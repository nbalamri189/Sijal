ى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[549,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[549,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[549,"نبت عينا أمامة عن مشيبي","https://www.aldiwan.net/poem48039.html","الوافر"],[556,"بستاننا في أراضي النيربين سقى","https://www.aldiwan.net/poem33513.html","البسيط"],[562,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[573,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[573,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[573,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[578,"ولست أبالي حين أصبح جثةً","https://www.aldiwan.net/poem25191.html","عموديه"],[584,"من كحل المقلة السوداء بالدعج","https://www.aldiwan.net/poem17465.html","البسيط"]],"verses":[["وَإِنَّ بُلوغَ الخَوفِ مِن قَلبِ خائِفٍ","لَدونَ بُلوغِ الخَوفِ مِن قَلبِ آمِنِ",0,"ن",1,0],["وَإِن بُزَّ مِن ذاكَ الجَناحِ مُطارُهُ","فَرُبَّ مَقالٍ مِنكَ ذي طَيَرانِ",1,"ن",1,0],["وَإِنَّ بِذاكَ الجِزعِ وَحشاً غَريرَةٌ","تَصيدُ وَأَعيا الناسُ كَيفَ تُصادُ",2,"د",1,0],["وَإِنَّ بُروداً لِلمَخازي مُعَدَّةٌ","فَمَن شاءَ في ذا الحَيِّ أَسحَبتُهُ بُردا",3,"د",2,0],["وَإِنَّ بُكاءَ مَن تَبكيهِ قُربى","لَدونَ بُكاءِ مَن يَبكيهِ وُدُّ",4,"د",1,0],["وَإِن بَعُدَ اللِقاءُ عَلى اِشتِياقي","تَرامَقنا بِأَلحاظِ القُلوبِ",5,"ب",1,0],["وَإِن بَلَغَ الرِّجالُ مَدايَ فيما","أُحاوِلُهُ فَلَستُ مِن الرِّجالِ",6,"ل",1,0],["وَإِنَّ بُيُوتَهُ لَكَمَا سَمِعْنَا","بُيُوتَ الْخَيْل وَالنَّعَمِ الْجِسَامِ",7,"م",1,0],["وَإِنَّ بَنِي زيَّانَ فِي أُفُقِ الْعُلَى","لأَنْجُمُ هَدْيٍ كُلَّمَا أَفَلَ النَّجْمُ",8,"م",1,0],["وَإِن بَرَقَت في مُخَيَلِ الصَوا","بِ عَمياءُ لا يَجتَليها البَصَر",9,"ر",1,0],["وَإِن بَشَرٌ يَوماً أَحالَ بِوَجهِهِ","عَلَيكَ فَحُل عَنهُ وَإِن كانَ دانِيا",10,"ي",2,0],["وَأَنبَتَ في النُفوسِ لَكُم جَفاءً","تَعَهَّدَهُ بِمُنهَلِّ الصُدودِ",11,"د",1,0],["وَإِن باتَ نَهّاضاً بِمِصرَ إِلى الذُرا","فَمِن جَدِّهِ الأَعلى عَلِيٍّ تَعَلَّما",12,"م",2,0],["وَاِنبَرى يَصدَعُ مِن أَغلالِها","بِاليَراعِ الحُرِّ لا بِالقُضُبِ",13,"ب",1,0],["وَأَنبَتَ في حِقفِ النَقاخيرُ رانَةً","تُقِلُّ هِلالاً أَطلَعَتهُ الذَوائِبُ",14,"ب",1,0],["وَإِن بَعُدتُ وَأَضنَتني الهُمومُ لَقَد","عَهِدتُهُ وَهوَ يُدنيني فَيُسليني",15,"ي",1,0],["وَإِنَّ بِلاداً هُنتُ فيها لَأَهوَنُ","وَمَن رامَ مِثلي بِالدَنِيَّةِ أَدنَأُ",16,"ن",2,0],["وَأَن باتَ مَن والاكَ في نَشوَةِ الغِنى","وَأَصبَحَ مَن عاداكَ في غَمرَةِ الرَدى",17,"د",2,0],["وَأَنَّ بَياضَ الرَأسِ يُعقِبُ بِالنُهى","وَلَكِنَّ أَطلالَ الشَبابِ تَزينُ",18,"ن",1,0],["وَإِنَّ بِجَوفي مِنكِ داءٌ مُخامِراً","وَجَوفُكِ مِمّا بي عَلَيك سَليمُ",19,"م",1,0],["وَإِن بَدَتِ الخَيماتُ مِن بَطنِ أَرثَدٍ","لَنا وَفِيافي المَرخَتَينِ الدَكادِكُ",20,"ك",1,0],["وأن بابا رجل يعبد","إلا إذا فاتته منه يد",21,"د",1,0],["وَأَنَّ بَيْتَكَ مَا مَرَّتْ بِهِ حِقَبٌ","حَلِيفُ نُجْحٍ وَإِقْبَالٍ وَعُمْرَانِ",22,"ن",1,0],["وَإِنَّ بَدِيلَ عَصْرٍ كَانَ فِيهِ","عِجَافُ الْقَوْمِ مِلْكاً لِلضِّخَامِ",23,"م",1,0],["وَأَنباطُ السَوادِ قَدِ اِستَحالوا","بِها عَرَباً فَقَد خَرِبَ السَوادُ",24,"د",1,0],["وَإِن بَدا آخَرُ نآءٍ أَغبَرُ","كَأَنَّهُ في رَيطَةٍ مُخَدَّرُ",25,"ر",1,0],["وَأَنَّ بَني اِمرِئِ القَيسِ اِبنِ لؤمٍ","أَبَت عَيدانُها إِلّا اِنكِسارا",26,"ر",2,0],["وأن بات بات على يقظةٍ","بطَرف لنجم العلا راصد",27,"د",1,0],["وإن بها للعلم قَدراً وحُرمة","وإن بها للحق عوناً وناصرا",28,"ر",2,0],["وَإِنَّ بَني رِفاعَةَ مِن تَميمٍ","هُمُ اللَجَأُ المُؤَمَّلُ وَالنَصيرُ",29,"ر",1,0],["وَإِنَّ بِالقَصيمِ مِنهُ ذِكرا","إِذ لَو يُطيعُ الرُؤَساءَ فَرّا",30,"ر",2,0],["وَأَنبُشَ مِن تَحتِ القُبورِ أُبُوَّةً","كِراماً هُمُ شَدّوا عَلَيَّ التَمائِما",31,"م",2,0],["وَإِن بَكَروا غَدَوتَ بِمُسمِعاتٍ","وَأَدكَنَ عاتِقٍ جَلدِ العِصامِ",32,"م",1,0],["وإن بَلغَت رَبيعَةَ جاءَ مِنهَا","أُسُودُ الغَابِ حَولِي مُوفِقِينَا",33,"ن",2,0],["وَأَنبَتَ حَوذاناً وَعَوفاً مُنَوِّراً","سَأُتبِعُهُ مِن خَيرِ ما أَنا قائِلُ",34,"ل",1,0],["وأنَّ بني الآمال أعوز رعيهم","وضاعوا فلا أمٌّ هناكَ ولا أب",35,"ب",1,0],["وانبرى غيثك الهتون بجدوى","علَّمتني مدائحاً لا تُبارى",36,"ر",2,0],["وأنبتّ بالتطعيم أشجار فضة","ومن أحسن الأشجار كلّ مطعّم",37,"م",1,0],["وإن بخسَ المُطْرون حقك إنهُ","لحق ثقيل لا يُظلَّم باخسه",38,"س",2,0],["وأنَّبتني حتى كأنك إنَّما","تتبَّعتَ هاتيكَ المواعيد بالنَّقض",39,"ض",1,0],["وإن بيوت البدو لو تصدقوننا","لأبنيةٌ ما ظللتكم نُطوعها",40,"ع",3,0],["وإن بغاك امرؤ بحيث بنى","أحمدُ أعلى بنيانه وجدكْ",41,"ك",1,0],["وَإِنَّ بَني أُمَيَّةَ أَلبَسوني","ظِلالَ كَرامَةٍ ما إِن تَزولُ",42,"ل",1,0],["وَإِن بَدَأَ النُعمى تَلاها بِمِثلِها","فَتَزدادُ حُسناً كَالقَريضِ مُجَنَّسا",43,"س",2,0],["وَإِن بَرَكَت مِنها عَجاساءُ جِلَّةٌ","بِمَحنِيَةٍ أَشلى العِفاسَ وَبَروَعا",44,"ع",2,0],["وَإِنَّ بَناتِ حَلّابٍ وَجَدنا","فَوارِسَهُنَّ في الهَيجا قُيونا",45,"ن",2,0],["وَإِن بِأَرضٍ نَبَت بِيَ الدارُ فَعَج","جَلتُ إِلى غَيرِ أَهلِها القُرَبا",46,"ب",2,0],["وَاِنبَرى النِساءُ لَهُ","عُجمُهُنَّ وَالعَرَبُ",47,"ب",1,0],["وَإِن بَعُدنا قَليلاً","حَمَلتَ رُمحاً وَحَربَه",48,"ب",2,0],["وَإِنَّ بِها وَإِنَّ بِهِ لَنَقصاً","وَأَنتَ لَها النِهايَةُ في الكَمالِ",49,"ل",1,0],["وَإِن بَذَلَ الإِنسانُ لي جودَ عابِسٍ","جَزَيتُ بِجودِ التارِكِ المُتَبَسِّمِ",50,"م",1,0],["وَإِن بُليتُ بِوُدٍّ مِثلِ وُدِّكُمُ","فَإِنَّني بِفِراقٍ مِثلِهِ قَمِنُ",51,"ن",1,0],["وإن بدَّلَ الأيَّامَ بؤسى بنعمةٍ","فلا تُنكري ما استبدلتْ وخُذيهِ",52,"ي",2,0],["وإنَّ بمسقطِ العلمين ماءً","نميراً دونَهُ ظِلٌّ ظليلُ",53,"ل",1,0],["وإِنَّ بقاءَ المالِ بعديَ نافعٌ","لمن كان بعدي في الزمان بقاؤهُ",54,"ا",3,0],["وَإِنَّ بِقَلبي كُلَّما هاجَ شَوقُهُ","حَراراتِ أَقباسٍ تَلوحُ لِراهِبِ",55,"ب",1,0],["وَأَنَّ بِوَجهِ البَدرِ مَحواً وَلَطخَةً","وَوَجهَكَ ما فيهِ مَعابٌ لِعائِبِ",56,"ب",1,0],["وَإِن باتَتِ الأَعداءُ دونَ بِلادِهِ","تَوَرَّدَها مَكروهُهُ في بِلادِها",57,"د",3,0],["وَإِن بَخِلتِ فَلا وَصلٌ وَلا صِلَةٌ","إِلّا اِهتِداءَ خَيالٍ مِنكِ زَوّارِ",58,"ر",1,0],["وَإِنب قَضى اللَهُ أَن تَبينَ فَقَد","كانَت فَبانَت مِن أَهلِها البَصِرَه",59,"ر",2,0],["وَإِنَّ بَخيلَكُم بِالجودِ يُكنى","سَفاهاً وَاِسمُ صِفرِدِكُم شُجاعُ",60,"ع",1,0],["وَإِنَّ بَني حَربٍ وَمَروانَ أَصبَحوا","بِدارِ هَوانٍ قَد عَراهُم نَكالُها",61,"ل",3,0],["وَإِنَّ بُكائِيَ بِالطُلولِ لَراحَةٌ","فَهَل مُسعِداتي بِالبُكاءِ طُلولُ",62,"ل",1,0],["وَإِنَّ بَقائي بَعدَهُ لَخِيانَةٌ","وَما كُنتُ يَوماً قَبلَهُ بِخَئونِ",63,"ن",1,0],["وَإِنَّ بَني المَراغَةِ لَم يُصيبوا","إِذا اِختاروا مُشاتَمَتي اِختِيارا",64,"ر",2,0],["وَإِنَّ بَني كُلَيبٍ إِذ هَجَوني","لَكَالجِعلانِ إِذ يَغشَينَ نارا",64,"ر",2,0],["وَإِنَّ بِلالاً لا تُحَجَّلُ قِدرُهُ","إِذا سُتِرَت دونَ الضُيوفِ حِجالُها",65,"ل",3,0],["وَإِنَّ بِلالاً يَقتُلُ الجوعَ إِن سَرَت","شَآمِيَّةً بِالنيبِ غُرّاً مَحالُها",65,"ل",3,0],["وإن بدا الليل فأجفانه","في لجة البركة مسبوته",66,"ت",2,0],["وَانْبَسَطَ النُّورُ على","وجهِ الثّرى فابتسَما",67,"م",2,0],["وإن بدأَتْ مواهبُه وعادَت","فمَدحي عائدٌ فيه وبَادِي",68,"ي",1,0],["وَإِن بَرَقَت في مَخيلِ الظُنو","نِ عَمياءَ لا يَجتَليها البَصَر",69,"ر",1,0],["وَانبِذ هُمومَكَ أَن تَضي","قَ بِها فَإِنَّ لَها مَخارِج",70,"ج",1,0],["وَإِنَّ بُطونَ المُكثِراتِ كَأَنَّما","يُنَقنِقُ في أَجوافِهِنَّ الضَفادِعُ",71,"ع",1,0],["وَاَنبَتَّ ما كانَ مَوصُلاً بِأَيدينا","أَينَ الَّذينَ عَهِدنا الجودَ يوثِقُنا",72,"ن",2,0],["وَإِنَّ بِأَيدينا الحديدَ لَناطقٌ","إِذا ما غَدا في غَيرها وَهوَ أَبكَمُ",73,"م",1,0],["وانبرَتْ منهما ولائدُ دُرٍّ","طائرِ الوَثبِ عَنهُما بالنّفارِ",74,"ر",1,0],["وَإِن بُليتُ بِجِدٍّ مِن حُزونَتِهِ","سَهَّلتُهُ فَكَأَنّي مِنهُ في لَعِبِ",75,"ب",1,0],["وَإِنَّ بُجرِيَّةً نابَت جَأَرتُ لَها","إِلى ذُرى جَلَدي فَاِستَوهَلَ الجَلَدُ",76,"د",1,0],["وَإِن بَكَرَت في ظُعنِهِم وَحُدوجِهِم","زَيانِبُ مِن أَحبابِنا وَعَواتِكُ",77,"ك",1,0],["وَإِنَّ بِعَينَيها لَعَمرُكَ شُهلَةً","فَقُلتُ كِرامُ الطَيرِ شُهلٌ عُيونُها",78,"ه",2,0],["وَإِنَّ بِنا لَو تَعلَمينَ لُغَلَّةٍ","إِلَيكَ كَما بِالحائِماتِ غَليلُ",79,"ل",1,0],["وأنبتَّ العلومَ بكلِّ أرضٍ","فتلك ثمارُها تُجنَى فُنونا",80,"ن",2,0],["وَإِنَّ بِلاداً سامَها الضَيمَ أَهلُها","لَأَجدَرُ أَن يَقضي عَلَيها الأَجانِبُ",81,"ب",1,0],["وإنَّ بها من كُلِّ رامٍ وَضَارِبٍ","أُلوفاً هُم السُّمُّ الذُّعافُ لمن يَبْلو",82,"ل",2,0],["وَإِن بَكَت لا بَكَت هَماً فَقَد عَلِمَت","وَأَيقَنَت أن ذاكَ الهَمّ يبكيني",83,"ي",1,0],["وَإِن بَرَكَت أَوفَت عَلى ثَفِناتِها","عَلى قَصَبٍ مِثلِ اليَراعِ المُقَصَّدِ",84,"د",1,0],["وَإِنَّ بَلائَهُم ما قَد عَلِمتُم","عَلى الأَيّامِ إِن نَفَعَ البَلاءُ",85,"ا",2,0],["وَإِن بَدا بِالرُمحِ كانَ أَعجَبا","تَحسَبُهُ قِرداً يَجُرُّ ذَنَبا",86,"ب",2,0],["وإنّ بهِ منهمْ لكُفْواً ومَقْنَعاً","ولكنّنا نأسى لِفَقْدِ المَقاوِل",87,"ل",1,0],["وإنّ بِنا شوقاً إليْهِ ولَوعَةً","تَكادُ لها أكبادُنَا تَتَصَدّع",88,"ع",1,0],["وإنّ بأهلِ الأرضِ فَقراً وفاقَةً","إليك وكلُّ النّاس آتيك مُهْطِع",88,"ع",1,0],["وَإِنباهُكَهُ في سا","دَةٍ مِن خَيرِ جُلّاسي",89,"ي",1,0],["وَاِنبَرى لي عَجرَدٌ يوعِدُني","كَمُثيرِ اللَيثِ لَيلاً ما شَعَر",90,"ر",1,0],["وَاِنبِض إِذا حارَبتَ غَيرَ نابِ","يا عُقبَ يا ذا القُحَمِ الرِغابِ",91,"ب",1,0],["وَأَنبَأَهُ المُنَبِّئُ أَنَّ حَيّاً","حُلولاً مِن حَرامٍ أَو جُذامِ",92,"م",1,0],["وَإِنَّ بَني حَوّاءَ زورٌ عَنِ الهُدى","وَلَو ضُرِبوا بِالسَيفِ ضَربَ الغَرائِبِ",93,"ب",1,0],["وَإِن بَلَغَ المِقدارُ لَم يَنجُ سابِحٌ","وَلَو أَنَّهُ في كُبَةِ الخَيلِ أَعوَجُ",94,"ج",1,0],["وَإِن بُتِكَت عَشرٌ فَمِن بَعدِ ما جَنَت","بِكُلِّ فَسيطٍ قُضَّ أَكثَرَ مِن عَشرِ",95,"ر",1,0],["وَاِنبُذ إِلى مَن تَشَكّى قِرَّةً سَمَلاً","مِنَ الثِيابِ وَأَورِد ظامِئاً سَمَلَك",96,"ك",1,0],["وَإِن بَدَوتِ فَلا يُؤنِسكِ شَقَةٌ","ضُحىً تُناجينَ سَوّاراً وَزَمّاما",97,"م",2,0],["وَإِنَّ بَني الدَيّانِ أَخمَلُ عِزَّهُم","قِيامُ عَميدٍ مِن خُزَيمَةَ دَيّانِ",98,"ن",1,0],["وإنْ بخِلْتَ عن الأحياء كلّهمِ","فاسْقِ المَواطِرَ حَيّاً من بَني مَطَرِ",99,"ر",1,0],["وَإِن بابُ أَمرٍ عَلَيكَ اِلتَوى","فَشاوِر لَبيباً وَلا تَعصِهِ",100,"ص",2,0],["وإن بها صحباً عن الحق ذادة","أبوا أن يهد الحيف من شرفي ركنا",101,"ن",2,0],["وإن بغداد فيها أُمَّة صدقوا","وإن بغداد فيها أُمَّة مانوا",102,"ن",3,0],["وإن بُكائي اليوم لَو نفع البكا","عليهم وَفي مستقبلي سَيَطول",103,"ل",1,0],["وأنبتّ منهم ربيع السّباع","فأثنت بإحسانك الشّامل",104,"ل",1,0],["وَانْبَرَى مِنْ فوْرِهِ أَرْغَبُهُمْ","فِي رِضَى الْغَاشِمِ يسْتَرْضِي الطِّمِرَّا",105,"ر",2,0],["وَأَنْبَتَت الْفَضَائِلَ فِي بَنِيهَا","نَبَاتَ المُخْصِبَاتِ مِنَ الحُقُول",106,"ل",1,0],["وَأَنْبتَ خَيْرَ إِنْبَاتٍ فرُوعاً","تُزَكِّيهِ كَمَا زَكَّى الأُصُولاَ",107,"ل",2,0],["وَأَنبَتَ في جِسمي البَلابِلَ وَالبلى","وَأَمطَرَ مِن آماقيَ الدَمَ وَالدَمعا",108,"ع",2,0],["وَأَنَّ بَني الحَصانِ تَعيثُ فيهِم","عَلانِيَةً سُيوفُ بَني البَغِيِّ",109,"ي",1,0],["وأنّ به نفساً يحطّمُ دونها","منيعُ الصياصي والحديد المَذرَّب",110,"ب",1,0],["وأن به من صَوْلةِ اللّه جَحْفَلاً","يَثُل عُروشَ القاسطينَ ويَسْلُب",110,"ب",1,0],["وإن بسمت له الدنيا سمِعنا","نشيداً يملأ الأطيارَ حِقدا",111,"د",2,0],["وإنَّ بُطُونَ المكثراتِ كأنَّما","تنقنقُ فِي أجوافِهِنَّ الضَّفَادِعُ",112,"ع",1,0],["وإنّ بَلاءَهُم ما قد عَلِمْتُمْ","لدى الذّاعي إذا رُفِع اللّواء",113,"ا",2,0],["وأنْبَأهُ المُنَبّىء ُ أنّ حَيّاً","حُلُولاً مِنْ حَرامٍ، أو جُذامِ",114,"م",1,0],["وانبرت عبقَرٌ تزجِّي من الجنّ","وفوداً مزهوةً بالمواسم",115,"م",1,0],["وإنَّ بلاداً أنجبتْكَ سعيدةٌ","وشعباً تَسامَى عِزُّهُ بك غانم",116,"م",1,0],["وانبرى كالغيمِ في مُضْحِيَةٍ","فسقى دهراً وأحيا وأفاء",117,"ا",2,0],["وانبرى التاريخُ في حَيْرتِهِ","أأماماً يتخطّى ام وراء",117,"ا",2,0],["وانبساطِ السَّفْحِ الذَّي زاحمته","دَفَعاتٌ من مَوجكَ الثَّوْري",118,"ي",1,0],["وانبرَتْ كفٌّ هي البُرْهُ مشَى","فشفَى من \" مُزمن \" داءً عُضالا",119,"ل",2,0],["وأنّ بطونَ العُتاةِ التي","مِن السُحتِ تَهضِمُ ما تهضم",120,"م",1,0],["وانبزتْ منهما ولائدُ دُرٍّ","طائرِ الوثب عهما بالنفّار",121,"ر",1,0],["وانبوا إلى الآتين من بعدكم","يبن لمن يخلفه القابل",122,"ل",1,0],["وأنبأه بصارمه اليقينا","جميعاً للدفاع مسلَّحينا",123,"ا",1,0],["وإن بات بات على يَقظَة ٍ","بطرف لنجم العلى راصد",124,"د",1,0],["وإنَّ بلاداً بالتجارِب هُدّمت","وضُيّعَ أهلوها لإحدى العجائب",125,"ب",1,0],["وإنْ بَعِدُوا لا يَأْمَنُونَ اقْتِرَابَهُ","تَشَوُّفَ أهلِ الغائبِ المُتَنَظَّرِ",126,"ر",1,0],["وأَنْبَتَ في حِقفِ النَّقَاخِيزُ رانة","تُقِلُّ هلالاً أَطلعتْهُ الذَّوائبُ",127,"ب",1,0],["وَاِنبُش وَجه النَجح بَعدَ عُبوسِهِ","فَرَحاً وَمُبتسم المُنى مضحاكُ",128,"ك",1,0],["وَإِن بت مَحزون الفُؤاد مِن النَوى","لِكُل امرءٍ مِن دَهرِهِ ما تَعَوَّدا",129,"د",2,0],["وانبرى صائلا على الاسد ال","كرار ظهر النهار كلب الدار",130,"ر",1,0],["وإن بني الصياد عال مقامهم","ومظهرهم سام بكل مقام",131,"م",1,1],["وإن بقيت على ظهري فعاري","على شيخ المشايخ بالعراق",132,"ق",1,0],["وإن بعدنا عن الخيرات وانقطعت","حبال أعمالنا للَه يدنينا",133,"ن",2,0],["وأنبت عن شرب العقار وبذله","وتنزهت شفتاي عن أدرانه",134,"ن",2,0],["وانبَرَى يَستَحيلُ بَينَ شَواطيهِ","زُلالاً مِن دُرّةٍ بَيضاءِ",135,"ا",2,0],["وإن بخلتْ يوماً علينا بقربكم","فكل حَلاَواتِ الزمان لنا مُهْلُ",136,"ل",1,0],["وإن بدَا طالعاً لآلاء غُرَّته","تكوَّرُ النيِّران الشمس والقمرُ",137,"ر",1,0],["وإن بَعُدَت دار وطالت مسافةٌ","وحالت صحارى دوننا ثم أسهُبُ",138,"ب",1,0],["وِإن بَلِيَت إِلاَّ ثَلاَثاً خَوَالِداً","ونُؤياً وآريًّا وَأودَت بِهَا الرِّيَا",139,"ي",2,0],["وأَنبَأني المُنبِئُ أنَّ وَغداً","يُحَاوِلُ أن يَكُونَ لَهَا حَلِيلا",140,"ل",2,0],["وأنَّ بَطشقَهُ تُخشَى وأنَّ لَهُ","زَاراً يُزلزَلُ منه الطَّودُ والجَلَدُ",141,"د",1,0],["وأنبوبة تنساب منها سوائلٌ","تردّ هواءَ الجو يُعمى ويبكمُ",142,"م",1,0],["وإنّ بين الأنامِ فَرْقا","فما كسولٌ كذِي اجتهادِ",143,"د",1,0],["وَإِن بَلِيَت أَوصالُهُ وَعِظامُهُ","فَعِندي ثَناءٌ لا يُلِمُّ بِهِ البِلا",144,"ل",2,0],["وَإِن بانَ وَثّابٌ فَما ضَيفُ مُسلِمٍ","كَمَن شَطَّ عَن بَحرٍ وَيَمَّمَ جَدوَلا",144,"ل",2,0],["وَإِن باتَ في أُخراهُمُ مُتَعَقِّباً","تَكُن أَوَّلاً مِنهُم إِذا الفَضلُ أَوَّلا",145,"ل",2,0],["وإن بنى الدنيا ودنياهم معاً","لنهبة أسباب الردى وحصيده",146,"د",2,0],["وإنّ بأكناف المرية منهم","لفدُّ السجايا والحلى والمناقب",147,"ب",1,0],["وَإِن بَلَغَ المَطلوبََ بالمَدحِ مُجتَدٍ","بَلَغنا بِمَدحِ الهاشميِّ مُحَمَّدٍ",148,"د",1,0],["وإِنْ بَدا لَكُما مِنْ سَيِّدي غَضَبٌ","فَغَالِطاهُ وَقولا لَيسَ نَعْرِفُهُ",149,"ف",2,0],["وأنبتت منه واهتزت به وربت","وبارك الله للأقوام في قدمه",150,"م",2,0],["وإنْ برقَتْ غزالةُ وجْنتيْه","حسبتَ الشمسَ ناظرةَ الغَزالِ",151,"ل",1,0],["وَأُنبِيكُما أَنّي عَلى ما عَهِدتُما","إِذا ضَيَّعَ العَهدَ المَلُولُ المماذِقُ",152,"ق",1,0],["وإن بدت نعمة لله سابغة","أو أبصروا من صنيع الله لي طرفا",153,"ف",2,0],["وَإِن بخلَ الغمامُ بطلّ غيثٍ","هَمَت يُمناك للعافين وبلا",154,"ل",2,0],["وانبرى للريح والموج","فلم تُغن الشجاعه",155,"ه",1,0],["وان بغتك صروف الدهر غائلةً","فزعزعتك تجد منهم اساطينا",156,"ن",2,0],["وَأُنبِئتُ أَن قَد أَلزَموكَ نُفوذَهُ","وَذَلِكَ لِلجيرانِ عَزلٌ بِمَعزِلِ",157,"ل",1,0],["وَأُنبِئتُ أَن قَد أَحرَمَ الغُسلَ عامِرٌ","وَأَنّي لَراضٍ عَنكَ ما لَم تُرَجَّلِ",157,"ل",1,0],["وان بان بان الحي من نحو طيبة","فأطلق زمان الشوق واحبس به الظعنا",158,"ن",2,0],["وان بدا لكما من وجهه غضب","فغالطاه وقولا ليس تعرفه",159,"ه",1,0],["وإن بغمَت عن صوته العذب بغمةٌ","فوسواسُ لحن الراح عن فيه ينقل",160,"ل",1,0],["وَاِنبَرَت تُقَلِّدُهُم","مِن سمائِها السُحُبُ",161,"ب",1,0],["وإنْ بَدَا من صاحبٍ بعضُ ما","يأتي به السُّكْرُ عَذَرْناه",162,"ن",3,0],["وَانْبَرَى النِّسْرينُ يُهْدي ذَهَباً","في صِِحَافٍٍ مُفْرَغَاتٍ منْ دُرَرْ",163,"ر",1,0],["وَانْبُذَنَّ الْخَلْقَ طُرّاً بَعْدَ مَنْ","كَانَ فِيهِ الْخَلْقُ طُرّاً جُمِعَا",164,"ع",2,0],["وإن بدت طلعته في ليلة","من شعره رأيت ليلا مقمرا",165,"ر",2,0],["وإن بدت من صاحب زلةٌ","فاستُرهُ بالإغضاء واستبقه",166,"ق",2,0],["وان بَخلوا واِستَغلو الحمدَ مُرخَصاً","رأى أَرخصَ الأَشياءَ حَمداً وان غَلا",167,"ل",2,0],["وان بَكاهُ الأَعادي راحِمين ضُحىً","لَمّا ثَوى فَلكَم أَبكاهُمُ حَسَدا",168,"د",2,0],["وإن بدا لي وجهه طالعاً","صفعت بالشمس قفا البدر",169,"ر",1,0],["وآن بأن يحمي الوطيس على المنى","ويضرم من جيش المنايا سعيرها",170,"ر",3,0],["وان بت في شك على شكر فضلها","شككت بحكم الله والكتب والرسل",171,"ل",1,0],["وآن بأن يتلو انحناؤك مفصحاً","لسمعك من تلقين ضعفك مصحفا",172,"ف",2,0],["وأنبئت أخوالي أرادوا نقيصتي","بشعواءَ فيها ثاملُ السمِّ منقعا",173,"ع",2,1],["وإن بسمَ الجمالُ صبا إليه","فأصلُ بليّتي القلبُ الحنون",174,"ن",1,0],["وإن بعدت دارٌ وشطَّ مزارُها","فللرُّوحِ مع روحٍ تُجاذبُها نجوى",175,"و",2,0],["وإن بعدوا عنّي دَنوتُ مُصافحاً","وإن أذنبوا عمداً فأعفو وأصفَح",176,"ح",1,0],["وان بليت باحكام الزَمان فَلا","تجزع فللدهر اقبال وادبار",177,"ر",1,0],["وان بك خاطب الاموات عيسى","فاز الجذع حن لذا وأَنا",178,"ن",2,0],["وَإِنَّ بِلاداً أَنْتَ حائِطُ ثَغْرِها","بِسَيْفِكَ قَدْ عَزَّتْ وَعَزَّ نَظِيرُها",179,"ر",3,0],["وَإِنَّ بُلُوغَ الْوَفْدِ ساحَةَ مِثْلِهِ","يَدٌ لِلْمَطايا لا تُؤَدّى حُقُوقُها",180,"ق",3,0],["وإن بني البسيطةِ كيفما هم","سبيلهمُ إلى هذا السبيل",181,"ل",1,0],["وَإِن بَكَيتُ لَدى مَن قَد كَلِفتُ بِهِ","لِما أُعانيهِ مِن وَجدٍ بِهِ ضَحِكا",182,"ك",2,0],["وإِن بدا لكما من وجهه غَضَبُ","فغالِطاهُ وَقولا لَيسَ نعرفُهُ",183,"ه",1,0],["وإِن بتحريمِهِ أَفتى مكابرةً","أَبو كثيرٍ فدَعهُ والَّذي زَعَما",184,"م",2,0],["وإن بليت بفقر فارض مكتفياً","بالله ربك أرح الفضل وارتقب",185,"ب",1,0],["وأنب إلى دار الكرامة والبقا","وعن الدنية كن أخي متجافي",186,"ي",1,0],["وأنبتها من كل زوج بثمره","وأزهاره تمتبع نفس وناظر",187,"ر",1,0],["وأنبتها زرعاً وعشباً مزهراً","بأزهاره ريح الجنوب تفوح",188,"ح",1,0],["وَأنبت خيرَ الدين في تقريرها","بِفصاحةٍ تزري على سحبانِ",189,"ن",1,0],["وَأنّ بِهِ شهب الفوارس ألبست","زمامَ الثريّا وهي مصحبة جنبا",190,"ب",2,0],["وَأنّ بِه شاكي السماكينِ حاجب","وَقَد نيطَ بهرامٌ إلى خصره عضبا",190,"ب",2,0],["وَأنّ بهِ زهر المَنازلِ نزّل","وَجَبهتها تلقى بإكليلها التربا",190,"ب",2,0],["وَإِن بَدا لَكُما في وَجهِهِ غَضَبٌ","وَقَد تَلاعَبَ تَحتَ الجَفنِ مُرهِفُهُ",191,"ف",2,0],["وَأَنبَأَ أَنَّهُ سَينالُ نَجحاً","وَفي العُمرِ المَديدِ يَظَلُّ يَمرَحُ",192,"ح",1,0],["وَإِن باحث العذّال فيما اِدّعيته","لعمر أَبي إنّي بِذاك أُباحثُ",193,"ث",1,0],["وإن بقيت فجَلدُ ذو مواطحةٍ","أسقي العدو نقيع السمِّ والسلَعا",194,"ع",2,0],["وَأَنبَتَ في الخدّر وَض الجمال","وَلكِن سَقاه بِماء اللَهَب",195,"ب",1,0],["وإنْ بدا غائصاً في بَحْرِ أنْمُله","ألْقَى إلى الطِّرْسِ من أسْنَى لآليه",196,"ي",2,0],["وأنّ بني الآمالِ حَلْيُ بني العُلا","وأنّ ذوي الإفضال ذُخْرُ ذوي الفَضل",197,"ل",1,0],["وانبَثَّ يُشيعُ عينَه نظَراً","منه ويَخبُرُ أمْرَهُ خُبرا",198,"ر",2,0],["وَإِن بَدَرَت كفَّاهُ كفّيَ سُرعَةً","فَخَلُّوا عن الشيخِ الكبيرِ المُمارسِ",199,"س",1,0],["وَإِن بَدَأتَ الكِتابَ في رَجَبٍ","وَيُسِّرَ الأَمرُ لَم يَحُل رَجَبُ",200,"ب",1,0],["وَأَنَّ بَني الدُنيا مَعَ الشَيبِ وَالصِبا","لَهُم وَعَلَيهِم غَيبَةٌ وَحُضورُ",201,"ر",1,0],["وَإِنَّ بِلاداً ما اِحتَلَت بي لَعاطِلٌ","وَإِنَّ زَماناً ما وَفى لي لَخَوّانُ",202,"ن",1,1],["وإن بَصُرتَ بهِ والقاصِدُونَ لهُ","من حَولهِ خِلتَهُ والنَّاسَ إخوانا",203,"ن",2,0],["وإن بعَّدَت آراؤهُ البِيضَ قَبلَهُ","فَأتباعُها حُمرُ المَنايا وجُونُها",204,"ن",3,0],["وانبَسِط في شَتيمَتي ودَع العا","لَم يَهذو فالعِرضُ عرضُ صَديقِك",205,"ك",1,0],["وإن بني الدنيا تميل لموسرٍ","وتعرضُ عن خلٍّ أُذيعَ شقاؤه",206,"ا",3,0],["وَاِن بَرَزت في محلِّ الصوا","بِ عَمياءُ لا تَجتَليها الفِكَر",207,"ر",1,0],["وَاِنبَرَت تَبغي حُسَيناً","وَعَرَتهُ وَعَراها",208,"ا",3,0],["وإنَّ بِأَطرافِ المُلَيلِ لَنِسوةً","ذَلولاً بأَردافٍ ثِقالٍ رَسِيمُهَا",209,"م",3,0],["وإنْ بَعُدَتْ عَنْ رَأي عَيْنِكَ فَاقَتي","فإِنّ افْتِقَاري مِنْ نَداكَ بِمَشْهَدِ",210,"د",1,0],["وإن بدا كَلَفٌ في وجهِ مكرُمَةٍ","جلا بلا كُلَفٍ عَن وَجهِهِ الكَلَفا",211,"ف",2,0],["وإنْ بخِلْتَ بوُدَّ أو مجاملَةٍ","فهُدْنَةٌ كيفَما كانَتْ على دَخَنِ",212,"ن",1,0],["وانبَرَى دونَ ضوئهِ وتَجَلِّي","هِ نِقابٌ يَضِلُّ رأيَ النِّقابِ",213,"ب",1,0],["وَإِنَّ بِقَلبي نَحوَهُنَّ لَغُلَّة","يقوِّم معوَجَّ الضُلوعِ زَفيرُها",214,"ر",3,0],["وَإِن بَّيَتَ الأَعداء أَمراً رَماهُمُ","صَباحاً بَخيلٍ لا تُرَدُّ وَلا تَكبو",215,"ب",2,0],["وإنّ بلاداً ضاق عنّي فضاؤُها","لأرحَبُ من أكنافِها للعُلا فِترُ",216,"ر",1,0],["وأنَّ بها من الأَشجانِ داءً","أعندك يا هذيم لها دواء",217,"ا",2,0],["وإنْ بارَزْتَ بالبرهان قوماً","تحامى من يرومك في نزالك",218,"ك",1,0],["وإنَّ بني أهليك لله درّهم","أَكابر أَقوام نمتهم أكابر",219,"ر",1,0],["وإنَّ بني السّعدون بالجود والنَّدى","لأشبَهُ شيءٍ بالبحور الزَّواخر",220,"ر",1,0],["وإن بدت وظلام الليل معتكر","رمت شياطين هم المرء بالشهب",221,"ب",1,0],["وأنَّ بني العلياء ضاقت صدورها","لفقدان ذاك السيّد المتصدر",222,"ر",1,0],["وأنْبتَّ بالتقوى بأحسن منبتٍ","وقد طاب أصلاً مثلما طاب محتدا",223,"د",2,0],["وَإِن بادَهوني بِالعَداوَةِ لَم أَكُن","أَبادُهُم إِلّا بِما يَنعَت الرُشدا",224,"د",2,1],["وإن بدا منك عيبٌ فاعترف وأقم","وجه اعتذاركَ عمّا فيك منكَ جرا",225,"ر",2,0],["وأن بها أهل البلاغة والحجى","فقلت نعم والفضل في صدرها علي",226,"ي",1,0],["وإن بدا تشرين والبازي نشا","في حسن تدبير فصد بما تشا",227,"ش",2,0],["وإن بالناطور نعني الراقبا","يرقب طيراً حاضراً أو ذاهبا",227,"ب",2,0],["وأنبئت أقواما لئاما تعرّضوا","بعرضي وفاهوا في أحاديثهم لعزا",228,"ز",2,0],["وإن بدأت يمين يديه جودا","فإن شماله حقا تعيد",229,"د",1,0],["وإن بعدت أيدي النوى عن مزاركم","فقلبي على عهد من الحبّ موثق",230,"ق",1,0],["وأنبئت من لي في رضاه مصالح","تهدّدني إذ رأيه في واهم",231,"م",1,0],["وإن بابك يولي قاصد بك علا","كأنما الشمس منك الدهر في الحمَلِ",232,"ل",1,0],["وإنْ بُدِّلَتْ منها السَكاكِينُ خِلْتَها","غماماً صائِرُ",233,"ر",1,0],["وإِنْ بَرَتِ الأَيَّامُ مِنْ حَدِّ هِمَّتِي","وفَلَّتْ سِلامُ الحادِثاتِ غِرَارَيَّا",234,"ي",2,0],["وإِنَّ بلاداً أَخرجَتنِي لَعُطَّلٌ","وإِنَّ زَماناً خان عَهدي لَخَوَّانُ",235,"ن",1,0],["وإن بقيت فما لي عن زيارتكم","عذر إذا وفق الباري وطال بقا",236,"ق",2,0],["وإن بتوحيدي لك اللَه وافدٌ","مع الوفد أرجو منك جائزة الوفد",237,"د",1,0],["وإِن بقي للذي يبقى على أَسف","بنو أخيك فنعم القادة النجد",238,"د",1,0],["وإِن بشير بقى من بعده خلفا","وصنوه أحمد بيت العلا عمرا",239,"ر",2,0],["وإِن بدا الصبح موشيا أكارعه","أبكي فأسقي الربا بالأدمع الذرف",240,"ف",1,0],["وإن بدا الصبح هيجت الحمام على","أعلى الأَشى ونهاري صار حلكوكا",241,"ك",2,0],["وإن بقيت أعمامه الغر وابنه","وإخوته فالحزن ليس بلازم",242,"م",1,0],["وإن بي وجعا شبهته بصدى","إن رن ران وعشب حين نم نما",243,"م",2,0],["وإنّ بواسطَ جوداً يكون","لرأسٍ عِقالاً ورجلٍ شكالا",244,"ل",2,0],["وإنّ ببابلٍ منهم لطَوداً","يضعضع كلَّ أرعنَ مشمخِرِّ",245,"ر",1,0],["وإن بلغَ الشكرُ حقَّ امرىء","فغايتُها مَعَك الإنتصارُ",246,"ر",1,0],["وإنّ ببابلٍ منكم لبحراً","لو أنّ البحرَ جاد كما يجودُ",247,"د",1,0],["وأَنبضَ من يديه لي غديراً","وقد أعيا فمي مَصُّ الثِّمادِ",248,"د",1,0],["وانْ بعت آمالي من المجد والعُلى","مبيع الكُسالى بالمواطنِ والأهْلِ",249,"ل",1,0],["وانْ بات يثنيني عن العزم موعِدٌ","بكى الفضل من اِنجازه لأولي الجهل",249,"ل",1,0],["وَإِنَّ بِقَومٍ سَوَّدوكَ لَحاجَةً","إِلى سَيِّدٍ لَو يَظفَرونَ بِسَيِّدِ",250,"د",1,1],["وَإِنَّ بَني حَربٍ كَما قَد عَلِمتُمُ","مَناطَ الثُرَيّا قَد تَعَلَّت نُجومُها",251,"ه",2,1],["واِنْ بَخِلَتْ غوادي السُّحبِ يوماً","فسحبُ الدمعِ مُثْقَلَةٌ عِثارُ",252,"ر",1,0],["وإن بت بجعجاع","لقد بتنا بأوجاع",253,"ع",1,0],["وإن بت بين الذروتين بفرجتي","خرسان خل العين منك بمكة",254,"ه",1,0],["وانْبِلاجِ الأشْكالِ لَوناً فَلَوْناً","بِبُروزِ المُفَسِّرِ الضَّوْئيِّ",255,"ي",1,0],["وانْبَلجتْ أنْسابُهُمْ","فهي أنابيبُ الرِّماح",256,"ح",1,0],["وانْبشِ الأرضَ فأين يكْثر المو","تُ فريحُ أجنبيٍّ لو عَقَلتا",257,"ت",2,0],["وأنبتَ في فؤادِ الصُّبحِ رَوعاً","فها كافورُه كالزّعْفَرانِ",258,"ن",1,0],["وإن برقت سني لذكر حكاية","فإن فؤادي ماحييت كئيب",259,"ب",1,0],["وإن بسمت يوماً بروق سيوفه","ذهلت به عن بارقات المباسم",260,"م",1,0],["وإن بارَاهُ ذُو سَبْقٍ","فَمنْ ذاكَ تَرَى مِثلهْ",261,"ل",2,0],["وإن بَدا غاضِباً فالقَلبُ في وَجَلٍ","والطَّرفُ في ذَهَلٍ والجسمُ في شَلَلِ",262,"ل",1,0],["وإن باتَ يسكُبُ من دمعِه","إلَى الفجرِ يَكفِيهِ ما قد سَكَب",263,"ب",1,0],["وإنْ بنتَ فما أنتَ","كقومٍ بالرّدى بانوا",264,"ن",3,0],["وإِنْ بتَّ ملآنَ الجفونِ من الكرى","فإنّ الّذي نازعتَه الغُمضَ ما أغفى",265,"ف",2,0],["وَإِن بَسطوا لَم تَلقَ في الخلق قابضاً","وَإِن قَبضوا لَم تلقَ في الخلقِ باسطا",266,"ط",2,0],["وَإنْ بقيتُ فَللعلياءِ أَركبها","وَالمَجد ما بين تصبيحٍ وتغليسِ",267,"س",1,0],["وَإنَّ بِنا وَما يَدري المعافى","شَجىً في الصّدرِ يَعتلجُ اِعتِلاجا",268,"ج",2,0],["وإنّ بَعيدَ شيبكِ وهو آتٍ","نظيرُ بياض مفرقيَ القريبِ",269,"ب",1,0],["وإن بدا خفيت في نوره وإذا","بدت ففيها اختفى لا تدرك الشفقا",270,"ق",2,0],["وإن بلاداً زرتها لوضيئة","وإن احتفالاً لم يكن بك قاتم",271,"م",1,0],["وإِن بكَيْتُ فنكِّبْ عن مُجَاوَرَتي","واحذَرْ وإِيَّاكَ من طُوفَانِ أَجْفَاني",272,"ي",1,0],["وإِنَّ بَقَائِي من بعدِه","قبيحٌ وإِنَّ حياتِي جفاءُ",273,"ا",2,0],["وإِن بَدَا بِيَ كَلْمٌ في الحَشا فَنَدي","عبد الرَّحيمِ لذِاكَ الْكَلْم كْالآسِي",274,"ي",1,0],["وإن بت تحت الترب فالترب تحته","شعوبٌ وأمصارٌ وقد نُسي الحزن",275,"ن",1,0],["وَإِنْ بَدا رَوْضُ خَدَّيهِ وَوَجْنَتِه","أَغْنَتْ بأَزْهارِهَا عَنْ سَائِر الفُرَجِ",276,"ج",1,0]]}