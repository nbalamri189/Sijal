s://www.aldiwan.net/poem47394.html","الطويل"],[552,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[552,"نبت عينا أمامة عن مشيبي","https://www.aldiwan.net/poem48039.html","الوافر"],[559,"بستاننا في أراضي النيربين سقى","https://www.aldiwan.net/poem33513.html","البسيط"],[565,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[576,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[576,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[576,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[581,"ولست أبالي حين أصبح جثةً","https://www.aldiwan.net/poem25191.html","عموديه"],[587,"من كحل المقلة السوداء بالدعج","https://www.aldiwan.net/poem17465.html","البسيط"]],"verses":[["وإن بخس التأريخ في الناس حقه","فكم طفف الميزان في الكيل ناصبه",0,"ب",2,0],["وَإِنَّ بُلوغَ الخَوفِ مِن قَلبِ خائِفٍ","لَدونَ بُلوغِ الخَوفِ مِن قَلبِ آمِنِ",1,"ن",1,0],["وَإِن بُزَّ مِن ذاكَ الجَناحِ مُطارُهُ","فَرُبَّ مَقالٍ مِنكَ ذي طَيَرانِ",2,"ن",1,0],["وَإِنَّ بِذاكَ الجِزعِ وَحشاً غَريرَةٌ","تَصيدُ وَأَعيا الناسُ كَيفَ تُصادُ",3,"د",1,0],["وَإِنَّ بُروداً لِلمَخازي مُعَدَّةٌ","فَمَن شاءَ في ذا الحَيِّ أَسحَبتُهُ بُردا",4,"د",2,0],["وَإِنَّ بُكاءَ مَن تَبكيهِ قُربى","لَدونَ بُكاءِ مَن يَبكيهِ وُدُّ",5,"د",1,0],["وَإِن بَعُدَ اللِقاءُ عَلى اِشتِياقي","تَرامَقنا بِأَلحاظِ القُلوبِ",6,"ب",1,0],["وَإِن بَلَغَ الرِّجالُ مَدايَ فيما","أُحاوِلُهُ فَلَستُ مِن الرِّجالِ",7,"ل",1,0],["وَإِنَّ بُيُوتَهُ لَكَمَا سَمِعْنَا","بُيُوتَ الْخَيْل وَالنَّعَمِ الْجِسَامِ",8,"م",1,0],["وَإِنَّ بَنِي زيَّانَ فِي أُفُقِ الْعُلَى","لأَنْجُمُ هَدْيٍ كُلَّمَا أَفَلَ النَّجْمُ",9,"م",1,0],["وَإِن بَرَقَت في مُخَيَلِ الصَوا","بِ عَمياءُ لا يَجتَليها البَصَر",10,"ر",1,0],["وَإِن بَشَرٌ يَوماً أَحالَ بِوَجهِهِ","عَلَيكَ فَحُل عَنهُ وَإِن كانَ دانِيا",11,"ي",2,0],["وَأَنبَتَ في النُفوسِ لَكُم جَفاءً","تَعَهَّدَهُ بِمُنهَلِّ الصُدودِ",12,"د",1,0],["وَإِن باتَ نَهّاضاً بِمِصرَ إِلى الذُرا","فَمِن جَدِّهِ الأَعلى عَلِيٍّ تَعَلَّما",13,"م",2,0],["وَاِنبَرى يَصدَعُ مِن أَغلالِها","بِاليَراعِ الحُرِّ لا بِالقُضُبِ",14,"ب",1,0],["وَأَنبَتَ في حِقفِ النَقاخيرُ رانَةً","تُقِلُّ هِلالاً أَطلَعَتهُ الذَوائِبُ",15,"ب",1,0],["وَإِن بَعُدتُ وَأَضنَتني الهُمومُ لَقَد","عَهِدتُهُ وَهوَ يُدنيني فَيُسليني",16,"ن",2,0],["وَإِنَّ بِلاداً هُنتُ فيها لَأَهوَنُ","وَمَن رامَ مِثلي بِالدَنِيَّةِ أَدنَأُ",17,"ن",2,0],["وَأَن باتَ مَن والاكَ في نَشوَةِ الغِنى","وَأَصبَحَ مَن عاداكَ في غَمرَةِ الرَدى",18,"د",2,0],["وَأَنَّ بَياضَ الرَأسِ يُعقِبُ بِالنُهى","وَلَكِنَّ أَطلالَ الشَبابِ تَزينُ",19,"ن",1,0],["وَإِنَّ بِجَوفي مِنكِ داءٌ مُخامِراً","وَجَوفُكِ مِمّا بي عَلَيك سَليمُ",20,"م",1,0],["وَإِن بَدَتِ الخَيماتُ مِن بَطنِ أَرثَدٍ","لَنا وَفِيافي المَرخَتَينِ الدَكادِكُ",21,"ك",1,0],["وأن بابا رجل يعبد","إلا إذا فاتته منه يد",22,"د",1,0],["وَأَنَّ بَيْتَكَ مَا مَرَّتْ بِهِ حِقَبٌ","حَلِيفُ نُجْحٍ وَإِقْبَالٍ وَعُمْرَانِ",23,"ن",1,0],["وَإِنَّ بَدِيلَ عَصْرٍ كَانَ فِيهِ","عِجَافُ الْقَوْمِ مِلْكاً لِلضِّخَامِ",24,"م",1,0],["وَأَنباطُ السَوادِ قَدِ اِستَحالوا","بِها عَرَباً فَقَد خَرِبَ السَوادُ",25,"د",1,0],["وَإِن بَدا آخَرُ نآءٍ أَغبَرُ","كَأَنَّهُ في رَيطَةٍ مُخَدَّرُ",26,"ر",1,0],["وَأَنَّ بَني اِمرِئِ القَيسِ اِبنِ لؤمٍ","أَبَت عَيدانُها إِلّا اِنكِسارا",27,"ر",2,0],["وأن بات بات على يقظةٍ","بطَرف لنجم العلا راصد",28,"د",1,0],["وإن بها للعلم قَدراً وحُرمة","وإن بها للحق عوناً وناصرا",29,"ر",2,0],["وَإِنَّ بَني رِفاعَةَ مِن تَميمٍ","هُمُ اللَجَأُ المُؤَمَّلُ وَالنَصيرُ",30,"ر",1,0],["وَإِنَّ بِالقَصيمِ مِنهُ ذِكرا","إِذ لَو يُطيعُ الرُؤَساءَ فَرّا",31,"ر",2,0],["وَأَنبُشَ مِن تَحتِ القُبورِ أُبُوَّةً","كِراماً هُمُ شَدّوا عَلَيَّ التَمائِما",32,"م",2,0],["وَإِن بَكَروا غَدَوتَ بِمُسمِعاتٍ","وَأَدكَنَ عاتِقٍ جَلدِ العِصامِ",33,"م",1,0],["وإن بَلغَت رَبيعَةَ جاءَ مِنهَا","أُسُودُ الغَابِ حَولِي مُوفِقِينَا",34,"ن",2,0],["وَأَنبَتَ حَوذاناً وَعَوفاً مُنَوِّراً","سَأُتبِعُهُ مِن خَيرِ ما أَنا قائِلُ",35,"ل",1,0],["وأنَّ بني الآمال أعوز رعيهم","وضاعوا فلا أمٌّ هناكَ ولا أب",36,"ب",1,0],["وانبرى غيثك الهتون بجدوى","علَّمتني مدائحاً لا تُبارى",37,"ر",2,0],["وأنبتّ بالتطعيم أشجار فضة","ومن أحسن الأشجار كلّ مطعّم",38,"م",1,0],["وإن بخسَ المُطْرون حقك إنهُ","لحق ثقيل لا يُظلَّم باخسه",39,"س",2,0],["وأنَّبتني حتى كأنك إنَّما","تتبَّعتَ هاتيكَ المواعيد بالنَّقض",40,"ض",1,0],["وإن بيوت البدو لو تصدقوننا","لأبنيةٌ ما ظللتكم نُطوعها",41,"ع",3,0],["وإن بغاك امرؤ بحيث بنى","أحمدُ أعلى بنيانه وجدكْ",42,"ك",1,0],["وَإِنَّ بَني أُمَيَّةَ أَلبَسوني","ظِلالَ كَرامَةٍ ما إِن تَزولُ",43,"ل",1,0],["وَإِن بَدَأَ النُعمى تَلاها بِمِثلِها","فَتَزدادُ حُسناً كَالقَريضِ مُجَنَّسا",44,"س",2,0],["وَإِن بَرَكَت مِنها عَجاساءُ جِلَّةٌ","بِمَحنِيَةٍ أَشلى العِفاسَ وَبَروَعا",45,"ع",2,0],["وَإِنَّ بَناتِ حَلّابٍ وَجَدنا","فَوارِسَهُنَّ في الهَيجا قُيونا",46,"ن",2,0],["وَإِن بِأَرضٍ نَبَت بِيَ الدارُ فَعَج","جَلتُ إِلى غَيرِ أَهلِها القُرَبا",47,"ب",2,0],["وَاِنبَرى النِساءُ لَهُ","عُجمُهُنَّ وَالعَرَبُ",48,"ب",1,0],["وَإِن بَعُدنا قَليلاً","حَمَلتَ رُمحاً وَحَربَه",49,"ب",2,0],["وَإِنَّ بِها وَإِنَّ بِهِ لَنَقصاً","وَأَنتَ لَها النِهايَةُ في الكَمالِ",50,"ل",1,0],["وَإِن بَذَلَ الإِنسانُ لي جودَ عابِسٍ","جَزَيتُ بِجودِ التارِكِ المُتَبَسِّمِ",51,"م",1,0],["وَإِن بُليتُ بِوُدٍّ مِثلِ وُدِّكُمُ","فَإِنَّني بِفِراقٍ مِثلِهِ قَمِنُ",52,"ن",1,0],["وإن بدَّلَ الأيَّامَ بؤسى بنعمةٍ","فلا تُنكري ما استبدلتْ وخُذيهِ",53,"ي",2,0],["وإنَّ بمسقطِ العلمين ماءً","نميراً دونَهُ ظِلٌّ ظليلُ",54,"ل",1,0],["وإِنَّ بقاءَ المالِ بعديَ نافعٌ","لمن كان بعدي في الزمان بقاؤهُ",55,"ا",3,0],["وَإِنَّ بِقَلبي كُلَّما هاجَ شَوقُهُ","حَراراتِ أَقباسٍ تَلوحُ لِراهِبِ",56,"ب",1,0],["وَأَنَّ بِوَجهِ البَدرِ مَحواً وَلَطخَةً","وَوَجهَكَ ما فيهِ مَعابٌ لِعائِبِ",57,"ب",1,0],["وَإِن باتَتِ الأَعداءُ دونَ بِلادِهِ","تَوَرَّدَها مَكروهُهُ في بِلادِها",58,"د",3,0],["وَإِن بَخِلتِ فَلا وَصلٌ وَلا صِلَةٌ","إِلّا اِهتِداءَ خَيالٍ مِنكِ زَوّارِ",59,"ر",1,0],["وَإِنب قَضى اللَهُ أَن تَبينَ فَقَد","كانَت فَبانَت مِن أَهلِها البَصِرَه",60,"ر",2,0],["وَإِنَّ بَخيلَكُم بِالجودِ يُكنى","سَفاهاً وَاِسمُ صِفرِدِكُم شُجاعُ",61,"ع",1,0],["وَإِنَّ بَني حَربٍ وَمَروانَ أَصبَحوا","بِدارِ هَوانٍ قَد عَراهُم نَكالُها",62,"ل",3,0],["وَإِنَّ بُكائِيَ بِالطُلولِ لَراحَةٌ","فَهَل مُسعِداتي بِالبُكاءِ طُلولُ",63,"ل",1,0],["وَإِنَّ بَقائي بَعدَهُ لَخِيانَةٌ","وَما كُنتُ يَوماً قَبلَهُ بِخَئونِ",64,"ن",1,0],["وَإِنَّ بَني المَراغَةِ لَم يُصيبوا","إِذا اِختاروا مُشاتَمَتي اِختِيارا",65,"ر",2,0],["وَإِنَّ بَني كُلَيبٍ إِذ هَجَوني","لَكَالجِعلانِ إِذ يَغشَينَ نارا",65,"ر",2,0],["وَإِنَّ بِلالاً لا تُحَجَّلُ قِدرُهُ","إِذا سُتِرَت دونَ الضُيوفِ حِجالُها",66,"ل",3,0],["وَإِنَّ بِلالاً يَقتُلُ الجوعَ إِن سَرَت","شَآمِيَّةً بِالنيبِ غُرّاً مَحالُها",66,"ل",3,0],["وإن بدا الليل فأجفانه","في لجة البركة مسبوته",67,"ت",2,0],["وَانْبَسَطَ النُّورُ على","وجهِ الثّرى فابتسَما",68,"م",2,0],["وإن بدأَتْ مواهبُه وعادَت","فمَدحي عائدٌ فيه وبَادِي",69,"د",2,0],["وَإِن بَرَقَت في مَخيلِ الظُنو","نِ عَمياءَ لا يَجتَليها البَصَر",70,"ر",1,0],["وَانبِذ هُمومَكَ أَن تَضي","قَ بِها فَإِنَّ لَها مَخارِج",71,"ج",1,0],["وَإِنَّ بُطونَ المُكثِراتِ كَأَنَّما","يُنَقنِقُ في أَجوافِهِنَّ الضَفادِعُ",72,"ع",1,0],["وَاَنبَتَّ ما كانَ مَوصُلاً بِأَيدينا","أَينَ الَّذينَ عَهِدنا الجودَ يوثِقُنا",73,"ن",2,0],["وإن بي وجعا شبهته بصدى","إن رن ران وعشب حين نم نما",74,"م",2,0],["وَإِنَّ بِأَيدينا الحديدَ لَناطقٌ","إِذا ما غَدا في غَيرها وَهوَ أَبكَمُ",75,"م",1,0],["وانبرَتْ منهما ولائدُ دُرٍّ","طائرِ الوَثبِ عَنهُما بالنّفارِ",76,"ر",1,0],["وَإِن بُليتُ بِجِدٍّ مِن حُزونَتِهِ","سَهَّلتُهُ فَكَأَنّي مِنهُ في لَعِبِ",77,"ب",1,0],["وَإِنَّ بُجرِيَّةً نابَت جَأَرتُ لَها","إِلى ذُرى جَلَدي فَاِستَوهَلَ الجَلَدُ",78,"د",1,0],["وَإِن بَكَرَت في ظُعنِهِم وَحُدوجِهِم","زَيانِبُ مِن أَحبابِنا وَعَواتِكُ",79,"ك",1,0],["وَإِنَّ بِعَينَيها لَعَمرُكَ شُهلَةً","فَقُلتُ كِرامُ الطَيرِ شُهلٌ عُيونُها",80,"ه",2,0],["وَإِنَّ بِنا لَو تَعلَمينَ لُغَلَّةٍ","إِلَيكَ كَما بِالحائِماتِ غَليلُ",81,"ل",1,0],["وأنبتَّ العلومَ بكلِّ أرضٍ","فتلك ثمارُها تُجنَى فُنونا",82,"ن",2,0],["وَإِنَّ بِلاداً سامَها الضَيمَ أَهلُها","لَأَجدَرُ أَن يَقضي عَلَيها الأَجانِبُ",83,"ب",1,0],["وإنَّ بها من كُلِّ رامٍ وَضَارِبٍ","أُلوفاً هُم السُّمُّ الذُّعافُ لمن يَبْلو",84,"ل",2,0],["وَإِن بَكَت لا بَكَت هَماً فَقَد عَلِمَت","وَأَيقَنَت أن ذاكَ الهَمّ يبكيني",85,"ن",2,0],["وَإِن بَرَكَت أَوفَت عَلى ثَفِناتِها","عَلى قَصَبٍ مِثلِ اليَراعِ المُقَصَّدِ",86,"د",1,0],["وَإِنَّ بَلائَهُم ما قَد عَلِمتُم","عَلى الأَيّامِ إِن نَفَعَ البَلاءُ",87,"ا",2,0],["وَإِن بَدا بِالرُمحِ كانَ أَعجَبا","تَحسَبُهُ قِرداً يَجُرُّ ذَنَبا",88,"ب",2,0],["وإنّ بهِ منهمْ لكُفْواً ومَقْنَعاً","ولكنّنا نأسى لِفَقْدِ المَقاوِل",89,"ل",1,0],["وإنّ بِنا شوقاً إليْهِ ولَوعَةً","تَكادُ لها أكبادُنَا تَتَصَدّع",90,"ع",1,0],["وإنّ بأهلِ الأرضِ فَقراً وفاقَةً","إليك وكلُّ النّاس آتيك مُهْطِع",90,"ع",1,0],["وَإِنباهُكَهُ في سا","دَةٍ مِن خَيرِ جُلّاسي",91,"س",2,0],["وَاِنبَرى لي عَجرَدٌ يوعِدُني","كَمُثيرِ اللَيثِ لَيلاً ما شَعَر",92,"ر",1,0],["وَاِنبِض إِذا حارَبتَ غَيرَ نابِ","يا عُقبَ يا ذا القُحَمِ الرِغابِ",93,"ب",1,0],["وَأَنبَأَهُ المُنَبِّئُ أَنَّ حَيّاً","حُلولاً مِن حَرامٍ أَو جُذامِ",94,"م",1,0],["وَإِنَّ بَني حَوّاءَ زورٌ عَنِ الهُدى","وَلَو ضُرِبوا بِالسَيفِ ضَربَ الغَرائِبِ",95,"ب",1,0],["وَإِن بَلَغَ المِقدارُ لَم يَنجُ سابِحٌ","وَلَو أَنَّهُ في كُبَةِ الخَيلِ أَعوَجُ",96,"ج",1,0],["وَإِن بُتِكَت عَشرٌ فَمِن بَعدِ ما جَنَت","بِكُلِّ فَسيطٍ قُضَّ أَكثَرَ مِن عَشرِ",97,"ر",1,0],["وَاِنبُذ إِلى مَن تَشَكّى قِرَّةً سَمَلاً","مِنَ الثِيابِ وَأَورِد ظامِئاً سَمَلَك",98,"ك",1,0],["وَإِن بَدَوتِ فَلا يُؤنِسكِ شَقَةٌ","ضُحىً تُناجينَ سَوّاراً وَزَمّاما",99,"م",2,0],["وَإِنَّ بَني الدَيّانِ أَخمَلُ عِزَّهُم","قِيامُ عَميدٍ مِن خُزَيمَةَ دَيّانِ",100,"ن",1,0],["وإنْ بخِلْتَ عن الأحياء كلّهمِ","فاسْقِ المَواطِرَ حَيّاً من بَني مَطَرِ",101,"ر",1,0],["وَإِن بابُ أَمرٍ عَلَيكَ اِلتَوى","فَشاوِر لَبيباً وَلا تَعصِهِ",102,"ص",2,0],["وإن بها صحباً عن الحق ذادة","أبوا أن يهد الحيف من شرفي ركنا",103,"ن",2,0],["وإن بغداد فيها أُمَّة صدقوا","وإن بغداد فيها أُمَّة مانوا",104,"ن",3,0],["وإن بُكائي اليوم لَو نفع البكا","عليهم وَفي مستقبلي سَيَطول",105,"ل",1,0],["وأنبتّ منهم ربيع السّباع","فأثنت بإحسانك الشّامل",106,"ل",1,0],["وَانْبَرَى مِنْ فوْرِهِ أَرْغَبُهُمْ","فِي رِضَى الْغَاشِمِ يسْتَرْضِي الطِّمِرَّا",107,"ر",2,0],["وَأَنْبَتَت الْفَضَائِلَ فِي بَنِيهَا","نَبَاتَ المُخْصِبَاتِ مِنَ الحُقُول",108,"ل",1,0],["وَأَنْبتَ خَيْرَ إِنْبَاتٍ فرُوعاً","تُزَكِّيهِ كَمَا زَكَّى الأُصُولاَ",109,"ل",2,0],["وَأَنبَتَ في جِسمي البَلابِلَ وَالبلى","وَأَمطَرَ مِن آماقيَ الدَمَ وَالدَمعا",110,"ع",2,0],["وَأَنَّ بَني الحَصانِ تَعيثُ فيهِم","عَلانِيَةً سُيوفُ بَني البَغِيِّ",111,"ي",1,0],["وأنّ به نفساً يحطّمُ دونها","منيعُ الصياصي والحديد المَذرَّب",112,"ب",1,0],["وأن به من صَوْلةِ اللّه جَحْفَلاً","يَثُل عُروشَ القاسطينَ ويَسْلُب",112,"ب",1,0],["وإن بسمت له الدنيا سمِعنا","نشيداً يملأ الأطيارَ حِقدا",113,"د",2,0],["وإنَّ بُطُونَ المكثراتِ كأنَّما","تنقنقُ فِي أجوافِهِنَّ الضَّفَادِعُ",114,"ع",1,0],["وإنّ بَلاءَهُم ما قد عَلِمْتُمْ","لدى الذّاعي إذا رُفِع اللّواء",115,"ا",2,0],["وأنْبَأهُ المُنَبّىء ُ أنّ حَيّاً","حُلُولاً مِنْ حَرامٍ، أو جُذامِ",116,"م",1,0],["وانبرت عبقَرٌ تزجِّي من الجنّ","وفوداً مزهوةً بالمواسم",117,"م",1,0],["وإنَّ بلاداً أنجبتْكَ سعيدةٌ","وشعباً تَسامَى عِزُّهُ بك غانم",118,"م",1,0],["وانبرى كالغيمِ في مُضْحِيَةٍ","فسقى دهراً وأحيا وأفاء",119,"ا",2,0],["وانبرى التاريخُ في حَيْرتِهِ","أأماماً يتخطّى ام وراء",119,"ا",2,0],["وانبساطِ السَّفْحِ الذَّي زاحمته","دَفَعاتٌ من مَوجكَ الثَّوْري",120,"ي",1,0],["وانبرَتْ كفٌّ هي البُرْهُ مشَى","فشفَى من \" مُزمن \" داءً عُضالا",121,"ل",2,0],["وأنّ بطونَ العُتاةِ التي","مِن السُحتِ تَهضِمُ ما تهضم",122,"م",1,0],["وانبزتْ منهما ولائدُ دُرٍّ","طائرِ الوثب عهما بالنفّار",123,"ر",1,0],["وانبوا إلى الآتين من بعدكم","يبن لمن يخلفه القابل",124,"ل",1,0],["وأنبأه بصارمه اليقينا","جميعاً للدفاع مسلَّحينا",125,"ا",1,0],["وإن بات بات على يَقظَة ٍ","بطرف لنجم العلى راصد",126,"د",1,0],["وإنَّ بلاداً بالتجارِب هُدّمت","وضُيّعَ أهلوها لإحدى العجائب",127,"ب",1,0],["وإنْ بَعِدُوا لا يَأْمَنُونَ اقْتِرَابَهُ","تَشَوُّفَ أهلِ الغائبِ المُتَنَظَّرِ",128,"ر",1,0],["وأَنْبَتَ في حِقفِ النَّقَاخِيزُ رانة","تُقِلُّ هلالاً أَطلعتْهُ الذَّوائبُ",129,"ب",1,0],["وَاِنبُش وَجه النَجح بَعدَ عُبوسِهِ","فَرَحاً وَمُبتسم المُنى مضحاكُ",130,"ك",1,0],["وَإِن بت مَحزون الفُؤاد مِن النَوى","لِكُل امرءٍ مِن دَهرِهِ ما تَعَوَّدا",131,"د",2,0],["وانبرى صائلا على الاسد ال","كرار ظهر النهار كلب الدار",132,"ر",1,0],["وإن بني الصياد عال مقامهم","ومظهرهم سام بكل مقام",133,"م",1,1],["وإن بقيت على ظهري فعاري","على شيخ المشايخ بالعراق",134,"ق",1,0],["وإن بعدنا عن الخيرات وانقطعت","حبال أعمالنا للَه يدنينا",135,"ن",2,0],["وأنبت عن شرب العقار وبذله","وتنزهت شفتاي عن أدرانه",136,"ن",2,0],["وانبَرَى يَستَحيلُ بَينَ شَواطيهِ","زُلالاً مِن دُرّةٍ بَيضاءِ",137,"ا",2,0],["وإن بخلتْ يوماً علينا بقربكم","فكل حَلاَواتِ الزمان لنا مُهْلُ",138,"ل",1,0],["وإن بدَا طالعاً لآلاء غُرَّته","تكوَّرُ النيِّران الشمس والقمرُ",139,"ر",1,0],["وإن بَعُدَت دار وطالت مسافةٌ","وحالت صحارى دوننا ثم أسهُبُ",140,"ب",1,0],["وِإن بَلِيَت إِلاَّ ثَلاَثاً خَوَالِداً","ونُؤياً وآريًّا وَأودَت بِهَا الرِّيَا",141,"ي",2,0],["وأَنبَأني المُنبِئُ أنَّ وَغداً","يُحَاوِلُ أن يَكُونَ لَهَا حَلِيلا",142,"ل",2,0],["وأنَّ بَطشقَهُ تُخشَى وأنَّ لَهُ","زَاراً يُزلزَلُ منه الطَّودُ والجَلَدُ",143,"د",1,0],["وأنبوبة تنساب منها سوائلٌ","تردّ هواءَ الجو يُعمى ويبكمُ",144,"م",1,0],["وإنّ بين الأنامِ فَرْقا","فما كسولٌ كذِي اجتهادِ",145,"د",1,0],["وَإِن بَلِيَت أَوصالُهُ وَعِظامُهُ","فَعِندي ثَناءٌ لا يُلِمُّ بِهِ البِلا",146,"ل",2,0],["وَإِن بانَ وَثّابٌ فَما ضَيفُ مُسلِمٍ","كَمَن شَطَّ عَن بَحرٍ وَيَمَّمَ جَدوَلا",146,"ل",2,0],["وَإِن باتَ في أُخراهُمُ مُتَعَقِّباً","تَكُن أَوَّلاً مِنهُم إِذا الفَضلُ أَوَّلا",147,"ل",2,0],["وإن بنى الدنيا ودنياهم معاً","لنهبة أسباب الردى وحصيده",148,"د",2,0],["وإنّ بأكناف المرية منهم","لفدُّ السجايا والحلى والمناقب",149,"ب",1,0],["وَإِن بَلَغَ المَطلوبََ بالمَدحِ مُجتَدٍ","بَلَغنا بِمَدحِ الهاشميِّ مُحَمَّدٍ",150,"د",1,0],["وإِنْ بَدا لَكُما مِنْ سَيِّدي غَضَبٌ","فَغَالِطاهُ وَقولا لَيسَ نَعْرِفُهُ",151,"ف",2,0],["وأنبتت منه واهتزت به وربت","وبارك الله للأقوام في قدمه",152,"م",2,0],["وإنْ برقَتْ غزالةُ وجْنتيْه","حسبتَ الشمسَ ناظرةَ الغَزالِ",153,"ل",1,0],["وَأُنبِيكُما أَنّي عَلى ما عَهِدتُما","إِذا ضَيَّعَ العَهدَ المَلُولُ المماذِقُ",154,"ق",1,0],["وإن بدت نعمة لله سابغة","أو أبصروا من صنيع الله لي طرفا",155,"ف",2,0],["وَإِن بخلَ الغمامُ بطلّ غيثٍ","هَمَت يُمناك للعافين وبلا",156,"ل",2,0],["وانبرى للريح والموج","فلم تُغن الشجاعه",157,"ه",1,0],["وان بغتك صروف الدهر غائلةً","فزعزعتك تجد منهم اساطينا",158,"ن",2,0],["وَأُنبِئتُ أَن قَد أَلزَموكَ نُفوذَهُ","وَذَلِكَ لِلجيرانِ عَزلٌ بِمَعزِلِ",159,"ل",1,0],["وَأُنبِئتُ أَن قَد أَحرَمَ الغُسلَ عامِرٌ","وَأَنّي لَراضٍ عَنكَ ما لَم تُرَجَّلِ",159,"ل",1,0],["وان بان بان الحي من نحو طيبة","فأطلق زمان الشوق واحبس به الظعنا",160,"ن",2,0],["وان بدا لكما من وجهه غضب","فغالطاه وقولا ليس تعرفه",161,"ه",1,0],["وإن بغمَت عن صوته العذب بغمةٌ","فوسواسُ لحن الراح عن فيه ينقل",162,"ل",1,0],["وَاِنبَرَت تُقَلِّدُهُم","مِن سمائِها السُحُبُ",163,"ب",1,0],["وإنْ بَدَا من صاحبٍ بعضُ ما","يأتي به السُّكْرُ عَذَرْناه",164,"ن",3,0],["وَانْبَرَى النِّسْرينُ يُهْدي ذَهَباً","في صِِحَافٍٍ مُفْرَغَاتٍ منْ دُرَرْ",165,"ر",1,0],["وَانْبُذَنَّ الْخَلْقَ طُرّاً بَعْدَ مَنْ","كَانَ فِيهِ الْخَلْقُ طُرّاً جُمِعَا",166,"ع",2,0],["وإن بدت طلعته في ليلة","من شعره رأيت ليلا مقمرا",167,"ر",2,0],["وإن بدت من صاحب زلةٌ","فاستُرهُ بالإغضاء واستبقه",168,"ق",2,0],["وان بَخلوا واِستَغلو الحمدَ مُرخَصاً","رأى أَرخصَ الأَشياءَ حَمداً وان غَلا",169,"ل",2,0],["وان بَكاهُ الأَعادي راحِمين ضُحىً","لَمّا ثَوى فَلكَم أَبكاهُمُ حَسَدا",170,"د",2,0],["وإن بدا لي وجهه طالعاً","صفعت بالشمس قفا البدر",171,"ر",1,0],["وآن بأن يحمي الوطيس على المنى","ويضرم من جيش المنايا سعيرها",172,"ر",3,0],["وان بت في شك على شكر فضلها","شككت بحكم الله والكتب والرسل",173,"ل",1,0],["وآن بأن يتلو انحناؤك مفصحاً","لسمعك من تلقين ضعفك مصحفا",174,"ف",2,0],["وأنبئت أخوالي أرادوا نقيصتي","بشعواءَ فيها ثاملُ السمِّ منقعا",175,"ع",2,1],["وإن بسمَ الجمالُ صبا إليه","فأصلُ بليّتي القلبُ الحنون",176,"ن",1,0],["وإن بعدت دارٌ وشطَّ مزارُها","فللرُّوحِ مع روحٍ تُجاذبُها نجوى",177,"و",2,0],["وإن بعدوا عنّي دَنوتُ مُصافحاً","وإن أذنبوا عمداً فأعفو وأصفَح",178,"ح",1,0],["وان بليت باحكام الزَمان فَلا","تجزع فللدهر اقبال وادبار",179,"ر",1,0],["وان بك خاطب الاموات عيسى","فاز الجذع حن لذا وأَنا",180,"ن",2,0],["وَإِنَّ بِلاداً أَنْتَ حائِطُ ثَغْرِها","بِسَيْفِكَ قَدْ عَزَّتْ وَعَزَّ نَظِيرُها",181,"ر",3,0],["وَإِنَّ بُلُوغَ الْوَفْدِ ساحَةَ مِثْلِهِ","يَدٌ لِلْمَطايا لا تُؤَدّى حُقُوقُها",182,"ق",3,0],["وإن بني البسيطةِ كيفما هم","سبيلهمُ إلى هذا السبيل",183,"ل",1,0],["وَإِن بَكَيتُ لَدى مَن قَد كَلِفتُ بِهِ","لِما أُعانيهِ مِن وَجدٍ بِهِ ضَحِكا",184,"ك",2,0],["وإِن بدا لكما من وجهه غَضَبُ","فغالِطاهُ وَقولا لَيسَ نعرفُهُ",185,"ه",1,0],["وإِن بتحريمِهِ أَفتى مكابرةً","أَبو كثيرٍ فدَعهُ والَّذي زَعَما",186,"م",2,0],["وإن بليت بفقر فارض مكتفياً","بالله ربك أرح الفضل وارتقب",187,"ب",1,0],["وأنب إلى دار الكرامة والبقا","وعن الدنية كن أخي متجافي",188,"ف",2,0],["وأنبتها من كل زوج بثمره","وأزهاره تمتبع نفس وناظر",189,"ر",1,0],["وأنبتها زرعاً وعشباً مزهراً","بأزهاره ريح الجنوب تفوح",190,"ح",1,0],["وَأنبت خيرَ الدين في تقريرها","بِفصاحةٍ تزري على سحبانِ",191,"ن",1,0],["وَأنّ بِهِ شهب الفوارس ألبست","زمامَ الثريّا وهي مصحبة جنبا",192,"ب",2,0],["وَأنّ بِه شاكي السماكينِ حاجب","وَقَد نيطَ بهرامٌ إلى خصره عضبا",192,"ب",2,0],["وَأنّ بهِ زهر المَنازلِ نزّل","وَجَبهتها تلقى بإكليلها التربا",192,"ب",2,0],["وَإِن بَدا لَكُما في وَجهِهِ غَضَبٌ","وَقَد تَلاعَبَ تَحتَ الجَفنِ مُرهِفُهُ",193,"ف",2,0],["وَأَنبَأَ أَنَّهُ سَينالُ نَجحاً","وَفي العُمرِ المَديدِ يَظَلُّ يَمرَحُ",194,"ح",1,0],["وَإِن باحث العذّال فيما اِدّعيته","لعمر أَبي إنّي بِذاك أُباحثُ",195,"ث",1,0],["وإن بقيت فجَلدُ ذو مواطحةٍ","أسقي العدو نقيع السمِّ والسلَعا",196,"ع",2,0],["وَأَنبَتَ في الخدّر وَض الجمال","وَلكِن سَقاه بِماء اللَهَب",197,"ب",1,0],["وإنْ بدا غائصاً في بَحْرِ أنْمُله","ألْقَى إلى الطِّرْسِ من أسْنَى لآليه",198,"ي",2,0],["وأنّ بني الآمالِ حَلْيُ بني العُلا","وأنّ ذوي الإفضال ذُخْرُ ذوي الفَضل",199,"ل",1,0],["وانبَثَّ يُشيعُ عينَه نظَراً","منه ويَخبُرُ أمْرَهُ خُبرا",200,"ر",2,0],["وَإِن بَدَرَت كفَّاهُ كفّيَ سُرعَةً","فَخَلُّوا عن الشيخِ الكبيرِ المُمارسِ",201,"س",1,0],["وَإِن بَدَأتَ الكِتابَ في رَجَبٍ","وَيُسِّرَ الأَمرُ لَم يَحُل رَجَبُ",202,"ب",1,0],["وَأَنَّ بَني الدُنيا مَعَ الشَيبِ وَالصِبا","لَهُم وَعَلَيهِم غَيبَةٌ وَحُضورُ",203,"ر",1,0],["وَإِنَّ بِلاداً ما اِحتَلَت بي لَعاطِلٌ","وَإِنَّ زَماناً ما وَفى لي لَخَوّانُ",204,"ن",1,1],["وإن بَصُرتَ بهِ والقاصِدُونَ لهُ","من حَولهِ خِلتَهُ والنَّاسَ إخوانا",205,"ن",2,0],["وإن بعَّدَت آراؤهُ البِيضَ قَبلَهُ","فَأتباعُها حُمرُ المَنايا وجُونُها",206,"ن",3,0],["وانبَسِط في شَتيمَتي ودَع العا","لَم يَهذو فالعِرضُ عرضُ صَديقِك",207,"ك",1,0],["وإن بني الدنيا تميل لموسرٍ","وتعرضُ عن خلٍّ أُذيعَ شقاؤه",208,"ا",3,0],["وَاِن بَرَزت في محلِّ الصوا","بِ عَمياءُ لا تَجتَليها الفِكَر",209,"ر",1,0],["وَاِنبَرَت تَبغي حُسَيناً","وَعَرَتهُ وَعَراها",210,"ا",3,0],["وإنَّ بِأَطرافِ المُلَيلِ لَنِسوةً","ذَلولاً بأَردافٍ ثِقالٍ رَسِيمُهَا",211,"م",3,0],["وإنْ بَعُدَتْ عَنْ رَأي عَيْنِكَ فَاقَتي","فإِنّ افْتِقَاري مِنْ نَداكَ بِمَشْهَدِ",212,"د",1,0],["وإن بدا كَلَفٌ في وجهِ مكرُمَةٍ","جلا بلا كُلَفٍ عَن وَجهِهِ الكَلَفا",213,"ف",2,0],["وإنْ بخِلْتَ بوُدَّ أو مجاملَةٍ","فهُدْنَةٌ كيفَما كانَتْ على دَخَنِ",214,"ن",1,0],["وانبَرَى دونَ ضوئهِ وتَجَلِّي","هِ نِقابٌ يَضِلُّ رأيَ النِّقابِ",215,"ب",1,0],["وَإِنَّ بِقَلبي نَحوَهُنَّ لَغُلَّة","يقوِّم معوَجَّ الضُلوعِ زَفيرُها",216,"ر",3,0],["وَإِن بَّيَتَ الأَعداء أَمراً رَماهُمُ","صَباحاً بَخيلٍ لا تُرَدُّ وَلا تَكبو",217,"ب",2,0],["وإنّ بلاداً ضاق عنّي فضاؤُها","لأرحَبُ من أكنافِها للعُلا فِترُ",218,"ر",1,0],["وأنَّ بها من الأَشجانِ داءً","أعندك يا هذيم لها دواء",219,"ا",2,0],["وإنْ بارَزْتَ بالبرهان قوماً","تحامى من يرومك في نزالك",220,"ك",1,0],["وإنَّ بني أهليك لله درّهم","أَكابر أَقوام نمتهم أكابر",221,"ر",1,0],["وإنَّ بني السّعدون بالجود والنَّدى","لأشبَهُ شيءٍ بالبحور الزَّواخر",222,"ر",1,0],["وإن بدت وظلام الليل معتكر","رمت شياطين هم المرء بالشهب",223,"ب",1,0],["وأنَّ بني العلياء ضاقت صدورها","لفقدان ذاك السيّد المتصدر",224,"ر",1,0],["وأنْبتَّ بالتقوى بأحسن منبتٍ","وقد طاب أصلاً مثلما طاب محتدا",225,"د",2,0],["وَإِن بادَهوني بِالعَداوَةِ لَم أَكُن","أَبادُهُم إِلّا بِما يَنعَت الرُشدا",226,"د",2,1],["وإن بدا منك عيبٌ فاعترف وأقم","وجه اعتذاركَ عمّا فيك منكَ جرا",227,"ر",2,0],["وأن بها أهل البلاغة والحجى","فقلت نعم والفضل في صدرها علي",228,"ي",1,0],["وإن بدا تشرين والبازي نشا","في حسن تدبير فصد بما تشا",229,"ش",2,0],["وإن بالناطور نعني الراقبا","يرقب طيراً حاضراً أو ذاهبا",229,"ب",2,0],["وأنبئت أقواما لئاما تعرّضوا","بعرضي وفاهوا في أحاديثهم لعزا",230,"ز",2,0],["وإن بدأت يمين يديه جودا","فإن شماله حقا تعيد",231,"د",1,0],["وإن بعدت أيدي النوى عن مزاركم","فقلبي على عهد من الحبّ موثق",232,"ق",1,0],["وأنبئت من لي في رضاه مصالح","تهدّدني إذ رأيه في واهم",233,"م",1,0],["وإن بابك يولي قاصد بك علا","كأنما الشمس منك الدهر في الحمَلِ",234,"ل",1,0],["وإنْ بُدِّلَتْ منها السَكاكِينُ خِلْتَها","غماماً صائِرُ",235,"ر",1,0],["وإِنْ بَرَتِ الأَيَّامُ مِنْ حَدِّ هِمَّتِي","وفَلَّتْ سِلامُ الحادِثاتِ غِرَارَيَّا",236,"ي",2,0],["وإِنَّ بلاداً أَخرجَتنِي لَعُطَّلٌ","وإِنَّ زَماناً خان عَهدي لَخَوَّانُ",237,"ن",1,0],["وإن بقيت فما لي عن زيارتكم","عذر إذا وفق الباري وطال بقا",238,"ق",2,0],["وإن بتوحيدي لك اللَه وافدٌ","مع الوفد أرجو منك جائزة الوفد",239,"د",1,0],["وإِن بقي للذي يبقى على أَسف","بنو أخيك فنعم القادة النجد",240,"د",1,0],["وإِن بشير بقى من بعده خلفا","وصنوه أحمد بيت العلا عمرا",241,"ر",2,0],["وإِن بدا الصبح موشيا أكارعه","أبكي فأسقي الربا بالأدمع الذرف",242,"ف",1,0],["وإن بدا الصبح هيجت الحمام على","أعلى الأَشى ونهاري صار حلكوكا",243,"ك",2,0],["وإن بقيت أعمامه الغر وابنه","وإخوته فالحزن ليس بلازم",244,"م",1,0],["وإنّ بواسطَ جوداً يكون","لرأسٍ عِقالاً ورجلٍ شكالا",245,"ل",2,0],["وإنّ ببابلٍ منهم لطَوداً","يضعضع كلَّ أرعنَ مشمخِرِّ",246,"ر",1,0],["وإن بلغَ الشكرُ حقَّ امرىء","فغايتُها مَعَك الإنتصارُ",247,"ر",1,0],["وإنّ ببابلٍ منكم لبحراً","لو أنّ البحرَ جاد كما يجودُ",248,"د",1,0],["وأَنبضَ من يديه لي غديراً","وقد أعيا فمي مَصُّ الثِّمادِ",249,"د",1,0],["وانْ بعت آمالي من المجد والعُلى","مبيع الكُسالى بالمواطنِ والأهْلِ",250,"ل",1,0],["وانْ بات يثنيني عن العزم موعِدٌ","بكى الفضل من اِنجازه لأولي الجهل",250,"ل",1,0],["وَإِنَّ بِقَومٍ سَوَّدوكَ لَحاجَةً","إِلى سَيِّدٍ لَو يَظفَرونَ بِسَيِّدِ",251,"د",1,1],["وَإِنَّ بَني حَربٍ كَما قَد عَلِمتُمُ","مَناطَ الثُرَيّا قَد تَعَلَّت نُجومُها",252,"ه",2,1],["واِنْ بَخِلَتْ غوادي السُّحبِ يوماً","فسحبُ الدمعِ مُثْقَلَةٌ عِثارُ",253,"ر",1,0],["وإن بت بجعجاع","لقد بتنا بأوجاع",254,"ع",1,0],["وإن بت بين الذروتين بفرجتي","خرسان خل العين منك بمكة",255,"ه",1,0],["وانْبِلاجِ الأشْكالِ لَوناً فَلَوْناً","بِبُروزِ المُفَسِّرِ الضَّوْئيِّ",256,"ي",1,0],["وانْبَلجتْ أنْسابُهُمْ","فهي أنابيبُ الرِّماح",257,"ح",1,0],["وانْبشِ الأرضَ فأين يكْثر المو","تُ فريحُ أجنبيٍّ لو عَقَلتا",258,"ت",2,0],["وأنبتَ في فؤادِ الصُّبحِ رَوعاً","فها كافورُه كالزّعْفَرانِ",259,"ن",1,0],["وإن برقت سني لذكر حكاية","فإن فؤادي ماحييت كئيب",260,"ب",1,0],["وإن بسمت يوماً بروق سيوفه","ذهلت به عن بارقات المباسم",261,"م",1,0],["وإن بارَاهُ ذُو سَبْقٍ","فَمنْ ذاكَ تَرَى مِثلهْ",262,"ل",2,0],["وإن بَدا غاضِباً فالقَلبُ في وَجَلٍ","والطَّرفُ في ذَهَلٍ والجسمُ في شَلَلِ",263,"ل",1,0],["وإن باتَ يسكُبُ من دمعِه","إلَى الفجرِ يَكفِيهِ ما قد سَكَب",264,"ب",1,0],["وإنْ بنتَ فما أنتَ","كقومٍ بالرّدى بانوا",265,"ن",3,0],["وإِنْ بتَّ ملآنَ الجفونِ من الكرى","فإنّ الّذي نازعتَه الغُمضَ ما أغفى",266,"ف",2,0],["وَإِن بَسطوا لَم تَلقَ في الخلق قابضاً","وَإِن قَبضوا لَم تلقَ في الخلقِ باسطا",267,"ط",2,0],["وَإنْ بقيتُ فَللعلياءِ أَركبها","وَالمَجد ما بين تصبيحٍ وتغليسِ",268,"س",1,0],["وَإنَّ بِنا وَما يَدري المعافى","شَجىً في الصّدرِ يَعتلجُ اِعتِلاجا",269,"ج",2,0],["وإنّ بَعيدَ شيبكِ وهو آتٍ","نظيرُ بياض مفرقيَ القريبِ",270,"ب",1,0],["وإن بدا خفيت في نوره وإذا","بدت ففيها اختفى لا تدرك الشفقا",271,"ق",2,0],["وإن بلاداً زرتها لوضيئة","وإن احتفالاً لم يكن بك قاتم",272,"م",1,0],["وإِن بكَيْتُ فنكِّبْ عن مُجَاوَرَتي","واحذَرْ وإِيَّاكَ من طُوفَانِ أَجْفَاني",273,"ن",2,0],["وإِنَّ بَقَائِي من بعدِه","قبيحٌ وإِنَّ حياتِي جفاءُ",274,"ا",2,0],["وإِن بَدَا بِيَ كَلْمٌ في الحَشا فَنَدي","عبد الرَّحيمِ لذِاكَ الْكَلْم كْالآسِي",275,"س",2,0],["وإن بت تحت الترب فالترب تحته","شعوبٌ وأمصارٌ وقد نُسي الحزن",276,"ن",1,0],["وَإِنْ بَدا رَوْضُ خَدَّيهِ وَوَجْنَتِه","أَغْنَتْ بأَزْهارِهَا عَنْ سَائِر الفُرَجِ",277,"ج",1,0]]}