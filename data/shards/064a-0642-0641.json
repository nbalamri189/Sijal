{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[90,"أبعد الدهر في الفضاء مكره","https://www.aldiwan.net/poem45074.html","الخفيف"],[74,"أذكى سنا البرق في أحشائه لهبا","https://www.aldiwan.net/poem18234.html","البسيط"],[53,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[47,"يفندون وهم أدنى إلى الفند","https://www.aldiwan.net/poem63480.html","الوافر"],[47,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[30,"ورث الخلافة سبعة آباءه","https://www.aldiwan.net/poem5216.html","الكامل"],[68,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[82,"حتى متى بين اللوى فالأجرع","https://www.aldiwan.net/poem31391.html","الرجز"],[48,"إن كنت صاحب إخوان ومائدة","https://www.aldiwan.net/poem22130.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[108,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[96,"يا جارتي","https://www.poetsgate.com/ViewPoem.aspx?id=15618",""],[146,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[164,"الفرق بين الكفر والإيمان","https://www.aldiwan.net/poem59187.html","الكامل"],[189,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[231,"البطل","https://www.aldiwan.net/poem24226.html","عموديه"],[236,"ما هز البرق سيفه أو ضحكا","https://www.aldiwan.net/poem44549.html","الدوبيت"],[276,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[310,"مولاي أهدي نحو مجلسك العلي","https://www.aldiwan.net/poem56431.html","البسيط"],[333,"رقرقت فيك ملاحني وغنائي","https://www.aldiwan.net/poem54944.html","الكامل"],[422,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[543,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[543,"الشبل قد تبع الأسود وقد غدا","https://www.aldiwan.net/poem48220.html","عموديه"],[556,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146220","الرجز"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216947","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26457","الرجز"],[2344,"","https://poetry.dctabudhabi.ae/diwan/poem/131384","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137162",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204861","السريع"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74297","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48427","السريع"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102388","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34712","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128944","الرجز"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[4755,"حَمَلَ الدُّرُوبَ حَقِيبَةً.. ومَشَى","https://www.poetsgate.com/ViewPoem.aspx?id=191943",""],[4578,"لولد لي الأنس بعيش رغيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=49399",""],[5026,"منبطحون على رصيف الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=211278",""],[5061,"محمد بن الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147169",""],[5106,"مِنْ ضَوْءِ أَلْفِ صَبَاْحٍ قَدْ سَرَىْ","https://www.poetsgate.com/ViewPoem.aspx?id=150036",""],[5107,"في لحظة يأ س","https://www.poetsgate.com/ViewPoem.aspx?id=34342",""],[5145,"ناصر الإسلام عيد ألف عام","https://www.poetsgate.com/ViewPoem.aspx?id=108072",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[307,"ملكة الدار","https://www.poetsgate.com/ViewPoem.aspx?id=214581",""],[5370,"عقارب الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=85520",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5470,"ثغرٌ تلألأ","https://www.poetsgate.com/ViewPoem.aspx?id=11005",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5691,"قالها شافيز...!","https://www.poetsgate.com/ViewPoem.aspx?id=207080",""],[6089,"علقت أيامي","https://www.poetsgate.com/ViewPoem.aspx?id=213644",""],[6117,"بهوُ الجمَال","https://www.poetsgate.com/ViewPoem.aspx?id=182786",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""]],"verses":[["يَقِفُ الحَقُّ عِندَهُم فَيُلاقي","طُرُقَ الجودِ بَينَهُم أوعارا",0,"ر",2,0],["يقْفو الشّادةَ باليَمينِ وإنّهُ","لمؤمَّنٌ منْ أنْ يُعَدَّ فَسيسا",1,"س",2,0],["يقف الفكر دونها مكوئداً","مقشعرّاً وتأخذ العقل حيره",2,"ر",2,0],["يقفو أخٌ في المعالي والعلومِ أخاً","فبطلع الكلُّ في آفاقها شهبا",3,"ب",2,0],["يَقفده معشرٌ ويشتمني","وثأرُه في أصابع القَفَدَهْ",4,"د",2,0],["يَقِفانِ في جَنبِ الدِما","كَالعُذرِ في جَنَبِ الجِنايَه",5,"ا",3,0],["يَقفونَ مِنهُ خِلالاً كُلُّها حَسَنٌ","إِن عُدِّدَت غادَرَت فَضلاً عَلى العَدَدِ",6,"د",1,0],["يَقفونَ هَديَ أَبي العَبّاسِ في سَنَنٍ","يَرضاهُ سامِعُهُ الأَقصى وَدانيهِ",7,"ي",2,0],["يَقِفونَ يَنتَظِرونَ خَلفَ ظُهورِنا","حَتّىنَميلَ بِعارِضٍ مُثعَنجِرِ",8,"ر",1,0],["يُقفِلُ عِندَ الأَكلِ أَبوابَهُ","خَوفاً عَلى الزادِ مِنَ الكَبسِ",9,"س",1,0],["يَقْفُو رَذايا جُنَّحاً في السير لا","تُوضَعُ عَنهُنَّ سِياطُ المُزْمعِ",10,"ع",1,0],["يَقفو اللَئيمُ كَريمَ القَومِ مُكتَسِباً","إِنَّ السَراحينَ يَتبَعنَ السَراحيبا",11,"ب",2,0],["يقفو خطاها وهي بين الطيور","لها جناحان مراحٌ ونور",12,"ر",1,0],["يقفز من لجةٍ إلى حجَرٍ","كأنما مَسَّ روحه الضَّجرُ",13,"ر",1,0],["يقفون والفَلكُ المحرَّ","ك دائبٌ في سيره",14,"ر",2,0],["يقفزن في كأسي فلا أنثني","عن خمرة الكأس ولا ينثنين",15,"ن",1,0],["يَقِفْنَ حوافلَ في عرصتي","ك حتى تُساوى الوِهادَ الإِكامُ",16,"م",1,0],["يقِف الثناءُ عليه وقفةَ حائرٍ","ممّا تسُنُّ له يداه وتشَرَعُ",17,"ع",1,0],["يقفون آثار النبي وصحبه","والتابعين لهم على الإحسان",18,"ن",1,0],["يَقْفُو الرَّدى في كل هَوْلٍ سيفه","فهو الدليلُ له بكل عَجاج",19,"ج",1,0],["يقف الهول لديه خاشعا","وهو يلقى الهول بسّام الرضاء",20,"ا",2,0],["يقفو أثر الغرام أنى سلكا","إما المأمول أو ذهاب العمر",21,"ر",1,0],["يَقفون في أثرهم آثار وَالدهم","حكم التَوابع في عطف وابدال",22,"ل",1,0],["يَقفوهُ مِن أرجِ الدعاءِ تقبّلاً","عن ظهرِ غيبٍ دعوة الخلّ الولي",23,"ل",2,0],["يقفون والفلك المحرك دائر","ماض مضيّ البارق العدّاء",24,"ا",2,0],["يَقِفُ المغرمُ فيها وقفةً","يخضل السَّيف عليها والنجادا",25,"د",2,0],["يَقفو ظُهورَ الكائِناتِ بحَدسِه","فيَرى وُجوهَ الغَيبِ في مِرآتِهِ",26,"ت",2,0],["يقفُ فِكرُ المَرءِ فيه صَاغِرا","أمَام واقعٍ ألمّا يَصدُقِ",27,"ق",1,0],["يقفُو الجدودَ بِسَيره مُتَنزِّها","مُتأدِّبَا مُتَديٍّنا متهجِّدا",28,"د",2,0],["يَقِفْنَ فيستوقفن لَحْظَ عيوننا","فما هنّ للأبصار إلّا كُبولُها",29,"ل",3,0],["يقفو نعاماً وارداً","وصادراً حيث سكع",30,"ع",1,0],["يَقِفُونَها بِالزّادِ وهي أثيْرةٌ","مَعْصُوبَةُ الحِقْوينِ من حذرِ الخَوَى",31,"ا",1,0],["يقفوه آل بيته الأطهار","وصحبه الأكابر الأخيار",32,"ر",1,0],["يَقفونَ آثاراً عَلى","جَذبَةِ خَيطِ القُنَّبِ",33,"ب",1,0],["يقفو الهوى بقتاده سلطانُه","والنفسُ والشيطان من أعوانه",34,"ن",2,0],["يقفو سبيل جدوده فيها وما","يعدو الذي شرعوه من احكام",35,"م",1,0],["يقفز قلبي هانئاً مثلهم","وكان في هم وتنكيد",36,"د",1,0],["يَقفون عِندَ رُبوعه فَكَأَنَّما","أَبياته للجود أَضحَت محشرا",37,"ر",2,0],["يَقف الزَمان وَأَنتَ تَم","شي في طَريقكَ لا تملُّ",38,"ل",1,0],["يقْفو بنو الآدابِ آثارَها","ما الرَّكْبُ إلا تابِعٌ حادِيَهْ",39,"د",3,0],["يقفْ عاشقٌ لم يبقَ من روحِ نفسِهِ","ولا عقلِهِ المسلوبِ غيرَ التوهُّمِ",40,"م",1,0],["يقف الوهم لديها حاسراً","كلما تجري انخفاضاً وانتصابا",41,"ب",2,0],["يَقِفُ الناسُ وَهوَ أَوَّلُ مَن يُد","خِلُهُ القَصرَ غادَةٌ عَطبولُ",42,"ل",1,0],["يقفز فوق العشب في الحقول","وتارة يعلو على التلول",43,"ل",1,0],["يقف الشاعر المفكر مسحورا","حجاه من منظر فتان",44,"ن",1,0],["يَقِفُ الهُنَيْهَةَ ثُمَّ يَخرُجُ مِن","هَذَيَانِهِ مُتَزَمِّلًا غَبَشَا",45,"ش",2,0],["يقفو طريق الجد سامي العلى","معتصماً بالله هادٍ رشيد",46,"د",1,0],["يقفونَ في طَللِ القُدامى والمدى","تَغْتالُ زرقاءُ اليمامةِ بابَهْ",47,"ب",2,0],["يقفي عن المخذول ﻻمن تحاكا","ويقول مخذول وردي ليه احاكيه",48,"ي",2,0],["يَقْفِلْ بَأَبْحُرِهِ عَنْ سَمْتِ قَاْمَتِهِ","مَاْ الشِّعْرُ بَالِغُهُ .. وَالصَّمْتُ وَاْفِِيْهِ",49,"ي",2,0],["يقفو خطى الوهم مشدوداً إلى حلم ٍ","صعب المنال ، ويقفو خطوه الأجلُ",50,"ل",1,0],["يقف الأعلاق منها رغبةً","في ثوابٍ سوف يبقى مستدام",51,"م",1,0],["يقف النبض منك ساعة تودي","عي فلا دقة ولا إصغاء",52,"ا",2,0],["يقفو خطا الآيات لما فصلت","بالنص مأخوذا بسحر بيانه",53,"ن",2,0],["يقفُ الزمانُ إذا البلوغ مقاربٌ","فغدا بأعوامِ الصبا معدودا",54,"د",2,0],["يقفي وانا اطالع الخطوات واحسبها","وعدّيت لين العد ما عاد يكفيني",55,"ن",2,0],["يقف العدل أينما وقف الفت","ح ويمشي إذا مشى الفتح ميلا",56,"ل",2,0],["يقفو دجاك بشمس مقلته","لو أن قنديل المساء خبا",57,"ب",2,0],["يَقِفُ المُحِّبُّ على الطُّلُولِ بِحُزنِهِ","لِيَزُفَّ مِن سُحُبِ البُكَاءِ دُمُوعَا",58,"ع",2,0],["يقْفونَ خُطاها ككِلابٍ","لحِراسَتِها وهُمُ الرَّدْفُ",59,"ف",1,0],["يَقِفُ الحُرُّ لدى إغْضابِهِ","أسَداً يَزْأرُ في أثْوابِهِ",60,"ب",2,1],["يقف الزمان مهابة لجلالها","ويحيطها فخرا بها الشعراءُ",61,"ا",1,0],["يقفُ المريدُ بصمتهِ متوجساً","حذرَ الحديثِ ليستبينَ لقاءَها",62,"ا",3,0],["يقف عليها بكبوته وبنبوته","والنسافات دي بشلوته من وحده تطير",63,"ر",1,0]]}