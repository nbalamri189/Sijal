َبْغِ الحَقيقَةَ عِنْدَهُ","وَإِنْ شِئْتَ أَنْ تُكْفَى أَذاهُ فَغَالِطِ",2,"ط",1,0],["هُوَ الدّهْرُ لكِنْ عدْلُهُ وسَماحُهُ","يرُدُّ صُروفَ الدّهْرِ راغِمَةَ الأنْفِ",3,"ف",1,0],["هوَ الدّهْرُ ذو وجْهَيْنِ يوْمٍ ولَيلَةٍ","ومَنْ كان ذا وجْهَيْنِ يُعْتِبُ في غَدْرِ",4,"ر",1,0],["هَوُ الدَّمْعُ إِنْ شَحَّتْ لِخَطْبٍ عُيُونُهُ","عَلَى ابْنِ أَبي عَمْرو يُذَالُ مَصُونُهُ",5,"ه",1,0],["هُوَ الدَهرُ فَاصبِر لِلَّذي أَحدَثَ الدَهرُ","فَمِن شِيَمِ الأَبرارِ في مِثلِها الصَبرُ",6,"ر",1,1],["هُوَ الدَهرُ مَهما أَحسَنَ الفِعلَ مَرَّةً","فَعَن خَطَإٍ لَكِن إِساءَتُهُ عَمدُ",7,"د",1,0],["هُوَ الْدَّهْرُ كَالتَّيَّارِ يَكْتَسِحُ الْوَرَى","بِلَيْلٍ مِنَ الأَحْدَاثِ أَعْكَرَ أُهْيَمَا",8,"م",2,0],["هو الدينار مُنية كل راج","وبغية كل من دَأب احترافا",9,"ف",2,0],["هو الدهر لم يسلم من الغيّ أهله","كما الليلُ لم يأمَنْ من الشر حاطبه",10,"ب",2,0],["هو الدهر لم يترك مَشَنَّ غِواره","على سابق من ليله أو نهاره",11,"ر",2,1],["هو الدهرُ إمَّا عابطٌ ذا شبيبة","بإحدى المنايا أو مُمِيتٌ أخا هرمْ",12,"م",1,0],["هو الدهرُ مُصْغٍ إلى سائلٍ","وليسَ بِمُصْغٍ إلى لائمِ",13,"م",1,0],["هُوَ الدَهرُ مِن ضِدَّينِ ذَل وَعِزَّةً","فَمَن ذَلَّ شاكيه وَمَن عَزَّ شاكِرُه",14,"ر",2,0],["هو الدهر او من قد توارى وراءه","يحطم ما يأتي ويبنى ويهدم",15,"م",1,0],["هُوَ الدَهرُ ميلادٌ فَشُغلٌ فَمَأتَمٌ","فَذِكرٌ كَما أَبقى الصَدى ذاهِبَ الصَوتِ",16,"ت",1,0],["هو الدّوحُ تهصرهُ العاصِفات","فينآدُ حيناً ولا يُقلعُ",17,"ع",1,0],["هُوَ الدَهرُ قَد أَعلى أَبا جَهلٍِ الَّذي","أُطيعَ بِأَرضِ الأَكرَمينَ الأَطايِبِ",18,"ب",1,0],["هُوَ الدَمعُ مَوقوفاً عَلى كُلِّ دِمنَةٍ","تُعَرِّجُ فيها أَو خَليطٍ تُزايِلُه",19,"ل",2,0],["هُوَ الدَهرُ يَستَدعي الفَناءَ بَقاؤُهُ","عَلَينا وَتَأتي بِالعَظيمِ عَظائِمُه",20,"م",2,0],["هُوَ الدَّهْرُ يِجري في البَرِيَّةِ بأسُه","بُبؤسى وتَجري بالسُّعودِ صَنائِعُه",21,"ع",2,0],["هُوَ الدَهرُ مُغرىً بِالكَريمِ وَسَلبِهِ","فَإِن كُنتَ في شَكٍّ بِذاكَ فَسَل بِهِ",22,"ب",2,1],["هُوَ الدَهرُ لا يُشوي وَهُنَّ المَصائِبُ","وَأَكثَرُ آمالِ الرِجالِ كَواذِبُ",23,"ب",1,1],["هوَ الدهرُ يلحنُ في أهلِهِ","فيخفضُ مَنْ حقُّهُ يرفعُ",24,"ع",1,0],["هو الدَهرُ لا يخشَى الضَّعيفَ إذا رمَى","ولا يتّقِي إلا الجريءَ المُغامرا",25,"ر",2,0],["هو الدينُ لا دِينُ الجهَالةِ والعَمى","وهل يستحِبُّ الجهلَ من كان ذا حِلْمِ",26,"م",1,0],["هُوَ الدّمُ لا يَشْفي من الجهلِ غيرُهُ","إذا لم يُفِدْ فيه ضروبُ التجارِبِ",27,"ب",1,0],["هُوَ الدّاءُ العُضالُ لِمُبتغيهِ","وكلُّ الشَّرِّ في الدَّاءِ العُضالِ",28,"ل",1,0],["هو الدّيْنُ الذي يُحيي البرايا","ويُصلِحُ أمرَهم بعدَ اخْتِلالِ",28,"ل",1,0],["هُو الدُّرُّ غَار الدَّهرُ عَنهُ فَردَّهُ","لِمَعدنِهِ إذ مَالَهُ عِندهُ ثَانِ",29,"ن",1,0],["هُوَ الدُرُّ يُهدي الدُرَّ بَحرٌ مُكَدَّرٌ","زُعاقٌ وَذا يَهديهِ عَذبٌ مُرَوَّقُ",30,"ق",1,0],["هُوَ الدَهرُ قَد جَرَّبتَهُ وَعَرَفتَهُ","فَصَبراً عَلى مَكروهِهِ وَتَجَلُّدا",31,"د",2,1],["هُوَ الدَهرُ الَّذي لا بُدَّ مِن أَن","يَكونَ إِلَيكُمُ مِنهُ ذُنوبُ",32,"ب",1,0],["هوَ الدهرُ إلاّ أنّني لا أرى له","على غير من ناواه خَطباً ولا صَرْفا",33,"ف",2,0],["هُوَ الدَهرُ يَفنى وَنَفسي عَلى","وَناها وَكَونُ مُناها عَسِر",34,"ر",1,0],["هُوَ الداءُ لا يَنفَكُّ يُشكى وَيُشتَكى","وَلَو شاءَ رَبُّ الناسِ أَدرَكَهُ الحَسمُ",35,"م",1,0],["هو الدينُ ما في الدينِ غُنمٌ ولا غُرمُ","هو المغنمُ الوافي هو المقتنى الضَّخمُ",36,"م",1,1],["هو الدينُ دِينُ اللَّهِ يا قوم خالصاً","فإنْ تُلحدوا فيهِ فذلكم الظُّلمُ",36,"م",1,0],["هُوَ الدَّمُ والحقُّ المحتَّمُ فاعلموا","وللهِ ما يَقضِي له الأمرُ والحُكمُ",36,"م",1,0],["هو الدمُ واللحمُ ما يشتهي","هو الخمرُ والمتعةُ الطارئهْ",37,"ه",1,0],["هو الدستور منه جَنىً قطفْنا","ونهرُ حياتنا ملآنُ عَذْبُ",38,"ب",1,0],["هُوَ الدَّاءُ فاسْتأَصِلْه تَلْبَسْ جَمالَها","وَداءُ كُعُوبِ المُنْحِسِينَ عُضالُ",39,"ل",1,0],["هُوَ الدَهرُ لا يَرعى الكَريمَ فَيَرعَوي","وَلا صَرفُهُ يَكتَفُّ عَنهُ فَيَكتَفي",40,"ف",2,0],["هُوَ الدَهرُ يُبكي إِذا أَضحَكا","فَما لَكَ تَضحَكُ مِمَّن بَكى",41,"ك",2,1],["هو الدهرُ ما بضَّتْ بخيرٍ يمينُه","يُجمِّعنا سهواً وينثُرنا عمدا",42,"د",2,0],["هو الدهر لا يبقى على حدثانه","جديد ولا ينفك عن حادث نكر",43,"ر",1,0],["هو الدهر يجري في البرية حكمه","فعز الغنى سيان أو ذلة الفقر",43,"ر",1,0],["هو الدين اما حاكمته خصومه","فقرآنُهُ يقضي عليهم مبينه",44,"ن",2,0],["هو الدهر قارعه يصاحبك صفوه","فما صاحب الأيام إلا المقارع",45,"ع",1,0],["هو الدهر لا خل يدوم ولا اخ","حوادثه الآيات تأتي وتنسخ",46,"خ",1,1],["هو الدليل هو البرهان عُرْوَتُهُ","وُثقى فمستمسك به بمتصل",47,"ل",1,0],["هُو الدَّهرُ إِن وَافَاكَ يَضحَكُ مُقبِلاً","فَسَوفَ يُولى كَالِحاً عَنكَ مُعرِضَا",48,"ض",2,0],["هُوَ الداءُ أَعيا الناسَ طُرّاً دَواؤُهُ","فَلَو غَيرُهُ كانَ الطَبيبَ لَأَعضَلا",49,"ل",2,0],["هو الدُّنيا لنا والدِّين","وهو الصَّحو والمطر",50,"ر",1,0],["هو الدهر كرَّت في المعالي كتائبه","وعضت بأنياب حداد نوائبه",51,"ب",2,1],["هُوَ الدَّهرُ لا يَبقى عَلى شَطرِ حالةٍ","فَبرْءٌ يَلي سُقماً وَيُسرٌ يلِي عُسرا",52,"ر",2,0],["هو الدينُ والإيمانُ والحلم إن هفا","وطاش على علم إليه يعود",53,"د",1,0],["هو الدهر لا يعدى على سطواته","فمن حظ محظوظ ومن طاح طائح",54,"ح",1,0],["هوَ الدهرُ عمّ الخلقَ شاملُ حكمهِ","وما عهدهُ في النائبات ذميمُ",55,"م",1,0],["هو الدهرُ آتيكَ أو ذاهبُ","وصادِقُكَ الوعد أو كاذبُ",56,"ب",1,1],["هو الدنيا وقد جنّت فصاغت","رحيق هواه من شهد وصاب",57,"ب",1,0],["هو الدهر يستثني المخلوف بالأمن","فلا بد من منع لديه ومِن مَنِّ",58,"ن",1,1],["هو الدهر ما أحداثه بقليلة","علينا ولا لذاته بكثير",59,"ر",1,0],["هو الدينُ والفرقانُ بالحقِّ مُنزَلٌ","لإصلاحِ دنياهم ومَنعِ الدنيّة",60,"ه",1,0],["هُوَ الدَهرُ يُرجى كُلَّ وَقتٍ وَيُتَّقى","هُوَ البَحرُ جوداً ما يُوافى لَهُ شَطُّ",61,"ط",1,0],["هُوَ الدَهر يَأتي بِيسر كَما","يَروح بِعسرٍ فَلا تَفرقِ",62,"ق",1,0],["هُوَ الدُرُّ مُذ نادوهُ باِسم مُحمّد","تَحلّى بِهِ جيد العلا وَتَرائبُه",63,"ب",2,0],["هُوَ الدَمعُ إِلّا أَنَّهُ اِبنُ جَلا الَّذي","يُجَمجِمُ عَنهُ مَن بِسِرِّكَ ما جَلا",64,"ل",2,0],["هُوَ الدَهرُ ثَنّى فِعلَهُ وَهوَ واحِدٌ","هَلِ الأُفقُ لَمّا غامَ غَيرُ الَّذي أَضحى",65,"ح",2,0],["هوَ الدَّهرُ وهيَ تصاريفُه","وما في سِواكَ لها مَدفَعُ",66,"ع",1,0],["هو الدهر إن تأمنهُ يخدعْكَ صاحبُهْ","فأبناؤه قد سالمتهم شوائبُهْ",67,"ب",2,1],["هُوَ الدَهر قَد يَسخو بِأَسباغ نعمة","وَلَكنها الأَيّام تُسرع بِالسَلب",68,"ب",1,0],["هو الدهر هذا طبعه مذ عرفته","يقدم أقدام الأنام على الرأس",69,"س",1,0],["هُوَ الدَّاءُ العَياءُ شَفَيْتَ منهُ","فما لِلدِّينِ من داءٍ عياءِ",70,"ا",2,0],["هو الدهر إن فكرت فيه دهارر","وإن كثير الناس في النسانس",71,"س",1,0],["هو الدين .. لا أعلى وأسمى وأجمل","من الدين في دنيا يمزقها البلا",72,"ل",2,1],["هو الدهرُ من قد بَعثرَ الخلقَ مثلما","تُبعثرُ ماءَ البحرِ ضرباتُ صخرةِ",73,"ه",1,0],["هو الدهرُ فالطّرس الصباحُ تبلّجت","ثناياه والنّقسُ الظلام إذا جنّا",74,"ن",2,0],["هو الدرُّ نثراً حيث وافى حديثه","ولكنّهُ نظمٌ لدى النحو والثغر",75,"ر",1,0],["هو الدمعُ أضحى بالغرامِ يُترجِمُ","وقد كانَ فيكَ الظنُّ قبلُ يُرَجَّمُ",76,"م",1,1],["هُوَ الدُّرُّ لا بَلء كالدَّرارِي بَلْ غَدا","كَبَدْرِ السَّما لا بَلْ هُوَ الشَّمْسُ إذْ تَبْدُو",77,"د",2,0],["هو الدَّهرُ يَحكي البَحرُ حالَ سُكونِه","إذا طالَ مَدُّ البَحرِ فانتَظِر الجَزرا",78,"ر",2,0],["هو الدّهرُ ينقضُ ما يبتنيهِ","جهاراً ويحصد ما يَزرعُ",79,"ع",1,0],["هو الدف والطنبور والوتر الذي","يسير به للوتر في الكون سائر",80,"ر",1,0],["هو الدنيا وما فيها","كتكريت وبغداد",81,"د",1,0],["هو الدَّهْرُ ذُو الحاليْن بؤسٌ ونعمةٌ","ولكنَّه في كُلِّ حَاليه يُلَبَسُ",82,"س",1,0],["هو الداء داء الجهل كل يقوله","ويطلب في الأفكار كل دواء",83,"ا",2,0],["هو الداعي إليه باحتجاج","فلم يدرك لدعوته سميعا",84,"ع",2,0],["هُوَ الدر الثَمين وَأَنتَ بَحر","كَذاك البَحر يَقذف صاحِ درّا",85,"ر",2,0],["هو الدَّهْرُ لا يُبقي على عائِذٍ به","فَمن شاءَ عيْشاً يَصْطَبِرْ لنوائبِهْ",86,"ه",1,1],["هو الدَّهرُ لا يُبقِي عَلى لائذٍ بهِ","فَمَنْ شاءَ عَيْشاً يَصطَبِرْ لِنَوائِبِهْ",87,"ه",1,1],["هو الدهر يمسى المرء في ليل أمنه","وقبل انشقاق الفجر يدهيه ختله",88,"ل",2,0],["هُوَ الدّرّة العَصماءُ وَالجَوهَرُ الّذي","بِهِ سابقُ الأَزمانِ فاتَ اِغتنامُهُ",89,"م",2,0],["هُوَ الدّينُ وَالدُّنْيا فَلَيْس لِطالِبٍ","وَلا راغِبٍ عَمّا لَدَيْهِ مُمِيلُ",90,"ل",1,0],["هو الدهر يأتي صرفه بالعجائب","يشوب بمر السلب حلو الموهب",91,"ب",1,1],["هو الدهر ذو وجْهين فعل منافق","وأحكامه تجري بكره الخلائق",92,"ق",1,0],["هو الدهر قد يُبدي الجميلَ وإنما","مَسرَّته مقرونةُ بمساتِه",93,"ت",2,0],["هو الدهر تغشى الكائناتِ نوائبُه","على الخلق تجري كل يوم عجائبُهْ",94,"ب",2,1],["هو الدهر مر حلوه ومآتم","مداعيه طرا والمُحَامي مقاتل",95,"ل",1,0],["هو الدهر ما صافي بنيه وما صفت","مَشَاربُه يوما لمَن جاء شاربا",96,"ب",2,0],["هو الدين موهوب لأعظم واهب","فعظّمه موهوبا ومَجِّده واهبا",96,"ب",2,0],["هوَ الداءُ المحاذر والدواءُ","ولو علمت بما في القلب منها",97,"ه",2,0],["هو الدهر إلا أنه غير خائن","هو البحر إلا أنه ما تكدرا",98,"ر",2,0],["هو الدين والدنيا هوالعلم والتقى","هو الغيث إلا أنه العلم أمطرا",98,"ر",2,0],["هو الدار في المحيط الأعظم","به انتظام عقده المنظم",99,"م",1,0],["هُوَ الدَهرُ لا يُعطيكَ إِلّا تَعِلَّةً","وَلا يَستَرِدُّ العُرفَ إِلّا تَغَنُّما",100,"م",2,0],["هو الدهرُ يأسو من أراد ويجرح","وأحداثه في الشمخ الشم تقدحُ",101,"ح",1,1],["هو الدهر لا تنفك تترى عجائبه","وتنشب في هذا الأنام مخالبه",102,"ب",2,1],["هو الدهر لا يبقى على حالة فما","ترى أخضرا الا وينتابه اليبس",103,"س",1,0],["هوَ الدَهرُ يَستَدعي الفَناءَ بَقاؤُهُ","وَتَستَصغِرُ الخَطبَ العَظيمَ مَصائِبُه",104,"ب",2,0],["هوَ الدَهرُ لا يُصغي إلى مَن يُعاتِبُه","وَلو عَظُمَت هِمّاتهُ وَمَآربُه",105,"ب",2,1],["هو الدَّهرُ ما تَبْنيه كفَّاك يهدمُ","وإن رُمْتَ إنصافاً لديه فَيَظْلِمُ",106,"م",1,1],["هو الدهر يقضي ما يشاء بعلمه","على كلِّ شيءٍ منه يعلمه الله",107,"ل",2,0],["هو الدليلُ عليه لا تذره سُدى","فالهلك في ترك ما الرحمن قد شرعا",108,"ع",2,0],["هو الدهر كم خضخضت كفه","برغم العلي في حشا المجد سهما",109,"م",2,0],["هُوَ الدَهر مثل اللَيث مَهَّد ظَهره","لِيُركب لَكن كَيفَ يَأمَن راكبه",110,"ب",2,0],["هُوَ الديمة الوَطفا إِذا انهل وَبلها","فَلا جبل يَبقى صَدياً وَلا سَهل",111,"ل",1,0],["هو الدهر لا تنفك تصبح خيله","منازل لم يبرح بها الطير ينعب",112,"ب",1,0],["هو الدهر احلى ما يكون به مر","فلا تغترر فيه وشيمته الغدر",113,"ر",1,1],["هو الدهر لا ينفك يبدى نوائبا","يجددها بالغى في زي مرشد",114,"د",1,0],["هُوَ الدَهرُ يُطعِمُ غَيري شُهاداً","وَيُطعِمُني تامِهَ الرَيرَقِ",115,"ق",1,0],["هُوَ الدُّرُّ وَالمرجانُ وَالبَدرُ وَالدُّجَى","هُوَ الوَردُ وَالسوسانُ وَالغُصنُ وَالحِقفُ",116,"ف",1,0],["هو الدهر لم تبدع علي 