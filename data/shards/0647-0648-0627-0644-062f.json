َ الدافعي لِنكالِ العِدى","فَإِنَّ لَهُم بِسِناني الرَدى",142,"د",2,0],["هو الدهر في الأمجاد تترى مصائبه","وكم ظهرت بين البرايا عجائبه",143,"ب",2,1],["هو الدهر كم قدش في الناس غارة","وكم ظهرت فيهم لعمري غرائبه",143,"ب",2,0],["هُوَ الدَهرُ يا نَفسي يُذِلُّ فيَنتَشي","سُروراً بِأذلالِ الكُماةِ السَلاهبِ",144,"ب",1,0],["هو الدواء الذي تزول به","عن القلوب الشكوك والتهمُ",145,"م",1,0],["هو الدهر كم أقصى عن العز دانيا","إليه وأدنى منه من هو نارح",146,"ح",1,0],["هو الدهر خوان فلم أر مثله","يخون بذي الافضال والعلم والفهم",147,"م",1,0],["هو الدين فانظر كيف طالت مناكبه","وكيف تراءت مشرقاتٍ كواكبه",148,"ب",2,1],["هُوَ الدَّهرُ ما إِن يُرى باكِياً","لِباكٍ وَلا مُعتِباً مِن عَتَب",149,"ب",1,0],["هو الدر نظم من بينه","بواقيت فاقعة الاصفرار",150,"ر",1,0],["هو الدائمُ الباقي بغيرِ نِهايةٍ","وعيدٌ له حَقٌّ علينا وموعِدُ",151,"د",1,0],["هو الدائمُ الباقي بغير نهاية","وكلٌّ سواهُ هالكٌ ثَمَّ نافدُ",152,"د",1,0],["هو الدهر في تصريفه لصروفه","فمن جهة يحيى ومن جهة يُردي",153,"د",2,0],["هو الدهرُ فانظر أىَّ قِرنٍ تُحارِبُه","وقد دَهَمَتنَا دُهمُهُ وأشاهِبُه",154,"ب",2,1],["هُوَ الدارُ وَهوَ الأَثلُ وَالحَيُّ وَالغَضا","هُوَ الناسُ وَالسُكّانُ وَهوَ المَراتِعُ",155,"ع",1,0],["هو الدهر لم يبلغ به السؤال ماجد","وكم نال منه فوق بغيته الوغد",156,"د",1,0],["هوَ الدهرُ مجبولٌ على الحلوِ مرةً","وأخرى على الحرمان والمُرِّ والصَّبرِ",157,"ر",1,0],["هو الدهر يعتام الكرام ويصطفي","صفايا البرايا سيدا بعد سيد",158,"د",1,0],["هو الدهر لا يرضى بدون ويجتني","لكأس المنايا أوحدا بعد أوحد",158,"د",1,0],["هو الدهر لا زالت كتائب جوره","تصول على الاشراف بغيا وتعتدي",158,"د",2,0],["هو الدليل على حق الحياة لها","إن الشعور هو القسطاس والحكم",159,"م",1,0],["هوَ الدُّرُ المُخبَّأ فِي حِجَابٍ","بِنُوْرٍ فَاضَ مِنْ غَيْبِ التسَاْمِي",160,"م",2,0],["هو الدهر لا عتب عليه ولا عتبى","فدعه عن العتبى وإياك والعتبا",161,"ب",2,1],["هو الدهر من أين نازعته","فبطشته الأعلب الأقهر",162,"ر",1,0],["هو الدهر لا يبقي مقيما على الوفا","ولا غادراً بحتاً ولا متملقا",163,"ق",2,0],["هو الدهر كم ساء الكريم سروره","فحتام لا تعطي الذمام شرو