{"poems":[[55,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[55,"نزلنا بمستن المكارم والعلى","https://www.aldiwan.net/poem30607.html","الطويل"],[65,"أما وحبيك هذا منتهى حلفي","https://www.aldiwan.net/poem46124.html","البسيط"],[65,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[73,"أهاجك شوق أم سنا بارق نجدي","https://www.aldiwan.net/poem4007.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[95,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[49,"لئن جمعتنا غدوة أرض بالس","https://www.aldiwan.net/poem25239.html","الطويل"],[74,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[74,"لئن جرحت خدي فلانة مقلتي","https://www.aldiwan.net/poem20114.html","الطويل"],[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[53,"لئن جلا وأقمنا إنه لفتى","https://www.aldiwan.net/poem65925.html","البسيط"],[72,"لئن جمعتنا بعد ذا اليوم خلوة","https://www.aldiwan.net/poem42744.html","الطويل"],[87,"جعلت حلاها وتمثالها","https://www.aldiwan.net/poem62953.html","المتقارب"],[2,"لمن طلل برامة لا يريم","https://www.aldiwan.net/poem25054.html","الوافر"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[46,"صبرت عنك بصبر غير مغلوب","https://www.aldiwan.net/poem30288.html","البسيط"],[46,"أبا سعيد وما وصفي بمتهم","https://www.aldiwan.net/poem30359.html","البسيط"],[46,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[71,"أيا علو دمع العين يغني عن الورد","https://www.aldiwan.net/poem28807.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[108,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[69,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[132,"أأحبابنا منكم حياة لنا الوصل","https://www.aldiwan.net/poem50554.html","الطويل"],[132,"نهني بك الأعياد إنك عيدها","https://www.aldiwan.net/poem50621.html","الطويل"],[147,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[202,"أنوما ووعد الحادثات وعيد","https://www.aldiwan.net/poem51952.html","الطويل"],[228,"ألا تبصر الأغصان بللها القطر","https://www.aldiwan.net/poem41891.html","الطويل"],[275,"ليالي النوى حتام ترخين برقعا","https://www.aldiwan.net/poem35627.html","الطويل"],[302,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem33023.html","الوافر"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[302,"أبو طالب عم النبي محمد","https://www.aldiwan.net/poem33194.html","الطويل"],[302,"إليك فقلبي لا تقر بلابله","https://www.aldiwan.net/poem33195.html","الطويل"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[310,"أجدك هذا مضجع الفخر والمجد","https://www.aldiwan.net/poem56572.html","الطويل"],[366,"وحقك أنت المنى والطلب","https://www.aldiwan.net/poem68141.html","المتقارب"],[371,"سقى الله تلك الدار عودة أهلها","https://www.aldiwan.net/poem17876.html","الطويل"],[422,"أقول لها يوم جدت بنا","https://www.aldiwan.net/poem53955.html","المتقارب"],[422,"يقول لي النصوح هلكت وجدا","https://www.aldiwan.net/poem53966.html","الطويل"],[457,"لئن جل المصاب بخير نجل","https://www.aldiwan.net/poem13946.html","الوافر"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[466,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[469,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[482,"يمينا لقد بالغت يا خل في العذل","https://www.aldiwan.net/poem15195.html","الطويل"],[482,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[500,"ما للخزامى تعود نسرينا","https://www.aldiwan.net/poem10279.html","المنسرح"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83307","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110415","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86704","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64004","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63861","الخفيف"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100140","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62679","المتقارب"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107204","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119860","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204061","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64857","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56634","الوافر"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178071","الطويل"],[463,"","https://poetry.dctabudhabi.ae/diwan/poem/25189","المتقارب"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131412","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35753","الهزج"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35813","الوافر"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11899","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26634","الطويل"],[1731,"","https://poetry.dctabudhabi.ae/diwan/poem/132060","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26426","المتقارب"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106701","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42472","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60878","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58471","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201411","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200987","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132665","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121408","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112693","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97893","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89138","الطويل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116854","الوافر"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66468","الطويل"],[3890,"","https://poetry.dctabudhabi.ae/diwan/poem/124624","الطويل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139452",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/19000","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116063","الطويل"],[4729,"فأُقسمُ بالمجدِ الأثيل ومنيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109438",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5092,"على ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=139678",""],[5277,"أبتي.. عُدْ لي.. واكْتلْ منّي كيْلَ سعير..","https://www.poetsgate.com/ViewPoem.aspx?id=199927",""],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5431,"أغنية-مجزوء الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=197736",""],[5688,"وغرّ بدا لي","https://www.poetsgate.com/ViewPoem.aspx?id=200926",""],[5741,"لئن جاد لي بالوصل منه خاليه","https://www.poetsgate.com/ViewPoem.aspx?id=187462",""],[5956,"اخضعي لي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182616",""],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""],[6142,"أسفح اللوى لا صافحتك الحوادث","https://www.poetsgate.com/ViewPoem.aspx?id=155731",""],[6182,"قَدْر ما يَتَنَهَّدُ الربّانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86105&r=&rc=2",""]],"verses":[["لَئِن جُلتُما في مَكَرِّ الزَمانِ","فَبَوّاكُما مِن مَداهُ العِثارا",0,"ر",2,0],["لَئِن جَحَدوا أَنّي اِبنُ خَيرِ الوَرى أَباً","فَلَن يَجحَدوا أَنّي اِبنُ خَيرِ الوَرى جَدّاً",1,"د",2,0],["لَئِنْ جَحَدْتُكَ نُعْمى مدَّ رَيّقُها","إِلى النّوائِبِ مني باعَ مُنْتَصِفِ",2,"ف",1,0],["لَئِنْ جَمَعَتْ ما بَينَ ظَهْرٍ ولَبَّةٍ","فكمْ فرَّقَتْ ما بَينَ هامٍ وأفْرُخِ",3,"خ",1,0],["لَئِن جَدَّ أَسبابُ العَداوَةِ بَينَنا","لَتَرتَحِلَن مِنّي عَلى ظَهرِ شَيهَمِ",4,"م",1,0],["لَئِن جَمَعَت بَيني وَبَينَهُمُ النوى","فَأَيُّ يَدٍ مَشكورَةٍ لِلنَوى عِندي",5,"د",2,0],["لَئِن جَزِعَت بَنو عَمروٍ عَلَيهِ","لَقَد رُزِئَت بَنو عَمروٍ فَتاها",6,"ا",3,0],["لَئِنْ جُلَّتْ مَصائِبُهَا","فَما انْحَلَّتْ أَوَاخِيهَا",7,"ي",3,0],["لَئِن جَمَعَتنا غَدوَةً أَرضُ بالِسٍ","فَإِنَّ لَها عِندي يَداً لا أُضيعُها",8,"ع",3,1],["لئن جلبت شجوي كسالى جفونه","لمثلك يا قلبي عن الصبرِ أكسل",9,"ل",1,0],["لئن جرحت خدّي فلانة مقلتي","لقد جرحاها بالدموع السواجم",10,"م",1,1],["لئنْ جِئتَ ذا بَشرٍ حالكٍ","لقد جئتَ ذا نسب أبرش",11,"ش",1,0],["لئن جلا وأقمنا إنَّه لفتىً","أمسى وكلُّ مقيمٍ بعده جالي",12,"ل",2,1],["لَئِن جَمَعَتنا بَعدَ ذا اليَومَ خَلوَةٌ","فَلي وَلَكُم عَتبٌ هُناكَ يَطولُ",13,"ل",1,1],["لَئِن جَلَّلَ البَحرَ أُسطولُها","لَقَد لَبِسَ البَرُّ قِسطالَها",14,"ل",3,0],["لِيَنجوا مِن مَلامَتِها وَكانوا","إِذا شَهِدوا العَظائِمَ لَم يُليموا",15,"م",3,0],["لِيُنجِح بِجودٍ مَن أَرادَ فَإِنَّهُ","عَوانٌ لِهَذا الناسِ وَهوَ لَنا بِكرُ",16,"ر",1,0],["لَئِن جَحَدتُكَ ما لاقَيتُ فيكَ فَقَد","صَحَّت شُهودُ تَباريحي وَتَعذيبي",17,"ب",2,0],["لَئِن جَحَدتُكَ ما أَولَيتَ مِن حَسَنٍ","إِنّي لَفي اللُؤمِ أَولى مِنكَ في الكَرَمِ",18,"م",1,0],["لَئِن جَزِعَ الوَحشِيُّ مِنها لِرُؤيَتي","لَإِنسِيُّها مِن شَيبِ رَأسِيَ أَجزَعُ",19,"ع",1,0],["لئنْ جرتِ يا علوى وقدُّكِ عادلٌ","فواعجبا للجائرِ العادلِ القدِّ",20,"د",1,0],["لَئِنْ جاش العُبابُ فَذُبْتِ فيه","لقد ذَابتْ نُفوسُ السّاكنينا",21,"ن",2,0],["لئن جَحدوا المصارعَ دامياتٍ","لقد شهِدتْ منايا الهالكينا",21,"ن",2,0],["لئن جَهِلَ التفوُّقَ مُدَّعوهُ","فتلك مَراتبُ المتفوِّقينا",21,"ن",2,0],["لئن جَحدوا مناقِبَهُ وكانوا","يُقيمون المواكبَ شاكرينا",21,"ن",2,0],["لئن جَهِلَ الأُلى نكثوا وخانوا","لقد علموا جَزاءَ النّاكثينا",21,"ن",2,0],["لئن جحدوا الذي لك من ولاءٍ","فقد بلغ الصَّفا وأتى الحُجونا",21,"ن",2,0],["لئن جاوزَتْ غايةَ العاملين","لقد بَارَكَ اللهُ أعمالها",22,"ل",3,0],["لَئِن جاءَهُم كَالغيثِ مِنهُ مُبَشِّراً","فَقَد جاءَهُم كَالموتِ مِنهُ نَذيرُ",23,"ر",1,0],["لئنْ جزع السريرُ، فَربَّ شَعْبٍ","بمصرَ قد استخفَّ به المِراحُ",24,"ح",1,0],["لئنْ جاءهم كالغيثِ منهُ مبشراً","لقد جاءهم كالموتِ منه نَذِيرُ",25,"ر",1,0],["لئن جادتِ الأيامُ لي بوصالِكم","فكل مرورات الزمانِ لنا نَحْلُو",26,"ل",2,0],["لَئِنْ جَحْدَ الحسادُ بعضَ مَقالتي","فتشهدُ لي بيض الليالِي وسودُها",27,"د",3,0],["لَئِن جِئتَ في أُخرى الزَمانِ مُعَقِّباً","فَمَجدُكَ لا يَقفو وَلَكِنَّهُ يُقفا",28,"ف",2,0],["لَئِن جَلَّ ما خَوَّلَتني لُهاكَ","فَإِنَّ الكَرامَةَ عِندي أَجَلّ",29,"ل",1,0],["لئن جَزِعَتْ نفسي عليه فإنَّني","على غَيْرِهِ شَهْمُ الفؤادِ جَليد",30,"د",1,0],["لَئِن جَنحت أَرواحها عَن لبانَةٍ","فَما جُنح المَجدُ المُخَلِّدُ وَالذِكرُ",31,"ر",1,0],["لئن جاءَ بعدي عاشقٌ يذكرُ الهوى","ويشكو نوىً فيها الشبيبة ضَيّعا",32,"ع",2,0],["لَئِن جَحدوكَ حقَّك عن شقاءٍ","فبالأشقين ما حلَّ العِقابُ",33,"ب",1,0],["لئن جَحدت قَومٌ عظيمَ مقامِه","وَقالوا بِما قالوا ضَلالاً وأَبهموا",34,"م",3,0],["لئن جهِلَت قَومٌ عظيمَ مقامِه","فَما ضرَّ ضوءَ الصُبح من هو جاهلُه",35,"ل",2,0],["لئن جارَ دَهري بالتفرُّق واِعتَدى","وَغال التَداني من دُهى البين غائلُه",36,"ل",2,0],["لئن جارَ دَهري بالتَنائي ولَم يزل","يَجورُ علينا كلّ آنٍ وَيشتَطُّ",37,"ط",1,0],["لَئِن جرّعَت مِن كأسِ فقدك علقماً","فَيا طالَما جرّعتها خالص الشهدِ",38,"د",1,0],["لَئِن جدت أَو جرت أَنتَ المُراد","وَما لي سِواكَ مَليح يُحِبّ",39,"ب",1,0],["لَئِن جَمَعَ الدَهرُ المُشَتِّتُ شَملَهُ","فَما بَعدَها ذَنبٌ يُعَدُّ لِدَهرِهِ",40,"ر",2,0],["لئنْ جُزتِ بي أَثلاثِ الغُوَير","وجُبْتِ الديارَ وأطلالَها",41,"ل",3,0],["لئنْ جاد السَّحاب وجادَ طرفي","أَرَيْتُ الدَّهرَ أيَّهما الشَّحيح",42,"ح",1,0],["لئِن جَلَّ المصاب بخير نَجْلٍ","لصدر بَني العُلا يومَ الرِهانِ",43,"ن",1,1],["لئن جادَ بالشعر الرقيقِ أغانياً","فمن خلفها الآلام تقدح بالشرر",44,"ر",1,0],["لئن جحدت بغداد حقي من العُلى","فما النجر مغموراً ولا الصبح خافيا",45,"ي",2,0],["لئن جن فيه العاشقون صبابة","فأصداغه للعاشقينَ سلاسل",46,"ل",1,0],["لئن جال قرطاها ونمّ نطاقها","لقد أحسنت كتماً حجال وخلخال",47,"ل",1,0],["لئن جئتُها مِن بَعْدِ بُعْدٍ فظهرُه","حرامٌ على الكُورِ المبرَّحِ والرَّحْلِ",48,"ل",1,0],["لئن جادَ لي بالقربِ دهرٌ ذممتُه","على البعدِ كانتْ منَّةً ليدِ الدهرِ",49,"ر",1,0],["لئن جزعنا على الشباب أسى","لقد ألفنا ظلاله حينا",50,"ن",2,0],["لَئِن جَرَدَتها رَومَةٌ لِحِصارِنا","لَقَد أَودَعَتها عِندَنا بِسُجونِها",51,"ن",3,0],["لئن جفَّ دمع العين مني هُنَيهةً","ففي القلب دمعٌ سائلٌ أبدا يجري",52,"ر",2,0],["لَئن جاءَ بِالبُشرى نَسيمُ أَحبتي","وَنبَّأني بِالقُرب مِن غَير مَوعد",53,"د",1,0],["لئن جزعتُ فلا بِدعٌ ولا عجبٌ","شجاعةُ العاشق المستهتَرِ الجزعُ",54,"ع",1,0],["لئن جاءني المشيبُ فعندي","مُسْكةٌ ما تَخُونني عندَ حُزَّه",55,"ز",2,0],["لئن جاءت الأيام شنعاء في الورى","فيوم علي كان أدهى وأشنعا",56,"ع",2,0],["لئنْ جاد دهر بإقبالها","حلالاً غدا ذنبه مغتفرْ",57,"ر",1,0],["لئِن جَرَتِ الأَقدارُ بالبُعدِ عنكُمُ","ومِن بَينِنا حالَت قِفارٌ وَسَبسَبُ",58,"ب",1,0],["لئن جبَّت الأيام غارب ملكه","لقد عوضتنا غاربا وسناما",59,"م",2,0],["لي نجدة الفتّاك في الهيجا وإن","خالفتهم في نسبة الكتاب",60,"ب",1,0],["لئِنْ جَزِعتَ عليهِ فهي حادِثَةٌ","صَمَّاءُ يُسْمَعُ فيها عُذْرُ مَنْ جَزِعَا",61,"ع",2,0],["لئن جاوزت في البعد المآقي","فلست مجاوزاً فيه القلوبا",62,"ب",2,0],["لئن جمعتكم نيّةٌ يمنيّةٌ","وفرّقكم وحش الفِجاج عميق",63,"ق",1,0],["لئن جئتها عانساً قد أبرّ","على سنّها العددُ الأطولُ",64,"ل",1,0],["لئن جلّت الأجرام مني وأفظعت","لعفوك عن جرمي أجلّ وأوسع",65,"ع",1,0],["لَئِن جَرَّت بِها الريحُ","ذُيولاً وَشيُها دَرسُ",66,"س",1,0],["لَئِنَ جَرَحَت شكاتُكَ كُلَّ قَلبٍ","لَقَد قَرَّت بِصِحَّتِكَ العُيونُ",67,"ن",1,1],["لَئِن جَلَّ حَسّانٌ بِمَدحِ مُحَمَّدٍ","فيها أَنا حَسّانٌ وَأَنتَ مُحَمَّدُ",68,"د",1,0],["لئن جاد شعرُ ابن الحُسين فإنما","تُجيد العطايا واللُّهي تفتح اللَّهَا",69,"ه",2,1],["لئن جَلَّ ما أبديه شوقاً إليكم","فإنَّ الذي أُخفيه أَضعافُ ما أبدي",70,"د",2,0],["لَئِن جَلَّ ذَنبٌ وَلَم أَعتَمِدهُ","فَأَنتَ أَجَلُّ وَأَعلى يَدا",71,"د",2,0],["لئِن جُدِّلَت بِيضُ المعالي فقَد غَدت","نشَاوَى الظُّبَاةُ البِيضُ واللُّدُنُ السُّمرُ",72,"ر",1,0],["لئنْ جادَتِ الأيّامُ يوماً بوصلِهِ","يميناً فإنّي قد صفحتُ عن الدَّهرِ",73,"ر",1,0],["لِئَن جئت في أثارهم فمحمدٌ","أتى أخِراً في الأنبيْاءِ مُقدّما",74,"م",2,0],["لَئن جُذِبَت قَسراً إِلى نَحو مَغرِبٍ","فَعَمّا قَليلٍ سَوفَ تَبدو بِمشرِقِ",75,"ق",1,0],["لي نَجمٌ يقولُ لي في رجوع","عنكَ ذَقنَ الحكيم في الاستقامه",76,"م",2,0],["لئن جُنّحتْ كالطائرات قنابلٌ","فعندي بحمد الله شعرٌ مجنّح",77,"ح",1,1],["لئن جمدت فها هي قد تلظت","إلهي لا يساورها الخمود",78,"د",1,0],["لئن جرعتني الحزن اطلال دارهم","فكم ارشفتني الراح فيها المراشف",79,"ف",1,0],["لئن جمعت بيني وبينك حليتي","لقد فرَّقت بيني وبينك حالي",80,"ل",2,0],["لئن جزع الصبور فرب خطب","به لا يحسن الصبر الجميل",81,"ل",1,0],["لئن جهلت من التمدين شيئاً","فيعوذها فقد جهلت أثامه",82,"م",2,0],["لئن جددت علياك مندرس الذكرِ","فقد أنشأت ما يزدري هرمي مصرِ",83,"ر",1,1],["لئن جَمَعت جوامعُ بين قومي","وظلمُ الأصل مَرتعُهُ وخيمُ",84,"م",1,0],["لئن جاذبت عطف الصِّبا نسمة الصَّبَا","لقد جاذبت عطفَي فؤادي الشمائل",85,"ل",1,1],["لينجيه ربّ الورى من جميع ما","يخاف ويخشى من عدو يكابده",86,"د",2,0],["لئن جحدتك معروفاً مننت به","إني لفي اللؤم أحظى منك في الكرمِ",87,"م",1,0],["لئن جف الثماد فأنت مروٍ","وأن صلد الزمان فأنت موري",88,"ر",2,0],["لئن جهلَ الزمان فأَنتَ عذرٌ","له فامحُ الإساءةَ باغتفارِ",89,"ر",1,0],["لَئِن جَعفَرٌ فاءَت عَلَينا صُدورُها","بِخَيرٍ وَلَم يُردَد عَلَينا خَيالَها",90,"ل",3,0],["لئن جهِلَ المُدَّاحُ طُرقَ مديحِكم","فإنّى بها من سائر النَّاسِ أعلَمُ",91,"م",1,0],["لئن جذبتني بعدها يَدُ ترحَةٍ","قطعتُ التفاتي عن مقالةِ مُحنثِ",92,"ث",1,0],["لئن جفت الأيام من قبل دارنا","فرب سحاب الغيث آب لها أوبا",93,"ب",2,0],["لي نجمتان , إذا صعدتُ سماءها","وأعودُ أحملُ في ظلامي شمعتي",94,"ت",2,0],["لي نجمةٌ تدري فصولَ حكايتي","ومضَتْ تُواسيني مِنَ الأحزانِ",95,"ن",1,0],["لِيُنَجِّينَا مِنَ الغَيِّ إذَا","لَيْلُهُ عَمَّ وَقَدْ صِيحَ: النَّجَا",96,"ج",2,0],["لي نجوم الليل تحكي","عن حبيب لم يخنّي",97,"ن",2,0],["لينجوَ منّي إن أراد فإنّني","كعفريت جنّ حلّ في كلّ خندق",98,"ق",1,0],["لئن جاد لي بالوصل منه خاليه","وأصبح مجهوداً رقيب ولائم",99,"م",1,1],["‏لي نجومٌ وغصونٌ وثمارٌ","‏ ‏ وهزار طائر عبر الكِساء",100,"ا",2,0],["ليَ نجلٌ خادمٌ خيرَ البشرْ","كلما يعلو يقيهم من حفرْ",101,"ر",1,1],["لئن جحدت فالحال ليست بغمةٍ","علينا ولا أمر الإمامة كارث",102,"ث",1,0],["لي نجمةٌ لَمْ تهْدِني، فشريعتي","وثنيّةٌ، وصحابتي صُلْبان",103,"ن",1,0]]}