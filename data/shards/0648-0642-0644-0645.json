{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[55,"أيا مرحبا بالغيث تسري بروقه","https://www.aldiwan.net/poem30484.html","الطويل"],[55,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"ما طلت باللهو والأيام تنتجز","https://www.aldiwan.net/poem64547.html","البسيط"],[53,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[72,"أيا من راح عن حالي","https://www.aldiwan.net/poem43007.html","مجزوء الوافر"],[87,"ولم لا وجدته نملة","https://www.aldiwan.net/poem6960.html","المتقارب"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[47,"لو أسعدت سعدى بتنويلها","https://www.aldiwan.net/poem65586.html","السريع"],[60,"إصبر على مضض الإدلاج في السحر","https://www.aldiwan.net/poem31066.html","البسيط"],[51,"لاعيب في جفوة إخواني","https://www.aldiwan.net/poem63157.html","السريع"],[51,"أغض عن المرء وعما لديه","https://www.aldiwan.net/poem63181.html","السريع"],[54,"ألا عج إلى دار السرور وسلم","https://www.aldiwan.net/poem26677.html","الطويل"],[48,"شكوت من أهل هذا العصر غدرهم","https://www.aldiwan.net/poem22983.html","البسيط"],[48,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55159","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54995","السريع"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12757","السريع"],[119,"أنت النبي لا كذب","https://www.aldiwan.net/poem41968.html","مجزوء الرجز"],[128,"يا جيرة البان ليت البان ما كانا","https://www.aldiwan.net/poem23706.html","البسيط"],[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[242,"يا هذه الزيتونه","https://www.aldiwan.net/poem19284.html","الرجز"],[242,"كتبت بمكتب أبيات شعر","https://www.aldiwan.net/poem19744.html","الوافر"],[266,"قد أحرز السبق مولانا الحريزي","https://www.aldiwan.net/poem38108.html","البسيط"],[266,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[325,"الدهر لا تصفو له صافية","https://www.aldiwan.net/poem61760.html","السريع"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[369,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[369,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[408,"قرأت من الصبابة كل فن","https://www.aldiwan.net/poem46737.html","الوافر"],[416,"خلت بعدنا من آل ليلى المصانع","https://www.aldiwan.net/poem67491.html","الطويل"],[422,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[422,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[447,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[463,"أإن تحدث عصفور على فننِ","https://www.aldiwan.net/poem55829.html","البسيط"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[463,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[520,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[567,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83287","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87160","الوافر"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34406","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137562",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137687",""],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34768","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77651","الرجز"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99990","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70991","المنسرح"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59812","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59243","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112767","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87873","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49546","البسيط"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198949","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114716","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123089","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102122","الوافر"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53051","الهزج"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109441","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109390","السريع"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106828","الطويل"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199851","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201913","السريع"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126920","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110091","السريع"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140285",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205918","المتقارب"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35638","السريع"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127785","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127171","البسيط"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45934","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90990","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83385","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83491","الوافر"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77694","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76728","البسيط"],[4584,"","https://poetry.dctabudhabi.ae/diwan/poem/141866","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120211","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139701",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204249","الطويل"],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[2177,"شجاني منهم ربع خلاء","https://www.poetsgate.com/ViewPoem.aspx?id=127080",""],[5274,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203694",""],[5298,"هَلْ حَبْلُ خَوْلَةَ بَعْدَ الهَجْرِ موصولُ","https://www.poetsgate.com/ViewPoem.aspx?id=183371",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5809,"قف بالمدينة","https://www.poetsgate.com/ViewPoem.aspx?id=205282",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[5309,"إصبر ففي الصبر اعجاز ومقدرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573679",""],[572,"وقَلمٍ مِدَادُهُ ترابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9166&r=&rc=23",""]],"verses":[["وَقَلَّمتُ أَظفاري وَكُنتُ أَعِدُّها","لِتَمزيقِ قُربى بَينَنا وَالمَحارِمِ",0,"م",1,0],["وَقَلَّمتَ أَظفارَ الخُطوبِ فَما اِشتَكى","نَزيلُكَ كَلماً لِلخُطوبِ وَلا عَقرا",1,"ر",2,0],["وَقَلَّ ما يَلقَينَني راقِداً","ما بَينَ أَحشاءٍ وَأَجيادِ",2,"د",1,0],["وَقَلَّمَتِ الأَقدارُ أَظفارَ بَطشِهِ","وَدَلَّ عَلى ما تَجهَلُ الجِنُّ حاجِبُه",3,"ب",2,0],["وقلَّ من صاحب أُصيبَ بهِ","لمثلِهِ حُزْنُهُ ومُكتَأبُهْ",4,"ب",2,0],["وقل مجيباً صهٍ للقائلات مهٍ","ولْيَلْقك العذلُ صلباً حين تْغتَمز",5,"ز",1,0],["وقلْ مُدلٌّ بحرمةٍ قدمتْ","على رءوفٍ بكلِّ من ملكا",6,"ك",2,0],["وقلَّ من ضَمِنَتْ خَيْراً طَوِيَّتُهُ","إلا وفي وجههِ للخيرِ عنوان",7,"ن",1,0],["وَقُل ماتَ الغَريبُ فَأَي","نَ مَن يَبكي عَلى الغُرَبا",8,"ب",2,0],["وقلَّ ما جاء حرا ماجدا ومشى","إلى الكريم الكثير الهم والحاج",9,"ج",1,0],["وَقَلما تَخَيروا رِجالهم","إِن الرِجال كَالفُصوص تُنتَقى",10,"ا",1,0],["وَقَلَّما عارِفَةٌ لَم يَكُن","مَقولُها بادِيَ مَفعولِها",11,"ل",3,0],["وَقَلَّ مَن جَدَّ في أَمرٍ يُطالِبُهُ","وَاِستَصحَبَ الصَبرَ إِلّا فازَ بِالظَفَرِ",12,"ر",1,0],["وَقَلَّما يَصفو عَلى غَيرِ ذا","تِ اللَهِ إِنسانٌ لِإِنسانِ",13,"ن",1,0],["وَقَلَّ مَن تَأتيهِ مِن حَيثُ لا","يَهواهُ إِلّا كُنتَ ثِقلاً عَلَيه",14,"ي",2,0],["وَقُل ما حَلَت بِالعَينَ دارٌ سَكَنتِها","سِواكِ فَإِن لَم تَعلَمي ذاكَ فَاِعلَمي",15,"م",2,0],["وَقَلَّما تَسكُنُ الأَضغانُ في خَلَدٍ","إِلّا وَفي وَجهِ مَن يَسعى بِها كَلَفُ",16,"ف",1,0],["وَقَلَّما تُسعِفُ الدُنيا بِلا تَعَبٍ","وَالدُرُّ يُعدَمُ فَوقَ الماءِ طافيهِ",17,"ف",3,0],["وَقُلْ مَا شِئْتَ فِي أَدَبٍ وَعِلْمٍ","تَبُزُّ بِهِ النَّوَابغَ فِي الرِّجالِ",18,"ل",1,0],["وَقُلْ مَا شِئْتَ فِي دَعَةٍ وَتَقْوَى","مُشَرِّفَةٍ لِرَبَّاتِ الحِجَالِ",18,"ل",1,0],["وَقَلَّ مَنْ أَكْرَمَ مِنْ قَبْلِهِ","حَيّاً كَمَا إِكْرَامِ إِذْ شُيِّعَا",19,"ع",2,0],["وَقَلَّما أَبقى عَلى ما أَرى","يوشِكُ أَن يَنعَناني الناعي",20,"ع",2,0],["وقل منحت ما تشا","فمن أتاك لم يخب",21,"ب",1,0],["وقل معي بلسان غير ذي عوج","لا كنت يا جنة الفردوس مأوانا",22,"ن",2,0],["وَقَلَّ مَقَرّاً عَلى ذي الصِفاتِ","لِمَن نَصَرَ الدينَ لَمّا اِنتَصَر",23,"ر",1,0],["وقلمٌ من بعده مسطورهُ","مِن كلّ موجودٍ بدون حدِّ",24,"د",1,0],["وَقَلَّمَتْ أَظْفَارَهُ","وَلَمْ تَكُنْ مَأْمُونَهْ",25,"ن",2,0],["وَقُلْ مَتْلَى كِتَابِ اللهِ وَاكْفُفْ","وَفَارِقْ مَنْ سَهَا فِي الْوَصْفِ سَهْوَا",26,"ه",3,0],["وقلما يرتضيها العقل شاردة","ولو حباني بها فيك العقيلي",27,"ي",1,0],["وقلما سئمت نفسي مصائبه","لكونها كمضاء الأعين الدعج",28,"ج",1,0],["وَقُل مقالَ من شكَر","فضلَ الصَديق وذكَر",29,"ر",1,0],["وَقُل مَن حازَ لَها آمِناً","مِن غَيرَ تَكديرٍ وَلا عادِيَةِ",30,"ي",2,0],["وَقَلَّ ما أَبقى الضَنا مِن جِسمِهِ","وَإِن تَمادى هَجرُكُم يَفنى الأَقَل",31,"ل",1,0],["وقَلَّ منّا لَوَ أنّا مِن مَحبَّتِه","يا وطْأةً في الثّرى منه فدَيْناك",32,"ك",1,0],["وقلَمي في الطِّرسِ ثُعبانٌ إذا","نَضنَضْتُ قال الفَضلُ لي لا تَخَف",33,"ف",1,0],["وقلّما أمكنَ الإنسانَ في دَعَةٍ","أن يَجمعَ الوطنَ المألوفَ والوَطَرا",34,"ر",2,0],["وقَلَّ من العِقيانِ صَوْغُ أساورٍ","لأيدي مَطي للعراقِ قَواصد",35,"د",1,0],["وَقَلَّمتَ صَرفَ الدَهرِ عَنّا وَقَد رَأَوا","هِلالَهُمُ مِثلَ القُلامَةِ في الظُفرِ",36,"ر",1,0],["وقل ما شئتَ في لومي فإِن لَمْ","تجد لي نحوه ميلاً فدَعني",37,"ن",2,0],["وَقُل مِثلُ ما قالَ اِبنُ يَعقوبِ يوسِفُ","لإِخوانِهِ قَولاً لَهُ القَلبُ نائِعُ",38,"ع",1,0],["وقلَّمتَ أظفارَ الطّغاة وسُسْتَهم","بأَبيضَ حاد الزيغ عن كلّ حاسد",39,"د",1,0],["وقلَّم أظفار الخطوب فلم تَصُلْ","بأنياب أحداث ولا بأَظافر",40,"ر",1,0],["وقل ما الذنب والخطل","وما التنويح والعطل",41,"ل",1,0],["وقل مضلٌّ ولكن من نشيدتِهِ","شخصٌ تولَّد بين البدرِ والغُصُنِ",42,"ن",1,0],["وقلَّما أغنى الفتى","شميمُه بأجدعِ",43,"ع",1,0],["وقل ما لكم بعد طول الضلا","ل لم تشكروا نعمة المرشدِ",44,"د",1,0],["وقلّما يرعى أياديكُمُ","في القرب مَنْ لم يَرْعَها في البعادْ",45,"د",1,0],["وقَلَّ من الآرابِ قُلٌّ ضممتَهُ","وقد جاز في الآفاق نَهباً مطرَّدا",46,"د",2,0],["وقل من للعنادل كان يصغي","فلا يصغي لتنهيق الحمار",47,"ر",1,0],["وقل ما يسلو الفتى أوطانه","إلا إذا ما حصلت أوطاره",48,"ر",2,0],["وقلمت ظفر الشر عنهم فقبلوا","أنامل كف برها لم يقلم",49,"م",1,0],["وقَلَّ من طابَقَتْ دُنياهُ حِكمَتُهُ","مِثلَ الأمينِ الذي اعتزَّت بهِ الدُوَلُ",50,"ل",1,0],["وقل ما ينفعه التأسف","إذ ضيع الواجب والتلهف",51,"ف",1,0],["وَقَلَّما الدَهرُ ناوي مِثلَهُ أَسَداً","مِمَّن رَعى تَلَعاتِ المَجدِ وَالأَكَما",52,"م",2,0],["وَقُل مَجدي عَليك الدَهر يُثني","بِما يَحلو بِهِ نغم المَثاني",53,"ن",2,0],["وَقَلَّ مُلوكُ الأَرض في العين بعدهُ","وَرأيُ الصُقور مَزدرٍ بِالهَداهِدِ",54,"د",1,0],["وقل ما السهول التي تتشعب","وما ذي الجبال التي تتركب",55,"ب",1,1],["وقل ما حشاهم فلو كان صخرا","لرق لمن نكبوا وانصدع",56,"ع",1,0],["وقَلَّ مَنْ جَدَّ في أَمْرٍ يُطالِبُهُ","فاستَصْحَبَ الصَّبْرَ إِلاَّ فاز بالظَّفَر",57,"ر",1,0],["وَقَلَما آكلُ إِلّا ديكا","وَرُبَّما وَجَدت لي شَريكا",58,"ك",2,0],["وقَلَّمَ عَنْهُمْ ظُفُرَ المَنايَا","بِقُرْبِ مُناهُمُ وَبِبُعْدِ حَيْنِ",59,"ن",1,0],["وقلَّ منه احتمالُه وصَباً","وعافه الإصبارُ والجَلَدُ",60,"د",1,0],["وقلَّ مَن في المغيبِ","يرعى ذِماماً لِحُر",61,"ر",1,0],["وقلَّ من للّه","يَبْتغي العلوم مكسَبا",62,"ب",2,0],["وَقَلَّمَ الغُصْنَ بِخَدَّيْهِ فَلَمْ","أعْلَمْ لِدَالٍ أوْ لِلاَمٍ مَشَقْ",63,"ق",1,0],["وقل ما تشا يسمع وسل ععط واشفعن","تشفع فأنت اليوم أوجه شافع",64,"ع",1,0],["وقل مدثر بشراك مني","بحسن الختم والرتب العليه",65,"ي",2,0],["وَقل ما يَلعَب بِالقَوائم","إِلا فَتى بِالحَرب غَير عالم",66,"م",1,0],["وَقَلَّ مَا يَبقَى عَلَى اللَّسِّ الخَلَى","يَا عَجَبِي مِن رَاكِضٍ إِلَى مَدَى",67,"د",2,0],["وقل ما شئت في تكليم ظبي","وشاة سمّ ساعدها وضب",68,"ب",1,0],["وقلّما نُزِّه الإِثنان عن بَشَعٍ","تلقاه في واحدٍ او عمَّ بينهما",69,"م",2,0],["وقلَّما نقصَ التأنيثُ صاحبَهُ","إذا تُذُكّرِتَ الأفعالَ والنُّصُب",70,"ب",1,0],["وقلمت المطالب من حداها","لنا أقلامنا ساقاً فساقا",71,"ق",2,0],["وقَلّما يكذبُ ارتِيادٌ","دَعا إلى وجهِكَ الصَّبيحِ",72,"ح",1,0],["وقُل مددت يدي مولاي ذا أمل","في فيض جودك يا جوّاد بالنِّعَم",73,"م",1,0],["وقل من حزب عثمان محمد","ومن اتباع طه في البرايا",74,"ا",3,0],["وقل مبعدا أقضاه في الحب أنه","بذلك أهل فاقتضى حظه البعدا",75,"د",2,0],["وقلْ ما شئتَ في مال","بأيدي الحمد منهوبِ",76,"ب",1,0],["وقلما ان ترى بين الملا رجلاً","مثل العلي بن إسماعيل تصحبه",77,"ب",2,0],["وقلما أشبع من وصفه","كأنني في مدحه اشعب",78,"ب",1,0],["وقل ما الذي قبل الحياة وبعدها","ومن أي نسجٍ ساحرٍ نسج العمر",79,"ر",1,0],["وقل محب لكم قد شفه مرض","وما سواك له من دائه راقي",80,"ق",2,0],["وقل مستغيثا بالامام وحزبه","اذا رمت خيرا او خشيت الورى ضرا",81,"ر",2,0],["وقلما يوجد شيء به","ارغب من ذا أنا كسلان",82,"ن",1,0],["وقل من كان للجهتين عامرا","فأكثر أهل الله لإحدى جهة",83,"ه",1,0],["وقل منشدا واهتف بفتيان هاشم","غياث البرايا من نزار ويعرب",84,"ب",1,0],["وَقُل مَنَانِ وَمَنَينِ بَعدَ لِى","إلفَانِ بِابنَينِ وَسَكِّن تَعدِلِ",85,"ل",1,0],["وَقُل منُونَ وَمَنِينَ مُسكِنَا","إن قِيلَ جَا قَومٌ لِقَومٍ فُطَنا",85,"ن",2,0],["وقلَّ مَن أَبعَدَ عنها وما","تَحرَّكَت منهُ اليها الشُجُون",86,"ن",1,0],["وقل مثلاً وما ظني تحصله","قد قل في الناس هذا اليوم أحرار",87,"ر",1,0],["وقُلْ ما بدا لك فيما مضى","وفي مقبل بعده مسعدِ",88,"د",1,0],["وَقَلَّ ما في أَساقي القَومِ فَاِنجَرَدوا","وَفي الأَداوى بَقِيّاتٌ صَلاصيلُ",89,"ل",1,0],["وَقَلَّما صَحّت صَلاةُ اِمرِئ","مُبَلبل البال بِطَرفٍ سَقيم",90,"م",1,0],["وقلَّ ما توجد في واحدٍ","العلمُ والعفَّة والعَقلُ",91,"ل",1,0],["وقل ما قد ذكرناه لمولد من","فيه سحاب العنا عنا قد انقشعا",92,"ع",2,0],["وَقُل مِثلَ هذا في عِشاءٍ وَمَغرِبِ","وَعَصرٍ كَذاكَ الصُبحُ وَالفَجرُ ما اِنفَجَرْ",93,"ر",1,0],["وقل مساعدي حتى كاني","لسوء الحظ في بلدي مسافر",94,"ر",1,0],["وقلّما يقال في الدنيا لَعاً","من عثرةٍ لكلّ شهوان لعا",95,"ا",1,0],["وَقَلَّما بانَ امرُؤٌ عَن أرضِهِ","إلا وبانَ الصَبرَ عَنهُ ونأى",95,"ا",1,0],["وَقَلَّما مُدَّ المَدى لِمَن غَدَا","في الظُلمِ والعُدوانِ مَمدُودَ المَدَى",95,"ا",1,0],["وَقُل من بَعد ذَنبٍ تابَ مِنهُ","إِلهُ العَرشِ شَفّعني بِذَنبِك",96,"ك",1,0],["وَقل مَولايَ هل نظرٌ كَريمٌ","لِمَن يَرجوكَ يا زين الطِباعِ",97,"ع",1,0],["وَقَلّما شُفِيت نَفسٌ بِزورة من","حَلّ البَقيع وَلَكن جُهدُ ذي أربِ",98,"ب",1,0],["وقلما تسأم الأجسام من عرض","اذا توالى عليها الرى والشبع",99,"ع",1,0],["وقلْ ما صحّ عندك من يقين","بحقٍ لا يعارضُه رياء",100,"ا",2,0],["وقل ما شئت في قلم ترينا","مواضيه فلولا في السيوف",101,"ف",1,0],["وقل مالكم قد رقدتم وقد","وُتِرتم من النوم هبُّوا سريعا",102,"ع",2,0],["وقل مرحباً بالمهرجان وحيِّه","بطلعة بسام أغر مجيد",103,"د",1,0],["وقل مولاي جُدْ بالعفو فضلاً","فبحرُ نداك وافره مديد",104,"د",1,0],["وقل ما شئت فيهم غير شيء","فان الله يؤتي من يشاء",105,"ا",2,0],["ََوقُل ْمَاشئْتَ عَنْ غَدْر الليَالي ْ","وَأفق ضَاقَ كَمْ تَرْجُوْ اتّساعََهْ",106,"ع",2,0],["وقَلَّ ما في أَسَاقِي القومِ فانْجَرَدُو","وفي الأَدَاوَى بَقيَّاتٌ صَلاَصِيلُ",107,"ل",1,0],["وقل ما تشا في حمدهم ومديحهم","فلن تبلغ المعشار من شكر نعمةِ",108,"ه",1,0],["وقلْ مِن الشِّعرِ مالَو رُحتَ تُطلقُهُ","لأَطرَبَ الناسَ والأطيارَ والشَّجَرا",109,"ر",2,0],["وقلَّمتُ جومانا أظافرَ غفلتي","وأعتقتُ من غيبوبةِ الشوق ِ ..حرماني",110,"ن",2,0],["وَقَلَّ مَن جَدَّ في أَمرٍ يُؤمِّلُهُ","وَاستَصحَب الصَّبرَ إِلاّ فازَ بِالوَطَر",111,"ر",1,0],["وقَلمٍ مِدَادُهُ ترابُ","في صحفٍ سطورُهَا حِسَابُ",112,"ب",1,1]]}