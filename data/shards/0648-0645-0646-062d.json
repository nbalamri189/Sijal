aldiwan.net/poem56272.html","السريع"],[456,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[456,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[493,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[493,"لا والذي شق خمسي","https://www.aldiwan.net/poem9884.html","المجتث"],[498,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[513,"رأيت أبا القنص ضاقت به","https://www.aldiwan.net/poem12167.html","المتقارب"],[513,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[514,"ومن حب سلمى راشح ليس بارحي","https://www.aldiwan.net/poem48639.html","الطويل"],[527,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[527,"مضى غير مذموم زمان شبابي","https://www.aldiwan.net/poem37534.html","الطويل"],[527,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[536,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[549,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[549,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[549,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[549,"إن كنت بالعفو ليس تعذرنا","https://www.aldiwan.net/poem47851.html","المنسرح"],[556,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[556,"لقد نظرت قوم بطرف لهم قذي","https://www.aldiwan.net/poem33813.html","الطويل"],[556,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[560,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[573,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["وَمَن حَلَّ ذاكَ الشِعبَ بَعدي وَراشَقَت","لَواحِظُهُ تِلكَ الظِباءَ الجَوازِيا",0,"ي",2,0],["وَمِن حَذَرٍ لا أَسأَلُ الرَكبَ عَنكُمُ","وَأَعلاقُ وَجدي باقِياتٌ كَما هِيا",0,"ي",2,0],["وَمَنَحتُهُ أَروى القَوافي عاتِباً","فَاِكتَنَّ في جَنبَيهِ سُمّاً قاتِلا",1,"ل",2,0],["وَمِنْ حَدَثَانِ الدَّهْر أَنْ أَسْتَميحَهُمْ","وَتَحْتَ نِجادِي مِدْرَهُ الحَدَثانِ",2,"ن",1,0],["ومِنْحَةٌ ضافيَةٌ أرْمي بِها","طَرْفِيَ في إثْرِ الغَمامِ الوابِلِ",3,"ل",1,0],["وَمَن حُبُّهُ يَزدادُ عِندِيَ جِدَّةً","وَحُبّي لَدَيهِ مُخلَقُ العَهدِ داثِرُ",4,"ر",1,0],["وَمِن حَرَقٍ لِلحُبِّ في باطِنِ الحَشا","وَلَيلٍ تَويلِ الحُزنِ غَيرِ قَصيرِ",5,"ر",1,0],["ومَنْ حَلَّ هَذا المُلْكَ لمْ يَبْغ بعْدَهُ","رَحيلاً ولمْ ينْزِعْ بِهِ عنْهُ نازِعُ",6,"ع",1,0],["وَمَنْ حَسَدَ الشَّمْسَ الْمُنِيرَةَ نُورَهَا","وَرِفْعَتَها فِي الْجَوِّ فَهْوَ جَهُولُ",7,"ل",1,0],["وَمِن حَواشي الحَواشي","عَلى مُتونِ اِبنِ جِنّي",8,"ي",1,0],["وَمِن حَملِيَ الكَأسَ المُفَدّى مُديرُها","تَقَحُّمُ أَهوالٍ حَمَلتُ لَها الرُمحا",9,"ح",2,0],["وَمَنْ حَدِيثٍ مطرب","فَازَ بِهِ مَنْ سَمِعَهْ",10,"ع",2,0],["وَمِنْ حُلاهَا استَمَدُّوا كُلَّ تَحْلِيَةٍ","بِلا مُحَاشَاةِ إِغْرِيقٍ وَ رُومَانِ",11,"ن",1,0],["وَمِن حاجَتي لَولا التَنائِي وَرُبَّما","مَنَحتُ الهَوى مَن لَيسَ بِالمُتَقارِبِ",12,"ب",1,0],["وَمِن حَنَشٍ تَعَرَّضَ لِلمَنايا","كَأَنَّ مَجَرَّهُ فيها جَريرُ",13,"ر",1,0],["وَمَن حُبُّهُ زُلفَةٌ","بِها يُكرَمُ المَحشَرُ",14,"ر",1,0],["وَمِن حَقِّ الطُلولِ عَلَيَّ أَلّا","أُغِبَّ مِنَ الدُموعِ لَها سَحابا",15,"ب",2,0],["ومن حقٍّ يساقُ إلى حقيق","ومن جدوى تفاض على جدير",16,"ر",1,0],["ومنح وصفح ذاك معفٍ لمخطئٍ","وذاك صريح المكرمات لعافِ",17,"ف",1,0],["ومن حُسن أوجهِ سكانها","قُروداً تَزَحَّرُ تحت الغَضى",18,"ا",1,0],["ومن حرك المعتلَّ عرَّضَ وصْله","وخُلَّته للصَّرْم والغدْرِ بالعهدِ",19,"د",1,0],["ومن حاربته الليالي اشتكى","ومن سالمته الليالي فُجع",20,"ع",1,0],["ومن حكمها لعنُ الدعيِّ وثلبِهِ","إذا واصل الأرحام عُدَّ قطوعها",21,"ع",3,0],["ومنحْتَ الذميمَ منحةَ حمدٍ","ومنحت العديمَ منحةَ مالِ",22,"ل",1,0],["وَمَنحتُ مَجدَ الدينِ ما","أَنا مِن عُلاهُ مُستَميحُه",23,"ح",2,0],["وَمِن حَنَنتُ إِلى ما اِعتَدتُ مِن كَرَمٍ","حَنينَ أَرضٍ إِلى مُستأخر المَطَرِ",24,"ر",1,0],["ومن حراك النافر المرتقي","ومن سكون الثابت الراسبِ",25,"ب",1,0],["وَمِن حَقِّ الأَحِبَّةِ لَو أَجَنَّت","رَمائِمَها الجَوانِحُ وَالقُلوبُ",26,"ب",1,0],["وَمَن حَمَلَ الخَيلَ العِتاقَ عَلى الوَجا","تُقادُ إِلى الأَعداءِ مَثنىً وَمَوحَدا",27,"د",2,0],["وَمِن حَينِ قَحطاني سَجَستانِ أَصبَحوا","عَلى سَيِّئٍ مِن دينِهِم قَد تَغَيَّرا",28,"ر",2,1],["وَمِن حَولِهِ رَهطٌ أَصابَ أَخاهُمُ","بِهازِمَةٍ تَحتَ الفِراشِ المُحَطَّمِ",29,"م",1,0],["وَمِن حينِ آخى بَينَ مَن كانَ حاضِراً","هُنالِكَ آخاني وَبَيَّنَ مِن فَضلي",30,"ي",1,0],["وَمَنَحتَني فَبَذَلتُ مالَكَ في يَدي","وَحَسَدتُ جودَكَ لي فَجُدتُ بِمالي",31,"ي",1,0],["وَمَن حَوى مُكرُمَةَ ال","أَنواءِ مَع بَأسِ الأَسَد",32,"د",1,0],["وَمَن حَبانا قَبلَ","النِدا بِنَدى",33,"د",2,0],["ومُنحنَى هاته الضلوع","على صوادٍ بها جياع",34,"ع",1,0],["ومن حبيب إلى حبيب","ترنو حناناً وتبتسم",34,"م",1,0],["وَمِن حَلَبِ الأَوداجَ يُغْذى فَطيمنا","بحِجْرٍ من الهيجاءِ ساعةَ يُفْطَمُ",35,"م",1,0],["ومن حلّ في سبعين عاماً كأنَّهُ","عِلاجُ علِيلٍ في مُواصَلَةِ النُّكسِ",36,"س",1,0],["ومِن حَيثُ ما ساورتَهُ خِفتَ بأسَهُ","وَلِلنّارِ مِن حَيثُ انثَنَيتَ لها وَقدُ",37,"د",1,0],["وَمِن حَبيرِ اليُمنَةِ الأَبرادِ","مِن أَتحَمِيّاتٍ وَمِن وِرادِ",38,"د",1,0],["وَمَنَحتَهُم عِظَتَيكَ مِن مُتَوَعِّرٍ","مُتَسَهِّلٍ قاسي الفُؤادِ رَحيمِ",39,"م",1,0],["وَمَنَحتَني وُدّاً حَمَيتُ ذِمارَهُ","وَذِمامَهُ مِن هِجرَةٍ وَصُدودِ",40,"د",1,0],["وَمِن حُبِّها زُرتُ أَهلَ العِراقِ","وَأَسخَطتُ أَهلي وَأَرضَيتُها",41,"ت",3,0],["وَمِن حُرِّ نُبلٍ قَد أَفاضَتهُ هِمَّةٌ","فَساحَ بِهِ في سَفحِ ثَهلانَ مَورِدُ",42,"د",1,0],["ومن حملَ الأمانةَ في بلادٍ","تَدينُ بغيرها حَملَ العذابا",43,"ب",2,0],["وَمَن حَاز لَفظَ النَّصرِ من لَفظِ قَاهِرٍ","فَقَد حُزتَ مَعنَى النَّصرِ وَاسمُكَ فَاضِلُ",44,"ل",1,0],["وَمِن حَسرَةِ الدُنيا هَواكَ لِباخِلٍ","بَعيدٍ مِنَ العُتبي ضَنينٍ بِمَوعِدِ",45,"د",1,1],["وَمِنْ حَيْثُمَا وَجَّهْتَ وَجْهَكَ نَحْوَها","تَلَقَّتْكَ مِنها نَضْرَةٌ وسُرُورُ",46,"ر",1,0],["ومَنْ حَظُّهُ مِنْ حُسْنِ مَدْحِيَ وَافِرٌ","وحَظِّيَ مِنْ إِحْسَانِهِ بِيَ أَوْفَرُ",47,"ر",1,0],["ومن حبّها أني أكتِّم حبها","وأنّي بها صبٌّ كأنّيَ ذاهل",48,"ل",1,0],["ومن حَقّ غَيرِيَ أن يَجْتَدي","ومن حَقّ مثليَ أن يحتَكِم",49,"م",1,0],["ومنحْنَ الفِراقَ رِقّةَ شَكوْا","هنَّ حتّى عشِقْتُ يومَ الفِراق",50,"ق",1,0],["ومن حقِّ نفسٍ مثل نفسك صَونُها","ليوم القَنا الخطِّيِّ والفتكةِ البِكر",51,"ر",1,0],["ومن حضورِ الربوع تندبُها","ومن بكاءٍ لرحلةِ الإبل",52,"ل",1,0],["وَمِن حُبِّها أَبكي إِلَيها صَبابَةً","وَأَلقى بِها الأَحزانَ وَفداً عَلى وَفدِ",53,"د",1,0],["وَمِن حُبِّ دُنياهُم رَمَوا في وَغاهُمُ","بَغيضَ المَنايا بِالنُفوسِ الحَبائِبِ",54,"ب",1,0],["وَمَن حانَ يوماً جارَ في عَينيهِ عَمىً","وَفي لُبِهِ ضَعفٌ وَفي سَمِعهِ وَقرُ",55,"ر",1,0],["وَمِن حَولِهِ قَومٌ كَأَنَّ وُجوهَهُم","صَفّاً لَم يُلَيِّن بِالغُيوثِ الهَوامِعِ",56,"ع",1,0],["وَمن حاد عن نهج الحقيقة لم يعش","ومن لم يدار الدهر ناصبه الدهر",57,"ر",1,0],["وَمنحت بالأدب الفَضائِلَ زينةً","فكأَنَّه في جيدها أَطواق",58,"ق",1,0],["ومن حاد عَن نهج الطَبيعة لَم يعش","وَمن لَم يدار الدهر ناصبه الدهر",59,"ر",1,0],["ومن حقها أن يصبح المسك عامراً","لها وهي في أعلى المواضع تجعل",60,"ل",1,0],["وَمِن حَذَرِ الأَيَّامِ ما حَزَّ أَنفَهُ","قَصيرٌ وخاضَ الَموتَ بِالسَّيفِ بَيهَسُ",61,"س",1,1],["ومِن حَذَرِ الُملاَوِمِ والمَخازي","وهُنَّ الُمندِياتُ لِمنَ مُنينا",62,"ن",2,0],["وَمَنْ حَدَّثَتْهُ النَّفْسُ بِالْغَيِّ بَعْدَ مَا","تَنَاهَى إِلَيْهِ الرُّشْدُ سَارَ عَلَى بُطْلِ",63,"ل",1,0],["وَمَنَحَ اللّهُ الْمُبْدِعُ وَجْهَيْكُمَا","تَشابُهاً بِالْحُسْنِ وَالْبِشْرِ",64,"ر",1,0],["وَمَنَحَتْنِي شَرفاً أَتِي","هُ بِهِ عَلَى كُلِّ الأَنَامِ",65,"م",1,0],["وَمَنْ حَبَاكِ بِآدَابٍ مُكَمَّلَةٍ","هَيْهَاتَ تَعْدِلُهَا آدَابُ أَمْلاَكِ",66,"ك",1,0],["وَمِن حِكْمَةٍ مَا زَالَتِ المَصْدَرُ الَّذِي","صَفَا حَوْضُهُ المَوْرُودُ لِلْقَلْبِ وَالْفِكْرِ",67,"ر",1,0],["ومَنَحْتَه خُلُقَ العَطَاءِ فَغَرَّدتْ","صَدَّاحَةُ الوَادِي بفَضْلِ عَطَائه",68,"ا",3,0],["ومن حل هذا الملك لم يبق بعده","رحيلا ولم ينزع به عنه نازع",69,"ع",1,0],["ومن حيث كان يدقّ القطيع","طبول الصلاة أمام الذئاب",70,"ب",1,0],["ومن حيث كانت كؤوس الجر