{"poems":[[53,"أقول لركب رائحين لعلكم","https://www.aldiwan.net/poem29626.html","الطويل"],[53,"إن لم أطع همما وأعص عواذلا","https://www.aldiwan.net/poem29863.html","الكامل"],[63,"خليلي بئس الرأي ما تريان","https://www.aldiwan.net/poem45933.html","الطويل"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[34,"بنفسي من قلبي له الدهر ذاكر","https://www.aldiwan.net/poem4886.html","الطويل"],[34,"فإن يحجبوها ويحل دون وصلها","https://www.aldiwan.net/poem4897.html","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[73,"خليلي لا فطر يسر ولا أضحى","https://www.aldiwan.net/poem11843.html","الطويل"],[93,"جاءوا وكانوا أربعه","https://www.aldiwan.net/poem11132.html","مجزوء الرجز"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[27,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[47,"لأيكم أذكر","https://www.aldiwan.net/poem25261.html","مجزوء المتقارب"],[47,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[51,"سقيتن يا منزلات الهوى","https://www.aldiwan.net/poem8117.html","المتقارب"],[51,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[78,"الجود أحلى على قلبي من الظفر","https://www.aldiwan.net/poem14158.html","البسيط"],[62,"صنوان ضدان أب واحد","https://www.aldiwan.net/poem52181.html","السريع"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[28,"أرى الموت لا يبقي على ذي جلادة","https://www.aldiwan.net/poem4986.html","الطويل"],[28,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[28,"إذا المرء لم يحقن دما لابن عمه","https://www.aldiwan.net/poem5508.html","الطويل"],[58,"أقيك بنفسي أيها المصطفى الذي","https://www.aldiwan.net/poem30919.html","الطويل"],[66,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[66,"يا مالك العصر ومن","https://www.aldiwan.net/poem39071.html","مجزوء الرجز"],[66,"زار وصبغ الظلام قد نصلا","https://www.aldiwan.net/poem40970.html","المنسرح"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[80,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[80,"حللت بيومي إذ رحلت عن الأمس","https://www.aldiwan.net/poem31412.html","الطويل"],[80,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[44,"حماد من نوء له حماد","https://www.aldiwan.net/poem29694.html","الرجز"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[31,"من البكرات عراقية","https://www.aldiwan.net/poem42599.html","المتقارب"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[105,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[52,"ومن حسرة الدنيا هواك لباخل","https://www.aldiwan.net/poem27120.html","الطويل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[48,"أحسن من موقف على طللِ","https://www.aldiwan.net/poem66591.html","المنسرح"],[50,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem63925.html","الطويل"],[46,"إذا عبت عندي غيري اليوم ظالما","https://www.aldiwan.net/poem22176.html","الطويل"],[46,"إذا زادك المال افتقارا وحاجة","https://www.aldiwan.net/poem22520.html","الطويل"],[46,"عليك بفعل الخير لولم يكن له","https://www.aldiwan.net/poem22960.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85340","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/141831","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21134","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42730","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54899","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54888","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[100,"ياقارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50457",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[46,"إذا زادكَ المالُ افتقاراً وحاجةً","https://www.poetsgate.com/ViewPoem.aspx?id=20068",""],[28,"لبئست هدايا القافلين أتيتم","https://www.poetsgate.com/ViewPoem.aspx?id=21087",""],[51,"ألا ليس شيبُك بالمتَّزعْ","https://www.poetsgate.com/ViewPoem.aspx?id=29516",""]],"verses":[["وَمَن حَلَّ ذاكَ الشِعبَ بَعدي وَراشَقَت","لَواحِظُهُ تِلكَ الظِباءَ الجَوازِيا",0,"ي",2,0],["وَمِن حَذَرٍ لا أَسأَلُ الرَكبَ عَنكُمُ","وَأَعلاقُ وَجدي باقِياتٌ كَما هِيا",0,"ي",2,0],["وَمَنَحتُهُ أَروى القَوافي عاتِباً","فَاِكتَنَّ في جَنبَيهِ سُمّاً قاتِلا",1,"ل",2,0],["وَمِنْ حَدَثَانِ الدَّهْر أَنْ أَسْتَميحَهُمْ","وَتَحْتَ نِجادِي مِدْرَهُ الحَدَثانِ",2,"ن",1,0],["ومِنْحَةٌ ضافيَةٌ أرْمي بِها","طَرْفِيَ في إثْرِ الغَمامِ الوابِلِ",3,"ل",1,0],["وَمَن حُبُّهُ يَزدادُ عِندِيَ جِدَّةً","وَحُبّي لَدَيهِ مُخلَقُ العَهدِ داثِرُ",4,"ر",1,0],["وَمِن حَرَقٍ لِلحُبِّ في باطِنِ الحَشا","وَلَيلٍ تَويلِ الحُزنِ غَيرِ قَصيرِ",5,"ر",1,0],["ومَنْ حَلَّ هَذا المُلْكَ لمْ يَبْغ بعْدَهُ","رَحيلاً ولمْ ينْزِعْ بِهِ عنْهُ نازِعُ",6,"ع",1,0],["وَمَنْ حَسَدَ الشَّمْسَ الْمُنِيرَةَ نُورَهَا","وَرِفْعَتَها فِي الْجَوِّ فَهْوَ جَهُولُ",7,"ل",1,0],["وَمِن حَواشي الحَواشي","عَلى مُتونِ اِبنِ جِنّي",8,"ي",1,0],["وَمِن حَملِيَ الكَأسَ المُفَدّى مُديرُها","تَقَحُّمُ أَهوالٍ حَمَلتُ لَها الرُمحا",9,"ح",2,0],["وَمَنْ حَدِيثٍ مطرب","فَازَ بِهِ مَنْ سَمِعَهْ",10,"ع",2,0],["وَمِنْ حُلاهَا استَمَدُّوا كُلَّ تَحْلِيَةٍ","بِلا مُحَاشَاةِ إِغْرِيقٍ وَ رُومَانِ",11,"ن",1,0],["وَمِن حاجَتي لَولا التَنائِي وَرُبَّما","مَنَحتُ الهَوى مَن لَيسَ بِالمُتَقارِبِ",12,"ب",1,0],["وَمِن حَنَشٍ تَعَرَّضَ لِلمَنايا","كَأَنَّ مَجَرَّهُ فيها جَريرُ",13,"ر",1,0],["وَمَن حُبُّهُ زُلفَةٌ","بِها يُكرَمُ المَحشَرُ",14,"ر",1,0],["وَمِن حَقِّ الطُلولِ عَلَيَّ أَلّا","أُغِبَّ مِنَ الدُموعِ لَها سَحابا",15,"ب",2,0],["ومن حقٍّ يساقُ إلى حقيق","ومن جدوى تفاض على جدير",16,"ر",1,0],["ومنح وصفح ذاك معفٍ لمخطئٍ","وذاك صريح المكرمات لعافِ",17,"ف",1,0],["ومن حُسن أوجهِ سكانها","قُروداً تَزَحَّرُ تحت الغَضى",18,"ا",1,0],["ومن حرك المعتلَّ عرَّضَ وصْله","وخُلَّته للصَّرْم والغدْرِ بالعهدِ",19,"د",1,0],["ومن حاربته الليالي اشتكى","ومن سالمته الليالي فُجع",20,"ع",1,0],["ومن حكمها لعنُ الدعيِّ وثلبِهِ","إذا واصل الأرحام عُدَّ قطوعها",21,"ع",3,0],["ومنحْتَ الذميمَ منحةَ حمدٍ","ومنحت العديمَ منحةَ مالِ",22,"ل",1,0],["وَمَنحتُ مَجدَ الدينِ ما","أَنا مِن عُلاهُ مُستَميحُه",23,"ح",2,0],["وَمِن حَنَنتُ إِلى ما اِعتَدتُ مِن كَرَمٍ","حَنينَ أَرضٍ إِلى مُستأخر المَطَرِ",24,"ر",1,0],["ومن حراك النافر المرتقي","ومن سكون الثابت الراسبِ",25,"ب",1,0],["وَمِن حَقِّ الأَحِبَّةِ لَو أَجَنَّت","رَمائِمَها الجَوانِحُ وَالقُلوبُ",26,"ب",1,0],["وَمَن حَمَلَ الخَيلَ العِتاقَ عَلى الوَجا","تُقادُ إِلى الأَعداءِ مَثنىً وَمَوحَدا",27,"د",2,0],["وَمِن حَينِ قَحطاني سَجَستانِ أَصبَحوا","عَلى سَيِّئٍ مِن دينِهِم قَد تَغَيَّرا",28,"ر",2,1],["وَمِن حَولِهِ رَهطٌ أَصابَ أَخاهُمُ","بِهازِمَةٍ تَحتَ الفِراشِ المُحَطَّمِ",29,"م",1,0],["وَمِن حينِ آخى بَينَ مَن كانَ حاضِراً","هُنالِكَ آخاني وَبَيَّنَ مِن فَضلي",30,"ي",1,0],["وَمَنَحتَني فَبَذَلتُ مالَكَ في يَدي","وَحَسَدتُ جودَكَ لي فَجُدتُ بِمالي",31,"ي",1,0],["وَمَن حَوى مُكرُمَةَ ال","أَنواءِ مَع بَأسِ الأَسَد",32,"د",1,0],["وَمَن حَبانا قَبلَ","النِدا بِنَدى",33,"د",2,0],["ومُنحنَى هاته الضلوع","على صوادٍ بها جياع",34,"ع",1,0],["ومن حبيب إلى حبيب","ترنو حناناً وتبتسم",34,"م",1,0],["وَمِن حَلَبِ الأَوداجَ يُغْذى فَطيمنا","بحِجْرٍ من الهيجاءِ ساعةَ يُفْطَمُ",35,"م",1,0],["ومن حلّ في سبعين عاماً كأنَّهُ","عِلاجُ علِيلٍ في مُواصَلَةِ النُّكسِ",36,"س",1,0],["ومِن حَيثُ ما ساورتَهُ خِفتَ بأسَهُ","وَلِلنّارِ مِن حَيثُ انثَنَيتَ لها وَقدُ",37,"د",1,0],["وَمِن حَبيرِ اليُمنَةِ الأَبرادِ","مِن أَتحَمِيّاتٍ وَمِن وِرادِ",38,"د",1,0],["وَمَنَحتَهُم عِظَتَيكَ مِن مُتَوَعِّرٍ","مُتَسَهِّلٍ قاسي الفُؤادِ رَحيمِ",39,"م",1,0],["وَمَنَحتَني وُدّاً حَمَيتُ ذِمارَهُ","وَذِمامَهُ مِن هِجرَةٍ وَصُدودِ",40,"د",1,0],["وَمِن حُبِّها زُرتُ أَهلَ العِراقِ","وَأَسخَطتُ أَهلي وَأَرضَيتُها",41,"ت",3,0],["وَمِن حُرِّ نُبلٍ قَد أَفاضَتهُ هِمَّةٌ","فَساحَ بِهِ في سَفحِ ثَهلانَ مَورِدُ",42,"د",1,0],["ومن حملَ الأمانةَ في بلادٍ","تَدينُ بغيرها حَملَ العذابا",43,"ب",2,0],["وَمَن حَاز لَفظَ النَّصرِ من لَفظِ قَاهِرٍ","فَقَد حُزتَ مَعنَى النَّصرِ وَاسمُكَ فَاضِلُ",44,"ل",1,0],["وَمِن حَسرَةِ الدُنيا هَواكَ لِباخِلٍ","بَعيدٍ مِنَ العُتبي ضَنينٍ بِمَوعِدِ",45,"د",1,1],["وَمِنْ حَيْثُمَا وَجَّهْتَ وَجْهَكَ نَحْوَها","تَلَقَّتْكَ مِنها نَضْرَةٌ وسُرُورُ",46,"ر",1,0],["ومَنْ حَظُّهُ مِنْ حُسْنِ مَدْحِيَ وَافِرٌ","وحَظِّيَ مِنْ إِحْسَانِهِ بِيَ أَوْفَرُ",47,"ر",1,0],["ومن حبّها أني أكتِّم حبها","وأنّي بها صبٌّ كأنّيَ ذاهل",48,"ل",1,0],["ومن حَقّ غَيرِيَ أن يَجْتَدي","ومن حَقّ مثليَ أن يحتَكِم",49,"م",1,0],["ومنحْنَ الفِراقَ رِقّةَ شَكوْا","هنَّ حتّى عشِقْتُ يومَ الفِراق",50,"ق",1,0],["ومن حقِّ نفسٍ مثل نفسك صَونُها","ليوم القَنا الخطِّيِّ والفتكةِ البِكر",51,"ر",1,0],["ومن حضورِ الربوع تندبُها","ومن بكاءٍ لرحلةِ الإبل",52,"ل",1,0],["وَمِن حُبِّها أَبكي إِلَيها صَبابَةً","وَأَلقى بِها الأَحزانَ وَفداً عَلى وَفدِ",53,"د",1,0],["وَمِن حُبِّ دُنياهُم رَمَوا في وَغاهُمُ","بَغيضَ المَنايا بِالنُفوسِ الحَبائِبِ",54,"ب",1,0],["وَمَن حانَ يوماً جارَ في عَينيهِ عَمىً","وَفي لُبِهِ ضَعفٌ وَفي سَمِعهِ وَقرُ",55,"ر",1,0],["وَمِن حَولِهِ قَومٌ كَأَنَّ وُجوهَهُم","صَفّاً لَم يُلَيِّن بِالغُيوثِ الهَوامِعِ",56,"ع",1,0],["وَمن حاد عن نهج الحقيقة لم يعش","ومن لم يدار الدهر ناصبه الدهر",57,"ر",1,0],["وَمنحت بالأدب الفَضائِلَ زينةً","فكأَنَّه في جيدها أَطواق",58,"ق",1,0],["ومن حاد عَن نهج الطَبيعة لَم يعش","وَمن لَم يدار الدهر ناصبه الدهر",59,"ر",1,0],["ومن حقها أن يصبح المسك عامراً","لها وهي في أعلى المواضع تجعل",60,"ل",1,0],["وَمِن حَذَرِ الأَيَّامِ ما حَزَّ أَنفَهُ","قَصيرٌ وخاضَ الَموتَ بِالسَّيفِ بَيهَسُ",61,"س",1,1],["ومِن حَذَرِ الُملاَوِمِ والمَخازي","وهُنَّ الُمندِياتُ لِمنَ مُنينا",62,"ن",2,0],["وَمَنْ حَدَّثَتْهُ النَّفْسُ بِالْغَيِّ بَعْدَ مَا","تَنَاهَى إِلَيْهِ الرُّشْدُ سَارَ عَلَى بُطْلِ",63,"ل",1,0],["وَمَنَحَ اللّهُ الْمُبْدِعُ وَجْهَيْكُمَا","تَشابُهاً بِالْحُسْنِ وَالْبِشْرِ",64,"ر",1,0],["وَمَنَحَتْنِي شَرفاً أَتِي","هُ بِهِ عَلَى كُلِّ الأَنَامِ",65,"م",1,0],["وَمَنْ حَبَاكِ بِآدَابٍ مُكَمَّلَةٍ","هَيْهَاتَ تَعْدِلُهَا آدَابُ أَمْلاَكِ",66,"ك",1,0],["وَمِن حِكْمَةٍ مَا زَالَتِ المَصْدَرُ الَّذِي","صَفَا حَوْضُهُ المَوْرُودُ لِلْقَلْبِ وَالْفِكْرِ",67,"ر",1,0],["ومَنَحْتَه خُلُقَ العَطَاءِ فَغَرَّدتْ","صَدَّاحَةُ الوَادِي بفَضْلِ عَطَائه",68,"ا",3,0],["ومن حل هذا الملك لم يبق بعده","رحيلا ولم ينزع به عنه نازع",69,"ع",1,0],["ومن حيث كان يدقّ القطيع","طبول الصلاة أمام الذئاب",70,"ب",1,0],["ومن حيث كانت كؤوس الجراح","تزغرد بين شفاه الحراب",70,"ب",1,0],["ومن حيث يحسو حنين الربى","غبار المنى ونجيع السراب",70,"ب",1,0],["ومن حيث يتلو السؤال السؤال","ويبتلع الذعر وهم الجواب",70,"ب",1,0],["ومِنْ حيثُ احتُجزِتَ مشى طليقاً","يَهُّزُّ الكونَ جبارٌ عَصوف",71,"ف",1,0],["وَمنَحْتَها والعاصِفاتُ تؤودُها","مَتناً أزلَّ وساعداً مفتولا",72,"ل",2,0],["ومن حان، يوماً، جارَ في عينهِ عمىً،","وفي لبّه ضعفٌ، وفي سَمعِه وَقر",73,"ر",1,0],["وَمن حَينِ قَحطاني سجستانَ أصْبحوا","على سَيّءٍ من دينِهمْ قَدْ تَغَيّرَا",74,"ر",2,0],["ومن حارِبتْه اللَّيالي اشتكى","ومن سالمته الليالي مُجِعْ",75,"ع",1,0]]}