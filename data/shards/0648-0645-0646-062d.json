s://www.aldiwan.net/poem55960.html","الكامل"],[458,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[458,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[458,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[458,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[463,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[495,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[495,"لا والذي شق خمسي","https://www.aldiwan.net/poem9884.html","المجتث"],[500,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[515,"رأيت أبا القنص ضاقت به","https://www.aldiwan.net/poem12167.html","المتقارب"],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[516,"ومن حب سلمى راشح ليس بارحي","https://www.aldiwan.net/poem48639.html","الطويل"],[529,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[529,"مضى غير مذموم زمان شبابي","https://www.aldiwan.net/poem37534.html","الطويل"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[551,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[551,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[551,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[551,"إن كنت بالعفو ليس تعذرنا","https://www.aldiwan.net/poem47851.html","المنسرح"],[558,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[558,"لقد نظرت قوم بطرف لهم قذي","https://www.aldiwan.net/poem33813.html","الطويل"],[558,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[562,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[575,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["وَمَن حَلَّ ذاكَ الشِعبَ بَعدي وَراشَقَت","لَواحِظُهُ تِلكَ الظِباءَ الجَوازِيا",0,"ي",2,0],["وَمِن حَذَرٍ لا أَسأَلُ الرَكبَ عَنكُمُ","وَأَعلاقُ وَجدي باقِياتٌ كَما هِيا",0,"ي",2,0],["وَمَنَحتُهُ أَروى القَوافي عاتِباً","فَاِكتَنَّ في جَنبَيهِ سُمّاً قاتِلا",1,"ل",2,0],["وَمِنْ حَدَثَانِ الدَّهْر أَنْ أَسْتَميحَهُمْ","وَتَحْتَ نِجادِي مِدْرَهُ الحَدَثانِ",2,"ن",1,0],["ومِنْحَةٌ ضافيَةٌ أرْمي بِها","طَرْفِيَ في إثْرِ الغَمامِ الوابِلِ",3,"ل",1,0],["وَمَن حُبُّهُ يَزدادُ عِندِيَ جِدَّةً","وَحُبّي لَدَيهِ مُخلَقُ العَهدِ داثِرُ",4,"ر",1,0],["وَمِن حَرَقٍ لِلحُبِّ في باطِنِ الحَشا","وَلَيلٍ تَويلِ الحُزنِ غَيرِ قَصيرِ",5,"ر",1,0],["ومَنْ حَلَّ هَذا المُلْكَ لمْ يَبْغ بعْدَهُ","رَحيلاً ولمْ ينْزِعْ بِهِ عنْهُ نازِعُ",6,"ع",1,0],["وَمَنْ حَسَدَ الشَّمْسَ الْمُنِيرَةَ نُورَهَا","وَرِفْعَتَها فِي الْجَوِّ فَهْوَ جَهُولُ",7,"ل",1,0],["وَمِن حَواشي الحَواشي","عَلى مُتونِ اِبنِ جِنّي",8,"ي",1,0],["وَمِن حَملِيَ الكَأسَ المُفَدّى مُديرُها","تَقَحُّمُ أَهوالٍ حَمَلتُ لَها الرُمحا",9,"ح",2,0],["وَمَنْ حَدِيثٍ مطرب","فَازَ بِهِ مَنْ سَمِعَهْ",10,"ع",2,0],["وَمِنْ حُلاهَا استَمَدُّوا كُلَّ تَحْلِيَةٍ","بِلا مُحَاشَاةِ إِغْرِيقٍ وَ رُومَانِ",11,"ن",1,0],["وَمِن حاجَتي لَولا التَنائِي وَرُبَّما","مَنَحتُ الهَوى مَن لَيسَ بِالمُتَقارِبِ",12,"ب",1,0],["وَمِن حَنَشٍ تَعَرَّضَ لِلمَنايا","كَأَنَّ مَجَرَّهُ فيها جَريرُ",13,"ر",1,0],["وَمَن حُبُّهُ زُلفَةٌ","بِها يُكرَمُ المَحشَرُ",14,"ر",1,0],["وَمِن حَقِّ الطُلولِ عَلَيَّ أَلّا","أُغِبَّ مِنَ الدُموعِ لَها سَحابا",15,"ب",2,0],["ومن حقٍّ يساقُ إلى حقيق","ومن جدوى تفاض على جدير",16,"ر",1,0],["ومنح وصفح ذاك معفٍ لمخطئٍ","وذاك صريح المكرمات لعافِ",17,"ف",1,0],["ومن حُسن أوجهِ سكانها","قُروداً تَزَحَّرُ تحت الغَضى",18,"ا",1,0],["ومن حرك المعتلَّ عرَّضَ وصْله","وخُلَّته للصَّرْم والغدْرِ بالعهدِ",19,"د",1,0],["ومن حاربته الليالي اشتكى","ومن سالمته الليالي فُجع",20,"ع",1,0],["ومن حكمها لعنُ الدعيِّ وثلبِهِ","إذا واصل الأرحام عُدَّ قطوعها",21,"ع",3,0],["ومنحْتَ الذميمَ منحةَ حمدٍ","ومنحت العديمَ منحةَ مالِ",22,"ل",1,0],["وَمَنحتُ مَجدَ الدينِ ما","أَنا مِن عُلاهُ مُستَميحُه",23,"ح",2,0],["وَمِن حَنَنتُ إِلى ما اِعتَدتُ مِن كَرَمٍ","حَنينَ أَرضٍ إِلى مُستأخر المَطَرِ",24,"ر",1,0],["ومن حراك النافر المرتقي","ومن سكون الثابت الراسبِ",25,"ب",1,0],["وَمِن حَقِّ الأَحِبَّةِ لَو أَجَنَّت","رَمائِمَها الجَوانِحُ وَالقُلوبُ",26,"ب",1,0],["وَمَن حَمَلَ الخَيلَ العِتاقَ عَلى الوَجا","تُقادُ إِلى الأَعداءِ مَثنىً وَمَوحَدا",27,"د",2,0],["وَمِن حَينِ قَحطاني سَجَستانِ أَصبَحوا","عَلى سَيِّئٍ مِن دينِهِم قَد تَغَيَّرا",28,"ر",2,1],["وَمِن حَولِهِ رَهطٌ أَصابَ أَخاهُمُ","بِهازِمَةٍ تَحتَ الفِراشِ المُحَطَّمِ",29,"م",1,0],["وَمِن حينِ آخى بَينَ مَن كانَ حاضِراً","هُنالِكَ آخاني وَبَيَّنَ مِن فَضلي",30,"ي",1,0],["وَمَنَحتَني فَبَذَلتُ مالَكَ في يَدي","وَحَسَدتُ جودَكَ لي فَجُدتُ بِمالي",31,"ي",1,0],["وَمَن حَوى مُكرُمَةَ ال","أَنواءِ مَع بَأسِ الأَسَد",32,"د",1,0],["وَمَن حَبانا قَبلَ","النِدا بِنَدى",33,"د",2,0],["ومُنحنَى هاته الضلوع","على صوادٍ بها جياع",34,"ع",1,0],["ومن حبيب إلى حبيب","ترنو حناناً وتبتسم",34,"م",1,0],["وَمِن حَلَبِ الأَوداجَ يُغْذى فَطيمنا","بحِجْرٍ من الهيجاءِ ساعةَ يُفْطَمُ",35,"م",1,0],["ومن حلّ في سبعين عاماً كأنَّهُ","عِلاجُ علِيلٍ في مُواصَلَةِ النُّكسِ",36,"س",1,0],["ومِن حَيثُ ما ساورتَهُ خِفتَ بأسَهُ","وَلِلنّارِ مِن حَيثُ انثَنَيتَ لها وَقدُ",37,"د",1,0],["وَمِن حَبيرِ اليُمنَةِ الأَبرادِ","مِن أَتحَمِيّاتٍ وَمِن وِرادِ",38,"د",1,0],["وَمَنَحتَهُم عِظَتَيكَ مِن مُتَوَعِّرٍ","مُتَسَهِّلٍ قاسي الفُؤادِ رَحيمِ",39,"م",1,0],["وَمَنَحتَني وُدّاً حَمَيتُ ذِمارَهُ","وَذِمامَهُ مِن هِجرَةٍ وَصُدودِ",40,"د",1,0],["وَمِن حُبِّها زُرتُ أَهلَ العِراقِ","وَأَسخَطتُ أَهلي وَأَرضَيتُها",41,"ت",3,0],["وَمِن حُرِّ نُبلٍ قَد أَفاضَتهُ هِمَّةٌ","فَساحَ بِهِ في سَفحِ ثَهلانَ مَورِدُ",42,"د",1,0],["ومن حملَ الأمانةَ في بلادٍ","تَدينُ بغيرها حَملَ العذابا",43,"ب",2,0],["وَمَن حَاز لَفظَ النَّصرِ من لَفظِ قَاهِرٍ","فَقَد حُزتَ مَعنَى النَّصرِ وَاسمُكَ فَاضِلُ",44,"ل",1,0],["وَمِن حَسرَةِ الدُنيا هَواكَ لِباخِلٍ","بَعيدٍ مِنَ العُتبي ضَنينٍ بِمَوعِدِ",45,"د",1,1],["وَمِنْ حَيْثُمَا وَجَّهْتَ وَجْهَكَ نَحْوَها","تَلَقَّتْكَ مِنها نَضْرَةٌ وسُرُورُ",46,"ر",1,0],["ومَنْ حَظُّهُ مِنْ حُسْنِ مَدْحِيَ وَافِرٌ","وحَظِّيَ مِنْ إِحْسَانِهِ بِيَ أَوْفَرُ",47,"ر",1,0],["ومن حبّها أني أكتِّم حبها","وأنّي بها صبٌّ كأنّيَ ذاهل",48,"ل",1,0],["ومن حَقّ غَيرِيَ أن يَجْتَدي","ومن حَقّ مثليَ أن يحتَكِم",49,"م",1,0],["ومنحْنَ الفِراقَ رِقّةَ شَكوْا","هنَّ حتّى عشِقْتُ يومَ الفِراق",50,"ق",1,0],["ومن حقِّ نفسٍ مثل نفسك صَونُها","ليوم القَنا الخطِّيِّ والفتكةِ البِكر",51,"ر",1,0],["ومن حضورِ الربوع تندبُها","ومن بكاءٍ لرحلةِ الإبل",52,"ل",1,0],["وَمِن حُبِّها أَبكي إِلَيها صَبابَةً","وَأَلقى بِها الأَحزانَ وَفداً عَلى وَفدِ",53,"د",1,0],["وَمِن حُبِّ دُنياهُم رَمَوا في وَغاهُمُ","بَغيضَ المَنايا بِالنُفوسِ الحَبائِبِ",54,"ب",1,0],["وَمَن حانَ يوماً جارَ في عَينيهِ عَمىً","وَفي لُبِهِ ضَعفٌ وَفي سَمِعهِ وَقرُ",55,"ر",1,0],["وَمِن حَولِهِ قَومٌ كَأَنَّ وُجوهَهُم","صَفّاً لَم يُلَيِّن بِالغُيوثِ الهَوامِعِ",56,"ع",1,0],["وَمن حاد عن نهج الحقيقة لم يعش","ومن لم يدار الدهر ناصبه الدهر",57,"ر",1,0],["وَمنحت بالأدب الفَضائِلَ زينةً","فكأَنَّه في جيدها أَطواق",58,"ق",1,0],["ومن حاد عَن نهج الطَبيعة لَم يعش","وَمن لَم يدار الدهر ناصبه الدهر",59,"ر",1,0],["ومن حقها أن يصبح المسك عامراً","لها وهي في أعلى المواضع تجعل",60,"ل",1,0],["ومن حمى ظلم فرعون لأمّته","فقد تفرعن طغيانا ومعتقدا",61,"د",2,0],["وَمِن حَذَرِ الأَيَّامِ ما حَزَّ أَنفَهُ","قَصيرٌ وخاضَ الَموتَ بِالسَّيفِ بَيهَسُ",62,"س",1,1],["ومِن حَذَرِ الُملاَوِمِ والمَخازي","وهُنَّ الُمندِياتُ لِمنَ مُنينا",63,"ن",2,0],["وَمَنْ حَدَّثَتْهُ النَّفْسُ بِالْغَيِّ بَعْدَ مَا","تَنَاهَى إِلَيْهِ الرُّشْدُ سَارَ عَلَى بُطْلِ",64,"ل",1,0],["وَمَنَحَ اللّهُ الْمُبْدِعُ وَجْهَيْكُمَا","تَشابُهاً بِالْحُسْنِ وَالْبِشْرِ",65,"ر",1,0],["وَمَنَحَتْنِي شَرفاً أَتِي","هُ بِهِ عَلَى كُلِّ الأَنَامِ",66,"م",1,0],["وَمَنْ حَبَاكِ بِآدَابٍ مُكَمَّلَةٍ","هَيْهَاتَ تَعْدِلُهَا آدَابُ أَمْلاَكِ",67,"ك",1,0],["وَمِن حِكْمَةٍ مَا زَالَتِ المَصْدَرُ الَّذِي","صَفَا حَوْضُهُ المَوْرُودُ لِلْقَلْبِ وَالْفِكْرِ",68,"ر",1,0],["ومَنَحْتَه خُلُقَ العَطَاءِ فَغَرَّدتْ","صَدَّاحَةُ الوَادِي بفَضْلِ عَطَائه",69,"ا",3,0],["ومن حل هذا الملك لم يبق بعده","رحيلا ولم ينزع به عنه نازع",70,"ع",1,0],["ومن حيث كان يدقّ القطيع","طبول الصلاة أمام الذئاب",71,"ب",1,0],["ومن حيث كانت كؤوس الجراح","تزغرد بين شفاه الحراب",71,"ب",1,0],["ومن حيث يحسو حنين الربى","غبار المنى ونجيع السراب",71,"ب",1,0],["ومن حيث يتلو السؤال السؤال","ويبتلع الذعر وهم الجواب",71,"ب",1,0],["ومِنْ حيثُ احتُجزِتَ مشى طليقاً","يَهُّزُّ الكونَ جبارٌ عَصوف",72,"ف",1,0],["وَمنَحْتَها والعاصِفاتُ تؤودُها","مَتناً أزلَّ وساعداً مفتولا",73,"ل",2,0],["ومن حاجتن .. ماتهون ألآ بمنه . ولوم.","ومن .. ؟ نقدة اللي لو أخطى ... ؟ ماني بناقده ..",74,"د",2,0],["ومن حان، يوماً، جارَ في عينهِ عمىً،","وفي لبّه ضعفٌ، وفي سَمعِه وَقر",75,"ر",1,0],["ومن حقّه أن أحمل الجرح راضيا","ومن حقّه أن لا ألوم وأعتبا",76,"ب",2,0],["وَمن حَينِ قَحطاني سجستانَ أصْبحوا","على سَيّءٍ من دينِهمْ قَدْ تَغَيّرَا",77,"ر",2,0],["ومن حارِبتْه اللَّيالي اشتكى","ومن سالمته الليالي مُجِعْ",78,"ع",1,0],["ومن حولنا الأطلال تستنفر الدجى","وترخي على الأشباح غابا من اللحى",79,"ح",2,0],["ومن حال البتول به شؤُن","لها قدم العلا في السابقين",80,"ن",1,0],["ومن حمى قربك اخرجتني","تقدر ان تخرج من قلبي",81,"ي",1,0],["ومنحت الهادي محمد عزا","دائما شأنه بغير انقضاء",82,"ا",2,0],["وَمَن حَجَّ بَيتَ اللَهِ مِن كُلِّ راكِبٍ","وَمِن كُلِّ ذي نَذرٍ وَمِن كُلِّ راجِلِ",83,"ل",1,0],["وَمَن حَقّاً لَو اِعطِي ما تَمَنّى","مِنَ الأَرضِ العَريضَةِ ما عَداكِ",84,"ك",1,0],["ومَن حتُفه بين أضلاعه","أيمنعه أنّه دارعُ",85,"ع",1,0],["ومن حِذارٍ تبوّأَ الكُديْةَ الض","بُّ وأوفىَ في الشاهقِ الوَعِلُ",86,"ل",1,0],["وَمَنَحتَها خَيرَ الأَنامِ مَقودَةً","وَلَها مِنَ النُصحِ الصَريحِ دَليلُ",87,"ل",1,0],["ومن حسن احسان الجناب ملابسا","نحوز بها الزلفى بدنيا وأخرة",88,"ه",1,0],["ومن حسم الثؤلول حال طلوعه","تدارك مشكواً لاذا قبل أن يشكا",89,"ك",2,0],["ومنحملت فعلي على غير ما اقتضى","عناداً وظلما لا يزاد بيانا",90,"ن",2,0],["ومن حركاته نصب وخفض","تشرك كونه بعد انضمام",91,"م",1,0],["ومن حب من عادى الإله فانه","بذلك في الأعداء لله يحسب",92,"ب",1,0],["وَمَن حَلَّ بِالحَبلِ الشَجيرِ إِلى المَلا","وَحُلّال تِلكَ الدائِراتِ اللَوابِثِ",93,"ث",1,0],["وَمِن حَقِّ بَيتٍ مِنهُ يُعزى اِبنُ عَبدَلٍ","دَوامُ عُلُوٍّ في أَتَمِّ كَمالِ",94,"ل",1,0],["وَمِنْ حَادِثٍ دُسْتُ أَمْثَالَهُ","وَأَتْبَعْتُ نَكْبَ مَعانِيهِ نَكْبَا",95,"ب",2,0],["وَمَن حَوى مِثل ما يَحويهِ مِن هِمَمٍ","لا غَروَ أَرَّخَتُ أَن يَرقى ذُرى الشَرَفِ",96,"ف",1,0],["وَمَن حَجّت لِكَعبَتِهِ الأَماني","فَأَرجَعَها نَداهُ أَجلَّ رَجعى",97,"ع",2,0],["ومن حبيبٍ أَرانِي فيكَ مَنظرُه","رَوْضا من الْحُسْنِ في روضٍ من الأدبِ",98,"ب",1,0],["ومن حديثٍ يَسُرُّ النفسَ مَوْقعُه","كأنما اشْتُقَّ من صِرفِ ابْنِة العِنَب",98,"ب",1,0],["وَمِن حيثُ أصل الدجلِ أكفاءُ بعضهم","فَلا واحدٌ يُبدي على واحدٍ فخرا",99,"ر",2,0],["وَمِن حمقهِ أَو كفرِه قال إنّه","إِلهي وقَد أكثرتُ في مدحهِ الشعرا",99,"ر",2,0],["ومنحتهُ حبّي فأدبر ساخراً","منّي وأشمت حاسدي وجفاني",100,"ي",1,0],["وَمَنْ حُبُّهُ للخرَّدِ العينِ صادقٌ","رأى أنَّ مَنْ أَهدى النصيحةَ يافك",101,"ك",1,0],["ومن حبِّ آباءِ الصغار صغارهم","تعوَّدُ روح الطفل ان تسكن الجلدا",102,"د",2,0],["ومن حيثما يممت نحو محيطها","تراهُ على كل الجهات ارتمى سدا",102,"د",2,0],["ومن حولها أعين ناعسات","تعلم هاروت من سحرها",103,"ه",2,0],["ومِنْ حولِهِ يزهو اخْضِرارَ عذاره","وفاءاتُ صُدغيه يُبَيِّنُها النَقْطُ",104,"ط",1,0],["ومنحته ماضيه بعد ضياعه","وأعذت قابله من المحظور",105,"ر",1,0],["ومنَحتني مكنونَ حُبِّك خالصاً","مَحْضاً مَشُوباً بالمفَاصِلِ والدَّمِ",106,"م",1,0],["ومن حكت مقلتاه الظَّبْيَ مُلْتَفتاً","وأشبهَ الغصنَ تليينا ومُنعَطَفا",107,"ف",2,0],["وَمَنْ حَوى العلمَ والْمَجْدَ الصُّراحَ مَعاً","وَمَنْ رَوى عَنْ أَبيهِ البِرَّ وَالرَّشَدَا",108,"د",2,0],["وَمَنْ حَمَى لِلْمُسْلِمِينَ أَسىً","فَاقْصُرْ عَلَيْهِ رَبَّنَا حِمْيَهْ",109,"ي",2,0],["ومن حماة الشام في ايامه","بالعدل تجلى كعروس حسنه",110,"ن",2,0],["ومن حالكات الأدم بحر إذا طما","طفا دره الزاهي واورى زنده",111,"د",2,0],["ومن حولِنا المنثُورُ يُعطيكِ لونهُ","ورّياهُ إذ ألفى يَدَيكِ غماما",112,"م",2,0],["ومن حبّاتِ عقدِكِ قد تدلّى","صَليبٌ يحرسُ الكنزَ الثمينا",113,"ن",2,0],["وَمن حارَبَتْ عنه السُعودُ فَمَا لَهُ","يُشاوِر آسادَ الوَغَى ويُسَاوِرُ",114,"ر",1,0],["ومُنحت بالعزّ الَّذي","يُعدي على صَرْف الدُّهورِ",115,"ر",1,0],["وَمَنحْتُهُمْ جَفْناً إِذا نَهْنَهْتُهُ","رَقَأَتْ جُفُونُ الثّاكِلاتِ وَما رَقا",116,"ق",2,0],["ومن حكمة ترثي لفقد مفجر","لينبوعها السلسال في الأرض سالكِ",117,"ك",1,0],["وَمِن حُسنِهِ حِصنُهُ لَم يُرَع","بِجَيشِ وَغىً لَجِبٍ حامِلِ",118,"ل",1,0],["وَمِن حَولِها تَنمي فُروعٌ مُنيفَةٌ","بِجُرثومَةٍ أَضحَت لِخاتَمِها فَصّا",119,"ص",2,0],["ومن حباهُ اللَه أَنباءَ ما","في كُتبه فهو لها فِهرِسُ",120,"س",1,0],["ومن حبِ السلامِ حوى سلاحي","ليكفيني ممارسةَ القتال",121,"ل",1,0],["وَمَنَحتُها قَولي عَلى عُرضِيَّةٍ","عُلُطٍ أُداري ضِغنَها بِتَوَدُّدِ",122,"د",1,0],["ومن حبهم في الحشا قد قطن","وخامر مني جميع العظام",123,"م",1,0],["ومن حاد عن علم الكتاب وسنة","فبشره في الدنيا بخزي وذلة",124,"ه",1,0],["ومن حقه أن حق حقت لك ال","حقيقة من إحسانك المعنوية",124,"ه",1,0],["ومن حييت من موتة الجهل نفسه","بعلم نجت من قطع كل منية",125,"ه",1,0],["ومن حقّك أن تأمن","آثامي وأخطاري",126,"ي",1,0],["ومن حقي أن تست","ر عاري إن بدا عاري",126,"ي",1,0],["ومن حوى علما وليس يعمل","به فإنه حمار يحمل",127,"ل",1,0],["ومن حاشاكم يرد المنايا","ويحتقر النوائب والصعابا",128,"ب",2,0],["وَمَنَحَ الخُمسَ مِنَ النِصابِ مَن","آلَ إِلَيهِم فَتَزَكّى وَطَهُر",129,"ر",1,0],["وَمِن حِمى حامٍ إِلى دانٍ دَنَت","وَنَجلُ سَمعانَ بِها مِنهُ اِتَّزَر",129,"ر",1,0],["وَمَنَحتُهُ صَفوَ المَوَدَّةِ باذِلاً","لِلنَفسِ فيهِ حَيثُ كانَ مُمَنَّعا",130,"ع",2,0],["وَمِن حَبلِ الوَريدِ غَدَوتَ أَدنى","إِلى قَلبي وَإِنَّكَ غَيرُ إِنّي",131,"ن",2,0],["ومن حُرَقي يا صاحِ أنّيَ ناهلٌ","ولا أرتَضي للوِرْدِ كُلَّ المَناهل",132,"ل",1,0],["ومَن حَلَّ فوقَ مَحلِّ النُّجومِ","فلا شَيْءَ يَنقُصه أو يَزيد",133,"د",1,0],["ومَن حَجَّهُ من شَرْقِ أرضٍ وغَرْبِها","على ضُمرٍ خُوصِ العيونِ طَلائح",134,"ح",1,0],["ومِن حَوْله من كلِّ ما الله