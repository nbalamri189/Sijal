/54199","الخفيف"],[106,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"بُشرى يقومُ لها الزّمانُ خطيبا","https://www.poetsgate.com/ViewPoem.aspx?id=33311",""],[100,"من ذا هنا","https://www.poetsgate.com/ViewPoem.aspx?id=50178",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[98,"الشباب الذاوى","https://www.poetsgate.com/ViewPoem.aspx?id=55332",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[0,"لَعَمْرُكَ ما قَلْبي إلى أهْلِهِ بِحُرْ","https://www.poetsgate.com/ViewPoem.aspx?id=4785",""],[45,"تَلُومُ المَادَرَائِّيينَ جَهْلاً","https://www.poetsgate.com/ViewPoem.aspx?id=32131",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[91,"فلسفة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=53232",""],[28,"عفى المنازل آخر الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=20966",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[31,"أتوصلُ زينبُ، أمْ تهجرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18900&r=&rc=163",""]],"verses":[["وَتَعنو المُلوكُ لَهُ خيفَةً","إِذا راعَ قَبلَ اللَظى بِالدُخانِ",0,"ن",1,0],["وَتَعرِفُ في عِرنينِهِ المَجدَ ساهِماً","عَلى عَقِبِ الإِدلاجِ أَو غَيرَ ساهِمِ",1,"م",1,0],["وَتَعرِضُ غُرّاتُ العُلى وَهوَ كانِعٌ","فَيَلحَظُها شَزراً بِعَينِ قَطامي",2,"ي",1,0],["وَتَعَزَّ إِن مِنَ العَزاءِ شَجاعَةً","وَأَعَزُّ ما عَزّى نُفوساً خيمُها",3,"م",3,0],["وَتَعقِدُ طَرفي مِنكَ في كُلِّ نَظرَةٍ","طَلاقَةُ بَدرٍ بِالمَعالي مُعَمَّمِ",4,"م",1,0],["وَتُعجِبُهُ غُرُّ البُروقِ يَشيمُها","سِراعاً إِذا مَرَّت عَليها الغَمائِمُ",5,"م",1,0],["وَتَعَرَّفتُ قائِليهِ وَلَكِن","آهِ لَو كانَ في يَميني حُسامُ",6,"م",1,0],["وَتَعَلَّل بِالمُدامِ لَهُ","إِنَّما الدُنيا تَعاليلُ",7,"ل",1,0],["وَتَعلو المَعالي إِلى العاجِزينَ","وَنحنُ نَرى الذُلَّ أَعلى وَأَغلى",8,"ل",2,0],["وَتَعذِمُني فَتُخطي صَفحَتَيها","عَذامي يَومَ أَعذِمُ أَو ضَراسي",9,"ي",1,0],["وَتَعَطلَت وَقَفاتُ كُلِّ كَريهَةٍ","أَبَداً وَحُطَّ رِواقُ كُلِّ غُبارِ",10,"ر",1,0],["وَتَعَلَّموا أَنَّ الصَبا","حَ ضُبارِمٌ وَاللَيلَ غابُ",11,"ب",1,0],["وَتَعَمَّد ذِكري إِذا كُنتَ بِالخي","فِ لِظَبيٍ مِن بَعضِ تِلكَ الظِباءِ",12,"ا",2,0],["وَتُعْبِقُ رَيّا كَفِّهِ يَزَنِيَّةً","إِذَا لَمَسَتْها كادَ يَخْضَرُّ عُودُها",13,"د",3,0],["وَتَعْتَرِكُ الفَوارِسُ في مَكَرٍّ","يُريكَ السُّمْرَ دامِيَةَ الزِّجاجِ",14,"ج",1,0],["وَتَعْجَبُ مِنْ بَذْلِي لِكُلِّ رَغيبَةٍ","وَجُودِي بِمَا أَحْويهِ مِنْ كُلِّ مُنْفِسِ",15,"س",1,0],["وَتَعْلَمُ أَنِّي مِنْ بَقِيَّةِ مَعْشَرٍ","نَماهُمْ إِلى العَلْياءِ أِكرَمُ مَغْرَسِ",15,"س",1,0],["وتعثّرَتْ نُوَبُ الزّمانِ بماجِدٍ","إنْ لمْ يُقاتِلْ في النّوائِبِ حرّضا",16,"ض",2,0],["وتَعْلَمُ ما نَبْغي فتَبْتَدِرُ المَدى","ولَيْسَتْ عليْها الأصبَحيّةُ تَجْهَلُ",17,"ل",1,0],["وتُعْرَفُ فيهِ من وُهَيْبٍ وجَعْفرٍ","شَمائِلُ مَنْ يَفْخَرْ بِها لا يُلَجْلِجِ",18,"ج",1,0],["وتَعْجَبُ أني منْ مُمارَسَة النّوى","نَحيفٌ وفي مَتْنِ القَناةِ ذُبولُ",19,"ل",1,0],["وتَعْثُرُ بالكُماةِ الصِّيدِ صَرْعَى","فتَنْفِرُ وهْيَ تَحْسَبُهمْ نَخيلا",20,"ل",2,0],["وتَعاوَدَتْ عَذْلي فَما أرْعَيْتُها","سَمْعاً يَقِلُّ بهِ المَلامُ ويَكْثُرُ",21,"ر",1,0],["وتعلّما أني أُجيلُ وراءَهُ","طَرْفاً يُثيرُ على الفؤادِ هُموما",22,"م",2,0],["وتَعتُّم ساقيها، وتجترُّ وجهه","وترمي الذي أوشى بجذع الذي لغا",23,"غ",2,0],["وَتَعَطَّفنَها عَلَيَّ وَيَحلِف","نَ عَلى ما ذَكَرنَ بِالأَيمانِ",24,"ن",1,0],["وَتَعَالَ نَأَخُذْ بِاَلْهَوَى عَهْداً كَمَا","كُنَّا عَلَيْهِ فِي الزَّمَانِ الْمَاضِي",25,"ي",1,0],["وَتَعَشَّى النَّهَارُ مِنْ صَفْحَةِ الطِّرْ","سِ مِدَاداً أَضْفَى عَلَيْهِ ظَلاَمَهْ",26,"م",2,0],["وَتُعْرَفُ مِنْ أَعِزَّتَنَا الدَّيَاجِي","لِعِزِّ اللَّهِ خَاشِعَةً أَذِلَّهْ",27,"ل",2,0],["وتَعاهَدَتْكَ من ابْنِكَ القُرَبُ التي","تمْتارُ نحْوَ رِضاكَ ما تمْتارُهُ",28,"ر",2,0],["وتعبُدُ منْ دونِ الإلاهِ حِجارةً","طَغامُ رِجالٍ يجْعَلونَ لهُ نِدّا",29,"د",2,0],["وَتَعَلَّقَتْ بُهْمُ الرِّجَالِ بِسُوْرِهِ","فَتُخَالُ فِي شُرُفَاتِهِ يَعْسُوبَا",30,"ب",2,0],["وَتَعادى عَنهُ النَهارَ تُواري","هِ عِراضُ الرِمالِ وَالدَرداقُ",31,"ق",1,0],["وَتَعنو الطَبيعَةُ لِلعارِفينَ","بِمَعنى الوُجودِ وَسِرِّ الهُدى",32,"د",2,0],["وَتَعلَمُ أَنَّ الطَبعَ لازالَ غالِباً","سَواءَ جَهولُ القَومِ وَالمُتَعَلِّمُ",33,"م",1,0],["وَتَعانَقوا بَعدَ النَوى كَخَمائِلٍ","يَحلو بِهِنَّ تَعانُقُ الأَغصانِ",34,"ن",1,0],["وَتَعاطى المُلوكُ نَيلَ مَعالي","هِ فَنالوا مِن دونِ ذلِكَ جَهدا",35,"د",2,0],["وَتَعتَّقَت في آبِلٍ حُقُباً","لَم تُمتَهَن مَزجاً وَلَم تُذَلِ",36,"ل",1,0],["وَتعافُ خَيلُهُمُ الوُرودَ بِمنهَلٍ","ما لَم يَكُن بِدَمِ الوَقائِعِ أَحمَرا",37,"ر",2,0],["وَتَعطو بِرَخصٍ غَيرِ شَثنٍ كَأَنَّهُ","أَساريعُ ظَبيٍ أَو مَساويكُ إِسحِلِ",38,"ل",1,0],["وَتَعرِفُ فيهِ مِن أَبيهِ شَمائِل","وَمِن خالِهِ أَو مِن يَزيدَ وَمِن حُجَر",39,"ر",1,0],["وَتَعدو كَعَدوِ نَجاةِ الظِباءِ","أَخطَأَها الحاذِفُ المُقتَدِر",40,"ر",1,0],["وَتَعانَقَت أُدمُ الظِبّاءِ وَباشَرَت","أَكنافَ كُلِّ ظَليلَةٍ مِقيالِ",41,"ل",1,0],["وَتُعرَفُ إِن ضَلَّت فَتُهدى لِرَبِّها","لِمَوضِعِ آلاتٍ مِنَ الطَلعِ أَربَعِ",42,"ع",1,0],["وَتَعْنِي بِتَعْلِيمِ البَنَاتِ عِنَايَةً","تَرْقَى بِهَا أَخْلاقُهَا وَتَصًونُ",43,"ن",1,0],["وَتُعْنَى بِعَافِيَةِ الأُمَّهَاتِ","وَتَرْعَى البَنَاتِ وَتَرْعَى البَنِينْ",44,"ن",1,0],["وَتَعَدَّدَتْ آياتُهَا حَتَّى غَدَت","وَبِهَا لِكُلِّ مُكَابِرٍ تَسْلِيمُ",45,"م",1,0],["وَتَعُجُّ طوراً بِالنَبِيِّ المُصطَفى","يا والِدي الساقي عَلِيِّ المُرتَضى",46,"ض",2,0],["وتَعقِدُ المِرطَ عَلى جَسرَةٍ","مثلِ كَثيبِ الرَملِ أَو أَعظَمَا",47,"م",2,0],["وتُعرف فيها من أبيها شمائلٌ","كما في أبيها من أبيه شمائلُ",48,"ل",1,0],["وتعالت راياتهم خافقاتٍ","في جيوش عنا لها الخافقان",49,"ن",1,0],["وتعتزّ من أرض الشَآم دمشقها","وتهتز من أرض العراقَيْن بغدان",50,"ن",1,0],["وتعاون الأقوام ليس بحاصل","إلاّ بنَشْر العلم في أوطانها",51,"ن",3,0],["وتعالى إلى أعاليه حتى","نال منه قديمة والجديدا",52,"د",2,0],["وَتُعجِبُ قَيساً وَالقُباعَ إِذا اِنتَشَوا","سَوالِفُ مالَت لِلصِبا وَعُيونُ",53,"ن",1,0],["وَتَعجَبُ مِن شُحوبي أُمُّ نوحٍ","وَما قاسَت رَواحي وَاِبتِكاري",54,"ي",1,0],["وَتُعرَفُ بِالمَنازِلِ يا اِبنَ تَيمٍ","لَئيمَ الضَربِ مُطَّرِفَ النِجارِ",55,"ر",1,0],["وَتَعرِفُ عِتقَهُنَّ عَلى نُحولٍ","وَقَد لَحِقَت ثَمائِلَها اِنضِماما",56,"م",2,0],["وتعاطى به ابنُ عائشة البد","رَ له رقيباً نظيرا",57,"ر",2,0],["وَتَعَطَّلَت سُمرُ الرِما","حِ وَأُغمِدَت بيضُ النُصولِ",58,"ل",1,0],["وَتَعافُ لي طَمَعَ الحَريصِ أُبُوَّتي","وَمُروءَتي وَقَناعَتي وَعَفافي",59,"ي",1,0],["وَتُعطِ المَقادَ عَلى رَغمِها","وَيَنزِل مِنَ الهامِ عِصيانُها",60,"ن",3,0],["وتعوَّدت في كلِّ مصرٍ عنده","مرعى يقابل جدبها بخصيب",61,"ب",1,0],["وتعجب لطرةٍ وجبينٍ","إنَّ في الليلِ والنهارِ عجائب",62,"ب",1,0],["وتعي الكفّ عن كشحٍ هضيمٍ","فأرفعها إلى رِدفٍ وثير",63,"ر",1,0],["وتعجَّلْ هذا المراد فما يح","مل حالي الضعيف أن يتأخَّر",64,"ر",1,0],["وتعلم بأن حظّك أوفى","في اتِّصال الأرفاد والإرفاق",65,"ق",1,0],["وتعرف فيه من أبيه شمائلاً","ومن جدِّه والسابقين من الأهل",66,"ل",1,0],["وتعدى الكرام سبقاً إلى أن","قيل ما ذا في قدرة الإنسان",67,"ن",1,0],["وتعالت إلى السماءِ إلى أن","نظرت في الذِّراع وفي الميزان",68,"ن",1,0],["وتعطَّلت آراء طالب شبههم","وهم الردى لمعطَّلٍ ومشبّه",69,"ه",1,0],["وَتَعاهَدها بِسَقيٍ","مِن كُؤوسٍ دائِراتِ",70,"ت",1,0],["وتعالتْ به سماءُ المعالي","أو ترى مجدَه السماءُ سماءَ",71,"ا",2,0],["وتَعلَّمْ متى حَميت على عب","دك تلك المياه والأَكْلاءَ",72,"ا",2,0],["وتُعيدُ نشأتها المشيبَ إلى الصِّبا","فكأن عيسى جاء بالإحياءِ",73,"ا",2,0],["وتعوي هذه فتُطي","لُ منك الحزنَ والوَصبا",74,"ب",2,0],["وتعصِفُ ريحُ الخطبِ عند هُبوبها","وأنت كركنِ الطَّودِ ذي الهَضباتِ",75,"ت",1,0],["وتُعِيرُ نَكْهَتَهَا نَدِيمَ أَحِبَّةٍ","فَيُقَبِّلُ التُّفَّاحَ بالتُّفَّاحِ",76,"ح",1,0],["وتعالتْ عن المهلَّبِ قِدْماً","في أَيازيده وعن أزيادِهْ",77,"د",2,0],["وتَعلَّمْ غيرَ ما مُستَأْنفٍ","علْم شيء أيها العِدُّ المَكُودُ",78,"د",1,0],["وتعقِر قدري مستخفاً بحاجتي","رويدك إن القتل أدهىَ من العقر",79,"ر",1,0],["وتُعقَب بالبين الذي برَّحت به","لكل محب كان منها مروَّعا",80,"ع",2,0],["وتُعرم غُلْمتي ويقوم أيري","إذا عز السّفاح فأعتريكا",81,"ك",2,0],["وتعتدُّ شُكري الذي يُسْتقلْ","لُ فوق جداكَ الذي لا يَقِلُّ",82,"ل",1,0],["وتعاصَى فقاده بيديه","أحدثُ الأخْفشَين فانقاد رَسْلا",83,"ل",2,0],["وتعلمْ أيّنا المغبونُ منا","عِياناً أو يقوم لك الدليل",84,"ل",1,0],["وتعلَّم أنّي وإن أنا أُذلِل","تُ بما قلتُ فيك من أقوالِ",85,"ل",1,0],["وتعود الرياضُ مقتبلاتٍ","ناعماتِ الشَّكير والأفنان",86,"ن",1,0],["وتعقِدُ الوعدَ فإنجازُه","خُلفٌ إذا إنجازهُ آنا",87,"ن",2,0],["وَتَعَرَّضَت لَكَ بِالأَبالِخِ بَعدَ ما","قَطَعَت بِأَبرَقَ خُلَّةً وَوِصالا",88,"ل",2,0],["وَتَعَرّى الرَوضُ مِن أَزهارِهِ","وَتَوارى النورُ في كَهفِ الشِتاء",89,"ا",2,0],["وَتَعالى الضَجيجُ لِلأُفقِ حَتّى","كادَ ذاكَ الضَجيجُ بِالأُفقِ يودي",90,"د",2,0],["وَتَعانَقا فَبَكى الفَتى فَرَحاً","إِنَّ البُخارَ نَتيجَةُ الحَرِّ",91,"ر",1,0],["وَتَعظُمُ الأَرضُ في عَينَيكَ مُحتَرَماً","وَلَيسَ تَعظُمُ في عَينَيكَ مُحتَقَرا",92,"ر",2,0],["وَتَعرِفُ الأَمنَ أَرواحٌ تُرَوِّعُها","ثَلاثَةٌ أَنتَ وَالنيرانُ وَالأَسَلُ",93,"ل",1,0],["وَتَعاقَبَت صُوَرُ الجَمالِ فَلَم يَدُم","في خاطِري مِنها سِوى تِمثالَها",94,"ل",3,0],["وَتَعَلَّم حُبَّ الطَبيعَةِ مِنها","وَاِترُكِ القالَ لِلوَرى وَالقيلا",95,"ل",2,0],["وَتَعَطَّلَت جَنّاتُها وَقُصورُها","وَلَقَد تَكونُ بِغَبطَةٍ وَأَمانِ",96,"ن",1,0],["وَتَعالَ العَويلُ حَولَكِ مِمَّن","مارَسوهُ وَأَصبَحوا يُحسِنونَه",97,"ن",2,0],["وَتَعتَعَ الشادي بِأَلحانِهِ","وَماجَتِ الدارُ بِمَن فيها",98,"ي",3,0],["وَتَعلَمُ نَفسي أَنَّهُ غَيرُ عالِمٍ","وَلَكِنَّني أَستَدفِعُ اليَأسَ راجِيا",99,"ي",2,0],["وَتَعلَمُ أَنّي في زَمانِيَ واحِدٌ","وَأَنَّ كَلامي آخِرٌ مُتَقَدِّمُ",100,"م",1,0],["وَتَعالَ اِسمَع حَديثاً","هُوَ مايَغلو بِسَفرَه",101,"ر",2,0],["وتعيشُ في كونٍ من","الغَفَلاتِ فتَّانٍ سَعيدْ",102,"د",1,0],["وتَعاليمَ ودِينٍ ورؤًى","وأَحاسيسَ وصَمْتٍ ونشيدْ",103,"د",1,0],["وتعسُّف المَومَاةِ تعزِفُ جِنُّها","بعدَ الهُدوءِ بِعرمسٍ مِرقَالِ",104,"ل",1,0],["وتعترى رجفة مني الفؤاد لدى","سماع صوت له كالرعد هدار",105,"ر",1,0],["وتعاتب الاقدار لو","يسمعن من احد عتابا",106,"ب",2,0],["وتعانقنا ساعة وبكينا","في تشاك يهز منا العروقا",107,"ق",2,0],["وتعود هذي الار","ض بعد خرابها كالاول",108,"ل",1,0],["وتعالي نجدد العهد فيما","بيننا فهو كالربيع المذهب",109,"ب",1,0],["وتعبِق في أنوف الحج ركنا","وتحت جباههم رَحَبا وساحا",110,"ح",2,0],["وتعاهدتك أشعة في شمها","ينفذن عافيةً إلى الأبراد",111,"د",1,0],["وتعطر بخَلِيلىِّ الشذى","وتمتع من خليلىّ الحلى",112,"ل",2,0],["وتعلموه وعلموه","صغاركم ضمن الشعائر",113,"ر",1,0],["وتعلم أن بالحساد داء","وأن شفاءهم في أن يقولوا",114,"ل",3,0],["وَتَعَوَّد أَن تُلاقى","حَسَنَ الثَوبِ نَظيفَه",115,"ف",2,0],["وَتَعَطَّلَت هالاتُها","مِنكُم وَكانَت حالِيَه",116,"ي",2,0],["وَتَعَشَّق وَتَعَفَّف وَاِتَّقِ","مادَرى اللَذَّةَ مَن لَم يَعشَقِ",117,"ق",1,0],["وَتُعجِبُهُ العَواطِفُ في كِتابٍ","وَفي دَمعِ المُشَخِّصِ ما أَجادا",118,"د",2,0],["وَتَعَزّي عَن عَوادي دَولَةٍ","لَم تَدُم في وَلَدٍ أَو في قَرين",119,"ن",1,0],["وَتَعَهَّدَت مِن أَربَعينَ نُفوسَهُم","تَغزو القُنوطَ وَتَغرِسُ التَأميلا",120,"ل",2,0],["وتعطَّلَتْ لغةُ الكلامِ وخاطبَتْ","عَيْنَيَّ فِي لُغَة الهَوى عيناكِ",121,"ك",1,0],["وَتَعَرَّوا إِلى البِلى فَكَساهُم","خُشنَةَ اللَحدِ وَالدُجى المَسدولا",122,"ل",2,0],["وَتَعرِضُ في المِهرَجانِ العَظيمِ","ضُحاها الخَوالي وَآصالَها",123,"ل",3,0],["وَتَعرِضُهُم مَوكِباً مَوكِباً","وَتَسأَلُ عَن عَلَمِ المَوكِبِ",124,"ب",1,0],["وَتُعانِقُ القَمَرَ السَنِيَّ عَزيزَةً","حَتّى إِذا وَدَّعتَ عانَقتَ الثَرى",125,"ر",2,0],["وَتَعَلَّلَت بِالشَرعِ قُلتُ كَذِبتِهِ","ما كانَ شَرعُ اللَهِ بِالجَزّارِ",126,"ر",1,0],["وَتَعُقّونَ بِلاداً لَم تَزَل","بَينَ إِشفاقٍ عَلَيكُم وَحَذَر",127,"ر",1,0],["وَتَعذِلُني فيكَ القَوافي وَهِمَّتي","كَأَنّي بِمَدحٍ قَبلَ مَدحِكَ مُذنِبُ",128,"ب",1,0],["وَتَعلو الَّذي زُحَلٌ تَحتَهُ","مُحالٌ لَعَمرُكَ ما تُسأَلُ",129,"ل",1,0],["وَتَعظُمُ في عَينِ الصَغيرِ صِغارُها","وَتَصغُرُ في عَينِ العَظيمِ العَظائِمُ",130,"م",1,0],["وَتَعَذُّرُ الأَحرارِ صَيَّرَ ظَهرَها","إِلّا إِلَيكَ عَلَيَّ فَرجَ حَرامِ",131,"م",1,0],["وَتُعجِبُني رِجلاكَ في النَعلِ إِنَّني","رَأَيتُكَ ذا نَعلٍ إِذا كُنتَ حافِيا",132,"ي",2,0],["وتعطِفُ لي زماناً قد تولَّى","ولوَّى عِطْفَهُ ليَّ الزِّمامِ",133,"م",1,0],["وتعقِدُ نعمةً غرَّاءَ عندي","يعِزُّ بها على الدهرِ انتقامي",133,"م",2,0],["وتُعجبُنِي المواعدُ كاذباتٍ","لتردادي إليه على المِطالِ",134,"ل",1,0],["وتعتذرُ الأيامُ بعدَ اساءةٍ","فَيُصْحَبُ أبَّاءٌ ويُصْلَحُ فاسدُ",135,"د",1,0],["وتعنو له صِيْدُ الممالكِ خُضَّعاً","إِذا اصطفَّ حَوليهِ كهولٌ وشُرَّخُ",136,"خ",1,0],["وَتَعتَعتَ عَنهُ السَيفَ فَاِرتَدَّ نَصلُهُ","كَليلَ الشَذا عَنهُ حَرونَ المَضارِبِ",137,"ب",1,0],["وَتَعَجَّب مِن غَيرِ ما أَنا فيهِ","فَكَذا كانَ مُسلِمٌ وَحَبيبُ",138,"ب",1,0],["وَتَعَجَّبَت مِن لَوعَتي فَتَبَسَّمَت","عَن واضِحاتٍ لَو لُثِمنَ عِذابِ",139,"ب",1,0],["وَتَعَمَّدتُ أَن تَظَلَّ رِكابي","بَينَ لُبنانَ طُلَّعاً وَسَنيرِ",140,"ر",1,0],["وَتَعافَسوا مَن كانَ طاحَ سِلاحُهُ","وَالنَفسُ تَتلَفُ عِندَ كُلِّ عِفاسِ",141,"س",1,0],["وَتَعلَمُ أَعباءُ الخِلافَةِ أَنَّها","وَإِن ثَقُلَت مَوجودَةٌ في اِضطِلاعِهِ",142,"ع",2,0],["وَتَعلَمُ أَنَّ السَيفَ يَكفيكَ حَدُّهُ","مُكاثَرَةَ الأَقرانِ قَبلَ اِستِلالِهِ",143,"ل",2,0],["وَتَعذُلُهُم إِذا نيكوا كَأَن لَم","تَنُل مِن قَبلِهِم شِيَعُ العَذولِ",144,"ل",1,0],["وَتَعلَمُ جُردُ الخَيلِ أَن لَيسَ راكِبٌ","سِواهُ وَسُمرُ الخَطِّ أَن لَيسَ حامِلُ",145,"ل",1,0],["وَتُعطَفُ أَثناءُ السُرادِقِ حَولَهُ","عَلى قَمَرٍ تَنجابُ عَنهُ سُدولُها",146,"ل",3,0],["وَتَعِزُّ أَن تَلتاثَ يَومَ كَريهَةٍ","عَنها وَتَكرُمُ أَن تَكونَ شَتيما",147,"م",2,0],["وَتَعَلَّمي أَنَّ اعتِلاقي حَبلَكُم","ذُلّي وَأَنَّ هَوايَ فيكِ هَواني",148,"ي",1,0],["وَتَعتَدُّ نَفسِيَ مِن مالِها","وَما أَبعَدَت مالَ إِخوانِها",149,"ن",3,0],["وَتَعرِفِ بِالأَبطالِ وَقعَ سُيوفِهِم","وَآثارَها مِن مُندَباتٍ وَمِن خَدبِ",150,"ب",1,0],["وَتَعدِلُ دارِماً بِبَني كُلَيبٍ","وَتَعدِلُ بِالمُفَقّئَةِ السِبابا",151,"ب",2,0],["وَتَعصِبُ أَمرَها بِكُمُ إِذا ما","شَرارُ الحَربِ هُيِّجَ فَاِستَطارا",152,"ر",2,0],["وَتَعلو بُحورَ العالَمينَ بُحورُهُم","بِفِعلٍ عَلى فِعلِ البَرِيَّةِ ضاعِفِ",153,"ف",1,0],["وَتُعطي العُرفَ عَفواً سائِليهِ","وَتُروي الزاعِبِيَّةَ في الطِعانِ",154,"ن",1,0],["وتعرضت تلك الظباء بذي الغضا","صورا وكن بذي الأراك حوائدا",155,"د",2,0],["وتعهَّدْ تلكَ الخِيامَ ففيها","ظَبَياتٌ يَفتُكْنَ بالصَّبِّ عَمْدا",156,"د",2,0],["وتَعجَبُ من ضَنِّ القريضِ وخُبْره","على وَشَلٍ لا رَيَّ فيه لصادي",157,"ي",1,0],["وتعرين أسفار الأعادي","تمائمه إذا ارتاعَ الحديدُ",158,"د",1,0],["وتعمَّدَتْه بِلَحظَةٍ لو أنَّها","سَهمٌ لَجازَ عن الشَّغافِ مُخضَّبا",159,"ب",2,0],["وَتَعلَمُ أَنّي في الحُروبِ إِذا اِلتَظى","بنِيرانِها اللَيثُ الهَموسُ المُرَجَّبُ",160,"ب",1,0],["وَتَعاهَدِ الإِخوانَ إِنَّهُمُ","زَينُ المَغيبِ وَزَينُ مَن شَهِدا",161,"د",2,0],["وَتَعَلَّقي بِمَعالِقِ ال","مَكروبِ ذي القَلبِ الحَزينِ",162,"ن",1,0],["وَتَعرِضُ كُلَّما أَبدَيتُ عُذراً","وَكَم ذَنبٍ مَحاهُ الإِعتِذارُ",163,"ر",1,0],["وَتَعلَمُ أَنَّ المالَ في الناسِ أَخذُهُ","خَفيفٌ وَلَكِنَّ الأَداءِ ثَقيلُ",164,"ل",1,0],["وَتَعَطَّرَت أَرضُ الكِفاحِ كَأَنَّما","فُتِقَت لَنا ريحُ الجِلادِ بِعَنبَرِ",165,"ر",1,0],["وَتَعُمُّ الأَنامَ مِنكَ هِباتٌ","توجِبُ الصَفحَ عَن ذُنوبِ الزَمانِ",166,"ن",1,0],["وَتُعرِبُ الرَقصَ مِن لَحنٍ فَتُلحِقُهُ","ما يَلحَقُ النَحوَ مِن حَذفٍ وَتَقديرِ",167,"ر",1,0],["وتعانقا خلف الغمام وأترعا","كأسيهما من نشوة وحنان",168,"ن",1,0],["وتعالي حدّثيني حدّثي","أنت مرآة شجوني وصَدَاهَا",169,"ا",3,0],["وتعبر المشجيات تترى","من كل ماضٍ بلا رجوع",170,"ع",1,0],["وتعجبُ منهم من فصاحة ألْسُنٍ","وما صَحِبوا في القفرِ غيرَ البهائمِ",171,"م",1,0],["وَتَعقِدُهُ حَتّى إِذا اِستَحصَدَت لَهُ","مَرائِرُهُ أَنشَأتَ بَعدُ تَحُلُّهُ",172,"ل",2,0],["وَتَعَلَّم بِأَنَّهُ ما لِأَنوا","ئِكَ إِن لَم تُرَوِّها مِن خَلاقِ",173,"ق",1,0],["وَتَعَرَّفَت عَرَفاتُ زاخِرَهُ وَلَم","يُخصَص كَداءٌ مِنهُ بِالإِكداءِ",174,"ا",2,0],["وتعيدَ ما عودتنا مِنْ نعمةٍ","عودتَنا منكَ الكثيرَ الطيِّبا",175,"ب",2,0],["وتُعَوِّضِي عن كلِّ ذلكَ","بالسجودِ وبالقيامِ",176,"م",1,0],["وَتَعَرَّضَت لي في المَسيرِ فَما","أَمسى الفُؤادُ يَرى لَها شَكلا",177,"ل",2,0],["وَتَعشو الضُيوفُ إِلى نارِهِ","فَتَلقى هُناكَ أَلا مَرحَبا",178,"ب",2,0],["وَتَعتَدَّهُ المُنتَقى المُتَّقى","عَلى الخَيرِ وَالحُوَّلِ القُلَّبا",178,"ب",2,0],["وَتُعَبُّ مِن رَجراجِ رِدفِكِ","مَوجَةٌ في شَطِّ خَصرِك",179,"ك",1,0],["وَتَعشو إِلى نارٍ بِهِم في مَفازَةٍ","ذَكاءُ قُلوبٍ في اِتِّساعِ صُدورِ",180,"ر",1,0],["وَتُعرِضُ لَيلى عَن كَلامي كَأَنَّني","قَتَلتُ لِلَيلى إِخوَةً وَمَوالِيا",181,"ي",2,0],["وَتَعذُبُ لي مِن غَيرِها فَأُعافُها","مَشارِبُ فيها مَقنَعٌ لَو أُريدُها",182,"ه",2,1],["وتعجَّبوا للأرضِ كيفَ يَسوسُها","طُغيانُ أربابٍ وجَهلُ عِبادِ",183,"د",1,0],["وتَعالَ نَقْضِ الحقَّ في ميعادهِ","إن الحياةَ قريبةُ الميعادِ",183,"د",1,0],["وَتَعصِفُ بِالأَهرامِ ثمَّتَ تَنتَحي","قَوارِعُها العُظمى فَتَذرو المُقَطَّما",184,"م",2,0],["وَتَعطِفُها السِياطُ عَلى رِجالٍ","بِمُطَّرَحِ الهَوانِ مُمَزَّقينا",185,"ن",2,0],["وَتَعزفُ تَدعو الجنَّ أَن يَكشفوا الأَذى","تُعالجُ مِن كَربٍ يَهول الأَناسيا",186,"ي",2,0],["وَتَعرِفُ مِنّي الريحُ زَفرَةَ عاشِقٍ","وَيَفهَمُ مِنّي البَرقُ نَظرَةَ مُشتاقِ",187,"ق",1,0],["وَتَعذُلُني أَبناءُ سَعدٍ عَلَيهِمُ","وَما قُلتُ إِلّا بِالَّذي عَلِمَت سَعدُ",188,"د",1,0],["وَتَعَجَّبتُ مِن مَعاشِرَ دَسّوا","لِيَ شَرّاً وَاللَهُ كافٍ عَلِيُّ",189,"ي",1,0],["وَتَعتادُهُ الآمالُ حَتّى تَحُطَّهُ","إِلى تُربَةٍ فيها لَهُنَّ فَرائِسُ",190,"س",1,0],["وَتَعانَقنا كَأَنّي","وَهوَ في عِقدٍ شَديدِ",191,"د",1,0],["وتَعَدَّوْا إلى النبيّ حدوداً","كان فيها عليهم العُدَوَاءُ",192,"ا",2,0],["وتعاطَوْا في أحمدٍ مُنْكَرَ القَوْ","لِ وَنُطقُ الأَراذِلِ العَوْراءُ",192,"ا",2,0],["وتَعَوَّضوا ثَمَنَ النُّفوس مِنَ الهدَى","فمِنَ الهُدَى ثَمَنُ النُّفَوسِ رَبِيحُ",193,"ح",1,0],["وتَعَوّذَ الشّيطانُ منكَ وكَيدُهُ","لمّا ذَعَرْتَ جزيرَةَ الشّيْطانِ",194,"ن",1,0],["وتَعرّضَتْ طُرَرُ السُّتورِ كأنّها","عذَباتُ أوشِحَةٍ يروقُ جُمانها",195,"ن",3,0],["وتُعيدُ روْضَتَهُ كأوّلِ عَهدِهَا","مُتَفَوِّفاً فيها النّباتُ تفوُّفا",196,"ف",2,0],["وتعنو له الساداتُ من كُلِّ مَعْشَرٍ","فلا سّيدٌ منه أغرُّ وأمنَعُ",197,"ع",1,0],["وتعرِفُ مني البِيدُ خِرْقاً كأنّمَا","تَوَغّلَ منْهُ بينَ أرجائِها سِمْع",198,"ع",1,0],["وتُعْقَدُ إكْليلاً على رأس مَلْكِهِ","وتُنْظَمُ فيه مثلَ ما نُظمَ العِقد",199,"د",1,0],["وتعلمُ نجوَى قلوبِ العِدَى","وسِرَّ الأحِبّةِ يوْمَ النّوَى",200,"ا",1,0],["وتَعانَقوا حتى رُدَيْنيّاتُهُم","عطْشَى وبِيضُهُمُ الرقاقُ رِواء",201,"ا",2,0],["وتعفيرِ وجهٍ بالتراب كأنني","رسولٌ أتى من عند أهل المقابرِ",202,"ر",1,0],["وَتَعبُدُ رَأساً تُصَلّي لَهُ","وَأَمّا الإِلَهُ فَلا تَعبُدُ",203,"د",1,0],["وَتَعودُ حينَ تَسُرُّنا","وَأَخو الفَعالِ عَلَيكَ عائِد",204,"د",1,0],["وَتَعرِفُ مِنهُ مِن شَمائِلِ ظالِمٍ","مَناقِبَ مِفضالٍ تَعودُ وَتَشعَبُ",205,"ب",1,0],["وَتُعينُ أَسبابَ الحَياةِ وَيَنتَهي","أَمَدٌ لَها فَتَخونُ مُنقَطَعاتُها",206,"ت",3,0],["وَتَعذِرُ نَفسَكَ عِندَ الحَنينِ","وَتَعذُلُ نَفسَكَ أَن حَنَّتا",207,"ت",2,0],["وَتَعقُدُ سَلوانَ الفَتى عَنكَ نَفسُهُ","بِأَذيالِ بَرقٍ أَو دَوائِبِ ريحِ",208,"ح",1,0],["وَتَعارَفَ القَومُ الَّذينَ عَرَفتُهُم","بِالمُنكِراتِ فَعُطِّلَ الإِنكارُ",209,"ر",1,0],["وَتَعَهَّدَ اِبنُ العَبدِ بُرقَةَ ثَهمِدٍ","فَمَضى وَشيكاً وَاِستَقَرَّ الأَبرَقُ",210,"ق",1,0],["وَتُعجِزُ دُنياكَ القَويَّ يَرومُها","وَيَطلُبُ أُخراهُ الضَعيفُ فَيودرِكُ",211,"ك",1,0],["وَتُعجِبُنا الدُنِّيا الهَلوكُ وَإِنَّها","لَأُمُّ رِجالٍ كُلُّهُم سُقِيَ الهُلكا",212,"ك",2,0],["وَتَعلَمُ أَنَّ ما لَم يُنضَ صَعبٌ","فَما تَخشى المَنِيَّةَ في الهُجومِ",213,"م",1,0],["وَتَعزِفُ جِنُّها وَاللَيلُ داجٍ","إِذا خَلَتِ الجَنادِبُ مِن تَغَنّي",214,"ي",1,0],["وتعطفتْ لعِبَ الصِّلالِ من الأسَى","فالزُّجُّ عند اللّهْذَم الرّعّافِ",215,"ف",1,0],["وتُعْذَلُ حينَ لم تُجْنَنْ سُرُوراً","وتُعْذَرُ حيثُ ليس لها جَنَانُ",216,"ن",1,0],["وَتَعَوَّذوا بِاللَهِ مِن أَقلامِهِ","إِنَّ السُيوفَ لَها مِنَ الحُسّادِ",217,"د",1,0],["وَتَعبُرُ يَعفُورَ الصَرِيمِ كِنَاسَهُ","وَتُخرِجُهُ طَوراً وَإِن كانَ مُظهِرا",218,"ر",2,0],["وَتُعْرِضُ عن هَائِمٍ","أَبَى عنكَ أنْ يُعرِضا",219,"ض",2,0],["وتَعتاضُ اليقينَ مِنَ التَّظَنِّي","ودارَ الحقِّ مِنْ دارِ الغرورِ",220,"ر",1,0],["وتعمَّقتُ في العقائد حتى","قيل هذا علامةٌ نحرير",221,"ر",1,0],["وَتَعود مخفوراً إِليَّ مشيعاً","فيُقرُّ هذي العين منك إِياب",222,"ب",1,0],["وتعدد الأزواج من إلى","الهوى لمن اقتدر",223,"ر",1,0],["وَتعصّبوا حَتّى رمو","ني بالمروق وَكفروا",224,"ر",3,0],["وَتَعلم أَنَّ المَوت حق وأنها","إذا لَم تَرِده فهو سوف يرودها",225,"د",3,0],["وَتعانقنا وَفي أحشائنا","لوعة نيرانها تستعر",226,"ر",1,0],["وَتَعود أيامي بها","وَتَعود هاتيك اللَيالي",227,"ي",1,0],["وتُعيش حيواناً بها","وتكون للانسان مهدا",228,"د",2,0],["وتعيد آباء كما","كانوا بها وتعيد وِلدا",228,"د",2,0],["وتعلوا الّذي زحلٌ تحته","محالٌ لعمرك ما تسأل",229,"ل",1,0],["وتعلو وتهبطُ مثل الشراع","ترامى الجنوبُ بهِ والشمالْ",230,"ل",1,0],["وتعدو كأنَّ يداً خلفها","تُعَذِّبُها بسياطٍ طوالْ",230,"ل",1,0],["وتعجبُ من حيرتي الكائناتُ","وتُشفِقُ منِّي نجومُ السّحرْ",231,"ر",1,0],["وتعصفُ بي شهْوَةٌ للجدال","فَتسكِتُني بمعَاذيرها",232,"ه",2,0],["وَتَعَقَّبَتْهُ تهزُّ قبضة ثائر","فإِذا الحديدُ بها صديعُ حطامِ",233,"م",1,0],["وتعانقتما وما كنتَ إلَّا","عونَ سعدٍ وإلفَهُ وخدينه",234,"ن",2,0],["وتعانقنا وأجهشنا بكاءَ","وانطلقنا في حديثٍ وشجونْ",235,"ن",1,0],["وَتَعاهَدوها مِثلَما","يَتَعاهَدُ النَبتَ السَحاب",236,"ب",1,0],["وتَعاقَبَتْكَ كتائبُ ابنِ مطرّفٍ","فَأَرَتْكَ في وَضَحِ الصَّباحِ نُجُوما",237,"م",2,0],["وتَعْرِضُ ذاتُ العَرشِ باسِطةً لها","إلى الغرْبِ في تَغْويرِها يَدَ أقْطَع",238,"ع",1,0],["وتعب الوصيُّ بالسفارة","وانتدب السّبطان للخفاره",239,"ه",1,0],["وَتُعَانُ المُحْصَنَاتُ الأَيَامَى","وَتُعَالُ العُفَاةُ وَالأَيْتَامُ",240,"م",1,0],["وَتَعَضُّهُ الفَاقَاتُ لاَ يَلْوِي بِهَا","عِزَّاً وَيَسْتُرُهَا بِسِتْرِ وَقَارِ",241,"ر",1,0],["وَتَعْصِمُهُمْ شَامِخَاتُ الجِبَا","لِ وَكُلُّ مَضِيقٍ بِهَا مُوصَدِ",242,"د",1,0],["وَتَعَطُّفُ الأَفْنَانِ شِبْهُ","تَقَصُّفٍ فِي أَضْلُعِ",243,"ع",1,0],["وَتَعَدَّدُوا صُوَراً مُجَزَّأَةً","عَنْ كَامِلٍ مُتَعَدِّدٍ فَرْدِ",244,"د",1,0],["وَتَعَلُّلٌ بِمُدَامَةٍ وتَعَذلٌ","لِمَلاَمَةٍ وَتَغَزُّلٌ بِغَزَالِ",245,"ل",1,0],["وَتُعَاقِبُ العُزْلَ الضِّعَافَ وَمَا جَنَوا","بِصَوَاعِقٍ لَيْسَتْ بَنَاتِ سَحَابِ",246,"ب",1,0],["وَتُعِد الأَهْرَامُ بَيْنَ يَدَيْه","نَهْضَةَ الْقُطْرِ أَيَّمَا إِعْدَاد",247,"د",1,0],["وَتَعتَدُّ ذَنباً أَن أَبوحَ بِحُبِّها","وَلَو قَتَلَتني لا أَعُدُّ لَها ذَنبا",248,"ب",2,0],["وَتَعرِفُ فيهِ مِن أَبيهِ شَمائِلاً","وَمِن خالِهِ أَو مِن يَزيدَ وَمِن حُجَر",249,"ر",1,0],["وَتَعَانَقَ الظلاَّنِ ظِلُّ","الطاقِ وَالْهَرَمِ الْمَشِيدِ",250,"د",1,0],["وتعالَيْ نعيشُ في جَنَّةِ الما","ضي إذا لم نجِدْ من العيشِ بُدّا",251,"د",2,0],["وتعلن عن نفسها بالسكو","ت، عالمةً أنه من ذهب",252,"ب",1,0],["وتعثَّر الحافي على وجه الثرى","فأقاله الفاروق من عثراته",253,"ت",2,0],["وتعلموا الأدبَ الرفيعَ؛ فإنه","لا خيرَ في نُطق بلا إِفصاح",254,"ح",1,0],["وتعيشُ أنتَ مع المَلائِك ناعمًا","في الخُلْد بَيْن أَرائكٍ وظِلالِ",255,"ل",1,0],["وتعاهدوا؛ فسألتُهمْ:","ما حدُّ من خَفَرَ الذِّمام؟",256,"م",1,0],["وتعلمُ أنَّ الهزيمة عارٌ","يلاحق في التُّرُب أجدادها",257,"د",3,0],["وتعرفُنا البيضُ عند اللقاءِ","كما تعرف الصُّفُرُ نقادها",257,"د",3,0],["وتعرف مصرُ لهُ أنَّهُ","إلى قِمَّة المجد قد قادها",257,"د",3,0],["وتعرف أنَّ جمالاً أذلَّ","عِداها، وأرغم حُسَّادها",257,"د",3,0],["وتعلم أنَّ عرش الحكم سُهْدٌ","وجهد، لا دلالٌ واختيال",258,"ل",1,0],["وتعبد من دون الإله حجارة","طغام رجال يجعلون له ندا",259,"د",2,0],["وتعلَّقت بهم الرجالِ بصورِهِ","فتخالُ في شُرفاتهِ يَعسوبا",260,"ب",2,0],["وتعامت فاستبعدتها عبيد اللّهو","باسم الهدى وباسم الشريعة",261,"ع",2,0],["وتعف الذئاب فيه، وينسى","جبروت السلاح، فيه المهاره",262,"ر",2,0],["وتعرى روض البيان من السجع","وجاس الخريف فى جنباته",263,"ت",2,0],["وتعزَّت حين أخلت طُنفا","لم تَصُنْه – أنها صانت فِناء",264,"ا",2,0],["وتَعَرَّتِ الأنظارُ عن مُستَشرِفٍ","بادي السَّنا ، عالٍ على الأنظار",265,"ر",1,0],["وتعطلتْ سُبُلُ المحامدِ والتقى","والمكرماتِ فما هناك سبيل",266,"ل",1,0],["وتَعَسَّر الابلالُ حتى تَنتَفى","منه الجذورُ ، وتُقطَعَ الأَجذام",267,"م",1,0],["وَتَعَطَّلَ الدستورُ عن أحكامه","من فَرطِ ما ألوَى به الحُكَام",267,"م",1,0],["وتُعرِبُ عنها بما لا تُبين","كأنَّك من كلِّ نفسٍ حشا",268,"ا",1,0],["وتعهَّد الكَفَنَ الخصيبَ بمثلهِ","وطنٌ سيَبْعَثُ كلَّ يومٍ خاضبا",269,"ب",2,0],["وتعلَّمَنْ أنَّ الزمانَ إذا انتحى","شُهُبَ السَّما كانت مداسَ خُيوله",270,"ل",2,0],["وتعالت أُمةٌ لم تنحرفْ","عن مدى الحقِّ ولا زاغَت ضَلالا",271,"ل",2,0],["وتعجَّبوا من مهبِط الوحي الذي","سمِعوا وليس سوى قرارةِ وادي",272,"د",2,0],["وَتَعْرِفُ فِيهِ مِنْ أبِيهِ شَمَائِلاً","ومن خاله ومن يزيدَ ومن حُجر",273,"ر",1,0],["وتَعْذُلُهُمْ إِذا بِيكُوا كَأَنْ لَمْ","تُنَكْ مَنْ قَبْلِهِم شِيَعُ العَذُولِ",274,"ل",1,0],["وتعطلّت جنّانها وقصورها","ولقد تكون بغبطة وأمان",275,"ن",1,0],["وتعلّم حبّ الطلّيعة منها","واترك القال للورى والقيلا",276,"ل",2,0],["وَتعرَى عَطِيّةَ ضَارِباً بِفِنَائِهِ","رِبْقَينِ بَينَ حَظَائِرِ الأغْنَامِ",277,"م",1,0],["وتُعْجِبُهُ فِي حُزْنِهِ وَسُرُورِهِ","وَتَصْطَادُهُ لُطْفاً بِفَخً غُرُورِهِ",278,"ه",1,0],["وتعلمُ أنّ لها عندنا","ذَخَائِرَ مِلْحُبِّ لا تَظْهَرُ",279,"ر",1,0]]}