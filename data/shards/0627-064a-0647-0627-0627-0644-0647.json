{"poems":[[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39540","الرمل"],[108,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[108,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[228,"إنزعوا مني قلبي","https://www.aldiwan.net/poem41878.html","مجزوء الرمل"],[295,"أيها الهاجر الذي سلب اللب","https://www.aldiwan.net/poem11703.html","الخفيف"],[333,"يا حبيبي ملأ الفجر لنا كاسا","https://www.aldiwan.net/poem54928.html","مجزوء الرمل"],[482,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[591,"أيها الهاجر حدث","https://www.aldiwan.net/poem17528.html","مجزوء الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47162","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77197","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45707","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126342","الرمل"],[4679,"من مجيري من سهام المقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142747",""],[5136,"أيها الهاجري فراقك صعب","https://www.poetsgate.com/ViewPoem.aspx?id=121756",""],[5409,"قل لمن عاش كما عا","https://www.poetsgate.com/ViewPoem.aspx?id=155319",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5596,"الخسارة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=206771",""],[5970,"أيها الثاوي الذي ليس يزار","https://www.poetsgate.com/ViewPoem.aspx?id=130675",""]],"verses":[["أَيُّها الهارِبُ إِنَّ العارَ في هَذا الفِرارِ","لا صَلاحٌ في الَّذي تَفعَلُ حَتّى لِلقِفارِ",0,"ر",1,0],["أيها الهاجرُ عزَّ الملتقى","وأذبتَ القلبَ صداً وامتناعا",1,"ع",2,0],["أيُّها الهاربون من تعبِ الأر","ضِ، استريحوا بجنَّة الرَّضوان",2,"ن",1,0],["أيها الهاتفُ السَّماويُّ أذِّن","في البهاليل من بني عدنانا",3,"ن",2,0],["أَيُّها الهائِمُ في هذي الفلاه","أَينَ تَنوي أَين",4,"ن",1,0],["أيها الهاجر الذي سلب اللبّ","وأودى بقلبيَ الخفّاق",5,"ق",1,1],["أيها الهاجر لا ذقت حنيني","وولوعي بلياليك الحسان",6,"ن",1,0],["أيُّها الهاجرونَ قد كان صبري","صارماً قبلَ هجركمْ لم يُفلاّ",7,"ل",2,0],["أَيُّهَا الهاجِرُ حَدّثْ","نِيَ مَا أَوْجَبَ هَجْرَكْ",8,"ك",1,1],["أيّها الهاجر وإن كنتَ أهلا","أين حِلم النّهى وصفحُ الكِرَام",9,"م",1,0],["أَيُّها الهاتِفُ المُرتّلُ ذَكِّر","فَعَسى مِنكَ يَنفَعُ التَذكيرُ",10,"ر",1,0],["أَيُّها الهادم سوراً","هَدمُهُ عَينُ الجُنون",11,"ن",1,1],["أَيُّها الهادئُ الوَقورُ أَما تُف","صِحُ عَمّا حَمَلتَ مِن أَعباءِ",12,"ا",2,0],["أيها الهادي غوى قلبي ولم","يسأل الرشد فعلمهُ السنَّنَ",13,"ن",1,1],["أيها الهائم وجداً عش خالياً","مثلما قد قيل أو فاحتملِ",14,"ل",1,0],["أيها الهاجري فراقك صعب","ليس يقوى بحمله إنسان",15,"ن",1,1],["أيها الهر اشكر الفو","ضى التي اعطتك شحمه",16,"م",2,0],["أيها الهابطون من قمةِ المجْ","دِ عليهم من الهوانِ غبارُ",17,"ر",1,1],["أيها الهابطون من قمةِ المج","دِ، وحاديكُمْ في الهوانِ العارُ",17,"ر",1,0],["أيها (الهاشميّ يا نجل سيفٍ)","كنت سيفاً هشمت كل جحود",18,"د",1,0],["أيها الهادئ والوحش غدا","جاره هل طبت من هذا الجوار",19,"ر",1,0]]}