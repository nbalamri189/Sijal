"],[4444,"وحاكمٍ زامل عباده","https://www.poetsgate.com/ViewPoem.aspx?id=85445",""],[5701,"يا سعد قم وانظر تجد ما نستحي","https://www.poetsgate.com/ViewPoem.aspx?id=164583",""],[5725,"لدن القوام","https://www.poetsgate.com/ViewPoem.aspx?id=208950",""],[5725,"يا نخلة البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=210802",""],[5732,"قلب صفق","https://www.poetsgate.com/ViewPoem.aspx?id=177942",""],[5739,"اكتبيني بقرطاس ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131226",""],[5747,"الجرح العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=61671",""],[4623,"إني بحبل الحب فيك مقيد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146853",""],[402,"يا غرباء الحمى سلاما","https://www.poetsgate.com/ViewPoem.aspx?id=36423",""],[402,"إلى أهلها تنعى النهى والعزائم","https://www.poetsgate.com/ViewPoem.aspx?id=36218",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5842,"سُرَّاق النسب/ محمد الرحمون","https://www.poetsgate.com/ViewPoem.aspx?id=117029",""],[5924,"فلذة كبدي أمسّها بيدي","https://www.poetsgate.com/ViewPoem.aspx?id=186932",""],[5948,"يا أيها السَائلُ عن قومِنا","https://www.poetsgate.com/ViewPoem.aspx?id=100612",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5956,"يا علاَّم الغيوب","https://www.poetsgate.com/ViewPoem.aspx?id=192543",""],[5956,"بكل جلاله يأتي إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=194012",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6019,"نبضاتٌ في حضرة الأمير (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=53829",""],[4442,"تطوي الذميل على الرسيم","https://www.poetsgate.com/ViewPoem.aspx?id=171227",""],[6093,"مثل ثيابي","https://www.poetsgate.com/ViewPoem.aspx?id=206924",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[6173,"مُقادًا بقلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86797&r=&rc=11",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""],[406,"خيمة الظلماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63653&r=&rc=83",""],[463,"جرتْ لها ببابلٍ يمينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60234&r=&rc=290",""],[463,"أمن خفوق البرق ترزمينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60256&r=&rc=312",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""],[5190,"الناس صنفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78332&r=&rc=45",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["لَو جُرِّعَ الماءَ لَاِستَطفَاهُ مَوقِعُهُ","مِنَ الحَشى مِن لَظىً فيهِ وَتَسعارِ",0,"ر",1,0],["لو جِئْتُ في حلْبَةِ العُرْبِ التي سبقَتْ","ما كُنْتُ في القوْمِ إلا حائِزَ السّبَقِ",1,"ق",1,0],["لَوْ جَنَى مَوْقِفُ النَّوَى حَينَ حَيٍّ","كَانَ يَوْمُ الْوَدَاعِ وَاللَّهِ حَيْنِي",2,"ن",2,0],["لِوِجهَةِ الريحِ مِنهُ جانِبٌ سَلِبٌ","وَجانِبٌ بِأَكُفِّ القَومِ مَضبورُ",3,"ر",1,0],["لِوَجْهِ مِصْرٍ تَسْعَوْنَ سَعياً","إِلَى سَمَاءِ الفِدَى تَسَامَى",4,"م",2,0],["لِوَجْهِكَ رَسْمٌ خَالِدٌ فِي ضَمِيرِهَا","تَدُولُ بِهَا الدُّوَلاتُ وَالرَّسْمُ",5,"م",1,0],["لو جاورتْ آل ذبيانٍ حماهُ لما","ذمُّوا العواقبَ من حالاتِ غبراء",6,"ا",2,0],["لو جازَ أنْ تسلكَ أجفاننا","إذا فرَشنا كلّ جفن قريح",7,"ح",1,0],["لو جرى والرياحُ شأْواً لأَضحى","جريُها عند جريه كالدَّبيبِ",8,"ب",1,0],["لو جاءنا العود وأتباعه","وخيرُهن العنبر الأخضر",9,"ر",1,0],["لو جاء يحكي لونَ كل أبٍ لهُ","لرأيت جلدته كَيُمنة عَبْقر",10,"ر",1,0],["لو جُدْتُمُ بهما معاً فتواءَما","فَرَشا لكم عند الرِّحال بِساطا",11,"ط",2,0],["لو جاهدته ساعةً فلم تُنكْ","كانت كمن صام وصلَّى ونسكْ",12,"ك",1,0],["لو جئتهنَّ إذا خَلَوْنَ لغيَّةٍ","لسمعتَ أجراساً هناك فنونا",13,"ن",2,0],["لو جهلتُمْ ما دون ان تجهلوا الحل","مَ لعارضتكم بحلم رزين",14,"ن",1,0],["لَوجدتَهم مرضى القلوبِ إذا خَلوا","ورأيتَهم مرضَى العيون إذا رنَوا",15,"ن",3,0],["لوجهك هذا ليته دام بازغاً","شعاعٌ يرد الطرف وهو كليل",16,"ل",1,0],["لو جلوا حسنك أو غنوا به","للبيد في الثمانين صبا",17,"ب",2,0],["لَو جادَتِ الدُنيا فَدَتكَ بِأَهلِها","أَو جاهَدَت كُتِبَت عَلَيكَ حَبيسا",18,"س",2,0],["لَو جَذَبَ الزَرّادُ مِن أَذيالي","مُخَيَّراً لي صَنعَتَي سِربالِ",19,"ل",1,0],["لَو جَلَّ خَلقٌ قَطُّ عَن أُكرومَةٍ","تُثنى جَلَلتَ عَنِ النَدى وَالباسِ",20,"س",1,0],["لَو جاوَدَ الغَيثُ المُثَجَّجُ كَفَّهُ","لَأَتَت بِأَطوَلَ مِن نَداهُ وَأَعرَضا",21,"ض",2,0],["لَو جُمِعَ الناسُ لِأُكرومَةٍ","وَلَم يَكُن في الجَمعِ لَم نَكتَفِ",22,"ف",1,0],["لَو جَفَت كَفَّكَ النَدى لَسَلَونا","مِنهُ عَن غائِبٍ بَطيءِ القُدومِ",23,"م",1,0],["لَو جَمَعوا مِنَ الخِلّانِ أَلفاً","فَقالوا أَعطِنا بِهُمُ أَبانا",24,"ن",2,1],["لو جازَ أن يَخفَى على اللهِ امرؤٌ","من خَلقِه خَفِيَ الذي يُخفيهِ",25,"ي",2,0],["لو جَمَدَتْ راحُنا غدَتْ ذَهباً","أو ذابَ تُفَّاحُنا اغتدى راحا",26,"ح",2,0],["لَو جَهِلنا فَنائَها وَقَعَ العُذ","رُ وَلَكِنَّ كُلَّنا عَلّامُ",27,"م",1,0],["لو جَرَت في خاطري أقصى المُنى","لتمنّيتُ خيالاً من خيالِك",28,"ك",1,0],["لَو جازَ سُلطانُ القُنوعِ وَحُكمُهُ","في الخَلقِ ما كانَ القَليلُ قَليلا",29,"ل",2,0],["لوجنةِ صيادِكم نسخةٌ","حريريَّةٌ ملحةٌ في المُلَحْ",30,"ح",1,1],["لَو جُمِّعَ الناسُ ثُمَّ اِختيرَ صَفوَتُهُم","شَخصاً مِنَ الناسِ لَم أَعدِل بِهِ أَحَدا",31,"د",2,0],["لَو جاءَهُ مُنتَقِدٌ لَما دَرى","أَلَهَبٌ مُتَّقِدٌ أَم ذَهَبُ",32,"ب",1,0],["لَو جِئتَهُ فَفَجَأتَهُ","لَأَقَلَّ جَفنَ المُستَفيقِ",33,"ق",1,0],["لو جَرَى الأمرُ عليهِ ما الْتَوَى","هَلْ لأهلِ الأرضِ من هادٍ سِوَى",34,"س",3,0],["لو جرى فرعونُ أو هامانُه","يتعاطى شأوَهم لم يَلْحَقِ",35,"ق",1,0],["لَو جاوَرَ الشَرَفُ المُلوكَ لَأَورَقَت","صُمُّ الصُخورِ وَضاءَتِ الظلماءُ",36,"ا",2,0],["لو جَزَى الله كافراً أجرَ ما أح","سنَ يَوماً لَخِلتُهُ مأجورا",37,"ر",2,0],["لَوْ جاءَني الرسَّامُ بالمشتهى","كفرتُ باللهِ وأشركتُهُ",38,"ت",2,0],["لو جرّب التعليم شوقي ساعة","لقضى الحياة شقاوة وخمولا",39,"ل",2,0],["لَوَجناءُ أَلقاها فَأنظُرُ قائِماً","إِلَيها وَلَو كانَت تَصُدُّ وَتَصدِفُ",40,"ف",1,0],["لو جحدنا جُحُودَكم لاستويْنَا","أوَ للحقِّ بالضَّلالِ استواءُ",41,"ا",2,0],["لو جرَّسُوهُ علسَّ مِنْ سَفَهٍ","لَقُلْتُ غَيْظاً عليه يِسْتاهِلْ",42,"ل",1,0],["لَو جَرى نائِلُهُ في حَجَر","قاحِلِ الصَفحَةِ لَاِبتَلَّ الحَجَر",43,"ر",1,0],["لَوَجَدتِ حُبَّكِ قاتِلي عَجَلاً","إِن لَم يُفَرِّج كاشِفُ الكَربِ",44,"ب",1,0],["لَو جاءَ مِن أَهلِ البِلى مُخبِرٌ","سَأَلتُ عَن قَومٍ وَأَرَّختُ",45,"ت",1,0],["لوجهكَ هذا الكونُ يا حسن كلُّهُ","وجوهٌ يفيضُ البشرُ من قَسَماتِها",46,"ت",3,1],["لو جُمعَتْ فِي نَسَقٍ بَارِعٍ","كَرِيمَةُ الأَحْجَارِ وَالدُّرِّ",47,"ر",1,0],["لَوْ جَاءَ ذِكْرُ فَضِيلَةٍ فِي غَادَةٍ","وَسِوَاكِ يَعْنِي خِلْتُهُ يَعْنِيكِ",48,"ك",1,0],["لو جاهلوا الناسَ بَزت جاهليّتَهم","أو سابَقوا الناسَ عن أحسابهم سَبَقُوا",49,"ق",3,0],["لَو جمعت حمير أَقوالها","لِحَرب فهرٍ كُنتَ أَقوى لَها",50,"ه",2,1],["لو جَرَّسُوهُ عليَّ مِنْ سَفَهٍ","لقلتُ غيظاً عليه يستاهلْ",51,"ل",1,0],["لو جازَ للحر السُجودُ تعبًّداً","لوُجدتُ عبداً للمعلِّم ساجدا",52,"د",2,0],["لو جنيف تحس بجرحي المر العطيب","كان ماتاخذك مني وتعطيني ضياع",53,"ع",1,0],["لَوْ جَلّ خَلْقٌ قَطّ عَنْ أُكْرُومَةٍ","تُنْثَى، جَلَلْتَ عن النّدى والبَاسِ",54,"س",1,0],["لوجهك الإجلالُ والإكرامُ","عن ذاك والتبجيلُ والإعظامُ",55,"م",1,0],["لو جائنا العود وأتباعه","وخيرُهن العنبر الأخضر",56,"ر",1,0],["لو جُلتَ حولَ الفلَك الدّوّار لم","يزددْ نَقيرا فوق ما اللهُ رزَقْ",57,"ق",1,0],["لو جئتكم مسترفداً منكمُ","أضعافَه جدتثم ولم تبخلوا",58,"ل",3,0],["لو جاوزت سحب السما يمينه","رأيت في وجه السحاب الغلبا",59,"ب",2,0],["لو جاد بالأموال فأحذر قربه","يوم النزال فإنه ذو فتك",60,"ك",1,0],["لو جدتَ لي بالوصل ثم بعثتَ لي","منك الخيال مُواصِلا لَكفانِي",61,"ن",2,0],["لو جرت سنة النفير إلى أه","ل الجنايات ما عداها النفير",62,"ر",1,0],["لو جاء ناظرُه ببابل لاعترت","هارُوتَ أو ماروتَ أُخذةُ سحرِهِ",63,"ر",2,0],["لو جادلوا حرب كسرى ملكه انتزعوا","ترغو السهام على رغم من الوتر",64,"ر",1,0],["لو جَلَّ عن قَدْرِ الْعِيانِ امرُؤٌ","لِلفضلِ ما نالك مِنّا العِيان",65,"ن",1,0],["لو جزاهم بفعلهم فلقد كا","ن عليهم جبال مكة يرس",66,"س",1,0],["لو جَمَعَ الرحمن شملي به","تَفَرَّقت عني صروف الزمان",67,"ن",1,0],["لو جد شعري رأيت فيه","كواكب الليل كيف تسري",68,"ر",2,0],["لوجنتِها ناري ومائي لجيدِها","وهذان للأملاكِ والملكات",69,"ت",1,0],["لو جئتُ والألمانُ أشرفَ أمةٍ","أُحصي مآثرهم لضاقَ المأثر",70,"ر",1,0],["لَوْ جُبِل الدّهْرُ عَلى حِلْمِهِ","لَم يَكُ مِنْه للنُفوسِ اكْتِساح",71,"ح",1,0],["لوجهه الحمد لا نحصي الثناءَ له","ولا نطيق له شكراً كما وجبا",72,"ب",2,0],["لَو جُسِّمَت أَخلاقُه","أَغنتكَ عن نور البُدورِ",73,"ر",1,0],["لِوجهكَ لا لعائدةٍ ترجّى","وَلا لإذاعةِ الذّكرِ الحميدِ",74,"د",1,0],["لِوُجودِكَ الجُزئِيِّ كُلِّياتُ أَجنا","سِ الجَواهِرِ أَصبَحَت أَعراضا",75,"ض",2,1],["لِوَجدِيَ جِنسٌ نَوعُهُ فَصلُ عَدَّتي","وَمِنهُ خُصوصي لَيسَ فيهِ عُمومُ",76,"م",1,1],["لَو جاءَنا بَعد خَير الخَلق ذو نبأٍ","لَأَنزَل اللَهُ في تِمداحه صحفا",77,"ف",2,0],["لَو جادَ بِالحُسنى لإِحيائي وَمَن","قَسماً بِطلعة وَجهِهِ الباهي الحَسَن",78,"ن",1,0],["لو جلا عن وجهِ أدْنَى عِلْمِه","لانْثَنى نَقْصُ بني الدَّهْرِ تماما",79,"م",2,0],["لَو جاءَنا المَهديّ لَم يُوجد لَنا","طَوق امرءِ إِلّا بِكَف غَريم",80,"م",1,0],["لو جَاءَه المُصطفى مُسْتَشْفِعاً","بأمينِ الله في دِرهمٍ ما كانَ يُعطيهِ",81,"ي",2,0],["لَو جَرى في المَنابِرِ الروحُ ظَلَّت","مِن سواكُم عيدانها تتبرّا",82,"ر",2,0],["لَو جادَهَنَّ غَداةَ رَمَن رواحاً","غَيث كَدَمعي ما أردن بَراحا",83,"ح",2,1],["لوجه الله ما أنْفَقْتَ لا ما","يراد به افتخارٌ واقتناء",84,"ا",2,0],["لو جفّ ماءُ النيل كان لأهلهِ","بوفاءِ نيل بنانك استغناءُ",85,"ا",2,0],["لو جاد منعا في ندى كفه","أحيى هشيما يابسا فيه لو",86,"و",1,0],["لو جَمعتْ كفّاه ما فرّقتا","في الجود ضاهى بالغنى قارونا",87,"ن",2,0],["لَوْ جدتُمُ لشكرتُ نزرَ عطائكم","ووهبتُ غَثَّ نوالكم لسمينهِ",88,"ن",2,0],["لو جُدتَ بالشباب في ثوابها","كان سواك الخاسرَ المغبونا",89,"ن",2,0],["لوجدَّ في أن يستقيل ساعةً","من الغرام بك ما استقالَه",90,"ل",2,0],["لو جُمع الرأيُ بجَمع لنا","لم نُزجِ من يَعملةٍ ناحلا",91,"ل",2,0],["لو جاء يُعطي خبراً عن جنةٍ","رائدُها راعيَها لصدَقا",92,"ق",2,0],["لو جادَ بالبحر المُحيطِ لَظَنَّهُ","منْ فرْطِ همَّتِه ثَميلةَ سحْبَل",93,"ل",1,0],["لوجه الضحى جنح العجاج براقع","به وبعين الشمس عثيره كحل",94,"ل",1,0],["لو جئتهُ بالعتب تُضمِرهُ له","لقرأتهُ من وجنتَيهِ مُبيَّنا",95,"ن",2,0],["لوجه سماء الدَّجن منها وجاهةٌ","لكفِّ عوادي المحل من ومضها كفُّ",96,"ف",1,0],["لوجوهها عند القلوب وجاهةٌ","فرواؤها يسبي عقول رواتها",97,"ت",3,0],["لوجهك وجهُ الأرض بعد قطوبهِ","طليقٌ وطرف العدل ليس بنائمِ",98,"م",1,0],["لو جاء حسَّان بإحسانه","يشكو أواماً ما سقوه بلال",99,"ل",1,0],["لِوَجدِكِ جِزءٌ في زَوايا قُلوبِهِمْ","لهُ مَوْكبٌ من عَسكَرِ العِشْقِ كُلِّيُّ",100,"ي",1,0],["لو جاءَ ذو جُبّةٍ يُنادي","قدْ جئتُ يا قومُ باقتراحِ",101,"ح",1,0],["لو جاد صيّبُه العِينَ المَها نَبتَتْ","جُلودها بالحرير المَحْضِ لا الوَبَرِ",102,"ر",1,0],["لو جاز أن يهب الحياة رأيته","لا راجعاً فيها ولا متأولا",103,"ل",2,0],["لوجهك تعنو أوجه الخلق هيبة","وتطرق منهم أعين وجفون",104,"ن",1,0],["لو جهدوا ما شَربوا من عَلٍ","إِلّا الّذي أسْأَرْتُ من فضلتِي",105,"ي",1,0],["لو جعل الخيار للجماعة","ما اتفقوا إلى قيام الساعة",106,"ه",1,0],["لو جاز للمفضول أن يولى","لكان بالأمر الوضيع أولى",106,"ل",2,0],["لَوْ جُدْت لي بالنَّفْس منك لقلتُ من","شَرَهِ المحبَّة إِنَّهُ لمُبَخلُ",107,"ل",1,0],["لوجُزتَ بين جوانِحي عرضاً","لرأَيتَها ورأَيتَ مَنْزِلها",108,"ل",3,0],["لَوَجَدتُموهُ حينَ يَغ","ضَبُ لا يُعَرِّجُ بِالمُضيعَه",109,"ع",2,0],["لَو جِئتَ في عَصرَ القَريضِ لَما عَلَت","يَوماً بِنابِغَةٍ لَها ذِبيانُ",110,"ن",1,0],["لَو جاءَ في العَصرِ القَديمِ لَمّا رَوى","إِلّا قَصائِدَهُ لِسانَ الأَصمَعي",111,"ع",2,0],["لَو جاءَ في الزَمَنِ المَاضي وَعاصِرُهُ","حَكيمُ كِندَةَ لَم يَزعُم بِما زَعَما",112,"م",2,0],["لو جاد بالمال أبو رهم","كجوده بالأختِ والأمِّ",113,"م",1,1],["لَو جاءَ سائِمُهُ يَستامُ مُهجَتُهُ","في غَيرِ مُهجَتِهِ ما خابَ سائِلُه",114,"ل",2,0],["لوجال جريالهُ في رأس مفترعٍ","طوداً لطار ومال الطودُ من طَرَبِ",115,"ب",1,0],["لَوَجْهُ الحبيب إذا ما الْتحَى","جمالُ الرياض اكتسى بالوَرَقْ",116,"ق",1,1],["لَو جادَ هانَ وَقيلَ الجودُ عادَتُهُ","وَإِنَّما عَزَّ لِما عَزَّ مَطلَبُهُ",117,"ه",1,0],["لو جاهدوا في الأرض عاماً سادساً","لاستبدلوا غير الأنام أناما",118,"م",2,0],["لوَجْهِكَ من لؤمِهِ قابضٌ","من البِشرِ ليس له باسط",119,"ط",1,0],["لو جاءَهُ سَحْبان يُظهرُ نَظمَهُ","لرأيتَ سَهلَ النّظمِ منهُ معقَّدا",120,"د",2,0],["لَوْ جازَ أَنْ يَعْبُدَ العِبادُ سِوَى الْ","خالِقِ كُنَّا لِلْبِرِّ نَعْبُدُهُ",121,"د",2,0],["لو جبُروا ما هاض من خاطري","بنظرة منهم فهل من جناحْ",122,"ح",1,0],["لَو جبالُ الطورِ يوماً نالَها","بَطشهُ زَعزَعها واِقتَلَعا",123,"ع",2,0],["لَو جدُّه نبهانُ عاينَ مجده","يوماً لطال بمجده نبهانهُ",124,"ن",2,0],["لو جاد لي فوق اللثام بقبلة","تشفي فؤاد الصَّب من أوصابه",125,"ب",2,0],["لوجود قيد ليس يمكن حله","وثنى عنان العزم حالاً وانحدر",126,"ر",1,0],["لو جمَدَتْ في دنّها لحظة","خرَطْتُ من جامدها فَصّي",127,"ص",2,0],["لَو جحدت أَيامه الأَقرانُ","أنبت بِها الذؤبان وَالعقبان",128,"ن",1,0],["لو جاز لي بالعمر إن أفديكما","لبذلته لأطيل في عمريكما",129,"م",2,0],["لَو جُرَّ شَنُّ وَسَطها لَم تَحفُلِ","مِن شَهوَةِ الماءِ وَرَزٍّ مُعضَلِ",130,"ل",1,0],["لو جذب الدهر بأدنى عزمة","دك كبيت العنكبوت ووهى",131,"ا",1,0],["لوجهه تعنو الوجوه بالوله","بأيد لا إله إلا اللّه",132,"ه",1,0],["لوجهك يا قدوس كل قداسة","بلا شرط تقييد ولا حصر نسبة",133,"ه",1,0],["لو جاز لم يك بالمحال معلقاً","كلا ولا صعقت يهود بمرجفه",134,"ف",2,0],["لوجهه لأجل ما سواه","بحقّ لا إله إلا اللّه",135,"ه",1,0],["لوجوبه وجبت احاطة علمه","والشيء واللاشي جف به القلم",136,"م",1,0],["لو جاور الفَطِنُ التحرير حارَ له","أو لاحَ للصِّخر خلاه لَخَلاَّهُ",137,"ا",2,0],["لو جادَ فِكرُ ابنِ الحُسَينِ بِمِثِلهَا","صَحَّت نُبُوَّتُهُ لدَى الشُّعَرَاءِ",138,"ا",2,0],["لو جاد مَن أهوى برشف رُضابِهِ","لشفى الفؤادَ ببردِهِ ممَّا بهِ",139,"ب",2,1],["لوجهك قد صلى بها المدح والثنا","لأنك فيها قبلةُ الشكر والحمد",140,"د",1,0],["لو جفا غادرتهُ","في سما الأنس لدينا",141,"ن",2,0],["لوجده بالصمد القديم","قد طرح الدنيا على الخصوم",142,"م",1,0],["لو جاء داوود والنعمى تضاحكنا","لهنأ الشام في المزمار داود",143,"د",1,0],["لوجهتك ابن العسكري توجهت","هداياي يذكو عرفها في القراطس",144,"س",1,0],["لو جرت حين قال لولا علي","نفسه وفق قوله أنجاها",145,"ا",3,0],["لوجوه من فضله أنشأتها","وأولو الرشد كلهم قد وعاها",145,"ا",3,0],["لَو جازَ أَن يُعبَدَ في حسنه","وَطرفه كنت له أَعبد",146,"د",1,0],["لَو جدتَ لم أعتبك من بعدها","وَلا إلى الشّكوى فمي عادا",147,"د",2,0],["لَو جرى ما يُنيلُه لاحتَقَرنا","عَصرَ نُوحٍ وَالفَيضَ مِن طُوفانِه",148,"ن",2,0],["لو جاءَه ما جاءَه من مُمْكنٍ","للمُلْكِ يَلْبسُ حُلَّةَ الجبَّارِ",149,"ر",1,0],["لِوَجهٍ لَهُ فِى الخُلدِ أَنتَ شَفِيعَهُ","وَأَنتَ الَّذِى ما ضَاعَ قَط وَقِيعُهُ",150,"ه",1,0],["لو جاء فخر الدين يشهد حاله","لبكى عليه وجدَّ في استنكاره",151,"ر",2,0],["لو جسمت لعيون الناس سيرته","هاموا بنور بحبل الشمس معقود",152,"د",1,0],["لوجهكَ أحسن الخلفاء وجهاً","وأسمحهم يدين ولا أحابي",153,"ي",1,0],["لو جرت الهُوج في مداه","حاق كَلاَلاً بها البوار",154,"ر",1,0],["لوجه ربي إنْ جاد الإله على","قلبي بمعرفةِ الأوزانِ والدرجِ",155,"ج",1,0],["لو جاء بالنصِّ لم يقبله ذو نظرِ","إلا بإيمانه لذاك يستره",156,"ر",2,0],["لو جاء من أسهم البلوى على حذرٍ","من المصابِ لجاءته بآلافِ",157,"ف",1,0],["لو جاد لي باللثم من خده","يوماً على الدنيا قرأتُ السلام",158,"م",1,0],["لَو جَنَّةُ الخُلدِ لي مِن وَجهِهِ بَدَلٌ","لا أَشتَريها بِما في القَلبِ مِن ضَرَمِ",159,"م",1,0],["لَو جامِعٌ رُسُلَ المَسيحِ إِلَيهِم","الإِنجيلُ ما ذادوهُمُ عَن فِريَةِ",160,"ه",1,0],["لو جمعوا شتاتَها وجدَّدوا","لها وِفاقاً أحكموا به العرا",161,"ا",1,0],["لو جبت من شط جيحون إلى عدن","فطفت من بعدها بغداد والبصره",162,"ر",2,0],["لَو جُزت بِالنعمان في قَصره","قابل خديك وَعاف الشَقيق",163,"ق",1,0],["لو جرى والجنوب في الجوِّ تسري","علَّم الرِّيح كيف قطع الأراضي",164,"ض",2,0],["لو جادت الزهراء بعض فعاله","لنفته حقاً لم يكن من آلها",165,"ل",3,0],["لوجٌ تحقره الخدور وانما","رباتها وقرنه تشريفا",166,"ف",2,0],["لو جزيناه بها كنَّا","جميعاً في فجارِ",167,"ر",1,0],["لوجه الحق قد وجهت قولي","فأشعاري صلاة أو دعاء",168,"ا",2,0],["لو جزت في درب صالح","عرفت درب حبيب",169,"ب",1,0],["لَو جازَ لاِنقطعوا إِلَيكَ وَصيّروا","