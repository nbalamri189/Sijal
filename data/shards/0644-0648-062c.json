{"poems":[[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[77,"بان يوم الخميس قرة عيني","https://www.aldiwan.net/poem36043.html","الخفيف"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[93,"يا غرباء الحمى سلاما","https://www.aldiwan.net/poem11291.html","مخلع البسيط"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[72,"أودت فعالك يا أسما بأحشائي","https://www.aldiwan.net/poem18168.html","البسيط"],[72,"عجبت من طرفي وخد المليح","https://www.aldiwan.net/poem18490.html","السريع"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[51,"ما إن يزال لهن ردف شائل","https://www.aldiwan.net/poem66492.html","الكامل"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[51,"أبلغ أباك إذا هلكت وقل له","https://www.aldiwan.net/poem66706.html","الكامل"],[89,"لكل طلوع يا ذكاء أفول","https://www.aldiwan.net/poem44942.html","الطويل"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[45,"ناهيك من حرق أبيت أقاسي","https://www.aldiwan.net/poem64589.html","الطويل"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[45,"لم تبلغ الحق ولم تنصف","https://www.aldiwan.net/poem65144.html","السريع"],[45,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[28,"لو جمعوا من الخلان ألفا","https://www.aldiwan.net/poem5634.html","الوافر"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[61,"لم ألق ريحانة ولا راحا","https://www.aldiwan.net/poem51740.html","المنسرح"],[49,"لعظيم من الأمور خلقنا","https://www.aldiwan.net/poem63105.html","الخفيف"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[69,"لوجنة صيادكم نسخة","https://www.aldiwan.net/poem28274.html","المتقارب"],[31,"ألمم بزينب إن البين قد أفدا","https://www.aldiwan.net/poem42567.html","البسيط"],[74,"لاعب تلك الريح ذاك اللهب","https://www.aldiwan.net/poem12840.html","الرجز"],[74,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[105,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[105,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[102,"برح بي الشوق فلما طغى","https://www.aldiwan.net/poem33000.html","السريع"],[102,"شوقي يقول وما درى بمصيبتي","https://www.aldiwan.net/poem33012.html","الكامل"],[40,"أسائل عن وجناء في السجن جارها","https://www.aldiwan.net/poem42282.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"يا أيها السيد الذي شهدت","https://www.aldiwan.net/poem18094.html","المنسرح"],[50,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[50,"أفد الرحيل وحثني صحبي","https://www.aldiwan.net/poem64845.html","الكامل"],[46,"بنت عن الدنيا ولا بنت لي","https://www.aldiwan.net/poem22160.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39538","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55106","الكامل"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/199525","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43742","السريع"],[67,"يا أيُّها السَّيِّدُ الذي شَهِدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=14574",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[45,"نَاهِيكَ مِنْ حُرَقٍ أبِيتُ أُقاسِي","https://www.poetsgate.com/ViewPoem.aspx?id=31155",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[51,"نِعال كِنْباية َ والعنبرُ","https://www.poetsgate.com/ViewPoem.aspx?id=29059",""]],"verses":[["لَو جُرِّعَ الماءَ لَاِستَطفَاهُ مَوقِعُهُ","مِنَ الحَشى مِن لَظىً فيهِ وَتَسعارِ",0,"ر",1,0],["لو جِئْتُ في حلْبَةِ العُرْبِ التي سبقَتْ","ما كُنْتُ في القوْمِ إلا حائِزَ السّبَقِ",1,"ق",1,0],["لَوْ جَنَى مَوْقِفُ النَّوَى حَينَ حَيٍّ","كَانَ يَوْمُ الْوَدَاعِ وَاللَّهِ حَيْنِي",2,"ي",1,0],["لِوِجهَةِ الريحِ مِنهُ جانِبٌ سَلِبٌ","وَجانِبٌ بِأَكُفِّ القَومِ مَضبورُ",3,"ر",1,0],["لِوَجْهِ مِصْرٍ تَسْعَوْنَ سَعياً","إِلَى سَمَاءِ الفِدَى تَسَامَى",4,"م",2,0],["لِوَجْهِكَ رَسْمٌ خَالِدٌ فِي ضَمِيرِهَا","تَدُولُ بِهَا الدُّوَلاتُ وَالرَّسْمُ",5,"م",1,0],["لو جاورتْ آل ذبيانٍ حماهُ لما","ذمُّوا العواقبَ من حالاتِ غبراء",6,"ا",2,0],["لو جازَ أنْ تسلكَ أجفاننا","إذا فرَشنا كلّ جفن قريح",7,"ح",1,0],["لو جرى والرياحُ شأْواً لأَضحى","جريُها عند جريه كالدَّبيبِ",8,"ب",1,0],["لو جاءنا العود وأتباعه","وخيرُهن العنبر الأخضر",9,"ر",1,0],["لو جاء يحكي لونَ كل أبٍ لهُ","لرأيت جلدته كَيُمنة عَبْقر",10,"ر",1,0],["لو جُدْتُمُ بهما معاً فتواءَما","فَرَشا لكم عند الرِّحال بِساطا",11,"ط",2,0],["لو جاهدته ساعةً فلم تُنكْ","كانت كمن صام وصلَّى ونسكْ",12,"ك",1,0],["لو جئتهنَّ إذا خَلَوْنَ لغيَّةٍ","لسمعتَ أجراساً هناك فنونا",13,"ن",2,0],["لو جهلتُمْ ما دون ان تجهلوا الحل","مَ لعارضتكم بحلم رزين",14,"ن",1,0],["لَوجدتَهم مرضى القلوبِ إذا خَلوا","ورأيتَهم مرضَى العيون إذا رنَوا",15,"ن",3,0],["لوجهك هذا ليته دام بازغاً","شعاعٌ يرد الطرف وهو كليل",16,"ل",1,0],["لو جلوا حسنك أو غنوا به","للبيد في الثمانين صبا",17,"ب",2,0],["لَو جادَتِ الدُنيا فَدَتكَ بِأَهلِها","أَو جاهَدَت كُتِبَت عَلَيكَ حَبيسا",18,"س",2,0],["لَو جَذَبَ الزَرّادُ مِن أَذيالي","مُخَيَّراً لي صَنعَتَي سِربالِ",19,"ل",1,0],["لَو جَلَّ خَلقٌ قَطُّ عَن أُكرومَةٍ","تُثنى جَلَلتَ عَنِ النَدى وَالباسِ",20,"س",1,0],["لَو جاوَدَ الغَيثُ المُثَجَّجُ كَفَّهُ","لَأَتَت بِأَطوَلَ مِن نَداهُ وَأَعرَضا",21,"ض",2,0],["لَو جُمِعَ الناسُ لِأُكرومَةٍ","وَلَم يَكُن في الجَمعِ لَم نَكتَفِ",22,"ف",1,0],["لَو جَفَت كَفَّكَ النَدى لَسَلَونا","مِنهُ عَن غائِبٍ بَطيءِ القُدومِ",23,"م",1,0],["لَو جَمَعوا مِنَ الخِلّانِ أَلفاً","فَقالوا أَعطِنا بِهُمُ أَبانا",24,"ن",2,1],["لو جازَ أن يَخفَى على اللهِ امرؤٌ","من خَلقِه خَفِيَ الذي يُخفيهِ",25,"ي",2,0],["لو جَمَدَتْ راحُنا غدَتْ ذَهباً","أو ذابَ تُفَّاحُنا اغتدى راحا",26,"ح",2,0],["لَو جَهِلنا فَنائَها وَقَعَ العُذ","رُ وَلَكِنَّ كُلَّنا عَلّامُ",27,"م",1,0],["لو جَرَت في خاطري أقصى المُنى","لتمنّيتُ خيالاً من خيالِك",28,"ك",1,0],["لَو جازَ سُلطانُ القُنوعِ وَحُكمُهُ","في الخَلقِ ما كانَ القَليلُ قَليلا",29,"ل",2,0],["لوجنةِ صيادِكم نسخةٌ","حريريَّةٌ ملحةٌ في المُلَحْ",30,"ح",1,1],["لَو جُمِّعَ الناسُ ثُمَّ اِختيرَ صَفوَتُهُم","شَخصاً مِنَ الناسِ لَم أَعدِل بِهِ أَحَدا",31,"د",2,0],["لَو جاءَهُ مُنتَقِدٌ لَما دَرى","أَلَهَبٌ مُتَّقِدٌ أَم ذَهَبُ",32,"ب",1,0],["لَو جِئتَهُ فَفَجَأتَهُ","لَأَقَلَّ جَفنَ المُستَفيقِ",33,"ق",1,0],["لو جَرَى الأمرُ عليهِ ما الْتَوَى","هَلْ لأهلِ الأرضِ من هادٍ سِوَى",34,"س",3,0],["لو جرى فرعونُ أو هامانُه","يتعاطى شأوَهم لم يَلْحَقِ",35,"ق",1,0],["لَو جاوَرَ الشَرَفُ المُلوكَ لَأَورَقَت","صُمُّ الصُخورِ وَضاءَتِ الظلماءُ",36,"ا",2,0],["لو جَزَى الله كافراً أجرَ ما أح","سنَ يَوماً لَخِلتُهُ مأجورا",37,"ر",2,0],["لَوْ جاءَني الرسَّامُ بالمشتهى","كفرتُ باللهِ وأشركتُهُ",38,"ت",2,0],["لو جرّب التعليم شوقي ساعة","لقضى الحياة شقاوة وخمولا",39,"ل",2,0],["لَوَجناءُ أَلقاها فَأنظُرُ قائِماً","إِلَيها وَلَو كانَت تَصُدُّ وَتَصدِفُ",40,"ف",1,0],["لو جحدنا جُحُودَكم لاستويْنَا","أوَ للحقِّ بالضَّلالِ استواءُ",41,"ا",2,0],["لو جرَّسُوهُ علسَّ مِنْ سَفَهٍ","لَقُلْتُ غَيْظاً عليه يِسْتاهِلْ",42,"ل",1,0],["لَو جَرى نائِلُهُ في حَجَر","قاحِلِ الصَفحَةِ لَاِبتَلَّ الحَجَر",43,"ر",1,0],["لَوَجَدتِ حُبَّكِ قاتِلي عَجَلاً","إِن لَم يُفَرِّج كاشِفُ الكَربِ",44,"ب",1,0],["لَو جاءَ مِن أَهلِ البِلى مُخبِرٌ","سَأَلتُ عَن قَومٍ وَأَرَّختُ",45,"ت",1,0],["لوجهكَ هذا الكونُ يا حسن كلُّهُ","وجوهٌ يفيضُ البشرُ من قَسَماتِها",46,"ت",3,1],["لو جُمعَتْ فِي نَسَقٍ بَارِعٍ","كَرِيمَةُ الأَحْجَارِ وَالدُّرِّ",47,"ر",1,0],["لَوْ جَاءَ ذِكْرُ فَضِيلَةٍ فِي غَادَةٍ","وَسِوَاكِ يَعْنِي خِلْتُهُ يَعْنِيكِ",48,"ك",1,0],["لو جاهلوا الناسَ بَزت جاهليّتَهم","أو سابَقوا الناسَ عن أحسابهم سَبَقُوا",49,"ق",3,0],["لَو جمعت حمير أَقوالها","لِحَرب فهرٍ كُنتَ أَقوى لَها",50,"ه",2,1],["لو جَرَّسُوهُ عليَّ مِنْ سَفَهٍ","لقلتُ غيظاً عليه يستاهلْ",51,"ل",1,0],["لو جازَ للحر السُجودُ تعبًّداً","لوُجدتُ عبداً للمعلِّم ساجدا",52,"د",2,0],["لَوْ جَلّ خَلْقٌ قَطّ عَنْ أُكْرُومَةٍ","تُنْثَى، جَلَلْتَ عن النّدى والبَاسِ",53,"س",1,0],["لوجهك الإجلالُ والإكرامُ","عن ذاك والتبجيلُ والإعظامُ",54,"م",1,0],["لو جائنا العود وأتباعه","وخيرُهن العنبر الأخضر",55,"ر",1,0]]}