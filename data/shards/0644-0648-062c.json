","مجزوء الكامل"],[305,"إلهي إن قصدي من قصيدي","https://www.aldiwan.net/poem56561.html","الوافر"],[349,"لوجودك الجزئي كليات أجنا","https://www.aldiwan.net/poem15750.html","الكامل"],[349,"لوجدي جنس نوعه فصل عدتي","https://www.aldiwan.net/poem15866.html","الطويل"],[353,"هيجت أشجان صب للربوع هفا","https://www.aldiwan.net/poem40141.html","البسيط"],[353,"يا لائمي بهوى الذي في ذاته","https://www.aldiwan.net/poem40557.html","الكامل"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[402,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[406,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[416,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[429,"بسم السرور فسرت الأحياء","https://www.aldiwan.net/poem40833.html","الكامل"],[429,"قوم لهم حسن الوفا شيمة","https://www.aldiwan.net/poem41416.html","السريع"],[458,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[458,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[458,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[458,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[458,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[458,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[461,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[464,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[464,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[464,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[464,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[464,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[464,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[500,"عليك سلام الله أفرطت يا مي","https://www.aldiwan.net/poem37725.html","الطويل"],[505,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[514,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[515,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[515,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[551,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أنت الأخير هوى وأنت الأول","https://www.aldiwan.net/poem2891.html","الكامل"],[575,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"]],"verses":[["لَو جُرِّعَ الماءَ لَاِستَطفَاهُ مَوقِعُهُ","مِنَ الحَشى مِن لَظىً فيهِ وَتَسعارِ",0,"ر",1,0],["لو جِئْتُ في حلْبَةِ العُرْبِ التي سبقَتْ","ما كُنْتُ في القوْمِ إلا حائِزَ السّبَقِ",1,"ق",1,0],["لَوْ جَنَى مَوْقِفُ النَّوَى حَينَ حَيٍّ","كَانَ يَوْمُ الْوَدَاعِ وَاللَّهِ حَيْنِي",2,"ي",1,0],["لِوِجهَةِ الريحِ مِنهُ جانِبٌ سَلِبٌ","وَجانِبٌ بِأَكُفِّ القَومِ مَضبورُ",3,"ر",1,0],["لِوَجْهِ مِصْرٍ تَسْعَوْنَ سَعياً","إِلَى سَمَاءِ الفِدَى تَسَامَى",4,"م",2,0],["لِوَجْهِكَ رَسْمٌ خَالِدٌ فِي ضَمِيرِهَا","تَدُولُ بِهَا الدُّوَلاتُ وَالرَّسْمُ",5,"م",1,0],["لو جاورتْ آل ذبيانٍ حماهُ لما","ذمُّوا العواقبَ من حالاتِ غبراء",6,"ا",2,0],["لو جازَ أنْ تسلكَ أجفاننا","إذا فرَشنا كلّ جفن قريح",7,"ح",1,0],["لو جرى والرياحُ شأْواً لأَضحى","جريُها عند جريه كالدَّبيبِ",8,"ب",1,0],["لو جاءنا العود وأتباعه","وخيرُهن العنبر الأخضر",9,"ر",1,0],["لو جاء يحكي لونَ كل أبٍ لهُ","لرأيت جلدته كَيُمنة عَبْقر",10,"ر",1,0],["لو جُدْتُمُ بهما معاً فتواءَما","فَرَشا لكم عند الرِّحال بِساطا",11,"ط",2,0],["لو جاهدته ساعةً فلم تُنكْ","كانت كمن صام وصلَّى ونسكْ",12,"ك",1,0],["لو جئتهنَّ إذا خَلَوْنَ لغيَّةٍ","لسمعتَ أجراساً هناك فنونا",13,"ن",2,0],["لو جهلتُمْ ما دون ان تجهلوا الحل","مَ لعارضتكم بحلم رزين",14,"ن",1,0],["لَوجدتَهم مرضى القلوبِ إذا خَلوا","ورأيتَهم مرضَى العيون إذا رنَوا",15,"ن",3,0],["لوجهك هذا ليته دام بازغاً","شعاعٌ يرد الطرف وهو كليل",16,"ل",1,0],["لو جلوا حسنك أو غنوا به","للبيد في الثمانين صبا",17,"ب",2,0],["لَو جادَتِ الدُنيا فَدَتكَ بِأَهلِها","أَو جاهَدَت كُتِبَت عَلَيكَ حَبيسا",18,"س",2,0],["لَو جَذَبَ الزَرّادُ مِن أَذيالي","مُخَيَّراً لي صَنعَتَي سِربالِ",19,"ل",1,0],["لَو جَلَّ خَلقٌ قَطُّ عَن أُكرومَةٍ","تُثنى جَلَلتَ عَنِ النَدى وَالباسِ",20,"س",1,0],["لَو جاوَدَ الغَيثُ المُثَجَّجُ كَفَّهُ","لَأَتَت بِأَطوَلَ مِن نَداهُ وَأَعرَضا",21,"ض",2,0],["لَو جُمِعَ الناسُ لِأُكرومَةٍ","وَلَم يَكُن في الجَمعِ لَم نَكتَفِ",22,"ف",1,0],["لَو جَفَت كَفَّكَ النَدى لَسَلَونا","مِنهُ عَن غائِبٍ بَطيءِ القُدومِ",23,"م",1,0],["لَو جَمَعوا مِنَ الخِلّانِ أَلفاً","فَقالوا أَعطِنا بِهُمُ أَبانا",24,"ن",2,1],["لو جازَ أن يَخفَى على اللهِ امرؤٌ","من خَلقِه خَفِيَ الذي يُخفيهِ",25,"ي",2,0],["لو جَمَدَتْ راحُنا غدَتْ ذَهباً","أو ذابَ تُفَّاحُنا اغتدى راحا",26,"ح",2,0],["لَو جَهِلنا فَنائَها وَقَعَ العُذ","رُ وَلَكِنَّ كُلَّنا عَلّامُ",27,"م",1,0],["لو جَرَت في خاطري أقصى المُنى","لتمنّيتُ خيالاً من خيالِك",28,"ك",1,0],["لَو جازَ سُلطانُ القُنوعِ وَحُكمُهُ","في الخَلقِ ما كانَ القَليلُ قَليلا",29,"ل",2,0],["لوجنةِ صيادِكم نسخةٌ","حريريَّةٌ ملحةٌ في المُلَحْ",30,"ح",1,1],["لَو جُمِّعَ الناسُ ثُمَّ اِختيرَ صَفوَتُهُم","شَخصاً مِنَ الناسِ لَم أَعدِل بِهِ أَحَدا",31,"د",2,0],["لَو جاءَهُ مُنتَقِدٌ لَما دَرى","أَلَهَبٌ مُتَّقِدٌ أَم ذَهَبُ",32,"ب",1,0],["لَو جِئتَهُ فَفَجَأتَهُ","لَأَقَلَّ جَفنَ المُستَفيقِ",33,"ق",1,0],["لو جَرَى الأمرُ عليهِ ما الْتَوَى","هَلْ لأهلِ الأرضِ من هادٍ سِوَى",34,"س",3,0],["لو جرى فرعونُ أو هامانُه","يتعاطى شأوَهم لم يَلْحَقِ",35,"ق",1,0],["لَو جاوَرَ الشَرَفُ المُلوكَ لَأَورَقَت","صُمُّ الصُخورِ وَضاءَتِ الظلماءُ",36,"ا",2,0],["لو جَزَى الله كافراً أجرَ ما أح","سنَ يَوماً لَخِلتُهُ مأجورا",37,"ر",2,0],["لَوْ جاءَني الرسَّامُ بالمشتهى","كفرتُ باللهِ وأشركتُهُ",38,"ت",2,0],["لو جرّب التعليم شوقي ساعة","لقضى الحياة شقاوة وخمولا",39,"ل",2,0],["لَوَجناءُ أَلقاها فَأنظُرُ قائِماً","إِلَيها وَلَو كانَت تَصُدُّ وَتَصدِفُ",40,"ف",1,0],["لو جحدنا جُحُودَكم لاستويْنَا","أوَ للحقِّ بالضَّلالِ استواءُ",41,"ا",2,0],["لو جرَّسُوهُ علسَّ مِنْ سَفَهٍ","لَقُلْتُ غَيْظاً عليه يِسْتاهِلْ",42,"ل",1,0],["لَو جَرى نائِلُهُ في حَجَر","قاحِلِ الصَفحَةِ لَاِبتَلَّ الحَجَر",43,"ر",1,0],["لَوَجَدتِ حُبَّكِ قاتِلي عَجَلاً","إِن لَم يُفَرِّج كاشِفُ الكَربِ",44,"ب",1,0],["لَو جاءَ مِن أَهلِ البِلى مُخبِرٌ","سَأَلتُ عَن قَومٍ وَأَرَّختُ",45,"ت",1,0],["لوجهكَ هذا الكونُ يا حسن كلُّهُ","وجوهٌ يفيضُ البشرُ من قَسَماتِها",46,"ت",3,1],["لو جُمعَتْ فِي نَسَقٍ بَارِعٍ","كَرِيمَةُ الأَحْجَارِ وَالدُّرِّ",47,"ر",1,0],["لَوْ جَاءَ ذِكْرُ فَضِيلَةٍ فِي غَادَةٍ","وَسِوَاكِ يَعْنِي خِلْتُهُ يَعْنِيكِ",48,"ك",1,0],["لو جاهلوا الناسَ بَزت جاهليّتَهم","أو سابَقوا الناسَ عن أحسابهم سَبَقُوا",49,"ق",3,0],["لَو جمعت حمير أَقوالها","لِحَرب فهرٍ كُنتَ أَقوى لَها",50,"ه",2,1],["لو جَرَّسُوهُ عليَّ مِنْ سَفَهٍ","لقلتُ غيظاً عليه يستاهلْ",51,"ل",1,0],["لو جازَ للحر السُجودُ تعبًّداً","لوُجدتُ عبداً للمعلِّم ساجدا",52,"د",2,0],["لو جنيف تحس بجرحي المر العطيب","كان ماتاخذك مني وتعطيني ضياع",53,"ع",1,0],["لَوْ جَلّ خَلْقٌ قَطّ عَنْ أُكْرُومَةٍ","تُنْثَى، جَلَلْتَ عن النّدى والبَاسِ",54,"س",1,0],["لوجهك الإجلالُ والإكرامُ","عن ذاك والتبجيلُ والإعظامُ",55,"م",1,0],["لو جائنا العود وأتباعه","وخيرُهن العنبر الأخضر",56,"ر",1,0],["لو جُلتَ حولَ الفلَك الدّوّار لم","يزددْ نَقيرا فوق ما اللهُ رزَقْ",57,"ق",1,0],["لو جئتكم مسترفداً منكمُ","أضعافَه جدتثم ولم تبخلوا",58,"ل",3,0],["لو جاوزت سحب السما يمينه","رأيت في وجه السحاب الغلبا",59,"ب",2,0],["لو جاد بالأموال فأحذر قربه","يوم النزال فإنه ذو فتك",60,"ك",1,0],["لو جدتَ لي بالوصل ثم بعثتَ لي","منك الخيال مُواصِلا لَكفانِي",61,"ي",1,0],["لو جرت سنة النفير إلى أه","ل الجنايات ما عداها النفير",62,"ر",1,0],["لو جاء ناظرُه ببابل لاعترت","هارُوتَ أو ماروتَ أُخذةُ سحرِهِ",63,"ر",2,0],["لو جادلوا حرب كسرى ملكه انتزعوا","ترغو السهام على رغم من الوتر",64,"ر",1,0],["لو جَلَّ عن قَدْرِ الْعِيانِ امرُؤٌ","لِلفضلِ ما نالك مِنّا العِيان",65,"ن",1,0],["لو جزاهم بفعلهم فلقد كا","ن عليهم جبال مكة يرس",66,"س",1,0],["لو جَمَعَ الرحمن شملي به","تَفَرَّقت عني صروف الزمان",67,"ن",1,0],["لو جد شعري رأيت فيه","كواكب الليل كيف تسري",68,"ر",2,0],["لوجنتِها ناري ومائي لجيدِها","وهذان للأملاكِ والملكات",69,"ت",1,0],["لو جئتُ والألمانُ أشرفَ أمةٍ","أُحصي مآثرهم لضاقَ المأثر",70,"ر",1,0],["لَوْ جُبِل الدّهْرُ عَلى حِلْمِهِ","لَم يَكُ مِنْه للنُفوسِ اكْتِساح",71,"ح",1,0],["لوجهه الحمد لا نحصي الثناءَ له","ولا نطيق له شكراً كما وجبا",72,"ب",2,0],["لَو جُسِّمَت أَخلاقُه","أَغنتكَ عن نور البُدورِ",73,"ر",1,0],["لِوجهكَ لا لعائدةٍ ترجّى","وَلا لإذاعةِ الذّكرِ الحميدِ",74,"د",1,0],["لِوُجودِكَ الجُزئِيِّ كُلِّياتُ أَجنا","سِ الجَواهِرِ أَصبَحَت أَعراضا",75,"ض",2,1],["لِوَجدِيَ جِنسٌ نَوعُهُ فَصلُ عَدَّتي","وَمِنهُ خُصوصي لَيسَ فيهِ عُمومُ",76,"م",1,1],["لَو جاءَنا بَعد خَير الخَلق ذو نبأٍ","لَأَنزَل اللَهُ في تِمداحه صحفا",77,"ف",2,0],["لَو جادَ بِالحُسنى لإِحيائي وَمَن","قَسماً بِطلعة وَجهِهِ الباهي الحَسَن",78,"ن",1,0],["لو جلا عن وجهِ أدْنَى عِلْمِه","لانْثَنى نَقْصُ بني الدَّهْرِ تماما",79,"م",2,0],["لَو جاءَنا المَهديّ لَم يُوجد لَنا","طَوق امرءِ إِلّا بِكَف غَريم",80,"م",1,0],["لو جَاءَه المُصطفى مُسْتَشْفِعاً","بأمينِ الله في دِرهمٍ ما كانَ يُعطيهِ",81,"ي",2,0],["لَو جَرى في المَنابِرِ الروحُ ظَلَّت","مِن سواكُم عيدانها تتبرّا",82,"ر",2,0],["لَو جادَهَنَّ غَداةَ رَمَن رواحاً","غَيث كَدَمعي ما أردن بَراحا",83,"ح",2,1],["لوجه الله ما أنْفَقْتَ لا ما","يراد به افتخارٌ واقتناء",84,"ا",2,0],["لو جفّ ماءُ النيل كان لأهلهِ","بوفاءِ نيل بنانك استغناءُ",85,"ا",2,0],["لو جاد منعا في ندى كفه","أحيى هشيما يابسا فيه لو",86,"و",1,0],["لو جَمعتْ كفّاه ما فرّقتا","في الجود ضاهى بالغنى قارونا",87,"ن",2,0],["لَوْ جدتُمُ لشكرتُ نزرَ عطائكم","ووهبتُ غَثَّ نوالكم لسمينهِ",88,"ن",2,0],["لو جُدتَ بالشباب في ثوابها","كان سواك الخاسرَ المغبونا",89,"ن",2,0],["لوجدَّ في أن يستقيل ساعةً","من الغرام بك ما استقالَه",90,"ل",2,0],["لو جُمع الرأيُ بجَمع لنا","لم نُزجِ من يَعملةٍ ناحلا",91,"ل",2,0],["لو جاء يُعطي خبراً عن جنةٍ","رائدُها راعيَها لصدَقا",92,"ق",2,0],["لو جادَ بالبحر المُحيطِ لَظَنَّهُ","منْ فرْطِ همَّتِه ثَميلةَ سحْبَل",93,"ل",1,0],["لوجه الضحى جنح العجاج براقع","به وبعين الشمس عثيره كحل",94,"ل",1,0],["لو جئتهُ بالعتب تُضمِرهُ له","لقرأتهُ من وجنتَيهِ مُبيَّنا",95,"ن",2,0],["لوجه سماء الدَّجن منها وجاهةٌ","لكفِّ عوادي المحل من ومضها كفُّ",96,"ف",1,0],["لوجوهها عند القلوب وجاهةٌ","فرواؤها يسبي عقول رواتها",97,"ت",3,0],["لوجهك وجهُ الأرض بعد قطوبهِ","طليقٌ وطرف العدل ليس بنائمِ",98,"م",1,0],["لو جاء حسَّان بإحسانه","يشكو أواماً ما سقوه بلال",99,"ل",1,0],["لِوَجدِكِ جِزءٌ في زَوايا قُلوبِهِمْ","لهُ مَوْكبٌ من عَسكَرِ العِشْقِ كُلِّيُّ",100,"ي",1,0],["لو جاءَ ذو جُبّةٍ يُنادي","قدْ جئتُ يا قومُ باقتراحِ",101,"ح",1,0],["لو جاد صيّبُه العِينَ المَها نَبتَتْ","جُلودها بالحرير المَحْضِ لا الوَبَرِ",102,"ر",1,0],["لو جاز أن يهب الحياة رأيته","لا راجعاً فيها ولا متأولا",103,"ل",2,0],["لوجهك تعنو أوجه الخلق هيبة","وتطرق منهم أعين وجفون",104,"ن",1,0],["لو جهدوا ما شَربوا من عَلٍ","إِلّا الّذي أسْأَرْتُ من فضلتِي",105,"ي",1,0],["لو جعل الخيار للجماعة","ما اتفقوا إلى قيام الساعة",106,"ه",1,0],["لو جاز للمفضول أن يولى","لكان بالأمر الوضيع أولى",106,"ل",2,0],["لَوْ جُدْت لي بالنَّفْس منك لقلتُ من","شَرَهِ المحبَّة إِنَّهُ لمُبَخلُ",107,"ل",1,0],["لوجُزتَ بين جوانِحي عرضاً","لرأَيتَها ورأَيتَ مَنْزِلها",108,"ل",3,0]]}