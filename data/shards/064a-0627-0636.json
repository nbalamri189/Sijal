العا يا أنت في سر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=197744",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[6093,"كُنْه الحُبِّ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=180644",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6125,"خذ كل شعري","https://www.poetsgate.com/ViewPoem.aspx?id=210911",""],[469,"لله ما شق من جيب الرياض بها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574849",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[463,"لو كانَ يرفقُ ظاعنٌ بمشيِّعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60141&r=&rc=197",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""],[6355,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66634&r=&rc=94",""],[572,"يا ضوءُ حُبُّكَ في اَحشاءَ قد قدّحَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9207&r=&rc=64",""]],"verses":[["يا ضارِبَ الهاماتِ وَهيَ نَوافِرٌ","تَشكو تَفَرُّقَها إِلى الأَبدانِ",0,"ن",1,0],["يا ضَيعَةَ الأَمَلِ الَّذي وَجَّهتُهُ","طَمَعاً إِلى الأَقوامِ بَل يا ضَيعَتي",1,"ت",2,0],["يا ضُلُوعي تَلَهَّبي في اكْتِئابِ","يا دُموعي تَأَهَّبي لِانْسِكابِ",2,"ب",1,1],["يا ضَرَّةَ الشَمسِ إِنَّ الحُبَّ أَبعَدَني","فَلَيتَ شِعري بِماذا مِنكِ أَقتَرِبُ",3,"ب",1,0],["يا ضارِبَ الفارِسِ يَومَ الوَغى","بِالسَيفِ في الحَومَةِ ذاتِ الأُوار",4,"ر",1,0],["يَا ضَرِيحاً أَوَى إِلَيْهِ حَبِيبٌ","تَحْتَ ضَوْءِ الذَّبِيحَةِ البَسَّامِ",5,"م",1,0],["يا ضَبُّ قَد فَرِغَت يَميني فَاِعلَموا","طُلُقاً وَما شَغَلَ القُيونُ شِمالي",6,"ل",2,0],["يا ضَبُّ عَلّي أَن تُصيبَ مَواسِمي","كوزاً عَلى حَنَقٍ وَرَهطَ بِلالِ",6,"ل",1,0],["يا ضَبُّ إِنّي قَد طَبَختُ مُجاشِعاً","طَبخاً يُزيلُ مَجامِعَ الأَوصالِ",6,"ل",1,0],["يا ضَبُّ لَولا حَينُكُم ما كُنتُمُ","عَرَضاً لِنَبلي حينَ جَدَّ نِضالي",6,"ل",2,0],["يا ضَبُّ إِنَّكُمُ البِكارُ وَإِنَّني","مُتَخَمِّطٌ قَطِمٌ يُخافُ صِيالي",6,"ل",2,0],["يا ضَبُّ غَيرُكُمُ الصَميمُ وَأَنتُمُ","تَبَعٌ إِذا عُدَّ الصَميمُ مَوالي",6,"ل",2,0],["يا ضَبُّ إِنَّكُم لَسَعدٍ حِشوَةٌ","مِثلُ البِكارِ ضَمَّمتَها الأَغفالِ",6,"ل",1,0],["يا ضَبُّ إِنَّ هَوى القُيونِ أَضَلَّكُم","كَضَلالِ شيعَةِ أَعوَرَ الدَجّالِ",6,"ل",1,0],["يا ضَمرَ يا عَبدَ بَني كِلابِ","يا أَيرَ كَلبٍ عَلِقٍ بِبابِ",7,"ب",1,1],["يا ضارِبَ الجَيشِ بي في وَسطِ مَفرِقِهِ","لَقَد ضَرَبتَ بِعَينِ الصارِمِ العَضَبِ",8,"ب",1,1],["يا ضلالي من بعد ذاك المحيّا","وافتقاري من بعد ذاك النوال",9,"ل",1,0],["يا ضُلَّ تَفْدِيةٍ هنا","لك تستديمُ بها هِبابهْ",10,"ب",2,0],["يا ضَيفَهُ أبشرْ فإنك غانمٌ","أجر الصيام وليس بالمكتوبِ",11,"ب",1,0],["يا ضرطة يُخْلِقُ الزمانُ وما","تبرحُ إحدى الطَّرائف الجُدُدِ",12,"د",1,1],["يا ضارب المَثَلِ المزخرفِ مُطْرياً","للحقد لم تَقْدح بزَنْدٍ وارِي",13,"ر",2,1],["يا ضرطةً سبق البريدَ بريدُها","ركضاً وخلَّفَ شوطُها أشواطا",14,"ط",2,0],["يا ضعيفاً في رأسه ألفُ قرنٍ","عدداً كلُّها غليظٌ سميك",15,"ك",1,0],["يا ضدَّ عيسى جاء من لا أبٍ","وجئْتَنا أنت مِنَ العالمِ",16,"م",1,1],["يا ضَريحاً عَلى ضِفافِ الوادي","جادَ مِن أَجلِكَ الغَمامُ البِلادا",17,"ا",1,0],["يا ضَيفَنا وَالأُنسُ أَنتَ رَسولُهُ","وَبَشيرُه وَالفَنُّ أَنتَ أَميرُهُ",18,"ر",2,0],["يا ضَرَّةَ البَلجيكِ في أَحزانِها","تُبكيكَ حَتّى أُمَّةُ البَلجيكِ",19,"ك",1,0],["يا ضميرَ الوُجُود يا عالمَ الأَروا","حِ يا أَيُّها الفضاءُ السَّاهي",20,"ي",1,0],["يا ضَبابَ الأَسى","يا فِجاجَ الجحيمْ",21,"م",1,0],["يا ضَيغَماً يَقتُلُ الأَبطال مُفتَرِساً","لا توهنَنّي فَإِنّي الناب وَالظُفرُ",22,"ر",1,0],["يا ضائع الميراث","والصبية الأحداث",23,"ث",1,0],["يا ضجة الطبول","على طريق الغول",23,"ل",1,0],["يا ضيعةَ الإِسلامِ بعدَكَ إِنَّه","غَرَضٌ لكلِّ مُبَدِّلٍ ومضَيِّعِ",24,"ع",1,0],["ياضَيعَةَ العِلمِ كَيفَ يُرزَقُهُ","ذو الخُرقِ مِنكُم وَالعُجبِ وَالصَلَفِ",25,"ف",1,0],["يا ضَيعَةَ الدُنيا وَضَيعَةَ أَهلِها","وَالمُسلِمينَ وَدَيعَةَ الإِسلامِ",26,"م",1,1],["يا ضَعيفَ الجُفونِ أَضعَفتَ قَلباً","كانَ قَبلَ الهَوى قَوِيّاً مَلِيّاً",27,"ي",2,1],["يا ضيف مصر أقم مقا","م الأهل وانزل في وطن",28,"ن",1,0],["يا ضفاف السلام","تحت عرش النور",29,"ر",1,0],["يا ضاحِكاً مِلءَ فيهِ جَهلاً","أَحسَنُ مِن ضَحكِكَ البُكاء",30,"ا",2,1],["يا ضارِباً يوسُفاً في حُسنِهِ مَثَلاً","جَلَّ اِبنُ أَفعَلَ عَن مِثلٍ وَعَن مَثَلِ",31,"ل",1,0],["يا ضُبَّ إِن تَكفُري أَيّامَ نِعمَتِنا","فَقَد كَفَرتِ أَيادي أَنعُمٍ تُلُدِ",32,"د",1,0],["يا ضارِبَ العَودِ البَطيءِ وَظَهرُهُ","لا وِزرَ يَحمِلُهُ كَوِزرِ الضارِبِ",33,"ب",1,0],["يا ضَيعةَ الشِّعْرِ في بُلْهٍ جَرامقَةٍ","تَشابَهتْ مِنهُمُ في اللُّؤمِ أَخلاقُ",34,"ق",1,0],["يا ضَريحاً فيه الرشيد يَنامُ","مطمئناً مني عليك سَلامُ",35,"م",1,1],["يا ضلّة الشاعر أين النجاهْ","وأين أينَ المنزلُ الآمنُ",36,"ن",1,0],["يا ضِفافَ النيلِ باللّهِ ويا خُضرَ الروابي","هل رأيتنَّ على النهر فتىً غضَّ الإهابِ",37,"ب",1,0],["يا ضارِب البَدرِ أَقسَم","تُ لا وَطِئتَ بِساطي",38,"ي",1,1],["يا ضعفنا ، تبدو لهم سافراً","يا ضعفهم ، هيهات أن يدركوك",39,"ك",1,0],["يا ضريح الحبيب لم يبق لى","دمع فأسقى ثراك من هتانه",40,"ن",2,0],["يا ضَيعَةَ العِلْمِ، كَيفَ يُرْزَقُهُ","ذو الخَرْقِ فيكُمْ وَالعُجبِ وَالصَّلَفِ",41,"ف",1,0],["يا ضَيْعَةَ الدّنْيَا وَضَيْعَةَ أهْلِهَا،","وَالمُسْلِمِينَ، وَضَيْعَةَ الإسْلامِ",42,"م",1,1],["يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","لقدْ ضربتَ بنفسِ الصارمِ الغضبِ",43,"ب",1,1],["يا ضيعة النغم الأسمى ولوعته","إذا محى الخالق الفنّان ما كتبا",44,"ب",2,0],["يا ضائعا فى الأرض .. يا نغما","فى غابة الشربين مرميا",45,"ي",2,0],["يا ضَيغَماً يَقتُلُ الفُرسان مُفتَرِساً","لا توهِنَنّي فَإِنّي الناب وَالظُفْرُ",46,"ر",1,0],["يا ضاحك الثغر من لعابسه","بمثل سح الغمائم الهمر",47,"ر",1,0],["يا ضالة الوادى أَحُثّ مطيَّتى","أم عند ظبِيِك في الكناسِ مَقيلُ",48,"ل",1,0],["يا ضيغم الحرب الذي","صار الهزبر له طريده",49,"د",2,0],["يا ضيعتي بينهم تعصبوا","جماعة يا ضيعتي بينهم",50,"م",1,0],["يا ضائراُ نافعاُ إن ثارَ هائِجُهُ","أسالَ مهجةَ أقوامٍ على الأسَلِ",51,"ل",1,0],["يا ضَيعَةَ العُمرِ يا خُسرانَ صَفقَتِنا","يا شُؤمَ حاضِرِنا الأَشقى وَبادِينا",52,"ن",2,0],["يا ضريرا له فؤادٌ ضريرٌ","لست من شهر زور بل أنت زور",53,"ر",1,1],["يا ضفافَ الخليجِ أخمَدتَ","إحساسي وماذا تجني وراءَ خمولي",54,"ل",2,0],["يا ضِفافَ الخليجِ حطّمتَ آما","لي واثقلتَ كاهلَ المسؤولِ",54,"ل",1,0],["يا ضِفافَ الخليج شرّدتَ","أحلامي فدَع لي عواطفي ومُيولي",54,"ل",2,0],["يا ضياءَ الصبحِ تحتَ الغَبَشِ","أطِرازٌ فوق خَدَّيْكَ وشِيْش",55,"ش",1,1],["يا ضيعة الحب امسى المال يعرضهُ","عرض المذلة في وجه الاذلينا",56,"ن",2,0],["يا ضارباً بشبا السيفِ الذي ارتعدتْ","لهُ الممالكُ أطعم سيفكَ الجزرا",57,"ر",2,0],["يا ضلوعي ما برحَ","القلبُ فيكِ يضطربُ",58,"ب",1,0],["يا ضرطة الشيخ المبج","ل بين حسادٍ حضور",59,"ر",1,0],["يا ضجرة المحمور بال","غدوات من ماء الشعير",59,"ر",1,0],["يا ضجة الصخب المصد","ع ذي التنازع والشرور",59,"ر",1,0],["يا ضيعَةَ الأعرابِ والإسلامِ إن","غدَتِ الشآمُ طريدةً لمُطارِد",60,"د",1,0],["يا ضِياءَ الدينِ صَبراً كُلّ حَيٍّ","لِفَناءٍ غَيرَ رَبّي وَزَوالِ",61,"ل",1,0],["يا ضِياءَ الدينِ أَنتُم سادَةٌ","عِندَهُم مازالَ سِعرُ الشِعرِ غالي",61,"ل",2,0],["يا ضمانةً ضمنتْ","أن تطيل من كمدي",62,"د",2,0],["يا ضرةَ الشمس إن عيني","ما ظفرت في الورى بشبهك",63,"ك",1,1],["يا ضيعةَ الإنسانِ في استعلائه","وكأنما بالمجدِ أصبحَ زائلا",64,"ل",2,0],["يا ضيعةَ الدين إن أهلوه أذهلهُم","مجد الدنانير عن مجد الرسالات",65,"ت",1,1],["يا ضميري أكلّما قدّمَ الدهر نضاراً","دفَعتَه مهتاجا",66,"ج",2,0],["يا ضارباً في الفلاة","وسابحاً في الفضاء",67,"ا",2,0],["يَا ضَاحِكاً لِلمُنَى مِن مَبسِمٍ لَقَطَت","مِن لَفظِهِ الدُّرَّ واشتَارَت بِهِ الضّرَبا",68,"ب",2,0],["يا ضَعفَ مَن أَمسى الفَريسَةَ في الهَوى","وَغَدا الحَمامُ لَهُ هُنَالِكَ جارِحا",69,"ح",2,0],["يا ضَيعَةَ الآمالِ إِذ","عَلِقَت أَنامِلُها بِحَبلِه",70,"ل",2,0],["يا ضيْعَةَ الأمَّةِ الغرَّاءِ يَسْجُنُه","ذُلٌّ ، فتطرُقُ للأعداءِ إطْراقا",71,"ق",2,0],["يا ضَيْفَ كلِّ المسلمينَ إذ","ما جِئْتَ جاءَ الأنسُ والبِشْرُ",72,"ر",1,0],["يا ضيفَ كلِّ المسلمين، له","في كلِّ قلبٍ مؤمنٍ، قَدْرُ",72,"ر",1,0],["يا ضيفَ أفئدةٍ بك ابتهجَتْ","فتألَّق الإحساسُ والفِكْرُ",72,"ر",1,0],["يا ضيفَ قلبي، أنتَ في لغتي","سِرُّ البيانِ، وفي فمي ذِكرُ",72,"ر",1,0],["يا ضيفَ أفئدةٍ معلَّقةٍ","بالله، يُجْبَرُ عندها الكَسْرُ",72,"ر",1,0],["يا ضيفَ وجداني ومُؤْنِسَهُ","يا مَنْ بسِرّكَ يَحْسُنُ الجَهْرُ",72,"ر",1,0],["ياضِعَافَ الأرضِ لا ترضوا بظلْمٍ","من رجالٍ لبسوا فيكم قناعا",73,"ع",2,0],["يا ضاحكاً في جنة الفردوس قد","أبكيتَ مَن كانَتْ له عينان",74,"ن",1,0],["يا ضياء الدين هل من دعوة","تكشف الكرب إذا الكرب تناها",75,"ا",3,0],["يا ضياء الهدى بَعثْتَ بِدُرٍّ","ما رأينا نظيره في البحور",76,"ر",1,0],["يا ضياء الدين يا من مجده","من نضار المجد والعليا سُبِكْ",77,"ك",1,1],["يا ضامناً يُسْرَ النّدى","ببشْرِ وجهه النّدي",78,"د",2,0],["يا ضيفَ طيفٍ ما هَداهُ لمَضجَعي","إلا لهيبٌ في الحشى يتوقّدُ",79,"د",1,0],["يا ضربة الجو هل ائمنا وما","في قطرنا شافع ابر تقي",80,"ق",2,0],["يا ضياء الاكوان يا زينة للد","نيا بهذي القلوب في ذا الوطيس",81,"س",1,0],["يا ضلَّ تغرير الحريص بنفسه","وهوى المطامع ما أرقَّ وأخملا",82,"ل",2,0],["يا ضلَّتي ما قمتُ أطلبُ عندهم","رزقاً عَداك ويا سفاهةَ مَطمَعي",83,"ع",2,0],["يا ضلة للقوافي كيفما قنصت","من بعدهم حسرة أو أسوةً بهم",84,"م",1,0],["ياضرَّةَ القمرين في شرفيهما","من أي شيء فيكِ لم أتعجَّب",85,"ب",1,1],["يا ضاحكَ الومض والأنواءُ باكيةٌ","أشبهتّ لمياءَ إلاَّ الظَّام والشّنبا",86,"ب",2,0],["يا ضَوءَ روحي العراقيُّين..يا وَجَعي","وكبريائي .. ويا عَيني التي سَمَلُوا",87,"ل",3,0],["يا ضرَّةَ القمرِ التَّمامِ وَمنْ لها","وجهٌ أعادَ سناه اكلَفَ شاحبا",88,"ب",2,0],["يا ضرماً في الأنامِ متقداً","والجود والمجد والندى حطبه",89,"ب",2,0],["يا ضُلَّ ضُلَّ المنايا ما تَرَكنَ لنا","عِزّاً نَبُوءُ به ما هُدِّلَ الوَرَقُ",90,"ق",1,0],["يا ضَرَّةَ القَمَرين لِمْ ذوّقْتِنِي","ما لم يكن لولا هواكِ مذوقا",91,"ق",2,0],["يا ضيعةً للمرءِ تد","عوهُ إلى الهُلْكِ الدُّعاةُ",92,"ه",1,0],["يا ضَيفَ موسى أَخى خُزَيمَةَ صُم","أَو فَتَحامَ إِن كُنتَ لَم تَصُمِ",93,"م",1,1],["ي