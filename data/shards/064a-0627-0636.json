{"poems":[[53,"صبرا غريم الثأر من عدنان","https://www.aldiwan.net/poem29664.html","الرجز"],[53,"قد قلت للنفس الشعاع أضمها","https://www.aldiwan.net/poem30669.html","الكامل"],[63,"يا ضلوعي تلهبي في اكتئاب","https://www.aldiwan.net/poem45902.html","الخفيف"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[10,"يا عين جودي بالدموع الغزار","https://www.aldiwan.net/poem21090.html","السريع"],[93,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[4,"يا ضمر يا عبد بني كلاب","https://www.aldiwan.net/poem21216.html","الرجز"],[47,"يا ضارب الجيش بي في وسط مفرقه","https://www.aldiwan.net/poem25357.html","البسيط"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[51,"يا ضرطة يخلق الزمان وما","https://www.aldiwan.net/poem61890.html","المنسرح"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[51,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"يا ضد عيسى جاء من لا أب","https://www.aldiwan.net/poem66349.html","السريع"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[91,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[45,"يا ضيعة الدنيا وضيعة أهلها","https://www.aldiwan.net/poem65680.html","الكامل"],[66,"يا ضعيف الجفون أضعفت قلبا","https://www.aldiwan.net/poem40105.html","الخفيف"],[97,"نفدي النزيل ونكرمن","https://www.aldiwan.net/poem24742.html","مجزوء الكامل"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[74,"يا ضاحكا ملء فيه جهلا","https://www.aldiwan.net/poem12837.html","مجزوء البسيط"],[74,"صممت سمعا فما أصغي إلى العذل","https://www.aldiwan.net/poem13214.html","البسيط"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[46,"خبر الحياة شرورها وسرورها","https://www.aldiwan.net/poem22353.html","الكامل"],[76,"ساق ترنح يشدو فوقه ساق","https://www.aldiwan.net/poem39256.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85434","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43724","المجتث"],[100,"بنوك .. وديوك","https://www.poetsgate.com/ViewPoem.aspx?id=183585",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[45,"مَرّتْ على عَزْمِها، وَلمْ تَقِفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32845",""],[45,"يا ضَيْعَةَ الدّنْيَا وَضَيْعَةَ أهْلِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=32041",""],[47,"يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14738",""],[94,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=15628",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[78,"سَكِّن فُؤادكَ لا تَذهَب بِكَ الفِكَرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86482&r=&rc=27",""],[120,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[142,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[150,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[160,"منزلتي أحمد عظمها","https://www.aldiwan.net/poem58665.html","الرجز"],[166,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[169,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[186,"يا ضريرا له فؤاد ضرير","https://www.aldiwan.net/poem43811.html","الخفيف"],[197,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[198,"يا ضياء الصبح تحت الغبش","https://www.aldiwan.net/poem51934.html","الرمل"],[199,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[199,"يوم بهذي الليالي يشبه القمرا","https://www.aldiwan.net/poem45350.html","البسيط"],[199,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[256,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[270,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[282,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[298,"خلف الأسى كبدي","https://www.aldiwan.net/poem36805.html","عموديه"],[303,"يا ضرة الشمس إن عيني","https://www.aldiwan.net/poem58019.html","مخلع البسيط"],[320,"أديت واجبك المقدس كاملا","https://www.aldiwan.net/poem61624.html","الكامل"],[328,"يا ضيعة الدين إن أهلوه أذهلهم","https://www.aldiwan.net/poem55009.html","البسيط"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[342,"يا ليل اين حبيبي","https://www.aldiwan.net/poem55309.html","المجتث"],[357,"أعرى من المدح الطرف الذي ركبا","https://www.aldiwan.net/poem4179.html","البسيط"],[366,"لو كنت جاوبت الحمائم نائحا","https://www.aldiwan.net/poem16963.html","الكامل"],[366,"يا مطمعي لفظا بكله","https://www.aldiwan.net/poem17385.html","الكامل"],[400,"يا قبة المسجد الأقصى","https://www.aldiwan.net/poem6723.html","عموديه"],[400,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[400,"تونس الخضراء","https://www.aldiwan.net/poem10308.html","عموديه"],[402,"يا قبر جادك وابل الرضوان","https://www.aldiwan.net/poem46437.html","البسيط"],[403,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[403,"ما يصان الغرام بالتستير","https://www.aldiwan.net/poem33908.html","الخفيف"],[403,"يا ضياء الدين يا من مجده","https://www.aldiwan.net/poem34151.html","الرمل"],[432,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[432,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[443,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[443,"عجبا حللوا عذاب النفوس","https://www.aldiwan.net/poem56028.html","عموديه"],[458,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[464,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[464,"ياضرة القمرين في شرفيهما","https://www.aldiwan.net/poem3310.html","عموديه"],[464,"ما نال من وصلكم بعض الذي وجبا","https://www.aldiwan.net/poem3498.html","عموديه"],[465,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[477,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[495,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[537,"يا عين بكي أبا جبر ووالده","https://www.aldiwan.net/poem69413.html","البسيط"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[551,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[553,"يا ضيف موسى أخى خزيمة صم","https://www.aldiwan.net/poem68397.html","المنسرح"],[558,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[567,"لا تظنين في بكاء النؤى والطنب","https://www.aldiwan.net/poem69810.html","البسيط"],[575,"يا ذا الذي يطربه كلما","https://www.aldiwan.net/poem3016.html","السريع"],[586,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"]],"verses":[["يا ضارِبَ الهاماتِ وَهيَ نَوافِرٌ","تَشكو تَفَرُّقَها إِلى الأَبدانِ",0,"ن",1,0],["يا ضَيعَةَ الأَمَلِ الَّذي وَجَّهتُهُ","طَمَعاً إِلى الأَقوامِ بَل يا ضَيعَتي",1,"ي",1,0],["يا ضُلُوعي تَلَهَّبي في اكْتِئابِ","يا دُموعي تَأَهَّبي لِانْسِكابِ",2,"ب",1,1],["يا ضَرَّةَ الشَمسِ إِنَّ الحُبَّ أَبعَدَني","فَلَيتَ شِعري بِماذا مِنكِ أَقتَرِبُ",3,"ب",1,0],["يا ضارِبَ الفارِسِ يَومَ الوَغى","بِالسَيفِ في الحَومَةِ ذاتِ الأُوار",4,"ر",1,0],["يَا ضَرِيحاً أَوَى إِلَيْهِ حَبِيبٌ","تَحْتَ ضَوْءِ الذَّبِيحَةِ البَسَّامِ",5,"م",1,0],["يا ضَبُّ قَد فَرِغَت يَميني فَاِعلَموا","طُلُقاً وَما شَغَلَ القُيونُ شِمالي",6,"ي",1,0],["يا ضَبُّ عَلّي أَن تُصيبَ مَواسِمي","كوزاً عَلى حَنَقٍ وَرَهطَ بِلالِ",6,"ل",1,0],["يا ضَبُّ إِنّي قَد طَبَختُ مُجاشِعاً","طَبخاً يُزيلُ مَجامِعَ الأَوصالِ",6,"ل",1,0],["يا ضَبُّ لَولا حَينُكُم ما كُنتُمُ","عَرَضاً لِنَبلي حينَ جَدَّ نِضالي",6,"ي",1,0],["يا ضَبُّ إِنَّكُمُ البِكارُ وَإِنَّني","مُتَخَمِّطٌ قَطِمٌ يُخافُ صِيالي",6,"ي",1,0],["يا ضَبُّ غَيرُكُمُ الصَميمُ وَأَنتُمُ","تَبَعٌ إِذا عُدَّ الصَميمُ مَوالي",6,"ي",1,0],["يا ضَبُّ إِنَّكُم لَسَعدٍ حِشوَةٌ","مِثلُ البِكارِ ضَمَّمتَها الأَغفالِ",6,"ل",1,0],["يا ضَبُّ إِنَّ هَوى القُيونِ أَضَلَّكُم","كَضَلالِ شيعَةِ أَعوَرَ الدَجّالِ",6,"ل",1,0],["يا ضَمرَ يا عَبدَ بَني كِلابِ","يا أَيرَ كَلبٍ عَلِقٍ بِبابِ",7,"ب",1,1],["يا ضارِبَ الجَيشِ بي في وَسطِ مَفرِقِهِ","لَقَد ضَرَبتَ بِعَينِ الصارِمِ العَضَبِ",8,"ب",1,1],["يا ضلالي من بعد ذاك المحيّا","وافتقاري من بعد ذاك النوال",9,"ل",1,0],["يا ضُلَّ تَفْدِيةٍ هنا","لك تستديمُ بها هِبابهْ",10,"ب",2,0],["يا ضَيفَهُ أبشرْ فإنك غانمٌ","أجر الصيام وليس بالمكتوبِ",11,"ب",1,0],["يا ضرطة يُخْلِقُ الزمانُ وما","تبرحُ إحدى الطَّرائف الجُدُدِ",12,"د",1,1],["يا ضارب المَثَلِ المزخرفِ مُطْرياً","للحقد لم تَقْدح بزَنْدٍ وارِي",13,"ر",2,1],["يا ضرطةً سبق البريدَ بريدُها","ركضاً وخلَّفَ شوطُها أشواطا",14,"ط",2,0],["يا ضعيفاً في رأسه ألفُ قرنٍ","عدداً كلُّها غليظٌ سميك",15,"ك",1,0],["يا ضدَّ عيسى جاء من لا أبٍ","وجئْتَنا أنت مِنَ العالمِ",16,"م",1,1],["يا ضَريحاً عَلى ضِفافِ الوادي","جادَ مِن أَجلِكَ الغَمامُ البِلادا",17,"ا",1,0],["يا ضَيفَنا وَالأُنسُ أَنتَ رَسولُهُ","وَبَشيرُه وَالفَنُّ أَنتَ أَميرُهُ",18,"ر",2,0],["يا ضَرَّةَ البَلجيكِ في أَحزانِها","تُبكيكَ حَتّى أُمَّةُ البَلجيكِ",19,"ك",1,0],["يا ضميرَ الوُجُود يا عالمَ الأَروا","حِ يا أَيُّها الفضاءُ السَّاهي",20,"ي",1,0],["يا ضَبابَ الأَسى","يا فِجاجَ الجحيمْ",21,"م",1,0],["يا ضَيغَماً يَقتُلُ الأَبطال مُفتَرِساً","لا توهنَنّي فَإِنّي الناب وَالظُفرُ",22,"ر",1,0],["يا ضائع الميراث","والصبية الأحداث",23,"ث",1,0],["يا ضجة الطبول","على طريق الغول",23,"ل",1,0],["يا ضيعةَ الإِسلامِ بعدَكَ إِنَّه","غَرَضٌ لكلِّ مُبَدِّلٍ ومضَيِّعِ",24,"ع",1,0],["ياضَيعَةَ العِلمِ كَيفَ يُرزَقُهُ","ذو الخُرقِ مِنكُم وَالعُجبِ وَالصَلَفِ",25,"ف",1,0],["يا ضَيعَةَ الدُنيا وَضَيعَةَ أَهلِها","وَالمُسلِمينَ وَدَيعَةَ الإِسلامِ",26,"م",1,1],["يا ضَعيفَ الجُفونِ أَضعَفتَ قَلباً","كانَ قَبلَ الهَوى قَوِيّاً مَلِيّاً",27,"ي",2,1],["يا ضيف مصر أقم مقا","م الأهل وانزل في وطن",28,"ن",1,0],["يا ضفاف السلام","تحت عرش النور",29,"ر",1,0],["يا ضاحِكاً مِلءَ فيهِ جَهلاً","أَحسَنُ مِن ضَحكِكَ البُكاء",30,"ا",2,1],["يا ضارِباً يوسُفاً في حُسنِهِ مَثَلاً","جَلَّ اِبنُ أَفعَلَ عَن مِثلٍ وَعَن مَثَلِ",31,"ل",1,0],["يا ضُبَّ إِن تَكفُري أَيّامَ نِعمَتِنا","فَقَد كَفَرتِ أَيادي أَنعُمٍ تُلُدِ",32,"د",1,0],["يا ضارِبَ العَودِ البَطيءِ وَظَهرُهُ","لا وِزرَ يَحمِلُهُ كَوِزرِ الضارِبِ",33,"ب",1,0],["يا ضَيعةَ الشِّعْرِ في بُلْهٍ جَرامقَةٍ","تَشابَهتْ مِنهُمُ في اللُّؤمِ أَخلاقُ",34,"ق",1,0],["يا ضَريحاً فيه الرشيد يَنامُ","مطمئناً مني عليك سَلامُ",35,"م",1,1],["يا ضلّة الشاعر أين النجاهْ","وأين أينَ المنزلُ الآمنُ",36,"ن",1,0],["يا ضِفافَ النيلِ باللّهِ ويا خُضرَ الروابي","هل رأيتنَّ على النهر فتىً غضَّ الإهابِ",37,"ب",1,0],["يا ضارِب البَدرِ أَقسَم","تُ لا وَطِئتَ بِساطي",38,"ي",1,1],["يا ضعفنا ، تبدو لهم سافراً","يا ضعفهم ، هيهات أن يدركوك",39,"ك",1,0],["يا ضريح الحبيب لم يبق لى","دمع فأسقى ثراك من هتانه",40,"ن",2,0],["يا ضَيعَةَ العِلْمِ، كَيفَ يُرْزَقُهُ","ذو الخَرْقِ فيكُمْ وَالعُجبِ وَالصَّلَفِ",41,"ف",1,0],["يا ضَيْعَةَ الدّنْيَا وَضَيْعَةَ أهْلِهَا،","وَالمُسْلِمِينَ، وَضَيْعَةَ الإسْلامِ",42,"م",1,1],["يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","لقدْ ضربتَ بنفسِ الصارمِ الغضبِ",43,"ب",1,1],["يا ضيعة النغم الأسمى ولوعته","إذا محى الخالق الفنّان ما كتبا",44,"ب",2,0],["يا ضائعا فى الأرض .. يا نغما","فى غابة الشربين مرميا",45,"ي",2,0],["يا ضَيغَماً يَقتُلُ الفُرسان مُفتَرِساً","لا توهِنَنّي فَإِنّي الناب وَالظُفْرُ",46,"ر",1,0],["يا ضاحك الثغر من لعابسه","بمثل سح الغمائم الهمر",47,"ر",1,0],["يا ضالة الوادى أَحُثّ مطيَّتى","أم عند ظبِيِك في الكناسِ مَقيلُ",48,"ل",1,0],["يا ضيغم الحرب الذي","صار الهزبر له طريده",49,"د",2,0],["يا ضيعتي بينهم تعصبوا","جماعة يا ضيعتي بينهم",50,"م",1,0],["يا ضائراُ نافعاُ إن ثارَ هائِجُهُ","أسالَ مهجةَ أقوامٍ على الأسَلِ",51,"ل",1,0],["يا ضَيعَةَ العُمرِ يا خُسرانَ صَفقَتِنا","يا شُؤمَ حاضِرِنا الأَشقى وَبادِينا",52,"ن",2,0],["يا ضريرا له فؤادٌ ضريرٌ","لست من شهر زور بل أنت زور",53,"ر",1,1],["يا ضفافَ الخليجِ أخمَدتَ","إحساسي وماذا تجني وراءَ خمولي",54,"ل",2,0],["يا ضِفافَ الخليجِ حطّمتَ آما","لي واثقلتَ كاهلَ المسؤولِ",54,"ل",1,0],["يا ضِفافَ الخليج شرّدتَ","أحلامي فدَع لي عواطفي ومُيولي",54,"ل",2,0],["يا ضياءَ الصبحِ تحتَ الغَبَشِ","أطِرازٌ فوق خَدَّيْكَ وشِيْش",55,"ش",1,1],["يا ضيعة الحب امسى المال يعرضهُ","عرض المذلة في وجه الاذلينا",56,"ن",2,0],["يا ضارباً بشبا السيفِ الذي ارتعدتْ","لهُ الممالكُ أطعم سيفكَ الجزرا",57,"ر",2,0],["يا ضلوعي ما برحَ","القلبُ فيكِ يضطربُ",58,"ب",1,0],["يا ضرطة الشيخ المبج","ل بين حسادٍ حضور",59,"ر",1,0],["يا ضجرة المحمور بال","غدوات من ماء الشعير",59,"ر",1,0],["يا ضجة الصخب المصد","ع ذي التنازع والشرور",59,"ر",1,0],["يا ضيعَةَ الأعرابِ والإسلامِ إن","غدَتِ الشآمُ طريدةً لمُطارِد",60,"د",1,0],["يا ضِياءَ الدينِ صَبراً كُلّ حَيٍّ","لِفَناءٍ غَيرَ رَبّي وَزَوالِ",61,"ل",1,0],["يا ضِياءَ الدينِ أَنتُم سادَةٌ","عِندَهُم مازالَ سِعرُ الشِعرِ غالي",61,"ي",1,0],["يا ضمانةً ضمنتْ","أن تطيل من كمدي",62,"ي",1,0],["يا ضرةَ الشمس إن عيني","ما ظفرت في الورى بشبهك",63,"ك",1,1],["يا ضيعةَ الإنسانِ في استعلائه","وكأنما بالمجدِ أصبحَ زائلا",64,"ل",2,0],["يا ضيعةَ الدين إن أهلوه أذهلهُم","مجد الدنانير عن مجد الرسالات",65,"ت",1,1],["يا ضميري أكلّما قدّمَ الدهر نضاراً","دفَعتَه مهتاجا",66,"ج",2,0],["يا ضارباً في الفلاة","وسابحاً في الفضاء",67,"ا",2,0],["يَا ضَاحِكاً لِلمُنَى مِن مَبسِمٍ لَقَطَت","مِن لَفظِهِ الدُّرَّ واشتَارَت بِهِ الضّرَبا",68,"ب",2,0],["يا ضَعفَ مَن أَمسى الفَريسَةَ في الهَوى","وَغَدا الحَمامُ لَهُ هُنَالِكَ جارِحا",69,"ح",2,0],["يا ضَيعَةَ الآمالِ إِذ","عَلِقَت أَنامِلُها بِحَبلِه",70,"ل",2,0],["يا ضيْعَةَ الأمَّةِ الغرَّاءِ يَسْجُنُه","ذُلٌّ ، فتطرُقُ للأعداءِ إطْراقا",71,"ق",2,0],["يا ضَيْفَ كلِّ المسلمينَ إذ","ما جِئْتَ جاءَ الأنسُ والبِشْرُ",72,"ر",1,0],["يا ضيفَ كلِّ المسلمين، له","في كلِّ قلبٍ مؤمنٍ، قَدْرُ",72,"ر",1,0],["يا ضيفَ أفئدةٍ بك ابتهجَتْ","فتألَّق الإحساسُ والفِكْرُ",72,"ر",1,0],["يا ضيفَ قلبي، أنتَ في لغتي","سِرُّ البيانِ، وفي فمي ذِكرُ",72,"ر",1,0],["يا ضيفَ أفئدةٍ معلَّقةٍ","بالله، يُجْبَرُ عندها الكَسْرُ",72,"ر",1,0],["يا ضيفَ وجداني ومُؤْنِسَهُ","يا مَنْ بسِرّكَ يَحْسُنُ الجَهْرُ",72,"ر",1,0],["ياضِعَافَ الأرضِ لا ترضوا بظلْمٍ","من رجالٍ لبسوا فيكم قناعا",73,"ع",2,0],["يا ضاحكاً في جنة الفردوس قد","أبكيتَ مَن كانَتْ له عينان",74,"ن",1,0],["يا ضياء الدين هل من دعوة","تكشف الكرب إذا الكرب تناها",75,"ا",3,0],["يا ضياء الهدى بَعثْتَ بِدُرٍّ","ما رأينا نظيره في البحور",76,"ر",1,0],["يا ضياء الدين يا من مجده","من نضار المجد والعليا سُبِكْ",77,"ك",1,1],["يا ضامناً يُسْرَ النّدى","ببشْرِ وجهه النّدي",78,"د",2,0],["يا ضيفَ طيفٍ ما هَداهُ لمَضجَعي","إلا لهيبٌ في الحشى يتوقّدُ",79,"د",1,0],["يا ضربة الجو هل ائمنا وما","في قطرنا شافع ابر تقي",80,"ق",2,0],["يا ضياء الاكوان يا زينة للد","نيا بهذي القلوب في ذا الوطيس",81,"س",1,0],["يا ضلَّ تغرير الحريص بنفسه","وهوى المطامع ما أرقَّ وأخملا",82,"ل",2,0],["يا ضلَّتي ما قمتُ أطلبُ عندهم","رزقاً عَداك ويا سفاهةَ مَطمَعي",83,"ع",2,0],["يا ضلة للقوافي كيفما قنصت","من بعدهم حسرة أو أسوةً بهم",84,"م",1,0],["ياضرَّةَ القمرين في شرفيهما","من أي شيء فيكِ لم أتعجَّب",85,"ب",1,1],["يا ضاحكَ الومض والأنواءُ باكيةٌ","أشبهتّ لمياءَ إلاَّ الظَّام والشّنبا",86,"ب",2,0],["يا ضَوءَ روحي العراقيُّين..يا وَجَعي","وكبريائي .. ويا عَيني التي سَمَلُوا",87,"ل",3,0],["يا ضرَّةَ القمرِ التَّمامِ وَمنْ لها","وجهٌ أعادَ سناه اكلَفَ شاحبا",88,"ب",2,0],["يا ضرماً في الأنامِ متقداً","والجود والمجد والندى حطبه",89,"ب",2,0],["يا ضُلَّ ضُلَّ المنايا ما تَرَكنَ لنا","عِزّاً نَبُوءُ به ما هُدِّلَ الوَرَقُ",90,"ق",1,0],["يا ضَرَّةَ القَمَرين لِمْ ذوّقْتِنِي","ما لم يكن لولا هواكِ مذوقا",91,"ق",2,0],["يا ضيعةً للمرءِ تد","عوهُ إلى الهُلْكِ الدُّعاةُ",92,"ه",1,0],["يا ضَيفَ موسى أَخى خُزَيمَةَ صُم","أَو فَتَحامَ إِن كُنتَ لَم تَصُمِ",93,"م",1,1],["يا ضيا شمسي إذا طلعت","في الضحى مني وفي الطَفَل",94,"ل",1,0],["يا ضاحكاً حين أبكاني تبسَّمُهُ","حقٌّ من الحب تُبْكيني وتضحكُ بي",95,"ب",2,0],["يا ضُحْكَةً يَبْكي على نَفْسِهِ","ويا حدِيثاُ ذِكْرُهُ في القَدِيمْ",96,"م",1,0],["يَا ضَاحِكاً وَالحَيَاةُ عَابِسَةٌ","وَثَابِتاً وَالجِبَالُ تَضْطَرِبُ",97,"ب",1,0]]}