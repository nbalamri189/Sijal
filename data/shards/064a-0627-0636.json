{"poems":[[53,"صبرا غريم الثأر من عدنان","https://www.aldiwan.net/poem29664.html","الرجز"],[53,"قد قلت للنفس الشعاع أضمها","https://www.aldiwan.net/poem30669.html","الكامل"],[63,"يا ضلوعي تلهبي في اكتئاب","https://www.aldiwan.net/poem45902.html","الخفيف"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[10,"يا عين جودي بالدموع الغزار","https://www.aldiwan.net/poem21090.html","السريع"],[93,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[4,"يا ضمر يا عبد بني كلاب","https://www.aldiwan.net/poem21216.html","الرجز"],[47,"يا ضارب الجيش بي في وسط مفرقه","https://www.aldiwan.net/poem25357.html","البسيط"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[51,"يا ضرطة يخلق الزمان وما","https://www.aldiwan.net/poem61890.html","المنسرح"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[51,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"يا ضد عيسى جاء من لا أب","https://www.aldiwan.net/poem66349.html","السريع"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[91,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[45,"يا ضيعة الدنيا وضيعة أهلها","https://www.aldiwan.net/poem65680.html","الكامل"],[66,"يا ضعيف الجفون أضعفت قلبا","https://www.aldiwan.net/poem40105.html","الخفيف"],[97,"نفدي النزيل ونكرمن","https://www.aldiwan.net/poem24742.html","مجزوء الكامل"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[74,"يا ضاحكا ملء فيه جهلا","https://www.aldiwan.net/poem12837.html","مجزوء البسيط"],[74,"صممت سمعا فما أصغي إلى العذل","https://www.aldiwan.net/poem13214.html","البسيط"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[46,"خبر الحياة شرورها وسرورها","https://www.aldiwan.net/poem22353.html","الكامل"],[76,"ساق ترنح يشدو فوقه ساق","https://www.aldiwan.net/poem39256.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85434","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43724","المجتث"],[100,"بنوك .. وديوك","https://www.poetsgate.com/ViewPoem.aspx?id=183585",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[45,"مَرّتْ على عَزْمِها، وَلمْ تَقِفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32845",""],[45,"يا ضَيْعَةَ الدّنْيَا وَضَيْعَةَ أهْلِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=32041",""],[47,"يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14738",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""]],"verses":[["يا ضارِبَ الهاماتِ وَهيَ نَوافِرٌ","تَشكو تَفَرُّقَها إِلى الأَبدانِ",0,"ن",1,0],["يا ضَيعَةَ الأَمَلِ الَّذي وَجَّهتُهُ","طَمَعاً إِلى الأَقوامِ بَل يا ضَيعَتي",1,"ي",1,0],["يا ضُلُوعي تَلَهَّبي في اكْتِئابِ","يا دُموعي تَأَهَّبي لِانْسِكابِ",2,"ب",1,1],["يا ضَرَّةَ الشَمسِ إِنَّ الحُبَّ أَبعَدَني","فَلَيتَ شِعري بِماذا مِنكِ أَقتَرِبُ",3,"ب",1,0],["يا ضارِبَ الفارِسِ يَومَ الوَغى","بِالسَيفِ في الحَومَةِ ذاتِ الأُوار",4,"ر",1,0],["يَا ضَرِيحاً أَوَى إِلَيْهِ حَبِيبٌ","تَحْتَ ضَوْءِ الذَّبِيحَةِ البَسَّامِ",5,"م",1,0],["يا ضَبُّ قَد فَرِغَت يَميني فَاِعلَموا","طُلُقاً وَما شَغَلَ القُيونُ شِمالي",6,"ي",1,0],["يا ضَبُّ عَلّي أَن تُصيبَ مَواسِمي","كوزاً عَلى حَنَقٍ وَرَهطَ بِلالِ",6,"ل",1,0],["يا ضَبُّ إِنّي قَد طَبَختُ مُجاشِعاً","طَبخاً يُزيلُ مَجامِعَ الأَوصالِ",6,"ل",1,0],["يا ضَبُّ لَولا حَينُكُم ما كُنتُمُ","عَرَضاً لِنَبلي حينَ جَدَّ نِضالي",6,"ي",1,0],["يا ضَبُّ إِنَّكُمُ البِكارُ وَإِنَّني","مُتَخَمِّطٌ قَطِمٌ يُخافُ صِيالي",6,"ي",1,0],["يا ضَبُّ غَيرُكُمُ الصَميمُ وَأَنتُمُ","تَبَعٌ إِذا عُدَّ الصَميمُ مَوالي",6,"ي",1,0],["يا ضَبُّ إِنَّكُم لَسَعدٍ حِشوَةٌ","مِثلُ البِكارِ ضَمَّمتَها الأَغفالِ",6,"ل",1,0],["يا ضَبُّ إِنَّ هَوى القُيونِ أَضَلَّكُم","كَضَلالِ شيعَةِ أَعوَرَ الدَجّالِ",6,"ل",1,0],["يا ضَمرَ يا عَبدَ بَني كِلابِ","يا أَيرَ كَلبٍ عَلِقٍ بِبابِ",7,"ب",1,1],["يا ضارِبَ الجَيشِ بي في وَسطِ مَفرِقِهِ","لَقَد ضَرَبتَ بِعَينِ الصارِمِ العَضَبِ",8,"ب",1,1],["يا ضلالي من بعد ذاك المحيّا","وافتقاري من بعد ذاك النوال",9,"ل",1,0],["يا ضُلَّ تَفْدِيةٍ هنا","لك تستديمُ بها هِبابهْ",10,"ب",2,0],["يا ضَيفَهُ أبشرْ فإنك غانمٌ","أجر الصيام وليس بالمكتوبِ",11,"ب",1,0],["يا ضرطة يُخْلِقُ الزمانُ وما","تبرحُ إحدى الطَّرائف الجُدُدِ",12,"د",1,1],["يا ضارب المَثَلِ المزخرفِ مُطْرياً","للحقد لم تَقْدح بزَنْدٍ وارِي",13,"ر",2,1],["يا ضرطةً سبق البريدَ بريدُها","ركضاً وخلَّفَ شوطُها أشواطا",14,"ط",2,0],["يا ضعيفاً في رأسه ألفُ قرنٍ","عدداً كلُّها غليظٌ سميك",15,"ك",1,0],["يا ضدَّ عيسى جاء من لا أبٍ","وجئْتَنا أنت مِنَ العالمِ",16,"م",1,1],["يا ضَريحاً عَلى ضِفافِ الوادي","جادَ مِن أَجلِكَ الغَمامُ البِلادا",17,"ا",1,0],["يا ضَيفَنا وَالأُنسُ أَنتَ رَسولُهُ","وَبَشيرُه وَالفَنُّ أَنتَ أَميرُهُ",18,"ر",2,0],["يا ضَرَّةَ البَلجيكِ في أَحزانِها","تُبكيكَ حَتّى أُمَّةُ البَلجيكِ",19,"ك",1,0],["يا ضميرَ الوُجُود يا عالمَ الأَروا","حِ يا أَيُّها الفضاءُ السَّاهي",20,"ي",1,0],["يا ضَبابَ الأَسى","يا فِجاجَ الجحيمْ",21,"م",1,0],["يا ضَيغَماً يَقتُلُ الأَبطال مُفتَرِساً","لا توهنَنّي فَإِنّي الناب وَالظُفرُ",22,"ر",1,0],["يا ضائع الميراث","والصبية الأحداث",23,"ث",1,0],["يا ضجة الطبول","على طريق الغول",23,"ل",1,0],["يا ضيعةَ الإِسلامِ بعدَكَ إِنَّه","غَرَضٌ لكلِّ مُبَدِّلٍ ومضَيِّعِ",24,"ع",1,0],["ياضَيعَةَ العِلمِ كَيفَ يُرزَقُهُ","ذو الخُرقِ مِنكُم وَالعُجبِ وَالصَلَفِ",25,"ف",1,0],["يا ضَيعَةَ الدُنيا وَضَيعَةَ أَهلِها","وَالمُسلِمينَ وَدَيعَةَ الإِسلامِ",26,"م",1,1],["يا ضَعيفَ الجُفونِ أَضعَفتَ قَلباً","كانَ قَبلَ الهَوى قَوِيّاً مَلِيّاً",27,"ي",2,1],["يا ضيف مصر أقم مقا","م الأهل وانزل في وطن",28,"ن",1,0],["يا ضفاف السلام","تحت عرش النور",29,"ر",1,0],["يا ضاحِكاً مِلءَ فيهِ جَهلاً","أَحسَنُ مِن ضَحكِكَ البُكاء",30,"ا",2,1],["يا ضارِباً يوسُفاً في حُسنِهِ مَثَلاً","جَلَّ اِبنُ أَفعَلَ عَن مِثلٍ وَعَن مَثَلِ",31,"ل",1,0],["يا ضُبَّ إِن تَكفُري أَيّامَ نِعمَتِنا","فَقَد كَفَرتِ أَيادي أَنعُمٍ تُلُدِ",32,"د",1,0],["يا ضارِبَ العَودِ البَطيءِ وَظَهرُهُ","لا وِزرَ يَحمِلُهُ كَوِزرِ الضارِبِ",33,"ب",1,0],["يا ضَيعةَ الشِّعْرِ في بُلْهٍ جَرامقَةٍ","تَشابَهتْ مِنهُمُ في اللُّؤمِ أَخلاقُ",34,"ق",1,0],["يا ضَريحاً فيه الرشيد يَنامُ","مطمئناً مني عليك سَلامُ",35,"م",1,1],["يا ضلّة الشاعر أين النجاهْ","وأين أينَ المنزلُ الآمنُ",36,"ن",1,0],["يا ضِفافَ النيلِ باللّهِ ويا خُضرَ الروابي","هل رأيتنَّ على النهر فتىً غضَّ الإهابِ",37,"ب",1,0],["يا ضارِب البَدرِ أَقسَم","تُ لا وَطِئتَ بِساطي",38,"ي",1,1],["يا ضعفنا ، تبدو لهم سافراً","يا ضعفهم ، هيهات أن يدركوك",39,"ك",1,0],["يا ضريح الحبيب لم يبق لى","دمع فأسقى ثراك من هتانه",40,"ن",2,0],["يا ضَيعَةَ العِلْمِ، كَيفَ يُرْزَقُهُ","ذو الخَرْقِ فيكُمْ وَالعُجبِ وَالصَّلَفِ",41,"ف",1,0],["يا ضَيْعَةَ الدّنْيَا وَضَيْعَةَ أهْلِهَا،","وَالمُسْلِمِينَ، وَضَيْعَةَ الإسْلامِ",42,"م",1,1],["يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","لقدْ ضربتَ بنفسِ الصارمِ الغضبِ",43,"ب",1,1],["يا ضائعا فى الأرض .. يا نغما","فى غابة الشربين مرميا",44,"ي",2,0]]}