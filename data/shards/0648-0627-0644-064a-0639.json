{"poems":[[79,"هب النسيم معطر الأراج","https://www.aldiwan.net/poem36664.html","الكامل"],[85,"هب النسيم على الرياض مع السحر","https://www.aldiwan.net/poem54309.html","الكامل"],[74,"بالغت في شجني وفي تعذيبي","https://www.aldiwan.net/poem18225.html","الكامل"],[53,"أمسى دمشقي الأمير ودهره","https://www.aldiwan.net/poem66442.html","الكامل"],[47,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30463","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[79,"هب النسيم معطر الأراج","https://www.poetsgate.com/ViewPoem.aspx?id=33813",""],[82,"عجبي من سكينتي وَوَقَاري","https://www.poetsgate.com/ViewPoem.aspx?id=3243",""],[132,"دعوه يبكى دما ودمعا","https://www.aldiwan.net/poem50582.html","مخلع البسيط"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[146,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[240,"تهن بها أشرف الأرض دارا","https://www.aldiwan.net/poem32007.html","المتقارب"],[255,"لي من الشمس خدمة صفراء","https://www.aldiwan.net/poem14922.html","الخفيف"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[409,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[412,"حييتما من دمنتي طلين","https://www.aldiwan.net/poem50099.html","الكامل"],[422,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[447,"يا خالق الخلق يا من جوده الجود","https://www.aldiwan.net/poem14289.html","البسيط"],[466,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[556,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86975","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122311","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38949","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78179","الرمل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67386","البسيط"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48242","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109404","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106886","المتقارب"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66530","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93314","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28620","الكامل"],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5364,"ثامن عشر آذار","https://www.poetsgate.com/ViewPoem.aspx?id=177161",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6259,"حُييتما من دمنتي طللينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59406&r=&rc=54",""]],"verses":[["والَى عليَّ بِها وقالَ هيَ التي","فِيها سَمَحْتَ بخَيْرِها النّسّاجِ",0,"ج",1,0],["وإلى عليك بها الكؤوس وربما","يسقيك من كأس الفتور إذا فَتَرْ",1,"ر",1,0],["وإلى عمادهُم انتهتْ علياؤُهم","وإلى العلاء قد انتهتْ لنجيب",2,"ب",1,0],["والَى عليه مصيبتين أفاضتا","عبراتِه واستذكَتا أحزانَهُ",3,"ن",2,0],["وَإِلى عَبدِ العَزيزِ اِتَّجَهَت","رَغبَتي تَسلُكُ نَهجاً مُشتَرَك",4,"ك",1,0],["واليعابِيبُ حَولَهُ تَتَعادى","كَالسراحينَ بِالأُسودِ الضَّواري",5,"ر",2,0],["وإلى عِشْقِكَ الجَمالُ دعاهُ","فإلى هجَرِهِ تُرى من دعاكا",6,"ك",2,0],["وإلى عروس البحر هِمْ","تَ وفي شواطئها كمنْتْ",7,"ت",1,0],["وَالى علَىَّ بطَرْفِهِ وبكَفِّهِ","فأَمالَ مِن رَأسِي لِعَبِّ كَبيرِه",8,"ر",2,0],["وَالْيَعْرُبِيَّةُ أَنْدى مَا بَعَثْتَ بِهِ","شَجْواً مِنَ الْحُزنِ أَوْ شَدْواً منَ الطَّرَب",9,"ب",1,0],["والى علي بها وقال هي التي","فيها سمحت بخير النساج",10,"ج",1,0],["واليعابيبُ حوله تتعادى","كالسراجين بالأسود الضواري",11,"ر",2,0],["واليعربى النسبُ الذي","يقطعُ عنق الأعداء قطْعَا",12,"ع",2,0],["وإلى عميد الدولة اعتسفت بنا","أنضاؤها حتى هناها المريَعُ",13,"ع",1,0],["واليَعْمَلاتُ سياطُها وحذاؤها","نسبٌ نماه شَدقُم وجديلُ",14,"ل",1,0],["وَآلى عَلى الدَهرِ أَن لا يَنالَ","مَآرِبَهُ مِنهُ إِلّا اِقتِسارا",15,"ر",2,0],["وإلى عَدلك الكريم أشتكي جَو","رَ الليالي فاصنع إِذا ما تَشَاءُ",16,"ا",2,0],["وَإِلى عَمرٍو وَإِن لَم آتِهِ","تُجلَبُ المِدحَةُ أَو يَمضي السَفَر",17,"ر",1,0],["وإلى علم ابن سينا فارتحل","واركب الأهوال",18,"ل",1,0],["وَإِلى عُمانَ وَفارِس ثُمَّ اِنتَحى","بِالرَيّش نَحوَ جَزيرَة البَحرَينِ",19,"ن",1,0],["وإلى عبد الحميد انتسَبَتْ","غرر الشعر له شكراً وحمدا",20,"د",2,0],["واليعملات بها يعلين من مرج","لها رفاف وإيغال وتوخيد",21,"د",1,0],["وإلى عُلا بكْرٍ نَمتْكَ عِصابةٌ","طيبُ الثَّناء وطيبِ العُنْصُر",22,"ر",1,0],["وإلى عَصائب سارِيا","تٍ في الدّآدِي عاشياتِ",23,"ت",1,0],["وَآلى عَلى أَن لا يَخون وَأَنَّهُ","يَكون أَميناً وَهوَ أَكذَب حالف",24,"ف",1,0],["وإلى على ان لا اقيم بارضه","وأحرمني يوم الفراق وداعه",25,"ع",2,0],["والى عَلَيك اللَّهُ ربِّي كَرَمَهْ","وَواصَلَ اللَّهُ عَلَيكَ نِعَمَه",26,"ه",1,0],["وَإِلى عَلياك أَهدى غادةً","بِكَ قَد دامَ لَها عِز وَفَرَح",27,"ح",1,0],["وإلى عَلِيَّا بِقَدْرِ بَذَّ مِنْهُ إذا","مَا صَرَّحَ الْغَدْرُ عَنْ رَدّ الضَّغَابِيسِ",28,"س",1,0],["والى عرش ساموابى فعوجا","تريا مربعا فسيحا بهيجا",29,"ج",2,0],["واليَعْمُلاتُ بزوْرةِ الأحبابِ بال","أحبابِ تقطعُ فَدْفَداً في فَدْفَدِ",30,"د",1,0],["وإلى علاه قد زففتُ عقيلة","محفوظةً من سعده بتمائِم",31,"م",1,0],["وآلى عليها وآلت عليه","بأن لا يحولَ وأن لا تحولا",32,"ل",2,0],["وَإِلى عَليا حِماكُم أَنتَمي","فَاِنظُروا أيَّ اِلتِزامٍ بَينَنا",33,"ن",2,0],["وإلى علاه بعثتها","غرّاء كي أرعى ذمامه",34,"م",2,0],["وإلى عاليه في لبنان قد","ساقني الضابط قيد الإعتقال",35,"ل",1,0],["واليعافيرُ ساحبات المغا","فير علينا كالرَّبْرَب المُجْتاز",36,"ز",1,0],["وَإِلى عموريةٍ سَمَا في جَحفَلٍ","مَلَأَ الفجاج سُهولَهُ وَحُزونَهُ",37,"ن",2,0],["وإلى عُشّنا الجميلِ.. ففيهِ","هزجٌ للهوى، وظلٌّ وسلسلْ",38,"ل",1,0],["واليعربي لسياسة الغرب خّدام","ي مسايس العدوان ويش انت لاقي",39,"ق",2,0],["وَالي عليه اللَه غضبان مننا","ما بينهم يجعل قصاص جَزاه",40,"ا",2,0],["وإلى عمان وفارس ثم انتحى","بالريّ نحو جزيرة البحرين",41,"ن",1,0]]}