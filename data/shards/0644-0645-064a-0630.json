{"poems":[[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[55,"ما أنكأ البين لقرح القلوب","https://www.aldiwan.net/poem26542.html","السريع"],[93,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[44,"أزعمت أن الربع ليس يتيم","https://www.aldiwan.net/poem30360.html","الكامل"],[44,"يا وارث الملك إن الملك محتبس","https://www.aldiwan.net/poem30495.html","البسيط"],[105,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[48,"عد عن رسم وعن كثب","https://www.aldiwan.net/poem10780.html","المديد"],[48,"دع الوقوف على رسم وأطلال","https://www.aldiwan.net/poem64512.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[94,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[51,"غصنٌ من البان في وشاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=27401",""],[110,"هاتها والزمان عنك نؤوم","https://www.aldiwan.net/poem16519.html","الخفيف"],[144,"ما عليها أوان تطوي الفيافي","https://www.aldiwan.net/poem11782.html","الخفيف"],[210,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[260,"أنجد المتهم في غزلان طي","https://www.aldiwan.net/poem35802.html","الرمل"],[305,"خل عنك الهم يا قلب الحزين","https://www.aldiwan.net/poem16773.html","الرمل"],[329,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[381,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[406,"والله لو أنهم أتوني","https://www.aldiwan.net/poem49828.html","مخلع البسيط"],[410,"يا ناق شطت دارهم فحني","https://www.aldiwan.net/poem32367.html","الرجز"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[559,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"]],"verses":[["لَم يَذوقوا الماءَ حَتّى اِجتَمَعوا","بِحِدى السَيفِ عَلى وِردِ الرَدى",0,"ا",1,0],["لمْ يَذهَبوا سَلَفاً لنَغْبُرَ بَعدَهُمْ","أينَ البَقاءُ ونحنُ في الآثارِ",1,"ر",1,0],["لَم يَذُقِ البُؤسَ وَلا طَعمَهُ","مَن لَيسَ مِن جُهدِ الهَوى ذا نَصيب",2,"ب",1,0],["لم يذكر التاريخ نصراً كالذي","أحرزته فوق الظنون مجيدا",3,"د",2,0],["لم يُذِقْنا حلاوةَ الوَصْلِ إلاَّ","بين عَتبٍ مبرِّحٍ وعِتابِ",4,"ب",1,0],["لَم يَذعَرِ الأَيّامَ عَنكَ كَمُرتَدٍ","بِالعَقلِ يَفهَمُ عَن أَخيهِ وَيُفهِمُ",5,"م",1,0],["لَم يُذكَرِ الجودُ إِلّا خُضتَ وادِيَهُ","وَلا اِنتُضِيَ السَيفُ إِلّا خافَكَ القَدَرُ",6,"ر",1,0],["لَم يَذكُروا إِذ نَحنُ نَبذُلُ قُوتَنا","وَنَظَلُّ صَرعى في البُيوتِ جِياعا",7,"ع",2,0],["لَم يَذُقها قَطُّ راشِفُها","فَخَلا مِن لاعِجِ الطَرَبِ",8,"ب",1,0],["لَم يُذهِبِ الدَهرُ عَنها حَدَّ سَورَتَها","وَلَم يَنَلها الأَذى في دَهرِها الخالي",9,"ل",2,0],["لَمْ يُذَعْ مِنْ فَضْلِهَا الخَا","فِي سِوَى طَيبٌ يَنِمُّ",10,"م",1,0],["لم يُذكر اسمُك دونها يومًا، ولا","نادى به عند الخطاب مناد",11,"د",1,0],["لم يذد في الوغى عدوّا ولم","يهززه في الرّوع ساعد مفتول",12,"ل",1,0],["لم يذكرها المحبُّ إلا","طار اشتياقاً بلا جناحِ",13,"ح",1,0],["لَم يَذُق طَعم ما أَقول مِن الشع","ر لِعُمري إِلّا الكَريم الكَريم",14,"م",1,0],["لَم يَذُمّوا بِظِلِّهِ العَيشَ في مَش","تىً وَلا مَربَعٍ وَلا مُصطافِ",15,"ف",1,0],["لم يذر فيَّ بهاتيك الربى","أملا تنشده تلك الطيور",16,"ر",1,0],["لم يذوقوا مشرب العشق ولا","طافت الأكؤس منهم بالحمي",17,"ي",1,0],["لَم يَذُق عَيشَ العِبادَ الصالِحينَ","إِن تَرَدَّ عِزّاً وَمَجداً لا يُبيدُ",18,"د",1,0],["لم يذوقوا تفاح حواء إلا","برغيف من طبعها الطيني",19,"ي",1,0],["لَم يَذكُروا عِندَ خوط البان قامَتُهُ","إِلّا وَمالَ مِن الأَشواق أَو سَجَدا",20,"د",2,0],["لم يُذهبِوا بعضَ مااعتَراني","ونالَني ساعةَ الفِراقِ",21,"ق",1,0],["لم يُذكَروا لي قَطّ إلا امتلأتْ","بالدّمعِ أجفانِي وقَالتْ قَطْني",22,"ن",2,0],["لَم يَذوقوا الرّدى جُزافاً ولكنْ","بَعدَ أَن أكرهوا القنا والشِّفارا",23,"ر",2,0],["لم يذوقوا منها الذي نحن ذقنا","لا ولم يعرفوا حقيق النزول",24,"ل",1,0]]}