{"poems":[[55,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[65,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[57,"ما أنكأ البين لقرح القلوب","https://www.aldiwan.net/poem26542.html","السريع"],[95,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[46,"أزعمت أن الربع ليس يتيم","https://www.aldiwan.net/poem30360.html","الكامل"],[46,"يا وارث الملك إن الملك محتبس","https://www.aldiwan.net/poem30495.html","البسيط"],[107,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[50,"عد عن رسم وعن كثب","https://www.aldiwan.net/poem10780.html","المديد"],[50,"دع الوقوف على رسم وأطلال","https://www.aldiwan.net/poem64512.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[108,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[53,"غصنٌ من البان في وشاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=27401",""],[113,"هاتها والزمان عنك نؤوم","https://www.aldiwan.net/poem16519.html","الخفيف"],[147,"ما عليها أوان تطوي الفيافي","https://www.aldiwan.net/poem11782.html","الخفيف"],[213,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[264,"أنجد المتهم في غزلان طي","https://www.aldiwan.net/poem35802.html","الرمل"],[309,"خل عنك الهم يا قلب الحزين","https://www.aldiwan.net/poem16773.html","الرمل"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[385,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[411,"والله لو أنهم أتوني","https://www.aldiwan.net/poem49828.html","مخلع البسيط"],[415,"يا ناق شطت دارهم فحني","https://www.aldiwan.net/poem32367.html","الرجز"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[563,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67014","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48885","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19990","الرمل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49564","البسيط"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139366",""],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93669","البسيط"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70336","الرجز"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127388","الرمل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100172","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89228","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138557",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129421","البسيط"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77716","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28692","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133077","الرجز"],[5224,"قد تجلى جماله جلوات","https://www.poetsgate.com/ViewPoem.aspx?id=121312",""],[5261,"رمضانيون","https://www.poetsgate.com/ViewPoem.aspx?id=212890",""],[5458,"الغدفة","https://www.poetsgate.com/ViewPoem.aspx?id=113375",""],[5653,"هَيْهَاتِ ما تُغْني القَنَابِلُ والقَنَا","https://www.poetsgate.com/ViewPoem.aspx?id=26455",""],[5970,"ما بقائي في العيش بعد الذي بي","https://www.poetsgate.com/ViewPoem.aspx?id=130636",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""]],"verses":[["لَم يَذوقوا الماءَ حَتّى اِجتَمَعوا","بِحِدى السَيفِ عَلى وِردِ الرَدى",0,"ا",1,0],["لمْ يَذهَبوا سَلَفاً لنَغْبُرَ بَعدَهُمْ","أينَ البَقاءُ ونحنُ في الآثارِ",1,"ر",1,0],["لَم يَذُقِ البُؤسَ وَلا طَعمَهُ","مَن لَيسَ مِن جُهدِ الهَوى ذا نَصيب",2,"ب",1,0],["لم يذكر التاريخ نصراً كالذي","أحرزته فوق الظنون مجيدا",3,"د",2,0],["لم يُذِقْنا حلاوةَ الوَصْلِ إلاَّ","بين عَتبٍ مبرِّحٍ وعِتابِ",4,"ب",1,0],["لَم يَذعَرِ الأَيّامَ عَنكَ كَمُرتَدٍ","بِالعَقلِ يَفهَمُ عَن أَخيهِ وَيُفهِمُ",5,"م",1,0],["لَم يُذكَرِ الجودُ إِلّا خُضتَ وادِيَهُ","وَلا اِنتُضِيَ السَيفُ إِلّا خافَكَ القَدَرُ",6,"ر",1,0],["لَم يَذكُروا إِذ نَحنُ نَبذُلُ قُوتَنا","وَنَظَلُّ صَرعى في البُيوتِ جِياعا",7,"ع",2,0],["لَم يَذُقها قَطُّ راشِفُها","فَخَلا مِن لاعِجِ الطَرَبِ",8,"ب",1,0],["لَم يُذهِبِ الدَهرُ عَنها حَدَّ سَورَتَها","وَلَم يَنَلها الأَذى في دَهرِها الخالي",9,"ل",2,0],["لَمْ يُذَعْ مِنْ فَضْلِهَا الخَا","فِي سِوَى طَيبٌ يَنِمُّ",10,"م",1,0],["لم يُذكر اسمُك دونها يومًا، ولا","نادى به عند الخطاب مناد",11,"د",1,0],["لم يذد في الوغى عدوّا ولم","يهززه في الرّوع ساعد مفتول",12,"ل",1,0],["لم يذكرها المحبُّ إلا","طار اشتياقاً بلا جناحِ",13,"ح",1,0],["لَم يَذُق طَعم ما أَقول مِن الشع","ر لِعُمري إِلّا الكَريم الكَريم",14,"م",1,0],["لَم يَذُمّوا بِظِلِّهِ العَيشَ في مَش","تىً وَلا مَربَعٍ وَلا مُصطافِ",15,"ف",1,0],["لم يذر فيَّ بهاتيك الربى","أملا تنشده تلك الطيور",16,"ر",1,0],["لم يذوقوا مشرب العشق ولا","طافت الأكؤس منهم بالحمي",17,"ي",1,0],["لَم يَذُق عَيشَ العِبادَ الصالِحينَ","إِن تَرَدَّ عِزّاً وَمَجداً لا يُبيدُ",18,"د",1,0],["لم يذوقوا تفاح حواء إلا","برغيف من طبعها الطيني",19,"ي",1,0],["لَم يَذكُروا عِندَ خوط البان قامَتُهُ","إِلّا وَمالَ مِن الأَشواق أَو سَجَدا",20,"د",2,0],["لم يُذهبِوا بعضَ مااعتَراني","ونالَني ساعةَ الفِراقِ",21,"ق",1,0],["لم يُذكَروا لي قَطّ إلا امتلأتْ","بالدّمعِ أجفانِي وقَالتْ قَطْني",22,"ن",2,0],["لَم يَذوقوا الرّدى جُزافاً ولكنْ","بَعدَ أَن أكرهوا القنا والشِّفارا",23,"ر",2,0],["لم يذوقوا منها الذي نحن ذقنا","لا ولم يعرفوا حقيق النزول",24,"ل",1,0],["لم يَذْكُرُوا إحْسَانَهَا إلاَّ نَسُوا","حُسْنَ العَزَاءِ وبَعْدَهَا لَنْ يَحْسُنَا",25,"ن",2,0],["لم يذهب الملأ السيوف ضحية","إلا ليلقى اللاحقون نجاحا",26,"ح",2,0],["لَم يَذُقها خِدن داءٍ وَسَقَم","مُزمنٍ إِلّا بِها نال شِفاه",27,"ه",1,0],["لَم يَذَرَّفي نَواحي","هِ مِن الصُبحِ ذَرورُ",28,"ر",1,0],["لم يذكر اسمك في كتاب الله ما","بين القضاء بموقف الديان",29,"ن",1,0],["لم يَذْهبُوا وبلى والله قد ذهبوا","كالمُزْنِ أفضَتْ بما فيها إلى الغُدُر",30,"ر",1,0],["لم يُذلَّلن بالسُّرُوج ولا أق","رح أشداقَهُنَّ جذبُ العنانِ",31,"ن",1,0],["لم يذق ما مر منه أوحلا","ظل يلحو ضلة إذ جهلا",32,"ل",2,0],["لَم يَذخروا غَير كنز العلم في وَرق","وَالناس تَدَّخر الأَموال وَالوَرَقا",33,"ق",2,0],["لم يذوقوا طعم الفراق ولا ما","أحرقت لوعة الهوى من ضلوعي",34,"ي",1,0],["لم يذق ما ذاق حتى","نال بالخلد مراده",35,"د",2,0],["لم يذق طرفي لما لمحا","جيدها الناصح دهراً وسنا",36,"ن",2,0],["لم يذق لذة المروءة هل من","غفلات ترى إذا إيقاظه",37,"ظ",2,0],["لم يذكر الطف إلا طاف جيش أسى","بالقلب قد منع الافراح ان تلجا",38,"ج",2,0],["لم يذكر المال بل اسنى ذخائره","كنز من البيض أو كنز من الأسل",39,"ل",1,0],["لمْ يذخروا عنك الطَّرِي","قَ إذا أتيتَ ولا التليدا",40,"د",2,0],["لم يذكر التاريخ الا جده","تركي من شبه له ومثيل",41,"ل",1,0],["لَم يُذَكِّرنيكَ خَطبٌ حادِثٌ","إِنَّما يذكرُ مَن كانَ سَها",42,"ه",2,0],["لم يذكروا وراهم","بعد الممات موقف القيامه",43,"ه",1,0],["لم يذر في الرؤوس من عقل","قهره العقول باللمحات",44,"ت",1,0],["لم يذوقوا بالمشتهى أي طعم","غير ِطعم الفناء ذاك الهيام",45,"م",1,0],["لم يذهل الشعر إلا عند طلعتها","حار البيان لهذا السحر أن يصفا",46,"ف",2,0],["لم يذكروا إحسانهم إلا نسوا","حسن العزاء وبعدها لن يحسنا",47,"ن",2,0],["لم يذق لذة الحياة ولكن","ذاق أنواع قاصمات الخطوب",48,"ب",1,0],["لم يذكرِ التاريخُ اسما ًقبلهُ","فتراه ُ هدْ يا ً للكتاب ِ يُؤيّدُ",49,"د",1,0]]}