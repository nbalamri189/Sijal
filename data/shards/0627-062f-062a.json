{"poems":[[49,"يا ليل ما أغفل عما بي","https://www.aldiwan.net/poem25351.html","السريع"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[47,"يزداد في غي الصبا ولعه","https://www.aldiwan.net/poem64662.html","الكامل"],[50,"إن التي أبصرتها","https://www.aldiwan.net/poem64970.html","مجزوء الكامل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[108,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[398,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[438,"وأمرد يعقد زناره","https://www.aldiwan.net/poem12606.html","السريع"],[463,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49958","المنسرح"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101729","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131011",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73149","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83143","البسيط"],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""]],"verses":[["أَدَّت رِسالاتِ حَبيبٍ لَنا","فَهِمتُها مِن بَينِ أَصحابي",0,"ب",2,0],["أَدَّت إِلى الناسِ بِهِ","سُكَّرَةً بِسُكَّرَه",1,"ر",2,0],["أَدَّت مَخايِلُهُ حَقيقَتُهُ","سَومَ الخَريفِ أَراكَهُ قَزَعُه",2,"ع",2,0],["أَدَّت إِلَيَّ رِسالَةً","كادَت لَها نَفسي تَسيلُ",3,"ل",1,0],["أَدَّتِ الصَنعَةُ في أَمتُنِها","فَهيَ مِن تَحتُ مُشيحاتُ الحُزُم",4,"م",1,0],["أَدَّتْ رسالتها المنابرُ، وانبرى","حدُّ السلاح بدوره ليقولا",5,"ل",2,0],["أَدَّت اِلَيهِ بَصائِر أَعمَلتُها","اِعمالَ مَرضِيِّ اليَقينِ عُقابي",6,"ب",2,0],["أدت يدي الريقَ لبابِ","وعاودتْ يبغي الهدى",7,"د",2,0],["أدَّتْهُمُ يحذوك فرعُ أصله","لم يك دينارُهم ابنَ الفَلسِ",8,"س",1,0],["أدّتْهُ وضّاحَ الجَبين كما","أدّتْ صقال الصّارمِ الخِلَلُ",9,"ل",1,0],["أَدَّت إليه الملُوك طاعَتها","أَشيبها كلِّها وأَمردُها",10,"د",3,0],["أدّت به واجبات للعلى ووفى","معروفها بفروض البر والسنن",11,"ن",1,0],["أدت تبالي دولة عند مأرب","أخيرا إلى الإنسان تصنع أم شرا",12,"ر",2,0],["أدَّت ضفائرُها رسالةَ قُرطهِا","منها مشافهةً إلى الخَلخالِ",13,"ل",1,0],["أَدَّت عَن القَلبِ ما يَعيا اللِسانُ بِهِ","كَمَنطِق الطَيرِ غِرِّيد لِغرِّيد",14,"د",1,0],["أدّتْ شرورُه أنْ حَرَمْنا غيرَه","مِن أوفياءَ مَغبَّة الوَسواسِ..",15,"س",1,0]]}