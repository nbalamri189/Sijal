{"poems":[[87,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[290,"دعك من هذا فماذا","https://www.aldiwan.net/poem39359.html","مجزوء الرمل"],[458,"هيا إلى السماء هيا","https://www.aldiwan.net/poem61573.html","مجزوء الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127365","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132679","السريع"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132014","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132023","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85219","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35465","الرمل"],[4927,"فرحة الاعياد","https://www.poetsgate.com/ViewPoem.aspx?id=4589",""],[4984,"يوم المجاهد","https://www.poetsgate.com/ViewPoem.aspx?id=181624",""],[5189,"تبدو العروبةُ","https://www.poetsgate.com/ViewPoem.aspx?id=195164",""],[5268,"ماسَت يداكِ","https://www.poetsgate.com/ViewPoem.aspx?id=207007",""],[5318,"استغفروا اللهَ عمّا كان من سَفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=213797",""],[5410,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=144511",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5431,"بين اللفظ والمعنى ...","https://www.poetsgate.com/ViewPoem.aspx?id=209150",""],[5500,"يقين","https://www.poetsgate.com/ViewPoem.aspx?id=188513",""],[5587,"أقات وأقات","https://www.poetsgate.com/ViewPoem.aspx?id=197787",""],[5703,"لغة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=207890",""],[5956,"صهاينة يرجون الموساد","https://www.poetsgate.com/ViewPoem.aspx?id=193985",""],[6124,"زهرة النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=160061",""],[6359,"المجلس الطاريء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69093&r=&rc=7",""]],"verses":[["كي نبيد الغرباء الماردين","إنهم في الصين كانوا مفسدين",0,"ن",1,0],["كي نعي ما يشرح الشي","خ صريحا ومرادا",1,"ا",1,0],["كي نسلى بنور شمس","بعد عيش لنا أسير",2,"ر",1,0],["كي نرى في عهده تح","قيق هاتيك الأمالي",3,"ي",1,0],["كي ننقذ الحق ونحيي به","روح أسير بلغت للتراق",4,"ق",1,0],["كي نرى فيها شبابا مؤمنا","يأخذ المقود من كف الدخيل",5,"ل",1,0],["كي نراه ساطعا كال","بدر في أوج التمام",6,"م",1,0],["كي نرى وجه التهاني أسفرا","لنطفَّي مابنا من لهبِ",7,"ب",1,0],["كي نحوز الهنا هنا وتلك الدا","ر في روضة الجنان الظليلة",8,"ل",2,0],["كي نلاقي الموت بالبيض الصفاح","حيَّهَل للثأر فالوقتُ حضَر",9,"ر",1,0],["كَي نُساعِد في خَفاها","حالَ تيهِ الزين",10,"ن",1,0],["كَيْ نَتْرُكَ الْوَطَنَ الْعَزِيْزَ لِغَاْصِبٍ","خَوْفاً مِنَ الإِبْرَاْقِ وَالإِرْعَاْدِ",11,"د",1,0],["كي نرى في مجاهد الأمس رمزا","ما ابتغى من جهاده أي أجر",12,"ر",1,0],["كي نستعيد مكانةً كانت لنا","ببسَالةِ الأبطالِ والشجعانِ",13,"ن",1,0],["كي نصطَفي من تُرابِ الكونِ سُنبُلَةً","تَمحو شقاءَكِ أَوْ تَتلو لَنَا الفَلَقَا",14,"ق",2,0],["كي نعبدَ اللهَ، هذا قصدُ خالِقنا","فهل - كما شاءَ- حقاً قد عبدناهُ؟!",15,"ا",2,0],["كي نُسَاقى مع المشاعر حُبّاً","في سناهُ يزيد فينا الثمارا",16,"ر",2,0],["كي نُروًّي القلوبَ نورا وحبّا","بعد أن أجٍدبتٍ وصارت قًفارا",17,"ر",2,0],["كينونة الشعر باتت محض أخيلة","تراقص الفكر في منسوبه الأدنى",18,"ن",2,0],["كَينونَةُ النُّورِ الَّتي تَجلُو كَمَا","شَاءَتْ وتَعرِفُ أيَّ نارٍ كَثَّفَتْ",19,"ت",1,0],["كِي نْشُوفْ الحْبِيبْ قَلْبِي يَشْفَقْ","وْ لَفْرَاقْ خَلّفْ مِنْ كْوَاهْ حْرِيقْ",20,"ق",1,0],["كي نملأ الدُنيا غَراماً ساحراً","وتضُمُّنا بينَ النُجومِ سُرادقُ",21,"ق",1,0],["كي نهدمَ البلدين نبني أمننا","في تلْ أبيبَ وفي ثرى طبريّا..",22,"ي",2,0],["كي نمرَّ الآنَ من دربٍ لدربِ","نحتسي من وجدنا شهدًا شهيَّ.",23,"ي",1,0],["كي نفاجأ أن \"ميرا \" أخرجتْ","من سباقِ الحلقاتِ المقبلة !",24,"ل",2,0]]}