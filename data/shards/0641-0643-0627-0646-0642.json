{"poems":[[90,"رويدك غورو أيهذا الجنيرال","https://www.aldiwan.net/poem44823.html","الطويل"],[53,"خذ نصيبا من عيشك المستعار","https://www.aldiwan.net/poem64086.html","الكامل"],[53,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[63,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[68,"نظروا الهلال فأعظموه وأكبروا","https://www.aldiwan.net/poem39649.html","الكامل"],[46,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[33,"ألمم بجور في الصفاح حسان","https://www.aldiwan.net/poem41303.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85441","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85300","الكامل"],[267,"يا ابن عم النبي دعوة شيخ","https://www.aldiwan.net/poem68212.html","الخفيف"],[315,"ضحكت وجوه الدهر بعد عبوس","https://www.aldiwan.net/poem59511.html","الكامل"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[382,"حي الديار ديار جلق واستزِد","https://www.aldiwan.net/poem66875.html","الكامل"],[409,"قرت العين ببشرى","https://www.aldiwan.net/poem33920.html","مجزوء الرمل"],[409,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[412,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[422,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[567,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"],[580,"أدنو إليك فأقصى","https://www.aldiwan.net/poem2923.html","المجتث"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101198","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46543","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47381","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108738","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69332","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48207","الكامل"],[2133,"","https://poetry.dctabudhabi.ae/diwan/poem/111529","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120981","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100288","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205033","الكامل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132949","الكامل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145152","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86460","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93739","الكامل"],[4830,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=193597",""],[4832,"حيث الهزار شدا وغرد","https://www.poetsgate.com/ViewPoem.aspx?id=166698",""],[4978,"(إذنا) ورفرف ألف طير شاد","https://www.poetsgate.com/ViewPoem.aspx?id=188848",""],[5147,"سر الهوى العذري مودع","https://www.poetsgate.com/ViewPoem.aspx?id=166721",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[5409,"منعاك عز على العراق الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=155480",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""]],"verses":[["فكان قتيلاً بالمطامع عزُّه","فذّل وإن الحرص للعزّ قتّال",0,"ل",1,0],["فكأنْ قد سَفتْ عليك السوافي","في بطون الملمَّعات القِفار",1,"ر",1,0],["فكان قِرىً قبل القِرى مُتعجّلاً","شهيّاً مريّاً للنفوس ملائما",2,"م",2,0],["فكأنْ قد شهدت كُلَّ قديم","وبكم قد تفاوتَ الحَرسَان",3,"ن",1,0],["فكأنَّ قُربَك سَقيُهُ","إذا تألَّقَ بالمَقَاتِل",4,"ل",1,0],["فَكَأَنَّ قَلبي في الحَقيقَةِ مِرجَلٌ","نارُ الصَبابَةِ حَولَهُ تَتَسَعَّرُ",5,"ر",1,0],["فَكَأَنَّ قُسّاً في عُكاظٍ يَخطُبُ","وَكَأَنَّ لَيلى الأَخيَلِيَّةَ تَندُبُ",6,"ب",1,0],["فَكَأَنَّ قَلبَكَ يَومَ جِئتَ مُوَدِّعاً","بِدَلالِهِنَّ وَرُبَّما أَضناني",7,"ن",2,0],["فكأن قبرك إذ زها بك روضة","وكأن عيني عندها ينبوع",8,"ع",1,0],["فكأَنَّ قَلبي لَيسَ في","هِ للصَبابة من حَراره",9,"ر",2,0],["فَكَأَن قَد مَضَى وخَلَّفَ فِيكُم","مَا أعَرتُم وأقفَرَت مِنهُ دَارُه",10,"ر",2,0],["فكأن قومي نادمتهم قرقف","شربوا النعيم لها بغير كؤوس",11,"س",1,0],["فكأن قرناً يُبتلى بنزاله","يرمي بطودٍ فوقه متدهده",12,"ه",1,0],["فكأن قاني وردها في غصنه","نارٌ على علمٍ وقدحُ زناد",13,"د",1,0],["فكأن قد جمع الشم","ل بمن أهواه طرا",14,"ر",2,0],["فكان قضاء الله سبق أحبتي","وفيما قضاه اللّه اللّه أحمد",15,"د",1,0],["فَكَأَنَّ قَلبي قبره وَكَأَنَّهُ","في طَيِّهِ سِرٌّ مِنَ الأَسرارِ",16,"ر",1,0],["فكأنْ قد أخَذَتْ من قَبلها","عن قماري الدَّوح أقمارُ القيان",17,"ن",1,0],["فكان قد طابَ في الدَّارَين مَضجَعُهُ","إذ كانَ في حِضنِ إبراهيمَ لم يَزَلِ",18,"ل",1,0],["فكان قَلْبِيَ قَصْراً","فصارَ بالهَمِّ خُصّاً",19,"ص",2,0],["فكأن قد عرجت فيها إلى أن","فيك اعيت على السهى معراجا",20,"ج",2,0],["فكأن قد مَضى الشّبابُ نهيّاً","وأتى الشّيبُ بالنُّهى الهَرميِّ",21,"ي",1,0],["فَكانَ قَصدي أَوّلا أَتيلا","بِهِ اِتّخَذت مَنزِلاً جَميلا",22,"ل",2,0],["فَكانَ قَول الشَّيخ قومي الهند","الحُكماء العُلماء اللد",23,"د",1,0],["فَكانَ قَول الصادِحَه","لا فض فوك ناصِحَه",24,"ه",1,1],["فَكَأَنَّ قَلْبي مِنْ وَراءِ ضُلوعِهِ","طَرَباً يُخَبِّرُ قَلْبَهُ عَمَّا بِهِ",25,"ب",2,0],["فكأن قامتها تلغراف الهوى","وكأن قلبي صفحة القرطاسِ",26,"س",1,0],["فَكَأَنَّ قُضبانَ الزَبَرجَدِ حُمِّلَت","أَعلا ذَوائِبها نُجومَ الحِندِسِ",27,"س",1,0],["فكأَّن قلبي ان نظمتُ قصيدةً","تسبى القلوب دَهَاه يوم حُماذ",28,"ذ",1,0],["فكان قطر دموعه من فوقها","در تبدد في بساط عقيق",29,"ق",1,0],["فكأنَّ قبتك العروس تبرّجت","عند الزفاف يحسنها الفنّانِ",30,"ن",1,0],["فكأن قلبك حين تعرض صخرة","عادية وفؤادك الفولاذُ",31,"ذ",1,0],["فكأن قلبي لا يعيش بلا هوى","وكأن حب الحسن سر وجودي",32,"د",2,0],["فكأن قُولَنجَ النَّذالةِ مَسَّه","فاستَفَّ من إهليلَجِ الأدبارِ",33,"ر",1,0],["فكأن قانون السما","ء طوى الصحائف وارتحل",34,"ل",1,0],["فكأن قبرك يوم ذلك كعبة","كل بقبلتها أقام وأذنا",35,"ن",2,0],["فَكأن قَبض النجم عندَ أُفوله","كف الفَناء تشير بالإِيماء",36,"ا",2,0],["فكأنّ قلبُكِ يازليخا قلبُنا","لكنَّ بغدادَ الحبيبةَ يوسفُ",37,"ف",1,0],["فكأن قلبي جنة","وهواهم فيها مخلد",38,"د",1,0],["فكأنّ قرنعةً بها حلت كما","تلٌُّ بها مع ذخرةٍ والوادي",39,"د",2,0],["فكأن قلبي وهو قلبي","بين أضلاعي مودع",40,"ع",1,0],["فَكَانَ قَضاءُ الإلَهِ لَنا","بِفَجرٍ أَغَرَّ بُعَيْدَ الغَبَشْ",41,"ش",1,0],["فكأن قلبك كان في إقدامه","زبُر الحديد بقالب الأجسام",42,"م",1,0],["فكأنَّ قامةَ كلِّ وِدٍّ مَائِلٍ","أَلِفٌ ودَارَةَ كلِّ نُؤْيٍ مِيْمُ",43,"م",1,0],["فَكَأَن قَد شَبِعَت في سَيرها","مِن أَمانٍ وَاكتَفَت مِن أَرَبِ",44,"ب",1,0]]}