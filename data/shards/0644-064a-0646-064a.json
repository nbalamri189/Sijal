{"poems":[[3,"لا يحمل الحقد من تعلو به الرتب","https://www.aldiwan.net/poem126.html",""],[3,"إِذا كان دمعي شاهدي كيف أجحَدُ","https://www.aldiwan.net/poem155.html",""],[75,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[29,"عفا ذو حمام بعدنا وحفير","https://www.aldiwan.net/poem5766.html","الطويل"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[87,"أقسمت لو أمر الزمان سماءه","https://www.aldiwan.net/poem8062.html","الكامل"],[71,"كن من أولي العلم ولو خاملا","https://www.aldiwan.net/poem28400.html","السريع"],[203,"أيا ضيفا أطال المك","https://www.aldiwan.net/poem45506.html","الهزج"],[228,"هذي الروائع من ذاك اللظى خلق","https://www.aldiwan.net/poem39686.html","البسيط"],[275,"من غصن قلبك زهر الحب ينتثر","https://www.aldiwan.net/poem35472.html","البسيط"],[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[469,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[567,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[567,"بكى حتى بكيت على بكاه","https://www.aldiwan.net/poem52917.html","الوافر"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110441","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126185","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109333","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109335","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109386","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105007","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104971","المتقارب"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107006","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204590","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204700","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65174","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138779",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87365","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109975","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92021","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91723","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132125","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44909","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136487",""],[4576,"","https://poetry.dctabudhabi.ae/diwan/poem/31392","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120557","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4679,"رأى الدهر ما قد سامنا البين والهجر","https://www.poetsgate.com/ViewPoem.aspx?id=142725",""],[5183,"مصاب الدين","https://www.poetsgate.com/ViewPoem.aspx?id=180258",""],[5183,"الرزّء الأليم","https://www.poetsgate.com/ViewPoem.aspx?id=180263",""],[5573,"عديت لك سبعين بارق وشديت","https://www.poetsgate.com/ViewPoem.aspx?id=205474",""],[5652,"دُرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192118",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5829,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180642",""],[6301,"حَنِيْنٌ الى لِقَاءٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80673&r=&rc=37",""]],"verses":[["لَئِن يَعيبوا سَوادي فَهوَ لي نَسَبٌ","يَومَ النِزالِ إِذا ما فاتَني النَسَبُ",0,"ب",1,0],["لَئِن يَشمَتِ الأَعداءُ يا بِنتَ مالِكٍ","فَإِنَّ وِدادي مِثلَما كانَ يَعهَدُ",1,"د",1,0],["لَئِن يَنصَرِم شَهرُ الصِيامِ لَبَعدَهُ","نَثا صالِحِ الأَعمالِ ما أَنتَ عامِلُ",2,"ل",1,0],["لَئِن يُسلِمِ اللَهُ المَراسيلَ بِالضُحى","وَمَرُّ القَوافي يَهتَدي وَيَجورُ",3,"ر",1,0],["لي نيَّةٌ فيك إذ لي فيهمُ كلمٌ","وإنَّما لبني الأعمالِ نيَّات",4,"ت",1,0],["ليُنيلَ قَدرَكَ في المَعالي حَقَّهُ","شَكَتِ المَعالي أَنَّهُ مَظلومُها",5,"ه",2,0],["لئنْ يقولوا عالمٌ كاسدٌ","ولا يقولوا جاهلٌ نافق",6,"ق",1,0],["لئنْ يصفُ لنا يومٌ","فأيامكَ لا تصفو",7,"ف",2,0],["لينينُ أَحلامُكَ الغَرّاءُ قَد صَدَقَت","فَاِنفُض تُرابَكَ يَكفي ذلِكَ الغَرَقُ",8,"ق",1,0],["لئن يكن ماؤه قد جفَّ أنضَرَهُ","دَمعي فوَجداً على الأغصان ينهمر",9,"ر",1,0],["لئن يَعيشوا فرجِّي من عزائِمهم","أمراً يؤخِّرهُ تَفريقُ شملِهم",10,"م",1,0],["لَينٌ يلاقي حاسديهِ وداعاً","بأَحدَّ من ظُبة الحسام وأَخشنا",11,"ن",2,0],["لئنْ يكُنْ من حِماها غيرَ مُقترِبٍ","فقلبُهُ عن هَواها غيرُ مُبتعِدِ",12,"د",1,0],["لَئِنْ يكُ فاتَها جَبَلٌ ففيها","جِبالٌ في معارِجِها يُتاهُ",13,"ا",2,0],["لئن يكُ عمرُها أَمَداً قليلاً","فَقَد نَالَت بهِ أَجراً جزيلا",14,"ل",2,0],["لئن يكن الولي أبو المعالي","إمام المسلمين الأصفياء",15,"ا",2,0],["لئن يك آل عثمان تباهوا","زماناً بالملوك الصالحينا",16,"ن",2,0],["لئن يك فر مثل سواه ابني","فاني ما أجزت ولا سعيت",17,"ت",1,0],["لي نية بمعاني وصفه صلحت","والمرء يعطي على مقدار نيته",18,"ت",2,0],["لئن يغدُ شرق الأرض والغرب مأتما","فرزءُ حسين جلَّ في الأرض والسما",19,"م",2,1],["لئن يُنسني الدهر كل الخطو","ب لم ينسني يومك الأيوما",20,"م",2,0],["لئن يرع ملتف الشقائق والكبا","فطرفي مستن الكواكب مرعاه",21,"ا",2,0],["لئن يمتلك يوماً جناحاً يطر به","الى حيث من يهوى وبالوصل يظفر",22,"ر",1,0],["لئن يقنع الجسم مني القليل","فأطماع روحي لا تنتهي",23,"ي",1,0],["لئن يحلُ قدحي في لسان فرّبّما","حلا وهو يحوي ناقع السّمّ مطعمُ",24,"م",1,0],["لئن يُعزى للأسماء يمن وطيرة","وفي اسمي لمولانا الأمير مواهمٌ",25,"م",1,0],["لِئن يكن الدَّهرُ أبدَى العُجَاب","فغفلتكم هذهِ أعجبُ",26,"ب",1,0],["لئن يكن ظِمأُها عِشراً لَقَد تَركت","في طيِّ قَلبي غَليلاً لا الى اجلِ",27,"ل",1,0],["لَئن يَكُن غابَ عن لحظي ففي خلدي","مُصوَّرٌ شخصُهُ والعقلُ ناظرُهُ",28,"ر",2,0],["لَئن يَك عنا سار بالشهم سائرٌ","فَكم من جَميل الذكر عَنهُ يخلد",29,"د",1,0],["لَئن يَطُل بعد بُعدي عنكم أَسفي","فَكَم نَأى صاحبٌ عن صاحب وَوَفى",30,"ف",2,1],["لئن يكن الحمام طواكِ عنا","فذكرك ليس يطويه الحمام",31,"م",1,0],["لَئِن يَرمِ ما مِثلُهُ نابِلُ","وَإِن كَرَّ فَهوَ الفَتى الباسِلُ",32,"ل",1,0],["لئن يفق بسداد الرأي بعضهم","فإنني بقراع الصم فقتهم",33,"م",1,0],["لَئِن يَفُز أَعدائُنا بِالسُفُنِ","وا خَزيَةَ العارِ وَثِقلَ المِحَنِ",34,"ن",1,0],["لَئن يَكُن حَظُكُم شالَت نَعامَتُهُ","فَفي شَبابِ العُلا عَطفٌ وَاِيثارُ",35,"ر",1,0],["لئن يبكه الدينُ الحنيف بعبرةٍ","فقد كانَ للدين الحنيفُ مهندا",36,"د",2,0],["لئن يُمس في الاموات فَرداً فطالما","لعمركَ في الاحياء قد كانَ مفردا",36,"د",2,0],["لِئِن يَترُك بَنو حَربِ بنُ وَدٍّ","عَلى قَتلِ المُزَيَّنِ وَالعَرارِ",37,"ر",1,0],["لئن يك سآها من قبل ظلم","واظلام فبشرها بصح",38,"ح",1,0],["لئن يك غاظ هذا الدهر قوما","فانا اليوم عنه قد رضينا",39,"ن",2,0],["لئن يك تاج الثلج كلل هامه","ففي طيّ أحشاه قد اتقد الجمر",40,"ر",1,0],["لئن ينأ عنا في المقابر من أبي","حميد محياه فقد قام نوره",41,"ر",2,0],["لئن يهلك بنا حمدان يهلك","فصيح العلم والخلق العظيم",42,"م",1,0],["لين يتنفس طاهر الصبح سجيت","مع مزنتي عن موحشات الذيابه",43,"ب",2,0],["لين ينبت حلم ضمتنا حنين","واحظنك صدقٍ تحقق ب الصبر",44,"ر",1,0],["لئن ينكرا قدري فشعري شاهد","يأني رب السبق في الشعر اللسن",45,"ن",1,0],["ليني فقلبي لين القسمات","واستشعري ولهي من النبضاتِ",46,"ت",1,1],["لئِنْ يَدْعُني داعٍ أُلبِّ نِداءَهُ","فحَقُّ بِلادي أن أَهُبَّ مُلبِّيا",47,"ي",2,0]]}