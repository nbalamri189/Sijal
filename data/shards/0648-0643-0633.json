oem926.html",""],[464,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[464,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[493,"كم للصبابة والصبا من منزل","https://www.aldiwan.net/poem67332.html","الكامل"],[505,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[514,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[515,"أبا حسن كدرت ماء صفائي","https://www.aldiwan.net/poem11997.html","الطويل"],[515,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[515,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[515,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[524,"نسب تلاشى في سطوع ضيائه","https://www.aldiwan.net/poem13286.html","الكامل"],[538,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[538,"يا دار نلت العز والتكريما","https://www.aldiwan.net/poem47930.html","عموديه"],[538,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[544,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[551,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[551,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[567,"برزت وأتراب لها عرب","https://www.aldiwan.net/poem69683.html","الكامل"],[567,"متبرم بغنائه","https://www.aldiwan.net/poem69787.html","مجزوء الكامل"],[567,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[573,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[575,"هذا الغرام غرمت آخره","https://www.aldiwan.net/poem2879.html","الخفيف"],[575,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"],[575,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"]],"verses":[["وَكَسَوتُ مَن مورِ المَلامِ جَنانَهُ","قَبلَ العِقابِ فَصارَ فيهِ جَنادِلا",0,"ل",2,0],["وَكَساها الرَّبيعُ حُلَّةَ نَورٍ","نَسَجَتها أَناملُ الأَنواءِ",1,"ا",2,0],["وَكَسا الرَبيعُ رُبوعَها أَنوارَهُ","لَما سَقَتها الغادِياتُ عُهودَها",2,"د",3,0],["وَكَسا الرَبيعُ رُباكِ مِن أَزهارِهِ","حُلَلاً إِذا ما الأَرضُ فاحَ رَبيعُها",3,"ع",3,0],["وَكَسَتهُ أَنفاسُها أَرَجَ ال","نَدِّ فَبِتنا مِن طيبِها في نَعيمِ",4,"م",1,0],["وَكَسَفْتَ يَا شَمْسَ الْمَحَاسِنِ ضَحْوَةً","فَالْيَوْمُ لَيْلٌ وَالضِّياءُ ظَلاَمُ",5,"م",1,0],["وَكَسَا مِنْ نَمَارِقِ السُّنْدُسِ","المْحْضَرِّ دَهْنَاءَ بِالْحَيَا وَرِمَالَه",6,"ل",2,0],["وَكَسَتْ إِيَالَتُكَ اَلْبِلاَدَ وَأَهْلَهَا","ظِلاًّ تَكَفَّلَ بِالْعِبَادِ ظَلِيلُهُ",7,"ل",2,0],["وَكِسرى شَهِنشاهُ الَّذي سارَ مُلكُهُ","لَهُ ما اِشتَهى راحٌ عَتيقٌ وَزَنبَقُ",8,"ق",1,0],["وَكَسَوتُ كاهِلَ حُرَّةٍ مَنهوكَةٍ","بِالفَجرِ حارِيّاً عَديمَ شَوارِ",9,"ر",1,0],["وَكَسَت أَنامِلُكَ اليَراعَ وَشائِعاً","هُنَّ السَحابُ سَقى البِلادَ وَرَوَّضا",10,"ض",2,0],["وَكَسا مَعاطِسَها اللُغامُ وَلُفِّعَت","فيهِ حَواجِبُ عَينِها بغَفائِرِ",11,"ر",1,0],["وَكَسبٍ يَسوءُ الحاسِدينَ اِحتَوَيتُهُ","إِلى أَصل مَالٍ مِن كِرامِ المَكاسِبِ",12,"ب",1,0],["وكسَّر تمثال الصليب وأخرست","نواقيسُ كانت للضلال بمَرْصَدِ",13,"د",1,0],["وكسوتَها بُرد الشباب مُفوّقاً","وشفيتَ ما تشكو من الأوجالِ",14,"ل",1,0],["وكساه أبو الخلائف مروا","ن سناءَ المكارم المأثورا",15,"ر",2,0],["وكستك أنواءُ الربيع مطارفاً","موشيةً بسنا البروق اللمَّع",16,"ع",1,0],["وكسا الدنيا بك الزَّيْ","نَ إلى أخرى إناتِهْ",17,"ت",2,0],["وكَسَوْهُ قوماً لا يَلِيقُ بهِمْ","من ماجد وَسَطٍ وَمِنْ وغْدِ",18,"د",1,0],["وكساك من خِلَعِ القلوبِ محبّةٍ","كمحبةِ الآباءِ للأولادِ",19,"د",1,0],["وكستْ ديارهمُ الريا","ض غرائبَ الوشْي المحبّرْ",20,"ر",1,0],["وكساهُ الخوفَ والذل","لةَ وابتز رياشه",21,"ش",2,0],["وَكَسائِحٍ بَلَغَ المَدينَةَ بَعدَما","ضَلَّ الطَريقَ وَتاهَ في البَيداءِ",22,"ا",2,0],["وَكَسى الخَزُّ جِسمَهُ فَتَباهى","وَحَوى المالَ كيسُهُ فَتَمَرَّد",23,"د",1,0],["وكَسرى الشعر إن أنشدت شعرا","ونطقي القاف واسعة النطاق",24,"ق",1,0],["وَكِسرى وَما خَمَدَت نارهُ","وَيوسُفُ لَو أَنَّهُ لَم يَشِب",25,"ب",1,0],["وَكَسا غَرائِبَ جِدِّهِ","حُلَلاً مِنَ الهَزلِ العُجابِ",26,"ب",1,0],["وَكَسا سَماءَ المِهرَجانِ جَلالَةً","سَيفُ المَنِيَّةِ وَهوَ صَلتٌ يَبرُقُ",27,"ق",1,0],["وَكَسا البِلادَ سَكينَةً مِن أَهلِها","وَوَقى مِنَ الفِتَنِ العِبادَ وَصانا",28,"ن",2,0],["وَكَسَوهُ أَبَدَ الدَه","رِ مِنَ الفَخرِ ثِيابا",29,"ب",2,0],["وَكَساكَ ثَوبَ مَهابَةٍ مِن عِندِهِ","وَأَراكَ وَجهَ شَقيقِكَ القَمقامِ",30,"م",1,0],["وَكُسيتُما زَهرَ الرَبيعِ وَعُشبَهُ","مُتَآلِفينَ بِأَحسَنِ التَأليفِ",31,"ف",1,0],["وكَسَوه من بِدَعِ القريضِ مدائحاً","موشّيةً كبدائعِ الأفوافِ",32,"ف",1,0],["وكَساهُمُ صَفُو النَّجاةِ خَلائِقاً","أصفى من الماءِ الزُّلالِ الصَّافي",32,"ف",2,0],["وكَسَتْ مَفْرِقي عِمامةَ ضَرْبٍ","أُرجُوانيَّةَ الذَّوائبِ تَنْدَى",33,"د",2,0],["وكَستْ أسيافُهُ عاريةً","ذُلّ أهْلِ السبتِ أهلَ الأَحَدِ",34,"د",1,0],["وَكُسيتِ مِن خِلَعِ الحَيا مُستَأسِداً","أُنُفاً يُغادِرُ وَحشُهُ مُستَأسِدا",35,"د",2,0],["وَكَسانا اليَومَ عاراً","حينَ بِتنا وَعُيوبا",36,"ب",2,0],["وكسا الجوَّ دُخاناً سَدَّهُ","وَطَوى أعلامَهُ عن كلِّ عَيْنْ",37,"ن",1,0],["وَكَساها قِخرَ لُؤلُؤَةٍ","لَيسَ فيها سِرُّ مُكتَتِمِ",38,"م",1,0],["وَكَساها الماءُ شَيباً","لَم يَكُن فيهِ وَقار",39,"ر",1,0],["وَكَساهم ثَوْبَ الصَّغارِ وقد","طُلَّت دِماً منهم وصِينَتْ دِمَاءُ",40,"ا",2,0],["وَكَسَتْهُ حُلَلَ الرَّوْضِ حتى","تَوَّجَتْ منها الرُّبَا والهِضابا",41,"ب",2,0],["وَكَسا الرَبيعُ الأَرضَ مِن أَنوارِهِ","وَشياً تَحارُ لِحُسنِهِ الأَبصارُ",42,"ر",1,0],["وكسا الأرضَ خِدْمَةً لكَ يا مَوْ","لاهُ دونَ المُلوكِ خُضْرَ الحريرِ",43,"ر",1,0],["وَكَسَت لَوامِعُهُ جَوانِبَه","قُصَصاً وَكانَ لِأَكمِها سَبَبا",44,"ب",2,0],["وكِسرَى إذ تَقَسَّمَهُ بَنُوهُ","بِأَسَيافٍ كَمَا اقتُسِمَ اللَّحَامُ",45,"م",1,1],["وَكِسَاءٌ لِيَتِيمٍ وَنَدىً","يَسْتَدِرُّ الثَّدْيَ قُوتاً لِلرَّضِيعْ",46,"ع",1,0],["وَكَسَت لَوامِعُهُ جَوانِبَها","قُصَصاً وَكانَ لِأَكمِها سَبَبا",47,"ب",2,0],["وكسا يعربا سموطا من الإبداع","زادت جبينه إشراقا",48,"ق",2,0],["وكسا الأرز حاليات قوافيهِ","وغنى الهوى على قضبانه",49,"ن",2,0],["وكَساها المُقامُ لوناً تحلَّت","فيه من كأْسها كرقَّةِ ذهن",50,"ن",1,0],["وكسبتمو عطف الشعوب، ونلتمو","من أهل مصرَ العوْن والتعضيدا",51,"د",2,0],["وكسا البِلى بأديمه","مَن كان لا يبلى كساؤه",52,"ا",3,0],["وكسا أيا لتك البلاد وأهلها","ظلا تكفل بالعباد ظليله",53,"ل",2,0],["وكَسَوْا كلبهُمُ الخزَّ ومنْ","حولهمْ يلتحفُ الجمعُ العراء",54,"ا",2,0],["وكسا الحشائشَ رونقاً لم تُعطَهُ","وجلا رُواءُ نميره العيدانا",55,"ن",2,0],["وكست جنودهم العواصم فارتدّت","ثوب الحداد وودّعت أعيادها",56,"د",3,0],["وكسوا مناكبها فلا أنجادها","تركوا لقاطنها ولا أغوارها",57,"ر",3,0],["وكسرت احتكار عينيك بالعنف","وأنقذت جيشي المهزوما ..",58,"م",2,0],["وكساك من خلعِ القلوب محبة ً","كمحبة ِ اللآباءِ للأولادِ",59,"د",1,0],["وكَسا الرَّبيعُ رُباكِ في أزهاره","حللاً إذا ما الأرضُ فاح ربيعها",60,"ع",3,0],["وكسا وجوه الأرض روضاً ضاحكا","حاك الرياب ثيابه وأطالا",61,"ل",2,0],["وكَسَونني من بعدِ ثوبِ","الوَصلِ ثوبَ الغَدرِ خَلقا",62,"ق",2,0],["وكسَرتَ قَيدكَ ظافراً","ما أنتَ بعد اليوم عَبدُ",63,"د",1,0],["وَكَساني مَلابِساً أَلبَسَتني","مُذ تَوارى مِنَ الأَسى جِلبابا",64,"ب",2,0],["وَكَسَوتَهُم في السِلمِ غَيرَ مُدافِعٍ","أَضعافَ ما سَلَبَت سُيوفُكَ في الوَعا",65,"ع",2,0],["وكسوتها النعماء من كل حسن","يصدّ لمرآها الشجاع كما الخال",66,"ل",1,0],["وكسا أفكارهم معرفةً","عَظُمَت هِمَّتُهَا عمَن سواه",67,"ا",2,0],["وَكَسَوْتَنِي وَالْمَكْرُمَاتُ تَقُولُ لِي","اِفْخَرْ بِأَنَّكَ مُذْ كُسِيتَ كُسِينا",68,"ن",2,0],["وكس جفاك بالهجران ملء","أجرعها بلا ذنب يكون",69,"ن",1,0],["وَكَسا مَرابِعَنا الرَبيعُ مطارِفاً","فَلبِسنَها لَما رَأينكَ مُقبِلا",70,"ل",2,0],["وَكَسَتهُ أخيلةِ الغُصونِ غَدائِراً","أَبداً يُلاعِبُها الهَوا السَيَّارُ",71,"ر",1,0],["وكسبتُ مالا لو يُرَفِّره","جَدْواىَ لم أعرفْ له طرفا",72,"ف",2,0],["وكسَرتُ كأسيَ بَعدَما","ذابَت بأحشائي لحومي",73,"ي",1,0],["وكست من ربوة مجدبة","حلل الزهر وحلت من قمم",74,"م",1,0],["وكستها بدروع دونها","كل سهم وحسام ينقصم",74,"م",1,0],["وكسى الربيع الأرض حلة سندس","بالوشي حاكتها يد الانواء",75,"ا",2,0],["وكسر فؤادي صح عندك جبهر","ولا غرو ان طابقت كسري بالجبر",76,"ر",1,0],["وكسوت آل النيربي من الثنا","حلل الفخار لها طرازة معلم",77,"م",1,0],["وَكَسَتكَ أَنواعَ المَحا","سنِ أُسرةٌ سكنوا حماك",78,"ك",1,0],["وكَسَوْنا رِيشاً جناحَيْك لمّا","عِريا مِن قوادمٍ وخوافِ",79,"ف",1,0],["وكسا الأرض بعد محل بروداً","من أزاهير غضةٍ وحشيش",80,"ش",1,0],["وَكَسَوتُكُم حُلَلاً مُفوَّفَةً","بِالحَمدِ مِن نَظمي وَمِن نَثري",81,"ي",1,0],["وَكَسَا بِلاَدَكَ مِنْ سَنَاكَ مُلاَءَةً","وَلَقَدْ كَسَاهَا قَبْلَكَ الْحِنْدِيسُ",82,"س",1,0],["وَكَسا روحك منه رحمة","وَصَلاة تَرتَضيها وَسَلاما",83,"م",2,0],["وكسوتها من رقم كفك حلّةً","تحكي الصباح مطرزاً بدُجاهُ",84,"ا",2,0],["وَكَسا أَعطافَ هاتيك الرُبى","حُللاً طرَّزَها الغيثُ اِنسجاما",85,"م",2,0],["وَكسوتُها من وصف ودِّك حُلَّةً","هَزَّت لها عِطف المحلّى المكتسي",86,"س",2,0],["وَكَسا معاطِفَنا بجُنح ظَلامه","مسكيَّ بُردٍ بالنُجوم مُدنَّرا",87,"ر",2,0],["وكَسَتْ وَحلَّتْ سمحةً أشجارها","فَجَلَتْ عرائسها بوشيٍ فاخر",88,"ر",1,0],["وكسب علو في علومٍ إذا أتى","إلى بابه ألقت حجاب حجازه",89,"ه",1,0],["وكسر إبراهيم أصنام قومه","وأبقى كبيراً كي يروحوا بخزية",90,"ه",1,0],["وَكَستها أَبرادَ وشي صفيّا","تٍ حسانِ الترقيم والألوانِ",91,"ن",1,0],["وكسيت كالطاووس ريشا لامعا","متلألئا ذا رونق وبريق",92,"ق",1,0],["وَكَسَتهُ السِنونَ شَيباً وَضَعفاً","وَطَوَت خَطوَهُ بِقَيدٍ دِخالِ",93,"ل",1,0],["وكساها الفن الإلهي ثوبا","سرق الزهر والسنا ألوانه",94,"ن",2,0],["وكَسبْتَ حُسْنَ الذّكرِ في الدُّنيا التي","تَفْنَى ومَن يَفعَلْ كفِعْلك يُذْكَر",95,"ر",1,0],["وكسا اللّهُ ذلك العهَدَ رَوْضاً","وكسا اللّهُ ذلك الرَّوضَ وَرْدا",96,"د",2,0],["وَكَساهُ الدَّهرُ سِبّاً ناصِعاً","وَتَحَنّى الظَّهرُ مِنهُ فَأُطِرْ",97,"ر",1,0],["وكَساهُ حَيدرَةٌ قُرُو","ناً طُلنُ عَن قَرنَي أبِيهِ",98,"ي",2,0],["وكسوف شمسٍ مع خسوف البدر وال","أفلاك تطوى والكواكب تغرب",99,"ب",1,0],["وَكَسلتِ عَن تَحصيلك العلم الَّذي","إِن فاتَ حَيّاً فَهُوَ كَالمَعدوم",100,"م",1,0],["وكسا القلب حلة حقها الشك","ر بسر المقال أو إعلانك",101,"ك",1,0],["وكسوتَه شَرفاً إذا","ما طاوَلَتْهُ الشُّهْبُ طالاَ",102,"ل",2,0],["وكسى بغداد في أيَّامه","حُلَّةَ الفخر جمال