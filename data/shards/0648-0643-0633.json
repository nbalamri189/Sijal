{"poems":[[53,"إن لم أطع همما وأعص عواذلا","https://www.aldiwan.net/poem29863.html","الكامل"],[63,"هذه دارها على الخلصاء","https://www.aldiwan.net/poem45779.html","الخفيف"],[3,"جازت مُلمات الزمان حدوده","https://www.aldiwan.net/poem147.html",""],[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[3,"هذه نار عبلة يا نديمي","https://www.aldiwan.net/poem203.html",""],[77,"العمر نوم والمنى أحلام","https://www.aldiwan.net/poem36107.html","الكامل"],[77,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[77,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[71,"لله قاضي ديندوز فإنه","https://www.aldiwan.net/poem3928.html","الكامل"],[35,"تلهو فتختضع المطي أمامها","https://www.aldiwan.net/poem39141.html","الكامل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[83,"ضريح أمير المسلمين محمد","https://www.aldiwan.net/poem54319.html","الطويل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[37,"أورثته الحصان أم هشام","https://www.aldiwan.net/poem7072.html","الخفيف"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"ما لمن حسنه الله وأعلى درجاته","https://www.aldiwan.net/poem8696.html","مجزوء الرمل"],[51,"إن أسرق الشعراء شعرهم","https://www.aldiwan.net/poem10002.html","أحذ الوافر"],[51,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[51,"وضعت كقضبان اللجين","https://www.aldiwan.net/poem64035.html","مجزوء الكامل"],[51,"إن كفيك لقفل","https://www.aldiwan.net/poem64924.html","مجزوء الرمل"],[91,"تلك السنون الغاربات ورائي","https://www.aldiwan.net/poem8726.html","عموديه"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[85,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[85,"فديناه من زائر مرتقب","https://www.aldiwan.net/poem8090.html","المتقارب"],[85,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[43,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[45,"حييتما من مربع ومصيف","https://www.aldiwan.net/poem65158.html","الطويل"],[61,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[31,"قد نبا بالقلب منها","https://www.aldiwan.net/poem42610.html","مجزوء الرمل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[52,"لم ينم همي ولم أنم","https://www.aldiwan.net/poem26680.html","المديد"],[52,"ونديم قمرته","https://www.aldiwan.net/poem26983.html","مجزوء الرمل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[48,"طاب الزمان وأورق الأشجار","https://www.aldiwan.net/poem63309.html","الكامل"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21140","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2231","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141923","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[77,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[99,"رصاصة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=36624",""],[51,"لا زلتَ أبيضَ غُرَّة ٍ وأيادِ","https://www.poetsgate.com/ViewPoem.aspx?id=27694",""],[3,"قف بالمنازل ان شجتك ربوعها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10711&r=&rc=65",""]],"verses":[["وَكَسَوتُ مَن مورِ المَلامِ جَنانَهُ","قَبلَ العِقابِ فَصارَ فيهِ جَنادِلا",0,"ل",2,0],["وَكَساها الرَّبيعُ حُلَّةَ نَورٍ","نَسَجَتها أَناملُ الأَنواءِ",1,"ا",2,0],["وَكَسا الرَبيعُ رُبوعَها أَنوارَهُ","لَما سَقَتها الغادِياتُ عُهودَها",2,"د",3,0],["وَكَسا الرَبيعُ رُباكِ مِن أَزهارِهِ","حُلَلاً إِذا ما الأَرضُ فاحَ رَبيعُها",3,"ع",3,0],["وَكَسَتهُ أَنفاسُها أَرَجَ ال","نَدِّ فَبِتنا مِن طيبِها في نَعيمِ",4,"م",1,0],["وَكَسَفْتَ يَا شَمْسَ الْمَحَاسِنِ ضَحْوَةً","فَالْيَوْمُ لَيْلٌ وَالضِّياءُ ظَلاَمُ",5,"م",1,0],["وَكَسَا مِنْ نَمَارِقِ السُّنْدُسِ","المْحْضَرِّ دَهْنَاءَ بِالْحَيَا وَرِمَالَه",6,"ل",2,0],["وَكَسَتْ إِيَالَتُكَ اَلْبِلاَدَ وَأَهْلَهَا","ظِلاًّ تَكَفَّلَ بِالْعِبَادِ ظَلِيلُهُ",7,"ل",2,0],["وَكِسرى شَهِنشاهُ الَّذي سارَ مُلكُهُ","لَهُ ما اِشتَهى راحٌ عَتيقٌ وَزَنبَقُ",8,"ق",1,0],["وَكَسَوتُ كاهِلَ حُرَّةٍ مَنهوكَةٍ","بِالفَجرِ حارِيّاً عَديمَ شَوارِ",9,"ر",1,0],["وَكَسَت أَنامِلُكَ اليَراعَ وَشائِعاً","هُنَّ السَحابُ سَقى البِلادَ وَرَوَّضا",10,"ض",2,0],["وَكَسا مَعاطِسَها اللُغامُ وَلُفِّعَت","فيهِ حَواجِبُ عَينِها بغَفائِرِ",11,"ر",1,0],["وَكَسبٍ يَسوءُ الحاسِدينَ اِحتَوَيتُهُ","إِلى أَصل مَالٍ مِن كِرامِ المَكاسِبِ",12,"ب",1,0],["وكسَّر تمثال الصليب وأخرست","نواقيسُ كانت للضلال بمَرْصَدِ",13,"د",1,0],["وكسوتَها بُرد الشباب مُفوّقاً","وشفيتَ ما تشكو من الأوجالِ",14,"ل",1,0],["وكساه أبو الخلائف مروا","ن سناءَ المكارم المأثورا",15,"ر",2,0],["وكستك أنواءُ الربيع مطارفاً","موشيةً بسنا البروق اللمَّع",16,"ع",1,0],["وكسا الدنيا بك الزَّيْ","نَ إلى أخرى إناتِهْ",17,"ت",2,0],["وكَسَوْهُ قوماً لا يَلِيقُ بهِمْ","من ماجد وَسَطٍ وَمِنْ وغْدِ",18,"د",1,0],["وكساك من خِلَعِ القلوبِ محبّةٍ","كمحبةِ الآباءِ للأولادِ",19,"د",1,0],["وكستْ ديارهمُ الريا","ض غرائبَ الوشْي المحبّرْ",20,"ر",1,0],["وكساهُ الخوفَ والذل","لةَ وابتز رياشه",21,"ش",2,0],["وَكَسائِحٍ بَلَغَ المَدينَةَ بَعدَما","ضَلَّ الطَريقَ وَتاهَ في البَيداءِ",22,"ا",2,0],["وَكَسى الخَزُّ جِسمَهُ فَتَباهى","وَحَوى المالَ كيسُهُ فَتَمَرَّد",23,"د",1,0],["وكَسرى الشعر إن أنشدت شعرا","ونطقي القاف واسعة النطاق",24,"ق",1,0],["وَكِسرى وَما خَمَدَت نارهُ","وَيوسُفُ لَو أَنَّهُ لَم يَشِب",25,"ب",1,0],["وَكَسا غَرائِبَ جِدِّهِ","حُلَلاً مِنَ الهَزلِ العُجابِ",26,"ب",1,0],["وَكَسا سَماءَ المِهرَجانِ جَلالَةً","سَيفُ المَنِيَّةِ وَهوَ صَلتٌ يَبرُقُ",27,"ق",1,0],["وَكَسا البِلادَ سَكينَةً مِن أَهلِها","وَوَقى مِنَ الفِتَنِ العِبادَ وَصانا",28,"ن",2,0],["وَكَسَوهُ أَبَدَ الدَه","رِ مِنَ الفَخرِ ثِيابا",29,"ب",2,0],["وَكَساكَ ثَوبَ مَهابَةٍ مِن عِندِهِ","وَأَراكَ وَجهَ شَقيقِكَ القَمقامِ",30,"م",1,0],["وَكُسيتُما زَهرَ الرَبيعِ وَعُشبَهُ","مُتَآلِفينَ بِأَحسَنِ التَأليفِ",31,"ف",1,0],["وكَسَوه من بِدَعِ القريضِ مدائحاً","موشّيةً كبدائعِ الأفوافِ",32,"ف",1,0],["وكَساهُمُ صَفُو النَّجاةِ خَلائِقاً","أصفى من الماءِ الزُّلالِ الصَّافي",32,"ف",2,0],["وكَسَتْ مَفْرِقي عِمامةَ ضَرْبٍ","أُرجُوانيَّةَ الذَّوائبِ تَنْدَى",33,"د",2,0],["وكَستْ أسيافُهُ عاريةً","ذُلّ أهْلِ السبتِ أهلَ الأَحَدِ",34,"د",1,0],["وَكُسيتِ مِن خِلَعِ الحَيا مُستَأسِداً","أُنُفاً يُغادِرُ وَحشُهُ مُستَأسِدا",35,"د",2,0],["وَكَسانا اليَومَ عاراً","حينَ بِتنا وَعُيوبا",36,"ب",2,0],["وكسا الجوَّ دُخاناً سَدَّهُ","وَطَوى أعلامَهُ عن كلِّ عَيْنْ",37,"ن",1,0],["وَكَساها قِخرَ لُؤلُؤَةٍ","لَيسَ فيها سِرُّ مُكتَتِمِ",38,"م",1,0],["وَكَساها الماءُ شَيباً","لَم يَكُن فيهِ وَقار",39,"ر",1,0],["وَكَساهم ثَوْبَ الصَّغارِ وقد","طُلَّت دِماً منهم وصِينَتْ دِمَاءُ",40,"ا",2,0],["وَكَسَتْهُ حُلَلَ الرَّوْضِ حتى","تَوَّجَتْ منها الرُّبَا والهِضابا",41,"ب",2,0],["وَكَسا الرَبيعُ الأَرضَ مِن أَنوارِهِ","وَشياً تَحارُ لِحُسنِهِ الأَبصارُ",42,"ر",1,0],["وكسا الأرضَ خِدْمَةً لكَ يا مَوْ","لاهُ دونَ المُلوكِ خُضْرَ الحريرِ",43,"ر",1,0],["وَكَسَت لَوامِعُهُ جَوانِبَه","قُصَصاً وَكانَ لِأَكمِها سَبَبا",44,"ب",2,0],["وكِسرَى إذ تَقَسَّمَهُ بَنُوهُ","بِأَسَيافٍ كَمَا اقتُسِمَ اللَّحَامُ",45,"م",1,1],["وَكِسَاءٌ لِيَتِيمٍ وَنَدىً","يَسْتَدِرُّ الثَّدْيَ قُوتاً لِلرَّضِيعْ",46,"ع",1,0],["وَكَسَت لَوامِعُهُ جَوانِبَها","قُصَصاً وَكانَ لِأَكمِها سَبَبا",47,"ب",2,0],["وكسا يعربا سموطا من الإبداع","زادت جبينه إشراقا",48,"ق",2,0],["وكسا الأرز حاليات قوافيهِ","وغنى الهوى على قضبانه",49,"ن",2,0],["وكَساها المُقامُ لوناً تحلَّت","فيه من كأْسها كرقَّةِ ذهن",50,"ن",1,0],["وكسبتمو عطف الشعوب، ونلتمو","من أهل مصرَ العوْن والتعضيدا",51,"د",2,0],["وكسا البِلى بأديمه","مَن كان لا يبلى كساؤه",52,"ا",3,0],["وكسا أيا لتك البلاد وأهلها","ظلا تكفل بالعباد ظليله",53,"ل",2,0],["وكَسَوْا كلبهُمُ الخزَّ ومنْ","حولهمْ يلتحفُ الجمعُ العراء",54,"ا",2,0],["وكسا الحشائشَ رونقاً لم تُعطَهُ","وجلا رُواءُ نميره العيدانا",55,"ن",2,0],["وكسرت احتكار عينيك بالعنف","وأنقذت جيشي المهزوما ..",56,"م",2,0],["وكساك من خلعِ القلوب محبة ً","كمحبة ِ اللآباءِ للأولادِ",57,"د",1,0],["وكَسا الرَّبيعُ رُباكِ في أزهاره","حللاً إذا ما الأرضُ فاح ربيعها",58,"ع",3,0]]}