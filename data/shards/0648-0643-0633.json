َ غَادَرَتِ الحَسودَ كَليما",134,"م",2,0],["وكسَا الكونَ سَوَاد","فَهوَ سُؤلِي والمُرَاد",135,"د",1,0],["وكساه من حُلَلِ القبول مجاسداً","ما كنّ من وشْىٍ ومن إستَبْرَقِ",136,"ق",1,0],["وكسوتَ مرتبتي هناك فضيلةً","تَبقى على عَقِبِي بقاءَ المُسْنَدِ",137,"د",1,0],["وَكَسَبْتُها عمداً بلا تِرَةِ","إلاّ هَوايَ ومثلُهُ وُتِرَا",138,"ر",2,0],["وكساهُ ثَوْبَ مشيْبِهِ","في عُنْفُوانِ شَبَابِهِ",139,"ب",2,0],["وكسوتَه بالميل ثوب مناقب","تبقى عواقبهن في أعقابِه",140,"ب",2,0],["وَكَسا الوَرى العَدلَ المُبينَ وَقَبلَهُ","سُلِبوا بِجَورِ وُلاتِهِم تِلكَ الكُسا",141,"س",2,0],["وكسا خدُّه نُحولاً فأَضْحَى","مِثْلَ ما أَشْتَهِيهِ خَدّاً أَسِيلاَ",142,"ل",2,0],["وكسوتَني خِلعاً هزز","تُ بِهِنَّ عِطْفِي كالصَّفيح",143,"ح",1,0],["وكسوتَني خِلعاً عَذَرتُ مَعاطِفي","لما ازْدَهاها التِّيهُ مِنْ إِعْجَابِها",144,"ب",3,0]]}