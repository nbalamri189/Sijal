{"poems":[[57,"ألا تعجبون كما أعجب","https://www.aldiwan.net/poem26533.html","المتقارب"],[11,"ألا سبيل إلى مال يعارضني","https://www.aldiwan.net/poem252.html",""],[53,"لا أسأل الله في جهمان مسألة","https://www.aldiwan.net/poem7952.html","البسيط"],[87,"لقد نقل الراوون عني حكاية","https://www.aldiwan.net/poem7570.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[78,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67358","البسيط"],[92,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[382,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77571","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59652","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61181","الطويل"],[1340,"","https://poetry.dctabudhabi.ae/diwan/poem/105885","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103031","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125862","البسيط"],[4299,"","https://poetry.dctabudhabi.ae/diwan/poem/203768","الطويل"],[5150,"إلام الصمت يا عرب ..؟؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202873",""],[5277,"سيدةُ الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=192265",""],[5376,"تُهانُُ القدسُ ما فيكم مروءةْ","https://www.poetsgate.com/ViewPoem.aspx?id=203293",""],[6068,"القلب يعلم في \"الأحلام\" مالكه -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175873",""],[6093,"لو مُثِّلَ الشَّوقُ في عينيَ إنسانا ( البسيط )","https://www.poetsgate.com/ViewPoem.aspx?id=176002",""]],"verses":[["أَلا اَعتِب فَدَيتُكَ يا مُذنِبُ","فَقَد جِئتُ أَبكي وَأَستَعتِبُ",0,"ب",1,0],["أَلا أُعانُ عَلى جودي بِمَيسَرَةٍ","فَلا يَرُدُّ نَدى كَفَّيَّ إِقتاري",1,"ي",1,0],["إلّا إعارَته عقلاً يُريه به","من بُغضه ما يراه غيرُهُ وكفى",2,"ا",1,0],["ألا اعتذروا لي عنده فأنا الذي","صفعت بصدغي كفه فتألما",3,"م",2,0],["أَلا أَعتِبُ اِبنَ العَمِّ إِن كانَ ظالِماً","وَأَغفِرُ عَنهُ الجَهلَ إِن كانَ أَجهَلا",4,"ل",2,0],["إلا اعتصاماً لضيغمٍ هَصِرٍ","تميدُ شمُّ الجبالِ من وَجَلِهْ",5,"ل",2,0],["أَلا اعْتَبَرْتُمْ بِخَيْلِ اللهِ إذ قَتَلَتْ","أهْلَ القَلِيبِ وَمَنْ أَلْقَيْنَهُ فِيها",6,"ي",3,0],["ألا أعينٌ تُلقى على الشَّعْبِ هاوياً","إلى حَمْأةِ الإدقاعِ نظرةَ راحم",7,"م",1,0],["إلا اعتقادا وحبا بالغا ورضى","بقسمة الله جل الواحد الصمد",8,"د",1,0],["إِلّا اِعتِرافاً فَما المَغبونُ مَن جُحِدَت","آلاؤُهُ إِنَّما المَغبونُ مَن جَحَدا",9,"د",2,0],["أَلا اِعجبوا مِن أوّلٍ قد خَتما","محمّدٌ رحمةُ كلِّ العالمين",10,"ن",1,0],["ألا اعجبْ لنفسٍ فوزُها أجرُ فتكها","مُخصَّصةً دون النفوس الفواتك",11,"ك",1,0],["أَلا اعترفوا لي واحداً بَعد واحِدٍ","وَلا يَخشَ مِنكُم واحِدٌ هَتَك سرِّه",12,"ر",2,0],["ألا أعدتِ الطرف نحو متَّيم","قلق الفؤاد مُدله متهالك",13,"ك",1,0],["ألا أعيش بخير كَرّةً فأرى","نصراً لقوم لهم في الخصم كَرّاتُ",14,"ت",1,0],["أَلا اعجبْ لذي نابين يَبلع كُلما","يَمر بِهِ مِما يَليق بِمثله",15,"ه",1,1],["ألا اعلَم أَخي أَنَّ الفَصاحةَ زَيَّنَت","تِلاوةَ تالٍ أدمَنَ الدرسِ للذِكرِ",16,"ر",1,0],["إلا اعترافي بالذنوب وأنني","متمسك بولاء آل محمد",17,"د",1,0],["أَلا اعتبارٌ لهم فيما يحيط بهم","من سود موماو أو من صفر فتمان",18,"ن",1,0],["ألا اعلم بان الموت كأس مدارة","على كل من قد راح فيها ومن غدا",19,"د",2,1],["ألا اعتصموا بحبلِ","اللهِ ينصُرْكُم بما يهبُ",20,"ب",1,0],["إلاّ أعدادٌ تغرقني","والعدُّ يخالفُ أصفارهْ",21,"ر",2,0],["ألا اعتصموا بحبل الله خيراً","تنالوا عزَّةً منه وضيئةْ",22,"ا",2,0],["ألا اعلمي صدق قولي دون لجلجة","أرسلت فيه غراما ملء قاريها",23,"ي",3,0],["ألا اعتبر حالنا والحالُ واعظةٌ","وأبْلَغُ الوعظِ ما تلقاهُ إنسانا",24,"ن",2,0]]}