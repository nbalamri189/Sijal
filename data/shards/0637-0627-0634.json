{"poems":[[55,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[55,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[95,"ذنبها أنها رأت","https://www.aldiwan.net/poem9153.html","مجزوء الخفيف"],[90,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[93,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[107,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[107,"سر يا أسامة ما لجيشك هازم","https://www.aldiwan.net/poem43570.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[98,"الأجنحة المحترقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66336&r=&rc=15",""],[189,"لو كان هجرك يبقيني إلى أمد","https://www.aldiwan.net/poem14501.html","البسيط"],[406,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[409,"العلم في قول لا إله إلا الله","https://www.aldiwan.net/poem33366.html","البسيط"],[409,"عذرا على ما جرى مني من الزلل","https://www.aldiwan.net/poem33488.html","البسيط"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[592,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[795,"","https://poetry.dctabudhabi.ae/diwan/poem/203857","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126187","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64826","المنسرح"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109073","الكامل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117101","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141324","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66309","الرجز"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199821","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27650","الكامل"],[3135,"","https://poetry.dctabudhabi.ae/diwan/poem/105701","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85195","الرجز"],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5277,"حديثُ الدموعِ..","https://www.poetsgate.com/ViewPoem.aspx?id=202790",""],[5542,"شموخ الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=10070",""],[5725,"وتمنعي","https://www.poetsgate.com/ViewPoem.aspx?id=195411",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[6129,"يفدي حذاءَك باعةُ الأبقارِ","https://www.poetsgate.com/ViewPoem.aspx?id=13877",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""]],"verses":[["طاشَت رُؤوسُهُمُ حَتّى جَعَلتَ لَهُم","مَناصِباً مِن أَنابيبَ القَنا الذُبُلِ",0,"ل",1,0],["طاشَت سِهامُكُمُ وَفارَقَ نَزعَهُ","سَهمٌ إِلى قَلبِ العَدوِّ سَديدُ",1,"د",1,0],["طاش حكم لحاكمٍ","جانب العدل والنوى",2,"و",2,0],["طاشت حصاة العلا لما نعيت لها","وكل ميزان علم بالأسى سالا",3,"ل",2,0],["طاشَت حُلومُ المالِكينَ فَذاهِلٌ","لا يَستَفيق وَحائِرٌ لا يَهتَدي",4,"د",2,0],["طاشتْ به تُرّهاتُ اللابسين له","ثَوبَ الرِّياءِ وغرّته التهاويلُ",5,"ل",1,0],["طاشَ الرَجاءُ بِهِم فَالأَمرُ مُضطربٌ","فَوضى بِأَرجائِهِ وَالصَدعُ مُنشَعِبُ",6,"ب",1,0],["طَاشتْ لمصرعِهِ عُقولٌ رُجَّحٌ","وَوَهَتْ قُوىً مشدودةٌ وعَزائِمُ",7,"م",1,0],["طاش الزمامُ فلا السحابُ مقاربٌ","لكما ولا الجبَلُ الأشمُّ مُداني",8,"ن",2,0],["طاش الزّمام فلا السّحاب مقرب","لكما ولا الجبل الأشمّ مداني",9,"ن",2,0],["طاشَتْ سُرورا به الدنيا فوَقَّرها","بحلمه فلذاك الأرضُ لم تَمِد",10,"د",1,0],["طاشت الألبابُ حتى سمعو","ما تلا الصدِّيقُ من قولٍ مُبين",11,"ن",1,0],["طاشت سجلات كل معصية","إن قابلت لا إله إلا اللّه",12,"ل",2,0],["طاشت لجهلي أقلامي ببارقة","جنت علي فآه ليت لم أفل",13,"ل",1,0],["طاشَ العَقَنْقَلُ في ميدانِ حكمتِهِ","على أولِي الزُّورِ حتَّى رَهبةً فاءوا",14,"ا",1,0],["طاشت حلوم ذوي الألباب وانصدعت","منا القلوب لهذا الخطب إذ عظما",15,"م",2,0],["طاش الفؤاد فليت شعري هل يرى","بقراره هذا الفؤاد الطائشُ",16,"ش",1,1],["طاشت لهُ لبُّ الرجال فبعضهم","خرس وبعضهمو له قد أقعدا",17,"د",2,0],["طاش وقَاري لهُ وأَيُّ فَتَىً","فازَ بما نِلْتُهُ فَلَمْ يَطِشِ",18,"ش",1,0],["طاشت رصاصته ولم يك فوزه","إِلا على الطِرف الذي قد أجفلا",19,"ل",2,0],["طاشت حلومهم والبغى مرتعه","وخم فعمت سماء المغرب الظلم",20,"م",1,0],["طاشت عن الهدف الأسمى سهامهم","ولم ينيلوا بني الأوطان أوطارا",21,"ر",2,0],["طاش بك الجهل إذا صوبته","إن الخصوم نابذوك اللقطا",22,"ط",2,0],["طاش بغير حبه موحّد","فإنه كان به مشترطا",22,"ط",2,0],["طاش فكري طيش لطّام البحر","والهوى شرعي تعلّي به عبور",23,"ر",1,0],["طاشتْ عقول ذوي النُّهى من سيره","لما أتاه محرِّضاً ومنشطا",24,"ط",2,0],["طاشت له أحلامه ولو أنه","في رقدة لارتاع في أحلامه",25,"م",2,0],["طاشت أو الأفلاك لا يطيشُ","دامت ودام في صفاء العمرِ",26,"ر",1,0],["طاشت عقول الكل حول ذاته","وإنما جالوا لدى صفاته",27,"ه",1,0],["طاش اللبيب لها وجاش مخافة","قلب المنحد ذي الأناه القلب",28,"ب",1,0],["طاشا وطار بحبوتي حلميهما","قسراً هناك جناح عنقا مغرب",28,"ب",1,0],["طاشَ الصَّوابُ منَ الضَّلالِ وأَهْلِهِ","الحِقْدُ غَرسٌ ... ماؤُهُ البَغْضاءُ",29,"ا",2,0],["طاشتْ سهامُ الوجدِ حولَ مشاعري","فغدوتُ فلكاً تاهَ بالأنواءِ",30,"ا",2,0],["طاشت الألبابُ حتى سمعوا","ما تلا الصدِّيقُ من قولٍ مُبين",31,"ن",1,0],["طاشت بنا مثل الصغار قلوبنا","وتماجنت احلامنا كالجهّلِ",32,"ل",1,0],["طاشتْ بها الطرقاتُ.. فاختصرتْ لها","نهجَ المنايا للسيادة مهيعا",33,"ع",2,0],["طاشت عقولكمو أمثل محمد","تلد النساء بسائر الأمصارِ؟",34,"ر",1,0],["طاش سهم العقول عنك اختبارا","كيف تقوى على معانيك فرزا",35,"ز",2,0]]}