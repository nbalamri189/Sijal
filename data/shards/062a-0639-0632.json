,[5273,"في مقتل الطفلة ب تَعِز","https://www.poetsgate.com/ViewPoem.aspx?id=215878",""],[5421,"تعز","https://www.poetsgate.com/ViewPoem.aspx?id=212208",""],[5431,"إلى تعِزّ...","https://www.poetsgate.com/ViewPoem.aspx?id=190053",""],[5431,"تعِزّ...الحبية تعزّ...حماها الله","https://www.poetsgate.com/ViewPoem.aspx?id=190354",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[5957,"يا جميل الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=12088",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6115,"تعلمت من سود الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=180458",""],[572,"تَعَزَّ أَبا بكرٍ المرتَجَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9367&r=&rc=224",""]],"verses":[["تَعَزَّ ما اِسطَعتَ فَالدُنيا مُفارِقَةٌ","وَالعُمرُ يُعنِقُ وَالمَغرورُ في شَغَلِ",0,"ل",1,0],["تَعَزَّ أَمينَ اللَهِ وَاِستَأنِفِ الأَسى","فَفي الأَجرِ مِن عُظمِ المُصابِ بَديلُ",1,"ل",1,0],["تَعَزَّ أَميرَ المُؤمِنينَ صَريمَةً","مِنَ العَزمِ عَن ماضي الصَرائِمِ أَروَعِ",2,"ع",1,0],["تَعَزَّ أَبا عَلِيٍ إِنَّ خَطباً","عَلى العِلّاتِ يَبلُغُ ما أَرادا",3,"د",2,0],["تَعَزُّزُ الحُبَّ لَهُ ذِلَّةٌ","وَناقِصُ الحُبِّ إِلى زائِدِ",4,"د",1,0],["تَعَزَّ فَما كُلُّ المَصائِبِ قادِمٌ","عَليكَ وَلا كُلُّ النَوائِبِ عائِدُ",5,"د",1,0],["تَعَزَّيتَ مُستَأنِساً بِالبُعادِ","وَاللَيثُ في كُلِّ أَرضٍ غَريبُ",6,"ب",1,0],["تعَزَّ وَهَوِّن عَلَيكَ الأُمورا","عَساكَ تَرى بَعدَ حُزنٍ سُرورا",7,"ر",2,1],["تعَزَّ فَما ثَمَّ منْ كائِنٍ","يُصاحِبُهُ الكوْنُ إلا فَسَدْ",8,"د",1,0],["تَعَزَّ بِحَوّاءَ الَّتي الخَلقُ نَسلُها","فَمِن دونِها في العَصرِ يَتبَعُهُ العَصرُ",9,"ر",1,0],["تَعِزُّ عَلَيها رَيبَتي وَيَسوؤُه","بُكاهُ فَتَثني الجيدَ أَن يَتَضَوَّعا",10,"ع",2,0],["تَعِزُّ العُرُوبَةَ مَا تَلْبَثُونَ","عَلَى الخَيْرِ وَالشَّرِّ عِقْداً نَظِيمَا",11,"م",2,0],["تَعَزَّ فَكَم لَكَ مِن أُسوَةٍ","تُبَرِّدُ عَنكَ غَليلَ الحَزَن",12,"ن",1,1],["تَعَزَّيتُ عَن مَيٍّ وَقَد رَشَّ رَشَّةً","مِنَ الوَجدَ جَفنا مُقلَتي وَحُدورُها",13,"ر",3,0],["تُعِزُّ ضِعافَ الناسِ عِزَّةُ نَفسِهِ","وَيَقطَعُ أَنفَ الكِبرِياءِ عَنِ الكِبرِ",14,"ر",1,0],["تَعَزَّت أُمُّ حَزرَةَ ثُمَّ قالَت","رَأَيتُ الوارِدينَ ذَوي اِمتِناحِ",15,"ح",1,0],["تعزَّ بموت الصِّيد من آل مُصْعب","تجدهُم أُسىً إن شئت أو قدواتِ",16,"ت",1,0],["تعزَّوا وقد نابتهُمُ كلُّ نوبةٍ","وماتوا فعزَّوا كلَّ ذي حسراتِ",16,"ت",1,0],["تَعزَّ حِجاً قبل السُّلُوِّ على المدى","فمثلك للحسنى من الأمر عامدُ",17,"د",1,0],["تعزيتَ عمن أثمرتْك حياتُهُ","ووشْكُ التعزي عن ثمارك أجدر",18,"ر",1,0],["تعزّ عن الماضي وِإن هصرتْ به","يدُ الدهر غصناً من غصونِكم غضّا",19,"ض",2,0],["تَعَزَّزَ بَعضُ الناسِ فَازدادَ بَهجَةً","وَزادَ فُؤادي مِن تَباعُدِهِ وَحشا",20,"ش",2,1],["تَعَزَّ وَإِن كانَت عَلَيكَ كَريمَةً","لَعَلَّكَ مِن رِقّ لبَثنَةَ تَعتِقُ",21,"ق",1,0],["تُعَزّي اليَمانينَ في سَيفِهِم","وَتَأخُذُ حِصَّتَها في الحَزَن",22,"ن",1,0],["تعزَّ أخا العُرَيْبِ فما بنجدٍ","لنا أخرى الليالي من قَرارِ",23,"ر",1,0],["تَعَزَّ أَميرَ المُؤمِنينَ فَإِنَّها","مُلِمّاتُ أَحداثِ الزَمانِ الفَوادِحِ",24,"ح",1,0],["تَعَزَّزَ بِاللَهِ مُستَقرِباً","مَدى الحَقِّ يَسري إِلى قَصدِهِ",25,"د",2,0],["تَعَزَّ بِالصَبرِ وَاِستَبدِل إِسىً بِأَسىً","فَالشَمسُ طالِعَةٌ إِن غُيِّبَ القَمَرُ",26,"ر",1,0],["تَعَزَّ فَإِنَّ السَيفَ يَمضي وَإِن وَهَت","حَمائِلُهُ عَنهو وَخَلّاهُ قائِمُه",27,"م",2,0],["تَعزَّيْتُ عن نَيْلِ الثَّراءِ بِفَضْلِهِ","وما مُعْدِمٌ أثرى من الفَضْلِ مُعْدِمُ",28,"م",1,0],["تَعَزَّ فإنّا للحِمامِ نُفوسُنا","كذاك الغواني للحِمامِ نفوسُها",29,"س",3,0],["تَعَزَّ بِصَبرٍ لا وَجَدِّكَ لا تَرى","بَشامَ الحِمى أُخرى اللَيالي الغَوائِرِ",30,"ر",1,1],["تَعَزّى مِن بَني الآدابِ قَومٌ","سَهِرتُ وَنامَ هاجِعُهُم حِيالي",31,"ل",2,0],["تعزيةٌ أودعَ فيها الضَّريْر","حُكْمَ البصيرْ",32,"ر",1,0],["تَعَزُّ أَبا العَبّاسِ عَن خَيرِ هالِكٍ","بِأَكرَمِ حَيٍّ كانَ أَو هُوَ كائِنُ",33,"ن",1,1],["تعزّى قلبُنا عن ذكرِ راح","فكيف عزاءُ قلبٍ مُستباح",34,"ح",1,1],["تَعَزَّ بِصَبرٍ عَن خِلافَةِ أَحمَدٍ","وَكُل رَغَداً مِمّا تَشَرَّقتَ وَاِرقُدِ",35,"د",1,0],["تَعَزَّ وَلا تَكُن مِثلَ اِبنِ نِهيا","لَهُ رُمحٌ وَلا يُغنيهِ رُمحُ",36,"ح",1,0],["تَعَزَّ عَنِ الحَوراءِ إِنَّ مَقامَنا","عَلَيها وَتَركَ المُلكِ رَأيٌ مُزَلَّجُ",37,"ج",1,0],["تَعَزَّ لَها يا اِبنَ الخُلَيقَ فَإِنَّها","مَواريثُ زِنجِيٍّ جَرَت بِعُيوبِ",38,"ب",1,0],["تَعَزَّ عَنِ الحَوراءِ إِنَّ عِداتِها","وَقَد نَزَلَت بِالزابِيَينِ لِفاءُ",39,"ا",2,0],["تَعَزَّ فَإِنَّ الدَهرَ يَجرَحُ في الصَفا","وَيَقدَحُ بِالعَصرَينِ في الجَبَلِ الوَعرِ",40,"ر",1,0],["تَعَزَّ عَنِ الْعَلْيَاءِ بِاللُّؤْمِ وَاعْتَزِلْ","فَإِنَّ الْعُلا لَيْسَتْ بِلَغْوِ الْمَنَاطِقِ",41,"ق",1,0],["تَعِزُّ عَلَيها رَيبَتي وَيَسوؤُها","بُكاهُ فَتَثني الجيدَ أَن يَتَضَوَّعا",42,"ع",2,0],["تعزّ يا طيرُ فالأيامُ مقبلةٌ","ما أضيقَ العيشَ لو عزّ المُعَزّونا",43,"ن",2,0],["تعزف عن مضوفة إذا عنت","مجفلة عن المضاف ان دعا",44,"ا",1,0],["تعزف العطر والفتون المندّى","وتهزّ الشباب والعنفوانا",45,"ن",2,0],["تعزَّ لها يا بن الخيلق فإنها","مواريثُ زنجيٍّ جرت بعيوب",46,"ب",1,0],["تَعَزّرَ بالله مُسْتَقْرِباً،","مَدَى الحقّ يَسرِي إلى قَصْدِهِ",47,"د",2,0],["تَعَزَّ، فإنّ السّيفَ يَمضِي، وَإنْ وَهتْ","حَمَائِلُهُ عِنْهُ وَخِلاّهُ قائِمُهْ",48,"م",2,0],["تعزَّوا وقد نابتهُمُ كلُّ نوبة","وماتوا فعرّوا كل ذي حسراتِ",49,"ت",1,0],["تعز عن الدنيا وأيقن بأنها","لئيمة طبع في الهبات تعود",50,"د",1,0],["تعز ولا ترخص لموتي أدمعاً","أباة على سوم الغرام غواليا",51,"ي",2,0],["تَعَزَّ فؤادِي لستُ أولَ عاشقٍ","فهذا بلاءٌ حلَّ في الناس مِن قَبلُ",52,"ل",1,0],["تَعَزَّ بِذا العِزِّ الأَشَمِّ فَإِنَّهُ","طَريقٌ إِلى حَسمِ المَساءَةِ لاحِبُ",53,"ب",1,0],["تَعَزَّزَ ديناً فاِعتَلى كُلَّ قِمَّةٍ","وَجَرَّدَ في أَعدائِهِ سَيفَ نِقمَةٍ",54,"ه",1,0],["تعزَّزْتُ مغْتَرّاً بِما البينُ صانعٌ","ولَم أَدرِ أَنَّ البينَ مركبُهُ صَعْبُ",55,"ب",1,0],["تَعَزَّ فَكُلٌّ سَالِكٌ لِسَبيلِهِ","وَكُلُّ اِمرِئٍ مِن خَشيَةِ المَوتِ جازِعُ",56,"ع",1,0],["تعزّيتُ عَن حبّ الضبابي حقبةً","وَكلّ عمايا جاهلٍ ستثوبُ",57,"ب",1,1],["تَعَزَّزَ حَتّى لا يُنالُ وَإِنَّما","رَأى ثَوبَهُ قَد مَسَّه فَأَغارَهْ",58,"ر",2,0],["تَعِزُّ بِأَنجالٍ كِرامٍ أَعِزَةٍ","لَهُم في سَما عَلياكَ أَشرفُ مَطلَعِ"