{"poems":[[55,"أخلفت يا سيدتي وعدي","https://www.aldiwan.net/poem26403.html","السريع"],[77,"جنى النسيم علي","https://www.aldiwan.net/poem36458.html","المجتث"],[48,"ما منك سلمى ولا أطلالها الدرس","https://www.aldiwan.net/poem64339.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[101,"أطلّت على سُحبِ الظلامِ ذُكاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62408&r=&rc=0",""]],"verses":[["إِذ صِرتُمُ تَلهُون يَهنيكُمُ","وَدَمعُ عَينَيَّ عَلى خَدّي",0,"د",2,0],["إذْ صيّرَ الخَلْقَ نجْداً","والأرضَ أبْناءَ عُذْرَهْ",1,"ه",1,0],["إِذ صَبَّحَ المَلِكَ النُعمانَ وافِدُهُ","وَمِن قُضاعاةَ أَسرى عِندَهُ حُبُسُ",2,"س",1,0],["إذ صورت لي نسوةً","بالرافدين يثرن وجدا",3,"د",2,0],["إذ صالَ لم يترك مَصالاً لصائل","وإن قَال ألقت سمعَها البُلغَاءُ",4,"ا",2,0]]}