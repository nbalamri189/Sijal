{"poems":[[55,"أخلفت يا سيدتي وعدي","https://www.aldiwan.net/poem26403.html","السريع"],[77,"جنى النسيم علي","https://www.aldiwan.net/poem36458.html","المجتث"],[48,"ما منك سلمى ولا أطلالها الدرس","https://www.aldiwan.net/poem64339.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[101,"أطلّت على سُحبِ الظلامِ ذُكاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62408&r=&rc=0",""],[129,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[212,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[282,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[354,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[378,"طوباك يا جسد العذراء إن له","https://www.aldiwan.net/poem59244.html","البسيط"],[378,"إني ودينك يا من جاد بالبعث","https://www.aldiwan.net/poem66896.html","البسيط"],[404,"كان السفائن سابقا","https://www.aldiwan.net/poem34136.html","مجزوء الكامل"],[433,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِذ صِرتُمُ تَلهُون يَهنيكُمُ","وَدَمعُ عَينَيَّ عَلى خَدّي",0,"د",2,0],["إذْ صيّرَ الخَلْقَ نجْداً","والأرضَ أبْناءَ عُذْرَهْ",1,"ه",1,0],["إِذ صَبَّحَ المَلِكَ النُعمانَ وافِدُهُ","وَمِن قُضاعاةَ أَسرى عِندَهُ حُبُسُ",2,"س",1,0],["إذ صورت لي نسوةً","بالرافدين يثرن وجدا",3,"د",2,0],["إذ صالَ لم يترك مَصالاً لصائل","وإن قَال ألقت سمعَها البُلغَاءُ",4,"ا",2,0],["إذْ صار عن نهج الهدى متكبراً","لا خير في هذا ولا في مجدِه",5,"د",2,0],["إذ صرت في غي الهوى ورشاده","إماماً فقد تمت أياديكمُ عندي",6,"د",2,0],["إذ صار فيهنَّ دين الحق مغتربا","يرتاعُ إن صدَّ ناب الكفر أو صدفا",7,"ف",2,0],["إِذ صحّة المَنقول تَمحو دجا ال","وهم كنور الشَمس يَمحو الظَلام",8,"م",1,0],["إذ صان مولدُه منه بَكارتَه","فصانه من فساد الموت إذ وُسِما",9,"م",2,0],["إذ صانكم ثم في الصحراء طوَّفكم","وكف عنكم أذى الآفات والدعث",10,"ث",1,0],["إذ صار طوقاً للكلا","ب الميتات على الرقاب",11,"ب",1,0],["إذ صدورُ الحسامِ ذاتُ فلولٍ","وكعوبُ القناةِ ذاتُ ارْفِضاضِ",12,"ض",1,0],["إذ صار أمر الناس للنساء","وعادت الإمرة للأهواء",13,"ا",2,0]]}