{"poems":[[57,"أخلفت يا سيدتي وعدي","https://www.aldiwan.net/poem26403.html","السريع"],[79,"جنى النسيم علي","https://www.aldiwan.net/poem36458.html","المجتث"],[50,"ما منك سلمى ولا أطلالها الدرس","https://www.aldiwan.net/poem64339.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[103,"أطلّت على سُحبِ الظلامِ ذُكاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62408&r=&rc=0",""],[132,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[358,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[382,"طوباك يا جسد العذراء إن له","https://www.aldiwan.net/poem59244.html","البسيط"],[382,"إني ودينك يا من جاد بالبعث","https://www.aldiwan.net/poem66896.html","البسيط"],[409,"كان السفائن سابقا","https://www.aldiwan.net/poem34136.html","مجزوء الكامل"],[438,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63998","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38661","الكامل"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34517","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59736","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96688","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108635","المتدارك"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65994","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198435","المجتث"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117307","الكامل"],[4475,"","https://poetry.dctabudhabi.ae/diwan/poem/206213","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72731","الرجز"],[4942,"ولد الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=188837",""],[5050,"صبرا على مضض المصارع","https://www.poetsgate.com/ViewPoem.aspx?id=38198",""],[5246,"يا نسيم الصبح هل أخبرتني","https://www.poetsgate.com/ViewPoem.aspx?id=187067",""],[5582,"سَرَتْ الحُدُوجُ يَزِينُها الأَفْزازُ","https://www.poetsgate.com/ViewPoem.aspx?id=187152",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""]],"verses":[["إِذ صِرتُمُ تَلهُون يَهنيكُمُ","وَدَمعُ عَينَيَّ عَلى خَدّي",0,"د",2,0],["إذْ صيّرَ الخَلْقَ نجْداً","والأرضَ أبْناءَ عُذْرَهْ",1,"ه",1,0],["إِذ صَبَّحَ المَلِكَ النُعمانَ وافِدُهُ","وَمِن قُضاعاةَ أَسرى عِندَهُ حُبُسُ",2,"س",1,0],["إذ صورت لي نسوةً","بالرافدين يثرن وجدا",3,"د",2,0],["إذ صالَ لم يترك مَصالاً لصائل","وإن قَال ألقت سمعَها البُلغَاءُ",4,"ا",2,0],["إذْ صار عن نهج الهدى متكبراً","لا خير في هذا ولا في مجدِه",5,"د",2,0],["إذ صرت في غي الهوى ورشاده","إماماً فقد تمت أياديكمُ عندي",6,"د",2,0],["إذ صار فيهنَّ دين الحق مغتربا","يرتاعُ إن صدَّ ناب الكفر أو صدفا",7,"ف",2,0],["إِذ صحّة المَنقول تَمحو دجا ال","وهم كنور الشَمس يَمحو الظَلام",8,"م",1,0],["إذ صان مولدُه منه بَكارتَه","فصانه من فساد الموت إذ وُسِما",9,"م",2,0],["إذ صانكم ثم في الصحراء طوَّفكم","وكف عنكم أذى الآفات والدعث",10,"ث",1,0],["إذ صار طوقاً للكلا","ب الميتات على الرقاب",11,"ب",1,0],["إذ صدورُ الحسامِ ذاتُ فلولٍ","وكعوبُ القناةِ ذاتُ ارْفِضاضِ",12,"ض",1,0],["إذ صار أمر الناس للنساء","وعادت الإمرة للأهواء",13,"ا",2,0],["إذ صار عند سواك طولُ إِقامتي","ضرراً عليَّ وصار عندك يَنفَع",14,"ع",1,0],["إِذ صارَ ذاكَ البدرُ بَينَ أَكفّها","قَد طَرّزَتهُ بِالحَريرِ الأَخضَرِ",15,"ر",1,0],["إِذ صُعودي عَلى الجِيادِ إِلَيهِ","وَاِنحِداري في المُنشَئاتِ الجَواري",16,"ر",2,0],["إذ صِرن نُهزَة ناهب","لا بالرحيم ولا العفيف",17,"ف",1,0],["إِذ صافَحت خدّي بِصفحةِ خدّها","وَدَنا إليّ قوامُها المتعطّفُ",18,"ف",1,0],["إِذ صارَ مِن عمالكا","وَعد مِن رجالكا",19,"ك",2,0],["إذ صار الحجل لنا حجلاً","وأنين الكاس لنا قمري",20,"ر",2,0],["إذ صَرَّحَ الوَحيَانِ مَع كُتُبِ الإِلَ","هِ جَميعِهَا بِالفَوقِ للرَّحمَنِ",21,"ن",1,0],["إذ صرت مشتهراً بالفضل أنت ولي","قلب يحب بدين اللّه من دانا",22,"ن",2,0],["إِذ صاحَ في النّاسِ رَسول صادِق","لِعقله مِن خَوفِهِ مفارقُ",23,"ق",1,0],["إذ صار صبحاً وليلاً","وكان قبل نهارا",24,"ر",2,0],["إِذ صرتِ بالملك الميمون آمنةً","وجندُه لَكَ أنصارٌ وأعوان",25,"ن",1,0],["إذ صبرنا للذي قد قدّرا","وجعلنا ذخرنا جاه النبي",26,"ي",1,0],["إذ صدغها الآس وإذ خدها","الورد له أكمامه برقع",27,"ع",1,0],["إذ صار حظى منك حظى منهم","احكم بما ترضى فلست مكابرا",28,"ر",2,0],["إذ صعودي على الجياد إليه","وانحداري في المعقبات الجواري",29,"ر",2,0],["إذ صرت من أشعر أهل السنه","في نعت سيدي شباب الجنه",30,"ه",1,0],["إذ صار هذا الكونُ كلُّهُ مُنهَكا","لما تحَكّمَ جاهلٌ مهذارُ",31,"ر",1,0],["إذ صرت في دار العد","وفكان خطبك أي شانع",32,"ع",1,0],["إذ صروف الدهر لا يسطيعُها","من يعانيها لينجو بانفراد",33,"د",1,0],["إِذْ صارَ لِلْفُرْسانِ فِي حَمَلاتِهِ","تَحْتَ العَجاجِ تَداعُسٌ وَبُزازُ",34,"ز",1,0],["إذْ صدّقٓ السيف أنْباءً بجحفلها","أوْ كذّب ألفألُ فيها ركنك الكسلِ",35,"ل",1,0]]}