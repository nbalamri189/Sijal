{"poems":[[55,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[47,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[48,"حالي حال اليائس الراجي","https://www.aldiwan.net/poem22270.html","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[102,"صنعاء والموت والميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=50405",""],[242,"ما للأحبة أسياف الجفا اخترطوا","https://www.aldiwan.net/poem18841.html","البسيط"],[327,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[333,"مجد يهان وعزة تتضعضع","https://www.aldiwan.net/poem54922.html","الكامل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[463,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[520,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87244","الوافر"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205627","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76610","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96035","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202024","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74216","الرجز"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203628","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62948","الرجز"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111320","البسيط"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4737,"متى الذهاب إلى الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=212154",""],[4888,"حلب الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=207762",""],[4916,"صدمه","https://www.poetsgate.com/ViewPoem.aspx?id=136242",""],[4931,"ختم النّواحه","https://www.poetsgate.com/ViewPoem.aspx?id=32768",""],[5431,"امرأة ترغب بالانفصال...","https://www.poetsgate.com/ViewPoem.aspx?id=202032",""],[5436,"نصيحة صادقة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35264",""],[5458,"كان جدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=72394",""],[5458,"رمضان العراق","https://www.poetsgate.com/ViewPoem.aspx?id=72392",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5574,"جرحُ الشام!","https://www.poetsgate.com/ViewPoem.aspx?id=206023",""],[5674,"ليلي مثل روحي راحل","https://www.poetsgate.com/ViewPoem.aspx?id=187317",""],[5725,"بلاد النهرين","https://www.poetsgate.com/ViewPoem.aspx?id=198717",""],[5853,"((رهطٌ من الجن))","https://www.poetsgate.com/ViewPoem.aspx?id=175656",""],[5888,"رؤيا وواقع مرير","https://www.poetsgate.com/ViewPoem.aspx?id=214508",""],[6032,"شهيد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=181525",""],[6038,"احبك اكثر","https://www.poetsgate.com/ViewPoem.aspx?id=25689",""],[6038,"تغليك","https://www.poetsgate.com/ViewPoem.aspx?id=28436",""],[6070,"ماذا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=187868",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["أَشلى بِها الضِرغامُ حَت","تى هَبَّ مِن طيبِ المَنامِ",0,"م",1,0],["أَشلَيتَ عَزمَكَ في كَتائِبِهِ","وَالسَهمُ يُشليهِ مُفَوِّقُهُ",1,"ق",2,0],["أَشلى سُلوقِيَّةً باتَت وَباتَ بِها","بِوَحشِ إِصمِتَ في أَصلابِها أَوَدُ",2,"د",1,0],["أَشلى عَلى مَنويلَ أَطرافَ القَنا","فَنَجا عَتيقَ عَتيقَةٍ جَرداءِ",3,"ا",2,0],["أَشَلَّ أَو أَعرَجَ دَهرٌ عَدا","فَوارِساً عَن شَكِّ أَعراجِ",4,"ج",1,0],["أَشلى الزَمانُ عَلَيها كُلَّ حادِثَةٍ","وَفُرقَةٍ تُظلِمُ الدُنيا لِنازِحِها",5,"ح",3,0],["اشلاء دفت عليها الفتح وانتهبت","أوصالها السيد بعد البيض والسمر",6,"ر",1,0],["أشلاء تخفق كالذكرى","وتنام لتحلم بالمحشر",7,"ر",1,0],["أَشْلَوْا عَلَى أَضْلُعِي مِخْرَاطَ هَجْرِهِمُ","إِذْ أَبْعَدُونِي وَأَغْصَانَ الْمُنَى خَرَطُوا",8,"ط",3,0],["أَشلى كِلاباً فَلَم تَنكُل وَأَجرِيَها","غُضفاً نَواحِلَ في أَلوانِها غَبَسُ",9,"س",1,0],["أشلاءُ معركة الحياة وعندهم","أن الجهاد تنابذٌ وتقاطع",10,"ع",1,0],["أشلعوا في بيت المعرس نارا","يتنشق دخانها التعساء",11,"ا",2,0],["أشِلْ بضَبعي من الحال التي لعبت","بماء وجهيَ لِعْبَ الماء بالسفُنِ",12,"ن",1,0],["أشلاؤهم مزق بكل ثنية","وجسومهم صرعى بكل مكان",13,"ن",1,0],["أَشَلٌّ لا ذراع لَهُ","وَأَعمى الطَرفِ وَالقلبِ",14,"ب",1,0],["أشلى كلاب الظالمين عليهمو","فغدوا نهاب خديعة وضلال",15,"ل",1,0],["أشلب ولا تنساب عبرة مشفق","وحمص ولا تعتاد زفرة نادم",16,"م",1,0],["أشلاء من قد وزعت","بالركض في ذاك الوهاد",17,"د",1,0],["أشلاؤه فوق الصعيد","ورأسه فوق الصعاد",17,"د",1,0],["أشلاءُ جسمي بالإباء تماسكتْ","ينهار جسمي إن فقدتُ إبائي",18,"ي",1,0],["أشل مِنا الكَف وَالأَصابِعا","وَأَخرس الأَلسنة المصاقعا",19,"ع",2,0],["أشلين ذل اليتم في الأشبال","وفتكن بالأجساد في الأغيال",20,"ل",1,0],["أَشليتَ منه أَسداً ضارياً","عَوَّدَ مضغَ اللحم أَشبالَهْ",21,"ل",2,0],["أشل أيديهم مما عرا قصر","أم وقر السمع مما قد جرى همم",22,"م",1,0],["أَشلاؤُها فَإِذا سَبَقنَ مَعاً","وَعَدا وَقورُ القَلبِ أَصمَعُهُ",23,"ع",2,0],["أشلاءُ عائلةٍ أنقاضُ أبنيةٍ","وطائراتٌ بحلوى الموت تَمطرُهُ",24,"ر",2,0],["أشلاءُ أطفالٍ ورَقْدَةُ رُضّعٍ","باتتْ تئنُّ من القلوبِ الكافرةْ",25,"ر",2,0],["اشلون اجاري خافقي وإلتياعه","واللي زرعته ماحصدنه يديّا ؟!",26,"ي",2,1],["أشلون بنسى الغرّ بو عيونن وساع","وانسى الكلام اللي نطق به وباحه",27,"ح",2,0],["أشلون بنسى ايام فيها الغلا فاع","وانسى .. وارد أبدي من اوّل .. صراحه",27,"ح",2,0],["أشلاءُ جسميَ مازالت مخبئةً","بين الشراشف مذْ ذاقت جراحته",28,"ت",2,0],["أشلاءُ أَجْنَادِ المَرِنْزِ تَمَرَّغَتْ","تَحْتَ النِّعالِ، وكُنْتُ حَيّاً أُرْزَقُ",29,"ق",1,0],["أشلاء أطفال العراق تناثرت","ومياه دجلة خضبت بدماء",30,"ا",2,0],["أشلاء أطفال العراق تناثرت","بدمائهم صار الخليج خضيبا",31,"ب",2,0],["أشلاءُ كرسيِّ البطولةِ شاهدٌ","عَدْلٌ يُدين الغادرَ الخوَّانا",32,"ن",2,0],["١٠- أشْلاءُ شتّى الأرضِ يرْمُقُها","منْ ماتَ لا يدري ومنْ رقَدَا!",33,"د",2,0],["أشلاء شوقي للوصال تهزني","مذبوحةٌ مثلي وانت القاتلُ",34,"ل",1,0],["اشلون تصبر من مشو بيه اهناك","ابديرة غرب بس اني ويْ نجم اسهيل",35,"ل",1,0],["أشلاء بعضٍ منهمُ من ضعفهمْ","يصطادها سرب الطيور الجارحة.!",36,"ح",2,0],["أشلاءَ أجسادٍ بدونِ رؤوسِها","تقتاتُها أسرابُ طيرٍ جارحة",37,"ح",2,0],["أشلاء عمري من أوار جحيمها","ونعيمها ظل الجوى وصدودُ",38,"د",1,0],["اشلون افرح وانت بعيدة","وحب الاول ما يتحول",39,"ل",1,0],["اشلون تقوى تعيش بلحظة من دوني","يا خلي ما اقوى اعيش بلحظة من دونك",40,"ك",1,0],["أشلاءَ لحمٍ طاهرٍ","وبقايا أَمْنٍ قَدْ هَرى",41,"ر",2,0],["أشلاءُ مَنْ هذي ؟! أليسوا من دمي ؟","أوَليسَ قد مُدّت إليَّ الأذرع ؟",42,"ع",1,0],["أشلاؤهُ فوق الطّغاةِ تناثرتْ","عَرْضاً تراها في العَراءِ وطولا",43,"ل",2,0]]}