{"poems":[[63,"خطوب للقلوب بها وجيب","https://www.aldiwan.net/poem45826.html","الوافر"],[55,"سلام على النازح المغترب","https://www.aldiwan.net/poem26493.html","المتقارب"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[27,"ألا حي ليلى إذ أجد اجتنابها","https://www.aldiwan.net/poem5681.html","الطويل"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[85,"نحن الكشافة في الوادي","https://www.aldiwan.net/poem7926.html","المتدارك"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[61,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[66,"أقيموا على الإعراض مع قرب داركم","https://www.aldiwan.net/poem38655.html","الطويل"],[31,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[52,"ليت يومي بنهر فروخ عادا","https://www.aldiwan.net/poem27119.html","الخفيف"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[67,"قل لولي الدولة المرتجى","https://www.aldiwan.net/poem18074.html","السريع"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[46,"متى ما تشاهد نعمة كنعامة","https://www.aldiwan.net/poem23369.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[113,"كشفت حجاب الطمس عن حيطة الأسما","https://www.aldiwan.net/poem41777.html","الطويل"],[133,"فمن مبلغ أهل المتاحف أننا","https://www.aldiwan.net/poem48929.html","الطويل"],[141,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[257,"يمم ندى غيث الكرام العلي","https://www.aldiwan.net/poem35740.html","السريع"],[257,"حمى السيد البكري حمى من به احتمى","https://www.aldiwan.net/poem35957.html","الطويل"],[340,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[364,"هو الصبر لكن لا أقول جميل","https://www.aldiwan.net/poem17351.html","الطويل"],[388,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[393,"أبينت رسم الدار أم لم تُبينِ","https://www.aldiwan.net/poem621.html",""],[447,"سلام على الماضي","https://www.aldiwan.net/poem1000.html",""],[451,"يعز علي أن ألفى المعزى","https://www.aldiwan.net/poem61775.html","الوافر"],[456,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[512,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"]],"verses":[["وَنَخضَعُ راغِبينَ لَها اِضطِراراً","وَكَيفَ يُلاطِمُ الإِشفى لَبيبُ",0,"ب",1,0],["وَنَخشى الوُشاةَ فَما نَستَطيعُ","نُهادي الَّذي بَينَنا في الكُتُب",1,"ب",1,0],["وَنَخْلَعُ منْ أمْداحِ أحْمَدَ حُلّةً","علَيْك ومِنْ منْظومِ آياتِهِ عِقْدا",2,"د",2,0],["وَنَخشى مِنَ الأَعداءِ أُذناً سَميعَةً","تُوَجَّسُ أَو عَيناً يُخافُ اِرتِقابُها",3,"ب",3,0],["وَنَخالُ أَنَّ البَدرَ يَطلِعُ في الدُجى","كَيما يُسامِرُنا فَلا نَتَمَلمَلُ",4,"ل",1,0],["ونخَاطبُ الأَصداءَ وهي","ترِفُّ في الوادي المُنيرْ",5,"ر",1,0],["وَنُخَلّي الخَلقَ وَما اِعتَقَدوا","وَلِوَجهِ الخالِقِ نَجتَهِدُ",6,"د",1,0],["وَنُخرِجُها فَتَكسِبُ ثُمَّ تَأوي","رُجوعَ النَحلِ قَد حُمِّلنَ زادا",7,"د",2,0],["ونَخطُبُ صُلحَ النَّائباتِ ولم يزَل","لأنفسِنا من خَطْبِها أبداً خَطْبُ",8,"ب",1,0],["وَنَختارُ أَيّامَ الصُدودِ لِأَنَّنا","نَرى عِظَماً بِالصَدِّ وَالبَينُ أَعظَمُ",9,"م",1,0],["وَنَخيباً مُسَحَّجاً أَوطَنَ العَر","صَةَ فَرداً أَبى بِها أَن يَريما",10,"م",2,0],["وَنَخلٌ ساقِطُ القِنوانِ فيهِ","خِلالَ أُصولِهِ رُطَبٌ قَميمُ",11,"م",1,0],["وَنَخالُ الحَصى إِذا ما عَدَت نَح","لاً أُطيرَت مِن تَحتِها أَو جَرادا",12,"د",2,0],["وَنَخْلٌ أَثْمَرَتُ في دُونِ عامٍ","فَغَارَ بها عَلَى القِنْوِ العَسيبُ",13,"ب",1,0],["وَنَخْلَةٍ تَشْكُرُ جَدْواكَ مِنْ","أَصْلٍ ومِنْ فَرْعٍ ومِنْ راسِ",14,"س",1,0],["ونخالُها صَفراء عارَضَتِ الدُّجى","وسَرَتْ فنادَمَ كوكباً نَدمانُها",15,"ن",3,0],["وَنَخشى عَذاباً في المَماتِ وَإِنَّنا","لَأَهلُ عَذابٍ في الحَياةِ أَليمِ",16,"م",1,0],["ونخطُّ البستانَ أحلامَ طِفلٍ","صَقلتهُ مواهبُ الأربابِ",17,"ب",1,0],["ونخوضُ الزمانَ في جُنْحِ ليلٍ","أبديٍّ يُضني النفوسَ ويُنضي",18,"ي",1,0],["ونَخْتَرِق الأجْواءَ بَيْنَ مُدَوِّمٍ","يَمَدُّ جَنَاحَيْهِ وبين مُصَفِّقِ",19,"ق",1,0],["ونخلة جرعاء البطائح قد مشت","إليك على منوال دعوتك العظمى",20,"م",2,0],["ونخطو عليها بالنعال كأنّ ذا","مباح فلم ينكر بعرف المعارفِ",21,"ف",1,0],["وَنَخوَةٌ ما يَزالُ الدَهرَ يَمنَعُها","مُستَحسَنُ الجِدِّ عَن مُستَقبَحِ اللَعِبِ",22,"ب",1,0],["ونخلته من دقيق المنى","وغيره يرمَى من المنخل",23,"ل",1,0],["ونخبتهم ذو الفضل في الكون مصطفى","إمام الهدى البكري الملاذ الّذي سما",24,"م",2,0],["ونخلد أم انفنى لا نرى ال","خلود على أرضنا الفانية",25,"ي",2,0],["وَنَخلٍ يَغيظُ الظِلُّ إِذ هُوَ ساكِنٌ","عَلى الظُهرِ خَفّاقُ العَشِيِّ ظَليلُ",26,"ل",1,0],["ونختمها بجمد","كثير ماله حد",27,"د",1,0],["ونخوةُ أقوام عليّ درأتها","بسطوة أيدٍ من رجال وألسن",28,"ن",1,0],["ونختال في برد كأن نسيجه","خمائل أزهار ترنحها الصبا",29,"ب",2,0],["ونخترع السعادة في إباءٍ","لعزّتنا فلا يُجدى الإباء",30,"ا",2,0],["ونخوةٌ سيماءُ فارسيَّةٍ","شمّاءَ لا تُعطي الخِزَام منخرا",31,"ر",2,0],["ونخلص لله المتاب النصوح لا","نعود إلى نقض كمن راح غادرا",32,"ر",2,0],["ونخشى رِماحَ الموتِ وهْيَ مَعاطِفٌ","ونسطو عليها وهْي سُمرٌ شواجِرُ",33,"ر",1,0]]}