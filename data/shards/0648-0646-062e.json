abi.ae/diwan/poem/122154","الرمل"],[4069,"","https://poetry.dctabudhabi.ae/diwan/poem/22630","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123525","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135098","الرجز"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119540","المتقارب"],[4660,"","https://poetry.dctabudhabi.ae/diwan/poem/143990","المنسرح"],[4755,"يا فَوقَ أَربَعَةٍ.. وتَحتَ ثَمَانِيَة","https://www.poetsgate.com/ViewPoem.aspx?id=210325",""],[4817,"أنشودة إلى روح أبي","https://www.poetsgate.com/ViewPoem.aspx?id=215385",""],[4862,"هجير الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=55375",""],[4927,"فرحة الاعياد","https://www.poetsgate.com/ViewPoem.aspx?id=4589",""],[4929,"عروبة الزمن الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=215675",""],[3591,"حيّ في مصر أربع الغادات","https://www.poetsgate.com/ViewPoem.aspx?id=149455",""],[5105,"إلام اتباعي للأماني الكواذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=135342",""],[5183,"لفح الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180226",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5277,"حديثُ الأحداق","https://www.poetsgate.com/ViewPoem.aspx?id=191115",""],[5302,"أقمت على نهري","https://www.poetsgate.com/ViewPoem.aspx?id=200064",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"وطن الأكفان ...","https://www.poetsgate.com/ViewPoem.aspx?id=198867",""],[5431,"على لسان حواء...","https://www.poetsgate.com/ViewPoem.aspx?id=208756",""],[5449,"مكانة","https://www.poetsgate.com/ViewPoem.aspx?id=191778",""],[5518,"بين يدي الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=200953",""],[5570,"نغيب ذا غبنا بنصح ونلتقي","https://www.poetsgate.com/ViewPoem.aspx?id=186712",""],[5626,"سمائي مثل عشبي","https://www.poetsgate.com/ViewPoem.aspx?id=189719",""],[5736,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=208885",""],[5956,"من أركان الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192592",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[6093,"ما كل ما فات مات","https://www.poetsgate.com/ViewPoem.aspx?id=199359",""],[6093,"نخلة النقد","https://www.poetsgate.com/ViewPoem.aspx?id=200148",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6229,"مي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65188&r=&rc=14",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""]],"verses":[["وَنَخضَعُ راغِبينَ لَها اِضطِراراً","وَكَيفَ يُلاطِمُ الإِشفى لَبيبُ",0,"ب",1,0],["وَنَخشى الوُشاةَ فَما نَستَطيعُ","نُهادي الَّذي بَينَنا في الكُتُب",1,"ب",1,0],["وَنَخْلَعُ منْ أمْداحِ أحْمَدَ حُلّةً","علَيْك ومِنْ منْظومِ آياتِهِ عِقْدا",2,"د",2,0],["وَنَخشى مِنَ الأَعداءِ أُذناً سَميعَةً","تُوَجَّسُ أَو عَيناً يُخافُ اِرتِقابُها",3,"ب",3,0],["وَنَخالُ أَنَّ البَدرَ يَطلِعُ في الدُجى","كَيما يُسامِرُنا فَلا نَتَمَلمَلُ",4,"ل",1,0],["ونخَاطبُ الأَصداءَ وهي","ترِفُّ في الوادي المُنيرْ",5,"ر",1,0],["وَنُخَلّي الخَلقَ وَما اِعتَقَدوا","وَلِوَجهِ الخالِقِ نَجتَهِدُ",6,"د",1,0],["وَنُخرِجُها فَتَكسِبُ ثُمَّ تَأوي","رُجوعَ النَحلِ قَد حُمِّلنَ زادا",7,"د",2,0],["ونَخطُبُ صُلحَ النَّائباتِ ولم يزَل","لأنفسِنا من خَطْبِها أبداً خَطْبُ",8,"ب",1,0],["وَنَختارُ أَيّامَ الصُدودِ لِأَنَّنا","نَرى عِظَماً بِالصَدِّ وَالبَينُ أَعظَمُ",9,"م",1,0],["وَنَخيباً مُسَحَّجاً أَوطَنَ العَر","صَةَ فَرداً أَبى بِها أَن يَريما",10,"م",2,0],["وَنَخلٌ ساقِطُ القِنوانِ فيهِ","خِلالَ أُصولِهِ رُطَبٌ قَميمُ",11,"م",1,0],["وَنَخالُ الحَصى إِذا ما عَدَت نَح","لاً أُطيرَت مِن تَحتِها أَو جَرادا",12,"د",2,0],["وَنَخْلٌ أَثْمَرَتُ في دُونِ عامٍ","فَغَارَ بها عَلَى القِنْوِ العَسيبُ",13,"ب",1,0],["وَنَخْلَةٍ تَشْكُرُ جَدْواكَ مِنْ","أَصْلٍ ومِنْ فَرْعٍ ومِنْ راسِ",14,"س",1,0],["ونخالُها صَفراء عارَضَتِ الدُّجى","وسَرَتْ فنادَمَ كوكباً نَدمانُها",15,"ن",3,0],["وَنَخشى عَذاباً في المَماتِ وَإِنَّنا","لَأَهلُ عَذابٍ في الحَياةِ أَليمِ",16,"م",1,0],["ونخطُّ البستانَ أحلامَ طِفلٍ","صَقلتهُ مواهبُ الأربابِ",17,"ب",1,0],["ونخوضُ الزمانَ في جُنْحِ ليلٍ","أبديٍّ يُضني النفوسَ ويُنضي",18,"ي",1,0],["ونَخْتَرِق الأجْواءَ بَيْنَ مُدَوِّمٍ","يَمَدُّ جَنَاحَيْهِ وبين مُصَفِّقِ",19,"ق",1,0],["ونخاف العدى وحين نعادي","هل درينا أنّا خلقنا عدانا ؟",20,"ن",2,0],["ونخيلا من السّيوف المواضي","وسيوفا من القوافي الجهيره",21,"ر",2,0],["ونخلة جرعاء البطائح قد مشت","إليك على منوال دعوتك العظمى",22,"م",2,0],["ونخطو عليها بالنعال كأنّ ذا","مباح فلم ينكر بعرف المعارفِ",23,"ف",1,0],["وَنَخوَةٌ ما يَزالُ الدَهرَ يَمنَعُها","مُستَحسَنُ الجِدِّ عَن مُستَقبَحِ اللَعِبِ",24,"ب",1,0],["ونخلته من دقيق المنى","وغيره يرمَى من المنخل",25,"ل",1,0],["ونخبتهم ذو الفضل في الكون مصطفى","إمام الهدى البكري الملاذ الّذي سما",26,"م",2,0],["ونخلد أم انفنى لا نرى ال","خلود على أرضنا الفانية",27,"ي",2,0],["وَنَخلٍ يَغيظُ الظِلُّ إِذ هُوَ ساكِنٌ","عَلى الظُهرِ خَفّاقُ العَشِيِّ ظَليلُ",28,"ل",1,0],["ونختمها بجمد","كثير ماله حد",29,"د",1,0],["ونخوةُ أقوام عليّ درأتها","بسطوة أيدٍ من رجال وألسن",30,"ن",1,0],["ونختال في برد كأن نسيجه","خمائل أزهار ترنحها الصبا",31,"ب",2,0],["ونخترع السعادة في إباءٍ","لعزّتنا فلا يُجدى الإباء",32,"ا",2,0],["ونخوةٌ سيماءُ فارسيَّةٍ","شمّاءَ لا تُعطي الخِزَام منخرا",33,"ر",2,0],["ونخلص لله المتاب النصوح لا","نعود إلى نقض كمن راح غادرا",34,"ر",2,0],["ونخشى رِماحَ الموتِ وهْيَ مَعاطِفٌ","ونسطو عليها وهْي سُمرٌ شواجِرُ",35,"ر",1,0],["ونخيلُ الحُصَيب حَسبي وتعري","جُ سَوامي عليهِ دونَ عِراج",36,"ج",1,0],["وَنَختال تيهاً في مَلابس سُندسٍ","أَكاليلها مِن يانِعات زُهور",37,"ر",1,0],["ونخلطها بصميم العيال","بمن لم يخب وهو المحرم",38,"م",1,0],["ونخيلٍ ترفَّع النَّوْعُ منها","عن حِوار الأَنْفَالِ والشَّهْرِيز",39,"ز",1,0],["وَنختارُ أعْشاشَها في الغيوم","فليسَ لنا ثِقة ٌبالغصُونْ",40,"ن",1,0],["وَنُخْفِي غَرَاماً فِي الفُؤَادِ مُؤَبَّدَا","جَعَلْتُ لَهَا سَجْعِي عَلى النَّوْحِ مُسْعِدَا",41,"د",2,0],["ونخلةٌ عكف الحسنُ البديع بهَا","والقلبُ طار عليها إذ زهت ورقا",42,"ق",2,0],["ونخرت بالبلى عظام","وانتثرت في الثرى الجلود",43,"د",1,0],["ونختم بالحسنى الفعال وانما","تزين أعمال الرجال الخواتم",44,"م",1,0],["وَنَخيلٍ وَقَفنَ في مِعطَفِ الرَم","لِ وُقوفَ الحُبشانِ في التيجانِ",45,"ن",1,1],["ونخشى أن نرى حرباً رحاها","إذا دارت تُغادرنا دقيقا",46,"ق",2,0],["وَنَخلَع في رَحاب القَصرِ حَتّى","نَلبّس هامَهُ خلع الهِيامِ",47,"م",1,0],["ونخوةً قط لم يظفر بها بشرٌ","وصدق قول حريزٍ جلَّ عن ريبِ",48,"ب",1,0],["ونخيله بجزوعها وطلوعها","حكت العرائس اذ لبسن عقودا",49,"د",2,0],["وَنَخوضُ غَمرَةَ كُلِّ يَومِ كَريهَةٍ","تُردي النُفوسَ وَغُنمُها لِلأَشجَعِ",50,"ع",1,0],["وَنخَلنَها نَخلَ الطَحينِ مُقيمَةً","كُلُّ الرِياحِ تُعيرُها غِربالَها",51,"ل",3,0],["ونخبطُ خبطاً ببيدائِهِ","كعشواءَ في المهمهِ الفدفد",52,"د",1,0],["وَنَخلَتُهُ الَّتي غُرِسَت لَدَيهِ","تَهَصَّرُ في ذَراهُ بِالعُذوقِ",53,"ق",1,0],["ونختم بالصلاة على أمير","كفانا صولة الزمن الغدور",54,"ر",1,0],["ونخلو بمن نهوى إذا رقد الورى","ويجلو علينا من نحب محياه",55,"ه",1,0],["وَنُخْمِدُ الحَرْبَ حينَ يُضْرِمُها","أَهْلُ الوَغَى تارَةً وَنُشْعِلُها",56,"ه",2,0],["ونخرجُ منها جاهلينَ لأنَّها","هي الروضةُ الغنَّاءُ والحيَّةُ البَتْرا",57,"ر",2,0],["ونخزيهم وينصرُكم عليهم","ويشفي صدورَ قومٍ مؤمنينا",58,"ن",2,0],["وَنَخلٌ باسِقاتٌ كَالعَذارى","تَثَنّى في غَدائِرِها الطِوالِ",59,"ل",1,0],["ونختمها بتحصين عظيم","بحول اللَه لا يقدر علينا",60,"ن",2,0],["ونختم بالصلاة على محمد","إمام الكلّ خير الشافعينا",60,"ن",2,0],["ونَخلُهَا والناسُ وَالبنادِر","على جنوبيهَا فَكُن بالخابِر",61,"ر",1,0],["ونخط فوق الرمل للعشاق","أمثالا وشكلا",62,"ل",2,0],["وَنَخَّلتُ مِن شَرحِ ابنِ مالِكٍ الَّذي","وَقَفنا لَهُ شَرحاً لَطيفا مُلَفَّقا",63,"ق",2,0],["وَنَختَلِسُ الآناتِ صُبحاً وَمَغرِباً","نَقُصُّ مِنَ الأَخبارِ غَيرَ المَراجِمِ",64,"م",1,0],["وَنَخطوَ لِلعُلا خُطُواتِ آلٍ","وَحَسبُ الفَخرِ أَن شِدنا القِبابا",65,"ب",2,0],["وَنَخطُبَ في نَوادينا ذِراباً","وَنَسلُكَ مَسلَكاً فينا مُجابا",65,"ب",2,0],["ونخاف أن نلقاك وشك منيّةٍ","فيصيبنا الأمر الجليل المُفظِعُ",66,"ع",1,0],["ونختم المقال بالثناء","مع مزيد الشكر والدعاء",67,"ا",2,0],["ونختم المقال بالدعاء","مع كمال الشكر والثناء",68,"ا",2,0],["ونخلو وما غير العفاف نديمنا","حليفي وما من نائم ومسهد",69,"د",1,0],["وَنَخَستَ يَربوعاً لِيُدرِكَ سَعيَنا","يا بنَ الأَتانِ فَبَلَّدوا تَبليدا",70,"د",2,0],["ونخل هشيم حول داري بدت به","حدادي أبو قردان بوم وغربان",71,"ن",1,0],["وَنخوة تنزلُ الدنيا بِساحتها","وَهمّة يَنطَوي في نشرها البشرُ",72,"ر",1,0],["ونَخْوَةَ وارداتِ الخِمْسِ لَغْواً","يُطَاوِلْنَ الأسِنَّةَ بالهوَادِي",73,"د",2,0],["ونختارُ الطبيبَ وهل طبيبٌ","يؤخِّرُ ما يُقَدِّمُهُ القَضاءُ",74,"ا",2,0],["ونخشى المنايا والشباب بشرخه","ولكن ذي حال الذي فنه الشعر",75,"ر",1,0],["وَنُخَلّي الضَربَ وَالطَع","نَ لِأَجسادٍ وَهامِ",76,"م",1,0],["وَنخشى صُروف الدَهر وَهيَ أَجلها","حلول المَنايا وَهيَ رهن لمرصد",77,"د",1,0],["ونخبة تلك العصبة العلوية ال","علية قدراً والعظيمة مفخرا",78,"ر",2,0],["ونخرج كارهين كما دخلنا","خروج الضب أحوجه الوجار",79,"ر",1,0],["ونخل سلمان قد طابت مغارسه","ومنه في عامه جادت عناكيل",80,"ل",1,0],["ونخيلٌ في تلاعٍ جمَّةٍ","تُخرِجُ التمرَ كأمثال الأكف",81,"ف",1,0],["وَنَخلَعُ نَعلَ العَبدِ مِن سوءِ قَودِهِ","لِكَيما يَكونَ العَبدُ لِلسَهلِ أَضرَعا",82,"ع",2,0],["ونخلا حبت في عام غرس بكفه","جنا طيبا من بعد ما أن زهت زهوا",83,"و",2,0],["ونخبة النخبة في فن الأدب","وزبدة الزبدة حبر منتخب",84,"ب",1,0],["ونخضع ذلا خضوع العبيد","لمولى عزيز اذا أعرضا",85,"ض",2,0],["ونخرط الليل في النهار فما","يؤنس إلا الصباح والشفق",86,"ق",1,0],["ونَخَافُ مِن يَمَنٍ يُرَقِّعُ ثَوبَهُ","بِيَدٍ.. ويَفقَأُ قَلبَهُ بِالثَّانِيَة",87,"ن",3,0],["وَنَخْلاتُ السَّمَا ضَاءَتْ","بِ\"سُبْحَانَ الَّذِي أَسْرَى\"",88,"ر",2,0],["ونخيلاً وقطوفاً دانياتِ","لذةً قصوى وإمتاعاً كثيرا",89,"ر",2,0],["وَنَخَاْفُ مِنْ ظُلْمِ الْحُكُوْمَةِ بَعْدَمَاْ","صَاْرَتْ ضَحِيَّةَ أَحْسَدِ الْحُسَّاْدِ",90,"د",1,0],["ونخوةٌ نفَقَتْ من عهدِ معتصمٍ","قد أورقت فجأة في يابسِ الخشبِ !",91,"ب",1,0],["ونخال المقام منبت بانا","ت لما فوقه من القامات",92,"ت",1,0],["ونخضعُ أعناقَ الأعادي لعزنا","كما خضعتْ أموالنا للمواهب",93,"ب",1,0],["ونختم القول جِدَّياً براعته","أزكى من المسك في عطف من التيه",94,"ي",2,0],["وَنَخْلٌ لِإخْرَاجِ النَّخَالَةِ جَانِبًا","بِعِلْمٍ حَقِيقِيٍّ بِهِ يُحكَمُ النَّخْلُ",95,"ل",1,0],["ونخيلُ بهجتِها تمادى في الهوى","هوَساً تعانقُ جذعَهُ الأعذاقُ",96,"ق",1,0],["ونختال لا ننوي سوى عذب سهرة","سرت تمزج السكر اللذيذ بأملاح",97,"ح",1,0],["ونختفي في موج أحلامنا","على المرام الثابت الأسبق",98,"ق",1,0],["ونخشاه بل ننقاد بالذل رهبة","ونرغب في المأمول ما منه يرتما",99,"م",2,0],["ونخلة العمر بالأضواء مشبعةٌ","لترسل التمر بالتحنان والنشوى",100,"و",2,0],["ونخاسة عصرية","وغوانيا وزبائنا",101,"ن",2,0],["ونخطأُ ثم نعتذرُ","لنشعرَ أنّنا بشرُ",102,"ر",1,1],["ونخفِضُ للذّئابِ جَناحَ ذُلٍّ","لتخدعَنا المحبَّةُ والسَّلامُ",103,"م",1,0],["ونُخفي الهوى ممن نخاف وإننا","إلى من أمناه لمشتكيان",104,"ن",1,0],["وَنَخْلٌ كانَ يَزهو في شُموخٍ","فَصارَ أسيرَ نَفْحِ الذّارياتِ",105,"ت",1,0],["ونخيل حزن قد تطاول في العنى","رَطِبًا من الصمت الرهيب تكلما",106,"م",2,0],["ونخشى الله في قولٍ وفعلٍ","فيومياً له الأفعال تصعدْ",107,"د",1,0],["ونخلٌ شموخٌ ينخُّ إليك","ليغدو القطاف يسيراً عليكِ",108,"ك",1,0],["ونخيلُ صبرٍ في ضمي","ريَ بانتظارِكَ صَامداتْ",109,"ت",1,0],["وَنَخْلَةُ النَّقْدِ مَلَّتْ مِنْ تَجَاهُلِهَا","فهاتفتْنِي وَقَالَتْ سَوْفَ أَرْتَحِلُ",110,"ل",1,0],["ونخافُ أن نشكو وضاعةَ وضعنا","حتى ولو بالصمت والإيماءِ",111,"ا",2,0],["ونخافُ من أولادِنا ونسائنا","ومن الهواءِ إذا أتى بهواءِ",111,"ا",2,0],["ونخافُ إن بدأت لدينا ثورةٌ","مِن أن تكونَ بداية الإنهاءِ",111,"ا",2,0],["ونختال في روض المحبّةِ وحدَنا","فلا يتغنّى طيرُها لسوانا",112,"ن",2,0],["ونختصرُ الصمتَ مابيننا","فتوغلُ فيَّ الحروفُ الشريده",113,"د",2,0],["ونخيلُ دجلةَ شامخٌ ، لا ينحني","للمعتدينَ ، كأنّهُ أوتادُ",114,"د",1,0]]}