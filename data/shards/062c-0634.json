{"poems":[[32,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[53,"قبلته فمج في جوف فيها","https://www.aldiwan.net/poem65434.html","الخفيف"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[93,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[93,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[87,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[68,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[99,"كم أغر في بواكيرِ الصبا","https://www.aldiwan.net/poem24387.html","الرمل"],[46,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[33,"لم تدر وليغفر لها ربها","https://www.aldiwan.net/poem42557.html","السريع"],[33,"هلا ارعويت فترحمي صبا","https://www.aldiwan.net/poem42612.html","الكامل"],[50,"نفر النوم واحتمى","https://www.aldiwan.net/poem65232.html","مجزوء الخفيف"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[48,"دنياك تشبه ناضحا متردا","https://www.aldiwan.net/poem22575.html","الكامل"],[111,"أبلغ إليك رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=536",""],[93,"بنت سورية","https://www.poetsgate.com/ViewPoem.aspx?id=53216",""],[99,"بطل الأبطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63541&r=&rc=87",""],[196,"فتقت بالهجر دروز الهوى","https://www.aldiwan.net/poem27549.html","السريع"],[199,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[310,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[466,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122680","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122660","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49970","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48934","الكامل"],[1661,"","https://poetry.dctabudhabi.ae/diwan/poem/67813","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71037","السريع"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89547","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100817","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97960","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112365","البسيط"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128397","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128886","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59515","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59455","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[5616,"شموخا أيتها المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=204845",""],[5829,"آفة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=175412",""],[463,"حيها أوجهاً على السفحِ غرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60067&r=&rc=123",""]],"verses":[["جَشَمتُ إِلَيكَ البُعدَ لا في خُصومَةٍ","وَلا مُستَجيراً مِن جَريرَةِ مُجرِمِ",0,"م",1,0],["جَشَّمَتْها المُرَّين من حب أير","بالغٍ كل مبلغٍ مبلوغ",1,"غ",1,0],["جَشِمْتَ عناءً لا عناءَ وراءهُ","فدعْ عنكَ ما أعيا ولا تَجْشَم الجُشَمْ",2,"م",1,0],["جَشَّمتُهُ صَبراً فَلَمّا لَم يَطُق","جَشَّمتُهُ التَصويب وَالتَصعيدا",3,"د",2,0],["جَشَّموها كُلَّ أَمرٍ مُعضِلٍ","وَهِيَ لَم تُخلَق لِغَيرِ المَنزِلِ",4,"ل",1,0],["جَشِمتِ شَوكَ السُرى حَتّى أَتَيتِ لَنا","بِالوَردِ كُتباً وَبِالرَيّا عَناوينا",5,"ن",2,0],["جَشَّمتُماها مِنَ الأَهوالِ أَربَعَةً","الرَعدَ وَالبَرقَ وَالإِعصارَ وَالظُلَما",6,"م",2,0],["جَشَّمتَها جُرداً إِذا رُمتَ العُلى","أَرسَلتَها فَجَرَت إِلى غاياتِها",7,"ت",3,0],["جَشَّمتُهُ وَهوَ يَثني جيدَهُ مَلَلاً","كَأساً إِذا بَسَمَت في وَجهِهِ كَلَحا",8,"ح",2,0],["جشمته خطةً داميةً","وعرةَ المسلكِ حُفَّت بالألم",9,"م",1,0],["جِش لي بِبَحرٍ واحِدٍ أُغرِقكَ في","مَدحٍ أَجيشُ لَهُ بِسَبعَةِ أَبحُرِ",10,"ر",1,0],["جَشَّمَتِ الهَولَ بَراذينَنا","نَسأَلُ عَن بَيتِ أَبي خالِدِ",11,"د",1,0],["جَشِمَ الزِيارَةَ عَن مَوَدَّتِكُم","فَأَرادَ أَن لا تَحقَدي ذَنبا",12,"ب",2,0],["جَشَّمتَ قَلبَكَ الصَبا","بَةَ حَتّى تَجَشَّما",13,"م",2,0],["جَشَمتُهُ أَفضى وَشيحَ الجِلدِ","طَيَّ السَخاوِيِّ بِغَيرِ نِدِّ",14,"د",1,0],["جَشِبٌ كَفاكَ مُطاعِماً وَعَباءَةٌ","أَغنَتكَ أَن تُتخَيَّرَ الأَوبارُ",15,"ر",1,0],["جشمتني خرط القتا","د كأن باقعة وقاح",16,"ح",1,0],["جشّمةها كلّ أمر معضل","وهي لم تخلق لغير المنزل",17,"ل",1,0],["جشمته خطة دامية","وعرة المسالك حفت بالألمْ",18,"م",1,0],["جَشَمَتني يا طيلَسانُ النَوى","مِنكَ عَلى شوزَكتي وَجدي",19,"د",2,0],["جَشَموا السُرى بَعدَ الرواحِ فَأَصبَحوا","سودَ الوجوهِ بِهِم سُهامَ سَمائِمِ",20,"م",1,0],["جشّمتَني إذناً لكم بزيارةٍ","أَنتم بِها منّي أحقّ وأجدرُ",21,"ر",1,0],["جشَّمتْها الأشواقُ في ساعةٍ شُق","قَةَ ما تخبِطُ السحائبُ شهرا",22,"ر",2,0],["جشمتُ خِطار الموت دون وفائهِ","أو الفَقْرَ والحالانِ مُستَويانِ",23,"ن",1,0],["جَشَّمتُها سَرحَ البَداهَةِ دَوسَراً","متَشَذّراً سَلسَ الفَقارَةِ خَيطَفا",24,"ف",2,0],["جَشَّمتُها لَغَبَ المَطيِّ فَساجِدٌ","لا يَستَفيقُ مِنَ الكَلالِ وراكع",25,"ع",1,0],["جشَّمته مطلباً ضاهيَ إرادتهُ","فرامَه بعزيز النّفس مُصطبرِ",26,"ر",1,0],["جشّمتَ نفسك عن بنيك مشقةً","ما أثقلتك عن العُلى الأَعوامُ",27,"م",1,0],["جشمني ذلك وجدي بها","وفضلها بين النساء الوسام",28,"م",1,0],["جَشَّمتُ نفسي خُطَّةً صَعْبَةً","فيه أَتَتهُ يِرَدًى تائِحِ",29,"ح",1,0],["جَشِمتُ عَلَيها الهَولَ أَمّا نَهارُها","فَوَخذٌ وَأَمّا لَيلُها فَذَميلُ",30,"ل",1,0],["جشمت نفسك همة تبغى بها","إرضاء قومك لا على أو مالا",31,"ل",2,0],["جشية جربا لها","عذب الترشف سلسبيل",32,"ل",1,0],["جشّمتهُ الكأس يعلو وجهها لهَبٌ","فَوَلّدتهُ جديداً أيّ تَولِيدِ",33,"د",1,0],["جشع ابن آدم ثار ثائره وكم","ذهبت بلبه نشوة التمويل",34,"ل",1,0],["جشع أفعم القلوب بنار","من جحيم الشقاء والشحناء",35,"ا",2,0],["جشَّمتُها جَوبَ الحزونِ فارقلت","رَقلاً تشوب الوَخْدَ بالوَسجانِ",36,"ن",1,0],["جَشَّمتُها تيهاء ليسَ تجوزُها","إلا ظبيً ونحائضُ ورَوامحُ",37,"ح",1,0],["جَشّمتها تقطيعَ جوزِ مفازةٍ","ما يستبينُ عليه ميسم منسم",38,"م",1,0],["جشعٌ قاتلٌ وَحقدٌ حقودٌ","وغرورٌ يطيشُ فوق غرورِ",39,"ر",1,0],["جشع تمترس خلف كل حشاشة","نامت ونام منبه الوجدان",40,"ن",1,0],["جشمتها الأشواقُ في ساعة ٍ شق","ة َ ما تخبطُ السحائبُ شهرا",41,"ر",2,0]]}