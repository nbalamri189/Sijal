{"poems":[[30,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[51,"قبلته فمج في جوف فيها","https://www.aldiwan.net/poem65434.html","الخفيف"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[91,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[85,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[66,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[97,"كم أغر في بواكيرِ الصبا","https://www.aldiwan.net/poem24387.html","الرمل"],[44,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[31,"لم تدر وليغفر لها ربها","https://www.aldiwan.net/poem42557.html","السريع"],[31,"هلا ارعويت فترحمي صبا","https://www.aldiwan.net/poem42612.html","الكامل"],[48,"نفر النوم واحتمى","https://www.aldiwan.net/poem65232.html","مجزوء الخفيف"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[46,"دنياك تشبه ناضحا متردا","https://www.aldiwan.net/poem22575.html","الكامل"],[91,"بنت سورية","https://www.poetsgate.com/ViewPoem.aspx?id=53216",""],[97,"بطل الأبطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63541&r=&rc=87",""],[192,"فتقت بالهجر دروز الهوى","https://www.aldiwan.net/poem27549.html","السريع"],[195,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[305,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[461,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"]],"verses":[["جَشَمتُ إِلَيكَ البُعدَ لا في خُصومَةٍ","وَلا مُستَجيراً مِن جَريرَةِ مُجرِمِ",0,"م",1,0],["جَشَّمَتْها المُرَّين من حب أير","بالغٍ كل مبلغٍ مبلوغ",1,"غ",1,0],["جَشِمْتَ عناءً لا عناءَ وراءهُ","فدعْ عنكَ ما أعيا ولا تَجْشَم الجُشَمْ",2,"م",1,0],["جَشَّمتُهُ صَبراً فَلَمّا لَم يَطُق","جَشَّمتُهُ التَصويب وَالتَصعيدا",3,"د",2,0],["جَشَّموها كُلَّ أَمرٍ مُعضِلٍ","وَهِيَ لَم تُخلَق لِغَيرِ المَنزِلِ",4,"ل",1,0],["جَشِمتِ شَوكَ السُرى حَتّى أَتَيتِ لَنا","بِالوَردِ كُتباً وَبِالرَيّا عَناوينا",5,"ن",2,0],["جَشَّمتُماها مِنَ الأَهوالِ أَربَعَةً","الرَعدَ وَالبَرقَ وَالإِعصارَ وَالظُلَما",6,"م",2,0],["جَشَّمتَها جُرداً إِذا رُمتَ العُلى","أَرسَلتَها فَجَرَت إِلى غاياتِها",7,"ت",3,0],["جَشَّمتُهُ وَهوَ يَثني جيدَهُ مَلَلاً","كَأساً إِذا بَسَمَت في وَجهِهِ كَلَحا",8,"ح",2,0],["جشمته خطةً داميةً","وعرةَ المسلكِ حُفَّت بالألم",9,"م",1,0],["جِش لي بِبَحرٍ واحِدٍ أُغرِقكَ في","مَدحٍ أَجيشُ لَهُ بِسَبعَةِ أَبحُرِ",10,"ر",1,0],["جَشَّمَتِ الهَولَ بَراذينَنا","نَسأَلُ عَن بَيتِ أَبي خالِدِ",11,"د",1,0],["جَشِمَ الزِيارَةَ عَن مَوَدَّتِكُم","فَأَرادَ أَن لا تَحقَدي ذَنبا",12,"ب",2,0],["جَشَّمتَ قَلبَكَ الصَبا","بَةَ حَتّى تَجَشَّما",13,"م",2,0],["جَشَمتُهُ أَفضى وَشيحَ الجِلدِ","طَيَّ السَخاوِيِّ بِغَيرِ نِدِّ",14,"د",1,0],["جَشِبٌ كَفاكَ مُطاعِماً وَعَباءَةٌ","أَغنَتكَ أَن تُتخَيَّرَ الأَوبارُ",15,"ر",1,0],["جشّمةها كلّ أمر معضل","وهي لم تخلق لغير المنزل",16,"ل",1,0],["جشمته خطة دامية","وعرة المسالك حفت بالألمْ",17,"م",1,0],["جَشَمَتني يا طيلَسانُ النَوى","مِنكَ عَلى شوزَكتي وَجدي",18,"ي",1,0],["جَشَموا السُرى بَعدَ الرواحِ فَأَصبَحوا","سودَ الوجوهِ بِهِم سُهامَ سَمائِمِ",19,"م",1,0],["جشّمتَني إذناً لكم بزيارةٍ","أَنتم بِها منّي أحقّ وأجدرُ",20,"ر",1,0],["جشَّمتْها الأشواقُ في ساعةٍ شُق","قَةَ ما تخبِطُ السحائبُ شهرا",21,"ر",2,0],["جشمتُ خِطار الموت دون وفائهِ","أو الفَقْرَ والحالانِ مُستَويانِ",22,"ن",1,0]]}