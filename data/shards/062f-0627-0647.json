{"poems":[[50,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[7,"صل صفاً لا تنطوي من القصر","https://www.aldiwan.net/poem1990.html","الرجز"],[164,"إن له فرط غرام وأسا","https://www.aldiwan.net/poem58976.html","الرجز"],[230,"أدك أمير الأغصان","https://www.aldiwan.net/poem55083.html","عموديه"],[1203,"","https://poetry.dctabudhabi.ae/diwan/poem/28276","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108481","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77422","الخفيف"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4679,"لا مرحباً بالزائر الجائرِ","https://www.poetsgate.com/ViewPoem.aspx?id=142767",""],[4680,"الوطن الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=185017",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5829,"دنيا غرور","https://www.poetsgate.com/ViewPoem.aspx?id=178227",""]],"verses":[["داهِيَةٌ تَخبِطُ أَعجازُها","خَبطاً يُحِسّيها الأَمَرّينا",0,"ن",2,0],["داهِيَةٌ قَد صَغُرَت مِنَ الكِبَر","كَأَنَّما قَد ذَهَبَت بِها الفِكَر",1,"ر",1,0],["داهية متى تصادف ذا دها","يهلك من داهنه وما دهن",2,"ن",1,0],["داهجر وصبابه وفِراء","يا رب هوّن",3,"ن",1,0],["داهِيَةٌ مِن دَواهي اللَيلِ بَيَّتَني","مُجاهِراً يَبتَغي نَفسي وَما خَتَلا",4,"ل",2,0],["داهمته ظلامة فتمنى","لو قضى النحب قبل تلك الظلامه",5,"م",2,0],["داهَمَتنا أَحداثُهُ في الفَيافي","وَغَزَتنا في باذِخاتِ القُصورِ",6,"ر",1,0],["داهمتْنا الوحوشُ من كلّ فَجٍّ","وتَوالت شراذمُ القرصانِ",7,"ن",1,0],["داهمَ بيروت على غرَّةٍ","تعساً له من طارق ماكرِ",8,"ر",1,0],["داهمتها برابرٌ ومغولٌ","فاستبدّ الردى وضجَّ السلاحُ",9,"ح",1,0],["داهاهم بها جهراً وأخرى فجاءة","فاقحمهم حوض المنايا وأوردا",10,"د",2,0],["داهمتني خلسة والعيش مرُّ","فاستحلت مضجعي دكت خبائي",11,"ا",3,0]]}