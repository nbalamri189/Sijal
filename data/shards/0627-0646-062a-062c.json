,"https://poetry.dctabudhabi.ae/diwan/poem/85196","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135769","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44904","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105561","الرمل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143842","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36692","الدوبيت"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136869",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73162","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73115","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136747",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104528","الرمل"],[4739,"الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=36921",""],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[4767,"قل للرجال","https://www.poetsgate.com/ViewPoem.aspx?id=175120",""],[585,"يا رب أقدام كان الداء منحسما","https://www.poetsgate.com/ViewPoem.aspx?id=161846",""],[5111,"شَجْوُ نَايٍ","https://www.poetsgate.com/ViewPoem.aspx?id=212215",""],[5136,"هنيت بالإقبال والنصر","https://www.poetsgate.com/ViewPoem.aspx?id=121574",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5333,"ما رأينا من غايةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=8880",""],[5542,"شموخ اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=10072",""],[5558,"أَنتِ يا أُمِّي مَلاكٌ","https://www.poetsgate.com/ViewPoem.aspx?id=211878",""],[5568,"هي الحوادث لا ترمي سوى العلم","https://www.poetsgate.com/ViewPoem.aspx?id=169348",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[402,"دين هذا الجميل كيف يؤدى","https://www.poetsgate.com/ViewPoem.aspx?id=35452",""],[5804,"لستُ مغرورًا ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=214757",""],[5956,"قلبي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=193291",""],[6229,"مرآةُ عصرنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65213&r=&rc=36",""],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[6355,"الطريق إلى مهجتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66572&r=&rc=32",""]],"verses":[["إِنْ تَجْهَلا ما يُناجِيني الحِفاظُ بِهِ","فَالرُّمْحُ يَعْلَمُ ما أَبْغِيهِ وَالفَرَسُ",0,"س",1,0],["أَنتَ جَلّادُنا فَلا تَنسَ أَنّا","قَد لَبِسنا عَلى يَدَيكَ الحِدادا",1,"د",2,0],["أنت جيردٌ بالذي نلته","من الهناء الأوفر الأجزل",2,"ل",1,0],["إن تجزع الزهر الطويل بقاؤها","ما عذر أصحاب المدى المتقاصر",3,"ر",1,0],["إن تجد لي منه بفضلٍ فبادر","ولك الفضل تغتنم شكراني",4,"ن",2,0],["أن تجريدها من الثوب يحكي","أنفساً جُرّدت من الآثام",5,"م",1,0],["أنتجت بعده فأوحش أرضاً","في العراقين عوّدت إيناسه",6,"س",2,0],["أنت جارٌ للشافعيّ وقلبي","مالكيّ الأهواء والأهوال",7,"ل",1,0],["أنت جِدِّيها وغيرك من يل","عب إن الرِّجال غيرُ النِّساءِ",8,"ا",2,0],["أنت جيش مثقّل غير مهتز","زٍ ولكن ما شئت من مهزوز",9,"ز",1,0],["إن تجالسْهُ فالدماثة منه","أو توكِّله تَبْلُ منه جزالهْ",10,"ل",2,0],["أَنتَ جانٍ أَيُّ جانِ قاطِلٌ في غَيرِ ثارِ","أَفَيَرضى اللَهُ عَن هَذا وَيَعفو لَستُ أَدري",11,"ي",1,0],["أَنتَ جِزءٌ مِنهُ لَكِن لَستَ تَدري كَيفَ غاب","وَهُوَ لا يَعلَمُ ما تَحوي أَيَدري لَستُ أَدري",11,"ي",1,0],["أَنتَ جُزءٌ مِنَ الكَيانِ وَفيهِ","كَثَراهُ كَنَبتِهِ كَحَصاهُ",12,"ا",2,0],["أَنْتَ جَبَّلْتَ بَيْنَ جنْبيَّ قلباً","سَرْمَديّ الشُّعورِ والانتباهِ",13,"ه",1,0],["انت جديرة بحق","ان تكوني الآمره",14,"ر",2,0],["إِن تُجَرِّب بَني الزَمانِ تَجِدهُم","إِخوَةً فيهِ كَالشِفارِ الكَليلَه",15,"ل",2,0],["إِن تُجمِعوا أَمرَكُم تَصلُح خِلافَتَكُم","وَفي الجَماعَةِ ما يَستَمسِكُ العَمَدُ",16,"د",1,0],["إن تَجفُها ديَمُ السَّحابِ فما جَفا","أطلالَها دمعٌ يُرَقْرِقُه الجَفا",17,"ف",2,0],["إن تجد يا قلبُ قلباً قد لَهَا","عن حبيبٍ مات فيه وَلَها",18,"ه",2,1],["أَنتَ جُبتَ الظَلامَ عَن سُبُلِ الآ","مالِ إِذ ضَلَّ كُلُّ هادٍ وَحادِ",19,"د",1,0],["إنْ تُجِزْني عنْ مديحي صرتُ في","رقِّها أوْ لا فيكفيني الخجلْ",20,"ل",1,0],["إِن تَجودي أَو تَبخَلي فَبِحَمدٍ","لَستِ يا نُعمُ فيهِما مِن يُذَمُّ",21,"م",1,0],["إِن تَجودي أَو تَبخَلي فَبِحَمدٍ","أَنتِ مِن واصِلٍ لَنا لا تُذَمّي",22,"م",2,0],["إِن تَجودي فَطالَما","بِتُّ لَيلي مُسَهَّدا",23,"د",2,0],["إِن تُجِدَّ الوِصالَ مِنكَ فَإِنّا","قَبَّحَ اللَهُ بَعدَها مَن خَدَعتا",24,"ت",2,0],["أَن تُجيزوا وَتَشهَدوا لِنِساءٍ","وَتَرُدّوا شَهادَةً لِنِساءٍ",25,"ا",2,0],["إن تَجْهَلُوُه فإنّه السِّر الذي","يُحيي النُّفوسَ إذا تَموتُ وتقْبَرُ",26,"ر",1,0],["إن تجهلوا معنى الحِما","يةِ فاسألوا أهلَ الدّرايهْ",27,"ا",3,0],["أَنتَ جَنى العودِ وَمَوتُ الرِئدِ","مُتَوَّجُ الآباءِ ضَخمُ الرِفدِ",28,"د",1,0],["إِن تَجفُني فَإِنّي اِمرُؤٌ","أَصبو وَأَصبي رُبَّما قَد جُفيتُ",29,"ت",1,0],["إِن تَجعَلِ اللَجَّةَ الخَضراءَ واقِيَةٌ","فَالمُلكُ يُحفَظُ بِالخُضرِ اليَعابيبِ",30,"ب",1,0],["إنْ تجهلوا فسلوا به آباءَكُم","أيامَ شَعَّ عدالَةً ورِغادا",31,"د",2,0],["إِن تَجرِ طَيرٌ بِأَمرٍ فيهِ عافِيَةٌ","أَو بِالفِراقِ فَقَد أَحسَنتُمُ زادي",32,"د",2,0],["أَنْتَ جَدِيرٌ بِالَّذِي نِلْتَهُ","مِنَ الصَّفَاءِ الأوْفَرِ الأجْزَلِ",33,"ل",1,0],["إِنْ تُجَزَّأْ مِنْ وَحْدَةٍ لَمْ يَكُنْ حَ","دُّكَ فِي الْقَلْبِ غَيْرَ مَا كَانَ حَدَّا",34,"د",2,0],["إِن تَجِد قُوايَ فَقُل","لِلخطوبِ تَعتَرِها",35,"ر",3,0],["أَنْ تَجَشَّمْتَهُ وإِنْ كَانَ إِلاَّ","مِثْلَ ما يأْنَسُ الفَتَى بأَخِيهِ",36,"ي",2,0],["أنت جديُّها وغيرك من يلعبُ","راحة النفس والصيانة والعف",37,"ف",1,0],["أنت جلاد الناس تسرف في الق","تل وأنت المفاجئ الهدام",38,"م",1,0],["إن تجد حسنا فخذه واطّرح ما ليس حسنا","إنّ بعض القول فنّ فاجعل الإصغاء فنّا",39,"ن",2,0],["أَن تَجلى في دُجى مِن شِعرِهِ","فاقَ بِالإِشراق نور النيرين",40,"ن",1,0],["إن تجودوا سحبت ذيلاً وفلا","أو تضنوا فلست أعدم خلا",41,"ل",2,0],["أَنتَ جوزينَج القُلوبَ وَفي اللي","نِ كَلينَ الخَبيصَةِ البَيضاءِ",42,"ا",2,0],["إن تجدْ قلباً كقلبي","تلقَ حباً مثلَ حبي",43,"ب",2,1],["إن تجد يا شهر بالروح الحبيب","كنت أنت الزهر في روض القلوب",44,"ب",1,0],["انت جاري وعدتي ونصيري","وعمادي في شدتي ورخائي",45,"ا",2,0],["أَنتَ جَلَبتَ الهَمَّ يا","طَرفي لِقَلبي فَذُقِ",46,"ق",1,0],["إِن تجلُ غرَّتَها فالصبحُ متَّضحٌ","أَو تُرخِ طرَّتها فالليلُ مُعتكِرُ",47,"ر",1,0],["أَنتَ جدَّدتَ بتَذكارِهُمُ","للحشى وَجداً وَللطَرف اِختلاجا",48,"ج",2,0],["إِنت جِئتَ يا صاحِ أَهلاً","تَجِد هُناكَ أَهلِكَ",49,"ك",1,0],["إِن تَجمَعِ الشَملَ مِن غَيظٍ وَما أَلَبَت","أَو المَحاشي فَأَنتَ الرّائِشُ الباري",50,"ر",2,0],["أنت جبّاره لك الحول والقو","ة ميّزت صبحه من مسائه",51,"ا",3,0],["إن تجهّمتَ فالحياة عبوسٌ","أو تهلّلت فهي نبع صفاء",52,"ا",2,0],["أنت جمر شبته أنفاس ماضيه","فما ينطفى بغير الماء",53,"ا",2,0],["إن تَجد ذَنبي قَبيحاً","فاِصفح الصَفح الجَميلا",54,"ل",2,0],["أَنتَجت يا بَدر العُلى دُرّة","يَحسدها شانئك الأبترُ",55,"ر",1,0],["أنت جمال الوجود طبعا","وأنت روح الزمان وضعا",56,"ع",2,0],["إنْ تجِدْ في رُضابِهِ سَلسَبيلاً","فإلى سلسبيلِهِ سَلْ سبيلا",57,"ل",2,1],["إنْ تُجرِّده كاشفاً لِمُلِمٍّ","فكما جرَّدَت يمينك نصلا",58,"ل",2,0],["إنْ تجرِّده على الدهر يدٌ","فَلَقَتْ من خطبه هاماً فهاما",59,"م",2,0],["أنت جوادٌ والنوى مَبخَلَةٌ","ما أعجبَ البخلَ من الجوادِ",60,"د",1,0],["اِنْ تُجبْ أو لا تُجِبْ قائلَهُ","فسفِيهٌ أنتَ منهُ أو ذَيلْ",61,"ل",1,0],["أن تجلَّى لك الحسود فكم جلَّي","تَ في حلبة المعالي وصلَّى",62,"ل",2,0],["أنت جوادٌ حبست عن أمدِ","لو أصبح اليومُ مرخياً طولك",63,"ك",1,0],["إن تجاهلت أو تصاممت عنا","فسل البلمريوم فهو خبير",64,"ر",1,0],["أنت جندي ولكن","فيك للحسن جنود",65,"د",1,0],["إِنْ تَجدنِي سَمْحَ القِيادِ ففي قْل","بِ زَماني مِن حرِّ نارِي وجيبُ",66,"ب",1,0],["أنت جسمٌ من ترابٍ","فيه روح متلالي",67,"ل",2,0],["إن تَجُز يوماً بذي سلم","قل لهم جودوا ببعض لقا",68,"ق",2,0],["أنتجت فرط الكلام له","خلطة إذ أمره فرط",69,"ط",1,0],["إِنَّ تجنَّيك فلا ذقْتَهُ","علَّم قلبي كيفَ يَنْسَاكَا",70,"ك",2,1],["إِن تَجودي أَو تَبخَلي أُمَّ عَمروٍ","حَبَّذا أَنتِ مِن حَبيبٍ مُصافِ",71,"ف",1,0],["إن تجدّد لكَ العروبة ذِكرا","فلقد عَظّمت لشنصك قَدرا",72,"ر",2,1],["إنْ تَجْمَع الأيَّامُ شَمْلي بِهِ","لم تَبْقَ للنَّفسِ عَلى اللهِ حاجْ",73,"ج",1,0],["أنتجعُ اللهوَ إِذا","منزلهُ عنّي شَحَط",74,"ط",1,0],["إنْ تجَدْ فرصةً أُخَىَّ فبادر","وانتهزْها في غاية الانتهاز",75,"ز",1,0],["إن تجودا أنتم لذلك أهل","أو تصدُّوا فشيمةٌ للغزال",76,"ل",1,0],["إِن تَجهَل العَجَبَ العُجا","بَ فَإِنَّنا العَجَبُ العِجابْ",77,"ب",1,0],["إِن تَجِد بابَ الأَماني مُغلَقاً","لا تُكَشِّرْ أَو تَلُم مَن سَكَّرَهْ",78,"ه",1,1],["إن تجنّى أو تجلّى","فلقد رمنا اجتناءَ",79,"ا",2,0],["إن تجلَّت عنه الحروب قليلاً","خلفتها زلازل وخطوب",80,"ب",1,0],["أَنتَ جوادٌ وِردُ إِنعامه","واردُه لم يخش يوماً جُواد",81,"د",1,0],["انتج من برة فرجى","إلى ذرى منبر ومن بر",82,"ر",1,0],["أنت جهل وفيك يظهر سر","ان تحققه بدا منه علم",83,"م",1,0],["انتجها القلب الذي","كانت لديه مودعه",84,"ع",2,0],["إن تجودي على سوانا بسقيٍ","فاذكرينا إنّا إليك ظوامي",85,"م",2,0],["أنت جليل رغم حكم الثرى","ولا يهين الموت قدر الجليل",86,"ل",1,0],["ان تجعل اللفظ لوحا حسب ظاهره","فاعط الرئيس حساب الدخل في المينا",87,"ن",2,0],["أنت جيشٌ من السَّلامة يغزو","كلَّ سقم فما لسقمِ نَجاءُ",88,"ا",2,0],["اِنتَجَعَ الفَضلُ أَو تَخَلَّ مِنَ الدُن","يا فَهاتانِ غايَتا الهِمَمِ",89,"م",1,1],["أنت جاهي في الأنام وذخ","ري ومأمولي ومعتصمي",90,"م",2,0],["إن تجدني أطلتُ نحوكَ تِردا","دِيَ بالعَتبِ جيئةً وذهابا",91,"ب",2,0],["إن تُجاوز فقد قَدرتَ عليهم","أو تُعاقب فلم تُعاقِب بريّا",92,"ي",2,1],["أنت جددت عصر يوسف بالمع","روف يا مقتفيه قولاً وفعلا",93,"ل",2,0],["إِن تَجافَيتَ مُنعِماً كُنتَ أَولى","مَن تَجافى عَنِ الذُنوبِ الكِبارِ",94,"ر",1,0],["إن تجديدَ الأغاني","في عُلا الشعبِ المجيد",95,"د",1,1],["إِن تَجحَدِ العُجمُ فَضلَ العُربِ قُل لَهُمُ","خَيرُ الوَرى مِنكُمُ أَم مِن صَميمِهِمِ",96,"م",1,0],["إِن تُجزنا بِالعَتب ذماً فاحِشاً","فَبِما حَواه رَشحُ كُل إِناء",97,"ا",2,0],["إن تجلَّتْ والحَلْيُ يلمعُ شاهدْ","تَ نجوماً تمشي بهنَّ بدورُ",98,"ر",1,0],["إِنْ تَجَلَّى للفص