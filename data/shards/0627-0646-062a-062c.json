{"poems":[[63,"يا صاحبي خذا للسير أهبته","https://www.aldiwan.net/poem45929.html","البسيط"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[93,"يا ليل أبدعت نظام الحلى","https://www.aldiwan.net/poem9846.html","السريع"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[93,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11075.html","الخفيف"],[88,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[88,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[51,"يا علي العلا ابن قاسم القاسم","https://www.aldiwan.net/poem65944.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[89,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[45,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[28,"إذا تقاعس صعب في خزامته","https://www.aldiwan.net/poem4994.html","البسيط"],[61,"هذي المعارف منهم فتعرفا","https://www.aldiwan.net/poem51553.html","الكامل"],[97,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[31,"طال ليلى واعتادني اليوم سقم","https://www.aldiwan.net/poem41336.html","الخفيف"],[31,"يا خليلي عادني اليوم سقمي","https://www.aldiwan.net/poem41337.html","الخفيف"],[31,"قل لهند وتربها","https://www.aldiwan.net/poem42558.html","مجزوء الخفيف"],[31,"أرسلت خلتي إلي بأنا","https://www.aldiwan.net/poem42604.html","الخفيف"],[31,"يا قضاة العباد إن عليكم","https://www.aldiwan.net/poem42665.html","الخفيف"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[105,"يا قوم ماذا تحملو","https://www.aldiwan.net/poem43057.html","مجزوء الكامل"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[50,"مهلا أخي لم تلق ما قد لقيت","https://www.aldiwan.net/poem64744.html","السريع"],[46,"لا يحسب الجود من رب النخيل جدا","https://www.aldiwan.net/poem22336.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1670","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55210","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[45,"يا بْنَ مَنْ طَابَ في المَوَالِيدِ حُرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=31683",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[107,"هب يجلو الراح في كاس اللجين","https://www.aldiwan.net/poem16521.html","الرمل"],[118,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[190,"يا شبيه الفالوذ في حمرة الخد","https://www.aldiwan.net/poem27574.html","الخفيف"],[197,"إن تجد قلبا كقلبي","https://www.aldiwan.net/poem45212.html","مجزوء الرمل"],[209,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[229,"زار وهنا ونحن بالزوراء","https://www.aldiwan.net/poem44600.html","الخفيف"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[295,"وافتك والزهر في روض الدجى زهر","https://www.aldiwan.net/poem33266.html","البسيط"],[295,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[318,"أبا الفضائل مهلا","https://www.aldiwan.net/poem61702.html","المتقارب"],[322,"أبلغ زياداً وحين المرء يدركه","https://www.aldiwan.net/poem2064.html","البسيط"],[326,"مزجت مصر دمعها بدمائه","https://www.aldiwan.net/poem55012.html","الخفيف"],[326,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[351,"لا تسل ما سبب البع","https://www.aldiwan.net/poem39990.html","مجزوء الرمل"],[351,"يا حسن مرآة زها حسنها","https://www.aldiwan.net/poem40187.html","السريع"],[400,"بستان أنس به أقمنا","https://www.aldiwan.net/poem33684.html","مخلع البسيط"],[402,"إن تجد في رضابه سلسبيلا","https://www.aldiwan.net/poem49781.html","الخفيف"],[413,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[413,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[456,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[459,"احذر الهزل وجانب أهله","https://www.aldiwan.net/poem16008.html","الرمل"],[462,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[462,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[477,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[540,"أيها الركب ثوباه","https://www.aldiwan.net/poem34025.html","مجزوء الرمل"],[549,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[556,"أنت إنسان خيالي","https://www.aldiwan.net/poem34208.html","مجزوء الرمل"],[556,"قمر من فوق غصن نقا","https://www.aldiwan.net/poem34336.html","المديد"],[556,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[573,"إن تجنيك فلا ذقته","https://www.aldiwan.net/poem2896.html","السريع"]],"verses":[["إِنْ تَجْهَلا ما يُناجِيني الحِفاظُ بِهِ","فَالرُّمْحُ يَعْلَمُ ما أَبْغِيهِ وَالفَرَسُ",0,"س",1,0],["أَنتَ جَلّادُنا فَلا تَنسَ أَنّا","قَد لَبِسنا عَلى يَدَيكَ الحِدادا",1,"د",2,0],["أنت جيردٌ بالذي نلته","من الهناء الأوفر الأجزل",2,"ل",1,0],["إن تجزع الزهر الطويل بقاؤها","ما عذر أصحاب المدى المتقاصر",3,"ر",1,0],["إن تجد لي منه بفضلٍ فبادر","ولك الفضل تغتنم شكراني",4,"ن",2,0],["أن تجريدها من الثوب يحكي","أنفساً جُرّدت من الآثام",5,"م",1,0],["أنتجت بعده فأوحش أرضاً","في العراقين عوّدت إيناسه",6,"س",2,0],["أنت جارٌ للشافعيّ وقلبي","مالكيّ الأهواء والأهوال",7,"ل",1,0],["أنت جِدِّيها وغيرك من يل","عب إن الرِّجال غيرُ النِّساءِ",8,"ا",2,0],["أنت جيش مثقّل غير مهتز","زٍ ولكن ما شئت من مهزوز",9,"ز",1,0],["إن تجالسْهُ فالدماثة منه","أو توكِّله تَبْلُ منه جزالهْ",10,"ل",2,0],["أَنتَ جانٍ أَيُّ جانِ قاطِلٌ في غَيرِ ثارِ","أَفَيَرضى اللَهُ عَن هَذا وَيَعفو لَستُ أَدري",11,"ي",1,0],["أَنتَ جِزءٌ مِنهُ لَكِن لَستَ تَدري كَيفَ غاب","وَهُوَ لا يَعلَمُ ما تَحوي أَيَدري لَستُ أَدري",11,"ي",1,0],["أَنتَ جُزءٌ مِنَ الكَيانِ وَفيهِ","كَثَراهُ كَنَبتِهِ كَحَصاهُ",12,"ا",2,0],["أَنْتَ جَبَّلْتَ بَيْنَ جنْبيَّ قلباً","سَرْمَديّ الشُّعورِ والانتباهِ",13,"ه",1,0],["انت جديرة بحق","ان تكوني الآمره",14,"ر",2,0],["إِن تُجَرِّب بَني الزَمانِ تَجِدهُم","إِخوَةً فيهِ كَالشِفارِ الكَليلَه",15,"ل",2,0],["إِن تُجمِعوا أَمرَكُم تَصلُح خِلافَتَكُم","وَفي الجَماعَةِ ما يَستَمسِكُ العَمَدُ",16,"د",1,0],["إن تَجفُها ديَمُ السَّحابِ فما جَفا","أطلالَها دمعٌ يُرَقْرِقُه الجَفا",17,"ف",2,0],["إن تجد يا قلبُ قلباً قد لَهَا","عن حبيبٍ مات فيه وَلَها",18,"ه",2,1],["أَنتَ جُبتَ الظَلامَ عَن سُبُلِ الآ","مالِ إِذ ضَلَّ كُلُّ هادٍ وَحادِ",19,"د",1,0],["إنْ تُجِزْني عنْ مديحي صرتُ في","رقِّها أوْ لا فيكفيني الخجلْ",20,"ل",1,0],["إِن تَجودي أَو تَبخَلي فَبِحَمدٍ","لَستِ يا نُعمُ فيهِما مِن يُذَمُّ",21,"م",1,0],["إِن تَجودي أَو تَبخَلي فَبِحَمدٍ","أَنتِ مِن واصِلٍ لَنا لا تُذَمّي",22,"ي",1,0],["إِن تَجودي فَطالَما","بِتُّ لَيلي مُسَهَّدا",23,"د",2,0],["إِن تُجِدَّ الوِصالَ مِنكَ فَإِنّا","قَبَّحَ اللَهُ بَعدَها مَن خَدَعتا",24,"ت",2,0],["أَن تُجيزوا وَتَشهَدوا لِنِساءٍ","وَتَرُدّوا شَهادَةً لِنِساءٍ",25,"ا",2,0],["إن تَجْهَلُوُه فإنّه السِّر الذي","يُحيي النُّفوسَ إذا تَموتُ وتقْبَرُ",26,"ر",1,0],["إن تجهلوا معنى الحِما","يةِ فاسألوا أهلَ الدّرايهْ",27,"ا",3,0],["أَنتَ جَنى العودِ وَمَوتُ الرِئدِ","مُتَوَّجُ الآباءِ ضَخمُ الرِفدِ",28,"د",1,0],["إِن تَجفُني فَإِنّي اِمرُؤٌ","أَصبو وَأَصبي رُبَّما قَد جُفيتُ",29,"ت",1,0],["إِن تَجعَلِ اللَجَّةَ الخَضراءَ واقِيَةٌ","فَالمُلكُ يُحفَظُ بِالخُضرِ اليَعابيبِ",30,"ب",1,0],["إنْ تجهلوا فسلوا به آباءَكُم","أيامَ شَعَّ عدالَةً ورِغادا",31,"د",2,0],["إِن تَجرِ طَيرٌ بِأَمرٍ فيهِ عافِيَةٌ","أَو بِالفِراقِ فَقَد أَحسَنتُمُ زادي",32,"د",2,0],["أَنْتَ جَدِيرٌ بِالَّذِي نِلْتَهُ","مِنَ الصَّفَاءِ الأوْفَرِ الأجْزَلِ",33,"ل",1,0],["إِنْ تُجَزَّأْ مِنْ وَحْدَةٍ لَمْ يَكُنْ حَ","دُّكَ فِي الْقَلْبِ غَيْرَ مَا كَانَ حَدَّا",34,"د",2,0],["إِن تَجِد قُوايَ فَقُل","لِلخطوبِ تَعتَرِها",35,"ر",3,0],["أَنْ تَجَشَّمْتَهُ وإِنْ كَانَ إِلاَّ","مِثْلَ ما يأْنَسُ الفَتَى بأَخِيهِ",36,"ي",2,0],["أنت جديُّها وغيرك من يلعبُ","راحة النفس والصيانة والعف",37,"ف",1,0],["أنت جلاد الناس تسرف في الق","تل وأنت المفاجئ الهدام",38,"م",1,0],["أَن تَجلى في دُجى مِن شِعرِهِ","فاقَ بِالإِشراق نور النيرين",39,"ن",1,0],["إن تجودوا سحبت ذيلاً وفلا","أو تضنوا فلست أعدم خلا",40,"ل",2,0],["أَنتَ جوزينَج القُلوبَ وَفي اللي","نِ كَلينَ الخَبيصَةِ البَيضاءِ",41,"ا",2,0],["إن تجدْ قلباً كقلبي","تلقَ حباً مثلَ حبي",42,"ي",1,1],["إن تجد يا شهر بالروح الحبيب","كنت أنت الزهر في روض القلوب",43,"ب",1,0],["انت جاري وعدتي ونصيري","وعمادي في شدتي ورخائي",44,"ا",2,0],["أَنتَ جَلَبتَ الهَمَّ يا","طَرفي لِقَلبي فَذُقِ",45,"ق",1,0],["إِن تجلُ غرَّتَها فالصبحُ متَّضحٌ","أَو تُرخِ طرَّتها فالليلُ مُعتكِرُ",46,"ر",1,0],["أَنتَ جدَّدتَ بتَذكارِهُمُ","للحشى وَجداً وَللطَرف اِختلاجا",47,"ج",2,0],["إِنت جِئتَ يا صاحِ أَهلاً","تَجِد هُناكَ أَهلِكَ",48,"ك",1,0],["إِن تَجمَعِ الشَملَ مِن غَيظٍ وَما أَلَبَت","أَو المَحاشي فَأَنتَ الرّائِشُ الباري",49,"ر",2,0],["أنت جبّاره لك الحول والقو","ة ميّزت صبحه من مسائه",50,"ا",3,0],["إن تجهّمتَ فالحياة عبوسٌ","أو تهلّلت فهي نبع صفاء",51,"ا",2,0],["أنت جمر شبته أنفاس ماضيه","فما ينطفى بغير الماء",52,"ا",2,0],["إن تَجد ذَنبي قَبيحاً","فاِصفح الصَفح الجَميلا",53,"ل",2,0],["أَنتَجت يا بَدر العُلى دُرّة","يَحسدها شانئك الأبترُ",54,"ر",1,0],["أنت جمال الوجود طبعا","وأنت روح الزمان وضعا",55,"ع",2,0],["إنْ تجِدْ في رُضابِهِ سَلسَبيلاً","فإلى سلسبيلِهِ سَلْ سبيلا",56,"ل",2,1],["إنْ تُجرِّده كاشفاً لِمُلِمٍّ","فكما جرَّدَت يمينك نصلا",57,"ل",2,0],["إنْ تجرِّده على الدهر يدٌ","فَلَقَتْ من خطبه هاماً فهاما",58,"م",2,0],["أنت جوادٌ والنوى مَبخَلَةٌ","ما أعجبَ البخلَ من الجوادِ",59,"د",1,0],["اِنْ تُجبْ أو لا تُجِبْ قائلَهُ","فسفِيهٌ أنتَ منهُ أو ذَيلْ",60,"ل",1,0],["أن تجلَّى لك الحسود فكم جلَّي","تَ في حلبة المعالي وصلَّى",61,"ل",2,0],["أنت جوادٌ حبست عن أمدِ","لو أصبح اليومُ مرخياً طولك",62,"ك",1,0],["إن تجاهلت أو تصاممت عنا","فسل البلمريوم فهو خبير",63,"ر",1,0],["أنت جندي ولكن","فيك للحسن جنود",64,"د",1,0],["إِنْ تَجدنِي سَمْحَ القِيادِ ففي قْل","بِ زَماني مِن حرِّ نارِي وجيبُ",65,"ب",1,0],["أنت جسمٌ من ترابٍ","فيه روح متلالي",66,"ي",1,0],["إن تَجُز يوماً بذي سلم","قل لهم جودوا ببعض لقا",67,"ق",2,0],["أنتجت فرط الكلام له","خلطة إذ أمره فرط",68,"ط",1,0],["إِنَّ تجنَّيك فلا ذقْتَهُ","علَّم قلبي كيفَ يَنْسَاكَا",69,"ك",2,1]]}