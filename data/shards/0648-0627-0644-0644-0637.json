{"poems":[[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[85,"مولاي يوم الجمعه","https://www.aldiwan.net/poem54276.html","مجزوء الرجز"],[139,"أفرح يا حنفي بأسيوط","https://www.aldiwan.net/poem48849.html","الهزج"],[309,"أقول للناظم المجيد","https://www.aldiwan.net/poem16873.html","مخلع البسيط"],[369,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[396,"أرجو من الرحمن سبحانه","https://www.aldiwan.net/poem54452.html","عموديه"],[723,"","https://poetry.dctabudhabi.ae/diwan/poem/102033","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112875","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48958","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200850","السريع"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72478","السريع"],[5281,"يا نفسُ","https://www.poetsgate.com/ViewPoem.aspx?id=199755",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""]],"verses":[["وَاللُّطْفُ بَادٍ وَالإبَاءُ مُمَثِّلٌ","فِي شَخْصِهِ المُتَأنِّقِ المُتَوانِي",0,"ن",2,0],["واللطفُ مرجوٌّ فرِدْ","بفضل ربي مَشْرَعَهْ",1,"ع",2,0],["واللطف والظرف عادتك","اجعل ودادك نادِي لهْ",2,"ه",1,0],["واللطف والعون ثم رزق","مهنا طيب رغيد",3,"د",1,0],["واللُّطْفُ منه للعبادِ وللورَى","نَيْلُ الحياةِ به معَ الأنفاس",4,"س",1,0],["واللطف والعطف مع منه","وقربه الأسنى ورضوانه",5,"ن",2,0],["واللطف لا ينفك عن","ه في الصباح وفي الأصيل",6,"ل",1,0],["وَاللُّطف مِن إِلاهنا يَصحبُنا","وَلا يرى مِن حادِث مَركبنا",7,"ن",2,0],["واللطف يشمله بكل زمانه","والسعد يتحفه بكل سماحه",8,"ح",2,0],["واللطفُ منتثرٌ ومنتظمٌ","واللطفُ نعم اللؤلؤ الرَّطِبُ",9,"ب",1,0],["واللطف يسترعيك في صمتها","كأنما الصمتُ بها ينطق",10,"ق",1,0],["وَاللُّطفُ في النّاسِ أَصدافٌ وَإِن نعمت","أَضلاعها لَم تَكُن في جَوفِها الدُّرَرُ",11,"ر",1,0],["وَاللُّطفُ لِلنّذلِ دِرعٌ يَستَجيرُ بِهِ","إِن راعَهُ وَجَلٌ أَو هالَهُ الخَطَرُ",11,"ر",1,0],["واللطف فيما اعترانا من نوائب لا","تُحصى بها كلّ قلبٍ باتَ مُنفَطِرا",12,"ر",2,0],["واللطف كالماء به تنطفي","شرارة الشرِّ لدى الاحتراق",13,"ق",1,0],["والُّلطفَ في يَومِ حَشْرٍ","إذْ دُكَّتِ الأَرضُ دَكَّه",14,"ك",2,0],["واللطف بالعبد عليه واجب","في كل فعل صالح ومأتم",15,"م",1,0]]}