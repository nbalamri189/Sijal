البسيط"],[551,"قال لجاف كلما سيم","https://www.aldiwan.net/poem47177.html","مجزوء الرمل"],[551,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[551,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[551,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[551,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[551,"لا تلمني فليس لي","https://www.aldiwan.net/poem48047.html","مجزوء الخفيف"],[562,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"],[562,"يا راحلين إلى الديار الباقيه","https://www.aldiwan.net/poem52885.html","البسيط"],[567,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[575,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[575,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[575,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[586,"لما درت أن المحب بغيرها","https://www.aldiwan.net/poem17444.html","الكامل"],[586,"إن الذي منزله","https://www.aldiwan.net/poem17590.html","مجزوء الرجز"],[586,"طرف تعرض بعدكم لهجوع","https://www.aldiwan.net/poem17592.html","الكامل"]],"verses":[["لَم أَدرِ أَنَّ الصِبا تَبلى خَميصَتُهُ","وَأَنَّ مُنصاتَ ذاكَ العودِ يَنأَطِرُ",0,"ر",1,0],["لما دعوت لها المعادن أرسلت","أفلاذها من دون ما استمساك",1,"ك",1,0],["لمّا دَعا دَاعِي الهَوَى لَبّيتُهُ","وحَثَثْتُ رَحْليَ مُسْرِعاً وأتَيْتُهُ",2,"ت",2,1],["لَمَّا دَعَتْكَ لِنَصْرِهَا لَبَّيْتَهَا","وَرَضِيتَ بَذْلَ النَّفْسِ فِي مَرْضَاتِهَا",3,"ت",3,0],["لَم أَدرِ ما يَدُهُ حَتّى تَرَشَّفَهُ","فَمُ المَشيبِ عَلى رَغمي فَأَفناهُ",4,"ا",2,0],["لم أَدَّخِرْ غير حبِّ فيك أرفعه","وسيلةٌ لكريم يوم ألقاهُ",5,"ا",2,0],["لم أدرِ والأيام ذات عجائبِ","تردادها يحلو على التذكارِ",6,"ر",1,0],["لما دعاك إلى القيام بسنة","حكَّمْتَ داعي الجود والإيثارِ",7,"ر",1,0],["لم أدرِ من شغفٍ بها وبهذه","من منهما فَتَن القلوب ومن كَسَرْ",8,"ر",1,0],["لم أدر والآثار منه كثيرة","في الغرب لم نزرت وقلّت عندنا",9,"ن",2,0],["لما دَنوت إليها كي أسائلها","والقلب في خَطَران كالأراجيح",10,"ح",1,0],["لم أدر جدٌّ فعلكم أم هودَد","فإن أجنادك جاءوا بالفَنَد",11,"د",1,0],["لَمّا دَعا الداعي لِأَعيَنَ لَم تَكُن","لِتَفعَلَ فِعلَ المازِنِيِّ بنِ أَخضَرا",12,"ر",2,1],["لَمّا دَعاني عامِرٌ لِأَسُبَّهُم","أَبَيتُ وَإِن كانَ اِبنُ عَيساءَ ظالِما",13,"م",2,1],["لما دعَا الدَّعوةَ الأولى فأسْمعني","لبستُ بُردَيَّ واسْتمررتُ أدراجِي",14,"ي",1,0],["لم أدر في المدّاح أن قد أتى","علاء دين الله نجل كريم",15,"م",1,1],["لما دنَا زمان رمي البندق","سرنا على وجهِ السُّرور المشرق",16,"ق",1,0],["لَمْ أدْرِ هل أبدتْ حَباباً زاهراً","أو عكسَ نورِ كواكب الجوزاءِ",17,"ا",2,0],["لمّا دخلنا دخلتْ نِعمةٌ","كان لها حولكَ تَحْويمُ",18,"م",1,0],["لَم أَدرِ بِالبَينِ حَتّى أَزمَعوا ظَعناً","كُلُّ الجِمالِ قُبَيلَ الصُبحِ مَزمومُ",19,"م",1,0],["لَم أَدرِ ما السَبَبُ الَّذي","قَد كانَ بَينَهُما وَبَيني",20,"ن",2,0],["لَم أَدرِ كَيفَ أُجيبُ ما","حَبَّرتَهُ نَظماً وَنَثرا",21,"ر",2,0],["لَم أَدرِ إِذ جُنَّ الظَلامُ أَلَوعَةٌ","بَينَ الحَشا أَم ذاتُ سُمٍّ تَلسَبُ",22,"ب",1,0],["لَمّا دَعا الدَعوَةَ الأولى فَأَسمَعَني","أَخَذتُ بُردَيَّ وَاِستَمرَرتُ أَدراجي",23,"ج",2,0],["لَمّا دَنا البَينُ بَينُ الحَيِّ وَاِقتَسَموا","حَبلَ النَوى فَهوَ في أَيديهِمُ قِطَعُ",24,"ع",1,1],["لم أدر ساعة لي نعاه نعيه","ماذا أصاب القلب تحت ضلوعي",25,"ي",1,0],["لما دعا داعى المعز إلى القِرى","شدّت صحارٍ رحلها وقفار",26,"ر",1,0],["لَمّا دَعا داعي أَبي الأَشبالِ","مُبَشِّراً بِأَوَّلِ الأَنجالِ",27,"ل",1,1],["لَمّا دَعا الصَحبُ يَستَسقونَ مِن ظَمَإٍ","فاضَت يَداهُ مِنَ التَسنيمِ بِالسَنَمِ",28,"م",1,0],["لم أَدر ما طِيبُ العِناقِ على الهوى","حتى ترفَّق ساعدي فطواكِ",29,"ك",1,0],["لَمّا دُعيتُ أَتَيتُ أَنثُرُ مَدمَعي","وَلَوِ اِستَطَعتَ نَثَرتُ جَفني في الثَرى",30,"ر",2,0],["لَم أَدرِ ما أَسكَرَني أَطَرفُهُ","أَم الَّتي يَدعونَها بِنتُ العِنَب",31,"ب",1,0],["لَم أَدَع مِن مَناقِبِ المَجدِ ما يُق","نِعُ مَن هَمَّ أَن يَكونَ مَجيدا",32,"د",2,0],["لم أَدْرِ إذ حَثَّ السُّقاةُ كُؤوسها","أكَواكِباً يَحمِلْنَ أَم أقداحا",33,"ح",2,0],["لَم أَدرِ أَنَّ نِبالَ الغُنجِ وَالكَحَلِ","تَحتَ السَوابِغِ تُصمي مُهجَةَ البَطَلِ",34,"ل",1,1],["لَم أَدرِ قَبلَ هَواهُم وَالهَوى حَرَمٌ","أَنَّ الظِباءَ تُحِلُّ الصَيدَ في الحَرَمِ",35,"م",1,0],["لَم أَدرِ ضَوءَ الصُبحِ أَقبَلَ جَيشُهُ","مُتَبَدِّدا وَلَهُ الشُعاعُ لِواءُ",36,"ا",2,0],["لَمّا دَعاني صاحِبي لِبَرزَةٍ","وَنَبَّهَ الزَميلَ وَالمَقاوِلا",37,"ل",2,0],["لَمّا دَعَتني لِلنِزاِلِ أَقارِبي","لَبّاهُمُ عَنّي لِسانُ المُنصُلِ",38,"ل",1,0],["لم أدر ماذا يكون","ولم أسَل كيف جاء",39,"ا",2,0],["لم أدر حين تبدت لي إذا شفقي","أبصرته أو على المنصورة الشفق",40,"ق",1,0],["لَمّا دَعَوتَهُمُ لِأَخذِ عُهودِهِم","طارَ السُرورُ بِمُعرِقٍ وَشَآمِ",41,"م",1,0],["لَم أَدعُ غَيرَكَ فِيما نابَني فَقِني","شَرَّ العَواقِبِ وَاِحفَظنِي مِنَ التُّهَمِ",42,"م",1,0],["لَمْ أَدْرِ هَلْ نَبَغَتْ فِي الأَرْضِ نَابِغَةٌ","أَمْ هَذِهِ شِيمَةُ الدُّنْيَا مِنَ الْقِدَمِ",43,"م",1,0],["لَمْ أَدْرِ هَلْ ثَابَتْ إِلَيْهِ أَنَاتُهُ","أَمْ لَمْ يَزَلْ فِي غَيِّهِ وَهُيَامِهِ",44,"م",2,0],["لمْ أدرِ هلْ بادرَتْني منْ كتابِكم ال","بدورُ أمْ غازلتني منهُ غزلانُ",45,"ن",1,0],["لَمّا دَنا تَقارُبٌ","مِن لَيلِنا وَمَصرِفٌ",46,"ف",1,0],["لَمّا دَخَلتُ مَنَحتُ طَرفي غَيرَها","عَمداً مَخافَةَ أَن يُرى رَيعُ الهَوى",47,"ا",1,0],["لَم أَدرِ هَل يُزهى فَيَخطُرُ نَخوَةً","أَم لاعَبَت أَعطافَهُ الجِريالُ",48,"ل",1,0],["لمّا دَعا الأحرارَ من غُرمائِها","لم يُلْفِهمْ صُمَّا ولا عُميانا",49,"ن",2,0],["لم أدرِ أهْيَ بِضاعةٌ مجلوبةٌ","أم أمّةٌ محروبةٌ وبلادُ",50,"د",1,0],["لَمّا دَعاها بَشيرُ الريحُ فَاِزدَلَفَت","تَلقى رِكابَهُما في المَوكِبِ الضاحي",51,"ح",2,0],["لمَّا دعاكم إلى الإسلامِ حينَ دَعا","قُلتم صَبأْنَا فلم يَأثَمْ ولم يَحُبِ",52,"ب",1,0],["لَمّا دَعاهُ بسيفِ اللهِ سَيِّدُهُ","زَادَ السُّيوفَ بِهِ في عِزِّهَا شَرَفا",53,"ف",2,0],["لم أدرِ إذ ذهبَ الزَّمانُ بريحِها","ماذا من القَدَرِ المُتَاحِ دَهاها",54,"