{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[55,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[57,"طال ليلي واشتياقي","https://www.aldiwan.net/poem26208.html","مجزوء الرمل"],[49,"ومعود للكر في حمس الوغى","https://www.aldiwan.net/poem25346.html","الكامل"],[72,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[47,"يا أبا نهشل وداع مقيم","https://www.aldiwan.net/poem64594.html","الخفيف"],[47,"لج هذا الحبيب في هجرانه","https://www.aldiwan.net/poem66663.html","الخفيف"],[33,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[54,"قال أذنبت ولا أدري","https://www.aldiwan.net/poem27039.html","المديد"],[52,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[52,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[48,"إني ونفسي أبدا في جذاب","https://www.aldiwan.net/poem22373.html","السريع"],[48,"جاران شاك ومسرور بحالته","https://www.aldiwan.net/poem23345.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85546","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147601",""],[113,"لا أطلبن مراما لست أدركه","https://www.aldiwan.net/poem16530.html","البسيط"],[146,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[159,"لجنون الهوى وهبت جناني","https://www.aldiwan.net/poem55511.html","الطويل"],[193,"منيتي طيبة لا أبغي سواها","https://www.aldiwan.net/poem35147.html","المتقارب"],[409,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[415,"ملني واستحل ظلمي","https://www.aldiwan.net/poem31839.html","مجزوء الخفيف"],[466,"ضعي لامتداحي ما استطعت من العذر","https://www.aldiwan.net/poem15104.html","الطويل"],[519,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[556,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[556,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[556,"لا قضى الله لقلبي","https://www.aldiwan.net/poem47894.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122795","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48811","الخفيف"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143251","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37991","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99970","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109163","الرمل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107306","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108562","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132301","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77287","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77400","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28602","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28485","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100894","الرمل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102189","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127370","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115730","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110783","السريع"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121775","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36760","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36554","الدوبيت"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4755,"قَيِّدْ فَضَائِي.. وهَبْ لِي مَسْلَكًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=183782",""],[4755,"قَيِّدْ فَضَائِي.. وهَبْ لِي مِعْطَفًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=184668",""],[5057,"ياخاله","https://www.poetsgate.com/ViewPoem.aspx?id=203632",""],[5101,"قلق","https://www.poetsgate.com/ViewPoem.aspx?id=202971",""],[5629,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=184606",""],[5956,"الحب السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=181895",""],[572,"لا وَعينٌ تُدِيرُ باللّحظِ خمرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9314&r=&rc=171",""]],"verses":[["لا أَطلُبُ المالَ إِلّا مِن مَطالِبِهِ","وَلا يَفي لِيَ بَذلُ المالِ بِالمِنَنِ",0,"ن",1,0],["لا أُطيعُ العَذولَ فيكَ وَلَو أَن","ني سَليمُ الفُؤادِ وَالعَذلُ راقِ",1,"ق",1,0],["لا اِطَّرَدَت بي إِلَيكَ سابِحَةٌ","حَتّى أَرى النَقعَ عالِيَ الكَتَدِ",2,"د",1,0],["لا أُطيقُ الصَبرَ عَنها","ضِقتُ ذَرعاً بِالفِراقِ",3,"ق",1,0],["لا أَطلُبُ الرِزقَ الذَليلَ مَنالُهُ","فَوتُ الهَوانِ أَذَلُّ مِن مَقناتِهِ",4,"ت",2,0],["لا أَطلُبُ في الهَوى شَفيعاً","لي فيكَ غِنىً عَنِ الوَسائِل",5,"ل",1,0],["لا أُطيقُ السُلُوَّ عَنكَ وَلو أَنَّ","فُؤادي مِن صَخرَةٍ مَرمَريسِ",6,"س",1,0],["لا أَطَعتُ الوُشاةَ فيهِ وَلَو","أَسرَفَ في ظُلمِهِ وَفي عُدوانِه",7,"ن",2,0],["لا أُطيقُ الكَلامَ مِن شِدَّةِ الوَج","دِ وَدَمعي يَسيلُ كُلَّ مَسيلِ",8,"ل",1,0],["لا أُطيقُ الهَجرَ أَحمِلُهُ","ضَعُفَت نَفسي عَنِ الهَجرِ",9,"ر",1,0],["لا أُطيقُ العَزاءَ عَن مُنيَةِ النَف","سِ عَذيري في حُبِّها مِن يَزيدِ",10,"د",1,0],["لا أُطيعُ الناسَ فيها","أَبَداً حَتّى المَماتِ",11,"ت",1,0],["لا أُطعَمُ الغِسلينَ في قَعرِها","وَلا أُغادى بِالحَميمِ المُذاب",12,"ب",1,0],["لا أَطعَموا مِنهُ مِسكيناً وَلا بَذَلوا","عُرفاً وَلا كَفَّروا في حِنثِهِ قَسَما",13,"م",2,0],["لا أطفأَ اللَه نوراً كان منتمياً","إلى سراج من العرفان وهَّاج",14,"ج",1,0],["لا أَطمئن لغير ما","أَنا سامع أَو مبصر",15,"ر",1,0],["لا أطلب الأرزاق وال","مولى يفيض علي رزقي",16,"ي",1,1],["لا أَطلُبنَّ مَراماً لَستُ أُدركهُ","وَإِن رَقت بي إِلى أَعلا الذرى هِمَمي",17,"م",2,1],["لا أطلبُ الهدنةَ فيها ولو","قامت بها الحربُ على ساقِ",18,"ق",1,0],["لا أَطَعتُ العَذُولَ في لَذَّةِ الكأْ","سِ وَلا لُمْتُ عَاشِقاً في الزَّمانِ",19,"ن",1,0],["لا أُطيلُ الشرح أقصى مُنيتي","أَن أَراها وأُرى تحت ثراها",20,"ا",3,0],["لا أطيل النظم في أوصافه","فهي شمس في الورى قد جليت",21,"ت",1,0],["لا أطيعُ النّصيحَ فيه","وإن كانَ يُرشِدُ",22,"د",1,0],["لا أطرقُ الحي اللئام بمدحهِ","ولو عرقتني شدةُ الازم الغُبْر",23,"ر",1,0],["لا أطْلَعَ اللَّهُ فجراً في مَفارقِهم","ولا اِنجَلى ليلُها عنهُم ولا أفَلوا",24,"ل",3,0],["لا أطْعَمَ الرّحمنُ دا","راً للهوانِ ولا سقاها",25,"ا",3,0],["لا اِطمأنَّ الرّدى إِليك ولا زِلْ","ت تَلَقَّى جماعةً بفراقِ",26,"ق",1,0],["لا أطاعَ القلبُ مِنِّي","أبداً فيك نصيحا",27,"ح",2,0],["لا أَطمَئِنُّ بِأرضٍ نائِماً فَرَقاً","وَلا أُلاقي لَذيذَ العَيشِ يَقظانا",28,"ن",2,0],["لا أطيلُ الكلامَ بعد الذي قل","تَ وقد جَلَّ ما بمصر وما بي",29,"ب",2,0],["لا أطيع العاذل الجا","هل في ترك العقار",30,"ر",1,0],["لا أُطفِئت إِذْ لَم تقطَّ وَلَم تَذُبْ","بَل لا تَزالُ الدَّهرَ خَيرَ مُضيئَةِ",31,"ه",1,0],["لا أَطلبُ الحظَّ إنَّ الحظَّ ذو صَممٍ","أَعمىً عَنِ الفضلِ بِالأَرذالِ ذو شغلِ",32,"ل",1,0],["لاَ أُطِيقُ الدِّفَاعَ عَنْكَ وَلاَ","أَمْلِكُ غَيْرَ الْهُمُومِ والإِرْتِمَاضِ",33,"ض",1,0],["لا أطيلُ القول في تقريظهِ","فلقد ينكر مدحُ الأصدقا",34,"ق",2,0],["لا أُطيقُ الصَبرَ عنهُ","لا ولَم أَهنا المَناما",35,"م",2,0],["لا أطال الإله عمر بعادي","عن وزير أطال بالخير نجحي",36,"ح",2,0],["لا أطيق الصبر عنه","لا ولا الوصل إليه",37,"ي",2,0],["لا أُطيقُ الرَحيلَ عَنكَ لَعَمري","وَلَو أَنّي رَكِبتُ مَتنَ البُراقِ",38,"ق",1,0],["لا أُطيعُ الشَيطانَ فيما دَعاني","إِنَّ كَيدَ الشَيطانِ كانَ ضَعيفا",39,"ف",2,0],["لا أَطلُبُ الرِّزقَ مِن سَيفٍ وَلا قَلَمٍ","وَلا يُمارِسُ في ما أَكسِبُ المِهَنُ",40,"ن",1,0],["لا أَطلُبُ الرِّزقَ مِن سَيفٍ وَلا قلم","وَلا أفَكِّرُ في روم وَأَعرابِ",41,"ب",1,0],["لا أطالَ الله فى الدنيا إِذا","كانت الدنيا انشقاقاً وانقساما",42,"م",2,0],["لا أطيق الجفا وعينك فاعطف","واهدني من ضلال حالك جعدك",43,"ك",1,0],["لا أطيق السكوت ما دام قلبي","خافقا واللسان يروى مرادي",44,"د",2,0],["لا أطيع العذول يبغى سلوّا","سامعاً قوله وإن كان عدلا",45,"ل",2,0],["لا أطلب الرزق بشعرٍ ولا","كنت على جيده أقدر",46,"ر",1,1],["لا أطمعُ اليومَ وقد أصبحتْ","للّهِ عندي نِعَمٌ سَابِغَهْ",47,"ه",1,1],["لا أَطمئِنُ ولا أَتوقُ الى هَوىً","ولكل حَيٍّ في الحياةِ مَتَاقُ",48,"ق",1,0],["لا أَطعَمُ الخُبزَ السَمي","ذَ بِها وَقَد مُلِئَت نِعَم",49,"م",1,0],["لا أطيلُ القولَ فيهِ فكفى","له هجواً أنه ينكرُ ناسَه",50,"س",2,0],["لا أَطلعَ كالخِلاف نَوري ثَمَراً","ما أورقتِ الغُصونُ إِن كانَ خِلاف",51,"ف",1,0],["لا أُطيق الحكم الَّذي أَبرَموه","وَهو حُكم بِالشَنقِ وَالإِعدامِ",52,"م",1,0],["لا أَطلُبُ الخُلْدَ.. إنِّي كُلَّمَا سَقَطَت","تُفَّاحَةٌ صَدَّ جُوعِي جُوعَهُ وعَصَى",53,"ص",2,0],["لا أطلُبُ المَاءَ, قَلبِي صَارَ خَرْدَلَةً","فِي جَوْفِهَا كُلُّ وَجهٍ ظامِئٍ شَخَصَا",54,"ص",2,0],["لا أَطلبُ الأمرَ المُحالَ وإنما","اقصى أمانيْ العاشِقيْنَ رِسالَهْ",55,"ل",2,0],["لا أطمئِنُّ لِشَهقتي الأولى","والموتُ مكتوبٌ لِمَن شهقوا",56,"ق",3,0],["لا أطروه قيل فلان وش هي سواياه ،","وأن جنبوا ذكره يشوف أنكساره ،",57,"ر",2,0],["لا أطيق الحب إن كان عذاباً","إنْ يجئْ بالذلِّ يعصفْ كبريائي",58,"ا",2,1],["لا أطيق الحب إن كان مهيناً","عاش رأسي شامخاً عند السماء ‏",58,"ا",2,0],["لا أَطعتُ السلوَّ عنها ولا العَا","ذِلَ فيها ولا تعاطيتُ صَبرَا",59,"ر",2,0]]}