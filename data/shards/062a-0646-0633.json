?name=Sh3er&doWhat=shqas&qid=9301&r=&rc=158",""]],"verses":[["تَنسَدُّ فيهِ الشَمسُ قَد","تاهَت بِها القَساطِلُ",0,"ل",1,0],["تُنسي جَرائِحُها قَوارِصَها","وَالطَلقُ يُنسى عِندَهُ المَغصُ",1,"ص",1,0],["تنسى الرؤوس العوالي نار نخوتها","إذا امتطاها إلى أسياده الذئب",2,"ب",1,0],["تَنسى بَلائي إِذا ما غارَةٌ لَقِحَت","تَخرُجُ مِنها الطُوالاتُ السَراعيفُ",3,"ف",1,0],["تُنْسِي فَعَالَ أَبِيكَ فِي آبَائِهِمْ","وَالشِّبْلُ نِدُّ الأُسْدِ فِي فَعَلاَتِهَا",4,"ت",3,0],["تَنَسَّم صَباها تُجَدِّد قُواكَ","فَأَرضُ الجَزيرَةِ لا تُجتَوى",5,"ا",1,0],["تُنسيه طِيَّتَه التي قد أمَّها","والركب فيها ميّت الأخبارِ",6,"ر",1,0],["تنسّك في شهر الصيام معذبي","وفي جفنه سيف على الناس عازم",7,"م",1,1],["تَنسى البَرِيَّةُ عِندَهُ","يَومَ الخَوَرنَق وَالسَديرِ",8,"ر",1,0],["تَنسابُ فيهِ العَينُ بَينَ جَداوِلٌ","وَخَمائِل وَمَسالِك وَدِيارِ",9,"ر",1,0],["تنسمتْ تسحب أذيالها","خلال جنات وأنهار",10,"ر",1,0],["تَنْسابُ سابحةً بغيرِ نظامِ","وأَحسَّ روحَ الكونِ تخفقُ حولهُ",11,"ه",1,0],["تُنسى البِلادَ بُروقَ الجَرِّ بارِقَتي","وَتَكتَفي بِالدَمِ الجاري عَنِ الدِيَمِ",12,"م",1,0],["تَنَسّكَ في بِرٍّ ثمانينَ حِجّةً","فيا طولَ عُمْرٍ فيه فرَّ إلى الرّبِ",13,"ب",1,0],["تَنسَلُّ في لُجَجٍ حَكَت أَغمارُها","فِعلَ المُحَمَّدِ في الزَمانِ المُجحِفِ",14,"ف",1,0],["تُنسى الرِياضُ وَما يُرَوَّضُ فِعلُهُ","أَبَداً عَلى مَرِّ اللَيالي يُذكَرُ",15,"ر",1,0],["تَنسى الشُموسَ الغارِباتِ وَقَد بَدا","لِهَوى الأَحِبَّةِ مِن جُفونِكَ مَطلَعُ",16,"ع",1,0],["تَنسابُ مِثلَ الأَرقَمِ المُنسابِ","كَأَنَّما تَنظُرُ عَن شِهابِ",17,"ب",1,0],["تَنْسَى له فُرسانَها قَيسٌ ولمْ","تَظلِمْ وتُعرِضُ عن كُلَيبٍ وائل",18,"ل",1,0],["تَنَسَّمُ الأَرواحِ في اِنبِرائِهِ","خَضخَضَ طُبيَيهِ عَلى أَمعائِهِ",19,"ا",3,0],["تُنسي الغَوِيَّ مَعادَهُ","وَتَكونُ لِلحُكَماءِ ذِكرا",20,"ر",2,0],["تَنَسَّكتَ بَعدَ الأَربَعينَ ضَرورَةً","وَلَم يَبقَ إِلّا أَن تَقومَ الصَوارِخُ",21,"خ",1,1],["تُنسيهُمُ العارِفَةَ الهيفُ كَالأَغ","صانِ وَالأَعجازُ مِثلُ الكُثُب",22,"ب",1,0],["تُنسَبُ الشُهُبُ مِن يَمانٍ وَشا","ميٍّ وَيُلغى اِنتِسابُها في الحِجازِ",23,"ز",1,0],["تَنَسَّكَ الأَسَدُ الضِرغامُ وَاِبتَكَرَت","جَآذِرُ العَينِ آساداً رَآبيلا",24,"ل",2,0],["تَنسى به العينُ طرفَها عَجباً","ويدركُ الوهمَ عنده الوهِمُ",25,"م",1,0],["تنسي البلاد بروق الجو بارقتي","وتكتفي بالدم الجاري عن الديم",26,"م",1,0],["تُنَسِّي الحربُ كلَّ فتىً هواه","ولا يَنسَى الكميُّ بها غرامهْ",27,"م",2,0],["تَنَسَّرَتِ الْبُغَاثُ بِأَرضِ نَسْرٍ","وَدَلَّ الذِّئْبُ فِي أَرْضِ الْهِزَبْرِ",28,"ر",1,0],["تنسابُ فوقَ الماء جاريةً","مدفوعةً بالماءِ والجَمْر",29,"ر",1,0],["تُنسَى الذنوبُ مع القُرْبى وإن عَظُمت","إن الشَّفيقَ صغيراتٌ كبائره",30,"ر",2,0],["تنسى المصير ويأتي","مصيرها في حقيبة",31,"ب",2,0],["تنسى الرؤوس العوالي نار نخوتها","إذا امتطاها إلى أسياده الذنب",32,"ب",1,0],["تَنْسَابُ فِي الرَّوْضِ عَلَى الْتِوَاءِ","خَفيَّةً ظَاهِرَةَ الَّلأْلاَءِ",33,"ا",2,0],["تنْسى بلاَئي إذا ما غارة ٌ لَقِحَتْ","تْخرجُ منها الطوالاتُ السواعيفُ",34,"ف",1,0],["تنُسيكَ بل تُسليكَ بل تُحييكَ","لا أمثالُها ليلَى ولا أسماءُ",35,"ا",2,0],["تَنَسكنَا ونَعنَعنَا وقُلنَا","ألاَ إلاَّ تَكُن إِبلٌ فَمِعزَى",36,"ز",2,0],["تُنسَى مرارةُ كلِّ نازلةٍ","بحلاوةٍ في النهى والأمرِ",37,"ر",1,0],["تنسمتُ من أنفاسها أَرَجَ الصَّبا","وجَنَّبْتُ عُلْويَّ الصَّبا والجنائبِ",38,"ب",1,0],["تُنسيكِ تذكاراتِ حُبٍّ مَضى","مُضِيَّ أَشباحٍ بِماءٍ زُلال",39,"ل",1,0],["تنساب كالماء على حافرٍ","كأنه من حجرٍ صلدِ",40,"د",1,0],["تَنَسَّكَ لا يَرْجُو زَمَاناً مُلائِماً","ولا يَتَّقِي في اللَّهِ لَوْمَةَ لائِمِ",41,"م",1,0],["تُنسي مَحاسنهُ القلائدَ وَالمعا","ني إِن زَها بِنظامها الإنشادُ",42,"د",1,0],["تنسج الوحدة من حو","ليه أكفان لظاه",43,"ه",1,0],["تنسل في عرصات الغاب راقصة","على عزيف وتنعاب وتصهال",44,"ل",1,0],["تُنسيكَ عُرْقُوباً لهُ قَواعِدٌ","عَن مَنْهجِ القَوْلِ الصَّحِيحِ نُكِّبَتْ",45,"ت",1,1],["تُنسيكَ حُسْنَ الخَلْق بِالخَلائقِ","لاحِتَةً بِأَعْوَجٍ وَلاحِقِ",46,"ق",1,0],["تَنسمي بِاللَه ريح نَجدٍ","عَلى فُؤاد طافح بِالوَجدِ",47,"د",1,1],["تنسى ذنوبا عليك تحصى","يحصرها نقده وحكه",48,"ك",2,0],["تَنَسَّمتَ معتلاً فلم أدرِ أيّنا","بظلِّ نسيمات الغُوَير عليل",49,"ل",1,0],["تُنسي العتاهيَّ لها قولَهُ","يا إخوتي إن الهَوى قاتلي",50,"ل",2,0],["تُنْسيكَ هَيْبتُهُمْ شَماخَةَ كُلِّ ذي","مُلْكِ وَهَيْبَةَ كُلِّ ذي سُلْطانِ",51,"ن",1,0],["تنسَّمي ريحَ رَوْحِ اللهِ مُنشِئةً","غُيوثَ رحمتِهِ سَحّاً وتَهتانا",52,"ن",2,0],["تنساب مثل الجدول الرقراق في","نسق فيستهويك منها المنظر",53,"ر",1,0],["تَنسُب قحطانَ من أبيها","وأمّها في الذؤابتينِ",54,"ن",1,0],["تُنسَى الليالي وهي مذكورةٌ","ويهرَمُ الدهر ولم تهرَمِ",55,"م",1,0],["تُنسَى وتقصَى غير منسيّة","وهي مع الإعراض ذكَّارَهْ",56,"ر",2,0],["تَنسَلُّ بِالأَمعَزِ المَرهوبِ لاهيَةً","عَنهُ إِذا جَزِعَ الرُكبانُ أَو جَلُدوا",57,"د",3,0],["تنسَّمتُ أخبارُ العُذَيْبِ وأهلِهِ","شِفاهاً فما أجدَى عليَّ التنسُّمُ",58,"م",1,0],["تَنْسِلُّ مِن هبواتِ المُورِ ناحلةً","مثلَ الهلالِ انجلى عن ضُمرِه الشفقُ",59,"ق",1,0],["تنسى الملمات إلا أزمة عرضت","للمسلمين وزادت منه تهويلا",60,"ل",2,0],["تنسّكوا وهمُ أُسْدٌ مظفّرةٌ","فاِعجَب لنُسكٍ وفتْكٍ في طِباعِهمِ",61,"م",1,0],["تُنسي مكارِمُهُ الأضيافَ مَنزِلَهم","فلا يَشوقُهُمُ أهلٌ ولا وَلَدُ",62,"د",1,0],["تنسَّك بالإِسلام لكن رأَيتُه","يَحِلُّ به بالشَّرعِ أَنْ يشْرَبَ الدِّما",63,"م",2,0],["تنَّسك شَيْطانِي فَيَا ليْتَه غَدا","فِدَا مَلِكٍ لِلْحُسنِ فِيه تَمرُّدَا",64,"د",2,1],["تنساب من لجّه الأمواه مترعة","جداولا نستقي منها وخلجانا",65,"ن",2,0],["تُنَسّيكَ ما وشَّى حبيبٌ لخالدٍ","وتزري بما حاك الوليد لصاعد",66,"د",1,0],["تُنسِي القلوبَ هموماً قد علقنَ بها","لهواً وتفتحُ للابصار منهاجا",67,"ا",1,0],["تنسف الأَرض في الوَقائع نَسفاً","وَبِها يُدرَك السُها في سماه",68,"ا",2,0],["تنسم الدهر بالأفراح والطرب","ونلت قصدي بلا قصد ولا طلب",69,"ب",1,1],["تنسى الحوادث في الدنيا إذا قدمت","وحادث الطف لا ينسى وإن قدما",70,"م",2,0],["تَنسِفُ الأَرضَ إِذا مَرَّت بِهِ","فَلَها إِعصارُ تُربٍ مُنتَسِف",71,"ف",1,0],["تُنسيك قول زُهير في","هرم الجواد الأصيدِ",72,"د",1,0],["تَنْسَى أباكَ وقد حَقّتْ مَقالَتُهُ","إذْ تَخْطُبُ الناسَ الوالي لنا عُمَرُ",73,"ر",1,0],["تُنْسي إذا سَغِبوا في الْبيدِ إِذْ ظَمِئُوا","بِطيبِها طِيبَ مَأْكولٍ ومَشْروبِ",74,"ب",1,0],["تنساب فوق معاطف مخذولة","تنساب في تيه وفي أعجاب",75,"ب