{"poems":[[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[161,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[376,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[382,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[556,"أمللتني وزعمت أن","https://www.aldiwan.net/poem47306.html","مجزوء الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48750","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104819","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202591","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199933","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67993","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110093","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[4908,"لا تعذلوه","https://www.poetsgate.com/ViewPoem.aspx?id=207388",""],[4984,"العام","https://www.poetsgate.com/ViewPoem.aspx?id=196890",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[5376,"قد أنبت القمح في كفي سنابله","https://www.poetsgate.com/ViewPoem.aspx?id=191877",""],[5497,"لا تستبيحوا بالجفاء مدامعي","https://www.poetsgate.com/ViewPoem.aspx?id=206088",""],[402,"يدعوك معتل وأنت بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=35453",""]],"verses":[["هَلْ ضَمَّ غَيْرُ الرَّسُولِ المُصْطَفَى قِدَماً","تلكَ العَزَائِمَ والآمَالَ مِنْ شَعَبِ",0,"ب",1,0],["هَلْ ضَمَّ حَفْلٌ مِنْ أَكَابِرِ أُمَّةٍ","مَا ضَمَّ مِنْهُمْ حَفْلُهُ الْمَشْهُودُ",1,"د",1,0],["هَلْ ضَمِنَتْ عُذْرًا عَلَى","جَهْلٍ بَقِىْ إنْ أُنذِرَتْ",2,"ت",1,0],["هَل ضِقتِ عَن عَيني ونَظرتِها","فتَركتِها والدَّمع في شُغلِ",3,"ل",1,0],["هل ضمَّنا فيها شذا","أرجائِها ضمنَ الصَبا",4,"ب",2,0],["هل ضامنٌ منكمْ لنا","ضمن الجميل فما بَدا لَهْ",5,"ل",2,0],["هل ضاق يوماً عن بنيه موطن","فيبيح مأوى الآمنِ المستعمرُ",6,"ر",1,0],["هَل ضَاءَ بَرقُ دُجا الأَسحارِ مِن اضَمِ","أَم نُورُ لَيلَى بَدَا ثَغراً لِمُبتَسَمِ",7,"م",1,1],["هل ضاع مني في التغرّب موطني","وأضعتُ فيه ربوعه وأضعنني",8,"ن",2,0],["هل ضم كوتة والمعري عصرنا","لنقول هذا العصر خير الأعصر",9,"ر",1,0],["هل ضَمَّت الأرضُ مليكاً مثل مَنْ","قَدْ ضمت اليومَ بأَحْقابِ الزمَنْ",10,"ن",1,1],["هَل ضيم ذو نخوة أَبيّ","يَأنف من أَن يُقال ضيما",11,"م",2,0],["هل ضاقت الأرض عن حيٍّ وهل بَخُلَت","يوماً على ميّتٍ بالقبر والكفَن",12,"ن",1,0],["هل ضلَّ من ظَلَّ لفظ العَذلِ يُولِعُهُ","فالقلبُ من لَذع عَذل فاظَ بالأَلَمِ",13,"م",1,0],["هل ضاعَ في دنيا الغرامِ غرامُنا","أزرى الحبيبُ بخافقي والرِّفاقُ",14,"ق",1,0],["هل ضللتك مسيرتي أم لم تجد","هَدْي النجوم الساريات بمرشد",15,"د",1,0],["هل ضج بالشكر عند الصخر واردهم","أو كان في المن والسلوى لهم شبع",16,"ع",1,0],["هل ضعت في وطني أم تهت في زمني","أم ذاك بأس وكم أخشى نوازله",17,"ل",2,0],["هل ضاق يوما من سباه غرامُ","وهل استوى بين الضلوع مقامُ؟!",18,"م",1,1],["هل ضم حفل من أكابر أمة","ما ضم منهم حلفه المشهود",19,"د",1,0]]}