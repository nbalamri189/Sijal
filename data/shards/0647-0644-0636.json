{"poems":[[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[157,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[371,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[377,"يا صاح ما هذي الربا","https://www.aldiwan.net/poem66951.html","مجزوء الكامل"],[551,"أمللتني وزعمت أن","https://www.aldiwan.net/poem47306.html","مجزوء الكامل"]],"verses":[["هَلْ ضَمَّ غَيْرُ الرَّسُولِ المُصْطَفَى قِدَماً","تلكَ العَزَائِمَ والآمَالَ مِنْ شَعَبِ",0,"ب",1,0],["هَلْ ضَمَّ حَفْلٌ مِنْ أَكَابِرِ أُمَّةٍ","مَا ضَمَّ مِنْهُمْ حَفْلُهُ الْمَشْهُودُ",1,"د",1,0],["هَلْ ضَمِنَتْ عُذْرًا عَلَى","جَهْلٍ بَقِىْ إنْ أُنذِرَتْ",2,"ت",1,0],["هَل ضِقتِ عَن عَيني ونَظرتِها","فتَركتِها والدَّمع في شُغلِ",3,"ل",1,0],["هل ضمَّنا فيها شذا","أرجائِها ضمنَ الصَبا",4,"ب",2,0],["هل ضامنٌ منكمْ لنا","ضمن الجميل فما بَدا لَهْ",5,"ل",2,0]]}