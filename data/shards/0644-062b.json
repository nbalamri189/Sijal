{"poems":[[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[53,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[72,"وأهيف القد فتان العيون قضى","https://www.aldiwan.net/poem18474.html","البسيط"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[61,"قمر بدير الموصل الأعلى","https://www.aldiwan.net/poem51335.html","الكامل"],[66,"لثمت مقاطر أقلامه","https://www.aldiwan.net/poem38442.html","المتقارب"],[44,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"لثغة من أهواه من حسنها","https://www.aldiwan.net/poem28457.html","السريع"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[50,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[7,"ياعام لم أعرفك تنكر سنة","https://www.aldiwan.net/poem1999.html","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72223","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142011","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""]],"verses":[["لَثِقُ المُناخِ ثَقيلَةٌ أَوراكُهُ","حَضِرُ المَجَرُّ مُرَوَّضٌ بِالبَلقَعِ",0,"ع",1,0],["لَثَّمتَ خَدَّ الشَمسِ مِنهُ بِأَسوَدٍ","وَالنورُ يَشهَدُ أَنَّ وَجهَكَ سافِرُ",1,"ر",1,0],["لِثامي غُبارُ الخَيلِ في كُلِّ غارَةٍ","وَثَوبي العَوالي وَالحَديدُ المُذَرَّبُ",2,"ب",1,0],["لَثمتُ الثَرى مُستَشفِياً بِتُرابِهِ","وَمَن لي بِأَن يَشفي غَليلي تُرابُهُ",3,"ب",2,0],["لثغرهِ ولخديهِ وطرَّته","شبهٌ من الدُّرِّ والياقوت والسبج",4,"ج",1,0],["لثمت ثغر عذولي حين سماك","فلذّ حتَّى كأني لاثم فاك",5,"ك",1,1],["لَثَنى صُدورَ السُمرِ تَكشِفُ كُربَةً","وَلَوى رُؤوسَ الخَيلِ تَفرُجُ ضيقا",6,"ق",2,0],["لثم الصليب فقلت من حسد","قبل الحبيب فمي بها أولى",7,"ل",2,0],["لثمت مقاطر أقلامه","وثقت إلى لثم أقدامه",8,"ه",1,1],["لَثَكِلتُ آمالي لَدَيهِ بِأَسرِها","أَو كانَ إِنشادي خَفيرَ كَلامي",9,"م",2,0],["لثابِتُ العَهدِ لَم يَحلُل قُوى أَمَلِي","يَأسٌ وَلَم تَخطُ بِي في سَلوَةٍ قَدَمي",10,"م",2,0],["لثغةُ مَنْ أهواهُ مِنْ حسنِها","عندي على الوجهينِ محمولَهْ",11,"ل",2,1],["لُثِمَتْ بإيمانِ القلوبِ وإنّها","لَتُرَى على مَرِّ الزَّمانِ فتُلثَم",12,"م",1,0],["لِثَقالِ الأَعجازِ تَمشي الهُوَينى","مِثلَ غُصنِ الرَيحانَةِ المَيّادِ",13,"د",1,0],["لَثَوَيتَ في قِدٍّ هُنالِكَ موثَقاً","في القَومِ أَو لَثَوَيتَ غَيرَ مُوَسَّدِ",14,"د",1,0],["لِثامِ المِلْكِ حِينَ تُعَدُّ كَعْبٌ","ذَوُو الأَخْطارِ والخُطَطِ الجِسامِ",15,"م",1,0],["لَثِقِ الرِّيشِ تَدَلَّى غُدوَةً","مِن أَعَالي صَعبَةِ الَمرقَى طِمارِ",16,"ر",1,0],["لَثَمْتُ بِهَا كَفّاً هِيَ الْبَحْرُ فِي النَّدَى","تَفِيضُ سَمَاحاً وَالْبَنَانُ جَدَاوِلُ",17,"ل",1,0],["لَثَمَ الدهرث راحيتكَ","وغنى عبقري الألحان تحت غصونك",18,"ك",1,0],["لَثَمْتُ حَصا مَغْنَاكَ لمّا وَطِئْتُهُ","وقُلتُ اللآلِي كيف تُظْلم بالرَّضِّ",19,"ض",1,0],["لِثورةِ الفكرِ تأريخٌ يحدّثُنا","بأنَّ ألفَ مسيحٍ دونَها صُلِبا",20,"ب",2,0],["لَثَمْتُ جراحكَ في \" فتحةٍ \"","هي المُصحَف الطُهرُ إذ يُلثَم",21,"م",1,0]]}