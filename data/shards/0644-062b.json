{"poems":[[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[53,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[72,"وأهيف القد فتان العيون قضى","https://www.aldiwan.net/poem18474.html","البسيط"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[61,"قمر بدير الموصل الأعلى","https://www.aldiwan.net/poem51335.html","الكامل"],[66,"لثمت مقاطر أقلامه","https://www.aldiwan.net/poem38442.html","المتقارب"],[44,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"لثغة من أهواه من حسنها","https://www.aldiwan.net/poem28457.html","السريع"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[50,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[7,"ياعام لم أعرفك تنكر سنة","https://www.aldiwan.net/poem1999.html","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72223","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142011","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[107,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[202,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[278,"ألم تك للملوك الغر تاجا","https://www.aldiwan.net/poem60700.html","الوافر"],[280,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[303,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[318,"لثمان عشر من ربيع مولد الهادي","https://www.aldiwan.net/poem67128.html","الكامل"],[320,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[351,"لثمت يد المحبوب يوما فقال لي","https://www.aldiwan.net/poem40360.html","الطويل"],[362,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[362,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[362,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[362,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[362,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[364,"هذا عذاب لا يفتر","https://www.aldiwan.net/poem16991.html","مجزوء الكامل"],[374,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[438,"تشفلط جلدي والليالي تشفلط","https://www.aldiwan.net/poem14310.html","الطويل"],[456,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[456,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[456,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[456,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[459,"بقيت بهاء الدينِ ما وضح الضحى","https://www.aldiwan.net/poem15370.html","الطويل"],[459,"الله جارك من أخي شرف","https://www.aldiwan.net/poem15448.html","أحذ الكامل"],[462,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[462,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[462,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[462,"سقى الله بالمحلة بارداً","https://www.aldiwan.net/poem3323.html","عموديه"],[466,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[536,"لو قطرة من دمه","https://www.aldiwan.net/poem47966.html","عموديه"],[538,"لثقا تجفجفه الصبا وكأنه","https://www.aldiwan.net/poem56760.html","الكامل"],[573,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[584,"ولما التقينا للوداع وللجوى","https://www.aldiwan.net/poem17622.html","الطويل"],[585,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["لَثِقُ المُناخِ ثَقيلَةٌ أَوراكُهُ","حَضِرُ المَجَرُّ مُرَوَّضٌ بِالبَلقَعِ",0,"ع",1,0],["لَثَّمتَ خَدَّ الشَمسِ مِنهُ بِأَسوَدٍ","وَالنورُ يَشهَدُ أَنَّ وَجهَكَ سافِرُ",1,"ر",1,0],["لِثامي غُبارُ الخَيلِ في كُلِّ غارَةٍ","وَثَوبي العَوالي وَالحَديدُ المُذَرَّبُ",2,"ب",1,0],["لَثمتُ الثَرى مُستَشفِياً بِتُرابِهِ","وَمَن لي بِأَن يَشفي غَليلي تُرابُهُ",3,"ب",2,0],["لثغرهِ ولخديهِ وطرَّته","شبهٌ من الدُّرِّ والياقوت والسبج",4,"ج",1,0],["لثمت ثغر عذولي حين سماك","فلذّ حتَّى كأني لاثم فاك",5,"ك",1,1],["لَثَنى صُدورَ السُمرِ تَكشِفُ كُربَةً","وَلَوى رُؤوسَ الخَيلِ تَفرُجُ ضيقا",6,"ق",2,0],["لثم الصليب فقلت من حسد","قبل الحبيب فمي بها أولى",7,"ل",2,0],["لثمت مقاطر أقلامه","وثقت إلى لثم أقدامه",8,"ه",1,1],["لَثَكِلتُ آمالي لَدَيهِ بِأَسرِها","أَو كانَ إِنشادي خَفيرَ كَلامي",9,"م",2,0],["لثابِتُ العَهدِ لَم يَحلُل قُوى أَمَلِي","يَأسٌ وَلَم تَخطُ بِي في سَلوَةٍ قَدَمي",10,"م",2,0],["لثغةُ مَنْ أهواهُ مِنْ حسنِها","عندي على الوجهينِ محمولَهْ",11,"ل",2,1],["لُثِمَتْ بإيمانِ القلوبِ وإنّها","لَتُرَى على مَرِّ الزَّمانِ فتُلثَم",12,"م",1,0],["لِثَقالِ الأَعجازِ تَمشي الهُوَينى","مِثلَ غُصنِ الرَيحانَةِ المَيّادِ",13,"د",1,0],["لَثَوَيتَ في قِدٍّ هُنالِكَ موثَقاً","في القَومِ أَو لَثَوَيتَ غَيرَ مُوَسَّدِ",14,"د",1,0],["لِثامِ المِلْكِ حِينَ تُعَدُّ كَعْبٌ","ذَوُو الأَخْطارِ والخُطَطِ الجِسامِ",15,"م",1,0],["لَثِقِ الرِّيشِ تَدَلَّى غُدوَةً","مِن أَعَالي صَعبَةِ الَمرقَى طِمارِ",16,"ر",1,0],["لَثَمْتُ بِهَا كَفّاً هِيَ الْبَحْرُ فِي النَّدَى","تَفِيضُ سَمَاحاً وَالْبَنَانُ جَدَاوِلُ",17,"ل",1,0],["لَثَمَ الدهرث راحيتكَ","وغنى عبقري الألحان تحت غصونك",18,"ك",1,0],["لَثَمْتُ حَصا مَغْنَاكَ لمّا وَطِئْتُهُ","وقُلتُ اللآلِي كيف تُظْلم بالرَّضِّ",19,"ض",1,0],["لِثورةِ الفكرِ تأريخٌ يحدّثُنا","بأنَّ ألفَ مسيحٍ دونَها صُلِبا",20,"ب",2,0],["لَثَمْتُ جراحكَ في \" فتحةٍ \"","هي المُصحَف الطُهرُ إذ يُلثَم",21,"م",1,0],["لَثمنا بِها الأَعتاب نُبدي تَحيةً","وَقَد زادَ مِنا عِندَ ذاكَ وَقار",22,"ر",1,0],["لثمتُ ثناياها فذقتُ رُضابَها","كذوب نقيِّ الثلج في خالص الشَّهدِ",23,"د",1,0],["لِثَغْرِ مَخُوفَةٍ إِلاّ سِداداً","وَبابِ مُلِمَّةٍ إِلاّ رِتاجا",24,"ج",2,0],["لَثَناهُ جودُ أَنامِلِهِ","لا يَرفَعُ رَأساً مِن خَجَلِ",25,"ل",1,0],["لِثلاثهنَّ لسانُ صدقٍ في الألى","غَبروا إِلى صَدقاتهِ المَضروجه",26,"ج",2,0],["لِثَمانِ عَشرٍ مِن رَبيعِ مَولِدِ ال","هادي البَشيرِ المُصطَفى مَولى التُقى",27,"ق",2,1],["لُثنَ خُمراً عَلى عَناقيدِ كَرمٍ","يانِعاتٍ أُتمِمنَ في إِكمالِ",28,"ل",1,0],["لَثمتُ يَد المَحبوب يَوماً فَقالَ لي","عَلى خَجَلٍ حوشيتَ يا عَلَم المَجدِ",29,"د",1,1],["لثَمْتُه ونظَمْتُ القولَ أَمدَحُه","ولم أَكنْ لأُجيدَ المَدْحَ لَولاه",30,"ا",2,0],["لثَمْنا ثَمَّ أيدي العيسِ شُكْراً","وألْصَقْنا المباسِمَ بالمناسم",31,"م",1,0],["لثَم العِمامةَ مُقتنِعاً به","فَخْراً وبَجّل رأسَه تَبْجيلا",32,"ل",2,0],["لثمتُ كفَّك شِكْراً وهْي طاميةٌ","يُروِي صدَى الوَفدِ منها أعذَبُ النُّطَف",33,"ف",1,0],["لِثامُه مثْلُ غَيْمٍ حَشْوه بَرَدٌ","يَشِفُّ من بُعُدٍ عنه وما حُدِرا",34,"ر",2,0],["لِثُغورِ زُهرٍ أَومَضَت","وَخُدودِ وَردٍ قَد تَخَفَّر",35,"ر",1,0],["لثمت بهاتيك العراص ثغورها","كما لثمت قدماً ثغور ترائبي",36,"ب",2,0],["لثمتك فانقدت ضلوعي لزفرتي","وكادت بورحي في الخياشيم تهبط",37,"ط",1,0],["لُثْ عليها الرداءَ فالشّعَر المق","تول داءٌ في الأعين القتّالَهْ",38,"ل",2,0],["لثَّمَها التحصينُ عن غيركم","وهي على أبوابكم سافرُ",39,"ر",1,0],["لَثمتُ ما خطَّت يدُ الكاتب مِن","وصفِكَ لي لثمَ المطيفين الحجَرْ",40,"ر",1,0],["لثوب الرياسةِ ضيقٌ علي","ه معْ وُسْعِ أثوابهِ وانشمارُ",41,"ر",1,0],["لُثْنَ العناقيدَ فوقَ الخُمرِ واختلفت","شِفاهُهنَّ على ماءِ العناقيدِ",42,"د",1,0],["لثروةِ مِعْدامٍ ونُصْرة خائفٍ","وزيْنِ نديٍّ أتْمكَتْهُ المجامعُ",43,"ع",1,0],["لثنَائِه الأعمارُ خالدةٌ","ولِمالِه بنوالهِ تَلَفُ",44,"ف",1,0],["لثنوا أمانيَّ العفاةِ بجودهم","بيضَ الطلى والحاسدين بسودها",45,"د",3,0],["لثنى حسامَ الصبرِ وهو مثلّمٌ","يومَ الوداع ملثّمٌ ومقنّع",46,"ع",1,0],["لثنى أبو اليمن المقالَ يمانياً","بالمعجزات موشّحٌ وموشّع",46,"ع",1,0],["لثناه يوماً شاتياً بدمائهم","لا كالشتاء وكان يوماً صيفا",47,"ف",2,0],["لثمنا ثغور النَّور في شنب الندى","خلال جبين النهر في طرر الظلّ",48,"ل",1,0],["لِثامُهُ يَنحَظُّ مِن وَجهِهِ","عَن سَحَرٍ مِن فَوقِهِ غَيهَبُ",49,"ب",1,0],["لَثَقُلَت دِمَاءُ أه","لِ مِصرَ ألفَ جِيلِ",50,"ل",1,0],["لثقاً تجفجفه الصِبا وَكأَنَّه","شاكٍ تَنَكَّر وَردهُ مَربوعُ",51,"ع",1,1],["لثْمِي ثَرى مَلِكٍ تَذِ","ل له الملوكُ مَعَ المَمَالِكْ",52,"ك",1,0],["لُثِّمتْ فوق نَقْبِها فَهنِيئاً","ولا غَرْوَ فالهَنا في النَّقْبِ",53,"ب",1,0],["لَثمْتُ ثَناياهُ وَقبَّلْتُ فَرْقَهُ","وَقَدْ جَدَّ وَجْدٌ بِالفُؤادِ يَشُوقُهُ",54,"ق",2,0],["لثلث الليل ينزل حين يبقى","بلا كيف على مر الليال",55,"ل",1,0]]}