ps://www.poetsgate.com/ViewPoem.aspx?id=174850",""],[4755,"لِثَغرِهَا في خَيَالِي حِينَ يَرتَسِمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183776",""],[4925,"ما بين بابَيْ عينِ سَعْنةَ واليَمنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176643",""],[4940,"هدايا لا تفنى","https://www.poetsgate.com/ViewPoem.aspx?id=210491",""],[4968,"طوق الحرير","https://www.poetsgate.com/ViewPoem.aspx?id=208082",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5239,"وديمة مطرت ربعي على ظمإٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190933",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5431,"وحبي له نورٌ وعطرٌ ولا شكلُ!!","https://www.poetsgate.com/ViewPoem.aspx?id=195351",""],[5431,"قد جاء في (ظلل الغمام) وجنده","https://www.poetsgate.com/ViewPoem.aspx?id=197376",""],[5464,"القتلى لن يُحييهم الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=125401",""],[5464,"القتلى لا يحييهم الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=24377",""],[5528,"لمن خلفهم عزم وشعلة نبراس","https://www.poetsgate.com/ViewPoem.aspx?id=201025",""],[5688,"تنصحني لأنسى ولكن...","https://www.poetsgate.com/ViewPoem.aspx?id=201026",""],[5897,"مساء عيد","https://www.poetsgate.com/ViewPoem.aspx?id=160574",""],[5937,"كأسٌ وناي","https://www.poetsgate.com/ViewPoem.aspx?id=211827",""],[6102,"شادن","https://www.poetsgate.com/ViewPoem.aspx?id=184418",""],[6125,"عَيْنِي مسهَّدةٌ وقَلْبِي واجِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=210913",""],[6131,"همسُ المَطَر","https://www.poetsgate.com/ViewPoem.aspx?id=189527",""],[469,"ولولا وشاة بل رواة تخرصوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574836",""],[6243,"لي .. للدّلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84447&r=&rc=21",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[6325,"معراج روح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88021&r=&rc=3",""],[6325,"صورة أخرى للحرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88018&r=&rc=0",""]],"verses":[["لَثِقُ المُناخِ ثَقيلَةٌ أَوراكُهُ","حَضِرُ المَجَرُّ مُرَوَّضٌ بِالبَلقَعِ",0,"ع",1,0],["لَثَّمتَ خَدَّ الشَمسِ مِنهُ بِأَسوَدٍ","وَالنورُ يَشهَدُ أَنَّ وَجهَكَ سافِرُ",1,"ر",1,0],["لِثامي غُبارُ الخَيلِ في كُلِّ غارَةٍ","وَثَوبي العَوالي وَالحَديدُ المُذَرَّبُ",2,"ب",1,0],["لَثمتُ الثَرى مُستَشفِياً بِتُرابِهِ","وَمَن لي بِأَن يَشفي غَليلي تُرابُهُ",3,"ب",2,0],["لثغرهِ ولخديهِ وطرَّته","شبهٌ من الدُّرِّ والياقوت والسبج",4,"ج",1,0],["لثمت ثغر عذولي حين سماك","فلذّ حتَّى كأني لاثم فاك",5,"ك",1,1],["لَثَنى صُدورَ السُمرِ تَكشِفُ كُربَةً","وَلَوى رُؤوسَ الخَيلِ تَفرُجُ ضيقا",6,"ق",2,0],["لثم الصليب فقلت من حسد","قبل الحبيب فمي بها أولى",7,"ل",2,0],["لثمت مقاطر أقلامه","وثقت إلى لثم أقدامه",8,"ه",1,1],["لَثَكِلتُ آمالي لَدَيهِ بِأَسرِها","أَو كانَ إِنشادي خَفيرَ كَلامي",9,"م",2,0],["لثابِتُ العَهدِ لَم يَحلُل قُوى أَمَلِي","يَأسٌ وَلَم تَخطُ بِي في سَلوَةٍ قَدَمي",10,"م",2,0],["لثغةُ مَنْ أهواهُ مِنْ حسنِها","عندي على الوجهينِ محمولَهْ",11,"ل",2,1],["لُثِمَتْ بإيمانِ القلوبِ وإنّها","لَتُرَى على مَرِّ الزَّمانِ فتُلثَم",12,"م",1,0],["لِثَقالِ الأَعجازِ تَمشي الهُوَينى","مِثلَ غُصنِ الرَيحانَةِ المَيّادِ",13,"د",1,0],["لَثَوَيتَ في قِدٍّ هُنالِكَ موثَقاً","في القَومِ أَو لَثَوَيتَ غَيرَ مُوَسَّدِ",14,"د",1,0],["لِثامِ المِلْكِ حِينَ تُعَدُّ كَعْبٌ","ذَوُو الأَخْطارِ والخُطَطِ الجِسامِ",15,"م",1,0],["لثمت فيها الأديم السمح فالتهبت","مراشف الحور من حصبائها حسدا",16,"د",2,0],["لَثِقِ الرِّيشِ تَدَلَّى غُدوَةً","مِن أَعَالي صَعبَةِ الَمرقَى طِمارِ",17,"ر",1,0],["لَثَمْتُ بِهَا كَفّاً هِيَ الْبَحْرُ فِي النَّدَى","تَفِيضُ سَمَاحاً وَالْبَنَانُ جَدَاوِلُ",18,"ل",1,0],["لَثَمَ الدهرث راحيتكَ","وغنى عبقري الألحان تحت غصونك",19,"ك",1,0],["لَثَمْتُ حَصا مَغْنَاكَ لمّا وَطِئْتُهُ","وقُلتُ اللآلِي كيف تُظْلم بالرَّضِّ",20,"ض",1,0],["لَثَغاتُ الصغير -إن حَاوَل النط","قَ- نَشيدٌ، موقَّعٌ، وأداءُ",21,"ا",2,0],["لِثورةِ الفكرِ تأريخٌ يحدّثُنا","بأنَّ ألفَ مسيحٍ دونَها صُلِبا",22,"ب",2,0],["لَثَمْتُ جراحكَ في \" فتحةٍ \"","هي المُصحَف الطُهرُ إذ يُلثَم",23,"م",1,0],["لثمت الثّرى سبعا وكحّلت مقلتي","بحسن كأسرار السماء مهيب",24,"ب",1,0],["لَثمنا بِها الأَعتاب نُبدي تَحيةً","وَقَد زادَ مِنا عِندَ ذاكَ وَقار",25,"ر",1,0],["لثمتُ ثناياها فذقتُ رُضابَها","كذوب نقيِّ الثلج في خالص الشَّهدِ",26,"د",1,0],["لِثَغْرِ مَخُوفَةٍ إِلاّ سِداداً","وَبابِ مُلِمَّةٍ إِلاّ رِتاجا",27,"ج",2,0],["لَثَناهُ جودُ أَنامِلِهِ","لا يَرفَعُ رَأساً مِن خَجَلِ",28,"ل",1,0],["لِثلاثهنَّ لسانُ صدقٍ في الألى","غَبروا إِلى صَدقاتهِ المَضروجه",29,"ج",2,0],["لِثَمانِ عَشرٍ مِن رَبيعِ مَولِدِ ال","هادي البَشيرِ المُصطَفى مَولى التُقى",30,"ق",2,1],["لُثنَ خُمراً عَلى عَناقيدِ كَرمٍ","يانِعاتٍ أُتمِمنَ في إِكمالِ",31,"ل",1,0],["لَثمتُ يَد المَحبوب يَوماً فَقالَ لي","عَلى خَجَلٍ حوشيتَ يا عَلَم المَجدِ",32,"د",1,1],["لثَمْتُه ونظَمْتُ القولَ أَمدَحُه","ولم أَكنْ لأُجيدَ المَدْحَ لَولاه",33,"ا",2,0],["لثَمْنا ثَمَّ أيدي العيسِ شُكْراً","وألْصَقْنا المباسِمَ بالمناسم",34,"م",1,0],["لثَم العِمامةَ مُقتنِعاً به","فَخْراً وبَجّل رأسَه تَبْجيلا",35,"ل",2,0],["لثمتُ كفَّك شِكْراً وهْي طاميةٌ","يُروِي صدَى الوَفدِ منها أعذَبُ النُّطَف",36,"ف",1,0],["لِثامُه مثْلُ غَيْمٍ حَشْوه بَرَدٌ","يَشِفُّ من بُعُدٍ عنه وما حُدِرا",37,"ر",2,0],["لِثُغورِ زُهرٍ أَومَضَت","وَخُدودِ وَردٍ قَد تَخَفَّر",38,"ر",1,0],["لثمت بهاتيك العراص ثغورها","كما لثمت قدماً ثغور ترائبي",39,"ب",2,0],["لثمتك فانقدت ضلوعي لزفرتي","وكادت بورحي في الخياشيم تهبط",40,"ط",1,0],["لُثْ عليها الرداءَ فالشّعَر المق","تول داءٌ في الأعين القتّالَهْ",41,"ل",2,0],["لثَّمَها التحصينُ عن غيركم","وهي على أبوابكم سافرُ",42,"ر",1,0],["لَثمتُ ما خطَّت يدُ الكاتب مِن","وصفِكَ لي لثمَ المطيفين الحجَرْ",43,"ر",1,0],["لثوب الرياسةِ ضيقٌ علي","ه معْ وُسْعِ أثوابهِ وانشمارُ",44,"ر",1,0],["لُثْنَ العناقيدَ فوقَ الخُمرِ واختلفت","شِفاهُهنَّ على ماءِ العناقيدِ",45,"د",1,0],["لثروةِ مِعْدامٍ ونُصْرة خائفٍ","وزيْنِ نديٍّ أتْمكَتْهُ المجامعُ",46,"ع",1,0],["لثنَائِه الأعمارُ خالدةٌ","ولِمالِه بنوالهِ تَلَفُ",47,"ف",1,0],["لثنوا أمانيَّ العفاةِ بجودهم","بيضَ الطلى والحاسدين بسودها",48,"د",3,0],["لثنى حسامَ الصبرِ وهو مثلّمٌ","يومَ الوداع ملثّمٌ ومقنّع",49,"ع",1,0],["لثنى أبو اليمن المقالَ يمانياً","بالمعجزات موشّحٌ وموشّع",49,"ع",1,0],["لثناه يوماً شاتياً بدمائهم","لا كالشتاء وكان يوماً صيفا",50,"ف",2,0],["لثمنا ثغور النَّور في شنب الندى","خلال جبين النهر في طرر الظلّ",51,"ل",1,0],["لِثامُهُ يَنحَظُّ مِن وَجهِهِ","عَن سَحَرٍ مِن فَوقِهِ غَيهَبُ",52,"ب",1,0],["لَثَقُلَت دِمَاءُ أه","لِ مِصرَ ألفَ جِيلِ",53,"ل",1,0],["لثقاً تجفجفه الصِبا وَكأَنَّه","شاكٍ تَنَكَّر وَردهُ مَربوعُ",54,"ع",1,1],["لثْمِي ثَرى مَلِكٍ تَذِ","ل له الملوكُ مَعَ المَمَالِكْ",55,"ك",1,0],["لُثِّمتْ فوق نَقْبِها فَهنِيئاً","ولا غَرْوَ فالهَنا في النَّقْبِ",56,"ب",1,0],["لَثمْتُ ثَناياهُ وَقبَّلْتُ فَرْقَهُ","وَقَدْ جَدَّ وَجْدٌ بِالفُؤادِ يَشُوقُهُ",57,"ق",2,0],["لثلث الليل ينزل حين يبقى","بلا كيف على مر الليال",58,"ل",1,0],["لَثَمَ النَّسيمُ تُرابَهُ فتَضَوَّعَ","أردانُه بالمِسكِ حينَ تَضَوَّعا",59,"ع",2,0],["لثد طُهرتَ يا مهديُّ","مِن عيبٍ ومِن رِجس",60,"س",1,0],["لِثَوبه بِالصَقلِ مِن فَوقِهِ","قعاقع ما تَحتَها طائِلُ",61,"ل",1,0],["لثمت الظبيَ من غيرِ اختيارِهْ","فمرَّ وليس يُمْلَكُ من نِفَارِهْ",62,"ر",2,1],["لَثمُ هَذي النّارِ مُطفٍ للظّما","مِثلَما فيهِ شِفاءُ الأَنفُسِ",63,"س",1,0],["لِثَغرِها البسّامِ قَد وَصَلنا","وَفي حِماها الرّحبِ قَد حَلَلنا",64,"ن",2,0],["لَثَمْتُ صَخْرَكِ مُشْتَاقًا أُقَبِّلُهُ","قَبْلَ الأَحِبَّةِ لَثْمَ الصَّخْرِ وَالطِّينِ",65,"ن",1,0],["لِثَوبِكَ الرَثِّ وَإِخلاقَهُ","كَرِهتُ أَثوابَ الحَريرِ القَشيبْ",66,"ب",1,0],["لثمتُ الجلّنار بوجنتيها","ومن فيها رشفتُ السلسبيلا",67,"ل",2,0],["لَثمُها غيرُ مباح","مِن تناياها الملاحِ",68,"ح",1,0],["لثار بالشام له ثائر","في ألف نغل من بني عض خري",69,"ر",2,0],["لَثمت البَدرَ مِن شَفَتَيهِ قالا","يَشق عَلى شَقيق عَم خالا",70,"ل",2,1],["لثراك أستسقي ثلاثَ سحائبٍ","متكافئاتٍ كلّها في الجودِ",71,"د",1,0],["لثمتها فرشفتُ العزَّ ممتزجاً","فيه الغنى وأخذ الريِّ في النهل",72,"ل",1,0],["لثلاثٍ دمٌ وثنتين مس","كينان فاعلم وعلم الجهالا",73,"ل",2,0],["لثبات حكمك كاد يذبل يذبلُ","ويشمّ رائحة الزوال شمامُ",74,"م",1,1],["لثاو على الرمضاء لم يلق مشفقاً","على الترب عار بالنجيع مسربل",75,"ل",1,0],["لثموا جوانبه وقد أرج الهدى","وتضوع العليا وفاح النائل",76,"ل",1,0],["لثمت بها من ليلة الوصل شامة","بها تزدهي من حسنها وجنة الدهر",77,"ر",1,0],["لَثمنا ثَرى ذاكَ المقام لأَنَّه","زلال إِذا اشتد الظَما وَنَمير",78,"ر",1,0],["لثغرها ولعيني تبتسمُ","يلوح دُرّان منثور ومنتظم",79,"م",1,1],["لَثَمْتُ ثَرَى أَرْضِهَا بِالجُفُونِ","ومِنْ شَغَفِي خِلْتُهَا أَثْمَدا",80,"د",2,0],["لثالثه في رقاب الأنام","أياد لعمرك لا ننكر",81,"ر",1,0],["لثمان عشر منه قد أرختها","بالله نصرتنا وسيف عرابى",82,"ب",2,0],["لَثمنا بِها كف ابن عَون محمد","فَفاضَت عَلَينا بِالنَوال بُحور",83,"ر",1,0],["لثمت ثغراً لها في ضمنه عسلٌ","ثملت منه وما في الحي لجلاج",84,"ج",1,0],["لثمتُ خدودَه فوشى عذولي","وقالَ لَقَد أَتى شَيئاً فريّا",85,"ي",2,0],["لثمت الحياة بلثميهما","وعاودت بعد السلو الغزلْ",86,"ل",1,0],["لثغوره وشعوره","صبحي وليلي ينتمي",87,"م",2,0],["لِثَنَايَا ثَغرٍ تَتِينُ عَلَى الجُد","رَانِ مِنهُ بَرقٌ لَهُ أضوَاءُ",88,"ا",2,0],["لثمتهُ وهو يجني وردَ بُستانِ","فقالَ ها أنتَ تجني ما أنا جانِ",89,"ن",1,1],["لَثَمتُ فَاهُ عَلَى رَغمٍ وَقُلتُ لَهُ","هَذا جَزَاءُ المَلِيحِ كُلَّمَا سَاءَ",90,"ا",2,0],["لثمت عذار محبوبي الشرابي","فقال: تركت لثم الخد عجبا",91,"ب",2,1],["لِثيَانُو رَبَّةِ الخَدِّ الأَسِيل","فَلَها أَلقَت بِهِ فَوقَ الرُّكَب",92,"ب",1,0],["لثم الضريح وصاح مرتمياً","متبرّكاً بترابه العفر",93,"ر",1,0],["لَثِمَتُ بِفي التَّفَكُّرِ وَجْنَتيْه","فسالَتْ وجْنَتاه دماً عَبيطا",94,"ط",2,1],["لثمته في طلب الإجلال","فانتثرت بفضه اللآلي",95,"ي",1,0],["لثموا يداً بيضاءَ منك كأنّهم","لثموا بها الحَجَر الكريم الأَسودا",96,"د",2,0],["لثغر الشرك أن يبد ابتسام","على عينيه للكفر اتسام",97,"م",1,0],["لثمنا بأوهام 