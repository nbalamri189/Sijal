{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[55,"تذكرت بين المأزمين إلى منى","https://www.aldiwan.net/poem29824.html","الطويل"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[49,"إباء إباء البكر غير مذلل","https://www.aldiwan.net/poem25207.html","الطويل"],[53,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[53,"كفي ملامك قد ملكت عناني","https://www.aldiwan.net/poem66542.html","الكامل"],[51,"مؤاخاة الفتى البطر البطين","https://www.aldiwan.net/poem63141.html","الوافر"],[128,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[370,"أرقت وأمسيت لا أرقد","https://www.aldiwan.net/poem44522.html","المتقارب"],[463,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[469,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[556,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70920","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93678","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67995","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62863","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63021","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86575","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73152","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52183","الرمل"],[4814,"ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=193408",""],[5085,"أشاغلُ نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=188401",""],[5101,"شموع ليلة الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=204585",""],[5213,"بماضي رهيف العزم أقتحم الصعبا","https://www.poetsgate.com/ViewPoem.aspx?id=170408",""],[5431,"رباعيات حول النقد...","https://www.poetsgate.com/ViewPoem.aspx?id=183017",""],[5459,"قتيل الصدود","https://www.poetsgate.com/ViewPoem.aspx?id=204160",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""]],"verses":[["أَأُغضي عَلى ضَيمٍ وَعِزُّكَ ناصِري","وَباعي طَويلٌ مِن وَراءِ سِناني",0,"ن",2,0],["أَأَغدو مُهيناً بِالحَبائِلِ ساعَةً","غَزالاً عَلى قَلبي الغَداةَ كَريما",1,"م",2,0],["أَأُغْضِيْتَ عَنْ حِمَاها عَيْنُ كَالِئِهَا","وَلَمْ تَنَمْ عَنْ حِمَاهَا أَعْيُنُ النُّوَبِ",2,"ب",1,0],["أَأُغضي عَلى الأَمرِ الَّذي لا أُريدُهُ","وَلَمّا يَقُم بِالعُذرِ رُمحي وَمُنصِلي",3,"ل",2,0],["أأغدو وأمري لا يسوء مُنافسي","وأمرُك أمرٌ لا يعارضه أمر",4,"ر",1,0],["أأغيبُ عنكِ فتنعمينَ برقدةٍ","لا خيرَ بعدك في حبيب ثاني",5,"ن",2,0],["أَأَغفُلُ وَالمَنايا مُقبِلاتٌ","عَلَيَّ وَأَشتَري الدُنيا بِديني",6,"ن",2,0],["أأغضي إن مكحلة","إلي بها رمى الدرب",7,"ب",1,0],["أأُغضِي على وِتْرٍ وللسيفِ قائمٌ","وأَقُعُدُ عن مَجدٍ وللعيسِ غارب",8,"ب",1,0],["أَأغزو رجالَ بني مازنٍ","ببطنِ تَبَالَةَ أَم أَرقُدُ",9,"د",1,0],["أأغنى ثرىً منه شقَّتْ عصاك","وأسبغَ نبتاً وأندى دِيَمْ",10,"م",1,0],["أأغدوا شجياً وهو خالٍ من الهوى","وأسهر من وجد به وهو نائم",11,"م",1,0],["أأغضبَ ابنَ أبي فعلُ الذي كبُرا","فينا وفيْ جوف رحمِ أمِّنا حُمِلا؟",12,"ل",2,0],["أأغفُلُ والدّهرُ لا يغفُلُ","وأنسى الّذي شأنُه أعضلُ",13,"ل",1,1],["أَأَغضبُ في حرب العدا لمبارزٍ","وعضْبيَ ينبو حدُّه حين أغضب",14,"ب",1,0],["أَأَغِيبُ عَن حَلَبٍ ثَلاثَةَ أَشهُرٍ","لَم تَكتُبوا فيها إِليَّ بِلَفظَةِ",15,"ه",1,0],["أَأغضي وَما غابَ المثقف عَن يَدي","وَذو الفَقَرات البيض طوع أَناملي",16,"ل",2,0],["أأغراه واشٍ أم حظوظٌ تقاصَرتْ","فما كَانَ قِدْماً يستطيع المُواشيا",17,"ي",2,0],["أَأَغلِبُ هذا الدهرَ أَمْ هو غَالبي","وعزمي مَعي والمَشْرفيُّ مُصاحِبي",18,"ب",2,1],["أَأَغصانُ بانٍ ما أَرى أَم شَمائلُ","وأَقمارُ تمٍ ما تَضمُ الغَلائِلُ",19,"ل",1,1],["أأغنى سلاح الصبر وقعة الخطب","وأنقذ صرعى الحزن من غمرة الكرب",20,"ب",1,1],["أأُغضي على حدٍ من الضَّيم مُرمضٍ","وسيفي بتّارُ الحدودِ رميضُها",21,"ض",3,0],["أأغدو منَ الوجدِ المبرِّح وادعاً","وقد جدَّ للبينِ الخليطُ المودِّعُ",22,"ع",1,0],["أأغرَبَ من هذا يعودُ كما بدا","وسبيُ ديار السلمِ في بلَدِ الكُفرِ",23,"ر",1,0],["أأغانٍ هي آناً نشوةٌ","وهي آناً عِظَةٌ تعقب ذكرى",24,"ر",2,0],["أ أغادرُ موتيَ، أمنعُني","منّي لأعيشَ كما أؤمر؟",25,"ر",1,0],["أأغْرَقُ ظَمْآناً بِبَحْرِ مَوَاجِعٍ","وَحَرْفِيَ سَاقٍ والقرِيْضُ رِوَائِيا",26,"ي",2,0],["أأغسِلُ مِن قروحِ الشِّعرِ جلدي","يَنُزُّ الشِّعْرُ مِن تحتِ الجُلودِ",27,"د",1,0],["أأغمض للأيام طرفي على القذى","وما سنه الآباء من شيم تأبى",28,"ب",2,0],["أأغضب والعطاء لدي نبعٌ","ونور الصبح في العينين يحكي",29,"ي",1,1],["أأغفلتني يا ظبيُ أم تتغافل ؟!","جفوتَ وما عادت تفيدُ الوسائل",30,"ل",1,1],["أأغْفِرُ جومانا أنالا..فلو أنا","غَفَرْتُ ..فلي لن تغفِري أنت ِ غفراني",31,"ن",2,0],["أأغني والقلب جدُّ كليم","والليالي في جوْرها والدماء",32,"ا",2,0]]}