خفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130162","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38338","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38684","الخفيف"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145611","الخفيف"],[985,"","https://poetry.dctabudhabi.ae/diwan/poem/111242","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119912","السريع"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216884","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202083","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64928","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113967","الخفيف"],[1605,"","https://poetry.dctabudhabi.ae/diwan/poem/143637","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27778","الرجز"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32582","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130843",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203492","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204649","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99467","المنسرح"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132782","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216548",""],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32388","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128916","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135704","الخفيف"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105169","الرمل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[4991,"يسأل البحر","https://www.poetsgate.com/ViewPoem.aspx?id=190281",""],[5055,"صحم عروس المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=105044",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[6355,"زيف المنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66642&r=&rc=102",""]],"verses":[["قلّت به الحاجات فالفقراء في","أيامه والأغنياء سواء",0,"ا",2,0],["قلت بي طاقة على الموت لكن","لست للقرب منك ويكِ مطيقا",1,"ق",2,0],["قلت بالحزم لو اقوم ولكن","قعدت بي شيخوختي عن قيامي",2,"ي",1,0],["قلت بعد العياء للمرض","ارحمني ولا تتخذ اليّ سبيلا",3,"ل",2,0],["قُلتُ بُشراكَ قَد أَقَلتُكَ إِكرا","ماً لِذِكرِ المَولى أَبي السِبطَينِ",4,"ن",1,0],["قُلتُ بِاللَهِ ذي الجَلالَةِ لَمّا","أَن تَبَلتِ الفُؤادَ أَن تَصدِقينا",5,"ن",2,0],["قُلتُ بِالخَيفِ مَرَّةً","لِجَوارٍ نَواعِمِ",6,"م",1,1],["قُلتَ بل يثربَ انتويتُ وما أَلْ","فَيْتُ نفسي بغيرها مأمورا",7,"ر",2,0],["قلت بالحق فلنقم","وإذا الحق باطل",8,"ل",1,0],["قُلتُ بَريءِ وَأَنا مُذنِبٌ","هَل يَستَوي المَحرومُ وَالمعطى",9,"ط",2,0],["قلت بشراك انني لك عبد","قال اهلا ومرحبا ببشير",10,"ر",1,0],["قلت بعني نظرة قال لي","بالروح ان كنت لها تبغي",11,"غ",2,0],["قلتُ بُخْلاً بكلّ شيءٍ فقالت","لا ولكن بخِلتُ بي وبِشِبهي",12,"ه",2,0],["قلت بالقشط يمَّحِي قالت اقشط","بالثنايا وأتْبع القشط مَصّا",13,"ص",2,0],["قلت بالله هل سمعتم ببدرٍ","غاب عن عاشقيه لما تبدى",14,"د",2,0],["قُلتُ بِمَحوِ الخَطِّ عَن","هُ وَبِإِثباتِ القُدَر",15,"ر",1,0],["قُلتُ بَعدَ القُربِ ما أَبعَدَني","عَنكَ قالَ الشَكُّ وَالرَدُّ عَلَي",16,"ي",1,0],["قلتُ بِذا لا يُغْتَرَر","فهْو بعيد المُسْتَمَر",17,"ر",1,0],["قلت بالرأي والقياسِ ولكن","كان رأيُ القاضي السروجيِّ أحمَد",18,"د",1,0],["قلت بلى لكنه","ليس يفيد النسب",19,"ب",1,0],["قلتُ بغيري فتحرَّش لها","فالنهضة الخرقاءُ للأخرقِ",20,"ق",1,0],["قُلْتُ بَلى لكنَّها كامِنَةٌ","ضِمْنَ فُؤادٍ شَيِّقٍ وَجيعِ",21,"ع",1,0],["قلت بي كلما أقول وما قد","قلت في خمرة وفي وصف دن",22,"ن",1,0],["قلت بدُورُ التِّم أَسرى السّرى","فارْضَ بأَنِّي لَكَ يا بدرُ وَاق",23,"ق",1,0],["قلت بعد الممات تعرف من خل","فت فهو المبني للمفعول",24,"ل",1,0],["قلت بل العادات جربتها","فأخزن الفلس على الفلس",25,"س",1,0],["قُلتُ بَل شَمسُ ضُحىً","حُسنُها غَيرُ خَفي",26,"ف",2,0],["قُلتُ بَيني وَبَينهُ","ضاعَ شَيءٌ لِعَبدهِ",27,"ه",1,1],["قلت: بالسكباج والجمليا","ت ورخص الشوا معاً بالرقاق",28,"ق",1,0],["قلت باللَه سبيلي","أين نتنى اين تتنى",29,"ن",2,0],["قلت بلى يأكلها معشر","بالهجو أعراضهم وكلوا",30,"ل",3,0],["قلْتُ بجلاً قلْتَ قولاً كاذباً","إنّما يمنعني سيفي ويدْ",31,"د",1,0],["قلت بالأمس لمْ تَجُدْ بلقَاءٍ","ولقَدْ كان لي مِنَ الطول حُقْبا",32,"ب",2,0],["قلتُ باللهِ خَلِّني فتَمادَى","وقَليلٌ مَنْ يَتْرُكُ الشَّرَّ لِلهْ",33,"ل",2,0],["قلت بالاستفهام والمضارع","بالتاء دون فاصل منازع",34,"ع",1,0],["قُلتُ بِاللَهِ فاحلِفي لي أو احلِف","إنَّني بالغَدورِ غيرُ وثوقِ",35,"ق",1,0],["قلت: بالليل كان أخ","فى وأدنى مسره",36,"ر",2,0],["قلت بل هو لفعلي خالقٌ","كلما أتى ولو مثقال ذر",37,"ر",1,0],["قلتُ بماذا قد عُصم","تَ يا فتى من شرِّنا",38,"ن",2,0],["قُلتُ بَيتُ الجَرينِ مَجمَعُ صِدقٍ","كانَ قِدماً لِجَمعِكُم مَعلوم",39,"م",1,0],["قلت بلغ امة اليابان عن","مصر وداً بالاسى تستبطن",40,"ن",1,0],["قلت بالله داوني فسأقضي","ان تبن لي يأساً بداء اليأس",41,"س",1,0],["قلت بالله أي قلب قسى","ضم هذا الجسم الرقيق اللطيف",42,"ف",1,0],["قلت بحقي عليك تطمع أن","تولج في ذا بالشعر والشرف",43,"ف",1,0],["قلت بالله من ابوك فأومت","لي بالطرف ناظر الحربيه",44,"ي",2,0],["قِلت بهواكُم مات شَفقان","والروح خَذْتُوها مَغْصُوبه",45,"ب",2,0],["قُلتُ بَيِّن ما هَلا هَل نَزَلوا","قالَ حَوباً ثُمَّ وَلّى عَجَلا",46,"ل",2,0],["قلت بلى أحبها مثلما","أحببتها أنت أيا مهجتي",47,"ي",1,0],["قلت بالقال من قريش فقالتْ","اصدق الحال من لسان المقالِ",48,"ل",1,0],["قلت بل واهتديت ما مثله مثل","ومثلي بمثله صار مثلا",49,"ل",2,0],["قلت بالكعبة أن أدنو الخبا","منك قالت لا وبيت المقدس",50,"س",1,0],["قلت باللَه أعطفي ان الهوى","حاكم بي مثل أحكام الصلاة",51,"ه",1,0],["قلت بعض الحنين يا ناق سيري","نحو برقٍ دعا لغيثٍ عميد",52,"د",1,0],["قلت برجع للهيامات واصيبه","خلي الحبوب بالحب الجموحي",53,"ح",2,0],["قلت بمدح ثراها غصنها والجذور","لقيت كل المدايح في هواها تجيب",54,"ب",1,0],["قلتُ \"بُؤساكمُو، السلامُ التزامٌ","لا كلامٌ وخدعةٌ وضِرار",55,"ر",1,0],["قلتُ \"بُؤْساك\" قال \"عفوًا فإني","أشتهي العيش صافيًا ذا بريق",56,"ق",1,0],["قلتُ بلْ أرْهقَهُ زَيْفُ المُنى","وتبناه أسىً حتى احْتضرْ",57,"ر",1,0]]}