{"poems":[[65,"طربن إلى نجد وأنى لها نجد","https://www.aldiwan.net/poem46175.html","الطويل"],[56,"لقد رحل ابن موسى بالمعالي","https://www.aldiwan.net/poem27429.html","الوافر"],[32,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[74,"أعد لنا السمر الأشهى نجدده","https://www.aldiwan.net/poem18599.html","البسيط"],[30,"لا بارك الله في قوم ولا شربوا","https://www.aldiwan.net/poem5627.html","البسيط"],[68,"ترى سكرت عطفاه من خمر ريقه","https://www.aldiwan.net/poem40113.html","الطويل"],[50,"قد كان لي حمدان ذا زورة","https://www.aldiwan.net/poem64453.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54848","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[295,"غن فديتك غن","https://www.aldiwan.net/poem11685.html","المجتث"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[463,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[520,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104564","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64562","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66296","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45578","المنسرح"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116829","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26184","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200475","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131246",""],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127928","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72831","الطويل"],[557,"في عينيك عنواني","https://www.poetsgate.com/ViewPoem.aspx?id=7677",""],[4981,"غزليّتي","https://www.poetsgate.com/ViewPoem.aspx?id=190495",""],[5431,"العبودية الجديدة 2 -عمليات التجميل","https://www.poetsgate.com/ViewPoem.aspx?id=210782",""],[5916,"سَلُوْ بَلْقَيْسَ","https://www.poetsgate.com/ViewPoem.aspx?id=190525",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""]],"verses":[["ترى سيمِياءَ العِزِّ فوقَ جبينِهِ","كما لاحَ حَدُّ السّيْفِ أخْلَصَهُ الهِنْدُ",0,"د",1,0],["تَرى سَكَناتِهِ فَتَقولُ غِرٌّ","وَتَحتَ سُكونِهِ رَأيٌ ثَقيفُ",1,"ف",1,0],["تَرى سَيفَهُ لا يَنصُفُ الساقَ نَعلُهُ","أَجَل لا وَإِن كانَت طِوالاً مَحامِلُه",2,"ل",2,0],["ترى سفائنه كالعيس سائرة","والضب والنون والملاّح والحادي",3,"د",2,0],["تَرى سَرابيلَهُم في البَأسِ مُحكَمَةً","مِن نَسجِ داوُدَ أَعطاها سُلَيمانا",4,"ن",2,0],["تُرى سَكِرَت عِطفاهُ مِن خَمرِ ريقِهِ","فَماسَت بِهِ أَم مِن كُؤوسِ رَحيقِهِ",5,"ق",2,1],["تَرى سَواداً قَد عَلا حُمرَةً","مِثلَ تَهاويلِ الشِقِرّاقِ",6,"ق",1,0],["تُرَى سِيَرُ الأَحْقَابِ فِيمَا خَطَطْتَهُ","موَاثِلَ وَهْيَ الطِّرْسُ بِالعَيْنِ وَالحِبْرُ",7,"ر",1,0],["ترى سلطة لا تعرف الله أفظعت","بعارفه والعدل تلك الفظائع",8,"ع",1,0],["ترى سأملأ عيني","من حسن روض أغنّ",9,"ن",1,0],["ترى سماتِ الملك أنوارُها","شاهدةٌ في قوله والفعالْ",10,"ل",1,0],["ترى سوطَ الشَّمال يَشُلّ منها","طرائدَ لا يُكَفُّ لها جِماحُ",11,"ح",1,0],["ترى سيماء الملك فوق جبينه","يلوح لعين الناظر المتوسم",12,"م",1,0],["تَرى سُندسيّ النبتِ تحتَ كِمامهِ","كموشيِّ صُبغِ العِهنِ في عبقريّهِ",13,"ي",2,0],["ترى سُلطان حُسنٍ لا","يَمَلُّ الطرفُ تسليطه",14,"ط",2,0],["ترى سوء حظي يا كبير وذلتي","فيا متعال خذ بجدي إلى العلى",15,"ل",2,0],["ترى سمة الهادي بها وبنو الهدى","تلوح من الآبا عليها سماتها",16,"ت",3,0],["تَرى سَهيلا أَمامَها كلفا","تَخالَهُ إِذ بَدا لِميقات",17,"ت",1,0],["تَرى سبُلَ المعروف نحو سجالهِ","عوامِرَ بالجادينَ من كل موردِ",18,"د",1,0],["تُرى سَيِّئاتِ القَيرانِ تَعاظَمَت","فَجَلَّت عَنِ الغُفرانِ وَاللَه غافِرُ",19,"ر",1,0],["تَرى سُهيلاً أربَعاً مَع نصفِ","والسلِّبارُ مِثلُهُ خُذ وَصفي",20,"ي",1,0],["ترى سواد الفحم في وجهه","يُنبيك أن الماسَ في الفحم",21,"م",1,0],["ترى سطوراً بلا معنى فتحسبها","مدارج النمل حاكت في الثرى رقما",22,"م",2,0],["ترى سفنه من فوق صهوات ظهره","كأَن قصوراً زيَّنتها حبائبُه",23,"ب",2,0],["ترى سيفَه يوم الوغى يقطع العدى","وكفٌ له بالوكف كالغيثِ يمطرُ",24,"ر",1,0],["ترى..ستقول ياعمري","بأنك كنت تهواني؟!",25,"ن",2,0],["تُرَى سَأَصحُو على أنفاسِها ثَمِلَاً ؟","كَمَنْ يفيقُ فلا يدري بِمَا لَبِثَا",26,"ث",2,0],["ترى سرب الذباب بصحن حلوى","غريزيا يظلّ إلى اتساع",27,"ع",1,0],["تَرى سِيْقَانُهَا مَكْشُوْفَةٌ لوْ","رَآها منْ رَأى حَقَّا هَواها",28,"ا",3,0],["2. ترى سَرابَ الفلا منْ دونِ رامتها","كبارِقِ السيفِ في كفٍ لأحراسِ ِ",29,"س",1,0]]}