{"poems":[[79,"ووجه غرست الورد فيه بنظرة","https://www.aldiwan.net/poem35887.html","الطويل"],[44,"أمير المؤمنين جزيت خيرا","https://www.aldiwan.net/poem50232.html","الوافر"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[29,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[63,"نطوي الليالي علما أن ستطوينا","https://www.aldiwan.net/poem51410.html","البسيط"],[68,"وزهر نيلوفر لولا تشعبه","https://www.aldiwan.net/poem38803.html","البسيط"],[33,"أمسى بأسماء هذا القلب معمودا","https://www.aldiwan.net/poem42577.html","البسيط"],[83,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[54,"أما ترى النرجس المياس يلحظنا","https://www.aldiwan.net/poem26953.html","البسيط"],[50,"شمر شبابك في قتلي وتعذيبي","https://www.aldiwan.net/poem10772.html","البسيط"],[50,"ألا دارها بالماء حتى تلينها","https://www.aldiwan.net/poem65278.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[136,"هذى نقول بنص الآي والأثر","https://www.aldiwan.net/poem54824.html","البسيط"],[159,"رض يا غلام على الروض النضير لنا","https://www.aldiwan.net/poem55667.html","البسيط"],[159,"وحديث كأنه","https://www.aldiwan.net/poem55700.html","مجزوء الخفيف"],[302,"أشمس سناها في الدجنة بازغ","https://www.aldiwan.net/poem33222.html","الطويل"],[369,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[371,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[385,"ملأ الغرام فؤاده فتصدعا","https://www.aldiwan.net/poem49244.html","الكامل"],[435,"انظر إلى النهر كم أبدى لنا طربا","https://www.aldiwan.net/poem41041.html","البسيط"],[466,"أبى الهم أن يعتاد صدري وناصري","https://www.aldiwan.net/poem15917.html","الطويل"],[471,"إذا انشق عند السابري رأيته","https://www.aldiwan.net/poem50369.html","الطويل"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144843","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145671","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96626","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96708","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11880","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49577","الوافر"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202381","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100903","الوافر"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124672","السريع"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122501","البسيط"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106685","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91612","الطويل"],[3853,"","https://poetry.dctabudhabi.ae/diwan/poem/124002","البسيط"],[4797,"اي والله اهوجس ولا ني بمرتاح","https://www.poetsgate.com/ViewPoem.aspx?id=132238",""],[4797,"فرقى المواليف","https://www.poetsgate.com/ViewPoem.aspx?id=50254",""],[4915,"اهجريني","https://www.poetsgate.com/ViewPoem.aspx?id=211398",""],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5431,"اسمٌ ويسكن في العينين مكحلها","https://www.poetsgate.com/ViewPoem.aspx?id=185930",""],[5561,"الحوار الحادي عشر","https://www.poetsgate.com/ViewPoem.aspx?id=201774",""],[5721,"لم أعد حتى بنفسي مؤمنا","https://www.poetsgate.com/ViewPoem.aspx?id=214510",""],[5956,"جُبُّ الكهولة الخانق","https://www.poetsgate.com/ViewPoem.aspx?id=192138",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6093,"أشكو إلى الله منْ هَمٍّ يُساورُني","https://www.poetsgate.com/ViewPoem.aspx?id=176150",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["كأنّ احْمِرارَ الخدِّ تحْتَ عِذارِهِ","عَلامَةُ موْلانا علَى أحْمَرِ الطِّرْسِ",0,"س",1,0],["كَأَنّا حينَ جِئناهُ أَطَفنا","بِضَبعانٍ تَوَرَّطُ في حَظيرَه",1,"ر",2,0],["كَأَنَّ اِحتِدامَ الجَوفِ في حَميِ شَدِّهِ","وَما بَعدَهُ مِن شَدِّهِ غَليُ قُمقُمِ",2,"م",1,0],["كَأَنَّ أَحداجَهُم تُحدى مُقَفِّيَةً","نَخلٌ بِمَلهَمَ أَو نَخلٌ بِقُرّانا",3,"ن",2,0],["كأنَّ أحشاءَنا من ذِكرِه أبداً","تُطوَى على الجَمْرِ أو تُحشَى السَّكاكِينا",4,"ن",2,0],["كَأَنَّ أَحمَرَهُ حُسناً وَأَزرَقَهُ","إِذا غَدا بِلِسانِ الحالِ مَنعوتا",5,"ت",2,0],["كَأَنَّ أَحوَرَ مِن غِزلانِ ذي بَقَرٍ","أَهدى لَها شَبَهَ العَينَينِ وَالجيدا",6,"د",2,0],["كَأَنَّ اِحمِرارَ الأُفقِ وَالفَجرَ وَالدُجى","دَمٌ وَحُسامٌ مَشرَفِيٌّ وَمَفرِقُ",7,"ق",1,0],["كَأَنَّ أَحداقَها في حُسنِ صورَتِها","مَداهِنُ التَبرِ في أَوراقِ كافورِ",8,"ر",1,0],["كَأَنَّ أَحداقَها وَالماءُ يَقرَعُها","في ساحَةِ الكَأسِ أَحداقُ اليَعاسيبِ",9,"ب",1,0],["كَأَنّا حُلولٌ بَينَ أَكنافِ رَوضَةٍ","إِذا ما سَلَبناها مَعَ اللَيلِ طينَها",10,"ن",3,0],["كأنَّ أحاديثَه بيننا","أساطيرُ آلهةٍ غابرينْ",11,"ن",1,0],["كَأَنَّ أحرَفَها في رَقِّها دُرَرٌ","وفي أسَالِيبِها أبَهى مِنَ الدُّرَرِ",12,"ر",1,0],["كأَنَّ أَحْداقَهُ في حسنِ صُفْرَتِهِ","مَداهِنُ التِّبرِ في أوراقِ كافورِ",13,"ر",1,0],["كانَ أَحلى مِنَ الرُّقا","دِ عَلى جَفْنِ ساهِرِ",14,"ر",1,0],["كأَنَّ اِحمرارَ الخَدَّ من وَجَناتها","له حسنُها من مهجة الصبِّ صابغُ",15,"غ",1,0],["كأنّا حَمامٌ حينَ لاقتْ نفوسَنا","جزَتْ صَوْغَ أَطواقٍ بصَوْغِ شُجون",16,"ن",1,0],["كأَنَّ أَحرُفَهُ كَأسٌ يَدورُ بِها","ساقي يَراعٍ عَلَيها الشَكلُ كَالحَبَبِ",17,"ب",1,0],["كَأَنّا حُروفٌ وَالمَراكِبُ أَشطُرٌ","وَريحُ الصَبا تَطوي وَأَمواجُها الكُتبُ",18,"ب",1,0],["كانَ اِحتِجابك سَيدي لي موجعاً","وَبَدا الصُدود فَكانَ مِنهُ أَوجَعا",19,"ع",2,0],["كأن احداهما ذات الجمال بدت","وتلك عاشقها يشكو لها الحرقا",20,"ق",2,0],["كأنَّ أحاديثَ الوزيرِ وذِكرَه","منابتُ روضِ الحَزْن باكرها القطر",21,"ر",1,0],["كأَنَّ أَحَمَّ المأقيين أَعارَها","بِرَمَّانَ عَينَيهِ إذا ما تَلَدَّدا",22,"د",2,0],["كان أَحْوَى فزِيد بِالعين رَاءٌ","حِينَ يَرْنُو فَصَارَ أَحْوى وأَحْوَر",23,"ر",1,0],["كأنَّ احمرارَ النارِ من تحت فحمها","خدودُ عذارى في محاجرَ سودِ",24,"د",1,0],["كَأَنّ أَحمَرَهُ في الرّوضِ مبخرةً","قَد بَخَّرت لا بِعودٍ لا ولا شَرَرِ",25,"ر",1,0],["كأن أحمرها من بين أسودها","بقية الشفق البادي مع الغبش",26,"ش",1,0],["كأنّ أَحداجهم في سيرها سفنٌ","في اليمّ أَتبعها الملّاح ملّاحا",27,"ح",2,0],["كأنَّ أحداجَهم يوم النوى سفن","في اليمِّ لمّا طفت في زاخر الآلِ",28,"ل",1,0],["كَأَنَّ اِحمِرارَ الخَدِ مِمَّن أُحِبُّهُ","حَديقَةُ وَردٍ وَالعِذارُ سِياجُها",29,"ه",2,1],["كأنا حيثُ لم نَسَعِ المنايا","فَطَبَقَتِ الحُزُونَةَ والسُّهولا",30,"ل",2,0],["كان احتياطهمُ لمالى صاينا","ورماه طالبه مكان الأنجم",31,"م",1,0],["كأنَّا حيثمَا سِرنَا بمصرٍ","نزلنا منهُما فى مهرجان",32,"ن",1,0],["كأنّ احلاَم الهوى صفحةٌ","خرساءُ بالمآءِ كتبناها",33,"ا",3,0],["كَانَ أحمَدُ يُملِيفِي مسانِدِهِ","عَن ابنش قَطَّانَ والآلافُ تسمَعُهُ",34,"ع",2,0],["كأنَّ احمِرارَ الوردِ خدُّ عَقِيلَةٍ","عَلاَهَا الحَيَا إن حُطَّ عَنهُ وِشَاحُ",35,"ح",1,0],["كَأَنّ احتساها نَزعةً بعد نزعةٍ","خُطاً للصفا وَالشِّربَ ركبٌ يبالغُ",36,"غ",1,0],["كان أحور من أدم الفلا فردا","أعارها منه حسن الجيد والحورا",37,"ر",2,0],["كان احسبن لحبنا عشرة ارواح","الين شفت الحبل بيدي مقطوع",38,"ع",1,0],["كان أحسب إن لحبنا عشرة أرواح","إلين شفت الحبل بيديه مقطوع",39,"ع",1,0],["كانَ أحلى بما حوى من معانٍ","مُبهراتٍ واليومَ ما عادَ أحلى",40,"ل",2,0],["كان أحرى وأنت في حضن صب","أن ترى الصدق في هواه وتبقى",41,"ق",2,0],["كان أحرى ان تطلبوا الشعب","كي يضفي رضاه عنكم وكي يتغمد",42,"د",1,0],["كأنّ أحرفه في حسنها امتلكت","يمَّ الصبابة من سحر ومن عسل",43,"ل",1,0],["كانَ إحساسي كاشتياقي عجولاً","وسماواتي صرنَ فيَّ مدارا",44,"ر",2,0],["كَانَ إِحْسَاساً بِأنِّي مِلِكٌ","مَا أُلاقِيهِ بِحُبِّي هَيِّنَا",45,"ن",2,0],["كان احتفاله بي عجيباً طاهراً","كالشمس في التأثير والتنوير",46,"ر",1,0],["كان احتشادَ ثقافاتٍ مطهرة","جاءتْ من الوُرْق لم تُحْشدْ مع السَّيْدِ",47,"د",1,0],["كأنَّ إحسانَهُ دَيْنٌ عليهِ لهمْ","جاءوا قضاةً فأقضاهم على عجَلِ",48,"ل",1,0],["كأَنَّ أحمَدَ بالأصفادِ كَبَّلَهُم","فَارتَدَّ جَيشُهُمُ المقهورُ بالسَّدَمِ",49,"م",1,0]]}