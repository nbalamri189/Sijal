عَفرا أَن يُعَفِّرَ أُمَّهُ","كَعَفرِ السَلا إِذ عَفَّرَتهُ ثَعالِبُه",117,"ب",2,0],["نَهَضتُ بِأَكنافِ الجَناحَينِ نَهضَةً","إِلى خَيرِ أَهلِ الأَرضِ فِرعاً وَعُنصُرا",118,"ر",2,0],["نَهى أَهلَهُ عَنها الَّذي يَعلَمونَهُ","إِلَيها وَزالَت عَن رَجاها ضَرائِرُه",119,"ر",2,0],["نَهَضَت لِتَحرُزَ شِلوَها فَتَجَوَّرَت","وَالمُخَّ مِن قَصَبِ القَوائِمِ رارُ",120,"ر",1,0],["نَهَيتُكَ أَن تَجري وَلَيسَ بِلاحِقٍ","مَشوبُ الفِلاءِ بِالجِيادِ الخَوالِصِ",121,"ص",1,0],["نَهَيتُ اِبنَ راعي الإِبلِ عَنّي فَلَم يَزَل","بِهِ الحَينُ حَتّى أَطلَقَتهُ حَبائِلُه",122,"ل",2,0],["نَهَزتَ بِدَلوٍ يَملَأُ الأَرضَ نِصفُها","وَخَيرُ دِلاءِ المُستَقينَ سَجيلُها",123,"ل",3,0],["نُهينُ بِها النيبَ السِمانَ وَضَيفُنا","بِها مُكرَمٌ في البَيتِ غَيرُ مُهانِ",124,"ن",1,0],["نهر حريري . . ومروحة","صينية . . وقصيدة تكتب",125,"ب",1,0],["نهاره ينظر عن مقلة","ساجية الألحاظ مبهوته",126,"ت",2,0],["نُهدي التحيَّةَ منهمُ لمحجَّبٍ","عَبَراتُنا أبداً تَحيَّةُ دارِه",127,"ر",2,0],["نَهْبٌ فلو حضَرَتْه النارُ مُضْرَمةً","جرى إليه يخوضُ النارَ ناهبُه",128,"ب",2,0],["نُهنِّيكَ بالبُرْءِ الذي قامَ فِعلُه","مقامَ الضُّحى والحِنْدِسِ المتراكبِ",129,"ب",1,0],["نَهوزٌ بِلَحيَيها أَمامَ سِفارِها","وَمُعتَلَّةٌ إِن شِئتَ في الجَمَزانِ",130,"ن",1,0],["نَهَتهُم سُيوفُ الهِندِ أَن يَقِفوا لَنا","غَداةَ التَقَينا وَالرِماحُ المَصايِدُ",131,"د",1,0],["نَهنِه دُموعَكَ كُلُّ حَيٍّ فانِ","وَاِصبِر لِقَرعِ نَوائِبِ الحَدَثانِ",132,"ن",1,1],["نَهانا النُهى عَنها فَلَجَّت قُلوبُنا","فَقُلنا اِقدُمي إِنَّ الجُنونَ فُنونُ",133,"ن",1,0],["نُهَوِّنُ في سُبلِ الغَرامِ نُفوسَنا","وَما عادَةً قَبلَ الغَرامِ تَهونُ",133,"ن",1,0],["نَهَبنَ قُلوبَ العاشِقينَ وَغادَرَت","بِجِسمي ضَنىً لِلقَلبِ مِنهُ شُجونُ",133,"ن",1,0],["نَهَضنا لِنَستَسقي السَحابَ فَجادَنا","سَحابُ نَدى كَفَّيهِ وَهيَ هَتونُ",133,"ن",1,0],["نَهَبتَ الثَنا وَالجودَ وَالمَجدَ وَالعُلى","وَنِلتَ الأَماني وَالزَمانُ سُكونُ",133,"ن",1,0],["نُهدي الثَناءَ وَلا نَبغي لَهُ ثَمَناً","وَرُبَّ دَوحٍ نَضيرٍ ما لَهُ ثَمَرُ",134,"ر",1,0],["نَهى اللَهُ عَن شُربِ المُدامِ لِأَنَّها","مُحَرَّمَةٌ إِلّا عَلى مَن لَهُ عِلمُ",135,"م",1,1],["نَهَكَ المُفرِطونَ فيها حِمى الإِس","لامِ مِن غَيرِ عِدَّةِ وَثَباتِ",136,"ت",1,0],["نَهَضتَ بِأَمرٍ يُعجِزُ الشُمَّ ثِقلُهُ","فَقُمتَ بِهِ جَزعاً وَرَأيُكَ قادِحُ",137,"ح",1,0],["نَهَضَت بِأَجنِحَةِ القُلوعِ كَأَنَّها","عِندَ المَسيرِ تَهُمُّ بِالطَيَرانِ",138,"ن",1,0],["نهاري في لوافحها سراب","وليلي من أباطيل وكذبِ",139,"ب",1,0],["نَهَتِ الكواشحَ عنه والعُذّالا","فَكَأنَّما ملأتْ يديه وصالا",140,"ل",2,1],["نَهَضتِ إِلى هَجْرِ الوصالِ نَشيطَةً","وَأَنتِ أَناةٌ في النواعِمِ مِكْسالُ",141,"ل",1,0],["نَهنِهي الحُزنَ فَإِنَّ ال","حُزنَ إِن لَم يُنهِ لَجّا",142,"ج",2,0],["نَهوضٌ بِثِقلِ العِبءِ مُضطَلِعٌ بِهِ","وَإِن عَظُمَت فيهِ الخُطوبُ وَجَلَّتِ",143,"ت",1,0],["نهدُها يُطفي لهيبي","فَهْوَ رمانٌ محققْ",144,"ق",1,0],["نهرُهُ إنْ قابلَ الشمسَ ترى","فضةٌ بيضاءَ في نهر ذهبْ",145,"ب",1,0],["نهضتَ بحجةِ الإملاءِ عني","فداكَ أبي كما أحييت أمي",146,"ي",1,0],["نَهَضنا بِأَعباءِ اللَيالي جَزالَةً","وَأَرسَت بِنا في النائِباتِ هِضابُ",147,"ب",1,0],["نَهرٌ كَما سالَ اللَمى سَلسالُ","وَصباً بَليلٌ ذَيلُها مِكسالُ",148,"ل",1,1],["نَهَضَت في كُلِّ مُعضِلَةٍ","بِوُجودِ السَعدِ في الخَدَمِ",149,"م",1,0],["نَهاري نَهارٌ طالَ حَتّى مَلِلتُهُ","وَلَيلي إِذا ما جَنَّني اللَيلُ أَطوَلُ",150,"ل",1,0],["نَهاري نَهارُ الناسِ حَتّى إِذا بَدا","لِيَ اللَيلُ هَزَّتني إِلَيكِ المَضاجِعُ",151,"ع",1,1],["نهض الشبابُ وجالتِ الآمالُ","والمجدُ أجمعُ نهضةٌ ومجالُ",152,"ل",1,0],["نهضت قُوى الجيل الذي انتفضت له","وتطلّعت من حوله الأجيالُ",152,"ل",1,0],["نهضت شُعوبُ الأرض ترفع مجدها","وأرى شُعوبَ المسلمين جُثوما",153,"م",2,0],["نهض الشّبابُ فما تَحيدُ صُفوفُهم","وَمَضَوا فلا فَرَقٌ ولا إحجامُ",154,"م",1,0],["نهضت تَسُدُّ على المُغيرِ مجالَه","وتُريه سَدَّ الموتِ كيف يُزاحُ",155,"ح",1,0],["نَهضتْ بالوجدِ والمجدِ معاً","وقضتْ ما عَرَفتْ من حقِّ ذيْنْ",156,"ن",1,0],["نَهض المُلكُ على أمثالِها","واستتبَّ الأمرُ فيه وانتظمْ",157,"م",1,0],["نَهضْنا نَتْبَعُ السَّنَنا","وَنَحمِي الدِّينَ والوَطَنا",158,"ا",1,0],["نهضَ الأُباةُ بهم إلى مُستشرفٍ","تَنجابُ عنه قوارعُ الحِدْثانِ",159,"ن",1,0],["نهضوا بأعباءِ الجهادِ أعزَّةً","وتعاوروا أعلامَه أبطالا",160,"ل",2,0],["نُهِينُ الغاصِبينَ إذا اسْتبدُّوا","ونَأبَى أن نكونَ لهم عبيدا",161,"د",2,0],["نهضنا تَخذُلُ الأوصالَ منّا","مناكبُ يَسْتَقِمْنَ ويلتوينا",162,"ن",2,0],["نُهين الناكثينَ ونجتويهم","ونرفضُ خُطّةَ المُتقَلِّبينا",162,"ن",2,0],["نَهضنَ وأسيافُ الغُزاةِ مآزِرٌ","وسِرنَ وأعرافُ الجِيادِ براقِعُ",163,"ع",1,0],["نَهضُتم بهِ حُرَّاً وليس بناهضٍ","إلى المجدِ شَعبٌ أَثْقلتْهُ الجوامعُ",163,"ع",1,0],["نهضوا لغيرِ بلادِهم فعرفتُهم","وعرفتُ نهضتَهم إلى اضمحلالِ",164,"ل",1,0],["نَهَضتُ أَو جاشَتِ الأَعراقُ تَنهَضُ بي","إِلى سُيوفِ بَني عَمّي أُحَيّيها",165,"ي",3,0],["نَهفو وَتثبت رُجّحاً أَحلامُنا","وَتَظلُّ تَهفو منهمُ الأَحلامُ",166,"م",1,0],["نَهاهُ مُحمّدٌ عن كلِّ أمرٍ","تَضِيقُ بهِ وما هو بالعَصِيِّ",167,"ي",1,0],["نَهاهُ فلا دَمٌ في الحيِّ يُشوَى","ولا شَيْخٌ يَجوعُ ولا غُلامُ",168,"م",1,0],["نَهَضَ الغُزاةُ فأين تَمْضِي العِيرُ","أعَلَى الغمامِ إلى الشآمِ تَسيرُ",169,"ر",1,1],["نَهَى القومَ عن لبسِ الحريرِ نَبِيُّهم","ولا شيءَ إلا ما نَهى عنه أو أمَرْ",170,"ر",1,0],["نَهضتَ خَفيفَ الجانِبَيْنِ ولم تَكُنْ","على مثلِها من قبلِ ذلكَ قادرا",171,"ر",2,0],["نَهَضَ النبيُّ يُقيمها في صحبهِ","للَّهِ تُبْدأُ بالخشوعِ وَتُختَم",172,"م",1,0],["نهضوا خَفافاً لو رأيتَ جُموعَهم","لَعَلِمتَ أيَّ النّاسِ إيماناً هُمُ",172,"م",1,0],["نهاهم قبل ذلك أن يخونوا","فكان الغدرُ والداءُ الوبيلُ",173,"ل",1,0],["نَهَضَ القومُ برأيٍ مُبصِرٍ","وَدَهَتْكم عَثرةُ الرأيِ العَمي",174,"م",2,0],["نهض الحماةُ به ولو لم يهتدوا","لم يبرحوا في القاعدين جُثوما",175,"م",2,0],["نهضتْ من كلِّ أوبٍ تلتقي","فاحذروها يا بَنِي المصطلقِ",176,"ق",1,1],["نهض الفاروقُ يدعوهم إلى","مِلّةِ الخيرِ دُعاءَ المُشفِقِ",176,"ق",1,0],["نَهرٌ كَأَنَّ الشَمسَ تَملَأُ قَلبَهُ","فَيُجِنُّ داءً لِلغَرامِ دَخيلا",177,"ل",2,1],["نَهَبتُ فيها عَقيقَ الدَمعِ مِن أَسَفٍ","حَتّى رَأَيتُ جُمانَ الشُهبِ قَد نُهِبا",178,"ب",2,0],["نهجوا منهجَ القويَّ وصفُّوا","لجهادٍ منصورةٌ أعلاُمهْ",179,"م",2,0],["نَهَضَت بَواسل فيك تق","ذف بِالنُفوس إِلى الجِهاد",180,"د",1,0],["نَهض الشَباب يُطالِبون بِمجدهم","يا أَيُّها الوَطَن المَجيد تَيمن",181,"ن",1,0],["نَهراً جارياً وَبَيتاً عَليّاً","يَعتَري المُعتَفينَ فَضلُ نَداكا",182,"ك",2,1],["نَهَضتُ إِلَيها مِن جُثومٍ كَأَنَّها","عَجوزٌ عَلَيها هِدمِلٌ ذاتُ خَيعَلِ",183,"ل",1,0],["نَهَضنَ بِأَعجاز ثِقالٍ تُمِيلُها","فَتَسمُو بِأَعناقٍ لَها وَصُدُورِ",184,"ر",1,0],["نَهى الجَهلَ شَيبُ الرَأسِ بَعدَ نِزاعِ","وَما كُلُّ ناهٍ ناصِحٍ بِمُطاعِ",185,"ع",1,1],["نُهَنّي الرَحلَ بِالخَيلِ المَذاكي","وَعُزّابَ الفَرائِسِ بِالنِكاحِ",186,"ح",1,0],["نَهَتْهُ عَنْ لَذَّةِ الدُّنْيا نَزَاهَتُهُ","وَشَرَّدَ النَّوْمَ مِنْ أجفانِهِ السَّهَرُ",187,"ر",1,0],["نَهَى السُّلْطانُ عَنْ شُرْبِ الْحُمَيَّا","وَصَبَّر حَدَّها حَدَّ الْيَمَانِيْ",188,"ي",1,1],["نَهَضَتْ بثقل الدُّرِّ ضوعِفَ نسجُها","فَجَرَتْ عليه عَسجداً محلولا",189,"ل",2,0],["نُهِيتُ عن الإكثار في جعفرٍ ولنْ","يقاسَ بشيءٍ كلُّ شيءٍ لهُ ضِدُّ",190,"د",1,0],["نَهارُكَ مِن حُسنٍ وَلَيلُكَ واحِدُ","فَذا أَنتَ حَيرانٌ وَذا أَنتَ ساهِدُ",191,"د",1,1],["نَهاري كُلَّهُ وَغَداً","وَبَعدَ غَدٍ وَبَعدَ غَدِ",192,"د",1,0],["نَهاني أَميرُ المُؤمِنينِ عَنِ الصَبا","وَأَمرُ أَميرُ المُؤمِنينِ مُطاعُ",193,"ع",1,0],["نَهَوني يا أُمامَةَ عَن هَواكُم","فَلَم أَقبَل مَقالَةَ مَن نَهاني",194,"ي",1,0],["نَهاني أَميرُ المُؤمِنينَ عَنِ الصِبا","فَدونَ الغَواني عَومَةٌ لا أَعومُها",195,"م",3,1],["نَهاني أَميرُ المُؤمِنينَ فَبَرَّكَت","رِكابُ الصِبى حَتّى وَعَيتُ إِلى كَسرِ",196,"ر",1,0],["نَهَضَ الشيبُ بِالحَمالَةِ وَالمَج","دِ بِرَأيٍ عالٍ وَأَيدٍ بُحورِ",197,"ر",1,0],["نَهاني الخَليفَةُ عَن ذِكرِها","وَكُنتُ بِما سَرَّهُ أَكدَحُ",198,"ح",1,0],["نَهى فُؤادي عَن تَذَكُّرِها","وَيَزيدُني عِيّاً إِذا جَمَحا",199,"ح",2,0],["نَهوى الحَديثَ وَنَستَبقي مَناصِبَنا","إِنَّ الصَحيحَةَ لا تَبقى مَعَ الجَرِبِ",200,"ب",1,0],["نَهاني مالِكُ الأَملاكِ عَنها","فَثابَ الحِلمُ وَاِنقَطَعَ العَناءُ",201,"ا",2,0],["نَهَضتُ إِلى عُذافِرَةٍ صَموتٍ","مُذَكَّرَةٍ تَجِلُّ عَنِ الكَلالِ",202,"ل",1,0],["نَهابُ أُموراً ثُمَّ نَركَبُ هَولُها","عَلى عَنَتٍ مِن صاغِرين قِماءِ",203,"م",3,0],["نَهارٌ يُضيءُ وَلَيلٌ يَجيءُ","وَنَجمٌ يَغورُ وَنَجمٌ يُرى",204,"ر",2,0],["نَهانِيَ عَقلي عَن أُمورٍ كَثيرَةٍ","وَطَبعي إِلَيها بِالغَريزَةِ جاذِبي",205,"ي",1,1],["نَهارٌ وَلَيلٌ عوقِبا أَنا فيهُما","كَأَنّي بِخَيطَي باطِلٍ أَتَشَبَّثُ",206,"ث",1,0],["نَهاكَ ناهيكَ عَن بَيعٍ عَلى غَرَرٍ","وَأَنتَ كُلُّكَ فيما بانَ لي غَرَرُ",207,"ر",1,0],["نَهَت أُمَماً فَما قَبِلَت وَبارَت","نَصيحَتُها فَكُلُّ القَومِ بورُ",208,"ر",1,0],["نَهارٌ كَذي اللُبِّ العَديمِ وَلَيلَةٌ","كَإِحدى بَناتِ الزِنجِ يَلعَبنَ بِالدَكرِ",209,"ر",1,0],["نَهَيتُكَ أَن تُعَرَضَ بِنَتَ قيلٍ","تَقَيَّلُ في الذَوابِلِ وَالتِراسِ",210,"س",1,0],["نَهجُ العُلا يُنضي الرِكابَ وَكُلُّنا","كَسلانُ دونَ المَجدِ أَو مُتَكاسِلُ",211,"ل",1,0],["نُهمِلُ أَسرانا بِأَيدي الرَدى","وَيُدلِجُ اللَيلَةَ أَسرانا",212,"ن",2,0],["نَهَيتُكَ عَن خِلاطِ الناسِ فَاِحذَر","أَقارِبَكَ الأَداني وَاِحذَرَنّي",213,"ي",1,0],["نَهاهُم عَن طِلابِ المالِ زُهدٌ","وَنادى الحِرصُ وَيبَكُمُ اِطلُبوهُ",214,"ب",3,0],["نَهَارٌ كأنّ البدْرَ قاسى هجِيرَه","فعادَ بلوْنٍ شاحِبٍ من سَهامهِ",215,"م",2,0],["نهدم اللاتَ صاغرِينَ ونُلغِي","ما درجنا عليهِ فالعيشُ رَغْدُ",216,"د",1,0],["نهاك مُحَمَّدٌ فأَبيتَ رُشْداً","لِنَفْسِكَ إنّها نَفْسٌ غَوِيَّهْ",217,"ي",2,0],["نهار بعده يأتي نهار","وَليل كُلما ولى يَعود",218,"د",1,0],["نهبت فجاج الأرض في ليلة دجت","بسيارة تطوي البعيد ولا تضنى",219,"ن",2,0],["نهر عيسى وبيطر ورُفيل","وَدجيل وطابق والصراة",220,"ه",1,0],["نهاره لا يَكون لَيلا","إلا دعا كالثكول ويلا",221,"ل",2,0],["نهوضاً إلى الغرّ الصُراح بعزمة","تخِرّ لمرماها الطُغاة وتركع",222,"ع",1,0],["نُهْزَةٌ أهدَتِ الخيالَ إلينا","ودَعتْنا لموعدٍ فالتقينا",223,"ن",2,1],["نهاري الجميع دعاء له","وليلي الجميع دعاء عليه",224,"ه",1,0],["نَهَارُ مَشِيبٍ سَاءَنِي وَهْوَ أَبْيَضٌ","وَلَيْلُ شَبَابٍ سَرَّنِي وَهْوَ أَسْفَعُ",225,"ع",1,0],["نَهَارٌ وَلَيْلٌ يَدْأَبَانِ وَأَنْجُمٌ","تَغِيبُ إِلَى مِيقَاتِهَا ثُمَّ تَشْرُقُ",226,"ق",1,0],["نَهْمَانُ يَعْتَلِقُ الْقَطَا بِمَخَالِبٍ","حُجْنٍ لَهُنَّ بِوَقْعِهَا تَصْعَاقُ",227,"ق",1,0],["نَهَضَتْ فَجأْةً تُنَافِحُ فِي آ","نٍ عَدُوَّيْنِ أَسْرَفَا فِي اللِّدَادِ",228,"د",1,0],["نُهَنِيءُ أُسْتَاذَنَا عَادِلاً","ونَقْضِي بإِكْرَامِهِ مَا وَجَبْ",229,"ب",1,1],["نَهْضَةٌ لَمْ تَخُصَّ مِصْرَ بِنُعْمَاهَا","وعَمَّتْ نوَاحِي الشَّرْقِ طُرَّا",230,"ر",2,0],["نَهَضْتُ فِي الصُّبْحِ معَافى","وَزَرَعْتُ البَلَدَا",231,"د",2,0],["نهبا أويقات الصفاء، وقد","عكفا عليهما عكف مجتهد",232,"د",1,0],["نَهارهُ لا تَراهُ إِلّا","مُرَتِّلَ الذِكرِ وَالمَثاني",233,"ن",2,0],["نَهنَهَني رُزؤُكَ الَّذي قَد","أَبانَ ثِقلاً عَلى أَبانِ",233,"ن",1,0],["نَهارُ ثُكلِكَ لَيلٌ","لا كانَ ذاكَ النَهارُ",234,"ر",1,0],["نَهُوضٌ لأَمْرٍ أَمَّرَتْهُ خَوارجٌ","نَهُوضٌ بأعباءِ العُلا أيَّما نَهْضِ",235,"ض",1,0],["نَهَتني النُهى عَن حُبِّكُم فَعَصيتُها","وَهَيهات يُثنى لِلمُحِبِّ عَنانُ",236,"ن",1,0],["نَهب النُهى وَأَتى النَذيرُ بِوَعظِهِ","لَو أَنَّنا عَن غَيِّنا نَتَناهى",237,"ا",3,1],["نَهكَتهُ عِلَّةٌ مَبدَؤُها","وَحشَةُ الأمِّ مَتى تُذكَر تشُق",238,"ق",1,0],["نَهاري عَلى الأَنهارِ وَالرَوضُ وحشَة","إِلَيكَ وَأَمّا لَيلَتي فَأَليلُ",239,"ل",1,0],["نَهارُهُ يَنظُرُ مِن مُقلَةٍ","شاخِصَةِ الأَجفانِ مَبهوتَه",240,"ت",2,0],["نهتهم به أحلامهم أن يثابروا","على عملٍ للعاملين مُبير",241,"ر",1,0],["نهضت بالشريفِ من لغة الضا","دِ وجاءت بالسحر من تبيانه",242,"ن",2,0],["نَهَضت به آمالُ مِصْرَ وأَقْسمتْ","مِنْ بعد هذا اليومِ لا تَتَعثَّرُ",243,"ر",1,0],["نَهَضَتْ مِصْرُ نَهْضَةَ النَسْرِ فيها","واسْتَوَتْ فوْقَ مُسْتَقرِّ العُقاب",244,"ب",1,0],["نَهضتْ مِصْرُ بَعدَه نَهَضَاتٍ","تَسْتَحِثُّ الْخُطَا إِلى نَهَضَاتِ",245,"ت",1,0],["نهكَتْكِ داهيةُ الْخُطوبِ فلم تَدعْ","للفوْزِ غيرَ حُشاشةِ المنهوك",246,"ك",1,0],["نَهَضْتِ والأَرْضُ في دجُاهَا","والشمْسُ والْبَدْرُ في الْمُهُودِ",247,"د",1,0],["نَهَبتْ من المسك الفتيقِ سَواده","فأغار موتوراً على أنفاحِها",248,"ح",3,0],["نهضتْ بفاروقٍ فكانت آيةً","للبَعثِ بعد شَتاتها وطراحها",248,"ح",3,0],["نهضْتَ بالحكم في عزم، وفي ثقةٍ","حكم أَفاد الحمى منه، ولم تُفِدِ",249,"د",1,0],["نهضوا بحِمْلك، يا فريد، وإن يكن","فوق الكواهل جندلاً، وحديدا",250,"د",2,0],["نهرانِ ما سالا نميرًا سائغًا","بل منهما المجدُ الأثيلُ تدفَّقا",251,"ق",2,0],["نهارُها من وجوه الغيد منتَزَعٌ","والليلُ ما بعيون الغيد من كَحَلِ",252,"ل",1,0],["نهضتَ بما تَنُوءُ به الجبالُ","فكيف يطول عمرُك يا جمال؟",253,"ل",1,1],["نهضتَ بنا جيلاً وأبقيتَ بعدَنا","لأبنائنا ما يَحمدَون به المسعى",254,"ع",2,0],["نَهَضْتُمْ بها جمعيةً يُرْتَجَى بها","هدى كَتْلةٍ فيما تُحاولُ خابطَهُ",255,"ط",2,1],["نهاراً كلُّه أُصُلٌ لِذاذٌ","وليلاً كلهُّ سحرٌ وفجر",256,"ر",1,0],["نهارُنا مُترَفٌ بَليدُ","وليلُنا جامِحٌ عَنيد",257,"د",1,0],["نهداكِ والصدرُ \" ثالوثٌ أُقدّسُه","لو كانَ يُجمَعُ تثليثٌ وتوحيد",258,"د",1,0],["نَهَضْتَ بِأعْبَاءِ الخِلافَةِ كافِياً،","وما زلت مرجوا لها منتظراً",259,"ر",2,0],["نهفوا وتثبت رجحاً أحلامنا","وتظل تهفو منهم الأحلام",260,"م",1,0],["نهوى الحياة كأنّما هي نعمة","وسوى الفواجع حبّها لا يثمر",261,"ر",1,0],["نهودها من ثنايا الثوب بارزة","كأنّها تشتكي ممّا بولريها",262,"ي",3,0],["نهدًا لجوجًا فيهِ تَيهُ الذُرى","وما لدى ربّيَ من عُنفُوانِ",263,"ن",1,0],["نهضن وأسياف الغزاة مآزر","وسرن أعراف الجياد براقع",264,"ع",1,0],["نهوضاً الى العز الصراح بعزمة","تخرُّ لمرماها الطُّغاة وتركع",265,"ع",1,0],["نهيتكِ عن هواكِ فما انتهيتِ","ولكن قد فعلتِ كما اشتهيتِ",266,"ت",1,1]]}