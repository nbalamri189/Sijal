َ سابِغَةً","لِفَيلَقٍ كَنُجومِ اللَيلِ جَرّارِ",5,"ر",1,0],["نُهزَةُ مَجدٍ كُنتُ في طِلابِها","لِمِثلِها يَنصُفُ ساقي مِئزَري",6,"ي",1,0],["نَهَيتُكُمُ عَن ذي هُماهِمَ مُشبَلٍ","حِمى بِجُنوبِ السَيءِ ضالاً وَغَرقَدا",7,"د",2,0],["نِهايَةُ العِزِّ أَن تَبقى لَهُ أَبَداً","وَغايَةُ الجودِ أَن يَبقى لَكَ الجودُ",8,"د",1,0],["نَهضاً بِها صابِراً فَأَنتَ لَها","وَالثِقلُ لا يُعجِزُ المَصاعيبا",9,"ب",2,0],["نَهَضتُ وَقَد قَعَدنَ بِيَ اللَيالي","فَلا خَيلٌ أَعَنَّ وَلا رِكابُ",10,"ب",1,0],["نَهَيتُكَ عَن طَبعِ اللِئامِ فَإِنَّني","أَرى البُخلَ يَأتي وَالمَكارِمَ تُطلَبُ",11,"ب",1,0],["نَهارٌ بِلَألاءِ السُيوفِ مُفَضَّضٌ","وَجَوٌّ بِحَمراءِ الأَنابيبِ مُذهَبُ",11,"ب",1,0],["نَهنَهتَ بادِرَةَ الدُموعِ تَجَمُّلاً","وَالعَينُ تُؤنِسُ عَبرَةً وَبُكاءَ",12,"ا",2,0],["نَهْجُ الثّناءِ إِلى ناديكَ مُخْتَصَرٌ","لوْ أدْرَكَتْ وَصْفَكَ الأوْهامُ والفِكَرُ",13,"ر",1,1],["نَهْوى البقاءَ وليسَ فيهِ طائِلٌ","والمرْءُ نَهْبُ حَوادثِ الأيّامِ",14,"م",1,0],["نُهْدي إليهِ مِدَحاً نَمْتَري","بهِنَّ خِلْفَ النّائِلِ المُسْتَماحْ",15,"ح",1,0],["نَهوضٌ بأعباءِ الرّفيقِ وإنْ غَلا","على مُنحَنى الأضْلاعِ مِنْ صَحْبِهِ غِمْرُ",16,"ر",1,0],["نَهدِ القَطاةِ كَأَنَّها مِن صَخرَةٍ","مَلساءَ يَغشاها المَسيلُ بِمَحفَلِ",17,"ل",1,0],["نَهاري كُلُّهُ عِبَرٌ","وَلَيلي كُلُّهُ سَهَرُ",18,"ر",1,0],["نَهاري نَهارُ الناسِ حَتّى إِذا دَجا","لِيا اللَيلُ هَزَّتني إِلَيكَ المَضاجِعُ",19,"ع",1,0],["نهش لنا البدور بكل خدر","وتهوانا الشموس بكل كله",20,"ل",2,0],["نَهَضُوا وَقَدْ جَنَّ االدُّجَى وَتَخَالَفَتْ","سُبُلُ الرَّدَى فَمُسَدَّدُونَ وَضُلَّلُ",21,"ل",1,1],["نَهارُ شَراحيلَ بنِ طَودٍ يُريبُني","وَلَيلُ أَبي لَيلى أَمَرُّ وَأَعلَقُ",22,"ق",1,0],["نَهَيتُكُمُ عَن جَهلِكُم وَنَصَرتُكُم","عَلى ظُلمِكُم وَالحازِمُ الرَأيِ أَشفَقُ",22,"ق",1,0],["نَهَشُّ إِلى الدينارِ حَتّى إِذا مَشى","بِهِ رَبُّهُ لِلسوقِ أَلفاهُ دِرهَما",23,"م",2,0],["نَهرٌ وَرَوضٌ نَحنُ بَينَهُ","ما تُفَيُّئِنا ظِلالُك",24,"ك",1,0],["نَهوضٌ بِأَعباءِ المُروءَةِ وَالتُقى","سَحوبٌ لِأَذيالِ السِيادَةِ وَالفَضلِ",25,"ل",1,0],["نَهيكٌ إِذا جَنَّ لَيلُ العَجاجِ","سَرى مِنهُ في جُنحِهِ بَدرُ تِمّ",26,"م",1,0],["نَهَتهُ فَلَمّا لَم تَرَ النَهيَ عاقَهُ","بَكَت فَبَكى مِمّا شَجاها قَطينُها",27,"ن",3,0],["نَهَيتَ الأَلى راموا الخِلافَةَ مِنهُمُ","بِضَربِ الطُلى وَالطَعنِ حَتّى تَنَكَّلوا",28,"ل",3,0],["نُهينُ النُفوسَ وَهَونُ النُفوسِ","يَومَ الكَريهَةِ أَبقى لَها",29,"ل",3,0],["نَهْرٌ أَتَمَّ اللهُ نِعْ","مته بِهِ وَأَدَامَ فَضْلَهْ",30,"ل",2,0],["نَهْلٌ تَسَاقَاهَا القُلُوبُ فَتَشْتَفِي","غُلَلٌ وَتُقْضَى لِلقُلُوبِ أَمَانِ",31,"ن",1,0],["نَهَى تَوَاضُعُهُ عن أن تَشِيدَ بِهِ","فَاليَوْمُ لاَ تَكُ لِلنَّاهِي بِمِذْعَانِ",32,"ن",1,0],["نَهَاكَ بِالأَمْسِ عَنْ مَدْحٍ يُصَاغُ لَهُ","فَاليَوْمَ لا تَكُ لِلنَّاهِي بِمِذْعَانِ",33,"ن",1,0],["نَهَجُوا الصِّرَاطَ المُسْتَقِيمَ وَلَيْسَ فِي","سُبُلِ المُرُوءةِ مِنْ سَبِيلٍ أَقْوَمِ",34,"م",1,0],["نِهَايَةُ الفَخْرِ كُلُّ حُرٍّ","فِي مَذْهَبٍ عَن حِمَاهُ حَامَى",35,"م",2,0],["نَهْفُو إِلَى الزَّهْراءِ شَوْقاً فَإِنْ","جَفَتْ جَفَانَا صَفْوُنَا وَالسَّلامْ",36,"م",1,0],["نِهَايَةُ الفَخْرِ لِي فِي هَذَا الكَلِمِ","تَعْرِيفُ حَافِظَ إِبْرَاهِيمَ مِنْ أَمَمِ",37,"م",1,1],["نَهَضَ البِنَاءُ إِلَى السَّمَاءِ وَقَوَّضَتْ","رَبَّ البِنَاءِ يَدُ الزَّمَانِ الهَادِمِ",38,"م",1,0],["نَهَضْتَ لِدَفْعِ الوَيْلِ عَنْهُ بِهِمَّةٍ","هِيَ الوَثْبُ فِي الأَرْيَاحِ وَالوِقْرِ فِي الشُّمِّ",39,"م",1,0],["نَهَشوهُ فَاِنتُزِعَت لَهُ أَسنانُهُم","وَتَهَشَّمَت أَقفاؤُهُم بِالحائِطِ",40,"ط",1,0],["نَهوضٌ بِأُخراها إِذا ما اِنبَرى لَها","مِنَ الأَرضِ نَهّاضُ الحَزابِيِّ أَغبَرُ",41,"ر",1,0],["نَهزنَ العَنيقَ الرَسلَ حَتّى أَمَلَّها","عِراضُ المَثاني وَالوجيفُ المُراوِحُ",42,"ح",1,0],["نَهَزنَ فَلاةً عَن فَلاةٍ فَأَصبَحَت","تَزَعزَعُ بِالإِعناقِ وَالسَيرِ وَالجَذبِ",43,"ب",1,0],["نهر المجرة والزهر المطيفُ به","زُهرُ النجوم إذا ما شئت تشبيها",44,"ي",3,0],["نهبتُ عذارى الحي ليلة عَرضِها","وقد جُليت منها لمبصرها شهبُ",45,"ب",1,0],["نهر هو الفِردَوس تدخل منه في","قصر الخلافة شعبة وقناة",46,"ه",1,0],["نهوضاً نهوضاً أيها القوم للعلا","لتبنوا لكم بنيان مجدٍ مُوَطَّد",47,"د",1,0],["نهضت بماضي الدهر نهضتها التي","خَضَعت لها الأفلاك في دَورانها",48,"ن",3,0],["نهضة عالميّة في وغَاها","من أمام البعير فرّ الفيل",49,"ل",1,0],["نَهوى ثَرى العِرقِ إِذ لَم نَلقَ بَعدَكُمُ","كَالعِرقِ عِرقاً وَلا السُلّانِ سُلّانا",50,"ن",2,0],["نَهى التَيمِيَّ عُتبَةُ وَالمُثَنّى","وَقالا سَوفَ تَبهُرُكَ الصَعودُ",51,"د",1,0],["نَهَيتُكُمُ أَن تَركَبوا ذاتَ ناطِحٍ","مِنَ الحَربِ يُلوى بِالرِداءِ نَذيرُها",52,"ر",3,0],["نَهوى الخَليطَ وَلَو أَقَمنا بَعدَهُم","إِنَّ المُقيمَ مُكَلَّفٌ بِالسائِرِ",53,"ر",1,0],["نَهِدِ المَحالِ إِذا حُدينَ مُفَرَّجٍ","سَبطِ المَشافِرِ مُخلِفٍ أَو فاطِرِ",53,"ر",1,0],["نَهَيتُ بَناتِ المُستَنيرِ عَنِ الرُقى","وَعَن مَشيِهِنَّ اللَيلَ بَينَ المَزارِعِ",54,"ع",1,0],["نَهَيتُ التَيمَ عَن سَفَهٍ وَطالَت","أَناتي وَاِنتَظَرتُ ذَوي الحُلومِ",55,"م",1,0],["نَهُزُّ القَنا في صُدورِ الكُما","ةِ حَتّى نُكَسِّرِ أَعوادَها",56,"د",3,0],["نهدي الذي بهباته وثنائه","سمعَ الأصمُّ وقالتِ الخرساء",57,"ا",2,0],["نهضت بما لا تحسنُ السحبُ حملهُ","وسدت على ما أسسَ الجدّ والأب",58,"ب",1,0],["نهني بلقياه حمى مصر إنها","بغيبتهِ حاشا المزاج مغلّثه",59,"ث",2,0],["نهانيَ عنه الهمُّ قبلَ عواذِلي","وأخرجني عنه وما كنتُ مُخرَجا",60,"ج",2,0],["نهدِي لهُ اللفظ أسمالاً فيقبلها","عواطف الخير من سحَّاب أذيال",61,"ل",1,0],["نهضت فما قلنا سيادة معشر","تداعت ولا بنيان قومٍ تهدَّما",62,"م",2,0],["نهنيك بل إنا نهني مناصباً","لشمسك يمحو عدلها كلّ مظلم",63,"م",1,1],["نَهْنَهتْني مهابتي لك عن جِي","لٍ من الناس والأريبُ هيوبُ",64,"ب",1,0],["نَهوضٌ بأعباء الكتابة مُرْفِقٌ","رعيَّتَهُ مستظهرٌ لرُعاتِهِ",65,"ت",2,0],["نهى جودُهُ عن كل سمحٍ وباخلٍ","شَذى القولِ حتى أحسنَ القولَ رافثُهْ",66,"ث",2,0],["نَهَكَ الحياءُ جُفُونَهُ وكلامَهُ","فغدا مريضاً في ثيابِ صحيحِ",67,"ح",1,0],["نَهَتْ عن نفسها النَّارُ","بما فيها من اللفحِ",68,"ح",1,0],["نهتني فزادتني حفاظاً على الصبى","ألا ربما ينهى الجهولُ فيأمر",69,"ر",1,0],["نهاري لدْن فارقتني لك موحِشٌ","وليلي فقيدُ النوم حتى انحساره",70,"ر",2,0],["نهارٌ وليلٌ أكّد الحلْفُ أنه","إذا بَنَيا مبنىً فشاداه قَوَّضا",71,"ض",2,0],["نهوضٌ بأعباء الملمَّات دونه","إذا بلَّح المستنهَضُ الفاترُ النهض",72,"ض",1,0],["نهدي لك الشعر ثم نحقره","وإن غدا من نفائس التحف",73,"ف",1,0],["نهاكَ بالريح حتى حلّ مَنْحسة","من المناحس ما كانت لتلقاكا",74,"ك",2,0],["نهضٌ به ولم أخُن ولم أغُل","لا هَوْلَ إن صَدُّكَ عني لم يهُل",75,"ل",1,0],["نهضْتُ إليه بالخوافي مُؤمِّلاً","به أن تَريْني ناهضاً بقوادمِ",76,"م",1,0],["نهارٌ شكْلُهُ في اللون سامٌ","وليلٌ شكلُهُ في اللونِ حامُ",77,"م",1,0],["نَهْنهتهُم لُهىً له ليس تنفكْ","كُ على المُقْترينَ ذات ازدحام",78,"م",1,0],["نهارنا الدهرَ منه طَلْقٌ","وليلنا منه إضْحِيان",79,"ن",1,0],["نهى الكتابُ عن الأوثان نعبدها","وما الأيورُ إذا قامتْ بأوثان",80,"ن",1,0],["نَهاهُم ثابِتٌ عَنهُ فَقالوا","تُعَيِّبُنا العَشائِرُ لَو يَؤوبُ",81,"ب",1,0],["نَهَيتُكَ عَن طِلابِكَ أُمَّ عَمرٍ","بِعاقِبَةٍ وَأَنتَ إِذٍ صَحيحُ",82,"ح",1,0],["نُهاديهِ أَحياناً وَحيناً نَجُرُّهُ","وَما كادَ إِلّا بِالحُشاشَةِ يَعقِلُ",83,"ل",1,0],["نَهضَةً تَكشِفُ المَذَلَّةَ عَنّا","فَلَقَد طالَ نَومُنا في الشَقاءِ",84,"ا",2,0],["نَهضَةً تَلفِتُ العُيونَ إِلَينا","إِنَّ خَوفَ البَلاءِ شَرُّ بَلاءِ",84,"ا",2,0],["نَهضَةً يَحمِلُ الأَثيرُ صَداها","لِلبَرايا في أَوَّلِ الأَنباءِ",84,"ا",2,0],["نَهضَةً تَبلُغُ النُفوسُ مُناها","فَهيَ مُشتاقَةٌ إِلى الهَيجاءِ",84,"ا",2,0],["نَهَشَ الأَسى لَمّا ضَحِكتُ قُلوبَهُم","عُرسُ المَحَبَّةِ مَأتَمُ البَغضاءِ",85,"ا",2,0],["نَهتَدي بِالضُحى فَإِن عَسعَسَ اللَي","لُ جَعَلنا الدَليلَ ضَوءَ الشِهابِ",86,"ب",1,0],["نَهوى الحَياةَ كَأَنَّما هِيَ نِعمَةٌ","وَسِوى افَواجِعِ حُبُّها لا يُثمِرُ",87,"ر",1,0],["نَهَضتُ وَلَكِن مِثلَما يَنهَضُ الَّذي","بِهِ نَشوَةٌ أَو مَن يَفيقُ مِنَ المَسِّ",88,"س",1,0],["نَهبَ الكُؤوسِ عُقولُهُم وَنُضارُهُم","نَهبَ المُديرِ الخادِعِ الخَتّالِ",89,"ل",1,0],["نهاني عَن قَتلِ النُفوسِ وَعِندَما","رَأى غُرَّةً مِنّي تَعَلَّمَ بِيَ القَتلا",90,"ل",2,0],["نَهوى وَنَحنُ جُموعٌ لا عِدادَ لَها","كَواحِدٍ وَكَذا نُقلى كَإِنسانِ",91,"ن",1,0],["نَهوى وَنَحنُ جُموعٌ لا عِدادَ لَها","كَواحِدٍ وَكَذا نَقلى كَإِنانِ",91,"ن",1,0],["نُهودُها مِن ثَنايا الثَوبِ بارِزَةٌ","كَأَنَّها تَشتَكي مِمّا يُواريها",92,"ي",3,0],["نَهرٌ تَبار