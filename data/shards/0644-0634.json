{"poems":[[53,"صدت وما كان لها الصدود","https://www.aldiwan.net/poem30527.html","الرجز"],[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[55,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[77,"لشمس الدين زوج ضج منها","https://www.aldiwan.net/poem36402.html","الوافر"],[77,"ألما على شط الفرات المقدس","https://www.aldiwan.net/poem35873.html","الطويل"],[42,"أظل كئيبا لو تشوكك شوكة","https://www.aldiwan.net/poem50279.html","الطويل"],[24,"رحلت إلى قومي لأدعو جلهم","https://www.aldiwan.net/poem21868.html","الطويل"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[88,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[88,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[27,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[4,"ولم تحم عبد الله لا در درها","https://www.aldiwan.net/poem21161.html","الطويل"],[11,"حننت إلى الأجبال أجبال طيئ","https://www.aldiwan.net/poem243.html",""],[23,"عفت ذات الأصابع فالجواء","https://www.aldiwan.net/poem21233.html","الوافر"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[72,"قالوا وقد ملكت رقي غلام","https://www.aldiwan.net/poem19980.html","السريع"],[72,"لست أنسى ابتسامها اللؤلؤيا","https://www.aldiwan.net/poem20569.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"لو كنت مثل ابن أبي طاهر","https://www.aldiwan.net/poem61849.html","السريع"],[51,"أظنك مما قد مطلت مثوبتي","https://www.aldiwan.net/poem62907.html","الطويل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[51,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[51,"إن ائتمانك آفات الزمان على","https://www.aldiwan.net/poem65773.html","البسيط"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[26,"ألا ليت شعري هل تنظر خالد","https://www.aldiwan.net/poem24079.html","الطويل"],[29,"أفي كل عام لا يزال لعامر","https://www.aldiwan.net/poem6191.html","الطويل"],[45,"أبا الطيب اسمع لا سمعت بحادث","https://www.aldiwan.net/poem64556.html","الطويل"],[45,"بقومي جمعا لا أحاشي ولا أكني","https://www.aldiwan.net/poem66812.html","الطويل"],[49,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[80,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[80,"تقول وقد لاحت لها في مفارقي","https://www.aldiwan.net/poem31523.html","الطويل"],[69,"باسم إله الخلق هذا ما اشترى","https://www.aldiwan.net/poem27989.html","الرجز"],[31,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[31,"قل للمليحة قد أبلتني الذكر","https://www.aldiwan.net/poem42546.html","البسيط"],[48,"يا رب مجلس فتيان سموت له","https://www.aldiwan.net/poem10404.html","البسيط"],[48,"يا قضيبا في كثيب","https://www.aldiwan.net/poem10802.html","مجزوء الرمل"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[50,"تقول ابنتي إذ فاخرتها غريبة","https://www.aldiwan.net/poem63870.html","الطويل"],[46,"توهمت خيرا في الزمان وأهله","https://www.aldiwan.net/poem23288.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85571","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16634","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54527","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54924","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200123","الطويل"],[4,"ولم تحم عبد الله لا در درها","https://www.poetsgate.com/ViewPoem.aspx?id=684",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"بقَوْمي جَميعاً لا أُحاشِي، وَلا أَكْني","https://www.poetsgate.com/ViewPoem.aspx?id=31799",""],[51,"ما تَجْزَعُ الشَّاة ُ إذا شُحِطَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=27380",""],[51,"قل للأمير الطاهريّ الماجدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27627",""],[51,"وكم عائبٍ قد عابني وهو صادقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=27032",""],[24,"رحَلْتُ إلى قومي لأدْعُوَ جُلَّهُم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10870&r=&rc=11",""],[31,"قد أبلتنيَ الذكرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18857&r=&rc=120",""]],"verses":[["لَشُدَّ ما أَوجَعَني الفَقيدُ","أَيّامُنا بَعدَ البَياضِ سودُ",0,"د",1,0],["لَشَدَّ بكَ المُلْكُ أطْنابَهُ","وكادَتْ دَعائمُهُ تُسْلَبُ",1,"ب",1,0],["لَشَكا إِلَيكُم بِالبُكا","ءِ وَبِالتَضَرُّعِ وَالتَمَلُّق",2,"ق",1,0],["لشَمْسِ الدّينِ زوْجٌ ضجَّ منْها","وطالَ لفِعْلِها منْهُ النّكيرُ",3,"ر",1,1],["لشَوْقٍ ثَوى بيْنَ الحَيازِم والحَشى","وبُعْدٍ رَمى في القَلْبِ سهْمَ مُقَرْطِسِ",4,"س",1,0],["لَشتّانَ ما بَيني وَبَينِكَ في الإِخا","صَدَقتُكَ في نَفسي وَلَستَ بِصادِقِ",5,"ق",1,0],["لشَتانَ مَن يَدعو فُيوفي بِعَهدِهِ","وَمَن هُوَ لِلعَهدِ المُؤَكَّدَ خالِعُ",6,"ع",1,0],["لَشَمَّرَ حَتّى اِنجابَ عارِضُ فِتنَةٍ","تَأَلَّقَ مِنها البَرقُ وَاِصطَخَبَ الرَعدُ",7,"د",1,0],["لشدّدت في زجر المحبّين أن جَفَوْا","وعاقبت منهم من يميل إلى الهجر",8,"ر",1,0],["لشمّر الثوب عن ساقَيْه منكمشاً","وسدّ منخره قطعاً لأنفاس",9,"س",1,0],["لَشَقَّ عَلى ذي الحِلمِ أَن يَتبَعَ الهَوى","وَيَرجو مِنَ الأَقصى الَّذي لَيسَ لاقِيا",10,"ي",2,0],["لَشَتّانَ المُجاوِرُ دَيرَ أَروى","وَمَن سَكَنَ السَليلَةَ وَالجِنابا",11,"ب",2,0],["لَشَتّانَ يَومٌ بَينَ سَجفٍ وَكِلَّةٍ","وَمَرِّ المَطايا تَغتَدي وَتَرَوَّحُ",12,"ح",1,0],["لَشَتّانَ مَن يَحمي مَعَدّاً مِنَ العِدى","وَمَن يَسكُنُ الماخورَ في مَن تَمَخَّرا",13,"ر",2,0],["لَشَتّانَ حَربٌ أَو تَبوءوا بِخِزيَةٍ","وَقَد يَقبَلُ الضَيمَ الذَليلُ المُسَيَّرُ",14,"ر",1,0],["لَشِعبٌ مِنَ الرَيّانِ أَملِكُ بابَهُ","أُنادي بِهِ آلَ الكَبيرِ وَجَعفَرا",15,"ر",2,0],["لِشَعثاءَ الَّتي قَد تَيَّمَتهُ","فَلَيسَ لِقَلبِهِ مِنها شِفاءُ",16,"ا",2,0],["لشهاب دين الله وصفٌ ضاءَ في","أفقٍ فقل نجم السما رَجمَ العِدى",17,"د",2,0],["لشامته يقول إذا أديرت","عليّ مدام ريقته بشامهْ",18,"م",2,0],["لشعر هذا فضل أيام ذا","يقول يا بشراي هذا غلام",19,"م",1,0],["لشذور الأغزال مع مدح تاج الد","ين أصبحت صائغاً جوهريَّا",20,"ي",2,0],["لَشتَّان ما بين البياضَيْن مُعْجِبٌ","أنيق ومَشْنُوءٌ إلى العين أنكدُ",21,"د",1,0],["لَشدَّ ما أقدَم بؤساً له","بلا سلاحٍ وبلا عُدَّهْ",22,"د",2,0],["لَشتان ما بيني وبينك تصطفي","مديحي وحظي من لُهاك الحقائر",23,"ر",1,0],["لشدّ ما أقدمتْ بالأمس عزمتُهُ","على التي أعوزتْ أنصارها العِذر",24,"ر",1,0],["لشتّانَ ما بين الشباب وضدّه","شبابُ الفتى يُصمي إذا الشيبُ أنبضا",25,"ض",2,0],["لشاعرنا خالدٍ في استِهِ","مآربُ أخرى سِوى الغائطِ",26,"ط",1,1],["لشنطفَ كعثبٌ خلقُ","تشعَّب جوفه طرقُ",27,"ق",1,1],["لشاهدٌ حالفٌ للحالفينَ لها","بأنَّ سرَّك فيه مثلُ إعلانِكْ",28,"ك",1,0],["لشكرِ محبتي قبل التلاقي","وشُكْم مودتي بعدَ التبالي",29,"ي",1,0],["لِشانِئِهِ طولُ الضَراعَةِ مِنهُمُ","وَداءٌ قَد أَعيا بِالأَطِبّاءِ ناجِسُ",30,"س",1,0],["لِشَنعاءَ بَينَ الأَصلِ لا يَستَطيعُها","إِذا القَومُ هابوها السَخيفُ المُزَلَّمُ",31,"م",1,0],["لِشَكوايَ إِنّي لِلَّذي قَد أَظَلَّني","مِنَ البَينِ أَخشى أَن أَموتَ وَلاأَدري",32,"ر",2,0],["لِشَهرِ رَبيعٍ نِعمَةٌ ما يَفي بِها","ثَناءٌ وَلَو قُمنا بِأَضعافِها نُثني",33,"ن",2,0],["لَشَتّانَ ما بَينَ المَخافَةِ وَالأَمنِ","وَشَتّانَ ما بَينَ السُهولَةِ وَالحَزنِ",34,"ن",1,1],["لِشِدَّةِ البَأسِ في يُمناهُ ضَربَتُهُ","إِن أُسكِرَ السَيفُ مِنها بِالنَجيعِ شَدا",35,"د",2,0],["لشيَّبني في عنفوانِ شَبيبَتي","لقائي مِنَ الأَيّامِ دَهياءَ فادِحه",36,"ح",2,0],["لشجرٍ مختلِفِ الأجناسِ","والأرضُ في البيعِ معَ الغراسِ",37,"س",1,0],["لِشَقائي قادَني بَصَري","وَلِحَينٍ وافَقَ القَدَرا",38,"ر",2,0],["لِشَقائي أُختٍ عَلِقنا","وَلِحينٍ ساقَهُ القَدَرُ",39,"ر",1,0],["لِشَقوَةٌ مِن شَقائي أُختِ مَنزِلَنا","وَقَد رَأى كَثرَةَ الأَعداءِ إِذ حَضَروا",40,"ر",3,0],["لِشُربِ صافِيَةٍ مِن صَدرِ خابِيَةٍ","تَغشى عُيونَ نَداماها بِلَألاءِ",41,"ا",2,0],["لِشَقائي صاغَكَ اللَ","هُ حَبيباً لِلقُلوبِ",42,"ب",1,0],["لِشِدَّةِ الجَريِ وَلِاِستِحطاطِهِ","ما إِن تَمَسُّ الأَرضَ في أَشواطِهِ",43,"ط",2,0],["لَشَتّانَ ما بَيني وَبَينَكِ في التُقى","وَفي الحَسَبِ الزاكي وَفي العَيشِ وَالحَفَد",44,"د",1,0],["لِشَهباءَ يُخفي القِرنُ فيها كَلامَهُ","وَيُفهِمُ إِلّا أَنَّهُ لَيسَ يَفهَمُ",45,"م",1,0],["لشاعر عربي غير ذي عوج","على الفصاحة منه تشهد الكلم",46,"م",1,0],["لشبابِ مِصرَ وهم بُناةُ حياتِها","وحُماتُها إنْ حاقتِ الأخطارُ",47,"ر",1,0],["لشدَّ الذي قُلتِهِ يا ابنتي","كلاماً توهَّجَ منه الحنينْ",48,"ن",1,0],["لشرّفت القوافيَ والمعاني","بلفظك والأخلة والخليلا",49,"ل",2,0],["لَشَدَّ مَا يُصْدَمُ وَهْمُ الفَتَى","بِنُكْرِ مَا يَلْقَاهُ فِي الوَاقِعِ",50,"ع",1,0],["لِشَبَابٍ كُلَّمَا نَادَاهُمُ","وَاجِبٌ لَبَّوا مِنَ الفَوْرِ النِّدَاءْ",51,"ا",2,0],["لَشَفَى غَلِيلَ المُسْتَهامِ بِقُرْبِهَا","وَشفَى جِرَاحَ النَّاقِمِ المَوْتُورِ",52,"ر",1,0],["لِشِعْرِ عَمَّيْكِ سِحْرٌ","فِي سِحْرِ عَيْنَيْكِ سَاجِ",53,"ج",1,0],["لِشُمُوسِهَا أَبَداً مَرَا","حٌ فاتِنٌ ظرْفاً وَمَغدَى",54,"د",2,0],["لِشَمَائِلَ مَمْلُؤَةٍ أُنْساً","وَأَخْلاَقَ عِذَابْ",55,"ب",1,0],["لشعبان في ست وسبعين حقبة","وزد مائتين في اثنتين من الدهر",56,"ر",1,0],["لشَتّانَ حَرْبٌ أوْ تَبُوؤوا بخِزْيَةٍ","وَقد يَقبَلُ الضَّيمَ الذَّليلُ المُسَيَّرُ",57,"ر",1,0],["لشرِّ النِهاياتِ هذا \" المطافُ \"","وكلُّ مَطافٍ إلى مُنتهى",58,"ا",1,0],["لِشَهْرِ رَبيعٍ نِعْمَةٌ مَا يَفِي بها","ثَنَاءٌ، وَلَوْ قُمْنا بأضْعَافِهِا نُثْني بيت",59,"ت",1,0],["لشْفِقُ أنْ يُكْتَبَ في جلدها","شِعْرُك يا ذا القَرْنِ والكَشْخِ",60,"خ",1,0],["لشاكرٍ نعمتهُ وجاحد","يُعطي العطايا ليس للعوائدِ",61,"د",1,0],["لشتانَ ما بين المَعيبيْن ظالمٌ","يُحَقُّ عليه العَتْبُ والمتعتَّبُ",62,"ب",1,0],["لشتانَ من يدعو فييوفي بعهده","ومن هو للعهدِ المؤكدِ خالعُ",63,"ع",1,0],["لَشِقْوَة ٌ مِنْ شَقَائي أُخْتِ غَفْلَتُنا","وشؤمُ جدي، وحينٌ ساقه القدر",64,"ر",1,0]]}