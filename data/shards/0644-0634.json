كايات","https://www.poetsgate.com/ViewPoem.aspx?id=198722",""],[4829,"شمّا وأم الجماجم","https://www.poetsgate.com/ViewPoem.aspx?id=34256",""],[4929,"لون الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=199429",""],[4978,"تشطير قصيدة لو كان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177254",""],[5050,"لشغلي بأهل الدهر إحدى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=38188",""],[585,"بربك يا دسيسة خبرينا","https://www.poetsgate.com/ViewPoem.aspx?id=161869",""],[5121,"صَبَاحُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215854",""],[5135,"يا قومنا","https://www.poetsgate.com/ViewPoem.aspx?id=208730",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5212,"سلاماً يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=212058",""],[5246,"بالصمت أخلاق الرجال تزيد","https://www.poetsgate.com/ViewPoem.aspx?id=187031",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5376,"بأيِّ الذنبِ ذاك الطفلُ يُقْتلْ","https://www.poetsgate.com/ViewPoem.aspx?id=196896",""],[223,"عابرة","https://www.poetsgate.com/ViewPoem.aspx?id=181152",""],[5431,"قلب اليماني حبٌ كله وكفى!","https://www.poetsgate.com/ViewPoem.aspx?id=189732",""],[5431,"فحياتي تنيرها حواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=196821",""],[5436,"غزل عراقي (محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=61666",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5574,"نُوَّارتي","https://www.poetsgate.com/ViewPoem.aspx?id=206011",""],[5664,"السمو","https://www.poetsgate.com/ViewPoem.aspx?id=176696",""],[5853,"عودي لأجلي","https://www.poetsgate.com/ViewPoem.aspx?id=175621",""],[5861,"إسمع ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=188095",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[161,"شهادة ميلاد هبة الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=166671",""],[6056,"مفهوم الأذواق","https://www.poetsgate.com/ViewPoem.aspx?id=130522",""],[6102,"شادن","https://www.poetsgate.com/ViewPoem.aspx?id=184418",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[6173,"مُقادًا بقلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86797&r=&rc=11",""],[5567,"جنة من هيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82095&r=&rc=136",""]],"verses":[["لَشُدَّ ما أَوجَعَني الفَقيدُ","أَيّامُنا بَعدَ البَياضِ سودُ",0,"د",1,0],["لَشَدَّ بكَ المُلْكُ أطْنابَهُ","وكادَتْ دَعائمُهُ تُسْلَبُ",1,"ب",1,0],["لَشَكا إِلَيكُم بِالبُكا","ءِ وَبِالتَضَرُّعِ وَالتَمَلُّق",2,"ق",1,0],["لشَمْسِ الدّينِ زوْجٌ ضجَّ منْها","وطالَ لفِعْلِها منْهُ النّكيرُ",3,"ر",1,1],["لشَوْقٍ ثَوى بيْنَ الحَيازِم والحَشى","وبُعْدٍ رَمى في القَلْبِ سهْمَ مُقَرْطِسِ",4,"س",1,0],["لَشتّانَ ما بَيني وَبَينِكَ في الإِخا","صَدَقتُكَ في نَفسي وَلَستَ بِصادِقِ",5,"ق",1,0],["لشَتانَ مَن يَدعو فُيوفي بِعَهدِهِ","وَمَن هُوَ لِلعَهدِ المُؤَكَّدَ خالِعُ",6,"ع",1,0],["لَشَمَّرَ حَتّى اِنجابَ عارِضُ فِتنَةٍ","تَأَلَّقَ مِنها البَرقُ وَاِصطَخَبَ الرَعدُ",7,"د",1,0],["لشدّدت في زجر المحبّين أن جَفَوْا","وعاقبت منهم من يميل إلى الهجر",8,"ر",1,0],["لشمّر الثوب عن ساقَيْه منكمشاً","وسدّ منخره قطعاً لأنفاس",9,"س",1,0],["لَشَقَّ عَلى ذي الحِلمِ أَن يَتبَعَ الهَوى","وَيَرجو مِنَ الأَقصى الَّذي لَيسَ لاقِيا",10,"ي",2,0],["لَشَتّانَ المُجاوِرُ دَيرَ أَروى","وَمَن سَكَنَ السَليلَةَ وَالجِنابا",11,"ب",2,0],["لَشَتّانَ يَومٌ بَينَ سَجفٍ وَكِلَّةٍ","وَمَرِّ المَطايا تَغتَدي وَتَرَوَّحُ",12,"ح",1,0],["لَشَتّانَ مَن يَحمي مَعَدّاً مِنَ العِدى","وَمَن يَسكُنُ الماخورَ في مَن تَمَخَّرا",13,"ر",2,0],["لَشَتّانَ حَربٌ أَو تَبوءوا بِخِزيَةٍ","وَقَد يَقبَلُ الضَيمَ الذَليلُ المُسَيَّرُ",14,"ر",1,0],["لَشِعبٌ مِنَ الرَيّانِ أَملِكُ بابَهُ","أُنادي بِهِ آلَ الكَبيرِ وَجَعفَرا",15,"ر",2,0],["لِشَعثاءَ الَّتي قَد تَيَّمَتهُ","فَلَيسَ لِقَلبِهِ مِنها شِفاءُ",16,"ا",2,0],["لشهاب دين الله وصفٌ ضاءَ في","أفقٍ فقل نجم السما رَجمَ العِدى",17,"د",2,0],["لشامته يقول إذا أديرت","عليّ مدام ريقته بشامهْ",18,"م",2,0],["لشعر هذا فضل أيام ذا","يقول يا بشراي هذا غلام",19,"م",1,0],["لشذور الأغزال مع مدح تاج الد","ين أصبحت صائغاً جوهريَّا",20,"ي",2,0],["لَشتَّان ما بين البياضَيْن مُعْجِبٌ","أنيق ومَشْنُوءٌ إلى العين أنكدُ",21,"د",1,0],["لَشدَّ ما أقدَم بؤساً له","بلا سلاحٍ وبلا عُدَّهْ",22,"د",2,0],["لَشتان ما بيني وبينك تصطفي","مديحي وحظي من لُهاك الحقائر",23,"ر",1,0],["لشدّ ما أقدمتْ بالأمس عزمتُهُ","على التي أعوزتْ أنصارها العِذر",24,"ر",1,0],["لشتّانَ ما بين الشباب وضدّه","شبابُ الفتى يُصمي إذا الشيبُ أنبضا",25,"ض",2,0],["لشاعرنا خالدٍ في استِهِ","مآربُ أخرى سِوى الغائطِ",26,"ط",1,1],["لشنطفَ كعثبٌ خلقُ","تشعَّب جوفه طرقُ",27,"ق",1,1],["لشاهدٌ حالفٌ للحالفينَ لها","بأنَّ سرَّك فيه مثلُ إعلانِكْ",28,"ك",1,0],["لشكرِ محبتي قبل التلاقي","وشُكْم مودتي بعدَ التبالي",29,"ل",2,0],["لِشانِئِهِ طولُ الضَراعَةِ مِنهُمُ","وَداءٌ قَد أَعيا بِالأَطِبّاءِ ناجِسُ",30,"س",1,0],["لِشَنعاءَ بَينَ الأَصلِ لا يَستَطيعُها","إِذا القَومُ هابوها السَخيفُ المُزَلَّمُ",31,"م",1,0],["لِشَكوايَ إِنّي لِلَّذي قَد أَظَلَّني","مِنَ البَينِ أَخشى أَن أَموتَ وَلاأَدري",32,"ر",2,0],["لِشَهرِ رَبيعٍ نِعمَةٌ ما يَفي بِها","ثَناءٌ وَلَو قُمنا بِأَضعافِها نُثني",33,"ن",2,0],["لَشَتّانَ ما بَينَ المَخافَةِ وَالأَمنِ","وَشَتّانَ ما بَينَ السُهولَةِ وَالحَزنِ",34,"ن",1,1],["لِشِدَّةِ البَأسِ في يُمناهُ ضَربَتُهُ","إِن أُسكِرَ السَيفُ مِنها بِالنَجيعِ شَدا",35,"د",2,0],["لشيَّبني في عنفوانِ شَبيبَتي","لقائي مِنَ الأَيّامِ دَهياءَ فادِحه",36,"ح",2,0],["لشجرٍ مختلِفِ الأجناسِ","والأرضُ في البيعِ معَ الغراسِ",37,"س",1,0],["لِشَقائي قادَني بَصَري","وَلِحَينٍ وافَقَ القَدَرا",38,"ر",2,0],["لِشَقائي أُختٍ عَلِقنا","وَلِحينٍ ساقَهُ القَدَرُ",39,"ر",1,0],["لِشَقوَةٌ مِن شَقائي أُختِ مَنزِلَنا","وَقَد رَأى كَثرَةَ الأَعداءِ إِذ حَضَروا",40,"ر",3,0],["لِشُربِ صافِيَةٍ مِن صَدرِ خابِيَةٍ","تَغشى عُيونَ نَداماها بِلَألاءِ",41,"ا",2,0],["لِشَقائي صاغَكَ اللَ","هُ حَبيباً لِلقُلوبِ",42,"ب",1,0],["لِشِدَّةِ الجَريِ وَلِاِستِحطاطِهِ","ما إِن تَمَسُّ الأَرضَ في أَشواطِهِ",43,"ط",2,0],["لَشَتّانَ ما بَيني وَبَينَكِ في التُقى","وَفي الحَسَبِ الزاكي وَفي العَيشِ وَالحَفَد",44,"د",1,0],["لِشَهباءَ يُخفي القِرنُ فيها كَلامَهُ","وَيُفهِمُ إِلّا أَنَّهُ لَيسَ يَفهَمُ",45,"م",1,0],["لشاعر عربي غير ذي عوج","على الفصاحة منه تشهد الكلم",46,"م",1,0],["لشبابِ مِصرَ وهم بُناةُ حياتِها","وحُماتُها إنْ حاقتِ الأخطارُ",47,"ر",1,0],["لشدَّ الذي قُلتِهِ يا ابنتي","كلاماً توهَّجَ منه الحنينْ",48,"ن",1,0],["لشرّفت القوافيَ والمعاني","بلفظك والأخلة والخليلا",49,"ل",2,0],["لَشَدَّ مَا يُصْدَمُ وَهْمُ الفَتَى","بِنُكْرِ مَا يَلْقَاهُ فِي الوَاقِعِ",50,"ع",1,0],["لِشَبَابٍ كُلَّمَا نَادَاهُمُ","وَاجِبٌ لَبَّوا مِنَ الفَوْرِ النِّدَاءْ",51,"ا",2,0],["لَشَفَى غَلِيلَ المُسْتَهامِ بِقُرْبِهَا","وَشفَى جِرَاحَ النَّاقِمِ المَوْتُورِ",52,"ر",1,0],["لِشِعْرِ عَمَّيْكِ سِحْرٌ","فِي سِحْرِ عَيْنَيْكِ سَاجِ",53,"ج",1,0],["لِشُمُوسِهَا أَبَداً مَرَا","حٌ فاتِنٌ ظرْفاً وَمَغدَى",54,"د",2,0],["لِشَمَائِلَ مَمْلُؤَةٍ أُنْساً","وَأَخْلاَقَ عِذَابْ",55,"ب",1,0],["لشعبان في ست وسبعين حقبة","وزد مائتين في اثنتين من الدهر",56,"ر",1,0],["لشَتّانَ حَرْبٌ أوْ تَبُوؤوا بخِزْيَةٍ","وَقد يَقبَلُ الضَّيمَ الذَّليلُ المُسَيَّرُ",57,"ر",1,0],["لشرِّ النِهاياتِ هذا \" المطافُ \"","وكلُّ مَطافٍ إلى مُنتهى",58,"ا",1,0],["لِشَهْرِ رَبيعٍ نِعْمَةٌ مَا يَفِي بها","ثَنَاءٌ، وَلَوْ قُمْنا بأضْعَافِهِا نُثْني بيت",59,"ت",1,0],["لشْفِقُ أنْ يُكْتَبَ في جلدها","شِعْرُك يا ذا القَرْنِ والكَشْخِ",60,"خ",1,0],["لشاكرٍ نعمتهُ وجاحد","يُعطي العطايا ليس للعوائدِ",61,"د",1,0],["لشتانَ ما بين المَعيبيْن ظالمٌ","يُحَقُّ عليه العَتْبُ والمتعتَّبُ",62,"ب",1,0],["لشتانَ من يدعو فييوفي بعهده","ومن هو للعهدِ المؤكدِ خالعُ",63,"ع",1,0],["لَشِقْوَة ٌ مِنْ شَقَائي أُخْتِ غَفْلَتُنا","وشؤمُ جدي، وحينٌ ساقه القدر",64,"ر",1,0],["لِشَمّاءَ بَعدَ شَتاتِ النَوى","وَقَد كُنتُ أَخيَلتُ بَرقاً وَليفا",65,"ف",2,1],["لشأن الدين في الإسلام معنى","يحل رموزه الدرك اللبيب",66,"ب",1,1],["لشجينا بمن يحيى ويمضي","فارغ القلب لا يحس شجوني",67,"ن",2,0],["لِشَكواكَ أَخفى الجَوُّ عَنّا غَمامَهُ","زَماناً فَمُذ عوفيتَ أَظهَرَ ما أَخفا",68,"ف",2,0],["لشاكر ما أسديته من مكارم","وآثر ما أبديته من مناقب",69,"ب",1,0],["لشخصين شيطانين من عجم الورى","وثالثهم من مصر مُنفيً مغرب",70,"ب",1,0],["لشويعر قد قال قولا فاجرا","ليغر منا واهي الإيمان",71,"ن",1,0],["لشمسِ الضحى والدرِّ والمسكِ ونفحةً","وغصنِ النقا والدعصِ والورد أَشباه",72,"ا",2,0],["لشاهدت اسدا غابها اجم القنا","تصول واطراف المنية تسرع",73,"ع",1,0],["لشاهدت ليثا حين دارت سيوفه","تدور المنايا حولها والنوائب",74,"ب",1,0],["لشَعْرُكَ مُشْبِهُ الماءِ الْ","لَذي يُروِي صَدَى الغُلَلِ",75,"ل",1,0],["لِشَقوتهِ يجتازُ أرضاً وطيئةً","ويسرحُ في جوِ الكَمالِ ويصعد",76,"د",1,0],["لشدَةِ ما يَلقى تحجّر قلبه","فلا ترجُ للخيرِ الدَّمَ المتجمّدا",77,"د",2,0],["لشِدَّةِ ما عانَقتُها انحلَّ عقدُها","فخُلتُ ظلامَ اللّيلِ من نورِه نفَر",78,"ر",1,0],["لِشِعرِكَ سالت مُهجتي في مَدامِعي","فإنشَادُكَ الشّاجي يذُوب له الحَجر",78,"ر",1,0],["لِشَيبي نُصولٌ مِن فُؤادي خِضابُها","بِما مالَهُ حَتّى المَماتِ نُصولُ",79,"ل",1,0],["لِشَهبائِها الشُّهبُ الثَّواقِبُ حُسَّدٌ","تَمَنّى لِغازٍ أَنَّهُنَّ خُيولُ",79,"ل",1,0],["لِشَنِّ غاراتِ العُفاةِ مالُهُ","مُنتَهَبٌ وَالعِرضُ غَيرُ مُنتَهَك",80,"ك",1,0],["لَشَتّانَ ما بَينَ اليَزيدَينِ في النَدى","إِذا عَدَّ في الناسِ المَكارِم وَالمَجدُ",81,"د",1,1],["لشدَّةِ العلاقَة","وَالصدقِ في الصَداقَه",82,"ه",1,0],["لشتان من بين المقامين إنما","المبرز من لاهمه غير عشرتي",83,"ي",1,0],["لَشَرُّ الناسِ عَبدٌ وَاِبنُ عَبدٍ","وَأَلأَمُ مِن مَشيِ مَولى المَوالي",84,"ي",1,1],["لِشَأْني قِصَّةٌ رُفِعَتْ","فَبادِرْ واغنَمِ الفُرْصَه",85,"ه",1,1],["لَشَدَّ ما قَد صَدَفتُم بَعدَ وَصلِكُمُ","يا قُربَ مَأتَمِهِم يالي مِنَ العُرُسِ",86,"س",1,0],["لِشِيمتِه وهمتِه اختِلافٌ","وليسَ يَضرُّ جمعُ الضَرَّتينِ",87,"ن",1,0],["لِشبلٍ لَهُ في السَنا","كَشَمس الضُحى في الحَمل",88,"ل",1,0],["لِشبّانِهِم حلم الكهول وَشيبهم","عَلى كُل جَد مُقبِل في العُلى رتبُ",89,"ب",1,0],["لِشنْعاء جانيها حَقيرٌ وخَطْبُها","خطيرٌ وتحْميها الفوارس والرَّجْل",90,"ل",1,0],["لَشاهَدتَ يَوماً بَعدَ شُحطٍ مِنَ النَوى","وَبَعدَ ثَنائي الدارَ حُلواً شَمائِلُه",91,"ل",2,0],["لَشَقُّ فُؤادي دونَ شَقِّ العَصا عَلى","مِنَ الآسُ لي مِن خَدِّهِ وَالشَقائِقُ",92,"ق",1,0],["لِشادِنٍ زالَ عَدلُ رَحمَتِهِ","عَنّي فَقاسَيتُ ظُلمَ قَسوَتِهِ",93,"ت",2,0],["لشيبي لا ارجو من الدهر مقصدا","فشبت واهلي في الولادة عاقر",94,"ر",1,0],["لشاء سيدنا الذي بلغ العلا","بجلاله وجماله وكماله",95,"ل",2,0],["لشدة حمل الثوب غيرُ مناسبٍ","رشا من كمال اللطف يحجبه العرا",96,"ا",1,0],["لشِنْتمُ الحقَّ ثم قلتمْ","والأنفسُ عنهُ في انْزياحِ",97,"ح",1,0],["لشوقِ سَنا الصّباحِ إلى لِقاهُم","تنفّس حسْرةً ورمى جِمارا",98,"ر",2,0],["لشيخ شيوخنا العربي من قد","أتانا منه فيض هدى ومنح",99,"ح",1,0],["لشكرانهم أو لكفرانهم","هو الإمتحان لهم يصلح",100,"ح",1,0],["لِشَزرِهِ صانَعَ بِالمَشزورِ","وَيَسَرٍ إِن دُرنَ لِلمَيسورِ",101,"ر",1,0],["لِشَرحِهِمُ خَبايا كُلِّ فَنٍّ","جَهِلنا ما البَليدُ مِنَ الفَهيمِ",102,"م",1,0],["لِشِعري مِنهُ عِزٌّ وَاِرتِفاعٌ","نَصيبَ السِلكِ مِن شَرَفِ النّظيمِ",102,"م",1,0],["لشمس مجدك في الآفاق أضواء","وللمقلين من جدواك إثراء",103,"ا",2,1],["لشيئينِ في كَفَّيه حِلٌّ ورِحْلَةٌ","فللجودِ حِلٌّ حيثُ للمالِ تَرحَالُ",104,"ل",1,0],["لشمس الهدى بدر الدجى علم الهدى","وغيظ الي فاليبك من كان باكيا",105,"ي",2,0],["لَشَفى نَفسَكِ اِنتِقامُ بَني عَم","مِكِ حينَ الدِماءُ كَالجِريالِ",106,"ل",1,0],["لِشَعب يَسيغ الذُل مِن بَعد ما سَما","لَهُ في الوَرى ملك أَشم مَكين",107,"ن",1,0],["لشؤونِ الأوقافِ صرتَ مُديراً","بكَ بُنيانها الرفيع