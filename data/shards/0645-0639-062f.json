{"poems":[[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[73,"لله قاضي ديندوز فإنه","https://www.aldiwan.net/poem3928.html","الكامل"],[32,"ألا حي الدار قفرا جنوبها","https://www.aldiwan.net/poem29610.html","الطويل"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[39,"معدنك الجوهر المهذب ذو","https://www.aldiwan.net/poem6457.html","المنسرح"],[74,"سقى عهدها داني العهاد سفوحها","https://www.aldiwan.net/poem18486.html","الطويل"],[74,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[47,"زائر زارني ليسأل عن حالى","https://www.aldiwan.net/poem65201.html","الخفيف"],[63,"قليل لها أن يتبع الدمع غيرها","https://www.aldiwan.net/poem51683.html","الطويل"],[63,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[46,"يا عليلا حشا الجوانح نارا","https://www.aldiwan.net/poem30255.html","السريع"],[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54835","السريع"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/199525","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[47,"زَائرٌ زَارَني ليَسْألَ عَنْ حَالي","https://www.poetsgate.com/ViewPoem.aspx?id=32174",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[119,"صحف الفضاء لما نقول دفاتر","https://www.aldiwan.net/poem40935.html","عموديه"],[119,"يا نبيا على الأنبياء","https://www.aldiwan.net/poem42164.html","الخفيف"],[125,"أضحى فؤادي والأشواق مرتبضا","https://www.aldiwan.net/poem23822.html","البسيط"],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[190,"قلت نصيحة من تشاور","https://www.aldiwan.net/poem43878.html","مجزوء الكامل"],[193,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[236,"طال في شرك المضايق حبسي","https://www.aldiwan.net/poem44588.html","الخفيف"],[240,"أثقل ظهري بالمنن","https://www.aldiwan.net/poem31740.html","مجزوء الرجز"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[385,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[520,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[563,"يا نسيم الحي عني","https://www.aldiwan.net/poem33633.html","مجزوء الرمل"],[567,"تشرفت واستنارت تربة بفتى","https://www.aldiwan.net/poem52564.html","البسيط"],[572,"سلام على الأطلال وحش خيامها","https://www.aldiwan.net/poem69505.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70718","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59624","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202105","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202081","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202074","المتقارب"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112931","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130590","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33864","البسيط"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17401","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93881","الخفيف"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133971","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124293","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132680","الرمل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140026","الطويل"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124158","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103038","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123506","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123503","المديد"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81695","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83588","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72475","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120415","الخفيف"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102016","الرمل"],[4737,"باب النجار مخلع","https://www.poetsgate.com/ViewPoem.aspx?id=212576",""],[4988,"سيرة بطل راحت معاه الكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186507",""],[5189,"سجدةُ الأسحارِ","https://www.poetsgate.com/ViewPoem.aspx?id=194237",""],[5307,"حيّ ابجوابٍ ياني","https://www.poetsgate.com/ViewPoem.aspx?id=10380",""],[5573,"العدل والميل","https://www.poetsgate.com/ViewPoem.aspx?id=200222",""],[5694,"أغنى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=132103",""],[5841,"قلي عَدَوك وغيروا من طباعك","https://www.poetsgate.com/ViewPoem.aspx?id=37036",""],[5980,"جئت والوقوف بالمكارم أظلم","https://www.poetsgate.com/ViewPoem.aspx?id=146262",""],[6056,"معدن ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=156704",""],[6225,"سلمت مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80916&r=&rc=185",""],[119,"يا نبيا علا على الأنبياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55610&r=&rc=7",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["مُعِدّاً عَلى عَجسِها مُرهَفاً","فَتيقَ الغِرارَينِ حَشراً سَنينا",0,"ن",2,0],["مَعدودَةٍ مَمدودَةٍ مَشهودَةٍ","بَيضاءَ أَعجَلَ صُنعُها أَن يُقتَضى",1,"ض",2,0],["مُعَدِّينَ يَعرَورون وَاللَيلُ جاثِمٌ","عَلى الأَرضِ أَفيافاً مَخوفا رُكوبُها",2,"ب",3,0],["مُعِدُّ زُرقٍ هَدَت قَضباً مُصَدَّرةً","مُلسَ البُطونِ حَداها الريشُ وَالعَقَبُ",3,"ب",1,0],["معدنك الجوهر المُهَذَّبُ ذو","الأبريز بخٍّ ما فوق ذا هَذَبُ",4,"ب",1,1],["معدلة في مرسلات مدامعي","ولكن قلبي المستهامَ جريحها",5,"ح",3,0],["معدّل بشهادات العُلى وله","جراح يوم سطا يقذفنَ بالقتَل",6,"ل",1,0],["مُعدَّةٌ لكُمُ ما فُلَّ صارمها","ونحن أبناء تلك العُصبة الصُبُر",7,"ر",1,0],["مُعِدٌّ عتادَيْ هاربٍ ومُقاتلٍ","متى كرّ يوماً كرَّةً أو متى انهزمْ",8,"م",1,0],["معدن بانت للقصائد غراً","مثلما البحر معدن للآلي",9,"ل",2,0],["مِعدَةٌ أَوَّلِيَّةٌ كَرَحى البُرِّ","تُلَقّى حوبّاً وَتُلقي دَقيقا",10,"ق",2,0],["مُعِدٌ ليومِ الرَّوْعِ بِيضاً تذكَّرَتْ","ظُباتِ الاعادي فاستقالَتْ ذُكورَها",11,"ر",3,0],["مُعِدّاً لهم في كلِّ يومٍ مُجَدَّدٍ","من الرَّاحِ والرَّيحانِ عيشاً مُجدَّدا",12,"د",2,0],["مَعدودَةٌ أَصنافُهُ لا تُجهَلُ","إِذ هِيَ في سَبعٍ وَسَبعٍ تَكمُلُ",13,"ل",1,0],["مَعدِنُ الحُسنِ وَالمَلاحَةِ قَد أَص","بَحَ لِلسُقمِ مَعدِناً وَقَرارا",14,"ر",2,0],["مُعِدّينَ ضِرغاماً وَأَسوَدَ سالِخاً","حُتوفاً لِمَن دَبَّت إِلَينا عَقارِبُه",15,"ب",2,0],["مُعَدَّةٌ لِلْعَيْشِ مَا يُقْتَضَى","مِنْ نَافِعٍ فِي الْفَن أَوْ فَاخِرْ",16,"ر",1,0],["معدّ شيخٌ بَنَى للمجد قُبًته","فالمجدُ منه، ومِن ابنائه خُلُقُ",17,"ق",1,0],["مُعِدٌّ لِأَخيارِ الرِياحِ طَليعَةً","يُراقِبُ زَبّانينَ حينَ يَأوبُ",18,"ب",1,0],["مِعْدَةٌ أوّلِيّةٌ كَرَحَى البُرِّ","تُلقَّي حَبّاً، وتُلْقي دَقِيقَا",19,"ق",2,0],["معدن الخير والجمال المصفّى","وجهك الخيّر الكريم الجميل",20,"ل",1,0],["معدومة ِ الأمثالِ والعَدائل","إن قلتَ مثلَ البدرِ لم تُماثل",21,"ل",1,0],["معدودة في علمه كلمتاتنا","صحف الفضاء لما تقول دفاتر",22,"ر",1,0],["معدن المجد روح جسم المعالي","مظهر الحق من مدار الفناء",23,"ا",2,0],["معدّماً مرضا يفيض لا بضضا","مكملا فرضاً سواه قدْ رُفضا",24,"ض",2,0],["مُعدي مَنِ اِستَعدى وَسُمُّ مَنِ اِعتَدى","وَهُدى مَنِ اِستَهدى وَغَيثُ مَن اِجتَدى",25,"د",2,0],["معد كنانك والخبائص","بالنقيّ من السكاكر",26,"ر",1,0],["مَعدومةٌ أشباههُ أمثالهُ","خيرُ الكلامِ ولا يحدُّ كماله",27,"ه",1,0],["معدن الخوف والرعاية الخش","ية والشكر والرضا والأنس",28,"س",1,0],["مُعَدَّمٌ وُجودُهُ","غَضاضَةٌ عَلى الزَمَن",29,"ن",1,0],["مَعدِلَةً عَمَّتِ البِلادَ فَما","لِلجَورِ فيها عَينٌ وَلا أَثَرُ",30,"ر",1,0],["معدّاتُهُ كُثرٌ وجمٌّ عَديدُهُ","وإعدادُنا من عَدِّنا كان أنزرا",31,"ر",2,0],["مَعدَن الجود مَجمَع الظَرف وَالآ","داب وَالأُنس صَيقل الأَفهام",32,"م",1,0],["معدِنٌ كلُّ لسانِ مفصِحٍ","حولها يسقط حتى تُلْقطا",33,"ط",2,0],["معدنه الغالي فمي","وقد ملكت المعدنا",34,"ن",2,0],["معدماً من لم يزل ما","لم يكن منه شفاها",35,"ا",3,0],["معدودُ عُمرٍ مَعَ العِشرينَ أربعة","أبقَى لنا عُمْرَ حزنٍ غيرَ مَعدودِ",36,"د",1,0],["مُعَدَّلَةُ الأَقْسَامِ لِلْبَدْرِ وَجْهُهَا","وَلِلْغُصْنِ مِنْهَا قَدُّهَا وَقَوَامُهَا",37,"م",3,0],["معدنُ الجود والشجاعةِ والإك","رام والإنتقام والإنصافِ",38,"ف",1,0],["مُعداً أو أنَ السلم أوزار حَرْبها","وكمْ دِنت بالعتبى وإلغاء عتبها",39,"ه",2,0],["مُعدًى وثيقَ العَقدِ كَفتاً كَأنَّه","إِلى المنحنى من جيدها جِروُ حنظلِ",40,"ل",1,0],["معدٌ أمير المؤمنين الذي بدا","شهابا يُضيء الشرق والغرب ثاقبا",41,"ب",2,0],["مَعَدٌّ أميرُ المؤمنين الذي له","عَلى ذَاتِ ما يُسْمَى العُلُو عَلاءُ",42,"ا",2,0],["مَعدٌّ إمامُ الهُدى المرْتَجى","ومِنْ فَضْله فابْتَغ السَّلسَبيلا",43,"ل",2,0],["معدٌ أيا شافِعِي في المعاد","وأَكْفَي مَعِينٍ وأوفي مَعَانِ",44,"ن",1,0],["معدن الارفاد بحر الخير غيث العطايا","سند في المزعجات",45,"ت",1,0],["معدن الاحسان واهبه","طاهر الاخلاق والقدم",46,"م",1,0],["مُعدٌ ليوِم الرَّوع أبيَض صارماً","واسْمَرَ خطّياً وأَشقر سَلْهَبَا",47,"ب",2,0],["معد جوعت ثلاثين يوماً","بسلاح شاك من الأسنان",48,"ن",1,0],["معدن الحق والنبوةِ والعد","ل إذا ما تنازع الخصمانِ",49,"ن",1,0],["مُعِداً وفاءَ الدين للموقف الذي","يُحاذرُهُ من لم يَفِدْ بوَفاءِ",50,"ا",2,0],["مُعِدَّةٌ حينَ يَلتَفُّ الكُماةُ بِها","مِن كُلِّ بِطريقَةٍ مِنهُم وَبِطريقِ",51,"ق",1,0],["مَعدِنَ الضَيفِ إِن أَناخوا إِلَيهِ","بَعدَ أَينِ الطَلائِحِ الأَنقاضِ",52,"ض",1,0],["معدن التبر ليس يخرج منه","ما سواه كزئبق أو نحاس",53,"س",1,0],["معدمة المثيل والنظائر","إذا سرت تزري بكل طائر",54,"ر",1,0],["معدن العلم منتهى الحلم مستح","فظ حكم النبي خير الأنام",55,"م",1,0],["معدن الفضل والمراحم والآ","لاء والحلم والندى المعلوم",56,"م",1,0],["معدَّل قد يبهت الشمس حسنه","وللشمس بالتعديل بهتٌ مصادم",57,"م",1,0],["معد عودتها عدنان معدنها","مرَدُّ ما سلبت من صالح الدوَل",58,"ل",1,0],["معدن من جوهر قد نظما","يجتنى منثوره في المنطق",59,"ق",1,0],["مُعدُّ لشخص واحدٍ فدعا له","ثمانين شخصاً من شباب وهُرّم",60,"م",1,0],["معدل الخلق لا طول ولا قصر","مكمل الخلق لا هين ولا شرس",61,"س",1,0],["معدلة وتفتح الدال وقل","عدلا ثلاثا وردت يا ذا الرجل",62,"ل",1,0],["معدم العدم مهلك كل عسر","أسد الأسد واحد الآحاد",63,"د",1,0],["معدن الجود أصل كل فخار","منبع المجد درة الغوّاص",64,"ص",1,0],["معدن الأسرار واهبها","قامع من باعتدا شمسا",65,"س",2,0],["معدن الخير والمكارم والجو","د مفيد الوفود أوفى مراد",66,"د",1,0],["معدنٌ آل أبي ح","فص نَمى خير المعادن",67,"ن",1,0],["مَعَدّيّة علياؤُهُ عدَوِيّةٌ","مناقِبُها أعيَت على الحصر والعدّ",68,"د",1,0],["مَعدنُ الحَمدِ واِسمُهُ مِنه مُشتَق","قٌ وَمَعناه لِلمَحامِد حَمدُ",69,"د",1,0],["معدومها علم الموجودا","من عدم علة الموجود",70,"د",1,0],["معدما من صبر غنيا من الشو","ق فهلا بقيت من ذا عديما",71,"م",2,0],["معدن الأسرار والعلم فكم","كشف الأستار عنه واللثاما",72,"م",2,0],["معدنُ جمجمتي فولاذٌ","إنْ ين