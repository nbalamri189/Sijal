{"poems":[[55,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20008","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79851","الخفيف"],[4797,"تحذرو من بايعين الحباري","https://www.poetsgate.com/ViewPoem.aspx?id=178133",""],[5573,"سلام مني ياصل القرم سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=200351",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""]],"verses":[["وَإِلى طَودٍ مِنَ العِز","زَةِ مِزلاقِ الجُنوبِ",0,"ب",1,0],["وَإِلى طِلِّ عِزِّهِ","يَلجَأُ الخائِفُ الوَجل",1,"ل",1,0],["وإلى طلعةٍ جلت كلَّ همٍّ","ببنان الإِقبال أضحى مشيرا",2,"ر",2,0],["والى طلع ماجاك سالم وباري","انًما ذبحه البنج فالريش تكسير",3,"ر",1,0],["والي طلب للعلم يلقابه احسان","يرقى المعالي لين يبلغ نصابه",4,"ب",2,0],["والى طريقٍ هامَ منتعلَ السّدى","وعلى الفراغِ يقيمُ أنخابَ الثّملْ",5,"ل",1,0]]}