aldiwan.net/poem17476.html","أحذ الكامل"]],"verses":[["لَو عُقِّدَت بَعضاً بِبَعضٍ في السُرى","كانَت لَهُ بَدَلاً مِنَ الأَرسانِ",0,"ن",1,0],["لَو عَلِمَ الناظِرُ يَوماً ما هُما","أَفظَعَهُ الخَطبُ وَقالَ مَن وَمَن",1,"ن",1,0],["لَو عَوِّضَ الدُنيا عَلى عِزِّها","مِنكَ لَما سُرَّ بِما عُوِّضا",2,"ض",2,0],["لَو عيدَ مِن داءِ الفَهاهَةِ واحِدٌ","عادوهُ مِن عَيِّ إِذا حَضَرَ النَدي",3,"د",2,0],["لَو عَلِمَت أَيَّ فَتىً ماجِدِ","ذاتُ اللَمى وَالشَنَبِ البارِدِ",4,"د",1,1],["لِوَعيدِ مُحتَضِرِ العِدى بِحُسامِهِ","قَبلَ اِحتِمالِ ضَغائِنٍ وَحُقودِ",5,"د",1,0],["لَو عَلى قَدرِ ما يُحاوِلُ قَلبي","طَلَبي لَم يَقَرَّ في الغِمدِ عَضبي",6,"ي",1,1],["لَو عَلِمنا أَنَّ الصِيامَ الَّذي يُن","سيكُمُ وَصلَنا قَلَينا الصِياما",7,"م",2,0],["لَو عُبِدَ المَخلوقُ مِن","حُسنِهِ لَأَصبَحَت مالِكَتي رَبّا",8,"ب",2,0],["لوْ عادَ البَدْرُ بغُرّتِه","لمْ يخْشَ الخَسْفَ ولا محَقا",9,"ق",2,0],["لَو عاقَبوني في الهَوى بِسوى النَوى","لَرَجَوتُهُم وَطَمَعتُ أَن أَتَصَبَّرا",10,"ر",2,0],["لَوْ عَدَدْنَا فِيهِ مَنْ أَسْعَدْتِهِ","لَعَدَدْنَاهُمْ أُلُوفاً وَمِئِينْ",11,"ن",1,0],["لَو عاشَ كَبشا تَميمٍ ثُمَّتَ اِستَمَعا","شِعري لَماتا وَماتَ الوَغد ذو الرُمَّةِ",12,"ه",1,0],["لو عمّ في الناس حسَنٌ مثل حسّك لي","ماتاه في فلوات الفقر من تاها",13,"ا",3,0],["لو عشت ستين عاماً لاستعضت بها","ستين مكْرُمةً بل دون ستين",14,"ن",1,0],["لو عجّل الله للحسّاد لعنته","لكان أسقط منها فوقهم كسفا",15,"ف",2,0],["لو عقلنا لما اختشى قط محسو","دون وقع الأذاة من حسّاد",16,"د",1,0],["لو عدانا منه وحاشاه برّ","لاكْتفينا من برِّه بالتغاضي",17,"ض",2,0],["لوعدِه من كرمِ ذكرِه","حتى إذا وفى فنسيانه",18,"ن",2,0],["لو علمتَ الخفيَّ من كلّ علمٍ","جامعاً بينه وبين البِغاءِ",19,"ا",2,0],["لو علمتَ الذي يُقاسي من الأَمْ","رين عَزّيتَه صباحَ مساءِ",20,"ا",2,0],["لو علِمتَ الذي بجسمي من السُّقْ","م وضُرِّ الهوى لكنت جوابي",21,"ي",1,0],["لو عدا صبرُها إلى إليتَيْها","كنتَ تحت السياط عين الجليدِ",22,"د",1,0],["لو عُقرتْ حول قبرها بقر ال","إنسِ مكان القِلاص والمُهَرِ",23,"ر",1,0],["لو عرضت شيراز صوَّارَها","وعِينها لانتابها الباعه",24,"ع",2,0],["لَو عادَ لِلدُنيا البُراقُ وَحُزنُهُ","ما كانَ إِلّا نَحوَهُ إِسرائي",25,"ا",2,0],["لَوعَةٌ في الضُلوعِ مِثلَ جَهَنَّمِ","تَرَكَت هَذِهِ الضُلوعَ رَمادا",26,"ا",1,1],["لَو عَلِموا أَنَّني عَدُوَّهُمُ","أَوشَكَ يَقضي عَلَيهُمُ الفَرَقُ",27,"ق",1,0],["لَو عَدَلَت فيهِمُ الشَرائِع","ما اِستَحدَثوا لِلقِتالِ الَه",28,"ه",1,0],["لَو عَرَفنا ما الَّذي قَبلَ الوُجود","لَعَرَفنا ما الَّذي بَعدَ الفَناء",29,"ا",2,0],["لَو عَلِمتُم مَحَلَّكُم","في فُؤادي لَسَرَّكُم",30,"م",1,0],["لو عاد ذلك كله لقى الهوى","حتى كأنه لم تطوِه الأعصار",31,"ر",1,0],["لَو عاشَ قُدوَتُهُمُ وَرَبُّ لِوائِهِم","نَكَسَ اللِواءَ لِثابِتٍ وَقّافِ",32,"ف",1,0],["لَو عِشتِ شِدتِ مِثلَها","لِلمَرأَةِ المُحَرَّرَه",33,"ر",2,0],["لَو عاشَ كانَ مُؤَمَّلاً لِمَواقِفٍ","يَرجو لَها الوادي كِرامَ شَبابِه",34,"ب",2,0],["لَو عَرَفوهُ عَرَفوا","مِنَ البَلاءِ أَكثَرَه",35,"ر",2,0],["لَو عَصَيتُمُ كاذِبِ اليَأسِ فَما","في صِباها يَنحَرُ النَفَسَ الضَجَر",36,"ر",1,0],["لَو عَدا عَنكِ غَيرَ هَجرِكِ بُعدٌ","لَأَرارَ الرَسيمُ مُخَّ المَناقي",37,"ق",2,0],["لَو عُدَّ فَتحُ المازِيارِ وَمِثلِهِ","أَفنى العِدادُ كَراسِفَ الأَنقاسِ",38,"س",1,0],["لَو عَلِموا مابِتَّ نَصباً لَهُ","أَصبَحتَ دُبّاً عِندَهُم أَكشَفا",39,"ف",2,0],["لَو عَصَرَت عُنقَ ظَليمٍ وَقَد","أَدخَلَ فيها رَأسَهُ ما اختَنَق",40,"ق",1,0],["لَوعَةٌ أفرَطَتْ فعادَتْ حَريقاً","وحَنينٌ أربَى فعادَ شَهيقا",41,"ق",2,0],["لو عاينت أملاك فارس حسنها","خرت لها أملاك فارس سجدا",42,"د",2,0],["لَو عَقَلنا إِذِ النَهارُ يَسوقُ ال","لَيلَ وَاللَيلُ إِذ يَسوقُ النَهارا",43,"ر",2,0],["لَو عَقَلنا ما نَرى لَانتَفَعنا","وَاعتَبَرنا بِالقُرونِ الخَوالي",44,"ي",1,0],["لَو عَلِمَ الناسُ كَيفَ أَنتَ لَهُم","ماتوا إِذا ما أَلِمتَ أَجمَعُهُم",45,"م",1,1],["لَو عَلِمَ الأَحياءُ ما عايَنَ ال","مَوتى إِذاً لَم يَستَلِذّوا الحَياة",46,"ا",2,0],["لَو عايَنَت مُقلَتُهُ دُخنَةً","لَاِستَرَقَ اللُبَّ مِنَ القِشرِ",47,"ر",1,1],["لو عاد ذاك الماءُ نفطاً أحرقت","في الجوّ منه قميصَ كلّ عنانِ",48,"ن",1,0],["لَو عايَنَ الدَجّالُ بَعضَ فَعالِهِ","لَاِنهَلَّ دَمعُ الأَعوَرِ الدَجّالِ",49,"ل",1,0],["لَو عايَنَ الأَسَدُ الضِرغامُ رُؤيَتَهُ","ما ليمَ أَن ظَنَّ رُعباً أَنَّهُ الأَسَدُ",50,"د",1,0],["لَو عايَناكَ لَقالا بَهجَةً جَذَلاً","أَبرَحتَ أَيسَرُ ما في العِرقِ أَن يَشِجا",51,"ج",2,0],["لَوْ عَزَوْنَا كُلَّ امْرِئٍ لأَبِيهِ","مِنْ فرَاخِ الْوَزَّانِ لَمْ يَبْقَ نَسْلُ",52,"ل",1,0],["لَو عِندَنا اِغتيبَ أَو نيلَت نَقيصَتُهُ","ما آبَ مُغتابُهُ مِن عِندِنا جَذِلا",53,"ل",2,0],["لَو عَلِمنا ما يُسَرُّ بِهِ","ما طَعِمنا البارِدَ الخَصِرا",54,"ر",2,0],["لَو عَلِمتِ الهَوى عَذَرتِ وَلَكِن","إِنَّما يَعذِرُ المُحِبَّ المُحِبُّ",55,"ب",1,0],["لَو عَظَّموا حُرُماتِ النيلِ ما اِضطَرَمَت","أَحقادُ قَلبٍ بِماءِ النيلِ رَيّانِ",56,"ن",1,0],["لَو عايَنَت صُوَرَ النُفوسِ عُيونُنا","لَم يَعدُها أَنَفٌ وَلا اِستِقباحُ",57,"ح",1,0],["لوعةٌ مشبوبةٌ في سَقَمٍ","في شآبيبَ من الدَّمعِ السخينْ",58,"ن",1,0],["لَوعَةٌ بي مِنكَ أَم بي لَمَمٌ","ما النُهى وَالحُبُّ إِلّا طَرَفانِ",59,"ن",1,0],["لوْ عُمِّرَ ابنُ المِعمار خَوَّلهُ","نِيَابَةَ الخِدْمَتَيْنِ والخُطْبَهْ",60,"ب",2,0],["لِوَعدِ يَومٍ لَيسَ فيهِ خُلفُ","حَتّى إِذا ما اِجتَمَعوا وَاِصطَفّوا",61,"ف",3,0],["لو عنّ لي قدرٌ يساعدُ صرفهُ","لرأيتِ كيف تعفّفي ووقاري",62,"ر",2,0],["لَو عاشَ حَمّادٌ لَهَونا بِهِ","لَكِنَّهُ صارَ إِلى النارِ",63,"ر",1,1],["لَو عَرَفتَ الرِئبالَ يابنَ خُلَيقٍ","لَتَنَصَّفتَ وَجهَهُ وَاِستَخَرتا",64,"ت",2,0],["لَو عايَنَتكَ كُماتُنا بِطُوالَةٍ","بِالحَزوَرِيَّةِ أَو بِلابَةِ ضَرغَدِ",65,"د",1,0],["لَو عاشَتِ الشَمسُ فينا أُلبِسَت ظُلَماً","أَو حاوَلَ البَدرُ مِنّا حاجَةً لِحَقرِ",66,"ر",1,0],["لَو عُجِّلَت لِغَويٍّ فاجِرٍ سَقرٌ","لَأُشعِروا جَمَراتِ النارِ تَحريقا",67,"ق",2,0],["لَو عُدتُ مِن أَسَدِ النُجومِ بِجَبهَةٍ","أَو بُتُّ في ذَنَبٍ لِشَبوَةِ شائِلِ",68,"ل",1,0],["لَو عَقَلَ الإِنسانُ رامَ الهُدى","وَلَم يَبِت في النَومِ سَدرانا",69,"ن",2,0],["لَو عَلِمَ العاذِلونَ سِرّي","لَأَصبَحَ القَومُ عاذِرِيّا",70,"ر",3,0],["لوْ عَرَفَ الإنْسانُ مقدارَهُ","لم يَفْخَر المولى على عَبْدِهِ",71,"د",2,0],["لو عاشَ زادكِ من غرائب فنّهِ","ما لا يُشَبّهُ حسنهُ بنظائرِ",72,"ر",1,0],["لَوْ عَلِمَ الإِنْسَانُ ما أَضْمَرَتْ","أَحْبَابُهُ هَانَتْ عَلَيْهِ الْعِدَا",73,"د",2,0],["لُوْ عَاشَ صَاحِبُهُمْ لَعَاشَ رَهِينَةً","مِنْ بَعْدِهَا لِلهَجْعَةِ السَّوْدَاءِ",74,"ا",2,0],["لَوْ عَلَوْا كَالمَدِّ فِي بَحْرٍ طَغى","ثُمَّ ظَنُّوهُ لعَادَ المَدُّ جَزْرَا",75,"ر",2,0],["لَوْ عَادَ مِمَّنْ خَلاَ أُنَاسٌ","لَعَادَ مَتْبُوعُهُمْ تِبيَعا",76,"ع",2,0],["لَوْ عُدَّ مَا فَعَلَتْ جَهَالَتُنَا بِنَا","لَمْ يُحْصِ أَكْثَرَهُ حِسَابُ الْحَاسِبِ",77,"ب",1,0],["لو عاد فرعون كانت من ذخائره","أو ختم الخلد كانت في خناصره",78,"ر",2,0],["لَو عاشَ لي عَبدُ الغنيّ هنا هنا","عيشي وَإِن فارَقت ريماً أَخمَصا",79,"ص",2,0],["لَو عِشتَ قامَ لِمَجدي","في كُلِّ أُفقٍ مَنارُ",80,"ر",1,0],["لَو عَلِمَت أُمّكَ أَلّا تَرى","وَجهَكَ ما أَزمَعتِ السُخطا",81,"ط",2,0],["لو عَرَفَ الإِنسانُ ما أجرُه","ما ضَنَّ بالنفْسِ على أَجْرِه",82,"ر",2,0],["لو علت للنجم نفسي لأتتْ","تقتفيها شدّةٌ هل من رَخاء",83,"ا",2,0],["لو عرفنا متى تكون المنايا؟","لانتظرناها مذ بلغنا الفطاما",84,"م",2,0],["لو عالج المصلحون \" الجوعَ \" ما فَسَدَتْ","أوضاعُنا ، هذه الفوضى من السغب",85,"ب",1,0],["لو عدَمتْه لبكتْ بأربعه","وأصبحتْ لفقده مفجَّعهْ",86,"ع",2,0],["لَوْ عِنْدَنَا کغْتِيبَ، أَوْ نِيلَتْ نَقِيصَتُهُ،","ماى بَ مغتابه من عندنا جذلا",87,"ل",2,0],["لو عزونا كلَّ امريءٍ لأبيهِ","منْ فراخِ الوزانِ ، لمْ يبقَ نسلُ",88,"ل",1,0],["لو عرف الغزال شأ","نه به تغزلا",89,"ل",2,0],["لوعته قد محقت كله","بعرف ذا من خمرة الوجد ذاق",90,"ق",1,0],["لوعة الوجد احجت جمر وجدي","فمتى الحظ باللقا يتنبه",91,"ب",2,0],["لو على قدر بطء حسك يوماً","كنت كيساً ذا أربة وذكاء",92,"ا",2,0],["لَو عاشَ كانَ لِفِهرٍ كُلِّها عَلَماً","إِذ كانَ مِنها مكانَ الروحِ لِلجَسَدِ",93,"د",1,0],["لَو عُدَّ أَدنى جودِهِم لَأَضعَفا","عَلى البِحارِ وَالسَحاب اِستَرعَفا",94,"ف",2,0],["لو عاش لم يطرق الأسماعَ ذكرهمو","في طلعة الشمس من ذا يبصر الشهبا",95,"ب",2,0],["لو علِمنا أنَّ التفجُّعَ يُدني","ك بكينا دون النساءِ ونُحْنا",96,"ن",2,0],["لو عِدموا البيَض والخَطِّىَّ أنجدَهم","ضربٌ دِراكٌ ورشْقاتٌ من المُقلِ",97,"ل",1,0],["لَو عاصَرَت كِسرى لَكانَ بِوِدِّهِ","لَو صيغَ مِنها تاجُهُ وَسِوارُهُ",98,"ر",2,0],["لو علمتم ما يقاسي في الهوى","لقى المسكين ما يذهله",99,"ل",2,0],["لو عاد عدت ولو تراجع للهدى","لرجعت نحو العفو والغفران",100,"ن",1,0],["لَو عادَ وَالِدُهُ حَيّاً وَخاصَمَهُ","مُستَضعَفٌ لَم يَحِف جَوراً وَلَم يَمِلِ",101,"ل",1,0],["لو عاش بقراط سرّني ورأى","منّي في فضله تفضلّه",102,"ل",2,0],["لو عددت النجوم والأفلاكا","وتراقيت فوق أقصى مناكا",103,"ك",2,1],["لَوْ عَمَّ عَزْمُكَ في الأصقاعِ لَانْدَثَرَتْ","أعتى المَصاعِبِ واسْتَعْصى بِها الزَّلَلُ",104,"ل",1,0],["لو عامر أو عمرو","شاهد بطش جفنيه لأحجم",105,"م",1,0],["لو عشقَ الشمسَ فيكَ قومٌ","لكانَ هذا الجمالُ عذرا",106,"ر",2,0],["لو عددت اسمَ حدِّه مأثراتٍ","كان فيه على الأمير أمارُ",107,"ر",1,0],["لو عُدَّ في الخَلق مَن يُغذى بنعمته","ما كان يُروِيهم جَيحَانُ والنِّيلُ",108,"ل",1,0],["لو على العاشقين يُقسم عشقي","أصبح الناسُ كلُّهم عُشّاقا",109,"ق",2,0],["لو عاصرت شيخ الشيوخ لجاءها","منطفلا يسعى إلى أبياتها",110,"ت",3,0],["لو عدتُ عاد صباها","وعاد ما قد عهدتم",111,"م",1,0],["لو عنفتني عذولي عن محبَّتِه","لما انثيتُ فما من حُبِّنا ذَاقُوا",112,"ق",3,0],["لَو عَلِمَ العاذِلُ وَجدي بِهِ","جاءَ مِنَ التَفنيدِ لي بِاعتِذار",113,"ر",1,0],["لَو عُوِّضَ الناظِرُ عَن ذَلِكَ ال","وَجهِ عَمى العَينَينِ لَم يَخسَرِ",114,"ر",1,0],["لَوْ عَلِمْنَا اطِّرَادَ نَقْضٍ لَدَيْكُمْ","لَلَهَجْنَا بِعَكْسِ مَا قَدْ نَوَيْنَا",115,"ن",2,0],["لَوْ عَلِمْنَا اطِّرَادَ نَقْضِ الأَمَانِي","لاَعْتَمَدْنَا عَكْسَ الْمُرَادِ فَفُزْنَا",116,"ن",2,0],["لو عاش فيه جريره ما","اعتاض منه سوى الجريره",117,"ر",2,0],["لو عمّر الهادي بنى داريهما","من عَسجدِ فوقَ اللُّجينِ يُشادِ",118,"د",1,0],["لَو عايَنَت عَيناكَ بَهجَةَ جِلَّقا","وَرَأَيتَ مَنظَرَها البَهيجَ المونِقا",119,"ق",2,1],["لَو عايَنَت عُربٌ بِنَجدٍ حُسنَهُ","لَم يَنسِبوا يَوماً بِرَبَّةِ هَودَجِ",120,"ج",1,0],["لوعة في جوانحي وشجون","كمنت فاسثارها التذكير",121,"ر",1,0],["لَو علمَ اللائمُ ما رامَه","مَلومُه ما رامَ إِلّا الصَلاح",122,"ح",1,0],["لو علمت بحالتي لا انفجرت","وهل يراد العلم من بهيمه",123,"ه",1,0],["لَو على يقظةٍ توهّمت جفواً","مِنهُ أَضحت مَلابسي أكفاني",124,"ن",2,0],["لَو علّقَ العلمَ بنجم السماء","لَنالهُ الأقوامُ مِن فارِس",125,"س",1,0],["لو علمت بعض ما له خلقت","أحزنها علمها وأبكاها",126,"ا",3,0],["لو عادك الشعر يوماً","بقلبه أو بفيه",127,"ي",2,0],["لَو عَلمنا بِذا القُدوم رَحلنا","قَبل أَن تَبتَغي النُفوس رَحيلا",128,"ل",2,0],["لوعة اعنت الفؤاد ونار","في حواشيه جمرها ضرام",129,"م",1,0],["لو عِشْتُ لاقَيْتُ الوزي","رَ ونلْتُ من جاهٍ ومال",130,"ل",1,0],["لو عَدَّ في أَقصَرِ الألحاظِ مُمتَحَناً","ما يَحسُبُ النّاسُ طولَ الدَّهْرِ ما غَلِطا",131,"ط",2,0],["لو عرَفْنا في الجودِ حُجْراً لكُنّا","قد ضرَبْنا عليه منه حَجرا",132,"ر",2,0],["لَو عاشَ شاهِنشاهُ أَيقَنَ أَنَّهُ","مَلِكُ الدُسوتِ وَأَنَّهُ الفِرزانُ",133,"ن",1,0],["لَوعةٌ يا بَني حُميدٍ أراها","مالَها في سِوىَ التَّأسِّي مُسَكِّن",134,"ن",1,0],["لو عَدلت كأسُ الهَوى لم أكُن","أكرَهُ عَدلَ الكأسِ في المَجلسِ",135,"س",1,1],["لو عشت دهراً مادحاً أوصافها","قصرت لم أوف المديح الواجبا",136,"ب",2,0],["لو عرفتم لعذرتم من غدا","لأبيه خيفة مجتنبا",137,"ب",2,0],["لو عرفت الحال كنت إلى","وصل من أهواه لي سبب",138,"ب",1,0],["لَو علمَت أَن العلى في السُرى","قالَت عَلى الرَشد انحَ ما أَنتَ ناح",139,"ح",1,0],["لوعةً في الحشا فشَبَّتْ ضراما","حرموا عَينَيَّ الكرى يوم بانوا",140,"ا",1,0],["لَوْ عَدَدْنَاه فِيهُمُ لأَصَبْنَا","نِسْبَةً تَسْتَبِينُ جِنْساً بِجِنْسِ",141,"س",1,0],["لو عايَنَتْهَا لاِبْنِ مُقْلَةَ مُقْلَةٌ","رَجَعَتْ تَرَى حُورَ الطَّرَائِق عُورا",142,"ر",2,0],["لو عطفَ الصبرُ تجنبتُه","فكيفَ أُلْفيه ولمْ يعطِفِ",143,"ف",1,0],["لو عاذ لي يجد الذي بي لم يكن","يوم الرحيل مفندا ومعنّفا",144,"ف",2,0],["لو علمه بحر يصور ما جرى","للخضر فلك من عباب يترع",145,"ع",1,0],["لو عزمه سيفاً يشحذ لم يزل","أبدا لهامات النوائب يقطع",145,"ع",1,0],["لو عكفَ الحسنُ على قِبلةٍ","تعبُّدا صلَّى إليه وصامْ",146,"م",1,0],["لو عيب بالجود وإفراطِه","مُعطٍ رأى العائبُ فيه مقالْ",147,"ل",1,0],["لو عفتُ كلَّ مالح","لما شربتُ أدمعي",148,"ي",1,0],["لو عِيبَ ما عابه شيءٌ يُزَنُّ به","من النقيصةِ إلا أنه بشرُ",149,"ر",1,0],["لو عشتَ لم تكن الحياةُ ذميمةً","ولكان حظي منك غير زهيد",150,"د",1,0],["لو عللّوني أ