{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"لو علمت أي فتى ماجد","https://www.aldiwan.net/poem30613.html","السريع"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[55,"قل لفوز ردي علي السلاما","https://www.aldiwan.net/poem26109.html","الخفيف"],[55,"وجاهل لم يذق الحبا","https://www.aldiwan.net/poem26489.html","السريع"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[71,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[93,"ربة الدولة والجاه المكين","https://www.aldiwan.net/poem11231.html","الرمل"],[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[88,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[88,"هلم نبك النهى والعلم والشرفا","https://www.aldiwan.net/poem45047.html","البسيط"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[72,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[51,"قل لعبد القوي أنت قوي","https://www.aldiwan.net/poem7971.html","الخفيف"],[51,"ليت شعري عن خالد كيف أمسى","https://www.aldiwan.net/poem7974.html","الخفيف"],[51,"كتبت ربة الثنايا العذاب","https://www.aldiwan.net/poem8530.html","الخفيف"],[51,"عيبك الصلع ليس مما يغبي","https://www.aldiwan.net/poem61863.html","البسيط"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[91,"لله من عبث القضاء وسخره","https://www.aldiwan.net/poem8730.html","عموديه"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[91,"غلط القائل إنا خالدون","https://www.aldiwan.net/poem62825.html","عموديه"],[70,"إن شكا القلب هجركم","https://www.aldiwan.net/poem42888.html","مجزوء الخفيف"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"حلفت بالمستره","https://www.aldiwan.net/poem62862.html","مجزوء الرجز"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[43,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"قد قلت عن نصح لبرذونة","https://www.aldiwan.net/poem65148.html","السريع"],[45,"من يأمن البلوى وبينا فتى","https://www.aldiwan.net/poem65213.html","السريع"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[61,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[49,"إن للدهر فاعلمن عثارا","https://www.aldiwan.net/poem62079.html","المتقارب"],[49,"أحمد الله على كل حال","https://www.aldiwan.net/poem63085.html","المديد"],[49,"لو علم الناس كيف أنت لهم","https://www.aldiwan.net/poem65358.html","المنسرح"],[49,"قد نغص الموت علي الحياة","https://www.aldiwan.net/poem65364.html","السريع"],[66,"لو عاينت مقلته دخنة","https://www.aldiwan.net/poem38602.html","السريع"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[44,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[87,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[31,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[31,"عاود القلب من سلامة نصب","https://www.aldiwan.net/poem42607.html","الخفيف"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[81,"يا سمي المصطفى يا بغيتي","https://www.aldiwan.net/poem61480.html","الرمل"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[48,"إذا مضى من رمضان النصف","https://www.aldiwan.net/poem64397.html","الرجز"],[48,"وملحة بالعذل تحسب أنني","https://www.aldiwan.net/poem66630.html","الكامل"],[50,"لو عاش حماد لهونا به","https://www.aldiwan.net/poem62392.html","السريع"],[50,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[7,"ياعام لم أعرفك تنكر سنة","https://www.aldiwan.net/poem1999.html","الكامل"],[46,"لئن سقتك الليالي مرة ضربا","https://www.aldiwan.net/poem22736.html","البسيط"],[46,"ما راعها من قرى عم وجارمها","https://www.aldiwan.net/poem23042.html","البسيط"],[46,"أسررت إذا مر السنيح تفاؤلا","https://www.aldiwan.net/poem23255.html","الكامل"],[46,"طودان قالا زل غفرانا","https://www.aldiwan.net/poem23492.html","السريع"],[46,"ساء بريا من البرايا","https://www.aldiwan.net/poem23609.html","مجزوء البسيط"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[51,"رأس أبي حفصٍ عظيم المَنْفعهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29551",""],[31,"يا صاحبيّ، قفا نستخبرِ الطللا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19020&r=&rc=283",""],[87,"كلُّ صعبٍ سوى المذلة ِ سهلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23768&r=&rc=30",""]],"verses":[["لَو عُقِّدَت بَعضاً بِبَعضٍ في السُرى","كانَت لَهُ بَدَلاً مِنَ الأَرسانِ",0,"ن",1,0],["لَو عَلِمَ الناظِرُ يَوماً ما هُما","أَفظَعَهُ الخَطبُ وَقالَ مَن وَمَن",1,"ن",1,0],["لَو عَوِّضَ الدُنيا عَلى عِزِّها","مِنكَ لَما سُرَّ بِما عُوِّضا",2,"ض",2,0],["لَو عيدَ مِن داءِ الفَهاهَةِ واحِدٌ","عادوهُ مِن عَيِّ إِذا حَضَرَ النَدي",3,"د",2,0],["لَو عَلِمَت أَيَّ فَتىً ماجِدِ","ذاتُ اللَمى وَالشَنَبِ البارِدِ",4,"د",1,1],["لِوَعيدِ مُحتَضِرِ العِدى بِحُسامِهِ","قَبلَ اِحتِمالِ ضَغائِنٍ وَحُقودِ",5,"د",1,0],["لَو عَلى قَدرِ ما يُحاوِلُ قَلبي","طَلَبي لَم يَقَرَّ في الغِمدِ عَضبي",6,"ي",1,1],["لَو عَلِمنا أَنَّ الصِيامَ الَّذي يُن","سيكُمُ وَصلَنا قَلَينا الصِياما",7,"م",2,0],["لَو عُبِدَ المَخلوقُ مِن","حُسنِهِ لَأَصبَحَت مالِكَتي رَبّا",8,"ب",2,0],["لوْ عادَ البَدْرُ بغُرّتِه","لمْ يخْشَ الخَسْفَ ولا محَقا",9,"ق",2,0],["لَو عاقَبوني في الهَوى بِسوى النَوى","لَرَجَوتُهُم وَطَمَعتُ أَن أَتَصَبَّرا",10,"ر",2,0],["لَوْ عَدَدْنَا فِيهِ مَنْ أَسْعَدْتِهِ","لَعَدَدْنَاهُمْ أُلُوفاً وَمِئِينْ",11,"ن",1,0],["لَو عاشَ كَبشا تَميمٍ ثُمَّتَ اِستَمَعا","شِعري لَماتا وَماتَ الوَغد ذو الرُمَّةِ",12,"ه",1,0],["لو عمّ في الناس حسَنٌ مثل حسّك لي","ماتاه في فلوات الفقر من تاها",13,"ا",3,0],["لو عشت ستين عاماً لاستعضت بها","ستين مكْرُمةً بل دون ستين",14,"ن",1,0],["لو عجّل الله للحسّاد لعنته","لكان أسقط منها فوقهم كسفا",15,"ف",2,0],["لو عقلنا لما اختشى قط محسو","دون وقع الأذاة من حسّاد",16,"د",1,0],["لو عدانا منه وحاشاه برّ","لاكْتفينا من برِّه بالتغاضي",17,"ض",2,0],["لوعدِه من كرمِ ذكرِه","حتى إذا وفى فنسيانه",18,"ن",2,0],["لو علمتَ الخفيَّ من كلّ علمٍ","جامعاً بينه وبين البِغاءِ",19,"ا",2,0],["لو علمتَ الذي يُقاسي من الأَمْ","رين عَزّيتَه صباحَ مساءِ",20,"ا",2,0],["لو علِمتَ الذي بجسمي من السُّقْ","م وضُرِّ الهوى لكنت جوابي",21,"ي",1,0],["لو عدا صبرُها إلى إليتَيْها","كنتَ تحت السياط عين الجليدِ",22,"د",1,0],["لو عُقرتْ حول قبرها بقر ال","إنسِ مكان القِلاص والمُهَرِ",23,"ر",1,0],["لو عرضت شيراز صوَّارَها","وعِينها لانتابها الباعه",24,"ع",2,0],["لَو عادَ لِلدُنيا البُراقُ وَحُزنُهُ","ما كانَ إِلّا نَحوَهُ إِسرائي",25,"ا",2,0],["لَوعَةٌ في الضُلوعِ مِثلَ جَهَنَّمِ","تَرَكَت هَذِهِ الضُلوعَ رَمادا",26,"ا",1,1],["لَو عَلِموا أَنَّني عَدُوَّهُمُ","أَوشَكَ يَقضي عَلَيهُمُ الفَرَقُ",27,"ق",1,0],["لَو عَدَلَت فيهِمُ الشَرائِع","ما اِستَحدَثوا لِلقِتالِ الَه",28,"ه",1,0],["لَو عَرَفنا ما الَّذي قَبلَ الوُجود","لَعَرَفنا ما الَّذي بَعدَ الفَناء",29,"ا",2,0],["لَو عَلِمتُم مَحَلَّكُم","في فُؤادي لَسَرَّكُم",30,"م",1,0],["لو عاد ذلك كله لقى الهوى","حتى كأنه لم تطوِه الأعصار",31,"ر",1,0],["لَو عاشَ قُدوَتُهُمُ وَرَبُّ لِوائِهِم","نَكَسَ اللِواءَ لِثابِتٍ وَقّافِ",32,"ف",1,0],["لَو عِشتِ شِدتِ مِثلَها","لِلمَرأَةِ المُحَرَّرَه",33,"ر",2,0],["لَو عاشَ كانَ مُؤَمَّلاً لِمَواقِفٍ","يَرجو لَها الوادي كِرامَ شَبابِه",34,"ب",2,0],["لَو عَرَفوهُ عَرَفوا","مِنَ البَلاءِ أَكثَرَه",35,"ر",2,0],["لَو عَصَيتُمُ كاذِبِ اليَأسِ فَما","في صِباها يَنحَرُ النَفَسَ الضَجَر",36,"ر",1,0],["لَو عَدا عَنكِ غَيرَ هَجرِكِ بُعدٌ","لَأَرارَ الرَسيمُ مُخَّ المَناقي",37,"ق",2,0],["لَو عُدَّ فَتحُ المازِيارِ وَمِثلِهِ","أَفنى العِدادُ كَراسِفَ الأَنقاسِ",38,"س",1,0],["لَو عَلِموا مابِتَّ نَصباً لَهُ","أَصبَحتَ دُبّاً عِندَهُم أَكشَفا",39,"ف",2,0],["لَو عَصَرَت عُنقَ ظَليمٍ وَقَد","أَدخَلَ فيها رَأسَهُ ما اختَنَق",40,"ق",1,0],["لَوعَةٌ أفرَطَتْ فعادَتْ حَريقاً","وحَنينٌ أربَى فعادَ شَهيقا",41,"ق",2,0],["لو عاينت أملاك فارس حسنها","خرت لها أملاك فارس سجدا",42,"د",2,0],["لَو عَقَلنا إِذِ النَهارُ يَسوقُ ال","لَيلَ وَاللَيلُ إِذ يَسوقُ النَهارا",43,"ر",2,0],["لَو عَقَلنا ما نَرى لَانتَفَعنا","وَاعتَبَرنا بِالقُرونِ الخَوالي",44,"ي",1,0],["لَو عَلِمَ الناسُ كَيفَ أَنتَ لَهُم","ماتوا إِذا ما أَلِمتَ أَجمَعُهُم",45,"م",1,1],["لَو عَلِمَ الأَحياءُ ما عايَنَ ال","مَوتى إِذاً لَم يَستَلِذّوا الحَياة",46,"ا",2,0],["لَو عايَنَت مُقلَتُهُ دُخنَةً","لَاِستَرَقَ اللُبَّ مِنَ القِشرِ",47,"ر",1,1],["لو عاد ذاك الماءُ نفطاً أحرقت","في الجوّ منه قميصَ كلّ عنانِ",48,"ن",1,0],["لَو عايَنَ الدَجّالُ بَعضَ فَعالِهِ","لَاِنهَلَّ دَمعُ الأَعوَرِ الدَجّالِ",49,"ل",1,0],["لَو عايَنَ الأَسَدُ الضِرغامُ رُؤيَتَهُ","ما ليمَ أَن ظَنَّ رُعباً أَنَّهُ الأَسَدُ",50,"د",1,0],["لَو عايَناكَ لَقالا بَهجَةً جَذَلاً","أَبرَحتَ أَيسَرُ ما في العِرقِ أَن يَشِجا",51,"ج",2,0],["لَوْ عَزَوْنَا كُلَّ امْرِئٍ لأَبِيهِ","مِنْ فرَاخِ الْوَزَّانِ لَمْ يَبْقَ نَسْلُ",52,"ل",1,0],["لَو عِندَنا اِغتيبَ أَو نيلَت نَقيصَتُهُ","ما آبَ مُغتابُهُ مِن عِندِنا جَذِلا",53,"ل",2,0],["لَو عَلِمنا ما يُسَرُّ بِهِ","ما طَعِمنا البارِدَ الخَصِرا",54,"ر",2,0],["لَو عَلِمتِ الهَوى عَذَرتِ وَلَكِن","إِنَّما يَعذِرُ المُحِبَّ المُحِبُّ",55,"ب",1,0],["لَو عَظَّموا حُرُماتِ النيلِ ما اِضطَرَمَت","أَحقادُ قَلبٍ بِماءِ النيلِ رَيّانِ",56,"ن",1,0],["لَو عايَنَت صُوَرَ النُفوسِ عُيونُنا","لَم يَعدُها أَنَفٌ وَلا اِستِقباحُ",57,"ح",1,0],["لوعةٌ مشبوبةٌ في سَقَمٍ","في شآبيبَ من الدَّمعِ السخينْ",58,"ن",1,0],["لَوعَةٌ بي مِنكَ أَم بي لَمَمٌ","ما النُهى وَالحُبُّ إِلّا طَرَفانِ",59,"ن",1,0],["لوْ عُمِّرَ ابنُ المِعمار خَوَّلهُ","نِيَابَةَ الخِدْمَتَيْنِ والخُطْبَهْ",60,"ب",2,0],["لِوَعدِ يَومٍ لَيسَ فيهِ خُلفُ","حَتّى إِذا ما اِجتَمَعوا وَاِصطَفّوا",61,"ف",3,0],["لو عنّ لي قدرٌ يساعدُ صرفهُ","لرأيتِ كيف تعفّفي ووقاري",62,"ر",2,0],["لَو عاشَ حَمّادٌ لَهَونا بِهِ","لَكِنَّهُ صارَ إِلى النارِ",63,"ر",1,1],["لَو عَرَفتَ الرِئبالَ يابنَ خُلَيقٍ","لَتَنَصَّفتَ وَجهَهُ وَاِستَخَرتا",64,"ت",2,0],["لَو عايَنَتكَ كُماتُنا بِطُوالَةٍ","بِالحَزوَرِيَّةِ أَو بِلابَةِ ضَرغَدِ",65,"د",1,0],["لَو عاشَتِ الشَمسُ فينا أُلبِسَت ظُلَماً","أَو حاوَلَ البَدرُ مِنّا حاجَةً لِحَقرِ",66,"ر",1,0],["لَو عُجِّلَت لِغَويٍّ فاجِرٍ سَقرٌ","لَأُشعِروا جَمَراتِ النارِ تَحريقا",67,"ق",2,0],["لَو عُدتُ مِن أَسَدِ النُجومِ بِجَبهَةٍ","أَو بُتُّ في ذَنَبٍ لِشَبوَةِ شائِلِ",68,"ل",1,0],["لَو عَقَلَ الإِنسانُ رامَ الهُدى","وَلَم يَبِت في النَومِ سَدرانا",69,"ن",2,0],["لَو عَلِمَ العاذِلونَ سِرّي","لَأَصبَحَ القَومُ عاذِرِيّا",70,"ر",3,0],["لوْ عَرَفَ الإنْسانُ مقدارَهُ","لم يَفْخَر المولى على عَبْدِهِ",71,"د",2,0],["لو عاشَ زادكِ من غرائب فنّهِ","ما لا يُشَبّهُ حسنهُ بنظائرِ",72,"ر",1,0],["لَوْ عَلِمَ الإِنْسَانُ ما أَضْمَرَتْ","أَحْبَابُهُ هَانَتْ عَلَيْهِ الْعِدَا",73,"د",2,0],["لُوْ عَاشَ صَاحِبُهُمْ لَعَاشَ رَهِينَةً","مِنْ بَعْدِهَا لِلهَجْعَةِ السَّوْدَاءِ",74,"ا",2,0],["لَوْ عَلَوْا كَالمَدِّ فِي بَحْرٍ طَغى","ثُمَّ ظَنُّوهُ لعَادَ المَدُّ جَزْرَا",75,"ر",2,0],["لَوْ عَادَ مِمَّنْ خَلاَ أُنَاسٌ","لَعَادَ مَتْبُوعُهُمْ تِبيَعا",76,"ع",2,0],["لَوْ عُدَّ مَا فَعَلَتْ جَهَالَتُنَا بِنَا","لَمْ يُحْصِ أَكْثَرَهُ حِسَابُ الْحَاسِبِ",77,"ب",1,0],["لو عاد فرعون كانت من ذخائره","أو ختم الخلد كانت في خناصره",78,"ر",2,0],["لَو عاشَ لي عَبدُ الغنيّ هنا هنا","عيشي وَإِن فارَقت ريماً أَخمَصا",79,"ص",2,0],["لَو عِشتَ قامَ لِمَجدي","في كُلِّ أُفقٍ مَنارُ",80,"ر",1,0],["لَو عَلِمَت أُمّكَ أَلّا تَرى","وَجهَكَ ما أَزمَعتِ السُخطا",81,"ط",2,0],["لو عَرَفَ الإِنسانُ ما أجرُه","ما ضَنَّ بالنفْسِ على أَجْرِه",82,"ر",2,0],["لو علت للنجم نفسي لأتتْ","تقتفيها شدّةٌ هل من رَخاء",83,"ا",2,0],["لو عرفنا متى تكون المنايا؟","لانتظرناها مذ بلغنا الفطاما",84,"م",2,0],["لو عالج المصلحون \" الجوعَ \" ما فَسَدَتْ","أوضاعُنا ، هذه الفوضى من السغب",85,"ب",1,0],["لو عدَمتْه لبكتْ بأربعه","وأصبحتْ لفقده مفجَّعهْ",86,"ع",2,0],["لَوْ عِنْدَنَا کغْتِيبَ، أَوْ نِيلَتْ نَقِيصَتُهُ،","ماى بَ مغتابه من عندنا جذلا",87,"ل",2,0],["لو عزونا كلَّ امريءٍ لأبيهِ","منْ فراخِ الوزانِ ، لمْ يبقَ نسلُ",88,"ل",1,0]]}