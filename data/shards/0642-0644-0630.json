{"poems":[[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[484,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202083","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126408","الدوبيت"]],"verses":[["قُلْ ذا الفَتى حَضَر الِّلقا مَعنا وإنْ","أَبْطَا بهِ عنّا الزّمانُ وأخّرا",0,"ر",2,0],["قل ذلك اليوم والتاريخ يشهد لي","يوم سعيد خلسناه من الحقب",1,"ب",1,0],["قل ذا العَتْبُ كلُّه والتَّجَنِّي","لِمَ قُلْ لي فَلَسْتُ أعرفُ ذَنْبا",2,"ب",2,0],["قل ذاك والبعدى بنحو ذلك","وثمّ أوهنا وقل هنالكا",3,"ك",2,0],["قل ذاك حليف الشوق قد صيره","هجرانك شاهداً على صورة حي",4,"ي",1,0]]}