{"poems":[[65,"ولوعة بت أخفيها وأظهرها","https://www.aldiwan.net/poem45795.html","البسيط"],[65,"وعليلة الألحاظ ترقد عن","https://www.aldiwan.net/poem45900.html","أحذ الكامل"],[65,"وشادن نبهته والكرى","https://www.aldiwan.net/poem45925.html","السريع"],[65,"وليلة من ليالي الدهر صالحة","https://www.aldiwan.net/poem45945.html","البسيط"],[65,"تذكر الوصل فارفضت مدامعه","https://www.aldiwan.net/poem46128.html","البسيط"],[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[93,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[64,"كم ليلة بتنا وجدي عينه","https://www.aldiwan.net/poem52275.html","الكامل"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5379","البسيط"],[168,"ودعته حين لا تودعه","https://www.aldiwan.net/poem67882.html","المنسرح"],[216,"سر قاصدا سرعا يا حادي النجب","https://www.aldiwan.net/poem37918.html","البسيط"],[415,"وصاحب صاحبني في الصبا","https://www.aldiwan.net/poem31719.html","عموديه"],[415,"أيها الغافل كم هذا الهجوع","https://www.aldiwan.net/poem31878.html","الرمل"],[415,"إن لم أبح بهواك قلن لوائمي","https://www.aldiwan.net/poem32382.html","الكامل"],[463,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[558,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"],[558,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[563,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64108","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99971","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49623","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60842","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111284","البسيط"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144427","السريع"],[2948,"","https://poetry.dctabudhabi.ae/diwan/poem/198266","الرجز"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[585,"درج الهلال من الخباء","https://www.poetsgate.com/ViewPoem.aspx?id=161864",""],[5163,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=33950",""],[5273,"وجد","https://www.poetsgate.com/ViewPoem.aspx?id=144507",""],[5497,"جادت تودعني","https://www.poetsgate.com/ViewPoem.aspx?id=210242",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""]],"verses":[["ثُمَّ اِفتَرَقنا فأَغنَتنا مَباسِمُها","عَنِ البُروقِ وَأَجفاني عَنِ الديَمِ",0,"م",1,0],["ثُمَّ افْتَرَقنا حِينَ فَاجَأنَا","صُبْحٌ تَقاسَمَ ضَوءَهُ الحَدَقُ",1,"ق",1,0],["ثُمَّ افْتَرَقْنا وَكِلانا شَجٍ","لَهُ فُؤادٌ بِالأَسى يَعْتَرِفْ",2,"ف",1,0],["ثُمَّ افْتَرَقْنا وَبُرْدِي في مَعاطِفِهِ","تُقىً يُعانِقُ فيهِ العِفَّةَ الكَرَمُ",3,"م",1,0],["ثمّ افتَرَقْنا وقد بَثَّ الصّباحُ سَناً","جابَتْ رِداءَ الدُّجى عنّا لوامِعُهُ",4,"ع",2,0],["ثمَّ افْتَرَقْنا والرَّقيبُ يَروعُ بي","أسَداً يوَدِّعُهُ غَزالٌ أحْوَرُ",5,"ر",1,0],["ثُمَّ اِفتَرَقنا ضاحِكَينِ إِلى غَدٍ","وَالشُهبُ تَهمِسُ فَوقَنا وَتُشيرُ",6,"ر",1,0],["ثمَّ افترقنا والدموعُ سواكِبٌ","والصبحُ طَلْقٌ وجههُ بسَّامُ",7,"م",1,0],["ثُمَّ اِفتَرَقنا لا لِعَودَةِ صُحبَةٍ","حَتّى كَأَنّا شُعلَةٌ وَزِنادُ",8,"د",1,0],["ثُمَّ اِفتَرَقنا عَلى سُخطٍ وَمَعتَبَةٍ","وَكَيفَ يَتَّفِقُ اللوطِيُّ وَالزاني",9,"ن",2,0],["ثُمَّ اِفتَرَقنا وَفي القُلوبِ لَنا","ضيقُ مكانٍ وَفي الدُموعِ سَعَه",10,"ه",1,0],["ثم افترقْنَا وصارَ البينُ ينعقُ في","آثارِنا بقبيحِ الزَجْرِ والنَعَبِ",11,"ب",1,0],["ثم افترقنا لم أصب مثله","عمري ومثلي أبداً لا يصيب",12,"ب",1,0],["ثمَّ أفضَتْ مدّةُ الشَّيبِ إلى","هرمٍ يَعقُبه الموتُ الذّريعُ",13,"ع",1,0],["ثم افْتَرقْنا بغتةً فَإذا الّذي","كُنّا نُسرُّ به فُكاهَةُ حَالِمِ",14,"م",1,0],["ثم افترقنا ومعي وثيقةٌ","تُقرِب ما بين الفراق واللقا",15,"ق",2,0],["ثُمَّ اِفتَرقنا وَلَم نَأثَم وَنَحنُ كَذا","نَهوى التَلاقي وَما مِن شَأنِنا الرِيَبُ",16,"ب",1,0],["ثُمَّ اِفتَرَقنا فَضَمَّنّا سَرائِرَنا","دونَ القُلوبِ وَفاءَ العَهدِ وَالخَطَرا",17,"ر",2,0],["ثم أفنت به النفوس وقامت","بتجلِّي صفاته الفتّانه",18,"ن",2,0],["ثم أُفردتُ منه بالرَّغم من أن","في فيا شوقَ مُغرَمٍ مشتاق",19,"ق",1,0],["ثُمَّ أَفْرَدْتَنِي خُصُوصاً بِبِرٍّ","مُفْرَدٍ طَاهِرٍ مِنَ التَّدْنِيسِ",20,"س",1,0],["ثم افترقنا كأَن لم نجتمع زمناً","ولا عهدنا لربع الحيّ عرفانا",21,"ن",2,0],["ثمَّ افترقنا وقد ساءت","ان اجتمعنا ولم تأثم ولم تخب",22,"ب",1,0],["ثم أفنى في مشهد الذّات حتى","يبدو المحو والفنا والبقاء",23,"ا",2,0],["ثم افترقنا فما من تلك لي خبَرُ","يا سُعّد أين حَدا الانضاء حاديها",24,"ي",3,0],["ثم افترقنا فكان الحظ سهم بني","عم لنا والمعالي سهم باقينا",25,"ن",2,0],["ثمّ افترقنا سَحَراً لم يكن","حالٌ وما ذاك لخوف الذُّنوبْ",26,"ب",1,0],["ثُمَ أَفئْتُ بعدَهَا مُستَقبِلَهْ","ولَمْ أضِعْ ما يَنْبَغي أنْ أفْعَلَهْ",27,"ل",2,0],["ثم افضنا قاصدين المشعرا","لنحمد الله به ونشكرا",28,"ر",2,0],["ثم أفاضوا أجمعين للحرم","طافوا وكل منهم الركن استلم",29,"م",1,0],["ثم افترقنا في الصباح","وناء في الصدر البلاء",30,"ا",2,0],["ثم افترقنا والزمانُ","من حولنا ظلماً يهيل",31,"ل",1,0],["ثمَّ أفتحي قاموسَ قلبِكِ إن","ني مِن فؤادِكِ أستقي لُغَتي",32,"ت",2,0],["ثم افترقنا فلا والله ما هجعت","مواجع الوجد والتحنان حاديها",33,"ي",3,0],["ثم افتخر فالسجن إن ضم الأبا","فهي الشهادة يا صغيري أحمدا",34,"د",2,0],["ثم افترقنا أو صحونا ، والدما","تنساب من تحت الثياب ، ثيابا",35,"ب",2,0]]}