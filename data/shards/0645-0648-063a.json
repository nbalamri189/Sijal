{"poems":[[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[4764,"مو غريبه","https://www.poetsgate.com/ViewPoem.aspx?id=26733",""],[4924,"انصفيني","https://www.poetsgate.com/ViewPoem.aspx?id=34872",""],[5388,"أقبل الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206922",""],[5431,"لن تضيع الأصول عند الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=196628",""],[5431,"مثل شمس لن تنطفي ياشآمُ","https://www.poetsgate.com/ViewPoem.aspx?id=197561",""],[5431,"لغتنا تتكلم ...","https://www.poetsgate.com/ViewPoem.aspx?id=201472",""],[5608,"إنتِ من جِدّك","https://www.poetsgate.com/ViewPoem.aspx?id=32979",""],[5956,"لوعة","https://www.poetsgate.com/ViewPoem.aspx?id=182154",""]],"verses":[["موغلاتٌ في كل فجّ من الأر","ضِ تفوتُ الرياحَ في الإيقالِ",0,"ل",1,0],["مُوغِلٌ في الشَّرِّ يسعى دائباً","وحَقودٌ لو تَزكَّى ما حقد",1,"د",1,0],["مُوغَراً صَدْرُهُ لِمَا سِيمَ فِي غَيْ","رِ جُنَاحٍ مِنْ جَفْوَةٍ وَاضْطِهَادِ",2,"د",1,0],["مُوغِلاً في البلادِ مُحتكماً في","حُرُمَاتِ الدماءِ والأَمْوال",3,"ل",1,0],["م وَغَوث للخائف المَطرود","كان نُوراً في العَرش زاه يَلوح",4,"ح",1,0],["مو غَريبه لو نَسيت الحُب وأقصيت الغَرام","حَتى رَبيع العُمر .. يَتليه .. الخَريف",5,"ف",1,1],["مو غريبه لو تِبدد عِشقنا مِثلِ المنام","كِلها كَانت حِكاية في الحقيقه مَحضِ طَيف !؟",5,"ف",1,0],["موغريبه ليه ما ارجع في كلامي","اعترافي بالخطا ما هو خطيه",6,"ي",2,0],["مُوغلَ الدُّجنِ مُخيفاً","فاغراً لِلبدرِ فاه",7,"ا",2,0],["موغلٌ في الخواء ظلٌ عليلٌ","اوقعتني حروبهم بالسهاد",8,"د",1,0],["موغلٌ في ازدرائه لست أُعنى","بصراعٍ يقوده الإيلامُ",9,"م",1,0],["موغلا في لذاذة الخلق شعرا","في معانٍ لم يغتصبها زكيّْ",10,"ي",1,0],["مو غرور اللي تشوفينه ترى هذا غِنا","لكن اللي مثلك انتِ صعبه تقرى كل ذهين",11,"ن",1,0],["مُوغِلاً عَبْرَ الصحارى","سائِلاً عَنْكَ البَشَرْ",12,"ر",1,0]]}