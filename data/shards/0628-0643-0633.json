{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[88,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[53,"يا عليلا جعل العلة","https://www.aldiwan.net/poem66011.html","مجزوء الرمل"],[48,"أرى ابن أبي إسحاق أسحقه الردى","https://www.aldiwan.net/poem22645.html","الطويل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[237,"بكسرة جفنيه رمز خفى","https://www.aldiwan.net/poem14848.html","المتقارب"],[287,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[1282,"","https://poetry.dctabudhabi.ae/diwan/poem/105279","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123174","الوافر"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74091","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5956,"يا من لديها الموهبات جزيلة","https://www.poetsgate.com/ViewPoem.aspx?id=193149",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["بِكَ سَدّوا فَوّارَ جائِشَةِ القَع","رِ لَها عائِدٌ يَرُدُّ السِبارا",0,"ر",2,0],["بِكِسرَةٍ وَكِساءٍ عِشتَ مُغتَبِطاً","تُسَبِّحُ اللَهَ في سِرٍّ وَإِعلانِ",1,"ن",1,0],["بِكَ سقمٌ في جفون","سقمها أكَّد سقمي",2,"م",2,0],["بِكُسوَةِ بُردٍ أَو بِإِعطاءِ بُلغَةٍ","مِنَ العَيشِ لا جَمِّ العَطاءِ وَلا غَمرِ",3,"ر",1,0],["بكسر ثالث وزيدك الأَلف","قبل الأخير كاعترافاً اعترف",4,"ف",1,0],["بِكَسرَةِ جَفنَيهِ رَمزٌ خَفى","إِلى الصَبِّ بِالكَمدِ المُتلَفِ",5,"ف",1,1],["بِكَ سُكّانُ دِمَشقَ اِفتَخَروا","فَخرَ عَدنانَ قَديماً بِالنَبِيِّ",6,"ي",1,0],["بكسر جناحي باضطراري بفاقتي","بذل خضوعي بالبقاع الضيائيه",7,"ي",2,0],["بكسرى كسيرا عند إرهاب رهبتي","محرك أفلاكي جرت حركاته",8,"ه",1,0],["بكسرويات إذا ما أشرقت","فهي شموس أشرقت في كنف",9,"ف",1,0],["بكسر النيل قد جُبر الوفاء","فمرّ تكدّري وحلا الصفاء",10,"ا",2,1],["بكسر قد أو بلحن الذكر","ويح ذوي الشرك ومن يتبعهم",11,"م",1,0],["بكسر قَلبي كاسِراً طرفه","فَهَل لِذاكَ الكسر من جابرِ",12,"ر",1,0],["بِكَسَّندَرا رَبَّةِ الحُسنِ هام","فخاطَبَ فِريامَ في ذا المَرام",13,"م",1,0],["بكسره وإجبار وعنف توعد","فعاد وقد باءوا بخيبة عائد",14,"د",1,0],["بك سوف نحيا بافتخارٍ مثلما","نحن افتخرنا بالفراسِ المُغْني",15,"ن",2,0],["بكسر حواجز التفريقِ كسراً","يُقاوم كل أنواع الجبورِ",16,"ر",1,0],["بك سيّدي هزأتْ، وساءَ فَعالُها","واللهُ يسمعُ قائلاً وفَعولا",17,"ل",2,0]]}