iewPoem.aspx?id=194161",""],[5290,"سريتم وطرفي من كرى العزم ما هبا","https://www.poetsgate.com/ViewPoem.aspx?id=113129",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188504",""],[5533,"أمَل","https://www.poetsgate.com/ViewPoem.aspx?id=186700",""],[5573,"من يفرش القاع يلقى ليلة لحافه","https://www.poetsgate.com/ViewPoem.aspx?id=200305",""],[5582,"أَلا حَدِّثانِي عَنْ رُسُومِ المَعاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63501",""],[5692,"صايح عند العصير إستهاضنا","https://www.poetsgate.com/ViewPoem.aspx?id=179113",""],[5756,"الجمهرة","https://www.poetsgate.com/ViewPoem.aspx?id=5430",""],[5829,"الحائر الصامد / لن أرحل","https://www.poetsgate.com/ViewPoem.aspx?id=175429",""],[6160,"صَقيعٌ لنبوءةٍ عارِية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87101&r=&rc=18",""]],"verses":[["مُنيفاً كَسَحلِ الهاجِرِيِّ تَضُمُّهُ","إِكامٌ وَيَعرَوري النِجادَ الغَوائِلا",0,"ل",2,0],["مَن يَفعَلِ الحَسَناتِ اللَهُ يَشكُرُها","وَالشَرُّ بِالشَرِّ عِندَ اللَهِ مِثلانِ",1,"ن",1,1],["مُنيفينَ مِن حَولِ اللِواءِ كَأَنَّهُم","لَهُ مَعقِلٌ فَوقَ المَعاقِلِ أَغلَبُ",2,"ب",1,0],["مُنيفٌ عَلى هامِ الرِجالِ إِذا مَشى","أَطالَ الخُطى بادي البَسالَةِ رائِعُ",3,"ع",1,0],["مُنيفٍ تَرى العِقبانَ تَقصُرُ دونَهُ","وَدونَ كُبَيداتِ السَماءِ مَناظِرُه",4,"ر",2,0],["مَن يَفعَلِ الخَيرَ لا يَعدَم جَوازِيَهُ","لا يَذهَبُ العُرفُ بَينَ اللَهِ وَالناسِ",5,"س",1,0],["مَن يَفقِدِ الحِسَّ لا يُعرَف بِمَخزِيَةٍ","إِنَّ الذُبابَ يَعلُ الجَنى يَنَمِ",6,"م",1,0],["مَنْ يَفْعَلِ الحَسَنَاتِ اللهُ يَشْكُرُهَا","والشَّرُّ بالشَّرِّ عِنْدَ اللهِ سِيَّانِ",7,"ن",1,1],["مُنيفان فوق الراسياتِ تَطاوُلا","تُقصِّرُ رَضْوَى عنهما وشَمام",8,"م",1,0],["من يفعل الخير لا يلقى سواه كما","من يفعل الشر يلق الشر في العقب",9,"ب",1,0],["مُنِيفٌ عَلَى هامِ الْمُسامِي كَأَنَّما","أطَلَّ مِنَ النَّشْزِ الْعَلِيِّ عَلَى وَهْدِ",10,"د",1,0],["مُنِيفٍ يَخِرُّ بِذَوْبِ اللُّجِيْنِ","عَلى ذَهَبٍ سَبْكُهُ الْمُخْلَصُ",11,"ص",1,0],["من يفكّرْ في ذنوبٍ","ساغها والعمر قالصْ",12,"ص",1,0],["من يفي للشعاع من بعد ما","ضحى وأحيا الموات والعبقريّه",13,"ي",2,0],["مُنىً فيك بلَّتْ يدي منذُ شِمْ","تُ عارضَها المُبرقَ المُرعِدا",14,"د",2,0],["منيفٌ من الأطواد في حال سلمه","وفي الحرب مصقول الغرارين قاطع",15,"ع",1,0],["منيف الذُّرى دحْضاً على غير أهلهِ","يَزِلُّ مَدى عَلْيائهِ بالمُفاخرِ",16,"ر",1,0],["مُنيف العُلى في ذروة المجد رائحٌ","مع الحمد يشْقى بالنَّوال عَواذلُهْ",17,"ل",2,0],["مُنيفُ المَجْدِ همَّتُهُ سَماءٌ","تُظِلُّ ومِنْ مَساعيهِ النُّجومُ",18,"م",1,0],["من يفعل الخير في عطفي مروءته","فعلَ النسيمِ مع الأشجار والغصن",19,"ن",1,0],["مُنيفاتٍ على الحاجِ","مَروقاتٍ عن العادِ",20,"د",1,0],["مَن يَفتخِرْ فبصالحِ العَمل الذي","كُنَّا نَعُدُّ لهُ الرَّئيسَ الأكبَرا",21,"ر",2,0],["مُنيفَ الأَعالي يَرقَدٌ مُتَبَسِّمٌ","أحمَّ الحَواشي رَعدُهُ مُتَزَرجِمُ",22,"م",1,0],["منْ يفعل الإحسانَ يُجْزَ بفِعْله","ويرى المسىءُ مع الجزاءِ جزاء",23,"ا",2,0],["من يفعلنْ خيرا يجد خيرا","ورب الشر يلْقى الشرَّ عاما بعد عام",24,"م",1,0],["منيف إذا الساري تسنمه اغتدى","كمرتقب خال الهلال فعلما",25,"م",2,0],["منيفٌ تسامى في السماءِ تخالهُ","جليساً إذا ما قابلته الفراقد",26,"د",1,0],["منيفة ثابتة صلبة","منيعة جانبها لا يرام",27,"م",1,0],["مُنِيفٌ بِإِسْمَاعِيلَ مَجْداً وَيُوسُفٍ","وَيَا لَكَ مَنْ مَجْدٍ لَهُ الْمَجْدُ هَائِبُ",28,"ب",1,0],["مُنيفٌ عَلَى كُلِّ المَصَانَعِ شَادَهُ","فَتَى الجُودِ وَالعَلْيَاءِ مِنْ نَسْلِ كَهْلاَنِ",29,"ن",1,0],["من يُفيدونَ المستفيدَ إذا ما","جلَتِ النارُ عن وجوهِ الغَواني",30,"ن",2,0],["من يفته البحر في سعة","يرتضى من بعد بالوشل",31,"ل",1,0],["مني فراهيد الذين ملوكهم","عموا وزادوا فوق فخر الفاخر",32,"ر",1,0],["مُنيفٌ إِذا سامى الرِجالَ تَضاءَلوا","لِاَروَعَ تَلهو بِالعُقولِ بَدائِعُه",33,"ع",2,0],["من يفكر شاف في الدنيا النكب","لو صفت بالعيش فاحذرها النكود",34,"د",1,0],["من يفتخر بجواده","فجيادنا عكازتان",35,"ن",1,0],["مني فخذ لك موقفاً","يا ابن المروءة بين أهلي",36,"ل",2,0],["منيفا على التل غض الجنى","يدور على قصره الأبلق",37,"ق",1,0],["مَنْ يفُدهم يَجزهِ الله به","وسيغني الله عمن لم يُفد",38,"د",1,0],["منيفاً على أنداده بذكائه","له من ثقوب الفهم ضوء شهاب",39,"ب",1,0],["من يَفُز أَنتِ زَوجُهُ وَمنُاهُ","وَعَلَيكِ الرِّهانُ كُلُّ الرِّهانِ",40,"ن",1,0],["مَن يَفز مِنهُ بِبَيتٍ فَيَعود","رَبَّ بَيتٍ ضوعفت ارباحهُ",41,"ه",1,0],["منى فدتك النفس اذ قضيتا","لم يك في نظير ما أديتا",42,"ت",2,0],["من يفزع الناس في الزورا برحمته","ان باغت الموحشان الظلم والظلم",43,"م",1,0],["مَنْ يَفْتَخِرْ انْ كانَ رَيانَ الغِنَى","يَسْقُطْ بهِ الفقرُ اذا المالُ انْتَفَى",44,"ا",1,0],["من يفترش عند التقيل ظله","متبردا احماه حر المضجع",45,"ع",1,0],["من يفهم همومك إذا قلت ياريت","من يجعلك للنفس غنوه وتاجي",46,"ج",2,0],["من يفعل المعروف يعدم أهله","ويضيع بين العالمين بلا مرا",47,"ر",2,0],["منيفة السوح فناها على","من ليس كفواً للقاها حرام",48,"م",1,0],["من يفهمِ الدنيا فإنَّ عزاءَهُ","أنَّ الحقيقةَ أحكَمتْ تزويرَها",49,"ر",3,0],["من يُفهمُ الأعرابَ أن عدَّوهم","يسخو لهم ممّا لهمْ.. تبَّ الغباءْ",50,"ا",2,0],["من يُفهم العربَ الأعرابَ غايتنا","مع الأعادي وهل يا عُربُ من رشدا",51,"د",2,0],["منْ يفضحُ الأسرارَ كلاَّ لم يَمتْ","إلاّ وسِرُّ شؤونهِ مفضُوحُ",52,"ح",1,1],["منيف على السبع الطباق علاؤهم","وإن سكنوا فيما يراه الورى التربا",53,"ب",2,0],["من يفعلِ الخيرَ بالدنيا له سررٌ","إذ تسمُ عليائه روحٌ تزاحمُها",54,"م",3,0],["من يفعلِ الخيرَ بالدنيا بلا ندم","تسمُ العلا رفعة ً روحٌ تزاحمُها",55,"م",3,0],["مَنْ يَفْرش دَرْبًا في خَيْرٍ","كَمْ يَكْبُر في عَيْنِ النَّاظِرْ!",56,"ر",1,0],["من يفرش القاع يلقى ليله لحافه","لا اقبل له البرد يفتح حضنه الدافي",57,"ف",2,0],["مُنِيفٌ تَسامَى فِي السَّماءِ تَخالُهُ","جَلِيساً إِذا قابَلْتَهُ لِلْفَراقِدِ",58,"د",1,0],["منيف على بنت العذي وجده","منيف وجده ضيغم بن منيف",59,"ف",1,0],["منيف اللي خيلنا تلتوي به","كما حجل ليدي تلتوي بعريف",59,"ف",1,0],["من يفتح لفرقاي باب أفك له عشرين باب","وأذا خويي مايقدر خوتي ما أقدره",60,"ر",2,0],["من يفقد بيتاً هل يرحل","لا يملك إلا أن يقتلْ",61,"ل",1,1],["من يفقد أسرته وبها","أطفال ونساء عزلْ",61,"ل",1,0],["من يفقد موطنه الغالي","هل يبحث عن وطن أجملْ",61,"ل",1,0],["مَنْ يَفْتحُ الأبوابَ فِينا خِلْسَةً","وَيُحَرِّرُ الأمَمَ الحُطَامَ العَارِبةْ",62,"ب",2,0]]}