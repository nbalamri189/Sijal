{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[93,"لا تحقر الدرهم من مسعد","https://www.aldiwan.net/poem11340.html","السريع"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[69,"بموت عبود ابن جبر","https://www.aldiwan.net/poem28747.html","مخلع البسيط"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[46,"هل قبلت من ناصح أمة","https://www.aldiwan.net/poem23534.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55101","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[158,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[187,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[283,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[295,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[295,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[400,"وقال واعجبا ما كنت أحسبه","https://www.aldiwan.net/poem33443.html","البسيط"],[400,"وافت هداياك التي مثلها","https://www.aldiwan.net/poem34101.html","السريع"],[441,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[451,"ما كان للعمال يوم لم يكن","https://www.aldiwan.net/poem61664.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["هَل قَدَمُ الطَودِ وَهيَ راسِخَةٌ","يُخافُ مِنها العِثارُ وَالزَلَلُ",0,"ل",1,0],["هَلْ قَامَ بِالمُعْظَمِ فِي كل مَا","يَعُمُّ بِالنَّفْعِ سِوَى المُعْظَمِ",1,"م",1,0],["هل قلتَ أخطأتم رماياكُمُ","لا يلتقي الشارقُ والغاربُ",2,"ب",1,0],["هَل قامَ قَبلَكَ في المَدائِنِ فاتِحٌ","غازٍ بِغَيرِ مُهَنَّدٍ وَسِنانِ",3,"ن",1,0],["هل قيسَ أوتارُ المزاهرِ غرَّدت","بالمنجنيق تُشدُّ بالأرسانِ",4,"ن",1,0],["هلْ قبرُهُ الروضُ أو سماءٌ","فالغصنُ والبدرُ حلَّ فيهِ",5,"ه",1,0],["هل قام لِلعُمْرانِ رُكنٌ لم يَقُمْ","منهم إليهِ مُخَرِّبٌ وَمُدَمِّرُ",6,"ر",1,0],["هَل قَبِلَت مِن ناصِحٍ أُمَّةٌ","تَغدو إِلى الفِصحِ بِصُلبانِها",7,"ن",3,1],["هَلْ قَصَّرَ المُتَشَفِّعُو","نَ مِنَ الضِّعَافِ بِطُولِ عُمْرِكْ",8,"ك",1,0],["هَلْ قَرَأْتُمْ شِعْرَهُ إِلاَّ وَقَدْ","خِلْتُمُ السِّحْرَ مِنَ الشِّعْرِ وَثَبْ",9,"ب",1,0],["هل قام فيهم صحابي يراقصهم","من آل هاشم أو من سائر العرب",10,"ب",1,0],["هَل قالهُ الشافعي في الأمّ ليس بهِ","أَو في الرِسالةِ أَو من أين جئت بهِ",11,"ب",2,0],["هل قام فيهم شاطحا","متمائلا حتى سكر",12,"ر",1,0],["هَل قائِمٌ عُذري لديكَ بما مَضى","منّي وَقَلبي بالخطوب يُشاكُ",13,"ك",1,0],["هَل قَضى حقَّ التَصابي كَلِفٌ","هو بالروح وحقِّ اللَهِ سَمحُ",14,"ح",1,0],["هل قال ربي هزي الكول من عنب","أم قال هزي بجذع النخل لو فهموا",15,"م",3,0],["هل قفة أو كرة قد أتتْ","من صدف فيها الذي قد هويت",16,"ت",1,0],["هل قام فينا قبله داع إلى","وطنية عربية التضريب",17,"ب",1,0],["هل قيمةُ الانسانِ إلاّ نفعهُ","حياً وميتاً قائداً ومقوَدا",18,"د",2,0],["هل قتلا في الله ممن كفرا","من أحد أو جرحا أو اسرا",19,"ر",2,0]]}