فَضَائِي.. وهَبْ لِي مِعْطَفًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=184668",""],[4829,"الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=34267",""],[4929,"لا تحسبِ الشعرَ نظماً أنت كاتبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203667",""],[5038,"أسحار الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=195420",""],[5112,"البدر الراحل","https://www.poetsgate.com/ViewPoem.aspx?id=212708",""],[5174,"تحيةُ مؤتمر المجلس الدولي للغة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=186006",""],[5206,"في الصديق والصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=187434",""],[5277,"نجوى قلم","https://www.poetsgate.com/ViewPoem.aspx?id=185263",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"ادْمَعْت َعينا ًمن دموعٍ خافيهْ","https://www.poetsgate.com/ViewPoem.aspx?id=188533",""],[5431,"متورطٌ بدم الجياع أنينك","https://www.poetsgate.com/ViewPoem.aspx?id=198134",""],[5431,"حسبي بأني وحسبك...","https://www.poetsgate.com/ViewPoem.aspx?id=208733",""],[5458,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=72391",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5582,"هَلْ قَدْ أَضاءَتْ شُمُوسٌ فِي المَحارِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186670",""],[5736,"أبكم","https://www.poetsgate.com/ViewPoem.aspx?id=203835",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[5861,"أكان بوذيا قاتلي يا ترى ..أم انه قد كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=191503",""],[5873,"خدع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215414",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""]],"verses":[["هَل قَدَمُ الطَودِ وَهيَ راسِخَةٌ","يُخافُ مِنها العِثارُ وَالزَلَلُ",0,"ل",1,0],["هَلْ قَامَ بِالمُعْظَمِ فِي كل مَا","يَعُمُّ بِالنَّفْعِ سِوَى المُعْظَمِ",1,"م",1,0],["هل قلتَ أخطأتم رماياكُمُ","لا يلتقي الشارقُ والغاربُ",2,"ب",1,0],["هَل قامَ قَبلَكَ في المَدائِنِ فاتِحٌ","غازٍ بِغَيرِ مُهَنَّدٍ وَسِنانِ",3,"ن",1,0],["هل قيسَ أوتارُ المزاهرِ غرَّدت","بالمنجنيق تُشدُّ بالأرسانِ",4,"ن",1,0],["هلْ قبرُهُ الروضُ أو سماءٌ","فالغصنُ والبدرُ حلَّ فيهِ",5,"ه",1,0],["هل قام لِلعُمْرانِ رُكنٌ لم يَقُمْ","منهم إليهِ مُخَرِّبٌ وَمُدَمِّرُ",6,"ر",1,0],["هَل قَبِلَت مِن ناصِحٍ أُمَّةٌ","تَغدو إِلى الفِصحِ بِصُلبانِها",7,"ن",3,1],["هَلْ قَصَّرَ المُتَشَفِّعُو","نَ مِنَ الضِّعَافِ بِطُولِ عُمْرِكْ",8,"ك",1,0],["هَلْ قَرَأْتُمْ شِعْرَهُ إِلاَّ وَقَدْ","خِلْتُمُ السِّحْرَ مِنَ الشِّعْرِ وَثَبْ",9,"ب",1,0],["هَلْ قَتَلَ الْيَوْمَ ابْنُ المَاضِيْ؟","لاَ أَدْرِيْ أَيُّهُمَا عَصْرِيْ",10,"ر",2,0],["هل قام فيهم صحابي يراقصهم","من آل هاشم أو من سائر العرب",11,"ب",1,0],["هَل قالهُ الشافعي في الأمّ ليس بهِ","أَو في الرِسالةِ أَو من أين جئت بهِ",12,"ب",2,0],["هل قام فيهم شاطحا","متمائلا حتى سكر",13,"ر",1,0],["هَل قائِمٌ عُذري لديكَ بما مَضى","منّي وَقَلبي بالخطوب يُشاكُ",14,"ك",1,0],["هَل قَضى حقَّ التَصابي كَلِفٌ","هو بالروح وحقِّ اللَهِ سَمحُ",15,"ح",1,0],["هل قال ربي هزي الكول من عنب","أم قال هزي بجذع النخل لو فهموا",16,"م",3,0],["هل قفة أو كرة قد أتتْ","من صدف فيها الذي قد هويت",17,"ت",1,0],["هل قام فينا قبله داع إلى","وطنية عربية التضريب",18,"ب",1,0],["هل قيمةُ الانسانِ إلاّ نفعهُ","حياً وميتاً قائداً ومقوَدا",19,"د",2,0],["هل قتلا في الله ممن كفرا","من أحد أو جرحا أو اسرا",20,"ر",2,0],["هل قُدّ من صخر فؤاد الدهر لم","يرحم من الطعن الشديد فؤادي",21,"د",2,0],["هل قربَ قائمكَ الذي بُوِّئتَه","ماءٌ يصاب فقالَ ما من مَشْربِ",22,"ب",1,0],["هَل قاسه بِسواه إلا جاهلٌ","في مَنطق بِنتيجة وَقِياس",23,"س",1,0],["هل قلت إلا مثل ما قالوه أم","راضي الدفاع بغير أجر جان",24,"ن",1,0],["هل قضى فانقضى الوداد وأمسى","مربع الضيف والسّراة حزينا",25,"ن",2,0],["هل قد أضرّ بكم جميل فعائلي","معكم وهل ساءتكمو حسناتي",26,"ت",2,0],["هل قلوب الأحباب فيها كقلبي","ودموع الجميع فيها كدمعي",27,"ع",2,0],["هل قام ميت بعوي","لٍ فوق قبر اجرد؟",28,"د",1,0],["هل قلبكَ اليوم عن شنباء منصرفُ","وأنت ما عشتَ مجنون بها كلفُ",29,"ف",1,1],["هَل قولُهُ بمشِيئَةٍ أم لاَ وَهَل","في ذَاتِهِ أم خَارِجٌ هَذَانِ",30,"ن",1,0],["هَل قَلبي مَوقد نِيرانٍ","أَم عَيني عزَّ تَبجُّسُها",31,"ه",2,0],["هل قال يا أبناء برقة مرة","حتى نرى في قوله التشعيبا",32,"ب",2,0],["هل قالها شاعر قبلي وهل حلمت","لبعضها كل دنيا الاختراعات",33,"ت",1,0],["هل قبل قومي بيض","تنقاد ذلا لسود",34,"د",1,0],["هل قبل قومي أناس","محكومة للقرود",34,"د",1,0],["هل قمتمو بفرض نسوتكم وهل","هذبتمو من طبعهن الأخرق",35,"ق",1,0],["هل قريبٌ أتى وهل زائرٌ جا","ءَ وهل كان مؤنِسٌ وضجيعُ",36,"ع",1,0],["هل قضت دين من قضى","في المحبين دينها",37,"ن",3,0],["هل قيل إن الخلق عاش بلا","قلوب في الصدور",38,"ر",1,0],["هل قبله رد الجرا","د سواه فيما قد غبر",39,"ر",1,0],["هَل قَرَّ إِلا مُذ حَواكَ سَريرُها","أَوراقَ إِلا فَوقَ راسِكَ تاجُها",40,"ه",2,0],["هل قبلتك الشمس تاركةً","في الوجه من قبلاتها أثرا",41,"ر",2,0],["هل قر مجد المصطفى","من بعد ما بلغ السماك",42,"ك",1,0],["هل قلتَ للطَّيْفِ لا يعاوِدُني","بَعْدَكَ أم قد وَفَى لك الحُلُمُ",43,"م",1,0],["هَل قَد سَمعتُم صَوتَنا بِقُصورِكُم","حَيث الكُؤوسُ مِن الهَناءِ تُدارُ",44,"ر",1,0],["هَل قارَضَك الحَبيب في خَلوَتِهِ","هَل مَرَّ هُنا ذكريَ بِالتَخصيصِ",45,"ص",1,0],["هَل قَهقَهَةُ الجام وَرَقصُ الحَبَبِ","إِلّا لِفَمٍ مُنِحتَه ذي شَنَبِ",46,"ب",1,1],["هل قنعت آل الأسواط هل سلبوا","منها المقانع بعد الخدر والحجب",47,"ب",1,0],["هل قامت الأخرى فاظلم أوجهاً","وأصيبت الدنيا بسهم منون",48,"ن",1,0],["هَل قَلدتك محاسن الانشاء","مِن جَوهر المَلَكوت عقد ضِياء",49,"ا",2,1],["هَل قَلَّ آلُ الوفا أم ذاكَ طالعنا","أَم قاسم الحظ تَبغي ذاك قسمتُهُ",50,"ت",2,0],["هل قرطه يخشى مفارقة","منه فلا ينفك منذعرا",51,"ر",2,0],["هل قد سمعتم ميتا","يشكو إليكم ما أصابه",52,"ب",2,0],["هل قَدَّرَ اللهُ فِيها أنْ نَمُوتَ ولا","نَدرِي لِما صارَ فِيها أو بها سَبَبَا؟!",53,"ب",2,0],["هَل قَاتِلِي أمْ قَتِيلِي صِرْتُ؟! لَستُ أرَى","فَرْقًا لِنِصْفَيَّ, كُلِّي طاشَ واقْتَنَصَا",54,"ص",2,0],["هل قومي قومي يال قومي اخبروا","قولوا لقومي ما قويت تجلدن",55,"ن",1,0],["هل قُدَّ قلبُكَ من صخرٍ فليسَ به","للحبِّ نبضٌ ولا للعشقِ أوتارُ ؟!",56,"ر",1,0],["هَلْ قَدَّتِ الْعُطْبولُ رِدْنَ قَميصِهِ","أَمْ قَدَّتِ الْوَلْهى نُهىً وَجِبالا",57,"ل",2,0],["هَلْ قَمَرٌ يَبْسِمُ إِنْ قَاسَى","مِمَّا قَاسَيْتَ مِنَ الْعُسْرِ؟",58,"ر",1,0],["هل قرأتم في كتاب ( العين) يا","معشر الفصحى وخلاني القداما",59,"م",2,0],["هَلْ قَد حَلَلْتَ عُقُودًا مِن أُخَوَّتِهِ","أمْ أَنتَ في شُغُلٍ بِالفِقْهِ ألْهَاكَا",60,"ك",2,0],["هل قد سئمتَ النوى من شجوِ هادلةٍ","هيّا أمطْ دمعَها عن وجهِ قافيتي",61,"ت",2,0],["هل قام في طهر ليرفع ذكره","( فالذكر للإنسان عمر ثاني )",62,"ن",2,0],["هل قاسيون يعوفُ يوما موطئي","أنَّى اتجهْتُ قصدْتُ داراً عاليهْ",63,"ي",2,0],["هل قصة الشعراء نزفُ قلوبهم ؟","أم أنّ عهدا مشرقا سيكونك؟؟",64,"ك",1,0],["هل قد أطيرُ انعداما؟","أم قد أوافق جذبك؟",65,"ك",1,0],["هل قاسيون سوى للعين حاجبها","يقظان يكلأ بالأهداب من ناموا",66,"م",3,0],["هل قلت شيئاً في الهوى قالت بلا","ما من مقام في الهوى حرم المقال",67,"ل",1,0],["هَلْ قَدْ أَضاءَتْ شُمُوسٌ فِي المَحارِيبِ","أَمْ هذِهِ أَوْجُهُ البِيضِ الرَّعابِيبِ",68,"ب",1,1],["هل قلتُ أني في غرامِكَ أبكمُ؟","ولسانُ حالي في الهوى متلعثمُ؟",69,"م",1,1],["هل قد تهجّى الدهرُ دعوى قاتلٍ","ينعاهُ موالٌ ورقصُ اللاطمة",70,"م",2,0],["هل قتل طفل ثورة","ام ظالم وتجبّرا",71,"ر",2,0],["هل قد أمنت الحادثات وريبها","أم أنّ ما يمضي لعمرك يوهبُ",72,"ب",1,0],["هل قلُبكم يا صاحباه دليلكم","ولدَيكَ في كشف النفوس مواهبُ؟",73,"ب",1,0],["هل قام معتصم يقود لدولة","سادت بإيمان وصدق مآثر",74,"ر",1,0],["هَل قَمَرٌ ذابَ بِمِرآتِها","أَمْ مُلِئتْ بالضَّوءِ قَارُورَتَانْ",75,"ن",1,0],["هل قرَّت الآنَ بالتدميرِ أعينُكُم","يا عُصبةَ الشرِّ ، هل أشبهتم البَشَرا ؟",76,"ر",2,0]]}