{"poems":[[74,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[45,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[47,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[63,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[92,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[107,"عهد لمصر من الحياة جديد","https://www.aldiwan.net/poem43166.html","الكامل"],[48,"ما غاب اسحاق البرايا عنهم","https://www.aldiwan.net/poem23044.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[108,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[102,"لافتة على طريق العيد العاشر لثورة سبتمبر","https://www.poetsgate.com/ViewPoem.aspx?id=50428",""],[119,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[164,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[173,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[173,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[242,"أكلنا يوم لمطتنا المريه","https://www.aldiwan.net/poem19753.html","الوافر"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[415,"لما رأيت صروف هذا","https://www.aldiwan.net/poem32056.html","مجزوء الكامل"],[422,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[438,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[447,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[463,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[466,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[519,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[543,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112460","السريع"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137727",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56292","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56252","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144076","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108708","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53133","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27429","الطويل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198484","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60845","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122492","الوافر"],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132665","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127014","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108170","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66349","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85245","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128931","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57975","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72976","البسيط"],[5064,"انكسَارات الخُشُوع","https://www.poetsgate.com/ViewPoem.aspx?id=199175",""],[5187,"هيا نتساقى","https://www.poetsgate.com/ViewPoem.aspx?id=29791",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5956,"سحُبٌ تفيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=208561",""],[5973,"إنني لا أطمئن إليه","https://www.poetsgate.com/ViewPoem.aspx?id=13766",""],[6032,"كم ليل العاشق ممتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=181516",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""]],"verses":[["لا نعتب الأيَّامَ كيفَ تقلَّبت","بالقاطنينَ وأنتَ من حسناتها",0,"ت",3,0],["لا نَعذُلُ المَرَضَ الَّذي بِكَ شائِقٌ","أَنتَ الرِجالَ وَشائِقٌ عِلّاتِها",1,"ت",3,0],["لا نَعدَمُ الطَولَ في رِضاهُ وَلا","نَخافُ حَيفَ الغُلُوِّ مِن غَضَبِه",2,"ب",2,0],["لا نَعْدَمَنْ غُرَّةَ الأميرِ فقد","أعدَمَ مِنْ جُودِ كَفِّهِ العَدَما",3,"م",2,0],["لا نعرِف الوِّد إلا أنَّه دنَفٌ","من الصبابةِ يعتاد المُحبينا",4,"ن",2,0],["لا نَعرِفُ اليَأسَ المُميتَ وَلا نَرى","أَنَّ الحَياةَ سَبيلُها مَسدودٌ",5,"د",1,0],["لا نَعلَمُ المَوتى تَهُمُّ بِكَرَّةٍ","لَكِنَّ أَحياءً تَرومُ لَحاقا",6,"ق",2,0],["لاَ نَعْرِفَ النَّوْمَ إِلاًّ خِلْسَةً غَضَبَاً","وَالحُرُّ إِنْ مَسَّهُ مَا سَاءَهُ غَضِبَا",7,"ب",2,0],["لأنعامها ودُّهُ صافيًا","ويا رُبَّ ودٍ بغير صفاء",8,"ا",2,0],["لا نعي كيف ابتدينا أو متى","كل ما نذكره أنا انتهينا",9,"ن",2,0],["لان عرف الدهر اللئام فانهم","معرفهم عند الكرام منكر",10,"ر",1,0],["لان عبادة الأصنام شيء","تراهم خير طرق الاستقامه",11,"م",2,0],["لِأَنَّ عُبابي دَفقَةٌ مِن عُبابِهِ","وَهَضبَةُ عِزّي تَلعَةٌ مِن هِضابِهِ",12,"ب",2,0],["لِأَنَّ عَلِيّاً جَدَّهُ عَمِّيَ الَّذي","يَطُولُ بِهِ بَيتي عَلى مَن يُطاوِلُ",13,"ل",1,0],["لِأَنَّ عَشَاءَنَا قَدْ ضَاقَ عَنَّا","فَكَمْ بَيْنَ الْعَشِيَّةِ وَالْغَدِيَّهْ",14,"ي",2,0],["لِأَنَّ عِفريباً أَتاني بِهِ","لِكُلِّ شَيطانٍ بِهِ حَصبُ",15,"ب",1,0],["لا نعمةٌ فيهِ تدو","مُ ولا تدومُ به البَلايا",16,"ا",3,0],["لانَ عطفاً مهفهفُ القدِّ قاسٍ","كلَّما زادَ قسوةً زدْتُ لينا",17,"ن",2,0],["لانَ عن فرطِ نشاطٍ ولكَمْ","شدّةٍ في القومِ عُدّتْ كسَلا",18,"ل",2,0],["لا نعمة وردت إلا بها صدرت","رقشاء من نقم تصميك بالغضض",19,"ض",1,0],["لأنعمَ بالحلوِ الحديثِ مُرنَّقاً","وبالحبِّ موفوراً وبالرّاحِ والثمر",20,"ر",1,0],["لأنعمٍ من حيثُ قابلتُها","يوما بوجهي تتلقانيا",21,"ي",2,0],["لا نَعمةٌ تبقى ولا نِقمةٌ","ولا غِنىً دامَ ولا فَقرُ",22,"ر",1,0],["لا نَعرِفُ الجَدْبَ إلّا عندَ غَيبَتِه","ولا نرى الغَيثَ إلّا حين نُبصِرُهُ",23,"ر",2,0],["لا نَعُدُّ الخَصمَ خَصما","حَربُه مثلُ السَّلام",24,"م",1,0],["لا نعمت أجفاننا بالكرى","ما لم نخضها بالحداد الرقاق",25,"ق",1,0],["لأن على بسط من لجين","ثواؤهم فاستطابوا الثوا",26,"ا",1,0],["لأن عداني زماني عندهم فلقد","ذممت لما عداني عنهم زمني",27,"ن",2,0],["لأن عدوي فيه بات مقهقراً","وقد رُدّ مخذولاً ذليلاً إلى ورا",28,"ر",2,0],["لأن عمامتي من فوق رأسي","لقد رويت ومنها الكل رطّبْ",29,"ب",1,0],["لإنعامِه في كلّ جيدٍ بجودِه","قلائدُ في جيدِ الزّمانِ لها سِمْطُ",30,"ط",1,0],["لا نَعبد الأَصنام وَالأَوثانا","وَلا نَرى الظُلم وَلا العُدوانا",31,"ن",2,0],["لا نعبد المحسوس ذاتاً كل مح","سوس حدوث ذاته متألفه",32,"ف",2,0],["لا نعرف السحر إلا من يراعته","ولا فتى بسوى ألفاظه سحرا",33,"ر",2,0],["لا نعيم النعمان دام ولا الب","وس فسل عنه إن أجاب السدير",34,"ر",1,0],["لا نعتَ اشرفُ من علمٍ يفوزُبه","يقولُ مَن فاته يا خيبةَ العمر",35,"ر",1,0],["لا نِعْمَةٌ إلاّ لَهُ لاَ قُوَّةٌ","إلاّ بِهِ لاَ فَاعِلٌ الاّهُ",36,"ا",2,0],["لأنَّ عندي فرساً","مِنْ خيل أهلِ الأدب",37,"ب",1,0],["لا نعمت عين ترى دين الهدى","مستهضماً تروي من النومات",38,"ت",1,0],["لأنَّ عليه نذراً أَن تروَّى","أسنَّتهُ الشَّوائِكُ والسِّهامُ",39,"م",1,0],["لأنّ عليّا له جوهر","سما في الهدى فهو لب اللباب",40,"ب",1,0],["لأن عاد مسلوب الثياب مجردا","فللحمد ابراد له ومطارف",41,"ف",1,0],["لأن عاد شمل الهم مجتمعاً بهم","فقد راح شمل الصبر وهو مفرق",42,"ق",1,0],["لا نعجبنّ فأنتَ نسل أريكة","سنت عليها المكرمات شرائعا",43,"ع",2,0],["لان عطفاً واغتدى قاسي الحشا","وحوى ردفاً به ضاق الغشا",44,"ش",2,0],["لانعدم الخير من والِيٍ أخى ثقةٍ","للشرع متبع بالحق أمار",45,"ر",1,0],["لا نعرف الواشي ولم","نعبأ بنمام شرير",46,"ر",1,0],["لأنَّ علمَ إلهي ليس تدركه","ضربُ الرمال ولا الحسبانُ بالشهب",47,"ب",1,0],["لأنّ عبد العزيز لما","مع ثاني اثنين دام ماكث",48,"ث",1,0],["لأنَّ عواصِفَ الدُّنيَا ستأتِي","إِلى المولَى مشَينَا بالركُّوعِ",49,"ع",1,0],["لا نعرفُ إلاّ أنَّ لنا","قلبينِ بحبّهما ارتاحا",50,"ح",2,0],["لأنعم باري الخلق قد كان زوجها","قديماً يميناً وهي كانت يسارها",51,"ر",3,0],["لانعى يامعنّى في هزيعٍ","شجيّات البلابل من غصيني",52,"ن",2,0],["لا نعرف الأسماء لكنْ قلْبُنا","يجري بأفضالٍ لكم تستشري",53,"ر",2,0],["لا..! نعم ..!لا..! لن اذوب شكي","فيه طول العمر في اذنيه",54,"ي",2,0],["لا نعرف كيف نخبئنا","وعيون الفجر لنا رصدُ",55,"د",1,0],["لِأَن عَوام الناس يَضني مَراسهم","إِذا ما حداهم خَوف ما ورعونها",56,"ن",3,0],["لأن عزيمتي خارت","تساوى الحسن والقبحُ",57,"ح",1,0]]}