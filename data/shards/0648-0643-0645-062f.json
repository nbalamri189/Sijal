","https://poetry.dctabudhabi.ae/diwan/poem/90817","الوافر"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18984","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73240","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136592",""],[4356,"","https://poetry.dctabudhabi.ae/diwan/poem/143368","الطويل"],[4393,"","https://poetry.dctabudhabi.ae/diwan/poem/124787","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72509","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4755,"مُكَاشَفَة","https://www.poetsgate.com/ViewPoem.aspx?id=207193",""],[463,"قضى دينَ سعدي طيفها المتأوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=14625",""],[4896,"في وجه العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=180880",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5050,"قضت أحسابنا ألا تدينا","https://www.poetsgate.com/ViewPoem.aspx?id=38191",""],[585,"سل الدار والأجيال هل طلع الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=161889",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5237,"حسامي ومنهاجي القويم وشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=113120",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5720,"أنا اليومَ","https://www.poetsgate.com/ViewPoem.aspx?id=215629",""],[5725,"لك ياحلوتي في القلب ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=192578",""],[5736,"شكواي","https://www.poetsgate.com/ViewPoem.aspx?id=208435",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""],[5977,"الوشاة","https://www.poetsgate.com/ViewPoem.aspx?id=212741",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[6229,"في سكون الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65187&r=&rc=13",""],[572,"أذَابَتْ قلبَهُ الزّفرهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9323&r=&rc=180",""]],"verses":[["وَكَم داخِلٍ ما بَينَنا بِنَميمَةٍ","تَقَطَّرَ لَمّا زاحَمَتهُ المَصاعِبُ",0,"ب",1,0],["وكم دُونَها منْ أتْلَعِ الجِيدِ شادِنٍ","مُهفْهَفِ مُسْتَنِّ الوِشاحَيْنِ أغْيَدِ",1,"د",1,0],["وَكَم داعٍ دَعا في الحَربِ بِاِسمي","وَناداني فَخُضتُ حَشا المُنادي",2,"د",2,0],["وَكَم دونَ بَيتِكَ مِن صَفصَفٍ","وَدَكداكِ رَملٍ وَأَعقادِها",3,"د",3,0],["وَكَم دونَ لَيلى مِن عَدُوٍّ وَبَلدَةٍ","وَسَهبٍ بِهِ مُستَوضِحُ الآلِ يَبرُقُ",4,"ق",1,0],["وَكَم دونَ بَيتِكَ مِن مَهمَهٍ","وَأَرضٍ إِذا قيسَ أَميالُها",5,"ل",3,0],["وَكَم دونَ بَيتِكَ مِن مَعشَرٍ","صُباةِ الحُلومِ عُداةٍ غُشُم",6,"م",1,0],["وَكَم دونَها مِن مَهمَهٍ وَمَفازَةٍ","وَكَم أَرضُ جَدبٍ دونَها وَلُصوصُ",7,"ص",1,0],["وَكَمَدَ النُّورُ فِمِنْ مُذْهَبٍ","إِلَى لُجَيْنِيٍّ إِلَى عَاتِمِ",8,"م",1,0],["وَكَم دافَعتُ مِن خَطِلٍ ظَلومٍ","وَأَشوَسَ في الحُكومَةِ ذي اِعتِراضِ",9,"ض",1,0],["وكم دون ليلى من عقاب قطعتها","شوامخ تضني كل سارٍ وسائر",10,"ر",1,1],["وكمْ دَعَوْتُك والعَزَّاءُ تَعْصبُني","وأنتَ غايةُ مَدْعَى كلِّ منْجُودِ",11,"د",1,0],["وَكَم دونَها مِن مَلعَبٍ وَمَفازَةٍ","تَظَلُّ بِها الوُرقُ الخِفافُ تَقَلَّبُ",12,"ب",1,0],["وَكَم دَرَّت مَكارِمُهُ لِعافٍ","كَما دَرَّت لِأَطفالٍ ثُدِيُّ",13,"ي",1,0],["وَكَم دونَ الثَوِيَّةِ مِن حَزينٍ","يَقولُ لَهُ قُدومي ذا بِذاكا",14,"ك",2,0],["وَكَم دونَها مِن عَطِفٍ في صَريمَةٍ","وَأَعداءِ قَومٍ يَنذُرونَ دَمي نَذرا",15,"ر",2,0],["وَكَم دائِبٍ يُعنى بِما لَيسَ مُدرِكاً","وَكَم وارِدٍ ما لَيسَ عَنهُ بِصادِرِ",16,"ر",1,0],["وَكَم دونَ أَبصا","رِها مِن حِجاب",17,"ب",1,0],["وَكَم دِيَةٍ تِمٍّ غَدَوتَ تَسوقُها","لَها أَثَرٌ في تالِدي غَيرُ تالِدِ",18,"د",1,0],["وَكَم دونَ لَيلى مِن عَدُوٍّ وَبَلدَةٍ","بِها لِلعِتاقِ الناجِياتِ بَريدُ",19,"د",1,0],["وَكَم دَولَةٍ لِلجَورِ مِن قَبلِ هَذِهِ","مَضَت وَاِنقَضَت عَنّا بِغَيرِ سَلامِ",20,"م",1,0],["وَكَم دُهِيَ المَرءُ مِن نَفسِهِ","فَلا تَأكُلَنَّ بِأَنيابِها",21,"ب",3,0],["وَكَمْ دعا وَمُحَيَّا الأرضِ مُكْتَئِبٌ","ثُمَّ انثَنَى وَله بِشْرٌ وتهليلُ",22,"ل",1,0],["وكم دونَ أرْوَى من كَميٍّ مُلأّمٍ","وشَعْبٍ شَتيتٍ بعدها لم يُلأّمْ",23,"م",1,0],["وَكَم دَثَرَت مَغانٍ مِن أُناسٍ","وَقَد ضاقَت بِذَي لَجَبٍ وَدَثرِ",24,"ر",1,0],["وَكَم دَرَسَت هَذي البَسيطَةُ عالَماً","وَعالَمُ جيلٍ مِن عَوائِدِهِ الدَرسُ",25,"س",1,0],["وَكَم دونَ سَلمى مِن عَدوٍّ وَبَلدَةٍ","يَحارُ بِها الهادي الخَفيفُ ذَلاذِلُه",26,"ل",2,0],["وَكَم درر لي في القَريض نظمتها","فَكانَت بجيد الدهر مثل عقود",27,"د",1,0],["وَكَمَدْحِهِ المَدْحُ الَّذِي","أَبَداً لَهُ ثَوبٌ قَشِيبُ",28,"ب",1,0],["وكم دُعِيتُ لبُستانٍ فجدَّد لي","وَجْداً وإن كان في مَعناه سَلْوَاتُ",29,"ت",1,0],["وَكَم دَعَت لَكَ العُلا","وَهوَ دُعاء مُشتَرك",30,"ك",1,0],["وكم دون هندٍ من عدوٍّ وبلدة","ٍ بها للعتاق الناجيات بريد",31,"د",1,0],["وَكَمْ دُونَها مِنْ عاطِفٍ في صرِيمةٍ","وَأعداءِ قَوْمٍ يَنذُرُونَ دَمي نَذْرَا",32,"ر",2,0],["وكم دجا الليل والركبان هاجعة","له الى القصد ارعاد وتصويت",33,"ت",1,0],["وكم دعي والصقال البيض عارية","فرد منها كليل الحد اصليت",33,"ت",1,0],["وَكَم دَاهِمٍ دَاهٍ تَلَقَّيتُ بَركَهُ","وَعَانَيتُهُ فَانقَادَ لِي بِعِنانِ",34,"ن",1,0],["وكم دعوة مضطرة قد أجابها","فنلت المنى منها ومن دونها النجم",35,"م",1,0],["وَكَم دُونَ سَلمَى مِن جِبالٍ وسَبسَبٍ","إِذا قَطَعَتهُ العِيسُ أَعرَضَ سَبسَبُ",36,"ب",1,0],["وَكم دولٍ يوماً عليهم تضافرت","فَخابت وما نالَت من الظفَرِ الظفرا",37,"ر",2,0],["وكم درارٍ فيكَ نظَّمتُها","تجلُّ أن تحسبَ أشعارا",38,"ر",2,0],["وكم دولةٍ جالت أمامكَ جولةً","وسيقَت كما ساقَ الشياهُ غرورها",39,"ر",3,0],["وكم دعوت بان الله يجمعنا","لكي افوز برؤيا وجهك الحسن",40,"ن",1,0],["وَكَم دَعَوتُ أَبا نَصرٍ لِحادِثَةٍ","جَلَّت فَما خارَ عَن نَصري وَلا صَدَفا",41,"ف",2,0],["وكم دَعوتُ وكم ذكّرتُ إخوتَنا","فما أحبّوا شفاءً من جُروحِهم",42,"م",1,0],["وَكَم دَعا بكما نَفسي فداؤكما","مستنصر فاِنثَنى بالنصر عَن عجل",43,"ل",1,0],["وَكَم دَفَعتُ الأَسى فيهِ بِالأَسى","وَلا مَرَدَّ لِما يَأَتي بِهِ القَدَرُ",44,"ر",1,0],["وَكَم دَعوَةٍ لِلمُصطَفى فيهِ حُقِّقَت","وَآمالُ مَن عادى الوَصِيَّ خَوائِبُ",45,"ب",1,0],["وَكم دِعِيٍّ عِندَما","يُنشَدُها يَلقى الخَجَل",46,"ل",1,0],["وكم دعوني إلى مراق","يصبو إليها هوى القلوبِ",47,"ب",1,0],["وكم دنفٍ بكاظمة سقيمٍ","ولكنْ من هوى طرف سقيم",48,"م",1,0],["وكم دَعَوْتُ وجُنحُ الليلِ مُنْسَدِلٌ","يَا لَيْلُ شَعْرِيَ يَغْشَى الليلَ أَمْ ظُلَمُكْ",49,"ك",1,0],["وكم دُونَ رحلي من قصورٍ مشيدَةٍ","تُحَرِّمُ من قرب المزار مَزَارَكِ",50,"ك",1,0],["وكم دلنا للخيف والليل أليل","عبير يحيينا وقد غطغط الركب",51,"ب",1,0],["وكم دنيٍّ وفي النعماء منقلب","وكم شريفٍ من الأقوام في سغب",52,"ب",1,0],["وكم دونهم لي من خلائقَ مُرّةٍ","إذا أنصفوها استثمروها جنىً يحلو",53,"ل",2,0],["وكم دون حُرّ القولِ من جِنح ليلةٍ","إذا أظلمتْ لم يورِ فيها سوى قَدحي",54,"ح",2,0],["وكم دولةٍ شاختْ وأنتَ لها أخٌ","وأُخرى تُرَيِّها وأنتَ لها أبُ",55,"ب",1,0],["وكم دون هندٍ رُضْتُ من ظَهرِ ليلةٍ","أشدَّ من الأخطارِ فيها ركوبُها",56,"ب",3,0],["وكم دينٍ جودٍ ما سواهم بشارعٍ","وداء نفاقٍ ما سواهم بحاسمِ",57,"م",1,0],["وكم دهتني خطوب قد تشيب بها","ذوائبي وسهام الفتك تختنق",58,"ق",1,0],["وكم دنوت لنبت الشيح أرعى به","عل مهاة يراها الجفن يسترق",58,"ق",1,0],["وكم دعتها ملوك العصر قبلكم","إلى المجير فلم تسمع ولم تجب",59,"ب",1,0],["وَكَم دونَ ذاكَ العارِض البارِق الَّذي","لَهُ اِشتَقَّت مِن وَجه اسيل مدامِعُه",60,"ع",2,0],["وكم دَاهشٍ قدَ حارَ في عظم موجهِ","ولم يدر ما معناهُ في المدّ والجزرِ",61,"ر",1,0],["وكم دموعٍ جَرَت من عين مُنتَحِبٍ","لم تَستَفِدْ عينُهُ منها سِوَى الرَّمدِ",62,"د",1,0],["وكم دَوِيَّةٍ قَفْرٍ","جَعَلْنَا جِسْرَهَا حَسْرَهْ",63,"ر",2,0],["وكم دروة من مزغل الموت أحرقت","بنيرانها جيش العداة الملمة",64,"ه",1,0],["وكم دولة شبت وشابت وأدبرت","فهل عاهد الغرب الزمان المداولا",65,"ل",2,0],["وكم ديون لي ... تقتضي","وعن غرامي فيك لا تسأل",66,"ل",1,0],["وكم دونها من سبسب دون طيه","سرى دونه زجر القلاص الرواسم",67,"م",1,0],["وكم دعا جاحدا فانقاد مستمعا","وكم هدى تائها لم يتبع الرسما",68,"م",2,0],["وكم دحا صنما لما محا ظلما","وكم شفى سقما لما وفي ألما",68,"م",2,0],["وكم دميم تعامت عن دمامته","ظلت تصانعه طورا وتطريه",69,"ي",2,0],["وَكَم دَفَعتَ خَطوباً كُنتَ تَصدمها","بالحلم وَالعَقل لا بِالبيض وَالأَسَلِ",70,"ل",1,0],["وكم دفعتَ بها في صدرِ نازلةٍ","طرحتَ منها عن اللاّجينَ ثَهلانا",71,"ن",2,0],["وكم دون ليلى من تنائف بيضها","صحيح بمدحي أمّة وفليق",72,"ق",1,0],["وكم دخيلٍ أتى مستجدياً فغدا","ربّ البلاد يقود الشّعب بالرّسن",73,"ن",1,0],["وكم دونها من مَهمَهٍ وتنوفَةٍ","ومن كاشحٍ قد جاء بعدي فأعقبا",74,"ب",2,0],["وكم دون ليلى بلدةٌ مُسبَطِرَّةٌ","تقودُ فلاها العِيسُ حَتَّى تَحَسَّرا",75,"ر",2,0],["وكم دم جرى من غير جرحٍ","وشمّ الطيب قد أجراهُ منها",76,"ن",3,0],["وَكَم دونَها مِن رُكنِ طَودٍ وَمَهمَهٍ","وَماء عَلى أَطرافِهِ الذِئبُ يَعسِلُ",77,"ل",1,0],["وكم دون النفوس المستفيده","إمارات تناديني شهود",78,"د",1,0],["وكم دقيقة دونها دقيقة","يحققها العارفون الاخيار",79,"ر",1,0],["وكم دنّ خمرٍ طربنا به","وعدنا له فوجدناه خلّ",80,"ل",1,0],["وكم دونهُ من صارمٍ ومثقّف","فيا من رأى بدراً بهذين يحجَبُ",81,"ب",1,0],["وَكَم دَمع عَيني حَسرة قَد أَسلته","عَلى النَحر حَتّى بَل دَمعي مَحملي",82,"ل",2,0],["وَكَم دَولَةٍ صاحَبتُها ناصِريةٍ","وَعاشَرتُ جَمعاً مِن رَحيبٍ وَمُرتَقِي",83,"ق",2,0],["وكم دُولٍ حاربتها غير مرةٍ","ففزت بسجنٍ كان شراً من الأسر",84,"ر",1,0],["وكم دارعات هدهد الموت عابثا","بقيّات ألواح لها ونمارق",85,"ق",1,0],["وكم دعت لي أمي وهى باكية","وكم دعا لي أبى يقظان يبتهل",86,"ل",1,0],["وكم دقت الاعناق كفي بمخذم","عليه نجيع الدارعين عقيد",87,"د",1,0],["وكم دانت له بالرغم قوم","تعاطت موثقا أن لا تدينا",88,"ن",2,0],["وَكَم دونَ لَيلى مِن فَلاةٍ كَأَنَّما","تَجَلَّلَ أَعلاها مُلاءً مُعَضَّلا",89,"ل",2,0],["وكَم دَم لكُم أسالوا هَدرا","وحُرّةِ قد هَتَكوها سِترا",90,"ر",2,0],["وكم دعا فألبى","إلى الصلاة القصيره",91,"ر",2,0],["وكم دستَ كنزاً بالخيول تركته","وعسجدُه رملٌ ورملُك عسجد",92,"د",1,0],["وَكَم دعوت الحمى فَلَم يرني","غير رسوم تخفى عَلى الرائي",93,"ا",2,0],["وكم دونَ سعدٍ من بلادٍ بليدةٍ","بها الشفق المحمر أدهى من الفجرِ",94,"ر",1,0],["وكم دني سما أوج الفخار بجد","هيهات لا باب فحر الفتى وبجد",95,"د",1,0],["وكم داعبوا منها غزالاً مغنجاً","وكم قطعوا منها الغصون القواطعا",96,"ع",2,0],["وَكَم دُون ما أَرجو رَددتُ مُعظَّماً","مِن الهَول بَل دافعت صَدر النَوائب",97,"ب",1,0],["وَكَم درّ عَلى وَثنٍ نثير","وَظبي صاده راعي الوعول",98,"ل",1,0],["وكم دليل ونص","لو شئت ألفا وجدتا",99,"ت",2,0],["وكم دونه للزهو باب بقفله","وللبغي أحراس وللتيه خندق",100,"ق",1,0],["وكم دلجة أردفتها إثر دلجة","وقد كثرت للجنِّ حولي هساهس",101,"س",1,0],["وَكَم درَّت دراريهِ وَدارَت","كُؤوسُ رَحيقِهِ بَينَ المَوالي",102,"ل",2,0],["وكم درر أهديتها لمحمد","فكنت كمن حلى الجمان جمانا",103,"ن",2,0],["وكم داوي كليما في كلام","به من كل معنى مستفاد",104,"د",1,0],["وَكَم دونَ بَيتِكَ مِن مَهمَهٍ","وَمِن أَسَدٍ جاحِرٍ في مَكى",105,"ا",1,0],["وَكَم دونَها مِن بَطنِ وادٍ نَباتُهُ","أَراكٌ تُغَنّيهِ الهَداهِدُ أَخضَرُ",106,"ر",1,0],["وكم دُمْيةٍ للحُسن فيها وصورةٍ","تروق وتمثالٍ من الحسن قد خُطَّا",107,"ط",2,0],["وَكَم دوُنَ الَمصارعِ من كمِيٍّ","صريعِ هوَىً ومن صَبٍّ كئيبِ",108,"ب",1,0],["وكم دمٍ أريقَ في كِناسه","لم يَتقّ الخلاقَ في إهراقه",109,"ق",2,0],["وكم دولةٍ قد كنتُ أرجو نُمُوَّها","فلما تناهَتْ صِرتُ أرجو زَوالها",110,"ل",3,1],["وَكَم دَمَّرُوا مِن مَربَع كَانَ آهِلاً","فَقَد تَرَكُوا الدارَ الأَنِيسَة بَلقَعا",111,"ع",2,0],["وَكَم دافَعوا عَن مَذهَبِ العَجزِ جُهدَهم","فَما غَسَلوا أَسواءَ تِلكَ المَذاهِبِ",112,"ب",1,0],["وكم دندنت من حول كورة مسمعي","لتبليغ ما أوحاه ربي إلى النحل",113,"ل",1,0],["وَكَم داسَها نَعلٌ عَلى أُمِّ رَأسِها","فَلَمّا تَوَلَّت أَقبَلَت وَهيَ خاضِعُ",114,"ع",1,0],["وكم داريتُ جرحا خوفَ عذلٍ","وكم عانيتُ من ألمٍ دفينِ",115,"ن",1,0],["وكَم دَرسٍ نَمُرُّ بهِ.. ولكنْ","وَقَانا اللهُ مِن فَهمِ الدُّرُوسِ",116,"س",1,0],["وكم دولة ٍ شاختْ وأنتَ لها أخٌ","وأخرى تربيها وأنتَ لها أبُ",117,"ب",1,0],["وكم دم تصدم الدنيا بشاعته","فيجرف الناس في سيل من الغضب",118,"ب",1,0],["وكم دعوةٍ ألحقت فيها تقبُّلت","وما خاب سؤلي وابتهالي ورغبتي",119,"ي",1,0],["وكم دانت له بالرغم قوم","تعاطت موثقا ألا تدينا",120,"ن",2,0],["وكم دولةٍ مرت بهم بعد دولةٍ","فكان سواءً عامرُ الربع والقفر",121,"ر",1,0],["وكم دونه من لمع برق إذا سنا","برامة وافى المرخ وهو كليل",122,"ل",1,0],["وكم دونه من مرجع متلدّد","له في دياجير الظلام أليل",122,"ل",1,0],["وكم دافع الله الكريم بذكرهم","عن الخلق من مكروهة ومبيرة",123,"ه",1,0],["وكم دهتنا ببدر لاح في افق","من العلوم الى اوج الكمال رقا",124,"ق",2,0],["وكم داعبتني حظوظٌ توارتْ","كأسراب حلْم محاهُ الشتاتُ",125,"ت",1,0],["وكم دفنتْ بانظاري بدورٌ","وانتِ فوق شمسي ما دفنتِ",126,"ت",1,0],["وكمْ ديستْ كراماتٌ وذُلّتْ","من القاماتِ منْ كانتْ هِضابا",127,"ب",2,0],["وكم دانت لها الأقوام صاغرة","وكم بزت فخارا من تحداها",128,"ا",3,0],["وكم دعاءٍ عليهم بات يُطْلِقُهُ","قلبٌ نقيٌّ طهورٌ ليس يَجترمُ",129,"م",1,0],["وكم دعوت له الرحمن في سحر","أن يبعد الهمّ فالأحزان أحزاني",130,"ن",2,0],["وَكَم دارَةٍ لِلحبِّ لَم تَبنِ سورَها","يَدٌ نَوَّرَت أَبراجَها الأسطُرُ الغُرُّ",131,"ر",1,0],["وكم دوحةٍ في الروض حال سوادُها","بأنوار بدرٍ شَعَّ بين المغارس",132,"س",1,0],["وكَمْ دوِّيّة ٍ قَفْرٍ","جَعَلْتُ أَجُرُّها حسرَة ْ",133,"ر",2,0]]}