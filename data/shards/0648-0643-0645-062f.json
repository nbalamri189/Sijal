{"poems":[[53,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[63,"إذا استلب النوم العنان من اليد","https://www.aldiwan.net/poem46176.html","الطويل"],[3,"إذا جحد الجميل بنو قراد","https://www.aldiwan.net/poem140.html",""],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[93,"زرت حمى الحسناء والشمس قد","https://www.aldiwan.net/poem11365.html","السريع"],[27,"ما أرضى بنصح بني كليب","https://www.aldiwan.net/poem5796.html","الوافر"],[72,"وكم دون ليلى من عقاب قطعتها","https://www.aldiwan.net/poem18979.html","الطويل"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[29,"هوى أم بشر أن تراني بغبطة","https://www.aldiwan.net/poem6067.html","الطويل"],[70,"يعز علي فقدك يا علي","https://www.aldiwan.net/poem42403.html","الوافر"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[28,"تذكر هذا القلب من شوقه ذكرا","https://www.aldiwan.net/poem5056.html","الطويل"],[49,"كأنك قد جاورت أهل المقابر","https://www.aldiwan.net/poem62081.html","الطويل"],[66,"شربنا سلافا بلا آنيه","https://www.aldiwan.net/poem38521.html","المتقارب"],[44,"قفوا جددوا من عهدكم بالمعاهد","https://www.aldiwan.net/poem30543.html","الطويل"],[22,"ألا طرقت هند الهنود وصحبتي","https://www.aldiwan.net/poem22008.html","الطويل"],[52,"ألا حبذا الناعي وأهلا ومرحبا","https://www.aldiwan.net/poem26691.html","الطويل"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[46,"يجل الملك عن نظم ونثر","https://www.aldiwan.net/poem22681.html","الوافر"],[46,"إذا ما أسن الشيخ أقصاه أهله","https://www.aldiwan.net/poem22779.html","الطويل"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[22,"ألا طرقت هندُالهنود وصحبتي","https://www.poetsgate.com/ViewPoem.aspx?id=19727",""],[28,"تذكر هذا القلب من شوقه ذكرا","https://www.poetsgate.com/ViewPoem.aspx?id=21586",""],[115,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[132,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[150,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[181,"ألا هل لأيام تولين مطلب","https://www.aldiwan.net/poem58840.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[199,"يا طير ما للنوم قد طارا","https://www.aldiwan.net/poem45627.html","السريع"],[199,"أراك الحمى هل قبلتك ثغورها","https://www.aldiwan.net/poem45651.html","الطويل"],[210,"ليهنك العود نحو الأهل والوطن","https://www.aldiwan.net/poem13515.html","البسيط"],[235,"لم يبق فيك لمشتاق إذا وقفا","https://www.aldiwan.net/poem31816.html","البسيط"],[270,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[271,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[366,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[393,"أيعسوب دين الله صنو نبيه","https://www.aldiwan.net/poem53623.html","الطويل"],[393,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[405,"أحمد ربي على ضياء","https://www.aldiwan.net/poem49428.html","مخلع البسيط"],[416,"أفي الطلل الحديث أو القديم","https://www.aldiwan.net/poem54063.html","الوافر"],[439,"من سبي سيبك مما أنبتت نعمك","https://www.aldiwan.net/poem34790.html","البسيط"],[439,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[441,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[441,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[458,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[458,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[464,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[482,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[515,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[516,"سرى الهم تثنيني إليك طلائعه","https://www.aldiwan.net/poem48660.html","الطويل"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[562,"من عاش في الأرض لا يخلو من الكمد","https://www.aldiwan.net/poem52790.html","البسيط"],[567,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"]],"verses":[["وَكَم داخِلٍ ما بَينَنا بِنَميمَةٍ","تَقَطَّرَ لَمّا زاحَمَتهُ المَصاعِبُ",0,"ب",1,0],["وكم دُونَها منْ أتْلَعِ الجِيدِ شادِنٍ","مُهفْهَفِ مُسْتَنِّ الوِشاحَيْنِ أغْيَدِ",1,"د",1,0],["وَكَم داعٍ دَعا في الحَربِ بِاِسمي","وَناداني فَخُضتُ حَشا المُنادي",2,"د",2,0],["وَكَم دونَ بَيتِكَ مِن صَفصَفٍ","وَدَكداكِ رَملٍ وَأَعقادِها",3,"د",3,0],["وَكَم دونَ لَيلى مِن عَدُوٍّ وَبَلدَةٍ","وَسَهبٍ بِهِ مُستَوضِحُ الآلِ يَبرُقُ",4,"ق",1,0],["وَكَم دونَ بَيتِكَ مِن مَهمَهٍ","وَأَرضٍ إِذا قيسَ أَميالُها",5,"ل",3,0],["وَكَم دونَ بَيتِكَ مِن مَعشَرٍ","صُباةِ الحُلومِ عُداةٍ غُشُم",6,"م",1,0],["وَكَم دونَها مِن مَهمَهٍ وَمَفازَةٍ","وَكَم أَرضُ جَدبٍ دونَها وَلُصوصُ",7,"ص",1,0],["وَكَمَدَ النُّورُ فِمِنْ مُذْهَبٍ","إِلَى لُجَيْنِيٍّ إِلَى عَاتِمِ",8,"م",1,0],["وَكَم دافَعتُ مِن خَطِلٍ ظَلومٍ","وَأَشوَسَ في الحُكومَةِ ذي اِعتِراضِ",9,"ض",1,0],["وكم دون ليلى من عقاب قطعتها","شوامخ تضني كل سارٍ وسائر",10,"ر",1,1],["وكمْ دَعَوْتُك والعَزَّاءُ تَعْصبُني","وأنتَ غايةُ مَدْعَى كلِّ منْجُودِ",11,"د",1,0],["وَكَم دونَها مِن مَلعَبٍ وَمَفازَةٍ","تَظَلُّ بِها الوُرقُ الخِفافُ تَقَلَّبُ",12,"ب",1,0],["وَكَم دَرَّت مَكارِمُهُ لِعافٍ","كَما دَرَّت لِأَطفالٍ ثُدِيُّ",13,"ي",1,0],["وَكَم دونَ الثَوِيَّةِ مِن حَزينٍ","يَقولُ لَهُ قُدومي ذا بِذاكا",14,"ك",2,0],["وَكَم دونَها مِن عَطِفٍ في صَريمَةٍ","وَأَعداءِ قَومٍ يَنذُرونَ دَمي نَذرا",15,"ر",2,0],["وَكَم دائِبٍ يُعنى بِما لَيسَ مُدرِكاً","وَكَم وارِدٍ ما لَيسَ عَنهُ بِصادِرِ",16,"ر",1,0],["وَكَم دونَ أَبصا","رِها مِن حِجاب",17,"ب",1,0],["وَكَم دِيَةٍ تِمٍّ غَدَوتَ تَسوقُها","لَها أَثَرٌ في تالِدي غَيرُ تالِدِ",18,"د",1,0],["وَكَم دونَ لَيلى مِن عَدُوٍّ وَبَلدَةٍ","بِها لِلعِتاقِ الناجِياتِ بَريدُ",19,"د",1,0],["وَكَم دَولَةٍ لِلجَورِ مِن قَبلِ هَذِهِ","مَضَت وَاِنقَضَت عَنّا بِغَيرِ سَلامِ",20,"م",1,0],["وَكَم دُهِيَ المَرءُ مِن نَفسِهِ","فَلا تَأكُلَنَّ بِأَنيابِها",21,"ب",3,0],["وَكَمْ دعا وَمُحَيَّا الأرضِ مُكْتَئِبٌ","ثُمَّ انثَنَى وَله بِشْرٌ وتهليلُ",22,"ل",1,0],["وكم دونَ أرْوَى من كَميٍّ مُلأّمٍ","وشَعْبٍ شَتيتٍ بعدها لم يُلأّمْ",23,"م",1,0],["وَكَم دَثَرَت مَغانٍ مِن أُناسٍ","وَقَد ضاقَت بِذَي لَجَبٍ وَدَثرِ",24,"ر",1,0],["وَكَم دَرَسَت هَذي البَسيطَةُ عالَماً","وَعالَمُ جيلٍ مِن عَوائِدِهِ الدَرسُ",25,"س",1,0],["وَكَم دونَ سَلمى مِن عَدوٍّ وَبَلدَةٍ","يَحارُ بِها الهادي الخَفيفُ ذَلاذِلُه",26,"ل",2,0],["وَكَم درر لي في القَريض نظمتها","فَكانَت بجيد الدهر مثل عقود",27,"د",1,0],["وَكَمَدْحِهِ المَدْحُ الَّذِي","أَبَداً لَهُ ثَوبٌ قَشِيبُ",28,"ب",1,0],["وكم دُعِيتُ لبُستانٍ فجدَّد لي","وَجْداً وإن كان في مَعناه سَلْوَاتُ",29,"ت",1,0],["وَكَم دَعَت لَكَ العُلا","وَهوَ دُعاء مُشتَرك",30,"ك",1,0],["وكم دون هندٍ من عدوٍّ وبلدة","ٍ بها للعتاق الناجيات بريد",31,"د",1,0],["وَكَمْ دُونَها مِنْ عاطِفٍ في صرِيمةٍ","وَأعداءِ قَوْمٍ يَنذُرُونَ دَمي نَذْرَا",32,"ر",2,0],["وكم دجا الليل والركبان هاجعة","له الى القصد ارعاد وتصويت",33,"ت",1,0],["وكم دعي والصقال البيض عارية","فرد منها كليل الحد اصليت",33,"ت",1,0],["وَكَم دَاهِمٍ دَاهٍ تَلَقَّيتُ بَركَهُ","وَعَانَيتُهُ فَانقَادَ لِي بِعِنانِ",34,"ن",1,0],["وكم دعوة مضطرة قد أجابها","فنلت المنى منها ومن دونها النجم",35,"م",1,0],["وَكَم دُونَ سَلمَى مِن جِبالٍ وسَبسَبٍ","إِذا قَطَعَتهُ العِيسُ أَعرَضَ سَبسَبُ",36,"ب",1,0],["وَكم دولٍ يوماً عليهم تضافرت","فَخابت وما نالَت من الظفَرِ الظفرا",37,"ر",2,0],["وكم درارٍ فيكَ نظَّمتُها","تجلُّ أن تحسبَ أشعارا",38,"ر",2,0],["وكم دولةٍ جالت أمامكَ جولةً","وسيقَت كما ساقَ الشياهُ غرورها",39,"ر",3,0],["وكم دعوت بان الله يجمعنا","لكي افوز برؤيا وجهك الحسن",40,"ن",1,0],["وَكَم دَعَوتُ أَبا نَصرٍ لِحادِثَةٍ","جَلَّت فَما خارَ عَن نَصري وَلا صَدَفا",41,"ف",2,0],["وكم دَعوتُ وكم ذكّرتُ إخوتَنا","فما أحبّوا شفاءً من جُروحِهم",42,"م",1,0],["وَكَم دَعا بكما نَفسي فداؤكما","مستنصر فاِنثَنى بالنصر عَن عجل",43,"ل",1,0],["وَكَم دَفَعتُ الأَسى فيهِ بِالأَسى","وَلا مَرَدَّ لِما يَأَتي بِهِ القَدَرُ",44,"ر",1,0],["وَكَم دَعوَةٍ لِلمُصطَفى فيهِ حُقِّقَت","وَآمالُ مَن عادى الوَصِيَّ خَوائِبُ",45,"ب",1,0],["وَكم دِعِيٍّ عِندَما","يُنشَدُها يَلقى الخَجَل",46,"ل",1,0],["وكم دعوني إلى مراق","يصبو إليها هوى القلوبِ",47,"ب",1,0],["وكم دنفٍ بكاظمة سقيمٍ","ولكنْ من هوى طرف سقيم",48,"م",1,0],["وكم دَعَوْتُ وجُنحُ الليلِ مُنْسَدِلٌ","يَا لَيْلُ شَعْرِيَ يَغْشَى الليلَ أَمْ ظُلَمُكْ",49,"ك",1,0],["وكم دُونَ رحلي من قصورٍ مشيدَةٍ","تُحَرِّمُ من قرب المزار مَزَارَكِ",50,"ك",1,0],["وكم دلنا للخيف والليل أليل","عبير يحيينا وقد غطغط الركب",51,"ب",1,0],["وكم دنيٍّ وفي النعماء منقلب","وكم شريفٍ من الأقوام في سغب",52,"ب",1,0],["وكم دونهم لي من خلائقَ مُرّةٍ","إذا أنصفوها استثمروها جنىً يحلو",53,"ل",2,0],["وكم دون حُرّ القولِ من جِنح ليلةٍ","إذا أظلمتْ لم يورِ فيها سوى قَدحي",54,"ي",1,0],["وكم دولةٍ شاختْ وأنتَ لها أخٌ","وأُخرى تُرَيِّها وأنتَ لها أبُ",55,"ب",1,0],["وكم دون هندٍ رُضْتُ من ظَهرِ ليلةٍ","أشدَّ من الأخطارِ فيها ركوبُها",56,"ب",3,0],["وكم دينٍ جودٍ ما سواهم بشارعٍ","وداء نفاقٍ ما سواهم بحاسمِ",57,"م",1,0],["وكم دهتني خطوب قد تشيب بها","ذوائبي وسهام الفتك تختنق",58,"ق",1,0],["وكم دنوت لنبت الشيح أرعى به","عل مهاة يراها الجفن يسترق",58,"ق",1,0],["وكم دعتها ملوك العصر قبلكم","إلى المجير فلم تسمع ولم تجب",59,"ب",1,0],["وَكَم دونَ ذاكَ العارِض البارِق الَّذي","لَهُ اِشتَقَّت مِن وَجه اسيل مدامِعُه",60,"ع",2,0],["وكم دَاهشٍ قدَ حارَ في عظم موجهِ","ولم يدر ما معناهُ في المدّ والجزرِ",61,"ر",1,0],["وكم دموعٍ جَرَت من عين مُنتَحِبٍ","لم تَستَفِدْ عينُهُ منها سِوَى الرَّمدِ",62,"د",1,0],["وكم دَوِيَّةٍ قَفْرٍ","جَعَلْنَا جِسْرَهَا حَسْرَهْ",63,"ر",2,0]]}