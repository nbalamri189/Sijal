173",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5644,"لا تكن مابين بين","https://www.poetsgate.com/ViewPoem.aspx?id=211089",""],[5720,"المتْرفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205536",""],[5736,"إذا جاء الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=203891",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[5956,"أُعاتب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183227",""],[6048,"عبيرُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197759",""],[6079,"بمَولدكِ المَهنى","https://www.poetsgate.com/ViewPoem.aspx?id=207844",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[1706,"في بطحاء مكة","https://www.poetsgate.com/ViewPoem.aspx?id=102862",""],[6152,"يارب خيرة","https://www.poetsgate.com/ViewPoem.aspx?id=202759",""],[5309,"أعظم الناس من يبوح بعاره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573851",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6166,"رسالة من المدينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7281&r=&rc=1",""],[6171,"أميرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86321&r=&rc=1",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""],[6336,"لقاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73564&r=&rc=25",""],[5567,"ارحموني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82102&r=&rc=143",""]],"verses":[["فَأَسالَ فيها نَفَسَهُ","وَالنَفَسُ تَبلُغُ مُنتَهاها",0,"ا",3,0],["فاسْأَلْ دِيَارَ الْغَادِرِينَ فَإِنَّهَا","لَمُجِيبَةٌ أَطْلاَلُهَا مَنْ يَسْأَلُ",1,"ل",1,0],["فَاِسأَلوا عَنها الثُرَثّا لا الثَرى","إِنَّها تَحتَلُّ أَبراجَ الهِمَم",2,"م",1,0],["فاِسأل بَلَنسِيةً ما شَأنُ مرسِيَةٍ","وَأَينَ شاطِبة أَم أَينَ جيّانُ",3,"ن",1,0],["فاسألْ ببدرٍ عن مواقف بأسهم","فهم تَلافَوْا أمره ببدارِ",4,"ر",1,0],["فَأَسْأَلُ اللهَ ربَّ العرش من لُطُفٍ","يسري إليك بها أنعام مقتدرِ",5,"ر",1,0],["فأسألَنّ الغرب عمّا ثَبَتا","في ربوعٍ خَلَّفوها دُرُس",6,"س",1,0],["فَاِسأَل غَمامَةَ بِالخَيلِ الَّتي شَهِدَت","كَأَنَّهُم يَومَ تَيمِ اللاتِ غُيّابُ",7,"ب",1,0],["فَاِسأَل أَقَومُكَ أَم قَومي هُمُ ضَرَبوا","هامَ المُلوكِ وَأَهلُ الشِركِ أَحزابُ",7,"ب",1,0],["فَاِسأَل تَميماً مَنِ الحامونَ ثَغرَهُمُ","وَالواجِلونَ إِذا ما قُعقِعَ البابُ",7,"ب",1,0],["فَاِسأَل جَحاجِحَ مِن قُرَيشٍ إِنَّهُم","تَلقى لِحُكمِهِم هُدىً وَمَنارا",8,"ر",2,0],["فَاِسأَل مَعاقِلَ بِالمَدينَةِ عِندَهُم","نورُ الحُكومَةِ وَالقَضاءُ المَقنَعُ",9,"ع",1,0],["فَاِسأَل إِذا خَرَجَ الخِدامُ وَأُحمِشَت","حَربٌ تَضَرَّمُ كَالحَريقِ المُشعَلِ",10,"ل",1,0],["فَاِسأَل بِذي نَجَبٍ فَوارِسَ عامِرٍ","وَاِسأَل عُيَينَةَ يَومَ جَزعِ ظِلالِ",11,"ل",1,0],["فَاِسأَل بَني عَبدِ شَمسٍ قَد رَضيتُ بِهِم","أَو هاشِمَ الصيدَ أَو أَبناءَ مَخزومِ",12,"م",1,0],["فاسألِ ابنيكَ ذا العلاء أبا العب","بَاس واسأل أبا العلاء النجيبا",13,"ب",2,0],["فاسْألاها ولا جوابَ لديها","لسؤال ومن لها بالكلام",14,"م",1,0],["فاسألاهُ ولا جوابَ لدْيهِ","أين عُبَّادُهُ الطوالُ القيام",14,"م",1,0],["فَاِسأَل ضَميرَكَ عَن وِدا","دي إِنَّهُ فيهِ جُهَينَه",15,"ن",2,0],["فَأَسأَلُ اللَهَ أَن لا","أَموتَ مِنكَ بِحَسرَه",16,"ر",2,0],["فاسأل اللَه تقديرا يغير ما","قضاه قبلا فلا ظلم ولا دخل",17,"ل",1,0],["فاسأل فكم من صيحة لك في الورى","نقلت إلى الدنيا صدى الآساد",18,"د",1,0],["فَاِسأَل إِلهي عَفوَهُ الجَليلا","لِتائِبٍ قَد جاءَهُ ذَليلا",19,"ل",2,0],["فَأَسأَلُ حِصنَيها العَجيبَينِ في الوَرى","وَمَدخَلُها الأَعصى الَّذي هُوَ أَعجَبُ",20,"ب",1,0],["فَاِسأَل هَوازِنَ إِنَّ عِندَ سَراتِهِم","عِلماً وَمُجتَمَعاً مِنَ الأَخبارِ",21,"ر",1,1],["فَاِسأَل غَداةَ جَدودَ أَيُّ فَوارِسٍ","مَنَعوا النِساءَ لِعوذِهِنَّ جُؤارُ",22,"ر",1,0],["فَاِسأَل فَإِنَّكَ مِن كُلَيبٍ وَاِلتَمِس","بِالعَسكَرَينِ بَقِيَّةَ الأَظلالِ",23,"ل",1,0],["فَأَساً تُصيبُ لَهاتَهُ يَلقى الَّذي","تَلقى نَواجِذُهُ أَشَدَّ زِحامِ",24,"م",1,0],["فَاِسأَل بِنا وَبِكُم إِذا لاقَيتُمُ","جُشُمَ الرَراقِمِ أَو بَني هَمّامِ",25,"م",1,0],["فاسأَلِ الحِيرَةَ عن جَبَّارِها","حينَ يَوماه حياةٌ وأجَلْ",26,"ل",1,0],["فَاِسأَل إِلَهَكَ بِالإِنابَةِ مُخلِصاً","دارُ الخُلودِ سُؤالَ مَن يَتَقَرَّبُ",27,"ب",1,0],["فاسأَلِ الأيامَ هل قد","ضنَّتِ الأيامُ دونَك",28,"ك",1,0],["فاسْألِ الرحمةَ ربّاً عظيماً","وَسِعَتْ رحمتُه كلّ شيِّ",29,"ي",1,0],["فَاِسأَل سُلَيمانَنا تَفديهِ أَنفُسُنا","يا مَن سُلَيمانُهُ يَرعى سُلَيماني",30,"ن",2,0],["فَاِسأَلنَها وَاِجعَل بُكاكَ جَواباً","تَجِدِ الشَوقَ سائِلاً وَمُجيبا",31,"ب",2,0],["فَاِسأَلِ العيسَ ما لَدَيها وَأَلِّف","بَينَ أَشخاصِها وَبَينَ السُهوبِ",32,"ب",1,0],["فَأَسأَلُ اللَهَ أَن يُعيدَكُمُ","وَيَجمَعُ الشَملَ بَعدَما اِفتَرَقا",33,"ق",2,0],["فَاسأَلي عَن فِعالهم يا فَرَنسا","إِن أَبناءَهُم لَدى غَملان",34,"ن",1,0],["فَاِسأَل زُرارَةَ وَالمَأمومَ ما فَعَلَت","قَتلى أُوارَةَ مِن زَغوانَ وَالكَدَدِ",35,"د",1,0],["فَاِسأَلنَهُ إِذا سَأَلتَ عَظيماً","إِنَّما يَسأَلُ العَظيمُ عَظيما",36,"م",2,0],["فَاِسأَل حِجاكَ إِذا أَرَدتَ هِدايَةً","وَاِحبِس لِسانَكَ أَن يَقولَ مُجازا",37,"ز",2,0],["فاسْألِ الفَرْقَدَينِ عَمّنْ أحَسّا","مِنْ قَبيلٍ وآنسا من بلادِ",38,"د",1,0],["فاسأَلِ النَّاسَ أَينَ آلُ قُبَيسٍ","طَحطَحَ الدَّهرُ قَبلَهُم سابُورا",39,"ر",2,0],["فأسأَلِ النّاسَ لا أَبا لكَ عنَّا","يومَ سَالَتْ بالمُعلَمينَ كداءُ",40,"ا",2,1],["فَاِسأَل كناسَ الحِمى هَل","قَضَت عَلَيَّ مَهاهُ",41,"ه",1,0],["فاسألا كلَّ جوهرِيّ فإن قا","ل لديهِ مِثْلٌ له فاسألاني",42,"ن",2,0],["فاسألْ مُناصرَه أو سَلْ مخالفَه","فليس فضلُ ابنِ محمودٍ بمجحود",43,"د",1,0],["فاسأل الفاطِميَّ كَمْ من كتابٍ","زَان تاريخَهُ وسِفْرٍ فرِيدِ",44,"د",1,0],["فاسألي المِرآةَ هل يوْماً رأت","أنَّ هذا الشكلَ من طينٍ وماء",45,"ا",2,0],["فاسألْ بِنَا وَبِكُمْ، إذا لاقَيْتُمُ","جُشَمَ الأرَاقِمِ، أوْ بَني هَمّامِ",46,"م",1,0],["فَاِسأَلهُ عَمّا لَم يَكُن بِكِنايَةٍ","فَالغَيبُ مِن أَفكارِهِ يُستَعلَمُ",47,"م",1,0],["فأسأل رب العرش يحفظ ذاتكم","بجاه ختام الرسل خير الورى طرّا",48,"ر",2,0],["فَأَساؤوهُ بالمقالِ وبالأف","عالِ واِشتدّ منهم الإعتداءُ",49,"ا",2,0],["فاسألوها لأيّ شيء لأعلم","إن تراني تصدّ عنّي كان لم",50,"م",1,0],["فاسأل محياكَ كم أخجلتَ من قمرٍ","وسل قوامكَ ذا المياسِ كم غصنا",51,"ن",2,0],["فاسأل نسيمَ الصبحِ إن مرَّ بي","هل حملتهُ الغيدُ أخبارا",52,"ر",2,0],["فاسألن عنه المعري كيف في","دربه قد كان يكبو ويثور",53,"ر",1,0],["فأسألك العدالة في ال","محب وأنت معتدل",54,"ل",1,0],["فَأَسأَلُ اللَهَ إِبقاءَ الهناءِ لكم","إِنَّ الهناء بحمد اللَهِ مَضمونُ",55,"ن",1,0],["فاسألْ خُطوبَ الدّهر عن جَلَدي","وغوامضَ الأشياء عن فَهَمي",56,"م",2,0],["فاسأل الهك لي بعشر محرم","جبراً لقلب واجف الأعشار",57,"ر",1,0],["فاسأل له الرحمن نظرة راحم","بشمول عافية وَعفو سرمدي",58,"د",2,0],["فَأَسْأَرَ مِنْ صَفْرَاءَ صِرْفٍ صُبَابةً","إذَا احْتُسِيَتْ كُلاً فَما لِلأَسَى بَعْضُ",59,"ض",1,0],["فَاِسأَلوا عَنهُم خَبيراً تَعلَموا","صِدقَ دَعوايَ وَلا سيما أَنا",60,"ن",2,0],["فاسأل العفو لهم يا سيدي","ربك الرحمن أكرم من عفا",61,"ف",2,0],["فَاِسأَلوا اللَهَ جَميعاً قُربَهُ","فَإِلَيهِ المُنتَهى وَالمُسَتَقَر",62,"ر",1,0],["فأسأل نفسي ما اراه حقيقة","تروعني أم ما أراه ظنون",63,"ن",1,0],["فَأَسأَلُ اللَّهَ رَبَّ العَرْشِ يُبْدِلُني","مِن المحَارَةِ تَسرِيحاً بإحسانِ",64,"ن",1,0],["فاسْألْ يُجِبْكَ خَبيرُ القومِ عن مَلكٍ","يَداهُ والجودُ في الدُّنيا حليفان",65,"ن",1,0],["فاسأَلْ بذاك مُحمّداً في قَبرِه","فكفَى به عن دينِه مَسْؤولا",66,"ل",2,0],["فاسأَلْ بني العّباسِ عمّا شاهَدوا","زمَنَ البَساسيريِّ هل يُتذَكَّر",67,"ر",1,0],["فَاِسأَلهُ لا تَسأَلِ الأَطلالَ حادِثَهُ","فَالدَنُّ مِن أَنطَقِ الأَطلالِ أَن يُسَلا",68,"ل",2,0],["فاسأَلوا عَن حَديثِها مَع سِواكُم","وإليكم ذاكَ الحديثُ يُساقُ",69,"ق",1,0],["فَاِسأَلوا عَنهُ أُحدهُ","وَاِسأَلوا عَنهُ خَيبَرَه",70,"ر",2,0],["فاسأل اللّه توفيقاً يكون به","حسن الختام ففيه الفوز مرتهن",71,"ن",1,0],["فاسألوا عافية منه ففي","فضلها جاء حديث ابن عمر",72,"ر",1,0],["فأسأله حسن الختام فإنه","إليه انقلابي في الرحيل إلى اللحد",73,"د",1,0],["فاسألوا البارق عني إن شرى","فأحاديثي إليه نميت",74,"ت",1,0],["فأَسْأَلُ رَدَّ العَفْوِ منك تَفَضُّلاً","فَحَسْبِيَ كَوْنِي غِبْتُ عنكَ عِقابا",75,"ب",2,0],["فاسأل الكوم عنهُم في العَطايا","واسألِ الجُرْدَ عنهم في النِزالِ",76,"ل",1,0],["فاسأل الكرج والفربخ يجيبو","ك بما قد لقوا به في المضيق",77,"ق",1,0],["فاسأل أعاديه عن افعاله فلكم","كساهم الذلّ بعد الويل والحرَبِ",78,"ب",1,0],["فأَسْأَلُ من بَرَاهُمْ للمنايا","بسيفِكَ أَن يَخُصَّكَ بالبقاءِ",79,"ا",2,0],["فاسْأَلْ كمِيَّ الوَجْدِ كيْفَ أَثَرْتُهُ","بِغُرُوبِ دَمْعٍ صائِبِ التَّسكابِ",80,"ب",1,0],["فأسألك التوفيق فيما رضيته","حياتي والغفران بعد شحوبي",81,"ب",2,0],["فاسأل إلهك أن يمن بفضله","وبستة من أحرف فيجود لي",82,"ل",2,0],["فاسأل معالمها فما أعلامها","وأنشد منازلها فمن نزالها",83,"ل",3,0],["فأسالت أنفسا معْجَلةً","لم تشارف من كتابٍ حِينَها",84,"ن",3,0],["فاسألي عينيكِ هل جانبتا","في الجوَى حُورَ المها أو عِينها",84,"ن",3,0],["فاسأل أسود الغاب كيف تفسحت","للشاءِ عن هذا العرين المُسبعِ",85,"ع",1,0],["فاسأل مَن الناجي إذا بُويعتْ","نفسٌ بنفسٍ ومَن الخاسرُ",86,"ر",1,0],["فاسألا عن هجرِ مثلي اعتداءً","بعد ذاكَ الوصالِ كيف استحلاّ",87,"ل",2,0],["فَأَسالَت دَماً كَأَنَّ جُفوني","عَصفَرَتهُ بِدَمعِها المَسكوبِ",88,"ب",1,0],["فاسْألِ القيعانَ عنهمْ","لو أجابَتْ من يُسائلْ",89,"ل",1,0],["فَاِسأَل لِكِندَةَ حينَ أَقبَلَ جَمعُها","حَولَ اِبنِ كَبشَةَ وَاِبنِ أُمِّ قَطامِ",90,"م",1,0],["فَاِسأَلوا ضَبَّةَ بنَ كَلبٍ وَأَوداً","تُخبَروا أَنَّنا شَفَينا الغَليلا",91,"ل",2,0],["فاسأل إلهك أن يديم حياته","لك ألف عام بعد هذا العام",92,"م",1,0],["فاسأَل تآليفَه تُنبيكَ عنه وعن","عُلومه تنمي كالعارَِ الهَطِل",93,"ل",1,0],["فَاِسأَلوا 