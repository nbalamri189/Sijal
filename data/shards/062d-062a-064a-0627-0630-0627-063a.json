{"poems":[[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[74,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[53,"غير الحياة إلى الشعور","https://www.aldiwan.net/poem64022.html","مجزوء الكامل"],[30,"نابي الفراش طري اللحم مطعمه","https://www.aldiwan.net/poem5497.html","البسيط"],[77,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[52,"سبح خليلي وقل يا حسن تصوير","https://www.aldiwan.net/poem63819.html","البسيط"],[52,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[8,"وكأن فاها بات مغتبقا","https://www.aldiwan.net/poem21792.html","أحذ الكامل"],[108,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[164,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[185,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[302,"دع الندامة لا يذهب بك الندم","https://www.aldiwan.net/poem33172.html","البسيط"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[358,"وتذكرت عهد الهوى","https://www.aldiwan.net/poem39954.html","مجزوء الكامل"],[358,"نفسي الفداء لمن حوت","https://www.aldiwan.net/poem40169.html","مجزوء الكامل"],[369,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[376,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[495,"منا مُسافٍ يُسافي الناس ما يسروا","https://www.aldiwan.net/poem661.html",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109028","الكامل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102310","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108753","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101063","الكامل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137377",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205808","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132721","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112366","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216384",""],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103788","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94768","البسيط"],[5135,"الرزق","https://www.poetsgate.com/ViewPoem.aspx?id=201874",""],[5136,"ولقد ذكرتك والعيون شواخص","https://www.poetsgate.com/ViewPoem.aspx?id=121536",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5302,"وسبت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=201220",""],[5447,"أنت","https://www.poetsgate.com/ViewPoem.aspx?id=208354",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[6344,"جنوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87977&r=&rc=17",""]],"verses":[["حَتَّى إِذَا غَدَتِ الْبِلاَدُ قَرِيرَةً","وَالأَمْنُ تُسْحَبُ بَيْنَهُنَّ ذُيُولَهُ",0,"ل",2,0],["حتى إذا غبطتك المكرمات عفت","تلك الهنات وكرّوا بعد ما عيفوا",1,"ف",3,0],["حتى إذا غِيَرُ المما","ت أتتْ على أهل القبور",2,"ر",1,0],["حَتّى إِذا غَمَرَ الحَوماتُ أَكرُعَها","وَعانَقَت مُستَنيماتِ العَلاجيمِ",3,"م",1,0],["حتى إذا غَمَرَ البحارَ كتائباً","لو يرتشفْنَ أُجاجَها لأميحا",4,"ح",2,0],["حَتّى إِذا غَرَّ فَتقٌ تَحتَ وَسنَتِها","وَراجَعَت بَعدَ تَسبيحٍ وَتَكبيرِ",5,"ر",1,0],["حَتّى إِذا غَدَتِ الوَرى وَغَدا بِها","مِثلَ المَريضِ أَفاقَ مِن أَوصابِهِ",6,"ب",2,0],["حَتّى إِذا غَفَلَت وَخَالَفَها","مُتَسَرِبلٌ أَدَماً عَلى الصَدرِ",7,"ر",1,0],["حتى إذا غبتَ عنها، ودَّعَتْ رجلاً","قد كان أَرفعَ من أهرامها شانا",8,"ن",2,0],["حتى إِذا غمرت أياديه الرجا","وأتاك يبغي العذر بالإِغراءَ",9,"ا",2,0],["حتى إِذا غَرَّدَ الحادِى وَأَتبَعَهُم","ذَمّاً بِهِم ليسَ تَقتِيراً ولا تَعَبَا",10,"ب",2,0],["حتّى إِذا غبتُ عنه قامَ منتهباً","داري وراح لما خلَّفتُ يغتنمُ",11,"م",1,0],["حَتّى إِذا غَمَرَ الأنامَ وَوُفِّيت","مِنهُ لِآمالِ الوَزيرِ نُذورُ",12,"ر",1,0],["حَتّى إِذا غَفل الرَقي","ب وَبات ضدّي في عَمى",13,"م",2,0],["حَتّى إِذا غَضبت وَقَد","نَفَرت كَخَشفٍ أَلعَسِ",14,"س",1,0],["حتّى إذا غَصَّ الفضاءُ بمَوكِبٍ","من وَطْئهِ كَبِدُ الحَسودِ تَفطَّر",15,"ر",1,0],["حتى إذا غمرَ الهيا","جَ بها الغلامُ العامِري",16,"ر",2,0],["حَتّى إِذا غابَ قَرنُ الشَمسِ أَو كَرَبَت","وَظَنَّ أَن سَوفَ يولي بَيضَهُ الغَسَف",17,"ف",1,0],["حتى إذا غارت على حسنائِها","وغدت تودُ بأنها لم تقطف",18,"ف",1,0],["حتى إذا غاب عني بدر طلعته","وقد دجت من ليالي شعره الظلم",19,"م",1,0],["حتى إذا غدت القفار من البكا","مثل البحار رددتهم لربوعي",20,"ع",2,0],["حتى إذا غشى الحمى ووقفته","بالأمر لم يحتج لحبس عنان",21,"ن",1,0],["حتى إذا غربت شمس النها بكم","والأفق صم لعين القرص ما سترا",22,"ر",2,0],["حتى إذا غفل الواشي وقد لعبت","راح الغرام بأسما في تصابيها",23,"ي",3,0],["حتى إذا غنّيتِ ذاق الكرى","ونام نوم الطفل في المضجع",24,"ع",1,0],["حتى إذا غلب الشك اليقين دجا","ليل الخطوب باسداف واظلام",25,"م",1,0],["حتى إذا غابت نجومُ الدجى","عنّي وكَلّ الطرفُ ممّا يرُود",26,"د",1,0],["حَتّى إِذا غال المشيب قذالها","واِبيضّ غربيب العذار الأَسودِ",27,"د",1,0],["حتى إذا غالبت سكرته","صفَّقته فرددت أقداحي",28,"ح",2,0],["حتى اذا غازلت أجفانه سنة","وصيرته يد الصهباء طوع يدي",29,"د",2,0],["حتى إذا غودرْنَ بينَ مُجدَّلٍ","ومُهلَلِ ناجٍ وبَينَ مُبعَّجِ",30,"ج",1,0],["حتى إذا غضبت روح الندا جأَزَت","هل من جريحٍ ولا يرتاع إن جهَزَت",31,"ت",1,0],["حتّى إذا غرب الرَّجاء وأظْلمتْ","نَفْسُ الْيَؤُوْس ِالضَّيِّقِ الْآفاقِ",32,"ق",1,1],["حتى إذا غزت الشمال وهاجت ال","أمواج ضجوا بالدعاء وهاجوا",33,"ج",3,0],["حتى إذا غادرتهم خيله مزعاً","أشلاء شالت مع العقبان والرخم",34,"م",1,0],["حتى إذا غمرت رحابي حركت","كل السكون وهاجت الغبراء",35,"ا",2,0],["حتى إذا غادرْتَ نضَّتْ حُسنَها","وبدَتْ بعين الناظرينَ عجوزا",36,"ز",2,0],["حتى إذا غص في الأشلاء أرحبها","وفاض في علق الأحشاء واديها",37,"ي",3,0],["حَتَّى إِذَا غَطَّاكَ مَوْجُكَ لَمْ تَجِدْ","غُصْنَ القَدَاسَةِ فَاسْتَحَلْتَ ضَرِيحَا",38,"ح",2,0]]}