{"poems":[[55,"أغر أيامي مني ذا الطلل","https://www.aldiwan.net/poem29853.html","الرجز"],[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[74,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"أغضى أبو بكر على الهون","https://www.aldiwan.net/poem66419.html","السريع"],[91,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[68,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[82,"أشكو إلى الله ما قاسيت من رمد","https://www.aldiwan.net/poem31451.html","البسيط"],[46,"قل للأمير لقد قلدتني نعما","https://www.aldiwan.net/poem30562.html","البسيط"],[54,"تخالهم أسوار جيش أبلخا","https://www.aldiwan.net/poem27136.html","الرجز"],[54,"كأنه لما غدا","https://www.aldiwan.net/poem27170.html","مجزوء الرجز"],[52,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[48,"بقيت وما أدري بما هو غائب","https://www.aldiwan.net/poem22079.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42720","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[141,"الحمد لله ولي الحمد","https://www.aldiwan.net/poem67916.html","الرجز"],[170,"يا شمس والشمس لها حاجب","https://www.aldiwan.net/poem46831.html","السريع"],[189,"كبارة لاح بها","https://www.aldiwan.net/poem14756.html","مجزوء الرجز"],[199,"لمن رسم دار كالكتاب المنمنم","https://www.aldiwan.net/poem54416.html","الطويل"],[214,"يا عين جودي لفقد الألف بالسهر","https://www.aldiwan.net/poem13571.html","البسيط"],[285,"ألا فتى من صروف الدهر يحميني","https://www.aldiwan.net/poem60743.html","البسيط"],[327,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[358,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[374,"مات معز الدين من قبل أن","https://www.aldiwan.net/poem4301.html","السريع"],[396,"جاء الفرج زال الحرج","https://www.aldiwan.net/poem54489.html","عموديه"],[435,"يا رب ليل طويناه على قلق","https://www.aldiwan.net/poem41007.html","البسيط"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[463,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[473,"لا تغفلن عن اللذات والطرب","https://www.aldiwan.net/poem60491.html","البسيط"],[498,"وشاهبلوط تناهى واستتم","https://www.aldiwan.net/poem67283.html","عموديه"],[556,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[567,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[572,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[574,"إن أبانا بكر آدم فاعلموا","https://www.aldiwan.net/poem52001.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2459","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44569","السريع"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[881,"","https://poetry.dctabudhabi.ae/diwan/poem/21183","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77630","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16919","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61180","البسيط"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100629","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56310","البسيط"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47500","البسيط"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47429","السريع"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98206","السريع"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126669","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33851","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109382","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93719","الطويل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100435","السريع"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103419","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100784","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112300","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74075","السريع"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125927","السريع"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86550","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86514","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86536","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86532","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59511","البسيط"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103566","الطويل"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113702","المنسرح"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119422","السريع"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103131","المجتث"],[4984,"الصيف ما الصيف","https://www.poetsgate.com/ViewPoem.aspx?id=215102",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5183,"منزل الشان","https://www.poetsgate.com/ViewPoem.aspx?id=180213",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5691,"تمرد الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=206656",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[6120,"قَلْبِي طَرِيحٌ عَلَى جَمْرِ الصَّبَابَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=213494",""],[463,"لو شاءَ سارٍ ليلة َ النَّعفِ وقفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""],[572,"ومَلْعَبٍ للخيلِ في قراحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9209&r=&rc=66",""]],"verses":[["كَأَنَّهُ لَمّا طَرا عَلى عَجَل","سَوادُ نَبتٍ عَمَّهُ بَياضُ طَل",0,"ل",1,0],["كانَ هِلالُ الكَمالِ مُنتَظَراً","وَكانَ نوءُ العَلاءِ مَرقوبا",1,"ب",2,0],["كأن هلال العام زورق قادم","عليك بمملوك الثناء مليّه",2,"ي",2,0],["كأنه لم يدرِ أنَّ العلا","تُزْري على العُرف إذا أنصبا",3,"ب",2,0],["كأَنَّه ليس يُبَاليهمُ","وعنده ما ليس بالدُّون",4,"ن",1,0],["كأنه لم يك بالمولود","من ام وأب",5,"ب",1,0],["كَأَنَّهُ لَم يَطُل إِلى رُتَبٍ","تَقصُرُ مِن دونِ نَيلِها الهِمَمُ",6,"م",1,0],["كأنّه للقَذَى والدمعِ في وَحِلٍ","فَخَلْعُهُ أَرجُلاً مِنهُ بِإِضرارِ",7,"ر",1,0],["كَأَنَّهُ لِاِجتِماعِ الروحِ فيهِ لَهُ","مِن كُلِّ جارِحَةٍ في جِسمِهِ روحُ",8,"ح",1,0],["كَأَنَّهُ لَمّا قَطَعنا فَرسَخا","مُصحَفُ وَرّاقٍ أُدِقُّ نُسَخا",9,"خ",2,0],["كَأَنَّهُ لَمّا غَدا","وَالصُبحُ لَم يَنبَلِجِ",10,"ج",1,1],["كَأَنَّهُ لُؤلُؤٌ رَثَّت مَعاقِدُهُ","فَاِنسابَ أَوَّلُهُ في السِلكِ فَاِطَّرَدا",11,"د",2,0],["كَأَنَّ هِلالاً لاحَ لِلطَعنِ فيهِمُ","حَناهُ الرَدى وَهوَ السِنانُ المُجَرَّبُ",12,"ب",1,0],["كَأَنَّ هِلالَ الأُفْقِ سَيْفٌ مُجَرَّدٌ","عَلَيْنَا بِهِ وَالنَّجْمَ سَهْمٌ مُفَوَّقُ",13,"ق",1,0],["كأنه لَيلٌ بَهيمٌ خَطَرَتْ","فيه من الشُّمِّ البَهاليلِ بُهَم",14,"م",1,0],["كَأَنَّهُ لِما بَقي لَدَيكُمُ","حَيٌّ صَحيحٌ لا يَزالُ فيكُمُ",15,"م",1,0],["كأنّهُ لم يَغْنَ بالأمسِ وإ","كآبتَا منهُ ولم تُغْنِ وا",16,"و",2,0],["كأنه لما بدا","في شكله المنمَّق",17,"ق",1,0],["كَأَنَّ هِلالاً واضِحاً فَرَجَت لَهُ","شَماريخُ مُزنٍ رابِعٍ مُتَغَيِّمِ",18,"م",1,0],["كأنه لم يكن عين الزمان ولا","في جبهة الدره يوما غرة الغرر",19,"ر",1,0],["كَأَنَّهُ لَيْسَ يَغْدُو مُرْسِلاً يَدَهُ","بِكُلِّ نافِذَةٍ إِلاّ لِيُصْمِينِي",20,"ن",2,0],["كَأَنَّهُ لَم يَكُن بِهِ أَحَدٌ","فَالقَلبُ مِن قَلبِ مَن نَأى قَرِحُ",21,"ح",1,0],["كَأَنّ هِلال الأُفق عضب مُجرّد","أَو اللَيل عَبدٌ أَسود شابَ حاجبُه",22,"ب",2,0],["كأنه لم يغدُ يوما ولم","يرح مليكاً بين حجّابه",23,"ب",2,0],["كأنه ليس مؤمن بالإله الكريم","والبعث والنشر والحشر ليوم عظيم",24,"م",1,0],["كأنه ليل مجنون ترقب ان","يأتي الصباح عسى أن يقمع الكدرا",25,"ر",2,0],["كَأَنَّهُ لَمْ يَجِدْ غَيْرَ الوَغى وَطَناً","وَلا سِوانا لما يَحوِيهِ خُزَّانا",26,"ن",2,0],["كأنّه ليس له","من ماله ما اختزنا",27,"ن",2,0],["كأنه لم يرَ حِقْفاً عَمَماً","هِيلَ ولا بدراً مع التمِّ انكسفْ",28,"ف",1,0],["كَأَنَّهُ لُؤلُؤٌ رَطبٌ تَشَقَّقُ في","غُصونِ فيروزُنجٍ عَن خالِصِ الذَهَبِ",29,"ب",1,0],["كأنه لما تراءى من أمم","في صحة التشبيه أظلاف الغنم",30,"م",1,0],["كَأنّهُ لم يَقرِكم ضُلَّلاً","عن الهدى القَصْدَ بأمّ القُرى",31,"ر",2,0],["كأنَّهُ لم يَكُنْ رُكناً لطائفةٍ","ولا مَناراً لدارِ العِلمِ والحِكَمِ",32,"م",1,0],["كَأَنَّ هَلُوكَاً حَبَتْهَا السِّوَا","رَ أَوْ سَلَبَ الكَفَّ أَسْوَارَهَا",33,"ر",3,0],["كأَنَّ هلالا لاح فوق قناته","جلا الغيم عنه وَالقتام الحراجفُ",34,"ف",1,0],["كَأَنَّهُ لُؤلُؤٌ في سِلكِ ناظِمَةٍ","بُتَّ القُوى مِن جَديدِ السِلكِ فَاِنتَثَرا",35,"ر",2,0],["كَأَنَّهُ لَمّا بَدا ضاحِكاً","في العَينِ تَشبيهاً وَتَقديرا",36,"ر",2,0],["كأنه ليثُ غابٍ","تخشى أذاهُ الأسود",37,"د",1,0],["كَأَنَّهُ لَم يَدعُ السَوابِحُ مَرَّةً","إِذا اِبتَدَرَ الخَيلَ الرِجالُ نَجيبُ",38,"ب",1,0],["كَأَنَّهُ لَم يَسمَع التَحيَّه","لِشُغلِهِ بِهَذِهِ القَضيَّه",39,"ه",1,0],["كأنه لاضطراب العطف مبتهل","من الدماء مداما فهو مثمول",40,"ل",1,0],["كَأنَّ هِلاَلَ العِيدِ زَوْرَقُ قَادِمٍ","يُبَادِرُ بِالتَّسْلِيمِ ثُمَّ يُوَاصِلُ",41,"ل",1,0],["كَأَنَّ هِلالَ الشَهرِ قِطعَةُ دُملُجٍ","تَلوحُ عَلى أَعضاءِ مُعتَكِرٍ غاسِ",42,"س",1,1],["كَأَنَّهُ للألى يأتونه رغبا","وَادي الأَراك لحاج البَيت وَالحَرَم",43,"م",1,0],["كأَنهُ لآلئٌ","يُصان فيها العسلُ",44,"ل",1,0],["كأنه ليل مسجون ترّقب أن","يأتي الصباح عسى أن يقمع الشررا",45,"ر",2,0],["كَأَنُه لَمْ يَخُضْ لِلْمَوْتِ بَحْرَ وَغَىً","خُضْرُ البِحارِ إذا قِيسَتْ بِهِ بِرَكُ",46,"ك",1,0],["كَأَنَّهُ لَمَّا أُتِينا بِهِ","مُنْغَمِسُ الأَثْوابِ في الَّلازَوَرْدْ",47,"د",1,0],["كأنّه لا كان من تيهه","مورّثٌ ملكَ سليمانِ",48,"ن",1,0],["كأنه لم يقد جيشا ولا ذكرت","أخباره في نوادي القوم والسمر",49,"ر",1,0],["كَأَنَّهُ لَم يَغشَ فيما مَضى","مَواطِناً غَيرَ ذَميماتِ",50,"ت",1,0],["كأنه للمعالي كلها فلكٌ","بهِ كواكبُها مُعتزَّةً تسري",51,"ر",2,0],["كَأَنّ هِلالاً تم وَهوَ ابن لَيلة","فَفاجأه بِالرَغم خسف مقارن",52,"ن",1,0],["كأنه لاقى شذا أحمد","فاكتسب الطيب بلقياه",53,"ا",2,0],["كأَنَّهُ لابِسٌ مِن جِلدِهِ فَنَكاً","في لينِهِ لبنانِ الكفِّ تَمهيدُ",54,"د",1,0],["كأنه لم يسد أيام منعتهم","ولم يعش منهم في عارض هتن",55,"ن",1,0],["كَأنّهُ لم يَطَأ مَنَاكِبَهضا","وحولهُ الجيشُ وهوَ مختَضِبُ",56,"ب",1,0],["كأَنَّه لَم يَر ما أَجزلت","نعماهُ مِن عطفٍ وَتحنانِ",57,"ن",1,0],["كأنه لم يكن قبر الذي","كان أخا جد بعيد الامد",58,"د",1,0],["كأن هلال الأفق خلف غمامة","تبين منه صفحة وتغمها",59,"ه",2,1],["كأنه لنجوم الليل معتنقٌ","أو أنه لسحاب الجو محتضن",60,"ن",1,0],["كأن هلال الظلمة أندق صلبه","فأطرق حاني الظهر لا يتحرك",61,"ك",1,0],["كأنه لم يجز عنك السلو تقىً","وواجب الصبر والتأساء لم يجب",62,"ب",1,0],["كأنه لقوةٌ طَلوبٌ","فتخا الجناحين إذ تحومُ",63,"م",1,0],["كان هلال الفطر لاح بوجهه","فأعيُنَنا شوقاً إليه تميلُ",64,"ل",1,0],["كأنَّه لؤلؤٌ تُبدِّده","أيدي عذارى أفضى بها اللَّعبُ",65,"ب",1,0],["كأنه للعين لما بدا","أحجار كافور عليها عبير",66,"ر",1,0],["كأنه لجة البح","ر غاض فيها ملجج",67,"ج",1,0],["كأنه لما انمحي خفية","وَمْضُ بُروقٍ أَبْرقت برقا",68,"ق",2,0],["كأنه لمّا بدا","لمع سيوفٍ تنتضى",69,"ض",2,0],["كأنه لم يدر منه على خلد","شيء وقد ضج فيه كل إنسان",70,"ن",1,0],["كأن هلال الغرب للستّ مائلٌ","بشامٌ رأينَ من عمامته شطرا",71,"ر",2,0],["كأنَّهُ لم يكنْ يوماً نديمَهما ولا","أدارَ هنا كأساً، ولا شَرِبا",72,"ب",2,0],["كأنَّهُ لُجَجُ الأنْوارِ تمْخُرُها","وتسْتَحِمُّ على شُطْآنِها النُّجُمُ",73,"م",1,0],["كأنه لم يعُدْ شخصا قويّاً","تُشيدُ بعزمِه حتى العراقُ",74,"ق",1,0],["كَأنَّهُ لَمْ يَكُنْ يَهوَاكَ فِي زَمَنٍ","وَلَم تَكُنْ أَنتَ فِيهِ العَاشِقَ المُغرَم",75,"م",1,0],["كأنَّهُ لمْ يرَ حقفاً عما","هيلَ ولا بدراً معِ التِّمِّ انكسفْ",76,"ف",1,0],["كأنَّه ليلٌ على صَبَاحِ","فخلتُهُمْ من شدّة المراحِ",77,"ح",1,0]]}