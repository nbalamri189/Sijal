{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[32,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[63,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[48,"أدين برب واحد وتجنب","https://www.aldiwan.net/poem23440.html","الطويل"],[96,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[32,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[267,"أبلغا ربطة أني","https://www.aldiwan.net/poem68183.html","مجزوء الرمل"],[371,"لا يضيع الله من عمل","https://www.aldiwan.net/poem17251.html","المديد"],[445,"ثم أقدمتهن شعث النواصي","https://www.aldiwan.net/poem34764.html","الخفيف"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"ترنمت ترنم الأسير","https://www.aldiwan.net/poem56206.html","الرجز"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101487","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64027","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203488","الخفيف"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131662",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33413","المقتضب"],[5061,"الخوه الخوه","https://www.poetsgate.com/ViewPoem.aspx?id=153974",""],[5956,"لو أتى السيّاف","https://www.poetsgate.com/ViewPoem.aspx?id=182114",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""]],"verses":[["تَنَطَّقَ بِالقَنا يَحمَ","رُّ ناهِضُهُ وَعاثِرُه",0,"ر",2,0],["تَنَطَّحَ بِالأَطلالِ مِنه مُجَلجِلٌ","أَحَمُّ إِذَا احمَومَت سحَائِبُهُ انسَجَل",1,"ل",1,0],["تَنَطَّقنَ في رَملِ الغِناءِ وَعُلِقَت","بَأَعناقِ أُدمانِ الظِباءِ القَلائِدُ",2,"د",1,0],["تنطق راياته فلا مللا","يظهر من مطقها ولا سأما",3,"م",2,0],["تَنَطَّسَ في كَتبِ الوَثائِقِ خائِفٌ","مَنِيَّتُهُ وَالمَرءُ لا بُدَّ بائِنُ",4,"ن",1,0],["تنطق عيناك ولم تنطقي","وقد تطيلان وقد توجزان",5,"ن",1,0],["تنطقنَ منْ رملِ الغناءِ وعُلِّقتْ","بأعناقِ أدمانِ الظِّباءِ القلائدُ",6,"د",1,0],["تَنطَحُ القِبلَةَ شَهراً","جَبهَتي لا تَأتَلِيها",7,"ي",3,0],["تَنطَحُ الشُجعانُ حَملَتَهُ","كَنِطاحِ السَيلِ لِلجَبَلِ",8,"ل",1,0],["تَنْطِقُ البِيضُ فِي الطُّلى والعَوَالي","فِي الكُلى أَبْشِرِي بِفَوْتِ الخَلاصِ",9,"ص",1,0],["تَنطِقُ السهلَ على ما ركِبتْ","من ظهورٍ صعبة الأردافِ خُشْنِ",10,"ن",1,0],["تنطَّقْتها حَلْياً وقُلِّدتَ فوقها","صقيلاً يُريك البشرَ وهو شتيمُ",11,"م",1,0],["تنطِقُ عن قلبٍ لها مكسورِ","كأنها تُخبِرُ عن ضميري",12,"ر",2,0],["تنطحُ الجوزاءَ منهُ رايةٌ","عُلّق المصباحُ فيها كالعَلم",13,"م",1,0],["تنطقُ ألحاظه ومنطقها","بلاغةٌ كلُّها وإِبلاغ",14,"غ",1,0],["تنطفي النار حين تنفخ إن قل","لت وبالنفخ للظى الجم زاد",15,"د",1,0],["تنط في الجو تخطف الشيمران","والباز تبقى له وكيفه",16,"ف",2,0],["تنطوي على أسفِ","يا خلي من الدنفِ",17,"ف",1,1],["ﻻ تنطرح-للياس ...وتوقف السير","اطمح ونفسك حقق الها هدفها",18,"ف",3,0],["تنطقُ المُقْلةُ عمَّا في دمي","إذْ لُجَيْنُ البدر يَجْرِي عَبْرَها",19,"ه",2,0],["تنطق الوحي سبحة في يديه","فتبين النيوب من خرزاته",20,"ت",2,0]]}