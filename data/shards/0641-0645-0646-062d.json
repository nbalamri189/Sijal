e.com/ViewPoem.aspx?id=170940",""],[4929,"الشعر وموهبته","https://www.poetsgate.com/ViewPoem.aspx?id=202409",""],[4984,"وَفَاءُ الْحَرْفِ - جِدَارِيَّةٌ 08 -","https://www.poetsgate.com/ViewPoem.aspx?id=187505",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[4119,"يشيم هواكم مقلتي فتصوب","https://www.poetsgate.com/ViewPoem.aspx?id=16068",""],[3271,"الشعاع المقيد","https://www.poetsgate.com/ViewPoem.aspx?id=104118",""],[5136,"فتى من طينة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=121800",""],[5689,"ترى أنت تهوي غير نفسك في ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=143396",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5742,"تزوج بأخرى","https://www.poetsgate.com/ViewPoem.aspx?id=206949",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5879,"خماسيات (5)","https://www.poetsgate.com/ViewPoem.aspx?id=215444",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[6102,"حَتمِيَّةُ الصِّراعِ...","https://www.poetsgate.com/ViewPoem.aspx?id=211869",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَمِن حِلَّةٍ نَجتابُها وَقَبيلَةٍ","نَمُرُّ بِها مُستَنبِحينَ كِلابَها",0,"ب",3,0],["فَمَن حَوى العِلمَ ثُمَّ أَودَعَهُ","بِجَهلِهِ غَيرَ أَهلِهِ ظَلَمَه",1,"م",2,0],["فَمِن حُسنِ صَبرٍ بِالسَلامَةِ واعِدي","وَمِن رَيبِ دَهرٍ بِالرَدى مُتَوَعَّدي",2,"د",2,0],["فَمَن حَسِبَ دُنيا وَأُخرى","فَذا رَجُلٌ عَقلُهُ أَحوَلُ",3,"ل",1,0],["فَمَنْ حَوَى الأَكْثَرَ مِنْهُنَّ افْتَخَرْ","بالفَضْلِ فِيما حازَه على الأُخَرْ",4,"ر",1,0],["فَمِنْ حَزمٍ تَدينُ له الليالي","وَمِنْ رأيٍ تَدِينُ به الغُيوبُ",5,"ب",1,0],["فمن حُسْنِ الصنائعِ فيه حُسْنٌ","ومن طيبِ المحامدِ فيه طيبُ",5,"ب",1,0],["فَمِن حادِثٍ جَمٍّ صَفَقتُ لَهُ يَدي","وَمِن فادِحٍ صَعبٍ قَرَعتُ لَهُ سِنّي",6,"ن",2,0],["فمن حياءٍ لا تَرى وَجْهَهُ","إلا وللغيم عليه لثام",7,"م",1,0],["فَمِن حاملٍ من غير فحلٍ يُنيخُها","إذا وَضَعتْ في ساحل الرّوم صَيْلَمُ",8,"م",1,0],["فَمَنَحتُهُ بَعدَ الوِصالِ قَطيعَةً","شَدَّت عَلى الزَفَراتِ عِقدَ نِطاقِهِ",9,"ق",2,0],["فَمِنْ حَامِلٍ رُمْحاً وَمِنْ قَابِضٍ عَصَاً","وَمِنْ فَزعٍ يَتْلُو الْكِتَابَ بِإِهْلالِ",10,"ل",1,0],["فَمَنْ حَسُنَتْ آثارُهُ فَهْوَ مُقْبِلٌ","ومَنْ قَبُحَتْ آثارُهُ فَهْوَ مُدْبِرُ",11,"ر",1,0],["فمَنْ حاتمٌ ثَكَلوا حاتِماً","ومَنْ هَرِمٌ حيثُ عدّوا هَرِم",12,"م",1,0],["فمِنْ حُرَقٍ قد باتَ وَهْناً يَشُبُّهَا","بذكراكِ تُذكَى في الفؤادِ فتُحرِقه",13,"ق",2,0],["فَمَن حارَبتِ حارَبتُ","وَمَن صافَيتِ صافَيتُ",14,"ت",1,0],["فَمِن حُلمٍ يَسُرُّكَ أَبطَلَتهُ","وَمِن حُلمٍ يَضُرُّكَ حَقَّقَتهُ",15,"ت",2,0],["فمِن حِكمةٍ عَلَّمتْها السِّنُونَ","حِوارَ النفُّوسِ وإِسْرَارَها",16,"ر",3,0],["فمن حياتك في الفن الحياة سرت","ومن معانيك قد رقَّت معانيه",17,"ي",2,0],["فمن حسب العيش دنيا وأخرى","فذا رجل عقله أحول",18,"ل",1,0],["فمن حية الهجر في مهجتي","سموم برؤيته تشتفي",19,"ي",1,0],["فمن حَبَّ أو من حُبّ فهو معذبٌ","ولا زالَ يغشاهُ الأسَى والمخارفُ",20,"ف",1,0],["فمن حيث رام العزَّ جاءته ذلةٌ","ومن حيثُ رامَ الحظَّ لاقاه حرمانُ",21,"ن",1,0],["فَمَنَحتَهُم جَبَلي أَبيهِم إِرثَهُم","عَنهُ وَساءا مَنزِلاً وَمُخَيَّما",22,"م",2,0],["فمن حاتم الطائي من معن في الندى","ومن عنتر العبسي ومن عمرو في الكر",23,"ر",1,0],["فَمِن حُبِّهَا اَحبَبتُ مَن لاَ يُحِبُّنِى","وَصَانَعتُ مِن قَد كنتُ أُبعِدُهُ جَهدِى",24,"د",2,0],["فمن حاسديه على أنْ رآك","فشرَّفتَه زمزمٌ والمقام",25,"م",1,0],["فَمِن حَصاهُ نَقِيٌّ في جَوانِبِهِ","مَعَ الغَثاءِ وَمِنهُ الراسِبُ الغَرِقُ",26,"ق",1,0],["فمن حيث داروا درتُ فيهم ككوكب","بأرزن من قاضٍ وأسخف من قرد",27,"د",1,0],["فمن حوى جلّ المكارم يا لهُ","خلٌّ وفيّ للمفاخر يطصفى",28,"ف",2,0],["فِمنْ حَدّ سيفك تسطو المَنونُ","ومِنْ بطن كفِّك يُبْغَى النَّدَى",29,"ا",1,0],["فَمِن حاسِرٍ يَخشاهُ كُلُّ مُدَجَّجٍ","وَمِن صامِتٍ يُزري عَلى كُلِّ قَوّالِ",30,"ل",1,0],["فَمِن حُرِّ وَجهٍ بِالصَعيدِ مُعَفَّرٍ","وَطَرفٍ كَحيلٍ بِالتُرابِ كَحيلِ",31,"ل",1,0],["فمن حانق والحقد ملء إهابه","ومن خائف في شأنه يترقب",32,"ب",1,0],["فَمِنْ حَقِّ الْقَوافِي مِنْكَ دَفْعٌ","يَجِيشُ بِمِثْلِهِ الْجَيْشُ اللُّهامُ",33,"م",1,0],["فَمَن حاتمٌ إِن بَذَلتَ النَدى","وَمَن هُوَ في الجودِ كَعبُ بنُ مامَه",34,"م",2,0],["فمن حققت سعادته","ورام اطالة العمر",35,"ر",1,0],["فمن حكمِه (موسى) و(عيسى) و(أحمد)","وَمن هو من أتباعهمْ بات راضيا",36,"ي",2,0],["فمن حيث أنسى هن لي خير صاحبٍ","ومن حيثُ نوري ما النجوم سواكم",37,"م",1,0],["فَمَن حَوَتهُ جِهاتي","رَأى جَليلُ مَقامي",38,"م",2,0],["فمِن حَيائي ومن شَوقي إليك أرَى","نارَيْنِ كلتاهما في القَلْبِ تَستَعِر",39,"ر",1,0],["فمِن حيثُ لا يُرجَى الوَفاء رَجوتَه","ومن حيثُ يُخشَى الغَدر سارَعتَ في الغَدرِ",40,"ر",1,0],["فَمنْ حصلَتْ هذي المعاني","فتابِعْ رأْيَهُ والزَمْ طريقَهْ",41,"ق",2,0],["فمن حقّ طرفي هذي الدموع","ومن شأن قلبي هذا الجوى",42,"ا",1,0],["فمن حلمه عفو ومن علمه حجا","ومن خيره بر ومن دينه عدل",43,"ل",1,0],["فَمِنْ حُرَّةٍ جُلِيتْ بِالجلاءِ","وعَذْرَاءَ نُصَّتْ بنصِّ الذَّميلِ",44,"ل",1,0],["فَمِنْ حَقِّها أَنْ تَرى الشَّارِبينَ","وَقَدْ نَفَّقَتْ سُوقُهُمْ بالنُّخَّبْ",45,"ب",1,0],["فمَن حاكمٌ بين الدؤُوبِ وبينها","إذا ما تقاضت أظهرٌ ورحالُ",46,"ل",1,0],["فمن حلمهم أركانُها وجبالُها","ومن جودهم أمواهُها ونباتُها",47,"ت",3,0],["فَمِن حُبِّها أَحبَبتُ مَن لَيسَ عِندَهُ","يَدٌ بِيَدٍ تُجزي وَلا مِنَّةٌ عِندي",48,"د",2,0],["فمن حسنها حسن الملاح وقد بدت","بتقييد مجلى الكون في خط صورتي",49,"ي",1,0],["فمن حذا في امور الدهر حذوهما","كان الفلاح له دوماً من الخلفا",50,"ف",2,0],["فَمَن حاتمُ في طي","ومَن عنتَرُ في عَبس",51,"س",1,0],["فمن حال فيه عن حضيض حظوظه","بمحضر حظي فهو حضرة حظوتي",52,"ي",1,0],["فمن حسن وأحمد كل فعلٍ","لنا نور النبي بدا لموعا",53,"ع",2,0],["فَمنحتَ في هَذي البِلادِ بِدَولةٍ","فَاِجعَل دَوامَ العَدلِ مِن شُكرانِها",54,"ن",3,0],["فمن حسنها العين في جنة","وقلبيَ من حبها في سقرْ",55,"ر",1,0],["فمن حبل الوردي إليه أدنى","تعافيه وطوراً تبتليه",56,"ي",2,0],["فمن حب هذا الفن تالله لم أزل","مقيماً لاصحاب السؤال حبيبا",57,"ب",2,0],["فَمَن حَكَمتَ كَأسَكَ فيهِ فَاِحكُم","لَهُ بِإِقالَةِ عِندَ العَثار",58,"ر",1,0],["فمن حمرة فوقنا وابيضاض","كخد الحبيب إذا ما عرق",59,"ق",1,0],["فمِن حُرَقٍ لِلنَّفس فيه لواعجٌ","ومن عَرَقٍ للجلد في دِباغُ",60,"غ",1,0],["فَمُنَّ حَبيبي بِالوصالِ تَعطُّفاً","فَطعمُ المَنايا دونَ ذا ما نُقاسِيهِ",61,"ي",2,0],["فمن حظاه بسهم منه سيده","فقد هداه إِلى عز وَتمكين",62,"ن",1,0],["فمن حرب إِلى حرب","ومن قتل إِلى قتل",63,"ل",1,0],["فَمِنْ حُبِّها أَبْغَضْتُ مَنْ كُنْتُ وَامقاً","وِمْن حُبِّها أَحْبَبْتُ مَنْ كُنْتُ أُبْغِضُ",64,"ض",1,0],["فمن حبه فرض عليّ وواجب","أميس به تيهاً وأزهو وأفخرا",65,"ر",2,0],["فمن حرة تبكي عفافاً هفت به","يد البغي من تلك الأكف الظم",66,"م",1,0],["فمن حمد قتلى وقتلي من الهوى","فلم بين جحجاح ولم تبن غانيه",67,"ي",2,0],["فمن حسين مزايا في معانيه","ومن علي سجايا في مغانيه",68,"ي",2,0],["فَمَنحَتُ بَدأَتِها رَقيباً جانِحاً","وَالنار تَلفَحُ وَجهَهُ بِأَوارِها",69,"ر",3,0],["فمن حبها وافيت أشعث أغبرا","تلبي لرب باللطائف ربكا",70,"ك",2,0],["فمَنْ حرَّمَ أنْ تَرْحَ","مَ مَنْ يَهواكَ أو تُسْعِدْ",71,"د",1,0],["فمن حاد عن حقّ وأبقى مذمة","فما ذم يوماً لابن أحمد موقف",72,"ف",1,0],["فمِن حسِّي إلى عقلي","ومن عقلي إلى حِسِّي",73,"س",2,1],["فمن حَمَلٍ إلى ثورٍ ويعلو","إلى الجوزاءِ في الفلك البهيّ",74,"ي",1,0],["فمن حبهم يحظى بأنظار جدهم","وتجري على وفق المراد أُمورهُ",75,"ه",1,0],["فمن حرة بز منها الخمار","ومن طفلة بز خلخالها",76,"ل",3,0],["فمن حكمه إبداؤنا وأمورنا","ذوات ارتباط لا ذوات توحد",77,"د",1,0],["فمنحتها من نور مجدك جذوة","فإليك فخر بنى الزمان يعود",78,"د",1,0],["فَمَنْ حَبَتْهُ هذه","سبحانَ رَبٍّ رَزَقه",79,"ق",2,0],["فمن حرق فحم الأرض ماسٌ مشَعشَعٌ","ومن حرق فحم الروح هذي الفرائد",80,"د",1,0],["فمن حرِّ فرقتكم والجفا","وجور هواكم عذابي أليم",81,"م",1,0],["فمن حرّة تسبى بعين حماتها","واخرى تقاسي لوعة الثكل والفقد",82,"د",1,0],["فمن حاد عنه ضل عن طرق الهدى","ومن ضل لا يهدي ولا يهتدي فيه",83,"ي",2,0],["فَمَن حَصَّلَ الأَموالَ فَهيَ حِبالُهُ","إِلى الفَوزِ بِالدارَينَ أَعلى المَراتِبِ",84,"ب",1,0],["فمن حيا قبل الموت ماتت حياته","ومن حيا بعد الموت حيا حقيقة",85,"ه",1,0],["فمن حظ ومن خط شريفٍ","ومن نظم ومن نثر اللآلي",86,"ل",2,0],["فمَنْ حاتِمٌ في الجودِ لو أنّ حاتِماً","رآه غَدا في النّاسِ يَطلُبُ رِفدَهُ",87,"د",2,0],["فَمنحتَهُم نَظراً وَفِضت عَلَيهِمُ","نِعَما فَأَنتَ بِذا وَذا تَتَصدَّقُ",88,"ق",1,0],["فمن حرم المختار بالعنف والجفا","لقد اخذوه جهرةً من مصلاه",89,"ا",2,0],["فمن حائز نُعمى أبيه وأمه","إلى خاسر رفديهما أو مطرَّحِ",90,"ح",1,0],["فَمِن حَولِ زَفسَ لًقَد رَقَبُوا","فَقَامَ بِهِم فُوِسذٌ يَصخَبُ",91,"ب",1,0],["فمن حاذفٍ فوق العجال بعاملٍ","تذلق حداه وأنفذ بالحذف",92,"ف",1,0],["فَمن حازَ الجَوائزَ نالَ عزّاً","وَمَن يُحرَم فَيَلقى بالهَوانِ",93,"ن",1,0],["فَمنحتهُ الكهنوت اسمى رتبةً","بعلو المَلائك بِالكَرامةِ موقفا",94,"ف",2,0],["فَمن حَلبٍ شُموس الفَضل ذرَّتَ","وَقَد سَطَعت أَشعتها السَنيَّه",95,"ي",2,0],["فمنحت النفس النفيسة منه","مستميحالك انتحى فاجتداكا",96,"ك",2,0],["فمنحتَني وهديتَني من حَيرتي","حتَّى كأنَّكَ ليَ بصنُعِكَ تربأُ",97,"ا",1,0],["فَمن حَلَّ فيها طابَ حَيّاً وَمَيّتاً","فطيبَة قد طابَت وَلَم تَقبل اللوثا",98,"ث",2,0],["فمن حب الخليل تفر منه","وهذا كله من كذب حبك",99,"ك",1,0],["فمن حياها يا رضي حماها","أرجوك يا رب يا ودود",100,"د",1,0],["فَمَن حَفَّهُ نورُ الرَسولِ يَخوضُ مِن","بِحارِ شُهودِ الذاتِ في كُلِّ لُجَّةِ",101,"ه",1,0],["فمن حيث شاءت أهَبَّتْ صباً","ومن حيث شاءت أهبَّت جَنوبا",102,"ب",2,0],["فمنحته صدي لعلمي أنه","قد قيل: كل يقتدي بقرينه",103,"ه",1,0],["فمن حاد عنه حاد عن منهج الهدى","وفاقد نهج الحق والدين فاقده",104,"د",2,0],["فَمَنْ حَوَّلَ الأفقَ قَبْرَاً عَمِيقَاً","وَمَنْ ألبَسَ البَدْرَ وَجْه المَحاقْ",105,"ق",1,0],["فمن حسن هاد حسينا نقيبة","جواد ندى والكل كهف ومنجد",106,"د",1,0],["فمن حباه بها الرحمن فاه بها","حتى ولو ما قَرَا حرفا ولا كتبا",107,"ب",2,0],["فَمِنْ حُبِّ\" آفْلُو\" صَغِيراً تَرَى","بَرِيقَ مَبَاسِمِهَا كَاللُّجَيْن",108,"ن",1,0],["فَمِنْ حَظِّ أَحْدَاثٍ مَضَتْ سَهْمُ وَقْتِهَا","وَتَفْنَى كَما يَفْنَى الْكَثِيرُ مِنَ الْفَانِي",109,"ن",2,0],["فمن حذري وريت بالبان والنقا","