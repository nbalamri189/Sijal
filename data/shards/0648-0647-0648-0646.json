{"poems":[[55,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[55,"صبرت عنك فلم ألفظك من شبع","https://www.aldiwan.net/poem30133.html","البسيط"],[55,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[55,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[95,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[90,"قل لسلمان بعدما كان حرا","https://www.aldiwan.net/poem44799.html","الخفيف"],[53,"إن ابن عمار عزير العالم","https://www.aldiwan.net/poem66075.html","الرجز"],[94,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[91,"أنصتوا أنصتوا فقد طاف بالورد","https://www.aldiwan.net/poem44623.html","الخفيف"],[64,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[64,"أيمن مولود رأيناه في","https://www.aldiwan.net/poem52203.html","السريع"],[60,"فتى كان يدنيه الغنى من صديقه","https://www.aldiwan.net/poem31004.html","الطويل"],[60,"وهون عليك فإن الأمور","https://www.aldiwan.net/poem31047.html","المتقارب"],[89,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[54,"تضمنت لي الحاج","https://www.aldiwan.net/poem27199.html","الهزج"],[48,"تباركت إن الموت فرض على الفتى","https://www.aldiwan.net/poem22642.html","الطويل"],[48,"عمى العين يتلوه عمى الدين والهدى","https://www.aldiwan.net/poem23211.html","الطويل"],[48,"سأرحل عن وشك ولست بعالم","https://www.aldiwan.net/poem23290.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[92,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[124,"ألا عد إلى العهد الذي كنت أحمد","https://www.aldiwan.net/poem49293.html","الطويل"],[131,"لو أن المنايا حدن عن ذي مهابة","https://www.aldiwan.net/poem24265.html","الطويل"],[135,"أرث جديد الحبل من أم معبد","https://www.aldiwan.net/poem24162.html","الطويل"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[159,"ليل شعر من فوق صبح جبين","https://www.aldiwan.net/poem55611.html","الخفيف"],[164,"يا من بنعماه لحمي نابت ودمي","https://www.aldiwan.net/poem58990.html","البسيط"],[178,"أمغنية مع الظلم الخطوب","https://www.aldiwan.net/poem46064.html","الوافر"],[203,"ما لك عند الحبيب عذر","https://www.aldiwan.net/poem45597.html","مخلع البسيط"],[242,"صبا نجد ألا هبي علينا","https://www.aldiwan.net/poem19274.html","الوافر"],[257,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[280,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[287,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[295,"بلبل في الرياض يلهمه الوحي","https://www.aldiwan.net/poem11715.html","الخفيف"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[369,"نصرت على الأعداء فليهنك النصر","https://www.aldiwan.net/poem60900.html","الطويل"],[376,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[406,"هو الحب الكبير","https://www.aldiwan.net/poem10294.html","عموديه"],[408,"هم أودعوه الذي أودعوا","https://www.aldiwan.net/poem46728.html","المتقارب"],[409,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[445,"هربنا إليكم فآويتمونا","https://www.aldiwan.net/poem34765.html","المتقارب"],[445,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[466,"يقر بعيني أن أراها مغيرة","https://www.aldiwan.net/poem15105.html","الطويل"],[466,"أقول ودمعي مستهل وددتني","https://www.aldiwan.net/poem15113.html","الطويل"],[466,"خليفة الله مالي كلما بسطت","https://www.aldiwan.net/poem15280.html","البسيط"],[466,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[466,"تبلج دين الله في كل خطة","https://www.aldiwan.net/poem16263.html","الطويل"],[556,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[556,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[556,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[556,"سلام على العمل الصالح","https://www.aldiwan.net/poem47889.html","المتقارب"],[563,"ظهر النور من النور ولا","https://www.aldiwan.net/poem33581.html","الرمل"],[563,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[563,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[563,"عندنا سر عجيب خطرا","https://www.aldiwan.net/poem34522.html","الرمل"],[572,"تجنت وما لي في التجني من ذنب","https://www.aldiwan.net/poem69786.html","الطويل"],[580,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53744","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122599","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86877","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38202","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70808","السريع"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90668","الطويل"],[1476,"","https://poetry.dctabudhabi.ae/diwan/poem/72999","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82657","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82666","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79990","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108562","الخفيف"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104140","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114707","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100461","المتقارب"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121907","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28055","الخفيف"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120729","الطويل"],[2415,"","https://poetry.dctabudhabi.ae/diwan/poem/146788","المجتث"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93697","الطويل"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117823","الطويل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144200","البسيط"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101954","الخفيف"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198414","المتقارب"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79721","المتقارب"],[3095,"","https://poetry.dctabudhabi.ae/diwan/poem/97808","الطويل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138454",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140286",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92017","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91294","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34672","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135864","الرجز"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2524","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17757","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28923","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4717,"الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=199842",""],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[4767,"ههنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=197295",""],[4858,"تغير صديق","https://www.poetsgate.com/ViewPoem.aspx?id=35296",""],[4869,"رمح جساس","https://www.poetsgate.com/ViewPoem.aspx?id=151701",""],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""]],"verses":[["وَهَوَّنَ تَقديمَ العَدوِّ بِغُصَّةٍ","وُلوجُ الرَدى في أُسرَتي وَقَبيلي",0,"ل",2,0],["وَهَوَّنَ الوَجدَ أَنَّ المَوتَ مُشتَرَكٌ","فينا وَأَنّا لِذا الماضي مِنَ التَبَعِ",1,"ع",1,0],["وَهَوَّنَ صَولَتَهُ أَنَّني","أَرى العَيشَ ثَوبَ بِلىً مُستَعارا",2,"ر",2,0],["وَهَوَّنَ عِندي ما بِقَلبي مِنَ الصَدى","ظِماءٌ تُجافي مَورِدَ الماءِ لُغَّبُ",3,"ب",1,0],["وَهَوَّنَ العُمْرَ خُسْراً","وَعَظَّمَ العِرْضَ دينَا",4,"ن",2,0],["وهو نقض لما جرى من عهود","حكمها من خِداعهم مستعار",5,"ر",1,0],["وهْو نسيمُ الروح للمُناسِمِ","ريحانةٌ للصاحب المنادمِ",6,"م",1,0],["وَهْوَ نايُ الجَمالِ والحبِّ والأَح","لامِ لكنْ قَدْ حَطَّمَتْهُ الدَّواهي",7,"ي",1,0],["وهو نار من لوعة القلب يبقى","صاعدا في الفضاء منها اللهيب",8,"ب",1,0],["وهو نارُ لسُمِنا وبها التد","بير بدء أمرنا والأخيرِ",9,"ر",1,0],["وهو نحاس الحكماء الذي","صَدّهُ في التركيب أو زَنجَروا",10,"ر",3,0],["وَهَوّنَ وَجدي أَنَني سَوفَ أَغتَدي","عَلى إِثرِهِ يَوماً وَإِن نَفَسَ العُمرُ",11,"ر",1,0],["وَهَوِّن عَلَيكَ فَإِنَّ الأُمورَ","بِكَفِّ الإِلَهِ مَقاديرُها",12,"ه",2,1],["وَهَوَّنَ الأَمْرَ عِنْدِي أَنَّ كُلَّ فَتَى","وَإِنْ تَمَلَّأ مِنْ مَاءِ الصِّبَا فَانِي",13,"ن",2,0],["وَهَوَّنتَ وَعَظَّمتا","وَأَسرَفتَ وَأَفرَطتا",14,"ت",2,0],["وَهَوَّنَ مانَلقى مِنَ البُؤسِ أَنَّنا","بَنو سَفَرٍ أَو عابِرونَ عَلى جِسرِ",15,"ر",1,0],["وَهَوَّنَ أَرزاءَ الحَوادِثِ أَنَّني","وَحيدٌ أُعانيها بِغَيرِ عِيالِ",16,"ل",1,0],["وَهَوَّنَ إِعدامي عَلَيَّ تَحَقُّقي","بأَنّي وَإِن طالَ التَمَكُّثُ أُعدَمُ",17,"م",1,0],["وهَوَّنْتُ الخُطوبَ عليّ حتى","كأني صِرتُ أمْنحُها الوِدادا",18,"د",2,0],["وَهَوَّنَ الْخَطْبَ عِنْدِي أَنَّنِي رَجُلٌ","لاقٍ مِنَ الدَّهْرِ مَا كُلُّ امْرِئٍ لاقِي",19,"ق",2,0],["وهِّونَ من حُرقتي أن أرى","دَمَ الناس عند الليالي هدر",20,"ر",1,0],["وهون عندي ما أعاني من الجوى","يعقيني أن البعد أحجى وأرشد",21,"د",1,0],["وَهَوَّنَ وَجدي أَنَّني لَم أَكُن لَهُ","كَطَيرِ الشِمالِ يَنتف الريشَ حاتما",22,"م",2,0],["وَهَوَّنَ وَجدي أَنَّني لَم أَقُل لَهُ","كَذَبتَ وَلَم أَبخُل بِما مَلَكَت يَدي",23,"د",2,0],["وَهَوَّنَ الحَمدَ عِزُّ المالِ عِندَهُمُ","فَعَزَّ عِندَكَ حَتّى هانَتِ البِدَرُ",24,"ر",1,0],["وَهْوَ نَوْعانِ فيهِما صُفْرَةُ العا","شِقِ مِنْ فَوْقِ حُمْرَةِ المَعْشُوقِ",25,"ق",1,0],["وهون الأمر ان لا عين مبصرة","إلا تفرق بيني النور والظلم",26,"م",1,0],["وَهَوَّنَ بَعْضَ مَا أَلْقَاهُ أَنِّي","نَقِيُّ الْجَيْبِ مِنْ دَنَسِ الْعُيُوبِ",27,"ب",1,0],["وهونِ الخطبَ كم عسيرٍ","أعقبهُ في الأمورِ يسرُ",28,"ر",1,0],["وَهَوَّنَ وَجْدَنَا أَنَّا مَتَى مَا","تَلَذَّذْنَا بِذِكْرِهِمُ انْتَشَيْنَا",29,"ن",2,0],["وَهوَّن الوجد إِنّي لا أَرى أَحَداً","بِفُرقة الأَلِف يَوماً غير مُمتَحَنِ",30,"ن",1,0],["وَهَوَّنَتِ الجُلّى عَلَيها دَقائِقٌ","مِن اللحظِ أَعْيا بَعضُها كُلّ شارِح",31,"ح",1,0],["وَهَوَّنَ عِندي اليَأسَ مِن عَودَةِ الصِبى","رَجاءُ صَلاحِ الدينِ أَن يَهَبَ الوَفرا",32,"ر",2,0],["وهو نار السعير إن عظم الخطبُ","عدو اللئام في أوطانه",33,"ن",2,0],["وهو نايٌ نفخَت فيه","الأعصاير فناح",34,"ح",1,0],["وهو نايٌ وهو كاس","وهو قلبٌ وهو جفنُ",34,"ن",1,0],["وهَوَّنَ فَقْدُ الفَجرِ أن كان بَعدَهُ","من الشَّمسِ ما يُنْسَى لمَوْضِعِه الفَجر",35,"ر",1,0],["وهوَّنَت ما عزَّ مِن قَصدِه","وما عزَّ من قَصدِه لم يَهُن",36,"ن",1,0],["وهوَّنَ ما أواجه من صعابٍ","وصيَّر مرَّها حُلْوَ المذاقِ",37,"ق",1,0],["وهَوَّنَ قومٌ عَليهِ الْهوى","فأصبحَ مِن وردِه يكرعُ",38,"ع",1,0],["وهوّن هذا إن عاقبة الأسَى","سرور به يفنى من الغيظ حُسَّدي",39,"د",2,0],["وهَوَّنَ أَقْدارَنا الإِغْتِرابُ","عَلَى كُلِّ خَلْقٍ فأَكْرَمْتُمُونا",40,"ن",2,0],["وَهَوْنُ هَوَانِها فِي كلِّ عَيْنٍ","جديرٌ أن يعِزَّ لَهُ العزاءُ",41,"ا",2,0],["وهون وجدي أن تراخت منيةٌ","ولم يكتسف بدر العلاء سرارُ",42,"ر",1,0],["وهَوَّنَ وجْدي أنه ماتَ ميتةَ ال","صريعاً بين مجدٍ ومَفْخرِ",43,"ر",1,0],["وهوِّنوا المالَ في إحْراز حمدكمُ","فالحمدُ للمُقْتني أبقى من المال",44,"ل",1,0],["وهَوَّنَ وجْدي بالظُّلامةِ أنني","مدحْتُك والمُنْثي بفضلكَ فاخِرُ",45,"ر",1,0],["وهَوَّن جَدْب العام والمحل عارقٌ","بنانُكَ تَهْمي بالنَّوالِ وتهْمُرُ",46,"ر",1,0],["وهوّن وَجْدي أَنّ قتلاً أراحَهُ","ولم يتحمّلْ للِّئامِ الأياديا",47,"ي",2,0],["وهوّن رُزءَك مَن لم يُحِطْ","بأنّي أعالجُ منه العسيرا",48,"ر",2,0],["وهوّنَ ما ألْقى من الدّهرِ أنّه","تعمّدنِي بالغدر فيمن تعمّدا",49,"د",2,0],["وهوّن رُزْءَك أنّي أقولُ","مضيتَ إلى مُنيةِ الفارحِ",50,"ح",1,0],["وهو نحن الآن نبديه لكم","كيف شئنا واضحاً مكتملا",51,"ل",2,0],["وهو نجم بدا وبدر وشمس","ثم كان امتيازه بالأفول",52,"ل",1,0],["وهو نور بدت به ظلمات","هن سحقٌ جميعهنَّ ومحق",53,"ق",1,0],["وهو نور المصطفى حتى كما","جاءنا نور على نور جرى",54,"ر",2,0],["وهوّنَ ما بي بيتُ شِعْر سَمِعْتُهُ","تَغَنَّتْ بِهِ يوماً معلِّلَةً الشُّرْبَ",55,"ب",1,0],["وهوَّنْتَ أَمْرَ فِرَاقي عَلَيْكَ","فما هوَّنَ المرءُ لم يَصْعُبِ",56,"ب",1,0],["وهْو نَذْرٌ عليَّ في كُلِّ عام","إِنْ قَضَى الله الْبرْءَ فِيه وَيَسَّر",57,"ر",1,0],["وهَوّنَ وَجْدِي أنّ من عاش بَعدَهُ","يُلاقي الذي لاقى وإن مُدَّ في العمرِ",58,"ر",1,0],["وهوّنَ وَجْدِي أنِّنِي لا أرَى امرءاً","من الناس إلاّ وهو مُغضٍ على وَتْرِ",58,"ر",1,0],["وهَوَّن وَجدي في عَليٍّ وحَسرتي","وما بيَ أنّي بَعدهُ غيرُ خالِد",59,"د",1,0],["وَهوَ نَعم المُجير في كُل خَطب","لِنَزيل في قَومه مَوتور",60,"ر",1,0],["وَهوَ نارٌ لَيت لي فيها الخُلودْ","لا أَرى فيها سِواها مِن نَعيم",61,"م",1,0],["وهْو نَهيمٌ في البرايا على","مال البرايا وعلى نفسه",62,"س",2,0],["وهوَّنَ عندي فقدَه أنَّ شخصَهُ","على كلِّ حالٍ بين عينيَّ ماثِلُ",63,"ل",1,0],["وهَوَّنَ وَجدي أنني لم أَقُل له","كذبتَ ولم أبخل عليه بماليا",64,"ي",2,0],["وَهَوّن وَجدي أَنّ يَومك مُدرِكي","وَأَنّي غَدا من أَهل تِلكَ الضَّرائِح",65,"ح",1,0],["وَهَوَّنَ وَجدي فيكَ أَنّ أَمامَنا","سِوى دارنا داراً سَتَجمَعُنا مَعا",66,"ع",2,0],["وهوَّن فقدان النساء مؤنّب","يعيب الأسى لو شئت أوسعته ثلبا",67,"ب",2,0],["وهوَّن فقدان الرجال وعنده","على زعمه فيما يرى هوَّن الخطبا",67,"ب",2,0],["وهو نورٌ به توقد ذهني","وهو سورٌ به تمرد صرحي",68,"ح",2,0],["وهون وجدي أني سوف أغتدي","على أثره يوماً وإن نفس العمر",69,"ر",1,1],["وهون في اقاصي الناس هين","وهون في العشيرة غير هين",70,"ن",1,0],["وهَوَّن خَطبَ الشَّامَتينَ مصانِعٌ","لها دونَ هذا الحُرّ أَلسِنَةٌ لُدُّ",71,"د",1,0],["وهون عليك فإن الخطوب","إذا عظمت موقعاً في زوال",72,"ل",1,0],["وهو نور في لمعة قد تراءى","قد توارى من ظله في حجاب",73,"ب",1,0],["وهون فقد من يمضى علينا","حوادثها اللواتى لا تصاع",74,"ع",1,0],["وهو نجم كما تراه ولكن","جعلَ الجوّ للرجوم مجالا",75,"ل",2,0],["وهو ناموسها العليم بما قد","عملته بجهرها وخفاها",76,"ا",3,0],["وهوَّن عندي كلَّ خَطبٍ مصابُهُ","فَبَعدَ عليِّ لستُ أبكي لمفقودِ",77,"د",1,0],["وهون الأمر فيما","ايقنت أن سوف ينفدْ",78,"د",1,0],["وَهوّن في الإِسلام كُلَّ مُصيبةٍ","مصاب الحسين ابن النَبي المُكرم",79,"م",1,0],["وهَوَّنَ وَجدي إذ أصابت رماحُنا","عشيةَ خَوَّ قيسِ بن جابرِ",80,"ر",1,0],["وهوّن اللومَ فيك حسنٌ","يلومُ في الحبّ منْ يلومُ",81,"م",1,0],["وهو نور الإله يهدي إليه","فاسأل المهتدين عمن هداها",82,"ا",3,0],["وهون عليك كثير الحياة","فسكناك في قبرك الأكثر",83,"ر",1,0],["وهونت النفس أمر الصلاح","إليه ولامته في الاعتصام",84,"م",1,0],["وَهوّن وَجدي أنّني سوفَ أَغتدي","عَلى إِثرهِ يَوماً وإِن طالَ بي العمرُ",85,"ر",1,0],["وهو نذيرُ كلِّ أهل الكفرِ","والجنُّ جاءتهم نجومٌ راميه",86,"ه",1,0],["وهو نورٌ لم تشبه ظلمةٌ","وبه كل منيرٍ قد أنارا",87,"ر",2,0],["وهون على الروح الممات فإنها","تحب البقا لكن لقاك هواؤها",88,"ا",3,0],["وهوّن عندي خَطبَ دُنياي أَنني","رَأَيتُ ثَرى جدي وَقد زُرت والدي",89,"د",2,0],["وَهوّن يَهون الخَطب وَاللَه فاعلٌ","وَمن همّ بِالإِقدام فَالنَصرُ خادمه",90,"م",2,0],["وهوَ نصفانِ من قضيبٍ ودعصٍ","زانَ صدرَ القضيبِ رمانتانِ",91,"ن",1,0],["وهوِّنِ الموتَ عليَّ ولذيذ","يكون لي كعسلٍ مع النبيذْ",92,"ذ",1,0],["وَهَوَّنَ وَجدي أَنَّني لَو رَأَيتُهُ","يُساوِرُهُ ذو لِبدَتَينِ مُكالِبُ",93,"ب",1,0],["وهو نقي العرض أن يعابا","والعَرض ضد الطول لا ارتيابا",94,"ب",2,0],["وَهَوَّنَ وَجدي عَن خَليلِيَ أَنَّني","إِذا شِئتُ لاقيتُ اَمراً ماتَ صاحِبُه",95,"ب",2,0],["وهَوَّنَ وَجدي بعدما كدتُ أنتحي","على السيفِ حتى يبلغَ الجوف والحشا",96,"ا",1,0],["وَهَوِّن عَلى النَفسِ اِرتِكاباً لِهَولِها","فَغَيرُ مُحِبٍّ مَن دَهَتهُ الفَجائِعُ",97,"ع",1,0],["وهو نور الشمس في رأد الضحى","وهو نبراس الهدى في الظلمات",98,"ت",1,0],["وهوِّنْ عليكَ .. فكلٌّ يزولُ","عصورُ الشقاءِ ، وعصرُ الهنا",99,"ا",1,0],["وهو نبع ماؤه يجري زلالاً","يرتوي منه الذي ما زال ناهل",100,"ل",1,0],["وهو نبع الندى الذي كم إليه","جاء مسترفدٌ فسال العطاء",101,"ا",2,0],["وهوّنتِ النفْسُ هجْرَ الحبيبِ","وحُبَّ الحقودِ ونتْنَ القَذَر!",102,"ر",1,0],["وهوّن ترآهآ بخفةٍ تشبه اكيآس","تلعب ريآح الطآمعين بكنفهآ",103,"ف",3,0],["وهو نذر الذي ينذره","فاصطفاه عذراً أو نذرا",104,"ر",2,0],["وهو نهبٌ لحادثاتِ الليالي","وحلالٌ للدهر قرعُ صَفاتهْ",105,"ت",2,0],["وهوّن ما ألقاهُ من لاعج الضنى","وخفّف ما أشكوهُ من ثائرِ الفكر",106,"ر",1,0],["وهو نور الأكوان حقا وعين","وعين الرحمة الربانية المهداة",107,"ه",1,0],["وهون وجدي بأن لا أرى","على هالك بعده آسف",108,"ف",1,0],["وهون الخطب أن الله ينظره","وفي سبيل رضاه خف ما ثقلا",109,"ل",2,0],["وهو نجم , ما أنجبت مثله الأر","ض , ولا آدم ولا حواء",110,"ا",2,0]]}