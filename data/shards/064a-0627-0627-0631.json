tps://www.poetsgate.com/ViewPoem.aspx?id=212986",""],[5277,"عراقي","https://www.poetsgate.com/ViewPoem.aspx?id=199943",""],[5318,"في حُبِ إربد","https://www.poetsgate.com/ViewPoem.aspx?id=206817",""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""],[5376,"الشعر منبرنا والحق والقلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188405",""],[5376,"يا ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5376,"للقدس عين من الاشواق لم تنم","https://www.poetsgate.com/ViewPoem.aspx?id=188549",""],[5376,"يا نيل مصر","https://www.poetsgate.com/ViewPoem.aspx?id=215093",""],[5431,"جذب الظباء السمر إذْ تردُ","https://www.poetsgate.com/ViewPoem.aspx?id=198444",""],[5452,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=119185",""],[5458,"ألا بذكر الله تطمئن القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=72385",""],[5458,"يا رب عفوك","https://www.poetsgate.com/ViewPoem.aspx?id=72283",""],[5542,"حسرة في قلب امرأة صومالية","https://www.poetsgate.com/ViewPoem.aspx?id=10029",""],[5612,"يا أرْضَ طَيْبَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=186739",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5736,"بنت غزة","https://www.poetsgate.com/ViewPoem.aspx?id=203818",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[5771,"صَوتٌ لا يَموت","https://www.poetsgate.com/ViewPoem.aspx?id=189449",""],[5939,"لم يكن للورد ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=178580",""],[5957,"في ذكرى الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=177637",""],[5957,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180143",""],[6144,"الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=13796",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[3155,"الأريج القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75609&r=&rc=32",""],[6276,"قصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80091&r=&rc=223",""],[6291,"المجدُ والتاريخ ُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87684&r=&rc=18",""],[6340,"غادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85846&r=&rc=11",""]],"verses":[["يا أَرضُ ناشَدتُكِ أَن تَحفَظي","تِلكَ الوُجوهَ الغُرَّ وَالأَعيُنا",0,"ن",2,0],["يا أَرضُ ما العُذرُ في شَخصٍ عَصَفتِ بِهِ","بَينَ الأَقارِبِ وَالعُوّادِ وَالخَوَلِ",1,"ل",1,0],["يا أَراكَ الحِمى تُراني أَراكا","أَيُّ قَلبٍ جَنى عَلَيهِ جَناكا",2,"ك",2,1],["يا أَربَدَ الخَيرِ الكَريمَ جُدودُهُ","أَفرَدتَني أَمشي بِقَرنٍ أَعضَبِ",3,"ب",1,0],["يا أرضنا هذا أوان تَحْيَيْن","قد طالما حُرِمتِ نؤَ الفرغين",4,"ن",1,1],["يا أرضُ هل حُمِّلْتِ في وُسْعها","باللَّه مذ حُمِّلْتِ أَعباكِ",5,"ك",1,0],["يا أَرزُ صَفِّق وَيا أَبنائُهُ اِبتَهِجوا","قَد أَصبَحَ السِربُ في أَمنٍ مِنَ السَيِّدِ",6,"د",1,0],["يا أَرضَ أورُبّا وَيا أَبنائَها","في عُنقِ مَن هَذا الدَمُ المَطلولُ",7,"ل",1,0],["يا ارض انا تاركو","ه تحت ردم في رحابك",8,"ك",1,0],["يا أرض أنت الأم للإنسان","يا أم ضميني إلى الأحضان",9,"ن",1,1],["يا أَرضُ مُذ فَقَدَ المُعَلِّمُ نَفسَهُ","بَينَ الشُموسِ وَبَينَ شَرقِكِ حيلا",10,"ل",2,0],["يا أريحيَّةَ شوقٍ هيَّجتْ طربي","واسترقصتني وأصحابي وكيراني",11,"ن",2,0],["يا أرضُ تِيهاً فقد ملكتِ به","أعجوبة من محاسنِ الصُّوَرِ",12,"ر",1,0],["يا أرجوان الغروب مهلا","ولتئد أيها العقيق",13,"ق",1,0],["يا أرضُ لولا البِرُّ من آبائِنا","ما غَيّبَتْ تِلكَ الكنوزَ قُبورُ",14,"ر",1,0],["يا أَرضَ عَمروٍ جَدَتكِ أَمطارُ","فيكِ لِقَلبي ما عِشتُ أَوطارُ",15,"ر",1,1],["يا أرضُ كيفَ حملتِ ثِنْيَ نجادهِ","والنصرُ أعظَمُ منكِ والتّمكين",16,"ن",1,0],["يا أَرحَمَ الناسِ لي كا","نَ مَرَّةً ما دَهاكا",17,"ك",2,0],["يا أَرضُ وَيحَكِ أَكرِميهِ فَإِنَّهُ","لَم يَبقَ لِلعَتكِيِّ فيكِ ضَريبُ",18,"ب",1,0],["يا أَرض أَهلي وَمالي","فداك مالي وأَهلي",19,"ل",2,0],["يا أَرض ماءك ابلَعي","وَيا سماء أَقلعي",20,"ع",2,1],["يا أَرض أَوطاني الَّتي أَحببتها","مني عليك تحيَّة وَسلام",21,"م",1,0],["يا أَرض إنك في زَمان واحد","مَرعى الظباء وَمربض الآساد",22,"د",1,0],["يا ارض لولا سعيه","لم تدركي يا أرض مجدا",23,"د",2,0],["يا أرضُ ما كنتِ لنا منزلا","ما أنتِ إلا موبقُ الأبرياء",24,"ا",2,0],["يا أرضُ هذا الوحيُ من عالمِكْ","الماءُ والطينُ به يشهدانْ",24,"ن",1,0],["يا أرضُ ولّى عهدُ نوحٍ وزالْ","فمن لكِ اليومَ بطوفانِهِ",24,"ه",1,0],["يا أرض ناديتُ فلم تسمعي","أنكرتِ صوتي وهو من قلبكِ",24,"ك",1,0],["يَا أَرْحَم الرَّاحِمِينَ يَا مَنْ","يَحْمِي ضَعِيفاً بِهِ اسْتَجَارْ",25,"ر",1,0],["يَا أَرَقَّ الوَرَى فُؤاداً وَأَنْدَا","هُمْ يَداً بِالصِّلاَتِ وَالأَلْطافِ",26,"ف",1,0],["يا أرْضُ وَيْحَكِ قَدْ رَوِيتِ فأَسْئِري","وكَفَاكِ مِنْ تِلْكَ الدِماءِ كَفاكِ",27,"ك",1,0],["يا أرض أوربّا ويا أبناءها","في عنق من هذا الدّم المطلول؟",28,"ل",1,0],["يا أرز صفق ، ويا أبناءه ابتهجوا ،","قد أصبح السرب في أمن من السيّد",29,"د",1,0],["يا أَرْبدَ الخيرِ الكريمَ جدودُهُ","خليتني أمشي بقرنٍ أغضبِ",30,"ب",1,0],["يا أرحمَ النَّاسِ بِالإنسانِ قاطِبَةً","حَوَّاءُ، حَوَّاءُ، تَستَجْدِيكَ والرَّجُلُ",31,"ل",1,0],["يا إِربد الخرزات حياك الحيا","رغم الجفاء ورغم كل تقاطع",32,"ع",1,0],["يا أربع الشؤم قد أودى بطارفنا","مع التليد زمان قد تحدانا",33,"ن",2,0],["يا أربعاً ما وراء الحصن عامرة","بما تعانيه من ظلم وطغيان",34,"ن",1,0],["يا أردنيات إن أَوديت مغترباً","فانسجنها بأبي أنتن أكفاني",34,"ن",2,0],["يا أَربُعَ الخيفِ يَسقي الماءَ واديها","بِسَفحه وَدِما العُشاقِ تَسقيها",35,"ي",3,1],["يا أرفعَ الخلفاء قَدْرا يا إما","مَ الحقِّ دعوةُ صادقٍ في قِيله",36,"ل",2,0],["يا أَرَجَ المُروج وَالأَكهامِ","يا وَتَراً أَسمَعَني أَنغامي",37,"ي",1,0],["يا أَرغنَ الوادي وَفي الوادي هَوى","يَصبو إِلَيكَ فُؤادُهُ وَالأَضلُعُ",38,"ع",1,0],["يا أَرزُ لا يُطوى الفُخارُ الَّذي","كانَ سليمانُ لهُ ينشُرُ",39,"ر",1,0],["يا أرض نعمان ووادي مِنى","والخيف لو أن المنى تصدق",40,"ق",1,0],["يا أرغدَ اللَه عيشاً حلَّ فيه كَما","كانَت شمائِلُه الحسناءُ في رَغَدِ",41,"د",1,0],["يا أربعاءٌ لا تدو","ر به محاقات الشهور",42,"ر",1,0],["يا أرض أندلسَ الخضراءَ حيّينا","لعلّ روحاً من الحمراءِ تُحيينا",43,"ن",2,1],["يا أرفعَ الناسِ عند الله منزلةً","متى نرى السيفَ مسلولاً ليشفينا",43,"ن",2,0],["يا أرحم الخلق يوم الحشر والنّدمِ","ارحم عُبيدَك يا ذا الطّول والنِّعمِ",44,"م",1,1],["يا أَرحمَ الرُحَماءِ فضلكَ يَغمرُ الر","راجي وَيسبقُ ظنّه وَنَتيجه",45,"ج",2,0],["يا أَرذل القَوم اللئام إِلى مَتى","أَملي يَعلّله لعلَّ وَهَل عَسى",46,"س",2,0],["يا أراكَ الجِزْعِ هَبْ لي رِيقَها","ولأطرافِكَ فاستَسْقِ الغَماما",47,"م",2,0],["يا أرضَ ناصرةٍ أضحيتِ ناصرةً","عَزائِماً كُنَّ قبلاً ذاتَ أسواءِ",48,"ا",2,0],["يا أرحم الراحمين يا أرحم الراحمين","يا أرحم الراحمين فرج على المسلمين",49,"ن",1,1],["يا أَرضَها أَفدي ذرا","كِ وَمُهجَتي تَفدي ثراكِ",50,"ك",1,0],["يا أرضُ فخراً أخرجتِ مثلَهما","نَعَمْ تملَّيْ محسودةً بهمَا",51,"م",2,0],["يا أرض ليلى والحياء لم يزل","يرش في هطاله تلالها",52,"ل",3,0],["يا أرض جودي بالعطا لمن يشا","ازخرت كترا الفيض من اذناله",53,"ل",2,0],["يا أَرضَ نَجدٍ سقاك اللَّهُ مُنبعقاً","من الغمامِ غزيرَ الماءِ ملآنا",54,"ن",2,0],["يا أرحمَ الراحمينَ المستغاثُ بهِ","عندَ البلاءِ الذي قد ضَيَّقَ السُّبُلا",55,"ل",2,0],["يا أرضَ بيروتَ بُشرَانا وبُشراكِ","لقد أتى اليومَ مَوْلانا ومَوْلاكِ",56,"ك",1,1],["يا أرضَ سُوريَّةَ المسعودَ طالِعُها","حَمْداً وشُكراً فإنَّ اللهَ أعطاكِ",56,"ك",1,0],["يا أرض سامرّاء طِبتِ ففاخري","كلّ البقاع برفعةٍ وعلاءِ",57,"ا",2,0],["يا أرض مصرٍ لي بأَرضكِ درَّةٌ","بخلَ الزمان بمثلها فتعذَّرا",58,"ر",2,0],["يا أرض زحلةَ لي في حبها شَغَفٌ","إذ في حماها شقيق الروح محتجبُ",59,"ب",1,0],["يا أَرزةً في رُبَى لبنان مغرسها","وفي المَغارب أَغصانٌ لها ارتفَعَت",60,"ت",1,0],["يا أربعين جواداً إن حسبكم","لطف المهيمن فلترضوا بما فعلا",61,"ل",2,0],["يا أرضنا الخضراء مضمار السنا","يسرحت عيني في بديع رباك",62,"ك",1,0],["يا أَربُعا ثقُلتْ منهن أطنابُ","هل جاورَتْكنَّ بعد البين أعرابُ",63,"ب",1,1],["يا إربليّين اسمعوا كلمةً","قد قال شيطانَي واسترسلا",64,"ل",2,0],["يا أرحم الرحما عيالك قد حجا","ما يقتنيه القاحط المجتاح",65,"ح",1,0],["يا أرحم الراحمين العفو عن غرق","لم ينجه العوم من لج تغشاه",66,"ا",2,0],["يا أرحم الراحمين العفو عن دنف","أعينا دواه وجافوه أطباه",66,"ا",2,0],["يا أروع من حقق الضلال برشد","يا أروع من قال في الظلال ومن قال",67,"ل",1,0],["يا أرحم الرحما ما بي سواك وقد","وافيت عبدا ذليلا يائسا دنفا",68,"ف",