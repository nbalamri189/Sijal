{"poems":[[53,"ما أسرع الأيام في طينا","https://www.aldiwan.net/poem29723.html","السريع"],[53,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[4,"طرب الفؤاد وليته لم يطرب","https://www.aldiwan.net/poem21150.html","الكامل"],[37,"يا أرضنا هذا أوان تحيين","https://www.aldiwan.net/poem7645.html","الرجز"],[51,"قولا لسمانة كهف الزنا","https://www.aldiwan.net/poem8123.html","الخفيف"],[91,"يا شاعر الحسن هذي روعة العيد","https://www.aldiwan.net/poem8808.html","عموديه"],[91,"كم قبل هذا الجل ولى جيل","https://www.aldiwan.net/poem9063.html","عموديه"],[89,"لهفي يطول على شبابك","https://www.aldiwan.net/poem44755.html","مجزوء الكامل"],[89,"يا أرض أنت الأم للإنسان","https://www.aldiwan.net/poem45094.html","الكامل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[62,"قد كذب الظن صادق الخبر","https://www.aldiwan.net/poem52383.html","المنسرح"],[97,"كل الورى يدعون حبك","https://www.aldiwan.net/poem25066.html","مجزوء البسيط"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[52,"يا أرض عمرو جدتك أمطار","https://www.aldiwan.net/poem26996.html","المنسرح"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[50,"ما بال عينك دمعها مسكوب","https://www.aldiwan.net/poem64802.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85563","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85344","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[91,"روعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=53024",""],[4,"قَضِّ اللُّبانَة َ لا أبَا لكَ واذْهَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10908&r=&rc=4",""],[118,"العطرُ أنت (1)","https://www.aldiwan.net/poem24028.html","البسيط"],[125,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[125,"ليلاي ليلاي إن الدهر أشقانا","https://www.aldiwan.net/poem23775.html","البسيط"],[125,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[183,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[186,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[224,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[224,"هل إن فكرك من يراعك أسرع","https://www.aldiwan.net/poem41634.html","الكامل"],[224,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[232,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[242,"أودى بي الحزن واغتال الجوى جلدي","https://www.aldiwan.net/poem45759.html","البسيط"],[257,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[282,"يا أرحم الخلق يوم الحشر والندم","https://www.aldiwan.net/poem1389.html",""],[306,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[354,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[365,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[378,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[392,"يا أرحم الراحمين يا أرحم الراحمين","https://www.aldiwan.net/poem54481.html","عموديه"],[394,"دمن عفون بذي الأراك","https://www.aldiwan.net/poem53665.html","مجزوء الكامل"],[459,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[501,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[505,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[552,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[563,"دعوت جنح الدجى مولاي مبتهلا","https://www.aldiwan.net/poem52736.html","البسيط"],[563,"يا أرض بيروت بشرانا وبشراك","https://www.aldiwan.net/poem52776.html","البسيط"]],"verses":[["يا أَرضُ ناشَدتُكِ أَن تَحفَظي","تِلكَ الوُجوهَ الغُرَّ وَالأَعيُنا",0,"ن",2,0],["يا أَرضُ ما العُذرُ في شَخصٍ عَصَفتِ بِهِ","بَينَ الأَقارِبِ وَالعُوّادِ وَالخَوَلِ",1,"ل",1,0],["يا أَراكَ الحِمى تُراني أَراكا","أَيُّ قَلبٍ جَنى عَلَيهِ جَناكا",2,"ك",2,1],["يا أَربَدَ الخَيرِ الكَريمَ جُدودُهُ","أَفرَدتَني أَمشي بِقَرنٍ أَعضَبِ",3,"ب",1,0],["يا أرضنا هذا أوان تَحْيَيْن","قد طالما حُرِمتِ نؤَ الفرغين",4,"ن",1,1],["يا أرضُ هل حُمِّلْتِ في وُسْعها","باللَّه مذ حُمِّلْتِ أَعباكِ",5,"ك",1,0],["يا أَرزُ صَفِّق وَيا أَبنائُهُ اِبتَهِجوا","قَد أَصبَحَ السِربُ في أَمنٍ مِنَ السَيِّدِ",6,"د",1,0],["يا أَرضَ أورُبّا وَيا أَبنائَها","في عُنقِ مَن هَذا الدَمُ المَطلولُ",7,"ل",1,0],["يا ارض انا تاركو","ه تحت ردم في رحابك",8,"ك",1,0],["يا أرض أنت الأم للإنسان","يا أم ضميني إلى الأحضان",9,"ن",1,1],["يا أَرضُ مُذ فَقَدَ المُعَلِّمُ نَفسَهُ","بَينَ الشُموسِ وَبَينَ شَرقِكِ حيلا",10,"ل",2,0],["يا أريحيَّةَ شوقٍ هيَّجتْ طربي","واسترقصتني وأصحابي وكيراني",11,"ن",2,0],["يا أرضُ تِيهاً فقد ملكتِ به","أعجوبة من محاسنِ الصُّوَرِ",12,"ر",1,0],["يا أرجوان الغروب مهلا","ولتئد أيها العقيق",13,"ق",1,0],["يا أرضُ لولا البِرُّ من آبائِنا","ما غَيّبَتْ تِلكَ الكنوزَ قُبورُ",14,"ر",1,0],["يا أَرضَ عَمروٍ جَدَتكِ أَمطارُ","فيكِ لِقَلبي ما عِشتُ أَوطارُ",15,"ر",1,1],["يا أرضُ كيفَ حملتِ ثِنْيَ نجادهِ","والنصرُ أعظَمُ منكِ والتّمكين",16,"ن",1,0],["يا أَرحَمَ الناسِ لي كا","نَ مَرَّةً ما دَهاكا",17,"ك",2,0],["يا أَرضُ وَيحَكِ أَكرِميهِ فَإِنَّهُ","لَم يَبقَ لِلعَتكِيِّ فيكِ ضَريبُ",18,"ب",1,0],["يا أَرض أَهلي وَمالي","فداك مالي وأَهلي",19,"ل",2,0],["يا أَرض ماءك ابلَعي","وَيا سماء أَقلعي",20,"ع",2,1],["يا أَرض أَوطاني الَّتي أَحببتها","مني عليك تحيَّة وَسلام",21,"م",1,0],["يا أَرض إنك في زَمان واحد","مَرعى الظباء وَمربض الآساد",22,"د",1,0],["يا ارض لولا سعيه","لم تدركي يا أرض مجدا",23,"د",2,0],["يا أرضُ ما كنتِ لنا منزلا","ما أنتِ إلا موبقُ الأبرياء",24,"ا",2,0],["يا أرضُ هذا الوحيُ من عالمِكْ","الماءُ والطينُ به يشهدانْ",24,"ن",1,0],["يا أرضُ ولّى عهدُ نوحٍ وزالْ","فمن لكِ اليومَ بطوفانِهِ",24,"ه",1,0],["يا أرض ناديتُ فلم تسمعي","أنكرتِ صوتي وهو من قلبكِ",24,"ك",1,0],["يَا أَرْحَم الرَّاحِمِينَ يَا مَنْ","يَحْمِي ضَعِيفاً بِهِ اسْتَجَارْ",25,"ر",1,0],["يَا أَرَقَّ الوَرَى فُؤاداً وَأَنْدَا","هُمْ يَداً بِالصِّلاَتِ وَالأَلْطافِ",26,"ف",1,0],["يا أرْضُ وَيْحَكِ قَدْ رَوِيتِ فأَسْئِري","وكَفَاكِ مِنْ تِلْكَ الدِماءِ كَفاكِ",27,"ك",1,0],["يا أرض أوربّا ويا أبناءها","في عنق من هذا الدّم المطلول؟",28,"ل",1,0],["يا أرز صفق ، ويا أبناءه ابتهجوا ،","قد أصبح السرب في أمن من السيّد",29,"د",1,0],["يا أَرْبدَ الخيرِ الكريمَ جدودُهُ","خليتني أمشي بقرنٍ أغضبِ",30,"ب",1,0],["يا أرحمَ النَّاسِ بِالإنسانِ قاطِبَةً","حَوَّاءُ، حَوَّاءُ، تَستَجْدِيكَ والرَّجُلُ",31,"ل",1,0],["يا إِربد الخرزات حياك الحيا","رغم الجفاء ورغم كل تقاطع",32,"ع",1,0],["يا أربع الشؤم قد أودى بطارفنا","مع التليد زمان قد تحدانا",33,"ن",2,0],["يا أربعاً ما وراء الحصن عامرة","بما تعانيه من ظلم وطغيان",34,"ن",1,0],["يا أردنيات إن أَوديت مغترباً","فانسجنها بأبي أنتن أكفاني",34,"ن",2,0],["يا أَربُعَ الخيفِ يَسقي الماءَ واديها","بِسَفحه وَدِما العُشاقِ تَسقيها",35,"ي",3,1],["يا أرفعَ الخلفاء قَدْرا يا إما","مَ الحقِّ دعوةُ صادقٍ في قِيله",36,"ل",2,0],["يا أَرَجَ المُروج وَالأَكهامِ","يا وَتَراً أَسمَعَني أَنغامي",37,"ي",1,0],["يا أَرغنَ الوادي وَفي الوادي هَوى","يَصبو إِلَيكَ فُؤادُهُ وَالأَضلُعُ",38,"ع",1,0],["يا أَرزُ لا يُطوى الفُخارُ الَّذي","كانَ سليمانُ لهُ ينشُرُ",39,"ر",1,0],["يا أرض نعمان ووادي مِنى","والخيف لو أن المنى تصدق",40,"ق",1,0],["يا أرغدَ اللَه عيشاً حلَّ فيه كَما","كانَت شمائِلُه الحسناءُ في رَغَدِ",41,"د",1,0],["يا أربعاءٌ لا تدو","ر به محاقات الشهور",42,"ر",1,0],["يا أرض أندلسَ الخضراءَ حيّينا","لعلّ روحاً من الحمراءِ تُحيينا",43,"ن",2,1],["يا أرفعَ الناسِ عند الله منزلةً","متى نرى السيفَ مسلولاً ليشفينا",43,"ن",2,0],["يا أرحم الخلق يوم الحشر والنّدمِ","ارحم عُبيدَك يا ذا الطّول والنِّعمِ",44,"م",1,1],["يا أَرحمَ الرُحَماءِ فضلكَ يَغمرُ الر","راجي وَيسبقُ ظنّه وَنَتيجه",45,"ج",2,0],["يا أَرذل القَوم اللئام إِلى مَتى","أَملي يَعلّله لعلَّ وَهَل عَسى",46,"س",2,0],["يا أراكَ الجِزْعِ هَبْ لي رِيقَها","ولأطرافِكَ فاستَسْقِ الغَماما",47,"م",2,0],["يا أرضَ ناصرةٍ أضحيتِ ناصرةً","عَزائِماً كُنَّ قبلاً ذاتَ أسواءِ",48,"ا",2,0],["يا أرحم الراحمين يا أرحم الراحمين","يا أرحم الراحمين فرج على المسلمين",49,"ن",1,1],["يا أَرضَها أَفدي ذرا","كِ وَمُهجَتي تَفدي ثراكِ",50,"ك",1,0],["يا أرضُ فخراً أخرجتِ مثلَهما","نَعَمْ تملَّيْ محسودةً بهمَا",51,"م",2,0],["يا أرض ليلى والحياء لم يزل","يرش في هطاله تلالها",52,"ل",3,0],["يا أرض جودي بالعطا لمن يشا","ازخرت كترا الفيض من اذناله",53,"ل",2,0],["يا أَرضَ نَجدٍ سقاك اللَّهُ مُنبعقاً","من الغمامِ غزيرَ الماءِ ملآنا",54,"ن",2,0],["يا أرحمَ الراحمينَ المستغاثُ بهِ","عندَ البلاءِ الذي قد ضَيَّقَ السُّبُلا",55,"ل",2,0],["يا أرضَ بيروتَ بُشرَانا وبُشراكِ","لقد أتى اليومَ مَوْلانا ومَوْلاكِ",56,"ك",1,1],["يا أرضَ سُوريَّةَ المسعودَ طالِعُها","حَمْداً وشُكراً فإنَّ اللهَ أعطاكِ",56,"ك",1,0]]}