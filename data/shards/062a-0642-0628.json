aspx?id=199867",""],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[6152,"تقبل الله منكِ الصوم غاليتي","https://www.poetsgate.com/ViewPoem.aspx?id=203315",""],[6152,"مناجاة رمضانية","https://www.poetsgate.com/ViewPoem.aspx?id=204731",""],[5080,"قرأت حروف القهرِ من أول السطرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88141&r=&rc=11",""],[463,"نرقُّ وتقسو بالغوير قلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59978&r=&rc=34",""],[463,"تمناها بجهلِ الظنَّ سعدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60038&r=&rc=94",""],[6315,"الفتاة الراهبة .. الفتاة الهاربة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87578&r=&rc=3",""]],"verses":[["تَقَبَّلتُ مِنهُ ظاهِراً مُتَبَلِّجاً","وَأَدمَجَ دوني باطِناً مُتَجَهِّما",0,"م",2,0],["تَقَبيلَةٌ كانِنتهازِ الصَّقرِ فُرصَتَهُ","بِها التَقى في عِناقٍ خَدُّها وَفَمي",1,"م",2,0],["تَقَبَّل إِن أَتى خَطبٌ","وَأَنفُ الفَحلِ لا يُقرَع",2,"ع",1,0],["تقبّل الزهرة ذات الشذا","طائرة منها إلى أختها",3,"ه",2,0],["تُقَبِّحُ ريحَ القَينِ لَمّا تَناوَلَت","مِقَذَّ هِجانٍ إِذ تُساوِفُهُ فَحلِ",4,"ل",1,0],["تُقبل فيهِ منك خمس أناملٍ","فيحظى كما قد قيل بالعشر والخمس",5,"س",1,0],["تقبل أطراف البساط ثغورهم","ويقصر ثغر الشهب عن طرف الكم",6,"م",1,0],["تقبّل مديحي بالندى مُتقبَّلاً","أو اطرحه بالمنع المبيَّن مطرحا",7,"ح",2,0],["تقبّلها منك امرؤٌ متوقِّعٌ","لها أخواتٍ من أناملِكِ العَشْر",8,"ر",1,0],["تقْبِضْ عليه قَبضَ رام مَعْجِسا","حتى إذا كان حَراً أن يُقلِسا",9,"س",2,0],["تَقَبَّلَ فيكَ اللَهُ بِالحَرَمَينِ ما","دَعا لَكَ حُجّاجٌ هُناكَ وَقُطّانُ",10,"ن",1,0],["تقبَّل ما يَذوبُ لَهُ حَياءً","وَإِن عَذَرَتهُ حالاتُ الفَقيرِ",11,"ر",1,0],["تقبل روحي روحه وتشمُّه","وتشكو إليه ما بها كان ينزل",12,"ل",1,0],["تقبل عزيز المالكين تحية","تقدّمها مصر وتهدى التهانيا",13,"ي",2,0],["تقبل الرأس من تيمان تائبة","عن ذنبها وحبيب القلب غافره",14,"ر",2,0],["تُقبِلُ في مَوكِبٍ","شَقَّ سَناهُ الظُلَم",15,"م",1,0],["تُقَبِّلُ أَفواهُ المُلوكِ بِساطَهُ","وَيَكبُرُ عَنها كُمُّهُ وَبَراجِمُه",16,"م",2,0],["تُقبِلُ مَحفوفَةً مَحاسِنُها","بِأَعيُنِ الناسِ وَالإِشاراتِ",17,"ت",1,0],["تقبّلي من روضة الأ","شعار خير زهرة",18,"ه",1,0],["تُقَبِّلُ الآمالُ منه يداً","فهي لأفواه الوَرَى مُستَلَم",19,"م",1,0],["تُقَبّلُ السحبُ مِنهُ لِلسَّماحِ يداً","لوْ أُلْقيَ البحرُ في مَعروفِها غَرِقا",20,"ق",2,0],["تُقَبِّلُ الرُكنَ رُكنَ البَيتِ نافِلَةً","وَظَهرُ كَفِّكَ مَعمورٌ مِنَ القُبَلِ",21,"ل",1,0],["تَقَبَّلِ المُهرَ مِن أَخي ثِقَةٍ","أَرسَلَ ريحاً بِهِ إِلى مَطَرِ",22,"ر",1,1],["تَقَبَّلتُ الرَبيعَ نَدىً وَبَأساً","وَحَزماً حينَ تَحزِبُني الأُمورُ",23,"ر",1,0],["تَقَبَّلَ مِن خَيفانَةٍ جُرشُعِيَّةٍ","سَليلَةِ مَعروقِ الأَباجِلِ جُرشُعِ",24,"ع",1,0],["تقبل الله من الحواري","واختص بالبيت وبالجوار",25,"ر",1,0],["تَقَبَّلِي شُكْرِي وَإِنْ لَمْ يُثِبْ","فَإِنَّهُ أَفْخَرُ مَا عِنْدِي",26,"د",2,0],["تُقَبِّلُ بِالضَّمِيرِ يَداً أَفَاضَتْ","عَلَيْهَا مِنْ مَوَارِدِهَا العِذَابِ",27,"ب",1,0],["تَقبَلُ مِن مَعشَرٍ يَسُرُّهُمُ","لَو أَنَّ حَبلي مِن حَبلِها اِنقَضَبا",28,"ب",2,0],["تَقْبِسُ الشَّمْسُ نُورَهَا في الصُّبْحِ","وَزُهْرُ النُّجُومِ عِنْدَ الْمَسَاءِ",29,"ا",2,0],["تقبلها الرحمن بالروح جاعلا","لها بين من حازوا الشهادة منزلا",30,"ل",2,0],["تَقبل راحَتي قَلَمي وَطرسي","وَتَجعَل عقدها الزاهي نثارا",31,"ر",2,0],["تقبل الأرض عني فهل نائبتي","إلى رحابك يا سر الوجود سرت",32,"ت",1,0],["تقبس النار وإن طال القدم","من ينابيع الزمان المنصرم",33,"م",1,1],["تَقَبَّل مِنَ المُثني عَلَيكَ اِعتِذارَهُ","فَقَد ضاقَ عَن أَوصافِكَ النَظمُ وَالنَثرُ",34,"ر",1,0],["تقبَّل آثار الأئمة قبله","فلا الظلّ مفقود ولا النّور غائب",35,"ب",1,0],["تَقَبَّلَ اللهُ مِنَ الْجَمِي","(م) عِ سُنَّةً جَرَتْ",36,"ت",1,0],["تَقَبَّلِ اللهُمَّ مِنْ","نَفْسٍ أَتَتْ بِمَا دَرَتْ",36,"ت",1,0],["تَقَبَّلَ فَضلاً ذا العُلا وَمُحَمَّداً","فَما لَهُما مِن بَعدِهِ مِن مُشابِهِ",37,"ب",2,0],["تَقبِيلُ كَفِّكَ مَسنُونٌ وَمُفتَرَضُ","وَأَنتُمُ الحَجُّ مَا مِن فَوتِهِ عِوَضُ",38,"ض",1,1],["تقبضني غيرتي على سلفي","فارتدى بالعفاف والأنف",39,"ف",1,0],["تُقَبِّلُ فَوْدي ثم أصْفِحُ مُعْرِضَاً","وعودي غَضُّ اللونِ ليس بذابلِ",40,"ل",1,0],["تَقَبَّلْه واجعلْ عنده لك نِعمةً","تروح بها في الناس أَكرمَ مُنعِمِ",41,"م",1,0],["تقبيلُ جَفنكِ لا يُعَدُّ خطيئةً","إني أراهُ رَحمةً وحنانا",42,"ن",2,0],["تَقَبَّلْتُ مِنهُ الوِترَ في كلِّ سُؤدَدٍ","مَواهِبُهُ شَفعٌ ونُجعَتُهُ وِتْرُ",43,"ر",1,0],["تَقَبّل آثارَ الخَليفَة مُسلِفا","بِها قُرباً تحْظى من اللّهِ بالقُرْبِ",44,"ب",1,0],["تقَبّلُ بُسطَكَ أَفواهُها","مُعفِرَةً في التُرابِ الجِباها",45,"ا",3,0],["تُقَبِّلُ أَفواهُ السَلاطينِ بُسطَهُ","فَتَفنى مِنَ التَقبيلِ لا غَيرِهِ البُسطُ",46,"ط",1,0],["تقبل رعاك الله من فكر مخلص","لك الحب نظما واسترن عيبه الداني",47,"ن",2,0],["تقبَّل اللهُ قرباناً جرى دمُه","عَلَى الثَّرى فتراءَى في السما شفقا",48,"ق",2,0],["تقبله مودعةً ثلاثاً","فمن خدٍ وَناظرةٍ وَجيد",49,"د",1,0],["تقبّلتُ القليلَ النَزْرَ وعداً","يكدر بالتعللِ والمطال",50,"ل",1,0],["تقبضُ الأبصارَ حتى لم يكدْ","رافعٌ إِصْبَعَهُ فيها يرى",51,"ا",1,0],["تُقبّل أَنفاسي قُرنفلَ خدّهِ","وَتتركُ رَيحانَ العذارِ المسلسلِ",52,"ل",1,0],["تَقبّل من بحبوحةِ المجدِ محتداً","لَه اللّه واقٍ ما أعزّ وأشرفا",53,"ف",2,0],["تقبيلُ كفِّكَ وهْيَ البحرُ غوصُ فمي","للقول فيك على دُرٍّ ومَرْجان",54,"ن",1,0],["تَقبّلتُ درّاً من سِرارِ حَديِثهمِ","فأدَّيتُ دُرّاً من دُموعي السَّوافح",55,"ح",1,0],["تقبض الواجبات من فقراهم","وعلى الأغنياء منهم تردد",56,"د",1,0],["تقبَّلْ هدِيَّةَ عبدٍ حَدَاها","لسانٌ شَكورٌ وقلبٌ وَدُودُ",57,"د",1,0],["تقبل كفيها وترشف ثغرها","وتلزم عطفيها وتكشف أعكنا",58,"ن",2,0],["تقبل كميه ملائكة السما","وتلثم نعليه الملوك التبابع",59,"ع",1,0],["تقبل توبتي مني","بخلع الذنب كالأتب",60,"ب",1,0],["تقبّله فتمنحه حياة","ويلثمها وفيا خلف شف",61,"ف",1,0],["تقبَّلتْ سماحَها وفخرَها","عن طيِّها إرثاً وعن شَيْبانِها",62,"ن",3,0],["تُقَبَّلُ منه راحةٌ تقتلُ الصدَى","تَعلَّمَ منها المزنُ كيف يصوبُ",63,"ب",1,0],["تقبِّلُ الأَرضَ عنِّي وهي نائِبَتي","يا طِيبَ مُنْتَشَقٍ منها ومُلْتَثَمِ",64,"م",1,0],["تُقبِّلُها الأفواهُ حتّى كأنّها","ثُغورُ الغَواني فهْي تُهوَى وتُلثَمُ",65,"م",1,0],["تقبَّا بالظلامِ لأجل حزني","وعمّم بالصباح لأجل هتكي",66,"ي",1,0],["تقبل الله صو