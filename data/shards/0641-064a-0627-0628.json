نا باليمن فاحت ورودها","https://www.aldiwan.net/poem40398.html","الطويل"],[354,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[365,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[403,"ألمت فهاجت لوعة بفؤادي","https://www.aldiwan.net/poem46494.html","الطويل"],[404,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[404,"جرى هذا الزمان على ضلاله","https://www.aldiwan.net/poem33453.html","الوافر"],[404,"أما آن للقلب أن يعقلا","https://www.aldiwan.net/poem33484.html","المتقارب"],[404,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[417,"حباك الله منه بالشفاء","https://www.aldiwan.net/poem53925.html","الوافر"],[417,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[417,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[417,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[417,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[417,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[433,"نجوم علاك قد طلعت سعودا","https://www.aldiwan.net/poem12502.html","الوافر"],[438,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[440,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[442,"إذا كان أولادي وأولاد أولادي","https://www.aldiwan.net/poem14362.html","الطويل"],[442,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[459,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[459,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[459,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[462,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[465,"صفاتك تفغم الآفاق طيبا","https://www.aldiwan.net/poem3170.html","عموديه"],[465,"يا غائباً لم تغب عني مكارمه","https://www.aldiwan.net/poem3315.html","عموديه"],[465,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[465,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[471,"فيا بعل ليلى كيف تجمع سلمها","https://www.aldiwan.net/poem4629.html","الطويل"],[501,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[516,"قليل لك المدح الذي بك فخره","https://www.aldiwan.net/poem12151.html","الطويل"],[530,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[530,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[552,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[552,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[580,"تعود على الإحسان يغنيك زاده","https://www.aldiwan.net/poem28338.html","الطويل"],[580,"سألت الذي لاينفذ الرزق عنده","https://www.aldiwan.net/poem56779.html","الطويل"],[588,"علام التراخي في الأمور النوائب","https://www.aldiwan.net/poem11502.html","عموديه"]],"verses":[["فَيا بانَتي بَطنِ العَقيقِ سُقيتُما","بِماءِ الغَوادي بَعدَ ماءِ شُؤونِ",0,"ن",1,0],["فَيا بانِياً لِلعِزِّ ثُلَّمَ مابَنى","وَيا راعِياً لِلمَجدِ أُهمِلَ ما رَعى",1,"ع",2,0],["فَيا بَينُ لَم تَنفَع إِلَيكَ وَسيلَةٌ","وَيا وَجدُ لَم يَسلَم عَليكَ فُؤادُ",2,"د",1,0],["فَيا بَردَ ماءٍ ما ذيقَ بَردُهُ","بَلى إِنَّ لي قَلباً عَلَيهِ يَذوبُ",3,"ب",1,0],["فَيا بَرحَ أَحزاني وَيا دَرَّ عَبرَتي","وَيا وَيلَتي ماذا لَقيتُ وَيا لَهفي",4,"ف",2,0],["فَيَا بَخْسَ مَا بَاعَ المُفَادِي بِعُمْرِهِ","عَلَى بَاذِلٍ فِي قَوْمِهِ أَوْ مُسَاوِمِ",5,"م",1,0],["فيا برد ذاك الثغر رَوَّيتَ غُلَّتي","ويا حَرَّ أنفاسي أَذَيْتَ فؤاديا",6,"ي",2,0],["فيا بحر فاجمد أو فغُر إن جيشنا","عليك غدا كالبحر يَزخَر بالعتب",7,"ب",1,0],["فيا بطلاً بالنفس ضحّى وإنما","بذلك لاستقلالنا سنّةً سنّا",8,"ن",2,0],["فَيا بُعدَ نابَينَ الكَلالِ وَبَينَها","وَياقُربَ مايَرجو عَلَيها المُسافِرُ",9,"ر",1,0],["فيا بشرى لمصرَ وساكنيها","مصيرك نحوها أزكى مصير",10,"ر",1,0],["في أبي القاسم المحبَّب والقا","سم ما يمنعُ المَلُولَ الملالا",11,"ل",2,0],["فيا بابي إلى المال","ويا بابي إلى العلمِ",12,"م",1,0],["في ابن الوزير كلالُ بادرةٍ","تُرْضِي النُّهَى ومضاءُ مُعْتَزَمِ",13,"م",1,0],["في اِبتِسامِ الفَجرِ وَفي صَمتِ الدُجى","في أَسى تِشرينَ في لَوعَةِ آبِ",14,"ب",1,0],["في اِبتِسامِ الفَجرِ في صَمتِ الدُجى","في أَسى تِشرينَ في لَوعَةِ آبِ",15,"ب",1,0],["في اِبتِسامِ الفَجرِ لِلمَرضى شِفاء","وَاِبتِسامُ الفَجرِ فيهِ سَقام",16,"م",1,0],["فَيا بُثنَ إِن واصَلتِ حُجنَةَ فَاِصرِمي","حِبالي وَإِن صارَمتِهِ فَصِليني",17,"ي",1,1],["فَيا بَحرَ البُحورِ وَلا أُوَرّي","وَيا مَلِكَ المُلوكِ وَلا أَحاشي",18,"ش",2,0],["فيا بُومةً قد عشَّشتْ فوق هامتي","على الرغم مني حين طارَ غُرابُها",19,"ب",3,0],["فيا بعدَ السَّلامَةِ من أَكُفٍّ","تُغَرُّ بِهِنَّ ضاريةُ الأُسودِ",20,"د",1,0],["فَيا بانِيَ الدُنيا لِغَيرِكَ تَبتَني","وَيا عامِرَ الدُنيا لِغَيرِكَ تَعمُرُ",21,"ر",1,0],["في أَبحُرِ الأَرجازِ بَحرٌ يَسهُلُ","مُستَفعِلُن مُستَفعِلُن مُستَفعِلُ",22,"ل",1,0],["فيأبى الوفاءُ عليه اندمالا","ويأبى التذكُر أن يشفقَا",23,"ق",2,0],["فيا بُعْدَ قُرْبٍ لم يبتْ فيه نافعاً","بسيرك بالبزلِ الرّواسمِ إيغالُ",24,"ل",1,0],["فَيا بَحرَ المَنونِ ذَهَبتَ مِنهُ","بِبَحرِ الجودِ في السَنَةِ الصَلودِ",25,"د",1,0],["فَيَا بْنَ مَنْ تَزْدَرِيهِ النَّفْسُ مِنْ ضَعَةٍ","فَمَا يُحَسُّ لَهُ وَجْدٌ وَإِعْدَامُ",26,"م",1,0],["فَيَا بْنَ الأُلَى سَادُوا الْوَرَى وَانْتَهَوْا إِلَى","تَمَامِ الْعُلا مِنْ قَبْلِ نَزْعِ التَّمَائِمِ",27,"م",1,0],["فيا بدرَ السماءِ أراكَ تبدو","وقدْ وارَوا سميَّك في القبورِ",28,"ر",1,0],["فيابنَ البتولِ وحَسْبِي بِهَا","ضَمَاناً على كُلِّ ما أَدَّعِي",29,"ع",2,0],["في أَبطَحٍ رَضِعَت ثُغورُ أَقاحِهِ","أَخلافَ كُلِّ غَمامَةٍ مِدرارِ",30,"ر",1,0],["فَيا بَعلَ لَيلى كَيفَ يُجمَعُ شَملُنا","لَدَيَّ وَفيما بَينَنا شَبَّتِ الحَربُ",31,"ب",1,0],["فَيا بائِعي شِبهاً لِلَيلى قُتِلتُما","وَجُنِّبتُما ما نالَهُ كُلُّ عابِدِ",32,"د",1,0],["فَيا بِشرَهُ إِذ جَرَّها نَحوَ قَومِهِ","وَيا بِشرَهُم لَمّا رَأَوا كَلمَها يَدمى",33,"م",2,0],["في أَباريقَ مِن لُجَينٍ حِسانٍ","كَظِباءٍ سَكَنَّ عَرضَ القِفارِ",34,"ر",1,0],["في أَباريقَ سُجَّدٍ كَبَناتِ ال","ماءِ أَقعَينَ مِن حِذارِ الصُقورِ",35,"ر",1,0],["فيا بغاةَ النيكِ ثوروا إلى","نخّارةٍ للأيرِ خنّاقه",36,"ق",2,0],["فَيا بَني آدَمَ الأَغمارَ وَيبَكُمُ","نُفوسُكُم لَم تَمَكَّن مِن تَصافيها",37,"ي",3,0],["فيابن كروسٍ يا نصف أعمى","وإن تفخر فيا نصف البصير",38,"ر",1,0],["فيا بَرْق ليس الكَرْخُ داري وإنما","رَماني إليه الدهرُ مُنْذُ لَيال",39,"ل",1,0],["فيا بأَبي تلكَ الدُّموعُ التي هَمَتْ","فدلَّتْ على مَكْنونِ تلكَ العَلائقِ",40,"ق",1,0],["فيا بَردَ اللقاءِ على فُؤادي","أَجِرْني اليومَ من حَرِّ الفِراقِ",41,"ق",1,0],["فَيَا بَرْقُ حَدِّثْنِي وَأَنْتَ مُصَدَّقٌ","عَنِ الآلِ والأَصْحَابِ مَا فَعَلُوا بَعْدِي",42,"د",2,0],["فَيَا بْنَ أَبِي وَلَسْتَ بِهِ وَلَكِنْ","كِلانَا زَرْعُ أَرضٍ لِلْحصَادِ",43,"د",1,0],["فَيا بْنَ أَبِي وَالنَّاسُ أَبْنَاءُ واحِدٍ","تَقَلَّدْ وَصَاتِي فَهْيَ لُؤْلُؤَةُ الْفِكْرِ",44,"ر",1,0],["فَيَا بَرِيدَ الصَّبَا بَلِّغْ ذَوِي رَحِمِي","أَنِّي مُقِيمٌ عَلَى عَهْدِي وَمِيثَاقِي",45,"ق",2,0],["فَيَا بُعْدَ مَا بَيْنِي وَبَيْنَ أَحِبَّتِي","وَيَا قُرْبَ ما الْتَفَّتْ عَلَيهِ الضَّمائِرُ",46,"ر",1,0],["فَيَا بْنَ ودِّي هَلُمَّ نَقْتَسِمِ الْ","لَهْوَ فَنَفْسِي إِلَى الصِّبَا حَسِرَهْ",47,"ر",2,0],["في أَبارِيقَ كَالطُّيُورِ اشْرَأَبَّتْ","حَذَرَ الْفَتْكِ مِنْ صِيَاحِ الْبُزَاةِ",48,"ه",1,0],["فَيَا بَشِيراً بِيَوْمِ سَعْدِهِمَا","أَرِّخْ غَدَتْ رِينُ زَوَجَ جَبْرِيلِ",49,"ل",1,0],["فِي أَبَوَيْهِ العَوَضُ المُرْتَجَى","فَلْيَنْجِبَا كُلَّ هِلاَل مُنيرْ",50,"ر",1,0],["فَيَا بَهْجَةَ البَيْتِ الَّذِي هُوَ بَعْدَهَا","كَدَارِسِ رَسْمٍ فَاقِدِ الأُنْسِ بَلْقَعِ",51,"ع",1,0],["فيا بغدادُ لا ينفكُّ سِرٌ","لحُسْنِكِ ينجلي فيدِقُّ سِر",52,"ر",1,0],["فيا بعدها من غاية لم ترح بها","مطيّ ولا حطّ الرّحال بها ركب",53,"ب",1,0],["فيا بنَ تزدريهِ النفسُ منْ ضعة ٍ","فما يحسُّ لهُ وجدٌ وَ إعدامُ",54,"م",1,0],["فيا بؤس للحي الذي لا يروقه","من الناس إلا من تضم الحفائر",55,"ر",1,0],["في أبحر من زجاج لا بهاء لها","ما بين سوداء أو خضراء زرقاء",56,"ا",2,0],["فيا بَيْك حفني ويا ناصفاً","ليَ العجز عذرٌ فكيف السبيل",57,"ل",1,0],["فيا بحر المعارف أنت حبر","بديعٌ في بيانك للمعاني",58,"ن",2,0],["فيا بعدهم عنها ويا بئس ما رضوا","فقد صدّهم قصدٌ وسيرّهم وزر",59,"ر",1,0],["فيابني معيبد بخ لكم","بسيد منكم إذا قال فعل",60,"ل",1,0],["فيا بن تقي الدين رحّب فقد أتت","تزوركَ أبكار القوافي وعونها",61,"ن",3,0],["فيا بن الأشرف المحمود فعلاً","بتفريج العظائم حين تفجا",62,"ج",2,0],["فيا باسط المعروف يا من نواله","مناديه من أقصى المكان يجاب",63,"ب",1,0],["فيا بايعا من غيره المدح بالعطا","عقدت ولكن صفقة ملئت غبنا",64,"ن",2,0],["فَيا باكياً قَبلَ النَوى خَشيَةَ النَوى","رُوَيداً بِعَينٍ جَفنُها سَوفَ يَقرَحُ",65,"ح",1,0],["فَيا بِأَبي أَخلاقُهُ الغُرُّ إِنَّها","لَأَعذَبُ مِن صافي الثِّغابِ زلالِ",66,"ل",1,0],["فَيا باعَلِيٍّ يا اِبنَ مَن فاقَ مَجدُهُ","أَواخِرَ أَربابِ العُلا وَالأَوائِلا",67,"ل",2,0],["فَيابا سِنانٍ قُم فَأَنتَ زَعيمُها","وَأَنتَ مُرَجّاها وَأَنتَ هُمامُها",68,"م",3,0],["فَيا بارِدَ الأَنفاسِ دَعني فَإِنَّهُ","قَليلٌ لَهُم مِن مَعشَرٍ فَيضُ أَجفانِ",69,"ن",1,0],["فَيَابنَ خَلِيفَةِ الرَّحمَانِ فِينَا","وَنَجلَ جَحاجِحٍ صِيدٍ فَصِيدِ",70,"د",1,0],["فَيابانَةَ الوادى أَلَيسَت مُصِيبَةً","مِنَ اللهِ أَن تُحمَى عَلَينَا ظِلالُكِ",71,"ك",1,0],["فَيا بنتَ هَذا الدَهرِ سِرتِ مَسيرَهُ","فَهَل أَنتِ دونَ الناسِ مِنهُ عَلى أَمنِ",72,"ن",1,0],["فيا بْنَ مغيثِ المُلْك بالرأيِ والقَنا","فقَصْدُك للنوعين منه سَديد",73,"د",1,0],["فيا بْنَ رسولِ الله هذا أَوانُكم","وُعِدتم به والآن يُنْتَجَز الوعد",74,"د",1,0],["فَيا بئسَ هُم مِن مُجرمينَ جَزاؤُهم","سُجونٌ من النيرانِ تحجرهم حجرا",75,"ر",2,0],["فَيا برقُ باللَّه إن جئتَها","وَطفتَ بها مَربعاً مربعا",76,"ع",2,0],["فيا بدرُ إني موضعُ الصنعِ فاتخذْ","يداً لكَ عندي تلقني الخيرَ جازيا",77,"ي",2,0],["فيا بارئ الدنيا حنانيكَ إنما","طغى الناسُ جهلاً بالذي كنتَ تشرعُ",78,"ع",1,0],["فيا باذلا للوفد في السلم ماله","ومن هو للاعمار في الحرب ناهب",79,"ب",1,0],["فيا بحر أين الحظ أين سبيله","على أنني بالحظ والحب عالم",80,"م",1,0],["فيا بائع العشق رفقا بنا","ورفقا بأهداب هذي الجفون",81,"ن",1,0],["فيا بن ال