{"poems":[[91,"قد عدت بعد ذهاب منك يا عيد","https://www.aldiwan.net/poem44645.html","البسيط"],[91,"ذهب الشباب وكل شيء طيب","https://www.aldiwan.net/poem44778.html","الكامل"],[30,"فاسأل هوازن إن عند سراتهم","https://www.aldiwan.net/poem5242.html","الكامل"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85706","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85427","الكامل"],[563,"عيسى بن مريم روحي","https://www.aldiwan.net/poem33861.html","المجتث"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205486",""],[4750,"ياسيدي خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=180430",""],[5106,"جَاْدَتْ غِيُوثُكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137168",""],[5401,"الفكره","https://www.poetsgate.com/ViewPoem.aspx?id=182827",""],[5739,"أمواق الغمام ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127362",""]],"verses":[["يا حق انك من كل الذين بهم","عثت يد الحيف في الاقطار منشود",0,"د",1,0],["يا حق اني في جميع مواقفي","متحزب لك لو يفيد تحزبي",1,"ب",2,0],["يا حَقَّ كُلُّ بَني كُلَيبٍ فَوقَهُ","لُؤمٌ تَسَربَلَهُ إِلى الأَظفارِ",2,"ر",1,0],["يا حقبة الوهم والخيال","هلا تمهلتِ للأبد",3,"د",1,0],["يا حق في أمة هَ","هنا كلانا غَريبُ",4,"ب",1,1],["يا حق مالك في سكو","ن الليل مضطرباً تلوب",5,"ب",1,0],["يا حق لا تجزع كلا","نا في مواطنه غريب",5,"ب",1,0],["يا حق من أَجلك الجهال تشتمني","وَفي سَبيلك تؤذيني فأَضطَرب",6,"ب",1,0],["يا حقُّ قد دَفَنوك حيّاً في الثرى","يوم القضاء فعادَني اِستعبار",7,"ر",1,0],["يا حق يا حي إني","ظهرت عنك بوسمي",8,"م",2,0],["يا حقُّ لا تبرحْ خباءَكْ","أتعبتنا سعيًا وراءَكْ",9,"ك",1,1],["يا حقُّ هذا حدُّنا","فاختر ظهورَك أو خفاءَكْ",9,"ك",1,0],["ياحق الإنصاف لطّام الأضاديدي","يالهيلع إللي تطيع له الصعيباتي",10,"ت",2,0],["يَاْ حُقَّ رَنْدٍ زَاْرَ فِيْ أَعْطَاْفِهَاْ","وَرَقَ الْهَوَىْ وَالْيَاْسِمِينُ عَرَاْئِقَاْ",11,"ق",2,0],["ياحقيل ياما شوينا الضب والعكره","والا انت مفطوم بالقشطه مع الكيري",12,"ر",2,0],["ياحقيقه مظلمه .... بين الآنام.","الضحى بالليل والليل الضحى.",13,"ح",2,0]]}