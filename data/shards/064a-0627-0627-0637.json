{"poems":[[45,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[52,"أخشى عليك من الجارات حاسدة","https://www.aldiwan.net/poem62299.html","البسيط"],[52,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[78,"لا بيت يسكن إلا فارق السكنا","https://www.aldiwan.net/poem38879.html","الطويل"],[422,"ما لي أفارق كل يوم صاحبا","https://www.aldiwan.net/poem53942.html","الكامل"],[470,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130718","الكامل"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147207","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109007","البسيط"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11121","البسيط"],[4755,"بِاسمِ البِلادِ أَصالةً، ونِيابةً","https://www.poetsgate.com/ViewPoem.aspx?id=202668",""],[4829,"همسة شمالية","https://www.poetsgate.com/ViewPoem.aspx?id=34265",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5431,"ماآلف الله أرواحا ليوجعها","https://www.poetsgate.com/ViewPoem.aspx?id=187991",""],[5525,"أجمل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=854",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5956,"شمسٌ وظلال","https://www.poetsgate.com/ViewPoem.aspx?id=192981",""],[6045,"هدية يوم الأم","https://www.poetsgate.com/ViewPoem.aspx?id=125354",""],[6152,"حياة روح","https://www.poetsgate.com/ViewPoem.aspx?id=203140",""]],"verses":[["يا أَطيَبَ الناسِ نَفساً","وَأَليَنَ الناسِ رُكبَه",0,"ب",2,0],["يا أَطيبَ الناسِ ريقاً غَيرَ مُختَبَرٍ","إِلّا شَهادَةَ أَطرافِ المَساويكِ",1,"ك",1,0],["يا أَطيَبَ الناسِ أَرداناً وَمُلتَزَماً","مُنّي عَلَيَّ بِيَومٍ مِنكِ وَاِحتَسِبي",2,"ب",2,0],["يا أطيبَ الناسِ رُوحاً ضمَّهُ بَدَنٌ","أَستودعُ اللَّهَ ذاك الروحَ والبَدَنا",3,"ن",2,0],["يا أَطْيَبَ القوم الَّذين ألِفْتُهم","في الناجبين خلائقاً وذواتا",4,"ت",2,0],["يا أطهَرَالأرض..يا قدِّيسَة َالطِّين ِ","يا كَربَلا..يا رياضَ الحُورِ والعِين ِ",5,"ن",1,0],["يا أطولَ الأقطابِ جاهاً إنَّني","قصرت يدا أملي فعدني وأنجز",6,"ز",1,0],["يا أطيب الناس ريحاً","وأطيب الناس راحا",7,"ح",2,1],["يا أطيب الناس أخلاقاً وأمنعهم","جاراً وأرفعهم للمجد بنيانا",8,"ن",2,0],["يا أَطيَبَ الناسِ ريقاً بَعدَ هَجعَتِها","وَأَملَحَ الناسِ عَيناً حينَ تَنتَقِبُ",9,"ب",1,0],["يا أَطوَلَ الأَقلامِ والأَعلامِ في","وطنٍ عليه تَكَالَب الأَقزامُ",10,"م",1,0],["ياأطهر من حمام البيت ياشرح من طوابيقه","يا أروع من نظم حرف(ن)بساح النت وحاراته",11,"ت",2,0],["يَاْ أَطْيَبَ النَّاْسِ أَهْدَتْهُ مَصَاْئِرُنَاْ","إِنْسَاْنُهُ قَدْ جَثَىْ للهِِ فِيْ صَبَبِ",12,"ب",1,0],["يا أطْيَبَ الشَّجَرِ المُوصى ببَذْرَتِهِ","ألَسْتِ كنتِ لإبراهيمَ إشْراقا",13,"ق",2,0],["ياأطيب الناس ياقمحاً تلوذ به","حمائم الخير أعط الخبزَ جوعانا",14,"ن",2,0],["يا اطهر الحزن ... لو كان القصيد","يكشف الغم عن بدر التمام",15,"م",1,0],["يا أطيَبَ الأرض ِ..يا بَغدادُ ثانيَة ٌ","يَخضَرُّ ضِلعي علَيها وَهوَ يَنطَبِقُ",16,"ق",1,0],["يا أطيب الناس الذين عرفتهم","قلباً وإحساساً وأطول بالا",17,"ل",2,0],["يا أطهرَ الأحياءِ طهرٌ نابعٌ","من كفك اليمنى ومن يسراكِ",18,"ك",1,0],["يا أطهر الناس قلبا من يضاهيك","ومن يُجاريك روحا أو يوازيكِ !؟",19,"ك",1,1]]}