{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[55,"قد ضاق بالحب صدري","https://www.aldiwan.net/poem26332.html","المجتث"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[86,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[47,"قد ضج جيشك من طول القتال به","https://www.aldiwan.net/poem25202.html","البسيط"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[70,"عشقته أهيف قد","https://www.aldiwan.net/poem42810.html","مجزوء الرجز"],[78,"أنباء أسرك قد طبقن آفاقا","https://www.aldiwan.net/poem14223.html","البسيط"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[45,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[69,"قالوا أيؤذيك ولم تهجه","https://www.aldiwan.net/poem28711.html","السريع"],[13,"قد ضقت من حبها مالا يضيقني","https://www.aldiwan.net/poem2195.html","البسيط"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[46,"الحظ يقسم عاش بشر ما اشتكى","https://www.aldiwan.net/poem22566.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85620","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[107,"قد ضمنا والكرام بستان","https://www.aldiwan.net/poem16548.html","المنسرح"],[113,"قد ضاق رحب الفؤاد مني","https://www.aldiwan.net/poem42008.html","مخلع البسيط"],[126,"درويش يا ذا الخلفة الشوهاء","https://www.aldiwan.net/poem50675.html","البسيط"],[127,"يا صاح ما لك لا ترد","https://www.aldiwan.net/poem67453.html","مجزوء الكامل"],[131,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[141,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[162,"صارمته فتواصلت أحزانه","https://www.aldiwan.net/poem67878.html","الكامل"],[172,"قد ضاع فيك صبري","https://www.aldiwan.net/poem46040.html","منهوك المنسرح"],[233,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[295,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[295,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[296,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[301,"قد ضل في خبر الأهرام عقل فتى","https://www.aldiwan.net/poem57773.html","البسيط"],[301,"وشاح من أحببتها قال لي","https://www.aldiwan.net/poem57873.html","الطويل"],[301,"وشاح من أحببته قال لي","https://www.aldiwan.net/poem58321.html","السريع"],[303,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[311,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[318,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[346,"لا غرو أن صغرت عن قدرك الرتب","https://www.aldiwan.net/poem19862.html","البسيط"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[362,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[369,"دع الليالي فللمعالي","https://www.aldiwan.net/poem57436.html","مخلع البسيط"],[374,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[374,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[374,"قد ضل من لم يرض في إيمانه","https://www.aldiwan.net/poem59407.html","الكامل"],[374,"ما بين جفني والأحبة برزخ","https://www.aldiwan.net/poem66880.html","الكامل"],[374,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[377,"يا راحتي وارتياحي","https://www.aldiwan.net/poem48770.html","المجتث"],[377,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[377,"طرف جفاه هجوعه","https://www.aldiwan.net/poem48798.html","مجزوء الكامل"],[377,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[388,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[400,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[400,"لا زلتم في نفس","https://www.aldiwan.net/poem33709.html","مجزوء الرجز"],[400,"قلب بداء ذنوبه مجروح","https://www.aldiwan.net/poem33989.html","الكامل"],[406,"العجز لا ينقص رزقا ولا","https://www.aldiwan.net/poem31684.html","عموديه"],[438,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[451,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[451,"أصار مثلي عارا أم غدا خطرا","https://www.aldiwan.net/poem61605.html","البسيط"],[451,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[456,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[462,"يا مقعد القاضي السعيد","https://www.aldiwan.net/poem3331.html","عموديه"],[466,"قد ضاقت الحيلة بي في رشا","https://www.aldiwan.net/poem59712.html","السريع"],[466,"لا يقبل الرشوة في ودي","https://www.aldiwan.net/poem60164.html","الطويل"],[466,"قد ضحكت غرة الصباح","https://www.aldiwan.net/poem60293.html","مخلع البسيط"],[466,"ومهفهف كالغصن في حركاته","https://www.aldiwan.net/poem60335.html","الكامل"],[475,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[536,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[560,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[560,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[560,"قف بين ريحان العقيق وضاله","https://www.aldiwan.net/poem52961.html","الكامل"],[565,"سامعة للهوى مطيعة","https://www.aldiwan.net/poem69603.html","مجزوء الكامل"],[565,"قامر باللهو في هوى قمر","https://www.aldiwan.net/poem69678.html","السريع"],[573,"قد ضاق والله جسمي فيك عن روحي","https://www.aldiwan.net/poem2973.html","البسيط"]],"verses":[["قَد ضَمِنَ اللَهُ أَن تَدومَ لَنا","مُسَلَّماً وَالزَمانُ وَالدُوَلُ",0,"ل",1,0],["قَد ضاقَ بِالحُبِّ صَدري","وَأَنفَدَ الشَوقُ صَبري",1,"ر",2,1],["قَد ضِقتُ ذَرعاً بِالحَياةِ وَمَن","يَفقِد أَحِبَّتَهُ يَضِق ذَرعا",2,"ع",2,0],["قَد ضاقَ جِسمُكَ عَن مَداكَ فَلَم يُطِق","صَبراً عَلَيكَ وَأَنتَ شُعلَةُ نارِ",3,"ر",1,0],["قَد ضَمِنّا لَكَ القَضاءَ بِمِصرٍ","وَضَمِنّا لِنَجلِكَ الإِسعادا",4,"د",2,0],["قَد ضَمَّنا أَلَمُ الحَياةِ وَكُلُّنا","يَشكو فَنَحنُ عَلى السَواءِ وَأَنتُمُ",5,"م",1,0],["قد ضيّعوا الحزم حتى أنهم ندموا","على الذي كان منهم بعد ما كانا",6,"ن",2,0],["قد ضيّعت بغداد سابق عزّها","وغدت تَجيش بصدرها الحسرات",7,"ت",1,0],["قد ضلّ أهلُك رُشدَهم وهل اهتدى","قوم أجاهلهم هم السَرَوات",8,"ت",1,0],["قَد ضَجَّ جَيشُكَ مِن طولِ القِتالِ بِهِ","وَقَد شَكَتكَ إِلَينا الخَيلُ وَالإِبِلُ",9,"ل",1,1],["قَد ضَمِنَت خِذرافَهُ أَبارِقُه","رَعَت بَقايا حَمضِهِ أَيانِقُه",10,"ق",2,0],["قَد ضاقَ حَتّى إِنَّهُ","تَخرُجُ واواً أَلِفُه",11,"ف",2,0],["قَد ضاقَ صَدرُ المَعالي إِذ نُعِيَت لَها","وَقيل إِنَّ عَلَيكَ القَيدَ قَد ضاقا",12,"ق",2,0],["قد ضل من بالعلم في","الحياة لا يعتصم",13,"م",1,0],["قد ضيّعت أوقاتي","وأذهبت لذاتي",14,"ي",1,0],["قَد ضَمَّها فَزَكا نَعشٌ يُطافُ بِهِ","مُقَدَّمٌ كَلِواءِ الحَقِّ مُنفَرِدُ",15,"د",1,0],["قد ضلّ قوم بتآويلها","فيالها من صفقة خاسره",16,"ر",2,0],["قَد ضاعَفَ اللَهُ لِلدُنيا مَحاسِنَها","بِمُلكِ مُنتَخَبٍ لِلمُلكِ مُختارِ",17,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ بَعضَ الكَائِناتِ لَها","مَكثٌ وَلِلعالَمِ العُلوِيَّ تَخليدُ",18,"د",1,0],["قدْ ضرَّ دنياي فإنْ أهجُهُ","تطرَّقَ الضرُّ إلى ديني",19,"ي",1,0],["قَد ضِقتُ مِن حُبِّها مالا يُضَيِّقُني","حَتّى عُدِدتُ مِنَ البُؤسِ المَساكينِ",20,"ن",1,1],["قد ضُرّجَتْ بدم الحياء فأقبلتْ","متظلّماً من وَردها سُوسانها",21,"ن",3,0],["قد ضَمّ قُطرَيها العَجاجُ فما تَرى","بينَ السِّنانِ وكعبِهِ تخليلا",22,"ل",2,0],["قَد ضارَعَ الحُبُّ قَلبي ثُمَّ أَدرَكَهُ","وَهنُ المُحِبِّ فَأَمسى القَلبُ قَد غُلِبا",23,"ب",2,0],["قَد ضَنَّ مَن رُزِقَ الغِنى بِزَكاتِهِ","وَغَدا فَلا فَلحٌ وَلا تِعشارُ",24,"ر",1,0],["قد ضقت ذرعاً بكتما","نِك الغَرام فبوحي",25,"ي",1,1],["قد ضللنا الطَريق نخبط في الأر","ضِ كَما ضلَّ ذو عمىً مسمول",26,"ل",1,0],["قد ضَحِكتْ للنور فيها الزَّهرْ","وصفَّقَتْ أوراقُها للنسيمْ",27,"م",1,0],["قد ضاع ما ملكت يدا","ه ولم يضع منه حياؤه",28,"ا",3,0],["قَد ضَمَنا وَالكِرام بُستانُ","كَأَنَّنا في الجِنان سُكانُ",29,"ن",1,1],["قد ضاق رحب الفؤاد مني","وأحرقت مهجتي الإساءه",30,"ه",1,1],["قد ضاقَ وصف الذِّم فيك لأنني","رائيكَ لا شيئاً من الأشياءِ",31,"ا",2,0],["قد ضمَّ قبرُكَ ما يُحَدُّ","وإن نفسكَ لا تُحَدُّ",32,"د",1,0],["قد ضاقَ ذَرعُ الكُفرِ منكَ وأهلُهُ","بموفقِ الإيرادِ والإصدارِ",33,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ المَجَرَّةَ رَوضَةً","تُرعى وَزاهِرَةَ النُجومِ سَواما",34,"م",2,0],["قَد ضَلَّ عَنهُ فُؤادُهُ فَاِستَخبِري","عَينَيكِ أَينَ مَحَلُّهُ وَمَكانُهُ",35,"ن",2,0],["قَدْ ضاعَ فيكَ صَبْرِي","يا راغِباً فِي الغَدْرِ",36,"ر",1,1],["قَد ضَمِنَت رَوعَةُ الجَمالِ لَهُم","وَالناسِ أَن لا يَفوتَهُم وَطَرُ",37,"ر",1,0],["قَد ضَلَّ رشدُ من اِطّباه جمالُها","فَصَبا إِليها واِزدَهاهُ زُهاها",38,"ا",3,0],["قد ضَلَّ طالِبُ غادَةٍ حُميَت","في قومها بالبيض والسُمرِ",39,"ر",1,0],["قَدْ ضاعَ مني القلبُ يوم نأتْ فهل","من ناشدٍ يوم النَّوى قلبي معي",40,"ي",1,0],["قد ضل في خبر الأهرام عقل فتىً","أراد تحقيقه في سالف الحقب",41,"ب",1,1],["قد ضاع مني الخصر لما انثنت","أما تراني دائراً في قلق",42,"ق",1,0],["قد ضاع مني الخصر لما انثنى","أما تراني دائماً في قلق",43,"ق",1,0],["قَد ضلّ مَن مِن غيرِها طلب الهدى","لِصلاحه الروحيِّ والجسماني",44,"ن",2,0],["قد ضقت ذرعاً بها وأحبسها","لم أك أعصي الإله لولاها",45,"ا",3,0],["قَد ضَمِنَ الثَغرَ مِنهُ سينَ بَسمَلَةٍ","فَكُلُّ شَيءٍ بِها جاءَت بِدايَتُهُ",46,"ت",2,0],["قَدْ ضَمَّ حِلْمُكَ بَرَّيْهَا فَلا عَجَبٌ","هَبْ أَنَّ ذا جِلِّقٌ أوْ أَنّ ذا حَلَبُ",47,"ب",1,0],["قَد ضَمِنَ اللَهُ وَلَيسَ يَنكُثُ","أَنَّكَ ما اِمتَدَّ الزَمانُ تَلبَثُ",48,"ث",1,0],["قد ضَمَّنا يومَ غدَوْا مَوقفٌ","ما كانَ لولا البَينُ أَحْلاه",49,"ا",2,0],["قد ضمَّه واقعاً مقيماً","يرقُبُ ما يأمر الأميرُ",50,"ر",1,0],["قد ضم من رهبانه","من كل نفسٍ غاليه",51,"ي",2,0],["قد ضل من قد حاد عن كشف الزللْ","مذ زلَّ عن إيضاح ما فيه انفعلْ",52,"ل",1,1],["قد ضل من لم يرض في إيمانه","إلا الذي حقّاً يراه ويُخبِرُ",53,"ر",1,1],["قد ضمه الجدث الحديث بأمره","ولكل فعلٍ غايةٌ لا تُفسَخ",54,"خ",1,0],["قد ضم في الطرفين شرَّ عذابه","أبديةَ البلوى وعِظْمَ بلائه",55,"ا",3,0],["قَد ضاقَ غل التَنائي","عَلى خِناق الأَسير",56,"ر",1,0],["قَد ضاقَ بي سجن الهمو","م فَهَل لِأَسري مِن سِراج",57,"ج",1,0],["قَد ضاقَ بِالأَشواق فَاِنفَرَجَت","هُناكَ صُدوعَهُ",58,"ع",2,0],["قَد ضاقَ قَلبيَ بِالوَجد المُذيبِ لَهُ","فَلو أَرادَ مَزيداً مِنهُ ما وَجَدا",59,"د",2,0],["قد ضقت زرعا وصبري يا إلهي نفد","إن البلا يا إلهي قد تمادى وشد",60,"د",1,0],["قد ضل أقوام برؤيته","فغدوا وليس لدينهم ظل",61,"ل",1,0],["قد ضربت أشجارها","خيام وَشيٍ سندسي",62,"س",2,0],["قد ضم أحبابي وأترابي ومن","عاشرته بعد الممات ضريح",63,"ح",1,0],["قد ضمن الله لنا رزقنا","جاءت به الآثار والنص",64,"ص",1,0],["قد ضاق بي الذرع ضيق الوقف من جر","م لو صور البعض منها أفعم الأفقا",65,"ق",2,0],["قد ضيّعت عصبة للنقل مكتبتي","يا عصبة النقل قد خلدت في العار",66,"ر",1,0],["قد ضاعَ جهدىَ فيهم واغتدى أملي","يأساً ولو أنني ما زلتُ مغتفرا",67,"ر",2,0],["قد ضاعَ بين الهازل","ين من الحسيب إلى النسيبِ",68,"ب",1,0],["قد ضمِنَ البارحُ عنهم فوفَى","ما ساءني إذ مرَّ غيرَ أيمَنِ",69,"ن",1,0],["قد ضمّنت أبياته الثقل","ين من إنسٍ وجنَّه",70,"ن",2,0],["قَد ضاقَتِ الحيلَةُ بي في رَشاً","لا يَقبَلُ الرِشوَةَ مِن ذُلّي",71,"ي",1,1],["قَد ضاقَتِ الحيلَةُ بي في رَشاً","لا يَقبَلُ الرِشوَةَ في وُدّي",72,"ي",1,1],["قَد ضَحِكَت غُرَّةُ الصَباحِ","وَاِندَفَعَ الديكُ في الصِياحِ",73,"ح",1,1],["قَد ضَلَّ فَكري عِن طَريقِ صَوابِهِ","مُذ صارَ يَطمَعُ في بُلوغِ صِفاتِهِ",74,"ت",2,0],["قد ضنَّ بخلاً بما قد كانَ يمنحُني","بهِ إلى أن غدا مِن بعضِ حُسادي",75,"ي",1,0],["قد ضاقَ صَدرُه فسالَ دَمعُهُ","ويَدُه من سَقَمٍ تُوجِعهُ",76,"ه",1,0],["قد ضرّني الصّدقُ فمنْ ذا الّذي","يَنفعني يا قومُ بالكذبِ",77,"ب",1,0],["قد ضاق جسمك عن مدى النَّفس التّي","ضغطت هياكِلها جميع جهاتهِ",78,"ت",2,0],["قد ضاعَ ما كَتَبَ الأقوامُ واجتهدوا","وما لِمَنْ قد أضلَّ اللهُ من هادِ",79,"د",1,0],["قد ضَمَّ منك الفُلكُ أفناناً كما","ضَمَّتْ سفينةُ نوحَ من أجيالِهِ",80,"ل",2,0],["قَدْ ضَحِكَتْ مِنْ صُرُوفِ دَهْرٍ","أَحْدَاثُهُ جَمَّةٌ فَظِيْعَهْ",81,"ع",2,0],["قَدْ ضُرِبَتْ خَيْمَةُ الغَمَامِ لنا","وَرُشّ جيش النّسِيْمِ بالمَطَرِ",82,"ر",1,0],["قد ضاقَ واللهِ جسمي فيكَ عن رُوحِي","فلا تَسَلْنِيَ عن وجْدي وتبريحي",83,"ي",1,1]]}