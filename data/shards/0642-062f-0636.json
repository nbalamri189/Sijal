{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[55,"قد ضاق بالحب صدري","https://www.aldiwan.net/poem26332.html","المجتث"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[86,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[47,"قد ضج جيشك من طول القتال به","https://www.aldiwan.net/poem25202.html","البسيط"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[70,"عشقته أهيف قد","https://www.aldiwan.net/poem42810.html","مجزوء الرجز"],[78,"أنباء أسرك قد طبقن آفاقا","https://www.aldiwan.net/poem14223.html","البسيط"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[45,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[69,"قالوا أيؤذيك ولم تهجه","https://www.aldiwan.net/poem28711.html","السريع"],[13,"قد ضقت من حبها مالا يضيقني","https://www.aldiwan.net/poem2195.html","البسيط"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[46,"الحظ يقسم عاش بشر ما اشتكى","https://www.aldiwan.net/poem22566.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85620","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[94,"تلك الأقانيم الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=15662",""],[110,"قد ضمنا والكرام بستان","https://www.aldiwan.net/poem16548.html","المنسرح"],[116,"قد ضاق رحب الفؤاد مني","https://www.aldiwan.net/poem42008.html","مخلع البسيط"],[129,"درويش يا ذا الخلفة الشوهاء","https://www.aldiwan.net/poem50675.html","البسيط"],[130,"يا صاح ما لك لا ترد","https://www.aldiwan.net/poem67453.html","مجزوء الكامل"],[134,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[144,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[165,"صارمته فتواصلت أحزانه","https://www.aldiwan.net/poem67878.html","الكامل"],[175,"قد ضاع فيك صبري","https://www.aldiwan.net/poem46040.html","منهوك المنسرح"],[236,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[298,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[298,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[299,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[304,"قد ضل في خبر الأهرام عقل فتى","https://www.aldiwan.net/poem57773.html","البسيط"],[304,"وشاح من أحببتها قال لي","https://www.aldiwan.net/poem57873.html","الطويل"],[304,"وشاح من أحببته قال لي","https://www.aldiwan.net/poem58321.html","السريع"],[306,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[314,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[321,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[349,"لا غرو أن صغرت عن قدرك الرتب","https://www.aldiwan.net/poem19862.html","البسيط"],[365,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[365,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[372,"دع الليالي فللمعالي","https://www.aldiwan.net/poem57436.html","مخلع البسيط"],[378,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[378,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[378,"قد ضل من لم يرض في إيمانه","https://www.aldiwan.net/poem59407.html","الكامل"],[378,"ما بين جفني والأحبة برزخ","https://www.aldiwan.net/poem66880.html","الكامل"],[378,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[381,"يا راحتي وارتياحي","https://www.aldiwan.net/poem48770.html","المجتث"],[381,"أنا والحمام مع الصباح","https://www.aldiwan.net/poem48789.html","مجزوء الكامل"],[381,"طرف جفاه هجوعه","https://www.aldiwan.net/poem48798.html","مجزوء الكامل"],[381,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[392,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[404,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[404,"لا زلتم في نفس","https://www.aldiwan.net/poem33709.html","مجزوء الرجز"],[404,"قلب بداء ذنوبه مجروح","https://www.aldiwan.net/poem33989.html","الكامل"],[410,"العجز لا ينقص رزقا ولا","https://www.aldiwan.net/poem31684.html","عموديه"],[442,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[454,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[454,"أصار مثلي عارا أم غدا خطرا","https://www.aldiwan.net/poem61605.html","البسيط"],[454,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[459,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[465,"يا مقعد القاضي السعيد","https://www.aldiwan.net/poem3331.html","عموديه"],[469,"قد ضاقت الحيلة بي في رشا","https://www.aldiwan.net/poem59712.html","السريع"],[469,"لا يقبل الرشوة في ودي","https://www.aldiwan.net/poem60164.html","الطويل"],[469,"قد ضحكت غرة الصباح","https://www.aldiwan.net/poem60293.html","مخلع البسيط"],[469,"ومهفهف كالغصن في حركاته","https://www.aldiwan.net/poem60335.html","الكامل"],[478,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[539,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[563,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[563,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[563,"قف بين ريحان العقيق وضاله","https://www.aldiwan.net/poem52961.html","الكامل"],[568,"سامعة للهوى مطيعة","https://www.aldiwan.net/poem69603.html","مجزوء الكامل"],[568,"قامر باللهو في هوى قمر","https://www.aldiwan.net/poem69678.html","السريع"],[576,"قد ضاق والله جسمي فيك عن روحي","https://www.aldiwan.net/poem2973.html","البسيط"]],"verses":[["قَد ضَمِنَ اللَهُ أَن تَدومَ لَنا","مُسَلَّماً وَالزَمانُ وَالدُوَلُ",0,"ل",1,0],["قَد ضاقَ بِالحُبِّ صَدري","وَأَنفَدَ الشَوقُ صَبري",1,"ر",2,1],["قَد ضِقتُ ذَرعاً بِالحَياةِ وَمَن","يَفقِد أَحِبَّتَهُ يَضِق ذَرعا",2,"ع",2,0],["قَد ضاقَ جِسمُكَ عَن مَداكَ فَلَم يُطِق","صَبراً عَلَيكَ وَأَنتَ شُعلَةُ نارِ",3,"ر",1,0],["قَد ضَمِنّا لَكَ القَضاءَ بِمِصرٍ","وَضَمِنّا لِنَجلِكَ الإِسعادا",4,"د",2,0],["قَد ضَمَّنا أَلَمُ الحَياةِ وَكُلُّنا","يَشكو فَنَحنُ عَلى السَواءِ وَأَنتُمُ",5,"م",1,0],["قد ضيّعوا الحزم حتى أنهم ندموا","على الذي كان منهم بعد ما كانا",6,"ن",2,0],["قد ضيّعت بغداد سابق عزّها","وغدت تَجيش بصدرها الحسرات",7,"ت",1,0],["قد ضلّ أهلُك رُشدَهم وهل اهتدى","قوم أجاهلهم هم السَرَوات",8,"ت",1,0],["قَد ضَجَّ جَيشُكَ مِن طولِ القِتالِ بِهِ","وَقَد شَكَتكَ إِلَينا الخَيلُ وَالإِبِلُ",9,"ل",1,1],["قَد ضَمِنَت خِذرافَهُ أَبارِقُه","رَعَت بَقايا حَمضِهِ أَيانِقُه",10,"ق",2,0],["قَد ضاقَ حَتّى إِنَّهُ","تَخرُجُ واواً أَلِفُه",11,"ف",2,0],["قَد ضاقَ صَدرُ المَعالي إِذ نُعِيَت لَها","وَقيل إِنَّ عَلَيكَ القَيدَ قَد ضاقا",12,"ق",2,0],["قد ضل من بالعلم في","الحياة لا يعتصم",13,"م",1,0],["قد ضيّعت أوقاتي","وأذهبت لذاتي",14,"ي",1,0],["قَد ضَمَّها فَزَكا نَعشٌ يُطافُ بِهِ","مُقَدَّمٌ كَلِواءِ الحَقِّ مُنفَرِدُ",15,"د",1,0],["قد ضلّ قوم بتآويلها","فيالها من صفقة خاسره",16,"ر",2,0],["قَد ضاعَفَ اللَهُ لِلدُنيا مَحاسِنَها","بِمُلكِ مُنتَخَبٍ لِلمُلكِ مُختارِ",17,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ بَعضَ الكَائِناتِ لَها","مَكثٌ وَلِلعالَمِ العُلوِيَّ تَخليدُ",18,"د",1,0],["قدْ ضرَّ دنياي فإنْ أهجُهُ","تطرَّقَ الضرُّ إلى ديني",19,"ي",1,0],["قَد ضِقتُ مِن حُبِّها مالا يُضَيِّقُني","حَتّى عُدِدتُ مِنَ البُؤسِ المَساكينِ",20,"ن",1,1],["قد ضُرّجَتْ بدم الحياء فأقبلتْ","متظلّماً من وَردها سُوسانها",21,"ن",3,0],["قد ضَمّ قُطرَيها العَجاجُ فما تَرى","بينَ السِّنانِ وكعبِهِ تخليلا",22,"ل",2,0],["قَد ضارَعَ الحُبُّ قَلبي ثُمَّ أَدرَكَهُ","وَهنُ المُحِبِّ فَأَمسى القَلبُ قَد غُلِبا",23,"ب",2,0],["قَد ضَنَّ مَن رُزِقَ الغِنى بِزَكاتِهِ","وَغَدا فَلا فَلحٌ وَلا تِعشارُ",24,"ر",1,0],["قد ضقت ذرعاً بكتما","نِك الغَرام فبوحي",25,"ي",1,1],["قد ضللنا الطَريق نخبط في الأر","ضِ كَما ضلَّ ذو عمىً مسمول",26,"ل",1,0],["قد ضَحِكتْ للنور فيها الزَّهرْ","وصفَّقَتْ أوراقُها للنسيمْ",27,"م",1,0],["قد ضمّ هذا الثرى من صيدها مزقا","إرث الفتوح ومن مرّانها قصدا",28,"د",2,0],["قد ضاع ما ملكت يدا","ه ولم يضع منه حياؤه",29,"ا",3,0],["قد ضاع في الاويل صدق عهودكم","ألكلّ عهد عندكم تأويل",30,"ل",1,0],["قَد ضَمَنا وَالكِرام بُستانُ","كَأَنَّنا في الجِنان سُكانُ",31,"ن",1,1],["قد ضاق رحب الفؤاد مني","وأحرقت مهجتي الإساءه",32,"ه",1,1],["قد ضاقَ وصف الذِّم فيك لأنني","رائيكَ لا شيئاً من الأشياءِ",33,"ا",2,0],["قد ضمَّ قبرُكَ ما يُحَدُّ","وإن نفسكَ لا تُحَدُّ",34,"د",1,0],["قد ضاقَ ذَرعُ الكُفرِ منكَ وأهلُهُ","بموفقِ الإيرادِ والإصدارِ",35,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ المَجَرَّةَ رَوضَةً","تُرعى وَزاهِرَةَ النُجومِ سَواما",36,"م",2,0],["قَد ضَلَّ عَنهُ فُؤادُهُ فَاِستَخبِري","عَينَيكِ أَينَ مَحَلُّهُ وَمَكانُهُ",37,"ن",2,0],["قَدْ ضاعَ فيكَ صَبْرِي","يا راغِباً فِي الغَدْرِ",38,"ر",1,1],["قَد ضَمِنَت رَوعَةُ الجَمالِ لَهُم","وَالناسِ أَن لا يَفوتَهُم وَطَرُ",39,"ر",1,0],["قَد ضَلَّ رشدُ من اِطّباه جمالُها","فَصَبا إِليها واِزدَهاهُ زُهاها",40,"ا",3,0],["قد ضَلَّ طالِبُ غادَةٍ حُميَت","في قومها بالبيض والسُمرِ",41,"ر",1,0],["قَدْ ضاعَ مني القلبُ يوم نأتْ فهل","من ناشدٍ يوم النَّوى قلبي معي",42,"ع",2,0],["قد ضل في خبر الأهرام عقل فتىً","أراد تحقيقه في سالف الحقب",43,"ب",1,1],["قد ضاع مني الخصر لما انثنت","أما تراني دائراً في قلق",44,"ق",1,0],["قد ضاع مني الخصر لما انثنى","أما تراني دائماً في قلق",45,"ق",1,0],["قَد ضلّ مَن مِن غيرِها طلب الهدى","لِصلاحه الروحيِّ والجسماني",46,"ن",2,0],["قد ضقت ذرعاً بها وأحبسها","لم أك أعصي الإله لولاها",47,"ا",3,0],["قَد ضَمِنَ الثَغرَ مِنهُ سينَ بَسمَلَةٍ","فَكُلُّ شَيءٍ بِها جاءَت بِدايَتُهُ",48,"ت",2,0],["قَدْ ضَمَّ حِلْمُكَ بَرَّيْهَا فَلا عَجَبٌ","هَبْ أَنَّ ذا جِلِّقٌ أوْ أَنّ ذا حَلَبُ",49,"ب",1,0],["قَد ضَمِنَ اللَهُ وَلَيسَ يَنكُثُ","أَنَّكَ ما اِمتَدَّ الزَمانُ تَلبَثُ",50,"ث",1,0],["قد ضَمَّنا يومَ غدَوْا مَوقفٌ","ما كانَ لولا البَينُ أَحْلاه",51,"ا",2,0],["قد ضمَّه واقعاً مقيماً","يرقُبُ ما يأمر الأميرُ",52,"ر",1,0],["قد ضم من رهبانه","من كل نفسٍ غاليه",53,"ي",2,0],["قد ضل من قد حاد عن كشف الزللْ","مذ زلَّ عن إيضاح ما فيه انفعلْ",54,"ل",1,1],["قد ضل من لم يرض في إيمانه","إلا الذي حقّاً يراه ويُخبِرُ",55,"ر",1,1],["قد ضمه الجدث الحديث بأمره","ولكل فعلٍ غايةٌ لا تُفسَخ",56,"خ",1,0],["قد ضم في الطرفين شرَّ عذابه","أبديةَ البلوى وعِظْمَ بلائه",57,"ا",3,0],["قَد ضاقَ غل التَنائي","عَلى خِناق الأَسير",58,"ر",1,0],["قَد ضاقَ بي سجن الهمو","م فَهَل لِأَسري مِن سِراج",59,"ج",1,0],["قَد ضاقَ بِالأَشواق فَاِنفَرَجَت","هُناكَ صُدوعَهُ",60,"ع",2,0],["قَد ضاقَ قَلبيَ بِالوَجد المُذيبِ لَهُ","فَلو أَرادَ مَزيداً مِنهُ ما وَجَدا",61,"د",2,0],["قد ضقت زرعا وصبري يا إلهي نفد","إن البلا يا إلهي قد تمادى وشد",62,"د",1,0],["قد ضل أقوام برؤيته","فغدوا وليس لدينهم ظل",63,"ل",1,0],["قد ضربت أشجارها","خيام وَشيٍ سندسي",64,"س",2,0],["قد ضم أحبابي وأترابي ومن","عاشرته بعد الممات ضريح",65,"ح",1,0],["قد ضمن الله لنا رزقنا","جاءت به الآثار 