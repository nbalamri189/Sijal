{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[55,"قد ضاق بالحب صدري","https://www.aldiwan.net/poem26332.html","المجتث"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[86,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[47,"قد ضج جيشك من طول القتال به","https://www.aldiwan.net/poem25202.html","البسيط"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[70,"عشقته أهيف قد","https://www.aldiwan.net/poem42810.html","مجزوء الرجز"],[78,"أنباء أسرك قد طبقن آفاقا","https://www.aldiwan.net/poem14223.html","البسيط"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[45,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[69,"قالوا أيؤذيك ولم تهجه","https://www.aldiwan.net/poem28711.html","السريع"],[13,"قد ضقت من حبها مالا يضيقني","https://www.aldiwan.net/poem2195.html","البسيط"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[46,"الحظ يقسم عاش بشر ما اشتكى","https://www.aldiwan.net/poem22566.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85620","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""]],"verses":[["قَد ضَمِنَ اللَهُ أَن تَدومَ لَنا","مُسَلَّماً وَالزَمانُ وَالدُوَلُ",0,"ل",1,0],["قَد ضاقَ بِالحُبِّ صَدري","وَأَنفَدَ الشَوقُ صَبري",1,"ر",2,1],["قَد ضِقتُ ذَرعاً بِالحَياةِ وَمَن","يَفقِد أَحِبَّتَهُ يَضِق ذَرعا",2,"ع",2,0],["قَد ضاقَ جِسمُكَ عَن مَداكَ فَلَم يُطِق","صَبراً عَلَيكَ وَأَنتَ شُعلَةُ نارِ",3,"ر",1,0],["قَد ضَمِنّا لَكَ القَضاءَ بِمِصرٍ","وَضَمِنّا لِنَجلِكَ الإِسعادا",4,"د",2,0],["قَد ضَمَّنا أَلَمُ الحَياةِ وَكُلُّنا","يَشكو فَنَحنُ عَلى السَواءِ وَأَنتُمُ",5,"م",1,0],["قد ضيّعوا الحزم حتى أنهم ندموا","على الذي كان منهم بعد ما كانا",6,"ن",2,0],["قد ضيّعت بغداد سابق عزّها","وغدت تَجيش بصدرها الحسرات",7,"ت",1,0],["قد ضلّ أهلُك رُشدَهم وهل اهتدى","قوم أجاهلهم هم السَرَوات",8,"ت",1,0],["قَد ضَجَّ جَيشُكَ مِن طولِ القِتالِ بِهِ","وَقَد شَكَتكَ إِلَينا الخَيلُ وَالإِبِلُ",9,"ل",1,1],["قَد ضَمِنَت خِذرافَهُ أَبارِقُه","رَعَت بَقايا حَمضِهِ أَيانِقُه",10,"ق",2,0],["قَد ضاقَ حَتّى إِنَّهُ","تَخرُجُ واواً أَلِفُه",11,"ف",2,0],["قَد ضاقَ صَدرُ المَعالي إِذ نُعِيَت لَها","وَقيل إِنَّ عَلَيكَ القَيدَ قَد ضاقا",12,"ق",2,0],["قد ضل من بالعلم في","الحياة لا يعتصم",13,"م",1,0],["قد ضيّعت أوقاتي","وأذهبت لذاتي",14,"ي",1,0],["قَد ضَمَّها فَزَكا نَعشٌ يُطافُ بِهِ","مُقَدَّمٌ كَلِواءِ الحَقِّ مُنفَرِدُ",15,"د",1,0],["قد ضلّ قوم بتآويلها","فيالها من صفقة خاسره",16,"ر",2,0],["قَد ضاعَفَ اللَهُ لِلدُنيا مَحاسِنَها","بِمُلكِ مُنتَخَبٍ لِلمُلكِ مُختارِ",17,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ بَعضَ الكَائِناتِ لَها","مَكثٌ وَلِلعالَمِ العُلوِيَّ تَخليدُ",18,"د",1,0],["قدْ ضرَّ دنياي فإنْ أهجُهُ","تطرَّقَ الضرُّ إلى ديني",19,"ي",1,0],["قَد ضِقتُ مِن حُبِّها مالا يُضَيِّقُني","حَتّى عُدِدتُ مِنَ البُؤسِ المَساكينِ",20,"ن",1,1],["قد ضُرّجَتْ بدم الحياء فأقبلتْ","متظلّماً من وَردها سُوسانها",21,"ن",3,0],["قد ضَمّ قُطرَيها العَجاجُ فما تَرى","بينَ السِّنانِ وكعبِهِ تخليلا",22,"ل",2,0],["قَد ضارَعَ الحُبُّ قَلبي ثُمَّ أَدرَكَهُ","وَهنُ المُحِبِّ فَأَمسى القَلبُ قَد غُلِبا",23,"ب",2,0],["قَد ضَنَّ مَن رُزِقَ الغِنى بِزَكاتِهِ","وَغَدا فَلا فَلحٌ وَلا تِعشارُ",24,"ر",1,0],["قد ضقت ذرعاً بكتما","نِك الغَرام فبوحي",25,"ي",1,1],["قد ضللنا الطَريق نخبط في الأر","ضِ كَما ضلَّ ذو عمىً مسمول",26,"ل",1,0],["قد ضَحِكتْ للنور فيها الزَّهرْ","وصفَّقَتْ أوراقُها للنسيمْ",27,"م",1,0],["قد ضاع ما ملكت يدا","ه ولم يضع منه حياؤه",28,"ا",3,0]]}