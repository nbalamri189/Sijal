 معانقا","https://www.poetsgate.com/ViewPoem.aspx?id=201202",""],[5449,"فاءٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188821",""],[5533,"ظُلْمُ الإخْوَة","https://www.poetsgate.com/ViewPoem.aspx?id=176386",""],[5535,"عندي هوىً لك طال عمر زمانه","https://www.poetsgate.com/ViewPoem.aspx?id=201504",""],[5595,"لَقيتُها ، وكأنَّ الدّمْعَ يُؤنِسُها","https://www.poetsgate.com/ViewPoem.aspx?id=177969",""],[5605,"من وحي رمضان 1436 ه","https://www.poetsgate.com/ViewPoem.aspx?id=177651",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5674,"الحظ العاثر","https://www.poetsgate.com/ViewPoem.aspx?id=207917",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5691,"جيل الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=205892",""],[5691,"رجس الأرض...!","https://www.poetsgate.com/ViewPoem.aspx?id=206310",""],[5725,"بغداد يا خوف الفؤاد وأمنه","https://www.poetsgate.com/ViewPoem.aspx?id=214502",""],[5736,"لا ماذا ولا أين","https://www.poetsgate.com/ViewPoem.aspx?id=208212",""],[5770,"شجب وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=178721",""],[5781,"أحلامٌ مُفكَّكةٌ ووِسادةٌ خالية","https://www.poetsgate.com/ViewPoem.aspx?id=202844",""],[5861,"رفقا حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=188296",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""],[5952,"حبَّات العِقد","https://www.poetsgate.com/ViewPoem.aspx?id=196747",""],[5956,"أبشِرْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=182324",""],[5956,"ما ذَلَّ حكمٌ إنْ يقربْ ناقدا","https://www.poetsgate.com/ViewPoem.aspx?id=184127",""],[5956,"رايتان خفاقتان في مصرَ للطيران","https://www.poetsgate.com/ViewPoem.aspx?id=202109",""],[5971,"شفة لماها زاد في الامي","https://www.poetsgate.com/ViewPoem.aspx?id=181202",""],[6078,"أعلنت حكمي","https://www.poetsgate.com/ViewPoem.aspx?id=202707",""],[399,"جزيرة الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68247&r=&rc=71",""],[6242,"دمشق يا وردة تاهَ النّسيم بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87573&r=&rc=20",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""],[2220,"إني نذرتُ وما في النذرِ من حرجٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11256&r=&rc=130",""],[6320,"أَجْرَاسُ السَّفَر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84361&r=&rc=58",""],[6341,"مداي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87282&r=&rc=11",""],[572,"قَامَ بالنَّفسِ في هَوَى قمرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9325&r=&rc=182",""]],"verses":[["قَد ضَمِنَ اللَهُ أَن تَدومَ لَنا","مُسَلَّماً وَالزَمانُ وَالدُوَلُ",0,"ل",1,0],["قَد ضاقَ بِالحُبِّ صَدري","وَأَنفَدَ الشَوقُ صَبري",1,"ر",2,1],["قَد ضِقتُ ذَرعاً بِالحَياةِ وَمَن","يَفقِد أَحِبَّتَهُ يَضِق ذَرعا",2,"ع",2,0],["قَد ضاقَ جِسمُكَ عَن مَداكَ فَلَم يُطِق","صَبراً عَلَيكَ وَأَنتَ شُعلَةُ نارِ",3,"ر",1,0],["قَد ضَمِنّا لَكَ القَضاءَ بِمِصرٍ","وَضَمِنّا لِنَجلِكَ الإِسعادا",4,"د",2,0],["قَد ضَمَّنا أَلَمُ الحَياةِ وَكُلُّنا","يَشكو فَنَحنُ عَلى السَواءِ وَأَنتُمُ",5,"م",1,0],["قد ضيّعوا الحزم حتى أنهم ندموا","على الذي كان منهم بعد ما كانا",6,"ن",2,0],["قد ضيّعت بغداد سابق عزّها","وغدت تَجيش بصدرها الحسرات",7,"ت",1,0],["قد ضلّ أهلُك رُشدَهم وهل اهتدى","قوم أجاهلهم هم السَرَوات",8,"ت",1,0],["قَد ضَجَّ جَيشُكَ مِن طولِ القِتالِ بِهِ","وَقَد شَكَتكَ إِلَينا الخَيلُ وَالإِبِلُ",9,"ل",1,1],["قَد ضَمِنَت خِذرافَهُ أَبارِقُه","رَعَت بَقايا حَمضِهِ أَيانِقُه",10,"ق",2,0],["قَد ضاقَ حَتّى إِنَّهُ","تَخرُجُ واواً أَلِفُه",11,"ف",2,0],["قَد ضاقَ صَدرُ المَعالي إِذ نُعِيَت لَها","وَقيل إِنَّ عَلَيكَ القَيدَ قَد ضاقا",12,"ق",2,0],["قد ضل من بالعلم في","الحياة لا يعتصم",13,"م",1,0],["قد ضيّعت أوقاتي","وأذهبت لذاتي",14,"ي",1,0],["قَد ضَمَّها فَزَكا نَعشٌ يُطافُ بِهِ","مُقَدَّمٌ كَلِواءِ الحَقِّ مُنفَرِدُ",15,"د",1,0],["قد ضلّ قوم بتآويلها","فيالها من صفقة خاسره",16,"ر",2,0],["قَد ضاعَفَ اللَهُ لِلدُنيا مَحاسِنَها","بِمُلكِ مُنتَخَبٍ لِلمُلكِ مُختارِ",17,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ بَعضَ الكَائِناتِ لَها","مَكثٌ وَلِلعالَمِ العُلوِيَّ تَخليدُ",18,"د",1,0],["قدْ ضرَّ دنياي فإنْ أهجُهُ","تطرَّقَ الضرُّ إلى ديني",19,"ي",1,0],["قَد ضِقتُ مِن حُبِّها مالا يُضَيِّقُني","حَتّى عُدِدتُ مِنَ البُؤسِ المَساكينِ",20,"ن",1,1],["قد ضُرّجَتْ بدم الحياء فأقبلتْ","متظلّماً من وَردها سُوسانها",21,"ن",3,0],["قد ضَمّ قُطرَيها العَجاجُ فما تَرى","بينَ السِّنانِ وكعبِهِ تخليلا",22,"ل",2,0],["قَد ضارَعَ الحُبُّ قَلبي ثُمَّ أَدرَكَهُ","وَهنُ المُحِبِّ فَأَمسى القَلبُ قَد غُلِبا",23,"ب",2,0],["قَد ضَنَّ مَن رُزِقَ الغِنى بِزَكاتِهِ","وَغَدا فَلا فَلحٌ وَلا تِعشارُ",24,"ر",1,0],["قد ضقت ذرعاً بكتما","نِك الغَرام فبوحي",25,"ي",1,1],["قد ضللنا الطَريق نخبط في الأر","ضِ كَما ضلَّ ذو عمىً مسمول",26,"ل",1,0],["قد ضَحِكتْ للنور فيها الزَّهرْ","وصفَّقَتْ أوراقُها للنسيمْ",27,"م",1,0],["قد ضمّ هذا الثرى من صيدها مزقا","إرث الفتوح ومن مرّانها قصدا",28,"د",2,0],["قد ضاع ما ملكت يدا","ه ولم يضع منه حياؤه",29,"ا",3,0],["قد ضاعت الحرمة بعد صونها","وشنت الغارة في عقر الحمى",30,"ا",1,0],["قد ضاع في الاويل صدق عهودكم","ألكلّ عهد عندكم تأويل",31,"ل",1,0],["قَد ضَمَنا وَالكِرام بُستانُ","كَأَنَّنا في الجِنان سُكانُ",32,"ن",1,1],["قد ضاق رحب الفؤاد مني","وأحرقت مهجتي الإساءه",33,"ه",1,1],["قد ضاقَ وصف الذِّم فيك لأنني","رائيكَ لا شيئاً من الأشياءِ",34,"ا",2,0],["قد ضمَّ قبرُكَ ما يُحَدُّ","وإن نفسكَ لا تُحَدُّ",35,"د",1,0],["قد ضاقَ ذَرعُ الكُفرِ منكَ وأهلُهُ","بموفقِ الإيرادِ والإصدارِ",36,"ر",1,0],["قَد ضَلَّ مَن ظَنَّ المَجَرَّةَ رَوضَةً","تُرعى وَزاهِرَةَ النُجومِ سَواما",37,"م",2,0],["قَد ضَلَّ عَنهُ فُؤادُهُ فَاِستَخبِري","عَينَيكِ أَينَ مَحَلُّهُ وَمَكانُهُ",38,"ن",2,0],["قَدْ ضاعَ فيكَ صَبْرِي","يا راغِباً فِي الغَدْرِ",39,"ر",1,1],["قَد ضَمِنَت رَوعَةُ الجَمالِ لَهُم","وَالناسِ أَن لا يَفوتَهُم وَطَرُ",40,"ر",1,0],["قَد ضَلَّ رشدُ من اِطّباه جمالُها","فَصَبا إِليها واِزدَهاهُ زُهاها",41,"ا",3,0],["قد ضَلَّ طالِبُ غادَةٍ حُميَت","في قومها بالبيض والسُمرِ",42,"ر",1,0],["قَدْ ضاعَ مني القلبُ يوم نأتْ فهل","من ناشدٍ يوم النَّوى قلبي معي",43,"ع",2,0],["قد ضل في خبر الأهرام عقل فتىً","أراد تحقيقه في سالف الحقب",44,"ب",1,1],["قد ضاع مني الخصر لما انثنت","أما تراني دائراً في قلق",45,"ق",1,0],["قد ضاع مني الخصر لما انثنى","أما تراني دائماً في قلق",46,"ق",1,0],["قَد ضلّ مَن مِن غيرِها طلب الهدى","لِصلاحه الروحيِّ والجسماني",47,"ن",2,0],["قد ضقت ذرعاً بها وأحبسها","لم أك أعصي الإله لولاها",48,"ا",3,0],["قَد ضَمِنَ الثَغرَ مِنهُ سينَ بَسمَلَةٍ","فَكُلُّ شَيءٍ بِها جاءَت بِدايَتُهُ",49,"ت",2,0],["قَدْ ضَمَّ حِلْمُكَ بَرَّيْهَا فَلا عَجَبٌ","هَبْ أَنَّ ذا جِلِّقٌ أوْ أَنّ ذا حَلَبُ",50,"ب",1,0],["قَد ضَمِنَ اللَهُ وَلَيسَ يَنكُثُ","أَنَّكَ ما اِمتَدَّ الزَمانُ تَلبَثُ",51,"ث",1,0],["قد ضَمَّنا يومَ غدَوْا مَوقفٌ","ما كانَ لولا البَينُ أَحْلاه",52,"ا",2,0],["قد ضمَّه واقعاً مقيماً","يرقُبُ ما يأمر الأميرُ",53,"ر",1,0],["قد ضم من رهبانه","من كل نفسٍ غاليه",54,"ي",2,0],["قد ضل من قد حاد عن كشف الزللْ","مذ زلَّ عن إيضاح ما فيه انفعلْ",55,"ل",1,1],["قد ضل من لم يرض في إيمانه","إلا الذي حقّاً يراه ويُخبِرُ",56,"ر",1,1],["قد ضمه الجدث الحديث بأمره","ولكل فعلٍ غايةٌ لا تُفسَخ",57,"خ",1,0],["قد ضم في الطرفين شرَّ عذابه","أبديةَ البلوى وعِظْمَ بلائه",58,"ا",3,0],["قَد ضاقَ غل التَنائي","عَلى خِناق الأَسير",59,"ر",1,0],["قَد ضاقَ بي سجن الهمو","م فَهَل لِأَسري مِن سِراج",60,"ج",1,0],["قَد ضاقَ بِالأَشواق فَاِنفَرَجَت","هُناكَ صُدوعَهُ",61,"ع",2,0],["قَد ضاقَ قَلبيَ بِالوَجد المُذيبِ لَهُ","فَلو أَرادَ مَزيداً مِنهُ ما وَجَدا",62,"د",2,0],["قد ضقت زرعا وصبري يا إلهي نفد","إن البلا يا إلهي قد تمادى وشد",63,"د",1,0],["قد ضل أقوام برؤيته","فغدوا وليس لدينهم ظل",64,"ل",1,0],["قد ضربت أشجارها","خيام وَشيٍ سندسي",65,"س",2,0],["قد ضم أحبابي وأترابي ومن","عاشرته بعد الممات ضريح",66,"ح",1,0],["قد ضمن الله لنا رزقنا","جاءت به الآثار والنص",67,"ص",1,0],["قد ضاق بي الذرع ضيق الوقف من جر","م لو صور البعض منها أفعم الأفقا",68,"ق",2,0],["قد ضيّعت عصبة للنقل مكتبتي","يا عصبة النقل قد خلدت في العار",69,"ر",1,0],["قد ضاعَ جهدىَ فيهم واغتدى أملي","يأساً ولو أنني ما زلتُ مغتفرا",70,"ر",2,0],["قد ضاعَ بين الهازل","ين من الحسيب إلى النسيبِ",71,"ب",1,0],["قد ضمِنَ البارحُ عنهم فوفَى","ما ساءني إذ مرَّ غيرَ أيمَنِ",72,"ن",1,0],["قد ضمّنت أبياته الثقل","ين من إنسٍ وجنَّه",73,"ن",2,0],["قَد ضاقَتِ الحيلَةُ بي في رَشاً","لا يَقبَلُ الرِشوَةَ مِن ذُلّي",74,"ل",2,1],["قَد ضاقَتِ الحيلَةُ بي في رَشاً","لا يَقبَلُ الرِشوَةَ في وُدّي",75,"ي",1,1],["قَد ضَحِكَت غُرَّةُ الصَباحِ","وَاِندَفَعَ الديكُ في الصِياحِ",76,"ح",1,1],["قَد ضَلَّ فَكري عِن طَريقِ صَوابِهِ","مُذ صارَ يَطمَعُ في بُلوغِ صِفاتِهِ",77,"ت",2,0],["قد ضنَّ بخلاً بما قد كانَ يمنحُني","بهِ إلى أن غدا مِن بعضِ حُسادي",78,"د",2,0],["قد ضاقَ صَدرُه فسالَ دَمعُهُ","ويَدُه من سَقَمٍ تُوجِعهُ",79,"ه",1,0],["قد ضرّني الصّدقُ فمنْ ذا الّذي","يَنفعني يا قومُ بالكذبِ",80,"ب",1,0],["قد ضاق جسمك عن مدى النَّفس التّي","ضغطت هياكِلها جميع جهاتهِ",81,"ت",2,0],["قد ضاعَ ما كَتَبَ الأقوامُ واجتهدوا","وما لِمَنْ قد أضلَّ اللهُ من هادِ",82,"د",1,0],["قد ضَمَّ منك الفُلكُ أفناناً كما","ضَمَّتْ سفينةُ نوحَ من أجيالِهِ",83,"ل",2,0],["قَدْ ضَحِكَتْ مِنْ صُرُوفِ دَهْرٍ","أَحْدَاثُهُ جَمَّةٌ فَظِيْعَهْ",84,"ع",2,0],["قَدْ ضُرِبَتْ خَيْمَةُ الغَمَامِ لنا","وَرُشّ جيش النّسِيْمِ بالمَطَرِ",85,"ر",1,0],["قد ضاقَ واللهِ جسمي فيكَ عن رُوحِي","فلا تَسَلْنِيَ عن وجْدي وتبريحي",86,"ي",1,1],["قد ضمنا هذا اللسان كأخوة","أبناء أم بعضنا بعضاً نحب",87,"ب",1,0],["قد ضاعَ نشرُ عبيرها","مُذ جسمها فيه تضرّج",88,"ج",1,0],["قَد ضَجَّ مِنّيَ صَحبي إذ حَمَلتُهُمُ","عَلى نَواهِق إنقاضٍ بأنقاض",89,"ض",1,0],["قد ضيّع اللهُ ما جمّعتُ من أدبٍ","بين الحميرِ وبين الشاءِ والبقرِ",90,"ر",1,1],["قد ضاع صبري خانني جلدي كفى","هزءاً بصبٍّ انت ربَّةُ قلبهِ",91,"ب",2,0],["قَد ضَعضَعَ الدهر حالي عِندَما نُهِبَت","بِالشامِ أَيّامَ تَيمُرلَنكَ أَموالي",92,"ل",2,0],["قد ضاق صدري من صدور زماننا","فهم جماع الشر بالإجماع",93,"ع",1,1],["قَد ضَلَّ عَن نَفعِهِ شَخصٌ يُشاوِرُكم","وضلَّ مَنْ كانت العميانُ تهديهِ",94,"ه",1,0],["قَد ضاعَ لُبّي وَالحِجى","مِن حَملِ ما لا قَد يُطاق",95,"ق",1,0],["قَد ضاعَ عُمري في الهَوى وَصَبابَتي","وَقوايَ ضاعَت وَالحِمامُ لَقَد دَنا",96,"ن",2,1],["قَ