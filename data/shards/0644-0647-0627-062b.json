{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[45,"مغاني الشعب طيبا في المغاني","https://www.aldiwan.net/poem10596.html","الوافر"],[47,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[50,"وجه بنان كأنه قمر","https://www.aldiwan.net/poem66152.html","المنسرح"],[48,"إذا عثر القوم فاغفر لهم","https://www.aldiwan.net/poem22751.html","المتقارب"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1940","المتقارب"],[47,"وعالمة وقد جهلت دوائي","https://www.poetsgate.com/ViewPoem.aspx?id=32838",""],[136,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[136,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126858","المتقارب"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216918","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49550","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65959","الطويل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32443","الهزج"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45997","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94466","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94463","الوافر"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117186","الطويل"],[5277,"دع القيلَ..فلا بديل","https://www.poetsgate.com/ViewPoem.aspx?id=187711",""],[5431,"أمازلتَ ياقلبي تضخّ له الحُبا","https://www.poetsgate.com/ViewPoem.aspx?id=189641",""],[5759,"مُسَهِّدَتي","https://www.poetsgate.com/ViewPoem.aspx?id=213782",""],[5829,"فتاة السكر","https://www.poetsgate.com/ViewPoem.aspx?id=210632",""]],"verses":[["لَها ثَبطٌ عَلى الأَيّامِ باقٍ","تَجيشُ بِها مَعيناً أَوأُجاجا",0,"ج",2,0],["لَها ثُنَنٌ كَخَوافي العُق","بِ سودٌ يَفينَ إِذا تَزبَئِر",1,"ر",1,0],["لُهاثٌ مُميتٌ تحت بيضاءَ سُخْنَةٍ","وَرِيٌّ مُفيتٌ تحت أسْحَمَ صائبِ",2,"ب",1,0],["لَها ثَمَرٌ تُشيرُ إِلَيكَ مِنهُ","بِأَشرِبَةٍ وَقَفنَ بِلا أَواني",3,"ن",2,0],["لَها ثَغرٌ وَمُبتَسِمٌ وَريقٌ","يَنوبُ عَنِ المُعَتَّقَةِ الطِلاءِ",4,"ا",2,0],["لَها ثَنايا تَحكي بِبَهجَتِها","وَحُسنِها أَلسُنَ المَوازينِ",5,"ن",1,0],["لَهُ أَثَرٌ كَجُروحِ السُيوفِ","وَلا أَثَرَ يَصحَبُ مِنهُ الأُثر",6,"ر",1,0],["لَها ثُنَنٌ كَخَوافي العُقا","بِ سودٌ يَفينَ إِذا تَزبَئِر",7,"ر",1,0],["لها ثغر ومبتسم، وريق","ينوب عن المتعتقة الطلاء",8,"ا",2,0],["لَها ثغر يعلّ بصرخديٍّ","به تفتر عن حَبِّ الغمام",9,"م",1,0],["لَهَا ثَغرٌ شَتِيتَ النَّبتِ فِيهِ","بُعيَدَ النَّومِ مَمزوجٌ العُقَارِ",10,"ر",1,0],["له أثرٌ في جميع النفوس","هَدانا لنهجٍ سويٍّ قويم",11,"م",1,0],["لَهُ أثرٌ في الأرْضِ لحبٌ كأنّهُ","نبيثُ مَسَاحٍ منْ لِحَاءِ مَهِيقِ",12,"ق",1,0],["لَهَا ثغرُ دُرّ عَنْهُ يَرْوِي ابن مزهر","ومُقْلَةُ لحظٍ عنه يَرْوِي ابن مُقْلَةِ",13,"ه",1,0],["له آثرٌ في كلِّ شَرْقٍ وَمَغْرِبٍ","به تَهْتَدِي الزُّهْرُ الكواكبُ أو تَهْدي",14,"د",2,0],["لها ثلث ثلثي ثلث ودّى وثلثه","ومن ودها لي تسع قيراط معشار",15,"ر",1,0],["لَها ثَغرٌ حَكى الدُرَّ","وَعَينا رَشَأٍ أَحوَر",16,"ر",1,0],["لَهُ اِثنانِ مِن كُلِّ مُضافٍ لِإِرثِهِ","مِن إِخوَتِهِ غَيرَ الأَخيرِ الَّذي تَلا",17,"ل",2,0],["لَها ثَغرٌ بياقوتٍ وماس","تنضَّد في ظروفٍ عسجديَّه",18,"ي",2,0],["لها ثَغرٌ بياقوتٍ وماسٍ","تنضَّد سبّحوا مولىً براها",19,"ا",3,0],["لهُ أثَرٌ في المكرماتِ يسرُّنا","وأنتَ تُعَفّي دائماً ذلك الأثَر",20,"ر",1,0],["لهاثُ الوجدِ قد أعياه نأيٌ","وليلٌ صار في المنفى طويلاً",21,"ل",2,0],["له أُثقلت نخلاتُ روحي برطبها","يهزّ لها شوقا ويجني بها رطْبا",22,"ب",2,0],["لَهَا ثغرٌ بهِ ضَرَبٌ شتيتٌ","إذا نَطقَت بهِ قَتلَت بلادا ٥",23,"د",2,0],["لها ثغر البلابل، حين تشدو","يفوح المسك من عبق وعنبر",24,"ر",1,0]]}