{"poems":[[45,"رضاك رضاي الذي أوثر","https://www.aldiwan.net/poem9564.html","المتقارب"],[71,"وأفشيت سري إلى صاحب","https://www.aldiwan.net/poem28638.html","المتقارب"],[119,"وهى حملي وضقت لثقل حوبي","https://www.aldiwan.net/poem42160.html","الوافر"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[382,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[416,"حمدنا الذي أدى ابن يحيى فأصبحت","https://www.aldiwan.net/poem67519.html","الطويل"],[422,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[1394,"","https://poetry.dctabudhabi.ae/diwan/poem/199967","الوافر"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44755","الرمل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113873","الخفيف"]],"verses":[["وَإِفشاءُ ما أَنا مُستَودَعٌ","مِنَ الغَدرِ وَالحُرِّ لا يَغدِرُ",0,"ر",1,0],["وأفشيْتُ سرِّي إلى صاحبٍ","فعدْتُ لهُ طولَ دهري ذليلا",1,"ل",2,1],["وافشوا الافترا وبغوا وجاروا","وجاؤني ببغضهم الغريب",2,"ب",1,0],["وأفشيت بي سري إلي فأصبحت","وقد أعربت إذ أفصحت عنه عجمتي",3,"ي",1,0],["وأفشى بينهم سرّاً مصوناً","فكان الرمز عندهمُ المقالا",4,"ل",2,0],["وَأَفشى بِلا مَنٍّ مَعَ العَدلِ فيهِم","أَيادِيَ عُرفِ باقِياتِ وَعُوَّدا",5,"د",2,0],["وأَفشى بسرِّي دمع العيون","وسرّ الصَّبابة لا يُكتَم",6,"م",1,0],["وأفشوا سر ساقيهم بلفظ","مبين ليس يفهمه البصير",7,"ر",1,0],["وَافشيا السِرَّ فَما يَهنأُ لي","شُربُها إِلّا اذا السِرُّ فَشا",8,"ش",2,0],["وافش مني تحية وسلاما","ثم عرض بذكر ما قد دهاني",9,"ن",2,0]]}