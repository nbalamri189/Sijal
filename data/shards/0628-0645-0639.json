با","يوطي الحِمى وَيَهتِكُ الحِجابا",0,"ب",2,0],["بِمُعتَرَكٍ يُلقي بِهِ المَوتُ بَركَهُ","يُسَلُّ لَجَيناً ثُمَّ يُغمَدُ عَسجَدا",1,"د",2,0],["بمُعْتَرَكِ العِزِّ الذي في ظِلالهِ","أفُلُّ شَبا الخَطْبِ الذي جارَ واعْتَدى",2,"د",2,0],["بمَعالي مُحمّدِ ابْنِ أبي الحَجّا","جِ ليْثِ العِدَى وغَيْثِ السّماح",3,"ح",1,0],["بِمُعتَرَكٍ ضَيِّقٍ بَينَهُ","تَجُرُّ المَنِيَّةُ أَذيالَها",4,"ل",3,0],["بِمَعقودَةٍ في نَسعِ رَحلٍ تَقَلقَلَت","إِلى الماءِ حَتّى اِنقَدَّ عَنها طَحالِبُه",5,"ب",2,0],["بمعاهد الإيمان والدين التي","قد صافحَتْ عرصاتُها جبريلا",6,"ل",2,0],["بِمُعتَرَكٍ تَهوي لِوَقعِ ظُباتِها","خَذاريفُ هامٍ أَو مَعاصِمُ تُطرَحُ",7,"ح",1,0],["بِمُعتَرَكِ منَ الأَبطَالِ ضَنكِ","تُرَى فِيهِ الجَمَاجَم كالكُرِينَا",8,"ن",2,0],["بمعجَّل المكيول من إنعامه","ومن المدائح فيه بالموزون",9,"ن",1,0],["بمعجز نظم الدرّ غير منقَّب","وإخراج ما أعيى الورَى من جنيّه",10,"ي",2,0],["بمعرفةٍ لا يَقْرعُ الشكُّ بابها","ولا طعْنُ ذي طعنٍ عليها بهاجمِ",11,"م",1,0],["بِمُعرِضٍ أَو مُعيدٍ أَو بَني الخَطَفى","تَرجو جَريرُ مُساماتي وَأَخطاري",12,"ر",2,0],["بمعتركِ الأحلام يطلبُ ثأرَهُمْ","بنو الحربِ والبيضُ الحسانُ الرعابيبُ",13,"ب",1,0],["بِمُعَوَّدٍ لِلسَيرِ مُحتَقَرٍ لَهُ","مَرِنَت قَوائِمُهُ عَلى التَخويدِ",14,"د",1,0],["بِمُعتَمَدٍ فيها عَلى اللَهِ أُسنِدَت","إِلَيهِ فَأَلفَتهُ الرِضا المُتَخَيِّرا",15,"ر",2,0],["بِمُعتَرَكٍ ضَنكٍ بِهِ قِصَدُ القَنا","وَضَعنا بِهِ أَقدامَنا فَاِستَقَرَّتِ",16,"ت",1,0],["بِمُعتَرَكٍ لا تَنجَلي غَمَراتُهُ","عَنِ القَومِ إِلّا وَالرِماحُ رَواعِفُ",17,"ف",1,0],["بِمَعانٍ مِنَ الجَزالَةِ كَالصَخ","رِ وَلَفظٍ مِن رِقَّةٍ كَالنَسيمِ",18,"م",1,0],["بِمَعانٍ تُضيءُ في ظُلمَةِ الحِب","رِ شَبيهَ الكَواكِبِ الزاهِراتِ",19,"ت",1,0],["بِمَعانٍ لَو كُنَّ في سالِفِ العَص","رِ لَسَكَّت مَسامِعَ السِكّاكِ",20,"ك",1,0],["بمعترك بالضرب والطَّعن جُرْدهُ","تمرّ على صرْعى العوادي عواديا",21,"ي",2,0],["بِمُعطٍ غَداةَ السيرِ ظَهرَ حَنِيّةٍ","بَنَيتُ عَلَيها الكورَ فانْهَدَّ تامِكُه",22,"ك",2,0],["بمعتّقَةٍ قَدُمَتْ فأتَتْ","للشَّرْبِ بلذّاتٍ جُدُدِ",23,"د",1,0],["بِمُعتَصِمٍ بِاللَهِ أَصبَحَ مَلجَأً","وَمُعتَصَماً حِرزاً لِكُلِّ مُوائِلِ",24,"ل",1,0],["بِمُعتَصِمٍ بِاللَهِ قَد عُصِمَت بِهِ","عُرى الدينِ وَاِلتَفَّت عَلَيها وَسائِلُه",25,"ل",2,0],["بِمُعَرَّسِ العَرَبِ الَّذي وَجَدَت بِهِ","أَمنَ المَروعِ وَنَجدَةَ المَنجودِ",26,"د",1,0],["بِمُعَرَّسٍ فيهِ إِذا ما مَسَّهُ","جِلدي خُشونَةُ مَضجَعٍ وَبِعادِ",27,"د",1,0],["بِمُعضِلَةٍ تَشيبُ لَها النَواصي","فَما تَلقى هُنالِكَ غَيرَ شيبِ",28,"ب",1,0],["بِمَعمِيَّةٍ يُمسي القَطا وَهوَ نُسَّسٌ","بِها بِعدَ وَلقِ للَيلَتَينِ المُسَمِّحِ",29,"ح",1,0],["بِمُعتَلَجِ السُيُولِ إِذا تَبَنّى","لِئامُ الناسِ في الشُعَبِ العِماقِ",30,"ق",1,0],["بِمُعَرَّسٍ فيهِ إِذا ما مَسَّهُ","جَنبي حُزُونَةُ مَضجَعٍ وَتَعادي",31,"د",2,0],["بمعوديّةِ الدين العتيقِ","بماري بطرسٍ بالجاثليقِ",32,"ق",1,1],["بِمُعَضِّلٍ لَجِبٍ كَأَنَّ عُقابَهُ","في رَأسِ خُرصٍ طائِرٌ يَتَقَلَّبُ",33,"ب",1,0],["بمعالي محمد بن الحجاج","ليث العدا أو غيث السماح",34,"ح",1,0],["بمعدن الأحوال والأسرار","أبى سعيد العارف البخاري",35,"ي",1,0],["بمعزلس عن هموم أنت موقدها","أرعى وأنت على الأيام غفلان",36,"ن",1,0],["بمعترك عند الجياع أوانه","جوابٍ قدورٌ راسياتٌ مرذَّما",37,"م",2,0],["بمعانٍ كأنها اللؤلؤُ الر","رَطب تفوقُ السمطَ الثمينَ نِظامَا",38,"م",2,0],["بمعانٍ أرقَّ من جَسد الما","ء لكن تُفتِّتُ الجلمودَا",39,"د",2,0],["بِمُعتَركٍ ضَنكٍ تُرى كسرُ القَنا","بِهِ وَالنُسورُ الطُخم يَعكُفنَ كَالشربِ",40,"ب",1,0],["بِمَعصورَةٍ وَالدَهرُ ما اِصفَرَّ عودُهُ","فَيُلوي وَما أَلوى بِعادٍ وَجُرهُما",41,"م",2,0],["بِمُعاديكَ لا بِكَ الأَسواءُ","وَلِحُسّادِكَ الثَّرى لا الثَّراءُ",42,"ا",2,1],["بِمُعتَرَكٍ لا يَسمَعُ القَومُ وَسطَهُ","لَنا زَجمَةٌ إِلّا التَذامُرَ وَالنَقفا",43,"ف",2,0],["بِمعاني عُلاكَ تَفتَخِر الدُن","يا وَتَزهو بِسَعدِك الأَنحاءُ",44,"ا",2,0],["بمعتقد الثبت الإمام ابن حنبل","أدين فهو الناقل المتورع",45,"ع",1,0],["بمعانٍ بخورها لك طيبٌ","وفساها في لحية الزجاج",46,"ج",1,0],["بمعانٍ كالبدر في ليل سطرٍ","من حروف الأسرار وهي أمينهْ",47,"ن",2,0],["بمعارفه وعوارفه","وبما قد أبدى من حجج",48,"ج",1,0],["بِمُعتَرَكٍ ضَنكٍ بِهِ قِصَدُ القَنا","صَبَرنا لَهُ قَ