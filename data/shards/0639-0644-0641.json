{"poems":[[95,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[201,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[303,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[6152,"زمان الطيبين","https://www.poetsgate.com/ViewPoem.aspx?id=203747",""]],"verses":[["عَلَّ فِي مُثْرِي مَوَاطِنِنَا","مَنْ ضِخَامِ الرَّيْعِ وَالْكَسْبِ",0,"ب",1,0],["عل في جانب من الكون أرضا","ليس فيها كراهة وولوع",1,"ع",1,0],["عُلِفَتْ على دَعَةٍ فصارَتَ بُدَّناً","دُخْسَ البَضِيعِ خَفِيفَةَ الأَقْصابِ",2,"ب",1,0],["علّ في النّهلة ما ينفي","ولو بعض الريوب",3,"ب",1,0],["علَّ فيكم من يواسي","ذا أسىً ما زال يربو",4,"ب",2,0],["عَلَّ في عَامِكَ هَذا راحَةً","لِلنُهى مِمّا اِرتَآهُ الأَشأَما",5,"م",2,0],["عَلَّ في يُمناكَ لي مُعجِزَةً","وَبِيُسراكَ النَضارُ اِبتَسَما",5,"م",2,0],["عَلّ في الليل رحمةَ لوجيعٍ","أغرقَته الآلام في سَكَراتِهْ",6,"ت",2,0],["عّل فيها ذكريات حلوة","كم خلود جاء من بعد الرحيل",7,"ل",1,1]]}