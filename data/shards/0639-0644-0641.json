{"poems":[[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[197,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[298,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"]],"verses":[["عَلَّ فِي مُثْرِي مَوَاطِنِنَا","مَنْ ضِخَامِ الرَّيْعِ وَالْكَسْبِ",0,"ب",1,0],["عل في جانب من الكون أرضا","ليس فيها كراهة وولوع",1,"ع",1,0],["عُلِفَتْ على دَعَةٍ فصارَتَ بُدَّناً","دُخْسَ البَضِيعِ خَفِيفَةَ الأَقْصابِ",2,"ب",1,0],["علّ في النّهلة ما ينفي","ولو بعض الريوب",3,"ب",1,0],["علَّ فيكم من يواسي","ذا أسىً ما زال يربو",4,"ب",2,0]]}