{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[53,"لو علمت أي فتى ماجد","https://www.aldiwan.net/poem30613.html","السريع"],[6,"يا آل زيد مناة هل من زاجر","https://www.aldiwan.net/poem376.html",""],[77,"من استغضبت من هذي الخليقه","https://www.aldiwan.net/poem35915.html","الوافر"],[77,"السعد جندك والقضاء دليل","https://www.aldiwan.net/poem36373.html","الكامل"],[71,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[10,"أبكي لصخر إذا ناحت مطوقة","https://www.aldiwan.net/poem21071.html","البسيط"],[93,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[72,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[51,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[61,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[61,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[49,"تخفف من الدنيا لعلك أن تنجو","https://www.aldiwan.net/poem62025.html","الطويل"],[80,"الدمع ينطق واللسان صموت","https://www.aldiwan.net/poem31531.html","الكامل"],[44,"أعتبة إن تطاولت الليالي","https://www.aldiwan.net/poem30024.html","الوافر"],[44,"وقائلة حج عبد العزيز","https://www.aldiwan.net/poem30342.html","المتقارب"],[44,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[74,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[105,"جزى الله ما أديتما من حقوقه","https://www.aldiwan.net/poem43160.html","الطويل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[49,"تخفَّف منَ الدُّنيا لعلكَ أنْ تنجُو","https://www.poetsgate.com/ViewPoem.aspx?id=16978",""],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[107,"ما أحمل القلب للبلوى واصبره","https://www.aldiwan.net/poem16290.html","البسيط"],[140,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[140,"وعيشكم لا ورد الحوم","https://www.aldiwan.net/poem58424.html","السريع"],[141,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[141,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[141,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[167,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[184,"مناسب الناس تخفى في مغارسهم","https://www.aldiwan.net/poem44157.html","البسيط"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[187,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[196,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[229,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[233,"آنسن في الفودين وخط بياض","https://www.aldiwan.net/poem31901.html","الكامل"],[259,"أيظن بي أني رنا أو مالا","https://www.aldiwan.net/poem38210.html","الكامل"],[259,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[259,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[273,"ويح ابن آدم غرته سلامته","https://www.aldiwan.net/poem25389.html","البسيط"],[273,"رويد الليالي كم تصر على الغدر","https://www.aldiwan.net/poem25559.html","الطويل"],[280,"أطربني صوت حمام شدا","https://www.aldiwan.net/poem32796.html","السريع"],[318,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[320,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[355,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[362,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[362,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[402,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[413,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[429,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[429,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[429,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[441,"من أسرة الغنام ذات صيانة","https://www.aldiwan.net/poem56041.html","عموديه"],[456,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[456,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[456,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[456,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[459,"ولما تراءت كعبة البيت كعبة","https://www.aldiwan.net/poem16377.html","الطويل"],[462,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[462,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[513,"أصبت في خير أعضائي وأعضادي","https://www.aldiwan.net/poem12069.html","البسيط"],[513,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[525,"يا عضد الدولة من يمناها","https://www.aldiwan.net/poem45981.html","الرجز"],[556,"من أسخط الناس في مرضاة خالقه","https://www.aldiwan.net/poem33839.html","البسيط"]],"verses":[["مِن أُسرَةٍ تُنبِتُ التيجانَ هامُهُمُ","مَنابِتَ النَبعِ في الأَطوادِ وَالقُنَنِ",0,"ن",1,0],["مَن أَسقَمَ الناسَ رَمَوهُ بِالسَقَم","وَمَن رُمِي بِالموقِظاتِ لَم يَنَم",1,"م",1,0],["مِن أَسَدٍ طالَ بِهِ عُمرُهُ","وَمِن قَريبِ العُمرِ مُستاسِدِ",2,"د",1,0],["مِنّا سَلامَةُ إِذ أَتانا ثائِراً","يَعدُو بِأَبيضَ كَالغَديرِ حُسامِ",3,"م",1,0],["مَنِ اسْتَغْضَبْتَ منْ هَذي الخَليقَهْ","بمُغْضِبَةٍ بإنْكارٍ خَليقَهْ",4,"ق",2,1],["مِنْ أُسْرَةٍ سَعْدِيةٍ نَصْرِيَّةٍ","أَثْنَى عَلَيْهَا اللهُ والتَّنْزِيلُ",5,"ل",1,0],["مِن أُسرَةٍ عَرَبِيَّةٍ جاءَت بِهِ","عَرَبِيَّةٌ آباؤُها أَحرارُ",6,"ر",1,0],["مِن أُسرَةٍ حازَ شيبانُ الفخارَ بِهِم","فَهم لَهُ شَرَفٌ باقٍ إِذا اِنتَسَبوا",7,"ب",3,0],["مِن أُسدِ بَيشَةَ يَحمي الخِلَّ ذي لِبَدٍ","مِن أَهلِهِ الحاضِرِ الأُدنَينِ وَالبادي",8,"ي",1,0],["مَنْ أَسْعَدَ النَّاسِ لاقَى","جَزَاءهُ فِي النَّعِيمِ",9,"م",1,0],["مَناسِمُها خُثمٌ صِلابٌ كَأَنَّها","رُؤوسُ الضِبابِ اِستَخرَجَتها الظَهائِرُ",10,"ر",1,0],["من أسرةٍ عمريةٍ عدويةٍ","شهدت بفضل مكانها أعداؤه",11,"ا",3,0],["من أسرة تقوية حظ الأولى","يوم الفخار لقهرها أن يتقوا",12,"ق",3,0],["من اسْتقامت به الأوقات واعْتدلت","للناسِ قبلَ نزول الشمس في الحمل",13,"ل",1,0],["من أساء الفِعال والقولَ ولَّى","عن أخيه ذا حُجَّةٍ مخصومه",14,"م",2,0],["مِن أُسودٍ تَسَربَلَت بِالحَديدِ","وَمِنَ الجِنِّ في رَواءِ الجُنودِ",15,"د",1,1],["من استدارة القمر","إلى لطافة الزهر",16,"ر",1,0],["من أسرةٍ أَسَرَتْ لها صِيدَ العُلى","وقَفَاتُ أَصْيَدَ في الرَّدى وَقَّافِ",17,"ف",1,0],["من أُسرةٍ قهَروا كِسرى وأسرتَه","والنَّاسُ مهتَضَمٌ منهم ومقهورُ",18,"ر",1,0],["مَنِ استَطرَفَ الشَيءَ استَلَذَّ اطِّرافَهُ","وَمَن مَلَّ شَيئاً كانَ فيهِ لَهُ مَجُّ",19,"ج",1,0],["مَن أَستَعينُ بِهِ على فرط الأسَى","فأنا الذي بجنايَتي عوديتُ",20,"ت",1,0],["مَناسِبُ كَلبَ قَد قُسِمَت فَدَعها","فَلَيسَت مِثلَ نِسبَتِكَ المُشاعَه",21,"ع",2,0],["مَناسِكُهُ فيهِ مَقبولَةٌ","وَحَجَّتُهُ بَرَّةٌ بِالتَمامِ",22,"م",1,0],["مَناسِبٌ تُحسَبُ مِن ضَوئِها","مَنازِلاً لِلقَمَرِ الطالِعِ",23,"ع",1,0],["مِن أُسرَةٍ نَشَأوا غَمائِمَ أَزمَةٍ","وَلَرُبَّما طَلَعوا بُدورَ حَنادِسِ",24,"س",1,0],["مِن أُسرَةٍ يَتَلَثَّمونَ إِلى الوَغى","يَومَ الحَفيظَةِ بِالعَجاجِ الأَقتَمِ",25,"م",1,0],["مَناسِكُ قامَ الدينُ في جَنَباتِها","يُحَيّي فَريقَ اللَهِ مِن كُلِّ قائِمِ",26,"م",1,0],["مَنِ استَنَّ تفضيلَ الجِياد لأهلِها","فأوطأهَا هامَ العِدى والسَّنوَّرا",27,"ر",2,0],["مَن أَسبغَ النُّعمى وكانتْ مَحْقَا","وفتَّق الدُّنيا وكانتْ رَتْقا",28,"ق",2,0],["من استطاع دفاعاً عن حقيقته","فإنه وحده في قومه البطل",29,"ل",1,0],["من استطاع أخذ شيء عنوة","كان له عن العلاج غنوة",30,"ه",1,0],["مِنْ أُسْرةٍ هُمْ أَهْلُ كُلِّ مُروُءَةٍ","يَوْمَ الْحِفَاظِ وَأَهْلُ كُلِّ ثَنَاءِ",31,"ا",2,0],["مِنْ أُسْرَةٍ طَهُرَتْ","خَلاَئِقُهَا وَلَمْ تُوصَمْ بِعَابْ",32,"ب",1,0],["من أساطير الشعوب الأول","ورموا بالغاز قتالاً فإن",33,"ن",1,0],["مَنْ أسكَن الذِّئْبَ الشَّرَى؟","أين الوِجَارُ من العرين؟",34,"ن",1,0],["مَنِ استَظرَفَ الشيءَ استَلَذّ بظَرْفِه،","ومَنْ مَلّ شَيئاً كانَ فيهِ لهُ مَجّ",35,"ج",1,0],["مِن أسارير الحِمى سرتَ إلى","قلبهِ كي تنجلي يوم اسودادي",36,"د",2,0],["مِن أُسرة مَلَكوا رَقَ الفَخار وَقَد","حازوا مِن الفَضل دونَ الناس أَوفَرَهُ",37,"ر",2,0],["مَناسكُ منهوجةٌ بالوجَى","يُجَبُّ على إثرهن السَّنامُ",38,"م",1,0],["من أُسرةٍ بيت معاليهمُ","يزوره الكافرُ والمسلمُ",39,"م",1,0],["مِن أُسرَةٍ شوسٍ إِذا سُئِلوا النَدى","جادوا وَإِن صَنَعوا الصَنيعَ أَجادوا",40,"د",3,0],["مَنِ اِستَوى في وَغىً وَفي قَنصٍ","بِناظِرَيهِ الطِرادُ وَالطَرَدُ",41,"د",1,0],["مَناسِبُ فَنّاخُسرُ مِنها وَصالِحٌ","بِها فَليَطُل مَن طالَ وَليَعلُ مَن عَلا",42,"ل",2,0],["مَنِ اِستَخَفَّ بِأَربابِ العُلى سَفَهاً","وَسامَها الخَسفَ أَدمى كَفَّهُ نَدَما",43,"م",2,0],["مناسب الناس تخفى في مغارسهم","سرّا ويعرض فيها الشك والريب",44,"ب",1,1],["مُناسبةٌ جرّت لكلِّ مُناسب","مُناسِبهُ إِن ساءَ ذلك أو سرّا",45,"ر",2,0],["مُناسَبةٌ قد أَلَّفت بينَ أهلها","تَجرُّ إِلى الأشكالِ أشكالَهم جرّا",46,"ر",2,0],["مُناسباً مكبّراً مصغّرا","وَلَم أَزل مقدّماً مؤخّرا",47,"ر",2,0],["من أُسرةٍ إنْ شهدوا نادياً","زانَ بهم أو وَلَدوا أَنجبوا",48,"ب",3,0],["مناسب في العلياء طاب نجارها","ومن يبتذر ذا اللحد بالسبق يبذذ",49,"ذ",1,0],["مِن أَسهُمٍ بُرِيَت لِخَيرِ مُناضِلٍ","كَفّاً وَخَيرِ كَنانَةٍ وَوِفاضِ",50,"ض",1,0],["من أسرة أسروا الوقار وسيروا","النقع المثار وأحسنوا الأعمالا",51,"ل",2,0],["من أسرة أسروا المحامد فاغتدت","وقفا عليهم في الزمان محبسا",52,"س",2,0],["من أسرة بسقت فروع أصولهم","وحلا مذاقاً طلعها المنضود",53,"د",1,0],["من استضاء بنور الحقّ مهتدياً","لم يخش ظلمة إبطالٍ وتلبيس",54,"س",1,0],["مَناسِكَ أشْجانِي وضَحَّيتُ بالصَّبرِ","فَقَلْبِيَ لَو رَامَ السلُوَّ ثَنيَتُه",55,"ه",1,0],["مِن أُسرَةٍ أَمسَوا مُلوكَ الوَرى","نُبلاً وَأَضحى لَهُمُ سَيِّدا",56,"د",2,0],["مِن اِسمِهِ اِشتَقَّ سُبحانَ المُعِزِّ لَهُ","مِنَ المَحامِدِ حَتّى حَقَّ مِدحَتُهُ",57,"ت",2,0],["مَناسِمُ رِجلَيها إِذا ما تَقاذَفَت","يَداها وَحُثَّت بِالدَوائِرِ تَلحَقُ",58,"ق",1,0],["مَنَاسِكُ دِينِ الحَقِّ وَاضِحَةٌ بِهِ","فلا نُسكُ حَقٍّ فِي سِوَاه ولا ذِبحُ",59,"ح",1,0],["مَنِ استَكْفاكَ أمرَهمُ كفيلٌ","إذا راب الزّمانُ بما كَفاكا",60,"ك",2,0],["مَنِ اسمُك وصْفُه في كلِّ حالٍ","لشَمْلِك لا أَرى الدُّنْيا افْتِراقا",61,"ق",2,0],["مَنِ استعانَ بغَيرِ اللهِ في طَلَبٍ","فإنَّ ناصِرَهُ عَجزٌ وخِذْلانُ",62,"ن",1,0],["منِ استشارَ صُروفَ الدَّهرِ قامَ لهُ","على حقيقةِ طَبعِ بُرهانُ",62,"ن",1,0],["مَنِ 