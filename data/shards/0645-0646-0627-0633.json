9%83-%D9%85%D8%B8%D9%87%D8%B1%D9%8F-%D8%A7%D9%84%D8%A3%D9%88%D8%B7%D8%A7%D9%86%D9%90/","الكامل"],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""],[2220,"من اسم العزيزِ النصر إن كنت تعقلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11647&r=&rc=521",""],[572,"ومَلْعَبٍ للخيلِ في قراحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9209&r=&rc=66",""]],"verses":[["مِن أُسرَةٍ تُنبِتُ التيجانَ هامُهُمُ","مَنابِتَ النَبعِ في الأَطوادِ وَالقُنَنِ",0,"ن",1,0],["مَن أَسقَمَ الناسَ رَمَوهُ بِالسَقَم","وَمَن رُمِي بِالموقِظاتِ لَم يَنَم",1,"م",1,0],["مِن أَسَدٍ طالَ بِهِ عُمرُهُ","وَمِن قَريبِ العُمرِ مُستاسِدِ",2,"د",1,0],["مِنّا سَلامَةُ إِذ أَتانا ثائِراً","يَعدُو بِأَبيضَ كَالغَديرِ حُسامِ",3,"م",1,0],["مَنِ اسْتَغْضَبْتَ منْ هَذي الخَليقَهْ","بمُغْضِبَةٍ بإنْكارٍ خَليقَهْ",4,"ق",2,1],["مِنْ أُسْرَةٍ سَعْدِيةٍ نَصْرِيَّةٍ","أَثْنَى عَلَيْهَا اللهُ والتَّنْزِيلُ",5,"ل",1,0],["مِن أُسرَةٍ عَرَبِيَّةٍ جاءَت بِهِ","عَرَبِيَّةٌ آباؤُها أَحرارُ",6,"ر",1,0],["مِن أُسرَةٍ حازَ شيبانُ الفخارَ بِهِم","فَهم لَهُ شَرَفٌ باقٍ إِذا اِنتَسَبوا",7,"ب",3,0],["مِن أُسدِ بَيشَةَ يَحمي الخِلَّ ذي لِبَدٍ","مِن أَهلِهِ الحاضِرِ الأُدنَينِ وَالبادي",8,"د",2,0],["مَنْ أَسْعَدَ النَّاسِ لاقَى","جَزَاءهُ فِي النَّعِيمِ",9,"م",1,0],["مَناسِمُها خُثمٌ صِلابٌ كَأَنَّها","رُؤوسُ الضِبابِ اِستَخرَجَتها الظَهائِرُ",10,"ر",1,0],["من أسرةٍ عمريةٍ عدويةٍ","شهدت بفضل مكانها أعداؤه",11,"ا",3,0],["من أسرة تقوية حظ الأولى","يوم الفخار لقهرها أن يتقوا",12,"ق",3,0],["من اسْتقامت به الأوقات واعْتدلت","للناسِ قبلَ نزول الشمس في الحمل",13,"ل",1,0],["من أساء الفِعال والقولَ ولَّى","عن أخيه ذا حُجَّةٍ مخصومه",14,"م",2,0],["مِن أُسودٍ تَسَربَلَت بِالحَديدِ","وَمِنَ الجِنِّ في رَواءِ الجُنودِ",15,"د",1,1],["من استدارة القمر","إلى لطافة الزهر",16,"ر",1,0],["من أسرةٍ أَسَرَتْ لها صِيدَ العُلى","وقَفَاتُ أَصْيَدَ في الرَّدى وَقَّافِ",17,"ف",1,0],["من أُسرةٍ قهَروا كِسرى وأسرتَه","والنَّاسُ مهتَضَمٌ منهم ومقهورُ",18,"ر",1,0],["مَنِ استَطرَفَ الشَيءَ استَلَذَّ اطِّرافَهُ","وَمَن مَلَّ شَيئاً كانَ فيهِ لَهُ مَجُّ",19,"ج",1,0],["مَن أَستَعينُ بِهِ على فرط الأسَى","فأنا الذي بجنايَتي عوديتُ",20,"ت",1,0],["مَناسِبُ كَلبَ قَد قُسِمَت فَدَعها","فَلَيسَت مِثلَ نِسبَتِكَ المُشاعَه",21,"ع",2,0],["مَناسِكُهُ فيهِ مَقبولَةٌ","وَحَجَّتُهُ بَرَّةٌ بِالتَمامِ",22,"م",1,0],["مَناسِبٌ تُحسَبُ مِن ضَوئِها","مَنازِلاً لِلقَمَرِ الطالِعِ",23,"ع",1,0],["مِن أُسرَةٍ نَشَأوا غَمائِمَ أَزمَةٍ","وَلَرُبَّما طَلَعوا بُدورَ حَنادِسِ",24,"س",1,0],["مِن أُسرَةٍ يَتَلَثَّمونَ إِلى الوَغى","يَومَ الحَفيظَةِ بِالعَجاجِ الأَقتَمِ",25,"م",1,0],["مَناسِكُ قامَ الدينُ في جَنَباتِها","يُحَيّي فَريقَ اللَهِ مِن كُلِّ قائِمِ",26,"م",1,0],["مَنِ استَنَّ تفضيلَ الجِياد لأهلِها","فأوطأهَا هامَ العِدى والسَّنوَّرا",27,"ر",2,0],["مَن أَسبغَ النُّعمى وكانتْ مَحْقَا","وفتَّق الدُّنيا وكانتْ رَتْقا",28,"ق",2,0],["من استطاع دفاعاً عن حقيقته","فإنه وحده في قومه البطل",29,"ل",1,0],["من استطاع أخذ شيء عنوة","كان له عن العلاج غنوة",30,"ه",1,0],["مِنْ أُسْرةٍ هُمْ أَهْلُ كُلِّ مُروُءَةٍ","يَوْمَ الْحِفَاظِ وَأَهْلُ كُلِّ ثَنَاءِ",31,"ا",2,0],["مِنْ أُسْرَةٍ طَهُرَتْ","خَلاَئِقُهَا وَلَمْ تُوصَمْ بِعَابْ",32,"ب",1,0],["من أساطير الشعوب الأول","ورموا بالغاز قتالاً فإن",33,"ن",1,0],["مَنْ أسكَن الذِّئْبَ الشَّرَى؟","أين الوِجَارُ من العرين؟",34,"ن",1,0],["مَنِ استَظرَفَ الشيءَ استَلَذّ بظَرْفِه،","ومَنْ مَلّ شَيئاً كانَ فيهِ لهُ مَجّ",35,"ج",1,0],["مِن أسارير الحِمى سرتَ إلى","قلبهِ كي تنجلي يوم اسودادي",36,"د",2,0],["مِن أُسرة مَلَكوا رَقَ الفَخار وَقَد","حازوا مِن الفَضل دونَ الناس أَوفَرَهُ",37,"ر",2,0],["مَناسكُ منهوجةٌ بالوجَى","يُجَبُّ على إثرهن السَّنامُ",38,"م",1,0],["من أُسرةٍ بيت معاليهمُ","يزوره الكافرُ والمسلمُ",39,"م",1,0],["مِن أُسرَةٍ شوسٍ إِذا سُئِلوا النَدى","جادوا وَإِن صَنَعوا الصَنيعَ أَجادوا",40,"د",3,0],["مَنِ اِستَوى في وَغىً وَفي قَنصٍ","بِناظِرَيهِ الطِرادُ وَالطَرَدُ",41,"د",1,0],["مَناسِبُ فَنّاخُسرُ مِنها وَصالِحٌ","بِها فَليَطُل مَن طالَ وَليَعلُ مَن عَلا",42,"ل",2,0],["مَنِ اِستَخَفَّ بِأَربابِ العُلى سَفَهاً","وَسامَها الخَسفَ أَدمى كَفَّهُ نَدَما",43,"م",2,0],["مناسب الناس تخفى في مغارسهم","سرّا ويعرض فيها الشك والريب",44,"ب",1,1],["مُناسبةٌ جرّت لكلِّ مُناسب","مُناسِبهُ إِن ساءَ ذلك أو سرّا",45,"ر",2,0],["مُناسَبةٌ قد أَلَّفت بينَ أهلها","تَجرُّ إِلى الأشكالِ أشكالَهم جرّا",46,"ر",2,0],["مُناسباً مكبّراً مصغّرا","وَلَم أَزل مقدّماً مؤخّرا",47,"ر",2,0],["من أُسرةٍ إنْ شهدوا نادياً","زانَ بهم أو وَلَدوا أَنجبوا",48,"ب",3,0],["مناسب في العلياء طاب نجارها","ومن يبتذر ذا اللحد بالسبق يبذذ",49,"ذ",1,0],["مِن أَسهُمٍ بُرِيَت لِخَيرِ مُناضِلٍ","كَفّاً وَخَيرِ كَنانَةٍ وَوِفاضِ",50,"ض",1,0],["من أسرة أسروا الوقار وسيروا","النقع المثار وأحسنوا الأعمالا",51,"ل",2,0],["من أسرة أسروا المحامد فاغتدت","وقفا عليهم في الزمان محبسا",52,"س",2,0],["من أسرة بسقت فروع أصولهم","وحلا مذاقاً طلعها المنضود",53,"د",1,0],["من استضاء بنور الحقّ مهتدياً","لم يخش ظلمة إبطالٍ وتلبيس",54,"س",1,0],["مَناسِكَ أشْجانِي وضَحَّيتُ بالصَّبرِ","فَقَلْبِيَ لَو رَامَ السلُوَّ ثَنيَتُه",55,"ه",1,0],["مِن أُسرَةٍ أَمسَوا مُلوكَ الوَرى","نُبلاً وَأَضحى لَهُمُ سَيِّدا",56,"د",2,0],["مِن اِسمِهِ اِشتَقَّ سُبحانَ المُعِزِّ لَهُ","مِنَ المَحامِدِ حَتّى حَقَّ مِدحَتُهُ",57,"ت",2,0],["مَناسِمُ رِجلَيها إِذا ما تَقاذَفَت","يَداها وَحُثَّت بِالدَوائِرِ تَلحَقُ",58,"ق",1,0],["مَنَاسِكُ دِينِ الحَقِّ وَاضِحَةٌ بِهِ","فلا نُسكُ حَقٍّ فِي سِوَاه ولا ذِبحُ",59,"ح",1,0],["مَنِ استَكْفاكَ أمرَهمُ كفيلٌ","إذا راب الزّمانُ بما كَفاكا",60,"ك",2,0],["مَنِ اسمُك وصْفُه في كلِّ حالٍ","لشَمْلِك لا أَرى الدُّنْيا افْتِراقا",61,"ق",2,0],["مَنِ استعانَ بغَيرِ اللهِ في طَلَبٍ","فإنَّ ناصِرَهُ عَجزٌ وخِذْلانُ",62,"ن",1,0],["منِ استشارَ صُروفَ الدَّهرِ قامَ لهُ","على حقيقةِ طَبعِ بُرهانُ",62,"ن",1,0],["مَنِ استَنامَ إلى الأشرار نامَ وفي","قَميصِهِ مِنهُمُ صِلُّ وثُعْبانُ",62,"ن",1,0],["من أُسْرَةٍ رغموا الأُنوف وأصبحوا","من أنف هذا المجد كالعرنين",63,"ن",1,0],["مَنَاسِبٌ كَاطِّرَادِ الْمَاءِ ما انْبَعَثَتْ","إلاَّ رَأَيْتَ بِحَارَ الأَرْضِ كَالْخُلُج",64,"ج",1,0],["من أَسمَرٍ يقضي بأَسْمَرَ عاسِلٍ","أَو أَبيضٍ يمضي بأَبْيَضَ قاضِبِ",65,"ب",1,0],["مناسِبٌ رقّ فيها 