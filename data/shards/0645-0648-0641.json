{"poems":[[55,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[88,"أبكي وعين الشرق تبكي معي","https://www.aldiwan.net/poem10376.html","السريع"],[39,"موفق لخلال الخير مطعمها","https://www.aldiwan.net/poem6868.html","البسيط"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"يا حسن الوجه والشمائل","https://www.aldiwan.net/poem65926.html","المنسرح"],[80,"لله ما خلد الأمحاض في خلدي","https://www.aldiwan.net/poem14279.html","البسيط"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[87,"جبريل هلل في السماء وكبر","https://www.aldiwan.net/poem63765.html","الكامل"],[47,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[47,"كم ليلة فيك بت أسهرها","https://www.aldiwan.net/poem63639.html","المنسرح"],[47,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[63,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[107,"أمل يزف مع السنين عروسا","https://www.aldiwan.net/poem42084.html","الكامل"],[107,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[83,"أهدت نجاتك عوذة المتخوف","https://www.aldiwan.net/poem61460.html","الطويل"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[50,"آنست نفسي بالتوحد","https://www.aldiwan.net/poem64992.html","مجزوء الكامل"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[111,"لا تترك الأنفاس في الهزل سدى","https://www.poetsgate.com/ViewPoem.aspx?id=532",""],[47,"قَلْبُ مَشُوقٍ عَناهُ البَثُّ وَالكَمَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=32937",""],[53,"يا حسنَ الوجه والشمائلِ وال","https://www.poetsgate.com/ViewPoem.aspx?id=30289",""],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[234,"وأرق العين بالحيين متله","https://www.aldiwan.net/poem51141.html","البسيط"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[369,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[415,"مالي وللجبل الأغر وإنما","https://www.aldiwan.net/poem32371.html","الكامل"],[416,"موفق لسبيل الرشد متبع","https://www.aldiwan.net/poem67529.html","البسيط"],[422,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[422,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[445,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[473,"قد نتج الجو جموحا أشهبا","https://www.aldiwan.net/poem60443.html","الرجز"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[558,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[580,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87273","المجتث"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86859","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48516","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143130","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20000","البسيط"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98198","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50000","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115852","المجتث"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26682","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49558","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48259","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2179,"","https://poetry.dctabudhabi.ae/diwan/poem/178152","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89279","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129356","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205902",""],[3815,"","https://poetry.dctabudhabi.ae/diwan/poem/143165","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35558","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54348","البسيط"],[5131,"سنضحي ما دعت أوطاننا","https://www.poetsgate.com/ViewPoem.aspx?id=42209",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""]],"verses":[["موفٍ عَلى القُلَلِ الذَوا","هِبِ في العُلى عَرضاً وَطولا",0,"ل",2,0],["مُوَفَّقاً أَنّى جَرى مُلهَماً","ما ضَلَّ في الوِردِ عَنِ المَشرَعِ",1,"ع",1,0],["موفق لخلال الخير مطعمها","عن الاساءة والفحشاء ذو حجبِ",2,"ب",1,1],["مُوَفَّقُ آراءٍ وزيرُ مُوَفَّقٍ","يُعَضِّدُهُ والرُّكْنُ بالركن يُعْضَدُ",3,"د",1,0],["موفقاً فيك للصنائع يُس","ديهنَّ ما فاض ساحلُ النيلِ",4,"ل",1,0],["مُوَفِّقُ الرأي في الراياتِ لَذَّتُهُ","في الجَدِّ وَالجودِ لا في العَيشَةِ الرَغَدِ",5,"د",1,0],["مَوفورَةٌ تَحتَ الثَرى أَزوادُهُم","رَحبٌ بِهِم بَينَ الكُهوفِ المُطبِقُ",6,"ق",1,0],["موفينَ لِلأَوطانِ بَينَ حِياضِها","لا يَسمَحونَ بِها وَبَينَ الكَوثَرِ",7,"ر",1,0],["مُوَفَّقٌ ما يَقُل فَهوَ الصَوابُ جَرى","رِسلاً وَما يَرتَئيهِ الحَزمُ وَالسَنَدُ",8,"د",1,0],["مُوَفَّقٌ لِلهُدى تَليقُ بِهِ","خِلافَةٌ رَأيُهُ يُدَبِّرُها",9,"ر",3,0],["مُوَفَّرُ القَدرِ لَم تُغمَض مَهابَتُهُ","وَنابِهُ الذِكرِ لَم تُغضَض مَساعيهِ",10,"ي",2,0],["مُوفٍ على قِمَمِ المكارمِ مُوقِدٌ","نيرانَها للطارقِ المتحيِّرِ",11,"ر",1,0],["مُوفٍ على أُمم الحياةِ يُريكَها","دُنيا تَطَلَّعُ أعيُناً ورُؤوسا",12,"س",2,0],["مُوفَّقُ الرأي موفورُ النُّهى يقِظٌ","ما زَلَّ قطُّ لِسانٌ منه أو قلمُ",13,"م",1,0],["موفٍ عَلى الأَحداثِ يَقمَعُ شَرَّها","وَيُكَشِّفُ الغَمَراتِ وَالأَهوالا",14,"ل",2,0],["موفٍ عَلى العَليا بِأَيسَرِ سَعيِهِ","نَيلَ البَليغِ مُرادَهُ في أَحرُفِ",15,"ف",1,0],["مُوفٍ يَرُدُّ على اللّيالي حُكمَها","فكأنّهُ بالحادثاتِ مُوَكَّل",16,"ل",1,0],["موفٍ عَلى شَرَفِ المَنِي","يَةِ مُضمِرٌ حَزَناً دَخيلا",17,"ل",2,0],["موفٍ عَلى حَوذانِهِ كَالنَقدِ","مِن زاهِرٍ أَحمَرَ لَم يَسوَدِّ",18,"د",1,0],["موفّق الآراء والرايات","معلّق الهمة بالغايات",19,"ت",1,0],["مُوَفَّقٌ لِصَنِيعِ الْخَيْرِ مُبْتَدِعٌ","لِمَا تُقَصِّرُ عَنْ إِدْرَاكِهِ الْفِكَرُ",20,"ر",1,0],["مُوفِياً مِنْ مِنَصَّةِ القَوْلِ يَرْنُو","بِاتَّئَادٍ وَلَحْظُهُ فِي اتِّقَادِ",21,"د",1,0],["موفَّق الرأي كم جادت أناملُهُ","بالحق عفواً وللشُكَّال تمحيض",22,"ض",1,0],["موفق الفتح ما فوجي باصبعها","مصاعب الأمر الاسهل الأزما",23,"م",2,0],["موفق النزعة كشاف العمى","مستوعب عشر العقول ابن جلا",24,"ل",2,0],["موَفَّقٌ ما يَقُلْ فَهُوَ الصّوابُ جرَى","رَسْلاً، ومَا يَرْتَئيهِ الحَزم وَالسّدَدُ",25,"د",1,0],["موفقاً فيك للصنائع يُسدْي","ن ما فاض ساحلُ النيل",26,"ل",1,0],["موفورة ً منها لك الأقسامُ","وحظُّ مَنْ يحسدك الإرغامُ",27,"م",1,0],["موفٍ على غُصْن بانٍ تستميل به","نواسُم الريح تصويبا وتصعيدا",28,"د",2,0],["موفِيّاً بِالعُهودِ مِن خَشيَةِ اللَ","هِ وَمَن يَعفُهُ يَكُن غَيرَ قالِ",29,"ل",1,0],["مُوفٍ على مُلْجَمٍ بالنَّجْمِ تَحسَبُه","للنّاظرِين وبالجَوزاء مُنْتَعِل",30,"ل",1,0],["موفٍ على أرضِ الشّآمِ كأنّما","جُونُ السحائب في ذُرَاهُ جُثُومُ",31,"م",1,0],["مُوَفَّقٌ لِسبيلِ الرُشدِ مُتَّبِعٌ","يَزينُهُ كُلُّ ما يُؤتى وَيَجتَنِبُ",32,"ب",1,1],["موفّق يسعى إليه الغِنى","من غير ما سعيٍ وخوض الغمار",33,"ر",1,0],["موفَّق للمعالي ما ابتغى طلباً","إلاَّ وأدرك بالتَّوفيق ما طلبا",34,"ب",2,0],["مُوفٍ عَلَى الرُّتَبِ القُصْوى مدىً فَمدىً","ووارِثُ المُلْكِ قحطاناً أَباً فَأَبا",35,"ب",2,0],["مُوفٍ عَلَى كَتدَيْ طاوي الحُزونِ بِهِ","والمُلكُ والدِّينُ والدنيا على كَتدِهْ",36,"د",2,0],["مُوفٍ بعَلياءِ الثُّغُورِ لِرَغْبةٍ","من راغِبٍ أَوْ رَهْبَةٍ منْ راهِبِ",37,"ب",1,0],["مُوفَّرَةٌ مِنِّي إِليكَ وسائِلاً","تفوحُ لأَنفاسِ الركائِبِ والرَّكْبِ",38,"ب",1,0],["موفَّقُ النظرةِ لا تحُوجُهُ","أوائلُ اللحظ إلى كرِّ الثِّنَى",39,"ن",2,0],["موفٍ عَلى كُلِّ الوَهادِ وَالرُبى","تَبتَسِمُ الأَرضُ إِذا ما قَطَّبا",40,"ب",2,0],["موفق الآراء لا إيراده","يصدر عن عجز ولا إصداره",41,"ر",2,0],["موفٍ عَلى مُهجٍ في يَومِ ذي رَهَجٍ","كَأَنَّهُ أَجَلٌ يَسعى إِلى أَمَلِ",42,"ل",1,0],["موفَّقُ الرأْي منصورٌ بيقْظَتِه","في الحادث اللِّينِ أَو في الكارِث الجَلَل",43,"ل",1,0],["مُوفَّقٍ وَمَصونِ","عَن الخَطا في المَقالِ",44,"ل",1,0],["مُوفَّقاً في مَساعيه الَّتي نَجحت","لِما يَبلّغه مَا شاءَ مِن وَطَره",45,"ر",2,0],["موف إذا ترك البلاد أنيسها","ملأ البلاد تذكرا ونحيبا",46,"ب",2,0],["موف مقلده كأن عنانه","في جيد عاط بالصرائم عوهج",47,"ج",1,0],["موفورها جزء من الخرم سلم","ثم بريئها عقابا قد عدم",48,"م",1,0],["مُوَفَّقُ الرَأي لا زالَت عَزائِمَهُ","تَكادُ مِنها الجِبالُ الصُمُّ تَنصَدِعُ",49,"ع",1,0],["موفّقُ السّعي والتّدبيرُ منجِحُه","وثاقبُ الرّأي في الجُلّى مسدّدُه",50,"د",2,0],["موفقلجميعالخير يفعله","لم يُثنَ عن فعل معروف بتعويقِ",51,"ق",1,0],["مُوفَّقِ الرأىِ ذى خِب","رةٍ وذى تجريب",52,"ب",1,0],["موفّرُ أعطافِ السيادةِ لم يزل","بأفئدة الأعداءِ منه وجيب",53,"ب",1,0],["موْفٍ على النفسِ مستوفٍ حُشاشتها","يُصوِّرُ الموتَ فيها كلَّ تصوير",54,"ر",1,0],["موفَّقُ رأيٍ ذو نَدىً فنديُّهُ ال","مُباركُ للأضيافِ فيه مَبَاركُ",55,"ك",1,0],["موف على الدفعات","عز اللَه اشجع من اسامه",56,"م",2,0],["موفّقٌ لسبيل الرّشد متبّعٌ","يزينه كلّ ما يأتي ويجتنب",57,"ب",1,1],["مُوفّقٌ بالإلاه مُعتضدٌ","مُظفّرٌ في الحُروب مُنتصرُ",58,"ر",1,0],["موفقين إلى الخيرات نسلهما","مبشران به في أكرم النزل",59,"ل",1,0],["موف على دجلة في صدره","إسكندر الثالث غيث العباد",60,"د",1,0],["مُوفٍ على آفاقه","وعلى الكواكب من علِ",61,"ل",1,0],["موفق الدين ماذا السهو منك على","ما نلت من رتبة في العلم والأدب",62,"ب",1,1],["مُوفٍ عِلى حُبُك المَجَرّةِ تَلتَقي","فيهِ الجَواري بِالجَواري الخُنَّسِ",63,"س",1,0],["موفَّقُ الرأْي ماضي العَزْم مُرتفعٌ","على الأَعاجم مَجْداً والأَعاريبِ",64,"ب",1,0],["موفدوكم ما رأينا منهمُ","غيرَ حالاتِ وحوشٍ حين تعدو",65,"د",2,0],["مُوفِياً بالعُهودِ من خَشْية اللا","هِ ومَنْ يَعْفُهُ يكنْ غَيْرَ قالِ",66,"ل",1,0]]}