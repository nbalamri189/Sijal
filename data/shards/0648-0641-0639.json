{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[88,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[74,"أرأيت نهج الحق كيف يبين","https://www.aldiwan.net/poem20170.html","الكامل"],[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[47,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[63,"ليس التجلد شيمة العشاق","https://www.aldiwan.net/poem51519.html","الكامل"],[54,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85396","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[79,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[119,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[122,"تخَطّت منك قافيةٌ عشاء","https://www.aldiwan.net/poem491.html",""],[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[132,"ألا فاذكرا العهد الذي كان بيننا","https://www.aldiwan.net/poem50611.html","الطويل"],[164,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[189,"أقسمت لو كاتبتكم","https://www.aldiwan.net/poem14506.html","مجزوء الكامل"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[216,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[226,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[307,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[395,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[436,"قسما بسؤددك القديم","https://www.aldiwan.net/poem12531.html","مجزوء الكامل"],[443,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[461,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[467,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[473,"وفعلك مرضي وربعك جحفل","https://www.aldiwan.net/poem4647.html","الطويل"],[554,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[554,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[556,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[561,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[561,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[561,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[565,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَفَعَلنا بِهِم كَما عَلِمَ اللَ","هُ وَما إِن لِلحائِنينَ دِماءُ",0,"ا",2,0],["وَفَعَلتُمُ فِعلَ الرِجالِ وَكُنتُمُ","يَومَ الفَخارِ كَأُمَّةِ اليابانِ",1,"ن",1,0],["وفعائلاً تمضي إرادتها إذا","ما صاحب الأفعال قد والسين",2,"ن",1,0],["وفعلكم عنوان آرائكم","وقد يُبين المخبرَ المنظر",3,"ر",1,0],["وفعل رآك الفاعلون فعلتَهُ","فأغضوا وكلٌّ ذلُّه لك عاكسه",4,"س",2,0],["وَفَعالٌ إِلى قُلوبِ المَعالي","وَقُلوبِ الآمالِ مِنهُ حَبيبُ",5,"ب",1,0],["وفَعَلْتَ في نُوْبِ الحَوادِثِ مثلَ ما","فَعَلَتْ ظُباكَ بمَعْشَرٍ مُزَّاقِ",6,"ق",1,0],["وَفَعَلتُ ما فَعَلَ الكِرامُ وَإِنَّما","أَحظى الوَرى بِالحَمدِ إِعطاءُ اللُهى",7,"ه",2,0],["وَفعلك في الأفواه يتلى وَفي الوَرى","يشيع وَفي التاريخ بعدك يذكر",8,"ر",1,0],["وفعلك حد المستطاع من التقى","على غير علم ضيعة وغرور",9,"ر",1,0],["وفعلك للصنع الجميل محالف","ورأيك للنجح المبين مؤازر",10,"ر",1,1],["وفعل جل عن قول","وقول كله ذكر",11,"ر",1,0],["وفعلا للأوامر واجتنابا","وبحثا في العلوم لمن يشاء",12,"ا",2,0],["وفعاله حيث الطَّعام فأين هو","والدّين ينسب للمُخالل أينما",13,"م",2,0],["وفعلكما الخيرَ الجميلَ مقدماً","على حالِه منِّي وإنى لشاكرُه",14,"ر",2,0],["وفعلت ذا نظرا لنفسي ليس لي","لكن لكم فيه عليّ المنّة",15,"ه",1,0],["وفعل ما ذم رب العالمين على","صنع واهون منه كل مرتكب",16,"ب",1,0],["وفعلت ما يقضي به","أسَفِي على طول البعاد",17,"د",1,0],["وفعل وصل يانجزم","يا مرو ونا نصب الهجر",18,"ر",1,0],["وفعلي لا يَخْفَى على الحيّ كلِّهِ","وقولي حَقّ صَحّحَتْهُ الدَلائِلُ",19,"ل",1,0],["وفعل حلقي عين وجدا","كفعل فعل وفعل وردا",20,"د",2,0],["وفعل المفتوح لازماً وجد","له فعول غالباً ما لم يرد",20,"د",1,0],["وفعلان مصرد للأوّل","وللذي تلا فعال ينجلي",20,"ي",1,0],["وفعلة بالفتح صغ لمرّة","من الذي مضى كجد بنظرة",20,"ه",1,0],["وفَعالٌ إذا وزنَّاه بالوع","دِ إذا قلتَ لم نجد إقواءَ",21,"ا",2,0],["وفعل ما يمنع التطهير عند الصلاه","وكالنياحه على الميت وصوت النعاه",22,"ا",2,0],["وفعلْتَ فيها مثل فِعْ","لِ البُرْءِ في جسدِ السّقيمِ",23,"م",1,0],["وفَعَمْتَ لي بَحْرَ الحياةِ مُبادِراً","بحياةِ ذابِلَةِ الكُبُودِ ظَوَامِي",24,"م",2,0],["وفعَمتَ لي بحراً وقد قَنطتْ","شفَتي من الأوشال والضَّحلِ",25,"ل",1,0],["وفعلت بالأقلام ما","فعلَ المقنَّع والمزرَّد",26,"د",1,0],["وَفِعلُك مَرضيٌّ وَرَبعُكَ جَحفَلٌ","وَلا عَيبَ في فِعلٍ وَلا في مُرَكَّبِ",27,"ب",1,1],["وفعلتُ فيه وإنّنِي شَفِقٌ به","لمّا يئستُ فِعالَ غيرِ المشفقِ",28,"ق",1,0],["وفعلتُ ضدَّ فِعالكمْ","لمّا غَدرتمْ بي وفيتُ",29,"ت",1,0],["وَفِعلُكَ مَحمودٌ وَمَجدُكَ شامِخٌ","وَجودُكَ مَوجودٌ وَبَحرُكَ خِضرِمُ",30,"م",1,0],["وفعله نحن على مراده","فنقتضي التحريك والسكونا",31,"ن",2,0],["وفعله لكل فعل يشمل","لأنه الآخر وهو الأول",32,"ل",1,0],["وفعل وانفعال وه","ي معلومات أشهاد",33,"د",1,0],["وفِعْلُ اللهِ يُبطِلُ كُلَّ فِعلٍ","ويَغلِبُ طِبَّ داودَ البصيرِ",34,"ر",1,0],["وفعله يقصر عنه وصفي","وفي الذي حكيته ما يكفي",35,"ي",1,0]]}