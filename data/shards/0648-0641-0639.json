{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[72,"أرأيت نهج الحق كيف يبين","https://www.aldiwan.net/poem20170.html","الكامل"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[45,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[61,"ليس التجلد شيمة العشاق","https://www.aldiwan.net/poem51519.html","الكامل"],[52,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85396","الطويل"],[77,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[113,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[116,"تخَطّت منك قافيةٌ عشاء","https://www.aldiwan.net/poem491.html",""],[119,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[126,"ألا فاذكرا العهد الذي كان بيننا","https://www.aldiwan.net/poem50611.html","الطويل"],[158,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[158,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[183,"أقسمت لو كاتبتكم","https://www.aldiwan.net/poem14506.html","مجزوء الكامل"],[208,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[210,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[220,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[301,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[388,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[429,"قسما بسؤددك القديم","https://www.aldiwan.net/poem12531.html","مجزوء الكامل"],[436,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[462,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[468,"وفعلك مرضي وربعك جحفل","https://www.aldiwan.net/poem4647.html","الطويل"],[549,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[549,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[551,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[556,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[556,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[556,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[560,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَفَعَلنا بِهِم كَما عَلِمَ اللَ","هُ وَما إِن لِلحائِنينَ دِماءُ",0,"ا",2,0],["وَفَعَلتُمُ فِعلَ الرِجالِ وَكُنتُمُ","يَومَ الفَخارِ كَأُمَّةِ اليابانِ",1,"ن",1,0],["وفعائلاً تمضي إرادتها إذا","ما صاحب الأفعال قد والسين",2,"ن",1,0],["وفعلكم عنوان آرائكم","وقد يُبين المخبرَ المنظر",3,"ر",1,0],["وفعل رآك الفاعلون فعلتَهُ","فأغضوا وكلٌّ ذلُّه لك عاكسه",4,"س",2,0],["وَفَعالٌ إِلى قُلوبِ المَعالي","وَقُلوبِ الآمالِ مِنهُ حَبيبُ",5,"ب",1,0],["وفَعَلْتَ في نُوْبِ الحَوادِثِ مثلَ ما","فَعَلَتْ ظُباكَ بمَعْشَرٍ مُزَّاقِ",6,"ق",1,0],["وَفَعَلتُ ما فَعَلَ الكِرامُ وَإِنَّما","أَحظى الوَرى بِالحَمدِ إِعطاءُ اللُهى",7,"ه",2,0],["وَفعلك في الأفواه يتلى وَفي الوَرى","يشيع وَفي التاريخ بعدك يذكر",8,"ر",1,0],["وفعلك للصنع الجميل محالف","ورأيك للنجح المبين مؤازر",9,"ر",1,1],["وفعل جل عن قول","وقول كله ذكر",10,"ر",1,0],["وفعلا للأوامر واجتنابا","وبحثا في العلوم لمن يشاء",11,"ا",2,0],["وفعاله حيث الطَّعام فأين هو","والدّين ينسب للمُخالل أينما",12,"م",2,0],["وفعلكما الخيرَ الجميلَ مقدماً","على حالِه منِّي وإنى لشاكرُه",13,"ر",2,0],["وفعلت ذا نظرا لنفسي ليس لي","لكن لكم فيه عليّ المنّة",14,"ه",1,0],["وفعل ما ذم رب العالمين على","صنع واهون منه كل مرتكب",15,"ب",1,0],["وفعلت ما يقضي به","أسَفِي على طول البعاد",16,"د",1,0],["وفعل وصل يانجزم","يا مرو ونا نصب الهجر",17,"ر",1,0],["وفعلي لا يَخْفَى على الحيّ كلِّهِ","وقولي حَقّ صَحّحَتْهُ الدَلائِلُ",18,"ل",1,0],["وفعل حلقي عين وجدا","كفعل فعل وفعل وردا",19,"د",2,0],["وفعل المفتوح لازماً وجد","له فعول غالباً ما لم يرد",19,"د",1,0],["وفعلان مصرد للأوّل","وللذي تلا فعال ينجلي",19,"ي",1,0],["وفعلة بالفتح صغ لمرّة","من الذي مضى كجد بنظرة",19,"ه",1,0],["وفَعالٌ إذا وزنَّاه بالوع","دِ إذا قلتَ لم نجد إقواءَ",20,"ا",2,0],["وفعل ما يمنع التطهير عند الصلاه","وكالنياحه على الميت وصوت النعاه",21,"ا",2,0],["وفعلْتَ فيها مثل فِعْ","لِ البُرْءِ في جسدِ السّقيمِ",22,"م",1,0],["وفَعَمْتَ لي بَحْرَ الحياةِ مُبادِراً","بحياةِ ذابِلَةِ الكُبُودِ ظَوَامِي",23,"م",2,0],["وفعَمتَ لي بحراً وقد قَنطتْ","شفَتي من الأوشال والضَّحلِ",24,"ل",1,0],["وفعلت بالأقلام ما","فعلَ المقنَّع والمزرَّد",25,"د",1,0],["وَفِعلُك مَرضيٌّ وَرَبعُكَ جَحفَلٌ","وَلا عَيبَ في فِعلٍ وَلا في مُرَكَّبِ",26,"ب",1,1],["وفعلتُ فيه وإنّنِي شَفِقٌ به","لمّا يئستُ فِعالَ غيرِ المشفقِ",27,"ق",1,0],["وفعلتُ ضدَّ فِعالكمْ","لمّا غَدرتمْ بي وفيتُ",28,"ت",1,0],["وَفِعلُكَ مَحمودٌ وَمَجدُكَ شامِخٌ","وَجودُكَ مَوجودٌ وَبَحرُكَ خِضرِمُ",29,"م",1,0],["وفعله نحن على مراده","فنقتضي التحريك والسكونا",30,"ن",2,0],["وفعله لكل فعل يشمل","لأنه الآخر وهو الأول",31,"ل",1,0],["وفعل وانفعال وه","ي معلومات أشهاد",32,"د",1,0],["وفِعْلُ اللهِ يُبطِلُ كُلَّ فِعلٍ","ويَغلِبُ طِبَّ داودَ البصيرِ",33,"ر",1,0],["وفعله يقصر عنه وصفي","وفي الذي حكيته ما يكفي",34,"ي",1,0]]}