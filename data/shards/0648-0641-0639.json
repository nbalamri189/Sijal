أراك بكل ناحية تحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=198677",""],[5072,"أنا بانتظاركِ","https://www.poetsgate.com/ViewPoem.aspx?id=61801",""],[5150,"اخوة في سجل العائلة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204652",""],[5200,"أبا حسن إنىّ ببابك واقف","https://www.poetsgate.com/ViewPoem.aspx?id=200807",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5431,"معنى الرجولة","https://www.poetsgate.com/ViewPoem.aspx?id=183089",""],[5431,"ولكَم يُظلم النبيل الأصيلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=196635",""],[470,"ما زلتِ نبضَ دمي","https://www.poetsgate.com/ViewPoem.aspx?id=178072",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5605,"رسالة الى عباس","https://www.poetsgate.com/ViewPoem.aspx?id=160586",""],[5740,"ألاَ اخْرَسْ فَهذاَ مِنْك أعْلا وأكبَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=211476",""],[5956,"من أركان الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192592",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""]],"verses":[["وَفَعَلنا بِهِم كَما عَلِمَ اللَ","هُ وَما إِن لِلحائِنينَ دِماءُ",0,"ا",2,0],["وَفَعَلتُمُ فِعلَ الرِجالِ وَكُنتُمُ","يَومَ الفَخارِ كَأُمَّةِ اليابانِ",1,"ن",1,0],["وفعائلاً تمضي إرادتها إذا","ما صاحب الأفعال قد والسين",2,"ن",1,0],["وفعلكم عنوان آرائكم","وقد يُبين المخبرَ المنظر",3,"ر",1,0],["وفعل رآك الفاعلون فعلتَهُ","فأغضوا وكلٌّ ذلُّه لك عاكسه",4,"س",2,0],["وَفَعالٌ إِلى قُلوبِ المَعالي","وَقُلوبِ الآمالِ مِنهُ حَبيبُ",5,"ب",1,0],["وفَعَلْتَ في نُوْبِ الحَوادِثِ مثلَ ما","فَعَلَتْ ظُباكَ بمَعْشَرٍ مُزَّاقِ",6,"ق",1,0],["وَفَعَلتُ ما فَعَلَ الكِرامُ وَإِنَّما","أَحظى الوَرى بِالحَمدِ إِعطاءُ اللُهى",7,"ه",2,0],["وَفعلك في الأفواه يتلى وَفي الوَرى","يشيع وَفي التاريخ بعدك يذكر",8,"ر",1,0],["وفعلك حد المستطاع من التقى","على غير علم ضيعة وغرور",9,"ر",1,0],["وفعلك للصنع الجميل محالف","ورأيك للنجح المبين مؤازر",10,"ر",1,1],["وفعل جل عن قول","وقول كله ذكر",11,"ر",1,0],["وفعلا للأوامر واجتنابا","وبحثا في العلوم لمن يشاء",12,"ا",2,0],["وفعاله حيث الطَّعام فأين هو","والدّين ينسب للمُخالل أينما",13,"م",2,0],["وفعلكما الخيرَ الجميلَ مقدماً","على حالِه منِّي وإنى لشاكرُه",14,"ر",2,0],["وفعلت ذا نظرا لنفسي ليس لي","لكن لكم فيه عليّ المنّة",15,"ه",1,0],["وفعل ما ذم رب العالمين على","صنع واهون منه كل مرتكب",16,"ب",1,0],["وفعلت ما يقضي به","أسَفِي على طول البعاد",17,"د",1,0],["وفعل وصل يانجزم","يا مرو ونا نصب الهجر",18,"ر",1,0],["وفعلي لا يَخْفَى على الحيّ كلِّهِ","وقولي حَقّ صَحّحَتْهُ الدَلائِلُ",19,"ل",1,0],["وفعل حلقي عين وجدا","كفعل فعل وفعل وردا",20,"د",2,0],["وفعل المفتوح لازماً وجد","له فعول غالباً ما لم يرد",20,"د",1,0],["وفعلان مصرد للأوّل","وللذي تلا فعال ينجلي",20,"ي",1,0],["وفعلة بالفتح صغ لمرّة","من الذي مضى كجد بنظرة",20,"ه",1,0],["وفَعالٌ إذا وزنَّاه بالوع","دِ إذا قلتَ لم نجد إقواءَ",21,"ا",2,0],["وفعل ما يمنع التطهير عند الصلاه","وكالنياحه على الميت وصوت النعاه",22,"ا",2,0],["وفعلْتَ فيها مثل فِعْ","لِ البُرْءِ في جسدِ السّقيمِ",23,"م",1,0],["وفَعَمْتَ لي بَحْرَ الحياةِ مُبادِراً","بحياةِ ذابِلَةِ الكُبُودِ ظَوَامِي",24,"م",2,0],["وفعَمتَ لي بحراً وقد قَنطتْ","شفَتي من الأوشال والضَّحلِ",25,"ل",1,0],["وفعلت بالأقلام ما","فعلَ المقنَّع والمزرَّد",26,"د",1,0],["وَفِعلُك مَرضيٌّ وَرَبعُكَ جَحفَلٌ","وَلا عَيبَ في فِعلٍ وَلا في مُرَكَّبِ",27,"ب",1,1],["وفعلتُ فيه وإنّنِي شَفِقٌ به","لمّا يئستُ فِعالَ غيرِ المشفقِ",28,"ق",1,0],["وفعلتُ ضدَّ فِعالكمْ","لمّا غَدرتمْ بي وفيتُ",29,"ت",1,0],["وَفِعلُكَ مَحمودٌ وَمَجدُكَ شامِخٌ","وَجودُكَ مَوجودٌ وَبَحرُكَ خِضرِمُ",30,"م",1,0],["وفعله نحن على مراده","فنقتضي التحريك والسكونا",31,"ن",2,0],["وفعله لكل فعل يشمل","لأنه الآخر وهو الأول",32,"ل",1,0],["وفعل وانفعال وه","ي معلومات أشهاد",33,"د",1,0],["وفِعْلُ اللهِ يُبطِلُ كُلَّ فِعلٍ","ويَغلِبُ طِبَّ داودَ البصيرِ",34,"ر",1,0],["وفعله يقصر عنه وصفي","وفي الذي حكيته ما يكفي",35,"ي",1,0],["وَفِعالُ الضِرغامِ أَوقَعَ في النَف","سِ مِنَ القَولِ إِنَّهُ الضِرغامِ",36,"م",1,0],["وفعل ابن أشقيلولةٍ في دعائه","أبا يوسفٍ بالحق والصدق يشهدُ",37,"د",1,0],["وفعلتُ ما فَعَل المشوقُ بليلةٍ","عادت لذاذتها عليه جُناحا",38,"ح",2,0],["وَفعل الضربُ بِوَجه النائم","ما تَفعل اللصُوص بِالعَمائم",39,"م",1,0],["وفعله الخير في سا","كني البلاد مُكثر",40,"ر",1,0],["وِفعْلُه حَسَناتٌ لا يوازنُها","شيءٌ ويقصُرُ عنها كُلُّ معْدودِ",41,"د",1,0],["وفِعالٍ قد أضاءت","بلآليها الظلاما",42,"م",2,0],["وفعل تيمور محمود عواقبه","كالسيل يبقى وإن وجه السماء صحا",43,"ح",2,0],["وفعله يسبق القو","لَ ليس يخُلف وعدا",44,"د",2,0],["وَفعمة الساقِ تُبدي مِن مَحاسِنها","من قبل من أَوبة الإصباح إِصباحا",45,"ح",2,0],["وفِعلُكَ محمودٌ وكَفُّكَ رحمَةٌ","ووجَهُكَ نورٌ ضوؤهُ غيرُ خامِدِ",46,"د",1,0],["وفعلها بعد خروج الوقت","لغير عذرٍ موجب للمقت",47,"ت",1,0],["وَفَعلوا ما شاءوا","وَذاكَ فَاِعلم داء",48,"ا",2,0],["وَفعل ما يفعل لِلصلاح","ما فيهِ مِن عَيب وَلا جَناح",49,"ح",1,0],["وفعل فعال أو فعول","والمد في ثلاث أو فعيل",50,"ل",1,0],["وفعلها كلا تقم أو ليقم","وإن تقم أقم وايضا لم يقم",50,"م",1,0],["وفعلاتن فاعلاتن خبنا","ومتفاعلن بقطع عيّنا",51,"ن",2,0],["وفعلات فاعلاتن قد شكل","كذاك مفعولات بعدما خبل",51,"ل",1,0],["وفعلاتن رفّلوا المخبونا","في متدارك به أتونا",51,"ن",2,0],["وفعلك ماض ليس فيه مضارع","وأجزم من مهما ولَمَّا وإن ومَن",52,"ن",1,0],["وَفِعْلُ الْفَتَى كَلٌّ عَلَى المَجْدِ وَالعُلاَ","إذَا كَانَ عَنْ تَقْوَى الْمُهَيْمِنِ مُبْعَدَا",53,"د",2,0],["وَفعله يكذبه عندهم","يَقول هَذا كاذِبٌ جاحد",54,"د",1,0],["وفعالاً لو اكتستها الليالي","لرتنا الحوال السود زهرا",55,"ر",2,0],["وَفَعِيل فِيهَا لَيسَ مَعنَى فَاعِلٍ","وَسِيَاقُهَا يَأبَاهُ ذُو التِّبيَانُ",56,"ن",1,0],["وفعاله للعالمين مفاخر","وعطاؤه للغارمين وقاء",57,"ا",2,0],["وفعل خير وإحسان ينيل غداًُ","قرار سجساج ظل غير منتقل",58,"ل",1,0],["وفعلك محمود العواقب مثلما","لك الرأي لم تذمم به في