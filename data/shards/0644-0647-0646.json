ُنَّ إرْخاءُ الذِّئابِ فوقَها","تحتَ القَنا كالغابِ آسادُ الشّرى",4,"ا",1,0],["له نِعَمٌ يُراحُ لهُنّ عافٍ","إِلى نِقَمٍ يُهيبُ بهِنَّ جانِ",5,"ن",1,0],["له نِعْمَةٌ تأوي إِلى ظِلّها المُنى","ويَسْحَبُ أذيالَ الثّراءِ بها الوَفْدُ",6,"د",1,0],["لهُ نِعَمٌ تَنْمي على الشُّكْرِ في الوَرى","وإنْ جَحدَوها لمْ يَحُلْ دونَها الكُفْرُ",7,"ر",1,0],["لَهُنَّ مِنَ النَعلِ الَّتي قَد حَذَوتُها","مِنَ الحَقِّ لَو دافَعتُها مِثلُ ما لَها",8,"ل",3,0],["لَهُنَّ إِذا أَصبَحنَ مُنهُم أَحِفَّةٌ","وَحينَ تَرونَ اللَيلِ أَقبَلَ جائِيا",9,"ي",2,0],["لَهُ نَبعَةٌ عَطوى كَأَنَّ رَنينَها","بِأَلوى تَعاطَتهُ الأَكُفُ المَواسِحُ",10,"ح",1,0],["له نسبة مجهولة غير أنه","مَغامزه معلومة ومعايبه",11,"ب",2,0],["لِهِندٍ بِأَعلامِ الأَغَرِّ رُسومُ","إِلى أُحُدٍ كَأَنَّهُنَّ وُشومُ",12,"م",1,1],["لهن وللمشيب ومن علاه","من الأمثال قائبة وقوبُ",13,"ب",1,1],["لَهُنَّ مَنَارُ عدنانِ بنِ أُدٍّ","بِهِنَّ إِلى ابن آجر يهتَدِينَا",14,"ن",2,0],["له نجومٌ من الآراء نعرفها","بصحة السعد لا حدساً وتخمينا",15,"ن",2,0],["له نائلٌ ما زال طالبَ طالبٍ","ومرتادَ مرتادٍ وخاطبَ خاطبِ",16,"ب",1,0],["له نارانِ نارُ قِرىً وحربٍ","ترى كلتيهما ذاتَ الْتهابِ",17,"ب",1,0],["لَه نَثا ينْشُر أرْواحَهُ","مَدْحٌ له في مَالِهِ مَتْحُ",18,"ح",1,0],["له نَفَسٌ قبلَ المذاقِ كأنما","بديهته أنفاسُ غيداءَ عاطرِ",19,"ر",1,0],["له نسوةٌ لو مُلِّك الليلُ أمره","لأوشك عنهنَّ الزوالَ وما ثنا",20,"ن",2,0],["لَهُنَّ نَشيجٌ بِالنَشيلِ كَأَنَّها","ضَرائِرُ حِرمِيٍّ تَفاحَشَ غارُها",21,"ر",3,0],["لَهُ نَظرَتانِ نَحوَهُنَّ وَنَظرَةٌ","إِلَينا فَلِلَّهِ المَشوقُ المُتَرَّحُ",22,"ح",1,0],["لَهُنَّ حَديثٌ فاتِنٌ يَترُكُ الفَتى","خَفيفَ الحَشا مُستَهلِكَ القَلبِ طامِعا",23,"ع",2,0],["لَهُنَّ فَوارِسٌ لَيسوا بِميلٍ","وَلا كُشُفٍ إِذا قُلنَ اِمنَعونا",24,"ن",2,0],["لَهُنَّ الوَجَى لِمْ كُنَّ عَوْناً على السُّرَى","ولا زالَ مِنْها ظالعٌ وحَسِيرُ",25,"ر",1,1],["لِهَنَّكِ أَولى لائِمٍ بِمَلامَةٍ","وَأَحوَجُ مِمَّن تَعذُلينَ إِلى العَذلِ",26,"ل",1,0],["له نفحةٌ إن جادَ سَجواءُ سَجْسَجٌ","وأخرى إِذا ما اغتاظ نكباءُ زعزعُ",27,"ع",1,0],["لَهُ نَبعَةٌ في العِزِّ طالَت فُروعُها","وَطابَ ثَراها وَاطمَأَنَّت أُصولُها",28,"ل",3,0],["لَهُ نَخَلاتٌ بِالفِناءِ تَشوقُنا","كَثيراً إِلى فَيءٍ كَثيرِ التَنَقُّلِ",29,"ل",1,0],["لَهُنَّ عَلَيهِم حَنَّةٌ بَعدَ أَنَّةٍ","وَوَجدٌ كَدُفّاعِ الحَريقِ المُضَرَّمِ",30,"م",1,0],["لَهُنَّ صَحنٌ رَحيبٌ في أَسافِلِها","إِذا اِنحَطَطنَ وَبَهوٌ في أَعاليها",31,"ي",3,0],["لَهُ نَسَبٌ بَينَ العَناجيجِ يَلتَقي","إِلى كُلِّ مَعروفٍ مِنَ الخَيلِ ناسِبُه",32,"ب",2,0],["لَهُنَّ تَثَنٍّ في الأَزِمَّةِ وَالبُرى","إِذا وَلَجَ اليَعفورُ حامي السَمائِمِ",33,"م",1,0],["لهُنَّ لغاتٌ مُعْجِماتٌ كأنَّها","صَريرُ نعالِ السِّبتِ عالٍ صريرُها",34,"ر",3,0],["لهن شياتٌ كَالدَّواويجِ أصبحتْ","مُوَلَّعَةً ظَلْماؤُها بضيائِها",35,"ا",3,0],["له نِعَمٌ تخضَرّ منها مَوَاقِعٌ","ولا سِيَما إن غَيّرَ الأفقَ المحلُ",36,"ل",1,0],["لهنّ أعاريضُ عند الخليل","مُهْمَلَةُ الوزنِ لا تُعْلَمُ",37,"م",1,0],["له نُورُ بشرٍ تُتّقَى سطواتُهُ","وكالنارِ في الإحراقِ ماءُ المفاصِلِ",38,"ل",1,0],["لَهُ نَظْرَتَا جُودٍ وَبَأْسٍ أَثَارَتَا","غَمَامَيْنِ سَالا بِالْفَوَاضِلِ وَالدمِ",39,"م",1,1],["لَهُنَّ إِلَى الْحَادِي الْتِفَاتَهُ وَامِقٍ","فَمِنْ رَازِحٍ مُعْيٍ وَآخَرَ رَازِمِ",40,"م",1,0],["له نهمةٌ في الأكلِ والشربِ مالها","شبيهٌ سوى التنورِ أَكْلَبَهُ السجرُ",41,"ر",1,0],["لهُ نقطةٌ سوداءُ مِنْ فوقِ رأسِهِ","وهذا لعمري حليةُ الحيَّةِ الذكَرْ",42,"ر",1,0],["لَهُنَّ فَلا يُنكِرنَهُ كُلَّما دَعا","هَوىً مِن أَماراتِ الشَقاءِ عِنانُ",43,"ن",1,0],["لِهِندٍ إِنَّ هِنداً حُب","بُها قَد كانَ مِن شُغُلي",44,"ل",2,0],["لِهِندٍ إِنَّ ذِكرَتَها","تُرى مِن شيمَتي خُلُقا",45,"ق",2,0],["لَهُنَّ وَما شاوَرنَها لَيسَ ما أَرى","بِحُسنِ جَزاءٍ لِلكَريمِ المُوَدِّعِ",46,"ع",1,0],["لَهُ نَظَرٌ فاتِنٌ فاتِرٌ","يَحُلُّ قُوى عَزمَتي ضُعفُهُ",47,"ف",2,0],["لَهُنَّ أَعناقُ غِزلانٍ وَأَعيُنُها","وَهُنَّ أَحسَنُ مِن أَبدانِها صُوَرا",48,"ر",2,0],["لَهُ نَفيانٌ يَحفِشُ الأُكمَ وَقعُهُ","تَرى التُربَ مِنهُ مائِراً يَتَثَلَّلُ",49,"ل",1,1],["لَهُنَّ وَأَعناقَ الظِباءِ اِستَعَرنَها","إِذا ما كَسَت لَباتِهِنَّ القَلائِدُ",50,"د",1,0],["لَهُ نَسَبُ الزَّهْراءِ دِنْياً يَخُصُّهُ","وسالفُ ما ضَمّتْ عليه العَواتك",51,"ك",1,0],["لَهُ نِعَمٌ في القَومِ لا يَستَثيبُها","جَزاءً وَكَيلُ التاجِرِ المُدُّ بِالمُدِّ",52,"د",1,0],["لَهُنَّ عَلَيهِم عادَةٌ قَد عَرَفنَها","إِذا عُرِّضَ الخَطِّيُّ فَوقَ الكَواثِبِ",53,"ب",1,0],["لِهِندٍ بِحِزّانِ الشَريفِ طُلولُ","تَلوحُ وَأَدنى عَهدِهِنَّ مُحيلُ",54,"ل",1,1],["لَهُ نَضَدٌ بِالَغورِ غَورِ تِهامَةٍ","يُجاوِبُ بِالرَعشاءِ جَوناً يمانِيا",55,"ي",2,0],["لهن في الغرب عزٌّ","جم وفي الشرق ذل",56,"ل",1,0],["لهُنَّ لياليكِ أو ذكرياتيَ","جِئْنَ بأجنحةٍ من ضياءْ",57,"ا",2,0],["لَهُ ناقَةٌ عِنْدِي وَساعٌ وكُورُها","كِلا مِرْفَقَيْها عَنْ رَحاها بمُجْنَبِ",58,"ب",1,0],["لَهُنَّ لُعَابٌ في الهَوَاءِ وهِزَّةٌ","إِذا جَدَّ بينَ الدّارِعين قِراعُ",59,"ع",1,0],["لِهِندٍ وَلَو أَنَّ المُقيمينَ بَعدَها","أَرادوا فِراقاً لَم أَجِد لَهُمُ فَقدا",60,"د",2,0],["لَهُ نَعَراتٌ بِالْفَلاةِ كَأَنَّها","عَلَى عُدَوَاءِ الدَّارِ جَلْجَلَةُ الرَّعْدِ",61,"د",1,0],["لَهُ نُورٌ يَكادُ يَسِيرُ فِيهِ","رَهِينُ المَحْبِسَيِنْ بِلاَ عَنَاءِ",62,"ا",2,0],["له نَغَمٌ يعِزُّ عليه مِثْلٌ","على ماضٍ يَعِزُّ عليه مثلُ",63,"ل",1,0],["لَهُ نَظْرَةٌ لم يحتَمِلْ وَقعَ سِحْرِهَا","غريبُ ابن حُجْرٍ أَو عَوِيصُ الفَرَزْدَقِ",64,"ق",1,0],["لهنَّ حديثٌ فاتنٌ يتركُ الفتى","خفيفَ الحشى مستهلكَ القلبِ طامعا",65,"ع",2,0],["لهندٍ، إنّ هنداً حب","هَا، قَدْ كَانَ مِنْ شُغُلي",66,"ل",2,0],["لَهُنَّ وَمَا شاوَرْنَها لَيْسَ ما أَرَى","بحسنِ جزاءٍ للحبيبِ المودع",67,"ع",1,0],["له ناقة عندي وساع وكورها","كلا مرفقيها عن رحاها بمجذبِ",68,"ب",1,0],["لهنَّ شِياتٌ كَالذَّراريحِ أصبحتْ","مُؤَلَّفَة ً ظَلْماؤُها بضيائِها",69,"ا",3,0],["لَهُ نعم ياوي إِلى ظِلِها المُنا","وَتَسحَب إِذيال الثَراء بِها الرَفد",70,"د",1,0],["له نسبةٌ قيسيةٌ قدسيةٌ","تُقِرُّ لها بالمعلواتِ مُواهِبُ",71,"ب",1,0],["لَهُ نَظَرٌ يَثني العِدى عَن فَريقِهِ","وَلا مُنكَرٌ لِلطَعنِ أَن يَمنَعَ الطَعنا",72,"ن",2,0],["لَهُ نِعَمٌ تفوتُ القولَ شكراً","لها من فوق أرؤسها زحام",73,"م",1,0],["له نعم على الآوي","إليه وفي العدا نقم",74,"م",1,0],["له نفسٌ تضمُّ إِلى غِناها","لمفخر كسبها النَّسِبَ الحسيبا",75,"ب",2,0],["له نسب في الملك من عهد آدم","إِلى اليوم سلك والملوم نظام",76,"م",1,0],["لهن سلاح ليس يوشى جريحه","فيرجى ولا يلزمن فيه ضمانا",77,"ن",2,0],["له نما طال من في فرعه شممم","كما ترى فاق كل العرب والعجم",78,"م",1,0],["لَهُنَّ عِندي هَوىً يُزَكي وَطيسَ جَوىً","في أَضلُعٍ جَدّ فيها الوَجدُ يُصليها",79,"ي",3,0],["لَهُنَّ رَبٌّ حَفِيٌّ لا يُضيعُ وَلا","يَخفى عَلَيهِ خَفِيٌّ حَيثُ ما كانا",80,"ن",2,0],["له نغماتٌ أَفحمْت كلَّ صادحٍ","وصوتُ نشيدٍ قد شجا كلَّ منشد",81,"د",1,0],["لَهُ نَسَبٌ واضِحٌ نورُهُ","كَما اِنشَقَّ عَن غَسَقِ اللَيلِ فَجرُ",82,"ر",1,0],["لَهِنَّكَ الْمَرْءَ أَهْدَى الدُّرَّ مُنْتَثِراً","فِي سِلْكٍ مُنْتَظِمٍ إِلَى ابْنِ زَاكُورِ",83,"ر",1,0],["لَهِنَّكَ حَاكِمُ الأُدَبَاءِ طُرًّا","شَرَائِعُهُمْ بَدَا لَكَ مُنْتَهَاهَا",84,"ا",3,0],["لَهِنَّكَ لَلرَّئِيسُ رَئِيسُ فَاسٍ","وَفَاسٌ جَنَّةُ الدُّنْيَا ذُرَاهَا",85,"ا",3,0],["لهنَّ أَعدَّتِ الزبّاءُ عرشاً","فعزَّ بهنَّ دجلةُ والفرات",86,"ت",1,0],["لهُ نغماتٌ كلُّهنَّ صبابةٌ","يحرِّكنَ قلبَ الصَّخر والصَّخرُ أصلد",87,"د",1,0],["لهنَّ قلوبٌ كالمرائي تناوَبت","وجُوهاً وأما العهدُ فالمدُّ والجزر",88,"ر",1,0],["لهنّ عيونٌ حاملاتٌ لِشَمسنا","فأحداقهنَّ السّودُ حَبُّ زبيب",89,"ب",1,0],["لَهُنَّ إِذا وافَيْنَ مَجْدَكَ قُرْبَةُ الْ","حِسانِ وَدَلُّ الآنِساتِ الْغَرائِرِ",90,"ر",1,0],["لهن من الأشواق حادٍ فإن ونتّ","حداة يرجعن الحنين أهازجا",91,"ج",2,0],["لَهُ نَفسي الفِداءُ وَكُلُّ شَيءٍ","يَعزُّ عَلَيَّ مِن أَهلٍ وَمالِ",92,"ل",1,0],["لَه نَجدةُ الناشي وَحِنكَةُ أَشيب","وَدُربةُ فذّ الغطِّ متيمةٌ وَخطا",93,"ط",2,0],["لَه نِسبةٌ تَقضي بِرَعيِ حقوقهِ","وَإن أكذبت فَحواه دعواه في النسبِ",94,"ب",1,0],["لَهُنَّ جَآذِرٌ نَعَسَت فَنامَت","عَواقِدُ في سَوالِفِها اِنثِناءُ",95,"ا",2,0],["لَهُنَّ عُيونُ العِينِ في صورِ الدُمى","وَطُرفٌ ضَعيفٌ يَستَمي العَقلَ فاتِرُ",96,"ر",1,0],["لَهُ نِيرَتا حَرٍّ سَمومٌ وَشَمسُهُ","صِلابُ الصَفا مِن حَرِّها تَتَشَقَّقُ",97,"ق",1,0],["لَهُنَّ صَليلٌ يَنتَظِرنَ قَضاءَهُ","بِضاحي عَذاةٍ أَمرَهُ وَهوَ ضامِزُ",98,"ز",1,0],["لَهُنَّ بِكُلِّ مَنزِلَةٍ رَذايا","تُرِكنَ بِها سَواهِمَ لاغِباتِ",99,"ت",1,0],["لَهُ نِصْفُ ذاكَ البَيتِ إذْ كانَ كلُّهُ","حَلِيفَ الضَّنَى مافيهِ قُوتٌ لِناسقِ",100,"ق",1,0],["لَهُنَّ بِشُبّاكِ الحَديدِ تَقاذُفٌ","هُوِيَّ رَواحٍ بِالدُجُنَّةِ يُعجِبُ",101,"ب",1,0],["لهُنَّ من البِيضِ مَصْقولةٌ","تُسَلُّ وتُغْمَدُ منْ كُلِّ فَم",102,"م",1,0],["لَهُنَّ الدّهرَ ما ركُزتْ سُكونٌ","فإن نُشِرَتْ تَشابهَتِ اختفاقا",103,"ق",2,0],["لُه نَظَرٌ لَم يُبقِ منِّي سِوى الهَوى","ولَو كانَ منِّي لَم يَزَل فيهِ مَقسمي",104,"م",2,0],["له نحوكُم سَعيٌ بحالي وما سَعى","ومَفهومُ قَولٍ ما وَعَته المسامِعُ",105,"ع",1,0],["له نَظراتٌ في الأمور تسابقَت","بكلِّ شهابٍ من عَزائِمه ثاقِب",106,"ب",1,0],["لَهُنَّ مِن الحَيا نَحوي ابتِدارُ","كَما ابتَدَرت مِنَ الزَندِ الشَرارُ",107,"ر",1,0],["له نائِلٌ يَسرِي إلى كلِّ آملٍ","إذا جيرةٌ سيموا النَّوالَ فلم يُنطُوا",108,"ط",3,0],["لِهندٍ منكَ عَينٌ ذاتُ سَجلٍ","وقَلبٌ سَوفَ يُفقَدُ أَو يَفُوتُ",109,"ت",1,0],["لهنّ في كبدي طعنات ذي حور","وكم فتنت بهم أيام قربهم",110,"م",1,0],["لهنّ ربوعٌ بالعقيقِ دواثرُ","خلتْ وقلوبُ العاشقين عوامرُ",111,"ر",1,1],["لَهُ نَكهَةٌ بَخرَاءُ بَعد انتِشَاقِهَا","تَصَدَّعَ مُجتَازُ الذُّبَابِ عَلَى بُعدِ",112,"د",1,0],["له نظر للمكرمات وغيرهُ","نواظرهُ نحو الرذائلِ ترمُق",113,"ق",1,0],["له نسب في اغتراس الرجا","ل وهو بلاءٌ على الغارسِ",114,"س",1,0],["لهنّ جديدٌ من نوالك كلَّما","أتى طالعاً يومٌ بهنّ جديدُ",115,"د",1,0],["لهنَّ من الرياح الهوجِ حادٍ","ومن خُلُجِ المياه العوجِ هادي",116,"د",2,0],["لهن على خدِّ الفلاة من السُّرى","لدامٌ كأيدي الفاقدات الثَّواكل",117,"ل",1,0],["لهن إلى وطءِ القتيل تقدمٌ","ومنهن عن أخذ الأسير نِفارُ",118,"ر",1,0],["له نسيبي ولمدحي كلهِ","مظفَّرُ الدين الجواد المنُعم",119,"م",1,0],["لَهَنَّكَ مِن بَيتٍ إِلَيَّ لَمونِقٌ","وَآنِقُ مِن عَيني مِنَ البَيتِ عامِرُه",120,"ر",2,0],["لَهُ نائِلٌ لَم يَزَل بابُهُ","لِطارِقِ آمالِنا يَفتَحُ",121,"ح",1,0],["له نظراتٌ كدَّرَ الحقدُ شزرَها","تَدُلُّ على ما عندَهُ مِن سخائمِ",122,"م",1,0],["له ناظراٌ بعدَ الحبائبِ جفنُهُ","همولٌ وقلبٌ للفراقِ جريحُ",123,"ح",1,0],["له نسبٌ في المكرماتِ مؤثَّلٌ","يذودُ الدنايا عن عرانِينها الشُّمَّ",124,"م",1,0],["له نسبٌ إلى العَرَبِ البوادي","يُصدِّقُه اختبارٌ واختيارُ",125,"ر",1,0],["له نشواتٌ في العقولِ كأنَّما","أُديرتْ على الأذهانِ منه حُميّاهُ",126,"ا",2,0],["له نواجذ حمر","فيها ظرائف غضه",127,"ض",2,0],["له نكتَةٌ يَحْتاطُ بالعبْدِ سِرُّها","إذا غابَ في تلكَ المَعارِجِ أو حَضَرْ",128,"ر",1,0],["له نِقَمٌ محذورةٌ عند سُخطِه","ولا غَرْوَ أن عادتْ من العفوِ أنعُما",129,"م",2,0],["لهنّ وأيديهنّ تستلب المدا","طلىً مائلاتٌ بينهنّ وهامُ",130,"م",1,0],["لهنّ ببَوْغاءِ الطّفوف أعزّةٌ","سُقوا الموتَ صِرْفاً صبيةً وكهولا",131,"ل",2,0],["له نسيمٌ أرِجٌ","يُمسك منّا الرَّمَقا",132,"ق",2,0],["لهنّ على وادي مِنيً كلَّ حجّةٍ","بروكٌ وقد قضّين كلَّ المواقفِ",133,"ف",1,0],["لَهَنُّكَ أوْلانا بكلّ فضيلةٍ","وأعشقُ للمعروف فينا وأشعفُ",134,"ف",1,0],["لهنّ صباحٌ من وجوهٍ منيرةٍ","تخلّلها ليلٌ من الفاحِمِ الجَعْدِ",135,"د",1,0],["لهنَّ بقلبِي عَبْقَةٌ أرَجِيَّةٌ","تبرّحُ بالنّفْحاتِ من عنبرِ الهِندِ",135,"د",1,0],["لَهُنّ والرّحلُ يَعْلَولِي مناسِجَها","إلى السَّباسِبِ شوقاً كلَّ حنّاتِ",136,"ت",1,0],["لَهُنَّ في شَباتِهِ صِئِيُّ","إِذا اِكتَلى وَاَقتُحِمَ المَكلِيُّ",137,"ي",1,0],["له نَغَمٌ يُفْضِيْنَ من كلِّ سامِعٍ","إلى حيثُ لا يُفْضي إلى مثله الخمْرُ",138,"ر",1,0],["له نَائِلٌ يَسْعى إِلى كُلِّ سَائِلٍ","فيطلبُه بالماءِ والزَّادِ أَيْنَما",139,"م",2,0],["له ناظرٌ يُسقِمُ الناظِرين","ويَكسِفُ منه الوجوهَ الوِضَا",140,"ض",2,0]]}