,""],[5397,"أغاظ الدهر قدرك أن يسودا","https://www.poetsgate.com/ViewPoem.aspx?id=157926",""],[5431,"أخي الأزلي شاعر اليمن عبد الإله الشميري","https://www.poetsgate.com/ViewPoem.aspx?id=191123",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[327,"ألا هاج قلبي العام ظعنٌ بواكر","https://www.poetsgate.com/ViewPoem.aspx?id=3814",""],[5525,"بسمة الضي","https://www.poetsgate.com/ViewPoem.aspx?id=858",""],[5609,"مملكة السحاب","https://www.poetsgate.com/ViewPoem.aspx?id=215574",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5725,"تداعى علينا القوم","https://www.poetsgate.com/ViewPoem.aspx?id=177466",""],[5848,"30","https://www.poetsgate.com/ViewPoem.aspx?id=53372",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5956,"أرثيه يوميا وهو حيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=206257",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[6031,"عَذِيريَ من هَذَا العَذُولِ المُفَنَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46273",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6142,"أسفح اللوى لا صافحتك الحوادث","https://www.poetsgate.com/ViewPoem.aspx?id=155731",""],[6148,"شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=201600",""],[6259,"سقى دمعي الأحبَّة َ حيث ساروا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59414&r=&rc=62",""]],"verses":[["لَهُنَّ اللَهُ كَيفَ أَصَبنَ مِنّا","نُفوساً ما عُقِلنَ وَما وُدينا",0,"ن",2,0],["لَهُ نَضحٌ بِرَوقَيهِ","وَلي نَطحٌ بِرَوقَينِ",1,"ن",1,0],["لَهُ نَعَراتٌ بَينَ قَوٍّ وَرامَةٍ","وَلا نَعَراتُ الشَيخِ أَوسِ بنِ مَعيَرا",2,"ر",2,0],["لَهُنَّ عَلى طَردِ الضُيوفِ تَعاقُدٌ","هِراشُ كِلابٍ بَينَهُنَّ عِقادُ",3,"د",1,0],["لهُنَّ إرْخاءُ الذِّئابِ فوقَها","تحتَ القَنا كالغابِ آسادُ الشّرى",4,"ا",1,0],["له نِعَمٌ يُراحُ لهُنّ عافٍ","إِلى نِقَمٍ يُهيبُ بهِنَّ جانِ",5,"ن",1,0],["له نِعْمَةٌ تأوي إِلى ظِلّها المُنى","ويَسْحَبُ أذيالَ الثّراءِ بها الوَفْدُ",6,"د",1,0],["لهُ نِعَمٌ تَنْمي على الشُّكْرِ في الوَرى","وإنْ جَحدَوها لمْ يَحُلْ دونَها الكُفْرُ",7,"ر",1,0],["لَهُنَّ مِنَ النَعلِ الَّتي قَد حَذَوتُها","مِنَ الحَقِّ لَو دافَعتُها مِثلُ ما لَها",8,"ل",3,0],["لَهُنَّ إِذا أَصبَحنَ مُنهُم أَحِفَّةٌ","وَحينَ تَرونَ اللَيلِ أَقبَلَ جائِيا",9,"ي",2,0],["لَهُ نَبعَةٌ عَطوى كَأَنَّ رَنينَها","بِأَلوى تَعاطَتهُ الأَكُفُ المَواسِحُ",10,"ح",1,0],["له نسبة مجهولة غير أنه","مَغامزه معلومة ومعايبه",11,"ب",2,0],["لِهِندٍ بِأَعلامِ الأَغَرِّ رُسومُ","إِلى أُحُدٍ كَأَنَّهُنَّ وُشومُ",12,"م",1,1],["لهن وللمشيب ومن علاه","من الأمثال قائبة وقوبُ",13,"ب",1,1],["لَهُنَّ مَنَارُ عدنانِ بنِ أُدٍّ","بِهِنَّ إِلى ابن آجر يهتَدِينَا",14,"ن",2,0],["له نجومٌ من الآراء نعرفها","بصحة السعد لا حدساً وتخمينا",15,"ن",2,0],["له نائلٌ ما زال طالبَ طالبٍ","ومرتادَ مرتادٍ وخاطبَ خاطبِ",16,"ب",1,0],["له نارانِ نارُ قِرىً وحربٍ","ترى كلتيهما ذاتَ الْتهابِ",17,"ب",1,0],["لَه نَثا ينْشُر أرْواحَهُ","مَدْحٌ له في مَالِهِ مَتْحُ",18,"ح",1,0],["له نَفَسٌ قبلَ المذاقِ كأنما","بديهته أنفاسُ غيداءَ عاطرِ",19,"ر",1,0],["له نسوةٌ لو مُلِّك الليلُ أمره","لأوشك عنهنَّ الزوالَ وما ثنا",20,"ن",2,0],["لَهُنَّ نَشيجٌ بِالنَشيلِ كَأَنَّها","ضَرائِرُ حِرمِيٍّ تَفاحَشَ غارُها",21,"ر",3,0],["لَهُ نَظرَتانِ نَحوَهُنَّ وَنَظرَةٌ","إِلَينا فَلِلَّهِ المَشوقُ المُتَرَّحُ",22,"ح",1,0],["لَهُنَّ حَديثٌ فاتِنٌ يَترُكُ الفَتى","خَفيفَ الحَشا مُستَهلِكَ القَلبِ طامِعا",23,"ع",2,0],["لَهُنَّ فَوارِسٌ لَيسوا بِميلٍ","وَلا كُشُفٍ إِذا قُلنَ اِمنَعونا",24,"ن",2,0],["لَهُنَّ الوَجَى لِمْ كُنَّ عَوْناً على السُّرَى","ولا زالَ مِنْها ظالعٌ وحَسِيرُ",25,"ر",1,1],["لِهَنَّكِ أَولى لائِمٍ بِمَلامَةٍ","وَأَحوَجُ مِمَّن تَعذُلينَ إِلى العَذلِ",26,"ل",1,0],["له نفحةٌ إن جادَ سَجواءُ سَجْسَجٌ","وأخرى إِذا ما اغتاظ نكباءُ زعزعُ",27,"ع",1,0],["لَهُ نَبعَةٌ في العِزِّ طالَت فُروعُها","وَطابَ ثَراها وَاطمَأَنَّت أُصولُها",28,"ل",3,0],["لَهُ نَخَلاتٌ بِالفِناءِ تَشوقُنا","كَثيراً إِلى فَيءٍ كَثيرِ التَنَقُّلِ",29,"ل",1,0],["لَهُنَّ عَلَيهِم حَنَّةٌ بَعدَ أَنَّةٍ","وَوَجدٌ كَدُفّاعِ الحَريقِ المُضَرَّمِ",30,"م",1,0],["لَهُنَّ صَحنٌ رَحيبٌ في أَسافِلِها","إِذا اِنحَطَطنَ وَبَهوٌ في أَعاليها",31,"ي",3,0],["لَهُ نَسَبٌ بَينَ العَناجيجِ يَلتَقي","إِلى كُلِّ مَعروفٍ مِنَ الخَيلِ ناسِبُه",32,"ب",2,0],["لَهُنَّ تَثَنٍّ في الأَزِمَّةِ وَالبُرى","إِذا وَلَجَ اليَعفورُ حامي السَمائِمِ",33,"م",1,0],["لهُنَّ لغاتٌ مُعْجِماتٌ كأنَّها","صَريرُ نعالِ السِّبتِ عالٍ صريرُها",34,"ر",3,0],["لهن شياتٌ كَالدَّواويجِ أصبحتْ","مُوَلَّعَةً ظَلْماؤُها بضيائِها",35,"ا",3,0],["له نِعَمٌ تخضَرّ منها مَوَاقِعٌ","ولا سِيَما إن غَيّرَ الأفقَ المحلُ",36,"ل",1,0],["لهنّ أعاريضُ عند الخليل","مُهْمَلَةُ الوزنِ لا تُعْلَمُ",37,"م",1,0],["له نُورُ بشرٍ تُتّقَى سطواتُهُ","وكالنارِ في الإحراقِ ماءُ المفاصِلِ",38,"ل",1,0],["لَهُ نَظْرَتَا جُودٍ وَبَأْسٍ أَثَارَتَا","غَمَامَيْنِ سَالا بِالْفَوَاضِلِ وَالدمِ",39,"م",1,1],["لَهُنَّ إِلَى الْحَادِي الْتِفَاتَهُ وَامِقٍ","فَمِنْ رَازِحٍ مُعْيٍ وَآخَرَ رَازِمِ",40,"م",1,0],["له نهمةٌ في الأكلِ والشربِ مالها","شبيهٌ سوى التنورِ أَكْلَبَهُ السجرُ",41,"ر",1,0],["لهُ نقطةٌ سوداءُ مِنْ فوقِ رأسِهِ","وهذا لعمري حليةُ الحيَّةِ الذكَرْ",42,"ر",1,0],["لَهُنَّ فَلا يُنكِرنَهُ كُلَّما دَعا","هَوىً مِن أَماراتِ الشَقاءِ عِنانُ",43,"ن",1,0],["لِهِندٍ إِنَّ هِنداً حُب","بُها قَد كانَ مِن شُغُلي",44,"ل",2,0],["لِهِندٍ إِنَّ ذِكرَتَها","تُرى مِن شيمَتي خُلُقا",45,"ق",2,0],["لَهُنَّ وَما شاوَرنَها لَيسَ ما أَرى","بِحُسنِ جَزاءٍ لِلكَريمِ المُوَدِّعِ",46,"ع",1,0],["لَهُ نَظَرٌ فاتِنٌ فاتِرٌ","يَحُلُّ قُوى عَزمَتي ضُعفُهُ",47,"ف",2,0],["لَهُنَّ أَعناقُ غِزلانٍ وَأَعيُنُها","وَهُنَّ أَحسَنُ مِن أَبدانِها صُوَرا",48,"ر",2,0],["لَهُ نَفيانٌ يَحفِشُ الأُكمَ وَقعُهُ","تَرى التُربَ مِنهُ مائِراً يَتَثَلَّلُ",49,"ل",1,1],["لَهُنَّ وَأَعناقَ الظِباءِ اِستَعَرنَها","إِذا ما كَسَت لَباتِهِنَّ القَلائِدُ",50,"د",1,0],["لَهُ نَسَبُ الزَّهْراءِ دِنْياً يَخُصُّهُ","وسالفُ ما ضَمّتْ عليه العَواتك",51,"ك",1,0],["لَهُ نِعَمٌ في القَومِ لا يَستَثيبُها","جَزاءً وَكَيلُ التاجِرِ المُدُّ بِالمُدِّ",52,"د",1,0],["لَهُنَّ عَلَيهِم عادَةٌ قَد عَرَفنَها","إِذا عُرِّضَ الخَطِّيُّ فَوقَ الكَواثِبِ",53,"ب",1,0],["لِهِندٍ بِحِزّانِ الشَريفِ طُلولُ","تَلوحُ وَأَدنى عَهدِهِنَّ مُحيلُ",54,"ل",1,1],["لَهُ نَضَدٌ بِالَغورِ غَورِ تِهامَةٍ","يُجاوِبُ بِالرَعشاءِ جَوناً يمانِيا",55,"ي",2,0],["لهن في الغرب عزٌّ","جم وفي الشرق ذل",56,"ل",1,0],["لَهُنَّ بِشُبَّاكِ الحَدِيدِ زَوَافِرٌ","دَوَابِرُهَا بِالجَنْدَلِ الصُّمِّ تُقْذَفُ",57,"ف",1,0],["لهُنَّ لياليكِ أو ذكرياتيَ","جِئْنَ بأجنحةٍ من ضياءْ",58,"ا",2,0],["لَهُ ناقَةٌ عِنْدِي وَساعٌ وكُورُها","كِلا مِرْفَقَيْها عَنْ رَحاها بمُجْنَبِ",59,"ب",1,0],["لَهُنَّ لُعَابٌ في الهَوَاءِ وهِزَّةٌ","إِذا جَدَّ بينَ الدّارِعين قِراعُ",60,"ع",1,0],["لِهِندٍ وَلَو أَنَّ المُقيمينَ بَعدَها","أَرادوا فِراقاً لَم أَجِد لَهُمُ فَقدا",61,"د",2,0],["لَهُ نَعَراتٌ بِالْفَلاةِ كَأَنَّها","عَلَى عُدَوَاءِ الدَّارِ جَلْجَلَةُ الرَّعْدِ",62,"د",1,0],["لَهُ نُورٌ يَكادُ يَسِيرُ فِيهِ","رَهِينُ المَحْبِسَيِنْ بِلاَ عَنَاءِ",63,"ا",2,0],["له نَغَمٌ يعِزُّ عليه مِثْلٌ","على ماضٍ يَعِزُّ عليه مثلُ",64,"ل",1,0],["لَهُ نَظْرَةٌ لم يحتَمِلْ وَقعَ سِحْرِهَا","غريبُ ابن حُجْرٍ أَو عَوِيصُ الفَرَزْدَقِ",65,"ق",1,0],["لهنَّ حديثٌ فاتنٌ يتركُ الفتى","خفيفَ الحشى مستهلكَ القلبِ طامعا",66,"ع",2,0],["لهندٍ، إنّ هنداً حب","هَا، قَدْ كَانَ مِنْ شُغُلي",67,"ل",2,0],["لَهُنَّ وَمَا شاوَرْنَها لَيْسَ ما أَرَى","بحسنِ جزاءٍ للحبيبِ المودع",68,"ع",1,0],["له ناقة عندي وساع وكورها","كلا مرفقيها عن رحاها بمجذبِ",69,"ب",1,0],["لهنَّ شِياتٌ كَالذَّراريحِ أصبحتْ","مُؤَلَّفَة ً ظَلْماؤُها بضيائِها",70,"ا",3,0],["لَهُ نعم ياوي إِلى ظِلِها المُنا","وَتَسحَب إِذيال الثَراء بِها الرَفد",71,"د",1,0],["له نسبةٌ قيسيةٌ قدسيةٌ","تُقِرُّ لها بالمعلواتِ مُواهِبُ",72,"ب",1,0],["لَهُ نَظَرٌ يَثني العِدى عَن فَريقِهِ","وَلا مُنكَرٌ لِلطَعنِ أَن يَمنَعَ الطَعنا",73,"ن",2,0],["لَهُ نِعَمٌ تفوتُ القولَ شكراً","لها من فوق أرؤسها زحام",74,"م",1,0],["له نعم على الآوي","إليه وفي العدا نقم",75,"م",1,0],["له نفسٌ تضمُّ إِلى غِناها","لمفخر كسبها النَّسِبَ الحسيبا",76,"ب",2,0],["له نسب في الملك من عهد آدم","إِلى اليوم سلك والملوم نظام",77,"م",1,0],["لهن سلا