وق على","غَوالٍ شينا بالعطر",149,"ر",1,0],["لهُ نسبٌ يتيه على","هِرَقْلَ عْلاً وسابورِ",150,"ر",1,0],["له نسب مثل صوب الغمام","تحدّر من أجْبُل شاهقهْ",151,"ق",2,0],["لَهُ نَفسُ حُرٍّ لا تَزالُ مُغِذَّةً","لِمجدٍ فَإِن تَسبِق إِلَيهِ اطمَأَنَّتِ",152,"ت",1,0],["له نكتَةٌ تقضى بأن ميّمَما","نحاه على شط المساوف يظفر",153,"ر",1,0],["لَهُنَّ عَلَيْهِ عَادَةٌ قَدْ عَرَفْنَهَا","إذَا أصْبَحَ الخَطِّيُّ بِالدَّمِ يَكْتُبُ",154,"ب",1,0],["لهنَّ على الرّيان فى كلِّ صَيفةٍ","فما ضمّ مِيثُ الأَزورين فجُلجُلِ",155,"ل",1,0],["له نثاران يبتغي بهما","في عدله موضعاً لتعريسه",156,"س",2,0],["له نفيس المذهب","فاحفظ له ودرس",157,"س",1,0],["له نِعمٌ عِندي ضَعُفتُ بشكرها","عَلى أَنَّه في كُلِّ يَوم يَزيدها",158,"د",3,0],["له نور وجه يخجل الشمس في الضحى","له حسن وصف قد سمى عن مقاله",159,"ه",1,0],["له نفس تولت عن هداها","أصابتها بأسها الرماة",160,"ه",1,0],["له ناظر عامل في القلوب","يعرف موقعه المستهام",161,"م",1,0],["له نَظرُ الشَّفيقِ بمقلتَيهِ","وليسَ وراءَهُ نظرُ الشَّفيقِ",162,"ق",1,0],["لَهُ نَظَرٌ ما يَغمِضُ الأَمرَ دونَهُ","تَكادُ سُتورُ الغَيبِ عَنهُ تُمزِقُ",163,"ق",1,1],["له نفائسُ علمٍ كلُّها دررٌ","والبحرُ يبرز منه أنفس الدررِ",164,"ر",1,0],["له نوازع شوق بات يضرمها","بين الجوانح والأحشاء ذكراك",165,"ك",1,0],["له نظر سام ورأى مسدد","ترى منه للاسلام أشجع حامى",166,"م",2,0],["لهن علينا في الخدور كرامةٌ","يَعزُّ بها ذاك الجمالُ المخدَّر",167,"ر",1,0],["له نبأ في الفجر دون احتماله","تساوي الجبان النكس والبطل النجد",168,"د",1,0],["لَهُنَّ لَجاجاتٌ شِدادٌ كَأَنَّها","لَجاجَةُ ربِّ البَيتِ في آخر الشَهر",169,"ر",1,0],["لَهُنَّ بِما بَينَ الأَصاغي وَمَنصَحٍ","تَعاوٍ كَما عَجَّ الحَجيجُ المُلَبِّدُ",170,"د",1,0],["لهُ نظرةُ الزّرقاء في كُلِّ بِدعَةٍ","ولكنَّهُ عن مَسلكِ الحَقِّ أَرمَدُ",171,"د",1,0],["لَهُ نَصلُ سَيفٍ يَقطَعُ الهامَ حَدُّهُ","وَأَقطَعُ مِنهُ حامِلُ النَصلِ لا النَصلُ",172,"ل",1,0],["له نصبت رفعاً وخفضاً بمُهجتي","سواكن وَجد منه فيّ عوامل",173,"ل",1,0],["له نقى قديما","من الأكوان جلّا",174,"ل",2,0],["له نفس قد صاغها اللَه تقوى","وعلوماً قد ألهمت إلهاما",175,"م",2,0],["له 