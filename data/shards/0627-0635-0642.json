{"poems":[[53,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[164,"يا غنيا بفخر ملك الأنام","https://www.aldiwan.net/poem59060.html","الخفيف"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102132","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202916","الخفيف"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138771",""],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[6003,"شجن عربي","https://www.poetsgate.com/ViewPoem.aspx?id=201196",""]],"verses":[["أصِقالَ كل مروءةٍ مجفوةٍ","ما للمروءةِ مذ أَفَلْتَ صِقالُ",0,"ل",1,0],["أصقع الناس شاعر منَّ بالش","عر عليكم ورام كل مرام",1,"م",1,0],["أصقلُ الانف انفه","جرَّح القلبَ منَّنا",2,"ن",2,0],["اصقل الروح إن في الروح كنزاً","مفعماً من بدائع الأسرار",3,"ر",1,1],["أصقالكم أكدت سواعد غربها","أو عربكم ضئلت وهن ضوابح",4,"ح",1,0],["أَصقَعُ النَاسَ بِرَجمٍ صائِبٍ","لَيسَ بالطَيشِ وَلا بِالمُرتَجَع",5,"ع",1,0],["أصقر تهامة والأبطحين","وما ضم فهراً وعدنانها",6,"ن",3,1],["أصقع الرأس كالعمود الطوال","فيها كالجنون أو طائف الأو",7,"ل",3,0],["أَصقاعُ حُلمي ولو قاومتُ عاطفتي","مصر وقدس وصنعاء وبغداد",8,"د",1,0]]}