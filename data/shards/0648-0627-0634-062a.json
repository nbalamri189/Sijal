gate.com/ViewPoem.aspx?id=128720",""],[5353,"فرعون","https://www.poetsgate.com/ViewPoem.aspx?id=212458",""],[5386,"الجهات الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=35001",""],[5431,"لغة الحب أن تذوب عطاءً","https://www.poetsgate.com/ViewPoem.aspx?id=198222",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5460,"إن كفّي إذا التقينا تراها","https://www.poetsgate.com/ViewPoem.aspx?id=200754",""],[5461,"استكثرك وقتي","https://www.poetsgate.com/ViewPoem.aspx?id=495",""],[5550,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=212912",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5690,"سعداًَ لبلاد أنعشها","https://www.poetsgate.com/ViewPoem.aspx?id=172230",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5691,"أسرجوا خيلكم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206157",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[5725,"وتمنعي","https://www.poetsgate.com/ViewPoem.aspx?id=195411",""],[5736,"للغيمات تشتاق التخوم","https://www.poetsgate.com/ViewPoem.aspx?id=203855",""],[5833,"قل للربيع","https://www.poetsgate.com/ViewPoem.aspx?id=197438",""],[5949,"أحن إلى روض التصابي وأرتاح","https://www.poetsgate.com/ViewPoem.aspx?id=181657",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6115,"سج هاجوس الشعر للشاعر المسكيني","https://www.poetsgate.com/ViewPoem.aspx?id=180475",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6124,"واشتاقت","https://www.poetsgate.com/ViewPoem.aspx?id=159906",""],[6124,"أفراح الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=174967",""],[6124,"جرة البنت","https://www.poetsgate.com/ViewPoem.aspx?id=193654",""],[6124,"لا تخافي","https://www.poetsgate.com/ViewPoem.aspx?id=194306",""],[6124,"يوم الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=194529",""],[6124,"خاتم الأشعار","https://www.poetsgate.com/ViewPoem.aspx?id=201323",""],[6152,"أنتِ عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=203118",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[4222,"هل لعاني الهوى من الأسر فاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52757&r=&rc=49",""]],"verses":[["وَأَشتَمِلُ الدُجى وَالرَكبُ يَمضي","مَضاءَ السَيفِ شَذَّ عَنِ القِرابِ",0,"ب",1,0],["واِشتِعالُ الهَمِّ في قَلبي عَلا","بِقِناعِ الشَيبِ رأسي فاِشتَعَلْ",1,"ل",1,0],["واشْتَعَلَ الرّأسُ فزالَتْ مَيْعَتي","شَيْباً وفي الشّيْبِ الوَقارُ والنُّهى",2,"ا",1,0],["واشتاقَ كاظِمَةً فجُنَّ جُنونُهُ","وذَكَرْتُ ساكِنَها فجُنَّ جُنوني",3,"ن",2,0],["وأشْتاقُ أيّامَ العَقيقِ وأنْثَني","بأربَعَةٍ مِنْ ذِكْرِهِنّ سِجامِ",4,"م",1,0],["وأشتمّ صيفا خجول القطاف","تلعتم في وجنتيك وفاح",5,"ح",1,0],["وَأَشتاقُ كاساتِ المَنونِ إِذا صَفَت","وَدارَت عَلى رَأسي سِهامُ المَصائِبِ",6,"ب",1,0],["وَأَشتاقُ فَلا يَعل","مُ إِلا اللَهُ ما أَلقى",7,"ا",1,0],["واشْتَرِ الَمْدَ بالمَواهِبِ واعْقِدْ","عَقْدَها في مَظِنّةِ الأرْباحِ",8,"ح",1,0],["وَاِشتِياقٌ وَاِحتِراقٌ وَاتقا","رُقباءٍ وَسَقامٌ موبِقُ",9,"ق",1,0],["وأًشِتَّت بِنَا مَصَادِرُ شَتَّى","بَعدَ نَهجِ السَّبِيلِ ذِي الآرَامِ",10,"م",1,0],["وأشتكي النأيَ في باب العلاءِ إلى","نعم المليّ بأنجائي وإنجاحي",11,"ح",2,0],["وَاِشتَرَكَ الشَكلانِ في حالَةٍ","فَاِمتَحَقا في العالَمِ الماحِقِ",12,"ق",1,0],["واشتد علباءاه وانقوَسا","دون العذار فضاق برقعه",13,"ع",2,0],["وَاِشتَدَّ نَوحي وَصارَ جَهراً","وَكانَ مِن قَبلُ في الخَفاء",14,"ا",2,0],["وَاِشتَرَكنا في جِهادٍ أَو عَذابِ","وَاِلتَقَينا في حَديثٍ أَو كِتابِ",15,"ب",1,0],["وَاِشتَهَرَت في النَملِ بِالتَقَشُّفِ","وَاِتَّصَفَت بِالزُهدِ وَالتَصَوُّفِ",16,"ف",1,0],["وَاِشتاقَ يَوماً مِنَ الأَيّامِ رُؤيَتَها","فَأَقبَلَت وَهيَ أَعصى الطَيرِ أَفواها",17,"ا",3,0],["وَاِشتَرَكنا فَمِصرُ عَبرى وَلُبنا","نُ سَكوبُ العُيونِ باكي الحَمائِم",18,"م",1,0],["واشتطَّ أحكامُ الردَى وتطاولتْ","أيدي المَنونِ إِلى السَّنامِ الأرفعِ",19,"ع",1,0],["وأشتهي أن أراهُ وهو مقتبِلٌ","غضّ الشبابِ خضيب الوجه بالشَّعَرِ",20,"ر",1,0],["وَاِشتِكائي هَواكَ ذَن","بٌ فَإِن تَعفُ لا أَعُد",21,"د",1,0],["وَاِشتِرائي العِراقَ خُطَّةُ غَبنٍ","بَعدَ بَيعي الشَآمَ بَيعَةَ وَكسِ",22,"س",1,0],["واشتَعَلَتْ نارُ خَدِّه خَجَلاً","فَخِلتُها في القُلوبِ تَشتَعِلُ",23,"ل",1,0],["واشترَكا إلى المماتِ في حَرِ","يَحرُثُهُ جَدُّ فَدانِ الأصغَرِ",24,"ر",1,0],["وَاِشتِياقي لِرَبعِكُم لا بِوَجدي","بِغَوانٍ بِهِ وَلا بِأَغاني",25,"ن",2,0],["واشتقّ من معنى الحياة نسيمه","فيكادُ يُحْدِثُ للعظام نُشورا",26,"ر",2,0],["واشتروه بنفوسٍ حُرّةٍ","بذلوها من سَخاءٍ وكرمْ",27,"م",1,0],["وَأَشتَهي مِنكَ ذَنباً","أَبني عَلَيهِ العِتابا",28,"ب",2,0],["وَاِشتِغالٍ بِالتُرَهاتِ وَحُبِّ الذ","ذات عَن نافع عَميم مَجيدِ",29,"د",1,0],["وَأَشتُمُ قَوماً كانَ مَجدُ أَبيهِمُ","عَلى كُلِّ حالٍ راسِياً لَم يُهَضَّمِ",30,"م",1,0],["واِشتد من غير إنذارٍ فمت به","كَذَلِكَ الغصن بالنكباء ينقصف",31,"ف",1,0],["واشْتَقَّتِ القُهْبُ ذات الخَرْجِ مِنْ مَرَسٍ","شَقَّ المُقَاسِمِ عَنْهُ مِدْرَعَ الرَّدَنِ",32,"ن",1,0],["واشتكتْ رقَّتهُ في الأرض يُبسا","وغدا الإبريقُ والكأسُ حطاما",33,"م",2,0],["وأشتمُّ من أنفاسها حَرَّ هَبْوَةٍ","كأنَّ هجيرَ الصيف يلفحُ حاصبُهْ",34,"ب",2,0],["واشْتَدَّ يَنْظِمُ حَزْمَهُمْ","شَيْحَانُ طَلاع المخارِمْ",35,"م",1,0],["وَاشْتَدَّ حُزْنُهُمُ وَلَمْ يَكُ مُجْدِياً","مِنْ بَعْدِ فَقْدِ أَحِبَّةٍ وَبِلاَدِ",36,"د",1,0],["وَاشْتدَّ رُزْءُ المُسْلِمِينَ وَحُزْنُهُمْ","لَمَّا مَضَيْتَ وَلَسْتَ فِيهِمْ مُخْلَفا",37,"ف",2,0],["وَاشْتِبَاكٌ كَضَمِّ غُصْنٍ أَخَاهُ","وَكَلَثْمِ النُّوَّارِ لِلنُّوَّارِ",38,"ر",1,0],["وأَشْتَاتُ تخِريجٍ تُحَارُ بِهَا النُّهَى","وَآياتُ تدْبِيجٍ تَرُوعُ وتَبْهَرُ",39,"ر",1,0],["واشتعلتْ لندنُ...","مثلَ ليلةِ الزفاف",40,"ف",1,0],["وَاِشتَكَت شِدَّةَ الإِزارِ مِنَ البُه","رِ وَأَلقَت عَنها لَدَيَّ الخِمارا",41,"ر",2,0],["واشتر الحمد بالمواهب واعقد","عقدها في مظنة الأرباح",42,"ح",1,0],["وأشتمّ صيفا خجول القطاف","تلعثم في وجنتيك وفاح",43,"ح",1,0],["واشتياق يقتات أنفاسه الحمر","ويحسو جراحه ... وحريقه",44,"ق",2,0],["واشتقّ من معنى الحياة نسميه","فيكادُ يُحْدِثُ للعظام نُشورا",45,"ر",2,0],["وَاِشتَرى مِنهُم النُفوس كَريمٌ","وَدَعاهُم أَعزة أَحرارا",46,"ر",2,0],["واشتط يشربها إلى أَن","يغتدي سكران طينه",47,"ن",2,0],["واشتدّ ظُلم الظالمينَ","على البريّةِ واشْتهر",48,"ر",1,0],["وَاِشتَهَرنا لِلنّاسِ حَيثُ يَقولو","نَ إِذا خُبِّروا بِما قَد فَعَلنا",49,"ن",2,0],["وَأَشتاقُ الدِيارَ وَساكِنيها","كَما يَشتاقُ صِحَّتَهُ العَليلُ",50,"ل",1,0],["واشتاقَ من لم يدن مني لمن دنا","ويصبح قلبي وهو من حبهمَ صفرُ",51,"ر",1,0],["وَاِشتَعَلَ المُبيَضُّ في مُسوَدِّهِ","مِثلَ اِشتِعالِ النارِ في جَزلِ الغَضى",52,"ا",1,0],["وأشتَاقُ لِلبَرقِ اليَمانِى إِذَا غَدَا","وَأَزدَادُ شَوقاً أَن تَهُبَّ جَنُوبُ",53,"ب",1,0],["واشتكت عيني فقالوا","خذ لها بالليل حرفا",54,"ف",2,0],["واشترك الناس في المراعي","لعزّة القوت والحمير",55,"ر",1,0],["وَاِشتَكت كعبةُ الإله أذاهم","وَاِستَغاثَت مِن شركهم إيلياءُ",56,"ا",2,0],["وأشتاق من نجد معالم ربعها","ومن نبتها زهر الربا العاطر المجنى",57,"ن",2,0],["واشتد حتى ان من يرده","لم يدف مني فيه غير اللسان",58,"ن",1,0],["واشتاق شوقَ النِّيب وأبْدِي حنينها","على من بدا وجهاً حكى الشمسَ أبْلَجَا",59,"ج",2,0],["واشتد ريح فكدنا","نروح تحت الرمال",60,"ل",1,0],["واشترطوا في المتحركين","أن لا يكونا متصدرين",61,"ن",1,0],["وَاِشتَدَّ في الحَجَرِ الكَريمِ نِزاعُهُم","مَن مِنهُم لِلرَّفعِ مِنهُ يُعانِ",62,"ن",1,0],["وَاِشتَدَّ تطلابُ العداةِ فَأَجزَلوا","فيهِ الرَّشا وَنَفائِسَ الأَثمانِ",62,"ن",1,0],["وَاِشتَدَّ بَردُ غَدوَةٍ فَتَخَلَّفوا","عَنها تَخَلُّفَ عاجِزٍ كَسلانِ",62,"ن",1,0],["وَاِشتَدَّ بَأسُهُم فَأَرسَلَ فيهِم","كَفّا مِنَ الحَصباءِ وَالصوّانِ",62,"ن",1,0],["وَاِشتَدَّ ما يَلقاهُ مِن آلامِهِ","حَتّى لَقَد حَمَلوهُ في الأحضانِ",62,"ن",1,0],["وَاِشتَكَت داءَها العُضالَ فَأَلفَت","كَ لِأَدوائِها الطَبيبَ الآسي",63,"س",2,0],["وَاشْتَرِ الرُّشْدَ بِالضَّلاَلَةِ وَاعْلَمْ","إِنَّمَا يَرْبَحُ الذِينَ اشْتَرَوْهُ",64,"و",2,0],["وأشتاقُ إِن هَبَّت نسيمُ قطائفِ ال","سِّحورِ سُحَيراً وهيَ عاطرة النَّثرِ",65,"ر",1,0],["وأشتهي أن أغوص فيه","من مشط رجلي إلى جبيني",66,"ن",2,0],["واشتدّ من كلّ الجهات المخرجُ","ضاق الخناق لوسع خرق الراقعِ",67,"ع",1,0],["وأشتاقُ فجراً لاحَ بعدَ تَسهُّدٍ","كما لاحَ يجلو بأسَنا الأملُ الأنور",68,"ر",1,0],["واشتدَّ عسكرُنا يحمي منازلنا","وارتدَّ أسطولُنا يحمي شواطينا",69,"ن",2,0],["واشتدَّ يصبغُ في المطلولِ من دمكم","تاجاً وعرشاً لمولاهُ وأثوابا",70,"ب",2,0],["وَأَشْتاقُكُمْ وَالْيَأْسُ بَيْنَ جَوانِحِي","وَأَبْرَحُ شَوْقٍ ما أَقامَ مَعَ ألْياسِ",71,"س",1,0],["واشتدَّ أَسرُ الشعرِ فيك وَطالما","كانت تساور جسمَه الأَسقام",72,"م",1,0],["واشتدّ حول المسلمين ففتّحوا","بهدى الحنيفة مغلق الأمصار",73,"ر",1,0],["وَأَشتهِي الكَحَالَ يَأْتي في البُكَرْ","وَهْوَ مَعِي مُعَيَّنٌ مِن السُّخَرْ",74,"ر",1,0],["وَأَشتَكيهِ صَباباتٍ لَبُعدِهِم","وَشَأنُ أَطلالِهِ مَن بُعدِهِم شاني",75,"ن",2,0],["وأَشتملُ الظّلامَ وفي شِمالي","زِمامُ شِمِلَّةٍ تَحْكي الشَّمالا",76,"ل",2,0],["وَاِشتِياقٌ أَم نِزاع","وَحَنين أَم جمام",77,"م",1,0],["وَاِشتِياقي إِلَيك في البُعد مثل ال","قُرب نار بِها الجَوانح تُصلى",78,"ل",2,0],["واشتغل بالذي يعنيك فاعلمه وادره","لا تعرج على غيره تصيبك معره",79,"ر",2,0],["واشتغل بالدين جهدك","ما سوى هذا فضول",80,"ل",1,0],["واشتَقَّ من حَقِّهِ بَحراً طغى وطمى","حُبابُهُ فَوقَ أفكاري وآمالي",81,"ل",2,0],["واشتياقي إلى ارتشاف رضاب","حَسَدَتْ ذلك الرضابَ المدام",82,"م",1,0],["واشتد هذا الثلج حتى لم يكن","من هوله لابن السبيل دخول",83,"ل",1,0],["واشتاقَ ثغرُ الأقحوا","نِ من الشقيقِ الغضِّ خدّا",84,"د",2,0],["وأشتاق إن مر النسيم وإنما","أذوب أسى للبارق المتألّق",85,"ق",1,0],["واشتط في اطماعه","وغروره حتى هبط",86,"ط",1,0],["واشتجار الضرب من حرَّته","مذهل الأمِّ عن الطفل الرؤوم",87,"م",1,0],["واشتدَّ محْلٌ فاغتدت أشلاؤُهُ","للمُترف العيَّافِ أكْرم مطعمِ",88,"م",1,0],["واشْتبه الهامُ بمُلْقى الجَندلِ","جاء الوزير في الرَّعيل الأول",89,"ل",1,0],["واشتريتمْ بوصالٍ مُهْجَتي","ومنَ العَدْلِ أداءُ الثَّمَنِ",90,"ن",1,0],["واشتاق نعمان الأراك ولم أكن","بأول مشتاق يحن من الوجد",91,"د",1,0],["وأشتاق هيف المائسات من القنا","ولولاكمُ ما شاقني مائسُ القدِّ",92,"د",