59",""],[3464,"تحكم بما تهوى لك الحسن مسعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158768",""],[4767,"شهداء العقيدة","https://www.poetsgate.com/ViewPoem.aspx?id=179282",""],[4920,"نسيم الصبح قد هبا","https://www.poetsgate.com/ViewPoem.aspx?id=1026",""],[5431,"وضعتك في أكف العشق طفلا...","https://www.poetsgate.com/ViewPoem.aspx?id=190158",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[709,"أَتُنْكِرُ بَأْسَ أَحْدَاقِ الْعَذَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=2929",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[520,"هي البدر بل من سنة البدر املح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577465",""]],"verses":[["لَهُ كُلَّ يَومٍ مَعرَكٌ إِن شَهِدتَهُ","تَرى قُضُباً عوناً وَهاماً عَذارِيا",0,"ي",2,0],["لَهُ كُلَّ يَومٍ غارَةٌ في عَدُوِّهِ","تُشارِكُهُ فيها النُسورُ القَشاعِمُ",1,"م",1,0],["لَهُ كُلَّ يَومٍ مُنيَةٌ وَطَماعَةٌ","وَنَبذُ قَريضٍ بِالأَمانيِّ سَيّارُ",2,"ر",1,0],["لَهُ كِذبُ الوَعيدِ مِنَ الأَعادي","وَمِن عاداتِهِ صِدقُ الضَرابِ",3,"ب",1,0],["لَهُ كُلَّ يَومٍ في رِضى اللَهِ مَوقِفٌ","وَفي ساحَةِ الإِحسانِ وَالبِرِّ مَوقِفُ",4,"ف",1,0],["لَهُ كَفَلٌ كَالدِعصِ لَبَّدَهُ النَدى","إِلى حارِكٍ مِثلِ الغَبيطِ المُذَأَّبِ",5,"ب",1,0],["لَهُ كَفٌّ يُشَدُّ بِها وَكَفٌّ","تَحَلَّبُ ما يَجِفُّ ثَرى نَداها",6,"ا",3,0],["له كفّ تفيض ندىً ونبلاً","لها بهما غنىً عن حَزو حازي",7,"ز",2,0],["لَهُ كَفٌّ تَفيضُ دَماً وَكَفٌّ","يُباري جودُها سَحَّ الشَمالِ",8,"ل",1,0],["له كتبٌ في ديار العدَى","غني بها الجيش عن كدحه",9,"ح",2,0],["له كلّ يوم في السيادة والعلى","أحاديثَ تملي المادحين فتبدع",10,"ع",1,0],["له كلّ يومٍ فيك واشٍ وعاذلُ","وفي قلبِه شغل من الحبِّ شاغل",11,"ل",1,1],["له كَلْكل رحبُ اللَّبان وكاهل","مُظَاهَر ألباد الرِّحالة أوْبر",12,"ر",1,0],["له كلَّ يوم في السوام عقيرةٌ","تكوسُ وقرنٌ فيه نُجْلٌ نواحط",13,"ط",1,0],["لَهُ كَبِدٌ حَرّى وَقَلبٌ مُكلَمٌ","غَلِطتُ فَما لِلصَبِّ قَلب وَلا كَبِدُ",14,"د",1,0],["لَهُ كَوكَبٌ تَعشى بِهِ الشَمسُ واضِحاً","تَرى فيهِ أَبناءَ المَنِيَّةِ رُوَّدا",15,"د",2,0],["لَهُ كَوكَبٌ إِذ ذَرَّتِ الشَمسُ واضِحٌ","تَرى فيهِ مِنّا دارِعينَ وَحُسَّرا",16,"ر",2,0],["له كلّ نادٍ بالوقار مُكَرَّمٌ","بغيرِ وقورٍ منه مِقْوَلُ أبكمِ",17,"م",1,0],["لَهُ كِبرِياءُ المُشتَري وَسُعودُهُ","وَسَورَةُ بَهرامٍ وَظَرفُ عُطارِدِ",18,"د",1,0],["لَهُ كُلَّ يَومٍ شَملُ مَجدٍ مُؤَلَّفٍ","وَشَملُ نَدىً بَينَ العُفاةِ مُشَتَّتِ",19,"ت",1,0],["لَهُ كَرَمٌ لَو كانَ في الماءِ لَم يَغِض","وَفي البَرقِ ما شامَ اِمرُؤٌ بَرقَ خُلَّبِ",20,"ب",1,0],["لهُ كلَّ يومٍ فتنةٌ أو شكايةٌ","وقالٌ وقيلٌ هكذا ينسلُ الكفرُ",21,"ر",1,0],["لَهُ كُلُّ نُعمى بَيَّضَت كُلَّ صَفحَةٍ","بِكُلِّ مَكانٍ فَالبَهيمُ مِنَ الغُرِّ",22,"ر",1,0],["لَهُ كاتِبٌ عَبقَرِيُّ اليَراعِ","سَرِيُّ الصَحيفَةِ حُرُّ الدَواةِ",23,"ه",1,0],["لَهُ كُلَّ عامٍ غَزوَةٌ بِمُسَوَّمٍ","يَقودُ المَنايا رايُهُ حينَ يَذهَبُ",24,"ب",1,0],["لَهُ كُمَيتانِ ذاتُ كَأسٍ","تُزبِدُ وَالسابِحُ الرَبيطُ",25,"ط",1,0],["له كلام وإن","الكلام منه مبين",26,"ن",1,0],["له كذاك جحيم","بها الحديد يلين",26,"ن",1,0],["له كَعْبُ نَحْسٍ لم يُصاحِبْ به امْرءاً","على الدَّهْرِ إِلا رُدَّ وَهْوَ خَيالُ",27,"ل",1,0],["لَهُ كَتفَان عَلاَويَتَان","كَصَفح أُواليَّة مِن إرَم",28,"م",1,0],["لَهُ كِبْرَةٌ تَبْدُو عَلَيْهِ كَأَنَّهُ","مَلِيكٌ عَلَيْهِ التَّاجُ يَنْظُرُ عَنْ شَزْرِ",29,"ر",1,0],["له كلَّ يوم حياةٌ تمرُّ","وعْمرٌ طويل يفوق الحسابا",30,"ب",2,0],["له كلَّ يوم قطعةٌ من فؤادِه","يُساقطها للناشئين قوافيا",31,"ي",2,0],["له كفلٌ كالدّعص لبدهُ الثدى","إلى حارِكٍ مِثْلِ الغَبيطِ المُذَأّبِ",32,"ب",1,0],["له كَفٌّ يفوقُ الغيث جودَاً","وقلبٌ يُشْبه الأرضينَ وسُعْا",33,"ع",2,0],["لَهُ كُديَةٌ أَعيَت عَلى كُلِّ قابِضٍ","وَلَو كانَ مِنهُم حارِشانِ وَحابِلُ",34,"ل",1,0],["لَهُ كُلُّ مَن يَلقى مِنَ الناسِ واحِداً","وَإِن يَلقَ مَثنى القَومِ يَفرَح وَيَزدَدِ",35,"د",1,0],["له كل يوم توبة ثم حوبة","متى عنَّ أو متى مسَّ طائف",36,"ف",1,0],["له كل يومٍ في العلا خرقُ عادةٍ","تناطُ بِأُخرى بعد أُخرى وتردفُ",37,"ف",1,0],["له كل يوم نهضة تطلب العلا","من السيف في شرق البلاد وفي الغرب",38,"ب",1,0],["له كل يوم في أعاديه فتكة","مدى الدهر بكر لا يصير عوانا",39,"ن",2,0],["له كل يوم مفخر يستجده","ولا يبتغى الا مجاوزة الحد",40,"د",1,0],["لَهُ كُلَّ يَومٍ غارَةٌ مُشمَعِلَّةٌ","تَرى الصِّيدَ مِن شَدّاتِها في مَناسِكِ",41,"ك",1,0],["له كفٌ تُعيد ندىً وتُبدى","فتُزْرِى بالبحار وبالسحاب",42,"ب",1,0],["لهُ كلُّ ما قَد كان أو هو كائنٌ","وَما لِسواه في الورى ذرّةٌ صغرى",43,"ر",2,0],["لهُ كجمالِ الدينِ نسبة كاذبٍ","بِها زادَ في طُنبوره نغمةً أخرى",43,"ر",2,0],["له كرمٌ وبه عفَّةٌ","فيجمعُ بينَ الحيا والحياءِ",44,"ا",2,0],["لَهُ كَفّانِ كَفٌّ كَفُّ ضُرٍّ","وَكَفُّ فَواضِلٍ خَضِلٌ نَداها",45,"ا",3,0],["لَهُ كُلَّ يَومٍ نَبأَةٌ مِن مُكَلِّبٍ","تُريهِ حِياضَ المَوتِ ثُمَّتَ تُقلَعُ",46,"ع",1,0],["لَهُ كُلَّ يَومٍ مغنَمٌ مِن عَدوِّهِ","يَرى بَذلَهُ لِلمجتدي نَيلَ مَغنَم",47,"م",1,0],["لَهُ كَرَمُ الْغَمامِ يَجُودُ عَفْواً","فَيُغْنِي عَنْ ذَرِيعٍ أَوْ وَسِيلِ",48,"ل",1,0],["لَهُ كِباشٌ بِوَقعِ السَيفِ يَغصِبُها","وَكَبشُ صَفِّكَ ماضٍ غَيرُ مَغصوبِ",49,"ب",1,0],["لهُ كَفٌّ أَهَانَ المالَ فِيها","فَأَقسَمَ لا أَقامَ على الهَوَانِ",50,"ن",1,1],["لَهُ كَرم الخِصال أبان حُبّاً","بِأَفئدة الأَنام غَدا كَمينا",51,"ن",2,0],["لَهُ كَرم الأَخلاق خلق مُحكَّم","لَهُ العَفو حكم لازم لا يغيّرُ",52,"ر",1,0],["له كلُّ أنمُلَةٍ كَعْبةٌ","مُعظّمةٌ ركْنُها يُسْتلَم",53,"م",1,0],["له كلَّ يومٍ بها نظْرةٌ","إلى الخلْقِ كشّافةٌ للغُمَم",54,"م",1,0],["لهُ كُلَّ يومٍ رفْعةٌ بعدَ رِفْعةٍ","كذلكَ في العَلْياء فَلْيَسْمُ منَ سَما",55,"م",2,0],["له كَفٌّ يَزِلُّ المالُ عنها","وكيف يَقِرُّ ماءٌ في مَسيل",56,"ل",1,0],["لَه كُلّ يومٍ مِن صُدودِكَ لَوعَةٌ","تعوَّدَ أَن يَتلو بِها زَفرَةً تَعلو",57,"ل",2,0],["لَهُ كرم كالبَحر يَزداد كُلَّما","يُرجّى فَما يَخشى عَلَيهِ نَفادُ",58,"د",1,0],["لَهُ كَفُّ جودٍ تُفيدُ الغِنى","وَكَفٌّ تُبيدُ بِسَيفِ النِقَم",59,"م",1,0],["له كلّ يوم وقفة بعد وقفة","يهيجُ جوى أحشائه وتقرّه",60,"ر",2,0],["له كبد حرّى تجنّ صبابة","تحنّ لعلويّ البروق التي تسري",61,"ر",2,0],["له كلَّ عامٍ منكَ عادةُ نعمةٍ","ولي تُوسَع الآمالُ حين تحينُ",62,"ن",1,0],["له كلَّ يومٍ والرياحُ ظوالعٌ","مُناخٌ إلى أمرِ العلا ورحيلُ",63,"ل",1,0],["له كلَّ يَومٍ نهضةٌ دون عِرضهِ","إذا نام حُبَّاً للبقاءِ حَسيبُ",64,"ب",1,0],["له كلَّ يومٍ حولَ سَرحِيَ غارةٌ","يشرِّد فيها بالصفايا النجائبِ",65,"ب",1,0],["لهُ كعبة الله الحرام وركنها","ومشعرها في حجرها ومقامها",66,"م",3,0],["لَهُ كُلُّ لَحنٍ إِذا ما هَمى","كَسى العَيشَ زَهراً بِأَندائِهِ",67,"ا",3,0],["له كُتبٌ يعِزُّ النّضبُ عنها","إذا شنّت كتائِبُها مُغارا",68,"ر",2,0],["له كما رووه قالوا لم يمت","وسوف يأتي فيكون ما ثبت",69,"ت",1,0],["له كاتِبٌ في الخَدِّ والخطُّ خَطهُ","إِلى شاعرٍ في فيه والشِّعرُ شِعْرهُ",70,"ر",2,0],["لَهُ كُلَّ يَوْمٍ في الوَدَاعِ مَواقِفٌ","يَذُوبُ لَهَا رَخْوُ الجمادِ وصَلْدُهُ",71,"د",2,0],["له كصفاً بصافي الماء تبدو","او الاقمار لحن بلا غيوم",72,"م",1,0],["لهُ كلّ يومٍ إن يمرّ وليلة","على عُلماءِ الدين سطوة غاشمِ",73,"م",1,0],["له كل حين حان نشأة نشوة","فيحيا بها بعد المعاد مواته",74,"ت",2,0],["له كل آن انة بعد أنة","لظاها على اعضائه تنقسم",75,"م",1,0],["له كَفَّانِ كَفٌ فيه يَبني","وكَفّ فيه شدَّ على الزِنادِ",76,"د",1,0],["له كُثْر أولادٍ وقلّةُ ثروةٍ","وقد عافه عن شأنه حادث الردى",77,"د",2,0],["له كلَّ يوم في خزائن ماله","ينادي إلى العافين داعي المكارمِ",78,"م",1,0],["له كلمٌ تَفوق الدر حسنا","وَطيّبها أَراه إِلَيهِ يصعد",79,"د",1,0],["له كفل كالترس محدودب الضلا","ومتن عظيم المنكبين نحوب",80,"ب",1,0],["لَهُ كفيلٌ غداة الروع ذابله","بنزعِ أرواحِ أبطالٍ وفرسانِ",81,"ن",1,0],["له كلام قائم بالذات","بلا حروف وبلا أصوات",82,"ت",1,0],["له كفّ كأنّ بِراحَتَيْها","منايا القومِ يَخْطِفُ خَطْفَ بازي",83,"ز",2,0],["له كَلِمٌ فيكَ مَعقولَةٌ","إِزاءَ القُلوب كركب وقوف",84,"ف",1,0],["لَهُ كُلَّ يَوم حَنّةٌ بَعدَ رَنَّة","يَجيش بِها في الصَدر شَوق يُغالِبُه",85,"ب",2,0],["له كرم ما البحر في جنب كفة","له منطق يسبى القلوب بخشية",86,"ه",1,0],["له كرم والخلق فهو مكمل","وأعظم خلق نعته جاء منزلا",87,"ل",2,0],["له كف يفوق البحر مدا","له ريح يفوق المسك في الشم",