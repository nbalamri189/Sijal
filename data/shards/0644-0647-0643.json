{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"بني عامر ما العز إلا لقادر","https://www.aldiwan.net/poem29773.html","الطويل"],[53,"فيا عجبا مما يظن محمد","https://www.aldiwan.net/poem30411.html","الطويل"],[53,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[86,"صدفت عن الأهواء والحر يصدف","https://www.aldiwan.net/poem68953.html","الطويل"],[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[88,"أبو غازي قضى فاقيم غازي","https://www.aldiwan.net/poem45037.html","الوافر"],[23,"رضيت حكومة المرقال قيس","https://www.aldiwan.net/poem21484.html","الوافر"],[72,"تأوب كالبدر في جنحه","https://www.aldiwan.net/poem18484.html","المتقارب"],[72,"سرى طيفها حيث العواذل هجع","https://www.aldiwan.net/poem19163.html","الطويل"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[91,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[28,"وأرعن جرار إذا ما تطلقت","https://www.aldiwan.net/poem5004.html","الطويل"],[28,"ونحن حدرنا طيئا عن جبالها","https://www.aldiwan.net/poem5062.html","الطويل"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[44,"قفوا جددوا من عهدكم بالمعاهد","https://www.aldiwan.net/poem30543.html","الطويل"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[105,"أما والليالي وأحداثها","https://www.aldiwan.net/poem43141.html","المتقارب"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[46,"أين امرؤ القيس والعذارى","https://www.aldiwan.net/poem22900.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30482","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21097","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[106,"رحلات عزام","https://www.poetsgate.com/ViewPoem.aspx?id=179550",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""],[126,"سقى بالمنحنى رسما وربعا","https://www.aldiwan.net/poem50581.html","الوافر"],[129,"وجدنا أبا الجبار ضباً مورشاً","https://www.aldiwan.net/poem23991.html","الطويل"],[129,"أرث جديد الحبل من أم معبد","https://www.aldiwan.net/poem24162.html","الطويل"],[148,"أسير الخطايا عند بابك واقف","https://www.aldiwan.net/poem68446.html","الطويل"],[158,"محب يمنى نفسه ويسوف","https://www.aldiwan.net/poem58925.html","الطويل"],[158,"أقمن على قلبي رقيبا من الحب","https://www.aldiwan.net/poem58937.html","الطويل"],[158,"خذوا لي من سمر القدود أمانا","https://www.aldiwan.net/poem58947.html","الطويل"],[158,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[167,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[183,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[196,"تعلقته من بني الأكرمين","https://www.aldiwan.net/poem51990.html","المتقارب"],[247,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[247,"أصوت مناد من رميلة تسمع","https://www.aldiwan.net/poem2109.html","الطويل"],[250,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[278,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[320,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[346,"له كف أهان المال فيها","https://www.aldiwan.net/poem20756.html","الوافر"],[351,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[351,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[362,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[362,"أما تحية الطرف الكحيل","https://www.aldiwan.net/poem60801.html","الوافر"],[369,"سقيم نهاه سقم جفنيه أن يسلو","https://www.aldiwan.net/poem57172.html","الطويل"],[403,"ألمت بنا بعد الهدو سعاد","https://www.aldiwan.net/poem50185.html","الطويل"],[407,"إلى ملك مثل بدر الدجى","https://www.aldiwan.net/poem67472.html","المتقارب"],[413,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[434,"صدرت ولم أنقع بكم غلة الصدر","https://www.aldiwan.net/poem2557.html","الطويل"],[456,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[456,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[456,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[456,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[462,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[466,"ومله سأقضي بإطرائه","https://www.aldiwan.net/poem60508.html","المتقارب"],[512,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[584,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"]],"verses":[["لَهُ كُلَّ يَومٍ مَعرَكٌ إِن شَهِدتَهُ","تَرى قُضُباً عوناً وَهاماً عَذارِيا",0,"ي",2,0],["لَهُ كُلَّ يَومٍ غارَةٌ في عَدُوِّهِ","تُشارِكُهُ فيها النُسورُ القَشاعِمُ",1,"م",1,0],["لَهُ كُلَّ يَومٍ مُنيَةٌ وَطَماعَةٌ","وَنَبذُ قَريضٍ بِالأَمانيِّ سَيّارُ",2,"ر",1,0],["لَهُ كِذبُ الوَعيدِ مِنَ الأَعادي","وَمِن عاداتِهِ صِدقُ الضَرابِ",3,"ب",1,0],["لَهُ كُلَّ يَومٍ في رِضى اللَهِ مَوقِفٌ","وَفي ساحَةِ الإِحسانِ وَالبِرِّ مَوقِفُ",4,"ف",1,0],["لَهُ كَفَلٌ كَالدِعصِ لَبَّدَهُ النَدى","إِلى حارِكٍ مِثلِ الغَبيطِ المُذَأَّبِ",5,"ب",1,0],["لَهُ كَفٌّ يُشَدُّ بِها وَكَفٌّ","تَحَلَّبُ ما يَجِفُّ ثَرى نَداها",6,"ا",3,0],["له كفّ تفيض ندىً ونبلاً","لها بهما غنىً عن حَزو حازي",7,"ي",1,0],["لَهُ كَفٌّ تَفيضُ دَماً وَكَفٌّ","يُباري جودُها سَحَّ الشَمالِ",8,"ل",1,0],["له كتبٌ في ديار العدَى","غني بها الجيش عن كدحه",9,"ح",2,0],["له كلّ يوم في السيادة والعلى","أحاديثَ تملي المادحين فتبدع",10,"ع",1,0],["له كلّ يومٍ فيك واشٍ وعاذلُ","وفي قلبِه شغل من الحبِّ شاغل",11,"ل",1,1],["له كَلْكل رحبُ اللَّبان وكاهل","مُظَاهَر ألباد الرِّحالة أوْبر",12,"ر",1,0],["له كلَّ يوم في السوام عقيرةٌ","تكوسُ وقرنٌ فيه نُجْلٌ نواحط",13,"ط",1,0],["لَهُ كَبِدٌ حَرّى وَقَلبٌ مُكلَمٌ","غَلِطتُ فَما لِلصَبِّ قَلب وَلا كَبِدُ",14,"د",1,0],["لَهُ كَوكَبٌ تَعشى بِهِ الشَمسُ واضِحاً","تَرى فيهِ أَبناءَ المَنِيَّةِ رُوَّدا",15,"د",2,0],["لَهُ كَوكَبٌ إِذ ذَرَّتِ الشَمسُ واضِحٌ","تَرى فيهِ مِنّا دارِعينَ وَحُسَّرا",16,"ر",2,0],["له كلّ نادٍ بالوقار مُكَرَّمٌ","بغيرِ وقورٍ منه مِقْوَلُ أبكمِ",17,"م",1,0],["لَهُ كِبرِياءُ المُشتَري وَسُعودُهُ","وَسَورَةُ بَهرامٍ وَظَرفُ عُطارِدِ",18,"د",1,0],["لَهُ كُلَّ يَومٍ شَملُ مَجدٍ مُؤَلَّفٍ","وَشَملُ نَدىً بَينَ العُفاةِ مُشَتَّتِ",19,"ت",1,0],["لَهُ كَرَمٌ لَو كانَ في الماءِ لَم يَغِض","وَفي البَرقِ ما شامَ اِمرُؤٌ بَرقَ خُلَّبِ",20,"ب",1,0],["لهُ كلَّ يومٍ فتنةٌ أو شكايةٌ","وقالٌ وقيلٌ هكذا ينسلُ الكفرُ",21,"ر",1,0],["لَهُ كُلُّ نُعمى بَيَّضَت كُلَّ صَفحَةٍ","بِكُلِّ مَكانٍ فَالبَهيمُ مِنَ الغُرِّ",22,"ر",1,0],["لَهُ كاتِبٌ عَبقَرِيُّ اليَراعِ","سَرِيُّ الصَحيفَةِ حُرُّ الدَواةِ",23,"ه",1,0],["لَهُ كُلَّ عامٍ غَزوَةٌ بِمُسَوَّمٍ","يَقودُ المَنايا رايُهُ حينَ يَذهَبُ",24,"ب",1,0],["لَهُ كُمَيتانِ ذاتُ كَأسٍ","تُزبِدُ وَالسابِحُ الرَبيطُ",25,"ط",1,0],["له كلام وإن","الكلام منه مبين",26,"ن",1,0],["له كذاك جحيم","بها الحديد يلين",26,"ن",1,0],["له كَعْبُ نَحْسٍ لم يُصاحِبْ به امْرءاً","على الدَّهْرِ إِلا رُدَّ وَهْوَ خَيالُ",27,"ل",1,0],["لَهُ كَتفَان عَلاَويَتَان","كَصَفح أُواليَّة مِن إرَم",28,"م",1,0],["لَهُ كِبْرَةٌ تَبْدُو عَلَيْهِ كَأَنَّهُ","مَلِيكٌ عَلَيْهِ التَّاجُ يَنْظُرُ عَنْ شَزْرِ",29,"ر",1,0],["له كلَّ يوم حياةٌ تمرُّ","وعْمرٌ طويل يفوق الحسابا",30,"ب",2,0],["له كلَّ يوم قطعةٌ من فؤادِه","يُساقطها للناشئين قوافيا",31,"ي",2,0],["له كفلٌ كالدّعص لبدهُ الثدى","إلى حارِكٍ مِثْلِ الغَبيطِ المُذَأّبِ",32,"ب",1,0],["له كَفٌّ يفوقُ الغيث جودَاً","وقلبٌ يُشْبه الأرضينَ وسُعْا",33,"ع",2,0],["لَهُ كُديَةٌ أَعيَت عَلى كُلِّ قابِضٍ","وَلَو كانَ مِنهُم حارِشانِ وَحابِلُ",34,"ل",1,0],["لَهُ كُلُّ مَن يَلقى مِنَ الناسِ واحِداً","وَإِن يَلقَ مَثنى القَومِ يَفرَح وَيَزدَدِ",35,"د",1,0],["له كل يوم توبة ثم حوبة","متى عنَّ أو متى مسَّ طائف",36,"ف",1,0],["له كل يومٍ في العلا خرقُ عادةٍ","تناطُ بِأُخرى بعد أُخرى وتردفُ",37,"ف",1,0],["له كل يوم نهضة تطلب العلا","من السيف في شرق البلاد وفي الغرب",38,"ب",1,0],["له كل يوم في أعاديه فتكة","مدى الدهر بكر لا يصير عوانا",39,"ن",2,0],["له كل يوم مفخر يستجده","ولا يبتغى الا مجاوزة الحد",40,"د",1,0],["لَهُ كُلَّ يَومٍ غارَةٌ مُشمَعِلَّةٌ","تَرى الصِّيدَ مِن شَدّاتِها في مَناسِكِ",41,"ك",1,0],["له كفٌ تُعيد ندىً وتُبدى","فتُزْرِى بالبحار وبالسحاب",42,"ب",1,0],["لهُ كلُّ ما قَد كان أو هو كائنٌ","وَما لِسواه في الورى ذرّةٌ صغرى",43,"ر",2,0],["لهُ كجمالِ الدينِ نسبة كاذبٍ","بِها زادَ في طُنبوره نغمةً أخرى",43,"ر",2,0],["له كرمٌ وبه عفَّةٌ","فيجمعُ بينَ الحيا والحياءِ",44,"ا",2,0],["لَهُ كَفّانِ كَفٌّ كَفُّ ضُرٍّ","وَكَفُّ فَواضِلٍ خَضِلٌ نَداها",45,"ا",3,0],["لَهُ كُلَّ يَومٍ نَبأَةٌ مِن مُكَلِّبٍ","تُريهِ حِياضَ المَوتِ ثُمَّتَ تُقلَعُ",46,"ع",1,0],["لَهُ كُلَّ يَومٍ مغنَمٌ مِن عَدوِّهِ","يَرى بَذلَهُ لِلمجتدي نَيلَ مَغنَم",47,"م",1,0],["لَهُ كَرَمُ الْغَمامِ يَجُودُ عَفْواً","فَيُغْ