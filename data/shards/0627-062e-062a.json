],[116,"نقشت في جبينها والمحيا","https://www.aldiwan.net/poem41658.html","الخفيف"],[136,"ما بال أصدق وعدها كسراب","https://www.aldiwan.net/poem49142.html","الكامل"],[151,"ماذا أقول ولا عتب على القدر","https://www.aldiwan.net/poem68476.html","البسيط"],[161,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[161,"من زاحم الأسد في غاباتها وقعا","https://www.aldiwan.net/poem58923.html","البسيط"],[205,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[224,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[230,"اخترت بالمختار لذاتي","https://www.aldiwan.net/poem51203.html","السريع"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[236,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[239,"لن نفترق","https://www.aldiwan.net/poem24809.html","عموديه"],[272,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[282,"اختم بذكر محمد فذكره","https://www.aldiwan.net/poem1378.html",""],[283,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32693.html","الرجز"],[299,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[303,"يا صاحب القبة الخضراء","https://www.aldiwan.net/poem65690.html","البسيط"],[329,"أخت أحلامي الذواهب مرحى","https://www.aldiwan.net/poem54958.html","الخفيف"],[365,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[372,"ما أقامت إلا لترحل صبري","https://www.aldiwan.net/poem57468.html","البسيط"],[378,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[378,"رب الورى في عرشه","https://www.aldiwan.net/poem66957.html","مجزوء الكامل"],[392,"محسن أحسن عسى ربك يجازيك بإحسان","https://www.aldiwan.net/poem54462.html","عموديه"],[392,"فاز المخفون في اليوم العظيم الطويل","https://www.aldiwan.net/poem54542.html","عموديه"],[392,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[394,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[406,"أخ تباعد عني شخصه ودنا","https://www.aldiwan.net/poem49716.html","البسيط"],[430,"أقبلت تنجلي وتسحب ذيلا","https://www.aldiwan.net/poem40711.html","الخفيف"],[459,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[465,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[480,"عانقيني بالراحتين حنوا","https://www.aldiwan.net/poem36881.html","الخفيف"],[516,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[539,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[539,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[545,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[568,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أُختَ الكَواكِبِ ما رَما","كِ وَأَنتِ رامِيَةُ النُسورِ",0,"ر",1,1],["أُختِ الفَلاةِ إِذا شُدَّت مَعاقِدُها","زَلَّت قُوى النِسعِ عَن كَبداءَ مِسفارِ",1,"ر",1,0],["اختلفنا كل اختلاف فما أن","يتساوى اعتقادكم واعتقادي",2,"د",2,0],["اختالت الشرقية الكبرى بكم","وجلت فتاكم في البيان شهابا",3,"ب",2,0],["اختاره اللورد من الأنام","معتدل المبدأ والقوام",4,"م",1,0],["اِختَلَفوا في أَصلِهِ وَفَصلِهِ","وَالسَيفُ يَومَ النَسَب اِبنُ نَصلِهِ",5,"ه",1,0],["أَختالُ حَتّى قالَتِ العِبادُ","لِمَن مِنَ المُلوكِ ذا الجَوادُ",6,"د",1,0],["اِختَلَطوا وَعَيَّثوا","كَالعُميِ حَولَ سُفرَةِ",7,"ه",1,0],["اِختَرتَ يَومَ الهَولِ يَومَ وَداعِ","وَنَعاكَ في عَصفِ الرِياحِ الناعي",8,"ع",2,1],["اِختِلافُ النَهارِ وَاللَيلِ يُنسي","اُذكُرا لِيَ الصِبا وَأَيّامَ أُنسي",9,"س",2,1],["أُختُ أَبي خَيرٍ أَميرٍ دَعا","فَقالَ جَيشٌ لِلقَنا لَبِّهِ",10,"ب",2,0],["اِختَرتُ دَهماءَتَينِ يا مَطَرُ","وَمَن لَهُ في الفَضائِلِ الخِيَرُ",11,"ر",1,1],["أختالُ بينُ جآذِرٍ ومَزاهِرٍ","وأرودُ بين دساكِرٍ وَبَواطِي",12,"ط",2,0],["أُختُ بَني شَيبانَ مَرَّت بِنا","مَمشوطَةً كوراً عَلى بَغلِ",13,"ل",1,0],["أَخٌ تَرَكَت أَسِنَّتُهُ أَخاهُ","تَليلاً لِلجَبينِ وَلِليَدَينِ",14,"ن",1,0],["أَخْتَالُ طَوْرَاً فَوْقَ ذِرْوةِ مِنْبَرٍ","وَأَكُرُّ طَوْرَاً فَوْقَ نَهْدٍ شَيْظَمِ",15,"م",1,0],["أختُكِ الوَلْهى عَنَاها شجوُها","وَدَهَى أبناءَها الخطبُ المِلَمّْ",16,"م",1,0],["أُختانِ إِحداهُما إِذا اِنتَحَبَت","تَبكي كَباكٍ بِدَمعَةٍ حَرّى",17,"ر",2,1],["اِختارَها في القِطافِ سائِمُها","حُمراً وَسوداً كَأَنَّها الحَدَقُ",18,"ق",1,0],["اِختَصَمَ الجودُ وَالجَمال","فيكَ فَصارا إِلى جِدال",19,"ل",1,1],["اِختارَ داوُدُ البُكاءَ مَكارِماً","وَاِختَرتَ أَكلَ نَقانِقٍ وَثَريدِ",20,"د",1,0],["أُختُ بَني الصَرِدِ في دَهرِها","أَصابَها سَهمُ رَداً صارِدُ",21,"د",1,0],["إِختِلافٌ قَد عَمَّنا في اِعتِقادٍ","وَصَلاةٍ لِرَبِّنا وَطُهورِ",22,"ر",1,1],["اختبرت الرجال من كل صنف","فإذا الناس كافرٌ أَو شكور",23,"ر",1,0],["اختفى عَن قوم وَخالط قوماً","فأرى الناس خفة ووقارا",24,"ر",2,0],["اختر ما هزّك من شعر","قد قيل فذلك أَجوده",25,"د",2,0],["اخترت من جوف الثرى متبوأً","علّ الثرى لك منزل تشتاق",26,"ق",1,0],["إختار في الظلِّ له مقعدا","في ربوةٍ فاتنةٍ ساحرَهْ",27,"ه",1,0],["أخْتَ روحي قرِّبيها من فمي","إن شربنا أو طربنا ما علينا",28,"ن",2,0],["أُختاهُ هذا الحبُّ غضٌّ صِباهْ","أيُّ عذابٍ صاغ هذي الصورْ",29,"ر",1,0],["أُخْتُنَا شَمْسُ البَنَاتِ الخُرَّدِ","الزُّهْرِ فِي العَصْرِ",30,"ر",1,0],["أُخْتِ الشَّوَادِي الخُضْرِ حَا","نتْ لَفْتَةُ المُتنَوِّعِ",31,"ع",1,0],["أخت الفراشات يلعب","ن حاليات الجناح",32,"ح",1,0],["اِختَطَفتِ اِبنَ اللَباةِ وَلَم","تَحمِهِ الأَظفارُ وَاللِبَدُ",33,"د",1,0],["اِخْتَارَكَ اللّهُ لِلإِسْلاَمِ تَنْصُرُهُ","فَكُنْتَ مَوْثِلَهُ يَا خَيْرَ مُخْتَارِ",34,"ر",1,0],["أختاهُ ! قد أزف النوى فتنعمي","بعدي فإن الحب لن يتكلما",35,"م",2,0],["أختك الشقراء مدت كفها","فاكتسى من كل نجم إصبع",36,"ع",1,0],["اختلتَ في بُرد الزفاف، وفي غد","تختال في برد النبيِّ الهادي",37,"د",2,0],["اختَرْ لنفسِكَ من فُتيَّاتِ القُرى","أهْلاً، فهُنَّ ملائِكٌ أطهار",38,"ر",1,0],["اختزال يجيء إثر اختزال","من قلوب لا تَعْرف الإشفاقا",39,"ق",2,0],["أختال كالسلطان ، حاشيتي الحصى ... تحيتي بلا فخر حصان الوالي","جيشي عفونات الأزقة تحتفي ... حولي ، وراياتي خيوط سعالي",40,"ل",2,0],["أختار هذا ما ترى من رأى","قلبي ركاما ؟ أحسن الاختيار",41,"ر",1,0],["اختار داوود البكاء مكارماً","واخْتَرْتَ أَكْلَ نَقَانِقٍ وثريد",42,"د",1,0],["اختياراً بالبنت سيروا إلى صالحها","قبل أن تسيروا اضطرارا",43,"ر",2,0],["اختبرنا ، إنَّا أسأنا اختباراً","واقتنعنا ، إنا أسأنا اقتناعا",44,"ع",2,0],["أختُ بني الصّاردِ، في دهْرِها","، أصابَها سَهمُ ردًى، صارد",45,"د",1,0],["أُختَ الأزقَّةِ والمضاجعِ والغوى","والغرفةِ المشبوهةِ المتلألِئهْ",46,"ا",2,0],["اخْتَارَكَ اللّهُ للإِسْلاَمِ تَنْصُرُهُ","فَكُنْتَ مَوْئِلَهُ يَا خَيْرَ مُخْتَارِ",47,"ر",1,0],["أختال كالسلطان ، حاشيتي الحصى","تحيتي بلا فخر حصان الوالي",48,"ل",2,0],["اخت تكاد تكون اما برة","فمن الحنان الله طينتها برى",49,"ر",2,0],["أخت الغزالة بنت الشمس ناعس ال","أجفان قتالة العشاق بالحور",50,"ر",1,1],["أخت شمس تبرقعت بدجى الشع","ر فأبدت للناس سراً خفيا",51,"ي",2,0],["أخت الهلالِ أما بقلبكَ رحمة","لمتيم بهوى هواكِ مصابِ",52,"ب",1,0],["أخ توخى المعالي في الصبا فأتى","كالماء ما أثرت فيه يد الكدر",53,"ر",1,0],["اخترت واختار الإِله لك الذي","ترضى وما تختار كان الأحسنا",54,"ن",2,0],["اختر لنفسك واعمل ما تحب لها","لا يحصد المرءُ شيئاً غير مازرعا",55,"ع",2,0],["اختصَّه جعفر الإمام فقد","وُفِّقَ فيما اختَصَّه جعفرْ",56,"ر",1,0],["أخت وَيا لِلَّهِ مِن جورِها","يأتمرُ الكُلُّ إِذا تَأمرُ",57,"ر",1,0],["اخترت بالمختار لذَّاتي","وكرَّ كاساتي وطاساتي",58,"ت",2,1],["اِختارَ إِسماعيلَ مِن أَولادَهِ","وَبَني كنانَةَ مِن بَني عَدنانِ",59,"ن",1,0],["أُختُ القَناعَةِ لا تَخِف","فُ لَها إِلى طَمَعٍ رِكابُ",60,"ب",1,0],["أختاه، صمتك ملؤه الريب ؟","فيما الفراق ؟ أما له سبب ؟",61,"ب",1,0],["أختاه لذّ على الهوى ألمي","فاستمتعي بهواك وابتسمي",61,"ي",1,0],["اختاره رب السَموات العلى","واختصه بالمكرمات وَفضل