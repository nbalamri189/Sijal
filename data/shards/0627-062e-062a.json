gate.com/ViewPoem.aspx?id=194020",""],[5956,"أختارُ ماذا أيا غالي سليمانُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=194707",""],[5956,"اختصه المولى بألف فضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=194771",""],[5956,"تجدد الإخلاص لله","https://www.poetsgate.com/ViewPoem.aspx?id=200102",""],[5956,"اختصكِ الرحمن بالتوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=207452",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5956,"كل أب يخشى على ابنه خَشيةً مشروعة","https://www.poetsgate.com/ViewPoem.aspx?id=215770",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=215046",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6056,"المعاناة الشديدة","https://www.poetsgate.com/ViewPoem.aspx?id=130508",""],[6056,"النقاش المحتدم","https://www.poetsgate.com/ViewPoem.aspx?id=156708",""],[6068,"خير اللغات جلالة وفخامة -16-","https://www.poetsgate.com/ViewPoem.aspx?id=175972",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[6097,"هل تُصغِينَ","https://www.poetsgate.com/ViewPoem.aspx?id=190697",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[6211,"أوّاهُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78539&r=&rc=0",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6271,"أبناء الدروب الضيقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80702&r=&rc=8",""],[6279,"هِيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78807&r=&rc=25",""],[572,"شَارفَتْنَا طَلائعُ المهرجانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9486&r=&rc=343",""]],"verses":[["أُختَ الكَواكِبِ ما رَما","كِ وَأَنتِ رامِيَةُ النُسورِ",0,"ر",1,1],["أُختِ الفَلاةِ إِذا شُدَّت مَعاقِدُها","زَلَّت قُوى النِسعِ عَن كَبداءَ مِسفارِ",1,"ر",1,0],["اختلفنا كل اختلاف فما أن","يتساوى اعتقادكم واعتقادي",2,"د",2,0],["اختالت الشرقية الكبرى بكم","وجلت فتاكم في البيان شهابا",3,"ب",2,0],["اختاره اللورد من الأنام","معتدل المبدأ والقوام",4,"م",1,0],["اِختَلَفوا في أَصلِهِ وَفَصلِهِ","وَالسَيفُ يَومَ النَسَب اِبنُ نَصلِهِ",5,"ه",1,0],["أَختالُ حَتّى قالَتِ العِبادُ","لِمَن مِنَ المُلوكِ ذا الجَوادُ",6,"د",1,0],["اِختَلَطوا وَعَيَّثوا","كَالعُميِ حَولَ سُفرَةِ",7,"ه",1,0],["اِختَرتَ يَومَ الهَولِ يَومَ وَداعِ","وَنَعاكَ في عَصفِ الرِياحِ الناعي",8,"ع",2,1],["اِختِلافُ النَهارِ وَاللَيلِ يُنسي","اُذكُرا لِيَ الصِبا وَأَيّامَ أُنسي",9,"س",2,1],["أُختُ أَبي خَيرٍ أَميرٍ دَعا","فَقالَ جَيشٌ لِلقَنا لَبِّهِ",10,"ب",2,0],["اِختَرتُ دَهماءَتَينِ يا مَطَرُ","وَمَن لَهُ في الفَضائِلِ الخِيَرُ",11,"ر",1,1],["أختالُ بينُ جآذِرٍ ومَزاهِرٍ","وأرودُ بين دساكِرٍ وَبَواطِي",12,"ط",2,0],["أُختُ بَني شَيبانَ مَرَّت بِنا","مَمشوطَةً كوراً عَلى بَغلِ",13,"ل",1,0],["أَخٌ تَرَكَت أَسِنَّتُهُ أَخاهُ","تَليلاً لِلجَبينِ وَلِليَدَينِ",14,"ن",1,0],["أَخْتَالُ طَوْرَاً فَوْقَ ذِرْوةِ مِنْبَرٍ","وَأَكُرُّ طَوْرَاً فَوْقَ نَهْدٍ شَيْظَمِ",15,"م",1,0],["أختُكِ الوَلْهى عَنَاها شجوُها","وَدَهَى أبناءَها الخطبُ المِلَمّْ",16,"م",1,0],["أُختانِ إِحداهُما إِذا اِنتَحَبَت","تَبكي كَباكٍ بِدَمعَةٍ حَرّى",17,"ر",2,1],["اِختارَها في القِطافِ سائِمُها","حُمراً وَسوداً كَأَنَّها الحَدَقُ",18,"ق",1,0],["اِختَصَمَ الجودُ وَالجَمال","فيكَ فَصارا إِلى جِدال",19,"ل",1,1],["اِختارَ داوُدُ البُكاءَ مَكارِماً","وَاِختَرتَ أَكلَ نَقانِقٍ وَثَريدِ",20,"د",1,0],["أُختُ بَني الصَرِدِ في دَهرِها","أَصابَها سَهمُ رَداً صارِدُ",21,"د",1,0],["إِختِلافٌ قَد عَمَّنا في اِعتِقادٍ","وَصَلاةٍ لِرَبِّنا وَطُهورِ",22,"ر",1,1],["اختبرت الرجال من كل صنف","فإذا الناس كافرٌ أَو شكور",23,"ر",1,0],["اختفى عَن قوم وَخالط قوماً","فأرى الناس خفة ووقارا",24,"ر",2,0],["اختر ما هزّك من شعر","قد قيل فذلك أَجوده",25,"د",2,0],["اخترت من جوف الثرى متبوأً","علّ الثرى لك منزل تشتاق",26,"ق",1,0],["إختار في الظلِّ له مقعدا","في ربوةٍ فاتنةٍ ساحرَهْ",27,"ه",1,0],["أخْتَ روحي قرِّبيها من فمي","إن شربنا أو طربنا ما علينا",28,"ن",2,0],["أُختاهُ هذا الحبُّ غضٌّ صِباهْ","أيُّ عذابٍ صاغ هذي الصورْ",29,"ر",1,0],["أُخْتُنَا شَمْسُ البَنَاتِ الخُرَّدِ","الزُّهْرِ فِي العَصْرِ",30,"ر",1,0],["أُخْتِ الشَّوَادِي الخُضْرِ حَا","نتْ لَفْتَةُ المُتنَوِّعِ",31,"ع",1,0],["أخت الفراشات يلعب","ن حاليات الجناح",32,"ح",1,0],["اِختَطَفتِ اِبنَ اللَباةِ وَلَم","تَحمِهِ الأَظفارُ وَاللِبَدُ",33,"د",1,0],["اِخْتَارَكَ اللّهُ لِلإِسْلاَمِ تَنْصُرُهُ","فَكُنْتَ مَوْثِلَهُ يَا خَيْرَ مُخْتَارِ",34,"ر",1,0],["أختاهُ ! قد أزف النوى فتنعمي","بعدي فإن الحب لن يتكلما",35,"م",2,0],["أختك الشقراء مدت كفها","فاكتسى من كل نجم إصبع",36,"ع",1,0],["اختلتَ في بُرد الزفاف، وفي غد","تختال في برد النبيِّ الهادي",37,"د",2,0],["اختَرْ لنفسِكَ من فُتيَّاتِ القُرى","أهْلاً، فهُنَّ ملائِكٌ أطهار",38,"ر",1,0],["اختزال يجيء إثر اختزال","من قلوب لا تَعْرف الإشفاقا",39,"ق",2,0],["أختال كالسلطان ، حاشيتي الحصى ... تحيتي بلا فخر حصان الوالي","جيشي عفونات الأزقة تحتفي ... حولي ، وراياتي خيوط سعالي",40,"ل",2,0],["أختار هذا ما ترى من رأى","قلبي ركاما ؟ أحسن الاختيار",41,"ر",1,0],["اختار داوود البكاء مكارماً","واخْتَرْتَ أَكْلَ نَقَانِقٍ وثريد",42,"د",1,0],["اختياراً بالبنت سيروا إلى صالحها","قبل أن تسيروا اضطرارا",43,"ر",2,0],["اختبرنا ، إنَّا أسأنا اختباراً","واقتنعنا ، إنا أسأنا اقتناعا",44,"ع",2,0],["أختُ بني الصّاردِ، في دهْرِها","، أصابَها سَهمُ ردًى، صارد",45,"د",1,0],["أُختَ الأزقَّةِ والمضاجعِ والغوى","والغرفةِ المشبوهةِ المتلألِئهْ",46,"ا",2,0],["اخْتَارَكَ اللّهُ للإِسْلاَمِ تَنْصُرُهُ","فَكُنْتَ مَوْئِلَهُ يَا خَيْرَ مُخْتَارِ",47,"ر",1,0],["أختال كالسلطان ، حاشيتي الحصى","تحيتي بلا فخر حصان الوالي",48,"ل",2,0],["اخت تكاد تكون اما برة","فمن الحنان الله طينتها برى",49,"ر",2,0],["أخت الغزالة بنت الشمس ناعس ال","أجفان قتالة العشاق بالحور",50,"ر",1,1],["أخت شمس تبرقعت بدجى الشع","ر فأبدت للناس سراً خفيا",51,"ي",2,0],["أخت الهلالِ أما بقلبكَ رحمة","لمتيم بهوى هواكِ مصابِ",52,"ب",1,0],["أخ توخى المعالي في الصبا فأتى","كالماء ما أثرت فيه يد الكدر",53,"ر",1,0],["اخترت واختار الإِله لك الذي","ترضى وما تختار كان الأحسنا",54,"ن",2,0],["اختر لنفسك واعمل ما تحب لها","لا يحصد المرءُ شيئاً غير مازرعا",55,"ع",2,0],["اختصَّه جعفر الإمام فقد","وُفِّقَ فيما 