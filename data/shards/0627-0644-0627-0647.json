iwan.net/poem67773.html","الطويل"],[518,"أناجيك والهم الدخيل مقيم","https://www.aldiwan.net/poem12264.html","الطويل"],[519,"الا هل من البين المفرق من بد","https://www.aldiwan.net/poem48691.html","الطويل"],[519,"ألا أيها الربع المقيم بعنبب","https://www.aldiwan.net/poem48737.html","الطويل"],[532,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[541,"تأخرت عن صوغ القريض له قصدا","https://www.aldiwan.net/poem48216.html","عموديه"],[554,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[554,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[554,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[554,"أرى عزة من بين أثناء ذلة","https://www.aldiwan.net/poem48027.html","الطويل"],[554,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[554,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[561,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[561,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[561,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[561,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"],[561,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[564,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[578,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[589,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/18845","الطويل"],[696,"","https://poetry.dctabudhabi.ae/diwan/poem/202220","الطويل"],[709,"","https://poetry.dctabudhabi.ae/diwan/poem/1899","الطويل"],[734,"","https://poetry.dctabudhabi.ae/diwan/poem/22610","الوافر"],[740,"","https://poetry.dctabudhabi.ae/diwan/poem/29431","الطويل"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/29559","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/22609","الطويل"],[934,"","https://poetry.dctabudhabi.ae/diwan/poem/202196","الطويل"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9610","الطويل"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18758","الطويل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18721","الطويل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18757","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75818","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[1117,"","https://poetry.dctabudhabi.ae/diwan/poem/202302","الطويل"],[1124,"","https://poetry.dctabudhabi.ae/diwan/poem/52","الطويل"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18973","الطويل"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/18201","الطويل"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/18204","الطويل"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/18773","الطويل"],[1189,"","https://poetry.dctabudhabi.ae/diwan/poem/89644","الطويل"],[1094,"أَلا هَل أَتى ذات القَلائد فرتى","https://www.poetsgate.com/ViewPoem.aspx?id=8287",""],[940,"لِمَن طَلَلٌ ، مِثلُ الكِتابِ المُنمَّقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24236&r=&rc=2",""]],"verses":[["أَلا هَل أَطرُقُ السَمُراتِ يَوماً","بِريءَ القَلبِ مِن عَنَتِ الهُمومِ",0,"م",1,0],["أَلا هَل لِحُبٍّ فاتَ أُولاهُ رَجعَةَ","وَإِن زادَ عِندي أَو تَضاعَفَ إِسمُهُ",1,"م",2,0],["أَلا هَل إِلى ظِلِّ الأَثيلِ تَخَلُّصٌ","وَهَل لِثَنَيّاتِ الغُوَيرِ طُلوعُ",2,"ع",1,0],["أَلا هَل أُخيضُ الطِرفَ يَوماً بِغَمرَةٍ","إِذا الخَيلُ بِالغُرِّ الوُجوهِ تَمَطَّتِ",3,"ت",1,0],["أَلا هَل تَرُدُّ الريحُ يا جَوَّ ضارِجٍ","نَسيمَكَ يَحلولي لَنا وَيَطيبُ",4,"ب",1,0],["أَلا هَلْ يُفيقُ الدَّهْرُ مِنْ سَكراتِهِ","وَيَرْفَضُّ عَن أَجْفانِهِ طارِقُ الحُلْمِ",5,"م",1,1],["أَلا هَلْ إِلى أَرْضٍ بِها أُمُّ سالِمٍ","وُصولٌ لِطاوي شُقَّةٍ وَبَلاغُ",6,"غ",1,1],["أَلا هَل أَتاها أَنَّ يَومَ عُراعِرٍ","شَفى سَقَماً لَو كانَتِ النَفسُ تَشتَفي",7,"ف",2,1],["أَلا هَل تُرى إِن شَطَّ عَنّي مَزارُه","وَأَزعَجُها عَن أَهلِها الآنَ مُزعِجُ",8,"ج",1,0],["أَلا هَل إِلى قَلبي سَبيلٌ لَعَلَّني","أُمِرُّ جَناحَيهِ عَلى القَصِّ وَالنَتفِ",9,"ف",1,0],["ألا هَكذا فلْيُحْرِز المَجْدَ ربُّهُ","وتُبْنى المَعالي أوْ تُرَبّى الصّنائِعُ",10,"ع",1,0],["أَلاَ هَكَذَا تُبْنَى الْمَدَارِسُ لِلْعِلْمِ","وَتَبْقَى عُهُودُ الْمَجْدِ ثَابِتَةُ الرَّسْمِ",11,"م",1,1],["إِلّا هَوانَكَ إِذ رَأَت","مِن دونِها باباً وَدارَه",12,"ر",2,0],["أَلا هَل إِلى الزَهراءِ أَوبَةُ نازِحٍ","تَقَضّى تَنائيها مَدامِعَهُ نَزحا",13,"ح",2,0],["أَلا هَل أَتى الفِتيانُ أَنَّ فَتاهُم","فَريسَةُ مَن يَعدو وَنُهزَةُ مَن يَسطو",14,"ط",2,0],["أَلا هَل جاءَ مَن فارَقتُ أَنّي","بِساحاتِ المُنى رَفلُ المَراحِ",15,"ح",1,0],["أَلا هَل دَرى الداعي المُثَوِّبُ إِذ دَعا","بِنَعيِكَ أَنَّ الدينَ مِن بَعضِ ما نَعى",16,"ع",2,1],["أَلا هَل سَبيلٌ إِلى العَيبِ فيهِ","فَكَم عينَ مِن قَبلِهِ مَن كَمَل",17,"ل",1,0],["أَلا هَل أَتى بِنتَ الثُوَيرِ مَغارُن","عَلى حَيِّ كَلبٍ وَالضُحى لَم تَرَحَّلِ",18,"ل",1,1],["أَلا هُبّي بِصَحنِكِ فَاَصبَحين","وَلا تُبقي خُمورَ الأَندَرينا",19,"ن",2,1],["أَلا هَل تَرجِعَنَّ لَنا اللَيالي","وَأَيّامٌ لَنا بِلِوى الشَقيقِ",20,"ق",1,0],["أَلا هَل إِلى مَيٍّ سَبِيلٌ وَساعَةٌ","تُكَلِّمُني فيها شِفاءٌ لِما بِيا",21,"ي",2,1],["أَلا هَل تَرى الأَظعانَ جاوَزنَ مُشرِفاً","مِنَ الرَملِ أَو حاذَت بِهِنَّ سَلاسِلُه",22,"ل",2,0],["أَلا هَل تَرى أَظعانَ مَيٍّ كَأَنَّها","ذُرى أَثأُبٍ راشَ الغُصونَ شَكيرُها",23,"ر",3,0],["ألا هكذا فليعقد الفخرُ تاجَه","ويسمو إلى أوج العلا ويطاولُ",24,"ل",1,0],["ألا هل تسمعون فإن عندي","حديثاً عن مواطنكم خطيرا",25,"ر",2,0],["أَلا هَل لِلخَليفَةِ في نِزارٍ","فَقَد أَمسَوا وَأَكثَرُهُم كُلولُ",26,"ل",1,0],["ألا هَل عَمِّ في رَأيه مُتَأمِلُ","وَهَل مُدبِرٌ بَعدَ الإِسَاءَةِ مُقبِلُ",27,"ل",1,1],["أَلا هَل مُنكِرٌ يا اِبنَي نِزارٍ","مَقامي يَومَ ذَلِكَ أَو مَقالي",28,"ل",2,0],["ألا هلْ لأيام تعلَّلْتُ عيشها","بها عودةٌ أم ليس دهرٌ بعائدِ",29,"د",1,0],["ألا هاتيكم العليا","ء والفخر لدى الفخر",30,"ر",1,0],["ألا هكذا فليمنع اليوم من غد","وإلا فلا يا من يريد صنيعا",31,"ع",2,0],["ألا هَبَلتْ أمُّ المعادِيه نفسهُ","وأين امرؤ عاداه إلا ابن هابلِ",32,"ل",1,0],["ألا هبلتْ أمُّ المعادِيه نفسه","وأيُّ امرئ عاداه إلا ابن هابلِ",33,"ل",1,0],["أَلا هَل أَتى أُمَّ الحُوَيرِثِ مُرسَلٌ","نَعَم خالِدٌ إِن لَم تَعُقهُ العَوائِقُ",34,"ق",1,1],["أَلا هَكَذا فَليُحسِنِ القَولَ قائِلٌ","وَمِثلُ صَلاحِ الدينِ قَد قَلَّ سُلطانُ",35,"ن",1,0],["أَلا هَل أَتى عَنّا سُعادَ وَدونَها","مَهامِهُ بيدٍ تَعتَلي بالصَعالِكِ",36,"ك",1,1],["أَلا هَل لعَهدٍ مِن بُثَينَة قَد خَلا","وَأورثَ شَجواً لا يُريمُك مِن رَدِّ",37,"د",1,1],["أَلا هَل إِلى إِلمامَةٍ أَن أُلِمَّها","بُثَينَةُ يَوماً في الحَياةِ سَبيلُ",38,"ل",1,1],["أَلا هَل لنا من بعد هذا التفرّق","سبيلٌ فيشكو كلّ صبّ بما لقي",39,"ق",2,1],["ألا هل لي بلقياه يدانِ","حبيب شأنه عجب وشأني",40,"ن",2,1],["أَلا هَكَذا الدُنيا وَذَلِكَ وُدُّها","فَهَلّا تَأَتّى في الأَمانِيِّ خاطِبُه",41,"ب",2,0],["أَلا هَل أَتاها أَنَّ مُظلِمَةَ الدُجى","تَجَلَّت وَأَنَّ العَيشَ سُهِّلَ جانِبُه",42,"ب",2,0],["أَلا هَل أَتاها بِالمَغيبِ سَلامي","وَهَل خُبِّرَت وَجدي بِها وَغَرامي",43,"م",2,1],["أَلا هَل يَحسُنُ العَيشُ","لَنا مِثلُ الَّذي كَنا",44,"ن",2,1],["أَلا هَل لِلَيلى في الفِداءِ فَإِنَّني","أَرى رَهنَ لَيلى لا تُبالي أَواصِرُه",45,"ر",2,0],["أَلا هَل عَلِمتُم مَيِّتاً قَبلَ غالِبٍ","قَرى مِئَةً ضَيفاً وَلَم يَتَكَلَّمِ",46,"م",1,0],["أَلا هَل لِعُلوِيٍّ الرِياحِ هُبوبُ","فَيُخبِرنَ هَل عَهدُ المزارِ قَرِيبُ",47,"ب",1,1],["أَلا هَل عَلى زَمَني مُسعَدُ","وَأَنّى وَقَد ذَهَبَ الأَجوَدُ",48,"د",1,1],["أَلا هَل إِلى طولِ الحَياةِ سَبيلُ","وَأَنّي وَهَذا المَوتُ لَيسَ يُقيلُ",49,"ل",1,1],["أَلا هَل إِلى الفِردَوسِ مِن مُتَشَوِّقٍ","تَحِنُّ إِلَيها نَفسُهُ وَإِلى عَدنِ",50,"ن",1,0],["أَلا هَل هاجَكَ الأَظعا","نُ إِذ جاوَزنَ مُطَّلَحا",51,"ح",2,1],["أَلا هَل إِلى أَرضِ الجَزيرَةِ أَوبَةٌ","فَأَسكُنَ أَنفاساً وَأَهدَأَ مَضجَعا",52,"ع",2,0],["أَلا هَل أَطَلَّ الأَميرُ الأَجَلُّ","أَمِ الشَمسُ حُلَّت بِرَأسِ الحَمَل",53,"ل",1,1],["أَلا هَل إِلى شَمِّ الخُزامى وَنَظرَةٍ","إِلى قَرقَري قَبلَ المَماتِ سَبيلُ",54,"ل",1,1],["أَلا هَل إِلى لَيلى قُبَيلَ مَنِيَّتي","سَبيلٌ وَهَل لِلناجِعينِ رُجوعُ",55,"ع",1,0],["أَلا هَل طُلوعُ الشَمسِ يُهدي تَحيَّةً","إِلى آلِ لَيلى مَرَّةً أَو غُروبُها",56,"ب",3,1],["أَلاَ هِمَّةٌ بدريَّةٌ تكشفُ الأَذَى","وتشفِي من الهَمِّ الذي اهتاج دَاخِلُهْ",57,"ل",2,0],["ألا هدنةٌ فيها من الهمِّ راحةٌ","فإنَّ بنا منه لَداءً مُخامِرا",58,"ر",2,0],["ألا هادٍ يُقَوِّمُ من خُطاها","وَيَحْسِمُ دَاءَها بعد اعْتِلالِ",59,"ل",1,0],["أَلا هَكَذا تُذكَرُ الصالِحاتُ","وَتُبنى المَعالي وَإِلّا فَلا",60,"ل",2,0],["إِلّا هَوىً رَدَّ حَقّي عِندَ باطِلِهِ","حَتّى يَرى الظُلمُ لي مِنهُ يَداً قِبَلي",61,"ل",2,0],["أَلا هَل أَتى الحَسناءَ أَنَّ حَليلَها","تَأَبَّطَ شَرّاً وَاِكتَنَيتُ أَبا وَهبِ",62,"ب",1,1],["أَلا هَبَّت أُمامَةُ بَعدَ هَدءٍ","عَلى لَومي وَما قَضَّت كَراها",63,"ا",3,1],["أَلا هَل لِسَهمٍ في الحَياةِ فَإِنَّني","أَرى الحَربَ عَن روقٍ كَوالِحَ فُرَّتِ",64,"ت",1,0],["أَلا هَبَّت أُمامَةُ بَعدَ هَدءٍ","تُعاتِبُني وَتَجبَهُني بِظُلمِ",65,"م",1,1],["أَلا هَل تَرَوا ما قَد رَأى مِن مُعاشِرٍ","لَهُم فِيَّ حُكمٌ يَهجُرُ الحَقَّ مُشتَطُّ",66,"ط",1,0],["ألا هكذا فيسعدِ الصنوُ صِنوَهُ","فذا سيِّدٌ ندبٌ وذا سيدٌ قَرمُ",67,"م",1,0],["ألا هكذا فَلْيُهْدِ مَن قاد عسكرا","وأوردَ عن رأي الإمام وأصدَرا",68,"ر",2,1],["ألا هكذا فلتُجْلَبِ العِيسُ بُدَّناً","ألا هكذا فلتُجنَبِ الخيلُ ضُمَّرا",68,"ر",2,0],["ألا هل أتاهُمْ أنّ ثغرَكَ مُوصَدٌ","وليسَ له إلاّ الرماحَ وصِيد",69,"د",1,0],["أَلا هَل عَلى اللَيلِ الطَويلِ مُعينُ","إِذا بَعُدَت دارٌ وَشَطَّ قَرينُ",70,"ن",1,1],["أَلا هَذا اليَقينُ فَخُذهُ مِنّي","وَدَع لِمُمَوِّهٍ ما باتَ يَفري",71,"ر",2,0],["أَلا هَل أَتى قَبرَ الفَقيرَةِ طارِقٌ","يُخَبِّرُها بِالغَيبِ عَن فِعلِ طارِقِ",72,"ق",1,1],["أَلا هَل رَأَت هَذي الفَراقِدُ رُمِيَنا","فَراقِدَ في وَحشٍ رَعى الوَحشَ آزِلُه",73,"ل",2,0],["ألأهل الجحيم بؤسٌ وتعسٌ","ولمن حلَّ في الجنانِ سرور",74,"ر",1,0],["الأهلُ أهْلُك يا أميرُ كما تَرَى","والدَّارُ دارُكَ قُبَّةً وعِمَادَا",75,"د",2,0],["أَلا هَل أَتى بِنتَ الثُوَيرِ مَغارُنا","عَلى حَيِّ كَلبٍ وَالضُحى لَم تَرَحَّلِ",76,"ل",1,1],["أَلا هُبّي بِصَحنِكِ فَاَصبَحينا","وَلا تُبقي خُمورَ الأَندَرينا",77,"ن",2,1],["أَلا هَل تُرى إِن شَطَّ عَنّي مَزارُها","وَأَزعَجُها عَن أَهلِها الآنَ مُزعِجُ",78,"ج",1,0],["ألاَ هَبَلَتكَ أُمُّكَ عَمُرو بَعدي","أَتقعُدُ لا أُفَكُّ ولا تَصولُ",79,"ل",1,0],["أَلا هَتَفَتْ بِالأَيْكِ سَاجِعَةُ الْقُمْرِ","فَطُفْ بِالْحُمَيَّا فَهْيَ رَيْحَانَةُ الْعُمْرِ",80,"ر",1,1],["أَلاَ هَلْ تَرَكْتُمْ يَا لَقَوْمِي فَضِيلَة","تَبِيتُ مِنَ الحُسَّادِ يَوْماً بِمَعْزِلِ",81,"ل",1,1],["ألاَ هَلْ أَتَى غَسَّانَ في نَأْيِ دَارِهَا","وَأَخْبَرُ شَيءٍ بالأُمُورِ عَليمُها",82,"م",3,1],["ألا هَلْ أَتَى أَفْنَاءَ فهرِ بن مَالكٍ","مقطّعُ أطرافٍ وَهَامٌ مفلّقُ",83,"ق",1,0],["أَلا هَلْ أتى غَسّانَ عنّا ودونَهُمْ","مِنَ الأَرضِ خَرْقٌ سَيْرُهُ مُتَنعْنِعُ",84,"ع",1,1],["ألا هل لداعي الله في الأرض سامع","فاني بأمر الله يا قوم صادع",85,"ع",1,1],["ألا هل أراني مُرسِلاً في شكيمتي","تُصرَّف كفّي كيف شاءت عنانيا",86,"ي",2,0],["ألا هل تعودُ الدارُ بعد تشتُّتٍ","ويُجْمَعُ هذا الشملُ بعدَ تفرُّق",87,"ق",1,0],["ألا هل يعودُ الشعر فينا كأنه","من الظهر يملى عن غيُوث رواشِح",88,"ح",1,0],["ألا هل أتاكم بأني متى","تدر كأس حبّكم أحتس",89,"س",1,0],["ألا هِزَّةً تستثيرُ الشّعوب","فقد يُدْرِكُ النَّهْزَةَ الثائرونا",90,"ن",2,0],["ألا هَلْ أتى نوَّماً في العراقِ","أنَّا للأجلِهِمُ ساهرونا",90,"ن",2,0],["ألا هلْ يَحْسُنُ العَيْشُ","لنَا، مِثْلَ الّذي كانَا",91,"ن",2,1],["ألا هبلتْ أمُّ المعادِيه نفسه","وأيُّ امرىء عاداه إلا ابن هابلِ",92,"ل",1,0],["ألا هل إلى طول الحياة سبيل","وأنى وهذا الموت ليس يحول",93,"ل",1,1],["أَلا هاتَ أَسقني كَأساً فَكَأسا","وَحيّ بِها ثَلاثاً بَل سداسا",94,"س",2,1],["أَلا هَل أَتاهُ ما رَكِبنا سَراتَهُم","وَما قَد عَقَرنَ مِن صَفِيٍّ وَمِن قَرمِ",95,"م",1,0],["أَلا هَل أَتى بَحريَّنا صُنعُ رَبِّنا","عَلى نَأيِهِم وَاللَهُ بِالناسِ أَروَدُ",96,"د",1,1],["ألا هل لهذا البين من آخر فقد","تطاول حتى خلت هذا إلى اللحد",97,"د",1,0],["ألا هل يجود الدهر بعد فراقنا","فيجمعنا والدهر يجري إلى الضد",97,"د",1,0],["إلاَهِي..فاقْتربْ منَّا.... تَجَلَّى","وَأَقْبِلْ... أَيْنَمَا كَانَ الْمَكَانُ",98,"ن",1,0],["أَلا هَل أَتى أَبا حَسّانَ أَنّا","نَعَيناهُ بِأَطرافِ الرِماحِ",99,"ح",1,1],["أَلاَ هَل لأَيَّامٍ تَوَلَّينَ مَطلَبُ","وَهَل عاتِبٌ زارٍ عَلَى الدَّهرِ مُعتَبُ",100,"ب",1,1],["أَلاَ هَل مِن البَينِ المُفَرِّقِ مِن بُدِّ","وَهَل لِلَيَالٍ قَد تَسَلَّفنَ مِن رَدِّ",101,"د",1,1],["أَلاَ هَل أدُلُّ الوارِدَينِ عَشِيَّةً","عَلَى مَشرَبٍ غَيرِ الّذِى يَرِدَانِ",102,"ن",1,0],["أَلاَ هلْ إلى بَرْدِ الأَصائلِ بالحِمىَ","على الرملِ في ظِلِّ الأَراكِ إِيابُ",103,"ب",1,1],["أَلا هلْ لأيامِ الوصالِ تَواصُلٌ","وهل لي إلى سكانِ مِصْر مَصير",104,"ر",1,0],["أَلا هلْ إلى ما أرتجيه بُلوغُ","فكم أَقتضيه الدهرَ وهْو يَروغُ",105,"غ",1,1],["أَلاَ هلْ لدائي من فراقِك إفراقُ","هو السُّمُّ لكنْ في لقائِك دِرْياق",106,"ق",1,1],["أَلاَ هلْ لأيامي بك الغُرِّ عودةٌ","كعهدِي وَثَغْرُ الثغرِ أَشْنَبُ بَرّاق",106,"ق",1,0],["أَلاَ هلْ إلى الإسكندريةِ أَوْبَةٌ","تُبرِّد أشواقي وحَرَّ أُوامى",107,"م",2,0],["أَلا هَل راجِعٌ عَيشٌ تَولّى","وَهَل مُتَبَدّلٌ عَيشٌ تَنكّد",108,"د",1,0],["أَلا هَل بِالأَحِبَّةِ مِن لمامٍ","وَهَل شَملُ السُرورِ بِهم معادُ",109,"د",1,0],["أَلا هَل أَتى عِرسي مَكَرّي وَمَوقِفي","بِوادي حُنَينٍ وَالأَسِنَّةُ تُشرَعُ",110,"ع",1,1],["أَلا هَذِّب شَبابَ الشَرقِ هَذِّب","لِيَرقى مَوطِنٌ لَهُمُ وَيَرقوا",111,"ق",3,0],["ألا هل لألفاظي طريقٌ إلى العذرِ","فدون الذي أوليتني رُتْبةُ الشكرِ",112,"ر",1,1],["أَلاَ هَلْ أَتَى مَعْشَرِي أَنَّنِي","عَلِقْتُ بِتِطْوَانَ عِلْقاً خَطِيرَا",113,"ر",2,0],["الأهل درى الخوَّان أن دويشهم","له فوق متن السحر مأوى ومركب",114,"ب",1,0],["أَلا هَذِهِ أَمُّ الصَبيينِ إِذ رأت","شُحوباً بِضاحي الجِسم مني تهزَّلُ",115,"ل",1,0],["ألا هلْ فؤادي عن صِبا اليومِ صافحُ","وهلْ ما وأتْ ليلى بهِ لكَ ناجحُ",116,"ح",1,1],["أَلا هَل أَتاها كَيفَ ناوَأَ قَومُها","بِجَنبِ قُلابِ إِذ تَدانى القَبائِلُ",117,"ل",1,1],["ألا هَل تَذكُرينَ مساءَ بِتنا","نذوبُ جوىً ألا هَل تَذكُرينا",118,"ن",2,0],["ألا هل عزاءٌ للمُحِبّ الذي يرى","مَنازِلَ أحبابٍ على وحشات",119,"ت",1,0],["ألا هل كقومي أو كمثلِ كبارِهم","إذا عُدَّتِ الأقوامُ والكبراء",120,"ا",2,0],["ألا هَل قُلُوبٌ لِلهَوى بَعدَ قَلبِها","وهل بعدَ عَينَيها عُيونٌ نَواظِر",121,"ر",1,0],["الاهدل الشيخ المبارك جده","وأَبوه سامي الفرع سامى المحتد",122,"د",1,0],["أَلا هَذِهِ الآفاقُ نَحْوَكَ تَرْتَمِي","لِتُدرِك أَقصَى ما تَرُومُ وتَبْلُغَا",123,"غ",2,0],["ألا هُو شِبل البأسِ زارَ هِزَبرَه","فَقرَّ قَرارُ الناسِ منهُ عَلى الزأرِ",124,"ر",1,0],["ألا هَذِه حِمْصٌ تُناسِبُ طاعَة","سِجلماسة في رَفْضِها لِلمناصِبِ",125,"ب",1,0],["أَلا هكَذا فَلْيُحْرِزِ الْحَمْدَ وَالأَجْرا","وَيَحْوِ جَميلَ الذِّكْرِ مَنْ طَلَبَ الذِّكْرا",126,"ر",2,1],["ألا هكَذا تَسْتَهِلُّ الْبُدُورُ","مَحَلٌّ عَلِيٌّ وَوَجْهٌ مُنِيرُ",127,"ر",1,1],["أَلا هَل إِلى الخِلِّ الوَصولِ وُصولُ","فَمِن بَعد ما الصَبرُ الجَميلُ جَميلُ",128,"ل",1,1],["أَلا هَل إِلى بابِ البَريدِ سَبيلُ","فَلَيلي بِزَوراءِ العِراقِ طَويلُ",129,"ل",1,1],["أَلا هَل درت من أَقصَدَت أَسهمُ الهُلكِ","فأَصبح عقدُ المَجد منفصمَ السِّلكِ",130,"ك",1,1],["أَلا هَلْ أَتى شبهَ الجزيرةِ نعْيُهمْ","وَمَنْ كان (قيسيّاً) بها و(يمانيا)",131,"ي",2,0],["أَلا هَذا الّذي منهُ تحيدُ","وَأنتَ لِمثله رهنٌ وحيدُ",132,"د",1,1],["أَلا هاجَ قَلبي العامَ ظُعنٌ بَواكِرٌ","كَما هاجَ مَسحوراً إلى الشَوقِ ساحِرُ",133,"ر",1,1],["ألا هبلت أم الذين غدوا به","إلى القبر ماذا يحملون إلى القبر",134,"ر",1,1],["أَلا هَلكَ الراعي العشيرة ذو الفقدِ","وَساقي الحجيج وَالمحامي عن المجدِ",135,"د",1,1],["أَلا هَل إِلى داري بِوادي طُوَيلِعٍ","وَإِن بَعُدَت بِعدَ الرَحيلِ قُفولُ",136,"ل",1,1],["الأهل أهلي والمكان مكاني","ما كان هجر الدار في إمكاني",137,"ن",2,1],["ألا هل لِقَلب عَنك قَد فَقَد الصَبرا","تَجرّع مُرّ الصَبر يقضي بِهِ صَبرا",138,"ر",2,1],["أَلا هَل أَتى أَهلَ الحِجازِ مُغارُنا","عَلى حَيِّ وَردٍ وَاِبنِ رَيّا المُضَرَّبِ",139,"ب",1,0],["أَلا هَل أَتى أَهلَ الحِجازِ مُغارُنا","وَمِن دونِهِم أَهلُ الجِنابِ فَأَيهَبُ",140,"ب",1,0],["ألا هل إلى نَيْلِ الغنى من وسيلة","يَمُتُّ بها إلاّ السُّيوفُ القَواطع",141,"ع",1,0],["أَلا هَل لِلثامِ الدَه","رِ عَن وَجهِ المُنى حَطُّ",142,"ط",1,0],["أَلا هل أَتاها من نَهَاوَندَ أَنَّني","أُمارسُ أَبطالاً لها وفُيُولا",143,"ل",2,1],["أَلا هَل أَتى الواشينَ أَنا عَلى النَوى","بِطَيفِ الكَرى أَو بِالأَمانِيِّ نَلتَقي",144,"ق",2,0],["إلاه والإحسانُ ملءُ جنانه","حَسبي جَنانٌ ملؤُه الإحسان",145,"ن",1,0],["أَلا هَكَذا فَليَحفَظ المَجدُ أَهلَهُ","وَمثل الَّذي قَد شادَ في المَجد فَليَبني",146,"ن",2,0],["الأهل محب للحبيب محمد","يبلغ عنه شرعه كل جاهل",147,"ل",1,0],["ألاهل سامع فطن حليم","يجيب مسرعاق بل البيات",148,"ت",1,0],["ألا هَل لِهذا الدهر من مُتعلّلٍ","سوى الناس مهما شاء بالناس يفعل",149,"ل",1,1],["إلاهي بهمْ جُدْ بعَفْوٍ عَلَى","أَسِيرٍ بهِ ضَاقَ رحبُ الفَضَا",150,"ض",2,0],["الأهل إلى أكنافها لي عودة","ليصحو قلب من معاصيه سكرانا",151,"ن",2,0],["أَلا هَل لِعَهدِ العامِريَّةِ جاحِدُ","وَعِندي مِن صدق المَوَدَّةِ شاهِدُ",152,"د",1,1],["أَلا هَل لِنَيل المُنى غايَةٌ","فَأَنا إِلى غير قصد نَخُب",153,"ب",1,0],["ألا هَلْ للمتيَّمِ من مُجير","كئيبٍ ذي فؤاد مستطيرِ",154,"ر",1,1],["أَلا هَلَكَ المُلوكُ وَعَبدُ عَمرٍو","وَخُلَّيَت العِراقُ لِمَن بَغاها",155,"ا",3,1],["أَلا هَكَذَا فَلْيَسْمُ للمجدِ مَنْ سَما","ويَحْمِ ذِمارَ الملكِ والدينِ مَنْ حَمى",156,"م",2,1],["ألا هَلْ إِلَى الدُّنيا مَعادٌ وهلْ لَنا","سِوى البحْرِ قَبْرٌ أَوْ سِوى الماءِ أَكْفانُ",157,"ن",1,0],["أَلا هكذا فَلْيَحْفَظِ العَهْدَ حافِظٌ","أَلا هكذا فَلْيَخْلُفِ المُلكَ سُلْطَانُ",157,"ن",1,0],["أَلا هل مبلغ مني رجالاً","نصيحات وبورك من وعاها",158,"ا",3,0],["ألا هل وظلُّ المنَى باردٌ","وقد يُرزَق المرءُ مما حُرِمْ",159,"م",1,0],["ألا هل رُقيةٌ من مسّ دهرٍ","خفيِّ الكيد شيطانِ العُرامَهْ",160,"م",2,0],["إلا هوَى القُربَى ورَعيُ وشائجٍ","بيني وبينك أُحْكِمتْ ووصائلِ",161,"ل",1,0],["ألا هل والمنَى سفَهٌ وحلمٌ","وصادقةٌ تسرّك أو خَدوعُ",162,"ع",1,0],["أَلا هَل أَتى لَيلى عَلى نَأيِ دارِها","بِأَن لَم أُقاتِل يَومَ صَخرٍ مُذَوِّدا",163,"د",2,0],["أَلا هاتِها راحاً لَها ريحُ عَنبَرِ","عَلى حِسِّ طَنبورٍ وَإيقاعِ مَزهَرِ",164,"ر",1,1],["أَلا هاجَ التَذَكُّرُ لِي سَقامَا","وَنُكسَ الدَاءِ والوَجَعَ الغَراما",165,"م",2,1],["ألا هل إلى وصل الحمى جبل رقا","قليب الظبي فالشوق فيه مسوما",166,"م",2,0],["أَلا هَل فُؤادي إِذ صَبا اليَومَ نازِعُ","وَهَل عَيشُنا الماضي الَّذي زالَ رايِعُ",167,"ع",1,1],["ألا هل مبلغ هَمَذانَ أني","وردت الفلك من جهة السوافي",168,"ف",2,0],["ألا هَل نَسِيمِ لِلرُّصافي مُبلغُ","تَحِيّة مُشتَاقٍ يُفَتِّقُها زَهرَا",169,"ر",2,1],["ألا هل إلى نجدٍ وماءٍ بقاعها","سبيل وأرواحٍ بها عطرات",170,"ت",1,0],["ألا هل له عطف علي فإنني","فقير إلى ما اعتدت منه عديم",171,"م",1,0],["ألا هب لنا من حية الهم رقية","فإنك من ليل السليم سليم",171,"م",1,0],["الا هل مِن البَين المفرِّق من بُدِّ","وَهل مِثل أَيّام بِمنقطع السَعد",172,"د",1,1],["الا هَل اِتى الصَقر اِبن مَروان أَنَّني","أَرَدُّ لَدى الاِبوابِ عَنهُ وَاِحجب",173,"ب",1,0],["أَلاَ هَكَذا مَنْ يَرُومُ الْفَخَارا","ويَبْغي بُلوغَ الْمُنَى والْقُصَارى",174,"ر",2,1],["ألا هَكَذا مَنْ يَرومُ الْعُلَى","ألا هَكَذا من يَرومُ الْفَخارا",174,"ر",2,0],["ألا هكذا تسمُو الملوكُ بِشعبِهم","فيشكرُهم شُكرا على ما لَه أسدَى",175,"د",2,0],["ألا هلْ أرى في أرضِ بابِلَ أَدْرُعاً","تصول بأسيافٍ رِقاقٍ بواتِكِ",176,"ك",1,0],["أَلا هَلْ أراها ثائراتٍ كأنّما","تَعلّقْنَ في أوراكهنَّ الأراقطا",177,"ط",2,0],["ألا هلْ أتاها كيف حُزنِيَ بعدها","وأنّ دموعي لست أملك رَدّها",178,"د",3,1],["أَلا هنّ صُنعٌ من عزيزٍ مُقدِّرٍ","أَخوذٍ على أيدِي الرّجالِ موقِّتِ",179,"ت",1,0],["أَلا هَل لما فات من مطلبِ","وهل عن ردَى المرءِ من مَهرَبِ",180,"ب",1,1],["أَلا هَرباً مِنَ الإِخوانِ جَمعاً","فَما لكَ مِنهُمُ إِلّا النُّدُوبُ",181,"ب",1,0],["ألا هل أنت بهجة وجه سلمى","بدت فتحير القلب الولوع",182,"ع",1,0],["ألا هكذا فافهم كلام إلهنا","فإن كلام الله يطوَى وينشر",183,"ر",1,0],["ألا هكذا الآفاق فانظر جميعها","ونفسك لا يغررك زيد ولا عمرو",184,"ر",2,0],["ألا هكذا في النار حال أولي الشقا","غداً بعد تحويل الحجاب عن الرب",185,"ب",1,0],["ألا هلموا نحونا لتعلموا","علم اليقين صورة المرائي",186,"ا",2,0],["إِلّا هَوى عَدُوُّهُم لِلكَلكلِ","أَو لِقَفاهُ بِالحَضيضِ الأَسفَلِ",187,"ل",1,0],["أَلاَ هذه العلياءُ لاَ انْحطَّ أُفْقُها","وذَا المَجْدُ لا غَابتْ عن النَّاسِ زُهْرُه",188,"ر",2,0],["إِلَّا هَواكَ وَأَنْتَ فِيها أَدَّعِي","أَدْرَى بِأَنِّي عَنْهُ لَمْ أَكُ أَنْكَفِي",189,"ف",2,0],["أَلا هَل أَتاها أَن بِالرَيِّ مَعشَراً","شَعوا مَنعَماً لَمّا اِستَجاشوا وَقَنبَلوا",190,"ل",3,1],["ألا هل أتاها أن شكة حازم","لدي وأني قد ركبت شموسا",191,"س",2,1],["أَلا هَل أَتى ذُبيانَ أَنَّ رِماحَنا","بِكُشيَةَ عالَتها الجِراحَةُ وَالحَدُّ",192,"د",1,0],["أَلا هَل آتى القَبائِلَ مِن بَكيلٍ","وَأَفنا حاشِدٍ خَبَرُ الخَبيرِ",193,"ر",1,1],["أَلا هَل أَتاها أَنَّ شِكَّةَ حازِمٍ","لَدَيَّ وَأَنّي قَد صَنَعتُ الشَموسا",194,"س",2,1],["أَلا هَل أَتى أُمَّ الصَبِيَّينِ أَنَّني","عَلى نَأيِها حِملٌ عَلى الحَيِّ مُقعَدُ",195,"د",1,0],["أَلا هيّما مِمّا لَقيتُ وَهيّما","وَويحاً لِمَن لَم أَلقَ مِنهُن وَيحَما",196,"م",2,1],["أَلا هَل صَدى أُمّ الوَليدِ مُكَلِّمٌ","صَدايَ إِذا ما كُنتُ رَمساً وأَعظَما",196,"م",2,0],["أَلا هَل أَتى حَيَّ الكَلاعِ وَيَحصِباً","وَأَهلَ العُلا مِن حاشِدٍ وَبَكيلِ",197,"ل",1,1],["ألا هل شباب يشترى بعجيب","بألف قلوص أو بألف نجيب",198,"ب",1,1],["أَلا هَل أَتَت أَنباؤُنا أَهلَ مَأرِبٍ","كَما قَد أَتَت أَهلَ الدَنا وَالخَوَرنَقِ",199,"ق",1,0],["أَلا هَل أَتى أَفناءَ خِندِفَ كُلَّها","وَعَيلانَ إِذ ضَمَّ الخَميسَينِ يَترَبُ",200,"ب",1,0],["أَلا هَل أَتاها وَالأَحاديثُ جَمَّةَ","مُغَلغَةً أَبناءَ جَيشِ اللَهازِمِ",201,"م",1,1],["أَلا هَلَ أَتى غَوثاً وَمازِنَ أَنَّني","حَلَلتُ إِلى البيضِ الطِوالِ السَواعِدِ",202,"د",1,1],["أَلا هَل أَتى غَوثاً وَرومانَ أَنَّنا","صَبَحنا بَني ذُبيانَ إِحدى العَظائِمِ",203,"م",1,1],["أَلا هَلْ أتى ذاتَ الخواتِم فَرِّتْي","عَشِيَّةَ بَيْنَ الجُرْفِ والنَّجْدِ مِنْ يَعْرِ",204,"ر",1,1],["أَلاهَلَ اَتاكَ والأَنْباُء تُنْميِ","طَوالِعَِ بَيْنَ مُبْتَكِرٍ وسَارِ",205,"ر",1,0],["ألا هل لمن أجرى ثمانين حجة","إلى مئة عيش وقد بلغ المدى",206,"ا",1,1],["أَلا هَل لِلهُمومِ مِن اِنفِراجِ","وِهَل لي مِن رُكوبِ البَحرِ ناجِ",207,"ج",1,1],["أَلا هَل أَتى فِتيانَ قَومي أَنَّني","تَسَمَّيتُ لَمّا إِشتَدَّتِ الحَربُ زَينَبا",208,"ب",2,1],["أَلا هَل أَتى أَفناءَ قَيسٍ وَخِندِفٍ","بِما لَقِيَت كَعبٌ وَحَيُّ كِلابِ",209,"ب",1,1],["أَلا هَل أَتى بَكرَ السَوادِ اِبنَ وائِلٍ","لِما بَلَغَت بِالساجِسِيِّ بَنوا بَدرِ",210,"ر",1,1],["أَلا هَل أَتاها أَنَّ دَجلَةَ ذَلَّلَت","عَلى ساعةٍ فيها القُلوبُ تُقَلَّبُ",211,"ب",1,1],["الأَهل أَتى عنا حِجازيَّ قومِنا","عَلى النأي أَبناءَ الخَميسِ العَرَمرَمِ",212,"م",1,0],["أَلا هَل أَتى ذات القَلائد فرتى","عشية بين الجرف وَالبحر من بعر",213,"ر",1,1],["ألاَ، هل أتتْ أنباؤها أهلَ مأربٍ","كما قَد أَتَتْ أَهلَ الدَّنا والخَوَرنَقِ",214,"ق",1,0]]}