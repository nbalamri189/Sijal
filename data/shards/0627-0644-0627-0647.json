{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"ألا يا غزال الرمل من بطن وجرة","https://www.aldiwan.net/poem30120.html","الطويل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[53,"سما كبطون الأتن ريعان عارض","https://www.aldiwan.net/poem30703.html","الطويل"],[63,"ألا هل يفيق الدهر من سكراته","https://www.aldiwan.net/poem45912.html","الطويل"],[63,"ألا هل إلى أرض بها أم سالم","https://www.aldiwan.net/poem45915.html","الطويل"],[3,"ألا هل أتاها أن يوم عراعر","https://www.aldiwan.net/poem103.html",""],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[55,"سرى طيف فوز آخر الليل بالطف","https://www.aldiwan.net/poem26241.html","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[77,"ألا هكذا تبنى المدارس للعلم","https://www.aldiwan.net/poem36089.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[73,"خليلي لا فطر يسر ولا أضحى","https://www.aldiwan.net/poem11843.html","الطويل"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[73,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[5,"ألا هل أتى بنت الثوير مغارن","https://www.aldiwan.net/poem304.html",""],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[30,"ألا هل إلى مي سبيل وساعة","https://www.aldiwan.net/poem29427.html","الطويل"],[30,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[88,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[27,"علام تلوم عاذلة جهول","https://www.aldiwan.net/poem5960.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"سألتك إغنائي عن الناس كلهم","https://www.aldiwan.net/poem65414.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"إذا ما جلته الحرب أعرض رمحه","https://www.aldiwan.net/poem66001.html","الطويل"],[26,"ألا هل أتى أم الحويرث مرسل","https://www.aldiwan.net/poem24081.html","الطويل"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[12,"ألا هل أتى عنا سعاد ودونها","https://www.aldiwan.net/poem1218.html",""],[32,"ألا هل لعهد من بثينة قد خلا","https://www.aldiwan.net/poem27711.html","الطويل"],[32,"ألا هل إلى إلمامة أن ألمها","https://www.aldiwan.net/poem27810.html","الطويل"],[79,"ألا هل لنا من بعد هذا التفرق","https://www.aldiwan.net/poem29564.html","الطويل"],[85,"ألا هل لي بلقياه يدانِ","https://www.aldiwan.net/poem7802.html","الوافر"],[85,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[45,"يجانبنا في الحب من لا نجانبه","https://www.aldiwan.net/poem10904.html","الطويل"],[45,"ألا هل أتاها بالمغيب سلامي","https://www.aldiwan.net/poem65670.html","الطويل"],[45,"ألا هل يحسن العيش","https://www.aldiwan.net/poem66838.html","الهزج"],[28,"حوارية بين الفراتين دارها","https://www.aldiwan.net/poem5078.html","الطويل"],[28,"ينام الطريد بعدها نومة الضحى","https://www.aldiwan.net/poem5509.html","الطويل"],[61,"ألا هل لعلوي الرياح هبوب","https://www.aldiwan.net/poem51840.html","الطويل"],[49,"ألا هل على زمني مسعد","https://www.aldiwan.net/poem62050.html","المتقارب"],[49,"ألا هل إلى طول الحياة سبيل","https://www.aldiwan.net/poem63078.html","البسيط"],[49,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[31,"ألا هل هاجك الأظعان إذ","https://www.aldiwan.net/poem42591.html","مجزوء الوافر"],[74,"أجبت وقد نادى الغرام فأسمعا","https://www.aldiwan.net/poem13172.html","الطويل"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[33,"ألا هل إلى شم الخزامى ونظرة","https://www.aldiwan.net/poem25849.html","الطويل"],[33,"أيا حرجات الحي حين تحملوا","https://www.aldiwan.net/poem25879.html","الطويل"],[33,"ألا هل طلوع الشمس يهدي تحية","https://www.aldiwan.net/poem25999.html","الطويل"],[105,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[105,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[105,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[81,"يا مرهبي دون سلطان يصول به","https://www.aldiwan.net/poem61499.html","البسيط"],[13,"ألا هل أتى الحسناء أن حليلها","https://www.aldiwan.net/poem2235.html","الطويل"],[22,"ألا هبت أمامة بعد هدء","https://www.aldiwan.net/poem21646.html","الوافر"],[22,"أشاقتك ليلى في اللمام وما جزت","https://www.aldiwan.net/poem21660.html","الطويل"],[22,"ألا هبت أمامة بعد هدء","https://www.aldiwan.net/poem21664.html","الوافر"],[52,"ألا تريان البرق ما هو صانع","https://www.aldiwan.net/poem26872.html","الطويل"],[75,"شكا ما شكوت الرمح والنصل والسهم","https://www.aldiwan.net/poem69019.html","الطويل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"ألا هل على الليل الطويل معين","https://www.aldiwan.net/poem66104.html","الطويل"],[46,"سئمت الكون في مصر وكفر","https://www.aldiwan.net/poem22677.html","الوافر"],[46,"ألا هل أتى قبر الفقيرة طارق","https://www.aldiwan.net/poem23048.html","الطويل"],[46,"عجبت لملبوس الحرير وإنما","https://www.aldiwan.net/poem23128.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6814","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9903","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20981","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55120","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67343","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67329","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[90,"الذكرى المؤلمة","https://www.poetsgate.com/ViewPoem.aspx?id=179016",""],[90,"على مجلسي","https://www.poetsgate.com/ViewPoem.aspx?id=179010",""],[90,"بين النجف وأمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=178944",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[45,"ألا هلْ يَحْسُنُ العَيْشُ","https://www.poetsgate.com/ViewPoem.aspx?id=31657",""],[51,"إذا ما جلتهُ الحربُ أعرضَ رمحُه","https://www.poetsgate.com/ViewPoem.aspx?id=30329",""],[58,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""]],"verses":[["أَلا هَل أَطرُقُ السَمُراتِ يَوماً","بِريءَ القَلبِ مِن عَنَتِ الهُمومِ",0,"م",1,0],["أَلا هَل لِحُبٍّ فاتَ أُولاهُ رَجعَةَ","وَإِن زادَ عِندي أَو تَضاعَفَ إِسمُهُ",1,"م",2,0],["أَلا هَل إِلى ظِلِّ الأَثيلِ تَخَلُّصٌ","وَهَل لِثَنَيّاتِ الغُوَيرِ طُلوعُ",2,"ع",1,0],["أَلا هَل أُخيضُ الطِرفَ يَوماً بِغَمرَةٍ","إِذا الخَيلُ بِالغُرِّ الوُجوهِ تَمَطَّتِ",3,"ت",1,0],["أَلا هَل تَرُدُّ الريحُ يا جَوَّ ضارِجٍ","نَسيمَكَ يَحلولي لَنا وَيَطيبُ",4,"ب",1,0],["أَلا هَلْ يُفيقُ الدَّهْرُ مِنْ سَكراتِهِ","وَيَرْفَضُّ عَن أَجْفانِهِ طارِقُ الحُلْمِ",5,"م",1,1],["أَلا هَلْ إِلى أَرْضٍ بِها أُمُّ سالِمٍ","وُصولٌ لِطاوي شُقَّةٍ وَبَلاغُ",6,"غ",1,1],["أَلا هَل أَتاها أَنَّ يَومَ عُراعِرٍ","شَفى سَقَماً لَو كانَتِ النَفسُ تَشتَفي",7,"ف",2,1],["أَلا هَل تُرى إِن شَطَّ عَنّي مَزارُه","وَأَزعَجُها عَن أَهلِها الآنَ مُزعِجُ",8,"ج",1,0],["أَلا هَل إِلى قَلبي سَبيلٌ لَعَلَّني","أُمِرُّ جَناحَيهِ عَلى القَصِّ وَالنَتفِ",9,"ف",1,0],["ألا هَكذا فلْيُحْرِز المَجْدَ ربُّهُ","وتُبْنى المَعالي أوْ تُرَبّى الصّنائِعُ",10,"ع",1,0],["أَلاَ هَكَذَا تُبْنَى الْمَدَارِسُ لِلْعِلْمِ","وَتَبْقَى عُهُودُ الْمَجْدِ ثَابِتَةُ الرَّسْمِ",11,"م",1,1],["إِلّا هَوانَكَ إِذ رَأَت","مِن دونِها باباً وَدارَه",12,"ر",2,0],["أَلا هَل إِلى الزَهراءِ أَوبَةُ نازِحٍ","تَقَضّى تَنائيها مَدامِعَهُ نَزحا",13,"ح",2,0],["أَلا هَل أَتى الفِتيانُ أَنَّ فَتاهُم","فَريسَةُ مَن يَعدو وَنُهزَةُ مَن يَسطو",14,"ط",2,0],["أَلا هَل جاءَ مَن فارَقتُ أَنّي","بِساحاتِ المُنى رَفلُ المَراحِ",15,"ح",1,0],["أَلا هَل دَرى الداعي المُثَوِّبُ إِذ دَعا","بِنَعيِكَ أَنَّ الدينَ مِن بَعضِ ما نَعى",16,"ع",2,1],["أَلا هَل سَبيلٌ إِلى العَيبِ فيهِ","فَكَم عينَ مِن قَبلِهِ مَن كَمَل",17,"ل",1,0],["أَلا هَل أَتى بِنتَ الثُوَيرِ مَغارُن","عَلى حَيِّ كَلبٍ وَالضُحى لَم تَرَحَّلِ",18,"ل",1,1],["أَلا هُبّي بِصَحنِكِ فَاَصبَحين","وَلا تُبقي خُمورَ الأَندَرينا",19,"ن",2,1],["أَلا هَل تَرجِعَنَّ لَنا اللَيالي","وَأَيّامٌ لَنا بِلِوى الشَقيقِ",20,"ق",1,0],["أَلا هَل إِلى مَيٍّ سَبِيلٌ وَساعَةٌ","تُكَلِّمُني فيها شِفاءٌ لِما بِيا",21,"ي",2,1],["أَلا هَل تَرى الأَظعانَ جاوَزنَ مُشرِفاً","مِنَ الرَملِ أَو حاذَت بِهِنَّ سَلاسِلُه",22,"ل",2,0],["أَلا هَل تَرى أَظعانَ مَيٍّ كَأَنَّها","ذُرى أَثأُبٍ راشَ الغُصونَ شَكيرُها",23,"ر",3,0],["ألا هكذا فليعقد الفخرُ تاجَه","ويسمو إلى أوج العلا ويطاولُ",24,"ل",1,0],["ألا هل تسمعون فإن عندي","حديثاً عن مواطنكم خطيرا",25,"ر",2,0],["أَلا هَل لِلخَليفَةِ في نِزارٍ","فَقَد أَمسَوا وَأَكثَرُهُم كُلولُ",26,"ل",1,0],["ألا هَل عَمِّ في رَأيه مُتَأمِلُ","وَهَل مُدبِرٌ بَعدَ الإِسَاءَةِ مُقبِلُ",27,"ل",1,1],["أَلا هَل مُنكِرٌ يا اِبنَي نِزارٍ","مَقامي يَومَ ذَلِكَ أَو مَقالي",28,"ي",1,0],["ألا هلْ لأيام تعلَّلْتُ عيشها","بها عودةٌ أم ليس دهرٌ بعائدِ",29,"د",1,0],["ألا هاتيكم العليا","ء والفخر لدى الفخر",30,"ر",1,0],["ألا هكذا فليمنع اليوم من غد","وإلا فلا يا من يريد صنيعا",31,"ع",2,0],["ألا هَبَلتْ أمُّ المعادِيه نفسهُ","وأين امرؤ عاداه إلا ابن هابلِ",32,"ل",1,0],["ألا هبلتْ أمُّ المعادِيه نفسه","وأيُّ امرئ عاداه إلا ابن هابلِ",33,"ل",1,0],["أَلا هَل أَتى أُمَّ الحُوَيرِثِ مُرسَلٌ","نَعَم خالِدٌ إِن لَم تَعُقهُ العَوائِقُ",34,"ق",1,1],["أَلا هَكَذا فَليُحسِنِ القَولَ قائِلٌ","وَمِثلُ صَلاحِ الدينِ قَد قَلَّ سُلطانُ",35,"ن",1,0],["أَلا هَل أَتى عَنّا سُعادَ وَدونَها","مَهامِهُ بيدٍ تَعتَلي بالصَعالِكِ",36,"ك",1,1],["أَلا هَل لعَهدٍ مِن بُثَينَة قَد خَلا","وَأورثَ شَجواً لا يُريمُك مِن رَدِّ",37,"د",1,1],["أَلا هَل إِلى إِلمامَةٍ أَن أُلِمَّها","بُثَينَةُ يَوماً في الحَياةِ سَبيلُ",38,"ل",1,1],["أَلا هَل لنا من بعد هذا التفرّق","سبيلٌ فيشكو كلّ صبّ بما لقي",39,"ي",1,1],["ألا هل لي بلقياه يدانِ","حبيب شأنه عجب وشأني",40,"ن",2,1],["أَلا هَكَذا الدُنيا وَذَلِكَ وُدُّها","فَهَلّا تَأَتّى في الأَمانِيِّ خاطِبُه",41,"ب",2,0],["أَلا هَل أَتاها أَنَّ مُظلِمَةَ الدُجى","تَجَلَّت وَأَنَّ العَيشَ سُهِّلَ جانِبُه",42,"ب",2,0],["أَلا هَل أَتاها بِالمَغيبِ سَلامي","وَهَل خُبِّرَت وَجدي بِها وَغَرامي",43,"م",2,1],["أَلا هَل يَحسُنُ العَيشُ","لَنا مِثلُ الَّذي كَنا",44,"ن",2,1],["أَلا هَل لِلَيلى في الفِداءِ فَإِنَّني","أَرى رَهنَ لَيلى لا تُبالي أَواصِرُه",45,"ر",2,0],["أَلا هَل عَلِمتُم مَيِّتاً قَبلَ غالِبٍ","قَرى مِئَةً ضَيفاً وَلَم يَتَكَلَّمِ",46,"م",1,0],["أَلا هَل لِعُلوِيٍّ الرِياحِ هُبوبُ","فَيُخبِرنَ هَل عَهدُ المزارِ قَرِيبُ",47,"ب",1,1],["أَلا هَل عَلى زَمَني مُسعَدُ","وَأَنّى وَقَد ذَهَبَ الأَجوَدُ",48,"د",1,1],["أَلا هَل إِلى طولِ الحَياةِ سَبيلُ","وَأَنّي وَهَذا المَوتُ لَيسَ يُقيلُ",49,"ل",1,1],["أَلا هَل إِلى الفِردَوسِ مِن مُتَشَوِّقٍ","تَحِنُّ إِلَيها نَفسُهُ وَإِلى عَدنِ",50,"ن",1,0],["أَلا هَل هاجَكَ الأَظعا","نُ إِذ جاوَزنَ مُطَّلَحا",51,"ح",2,1],["أَلا هَل إِلى أَرضِ الجَزيرَةِ أَوبَةٌ","فَأَسكُنَ أَنفاساً وَأَهدَأَ مَضجَعا",52,"ع",2,0],["أَلا هَل أَطَلَّ الأَميرُ الأَجَلُّ","أَمِ الشَمسُ حُلَّت بِرَأسِ الحَمَل",53,"ل",1,1],["أَلا هَل إِلى شَمِّ الخُزامى وَنَظرَةٍ","إِلى قَرقَري قَبلَ المَماتِ سَبيلُ",54,"ل",1,1],["أَلا هَل إِلى لَيلى قُبَيلَ مَنِيَّتي","سَبيلٌ وَهَل لِلناجِعينِ رُجوعُ",55,"ع",1,0],["أَلا هَل طُلوعُ الشَمسِ يُهدي تَحيَّةً","إِلى آلِ لَيلى مَرَّةً أَو غُروبُها",56,"ب",3,1],["أَلاَ هِمَّةٌ بدريَّةٌ تكشفُ الأَذَى","وتشفِي من الهَمِّ الذي اهتاج دَاخِلُهْ",57,"ل",2,0],["ألا هدنةٌ فيها من الهمِّ راحةٌ","فإنَّ بنا منه لَداءً مُخامِرا",58,"ر",2,0],["ألا هادٍ يُقَوِّمُ من خُطاها","وَيَحْسِمُ دَاءَها بعد اعْتِلالِ",59,"ل",1,0],["أَلا هَكَذا تُذكَرُ الصالِحاتُ","وَتُبنى المَعالي وَإِلّا فَلا",60,"ل",2,0],["إِلّا هَوىً رَدَّ حَقّي عِندَ باطِلِهِ","حَتّى يَرى الظُلمُ لي مِنهُ يَداً قِبَلي",61,"ل",2,0],["أَلا هَل أَتى الحَسناءَ أَنَّ حَليلَها","تَأَبَّطَ شَرّاً وَاِكتَنَيتُ أَبا وَهبِ",62,"ب",1,1],["أَلا هَبَّت أُمامَةُ بَعدَ هَدءٍ","عَلى لَومي وَما قَضَّت كَراها",63,"ا",3,1],["أَلا هَل لِسَهمٍ في الحَياةِ فَإِنَّني","أَرى الحَربَ عَن روقٍ كَوالِحَ فُرَّتِ",64,"ت",1,0],["أَلا هَبَّت أُمامَةُ بَعدَ هَدءٍ","تُعاتِبُني وَتَجبَهُني بِظُلمِ",65,"م",1,1],["أَلا هَل تَرَوا ما قَد رَأى مِن مُعاشِرٍ","لَهُم فِيَّ حُكمٌ يَهجُرُ الحَقَّ مُشتَطُّ",66,"ط",1,0],["ألا هكذا فيسعدِ الصنوُ صِنوَهُ","فذا سيِّدٌ ندبٌ وذا سيدٌ قَرمُ",67,"م",1,0],["ألا هكذا فَلْيُهْدِ مَن قاد عسكرا","وأوردَ عن رأي الإمام وأصدَرا",68,"ر",2,1],["ألا هكذا فلتُجْلَبِ العِيسُ بُدَّناً","ألا هكذا فلتُجنَبِ الخيلُ ضُمَّرا",68,"ر",2,0],["ألا هل أتاهُمْ أنّ ثغرَكَ مُوصَدٌ","وليسَ له إلاّ الرماحَ وصِيد",69,"د",1,0],["أَلا هَل عَلى اللَيلِ الطَويلِ مُعينُ","إِذا بَعُدَت دارٌ وَشَطَّ قَرينُ",70,"ن",1,1],["أَلا هَذا اليَقينُ فَخُذهُ مِنّي","وَدَع لِمُمَوِّهٍ ما باتَ يَفري",71,"ر",2,0],["أَلا هَل أَتى قَبرَ الفَقيرَةِ طارِقٌ","يُخَبِّرُها بِالغَيبِ عَن فِعلِ طارِقِ",72,"ق",1,1],["أَلا هَل رَأَت هَذي الفَراقِدُ رُمِيَنا","فَراقِدَ في وَحشٍ رَعى الوَحشَ آزِلُه",73,"ل",2,0],["ألأهل الجحيم بؤسٌ وتعسٌ","ولمن حلَّ في الجنانِ سرور",74,"ر",1,0],["الأهلُ أهْلُك يا أميرُ كما تَرَى","والدَّارُ دارُكَ قُبَّةً وعِمَادَا",75,"د",2,0],["أَلا هَل أَتى بِنتَ الثُوَيرِ مَغارُنا","عَلى حَيِّ كَلبٍ وَالضُحى لَم تَرَحَّلِ",76,"ل",1,1],["أَلا هُبّي بِصَحنِكِ فَاَصبَحينا","وَلا تُبقي خُمورَ الأَندَرينا",77,"ن",2,1],["أَلا هَل تُرى إِن شَطَّ عَنّي مَزارُها","وَأَزعَجُها عَن أَهلِها الآنَ مُزعِجُ",78,"ج",1,0],["ألاَ هَبَلَتكَ أُمُّكَ عَمُرو بَعدي","أَتقعُدُ لا أُفَكُّ ولا تَصولُ",79,"ل",1,0],["أَلا هَتَفَتْ بِالأَيْكِ سَاجِعَةُ الْقُمْرِ","فَطُفْ بِالْحُمَيَّا فَهْيَ رَيْحَانَةُ الْعُمْرِ",80,"ر",1,1],["أَلاَ هَلْ تَرَكْتُمْ يَا لَقَوْمِي فَضِيلَة","تَبِيتُ مِنَ الحُسَّادِ يَوْماً بِمَعْزِلِ",81,"ل",1,1],["ألاَ هَلْ أَتَى غَسَّانَ في نَأْيِ دَارِهَا","وَأَخْبَرُ شَيءٍ بالأُمُورِ عَليمُها",82,"م",3,1],["ألا هَلْ أَتَى أَفْنَاءَ فهرِ بن مَالكٍ","مقطّعُ أطرافٍ وَهَامٌ مفلّقُ",83,"ق",1,0],["أَلا هَلْ أتى غَسّانَ عنّا ودونَهُمْ","مِنَ الأَرضِ خَرْقٌ سَيْرُهُ مُتَنعْنِعُ",84,"ع",1,1],["ألا هل أراني مُرسِلاً في شكيمتي","تُصرَّف كفّي كيف شاءت عنانيا",85,"ي",2,0],["ألا هل تعودُ الدارُ بعد تشتُّتٍ","ويُجْمَعُ هذا الشملُ بعدَ تفرُّق",86,"ق",1,0],["ألا هل يعودُ الشعر فينا كأنه","من الظهر يملى عن غيُوث رواشِح",87,"ح",1,0],["ألا هل أتاكم بأني متى","تدر كأس حبّكم أحتس",88,"س",1,0],["ألا هِزَّةً تستثيرُ الشّعوب","فقد يُدْرِكُ النَّهْزَةَ الثائرونا",89,"ن",2,0],["ألا هَلْ أتى نوَّماً في العراقِ","أنَّا للأجلِهِمُ ساهرونا",89,"ن",2,0],["ألا هلْ يَحْسُنُ العَيْشُ","لنَا، مِثْلَ الّذي كانَا",90,"ن",2,1],["ألا هبلتْ أمُّ المعادِيه نفسه","وأيُّ امرىء عاداه إلا ابن هابلِ",91,"ل",1,0],["ألا هل إلى طول الحياة سبيل","وأنى وهذا الموت ليس يحول",92,"ل",1,1]]}