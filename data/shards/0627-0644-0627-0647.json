poem12264.html","الطويل"],[517,"الا هل من البين المفرق من بد","https://www.aldiwan.net/poem48691.html","الطويل"],[517,"ألا أيها الربع المقيم بعنبب","https://www.aldiwan.net/poem48737.html","الطويل"],[530,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[539,"تأخرت عن صوغ القريض له قصدا","https://www.aldiwan.net/poem48216.html","عموديه"],[552,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[552,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[552,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[552,"أرى عزة من بين أثناء ذلة","https://www.aldiwan.net/poem48027.html","الطويل"],[552,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[552,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[559,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[559,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[559,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[559,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"],[559,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[562,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[576,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[587,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"]],"verses":[["أَلا هَل أَطرُقُ السَمُراتِ يَوماً","بِريءَ القَلبِ مِن عَنَتِ الهُمومِ",0,"م",1,0],["أَلا هَل لِحُبٍّ فاتَ أُولاهُ رَجعَةَ","وَإِن زادَ عِندي أَو تَضاعَفَ إِسمُهُ",1,"م",2,0],["أَلا هَل إِلى ظِلِّ الأَثيلِ تَخَلُّصٌ","وَهَل لِثَنَيّاتِ الغُوَيرِ طُلوعُ",2,"ع",1,0],["أَلا هَل أُخيضُ الطِرفَ يَوماً بِغَمرَةٍ","إِذا الخَيلُ بِالغُرِّ الوُجوهِ تَمَطَّتِ",3,"ت",1,0],["أَلا هَل تَرُدُّ الريحُ يا جَوَّ ضارِجٍ","نَسيمَكَ يَحلولي لَنا وَيَطيبُ",4,"ب",1,0],["أَلا هَلْ يُفيقُ الدَّهْرُ مِنْ سَكراتِهِ","وَيَرْفَضُّ عَن أَجْفانِهِ طارِقُ الحُلْمِ",5,"م",1,1],["أَلا هَلْ إِلى أَرْضٍ بِها أُمُّ سالِمٍ","وُصولٌ لِطاوي شُقَّةٍ وَبَلاغُ",6,"غ",1,1],["أَلا هَل أَتاها أَنَّ يَومَ عُراعِرٍ","شَفى سَقَماً لَو كانَتِ النَفسُ تَشتَفي",7,"ف",2,1],["أَلا هَل تُرى إِن شَطَّ عَنّي مَزارُه","وَأَزعَجُها عَن أَهلِها الآنَ مُزعِجُ",8,"ج",1,0],["أَلا هَل إِلى قَلبي سَبيلٌ لَعَلَّني","أُمِرُّ جَناحَيهِ عَلى القَصِّ وَالنَتفِ",9,"ف",1,0],["ألا هَكذا فلْيُحْرِز المَجْدَ ربُّهُ","وتُبْنى المَعالي أوْ تُرَبّى الصّنائِعُ",10,"ع",1,0],["أَلاَ هَكَذَا تُبْنَى الْمَدَارِسُ لِلْعِلْمِ","وَتَبْقَى عُهُودُ الْمَجْدِ ثَابِتَةُ الرَّسْمِ",11,"م",1,1],["إِلّا هَوانَكَ إِذ رَأَت","مِن دونِها باباً وَدارَه",12,"ر",2,0],["أَلا هَل إِلى الزَهراءِ أَوبَةُ نازِحٍ","تَقَضّى تَنائيها مَدامِعَهُ نَزحا",13,"ح",2,0],["أَلا هَل أَتى الفِتيانُ أَنَّ فَتاهُم","فَريسَةُ مَن يَعدو وَنُهزَةُ مَن يَسطو",14,"ط",2,0],["أَلا هَل جاءَ مَن فارَقتُ أَنّي","بِساحاتِ المُنى رَفلُ المَراحِ",15,"ح",1,0],["أَلا هَل دَرى الداعي المُثَوِّبُ إِذ دَعا","بِنَعيِكَ أَنَّ الدينَ مِن بَعضِ ما نَعى",16,"ع",2,1],["أَلا هَل سَبيلٌ إِلى العَيبِ فيهِ","فَكَم عينَ مِن قَبلِهِ مَن كَمَل",17,"ل",1,0],["أَلا هَل أَتى بِنتَ الثُوَيرِ مَغارُن","عَلى حَيِّ كَلبٍ وَالضُحى لَم تَرَحَّلِ",18,"ل",1,1],["أَلا هُبّي بِصَحنِكِ فَاَصبَحين","وَلا تُبقي خُمورَ الأَندَرينا",19,"ن",2,1],["أَلا هَل تَرجِعَنَّ لَنا اللَيالي","وَأَيّامٌ لَنا بِلِوى الشَقيقِ",20,"ق",1,0],["أَلا هَل إِلى مَيٍّ سَبِيلٌ وَساعَةٌ","تُكَلِّمُني فيها شِفاءٌ لِما بِيا",21,"ي",2,1],["أَلا هَل تَرى الأَظعانَ جاوَزنَ مُشرِفاً","مِنَ الرَملِ أَو حاذَت بِهِنَّ سَلاسِلُه",22,"ل",2,0],["أَلا هَل تَرى أَظعانَ مَيٍّ كَأَنَّها","ذُرى أَثأُبٍ راشَ الغُصونَ شَكيرُها",23,"ر",3,0],["ألا هكذا فليعقد الفخرُ تاجَه","ويسمو إلى أوج العلا ويطاولُ",24,"ل",1,0],["ألا هل تسمعون فإن عندي","حديثاً عن مواطنكم خطيرا",25,"ر",2,0],["أَلا هَل لِلخَليفَةِ في نِزارٍ","فَقَد أَمسَوا وَأَكثَرُهُم كُلولُ",26,"ل",1,0],["ألا هَل عَمِّ في رَأيه مُتَأمِلُ","وَهَل مُدبِرٌ بَعدَ الإِسَاءَةِ مُقبِلُ",27,"ل",1,1],["أَلا هَل مُنكِرٌ يا اِبنَي نِزارٍ","مَقامي يَومَ ذَلِكَ أَو مَقالي",28,"ل",2,0],["ألا هلْ لأيام تعلَّلْتُ عيشها","بها عودةٌ أم ليس دهرٌ بعائدِ",29,"د",1,0],["ألا هاتيكم العليا","ء والفخر لدى الفخر",30,"ر",1,0],["ألا هكذا فليمنع اليوم من غد","وإلا فلا يا من يريد صنيعا",31,"ع",2,0],["ألا هَبَلتْ أمُّ المعادِيه نفسهُ","وأين امرؤ عاداه إلا ابن هابلِ",32,"ل",1,0],["ألا هبلتْ أمُّ المعادِيه نفسه","وأيُّ امرئ عاداه إلا ابن هابلِ",33,"ل",1,0],["أَلا هَل أَتى أُمَّ الحُوَيرِثِ مُرسَلٌ","نَعَم خالِدٌ إِن لَم تَعُقهُ العَوائِقُ",34,"ق",1,1],["أَلا هَكَذا فَليُحسِنِ القَولَ قائِلٌ","وَمِثلُ صَلاحِ الدينِ قَد قَلَّ سُلطانُ",35,"ن",1,0],["أَلا هَل أَتى عَنّا سُعادَ وَدونَها","مَهامِهُ بيدٍ تَعتَلي بالصَعالِكِ",36,"ك",1,1],["أَلا هَل لعَهدٍ مِن بُثَينَة قَد خَلا","وَأورثَ شَجواً لا يُريمُك مِن رَدِّ",37,"د",1,1],["أَلا هَل إِلى إِلمامَةٍ أَن أُلِمَّها","بُثَينَةُ يَوماً في الحَياةِ سَبيلُ",38,"ل",1,1],["أَلا هَل لنا من بعد هذا التفرّق","سبيلٌ فيشكو كلّ صبّ بما لقي",39,"ق",2,1],["ألا هل لي بلقياه يدانِ","حبيب شأنه عجب وشأني",40,"ن",2,1],["أَلا هَكَذا الدُنيا وَذَلِكَ وُدُّها","فَهَلّا تَأَتّى في الأَمانِيِّ خاطِبُه",41,"ب",2,0],["أَلا هَل أَتاها أَنَّ مُظلِمَةَ الدُجى","تَجَلَّت وَأَنَّ العَيشَ سُهِّلَ جانِبُه",42,"ب",2,0],["أَلا هَل أَتاها بِالمَغيبِ سَلامي","وَهَل خُبِّرَت وَجدي بِها وَغَرامي",43,"م",2,1],["أَلا هَل يَحسُنُ العَيشُ","لَنا مِثلُ الَّذي كَنا",44,"ن",2,1],["أَلا هَل لِلَيلى في الفِداءِ فَإِنَّني","أَرى رَهنَ لَيلى لا تُبالي أَواصِرُه",45,"ر",2,0],["أَلا هَل عَلِمتُم مَيِّتاً قَبلَ غالِبٍ","قَرى مِئَةً ضَيفاً وَلَم يَتَكَلَّمِ",46,"م",1,0],["أَلا هَل لِعُلوِيٍّ الرِياحِ هُبوبُ","فَيُخبِرنَ هَل عَهدُ المزارِ قَرِيبُ",47,"ب",1,1],["أَلا هَل عَلى زَمَني مُسعَدُ","وَأَنّى وَقَد ذَهَبَ الأَجوَدُ",48,"د",1,1],["أَلا هَل إِلى طولِ الحَياةِ سَبيلُ","وَأَنّي وَهَذا المَوتُ لَيسَ يُقيلُ",49,"ل",1,1],["أَلا هَل إِلى الفِردَوسِ مِن مُتَشَوِّقٍ","تَحِنُّ إِلَيها نَفسُهُ وَإِلى عَدنِ",50,"ن",1,0],["أَلا هَل هاجَكَ الأَظعا","نُ إِذ جاوَزنَ مُطَّلَحا",51,"ح",2,1],["أَلا هَل إِلى أَرضِ الجَزيرَةِ أَوبَةٌ","فَأَسكُنَ أَنفاساً وَأَهدَأَ مَضجَعا",52,"ع",2,0],["أَلا هَل أَطَلَّ الأَميرُ الأَجَلُّ","أَمِ الشَمسُ حُلَّت بِرَأسِ الحَمَل",53,"ل",1,1],["أَلا هَل إِلى شَمِّ الخُزامى وَنَظرَةٍ","إِلى قَرقَري قَبلَ المَماتِ سَبيلُ",54,"ل",1,1],["أَلا هَل إِلى لَيلى قُبَيلَ مَنِيَّتي","سَبيلٌ وَهَل لِلناجِعينِ رُجوعُ",55,"ع",1,0],["أَلا هَل طُلوعُ الشَمسِ يُهدي تَحيَّةً","إِلى آلِ لَيلى مَرَّةً أَو غُروبُها",56,"ب",3,1],["أَلاَ هِمَّةٌ بدريَّةٌ تكشفُ الأَذَى","وتشفِي من الهَمِّ الذي اهتاج دَاخِلُهْ",57,"ل",2,0],["ألا هدنةٌ فيها من الهمِّ راحةٌ","فإنَّ بنا منه لَداءً مُخامِرا",58,"ر",2,0],["ألا هادٍ يُقَوِّمُ من خُطاها","وَيَحْسِمُ دَاءَها بعد اعْتِلالِ",59,"ل",1,0],["أَلا هَكَذا تُذكَرُ الصالِحاتُ","وَتُبنى المَعالي وَإِلّا فَلا",60,"ل",2,0],["إِلّا هَوىً رَدَّ حَقّي عِندَ باطِلِهِ","حَتّى يَرى الظُلمُ لي مِنهُ يَداً قِبَلي",61,"ل",2,0],["أَلا هَل أَتى الحَسناءَ أَنَّ حَليلَها","تَأَبَّطَ شَرّاً وَاِكتَنَيتُ أَبا وَهبِ",62,"ب",1,1],["أَلا هَبَّت أُمامَةُ بَعدَ هَدءٍ","عَلى لَومي وَما قَضَّت كَراها",63,"ا",3,1],["أَلا هَل لِسَهمٍ في الحَياةِ فَإِنَّني","أَرى الحَربَ عَن روقٍ كَوالِحَ فُرَّتِ",64,"ت",1,0],["أَلا هَبَّت أُمامَةُ بَعدَ هَدءٍ","تُعاتِبُني وَتَجبَهُني بِظُلمِ",65,"م",1,1],["أَلا هَل تَرَوا ما قَد رَأى مِن مُعاشِرٍ","لَهُم فِيَّ حُكمٌ يَهجُرُ الحَقَّ مُشتَطُّ",66,"ط",1,0],["ألا هكذا فيسعدِ الصنوُ صِنوَهُ","فذا سيِّدٌ ندبٌ وذا سيدٌ قَرمُ",67,"م",1,0],["ألا هكذا فَلْيُهْدِ مَن قاد عسكرا","وأوردَ عن رأي الإمام وأصدَرا",68,"ر",2,1],["ألا هكذا فلتُجْلَبِ العِيسُ بُدَّناً","ألا هكذا فلتُجنَبِ الخيلُ ضُمَّرا",68,"ر",2,0],["ألا هل أتاهُمْ أنّ ثغرَكَ مُوصَدٌ","وليسَ له إلاّ الرماحَ وصِيد",69,"د",1,0],["أَلا هَل عَلى اللَيلِ الطَويلِ مُعينُ","إِذا بَعُدَت دارٌ وَشَطَّ قَرينُ",70,"ن",1,1],["أَلا هَذا اليَقينُ فَخُذهُ مِنّي","وَدَع لِمُمَوِّهٍ ما باتَ يَفري",71,"ر",2,0],["أَلا هَل أَتى قَبرَ الفَقيرَةِ طارِقٌ","يُخَبِّرُها بِالغَيبِ عَن فِعلِ طارِقِ",72,"ق",1,1],["أَلا هَل رَأَت هَذي الفَراقِدُ رُمِيَنا","فَراقِدَ في وَحشٍ رَعى الوَحشَ آزِلُه",73,"ل",2,0],["ألأهل الجحيم بؤسٌ وتعسٌ","ولمن حلَّ في الجنانِ سرور",74,"ر",1,0],["الأهلُ أهْلُك يا أميرُ كما تَرَى","والدَّارُ دارُكَ قُبَّةً وعِمَادَا",75,"د",2,0],["أَلا هَل أَتى بِنتَ الثُوَيرِ مَغارُنا","عَلى حَيِّ كَلبٍ وَالضُحى لَم تَرَحَّلِ",76,"ل",1,1],["أَلا هُبّي بِصَحنِكِ فَاَصبَحينا","وَلا تُبقي خُمورَ الأَندَرينا",77,"ن",2,1],["أَلا هَل تُرى إِن شَطَّ عَنّي مَزارُها","وَأَزعَجُها عَن أَهلِها الآنَ مُزعِجُ",78,"ج",1,0],["ألاَ هَبَلَتكَ أُمُّكَ عَمُرو بَعدي","أَتقعُدُ لا أُفَكُّ ولا تَصولُ",79,"ل",1,0],["أَلا هَتَفَتْ بِالأَيْكِ سَاجِعَةُ الْقُمْرِ","فَطُفْ بِالْحُمَيَّا فَهْيَ رَيْحَانَةُ الْعُمْرِ",80,"ر",1,1],["أَلاَ هَلْ تَرَكْتُمْ يَا لَقَوْمِي فَضِيلَة","تَبِيتُ مِنَ الحُسَّادِ يَوْماً بِمَعْزِلِ",81,"ل",1,1],["ألاَ هَلْ أَتَى غَسَّانَ في نَأْيِ دَارِهَا","وَأَخْبَرُ شَيءٍ بالأُمُورِ عَليمُها",82,"م",3,1],["ألا هَلْ أَتَى أَفْنَاءَ فهرِ بن مَالكٍ","مقطّعُ أطرافٍ وَهَامٌ مفلّقُ",83,"ق",1,0],["أَلا هَلْ أتى غَسّانَ عنّا ودونَهُمْ","مِنَ الأَرضِ خَرْقٌ سَيْرُهُ مُتَنعْنِعُ",84,"ع",1,1],["ألا هل أراني مُرسِلاً في شكيمتي","تُصرَّف كفّي كيف شاءت عنانيا",85,"ي",2,0],["ألا هل تعودُ الدارُ بعد تشتُّتٍ","ويُجْمَعُ هذا الشملُ بعدَ تفرُّق",86,"ق",1,0],["ألا هل يعودُ الشعر فينا كأنه","من الظهر يملى عن غيُوث رواشِح",87,"ح",1,0],["ألا هل أتاكم بأني متى","تدر كأس حبّكم أحتس",88,"س",1,0],["ألا هِزَّةً تستثيرُ الشّعوب","فقد يُدْرِكُ النَّهْزَةَ الثائرونا",89,"ن",2,0],["ألا هَلْ أتى نوَّماً في العراقِ","أنَّا للأجلِهِمُ ساهرونا",89,"ن",2,0],["ألا هلْ يَحْسُنُ العَيْشُ","لنَا، مِثْلَ الّذي كانَا",90,"ن",2,1],["ألا هبلتْ أمُّ المعادِيه نفسه","وأيُّ امرىء عاداه إلا ابن هابلِ",91,"ل",1,0],["ألا هل إلى طول الحياة سبيل","وأنى وهذا الموت ليس يحول",92,"ل",1,1],["أَلا هاتَ أَسقني كَأساً فَكَأسا","وَحيّ بِها ثَلاثاً بَل سداسا",93,"س",2,1],["أَلا هَل أَتاهُ ما رَكِبنا سَراتَهُم","وَما قَد عَقَرنَ مِن صَفِيٍّ وَمِن قَرمِ",94,"م",1,0],["أَلا هَل أَتى بَحريَّنا صُنعُ رَبِّنا","عَلى نَأيِهِم وَاللَهُ بِالناسِ أَروَدُ",95,"د",1,1],["ألا هل لهذا البين من آخر فقد","تطاول حتى خلت هذا إلى اللحد",96,"د",1,0],["ألا هل يجود الدهر بعد فراقنا","فيجمعنا والدهر يجري إلى الضد",96,"د",1,0],["إلاَهِي..فاقْتربْ منَّا.... تَجَلَّى","وَأَقْبِلْ... أَيْنَمَا كَانَ الْمَكَانُ",97,"ن",1,0],["أَلا هَل أَتى أَبا حَسّانَ أَنّا","نَعَيناهُ بِأَطرافِ الرِماحِ",98,"ح",1,1],["أَلاَ هَل لأَيَّامٍ تَوَلَّينَ مَطلَبُ","وَهَل عاتِبٌ زارٍ عَلَى الدَّهرِ مُعتَبُ",99,"ب",1,1],["أَلاَ هَل مِن البَينِ المُفَرِّقِ مِن بُدِّ","وَهَل لِلَيَالٍ قَد تَسَلَّفنَ مِن رَدِّ",100,"د",1,1],["أَلاَ هَل أدُلُّ الوارِدَينِ عَشِيَّةً","عَلَى مَشرَبٍ غَيرِ الّذِى يَرِدَانِ",101,"ن",1,0],["أَلاَ هلْ إلى بَرْدِ الأَصائلِ بالحِمىَ","على الرملِ في ظِلِّ الأَراكِ إِيابُ",102,"ب",1,1],["أَلا هلْ لأيامِ الوصالِ تَواصُلٌ","وهل لي إلى سكانِ مِصْر مَصير",103,"ر",1,0],["أَلا هلْ إلى ما أرتجيه بُلوغُ","فكم أَقتضيه الدهرَ وهْو يَروغُ",104,"غ",1,1],["أَلاَ هلْ لدائي من فراقِك إفراقُ","هو السُّمُّ لكنْ في لقائِك دِرْياق",105,"ق",1,1],["أَلاَ هلْ لأيامي بك الغُرِّ عودةٌ","كعهدِي وَثَغْرُ الثغرِ أَشْنَبُ بَرّاق",105,"ق",1,0],["أَلاَ هلْ إلى الإسكندريةِ أَوْبَةٌ","تُبرِّد أشواقي وحَرَّ أُوامى",106,"م",2,0],["أَلا هَل راجِعٌ عَيشٌ تَولّى","وَهَل مُتَبَدّلٌ عَيشٌ تَنكّد",107,"د",1,0],["أَلا هَل بِالأَحِبَّةِ مِن لمامٍ","وَهَل شَملُ السُرورِ بِهم معادُ",108,"د",1,0],["أَلا هَل أَتى عِرسي مَكَرّي وَمَوقِفي","بِوادي حُنَينٍ وَالأَسِنَّةُ تُشرَعُ",109,"ع",1,1],["أَلا هَذِّب شَبابَ الشَرقِ هَذِّب","لِيَرقى مَوطِنٌ لَهُمُ وَيَرقوا",110,"ق",3,0],["ألا هل لألفاظي طريقٌ إلى العذرِ","فدون الذي أوليتني رُتْبةُ الشكرِ",111,"ر",1,1],["أَلاَ هَلْ أَتَى مَعْشَرِي أَنَّنِي","عَلِقْتُ بِتِطْوَانَ عِلْقاً خَطِيرَا",112,"ر",2,0],["الأهل درى الخوَّان أن دويشهم","له فوق متن السحر مأوى ومركب",113,"ب",1,0],["أَلا هَذِهِ أَمُّ الصَبيينِ إِذ رأت","شُحوباً بِضاحي الجِسم مني تهزَّلُ",114,"ل",1,0],["ألا هلْ فؤادي عن صِبا اليومِ صافحُ","وهلْ ما وأتْ ليلى بهِ لكَ ناجحُ",115,"ح",1,1],["أَلا هَل أَتاها كَيفَ ناوَأَ قَومُها","بِجَنبِ قُلابِ إِذ تَدانى القَبائِلُ",116,"ل",1,1],["ألا هَل تَذكُرينَ مساءَ بِتنا","نذوبُ جوىً ألا هَل تَذكُرينا",117,"ن",2,0],["ألا هل عزاءٌ للمُحِبّ الذي يرى","مَنازِلَ أحبابٍ على وحشات",118,"ت",1,0],["ألا هل كقومي أو كمثلِ كبارِهم","إذا عُدَّتِ الأقوامُ والكبراء",119,"ا",2,0],["ألا هَل قُلُوبٌ لِلهَوى بَعدَ قَلبِها","وهل بعدَ عَينَيها عُيونٌ نَواظِر",120,"ر",1,0],["الاهدل الشيخ المبارك جده","وأَبوه سامي الفرع سامى المحتد",121,"د",1,0],["أَلا هَذِهِ الآفاقُ نَحْوَكَ تَرْتَمِي","لِتُدرِك أَقصَى ما تَرُومُ وتَبْلُغَا",122,"غ",2,0],["ألا هُو شِبل البأسِ زارَ هِزَبرَه","فَقرَّ قَرارُ الناسِ منهُ عَلى الزأرِ",123,"ر",1,0],["ألا هَذِه حِمْصٌ تُناسِبُ طاعَة","سِجلماسة في رَفْضِها لِلمناصِبِ",124,"ب",1,0],["أَلا هكَذا فَلْيُحْرِزِ الْحَمْدَ وَالأَجْرا","وَيَحْوِ جَميلَ الذِّكْرِ مَنْ طَلَبَ الذِّكْرا",125,"ر",2,1],["ألا هكَذا تَسْتَهِلُّ الْبُدُورُ","مَحَلٌّ عَلِيٌّ وَوَجْهٌ مُنِيرُ",126,"ر",1,1],["أَلا هَل إِلى الخِلِّ الوَصولِ وُصولُ","فَمِن بَعد ما الصَبرُ الجَميلُ جَميلُ",127,"ل",1,1],["أَلا هَل إِلى بابِ البَريدِ سَبيلُ","فَلَيلي بِزَوراءِ العِراقِ طَويلُ",128,"ل",1,1],["أَلا هَل درت من أَقصَدَت أَسهمُ الهُلكِ","فأَصبح عقدُ المَجد منفصمَ السِّلكِ",129,"ك",1,1],["أَلا هَلْ أَتى شبهَ الجزيرةِ نعْيُهمْ","وَمَنْ كان (قيسيّاً) بها و(يمانيا)",130,"ي",2,0],["أَلا هَذا الّذي منهُ تحيدُ","وَأنتَ لِمثله رهنٌ وحيدُ",131,"د",1,1],["أَلا هاجَ قَلبي العامَ ظُعنٌ بَواكِرٌ","كَما هاجَ مَسحوراً إلى الشَوقِ ساحِرُ",132,"ر",1,1],["ألا هبلت أم الذين غدوا به","إلى القبر ماذا يحملون إلى القبر",133,"ر",1,1],["أَلا هَلكَ الراعي العشيرة ذو الفقدِ","وَساقي الحجيج وَالمحامي عن المجدِ",134,"د",1,1],["أَلا هَل إِلى داري بِوادي طُوَيلِعٍ","وَإِن بَعُدَت بِعدَ الرَحيلِ قُفولُ",135,"ل",1,1],["الأهل أهلي والمكان مكاني","ما كان هجر الدار في إمكاني",136,"ن",2,1],["ألا هل لِقَلب عَنك قَد فَقَد الصَبرا","تَجرّع مُرّ الصَبر يقضي بِهِ صَبرا",137,"ر",2,1],["أَلا هَل أَتى أَهلَ الحِجازِ مُغارُنا","عَلى حَيِّ وَردٍ وَاِبنِ رَيّا المُضَرَّبِ",138,"ب",1,0],["أَلا هَل أَتى أَهلَ الحِجازِ مُغارُنا","وَمِن دونِهِم أَهلُ الجِنابِ فَأَيهَبُ",139,"ب",1,0],["ألا هل إلى نَيْلِ الغنى من وسيلة","يَمُتُّ بها إلاّ السُّيوفُ القَواطع",140,"ع",1,0],["أَلا هَل لِلثامِ الدَه","رِ عَن وَجهِ المُنى حَطُّ",141,"ط",1,0],["أَلا هل أَتاها من نَهَاوَندَ أَنَّني","أُمارسُ أَبطالاً لها وفُيُولا",142,"ل",2,1],["أَلا هَل أَتى الواشينَ أَنا عَلى النَوى","بِطَيفِ الكَرى أَو بِالأَمانِيِّ نَلتَقي",143,"ق",2,0],["إلاه والإحسانُ ملءُ جنانه","حَسبي جَنانٌ ملؤُه الإحسان",144,"ن",1,0],["أَلا هَكَذا فَليَحفَظ المَجدُ أَهلَهُ","وَمثل الَّذي قَد شادَ في المَجد فَليَبني",145,"ن",2,0],["الأهل محب للحبيب محمد","يبلغ عنه شرعه كل جاهل",146,"ل",1,0],["ألاهل سامع فطن حليم","يجيب مسرعاق بل البيات",147,"ت",1,0],["ألا هَل لِهذا الدهر من مُتعلّلٍ","سوى الناس مهما شاء بالناس يفعل",148,"ل",1,1],["إلاهي بهمْ جُدْ بعَفْوٍ عَلَى","أَسِيرٍ بهِ ضَاقَ رحبُ الفَضَا",149,"ض",2,0],["الأهل إلى أكنافها لي عودة","ليصحو قلب من معاصيه سكرانا",150,"ن",2,0],["أَلا هَل لِعَهدِ العامِريَّةِ جاحِدُ","وَعِندي مِن صدق المَوَدَّةِ شاهِدُ",151,"د",1,1],["أَلا هَل لِنَيل المُنى غايَةٌ","فَأَنا إِلى غير قصد نَخُب",152,"ب",1,0],["ألا هَلْ للمتيَّمِ من مُجير","كئيبٍ ذي فؤاد مستطيرِ",153,"ر",1,1],["أَلا هَلَكَ المُلوكُ وَعَبدُ عَمرٍو","وَخُلَّيَت العِراقُ لِمَن بَغاها",154,"ا",3,1],["أَلا هَكَذَا فَلْيَسْمُ للمجدِ مَنْ سَما","ويَحْمِ ذِمارَ الملكِ والدينِ مَنْ حَمى",155,"م",2,1],["ألا هَلْ إِلَى الدُّنيا مَعادٌ وهلْ لَنا","سِوى البحْرِ قَبْرٌ أَوْ سِوى الماءِ أَكْفانُ",156,"ن",1,0],["أَلا هكذا فَلْيَحْفَظِ العَهْدَ حافِظٌ","أَلا هكذا فَلْيَخْلُفِ المُلكَ سُلْطَانُ",156,"ن",1,0],["أَلا هل مبلغ مني رجالاً","نصيحات وبورك من وعاها",157,"ا",3,0],["ألا هل وظلُّ المنَى باردٌ","وقد يُرزَق المرءُ مما حُرِمْ",158,"م",1,0],["ألا هل رُقيةٌ من مسّ دهرٍ","خفيِّ الكيد شيطانِ العُرامَهْ",159,"م",2,0],["إلا هوَى القُربَى ورَعيُ وشائجٍ","بيني وبينك أُحْكِمتْ ووصائلِ",160,"ل",1,0],["ألا هل والمنَى سفَهٌ وحلمٌ","وصادقةٌ تسرّك أو خَدوعُ",161,"ع",1,0],["أَلا هَل أَتى لَيلى عَلى نَأيِ دارِها","بِأَن لَم أُقاتِل يَومَ صَخرٍ مُذَوِّدا",162,"د",2,0],["أَلا هاتِها راحاً لَها ريحُ عَنبَرِ","عَلى حِسِّ طَنبورٍ وَإيقاعِ مَزهَرِ",163,"ر",1,1],["أَلا هاجَ التَذَكُّرُ لِي سَقامَا","وَنُكسَ الدَاءِ والوَجَعَ الغَراما",164,"م",2,1],["ألا هل إلى وصل الحمى جبل رقا","قليب الظبي فالشوق فيه مسوما",165,"م",2,0],["أَلا هَل فُؤادي إِذ صَبا اليَومَ نازِعُ","وَهَل عَيشُنا الماضي الَّذي زالَ رايِعُ",166,"ع",1,1],["ألا هل مبلغ هَمَذانَ أني","وردت الفلك من جهة السوافي",167,"ف",2,0],["ألا هَل نَسِيمِ لِلرُّصافي مُبلغُ","تَحِيّة مُشتَاقٍ يُفَتِّقُها زَهرَا",168,"ر",2,1],["ألا هل إلى نجدٍ وماءٍ بقاعها","سبيل وأرواحٍ بها عطرات",169,"ت",1,0],["ألا هل له عطف علي فإنني","فقير إلى ما اعتدت منه عديم",170,"م",1,0],["ألا هب لنا من حية الهم رقية","فإنك من ليل السليم سليم",170,"م",1,0],["الا هل مِن البَين المفرِّق من بُدِّ","وَهل مِثل أَيّام بِمنقطع السَعد",171,"د",1,1],["الا هَل اِتى الصَقر اِبن مَروان أَنَّني","أَرَدُّ لَدى الاِبوابِ عَنهُ وَاِحجب",172,"ب",1,0],["أَلاَ هَكَذا مَنْ يَرُومُ الْفَخَارا","ويَبْغي بُلوغَ الْمُنَى والْقُصَارى",173,"ر",2,1],["ألا هَكَذا مَنْ يَرومُ الْعُلَى","ألا هَكَذا من يَرومُ الْفَخارا",173,"ر",2,0],["ألا هكذا تسمُو الملوكُ بِشعبِهم","فيشكرُهم شُكرا على ما لَه أسدَى",174,"د",2,0],["ألا هلْ أرى في أرضِ بابِلَ أَدْرُعاً","تصول بأسيافٍ رِقاقٍ بواتِكِ",175,"ك",1,0],["أَلا هَلْ أراها ثائراتٍ كأنّما","تَعلّقْنَ في أوراكهنَّ الأراقطا",176,"ط",2,0],["ألا هلْ أتاها كيف حُزنِيَ بعدها","وأنّ دموعي لست أملك رَدّها",177,"د",3,1],["أَلا هنّ صُنعٌ من عزيزٍ مُقدِّرٍ","أَخوذٍ على أيدِي الرّجالِ موقِّتِ",178,"ت",1,0],["أَلا هَل لما فات من مطلبِ","وهل عن ردَى المرءِ من مَهرَبِ",179,"ب",1,1],["أَلا هَرباً مِنَ الإِخوانِ جَمعاً","فَما لكَ مِنهُمُ إِلّا النُّدُوبُ",180,"ب",1,0],["ألا هل أنت بهجة وجه سلمى","بدت فتحير القلب الولوع",181,"ع",1,0],["ألا هكذا فافهم كلام إلهنا","فإن كلام الله يطوَى وينشر",182,"ر",1,0],["ألا هكذا الآفاق فانظر جميعها","ونفسك لا يغررك زيد ولا عمرو",183,"ر",2,0],["ألا هكذا في النار حال أولي الشقا","غداً بعد تحويل الحجاب عن الرب",184,"ب",1,0],["ألا هلموا نحونا لتعلموا","علم اليقين صورة المرائي",185,"ا",2,0],["إِلّا هَوى عَدُوُّهُم لِلكَلكلِ","أَو لِقَفاهُ بِالحَضيضِ الأَسفَلِ",186,"ل",1,0],["أَلاَ هذه العلياءُ لاَ انْحطَّ أُفْقُها","وذَا المَجْدُ لا غَابتْ عن النَّاسِ زُهْرُه",187,"ر",2,0],["إِلَّا هَواكَ وَأَنْتَ فِيها أَدَّعِي","أَدْرَى بِأَنِّي عَنْهُ لَمْ أَكُ أَنْكَفِي",188,"ف",2,0]]}