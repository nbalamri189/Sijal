{"poems":[[75,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[92,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[443,"رب السماء يزيد من عمري","https://www.aldiwan.net/poem2567.html","مجزوء الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103870","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132191","الطويل"],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5751,"تَحارُ بكَ الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=214772",""],[6068,"أبصرتها -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175865",""]],"verses":[["يُوَكِّلُ بِالتَدبيرِ خاطِرَ فِكرَةٍ","إِنِ اِقتَدَحَت في خاطِرٍ أَثقَبَ الزَندُ",0,"د",1,0],["يؤكد أن الدينَ حُبٌّ ورحمةٌ","وعدلٌ ، وأن اللهَ لا شكَ واحد",1,"د",1,0],["يُوكَسُ من لا أدبٌ عنده","وكْس الدنانيرِ ولم تُطبعِ",2,"ع",1,0],["يوكي نداك وعرضك ال","موفور والحسب المطهّر",3,"ر",1,0],["يؤكل للطحال في أيام","ثلاثة والأمن من جذام",4,"م",1,0],["يوكَلُ في الليل وفي العشيه","وبعدما يُقضى منَ الأغذِيه",5,"ه",1,0],["يوكل في الصَّبَاح والمساء","وكلُّ بائتٍ كثيرُ الداء",5,"ا",2,0],["يُوكَلُ قَبْلَ الأَخْذِ فِي الغِذَاء","وَبَعْدَه مَكَانَ شُرْبِ المَاءِ",5,"ا",2,0],["يؤكد ذا أنا نرى كل نشأةٍ","تتم سريعاً عن قريبٍ معادها",6,"د",3,0],["يُؤكِّدَانِ افعَل وَيَفعَل آتِيَا","ذَا طَلَبٍ أو شَرطاً إمَّا تَالِيَا",7,"ي",2,0],["يؤكد حتف الصب عامل قدره","وتعطف من واو العذار توابعه",8,"ع",2,0],["يُوكّله إلى عمٍّ رحيم ٍ","نمى في بيته خير النماءِ",9,"ا",2,0],["يؤكدكَ المدارُ وأنتَ سَهْمُ","تطوفُ بغير أجنحةٍ وتسمو",10,"م",2,1],["يؤكد الخبر بالاثنين منطقها","كأنما أخذت وقتا لدى صفعي",11,"ع",2,0]]}