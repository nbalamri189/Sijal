{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[55,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[95,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[53,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[72,"بالله قل لي خبرك","https://www.aldiwan.net/poem42917.html","مجزوء الرجز"],[104,"لا تسل عن سلامته","https://www.aldiwan.net/poem33066.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85470","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[102,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[102,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[113,"بين جفنيك الجمال","https://www.aldiwan.net/poem16602.html","مجزوء الرمل"],[121,"المها","https://www.aldiwan.net/poem24062.html","الرمل"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[295,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[303,"مقلة عبرى ودمع يكف","https://www.aldiwan.net/poem36328.html","عموديه"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[366,"ان وجدي كل يوم في ازدياد","https://www.aldiwan.net/poem68123.html","الرمل"],[463,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[484,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[543,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[563,"إن شربي شرب الجمال الهيم","https://www.aldiwan.net/poem33882.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70857","الخفيف"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216673",""],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124027","الخفيف"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36188","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101024","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126649","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202132","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199638","المسحوب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106908","الرمل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46746","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137106",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205828","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79726","الخفيف"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216402",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102939","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103053","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32434","المديد"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70040","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119634","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81264","الخفيف"],[4755,"قَبلَ يَومَينِ هاتِفِي مِنكَ رَنَّا","https://www.poetsgate.com/ViewPoem.aspx?id=183857",""],[5107,"نداء من المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=32889",""],[5409,"أرسلوها في الفضا قبا مهارا","https://www.poetsgate.com/ViewPoem.aspx?id=155278",""],[5455,"نبض القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=34457",""],[5563,"كَلَّ منِّي الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212143",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5670,"جئتُ يا شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=211123",""],[6102,"عرس برسم الدم!!","https://www.poetsgate.com/ViewPoem.aspx?id=186280",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[6189,"فواصل .. للصبح الجنوبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83603&r=&rc=70",""]],"verses":[["بَينَ جَمعٍ وَالمُصَلّى","ريمُ سِربٍ لا يُرامُ",0,"م",1,0],["بَينَ جَدٍّ بَذَّ الجُدودَ فَأَوفى","وَأَبٍ ضُمَّنَ العَلاءَ فَوَفّى",1,"ف",2,0],["بَينَ جَنبَيكَ ما بِجَنبَيَّ لَكِن","ما بِجَنبَيَّ مُستَديمُ الضِرامِ",2,"م",1,0],["بَيْنَ جِدٍّ وَبَيْنَ هَزْلٍ وَفِي الْحَالَيْ","نِ قَصْدُ التَّسْدِيدِ وَالتَّقْوِيمِ",3,"م",1,0],["بين جِمَالات وأشباهِها","من بَشَرٍ نامُوا عن المجْدِ",4,"د",1,0],["بَينَ جُفوني وَالكَرى","مُذ غِبتَ عَنّي مُعتَرَك",5,"ك",1,0],["بيْنَ جنبيْهِ خافقٌ","يتلظَّى بغايتهْ",6,"ه",1,0],["بين جمهور الناس صار مذاعاً","خبر كانَ أَمس غير مذاع",7,"ع",1,0],["بَيْنَ جِيرانِها وبينَ الغِنى الفا","ئِضِ أنْ أبعَثَ الجِيادَ مُغيرا",8,"ر",2,0],["بَيْنَ جَوٍّ مَعَ الْغَمَائِمِ سَارٍ","وَفَضَاءٍ مَعَ الْجَدَاوِلِ جَارِي",9,"ر",2,0],["بَيْنَ جِيلٍ خَلاَ وَجِيلٍ تَلاهُ","لَمْ تُبَدَّلْ جَوَاهِرُ الحَالاَتِ",10,"ت",1,0],["بَيْنَ جِيلٍ عَدُوِّ مَنْ","قَالَ صِدْقَاً وَمَنْ نَصَح",11,"ح",1,0],["بين جنبيه، جريح هاربٌ","من يد الموت، ومسلول فدائي",12,"ا",2,0],["بين جدرانها ركام الحكايا","من جديد القرى وأكفان تالد",13,"د",1,0],["بَينَ جفنيك الجَمال","وَبِعَطفيك الدَلال",14,"ل",1,1],["بين جَفْنَيْها وخَدَّيْها دَمي","هي للقلب دواءٌ والسَّكَنْ",15,"ن",1,0],["بَينَ جودٍ يَسيرُهُ يَطرُدُ الفَق","رَ وَقُربى تُعَلِّمُ الآدابا",16,"ب",2,0],["بين جنبيّ خفوقٌ كلّما","شاقهُ عهدُ الصبى والحبّ جنّا",17,"ن",2,0],["بين جنبيَّ جنانٌ خافق","وبجفنيَّ دموعٌ تذوف",18,"ف",1,0],["بين جنبيه لاعج ليس يهدي","من شجون ولوعة وغرام",19,"م",1,0],["بين جنيَّ خافِقٌ بعثَرُ العم","رَ دموعا على الورى وأنينا",20,"ن",2,0],["بين جفنيك حانةٌ من لحاظٍ","مسكرات حيناً وحيناً سكارى",21,"ر",2,0],["بين جنبيّ طائرٌ في السماوا","تِ ولكنّهُ كسيرُ الجناح",21,"ح",1,0],["بَينَ جِفني وَالكَرى معترك","وَاِختِلاف وَشَقاق وَعناد",22,"د",1,0],["بين جَمٍّ منهُمُ وسابورَ أقيا","لٌ يعدُّون مَولد الدهر عَدَّا",23,"د",2,0],["بين جفنيها مصرعي","غضت الطرف أو رنت",24,"ت",1,0],["بين جارٍ ذَمعُه أو صَارخٍ","يا أُخَيِّي يا أُخَيِّي يا اُخَي",25,"ي",1,0],["بين جمع وبين فرق شهود","واعتقاد حالٍ كعقد نظيم",26,"م",1,0],["بين جمرٍ يَشبُّه عاصف الوجد","وطول التمويه والإخلاف",27,"ف",1,0],["بين جزْر الحب والمدِّ","مَن يروم يْوِجّه شعوره",28,"ر",2,0],["بين جرد أو بين أجرد نهد","فوقه ضيغم طويل النجاد",29,"د",1,0],["بَينَ جِسمي وَالسَّقم سلم وَبَينَ ال","جفنِ وَالنَّوم عِندَما صَدّ حَربُ",30,"ب",1,0],["بين جيش يميع تحت شواظٍ","مثل ما تسلأ الدان فتسلى",31,"ل",2,0],["بين جنبي جذوة تتلظى","مهجتي فوق حرها الوقاد",32,"د",1,0],["بين جنبيّ همة حمّلتني","فوق هذى المصائب السود إصرا",33,"ر",2,0],["بين جنبَيْه نفسُ حرٍّ إذا ما","وطِئ النجمَ عاد بدرًا تماما",34,"م",2,0],["بين جفني والكرى حايس","يوم نوم الدّله في شوره",35,"ر",2,0],["بين جنبيِّ على البؤس فؤادُ","ما انقضى يوماً له فيكِ مرادُ",36,"د",1,1],["بين جنبيِّ فؤادُ","بين جنبيَّ فؤادٌ لم يزل",36,"ل",1,0],["بين جبيه فؤادُ","كلُّ ما في الحب همٌّ وعنا",36,"ن",2,0],["بَينَ جَنوبٍ وَصَباً تَغتَدي","طاوَعَها ذو لَجبٍ هاطِلُ",37,"ل",1,0],["بين جنبيه نفس حر كريم","لم تقس بالاشباه والانداد",38,"د",1,0],["بين جنبىّ خافق يحمل الود","د ويسري على جناح الوفاء",39,"ا",2,0],["بينَ جِدٍّ من المجونِ وَهَزْلٍ","وحلالٍ من سِحرِها وَحَرامِ",40,"م",1,0],["بي نجوى المرزأ المحروب","وحنين المتيم المسلوب",41,"ب",1,1],["بين جيم وبين خا خافي","بين تا وَالْفٍ نْحازي به",42,"ب",2,0],["بين جنبيه للصبابة واد","كل آن حمامه نواح",43,"ح",1,0],["بين جنبيك همة من جلاد","خلقت في الوغى صقال النصال",44,"ل",1,0],["بَينَ جَريحٍ وَطَريحٍ غادي","وَقُوَّةُ الطُروادِ في اِزدِيادِ",45,"د",1,0],["بَينَ جيرانٍ أَقاموا صُموتاً","لا يُحيرونَ جَوابَ المُنادي",46,"د",2,0],["بُينِ جلوسهِ البركاتُ حَلَّت","فَحَلَّت جيدَ مملكةِ تميسُ",47,"س",1,0],["بين جلفٍ من الجفاة وبين ال","أعراب هاتيكم الطغاة الطغام",48,"م",1,0],["بَينَ جَنبيك يا كَبير الأَماني","هُم شَعبٌ كَفيته أَحزانه",49,"ن",2,0],["بَينَ جَنبيه خافق في طَويا","ت مُلوك الثَرى وَعِندَ حَقيره",50,"ر",2,0],["بَينَ جَنْبَيكَ مَوطِنٌ كانَ يَحيا","ضَيَّعَ اليَومَ سَيفَهُ والمُثَنَّى",51,"ن",2,0],["بَينَ جَنبَيكَ طائِرٌ ضاقَ حَتى","ماتَ مِن فَرْطِ حُزنِهِ يَومَ غَنَّى",51,"ن",2,0],["بَينَ جَنبَيكَ شاعِرٌ لَم يُشَاهِد","مِن هَنَاءٍ _سِوى اسمِهِ_ مُذْ تَكَنَّى",51,"ن",2,0],["بين جنبيّ لهفة وانقبا ض","وحواليّ وحشة وجليد",52,"د",1,0],["بين جنبينا نفوس حرةٌ","شاء باريهن أن ترعى الذمارا",53,"ر",2,0],["بين جرح وبين خوف وبين طعنات القدر","طب ياحظي تخير أو تغير ياوذا",54,"ذ",2,0],["بين جنبيها فؤادٌ مفْعمٌ","بالرضا ... لا شيءَ غلًّا يعتريهْ",55,"ي",2,0],["بين جسريْ ( فنجا ١) نصبت خيامي","بين نهر الهوى وروض غرامي",56,"م",2,1],["بين جنبيّ خيالٌ جامحٌ","عالمٌ ما فيه قطرٌ أو جهات",57,"ت",1,0],["بَينَ جَنبَيَّ مُهجَةٌ تَتَشَظَّى","وَاختِلافاتُ أَضلُعٍ, وَاصطِفاقُ",58,"ق",1,0],["بينَ جمرٍ من أهازِيجِ الكَنَارِي","سابحًا في بحرِ حُلمٍ للإيابِ",59,"ب",1,0],["بين جفنيه ضمه بنهارٍ","وبليلٍ في يقظةٍ وهجود",60,"د",1,0],["بين جفنيك تستريح حُروفي","تتجلّى أحلى وأعمقُ جَرْسا",61,"س",2,0]]}