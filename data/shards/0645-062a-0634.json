{"poems":[[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[93,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[51,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[51,"إن امرأ رفض المكاسب واغتدى","https://www.aldiwan.net/poem66367.html","الكامل"],[70,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[28,"نام الخلي وما أغمض ساعة","https://www.aldiwan.net/poem5624.html","الكامل"],[61,"يأبى إذا خطر العقيق بباله","https://www.aldiwan.net/poem51464.html","الكامل"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[46,"كيف الرباح وقد تألى ربنا","https://www.aldiwan.net/poem22713.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[87,"كَمْ غادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِكَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23829&r=&rc=91",""],[202,"بيني وبينك يا ظلوم الموقف","https://www.aldiwan.net/poem53234.html","الكامل"],[227,"نعم المعين على الوغى في مأزق","https://www.aldiwan.net/poem50885.html","الكامل"],[233,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[233,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[259,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[280,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[369,"ما لي أراك مشمرا لمراسي","https://www.aldiwan.net/poem57364.html","الكامل"],[369,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[369,"طرفان طرف مساعد","https://www.aldiwan.net/poem57475.html","مجزوء الكامل"],[400,"أترى يعود من الحمى قلبي","https://www.aldiwan.net/poem34152.html","الكامل"],[426,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[462,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[462,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[513,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[565,"يا أيها الصلف المدل بحسنه","https://www.aldiwan.net/poem69737.html","الكامل"]],"verses":[["مُتَشاغِلٌ بالحَزْمِ يقْدَحُ زَنْدَهُ","لا يُسْتَفَزُّ بعابِثٍ أو لاهِي",0,"ي",1,0],["متشبث بالحق يرعاه","وبالله اعتضاده",1,"د",2,0],["مُتَشَمِّراً بِغُدُّوِّهِ وَرَوَاحِهِ","عَجِلَ الخُطَى مُسْتَرْسِلَ الأَرْدَانِ",2,"ن",1,0],["مُتَشَابِكَاتٍ يَرْتَضِعْنَ عَلَى المَدَى","مَاءَ الحَيَاةِ مَعاً وَهُنَّ هَوَانِي",3,"ي",1,0],["متشبِّثٌ بعلائقي متخلصُ","طوراً يماذِقني وطوراً يُخلصُ",4,"ص",1,1],["متشاغلاً عما يُمارِسُ غيرُهُ","حتى لقد أثرى اللِّئامُ وأعدما",5,"م",2,0],["مُتُّ شَوقاً فَأَحيِني بِوِصالٍ","أُخبِرُ الناسَ كَيفَ طَعمُ المَماتِ",6,"ت",1,0],["مُتَشابِهِي وَرَعِ النُفوسِ كَبيرُهُم","وَصَغيرُهُم عَفُّ الإِزارِ حُلاحِلُ",7,"ل",1,0],["مُت شَهيدَ الهَوى فَإِنَّ لِمَن ما","تَ مِنَ الحُبِّ ضِعفَ أَجرِ الشَهيدِ",8,"د",1,0],["مُتَشَعِّبٌ لا يَقتَضي في مَحفَلٍ","مِن فَهمِهِ شَيئاً وَلا إِفهامِهِ",9,"م",2,0],["مُتَشابِهانِ إِذا الأُمورُ تَشابَهَت","حَزماً وَعِلماً بِالطَريقِ المَهيَعِ",10,"ع",1,0],["مُتَشابِهينَ بُيوتُهُم بِمَجازَةٍ","لِلسَيلِ بَينَ سَباسِبٍ وَمِتانِ",11,"ن",1,0],["متشابهُ الطَّرَفينِ أصبحَ عمُّه","في ذُورةٍ لم تَعْدُ ذُروةَ خالِه",12,"ل",2,0],["مُتَشَابِهُ الطَّرَفَيْنِ يُنْبِئُ صَدْرُهُ","عَمَّا تَلاحَقَ فَهْوَ بَادِي الْمَعْلَمِ",13,"م",1,0],["مُتَشابِهاتٌ ما اِقتَضَينَ مَِن الفَتى","نَفَساً فَرامَ اللِيَ بِالإِعسارِ",14,"ر",1,0],["مُتَشَبِّعَاً مُترَوِّيَاً مِمَّا يَرَى","لِشِفاءِ مَسْغَبَةٍ بِهِ وَأُوَارِ",15,"ر",1,0],["مَتَشَاكِيَيْنِ هُمُومَنَا","وَكَثِيرُهَا مَحْضُ اشْتِكَاءْ",16,"ا",2,0],["مُتَشابِهُو وَرَعِ النّفُوسِ كَبيرُهم","وصَغيرُهمْ عَفُّ الإزارِ حُلاحِلُ",17,"ل",1,0],["متشنجون يخالَهم من راءهُم","للحزن – أنَهمُ عليه غِضاب",18,"ب",1,0],["مُتَشَابِهُ الطَّرَفَينِ، يُنبِىء ُ صَدْرُهُ","عما تلاحقَ ؛ فهوَ بادي المعلمِ",19,"م",1,0],["متشرِّب ماءَ البشاشةِ وجهُهُ","فعليه ريحان القلوب يرفرفُ",20,"ف",1,0],["مُتشاوسُ العينين يُربِي فيهما","حُسْناً على عَيْنِ الغزال الأَكْحلِ",21,"ل",1,0],["مُتَشَبِّهٍ بِاللَهِ لا تُعزى عَطا","ياهُ وَإِن كَثُرَت إِلى الإِسرافِ",22,"ف",1,0],["مُتَشابِهي الأَعطافِ لا مِن فِتيَةٍ","مِنهُم رَأَيتَ مُعَظَّماً وَمُمَجَّدا",23,"د",2,0],["متشرع الجنبات طال","عموده الصلب الرزين",24,"ن",1,0],["مُتَشَكٍّ خَصرُهُ مِن رِدفِهِ","ما تَشَكّاهُ ضَعيف مِن قَوِيِّ",25,"ي",1,0],["مُتَشابهُونَ كأنَّما أخلاقُهم","خُلِقَت بحذوٍ واحدٍ وقِياسِ",26,"س",1,0],["متشبِّهاً بعليٍّ ب","نِ عمارةِ بن عذافِرِ",27,"ر",1,0],["متشدِّداً في الرزقِ بي","نَ نوائبٍ وشدائدِ",28,"د",1,0],["متشبثاً بالنصح يزعمه","كتشبث الجبري بالكسب",29,"ب",1,0],["متشبثين ملطفه وبحلمه","فهو الرحيم المالك المأمول",30,"ل",1,0],["متشهِّراً في جوِّه","حتى كأني أبلقُهْ",31,"ق",2,0],["متشابه الإحسان عثر بنانه","تتلو وفود نداه محكم آيها",32,"ا",1,0],["متشابهين فإن عثرت بقصدهم","في أزمةٍ نفسوا عليك بدعدع",33,"ع",1,0],["متشابهي كرمِ الفعال يسير عن","مهديهِ ويحلُّ عند رشيده",34,"د",2,0],["متشفعاً برسول الله وابنته","وبعلها والحسين الطهر والحسن",35,"ن",1,0],["متشبهٌ بك حين تخطِرُ لاهِياً","وَتَمِيْسُ بين مجاسدٍ وعُقُودِ",36,"د",1,0]]}