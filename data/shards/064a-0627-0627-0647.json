جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[506,"يا أهل طيبة قلبي","https://www.aldiwan.net/poem2434.html","المجتث"],[514,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[529,"يا أهل صنعا وإن كانت أحبتنا","https://www.aldiwan.net/poem37099.html","البسيط"],[558,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[559,"للعيس شوق قادها نحو السري","https://www.aldiwan.net/poem69355.html","الكامل"],[573,"عاديت في الله قوماً أنكروا رصداً","https://www.aldiwan.net/poem3659.html","البسيط"],[586,"يا أهل نجد على هوائي","https://www.aldiwan.net/poem17456.html","مخلع البسيط"]],"verses":[["يا أَهلَ مَكَّةَ ما يَرى فُقَهاؤُكُم","في عاشِقٍ مُتَعاهِدٍ لِسَلامِ",0,"م",1,1],["يا أَهلَ فَوزٍ أَما لي عِندَكُم فَرَجٌ","وَيلي وَلا راحَةٌ مِن طولِ تَعزيري",1,"ر",2,0],["يا أَهلَ فَوزَ اِدفِنوني بَينَ دُورِكُمُ","نَفسي الفِداءُ لِتِلكَ الدور مِن دورِ",1,"ر",1,0],["يا أَهلَ يَثرِبَ ما تَقضونَ في رَجُلٍ","صَبِّ الفُؤادِ كَئيبٍ غَيرِ مَمنوحِ",2,"ح",1,0],["يا أَهلَ وَدي بِالشَآمِ تَحِيَّةً","مِن نازِحٍ لَم يَبقَ فيهِ سوى ذَما",3,"م",2,0],["يَا أَهْلَ لُبْنَانَ لا زَالَتْ مَكَارِمُكُمْ","مُجِيبَةً مَنْ دَعَا يَا أَهْلَ لُبْنَانِ",4,"ن",1,0],["يَا أَهْلَ جِزين الَّذِينَ تَجَمَّلُوا","بِمَكَارِمِ الأَخْلاقِ وَالعِرْفَانِ",5,"ن",1,0],["يَا أَهْلَ لُبْنَانَ إِنَّ الضَّيْفَ عِنْدَكُمُ","هَدِيَّةُ اللهِ فِيمَا قِيلَ مِنْ قِدَمِ",6,"م",1,0],["يَا أَهْلَ هَذِي الدَّارِ لا بَرِحَتْ بِكُمْ","مَأْهُولَةً مَرْفُوعَةَ الأَعْلامِ",7,"م",1,0],["يا أهل نجد سقى الوسميُّ ربعَكُمُ","غيثاً يُنيلُ غليلَ التُّربِ ما اقترحا",8,"ح",2,0],["يا أهل ذا الجبل المنيع مكانه","تفدى مواطنكم بكلّ مكان",9,"ن",1,0],["يا أهل مصر عزاءكم فمصابكم","أمر قضاه الله في تقديره",10,"ر",2,0],["يا أهل لندن ما أرضت سياستكم","أهل العراقين لا بدواً ولا حضرا",11,"ر",2,0],["يا أهل مصر وأنتم مثلنا عرب","ما قلتم عندما اعلمتم الخبرا",11,"ر",2,0],["يا أَهلَ جُزرَةَ لا حِلمٌ فَيَنفَعُكُم","أَو تَنتَهُنَ فَيُنجي الخائِفَ الحَذَرُ",12,"ر",1,1],["يا أَهلَ جُزرَةَ إِنّي قَد نَصَبتُ لَكُم","بِالمَنجَنيقِ وَلَمّا يُرسَلِ الحَجَرُ",12,"ر",1,0],["يا أهلَ فضلِ اللهِ إنَّ لبيتكم","فضلاً يروح له الثناء ويغتدِي",13,"ي",1,1],["يا أَهلِ ما بالُ هَذا اللَيلِ في صَفَرِ","يَزدادُ طولاً وَما يَزدادُ مِن قِصَرِ",14,"ر",1,1],["يا أَهلَ مِصرَ رَمى القَضاءُ بِلُطفِهِ","وَأَرادَ أَمراً بِالبِلادِ فَكانا",15,"ن",2,0],["يا أَهلَ حَوزَةِ أَذرَبيجانَ الأُلى","حازوا المَكارِمَ مَشهَداً وَمَغيبا",16,"ب",2,0],["يا أَهلَ وُدِّيَ إِنّي قَد لَطَفتُ بِكُم","في الحُبِّ جُهدي وَلَكِن لا تُبالوني",17,"ن",2,0],["يا أَهلَ جَيرونَ جُرتُم بَعدَ مَعدَلَةٍ","ظُلماً وَعَوَّدتُموني غَيرَ مَعهودي",18,"ي",1,0],["يا أُهَيلَ الوُدِّ أَنتِم مُرادي","وَإِلَيكُم في العَلاءِ اِنتِسابي",19,"ب",2,0],["يا أهلَ بدرٍ فيكمُ","وسنانُ عاطٍ عاطرُ",20,"ر",1,0],["يا أهلَ مصرَ هكذا وليتمُ","حلباً لجلفٍ مالكيِّ المذهب",21,"ب",1,1],["يا أهلَ مصرَ وقاكمُ اللهُ الأذى","وليتمُ طرفاً على الأوساط",22,"ط",1,1],["يا أهنأ الساع في دنياي أجمَعُها","إذا عددتُ الهنيء الحلوَ من عُمري",23,"ر",2,0],["يا أَهلَ بابِل ما نَفِستُ عَليكُمُ","مِن عَيشُكُم إِلّا ثَلاثَ خِلالِ",24,"ل",1,1],["يا أَهلَ سَبتَةَ هَذِهِ السِيَرُ الَّتي","أَبدَت فَضائِلَ مَن مَضى في مَن بَقي",25,"ق",2,0],["يا أَهلَ سَبتَةٍ اِشكُروا آثارَهُ","إِنَّ المَواهِبَ قَيدُها أَن تُشكَرا",26,"ر",2,0],["يا أَهلَ مَصرَ قُرونَكُم سَقَطَت","مِن بَعدِهِ فَرُؤوسُكُم مُلسُ",27,"س",1,0],["يا أَهلَ مِصرَ لَقَد غِبتُم بِأَجمَعِكُم","لَمّا حَوى قَصَبَ السَبقِ المَسابيحُ",28,"ح",1,0],["يا أَهلَ بَغدادَ أَلقى ذا بِحَضرَتِكُم","فَكَيفَ لَو كُنتُ بَينَ التُركِ وَالخَزَرِ",29,"ر",1,0],["يا أَهلَ وُدّي عَلاما","صَرَمتُموني فَقولوا",30,"ل",3,0],["يا أهلَ وِدّي هل لراجي وَصْلِكُمْ","طَمَعٌ فيَنعَمَ بالُهُ استِرْوَاحا",31,"ح",2,0],["يا أهلَ وُدّي أنتم أَمَلي ومَن","نَادَاكُمُ يا أَهْلَ وُدّي قد كُفي",32,"ي",1,0],["يا أُهَيْلَ الوُدّ أنّى تُنْكِرُو","نيَ كَهْلاً بعدَ عِرفاني فُتَي",33,"ي",1,0],["يا أَهل بيروت لا أَنسى حفاوتكم","إذ جئت أدلف في بيروت من كبري",34,"ر",2,0],["يَا أَهْلَ ذَا النَّادِي أَلَيْسَ بِكُمْ فَتَىً","يَرْثِي لِوَيلاتِ الْمَشُوقِ الْمُولَعِ",35,"ع",1,0],["يَا أَهْلَ ذا الْبَيْتِ الرَّفِيعِ مَنَارُهُ","أَدْعُوكُمُ يَا قَوْمُ دَعْوَةَ مُقْصَدِ",36,"د",1,0],["يا أَهلَ هُودٍ إذا الوَرَى حُسِبُوا","مِن صَدَفِ البحرِ كنتمُ دُرَرَه",37,"ر",2,0],["يا أهْلَ الشوقِ لنا شَرَقٌ","بالدّمعِ يَفيضُ مَوْرِدُهُ",38,"د",2,0],["يا أهلَ ودِّيَ لا واللهِ ما اِنتكثَتْ","عندِي عُهودٌ ولا ضاقَتْ مودَّاتُ",39,"ت",1,0],["يا أهلَ بغدانَ، راعوا الله في رحِمٍ","موصولةٍ قُطِعَتْ، يا أَهل بغدانا",40,"ن",2,0],["يا أهلَ ودِّي هلْ لراحي وصلكمْ","طَمَعٌ، فَينعَمَ بالهُ استِرْواحا",41,"ح",2,0],["يا اهل ريم حاجر بحقكم","رفقا بعين سيلها اسالها",42,"ل",3,0],["يا اهل ذاك الحي حبي لكم","صار لقلبي في الهوى مذهبا",43,"ب",2,0],["يا أهيفا وجهه","مستطلع كوكبا",44,"ب",2,0],["يا أهل زينب اعلموا لي زينباً","كوني لزينب طائعاً منقادا",45,"د",2,1],["يا أهل يافا لقد واللّه أَرقني","برق تألق في أجواء حسبان",46,"ن",1,0],["يا أهَيْلَ الغُوَيْرِ لا غرو إن أَصبحتُ","مِن بَعْدِكم كَئيبَ الفؤادِ",47,"د",1,0],["يا أهل طيبة ما لكم لم ترحموا","صبا غدا لنوالكم متكفّفا",48,"ف",2,0],["يا أهل مصر رأيت أيديكم","من بسطها بالنوال منقبضه",49,"ه",1,1],["يا أهل ودى هل رأيتم سيدا","رضى المقام على قطيعة عبده",50,"د",2,0],["يا أهلَ جُرجانَ عفاءً على","أرضكُمُ الكالحةِ العابسَةْ",51,"س",2,1],["يا أهلَ بيتِ الوحيِ أما مدحُكم","معْ فرطِ دُرْبتنا فقد أعيانا",52,"ن",2,0],["يا أهلَ ليلايَ مُذ شطّ المزارُ بكم","لا الحيُّ حيّي ولا الجيرانُ جيراني",53,"ي",1,0],["يا أهل من أهوى رضيتم لابنكم","أن تبصروه قاتلاً لمُوَحِّدِ",54,"د",1,0],["يا أهيل الود يا أهل الوفا","والصّفا والجود يا أهل النّوال",55,"ل",1,0],["يا أهيل الحمى وعرب الفريق","علّ من نظرة لصب مشوق",56,"ق",1,1],["يا أهل أسيوط ليت الطير تخبرني","بأنكم لفؤادي خير قربان",57,"ن",1,0],["يا أهل أسيوط لن يبقى لكم أثرٌ","إذا منيتم بإلحادي وكفراني",57,"ي",1,0],["يا أهلَ أسيوطَ لا زلتم بعافيةٍ","وإن تمرّد في وجدى بكم دائي",58,"ي",1,1],["يا أَهلَ بَغداذَ مالي بَينَ أَظهُرِكُم","كَأَنَّني مَسجِدٌ بِالكَرخِ مَهجورُ",59,"ر",1,1],["يا اهيل العقيق بنتم فدمعي","دره بعد بعدكم مرجان",60,"ن",1,0],["يا أهلَ مصرَ مقامُ الحزنِ محترمٌ","فأسكتوا معبداً منكم وزريابا",61,"ب",2,0],["يا أهْلَ وِدّي لِم أرومُ تَدانِياً","مِنكُم ودَارُكُمْ تَبينُ وتَنْزَحُ",62,"ح",1,1],["يا أَهلُ نَجدٍ بِكُم وَاللَه قَد وَضَحَت","لِعاذِلي في الهَوى العُذرِيِّ أعذاري",63,"ي",1,0],["يا أهل الحسب والنسب الأسي","والعلم والحلم والتقوى",64,"ق",3,0],["يا أَهلَ بيتٍ لهُ العلياءُ والعظمُ","وَمنهُ للأممِ الآلاءُ والعصمُ",65,"م",1,1],["يا أهلَ بيتِ رسولِ اللّه جاهكم","عِند الإله عظيمُ الخطرِ محترمُ",65,"م",1,0],["يا أَهلَ بيتِ رسول اللّه رُكنكم","حِمىً منيعٌ به تًسعتصمُ الأممُ",65,"م",1,0],["يا أَهلَ بيتِ رسولِ اللّه ذِكركم","هو الشفاءُ إِذا ما أعضل الألمُ",65,"م",1,0],["يا أَهلَ بيتِ رسولِ اللّه لا حرمٌ","إلّا حِماكم بيومٍ شرّه عممُ",65,"م",1,0],["يا أَهلَ بيتِ رسولِ اللّه كَم مننٍ","لِجاهكم شَهِدَتها العربُ والعجمُ",65,"م",1,0],["يا أهلَ بيتِ رَسول اللّه نصرتكم","لِمَن عليه بَغي الحسّاد واِجترموا",65,"م",3,0],["يا أَهلَ بيتِ رسولِ اللّه همّتكم","تَأسو الّذي كَلَمت مِن عرضنا الكلمُ",65,"م",1,0],["يا أهلَ بيتِ المصطفى","دُمتم كعقد نضدا",66,"د",2,0],["يا أَهلَ تونسَ قد هَوى عن أفقكم","بدرٌ علومُ الدينِ كنّ بروجه",67,"ج",2,0],["يا أهلَ تونس قَد طَحا في أرضكُم","عَلمٌ ستفقد رسوهُ وعروجه",67,"ج",2,0],["يا أَهل تونسَ إِنّ حافظ سنّة ال","مُختار فارقكُم وجدّ نؤوجه",67,"ج",2,0],["يا أهل تونس إنّ حاملَ رايةِ الت","تَفسيرِ للأُخرى حَدا حرجوجه",67,"ج",2,0],["يا أهلَ تونسَ لا عزاءَ بهِ ولا","لومٌ عَلى باكٍ يطيلُ نشيجه",67,"ج",2,0],["يا أهلَ تونس إنّ روعة نعيهِ","تجفي الدموعَ وتعزبُ المخلوجه",67,"ج",2,0],["يا أهلَ تونسَ إِنّ جرعة فقدهِ","لأمرّ مِن كأسِ الردى الممجوجه",67,"ج",2,0],["يا أهلَ تونس رُزؤه مستأصلٌ","مِن دوحةِ الإسلامِ أيّ وشيجه",67,"ج",2,0],["يا أهلَ تونس إنّ أفجعَ هالكٍ","مَن لا نَرى أحداً يشقّ رهوجه",67,"ج",2,0],["يا أهل نجد وما نجد وساكنها","حسناً سوى جنة الفردوس والعين",68,"ن",1,0],["يا أَهلَ وُدّي يا خِلانَ ياثِقَتي","ما القَولُ ما الرَأيُ ما التَدبيرُ ما العَمَلُ",69,"ل",1,0],["يا أهلَ تُدمِيرَ إنَّ جَارَكُمُ","صِيدَ على مَا تَرَونَ مِن حَذَرِه",70,"ر",2,1],["يا أَهيل العِشق هَل من منجد","هَل سَلا الاِحباب ذَوو جد وَساد",71,"د",1,0],["يا أهلَ بغدادٍ سقَى عَهْدِي بكم","غيْثٌ يَبيتُ لكم كَدْمعِي ساكِبا",72,"ب",2,1],["يا أهل العقول السالمه وأهل القلوب العالمه","قولوا بهمه عازمه",73,"ه",1,1],["يا أهيل الفضل منوا","أصلحوا فضلا شؤني",74,"ن",2,0],["يا أهيل الجود منا","منكم أن تحرسوني",74,"ن",2,0],["يا أهيل الصفح صفحا","وافرا فوق الظنون",74,"ن",1,0],["يا أهيل الفضل والكرم","استروني واغفر وازللي",75,"ي",1,0],["يا أَهلَ سارِيَةَ السَلامِ عَلَيكُمُ","قَد قَلَّ في أَرضيكُم الخطباءُ",76,"ا",2,1],["يا أهل بابل رفقاً بعضَ صدّكم","ما لي على البين والهجرانِ من جلدِ",77,"د",1,0],["يا أهل ذا البيت الرَّفيع عماده","وانحطَّت الملوان دون عماده",78,"د",2,0],["يا أهل هذا الحي كيف تصبري","عنكم ومن لي بالفؤاد الصابر",79,"ر",1,0],["يا أهيفاً جاء يسبي","بحسنهِ كل صبّ",80,"ب",1,1],["يا أهلَ رامةَ ما ريمكُمُ عَدا","في فتْكةٍ بالأسْدِ عن عاداتِه",81,"ت",2,0],["يَا أهلَ صَبرَةَ وَالأحبَابُ عِندَكُمُ","إن كَانَ عِندَكُمُ صَبرٌ فَوَاسُونِي",82,"ي",1,0],["يا أهل ليلى من ورا","كم مثلنا قد افتنا",83,"ن",2,0],["يا أهل نزوى أنتم في نعمة","ما سادكم هذا الكريم المنعم",84,"م",1,0],["يا أهل لبنان ما ذا العهد كان بكم","يا أهل لبنان قد اصمعت آذاني",85,"ن",2,0],["يا أهل ودى وانهى","قصدى وانس مرادي",86,"د",2,0],["يا أهلَ نَعمانَ اسمعوا دعوةً","إن أسمَعتكم من لوى عاقلِ",87,"ل",1,0],["يا أهل عبدةَ هل يدٌ يفدَى بها","قلبٌ أسيرٌ بينكم لطليقِ",88,"ق",1,0],["يا أهل بابلَ لا طار الوفاء لكم","بعدي إذا سرت في جوّ ولا هبَطا",89,"ط",2,0],["يا أهل ودِّي وما أهلاً دعوتُكُمُ","بالحقِّ لكنها العاداتُ والدُّرَبُ",90,"ب",1,0],["يا أهلَنا.. ليسَ في حَربِ العِدا خَلَلٌ","بَلْ قَتلُكُم بَعضُكُم بَعضا ًهوَ الخَلَلُ",91,"ل",1,0],["يا أهلَنا.. يا عراقيّون .. يا أ ُنُفُ","يا حافِرينَ قُبورا ًفَوقَها وَقَفوا",92,"ف",3,0],["يا أهيل الحي يا ساقي الملاح","بمدام أسكرت كل غزل",93,"ل",1,0],["يا أهل منعرج اللوى بحياتكم","لا تتركوني مضغة الأهوالِ",94,"ل",1,0],["يا اهل بَدرٍ ويا اهلَ المهارِكِ في","لَيلِ المعامِعِ هذا الحربُ فاتَّحِدوا",95,"د",3,0],["يا أهل جرعاء الغوير بحقكم","عطفاً علي فمهجتي مشويه",96,"ي",2,0],["يا أهل