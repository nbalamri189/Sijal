/poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83359","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83356","الخفيف"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198224","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66138","الكامل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123458","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72862","الخفيف"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99110","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[4728,"يوم سلّم","https://www.poetsgate.com/ViewPoem.aspx?id=176949",""],[4801,"أجميل بالمرء يخلف وعداً","https://www.poetsgate.com/ViewPoem.aspx?id=86681",""],[585,"يا صارخاً أجفلت من صوته الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=161844",""],[585,"حي الشريف وحي البيت والحرما","https://www.poetsgate.com/ViewPoem.aspx?id=161911",""],[3591,"لا زاهدٌ في الدنيا كلٌّ لقد كذبا","https://www.poetsgate.com/ViewPoem.aspx?id=149398",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5198,"نجمة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=135527",""],[5299,"رسالة من الحدود","https://www.poetsgate.com/ViewPoem.aspx?id=210541",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5397,"عز الحمى فثوى بالأمن خائفه","https://www.poetsgate.com/ViewPoem.aspx?id=157940",""],[5409,"لم ينل من علاك كل أثيم","https://www.poetsgate.com/ViewPoem.aspx?id=155489",""],[5431,"جلجامش القصيد...","https://www.poetsgate.com/ViewPoem.aspx?id=211485",""],[5461,"عيون الهنوفه","https://www.poetsgate.com/ViewPoem.aspx?id=5290",""],[5538,"ليس عار أن يقال","https://www.poetsgate.com/ViewPoem.aspx?id=142641",""],[4623,"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5939,"اضرب كي تقطع رأس الأفعى","https://www.poetsgate.com/ViewPoem.aspx?id=136646",""],[1920,"المسدّس","https://www.poetsgate.com/ViewPoem.aspx?id=191344",""],[6031,"قُلْ لِمَنْ يُرْجِعُ الحَوَائجَ","https://www.poetsgate.com/ViewPoem.aspx?id=46404",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6082,"كفاني","https://www.poetsgate.com/ViewPoem.aspx?id=58991",""],[242,"يا جميل الصبر لب من دعا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563798",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6225,"تفسيرٌ آخر لحلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81300&r=&rc=327",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""],[5567,"حلول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69071&r=&rc=9",""]],"verses":[["واِقتَدى بِالقَومِ يَدعو","هُ هَواهُ فَيُجيبُهْ",0,"ب",2,0],["وَأقْتَفي حِينَ أَرُومُ العُلا","آثارَ آبَاءٍ مَناجِيبِ",1,"ب",1,0],["وأقتدي بضَجيعَيْكَ اقتِداءَ أبي","كِلاهُما دَمُ مَن عاداهُ مَطلولُ",2,"ل",1,0],["وأقْتَحِمُ الأخْطارَ والأرضُ تلْتَظي","وألْتَهِمُ الأقْطارَ والهَوْلُ يغْتَدي",3,"د",2,0],["وَاِقتَنِع بِالقَليلِ مِن بِرِّ مِثلي","وَاكشُط اِسمي وَخُطَّ مَن شِئتَ غَيري",4,"ر",2,0],["وَأَقتَحِمَ الأَمرَ الجَسيمَ بِحَيثُ أَن","أَرى المَوتَ خَلفي تارَةً وَأَمامي",5,"م",2,0],["وَاقْتَدُوا بِالِهلالِ كَانَ وَلِيدا","مُنْذُ حِينٍ فَصَارَ بَدْراً تَمَامَا",6,"م",2,0],["واقتحمنا لأجله كل هَوْل","وركِبنا لأجله الأخطارا",7,"ر",2,0],["وَاِقتُسِمَ الفَيءُ دونَ الناسِ كُلِّهِمُ","وَبَدَّدوهُ جِهاراً بَينَهُم هَدَرا",8,"ر",2,0],["واقتحامي وللهوى عزماتٌ","يقتحمْن العِقابَ أيَّ اقتحام",9,"م",1,0],["وَأَقتَلِ قاتِلٍ لِلدَهرِ خُبراً","وَأَصبَرِ صابِرٍ لِلغاشِياتِ",10,"ت",1,0],["وَاِقتَصَرنا عَلى الَّتي فاجَأَتنا","وَردَةٌ عِندَما اِستُشِفَّت لِوَردِ",11,"د",1,0],["وَإِقتَصَرنا عَلى الدَنانيرِ فَإِجعَل","ها لَنا نِحلَةً وَإِن شِئتَ قَرضا",12,"ض",2,0],["واقتَسَما باللَّحظِ في المُعَجَّرِ","وجَمَّشا الوَردَ بِوَرْدٍ أحمَرِ",13,"ر",1,0],["واقتدِحْ نارَ سرورٍ زَنْدُها","حينَ يخبو وجهُ ساقٍ وقَدَح",14,"ح",1,0],["وَاِقتَرَضنا مِنها الدُموعَ فَقالَت","كُلُّ قَرضٍ يَجُرُّ نَفعاً حَرامُ",15,"م",1,0],["وَاِقتَدَحوا بِالوَعيدِ نارَ وَغىً","وَرُبَّ نارٍ وُقودُها الكَلِمُ",16,"م",1,0],["واقتضى الشهرُ من معاليك صنعاً","مُعْلياً منه همّةً باهتمامِ",17,"م",1,0],["واقتادَ حِزْبَ اللَّه نَحوَ عَدُوِّهِ","فالحرْبُ تَجْدَعُ مَعْطِسَ المُتَمرِّدِ",18,"د",1,0],["واقتدى بالبحرِ دهري إذْ بهِ","يرسبُ الدرُّ وتطفو الجيَفُ",19,"ف",1,0],["واقتدِ بالموتى على أنَّهُ","لا بدَّ للحيِّ من الأحْيا",20,"ي",2,0],["وَاِقتَصِدي في المَلامِ وَاِتَّرِكي","بَعضَ التَجَنّي عَلَيَّ وَالغَضَبِ",21,"ب",1,0],["واقتسمنا كِسْرةَ الخُبز معاً","وكتبنا بالدِّما عهداً وثيقا",22,"ق",2,0],["وَاِقتُلا هَمَّنا بِصِرفِ عُقارٍ","وَاِترُكا الدَهرَ فَما شاءَ كانا",23,"ن",2,0],["وَاقتفى إثْرَهُ سُراقَةُ فاستَهْ","وَتهُ في الأَرْضِ صافنٌ جَرْداءُ",24,"ا",2,0],["وَاقتضَاهُ النبيُّ دَيْنُ الإِراشي","يِ وَقد سَاء بيعُهُ وَالشِّرَاءُ",24,"ا",2,0],["وَاقْتَضَتْنِي الشِّوارَ بَغْياً عَلَى مَنْ","بيتُهُ ليسَ فيهِ غير حَصِيرِ",25,"ر",1,0],["واقتحم العَسكرُ في المدينَه","وهُو بها كهيْئةِ الظعينَهْ",26,"ه",1,0],["واقَتَحموا الشِّعابَ والمَكامِنا","وأَسْلموا الحُصونَ والمَدائِنا",26,"ن",2,0],["واقتباسُ الأنوارِ من ظاهري","غيرُ عجيبٍ وباطني مأواكا",27,"ك",2,0],["واقتحامي الضُّحى عليها كراعٍ","أسيويٍّ أو صائدٍ إفريقي",28,"ق",2,0],["وأقْتالُ حَرْبٍ يُفْقَدُ السّلْمُ فيهِمُ","على غيرِهمْ أمْضَى القَضاء واقْتال",29,"ل",1,0],["واقتحموا الشام فزال شومها","وضاق ذرعا بهم غشومها",30,"ه",2,0],["واقْتَدْتُهُ بشَكائِمِي","فانْقاد في تِلْكَ الشَّكائِمْ",31,"م",1,0],["وَأَقْتَلُ دَاءٍ رُؤْيَةُ العَيْنِ ظَالِماً","يُسِيءُ وَيُتْلَى في الْمَحَافِلِ حَمْدُهُ",32,"د",2,0],["وَاِقتَنِع فَموسِعُها","راحِلٌ كَمُقتِرِها",33,"ر",3,0],["وَاِقتَصَرتُ الحَديثَ دونَ الَّذي قَد","كانَ مِن قَبلُ يَعلَمُ الأَسرارا",34,"ر",2,0],["واقتلعنا جلودنا بيدينا","وفككنا حجارة الاكوان",35,"ن",1,0],["واقتاده بأرسان","الشعر حبلٌ فتان",36,"ن",1,0],["واقتحام المجيد في الروع لا ير","قب سعدا أو ينثني لمخوف",37,"ف",1,0],["واقتنى الدر من علوم الاشارا","ت فحلى به صدور النوادي",38,"د",2,0],["واقترابي حتى شمعت وعودي","بأسى جبئتي وهزء انصرافي",39,"ف",2,0],["وأقتطف الصفو من وهمه","كما يقطف الواهم الفرقدا",40,"د",2,0],["وَاقْتَضَتْني الشِّوارَ بَغياً عَلَى مَنْ","عنك آياتُها قَعُودَ حَسِيرِ",41,"ر",1,0],["واقتحمنا حديدا ولظى","وجزيناه اعتداء باعتداء",42,"ا",2,0],["وِاقتَنَيتمُ شَمسَهُ لُؤلُؤَةً","وِرِكبتمُ أَنجمُ اللَّيلِ خُيُولاَ",43,"ل",2,0],["وأقتل عطري .. عامدا متعمداً","وأخرج من جنات عينيك هاربا",44,"ب",2,0],["واقتن الطيبات ان رمت يوما","لك من زمرة النساء عيالا",45,"ل",2,0],["واقتراب ما البعد أصعب منه","واتصال أدهى من الإنفصال",46,"ل",1,0],["واقتَفَى في الخُطَا خُطَاه وطه","لم يزل عن سبيله مفطوما",47,"م",2,0],["واقتنَى إرعِواءً ليتَ شَعرِى","أمقدُورٌ أَن أقتني إرعوَاءَ",48,"ا",2,0],["وَاِقتَد بِما أَسدَت يَداكَ مَدائِحاً","لَولاكَ لَم يُملَك لَهُنَّ قِيادُ",49,"د",1,0],["واقتاد أهواء النفوس فما ترى","إلاَّ حجا ماض وعشقاً مقبلا",50,"ل",2,0],["وَاِقتفاهُ فِتيانهم وَذوو النج","دةِ منهم وقُبّح الإقتفاءُ",51,"ا",2,0],["وَاِقتَفاها سُراقةٌ لاِستراقِ الن","نورِ مِنها كأنّه الحرباءُ",51,"ا",2,0],["وَاِقتَفَتهم تلكَ الصقورُ فَطاروا","وَلَهُم كالبغاثِ يَعلو زقاءُ",51,"ا",2,0],["وَاِقتَرنا بالشِعبِ شعبِ طالبِ","أَكرِم بِهذا مِن قرانِ سعدِ",52,"د",1,0],["واقتنِ المجدَ مقيماً وادعاً","بالوَفا أو بالسُّرى غيرَ مقيم",53,"م",1,0],["واقتل باحسانك فقري الذي","صال فلا اثم على القاتل",54,"ل",1,0],["وأقتل أحزاني وأحيى بشاشتي","ويسمع منى فاتني فأقول",55,"ل",1,0],["واقتراحِي له عليكَ لِعلمي","أنني مخلِصٌ لديك مُدِلُّ",56,"ل",1,0],["واقتنى العزَّ بالظُّبا والعوالي","واشترى الحمدَ بالنَّدى والسَّماح",57,"ح",1,0],["واقتداء بشيخ صدق عليم","سالك قد بنى على خير أس",58,"س",1,0],["وَاِقتادَ فيهِ خَواطِري نَحوَ الهُدى","مَلكٌ وَأَدبَرَ خاسِئاً شَيطاني",59,"ن",2,0],["وَاِقتَنِع مِنها بِما في وُسعِها","لا تُكَلِّفها سِوى إِمكانِها",60,"ن",3,0],["وَاِقتَنِص حُرَّ الثَناءِ فَما","كُلَّ وَقتٍ يَعلَقُ الشَرَكُ",61,"ك",1,0],["وَاِقتِناصِ الأَعداءِ بِالأَعوَجِيّا","تِ المَذاكي وَالمُرهَفاتِ الذُكورِ",62,"ر",1,0],["وَاِقتَعَدوها ضُمَّراً","أَجرى مِنَ الرِياحِ",63,"ح",1,0],["وَاقْتَصِرْ وَاللهِ مَا نَعْلَمُ مِنْ","أَحَدٍ قَدْ سَدَّ مِنْهُ مَوْضِعَا",64,"ع",2,0],["وَاقْتَنِ الصَّبْرَ لِلنَّوَائِبِ وَاعْلَمْ","إِنَّمَا يَقْتَنِِي الذِينَ اقْتَنَوْهُ",65,"و",2,0],["وأقتادُ لَيثَ الغابِ واللَّيثُ مُخدِرٌ","ويقتادني الظبي الغريرُ فأتبَعُ",66,"ع",1,0],["واقتباس الوغى لنا وقت باسٍ","واصطلام العداة من وسط لام",67,"م",1,0],["واقتحام الأمور من وقت حامٍ","بأسنا حام في حمى الوقت حام",67,"م",1,0],["واقتبس جذوة التجلّي بسينا","ء سناً لاح من جميع جهاتك",68,"ك",1,0],["وأقتلُ ما ألقى من البينِ أنَّ لي","هنالِك أُماً ضائعٌ دمعُها الغالي",69,"ل",2,0],["واقتَفاها مِن أبِيه سُنَناً","سارَ في الناسِ بها أوْ سِيَرا",70,"ر",2,0],["وَاقْتَدَى الرُّهْبَانُ فِي نُدْبَتِهِ","بِلَبيد في أَخيهِ أرْبَدِ",71,"د",1,0],["واِقتَفى إِثرَ جَدِّه وأَبيه","سالِكاً مَنهجَ الهُدى والصَوابِ",72,"ب",1,0],["واقتد بتاج الأصفيا علم الهدى","زين الوجود محمد خير البشر",73,"ر",1,0],["وَاِقتَعِد صهوةَ جدٍّ أمرحِ","وَاِستند طودَ ذمامٍ أمنعِ",74,"ع",1,0],["وَاِقتُل المرَّواسَ في كُلِّ مَجمَعٍ","إِذا ضَعضَعَ الدَهرُ الجُموعَ وَكَبكَبا",75,"ب",2,0],["وَأَقتُلُ جَهلَ المَرءِ بِالحِلمِ وَالتُقى","وَإِن رامَ قَرضي حالَ مِن دونِهِ قَرضي",76,"ض",2,0],["وَأَقتَحِمُ الصِراطَ بِغَيرِ شَكٍّ","إِلى نارٍ لِعارِفِها تَلوحُ",77,"ح",1,0],["وَاِقتَفى أَنجالهُ آثاره","وَبِذاك القَصدِ كُلٌّ نَجحا",78,"ح",2,0],["وَاقتَطِف وَرد جنتي طربا","اِن خَدّي عَن قطف غيرك صانَه",79,"ن",2,0],["وَاِقتَصِر يا عَذول فَهو مُرادي","جادَ أَو جارَ أَو تَطَوّل أَو مل",80,"ل",1,0],["وَاِقتطفنا من روحِه ثَمرات","قَد تناهت فَليس بحصرها العد",81,"د",1,0],["واقتدَى بالّذي رُوِي لك من شِعْ","رِك حتّى صار المُجِيدَ المُفَدّى",82,"د",2,0],["واقْتاده سَعْدُهُ","إليه أَيَّ اقْتِياد",83,"د",1,0],["وَاِقتُلِ الكَأسَ بِمَزجٍ","تَقتُلِ الهَمِّ يَقينا",84,"ن",2,0],["واقتد باهل المعارف والحجا والعقول","وجانب الناس بالمرة تنل كل سول",85,"ل",1,0],["واقتطفنا لطائف الطائف","وفي الروض تقطف الأنوار",86,"ر",1,0],["واقتفوا آثارها فهي التي","بهدى أهل التُّقى قد هديت",87,"ت",1,0],["واقتِسامِ الأموالِ من وَقتِ سامٍ","واقتحامِ الأهوالِ من وَقتِ حامِ",88,"م",1,0],["واقتحام الأبطال في وقت حام","واقتسام الأموال في وقت سام",89,"م",1,0],["وأقتَدي بالوَرى قبلي فكم فَقدوا","أخاً وكم فارقوا أهلاً وجيرانا",90,"ن",2,0],["وأقتَلُ أدْوائِي بِعادُ أحبّتِي","وداءُ التّنائِي ما علمتَ قَتُولُ",91,"ل",1,0],["واقتحمها إذا نَبَتْ بك يوماً","فأرى المجدَ بابُه الاقتحام",92,"م",1,0],["واقتطفنا من الخُدود وُروداً","وهَصَرنا قدًّا من الغيد غضّا",93,"ض",2,0],["وأقتحم الأمر المهول وما العُلى","بغير العوالي والسُّيوف البواتر",94,"ر",1,0],["واقتبس النار من ضلوعي","ففي الحشا حشوها شعيل",95,"ل",1,0],["واقتران بالتهاني","دائما ما طال دهر",96,"ر",1,0],["واقتسمنا مكانَ عارِضِ غيثٍ","عِشْتُ في ظلَّهِ وكنتُ النَّباتا",97,"ت",2,0],["واقْتَضَتْ عنده الرَّفاهَةُ أَنِّي","صارَ يومي سَبْتاً ونَوْمِي سُباتا",97,"ت",2,0],["واقتصرْنا على القليل الى أن","تشتري هامةً من القلاّلِ",98,"ل",1,0],["واقتادَ شاردَ حظّه ذو همّةٍ","راضَتْ بقصدِ ذَراك صعبَ جِماحِه",99,"ح",2,0],["واقتضي همماً شيئاً لا مفاز به","والجد يدرك بالأقدار لا الطلب",100,"ب",1,0],["واقتحم لُجةَ القريض بفكر","ينتقي الدرَّ في حشا الأصدافِ",101,"ف",1,0],["واقتضاء المشيب حق الصبا أع","جَب منه الأناة في الاستلاف",101,"ف",1,0],["وأقتبسَ المعنى الثمينَ ذخيرةً","إذا شحَّ ودُ الناسِ أو خاطري افتقر",102,"ر",1,0],["واقتادني بِخزامة من خُلقهِ","ملكت خشونةَ مِقودي باللينِ",103,"ن",1,0],["واقتعدوا الذَّروةَ القُدامَى","بيتا على كاهل الزمانِ",104,"ن",1,0],["واقتسمت الهمومَ في صدْع دهرٍ","ليس من خُلقه اعتدالُ القِسمَهْ",105,"م",2,0],["واقتصّ حقُّ الشَّيب من باطلي","فتلك حالي ولِيَ اليومَ حالْ",106,"ل",1,0],["واقترع الدهر من بنيه","سميَّ أبراجه العوالي",107,"ل",2,0],["وأقتضي أذرعَ المطايا","ما استصحبتْ من ثرى الطلولِ",1