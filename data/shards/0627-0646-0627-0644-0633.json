"],[464,"لا تيأسن من أخ ولى بجانبه","https://www.aldiwan.net/poem3535.html","عموديه"],[465,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[479,"اسكت وقل هذا مآل","https://www.aldiwan.net/poem36958.html","مجزوء الكامل"],[500,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[515,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[515,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[529,"يا سيدا سودته المكرمات كما","https://www.aldiwan.net/poem37533.html","البسيط"],[534,"إلى الأمير فدته النفس أهديها","https://www.aldiwan.net/poem23814.html","البسيط"],[540,"ليت السباع لنا كانت مجاورة","https://www.aldiwan.net/poem56861.html","البسيط"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[551,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[553,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[558,"إن السماع سماع الناي والوتر","https://www.aldiwan.net/poem34546.html","البسيط"],[558,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[558,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[562,"يا بائع الصبر لا تشفق على الشاري","https://www.aldiwan.net/poem52764.html","البسيط"],[562,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[575,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[575,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["إِنَّ السَوادَ عَلى لَذّاتِهِ لَعَمىً","كَما البَياضُ عَلى عِلّاتِهِ بَصَرُ",0,"ر",1,0],["إِنَّ السُلوَّ لَمَحظورٌ عَلى كَبِدي","وَما السُلُوُّ عَلى قَلبٍ بِمَحظورِ",1,"ر",1,0],["إِنَّ السَعيدَ لَهُ في غَيرِهِ عِظَةٌ","وَفي التَجارِبِ تَحكيمٌ وَمُعتَبَرُ",2,"ر",1,0],["إِنَّ السِيادَةَ بِالإِغضاءِ لابِسَةٌ","بَهاءَها وَبَهاءُ الحُسنِ في الخَفَرِ",3,"ر",1,0],["إِنَّ السُيوفَ إِذا ما طابَ جَوهَرُها","في أَوَّلِ الطَبعِ لَم يَعلَق بِها طَبَعُ",4,"ع",1,0],["إِنَّ السِّيَاسَةَ وَعْرَةٌ وَمِرَاسُهَا","صَعْبُ وَوادِي التِّيهِ فِي أَذْيَالِهَا",5,"ل",3,0],["إن السياسة سرّها","لو تعلمون مُطلسَم",6,"م",1,0],["إِنَّ السَوارِيَ وَالغَوادِيَ غادَرَت","لِلريحِ مُختَرَقاً بِهِ وَمَجالا",7,"ل",2,0],["إِنَّ السَنامَ وَإِن طالَت شَطِيَّتُهُ","يَعتادُ ذِروَتَهُ الأَدواءُ وَالعَمَدُ",8,"د",1,1],["إن السراج رفيقنا مع خيره","تعساه شرّ مبيناً متبين",9,"ن",1,1],["إنَّ السيادة قد نضَّت سوالفها","لواحد العصر يصبيها وتصبيه",10,"ي",2,0],["إن السيوف منايا كلِّ معتزِمٍ","يلقى المنايا بعزمٍ غيرِ منتشر",11,"ر",1,0],["إن السيوف التي أردَتْ أوائلَكُم","أسيافُنا وبها نُردي ذوي البطر",11,"ر",1,0],["إن السعيدَ لمدركٌ دركاً","وأخو الشقاوةِ فهو في الدَّركِ",12,"ك",1,0],["إِنَّ السُيوفَ غُدُوَّها وَرَواحَها","تَرَكَت هَوازِنَ مِثلَ قَرنِ الأَعضَبِ",13,"ب",1,0],["إِنَّ السِنينَ كَثيرُها كَقَليلِها","إِن لَم تَزِن صَفَحاتِها الآثارُ",14,"ر",1,0],["أَنا لَستُ في دُنيا الخَيال وَلا الكَرى","وَكَأَنَّني فيها لِرَوعَةِ ما أَرى",15,"ر",2,1],["أَنا لَستُ بِالحَسناءِ أَوَّلَ مولَعِ","هِيَ مَطمَعُ الدُنيا كَما هِيَ مَطمَعِ",16,"ع",1,1],["أَنا لَستُ أَعدَلُ بِالمَناجِمِ واحِداً","وَأَبيعُ مَن عَقَلوا بِما لا يُعقَلُ",17,"ل",1,0],["إِنَّ السُعاةَ عَصَوكَ حينَ بَعَثتَهُم","وَأَتَوا دَواعِيَ لَو عَلِمتَ وَغولا",18,"ل",2,0],["إِنَّ السَماءَ وَإِنَّ الريحَ شاهِدَةٌ","وَالأَرضُ تَشهَدُ وَالأَيّامُ وَالبَلَدُ",19,"د",1,1],["إنَّ السَّكينَةَ رُوحٌ في","اللَّيلِ ليستْ تٌضامْ",20,"م",1,0],["أنَّ السَّلامَ حَقيقةٌ مَكْذوبةٌ","والعَدْلَ فَلْسَفةُ اللّهيبِ الخابي",21,"ي",1,0],["أنا لست في الشعراء إلا بلبلا","يشدو على الليمون والصفصاف",22,"ف",1,0],["ان السهام وان كانت منصلة","يعوزها منه عند الرمي تسديد",23,"د",1,0],["انا لست للملأ الشتيت مكلما","ما ليس حين يهمّ في امكانه",24,"ن",2,0],["ان السياسد في جميع","بقاعها تبدي ازورارا",25,"ر",2,0],["انا لست من ذنب جنا","ه العقل بالمتنصّل",26,"ل",1,0],["انا لست بالمسؤول عن","نزوات عقل مبطل",26,"ل",1,0],["انا لست منها غير جزء قد جثا","في نقطة من ارضه يتطلع",27,"ع",1,0],["انا لست مهما ضعضعتني كبرة","متطلعاً الا الى استقبالي",28,"ي",1,0],["أن السيادة تستدير مع الغنى","في حالتَيْ عدم له ووجود",29,"د",1,0],["إن السنين حلفن لا","حالفن غير صباك نضرا",30,"ر",2,0],["إن السهام إذا ما واصلت غرضا","كانت خواطئها مثل المصيبات",31,"ت",1,0],["إِنَّ السَماءَ جَديرَةٌ","بِالطَيرِ وَهوَ بِها جَدير",32,"ر",1,0],["إِنَّ السِلاحَ جَميعُ الناسِ تَحمِلُهُ","وَلَيسَ كُلُّ ذَواتِ المِخلَبِ السَبُعُ",33,"ع",1,0],["إِنَّ السَعادَةَ فيما أَنتَ فاعِلُهُ","وُفِّقتَ مُرتَحِلاً أَو غَيرَ مُرتَحِلِ",34,"ل",1,0],["إِنَّ السُيوفَ مَعَ الَّذينَ قُلوبُهُم","كَقُلوبِهِنَّ إِذا اِلتَقى الجَمعانِ",35,"ن",1,0],["إِنَّ السِياسَةَ قَد آلَت إِلى يَقِظٍ","مُوَفَّقٍ لِسَبيلِ الحَقِّ مُعتَمَدِ",36,"د",1,0],["إِنَّ السَماءَ إِذا لَم تَبكِ مُقلَتُها","لَم تَضحَكِ الأَرضُ عَن شَيءٍ مِنَ الخُضُرِ",37,"ر",1,1],["إِنَّ السُلُوَّ كَما تَقولُ لَراحَةُ","لَو راحَ قَلبي لِلسُلُوِّ مُطيقا",38,"ق",2,0],["إِنَّ السَماحَةَ وَالتَكَرُّمَ وَالنَدى","لِفَتى السَماحَةِ أَحمَدَ بنِ الهَيثَمِ",39,"م",1,1],["إِنَّ السَماءَ لَنا عَلَيكَ نُجومُها","وَالشَمسُ مُشرِقَةٌ وَكُلُّ هِلالِ",40,"ل",1,0],["إنَّ السَّماحَ مواردٌ مخصوصَةٌ","بالحمدِ بينَ ورودِها والمَصدَرِ",41,"ر",1,0],["إنَّ السَّماحَةَ أخلاقٌ عُرِفْتَ بها","والمَكرُماتُ حَديثٌ عنكَ مَسطورُ",42,"ر",1,0],["إِنَّ السَعيدَ غَداً زَهيدٌ قانِعٌ","عَبدَ الإِلَهِ بِأَحسَنِ الإِخباتِ",43,"ت",1,0],["إِنَّ السَلامَ وَإِنَّ البِشرَ مِن رَجُلٍ","في مِثلِ ما أَنتَ فيهِ لَيسَ يَكفيني",44,"ي",1,0],["إِنَّ السَلامَةَ أَن تَرضى بِما قُضِيا","لَيَسلَمَنَّ بِإِذنِ اللَهِ مَن رَضِيا",45,"ي",2,1],["إِنَّ السُكوتَ سَلامَةٌ وَلَرُبَّما","زَرَعَ الكَلامُ عَداوَةً وَضِرارا",46,"ر",2,0],["إن السراة الأباظيين قد عظموا","عن طوق ند وعن تحليق أضداد",47,"د",1,1],["إِنَّ السرائرَ عَوْراتٌ وَإِنَّ لها","مُهَذّباً آخذاً بالحزْمِ يَستُرُها",48,"ه",2,1],["إنَّ السحائبَ قَدْ طَغَيْنَ بجلِّقٍ","وبثثنَ ثلجاً لا سلمْنَ سحائبا",49,"ب",2,1],["إنّ السّماءَ تدفَّقتْ رحَمَاتُها","تَسقِي المشارقَ بعد طولِ مُحولِ",50,"ل",1,0],["إنّ السياسةَ لِلأقوامِ مَهْلكةٌ","فلا يَغُرَّنْكَ منها طولُ تَغْريرِ",51,"ر",1,0],["إِنَّ السُيوفَ لَيَمضي كُلُّ ذي شُطَبٍ","في الرَوعِ مِنها وَيَنبو كُلُّ مَفلولِ",52,"ل",1,0],["إِنَّ السُيوفَ سُيوفَ التُركِ ما بَرِحَت","تَحمي حِماها وَتَمضي في أَعاديها",53,"ي",3,0],["إنّ السّيوفَ بذي الفَقارِ تشَرّفَتْ","ولَقَلَّ سَيفٌ مثلُ أفلَحَ ثانِ",54,"ن",1,0],["إنّ السّماءَ لَدُونَ ما ترْقَى له","والنجمُ أقرَبُ نَهجِكَ المسلوك",55,"ك",1,0],["إنَّ السقيمَ زمانُهُ لا جسمُهُ","إذ لا يجيءُ لمثله بنديد",56,"د",1,0],["إِنَّ السَحابَ لَتَستَحيِي إِذا نَظَرَت","إِلى نَداهُ فَقاسَتهُ بِما فيها",57,"ي",3,0],["إِنَّ السَلامَ أَيُّها الأَميرُ","عَلَيكَ وَالرَحمَةُ وَالسُرورُ",58,"ر",1,1],["إِنَّ السَبيلَ عَلى اِثنَتَي","نِ اِختَرهُما يا اِبنَ الجِيادِ",59,"د",1,0],["إِنَّ السَوانِيَ مَأكولٌ وَمُهتَضَمٌ","فَما يُرى طَيرُهُ يَعني إِذا رادا",60,"د",2,0],["إِنَّ السَراحَ مَعَ السَما","حِ إِذا شَقيتَ بِما طَلَبتا",61,"ت",2,0],["إِنَّ السَوادَ لَجِنسٌ خَيرُهُ زَمِرٌ","فَقِس بَني آدَمٍ مِنهُ عَلى اللابِ",62,"ب",1,0],["إِنَّ السُيوفَ تُراحُ في أَغمادِها","وَتَظَلُّ في تَعَبٍ إِذا لَم تُغمَدِ",63,"د",1,0],["إِنَّ السَماءَ تَهَذَّبَت أَنوارُها","وَتَخَلَّفوا بِالأَرضِ شَرَّ بُخارِ",64,"ر",1,0],["إِنَّ السُيوفَ مَخاريقٌ إِذا عُصِيَت","بِها الفَوارِسُ أَودى كُلُّ مِخراقِ",65,"ق",1,0],["إِنَّ السُهى وَالسِماكَ ما غَفَلا","عَن ذِكرِ مَولاهُما وَلا سَهَوا",66,"ه",3,0],["أَنا لست من خلط المزاح بجده","فالجد جد والمزاح مزاح",67,"ح",1,0],["إن السحب لم تسكب على موطني الحيا","غزيراً فلا منِّي سلام على السحب",68,"ب",1,0],["أَنا لست زنديقاً ولا أَنا مارق","حتى يحل لظفركم تمزيقي",69,"ي",1,0],["إن السماء الَّتي تعلو مرابعكم","منها لأجلكم الخيرات تنسكب",70,"ب",1,0],["إنَّ السَماء لَتَبغي","في كل يوم شَهيدا",71,"د",2,0],["أَنا لست أول هالك في قومه","يَرجو تقدمهم مع الأقوام",72,"م",1,0],["أَنا لست وحدي إن هلكت بميت","كَم من كرام في التراب نيام",72,"م",1,0],["إن السَّلامَ الحقَّ ما آثرتهُ","والأرضُ غرقى في دمٍ وسَوَادِ",73,"د",1,0],["إنَّ السيوفَ تُهاب وهي رقيقةٌ","وخَلائقُ العظماءِ حين تُرفَّقُ",74,"ق",1,0],["إِنَّ السحَابَ لَدَى تَبَدُّدِه","لَيَبِيدُ بَيْنَ الْبَرْقِ وَالرَّعْدِ",75,"د",1,0],["إِنَّ السِّرَاجَ الَّذِي جَاوَرَهُ","أَجْلَى مِنَ النَّجْمِ سَنىً وَأهْدَى",76,"د",2,0],["أنا لست أرضى للندامى أن أرى","كسل الهوى وتشاؤب الأقداح",77,"ح",1,0],["إِنَّ السُرورَ تَصَرَّمَت أَيّامُهُ","مِنّي وَفارَقَني الحَبيبُ المُؤنِسُ",78,"س",1,0],["إن السلاليم لا تبنَى أطاوِلُها","يوماً ليهبط بانيهنّ أغوارا",79,"ر",2,0],["إنّ السَّلامَةَ قد تَكُونُ مَذَلَّةً","ويَكُونُ إقْدامُ الجريءِ حِمَاما",80,"م",2,0],["أنا لستُ أدري: من زئي","رٍ كان صوتُكِ أم صُداح؟",81,"ح",1,0],["أنا لست أسْلُو حُبَّكم","«غيري على السُّلوان قادر»",82,"ر",1,0],["إنّ السّلامَة َ أنْ نَرْضَى بمَا قُضِيَا","، لَيَسْلَمَنّ، بإذْنِ الله، مَن رَضِيَا",83,"ي",2,1],["إن السبيل على اثنتي","ن اخترهما يا بن الجياد",84,"د",1,0],["إنَّ السيوفَ تُهاب وهيَ رقيقةٌ","وخَلائِقُ العظماءِ حينَ تُرَقَّقُ",85,"ق",1,0],["إن السماءَ التي ابديتَ رَونَقها","يومَ الخميس بدا في وَجهها كَدَر",86,"ر",1,0],["َ انَ السَّحَابُ مُجانِباً لِبلاَدِنا","حَتَّى قَدِمْتَ فَجادَ فيهِ وأَسْبَلاَ",87,"ل",2,0],["أنا لستُ أغفر كالمسيحِ","ولن أُديرَ إليكِ خدّي",88,"د",2,0],["إن السيوف التي أردَتْ أوائلَكُم","أسيا ُناوبها نُردِي ذوي البطر",89,"ر",1,0],["إن السماحة ِ والشجاعة والعلى","جمعت لعمري في ابي عبعوب",90,"ب",1,0],["أَنا لَستُ أَدْري هَلْ سَتُذْكَرُ قِصَّتي","أَمْ سَوْفَ يَعْرُوها دُجَى النِّسْيانِ؟",91,"ن",1,0],["أنا لستُ أنسى ما حييتُ وِدادَكم","لو مر ألفٌ في السنينَ وأكثرُ",92,"ر",1,0],["إِنَّ السِنينَ إِذا قارَبنَ مِن مِئَةٍ","لَوَينَ مِرَّةَ أَحوالي عَلى مِرَرِ",93,"ر",1,0],["إِنَّ السَماءَ رَأَت فَعالَكَ في الوَرى","فَإِذا دَعَوا لَكَ فُتِّحَت أَبوابُها",94,"ب",3,0],["إِنَّ السَعادَةَ عَمَّت مُذ خُصِصتَ بِها","فَاِسلَم عَلى رَغمِ حُسّادٍ وَكَبتِ عِدا",95,"د",2,0],["إِن السَّعيد إِذا سعى في معجزٍ","كانت موانِعه له أَعوانا",96,"ن",2,0],["إِن السعادةَ حين تنهض بالفتى","تدني البعيد وتلقبُ الأعيانا",96,"ن",2,0],["إنّ السعادةَ كلَّها إِن يعتني","ربُّ السما بالعبدِ هذا الاعتنا",97,"ن",2,0],["أَنا لست أَعجب من ظِباك وفعلِها","فيمن طغى فالأُمر فيها أَظهرُ",98,"ر",1,0],["إن السعادة للعادات خارقة","أما ترى سعد عبدالله ما فعلا",99,"ل",2,0],["إن السفية كحش غاب أنته","إن أنت حرّكته هاجت غوائبُه",100,"ب",2,0],["إنّ السراجَ إِذا عبثتَ بضوئهِ","يَزدادُ فيه ضوؤهُ تكميلا",101,"ل",2,0],["أنَّ السفينةَ كلما","صغرتْ تراها في الشطوطِ",102,"ط",1,0],["إن السياسة يُرجى خير صاحبها","كالبَرق يأمل فيه الزارعُ المَطَرا",103,"ر",2,0],["إن السلوَّ لَرَاحةٌ وصيانة","للحرِّ لو أن السلوَّ أجابا",104,"ب",2,0],["انا لست اسلو عن ربيع وصاله","ان الحبيب محرم سلوانه",105,"ن",2,0],["انا لست ابرح عن حماه انني","بالجود والاحسان منه مقيد",106,"د",1,0],["ان السخا والمكرمات سجية","خلقت به لا مثل من ينخلق",107,"ق",1,0],["إن السننا من سناها قد أثار دمي","عيناك يا فاتني بالحسن عينان",108,"ن",1,0],["أَنا لَستُ أَخشى مِن جَهَنَّم جَذوَةَ","ما دامَ جِسمي يا سدومُ جهنَّمي",109,"ي",1,0],["إِنَّ السِّيَادَةَ أَحْرُفٌ","بِعُلاَكَ يَا مَوْلاَيَ تُعْجَمْ",110,"م",1,0],["إنّ السماع سماع الناي والوتر","يا نفس لا تسمعي من غيره وتري",111,"ر",2,1],["أنا لست سواءك متّخذاً","ربّاً إذ غيرك صرف أذىً",112,"ذ",2,0],["إن السماء على علو مكانها","لم تمتنع بالشهب من أن تحرسا",113,"س",2,0],["إن السرى تسعد آمال من","تشقي به الكوماء والمصعب",114,"ب",1,0],["إنَّ السعادةَ وَعدٌ دونَ إنجازِ","لا تَطمَعَنَّ على كدٍّ بإحرازِ",115,"ز",1,1],["إن السرورَ قليلٌ فاغنَمي فرصاً","يلذُّ فيها الهوى والكأسُ والوتر",116,"ر",1,0],["إن السعادةَ خدعةٌ قتَّالةٌ","نزَقُ الشَّبابِ بِنَيلِها يُغرينا",117,"ن",2,0],["إنّ السماء على المسكينِ ضيقةٌ","رحيبةٌ لِذَوي الأموالِ والعدد",118,"د",1,0],["إن السيوفَ على الأغمادِ حاقدةٌ","لأنها لم تجرَّد في رزاياك",119,"ك",1,0],["إن السيادةَ والسعادةَ والعُلى","من وجهِ دينارٍ وحدِّ مذكَّر",120,"ر",1,0],["إِنَّ السَّعيدَ امْرُؤٌ أَلقَى بِحَضرَتِهِ","عَصَاهُ مُحْتَزِماً بالعَدْلِ مُحْتَرِسا",121,"س",2,0],["إِنَّ السِّماحَةَ َأُولاها وَآخِرَها","فِي كَفِّ كُلِّ يَمانٍ يَا بْنَ مِسْمارِ",122,"ر",1,0],["إِنَّ السُّؤالَ لَواقِعٌ مِنْهُ بِمَنْ","زِلَةِ النَّوالِ مِنَ الْمُقِلِّ الْمُنْفِضِ",123,"ض",1,0],["ان السلامة والسرور تعانقا","بختان عمرو نجل ذي الاحسان",124,"ن",1,0],["أنا لست أعبأ بالزمان","ولا المكان ولا الوجود",125,"د",1,0],["أنا لست أعبأ بالفناء","ولا أفكر في الخلود",125,"د",1,0],["أَنا لستُ أدري كيف أرثي واحداً","أَمسى برغمِ الموتِ حيا خالداً",126,"د",2,1],["أَنا لستُ أجهلُ وَهجَها","لكنّ ما لا أعلم!",127,"م",1,0],["أنا لست أَعني بالسياسة إِنما","هي نفثةٌ من ذي جوى منهوكِ",128,"ك",1,0],["إِنَّ السوادَ الحرّ كتّام لما","أَودعتهُ والأبيض النمّامُ",129,"م",1,0],["إِنّ السيادةَ في أبناءِ فاطمةٍ","سَجيّةٌ فُطِرَت فيهم وما فطموا",130,"م",3,0],["إنَّ السَّلاَمَة مِن سَعدَى حضارتِهَا","أَن لاَ تحل عَلَى حَالٍ بِوَادِيهَا",131,"ه",2,0],["إِنَّ السَلائِقَ في الأَخلاقِ غالِبَةٌ","فَالصَقرُ لا يُقتَنى إِلّا بِتَدريبِ",132,"ب",1,0],["إِنَّ السُؤالَ فَعَدِّ عَنهُ قَليلُهُ","ثَمَنٌ لِكُلِّ عَطِيَّةٍ أَو مالِ",133,"ل",1,1],["إِنَّ السَعادَةَ فارَقَت سَلَفاً","مَن لا لَهُ في أَمسِها سَلَفُ",134,"ف",1,0],["إن السماء ديارهم لكنني اس","تسقيته ولشرحه تأويل",135,"ل",1,0],["إن السعيدَ هو الغنيُّ","عن العلائِقِ والعوائق",136,"ق",1,0],["إن السيول إلى القرار سريعة","والسيل حرب للمكان العالي",137,"ي",1,0],["إِنَّ السِنانَ وَحَدَّ السَيفِ لَو نَطَقا","لأَخبَرا عَنكَ في الهَيجاءِ بِالعَجَبِ",138,"ب",1,0],["إنَّ السَّلامة في سلمان من كدرٍ","يجني عليَّ ومن همِّي ومن فكري",139,"ر",2,0],["أنا لست أرضى يا خلي","لي ما يقول المبلس",140,"س",1,0],["إن السعيد صغير مات ما كسبت","يداه دنيا وعنه الحجر محدود",141,"د",1,0],["إن السعيد الذي يلقى المصائب في","جيش من الصبر شهم القلب مجتمع",142,"ع",1,0],["إن السلام هو الإسلام من قدم","كما رآه الألباء الأجلّاء",143,"ا",2,0],["إن السماء إذا سرتْ","معدودةً أنوارُها",144,"ر",3,0],["أنَّ السنانَ مخوفٌ وهو ذو كلفٍ","والسيف يقطعُ منهُ الحدُّ وهو صدي",145,"د",2,0],["إن السماء لترجى وهي نازحة","إذا ألحت بأرعادٍ وأبراق",146,"ق",1,0],["أنا لستُ أبكي، بَلْ أتَيتُ وفي دَمي","جاءَ العراقُ ، شيوخُه ُوالرُّضَّعُ",147,"ع",1,0],["إن السكوت من اللجي","ن وهكذا صنع الفقيه",148,"ي",2,0],["إِنَّ السَّخِيَّ بحرامٍ نَكِدٌ","مع البخيلِ المُفرِطِ الشُّحِّ استوَى",149,"ا",1,0],["إن السعيد ابن السعيد أجل أن","يحصي مآثره البليغ بشكره",150,"ر",2,0],["إن السعادة قد أظل زمانها","وافتر عن ثغر الهناء أوانها",151,"ن",3,1],["إِنَّ السِّيادَةَ أَنْحاءٌ وأَشْرَفُها","ما كانَ في شَرَفٍ سامٍ أَباً فَأبا",152,"ب",2,0],["إن السياسة رجس لا يطهره","إلا دم طاهر حتى يغطيها",153,"ي",3,0],["إِنَّ السِباعَ لَتَهدا عَن فَرائِسِها","وَالناسُ لَيسَ بِهادٍ شَرُّهُم أَبَدا",154,"د",2,0],["إنّ السّجايا الغُرَّ عن","دك ليس يعدِلهنّ مِثْلُ",155,"ل",1,0],["إِنّ السّيوفَ المُعْرَيا","تِ من السّيوف المُغمَداتِ",156,"ت",1,0],["إِنَّ السُيوفَ إِذا الحُروبُ تَسَعَّرَت","بِكَ توعِدُ الفُرسانَ وَالأَبطالا",157,"ل",2,0],["أنا لست أعرف من أنا","أنا عارف بي لست لاهي",158,"ا",3,0],["أنا لست حيواناً ولا","إنساً ولا جناً يلاهي",158,"ا",3,0],["أنا لست شيطاناً ولا","ملَكاً عصمت من المناهي",158,"ا",3,0],["أنا لست يقظاناً ولا","أنا غافل عني وساهي",158,"ا",3,0],["إن السماع سماع الناي والوترِ","يسقي أراضي نفوس الناس كالمطرِ",159,"ر",1,1],["إن السجود هو الفنا","فيه لمن هو قاصد",160,"د",1,0],["إن السيادة والريا","سة في الشقي وفي السعيد",161,"د",1,1],["إن السَّلامةَ كَنزٌ كلُّ خردلةٍ","منهُ تقُوَّمُ مِن مالٍ بقنطارِ",162,"ر",1,0],["إن السَّعيدَ الذي كانت عواقبُهُ","بالخيرِ في طاعةِ الرحمنِ تُختَتَمُ",163,"م",1,0],["إِنَّ السُّلُوَّ أَذلَّ الحبُّ عِزَّتَه","وأَخرجَ القلبَ منه مثلَ ما دخلا",164,"ل",2,0],["إِنَّ السحائِبَ جارَتْه فأَتْعَبها","وذلكَ القطرُ بعد الجُهدِ كالْعَرَقِ",165,"ق",1,0]]}