ر الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=181850",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[6056,"نور السوارة","https://www.poetsgate.com/ViewPoem.aspx?id=130342",""],[6102,"شادن","https://www.poetsgate.com/ViewPoem.aspx?id=184418",""],[6152,"بياض قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203103",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[572,"بي إنْ عَزَرْتُ عليكَ ذُلُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9437&r=&rc=294",""]],"verses":[["بِئاباءِ مَضوا وَهُمُ عَوارٍ","مِنَ القَولِ المُهَجَّنِ وَالمَلامِ",0,"م",1,0],["بَيانٌ يُبَيِّنُ لِلسامِعي","نَ أَنَّ مِنَ السِحرِ ما يُستَحَلّ",1,"ل",1,0],["بَيَانٌ يَنْتَشِى الأُدَبَاءُ مِنْهُ","فَهُمْ كَالشَّارِبِينَ وَلا مُدَامُ",2,"م",1,0],["بَيَانُهُ فِيهِ كَاليَنْبُوعِ مُنْفَجِرٌ","وَرَأْيُهُ فِيهِ كَالْبُنْيَانِ مُدَّعِمُ",3,"م",1,0],["بَيَانٌ مَا تَشَاء ُتُصِيبُ فِيهِ","سُرُورَ مُسَاهِمٍ وَأَسَى قَسِيمِ",4,"م",1,0],["بيان جوهريّ الوصف تروى","عوالي الحرب منه عن الصحاح",5,"ح",1,0],["بَيانُ بَيانِ الحَقِّ أَنتَ بَيانُهُ","وَكُلُّ بَيانٍ أَنتَ فيهِ لِسانُهُ",6,"ن",2,1],["بِيَارَشوخٍ وفتيانٍ لهم قَدَمٌ","فيمن وَفَى لمواليه ومن نصحا",7,"ح",2,0],["بيان جل موحيه","وعلم عز ملهمه",8,"م",2,0],["بَيانٌ يُشَمُّ الوَحيُ مِن نَفَحاتِهِ","وَعِلمٌ كَعِلمِ الأَنبِياءِ غَزيرُ",9,"ر",1,0],["بَياضُ وَجهٍ يُريكَ الشَمسَ حالِكَةً","وَدُرُّ لَفظٍ يُريكَ الدُرَّ مَخشَلَبا",10,"ب",2,0],["بَيادِقٌ ظَفِرَت أَيدي الرِخاخِ بِها","وَلَو تَرَكناهُمُ صادوا فَرازينا",11,"ن",2,0],["بيَ الجرحُ جرحُ الكون من قبل آدم","تغلغل في الأرواحِ يَدمى ويستشري",12,"ر",2,0],["بَيانٌ لَم تَرِثهُ تُراثَ دَعوى","وَلَم تُنبِطهُ مِن حِسيٍ بَكِيِّ",13,"ي",1,0],["بَيانُ ذَلِكَ أَنَّ أَوَّلَ مَن حَبا","وَقَرى خَليلُ اللَهِ إِبراهيمُ",14,"م",1,0],["بيانٌ مِنْ معانيكمْ بديعٌ","بهِ نمَّقْتم روضَ البطاحِ",15,"ح",1,0],["بي إلى وصلِكِ افتقارٌ كما بال","ناسِ فقرٌ إلى بقاءِ الوزيرِ",16,"ر",1,0],["بي أغيدٌ لو بَذَلْتُ نفسي","في قبلةٍ منهُ لمْ أنلْها",17,"ه",2,1],["بِيَ اليَومَ ما بي مِن هَيامٍ أَصابَني","فَإِيّاكَ عَنّي لا يَكُن بِكَ ما بِيا",18,"ي",2,1],["بِيَ اليَومَ داءٌ لِلهِيامِ أَصابَني","وَما مِثلُهُ داءً أَصابَ سَوائِيا",19,"ي",2,0],["بَياضٌ في جَوانِبِهِ اِحمِرارٌ","كَما اِحمَرَّت مِنَ الخَجَلِ الخُدودُ",20,"د",1,0],["بيانُكَ من نبعِ الجمالِ المخلّدِ","صدَى الوحي في أسلوبهِ المتجدِّدِ",21,"د",1,1],["بِيَ اليَأسُ أَو داءُ الهُيامِ أَصابَني","فَإِيّاكَ عَنّي لا يَكُن بِكَ ما بِيا",22,"ي",2,0],["بَيَانُكَ سَيْف لِلْحَقِيقَةِ سَاطِع","ذَلِيل بِهِ الْبَاغِي قَتِيلٌ بِهِ الرَّدَى",23,"د",2,0],["بَيَاضٌ يَغارُ الْعَاجُ مِنْهُ نقَاوَةً","وَيَحْجُبُهُ لَوْنُ الْحيَاءِ كَبُرْقُعِ",24,"ع",1,0],["بَياضُهُ وَاِحمِرارُهُ ذَهَبا","لا البَدرُ زاهي الضِيا وَلا الشَفَقا",25,"ق",2,0],["بَيَانُكَ وَاضِحُ الْقَسَمَاتِ صَافٍ","يَكادُ يُشِعُّ مِنْ فَرْطِ الصفَاءِ",26,"ا",2,0],["بَيَانٌ لَوْ صَدَعْتَ بِهِ اللَّيَالِي","رَأَيْتَ الصبْحَ مِنْهَا في الْعِشَاءِ",26,"ا",2,0],["بيانٌ مشرقُ اللمحاتِ زاهٍ","وقولٌ صادقُ النّبَراتِ فَصْل",27,"ل",1,0],["بيان الشرع هل لك من بيان","بيان الشرع هل لك من قرين",28,"ن",1,0],["بيانٌ جاش فيكِ فجاء عفواً","وحسنٌ رق منك فرقّ شعر",29,"ر",1,0],["ب \" يافا \" يومَ حُطَّ بها الرِكابُ","تَمَطَّرَ عارِضٌ ودجا سَحابُ",30,"ب",1,1],["بَيانٌ واضِحٌ وَنَدى بَنانٍ","غَمَرتَ تَفَضُّلاً وَبَهَرتَ فَضلا",31,"ل",2,0],["بَياضُ خَدَّيْكَ مَوْصُولٌ بِصُدْغَيْنِ","صُدْغٍ مِنَ اللَّيْلِ مُسْوَدِّ الجَناحَيْنِ",32,"ن",1,1],["بياضُ هِلالِهِ فيهِ سَوادٌ","كَإِثْرِ اللَّطمِ في يَقَقِ الخُدودِ",33,"د",1,0],["بَياضٌ نَهنَهَ اللَهوَ","وَدانى قَيدَهُ المُطلَق",34,"ق",1,0],["بَيَانِي فِي بَنَانِي مُستَقِلٌّ","فَلاَ تُطلُب فُدِيتَ بِهِ لِسَاني",35,"ن",2,0],["بِيَ اليأَسُ أَوْ داءُ الهُيامِ شَرِبْتُهُ","فَإيّاكَ عنّي لا يَكُنْ بكَ ما بِيا",36,"ي",2,1],["بياضٌ من وجوهِ البِيضِ فيه","سوادٌ من شعورِهُم يُذاب",37,"ب",1,0],["بيَ الهوى إن كنتِ لم تعرفي","يا أختَ باناتِ الربى فاعطفي",38,"ف",2,1],["بياضٌ برأسى يشتهى البدر نورهُ","ومن ضوئه الشمس المنيرة تخجل",39,"ل",1,0],["بَياناً ووعظاً قد تَناهيتَ فيهما","كأنّك لم يَسبِقْك قُسٌّ ويَعْرُبُ",40,"ب",1,0],["بَيَانُ اسْمِهِ الْمَكْنِيِّ عَنْهُ فَصَدِّقِ","بِحُكْمِ اخْتَيِارٍ بَخْتِيَارٌ بِمَشْرِقِ",41,"ق",1,1],["بياضٌ يملأ الآفاقَ نوراً","يُبَشِّرُ بَرقُهُ بسَحابِ جُود",42,"د",1,0],["بياض الشيب تكرهه الغواني","ويعجبها سوادٌ في الشباب",43,"ب",1,1],["بياضُ راحتكِ الريّا وحمرتُها","سماءُ صيفٍ عليها يحسنُ الشَّفَق",44,"ق",1,0],["بَياضُ الطَّلحِ ما تَنْشَقُّ عَنْهُ","وَفَوْقَ أَدِيمِها صَهَبُ الخُمُورِ",45,"ر",1,0],["بي أَكحَلُ الأَجفانِ يَح","سُدُ طَرفَهُ الرَشَأُ الكَحيلُ",46,"ل",1,0],["بي أَهيفٌ ضامِرُ الكَشحَينِ مُعتَدِلُ ال","قَوامِ لا ذاتُ أسوارٍ وَخَلخالِ",47,"ل",1,0],["بي أَسمَرُ إِن يَتَثَنَّ يَبِن","خَجَلٌ بِالسُمرِ مِنَ الأَسَلِ",48,"ل",1,0],["بَياضَ الشَيبِ قَد سَوَّدت وَجهي","فَفي تَسويدِ وَجهِكَ ما أحابي",49,"ب",2,0],["بي أَهيَفٌ مِثلُ قَضيبِ البانِ مِن","أَجفانِهِ السودِ اِنتَضى بيضَ القُضُب",50,"ب",1,0],["بيانُه فَهاهَه","وحِلمُه سَفاهَه",51,"ه",1,0],["بَيانٌ يودُّ السحرُ لو نالَ لطفهُ","وَشعرٌ نَمَته حكمة تُنزِلُ الشعرى",52,"ر",2,0],["بياض العين يكسوها جمالا","وليس النور إلا في السواد",53,"د",1,0],["بياض محيّا ذلك العيش بعدكم","فما زال ذاك الوجه أغبَر أسودا",54,"د",2,0],["بياض يدٍ تندى ومخضرّ مربع","تروق برغد العيش في الخطط الغبر",55,"ر",1,0],["بي أنت ضجَّ السيفُ حتى إنه","لو كان يومَ يُسلُّ ذا صوتٍ لَبَحْ",56,"ح",1,0],["بي إليهم صبوة عذريةٌ","شغلتني عم سماع العذل",57,"ل",1,0],["بي آمن الأصداغ ليس يروعهُ","إكثارهُ في القتلِ أو إسرافه",58,"ف",2,0],["بيانُ غمضٍ بممتَدِّ الرَّقائقِ من","علمِ الرَّسولِ وهل للسَّطرِ قرَّاءُ",59,"ا",2,0],["بيان المرء بالإكثار عيبٌ","وعقبى الصمت أقرب للبيان",60,"ن",1,1],["بي إلى وجهك الكريم غرام","في يديه عفو اشتياقي وكده",61,"د",2,0],["بياضك يا لون المشيبِ سوادُ","وَسُقمُك سقمٌ لا يكادُ يُعادُ",62,"د",1,1],["بَياذِقٌ قد تصدَّت للرِّخاخِ علَى","جَهالةٍ فإذا أبياتُها خِرَبُ",63,"ب",1,0],["بَيانُ مُحَمّدٍ صُبحٌ مُنيرٌ","فَأَفحَمَ كُلَّ ذي جَدَلٍ خَصيمِ",64,"م",1,0],["بِي إِنْ عَزَزْتَ عَلَيَّ ذُلُّ","وَلَكَ الرِّيَاسَةُ والمَحَلُّ",65,"ل",1,1],["بيانها لاسحر يسبي والبديع لها","حسن ومنظومها كالؤلؤ الرطب",66,"ب",1,0],["بيانك بالأوهام عنك وعن وعن","وإن كنت تدري الحشر والنشر فاسمُ عن",67,"ن",1,0],["بيان مبين في اقتضا كل رتبة","ولكن في التفصيل أحكام حكمة",67,"ه",1,0],["بَيَاضُكِ السَمحُ لنْ يَلقى السَوَادُ بهِ","مَأوىً ولا الحُبُّ بالأحقادِ يَقترِنُ",68,"ن",1,0],["بي آل أحمد لا أزال أحبَّ ف","ي الدنيا بحبهم وأبغض مبغضا",69,"ض",2,0],["بَياضُ صَحيفَةٍ تَلتاحُ حُسناً","كَمَتنِ السَيفِ في كَفِّ المَليحِ",70,"ح",1,1],["بيانها في كتب الكلام","يضيق عن تفصيلها نظامي",71,"ي",1,0],["بياعها العكر الذي أبداً له","طلبٌ يخال أحدَ من صمصامَهْ",72,"م",2,0],["بِياءِ اليَقينِ وواوِ الوفاءِ","وسينِ السَّناءِ وفاءِ الفلاحِ",73,"ح",1,0],["بيانها يغْني عن متون وشروح","كالشمْس يزري ضيّها بالفوانيس",74,"س",1,0],["بي اللهو من نفسي وابليس والهوى","أما آن يا مصباحنا القرب والهدى",75,"د",2,0],["بياء اليقين وأواره","ويمن يمينك يا مشتكايه",76,"ا",3,0],["بيانعةٍ تاهت وباهت بسوسنٍ","وآسٍ ونسرينٍ ووردٍ وكتلة",77,"ه",1,0],["بيَ اشتياقٌ وبهِ مِثْلُهُ","لولا اتّقَاء الله والعار",78,"ر",1,0],["بَيانيٌّ مليحٌ قد سَباني","وبيَّنَ من مَبَاحثِهِ مَعَاني",79,"ي",1,1],["بِيْ أنَا مِنْ غِضّ تيتوني","ماخذ مِنْ الزَّيْن وِمْخَلّي",80,"ل",2,0],["بي أبا هي أم ذا بِحُسنِ الحبَائبِ","أهى مِنَّى أم تِلكَ منهم عَجائِبِ",81,"ب",1,1],["بي الدَوائر دارَت مِن دَوائرها","ما لِأمرئ ارب في ذاك مَن أَرب",82,"ب",1,0],["بيانُ هذا كلّهُ اختراعي","هديّةٌ من مَلِكٍ مُطَاعِ",83,"ع",1,0],["بيانها السحر من أسرارهِ انكشفت","غوامضُ الحكم يروي سعدها الفالُ",84,"ل",1,0],["بيان حلى معانيه بديع","وسحر حديثه حكم الكلام",85,"م",1,0],["بيانه زان بالمعاني","مدارساً بحرها غزير",86,"ر",1,0],["بياضها مثل نقي الخد","أعتابها حمرتها كالورد",87,"د",1,0],["بَيَاضٌ بهِ تجري دموعي كأنَه","لِذاكَ دموعُ العَين صاحبُ دَمعَةِ",88,