دَكَ كُلُّها","وَتَرَكتَ أَضيَقَها عَلَيَّ بِلادي",3,"د",2,0],["ضاعَ الشَبابُ فَقُل لي أَينَ أَطلُبُهُ","وَاِزوَرَّ عَن نَظَري البيضُ الرَعاديدُ",4,"د",1,0],["ضاقَت فَلَمّا اِستَحكَمَت حَلَقاتُها","فُرِجَت وَكُنتُ أَظُنُّها لا تُفرَجُ",5,"ج",1,0],["ضَايَقَتْنِي صُرُوفُ هَذِي اللَّيَالِي","وَأَطَالَتْ هَمِّي وَألْوَتْ بِدَيْنِي",6,"ي",1,0],["ضَاعَتْ أُمُورُهُمْ هُدَّتْ ثُغُورُهُمُ","فَانْظُرْ لَهُمْ نَاصِرا فِي هَذِهِ الْحَالِ",7,"ل",1,0],["ضايَقَتْني فيكُمْ صُروف اللّيالي","واسْتَدارَتْ عليَّ دَوْرَ الوِشاحِ",8,"ح",1,0],["ضاعَ يومَ البيْنِ قلْبي فابْحَثا","بيْنَ أخْفافِ المَطايا وانْبِشا",9,"ش",2,0],["ضارِبٌ في الأَرضِ يَبغي مَأرَباً","كُلَّما قارَبَهُ عَنهُ اِبتَعَد",10,"د",1,0],["ضاقَتِ الأَرضُ عَن مَداكَ فَأَرسَل","تَ بِطَرفٍ إِلى السَماءِ عَتيدِ",11,"د",1,0],["ضاقَ في مِصرَ قِسمُنا فَاِعذُرونا","إِن حَسَدنا عَلى الجَلاءِ الشَآما",12,"م",2,0],["ضاعَ شِعري وَقَلَّ في الناسِ قَدري","مِن وُقوفي بابَ اللَئيمِ اِبنِ شُكرِ",13,"ر",1,1],["ضاقَت بِيَ الأَرضُ وَاِنقَضَّت مَخارِمُها","حَتّى تَخاشَعَتِ الأَعلامُ وَالبيدُ",14,"د",1,1],["ضاحي المَراتِعِ بِالبَيداءِ في قَرَنٍ","يَدنو بِهِ اللَيلَ في ظَلماءَ دَيجورِ",15,"ر",1,0],["ضاقت على الناس وانسدّت مسالكها","فعاد كل طريق غير مفتوح",16,"ح",1,0],["ضاع الدواء الذي قد كنت أوجِره","مَن ليس يشرب أو من ليس يستعط",17,"ط",1,0],["ضاقت بها العيشة إذ دونها","سُدّت جميع الطُرُق المُعلَمَه",18,"م",2,0],["ضاع جذر الحياةعنا فخلنا","أنها كالأصمّ في الاعداد",19,"د",1,0],["ضارَستُهُم حَتّى يَلينَ شَريسُهُم","عَنّي وَعِندي لِلجَموحِ لِجامُ",20,"م",1,0],["ضافي القَرا عَناقَهُ عَنائِقُه","تَحسَبُهُ إِذا عَلاكَ فائِقُه",21,"ق",2,0],["ضاقَ عَنّا الشِعبُ إِذ نَجزَعُهُ","وَمَلَأنا الفُرطَ مِنهُم وَالرِجَل",22,"ل",1,0],["ضاقَت بِالاَنصارِ البِلادُ فَأَصبَحوا","سوداً وُجوهُهُمُ كَلَونِ الإِثمِدِ",23,"د",1,0],["ضاع فيه لفظي الجهير وفضلي","ضيعةَ السيفِ في يدٍ شلاَّء",24,"ا",2,0],["ضائع العين كلّ سهران فيه","ضيعة القاف في حروف كلامه",25,"م",2,0],["ضاع مدحٌ يهدى لغير علاه","ضيعة البكر في يد العنين",26,"ن",1,0],["ضاقَ به إلاَّ إليك الفضا","وحثَّه حاشاكَ حرمانه",27,"ن",2,0],["ضاربات الدفوف في جيشِ لهوٍ","طاعنات الهموم بالعيدان",28,"ن",1,0],["ضافَنِي حُبُّك الغريبُ فألوى","بالرُّقادِ النَّسيبِ فهو طريدُ",29,"د",1,0],["ضاق خناقي فالتمس قطعة","ولا تكن عوناً لخنّاقي",30,"ق",2,0],["ضامرٌ وجهُ طيزها غيرَ تركي","يٍ ولكن ينموزجيُّ السُّؤال",31,"ل",1,0],["ضاهت صنائعُ أيديكم وقائعَها","فأصبحتْ ذات إنجادٍ وإتهامِ",32,"م",1,0],["ضاقت ببلواي أعطاني بما رَحُبَتْ","ولن تضيق بغوثي منك أعطان",33,"ن",1,0],["ضاق عن مأثُراتك الشعرُ إلا","فاعلاتن مستفعلن فاعلانِ",34,"ن",1,0],["ضاقَت بِهِ الدُنيا الرَحيبَةُ فَاِنثَنى","بِالشِعرِ يَستَجدي بَني حَوّاءِ",35,"ا",2,0],["ضاقَت ذَوائِبُها فَما اِنفَرَجَت","إِلّا لِسَيرِ الذِئب وَالنَمرِ",36,"ر",1,0],["ضاقَت عَلى أَحلامِهِم تِلكَ القُرى","فَاِختَرتُمُ الدُنيا الوِساعَ لِتَحلَموا",37,"م",3,0],["ضاحِكٌ مِثلُ الخَميلَه","لاعِبٌ مِثلُ النَسيم",38,"م",1,0],["ضاقَت عَليَّ الأَرضُ في","كَ وَضِقتُ بِالهِجرانِ ذَرعا",39,"ع",2,0],["ضاعَ عُمري في اِغتِرابٍ","وَرَحيلٍ مُستَمِرِّ",40,"ر",1,0],["ضافي العَطِيَّةِ راجيهِ وَسائِلُهُ","سَيّانِ أَفلَحَ مَن يُعطي وَمَن يَعِدُ",41,"د",1,0],["ضاعَ أَمسي وأَينَ منِّي أَمسي","وقَضَى الدَّهْرُ أَنْ أَعيشَ بيَأْسي",42,"ي",1,0],["ضامن ان تعيش في الارض حراً","كل ما للشيطان من نزغات",43,"ت",1,0],["ضامها في قساوة","سامها الذل واحتقر",44,"ر",1,0],["ضاجعي حية الثرى","فهي خير من البشر",44,"ر",1,0],["ضاحي المواكب في الرياض مميز","دون الزهور بشوكة وسلاح",45,"ح",1,0],["ضافته بلقيس حين الدهر خادمها","في ملكها والليالى من جواريها",46,"ي",3,0],["ضاق بحر الروم عن ملك","زاخر في الحل والسفر",47,"ر",1,0],["ضاقَت كَريدُ جِبالُها","بِكَ يا خَلوصي وَالقِفار",48,"ر",1,0],["ضاقَ عَن ثُكلِها البُكا فَتَغَنَّت","رُبَّ ثُكلٍ سَمِعتَهُ مِن شادي",49,"د",2,0],["ضامِرٍ في شُفعَةٍ تَحسَبُهُ","نِضوَ صَحراءَ اِرتَدى الشَمسَ دِهانا",50,"ن",2,0],["ضافي الجَلالَةِ كَالعَتيقِ مُفضَلٌ","ساحاتِ فَضلٍ في رِحابِ سَماحِ",51,"ح",1,0],["ضاقَت بِهِم عَرَصاتُها فَكَأَنَّما","رَدَّت وَدائِعَها الفَلاةُ الفَيهَقُ",52,"ق",1,0],["ضاقَتِ الأَرضُ بِهِم فَاِتَّخَذوا","في السَماواتِ قُبورَ الشُهَداء",53,"ا",2,0],["ضاقَ الحِصارُ كَأَنَّما حَلَقاتُهُ","فَلَكٌ وَمَقذوفاتُها أَجرامُ",54,"م",1,0],["ضاقَ بِالعيشَةِ ذَرعاً فَهَوى","عَن شَفا اليَأسِ وَبِئسَ المُنحَدَر",55,"ر",1,0],["ضاقَ صَدري وَطالَ في طَلَبِ الرِز","قِ قِيامي وَقَلَّ عَنهُ قُعودي",56,"د",2,0],["ضارِبُ الهامِ في الغُبارِ وَما يَر","هَبُ أَن يَشرَبَ الَّذي هُوَ ساقي",57,"ق",2,0],["ضاقَ الزَمانُ وَوَجهُ الأَرضِ عَن مَلِكٍ","مِلءِ الزَمانِ وَمِلءِ السَهلِ وَالجَبَلِ",58,"ل",1,0],["ضاقَ ذَرعاً بِأَن أَضيقَ بِهِ ذَر","عاً زَماني وَاِستَكرَمَتني الكِرامُ",59,"م",1,0],["ضافي الحِداد حرونُ النجم حائرُه","يحنو عليك بأذيالٍ تواريكا",60,"ك",2,0],["ضاقتْ بك الدنيا فعِفْتَ جِوارَها","ونزعتَ نحو الخُلدِ أكرمَ منزعِ",61,"ع",1,0],["ضافتْهُ أسرابُ البلابلِ والدُّجَى","لم ترمِ سُودَ قُرونِها ببياضِ",62,"ض",1,0],["ضاهِي بكيدِكِ كيدَ دهرٍ واعزِمي","عَزَماتِ أروعَ مُبْرِمٍ نَقَّاضِ",62,"ض",1,0],["ضاقت له فُسَحُ الأمورِ وأُفرجتْ","عنه بعزمِ مروِّضٍ روَّاضِ",62,"ض",1,0],["ضامت أخِشَّةُ ذُلِّهِ عرنينَهُ","عَوْدٌ على جُلَبِ المهانةِ ماضِ",62,"ض",1,0],["ضاهَت بِحُلَّتِها تَلَهُّبَ خَدِّها","حَتّى اِغتَدَت في أُرجُوانٍ جاسِدِ",63,"د",1,0],["ضاقَ صَدري بِما أُجِن","نُ وَقَلبي بِما أَجِد",64,"د",1,0],["ضامِناً رِزقَ كُلِّ طَيرٍ كَما ضُمّ","مِنَ أَرزاقُ كُلِّ ضَبعٍ وَسيدِ",65,"د",1,0],["ضاقَت عَلَيَّ لَهُ البِلادُ بِأَسرِها","حَتّى لَخِلتُ الأَرضَ كِفَّةَ صائِدِ",66,"د",1,0],["ضافَتهُ أُخرى مِثلُها فَاِغتَدى","مُسانِدي أَو واقِفاً مَوقِفي",67,"ف",2,0],["ضاهَت مَحاسِنَهُ الحُسّادُ طامِعَةً","لِلُّؤمِ مِن جَهلِها أَن يُغمَرَ الكَرَما",68,"م",2,0],["ضاقَت بِأَسعَدِ أَرضِها لَمّا رَمى","ساحاتِها بِالرَجلِ وَالفُرسانِ",69,"ن",1,0],["ضامِنٌ لِلَّذي يُرادُ لَدَيهِ","قَلِقُ الفِكرِ أَو يَصِحَّ ضَمانُه",70,"ن",2,0],["ضاعَفَ مِن بَثّي وَأَحزاني","فَقدُ أَخِلّايَ وَإِخواني",71,"ي",1,1],["ضافي السَبيبِ مُقَلِّصِن لَم تَنخَزِل","مِنهُ القَطاةُ وَلَم يَخُنهُ شَظاهُ",72,"ا",2,0],["ضاق العناق به على أعناقها","حتى تناثرت العقود فرائدا",73,"د",2,0],["ضاع دم بينكم مشروب","وضعف الطالب والمطلوب",74,"ب",1,0],["ضاقَتْ جوانبُه بالبِيضِ فازدَحَمَتْ","كالماءِ ضاقَ به اليَنبوعُ فا