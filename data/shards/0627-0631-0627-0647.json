w.poetsgate.com/ViewPoem.aspx?id=194149",""],[5957,"تباعدتَ","https://www.poetsgate.com/ViewPoem.aspx?id=18429",""],[5997,"بحرٌ وأطْلس","https://www.poetsgate.com/ViewPoem.aspx?id=214227",""],[5997,"على مرأى ومسمع","https://www.poetsgate.com/ViewPoem.aspx?id=214462",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""],[6068,"أراها في المنام -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175943",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6075,"وطن في عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=195129",""],[6082,"لا تثقي","https://www.poetsgate.com/ViewPoem.aspx?id=180043",""],[6102,"عيد شديد","https://www.poetsgate.com/ViewPoem.aspx?id=184462",""],[6124,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=109745",""],[6127,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=204476",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6142,"بالأمس كانوا معي واليوم قد رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=155753",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[5377,"لحظات الإشراق الفني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79566&r=&rc=22",""],[243,"أراها غدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68171&r=&rc=163",""],[6187,"الدائرة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82160&r=&rc=4",""],[2638,"دنيا الأذكياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87840&r=&rc=4",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""],[6300,"عروس أنتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82838&r=&rc=9",""],[6320,"الأَمَةُ الآبِقَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84326&r=&rc=23",""],[5190,"شرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85062&r=&rc=137",""],[5190,"اعذريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78335&r=&rc=48",""],[572,"وََمَثّلَهُ لِي المُنّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9268&r=&rc=125",""]],"verses":[["أَراهُ سِناناً لِلقَريبِ مُسَدَّداً","وَسَهماً إِلى النَأيِ البَعيدِ مُفَوَّقا",0,"ق",2,0],["أَراها بِعَينِ الظَنِّ حَمراءَ جَهمَةً","سَتَجري إِلى عارِ العَواقِبِ أَو تُفضي",1,"ض",2,0],["أراها على سُعْدى غَيارى كأنّما","بِها مابِنا من صَبْوَةٍ وغَرامِ",2,"م",1,0],["أَراهُ أَهلَ ذَلِكَ حينَ يَسعى","رُعاءُ الحَيِّ في طَلَبِ الحَلوبِ",3,"ب",1,0],["أراهُ رَحَى قَيْنٍ وعُمْريَ صَفْحَةٌ","يَكُرُّ علَيْها بالمَدارِ فيُفْنيها",4,"ه",2,0],["أَراهُمُ أَنزَلونا","مَنازِلَ الحَيَوانِ",5,"ن",1,0],["أَراهُ فَتُدنيني إِلَيهِ شَراسَتي","فَيَنأى وَفي نَفسي إِلَيهِ أُوارُ",6,"ر",1,0],["أَراهُنَّ لا يُحبِبنَ مَن قَلَّ مالُهُ","وَلا مَن رَأَينَ الشَيبَ فيهِ وَقَوَّسا",7,"س",2,0],["أَراهُم مَنارَاتِ الهُدى مُستَنيرَةً","وَوافَقَ مِنها رُشدَها وَصَوابَها",8,"ب",3,0],["أَراها والِهاً تَبكي أَخاها","عَشِيَّةَ رُزئِهِ أَو غِبَّ أَمسِ",9,"س",1,0],["أراه كوجه الغادة الخَود راقني","بحسن ولكن قد تجهّم وازورّا",10,"ر",2,0],["أراه إذا طارحته الجِدّ لاعباً","وما أنا ممن يا أميم يلاعبه",11,"ب",2,0],["أراها فأبكي وهي رهنُ يد البلى","بدمع كما ارفَضّ الجُمان المُنضّد",12,"د",1,0],["أَراهُنَّ ماءَ المُزنِ يُشفى بِهِ الصَدى","وَكانَت مِلاحاً غَيرَهُنَّ المَشارِبُ",13,"ب",1,0],["أراها وإن كانت تُحَبَّ كأنها","سحابة صيف عن قليل تقشعُ",14,"ع",1,1],["أَراها مِنكَ بِالقَلبِ","وَلِلأَحشاءِ أَبصارُ",15,"ر",1,0],["أراها فأزْدادُ اشتياقاً وصَبْوَةً","وإن نزحَتْ فالموتُ دون نُزُوحِها",16,"ه",2,1],["أراه يُضيع ثغراً بعد ثغرٍ","وذلك في فسادِكُمُ سريعُ",17,"ع",1,0],["أراه كضوء الشمس بالعين رؤية","ويمنعني من لمسه بالأصابع",18,"ع",1,0],["أراه حيّاً وإن طال النقيق به","أقلَّ منه إذا ما فادغٌ فَدَغه",19,"غ",2,0],["أراهم هوينا المستخفّ بشأنهم","وربّ مجدٍّ في الأمور كهازِلِ",20,"ل",1,0],["أراه بحقٍّ مليكاً عليْ","يَ مقتدراً ويراني خليلا",21,"ل",2,0],["أَراهُ قَد عَرَّضَ لي عِرضَهُ","أُشهِدُكُم يامَعشَرَ الناسِ",22,"س",1,0],["أَراهُ مِن بَينِ أَعلامِ الوَغى مَلَكاً","وَما سِواهُ مِنَ الأَعلامِ شَيطانا",23,"ن",2,0],["أَراهُ صَغيراً قَدرَها عُظمُ قَدرِهِ","فَما لِعَظيمٍ قَدرُهُ عِندَهُ قَدرُ",24,"ر",1,0],["أُراهُ وَفِيّاً وَأَنّى لَهُ","وَفاءٌ إِذا كانَ لا أَصلَ لَه",25,"ل",2,0],["أَراها نُجومَ اللَيلِ وَالشَمسُ حَيَّةٌ","زِحامِ بَناتِ الحارِثُ بنِ عُبادِ",26,"د",1,1],["أَراهُم بَنو مَروانَ يَومَ لَقوهُمُ","بِبابِلَ يَوماً أَخرَجَ النَجمَ بادِيا",27,"ي",2,0],["أراه قَالَبَ جسمي حينَ أَدخُلُه","فما أَمُدُّ به رجلاً ولا سَاقا",28,"ق",2,0],["أراه قد هُتِكَتْ أستارُ حُرمَتِه","وسائرُ الشِّعرِ مستورٌ بأستارِ",29,"ر",1,0],["أَراهُ مَعسولَ اللَمى وِردَهُ","وَصَدَّ عَمّا رامَهُ وَهوَ صاد",30,"د",1,0],["أَراهُ طولُ الصَدِّ لَمّا عَدا","مَرامَهُ ما هَدَّ صُمَّ الصِلاد",30,"د",1,0],["أَرَاهُ فَيَمْحُونِي الْجَلالُ وَأَنْتَحِي","أَغَالِطُ أَفْكَارِي وَلَسْتُ بِحَالِمِ",31,"م",1,0],["أراهُ لي في خلوتي","عنْ كلِّ خلٍّ خَلَفَا",32,"ف",2,0],["أَراهم حَيارَى لا يُصيبون هادياً","وفيهم كتابُ اللهِ يا فتحُ فاشْهدِ",33,"د",1,0],["أراهُمْ يَرفَعُونَ كما عَهِدْنا","وَراءَ الجمعِ أعناقاً وهاما",34,"م",2,0],["أراها حولنا عَجْلىَ تَرامَى","كموجِ البحرِ تزدحمُ ازدحاما",34,"م",2,0],["أَراهُم سَواءً لا تَفاوُتَ بَينَهُم","وَلَن تَستَبينَ العَينُ ما كانَ خافِيا",35,"ي",2,0],["أَراهُم عَلى وَخزِ القَريضِ وَوَكزِهِ","وَما فيهِمُ إِلّا ذَليلٌ مُعَبَّدُ",36,"د",1,0],["أَراها كَسارِي الليلِ لا يَأمنُ الرَدى","وَلا هوَ يَرجو مِن سَنا النَجمِ هاديا",37,"ي",2,0],["أراها فلم أملِكْ تَهالُك واهنٍ","بجنبيَّ مسلوبِ الجراءَ ةِ والعزم",38,"م",1,0],["أَراهُ فَيُعديني مِنَ المَكرِ ما بِهِ","فَأُكرِمُ عَنهُ شَيمَتي وَطِباعي",39,"ع",2,0],["أَراهم مَقاماً ليسَ يُرْعَى لِجَارِهِ","ذِمَامٌ وَلَمْ يُحْفَظْ لِساكِنِهِ عَهْدُ",40,"د",1,0],["أُراهُ سَوفَ يَقتُلُني","بِبَعضِ سُيوفِ مُقلَتِهِ",41,"ت",2,0],["أَراهُم يَضحَكونَ إِلَيَّ غِشّاً","وَتَغشاني المَشاقِصُ وَالحِظاءُ",42,"ا",2,1],["أَراهُ حينَ يَراني","كحيَّة تَتَلوّى",43,"و",2,0],["أراهُ ولمَّا يَزَلْ بيننا","أصابَتْه لُوثَةُ أهلِ الفنونْ",44,"ن",1,0],["أراها على الأرض طيفَ النعيم","وحُلمَ الفراديسِ فيما مضى",44,"ض",2,0],["أَراهُم بِحَمدِ اللهِ بَعدَ جَخِيفِهِم","غُرابَهُمُ إذ مَسَّهُ الفَترُ واقِعا",45,"ع",2,0],["أَرَاهُ يَهْتِفُ بِاسْمِي غَيْرَ مُكْتَرِثٍ","وَلَوْ كَنَى لَمْ يَدَعْ لِلظَّنِّ مِنْ سَبَبِ",46,"ب",1,0],["أُرَاهُنَّ جَيْشاً لِلسلاَمِ سِلاَحُهُ","مِنَ النَّورِ فِي ظِلِّ اللِّوَاءِ المُقَدَّسِ",47,"س",1,0],["أَرَاهُمْ بَدِيعاً بِذاك الْبَدِيعِ","صَفا جَوْهَراً وَحَلاَ مَوْرِدَا",48,"د",2,0],["أَرَاهُ فأَلْقَى البِشْرَ في قَسَمَاتِه","طَهُوراً كثَغْر الطِّفْلِ حين تُدَاعِبُه",49,"ب",2,0],["أرَاهُنّ لا يُحْبِبنَ مَن قَلّ مَالُهُ","ولا من رأين الشيب فيه وقوّا",50,"ق",3,0],["أَراهُم بِحَمدِ اللَهِ بَعدَ خَجيفِهِم","غُرابُهُم إِذ مَسَّهُ الفَترُ واقِعا",51,"ع",2,0],["اراها اذا ما ذقت عاطر خمرها","سروري ولم تسفح حذار محرض",52,"ض",1,0],["اراه بكل مرئي لوجدي","واشرق فيه بالماء القراح",53,"ح",1,0],["أراه على لذاته ونعيمه","يفاجئنا منه وميض ونامر",54,"ر",1,0],["أراه في الزهر مخضلّاً وأسمعه","في هادل الطير هاجتهن أشجان",55,"ن",1,0],["أَراهُما عُرضَةَ اللِقاءِ إِذا","سامَيتُ أَو أَنتَمي إِلى حَسَبِ",56,"ب",1,0],["أراهُ بقَلبٍ كُلَّ يَومٍ ولَيلَةٍ","وإن كنتُ عَن وِردِ الوِصالِ أُحَلأُ",57,"ا",1,0],["أَراهُ الهَوى ما لَم يَكُن في حِسابِهِ","فَأَقلَقَهُ عَن صَبرِهِ وَاِحتِسابِهِ",58,"ب",2,1],["أَراهُ وَلُوعاً بِالكِرامِ يَلُسُّها","كَلَسِّ الكَلا مِن يَمنَةٍ وَشِمالِ",59,"ل",1,0],["أراه فيشتفي نظري","ويقطع وصله عدمي",60,"م",2,0],["أراه بعيدا وهو يقبل ماشيا","فيدخل بعضي حين يقبل في بعض",61,"ض",1,0],["أَراها مُنيتي وهوى فؤادي","إِذا هويَ السِوى هنداً وليلى",62,"ل",2,0],["أراها خلاءً منكِ الاَّ محامداً","وآثار فضل حيةً وترحما",63,"م",2,0],["أراها وقد جعلتْ تمطلُ","ذكاءٌ تضيءُ ولا تنزلُ",64,"ل",1,0],["أراهُ في الأرضِ معنى لا نظيرَ لهُ","فما أكذبُ أن أدعوهُ مبتكرا",65,"ر",2,0],["أراهُ لنا قائداً","ونحنُ لهُ عسكرُ",66,"ر",1,0],["أراها أن تكنفها حسانٌ","كنورِ الكهرباءةِ في الشموعِ",67,"ع",1,0],["أراه في كل حسن يستهام به","بين الخلائق من جنّ ومن ناس",68,"س",1,0],["أراها فتشتبك المقلتا","ن وتنتعش الروح بالنظرة",69,"ه",1,1],["أَراهُ عَلى المُنحَنى وَالخَليج","وَفي هذِهِ الغابَة الجارِيَه",70,"ي",2,0],["أَراهُ عَلى أَملِ الزارِعين","في مَوسِمِ الحَقلِ وَالماشِيَه",70,"ي",2,0],["أَراهُ بِعَينٍ حينَ يَلمَعُ مَدمَعُ اِش","تِياقٍ وَقَلبٍ خافِقٍ حينَ يَخفقُ",71,"ق",1,0],["أَرَاهَا إِذَا أَفْنَى نَحِيبِي تَأَلُّمِي","وَأَذْهَلَنِي عَنِّي مِنَ الشَّوْقِ أَقْيَاظُ",72,"ظ",1,0],["أراهُ ما أقامَ عليَّ حقّاً","شريكي في بلادي ما بقيتُ",73,"ت",1,0],["أَراهُ قِصَّة رُفِعَت إِلى مَن","يُوَقِّعُ في جَوابِيَ بِالجَوى بي",74,"ب",2,0],["أَراهُمُ رُفقَتي حَتّى إِذا ما","تَجافى اللَيلُ وَاِنخَزَلَ اِنحِزالا",75,"ل",2,0],["أَراهُ مَجامِعَ الوَرِكَينِ مِنها","مَكانَ السَّرْجِ أُثبِتَ بِالحِزامِ",76,"م",1,0],["أراهمُ إِخواني لحقّ أبيهم","عليّ ولكن ليس فيهم تأدّبُ",77,"ب",1,0],["أَراهُم كُلَّما مَرّوا سِراعاً","عَلى أَهل الهَوى مَرّوا كِراما",78,"م",2,0],["أَراها اِنشِقاق البَدر نصفين واحد","إِلى الشَرق مَيّالٌ وَثانٍ مُغرِّبُ",79,"ب",1,0],["أَراها كَرُؤيا الظامِئينَ سَحابَةً","يَرونَ لَدَيها الرِّيَّ لَو قُضِيَ السَكبُ",80,"ب",1,0],["أراه الذي أعطاه مثل الذي رأى","باعطائهِ في نفسِه في سليلهِ",81,"ل",2,0],["أَراهُم حَيثُما حلُّوا استَقَلُّوا","فَفيما تَطمَئِنُّ بِهم تُراعُ",82,"ع",1,0],["أراه للدهر لا ينفك يرقبني","كأنه هلْ واَنا فعلٌ بحيِّزِها",83,"ه",2,0],["أراهُ في غمراتِ الحربِ مُمْتَشِق","سيفَ البطولةِ مثلَ السَّيل دفَّاقا",84,"ق",2,0],["أراها لا عذوق لها ولكن","لها سعف تغاض به الرماح",85,"ح",1,0],["أراهم ينصتون إلى كذوبٍ","ويزعجهم إذا نطق الصدوق",86,"ق",1,0],["أراها صيرت فكري بليداً","وما هو قبل مقدمها بليد",87,"د",1,0],["أراه بعين القلب إن غيب النوى","محياه عني فهو عندي بحضرتي",88,"ي",1,0],["أراهُ مَلالُه حَسَني قبيحاً","فصدَّ وأيسَرُ الغَدرِ الصُّدودُ",89,"د",1,0],["أَراهُ مكانَ الشّمسِ بُعداً وبينَنا","كما بينَ عينٍ في التّداني وحاجِبِ",90,"ب",1,0],["أراها والغرام قد ابْتلاها","بلى إنَّ الغرامَ هو البلاء",91,"ا",2,0],["أراها لا تُفيقُ جوىً ووجداً","وشبَّ بقلبها للشوق وقد",92,"د",1,0],["أَراهُم إِلى نَصري بِطاءً وَإِن هُمُ","دَعَوني إِلى نَصرٍ أَتيتُهُم شَدّا",93,"د",2,0],["أراها لا تمي