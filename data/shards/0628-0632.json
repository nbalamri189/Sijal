//www.aldiwan.net/poem30558.html","الكامل"],[31,"ألا يا بكر قد طرقا","https://www.aldiwan.net/poem42035.html","مجزوء الوافر"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[48,"بزاتنا الأقداح","https://www.aldiwan.net/poem62536.html","المجتث"],[48,"بمعودية الدين العتيقِ","https://www.aldiwan.net/poem66571.html","الوافر"],[48,"وملحة بالعذل تحسب أنني","https://www.aldiwan.net/poem66630.html","الكامل"],[7,"لقد قلت للنعمان يوم لقيته","https://www.aldiwan.net/poem1993.html","الطويل"],[76,"ذات دل وشاحها قلق","https://www.aldiwan.net/poem39252.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21008","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43833","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54319","الخفيف"],[78,"غريب بأرض المغربين","https://www.poetsgate.com/ViewPoem.aspx?id=1467",""],[3,"هَلْ غَادَرَ الشُّعَرَاءُ منْ مُتَرَدَّمِ(معلق","https://www.poetsgate.com/ViewPoem.aspx?id=10032",""],[80,"غريبٌ بأرض المغربين أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3292",""],[6,"آذَنَتْنَا بِبَينِهَا أَسْماءُ ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14185&r=&rc=0",""]],"verses":[["بَزَّ زُهَيراً شِعري وَها أَنا ذا","لَم أَرضَ في المَجدِ أَنَّهُ هَرِمُ",0,"م",1,0],["بِزَينِ المِلَّةِ اِشتَفَتِ الأَماني","مِنَ المَطلِ المُمانِعِ وَالدِفاعِ",1,"ع",1,0],["بِزَفُوفٍ كَأَنَّها هِقلَةٌ أَ","مُّ رِئالٍ دَوِّيَّةٌ سَقفاءُ",2,"ا",2,0],["بِزُجاجَةٍ صَفراءَ ذاتِ أَسِرَّةٍ","قُرِنَت بِأَزهَرَ في الشَمالِ مُفَدَّمِ",3,"م",1,0],["بَزَغَتْ شَمْسُ الضُّحَى مِنْ سِتْرِهَا","وَهِلالُ العِيدِ مِنْ أَنْقَى جَبِينْ",4,"ن",1,0],["بِزَعْمِهِ يَقْتُلُ الأَيَّامَ فَلْسَفَةً","وَرُبَّمُا قَتَلَتْهُ هَذِهِ الحِكَمُ",5,"م",1,0],["بِزَأْرَةِ رِئْبَالٍ وَتَطْرِيبِ سَاجِعٍ","وَعَطْفَةِ مُهْتَزٍّ وَلَهْفَةِ مُهْتَمِّ",6,"م",1,0],["بُزلٌ كَأَنَّ الكُحَيلَ الصِرفَ ضَرَّجَها","حَيثُ المَناكِبُ يَلقى رَجعَها القَصَرُ",7,"ر",1,0],["بِزَيدِ مَناةَ يَحطِمُ كُلَّ عَظمٍ","بُوازِلُهُ وَزِدنَ عَلى البُزولِ",8,"ل",1,0],["بِزُجاجَةٍ رَقَصَت بِما في قَعرِها","رَقَصَ القَلوصِ بِراكِبٍ مُستَعجِلِ",9,"ل",1,0],["بزهرٍ من الآراء والقول واللُّهى","روينا صحيحَ الحمد منها عن الزُّهري",10,"ر",2,0],["بزَّه الدهرُ ما كسا الناسَ إلا","ما عليه من لَحمه والإهابِ",11,"ب",1,0],["بُزُرْجُمُهْرُ بني العباس رُسْتُمهم","جلمود خَطْبَيْن ما صكُّوا به رَضحا",12,"ح",2,0],["بَزَّنِي الدَّهرُ وكانَ غَشُوماً","بِأبِيٍّ جَارُهُ ما يُذَلُّ",13,"ل",1,0],["بِزاهِرِها السامي الذُرَى جادَهُ الحَيا","تُشيرُ الثُرَيّا نَحوَنا وَنُشيرُ",14,"ر",1,0],["بَزَّ المَذاكي وَهوَ في العَقائِقِ","وَزادَ في الساقِ عَلى النَقانِقِ",15,"ق",1,0],["بَزَّت بِالمُخلَدِيِّنَ لُهىً","كَجِمامِ البَحرِ باتَت تَصطَفِق",16,"ق",1,0],["بِزُهرٍ كَأَنَّ السَحابَ اِستَعا","رَ مِن جودِهِم فَيضَ تَهتانِهِ",17,"ن",2,0],["بزلنا دنها والليل داج","فصيرت الدجا شمسا وظلا",18,"ل",2,0],["بِزُجاجَةٍ تَستَخرِجُ ال","سِرَّ الدَفينَ مِنَ الضَميرِ",19,"ر",1,0],["بزُجاجةٍ صُوَرُ الفوارسِ نَقْشُها","فترى لها حَرْباً بكفِّ السّاقي",20,"ق",2,0],["بزَبرجديّاتٍ إذا عَلَتِ الصّفا","وَقَعَتْ بواطنُها عليه صلابا",21,"ب",2,0],["بِزَفرَةٍ بَعدَ أُخرى طالَما شَهِدَت","بِأَنَّها اِنتُزِعَت مِن صَدرِ مَكروبِ",22,"ب",1,0],["بَزَّ التَحِيَّةَ مِن لَخمٍ فَلا مَلِكٌ","مُتَوَّجٌ في عَماماتٍ وَلا عَمَمِ",23,"م",1,0],["بِزُهرٍ وَالحُذاقِ وَآلِ بُردٍ","وَرَت في كُلِّ صالِحَةٍ زِنادي",24,"د",2,0],["بِزَينَبَ إِنَّها هَمّي","فَكَيفَ بِحَبلِها خَلَقَ",25,"ق",1,0],["بَزَّ الضَعيفَ فَمِن نَسائِلِ طِمرِهِ","حُيكت عَلَيهِ البِزَّةُ الحَسناءُ",26,"ا",2,0],["بِزُهاءِ أَلفٍ ثُمَّ أَل","فٍ بَينَ ذي بَدَنٍ وَرامِح",27,"ح",1,0],["بِزِوَرَّةٍ تَمطو النُسو","عَ بِنا مَطا صُلبٍ وَكاهِل",28,"ل",1,0],["بُزاتُنا الأَقداحُ","دُرّاجُهُنَّ الراحُ",29,"ح",1,1],["بزكّى بل بمتّى بل بيحيى","وإمساكٍ بذي الدين الوثيقِ",30,"ق",1,0],["بزهى بوجهٍ مشرقٍ ذي رونقٍ","كالبدرِ حين انار للسفّار",31,"ر",1,0],["بُزاخِيَّةٍ أَلوَت بِليفٍ كَأَنَّهُ","عِفاءُ قِلاصٍ طارَ عَنها تَواجِرُ",32,"ر",1,0],["بَزَّتِ الشَّمسُ نورَها وحَباها","لحظَ عينيهِ شادِنٌ خَرِقُ",33,"ق",1,0],["بزغت والنفوس ترنو إليها","بعيون مملوءة من غرام",34,"م",1,0],["بزاهدٍ قام مكان الزاهد","مجاهدٍ ناب عن المجاهد",35,"د",1,0],["بِزُجاجَةٍ مِلءِ اليَدَينِ كأَنَّها","قِنديلُ فُصحٍ في كَنيسَةِ راهِبِ",36,"ب",1,0],["بَزَغَتْ بِهِ شَمْسُ الْهِدَايَةِ بَعْدَ مَا","أَفَلَتْ وَأَبْصَرَ كُلُّ طَرْفٍ أَرْمَدِ",37,"د",1,0],["بِزَفَافِ عَبْدِ اللّهِ كَمْ مِنْ غَافِرٍ","لِزَمَانِهِ ذَنْباً وَكمْ مِنْ شَاكِرِ",38,"ر",1,0],["بَزَّتكَ ثاراً يَدٌ تَساوى","فيها عِقابٌ وَعَندَليبُ",39,"ب",1,0],["بَزَغَتْ في مشارقِ المجدِ شَمْساً","وبدَا في مطالِع السعدِ بَدْرا",40,"ر",2,0],["بزاهرها السامي الذرا جاده الحيا","تشير الثريا نحونا ونشير",41,"ر",1,0],["بِزُجاجَةٍ صَفْراءَ ذاتِ أَسِرَّةٍ","قُرِنَتْ بِأَزْهَر في الشَّمالِ مُقَدَّمِ",42,"م",1,0],["بزاهرها السامي الذي جا/ه الحيا","تشير الثريا نحونا ونشير",43,"ر",1,0],["بِزَفوفٍ كأنَّها هِقْلَة ٌ أُمُّ","مٌ رئالٍ دّوّية ُ سقفاءُ",44,"ا",2,0]]}