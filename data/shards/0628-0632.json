170.html","مجزوء الكامل"],[195,"توهم إبلاد المنازل عن حقب","https://www.aldiwan.net/poem54390.html","الطويل"],[195,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[197,"يا بني العرب إنما الضعف عار","https://www.aldiwan.net/poem39951.html","الخفيف"],[221,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[270,"إن كان وعد الحر دينا أنجز","https://www.aldiwan.net/poem35290.html","الكامل"],[270,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[281,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[298,"هلم ننشد يا صاحبي معا","https://www.aldiwan.net/poem36288.html","عموديه"],[320,"يا من بطول الهجر أصبح غادري","https://www.aldiwan.net/poem67095.html","الكامل"],[337,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[353,"بزغت شمس أنسنا المسعود","https://www.aldiwan.net/poem40366.html","الخفيف"],[353,"راح ساقي الراح يجلو القدحا","https://www.aldiwan.net/poem40540.html","الرمل"],[377,"إلام إلام ظلما يا حسود","https://www.aldiwan.net/poem59453.html","البسيط"],[377,"بزغت في بروجها الأضواء","https://www.aldiwan.net/poem66989.html","الخفيف"],[380,"قد نمت عن أشواقه","https://www.aldiwan.net/poem49233.html","مجزوء الكامل"],[391,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[400,"مليكة وجداني","https://www.aldiwan.net/poem10300.html","عموديه"],[405,"يا ليلة نادمت فيها عصبة","https://www.aldiwan.net/poem49734.html","الكامل"],[432,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[432,"سفحت عيون الغيث أدمع قطره","https://www.aldiwan.net/poem12612.html","الكامل"],[458,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[461,"إذا ما شكت بيض السيوف ظماءة","https://www.aldiwan.net/poem15172.html","الطويل"],[461,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[483,"لمن الديار عفون بالجزع","https://www.aldiwan.net/poem2073.html","أحذ الكامل"],[493,"ومدام كأنها في حشا الدنن","https://www.aldiwan.net/poem67426.html","الخفيف"],[500,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[516,"بزينب المم قبل ان يرحل الركب","https://www.aldiwan.net/poem48740.html","الطويل"],[538,"يا دهر هل لي ن أراك مساعدي","https://www.aldiwan.net/poem47975.html","عموديه"],[549,"أمن القتول منازل ومعرس","https://www.aldiwan.net/poem446.html",""],[551,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[567,"ألست ترى الظلام وقد تولى","https://www.aldiwan.net/poem69455.html","الوافر"]],"verses":[["بَزَّ زُهَيراً شِعري وَها أَنا ذا","لَم أَرضَ في المَجدِ أَنَّهُ هَرِمُ",0,"م",1,0],["بِزَينِ المِلَّةِ اِشتَفَتِ الأَماني","مِنَ المَطلِ المُمانِعِ وَالدِفاعِ",1,"ع",1,0],["بِزَفُوفٍ كَأَنَّها هِقلَةٌ أَ","مُّ رِئالٍ دَوِّيَّةٌ سَقفاءُ",2,"ا",2,0],["بِزُجاجَةٍ صَفراءَ ذاتِ أَسِرَّةٍ","قُرِنَت بِأَزهَرَ في الشَمالِ مُفَدَّمِ",3,"م",1,0],["بَزَغَتْ شَمْسُ الضُّحَى مِنْ سِتْرِهَا","وَهِلالُ العِيدِ مِنْ أَنْقَى جَبِينْ",4,"ن",1,0],["بِزَعْمِهِ يَقْتُلُ الأَيَّامَ فَلْسَفَةً","وَرُبَّمُا قَتَلَتْهُ هَذِهِ الحِكَمُ",5,"م",1,0],["بِزَأْرَةِ رِئْبَالٍ وَتَطْرِيبِ سَاجِعٍ","وَعَطْفَةِ مُهْتَزٍّ وَلَهْفَةِ مُهْتَمِّ",6,"م",1,0],["بُزلٌ كَأَنَّ الكُحَيلَ الصِرفَ ضَرَّجَها","حَيثُ المَناكِبُ يَلقى رَجعَها القَصَرُ",7,"ر",1,0],["بِزَيدِ مَناةَ يَحطِمُ كُلَّ عَظمٍ","بُوازِلُهُ وَزِدنَ عَلى البُزولِ",8,"ل",1,0],["بِزُجاجَةٍ رَقَصَت بِما في قَعرِها","رَقَصَ القَلوصِ بِراكِبٍ مُستَعجِلِ",9,"ل",1,0],["بزهرٍ من الآراء والقول واللُّهى","روينا صحيحَ الحمد منها عن الزُّهري",10,"ر",2,0],["بزَّه الدهرُ ما كسا الناسَ إلا","ما عليه من لَحمه والإهابِ",11,"ب",1,0],["بُزُرْجُمُهْرُ بني العباس رُسْتُمهم","جلمود خَطْبَيْن ما صكُّوا به رَضحا",12,"ح",2,0],["بَزَّنِي الدَّهرُ وكانَ غَشُوماً","بِأبِيٍّ جَارُهُ ما يُذَلُّ",13,"ل",1,0],["بِزاهِرِها السامي الذُرَى جادَهُ الحَيا","تُشيرُ الثُرَيّا نَحوَنا وَنُشيرُ",14,"ر",1,0],["بَزَّ المَذاكي وَهوَ في العَقائِقِ","وَزادَ في الساقِ عَلى النَقانِقِ",15,"ق",1,0],["بَزَّت بِالمُخلَدِيِّنَ لُهىً","كَجِمامِ البَحرِ باتَت تَصطَفِق",16,"ق",1,0],["بِزُهرٍ كَأَنَّ السَحابَ اِستَعا","رَ مِن جودِهِم فَيضَ تَهتانِهِ",17,"ن",2,0],["بزلنا دنها والليل داج","فصيرت الدجا شمسا وظلا",18,"ل",2,0],["بِزُجاجَةٍ تَستَخرِجُ ال","سِرَّ الدَفينَ مِنَ الضَميرِ",19,"ر",1,0],["بزُجاجةٍ صُوَرُ الفوارسِ نَقْشُها","فترى لها حَرْباً بكفِّ السّاقي",20,"ق",2,0],["بزَبرجديّاتٍ إذا عَلَتِ الصّفا","وَقَعَتْ بواطنُها عليه صلابا",21,"ب",2,0],["بِزَفرَةٍ بَعدَ أُخرى طالَما شَهِدَت","بِأَنَّها اِنتُزِعَت مِن صَدرِ مَكروبِ",22,"ب",1,0],["بَزَّ التَحِيَّةَ مِن لَخمٍ فَلا مَلِكٌ","مُتَوَّجٌ في عَماماتٍ وَلا عَمَمِ",23,"م",1,0],["بِزُهرٍ وَالحُذاقِ وَآلِ بُردٍ","وَرَت في كُلِّ صالِحَةٍ زِنادي",24,"د",2,0],["بِزَينَبَ إِنَّها هَمّي","فَكَيفَ بِحَبلِها خَلَقَ",25,"ق",1,0],["بَزَّ الضَعيفَ فَمِن نَسائِلِ طِمرِهِ","حُيكت عَلَيهِ البِزَّةُ الحَسناءُ",26,"ا",2,0],["بِزُهاءِ أَلفٍ ثُمَّ أَل","فٍ بَينَ ذي بَدَنٍ وَرامِح",27,"ح",1,0],["بِزِوَرَّةٍ تَمطو النُسو","عَ بِنا مَطا صُلبٍ وَكاهِل",28,"ل",1,0],["بُزاتُنا الأَقداحُ","دُرّاجُهُنَّ الراحُ",29,"ح",1,1],["بزكّى بل بمتّى بل بيحيى","وإمساكٍ بذي الدين الوثيقِ",30,"ق",1,0],["بزهى بوجهٍ مشرقٍ ذي رونقٍ","كالبدرِ حين انار للسفّار",31,"ر",1,0],["بُزاخِيَّةٍ أَلوَت بِليفٍ كَأَنَّهُ","عِفاءُ قِلاصٍ طارَ عَنها تَواجِرُ",32,"ر",1,0],["بَزَّتِ الشَّمسُ نورَها وحَباها","لحظَ عينيهِ شادِنٌ خَرِقُ",33,"ق",1,0],["بزغت والنفوس ترنو إليها","بعيون مملوءة من غرام",34,"م",1,0],["بزاهدٍ قام مكان الزاهد","مجاهدٍ ناب عن المجاهد",35,"د",1,0],["بِزُجاجَةٍ مِلءِ اليَدَينِ كأَنَّها","قِنديلُ فُصحٍ في كَنيسَةِ راهِبِ",36,"ب",1,0],["بَزَغَتْ بِهِ شَمْسُ الْهِدَايَةِ بَعْدَ مَا","أَفَلَتْ وَأَبْصَرَ كُلُّ طَرْفٍ أَرْمَدِ",37,"د",1,0],["بِزَفَافِ عَبْدِ اللّهِ كَمْ مِنْ غَافِرٍ","لِزَمَانِهِ ذَنْباً وَكمْ مِنْ شَاكِرِ",38,"ر",1,0],["بَزَّتكَ ثاراً يَدٌ تَساوى","فيها عِقابٌ وَعَندَليبُ",39,"ب",1,0],["بَزَغَتْ في مشارقِ المجدِ شَمْساً","وبدَا في مطالِع السعدِ بَدْرا",40,"ر",2,0],["بزاهرها السامي الذرا جاده الحيا","تشير الثريا نحونا ونشير",41,"ر",1,0],["بِزُجاجَةٍ صَفْراءَ ذاتِ أَسِرَّةٍ","قُرِنَتْ بِأَزْهَر في الشَّمالِ مُقَدَّمِ",42,"م",1,0],["بزاهرها السامي الذي جا/ه الحيا","تشير الثريا نحونا ونشير",43,"ر",1,0],["بِزَفوفٍ كأنَّها هِقْلَة ٌ أُمُّ","مٌ رئالٍ دّوّية ُ سقفاءُ",44,"ا",2,0],["بزمرة ركب المؤمنين جميعهم","بما جاء من أمر قديم وتبيان",45,"ن",1,0],["بزيارةٍ لمحبكمْ","كَىْ ما يكون له قَدَرْ",46,"ر",1,0],["بزَّني دهريَ اللئيمُ كَريما","كانَ لي والداً وكنتُ أنا ابْنا",47,"ن",2,1],["بَزُّوا ثَمانينَ دِرعاً مِن سُراتِهِمُ","في حَملَةٍ تَرَكَت هاماتِهِم رِمَما",48,"م",2,0],["بِزخارفٍ مَلَكت هوا","كَ فأنتَ فيها الدهرَ رافِث",49,"ث",1,0],["بِزَهمانَ لَو كانَت تَكَلَّمُ أَخبَرَت","بِما لَقِيَت بَعدَ الأَنيسِ مِن العَجَبِ",50,"ب",1,0],["بَزَّها الأَمرَ أَيِّدٌ نَعِرُ النِيْ","لية لا يطبيهِ إِلّا الخَلاءُ",51,"ا",2,0],["بَزَغَت فوقَ فرقِكَ الشمسُ تاجاً","تَتلالا أنوارهُ الذهبيّه",52,"ي",2,0],["بزنود وقوام وخدود","ثم يمشي بعد هذا الخيلاء",53,"ا",2,0],["بزجاجَتَينِ وعَدتَني من قُرقُفٍ","لم تبقَ فيها فضلةٌ لم تُفرَز",54,"ز",1,0],["بزغَ الصباحُ عليكِ ثم على","قلبي وصبَّحني بك السعدُ",55,"د",1,0],["بزَّ المذكي سابقاً","فمن المصلِّي والمجل",56,"ل",1,0],["بزَّتْ نساءَ الورى فما بِسِوا","ها الحسنُ والعلمُ والنُهى اجتمعا",57,"ع",2,0],["بِزِيارَةٍ تُطفي لَهيبَ تَوَلُّعي","فَاِجعَل كَلامَكَ يا مُنى القَلبِ مَعي",58,"ي",1,0],["بِزُرقِ النَواحي مُرهَفاتٍ كَأَنَّما","تَوَقُّدُها في الصُبحِ نيرانُ عَرفَجِ",59,"ج",1,0],["بَزَغت شَمس أنسنا المَسعود","مِن سَماء الهَنا بِسَعد السُعودِ",60,"د",1,1],["بِزَفاف القَمر الزاهي الَّذي","حُسن أَقمار الدَياجي فَضَحا",61,"ح",2,0],["بزعمك أنها غَشَّت وغُشَّت","كما قد قال كَلْوينُ العنيد",62,"د",1,0],["بَزَغَت في بروجها الأَضواءُ","وَسَرت في ظِلالها البُشْراءُ",63,"ا",2,1],["بَزَغَت لِفتنة مِن يَرا","هُ الشَمس مِن أَطواقِهِ",64,"ق",2,0],["بزين العابدين مع محمد","وجعفر مع على مط كروبي",65,"ي",1,0],["بزهورِ الرَّوضِ وما نفحتْ","من عطرٍ فوقَ عباءَتِهِ",66,"ت",2,0],["بَزَلَ السُّقاُ دِنانَهُمْ فكأنَّما","بُزِلَتْ لَنا عن عَنْدَمٍ أو عَنْ دَمِ",67,"م",1,0],["بُزْلٌ كأَمثالِ الدِّنانِ تجانَسَتْ","مَعَهَا على طَرَبٍ ذباب نُزَّلُ",68,"ل",1,0],["بزجاجةٍ حيّاك منها قيصَرٌ","وكأنما هو في جوانبِ قَصرِه",69,"ر",2,0],["بزلاءُ عاميْن فإن أثرتَها","فثورةُ الغِرِّ وقمصاتُ الثَّني",70,"ي",1,0],["بزولٍ لبيقٍ في مُتونِ جيادهِ","بغُرَّتهِ جُنْح العجاجةِ يُقْمِرُ",71,"ر",1,0],["بَزَّتْهُ أيامهُ أرْماقَ بُلْغَتهِ","فازداد صوناً على اللَّزْبات والقُحَم",72,"م",1,0],["بزَّت بني ساسان واطدملكهم","ورمتْ نظامَ القومِ بالتبديد",73,"د",1,0],["بِزَفيفِ نَقنَقَةٍ مُصَلَّمَةٍ","قَرعاءَ بَينَ نَقانِقٍ قُرعِ",74,"ع",1,0],["بَزَلَت وَالضُحى عَنِ اللَيلِ مَحجو","بُ فَلاحَت كَالشَمسِ في الظُلماءِ",75,"ا",2,0],["بِزَوْجِ البَتولِ المُرْتَضى صِنْوِهِ الَّذي","أقامَ على الخَصْمِ القيامةَ في الكَرِّ",76,"ر",1,0],["بزَغَتْ بالظّلامِ شَمسُ الدُيورِ","فأرَتْ بالشتاءِ وقتَ الهَجيرِ",77,"ر",1,1],["بزينَب المم قَبل ان يَرحَل الرَكب","وَقُل ان تَمَلّينا فَما مَلَك القَلب",78,"ب",1,1],["بِزيارَةٍ لِمَنِ اغتدى نَجماً عَلى","أفقِ المَعالي حائزاً إقبالا",79,"ل",2,0],["بَزُّ بِهِ أَحمي المُضافَ إِذا دَعا","وَبَدا لَهُم يَومٌ ذَنوبٌ أَحمَسُ",80,"س",1,0],["بزّ اليمانيّين تيجانَهمْ","مِن دونها أَردية العَصْبِ",81,"ب",1,0],["بَزَلْنَا دَنَّهَا واللَّيْلُ دَاجٍ","فَصَيَّرَتِ الدُّجَى شَمْسَاً وَظِلاَّ",82,"ل",2,0]]}