[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105110","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91002","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90870","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94719","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81717","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117272","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72394","الخفيف"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216347",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120468","الكامل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105489","الخفيف"],[4767,"غريب تناجيب","https://www.poetsgate.com/ViewPoem.aspx?id=88151",""],[4767,"رجب","https://www.poetsgate.com/ViewPoem.aspx?id=88247",""],[4830,"آهاتُ شعبي","https://www.poetsgate.com/ViewPoem.aspx?id=198931",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[4578,"مرسلٌ فوق نجيل الخصر شد","https://www.poetsgate.com/ViewPoem.aspx?id=49408",""],[4578,"هذي رواية آدابٍ لذي أدبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49350",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4862,"ماأنت إلا مهزلة","https://www.poetsgate.com/ViewPoem.aspx?id=55628",""],[4978,"رد على أنشودة الطوفان","https://www.poetsgate.com/ViewPoem.aspx?id=177268",""],[5064,"انكسَارات الخُشُوع","https://www.poetsgate.com/ViewPoem.aspx?id=199175",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5096,"نأى ودُّنا","https://www.poetsgate.com/ViewPoem.aspx?id=207836",""],[5145,"عودوا ببعض عشيات الحمى عودوا","https://www.poetsgate.com/ViewPoem.aspx?id=108065",""],[5183,"طائش المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180259",""],[5273,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=28764",""],[5277,"حبيبي الأغرّ","https://www.poetsgate.com/ViewPoem.aspx?id=189722",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[5628,"ذكرى غروب قمر","https://www.poetsgate.com/ViewPoem.aspx?id=178485",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5751,"يا أجمل الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=215022",""],[5952,"حبَّات العِقد","https://www.poetsgate.com/ViewPoem.aspx?id=196747",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""],[1583,"شعاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73067&r=&rc=24",""]],"verses":[["بَزَّ زُهَيراً شِعري وَها أَنا ذا","لَم أَرضَ في المَجدِ أَنَّهُ هَرِمُ",0,"م",1,0],["بِزَينِ المِلَّةِ اِشتَفَتِ الأَماني","مِنَ المَطلِ المُمانِعِ وَالدِفاعِ",1,"ع",1,0],["بِزَفُوفٍ كَأَنَّها هِقلَةٌ أَ","مُّ رِئالٍ دَوِّيَّةٌ سَقفاءُ",2,"ا",2,0],["بِزُجاجَةٍ صَفراءَ ذاتِ أَسِرَّةٍ","قُرِنَت بِأَزهَرَ في الشَمالِ مُفَدَّمِ",3,"م",1,0],["بَزَغَتْ شَمْسُ الضُّحَى مِنْ سِتْرِهَا","وَهِلالُ العِيدِ مِنْ أَنْقَى جَبِينْ",4,"ن",1,0],["بِزَعْمِهِ يَقْتُلُ الأَيَّامَ فَلْسَفَةً","وَرُبَّمُا قَتَلَتْهُ هَذِهِ الحِكَمُ",5,"م",1,0],["بِزَأْرَةِ رِئْبَالٍ وَتَطْرِيبِ سَاجِعٍ","وَعَطْفَةِ مُهْتَزٍّ وَلَهْفَةِ مُهْتَمِّ",6,"م",1,0],["بُزلٌ كَأَنَّ الكُحَيلَ الصِرفَ ضَرَّجَها","حَيثُ المَناكِبُ يَلقى رَجعَها القَصَرُ",7,"ر",1,0],["بِزَيدِ مَناةَ يَحطِمُ كُلَّ عَظمٍ","بُوازِلُهُ وَزِدنَ عَلى البُزولِ",8,"ل",1,0],["بِزُجاجَةٍ رَقَصَت بِما في قَعرِها","رَقَصَ القَلوصِ بِراكِبٍ مُستَعجِلِ",9,"ل",1,0],["بزهرٍ من الآراء والقول واللُّهى","روينا صحيحَ الحمد منها عن الزُّهري",10,"ر",2,0],["بزَّه الدهرُ ما كسا الناسَ إلا","ما عليه من لَحمه والإهابِ",11,"ب",1,0],["بُزُرْجُمُهْرُ بني العباس رُسْتُمهم","جلمود خَطْبَيْن ما صكُّوا به رَضحا",12,"ح",2,0],["بَزَّنِي الدَّهرُ وكانَ غَشُوماً","بِأبِيٍّ جَارُهُ ما يُذَلُّ",13,"ل",1,0],["بِزاهِرِها السامي الذُرَى جادَهُ الحَيا","تُشيرُ الثُرَيّا نَحوَنا وَنُشيرُ",14,"ر",1,0],["بَزَّ المَذاكي وَهوَ في العَقائِقِ","وَزادَ في الساقِ عَلى النَقانِقِ",15,"ق",1,0],["بَزَّت بِالمُخلَدِيِّنَ لُهىً","كَجِمامِ البَحرِ باتَت تَصطَفِق",16,"ق",1,0],["بِزُهرٍ كَأَنَّ السَحابَ اِستَعا","رَ مِن جودِهِم فَيضَ تَهتانِهِ",17,"ن",2,0],["بزلنا دنها والليل داج","فصيرت الدجا شمسا وظلا",18,"ل",2,0],["بِزُجاجَةٍ تَستَخرِجُ ال","سِرَّ الدَفينَ مِنَ الضَميرِ",19,"ر",1,0],["بزُجاجةٍ صُوَرُ الفوارسِ نَقْشُها","فترى لها حَرْباً بكفِّ السّاقي",20,"ق",2,0],["بزَبرجديّاتٍ إذا عَلَتِ الصّفا","وَقَعَتْ بواطنُها عليه صلابا",21,"ب",2,0],["بِزَفرَةٍ بَعدَ أُخرى طالَما شَهِدَت","بِأَنَّها اِنتُزِعَت مِن صَدرِ مَكروبِ",22,"ب",1,0],["بَزَّ التَحِيَّةَ مِن لَخمٍ فَلا مَلِكٌ","مُتَوَّجٌ في عَماماتٍ وَلا عَمَمِ",23,"م",1,0],["بِزُهرٍ وَالحُذاقِ وَآلِ بُردٍ","وَرَت في كُلِّ صالِحَةٍ زِنادي",24,"د",2,0],["بِزَينَبَ إِنَّها هَمّي","فَكَيفَ بِحَبلِها خَلَقَ",25,"ق",1,0],["بَزَّ الضَعيفَ فَمِن نَسائِلِ طِمرِهِ","حُيكت عَلَيهِ البِزَّةُ الحَسناءُ",26,"ا",2,0],["بِزُهاءِ أَلفٍ ثُمَّ أَل","فٍ بَينَ ذي بَدَنٍ وَرامِح",27,"ح",1,0],["بِزِوَرَّةٍ تَمطو النُسو","عَ بِنا مَطا صُلبٍ وَكاهِل",28,"ل",1,0],["بُزاتُنا الأَقداحُ","دُرّاجُهُنَّ الراحُ",29,"ح",1,1],["بزكّى بل بمتّى بل بيحيى","وإمساكٍ بذي الدين الوثيقِ",30,"ق",1,0],["بزهى بوجهٍ مشرقٍ ذي رونقٍ","كالبدرِ حين انار للسفّار",31,"ر",1,0],["بُزاخِيَّةٍ أَلوَت بِليفٍ كَأَنَّهُ","عِفاءُ قِلاصٍ طارَ عَنها تَواجِرُ",32,"ر",1,0],["بَزَّتِ الشَّمسُ نورَها وحَباها","لحظَ عينيهِ شادِنٌ خَرِقُ",33,"ق",1,0],["بزغت والنفوس ترنو إليها","بعيون مملوءة من غرام",34,"م",1,0],["بزاهدٍ قام مكان الزاهد","مجاهدٍ ناب عن المجاهد",35,"د",1,0],["بِزُجاجَةٍ مِلءِ اليَدَينِ كأَنَّها","قِنديلُ فُصحٍ في كَنيسَةِ راهِبِ",36,"ب",1,0],["بَزَغَتْ بِهِ شَمْسُ الْهِدَايَةِ بَعْدَ مَا","أَفَلَتْ وَأَبْصَرَ كُلُّ طَرْفٍ أَرْمَدِ",37,"د",1,0],["بِزَفَافِ عَبْدِ اللّهِ كَمْ مِنْ غَافِرٍ","لِزَمَانِهِ ذَنْباً وَكمْ مِنْ شَاكِرِ",38,"ر",1,0],["بَزَّتكَ ثاراً يَدٌ تَساوى","فيها عِقابٌ وَعَندَليبُ",39,"ب",1,0],["بَزَغَتْ في مشارقِ المجدِ شَمْساً","وبدَا في مطالِع السعدِ بَدْرا",40,"ر",2,0],["بزاهرها السامي الذرا جاده الحيا","تشير الثريا نحونا ونشير",41,"ر",1,0],["بِزُجاجَةٍ صَفْراءَ ذاتِ أَسِرَّةٍ","قُرِنَتْ بِأَزْهَر في الشَّمالِ مُقَدَّمِ",42,"م",1,0],["بزاهرها السامي الذي جا/ه الحيا","تشير الثريا نحونا ونشير",43,"ر",1,0],["بِزَفوفٍ كأنَّها هِقْلَة ٌ أُمُّ","مٌ رئالٍ دّوّية ُ سقفاءُ",44,"ا",2,0],["بزمرة ركب المؤمنين جميعهم","بما جاء من أمر قديم وتبيان",45,"ن",1,0],["بزيارةٍ لمحبكمْ","كَىْ ما يكون له قَدَرْ",46,"ر",1,0],["بزَّني دهريَ اللئيمُ كَريما","كانَ لي والداً وكنتُ أنا ابْنا",47,"ن",2,1],["بَزُّوا ثَمانينَ دِرعاً مِن سُراتِهِمُ","في حَملَةٍ تَرَكَت هاماتِهِم رِمَما",48,"م",2,0],["بِزخارفٍ مَلَكت هوا","كَ فأنتَ فيها الدهرَ رافِث",49,"ث",1,0],["بِزَهمانَ لَو كانَت تَكَلَّمُ أَخبَرَت","بِما لَقِيَت بَعدَ الأَنيسِ مِن العَجَبِ",50,"ب",1,0],["بَزَّها الأَمرَ أَيِّدٌ نَعِرُ النِيْ","لية لا يطبيهِ إِلّا الخَلاءُ",51,"ا",2,0],["بَزَغَت فوقَ فرقِكَ الشمسُ تاجاً","تَتلالا أنوارهُ الذهبيّه",52,"ي",2,0],["بزنود وقوام وخدود","ثم يمشي بعد هذا الخيلاء",53,"ا",2,0],["بزجاجَتَينِ وعَدتَني من قُرقُفٍ","لم تبقَ فيها فضلةٌ لم تُفرَز",54,"ز",1,0],["بزغَ الصباحُ عليكِ ثم على","قلبي وصبَّحني بك السعدُ",55,"د",1,0],["بزَّ المذكي سابقاً","فمن المصلِّي والمجل",56,"ل",1,0],["بزَّتْ نساءَ