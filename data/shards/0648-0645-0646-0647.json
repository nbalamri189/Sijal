["ومنها ليوم المِهرَجان قلادةٌ","تحلِّيه والأيامُ تَحلَى وتَعطَلُ",180,"ل",1,0],["ومنهمُ من تاب بعد موته","وليس بعد الموت للمرءِ عملْ",181,"ل",1,0],["ومنه الفضل إسماعيل خالٌ","كما إكمال موقِ العين مُوقُ",182,"ق",1,0],["ومنه فرعا مكةٍ وطيبةٍ","تشعَّبا ومنه بيتُ المقدِسِ",183,"س",1,0],["ومَن هُزَّ من بين الوسائد طودهُ","وفي دسته ثهلانُ لا يتزحزحُ",184,"ح",1,0],["ومنها ومن أترابها في ثرى الحمى","عبائقُ تَهديها الصَّبا لِيَ والتربُ",185,"ب",1,0],["ومنهُمُ في حربها وسلمها","رمحٌ يَخُطُّ ولسانٌ يخطبُ",186,"ب",1,0],["ومَنْ هذا يردّ عِنانَ طِرْفي","إليك إن استمرّ بِيَ الرُّكوبُ",187,"ب",1,0],["ومنهم أغَرُّ الوجه يشرقُ نورُه","بشيبته جادَ البلاد مَطيرها",188,"ر",3,0],["وَمَن هُوَ لا يَزدادُ إِلّا تَشَوُّقاً","وَلَيسَ يَرى إِلّا عَلَيهِ رَقيبُ",189,"ب",1,0],["وَمَن هُو البَحرُ الَّذي دائباً","يَغمُرُني آذِبُه الطامي",190,"م",2,0],["وَمَن هُوَ المَرءُ كُلَّ يَومٍ","أَموالُهُ مِنهُ مُستَضامَه",191,"م",2,0],["وَمَن هُوَ عِندِيَ مُذ لَم يَزَل","أَجَلَّ الوَرى وَأَعَزَّ البَشَر",192,"ر",1,0],["وَمَن هُوَ المَرءُ لَم يَزَل","يَصدُقُ في القَوبلِ وَلا يَكذِبُ",193,"ب",1,0],["ومن هو من أهل المعارف شامنا","فأبدى عشير العشر في شأن صحبة",194,"ه",1,0],["ومن هو من أهل المعارج غابنا","وأنكرنا والجهل شأن البرية",194,"ه",1,0],["ومن هو قبل الراح لعسه","نبي الورى فافهم مكان خصبيتي",195,"ت",2,0],["ومن هو شيء قد أضاء في فوقه","وإن زلته حرفا فجمرا لكرعيتي",195,"ت",2,0],["ومن ها هنا علم الجدال تشعبت","موارده في الذب عن كل نافل",196,"ل",1,0],["وَمِنهُنَّ مَن قَد شَقَّقَ الخَمشُ وَجهَها","مُسَلِّبَةً قَد مَسَّ أَحشاءَها العِبَر",197,"ر",1,0],["ومنه للطُّهرِ عليٍّ وإلى السِّ","بْطَيْنِ والزَّهراءِ نِعمَ الأَربعَهْ",198,"ع",2,0],["ومنهُمْ إلى الرِّفاعِيِّ الَّذي","على رِجالِ اللهِ رَبِّي رَفَعَهْ",198,"ع",2,0],["ومنهُمْ بأَبناءِ الرِّفاعِيِّ أُودِعَتْ","طرائقُها مَحفوفةً بالمواهِبِ",199,"ب",1,0],["ومنها لفردوسِ الطفولةِ حولي","ولا تكبري فالشّيبُ محضُ خذولِ",200,"ل",1,0],["ومنها رجوع الغز عن مصر بعدما","أبيح بهم وأغوارها ونجودها",201,"د",3,0],["ومنهن أيام رأينا وزارة","لغيرك عادت بعدما صد خودها",201,"د",3,0],["وَمن هَويتَ اِذا جاوَزنَ ذا عُبَبٍ","وَضيفَةَ الحَزنِ لا دانَ وَلا صَقِبُ",202,"ب",1,1],["وَمَنْ هُوَ أَبْقاهُ الإلَهُ بَقِيَّةٌ","لَنا ولأهْلِ العَصْرِ منْ كُلّ معْشَرِ",203,"ر",1,0],["ومَنْ هُوَ الفَارِسُ السَّبّاقُ إنْ عَصَفَتْ","للمُشْكِلاتِ رِياحُ الْمَيْدِ والأَيَدِ",204,"د",1,0],["ومَنْ هُمُ القادَةُ إنْ","أَعْضَلَ أَمْرٌ أو عَتا",205,"ت",2,0],["ومِنْهُمُ العالِمُ السَّبّاقُ في رُتَبٍ","حَتَّى حَوَى غايَةً تَعْنُو لَهَا والرتَبُ",206,"ب",1,0],["وَمِنها بشَرقيِّ المَذاهِبِ دِمنَةٌ","مُعَطَّلَةٌ آياتُها لَم تَتَغَيَّرِ",207,"ر",1,0],["ومَن هو ناقصٌ لم يدنُ يوماً","بتفضيلٍ إلى دارِ التَّمامِ",208,"م",1,0],["ومُنْهَلٌّ من العَبَراتِ تجري","فينطِقُ إِنْ سكتُّ بسوء حالي",209,"ل",2,0],["وَمن هو غُفْلٌ قبل وَسْمِي وعاطلُ ال","تَرائب لولا دُرُّ نَظْميَ أو نثري",210,"ر",2,0],["ومنهُ زادنا فضلاً","وبالتوفيق قد أنعمْ",211,"م",1,0],["ومنه الماء أخرجنا","لذيذاً طعمه في الفمْ",211,"م",1,0],["ومن هو عندي إن حضرت به أنا","ولكنها جلت علي مواهبه",212,"ب",2,0],["ومن هو النور من فياض نورك قد","خلقت كل الورى منه بتكوين",213,"ن",1,0],["ومنه قد صار في ذهول","وفي اندهاش لما يعاني",214,"ن",2,0],["ومنه لا تن","فع التمائم",215,"م",1,0],["ومن ههنا ألهى التكاثرُ أمة","محققها من كوثر هو جارع",216,"ع",1,0],["ومنهم بريءٌ إنني وإن انتموا","إلي على كره لدي ولي زجر",217,"ر",1,0],["ومنه لي نفس الرحمن منهبط","لم يبق من جملتي شيئاً ولم يذر",218,"ر",1,0],["ومنه لنا علوم","وإكرام وجود",219,"د",1,0],["ومنه إلى الكرسي تنزلت بل إلى","سمواتي السبع الطباق العلية",220,"ه",1,0],["ومنه إبليس كان خلقاً","له افتخار وكبرياء",221,"ا",2,0],["ومنه الأنبيا عصموا وعنه","شعار الصالحين الأتقياء",222,"ا",2,0],["ومَن هُوَ البَطلُ الحامي الدِّيارِ ومن","كانت لهُ الخُطَبُ الغرَّاءُ والحِكَمُ",223,"م",1,0],["وَمَن هَديُهُ ساوى النَهارَ وَلَيلُهُ","فَأَمسى يُنيرُ الخافِقَينِ كَما أَضحى",224,"ح",2,0],["وَمَن هُوَ غَيثٌ أَخضَلَ الأَرضَ رَوضُهُ","فَلا يَظمَأُ الآوي إِلَيهِ وَلا يَضحى",224,"ح",2,0],["وَمِنهُ صَومُ دَهرٍ راجِلاً في ال","قُيوظِ وَفَكُّ أَسرى في القُيودِ",225,"د",1,0],["ومنهم فيما رووا سعيد","وابن الأرت فيهم معدود",226,"د",1,0],["ومنهم سلمان فيما اثروا","وحدثوا عنهم ومنهم جابر",226,"ر",1,0],["ومنهم ابن عامر للأثرة","ولاه عثمان يقال البصرة",226,"ه",1,0],["ومنهم فيما روي مروان","وقد ذكرت ما أتى عثمان",226,"ن",1,0],["ومَنهلِ بِرٍّ أَتَى نَاهِلاً","ويَأْتِي إِلى الْمنْهلِ النَّاهِلُ",227,"ل",1,0],["ومَن هُو يَسْري في الْفَيافِي وإِنما","إِلى النَّجْم يَسْري بَلْ علَيْه يُعرِّسُ",228,"س",1,0],["ومِنْه وفِيه بالمدائِح نَظْمُه","وَفيه ومِنْه بالمحامِد نَثْرُه",229,"ر",2,0],["ومنه غِنَاهُ إِذْ إِليْه افتِقَارُه","وإِنَّ غِناه قَبْل ذلك فَقْرُه",229,"ر",2,0],["ومن هابَ من هذا الأَنامِ زمانَه","فقلْ لِزماني إِنَّني لا أَهَابُه",230,"ب",2,0],["وَمَنْ هُوَ دُونَ أَنْ يَرْنُو بِطَرْفٍ","إِلَيكَ فَكَيْفَ تَنْظُره عَدِيلا",231,"ل",2,0],["ومنها وهو ثانيها إذا ما","يفوت الورد يوماً لاشتغال",232,"ل",1,0],["ومنها شحه بالوقت يمضي","ضياعاً كالشحيح ببذل مال",232,"ل",1,0]]}