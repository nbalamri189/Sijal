","الوافر"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"قد أغتدي وفي الدجى مبالغ","https://www.aldiwan.net/poem26840.html","الرجز"],[52,"أبى القلب إلا حب من هو هاجر","https://www.aldiwan.net/poem27043.html","الطويل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"تعاليت رب النجم هل هو عالم","https://www.aldiwan.net/poem22658.html","الطويل"],[76,"بنفسي من مراشفه مدام","https://www.aldiwan.net/poem38996.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16640","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16651","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55027","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200123","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1945","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=18932",""],[43,"من الجآذر في زي الأعاريب","https://www.poetsgate.com/ViewPoem.aspx?id=175",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[0,"جزعتُ ولم أجزع من البين مجزعاً","https://www.poetsgate.com/ViewPoem.aspx?id=4804",""],[57,"ومن هاب الرجال تهيبه","https://www.poetsgate.com/ViewPoem.aspx?id=3234",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[35,"وإنّكَ عمري هل ترى ضوءَ بارقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=21993",""],[35,"تَقَطَّعَ مِنْ ظَلاَّمَة َ الوَصْلُ أجمَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=22041",""],[28,"أقول لصاحبي من التعزي","https://www.poetsgate.com/ViewPoem.aspx?id=17932",""],[38,"ألا اسلمي اليومَ ذاتَ الطّوقِ والعاجِ","https://www.poetsgate.com/ViewPoem.aspx?id=21139",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[30,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[2,"أمِنْ أُمّ أوْفَى دِمْنَة ٌ لمْ تَكَلّمِ ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19474&r=&rc=0",""]],"verses":[["وَمِن هَذا يَقومُ مَقامَ فَضلٍ","قَعَدنَ لَهُ ذُرى الصُمِّ الصِلادِ",0,"د",1,0],["وَمِن هِمَمٍ أَوجَدنَني في عَشيرَتي","وَأَكثَرنَ ما بَينَ الأَقارِبِ غُربَتي",1,"ي",1,0],["وَمِن هاوٍ تَرَنَّحَ في العَوالي","وَعارٍ قَد أَقامَ عَلى العَراءِ",2,"ا",2,0],["ومَنْ هؤُلَيّاءِ العُريْبُ على اللِّوى","لخَيْلِهِمُ بالوادِيَيْنِ عَنيقُ",3,"ق",1,0],["وَمَن هُوَ مَحجوبٌ كَلِفتُ بِحُبِّهِ","صَحيحٌ مَريضُ المُقلَتَينِ إِذا نَظَر",4,"ر",1,0],["وَمِنهُنَّ أَلّا يَعرِضَ الدَهرُ ذُكرَها","عَلى القَلبِ إِلّا كادَتِ النَفسُ تَتلَفُ",5,"ف",1,0],["وَمَن هابَ الرِجالَ تَهَيَّبوهُ","وَمَن حَقَّرَ الرِجالَ فَلَن يُهابا",6,"ب",2,1],["وَمِنهُنَّ رَكضُ الخَيلِ تَرجُمُ بِالفَن","يُبادِرنَ سِرباً آمِناً أَن يُفَزَّعا",7,"ع",2,0],["وَمِنهُنَّ نَصُّ العيسِ وَاللَيلُ شامِلٌ","تَيَمَّمُ مَجهولاً مِنَ الأَرضِ بَلقَعا",7,"ع",2,0],["وَمِنهُنَّ سَوفُ الخودِ قَد بَلَّها النَدى","تُراقِبُ مَنظومَ التَمائِمِ مُرضَعا",7,"ع",2,0],["وَمِنها بِأَجزاعِ المَقاريبِ دِمنَةٌ","وَبِالسَفحِ مِن فُرعانَ آلٌ مُصَرَّعُ",8,"ع",1,0],["وَمِنهُنَّ إِكرامُ الكَريمِ وَهَفوَةُ ال","اليَتيمِ وَخَلّاتُ المَكارِمِ تَنفَعُ",8,"ع",1,0],["وَمِنهُ بِصَخرِ المَحوِ وَدقُ غَمامَةٍ","لَهُ سَبَلٌ واِقوَرَّ مِنهُ الغَفائِرُ",9,"ر",1,0],["وَمِنهُ بِذي دَورانَ لَمعٌ كَأَنَّهُ","بُعيدَ الكَرى كَفّا مُفيضٍ بِأَقداحِ",10,"ح",1,0],["ومنهمالشهم الذي يزدهي","بمثله في الفتية الغر",11,"ر",1,0],["ومنهم الحر الذي يفتدي","أخلاقه كل فتى حر",11,"ر",1,0],["ومنهم الجوزاء في أوجها","أو أختها بالصون والطهر",11,"ر",1,0],["وَمِنْهُمُ السَّالِمُ لَكِنَّهُ","مِنْ مُغْرِيَاتِ السُّوءِ لا يَسْلَمُ",12,"م",1,0],["وَمِنْهُ مُعِدَّاتُ الْجِلادِ الَّتِي بِهَا","نُدَافِعُ عَنَّا مِنْهُ مَنْ يَتَقَحَّمُ",13,"م",1,0],["وَمَنهَلٍ صَخِبِ الأَصدَاءِ وَارِدُه","طَيرُ السَّمَاءِ تَحومُ الحَينُ أَو تَقَعُ",14,"ع",1,0],["وَمَنهَلٍ آجِنٍ كَالغِسلِ مُختَلَطٍ","باكَرتُهُ قَبلَ تَرنيمِ العَصافيرِ",15,"ر",1,0],["وَمَنهَلٍ أَعرى خَباهُ الحُضَّرُ","طَامِي النِطافِ آجِنٍ لا يُجهَرُ",16,"ر",1,0],["وَمَنهَلٍ آجِنٍ قَفرٍ مَحاضِرُهُ","تُذري الرياحُ عَلى جَمّاتِهِ البَعَرا",17,"ر",2,0],["وَمَنهَل مِنَ القَطا مَورودِ","أَجنِ الصَرى ذي عَرمَض لَبودِ",18,"د",1,0],["وَمَنهَل آجِنٍ قَفر مَحاضِرُهُ","خُضرٍ كَواكِبُهُ ذي عَرمَض لَبد",19,"د",1,0],["وَمنهَلٍ آجِنِ الجَمّاتِ مُجتَنَبٍ","غَلَّستُهُ بِالهِبِلاّتِ الهَماليجِ",20,"ج",1,0],["ومنه تلقى الهديَ كلُّ خليفةٍ","كأنّهُمُ ممّا أفاد تعلّموا",21,"م",3,0],["ومنهُمُ كل تصحيح إذا وعَدُوا","وفي وعيدهم بالشرِّ تمريض",22,"ض",1,0],["ومن هجا ماجداً أخا شرف","فليس إلا من نفسه يضع",23,"ع",1,0],["وَمَنهَلٍ آجِنٍ غُبرٌ مَوارِدُهُ","خاوي العُروشِ يَبابٍ غَيرِ إِنهاجِ",24,"ج",1,0],["ومِنْهُ اللَّذيذُ ومِنْهُ الكَريهُ","ومِنْهُ المشِيدُ ومِنْهُ المبيدْ",25,"د",1,0],["ومنه ما رق حتى","كأنه عبرات",26,"ت",1,0],["ومنها السمين بحجم الخروف","ومنها الضئيل بحجم الجرادة",27,"د",2,0],["وَمِنها الظاهِراتُ وَأُخرَياتُ","تَوارى في الصُخورِ وَتَستَسِرُّ",28,"ر",1,0],["ومِنْ هناكَ انْبَرَى الزَّمانُ لهمْ","بعدَ الْتِياطٍ بغارِبٍ جَشِبِ",29,"ب",1,0],["وَمِن هَوى كُلِّ مَن لَيسَت مُمَوَّهَةً","تَرَكتُ لَونَ مَشيبي غَيرَ مَخضوبِ",30,"ب",1,0],["وَمِن هَوى الصِدقِ في قَولي وَعادَتِهِ","رَغِبتُ عَن شَعَرٍ في الرَأسِ مَكذوبِ",30,"ب",1,0],["ومنه تولد أصباغنا","فيغدو به ماؤنا وهو دم",31,"م",1,0],["وَمِنها إِذا ما الهَزلُ حانَت هَناتُهُ","مُنى النَفسِ في سِترٍ عَنِ الفُحشِ حاجِبِ",32,"ب",1,0],["وَمَن هُم وَأَنتُم يَدا نُصرَةٍ","وَحَدّا حُسامٍ قَديمِ الأُثُر",33,"ر",1,0],["وَمِنهُنَّ مَشغولٌ بِهِ الطَرفُ هارِبٌ","بِعَينَيهِ مِن لَحظِ المُحِبِّ المُخالِسِ",34,"س",1,0],["وَمِنهُم كانَتِ الرُؤَساءُ قِدماً","وَهُم قَتَلوا العَدُوَّ بِكُلِّ دارِ",35,"ر",1,0],["وَمِنهُنَّ إِذ راعى جَناباً وَقَد دَنا","إِلى بابِ مِغلاقِ الشَبا غَيرِ مُغلَقِ",36,"ق",1,1],["وَمِنهُنَّ إِذ أَرخى طُفَيلُ اِبنُ مالِكٍ","عَلى قُرزُلٍ رِجلي رَكوضِ الهَزائِمِ",37,"م",1,0],["ومَنهَلٌ راقَ وِردُه فغَدا","يَطرُدُ عنَّا الإعْدامَ مُطَّرَدُه",38,"د",2,0],["وَمِنهُم مانِعُ البَطحاءِ حَزنٌ","وَكانَ سِدادَ مَركَبَةٍ كِفاها",39,"ا",3,0],["وَمَن هابَ أَسبابَ المَنِيَّةِ يَلقَها","وَلَو رامَ أَسبابَ السَماءِ بِسُلَّمِ",40,"م",1,0],["وَمَن هُوَ في الجِنانِ يَدَرُّ فيها","عَلَيهِ الرِزقَ مُغتَبِطاً حَميدا",41,"د",2,0],["وَمَن هابَ الرِجالَ تَهَيَّبوهُ","وَمَن يُهِنِ الرِجالَ فَلَن يُهابا",42,"ب",2,0],["وَمَن هُوَ الدائِمُ في مُلكِهِ","وَمَن هُوَ الباطِنُ وَالظاهِرُ",43,"ر",1,0],["وَمَن هانَتِ الدُنيا عَلَيهِ فَإِنَّني","لَهُ ضامِنٌ أَن لا تُذَمَّ خَلائِقُه",44,"ق",2,0],["وَمَن هَذا الَّذي يَبقى","عَلى الحَدَثانِ أَو يَسلَم",45,"م",1,0],["وَمِنهُم مُلِفٌّ في الجَناحينِ رَأسَهُ","يَكادُ لِذِكرى رَبِّهِ يَتَفَصَّدُ",46,"د",1,0],["وَمَن هُوَ في قَولِهِ صادِقٌ","وَمَن أَمرُهُ مُبرَمٌ مُوجَحُ",47,"ح",1,0],["وَمِنها أَن يَنوءَ عَلى يَدَيهِ","وَيَنهَضَ في تَراقيهِ اِنحِناءُ",48,"ا",2,0],["وَمِن هَيبَةِ الرَحمانِ دُكَّ تَذَلُّلاً","فَشَرَّفَهُ الباري عَلى كُلِّ طائِلِ",49,"ل",1,0],["وَمِنهُمُ عيسى اِبنُ شَيخٍ وَاِبنُهُ","كِلاهُما لِصٌّ حَلالٌ لَعنُهُ",50,"ه",1,0],["وَمِنهُمُ الشَراةُ وَالحِرابُ","إِن سَمِعوا بِبَيعَةٍ أَجابوا",50,"ب",3,0],["وَمِنهُ لِلصُبحِ خَطيبٌ نابِغُ","وَاللَيلُ في المَغرِبِ عَنهُ رائِغُ",51,"غ",1,0],["وَمَن هُوَ عَنّي كُلَّما جِئتُ مُعرِضٌ","وَمَن لا يُوافيني وَمَن أَنا عاذِرُ",52,"ر",1,0],["ومنها نُجومٌ في بُروجِ مَجَرَّةٍ","عَلَى الأرضِ تَبْدُو تارَةً وتَغُورُ",53,"ر",1,0],["ومنهمْ أُناسٌ يُظْهِرُونَ مَوَدَّتِي","وبُغْضُهُمُ لِي مِنْ قِفا نَبْكِ أَشْهَرُ",54,"ر",1,0],["وَمَنْ هُوَ الآيَةُ الكُبْرَى لَمُعْتَبِرٍ","وَمَنْ هُوَ النِّعْمَةُ العُظْمَى لِمُغْتَنِمِ",55,"م",1,0],["وَمَن هَوِيَ الدُنِّيا الكَذوبَ فَإِنَّهُ","رَهينٌ بِثَوبَي ذِلَّةٍ وَصَغارِ",56,"ر",1,0],["ومَن هوَ إنْ بدا والبدْرُ تِمٌّ","خَفِي مِنْ حُسنِهِ البدرُ التَّمامُ",57,"م",1,0],["ومنه تقليد من قد","مضى ومنه اقتراع",58,"ع",1,0],["ومن هيَ الغادةُ التي","تنسلُّ من مخدعي إليها",59,"ه",2,0],["وَمَن هُوَ ذو وَجهَينِ لَيسَ بِدائِمٍ","عَلى العَهدِ خَلّافٌ بِكُلِّ يَمينِ",60,"ن",1,0],["ومَنْ هوَ حتى يُحْمَلَ النّطْقُ عن فمي","إليه وتمْشي بينَنا السُّفَراء",61,"ر",3,0],["ومَنْهَلٍ تَرِدُ الجَوْزاءُ غَمْرَتَه","إذا السِّماكانِ شطْرَ المغْرِبِ اعترَضَا",62,"ض",2,0],["ومنهمو من مزّق الكتابا","معاتباً يا قبحه عتابا",63,"ب",2,0],["وَمِنْهُمْ كِرَامٌ إِذَا مُحِّصُوا","سَمَا طَبعُهُمْ وَتَنَقَّى وَعَف",64,"ف",1,0],["وَمَنْ هُو لَمْ تَتْرُكْ لَهُ الحَرْبُ مَفْخَراً","وَمَنْ خدُّهُ يومَ الكَرِيهَةِ أضرعُ",65,"ع",1,0],["ومنهم أبو العباس يحيى بن خالد","وصاحبه الحبر النبيل أبو عمرو",66,"ر",2,0],["ومنهم أبو الخطاب نجل ابن يوسف","سليل ابن يمن جل ذلك من وزر",66,"ر",1,0],["وَمِنهُنَّ رَكضُ الخَيلِ تَرجُمُ بِالفَنا","يُبادِرنَ سِرباً آمِناً أَن يُفَزَّعا",67,"ع",2,0],["ومِنَّةٍ كانت جَنَاحاً له","طارَ بهِ الذائعُ من ذِكْرِهِ",68,"ر",2,0],["ومنها أن ينوءَ على يديه","ويَظْهَرَ في تَرَاقِيهِ انْحِنَاءُ",69,"ا",2,0],["وَمِن هَوى الصِدقِ في قَولي وَعادَتِهِ","رَغِبتُ عَن شَعَرٍ في الوجه مَكذوبِ",70,"ب",1,0],["ومِنْ هذي الكُوى سيُطِلُّ فجرٌ","ضَحوكٌ يملأ الدُّنيا كَشوف",71,"ف",1,0],["ومنها الذي تدنو فتبعدُ نُزَّعاً","شواخِصُهُ مِثْلَ السَّرابِ المُخادع",72,"ع",1,0],["ومنها الذي لا أنتَ عنهُ إذا دَنا","براضٍ ولا منهُ – بعيداً – بجازع",72,"ع",1,0],["وَمنهُنَّ: رَكْضُ الخَيْلِ تَرْجُمُ بِالقَنا","يُبادُرْنَ سِرْباً آمِناً أنْ يُفَزَّعا",73,"ع",2,0],["وَمِنْهُنَّ: سوْقي الخَوْدَ قَد بَلّها النَّدى","تُرَاقِبُ مَنْظُومَ التَّمائِمِ، مُرْضَعا",73,"ع",2,0],["ومن هاب الرجال تهيبه","ومن حقر الرجال فلن يهابا",74,"ب",2,1],["ومنهن سبقي العاذلات بشربةٍ","كميتٍ متى ما تعل بالماء تزبد",75,"د",1,0],["ومنهُ بذي دورانَ لمعٌ كأنَّهُ","بُعيدَ الكَرَى كَفَّا مُفِيضٍ بأقدُحِ",76,"ح",1,0],["وَمِنْهُنَّ إكْرَام الكَرِيم وَهَفْوَة ُ ال","اللئيمِ،وخلاّتُ المكارمِ تنفعُ",77,"ع",1,0],["وَمِنْهُمْ كانَتِ الرّؤسَاءُ قِدْماً،","وَهُمْ قَتلُوا العَدُأ بِكُلّ دارِ",78,"ر",1,0],["وَمَنْهَلٍ کجِنٍ غُبْرٍ مَوَارِدُهُ","خَاوي العُرُوشِ يَبَابٍ غَيْرِ إنْهَاجِ",79,"ج",1,0],["وَمَنْ هَابَ أَسْبَابَ المَنَايَا يَنَلْنَهُ","وَإِنْ يَرْقَ أَسْبَابَ السَّمَاءِ بِسُلَّمِ",80,"م",1,0],["وَمَنْهَلٍ آجِنٍ قَفْرٍ مَحَاضِرُهُ","تذري الرِّياحُ على جمَّاتهِ البعا",81,"ع",2,0],["وَمَن هابَ أَسبابَ المَنِيَّةِ يَلقَها","وَإن يرق أَسبابَ السَماءِ بِسُلَّمِ",82,"م",1,0]]}