",1,0],["ومنهمُ في رؤوس الشمِّ مُنهزما","ومنهمُ في مفازاتٍ وما قُبرُوا",91,"ر",3,0],["ومن هو في الدين الحنيفي قيِّمٌ","ومَنْ هو في تدبيره مَلِكٌ فردُ",92,"د",1,0],["ومنهم من سرى يمشي مكبًّا","فعاد رجوعهُ فوق المحالِ",93,"ل",1,0],["ومنهم من أحاطَ بهِ الأعادي","ما أجداه إدرارَ النوالِ",93,"ل",1,0],["وَمِنهُ إِلى حَمدانَ كُلُّ مُمَلَّكٍ","لَهُ الجودُ وَكدٌ وَالمَحامِدُ مَكسَبُ",94,"ب",1,0],["وَمِنهُ النَدى يَعتادُ في كُلِّ لَحظَةٍ","وَغيرُكَ بِالأَدنى مِنَ الجودِ يَعتَدُّ",95,"د",1,0],["وَمِنهُم رِجالٌ قارَعوا عَن نَبيِّهِم","بِبَدرٍ وَمِنهُم ذو العِصابَةِ في أُحدِ",96,"د",1,0],["وَمِنهُم وَما الإِنصافُ إِلّا ديانَةٌ","لِأَحمَدَ خَيرَ العالَمينَ مَكانَةٌ",97,"ه",1,0],["وَمِنهُ لِمَن أَضحى عَنِ الإِفكِ مُعرِضا","طِلاوَةُ حُسنٍ مِن شَمائِلِهِ الرِضى",98,"ض",2,0],["وَمَنْ هُوَ الشَّمْسُ فِي أُفْقٍ بِلا فَلَكٍ","وَمَنْ هُوَ البَدْرُ في أَرْضٍ بِغَيْرِ سَمَا",99,"م",2,0],["ومُنهَتِكٍ لَهُ نَظَرٌ","يَصُونُ مَوَاقِعَ النَّظَرِ",100,"ر",1,1],["ومن هو في الإِحسان والجود آيةٌ","عليها جرى إِجماع من طبعه الجحدُ",101,"د",1,0],["ومن هين في عينه قتله ابنه","إذا ما رأى منه لك النصح قد قلا",102,"ل",2,0],["ومن هزم الأعداء وهي جحافل","وقل جيوش العد في زمن الكسر",103,"ر",1,0],["ومن هو يستفتي عن العبد قلبه","فيفتيه عن غش به أو نصيحة",104,"ه",1,0],["وَمِنهُ ما تَقتَحِمُ العَينُ فَإِن","ذُقتَ جَناهُ اِنساغَ عَذباً في اللها",105,"ا",1,0],["ومَنْ هابَني في كلِّ أَمْرٍ وهِبْتُهُ","ولَوْ كُنْتُ أَمْضي من شَباةِ سِنانِ",106,"ن",1,0],["ومِنْهُمُ نُخَبٌ باعوا الوَرى خُطَبًا","عَنْ حُرْمَةِ الدَّمِّ فانفَضّوا وما اتّأدوا",107,"د",3,0],["وَمِنهُم خَالِدٌ طاحَت يَدَاهُ","وَهَامَةُ جَابِرٍ لَمّا انتُضِينَا",108,"ن",2,0],["وَمَن هُوَ أهوَى كُلِّ مَن وَطِىءَ الحَصى","إِلىَّ وَيَجفونى ويَغلُظُ جانبُه",109,"ب",2,0],["وَمِنه حديثُ الشمسِ بعدَ غُروبها","فَتسجدُ تحتَ العرشِ تَستأذنُ السيرا",110,"ر",2,0],["وَمنهُ القُوى فينا وقد يستردّها","وَكلُّ اِمرئٍ منّا بحالته أدرى",111,"ر",2,0],["وَمِنهم قدِ اِختارَ الحبيبَ مُحمّداً","نَبيَّ الهُدى روحَ الوجودِ أبا الزهرا",111,"ر",2,0],["وَمِنهم قسوسٌ خالَفوا الناس للأذى