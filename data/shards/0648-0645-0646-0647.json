ى","ومن رنماتِ العودِ في كفّ مُغرم",134,"م",1,0],["ومنها النَّدى والخصبُ والعدلُ والهُدى","فَعَمَّت جميعَ العالمينَ المراحِم",135,"م",1,0],["وَمنه ظل لواء الحمد يشملنا","اذا العصاة عليهم من لطى ظلل",136,"ل",1,0],["وَمنه في الشيخ عبدالقادر ابتهجت","طَلائِع الفَظل نورا في محياه",137,"ا",2,0],["ومن هو فرد لا نَظير له وَلا","شَبيه وَلا مثل به يَتَمَثَل",138,"ل",1,0],["وَمِن هَزارٍ إِذا دَعا سحراً","جاءَ بِداوودَ وَالمَزاميرِ",139,"ر",1,0],["ومنهم يعيش بأخباره","فذكراه كالمسك يضوّع",140,"ع",1,0],["ومن هنا وههنا","تدورُ دورَ البكره",141,"ر",2,0],["ومن هو جنة العافي إذا ما","رماه سهم فاقته وفوق",142,"ق",1,0],["ومنهم رجال يؤثرون سياحة","وسكنى مغارات الجبال وقفرة",143,"ه",1,0],["ومنهم رجال ظاهرون بأمره","لإرشاد هذا الخلق نهج الطريقة",143,"ه",1,0],["ومن هو النعمة العظمى لمغتنم","صلي وسلم رب العرش والأمم",144,"م",1,0],["ومن ها هنا جذب القلوب وميلها","ومنه مطر الروح من كل طائر",145,"ر",1,0],["وَمِنهمُ العلماءُ الوارثونَ غَدت","كَرامةُ مُعجزات الأنبيا لهمُ",146,"م",1,0],["وَمِن هابَني في كلّ شيءٍ وهبتهُ","فَلا هو يُعطيني ولا أَنا سائِلُه",147,"ل",2,0],["وَمِنهُ غُثاءٌ لا يُفارِقُ أَهلَهُ","كَمِثلِ الحَرونِ لا يَكُرُّ وَلا يَمضي",148,"ض",2,0],["وَمِنهُم قَصيرٌ رامَ مَجداً فنالَهُ","وَآخَرُ هَيقٌ في الحِفاظِ قصيرُ",149,"ر",1,0],["وَمَن هَذا عَلى الأَيّامِ تَبقى","مَضارِبُهُ بِمَدرَجَةِ السُيولِ",150,"ل",1,0],["ومنهم حجر","ومنهم خشب",151,"ب",1,0],["وَمِنهُ القَبولُ يُديمُ النَعيمَ","وَعَنهُ الخِلافُ يُزيدُ الشَقاءَ",152,"ا",2,0],["وَمِنهُ طِلسَمِيَّ ظَلِّ اِسمُهُ","لِكُلِّ مَولىً عَبدُهُ رَبُّ",153,"ب",1,0],["وَمِنهُ بِالسَمعِ بَصيراً غَدا","مِنّي فُؤادٌ مالُهُ قَلبُ",153,"ب",1,0],["وَمِنها يَنظُرُ الأَكمَ","هُ في اللَيلِ ضُحى الفَجرِ",154,"ر",1,0],["وَمِنهُ في الشَرقِ وَفي ال","غَربِ مَيامينٌ غُرَر",155,"ر",1,0],["وَمِنهُمُ القَومُ الأولى","لَم يَنحَلوا يَزدانَ شَر",155,"ر",1,0],["وَمِنهُمُ مَن لِلمَسيحِ","الحَيِّ في اللَهِ نَصَر",155,"ر",1,0],["وَمِنهُمُ الجَيشُ الَّذي","بِالفَتحِ لِلشِركِ كَسَر",155,"ر",1,0],["وَمَن هُوَ الرَحمَة العُظمى لذي أَلَمٍ","وَمَن هُوَ النعمة الكُبرى لذ