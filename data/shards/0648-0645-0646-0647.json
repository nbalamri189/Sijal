"عموديه"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[483,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[491,"ألا علِّلاني واعلما أنني غرر","https://www.aldiwan.net/poem654.html",""],[501,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[501,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[506,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[516,"لك المعجزات الخمس لم يفتخر بها","https://www.aldiwan.net/poem12087.html","الطويل"],[517,"ومن هويت اذا جاوزن ذا عبب","https://www.aldiwan.net/poem48723.html","البسيط"],[530,"سلام على شيخ الفواطم عن يد","https://www.aldiwan.net/poem37386.html","الطويل"],[530,"يا من له في المعالي أرفع السند","https://www.aldiwan.net/poem37463.html","البسيط"],[530,"يا بن الأولى في شانهم","https://www.aldiwan.net/poem37491.html","مجزوء الرجز"],[530,"في حاديات الليالي للفتى عجب","https://www.aldiwan.net/poem37535.html","البسيط"],[541,"عفا سائر منها فهضب كتانة","https://www.aldiwan.net/poem56821.html","الطويل"],[552,"ألا قل للوزير مقال مثن","https://www.aldiwan.net/poem47206.html","الوافر"],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[552,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"يخاطب كلا في المناجاة صاحبه","https://www.aldiwan.net/poem33525.html","الطويل"],[559,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[559,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[559,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[559,"افتح عيونك في الآيات والسور","https://www.aldiwan.net/poem34549.html","البسيط"],[559,"أنا الخلق الجديد","https://www.aldiwan.net/poem34582.html","مجزوء الوافر"],[559,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[559,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[559,"بلاء الأنبياء هو البلاء","https://www.aldiwan.net/poem35089.html","الوافر"],[563,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[564,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[564,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[576,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[576,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[576,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[587,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["ومن هشم الثريد قرى سنين ٍ","بها لم تطعم النار احتطابا",0,"ب",2,0],["وَمِن هَذا يَقومُ مَقامَ فَضلٍ","قَعَدنَ لَهُ ذُرى الصُمِّ الصِلادِ",1,"د",1,0],["وَمِن هِمَمٍ أَوجَدنَني في عَشيرَتي","وَأَكثَرنَ ما بَينَ الأَقارِبِ غُربَتي",2,"ت",2,0],["وَمِن هاوٍ تَرَنَّحَ في العَوالي","وَعارٍ قَد أَقامَ عَلى العَراءِ",3,"ا",2,0],["ومَنْ هؤُلَيّاءِ العُريْبُ على اللِّوى","لخَيْلِهِمُ بالوادِيَيْنِ عَنيقُ",4,"ق",1,0],["وَمَن هُوَ مَحجوبٌ كَلِفتُ بِحُبِّهِ","صَحيحٌ مَريضُ المُقلَتَينِ إِذا نَظَر",5,"ر",1,0],["وَمِنهُنَّ أَلّا يَعرِضَ الدَهرُ ذُكرَها","عَلى القَلبِ إِلّا كادَتِ النَفسُ تَتلَفُ",6,"ف",1,0],["وَمَن هابَ الرِجالَ تَهَيَّبوهُ","وَمَن حَقَّرَ الرِجالَ فَلَن يُهابا",7,"ب",2,1],["وَمِنهُنَّ رَكضُ الخَيلِ تَرجُمُ بِالفَن","يُبادِرنَ سِرباً آمِناً أَن يُفَزَّعا",8,"ع",2,0],["وَمِنهُنَّ نَصُّ العيسِ وَاللَيلُ شامِلٌ","تَيَمَّمُ مَجهولاً مِنَ الأَرضِ بَلقَعا",8,"ع",2,0],["وَمِنهُنَّ سَوفُ الخودِ قَد بَلَّها النَدى","تُراقِبُ مَنظومَ التَمائِمِ مُرضَعا",8,"ع",2,0],["وَمِنها بِأَجزاعِ المَقاريبِ دِمنَةٌ","وَبِالسَفحِ مِن فُرعانَ آلٌ مُصَرَّعُ",9,"ع",1,0],["وَمِنهُنَّ إِكرامُ الكَريمِ وَهَفوَةُ ال","اليَتيمِ وَخَلّاتُ المَكارِمِ تَنفَعُ",9,"ع",1,0],["وَمِنهُ بِصَخرِ المَحوِ وَدقُ غَمامَةٍ","لَهُ سَبَلٌ واِقوَرَّ مِنهُ الغَفائِرُ",10,"ر",1,0],["وَمِنهُ بِذي دَورانَ لَمعٌ كَأَنَّهُ","بُعيدَ الكَرى كَفّا مُفيضٍ بِأَقداحِ",11,"ح",1,0],["ومنهمالشهم الذي يزدهي","بمثله في الفتية الغر",12,"ر",1,0],["ومنهم الحر الذي يفتدي","أخلاقه كل فتى حر",12,"ر",1,0],["ومنهم الجوزاء في أوجها","أو أختها بالصون والطهر",12,"ر",1,0],["وَمِنْهُمُ السَّالِمُ لَكِنَّهُ","مِنْ مُغْرِيَاتِ السُّوءِ لا يَسْلَمُ",13,"م",1,0],["وَمِنْهُ مُعِدَّاتُ الْجِلادِ الَّتِي بِهَا","نُدَافِعُ عَنَّا مِنْهُ مَنْ يَتَقَحَّمُ",14,"م",1,0],["وَمَنهَلٍ صَخِبِ الأَصدَاءِ وَارِدُه","طَيرُ السَّمَاءِ تَحومُ الحَينُ أَو تَقَعُ",15,"ع",1,0],["وَمَنهَلٍ آجِنٍ كَالغِسلِ مُختَلَطٍ","باكَرتُهُ قَبلَ تَرنيمِ العَصافيرِ",16,"ر",1,0],["وَمَنهَلٍ أَعرى خَباهُ الحُضَّرُ","طَامِي النِطافِ آجِنٍ لا يُجهَرُ",17,"ر",1,0],["وَمَنهَلٍ آجِنٍ قَفرٍ مَحاضِرُهُ","تُذري الرياحُ عَلى جَمّاتِهِ البَعَرا",18,"ر",2,0],["وَمَنهَل مِنَ القَطا مَورودِ","أَجنِ الصَرى ذي عَرمَض لَبودِ",19,"د",1,0],["وَمَنهَل آجِنٍ قَفر مَحاضِرُهُ","خُضرٍ كَواكِبُهُ ذي عَرمَض لَبد",20,"د",1,0],["وَمنهَلٍ آجِنِ الجَمّاتِ مُجتَنَبٍ","غَلَّستُهُ بِالهِبِلاّتِ الهَماليجِ",21,"ج",1,0],["ومنه تلقى الهديَ كلُّ خليفةٍ","كأنّهُمُ ممّا أفاد تعلّموا",22,"م",3,0],["ومنهُمُ كل تصحيح إذا وعَدُوا","وفي وعيدهم بالشرِّ تمريض",23,"ض",1,0],["ومن هجا ماجداً أخا شرف","فليس إلا من نفسه يضع",24,"ع",1,0],["وَمَنهَلٍ آجِنٍ غُبرٌ مَوارِدُهُ","خاوي العُروشِ يَبابٍ غَيرِ إِنهاجِ",25,"ج",1,0],["ومِنْهُ اللَّذيذُ ومِنْهُ الكَريهُ","ومِنْهُ المشِيدُ ومِنْهُ المبيدْ",26,"د",1,0],["ومنه ما رق حتى","كأنه عبرات",27,"ت",1,0],["ومنها السمين بحجم الخروف","ومنها الضئيل بحجم الجرادة",28,"د",2,0],["وَمِنها الظاهِراتُ وَأُخرَياتُ","تَوارى في الصُخورِ وَتَستَسِرُّ",29,"ر",1,0],["ومِنْ هناكَ انْبَرَى الزَّمانُ لهمْ","بعدَ الْتِياطٍ بغارِبٍ جَشِبِ",30,"ب",1,0],["وَمِن هَوى كُلِّ مَن لَيسَت مُمَوَّهَةً","تَرَكتُ لَونَ مَشيبي غَيرَ مَخضوبِ",31,"ب",1,0],["وَمِن هَوى الصِدقِ في قَولي وَعادَتِهِ","رَغِبتُ عَن شَعَرٍ في الرَأسِ مَكذوبِ",31,"ب",1,0],["ومنه تولد أصباغنا","فيغدو به ماؤنا وهو دم",32,"م",1,0],["وَمِنها إِذا ما الهَزلُ حانَت هَناتُهُ","مُنى النَفسِ في سِترٍ عَنِ الفُحشِ حاجِبِ",33,"ب",1,0],["وَمَن هُم وَأَنتُم يَدا نُصرَةٍ","وَحَدّا حُسامٍ قَديمِ الأُثُر",34,"ر",1,0],["وَمِنهُنَّ مَشغولٌ بِهِ الطَرفُ هارِبٌ","بِعَينَيهِ مِن لَحظِ المُحِبِّ المُخالِسِ",35,"س",1,0],["وَمِنهُم كانَتِ الرُؤَساءُ قِدماً","وَهُم قَتَلوا العَدُوَّ بِكُلِّ دارِ",36,"ر",1,0],["وَمِنهُنَّ إِذ راعى جَناباً وَقَد دَنا","إِلى بابِ مِغلاقِ الشَبا غَيرِ مُغلَقِ",37,"ق",1,1],["وَمِنهُنَّ إِذ أَرخى طُفَيلُ اِبنُ مالِكٍ","عَلى قُرزُلٍ رِجلي رَكوضِ الهَزائِمِ",38,"م",1,0],["ومَنهَلٌ راقَ وِردُه فغَدا","يَطرُدُ عنَّا الإعْدامَ مُطَّرَدُه",39,"د",2,0],["وَمِنهُم مانِعُ البَطحاءِ حَزنٌ","وَكانَ سِدادَ مَركَبَةٍ كِفاها",40,"ا",3,0],["وَمَن هابَ أَسبابَ المَنِيَّةِ يَلقَها","وَلَو رامَ أَسبابَ السَماءِ بِسُلَّمِ",41,"م",1,0],["وَمَن هُوَ في الجِنانِ يَدَرُّ فيها","عَلَيهِ الرِزقَ مُغتَبِطاً حَميدا",42,"د",2,0],["وَمَن هابَ الرِجالَ تَهَيَّبوهُ","وَمَن يُهِنِ الرِجالَ فَلَن يُهابا",43,"ب",2,0],["وَمَن هُوَ الدائِمُ في مُلكِهِ","وَمَن هُوَ الباطِنُ وَالظاهِرُ",44,"ر",1,0],["وَمَن هانَتِ الدُنيا عَلَيهِ فَإِنَّني","لَهُ ضامِنٌ أَن لا تُذَمَّ خَلائِقُه",45,"ق",2,0],["وَمَن هَذا الَّذي يَبقى","عَلى الحَدَثانِ أَو يَسلَم",46,"م",1,0],["وَمِنهُم مُلِفٌّ في الجَناحينِ رَأسَهُ","يَكادُ لِذِكرى رَبِّهِ يَتَفَصَّدُ",47,"د",1,0],["وَمَن هُوَ في قَولِهِ صادِقٌ","وَمَن أَمرُهُ مُبرَمٌ مُوجَحُ",48,"ح",1,0],["وَمِنها أَن يَنوءَ عَلى يَدَيهِ","وَيَنهَضَ في تَراقيهِ اِنحِناءُ",49,"ا",2,0],["وَمِن هَيبَةِ الرَحمانِ دُكَّ تَذَلُّلاً","فَشَرَّفَهُ الباري عَلى كُلِّ طائِلِ",50,"ل",1,0],["وَمِنهُمُ عيسى اِبنُ شَيخٍ وَاِبنُهُ","كِلاهُما لِصٌّ حَلالٌ لَعنُهُ",51,"ه",1,0],["وَمِنهُمُ الشَراةُ وَالحِرابُ","إِن سَمِعوا بِبَيعَةٍ أَجابوا",51,"ب",3,0],["وَمِنهُ لِلصُبحِ خَطيبٌ نابِغُ","وَاللَيلُ في المَغرِبِ عَنهُ رائِغُ",52,"غ",1,0],["وَمَن هُوَ عَنّي كُلَّما جِئتُ مُعرِضٌ","وَمَن لا يُوافيني وَمَن أَنا عاذِرُ",53,"ر",1,0],["ومنها نُجومٌ في بُروجِ مَجَرَّةٍ","عَلَى الأرضِ تَبْدُو تارَةً وتَغُورُ",54,"ر",1,0],["ومنهمْ أُناسٌ يُظْهِرُونَ مَوَدَّتِي","وبُغْضُهُمُ لِي مِنْ قِفا نَبْكِ أَشْهَرُ",55,"ر",1,0],["وَمَنْ هُوَ الآيَةُ الكُبْرَى لَمُعْتَبِرٍ","وَمَنْ هُوَ النِّعْمَةُ العُظْمَى لِمُغْتَنِمِ",56,"م",1,0],["وَمَن هَوِيَ الدُنِّيا الكَذوبَ فَإِنَّهُ","رَهينٌ بِثَوبَي ذِلَّةٍ وَصَغارِ",57,"ر",1,0],["ومَن هوَ إنْ بدا والبدْرُ تِمٌّ","خَفِي مِنْ حُسنِهِ البدرُ التَّمامُ",58,"م",1,0],["ومنه تقليد من قد","مضى ومنه اقتراع",59,"ع",1,0],["ومن هيَ الغادةُ التي","تنسلُّ من مخدعي إليها",60,"ه",2,0],["وَمَن هُوَ ذو وَجهَينِ لَيسَ بِدائِمٍ","عَلى العَهدِ خَلّافٌ بِكُلِّ يَمينِ",61,"ن",1,0],["ومَنْ هوَ حتى يُحْمَلَ النّطْقُ عن فمي","إليه وتمْشي بينَنا السُّفَراء",62,"ر",3,0],["ومَنْهَلٍ تَرِدُ الجَوْزاءُ غَمْرَتَه","إذا السِّماكانِ شطْرَ المغْرِبِ اعترَضَا",63,"ض",2,0],["ومنهمو من مزّق الكتابا","معاتباً يا قبحه عتابا",64,"ب",2,0],["وَمِنْهُمْ كِرَامٌ إِذَا مُحِّصُوا","سَمَا طَبعُهُمْ وَتَنَقَّى وَعَف",65,"ف",1,0],["وَمَنْ هُو لَمْ تَتْرُكْ لَهُ الحَرْبُ مَفْخَراً","وَمَنْ خدُّهُ يومَ الكَرِيهَةِ أضرعُ",66,"ع",1,0],["ومنهم أبو العباس يحيى بن خالد","وصاحبه الحبر النبيل أبو عمرو",67,"ر",2,0],["ومنهم أبو الخطاب نجل ابن يوسف","سليل ابن يمن جل ذلك من وزر",67,"ر",1,0],["وَمِنهُنَّ رَكضُ الخَيلِ تَرجُمُ بِالفَنا","يُبادِرنَ سِرباً آمِناً أَن يُفَزَّعا",68,"ع",2,0],["ومِنَّةٍ كانت جَنَاحاً له","طارَ بهِ الذائعُ من ذِكْرِهِ",69,"ر",2,0],["ومنها أن ينوءَ على يديه","ويَظْهَرَ في تَرَاقِيهِ انْحِنَاءُ",70,"ا",2,0],["وَمِن هَوى الصِدقِ في قَولي وَعادَتِهِ","رَغِبتُ عَن شَعَرٍ في الوجه مَكذوبِ",71,"ب",1,0],["ومِنْ هذي الكُوى سيُطِلُّ فجرٌ","ضَحوكٌ يملأ الدُّنيا كَشوف",72,"ف",1,0],["ومنها الذي تدنو فتبعدُ نُزَّعاً","شواخِصُهُ مِثْلَ ال