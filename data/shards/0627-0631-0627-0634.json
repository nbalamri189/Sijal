{"poems":[[422,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[422,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[478,"أراش نبال مقلته فأصمى","https://www.aldiwan.net/poem4120.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122600","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77517","الوافر"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145641","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62574","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101986","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144773","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144751","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110623","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137140",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74048","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74101","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94470","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76759","الطويل"],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""]],"verses":[["أَراشوا بني عبد الغنيّ جناحَه","فأثرى بمالٍ ما هناك جزيل",0,"ل",1,0],["أراش سهامَ مقلته غريرٌ","إذا أرمى بها قلباً أصابا",1,"ب",2,0],["أراشَ نبال مُقلته فَأَصمى","غزالٌ فاترُ اللَحظات ألمى",2,"م",2,1],["أُراشي جُفوني أن تَنامَ وترعَوي","دُموعٌ أذابَ البينُ راقي جُمُودها",3,"د",3,0],["أَراشَت بِالضَنى سَهم الأَعادي","فَكَلَّ لبرء طَعنتها الطَبيبُ",4,"ب",1,0],["أُراشِقُ الحُورَ أشعاري، فتَرْشُقُني","من الهوى والجَوى نارًا وسِكّينا",5,"ن",2,0],["أراشد يا ابن أحمد لم نجد في","علاك وفي جميلك قط مثلا",6,"ل",2,0],["أر أشب ساجي الطرف لو فرضت","ملاحه ما تعدته الملاحات",7,"ت",1,0],["أراش سهام الحتف شلت يمينه","وصال بمصقول الحدود مهند",8,"د",1,0],["أراش سهاماً ريشها الهدب وانثنى","يهز بعطفيه فيهزأ بالقضب",9,"ب",1,0],["أراشَت لأحشائِي رواشقَ مُقلَةِ","ترَى نبلها يُصمِي الفؤادَ إذا أخطا",10,"ط",2,0],["أراشت يد الأيام سهم مسدد","فأصمت بما قد سددت أي سيد",11,"د",1,1],["اراش الردى سهماً اصاب به النهى","وفي كبد العلياء قد احتدم الجمر",12,"ر",1,0],["أَراشوا سِهاماً للمروق فمزّقت","نحورهم تلك السهام الموارِقُ",13,"ق",1,0],["أَراشَت سهام الحتف سود لحاظها","وَقَلبي في تلك السِهام رَجيمُ",14,"م",1,0],["أراشت مهجتي بسهام هجر","كأسهام العيون النرجسيَّه",15,"ي",2,0],["أراشوا جناحي ثم بلّوه بالندى","فلم أستطع من حيّهم طيرانا",16,"ن",2,0],["أراش بالهدب غنج مقلته","لكل قلب الى لماه صدى",17,"د",2,0],["أراشدٌ ذي صفات منك ترشدني","للمدح سجانهُ أعطى فأغنا كا",18,"ك",2,0]]}