{"poems":[[65,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[3,"وإن تك حربكم أمست عوان","https://www.aldiwan.net/poem117.html",""],[90,"شكاية قلب بالأسى نابض العرق","https://www.aldiwan.net/poem44834.html","الطويل"],[53,"فقدتك يا ابن أبي طاهر","https://www.aldiwan.net/poem62913.html","الكامل"],[47,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[47,"أتاني كتابك ذاك الذي","https://www.aldiwan.net/poem65225.html","المتقارب"],[30,"ضيع أمري الأقعسان فأصبحا","https://www.aldiwan.net/poem1261.html",""],[51,"هززتك لا أني وجدتك ناسيا","https://www.aldiwan.net/poem65370.html","الكامل"],[71,"ألا أيها المولى الذي زار عبده","https://www.aldiwan.net/poem28560.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9882","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54795","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[47,"سرَى من خَيالِ المالكِيّةِ ما سَرَى،","https://www.poetsgate.com/ViewPoem.aspx?id=31270",""],[164,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[215,"منازل كانت جلوة العين والحشا","https://www.aldiwan.net/poem46626.html","الطويل"],[228,"أودك جاحظة المقلتين","https://www.aldiwan.net/poem41903.html","المتقارب"],[272,"فإن تك حربكم أمست عواناً","https://www.aldiwan.net/poem1143.html",""],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[371,"تنكر بعد البين دار وجيران","https://www.aldiwan.net/poem17289.html","الطويل"],[415,"كعهدك بانات الحمى فوق كثبها","https://www.aldiwan.net/poem31848.html","الطويل"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[463,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[520,"ترى عند نجم الدين علم بما عندي","https://www.aldiwan.net/poem12071.html","الطويل"],[563,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115102","الطويل"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132425","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61135","الوافر"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28354","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56064","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84508","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47180","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65962","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205012","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145032","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91169","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119625","الطويل"],[4279,"","https://poetry.dctabudhabi.ae/diwan/poem/101972","الطويل"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[5344,"كن الشُغل متواصل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180838",""],[5461,"سمرت","https://www.poetsgate.com/ViewPoem.aspx?id=34730",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"أصالة النقاء ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182271",""],[6225,"حسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80895&r=&rc=164",""],[6320,"صُرُوفُ الدَّهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84358&r=&rc=55",""]],"verses":[["ولكنْ وَشى بي نَشْرُها إذْ توَشَّحَتْ","لديَّ جُمانَ الرَّشْحِ فذّاً وتَوْأَما",0,"م",2,0],["وَلَكِن وُلدُ سَودَةَ أَرَّثوه","وَشَبّوا نارَها لِمَنِ اِصطَلاها",1,"ا",3,0],["ولكن وراء الستر كفٌ حفيّة","تزحزح من شاءت عن الأمر أو تبقي",2,"ق",2,0],["ولكن وقاك معراتِها","تضاؤلُ قدرِك في الخاطر",3,"ر",1,0],["وَلَكِنَّ وَجداً لَم أَجِد مِنهُ مَوئِلاً","وَمَورِدَ حُبٍّ لَم أَجِد عَنهُ مَصدارا",4,"ر",2,0],["وَلَكِن وَرِثتَ عَنِ المَلأَمانِ","فَهماً غَليظاً وَرَأياً رَكيكا",5,"ك",2,0],["وَلَكِن وَجَدتَ السَهمَ أَهوَنَ فَوقَةً","عَلَيكَ فَقَد أَودى دَمٌ أَنتَ طالِبُه",6,"ب",2,0],["وَلَكِن وَجَدتُ السَيفَ عِندَ انتِضائِهِ","إِلى الهَزِّ مُحتاجاً وَإِن كانَ ماضِيا",7,"ي",2,0],["ولكنْ وثوقي منكَ بالصفحِ حثَّني","على بعضِ بحثٍ بالتكلُّفِ والجهدِ",8,"د",1,0],["وَلَكِن وُلدُ سَودَةَ أَرَّثوها","وَشَبّوا نارَها لِمَنِ اِصطَلاها",9,"ا",3,0],["وَلَكِنْ وِدَادٌ لِلْحَبِيبِ مَحَضْتُهُ","هُوَ الحُبُّ لَكِنِّي أَقُولُ وِدَادُ",10,"د",1,0],["ولكن وهى رأى وخامت عزيمة","فحكم خصم واستبيح نصير",11,"ر",1,0],["وَلكِنّ وَجْداً لمْ أجِدْ منهُ موْئِلاً،","وَمَوْرِدَ حُبٍّ لم أجِدْ عنهُ مصْدرَا",12,"ر",2,0],["ولكن وشاة كثروا في حديثهم","فبعد القوم أحرموني وصاله",13,"ل",2,0],["ولكن وحيا حاسما قد سمعته","يقول بهجران السياسة والبطش",14,"ش",1,0],["وَلكِن وَلكِن أَغارُ عَلَيكِ","مِن التُربِ إِن ودَّ أَن يَلثِما",15,"م",2,0],["ولكن ولدُ سودة أرثوها","وحشّوا نارها لمن اصطلاها",16,"ا",3,0],["ولكن وشاة السوء فيك كثيرة","وليست مع الواشين تمكن رؤيتي",17,"ي",1,0],["ولكنْ وَلاءٌ في الطَوّيةِ خالصٌ","ونَشْرُ ثناءٍ كاللطيةِ فائح",18,"ح",1,0],["وَلَكِنَّ وَجهاً عِندَهُ الشَمسُ لَيلَةٌ","وَلَكِنَّ كَفّاً عِندَها البَحرُ غُدرانُ",19,"ن",1,0],["ولكنْ وفاءٌ وِرْدُهُ غيرُ آجِن","ولو لم يَهِجْني الظّاعنونَ لَهاجَني",20,"ي",1,0],["ولكن وفِّني منها نصيباً","بجاهك لا أسومك فضلَ مالِ",21,"ل",1,0],["ولكنَّ وعداً عِينَ لمّا تخازرت","على طوله زُرْقُ المِطال وشُهلُهُ",22,"ل",2,0],["ولكن وداد سره مثل جهره","فباطن ما أخفي كظاهر ما أبدي",23,"د",2,0],["ولكن وجود مطلق عن تقيُّدٍ","بإطلاقه والكل منه شعائر",24,"ر",1,0],["ولكن وَشَى واشٍ لِيُفسِد بيننا","عَدُوٌّ مُبينٌ فافترى كَذِباً لَكِ",25,"ك",1,0],["ولكن وفري في الزكاة بذلته","إلى غير من للفقر ظل يعاني",26,"ن",2,1],["ولكن وللَه كل الأمور","ولا من مرد لما قدرا",27,"ر",2,0],["وَلَكن واحد وَالجَيش خَلفي","تسلم مهجتي وَغَدا سَليما",28,"م",2,0],["وَلَكِنَّ وَقعَ المشرَفِيَّةِ بَينَهُم","لِتُجهِزَ من يَدنو لِدارِ خُلودِ",29,"د",1,0],["ولكن وان كان الثرى ضم جسمه","فثق ان تلك النفس في خير مرتعِ",30,"ع",1,0],["ولكن وثوقي بالشفيع يمدّني","بخاطره في الحشر أسكن في قصر",31,"ر",1,0],["ولكنْ وَلِيٍّ نَالَ وزن ولايةٍ","والشّاذليُّ به استقامةُ وزنهِ",32,"ن",2,0],["ولكن وجدت الناس لا ناس إنما","مضى الناس إِذ لم يبق إِلا النسانس",33,"س",1,0],["ولكن وجه سائقه بدا لي","يموج بشاشة ويفيض بشرا",34,"ر",2,0],["ولكنّ وجداني ينمّ بحسرة","إلى القلب أو يوحى له بشكاة",35,"ه",1,0],["ولكنْ وبيتِ اللهِ ما طَلَّ مسلماً","كغُرِّ الثنايا واضحاتِ المَلاغمِ",36,"م",1,0],["وَلَكن وَرائي معشر وَأَحبة","عزازٌ عَلى قَلبي نَواهم تذيبني",37,"ن",2,0],["وَلكِنَّ وَفدَ اللّيلِ أَسبَلَ سِترَهُ","عَلَيهِم وَأَنجاهُم فَلا نَعصِ أَمرَهُ",38,"ه",1,0],["ولكن ولائي حثني ومحبتي","لكم وادّكاري العيش والعيش غابر",39,"ر",1,0],["ولكن وإن جلت لدي صروفه","وأسعر في أحشاي ناراً تلهب",40,"ب",1,0],["ولكن ورا هذا المقام ترافعا","للإيمان والإحسان أيضا مقامان",41,"ن",1,0],["ولكن ولله الفضل ما تاصل","لأشيا تردينا وما نتوانا",42,"ن",2,0],["ولكن وش يفيده لو ذبحني","ومن يوصف جماله عقب قافي",43,"ف",2,0],["ولكن وعته الروح مني فأودعت","ه في مضمر الكتمان حشو لطيفتي",44,"ت",2,0],["ولكنّ ودّي طهورٌ نبيل","كوُدّك أنت أصيلُ الحياءِ",45,"ا",2,0],["ولكنْ وساطته حملتهُ","إلى أولِ النبع والنبعُ جفْ",46,"ف",1,0],["وَلَكِنْ وَيْحَهَا الأَيَّامُ جَارَتْ","وَمَا أَبْقَتْ لَنَا إلاَّ الحُطَامَا",47,"م",2,0]]}