{"poems":[[55,"وما كنت أدري الحب حتى تعرضت","https://www.aldiwan.net/poem29727.html","الطويل"],[75,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[31,"بنو دارم عند السماء وأنتم","https://www.aldiwan.net/poem6091.html","الطويل"],[93,"يا نفس لو كنت ترين الشؤون","https://www.aldiwan.net/poem8972.html","عموديه"],[93,"ما طائر كان فيبيداء موحشة","https://www.aldiwan.net/poem62778.html","عموديه"],[80,"ألا يا مليكا يرتجى ويهاب","https://www.aldiwan.net/poem14278.html","الطويل"],[47,"يأبى الخلي بكاء المنزل الخالي","https://www.aldiwan.net/poem65572.html","البسيط"],[30,"إذا شئت هاجتني ديار محيلة","https://www.aldiwan.net/poem5524.html","الطويل"],[63,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[51,"فررت من الفقر الذي هو مدركي","https://www.aldiwan.net/poem64241.html","الطويل"],[107,"عيينة ماذا أنت ويحك صانع","https://www.aldiwan.net/poem43575.html","الطويل"],[107,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[107,"تأن ابن حرب لست في مثلها جلدا","https://www.aldiwan.net/poem44214.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39401","الوافر"],[96,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[215,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[303,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[362,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[463,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[563,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/93483","السريع"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53824","المتقارب"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123376","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203790","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108622","الوافر"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53188","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27308","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27654","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106985","البسيط"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132385","الوافر"],[2615,"","https://poetry.dctabudhabi.ae/diwan/poem/124292","الطويل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34743","المتقارب"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34741","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201111","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200683","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200671","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204901","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118926","المجتث"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123936","الوافر"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116861","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125828","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136621",""],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96062","الطويل"],[4648,"","https://poetry.dctabudhabi.ae/diwan/poem/204517","الطويل"],[4811,"سدرة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=198305",""],[5413,"لمَالِكِ عصره","https://www.poetsgate.com/ViewPoem.aspx?id=200591",""],[5986,"زماني من مصائبه دعاني","https://www.poetsgate.com/ViewPoem.aspx?id=162961",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""]],"verses":[["فَرَرتُ بِطَرفي مِن سِهامِ لِحاظِها","وَهَل تُتَلَقّى أَسهُمٌ بِعُيونِ",0,"ن",1,0],["فَرَرتُ فَإِن قالوا الفِرارَ إِرابَةٌ","فَقَد فَرَّ موسى حينَ هَمَّ بِهِ القِبطُ",1,"ط",1,0],["فَرَرتُم حِذارَ الثَعلَبِيِّينَ إِذ سَمَوا","بِأَرعَنَ طَودٍ مُشمَخِرِّ الحَوارِكِ",2,"ك",1,0],["فَرَرتِ بِلَّذّاتِ قَبلَ الفَرار","فَضاعَ يَومي حائِراً في غَدي",3,"ي",1,0],["فَرَرتُ مِن بَردِ كانونٍ فَقابَلَني","في أَرضِكُم بِالأَقاحي شَهرُ كانونِ",4,"ن",1,0],["فَرَرتُ بِنَفسي أَبتَغي فَرجَةً لَها","عَلى أَنَّ حُلوَ العَيشِ بَعدَكَ صابُ",5,"ب",1,0],["فَرَرتُ مِنهُ حَياءً مِن قُصوري عَن","جَزاءِ ما زادَ في جاهي وَفي مالي",6,"ل",2,0],["فَرَرتُ إِلى رَبّي وَأَيقَنتُ أَنَّني","مُلاقٍ لِأَيّامِ المَنونَ حِمامي",7,"م",2,0],["فرَرْتُ إليه من صَرْفِ اللَّيالي","فنكَّبَ جَورُها عني فِرارا",8,"ر",2,0],["فَرَرتُ مِنَ الفَقرِ الَّذي هُوَ مُدرِكي","إِلى بُخلِ مَحظورِ النَوالِ مَنوعِ",9,"ع",1,1],["فَرَرْتُم تُرِيْدونَ النّجاةَ وقد بَدَا","لكم منه يومٌ هائلُ البأسِ رَائِعُ",10,"ع",1,0],["فررتم تَتَّقون الموتَ زَحْفاً","على القِمَمِ الشَّواهِقِ والقِلالِ",11,"ل",1,0],["فررتَ تخاف الفقد في حَوْمَةِ الوغى","بأيدي الألى يستعذبون بها الفقدا",12,"د",2,0],["فرَّ رضوان للنجاة ومن أت","باعِ رضوان مسرعاً جمهور",13,"ر",1,0],["فَررتُ منَ اللقاءِ إلى الفِراقِ","فحَسْبي ما لقيتُ وما أُلاقي",14,"ق",2,1],["فررت إلى قلبي من العقل خائفا","كما فرّ من عدوي المريض سليم",15,"م",1,0],["فررت فراراً كل ذنبك عندهُ","وان كان ملء المغربين صغيرُ",16,"ر",1,0],["فررتُ منكم إليكم","فجئتُ أسأل عنكم",17,"م",1,1],["فررت منهم إليك قاطبة","فرار من غنمه كمغرمة",18,"م",2,0],["فررتُ منهمْ بآرائي وَمعتقدي","فرارَ من جدَّ في آثاره السبع",19,"ع",1,0],["فَرَرتَ وجِنحُ اللَّيلِ دِرعٌ مُفاضَةٌ","عَلَيكَ وأوقَى جُنَّةِ الهَارِبِ الجِنحُ",20,"ح",1,0],["فررتِ مكانَ لم تَجِدِي ثباتاً","ويقتُلُ ذِكرَهُ البطلُ الفَرورُ",21,"ر",1,0],["فررتمْ وما فرّوا وحِدْتُمْ عن الرّدى","وما عنه منهم حائدٌ مُتَحَرِّفُ",22,"ف",1,0],["فررت به مني إليه لأنني","تحققت أن لا غير والأمر ظاهر",23,"ر",1,0],["فَرَرتُ من قَطرٍ إلى مَثعَبٍ","عليَّ بالوابِلِ مُثعَنجِرُ",24,"ر",1,1],["فررتُكَ يا جَذَعاً يسنُّه","من العلم عن مُصْعَبٍ بازلِ",25,"ل",1,1],["فَرَرْتُهم وتوَخَّيْتُ الفِرار وَهَلْ","يُرْجى الإباق لعانٍ شُدَّ بالأَبَقِ",26,"ق",1,0],["فررت مثل الحلم المشتهى","من مقلة هدهدها المسكِر",27,"ر",1,0],["فررت إليك يا باري البرايا","من الوجل المخيم في ضميري",28,"ر",2,0],["فررت إليك من حمقي وجهلي","ومن شرهي وتشبيبي وجوري",28,"ر",2,0],["فررت إليك من لهوي وزهوي","وما قدمت من صلفي وزوري",28,"ر",2,0],["فررت إليك من ألم إليمٍ","وخيمٍ لا يحدثني بخير",28,"ر",1,0],["فررت إليك من خطرٍ خطيرٍ","خشيت به على العفو الخطير",28,"ر",1,0],["فَرَرنا إِلى القاضي مَخافَةَ غَيرِهِ","فَكانَ مِنَ القاضي التي هِيَ أَخوَفُ",29,"ف",1,0],["فررتم من حين أحرقكم","ضرباً فأغرقكم طوفان ملتطم",30,"م",1,0],["فررتُ إلى الرحمن أبغي التصرّفا","بسطوةِ جبارٍ ورحمة مصطفى",31,"ف",2,1],["فررتُ إلى ربي كموسى ولم يكن","فِراري عن خوفِ عنايةِ مصطفى",32,"ف",2,1],["فررت من حربه وشوقي","حبب لي كرة وكره",33,"ر",2,0],["فَرَرنا مُقبلينَ ومُهطعِينا","إلى المولى عزينَ ومشفقينا",34,"ن",2,1],["فررت بها من كل ما أنا كاره","إليك فكن حصني إذا نابني الإد",35,"د",1,0],["فررتُ من البيتِ من أجلها","فِرار الهَجين من الأعمشِ",36,"ش",1,0],["فررتُ من العمالةِ بعد يحيى","وبعد النَّهشليّ أبي أبانِ",37,"ن",1,0],["فررتُ الى القفر من بلدة","على زغل زرعها نابتُ",38,"ت",1,1],["فررت من وحدة بالشعر زاجرة","فضاعفت لي أذايا الناسِ أشعاري",39,"ي",1,0],["فررتُ من مقلقات النفس في بلدي","إذا القريض يوافيني على الأثر",40,"ر",1,1],["فررت من البحر الذي لك عاشق","وجربت حب البر والبر يخدع",41,"ع",1,0],["فررت للحق منهم","إذ هم عن الحق زورُ",42,"ر",1,0],["فَرَرتَ مِنَ المَدينَةِ حينَ ثابَت","رواةُ الناسِ واِستُمِعَ النَشيدُ",43,"د",1,0],["فررن إلى مصارعكم ومذ لم","تجد كم غير أشلاء بقاع",44,"ع",1,0],["فررت فلم يغن الفرار","مع اللَه لم يعجز في الأرض هارب",45,"ب",1,1],["فررت على زورق مسرع","يمرُّ به الموج ما يشعر",46,"ر",1,0],["فررتُ وخلَّفت الفُؤاد لديُهم","ولا تَحسبيه أنه اليومَ سالم",47,"م",1,0],["فَرَرنا عجالاً عن بنينا وأهلِنا","وأزواجنا إذ عارضتنا الصفائح",48,"ح",1,0],["فررت من الدنيا إلى ساكن الحمى","فرار محب عائذ بحبيب",49,"ب",1,1],["فَررت إليهِ مِنهُ فجلَّ شأني","وطِبتُ بأمرهِِ رَفعاً وخَفضا",50,"ض",2,0],["فررتَ منَ الدنيا الدنيةِ كلها","إلى ربكَ الباقي بكلكَ راضيا",51,"ي",2,0],["فررت بعزتي وإباء نفسي","ونفسي لا تقر على الهوان",52,"ن",1,0],["فررتَ خصيّا وليلاك عُهْرٌ","وصهرُك لصّ.. فماذا أقول؟",53,"ل",1,0]]}