{"poems":[[55,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[82,"رعى من أخي الوجد طيف ذماما","https://www.aldiwan.net/poem31291.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[53,"رقدْتُ وما ليلُ الغريب براقدِ","https://www.poetsgate.com/ViewPoem.aspx?id=28472",""],[111,"الله أكبر فاز المجد واغتبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66838&r=&rc=17",""],[139,"بنقلك يزهو الهناء الجميل","https://www.aldiwan.net/poem48850.html","المتقارب"],[264,"إلام الحشا من لاعج الشوق في سخط","https://www.aldiwan.net/poem35776.html","الطويل"],[354,"بنقط زاد في الخط","https://www.aldiwan.net/poem15837.html","الهزج"],[509,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[556,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37735","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27405","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204504","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21381","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/19008","الكامل"],[5747,"بين فرح وبين جرح","https://www.poetsgate.com/ViewPoem.aspx?id=61682",""],[6082,"فتاة شرقية","https://www.poetsgate.com/ViewPoem.aspx?id=60252",""]],"verses":[["بِنَقعٍ يُظلِمُ الإِصباحُ مِنهُ","عَلى بيضٍ يُضيءُ بِها الظَلامُ",0,"م",1,0],["بنقض شروط كان أحمقَ ناقضٍ","عُراها ولكن كنتَ أحزم عاقدِ",1,"د",1,0],["بنقعٍ يُريكَ نجومَ السماء","إذا الجوّ منه على الشمس غاما",2,"م",2,0],["بِنَقْطِ الجَمَاجِمِ إِعْجَامُهُ","وَإِهْمَالُهُ جَوْبُهُ مُقْفِرَا",3,"ر",2,0],["بنقض شروط كان أحمقَ ناقصٍ","عُراها ولكن كنتَ أحزم عاقدِ",4,"د",1,0],["بنقض بين لهام البهم صاعقة","لو صادفته الجبال الشم ما وهطا",5,"ط",2,0],["بنَقْلك يزهو الهناء الجميلْ","وما لك إلاّ المَقامَ الجليلْ",6,"ل",1,1],["بنقطة خالٍ أعجمت مهملَ الهوى","وصفحة خدٍّ معجمِ الحسن بالنقط",7,"ط",1,0],["بِنَقطٍ زادَ في الخَطِّ","يُبينُ النَقصَ في الشَكلِ",8,"ل",1,1],["بنقطة لفظ الخد شبه بعضهم","لصحة حسن الخط من قلم القضا",9,"ا",1,0],["بَنقَا الرِّمْثِ مِن شَرافِ غزالٌ","ضلّ عنّي وليس منه الضّلالُ",10,"ل",1,1],["بنقصِهمُ قّدْ بان فضْلي ورُبَّما","شكرتُهمُ والضِّدُّ يُظهرُه الضِّدُّ",11,"د",1,0],["بنُقطةٍ من عَنبرٍ","تُنعشُ قلبَ المُدنَفِ",12,"ف",1,0],["بنقع به سمر الرياح قبائل","وجوّ به بيض الصفاح شعوب",13,"ب",1,0],["بنقع كأن الأرض تنبت أغصنا","بأرماحه والحق بمطر أنجما",14,"م",2,0],["بنقرٍ بأوتارٍ بأيدي كواعبَ","يملن علينا من هوى لا من السُّكر",15,"ر",1,0],["بنقاد القريض بَرْمت لما","رأيتهمُ وقوفاً في طريقي",16,"ق",2,1],["بنقوش كأنما هندسي","خطها في يمينها الفرجار",17,"ر",1,0],["بِنقعاءَ أَظلَلنا لَكُم مِن وَرائِهِم","بِمُنخَرِقِ النَقعاءِ يَوماً عَصَبصَبا",18,"ب",2,0],["بِنَقا الفُقَيِّ تَلَألَأَت فَخَطا لَها","طِفلٌ بُرادٌ ما يَكادُ يَقومُ",19,"م",1,0],["بنقشك بحروف شعري فوق طبعات الغلاف","دام دونك كل شيِ في حياتي مفهمه",20,"م",2,0],["بنقوش الحنّا على قدمي","ودهون العود الشرقية",21,"ي",2,0]]}