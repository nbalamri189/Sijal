{"poems":[[90,"خرج الناس يهرعون احتفاء","https://www.aldiwan.net/poem44795.html","الخفيف"],[91,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[91,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[68,"هجرت بعدك القلوب الجسوما","https://www.aldiwan.net/poem40293.html","الخفيف"],[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141322","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121933","الخفيف"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102179","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204984","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204967","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204773","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101609","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68111","الخفيف"],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[6318,"درّة الأقصى مُحمَّد الدرّة وأبوه جمال الدرّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66165&r=&rc=15",""]],"verses":[["كيف جاء الأمير قبل ائتمار ال","قوم فيما يختصّ بالتأمير",0,"ر",1,0],["كيف جاءت تقوى الارادة فينا","ما علاقات الروح بالاجساد",1,"د",1,0],["كيف جوّزت أن تفكي عهوداً","أنتِ أبرمتها أمام الشهود",2,"د",1,0],["كَيفَ جَرَّعتَني الحَميمَ مِنَ الحُز","نِ وَقَد كُنتَ لي صَديقاً حَميما",3,"م",2,0],["كيف جانبتك أبغي سلوة","ثم ناجيتك في كل شبيه",4,"ه",1,0],["كَيْفَ جُوُّ الفَتْحِ فِيمَا سَخَّرَتْ","مِنْ قُرَى الدُّنْيَا عُقُولُ العُلَمَاءْ",5,"ا",2,0],["كَيْفَ جَوُّ العَبْقَرِيَّاتِ وَقَدْ","شَالَتِ الأَطْوَادُ فِيهِ كَالْهَبَاءْ",5,"ا",2,0],["كيف جُبت الفلا بغير دليلٍ","وملأتَ الصَّحراءَ بالعُمران؟",6,"ن",1,0],["كيف جئت الوجود بل كيف مضي","من ضياء الوجود للظّلمات",7,"ت",1,0],["كَيفَ جابَت مَخاوِفَ البيد أَم كَي","فَ اطمَأَنَّت في سَيرِها البَيداءُ",8,"ا",2,0],["كيف جانبتها وأنت محب","هل محب رأيته ذا اجتناب",9,"ب",1,0],["كيف جاريتكم وان جواد ال","فكر مني عن القريض شرود",10,"د",1,0],["كيف جرعتني بفرط صدود","بعد ذاك الوصال كأس الصديد",11,"د",1,0],["كيف جاء الفدا لنا من غريب","فوق ما نرتجيه من أقرباء",12,"ا",2,0],["كيف جاءت تلك المواضيع تترى","لست أدري ووحيها كيف جاءا",13,"ا",3,0],["كيف جمعي لهم بقول سواء","مع مقام دان وعالي مقام",14,"م",1,0],["كيف جئنا الدنيا ومن أين جئنا","وإلى أين عالم سوف نفضي",15,"ض",2,0],["كَيْفَ جفنايَ بالمنامِ تَلاقَى","قَرَّح السهدُ من عيوني الحِداقا",16,"ق",2,0],["كيف جاؤوا لبتره من رئاتٍ","هو فيها معششٌ كالهواءِ",17,"ا",2,0],["كيفَ جاوزتِ أنتِ ليلاً وليلاً","يبعثُ الحزنَ والظلام مرارا",18,"ر",2,0],["كيف جاءت وأين تغدو وماذا","تبتغي هذه التي تجتوينا؟!",19,"ن",2,0],["كيفَ جِئنا هُنا! وكيفَ حُصِرنا","لا أرى ملجأً إليه نَعودُ",20,"د",1,0]]}