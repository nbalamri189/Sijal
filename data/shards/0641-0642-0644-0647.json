{"poems":[[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[164,"من عونه ربه في أمره غلبا","https://www.aldiwan.net/poem58896.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[484,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138384",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109076","الطويل"],[1647,"","https://poetry.dctabudhabi.ae/diwan/poem/79695","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106979","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2849,"","https://poetry.dctabudhabi.ae/diwan/poem/145225","المنسرح"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103940","الهزج"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131034",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[5105,"وإني لأستشفي بطيفٍ مُسَلِّمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=135340",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""]],"verses":[["فَقُل هُمُ رَحَلُوا يَوماً إِلى مَلِكٍ","وَقَطَّعُوا عَن عُناةِ الشَعبِ أَغلالا",0,"ل",2,0],["فقلهُ الدخلِ والأقطار ساكنةٌ","ولا الكثير لذي قطر قد اضطربا",1,"ب",2,0],["فَقُل هوَ عبدُ اللَّه سيّد خلقهِ","وَدَع ما طَرا في حقّ عيسى من الإطرا",2,"ر",2,0],["فقَلَّها وأَقبَلا","يَسعى إِليه عَجِلا",3,"ل",2,0],["فقل هب عندنا فرد","ولسنا الحق أقواما",4,"م",2,0],["فقل هذي صفات قد حواها","محمدٌ الحكيم ابن الحكيم",5,"م",1,0],["فقل هامساً في أذنها عابثاً بها","كفى الحسن تيهاً أنه سوف ينضب",6,"ب",1,0],["فَقُلَّةُ أَرْواضِ النُّخَيْلَةِ عُرِّيتْ","فَقِيعانُ لَيْلى بعْدَنا فَهزُومُها",7,"م",3,1],["فقل هو اللَه الذي كوّنها","ولم يكن لهن كفواً أحد",8,"د",1,0],["فقل هما قد دعوا ربهما","والواو والألف ضع كتبهما",9,"م",2,0],["فقل هو الله، وصف خالقنا","من بعد تبت يدا أبي لهب",10,"ب",1,0],["فَقلّة العَلياء نعم قَد مزّقَت","وَثمَّ أَحجار لَها قَد فرّقَت",11,"ت",1,0],["فقله غير مكثر منه ولا","تعبأ بقول جاهل أو أحمق",12,"ق",1,0],["فَقُل هُم البُهمُ ماتوا قَبلَما وُلِدوا","أَنّى دَروا كنه من يحيي وَما اِختَبَرُوا",13,"ر",3,0],["فقل هو الله ولا يفسر","بغيره فهو العظيم الأكبر",14,"ر",1,0],["فقل هل تعرف الجن","نَة يوماً بسوى الوصف",15,"ف",1,0],["فقله فخرا كما قالوه أو حكما","تهدي الذي عن طريق الرشد قد جمحا",16,"ح",2,0],["فقلَّةُ الدينِ مع الديانَهْ","وكثرةُ الكِذْبِ مع الخيانهْ",17,"ه",1,0],["فقل هو ليلٌ في الظهيرةِ مظلمٌ","وقل هو بحرٌ في البسيطةِ مزبد",18,"د",1,0],["فقل هو العالم النحرير قدوتنا","السالميّ زكي القول والعمل",19,"ل",1,0],["فَقُل هُوَ الرُّوحُ أَعطاني لأُعطِيَكُم","وَدَعكَ مِمِن قَضَوا بِالمالِ إِحسانا",20,"ن",2,0]]}