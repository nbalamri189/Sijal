{"poems":[[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[164,"من عونه ربه في أمره غلبا","https://www.aldiwan.net/poem58896.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[301,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[482,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[743,"","https://poetry.dctabudhabi.ae/diwan/poem/79695","الطويل"]],"verses":[["فَقُل هُمُ رَحَلُوا يَوماً إِلى مَلِكٍ","وَقَطَّعُوا عَن عُناةِ الشَعبِ أَغلالا",0,"ل",2,0],["فقلهُ الدخلِ والأقطار ساكنةٌ","ولا الكثير لذي قطر قد اضطربا",1,"ب",2,0],["فَقُل هوَ عبدُ اللَّه سيّد خلقهِ","وَدَع ما طَرا في حقّ عيسى من الإطرا",2,"ر",2,0],["فقَلَّها وأَقبَلا","يَسعى إِليه عَجِلا",3,"ل",2,0],["فقل هب عندنا فرد","ولسنا الحق أقواما",4,"م",2,0],["فَقُلَّةُ أَرْواضِ النُّخَيْلَةِ عُرِّيتْ","فَقِيعانُ لَيْلى بعْدَنا فَهزُومُها",5,"م",3,1]]}