{"poems":[[24,"أنت امرؤ من أهل قدس أوراة","https://www.aldiwan.net/poem21879.html","الطويل"],[53,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[40,"يا من توعدني جهلا بكثرته","https://www.aldiwan.net/poem7706.html","البسيط"],[91,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[47,"ما لي لا يرحمني من أرحمه","https://www.aldiwan.net/poem66657.html","الرجز"],[47,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[63,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[68,"ليت شعري بمن تشاغلت عنا","https://www.aldiwan.net/poem39684.html","الخفيف"],[68,"لا زلت سباقا إلى المكرمات","https://www.aldiwan.net/poem40955.html","السريع"],[99,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[46,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[71,"ذهب الصدق وإخلاص العمل","https://www.aldiwan.net/poem29305.html","الرمل"],[107,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[50,"حلت سعاد وأهلها سرفا","https://www.aldiwan.net/poem64408.html","الكامل"],[52,"قد لعب الدهر على هامتي","https://www.aldiwan.net/poem64882.html","السريع"],[48,"قد وعظتني بك الليالي","https://www.aldiwan.net/poem22402.html","مجزوء البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[108,"ظل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179710",""],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[119,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[164,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[201,"أترعي الأقداح يا حوا","https://www.aldiwan.net/poem39879.html","مجزوء الرمل"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[280,"ثلاثة حيتك في الأربعين","https://www.aldiwan.net/poem25511.html","السريع"],[283,"أنت امرؤ أو ليتني منناً","https://www.aldiwan.net/poem2478.html","أحذ الكامل"],[333,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[411,"أنت امرؤ لا ترعوي تائبا","https://www.aldiwan.net/poem49475.html","السريع"],[438,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[443,"أمّا الخليط فبان غير مودع","https://www.aldiwan.net/poem2555.html","الكامل"],[443,"يا أيها المولى الوزير ومن له","https://www.aldiwan.net/poem2608.html","الكامل"],[458,"من هموم الإنسان ثم","https://www.aldiwan.net/poem61228.html","الخفيف"],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[563,"إنني إن أمت فما أنا ميت","https://www.aldiwan.net/poem34725.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48781","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122374","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64044","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38010","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119999","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120094","الرمل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72305","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35351","الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122881","المنسرح"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31635","الخفيف"],[1396,"","https://poetry.dctabudhabi.ae/diwan/poem/204676","الكامل"],[1426,"","https://poetry.dctabudhabi.ae/diwan/poem/124626","المنسرح"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87863","الخفيف"],[1894,"","https://poetry.dctabudhabi.ae/diwan/poem/198779","الخفيف"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76675","الخفيف"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32617","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102368","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100775","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99377","البسيط"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20606","المنسرح"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32778","السريع"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139462",""],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105510","الخفيف"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117175","الكامل"],[5136,"عاد عليك العيد يا أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=121553",""],[5277,"إجمعيني","https://www.poetsgate.com/ViewPoem.aspx?id=191102",""],[5431,"يالقلبي واأساه ...","https://www.poetsgate.com/ViewPoem.aspx?id=191671",""],[5496,"أنت واحدها","https://www.poetsgate.com/ViewPoem.aspx?id=212780",""],[5628,"في ذكرى شهيد الإنسانية الإمام الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178499",""],[5956,"يا ميِّتاً من حزنهِ","https://www.poetsgate.com/ViewPoem.aspx?id=183751",""],[6019,"عِناقُ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=162129",""],[6052,"حلية التقى","https://www.poetsgate.com/ViewPoem.aspx?id=34891",""],[6152,"مافات انقضى","https://www.poetsgate.com/ViewPoem.aspx?id=207354",""],[6225,"حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80912&r=&rc=181",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[6307,"اعتراف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79013&r=&rc=1",""]],"verses":[["أَنتَ اِمرُؤٌ مِن أَهَلِ قُدسِ أوراةٍ","أَحَلَّتكَ عَبدَاللَهِ أَكنافَ مُبهِلِ",0,"ل",1,1],["أنتَ امرؤٌ للصدقِ فيه مذاهب","سقط الجُنَاح بها عن المُداحِ",1,"ح",1,0],["أَنتَ أُمنِيَّةُ قَلبِ أَكَلَتهُ الحَشَرات","أَنتَ بانيكَ الَّذي شادَكَ لا لا لَستُ أَدري",2,"ي",1,0],["أَنتَ اِمرُؤٌ نالَ مِن عِرضي وَعِزَّتُهُ","كَعِزَّةِ العَيرِ يَرعى تَلعَةَ الأَسَدِ",3,"د",1,0],["ان تأملتها رأيت عليها","اثر القصد ظاهراً والسداد",4,"د",1,0],["أَنتَ أَمينُ اللَهِ لا تُجَمجِمُه","وَفي الحَديثِ وَالقَديمِ كَرَمُه",5,"م",2,0],["إِن تَأَمَّل مَحاسِنَ الأَصبَهانِيِّ","تَجِد طولَهُ أَخا طولِ باعِه",6,"ع",2,1],["أنتَ أمضى من الحسامِ وأصفى","من حَيَا المُزنِ في المُحولِ وأندَى",7,"د",2,0],["أَنتَ أَملَلتَنا وَلَم نَجنِ ذَنباً","لَو عَلِمنا ذَنباً لَدَيكَ لَتُبنا",8,"ن",2,0],["أَنتَ اِمرُؤٌ مَعروفُهُ ثابِتٌ","وَليسَ لِلأَموالِ مِنهُ ثَبات",9,"ت",1,0],["أنت امرؤٌ ترزح تحت الضنى","لم يبق منك الدهر إلا عناد",10,"د",1,0],["أَنتَ أَمضى مِن أَن تَصُدَّ عَنِ الرَم","يِ إِذا ما جَدَدتَ في الإِنباضِ",11,"ض",1,0],["إنْ تأملتَ فزيِّي منهمُ","غيرَ أَنَّ القلبَ مغناهُ طللْ",12,"ل",1,0],["أنت امرؤٌ ذُو حروبٍ لا يُلائِمُه","أن يستجيبَ ذَوِي الأضغانِ إن دَلفوا",13,"ف",3,0],["أَنتَ اِمرُؤٌ جَلَّلتَني نِعَماً","أَوهَت قِوى شُكري فَقَد ضَعُفا",14,"ف",2,0],["أَنتَ اِمرُؤٌ في سُخطِنا ناصِبٌ","وَمِن هَوانا نازِحٌ ناءِ",15,"ا",2,0],["أَنتَ أَميرٌ وَأَنتَ قاضٍ","وَشَأنُكَ الوَعدُ وَالوَعيدُ",16,"د",1,0],["أنتِ أمُّ المَجْدَيْنِ بَيْنَ طَرِيفٍ","يتَحَدَّى الوَرَى وبَيْنَ تَلِيدِ",17,"د",1,0],["أَنْتِ أُمُّ الأَشْبالِ إنْ غَابَ لَيْثٌ","صالَ لِلْحَقِّ بَعْدَه لَيْثُ غَابِ",18,"ب",1,0],["أنت امرؤٌ دَست الوَزا","رة لا يُجلُّك بل تُجلُّه",19,"ل",2,0],["أنت أمّارة أنا ثم قالوا :","سكتت قبل أن تقول وزيره",20,"ر",2,0],["أنتِ امليت على تاريخه","طافحا بالكبر ذلاً واختذاء",21,"ا",2,0],["انت امروءٌ حب غزا","ل لعلع خباله",22,"ل",2,0],["إن تأمن الدهران يغلي العدو فلا","تستامن الدهران يلقيك في السفل",23,"ل",1,0],["أنت أمّي وأبي","أنت خليلي وشقيقي",24,"ي",1,0],["أنت إمامٌ لي بلا تقيُّد","لا هُمَّ فاشهدْ ثم لاهُمَّ اشهدِ",25,"د",1,0],["أَنتَ أميرُ المُؤمِنينَ الذِي","دَوْلَتُهُ يُمْنٌ عَلَى المُؤْمِنينْ",26,"ن",1,0],["أنت امرؤ أو ليتني منناً","أوهت قوى شكري فقد ضعفا",27,"ف",2,1],["أنت أمسى وحاضري وغدى في","ك سراب تهفو له صحرائي",28,"ي",1,0],["أنت أمُّه وعروسُه وله ابنةٌ","من ذا رأى بكراً لها ابنُ فطام",29,"م",1,0],["أنتَ امْرؤٌ لا تَرعوي تائباً","مِن شِمَةِ العُدْوانِ والظُّلْمِ",30,"م",1,1],["أنت أمضى حزْماً أريباً لدى الرّوْ","عِ وأهْدى رأياً به جَحْجاحا",31,"ح",2,0],["أنت امرؤ ما زال يخشاه العدى","وفتّى لغير إلهه لم يخضع",32,"ع",1,0],["أنت أمرؤ ما أمه ذو فاقة","إلا ولاح النجح في آماله",33,"ل",2,0],["أنت أم الجميع لو يعقل","الناس ولو يدركون ويل الخصام",34,"م",1,0],["أنتِ أمٌّ لنا ونحنُ بَنوها","لا رعى الله قاطِعاً أرحاما",35,"م",2,0],["إن تأملت فالجميع معان","ولنطق الوجود هم تصويت",36,"ت",1,0],["أنت أم ذلك المسيطر أولى","بالعداء الذي لك التزموه",37,"و",2,0],["ان تأمري تطع وان","تدعى بها تلبك",38,"ك",1,0],["أنت امرؤٌ شيمةُ الإنسان شيمتُهُ","لم تعدُهُ تُحَفُ الإحسان والطرف",39,"ف",1,0],["أَنتَ اِمرُؤٌ مِنهُ المَواعِظُ تُجتَنى","وَلَهُ التصدُّرُ ثمَّ وَالتصديرُ",40,"ر",1,0],["أنت امرؤ في عودِهِ ثمرُ","يرجى وكم عود بلا ثَمرِ",41,"ر",1,0],["أنت أمن لأخي خو","ف ومال لعديمِ",42,"م",1,0],["أنت امرؤ من قال فيك مقالة","الغالي فكل الخلق في تصديقه",43,"ق",2,0],["إِن تَأَمَّلتَ رَونقي وَاِبتِهاجي","تَتَعَرَّف حَقيقَتي وَاِنتِسابي",44,"ب",2,0],["أنت أمير عليَّ مقتدر","حكمك في قبض مهجتي ماضي",45,"ض",2,0],["أَنْتَ أُمْنيَتي فَإِنْ مِت غَمْضاً","سَلَّمَتْك المُنى إِلى الأَحْلامِ",46,"م",1,0],["أنت امرؤ غثُّ الصنيعة رثُّها","لا تُحسن النعمي إلى أمثالي",47,"ل",2,1],["انت امام الندى قد اتفقت","عليك بعد اختلافها الأمم",48,"م",1,0],["أَنتِ أُمنِيَّةُ الفُؤادِ وَما لي","غَيرُ يَومِ اللِقاءِ مِن أُمنِيَّه",49,"ي",2,0],["أنت أمنتها فلا ظلم فيها","وملأتم ربوعها بالأمان",50,"ن",1,0],["أنت إما اعترضتم درة التا","ج فرند الحسام وسطي الفريد",51,"د",1,0],["أنت إما عرضت عرض بذكري","في سراة النادي وبين صحاب",52,"ب",1,0],["أنت امرؤ في أرض أمك فلفل","جم وفلفلنا هناك الدندن",53,"ن",1,0],["أَنتَ امرؤٌ ضَيَّعتَ عِرضَكَ جاهِلٌ","وَرَضِيتَ جَهلاً أَن يُقالَ أَثيمُ",54,"م",1,0],["أنت امرؤ إِما ائتمنتكَ خالياً","فخنتَ وإِمَّا قلتَ قولاً بلا علم",55,"م",1,1],["إن تأمري فاديب النيل ممتثل","لم يعص أمراً ولم يقعد به طلب",56,"ب",1,0],["أنت امرؤ جوده غمر ونائله","همر ووبل نداه مسبل غدق",57,"ق",1,0],["أَنتَ إِمامُ الهُدى الَّذي أَصلَحَ اللَ","هُ بِهِ الناسَ بَعدَما فَسَدوا",58,"د",3,0],["أَنتَ اِمرؤٌ شُكري لَهُ واجِبٌ","وَلَم أَكُن قَصَّرتُ في واجِبِه",59,"ه",1,1],["أنتَ امرؤٌ متجن","ولست بالغضبان",60,"ن",1,1],["إن تأملت منه حرفاً فحرفاً","أو تصفحت منه سطراً فسطرا",61,"ر",2,0],["أنت امرُؤٌ لو متّ ث","مّ وجَدتَ ريح الخبزِ عِشتا",62,"ت",2,0],["أنت أمين الله في خلقه","حقا وأنت الملك السيد",63,"د",1,0],["أنت أمّي العطوفُ والأمُّ تؤوي","من أتاه الفطامُ بعد ارتحالِ",64,"ل",1,1],["أنت أمٌ...أنت طفل","أنت للوجد أباه",65,"ا",2,0],["أنت امتلكت هواها أينما ذهبت","من دون حبك ماتت كيف أحييها",66,"ي",3,0],["أنتَ امتدادُ الظلّ والأ","نسامِ في مرْجٍ جديبِ",67,"ب",1,0],["‏ ‏أنت اْمرؤٌ متفضلٌ","‏ ‏ نجحَ اللئامُ بطعْنِهِ",68,"ن",2,0],["أنتِ امْتَلَكتِ هَواهُ مَحضَ حقيقةٍ","فَغَدا بِنَبضِكِ عَاشَقاً وأميرا",69,"ر",2,0],["أنت أمٌّ وأنت أخت وزوج","وحنين يظمنا أحبابا",70,"ب",2,0],["أنتِ آمالي التي أرقبها","وضيائي بعد ليل الظُلم",71,"م",1,0],["أنتِ أمِّي . أنا ابنكِ.. امتحِنيني","في يقينِ الوفاءِ عدلا وُظلما",72,"م",2,0],["أنتَ أمٌّ وأبٌ، أخٌّ وخِلٌّ","إنْ أخذْنا لستَ يومًا بالمَنوعِ",73,"ع",1,0],["أنت أمّي ووالدي وصديقي","وحنيني الذي إليه أؤوب",74,"ب",1,0]]}