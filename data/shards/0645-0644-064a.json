https://www.aldiwan.net/poem17620.html","الطويل"],[587,"مليح حكاه البدر عند طلوعه","https://www.aldiwan.net/poem17996.html","الطويل"]],"verses":[["مليك صوت حاجبه خفير","بأهدابٍ له اصطفت حرابا",0,"ب",2,0],["مَليئونَ في يَومِ القَضاءِ إِذا اِنتَدوا","بِجَدعِ القَضايا مِن أُنوفِ المَظالِمِ",1,"م",1,0],["مُلِئتُمُ النَعماءَ وَالدَواما","عاماً عَلى رَغمِ العِدا فَعاما",2,"م",2,0],["مُلِئَت بِفَضلِكَ فَالوَليُّ مُكَثِّرٌ","ما شاعَ عَنها وَالعَدوُّ مُقَلِّلُ",3,"ل",1,0],["مَليئونَ أَن يُبدوا بِذي التاجِ ذِلَّةً","إِذا كَرُموا في طاعَةِ الجودِ ذي الطِمرِ",4,"ر",1,0],["مَلِيءٌ بِأَوْصَافِ الإِمَامِ بِمِثْلِهِ","وَلاَ مِثْلَ مَنْ يَبْغِي الإِمَامَةَ يَأتَمُّ",5,"م",1,0],["مُلِئَتْ صُدُورُ المُسْلِمِينَ سَكِينَةً","إذْ ذَاكَ وانْتَاشَ القُلُوبَ رَجَاءُ",6,"ا",2,0],["مُلِئَتْ منْ جوْهَرِ الدّمْعِ يَدي","عجَباً أقْبَلُ في قَلْبي الرّشا",7,"ش",2,0],["مَليكِيَّةٌ جاوَرَت بِالحِجا","زِ قَوماً عُداةً وَأَرضاً شَطيرا",8,"ر",2,0],["مُلِئَت رَحمَةً وَفاضَت حَناناً","فَهيَ لِلبائِساتِ دارُ السَلامِ",9,"م",1,0],["مَليكٌ رَعاهُ بِإِقبالِهِ","وَحُسنِ عِنايَتِهِ وَالجَدا",10,"ا",1,0],["مَليكٌ إِذا غَنّى اليَراعُ بِمَدحِهِ","سَرَت بِالمَعالي هِزَّةٌ وَسُرورُ",11,"ر",1,0],["مَليكٌ أَباحَ العيدُ لَثمَ يَمينِهِ","وَيالَيتَ ذاكَ العيدَ يَبسُطُ أَعذاري",12,"ر",2,0],["مَليكٌ إِذا ما جالَ في مَتنِ ضامِرٍ","لِيَومِ وَغىً أَبصَرَت بَحراً عَلى بَحرِ",13,"ر",1,0],["مَليكٌ تَحَلّى المُلكُ مِنهُ بِعَزمَةٍ","بِها طالَ مِن رُمحِ السِماكِ قَصيرُها",14,"ر",3,0],["مَليكٌ إِذا سابَقَتهُ المُلوكُ","حَوى الخَصلَ أَو ساهَمَتهُ سَهَم",15,"م",1,0],["مَليكٌ لَهُ مِنّا النَصيحَةُ وَالهَوى","وَمِنهُ الأَيادي البيضُ وَالنِعَمُ الخُضرُ",16,"ر",1,0],["مَليكٌ يَسوسُ المُلكَ مِنهُ مُقَلِّدٌ","رَوى عَن أَبيهِ فيهِ ما سَنَّهُ الجَدُّ",17,"د",1,0],["مَليكٌ تَجَلّى لَهُ غُرَّةً","تَأَمَّلَها غِرَّةً تُهتَبَل",18,"ل",1,0],["مَلِيكَةٌ ذَاتُ وَجْهٍ","سَمْحٍ وَطَرْفٍ مُذِيبِ",19,"ب",1,0],["مَلِيكَةُ الوَرْدِ مِلْءُ العَيْنِ صُورتُهَا","مَاءُ الجَمَالِ جَرى فِيهَا فَأَرواهَا",20,"ا",3,0],["مَلِيكَا سَاعَةٍ فِي عَرْشِ فَأْلٍ","أَقَامَتْهُ لِسَعْدِهِمَا الأَمَانِي",21,"ن",2,0],["مَلِيكَتَانَا أَدَامَ اللهُ عِزَّهُمَا","شَمْسَانِ أَشْرَقَتَا بِاليُمْنِ فِي آنِ",22,"ن",1,1],["مَلِيكُنَا صُورَةُ الدُّنْيَا وَقَدْ حَسُنَتْ","كَأَنَّهُ مَلَكٌ فِي شَكْلِ إِنْسَانِ",22,"ن",1,0],["مُلِيءَ الْخَافِقَانِ قَتْلاً وَثُكْلاً","وَحِمَاهَا عَلَى الصُّرُوفِ حَرَامُ",23,"م",1,0],["مُلِيءَ الزَّمَانُ بِعَبْقَرِيَّتِكَ الَّتِي","يَعْفُو الزَّمَانُ وَمَا بَنَتْ سَيُقِيمُ",24,"م",1,0],["مليك واصل الأقدام حتى","أتاه بهلكه يوم الهلوك",25,"ك",1,0],["مليجيٌّ له في الجودِ بابٌ","يكاد زحامه ينهى ولوجي",26,"ج",2,0],["مليكٌ رأى أن لا مباريَ في الورى","فظلَّ يباري سؤددَ اليومِ بالغد",27,"د",1,0],["مليكٌ له في الملك أصلٌ ومكسبٌ","وحظّ فنعم الجدّ والجدُّ والجدّ",28,"د",1,0],["مليكٌ حوى في الملكِ أفضل وصفه","فيا حبَّذا نعتاً ونفساً ومحتدا",29,"د",2,0],["ملئَ البيتُ من يديك نوالاً","فملأنا أبيات مدحك حمدا",30,"د",2,0],["مليك بدا في أحمر من ملابس","كذاك بدت من حوله الخيل والجند",31,"د",1,1],["مليكٌ سمت عيناه للنسك والعلى","فكانت قليلاً من دجى الليل ما تكرى",32,"ر",2,0],["مليكٌ روت أعماله سيرَ التقى","عن الملك المصري عن الحسن البصري",33,"ر",2,0],["مليك التقى والعلم والبأس والندى","فمدحٌ على مدحٍ وشكرٌ على شكر",33,"ر",1,0],["مليح يغيظُ الوردَ حمرةَ خدّه","ويطوي حديث العنبر الورد نشره",34,"ر",2,0],["مليك تساوى علمه ونواله","كأنَّهما بحران جاءا على بحر",35,"ر",1,0],["مليكَ العلى بشراك بالعيد مقبلاً","وبشرى الورى من سحب كفَّيك بالعشر",35,"ر",1,0],["مليحٌ جلا من خطِّه لي رقعة","تدلّ على تحريره واعتباره",36,"ه",1,1],["مليك أعاد الشعر سوقاً بدهره","فجئت إلى أبوابه متبضعا",37,"ع",2,0],["مليكٌ له في الجودِ صنعٌ تأنَّقت","معانيه حتى خلتهُ يتصنَّع",38,"ع",1,0],["مليحة حجبت وشاعت","فخاب طرسٌ وفاز شمع",39,"ع",1,0],["ملئت إنسانُ عيني عسجداً","من خدودٍ قد ملاها الحسن صبغا",40,"غ",2,1],["مليك التقى هنئت بالجامع الذي","وجدت إلى مبناه سعداً موافقا",41,"ق",2,1],["مليكٌ إلى مغناه تستبق المنى","مسابقة الحجاج نحو المناسك",42,"ك",1,0],["مليك إذا رمنا مديح جلاله","فأقلامنا تجري وأوصافه تملي",43,"ل",2,0],["مليحةٌ إن تكن في حسنِها صنماً","فيا عذوليَ لا بوركت من هُبَلي",44,"ل",2,0],["مليكان هذا قد هوى لضريحه","برغمي وهذا للأسرّة قد سما",45,"م",2,0],["مليكٌ تولَّى الفضل بعد ضياعه","وهذَّب هذا الدهر بعد خبونه",46,"ن",2,0],["مليكٌ له في العلم والجود همةٌ","ترى المال في الإقتار والعيش في العنا",47,"ن",2,0],["مليّ الحسن حالي الوجنتين","متى يقضي وعود الوصل ديني",48,"ن",2,1],["مليك رقى قبل الصبا كاهل العلى","فكيف وقد أبصرته متكهّلا",49,"ل",2,0],["مليك له سورٌ في الثنا","تظلُّ السراة لها جافيه",50,"ي",2,0],["مُلِّيتَهُمْ حتَّى تُحَقَّ كُنَاهُمُ","فَتَرَى بنيهِمْ باكِرينَ وَرُوَّحَا",51,"ح",2,0],["مَليٌّ بأنْ يغشَى الغِمَارَ وأنْ يَرى","مصادِرَها بالرأْي قبْل وُرُودِها",52,"د",3,0],["مَليٌ من الحمد والتحميد حاملة","ألطاف حُرٍّ يرجّي منك ألطافا",53,"ف",2,0],["مليكَ الناس أعتقنا","فإعتاقك إعتاق",54,"ق",1,0],["مليك الناس خلِّصنا","إذا ما كُشِّفَت ساق",54,"ق",1,0],["مليك الملك هل مما","تطوقناه إطلاق",54,"ق",1,0],["مليئاً إن توسّم بالمعاني","وفيَّاً إنْ تَكَلَّمَ بالبيان",55,"ن",1,0],["مُلِّيتْكَ الملوكُ سَيْفَ جلادٍ","وعصا رِعيةٍ ورمحَ طِعان",56,"ن",1,0],["مَليحٌ كُلَّ ما فيهِ مَليحٌ","مَليحٌ دونَهُ البَدرُ التَمامُ",57,"م",1,0],["مَلِيٌّ بِتَسيِيرِ الثَناءِ وَإِنَّني","لَيُعجِزُني إِحسانُكَ المُتَكاثِرُ",58,"ر",1,0],["مُلِئَ الدَّهْرُ بالخداعِ فكمْ قَدْ","ضَلَّلَ النَّاسَ مِنْ لإمامٍ وقسِّ",59,"س",1,0],["ملئت بكم خُلُقا وكانت لا ترى","خلق الرجال ولا تحس إباءها",60,"ا",3,0],["مُلِئَت قُلوبُ العالَمينَ بِفِعلِهِ ال","مَحمودِ مِن خَوفٍ لَهُ وَرَجاءِ",61,"ا",2,0],["مَلِيٌّ بِنَصرِ الحَقِّ وَالحَقُّ أَوحَدٌ","إِذا عُصبَةٌ مِنّا لِظُلمٍ تَصَدَّتِ",62,"ت",1,0],["مَلِيّونَ أَن تُسقى البِلادُ غِياثَها","بِأَوجُهِهِم حَتّى تَسيلَ فِجاجُها",63,"ج",3,0],["مَلِيّاً إِذا ما كانَ بادِئَ نِعمَةٍ","بِكَرِّ العَطايا البادِئاتِ العَوائِدِ",64,"د",1,0],["مَليءٌ بِأَن يَستَرِقَّ القُلو","بَ عَلى هَزلِهِ وَعَلى جَدِّهِ",65,"د",2,0],["مَليءٌ أَن يُقِلَّ السَيفَ حَتّى","يَنوسَ إِذا تَمَطّى في النِجادِ",66,"د",1,0],["مَليؤونَ جوداً أَن تَضيمَ أَكُفُّهُم","حَيا كُلِّ عَرّاصِ العَشِيِّ رَعودِ",67,"د",1,0],["مَلِيّاً بِأَن يَجلو الظَلامَ بِغُرَّةٍ","تَخاضَ