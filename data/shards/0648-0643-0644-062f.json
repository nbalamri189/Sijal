{"poems":[[55,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[9,"تصابيت أم بانت بعقلك زينب","https://www.aldiwan.net/poem21908.html","الطويل"],[10,"جرى لي طير في حمام حذرته","https://www.aldiwan.net/poem21067.html","الطويل"],[87,"حلفت بالمستره","https://www.aldiwan.net/poem62862.html","مجزوء الرجز"],[51,"ألا أين الألى سلفوا","https://www.aldiwan.net/poem62179.html","البسيط"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[119,"روح الوجود معاني الكون جملتها","https://www.aldiwan.net/poem42173.html","البسيط"],[216,"ألا كل ليل زار فيه خليل","https://www.aldiwan.net/poem37840.html","الطويل"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[264,"لك السعد أسعد يا صبا ما المشام","https://www.aldiwan.net/poem35738.html","الطويل"],[266,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[463,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[520,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[556,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[567,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[567,"قف بالديار وحي القوم عن كثب","https://www.aldiwan.net/poem52914.html","البسيط"],[580,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122703","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97049","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37751","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27858","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124766","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46746","السريع"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132209","الطويل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58312","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62765","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133249","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136872",""],[5219,"الطاهرة المطهرة","https://www.poetsgate.com/ViewPoem.aspx?id=194998",""],[5277,"ليلُ المنافي","https://www.poetsgate.com/ViewPoem.aspx?id=191209",""],[5413,"أفي الله شك فاطر السموات والأرض!!","https://www.poetsgate.com/ViewPoem.aspx?id=201589",""],[5459,"مدلجون..","https://www.poetsgate.com/ViewPoem.aspx?id=191597",""],[5939,"مُتوَّجةٌ في سماواتِ عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=178605",""],[5956,"رشادٌ مستديم","https://www.poetsgate.com/ViewPoem.aspx?id=192321",""],[6093,"قلبٌ يَطرُقُ البَابَا","https://www.poetsgate.com/ViewPoem.aspx?id=189701",""],[6093,"مُشَرَّدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198050",""],[6251,"أنتَ الأمَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76468&r=&rc=8",""]],"verses":[["وَكُلُّ دَمٍ عِندي إِذا ما حَمَلتُهُ","وَإِن أَثقَلَ الأَقوامَ غَيرُ ثَقيلِ",0,"ل",1,0],["وَكُلُّ دِلاصٍ كَالأَضاةِ حَصينَةٍ","تَرى فَضلَها عَن رَبِّها يَتَذَبذَبُ",1,"ب",1,0],["وَكُلُّ دِلاصٍ كَالأَضاةِ مُذالَةً","وَكُلُّ جَوادٍ بَيِّنِ العِتقِ قارِحِ",2,"ح",1,0],["وَكُلَّ دَمعٍ كَذِبٍ","وَلَوعَةٍ مُزَوَّرَه",3,"ر",2,0],["وَكُلٌّ دائِمُ الغَفَلا","تِ وَالأَنفاسُ تُختَطَفُ",4,"ف",1,0],["وكلِّ درعٍ دِلاصِ المَتن سابغةٍ","تُطوَى على كل ضافي النسْج مَسرود",5,"د",1,0],["وكل دائرة الأكوان ذكرت","فأنت سيدها حكماً ومولاها",6,"ا",3,0],["وكلُّ دموعٍ في الهوى جفَّ غَرْبُها","فَحَتْماً على إثْرِ الفراق تسيلُ",7,"ل",1,0],["وكل دولة شادت من المجد والعلي","لها العز ثوب والسيادة مركب",8,"ب",1,0],["وكل دعي بالامارة يدعى","قد افترقوا ما بينهم وتشعبوا",8,"ب",3,0],["وكلّ دعيٍّ يدّعي غيره ادعُهُ","إلى ما عليه البيّنات تقام",9,"م",1,0],["وكل دلاص يشرب العين من صفا","بها وصقال في جوانبها نهرا",10,"ر",2,0],["وكلّ دعيِّ فضلٍ مستطِبٍّ","له بالعجز شغلٌ واعتذارُ",11,"ر",1,0],["وكل دعاء لم يشيع بذكره","فليس بمرفوع ولا بمجاب",12,"ب",1,0],["وكلّ داعٍ بي إلى نُصرةٍ","سابقةٌ دعوتهُ نُصرتي",13,"ي",1,0],["وكلُّ دِيوانِ شِعرٍ كُنتَ تَنظِمُهُ","وكلُّ ديوانِ قومٍ فيكَ ينتظِمُ",14,"م",1,0],["وكلُّ دارٍ بها الضِرغامُ مُؤْتلِفٌ","بالظَبيِ بينَ عَرُوض البَيتِ والطُنُبِ",15,"ب",1,0],["وكلُّ دمعٍ ليَ جدَّدْتُه","حُزْناً على أَيامِكَ القِدْم",16,"م",1,0],["وَكُلُّ دِلاصٍ كَمِثلِ الغَديرِ","هَبَّ النَّسيمُ لَهُ فاصطَلَق",17,"ق",1,0],["وكل دعا من لي بفروةٍ أتقي","بها البرد أيام الشتا أتحجب",18,"ب",1,0],["وَكُلُّ دِيارٍ سَوفَ تَعفو رُسومُها","وَفيها غُرابُ البَيْنِ بِالبَيْنِ ناعِقُ",19,"ق",1,0],["وكل داء ومقام أعضلا","وهلع وجزع إن نزلا",20,"ل",2,0],["وكل دينٍ إذا ما مات صاحبه","يحل إلا إلى ميقاته السلف",21,"ف",1,0],["وكلُّ دليلٍ جاءكم في معاند","يخالف قولي فاجعلوه هَباء",22,"ا",2,0],["وكل دواء فيه خلط محرم","حرامٌ كترياق بغير تقيد",23,"د",1,0],["وَكُلُّ دُنيا وَنَعيمٍ لَها","مُنكَشِفٌ عَن أَهلِهِ زائِلُ",24,"ل",1,0],["وكل دعي بين أبناء يعرب","وقحطان لا يغنيه ثم فضول",25,"ل",1,0],["وَكلّ دينارَين يا إمامي","بِكُلّ رَأسٍ مِن بَني الأَعجامِ",26,"م",1,0],["وكلّ ديباجِ خَدّ ظبْي","إنْ لم يَكُنْ مُعْلماًُ فَدَحَرجْ",27,"ج",1,0],["وكلّ دار حاك الرَبيع لَها","وَشيا وَقام النَسيم يرصدها",28,"د",3,0],["وكلُّ دنيٍ ظاهرِ النّقصِ منهم","يَرى أنه فوقَ الهُمامِ المُحجَّبِ",29,"ب",1,0],["وكل دين بدين المصطفى نسخت","آياته واستحال الرشد أحباره",30,"ر",2,0],["وكُلَّ دعائي يا مجيب أجب بما","ترى فيه لي خيراً إجابة مضطرِّ",31,"ر",1,0],["وكل ديار إذا رآنا من أهل الدنان","يضع ويخضع ولا يفتضها إلا بدان",32,"ن",1,0],["وكلُّ دعيٍّ راح ينفثُ سُمّه","زعافا كحياتِ الجُحور القواتلِ",33,"ل",1,0],["وكلُّ دروبِ العادياتِ مشيتُها","وكلُّ جوارٍ صهرُنا ونسيبُ",34,"ب",1,0],["وكلُّ دليلٍ خِلْنَ يَنْفيهِ سرمدًا","دليلٌ لإثباتِ الربوبيةِ الأعلى",35,"ل",2,0],["وَ كُلُّ دَارٍ غَشَتْهَا قَبْلُ وَاجِمَةٌ","سَفْكُ الدِّمَاءِ بِهَا سَيْلٌ طَمَا عَرِمُ..",36,"م",1,0],["وكلُّ دواءٍ لهُ ليسَ يُجدي، تَجاوزَ مَفعولُهُ المُنتَهَى","وإن رامَ يَنسَى كَوَى الشَّوقُ حِسّا: \"أيا ويلَ قلبِكَ إنْ خُنتَها\"!",37,"ت",3,0],["وكلّ دقائق الإحساس فيه","ليخذل كل شيطانٍ رجيمِ",38,"م",1,0],["وَكَلُّ دارٍ لنا في جَوفِها سَكَنٌ","فَتِلكَ دارٌ يراها القلبُ مِحْرابَا",39,"ب",2,0],["وَكُلُّ دَربٍ مَشَى بالرَّفضِ شَايَعَهُ","أمَّا الغُبَارُ بِسُوءِ الظَّنِّ قَدْ سَبَقَهْ",40,"ق",2,0],["وُكُلْ دُنْيَانَا وُمَا حَوْلَنْا","قَدْ احْتَوَانَا قُبْلَهْ واحْتِضَانْ",41,"ن",1,0]]}