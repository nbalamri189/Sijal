px?id=214175",""],[402,"صدقت في عتبكم أو يصدق الشمم","https://www.poetsgate.com/ViewPoem.aspx?id=36829",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5829,"بلبل الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=176836",""],[5893,"حنا على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=141493",""],[5943,"سلوا الأيام منشدة(أبو سهام)","https://www.poetsgate.com/ViewPoem.aspx?id=34370",""],[5956,"دفاع عن الحظائر *","https://www.poetsgate.com/ViewPoem.aspx?id=183370",""],[5957,"عروبي الهوى قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=194589",""],[6100,"العام في شوفي تزف التباشير","https://www.poetsgate.com/ViewPoem.aspx?id=52552",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[6237,"الليل في الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77891&r=&rc=33",""],[2220,"تظن ترى ناساً وما هم كما ترى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11702&r=&rc=572",""],[6316,"في رثاء الشيخ بن باز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65165&r=&rc=0",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""]],"verses":[["قُلوبٌ كَأُسدِ الشَرى الضارِياتِ","وَأَحشاؤُهُم دونَها كَالأَجَم",0,"م",1,0],["قَلّوا عَناءً وَإِن أَثرى عَديدُهُمُ","وَرُبَّما قَلَّ أَقوامٌ وَإِن كَثُروا",1,"ر",3,0],["قُلوبُهُمُ بِذُيولِ الحِمامِ","مِن وَقعِ أَطرافِها في عِثارِ",2,"ر",1,0],["قُلوبُنا عِندَكَ مَعقودَةٌ","بِطَرفِ ذاكَ الشادِنِ العاقِدِ",3,"د",1,0],["قَلّوا عَلى كَثرَةِ العَدُوِّ لَهُم","كَم عَدَدٍ لا يُعَدُّ في العُدَدِ",4,"د",1,0],["قُل وَاِحتَكُم أَنتَ مُختارٌ فَقالَ لَهُم","إِنّا رِجالٌ نُهينُ المالَ وَالنَشَبا",5,"ب",2,0],["قلوبنا حيث حلوا في جوانبهم","إن حال دون التلاقي نأى بلدان",6,"ن",1,0],["قُلْ وَحَقِّ الوَفَاءِ لَسْنَا بِسَالِ","يْنَ وَمَا وَحْشَةٌ سِوَى السُّلْوَانِ",7,"ن",1,0],["قَلُّوا وَأَبْلَى بَلاءَ الْجَمْعِ وَاحِدُهُمْ","تَحَيَّرَ مِمَّا خُولِفَ الرَّقَمُ",8,"م",1,0],["قَلوصَينِ عَوجاوَينِ بَلّى عَلَيهِما","هَواءُ السُرى ثُمَّ اِقتِراحُ الهَواجِرِ",9,"ر",1,0],["قُلوبُ العاشِقينَ لَها عُيونٌ","تَرى ما لا يَراهُ الناظِرونا",10,"ن",2,1],["قُلوبَنا لَيسَ فيها غَيرُ موجِدَةٍ","ذو الشَيبِ فيها وَفَحمُ الشَزِ سِيّانِ",11,"ن",1,0],["قُلوبُهُم في مَضاءِ ما اِمتَشَقوا","قاماتُهُم في تَمامِ ما اِعتَقَلوا",12,"ل",3,0],["قلوبُهمُ من جهلِهمْ في أَكِنَّةٍ","وآذانُهم من غَيّهمْ مُلِئَتْ وَقْرَا",13,"ر",2,0],["قلوبٌ كأمثالِ الجلاميدِ صخرةٌ","وشرٌّ كشرِّ الزندِ فيهنّ محجوبُ",14,"ب",1,0],["قُلوبٌ شَجَتهُنَّ الخُدودُ المَلائِحُ","وَساقٍ بَدا كَالصُبحِ وَاللَيلُ جانِحُ",15,"ح",1,1],["قَلّوا وَما قَلَّت صَواعِقُ نارِهِم","دُفَعاً بِصَحراءِ العَدُوِّ المُصحِرِ",16,"ر",1,0],["قُلوبُ مُنافِقينَ طَغَوا وَشَبّوا","بِكُلِّ ثَنِيَّةٍ بِالأَرضِ نارا",17,"ر",2,0],["قُلوبُنا مودَعَةٌ عِندَكُم","أَمانَةً نَعجَزُ عَن حَملِها",18,"ه",2,1],["قَلّوا لَدَيكَ فَأَخطَأوا","لَمّا دَعَوتَ فَأَبطَأوا",19,"ا",1,1],["قَلّوا لَدَيْكَ غنيمةً فكأنّما","أَبقتهُمُ الأَيّامُ فيه لِيَكثُروا",20,"ر",3,0],["قلوبُ عداةِ اللَّه منها خوافِقٌ","كما قلبت فيها الصَّبا عَذَبَ البندِ",21,"د",1,0],["قَلّوا وَلَكِنَّهُم طابوا فَأَنجَدَهُم","جَيشٌ مِنَ الصَبرِ لا يُحصى لَهُ عَدَدُ",22,"د",1,0],["قلوبُ كلِّ الناسِ في أسرهم","قيَّدَها جودُهُم المطلَقُ",23,"ق",1,0],["قُلوبٌ من سَوادِ القومِ عُمْيٌ","وألبابٌ من الزعماءِ حُولُ",24,"ل",1,0],["قُلوبُ الخَلقِ أَسراك","وَقَلبي وَحدُ مَثواك",25,"ك",1,0],["قُلوبُهُم في جَنى النَعيمِ بِها","وَإِن بَدَت في وُجوهِهِم شُعَلا",26,"ل",2,0],["قُلوبٌ عَرَفنَ الحَقَّ فَهيَ قَدِ اِنطَوَت","عَلَيها جُنوبٌ ما عَرَفنَ المَضاجِعا",27,"ع",2,0],["قُلوبُ الناسِ أَسرى في يَدَيهِ","وَثَوبُ الحُسنِ مَخلوعاً عَلَيهِ",28,"ه",1,1],["قلُوبُهمْ باخعَةٌ بالطَّاعهْ","قد أَجْمعوا الدُّخولَ في الجَماعَهْ",29,"ه",1,0],["قلوبٌ مُدلَّهةٌ بالجمالِ","ترى فيه معبودَها المُلْهَما",30,"م",2,0],["قلوبٌ تلذُّ بتعذيبها","غرائزُ عاتيةٌ عارمه",30,"ه",1,0],["قلوبُنا منه تُصيبُ الحياه","وتستمدُّ النَّضرةَ الخالدهْ",31,"ه",1,0],["قلوبٌ قاسياتٌ قنّعتها","وجوهٌ شاعرياتٌ نبيلَهْ",32,"ل",2,0],["قُلُوبُ الرِّجَالِ الْمُسْتَبِدَّةِ أَكْلُهُ","وَفَيْضُ الدِّماءِ الْمُسْتَهِلَّةِ وِرْدُهُ",33,"د",2,0],["قَلُّوا سَوَاداً وَجَازَ الْحَصْرَ مَا فَعَلُوا","حَتَّى لَيَذْكُرَهُ النَّائِي فَيَرْتَعِدُ",34,"د",1,0],["قُلوبٌ فيكَ دامِيَةُ الجِراحِ","وَأَكبادٌ مُكَلَّمَةُ النَواحي",35,"ح",2,1],["قُلْ - وقُيتَ العِثارَ - في ندوة القَوْ","مِ، متى أصبح الحليفُ مُخاصِم؟",36,"م",1,0],["قلوبُ بني مصرٍ خوافقُ حولَها","لها كلَّ حينٍ جَيْئةٌ وذَهاب",37,"ب",1,0],["قُلُوبُهُمْ في يَدَيْهِمْ","تُهْدَى إلَيْكَ احْتِسَابا",38,"ب",2,0],["قلوب العاشقين لها حنين","لذكرك واضطراب واضطرام",39,"م",1,0],["قلوبنا ابدا تطوي الهيام لكم","وللقلوب بما تطوى اختلافات",40,"ت",1,0],["قلوب والباب هي الركب نحوها","يروح ويغدو مستظلا بها الركب",41,"ب",1,0],["قُلوبٌ ذَعَرتَ الخَوفَ عَنها بِضِدِّهِ","فَأَنتَ بِها أَحلى مِنَ المالِ وَالوُلدِ",42,"د",1,0],["قُلوبٌ فاضَ سَيلُ اليَأسِ فيها","وَتَأبى نارُها إِلّا اِضطِراما",43,"م",2,0],["قلوبهم بوعظك خافقاتٌ","وأدمعهم هواملُ في المصلّى",44,"ل",2,0],["قِلٌّ وَذُلٌّ وَخِذلانٌ وضَيمُ عِدىً","مُقامُ مِثلي عَلى هَذا مِنَ العَجَبِ",45,"ب",1,0],["قلوبٌ فزعنا بها للدموعِ","فما أطفأ الدمع من نارِها",46,"ر",3,0],["قلوبهم شتى هواء من الهوى","إلى أن قضوا في لهوهم وتشعبوا",47,"ب",3,0],["قُلوبُ مُحبِّيهِ به مُطمئنَّةٌ","ومنها إليه حيثُ كان تشوُّقُ",48,"ق",1,0],["قلوب اِمتزجت بالود ما بلغت","وان بعدتم فَمَعنى سركم مَعنا",49,"ن",2,0],["قُلوبُنا تُخزَمُ لا أُنوفُنا","وَكُلُّ خَطبٍ أَخطَأَ الأَنفَ جَلَل",50,"ل",1,0],["قُلوبُ الأولى خَلفَ الفَرَنجَةِ كُلِّهِم","وَأَنتَ بِأَرضِ الشامِ طائِرَةٌ ذُعرا",51,"ر",2,0],["قُلوباً لا تَزالُ تَهيمُ وَجداً","بِذِكرِكَ في الغُدُوِّ وَفي الرَواحِ",52,"ح",1,0],["قلوبٌ وأجسامٌ تُزاحم ناديا","يفرّقها رهباً وَيَجمعها حبّا",53,"ب",2,0],["قُلوبُ الوَرى في مَطمح الفكر قلّبُ","وَبَرق المُنى في غَيهب الوَهم خُلَّبُ",54,"ب",1,1],["قلوبُ العِدا منه حِذاراً كقلْبِه","علينا وعَيْناهُ كأعيُنهم سهدا",55,"د",2,0],["قُلوبُنا اليومَ كالعيونِ لكم","أَمرَضُها إن نظَرْتَ أبرَؤه