ض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[282,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[282,"أيا من ثغره نور الأقاحي","https://www.aldiwan.net/poem32827.html","الوافر"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[353,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[364,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[364,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[371,"توق إذا ما حرمة العدل جلت","https://www.aldiwan.net/poem57518.html","الطويل"],[377,"قل ويك بيلاطوس الباغي بفعلته","https://www.aldiwan.net/poem59143.html","البسيط"],[380,"وجد له في الحشا دبيب","https://www.aldiwan.net/poem49249.html","مخلع البسيط"],[400,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[416,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[441,"بئس الصداقة عقباها العداوات","https://www.aldiwan.net/poem14353.html","البسيط"],[441,"عزاء وصبرا كل حي فميت","https://www.aldiwan.net/poem14441.html","الطويل"],[452,"قل وحث المدام في إبانه","https://www.aldiwan.net/poem13936.html","الخفيف"],[458,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[458,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[458,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[461,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[464,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[465,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[479,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[500,"روق كؤوسك هذا الوقت قد راق","https://www.aldiwan.net/poem37939.html","البسيط"],[500,"قلوب الأولياء لها سيوف","https://www.aldiwan.net/poem37953.html","الوافر"],[500,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[515,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[538,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[553,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[553,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[558,"قلوب متى منه خلت فنفوس","https://www.aldiwan.net/poem34450.html","الطويل"],[558,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"],[560,"قلوب ودروب","https://www.aldiwan.net/poem67273.html","عموديه"]],"verses":[["قُلوبٌ كَأُسدِ الشَرى الضارِياتِ","وَأَحشاؤُهُم دونَها كَالأَجَم",0,"م",1,0],["قَلّوا عَناءً وَإِن أَثرى عَديدُهُمُ","وَرُبَّما قَلَّ أَقوامٌ وَإِن كَثُروا",1,"ر",3,0],["قُلوبُهُمُ بِذُيولِ الحِمامِ","مِن وَقعِ أَطرافِها في عِثارِ",2,"ر",1,0],["قُلوبُنا عِندَكَ مَعقودَةٌ","بِطَرفِ ذاكَ الشادِنِ العاقِدِ",3,"د",1,0],["قَلّوا عَلى كَثرَةِ العَدُوِّ لَهُم","كَم عَدَدٍ لا يُعَدُّ في العُدَدِ",4,"د",1,0],["قُل وَاِحتَكُم أَنتَ مُختارٌ فَقالَ لَهُم","إِنّا رِجالٌ نُهينُ المالَ وَالنَشَبا",5,"ب",2,0],["قلوبنا حيث حلوا في جوانبهم","إن حال دون التلاقي نأى بلدان",6,"ن",1,0],["قُلْ وَحَقِّ الوَفَاءِ لَسْنَا بِسَالِ","يْنَ وَمَا وَحْشَةٌ سِوَى السُّلْوَانِ",7,"ن",1,0],["قَلُّوا وَأَبْلَى بَلاءَ الْجَمْعِ وَاحِدُهُمْ","تَحَيَّرَ مِمَّا خُولِفَ الرَّقَمُ",8,"م",1,0],["قَلوصَينِ عَوجاوَينِ بَلّى عَلَيهِما","هَواءُ السُرى ثُمَّ اِقتِراحُ الهَواجِرِ",9,"ر",1,0],["قُلوبُ العاشِقينَ لَها عُيونٌ","تَرى ما لا يَراهُ الناظِرونا",10,"ن",2,1],["قُلوبَنا لَيسَ فيها غَيرُ موجِدَةٍ","ذو الشَيبِ فيها وَفَحمُ الشَزِ سِيّانِ",11,"ن",1,0],["قُلوبُهُم في مَضاءِ ما اِمتَشَقوا","قاماتُهُم في تَمامِ ما اِعتَقَلوا",12,"ل",3,0],["قلوبُهمُ من جهلِهمْ في أَكِنَّةٍ","وآذانُهم من غَيّهمْ مُلِئَتْ وَقْرَا",13,"ر",2,0],["قلوبٌ كأمثالِ الجلاميدِ صخرةٌ","وشرٌّ كشرِّ الزندِ فيهنّ محجوبُ",14,"ب",1,0],["قُلوبٌ شَجَتهُنَّ الخُدودُ المَلائِحُ","وَساقٍ بَدا كَالصُبحِ وَاللَيلُ جانِحُ",15,"ح",1,1],["قَلّوا وَما قَلَّت صَواعِقُ نارِهِم","دُفَعاً بِصَحراءِ العَدُوِّ المُصحِرِ",16,"ر",1,0],["قُلوبُ مُنافِقينَ طَغَوا وَشَبّوا","بِكُلِّ ثَنِيَّةٍ بِالأَرضِ نارا",17,"ر",2,0],["قُلوبُنا مودَعَةٌ عِندَكُم","أَمانَةً نَعجَزُ عَن حَملِها",18,"ه",2,1],["قَلّوا لَدَيكَ فَأَخطَأوا","لَمّا دَعَوتَ فَأَبطَأوا",19,"ا",1,1],["قَلّوا لَدَيْكَ غنيمةً فكأنّما","أَبقتهُمُ الأَيّامُ فيه لِيَكثُروا",20,"ر",3,0],["قلوبُ عداةِ اللَّه منها خوافِقٌ","كما قلبت فيها الصَّبا عَذَبَ البندِ",21,"د",1,0],["قَلّوا وَلَكِنَّهُم طابوا فَأَنجَدَهُم","جَيشٌ مِنَ الصَبرِ لا يُحصى لَهُ عَدَدُ",22,"د",1,0],["قلوبُ كلِّ الناسِ في أسرهم","قيَّدَها جودُهُم المطلَقُ",23,"ق",1,0],["قُلوبٌ من سَوادِ القومِ عُمْيٌ","وألبابٌ من الزعماءِ حُولُ",24,"ل",1,0],["قُلوبُ الخَلقِ أَسراك","وَقَلبي وَحدُ مَثواك",25,"ك",1,0],["قُلوبُهُم في جَنى النَعيمِ بِها","وَإِن بَدَت في وُجوهِهِم شُعَلا",26,"ل",2,0],["قُلوبٌ عَرَفنَ الحَقَّ فَهيَ قَدِ اِنطَوَت","عَلَيها جُنوبٌ ما عَرَفنَ المَضاجِعا",27,"ع",2,0],["قُلوبُ الناسِ أَسرى في يَدَيهِ","وَثَوبُ الحُسنِ مَخلوعاً عَلَيهِ",28,"ه",1,1],["قلُوبُهمْ باخعَةٌ بالطَّاعهْ","قد أَجْمعوا الدُّخولَ في الجَماعَهْ",29,"ه",1,0],["قلوبٌ مُدلَّهةٌ بالجمالِ","ترى فيه معبودَها المُلْهَما",30,"م",2,0],["قلوبٌ تلذُّ بتعذيبها","غرائزُ عاتيةٌ عارمه",30,"ه",1,0],["قلوبُنا منه تُصيبُ الحياه","وتستمدُّ النَّضرةَ الخالدهْ",31,"ه",1,0],["قلوبٌ قاسياتٌ قنّعتها","وجوهٌ شاعرياتٌ نبيلَهْ",32,"ل",2,0],["قُلُوبُ الرِّجَالِ الْمُسْتَبِدَّةِ أَكْلُهُ","وَفَيْضُ الدِّماءِ الْمُسْتَهِلَّةِ وِرْدُهُ",33,"د",2,0],["قَلُّوا سَوَاداً وَجَازَ الْحَصْرَ مَا فَعَلُوا","حَتَّى لَيَذْكُرَهُ النَّائِي فَيَرْتَعِدُ",34,"د",1,0],["قُلوبٌ فيكَ دامِيَةُ الجِراحِ","وَأَكبادٌ مُكَلَّمَةُ النَواحي",35,"ح",2,1],["قُلْ - وقُيتَ العِثارَ - في ندوة القَوْ","مِ، متى أصبح الحليفُ مُخاصِم؟",36,"م",1,0],["قلوبُ بني مصرٍ خوافقُ حولَها","لها كلَّ حينٍ جَيْئةٌ وذَهاب",37,"ب",1,0],["قُلُوبُهُمْ في يَدَيْهِمْ","تُهْدَى إلَيْكَ احْتِسَابا",38,"ب",2,0],["قلوب العاشقين لها حنين","لذكرك واضطراب واضطرام",39,"م",1,0],["قلوبنا ابدا تطوي الهيام لكم","وللقلوب بما تطوى اختلافات",40,"ت",1,0],["قلوب والباب هي الركب نحوها","يروح ويغدو مستظلا بها الركب",41,"ب",1,0],["قُلوبٌ ذَعَرتَ الخَوفَ عَنها بِضِدِّهِ","فَأَنتَ بِها أَحلى مِنَ المالِ وَالوُلدِ",42,"د",1,0],["قُلوبٌ فاضَ سَيلُ اليَأسِ فيها","وَتَأبى نارُها إِلّا اِضطِراما",43,"م",2,0],["قلوبهم بوعظك خافقاتٌ","وأدمعهم هواملُ في المصلّى",44,"ل",2,0],["قِلٌّ وَذُلٌّ وَخِذلانٌ وضَيمُ عِدىً","مُقامُ مِثلي عَلى هَذا مِنَ العَجَبِ",45,"ب",1,0],["قلوبٌ فزعنا بها للدموعِ","فما أطفأ الدمع من نارِها",46,"ر",3,0],["قلوبهم شتى هواء من الهوى","إلى أن قضوا في لهوهم وتشعبوا",47,"ب",3,0],["قُلوبُ مُحبِّيهِ به مُطمئنَّةٌ","ومنها إليه حيثُ كان تشوُّقُ",48,"ق",1,0],["قلوب اِمتزجت بالود ما بلغت","وان بعدتم فَمَعنى سركم مَعنا",49,"ن",2,0],["قُلوبُنا تُخزَمُ لا أُنوفُنا","وَكُلُّ خَطبٍ أَخطَأَ الأَنفَ جَلَل",50,"ل",1,0],["قُلوبُ الأولى خَلفَ الفَرَنجَةِ كُلِّهِم","وَأَنتَ بِأَرضِ الشامِ طائِرَةٌ ذُعرا",51,"ر",2,0],["قُلوباً لا تَزالُ تَهيمُ وَجداً","بِذِكرِكَ في الغُدُوِّ وَفي الرَواحِ",52,"ح",1,0],["قلوبٌ وأجسامٌ تُزاحم ناديا","يفرّقها رهباً وَيَجمعها حبّا",53,"ب",2,0],["قُلوبُ الوَرى في مَطمح الفكر قلّبُ","وَبَرق المُنى في غَيهب الوَهم خُلَّبُ",54,"ب",1,1],["قلوبُ العِدا منه حِذاراً كقلْبِه","علينا وعَيْناهُ كأعيُنهم سهدا",55,"د",2,0],["قُلوبُنا اليومَ كالعيونِ لكم","أَمرَضُها إن نظَرْتَ أبرَؤها",56,"ا",3,0],["قلوبٌ على الدين العَتيقِ تَألَّفَت","لهم ومنَ الحقد القديم استملَّتِ",57,"ت",1,0],["قل ويك بيلاطوسُ الباغي بفعلته","جزيتَ شرّاً بإقلالٍ وإعوازِ",58,"ز",1,1],["قُلوبُهم كُلَها عُيون","وَكُلُ أَجسامِهُم قُلوب",59,"ب",1,0],["قلوب ياأخا العزمات يبقى","لها من صدقها أوفى نصيب",60,"ب",1,0],["قلوبٌ عند كاظمةٍ رهون","وما قُبِضَتْ إذَنْ تلك الرهون",61,"ن",1,0],["قلوبنا ما خلت منكم لبينكم","منا قلوبكم فهي الخليات",62,"ت",1,0],["قلوب لنا أَعسى وأَقسى من الحصى","لها نائبات الدَهر تبري وتنحت",63,"ت",1,0],["قُلْ وحُثَّ المُدامَ في إِبّانِه","واجْرِ مَعْ من تُحبُّ في ميدانِه",64,"ن",2,1],["قلوبُهم رِقٌّ لأهل الحمى","حيث النواصي حرةٌ والجسومْ",65,"م",1,0],["قلوبٌ في سروجهمُ خِفافٌ","صدورٌ في مجالسهم ثِقالُ",66,"ل",1,0],["قلوبُ الغواني حديدٌ يقالُ","وقلبك نارٌ تذيبُ الحديدا",67,"د",2,0],["قلوبُ أعاديهمْ تباري بنودهُمْ","إِذا نُهدوا للغزو في الخَفَقانِ",68,"ن",1,0],["قلوبُ جحافلٍ ترضيك بطشاً","إذا دفعتْ صدورً وغىً تراح",69,"ح",1,0],["قُلوبُهُم صاعِداتٍ في مَدارِجِنا","حَرَّى، وَنحنُ إلى مَرقاكَ نَزدَلِفُ",70,"ف",1,0],["قلوبهمو ترفرف حول ربعي","وتلحظني البصائر باحترام",71,"م",1,0],["قُلوبُنا اتَّصلتْ غيباً وما انْفَصَلَتْ","ما زخرَفَتْ مثلَ بعضِ النَّاسِ أوفاقَا",72,"ق",2,0],["قُلوبُ الأولياءِ لها سُيوفٌ","وتَفْعَلُ فوقَ أفْعالِ السُّيوفِ",73,"ف",1,1],["قُلوبُ أَعدائِكَ البُهْتانُ أَقلقَها","وأنتَ قلبُكَ بالإِيمانِ مَسْرُورُ",74,"ر",1,0],["قلوبنا بين هجر منك أو صلة","يقتادها لك إعراض وإقبال",75,"ل",1,0],["قُلوبُنَا هَدَأت من بعدِ رَجفَتِها","واسترجَعت نومَها الأجفانُ والمُقَلُ",76,"ل",1,0],["قُلوبُنا سُيوفٌ","لِسِرِّنا أَغمادُ",77,"د",1,0],["قُلوبُ النَدامى في يَدَيها رَهينَةٌ","يَصيدونَها قَهراً وَتَقتُلُهُم مَكرا",78,"ر",2,0],["قلوب متى منه خلت فنفوسُ","لأحرف وسواس اللعين طروسُ",79,"س",1,1],["قلوبنا بك أبلتها النوى كمدا","ونحن قوم ضعاف صبرنا نفدا",80,"د",2,1],["قلوبٌ نحنُ تأسرُها قلوبُ","تُفرّقنا وتجمعُنا الدروبُ",81,"ب",1,1]]}