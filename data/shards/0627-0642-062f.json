956,"أمامَ جمالك","https://www.poetsgate.com/ViewPoem.aspx?id=182649",""],[5956,"نُقَّادٌ ومعجَبون","https://www.poetsgate.com/ViewPoem.aspx?id=185609",""],[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[5956,"الوسواس الخناس يحطِّم كبارَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192093",""],[5956,"إلهي هل لديك مزيدُ حب؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=192558",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[5956,"أقَدَّر أنك تأتي لزيارتي بغرفتي","https://www.poetsgate.com/ViewPoem.aspx?id=194119",""],[5956,"مروءةُ أهلِ الصعيد لديهِ","https://www.poetsgate.com/ViewPoem.aspx?id=204645",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[5986,"أقدم سيدي منك اعتذارا","https://www.poetsgate.com/ViewPoem.aspx?id=162954",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[6075,"أجمل الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=210327",""],[6097,"التّيه","https://www.poetsgate.com/ViewPoem.aspx?id=197427",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6115,"الا يازمان قام يلوي ذراعي لي","https://www.poetsgate.com/ViewPoem.aspx?id=196459",""],[520,"يهوى الحبيبين من بأس ومن كرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577609",""],[186,"تنبهوا واستفيقوا أيها العرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55739&r=&rc=2",""],[6186,"متجردٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82884&r=&rc=4",""],[6202,"هيهات هيهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86756&r=&rc=57",""],[6202,"يا بنت عشرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86765&r=&rc=66",""],[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""],[463,"رقَّ لبغدادَ القضاءُ والقدرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60077&r=&rc=133",""],[454,"نور العيون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82652&r=&rc=16",""]],"verses":[["أَقَدَمتُ إِقدامَ الَّذي","يَدنو وَشافِعُهُ مَكينُ",0,"ن",1,0],["إِقدامُ غَضبانَ كَظَّتهُ ضَغائِنُهُ","فَمالَ يَخلِطُ مَضروباً بِمَطعونِ",1,"ن",1,0],["أَقدَمَ لِلحَينِ وَيا رُبَّما","أَجلى الوَغى وَالغُنمُ لِلمُحجِمِ",2,"م",1,0],["أَقدَمَ مِن سِنانِهِ","إِذا الجَبانُ عَرَّدا",3,"د",2,0],["أُقَدِّمُ النَذرَ وَلي سَطوَةٌ","تُنَفِّرُ النَومَ عَنِ الراقِدِ",4,"د",1,0],["أَقَدُّها أَم طَرفُها أَم أَنا","ثَلاثَةٌ ما فيهِمُ صاحِ",5,"ح",1,0],["أقُدُّ بهِ قَوافيَ مُحْكَماتٍ","لأَرْوَعَ قُدَّ منْ سَلَفَيْ مَعَدِّ",6,"د",1,0],["أَقدِم كَما قَدِمَ الرَبيعُ الباكِرُ","وَاِطلُع كَما طَلَعَ الصَباحُ الزاهِرُ",7,"ر",1,1],["أقدم شكري وشكر الحضور","لأرباب هذا المضاف الرحيب",8,"ب",1,0],["أقدم فيه الوصف قبل أوانه","على ثقة منِّي بأنَّك مانح",9,"ح",1,0],["أقدِّم أطراساً وتمنح أنعماً","فمنِّيَ أوراق ومنك ثمار",10,"ر",1,0],["أقدم اسمي مصدراً في مديحه","ويفعل صوب الغيث ما هو فاعله",11,"ل",2,0],["أقدَّرت أني راغب فيك لائم","أبا حسن أم زاهد فيك عاذِرُ",12,"ر",1,0],["إقدامُهُ تضييعُهُ حِذرَه","من هوجٍ فيه ومن خبلِ",13,"ل",1,0],["أقدم الخائنُ اللعينُ عليها","وعلى الله أيَّما إقدام",14,"م",1,0],["أَقدِم أَبا الأَصبغ المَحبوبِ تلقَ فَتىً","هَشَّ المَوَدَّة لا يُزري بِهِ سأمُ",15,"م",1,0],["اقدر به من فاتح في فنه","القى اليه الفاتحون قيادا",16,"د",2,0],["أَقدَمتَ في العِشرينَ تَحتَ لِوائِهِ","وَرَوائِعُ الإِقدامِ في العِشرينا",17,"ن",2,0],["أَقدِم فَلَيسَ عَلى الإِقدامِ مُمتَنِعُ","وَاِصنَع بِهِ المَجدَ فَهوَ البارِعُ الصَنَعُ",18,"ع",1,1],["أقدمتَ إقدامَ المُدِلِّ ببأسِهِ","وتناكصُوا إنَّ اللئيمَ جَبَانُ",19,"ن",1,0],["أقداحُ ياقوتٍ لطافٌ أُتْرِعَتْ","راحاً فباتَ المِسْكُ سُؤرَ قرارِهَا",20,"ر",3,0],["إِقدامُ أَبيَضَ تَستَعلي مَناسِبُهُ","بِهِ إِلى مَلِكِ البَيضاءِ ذي التاجِ",21,"ج",1,0],["أقدمتَ تَفترِسُ الفوارسَ جُرأةً","فيه وقد هاب الرَّدَى أن يُقدِما",22,"م",2,0],["إقدامُ ذي نُذُرٍ بالسَّيفِ مُعتصِمٍ","ما شانَ إقدامَه كيدٌ ولا حِيَلُ",23,"ل",1,0],["أقدمتَ فيه تهُزُّ أسمرَ ذابلاً","لَدْناً لأرواحِ العِدا مُتَخَطِّفا",24,"ف",2,0],["أُقدُّم ما عِندَنا حاضِرٌ","وَإِن لَم يَكُن غَيرَ حُبزٍ وَخَل",25,"ل",1,0],["إِقدامَ عَمرٍو في سَماحَةِ حاتِمٍ","في حِلمِ أَحنَفَ في ذَكاءِ إِياسِ",26,"س",1,0],["أَقدَمتَ لَم تُرِكَ الحَمِيَّةُ مَصدَراً","عَنها وَلَم يَرَ فيكَ قِرنُكَ مَورِدا",27,"د",2,0],["أَقدِمْ عليُّ وسِرْ بالجندِ مُقتحِماً","لا تخلعِ النّقعَ حتّى تَلْبَسَ الظَّفَرا",28,"ر",2,0],["أقدِمْ فخذها يا أبيُّ سُقِيتَها","فانظرْ إلى السّاقِي ورَوعةِ جامِهِ",29,"م",2,0],["أَقدَمتَ حَتّى ظلَّ يَعجب واجِماً","جَيش مِن الأَيام حَولك محدقُ",30,"ق",1,0],["أَقدِم أَميرَ المُؤمِنينَ عَلى الرِضا","وَاِسلَم لِإِهلاكِ العَدوِّ المارِقِ",31,"ق",1,0],["أَقدِموا قَبلَ رِماحٍ أُشرِعَت","وَسُيوفٍ ذاتِ عَصٍّ وَصِعادِ",32,"د",1,0],["أقده بي وتجنب منه أربعةً","الجيدَ والخدَّ والألحاظَ والكفلا",33,"ل",2,0],["أقْدمَ إذ كاعَ كُلُّ ليثٍ","عن حَومةِ الموتِ إذْ رآها",34,"ا",3,0],["إقدامُ عمرٍو وبأسُ عنترةٍ","يعجزُ عن كيدهِ وعن حِيلِهْ",35,"ل",2,0],["أقدم فداكَ حديدها ولهيبها","واغنم مجادتها فأنت ربيبها",36,"ب",3,1],["أقدارهم في أوطان","لها البروج جدران",37,"ن",1,0],["أقدِّسُ فيك التقى والصلاحَ","أقدِّسُ فيك الخلاق الحميدا",38,"د",2,0],["أَقِدمْ؛ فإنِّي أرى الإقدامَ قد وَجَبَا","لا يحسِبُ الليثُ حُسبانًا إذا وَثَبَا",39,"ب",2,1],["اقدرت لي جلدا يقاوم نكبتي","فاليوم لا جلدي ولا أقداري",40,"ر",2,0],["أقدمت أظنّ بلا ظن","وبدون يقين أتيقّن",41,"ن",1,0],["أُقدِّمُ ما عِنْدَنا حاضِرا","وإن لم يكن غير خبز وخل",42,"ل",1,0],["أقدَمتَ إقدامَ من لا الخوفُ يمنَعُهُ","ولا يُنَهنِهُ مِن تَصميمهِ الخطر",43,"ر",1,0],["أقدِمْ فأنتَ على الإقدامِ مُنطَبِعٌ","وأبطُشْ فأنت على التنكيل مُقتدر",43,"ر",1,0],["إقدامُهُ تضبيعهُ حذره","من هوجٍ فيه ومن خبلِ",44,"ل",1,0],["اقدِمتُم سالمين والمجدُ مق","صورٌ عليكُم والفضلُ مشتركُ",45,"ك",1,0],["أُقَدِّمُ العودَ قُدّامي فَأَتبَعُهُ","وَقَد أَراني وَلا يَمشي بِيَ العَودُ",46,"د",1,1],["أَقدَمتَ أَمنَعَ مُقدِمٍ وَغَنِمتَ أَو","فى مَغنَمٍ وَقَدِمتَ أَسعَدَ مَقدَمِ",47,"م",1,0],["أَقدَمتَ حَتّى لَم تَجِد مُتَقَدَّماً","وَهَمَمتَ حَتّى ما تَرَكتَ هُماما",48,"م",2,0],["إقدامُ عمرو في سماحةِ حاتمٍ","في حلمِ أحنفَ في دهاءِ زيادِ",49,"د",1,0],["إِقدامُ جَسّاسٍ وَعِزَّةُ هانِئٍ","وَعَفافُ بِسطامٍ وَنَفسُ عِصامِ",50,"م",1,0],["أَقدارُكُم في عُيونِ التُّركِ نازلَة","وَحَقَكُم بَينَ أَيدي التُّرك مُغتَصَبُ",51,"ب",1,0],["أقَدِرْتُم فَظَلَمْتُم مَنْ رَنَا","دُونَ جُرْم وحَرَمْتُم مَنْ رَجا",52,"ج",2,0],["اِقدَح زِنادَ السُرورَ بِالقَدَحِ","وَالمَح بِهِ ما تَشاءُ مِن مُلَحِ",53,"ح",1,1],["أقدم بالنيابة ذا فاما","فداءاً أو فعفوا من عطوف",54,"ف",1,0],["أقدمتَ حيث ارتاع كلُّ مفوَّهٍ","قد يركب الأَمرَ المخوفَ غلام",55,"م",1,0],["أُقَدِّمُهُ يَجوبُ بِيَ الحُدابى","عَلى ثَبَجٍ مِنَ الظَلماءِ جَرشِ",56,"ش",1,0],["أَقَدْ رأى الغَيثُ أَبَرَّ نائلاً","منهُ وأَحْلَى منهُ في مَذاقهِ",57,"ق",2,0],["أَقُدُّ أديمَ البيدِ بالسّيرِ حيثما","وجَدْتُ وراءَ العِزِّ في الأرضِ مَنسَغا",58,"غ",2,0],["أقدِمْ على الموتِ تَعِشْ فإنّما","يومُ الفتى مسُتطَرٌ ومُكتَتَب",59,"ب",1,0],["أُقَدّمُهُ وَيَحميهِ عَبوسٌ","على أَكتادِهِ كُرهُ اللِّمامِ",60,"م",1,0],["أقدمت إقدام شيطانٍ على رجلٍ","برٍّ تقيٍّ سما في أرفع الرتب",61,"ب",1,0],["إقدح بذكرهُم زِنَادَ صبابتي","إن شئت تنظر نار شوقي تلمع",62,"ع",1,0],["إِقدام حَيدَرَةٍ وَبأس مُحَمَّدٍ","فيهِ وَلا يعدوهما أَبواهُ",63,"ا",2,0],["أقدامه يُنسي ربي","عةَ يا ربيعُ فتى مكدَّمْ",64,"م",1,0],["أقْدَمتَ دونَ مَعالِم الإسلامِ","فاقْدَمْ بخيرِ تحية وسَلامِ",65,"م",1,1],["أقدم ففي الإقدام عزة موطن","فالنصر للثوار للأحرار",66,"ر",1,0],["أقدس فيك أخلاقا عذاب","وحسنا صيغ من ماء اللجين",67,"ن",1,0],["أقدس شأن الحب في كل موطن","ولا خير في قلب له لا يقدس",68,"س",1,0],["أقدام ذي لبدٍ وهمةُ أَعْصَمٍ","وإباءُ بازي ويقظة أجْدل",69,"ل",1,0],["أقدمت حتى غروب البيض في حسد","وجُدْت حتى قطار السحب في خجل",70,"ل",1,0],["أقدمت من بعد إحجامي تحلق بي","في الشعر خاطرة توحي بإنشاد",71,"د",1,0],["إِقدامها بِبَأسِها الشَديدِ","أَسكَنَها في قَفَصِ الحَديدِ",72,"د",1,0],["أقدمت وحدك إقدام الليوث على","هول يمهد عذر الليث في الهرب",73,"ب",1,0],["أقدمت فيه ونار الموت جامحة","وخضت بحر بلاياه ولم تبل",74,"ل",1,0],["أقدّرُه المُسالِمَ وهو حَرْبٌ","