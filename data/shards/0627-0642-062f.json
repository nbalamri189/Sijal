{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"لو علمت أي فتى ماجد","https://www.aldiwan.net/poem30613.html","السريع"],[63,"زارت سليمى والخطا يقتفي","https://www.aldiwan.net/poem45801.html","السريع"],[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[73,"أقدم كما قدم الربيع الباكر","https://www.aldiwan.net/poem11942.html","الكامل"],[93,"بوحي الطعام وإذن المدام","https://www.aldiwan.net/poem9779.html","عموديه"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[72,"كذا أبدا يا أرفع الناس همة","https://www.aldiwan.net/poem18890.html","الطويل"],[72,"وأزهر وضاح الصفات عليها","https://www.aldiwan.net/poem19563.html","الطويل"],[51,"ألا ليت شعري حين أخلفت موعدي","https://www.aldiwan.net/poem62968.html","الطويل"],[51,"وفارس ما شئت من فارس","https://www.aldiwan.net/poem65880.html","السريع"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[78,"أهلا بكم صحبتكم نحوي الديم","https://www.aldiwan.net/poem14185.html","البسيط"],[89,"أبدى يمثل يوسف واعادا","https://www.aldiwan.net/poem44753.html","الكامل"],[85,"أوحت لطرفك فاستهل شؤونا","https://www.aldiwan.net/poem8112.html","الكامل"],[85,"أقدم فليس على الإقدام ممتنع","https://www.aldiwan.net/poem63762.html","البسيط"],[62,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[62,"وترى شقائقها خلال رياضها","https://www.aldiwan.net/poem52400.html","الكامل"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[61,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[61,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[61,"هذي المعارف منهم فتعرفا","https://www.aldiwan.net/poem51553.html","الكامل"],[58,"فداري مناخ لمن قد نزل","https://www.aldiwan.net/poem30903.html","المتقارب"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[105,"ناج الشهيد وحدث بعده الأثرا","https://www.aldiwan.net/poem42131.html","البسيط"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[102,"وجه القضية من جهادك مشرق","https://www.aldiwan.net/poem32989.html","الكامل"],[52,"قرب الحبيب إلى المحب الوامق","https://www.aldiwan.net/poem26806.html","الكامل"],[52,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[75,"يا مصلت السيف لا تطلب به بدلا","https://www.aldiwan.net/poem69006.html","البسيط"],[76,"ورب ملتفة العوالي","https://www.aldiwan.net/poem38859.html","مخلع البسيط"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[100,"لص تحت الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=50429",""],[58,"فداري مُناخٌ لِمَنْ قَدْ نَزَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=22770",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[51,"وفارسٍ ما شئْتَ من فارسٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30213",""],[51,"حَيَّتْكَ عنّي السُّعودُ والفلك","https://www.poetsgate.com/ViewPoem.aspx?id=30007",""],[131,"أقدم العود قدامي فأتبعه","https://www.aldiwan.net/poem24156.html","البسيط"],[143,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[143,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[166,"غر الأعادي منه رونق بشره","https://www.aldiwan.net/poem47097.html","الكامل"],[169,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[182,"تنبهوا واستفيقوا أيها العرب","https://www.aldiwan.net/poem67087.html","البسيط"],[275,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[282,"اقدح زناد السرور بالقدح","https://www.aldiwan.net/poem32826.html","المنسرح"],[285,"لأنس بين زيتون وزرع","https://www.aldiwan.net/poem39384.html","الوافر"],[298,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[322,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[348,"حلم الوزير أحمد أفرط أو","https://www.aldiwan.net/poem20442.html","الرجز"],[364,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[364,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[365,"خليل لم أهبه من قلاه","https://www.aldiwan.net/poem44480.html","الوافر"],[377,"السيف والحيف في حرب وفي حربِ","https://www.aldiwan.net/poem66948.html","البسيط"],[403,"لا والغرام وما تجن الأضلع","https://www.aldiwan.net/poem33683.html","الكامل"],[406,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[432,"مولاي أمرك قد تقدم","https://www.aldiwan.net/poem12729.html","مجزوء الكامل"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[449,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[449,"أفكر فيك يا نور العيون","https://www.aldiwan.net/poem1004.html",""],[449,"العبور","https://www.aldiwan.net/poem1007.html",""],[461,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[461,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[479,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[493,"من منصفي من محكم الكتاب","https://www.aldiwan.net/poem67302.html","الرجز"],[515,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[551,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"]],"verses":[["أَقَدَمتُ إِقدامَ الَّذي","يَدنو وَشافِعُهُ مَكينُ",0,"ن",1,0],["إِقدامُ غَضبانَ كَظَّتهُ ضَغائِنُهُ","فَمالَ يَخلِطُ مَضروباً بِمَطعونِ",1,"ن",1,0],["أَقدَمَ لِلحَينِ وَيا رُبَّما","أَجلى الوَغى وَالغُنمُ لِلمُحجِمِ",2,"م",1,0],["أَقدَمَ مِن سِنانِهِ","إِذا الجَبانُ عَرَّدا",3,"د",2,0],["أُقَدِّمُ النَذرَ وَلي سَطوَةٌ","تُنَفِّرُ النَومَ عَنِ الراقِدِ",4,"د",1,0],["أَقَدُّها أَم طَرفُها أَم أَنا","ثَلاثَةٌ ما فيهِمُ صاحِ",5,"ح",1,0],["أقُدُّ بهِ قَوافيَ مُحْكَماتٍ","لأَرْوَعَ قُدَّ منْ سَلَفَيْ مَعَدِّ",6,"د",1,0],["أَقدِم كَما قَدِمَ الرَبيعُ الباكِرُ","وَاِطلُع كَما طَلَعَ الصَباحُ الزاهِرُ",7,"ر",1,1],["أقدم شكري وشكر الحضور","لأرباب هذا المضاف الرحيب",8,"ب",1,0],["أقدم فيه الوصف قبل أوانه","على ثقة منِّي بأنَّك مانح",9,"ح",1,0],["أقدِّم أطراساً وتمنح أنعماً","فمنِّيَ أوراق ومنك ثمار",10,"ر",1,0],["أقدم اسمي مصدراً في مديحه","ويفعل صوب الغيث ما هو فاعله",11,"ل",2,0],["أقدَّرت أني راغب فيك لائم","أبا حسن أم زاهد فيك عاذِرُ",12,"ر",1,0],["إقدامُهُ تضييعُهُ حِذرَه","من هوجٍ فيه ومن خبلِ",13,"ل",1,0],["أقدم الخائنُ اللعينُ عليها","وعلى الله أيَّما إقدام",14,"م",1,0],["أَقدِم أَبا الأَصبغ المَحبوبِ تلقَ فَتىً","هَشَّ المَوَدَّة لا يُزري بِهِ سأمُ",15,"م",1,0],["اقدر به من فاتح في فنه","القى اليه الفاتحون قيادا",16,"د",2,0],["أَقدَمتَ في العِشرينَ تَحتَ لِوائِهِ","وَرَوائِعُ الإِقدامِ في العِشرينا",17,"ن",2,0],["أَقدِم فَلَيسَ عَلى الإِقدامِ مُمتَنِعُ","وَاِصنَع بِهِ المَجدَ فَهوَ البارِعُ الصَنَعُ",18,"ع",1,1],["أقدمتَ إقدامَ المُدِلِّ ببأسِهِ","وتناكصُوا إنَّ اللئيمَ جَبَانُ",19,"ن",1,0],["أقداحُ ياقوتٍ لطافٌ أُتْرِعَتْ","راحاً فباتَ المِسْكُ سُؤرَ قرارِهَا",20,"ر",3,0],["إِقدامُ أَبيَضَ تَستَعلي مَناسِبُهُ","بِهِ إِلى مَلِكِ البَيضاءِ ذي التاجِ",21,"ج",1,0],["أقدمتَ تَفترِسُ الفوارسَ جُرأةً","فيه وقد هاب الرَّدَى أن يُقدِما",22,"م",2,0],["إقدامُ ذي نُذُرٍ بالسَّيفِ مُعتصِمٍ","ما شانَ إقدامَه كيدٌ ولا حِيَلُ",23,"ل",1,0],["أقدمتَ فيه تهُزُّ أسمرَ ذابلاً","لَدْناً لأرواحِ العِدا مُتَخَطِّفا",24,"ف",2,0],["أُقدُّم ما عِندَنا حاضِرٌ","وَإِن لَم يَكُن غَيرَ حُبزٍ وَخَل",25,"ل",1,0],["إِقدامَ عَمرٍو في سَماحَةِ حاتِمٍ","في حِلمِ أَحنَفَ في ذَكاءِ إِياسِ",26,"س",1,0],["أَقدَمتَ لَم تُرِكَ الحَمِيَّةُ مَصدَراً","عَنها وَلَم يَرَ فيكَ قِرنُكَ مَورِدا",27,"د",2,0],["أَقدِمْ عليُّ وسِرْ بالجندِ مُقتحِماً","لا تخلعِ النّقعَ حتّى تَلْبَسَ الظَّفَرا",28,"ر",2,0],["أقدِمْ فخذها يا أبيُّ سُقِيتَها","فانظرْ إلى السّاقِي ورَوعةِ جامِهِ",29,"م",2,0],["أَقدَمتَ حَتّى ظلَّ يَعجب واجِماً","جَيش مِن الأَيام حَولك محدقُ",30,"ق",1,0],["أَقدِم أَميرَ المُؤمِنينَ عَلى الرِضا","وَاِسلَم لِإِهلاكِ العَدوِّ المارِقِ",31,"ق",1,0],["أَقدِموا قَبلَ رِماحٍ أُشرِعَت","وَسُيوفٍ ذاتِ عَصٍّ وَصِعادِ",32,"د",1,0],["أقده بي وتجنب منه أربعةً","الجيدَ والخدَّ والألحاظَ والكفلا",33,"ل",2,0],["أقْدمَ إذ كاعَ كُلُّ ليثٍ","عن حَومةِ الموتِ إذْ رآها",34,"ا",3,0],["إقدامُ عمرٍو وبأسُ عنترةٍ","يعجزُ عن كيدهِ وعن حِيلِهْ",35,"ل",2,0],["أقدم فداكَ حديدها ولهيبها","واغنم مجادتها فأنت ربيبها",36,"ب",3,1],["أقدارهم في أوطان","لها البروج جدران",37,"ن",1,0],["أقدِّسُ فيك التقى والصلاحَ","أقدِّسُ فيك الخلاق الحميدا",38,"د",2,0],["أَقِدمْ؛ فإنِّي أرى الإقدامَ قد وَجَبَا","لا يحسِبُ الليثُ حُسبانًا إذا وَثَبَا",39,"ب",2,1],["أقدمت أظنّ بلا ظن","وبدون يقين أتيقّن",40,"ن",1,0],["أُقدِّمُ ما عِنْدَنا حاضِرا","وإن لم يكن غير خبز وخل",41,"ل",1,0],["أقدَمتَ إقدامَ من لا الخوفُ يمنَعُهُ","ولا يُنَهنِهُ مِن تَصميمهِ الخطر",42,"ر",1,0],["أقدِمْ فأنتَ على الإقدامِ مُنطَبِعٌ","وأبطُشْ فأنت على التنكيل مُقتدر",42,"ر",1,0],["إقدامُهُ تضبيعهُ حذره","من هوجٍ فيه ومن خبلِ",43,"ل",1,0],["اقدِمتُم سالمين والمجدُ مق","صورٌ عليكُم والفضلُ مشتركُ",44,"ك",1,0],["أُقَدِّمُ العودَ قُدّامي فَأَتبَعُهُ","وَقَد أَراني وَلا يَمشي بِيَ العَودُ",45,"د",1,1],["أَقدَمتَ أَمنَعَ مُقدِمٍ وَغَنِمتَ أَو","فى مَغنَمٍ وَقَدِمتَ أَسعَدَ مَقدَمِ",46,"م",1,0],["أَقدَمتَ حَتّى لَم تَجِد مُتَقَدَّماً","وَهَمَمتَ حَتّى ما تَرَكتَ هُماما",47,"م",2,0],["إقدامُ عمرو في سماحةِ حاتمٍ","في حلمِ أحنفَ في دهاءِ زيادِ",48,"د",1,0],["إِقدامُ جَسّاسٍ وَعِزَّةُ هانِئٍ","وَعَفافُ بِسطامٍ وَنَفسُ عِصامِ",49,"م",1,0],["أَقدارُكُم في عُيونِ التُّركِ نازلَة","وَحَقَكُم بَينَ أَيدي التُّرك مُغتَصَبُ",50,"ب",1,0],["أقَدِرْتُم فَظَلَمْتُم مَنْ رَنَا","دُونَ جُرْم وحَرَمْتُم مَنْ رَجا",51,"ج",2,0],["اِقدَح زِنادَ السُرورَ بِالقَدَحِ","وَالمَح بِهِ ما تَشاءُ مِن مُلَحِ",52,"ح",1,1],["أقدم بالنيابة ذا فاما","فداءاً أو فعفوا من عطوف",53,"ف",1,0],["أقدمتَ حيث ارتاع كلُّ مفوَّهٍ","قد يركب الأَمرَ المخوفَ غلام",54,"م",1,0],["أُقَدِّمُهُ يَجوبُ بِيَ الحُدابى","عَلى ثَبَجٍ مِنَ الظَلماءِ جَرشِ",55,"ش",1,0],["أَقَدْ رأى الغَيثُ أَبَرَّ نائلاً","منهُ وأَحْلَى منهُ في مَذاقهِ",56,"ق",2,0],["أَقُدُّ أديمَ البيدِ بالسّيرِ حيثما","وجَدْتُ وراءَ العِزِّ في الأرضِ مَنسَغا",57,"غ",2,0],["أقدِمْ على الموتِ تَعِشْ فإنّما","يومُ الفتى مسُتطَرٌ ومُكتَتَب",58,"ب",1,0],["أُقَدّمُهُ وَيَحميهِ عَبوسٌ","على أَكتادِهِ كُرهُ اللِّمامِ",59,"م",1,0],["أقدمت إقدام شيطانٍ على رجلٍ","برٍّ تقيٍّ سما في أرفع الرتب",60,"ب",1,0],["إقدح بذكرهُم زِنَادَ صبابتي","إن شئت تنظر نار شوقي تلمع",61,"ع",1,0],["إِقدام حَيدَرَةٍ وَبأس مُحَمَّدٍ","فيهِ وَلا يعدوهما أَبواهُ",62,"ا",2,0],["أقدامه يُنسي ربي","عةَ يا ربيعُ فتى مكدَّمْ",63,"م",1,0],["أقْدَمتَ دونَ مَعالِم الإسلامِ","فاقْدَمْ بخيرِ تحية وسَلامِ",64,"م",1,1],["أقدم ففي الإقدام عزة موطن","فالنصر للثوار للأحرار",65,"ر",1,0],["أقدس فيك أخلاقا عذاب","وحسنا صيغ من ماء اللجين",66,"ن",1,0],["أقدس شأن الحب في كل موطن","ولا خير في قلب له لا يقدس",67,"س",1,0],["أقدام ذي لبدٍ وهمةُ أَعْصَمٍ","وإباءُ بازي ويقظة أجْدل",68,"ل",1,0],["أقدمت حتى غروب البيض في حسد","وجُدْت حتى قطار السحب في خجل",69,"ل",1,0],["أقدمت من بعد إحجامي تحلق بي","في الشعر خاطرة توحي بإنشاد",70,"د",1,0],["إِقدامها بِبَأسِها الشَديدِ","أَسكَنَها في قَفَصِ الحَديدِ",71,"د",1,0],["أقدمت وحدك إقدام الليوث على","هول يمهد عذر الليث في الهرب",72,"ب",1,0],["أقدمت فيه ونار الموت جامحة","وخضت بحر بلاياه ولم تبل",73,"ل",1,0],["أقدّرُه المُسالِمَ وهو حَرْبٌ","وأحسبُهُ بعيداً وهو دانِ",74,"ن",1,0],["أَقدَمتَ وَالمُهَجاتُ تُلفَظُ وَالرَدى","مُتَحَيِّرٌ بَينَ الأَسِنَّةِ مُهتَدِ",75,"د",1,0]]}