{"poems":[[53,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[86,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[35,"ما عناك الغداة من أطلال","https://www.aldiwan.net/poem39094.html","الخفيف"],[93,"فداحة الخطب أبكتني عليك دماً","https://www.aldiwan.net/poem11349.html","البسيط"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[85,"يا شباب اقتدوا بشيخ المعالى","https://www.aldiwan.net/poem7043.html","الخفيف"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[45,"لك في المجد أول وأخير","https://www.aldiwan.net/poem63574.html","الخفيف"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[45,"بقومي جمعا لا أحاشي ولا أكني","https://www.aldiwan.net/poem66812.html","الطويل"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[49,"حزنت لموت زائدة بن معن","https://www.aldiwan.net/poem65341.html","الوافر"],[66,"حي الرفاق وطف بكأس الراح","https://www.aldiwan.net/poem38496.html","الكامل"],[66,"يا سمي الذي به اتهم الذئ","https://www.aldiwan.net/poem39533.html","الخفيف"],[66,"سفها إذا شقت عليك جيوب","https://www.aldiwan.net/poem40296.html","الكامل"],[66,"ما زال ظل نداك شامل","https://www.aldiwan.net/poem40954.html","مجزوء الكامل"],[66,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[87,"أنا في الدهر ضائع بين فهم","https://www.aldiwan.net/poem8265.html","الخفيف"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[105,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[105,"طلحة الخير طلحة الجود أبشر","https://www.aldiwan.net/poem44024.html","الخفيف"],[102,"برقت له مسنونة تتلهب","https://www.aldiwan.net/poem33042.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[48,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85546","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42712","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54913","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[99,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""],[51,"حزني منكِ يا بنة الأملاك","https://www.poetsgate.com/ViewPoem.aspx?id=30075",""]],"verses":[["حَزّاً إِلى المَجدِ مِن أَزِمَّتِها","لَيسَ كَحَزِّ الأَعاجِزِ الظُعُنا",0,"ن",2,0],["حِزْبُ النّبيّ الأُلَى إنْ روْعةٌ دهَمَتْ","مِلْءَ الفَضا لمْ تهِنْ ذَرْعاً ولم تضِقِ",1,"ق",1,0],["حَزِنَت عَلَيهِ عُقولُنا وَقُلوبُنا","وَبَكَت وَحُزنُ العَقلِ شَرُّ مُصابِ",2,"ب",1,0],["حَزِنَ العِلمُ يَومَ مِتَّ وَلَكِن","أَمِنَ الدينُ صَيحَةَ المُرتابِ",3,"ب",1,0],["حُزِيَت لي بِحَزمِ فَيدَةَ تُحدى","كَاليَهودِيِّ مِن نَطاةِ الرِقالِ",4,"ل",1,0],["حُزْنِي كَحُزْنِكُمُ لَكِنَّ لِي أَمَلاً","فِيكُمُ يُلَطِّفُ حُزْنَ النَّفْسِ وَالأَلَمَا",5,"م",2,0],["حُزاوِيَّةٌ أَو عَوهَجٌ مَعقُلِيَّةٍ","تَرودُ بِأَعطافِ الرِمالِ الحَرائِرِ",6,"ر",1,0],["حزتَ المحامِد حتَّى ما لِذي شرفٍ","من صورةِ الحمدِ لا جسمٌ ولا ذات",7,"ت",1,0],["حزني منكِ يا ابنة الأملاكِ","أيُّ ذلٍّ لقيتُه في هواكِ",8,"ك",1,1],["حزت حينا تجلة واحتراماً","وتألمت للمصائب حينا",9,"ن",2,0],["حزَنَته بلاده وهي صيد","بين نابى مظَّفر الناب ورد",10,"د",1,0],["حُزنَ مُستَعمَلَ الكَلامٍ اِختِياراً","وَتَجَنَّبنَ ظُلمَةَ التَعقيدِ",11,"د",1,0],["حُزتَ ميراثَهُ بِحَقٍّ مُبينٍ","كُلُّ حَقٍّ سِواهُ إِفكٌ وَزورُ",12,"ر",1,0],["حُزتَ العُلا سَبقاً وَصَلّى ثانِياً","ثُمَّ اِستَوَت مِن بَعدِهِ الأَقدامُ",13,"م",1,0],["حُزونَةُ أَيّامٍ مَرَرنَ بِهَضبَةٍ","فَأَقلَعنَ مِثلَ المارِنِ اللَيِّنِ اللَدنِ",14,"ن",1,0],["حَزماً وَبِرّاً لِلإِلَهِ وَشيمَةً","تَعفو عَلى خُلُقِ المُسيءِ المُفسِدِ",15,"د",1,0],["حَزِنتُ لِمَوتِ زائِدَةَ بنَ مَعنٍ","حَقيقٌ أَن يَطولُ عَلَيهِ حُزني",16,"ي",1,1],["حُزنا السُرورَ بِها وَبِتنا نَجتَلي","بِنتَ الكُرومِ بِغَيرِ عَقدِ نِكاحِ",17,"ح",1,0],["حَزمٌ فَتَحتَ بِهِ الأُمورَ وَإِنَّها","كَالقُفلِ مُحتاجُ إِلى المِفتاحِ",17,"ح",1,0],["حُزتَ أَضعافَ حُسنِهِ وَتَمَيَّز","تَ عَليهِ بِكُلِّ مَعنىً مَحوزِ",18,"ز",1,0],["حُزتَ المَحامِدَ بِالمَكارِمِ مَيِّتاً","فَغَدا لَكَ التَأبينُ لا التَأنيبُ",19,"ب",1,0],["حُزتَ العُلى وَالجودَ يا","رَبَّ الفَضائِلِ وَالفَواضِل",20,"ل",1,0],["حُزتَ العُلى فَدَعاكَ الناسُ سَيِّدَهُمُ","وَالكَأسُ لَولا الحُمَيّا سُمِّيَت قَدَحا",21,"ح",2,0],["حُزنٌ غَداةَ الحَزنِ هاجَ غَليلَهُ","في أَبرَقِ الحَنّانِ مِنكَ حَنينُ",22,"ن",1,0],["حُزْتُ عِلْمَاً وَمَا رُزِقْتُ قَبُولاً","فَكَأَنِّي مَجَلَّةُ الأَحْكَامِ",23,"م",1,0],["حزبُ النّجاةِ أعدَّ أفضلَ عُدَّةٍ","واستنَّ أقومَ سُنّةٍ وسبيلِ",24,"ل",1,0],["حِزبٌ من الشُّمِّ يهوي عن جوانبِه","مَن كدَّ يطمعُ أن ينهارَ أو كدحا",25,"ح",2,0],["حَزَبَتْهُ الأمورُ في طاعةِ الل","هِ فما هَمَّ مَرّةً باعتراضِ",26,"ض",1,0],["حَزَّتْ فلا خد الحديدِ مخضَّبٌ","بدمٍ ولا نحرُ الذبيح مخضًّب",27,"ب",1,0],["حُزْتُمْ عظيماً مِنْ تُراثِ نُبُوَّةٍ","ما كان دونكُم لها مَنْ يَحجُبُ",28,"ب",1,0],["حِزْبُ الإمامِ منَ الوَرَى حِزْبي إذا","عُدّوا وخُلصانُ الهدَى خُلصاني",29,"ن",2,0],["حُزْتَ الكمالَ ففيكَ معنىً مُشكلٌ","يَنْبو بيانُ القوْلِ عن تَبيينه",30,"ن",2,0],["حَزَوَّرٍ ذي ذَنَبٍ قَصيرِ","مِن مُزجَلٍ أُرسِلَ في البُحورِ",31,"ر",1,0],["حَزْنُ المَضاجِع لا نَفَاذَ لِبَثّه","حُزْناً بذاك قَضى القضاءُ نَفاذا",32,"ذ",2,0],["حزب على خلفة الأديان متحد","كأَنه لم يكن قبلاً بأمشاج",33,"ج",1,0],["حزنت عليك أماثل وأفاضل","وبكاك صحب منهم ورفاق",34,"ق",1,0],["حَزَني على سَرَواتِها ورُواتِها","وثِقاتِها وحُماتِها يَتَكَرَّرُ",35,"ر",1,0],["حُزْنٌ بَرَانِي وَأَشْوَاقٌ رَعَتْ كَبِدِي","يَا وَيْحَ نَفْسِيَ مِنْ حُزْنٍ وَأَشْوَاقِ",36,"ق",1,0],["حُزْناً عَلى ذَاكَ الجَرِيحِ الَّذي","يَجِفُّ سُقْماً فِي الصبَا الأَنْضَرِ",37,"ر",1,0],["حزْمُهُ عَلَّمَ الضَّعِيفَ إِذا اسْتَبْصَرَ","أَنَّى بِالحَزمِ يَغْدُو قَدِيرَا",38,"ر",2,0],["حُزْنٌ بَعِيدُ الغَوْرِ فِي قَلْبِي فَإِنْ","وَجَبَ الرِّثَاءُ فَإِنِّمَا يُرْثَى لِي",39,"ل",2,0],["حزته تاج المعم المخول","لك نصف الناس لو تنهضهم",40,"م",1,0],["حُز وَديعاتِ وَداعي","أَنا غيلان بِحَزوى",41,"و",2,0],["حَزَّبَ الإِخوَةَ مِنهُم بِعُلاً","نافَسَت نَبهانُ فيهُنَّ ثَعَل",42,"ل",1,0],["حزبان: ذاك على أرا","ئكه، وذلك في ارتقاب",43,"ب",1,0],["حزبيَّة قامت على","أُس من الشهَّوَات ناب",43,"ب",1,0],["حزناً ليومَ أبي محمدَ إنّهُ","يومٌ على يومِ الحسابِ يطول",44,"ل",1,0],["حزني بنفسجة يبللها الندى","وضفاف جرحي روضة معشاب",45,"ب",1,0],["حزني منكِ يا بنة الأملاك","أيُّ ذلّ لقيتُه في هواكِ",46,"ك",1,1]]}