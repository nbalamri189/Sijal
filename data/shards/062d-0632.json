 يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[403,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[413,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[413,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[413,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[413,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[429,"يا أيها الملك الذي","https://www.aldiwan.net/poem12537.html","مجزوء الكامل"],[431,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[441,"لا تقل عجزا فأنت المعجز","https://www.aldiwan.net/poem55805.html","الرمل"],[459,"حزت المكارم والعلى","https://www.aldiwan.net/poem16153.html","مجزوء الكامل"],[461,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[462,"حزت الزمان بتسطيري مديحك","https://www.aldiwan.net/poem3555.html","عموديه"],[477,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[498,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[498,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[512,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[513,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[536,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[549,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[560,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[560,"لمن المضارب في ظلال الوادي","https://www.aldiwan.net/poem52867.html","الكامل"],[560,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[565,"حان أن تستحي الأسقام","https://www.aldiwan.net/poem69644.html","مجزوء الرجز"]],"verses":[["حَزّاً إِلى المَجدِ مِن أَزِمَّتِها","لَيسَ كَحَزِّ الأَعاجِزِ الظُعُنا",0,"ن",2,0],["حِزْبُ النّبيّ الأُلَى إنْ روْعةٌ دهَمَتْ","مِلْءَ الفَضا لمْ تهِنْ ذَرْعاً ولم تضِقِ",1,"ق",1,0],["حَزِنَت عَلَيهِ عُقولُنا وَقُلوبُنا","وَبَكَت وَحُزنُ العَقلِ شَرُّ مُصابِ",2,"ب",1,0],["حَزِنَ العِلمُ يَومَ مِتَّ وَلَكِن","أَمِنَ الدينُ صَيحَةَ المُرتابِ",3,"ب",1,0],["حُزِيَت لي بِحَزمِ فَيدَةَ تُحدى","كَاليَهودِيِّ مِن نَطاةِ الرِقالِ",4,"ل",1,0],["حُزْنِي كَحُزْنِكُمُ لَكِنَّ لِي أَمَلاً","فِيكُمُ يُلَطِّفُ حُزْنَ النَّفْسِ وَالأَلَمَا",5,"م",2,0],["حُزاوِيَّةٌ أَو عَوهَجٌ مَعقُلِيَّةٍ","تَرودُ بِأَعطافِ الرِمالِ الحَرائِرِ",6,"ر",1,0],["حزتَ المحامِد حتَّى ما لِذي شرفٍ","من صورةِ الحمدِ لا جسمٌ ولا ذات",7,"ت",1,0],["حزني منكِ يا ابنة الأملاكِ","أيُّ ذلٍّ لقيتُه في هواكِ",8,"ك",1,1],["حزت حينا تجلة واحتراماً","وتألمت للمصائب حينا",9,"ن",2,0],["حزَنَته بلاده وهي صيد","بين نابى مظَّفر الناب ورد",10,"د",1,0],["حُزنَ مُستَعمَلَ الكَلامٍ اِختِياراً","وَتَجَنَّبنَ ظُلمَةَ التَعقيدِ",11,"د",1,0],["حُزتَ ميراثَهُ بِحَقٍّ مُبينٍ","كُلُّ حَقٍّ سِواهُ إِفكٌ وَزورُ",12,"ر",1,0],["حُزتَ العُلا سَبقاً وَصَلّى ثانِياً","ثُمَّ اِستَوَت مِن بَعدِهِ الأَقدامُ",13,"م",1,0],["حُزونَةُ أَيّامٍ مَرَرنَ بِهَضبَةٍ","فَأَقلَعنَ مِثلَ المارِنِ اللَيِّنِ اللَدنِ",14,"ن",1,0],["حَزماً وَبِرّاً لِلإِلَهِ وَشيمَةً","تَعفو عَلى خُلُقِ المُسيءِ المُفسِدِ",15,"د",1,0],["حَزِنتُ لِمَوتِ زائِدَةَ بنَ مَعنٍ","حَقيقٌ أَن يَطولُ عَلَيهِ حُزني",16,"ي",1,1],["حُزنا السُرورَ بِها وَبِتنا نَجتَلي","بِنتَ الكُرومِ بِغَيرِ عَقدِ نِكاحِ",17,"ح",1,0],["حَزمٌ فَتَحتَ بِهِ الأُمورَ وَإِنَّها","كَالقُفلِ مُحتاجُ إِلى المِفتاحِ",17,"ح",1,0],["حُزتَ أَضعافَ حُسنِهِ وَتَمَيَّز","تَ عَليهِ بِكُلِّ مَعنىً مَحوزِ",18,"ز",1,0],["حُزتَ المَحامِدَ بِالمَكارِمِ مَيِّتاً","فَغَدا لَكَ التَأبينُ لا التَأنيبُ",19,"ب",1,0],["حُزتَ العُلى وَالجودَ يا","رَبَّ الفَضائِلِ وَالفَواضِل",20,"ل",1,0],["حُزتَ العُلى فَدَعاكَ الناسُ سَيِّدَهُمُ","وَالكَأسُ لَولا الحُمَيّا سُمِّيَت قَدَحا",21,"ح",2,0],["حُزنٌ غَداةَ الحَزنِ هاجَ غَليلَهُ","في أَبرَقِ الحَنّانِ مِنكَ حَنينُ",22,"ن",1,0],["حُزْتُ عِلْمَاً وَمَا رُزِقْتُ قَبُولاً","فَكَأَنِّي مَجَلَّةُ الأَحْكَامِ",23,"م",1,0],["حزبُ النّجاةِ أعدَّ أفضلَ عُدَّةٍ","واستنَّ أقومَ سُنّةٍ وسبيلِ",24,"ل",1,0],["حِزبٌ من الشُّمِّ يهوي عن جوانبِه","مَن كدَّ يطمعُ أن ينهارَ أو كدحا",25,"ح",2,0],["حَزَبَتْهُ الأمورُ في طاعةِ الل","هِ فما هَمَّ مَرّةً باعتراضِ",26,"ض",1,0],["حَزَّتْ فلا خد الحديدِ مخضَّبٌ","بدمٍ ولا نحرُ الذبيح مخضًّب",27,"ب",1,0],["حُزْتُمْ عظيماً مِنْ تُراثِ نُبُوَّةٍ","ما كان دونكُم لها مَنْ يَحجُبُ",28,"ب",1,0],["حِزْبُ الإمامِ منَ الوَرَى حِزْبي إذا","عُدّوا وخُلصانُ الهدَى خُلصاني",29,"ن",2,0],["حُزْتَ الكمالَ ففيكَ معنىً مُشكلٌ","يَنْبو بيانُ القوْلِ عن تَبيينه",30,"ن",2,0],["حَزَوَّرٍ ذي ذَنَبٍ قَصيرِ","مِن مُزجَلٍ أُرسِلَ في البُحورِ",31,"ر",1,0],["حَزْنُ المَضاجِع لا نَفَاذَ لِبَثّه","حُزْناً بذاك قَضى القضاءُ نَفاذا",32,"ذ",2,0],["حزب على خلفة الأديان متحد","كأَنه لم يكن قبلاً بأمشاج",33,"ج",1,0],["حزنت عليك أماثل وأفاضل","وبكاك صحب منهم ورفاق",34,"ق",1,0],["حَزَني على سَرَواتِها ورُواتِها","وثِقاتِها وحُماتِها يَتَكَرَّرُ",35,"ر",1,0],["حُزْنٌ بَرَانِي وَأَشْوَاقٌ رَعَتْ كَبِدِي","يَا وَيْحَ نَفْسِيَ مِنْ حُزْنٍ وَأَشْوَاقِ",36,"ق",1,0],["حُزْناً عَلى ذَاكَ الجَرِيحِ الَّذي","يَجِفُّ سُقْماً فِي الصبَا الأَنْضَرِ",37,"ر",1,0],["حزْمُهُ عَلَّمَ الضَّعِيفَ إِذا اسْتَبْصَرَ","أَنَّى بِالحَزمِ يَغْدُو قَدِيرَا",38,"ر",2,0],["حُزْنٌ بَعِيدُ الغَوْرِ فِي قَلْبِي فَإِنْ","وَجَبَ الرِّثَاءُ فَإِنِّمَا يُرْثَى لِي",39,"ل",2,0],["حزته تاج المعم المخول","لك نصف الناس لو تنهضهم",40,"م",1,0],["حُز وَديعاتِ وَداعي","أَنا غيلان بِحَزوى",41,"و",2,0],["حَزَّبَ الإِخوَةَ مِنهُم بِعُلاً","نافَسَت نَبهانُ فيهُنَّ ثَعَل",42,"ل",1,0],["حزبان: ذاك على أرا","ئكه، وذلك في ارتقاب",43,"ب",1,0],["حزبيَّة قامت على","أُس من الشهَّوَات ناب",43,"ب",1,0],["حزناً ليومَ أبي محمدَ إنّهُ","يومٌ على يومِ الحسابِ يطول",44,"ل",1,0],["حزني بنفسجة يبللها الندى","وضفاف جرحي روضة معشاب",45,"ب",1,0],["حزني منكِ يا بنة الأملاك","أيُّ ذلّ لقيتُه في هواكِ",46,"ك",1,1],["حِزتُ الفَضائل قَبل خَلقِكَ وَالسوى","يَبكي عَلى ما فاتَهُ وَيَنوحُ",47,"ح",1,0],["حز متن الضلعين مني غرارا","ومنه الشبا عظيم التمادي",48,"ي",1,0],["حزين لحزن المسلمين وضاحك","لأفراحهم ما ميز العبد والحرا",49,"ر",2,0],["حزن عظيم لو تنزل عشره","فوق النهار لصار كالليل السكن",50,"ن",1,0],["حزناً للحسين فالسحب تبكي","بخشوع أبكت به الأملاكا",51,"ك",2,0],["حَزينٌ لا يَنامُ، ولا يُغَنِّي","ولا يَسْلُو، إصابتُهُ عَصِيَّةْ",52,"ي",2,0],["حزت ذمي وللرياح السوافي","مثل ذم التراب والحصباء",53,"ا",2,0],["حُزني غناي فلو فرَّقتُهُ هِبَةً","على النُفوسِ لأثرَت أنفُسُ الناسِ",54,"س",1,0],["حُزتَ حُكمَ الجُيوشِ فيهِم وَما جَه","هَزتَ جَيشاً وَلا عَقَدتَ لِواءَ",55,"ا",2,0],["حُزتَ الفَضائِلَ لَيسَ يُمكِنُ جَحدُها","وَالصُبحُ لَيسَ بِمُمكِنٍ كِتمانُهُ",56,"ن",2,0],["حزتَ العلوم فلم تدع","فيها على نور كمامه",57,"م",2,0],["حِزحُهُ التَقديسُ عَن كُلِّ وَصمَةٍ","بِنَفسيَ مِنهُ لانشِراحٍ وَرَحمَةٍ شَغافٌ",58,"ف",1,0],["حُزْتَ المودَّة فاستَوى","عِندي حضورُك والمَغيبُ",59,"ب",1,0],["حَزمٌ وَعَزمٌ وَبَأسٌ صادِقٌ وَنَدىً","غَمرٌ وَحِلمٌ وَعَقلٌ فاقَ لُقمانا",60,"ن",2,0],["حَزمٌ لَقَد ضَبطَ الأُمورَ وَحكمةٌ","كَشَفَت لِثاقبِ عِلمَها الأَسرارُ",61,"ر",1,0],["حُزتِ بهِ طيبة كلّ العلا","هنّأهُ اللَّه وهنّاكِ",62,"ك",1,0],["حزتَ الجمال فإن رمتَ الكمال فلا","تستعمل الغدرَ في عهد ولا خُلُفا",63,"ف",2,0],["حزت السّيادة والكرامة والتقى","والفضل والأمداد بالتذكار",64,"ر",1,0],["حزنٌ يقطّع في الحشا","فكأنه غدر الصديق",65,"ق",1,0],["حزماَ يَرَى الأمير قبل موقِعه","به وعزماً يسابق القَدَرا",66,"ر",2,0],["حُزْتَ الْبَرَاعَةَ وَالْيَرَاعَةَ وَالْعُلاَ","وَسَبَقْتَ فِي مِضْمَارِ هَذَا الشَّانِ",67,"ن",1,0],["حُزْتَ يَا ابْنَ الْفَخَارِ الْيُوسِي","كُلَّ فَخْرٍ بِرَقْمِ هَذِي الطُّرُوسِ",68,"س",1,1],["حُزناً على رجلٍ كانت تدينُ له ال","آمالُ تبغى لديه غايةَ الرشدِ",69,"د",1,0],["حُزناً على زينة الدنيا ورنقها","لما هوى بدرُهُ الوضاءُ عن صُعُدِ",69,"د",1,0],["حُزتَ الجمال مثلما حاز العُلا ال","مَولى كمالُ الدين من دون الوَرى",70,"ر",2,0],["حزَّت قلوبَ البائسينَ سيوفُهم","فالصدرُ فيهِ الحزُّ والحزَّاز",71,"ز",1,0],["حُزْتَ بِها شُكْرِي وَدَلَّتْ عَلَى","مَحَبَّةٍ بِالنَّفْسِ مَخْلُوطَهْ",72,"ط",2,0],["حُزْتَ فِيهِ الْمُنى فَأَطْلَعْتَ مِنْهُ","قَمَرَ الْمَجْدِ فِي سَماءِ الْفَخارِ",73,"ر",1,0],["حَزْماً وَإِقْداماً وَلَيْسَ بِمُنْكَرٍ","بَأْسُ الضَّراغِمِ وُثَّباً أَوْ رُبَّضا",74,"ض",2,0],["حزنا عليك على القريض","العف والأدب اللباب",75,"ب",1,0],["حَزِنَت لمَوتِكَ طيبةٌ","ومِنىً وزَمزَم وَالحَطيمُ",76,"م",1,1],["حزِنت لموتك طيبةٌ وبقيعُها","وَبكت لفوتِكَ مكَّةٌ ومِناها",77,"ا",3,0],["حَزَنٌ شامِلٌ وَشَملٌ شَتيتٌ","وَهَوىً نازِحٌ وَقَلبٌ كسيرُ",78,"ر",1,0],["حُزنٌ كمَّ فمي إِذْ كمَّ فاها","وَعلتْ آياتهُ منّا الجباها",79,"ه",2,0],["حزني عَلى ما لا سبي","ل إِليه يَحرِمُني السرورا",80,"ر",2,0],["حزني لأن غادَرتني مُتوحّشاً","في دارِ بلوى بِالمصائب تفجعُ",81,"ع",1,0],["حزني عليه دائم ما غردت","ورق الحمام ضحى بذروة نيق",82,"ق",1,0],["حُزتُ المَحامِدَ بِاِجتِهادِكَ فَاِقتَفَت","آثارَكَ العَليا وَحالَفَكَ الوَفا",83,"ف",2,0],["حَزَّ سُقاةٍ حِجاجَ غامِضَةً","مِنها عَلى كُلِّ جانِبٍ مَتَحوا",84,"ح",3,0],["حُزناً بِعَون اللَه ما شئنا كَما","قَد كانَ ذَلِكَ في الكِتاب مسَطَّرا",85,"ر",2,0],["حَزمٌ يُعِدُّ لِنارِ الحَزمِ لُجَّتَهُ","كَم مُسعِرٍ وَيُلاقي النارَ بِالحَطَبِ",86,"ب",1,0],["حَزَمتُمُ إِذ حَسَمتُم داءَها فَبِها","تُعدى البِلادُ كَما قَد جُرِّبَ الجَرَبُ",87,"ب",1,0],["حُزنٌ غَدَت أَعمارُهُ نوحِيَّةٌ","وَالدَمعُ كَالطَوقانِ لا الغُدرانِ",88,"ن",1,0],["حزت السعادة من إِلهك ما سرت","في الليل دعوة عابدٍ متألِّه",89,"ه",1,0],["حُزنَ عدلاً جزاءَ شرٍّ بشرٍّ","بانتقامٍ يزيد أعلالَهنه",90,"ن",2,0],["حُزْنَا خِلالاً تراها عينُنا حَسَناً","والعقل أدرى يراها لَسنَ بالحسن",91,"ن",1,0],["حزقيلُ واَرْمِيّا وشَعياءٌ معاً","والأنبيا كلٌّ له إعلان",92,"ن",1,0],["حزتَ الرئاسة في الآفاق قاطبةً","يا بطرسُ الحِبرُ إذ خاطبتَ مولاكا",93,"ك",2,1],["حزتِ الخلالَ الكاملاتِ بأَسرها","فبك الكمال المستهامُ الأرفع",94,"ع",1,0],["حُزتم من الدين المسيحي رتبةً","صدرَ المجالس والأنامُ حواشي",95,"ي",1,0],["حِزقيل