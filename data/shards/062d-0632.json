,[381,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[381,"حزت الرئاسة في الآفاق قاطبة","https://www.aldiwan.net/poem59301.html","البسيط"],[381,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[381,"حاشاكم من وصمة تزري بكم","https://www.aldiwan.net/poem59368.html","الكامل"],[381,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[406,"الآن باح بمضمر الأسرار","https://www.aldiwan.net/poem46978.html","الكامل"],[407,"لله درك يا ابن إسماعيلا","https://www.aldiwan.net/poem33595.html","الكامل"],[407,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[410,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[420,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[420,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[420,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[420,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[436,"يا أيها الملك الذي","https://www.aldiwan.net/poem12537.html","مجزوء الكامل"],[438,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[445,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[447,"لا تقل عجزا فأنت المعجز","https://www.aldiwan.net/poem55805.html","الرمل"],[464,"حزت المكارم والعلى","https://www.aldiwan.net/poem16153.html","مجزوء الكامل"],[466,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[467,"حزت الزمان بتسطيري مديحك","https://www.aldiwan.net/poem3555.html","عموديه"],[482,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[503,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[503,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[517,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[517,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[518,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[541,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[554,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[556,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[565,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[565,"لمن المضارب في ظلال الوادي","https://www.aldiwan.net/poem52867.html","الكامل"],[565,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[570,"حان أن تستحي الأسقام","https://www.aldiwan.net/poem69644.html","مجزوء الرجز"]],"verses":[["حَزّاً إِلى المَجدِ مِن أَزِمَّتِها","لَيسَ كَحَزِّ الأَعاجِزِ الظُعُنا",0,"ن",2,0],["حِزْبُ النّبيّ الأُلَى إنْ روْعةٌ دهَمَتْ","مِلْءَ الفَضا لمْ تهِنْ ذَرْعاً ولم تضِقِ",1,"ق",1,0],["حَزِنَت عَلَيهِ عُقولُنا وَقُلوبُنا","وَبَكَت وَحُزنُ العَقلِ شَرُّ مُصابِ",2,"ب",1,0],["حَزِنَ العِلمُ يَومَ مِتَّ وَلَكِن","أَمِنَ الدينُ صَيحَةَ المُرتابِ",3,"ب",1,0],["حُزِيَت لي بِحَزمِ فَيدَةَ تُحدى","كَاليَهودِيِّ مِن نَطاةِ الرِقالِ",4,"ل",1,0],["حُزْنِي كَحُزْنِكُمُ لَكِنَّ لِي أَمَلاً","فِيكُمُ يُلَطِّفُ حُزْنَ النَّفْسِ وَالأَلَمَا",5,"م",2,0],["حُزاوِيَّةٌ أَو عَوهَجٌ مَعقُلِيَّةٍ","تَرودُ بِأَعطافِ الرِمالِ الحَرائِرِ",6,"ر",1,0],["حزتَ المحامِد حتَّى ما لِذي شرفٍ","من صورةِ الحمدِ لا جسمٌ ولا ذات",7,"ت",1,0],["حزني منكِ يا ابنة الأملاكِ","أيُّ ذلٍّ لقيتُه في هواكِ",8,"ك",1,1],["حزت حينا تجلة واحتراماً","وتألمت للمصائب حينا",9,"ن",2,0],["حزَنَته بلاده وهي صيد","بين نابى مظَّفر الناب ورد",10,"د",1,0],["حُزنَ مُستَعمَلَ الكَلامٍ اِختِياراً","وَتَجَنَّبنَ ظُلمَةَ التَعقيدِ",11,"د",1,0],["حُزتَ ميراثَهُ بِحَقٍّ مُبينٍ","كُلُّ حَقٍّ سِواهُ إِفكٌ وَزورُ",12,"ر",1,0],["حُزتَ العُلا سَبقاً وَصَلّى ثانِياً","ثُمَّ اِستَوَت مِن بَعدِهِ الأَقدامُ",13,"م",1,0],["حُزونَةُ أَيّامٍ مَرَرنَ بِهَضبَةٍ","فَأَقلَعنَ مِثلَ المارِنِ اللَيِّنِ اللَدنِ",14,"ن",1,0],["حَزماً وَبِرّاً لِلإِلَهِ وَشيمَةً","تَعفو عَلى خُلُقِ المُسيءِ المُفسِدِ",15,"د",1,0],["حَزِنتُ لِمَوتِ زائِدَةَ بنَ مَعنٍ","حَقيقٌ أَن يَطولُ عَلَيهِ حُزني",16,"ن",2,1],["حُزنا السُرورَ بِها وَبِتنا نَجتَلي","بِنتَ الكُرومِ بِغَيرِ عَقدِ نِكاحِ",17,"ح",1,0],["حَزمٌ فَتَحتَ بِهِ الأُمورَ وَإِنَّها","كَالقُفلِ مُحتاجُ إِلى المِفتاحِ",17,"ح",1,0],["حُزتَ أَضعافَ حُسنِهِ وَتَمَيَّز","تَ عَليهِ بِكُلِّ مَعنىً مَحوزِ",18,"ز",1,0],["حُزتَ المَحامِدَ بِالمَكارِمِ مَيِّتاً","فَغَدا لَكَ التَأبينُ لا التَأنيبُ",19,"ب",1,0],["حُزتَ العُلى وَالجودَ يا","رَبَّ الفَضائِلِ وَالفَواضِل",20,"ل",1,0],["حُزتَ العُلى فَدَعاكَ الناسُ سَيِّدَهُمُ","وَالكَأسُ لَولا الحُمَيّا سُمِّيَت قَدَحا",21,"ح",2,0],["حُزنٌ غَداةَ الحَزنِ هاجَ غَليلَهُ","في أَبرَقِ الحَنّانِ مِنكَ حَنينُ",22,"ن",1,0],["حُزْتُ عِلْمَاً وَمَا رُزِقْتُ قَبُولاً","فَكَأَنِّي مَجَلَّةُ الأَحْكَامِ",23,"م",1,0],["حزبُ النّجاةِ أعدَّ أفضلَ عُدَّةٍ","واستنَّ أقومَ سُنّةٍ وسبيلِ",24,"ل",1,0],["حِزبٌ من الشُّمِّ يهوي عن جوانبِه","مَن كدَّ يطمعُ أن ينهارَ أو كدحا",25,"ح",2,0],["حَزَبَتْهُ الأمورُ في طاعةِ الل","هِ فما هَمَّ مَرّةً باعتراضِ",26,"ض",1,0],["حَزَّتْ فلا خد الحديدِ مخضَّبٌ","بدمٍ ولا نحرُ الذبيح مخضًّب",27,"ب",1,0],["حُزْتُمْ عظيماً مِنْ تُراثِ نُبُوَّةٍ","ما كان دونكُم لها مَنْ يَحجُبُ",28,"ب",1,0],["حِزْبُ الإمامِ منَ الوَرَى حِزْبي إذا","عُدّوا وخُلصانُ الهدَى خُلصاني",29,"ن",2,0],["حُزْتَ الكمالَ ففيكَ معنىً مُشكلٌ","يَنْبو بيانُ القوْلِ عن تَبيينه",30,"ن",2,0],["حَزَوَّرٍ ذي ذَنَبٍ قَصيرِ","مِن مُزجَلٍ أُرسِلَ في البُحورِ",31,"ر",1,0],["حَزْنُ المَضاجِع لا نَفَاذَ لِبَثّه","حُزْناً بذاك قَضى القضاءُ نَفاذا",32,"ذ",2,0],["حزب على خلفة الأديان متحد","كأَنه لم يكن قبلاً بأمشاج",33,"ج",1,0],["حزنت عليك أماثل وأفاضل","وبكاك صحب منهم ورفاق",34,"ق",1,0],["حَزَني على سَرَواتِها ورُواتِها","وثِقاتِها وحُماتِها يَتَكَرَّرُ",35,"ر",1,0],["حُزْنٌ بَرَانِي وَأَشْوَاقٌ رَعَتْ كَبِدِي","يَا وَيْحَ نَفْسِيَ مِنْ حُزْنٍ وَأَشْوَاقِ",36,"ق",1,0],["حُزْناً عَلى ذَاكَ الجَرِيحِ الَّذي","يَجِفُّ سُقْماً فِي الصبَا الأَنْضَرِ",37,"ر",1,0],["حزْمُهُ عَلَّمَ الضَّعِيفَ إِذا اسْتَبْصَرَ","أَنَّى بِالحَزمِ يَغْدُو قَدِيرَا",38,"ر",2,0],["حُزْنٌ بَعِيدُ الغَوْرِ فِي قَلْبِي فَإِنْ","وَجَبَ الرِّثَاءُ فَإِنِّمَا يُرْثَى لِي",39,"ل",2,0],["حزته تاج المعم المخول","لك نصف الناس لو تنهضهم",40,"م",1,0],["حُز وَديعاتِ وَداعي","أَنا غيلان بِحَزوى",41,"و",2,0],["حَزَّبَ الإِخوَةَ مِنهُم بِعُلاً","نافَسَت نَبهانُ فيهُنَّ ثَعَل",42,"ل",1,0],["حزبان: ذاك على أرا","ئكه، وذلك في ارتقاب",43,"ب",1,0],["حزبيَّة قامت على","أُس من الشهَّوَات ناب",43,"ب",1,0],["حزما علي وبعض حز","م المرء يخلو من صلاح",44,"ح",1,0],["حزن على حزن وهول مدهش","يمضي المدى والغم في تكرار",45,"ر",1,0],["حزامها ساعدي يشب بها","وكعبها فوق الأرض شبران",46,"ن",1,0],["حزين غريق بأحزانه","كئيب بآلامه مفعم",47,"م",1,0],["حزناً ليومَ أبي محمدَ إنّهُ","يومٌ على يومِ الحسابِ يطول",48,"ل",1,0],["حزت المحاسن في الربيع وفقته","إذ ليس عندك عوسج يدمينا",49,"ن",2,0],["حزنت قبور الفاتحين وأطلقت","حمر الدموع وأرسلت مدرارها",50,"ر",3,0],["حزني بنفسجة يبللها الندى","وضفاف جرحي روضة معشاب",51,"ب",1,0],["حزني منكِ يا بنة الأملاك","أيُّ ذلّ لقيتُه في هواكِ",52,"ك",1,1],["حزّ في قلبك الوفيّ صديق","صار في الندوة الخصيم الألدّا",53,"د",2,0],["حِزتُ الفَضائل قَبل خَلقِكَ وَالسوى","يَبكي عَلى ما فاتَهُ وَيَنوحُ",54,"ح",1,0],["حز متن الضلعين مني غرارا","ومنه الشبا عظيم التمادي",55,"د",2,0],["حزين لحزن المسلمين وضاحك","لأفراحهم ما ميز العبد والحرا",56,"ر",2,0],["حزن عظيم لو تنزل عشره","فوق النهار لصار كالليل السكن",57,"ن",1,0],["حزناً للحسين فالسحب تبكي","بخشوع أبكت به الأملاكا",58,"ك",2,0],["حَزينٌ لا يَنامُ، ولا يُغَنِّي","ولا يَسْلُو، إصابتُهُ عَصِيَّةْ",59,"ي",2,0],["حزت ذمي وللرياح السوافي","مثل ذم التراب والحصباء",60,"ا",2,0],["حُزني غناي فلو فرَّقتُهُ هِبَةً","على النُفوسِ لأثرَت أنفُسُ الناسِ",61,"س",1,0],["حُزتَ حُكمَ الجُيوشِ فيهِم وَما جَه","هَزتَ جَيشاً وَلا عَقَدتَ لِواءَ",62,"ا",2,0],["حُزتَ الفَضائِلَ لَيسَ يُمكِنُ جَحدُها","وَالصُبحُ لَيسَ بِمُمكِنٍ كِتمانُهُ",63,"ن",2,0],["حزتَ العلوم فلم تدع","فيها على نور كمامه",64,"م",2,0],["حِزحُهُ التَقديسُ عَن كُلِّ وَصمَةٍ","بِنَفسيَ مِنهُ لانشِراحٍ وَرَحمَةٍ شَغافٌ",65,"ف",1,0],["حُزْتَ المودَّة فاستَوى","عِندي حضورُك والمَغيبُ",66,"ب",1,0],["حَزمٌ وَعَزمٌ وَبَأسٌ صادِقٌ وَنَدىً","غَمرٌ وَحِلمٌ وَعَقلٌ فاقَ لُقمانا",67,"ن",2,0],["حَزمٌ لَقَد ضَبطَ الأُمورَ وَحكمةٌ","كَشَفَت لِثاقبِ عِلمَها الأَسرارُ",68,"ر",1,0],["حُزتِ بهِ طيبة كلّ العلا","هنّأهُ اللَّه وهنّاكِ",69,"ك",1,0],["حزتَ الجمال فإن رمتَ الكمال فلا","تستعمل الغدرَ في عهد ولا خُلُفا",70,"ف",2,0],["حزت السّيادة والكرامة والتقى","والفضل والأمداد بالتذكار",71,"ر",1,0],["حزنٌ يقطّع في الحشا","فكأنه غدر الصديق",72,"ق",1,0],["حزماَ يَرَى الأمير قبل موقِعه","به وعزماً يسابق القَدَرا",73,"ر",2,0],["حُزْتَ الْبَرَاعَةَ وَالْيَرَاعَةَ وَالْعُلاَ","وَسَبَقْتَ فِي مِضْمَارِ هَذَا الشَّانِ",74,"ن",1,0],["حُزْتَ يَا ابْنَ الْفَخَارِ الْيُوسِي","كُلَّ فَخْرٍ بِرَقْمِ هَذِي الطُّرُوسِ",75,"س",1,1],["حُزناً على رجلٍ كانت تدينُ له ال","آمالُ تبغى لديه غايةَ الرشدِ",76,"د",1,0],["حُزناً على زينة الدنيا ورنقها","لما هوى بدرُهُ الوضاءُ عن صُعُدِ",76,"د",1,0],["حُزتَ الجمال مثلما حاز العُلا ال","مَولى كمالُ الدين من دون الوَرى",77,"ر",2,0],["حزني على وطني يعيث به أذى","قوم شديد مكرهم ولئام",78,"م",1,0],["حزني على وطني يمزّق شمله","تغشاه من أيدي اليهود سهام",78,"م",1,0],["حزَّت قلوبَ البائسينَ سيوفُهم","فالصدرُ فيهِ الحزُّ والحزَّاز",79,"ز",1,0],["حُزْتَ بِها شُكْرِي وَدَلَّتْ عَلَى","مَحَبَّةٍ بِالنَّفْسِ مَخْلُوطَهْ",80,"ط",2,0],["حُزْتَ فِيهِ الْمُنى فَأَطْلَعْتَ مِنْهُ","قَمَرَ الْمَجْدِ فِي سَماءِ الْفَخارِ",81,"ر",1,0],["حَزْماً وَإِقْداماً وَلَيْسَ بِمُنْكَرٍ","بَأْسُ الضَّراغِمِ وُثَّباً أَوْ رُبَّضا",82,"ض",2,0],["حزنا عليك على القريض","العف والأدب اللباب",83,"ب",1,0],["حَزِنَت لمَوتِكَ طيبةٌ","ومِنىً وزَمزَم وَالحَطيمُ",84,"م",1,1],["حزِنت لموتك طيبةٌ وبقيعُها","وَبكت لفوتِكَ مكَّةٌ ومِناها",85,"ا",3,0],["حَزَنٌ شامِلٌ وَشَملٌ شَتيتٌ","وَهَوىً نازِحٌ وَقَلبٌ كسيرُ",86,"ر",1,0],["حُزنٌ كمَّ فمي إِذْ كمَّ فاها","وَعلتْ آياتهُ منّا الجباها",87,"ه",2,0],["حزني عَلى ما لا سبي","ل إِليه يَحرِمُني السرورا",88,"ر",2,0],["حزني لأن غادَرتني مُتوحّشاً","في دارِ 