{"poems":[[55,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[74,"ونشيطة الأعطاف إلا أنها","https://www.aldiwan.net/poem19537.html","الكامل"],[45,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[63,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[68,"فطر به كاد قلب الدهر ينفطر","https://www.aldiwan.net/poem40977.html","البسيط"],[132,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[164,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[164,"من عونه ربه في أمره غلبا","https://www.aldiwan.net/poem58896.html","البسيط"],[164,"ملك سما ذو كمال زانه كرم","https://www.aldiwan.net/poem59106.html","البسيط"],[240,"مالي على جور الليالي صاحب","https://www.aldiwan.net/poem32144.html","الكامل"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[408,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[520,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[563,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62504","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120096","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120092","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59129","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96722","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96602","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96703","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96717","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96713","الكامل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111166","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64740","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64697","الكامل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105226","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108597","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141314","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69321","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48218","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53233","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53177","الرمل"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126535","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97889","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103024","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198238","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198189","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76724","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139724",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5864,"عادتكَ ياوطنَ الكِرامِ لئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190486",""]],"verses":[["مَلِكٌ سَما حَتّى تَحَلَّقَ في العُلى","وَأَذَلَّ عِرنينَ الزَمانِ السامي",0,"م",2,0],["مَلِكٌ سَجِيَّتُهُ الوَفاءُ فَما لَهُ","بِالعَهدِ في ذي خُلَّةٍ إِخلالُ",1,"ل",1,0],["مَلِكٌ سَابِقُ المُلوكِ إذَا","كَانَتْ المَحْمَدَاتُ مَيْدَانَا",2,"ن",2,0],["ملك سما ونما وجادَ على الورَى","فليجتنوا وليجتدوا وليجتلوا",3,"ل",3,0],["مَلِكٌ سِنانُ قَناتِهِ وَبَنانُهُ","يَتَبارَيانِ دَماً وَعُرفاً ساكِبا",4,"ب",2,0],["ملك سماء يمينه وشماله","منهلة بالسم والدرياق",5,"ق",1,0],["مَلكٌ سَما ذِكرُهُ بَينَ المُلوكِ وَما","بَنى لَهُ الذِكرَ إِلّا الصارِمُ الذَكرُ",6,"ر",1,0],["ملكٌ سيّد شجاعٌ جوادٌ","بطلٌ قاصمُ الكنَودِ الكفورِ",7,"ر",1,0],["ملك سخي كل منبت شعرة","منه بها للجود بحر مزبدُ",8,"د",1,0],["ملك سعيد وأيامٌ مباركةٌ","ومالك عدله يستنزلُ السُّحبا",9,"ب",2,0],["ملك سما ذو كمال زانه كرم","أغنى الورى من كريم الطبع والشيم",10,"م",1,1],["مَلِكٌ سَقاني مِن نَداهُ وَرَأيِهِ","لَمّا اِشتَكَيتُ بِصَيِّبٍ وَبِصائِبِ",11,"ب",1,0],["مَلِكٌ سَرى العلماءُ تحت لوائه","فغَدا حريمُ بني الضَّلال مُباحا",12,"ح",2,0],["ملكٌ سادَ في الزّمان كما ساد","أبوه من قبل مَجْداً وفَضْلا",13,"ل",2,0],["ملك سمت غسان بالشرفين من","أجداده قدماً ومن أعمامه",14,"م",2,0],["ملك سليمان كان منه كما","خليفة عنه كان داوود",15,"د",1,0],["مَلِكٌ سَوَّدته بالسُّؤددِ البا","ذِخِ ساداتُ يَعرُبٍ ونزار",16,"ر",1,0],["مَلِكٌ سُحْبُ أيادي","ه أبت إلا انسجاما",17,"م",2,0],["ملك سريع العفو مر","هوب السطا يرجى ويحذر",18,"ر",1,0],["ملك سمت هماته","وعلت به فهو الهمامُ",19,"م",1,0],["مَلِكٌ سَمَتْ أخْلاَقُهُ فَتَرَفَّعَتْ","عَنْ رُتْبَةِ الأشْبَاهِ وَالأمْثَالِ",20,"ل",1,0],["ملكٌ سما أَعلى سما","وات المفاخرِ والكرَم",21,"م",1,0],["مَلكٌ سَمت شَرفاً سماءُ فخارهِ","حتّى سَمت فوقَ السماءِ سماؤهُ",22,"ا",3,0],["ملكٌ سادَ الملوكا","وَبنى المجدَ سموكا",23,"ك",2,0],["ملكٌ سادَ الورى طفلاً وما","نَبتت مِن فوقِ خدّيه اللمم",24,"م",1,0],["ملكٌ سَعى في المَكرُماتِ ولم تمط","أَيدي الولايد بعد عنهُ تمائما",25,"م",2,0],["ملك سما للسماء لما","أوحى له اللَه عد واصعد",26,"د",1,0],["مَلْكٌ سَما الأَملاكَ في الفَصْلِ والْ","إِفضالِ إِذا جدُّوا وإِذْ جادُوا",27,"د",3,0],["مَلِكٌ سَما أَمْلاكَنا","فَضْلاً وإِفْضالاً وَسَمْتا",28,"ت",2,0],["ملك ساد على أقرانه","ان يجرد فبفيه القلب يقوى",29,"و",2,0],["ملك سمى الأملاك ثر","وته الفضائل والمحامد",30,"د",1,0],["ملك سماويّ يفيض جبينه","نوراً وماء اللّطف يقطرُ فُوهُ",31,"و",2,0],["مَلِكٌ سَمِعنا بِالمُلوكِ وَفِعلِهِم","وَأَتى فَصَغَّرَ فِعلُهُ ما تَسمَعُ",32,"ع",1,0],["ملكٌ سلاهبُهُ لِلخصْمِ إِنْ ركضت","قبل ارتدادِ لحاظِ المرء يَنْقرضُ",33,"ض",1,0],["ملك سما بمواهب ومناقب","يغشي عيون الحاسدين سناها",34,"ا",3,0],["ملك سنَّ له آباؤه","شرف القول وإِكْمال الفعال",35,"ل",1,0],["ملك سما ذو كمال زانه كرم","بحر جرى فيض كفيه على الأمم",36,"م",1,1],["ملك سليمان ترى ملككم","وإنني في شعبه الهدهد",37,"د",1,0],["ملك سمتْ فَوْقَ السما عَزماتُه","ولَطار فِيهَا لَوْ أُعيرَ جَناحا",38,"ح",2,0],["ملك سَما سُلطانَهُ وَتَقاصَرَت","عَنهُ المُلوك لِأَنَّها أَسماءُ",39,"ا",2,0],["ملك سما في بني الأملاك مفخره","كما سمت شرفا في العرب قحطان",40,"ن",1,0],["مُلكٌ سُليمانِيَّةٌ بَسطَتُهُ","ما فَوقَهُ لِمُعتلٍ مِن مُعتَلى",41,"ا",1,0],["مَلِكٌ سَنِيُّ أَلْمَعِيُّ ماجِدٌ","بَرٌّ تَقِيٌّ ((زائِدٌ)) مُتَعَفِّفُ",42,"ف",1,0],["مَلِكٌ سَجاياهُ تُضِيءُ وَلَمْ يَكُنْ","يَحْتَاجُ مَنْ يرجو نَداهُ سُؤَالاَ",43,"ل",2,0],["ملك سمت علياه حتى دوّحت","وزكا ثرى نعماه حتى روضا",44,"ض",2,0],["ملكٌ ساد الملوك الغلبَ في ال","عدل والبذلِ وفي المجد الأثيل",45,"ل",1,0],["ملك سعيد الجد فرداً في العلا","هو في الورى مثل المناد المفرد",46,"د",1,0],["مَلِكٌ سَماءُ فَخارِهِ شَفَعَتْ","فِي شَأْوِها الخَضْرا بِخَضْراءِ",47,"ا",2,0],["مَلِكٌ سَعى للهِ ملء فؤادِهِ","فسَعَى لَهُ التَّبجِيلُ والإِعظامُ",48,"م",1,0]]}