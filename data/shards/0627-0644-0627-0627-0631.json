{"poems":[[11,"ألا أرقت عيني فبت أديره","https://www.aldiwan.net/poem255.html",""],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[51,"ألا أرى للمرء أن يأمن الدهرا","https://www.aldiwan.net/poem62093.html","الطويل"],[107,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10384","الطويل"],[146,"تفيض نفوس بأوصابها","https://www.aldiwan.net/poem58421.html","المتقارب"],[556,"ألا أرقت لضوء برق أومضا","https://www.aldiwan.net/poem47737.html","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104554","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38936","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96752","المتقارب"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/141465","السريع"],[1230,"","https://poetry.dctabudhabi.ae/diwan/poem/123609","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122018","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108543","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126666","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105011","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28536","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202584","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48423","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94657","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94362","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35459","المجتث"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104886","الوافر"],[4818,"طمع","https://www.poetsgate.com/ViewPoem.aspx?id=203510",""],[5490,"حديث الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=176287",""],[5956,"ألا ارحم يا صديقُ ذماءَ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=193928",""],[5956,"أهاجر أين؟","https://www.poetsgate.com/ViewPoem.aspx?id=194385",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""]],"verses":[["أَلا أَرِقَت عَيني فَبِتُّ أُديرُه","حِذارَ غَدٍ أَحجى بِأَن لا يَضيرُها",0,"ر",3,1],["ألا أرني من قد يسد مسده","ودع جرح مصر شاغلا للضوامد",1,"د",1,0],["أَلا أَرى لِلمَرءِ أَن يَأمَنَ الدَهرا","فَإِنَّ لَهُ في طولِ مُهلَتِهِ مَكرا",2,"ر",2,1],["أَلا أَرِنَا مناسِكَنا فإنّا","من الأَحبارِ في أمرٍ مُريبِ",3,"ب",1,0],["ألا أراك فإني سامعٌ نغما","يهفو إليّ بإطرابٍ وإبهاج",4,"ج",1,0],["أَلا أَرِقَت عَيني فَبِتُّ أُديرُها","حِذارَ غَدٍ أَحجى بِأَن لا يَضيرُها",5,"ر",3,1],["ألا أرِنى لوعةً في الحشا","وليس الهوى بعضَ أسبابها",6,"ب",3,0],["أَلّا أَرِقْتَ لضوء برقٍ أوْمضا","ما زار طرفي ومْضُهُ حتّى مضى",7,"ض",2,1],["ألا أرسليها بالسلامِ فإنَّها","تُشافِهُ أشواقي بألسنةِ البِشرِ",8,"ر",1,0],["أَلا اِرمِ بِها صَدرَ الفَيافي فَإِنّها","شَماليل مِثلُ البرقِ شوس دَلاعسُ",9,"س",1,0],["أَلا اِرفق بمن لمتَ يا لائمي","وقلِّل من اللَّومِ فالصَّبر أقلى",10,"ل",2,0],["ألا أراني والهوى غالبي","أجمع المال لأختاني",11,"ن",2,0],["ألا أرى ماء الصبح شافياً","نفوساً إلى أمواه بقعاء نزعاً",12,"ع",2,1],["أَلاَ ارْتَقِبُوا هَذَا الهِلاَلَ الَّذِي بَدَا","مِنَ الْغَربِ مَرْفُوعاً عَلَى أُفُقِ الْهُدَى",13,"د",2,1],["ألا أرجٌ من طيب عرفك يا صبا","يبلغ أحبابي الكرام تحيتي",14,"ي",1,0],["ألا أرسلته لي ذا لسان","يفوق على لسان أخيه حدا",15,"د",2,0],["ألا أرخص الدمع المصون لمن له","غدا مرجل الأحزان في القلب غاليا",16,"ي",2,0],["أَلا أَرقت لِلَمعِ بَرقٍ سارِ","باتَت تُجَرِّدُهُ يَدُ الأَمطارِ",17,"ر",1,1],["ألا أرى آدميّاً حائزاً ثقتي","هل مات آدم أو أوصى لحوّاء",18,"ا",2,0],["إلا أرغم الله الوشاة فإنهم","سعاة للأنف المغرمين رواغم",19,"م",1,0],["ألا أرُدُّ خَصيمَ القومِ إذ حسَدوا","وقد مضى عدْلُهُ بالبغْي والحسَدِ",20,"د",1,0],["ألا أرفق بنفسٍ إن كل نفائسٍ","لديها بذي الدنيا أخسُّ الخسيسةِ",21,"ه",1,0],["ألا أرحم حشا لبنانَ ضمّد جراحهُ","بلسم صبرٍ من محامد عاقبِ",22,"ب",1,0],["ألا أرفق بهذا الصبِّ إذ أنت فاتنُه","واشفق على قلبٍ حوتكَ بَواطنهُ",23,"ه",1,1],["أَلا أرفق رعاك اللَهُ في حال مغرمٍ","يراعي نجوم الليل دهراً بيقظةِ",24,"ه",1,0],["إِلّا اِرتَقى لِمَقام","يَعُدّهُ مُتَجاسِر",25,"ر",1,0],["ألا ارجع أنت من سفر قريب","ليرجع ذاك من سفر بعيد",26,"د",1,1],["ألا ارحم ْحالتي ياحِبّ، لطفاً","على وَجَعي، ومن وجعٍ أُغنّي",27,"ن",2,0],["ألا ارحم ما تبَقى منك وارفق","بقلبٍ كلما أعرضتَ حَنّا",28,"ن",2,0],["ألا ارحمْ يا صديق ذماءَ روحي","لقد ذابت عظامي من جروحي",29,"ح",2,1],["ألا ارحمْ يا حسينُ ذماءَ روحي","لقد ذابت عظامي من جروحي",30,"ح",2,1],["ألا ارْحلْ لِلَيْلاك بين القُمام","وراقِصْ بليْلاك كلَّ السطول",31,"ل",1,0]]}