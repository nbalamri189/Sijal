{"poems":[[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[333,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[556,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138607",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73179","المديد"]],"verses":[["كيف ضعتم وفرجُ بوران موقو","ف على ابن السبيل والمحروم",0,"م",1,0],["كيف ضاع الذي ورثناه عنه","وبقينا نبكى لمجد فقيد",1,"د",1,0],["كَيفَ ضَيّعتَنِي وقد كنتَ بي فَوْ","قَ محلِّ السِّماك لو لم تُضِعنِي",2,"ن",2,0],["كَيفَ ضاعَ المَجدُ منا وانطوى","كيف صار الشرقُ جمعاً نُوَّما",3,"م",2,0],["كيف ضم النعش منه جسداً","قام فيه الكون طراً واستقلا",4,"ل",2,0],["كَيفَ ضاعت عندَكم ذِمَمي","وإِليكُم تُنسبُ الِمنَنُ",5,"ن",1,0]]}