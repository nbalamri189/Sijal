{"poems":[[164,"رقص جياد الظبا في حلبة اللعب","https://www.aldiwan.net/poem59045.html","البسيط"],[228,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[266,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[353,"سلام كأنفاس الصبا مست الربى","https://www.aldiwan.net/poem20257.html","الطويل"],[435,"يا نائيا وفؤاد الصب مأواه","https://www.aldiwan.net/poem41023.html","البسيط"],[500,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37831","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119900","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79895","البسيط"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146755","المنسرح"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104539","البسيط"]],"verses":[["ولؤلؤ الطل يسمو قدر مشبهه","لو أنه لفراق السحب لم يذب",0,"ب",1,0],["وَلُؤلوءٌ في قَعرِ بَحرٍ خاطي","يَقذِفُهُ الموجُ إِلى الشَواطىء",1,"ا",2,0],["ولولوا الحب يرى أسعدهم","مسلب اللب بأسباب الشقاء",2,"ا",2,0],["ولؤلؤُ طلٍّ لاحَ في كلِّ زهرةٍ","ما لاحَ عِقْدٌ مِن فَتاةٍ علَى نَحْرِ",3,"ر",1,0],["ولؤلؤ الطل في جيد الأقاح حكى","ثغر الحبيب إذا افترّت ثناياه",4,"ا",2,0],["ولؤلؤيْ درْج ونجمين في","برج وصمصامين في غمد",5,"د",1,0],["وَلُؤلُؤ لفظِكَ والشّفاه عَقائقٌ","وجيدُك ألماسُ وجسمُك عسجَدُ",6,"د",1,0],["ولولوعي بكل مجدولة القد","يطيع الغرام فيها العذول",7,"ل",1,0],["ولؤلؤٌ رطبٌ ريقاً وأسنانا","أُجيلُ فكريَ طوراً في حواضِنه",8,"ه",1,0],["ولؤلؤ من لسانه برد","ولؤلؤ في لباته نسق",9,"ق",1,0],["ولؤلؤ الطل قد تدلى","قلائداً في طلى البراعم",10,"م",1,0]]}