{"poems":[[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[23,"ثريد كأن السمن في حجراته","https://www.aldiwan.net/poem21626.html","الطويل"],[89,"وما الارض والانسان يجثم فوقها","https://www.aldiwan.net/poem44858.html","الطويل"],[85,"رحمة الله على سيدتي","https://www.aldiwan.net/poem6941.html","عموديه"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[62,"يقولون أبق المال واجمعه ممسكا","https://www.aldiwan.net/poem52509.html","الطويل"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[105,"أما ينهى دعاة السوء عنا","https://www.aldiwan.net/poem43378.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55150","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""]],"verses":[["ثَرىً يَرمُقُ الغَيثَ عَن مُقلَةٍ","بِها رَمَدٌ مِن رَمادِ الحُمَم",0,"م",1,0],["ثَريدٌ كَأَنَّ السَمنَ في حَجَراتِهِ","نُجومُ الثُرَيّا أَو عُيونُ الضَياوِنِ",1,"ن",1,1],["ثراء واملاق وعز وذلة","وفوز وحرمان وعرس ومأتم",2,"م",1,0],["ثروة قد نهض الجوع بها","ومشى الحرمان فيها فبناها",3,"ا",3,0],["ثراك متى أطيف به","وأنشقه وألثمه",4,"م",2,0],["ثراءُ الفتى من دون إِنفاقِه له","فسادٌ وإِنفاقُ الثَّراء نَماؤهُ",5,"ا",3,0],["ثَرَّةٌ مِن أَنامِلٍ ظَلنَ يَجري","نَ عَلى الخابِطينَ جَريَ الشِعابِ",6,"ب",1,0],["ثُرِمَت ثُغورُ المُلكِ لَولا أَنَّهُ","يُنشي لَها العَدلَ العَميمَ وَيُحدِثُ",7,"ث",1,0],["ثرِّ الشّآبيبِ أَصواتُ الرعودِ بِهِ","كَأَنَّهُنَّ هَديرُ الجُلَّةِ البُزُلِ",8,"ل",1,0],["ثَراءُ ذَوي النُهى أَوفى ثَراءً","وَرِزقُ الصالِحاتِ أَجَلُّ رِزقِ",9,"ق",1,0],["ثرْثِري واصنعي الدموعَ ولا","تحفِلي إنْ هَمَمْتِ بالكذبِ",10,"ب",1,0],["ثَرْوَةٌ لاَ تَقِلُّ فِي العِلْمِ وَالآ","دَابِ عَنْهَا فِي الجَاهِ أَوْ فِي المَالِ",11,"ل",1,0],["ثَراكَ مِسكٌ وَإِن يَصُنهُ","قَبرُكَ فَالسِرُّ في اِنبِثاثِ",12,"ث",1,0],["ثرْوَةُ الشعب مجده إن أراد ال","مَجْدَ، والأَرضُ مصدرُ الثروات",13,"ت",1,0],["ثُرتُم على البغي والباغي، ولا عجبٌ","فالشعب للحاكم الجلادِ جلاد",14,"د",1,0],["ثُرْ يا شُعورُ على ضَيْمٍ تُكابدُهُ","أوْلا فلستَ على شيءٍ بِثَوَّار",15,"ر",1,0]]}