{"poems":[[108,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[23,"ثريد كأن السمن في حجراته","https://www.aldiwan.net/poem21626.html","الطويل"],[89,"وما الارض والانسان يجثم فوقها","https://www.aldiwan.net/poem44858.html","الطويل"],[85,"رحمة الله على سيدتي","https://www.aldiwan.net/poem6941.html","عموديه"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[62,"يقولون أبق المال واجمعه ممسكا","https://www.aldiwan.net/poem52509.html","الطويل"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[105,"أما ينهى دعاة السوء عنا","https://www.aldiwan.net/poem43378.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55150","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[151,"ثوى لك في قلبي غرام مبرح","https://www.aldiwan.net/poem68573.html","الطويل"],[151,"أروح على ذكر النبي وأغتدي","https://www.aldiwan.net/poem68602.html","الطويل"],[161,"بجود يديك أورقت الغصون","https://www.aldiwan.net/poem59070.html","الوافر"],[186,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[212,"شادن قد وفى فأسكر روحا","https://www.aldiwan.net/poem46593.html","الخفيف"],[299,"قد صفت الحقب","https://www.aldiwan.net/poem36828.html","عموديه"],[459,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[469,"ثرى البركة الغناء حالي المقلد","https://www.aldiwan.net/poem60185.html","الطويل"],[576,"ثراك دفنت به ناظري","https://www.aldiwan.net/poem2788.html","المتقارب"]],"verses":[["ثرىً أحيت دوارسه بياني","كما أحيت معالمه اليبابا",0,"ب",2,0],["ثَرىً يَرمُقُ الغَيثَ عَن مُقلَةٍ","بِها رَمَدٌ مِن رَمادِ الحُمَم",1,"م",1,0],["ثَريدٌ كَأَنَّ السَمنَ في حَجَراتِهِ","نُجومُ الثُرَيّا أَو عُيونُ الضَياوِنِ",2,"ن",1,1],["ثراء واملاق وعز وذلة","وفوز وحرمان وعرس ومأتم",3,"م",1,0],["ثروة قد نهض الجوع بها","ومشى الحرمان فيها فبناها",4,"ا",3,0],["ثراك متى أطيف به","وأنشقه وألثمه",5,"م",2,0],["ثراءُ الفتى من دون إِنفاقِه له","فسادٌ وإِنفاقُ الثَّراء نَماؤهُ",6,"ا",3,0],["ثَرَّةٌ مِن أَنامِلٍ ظَلنَ يَجري","نَ عَلى الخابِطينَ جَريَ الشِعابِ",7,"ب",1,0],["ثُرِمَت ثُغورُ المُلكِ لَولا أَنَّهُ","يُنشي لَها العَدلَ العَميمَ وَيُحدِثُ",8,"ث",1,0],["ثرِّ الشّآبيبِ أَصواتُ الرعودِ بِهِ","كَأَنَّهُنَّ هَديرُ الجُلَّةِ البُزُلِ",9,"ل",1,0],["ثَراءُ ذَوي النُهى أَوفى ثَراءً","وَرِزقُ الصالِحاتِ أَجَلُّ رِزقِ",10,"ق",1,0],["ثرْثِري واصنعي الدموعَ ولا","تحفِلي إنْ هَمَمْتِ بالكذبِ",11,"ب",1,0],["ثراك والدّر ما هانا وإن ظلما","وأنت والنّور ما ضاعا وإن جحدا",12,"د",2,0],["ثَرْوَةٌ لاَ تَقِلُّ فِي العِلْمِ وَالآ","دَابِ عَنْهَا فِي الجَاهِ أَوْ فِي المَالِ",13,"ل",1,0],["ثَراكَ مِسكٌ وَإِن يَصُنهُ","قَبرُكَ فَالسِرُّ في اِنبِثاثِ",14,"ث",1,0],["ثرْوَةُ الشعب مجده إن أراد ال","مَجْدَ، والأَرضُ مصدرُ الثروات",15,"ت",1,0],["ثُرتُم على البغي والباغي، ولا عجبٌ","فالشعب للحاكم الجلادِ جلاد",16,"د",1,0],["ثُرْ يا شُعورُ على ضَيْمٍ تُكابدُهُ","أوْلا فلستَ على شيءٍ بِثَوَّار",17,"ر",1,0],["ثَرائي وَجَاهَي فيه وَجدٌ وأدُمعٌ","فَقلبيَ في الحَالَينِ ضاعٍ مُدَمَّثُ",18,"ث",1,0],["ثَرى نَعلِهِ كالمِسكِ بَلهُوَ فَوقَهُ","وَشَتّانَ طيباً ما يَحولُ وَيَمكُثُ",19,"ث",1,0],["ثَرائي وَجاهي حُبُّهُ وَاِمتِداحُهُ","فَما لي بِمَخلوقٍ سواهُ تَشَبُّتُ",19,"ت",1,0],["ثرى أقدامكم مسك فتيت","وعنصر غيركم ماء وطين",20,"ن",1,0],["ثَرىً تَودُّ نجومُ الأفقِ لو جُعلتْ","حَصْباءَهُ وعَلا منها على القمم",21,"م",1,0],["ثروة من عواطف وشجون","لو رآها اليهود باتوا سهارى",22,"ر",2,0],["ثرتدي الحدادَ وَإنَّ","رداءَها السحب",23,"ب",1,0],["ثراكِ يُسْتافُ مع ال","صبحِ لها ويُلثَمُ",24,"م",1,0],["ثَرى البِركَةِ الغَنّاءَ حالي المُقَلَّدِ","عَلَيهِ عُقودٌ مِن لُجَينٍ وَعَسجَدِ",25,"د",1,1],["ثراكِ دفنتُ به ناظري","وقالُوا مددت عليهِ الحِجابا",26,"ب",2,1]]}