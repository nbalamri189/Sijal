iewPoem.aspx?id=186100",""],[5174,"أُمَّ الْبَيَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188618",""],[5277,"رحيلُ \"الثريّا\"","https://www.poetsgate.com/ViewPoem.aspx?id=201276",""],[5320,"يا ابن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=41646",""],[5320,"حضارة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=40425",""],[5324,"بين شك ويقين","https://www.poetsgate.com/ViewPoem.aspx?id=207178",""],[5358,"يمن أنت يا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=206165",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5595,"إنّ العراقَ أبيّ ٌ أينما ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=144531",""],[5674,"فرات الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189070",""],[5720,"الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=215275",""],[5776,"الفجر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=199936",""],[402,"تم فيك الجمال حسا ومعنى","https://www.poetsgate.com/ViewPoem.aspx?id=36132",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""],[5943,"صيدا في الشباك","https://www.poetsgate.com/ViewPoem.aspx?id=34289",""],[5956,"تحيا الطفولة والجنون ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183937",""],[5956,"الوطن العربي","https://www.poetsgate.com/ViewPoem.aspx?id=192339",""],[5957,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182458",""],[6097,"فرّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190668",""],[6102,"كلميني","https://www.poetsgate.com/ViewPoem.aspx?id=184858",""],[1583,"هذه الأرض لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73069&r=&rc=26",""],[6247,"عطر المدينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80278&r=&rc=17",""],[6251,"الهديل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76469&r=&rc=9",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["ثرىً أحيت دوارسه بياني","كما أحيت معالمه اليبابا",0,"ب",2,0],["ثَرىً يَرمُقُ الغَيثَ عَن مُقلَةٍ","بِها رَمَدٌ مِن رَمادِ الحُمَم",1,"م",1,0],["ثَريدٌ كَأَنَّ السَمنَ في حَجَراتِهِ","نُجومُ الثُرَيّا أَو عُيونُ الضَياوِنِ",2,"ن",1,1],["ثراء واملاق وعز وذلة","وفوز وحرمان وعرس ومأتم",3,"م",1,0],["ثروة قد نهض الجوع بها","ومشى الحرمان فيها فبناها",4,"ا",3,0],["ثراك متى أطيف به","وأنشقه وألثمه",5,"م",2,0],["ثراءُ الفتى من دون إِنفاقِه له","فسادٌ وإِنفاقُ الثَّراء نَماؤهُ",6,"ا",3,0],["ثَرَّةٌ مِن أَنامِلٍ ظَلنَ يَجري","نَ عَلى الخابِطينَ جَريَ الشِعابِ",7,"ب",1,0],["ثُرِمَت ثُغورُ المُلكِ لَولا أَنَّهُ","يُنشي لَها العَدلَ العَميمَ وَيُحدِثُ",8,"ث",1,0],["ثرِّ الشّآبيبِ أَصواتُ الرعودِ بِهِ","كَأَنَّهُنَّ هَديرُ الجُلَّةِ البُزُلِ",9,"ل",1,0],["ثَراءُ ذَوي النُهى أَوفى ثَراءً","وَرِزقُ الصالِحاتِ أَجَلُّ رِزقِ",10,"ق",1,0],["ثرْثِري واصنعي الدموعَ ولا","تحفِلي إنْ هَمَمْتِ بالكذبِ",11,"ب",1,0],["ثراك والدّر ما هانا وإن ظلما","وأنت والنّور ما ضاعا وإن جحدا",12,"د",2,0],["ثَرْوَةٌ لاَ تَقِلُّ فِي العِلْمِ وَالآ","دَابِ عَنْهَا فِي الجَاهِ أَوْ فِي المَالِ",13,"ل",1,0],["ثَراكَ مِسكٌ وَإِن يَصُنهُ","قَبرُكَ فَالسِرُّ في اِنبِثاثِ",14,"ث",1,0],["ثرْوَةُ الشعب مجده إن أراد ال","مَجْدَ، والأَرضُ مصدرُ الثروات",15,"ت",1,0],["ثُرتُم على البغي والباغي، ولا عجبٌ","فالشعب للحاكم الجلادِ جلاد",16,"د",1,0],["ثُرْ يا شُعورُ على ضَيْمٍ تُكابدُهُ","أوْلا فلستَ على شيءٍ بِثَوَّار",17,"ر",1,0],["ثَرائي وَجَاهَي فيه وَجدٌ وأدُمعٌ","فَقلبيَ في الحَالَينِ ضاعٍ مُدَمَّثُ",18,"ث",1,0],["ثَرى نَعلِهِ كالمِسكِ بَلهُوَ فَوقَهُ","وَشَتّانَ طيباً ما يَحولُ وَيَمكُثُ",19,"ث",1,0],["ثَرائي وَجاهي حُبُّهُ وَاِمتِداحُهُ","فَما لي بِمَخلوقٍ سواهُ تَشَبُّتُ",19,"ت",1,0],["ثرى أقدامكم مسك فتيت","وعنصر غيركم ماء وطين",20,"ن",1,0],["ثَرىً تَودُّ نجومُ الأفقِ لو جُعلتْ","حَصْباءَهُ وعَلا منها على القمم",21,"م",1,0],["ثروة من عواطف وشجون","لو رآها اليهود باتوا سهارى",22,"ر",2,0],["ثرتدي الحدادَ وَإنَّ","رداءَها السحب",23,"ب",1,0],["ثراكِ يُسْتافُ مع ال","صبحِ لها ويُلثَمُ",24,"م",1,0],["ثَرى البِركَةِ الغَنّاءَ حالي المُقَلَّدِ","عَلَيهِ عُقودٌ مِن لُجَينٍ وَعَسجَدِ",25,"د",1,1],["ثراكِ دفنتُ به ناظري","وقالُوا مددت عليهِ الحِجابا",26,"ب",2,1],["ثرَى الغَمامَ فَلَو ثَرَّت أنامِلُهُ","خُورَ السَّحابِ لَفاقَتها أنامِلُه",27,"ل",2,0],["ثريا مع الإكليل بالوقود","تنور الجبهة في السعود",28,"د",1,0],["ثرنا خفافاً بالصفاح وبالقنا","لم نفتكر بغنيمة وإياب",29,"ب",1,0],["ثَرَاهُ لِيلْقى عِنْدَهُ مَا يُؤَمِّلُ","يَهُونُ بِهِ مَا يَحْمِلُ الْمُتَحَمِّلُ",30,"ل",1,0],["ثريّ الفخار إذا تسامى","عريّ الجيب من عار وذمِ",31,"م",1,0],["ثرى ترب المجد ذو راحة","إذا اعتفاها معدم أثرى",32,"ر",2,0],["ثرة في يبس العا","م فما تبرح رطبه",33,"ب",2,0],["ثَراهُ مِنَ المِسكِ الفَتيتِ مُدَبَّرٌ","إِذا مازَجَتهُ السُحبُ عادَ بِها خِلطا",34,"ط",2,0],["ثُرْنَا إلَيْهِمْ عِنْدَ ذَلِكَ بِالقَنَا","وَبِكُل أبْيَضَ كَالْعَقِيقَةِ صَادِ",35,"د",1,0],["ثَرَّتْ دُموعي إِذ افْتَرَّتْ بذي أُشُرٍ","كأَنَّه مَنْهلٌ بالرَّاحِ مَعْلولُ",36,"ل",1,0],["ثرمهم خرم وقبض وهو في","طويلها ومتقارب يفي",37,"ي",1,0],["ثري الحزن بين القوم نهباً مُقسما","يردد كلٌ حسنَ سيرته حَمدَا",38,"د",2,0],["ثراء وتأثير شفاء ولا سقم","وفيض وترياق وهدي ومعشرا",39,"ر",2,0],["ثرى طبيب يسقى بماء دموعنا","فإن حرثت يوما على الدمع تحرث",40,"ث",1,0],["ثُرَيَّا أطالت في بِعادي وَجفوَتي","وَمِن حسرَتي ما فُزتُ منها بِطَائلِ",41,"ل",1,1],["ثرَيَّا مُذ سَبَت عقلي ولُبّي","وَقد فارَقتُ أوطاناً وَحَيّا",42,"ي",2,1],["ثَروَتٌ في البَأسِ عَدلي","إِن تَعَرَّفتَ الكِرام",43,"م",1,0],["ثَراؤكَ فَقرٌّ والغِنَى مَدحُ مَن هَدَى","وساد بني سام وحام ويافثِ",44,"ث",1,1],["ثَروةَ الشَملِ آثُروها بِسَهرِ","كلُّ شَملٍ فى جنبهم أشعاثُ",45,"ث",1,0],["ثَراه يَطيب الزاد للضَيف وَالروى","إِذا الناس طرّاً أَعطَشوا وَأَجيعوا",46,"ع",3,0],["ثَرى أرضِهِم من وقعِ أقدامِهم بها","ومَسَّ الصخرِ ظلّت صُمُّهُنّ تمورُ",47,"ر",1,0],["ثراك التبر أَو هُوَ مِنهُ أَغلى","وَرَيّاك العَبير لِكُلّ ناشق",48,"ق",1,0],["ثرمنا به للروع ثغراً فَلَم نزَل","بأمن وَلَم تلف بنا بعض باعث",49,"ث",1,0],["ثَرى الأَرض لَو امسى نضاراً وَكفه","يجود به ابصرته غير لابث",49,"ث",1,0],["ثرنا إلى الشَدقميات الَّتي سَهِكَت","أَبدانهن وَأَعياهُنَّ تَنعيلُ",50,"ل",1,0],["ثُرْنا لهم ثَوْرةً في الله صادِقةً","وَهَتْ عُرى عُرِفْهم فيها وما عَزَمَوا",51,"م",3,0],["ثُرتم على الوزن والقوافي","أعلنتم الحرب والقتالا",52,"ل",2,0],["ثروة اللفظ والمعاني لديّا","يتعب الرافعون رأسا إليّا",53,"ي",2,1],["ثُرَيَّةُ العُشْبِ بِالشُّعْلاَتِ تَقْطُرُ فِي","نَدَاوَةِ الرَّحْبِ قَامُوساً مِنَ العَجَبِ",54,"ب",1,0],["ثروة تجنى ومجد يقتنى","وعلا تحوى وأرض تغتصب",55,"ب",1,0],["ثَرى الشيءَ مَبذولاً فان رمتَهُ غدا","واقرب من لقياهُ عنقاءُ مُغربِ",56,"ب",1,0],["ثَرَائِي وَجَاهِي فِيهِ وَحْدٌ وَأَدْمُعٌ","فَقَلْبيَ فِي الحَالَيِنِ ضَاحٍ وَمُدْمِثُ",57,"ث",1,0],["ثَرْ فِيْ المحبَّه يضيع لِقْيَاسْ","يومْ العَقِلْ مَاخوذ عَنَّا",58,"ن",2,0],["ثرى أرضه طيبٌ فياليتَ أنني","أعفّر خدّي في ثراها وأمغَث",59,"ث",1,0],["ثراءٌ عظيمٌ أن أعدَّ على الثرى","ليالي دمع من جفوني تنبثُ",59,"ث",1,0],["ثرى قد اعاد الليل مسكاً عبيره","وماء اعاد البدر فضته تبرا",60,"ر",2,0],["ثَرىً قد هدَى للرُشْدِ كلَّ مضلَّلٍ","وأثْرى به طوْعَ السّعادةِ مُعْدِمُ",61,"م",1,0],["ثراء من المولى الأغر ابن هاشم","الى دولة غراء بالمرء يعبث",62,"ث",1,0],["ثريا نظامي كم تسامى لنيلها","غبي بأشعار الورى يتشبث",62,"ث",1,0],["ثرى القوم صرعى من سلافة حانة","يخبر عن فيض الوريد عصيرها",63,"ر",3,0],["ثروة المرء بما يطلبه","لا بما يملكه بين يديه",64,"ي",2,1],["ثرى آثار نعلك كحل عيني","ولذتها بذلك حين أحثو",65,"ث",2,0],["ثريا أمن هذا الدين مما","نحاذره وللراجين غوث",65,"ث",1,0],["ثريا أمان الدين من كل ملحد","ونبراسه الماحي بأنواره الظلما",66,"م",2,0],["ثَرَاكَ رَسُولَ اللهِ أشفَى لِمُشتَفٍ","مِنَ العَنبَرِ الشِّحرِيِّ والمِسكِ قَد بُثاَّ",67,"ث",2,0],["ثُرَيَّاكَ لَمَّا عَن قُرَيشٍ تَغَيَّبَت","أصَابَتهُمُ العَاهَاتُ جَمعُهُمُ اجتُثَّا",67,"ث",2,0],["ثَرَّتْ على الاََرْضِ مِن مُنْهَلِّ هَيْدَبِها","بِعارِضٍ جادَ أَو خِلْتَ البِطاحَ بِها",68,"ه",2,0],["ثرى منه بالدنيا الثراء لمترت","وللمذنب الجاني الشفاعة في الاخرى",69,"ر",2,0],["ثُر ثورة السفاح تصفر بالعدى","ولو استقل بهم بنو مروان",70,"ن",1,0],["ثريا تضيء بليل الدجى","فيهرب منها ظلام الحلك",71,"ك",1,1],["ثرىً كحلُ البسيطة من ثراه","ومه كحل باصرَتي ذكاء",72,"ا",2,0],["ثر بأمر الإله لله واجعل","كلَّ طودٍ من الضلال يبابا",73,"ب",2,0],["ثراه قد فاق الثريا كما","قد جاوز الجوزاء منه الأديم",74,"م",1,0],["ثَرْثرْي ثمّ ثَرْثرْي","قولُك ِ العذب ُ كرري",75,"ر",2,1],["ثُرْنا وثُرتُمْ .. غَيرَ أَنَّا لم نَكُن","يَومًا بحَجمِ الدَّاءِ واستِفحالِهِ",76,"ل",2,0],["ثروتي دون همتي وفراقي","فوق طوقي وساعدي مغلول",77,"ل",1,0],["ثراؤه خدعةٌ تسقي قناعتنا","ونحن في كسبها للفقر ننجر",78,"ر",1,0],["ثروتنا يصنعها جدنا","عصر نما بالجد في النهْبِ",79,"ب",1,0],["ثُرنا فقلنا لماض ءاتنا غدَنا","لقد لقينا على أسفارنا نصبا",80,"ب",2,0],["ثرت حتى استقبلت خرراً خياراً","تتهادى ودمعها مذروف",81,"ف",1,0],["ثراؤها واسع لا حد يحويها","فافخر بها ولدي فالشرع يعليها",82,"ي",3,0],["ثَرَّاءُ مِثْلَ الْبَحْرِ فِي كَرَمٍ","زهراءُ مِثْلَ النَّجْمِ يَزْدَهِرُ",83,"ر",1,0],["ثريّا..والنجومُ غدونَ دمعاً","على فقدانِها..رغمَ التماعِ",84,"ع",1,0],["ثرى الوطن العزيز أعز تبر","إذا مالفأس غرد والمناجل",85,"ل",1,0],["ثَرَى فِيتْنامَ يَعرفُكمْ وُحُوشا","بلا أخلاق تردع أونظام",86,"م",1,0],["ثرثارة عيناي تنطق بالهوى..","وبما تكنّ جوانحي تتكلمُ",87,"م",1,0],["ثراؤُكم وعزُّكُمْ","ترابُكم وما دَفَنْ",88,"ن",1,0],["ثَرُّ البلاغةِ يُثري حَيْثُ تَنْثُرُهُ","تلكَ السَّنابل ُ يُربْي ذَرُُّها القَمْحا",89,"ح",2,0],["ثَرَواتنا كَذِبٌ وغدرٌ فاقعٌ","وتفاخرٌ في الّلهوِ والعصيانِ",90,"ن",1,0],["ثرواتُ أهلي قد ضجّت بما حملتْ","أنّ العِراقَ جريح ٌأرضه ُ العَصبُ",91,"ب",1,0],["ثرى الأحباب طهرٌ ، خبريهم","نوارسنا ... وكان لنا سباقُ",92,"ق",1,0],["ثراءُ الفتىٰ أخلاقُهُ حيثما سعىٰ","هي التاجُ للإنسانِ تعلو به قدْرا",93,"ر",2,0],["ثرنا لأجل سيادة يمنية","ولذا أتوا بتحالف ودمارِ",94,"ر",1,0],["ثرنا ولم ينم السلاح عن العدا","فحديث جبهات الوغى أخباري",94,"ر",2,0],["ثروة لا تقل في العم والآداب","عنها في الجاه أو في المال",95,"ل",1,0],["ثُرْنا لأجْل سلامٍ بات مُطَّرحًا","والحربُ تبدو بَصِيصًا ثم تحتدمُ",96,"م",1,0],["ثُرنا لأجْل رخاءٍ ضاع مُذْ زَمَنٍ","فالعيشُ مضطربٌ والصفوُ منعدمُ",96,"م",1,0],["ثُرنا لعزَّةِ نفسٍ سام عزَّتَها","قومٌ أباحوا شقاءً بات يلتهمُ",96,"م",1,0],["ثرواتنا تمضي بنا نحوالهلاكْ","فإلى متى سنظلُّ صيدًا في الشِّباكْ",97,"ك",1,1],["ثرثرْ وثرثرْ ريثما الأيامُ","تنهيك منها والوفاة تُدامُ",98,"م",1,1],["ثر وأشعل يا مغرب الثورا","واملأ الدنيا كلها نصرا",99,"ر",2,0],["ثرثر وأمطر بالحديث مدائني","فحديثكَ المائي يروي لو همى",100,"م",2,0],["ثَرْثَرَاتُ الشِّعْرِ _قَدْرًا_","لا تَفِي بَعْضَ البَشَرْ",101,"ر",1,0],["ثُرْتُ , ثَارَ الإلْحَاحُ فِيَّ , اكْبَحِينِي","أَو فَرُدِّي عَلَيَّ نَارِي انْتِقَاما",102,"م",2,0],["ثروةٌ ، يا نعمّها ، كم تفادى","وقضى في ادّخارها الآباءُ ،",103,"ا",2,0],["ثرًى أم ثراءً وطِئْت؟ وحِرتُ..","وليستْ لغاتُ الحيارى أمينهْ",104,"ن",2,0],["ثَرِيَ النَّاسُ في الحَيَاةِ وكانَتْ","في مَدَى العُمْرِ ثَرْوَةُ الحُبِّ حَسْبِي",105,"ب",2,0],["ثَرَاءٌ وَ إِمْلَاقٌ وَ عِزٌّ وَ ذِلَّةٌ","مُلُوكٌ وَ شَعْبٌ عَيْشُهُ الْكَبْتُ وَ الْكَظْمُ",106,"م",1,0],["ثراها سرى في أغنياتي فأشرقت","كأن مرايا الأغنيات ترابها",107,"ب",3,0]]}