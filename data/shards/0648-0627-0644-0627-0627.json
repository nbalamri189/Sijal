أعمى","https://www.poetsgate.com/ViewPoem.aspx?id=34993",""],[5401,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=78116",""],[5401,"ضابط الإيقاع","https://www.poetsgate.com/ViewPoem.aspx?id=78141",""],[5401,"سجن المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=85961",""],[5525,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=7255",""],[5606,"ترى الزعل ممنوع يامودماني","https://www.poetsgate.com/ViewPoem.aspx?id=195382",""],[5615,"رسالة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=187951",""],[5652,"حب الرعاييب","https://www.poetsgate.com/ViewPoem.aspx?id=206702",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5747,"ياسعود لاترقد وانا بخاطري ضيق","https://www.poetsgate.com/ViewPoem.aspx?id=61686",""],[5755,"حظ الحفاة العراه","https://www.poetsgate.com/ViewPoem.aspx?id=133252",""],[5756,"الاولي والتالي","https://www.poetsgate.com/ViewPoem.aspx?id=5415",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5848,"فلسطين وبغداد","https://www.poetsgate.com/ViewPoem.aspx?id=50587",""],[5848,"يصير خير","https://www.poetsgate.com/ViewPoem.aspx?id=53208",""],[5848,"بصحة الامي","https://www.poetsgate.com/ViewPoem.aspx?id=52028",""],[5848,"سرحان عبدالصبور","https://www.poetsgate.com/ViewPoem.aspx?id=53460",""],[5848,"شفة غياب","https://www.poetsgate.com/ViewPoem.aspx?id=53330",""],[5848,"أسأل جروحي","https://www.poetsgate.com/ViewPoem.aspx?id=50602",""],[5848,"أنت الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=50535",""],[5848,"ليل السهر","https://www.poetsgate.com/ViewPoem.aspx?id=48819",""],[5877,"الكيف","https://www.poetsgate.com/ViewPoem.aspx?id=52287",""],[5939,"لصة الأفئدة","https://www.poetsgate.com/ViewPoem.aspx?id=195293",""],[5950,"مريم ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128336",""],[5976,"القلب داعي له","https://www.poetsgate.com/ViewPoem.aspx?id=32522",""],[5976,"يا بو سعد ..","https://www.poetsgate.com/ViewPoem.aspx?id=35084",""],[6008,"من الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=60806",""],[6056,"الشعر أكذبه  أعذبه","https://www.poetsgate.com/ViewPoem.aspx?id=130138",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6056,"الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=130328",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6100,"قضية تيسير علوني","https://www.poetsgate.com/ViewPoem.aspx?id=52599",""],[6100,"اشتقت لأنفاسك","https://www.poetsgate.com/ViewPoem.aspx?id=52589",""],[6115,"ماعاد اجامل ولا حسب رضى الناس","https://www.poetsgate.com/ViewPoem.aspx?id=180501",""]],"verses":[["وَإِلّا اِقتُلوني أَستَرِح مِن عَذابِكُم","عَذابُكُمُ عِندي أَشَدُّ مِنَ القَتلِ",0,"ل",1,0],["وَإِلّا اِنتَحَتكَ جُيوشُ العِتابِ","مُناجِزَةً في قَضيضٍ وَقَضّ",1,"ض",1,0],["وَإِلّا الفَرقَدَينِ وَآلَ نَعشٍ","خَوالِدَ ما تَحَدَّثُ بِاِنهِدامِ",2,"م",1,0],["وَإِلّا اِمرَأً قَد نالَهُ مِن سُيوفِنا","ذُبابٌ فَأَمسى مائِلَ الشِقِّ أَعزَلا",3,"ل",2,0],["وَإِلّا أَبَحناكُم وَسُقنا نِساءَكُم","بِصُمِّ القَنا وَالمُقرَباتِ الصَلادِمِ",4,"م",1,0],["وإلا انظرا من خاله فوق خده","إلى خير نارٍ عندها خير مصطل",5,"ل",1,0],["وإلاَّ أَريجُ الزُّهُورِ الصُّبَاحِ","ورقصُ الأَشعَّةِ بَيْنَ الميَاهْ",6,"ا",2,0],["وَإِلا اِعتَرَتني زَفرَةٌ وَاِستِكانَةٌ","وَجادَ لَها سَجلٌ مِنَ الدَمعِ يَذرِفُ",7,"ف",1,0],["وَأَلّا أَعَدّوا بَأسَهُ وَانتِقامَهُ","لِكَبشِ العَدُوِّ المُستَميتِ المُناطِحِ",8,"ح",1,0],["وَإِلّا السَماءَ وَالبِلادَ وَرَبَّنا","وَأَيّامَنا مَعدودَةً وَاللَيالِيا",9,"ي",2,0],["وَإِلّا أَن تَبيدَ سَراةُ بَكرٍ","فَلا يَبقى لَها أَبَداً أَثارُ",10,"ر",1,0],["وَإلاَّ أَيُّ مَنْفَعَةٍ بِقَوْمٍ","إذَا اسْتَحْفَظْتَهُمْ لاَ يَحْفَظُونا",11,"ن",2,0],["وإلا أبنْه في العُصاةِ فإنّني","أرى شارباً منهم يميل مُرَنَّحا",12,"ح",2,0],["وألا ألاقي روحك الطيب الذي","كأن ذكي المسك كان له جسما",13,"م",2,0],["وَإلاَّ إلى ضَرْبِ الرِّقابِ مَصيرُ","فلما أحسُّوا بأسَ أغلبَ همَّة ً",14,"ه",1,0],["وألاّ أنت كامل لاكن أن فيك عاقه","ينقص برستجيك شويّة جروّه",15,"و",2,0],["وإِلاَّ أكؤُساً مهما دَنَت مِن","مُعَنًّى بالدِّنَانِ هَجَا الدِّنَانَا",16,"ن",2,0],["وإلا الأمر أمرك والقلوب لديكم","إلا بقايا أعظم وجلود",17,"د",1,0],["وَإِلّا الدَمعُ أَنثُره عَقيقا","على ذكرى حُلاكَ الغائِباتِ",18,"ت",1,0],["وَإِلّا أَعيناني على النَوحِ وَالبُكا","فَشَأنُكما شَأني وما بِكُما بِيا",19,"ي",2,0],["وإلّا اصمت ودع ما ليس يعني","فأمر الدين في هذين دائر",20,"ر",1,0],["وَإِلّا أَروني فاضِلاً لَيسَ عِندَه","لِمَعنٍ يَدٌ يَوماً وَلا سِيَّما عِندي",21,"د",2,0],["وَإلا أَزِمّةُ دارٍ غَدَتْ","بِهِمْ حُرُماً أُمَنَا لِلحَريمِ",22,"م",1,0],["وَأَلّا أَكُرَّ القَلبَ صُبحاً أَمامِيا","وَأَلّا أَجُرَّ الطَرفَ لَيلاً وَرائِيا",23,"ي",2,0],["وإلا الذي أعطاه فهاً إلهُهُ","بأياته فاسأل عساك تجاب",24,"ب",1,0],["وإلا القدود عذارى رقص","ن فظلت تناقل أسيافها",25,"ف",3,0],["وَإِلّا اِنتجاءٌ بالهوى وتحدّثٌ","صقيلُ حواشي الطُّرَّتين أنيقُ",26,"ق",1,0],["وإِلا الصديقُ وإِلاَّ الصَّدُوقُ","وإِلاَّ الصفيُّ وإِلاَّ الصَّفاءُ",27,"ا",2,0],["وإلا استهلت عبرةٌ بعد زفرةٍ","يصدع قلبي أن يُلِمَّ صعودها",28,"د",3,0],["والا أن تطوّحها الرزايا","وأن تسبى وترسف بالقيود",29,"د",1,0],["وَإِلّا أَكُن أَهلاً لِفَضلٍ وَرَحمَةٍ","فَرَبِّيَ أَهلُ الفَضلِ وَالرَحَماتِ",30,"ت",1,0],["وإلاَّ أَصادفْ مثلكم لي سادةً","فلن تظفروا في الدّهر مثلي بخادمِ",31,"م",1,0],["وَإِلّا اِصطِباراً عَلى النائِبا","تِ وَالمَرءُ يَمنَعُ مَن قَد أَجارا",32,"ر",2,0],["وإِلاَّ أَنَلْ ثَأْرِي مِن اليَومِ أَجْزِهِ","بما قَدَّمَتْ كَفَّاهُ في مَعْبَدٍ غَدَا",33,"د",2,0],["وإلاّ أدم مقصِراً من رجاي","ولم أرَ للعتبِ يوماً مُطِيلا",34,"ل",2,0],["وَإِلّا أَخبرينا","عَن المستهترينا",35,"ن",2,0],["وإلا اختيالي في ذُرى صَهَوَاتها","وقد نظرتْ شزراً إليَّ المهالك",36,"ك",1,0],["وإلا أروني مثل عثمان صهره","وشبه أبي السبطين حيدرة الزفر",37,"ر",1,0],["وإلا أقيد المتقى ولأهله","به النصف يعطى الضارب المترفلُ",38,"ل",1,0],["وإلا أكن عين الجواد فإنني","على المال في الظلماء غيرُ لئيم",39,"م",1,0],["وإِلَّا أكُن كُلَّ الجوادِ فإنني","على الزَّادِ في الظَلماءِ غَيرُ شتيم",40,"م",1,0],["وإلا أَكُن كُلَّ الشجاعِ فإنّني","بضرب الطُّلا والهامِ حقُّ عليم",40,"م",1,0],["وِالّا أنا ظَنّي انْشَطّيت","والسدّ منَّي والعقل راح",41,"ح",1,0],["والّا الردي إن مات وان حِيّ وِشْ عاد","ما تنفقد غير القروم العوادي",42,"د",2,0],["والا اعطيته مسوع","في الجنه يضربني",43,"ن",2,0],["وإلاّ الثريَّا والسِّماكُ لعاجزٍ","عَنِ الجوشِ حتّى يرجِعَ المَوجُ نافِر",44,"ر",1,0],["وَإِلّا النَعامَ وَحَفّانَهُ","وَطَغيا مِنَ اللَهَقِ الناشِطِ",45,"ط",1,0],["وإلا اقبلي أو أنظري أو تحدثي","إلي ولو بالعتب أو بالمعاذل",46,"ل",1,0],["والّا أنا بيحول ما حال","دوني ولا بِتْطال لِيدين",47,"ن",1,0],["وَإِلا اذكُرَنْ لَيلي وَعَهديَ بِاللَوى","فَثمَّ حَبيبٌ لي وَعَهدٌ وَمَنزل",48,"ل",1,0],["وَإِلا استرجعت زَمناً هنيئاً","تولّى وهيَ بكرٌ في الزَمان",49,"ن",1,0],["وإلا الذي أعطاه فهماً إلهه","باياته فاسئل عساك تجاب",50,"ب",1,0],["وإلا اقتداءٌ واقتفاءٌ لذي عمى","عليه قرينه امتطى وهو ملجمُ",51,"م",1,0],["والا التقينا في بحر وسط نطفه","نجمع لآلي الشعر فيها غواطيس",52,"س",1,0],["والا انطوى الليل ونهاره يلفه","اليا لعب لي والخلايق مناعيس",52,"س",1,0],["وإلاّ أنّها في غايتي خيَّر تنِيْ","وأختار أنا مرباع قلبي وصيفه",53,"ف",2,0],["والا اخذهم يا مجري سود الحقاب ..",".. أخذ العجوز اللي بقت في الغابرين",54,"ن",1,0],["والا انت ياللي جيش عينيك مقدام","لا اقنعت منك والرجا مارجيتك",55,"ك",1,0],["وإلا انت . ردك كُل مادعيك لبيه","انشهدٍ منتوا بفي عيني اشباه",56,"ا",2,0],["والا انت وافي والوفا ما يخليك","والطيب بصلك ما خفاك وخفاني",57,"ن",2,0],["والا البشر ما عمرهم بشروني","قوم ن تخالف وجهة الدين والقوم",58,"م",1,0],["والا الردي طارف وعنه آتحاشا","وشرواك ياخالد يزيد انتعاشي",59,"ش",2,0],["والا انحرم .. من حتى نبرة سمآعه","والإبتسآمه وْالكرم في عطآيآه",60,"ا",2,0],["والا الذي يكشف خوافيه لانسان","عليه خيبات السنين استضاحت",61,"ت",1,0],["والا الوفي يبقا زعيم الطلاقه","ومن ما اقوله مايفكر يضيقي",62,"ق",2,0],["وألا انتي زينك ماخذٍ دور كشختك","مشيك اسآور والحكي طوق والماس",63,"س",1,0],["والا انا من يوم قلت احتريني","ألين مااتشفقت بيني وبينك",64,"ك",1,0],["والا الكرم ماهو بطرسٍ وتحبير","الجار وهو الجار يمسي غناوي",65,"ا",3,0],["وإلا البلد هذا متبلد ومسحور","يسحرهم الساحر وهم معه كهان",66,"ن",1,0],["وإلا التزم بالحق إن كنت صادقا","مصالح من أوْلَوْك إن تتعظ أولى",67,"ل",2,0],["وإلا القصايد جعلها من فداياك","لبستها مبطي ثياب الحدادي",68,"د",2,0],["والا الرجال اللي لهم بالوفا باع","وقفاتهم تبري الجروح العطايب",69,"ب",1,0],["وإلا أقولك أستمع هاالحكايا","عيشة تعاسة مع تنهّات والنوح",70,"ح",1,0],["وإلا الهبايب لو تحنّ الخطاوي","ماكان أبد عاشق نسا وصل معشوق",71,"ق",1,0],["وألا النفود اللي انبنت كل خذله","نزجر ننادي مهمهٍ من يبالي ؟!",72,"ل",2,0],["وألا أشقرٍ حامت عليه النواشيب","والريش راح ولا تفيده اسلاله",73,"ل",2,0],["وألا اْمسحي جرحك على ثوب خيال","إن كان يحملها على نور عينه",74,"ن",2,0],["والاّ اركع اليا هوّد الليل ركعات","وقت السحر والليل مسدل سواده",75,"د",2,0],["والاّ اهدني نور صبحك والوئام","ب الوانك ارسم واشيّد متحفي",76,"ف",2,0],["والاّ اهدني حرب مابعده سلام","والاّ اهدني قرب مابعده نفي",76,"ف",2,0],["والا المثل قد قال من باح بالسد","لاتصاحبه لكن مره وعده",77,"د",2,0],["والاّ السنين (الوهم) ................... آذانها صمّا","هذا الهوى فارغ وكاسه ....... وهم ثاني",78,"ن",2,0],["والاانا يابنت حظي منك طوّووح","كيف اسوّي في غرامي يااجوديه",79,"ي",2,0],["والا الشمالي راح يضرب يَدّ يَدّ","من حيرته مغير يفتل في اشنبه",80,"ب",2,0],["وألا أتركوني على مرقابي المُشتهر","يمين واد الحويه في قرار الحزوم",81,"م",1,0],["والا الخبيث بمنسم الرجل ناطاه","يوم الغدر والخبث عنده طبيعه",82,"ع",2,0],["وألا أنت مثل الطيف لك سبعة ألوان","لاقلت ذاعلمك بدى علم ثاني",83,"ن",2,0],["وإِلَّا الجَهرُ فِيهِ ، لَعَلَّ يَومًا","تَحِنُّ ، وتَرتضي يَومًا وِصَالَهْ",84,"ل",2,0],["والا الغرير الي جهل بالشلاهيب","اليا أدلهمت يبتلش ب إنفراجه",85,"ج",2,0],["وإلا اندفع الشعب","إلى ثورته الحمرا",86,"ر",2,0],["والا السعاده كلبوها تلافيق","عزي لقلبٍ فوق حام المليله",87,"ل",2,0],["والا انت يالوقت تعطيني امل فالحياه","وبثانيه ينقطع هذا الامل ويغَدي",88,"د",2,0],["والا انا ما كنت ابين لا أمطرت ديمومة","بالمدامع من فراق المخلصين امثالي",89,"ل",2,0],["والا أنا قلبي بقى لي بالمحبة راس مال","والله اللي مبتليني بالهوى والله يعين",90,"ن",1,0],["والا انت يا صدام خالي من الدين","مواقفك قشرا قديمات وجداد",91,"د",1,0],["والا انا من ليلة العام معدوم المصير","ليلة الوصل بمشاعر غلاك ارّختها",92,"ت",3,0],["والا انت يا سالفة عمري وعنقوده","شربت حزنك وانا من فرحتك ظامي",93,"م",2,0],["والا انت ياللي يدينك تستفز الحرير","مافيه غيرك شغل قلبي ولا شب نار",94,"ر",1,0],["والا الشعر مافيه غير الرحابه","لو الوجع يمشي على قلبي اسراب",95,"ب",1,0],["والا التعب مستيقظٍ بي بدري","مع صحوته من غفوته صحّاني",96,"ن",2,0],["والا انا صارت اعصابي زجاج","وذكرياتي حجارٍ ما تلين",97,"ن",1,0],["والا السهر .. من جنوني تنبت احلامي","على نجومه .. وهي تقطف تناهيدي",98,"د",2,0],["والا الردي .. يا سعود بالشر له فال","عوّد على طرد الهزايل خيوله",99,"ل",2,0],["وإلا امنحيني فؤادَكِ تَوًّا","تَساوتْ بواحدةٍ واحدةْ",100,"د",2,0],["وإلا إسقي عروقي الذبلى بكاس الغرام","وأنفخ لك الروح في عظم الكلام الرميم",101,"م",1,0],["والا الذي راح ما لبّى معه شفّي","مانيب في حاجته والقلب داعي له",102,"ل",2,0],["والا الشمالي حشمته .. ماهو منّه جاي","يأبى لميلة عقال الحاتمي يشبه .. !!",103,"ب",2,0],["والا الردي لوكان بيته زجاجي","مازاد قدره في زيادة رصيده",104,"د",2,0],["وإلا البعض هرجهم بألفاظ محسوبة","إلى اشتروا سلعة ٍ ، ماهيب تنباعي",105,"ع",2,0],["وإلاّ العدو ، لابد له يوم زايل","يموت وهمومه بصدره ، مدافيش",106,"ش",1,0],["وإلا الولد،، مهما كبر باللين ممكن تقنعه","ما فيه أحد عايش بها لدنيا بلا عيب ونزيه",107,"ي",2,0],["وإلاّ الشعر باب ٍ من الكل مطروق","هروج ٍ ينقّط من حلاها ، شهدها",108,"د",3,0],["وإلاّ الغشيم اللي بلا دلو ، وحبال","يهلك .!وظنه كل رمّاي صايد",109,"د",1,0],["والا انت تبقى يامحقق كوني","اسبيس تون تخبل الورعاني",110,"ن",2,0],["والا انت تدري اسهل السهل جيبتّك \"","أخاف أفج بنحر الاوجاع بابك",111,"ك",1,0],["والا الدجاجه مليئه طيب واحساس","تشبعك بالبيض وتزيد اللجاجه",112,"ج",2,0]]}