abi.ae/diwan/poem/106840","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106911","الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137116",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137001",""],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82891","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129875","الكامل"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48060","الكامل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70315","الرمل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[2812,"","https://poetry.dctabudhabi.ae/diwan/poem/146153","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146318","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58490","الطويل"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76539","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91715","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54335","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81271","الكامل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143037","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58148","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4728,"راوية","https://www.poetsgate.com/ViewPoem.aspx?id=176881",""],[1901,"ليَ الله ما ننفكّ ترفضُ أدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=160399",""],[4981,"إليكَ صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=190498",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[1043,"الخيبة","https://www.poetsgate.com/ViewPoem.aspx?id=97208",""],[5281,"حُسنُ الخِتامِ","https://www.poetsgate.com/ViewPoem.aspx?id=200234",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5388,"أفديك لولا الرّدى","https://www.poetsgate.com/ViewPoem.aspx?id=206907",""],[5652,"وشلون هانت عشرتي واتركوني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=165471",""],[5652,"لاهو ب رجالٍ ولاهو رجيجيل","https://www.poetsgate.com/ViewPoem.aspx?id=198328",""],[5732,"مصايب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=177822",""],[5751,"قُبْلةٌ بَينَ عَينَيكْ","https://www.poetsgate.com/ViewPoem.aspx?id=214767",""],[520,"شغل الزمان بما تقول وتفعل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577611",""],[4222,"قد أضاء الزمان بالمستضيء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52712&r=&rc=4",""]],"verses":[["وَلَقَينَ بَعدَكَ كُلَّ صُبحٍ ضاحِكٍ","يَوماً أَغَمَّ وَلَيلَةً لَيلاءَ",0,"ا",2,0],["وَلَقيتُ في قُبُلِ الهَجيرِ كَتيبَةً","فَطَعَنتُ أَوَّلَ فارِسٍ أَولاها",1,"ا",3,0],["ولَقيتُ منْ بِرٍّ وخَيْ","رٍمِلْءَ سَمْعيَ والبَصَرْ",2,"ر",1,0],["وَلَقِيتُها تَمشِي بأَبطَحَ مَرَّةً","بِخَلاَخِلٍ وَبِحُلَّةٍ أَكبَاشِ",3,"ش",1,0],["ولقيت شاعرها الذي ارتفعت له","كفّ القريض مشيرةً ببنان",4,"ن",1,0],["وَلَقيتَ رايَةَ آلِ قَيسٍ دونَها","مِثلُ الجِمالِ طُلينَ بِالقَطِرانِ",5,"ن",1,0],["وَلَقيتَ دوني مِن خُزَيمَةَ مَعشَراً","وَشَقاشِقاً بَذَخَت عَلَيكَ طِوالا",6,"ل",2,0],["ولُقِّيتَ الإقالَةَ من قريبٍ","موقّىً كلَّ نائبةٍ تنوبُ",7,"ب",1,0],["ولقيتَني فلقيتني متهلِّلاً","كالغيث بشَّر بالمعاش الراغِد",8,"د",1,0],["ولقيتُ في دنيا الخَيالِ سَلامي","ونسيت دنيا الناس فهي سخافة",9,"ه",1,0],["ولقيت في الحنفى من يسعى له","برسالة مفتوحة وكتاب",10,"ب",1,0],["وَلَقيتُ كُلَّ الفاضِلينَ كَأَنَّما","رَدَّ الإِلَهُ نُفوسَهُم وَالأَعصُرا",11,"ر",2,0],["وَلَقَينا شَمائِلاً تَنثُرُ المِس","كَ سَحيقاً كَما لَقينا الشُمولا",12,"ل",2,0],["ولقينا الحسنَ غَضّاً والصّبا","وتملَّينَا الجلالَ الأبدِيَّا",13,"ي",2,0],["ولقيتَ الكريمَ والمرتجى مِنْ","فضلِه أنْ تنالَ ما تتمنى",14,"ن",2,0],["وَلَقَّيتَهُ ريحَ المَهابَةِ بارِحاً","فَأَقلَعَ إِقلاعَ الغَمامَةِ تَقشَعُ",15,"ع",1,0],["وَلَقيتُ مِن قَومٍ ذَوي إِحَنٍ","لَجَبَت صُدورُهُمُ مِنَ الطَعنِ",16,"ن",1,0],["وَلَقيتُ عَيّاراً فَجَرَّحَني","وَقَعَت خَناجِرُهُ عَلى كَبِدي",17,"د",2,0],["وَلَقيتُها كَالخَمرِ صافِيَةً","حَلَّت لِشارِبِها وَما شَرِبا",18,"ب",2,0],["وَلَقيتَ رَبّكَ فاستَرَدّ لك الهُدى","ما نالَتِ الأيّامُ بالإتْلافِ",19,"ف",1,0],["وَلقيت فيما قد لقي","تُ بموطني نحساً وَسعدا",20,"د",2,0],["ولقِيتُ غيركِ غير أنَّ حُشاشتي","لم تَلقَ غير الوقدِ والإرماضِ",21,"ض",1,0],["وَلَقيتُ الأَبطالَ في كُلِّ حَربٍ","وَهَزَمتُ الرِجالَ في كُلِّ وادي",22,"د",2,0],["ولَقِيتُ الأَحْبَابَ وَالأَهْلَ فِي سَا","حَاتِ أُنْسٍ طَلْقٍ وَبَاحَاتِ جُود",23,"د",1,0],["ولقيتِ من عَسْفِ العدوِّ وكيدِه","دونَ الذي لاقيتِ من أهليكِ",24,"ك",1,0],["ولقيت وجهك بالبشا","شة وهي أطراف الرماح",25,"ح",1,0],["ولُقِّيتَ الإفالَة َ من قريبٍ","موقًّى كلَّ نائبة ٍ تنوبُ",26,"ب",1,0],["ولقيتُ ما سرَّ الصديقَ وساء من","عادَي فأَخْزاهُ عَقيبَ شَماته",27,"ت",2,0],["ولَقِيتُ مِن أمرِ الصِّيَامِ وحَرِّهِ","أمرَينِ قِيسا بالعَذَابِ المُؤصَدِ",28,"د",1,0],["وَلقيت منه لدى الشدائد أنعما","وَجعلته لمنال فَخري سلما",29,"م",2,0],["وَلَقيتُ ما لا أستَقِلُّ بِوَصفِهِ","وَإِنِ ادَّعيت مزِيَّةَ استِقلالِ",30,"ل",1,0],["وَلقياك الخليلَ وَإنْ أخفَتْ","وسرّتْ عنك تذكرك الجليلا",31,"ل",2,0],["وَلَقيتَ أُنسا بالّذي قدّمته","مِن صالحٍ يُنميه فضل أوسعُ",32,"ع",1,0],["ولقيتني فنسيت فيك","تعاستي ونسيت عمري",33,"ي",1,0],["وَلَقِيتُ عَنْتَرَ إذْ مُنِيتُ بِفاصِدٍ","ذِي رِيشَةٍ سَقَطَتْ عليَّ كَيذْبُلِ",34,"ل",1,1],["وَلَقيتُ من ثَكَلٍ وَمغبَطَةٍ","وَالدَهرُ من طَلقٍ ومن نَحسِ",35,"س",1,0],["وَلَقيتُ بَعدَكَ أُمَّةً لَكِنَّني","فارَقتُ مِنكُم واحِداً بِأَئِمَّةِ",36,"ه",1,0],["وَلَقيتُ ما لَم يَكفِهِ صَبري وَلَم","يَثبُت لِرَوعَةِ ما جَناهُ جَناني",37,"ن",2,0],["ولقيتُ مِن أجفانِهِن","نَ مُقاتِلاً ومُحرِّضا",38,"ض",2,0],["وَلقيتُ ما لَقِيَت مَعَدٌّ كُلُّها","وفَقَدتُ راحِي في الشَّبابِ وخَالي",39,"ي",1,0],["ولقيت من أهل الديانة والتُّقى","قوماً هم الأعلام في الأعلام",40,"م",1,0],["وَلَقيتُ نِعمَتِهِ بِأَحسَن خُلَةٍ","تَلقى بِها النعماء عِند ورودِها",41,"د",3,0],["ولُقِّيْتَهُ عيْدَ فَأْلٍ بوَعْدٍ","لِنَصْرِكَ يَقْرُو عِدَاكَ الوعيدا",42,"د",2,0],["ولُقِّيتِ فِي ضَنْكِ ذَاكَ الضَّريحِ","نسيمَ النعيم وطِيبَ الثَّواءِ",43,"ا",2,0],["ولقيتُ قوماً دونكم كرهوا","أيّامَكم بقواصم الظهرِ",44,"ر",1,0],["وَلَقيتَ حَيّاً في الحُروبِ مَحَلُّهُم","وَالجَيشُ بِاِسمِ أَبيهِمُ يُستَهزَمُ",45,"م",1,0],["ولقيت عيد الفطر منك بغرة","أضحى ببهجتها يهنا العيد",46,"د",1,0],["ولقيتمو عنها القتال بمثله","من بعدما انكشفت وبان المقتل",47,"ل",1,0],["ولقيتها بكرامة من أجلها","قعد الرجال الحاسدون وقاموا",48,"م",3,0],["وَلَقى القَومُ بِالذَنائِبِ منّا","إِذ كَشَفنا الخُلودَ مَوتاً ذُباحا",49,"ح",2,0],["ولقيتَ من عفو الإلهِ وصفحهِ","فوقَ الّذي ترجو بغير مِطالِ",50,"ل",1,0],["ولقيتنِي مُتخشِّعاً لا يُرتَجى","نَفعي ولا يُخشى العشيّةَ باسي",51,"س",2,0],["وَلَقيتُ فيكِ مِنَ العناءِ غَرائباً","وَأَخذتُ مِن أَدهى البلاءِ ضروبا",52,"ب",2,0],["ولقيصر الرأي الحصيف فإنه","في القوم محترم وقور أمجد",53,"د",1,0],["ولقيتني بتجهّمٍ","فالكلب منك إليّ أعجب",54,"ب",1,0],["وَلَقيتهُم لَقيَ الأَعا","جِمِ كَالجَرادِ المُرتَدِفِ",55,"ف",1,1],["ولقيت عيدك ألف عام عائد","بسعادة تبقى وعز سرمدِ",56,"د",1,0],["ولقيت السعد يترى","في غدو ورواح",57,"ح",1,0],["ولقيت عيدك عائدا أبدا","في دولتي عز وتمكينِ",58,"ن",1,0],["وَلَقِيتَ أسْبَابَ الهنا","وَوُقِيتَ دَائِرة التلفْ",59,"ف",1,0],["ولقيت أنسا في البعاد وسلوةً","وقنعت من سفر بحسن ايابي",60,"ي",1,0],["ولقيت أعظم فجعةٍ وغرقت في","بحر النكال وحرت بالأمرينِ",61,"ن",1,0],["ولُقّيتَ سَعْداً إِذا العيدُ عادَ","ولُقّيتَ رُشْداً إِذا الحَوْلُ حالا",62,"ل",2,0],["ولقيت أيامي بحظ أبيض","لما لثمت سواد ذاك الخال",63,"ل",1,0],["ولقيت أَثقال السُّرى وحَمَلتها","على يَعملاتٍ كالقسيِّ ضوامِرِ",64,"ر",1,0],["ولقيتُ أشرَفهم يداً وأيادياً","وأدقَّهم نظَراً وأبهى منظرا",65,"ا",1,0],["ولقيتما فرحَ الدّنا وعمارها","وكُفيتما مكروهها وحِذارَها",65,"ا",1,0],["ولقيتُ حدَّ الحادثاتِ به","فَفَللتُ ذا غربٍ بذي غرب",66,"ب",1,0],["ولقىً إذا وصلَ الخُطَى في مُهْرَقٍ","جاءَتْهُ أعناقُ الخطوبِ تَقَطَّع",67,"ع",1,0],["وَلَقيتَ مِن سُكّانِ ذَيّاكَ الحِمى","إِخوانَ إيناسٍ وَأَهلَ صَلاحِ",68,"ح",1,0],["ولقى الذين تزيلوا","يوماً عبوساً قمطريرا",69,"ر",2,0],["وَلَقَى بَنو زَيَّانَ مِنْ أوصَابِهَا","وَبَنُو مَرِينٍ شِدَّةَ فِي بَأسِ",70,"س",1,0],["ولقياه منا بَعدَ بُعدٍ تقاربت","فو الله لا لقيا تعادل لقياه",71,"ه",1,0],["وَلَقِيتَ في نَصبِ المَكارِمِ وَالعُلى","نَصَباً فَأَنتَ الناصِبُ النَصّابُ",72,"ب",1,0],["وَلَقيتَ فيما قَد كَسِبتَ من العلا","تعبا فألقيت القوافي الشرّدا",73,"د",2,0],["ولقيت المنون تحت عوالي","كَ معداً ذخراً ليوم نشوري",74,"ر",2,0],["وَلَقى ثَوائي اليَومَ ما","عَلِقَت حِبالُ القاطِنِيَّه",75,"ي",2,0],["ولقيد الحمد والشكر غدا","صالحاً في كل فعلٍ مطلق",76,"ق",1,0],["وَلَقيتُ قَوماً ما أَبو الفَضلِ بنِ","الانباريِّ إِلَّا دونَهُم في الخِسَّةِ",77,"ه",1,0],["ولقيتُ خلقاً كل أمرهم","التنازع والخصام",78,"م",1,0],["ولقيتُ منكِ تجنُّباً","حمل الفؤادُ عنيفَهُ",79,"ه",1,0],["ولقيت صاحب تاجها في قصره","والوفد ثم بصحبتي نظار",80,"ر",1,0],["ولقي المذلة الكثيره","من بعد تلك الحظوة الأثيره",81,"ه",1,0],["ولقيت من لافاك فيها حظوة","ما كان غيرك مثلها يتوقع",82,"ع",1,0],["ولقيصر المعلوف غر قصائد","طابت ومنها للنفوس غذاء",83,"ا",2,0],["وَلَقيتَ الرِّجالَ فيه وَزاحَم","تَ عَليه الجَميعَ حتى سَمِعته",84,"ت",2,0],["ولقيتَ من حرب الأعادي شدّةً","لو كابدوها ساعةً لتبَدّدوا",85,"د",3,0],["ولَقيتُ زَيد الخَيلِ تَحْتَ عَجاجَةٍ","يكسو غلائِلُها الجِياد الضُّمَّرا",86,"ر",2,0],["ولقينا بعد لينِ الع","يشةِ الصَّعبَ الشديدا",87,"د",2,0],["ولقينا بساحل العشق حربا","فيه قد أضحت الفوارس أسرى",88,"ر",2,0],["ولقيت منهم من يشق صداره","ولقيت منا من يشق صدورا",89,"ر",2,0],["ولقيتَ وفدَكَ والرّكابَ، بطلعةٍ","تُسْلي عن الأوطان والأعطان",90,"ن",1,0],["ولقَيته الحصنَ الحصينَ وإنّه","لَحُصْنٌ بآيِ اللهِ باتَ منّوراً",91,"ر",2,0],["وَلَقِيتُ أَهوالاً فَلَم أَرَ كَالنَوى","لِحَشايَ أَنكى أَو لِعَهدِيَ أَنكَثا",92,"ث",2,0],["وَلَقيتُ أَحمَدَ في الجِنانِ وَصَحبَهُ","وَالكُلُّ عِندَ لِقائِهِم أَدناني",93,"ن",2,0],["وَلقيت أَيةَ لوعةٍ يَشقى بها","قَلبٌ وَأَيةَ زفرةٍ لا تُخفَض",94,"ض",1,0],["ولَقية لقيت زيداً ونُقل","لِقاءَة بالمد فاعرفه وقل",95,"ل",1,0],["ولقيتُ الدَّهرَ العبوسَ وقد عا","دَ بوجهٍ طَلْقٍ إليَّ وضيْ",96,"ي",1,0],["ولقيتُ سَحْبانَ البلاغةِ ساحباً","ببيانهِ ثوبَ الفخارِ لوائلِ",97,"ل",1,0],["وَلَقيت مِن عنت الزيود مَشاكِلاً","وَبَكيت مِن عمرو وَمِن أَعرابه",98,"ب",2,0],["ولقيت مائرة النشاط مرحباً","بلسان زير واللغات ضروب",99,"ب",1,0],["ولُقِّيت أحوالاً سروراً وضدُّهُ","كذلكَ بُسْرٌ ثم أعقبَهُ العُدْمُ",100,"م",1,0],["ولِقينا من الدواهِي الدواهي","وأصبنا من العوادي العوادي",101,"د",2,0],["ولقيت بأن الهوى لأهل الهوى لا قوى","لا بدّ ما تنقطع به شعْرة معاوية",102,"و",3,0],["ولقينَني نحساً من الحظ لم يزَل","يجيءُ بما أخشى ولم أتوقعِ",103,"ع",1,0],["ولقيتُ فيهِ صداقةً مفقودةً","فكأنّهُ عُطيَا من الرّحمنِ",104,"ن",1,0],["ولقينا ذلّ المتيّم في الدّن","يا ولكن لم نجزها بعتاب",105,"ب",1,0],["ولقيتُ أُنسا في البعاد وسلوةً","وقنعت من سفري بحسن إيابي",106,"ي",1,0],["ولقيتَ الإلهَ في ثوبِ طُهرٍ","فهنيئًا حُسنَ الختامِ (محمّد)",107,"د",1,0],["ولقيت في جل النفوس مراحبا","وكسرت كل أصابع العدوان",108,"ن",1,0],["وَ لَقيتُ في نَفسي شَظايا سَلوةٍ","وسَلمتُ من سَقمي وَ عِشتُ قَذاهُ",109,"ا",2,0],["ولقيتني من ضيق الايام مرتاب","اسأل عليهم وحدتي في ظنوني",110,"ن",2,0],["ولقيتني أطرد .. سرابٍ وتضليل","يوم الوجيه أشباه تطعن قفايا",111,"ا",3,0],["ولقيت يا عوق العديم بن مقرن","الحسد بين الاقربين جنيب",112,"ب",1,0],["ولقيت يا عوق العديم ابن فيصل","رفيقك الأدنى عليك رقيب",112,"ب",1,0],["وَلِقَيصرٍ أحلامُهُ ، وَلِرُستُمٍ","أحلامُهُ ، فَإِلى مَتى يَستَقْبِلُ ؟!!",113,"ل",1,0],["ولقيتم عنها القتال بمثله","من بعد ما انكشفت وبان المقتل",114,"ل",1,0],["ولقيت الدهر العبوس وقد عاد","بوجه طلق إلي وضيء",115,"ي",2,0]]}