{"poems":[[55,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[3,"يا عبل أين من المنية مهربي","https://www.aldiwan.net/poem116.html",""],[79,"كفلت عنايتك الجميلة","https://www.aldiwan.net/poem36466.html","مجزوء الكامل"],[43,"طرب الفؤاد لطيف روضة غاشي","https://www.aldiwan.net/poem42372.html","الكامل"],[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[29,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[29,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[53,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[53,"أنجز مواعدك التي قدمتها","https://www.aldiwan.net/poem61860.html","الكامل"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[87,"لما رأيت جباه قوم في الثرى","https://www.aldiwan.net/poem7575.html","الكامل"],[45,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[47,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[99,"يا حنانا كيد الآسي الرؤوم","https://www.aldiwan.net/poem24775.html","الرمل"],[71,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[76,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[54,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[54,"يا صاحبي عصيت ذا فند","https://www.aldiwan.net/poem27127.html","الكامل"],[52,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[48,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39636","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9919","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[111,"أبلغ إليك رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=536",""],[53,"وَقَتْكَ يدُ الإله أبا عليٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=26847",""],[189,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[266,"أدعوك بالرحم التي هي جمعت","https://www.aldiwan.net/poem68215.html","الكامل"],[275,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[279,"بشراي هذا مبدأ الإقبال","https://www.aldiwan.net/poem25535.html","الكامل"],[302,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[309,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[332,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[352,"ولقيت عنتر إذ منيت بفاصد","https://www.aldiwan.net/poem20646.html","الكامل"],[354,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[370,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[370,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[375,"أهواك أم جمر الغضا","https://www.aldiwan.net/poem57347.html","مجزوء الكامل"],[402,"هل غيرُ أن كثُر الأشر وأهلكت","https://www.aldiwan.net/poem695.html",""],[407,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[410,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[443,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[443,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[461,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[474,"ولقد دعوت طريفُ دعوة جاهلٍ","https://www.aldiwan.net/poem755.html",""],[518,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[518,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[518,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[546,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[554,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[554,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[554,"عادت إلي بغيضة فتوددت","https://www.aldiwan.net/poem48072.html","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20919","الكامل"]],"verses":[["وَلَقَينَ بَعدَكَ كُلَّ صُبحٍ ضاحِكٍ","يَوماً أَغَمَّ وَلَيلَةً لَيلاءَ",0,"ا",2,0],["وَلَقيتُ في قُبُلِ الهَجيرِ كَتيبَةً","فَطَعَنتُ أَوَّلَ فارِسٍ أَولاها",1,"ا",3,0],["ولَقيتُ منْ بِرٍّ وخَيْ","رٍمِلْءَ سَمْعيَ والبَصَرْ",2,"ر",1,0],["وَلَقِيتُها تَمشِي بأَبطَحَ مَرَّةً","بِخَلاَخِلٍ وَبِحُلَّةٍ أَكبَاشِ",3,"ش",1,0],["ولقيت شاعرها الذي ارتفعت له","كفّ القريض مشيرةً ببنان",4,"ن",1,0],["وَلَقيتَ رايَةَ آلِ قَيسٍ دونَها","مِثلُ الجِمالِ طُلينَ بِالقَطِرانِ",5,"ن",1,0],["وَلَقيتَ دوني مِن خُزَيمَةَ مَعشَراً","وَشَقاشِقاً بَذَخَت عَلَيكَ طِوالا",6,"ل",2,0],["ولُقِّيتَ الإقالَةَ من قريبٍ","موقّىً كلَّ نائبةٍ تنوبُ",7,"ب",1,0],["ولقيتَني فلقيتني متهلِّلاً","كالغيث بشَّر بالمعاش الراغِد",8,"د",1,0],["ولقيتُ في دنيا الخَيالِ سَلامي","ونسيت دنيا الناس فهي سخافة",9,"ه",1,0],["ولقيت في الحنفى من يسعى له","برسالة مفتوحة وكتاب",10,"ب",1,0],["وَلَقيتُ كُلَّ الفاضِلينَ كَأَنَّما","رَدَّ الإِلَهُ نُفوسَهُم وَالأَعصُرا",11,"ر",2,0],["وَلَقَينا شَمائِلاً تَنثُرُ المِس","كَ سَحيقاً كَما لَقينا الشُمولا",12,"ل",2,0],["ولقينا الحسنَ غَضّاً والصّبا","وتملَّينَا الجلالَ الأبدِيَّا",13,"ي",2,0],["ولقيتَ الكريمَ والمرتجى مِنْ","فضلِه أنْ تنالَ ما تتمنى",14,"ن",2,0],["وَلَقَّيتَهُ ريحَ المَهابَةِ بارِحاً","فَأَقلَعَ إِقلاعَ الغَمامَةِ تَقشَعُ",15,"ع",1,0],["وَلَقيتُ مِن قَومٍ ذَوي إِحَنٍ","لَجَبَت صُدورُهُمُ مِنَ الطَعنِ",16,"ن",1,0],["وَلَقيتُ عَيّاراً فَجَرَّحَني","وَقَعَت خَناجِرُهُ عَلى كَبِدي",17,"د",2,0],["وَلَقيتُها كَالخَمرِ صافِيَةً","حَلَّت لِشارِبِها وَما شَرِبا",18,"ب",2,0],["وَلَقيتَ رَبّكَ فاستَرَدّ لك الهُدى","ما نالَتِ الأيّامُ بالإتْلافِ",19,"ف",1,0],["وَلقيت فيما قد لقي","تُ بموطني نحساً وَسعدا",20,"د",2,0],["ولقِيتُ غيركِ غير أنَّ حُشاشتي","لم تَلقَ غير الوقدِ والإرماضِ",21,"ض",1,0],["وَلَقيتُ الأَبطالَ في كُلِّ حَربٍ","وَهَزَمتُ الرِجالَ في كُلِّ وادي",22,"د",2,0],["ولَقِيتُ الأَحْبَابَ وَالأَهْلَ فِي سَا","حَاتِ أُنْسٍ طَلْقٍ وَبَاحَاتِ جُود",23,"د",1,0],["ولقيتِ من عَسْفِ العدوِّ وكيدِه","دونَ الذي لاقيتِ من أهليكِ",24,"ك",1,0],["ولقيت وجهك بالبشا","شة وهي أطراف الرماح",25,"ح",1,0],["ولُقِّيتَ الإفالَة َ من قريبٍ","موقًّى كلَّ نائبة ٍ تنوبُ",26,"ب",1,0],["ولقيتُ ما سرَّ الصديقَ وساء من","عادَي فأَخْزاهُ عَقيبَ شَماته",27,"ت",2,0],["ولَقِيتُ مِن أمرِ الصِّيَامِ وحَرِّهِ","أمرَينِ قِيسا بالعَذَابِ المُؤصَدِ",28,"د",1,0],["وَلقيت منه لدى الشدائد أنعما","وَجعلته لمنال فَخري سلما",29,"م",2,0],["وَلَقيتُ ما لا أستَقِلُّ بِوَصفِهِ","وَإِنِ ادَّعيت مزِيَّةَ استِقلالِ",30,"ل",1,0],["وَلقياك الخليلَ وَإنْ أخفَتْ","وسرّتْ عنك تذكرك الجليلا",31,"ل",2,0],["وَلَقيتَ أُنسا بالّذي قدّمته","مِن صالحٍ يُنميه فضل أوسعُ",32,"ع",1,0],["ولقيتني فنسيت فيك","تعاستي ونسيت عمري",33,"ي",1,0],["وَلَقِيتُ عَنْتَرَ إذْ مُنِيتُ بِفاصِدٍ","ذِي رِيشَةٍ سَقَطَتْ عليَّ كَيذْبُلِ",34,"ل",1,1],["وَلَقيتُ من ثَكَلٍ وَمغبَطَةٍ","وَالدَهرُ من طَلقٍ ومن نَحسِ",35,"س",1,0],["وَلَقيتُ بَعدَكَ أُمَّةً لَكِنَّني","فارَقتُ مِنكُم واحِداً بِأَئِمَّةِ",36,"ه",1,0],["وَلَقيتُ ما لَم يَكفِهِ صَبري وَلَم","يَثبُت لِرَوعَةِ ما جَناهُ جَناني",37,"ن",2,0],["ولقيتُ مِن أجفانِهِن","نَ مُقاتِلاً ومُحرِّضا",38,"ض",2,0],["وَلقيتُ ما لَقِيَت مَعَدٌّ كُلُّها","وفَقَدتُ راحِي في الشَّبابِ وخَالي",39,"ي",1,0],["ولقيت من أهل الديانة والتُّقى","قوماً هم الأعلام في الأعلام",40,"م",1,0],["وَلَقيتُ نِعمَتِهِ بِأَحسَن خُلَةٍ","تَلقى بِها النعماء عِند ورودِها",41,"د",3,0],["ولُقِّيْتَهُ عيْدَ فَأْلٍ بوَعْدٍ","لِنَصْرِكَ يَقْرُو عِدَاكَ الوعيدا",42,"د",2,0],["ولُقِّيتِ فِي ضَنْكِ ذَاكَ الضَّريحِ","نسيمَ النعيم وطِيبَ الثَّواءِ",43,"ا",2,0],["ولقيتُ قوماً دونكم كرهوا","أيّامَكم بقواصم الظهرِ",44,"ر",1,0],["وَلَقيتَ حَيّاً في الحُروبِ مَحَلُّهُم","وَالجَيشُ بِاِسمِ أَبيهِمُ يُستَهزَمُ",45,"م",1,0],["ولقيت عيد الفطر منك بغرة","أضحى ببهجتها يهنا العيد",46,"د",1,0],["ولقيتمو عنها القتال بمثله","من بعدما انكشفت وبان المقتل",47,"ل",1,0],["ولقيتها بكرامة من أجلها","قعد الرجال الحاسدون وقاموا",48,"م",3,0],["وَلَقى القَومُ بِالذَنائِبِ منّا","إِذ كَشَفنا الخُلودَ مَوتاً ذُباحا",49,"ح",2,0],["ولقيتَ من عفو الإلهِ وصفحهِ","فوقَ الّذي ترجو بغير مِطالِ",50,"ل",1,0],["ولقيتنِي مُتخشِّعاً لا يُرتَجى","نَفعي ولا يُخشى العشيّةَ باسي",51,"س",2,0],["وَلَقيتُ فيكِ مِنَ العناءِ غَرائباً","وَأَخذتُ مِن أَدهى البلاءِ ضروبا",52,"ب",2,0],["وَلَقى ثَوائي اليَومَ ما","عَلِقَت حِبالُ القاطِنِيَّه",53,"ي",2,0]]}