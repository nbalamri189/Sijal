{"poems":[[75,"أفدتني من نفائس الدرر","https://www.aldiwan.net/poem11981.html","المنسرح"],[85,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[164,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[203,"أيا ضلوعا قلبها وامق","https://www.aldiwan.net/poem45557.html","السريع"],[415,"فيا أخا العزم يطوي البيد منصلتا","https://www.aldiwan.net/poem32225.html","البسيط"],[438,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88620","الرجز"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203709","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115941","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108590","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42448","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27181","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104974","السريع"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120897","السريع"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26183","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132674","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89409","الكامل"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144065","الرجز"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120181","الرجز"],[5135,"قلبي شراع","https://www.poetsgate.com/ViewPoem.aspx?id=201782",""]],"verses":[["مِن لَفظَةٍ قارَنَت نَظيرَتَها","قِرانَ سُقمِ الجُفونِ لِلحَوَرِ",0,"ر",1,0],["من ل فخر كافتخارك","بمآثرك الأثيرا",1,"ر",2,0],["من لفظ إسماعيل فيه حسْنُ","تعشقته في الرسول اللسْنُ",2,"ن",1,0],["مِن لَفا هَذا إِلى مَخسوسِ ذا","وَمِنَ الذَودِ إِلى الذَودِ إِبِل",3,"ل",1,0],["من لفَّ شملكمَ على مرضاته","فدعاه كلٌّ منكم بلسانِ",4,"ن",1,0],["من لفؤادٍ طاهرٍ جرَّهُ","إلى الغرامِ النظرُ الفاسقُ",5,"ق",1,0],["من لَفظُه تُسكِرُ الصّاحِي فصاحَتُهُ","ولَو وَعَى فَضلَه ذُو سَكْرَةٍ لَصَحَا",6,"ح",2,0],["من لفظِه راحٌ وأخلاقِه","روحٌ وتلك الدارُ دار النعيمْ",7,"م",1,0],["من لفضلٍ أخرجتَ منه خبيئاً","ومعانٍ فضضتَ عنها ختاما",8,"م",2,0],["من لفتاة عوذتها قومها","بسمرها لا بالتميم والرقى",9,"ق",2,0],["من لفتة الظبي الغرير جماله","ومضاؤه حد الاسنة والظبى",10,"ب",2,0],["مَن لِفتًى جار علَي","هِ صَرفُهُ فيما قَضى",11,"ض",2,1],["من لفظه العذب إن شئت التقط درراً","أو فاقتطف زهراً أو فاقتبس حكما",12,"م",2,0],["من لفظه درٌّ بلا صدفٍ","وسماحه سيلٌ بلا رعد",13,"د",1,0],["من لفظِه الدرُّ مَعسولاً بريقتَهِ","من لثغةِ الراءِ بالأرواحِ ممتزجِ",14,"ج",1,0],["مَن لِفَتىً مُتَيَّهٍ في مَهمَهٍ","مُوَلَّهٍ مُدَلَّهِ العَقلِ شَجى",15,"ج",2,0],["مَن لِفَتىً دَمعَتُهُ مُغرِقَةٌ","أَسكَرَهُ خَمرٌ بِذاكَ الفَلَجِ",15,"ج",1,0],["مَن لِفَتىً زَفرَتُهُ مُحرِقَةٌ","تَيَّمَهُ جَمالُ ذاكَ البَلَجِ",15,"ج",1,0],["من لفظها السلس المعاني أتت","منقادة بالمقود السلس",16,"س",1,0],["من لفؤاد والهٍ مستطار","هاج له الوجد القديم اذكار",17,"ر",1,1],["مِن لَفظِهِم تَعرِفُ ما هُم وَفي","جَحفَلَةِ العاثِرِ يَبدو العِثار",18,"ر",1,0],["من لفظه ورضابه وخدوده","ولحاظه يسقى المحب رحيقا",19,"ق",2,0],["مَن لفظُهُ درٌّ يفوق نظائراً","ويعز منطقه عن الأشباهِ",20,"ه",1,1],["من لفؤادٍ نارُه","راميةٌ بالشّرَرِ",21,"ر",1,0],["من لفظه واعظ بالنصح جردني","يا نفس توبي فللتجريد فالتزمي",22,"م",2,0],["من لفظك الدر النقي المشتهى","الرائق العذب الشهي المنتخب",23,"ب",1,0],["مِنْ لَفْظِكِ الْعَذْبِ في أذْنَيَّ أُغْنِيةٌ","تُبْقِيْهِ فِي غُرْبَةِ الْأَشْوَاقِ نَشْوَانا",24,"ن",2,0]]}