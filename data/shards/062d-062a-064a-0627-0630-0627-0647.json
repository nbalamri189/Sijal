{"poems":[[57,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[32,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[32,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[74,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[53,"بلاغة ابن فراس","https://www.aldiwan.net/poem64938.html","المجتث"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[31,"بينا يجول بها عرته ليلة","https://www.aldiwan.net/poem6161.html","الكامل"],[93,"أزف الرحيل وحان أن نتفرقا","https://www.aldiwan.net/poem8988.html","عموديه"],[93,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[87,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[83,"عبثت بقلب عميده لحظاته","https://www.aldiwan.net/poem61369.html","عموديه"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[54,"وفتية لا يخوض الشك أنفسهم","https://www.aldiwan.net/poem27181.html","البسيط"],[8,"باتت تذكرني بالله قاعدة","https://www.aldiwan.net/poem21822.html","البسيط"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62235","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39564","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[32,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[186,"قف بي نحي رباها أيها الحادي","https://www.aldiwan.net/poem61045.html","البسيط"],[234,"لا تقتل الأحزان إلا بما","https://www.aldiwan.net/poem50755.html","السريع"],[369,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[466,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101558","الكامل"],[867,"","https://poetry.dctabudhabi.ae/diwan/poem/144600","السريع"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18497","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109104","السريع"],[1495,"","https://poetry.dctabudhabi.ae/diwan/poem/178085","البسيط"],[1533,"","https://poetry.dctabudhabi.ae/diwan/poem/105658","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108823","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45512","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79719","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68009","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62802","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138594",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85257","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136673",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83472","البسيط"],[4490,"","https://poetry.dctabudhabi.ae/diwan/poem/145773","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52194","الكامل"],[4722,"وأول الفرض إيمان الفؤاد كذا","https://www.poetsgate.com/ViewPoem.aspx?id=26471",""],[5055,"كومة أحزاب","https://www.poetsgate.com/ViewPoem.aspx?id=101660",""],[5353,"ملحمة فجر الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=212649",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[5725,"مابال حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177839",""],[1710,"إركب اذا دارت رحاها وانزل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=530612",""],[186,"قف بي نحيي رباها أيها الحادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55745&r=&rc=8",""],[6225,"خاطرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81120&r=&rc=314",""]],"verses":[["حَتّى إِذا هُوَ رَوّاها وَأَخرَجَها","وَقالَ قَد نِلتُ يُسراً بَعدَ إِعسارِ",0,"ر",1,0],["حَتّى إِذا هَزَّتِ البُهمى ذَوآئِبَها","في كُلِّ يَومٍ يُشَهّي البادِيَ الحَضَرا",1,"ر",2,0],["حَتّى إِذا هَأهى بِهِ وَأَسَّدا","وَاِنقَضَّ يَعدو الرَهقى وَاِستَأسَدا",2,"د",2,0],["حتَّى إذا هبَّ نسيمُ اللقا","قام الرَّجا يستنّ من لحده",3,"د",2,0],["حتَّى إذا هوت النجوم وأطفأت","في الصبح أنفاس النسيم ذبالها",4,"ل",3,0],["حتى إذا هي أعيتْ","ركبنَ كل قَمُوص",5,"ص",1,0],["حَتّى إِذا هُنَّ وَرَّكنَ القَصيمَ وَقَد","أَشرَفنَ أَو قُلنَ هَذا الخَندَقُ الحَفَرُ",6,"ر",1,0],["حَتّى إِذا هُوَ ظَنَّ أَن قَدِ اِكتَفى","وَاِكتَنَّ مالَ بِهِ هَيامٌ أَعفَرُ",7,"ر",1,0],["حَتّى إِذا هَبَطَت بِنا في لُجَّةٍ","أَيقَنتُ أَنَّ المَوتَ فينا أَحدَقا",8,"ق",2,0],["حَتّى إِذا هَتَفَ المَشيبُ بِلِمَّتي","وَدَنَت يَدُ الماحي إِلى أَحلامي",9,"م",2,0],["حَتّى إِذا هَبَطَ الوُحدانَ وَاِنقَطَعَت","عَنهُ سَلاسِلَ رَملٍ بَينَها عُقَدُ",10,"د",1,0],["حَتّى إِذا هَدَأَ المَلا في لَيلِهِ","جاذَبتُ لَيلي ثَوبَهُ مُتَحَيِّرا",11,"ر",2,0],["حَتَّى إذَا هَامَ الكَرَى بِجُفُونِهِ","وَامتَدَّ فِي عَضُدَيَّ طَوعَ سِنَاتِهِ",12,"ت",2,0],["حَتّى إِذا هُوَ آلَ وَاِطَّرَدَت لَهُ","شُعَبٌ كَأَنَّ وُحِيَّهُنَّ المُسنَدُ",13,"د",1,0],["حَتّى إِذا هَزَمَ الإِصباحُ لَيلَهُمُ","بِعَسكَرٍ مِن جُنودِ النورِ مَبثوثِ",14,"ث",1,0],["حَتّى إِذا هَبَطَ الأَفلاَحَ وَاِنقَطَعَت","عَنُه الجَنُوبُ وَحَلَّ الغائِطَ السَهِلا",15,"ل",2,0],["حَتّى إِذا هَمَّ الأَمينُ بِنَفسِهِ","دَفَعَ اللِواءَ إِلَيهِ غَيرَ مُذَمَّمِ",16,"م",1,0],["حَتَّى إِذَا هَبَطَتْ مَدَافِعَ رَاكِسٍ","ولَهَا بِصَحْرَاءِ الرُّقَيِّ تَوَالِي",17,"ل",2,0],["حتى إذا هتفتْ بمقدمكَ المُنى","وأصختُ أسترعي انتباهةَ حائرِ",18,"ر",1,0],["حَتَّى إِذَا هَبَط النَّهَا","رُ كَحَطِّ رَاحِلَةِ المُسَافِرْ",19,"ر",1,0],["حتى إذا هدَّ المسيرُ كيانَه","حصب الورى بالصلد من صّوانه",20,"ن",2,0],["حَتَّى إذَا هزَّتِ الْبُهْمَى ذَوَآئِبَهَا","في كلِّ يومٍ ييشهَّى البادي الحضرا",21,"ر",2,0],["حتى إِذا هَيَّأنَ أَحسَنَ مَنظَرٍ","حالاً بلَ عُنفٍ وَلاَ بِتَوَاكُلِ",22,"ل",1,0],["حتى إذا هجعت في ليلها ظفرت","منها العيون بلمج الميسم البادي",23,"د",2,0],["حتّى إذا هَزّتكُم نَشْوَةٌ","هَزَّ الشُّجاع المتَّقي للجَبان",24,"ن",1,0],["حتّى إذا هجَم الرقيبُ مُعارِضاً","منّا على سَرْحِ الِلّحاظِ الرّاتع",25,"ع",1,0],["حتى إذا هجَّرت شمس الضحى وردت","ماء المفارقِ من عَلٍّ ومن نَهَلِ",26,"ل",1,0],["حتى اذا هُجرت موا","خيرٌ ونامت جانيَه",27,"ي",2,0],["حتى اذا هتكَ الصبا","حُ ستورَ ليلٍ داجيه",27,"ي",2,0],["حتى إذا هبّتْ أهاضيبُها","بنَوء أبوالٍ وأزْبالِ",28,"ل",1,0],["حَتّى إِذا هَلَكوا وَبادَ كُراعُهُم","رُمتَ الخُروجَ وَأَيُّ ساعَةِ مَخرَجِ",29,"ج",1,0],["حتى إذا هبت له عصبةٌ","هزت به العرش وإنسانه",30,"ن",2,0],["حتى إذا هي حلت من ذراك حمى","قالت: إلى منتهى المجد انتهى السفر",31,"ر",1,0],["حتى إذا هدرت هدر الفحول لظى ال","هيجاء واشتبكت بيضاً وخرصانا",32,"ن",2,0],["حتى إذا هب النشاط بها","وانحط عن أعطافها الكسل",33,"ل",1,0],["حتى إذا هَبّتْ بأَمرٍ مُعضِلِ","صَبّحْتَها بكلِّ لَيْثٍ مُشْبِلِ",34,"ل",1,0],["حَتّى إِذا هَجَدوا أَلَمَّ خَيالُها","سِرّاً أَلا بِلِمامِه كانَ المُنى",35,"ا",1,0],["حَتّى إِذا هِيَ لَم تُبِن لِمُسائِلٍ","وَسَعَت رِياحُ الصَيفِ بِالأَصياقِ",36,"ق",1,0],["حتى إذا همدت وأخمدها الردى","فأرقت دنيا جمة النعماء",37,"ا",2,0],["حَتَّى إذَا هجم الصبَاحُ برمحه","والليل ظلَّ كَأَنَّهُ أَطْمَار",38,"ر",1,0],["حتى إذا هطلتْ عليّ سماؤهُ","وأعادَ عودي مورقاً إحسانُهُ",39,"ن",2,0],["حتى إذا هجم العدو ببيتها","نادت فقطعت القلوب بصوتها",40,"ا",1,0],["حتى إذا هام سكراً في محبته","قال الكليم إلهي اسئل النظرا",41,"ر",2,0],["حتى إذا هب من مصر نسيم صبا","بالنصر للدين مع سلطانها عصفا",42,"ف",2,0],["حتى إذا هَجم الصباحُ على الدجُى","وسَطت على جَيش الظلام جنوده",43,"د",2,0],["حَتّى إِذا هَزَّها قَولي وَأَنعَشَها","تطوي الفَيافي كبرقٍ خاطِفٍ حالا",44,"ل",2,0],["حتى إذا هبطوا مساقطَ مُزنْة","لم يُبْصرِوا إلاّ النجيعَ الأحمرا",45,"ر",2,0],["حتى إذا هدأ الوجيفُ وأمسكَتْ","حِيناً مدامعُنَا عن التهتانِ",46,"ن",1,0],["حتى إذا هام سكرا في محبته","قال الكليم إلهي أسأل النظرا",47,"ر",2,0],["حتّى إذا هبّت بوارح وَلَسْباب","شيء جلى مني وشيءٍ ذهبّي",48,"ب",2,0],["حتى اذا هَرمَ الغمامُ وجئتُه","مستمطراً يوما سقاني الكوثرا",49,"ر",2,0],["حتَّى إذا هَدَأَ الحَبيبُ وأَيْنَعَتْ","آياتُ قُرْآنٍ وزادَ نَمَاؤُها",50,"ا",3,0],["حتى اذا هدأتْ عواصف غربتي","لم يبقِ فيّ الموج غصنا مورفا",51,"ف",2,0],["حتى إذا هَبّتْ بأَمرٍ مُعضِلِ","أهرتُ نابي الهمّ داني المأكل",52,"ل",1,0],["حتى إذا هجعت في ليلها ظفرت","منها العيون بلمح الميسم الباد",53,"د",1,0],["حتى إذا هامتِ الأحلامُ والتأمتْ","ستائرُ الروحِ , فاض القلبُ بالعِبَرِ",54,"ر",1,0]]}