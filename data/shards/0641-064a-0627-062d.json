t/poem24496.html","عموديه"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[501,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[501,"أفيضوا لنا يا أهل أم عبيدة","https://www.aldiwan.net/poem38012.html","الطويل"],[516,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[552,"أقول لصحبي وقد هوموا","https://www.aldiwan.net/poem47189.html","المتقارب"],[552,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[559,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"]],"verses":[["فَيا حادي السِنينَ قِفِ المَطايا","فَهُنَّ عَلى طَريقِ الأَربَعينا",0,"ن",2,0],["فَيا حُسنَ حالِ الوُدِّ ما دَمتُ مُذنِباً","أَتوبُ وَما ضامَت تُعَدُّ ذُنوبي",1,"ب",2,0],["فَيا حَبَّذا أَثلُ العَقيقِ وَمَن بِهِ","وَإِن رَحَلَتْ عَنهُ فَلا حَبَّذا الأَثلُ",2,"ل",1,0],["فَيا حَسَراتِ النّفْسِ حينَ تقطَّعَتْ","لبَيْنٍ كما شاءَ الغَيورُ حِبالُ",3,"ل",1,0],["فَيا حَزَني لِنَفسي بَعدَ فَوزٍ","وَيا طولَ اِغتِرابي وَاِنفِرادي",4,"د",2,0],["فَيا حضْرَةً للعَدْلِ أصْبَحَتْ روْضَةً","بأنْوارِها روْضُ الهِدايةِ يُتْحِفُ",5,"ف",1,0],["في أحْسَنِ التّقْويمِ أنشأتَهُ","خَلْقاً جَديداً بَيْنَ جِسْمٍ وروحْ",6,"ح",1,0],["فَيا حَبَّذا قَومٌ هُناكَ وَحَبَّذا","مِنَ الأَرضِ غَربِيُّ الحَدالى وَغُرَّبِ",7,"ب",1,0],["فَيا حَبَّذا الرَوضُ الَّذي دونَ عزَّتا","سُحَيراً إِذا هَبت عَلَيهِ قَبولُ",8,"ل",1,0],["فيا حَبّذا كوزٌ إذا الخَيْلُ أدبَرَتْ","وثارَ غبارٌ في الدَّهاسِ وفي الاكمْ",9,"م",1,0],["فيا حفلاً لقيت به","جميلاً جاز آمالي",10,"ل",2,0],["فَيا حَسَراتِ القَلبِ في إِثرِ مَن يُرى","قَريباً وَيُلفى خَيرُهُ مِنكَ نائِيا",11,"ي",2,0],["فَيا حَسرَتا مَن لي بِخِلٍّ مُوافِقٍ","أَقولُ بِشَجوي مَرَّةً وَيَقولُ",12,"ل",1,0],["فَيا حَكَمي المَأمولَ جُرتَ مَعَ الهَوى","وَيا ثِقَتي المَأمونَ خُنتَ مَعَ الدَهرِ",13,"ر",1,0],["فيا حبَّذا للخصر مرود عسجدٍ","جعلت عليه للذَّوائب إثمدا",14,"د",2,0],["فيا حبَّذا عبدُ الرحيم توسلاً","ويا حبَّذا الطائي في الجود والشعر",15,"ر",1,0],["فيا حبَّذا البر الذي ليس عيبه","سوى أنني لا أستطيع له شكرا",16,"ر",2,0],["فيا حامي الإسلامَ من كلماته","بأجهد من حربِ الأسود وأربطا",17,"ط",2,0],["فيا حرباً من فاتر الطرف فاتكٍ","يفطّر أكباد الورَى وهو صائم",18,"م",1,0],["فيا حبذا في شهرِنا من رياضِه","أوائل وردٍ في أواخر شعبان",19,"ن",1,0],["فيا حَزَني أن لا سلوَّ يُطيعني","ويا سوءَتا من سلوتي إنها غدرُ",20,"ر",1,0],["فَيا حُسنَ رَكبٍ جِئتَ فيهِ مُسَلِّماً","وَيا طيبَ ما أَهدَتهُ أَيدي الرَواسِمِ",21,"م",1,0],["فَياحَبَّذا مَن لا أُسَمّيهِ غَيرَةً","وَبي مِن هَواهُ مُقعَدٌ وَمُقيمُ",22,"م",1,0],["فَيا حَرباً وَهَل يَشفي","أَديباً قَولُ واحَربا",23,"ب",2,0],["فَيا حَبَّذا غُرُّ أَبياتِها","وَما أودِعَت مِن فُنونِ الأَدَب",24,"ب",1,0],["فَيا حُسنَها إِذ يَغسَلُ الدَمعُ كُحلَها","وَإِذ هِيَ تُذري الدَمعَ مِنها الأَنامِلُ",25,"ل",1,1],["فيا حسن شعر محزن مطرب معاً","ويا حسن لحن ثم يا حسن ترداد",26,"د",1,0],["فيا حوادث مهلا في نصيحتنا","فما تركت لنا لبا بعرفان",27,"ن",1,0],["فَيا حَسرَتا أَلّا تَراهُم أَهِلَّةً","إِذا أَقصَرَ البَدرُ التَمامُ مَضَوا قُدما",28,"م",2,0],["فَيا حَلبَةً رَفَّت عَلى البَحرِ حِليَةً","وَهَزَّت بِها حُلوانُ أَعطافَ مُختالِ",29,"ل",1,0],["فيا حسن ذلك من مجلس","ويا طيب ماضمنته الفصولُ",30,"ل",1,0],["فيا حسنَها أضغاثُ حُلمٍ وبَردَها","على القلب لولا أنهنَّ أكاذيبُ",31,"ب",1,0],["فَيا حائِلاً عَن ذَلِكَ الاِسمِ لا تَحُل","وَإِن جَهِدَ الأَعداءُ عَن ذَلِكَ العَهدِ",32,"د",1,0],["فَيا حُسنَها إِذ هَبَّ مِن سِنَةِ الكَرى","صَريعٌ بِصَيكِ الزَعفَرانِ رَميلُ",33,"ل",1,0],["فيا حُسنَ أرواحِها في الدُّجى","وقد أكَلتْ فيه أبدانَها",34,"ن",3,0],["فيا حبَّذا الديرُ من منزلٍ","هَصَرْنا به العيشَ غضّاً رطيبا",35,"ب",2,0],["فَيا حُزناً إِنّا رَأَينا نَبِيَّنا","عَلى حينِ تَمَّ الدينُ وَاِشتَدَّتِ القُوى",36,"ا",1,0],["فَيا حَضرَةَ القُدسِ الَّتي مُذ شَهِدتُها","تَيَقَّنَ قَلبي بِالوُصولِ إِلى رَبّي",37,"ب",2,0],["فَيا حَبَّذا فَصلُ الخَريفِ وَمُزنُهُ","وَسُترُ السَحابِ الطَلقِ بِالبَرقِ تُحبَكُ",38,"ك",1,0],["فيا حارسَ الأخلاقِ في الحيِّ نائم","قضى يومَه في حومةِ البؤسِ يستجدي",39,"د",2,0],["فيا حاضراً أبداً ذنبُهُ","وتوبتُهُ أبداً غائبه",40,"ب",2,0],["فَيا حُسنَ ذاكَ البِرِّ إِذ أَنا حاضِرٌ","وَيا طيبَ ذاكَ القَولِ وَالذِكرِ مِن بَعدي",41,"د",2,0],["فَيا حُسنَ الرُسومِ وَما تَمَشّى","إِلَيها الدَهرُ في صُوَرِ البُعادِ",42,"د",1,0],["فَيا حَبَّذا ماءٌ بِمُنعَرَجِ اللِوى","وَما اِهتَزَّ مِن أَيكٍ عَلَيهِ مَطيرِ",43,"ر",1,0],["فَيا حُسنَ مَرأى المَلِكِ بَينَ مُهَنَّدٍ","خَضيبٍ وَرَندٍ لِليَراعِ نَضيرِ",43,"ر",1,0],["فَيا حُسنَ خَصرٍ لَها أَحمَرٍ","وَمِئزَرِ شَحمٍ عَلَيهِ يَقَق",44,"ق",1,0],["فَيا حَبَذا مِن مَنظَرٍ لَو تَنالَهُ","عَذابُ الثَنايا أُمُّ عَمروٍ وَريقُها",45,"ه",2,0],["فَيا حَبَّذا لَيلى إِذا الدَهرُ صالِحٌ","وَسُقيا لِلَيلى بَعدَ ما خَبُثَ الدَهرُ",46,"ر",1,0],["فَيا حَبَّذا إِعراضُ لَيلى وَقَولُها","هَمَمتَ بِهَجرٍ وَهيَ بِالهَجرِ هَمَّتِ",47,"ت",1,0],["فَيا حَسرَتي مَن أَشبَهَ اليَأسِ بِالغِنى","وَإِن لَم يَكونا عِندَنا بِسَواءِ",48,"ا",2,0],["فَيا حَبّذا قَبل الشَقاءِ نَعيمُهُ","وَيا حَبّذا بَعد النَعيمِ شَقاؤُهُ",49,"ا",3,0],["فيا حُسْنَها من وَقعةٍ غالبيةٍ","ويا لَكَ من يومٍ جليلِ المناقبِ",50,"ب",1,0],["فَيا حُسنَهُ يا إِمامَ الهُدى","وَخَيرَ الخَلائِفِ نَفساً وَأَب",51,"ب",1,0],["فَيا حَسرَتي إِن رَدَّ كَفَّيَ مانِعٌ","فَقَصَّرَها عَمّا تُحِبُّ مِنَ الدُنيا",52,"ا",1,0],["فَيا حُسنَهُ لَحناً بَدا مِن لِسانِهِ","وَيا حُسنَهُ لَحظاً وَيا حُسنَهُ ثَغرا",53,"ر",2,0],["فَيا حَرَبا بانَ الشَبابُ وَحاجَتي","إِلَيهِنَّ بَينَ العَينِ وَالقَلبِ تَسجُرُ",54,"ر",1,0],["فَيا حَزَناً بَعدَ جِنِّيَّةٍ","عَلَيها القَلائِدُ وَالمِسجَدُ",55,"د",1,0],["فَيا حُسنَها لَولا العُيونُ فَإِنَّها","إِذا أُرسِلَت يَوماً أَحالَت عَلى الغَدِ",56,"د",1,0],["فَيا حَزَنا في الصَدرِ مِنكِ حَرارَةٌ","وَفي النَفسِ حاجاتٌ تَشوقُ وَلا تُجدي",57,"د",2,0],["فَيا حُسنَها إِذ نَلتَقي بِمَهايِلٍ","مُحِبَّينَ في بَحرٍ مِنَ الحُبِّ نَلتَجي",58,"ج",2,0],["فَيا حُسناً لِما قُلتِ","وَبَشَّرتِ وَمَنَّيتِ",59,"ت",1,0],["فَيا حَزَناً لا أَنا غِرٌّ مُشَبَّبٌ","نَعِمتُ وَلا في الشَوقِ إِذ أَنا أَشيَبُ",60,"ب",1,0],["فَيا حَزَنا هَلّا بِنا كانَ ما بِهِ","مِنَ الوُدِّ إِذ تَبكي عَلَيهِ قَرائِبُه",61,"ب",