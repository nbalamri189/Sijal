{"poems":[[85,"جن على حرم السماء أغاروا","https://www.aldiwan.net/poem62964.html","الكامل"],[85,"من صور السحر المبين عيونا","https://www.aldiwan.net/poem63011.html","الكامل"],[269,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[459,"يا فتى الخير من نوال وبأس","https://www.aldiwan.net/poem15343.html","الخفيف"]],"verses":[["فَلَمَستَ أَقضِيَةِ السَماءِ وَأَسفَرَت","حَتّى نَظَرَت وُجوهَها الأَقدارُ",0,"ر",1,0],["فَلَمَستُ صَدري موجِساً وَمُرَوَّعاً","وَلَمَستُ جَنبي مُشفِقاً وَضَنينا",1,"ن",2,0],["فَلَمسان فسر ددثم مور","فَحَيران لهن به رَسيم",2,"م",1,0],["فلمُستصرخي حِماكَ ونُعمْا","كَ عطاءٌ هامٍ ونصْرٌ عَتيدُ",3,"د",1,0]]}