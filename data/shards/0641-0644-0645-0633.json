{"poems":[[87,"جن على حرم السماء أغاروا","https://www.aldiwan.net/poem62964.html","الكامل"],[87,"من صور السحر المبين عيونا","https://www.aldiwan.net/poem63011.html","الكامل"],[276,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[466,"يا فتى الخير من نوال وبأس","https://www.aldiwan.net/poem15343.html","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126187","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125835","الهزج"],[4927,"لَسْت وَحْدَك","https://www.poetsgate.com/ViewPoem.aspx?id=29839",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""]],"verses":[["فَلَمَستَ أَقضِيَةِ السَماءِ وَأَسفَرَت","حَتّى نَظَرَت وُجوهَها الأَقدارُ",0,"ر",1,0],["فَلَمَستُ صَدري موجِساً وَمُرَوَّعاً","وَلَمَستُ جَنبي مُشفِقاً وَضَنينا",1,"ن",2,0],["فَلَمسان فسر ددثم مور","فَحَيران لهن به رَسيم",2,"م",1,0],["فلمُستصرخي حِماكَ ونُعمْا","كَ عطاءٌ هامٍ ونصْرٌ عَتيدُ",3,"د",1,0],["فلمسلم قال البخاري مقسما","بعد الفتى القصاب قد صرنا سدى",4,"د",2,0],["فَلِمْ سَلَّمْتَهَا للروس","بعد الحرب مُرْتدا",5,"د",2,0],["فَلَمَسْتُ صِدْقاً صَاْفِياًّ بِكَلاْمِهَاْ","يُصْغِيْ إِلَيْهِ السَّاْدَةُ الأَحْرَاْرُ",6,"ر",1,0],["فلمسراه شرعة بعث العق","بأحكامه إليه رسولا",7,"ل",2,0],["فلمست منه شدة في بأسه","حتى لتخشى باسه الهجاء",8,"ا",2,0],["فَلَمَستُ مِن شِعرِ الكِرَامِ حَلَاوَةً","فَاقَتْ \" أَرَاكَ عَصِيَّ \" فِي إِلقَائِهَا",9,"ا",3,0]]}