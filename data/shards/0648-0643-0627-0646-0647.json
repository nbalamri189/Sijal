2,"راسي الحبى في سلمه ونديه","https://www.aldiwan.net/poem16423.html","الكامل"],[465,"ولقد بدا والصولجان بكفّه","https://www.aldiwan.net/poem3522.html","عموديه"],[465,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[483,"نيل الجفون أذاب قلب العاشق","https://www.aldiwan.net/poem24457.html","عموديه"],[494,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[516,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[516,"أقسمت لا كشفت لمصر غمة","https://www.aldiwan.net/poem12089.html","الكامل"],[516,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[539,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[545,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[552,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[552,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[552,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[552,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[552,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[552,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[552,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[552,"إني مررت على جنادل","https://www.aldiwan.net/poem47747.html","مجزوء الكامل"],[552,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[552,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[552,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[552,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[552,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[552,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[552,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[554,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[559,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[563,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[568,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"]],"verses":[["وَكَأَنَّهُ في رَصفِها","جارُ الفَرَزدَقِ أَو جَريرِ",0,"ر",1,0],["وَكَأَنَّهُ في حُسنِها","بَينَ الخَوَرنَقِ وَالسَديرِ",0,"ر",1,0],["وكأنّهُنَّ وهُنَّ يأْلَفْنَ الصّدَى","مِنْ صَبْرِهنَّ عليهِ غَيْرُ عِطاشِ",1,"ش",1,0],["وكأنّهمُم بلَغوا المَدى فتَواقَفوا","يتَذاكَرونَ عَواقِبَ الأسْفارِ",2,"ر",1,0],["وكأنّهُ المَنْصورُ في عَزَماتِهِ","ومُحَمّدٌ في المَكرُماتِ وجَعْفَرُ",3,"ر",1,0],["وكأنَّهُ مِمَّا يُميلُ بِطَرْفِهِ","قِبَلَ المَغارِبِ بالثُّريَّا مُلْجَمُ",4,"م",1,0],["وكأنه وهج إلهي السن","ومنابر تمحو دياجير العمى!",5,"م",2,0],["وكأنه بفم الربيع نشيده","خضراء نقشها الصباح ونمنما",5,"م",2,0],["وكأنه قلب يذوب تأوه","للبائسين ويستفيض ترحما",5,"م",2,0],["وَكَأَنَّ هادِيَهُ إِذا اِستَقبَلتَهُ","جِذعٌ أُذِلَّ وَكانَ غَيرَ مُذَلَّلِ",6,"ل",1,0],["وَكَأَنَّها جِنِّيَّةٌ وَكَأَنَّما","هُدلُ الكُروم تَلوحُ تَحتَ قِناعِها",7,"ع",3,0],["وكأنّها تحْتَ الذّروعِ أراقِمٌ","ينْظُرْنَ منْ خلَلِ المَغافِرِ شُوسا",8,"س",2,0],["وكأنّهُ جُعَلٌ يُدَحْرِجُ جاهِداً","كُرةَ الخَراءِ وبعْدَ ذاكَ يَطيرُ",9,"ر",1,0],["وكأنّه في ضِفّةِ النّهْرِ انْتَشى","وغَدا يَبوحُ بسِرّهِ عِرْبيدُهُ",10,"د",2,0],["وَكَأَنَّها مَحمومُ خَي","بَرَ بَلَّ مِن أَوصابِها",11,"ب",3,0],["وَكَأَنَّها ذو جُدَّةٍ غِبَّ السُرى","أَو قارِحٌ يَتلو نَحائِصَ جُدَّدا",12,"د",2,0],["وَكَأَنَّهُ هِقلٌ يُباري هِقلَهُ","رَمداءَ في خيطٍ نَقانِقَ أَرمَدا",12,"د",2,0],["وَكَأَنَّها بَعدَ الكَلا","لِ مُكَدَّمٌ مِن حُمرِ عاقِل",13,"ل",1,0],["وَكَأَنَّها نُوبِيَةٌ وَكَأَنَّهُ","زَوجٌ لَها مِن قَومِها مَشعوفُ",14,"ف",1,0],["وَكَأَنَّها في الأُفقِ حي","نَ يَميلُ ميزانُ النَهار",15,"ر",1,0],["وَكانَ هَذا يَقومُ بِالناسِ في ال","حمّامِ هَذا جَلِيَّةُ الأَمرِ",16,"ر",1,0],["وَكَأَنَّها لَم تَرضَ ما في الأَرضِ مِن","عَرضٍ لِراجيها فَجاءَت بِالفَلَك",17,"ك",1,0],["وكأنها والقوم يَحتوِ شونها","قلبٌ عليه تهاجم الآلام",18,"م",1,0],["وكأنه في القوم ساعة حفلهم","متكلّم بنظيمه ونثيره",19,"ر",2,0],["وَكَأَنَّهُ مِمّا يَجيشُ بِهِ","يُبدي الفُجورَ وَسَورَةَ الجَهلِ",20,"ل",1,0],["وكأنها في الكأس شمسٌ قارنتْ","بُرْجَ الهلال فهلَّ بالأضواءِ",21,"ا",2,0],["وكأنَّها عارٌ تحاول ضَرْحَهُ","عَنَّا وما يُسْدَى الجميلُ لِيُضْرَحَا",22,"ح",2,0],["وكأنه فيها وقد لحظ الصِّبا","ورمى المنام بِبعْده وبصدِّهِ",23,"د",2,0],["وكأنه إذ غاب عند مسائه","في الماء وانحجبت نضارة قدِّهِ",23,"د",2,0],["وكأنهمْ من خوفهمْ","حُمُرٌ نوافر من قَساور",24,"ر",1,0],["وكأنه إذ ذاك زَمْ","مَمَ أنفهُ خَطْمٌ وزَمُّ",25,"م",1,0],["وَكَأَنَّهُنَّ رَبابَةٌ وَكَأَنَّهُ","يَسَرٌ يُفيضُ عَلى القِداحِ وَيَصدَعُ",26,"ع",1,0],["وَكَأَنَّهُ حُلمٌ يَصُحُّ مَعَ الكَرى","فَإِنِ اِنتَهَيتَ مِنَ الكَرى يَتَبدَّدِ",27,"د",1,0],["وَكَأَنَّهُ لِصِفاتِهِ وَسَنائِهِ","بَحرٌ تَعومُ بِهِ الطُيورُ الحُوَّمُ",28,"م",1,0],["وَكَأَنَّ هُدبِيَ أَن تَطولَ ضَلالَتي","وَكَأَنَّ رَبّي أَن يَدومَ أُوامي",29,"م",2,0],["وَكَأَنَها في صَمتِها مَشدوهَةٌ","أَن لا تَرى بِهُتافِها مَشدوها",30,"ه",2,0],["وَكَأَنَّهُ كَلبٌ عَوى","لا بَل أَقولُ بِأَنَّهُ",31,"ن",2,0],["وَكَأَنَّهُ مِن فِطنَةٍ","حاشاهُ شِقٌّ أَو سَطيحُه",32,"ح",2,0],["وَكَأَنَّهُنَّ قَطاً يُصَفِّقُهُ","خُرُقُ الرِياحِ بِنَفنَفٍ رَحبِ",33,"ب",1,0],["وَكَأَنَّهُنَّ أَشاءُ يَثرِبَ حَولَها","جُرفٌ أَضَرَّ بِهِنَّ نِهيٌ بُهَّلا",34,"ل",2,0],["وكأنهم زهر النجوم مضيئة","ما في الفضاء الرحب من اجواز",35,"ز",1,0],["وكأن هذا الليل ثوب اسود","وكأنما فيه النجوم خروق",36,"ق",1,0],["وَكَأَنَّهُ في الفَتحِ عَمّورِيَّةٌ","وَكَأَنَّني فيهِ أَبو تَمّامِ",37,"م",1,0],["وَكَأَنَّهُ نَعشُ الحُسَينِ بِكَربُلا","يَختالُ بَينَ بُكاً وَبَينَ حَنانِ",38,"ن",1,0],["وَكَأَنَّهُم صَرعى كَرى","بِالقاعِ أَو صَرعى شَرابِ",39,"ب",1,0],["وَكَأَنَّهُ في كُتبِهِ","عُثمانُ في ظِلِّ الكِتابِ",39,"ب",1,0],["وَكَأَنَّهُ عيسى الهُدى في مَهدِهِ","وَكَأَنَّ سَعداً يوسُفُ النَجّارُ",40,"ر",1,0],["وَكَأَنَّ هَمسَ القاعِ في أُذُنِ الصَفا","صَوتُ العِتابِ ظُهورُهُ وَخُفوتُهُ",41,"ت",2,0],["وَكَأَنَّهُنَّ كَمائِمٌ","وَكَأَنَّكَ الوَردُ الجَنين",42,"ن",1,0],["وَكَأَنَّها وَالمَوجُ مُنتَظِمٌ وَقَد","أَوفَيتَ ثُمَّ دَنَوتَ كَالمُختارِ",43,"ر",1,0],["وكأنّها والماءُ يَهْشِمُ وَجْهَهَا","قَبَسٌ عَلاهُ مِنَ السّرابِ غَمَامُ",44,"م",1,0],["وَكَأَنَّهُ ما لا تَشاءُ عُداتُهُ","مُتَمَثِّلاً لِوُفودِهِ ما شاؤوا",45,"ا",1,0],["وَكَأَنَّها شَجَرٌ بَدَت لَكِنَّها","شَجَرٌ جَنَيتُ المَوتَ مِن ثَمَراتِها",46,"ت",3,0],["وَكانَ هَديراً مِن فُحولٍ تَرَكتَها","مُهَلَّبَةَ الأَذنابِ خُرسَ الشَقاشِقِ",47,"ق",1,0],["وَكَأَنَّهُ غَرَّتهُ عَينٌ فَاِدَّنى","لا يُبصِرُ الخَطبَ الجَليلَ جَليلا",48,"ل",2,0],["وكأنّها والليلُ وَحْفٌ فاحمٌ","عوجُ المدارى والظلامُ قرونُ",49,"ن",1,0],["وكأنَّها والريحُ يصقلُ خَدَّها","والسُّحْبُ تملؤُها بصَوبِ قَطارِهَا",50,"ر",3,0],["وكأنَّها وَجَناتُ غيدٍ أحدَقَتْ","بخدُودِها حُمْراً خطوطُ عِذارِها",50,"ر",3,0],["وكأنهُ وكأنها في جَنْبِه","عنقودةٌ في زورقٍ من عَسْجَدِ",51,"د",1,0],["وكأنها بحرٌ يُعَبُّ عُبابُه","وكأنه فيها غريقٌ راسبُ",52,"ب",1,0],["وَكَأَنَّها وَالسَمعُ مَعقودٌ بِها","شَخصُ الحَبيبِ بَدا لِعَينِ مُحِبِّهِ",53,"ب",2,0],["وَكَأَنَّهُم لَمّا اِقتَفَوا آثارَهُ","تَبِعوا ضِياءَ الكَوكَبِ الوَقّادِ",54,"د",1,0],["وَكَأَنَّهُ أَلفى الصِبا وَجَديدَهُ","دَيناً دَنا ميقاتُهُ أَن يُقتَضى",55,"ض",2,0],["وكأنَّهُ والحِبرُ يَخضِبُ رَأسَه","شَيخٌ لِوَصْلِ خَريدةٍ يَتَصَنَّعُ",56,"ع",1,0],["وكأنَّه في الغَيْبِ مُطَّلِعٌ","للأمْرِ يُورِدُهُ ويُصْدِرُه",57,"ر",2,0],["وكأنَّه لمّا اكتَسى عَرَقاً","ورَقُ الشَّقائقِ يَحمِلُ القَطرا",58,"ر",2,0],["وَكَأَنَّها بَعدَ الكَلالِ عَشِيَّةً","قَهبُ الإِهابِ مُلَمَّعٌ بِسَوادِ",59,"د",1,0],["وَكَأَنَّها إِذ قُرِّبَت لِقُتودِها","فَدَنٌ تَطوفُ بِهِ البُناةُ مُبَوَّبُ",60,"ب",1,0],["وَكَأَنَّها صَحِلُ الشَحيجِ مُطَرَّدٌ","أَخلى لَهُ حُقبُ السَوارِ وَمِذنَبُ",60,"ب",1,0],["وَكَأَنَّها يَومَ الرَحيلِ وَقَد بَدا","مِنها البَنانُ يَزينُهُ الحِنّاءُ",61,"ا",2,0],["وكأنَّه أحزانُ قومٍ ساروا","هذي مآتمُهم وَثم ظلالُهَا",62,"ه",2,0],["وكأنه في رسمه البالي","ندم الأسيف ودمعة حرَّى",63,"ر",2,0],["وكأنّ هاتيك الشقائقَ قَهْوَةٌ","وكأنّ ساحاتِ الديارِ كؤوسُ",64,"س",1,0],["وكأنّها نونٌ تُمَطّ وعينها","ميمٌ لطولِ نحولها بالفدفدِ",65,"د",1,1],["وكأنّهُ من دُرّةٍ شَفّافَةٍ","تُعْشي العيونَ بشدّة اللمعانِ",66,"ن",1,0],["وكأنّهنّ كراتُ تبرٍ أحمرٍ","جُعِلَتْ صوالجها من القضبانِ",66,"ن",1,0],["وكأنّها ترْمي السماء ببندق","مستنبطٍ من لؤلؤ وجمانِ",66,"ن",1,0],["وَكَأنَّهُ مِن كُلِّ دِرعٍ قَدَّها","يُغْري بأحداقِ الجرادِ نَمالا",67,"ل",2,0],["وكَأَنَّهُ بِكَ لِلأنامِ مهنّئٌ","ومبشّرٌ لك في علوّ المنزلِ",68,"ل",1,0],["وكأنّها شمسٌ على غُصُنٍ","مترنّحَ التقويمِ والميلِ",69,"ل",1,0],["وكأَنَّهُ وكأنَّ غُرَّةَ وَجهِهِ","شفقٌ تألّقَ فيه مطلَعُ شارِقِ",70,"ق",1,0],["وكأنّهُ بالغيثِ باتَ مَحدّثاً","للطرف بالخضراءِ وهوَ سَميعُهُ",71,"ع",2,0],["وكأنّهُ في الدَّهرِ خُيِّرَ فانتقى","أيّامَهُ من حُسْنِها وتَخَيّرا",72,"ر",2,0],["وكَأَنَّهُم في السّابِغاتِ صَوارِمٌ","والسّابِغاتِ لَهُم مِنَ الأَغمادِ",73,"د",1,0],["وكأنّهنّ صوارمٌ ما فعلها","إلّا مِنَ الأَجسامِ في أغمادِ",74,"د",1,0],["وكأنّهُ قَفْرٌ لعينكَ موحشٌ","أبَداً تَمُرّ ببابه ضحضاحا",75,"ح",2,0],["وكأنّه في كلّ داجي شعرةٍ","في الرأسِ منهُ مُوقِدٌ مِصباحا",76,"ح",2,0],["وكأنّه مرداة صخرٍ حَطّهُ","من عَلْوَ سيلٌ ماجَ في تَصويبِ",77,"ب",1,0],["وَكَأَنَّهُ مِن مَدحِهِم في رَوضَةٍ","وَكَأَنَّهُم مِن سَيبِهِ في مَقسَمِ",78,"م",1,0],["وَكَأَنَّهُم في بِرِّهِم وَحَفائِهِم","بِالمُجتَدي الأَضيافُ لِلأَضيافِ",79,"ف",1,0],["وَكانَ هُوَ الجَلدَ القُوى فَسَلَبتَهُ","بِحُسنِ الجِلادِ المَحضِ حُسنَ التَجَلُّدِ",80,"د",1,0],["وكأنَّهُ عريانُ في حمامِهِ","والسدرُ يزهو فوقَ أبيضَ أحمرا",81,"ر",2,1],["وكانَ هناكَ الصمتُ أجملُ بي وأنْ","أصيخَ سماعاً لا أعيدُ ولا أبدي",82,"د",2,0],["وَكَأَنَّهُ مِن عَزمَةٍ في رَحمَةٍ","مُتَرَكِّبٌ مِن جُذوَةٍ في ماءِ",83,"ا",2,0],["وَكَأَنَّهُ وَكَأَنَّ رَجعَ نَشيدِهِ","فَصلُ الرَبيعِ وَرِنَّةُ المُكّاءِ",83,"ا",2,0],["وَكَأَنَّها وَكَأَنَّ جَدوَلَ مائِها","حَسناءُ شُدَّ بِخَصرِها زِنّارُ",84,"ر",1,0],["وَكَأَنَّهُ ذو فَجعَةٍ لِفِراقِها","قَد ضَمَّ مِن خَوفِ الوَداعِ غَليلا",85,"ل",2,0],["وَكَأَنَّهُ إِذ لاحَ ناصِعُ فِضَّةٍ","جَعَلَتهُ كَفُّ الشَمسِ تِبراً أَصفَرا",86,"ر",2,0],["وَكَأَنَّها كَبد يَصرّعها الأَسى","وَكَأَنَّهُ لَمّا تَعلقها يَد",87,"د",1,0],["وَكَأَنَّهُنَّ بِها عُرَينَةُ","في طَوائِفِها وَهاجِر",88,"ر",1,0],["وَكَأَنَّها وَالشَربُ قَد أَذِنوا لَها","دَنِفٌ أَشارَ بِرَأسِهِ فَطَأَوَّها",89,"ه",2,0],["وَكَأَنَّها عَدواً قَطاةٌ صَبَّحَت","زُرقَ المِياهِ وَهَمُّها في المَنزِلِ",90,"ل",1,0],["وَكَأَنَّ هاتَنَ وَبلِهِ","قُطنٌ أُطَيرَ مُنَدَّفا",91,"ف",2,0],["وَكَأَنَّهُ لَمّا تَبَد","دى في المَشارِقِ خَطُّ شارِب",92,"ب",1,0],["وكأَنَّه قاضٍ يقولُ لِخَصمِهِ","هذا غَرِيمُكَ أَثْبَتَ التَّفْلِيسا",93,"س",2,0],["وكأنّها الدّهْرُ المُنيخُ عليهِمُ","لا يُستَطاعُ لِصَرفِهِ تحوْيل",94,"ل",1,0],["وكأنّها شمسُ الظّهيرَةِ فوقَهُمْ","يرْتَدُّ عنها الطَّرْفُ وهو كليل",94,"ل",1,0],["وَكَأَنَّهُم قَد عَطَّروكَ بِما","يَتَزَوَّدُ الهَلكى مِنَ العِطرِ",95,"ر",1,0],["وَكَأَنَّهُم قَد قَلَّبوكَ عَلى","ظَهرِ السَريرِ وَظُلمَةِ القَبرِ",95,"ر",1,0],["وَكَأَنَّهُنَ أَهِلَّةٌ","تَحتَ الثيابِ رَفَقنَ شَمسا",96,"س",2,0],["وَكَأَنَّها بَردُ الشَرا","بِ صَفا وَوافَقَ مِنكَ فِطرا",97,"ر",2,0],["وَكَأَنَّ هَمّي وَالظَلامَ تَواعَدا","عِندي فَكُلٌّ قَد وَفا بِالمَوعِدِ",98,"د",1,0],["وَكَأَنَّها شَرِبَت سُلافَةَ بابِلٍ","بِالساهِرِيَّةِ خالَطَت قِنديدا",99,"د",2,0],["وَكَأَنَّهُم في نَحرِ كُلِّ مَخوفَةٍ","أُسُدٌ جَعَلنَ لَها المَلاحِمَ عيدا",99,"د",2,0],["وَكَأَنَّ هامَةَ رَأسِهِ بِطّيخَةٌ","حُمِلَت إِلى مَلِكٍ بِدَجلَةَ جابِ",100,"ب",1,0],["وَكَأَنَّهُ مِن وَحشِ وَجرَةَ ناشِطٌ","يَقرو العَقَنقَلَ آلِفاً بِعَذابِهِ",101,"ب",2,0],["وَكَأَنَّها لَمّا مَشَت","أَيمٌ تَأَوَّدَ في كَثيب",102,"ب",1,0],["وَكَأَنَّها لَمّا دَنَت مِن شَيبِهِ","شَقِرٌ لِنورِ الإِقحِوانِ مَلابِسُ",103,"س",1,0],["وَكَأَنَّ هَذا الخَلقَ أَهلُ جَهَنَّم","وَلَهُم مِنَ المَوتِ الزُؤامِ سِراطُ",104,"ط",1,0],["وكأن هَذا اللَيل سجف أَسوَد","وَكأَنَّما فيه النجوم خروق",105,"ق",1,0],["وكأنه ما لا تشاء عداته","متمثلاً لوفوده ما شاءوا",106,"ا",1,0],["وكأَنَّها أَظْبٍ رَعَفْ","نَ فثُرْنَ دامِيَةَ الخَياشِمْ",107,"م",1,0],["وَكَأَنَّهَا حَوْلَ الْمَجَرِّ حَمَائِمٌ","بِيضٌ عَكَفْنَ عَلَى جَوَانِبِ مَشْرَعِ",108,"ع",1,0],["وَكَأَنَّهَا أُكَرٌ تَوَقَّدَ نُورُهَا","بِالكَهْرَبَاءَةِ فِي سَمَاوَةِ مَصْنَعِ",108,"ع",1,0],["وَكَانَ هِلاَلُهَا لِلتِّمِّ رَمْزاً","أَلَيْسَ التِّمُّ وَعْداً لِلهِلاَلِ",109,"ل",1,0],["وَكَأَنَّهَا بِلطَافَة عُلْويَّةٍ","زَانَتْ لَنَا مُتَفَيَّأَ الأَشْجَارِ",110,"ر",1,0],["وَكأَنَّهمْ لاَ يَجْزَعو","نَ لِمَثْلِ هَذِي فِي الكبَائرْ",111,"ر",1,0],["وكأَنهُنَّ رَأَيْنَ بِالْ","أَبْصَارِ ما رَأَتِ الْبَصَائِرْ",112,"ر",1,0],["وكأنه سلب الضحايا لونها","أفلا تراه بصفرة يتلثّم؟",113,"م",1,0],["وكأنها خطرت لها ابنتها وما","تلقاه من ألم الطوى المقلاق",114,"ق",1,0],["وكأنها لما رأتهُ صفّقت","وتضاحكت في وجههِ تَتَهَكَّمُ",115,"م",1,0],["وَكَأَنَّهُنَّ إِذا اِنحَنَينَ رَواكِعٌ","صَلَّت إِلى قِبَلٍ مِنَ الأَكبادِ",116,"د",1,0],["وَكَأَنَّهُ مُلكٌ نَمى","فَعُزِلتُ حينَ وَليتُهُ",117,"ه",1,0],["وَكَأَنَّهُ يَومَ العُروبَةِ موثق","أَسراً وَيَوم السَبتِ يَوم فِداءِ",118,"ا",2,0],["وكأنه لا يشتفي","من ريقها العذب البرود؟",119,"د",1,0],["وكأنّه وهج إلاهيّ السنا","ومنابر تمحو دياجير العمى !",120,"م",2,0],["وكأنّه قلب يذوب تأوّها","للبائسين ويستفيض ترحّما",120,"م",2,0],["وَكَأَنَّها شَجَرٌ بَدَت لَكِنَّها","شَجَرٌ جَنَيتُ المرَّ مِن ثَمَراتِها",121,"ت",3,0],["وكأنَّه ، إذ خِيفَ مَسبَحُه","مُتَرِّهبُ قد سُدَّ مَعْبَده!",122,"د",2,0],["وكأنَّه \" للمستغيث\" إغاثةٌ","وكأنَّه \" للجائعين \" إدام",123,"م",1,0],["وكأنه بين السُّطور مدِّبرٌ","للجيش اعَجَبه انتظامُ صُفوفه",124,"ف",2,0],["وكانها.. بالطيب....؟ ماعقب الحصان؟.؟ الا الحصاني..؟","وكانها... بالجيد...ياطيب.. أأأأخر المعنز؟؟ وجيده....",125,"د",2,0],["وكانها في فبركة.. ضرب المعاني..؟ بالمعاني....؟","الشعر... يسجد لوجهي...؟ كل ... ماسوي جديده...",125,"د",2,0],["وكأنها تَرْمي السماء ببندق","مستنبَطٍ من لؤلؤ وحجان",126,"ن",1,0],["وكأنه حلم يصحّ مع الكرى","فإن انتهت من الكرى يتبدّد",127,"د",1,0],["وكأنّه لصفائه وسنائه","تعوم به الطّيور الحوّم",128,"م",1,0],["وكأنه فيها قد لحظ الصَّبا","ورمى المنام بُبعْده وبصدِّهِ",129,"د",2,0],["وكأنه في الفتح عموريَّة ٌ","أَسِمُ العصورَ بحسنِهِ، وأنا الذي",130,"ي",1,0],["وكان هذا النّوء والموج والدّجى","ليرهب نفسا حقّرت ما تصادف",131,"ف",1,0],["وكان هو المعروف في حضرة العمى","بل العالم الموصوف في عالم الأسما",132,"م",2,0],["وكأنها علمت مقاديرَ الهوى","فتصرفت لَهُمُ على مقدارِ",133,"ر",1,0],["وكأنها من حُسنها وجَمالها","وكمالها حُورِيّةٌ حسناءُ",134,"ا",2,0],["وكَأنَّهُنَّ إِذَا رَنِينَ مِنَ المَهَا","عِينٌ مَطَافِلُ قَد أحَسنَ مُخَاتِلا",135,"ل",2,0],["وكَأنَّهُنَّ إذا ابتَسَمنَ بَوَارِقاً","بَل هُنَّ أحسَنُ طَلعَةً وأقَاوِلا",135,"ل",2,0],["وكَأنَّهُنَّ تَثَنِيًّا وتَمَايُلاً","بَانُ النّقَى مُتَثَنِياً مُتَمَائِلا",135,"ل",2,0],["وَكانَ هِشامُ بنُ المُغيرَةِ عِصمَةً","إِذا عَرَكَ الناسَ المَخاوِفُ وَالفَقرُ",136,"ر",1,0],["وكأنها الخطباءُ فوقَ بنانهِ","لكن بلاغُتها كلامُ المنبرِ",137,"ر",1,0],["وكأنه أثرا حبيبٌ خاطب","وكانه زهراً عروسٌ تجتلي",138,"ل",2,0],["وكأنها قد ألحقت","بمن انقضى من قبلها",139,"ل",3,0],["وَكَأَنَّها تَهْوى إِذاعَةَ ضَوْئِها","لِلنَّاظِرِينَ لِسَعْدِهِمْ بِنُحُوسِها",140,"ه",2,1],["وَكَأَنَّها وكأَنَّ حاملَ كأْسها","إِذ قامَ يجْلوها عَلى النُّدَماءِ",141,"ا",2,0],["وكان هو القاضي وكان الذي ادعى","وكان إذا الأشهاد بلغت عن عمرو",142,"ر",2,0],["وكأنّها في كأسِها مسفوحةً","من عتقِها تُنْبي عن السّفّاحِ",143,"ح",1,0],["وكأن هَتْف الوُرْقِ في أَغصانِها","لفظٌ يُفيدك من فصيحٍ أَخْرس",144,"س",1,0],["وَكَأَنَّها وَسَطَ النِساءِ أَعارَها","عَينَيهِ أَحوَرُ مِن جَآذِرِ جاسِمِ",145,"م",1,0],["وكأنهُ أبراجَ السما حجراتُها","في كلِّ برجٍ كوكبٌ وقادُ",146,"د",1,0],["وكأنها عقدٌ تناثرَ درُّهُ","من جيدِ غانيةٍ ولم تتعمدِ",147,"د",1,0],["وكأنهُ صدرُ المليحةِ عارياً","ما بينَ لبتها وبينَ المعقدِ",147,"د",1,0],["وكأنها إذ أحدقتْ في جانبي","حسبتْ هلال سمائِها في مضجعي",148,"ع",2,0],["وكأنها عند التَّعَط","طُفِ مُصغياتٌ للسَّرارِ",149,"ر",1,0],["وكأنهنَّ مع النَّسا","ئم في عتابٍ واعتذارِ",149,"ر",1,0],["وكأنَّه في سَرحِهِ ضرغامُهُ","صاف الى مُهَج الورى يتصرَّفُ",150,"ف",1,0],["وكأنه قمرُ النهار بياضه","إذ حفَّه لونُ السماء الأخضرُ",151,"ر",1,0],["وكأنهم لم يبصروا","في خلّتي الحر الصدوق",152,"ق",1,0],["وكأنها ألف بليت بجرها","ما كنت أعهد قبلها ألفاً تجر",153,"ر",1,0],["وكأنه علم يُنيفُ على الورى","ترنو إليه وتخشع الأقدار",154,"ر",1,0],["وكأنها تخطو إذا نهضت","فوق المناصل أو على الجمر",155,"ر",1,0],["وَكَأَنَّ هَذا صيغَ مِن","خَزَفٍ وَذا مِن عَسجَدِ",156,"د",1,0],["وكأنها في فيه لما أغربت","شمس النهار تغيب في بدر الدجا",157,"ج",2,0],["وكأنها في كل بيت شمته","منها تضم من القريض مهندسا",158,"س",2,0],["وكأن هينمةَ النسيمِ تقولُ لي","تلكَ المليحةُ يا فتى تهواكا",159,"ك",2,0],["وكأنهُ البلسانُ مِنهُ قد بَدا","وَردٌ على الأغصانِ لم يَتَفَتَّح",160,"ح",1,0],["وكأنه رنّاتُ صو","تِكِ بينَ أصواتِ المِلاح",161,"ح",1,0],["وكأنه أنّاتُ شِع","ري إن بسِرِّ هواكِ باح",161,"ح",1,0],["وكأنه حناتُ نَف","سي في الغدوِّ وفي الرُّواح",161,"ح",1,0],["وكأنهنَّ لفرطِ ما أسبَلنَها","صيرَّنَ حباتِ القلوبِ عُيونا",162,"ن",2,0],["وكأنه النارُ التي منها الهُدى","للتائهينَ وكلّهم رُوَّاد",163,"د",1,0],["وكأنَّهم وكأنَّ سُبَّقَ خَيْلِهم","وَسْط العَجَاج ضَراغِمٌ وصُقورُ",164,"ر",1,0],["وكَأنّه مِمّا تَرَنّم مَاجِنٌ","وكأنّه ممّا بَكى أوّابُ",165,"ب",1,0],["وكَأنّه بِنُثَارهِ وَمَدارِه","فَلَكٌ كواكِبُهُ لَها أذنابُ",165,"ب",1,0],["وَكَأَنَّهُ بَدرٌ أَضاءَ بِأَسعُدٍ","بِضِيائِها هَزَمَت ضِياءَ الأَنحُسِ",166,"س",1,0],["وَكَأَنَّهُ في الجَيشِ لَيثٌ راحَ في","أَجَمِ الرِماحِ مِنَ السَوابِغِ مُكتَسِ",166,"س",1,0],["وَكَأَنَّهُم بَحرٌ تَدافَعَ مَوجُهُ","بِظُبىً وَزَغفٍ مُحكَمٍ وَسَنَوَّرِ",167,"ر",1,0],["وَكَأَنَّهُم عِندَ النِزالِ صَوارِمٌ","قَد فارَقَت يَومَ النِزالِ غُمودا",168,"د",2,0],["وَكَأَنَّهُم شَربٌ تَعاطَوا قَرقَفاً","عُنقودُها أَكرِم بِهِ عُنقودا",168,"د",2,0],["وَكَأَنَّهُ الزَوراءُ وَالأَقلامُ أَس","همه بِها يفري كُلى الزَوراءِ",169,"ا",2,0],["وَكأنَّها لمَّا بَدَتْ","تختالُ في زُرْقِ الثِّيابِ",170,"ب",1,1],["وكأَنها في الماء خَوْدٌ شَمَّرتْ","عن ساقِها عند الورودِ لتستقي",171,"ق",2,0],["وكأنها استحيتْ فغضَّتْ طرفَها","وتطأْمنتْ خَفَراً برأْسٍ مطرق",171,"ق",1,0],["وكأنها سكرى تمايَلَ عنقُها","ورنتْ بجفْنٍ بالنعاسِ مرنَّق",171,"ق",1,0],["وكأنها وجناتُ غيدٍ نقطها","خالٌ على الأصداغ من جيماتها",172,"ت",3,0],["وكأنه في مائها وهضابها","ما داس إلا أعينا وجباها",173,"ه",2,0],["وكأنه ما كان فيها ساكن","أو مؤنس أو من يجيب إذا دعى",174,"ع",2,0],["وَكأنّها بِحضارةٍ ونضارةٍ","وَرفوهِ سكّان رياض جنانِ",175,"ن",1,0],["وَكَأَنَّه فَهمَ الأَلِيَّةَ فَاِختَشى","أَن يَستَحيلَ إِلى العُقوق بُرورُ",176,"ر",1,0],["وكان هلاك الحرث والنسل عاجلاً","وذاك بلا شك خراب البسيطة",177,"ه",1,0],["وَكانَ هَذا كَما أَنهى مَعايِنَهُم","مِن بَعدِ ما أَخبَرَ الأَقوامَ كاهِنَهُم",178,"م",1,0],["وَكَأَنَّهُنَّ مِنَ الكَلالِ أَهِلَّةٌ","أَو مِثلُهُنَّ عَطائِفُ الأَقواسِ",179,"س",1,1],["وَكَأَنَّهُ عانٍ يُشاوِرُ نَفسَهُ","غابَت أَقارِبُهُ وَشُدَّ وَثاقا",180,"ق",2,0],["وَكَأَنَّهُ فيهِ النُجومُ إِذا","جَدَّ المَسيرُ بِها عَلى مَهلِ",181,"ل",1,0],["وكأنَّهُ وَيَداهُ في مِجْذافهِ","رَامَ الطّعانَ بِصَعْدةٍ سَمْراءِ",182,"ا",2,0],["وَكَأنَّهُم فِي كُلِّ مَدرَجِ نَاسِمٍ","فَعَلَيهِ مِنهُم رِقَّةٌ وَتضَوُّعُ",183,"ع",1,0],["وَكانَ هُرَيمٌ مِن سِنانٍ خَليفَةً","وَحِصنٍ وَمِن أَسماءَ لَمّا تَغَيَّبوا",184,"ب",3,0],["وكأنّه يومَ الهِياجِ مُحَرِّشٌ","يَسعَى لكي يَتصادم الزَّحْفان",185,"ن",1,0],["وكانَ هُوَ الطّالبَ الشُّغْلَ منه","فحسْبُك أنّا لكَ الطّالِبونا",186,"ن",2,0],["وكأنّه الشَّمسُ المنيرةُ طالعَتْ","خِططَ البلادِ من القَصيّ إلى الدُّنا",187,"ن",2,0],["وكأنّها والدّهرَ نَهْجٌ ضَيِّقٌ","أَصبحتَ تَسلُكُ فيه جَيْشاً أَرْعَنا",187,"ن",2,0],["وكأنّه قد دُرّعَ النّارَ الّتي","قدحَتْ سَنابِكُه النّواهِبُ للفلا",188,"ل",2,0],["وكأنّه حَنِقٌ بلا حَنَقٍ","يُغْشِي السّياطَ البَطْنَ والظَّهرا",189,"ر",2,0],["وكأنّهُنّ نَزعْنَ من أجيادِها","تلك العقودَ ونُطْنَها بخُدود",190,"د",1,0],["وكأنّها وَسْطَ الفدافِدِ ناشِطٌ","راعَتْهُ غُضْفٌ شَفَّها التَّغْريث",191,"ث",1,0],["وكأنّه الظّفر الهَنيءُ بُلوغُه","يَلْتَذُّهُ مَن كان منه قَريبا",192,"ب",2,0],["وَكَأَنَّها مِن شَوقِهِ وَنَسيمِهِ","مِثلُ المَجامِرِ فاحَ مِنها الطيبُ",193,"ب",1,0],["وَكَأَنَّهُ وَالشَيبُ يَخضِبُ وَجهَهُ","فَأرٌ تَمَرَّغَ في دَقيقِ القُفَّةِ",194,"ه",1,0],["وَكَأَنَّها في كَفِّهِ","بَرقٌ تَضاحَكَ مِن غَمامِ",195,"م",1,0],["وكأنَّهنَّ الصافِنا","تُ يَقودُهنَّ أبو الرِّضا",196,"ض",2,0],["وكأنهنَّ أصولُ أش","جارِ القَنا المُتَشاجِرِ",197,"ر",1,0],["وكأنهنَّ رَبطنَ لي","حبلَ السرورِ عَلى السرورِ",198,"ر",1,0],["وَكانَ هارونَ موسى لو تَبَيَّنَهُ","مَن قد غَدا النَصب دون الرشد يَعميه",199,"ي",2,0],["وكان هنا خيرُ البرايا محمدٌ","يناجي وفي ثَوْبِ التعبُّدِ يَرْفُلُ",200,"ل",1,0],["وكأنه الخفاش ينتظر الدجى","ليطير لما تغمض الأهداب",201,"ب",1,0],["وكأنها من بابل عصرت","فأتت بأنواع من السحر",202,"ر",1,0],["وَكَأَنَّهُ مِن يُمن حيدرة استَعارَ","النَصرَ فَهوَ عَلى القُلوبِ مُظَفَّرُ",203,"ر",1,0],["وَكَأَنَّهُ في كُل معرَكَةٍ لَهُ","ليث لَهُ في فعلِهِ المتغضِّبِ",204,"ب",1,0],["وكأنَّهُمْ إذ أَعْرَضُوا وَتَعَرَّضُوا","كانُوا لنا حَزَناً فَعَادَ سُرورا",205,"ر",2,0],["وكأَنَّهُمْ زَهَرٌ علي","هِ من غلائِلِهِمْ كمائِمْ",206,"م",1,0],["وكأنه والنّقعُ عنه سافِرٌ","داجي دُخانٍ شقّ عن مصباحه",207,"ح",2,0],["وكأنه ظن النجومَ كواعباً","فرمى لها بملاءةٍ من فجرِه",208,"ر",2,0],["وكأنها من فعلها","تحكي الذي في ناظريه",209,"ه",1,0],["وَكَأَنَّه مِنْ حُوَّةٍ وَلَمىً","قَدْ قَبَّلَتْهُ الشَّمْسُ في فمِهِ",210,"ه",1,1],["وكأَنَّهُ من تحتِ سَوْطِيَ خارجاً","في الرَّوعِ شُعْلَةُ قادحٍ بِزِنادِ",211,"د",1,0],["وكأَنَّهُنَّ وَقَدْ دَجَتْ ظُلَمُ الوَغى","فِي الرَّوعِ أَفلاكٌ عَلَيْكَ مَدَارُها",212,"ر",3,0],["وكأنها طلبت من الأرض الحيا","فتحدرت فوق الرياض حبالها",213,"ل",3,0],["وكأنها المفراق بعدك أَردفت","أَثر الزفير ترزم الثكلاء",214,"ا",2,0],["وكأنها من طول ما ولهت أَسى","فقدت لفقدك جملة الأَكفاء",214,"ا",2,0],["وكأنها البيت الحرام مقدسا","وكأنهم طير عليه سجوع",215,"ع",1,0],["وكأنه وكأننا لم نفترق","من قبل هذا الموعد المضروب",216,"ب",1,0],["وكأنها لما تألف سجعها","متشاجرات فى ذرى الشجرات",217,"ت",1,0],["وكأنَّها حُكمُ القرونِ فلم تزل","تَدوى لأخصامٍ لنا وأصادق",218,"ق",1,0],["وكأنَّهم رُسُل المسيحِ بوعظهِ","حُراً على الجبل الفخور السامِقِ",218,"ق",1,0],["وكأنَّهم أكوازُ ساقية","دوَّارةٍ بالشِّر للفطنِ",219,"ن",1,0],["وكأنها بين الشفاهِ قصائداً","فوق النحورِ قلائدٌ وعقودُ",220,"د",1,0],["وكأنها وبِساطَها وحُلِيَّها","للمستبين أخي الفؤادِ الأصْمعِ",221,"ع",1,0],["وكأنَّهُ في النَّاس شمسُ ظَيهرةٍ","يَجْلو مَحاسنها سَحيقٌ مُمْرِع",222,"ع",1,0],["وكأنّهُ بين القواضب والقنا","يختال بين لواحظٍ وقدود",223,"د",1,0],["وكأنّهُ لفظ الهناءِ بمقدمِ ال","ملك العزيز الذّه ما جدّدا",224,"د",2,0],["وكأنها ورد سما في روضه","وكأنها نجم علا لتلاق",225,"ق",1,0],["وَكَأَنَّ هِمَّةَ رَبِّهِ قالَت لَهُ","طُل وَاِرقَ في دَرجِ المَعالي وَاِصعَدِ",226,"د",1,0],["وكأنها فلك ووجهك شمسه","لولا اعتماد رتاجها بعماد",227,"د",1,0],["وكأنه معه زيادة خنصر","سيان إن وجدت وإن لم توجد",228,"د",1,0],["وكأنها فرض يرد بردة","ألزمتهم بعقالها وعناقها",229,"ق",3,0],["وكَأنهُ فَلَكٌ يَدُورُ بأنجُمٍ","من بَعدِ رُؤيتِها يُريكَ أفُولا",230,"ل",2,0],["وكأنَّها في الطَّلْقِ تُطلقُ أنجماً","من ثغرِها فإذا المجرَّةُ تُزهِرُ",231,"ر",1,0],["وكأنّه يأتي الحُتو","فَ أو الخسوفَ إذا أتاها",232,"ا",3,0],["وكأنّها في قَفرةٍ","عَصْفٌ تصفّقهُ صَباها",232,"ا",3,0],["وكأنّه دَنِفٌ تجلّد مؤنساً","عُوّادَه حتّى اِستَبان سَقامُهُ",233,"م",2,0],["وكأنّه لمّا مضى بمسرّتي","عَجِلاً أتاني من مَطيفِ خيالي",234,"ل",2,0],["وكأنّهنّ يخُضن ماءَ ترائبٍ","لمجدّلين يخُضن ماءَ وُحولِ",235,"ل",1,0],["وكأنّها عشواءُ في غبشِ الدّجى","تطوي الفَلا خَبْطاً بغير دليلِ",235,"ل",1,0],["وكأنّها للمبصريها جَذوَةٌ","ولناشقيها فَغْمةٌ لشَمولِ",235,"ل",1,0],["وكأنّها روضُ الفلا عبثتْ به","أيدي شمالٍ سُحْرةً وقَبولِ",235,"ل",1,0],["وكأنّهمْ ليلٌ بلا سَحَرٍ","يأتيه أو عقدٌ بلا حلِّ",236,"ل",1,0],["وكأنّهمْ في صدر جارهمُ","حَنَقاً عليهمْ مِرْجَلٌ يغلي",236,"ل",2,0],["وكأنّهمْ قُضُبٌ يمانِيَةٌ","مصقولةٌ من غير ما صَقْلِ",236,"ل",1,0],["وكأنّه فرداً إذا شهد الوغى","ضرباً وطعناً معشرٌ وقبيلُ",237,"ل",1,0],["وَكأنّه متراكماً صُمٌّ هَوَتْ","من شاهقٍ أو جِلّةٌ من دَرْدَقِ",238,"ق",1,0],["وكأنّهمْ شَرَدٌ سوامُهُمُ وقد","سمعوا على جوّ السّماء حفيفي",239,"ف",2,0],["وكأنّهمْ يومَ الوغى خَلَلَ القنا","حيّاتُ رَمْلٍ أو أُسودُ عَزيفِ",239,"ف",1,0],["وكأنّهمْ لم يعلموا أنّ الّذي","جَمَعوا بمرأىً للخطوب ومسمعِ",240,"ع",1,0],["وكأنّهمْ لخُفوتِهمْ","شَرْبٌ تساقَوْا بالكؤوسِ",241,"س",1,0],["وكأنّه بُرْدُ الشّبابِ نضارةً","أو بِشْرُ آونةِ الرّبيع الزّاهرِ",242,"ر",1,0],["وكأنّه بعد المشيب مبشّرِي","بإيابِ آونةِ الشّبابِ الناضِرِ",243,"ر",1,0],["وكأنّهمْ بيد الحِمامِ يلفُّهمْ","عَصْفٌ تصفِّقُهُ خَريقٌ صَرْصَرُ",244,"ر",1,0],["وكأنّه في ليلِ أقوالٍ مضتْ","قمرٌ بدا وسْطَ الدُّجُنَّةِ أنورُ",244,"ر",1,0],["وكأنّه والبرقُ ملتمعٌ به","بُرْدٌ على أيدي الرّياحِ مُحبَّرُ",244,"ر",1,0],["وكأنّهمْ من بعدما سكنوا الْ","أجداثِ ما هَزَلوا وما جدّوا",245,"د",3,0],["وكأنّه ينسابُ في خَلَلِ القنا","يومَ الكريهةِ أرْقمٌ مَزؤودُ",246,"د",1,0],["وَكأنّهمْ لمّا عموا بظلامِ أرْ","ماسٍ لهمْ ما أشرقوا أو أبْلجوا",247,"ج",3,0],["وكأنّهُ متنمّراً","صَقْرٌ تشرّف من عَلاةِ",248,"ه",1,0],["وكأنّه سَقياً لهُ","ما مات لمّا أن حَييتا",249,"ت",2,0],["وَكأنّهُمْ بِقُبورِهمْ","سَبَتوا وما بهِمُ سُباتُ",250,"ت",1,0],["وكأنّهمْ لم يسمعوا","ماذا تقولُ النّاعياتُ",250,"ت",1,0],["وَكَأَنَّها وَالماءُ يَطلُبُ حِلمَها","لَهَبٌ تُلاطِمُهُ الصَبا في مَقبَسِ",251,"س",1,0],["وكان هذا بسر لاح لي زمناً","هو الوجود وتفريعي وتأسيسي",252,"س",2,0],["وكأنَّهُ يجني على فُضَلائهِ","حَسَداً لهم فيَرُدُّ ما قد أنعَما",253,"م",2,0],["وكأنّه من حِدّةٍ","ونفاذِ تدبيرٍ شَرَارَهْ",254,"ر",2,0],["وكان هذا فيه كيلا يشتبه","من طلب القيام في ذلك به",255,"ه",1,0],["وكان هذا سبب الهلاك","والحيف والردة والإشراك",255,"ك",1,0],["وكأَنَّه من دلِّهِ وحيائِه","غيداءُ لكِن في شَمائِل أَغْيدِ",256,"د",1,0]]}