{"poems":[[93,"خرج الناس يشترون هدايا","https://www.aldiwan.net/poem8746.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[469,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[556,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87065","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86794","الخفيف"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96454","الكامل"],[5488,"وآشيب رأسي وا محنتي والوسف","https://www.poetsgate.com/ViewPoem.aspx?id=100735",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""]],"verses":[["وَإِلى ذي الغِنى الَّذي يَرهَبُ","الفَقرَ اِزدِيادَ الَّذي بِهِ مِن عَذابِ",0,"ب",1,0],["وَإِلَى ذَاكَ مَوْئِلُ العِلمِ إِنْ لَمْ","تَرْحَبِ الأَرْضُ بِالهُدَى وَالهُدَاةِ",1,"ه",1,0],["وَإِلى ذَاكَ لَمْ يَكُنْ فِي بَديعِ","النَّظْمِ إِلاَّهُ فِي بَديعِ النَّثْرِ",2,"ر",1,0],["وإلى ذي الرتبتيْن ابتدرتْ","فُرصُ المجدِ وحاجاتُ الأريبِ",3,"ب",1,0],["وإلى ذرى الملك الهجان ترفَّعت","عن كل مقروف البنان هجينها",4,"ن",3,0],["وإلى ذُرا ملك الملوك أثَرْتُها","واللَّيلُ مشتملٌ بشملةِ أدْرَعِ",5,"ع",1,0],["وَإِلى ذاتك الكَريمة يُهدَى","مِن ضروب المَديح أَوفر قسم",6,"م",1,0],["وَإِلى ذاتك الشَريفة شُكري","لَم يَزَل كُلَّما ذُكرت يَزيد",7,"د",1,0],["وَاليَذمُرِىَّ عَلَى تَقَادُمِ عَهدِهِ","مِمّن قَضَيتُ لَهُ قَضَاءَ الفَيصَلِ",8,"ل",1,0],["وإلى ذكرته قلبي والفؤاد يقف","شروى الذّي وافق خصيمه وروعه",9,"ع",2,0],["وإلى ذاك موئل العلم إن لم","ترحت الأرض بالهدى والهداة",10,"ه",1,0]]}