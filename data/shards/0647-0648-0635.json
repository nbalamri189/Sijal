{"poems":[[93,"إن يقض اسماعيل عاصم","https://www.aldiwan.net/poem11404.html","مجزوء الكامل"],[88,"أن من حاز في العلوم إجازه","https://www.aldiwan.net/poem45000.html","الخفيف"],[85,"لا يقيمن على الضيم الأسد","https://www.aldiwan.net/poem8101.html","الرمل"],[66,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[66,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[105,"اسألي يا نجد أهل الميفعه","https://www.aldiwan.net/poem43578.html","الرمل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54791","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[67,"إنْ يدْعُهُ الإنجيلُ فارقليطهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14559",""],[85,"لا يقيمنَّ على الضَّيمِ الأسدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9643&r=&rc=133",""],[107,"ما للحبيب المعرض المتلاهي","https://www.aldiwan.net/poem16237.html","الكامل"],[229,"بين العقيق وبين سلع مربع","https://www.aldiwan.net/poem44569.html","الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[269,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[269,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[303,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[362,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[429,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[480,"نور الحق هداني بفضل عطاني","https://www.aldiwan.net/poem24198.html","عموديه"],[512,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[556,"هو صبغة العدم الذي هو كلنا","https://www.aldiwan.net/poem33850.html","الكامل"],[556,"قف على أيمن الحمى كوقوفي","https://www.aldiwan.net/poem34361.html","الخفيف"],[556,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["هُوَ صَارِمٌ لِلعَدْلِ يُخْشَى","جَانِبَيْهِ أُولُو المَظَالِمْ",0,"م",1,0],["هُوَ صَاحِبُ الصَّوْتِ الَّذِي","تَعْنُو لَهُ الأُسْدُ الضَّرَاغِمْ",0,"م",1,0],["هو صيد ولم يَعُد يجعل المُص","طادُ منه غير التجاريب بازه",1,"ز",2,0],["هُوَ صَوتُ الحَقِّ لَم يَبغِ وَلَم","يَحمِلِ الحِقدَ وَلَم يُخفِ الحَسَد",2,"د",1,0],["هُوَ صادِقُ الوَعدِ الَّذي لِوَفائِهِ","نَستَشهِدُ الآياتِ وَالتَنزيلا",3,"ل",2,0],["هُوَ صاحِبُ البَلَدِ الَّذي لِسَماحِهِ","بِالرِفقِ يَبلُغُ لا بِشَقِّ الأَنفُسِ",4,"س",1,0],["هو صِنْوُ الشّرِّ أو تَوأمُهُ","ما ثَوى في موطنٍ إلا مَعَهْ",5,"ع",2,0],["هُوَ صَخْرَةٌ ما زُوحِمَتْ صَدَمَتْ فلا","تَبْغُوا لها إلَّا النُّجُومَ وُعُولا",6,"ل",2,0],["هُوَ صِبغَةُ الفُرقانِ نَفحَةُ قُدسِهِ","وَالسينُ مِن سَوراتِهِ وَالراءُ",7,"ا",2,0],["هُوَ صورَةٌ رَاعَ القُلُوبَ جَمَالُهَا","وَسَعَتْ عَلَى صِغَرٍ جَلاَلَ الوَادِي",8,"ي",1,0],["هو صُورةٌ للبِشْرِ أُحْكِم رَسْمُها","لو أنَّ أَيَّامَ السُّرورِ تُصَوَّر",9,"ر",1,0],["هوَ صخرة ٌ ما زوحمتْ صدمتْ فلا","إلاَّ ونالَ بِجُودِهِ المَأْمُولا",10,"ل",2,0],["هو صوتُ ، الحقِّ ، لم يبغِ ، ولم","يحمل الحقدَ ، ولم يحفِ الحسدَ",11,"د",1,0],["هُو صَيقل الأَرواح في وَجناتِهِ","نزهُ العُيون وَكُل مَعنى لاهي",12,"ي",1,0],["هو صفوة ارحم وهو حبيبه","وله المقامات التي لا تدفع",13,"ع",1,0],["هُوَ صاحِبُ الحَوضِ الَّذي مِن جَنَّةِ ال","فردَوسِ يَشخبُ فيهِ ميزابانِ",14,"ن",1,0],["هُوَ صاحب الاحاكم وَالحكم الَّتي","طلعت طَلائعها هدى للمهتدى",15,"د",2,0],["هُوَ صفوة الباري وَخاتم رسله","وأمينه المَخصوص منه بفضله",16,"ه",1,0],["هو صادقُ العزماتِ قرّر مجدهُ","صدقاً بذا القانونِ عهد أمانِ",17,"ن",1,0],["هو صومٌ وافَى ووجْهُك عِيدٌ","هل رأيتُمُ صَوماً يُفارِقُ عِيدا",18,"د",2,0],["هو صفوةُ الله الَّذي نَعشَ الهدى","وحبيبُهُ بالنصِّ من خيرِ الورى",19,"ر",2,0],["هو صدرٌ للدين شرقاً وغرباً","وعلى بابه الأنيسِ الوُفودُ",20,"د",1,0],["هو صفا شربي برضاب خمار","ليا صفات المعنى يا باب",21,"ب",1,0],["هو صدرُ أسمرِه وقبضةُ قوسِه","وعِذارُ أبيضِه لدى الهَيجاءِ",22,"ا",2,0],["هو صبغة العدم الذي هو كلنا","طوراً وطوراً نحن صبغته افهموا",23,"م",3,1],["هو صلَّى إليَّ لا أنا صلَّيْ","تُ إليه واذكر صلاةَ الخسوف",24,"ف",1,0],["هو صاحب لك إن رحلت مسافراً","عما سواه فما سواه أجانب",25,"ب",1,0],["هُو صبٌّ بها فلا غَرْو أَن ين","حَل إِنَّ النُّحولَ حَلْيُ الصَّبِّ",26,"ب",1,0]]}