,"الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86495","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83607","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83475","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117211","الكامل"],[4374,"","https://poetry.dctabudhabi.ae/diwan/poem/130562","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58018","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139787",""],[4773,"شمت برق الحمى وآنست ناراً","https://www.poetsgate.com/ViewPoem.aspx?id=169634",""],[4869,"ارجل طفل . مرثيه","https://www.poetsgate.com/ViewPoem.aspx?id=139688",""],[4929,"موقع سهيل في سراب الوعي","https://www.poetsgate.com/ViewPoem.aspx?id=215832",""],[4935,"راح الاماني وسط تلك الاكوس","https://www.poetsgate.com/ViewPoem.aspx?id=129529",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[4942,"ولد الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=188837",""],[4955,"وصفوه بدرا للدجى","https://www.poetsgate.com/ViewPoem.aspx?id=188773",""],[4984,"يوم المجاهد","https://www.poetsgate.com/ViewPoem.aspx?id=181624",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5012,"كف شالت شموع","https://www.poetsgate.com/ViewPoem.aspx?id=22795",""],[5061,"الديه","https://www.poetsgate.com/ViewPoem.aspx?id=147168",""],[585,"أقسمتُ أنكَ روضةٌ وجنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[3591,"يا من أمدّ له اليمين مودّعاً","https://www.poetsgate.com/ViewPoem.aspx?id=149489",""],[1696,"اللَه اللَه اللَه","https://www.poetsgate.com/ViewPoem.aspx?id=173328",""],[5273,"إلى مستبدة","https://www.poetsgate.com/ViewPoem.aspx?id=178286",""],[5290,"رعي الحقوق كما علمت حقيق","https://www.poetsgate.com/ViewPoem.aspx?id=113130",""],[5397,"طلعت بك العليا بنجم أسعد","https://www.poetsgate.com/ViewPoem.aspx?id=157935",""],[5457,"ما معنى الوطن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213236",""],[5461,"يا قديم الغوص","https://www.poetsgate.com/ViewPoem.aspx?id=5306",""],[5490,"وللحديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=176364",""],[5525,"ليل التجافي","https://www.poetsgate.com/ViewPoem.aspx?id=7193",""],[5674,"مأسور ويعشق آسره","https://www.poetsgate.com/ViewPoem.aspx?id=190017",""],[5736,"احتضار","https://www.poetsgate.com/ViewPoem.aspx?id=208862",""],[402,"إن يقض اسماعيل عاصم","https://www.poetsgate.com/ViewPoem.aspx?id=36194",""],[5794,"صمت المدينة ..","https://www.poetsgate.com/ViewPoem.aspx?id=122799",""],[5956,"من أجل نقوده تقتله","https://www.poetsgate.com/ViewPoem.aspx?id=182526",""],[5956,"هو صاحبي الأغلى الأبُ المسؤولُ","https://www.poetsgate.com/ViewPoem.aspx?id=194273",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[5956,"إلى سيادة صديقي الروحي","https://www.poetsgate.com/ViewPoem.aspx?id=194487",""],[5956,"رائد الأفضال في الأجيالِ","https://www.poetsgate.com/ViewPoem.aspx?id=205487",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""],[6093,"محمد سيد السادات","https://www.poetsgate.com/ViewPoem.aspx?id=193786",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[5190,"يا قارئ القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85083&r=&rc=158",""]],"verses":[["هُوَ صَارِمٌ لِلعَدْلِ يُخْشَى","جَانِبَيْهِ أُولُو المَظَالِمْ",0,"م",1,0],["هُوَ صَاحِبُ الصَّوْتِ الَّذِي","تَعْنُو لَهُ الأُسْدُ الضَّرَاغِمْ",0,"م",1,0],["هو صيد ولم يَعُد يجعل المُص","طادُ منه غير التجاريب بازه",1,"ز",2,0],["هُوَ صَوتُ الحَقِّ لَم يَبغِ وَلَم","يَحمِلِ الحِقدَ وَلَم يُخفِ الحَسَد",2,"د",1,0],["هُوَ صادِقُ الوَعدِ الَّذي لِوَفائِهِ","نَستَشهِدُ الآياتِ وَالتَنزيلا",3,"ل",2,0],["هُوَ صاحِبُ البَلَدِ الَّذي لِسَماحِهِ","بِالرِفقِ يَبلُغُ لا بِشَقِّ الأَنفُسِ",4,"س",1,0],["هو صِنْوُ الشّرِّ أو تَوأمُهُ","ما ثَوى في موطنٍ إلا مَعَهْ",5,"ع",2,0],["هُوَ صَخْرَةٌ ما زُوحِمَتْ صَدَمَتْ فلا","تَبْغُوا لها إلَّا النُّجُومَ وُعُولا",6,"ل",2,0],["هُوَ صِبغَةُ الفُرقانِ نَفحَةُ قُدسِهِ","وَالسينُ مِن سَوراتِهِ وَالراءُ",7,"ا",2,0],["هُوَ صورَةٌ رَاعَ القُلُوبَ جَمَالُهَا","وَسَعَتْ عَلَى صِغَرٍ جَلاَلَ الوَادِي",8,"ي",1,0],["هو صُورةٌ للبِشْرِ أُحْكِم رَسْمُها","لو أنَّ أَيَّامَ السُّرورِ تُصَوَّر",9,"ر",1,0],["هوَ صخرة ٌ ما زوحمتْ صدمتْ فلا","إلاَّ ونالَ بِجُودِهِ المَأْمُولا",10,"ل",2,0],["هو صوتُ ، الحقِّ ، لم يبغِ ، ولم","يحمل الحقدَ ، ولم يحفِ الحسدَ",11,"د",1,0],["هُو صَيقل الأَرواح في وَجناتِهِ","نزهُ العُيون وَكُل مَعنى لاهي",12,"ي",1,0],["هو صفوة ارحم وهو حبيبه","وله المقامات التي لا تدفع",13,"ع",1,0],["هُوَ صاحِبُ الحَوضِ الَّذي مِن جَنَّةِ ال","فردَوسِ يَشخبُ فيهِ ميزابانِ",14,"ن",1,0],["هُوَ صاحب الاحاكم وَالحكم الَّتي","طلعت طَلائعها هدى للمهتدى",15,"د",2,0],["هُوَ صفوة الباري وَخاتم رسله","وأمينه المَخصوص منه بفضله",16,"ه",1,0],["هو صادقُ العزماتِ قرّر مجدهُ","صدقاً بذا القانونِ عهد أمانِ",17,"ن",1,0],["هو صومٌ وافَى ووجْهُك عِيدٌ","هل رأيتُمُ صَوماً يُفارِقُ عِيدا",18,"د",2,0],["هو صفوةُ الله الَّذي نَعشَ الهدى","وحبيبُهُ بالنصِّ من خيرِ الورى",19,"ر",2,0],["هو صدرٌ للدين شرقاً وغرباً","وعلى بابه الأنيسِ الوُفودُ",20,"د",1,0],["هو صفا شربي برضاب خمار","ليا صفات المعنى يا باب",21,"ب",1,0],["هو صدرُ أسمرِه وقبضةُ قوسِه","وعِذارُ أبيضِه لدى الهَيجاءِ",22,"ا",2,0],["هو صبغة العدم الذي هو كلنا","طوراً وطوراً نحن صبغته افهموا",23,"م",3,1],["هو صلَّى إليَّ لا أنا صلَّيْ","تُ إليه واذكر صلاةَ الخسوف",24,"ف",1,0],["هو صاحب لك إن رحلت مسافراً","عما سواه فما سواه أجانب",25,"ب",1,0],["هُو صبٌّ بها فلا غَرْو أَن ين","حَل إِنَّ النُّحولَ حَلْيُ الصَّبِّ",26,"ب",1,0],["هو صاحبي دون الرجال وليس لي","خِلّ سواهُ يهمّه ما همّني",27,"ن",2,0],["هو صنوه وقسيمه","في كل مكرمةٍ وخير",28,"ر",1,0],["هو صاحب الفرقان احمدنا","وختم الانبياء وبحر علم طاف",29,"ف",1,0],["هو صبح ليلتها وبدر ظلامها","ولسان حكمتها وقلب الفيلق",30,"ق",1,0],["هو صبحُ الأيام سعد الليالي","بهجة الدهر نور عين الزمان",31,"ن",1,0],["هو صارعُ الأعداء نا","عش كلِّ ذي نفسٍ صريعه",32,"ع",2,0],["هو صخرٌ قد حطَّه السعيُ من","صَرْحِ النُّهى فاْنحنتْ له الخنساء",33,"ا",2,0],["هو صورةٌ لحياتنا","يبدو سَناها للنواظرْ",34,"ر",1,0],["هُوَ صَحوُ الضَميرِ مِن غَفلَةِ الإِث","مِ عَلى مَصرَعِ الخِلالِ النَبيلَه",35,"ل",2,0],["هو صعب المنال سهلُ السّجايا","قد كساه الإلهُ تاجَ المهابَه",36,"ب",2,0],["هوَ صَفوَةُ الرَّحمن أكرَمُ مُصطفىً","طابَ النِّجارُ بِه وَتَمَّ سَما الفَخَر",37,"ر",1,0],["هو صفوةُ الأخيار والأطهار من","قومٍ لهم في الدين حسنُ مواقفِ",38,"ف",1,0],["هو صاحبٌ لك في السرى وخليفةٌ","في الأهل بعدك فانتبه يا نائم",39,"م",1,0],["هو صرف القضاء يجري فمن ذا","لليال يستطيع صرف قضاها",40,"ا",3,0],["هو صبٌّ يشف ستر هواه","عن اسى مهجةٍ يهز الجبالا",41,"ل",2,0],["هو صامت لكنه في صمته","أقوى وأبلغ منه في إعرابه",42,"ب",2,0],["هو صبح مجسم وجهها أم","من ليالٍ شعورها يتجمد",43,"د",1,0],["هو صاحب الكرات في دول خلت","وأمين خالقه على الأدوار",44,"ر",1,0],["هُوَ صِنوي الرطيبُ لكنَّ شَتَّا","نَ وبَونٌ ما بينَ ذاوٍ ونامِ",45,"م",1,0],["هُوَ صُورة للمجد حلّت لا خَفا","أَعلا هُيولاه فَلم تتكيّف",46,"ف",1,0],["هو صاحبي هو بهجتي","وكفايتي عن كل صاح",47,"ح",1,0],["هو صاحب ما كان يوماً معرضاً","عن إلفه أو باخلاً بخطاب",48,"ب",1,0],["هو صدغ مستحيٍ علا عرقٌ به","فأمرَّ أكماماً منشفةَ العرَق",49,"ق",1,0],["هو صبغة اللَه الذي اكتحلت به","عين السواد من العراق فأبصرا",50,"ر",2,0],["هو صبغة اللَه التي حيّا بها","زحل الزمان فصار بدرا نيّرا",50,"ر",2,0],["هُوَ صُنعُ هِيفستٍ وَفيهِ حَبا","زَفسَ العَظِيمَ بِغَابِرِ القِدَمِ",51,"م",1,0],["هُوَ صَرحٌ شِيدَ بالنَّحتِ الجَمِيل","فَوقَ أَبوَابِ رِوَاقٍ مُستَطِيل",52,"ل",1,0],["هو صل والصل يلسع لكن","راق عند الرقى وراق لسيعا",53,"ع",2,0],["هو صبحُ الهدى جَلا كلّ لَيلٍ","فيهِ تِهنا وَلِلصَّباحِ عمودُ",54,"د",1,0],["هو صفوةُ الخَلّاقِ جلَّ جَلاله","وَعَلى الخَلائِق لا يَزالُ مقدَّما",55,"م",2,0],["هو صاحب المختار في أزماته","ثانيه يوم ثوى فحل الغارا",56,"ر",2,0],["هو صحن به المصابيح أمست","نيرات تزري بشهب الظلام",57,"م",1,0],["هُوَ صَوتُ السَماءِ في عالَمِ الأَر","ضِ وَرُوحٌ مِن اللَطيفِ الخَبيرِ",58,"ر",1,0],["هو صفوة الرَّحمنِ بل هو حُجَّةٌ","لله وهو 