{"poems":[[55,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[55,"ما لي أودع كل يوم ظاعنا","https://www.aldiwan.net/poem30777.html","الكامل"],[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[29,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[74,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[14,"إذا آذاك مالك فامتهنه","https://www.aldiwan.net/poem38312.html","الطويل"],[91,"ورد يطيح وبلبل اسوان","https://www.aldiwan.net/poem44907.html","الكامل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[30,"أرى كاهلي سعد أتى منكباهما","https://www.aldiwan.net/poem5616.html","الطويل"],[99,"قست الحياة على الطري","https://www.aldiwan.net/poem24856.html","مجزوء الكامل"],[82,"خطاب عن لقائكم يعوق","https://www.aldiwan.net/poem31361.html","الوافر"],[82,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[82,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[46,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[71,"فرغت منه حامدا","https://www.aldiwan.net/poem28713.html","مجزوء الرجز"],[76,"ورداء ليل بات فيه معانقي","https://www.aldiwan.net/poem12817.html","الكامل"],[21,"كثمود التي تفتكت الدين","https://www.aldiwan.net/poem36208.html","الخفيف"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[77,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[52,"أخي أنت النصيح فلا تلمني","https://www.aldiwan.net/poem64798.html","الوافر"],[52,"نور عيني أصبت عيني بسكب","https://www.aldiwan.net/poem64824.html","الخفيف"],[52,"يا صاح دعني فإنني نصب","https://www.aldiwan.net/poem64857.html","المنسرح"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[79,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[30,"أرى كاهلي سعد أتى منكباهما","https://www.poetsgate.com/ViewPoem.aspx?id=20965",""],[147,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[255,"يا لقومي أنا من فق","https://www.aldiwan.net/poem15012.html","مجزوء الرمل"],[280,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[353,"فرغ الشعر والشعير فلاحا","https://www.aldiwan.net/poem20408.html","الخفيف"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[409,"أشغلت بالورقا عن الأوراق","https://www.aldiwan.net/poem33625.html","الكامل"],[412,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[487,"أشكو له منه مهجتي","https://www.aldiwan.net/poem24282.html","عموديه"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[563,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64027","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64029","الخفيف"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64946","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64968","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64661","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64600","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79841","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69374","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69417","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102662","الرجز"],[2626,"","https://poetry.dctabudhabi.ae/diwan/poem/200099","الخفيف"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61261","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92248","المديد"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216736","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216388","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216807","الطويل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114666","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111391","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28736","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83140","الخفيف"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116100",""],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147309","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147280","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72622","البسيط"],[4729,"يا كَاتبا يَنثُر من فَضله اللؤلؤَ","https://www.poetsgate.com/ViewPoem.aspx?id=109450",""],[3464,"شموس سعوده هلت تبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158759",""],[5143,"أشدُّ قبالَ نَعْلي أنْ يراني","https://www.poetsgate.com/ViewPoem.aspx?id=186632",""],[5147,"أيقل أرحلك الصعيد الهامد","https://www.poetsgate.com/ViewPoem.aspx?id=166697",""],[5376,"أهيم وداريا بدمعٍ أرومها","https://www.poetsgate.com/ViewPoem.aspx?id=188409",""],[5461,"نادميني","https://www.poetsgate.com/ViewPoem.aspx?id=1312",""],[6033,"نفرتُ إلى ربّي","https://www.poetsgate.com/ViewPoem.aspx?id=215800",""],[6075,"على بوابة الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190650",""],[5957,"أأحببت غيري!؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82406&r=&rc=41",""]],"verses":[["فَرَغَت أَكُفٌّ مِن نَوالِكَ بَعدَها","وَأَطالَ عُظمُ مُصابِكَ الأَشغالا",0,"ل",2,0],["فَرَغَت يَدي مِنهُ وَقَد رَجَعَت بِهِ","أَيدي النَوائِبِ وَالخُطوبِ مِلاءَ",1,"ا",2,0],["فَرَغَ الإِلاهُ مِنَ الحَظُوظِ فَعَدَّ عَنْ","حَظِّ تَكِدُّ لَهُ فَحَظُّكَ يَطْلُبُ",2,"ب",1,0],["فَرَغنَ أَبا عَمرٍو بِما بَينَ أَهلِنا","وَبَينَكَ مِن أَطراقِهِنَّ وَمِن شَهرِ",3,"ر",1,0],["فَرَغتُ مِنَ القُيونِ وَعَضَّ تَيماً","فِرِندُ الوَقعِ لَيسَ بِذي فُلولِ",4,"ل",1,0],["فرّغ بعطفك ذهنِي للثناء فقد","سارَت بمثلي فيه غرّ أمثالي",5,"ل",2,0],["فَرَغمُ العَيشِ إِلفُ فِناءِ قَومٍ","وَإِن آسوكَ وَالمَوتُ الرَواحُ",6,"ح",1,0],["فرغت عيوني من دموعي في البكى","اما الفؤاد فبالأسى ملآن",7,"ن",1,0],["فَرَغَت مِنهُ النَوى غَيرَ رَمَق","فَضلَةَ الجُرحِ إِذا الجُرحُ نَغَر",8,"ر",1,0],["فَرَغمَن وَدَغماً لِلعَدُوِّ فَإِنَّهُ","سَتَنبو مَرامي عَنهُما مَن رَماهُما",9,"م",2,0],["فرغ الحديث ومن رواه","طُوِي الكتاب فمن طواه",10,"ا",2,0],["فرَغتُ منَ الشبابِ فَلَستُ أَرنو","إلى لهوٍ فيشغلني الرّحيقُ",11,"ق",1,0],["فَرِّغْ مِنَ السّيْرِ الرَذِيّةَ عِندَهُ","تملأ يديكَ بطارفٍ وَتلادِ",12,"د",1,0],["فرغت لصنعك ما لا يقيك","كأنّك عاملة ناصبه",13,"ب",2,0],["فَرَغَ الوِشاحُ بِها وَقَد مَلَأَت","مِنها الشَوى الخَلخالَ وَالقُلبا",14,"ب",2,0],["فَرَغنَ لِلسِحرِ حَتّى ظَلَّ كُلُّ شَجٍ","حَرّانَ في بَعضِهِ عَن بَعضِهِ شُغُلُ",15,"ل",1,0],["فرغْتُ منهُ حامداً","مصلياً مسلما",16,"م",2,1],["فَرَغِبتُ عَن نورِ الصَباحِ لِنَورَةٍ","أُغرى لَها بِبَنفسَجِ الظَلماءِ",17,"ا",2,0],["فَرَغا رَغوَةً فَكانَت عَلَيهِم","رَغوَةُ السَقبِ دُمِّروا تَدميرا",18,"ر",2,0],["فَرَغَ الإلهُ له بكُلِّ فضيلَةٍ","أيّامَ آياتُ الكِتابِ تُفَصَّل",19,"ل",1,0],["فرَغتَ للحج من شُغل الهِياجِ فلوْ","سألتَ مكّة قالتْ هيْتَ فارتحِل",20,"ل",1,0],["فرغت من المجد الذي أنت شائد","فجرَّ ذيول العيش في الزمن النضر",21,"ر",1,0],["فَرُغتُ وَأَنتَ مِن هَمّي وَبالي","وَما كُلُّ الرَواغِ لَهُ عِقابُ",22,"ب",1,0],["فَرَغَ الناسُ مِن مُعالَجَةِ النا","سِ جَميعاً وَأَنتِ هَمّي وَرَبّي",23,"ب",2,0],["فَرَّغتُ قَلبي لَها لِتَسكُنَهُ","حيناً فَأَمسى فيهِ لَها شُعَبُ",24,"ب",1,0],["فرغت من أحلامه وانطوى","بِمُرِّهِ وارتحتُ من عذبه",25,"ه",1,0],["فرغتْ منه النوى غير رمق","فضله الجرح إذا الجرح نعَرْ",26,"ر",1,0],["فرغت لها من كل هم وإن نأت","وخلفت نفسي لا تريم ببابها",27,"ب",3,0],["فَرَغَ الإلاهُ عن الحُظوظِ فَعَدِّ عن","حظٍ تَكِدُّ له فحظُّك يطلبُ",28,"ب",1,0],["فَرَغْماً وَدَغْماً، للعَدُوّ فَإنّهُ","سَتَنْبُو مَرَامي عنهُما، مَنْ رَماهُمَا",29,"م",2,0],["فَرَغوا لِلَهوِهِمُ بِشُغلِكَ عَنهُمُ","فَاِجعَل لَهُم بِنُفوسِهِم أَشغالا",30,"ل",2,0],["فَرَغَت دُكانُهُ لو","أَنَّهَا دارُ الوِكالَه",31,"ل",2,0],["فَرَغتَ لكلِّ جَبَّار عَنِيد","فَمِنْ هَدرٍ نَجِيعُهُم وفَرْغِ",32,"غ",1,0],["فَرَغَ الشِّعْرُ والشَّعِيرُ فَلاحَا","لي بِرَغْمِي ولا حِماريُّ ماشِي",33,"ي",1,1],["فَرغْتَ للدّينِ والدُّنيا تَسوسُهما","وأنت ملآنُ من عُرْفٍ وعِرفان",34,"ن",1,0],["فرغت سمعك لاستماع مطوَّق","يشدو فيبعث لاعِجَ الأشواق",35,"ق",1,0],["فَرَّغتَ نَفسَكَ للأَحرار تَغرِسُهم","وَهَمُّ غَيرِكَ غرس النَخلِ وَالشَجرِ",36,"ر",1,0],["فرغت كوني مني مخلصا","لعلي بها أخلو وتجلو النقابا",37,"ب",2,0],["فرّغْتَ فيه القلبَ عن شُغلِ الهَوى","وعصَيْتَ ما يُلهيكَ عن طاعاتِهِ",38,"ت",2,0],["فرِّغِ القلبَ له من غيره","واجتليه بركوع وسجود",39,"د",1,0],["فرغتُ للهو فيه يُسعِدني","عليه مستهترون فُرّاغ",40,"غ",1,0],["فرَّغ الشوقُ من سوى الشوق قلباً","كان بَدْءَ اشتغالِهِ تفريغُه",41,"غ",2,0],["فَرغاء ينقي الشنار مربدها","يَهُزّها بالسنان شاجرها",42,"ر",3,0],["فَرَّغْتُ يا بْنَ مُعزِّ الدِّينِ جَهْدَكَ في","جَدْواكَ فامْتَلأَتْ مِنْها الأَقاليمُ",43,"م",1,0],["فرغَّبْتَ في الإِنعامِ كلَّ مُبَخَّلٍ","وزَهَّدْتَ في الإِحجامِ كلِّ جَبانِ",44,"ن",1,0],["فَرَّغَ الجُودُ وَفْرَهُ الْجَمَّ لكِنْ","مَلأَ الأَرْضَ شُكرُهُ والثَّناءُ",45,"ا",2,0],["فرغت لها من كل همّ وإن نأَت","وخلفتُ نفي لا تريم ببابها",46,"ب",3,0],["فرّغ الكفَّ فلا أدرى لِمن","في جفير الغدر تستبقي النبالا",47,"ل",2,0],["فرِّغ القلبَ من جوى الثكل يا مَن","هو في الفضلِ ملءُ عين الزمان",48,"ن",1,0],["فرغت من سهر الليل وأومت","بعيون آذنتنا أن تناما",49,"م",2,0],["فَرَغِبتُ أن أبقى لأُطرِبَ مِسمعي","وكأَن سَرى بالزائرين مَرَامي",50,"ي",1,0],["فَرَّغَت كَفُّهُ الكُنوزَ وَأَفنى","بِعَطا الطارِقِينَ بُزلَ سَوامِه",51,"م",2,0],["فَرَّغتَ مالَكَ في الجَميلِ وَلَم تَدَع","في اليَومِ ما يُعطى وَيُوهَبُ في الغَدِ",52,"د",1,0],["فرغ لمولاك القدير قلبك","إذا اتثقت به فسوف يعطيك",53,"ك",1,0],["فرغ القلب عن مسائل نحو","واشتغل بالحساب والفارسيه",54,"ه",1,1],["فرغَ القَضاءُ وَلا مردَّ لِحُكمِهِ","مِن أَنَّ جَدَّ معانديك الأَسفَلُ",55,"ل",1,0],["فرَّغت قَوسَ اجتِهادي في مدائح مَن","جلَّت مناقبُهم إِجلالَ قَدرِهِمِ",56,"م",1,0],["فرِّغِ الأفكارَ عن شغلها","قد كَفى بالغير ما أشغلكْ",57,"ك",1,1],["فرغت من الحياة فأنت ترجو","حياة في الفراديس الفساح",58,"ح",1,0],["فرغت من الحب الذي يعقب الشكوى","فحبي من النعمى وليس من البلوى",59,"و",2,1],["فرغنا لشغل في المعيشة فارغ","وبُؤنا إلى كدح نتيجته عقمُ",60,"م",1,1],["فرغت ولم تكن فرغت فرامت","ادامة نيكها حتى الفراغ",61,"غ",1,0],["فرغت حواصلها وأنسل ريشها","ثم اعتراها بعد ذاك همود",62,"د",1,0],["فرغت من المثالث والمثاني","بقلب فيه للكرم اشتغال",63,"ل",1,0],["فَرَغَ الشَّيخُ فَاستَجَابَ أَفُلُّو","نُ بأَعلَى الأُولِمبِ وَانقَبضَّ حَالا",64,"ل",2,1],["فَرَغَت مِن كُل شَيءٍ وَخَلَت","كُلّها إِلا مِنَ الحُزنِ الدَؤوبِ",65,"ب",1,0],["فَرغَ الكنزَ من ذخائرَ مالٍ","مالئاً من نفائسِ الحمدِ كنزَهْ",66,"ه",1,0],["فَرَغتِ لي في إِسارِ قَلبي","ثُمَّ تَشاغَلتِ عِندَ فَكّي",67,"ك",2,0],["فَرغَ القَلبُ مِن عَسى وَلَعَلَّ","فَسَلامٌ عَلى غَرامٍ تَوَلّى",68,"ل",2,1],["فرغبت في الترحال وهي بخاطري","مطبوعة منظومة أشكالها",69,"ل",3,0],["فرغد العيش تخفره المنايا","ونور الحب يطفئ بالمماتِ",70,"ت",1,0],["فرغد العيش يُنسي كل همٍ","ودفء الحب مورده مقيم",71,"م",1,0],["فرغبوني بها عروسا","بالشمس يزري لها بروز",72,"ز",1,0],["فُرغَتَ عن حقي وأهملتَ ما","أطلبُه منكَ من السُّكَّرِ",73,"