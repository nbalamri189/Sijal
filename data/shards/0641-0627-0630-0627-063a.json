34",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6120,"سُلْطَانَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=213477",""],[433,"شاء الهوى أم شئتِ أنتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87054&r=&rc=7",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""]],"verses":[["فَإِذا غَضِبتَ فَأَنتَ أَنتَ شُجاعَةٌ","توفي عَلى عَضبِ الرَدى وَهُمُ هُمُ",0,"م",1,0],["فإذا غَزا فمَنَ الدِّماءِ مُدامُهُ","ومنَ الصّهيلِ إذا انْتَشى مِزْمارُهُ",1,"ر",2,0],["فَإِذا غَشيتُ لَها بِبُرقَةِ واسِطٍ","فَلِوى لُبَينَةَ مَنزِلاً أَبكاني",2,"ن",2,0],["فإذا غنَّتْ بدا في جِيدها","كلُّ عرقٍ مثلَ بيت الأَرَضَهْ",3,"ض",2,0],["فإذا غدا بصرٌ يباهرُ نورَها","رَجَعته مطروفَ الشعاع كليلا",4,"ل",2,0],["فَإِذا غِبتَ تَلَفَّ","تُّ يَميناً وَشِمالا",5,"ل",2,0],["فإذا غارَتِ الكواكبُ صبحاً","فهُوَ الكوكبُ الذي لا يَغورُ",6,"ر",1,0],["فَإِذا غوزِلوا فَآرامُ سِربٍ","وَإِذا نوزِلوا فَأُسدُ عِراكِ",7,"ك",1,0],["فإذا غفا فلطيفها وإذا هفا","فلوجهها المستعذبِ الوضّاءِ",8,"ا",2,0],["فإذا غفوتُ فإِنني أُمسي بها","وعلى مغانيها الفواتن أُصبح",9,"ح",1,0],["فإذا غَوَيْتَ فكلُّ شيءٍ ضائرٌ","وإذا اهتديتَ فكلُّ شيءٍ نافعُ",10,"ع",1,0],["فإذا غَضِبْتَ علَتْهُ دونك رُبْدَةٌ","يَغدُو لها طَرْفُ النهارِ كَليلا",11,"ل",2,0],["فَإِذا غُمَّ تَنَفَّس","تُ فَأَوهَينَ جُنوبي",12,"ب",2,0],["فَإِذا غَنيتُ فَإِنَّ جارِيَ نَيلُهُ","مِن نائِلي وَمَيَسَّري مَعهودُ",13,"د",1,0],["فإذا غضبت، ففي الخليج ومائهِ","سَعَةٌ، فَقُمْ؛ واشربْهُ: كُوبًا، كوبا",14,"ب",2,0],["فَإِذا غَفَلْتُ عَنِ الْكَفُور فإِنَّما","أُهْدِي إِلَيْهِ الْحَتْفَ مِنْ غَفَلاتي",15,"ت",2,0],["فإذا غشّ نفسهُ","غيرها كيف ينصف",16,"ف",1,0],["فَإِذا غَنَّيتُ شَعَّت في غِنايا","جُنَّتِ الدُنيا كَما نَهوى فَجُنّي",17,"ي",1,0],["فإذا غربت أفضنا لجمع","وإلى المشعر المنيف الحرام",18,"م",1,0],["فإذا غَيَّر حالاتِ الورَى","كان كالدَّهرِ مُقيمَ الحالتَين",19,"ن",1,0],["فإذا غالت به طاوعها","وإذا مالت إلى الخفض عَصاها",20,"ا",3,0],["فإذا غدا صفرَ اليدينِ فإنَّهُ","مَلآنُ من شرفِ العُلى والمَفخر",21,"ر",1,0],["فإذا غَزا وقَرى فمنْ أنْصارِه","يهديه عنه مُهَنَّدٌ أو لَهْذَمُ",22,"م",1,0],["فاِذا غنَّتْ على أغصانِها","هُتَّفُ الوُرْقِ غدا دمعي المُداما",23,"م",2,0],["فإذَا غَزَالٌ عَاقِدٌ","كالظّبيِ فشَّغهُ المَنَامُ",24,"م",1,0],["فإذا غضبةٌ من الحق مُثلى","وإذا وثبة إلى السيف كبرى",25,"ر",2,0],["فإذا غنيت لي","ينجلي عني الكدر",26,"ر",1,0],["فإذا غَدَونَ من الرمالِ علَيهِمُ","فغَدونَ جَزرَ خوامعٍ وذِئابِ",27,"ب",1,0],["فإذا غضبت فأنت ليث مبسل","وإذا رضيت فأنت غيث مسبل",28,"ل",1,0],["فإذا غنيتُ فكلّهم لي خاتِلٌ","وإذا افتقرتُ فكلّهم لي جافي",29,"ي",1,1],["فإذا غزا وهب الظُّبا","هندية والخيل جردا",30,"د",2,0],["فإذَا غَدَا التفصِيلُ لَفظِيًّا وَمَع","زُولاً عَنِ الإِيقَانِ والرُّجحَانِ",31,"ن",1,0],["فَإِذَا غُلِبتَ علَى المَجَازِ فَقُل لَهُم","لاَ يُستَفاَدُ حَقِيقَةُ الإيقَانِ",31,"ن",1,0],["فإذا غدوت له تريد نجازه","بالوعد راغ كما يروغ الثعلب",32,"ب",1,0],["فإذا غابت فقلبي غائب","لست أدري كيف قلبي عقني",33,"ن",2,0],["فَإِذا غضبت فأيّ قلبٍ لَم يطر","رعباً وَأَيّ فَريصة لَم ترعدِ",34,"د",1,0],["فإذا غشيْتَهمُ سمعتَ هوادراً","وصَواهلاً ورأيتَ أحسنَ حالِ",35,"ل",1,0],["فإذا غدوت غدوت ظاهر غبطة","أو رحتُ كان مع السرور رواحيا",36,"ي",2,0],["فاذا غدائرها ومعطفها","سيان لون العطف والشعر",37,"ر",1,0],["فَإِذا غالَكَ الفَناءُ بِسَهمِ","كَيفَ أَرضى الفِردَوسَ داراً بَعدَك",38,"ك",1,0],["فإذا غضبت تلفت بعد حياتنا","وإذا رضيت حييت بعد وفاتي",39,"ت",2,0],["فإذا غضبت من الهوى","من لي سواك سيغفرُ",40,"ر",1,0],["فإذا غُرمي على التَّرحةِ بي","مستطيرٌ بالخوافي والقُدامي",41,"م",2,0],["فِإِذَاْ غَرَاْمُكَº قِصَّةٌ عَبَثِيَّةٌ","حُبِكَتْ، فَثَاْرَتْ فِي الْفُؤَاْدِ بَلاْبِلُ",42,"ل",1,0],["فإِذا غَفَوتُ دقيقةً عن حبِّها","أنتَ الذي عمّا مضى عوّضْتَها",43,"ت",3,0],["فإذا غفوتُ قُبيلَ عَوْدكِ فاعلمي","أنّي لِفَرطِ الشَّوقِ مُتُّ حزينا",44,"ن",2,0],["فإذا غزاهُ الصَدُّ أورثه الضنا","فغدا عليلاً صاغراً متألّما",45,"م",2,0],["فإذا غالب الرحيلُ رُؤاها","حاصرتها ذرى الدموع البواقي",46,"ق",2,0],["فإذا غفا سقطت نجوميَ حوله","حراس مهد منامه لاتنكصُ",47,"ص",1,0],["فإذا غابتْ عن عيوني ثوانٍ","يَذْبَحُ الشِّريانَ الحزينَ أُوارُ",48,"ر",1,0],["فاذا غضبنا لانبالي , حينها","يَرِِدُ الردى الأصقاعَ كيف نشاء",49,"ا",2,0],["فإذا غبتَ حياتي تنتهي","واذا متُ أنا أنت السبب",50,"ب",1,0],["فاذا غفى حرمُ التواْصلُ بينناْ","تلقين جثْمان الهوىْ بترابيْ",51,"ب",2,0],["فإذا غَليلُ الحُزْنِ أَعْطَشَ مُهْجةً","فعَلَى دُمُوعِ العَينِ رَيُّ ظِمائِها",52,"ا",3,0],["فَإِذَا غَدَتْ تَخْتَالُ بَيْنَ مَمَرَّهَا","نَفَحَتْهُ مِن أَطْرَافِهَاْ رَيْحَاْنَهْ",53,"ن",2,0],["فاذا غفوت لكي أراك","فربما في الحلم جئتِ",54,"ت",1,0],["فإذا غفوتُ على هديل حمامها","فاضت رؤاي وضمني التسبيحُ",55,"ح",1,0]]}