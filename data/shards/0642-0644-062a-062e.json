{"poems":[[58,"وقنان زواهر هن بالشم","https://www.aldiwan.net/poem58540.html","الخفيف"],[71,"قالوا تنقل لتنال العلى","https://www.aldiwan.net/poem28471.html","السريع"],[50,"انس رسم الديار ثم الطلولا","https://www.aldiwan.net/poem64509.html","الخفيف"],[52,"ذهب الدهر بسمط وبرا","https://www.aldiwan.net/poem64874.html","البسيط"],[228,"أيكون الهوى ندى وملابا","https://www.aldiwan.net/poem39721.html","الخفيف"],[347,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[543,"قد قصدت الطبيب يوما لفحصي","https://www.aldiwan.net/poem47980.html","عموديه"],[543,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[563,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38657","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204661","الخفيف"],[3154,"","https://poetry.dctabudhabi.ae/diwan/poem/138930",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136638",""],[4691,"يا خلتي الراحمة القاتلة","https://www.poetsgate.com/ViewPoem.aspx?id=211572",""],[4797,"حالك وش بلاه","https://www.poetsgate.com/ViewPoem.aspx?id=132237",""],[5057,"أُشبهُ النار .","https://www.poetsgate.com/ViewPoem.aspx?id=184020",""],[5145,"من رأى البرق تعالى وسنا","https://www.poetsgate.com/ViewPoem.aspx?id=108060",""],[5183,"قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186482",""],[5357,"المعاند","https://www.poetsgate.com/ViewPoem.aspx?id=16498",""],[5455,"كذبه كبيره","https://www.poetsgate.com/ViewPoem.aspx?id=34433",""],[5463,"يا زماني .. ما طلبت الا سلامه","https://www.poetsgate.com/ViewPoem.aspx?id=25227",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5749,"الدوا والطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=29663",""],[5790,"قد رأيناك والغزالة تسنح","https://www.poetsgate.com/ViewPoem.aspx?id=111949",""]],"verses":[["قُلْتُ خُذْها وعاطِنِيها سلافاً","ذَهَباً في الزّجَاجِ يُسْبَكُ سَبْكا",0,"ك",2,0],["قلتُ خمولٌ فيهِ لي راحتي","وأينما سافرتُ حظي معي",1,"ي",1,0],["قُلتُ خُذها لِكَي يَزولَ التَشَكّي","فَبِها يُصبِحُ الخُمارُ قَتيلا",2,"ل",2,0],["قُلتُ خِنزيرٌ وَكَلبٌ حارِسٌ","ذاكَ كَالناسِ وَهَذا ذو نِدا",3,"ا",1,0],["قُلتِ خُذها نَقِيَّةَ العِرقِ مِن حُ","بّي شفاهاً وَمن حَناني رُضابا",4,"ب",2,0],["قلت خمس قال ست","خلّ عنك الافتئات",5,"ت",1,0],["قلت خَلِّ العَليلَ فهو كَثيرُ","ولَتعَدَ الصَّحيحَ وهو قَليلُ",6,"ل",1,0],["قُلتُ خَلُّوا النُّجومَ عنكُمُ عَدّاً","ولتَجيئُوا له بِفَردٍ مِثالِ",7,"ل",1,0],["قلت خذ روحي فقال الروح لي","خل دعواها وهات الجسدا",8,"د",2,0],["قُلتُ خافَت عَلى مُحيّاه مِنها","فَوَقَتْهُ العُيون بِالأَهدابِ",9,"ب",1,0],["قلت خفّض عليك من عظم الأم","ر ونهنه من لوعة البرحاء",10,"ا",2,0],["قلت خلوا عنكم أسامي أشخا","ص فهذي عبادة الأوثان",11,"ن",1,0],["قلت خذها على جناحيك أنفا","سي وحافظ على لطيف شذاها",12,"ا",3,0],["قلتُ خفض عَليك فالله فيما","أنا مخفيه من هَواك عليم",13,"م",1,0],["قلتُ خذيني مثل أخذي لها","وقلت تلك قسمة عادلة",14,"ل",2,0],["قلت خله ينبري للي براه","ان بغى يفنيه ماني معترض",15,"ض",1,0],["قلتُ خافي من الحِسابِ فقالت","ليسَ في الحُبِّ مُنكرٌ ونكيرُ .",16,"ر",1,0],["قلت خلّيني وخلّي عذلي","ما أنا أنت ولا أنت أنا",17,"ن",2,0],["قلت خلي طرفي يراك فواقا","قالت اِيْئَسْ فمنك عنك ستار",18,"ر",1,0],["قلت : خل المعاند ما سمعت الكلام ... ذوق نار المعاند ذوقها يا عنيد","قلت لك : ف المحبه صار لي كم عام ... وانت توّك على دنيا المحبه جديد",19,"د",1,1],["قلت : \"خيره\".. ولكن وينها ووين خيره؟!","لا عيوني تكفّ.. ولا يديني تنول",20,"ل",1,0],["قلت : \" خلّي \" يوم علّقني بغرامه","\" شحّ \" في حبّه وهدّم بي كياني",21,"ن",2,0],["قلت خطا كانك تمشيت برضاي","واخطيت كانك ما مشيت بهوايه",22,"ا",3,1],["قلت خلاص يا روحي روحي افدرب هواه ودوبي","ويا قلب ولا يهمك مادام فيك الدوا والطبيب",23,"ب",1,0],["قلت خدي المعصفر أوفى شهود","قال هذا بالدمع منك مجرح",24,"ح",1,0]]}