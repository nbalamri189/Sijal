ps://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[77,"قد زُرْتُ قبْركَ عن طَوْع بأغْماتِ","https://www.poetsgate.com/ViewPoem.aspx?id=33386",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"هَواهَا عَلَى أَنَّ الصُّدُودَ سَبِيلُهَا","https://www.poetsgate.com/ViewPoem.aspx?id=32102",""],[47,"وَقَفَتْني عَلى الأَسَى وَالنّحِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=14737",""],[78,"أَنا في عَذابٍ مِن فراقِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86517&r=&rc=62",""]],"verses":[["أَنا في الضُحى سَرجُ الحِصانِ وَفي الدُجى","كورٌ عَلى ظَهرِ الأَمونِ الجَلعَدِ",0,"د",1,0],["أَنافِعَةٌ لي زورةٌ مِن خيالِها","أَجَلْ كُلُّ شيءٍ من أُمَيمَةَ نافِعُ",1,"ع",1,0],["أَنا في عَسكَرٍ لِخَيرِ إِمامٍ","زانَهُ رَبُّهُ بِخَيرِ وَزيرِ",2,"ر",1,0],["أَنافَ بِضَبعَيهِ إِلى فَرعِ هاشِمٍ","نَجيبٌ نَماهُ ماجِدٌ لِنَجيبِ",3,"ب",1,0],["أنا في حِماهُ وأنتَ أبْصَرُ بالذي","يُرْضيهِ منْكَ فوَزْنُ عَقْلِك أرْجَحُ",4,"ح",1,0],["أنافَ قَبْرُكَ في هَضْبٍ يَميزُهُ","فتَنْتَمِيهِ حَفِيّاتُ التّحِيّاتِ",5,"ت",1,0],["أَنا في هَمٍّ وَيَأسٍ وَأَسىً","حاضِرُ اللَوعَةِ مَوصولُ الأَنين",6,"ن",1,0],["أَنا في الجيزَةِ ثاوٍ","لَيسَ لي فيها أَنيسُ",7,"س",1,1],["إِنَّ افْتِتَاحِكَ وَحْدَةً صِحَّيَّةً","فَتْحٌ سَيَغْدُو فِي البِلادِ حَمِيمَا",8,"م",2,0],["أَنَا فِي الرَّوْضِ سَاهِرٌ وَهْوَ نَائمْ","بَاتَ فِي قُرَّةِ الدُّجَى وَهْوَ نَاعِمْ",9,"م",1,1],["أناف على أعلى السحاب معارضاً","بجُودك للعافين جَوْد البوارق",10,"ق",1,0],["إنا فقدنا الظرف والأدبا","وفقدت يا سعدون خير أب",11,"ب",1,0],["أُنافِسُ فيكَ بِعِلقٍ ثَمينِ","وَيَغلِبُني فيكَ ظَنُّ الظَنينِ",12,"ن",1,1],["إِنّا فُجِعنا بِفَتى وائِلٍ","لَمّا فُجِعنا بِأَبي وائِلِ",13,"ل",1,0],["أَنا في حالَتَي وِصالي وَهَجري","مِن أَذى الحُبِّ في عَذابٍ مُذيبِ",14,"ب",1,0],["أنا فرعٌ من النباتِ إذا ما","هجرَتهُ السقاةُ خافَ مماته",15,"ت",2,0],["أنا في حبها كُثير عشقٍ","وقليلٌ لنعلها خدّ عزّه",16,"ز",2,0],["أنا في المديح أشبب الوصف الذي","أهدى وأنتَ على الجريح تذفف",17,"ف",1,0],["أنا في خيرٍ وميرٍ بحمى","صاحب سلك قصدي مسلكه",18,"ه",1,1],["أنا في نعماك لكن مهجتي","مثلهم في حال بعدٍ في جحيم",19,"م",1,0],["إن أفقرتنيَ من صبرِي المهى فندا","قاضي القضاة عن السادات أغناني",20,"ي",1,0],["أنا في الحبِّ مثل قاضي قضاة الد","ين في الجودِ ليسَ يسمع عذلا",21,"ل",2,0],["أنا في غبطة بها وسرورٍ","ملءَ صدري وأنت في بُرَحاءِ",22,"ا",2,0],["أنا في الأرض محنةٌ فاتِخذْني","محنةَ الأشقياء والسُّعداءِ",23,"ا",2,0],["أنا في خِطَّتي وأهلي ومالي","وكأني أمسيتُ فرداً غريبَا",24,"ب",2,0],["أنا في غُمةٍ من الأمرِ غَمَّا","ءَ أُطيلُ التصعيدَ والتصويبا",24,"ب",2,0],["أنا فَرْدُ الهوى كما أنت فرد ال","حسنِ مُستكبِرٌ عن الأندادِ",25,"د",1,0],["أنا في حالة رجائيَ فيها","من سوى الله أو سواك غُرورُ",26,"ر",1,0],["أنا فيلُ ربي لم أزل","لهْواً لإخواني وسُخرا",27,"ر",2,0],["أنا في نعمة بصدك عني","أكَّد الله نعمتي بالسبوغ",28,"غ",1,0],["أَنا في نيويوركَ بِالجِسمِ وَبِال","روحِ في الشَرقِ عَلى تِلكَ الهِضابِ",29,"ب",1,0],["أَنا في الغوطَةِ زَهرٌ وَنَدىً","أَنا في لُبنانَ نَجوى وَتَصابي",29,"ي",1,0],["أَنا في فَجرِ حَياتي أَنا في شَرخِ شَبابي","الهَوى مِلءُ فُؤادي وَالصِبى مِلءُ إِهابي",30,"ي",1,0],["أَنا فَجرٌ لَم تُتَوِّج فِضَّتي كُلَّ الرَوابي","لي رِغابٌ لَم تَلِد بَعدُ بِالتَبابِ",30,"ب",1,0],["أَنا في نِيويوركَ بِالجِسمِ وَبِالر","روحِ في الشَرقِ عَلى تِلكَ الهِضابِ",31,"ب",1,0],["أَنا في الزَمانِ كَمَوجَةٍ في زاخِرٍ","أَنا فيهِ إِن يُزيد وَإِن لَم يُزيدِ",32,"د",1,0],["أَنا في حِماكُم طائِرٌ مُتَرَنِّمٌ","بَينَ الأَقاحِ الغَضِّ وَالنِسرينِ",33,"ن",1,0],["أَنا في عالَمٍ قَصِيٍّ سَحيقٍ","لا أَراها لَكِنَّ روحي تَراها",34,"ا",3,0],["أَنا في الحُبِّ مَيِّتٌ","وَعَذولي يَقولُ حَيَّ",35,"ي",1,0],["أَنا في البُستانِ وَحدي","في رِياضٍ سُندُسِيَّه",36,"ي",2,1],["أَنا في الحَقيقَةِ أَنتُمُ","هَذا اِعتِقادي فيكُمُ",37,"م",1,1],["أَنا في الحُبِّ أَلطَفُ الناسِ مَعنىً","دَمِثُ الخُلقِ ذو حَواشٍ رِقاقِ",38,"ق",1,0],["أَنا في القُربِ وَالنَوى","لَكَ قَلبي مُلاحِظُ",39,"ظ",1,1],["أَنا في أَمرٍ مَريجٍ","كُلَّما حَقَّقتُ أَمرَك",40,"ك",1,0],["أَنا في أَوسَعِ عُذري","وَكَفى أَنَّكَ تَدري",41,"ر",2,1],["أَنا في أَسرٍ ثَقيلٍ","أَيُّ أَسرٍ أَيُّ أَسرِ",41,"ر",1,0],["أَنا في مَجلِسٍ يَرو","قُكَ مَرأىً وَمُختَبَر",42,"ر",1,0],["أَنافَ إِلى أَن سارَتِ السُحبُ تَحتَهُ","فَلَولا نَداكَ الجَمُّ عَزَّ بِهِ القَطرُ",43,"ر",1,0],["أَنا في دارِيَ وَحدي","فَتَفَضَّل أَنتَ وَحدَك",44,"ك",1,0],["أَنا في الحُبِّ غَيورٌ","ذاكَ خُلُقي لا عِدِمتُهُ",45,"ت",2,0],["أَنا في الحُبِّ صاحِبُ المُعجِزاتِ","جِئتُ لِلعاشِقينَ بِالآياتِ",46,"ت",1,1],["أَنا فيما أَنا فيهِ","وَعَذولي يَتَعَتَّب",47,"ب",1,1],["أَنَا في دَرْبِ الحَياةِ الغَامِضَهْ","تَائِهٌ حَيْرَانْ",48,"ن",1,0],["أَنا في عَذابٍ مِن فراقِك","سكرانُ مِن خمر اِشتياقِكْ",49,"ك",1,1],["أنا في الحُبِّ مُغرَمٌ مُستَنيلُ","كُلَّ نَيلٍ أَنالُهُ لي قَليلُ",50,"ل",1,1],["انا في الحزن ارسل الشعر دمعا","ساخنا ثم ارسل الدمع شعرا",51,"ر",2,0],["انا في قبري اليوم عنكم بعيد","وانا عنكم فيه غير بعيد",52,"د",1,0],["انا في جوهري قديم على الار","ض وان كان حادثاً ميلادي",53,"ي",1,0],["انا في خضم ثائر عجّاج","والليل مسود الجوانب داج",54,"ج",1,1],["انا في حياتي بالحقيقة مغرم","واقولها جهرا على الاشهاد",55,"د",1,0],["انا في حياتي ما كذبت","لنيل شيء ليس لي",56,"ل",2,0],["انا فقاعة على الوجه منه","وخفائي في وجهه كظهوري",57,"ر",2,0],["أنا فيما أبديته من مقال","مخطئ ليس لي أقل استناد",58,"د",1,1],["أنا في دنياى أوآخرتي","شاعر النيل وحسبي لقبا",59,"ب",2,0],["أنا في تطلابه وهو لدىّ","مطلب مرَّ ولم يلو علىّ",60,"ا",1,1],["أَنافَ عَلى الماءِ ما بَينَها","وَبَينَ الجِبالِ وَشُمَّ الهُضَب",61,"ب",1,0],["أَنا في حِمى الهادي أَبي","كَ أُحِبُّهُ وَأُجِلُّ آلَه",62,"ل",2,0],["أَنافَ خَلفَ سَماءِ اللَيلِ مُتَّقِداً","يُخالُ في شُرَفاتِ الجَوِّ كيوانا",63,"ن",2,0],["أَنا في أُمَّةٍ تَدارَكَها اللَ","هُ غَريبٌ كَصالِحٍ في ثَمودِ",64,"د",1,0],["أنا في عينكَ الظلامُ كما أن","نَ بياضَ النهارِ عندكَ جونُ",65,"ن",1,0],["أَنا في أُسرَتي وَأَهلي كَأَنّي","بَينَهُم حينَ لا أَراكَ غَريبُ",66,"ب",1,0],["أَنا في إِذنٍ فَأَشكو","فَلَقَد طالَ السُكوتُ",67,"ت",1,1],["أَنافَ بِهِ بِسطامُهُ وَمُحَمَّدٌ","قِمامَ عُلاً يُعيِ المُلوكَ حُلولُها",68,"ل",3,0],["أَنافِعي عِندَ لَيلى فَرطُ حُبّيها","وَلَوعَةٌ لِيَ أُبديها وَأُخفيها",69,"ي",3,1],["أنا فارسٌ فيما أقولُ مُحَقَّقٌ","فاسَمع مَقالَةَ فارسٍ من راجِلِ",70,"ل",1,0],["أُنافِسُ في طيبِ الطَعامِ وَكُلُّهُ","سَواءٌ إِذا ما جاوَزَ اللَهَواتِ",71,"ت",1,0],["أَنا فَتاةُ الحَيِّ مِن وائِلٍ","في الشَرَفِ الشامِخِ وَالنُبلِ",72,"ل",1,0],["أَنا فيهِ مُخاطِرٌ","حينَ يَأتي وَيَذهَبُ",73,"ب",1,0],["أنا في بُعدِكَ مفقودُ الهُدَى","ضَائعٌ أعشو إلى نورٍ كريمِ",74,"م",1,0],["أَنا في الثَمانين الَّتي فَتَلَتْ بِها","قَيْدي الزمانةُ عِندَ ذلّ قِيادي",75,"د",2,0],["أَنا في لَوعَةٍ وَحُزنٍ شَديدِ","لَيسَ عِندي لِلَوعَةٍ مِن مَزيدِ",76,"د",1,1],["أَنا في ذِمَّةِ الكَريمِ سُلَيما","نَ السَليمِ الهَوى الرَئيفِ الهُمامِ",77,"م",1,1],["أَنَا فِي هَذِهِ الدِّيَارِ غَريبٌ","وَغَرِيبُ الدِّيَارِ لَيْسَ يُلامُ",78,"م",1,0],["أَنَا فِي الدَّهْرِ ضَائِعٌ بَيْنَ فَهْمٍ","فَاتِكٍ حَدُّهُ وَجدٍّ كَهَامِ",79,"م",1,1],["أَنَا فِي الْحُبِّ وَفِيٌّ","لَيْسَ لِي بِالْغَدْرِ عِلْمُ",80,"م",1,1],["أَنَا فِي الشِّعْرِ عَرِيقٌ","لَمْ أَرِثْهُ عَنْ كَلالَهْ",81,"ل",2,0],["أنا فارسُ المنظومِ والمنثورِ هلْ","تسري المعاني تحتَ غيرِ ركابي",82,"ي",1,0],["أنا في حالٍ نقيصٍ","يا شموساً في البزوغِ",83,"غ",1,1],["أنا في غمرتي ساهٍ","وأعمالي لها مُحْصِ",84,"ص",1,0],["أنا في حلقِ حسودي غصةٌ","وبهِ مني أذى لا يوصَفُ",85,"ف",1,0],["أنا في يقيني أنَّ لي مِنْ حرِّها","حصناً يقيني وهْوَ عفْوُ الباري",86,"ي",1,0],["أنا في الحبِّ قانعٌ باليسير","بخيالٍ يزورُ أو وَعدِ زورِ",87,"ر",1,1],["أنا في بحرِ هواهُ","واقعٌ والقلبُ طائرْ",88,"ر",1,0],["أنا في صَمِيمِ الضَّارِعينَ لربِّهِمْ","ألاّ يُرِيكَ كَرِيهةً، وجَفِيلا",89,"ل",2,0],["أَنافَ بِهِ صَلدُ الصَفا فَهوَ مِنبَرٌ","وَقامَ عَلى أَعلاهُ فَهوَ خَطيبُ",90,"ب",1,0],["أنَا فِي عَاذِلِي وحُبِّي وشَوقِي","حَائِرٌ أيَّهُم أشَدُّ عُتِيَّا",91,"ي",2,0],["أَنا في ظُلمَةِ العَجاجِ شُجاعٌ","وَجَبانٌ في نورِ ذاكَ الجَبينِ",92,"ن",1