//www.poetsgate.com/ViewPoem.aspx?id=159305",""],[5324,"أحلى الهوى.","https://www.poetsgate.com/ViewPoem.aspx?id=211180",""],[592,"هو الله معبود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5410,"إلامَ الصَبر...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=141849",""],[5431,"متصلٌ فيَّ ومااتصلا","https://www.poetsgate.com/ViewPoem.aspx?id=185184",""],[5431,"استنساخ!","https://www.poetsgate.com/ViewPoem.aspx?id=202923",""],[5431,"حكمةٌ وسعادة....","https://www.poetsgate.com/ViewPoem.aspx?id=207031",""],[5436,"شوق التراب(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34912",""],[5444,"عصامي العلا","https://www.poetsgate.com/ViewPoem.aspx?id=205517",""],[5459,"غثاء","https://www.poetsgate.com/ViewPoem.aspx?id=199893",""],[5538,"الله يقسم من أضاع فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=142624",""],[470,"وأنتِ هنا كأنكِ ما عليكِ!","https://www.poetsgate.com/ViewPoem.aspx?id=177989",""],[482,"شكايةُ الصبَّ إلى الأربُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=111423",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5674,"ترنيمة عاشقة فراتية","https://www.poetsgate.com/ViewPoem.aspx?id=190249",""],[5691,"جارة القمر","https://www.poetsgate.com/ViewPoem.aspx?id=205881",""],[5691,"تدور بنا الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206080",""],[5732,"اهلا عدد ما مال ريح","https://www.poetsgate.com/ViewPoem.aspx?id=177869",""],[5781,"صهيلُ اللَّيلِ وعطره","https://www.poetsgate.com/ViewPoem.aspx?id=202851",""],[5790,"إذا ما سقاني ريقه وهو باسمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=112096",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[5926,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=213827",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[5956,"سيذكرك ..‏","https://www.poetsgate.com/ViewPoem.aspx?id=182161",""],[5956,"نورُ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183249",""],[5956,"نعيش على الحب","https://www.poetsgate.com/ViewPoem.aspx?id=184057",""],[5957,"عابر","https://www.poetsgate.com/ViewPoem.aspx?id=37161",""],[5966,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=158312",""],[5969,"طقوس العز","https://www.poetsgate.com/ViewPoem.aspx?id=198911",""],[6093,"أخْلو ، ونفسيَ للهمومِ مَطَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=176070",""],[6093,"حَبْرُ المدينةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199237",""],[6102,"سمسمة 2","https://www.poetsgate.com/ViewPoem.aspx?id=184414",""],[6125,"أما يَشتاقُ قلبُكِ في اللياليْ","https://www.poetsgate.com/ViewPoem.aspx?id=210955",""],[6125,"قد أضرمَ الشَّوقُ في جنبيَّ نِيرَانا","https://www.poetsgate.com/ViewPoem.aspx?id=210958",""],[6184,"أمام مصحف عثمان في استنبول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78621&r=&rc=13",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[6259,"ذكر الحمى فبكى لسجع حمامهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59404&r=&rc=52",""],[6346,"لك المدائح ياشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83384&r=&rc=0",""]],"verses":[["وَيُذهِلُها إِذا التَقَتِ العَوالي","ضِرامُ الطَعنِ عَن مَضغِ الشَكيمِ",0,"م",1,0],["وَيُذكِرُها الحُلومَ عَلى تَناسٍ","وَقَد بَلَغَت حَفائِظُها الهِياجا",1,"ج",2,0],["ويُذْكي لهُ الغَيْرانُ عَيناً إذا رأى","أَجارِعَ منْ حُزْوى بسَمْراءَ تُسْعِفُ",2,"ف",1,0],["وَيَذهَبُ بِالكِتابِ بِما أُلاقي","فَتَلثِمُهُ فَطوبى لِلكِتابِ",3,"ب",1,0],["وَيَذكُرُ أَيّاماً مَضَت مِن شَبابِهِ","وَما كانَ فيها بِالجَهالَةِ أَجرَما",4,"م",2,0],["وَيَذبُلُ زَهرُ القَريضِ الثَرِيِّ","وَيُقفِرُ رَوضَ القَوافي الغُرَر",5,"ر",1,0],["ويذيق من أشقى البلاد ببغيه","عقبى نكال كابدته مديدا",6,"د",2,0],["وَيَذْكُرُ فَرْقَداً مَنْ لا يُسَمَّى","وَبالأَفْرَادِ يَعْنِي الفَرْقَدَانِ",7,"ن",1,0],["وَيَذُودُ مَنْ جَارَاكَ عَنْ غَاياتِهِ","بِبُلُوغِهِ الْغَايَاتِ فِي الإِتْقَانِ",8,"ن",1,0],["وَيَذوبُ بِالكِتمانِ إِلّا أَنَّهُ","أَحوالُهُ تُنبي عَنِ الكِتمانِ",9,"ن",1,0],["ويذبح جفني بالدُّموع وما له","سوى الشهر بعد الشهر في البعدِ يسلخ",10,"خ",1,0],["ويذهب اللوم بي في كل ناحية","فلا يبلّغني إلا صُبابات",11,"ت",1,0],["وَيَذُمُّ عَهدَ الغانِياتِ كَناقَةٍ","بَعدَ الشِفاءِ يَذُمُّ عَهدَ سَقامِ",12,"م",1,0],["وَيُذكِرُني تَخيِيطُ كَعبِكَ شَقَّهُ","وَمَشيَكَ في ثَوبٍ مِنَ الزَيتِ عارِيا",13,"ي",2,0],["وَيَذيمُني مَن لَو ضَغَمتُ قَبيلَهُ","يَومَ الفَخارِ لَطارَ في لَهَواتي",14,"ت",2,0],["وَيُذهِلُ عَقلَهُ بِالحَربِ حَتّى","يَقومُ فَيَستَجيبُ لِغَيرِ داعِ",15,"ع",1,0],["وَيُذكِرُني الإِلفَ الَّذي هُوَ فاقِدٌ","وَيَعجِمُ شَكواهُ إِلَيَّ فَأُفصِحُ",16,"ح",1,0],["وَيُذيقُني طَعمَ المَلالِ تَدَلُّلاً","فَأَذوبُ بَينَ دَلالِهِ وَمَلالِهِ",17,"ل",2,0],["وَيُذيقُني مِنهُ عَلى وَجَلٍ","عَذباً كَطَعمِ سُلافَةِ الخَمرِ",18,"ر",1,0],["وَيُذكي وَراءَ اللَيلِ عَيناً حَديدَةً","يَنامُ بِها الدينُ اِحتِراساً وَيَسهَدُ",19,"د",1,0],["ويُذِيقُهم بَرْدَ السّلامِ مُردَّداً","عَذْباً كماءِ المُزْنِ أو هُوَ أعْذَبُ",20,"ب",1,0],["ويذكره وبالفاروقِ حِرصٌ","على أن ليس يَعدوه انتخابا",21,"ب",2,0],["وَيَذرِفُ مِن حُبِّها دَمعَهُ","وَما يَجلُبُ الحَظَّ دَمعٌ ذُرِف",22,"ف",1,0],["وَيَذكُرُ مِن شَأنِ القِرانِ شَدائِداً","وَفي أَيِّ دَهرٍ لَم تُبَتَّ القَرائِنُ",23,"ن",1,0],["وَيُذكَرُ أَنَّ في الأَيّامِ يَوماً","يَقومُ مِنَ التُرابِ مُغَيِّبوهُ",24,"ب",3,0],["وَيَذهَبُ هَذا الجيل نضو شقائه","وَيأَتي سعيداً بالسَلامة جيل",25,"ل",1,0],["ويذهبُ النُّورُ ويأتي الظلامْ","وتبزغ الأنجمُ في نسقهِ",26,"ه",1,0],["وَيَذُوبُ قَبْلَ الْبَيْنِ مِنْ شَوْقٍ إِلى","وَجْهِ الْحِمَى وَجَمَالهِ السَّحَّارِ",27,"ر",1,0],["وَيَذْكُرُ للآدَاب عَهْداً فَمَا يَني","مُعيناً لمَنْ يُعْنَى بهِنَّ وَمُنْجدَا",28,"د",2,0],["ويذيع منك البرق كامن لوعتي","فيدي على قلبي من الاشفاق",29,"ق",1,0],["وَيَذْعَرُ الأعداءُ مِنْ فَارِسٍ،","يَهُولُهُمْ إشْرَافُهُ، أوْ يَرُوعْ",30,"ع",1,0],["وَيَذكُرني أَخلاقك الغُر شَطرُهُ","وَتَحريفُهُ ضد لَكُم لَم يُكرَم",31,"م",1,0],["ويذكر في ضواحيك الروابي","زهت والورد منها طاب شما",32,"م",2,0],["ويذل الخصم في عزته","فيرى بالحال ممحوق الجسد",33,"د",1,0],["ويذكر أيام القطعية والنوى","وأيام وصل الآنسات الغرائر",34,"ر",1,0],["ويذكرني شدو الحمام وصالها","إذا رجَّعت ورقُ الحمامِ التغنيا",35,"ي",2,0],["وَيَذَهَب عَن طَرِيقِ المُصطفي مَن","بِهِ شَرُفَت ثَنِيَّاتُ الوَدَاعِ",36,"ع",1,0],["ويذكرني الأمين إذا بَدا لي","وقد مُلِّئَت بِهَيبَتِه الصُّدُورُ",37,"ر",1,1],["ويذهب عمر النوى والجفا","جُفاءً ويكفيه ما أضرما",38,"م",2,0],["ويذب عن آي الكتاب بحكمة","ويذيق من باراه فيه تبارا",39,"ر",2,0],["ويذكّر العلماء ألاّ يغمضوا","عما اقتضاه زمانهم أبصارا",39,"ر",2,0],["ويُذكِره بزلَ النجيعِ من الطُّلَى","عِضارٌ جلبنَ البابلىَّ المبرَّدا",40,"د",2,0],["وَيُذهِبُ نَقصَ البُعدِ عَنهُ وَشَينَهُ","لَحى اللَهُ وَقتاً حالَ بَيني وَبَينَهُ",41,"ه",1,0],["ويذكر ما من انعم الله عنده","فيشكر بعض الشكر أو يتادب",42,"ب",1,0],["ويذب أقوالا تبيت سواريا","منه إلى الأمراء والغلمان",43,"ن",1,0],["ويذهلُ عن نفائسِهِ بنفسٍ","تَرى الذكرَ المخلّدَ خَير مالِ",44,"ل",1,0],["ويذمّ وهو مذمّم","غيظا كأن به ندامه",45,"م",2,0],["ويذكر فضلك القمّينُ يوماً","إذا اجتمعَ المطاريحُ الجياعُ",46,"ع",1,0],["ويُذعنون ولا ما يُذعنون لهُ","لكنَّهُ خلُقٌ يقضي بإِذعانِ",47,"ن",1,0],["ويذكرنا فعلاتِ الردى","بأهلِ البوادي وأهلِ الحضرْ",48,"ر",1,0],["ويذكرنا مصرا وفاضل عصرها","رعى الله ذاك السفح والناس والعصرا",49,"ر",2,0],["ويذكر قلبي حسْن وجهك إن رأى","شبيهك في إشراقك الشمس والبدرا",50,"ر",2,0],["وَيُذِلَّني خَطبٌ وَعِزُّكَ قاهِرٌ","وَيُكاظَني ظَمَأٌ وَبَحرُكَ قَد طَما",51,"م",2,0],["وَيُذْهِبُ إِظْلاَمَ الْفُؤَادِ صَبَاحُهُ","كَمَا أَذْهَبَتْ لَيْلَ الْهَوَى سُرُجُ الْقِسْطِ",52,"ط",1,0],["وَيَذُمُّ مَنْ نَبَذَ الْعُهُودَ وَحَادَ عَنْ","سَنَنِ الْعُلاَ إِنِّي إِذَنْ لَخَسِيسُ",53,"س",1,0],["ويذهب الكلُّ حزناً كان أو فرجاً","فارض القضاء وسلّم غير منزعج",54,"ج",1,0],["ويذوي جمالٌ في الشبابِ ويَنطوي","وَيهوي جلالٌ كادَ في الأرضِ يُعبد",55,"د",1,0],["وَيذكر في التَهليل مَع ذكر ربه","وان قيل في التأذين أَشهد أَشهَد",56,"د",1,0],["وَيذْكِرُكمَ الأَحْبابَ فِيهِ بَدائِعٌ","مِنَ النَّوْرِ مِنْها نَرْجِسٌ وَبَنَفْسَجُ",57,"ج",1,0],["ويذكو عرْفُهُ في ثغْ","رِها ما رُدّد والقعس",58,"س",1,0],["ويذهب العمر سدى ضائعاً","كأنه الطيف بحين المنام",59,"م",1,0],["ويذهب الهجر والبعاد","والبؤس والمضره",60,"ه",1,0],["ويذكر كم المولى اشكروا نعماته","يزدكم ويهد الخلق في حال شكران",61,"ن",1,0],["وَيَذكرونكَ في بدءٍ وعاقبةٍ","مِن مستفزّينَ مرجوٍّ ومحذورِ",62,"ر",1,0],["ويذهب بي ما بين يأس ومطمع","زمان بنيل المعلوات بخيل",63,"ل",1,0],["ويذهل عما كان فيه من الأذى","وتبدو لنا منه مخايل طربة",64,"ه",1,0],["وَيَذُد عَنهُمُ الخَلالَةَ مِنهُ","بِسِجالٍ تَغدو أَمامَ سِجالِ",65,"ل",1,0],["ويذرى المدامع هتّانة","فيرمض بالنار قلب الفلاه",66,"ا",2,0],["ويذوب في خمر الندا","ء وينتشي مما يذوب",67,"ب",1,0],["ويذهلني فيه تخيل نفسه","غنياً ولا لون لهذا ولا شكل",68,"ل",1,0],["ويَذكُرُ فَرْخَيهِ ببَيْداءَ بَلْقَعٍ","تَشُق على مَن جابَها وتَطول",69,"ل",1,0],["ويَذْكرني منسيُّه أو مُضاعُه","وفي ضِمنها غَيثٌ بحيثُ يَصول",69,"ل",1,0],["ويَذهَبُ العُمْرُ وماذا يُرتَجى","من ذَهَبٍ يأتي إذا العُمْرُ ذَهَب",70,"ب",1,0],["وَيُذكِرُني صَبري بِرِقَّةِ خَصرِهِ","وَيُذكِرُني عَزمي بِفَترَةِ جَفنِهِ",71,"ن",2,0],["ويُذكرُني مرُّ النسيم ورَوحُه","حفائرَ تلعوها من الترب أطباق",72,"ق",1,0],["وَيذوق الموتَ من كمدٍ","كلَّما حازيتَ منزلَه",73,"ل",2,0],["ويذهب الشوش والاشجان","والهم والغم والكرب",74,"ب",1,0],["وَيَذكرَ لي دونَ الرِجال حَديثَها","وَيَنشُرَ عِندي نطقَها وَكَلامَها",75,"ه",2,0],["ويَذعَرُ سرب الحيّ وسواسُ حليها","إذا حركته من دعاثٍ ورفرفِ",76,"ف",1,0],["ويُذْري لتذْكار الغُوَيْر مدامِعاً","تكفَّل عَنْ أيدي الغمامِ بِسقْياهُ",77,"ه",1,0],["ويذكرُ نَعْمانَ الأَراك فينتشي","بعاثِر رَيَّاه فكيفَ برُؤْياهُ",77,"ه",1,0],["ويذهب التوهيم عن أفكاري","مؤتلفاً بأهلي الأخيار",78,"ر",1,0],["وَيَذُمُّ صَفوَ حَياتِهِ من لَم يَبِت","مِستَعصياً بِوَلائِهِ وَذِمامِهِ",79,"م",2,0],["ويذكر إن لاح برق لياليا","حمدت بها عيشى ببصري وجلّق",80,"ق",1,0],["ويُذْهِلُني عن سِحْرِ ما في جُفُونِها","بتُفَّاحِ سَواحِرُ",81,"ر",1,0],["ويذودُ عن أجفانِهِ سِنَةَ الكَرى","كَيْ لا يُرِيهِ الحُلْمُ أن يَتَأَوَّلَكْ",82,"ك",1,0],["ويُذِمُّ فيك بألفِ يومٍ مثلهِ","في العزّ يشهدُ عامُها بالقابلِ",83,"ل",1,0],["ويُذهله وجهُك المستنيرُ","عليه ومجلسُك المونِقُ",84,"ق",1,0],["ويذودُ عنه مُسدَّدٌ في قصده","يهدي الصوار له بغير تلوُّمِ",85,"م",1,0],["ويذْكو نسيم الجوِّ عند مديحهِ","كأن بأعلى لُوحِه نشرَ عنبرِ",86,"ر",1,0],["ويُذْكِرُه البانُ القدودَ إذا انثنتْ","تَرنَّحُ مِن مَرَّ النَّسيمِ موائلُه",87,"ل",2,0],["ويُذكِرُه طيفُ الخيالِ ازديارَهٌ","اِذا نابَ عن طيبِ الوصالِ كتابُهُ",88,"ب",2,0],["ويذكر هذا عن مناقبهم فأي","ن من هم أسود الحق أهل اشمائل",89,"ل",1,0],["ويذكُرُ ذُهلاً والهوى حيثُ عامرٌ","ومنزلَ حُزْوى والمُرادُ زَرودُ",90,"د",1,0],["ويذهبُ طرفي في تعقُّب خَطوِه","وإن كنتُ في شُغلٍ فيا ضَيعةَ الشُّغلِ",91,"ل",1,0],["ويذودنِي وبِيَ الصّدى عن عَذْبِهِ","فإذا سَقاك سَقاك كلَّ أجاجِ",92,"ج",1,0],["ويذوب المحب فيه ويفنى","كلما لاح كاشفاً أردانه",93,"ن",2,0],["ويذْهبُ من نُريدُ لهُ بَقاءً","ويَبقَى مَن نُريدُ لهُ ذَهابا",94,"ب",2,0],["ويَذخرُ بيضَ الهِندِ وهْيَ كنوزُهُ","وتَهلِكُ معهُ بينَ نحرٍ وعاتقِ",95,"ق",1,0],["وَيَذُبُّ عَنْ أعراضِهِ","ويَشُتَّ للطُّرَّاقِ نَارَهْ",96,"ر",2,0],["وَيُذيقُ عاصيَة العذابَ لأَنَّه","للخلقِ عَادَى أَو عَلى الخلقِ اعْتَدَى",97,"د",2,0],["ويذكر ربه سراً وجهراً","ويدمن ذكره في كل حال",98,"ل",1,0],["وَيُذكيها بِكَفَّيهِ","إِذا ما لاحَ كَوكَبُها",99,"ب",3,0],["وَيَذكُر وَسَط دُخان الطِباق","دُخان الحُروب وَنار الوَغى",100,"ا",1,0],["ويذكرهم أبو رهم بهجو","فيستدعي إلى الحرم النفوسا",101,"س",2,0],["ويذكرُ أيّاماً بقربك قد مضت","ويكثر منك الذكر في القرب والبعدُ",102,"د",1,0],["وَيُذَكِّرُ الثَّقَلَينِ هَولُ مَسيرِهِ","بالصُّورِ يَنفُخُ فيهِ إسرافيلُه",103,"ل",2,0],["ويذهلها حتى تغيب عن الورى","بروق على وجه السماوات تلمع",104,"ع",1,0],["وَيذود عَنهُم كُلّ غرٍّ همه","سَلب وَنَهب زائد وَمغارم",105,"م",1,0],["وَيُذعنُ جاكوني بِحَقِّ تقدّمٍ","لِفَصل القَضا مِنا بِقاطع بُرهان",106,"ن",1,0],["وَيذب عَن أَبنائها بِحَماسةٍ","مَقرونةٍ بِالعز وَالإدلال",107,"ل",1,0],["ويُذيقُه كأسَ الرَّدى أدباً له","إذْ لم يَذُقْ فيما تَقَدَّمَ كاسَهُ",108,"س",2,0],["ويذهب بالنجوى المساءُ وبالرضى","ويطلعُ بالشحناءِ والغضبِ الصبحُ",109,"ح",1,0],["ويذود الخطوب عنها ويحمي","مجدها أن يناله الحساد",110,"د",1,0],["وَيَذكر كلّ اللّيلِ أَحوالَ عِشقِهِ","إِلى حينِ أَنّ الصّبح يَبدو اِبتسامُهُ",111,"م",2,0],["ويُذِيقُهُمْ جُرَعَ المَنايا بجَكَمٌ","وَكَذاكَ عادَةُ بَجْكَمٍ فِيما مَضَى",112,"ض",2,0],["وَيُذكِرُنا وَمضَ البُرُوقِ ابتِسامُهُ","وَتُبدِي لَنا سِحرَ الهَوى لَحَظاتُهُ",113,"ت",2,0],["وَيُذكِي غَرامِي البرقُ مِن نَحوِ أَرضِهِ","وَيُطرِبُني مِن حَيِّهِ نَسَماتُهُ",113,"ت",2,0],["ويذيع الجمال سري وأدعو","بأعذار خلعت فيه العذارى",114,"ر",2,0],["ويذهب الحنيف معنى الخوف من كبدي","وأغتدي بمنى في مأمن عصما",115,"م",2,0],["ويُذِلُّ الصِّعابَ للفاطمي","ينَ وَيَصْفى لهمْ من الدَّهر شِرْبا",116,"ب",2,0],["ويُذِلُّ العدى فيَلْقَوْنَ خَسْفا","ومَضِيقا في مَدْرَج العْيشِ صَعْبا",116,"ب",2,0],["ويذّكر الصبابة كل لون","ترنَّح فوق هاتيك الأعالي",117,"ل",2,0],["ويذر الأرز والملح في النار","فتزداد فوق كل ازدياد",118,"د",1,0],["ويذرُّ العبيرَ في ورق الزَهرِ","ويغري الطيورَ بالتغريد",119,"د",1,0],["ويذيع فيك المدح ما","شدت الطيور معغردهْ",120,"د",2,0],["ويذهب قحط القلب والنور ينزلن","وتطرب والآلا تذود عن الكرب",121,"ب",1,0],["ويذكره العافون إن ضاق ذرعهم","وأبدى لهم أهل الثراء التجهما",122,"م",2,0],["ويذكرني أهل العديب وبارق","وأوطان سلمى والمرابع من نجد",123,"د",1,1],["ويذكر للعرش يوم ارتقى","عليه فؤاد فقرّت علاه",124,"ا",2,0],["ويذهبُ عني ما أُلاقِي مِنَ الضَنى","ويومُ النَوى عنّا تزُمُّ مَطاياهُ",125,"ا",2,0],["وَيذبح شيطان النفوس وَيحلقوا","الرؤوس فيضحى القلب منهن أَقرعا",126,"ع",2,0],["وَيذيب قَلبي وَهُوَ يهوى قربه","وَمن العجائب عاشق لمذيبه",127,"ب",2,0],["ويذيب السّقم جسمي تلفاً","وأنا بالعمر لم أبرح فتيّا",128,"ي",2,0],["وَيُذْهِبُ الغَوْلَ عن التَغَوُّلِ","يُلْقَى به الدليلُ ذو التمحُّلِ",129,"ل",1,0],["ويذهله عن حسن باريس همه","فيذهل عن أم العواصم والمدن",130,"ن",1,0],["ويذكرُهُ من ردَّهم بعبوسهِ","فتًى كان يلقاهم ببشر ويسعفُ",131,"ف",1,0],["ويذهنه إياس ألفى مرة","والشافعي في جودة الأفكار",132,"ر",1,0],["ويّذُودُ عن طَرْفي كَراهُ تَعَمُّدٌ","للوَجْدِ يمنع طارِقَ التهويمِ",133,"م",1,0],["ويذهبون الأُلى تزداد هِمَّتُهم","كلٌّ على نِيَّةٍ يسْعَى ولا يسمُ",134,"م",1,0],["ويذهبون شَتيتاً في الورى مِزقا","بين البريَّةِ لا عُربٌ ولا عَجمُ",134,"م",1,0],["ويذيبه أسفٌ على وطن","أودى بريق عيشه النكد",135,"د",1,0],["ويذلّ للبواب والحجاب والش","فعاء أهل القريب والاحسان",136,"ن",1,0],["وَيُذيبُني لَحظُ الحِسانِ وَإِنَّما","قَد كُنتُ قُلتُ شَبيبَتي لِبِلادي",137,"د",2,0],["ويذري حين يستسقي دموعاً","يرقن كما يروقُ الإبتسامُ",138,"م",1,0],["وَيُذهِلُ الخَليلَ عَن خَليلِهِ","أَو يَرجِعَ الحَقُّ إِلى سَبيلِهِ",139,"ل",2,0],["وَيَذب عَن حرم النَبوة","مُخلصاً لِلّه ذبَّه",140,"ب",2,0],["وَيذكر الأَعداء بَطشة رَبِهم","لَو كانَ ثَمة يَنفَع التَذكير",141,"ر",1,0],["ويذكر أياماً تقضت بحاجر","وناعم عيش راق في سالف العهد",142,"د",1,0],["ويذهب البلغم والزوجين","يزيد حضوتيهما في البين",143,"ن",1,0],["ويذود عن حرم النبي بسيفه","أهل العناد فديته من ذائد",144,"د",1,0],["وَيَذاد عَن وَطَن تَعاهده","وَالناس أَبناء لِأَوطان",145,"ن",1,0],["ويذود المنام عني غرام","واكتئابي ولم يطع لي أمرا",146,"ر",2,0],["وَيَذهَبُ هَمُّ الوَفدِ مِن نُورِ وَجهِهِ","لِما راقَ فيهِ مِن حَياً وَتَكَرُّمِ",147,"م",1,0],["وَيَذودُ عَن وادي الكِنانَةِ طارِقاً","وَيَقيهِ عادِيَةَ الزَمانِ وَمَن سَعى",148,"ع",2,0],["ويذكرني قومي إذا عز فارس","له فيصل يوم النزال صقيل",149,"ل",1,0],["ويذكرني قومي لدى كل منبر","عليه اساطين البيان تجول",149,"ل",1,0],["ويذوق لي عذبا مسا","غاً من شهي رضاب بردِك",150,"ك",1,0],["ويذكُرُكَ الجارُ المربّعُ شَكْلُه","صَليبكَ فوقَ الزّنْد في غُرةِ العُمْر",151,"ر",1,0],["ويذوق طعم الشهد من","ذاك الرضاب إذا عصر",152,"ر",1,0],["ويذكرني ما قد تناسيتُ سالفا","لهُ سالفٌ يهدي الهوى لعشيقه",153,"ق",2,0],["ويذود عنهم مقولي بشوارد","في جيدهم كاللؤلؤ المتناثر",154,"ر",1,0],["ويذيقُهُ لكزاً وَوَكزاً آخِذاً","بخناقهِ اخذَ العدوّ الازرقِ",155,"ق",1,0],["ويَذرفُ دَمعاً والحَشا تَتَوَقّدُ","يقولُ لِنَهرٍ ماؤهُ يَتَجَعّدُ",156,"د",1,0],["ويَذعَرُني خطبٌ رَجاؤكَ دونَهُ","فأجزعَ منهُ إنّني لجَزوعُ",157,"ع",1,0],["ويذعَرُها تلفُّتُنا إليها","فتسقُطُ أوْ تَزِلُّ عن الكُعوبِ",158,"ب",1,0],["ويُذْكِرُها عَرْفُ الصَّبا زمَنَ الصِّبا","فهلْ نفَحاتُ الطّيبِ فُضّتْ عِيابُها",159,"ب",3,0],["وَيُذكَرُ المَخصُوصُ بَعدُ مُبتَدَا","أو خَبَرَ اسمٍ لَيسَ يَبدُو أبَدَا",160,"د",2,0],["ويذيقه مكراً ضروب حلاوة","من خمرة الملهي وقد وضع الرصد",161,"د",1,0],["ويذود عن حوض المرؤة كلما","حجز اللئيم الورد على صفاته",162,"ت",2,0],["ويذوب من غيظ ويأخذه البكا","حسداً وبغياً يعتريه نشوغ",163,"غ",1,0],["وَيَذكُرُ إِن لا قاهُ زَلَّةَ نَعلِهِ","فَجِئ لِلَّذي لَم يَستَبِن بِبَيانِ",164,"ن",1,0],["وَيذكرُهُ قَومٌ وَقاهُم مِنَ الرَّدى","عَلى حينِ جَدَّ الدَّاءُ وَاِستَوثَقَ الحَدُّ",165,"د",1,0],["وَيذنب دَهري في تصاريف دَهره","وَما كُنت أَلقاه بخجلة غالط",166,"ط",1,0],["وَيذكُرَ أَحبابي زَماني لقُربِنا","كما لم يَزالوا في لِساني وَفكرتي",167,"ي",1,0],["ويذرون من مس العذاب دموعهم","فيُنظم منها جوهر وعقود",168,"د",1,0],["ويذهل حتى يفلت الليث صيده","ولا تفرق الغزلان من ناب ضيغم",169,"م",1,0],["ويذود عنها الحرب صادق عزمه","والدهر عز على الملوك سلامه",170,"م",2,0],["ويذكى لظى الحرب العبوس تنزّهاً","يخال مجال الضرب والطعن بستانا",171,"ن",2,0],["ويذيع كلٌ ما افترى من نعت شي","خهم الغوي ولو خرافة هازل",172,"ل",1,0],["وَيَذكُرهُ القُمريُّ بِالأَيكِ ساحِقاً","زَمانَ الصِبا مِن شَرخِهِ المُتَقَدِّمِ",173,"م",1,0],["ويذكي التعصب نار العدا","ء ويتبع من رأيه فائل",174,"ل",1,0],["ويذكر واجداً منناً عليه","أفاضتها بلا من يداكا",175,"ك",2,0],["ويذكر سروا في رياضك باسقا","تحل الصبا منه غدائره الجعدا",176,"د",2,0],["ويذكر جوا في مصيفك صافيا","يراعي الدراري فيه من الف السهدا",176,"د",2,0],["ويذل كل فتى أخي همم","ويعزّ من قعدت به الهمم",177,"م",1,0],["ويذكي جواي البرق يلمع موهنا","ويهتاجني ساري النسيم إذا هبا",178,"ب",2,0],["ويذهب الشرور عنا والضرارْ","ويغفرن ذنوبَنا والأوزارْ",179,"ر",1,0],["وَيَذخَرُ بَطشاً بَعيدَ المَنالِ","لِذَبحِ الكِلابِ وَكَبحِ الرِجالِ",180,"ل",1,0],["وَيَذهَبُ قَبلَ بُرُوزِ الغَزَاله","إِلى الفُلكنِ إِيذِيُسٌ بالرَّسالَه",181,"ه",1,0],["ويُذكِي بها النِّيرانَ ثُمَّ إِزاءَها","يُذَبِّحُ كًلَّ العَسكَرِ المُتَضَوِّرِ",182,"ر",1,0],["ويذكركم حرباً بها جهداً معاً","وكم بعباب البحر نالهم الجهد",183,"د",1,0],["وََيَذبُّ عَنهُ طروق ذئبٍ خاطفٍ","وَإلى يَنابيعِ الحَياة يَقودُه",184,"د",2,0],["وَيذبُّ عَنها المعتدين وَان عَصوا","بِعَصا الكَليم مدافعاً وَمقاوما",185,"م",2,0],["وَيَذِلِّلنَهُ عَمداً وَإِن عَزَّ جانِباً","وَيَحسِبُ مِنهُنَّ الهَوانُ تَكَرُّما",186,"م",2,0],["ويذب عن حرم الجمال بأعين","تدمي لواحظها القلوب ولا تدي",187,"د",2,0],["ويَذِلُّ عنترةُ الشجاع لها","وينال حاتَم عندها بُخلُ",188,"ل",1,0],["ويذب من أصداغه وجعوده","أفعى عن الكنز المصون وعقرب",189,"ب",1,0],["ويذكّر الظمآن في البيرا وفي","كاسٍ من البردو تكلل بالدرر",190,"ر",1,0],["ويذيقون العدى مر الضنى","أي شيء جابهوا لا يأبهون",191,"ن",1,0],["وَيذاع أَمركم على أَجنادنا","أَن لا يُطيلوا في المكان بقاءَ",192,"ا",2,0],["وَيُذكرني نَفحُ الرِياضِ عَبيرَها","فَأَمكثُ يَطويني الغَرامُ وَيَنشُرُ",193,"ر",1,0],["ويذيعه بالليل فهو بفعله","وبصنعه هذا صديق الحندسِ",194,"س",1,0],["ويذهب كالنعامة في الفيافي","وقد ولي البخار له قيادا",195,"د",2,0],["ويذوب من حرّ النوى ما بيْننا","وأذوق بعد وصالنا ، بُعدي",196,"د",2,0],["ويذكرها الأبيُّ بكل عزمٍ","إذا ما ثار يخشاه الحقود",197,"د",1,0],["ويذكي لظى وجدي نسيم من الحمى","وقد جاء من نحو الأحبة ذاكيا",198,"ي",2,0],["ويذيبني وجدي إليكِ ويحتوي","قلبي هواكِ ، أتقبلين وصالي",199,"ل",2,0],["ويذكر غرامٍ عايشه حول مع حول","ويذكر غرامٍ عايشه باالطعوني",200,"ن",2,0],["ويذوق في كأس العذاب... عذوبة الصبر الحميد","ويشيم في وجه البلاء مخايل النصر الأكيد",201,"د",1,0],["ويذهل الناطق عن جوابه","حتى ترى كل فصيح باقلا",202,"ل",2,0],["ويذكي اشتياقي زند تذكار عهدكم","وما الشوق إلا بعض نار الجوانح",203,"ح",1,0],["وَيَذُوبُ فِي حِضْنِ اللَّمَى رَقْرَاقُهُ","وَكَأَنَّهَا قَدْ سَيَّحَتْ نَبْضَاتِهَا",204,"ت",3,0],["ويذكرُني الأعادي في فدائي","نموذجَ أمةٍ عاشت مجيدَهْ",205,"د",2,0],["ويذبح كأسي بين آهٍ وحسرةٍ","ففاضت دما شفتيَّ تبكي المجندلا",206,"ل",2,0],["ويذكرك المحراب والليل دامس","وتذكرك الأذكار في الخلوات",207,"ت",1,0],["ويذكرك الفرقان والقلب خاشع","وتذكرك الآيات في السبخات",207,"ت",1,0],["ويذكرك الليل الذي قمت جنحه","كمثل الخيال دائم السجدات",207,"ت",1,0],["ويذكرهم والليل يرخي سدوله","على راهب من خشية الله هارب",208,"ب",1,0],["ويُذِيقَ الكَهلَ فِي دَاخِلِهِ","مُنذُ أَنْ كَانَ نَدِيمِي العَسَلا",209,"ل",2,0],["ويذرف الدمع مدرارا بلا مهل","مابال عينك منها الدمع ينهمل ؟",210,"ل",1,0],["ويُذيبُ هذا البعدُ جوفَ حُشاشتي","والنبضُ في قلبي أشدُ وأوجعُ",211,"ع",1,0],["ويذيقك المر الزؤام حلاوة","وحقائق تغدو به الاوهام",212,"م",1,0],["ويذهب عني الغم والهم والأسى","فننجوا وعن قرب إلى صحبنا نغذ",213,"ذ",1,0],["ويذْكُرُ فضلي مَنْ قَطَعْتُ رجاءَه","ويشْكرُ هجري من رأى الفضْلَ باغيا",214,"ي",2,0],["ويذكر من أقام الشرع فينا","بنور سماحة تمحو السقاما",215,"م",2,0],["ويذوبُ حلاه بذائقتي","ويفيضُ الشوقُ إذا انفعلا",216,"ل",2,0],["ويذيبُ قطعان الثلوج بحرّه","حتى ولو من لؤمها يتلطّخُ",217,"خ",1,0],["ويذوب أحيانا بنكهة قهوتي","بشفاهه الحرّى وإثم عبادةْ!",218,"د",2,0],["ويذبُّ الذنوبَ عنها عَفافٌ","بحلالِ الهوى يُجافي الحراما",219,"م",2,0],["ويذرعُ في كل النواحي جهادَه","بروحٍ وعزمٍ قد ألانَ له الصعبا",220,"ب",2,0],["ويَذِلُّ مَن للريح عندَ هُبُوبها","ينقادُ ..تَحفرُ قبرَه الأهواءُ",221,"ا",2,0],["ويذله بالعشق حتى يبتلي","وأعوده من جملة العود",222,"د",1,0],["ويَذبحُني الهوى والعينُ تهوي","على لُجَحِ المياهِ بُركبَتَيكِ!",223,"ك",1,0],["ويذكرُ العهدَ فيخشى على","أعشارِ قلبٍ بهمُ مولَعِ",224,"ع",1,0],["وَ يُذْكَرُ بِالغَارِ الْعَنَاكِبُ مُقْعِدٌ","وَ لَا أُزْعِجَتْ بَالًا وَ لَا هُوَ يُزْعَجُ",225,"ج",1,0],["ويذوبُ طيفكٓ في صقيعِ أضالعي","قد تستكينُ منٓ العذابِ دمائي",226,"ا",3,0],["ويَذوبُ فيها ذوْبَ هدْهَدَةٍ","للطِّفْلِ قبْلَ النَّوْمِ في حَبَرِ",227,"ر",1,0],["ويذْكُرُهُ الرَّحْمنُ بالخَيْرِ عنْدَهُ","فأنْعِمْ بهِ ذِكْراً لَدى اللهِ أخْيَرُهْ",228,"ر",2,0],["ويذريه ما يشكي عنا كل لا هوب","ويزيد له بالطيب عن ماهقى به",229,"ب",2,0],["وَيَذُرُّ في شَفَقِ الغُروبِ عَقيقَهُ","هَزَجُ العَشِيِّ عَنِ الصَّباحِ بَديلا",230,"ل",2,0],["ويُذكِرني من قَدِّه ومدامعي","مَجَرَّ عَوالينا ومَجرى السوابقِ",231,"ق",1,0],["وَيُذْبَحُ أَطْفَالٌ تَعِلَّةَ فَاجِرٍ","لَهُ فِي دِمَاءِ المُسْلِمِينَ مَعَاوِلُ",232,"ل",1,0],["ويذوق جلُّكمُ قبيحَ ثمارها","وستنزف الأحداق ممّا يؤْرقُ",233,"ق",1,0],["‏‎‎‎‎‎‎‎‎‎ويذهب كل البؤس من بهو نورها","ومن بسمة خجلى تجلت بثغرها",234,"ر",3,1],["ويذهب كلّ دينٍ غير هذا","وينقشع الدُّجاء فلا دجاء",235,"ا",2,0],["ويذكركِ الليل والسَّحَرُ","ويذكركِ الثلج والمطرُ",236,"ر",1,0],["ويذكرك القلب والفِكَرُ","وتذكرك الروح والبصرُ",236,"ر",1,0],["ويذوب الحُسْنُ بقلبينا","ويغطّي العالمَ بالشِّعْرِ",237,"ر",1,0],["ويذعنُ كلُّ امرِئٍ لطباعٍ","لديه بسلمٍ بها أو قنا",238,"ن",2,0],["ويذبل غصني بحبه حتى","أصير أسيرةَ وجدٍ وأكثرْ",239,"ر",1,0],["ويذبلُ في شفاةِ الحُلمِ وردٌ","يعبِّرُ عن معاناةِ الفؤادِ",240,"د",1,0],["وَيَذكُرُ أُمَّةً في العُهرِ تَذوي","على رَقصِ البَغايا لا تَراهُ",241,"ا",2,0],["ويذيبني نبَأ الفجيعة قولهم :","في ظَهْرِ مُحْصَنَةٍ تَنَفْسَ عَارُ",242,"ر",1,0],["ويذلُ قوماً أَلَّهوا من دونه","زوراً عليَّاً في الضلالة ساروا",242,"ر",3,0],["ويَذُبُّ عَنْ نهرِ الهُدى","أقذاءَ أقوام ٍ عُتَاةْ",243,"ا",2,0],["وَيَذكُرُنِي شَقاءُ العُمرِ, لَكِن","إِذا ما آنَ يَنسانِي الخَراجُ",244,"ج",1,0],["ويَذكرُ قُبْلَةً قَبلَ ارتِحَالي","وأحضَانًا بها أحسَنتِ سَبْكِيْ",245,"ي",1,0],["ويذرفُ القلبُ في كَدٍّ وفي كَلَلٍ","وفي سَمومٍ على الأطلالِ رَيحَانا",246,"ن",2,0],["ويُذيبني من سال فكرهمُ","واطلّ فجر حيثما ركبوا",247,"ب",3,0],["ويذهب بوش الإثم نحو مزابل","ويلحق أوباما به متهاويا",248,"ي",2,0],["ويذمّ صفوَ حياته من لم يبت","مستعصماً بولائه وذمامه",249,"م",2,0],["وَيَذْكُرُ أَنَّ شَعْباً مَاتَ غَبْناً","يُنَادِينَا فَآثَرْنَا القُعُودَا",250,"د",2,0]]}