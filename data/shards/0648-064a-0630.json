{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[55,"إذا هجر المحب بكى وأبدى","https://www.aldiwan.net/poem26538.html","الوافر"],[57,"ولما قسا قلبي وضاقت مذاهبي","https://www.aldiwan.net/poem24634.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[93,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[47,"الحر يصبر ما أطاق تصبرا","https://www.aldiwan.net/poem25117.html","الكامل"],[72,"أخط سؤالي بالرقاع ولا أرى","https://www.aldiwan.net/poem18535.html","الطويل"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[85,"شغلته أشغال عن الآرام","https://www.aldiwan.net/poem63013.html","الكامل"],[43,"أريك الرضا لو أخفت النفس خافيا","https://www.aldiwan.net/poem10605.html","الطويل"],[45,"أحبب إلي بطيف سعدى الآتي","https://www.aldiwan.net/poem62643.html","الكامل"],[58,"ألم تعلم أبا سمعان أنا","https://www.aldiwan.net/poem30964.html","الوافر"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[31,"أطوي الضمير على حرارته","https://www.aldiwan.net/poem42495.html","الكامل"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[105,"هو وفدهم وهم الفريق الطيب","https://www.aldiwan.net/poem44002.html","الكامل"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[46,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[46,"أدين برب واحد وتجنب","https://www.aldiwan.net/poem23440.html","الطويل"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[45,"كَلّفَني، فَوْقَ الذي أسْتَطيعْ","https://www.poetsgate.com/ViewPoem.aspx?id=31119",""],[107,"فدا لك روحي من رشا متبرم","https://www.aldiwan.net/poem16245.html","الطويل"],[113,"سقاك العارض الوسمي سجما","https://www.aldiwan.net/poem40598.html","عموديه"],[113,"قتل الاعداء يا هند الحسد","https://www.aldiwan.net/poem41154.html","عموديه"],[118,"ترى يذكر الأحياء أهل المقابر","https://www.aldiwan.net/poem49360.html","الطويل"],[130,"ألا حييا دور الحبيب واحيينا","https://www.aldiwan.net/poem54648.html","الطويل"],[130,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[130,"ويذكرني الأمين إذا بدا لي","https://www.aldiwan.net/poem54839.html","الوافر"],[133,"أما آن للشمل أن ينظما","https://www.aldiwan.net/poem49065.html","المتقارب"],[133,"لم لا تجيب وقد دعوت مرارا","https://www.aldiwan.net/poem49173.html","الكامل"],[140,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[148,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[158,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[164,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[184,"إن المحسد في النعيم","https://www.aldiwan.net/poem43292.html","مجزوء الكامل"],[184,"دموع العين أربعة تباع","https://www.aldiwan.net/poem43629.html","الوافر"],[197,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[197,"زهته الملاحة حتى سفر","https://www.aldiwan.net/poem45638.html","المتقارب"],[208,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[227,"أخفف تسليمي وأصفي مودتي","https://www.aldiwan.net/poem51106.html","الطويل"],[233,"يا من رأى حد الحسام مضاءه","https://www.aldiwan.net/poem31747.html","الكامل"],[235,"سهام الردى تخطي الذي قصد الهبطي","https://www.aldiwan.net/poem18843.html","الطويل"],[235,"ربع المودة بالحشا مأنوس","https://www.aldiwan.net/poem19705.html","الكامل"],[257,"ليل الخطوب له فجر من الفرج","https://www.aldiwan.net/poem35932.html","البسيط"],[268,"محا لك حسنا مدمع وتسهد","https://www.aldiwan.net/poem35617.html","الطويل"],[269,"هي العيس نوليها الحنين فتسعد","https://www.aldiwan.net/poem52091.html","البسيط"],[278,"لنا مجلس ما فيه للهم مدخل","https://www.aldiwan.net/poem60713.html","الطويل"],[296,"تعالى المبدع القدس","https://www.aldiwan.net/poem36858.html","عموديه"],[302,"يا خيرة الحي عليكم سلام","https://www.aldiwan.net/poem16888.html","السريع"],[302,"يا سعد قف بي على الطلول","https://www.aldiwan.net/poem16901.html","مخلع البسيط"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[303,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[308,"هنيئا بصوم لا عداه قبول","https://www.aldiwan.net/poem59517.html","الطويل"],[311,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[320,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[326,"شياه ترجى اخضرارا الجدوب","https://www.aldiwan.net/poem55039.html","المتقارب"],[340,"نيسان يا روح القلوب","https://www.aldiwan.net/poem55318.html","مجزوء الكامل"],[340,"لموسى يد في البخل قد قيل انها","https://www.aldiwan.net/poem55371.html","البسيط"],[362,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[364,"فنزهت طرفي في طرائف حسنه","https://www.aldiwan.net/poem17128.html","الطويل"],[367,"أرى المرء يهوى أن تطول حياته","https://www.aldiwan.net/poem4288.html","الطويل"],[372,"وصل الموصول كل علا","https://www.aldiwan.net/poem4131.html","المديد"],[388,"أني أنا السائل الطلاب","https://www.aldiwan.net/poem54619.html","عموديه"],[390,"يقر بعيني أن يلم رسولها","https://www.aldiwan.net/poem53422.html","الطويل"],[393,"أجارتنا غُضي من السير أو قفي","https://www.aldiwan.net/poem596.html",""],[399,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[400,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[403,"ذكر الحمى فبكى لسجع حمامه","https://www.aldiwan.net/poem50115.html","الكامل"],[434,"سعاد اسعدي بالطيف بعد التفرق","https://www.aldiwan.net/poem2554.html","الطويل"],[436,"وفي سر من را من محلي مقاصر","https://www.aldiwan.net/poem34758.html","الطويل"],[436,"اليوم نادتك السيادة هيت لك","https://www.aldiwan.net/poem34848.html","الكامل"],[456,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[456,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[459,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[459,"يكاد الدجى يغدو صباحا مشرقا","https://www.aldiwan.net/poem15175.html","الطويل"],[475,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[475,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[480,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[512,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[536,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[549,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[556,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[560,"نعاتب حيث لا نرجو الجوابا","https://www.aldiwan.net/poem52805.html","الوافر"],[560,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[565,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[573,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[585,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَيُذهِلُها إِذا التَقَتِ العَوالي","ضِرامُ الطَعنِ عَن مَضغِ الشَكيمِ",0,"م",1,0],["وَيُذكِرُها الحُلومَ عَلى تَناسٍ","وَقَد بَلَغَت حَفائِظُها الهِياجا",1,"ج",2,0],["ويُذْكي لهُ الغَيْرانُ عَيناً إذا رأى","أَجارِعَ منْ حُزْوى بسَمْراءَ تُسْعِفُ",2,"ف",1,0],["وَيَذهَبُ بِالكِتابِ بِما أُلاقي","فَتَلثِمُهُ فَطوبى لِلكِتابِ",3,"ب",1,0],["وَيَذكُرُ أَيّاماً مَضَت مِن شَبابِهِ","وَما كانَ فيها بِالجَهالَةِ أَجرَما",4,"م",2,0],["وَيَذبُلُ زَهرُ القَريضِ الثَرِيِّ","وَيُقفِرُ رَوضَ القَوافي الغُرَر",5,"ر",1,0],["ويذيق من أشقى البلاد ببغيه","عقبى نكال كابدته مديدا",6,"د",2,0],["وَيَذْكُرُ فَرْقَداً مَنْ لا يُسَمَّى","وَبالأَفْرَادِ يَعْنِي الفَرْقَدَانِ",7,"ن",1,0],["وَيَذُودُ مَنْ جَارَاكَ عَنْ غَاياتِهِ","بِبُلُوغِهِ الْغَايَاتِ فِي الإِتْقَانِ",8,"ن",1,0],["وَيَذوبُ بِالكِتمانِ إِلّا أَنَّهُ","أَحوالُهُ تُنبي عَنِ الكِتمانِ",9,"ن",1,0],["ويذبح جفني بالدُّموع وما له","سوى الشهر بعد الشهر في البعدِ يسلخ",10,"خ",1,0],["ويذهب اللوم بي في كل ناحية","فلا يبلّغني إلا صُبابات",11,"ت",1,0],["وَيَذُمُّ عَهدَ الغانِياتِ كَناقَةٍ","بَعدَ الشِفاءِ يَذُمُّ عَهدَ سَقامِ",12,"م",1,0],["وَيُذكِرُني تَخيِيطُ كَعبِكَ شَقَّهُ","وَمَشيَكَ في ثَوبٍ مِنَ الزَيتِ عارِيا",13,"ي",2,0],["وَيَذيمُني مَن لَو ضَغَمتُ قَبيلَهُ","يَومَ الفَخارِ لَطارَ في لَهَواتي",14,"ي",1,0],["وَيُذهِلُ عَقلَهُ بِالحَربِ حَتّى","يَقومُ فَيَستَجيبُ لِغَيرِ داعِ",15,"ع",1,0],["وَيُذكِرُني الإِلفَ الَّذي هُوَ فاقِدٌ","وَيَعجِمُ شَكواهُ إِلَيَّ فَأُفصِحُ",16,"ح",1,0],["وَيُذيقُني طَعمَ المَلالِ تَدَلُّلاً","فَأَذوبُ بَينَ دَلالِهِ وَمَلالِهِ",17,"ل",2,0],["وَيُذيقُني مِنهُ عَلى وَجَلٍ","عَذباً كَطَعمِ سُلافَةِ الخَمرِ",18,"ر",1,0],["وَيُذكي وَراءَ اللَيلِ عَيناً حَديدَةً","يَنامُ بِها الدينُ اِحتِراساً وَيَسهَدُ",19,"د",1,0],["ويُذِيقُهم بَرْدَ السّلامِ مُردَّداً","عَذْباً كماءِ المُزْنِ أو هُوَ أعْذَبُ",20,"ب",1,0],["ويذكره وبالفاروقِ حِرصٌ","على أن ليس يَعدوه انتخابا",21,"ب",2,0],["وَيَذرِفُ مِن حُبِّها دَمعَهُ","وَما يَجلُبُ الحَظَّ دَمعٌ ذُرِف",22,"ف",1,0],["وَيَذكُرُ مِن شَأنِ القِرانِ شَدائِداً","وَفي أَيِّ دَهرٍ لَم تُبَتَّ القَرائِنُ",23,"ن",1,0],["وَيُذكَرُ أَنَّ في الأَيّامِ يَوماً","يَقومُ مِنَ التُرابِ مُغَيِّبوهُ",24,"ب",3,0],["وَيَذهَبُ هَذا الجيل نضو شقائه","وَيأَتي سعيداً بالسَلامة جيل",25,"ل",1,0],["ويذهبُ النُّورُ ويأتي الظلامْ","وتبزغ الأنجمُ في نسقهِ",26,"ه",1,0],["وَيَذُوبُ قَبْلَ الْبَيْنِ مِنْ شَوْقٍ إِلى","وَجْهِ الْحِمَى وَجَمَالهِ السَّحَّارِ",27,"ر",1,0],["وَيَذْكُرُ للآدَاب عَهْداً فَمَا يَني","مُعيناً لمَنْ يُعْنَى بهِنَّ وَمُنْجدَا",28,"د",2,0],["ويذيع منك البرق كامن لوعتي","فيدي على قلبي من الاشفاق",29,"ق",1,0],["وَيَذْعَرُ الأعداءُ مِنْ فَارِسٍ،","يَهُولُهُمْ إشْرَافُهُ، أوْ يَرُوعْ",30,"ع",1,0],["وَيَذكُرني أَخلاقك الغُر شَطرُهُ","وَتَحريفُهُ ضد لَكُم لَم يُكرَم",31,"م",1,0],["ويذكر في ضواحيك الروابي","زهت والورد منها طاب شما",32,"م",2,0],["ويذل الخصم في عزته","فيرى بالحال ممحوق الجسد",33,"د",1,0],["ويذكر أيام القطعية والنوى","وأيام وصل الآنسات الغرائر",34,"ر",1,0],["ويذكرني شدو الحمام وصالها","إذا رجَّعت ورقُ الحمامِ التغنيا",35,"ي",2,0],["وَيَذَهَب عَن طَرِيقِ المُصطفي مَن","بِهِ شَرُفَت ثَنِيَّاتُ الوَدَاعِ",36,"ع",1,0],["ويذكرني الأمين إذا بَدا لي","وقد مُلِّئَت بِهَيبَتِه الصُّدُورُ",37,"ر",1,1],["ويذهب عمر النوى والجفا","جُفاءً ويكفيه ما أضرما",38,"م",2,0],["ويذب عن آي الكتاب بحكمة","ويذيق من باراه فيه تبارا",39,"ر",2,0],["ويذكّر العلماء ألاّ يغمضوا","عما اقتضاه زمانهم أبصارا",39,"ر",2,0],["ويُذكِره بزلَ النجيعِ من الطُّلَى","عِضارٌ جلبنَ البابلىَّ المبرَّدا",40,"د",2,0],["وَيُذهِبُ نَقصَ البُعدِ عَنهُ وَشَينَهُ","لَحى اللَهُ وَقتاً حالَ بَيني وَبَينَهُ",41,"ه",1,0],["ويذكر ما من انعم الله عنده","فيشكر بعض الشكر أو يتادب",42,"ب",1,0],["ويذب أقوالا تبيت سواريا","منه إلى الأمراء والغلمان",43,"ن",1,0],["ويذهلُ عن نفائسِهِ بنفسٍ","تَرى الذكرَ المخلّدَ خَير مالِ",44,"ل",1,0],["ويذمّ وهو مذمّم","غيظا كأن به ندامه",45,"م",2,0],["ويذكر فضلك القمّينُ يوماً","إذا اجتمعَ المطاريحُ الجياعُ",46,"ع",1,0],["ويُذعنون ولا ما يُذعنون لهُ","لكنَّهُ خلُقٌ يقضي بإِذعانِ",47,"ن",1,0],["ويذكرنا فعلاتِ الردى","بأهلِ البوادي وأهلِ الحضرْ",48,"ر",1,0],["ويذكرنا مصرا وفاضل عصرها","رعى الله ذاك السفح والناس والعصرا",49,"ر",2,0],["ويذكر قلبي حسْن وجهك إن رأى","شبيهك في إشراقك الشمس والبدرا",50,"ر",2,0],["وَيُذِلَّني خَطبٌ وَعِزُّكَ قاهِرٌ","وَيُكاظَني ظَمَأٌ وَبَحرُكَ قَد طَما",51,"م",2,0],["وَيُذْهِبُ إِظْلاَمَ الْفُؤَادِ صَبَاحُهُ","كَمَا أَذْهَبَتْ لَيْلَ الْهَوَى سُرُجُ الْقِسْطِ",52,"ط",1,0],["وَيَذُمُّ مَنْ نَبَذَ الْعُهُودَ وَحَادَ عَنْ","سَنَنِ الْعُلاَ إِنِّي إِذَنْ لَخَسِيسُ",53,"س",1,0],["ويذهب الكلُّ حزناً كان أو فرجاً","فارض القضاء وسلّم غير منزعج",54,"ج",1,0],["ويذوي جمالٌ في الشبابِ ويَنطوي","وَيهوي جلالٌ كادَ في الأرضِ يُعبد",55,"د",1,0],["وَيذكر في التَهليل مَع ذكر ربه","وان قيل في التأذين أَشهد أَشهَد",56,"د",1,0],["وَيذْكِرُكمَ الأَحْبابَ فِيهِ بَدائِعٌ","مِنَ النَّوْرِ مِنْها نَرْجِسٌ وَبَنَفْسَجُ",57,"ج",1,0],["ويذكو عرْفُهُ في ثغْ","رِها ما رُدّد والقعس",58,"س",1,0],["ويذهب العمر سدى ضائعاً","كأنه الطيف بحين المنام",59,"م",1,0],["ويذهب الهجر والبعاد","والبؤس والمضره",60,"ه",1,0],["ويذكر كم المولى اشكروا نعماته","يزدكم ويهد الخلق في حال شكران",61,"ن",1,0],["وَيَذكرونكَ في بدءٍ وعاقبةٍ","مِن مستفزّينَ مرجوٍّ ومحذورِ",62,"ر",1,0],["ويذهب بي ما بين يأس ومطمع","زمان بنيل المعلوات بخيل",63,"ل",1,0],["ويذهل عما كان فيه من الأذى","وتبدو لنا منه مخايل طربة",64,"ه",1,0],["وَيَذُد عَنهُمُ الخَلالَةَ مِنهُ","بِسِجالٍ تَغدو أَمامَ سِجالِ",65,"ل",1,0],["ويذرى المدامع هتّانة","فيرمض بالنار قلب الفلاه",66,"ا",2,0],["ويذوب في خمر الندا","ء وينتشي مما يذوب",67,"ب",1,0],["ويذهلني فيه تخيل نفسه","غنياً ولا لون لهذا ولا شكل",68,"ل",1,0],["ويَذكُرُ فَرْخَيهِ ببَيْداءَ بَلْقَعٍ","تَشُق على مَن جابَها وتَطول",69,"ل",1,0],["ويَذْكرني منسيُّه أو مُضاعُه","وفي ضِمنها غَيثٌ بحيثُ يَصول",69,"ل",1,0],["ويَذهَبُ العُمْرُ وماذا يُرتَجى","من ذَهَبٍ يأتي إذا العُمْرُ ذَهَب",70,"ب",1,0],["وَيُذكِرُني صَبري بِرِقَّةِ خَصرِهِ","وَيُذكِرُني عَزمي بِفَترَةِ جَفنِهِ",71,"ن",2,0],["ويُذكرُني مرُّ النسيم ورَوحُه","حفائرَ تلعوها من الترب أطباق",72,"ق",1,0],["وَيذوق الموتَ من كمدٍ","كلَّما حازيتَ منزلَه",73,"ل",2,0],["ويذهب الشوش والاشجان","والهم والغم والكرب",74,"ب",1,0],["وَيَذكرَ لي دونَ الرِجال حَديثَها","وَيَنشُرَ عِندي نطقَها وَكَلامَها",75,"ه",2,0],["ويَذعَرُ سرب الحيّ وسواسُ حليها","إذا حركته من دعاثٍ ورفرفِ",76,"ف",1,0],["ويُذْري لتذْكار الغُوَيْر مدامِعاً","تكفَّل عَنْ أيدي الغمامِ بِسقْياهُ",77,"ه",1,0],["ويذكرُ نَعْمانَ الأَراك فينتشي","بعاثِر رَيَّاه فكيفَ برُؤْياهُ",77,"ه",1,0],["ويذهب التوهيم عن أفكاري","مؤتلفاً بأهلي الأخيار",78,"ر",1,0],["وَيَذُمُّ صَفوَ حَياتِهِ من لَم يَبِت","مِستَعصياً بِوَلائِهِ وَذِمامِهِ",79,"م",2,0],["ويذكر إن لاح برق لياليا","حمدت بها عيشى ببصري وجلّق",80,"ق",1,0],["ويُذْهِلُني عن سِحْرِ ما في جُفُونِها","بتُفَّاحِ سَواحِرُ",81,"ر",1,0],["ويذودُ عن أجفانِهِ سِنَةَ الكَرى","كَيْ لا يُرِيهِ الحُلْمُ أن يَتَأَوَّلَكْ",82,"ك",1,0],["ويُذِمُّ فيك بألفِ يومٍ مثلهِ","في العزّ يشهدُ عامُها بالقابلِ",83,"ل",1,0],["ويُذهله وجهُك المستنيرُ","عليه ومجلسُك المونِقُ",84,"ق",1,0],["ويذودُ عنه مُسدَّدٌ في قصده","يهدي الصوار له بغير تلوُّمِ",85,"م",1,0],["ويذْكو نسيم الجوِّ عند مديحهِ","كأن بأعلى لُوحِه نشرَ عنبرِ",86,"ر",1,0],["ويُذْكِرُه البانُ القدودَ إذا انثنتْ","تَرنَّحُ مِن مَرَّ النَّسيمِ موائلُه",87,"ل",2,0],["ويُذكِرُه طيفُ الخيالِ ازديارَهٌ","اِذا نابَ عن طيبِ الوصالِ كتابُهُ",88,"ب",2,0],["ويذكر هذا عن مناقبهم فأي","ن من هم أسود الحق أهل اشمائل",89,"ل",1,0],["ويذكُرُ ذُهلاً والهوى حيثُ عامرٌ","ومنزلَ حُزْوى والمُرادُ زَرودُ",90,"د",1,0],["ويذهبُ طرفي في تعقُّب خَطوِه","وإن كنتُ في شُغلٍ فيا ضَيعةَ الشُّغلِ",91,"ل",1,0],["ويذودنِي وبِيَ الصّدى عن عَذْبِهِ","فإذا سَقاك سَقاك كلَّ أجاجِ",92,"ج",1,0],["ويذوب المحب فيه ويفنى","كلما لاح كاشفاً أردانه",93,"ن",2,0],["ويذْهبُ من نُريدُ لهُ بَقاءً","ويَبقَى مَن نُريدُ لهُ ذَهابا",94,"ب",2,0],["ويَذخرُ بيضَ الهِندِ وهْيَ كنوزُهُ","وتَهلِكُ معهُ بينَ نحرٍ وعاتقِ",95,"ق",1,0],["وَيَذُبُّ عَنْ أعراضِهِ","ويَشُتَّ للطُّرَّاقِ نَارَهْ",96,"ر",2,0],["وَيُذيقُ عاصيَة العذابَ لأَنَّه","للخلقِ عَادَى أَو عَلى الخلقِ اعْتَدَى",97,"د",2,0],["ويذكر ربه سراً وجهراً","ويدمن ذكره في كل حال",98,"ل",1,0]]}