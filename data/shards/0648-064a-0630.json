{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[55,"إذا هجر المحب بكى وأبدى","https://www.aldiwan.net/poem26538.html","الوافر"],[57,"ولما قسا قلبي وضاقت مذاهبي","https://www.aldiwan.net/poem24634.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[93,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[47,"الحر يصبر ما أطاق تصبرا","https://www.aldiwan.net/poem25117.html","الكامل"],[72,"أخط سؤالي بالرقاع ولا أرى","https://www.aldiwan.net/poem18535.html","الطويل"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[85,"شغلته أشغال عن الآرام","https://www.aldiwan.net/poem63013.html","الكامل"],[43,"أريك الرضا لو أخفت النفس خافيا","https://www.aldiwan.net/poem10605.html","الطويل"],[45,"أحبب إلي بطيف سعدى الآتي","https://www.aldiwan.net/poem62643.html","الكامل"],[58,"ألم تعلم أبا سمعان أنا","https://www.aldiwan.net/poem30964.html","الوافر"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[31,"أطوي الضمير على حرارته","https://www.aldiwan.net/poem42495.html","الكامل"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[105,"هو وفدهم وهم الفريق الطيب","https://www.aldiwan.net/poem44002.html","الكامل"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[46,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[46,"أدين برب واحد وتجنب","https://www.aldiwan.net/poem23440.html","الطويل"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[45,"كَلّفَني، فَوْقَ الذي أسْتَطيعْ","https://www.poetsgate.com/ViewPoem.aspx?id=31119",""]],"verses":[["وَيُذهِلُها إِذا التَقَتِ العَوالي","ضِرامُ الطَعنِ عَن مَضغِ الشَكيمِ",0,"م",1,0],["وَيُذكِرُها الحُلومَ عَلى تَناسٍ","وَقَد بَلَغَت حَفائِظُها الهِياجا",1,"ج",2,0],["ويُذْكي لهُ الغَيْرانُ عَيناً إذا رأى","أَجارِعَ منْ حُزْوى بسَمْراءَ تُسْعِفُ",2,"ف",1,0],["وَيَذهَبُ بِالكِتابِ بِما أُلاقي","فَتَلثِمُهُ فَطوبى لِلكِتابِ",3,"ب",1,0],["وَيَذكُرُ أَيّاماً مَضَت مِن شَبابِهِ","وَما كانَ فيها بِالجَهالَةِ أَجرَما",4,"م",2,0],["وَيَذبُلُ زَهرُ القَريضِ الثَرِيِّ","وَيُقفِرُ رَوضَ القَوافي الغُرَر",5,"ر",1,0],["ويذيق من أشقى البلاد ببغيه","عقبى نكال كابدته مديدا",6,"د",2,0],["وَيَذْكُرُ فَرْقَداً مَنْ لا يُسَمَّى","وَبالأَفْرَادِ يَعْنِي الفَرْقَدَانِ",7,"ن",1,0],["وَيَذُودُ مَنْ جَارَاكَ عَنْ غَاياتِهِ","بِبُلُوغِهِ الْغَايَاتِ فِي الإِتْقَانِ",8,"ن",1,0],["وَيَذوبُ بِالكِتمانِ إِلّا أَنَّهُ","أَحوالُهُ تُنبي عَنِ الكِتمانِ",9,"ن",1,0],["ويذبح جفني بالدُّموع وما له","سوى الشهر بعد الشهر في البعدِ يسلخ",10,"خ",1,0],["ويذهب اللوم بي في كل ناحية","فلا يبلّغني إلا صُبابات",11,"ت",1,0],["وَيَذُمُّ عَهدَ الغانِياتِ كَناقَةٍ","بَعدَ الشِفاءِ يَذُمُّ عَهدَ سَقامِ",12,"م",1,0],["وَيُذكِرُني تَخيِيطُ كَعبِكَ شَقَّهُ","وَمَشيَكَ في ثَوبٍ مِنَ الزَيتِ عارِيا",13,"ي",2,0],["وَيَذيمُني مَن لَو ضَغَمتُ قَبيلَهُ","يَومَ الفَخارِ لَطارَ في لَهَواتي",14,"ي",1,0],["وَيُذهِلُ عَقلَهُ بِالحَربِ حَتّى","يَقومُ فَيَستَجيبُ لِغَيرِ داعِ",15,"ع",1,0],["وَيُذكِرُني الإِلفَ الَّذي هُوَ فاقِدٌ","وَيَعجِمُ شَكواهُ إِلَيَّ فَأُفصِحُ",16,"ح",1,0],["وَيُذيقُني طَعمَ المَلالِ تَدَلُّلاً","فَأَذوبُ بَينَ دَلالِهِ وَمَلالِهِ",17,"ل",2,0],["وَيُذيقُني مِنهُ عَلى وَجَلٍ","عَذباً كَطَعمِ سُلافَةِ الخَمرِ",18,"ر",1,0],["وَيُذكي وَراءَ اللَيلِ عَيناً حَديدَةً","يَنامُ بِها الدينُ اِحتِراساً وَيَسهَدُ",19,"د",1,0],["ويُذِيقُهم بَرْدَ السّلامِ مُردَّداً","عَذْباً كماءِ المُزْنِ أو هُوَ أعْذَبُ",20,"ب",1,0],["ويذكره وبالفاروقِ حِرصٌ","على أن ليس يَعدوه انتخابا",21,"ب",2,0],["وَيَذرِفُ مِن حُبِّها دَمعَهُ","وَما يَجلُبُ الحَظَّ دَمعٌ ذُرِف",22,"ف",1,0],["وَيَذكُرُ مِن شَأنِ القِرانِ شَدائِداً","وَفي أَيِّ دَهرٍ لَم تُبَتَّ القَرائِنُ",23,"ن",1,0],["وَيُذكَرُ أَنَّ في الأَيّامِ يَوماً","يَقومُ مِنَ التُرابِ مُغَيِّبوهُ",24,"ب",3,0],["وَيَذهَبُ هَذا الجيل نضو شقائه","وَيأَتي سعيداً بالسَلامة جيل",25,"ل",1,0],["ويذهبُ النُّورُ ويأتي الظلامْ","وتبزغ الأنجمُ في نسقهِ",26,"ه",1,0],["وَيَذُوبُ قَبْلَ الْبَيْنِ مِنْ شَوْقٍ إِلى","وَجْهِ الْحِمَى وَجَمَالهِ السَّحَّارِ",27,"ر",1,0],["وَيَذْكُرُ للآدَاب عَهْداً فَمَا يَني","مُعيناً لمَنْ يُعْنَى بهِنَّ وَمُنْجدَا",28,"د",2,0],["ويذيع منك البرق كامن لوعتي","فيدي على قلبي من الاشفاق",29,"ق",1,0],["وَيَذْعَرُ الأعداءُ مِنْ فَارِسٍ،","يَهُولُهُمْ إشْرَافُهُ، أوْ يَرُوعْ",30,"ع",1,0]]}