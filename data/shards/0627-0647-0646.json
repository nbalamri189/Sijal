tabudhabi.ae/diwan/poem/20885","الكامل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107041","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45107","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94443","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72799","الطويل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107126","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113833","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139585",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52158","الطويل"],[4706,"شهيد القسطل","https://www.poetsgate.com/ViewPoem.aspx?id=34368",""],[4814,"ليل الصامتين","https://www.poetsgate.com/ViewPoem.aspx?id=193676",""],[4858,"رثاء الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=157954",""],[4912,"أهنيك بل نفسي أهني بما سنى","https://www.poetsgate.com/ViewPoem.aspx?id=181788",""],[4935,"أهني أبا الباقي المدفق جوده","https://www.poetsgate.com/ViewPoem.aspx?id=129380",""],[4978,"تحية لأستاذتي نادية بوغرارة","https://www.poetsgate.com/ViewPoem.aspx?id=189774",""],[5122,"أهني إنسان\"","https://www.poetsgate.com/ViewPoem.aspx?id=33177",""],[5122,"(غني الاوأدم ما تكفل أبمفلسها)","https://www.poetsgate.com/ViewPoem.aspx?id=34736",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5275,"صرخة من بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=35276",""],[5277,"رسالةٌ إلى روحي","https://www.poetsgate.com/ViewPoem.aspx?id=194241",""],[5277,"كل فطر، تُقُبِّلَ منا ومنكم...","https://www.poetsgate.com/ViewPoem.aspx?id=213006",""],[5324,"رثاء والدي (رحمه الله)","https://www.poetsgate.com/ViewPoem.aspx?id=211105",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5362,"أهنيك بالعيد أم بالظفر","https://www.poetsgate.com/ViewPoem.aspx?id=170387",""],[5431,"القلب الوطن ...قصيدة سوريالية","https://www.poetsgate.com/ViewPoem.aspx?id=202071",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5596,"آه نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=206780",""],[5677,"عيد ميلادك","https://www.poetsgate.com/ViewPoem.aspx?id=179848",""],[959,"وترتاح عطفاها فأحسب أنها","https://www.poetsgate.com/ViewPoem.aspx?id=133738",""],[402,"أيها النائمون في الشرق من خفض","https://www.poetsgate.com/ViewPoem.aspx?id=36256",""],[5804,"الحب والغيب","https://www.poetsgate.com/ViewPoem.aspx?id=190654",""],[5858,"إنزعاج مغترب من تهاني العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189726",""],[5956,"أهنىء مملكتي بذكاكم","https://www.poetsgate.com/ViewPoem.aspx?id=194564",""],[5956,"العطاءُ الصَّافي","https://www.poetsgate.com/ViewPoem.aspx?id=194638",""],[5986,"أيا بدر المعارف والمعالي","https://www.poetsgate.com/ViewPoem.aspx?id=162953",""],[6019,"رحيقُ الوفاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=120903",""],[4661,"إيابك يا مولاي والله شاهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57075&r=&rc=14",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[6260,"نجوى المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68315&r=&rc=7",""]],"verses":[["أُهَنّيكَ بِالعيدِ الجَديدِ تَعِلَّةً","وَغَيرُكَ بِالأَعيادِ وَاللَهوِ يُعجَبُ",0,"ب",1,0],["أُهَنِّيكَ أَمْ نَفْسِي بِهَذَا أَخُصُّهَا","بَدْياً فَمَا الْبُشْرَى لَدَيْكَ بِأَعْظَمِ",1,"م",1,0],["أُهنِّيكَ أَمْ تُهْنَى الْوَزَارَةُ إِنَّهَا","أَنَافَ عَلَيْهَا مِنْكَ كَافٍ وَكَافٍلُ",2,"ل",1,0],["أَهَنّا لَها أَموالَنا عِندَ حَقِّها","وَعَزَّت بِها أَعراضُنا لا نُفاتُها",3,"ت",3,0],["أُهَنّي الثَرى أَم أُعَزّي الوَرى","لَقَد فازَ هَذا وَهَذا خَسِر",4,"ر",1,0],["أَهُناكَ في المِرّيخِ ما","في الأَرضِ مِن عِلَلِ الشِجار",5,"ر",1,0],["أَهُناكَ يَستَعدي الضَعي","فُ عَلى القَوِيِّ فَلا يُجار",5,"ر",1,0],["أَهَنّيكَ أَم أَشكو فِراقَكَ قائِلاً","أَيا لَيتَني كُنتُ السَجينَ المُصَفَّدا",6,"د",2,1],["إِهْنَأْ بِمَا أَهْدَى المَلِيكُ","إِلَيْكَ مِنْ سَامِي اللَّقَبْ",7,"ب",1,1],["إِهْنَأْ بِمَا نِلْتَهُ","مِنْ نِعْمَةٍ تُرْتَقَبْ",8,"ب",1,0],["أهنأوا ناعمين غاية ما طا","ب نعيم وما زكا إنعام",9,"م",1,0],["أُهَنِئُهُ بِمَنْصِبِهِ وَأَرْجُو لَهُ","فِي الخَيْرِ تَوْفِيقاً يَدُومُ",10,"م",1,0],["اهْنَأُوا بِالنَّعِيمِ غَايَةَ مَا طَا","بَ وَفِيهِ لآمِنٍ إِنْعَامُ",11,"م",1,0],["اهَنْأْ بِمَنْ أُويِتَهَا","مِنْ فَضْلِ ذِي الفَضْلِ الجَّزِيلْ",12,"ل",1,0],["أهنّيك بالإبلال ممن شفاؤه","شفاؤك فاشكر من تلافي وقدَس",13,"س",1,0],["أَهِن لِلَّذي تَهوى التِلادَ فَإِنَّهُ","إِذا مُتَّ كانَ المالُ نَهباً مُقَسَّما",14,"م",2,0],["أهنيكَ بالعيدِ السعيدِ قدومه","وأشكر برًّا أنتَ من قبلُ واهبه",15,"ه",1,1],["أهنأُ العرفِ ما أتى من خليلٍ","يحسبُ القرضَ للأخلاءِ فرضا",16,"ض",2,1],["أهنَّ أدوم طحناً","أم شفر أختك سحقا",17,"ق",2,0],["أُهنِّئ الفطر بوجهِ الإمامِ","أليس قد عاينَ بدرَ الأنامِ",18,"م",1,1],["أهنتني جداً فأعززتني","رُبَّ امرىءٍ عَزَّ بأن هانا",19,"ن",2,0],["إِهنأ فَقَد نِلتَ الَّذي تَشتَهي","نَفسُكَ وَاشكُر نِعَم الباري",20,"ر",2,0],["أهناك جيش لا أبا","لك حذوه جيش محارب",21,"ب",1,0],["أهنتُ عزيز الصبر فيك وخانني","إباء وفىٌّ في الخطوب وفير",22,"ر",1,0],["أُهنِّئُ مولانا بأيمنِ قادمٍ","تَقَيَّلَ في الإحسانِ أفعالَهُ الزُّهْرا",23,"ر",2,1],["أَهُنَّ عَوادي يوسُفٍ وَصَواحِبُه","فَعَزماً فَقِدماً أَدرَكَ السُؤلَ طالِبُه",24,"ب",2,1],["أُهَنِّيكَ بِالْمُلْكِ الَّذِي طَالَ جِيدُهُ","بِعِزِّكَ حَتَّى حَلَّ بَيْتَ النَّعَائِمِ",25,"م",1,0],["اهْنَأْ بدعوتِهِ فتِلكَ وقايةٌ","من كلِّ ذِي جَبرِيَّةٍ يتنَّمرُ",26,"ر",1,0],["إهنأ أبا بكرٍ قَضيتَ بحُجَّةٍ","صَدَع اليقينُ بها وأنتَ مُتَرْجِم",27,"م",1,0],["اهنأ بها حُلَلاً حملت حِسانَها","نُوراً على نُورٍ يُضيءُ وَيَسْطَعُ",28,"ع",1,0],["أَهَنتُ فيها سَخَطَ اللَواحِ","أُكابِرُ الأَصواتَ بِالأَقداحِ",29,"ح",1,0],["أُهنّيكَ بالفتْحِ الذي أنا ناظِرٌ","إليه بعَينٍ ليسَ يُغمِضُها الكفْر",30,"ر",1,0],["أَهُناك من نفس المساوم مانع","أَم حيل بين العير وَالنزوان",31,"ن",1,0],["أَهُناكَ جسم فارقته روحه","للموت أَم روح بلا جثمان",32,"ن",1,0],["أهناءَ الساعات تجري وتعدو","نا عطاشاً فقفْ بنا جريانكْ",33,"ك",1,0],["أَهَنْتُ لِلْحُبِّ نَفْسِي بَعْدَ عِزَّتِهَا","وَأَيُّ ذِي عِزَّةٍ لِلْحُبِّ لا يَهِنُ",34,"ن",1,0],["إِهْنَأْ بِثَوْبٍ لِلْخُلُودِ لَبِسْتَهُ","وَالبَسْ جَدِيداً مَا حَيِيتَ وَأَخْلِقِ",35,"ق",1,0],["إِهْنَأْ بخَيْر قَرينَةٍ","يَا زَيْنَ فِتْيَانِ الْبَلَدْ",36,"د",1,1],["إِهْنَأْ بِمَنْ أُوتِيتَهَا","مِنْ فَضْلِ ذِي الفَضْلِ الجَزْيلِ",37,"ل",1,0],["إِهنَأْ بِرُتْبَتِكَ العُلْيَا وَيَهْنِئُهَا","مَا أَحْرَزَتْ بِكَ مِنْ جَاهٍ وَمِنْ شَرَف",38,"ف",1,1],["أُهَنِّيءُ مِيشِيلَ الْعَزِيزَ وَآلَهُ","أُهَنِّيءُ أَزْكَى غَادَةٍ طِيبِ مُحْتَدِ",39,"د",1,0],["أهْنِئ بيومك، يا «محمد»، إنه","يوم تَضنُّ بمثلهِ الأعمَار",40,"ر",1,0],["أهُنا ينامُ فتىً يُهابُ ويرتَجَى","أهُنا يعاف فَتىً يَضرُّ وينفَع",41,"ع",1,0],["أهنيهة قطع الضحى أم جيلا","يوم العفاة لقد خلقت طويلا",42,"ل",2,1],["أُهنِّىء الفطر بوجهِ الإمام","أليس قد عاينَ بدرَ الأنام",43,"م",1,1],["اهنئي يا حضرةَ القُدسِ فَقَد","رُحتِ في ثوبِ البَهاءِ المُعجِبِ",44,"ب",1,0],["أُهَنِّيك يا ابن الأكرمين الأطايب","ونجلَ الملوك الشُّمِّ أهلِ الرغايبِ",45,"ب",1,1],["اهنأ أميرَ المؤمنينَ بأنجمٍ","منها تقابِلُ في المطالِعِ أسعدا",46,"د",2,0],["اهنأ إمامَ الهُدى فالعدلُ منبسطٌ","والدينُ منتظمٌ والكفرُ أشتاتُ",47,"ت",1,0],["أهنيك لكنني أخجلُ","لأنك مهما علَت أفضلُ",48,"ل",1,1],["أَهَنتَ ما لَو أَهانوهُ لَما حَمَلوا","عَلى المَفارِقِ ياقوتاً وَعِقيانا",49,"ن",2,0],["أَهُناكَ اِقتَرَفتَ ذَنباً فجوزي","تَ بِنَفيٍ في عالَمِ الإَضطهادِ",50,"د",1,0],["أهنّيك بالعيدِ الذي أنت عِيدُه","ونورُ سنا إِقبالِهِ حين يَسْطع",51,"ع",1,0],["أُهنّيك لا أَعني سواك بأَوبة","كأنك عِقْد وهْيَ من تحته نَحْرُ",52,"ر",1,0],["أَهَنْتُ أَكُفَّ الْكَفِّ لَمَّا مُدِدْنَ لِي","فَأَعْقَبَنِي مِنْهَا هَوَانٌ وَإِذْلاَلُ",53,"ل",1,0],["أهنّيك بل نفسي أهنّي لأنّني","بلقياك قد زال الجوى من جوانحي",54,"ح",2,0],["اِهنأ بِمَولدهِ المُفضي لمحتنه","وعرسهِ ولأحفادٍ حَموا كَنفه",55,"ف",2,0],["أهنّيكَ بالعيدِ الّذي أَنتَ عيدهُ","يطوّقُ مِن علياكَ بالفخرِ جيدهُ",56,"ه",1,1],["إِهنَأ نَجيبَ بِنَجلٍ جادَ مَطلَعُهُ","في طالِعِ السَعدِ مَقروناً بِبُرجٍ عَلاكَ",57,"ك",1,1],["أَهنَأ بِعامٍ قَد أَتاكَ مُبارِكاً","وَمُباشِراً بِسَعادَةٍ لا تَعبُدُ",58,"د",1,1],["أُهَنّيكَ بِالعَلياءِ تَصحَبُها المُنى","وَاِمنَحكَ البُشرى فَعِزُّكَ دائِمُ",59,"م",1,0],["اِهنَأ بِعامٍ قَد أَتاكَ","مُبارَكاً في رَوضِهِ طَيرَ السُرورِ يُغَنّي",60,"ي",1,0],["آه نفسي إلى متى أتألم","وإلام العذابُ بي يتحكم",61,"م",1,1],["أهنّئهُ كَما هَنّأت نَفسي","بِما قَد حازَ مِن نَيل الأَماني",62,"ن",2,0],["أُهنِّئُ النّاسَ فيه مُظهِراً فَرَحاً","واللهُ يَعلَمُ ما أُخْفي من الأَسَف",63,"ف",1,0],["أهنّيكِ في من جاءنا بكِ مُدرَكاً","هو اللَهُ حقّاً فوق كل المدارك",64,"ك",1,0],["أهنت الجزءَ منها فهو كلٌّ","وذم الكلِّ في جزءٍ مزيد",65,"د",1,0],["أَهنا المَسَرّاتِ ما جاءَت مفاجأَةً","وَما تَناجَت بها الأَلفاظُ وَالفِكرُ",66,"ر",1,0],["أَهَنَّا إِذْ دُفِنْتَ عقودَ دمعٍ","مخبّأةً لِغيركَ لا تَهونُ",67,"ن",1,0],["أهنيك بالعام الجديد وإنما","أهني بك العام الجديد على عمد",68,"د",1,1],["أُهنِّيك بالعيد يا عيدَنا","فأَنتَ الهناءُ لنا الأَعظم",69,"م",1,0],["أهنِّيكَ فيه مَنصِباً أنت فوقَه","بمرتبة لو أنصفتك المراتبُ",70,"ب",1,0],["اِهْنَأْ أَبا الحَسَن السّامي بخير فَتًى","مُحَسَّنٍ لم يَدَعْ من مَنْظَرٍ بَهَجَ",71,"ج",1,0],["اِهْنَأْ بعُرْسٍ قد غدا يُوْمُهُ","عيداً لأَهلِ الغَوْرِ والنَّجْدِ",72,"د",1,0],["اِهْنَاْ بذا العَشْر المُعَظَّمِ قَدْرُه","واعلَمْ بأَنك أَنتَ منه العاشِرُ",73,"ر",1,0],["اهْنَ عاماً وبعدَه ألفُ عامٍ","كلّها ناضِرُ المُحيّا أنيقُ",74,"ق",1,0],["إهنأ بخيرِ قرينة ميمونة","قد سُرْبِلَتْ بردَ المَفاخِرِ والتُقى",75,"ق",2,0],["اهنأ فدَتْكَ النفسُ بالمحرَّمِ","وابقَ سعيدَ الجدِّ فرداً أو دُمِ",76,"م",1,0],["اهنأ بعيدٍ قد حكاكَ فضيلةً","لا بل تجِلُّ إذاً عن النُظَراءِ",77,"ا",2,0],["اهنأ بعيدٍ أنت معنى لفظِه","فيكَ اكتَسى مُستَحْسَناتِ صِفاتِه",78,"ت",2,0],["أُهَنِّيكُما مَا يَهْنِئُ الدِّينَ مِنكُما","هدىً ونَدىً فلْيَسْلَمِ الدِّينُ واسْلَما",79,"م",2,1],["أهنِّيكَ يَا عِيدَ الرَّغائِبِ عيدا","تَلَقَّاكَ بِاسمٍ صادقٍ لِتَعُودَا",80,"د",2,1],["أهنتُ في أبياتهم كرائما","لو أُنكحتْ أكفاءَها لم تَهُنِ",81,"ن",1,0],["أهنتُ شعريَ أبغي الرزق من نفرٍ","تسبيحُ أسمحِهم 