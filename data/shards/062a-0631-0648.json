et/poem36913.html","الطويل"],[479,"دع الأيام تخطي أو تصيب","https://www.aldiwan.net/poem37044.html","الوافر"],[479,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[495,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[500,"ما قول هند إذا ما صدها القدر","https://www.aldiwan.net/poem37697.html","البسيط"],[500,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[500,"دع طيش نفسك لا تسمع دعاويها","https://www.aldiwan.net/poem37716.html","البسيط"],[500,"ماذا تريد سليمى من خلي يد","https://www.aldiwan.net/poem37737.html","البسيط"],[500,"يا عليل القلب ما أغفلكا","https://www.aldiwan.net/poem37931.html","الرمل"],[514,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[514,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[515,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[515,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[529,"لك الويل لا فاجر تتقى","https://www.aldiwan.net/poem37075.html","المتقارب"],[529,"تروم نفسي أن يدوم الوصال","https://www.aldiwan.net/poem37265.html","السريع"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"في بذلة النوم قد تبدى","https://www.aldiwan.net/poem48249.html","عموديه"],[551,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[551,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[551,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[551,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[562,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[566,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[567,"أبى الدهر إلا فعالا خسيسا","https://www.aldiwan.net/poem69635.html","المتقارب"],[575,"لقد ذهبت نفسي وقد صفرت يدي","https://www.aldiwan.net/poem2970.html","الطويل"]],"verses":[["تَرومُ رَدَّ نُفوسٍ بَعدَ طَيرَتِها","عَلى قَوادِمَ مِن وَجدٍ وَمِن حَزَنِ",0,"ن",1,0],["تَرومُ العِدا أَن تُستَلانَ حَميَّتي","وَقَبلَهُمُ أَعدى عَلَيَّ حِرانُها",1,"ن",3,0],["تَرَوُّحَ السِربِ عَنِ ال","وِردِ إِذا اللَيلُ دَنا",2,"ن",2,0],["تَروقينَ أَسماعَنا في النَشيدِ","كَأَنَّكِ مِن كُلِّ لَفظٍ نَغَم",3,"م",1,0],["تَرومُ اِبتِزازِيَ فَضلي وَذاكَ","إِذاً فَكُّ أَطواقِ وُرقِ الحَمامِ",4,"م",1,0],["تَرَوَّقَ ماءُ الوُدِّ بَيني وَبَينَهُ","وَطاحَ القَذى عَن سَلسَلِ الطَعمِ رائِقِ",5,"ق",1,0],["تَروعُ جَنانَ اللَيثِ إِن لَم تَذُمَّهُ","وَتَطعَنُ في الأَقرانِ إِن لَم تُعانِقِ",6,"ق",1,0],["تَروحُ لَهُم حُمرُ الهَوادي كَأَنَّها","قَواني عُروقِ العَندَمِ المُتَوَرِّدِ",7,"د",1,0],["تَروي مَناقِبَ فَضلِها أَعداؤُها","أَبَداً وَتُسنِدُهُ إِلى أَضدادِها",8,"د",3,0],["تَرودُ طَلاً أَودَت بِهِ غَفَلاتُها","وَفي كُلِّ حَيٌّ لِلمَنونِ نَصيبُ",9,"ب",1,0],["تَروعينَ أَوقاتَهُ بِالصُدودِ","وَتَرمينَ أَيّامَهُ بِالسِبابِ",10,"ب",1,0],["تَرودُ تَحْتَ ظِلالِ السُّمْرِ عِنْدَهُمُ","مَلْبُونَةٌ تَطأُ الهاماتِ أَفْلاقَا",11,"ق",2,0],["تَروضُ مَصاعيبَ الأمورِ وتَمْتَطي","غَوارِبَ منْ دَهْرٍ أبى أن يُخَطّما",12,"م",2,0],["تَرودُ بأبوابِ القِبابِ وأهلُها","عليها بألْبانِ القَلائِصِ عُكَّفُ",13,"ف",1,0],["تَرودُ مَصابَ المُزْنِ أنّى تَلَوَّمَتْ","وتُنكِرُ أفلاقَ الحَصَى ثَفَناتُها",14,"ت",3,0],["تُرَوِّي غَليلَ المُرْهَفاتِ يَمينُهُ","إذا التَثَمَتْ في الرَّوْعِ بالنَّقْعِ فُرسانُ",15,"ن",1,0],["تَرْوي الْعَوَالِي فِي الْمَعَالِي عَنْهُمُ","أَثَرَ النَّدَى الْمَوْلُودِ وَالْمَكْسُوبِ",16,"ب",1,0],["تَرَوَّحتَ مِن رُزداقَ جيٍّ عَشيَّةً","وَغادَرتَ في رُزداقِ جيٍّ أَخاً لَكا",17,"ك",2,1],["تَروحُ جيادُهُ مِثلَ السَعالي","حَوافِرُهُنَّ تَهتَضِمُ السِلاما",18,"م",2,0],["تَروحُ أَميراً في البِلادِ مُحَكَّماً","وَتَغدو شَفيعاً في الذُنوبِ مُشَفَّعا",19,"ع",2,0],["تَروحُ كَأَنَّها مِمّا أَصابَت","مُعَلَّقَةٌ بِأَحقَيها الدُلِيُّ",20,"ي",1,0],["تَروحُ مِنَ الحَيِّ أَم تَبتَكِر","وَماذا عَلَيكَ بِأَن تَنتَظِر",21,"ر",1,0],["تَروحُ إِذا راحَت رَواحَ جَهامَةٍ","بِإِثرِ جَهامٍ رائِحٍ مُتَفَرِّقِ",22,"ق",1,0],["تَرَوَّحَ مِن أَرضٍ لِأَرضٍ نَطِيَّةٍ","لِذِكرَةِ قَيضٍ حَولَ بَيضٍ مُفَلَّقِ",22,"ق",1,0],["تَروكٌ لِسِقطِ القَولِ لا يُهتَدى بِهِ","وَلا هِيَ تُستَوصى الحَديثَ المُكَتَّما",23,"م",2,0],["تَروعُ بِأَكنافِ الأَفاهيدِ عيرُها","نَعماً وَحُقباً بِالفَدافِدِ صُيَّما",23,"م",2,0],["تَرُوقُ عُيونَ اللائي لايَطمَعونَها","وَيروى بِرَيّاها الَجيعُ المُكافِحُ",24,"ح",1,0],["تُروي سِنانَ الرُمحِ طَعنَتُهُ","وَالخَيلُ قَد خاضَت دَماً يَجري",25,"ي",1,0],["تَرَوَّ مِنْ مَائِهَا الجَارِي وَأَصْغِ إِلَى","حَدِيثِهِ بِأَفَانِينٍ مِنَ اللَّسَنِ",26,"ن",1,0],["تَروحُ عَلَيها هَجمَةٌ مَرتَعُ المَها","مَراتِقُها وَالقَيظُ لَم يَتَجَرَّمِ",27,"م",1,0],["تَرَوَّحنَ فَاعصَوصَبنَ حَتَّى وَرَدنَهُ","وَلَم يَلفِظِ الغَرثَى الخُدارِيَّةَ الوَكرُ",28,"ر",1,0],["تروقك فيه للبدور مطالعٌ","إذا مثلَتْ في ساحتيه الأماثلُ",29,"ل",1,0],["تروم جواري الشُّهب شأوّكَ في العُلا","ومن دونه للنَّيِّرات مراحلُ",29,"ل",1,0],["ترودون أهل العلم مرعىً ومنزلاً","وتجتنبون الهزل في معرض الجد",30,"د",1,0],["تروق الناظرين بجانبيه","مناظر دونها العجب العجيب",31,"ب",1,0],["تروح سهام العيش فيها طوائشاً","وللموت سهم لا يكاد يطيش",32,"ش",1,0],["تُرَوِّعُنا الجَنائِزُ مُقبِلاتٍ","فَنَلهو حينَ تَذهَبُ مُدبِراتِ",33,"ت",1,1],["تُروي الأَجارِعَ وَالأَعازِلَ كُلَّها","وَالنَعفَ حَيثُ تَقابَلُ الأَحجارُ",34,"ر",1,0],["تَروغُ وَقَد أَخزَوكَ في كُلِّ مَوطِنٍ","كَما راغَ قِردُ الحَرَّةِ المُتَخَذَّفُ",35,"ف",1,0],["تَروحُ إِذا راحَ الشَروبُ كَأَنَّها","ظِباءُ شَقيقٍ لَيسَ فيهِنَّ عاطِلُ",36,"ل",1,0],["تَروغُ إِلى الواشينَ فِيَّ وَإِنَّ لي","لَأُذناً بِها عَن كُلِّ واشِيَةٍ وَقرُ",37,"ر",1,0],["ترود بمغناك فيه العفاة","وتلقى العدى منك أنكادها",38,"د",3,0],["تروم يداي في خصريه مسرًى","ولكن ضاق فترٌ عن مسير",39,"ر",1,0],["تروى صحاح القضايا عن براعتِهِ","والنصر في الحربِ يروي عن عواليه",40,"ي",2,0],["تَرْوِي عن العصر القديم حديثها","بتسلسلٍ والدَّوْرُ في الندماءِ",41,"ا",2,0],["تُروِّعني النقائص كلَّ شهرٍ","مع التعبِ المبرِّحِ والدّؤوبِ",42,"ب",1,0],["تروحُ وتغدو غير ذات ونيَّةٍ","على حيوان مرة ومَواتِ",43,"ت",1,0],["تروح للفسق فإن عُوتبت","أعتبتِ اللائمَ بالدَّلْجَهْ",44,"ج",2,0],["ترودون منه بين حظَّيْ سعادة","لكم حاصلٌ منها عتيد وواعدُ",45,"د",1,0],["تروقك النَورة منها الناكسه","بعينِ يقظى وبجيدِ ناعسه",46,"س",2,0],["تروحُ بها سيداً نابهاً","وإن كُنتَ في الوَبَش الأوبش",47,"ش",1,0],["ترون بها ما في غدٍ رأْيَ ناظرٍ","بعين من البرهان لا وهمَ واهمِ",48,"م",1,0],["تَرَوَّت بِماءِ البَحرِ ثُمَّ تَنَصَّبَت","عَلى حَبَشِيّاتٍ لَهُنَّ نَئيجُ",49,"ج",1,0],["تَروقُكَ عَيناها وَأَنتَ تَرى لَها","عَلى حَيثُ يُلقى الزَوجُ مُنبَطِحاً سَهلا",50,"ل",2,0],["تَرَوا أَنَّنا نَجزي إِذا هِيَ أَبهَمَت","بِصَمّاءَ يُلفى بابُها ليسَ يُفتَحُ",51,"ح",1,0],["تَروح وَتَغدو وَاللَيالي كَأَنَّها","وُقوفٌ لِأَمرٍ لا تَروحُ وَلا تَغدو",52,"د",2,0],["تَروحُ وَتَغدو حُرَّةً في عُبابِهِ","كَما يَتَهادى ساكِنُ السِجنِ في السِجنِ",53,"ن",1,0],["تَرودُ الأَراوِيَ الصُحمُ حَولِي كَأَنَّها","عَذارى عَلَيهنَّ المُلاءُ المُذَيَّلُ",54,"ل",1,0],["تَرَوَّحنَ مِن حَزمِ الجُفولِ فَأَصبَحَت","هِضابُ شَرَورى دونَها وَالمُضَيَّحُ",55,"ح",1,0],["تروح إلى دار الحكومة تبتغي","معاشاً لها مستأخراً ليس يحصل",56,"ل",1,0],["تروق العين من بيضاء حال","كما تَرَّبتَ بالتِبر الكتابا",57,"ب",2,0],["تَروى بطانته ويشبع بطنه","والملك غرثان الرعية صادى",58,"د",2,0],["تروِّى الجيش راحته","إذا استسقى عرمرمه",59,"م",2,0],["تَرومُ بِمَنفيسَ بيضَ الظُبا","وَسُمرَ القَنا وَالخَميسَ الدُثَر",60,"ر",1,0],["تَروحُ المَنايا الزُرقُ فيهِ وَتَغتَدي","وَما هِيَ إِلّا المَوجُ يَأتي وَيَذهَبُ",61,"ب",1,0],["تروق بني الدنيا عجائبُها ولي","فُؤادٌ ببيضِ الهند لا بيضها مغرى",62,"ر",2,0],["تَروحُ رَواحاً عَلى أَبلَقٍ","وَتَغدو غُدُوّاً عَلى أَشهَبِ",63,"ب",1,1],["تَرومُ عَظيماً جَلَّ عَنكَ وَتَرتَجي","رِياسَةَ خِرقٍ عَطَّلَتكَ قَلائِدُه",64,"د",2,0],["تَرَونَ بُلوغَ المَجدِ أَنَّ ثِيابَكُم","يَلوحُ عَلَيكُم حُسنُها وَبَصيصُها",65,"ص",3,1],["تَرومُ وَصلَ المَها وَأَنتَ كَذا","هَذا لَعَمري ضَربٌ مِنَ السَرَفِ",66,"ف",1,0],["تَرَوَّت بِداراتِ الغَمامِ وَقَد سَرى","فَنَظَّمَ في أَوراقِها لُؤلُؤَ الطَلِّ",67,"ل",1,0],["تَروعُ المالَ ضِحكَتُهُ إِذا ما","غَدا مُتَهَلِّلاً طَلقَ الجَبينِ",68,"ن",1,0],["تَروكٌ لِما لا يَزالُ الشَري","فُ يُفيدُ اِعتِلاءً بِتِركانِها",69,"ن",3,0],["تَرومُ إِخوانَها وَيَمنَعُها","مِنهُم لَقَد ساءَها وَأَحزَنَها",70,"ن",3,0],["تَروحُ بِالوابِلِ الداني رَوائِحُها","عَلى رُبوعِكِ أَو تَغدو غَواديها",71,"ي",3,0],["تَرومُ لِتَركَبَ الصُعَداءَ مِنهُ","وَلَو لُقمانُ ساوَرَها لَهابا",72,"ب",2,0],["تَرومُ عَلى نَعمانَ في الفَجرِ ناقَتي","وَإِن هِيَ حَنَّت كُنتُ بِالشَوقِ أَعذَرا",73,"ر",2,1],["تَرَونَ لَكُم مَجداً هِجائي وَإِنَّما","هِجائي لِمَن حانَ الذُعافُ المُسَلَّعُ",74,"ع",1,0],["ترونه في ضحكة السواقي","في رفة الفراشة اللعوب",75,"ب",1,0],["تَروعُ أحشاءَهُ بالكُتْبِ وَهْوَ لَهَا","خَوفُ الرَّدى ورجاءُ السِّلمِ مُستَلِمُ",76,"م",1,0],["ترومُ وقَد فَرَعنَ بنا فُروعاً","من الفَيَّاضِ طَيَّبةَ الأُرومِ",77,"م",1,0],["تُرَوِّعُها أسيافُه فتَشيمُها","بِدَاميَةِ الأجفانِ نزرٍ هُجوعُها",78,"ع",3,0],["تُروِّحُه عذباتُ الغَرامِ","بريَّا النَّسيمِ إذا ما جرى",79,"ر",2,0],["تَروحُ به بينَ الصَّوارمِ والقَنا","وتَغدو به بينَ اللُّهى والمَواهِبِ",80,"ب",1,0],["تروقُك وهي ناجمةُ المعاني","كما راقَتْكَ نَاجِمةُ الحَبابِ",81,"ب",1,0],["تَرومُ الخُلدَ في دارِ المَنايا","فَكَم قَد رامَ مِثلَكَ ما تَرومُ",82,"م",1,0],["تَرومُ الخُلدَ في دارِ المَنايا","وَكَم قَد رامَ غَيرُكَ ما تَرومُ",83,"م",1,0],["تَرومُ بِها نَفسي الجَزاءَ فَكُن لَها","مُجيزاً بِأَن تُمسي وَأَنتَ مُجيرُها",84,"ر",3,0],["تروقكَ منها زُرقةٌ فكأنّها","سماءٌ بَدَتْ للعينِ في رونقْ الصحوِ",85,"و",1,0],["تروحُ والعنبرُ والعودُ في","ليلٍ من الفرعَ صقيلِ الظلام",86,"م",1,0],["تَروقُ ذا الجهلَ زَيناً ثم تَ