{"poems":[[32,"يهماء هيماء وخرق أهيم","https://www.aldiwan.net/poem29533.html","الرجز"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[82,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[48,"للرزق أسباب تسبب","https://www.aldiwan.net/poem22368.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54541","الخفيف"],[106,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[108,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[163,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[185,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[228,"أطلع الكاس كوكبا في ازدهاء","https://www.aldiwan.net/poem55244.html","الطويل"],[257,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[300,"للريح في وجنات الورد تخميش","https://www.aldiwan.net/poem33233.html","البسيط"],[331,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[367,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[394,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[419,"لله والدة المليك وما بنت","https://www.aldiwan.net/poem53919.html","الكامل"],[444,"قسم الغنيمة عن موسى سليل علي","https://www.aldiwan.net/poem14414.html","البسيط"],[460,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[463,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[502,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[553,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[560,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[562,"معايدات سريعة","https://www.aldiwan.net/poem67272.html","عموديه"],[563,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["لِلريحِ وَشيٌ فَوقَهُ مُنَمنَمُ","نَسجانِ هذا مُسحَلٌ وَمُبرَمُ",0,"م",1,0],["للرَّبيعِ الَّذي يؤجِّجُ في الدُّ","نيا حياةَ الهَوَى وروحَ الحنينِ",1,"ن",1,0],["للرّدينيِّ منه ريٌّ مُعَادٌ","من نجيع العدا كحرف الدّويِّ",2,"ي",1,0],["للرسلِ مِنْ قَبْلُ أصحابٌ تفوقُ وما","فيهمْ كمثلِ أبي بكرٍ ولا عمرِ",3,"ر",1,0],["لِلرِزقِ أَسبابٌ تَسَبَّب","وَالعَيشُ مَأمولٌ مَحَبَّب",4,"ب",1,1],["لِلرَّأْي غَضْبَتُهُ فإِنْ صَدمَتْهُ لمْ","يُخطئْهُ رَعْيُ مُنَاظرٍ لِمُنَاظرِ",5,"ر",1,0],["لِلْرُوحِ فِي قَسَمَاتِهَا لُطْفٌ يُرَى","والجِسْمُ طُهْرٌ مُفْرَغٌ فِي قَالَبِ",6,"ب",1,0],["لِلْرِّفَاقِ الَّذِينَ أَعَلَوْا مَكَانِي","مِنْ كِبَارِ الكُتَّابِ وَالشُّعَرَاءِ",7,"ا",2,0],["للرزء واقعة ينوء بحملها","كتف الصبور..وتفزع الألباب",8,"ب",1,0],["للرِّق قومٌ تمشَّي الرقُّ في دمهِمْ","لا يصلُحُون لغير الطَّوْقِ والصَّفَدِ",9,"د",1,0],["لِلرِّيحِ والأمْطَارِ مَا سَبَقَا بِهِ","ومَاتَرَكْنَ فّمِنْ نَصِيبِ الخَابِلِ",10,"ل",1,0],["للرمح في الدرع ما يغنيه مدخله","عن مدخل الابرة الخرقاء في الخرق",11,"ق",1,0],["لِلرَّفدِ وَالوَفدِ وَالأَنعامِ راحَتُهُ","وَالبَذلُ وَالعَدلُ مِن أَوفى مَساعيها",12,"ي",3,0],["لِلرَعايا منك الذي تَتَمَنّى","وَلك الشُكر ملحَقاً بِالثَناء",13,"ا",2,0],["للردى طوْعاً فهَوْناً","وبحبي عذباني",14,"ن",2,0],["للريح في وَجَناتِ الوَردِ تَخميشُ","وَللصبا بغصون البانِ تَحريشُ",15,"ش",1,1],["للرؤى فيه حياة","وفناء كالحياة",16,"ه",1,0],["للرّوضِ والرّيحِ إذْكارٌ بفاتنتِي","فالرّوضُ حاليةٌ والريحُ مِعطار",17,"ر",1,0],["للروح والراحات في الدنيا وفي دار السلام","والأنس والأسرار والأنوار ما فيها ظلام",18,"م",1,0],["للراكعين الساجدين لقد زها","سمة التقى للناظر المتوسّم",19,"م",1,0],["للراجل السهم والسهمان عندهمُ","بعد التحري نصيب الفارس البطل",20,"ل",1,0],["للرشفِ واللثم مكانٌ بها","ينبو عن الدينار والدرهمِ",21,"م",1,0],["للرِّفْدِ والمعروفِ ثَرْوَتُهُ","والنَّجْدَةُ القَعْساءُ للنَّصْرِ",22,"ر",1,0],["للرُّوحِ من رَوْحِ ريحِ الحِبِّ رَيْحانُ","وللحَقائِقِ في الأَسرارِ بُرْهَانُ",23,"ن",1,1],["للرّعد فيه قعاقِعٌ وزماجِرٌ","والبرق فيه توهّجٌ وتموّجُ",24,"ج",1,0],["للربوبية سر","فاحفظ السر وصنه",25,"ن",2,0],["للرملِ فيْ جَيْبَهِ ذكرى اليتيم فكم","عَبَّ الأَسى كُلما زادَ المَسَا طُولا",26,"ل",2,0],["لِلرَّيحِ في أَقرابِها هَوِيُّ","هَمِّي ومَضبورُ القَرا مَهرِيُّ",27,"ي",1,0]]}