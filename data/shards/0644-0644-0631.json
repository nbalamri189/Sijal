{"poems":[[30,"يهماء هيماء وخرق أهيم","https://www.aldiwan.net/poem29533.html","الرجز"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[46,"للرزق أسباب تسبب","https://www.aldiwan.net/poem22368.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54541","الخفيف"],[104,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[158,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[180,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[223,"أطلع الكاس كوكبا في ازدهاء","https://www.aldiwan.net/poem55244.html","الطويل"],[252,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[295,"للريح في وجنات الورد تخميش","https://www.aldiwan.net/poem33233.html","البسيط"],[326,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[362,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[388,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[413,"لله والدة المليك وما بنت","https://www.aldiwan.net/poem53919.html","الكامل"],[438,"قسم الغنيمة عن موسى سليل علي","https://www.aldiwan.net/poem14414.html","البسيط"],[456,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[498,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[549,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[556,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[558,"معايدات سريعة","https://www.aldiwan.net/poem67272.html","عموديه"],[559,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["لِلريحِ وَشيٌ فَوقَهُ مُنَمنَمُ","نَسجانِ هذا مُسحَلٌ وَمُبرَمُ",0,"م",1,0],["للرَّبيعِ الَّذي يؤجِّجُ في الدُّ","نيا حياةَ الهَوَى وروحَ الحنينِ",1,"ن",1,0],["للرّدينيِّ منه ريٌّ مُعَادٌ","من نجيع العدا كحرف الدّويِّ",2,"ي",1,0],["للرسلِ مِنْ قَبْلُ أصحابٌ تفوقُ وما","فيهمْ كمثلِ أبي بكرٍ ولا عمرِ",3,"ر",1,0],["لِلرِزقِ أَسبابٌ تَسَبَّب","وَالعَيشُ مَأمولٌ مَحَبَّب",4,"ب",1,1],["لِلرَّأْي غَضْبَتُهُ فإِنْ صَدمَتْهُ لمْ","يُخطئْهُ رَعْيُ مُنَاظرٍ لِمُنَاظرِ",5,"ر",1,0],["لِلْرُوحِ فِي قَسَمَاتِهَا لُطْفٌ يُرَى","والجِسْمُ طُهْرٌ مُفْرَغٌ فِي قَالَبِ",6,"ب",1,0],["لِلْرِّفَاقِ الَّذِينَ أَعَلَوْا مَكَانِي","مِنْ كِبَارِ الكُتَّابِ وَالشُّعَرَاءِ",7,"ا",2,0],["للرزء واقعة ينوء بحملها","كتف الصبور..وتفزع الألباب",8,"ب",1,0],["للرِّق قومٌ تمشَّي الرقُّ في دمهِمْ","لا يصلُحُون لغير الطَّوْقِ والصَّفَدِ",9,"د",1,0],["للرمح في الدرع ما يغنيه مدخله","عن مدخل الابرة الخرقاء في الخرق",10,"ق",1,0],["لِلرَّفدِ وَالوَفدِ وَالأَنعامِ راحَتُهُ","وَالبَذلُ وَالعَدلُ مِن أَوفى مَساعيها",11,"ي",3,0],["لِلرَعايا منك الذي تَتَمَنّى","وَلك الشُكر ملحَقاً بِالثَناء",12,"ا",2,0],["للردى طوْعاً فهَوْناً","وبحبي عذباني",13,"ن",2,0],["للريح في وَجَناتِ الوَردِ تَخميشُ","وَللصبا بغصون البانِ تَحريشُ",14,"ش",1,1],["للرؤى فيه حياة","وفناء كالحياة",15,"ه",1,0],["للرّوضِ والرّيحِ إذْكارٌ بفاتنتِي","فالرّوضُ حاليةٌ والريحُ مِعطار",16,"ر",1,0],["للروح والراحات في الدنيا وفي دار السلام","والأنس والأسرار والأنوار ما فيها ظلام",17,"م",1,0],["للراكعين الساجدين لقد زها","سمة التقى للناظر المتوسّم",18,"م",1,0],["للراجل السهم والسهمان عندهمُ","بعد التحري نصيب الفارس البطل",19,"ل",1,0],["للرشفِ واللثم مكانٌ بها","ينبو عن الدينار والدرهمِ",20,"م",1,0],["للرِّفْدِ والمعروفِ ثَرْوَتُهُ","والنَّجْدَةُ القَعْساءُ للنَّصْرِ",21,"ر",1,0],["للرُّوحِ من رَوْحِ ريحِ الحِبِّ رَيْحانُ","وللحَقائِقِ في الأَسرارِ بُرْهَانُ",22,"ن",1,1],["للرّعد فيه قعاقِعٌ وزماجِرٌ","والبرق فيه توهّجٌ وتموّجُ",23,"ج",1,0],["للربوبية سر","فاحفظ السر وصنه",24,"ن",2,0],["للرملِ فيْ جَيْبَهِ ذكرى اليتيم فكم","عَبَّ الأَسى كُلما زادَ المَسَا طُولا",25,"ل",2,0],["لِلرَّيحِ في أَقرابِها هَوِيُّ","هَمِّي ومَضبورُ القَرا مَهرِيُّ",26,"ي",1,0]]}