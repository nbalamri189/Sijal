85",""],[4784,"حياك مياس المعاطف","https://www.poetsgate.com/ViewPoem.aspx?id=170932",""],[4816,"موت الضماير","https://www.poetsgate.com/ViewPoem.aspx?id=199479",""],[4902,"ياصغير مايكبرني لقب","https://www.poetsgate.com/ViewPoem.aspx?id=22586",""],[4927,"مَجْدُ الْعِرَاْق","https://www.poetsgate.com/ViewPoem.aspx?id=30480",""],[4940,"وادٍ غير ذي يَبسٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207468",""],[5064,"زيدِي اغترَابِي","https://www.poetsgate.com/ViewPoem.aspx?id=199107",""],[5092,"أنثايَ","https://www.poetsgate.com/ViewPoem.aspx?id=180133",""],[5186,"لا خير في الشكوى وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156478",""],[307,"ملكة الدار","https://www.poetsgate.com/ViewPoem.aspx?id=214581",""],[5327,"الصُّبحُ الغَائب","https://www.poetsgate.com/ViewPoem.aspx?id=140331",""],[5376,"بانتْ بليلى امةٌ وديارُ","https://www.poetsgate.com/ViewPoem.aspx?id=197712",""],[5376,"واحرقتاه على الهجران أمَّاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=204777",""],[5387,"أفريقيا","https://www.poetsgate.com/ViewPoem.aspx?id=53789",""],[5447,"وصية المطالع","https://www.poetsgate.com/ViewPoem.aspx?id=208290",""],[5452,"بلد الأخيار","https://www.poetsgate.com/ViewPoem.aspx?id=148454",""],[5470,"كتبتُ عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=10983",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5561,"ألقت معاذيرها ...","https://www.poetsgate.com/ViewPoem.aspx?id=194433",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5732,"اقطف زهر مالاق","https://www.poetsgate.com/ViewPoem.aspx?id=177908",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5874,"خَمْرِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=202034",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[5937,"غيمتان","https://www.poetsgate.com/ViewPoem.aspx?id=211886",""],[5956,"ترعَى الصداقةَ كندةُ الحمدونُ","https://www.poetsgate.com/ViewPoem.aspx?id=207260",""],[5969,"رَمتني بدائها وانسلت","https://www.poetsgate.com/ViewPoem.aspx?id=199036",""],[6115,"الذي يرخصك سيبه وبيعه بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=196460",""],[6225,"معركة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80894&r=&rc=163",""]],"verses":[["لِلريحِ وَشيٌ فَوقَهُ مُنَمنَمُ","نَسجانِ هذا مُسحَلٌ وَمُبرَمُ",0,"م",1,0],["للرَّبيعِ الَّذي يؤجِّجُ في الدُّ","نيا حياةَ الهَوَى وروحَ الحنينِ",1,"ن",1,0],["للرّدينيِّ منه ريٌّ مُعَادٌ","من نجيع العدا كحرف الدّويِّ",2,"ي",1,0],["للرسلِ مِنْ قَبْلُ أصحابٌ تفوقُ وما","فيهمْ كمثلِ أبي بكرٍ ولا عمرِ",3,"ر",1,0],["لِلرِزقِ أَسبابٌ تَسَبَّب","وَالعَيشُ مَأمولٌ مَحَبَّب",4,"ب",1,1],["لِلرَّأْي غَضْبَتُهُ فإِنْ صَدمَتْهُ لمْ","يُخطئْهُ رَعْيُ مُنَاظرٍ لِمُنَاظرِ",5,"ر",1,0],["لِلْرُوحِ فِي قَسَمَاتِهَا لُطْفٌ يُرَى","والجِسْمُ طُهْرٌ مُفْرَغٌ فِي قَالَبِ",6,"ب",1,0],["لِلْرِّفَاقِ الَّذِينَ أَعَلَوْا مَكَانِي","مِنْ كِبَارِ الكُتَّابِ وَالشُّعَرَاءِ",7,"ا",2,0],["للرزء واقعة ينوء بحملها","كتف الصبور..وتفزع الألباب",8,"ب",1,0],["للرِّق قومٌ تمشَّي الرقُّ في دمهِمْ","لا يصلُحُون لغير الطَّوْقِ والصَّفَدِ",9,"د",1,0],["للرسل والملأ الأعلى وأشرفهم","بالاستقامة تكليف بلا عذر",10,"ر",1,0],["لِلرِّيحِ والأمْطَارِ مَا سَبَقَا بِهِ","ومَاتَرَكْنَ فّمِنْ نَصِيبِ الخَابِلِ",11,"ل",1,0],["للرمح في الدرع ما يغنيه مدخله","عن مدخل الابرة الخرقاء في الخرق",12,"ق",1,0],["لِلرَّفدِ وَالوَفدِ وَالأَنعامِ راحَتُهُ","وَالبَذلُ وَالعَدلُ مِن أَوفى مَساعيها",13,"ي",3,0],["لِلرَعايا منك الذي تَتَمَنّى","وَلك الشُكر ملحَقاً بِالثَناء",14,"ا",2,0],["للردى طوْعاً فهَوْناً","وبحبي عذباني",15,"ن",2,0],["للريح في وَجَناتِ الوَردِ تَخميشُ","وَللصبا بغصون البانِ تَحريشُ",16,"ش",1,1],["للرؤى فيه حياة","وفناء كالحياة",17,"ه",1,0],["للرّوضِ والرّيحِ إذْكارٌ بفاتنتِي","فالرّوضُ حاليةٌ والريحُ مِعطار",18,"ر",1,0],["للروح والراحات في الدنيا وفي دار السلام","والأنس والأسرار والأنوار ما فيها ظلام",19,"م",1,0],["للراكعين الساجدين لقد زها","سمة التقى للناظر المتوسّم",20,"م",1,0],["للراجل السهم والسهمان عندهمُ","بعد التحري نصيب الفارس البطل",21,"ل",1,0],["للرشفِ واللثم مكانٌ بها","ينبو عن الدينار والدرهمِ",22,"م",1,0],["للرِّفْدِ والمعروفِ ثَرْوَتُهُ","والنَّجْدَةُ القَعْساءُ للنَّصْرِ",23,"ر",1,0],["للرُّوحِ من رَوْحِ ريحِ الحِبِّ رَيْحانُ","وللحَقائِقِ في الأَسرارِ بُرْهَانُ",24,"ن",1,1],["للرّعد فيه قعاقِعٌ وزماجِرٌ","والبرق فيه توهّجٌ وتموّجُ",25,"ج",1,0],["للربوبية سر","فاحفظ السر وصنه",26,"ن",2,0],["للرملِ فيْ جَيْبَهِ ذكرى اليتيم فكم","عَبَّ الأَسى كُلما زادَ المَسَا طُولا",27,"ل",2,0],["لِلرَّيحِ في أَقرابِها هَوِيُّ","هَمِّي ومَضبورُ القَرا مَهرِيُّ",28,"ي",1,0],["للرىّ قام محمد بجلائل","وبفضله كل القناطر تنطق",29,"ق",1,0],["للروحِ والريحانِ راح محمّد","بجوارِ خير الرسل طه أحمدِ",30,"د",1,0],["لَلرّائحينَ عَلَيَّ إنَّ جَوانِحي","وقُوايَ يَقتُلُها الغَرامُ ويَنقُض",31,"ض",1,0],["للرائحينَ وللغادينَ في كَبِدي","مَنازِلٌ ما غَدو فيها ولا راحوا",32,"ح",3,0],["للرأي كُلُّ حَكيمِ","إِلى نُشورٍ وَحَشرِ",33,"ر",1,0],["لِلرّوضِ بادِر تُمنح التّكريما","مِن زَهرهِ مزري الجُمانِ نَظيما",34,"م",2,1],["لِلرَميِ سَهمٌ وَللتفتيكِ في مُهجٍ","سَيف وَلِلعَقلِ سحر غَير مُحتَجِبِ",35,"ب",1,0],["للرشف من تلك الشفاه الحمر","عقرب مسك فوق خدّه التوى",36,"ت",3,0],["للرّيم منه لواحظ وتلفت","للصبّ منه بلابل ولواعج",37,"ج",1,0],["للريم منه لواحظٌ وتلفتُ","في مُعجبيَ إيناسه وشماسه",38,"س",2,0],["للروض غبّ القطر منه مشابه","توريد وردته وخضرة آسه",38,"س",2,0],["للربيع الطلقِ من أنفاسها","ذلك التيه وتلك الخيلاء",39,"ا",2,0],["للريح فيه تأوه","وتفجع تحت الدجنّ",40,"ن",1,0],["للرأي كان وللمشورة والنهى","أدرى وآنس من نحب والمع",41,"ع",1,0],["للرب قد جُعل الخلاص لأنه","ما من سواه على خلاصي يقدرُ",42,"ر",1,0],["للرشد أبوابٌ وأبناؤه","كانوا المفاتيحَ لأقفالها",43,"ل",3,0],["لِلرُّوحِ رَوحٌ لِلسَرِيرَةِ غِبطَةٌ","للعُمر عمرٌ في الأذاةِ إسَاكُمُ",44,"م",1,0],["لِلرّيحِ فيهَ حَنَّةٌ","مِن جَريِهِ المُنجَذِبِ",45,"ب",1,0],["للرافدين عيون غير غافلة","عنكم تراقب ما يبدو ويستتر",46,"ر",1,0],["للروض زهر وَفي الأَغصان ساجعة","وَللمَعاني من الحذاق تَعبير",47,"ر",1,0],["للريح في مذهبه ذهاب","فالوحش ما يلقاه والهراب",48,"ب",1,0],["للرُّشد ما ورثوا منهمْ ولا ألِفوا","أولئك القومُ من زيغِ الهُدى سلموا",49,"م",3,0],["للراكعين الساجدين العابدين","الحامدين لربهم رب السما",50,"م",2,0],["لِلرُّوحِ شَأنٌ غَير ذِي الأجسَامِ لاَ","تُهمِلهُ شَأنُ الرُّوحِ أعجَبُ شَانِ",51,"ن",1,0],["لِلروحِ فيها حَفيفٌ","وَلِلقُلوبِ اِختِلاجُ",52,"ج",1,0],["للرشد والترغيب وال","ترهيب يومك قد تقسم",53,"م",1,0],["للرمل أم لم تكن بثكلي","وقد حوى ستة عشر شكلا",54,"ل",2,0],["للراح أهوى ساقيا ظبيا كما","أهوى لها من الغناء الهزجا",55,"ج",2,0],["للَّراحِلِينَ قوَافِلٌ مَطْلِيةٌ","مِنْ صِبغَةِ التَّسنِيمِ جَنْيَاً تَلْعَقُ",56,"ق",1,0],["للرَّوْضِ أتى حبيبُ قلبي العانِي","فاهْتزَّ لفَرْحةٍ قضيبُ البانِ",57,"ن",1,1],["للروع مدّخر الرجال فإِن سَطا","خطب وَلم تنكص فللأمن النسا",58,"س",2,0],["لِلرِّزقِ ندّاً وَكَم مِمَّن يودِعه","مُتَيَّمٌ بِالنَوى اِذ خابَ في املٍ",59,"ل",1,0],["لِلرَّفعِ والَّصبِ وَجَرٍّنَا صَلَحَ","كَاعرِف بِنَا فَإِنَّنَا نِلنَا المِنَح",60,"ح",1,0],["للرضا في العلا مقام عظيم","طائر الفكر حوله لا يحوم",61,"م",1,1],["للرزق كدّاً وكم مِمَّن يودعُهُ","وكم يودع من خلٍّ ومن أَهَلِ",62,"ل",1,0],["للرَّوضِ رُواً طَلْقُ المُحَيَّا نَضِرُ","لو تَمَّ بكم كما رَجوْنَا وَطَرُ",63,"ر",1,1],["لِلرَّمْي فَضْلٌ لَيْسَ يُنْكَرُ قَدْرُهُ","وَالجَوُّ قَد شَهْدَتْ بِهِ آثارُهُ",64,"ه",1,1],["للراح في راحتنا أكؤسٌ","كأنها يا سعد تيجان",65,"ن",1,0],["لِلرمح أَقول واثِقاً بِالنَصرِ","لا تَلتَوِ لا يُزِغكَ خَوفُ الكَسرِ",66,"ر",1,1],["لِلروحِ سِوى لَفظِكَ هَل مِن قوتِ","في حُبِّكَ هَل لام سِوى مَمقوتِ",67,"ت",1,1],["لِلريحِ يَقولُ فاغمُ الأَزهارِ","لَولاك لَما بَدَوتُ لِلنُظّارِ",68,"ر",1,1],["للراح رح واسبق فواحزني على","من عن أويقات السرور تخلفا",69,"ف",2,0],["للروض عند الصباح طيبُ","نَمَت إلينا به الحنبوب",70,"ب",1,1],["للرومِ والإفرنج منكَ مصائبٌ","بالتُّرك والأَكرادِ والعُربانِ",71,"ن",1,0],["للرِّيمِ منهُ وللغُصونِ إذا بدا","وإذا تثنَّى ناظُرٌ وقَوامُ",72,"م",1,0],["للربح والنجح في هذي الحياة دعوا","كل الورى وليلِ الخير في العقب",73,"ب",1,0],["للرزق أسباب ومن أسبابه","أعمال ناجية وشد حزام",74,"م",1,1],["للرفق والرأفة واللطف والرحم","ة والحلم له اشتياق",75,"ق",1,0],["للرأي بالشورى يصح البنا","إن كانت صدق المستشار الصداق",75,"ق",1,0],["للرُّمح نَصلٌ واحدٌ ولقَدِّهِ","من ناظريه إذا إذا رَنَا نَصلانِ",76,"ن",1,0],["للرشد حبُّهم يهدى الملا وإلى","روض الجنان ولاهم كم هدى شيعا",77,"ع",2,0],["للريم فالقلب نار الغبن مشبوبه","وانا ظمايه لها بالحيل متروّي",78,"و",2,0],["لِلرِّيحِ في كُلِّ شِبرٍ دَاخِلِي لُغَةٌ","تُشِيرُ لِي كَيفَ أَبنِي بالحَصَى الجَبَلَا",79,"ل",2,0],["للرشد ينشر أمرَه","ما دامَ غيٌّ في الورى",80,"ر",2,0],["للربيع الجميل إذ جاء حباً","يبعث العطر والشذا والنسيما",81,"م",2,0],["للريم فيه تشابه","أو ما تراه لا يوالف",82,"ف",1,0],["للربد ركات وللحر كفخات","والفرق من رجله على العنق طبقه",83,"ق",2,0],["للرجال الرجاجيل العتب","والزكاة تحل في حال الفقير",84,"ر",1,0],["لِلرَّاْفِعِيْنَ بَيَاْرِقَ الأَعْدَاْ عَلَىْ","هَاْمَاْتِهِمْ بِتَخَاْذُلٍ وَ عِنَاْدِ",85,"د",1,0],["للروحِ لقيا لا تكون لغيرها","تنأى الجسوم ويلتقي الأحبابُ",86,"ب",1,0],["للرُّوحِ كَشْفٌ وإنِّي مِنْ دلائِلهِ","بِرُغمِ تَعذِيبهِ لا تُسدِلي الحُجُبَا",87,"ب",2,0],["للرمشِ رقصتهُ إنْ يعلُ منحنيًا","كأنّهُ لِشِبَاكِ السحر قد غزلا",88,"ل",2,0],["للرأس تاج من زرد","في الجيد في لبنان حد",89,"د",1,0],["للرزق أصحو من رقادي للوغى","فغدوتُ فيها للصعابِ رصيدا",90,"د",2,0],["لِلرَّايَةِ نَحشِدُ أُمَّتَنَا","ونُوَحِّدُهَا صَفَّاً أَكْبَرْ",91,"ر",1,0],["للروضةِ الخضراء عندي غبطةٌ","فلها النبيُّ لَمسْكنٌ وجِوارُ",92,"ر",1,0],["للرَغْدِ ناسٌ وما رغْدُ الفقيرِ له","إذا يشاء سوى موتٍ بمنفاهُ",93,"ا",2,0],["للرفقِ بالحيوانِ عند شعوبهم","جمعيةُ ومؤسساتُ ربما",94,"م",2,0],["للريحِ أن تصفَ اللقاءَ صراحةً","وعلى القصيدِ أمانةُ التلميحِ!",95,"ح",1,0],["للرّقص والموضات وجه همومنا","نحن الصّدى وهوامش الأشياءِ",96,"ا",2,0],["للرِّيحِ عَصفٌ وللإرْعَادِ عَاصِفَةٌ","أينَ النَّجَاةُ؟ فلا يَقوَى على الهَرَبِ",97,"ب",1,0],["للرّوضة الغنّاء في تألّق","بنورها مبتسما عن عَبَقِ",98,"ق",1,0],["للركنِ يُلجؤها في الّليلِ غاصبُها","وتستظلُّ حياءً ظلَّ منكتِما",99,"م",2,0],["للركايب مع الي وردوها خطام","ساقها للموارد من يعرف الدليل",100,"ل",1,0],["للرغو حول شدوق الخيل وسوسة","والنقع يذري لثاما قنع السحبا",101,"ب",2,0],["للريم فيها يابن سلوم مدهال","وغر المزون بوبلها عللتها",102,"ت",3,0],["للرغيف من السنابل ياشقاء الزارعين","للنوارس يوم ترحل في دموعٍ ساحليه",103,"ي",2,0],["لِلرِّيحِ أَنْ تَتَسَمَّى بِي .. أُلَمْلِمُها","فَتَتْرُكُ البَحْرَ رَهْوًا تَحْتَ أَلوَاحِي",104,"ح",2,0],["للروح ماللجسم من حُضن اللِقَا","ولها عيونٌ تشتهي وكلامُ",105,"م",1,0],["للروح صدرٌ كما تدرين يجمعنا","إذا بكى الجسم منفياً عن الجسمِ",106,"م",1,0],["للراغب الحمدونِ عندي قيمة","عُليا وتعبيري الرَّكيكُ مُشينُ",107,"ن",1,0],["للراحلينَ عَنِ الغديرِ تَفرقاً","والراكضينَ إلى الشَتاتِ للمِهِ",108,"م",2,0],["للرديين بيع بدين ولا بكاش","ويش تبي من هلايم عزمهم يبردي",109,"د",2,0],["للراسبين نجاحٌ في الحياة كما","للناجحين رسوبٌ غيرُ مُفتقَدِ",110,"د",1,0]]}