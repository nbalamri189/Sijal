{"poems":[[54,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16658","البسيط"],[189,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37984","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115892","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108631","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140301",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[4809,"هل في القوم من عمر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201476",""],[5974,"أريكة الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=215273",""],[6031,"أَهْدَى لنا طيفَهُ بعد الهدوِّ عِشا","https://www.poetsgate.com/ViewPoem.aspx?id=46297",""]],"verses":[["كَأَنَّهُ غُرَّةُ مُهرٍ أَشقَرِ","وَالوَحشُ في أَوطانِها لَم تُعذَرِ",0,"ر",1,0],["كأنَّهُ غارَ منّا أنْ نُصاحِبَهُ","وخافَ أنْ نَتَقاضاكِ المَواعِيدا",1,"د",2,0],["كأنه غُرَّة المُختارِ حين بَدا","يَحُفُّه في جيوش النصرِ مَوْكِبُه",2,"ب",2,0],["كَأَنَّهُ غَزالٌ","بِبَلدَةٍ فَريدُ",3,"د",1,0],["كَأَنّهُ غادَةٌ قَد زُيِّنَت وَلَها","مِن دُرِّ مِدْحَتِهِ المَنظومِ تزيينُ",4,"ن",1,0],["كأنه غصن بان حامل فلكا","والبدر والشمس في خديه زهرات",5,"ت",1,0],["كأنّه غُصنُ خيزُرانٍ","إذا تثنَّى أو قضيبُ رَند",6,"د",1,0],["كأنه غار من عيني على فُنُقٍ","تغارُ منها حسان الحور والبشر",7,"ر",1,0],["كأنه غادةٌ ماست ومذ برزت","بخدها الصلت غنتها المزامير",8,"ر",1,0],["كَأَنَّهُ غُصنُ بانٍ في مَعاطِفِه","فَيا لِحظ الَّذي قَد حازَهُ وَقَنى",9,"ا",1,0],["كأنه غادر العلياء في ألمٍ","ملء الجوانح أحزانٌ بلا وتر",10,"ر",1,0],["كأنّه غصة في ثغر مرتحل","عن الديار ، ومنه الموت قد قَرُبا",11,"ب",2,0],["كأنَّهُ غُصْنُ بانٍ تحتَ بدرِ دُجىً","على نقاً من رمالِ الأبرقينِ نَشَا",12,"ش",2,0]]}