طرت آسيا بعيد أبيها","https://www.aldiwan.net/poem61621.html","الخفيف"],[459,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[459,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[459,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[459,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[459,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[462,"وإني ومدحي أبا جعفر","https://www.aldiwan.net/poem16149.html","المتقارب"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[465,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[465,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[465,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[466,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[469,"كم نعرة طولتها","https://www.aldiwan.net/poem59604.html","مجزوء الكامل"],[469,"لا تقرضن يا فار لي ذمة","https://www.aldiwan.net/poem59787.html","السريع"],[478,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[480,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[480,"يكون المرء مضطرا لجرم","https://www.aldiwan.net/poem37016.html","الوافر"],[480,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[501,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[501,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[501,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[514,"أبى لي الوفاء دوام الجفا","https://www.aldiwan.net/poem67694.html","المتقارب"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[515,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[530,"وطالب الدنيا بعل","https://www.aldiwan.net/poem37364.html","مجزوء الرجز"],[530,"وكم من طواغيت يجر زمامها","https://www.aldiwan.net/poem37490.html","الطويل"],[537,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[539,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[539,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[541,"يا دار سعدى بالجزع من ملل","https://www.aldiwan.net/poem56706.html","المنسرح"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[554,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[559,"وجدت كنزا هنا هو البركه","https://www.aldiwan.net/poem33508.html","المنسرح"],[559,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[559,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[559,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[559,"رويدا أيها النفس المراشه","https://www.aldiwan.net/poem34428.html","الوافر"],[563,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[563,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[568,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[576,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[576,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[576,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[576,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[580,"سألت الذي لاينفذ الرزق عنده","https://www.aldiwan.net/poem56779.html","الطويل"],[587,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["كمن بات بالحمى خلافا لما به","يرى يشتكي بردا وما انفك لاهب",0,"ب",1,0],["كَمَن صارَعَ الأَسَدَ المُستَغي","رَ في الغابِ أَو ساوَرَ الأَرقَما",1,"م",2,0],["كَمَن بادَلَ الإِجلاءَ في العَينِ بِالقَذى","وَآبَ بِداءٍ لا يُطَبُّ عُضالُ",2,"ل",1,0],["كَم نِعمَةٍ مِنكَ كَاللَطيمَةِ مَس","راها نَمومٌ وَعَرفُها ثَمَلُ",3,"ل",1,0],["كَم نَفحَةٍ مِنهُ عَلى فاقَةٍ","تُنبِتُ عُشبَ البَلَدِ البَلقَعِ",4,"ع",1,0],["كَم نَظرَةٍ مِنكَ تَشفي النَفسَ عَن عَرَضٍ","وَتُرجِعُ القَلبَ مِنِّ جِدَّ مُنتَكِسِ",5,"س",1,0],["كَم نَفَّرَت مِن شَجوِ قَلبٍ نافِرٍ","وَاِستَمطَرَت مِن دَمعِ عَينٍ مُمطِرِ",6,"ر",1,0],["كَم نَأى بِالنَفرِ عَنّا","مِن غَزالٍ وَمَهاةِ",7,"ه",1,0],["كَم نِعمَةٍ لَكَ يا مَحمودُ عِندَ أَبي","بِشُكرِها لَكَ عِندَ المَوتِ أَوصاني",8,"ن",2,0],["كَم نَفَّسَت عَن صَدرِ حُرٍّ واجِدٍ","لَولا الصِمامُ مِنَ الأَسى لَتَمَزَّقا",9,"ق",2,0],["كَم نَفثَةٍ لَكَ تَستَثيرُ بِها الهَوى","هاروتُ في أَثنائِها يَتَكَلَّمُ",10,"م",1,0],["كَم نُفوسٍ قَد سَلَّها مِن يَدِ المَو","تِ بِلُطفٍ مِنهُ وَكَم سَلَّ داءَ",11,"ا",2,0],["كَم نَظرَةٍ لَكَ في عَيني عَلِمتَ بِها","يَومَ الزِيارَةِ أَنَّ القَلبَ قَد ذابا",12,"ب",2,0],["كَم نَفَسّوا كَربَ مَكروبٍ وَكَم صَبَروا","عَلى الشَدائِدِ مِن لَأواءَ فَاِنجَلَتِ",13,"ت",1,0],["كم نشرب الظنّ فلا نرتوي","ونأكل الحدس فلا نشبع",14,"ع",1,0],["كم نعمةٍ لك مهما","نظرتُ كانت إزائي",15,"ا",3,0],["كم نعمة سبحت عن بيت سؤدده","في الخافقين وكم من مدحة سرحت",16,"ت",1,0],["كم نعمة تقوية أفضت بها","سور الثنا للحمد والإخلاص",17,"ص",1,1],["كم نالَ سعيهمو جدّ فما بطروا","فيه وكم نالهم دهرٌ فما خضعوا",18,"ع",3,0],["كم نعمة أسبغتها للورى","فهي على عرض الورى سابغه",19,"غ",2,0],["كم نائحٍ كالصدى مثلي على ولدٍ","يقول واحرقي إن قلت واحرقي",20,"ق",2,0],["كم نِضْوِ شُكرٍ نَضَوْا عنه وليَّتَهُ","فظهرُهُ مستريحٌ غيرُ مُعْتقَبِ",21,"ب",1,0],["كم نوالٍ مباركٍ لك قد قا","د نوالاً إليَّ طوعَ الجنابِ",22,"ب",1,0],["كم نُسام الأذى كأنَّا كلابُ","كَمْ إلى كَمْ يكون هذا العتابُ",23,"ب",1,1],["كم نظرةٍ فيها تَقَصَّيتها","كم وقفةٍ فيها توقَّفْتُها",24,"ت",3,0],["كمن دحرجَ درَّ البح","رِ فيِ بَخرِ البلاليعِ",25,"ع",1,0],["كمنطقة الجوزاء لاحت بسحرة","بعقب غمام لائح ثم أقشعا",26,"ع",2,0],["كم نظيرلك في الثر","وة أكدى حين أبقى",27,"ق",2,0],["كم نعمة منك لا يقر بها","ينطق عنها ذرورُ شارقها",28,"ق",3,0],["كم نوبة يذعر الزمان لها","يُعدُّه أهله لطارقها",28,"ق",3,0],["كم نوال لكم بَكورٍ طروقٍ","قد كفى نوبة بكوراً طروقا",29,"ق",2,0],["كم نعمةٍ لك ملء فِكْ","رِي لا تُلاحِظها بفِكْرِكْ",30,"ك",1,0],["كَمَن يَمشي إِلى الوِزرِ عامِداً","وَيَضحَكُ مُختالاً إِذا مَسَّهُ الوِزرُ",31,"ر",1,0],["كَم نائِمٍ في وَكرِهِ هانِئٍ","نَبَّهتِهِ مِن وَكرِهِ باكِرا",32,"ر",2,0],["كَم ناكِصٍ عَن مَأزَقٍ خَوفَ الرَدى","طَلَعَ الرَدى مِنَ خَلفِهِ يَتَصَلصَلُ",33,"ل",1,0],["كَمَنجَةيَ الشَوّا عَلَيكِ السَلام","بِهَيكَلِ الوَحيِ وَعَرشِ الغَرام",34,"م",1,1],["كَمَن باعَ بِالإِثمِ التُقى وَتَفَرَّقَت","بِهِ طُرُقُ الدُنيا وَنَيلٌ مُتَرَّحُ",35,"ح",1,0],["كم نسوةٍ قتلت ظلما بعولتها","فصرن يهملن دمعاً قبله صينا",36,"ن",2,0],["كم نباهي بلحد ميت وكم نح","مل من هادم ولم يبن مَنَّا",37,"ن",2,0],["كَم نَستَعيرُ الآخَرينَ وَنَجتَدي","هَيهاتَ ما لِلعارِياتِ دَوامُ",38,"م",1,0],["كَم نائِمٍ لا يَراها وَهيَ ساهِرَةٌ","لَولا الأَمانِيُّ وَالأَحلامُ لَم يَنَمِ",39,"م",1,0],["كَم ناهِدٍ في اللّاعِباتِ صَغيرَةٍ","أَلهَتهُ عَن حَفَدٍ بِمِصرَ صِغارِ",40,"ر",1,0],["كَم نَظرَةٍ لي خِلالَ الشامِ لَو وَصَلَت","رَوَّت غَليلَ فُؤادٍ مِنكِ مُلتاحِ",41,"ح",1,0],["كَم نِعمَةٍ لَكَ لَم تَخَلها تَلتَوي","باتَت تَقَلقَلُ طَوعَ بَيتٍ شارِدِ",42,"د",1,0],["كَمَنعِ أَبي لَيلى عِياضَ بنَ دَيهَثٍ","عَشِيَّةَ خافَ القَومُ أَن يَتَمَزَّعا",43,"ع",2,0],["كم نعمة ألبست من نعمان","لم تلقها الأعضاء بالكفران",44,"ن",1,1],["كم نِعمةٍ للرَّبيع جادَ بها","ونَقمةٍ كالحريقِ أطفَاها",45,"ا",3,0],["كَم نِعمَةٍ لَم تَستَقِلُّ بِشُكرِها","لِلّهِ في طَيِّ المَكارِهِ كامِنَه",46,"ه",1,0],["كَم نِعمَةٍ لا أَستَطيعُ بُلوغَها","جُهداً وَلو أَعلَمتُ طاقَة مقوَلِ",47,"ل",1,0],["كَم نَغَّصَ الدَهرُ مِن مَبيتِ","عَلى سَريرٍ وَمِن مَقيلِ",48,"ل",1,0],["كَم نافَسَ المَرءُ في شَيءٍ وَكايَدَ في","هِ الناسَ ثُمَّ مَضى عَنهُ وَخَلّاهُ",49,"ا",2,0],["كَم نِعمَةٍ لا يُستَقَلُّ بِشُكرِها","لِلَّهِ في طَيِّ المَكارِهِ كامِنَه",50,"ه",1,1],["كم نداء خافت مبتعد","تشتهي أذن الهوى أن تستعيده",51,"ه",1,0],["كمنْجَلٍ قد صِيغَ من عَسْجَدٍ","يحصُدُ من زَهْرِ الرّبى نَرْجِسَا",52,"س",2,0],["كَمُنَعَّمِ الأطرافِ بَلّلَهُ","شَرَقُ النسيم بريقِهِ الوَسْمي",53,"م",2,0],["كَمَن جَعَلَ الحَضيضَ لَهُ مِهاداً","وَيَزعُمُ أَنَّ إِخوَتَهُ النُجومُ",54,"م",1,0],["كَم نادَمَت أَسيافُنا أَرماحَهُم","بَينَ الجُيوشِ عَلى دَمٍ يَتَرَقرَقُ",55,"ق",1,0],["كَم نَفحَةٍ لَكَ لَم يُحفَظ تَذَمُّمُها","لِصامِتِ المالِ لا إِلّا وَلا ذِمَما",56,"م",2,0],["كَم نِعمَةٍ لِلَّهِ كانَت عِندَهُ","فَكَأَنَّها في غُربَةٍ وَإِسارِ",57,"ر",1,0],["كَم نِعمَةٍ زَيَّنَتَني بِسُموطِها","كَالعِقدِ في عُنُقِ الكِعابِ الناهِدِ",58,"د",1,0],["كَم نيلَ تَحتَ سَناها مِن سَنا قَمَرٍ","وَتَحتَ عارِضِها مِن عارِضٍ شَنِبِ",59,"ب",1,0],["كمْ نالَ بالتدبيرِ مَنْ هو صابرٌ","ما لمْ ينلْهُ بعسكرٍ جرارِ",60,"ر",1,0],["كَم نَكبَةٍ فَدَحَت وَكَم مِن غَمرَةٍ","خُضنا بِها الأَهوالَ وَالأَخطارا",61,"ر",2,0],["كَم نَهاني عَن حُبِّ موسى أُناسٌ","عَذَلوني فَإِن بَدا عَذَروني",62,"ن",2,0],["كَم نَكَّروا مِن مَعلَمٍ كَم دَمَّروا","مِن مَعشَرٍ كَم غَيَّروا مِن مَشعَرِ",63,"ر",1,0],["كَم نَذيرٍ بَدا لِعَينيهِ حَتّى","قامَ شَخص الرَدى هُناكَ سَويّا",64,"ي",2,0],["كَم نِعمَةٍ عَرِفَ الإِخوانُ صاحِبَها","لَمّا مَضَت أَنكَروهُ بَعدَ عِرفانِ",65,"ن",1,0],["كَمِنجَلٍ قَد صيغَ مِن فِضَّةٍ","يَحصُدُ مِن زُهرِ الدُجى نَرجِسا",66,"س",2,0],["كمَنْ لامَ نَفْساً وهي غَيرُ ملُومَةٍ","وأُفْحِمَ ظَنّاً وهو ليس بمُفحم",67,"م",1,0],["كَمَنِ الشَنآنُ فيهِ لَنا","كَكُمونِ النارِ في حَجَرِه",68,"ر",2,0],["كَمَن أَرادَ بِشَيءٍ","سَماجَةً فَتَجَلّى",69,"ل",2,0],["كَمَن أَلقاهُ في سِرٍّ وَجَهرٍ","وَأَطمَعُ مِنهُ في رَدِّ السَلامِ",70,"م",1,0],["كَم نارِ حَربِ ضَلالَةٍ أَطفَأتَها","وَرُضاعِ جَهلٍ كِدتَهُ بِفِطامِ",71,"م",1,0],["كَم نالَ أَطيَبَ مَطعَمٍ هِلباجَةٌ","أَشِرٌ وَأَعوَزَ حُرَّةً هِلباجُها",72,"ج",3,0],["كَم نِعمَةٍ لِلَّهِ يَحسِبُها اِمرُؤٌ","بِالشَحطِ وَهِيَ قَريبَةُ المُزدارِ",73,"ر",1,0],["كَم نالَ قَبلَكَ في طَعّامِكَ مِن يَدٍ","نَصَبٌ إِلى أَن لاسَ قُوتَكَ لائِسُ",74,"س",1,0],["كَم نجوم يخفين بعد ظهور","وَنجوم يظهرن بعد خفاء",75,"ا",2,0],["كمنَ الغدر لهُ ثم رمى","عن يدٍ عسراءَ شعواءَ الرّماءْ",76,"ا",2,0],["كَمْ نِعْمَةٍ عِنْدَ البَخِيلِ فَقِيدَةٌ","جَعَلْتَ عَطَاءَ اللهِ كَالتَّطْفِيلِ",77,"ل",1,0],["كَمْ نَشَّأَ النِشءَ الضَّعِيفَ وَصَانَهُ","فَأُعِدَّ جِيلٌ لِلْبلادِ جَدِيدُ",78,"د",1,0],["كَمْ نُفُوسٍ مَلَكْتَهُنَّ بِنُعْمَى","وَصَلَتْ مَا قَطَعْنَهُ مِنْ رَجَاءٍ",79,"ا",2,0],["كم نحول يشفّ عن نفس جبار","جريءٍ الفعال ضخم الرغاب",80,"ب",1,0],["كم نشقنا تُقىً هناك وقُدساً","كيف أنسى",81,"ا",1,0],["كم نظرنا من كوتيك إلى الكون","وهل تعرف الطفولة شرا",82,"ر",2,0],["كَمَن فَرَّ مِنَ القَطرِ","فَصارَ القَطرُ ميزابا",83,"ب",2,0],["كم نبت أسيافنا في ملعب","وكبت أفراسنا في ملعب",84,"ب",1,0],["كَمْ نَدَبْنَا الشَّبَابَ حِينَ تَولى","وَشُغِفْنَا بالْبَدْرِ بَعْدَ احْتِجَابِهْ",85,"ب",2,0],["كم ناغم الشرق في مواجعه","وهلّلت في سمائها غرره",86,"ر",2,0],["كم نعمنا به زماناً فلمّا","طاح عشنا في ذكريات زمانِهْ",87,"ن",2,0],["كم نكتَة فيه كادت","تخفَى على كُلِّ ظن",88,"ن",1,0],["كَمْ نِلْتِ بالْعِلْمِ مِنْ مَقَامِ","وِنلتِ بالْجِدِّ مِنْ مَرَامِ",89,"م",1,0],["كم نمقوا صُوَراً شتَّى وكَمْ خلَقُوا","للغدْرِ والفتكِ أشكالاً أفَانينَا",90,"ن",2,0],["كم ناشدتنا شفاه فيك ضارعة","وكم دعانا عفاف منك مسلوب",91,"ب",1,0],["كم نوينا الصومَ، لا عن حِسبَةٍ","أتُرى، يا صاحِ، قد عِفتَ الصياما؟",92,"م",2,0],["كم نسجتَ الثيابَ من غير نولٍ","ثم وشَّيتها بألف دهان",93,"ن",1,0],["كم ناجح متفَوِّقٌ في درسه","دخل الحياةَ، فلم يَفُز بنجاحِ",94,"ح",1,0],["كم نال شاعر أُمَّةٍ بربابة","ما لم ينَلْهُ كمِيها بِجِرَابه",95,"ب",2,0],["كم نسفت النُّجُودَ نجدًا، فنجدًا","وفريت الصفاة بعد الصَّفاة",96,"ه",1,0],["كم ناطق تبع الهوى","فَلوى بغير الحق فاه",97,"ا",2,0],["كم نعمة لا أستطيع بلوغها","جهداً ولو اعملت طاقة مقول",98,"ل",1,0],["كم نفثةٍ لي قَنَّعتْ وجه الدجى","هماً وأوحت للسُها إخفاقها",99,"ق",3,0],["كمنجة ((الشوّا)) عليك السلام","بهيكل الوحي وعرش الغرام",100,"م",1,1],["كم نائم في وكره هانيء","نبّهته من وكره باكرا ؟",101,"ر",2,0],["كمنت للغيد في أشعاره","زينة الشيطان من غيّ ورجس",102,"س",1,0],["كمن دحرجَ دُرَّ البح","رِ في بحرِ البلاليعِ",103,"ع",1,0],["كَمَنْ تَعَدَّى بَغْيُهُ قَوْمَهُ","طَارَ إِلَى رَبِّ اللِّوَاءِ الخَفُوقْ",104,"ق",1,0],["كمن يبغي العراق تطير فيه","سوام كل بغيتها الشآم",105,"م",1,0],["كم نعمٍ قد أصارها نقماً","على الليالي الخطوب والعلل",106,"ل",1,0],["كم نوّر الأبصار من","ألفاظهِ الدررُ العِذابْ",107,"ب",1,0],["كم نافسوا كم سارعوا كم سابقوا","من سابق لفضائل وتفضل",108,"ل",1,0],["كم نعمة لك مثل الطوق في عنقي","وكم يد لك بيضاً في يدي ومنا",109,"ن",2,0],["كم نائم باتت الأرزاق توقظه","وهائم حظه من سعيه التعبُ",110,"ب",1,0],["كَم نارِ شَرٍّ طِلاعُ الأَرضِ جاحِمُها","لَهُ شُواظٌ بِحَيثُ النَجمُ يَلتَهِبُ",111,"ب",1,0],["كَم نِعمَةٍ لَهُم لا يُستَقَلُّ بِها","لا مَنُّ يَتبَعُها مِنهُم وَلا كَدَرُ",112,"ر",1,0],["كم ناظر ضَلَّ بلا دُرْبَةٍ","فدَلَّه الأعمى الذي قد دَرِب",113,"ب",1,0],["كم نظرةٍ نالتْ بطَرْفٍ ذابلٍ","ما لا يَنال الذابلُ المهزوز",114,"ز",1,0],["كم نعيم بنهر معقل دافع","تُ به صرف نازل الحدثان",115,"ن",1,0],["كم نائم لم ينتبه","كم هالك بسقوط عاثر",116,"ر",1,0],["كم نظرة أتلفت محبا","بين المعاريض والمزاح",117,"ح",1,0],["كَمَن قَد تربّي في مدارسَ شُيّدت","لِتَخريبِ دينِ اللَّه عاشَ بها عمرا",118,"ر",2,0],["كَمُنتَظِر الفِطرِ يَومَ الصيامِ","وَمُرتَقِبِ الشَمسِ حَتّى تَغيبا",119,"ب",2,0],["كم نشرنا من بساط","وشربنا بالكبيره",120,"ه",1,0],["كم نغمة صغت من إلهام روعته","ووحي طلعته فاصدح بها الانا",121,"ن",2,0],["كَم نُفوسٍ رَأَيتُها تَلفظ الأَث","مَ فَيَرقى مِنها إِلى الأَرياقِ",122,"ق",1,0],["كم نِلتَ بالمَهْلِ ما تعيا السيوفُ به","ونلت بالسيف ما يَعيْا به المَهَلُ",123,"ل",1,0],["كم نصيرٍ له هناك