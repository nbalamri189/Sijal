الخفيف"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[458,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[458,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[458,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[461,"وإني ومدحي أبا جعفر","https://www.aldiwan.net/poem16149.html","المتقارب"],[464,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[464,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[464,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[464,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[464,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[464,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[465,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[468,"كم نعرة طولتها","https://www.aldiwan.net/poem59604.html","مجزوء الكامل"],[468,"لا تقرضن يا فار لي ذمة","https://www.aldiwan.net/poem59787.html","السريع"],[477,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[479,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[479,"يكون المرء مضطرا لجرم","https://www.aldiwan.net/poem37016.html","الوافر"],[479,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[500,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[500,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[500,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[500,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[513,"أبى لي الوفاء دوام الجفا","https://www.aldiwan.net/poem67694.html","المتقارب"],[514,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[514,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[529,"وطالب الدنيا بعل","https://www.aldiwan.net/poem37364.html","مجزوء الرجز"],[529,"وكم من طواغيت يجر زمامها","https://www.aldiwan.net/poem37490.html","الطويل"],[536,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[538,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[538,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[540,"يا دار سعدى بالجزع من ملل","https://www.aldiwan.net/poem56706.html","المنسرح"],[544,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[551,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[551,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[553,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[558,"وجدت كنزا هنا هو البركه","https://www.aldiwan.net/poem33508.html","المنسرح"],[558,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[558,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[558,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[558,"رويدا أيها النفس المراشه","https://www.aldiwan.net/poem34428.html","الوافر"],[562,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[562,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[567,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[575,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[575,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[575,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[575,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[579,"سألت الذي لاينفذ الرزق عنده","https://www.aldiwan.net/poem56779.html","الطويل"],[586,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["كَمَن صارَعَ الأَسَدَ المُستَغي","رَ في الغابِ أَو ساوَرَ الأَرقَما",0,"م",2,0],["كَمَن بادَلَ الإِجلاءَ في العَينِ بِالقَذى","وَآبَ بِداءٍ لا يُطَبُّ عُضالُ",1,"ل",1,0],["كَم نِعمَةٍ مِنكَ كَاللَطيمَةِ مَس","راها نَمومٌ وَعَرفُها ثَمَلُ",2,"ل",1,0],["كَم نَفحَةٍ مِنهُ عَلى فاقَةٍ","تُنبِتُ عُشبَ البَلَدِ البَلقَعِ",3,"ع",1,0],["كَم نَظرَةٍ مِنكَ تَشفي النَفسَ عَن عَرَضٍ","وَتُرجِعُ القَلبَ مِنِّ جِدَّ مُنتَكِسِ",4,"س",1,0],["كَم نَفَّرَت مِن شَجوِ قَلبٍ نافِرٍ","وَاِستَمطَرَت مِن دَمعِ عَينٍ مُمطِرِ",5,"ر",1,0],["كَم نَأى بِالنَفرِ عَنّا","مِن غَزالٍ وَمَهاةِ",6,"ه",1,0],["كَم نِعمَةٍ لَكَ يا مَحمودُ عِندَ أَبي","بِشُكرِها لَكَ عِندَ المَوتِ أَوصاني",7,"ي",1,0],["كَم نَفَّسَت عَن صَدرِ حُرٍّ واجِدٍ","لَولا الصِمامُ مِنَ الأَسى لَتَمَزَّقا",8,"ق",2,0],["كَم نَفثَةٍ لَكَ تَستَثيرُ بِها الهَوى","هاروتُ في أَثنائِها يَتَكَلَّمُ",9,"م",1,0],["كَم نُفوسٍ قَد سَلَّها مِن يَدِ المَو","تِ بِلُطفٍ مِنهُ وَكَم سَلَّ داءَ",10,"ا",2,0],["كَم نَظرَةٍ لَكَ في عَيني عَلِمتَ بِها","يَومَ الزِيارَةِ أَنَّ القَلبَ قَد ذابا",11,"ب",2,0],["كَم نَفَسّوا كَربَ مَكروبٍ وَكَم صَبَروا","عَلى الشَدائِدِ مِن لَأواءَ فَاِنجَلَتِ",12,"ت",1,0],["كم نشرب الظنّ فلا نرتوي","ونأكل الحدس فلا نشبع",13,"ع",1,0],["كم نعمةٍ لك مهما","نظرتُ كانت إزائي",14,"ا",3,0],["كم نعمة سبحت عن بيت سؤدده","في الخافقين وكم من مدحة سرحت",15,"ت",1,0],["كم نعمة تقوية أفضت بها","سور الثنا للحمد والإخلاص",16,"ص",1,1],["كم نالَ سعيهمو جدّ فما بطروا","فيه وكم نالهم دهرٌ فما خضعوا",17,"ع",3,0],["كم نعمة أسبغتها للورى","فهي على عرض الورى سابغه",18,"غ",2,0],["كم نائحٍ كالصدى مثلي على ولدٍ","يقول واحرقي إن قلت واحرقي",19,"ي",1,0],["كم نِضْوِ شُكرٍ نَضَوْا عنه وليَّتَهُ","فظهرُهُ مستريحٌ غيرُ مُعْتقَبِ",20,"ب",1,0],["كم نوالٍ مباركٍ لك قد قا","د نوالاً إليَّ طوعَ الجنابِ",21,"ب",1,0],["كم نُسام الأذى كأنَّا كلابُ","كَمْ إلى كَمْ يكون هذا العتابُ",22,"ب",1,1],["كم نظرةٍ فيها تَقَصَّيتها","كم وقفةٍ فيها توقَّفْتُها",23,"ت",3,0],["كمن دحرجَ درَّ البح","رِ فيِ بَخرِ البلاليعِ",24,"ع",1,0],["كمنطقة الجوزاء لاحت بسحرة","بعقب غمام لائح ثم أقشعا",25,"ع",2,0],["كم نظيرلك في الثر","وة أكدى حين أبقى",26,"ق",2,0],["كم نعمة منك لا يقر بها","ينطق عنها ذرورُ شارقها",27,"ق",3,0],["كم نوبة يذعر الزمان لها","يُعدُّه أهله لطارقها",27,"ق",3,0],["كم نوال لكم بَكورٍ طروقٍ","قد كفى نوبة بكوراً طروقا",28,"ق",2,0],["كم نعمةٍ لك ملء فِكْ","رِي لا تُلاحِظها بفِكْرِكْ",29,"ك",1,0],["كَمَن يَمشي إِلى الوِزرِ عامِداً","وَيَضحَكُ مُختالاً إِذا مَسَّهُ الوِزرُ",30,"ر",1,0],["كَم نائِمٍ في وَكرِهِ هانِئٍ","نَبَّهتِهِ مِن وَكرِهِ باكِرا",31,"ر",2,0],["كَم ناكِصٍ عَن مَأزَقٍ خَوفَ الرَدى","طَلَعَ الرَدى مِنَ خَلفِهِ يَتَصَلصَلُ",32,"ل",1,0],["كَمَنجَةيَ الشَوّا عَلَيكِ السَلام","بِهَيكَلِ الوَحيِ وَعَرشِ الغَرام",33,"م",1,1],["كَمَن باعَ بِالإِثمِ التُقى وَتَفَرَّقَت","بِهِ طُرُقُ الدُنيا وَنَيلٌ مُتَرَّحُ",34,"ح",1,0],["كم نسوةٍ قتلت ظلما بعولتها","فصرن يهملن دمعاً قبله صينا",35,"ن",2,0],["كم نباهي بلحد ميت وكم نح","مل من هادم ولم يبن مَنَّا",36,"ن",2,0],["كَم نَستَعيرُ الآخَرينَ وَنَجتَدي","هَيهاتَ ما لِلعارِياتِ دَوامُ",37,"م",1,0],["كَم نائِمٍ لا يَراها وَهيَ ساهِرَةٌ","لَولا الأَمانِيُّ وَالأَحلامُ لَم يَنَمِ",38,"م",1,0],["كَم ناهِدٍ في اللّاعِباتِ صَغيرَةٍ","أَلهَتهُ عَن حَفَدٍ بِمِصرَ صِغارِ",39,"ر",1,0],["كَم نَظرَةٍ لي خِلالَ الشامِ لَو وَصَلَت","رَوَّت غَليلَ فُؤادٍ مِنكِ مُلتاحِ",40,"ح",1,0],["كَم نِعمَةٍ لَكَ لَم تَخَلها تَلتَوي","باتَت تَقَلقَلُ طَوعَ بَيتٍ شارِدِ",41,"د",1,0],["كَمَنعِ أَبي لَيلى عِياضَ بنَ دَيهَثٍ","عَشِيَّةَ خافَ القَومُ أَن يَتَمَزَّعا",42,"ع",2,0],["كم نعمة ألبست من نعمان","لم تلقها الأعضاء بالكفران",43,"ن",1,1],["كم نِعمةٍ للرَّبيع جادَ بها","ونَقمةٍ كالحريقِ أطفَاها",44,"ا",3,0],["كَم نِعمَةٍ لَم تَستَقِلُّ بِشُكرِها","لِلّهِ في طَيِّ المَكارِهِ كامِنَه",45,"ه",1,0],["كَم نِعمَةٍ لا أَستَطيعُ بُلوغَها","جُهداً وَلو أَعلَمتُ طاقَة مقوَلِ",46,"ل",1,0],["كَم نَغَّصَ الدَهرُ مِن مَبيتِ","عَلى سَريرٍ وَمِن مَقيلِ",47,"ل",1,0],["كَم نافَسَ المَرءُ في شَيءٍ وَكايَدَ في","هِ الناسَ ثُمَّ مَضى عَنهُ وَخَلّاهُ",48,"ا",2,0],["كَم نِعمَةٍ لا يُستَقَلُّ بِشُكرِها","لِلَّهِ في طَيِّ المَكارِهِ كامِنَه",49,"ه",1,1],["كم نداء خافت مبتعد","تشتهي أذن الهوى أن تستعيده",50,"ه",1,0],["كمنْجَلٍ قد صِيغَ من عَسْجَدٍ","يحصُدُ من زَهْرِ الرّبى نَرْجِسَا",51,"س",2,0],["كَمُنَعَّمِ الأطرافِ بَلّلَهُ","شَرَقُ النسيم بريقِهِ الوَسْمي",52,"ي",1,0],["كَمَن جَعَلَ الحَضيضَ لَهُ مِهاداً","وَيَزعُمُ أَنَّ إِخوَتَهُ النُجومُ",53,"م",1,0],["كَم نادَمَت أَسيافُنا أَرماحَهُم","بَينَ الجُيوشِ عَلى دَمٍ يَتَرَقرَقُ",54,"ق",1,0],["كَم نَفحَةٍ لَكَ لَم يُحفَظ تَذَمُّمُها","لِصامِتِ المالِ لا إِلّا وَلا ذِمَما",55,"م",2,0],["كَم نِعمَةٍ لِلَّهِ كانَت عِندَهُ","فَكَأَنَّها في غُربَةٍ وَإِسارِ",56,"ر",1,0],["كَم نِعمَةٍ زَيَّنَتَني بِسُموطِها","كَالعِقدِ في عُنُقِ الكِعابِ الناهِدِ",57,"د",1,0],["كَم نيلَ تَحتَ سَناها مِن سَنا قَمَرٍ","وَتَحتَ عارِضِها مِن عارِضٍ شَنِبِ",58,"ب",1,0],["كمْ نالَ بالتدبيرِ مَنْ هو صابرٌ","ما لمْ ينلْهُ بعسكرٍ جرارِ",59,"ر",1,0],["كَم نَكبَةٍ فَدَحَت وَكَم مِن غَمرَةٍ","خُضنا بِها الأَهوالَ وَالأَخطارا",60,"ر",2,0],["كَم نَهاني عَن حُبِّ موسى أُناسٌ","عَذَلوني فَإِن بَدا عَذَروني",61,"ن",2,0],["كَم نَكَّروا مِن مَعلَمٍ كَم دَمَّروا","مِن مَعشَرٍ كَم غَيَّروا مِن مَشعَرِ",62,"ر",1,0],["كَم نَذيرٍ بَدا لِعَينيهِ حَتّى","قامَ شَخص الرَدى هُناكَ سَويّا",63,"ي",2,0],["كَم نِعمَةٍ عَرِفَ الإِخوانُ صاحِبَها","لَمّا مَضَت أَنكَروهُ بَعدَ عِرفانِ",64,"ن",1,0],["كَمِنجَلٍ قَد صيغَ مِن فِضَّةٍ","يَحصُدُ مِن زُهرِ الدُجى نَرجِسا",65,"س",2,0],["كمَنْ لامَ نَفْساً وهي غَيرُ ملُومَةٍ","وأُفْحِمَ ظَنّاً وهو ليس بمُفحم",66,"م",1,0],["كَمَنِ الشَنآنُ فيهِ لَنا","كَكُمونِ النارِ في حَجَرِه",67,"ر",2,0],["كَمَن أَرادَ بِشَيءٍ","سَماجَةً فَتَجَلّى",68,"ل",2,0],["كَمَن أَلقاهُ في سِرٍّ وَجَهرٍ","وَأَطمَعُ مِنهُ في رَدِّ السَلامِ",69,"م",1,0],["كَم نارِ حَربِ ضَلالَةٍ أَطفَأتَها","وَرُضاعِ جَهلٍ كِدتَهُ 