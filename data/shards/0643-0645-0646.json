.aldiwan.net/poem61621.html","الخفيف"],[460,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[460,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[460,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[460,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[460,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[463,"وإني ومدحي أبا جعفر","https://www.aldiwan.net/poem16149.html","المتقارب"],[466,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[466,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[466,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[466,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[466,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[466,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[467,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[470,"كم نعرة طولتها","https://www.aldiwan.net/poem59604.html","مجزوء الكامل"],[470,"لا تقرضن يا فار لي ذمة","https://www.aldiwan.net/poem59787.html","السريع"],[479,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[481,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[481,"يكون المرء مضطرا لجرم","https://www.aldiwan.net/poem37016.html","الوافر"],[481,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[502,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[502,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[502,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[502,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[515,"أبى لي الوفاء دوام الجفا","https://www.aldiwan.net/poem67694.html","المتقارب"],[516,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[516,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[516,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[531,"وطالب الدنيا بعل","https://www.aldiwan.net/poem37364.html","مجزوء الرجز"],[531,"وكم من طواغيت يجر زمامها","https://www.aldiwan.net/poem37490.html","الطويل"],[538,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[540,"أسدل الشعر هالة للجبين","https://www.aldiwan.net/poem47608.html","عموديه"],[540,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[542,"يا دار سعدى بالجزع من ملل","https://www.aldiwan.net/poem56706.html","المنسرح"],[546,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[553,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[553,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[553,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[555,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[560,"وجدت كنزا هنا هو البركه","https://www.aldiwan.net/poem33508.html","المنسرح"],[560,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[560,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[560,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[560,"رويدا أيها النفس المراشه","https://www.aldiwan.net/poem34428.html","الوافر"],[564,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[564,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[569,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[577,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[577,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[577,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[577,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[581,"سألت الذي لاينفذ الرزق عنده","https://www.aldiwan.net/poem56779.html","الطويل"],[588,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18746","الوافر"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/198365","الرجز"]],"verses":[["كمن بات بالحمى خلافا لما به","يرى يشتكي بردا وما انفك لاهب",0,"ب",1,0],["كَمَن صارَعَ الأَسَدَ المُستَغي","رَ في الغابِ أَو ساوَرَ الأَرقَما",1,"م",2,0],["كَمَن بادَلَ الإِجلاءَ في العَينِ بِالقَذى","وَآبَ بِداءٍ لا يُطَبُّ عُضالُ",2,"ل",1,0],["كَم نِعمَةٍ مِنكَ كَاللَطيمَةِ مَس","راها نَمومٌ وَعَرفُها ثَمَلُ",3,"ل",1,0],["كَم نَفحَةٍ مِنهُ عَلى فاقَةٍ","تُنبِتُ عُشبَ البَلَدِ البَلقَعِ",4,"ع",1,0],["كَم نَظرَةٍ مِنكَ تَشفي النَفسَ عَن عَرَضٍ","وَتُرجِعُ القَلبَ مِنِّ جِدَّ مُنتَكِسِ",5,"س",1,0],["كَم نَفَّرَت مِن شَجوِ قَلبٍ نافِرٍ","وَاِستَمطَرَت مِن دَمعِ عَينٍ مُمطِرِ",6,"ر",1,0],["كَم نَأى بِالنَفرِ عَنّا","مِن غَزالٍ وَمَهاةِ",7,"ه",1,0],["كَم نِعمَةٍ لَكَ يا مَحمودُ عِندَ أَبي","بِشُكرِها لَكَ عِندَ المَوتِ أَوصاني",8,"ن",2,0],["كَم نَفَّسَت عَن صَدرِ حُرٍّ واجِدٍ","لَولا الصِمامُ مِنَ الأَسى لَتَمَزَّقا",9,"ق",2,0],["كَم نَفثَةٍ لَكَ تَستَثيرُ بِها الهَوى","هاروتُ في أَثنائِها يَتَكَلَّمُ",10,"م",1,0],["كَم نُفوسٍ قَد سَلَّها مِن يَدِ المَو","تِ بِلُطفٍ مِنهُ وَكَم سَلَّ داءَ",11,"ا",2,0],["كَم نَظرَةٍ لَكَ في عَيني عَلِمتَ بِها","يَومَ الزِيارَةِ أَنَّ القَلبَ قَد ذابا",12,"ب",2,0],["كَم نَفَسّوا كَربَ مَكروبٍ وَكَم صَبَروا","عَلى الشَدائِدِ مِن لَأواءَ فَاِنجَلَتِ",13,"ت",1,0],["كم نشرب الظنّ فلا نرتوي","ونأكل الحدس فلا نشبع",14,"ع",1,0],["كم نعمةٍ لك مهما","نظرتُ كانت إزائي",15,"ا",3,0],["كم نعمة سبحت عن بيت سؤدده","في الخافقين وكم من مدحة سرحت",16,"ت",1,0],["كم نعمة تقوية أفضت بها","سور الثنا للحمد والإخلاص",17,"ص",1,1],["كم نالَ سعيهمو جدّ فما بطروا","فيه وكم نالهم دهرٌ فما خضعوا",18,"ع",3,0],["كم نعمة أسبغتها للورى","فهي على عرض الورى سابغه",19,"غ",2,0],["كم نائحٍ كالصدى مثلي على ولدٍ","يقول واحرقي إن قلت واحرقي",20,"ق",2,0],["كم نِضْوِ شُكرٍ نَضَوْا عنه وليَّتَهُ","فظهرُهُ مستريحٌ غيرُ مُعْتقَبِ",21,"ب",1,0],["كم نوالٍ مباركٍ لك قد قا","د نوالاً إليَّ طوعَ الجنابِ",22,"ب",1,0],["كم نُسام الأذى كأنَّا كلابُ","كَمْ إلى كَمْ يكون هذا العتابُ",23,"ب",1,1],["كم نظرةٍ فيها تَقَصَّيتها","كم وقفةٍ فيها توقَّفْتُها",24,"ت",3,0],["كمن دحرجَ درَّ البح","رِ فيِ بَخرِ البلاليعِ",25,"ع",1,0],["كمنطقة الجوزاء لاحت بسحرة","بعقب غمام لائح ثم أقشعا",26,"ع",2,0],["كم نظيرلك في الثر","وة أكدى حين أبقى",27,"ق",2,0],["كم نعمة منك لا يقر بها","ينطق عنها ذرورُ شارقها",28,"ق",3,0],["كم نوبة يذعر الزمان لها","يُعدُّه أهله لطارقها",28,"ق",3,0],["كم نوال لكم بَكورٍ طروقٍ","قد كفى نوبة بكوراً طروقا",29,"ق",2,0],["كم نعمةٍ لك ملء فِكْ","رِي لا تُلاحِظها بفِكْرِكْ",30,"ك",1,0],["كَمَن يَمشي إِلى الوِزرِ عامِداً","وَيَضحَكُ مُختالاً إِذا مَسَّهُ الوِزرُ",31,"ر",1,0],["كَم نائِمٍ في وَكرِهِ هانِئٍ","نَبَّهتِهِ مِن وَكرِهِ باكِرا",32,"ر",2,0],["كَم ناكِصٍ عَن مَأزَقٍ خَوفَ الرَدى","طَلَعَ الرَدى مِنَ خَلفِهِ يَتَصَلصَلُ",33,"ل",1,0],["كَمَنجَةيَ الشَوّا عَلَيكِ السَلام","بِهَيكَلِ الوَحيِ وَعَرشِ الغَرام",34,"م",1,1],["كَمَن باعَ بِالإِثمِ التُقى وَتَفَرَّقَت","بِهِ طُرُقُ الدُنيا وَنَيلٌ مُتَرَّحُ",35,"ح",1,0],["كم نسوةٍ قتلت ظلما بعولتها","فصرن يهملن دمعاً قبله صينا",36,"ن",2,0],["كم نباهي بلحد ميت وكم نح","مل من هادم ولم يبن مَنَّا",37,"ن",2,0],["كَم نَستَعيرُ الآخَرينَ وَنَجتَدي","هَيهاتَ ما لِلعارِياتِ دَوامُ",38,"م",1,0],["كَم نائِمٍ لا يَراها وَهيَ ساهِرَةٌ","لَولا الأَمانِيُّ وَالأَحلامُ لَم يَنَمِ",39,"م",1,0],["كَم ناهِدٍ في اللّاعِباتِ صَغيرَةٍ","أَلهَتهُ عَن حَفَدٍ بِمِصرَ صِغارِ",40,"ر",1,0],["كَم نَظرَةٍ لي خِلالَ الشامِ لَو وَصَلَت","رَوَّت غَليلَ فُؤادٍ مِنكِ مُلتاحِ",41,"ح",1,0],["كَم نِعمَةٍ لَكَ لَم تَخَلها تَلتَوي","باتَت تَقَلقَلُ طَوعَ بَيتٍ شارِدِ",42,"د",1,0],["كَمَنعِ أَبي لَيلى عِياضَ بنَ دَيهَثٍ","عَشِيَّةَ خافَ القَومُ أَن يَتَمَزَّعا",43,"ع",2,0],["كم نعمة ألبست من نعمان","لم تلقها الأعضاء بالكفران",44,"ن",1,1],["كم نِعمةٍ للرَّبيع جادَ بها","ونَقمةٍ كالحريقِ أطفَاها",45,"ا",3,0],["كَم نِعمَةٍ لَم تَستَقِلُّ بِشُكرِها","لِلّهِ في طَيِّ المَكارِهِ كامِنَه",46,"ه",1,0],["كَم نِعمَةٍ لا أَستَطيعُ بُلوغَها","جُهداً وَلو أَعلَمتُ طاقَة مقوَلِ",47,"ل",1,0],["كَم نَغَّصَ الدَهرُ مِن مَبيتِ","عَلى سَريرٍ وَمِن مَقيلِ",48,"ل",1,0],["كَم نافَسَ المَرءُ في شَيءٍ وَكايَدَ في","هِ الناسَ ثُمَّ مَضى عَنهُ وَخَلّاهُ",49,"ا",2,0],["كَم نِعمَةٍ لا يُستَقَلُّ بِشُكرِها","لِلَّهِ في طَيِّ المَكارِهِ كامِنَه",50,"ه",1,1],["كم نداء خافت مبتعد","تشتهي أذن الهوى أن تستعيده",51,"ه",1,0],["كَمَن تَعَدَّى بَغيُهُ قَومَهُ","طارَ إِلى رَبِّ اللِواءِ الخَفوق",52,"ق",1,0],["كمنْجَلٍ قد صِيغَ من عَسْجَدٍ","يحصُدُ من زَهْرِ الرّبى نَرْجِسَا",53,"س",2,0],["كَمُنَعَّمِ الأطرافِ بَلّلَهُ","شَرَقُ النسيم بريقِهِ الوَسْمي",54,"م",2,0],["كَمَن جَعَلَ الحَضيضَ لَهُ مِهاداً","وَيَزعُمُ أَنَّ إِخوَتَهُ النُجومُ",55,"م",1,0],["كَم نادَمَت أَسيافُنا أَرماحَهُم","بَينَ الجُيوشِ عَلى دَمٍ يَتَرَقرَقُ",56,"ق",1,0],["كَم نَفحَةٍ لَكَ لَم يُحفَظ تَذَمُّمُها","لِصامِتِ المالِ لا إِلّا وَلا ذِمَما",57,"م",2,0],["كَم نِعمَةٍ لِلَّهِ كانَت عِندَهُ","فَكَأَنَّها في غُربَةٍ وَإِسارِ",58,"ر",1,0],["كَم نِعمَةٍ زَيَّنَتَني بِسُموطِها","كَالعِقدِ في عُنُقِ الكِعابِ الناهِدِ",59,"د",1,0],["كَم نيلَ تَحتَ سَناها مِن سَنا قَمَرٍ","وَتَحتَ عارِضِها مِن عارِضٍ شَنِبِ",60,"ب",1,0],["كمْ نالَ بالتدبيرِ مَنْ هو صابرٌ","ما لمْ ينلْهُ بعسكرٍ جرارِ",61,"ر",1,0],["كَم نَكبَةٍ فَدَحَت وَكَم مِن غَمرَةٍ","خُضنا بِها الأَهوالَ وَالأَخطارا",62,"ر",2,0],["كَم نَهاني عَن حُبِّ موسى أُناسٌ","عَذَلوني فَإِن بَدا عَذَروني",63,"ن",2,0],["كَم نَكَّروا مِن مَعلَمٍ كَم دَمَّروا","مِن مَعشَرٍ كَم غَيَّروا مِن مَشعَرِ",64,"ر",1,0],["كَم نَذيرٍ بَدا لِعَينيهِ حَتّى","قامَ شَخص الرَدى هُناكَ سَويّا",65,"ي",2,0],["كَم نِعمَةٍ عَرِفَ الإِخوانُ صاحِبَها","لَمّا مَضَت أَنكَروهُ بَعدَ عِرفانِ",66,"ن",1,0],["كَمِنجَلٍ قَد صيغَ مِن فِضَّةٍ","يَحصُدُ مِن زُهرِ الدُجى نَرجِسا",67,"س",2,0],["كمَنْ لامَ نَفْساً وهي غَيرُ ملُومَةٍ","وأُفْحِمَ ظَنّاً وهو ليس بمُفحم",68,"م",1,0],["كَمَنِ الشَنآنُ فيهِ لَنا","كَكُمونِ النارِ في حَجَرِه",69,"ر",2,0],["كَمَن أَرادَ بِشَيءٍ","سَماجَةً فَتَجَلّى",70,"ل",2,0],["كَمَن أَلقاهُ في سِرٍّ وَجَهرٍ","وَأَطمَعُ مِنهُ في رَدِّ السَلامِ",71,"م",1,0],["كَم نارِ حَربِ ضَلالَةٍ أَطفَأتَها","وَرُضاعِ جَهلٍ كِدتَهُ بِفِطامِ",72,"م",1,0],["كَم نالَ أَطيَبَ مَطعَمٍ هِلباجَةٌ","أَشِرٌ وَأَعوَزَ حُرَّةً هِلباجُها",73,"ج",3,0],["كَم نِعمَةٍ لِلَّهِ يَحسِبُها اِمرُؤٌ","بِالشَحطِ وَهِيَ قَريبَةُ المُزدارِ",74,"ر",1,0],["كَم نالَ قَبلَكَ في طَعّامِكَ مِن يَدٍ","نَصَبٌ إِلى أَن لاسَ قُوتَكَ لائِسُ",75,"س",1,0],["كَم نجوم يخفين بعد ظهور","وَنجوم يظهرن بعد خفاء",76,"ا",2,0],["كمنَ الغدر لهُ ثم رمى","عن يدٍ عسراءَ شعواءَ الرّماءْ",77,"ا",2,0],["كَمْ نِعْمَةٍ عِنْدَ البَخِيلِ فَقِيدَةٌ","جَعَلْتَ عَطَاءَ اللهِ كَالتَّطْفِيلِ",78,"ل",1,0],["كَمْ نَشَّأَ النِشءَ الضَّعِيفَ وَصَانَهُ","فَأُعِدَّ جِيلٌ لِلْبلادِ جَدِيدُ",79,"د",1,0],["كَمْ نُفُوسٍ مَلَكْتَهُنَّ بِنُعْمَى","وَصَلَتْ مَا قَطَعْنَهُ مِنْ رَجَاءٍ",80,"ا",2,0],["كم نحول يشفّ عن نفس جبار","جريءٍ الفعال ضخم الرغاب",81,"ب",1,0],["كم نشقنا تُقىً هناك وقُدساً","كيف أنسى",82,"ا",1,0],["كم نظرنا من كوتيك إلى الكون","وهل تعرف الطفولة شرا",83,"ر",2,0],["كَمَن فَرَّ مِنَ القَطرِ","فَصارَ القَطرُ ميزابا",84,"ب",2,0],["كم نبت أسيافنا في ملعب","وكبت أفراسنا في ملعب",85,"ب",1,0],["كَمْ نَدَبْنَا الشَّبَابَ حِينَ تَولى","وَشُغِفْنَا بالْبَدْرِ بَعْدَ احْتِجَابِهْ",86,"ب",2,0],["كم ناغم الشرق في مواجعه","وهلّلت في سمائها غرره",87,"ر",2,0],["كم نعمنا به زماناً فلمّا","طاح عشنا في ذكريات زمانِهْ",88,"ن",2,0],["كم نكتَة فيه كادت","تخفَى على كُلِّ ظن",89,"ن",1,0],["كَمْ نِلْتِ بالْعِلْمِ مِنْ مَقَامِ","وِنلتِ بالْجِدِّ مِنْ مَرَامِ",90,"م",1,0],["كم نمقوا صُوَراً شتَّى وكَمْ خلَقُوا","للغدْرِ والفتكِ أشكالاً أفَانينَا",91,"ن",2,0],["كم ناشدتنا شفاه فيك ضارعة","وكم دعانا عفاف منك مسلوب",92,"ب",1,0],["كم نوينا الصومَ، لا عن حِسبَةٍ","أتُرى، يا صاحِ، قد عِفتَ الصياما؟",93,"م",2,0],["كم نسجتَ الثيابَ من غير نولٍ","ثم وشَّيتها بألف دهان",94,