63190.html","البسيط"],[49,"كم نعمة لا يستقل بشكرها","https://www.aldiwan.net/poem65334.html","الكامل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[80,"انظر إلى حسن هلال بدا","https://www.aldiwan.net/poem31226.html","السريع"],[80,"أظلوم منك تعلمت ظلمي","https://www.aldiwan.net/poem31314.html","أحذ الكامل"],[44,"أتدري أي بارقة تشيم","https://www.aldiwan.net/poem30002.html","الوافر"],[44,"أعلي يقدم عتبة المستحلق","https://www.aldiwan.net/poem30019.html","الكامل"],[44,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[44,"أرويت ظمآن الصعيد الهامد","https://www.aldiwan.net/poem30549.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[105,"إنا أتينا بالثناء نسوقه","https://www.aldiwan.net/poem43402.html","الكامل"],[81,"رع بجيش اللذات سرب الشجون","https://www.aldiwan.net/poem61479.html","الخفيف"],[81,"وردا فمضمون نجاح المصدر","https://www.aldiwan.net/poem61521.html","الكامل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[52,"انظر إلى حسن هلال بدا","https://www.aldiwan.net/poem26901.html","السريع"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[48,"يا من تمره عمدا","https://www.aldiwan.net/poem65012.html","المجتث"],[48,"غنيت عن الكواعب بالغلام","https://www.aldiwan.net/poem65250.html","الوافر"],[48,"ما حاجة أولى بنجح عاجل","https://www.aldiwan.net/poem65260.html","الكامل"],[46,"لا تفخرن معاشر بقديمها","https://www.aldiwan.net/poem22247.html","الكامل"],[46,"عاين أواخر كائن بأوائل","https://www.aldiwan.net/poem22724.html","الكامل"],[46,"جنت الغوارس واستقل أخو الغني","https://www.aldiwan.net/poem22806.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55189","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141950","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142345","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[58,"الحَمْدُ للِه الجَمِيْلِ المُفْضِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=22769",""],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""],[91,"كمنجة الشوا","https://www.poetsgate.com/ViewPoem.aspx?id=53301",""],[91,"عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=53082",""],[51,"لئامٌ كالخنازير","https://www.poetsgate.com/ViewPoem.aspx?id=29342",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["كَمَن صارَعَ الأَسَدَ المُستَغي","رَ في الغابِ أَو ساوَرَ الأَرقَما",0,"م",2,0],["كَمَن بادَلَ الإِجلاءَ في العَينِ بِالقَذى","وَآبَ بِداءٍ لا يُطَبُّ عُضالُ",1,"ل",1,0],["كَم نِعمَةٍ مِنكَ كَاللَطيمَةِ مَس","راها نَمومٌ وَعَرفُها ثَمَلُ",2,"ل",1,0],["كَم نَفحَةٍ مِنهُ عَلى فاقَةٍ","تُنبِتُ عُشبَ البَلَدِ البَلقَعِ",3,"ع",1,0],["كَم نَظرَةٍ مِنكَ تَشفي النَفسَ عَن عَرَضٍ","وَتُرجِعُ القَلبَ مِنِّ جِدَّ مُنتَكِسِ",4,"س",1,0],["كَم نَفَّرَت مِن شَجوِ قَلبٍ نافِرٍ","وَاِستَمطَرَت مِن دَمعِ عَينٍ مُمطِرِ",5,"ر",1,0],["كَم نَأى بِالنَفرِ عَنّا","مِن غَزالٍ وَمَهاةِ",6,"ه",1,0],["كَم نِعمَةٍ لَكَ يا مَحمودُ عِندَ أَبي","بِشُكرِها لَكَ عِندَ المَوتِ أَوصاني",7,"ي",1,0],["كَم نَفَّسَت عَن صَدرِ حُرٍّ واجِدٍ","لَولا الصِمامُ مِنَ الأَسى لَتَمَزَّقا",8,"ق",2,0],["كَم نَفثَةٍ لَكَ تَستَثيرُ بِها الهَوى","هاروتُ في أَثنائِها يَتَكَلَّمُ",9,"م",1,0],["كَم نُفوسٍ قَد سَلَّها مِن يَدِ المَو","تِ بِلُطفٍ مِنهُ وَكَم سَلَّ داءَ",10,"ا",2,0],["كَم نَظرَةٍ لَكَ في عَيني عَلِمتَ بِها","يَومَ الزِيارَةِ أَنَّ القَلبَ قَد ذابا",11,"ب",2,0],["كَم نَفَسّوا كَربَ مَكروبٍ وَكَم صَبَروا","عَلى الشَدائِدِ مِن لَأواءَ فَاِنجَلَتِ",12,"ت",1,0],["كم نشرب الظنّ فلا نرتوي","ونأكل الحدس فلا نشبع",13,"ع",1,0],["كم نعمةٍ لك مهما","نظرتُ كانت إزائي",14,"ا",3,0],["كم نعمة سبحت عن بيت سؤدده","في الخافقين وكم من مدحة سرحت",15,"ت",1,0],["كم نعمة تقوية أفضت بها","سور الثنا للحمد والإخلاص",16,"ص",1,1],["كم نالَ سعيهمو جدّ فما بطروا","فيه وكم نالهم دهرٌ فما خضعوا",17,"ع",3,0],["كم نعمة أسبغتها للورى","فهي على عرض الورى سابغه",18,"غ",2,0],["كم نائحٍ كالصدى مثلي على ولدٍ","يقول واحرقي إن قلت واحرقي",19,"ي",1,0],["كم نِضْوِ شُكرٍ نَضَوْا عنه وليَّتَهُ","فظهرُهُ مستريحٌ غيرُ مُعْتقَبِ",20,"ب",1,0],["كم نوالٍ مباركٍ لك قد قا","د نوالاً إليَّ طوعَ الجنابِ",21,"ب",1,0],["كم نُسام الأذى كأنَّا كلابُ","كَمْ إلى كَمْ يكون هذا العتابُ",22,"ب",1,1],["كم نظرةٍ فيها تَقَصَّيتها","كم وقفةٍ فيها توقَّفْتُها",23,"ت",3,0],["كمن دحرجَ درَّ البح","رِ فيِ بَخرِ البلاليعِ",24,"ع",1,0],["كمنطقة الجوزاء لاحت بسحرة","بعقب غمام لائح ثم أقشعا",25,"ع",2,0],["كم نظيرلك في الثر","وة أكدى حين أبقى",26,"ق",2,0],["كم نعمة منك لا يقر بها","ينطق عنها ذرورُ شارقها",27,"ق",3,0],["كم نوبة يذعر الزمان لها","يُعدُّه أهله لطارقها",27,"ق",3,0],["كم نوال لكم بَكورٍ طروقٍ","قد كفى نوبة بكوراً طروقا",28,"ق",2,0],["كم نعمةٍ لك ملء فِكْ","رِي لا تُلاحِظها بفِكْرِكْ",29,"ك",1,0],["كَمَن يَمشي إِلى الوِزرِ عامِداً","وَيَضحَكُ مُختالاً إِذا مَسَّهُ الوِزرُ",30,"ر",1,0],["كَم نائِمٍ في وَكرِهِ هانِئٍ","نَبَّهتِهِ مِن وَكرِهِ باكِرا",31,"ر",2,0],["كَم ناكِصٍ عَن مَأزَقٍ خَوفَ الرَدى","طَلَعَ الرَدى مِنَ خَلفِهِ يَتَصَلصَلُ",32,"ل",1,0],["كَمَنجَةيَ الشَوّا عَلَيكِ السَلام","بِهَيكَلِ الوَحيِ وَعَرشِ الغَرام",33,"م",1,1],["كَمَن باعَ بِالإِثمِ التُقى وَتَفَرَّقَت","بِهِ طُرُقُ الدُنيا وَنَيلٌ مُتَرَّحُ",34,"ح",1,0],["كم نسوةٍ قتلت ظلما بعولتها","فصرن يهملن دمعاً قبله صينا",35,"ن",2,0],["كم نباهي بلحد ميت وكم نح","مل من هادم ولم يبن مَنَّا",36,"ن",2,0],["كَم نَستَعيرُ الآخَرينَ وَنَجتَدي","هَيهاتَ ما لِلعارِياتِ دَوامُ",37,"م",1,0],["كَم نائِمٍ لا يَراها وَهيَ ساهِرَةٌ","لَولا الأَمانِيُّ وَالأَحلامُ لَم يَنَمِ",38,"م",1,0],["كَم ناهِدٍ في اللّاعِباتِ صَغيرَةٍ","أَلهَتهُ عَن حَفَدٍ بِمِصرَ صِغارِ",39,"ر",1,0],["كَم نَظرَةٍ لي خِلالَ الشامِ لَو وَصَلَت","رَوَّت غَليلَ فُؤادٍ مِنكِ مُلتاحِ",40,"ح",1,0],["كَم نِعمَةٍ لَكَ لَم تَخَلها تَلتَوي","باتَت تَقَلقَلُ طَوعَ بَيتٍ شارِدِ",41,"د",1,0],["كَمَنعِ أَبي لَيلى عِياضَ بنَ دَيهَثٍ","عَشِيَّةَ خافَ القَومُ أَن يَتَمَزَّعا",42,"ع",2,0],["كم نعمة ألبست من نعمان","لم تلقها الأعضاء بالكفران",43,"ن",1,1],["كم نِعمةٍ للرَّبيع جادَ بها","ونَقمةٍ كالحريقِ أطفَاها",44,"ا",3,0],["كَم نِعمَةٍ لَم تَستَقِلُّ بِشُكرِها","لِلّهِ في طَيِّ المَكارِهِ كامِنَه",45,"ه",1,0],["كَم نِعمَةٍ لا أَستَطيعُ بُلوغَها","جُهداً وَلو أَعلَمتُ طاقَة مقوَلِ",46,"ل",1,0],["كَم نَغَّصَ الدَهرُ مِن مَبيتِ","عَلى سَريرٍ وَمِن مَقيلِ",47,"ل",1,0],["كَم نافَسَ المَرءُ في شَيءٍ وَكايَدَ في","هِ الناسَ ثُمَّ مَضى عَنهُ وَخَلّاهُ",48,"ا",2,0],["كَم نِعمَةٍ لا يُستَقَلُّ بِشُكرِها","لِلَّهِ في طَيِّ المَكارِهِ كامِنَه",49,"ه",1,1],["كم نداء خافت مبتعد","تشتهي أذن الهوى أن تستعيده",50,"ه",1,0],["كمنْجَلٍ قد صِيغَ من عَسْجَدٍ","يحصُدُ من زَهْرِ الرّبى نَرْجِسَا",51,"س",2,0],["كَمُنَعَّمِ الأطرافِ بَلّلَهُ","شَرَقُ النسيم بريقِهِ الوَسْمي",52,"ي",1,0],["كَمَن جَعَلَ الحَضيضَ لَهُ مِهاداً","وَيَزعُمُ أَنَّ إِخوَتَهُ النُجومُ",53,"م",1,0],["كَم نادَمَت أَسيافُنا أَرماحَهُم","بَينَ الجُيوشِ عَلى دَمٍ يَتَرَقرَقُ",54,"ق",1,0],["كَم نَفحَةٍ لَكَ لَم يُحفَظ تَذَمُّمُها","لِصامِتِ المالِ لا إِلّا وَلا ذِمَما",55,"م",2,0],["كَم نِعمَةٍ لِلَّهِ كانَت عِندَهُ","فَكَأَنَّها في غُربَةٍ وَإِسارِ",56,"ر",1,0],["كَم نِعمَةٍ زَيَّنَتَني بِسُموطِها","كَالعِقدِ في عُنُقِ الكِعابِ الناهِدِ",57,"د",1,0],["كَم نيلَ تَحتَ سَناها مِن سَنا قَمَرٍ","وَتَحتَ عارِضِها مِن عارِضٍ شَنِبِ",58,"ب",1,0],["كمْ نالَ بالتدبيرِ مَنْ هو صابرٌ","ما لمْ ينلْهُ بعسكرٍ جرارِ",59,"ر",1,0],["كَم نَكبَةٍ فَدَحَت وَكَم مِن غَمرَةٍ","خُضنا بِها الأَهوالَ وَالأَخطارا",60,"ر",2,0],["كَم نَهاني عَن حُبِّ موسى أُناسٌ","عَذَلوني فَإِن بَدا عَذَروني",61,"ن",2,0],["كَم نَكَّروا مِن مَعلَمٍ كَم دَمَّروا","مِن مَعشَرٍ كَم غَيَّروا مِن مَشعَرِ",62,"ر",1,0],["كَم نَذيرٍ بَدا لِعَينيهِ حَتّى","قامَ شَخص الرَدى هُناكَ سَويّا",63,"ي",2,0],["كَم نِعمَةٍ عَرِفَ الإِخوانُ صاحِبَها","لَمّا مَضَت أَنكَروهُ بَعدَ عِرفانِ",64,"ن",1,0],["كَمِنجَلٍ قَد صيغَ مِن فِضَّةٍ","يَحصُدُ مِن زُهرِ الدُجى نَرجِسا",65,"س",2,0],["كمَنْ لامَ نَفْساً وهي غَيرُ ملُومَةٍ","وأُفْحِمَ ظَنّاً وهو ليس بمُفحم",66,"م",1,0],["كَمَنِ الشَنآنُ فيهِ لَنا","كَكُمونِ النارِ في حَجَرِه",67,"ر",2,0],["كَمَن أَرادَ بِشَيءٍ","سَماجَةً فَتَجَلّى",68,"ل",2,0],["كَمَن أَلقاهُ في سِرٍّ وَجَهرٍ","وَأَطمَعُ مِنهُ في رَدِّ السَلامِ",69,"م",1,0],["كَم نارِ حَربِ ضَلالَةٍ أَطفَأتَها","وَرُضاعِ جَهلٍ كِدتَهُ بِفِطامِ",70,"م",1,0],["كَم نالَ أَطيَبَ مَطعَمٍ هِلباجَةٌ","أَشِرٌ وَأَعوَزَ حُرَّةً هِلباجُها",71,"ج",3,0],["كَم نِعمَةٍ لِلَّهِ يَحسِبُها اِمرُؤٌ","بِالشَحطِ وَهِيَ قَريبَةُ المُزدارِ",72,"ر",1,0],["كَم نالَ قَبلَكَ في طَعّامِكَ مِن يَدٍ","نَصَبٌ إِلى أَن لاسَ قُوتَكَ لائِسُ",73,"س",1,0],["كَم نجوم يخفين بعد ظهور","وَنجوم يظهرن بعد خفاء",74,"ا",2,0],["كمنَ الغدر لهُ ثم رمى","عن يدٍ عسراءَ شعواءَ الرّماءْ",75,"ا",2,0],["كَمْ نِعْمَةٍ عِنْدَ البَخِيلِ فَقِيدَةٌ","جَعَلْتَ عَطَاءَ اللهِ كَالتَّطْفِيلِ",76,"ل",1,0],["كَمْ نَشَّأَ النِشءَ الضَّعِيفَ وَصَانَهُ","فَأُعِدَّ جِيلٌ لِلْبلادِ جَدِيدُ",77,"د",1,0],["كَمْ نُفُوسٍ مَلَكْتَهُنَّ بِنُعْمَى","وَصَلَتْ مَا قَطَعْنَهُ مِنْ رَجَاءٍ",78,"ا",2,0],["كم نحول يشفّ عن نفس جبار","جريءٍ الفعال ضخم الرغاب",79,"ب",1,0],["كم نشقنا تُقىً هناك وقُدساً","كيف أنسى",80,"ا",1,0],["كم نظرنا من كوتيك إلى الكون","وهل تعرف الطفولة شرا",81,"ر",2,0],["كَمَن فَرَّ مِنَ القَطرِ","فَصارَ القَطرُ ميزابا",82,"ب",2,0],["كم نبت أسيافنا في ملعب","وكبت أفراسنا في ملعب",83,"ب",1,0],["كَمْ نَدَبْنَا الشَّبَابَ حِينَ تَولى","وَشُغِفْنَا بالْبَدْرِ بَعْدَ احْتِجَابِهْ",84,"ب",2,0],["كم ناغم الشرق في مواجعه","وهلّلت في سمائها غرره",85,"ر",2,0],["كم نعمنا به زماناً فلمّا","طاح عشنا في ذكريات زمانِهْ",86,"ن",2,0],["كم نكتَة فيه كادت","تخفَى على كُلِّ ظن",87,"ن",1,0],["كَمْ نِلْتِ بالْعِلْمِ مِنْ مَقَامِ","وِنلتِ بالْجِدِّ مِنْ مَرَامِ",88,"م",1,0],["كم نمقوا صُوَراً شتَّى وكَمْ خلَقُوا","للغدْرِ والفتكِ أشكالاً أفَانينَا",89,"ن",2,0],["كم نوينا الصومَ، لا عن حِسبَةٍ","أتُرى، يا صاحِ، قد عِفتَ الصياما؟",90,"م",2,0],["كم نسجتَ الثيابَ من غير نولٍ","ثم وشَّيتها بألف دهان",91,"ن",1,0],["كم ناجح متفَوِّقٌ في درسه","دخل الحياةَ، فلم يَفُز بنجاحِ",92,"ح",1,0],["كم نال شاعر أُمَّةٍ بربابة","ما لم ينَلْهُ كمِيها بِجِرَابه",93,"ب",2,0],["كم نسفت النُّجُودَ نجدًا، فنجدًا","وفريت الصفاة بعد الصَّفاة",94,"ه",1,0],["كم ناطق تبع الهوى","فَلوى بغير الحق فاه",95,"ا",2,0],["كم نعمة لا أستطيع بلوغها","جهداً ولو اعملت طاقة مقول",96,"ل",1,0],["كم نفثةٍ لي قَنَّعتْ وجه الدجى","هماً وأوحت للسُها إخفاقها",97,"ق",3,0],["كمنجة ((الشوّا)) عليك السلام","بهيكل الوحي وعرش الغرام",98,"م",1,1],["كم نائم في وكره هانيء","نبّهته من وكره باكرا ؟",99,"ر",2,0],["كمن دحرجَ دُرَّ البح","رِ في بحرِ البلاليعِ",100,"ع",1,0],["كَمَنْ تَعَدَّى بَغْيُهُ قَوْمَهُ","طَارَ إِلَى رَبِّ اللِّوَاءِ الخَفُوقْ",101,"ق",1,0]]}