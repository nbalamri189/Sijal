{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64124","الرجز"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127396","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108054","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[5199,"لاتقول الناس بالانفس سوى","https://www.poetsgate.com/ViewPoem.aspx?id=146249",""],[5455,"ليل يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=34432",""]],"verses":[["يَوْمَ ذِكْرَاهُ مَا تَجَدَّدَ إِلاَّ","قَلَّدَتْهُ مَفَاخِرُ العَامِ عِقْدَا",0,"د",2,0],["يومٌ ذيولُ مُزنِهِ","على الثرى مُنسَحِبَهْ",1,"ب",2,1],["يوم ذل الإسلام وانتسفت في","أوجه المسلمين كئب رماد",2,"د",1,0],["يوم ذكرى جمعت كل قريب","وبعيد جاء يسعى ليراك",3,"ك",1,0],["يومٌ ذكرت به زماناً ماضياً","معه وما أحلى زمان المصطفى",4,"ف",2,0],["يَومَ ذَهَبنا نَحشِدُ العُمّالا","بَينَ الأَخائيينَ وَالأَبطالا",5,"ل",2,0],["يوم ذيب الحد بالمرقب عوى","النجوم بعرضها وبطولها",6,"ل",3,0],["يوم ذيك الصبية أم ذاك الجديل","جت تهادى وتمشي مثل مشي الحمام",7,"م",1,0]]}