/www.aldiwan.net/poem50135.html","الخفيف"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[406,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[406,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[409,"يا دار لو روت محولك أدمعي","https://www.aldiwan.net/poem31645.html","عموديه"],[409,"قل للذي فقد الأحبة وانثنى","https://www.aldiwan.net/poem31649.html","عموديه"],[409,"حملت ثقلي في السهل العصا","https://www.aldiwan.net/poem31946.html","الرمل"],[409,"أنا تاج فرسان الهياج ومن بهم","https://www.aldiwan.net/poem32190.html","الكامل"],[409,"أين السرور من المروع بالنوى","https://www.aldiwan.net/poem32360.html","الكامل"],[414,"تذكرت حرب الروم لما تطاولت","https://www.aldiwan.net/poem4485.html","الطويل"],[416,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[416,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[420,"أبل الرجال أردت إخاءهم","https://www.aldiwan.net/poem4851.html","الكامل"],[420,"وإذا رزقت من النوافل ثروة","https://www.aldiwan.net/poem4857.html","الكامل"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[432,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[432,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[432,"شعري كمجدك من يرمه مقصر","https://www.aldiwan.net/poem12631.html","الكامل"],[441,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[441,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[448,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[453,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[458,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[458,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[458,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[458,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[458,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[458,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[461,"طرب الزمان وأنجمت أشجانه","https://www.aldiwan.net/poem15145.html","الكامل"],[461,"عشت قطب الدين هطال الندى","https://www.aldiwan.net/poem16432.html","الرمل"],[477,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[495,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[499,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[500,"إياك عن عظم الغني من غفلة","https://www.aldiwan.net/poem37655.html","الكامل"],[500,"جرد لبر الشرق همة زائر","https://www.aldiwan.net/poem38011.html","الكامل"],[515,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[538,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[551,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[551,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[551,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[551,"ما ضر من رهب الملوك لو انه","https://www.aldiwan.net/poem47347.html","الكامل"],[551,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[551,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[551,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[551,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[551,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[551,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[551,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"ظهر الوجود الحق في مرآتنا","https://www.aldiwan.net/poem34219.html","الكامل"],[562,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[562,"القلب بين الصحب أعدل شاهد","https://www.aldiwan.net/poem52952.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[575,"تدعي العقل وهو أشرف ما فيك","https://www.aldiwan.net/poem2757.html","الخفيف"],[575,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"]],"verses":[["وَإِذا رَأَيتَهُمُ عَلى سَرَواتِها","أَبصَرتَ عِقباناً عَلى عِقبانِ",0,"ن",1,0],["وَإِذا رَآهُم لَم يَقُل مُتَمَثِّلاً","أَبَني الزَمانِ لِكُلِّ رَحبٍ ضيقُ",1,"ق",1,0],["وَإِذا رَمَيتَ مِنَ الحِذارِ بِمُقلَةٍ","في الجَوِّ راعَكَ في السَماءِ حَفيفي",2,"ي",1,0],["وَإِذا رَمَتكَ مِنَ الرِجالِ قَوارِصٌ","فَسِهامُ ذي القُربى القَريبَةِ أَجرَحُ",3,"ح",1,0],["وَإِذا رَنَتْ وَلَعَ الفُتورُ بِمُهْجَتِي","مِنْ أَعْيُنٍ مَلَكَ القُلوبَ فُتُورُها",4,"ر",3,0],["وَإِذا رَكِبتُ تَرى الجِبالَ تَضِجُّ مِن","رَكضِ الخُيولِ وَكُلَّ قُطرٍ موعِرِ",5,"ر",1,0],["وَإِذا رَأَت سَيفي تَضِجُّ مَخافَةً","كَضَجيجِ نوقِ الحَيِّ حَولَ المَنزِلِ",6,"ل",1,0],["وَإِذَا رَمَى فَلَكُ الْبُرُوجِ مَدِينَةً","بِالْمَنْجَنِيقِ فَسُورُهَا الْمَهْدُومُ",7,"م",1,0],["وَإِذَا رَضِيتَ وَقَدْ رَضِيتَ فَلَيْسَ لِي","عِلْمٌ بِمَنْ يَرْضَى وَلاَ مَنْ يَغْضَبُ",8,"ب",1,0],["وَإِذا رَقَدتَ فَأَنتَ مُنتَبهٌ","وَإِذا انتَبهتَ فَوجهُكَ البَدرُ",9,"ر",1,0],["وَإِذا رُزِقتَ رِآسَةً فَاِنسُج لَها","بُردَينِ مِن حَزمٍ وَمِن إِسجاحِ",10,"ح",1,0],["وَإِذا راكِبٌ إِلى الجِسرِ يَهوي","بَينَ صَفَّينِ مِن مَماتٍ زُؤامِ",11,"م",1,0],["وإِذَا رأتك تَقَلقَلَت أَحشَاؤُها","شَوقَاً إِلَيكَ فَأَكثَرَت وأّقَلَّتِِ",12,"ت",1,0],["وإذا رأى فيها الوقائع غافل","من نوم غفلته يكون مُفيقا",13,"ق",2,0],["وإذا رُمت في التعلُّم حذفاً","فاتركِ النفس والذي هي ترمي",14,"م",2,0],["وَإِذا رَأَيتَ مُنافِقينَ تَخَيَّروا","سُبُلَ الضَجاجِ أَقَمتَ كُلَّ ضَجاجِ",15,"ج",1,0],["وَإِذا رَجَوتُ بِأَن يُقَرِّبَكِ الهَوى","كانَ القَريبُ لِما رَجَوتُ بَعيدا",16,"د",2,0],["وَإِذا رَجَوا أَن يَنقُضوا مِنّي قُوىً","مَرَسَت قُوايَ عَلَيهِمُ وَمَرائِري",17,"ر",2,0],["وَإِذا رَجَعنَ وَقَد وَطِئنَ عَدُوَّنا","قُرَّبنَ بَينَ أَجِلَّةٍ وَأَياصِرِ",17,"ر",1,0],["وَإِذا رُمتَ رَحيلاً فَاِرتَحِل","وَاِعصِ ما يَأمُرُ تَوصيمُ الكَسَل",18,"ل",1,0],["وإذا رأيتَ الغصن ثمَّ رأيته","يختال تاهَ القلب منه بأتيَه",19,"ه",1,0],["وإذا رَاصَدَ الغُيوبَ بِظَنٍّ","فكأنّ الغُيوب من أرْصادِهْ",20,"د",2,0],["وإذا رَمى بمكيدةٍ","فكأنهُ القدرُ المُبيرُ",21,"ر",1,0],["وإذا رام أن يفوه بقدّو","س أبَى مِرْنةً سوى قدّيس",22,"س",1,0],["وإذا رامه عدوٌّ رآه","جبلاً فوق رأسه منتوقا",23,"ق",2,0],["وإذا رجَّم قومٌ فيكُمُ","بالندى والصفح كانوا كَهنه",24,"ن",2,0],["وَإِذا رَقَدتُ رَقَدتُ مُضطَرِباً","وَإِذا صَحَوتُ صَحَوتُ مُرتَعِدا",25,"د",2,0],["وَإِذا راعَكَ الحَبيبُ بِهَجرٍ","وَدَعَتكَ الذِكرى أَلا تَتَوَجَّد",26,"د",1,0],["وَإِذا رَأَيتَ مِنَ البَعي","دِ مَوَدَّةً فَهُوَ القَريبُ",27,"ب",1,0],["وَإِذا رَأَيتُ عَلَيهِ ثَوباً ناعِماً","لَم يُلفِني مُتَمَنِّياً لِرِدائِهِ",28,"ا",3,0],["واذا ركبت البحر فانظر اولا","ان لا يكون البحر بالمهتاج",29,"ج",1,0],["وإذا رأيت النفس بالحق اعتلت","فاعرف لها إقدامها وحياءها",30,"ا",3,0],["وإذا رمى خِطط الحما","سة قلت قسورة وثب",31,"ب",1,0],["وَإِذا رَحِمتَ فَأَنتَ أُمٌّ أَو أَبٌ","هَذانِ في الدُنيا هُما الرُحَماءُ",32,"ا",2,0],["وَإِذا رَضيتَ فَذاكَ في مَرضاتِهِ","وَرِضى الكَثيرِ تَحَلُّمٌ وَرِياءُ",32,"ا",2,0],["وَإِذا رَجَعتَ إِلى الحَقا","ئِقِ فَهيَ واحِدَةٌ لِأَوحَد",33,"د",1,0],["وَإِذا رَأَيتُكَ دونَ عِرضي عارِضاً","أَيقَنتُ أَنَّ اللَهَ يَبغي نَصرَهُ",34,"ه",1,0],["وإِذا رجعتَ إِلى الكرامِ فطاعِمٌ","ما بينَ أهلِ المكرُماتِ وكاسي",35,"س",2,0],["وَإِذا رَجَوتُ ثَنَت رَجائِي سَكتَةٌ","مِن عاتِبٍ في الحُبِّ غَيرَ مُعاتِبِ",36,"ب",1,0],["وَإِذا رَأَيتُ الهَجرَ ضَربَةَ لازِبٍ","أَبَداً رَأَيتُ الصَبرَ ضَربَةَ لازِبِ",36,"ب",1,0],["وَإِذا رَأَيتُ أَبا عَلِيٍّ فَالعُلا","لِمَشارِقٍ مِن سَيبِهِ وَمَغارِبِ",36,"ب",1,0],["وَإِذا رَأى إِبليسُ غُرَّةَ وَجهِهِ","حَيّا وَقالَ فَدَيتُ مَن لَم يُفلِحِ",37,"ح",1,0],["وَإِذا رَأَيتَ شَمائِلَ اِبنى صاعِدٍ","أَدَّت إِلَيكَ شَمائِلَ اِبنى مَخلَدِ",38,"د",1,1],["وَإِذا رُعتُهُ بِناحِيَةِ السَو","طِ عَلى الذَنبِ راعَني بِالفَرارِ",39,"ر",1,0],["وَإِذا راقَتِ المَطالِبُ حُسناً","فَسِوايَ الداني إِلَيها المُسِفُّ",40,"ف",1,0],["وَإِذا رَفَعتُ لِواءَ خِندِفَ قَصَّرَت","عَنهُ العُيونُ فَطَرفُها مَقصورُ",41,"ر",1,0],["وإذا رفعت قفاك عن أيديهم","فمقالهم لك يا معلم طاطي",42,"ط",2,0],["وإذا رَأَيْتَ نوالَهم ثَمَداً","فالحظُّ بينَ طِلابِكَ البَحرا",43,"ر",2,0],["وإذا رُميتُ بعَتْبِ مثلِك خانَني","جَلَدي فلم أصبِرْ ولم أتصبَّرِ",44,"ر",1,0],["وَإِذا رَآكَ مُسلِّماً ذَكَرَ الَّذي","حمّلتَهُ فَكَأَنَّهُ مُبرومُ",45,"م",1,0],["وَإِذا رَأَيتَ الرِزقَ ضاقَ بِبَلدَةٍ","وَخَشيتَ فيها أَن يَضيقَ المَكسَبُ",46,"ب",1,0],["وَإِذا رَأَيتَ جَديدَ رَوضٍ ناضِرٍ","فَاِرشُف عَتيقَ الراحِ فَوقَ جَديدِهِ",47,"د",2,0],["وَإِذا رَأَيتُ مَدامِعي مُبيَضَّةً","مِثلَ المِياهِ مَزَجتُها بِدِماءِ",48,"ا",2,0],["وَإِذا رَأَيتَ نُجومَها","كَقَلائِدِ الدُرِّ النَضيدِ",49,"د",1,0],["وَإِذا رَحَلتُ فَجِنَّتي أَجَمُّ القَنا","وَعَلى مُتونِ الصافِناتِ تَحَصُّني",50,"ي",1,0],["وَإِذا رُسومٌ في كِتابِكَ لَم تَدَع","شَكّاً لِنَظّارٍ وَلا مُتَفَكِّرِ",51,"ر",1,0],["وَإِذا رَأَيتَ أَسى اِمرِىءٍ أَو صَبرَهُ","يَوماً فَقَد عايَنتَ صورَةَ رائِهِ",52,"ا",3,0],["وَإِذا رَمَتكَ الحادِثاتُ بِلَحظَةٍ","رَدَّت ظِباؤُكَ طَرفَها مَطروفا",53,"ف",2,0],["وَإِذا رَأَيتَ أَبا يَزيدٍ في نَدىً","وَوَغىً وَمُبدِئَ غارَةٍ وَمُعيدا",54,"د",2,0],["وَإِذا رَأَيتُكَ وَالكَلامُ لَآلِئٌ","تُؤمٌ فَبِكرٌ في النِظامِ وَثَيِّبُ",55,"ب",1,0],["وَإِذا رَنَت خِلتَ الظِباءَ وَلَدنَها","رِبعِيَّةً وَاِستُرضِعَت في الرَبرَبِ",56,"ب",1,0],["وإذا رمْتَ صلاحاً","فَعَوانٌ بينَ ذلكْ",57,"ك",1,0],["وإذا رأيتَ الضيمَ مشتداً فلا","تلبثْ وحاولْ غيرُ تلكَ الدارِ",58,"ر",1,0],["وإذا رأتْكَ العينُ تبكي رحمةً","لخلوِّ ربعكَ والبكاءُ يَسيرُ",59,"ر",1,0],["وإذا رأتْ عيناي عالي رتبةٍ","بلغ المعاليَ وَهْوَ غيرُ مهذبِ",60,"ب",1,1],["وَإِذا رَنَت نَظَرَ النَزيفِ بِعَينِها","فَعَرَفتُ حاجَتَها وَإِن لَم تَنطِقِ",61,"ق",1,0],["وَإِذا رَقى وَرقاءَ تَحسِبُ مُقلَةً","زَرقاءَ لَم تُطبِق لَها أَشفارا",62,"ر",2,0],["وإذا رَفعتم للحياةِ عِمادَها","ألفيتمُ الدُّستورَ خيرَ عمادِ",63,"د",1,0],["وإذا رَحلتَ لآخرين مَطيّةً","فَرِحالُها الأسماعُ والأحداقُ",64,"ق",1,0],["وإذا رُزِقتَ الصِّدق في أهلِ الهَوى","فالنّفسُ أهونُ قُربةٍ وفداءِ",65,"ا",2,0],["وإذا رُزِقْتَ النَّفسَ دائبةَ القُوى","فَاهْنَأْ فلستَ على الزَّمانِ بفانِ",66,"ن",1,0],["وَإِذا رَماكَ أولو الخُصومَةِ فَاِرمِهِم","بِالحُجَّةِ الكُبرى وَبِالبُرهانِ",67,"ن",1,0],["وَإِذا رَمى شُمَّ المَعاقِلِ مِن عَلٍ","طارَت بِمُختَرِقِ الرِياحِ تُرابا",68,"ب",2,0],["وإذا رأيتَ خليفتيه رأيتَه","للَّهِ في ثوبيهما ملموما",69,"م",2,0],["وَإِذا رَمَت شَخصي العُدا","ةُ بِنَبلِها صارَت سَفى",70,"ف",2,0],["وَإذا رَعَتْ كَرَمَ المكارِم أُخْرَجَتْ","شَهْدَ المَدَائِحِ فيهِ وسُكْرَ مُدامِ",71,"م",1,0],["وإذا رأيتَ الأمْرَ خالَفَ قَصْدهُ","فالرأيُ عن جِهَةِ النُّهَى مَعدول",72,"ل",1,0],["وَإِذا رامَ نَديمٌ عَربَدَه","فَاِقرَعَن بِالصِرفِ مِنهُ كَبِدَه",73,"د",2,1],["وَإِذا رُفِعتِ إِلى مَخيلَتِهِ","مَطَرَت عَلَيكِ سَماؤُهُ ذَهَبا",74,"ب",2,0],["وَإِذا رَجَعتَ إِلى النُهى فَذَواهِبُ","الأَيّامِ غَيرَ مُؤَمَّلٍ رَجَعاتُها",75,"ت",3,0],["وَإِذا رَجَعتُ إِلَيهِ صارَت أَعظُمي","تُرباً تَهافَتَ في طِوالِ الأَعصُرِ",76,"ر",1,0],["وَإِذا رَجَعتَ إِلى الحَقائِقِ لَم يَكُن","في العالَمِ البَشَريِّ إِلّا بائِسُ",77,"س",1,0],["وَإِذا رأَيتُ السَّيلَحِينَ وَبارِقاً","أَغنَينَ عَن عَمرٍو وَأُمٍّ قتالِ",78,"ل",1,0],["وإذا رُخِّمَ اقتضى","طيبُهُ حُسنَ وصفِهِ",79,"ه",1,0],["وإذا رمت أن يحول لك التي","ن دجاجاً أتى إليك يطير",80,"ر",1,0],["واذا راموا ان اقاطع ليلى","وجدوني وان الحوا عصيا",81,"ي",2,0],["وإذا رأَيت اللفظ لَي","سَ كَما أروم أُغَيِّر",82,"ر",1,0],["وإذا رأيتك دون عرضٍ عارضاً","أيقنت أنّ اللّه يبغي نصره",83,"ه",1,0],["وإذا رأت يوماً فقيراً بائساً","نبحت عليه وكشَّرت أنيابها",84,"ب",3,0],["وَإِذا رَمى عَن قَوسِهِ فَيَمينُهُ","قَدَرٌ وَما تُرمى اليَمينُ قَضاءُ",85,"ا",2,0],["وإِذا رَجَعْتَ إِلى الْيَقِينِ فَإِنَّها","نارٌ تَحَلَّلَ جِسْمُها في ماءِ",86,"ا",2,0],["وَإِذَا رَأَيْتَ المَوْجَ يَسْفُلُ بَعْضُهُ","أَلْفَيْتَ تَالِيَهُ طَغَى وَتَعَالَى",87,"ل",2,0],["وَإِذَا رَستْ فَالضِفَّتَانِ حدائِقٌ","زهِرتْ بِكلِّ مُحَبِّبٍ وجمِيلِ",88,"ل",1,0],["وَإِذا رَمَيتَ الطَرفَ راعَكَ مِنهُم","أَطلالُ أَجبالٍ عَليكَ رَواسِ",89,"س",1,0],["وإذا راعك الجمالُ لفنٍ","عبقري فاسألهُ عن فنَّانه",90,"ن",2,0],["وإذا رَنَّةٌ كما تضحَك الآ","مالُ بعد النوى وطولِ المِطالِ",91,"ل",1,0],["وإذا رنا نحو الغريب، فإنما","يرنو بمجْهَر راصِد الأجرام",92,"م",1,0],["وإذا رَضِيَت وقد رَضِيتَ فليس لي","عِلْمٌ بمن يرضى ومن يغْضَب",93,"ب",1,0],["وإذا رأى منهم همام ريبةً","ناداه داعي دينه أن يزأرا",94,"ر",2,0],["وَإِذا رَضيتَ فَذاكَ في مَرضاتِهِ","وَرِضا الكَثيرِ تَحَلُّمٌ وَرِياءُ",95,"ا",2,0],["وَإذَا رَمَيْتَ بِهِ الْفِجَاجَ رَأَيْتَهُ","يَهْوِي مَخَارِمَهَا هُوِيَّ الأجْدَلِ",96,"ل",1,0],["واذا رأيتِ النيلَ يَزْفُرُ موجُهُ","ولي بعينك شجو هذا الباكي",97,"ك",2,0],["وَإذا رَجَوْتُ ثَنَتْ رَجائيَ شَكتّةٌ","مِنْ عاتِبٍ في الحُبّ، غَيرِ مُعاتِبِ",98,"ب",1,0],["وإذا راعك الحبيب بهجر","ودعتك الذكرى ألا تتوحّد ؟",99,"د",1,0],["وإذا رنتْ، نطرَ النزيفَ، بعينها،","فعرفتُ حاجتها، وإنْ لم تنطقِ",100,"ق",1,0],["وإذا رفّ طيفه في خيالي","رفّ ريحانة من الله تهدى",101,"د",2,0],["وإذا رأيتك ضقت فيه تنكّرت","للجدّ منه دعابتي ومزاحي",102,"ح",2,0],["واذا رمت رفاقا فاختر ال","خيرين الصالحين الحكما",103,"م",2,0],["وإذا رمت من طريقة فكري","مذهب الحو في الهوى تتحير",104,"ر",1,0],["وإذا روحي في كَفَّيْها","مِثلُ العُصْفورِ على الغُصْنِ",105,"ن",1,0],["وإذا رَمَته يدُ الحوادث بالأسَى","عُدْ مُسْرِعاً لا يعتريك تكلفُ",106,"ف",1,0],["وِإذَا رُمتَ مِثلَها لَم يُطَاوِع","وعَسِيرٌ عَلَيكَ أن لاَتَرُومَا",107,"م",2,0],["وإِذَا رُمتَ أن تَرِيمَ كَسَتهَا","جَودَةُ الذِّهنِ جِدَّةً لَن تَرِيمَا",107,"م",2,0],["وإذا رنت قتلت وإن هي كلمت","ميتاً غدا من جملةِ الأحياءِ",108,"ا",2,0],["وإذا رأيتَ الكون فاع","لمْ أن سيتبعُهُ الفسادُ",109,"د",1,0],["وإذا رايةٌ أُمدتْ بإقبا","لك سارت منصورةً بالرُّعبِ",110,"ب",1,0],["وإذا رجالٌ حصَّنوا أموالَهم","جعَل المواهبَ أوثقَ الخُزّانِ",111,"ن",1,0],["وَإِذا رُمتَ غايَةً بَعدَت نَي","لاً أَخَذتَ الظُبى بِها كُفَلاءَ",112,"ا",2,0],["وإذا رأيت الورد في أكمامه","خيلته في الشبه حمرة خده",113,"د",2,0],["وإذا ركبت السيف في مرضاته","فاعلم بأنك ذلك الإنسان",114,"ن",1,0],["وإذا رجت نجح المساعي استبشرت","وعدت بها الأطماع في استلحاقها",115,"ق",3,0],["وإذا رأت وجه الرضا حلت له","قيد التحفظ والوفا عن ساقها",115,"ق",3,0],["وإذا رجال في هواه تهالكوا","لقد اقتدوا منه بشر إمام",116,"م",1,0],["وإذا رمَيْتَ بفضلِ كأسكَ في الهوّا","عادَتْ عليكَ من العّقيقِ عُقودا",117,"د",2,0],["وإِذا رَأَينَنِىَ احتَشَدنَ لِجِيئَتِى","مُتَطَرِّقاً ذا جُرأَةٍ وَدَلالِ",118,"ل",1,0],["وَإِذا رمتكِ يَد الزَمان بِنَكبةٍ","فَاِستَنجِدي بوزيرِنا المِقدامِ",119,"م",1,0],["وَإِذا رَأَيت عَليَّ مَيلةَ شارِبٍ","زِدني فَذَلِكَ مَذهَبي المُختارُ",120,"ر",1,0],["وإذا رأين الشيخ قلن له النجا","أين الغزال من البعير الأفحج",121,"ج",1,0],["وَإِذا رَأى نارَ العَدُمِّ تَضَرَّمَت","سامي جَماعَةَ أَهلِها فَاِكتادَها",122,"د",3,0],["وَإِذا رَأَيتَ جَماعَةً هُوَ فيهِمُ","بَيَّنتَ سُؤدُدَهُ وَإِن لَم تُسأَلِ",123,"ل",1,0],["وإذا رابتك أرضٌ أو نبتْ","بك جاوِزْها بوخدٍ أو رسيم",124,"م",1,0],["وإذا رقرقتها سطعتْ","نفخةُ الوقَّادِ في الضرمِ",125,"م",1,0],["وإذا رأتْ أهلَ الهوى","عزتْ على طلابها",126,"ب",3,0],["وإذا رنتْ غدتِ القلو","بُ تفرُّ من أصحابها",126,"ب",3,0],["واذا رمت سواه لم اجد","في فؤادي لسواه موضعا",127,"ع",2,0],["وإذا رحت على أنغامها","ذهب الهمّ بعيداً ثم طاح",128,"ح",1,0],["واذا رنوت لرسمه","في الطرس عبراتي تسيل",129,"ل",1,0],["وإذا رغبت عن اللقا","ء فقد لقيتك في المنام",130,"م",1,0],["وَإِذا رَعشَةٌ أَمَرَّت عَلَيها","جانِحيها وَاللَيلُ يَطوي ظِلاله",131,"ل",2,0],["وإذا رُمْتُ وصلَه","صَدَّ عنّي وسَوَّفا",132,"ف",2,0],["وَإِذا رَأى سوءاً فَيَسأَلُهُ لَها","فَيَؤولُ سَيِّئها إِلى غُفرانِ",133,"ن",1,0],["وَإِذا رَآهُ ذَوو المَنامِ فَإِنَّهُ","في صِحَّةِ الرُؤيا لَكاليَقظانِ",133,"ن",1,0],["وإذا رقدت فليس إلاّ فكرتي","لا الحلم جاد به ولا بمثالهِ",134,"ل",2,0],["وإذا رَقَدت مُنعَّماً","فاذكر شَقيّاً فيكَ ساهر",135,"ر",1,0],["وإذا رأته الشمس كا","دت أن تموت من الحسد",136,"د",1,0],["وإذا رأيتُ وميضَ برقٍ قلتُ من","ذكري لديك تحرّكت شفتاك",137,"ك",1,0],["وإذا رأيت الحي تقصده","الركائب والظمون",138,"ن",1,0],["وإذا رَنونَ بأعيُنٍ فيها الهُدى","صَيَّرنَ قلبي في الخطوبِ كَبيرا",139,"ر",2,0],["وإذا رَنوتِ إِلى النجومِ وبَعضُها","يَغشاهُ جنحُ الغَيمةِ السُّوداء",140,"ا",2,0],["وإذا رأيتَ اليأس يحملُ خنجراً","لا تعذلِ الزّنديق والمجنونا",141,"ن",2,0],["وَإِذا رَماهُ الكاشِحونَ رَماهُمُ","بِمَعابِلَ مَذروبَةٍ وَقِطاعِ",142,"ع",1,0],["وإذا رأَيتُك بين آل المُصطَفى","عوَّذتُ منظَرك الجَميل بطاها",143,"ا",3,0],["وإذا رأى منّي الحضورَ لرغبةٍ","أَولَيتُهُ ودَّ الصديق الغائبِ",144,"ب",1,0],["وإذا رامَ هُجوعاً طَرفه","هزَّه الشَوقُ إليكم فاِنتَبَه",145,"ب",2,0],["وَإِذا رموا (عن غيرِ قصْدٍ) نظرةً","نظروا بعينِ الأحوالِ المتعامي",146,"م",2,0],["وَإِذا رأى ألَم العقاب شفاءه","من علّة لم يعد رفق طبيبِ",147,"ب",1,0],["وإذا رحلت فللسعادة آية","تقتادها في موكب وخميس",148,"س",1,0],["وإذا رأيت فتى بأعلى رتبة","في شامخ من عره المترفع",149,"ع",1,1],["وإذا راهب الليالي خيال","شارد الخطو كالمها في الغاب",150,"ب",1,0],["وَإِذا رَآكَ وَقَد قَصَدتَ لِصَرفِهِ","بِالصَبرِ لاقى الصَبرَ بِالإِذعانِ",151,"ن",1,0],["وإذا رَجَعْتَ إلى الصَّحِيحِ فَإنَّهُ","عَتْبٌ وَعَيشِكَ لَيْسَ فِيهِ سِبَابُ",152,"ب",1,0],["وَإِذا رَأَيتُ الكَفرَ لِلإيمانِ إِتما","ماً غَدا المُؤمِنُ عِندي مَن كَفَر",153,"ر",1,0],["وَإِذ اِرتَأَيتُ عَدلاً مَيلَكُم","عَنّي وَغَيرُ سَبيلُكُم أَنا سالِكُ",154,"ك",1,0],["وَإِذا رَأَيت مِن اللئام مُؤخّرا","فَاِعلم بِأَنّ الدَهر أَطعمه",155,"ه",1,1],["وَإِذا رَأَينَ لَدى الفِناءِ غَريبَةً","فاضَت لَهُنَّ مِن الدُموعِ سِجالُ",156,"ل",1,0],["وإذا رامَ سُلُوّاً","عنهمُ زادَ أُواما",157,"م",2,0],["وإذا رَنّقت خَلائقَ قَومٍ","ظَلَّ أخلاقُنا بها تَتَصَفّى",158,"ف",2,0],["وإذا رأيتَ الدُّرَّ أصبحَ باقياً","هانَتْ إعادَةُ سِلْكه المَقْطوع",159,"ع",1,0],["وإذا رأيتَ العبْدَ يَهربُ ثُمَّ لم","يُطلَبْ فَمَولَى العَبْدِ منه هارب",160,"ب",1,0],["وإذا رأيت السّودَ من راياتهِم","سارتْ أمام البيضِ من آرائه",161,"ا",3,0],["وَإِذا رَضيتَ بِما لَقَي","تُ فَقَد نَعِمتَ بِما شَقيتُ",162,"ت",1,0],["وَإِذا رِشتَ بِالأَيادي جَناحي","فَمعَاني العَلاءِ مِمّا أَصيدُ",163,"د",1,0],["وَإِذا رَفَعتَ حِجابَكَ المَرفوعَ عَن","عَيني فَمَن لِحِجابِكِ المَستورِ",164,"ر",1,1],["وإذا رأيتَ الشعرَ أوَّلَ ما بدا","في عارضٍ فالحبُّ أوَّلُ ما بَدا",165,"د",2,0],["وإذا رأيت اللَه فيها ساكناً","عجباً لكفرك كيف لا يتألم",166,"م",1,0],["وإذا رأيت الصمَّ تسمعُ مدحها","عجباً لشعرك كيف لا يترنم",166,"م",1,0],["وإذا رأيت المدح فيها واجباً","عجباً لقلبك كيف لا يتكلم",166,"م",1,0],["وَإِذا رَأَى وَجه المَنية","بَغتة لا يَفزَع",167,"ع",1,0],["وإذا رأيتم بيت ربي فاطلبوا","عفوا لمن من بعده يتحسر",168,"ر",1,0],["وَإِذا رَأَيتَ مناصِباً","مُتَعَلِّقاً حَبلَ الجحود",169,"د",1,0],["وإذا رمى بالظَّنِّ أمراً مُشكِلاً","أضحَتْ سُتورُ الغَيبِ عنهُ مُهَتَّكَهُ",170,"ه",1,0],["وإذا رأوْني مُقبلاً فلْيعلَموا","أنِّي بوَجهِ الودِّ عنْهُم مُعرِض",171,"ض",1,0],["وَإِذا راشَ بِالأَنامِلِ أَنبوب","يَراعٍ كَأَنَّما هوَ نَبلُ",172,"ل",1,0],["وَإِذا راش بِالأَنامِلِ مِنهُ","قلماً واستَمَدَّ ساءَ وَضَرّا",173,"ر",2,0],["وَإِذا رَجَوتَ المُستَحيل فَإِنَّما","تَبني الرَجاءَ عَلى شَفيرٍ هارِ",174,"ر",1,0],["وَإِذا رأى إِبرام أَمر لَم يُطِق","أَحَد يَحِلُّ الأَمر مِن تَوكيدِهِ",175,"د",2,0],["وإذا رأيتك قفرة من معشري","وبني أبي وهم لعمرك ما هم",176,"م",1,0],["وإذا رأيت محسدين فقلما","ترجيهم الأيلم حتى يرحموا",177,"م",3,0],["وإذا رجليَ خانَتْني فَلا","لومَ عندي للعصا في أن تَخونَا",178,"ن",2,0],["وإذا رجوتَهُمُ لنصرٍ صدَّقُوا","بعظيمِ بأسهِمُ رجاءَ المُرتجِي",179,"ج",2,0],["وإذَا رأى الشّملَ الجميعَ تَزاحمتْ","في قَلبه الأمواهُ والنّيرانُ",180,"ن",1,0],["وإذ أرطبون الروم يحمى بلاده","يحاوله قرم هناك يساجله",181,"ل",2,0],["وإذا رمت في الرِّجال كريماً","كانَ عيد الرحمن أقصى مرامي",182,"م",2,0],["وإذا رُوِّعَتْ ومثلُك فيها","أصبحوا في ديارهم آمنينا",183,"ن",2,0],["وَإِذا رَأَيتَ وَلا مَحالَةَ زَلَّة","فَعَلى أَخيكَ بِفَضلِ حِلمِكِ فَاِردُدِ",184,"د",1,0],["وَإِذا رُزِقتَ مِن النَّوافِل ثَروَةً","فَاِمنَح عَشيرَتَكَ الأَداني فَضلَها",185,"ل",3,1],["وإِذا ريحُ نشاطٍ نَفَحَتْ","نَفَخَتْ منهُ بأَذْكَى ضَرَم",186,"م",1,0],["وإِذا رأَيت الحُسْنَ من حَسَنٍ","فاطْرَبْ لصِدْقِ الإِسْمِ والفعلِ",187,"ل",1,0],["وإذا روّيْتُ في رؤيته","بدَهَ الحُسنُ بها وارتجَلا",188,"ل",2,0],["وإذا رجِعْتَ الى حقيقةِ","يوماً فمن عَلياكَ ذاكَ الجوهرُ",189,"ر",1,0],["وإذا رأيتك أو سمعت بكم فما","زمني ولا أحد عليك أضامني",190,"ن",2,0],["وإِذا رضي الباري على بشر أَتت","منه له بيد القضا أَسباب",191,"ب",1,0],["وإذا رضيت بان أموت هوى فقد","أحييتنى يا مبدئى ومعيدى",192,"د",2,0],["واذا راعيتها في يقظة","لم تنم أصبحتُ للخلد لزاما",193,"م",2,0],["وإذا رأى إنصافَه في غيره","أشفقتُ أن يحمِي حمى مغبونهِ",194,"ن",2,0],["وإذا رابه مريبٌ من الوح","شة شام الحسامَ أنساً وضمَّهْ",195,"م",2,0],["وإذا رويتُ بها مقامَ علاً","نهضتْ فأبلتْ مثلما أُبلي",196,"ل",2,0],["وإذا رجَعتُ إلى أواخِر ودّه","قابلتُها بوسائطٍ وأوائلِ",197,"ل",1,0],["وإذا رابتك من خُلْقِ أخٍ","هفوةٌ تخلِطُ بالبرِّ عُقوقَهْ",198,"ق",2,0],["وإذا رغبتَ إلى السحاب فحاجةٌ","لك ما يصوب على الغضا ويجودُ",199,"د",1,0],["وإذا ركضن بآهلٍ من وحشة","جم النوال سكونه ميطانه",200,"ن",2,0],["وإذا رُحْتَ مُبيداً للْعِدى","عُدْتَ كَرَّاراً تُبيدُ الإِزَما",201,"م",2,0],["واِذا رمى بعدَ الخليطِ بطرفهِ","نحوَ الديارِ رأى الحمى فاستعبرا",202,"ر",2,0],["وإذا رأيت اللّه خصّ عصابة","بكرامة محسودة الأعراض",203,"ض",1,0],["وَإِذا رَأَيتَ مُحارِباً وَمُسالِماً","فَليَبِني عِندَ المُحارِبِ مَن بَغى",204,"ا",1,0],["وإذا رأيت فتىً يؤلُ لفاطمٍ","فاضممه واحفظ فيه ذمَّة فاطمه",205,"ه",1,0],["وإذا رَأيتَ رُواقَ أمِّ عَبيدَةٍ","يُجْلى كَشَمْسٍ في ظَلامِ دَياجِرِ",206,"ر",1,0],["وإذا رميت معانداً بمكيدة","وأردت أن يجني عليه زمانها",207,"ن",3,0],["وإذا رُمتُ مَدحَهُ قال هَيَّا","أنا أجري مِن جَدولٍ بِزُلالِ",208,"ل",1,0],["وإذا رأيت جمالَ غانيةٍ","فهو الّذي سَرَقَتْه من جُمَلِ",209,"ل",1,0],["وإذا رضيتَ القولَ من أحدٍ","حاز الرِّهانَ وأدرك المَهَلا",210,"ل",2,0],["وإذا رأينا منك طلعتك الّتي","هي رونقٌ أو جوهرٌ مصقولُ",211,"ل",1,0],["وإذا رجوتَ لنعمةٍ أو نقمةٍ","فاِرجو المليكَ وحاذر المملوكا",212,"ك",2,0],["وإذا رأيتَ على الرّدى مِقدامَهمْ","فكأنّ قلباً منه ليس بخائفِ",213,"ف",1,0],["وإذا رضيتَ مقالتي فَلَهَيِّنٌ","من صمّ عنها مُعرِضاً لم يسمعِ",214,"ع",1,0],["وإذا رضيتَ فضيلةً لِي لم أُبَلْ","من نام عنها بالعيونِ الهُجَّعِ",214,"ع",1,0],["وإذا رمى منهمْ فتىً","يوماً أصاب فأغرضا",215,"ض",2,0],["وإذا رجعتُ رجعتُ صِفراً يائساً","عن مُقفر من كلِّ شيءٍ يابسِ",216,"س",1,0],["وَإِذا رعيتَ لِيَ الإخاءَ فهنِّني","ببلوغِ أوطاري ونيلِ مُرادِي",217,"ي",1,0],["وَإِذا رَشادي كانَ بَينكُمُ فما","أَبغي إِذا خُيّرت غيرَ رشادِي",217,"ي",1,0],["وإذا رضيتُمْ بالحُطامِ فلا اِرتَوى","صادٍ ولا اِمتَلأتْ لكمْ أعفاجُ",218,"ج",1,0],["وإذا رُميتَ فإنّما","لم تُرْمَ وحدَك إذ رُمِيتا",219,"ت",2,0],["وإذا رضيتَ فقد حظيتُ فإنّني","أرضى بأن ترضى وذاك طِلابِي",220,"ي",1,0],["وَإِذا رَأيتُ الحُسنَ عندَكُمُ","دونَ الخَلائقِ كيفَ لا أَصبو",221,"ب",2,0],["وإذا رأيناه فأنفسنا نرى","لا غير فاكشف عن سنا هذا المحل",222,"ل",1,0],["وإذا رأيتَ السُّخطَ ليسَ بِنافعٍ","ممَّا قَضاهُ فاعتَمِدْ حُسنَ الرِضَى",223,"ا",1,0],["وإذا رَجوتَ منَ الزَّمانِ سَلامةً","فهيَ الصَّلاحُ رَجَوتَهُ من فاسدِ",224,"د",1,0],["وإذ أرادوا الكيد والخديعة","فحكمهم تبطله الشريعة",225,"ه",1,0],["وَإِذا رَأَو جَريَ القَضاءِ بِأَمرِهِ","فَهِموا يَقينَ الحَزمِ وَالمَحزومِ",226,"م",1,0],["وَإِذا رُمْت أَنْ تُمَارىَ فاسْكُتْ","وإِذا شِئْت أَن تُلاحي فأَمْسِكْ",227,"ك",1,0],["وإِذا رأَيْتَ مُحَدِّثاً عنه فقلْ","حدِّث ولا حَرَجاً عن الحِدْثان",228,"ن",1,0],["وإِذا رأَى الخَطِّيُّ حدّةَ عزمهم","نَكِر السِّنانَ وكادَ أَن لا يطْعنَا",229,"ن",2,0],["وإِذا رَأَى أَثَرِي بكى فكأَنَّه","طَلَلٌ تقادمَ عهدُهُ بالمنْحَنَى",229,"ن",2,0]]}