78",""],[5376,"أنتِ الرحيقُ وفاه كأسي فاغرُ","https://www.poetsgate.com/ViewPoem.aspx?id=202189",""],[5431,"إنّي عشقتك محكومٌ بتأبيدي","https://www.poetsgate.com/ViewPoem.aspx?id=184962",""],[5431,"أنت وحدك من أُنْعمتَ بالقُبل","https://www.poetsgate.com/ViewPoem.aspx?id=189570",""],[5431,"مثل شمس لن تنطفي ياشآمُ","https://www.poetsgate.com/ViewPoem.aspx?id=197561",""],[5431,"فيك الحسُ يُختزلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=198568",""],[5458,"العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=72384",""],[5470,"ذاكرة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=12367",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5561,"آثار مجدك","https://www.poetsgate.com/ViewPoem.aspx?id=192893",""],[5561,"كما تشائين","https://www.poetsgate.com/ViewPoem.aspx?id=201390",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[1680,"يا من تحل بذكره","https://www.poetsgate.com/ViewPoem.aspx?id=108880",""],[5720,"أنتَ الإِلٰهُ","https://www.poetsgate.com/ViewPoem.aspx?id=201610",""],[5776,"البُردةُ اليمانيةُ الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=199545",""],[5781,"كم نحنُ تُعَساء","https://www.poetsgate.com/ViewPoem.aspx?id=204826",""],[5829,"وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=157230",""],[5861,"لغز العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190728",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5945,"رمضان أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=189061",""],[5956,"أدي الرسالة يا مولات واجتهدي","https://www.poetsgate.com/ViewPoem.aspx?id=182382",""],[5956,"هذي الطبيعة يا رفاهي غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=196809",""],[5956,"لقد سكنتَ حبيباً في ضمائرنا","https://www.poetsgate.com/ViewPoem.aspx?id=204483",""],[5957,"أنت الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=27115",""],[6019,"إلى هَجر الحب والنقاﺀ..للأحساﺀ أنشود","https://www.poetsgate.com/ViewPoem.aspx?id=137673",""],[6027,"لي في هواك .. تعقل وجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187195",""],[6152,"أنتِ الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=213204",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6213,"حبّات المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81913&r=&rc=88",""],[6213,"ومضة من الألق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81912&r=&rc=87",""],[6213,"لوحة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76258&r=&rc=15",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""],[6224,"سبحانه البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88237&r=&rc=16",""],[6242,"مَنْ ضيّعَك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87556&r=&rc=3",""],[6259,"عصرت معدا معك الأناة ُ المعصرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59379&r=&rc=27",""],[5001,"فى كل يوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80714&r=&rc=4",""],[6331,"الصَّبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82022&r=&rc=3",""]],"verses":[["أَنتَ الرَبيعُ إِذا ما لَم يَكُن مَطَرٌ","وَالسآئِسُ الحازِمُ المَفعولُ ما أَمَرا",0,"ر",2,0],["أنت الرشيد على كريم بساطه","تستعرض الآراء والأفكار",1,"ر",1,0],["أنتَ الربيعُ الطَّلْقُ إن شاءَ الثَّرى","وتَزَحَّلُ الأنواءِ سَرَّ قُدوما",2,"م",2,0],["أنت الرّئيسُ هَداكَ ربُّكَ خُطّةً","بيضاءَ زِدتَ ضِياءَها إشراقا",3,"ق",2,0],["أَنتَ الرِئيسُ حُكومَةً وَمَشيئَةً","وَالوَفدُ أَجمَعُ صورَةً وَمِثالا",4,"ل",2,0],["أَنتَ الرِسالَةُ وَالرَسولُ فَكُن لَهُم","مِنّا عَلى النَأيِ الكِتابَ المُذهَبا",5,"ب",2,0],["أَنْتَ الرَّجَاءُ فَأَيَّ شَيْءٍ تَرْتَجِي","وَالرَّوْعُ أَنْتَ فَأَيَّ شَيْءٍ تَرْهَبُ",6,"ب",1,0],["أَنْتَ الرَّجَاءُ رَجَاءُ مِصْرَ","بَدَا سَنَاهُ فِي سَنَاكْ",7,"ك",1,0],["أَنْتَ الرَّبيعُ الَّذي تَحْيَا الأَنَامُ به","كُلٌّ يَعِيشُ بفَضلِ مِنكَ مَقسُومِ",8,"م",1,1],["انت الرفاعي والاكوان شاهدة","بأن فضلم مثل الظهر قد ظهرا",9,"ر",2,0],["انت الرفاعي مرفوع المكانة في","آل الوصي وغوث الكون والقطب",10,"ب",1,0],["أَنتَ الرَسولُ رَسولُ اللَهِ نَعلَمُهُ","عَلَيكَ نُزِّلَ مِن ذي العِزَّةِ الكُتُبُ",11,"ب",1,1],["أنت الرجاء","يا واسع الإحسانْ",12,"ن",1,0],["أنت الرسول رسول الحسن في زمن","أنا الأمير به من بعد حسان",13,"ن",1,0],["أنتِ الرحيمةُ والأسيافُ مُصلتةٌ","أَنتِ الحليمةُ والأبطالُ أسراك",14,"ك",1,0],["أَنتَ الرَئيسُ إِذا هُمُ نَزَلوا","وَتَواجَهوا كَالأُسدِ وَالنُمرِ",15,"ر",1,0],["أَنتَ الرَّجاءُ لكلِّ مَن يطأُ الثَّرى","فإليكَ كان أَشار حينَ به اكْتنَى",16,"ن",2,0],["أنت الرّبيعُ وفَضْلي في تَرقُّبِه","كالعُودِ عاد إلى الإيراقِ مُفتَقِرا",17,"ر",2,0],["أَنتَ الرَبيع وَكَيف يَحيا مَوضِع","غير الرَبيع بِهِ فَما أَحياهُ",18,"ا",2,0],["أَنتَ الرَبيعُ وَكَيفَ تَحيا بَلدَةٌ","حَتّى يُجاوِرُها الرَبيع المُمطِرُ",19,"ر",1,0],["أنت الربيع تفتحت أزهاره","حسنا وشارك ورده نواره",20,"ر",2,1],["أنت الرّجاءُ لرفعِ النازلاتِ بنا","إذ يَكشِرُ الدهرُ عن أنيابه العُضَلِ",21,"ل",1,0],["أنتَ الرَّخيمُ على ضَريحِكَ رحمةٌ","تَسقي ثَراهُ كما سَقتهُ الأدمُعُ",22,"ع",1,0],["أنت الرشيد وذي دار السلام بها","طاب المقام وعين السوء عمياء",23,"ا",2,0],["أَنتَ الرَواءُ إِذا تَعَذَّرَ مَورِدٌ","وَالماءُ إِن كَدُرَ الرَجاءُ فَأَيأَسا",24,"س",2,0],["أنت الرفيع الذي فاق الأنام ومَن","طوعا وقهرا لديه الناس قد خشعت",25,"ت",1,0],["انت الرئيس بكل معنى مدرك","بل انت من فوق الرؤوس جليل",26,"ل",1,0],["أنت الرئيس المكتسى حلل التقى","وردا الصلاح وثوب كل وقار",27,"ر",1,0],["أنت الرسولُ ونحن الشاهدونَ على","أن قد نصحتَ وقد بَيَّنتَ تِبيانا",28,"ن",2,0],["أنت الرجا فبلادنا حالت لما","نلقاه من خطب العداة ونألف",29,"ف",1,0],["أَنتَ الرَئيسُ اِبنُ الرَئي","سِ وَأَنتَ أَعلى الناسِ كَعبا",30,"ب",2,0],["أنت الربيع الطلق في يوم الندى","وربيعه في يوم ينسفك الدمُ",31,"م",1,0],["أنت الرئيس لدى الرو","ع للخميس العرمرم",32,"م",1,0],["أنت الرحيم بمدنف","وافاك يشكو ما وجد",33,"د",1,0],["أَنتَ الرَبيعُ الغَضُّ رَقَّ نَسيمُهُ","وَاِخضَرَّ رَوضَتُهُ وَصابَ غَمامُهُ",34,"م",2,0],["انت الربيع الذي جادت مواطره","وكل من لم يصبه الغيث محروم",35,"م",1,0],["انتَ الرحيم","قلبي اشتفى وبدا هلالُ هنائهِ",36,"ه",1,0],["أَنتَ الربيع وإنما","جادَ الزمانُ على الربيع",37,"ع",1,0],["أنت الرجاءُ لعين صَبٍّ ساهرٍ","هجر المنامُ جفونه لنواكِ",38,"ك",1,0],["أنت الرشيد ودع من قد سمعت به","وإن تشابه أخلاق وأعراق",39,"ق",1,0],["أنت الرجولة في أسمى معالمها","أنت المبادئ والأمجاد والحسب",40,"ب",1,0],["أَنتَ الرَّسُولُ وَأَنتَ أَنتَ مُحَمَّدٌ","أنتَ الَّذِى إِن قُلتَ قَولا تَصدُقُ",41,"ق",1,0],["أنتَ الرُّؤوفُ المُحسِنُ المُتَعَطِّفُ","أَنتَ الشَّفُوقُ لِلخَلاَئِقِ أَجمَعُ",42,"ع",1,0],["انت الرؤوف بكل من يشكو البلا","ولاجل ذلك قد دعيت رؤوفا",43,"ف",2,0],["أنت الردآء وعلمكم بمن ارتدى","علمٌ لذا لا يقبلُ الإشكالا",44,"ل",2,0],["أنتَ الرجاءُ ومُلتجأ","للكلِ في جُزءِ وكُل",45,"ل",1,0],["أنتَ الرياض جنيَّة قد أبدعت","زهراً مغيراً زهر كل جنان",46,"ن",1,0],["أَنتَ الرَحيمُ بِخَلقِهِ وَعِبادِهِ","أَنتَ الحَليمُ البَرُّ أَنتَ الأَرحَمُ",47,"م",1,0],["أنت الرَّجا مَا من شفيعٍ يُرْتَجى","مَن ذا شفيعٌ للكريمِ إِذَا غفر",48,"ر",1,0],["أنت الرسول المصطفى","ووصيك الهادي المسدد",49,"د",1,0],["أنت الرقيب وقد عودتنا كرما","رد الحقوق لمن قد ذل واتضعا",50,"ع",2,0],["أنت الرحيم برحمة وسعت لما","قد كان فاجعلنّي بها من يُكتبُ",51,"ب",1,0],["أنتَ الربيعُ فما احتياجك","للتَّنزه في الربيع",52,"ع",1,0],["أنت الربيعُ لكل عافٍ ممحلٍ","ولكل كسر أنت أنت الجابر",53,"ر",1,0],["أَنتَ الرَسول الناسِخ","رَفيعُ مجدِكَ باذِخ",54,"خ",1,0],["أَنتَ الرَسول البَليغُ","بِما اِقتَضى التَبليغُ",54,"غ",1,0],["أنت الرحيم برحمتك التي وسعت","كل البرايا بقاصيها ودانيها",55,"ي",3,0],["أنت الرجا والمرتجى والغوث إذ","عزا النصير وقل فيه الناصح",56,"ح",1,0],["أَنْتِ الرَّجاءُ لأَمَّةٍ","تَحْنِي الرِّقابَ لِمَنْ غَلَبْ",57,"ب",1,0],["أنت الرشيد وليس بدعا أن نرى","يحيى وزيرا في زمان رشيده",58,"ه",1,0],["أنت الرجا لاسوى ماجئتَ مُعتصَمٌ","وأنت نور السما في الأرض يشتعل",59,"ل",1,0],["أنتِ الربيعُ إذا اخضرَّتْ له صورٌ","وخبّأ العاشقين العشبُ والقصبُ",60,"ب",1,0],["أنت الرحيم بنا وصدرك واسعٌ","فكن الشفيعَ لأمّةِ الغرباءِ",61,"ا",2,0],["أنت الرّؤوفُ بمَن قد مسّه ألمٌ","فامنحهُ , ربّي , شفاءً كاملاً حسَنا",62,"ن",2,0],["أنت الرجاء وأنت المنح في سغَبٍ","وأنت ماء حياتي لا يروّيني",63,"ن",2,0],["\"أنت الرجا يا خالقي","ما خاب عيد يقصدُكْ \"",64,"ك",1,0],["أَنْتِ الرَّؤوْمُ وَأَنْتِ مَسْكَنُ حُبِّنا","سِرُّ الدَّماثَةِ مِنْ صَفاءِ نُهاكِ",65,"ك",1,0],["أنت الرجا بالعمر والخوف من حتفي","وأنت أبعد أحلام عمري وأقرب أهدافي",66,"ف",2,0],["أنت الربيع أتيتَ في فصل الربي","عِ فزهرهُ في جنب زهرك ذابلُ",67,"ل",1,0],["انتِ الرحيقُ إذا أردتُ تشافياً","سبحانَهُ .. تحتَ الجناحِ شِفاءُ",68,"ا",2,0],["انت الرياح المرسلة بالغيث ياجزل الهبات","الشعب لحم ودم وانت النبض فعروق الجسم",69,"م",1,0],["أنت الرحمن وأنت إذا","عز الأصحاب ، أغيرك لي ؟",70,"ل",2,0],["أنت الرفيع أنت المنيع","همتي عالية ولكن يدي قصيرة",71,"ه",1,0],["أنتَ الرَّفِيقُ إذَا الصِّحَابُ .. تَسَاقَطُوا","أنتَ الشَّوَاطِئُ والهَوَى والبَدرُ .. لَكْ",72,"ك",1,0],["أنتِ الربيعُ ونيروزُ الهوى عطرٌ","مهما استبدّتْ بقلبِ الصّبِ أحزانُ",73,"ن",1,0],["أنتِ الربيعُ وغصنُ وردٍ يانعٍ","وأنا الخريفُ مرتّقُ الأثوابِ",74,"ب",1,0],["أنت الرؤوفُ بكل قلبٍ ضامِ","وأرومُ منكَ العفوَ قبلَ حمامي",75,"م",2,1],["أنتِ الربابُ إذا خلوتُ بوحدتي","غنتك منها في الدجى الأسحارُ",76,"ر",1,0],["انت الرحيل وما ابقيت من جملٍ","إلا وكنت الذي تحدو به الإبلُ",77,"ل",1,0],["أنت الرحيمُ وقلبي ملَّ نبضتَهُ","منك الشفاء فقد أزرت به العِلَلُ",78,"ل",1,0],["انت الرؤوف الحنين البر يشملنا","بعطفه ولسان الحمد ترسيل",79,"ل",1,0],["انت الرصيد الذي عزت نفائسه","دينا ودنيا ومنك الفضل تمويل",79,"ل",1,0],["أنتِ الرحيقُ وفاه كأسي فاغرُ","والعطرُ مشروبُ السماءِ وماطرُ",80,"ر",1,1],["أنت الرداء لروحي كم شُغفتُ به","يامعطف النور في دهليز تشريدي",81,"د",2,0],["أنت الرجال أساطيرٌ ملفقةٌ","والمجدُ أنت بلا شكٍ ولا جدلِ",82,"ل",1,0],["أنّت الروح واعتراها السقامُ","إثر ظلمٍ وجفّت الأقلامُ",83,"م",1,1],["أنت الرسالة والأشعار تشرحها","وتحتسي الحزن أيوبا وتحتملُ",84,"ل",1,0],["أنتِ الربيع وما حوت أفنانه","ولك الورود وصائف وإماء",85,"ا",2,0],["أَنتَ الرَّبِيعُ الذِّي يَسبِي نَوَاظِرَهَا","تَضُمُّ أطيَافهُ بِالوُدِّ في الحُلُمِ",86,"م",1,0],["أنتَ الرحيمُ بهِم بعدَ الذي صنعوا","ولو تشاءُ لَذَلُّوا في أقاصيها",87,"ي",3,0],["أنتَ الرجاءُ لكلِّ مَن طَلَبَ العُلا","وملاذُ مَن مَلأوا الدجى أنوارا",88,"ر",2,0],["أنتِ الرجولةُ في أبهى مكارمِها","ليتَ الرجولةُ كانت منكِ مُكتسبا",89,"ب",2,0],["أَنْتَ الرَّسُولُ لِفَكِّ أَغْلَالِ الْوَرَى","فَلْيَخْسَأِ الطُّغْيَانُ وَالْأَصْنَامُ",90,"م",1,0],["أنت الرقيب على العبا","د وأنت في الملكوت واحد",91,"د",1,0],["أنتَ الرحيمُ الواهبُ ال","رحمٰنُ .. ربٌ واحدُ",92,"د",1,0],["أنتَ الربيعُ الذي في ذاتهِ اختصرتْ","محاسنُ الكونِ ليس سواكَ مولاها",93,"ا",3,0],["أنتَ الرَّواءُ ومنكَ طُهر تَبَتُّلي","فازْجِ الصَّلاةَ على الضَّريحِ وَبَسْمِلِ",94,"ل",1,1],["أنت الريحانة أعشقها","وضياء الشمس إذا جئتِ",95,"ت",1,0],["أنتَ الرواءُ ومن عطاشِكَ يرتوي","وجدُ الحروفِ ... وسرُّنا سلسالُ",96,"ل",1,0],["أنت الرؤوف البر ما من تائب","إلا له في عفوك استثناءُ",97,"ا",2,0],["أنت الرحيم فخذ بنا نحو الهدى","وامنح رضاك لنا به الجنات",98,"ت",1,0],["‏أنت الرياديّة العظمى التي درجتْ","‏ ‏ على حماية أكبادٍ من الكَبَدِ",99,"د",1,0],["أنت الرفاه ولن نظل بفاقةٍ","قسريةٍ ولْتستعيني الربّا",100,"ب",2,0],["أنت الرئيسُ الذي يسعَى لعزتنا","ونشتهي صوتَه يُسْدي الهُدى فينا",101,"ن",2,0],["أنت الرصافة في دمي","والشوق قد أضنى الوريدْ",102,"د",1,0],["أنتِ الربيعُ هوىً، يَخضرُّ مبتهجاً","بالروحِ حتى غفى في لونهِ النظرُ",103,"ر",1,0],["أنت الرجاء وفيك كلّ مؤمّلٍ","فدع الذي في الخافقيْن يبين ُ",104,"ن",1,0],["أنتِ الربيع وكم خريف مّرني","فأصاب قلبي بالذبول ورَوعّه",105,"ه",1,1],["أنت الرسول ومن سوا","ك لنا إذا هول خنى",106,"ن",2,0],["أنت الرغائب في لمس الندى طربا","أنت النقاء وهذي الديمة المطِر",107,"ر",1,0],["أنتِ الربيع يطوف الروضَ في طرب","والليل يمرح في موجاته الغسق",108,"ق",1,0],["أنتِ الروائح في حضن الزمان نمتْ","أنت الغوادي وفيها النور والألق",108,"ق",1,0],["أنت الربيع وعطره وحقوله","والورد في لمس الندى يتبسم",109,"م",1,0],["أنتِ الربيعُ ورملُ البحرِ سيدتي","أنتِ الجميلاتُ لا ليلى ولا سحرُ",110,"ر",1,0],["أنتَ الربيعُ الذي ما مرَّ بلدتَنا","ونحنُ في اليُتمِ بين الصَيفِ والبَرَدِ",111,"د",1,0],["أنت الرّماد وفي الرياح مبعثر","صف لي - بربك- مسلكا كي أجمعكْ ؟",112,"ك",1,0],["أنت الربيعُ وليس تحيي بلدة","حتى يجاورها الربيعُ الممطرُ",113,"ر",1,0],["انت الرحيم وانت وحدك سيدى","ان عز من ياسو ترق وترفق",114,"ق",1,0],["أنت الربيعُ وفنُّ سحرِكِ خالدٌ","ولكلِّ ألوان الجمال يصوِّرُ",115,"ر",1,0]]}