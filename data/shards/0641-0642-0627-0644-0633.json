{"poems":[[93,"ألا أيها الإبريق ما لك والصلف","https://www.aldiwan.net/poem8983.html","عموديه"],[87,"كان لبعضهم حمار وجمل","https://www.aldiwan.net/poem8010.html","الرجز"],[87,"يقال كانت فأرة الغيطان","https://www.aldiwan.net/poem8045.html","الرجز"],[93,"الإبريق","https://www.poetsgate.com/ViewPoem.aspx?id=1192",""],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[473,"ولما رأى شوال جسمي ناحلا","https://www.aldiwan.net/poem59768.html","الطويل"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39008","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35373","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61030","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1950,"","https://poetry.dctabudhabi.ae/diwan/poem/177991","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27874","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121182","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93366","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91769","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32672","الوافر"],[4929,"سكبت حبي له لحنا","https://www.poetsgate.com/ViewPoem.aspx?id=199297",""],[5690,"هي التهاني لقطر الشام نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=172191",""],[5790,"سألت من أمرضني","https://www.poetsgate.com/ViewPoem.aspx?id=112144",""]],"verses":[["فَقالَ سَقَيتُ الناسَ قُلتُ لَهُ أَجَل","سَقَيتَهُم ماءَ السَحابِ الَّذي يَكَف",0,"ف",1,0],["فَقالَ سَل فِداكَ أُمّي وَأَبي","عَسى تَنالُ بي جَليلَ المَطلَبِ",1,"ب",1,0],["فَقالَ سِر وَاِلزَم أَخاكَ الوَتِدا","فَإِنَّما خُلِقتَ كَي تُقَيَّدا",1,"د",2,0],["فَقالَ سَمّيني بِنورِ القَصرِ","لِأَنَّني يا أُمُّ فَأرُ العَصرِ",2,"ر",1,0],["فقالَ: \" سقيتُ الناسَ \"، قلتُ له:أجلْ","سقيتَهمُ ماءَ السحابِ الذي وَكفْ",3,"ف",1,0],["فقال سيروا عَجَلا","سيراً يَفوتُ الأَجَلا",4,"ل",2,0],["فَقالَ سَتَغدو مِثلَ بَدري بِرُغمِهِ","فَلا تَجزَعَن أَن صِرتَ مِثلَ هِلالي",5,"ل",2,0],["فقال سجنت مثلك وهو حق","تقوله ثم ودّع باتبسام",6,"م",1,0],["فَقالَ سُلطاننا المَحمود مَن حمدَت","مِنهُ مَزاياهُ أَسنى الحمدِ وَاِمتَدحت",7,"ت",1,0],["فَقالَ سِياجٌ بِهِ بَحرُ النَدى مُتَمَوِّجٌ","فَقُلتُ وَمِن أُفقِهِ شَمسُ الإِمامَةِ تَطلُعُ",8,"ع",1,0],["فَقالَ سَرير الملك مَهلاً فَإِنني","بِمقعده أَولى وَأَحرى مِن المَهد",9,"د",1,0],["فَقالَ سَيف الدَّولة المَسعود","كَأَنَّهُ في قَومِهِ مَعبود",10,"د",1,0],["فَقالَ سمى نَفسه صَبيحا","وَقالَ يُدعى وَالدي مَليحا",11,"ح",2,0],["فقال: سألقاه حتّى يملّ","فقلت: لقد ملّ قبل اللّقاء",12,"ا",2,0],["فقال سلامٌ عندنا وتحية","عليكم وتسليم من الغادة الهيفا",13,"ف",2,0],["فقال سر نحو بغداد وسل رجلا","معمار اتقن التاريخ والادبا",14,"ب",2,0],["فَقالَ سَجَنتَ لي جاراً يُسَمَّى","بِعمروٍ قالَ يُطلقُ كلُّ عمرِو",15,"ر",2,0],["فَقال سَقاك اللَه يا معهد الهَوى","وَيا منزل الأَصحاب أَين صحابيا",16,"ي",2,0],["فقال سيروا عجلا","سيراً يفوت الأحبلا",17,"ل",2,0],["فَقالَ سِوى أَبيكَ فَذاكَ شَيخٌ","بَغيضٌ لَيسَ يَردَعُهُ الكَلامُ",18,"م",1,0],["فقالَ سِرُّكَ مفهومٌ بلا كلِمٍ","أردتُ فيه التغابي ليسَ ذاك غَبا",19,"ب",2,0],["فقال سلطاننا والصدق شئمتهُ","سيروا يا منٍ فصبحي قد أضافيها",20,"ي",3,0],["فقال سرا قلت لا","إلا على رأس علم",21,"م",1,0]]}