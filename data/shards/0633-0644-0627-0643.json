{"poems":[[36,"ألا ليت أيام مضين تعود","https://www.aldiwan.net/poem4881.html","الطويل"],[34,"ألا من لقلب لا يمل فيذهل","https://www.aldiwan.net/poem27814.html","الطويل"],[35,"ألا أيها القلب اللجوج المعذل","https://www.aldiwan.net/poem25851.html","الطويل"],[35,"أجبت بليلى من دعاني تجلدا","https://www.aldiwan.net/poem25965.html","الطويل"],[154,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[409,"أما آن للقلب أن يعقلا","https://www.aldiwan.net/poem33484.html","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38087","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62890","الطويل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103622","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57995","السريع"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77697","الطويل"],[5997,"الخل","https://www.poetsgate.com/ViewPoem.aspx?id=214226",""]],"verses":[["سَلا كُلُّ ذي شَجوٍ عَلِمتُ مَكانَهُ","وَقَلبي لِلُبنى ما حَيِيتُ وَدودُ",0,"د",1,0],["سَلا كُلُّ ذي وُدٍّ عَلِمتُ مَكانَهُ","وَأَنتَ بِها حَتّى المَماتِ مُوَكَّلُ",1,"ل",1,0],["سَلا كُلُّ ذي وُدٍّ عَنِ الحُبِّ وَاِرعَوى","وَأَنتَ بِلَيلى مُستَهامٌ مُوَكَّلُ",2,"ل",1,0],["سَلا كُلُّ صَبٍّ حِبَّهُ وَخَليلَهُ","وَأَنتَ لِلَيلى عاشِقٌ وَوَدودُ",3,"د",1,0],["سَلا كُلُّ مَهمومٍ وَهَمّي كَحالِهِ","فَصَبراً فَكَم حُزنٍ يَؤُلُ إِلى عُرسِ",4,"س",1,0],["سلا كل قلب فنون الهوى","وقلبي لفن الهوى ما سلا",5,"ل",2,0],["سَلاكُم فَما أَحلى وَأَحرى سُلُوَّه","وَإِنّيَ عِندَ المَنِّ أَستَحسِنُ السّلوى",6,"ل",3,0],["سلا كثبَ ذاك القفر يندى صعيدُه","بريِّ بني الآمال هل راحَ ينضبُ",7,"ب",1,0],["سَلا كلُّ مُشْتَاقٍ يبوحُ بشَجْوِهِ","ولم يُسْلني الكتمانُ والحزمُ أَوفقُ",8,"ق",1,0],["سلا كلّ مشتاق برؤية الفه","وكان عليّ الشوق ضربة لازم",9,"م",1,0],["سُلاَّكهُ آل نبيِّ الهدى","وكل من يقفو سواهُ هَمَج",10,"ج",1,0],["سَلا كُلّ مُشتاقٍ وَأقصَر وَجده","وَعِندَ اللوى وَجدي وَفي ساكِني اللوى",11,"و",2,0],["سَلَاْكَ الْخِلُّ يَا قَلْبِيْ كَنَوْدَا","وَأَنْكَرَ وُدَّكَ الْمَاْضِيْ جُحُوْدَا",12,"د",2,1]]}