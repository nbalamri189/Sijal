مَ عادَ النازِحونَ لِأَرضِهِم","يَتَسابَقونَ لِرُؤيَةِ الأَوطانِ",9,"ن",1,0],["يَا يَوْمَ سَمْعَانَ هَلْ أَبْقَيْتَ لِي سَكَناً","يُحَبِّبُ العَيْشَ أَوْ يُغْرِي بِسُلْوَانِ",10,"ن",1,0],["يَا يَوْمَ مَوْلِدِ مُصْطَفَى فِيكَ اعْتَلَى","أَفُقَ الكِنَانَةِ طَالِعٌ بَسَّامُ",11,"م",1,0],["يا يَومَ مُطَّلِبٍ أَصبَحتَ أَعيُنَنا","دَمعاً يَدومُ لَها ما دامَتِ الحِقَبُ",12,"ب",1,0],["يا يوم بكفيّا وبيت شبابها","أفديك من يوم بكل زمان",13,"ن",1,0],["يا يَحيَ هَل لِيَ في حَياتِكَ حاجَةٌ","مِن قَبلِ فاقِرَةٍ وَمَوتٍ عاجِلِ",14,"ل",1,0],["يا يوسف الحسن البديع جماله","والله ما عيشي بهجرك صالح",15,"ح",1,0],["يا يوم يحيى لقد أحييت داهيةً","دهياءَ للناس تبقى آخر العُصُر",16,"ر",1,0],["يا يومَ إسحاقَ بنَ عبدِ الملكْ","لم تُبقِ لي صبراً ولم تتَّركْ",17,"ك",1,1],["يا يوم إسحاقَ الذي غالهُ","أيَّ حريمٍ ليَ لم تَنْتهكْ",17,"ك",1,0],["يا يَومَنا عِندَها عُد بِالنَعيمِ لَنا","مِنها وَيا لَيلَتي في بَيتِها عودي",18,"د",2,1],["يا يَراعي سَل بورتَ آرثور عَنهُ","إِنَّ تِلكَ الحُصونِ خَيرُ شَهيدِ",19,"د",1,0],["يا يَومَ صَبَّحتَهُم وَالنَقعُ مُعتَكِرٌ","كَأَنَّهُ اللَيلُ فَوقَ الأَرضِ مُنسَدِلُ",20,"ل",1,0],["يائتيكُمُ بادي الوِفاضِ فَيَنثَني","وَكَأَنَّما في بُردِهِ المُتَوَكِّلُ",21,"ل",1,0],["يا يوم في صبحك اظهرت","لعيني طفلك",22,"ك",1,0],["يا يوسف السمح الذي ما ان تفي","بجميله كلماتنا والاحرف",23,"ف",1,0],["يا يوم اني لا ارى","فيك الا عزوة من ضبابك",24,"ك",1,0],["يا يوسُفَ بنَ أَبي سَعيدٍ وَالغِنى","لِلمُغمَدِ العَزَماتِ غَيرُ مُساعِدِ",25,"د",1,0],["يا يَومُ عَرِّج بَل وَراءَكَ يا غَدُ","قَد أَجمَعوا بَيناً وَأَنتَ المَوعِدُ",26,"د",1,1],["يَائِسَ الحاسِدونَ مِنكَ وَما مَج","دُكَ مِمّا يَرجوهُ ظَنُّ الحَسودِ",27,"د",1,0],["يا يوسُفَ بنَ مُحَمَّدٍ ما أَحمَدَ ال","رومَ اِنصِلاتَكَ بِالحُسامِ المُرهَفِ",28,"ف",1,0],["يا يوسِفَ بنَ مُحَمَّدٍ دَعوى اِمرِئٍ","عَدَلَ الهَوى بِلِسانِهِ فَدَعاكا",29,"ك",2,0],["يائِبنَةَ الدَهرِ هَل رَأَيتِ كَمِثلي","عِندَ دَفعِ المُنى وَنفيِ الشُكوكِ",30,"ك",1,1],["يا يوسُفَ بنَ أَبي سَعيدٍ لِلَّتي","يُدعى أَبوكَ لَها وَفيها فَاسمَعِ",31,"ع",1,0],["يَأَيُّها المَلِكُ الَّذي في حَربِهِ","بِالعَزمِ عَن حَدِّ الصَوارِمِ يَغتَني",32,"ن",2,0],["يَأَيُّها المَلِكُ المَنصورُ طائِرُهُ","وَمَن بِآرائِهِ الأَملاكُ تَعتَضِدُ",33,"د",1,0],["يَأَيُّها المَلِكُ الَّذي مَلَكَ الوَرى","فَغَدَت لِدَولَتِهِ العِبادُ عَبيدا",34,"د",2,0],["يَأَيُّها المَلِكُ المَنصورِ طائِرُهُ","وَمَن أَياديهِ كَالأَطواقِ في عُنُقي",35,"ق",2,0],["يا يَومَ وَقعَةِ زَوراءِ العِراقِ وَقَد","دِنّا الأَعادي كَما كانوا يَدينونا",36,"ن",2,0],["يا يَوْمَ رَدّهِمُ إلى أوطانِهِمْ","لرددتَ أرواحاً إلى أبدانِ",37,"ن",1,0],["يا يَومَ وَلَّى عنِ الدُّنيا بِهِ طُمِسَتْ","بِظُلمَةِ الرزءِ مِن أَنواركَ الغُررَ",38,"ر",1,0],["يا يَومَ قَحطَبَةٍ لَقَد أَبقَيتَ لي","حُرَقاً أَرى أَيّامَها سَتَطولُ",39,"ل",1,0],["يا يَومَ أَرشَقَ كُنتَ رَشقَ مَنِيَّةٍ","لِلخُرَّمِيَّةِ صائِبِ الآجالِ",40,"ل",1,0],["يا يَومَ شَرَّدَ يَومَ لَهوي لَهوُهُ","بِصَبابَتي وَأَذَلَّ عِزَّ تَجَلُّدي",41,"د",2,0],["يا يَومَ وَقعَةِ عَمّورِيَّةَ اِنصَرَفَت","مِنكَ المُنى حُفَّلاً مَعسولَةَ الحَلَبِ",42,"ب",1,0],["يائيةُ النظمِ لو أني أنقِّطُها","بنقطةِ القلبِ ما أدَّيْتُ ما وجبا",43,"ب",2,0],["يا يومَ جَدّدَ لِلكنانةِ عَهدَهم","بُوركتَ يوماً صالحاً ونهارا",44,"ر",2,0],["يا يوسُفَ الحُسنِ وَيا سامِرِ","يَّ الهَجرَ أَشفِق لِلهَوى العُذري",45,"ر",2,0],["يَا يَهوديُّ كَيفَ علمك بالتو","راة قُل لي أَم فاتَكَ التَعليم",46,"م",1,0],["يا يَهوديّ هَل سَمعتَ بِشَعب","ضَلَّ حَتّى في كُلِ قُطرٍ يَهيم",46,"م",1,0],["يا يَهودي لا عَليك سَلامٌ","وَإِذا شئت لا عَلَيك شلوم",46,"م",1,0],["يا يد الموت ما عهدت أُلوفاً","منك هوجاً تمتد للاغتيالِ",47,"ل",1,0],["يَأَيُّها المَلِكُ الَّذي أَمسَت لَهُ","بُصرى وَغَزَّةَ سَهلُها وَالأَجرَعُ",48,"ع",1,1],["يا ياسَميناً بِالمِسكِ مُختَلِطاً","يا جُلَّناراً في طيبِ نِسرينِ",49,"ن",1,0],["يا يراع الأديب غنّ لشعب","فتح العين منه بعد التَغاضي",50,"ض",2,1],["يا ياسمين تفتح","يا أقحوان اِبتسم لي",51,"ل",2,0],["يا يوسف العظمات غرسُكَ لم يضِع","وجَناهُ أخلدُ من نتاج قرائحِ",52,"ح",1,0],["يأَيُّها الأُمِيُّ حَسبُكَ رُتبَةً","في العِلمِ أَن دانَت بِكَ العُلَماءُ",53,"ا",2,0],["يأَيُّها المُسرى بِهِ شَرَفاً إِلى","ما لا تَنالُ الشَمسُ وَالجَوزاءُ",53,"ا",2,0],["يا يوم صفِّين بمن قضاكا","هل أنصف الجمعان إذ خَاضَاكا",54,"ك",2,0],["يأَيُّها الصَّادِي إِلى نَيْلِ الْمُنَى","رِدْ بَحْرَ سُدَّتِهِ تَفُزْ بِوَلائِهِ",55,"ا",3,0],["يَا يَوْمَ غَارِةِ ذِي الغُرُو","رِ وَقَدْ دَهَاهُمْ مِنْ أَمَمْ",56,"م",1,0],["يَا يُوسُفَ الشَّهْمُ العَزِيزْ","إِفْرَحَ وَطِبْ وَاهْنَأْ بِنَجْلِكْ",57,"ك",1,1],["يَا يَوْمَ طِيَّتِهِ أَدَلْتَ دُجُنَّةً","نَكْرَاءَ مِنْ أَنْوَارِ أَوْهَرَ شَارِقِ",58,"ق",1,0],["يَا يَوْمنا إِنْ كُنْتَ مُفْتَتَحاً لِمَا","نَرْجُو فإِنَّكَ أَبْهَجُ الأَعْيَادِ",59,"د",1,0],["يَا يَوْمَ قَتْل بُزَرْجُمَهْرَ وَقَدْ أَتَوْا","فِيهِ يُلَبُّونَ النِّدَاءَ عِجَالاَ",60,"ل",2,0],["يِا يُوسُفَ الحُسْنِ وَالإِحْسَانِ دُمْ مَثلاً","بِالاسْتِقَامَةِ لِلجِيلِ الَّذِي انْحَرَفَا",61,"ف",2,0],["يا يومَ مولِدِه وما","لكَ في جمالِكَ من مُفاخرْ",62,"ر",1,0],["يا يومَ فاروقٍ وكمْ","لكَ عند مصرٍ من مآثِرْ",62,"ر",1,0],["يا يومَ أمريكا وكم بكَ موقف","أعيا النُّهىَ وبراعةَ الوصّافِ",63,"ف",1,0],["يَأَيُّها النَّاعِي حَنَانَكَ إنّما","هِيَ أُمَّةٌ أَضْحَتْ بِغَيْرِ ثِمَال",64,"ل",1,0],["يأيها السَادِرُ المُزوَرُّ مِن صَلَفٍ","مَهْلاً، فَإِنَّكَ بِالأَيَّامِ مُنْخَدِعُ",65,"ع",1,0],["يا يوم مولده، تعالَ مبشِّرًا","ضلَّ السلام عن الأنَامِ، فهاته",66,"ت",2,0],["يا يومَ مولده طلعتَ بكوكب","ما انشقت الأبراجُ عن هالاته",66,"ت",2,0],["يأيها الوادي الجميل، تحيَّةً","بشراكَ! قدْ وافاكَ خَيْرُ مُعَمِّر",67,"ر",1,0],["يأيها الحفلُ الكريمُ، تحيةً","من نَفْحِها تتعطَّرُ الأزهار",68,"ر",1,0],["يأَيُّها السَّدُّ، بشِّرْ بالرخاء؛ فما","حويتَ ماءً، ولكنْ ذوبَ عِقْيانِ",69,"ن",1,0],["يأيها الرجل الآليُّ، هل لك في","ود أساقيكه ماء وصهباء؟",70,"ا",2,0],["يأَيها العهدُ البَغِي","ضُ، خَسِئْت من بين العهود!",71,"د",1,0],["يأيها العربي، لا ذُقْت القرَى","أبدًا، ولا نِعمَتْ جُفونُكَ بالكرى!",72,"ر",2,0],["يأيُها الجُنْدُ الأُلَى ما زَيَّنُوا","صَدْرَ الجِهاد بأنْجُمِ وهِلالِ",73,"ل",1,0],["يأيُّها الضيفُ الكري","مُ، نزلتَّ دار أخٍ حميم",74,"م",1,0],["يأيها الواشي، رعا","ك الله من بين الوشاة!",75,"ا",2,