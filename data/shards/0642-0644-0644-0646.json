{"poems":[[90,"قل لنجلا نجلا أبي اللمع إني","https://www.aldiwan.net/poem45060.html","الخفيف"],[53,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[53,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[53,"يا أبا المستهل ماذا تقول","https://www.aldiwan.net/poem65846.html","الخفيف"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[47,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[50,"قل لنداماي وجلاسي","https://www.aldiwan.net/poem64317.html","السريع"],[234,"قل لنزار أنت أس العلا","https://www.aldiwan.net/poem50994.html","السريع"],[302,"خطرت في شمائل ونعوت","https://www.aldiwan.net/poem33316.html","الخفيف"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[408,"يا أديبا لا يداني شأوه","https://www.aldiwan.net/poem46445.html","الرمل"],[408,"من ترى غير علي","https://www.aldiwan.net/poem46974.html","مجزوء الرمل"],[438,"قل لنجم الدين يا من نهتدي","https://www.aldiwan.net/poem12646.html","الرمل"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[525,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[556,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[563,"قل لنفس جهلت بين الورى","https://www.aldiwan.net/poem34526.html","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77888","المنسرح"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128018","الخفيف"],[1933,"","https://poetry.dctabudhabi.ae/diwan/poem/144319","الخفيف"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82937","الخفيف"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137464",""],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124679","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110223","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110224","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110198","المديد"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205753","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99228","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86401","الخفيف"],[4149,"","https://poetry.dctabudhabi.ae/diwan/poem/145504","السريع"],[4729,"مالها تستعيضُ بالسهل وَعرا","https://www.poetsgate.com/ViewPoem.aspx?id=109446",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["قل لنجلا نجلا أبي اللمع إني","عاشقٌ نور فجرها الوضاح",0,"ح",1,1],["قل لِنُجْح أخطأتَ باب النّجاح","بل تعاطيتَهُ بلا مفتاحِ",1,"ح",1,1],["قل لنا يا سلامة بن سعيدٍ","أيُ شيءٍ عشقتَهُ من كنوزِ",2,"ز",1,1],["قلْ لنا بالذي يُزيرك في النو","مِ خيالَ الرغيفِ كيف تقولُ",3,"ل",1,0],["قل لنا أيها الرئيس الذي قد","بان عن مصر من يسد مسدك",4,"ك",1,0],["قُل لَنا وَالنُجومُ مِنكَ بِبالٍ","لِم أَخَلَّت بِطالِعَيكَ السُعودُ",5,"د",1,0],["قُل لِنَدامايَ وَجُلّاسي","هَل لِيَ مِن عَبدَةَ مِن آسِ",6,"س",1,1],["قل لنزارٍ أنت أُسُّ العلا","وفرعها الثابت في الأُسّ",7,"س",1,1],["قل لِنَفسٍ قد نازَعَتكَ إِليها","إِن تَرومي بها الحَياةَ فَموتي",8,"ت",2,0],["قُلْ لنجدٍ عنّا سقَى اللّهُ نجداً","قولَ مَن ضَمَّ منه في القلبِ وَجدا",9,"د",2,0],["قُلْ لنا ما اسمٌ تَرى جملتَهُ","ضِدّه في الوصْفِ إنْ حرفٌ سقَطْ",10,"ط",1,0],["قُلْ لَنا فالأمْرُ إنْ","أَنْصفتَنَا غيرُ خَفيِّ",11,"ي",1,0],["قل لنجمِ الدينِ يا من نهتدي","من مُحيّاهُ بأذكى قبَسِ",12,"س",1,1],["قل لنوتِيَّك شَرِّعْ آمناً","حَدَثَ التَّيارِ والموجِ العصيبِ",13,"ب",1,0],["قل لنا كيف اختصرت المرتقى","وتناولت المعالي باليد",14,"د",1,0],["قل لنسناس الهوى خلّ المزور","بالنا لاهيّ عن كلّ بزور",15,"ر",1,0],["قل لناعي أبي عليٍّ ألا لي","تَ الّذي قلت لَم يَكن مَسموعا",16,"ع",2,0],["قل لنفس جهلت بين الورى","أمرَ مولىً لم يزل مقتدرا",17,"ر",2,1],["قل لِنَسيم الصبا إِذا اِنتَصَبا","من جانب الطور شيّقاً طربا",18,"ب",2,1],["قل لنار فوق الخدود تلظت","يا حسينا تكن على سلاما",19,"م",2,0],["قل لنبل القسي ما أنت إلا","عند لحظ الحبيب شوك القتادة",20,"د",2,0],["قُل لَنا ما الَّذي أَعا","دَكَ لِلذِّئبِ مرتَعا",21,"ع",2,0],["قل لنا ما اسم رباعي له","ان تبدى في الورى تعنو الأسود",22,"د",1,0],["قلِّلْ نوالَه في الابتداء","ولا تقرّبه فِي الانتهاء",23,"ا",2,0],["قل لنا في القتيلِ كيف تحلّى بدماءِ","القتيلِ منكَ الماءُ",24,"ا",1,0],["قل لنا ماذا يضاهي قولنا","ظُنَّ برقاً أو سحاباً مُمطِرا",25,"ر",2,0],["قل لنا ما مثلُ قولي","مَرَضٌ مُلكُ يميني",26,"ي",1,0],["قُل لنا يا صاحِ قبلاً تُؤخَذُ","لِلظى عنا وينقطع الخبر",27,"ر",1,0],["قُل لنا ان كنتَ ذا فَهمٍ","ما كقولي والدٌ آمِل",28,"ل",1,0],["قل لنا السرَّ كلَّه يا نبيِّي","أو فها نحن في الهوى سيان",29,"ن",1,0],["قل لنا كيف ترانا ها هنا","قال ماذا إننا للفائزون",30,"ن",1,0],["قلْ لنسيمٍ زار عندَ الصباحْ","من حَلَكِيَّاتِ الرُّبَى والبِطاحْ",31,"ح",1,1],["قل لنا أيها البديع جمالا","أببغداد يوسف أم بمصر",32,"ر",1,0],["قل لنظام الملك في صدره","يا سيد الناس أما فرصه؟",33,"ص",2,1],["قل لنور الدين المليك الذي","فاضَ نَداه فَعَمَّ زيداً وعَمرا",34,"ر",2,0],["قل لنعش يمشي على أرؤس النا","س مسجّى في حلّتي أحزان",35,"ن",1,0],["قل لنَا ياقصيدُ في أيِّ نَوْءٍ","كوكبُ السّعدِ ينفَحُ الأَشعَارا",36,"ر",2,0]]}