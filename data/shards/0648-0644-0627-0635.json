oetsgate.com/ViewPoem.aspx?id=203429",""],[5616,"زيارة","https://www.poetsgate.com/ViewPoem.aspx?id=203497",""],[5664,"سلامات","https://www.poetsgate.com/ViewPoem.aspx?id=176698",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[5749,"الارض في خطر","https://www.poetsgate.com/ViewPoem.aspx?id=203716",""],[5756,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=5436",""],[5785,"يا ربّ يا مسبل علينا الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131575",""],[5821,"الممرضات","https://www.poetsgate.com/ViewPoem.aspx?id=113765",""],[5848,"لا صرت","https://www.poetsgate.com/ViewPoem.aspx?id=48991",""],[5881,"والبشرى معطلةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183773",""],[6115,"تمهلو ياللى عن الحق غادين","https://www.poetsgate.com/ViewPoem.aspx?id=196455",""],[6184,"أأضحكُ عِنْدَما يَبْكي الجليلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78613&r=&rc=5",""],[6277,"سهاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64472&r=&rc=35",""]],"verses":[["وَلَأَصبَحا في الرَوعِ مِن عَدَدي","كَرَماً وَفي اللَأواءِ مِن عُدَدي",0,"د",2,0],["وَلا صادَفوا في الدَهرِ مَنجىً لَخائِفٍ","وَلا وَجَدوا في الأَرضِ مَأوىً لِمُطرَدِ",1,"د",1,0],["وَلا صُلحَ حَتّى يَنظُروا مِن زُهائِها","شَواهِقَ لا يَبلُغنَ صَوتَ المُصَوِّتِ",2,"ت",1,0],["وَلا صَبَرتَ عَلى ذُلٍّ وَمَنقَصَةٍ","وَلا حَذِرتَ عَلى عَذلٍ وَتَأنيبِ",3,"ب",1,0],["ولا صَحْبَ لي إلا الأسنّةُ والظُّبا","بحيثُ عُيونُ الشُّهْبِ بالنّقْعِ تُكْحَلُ",4,"ل",1,0],["وَلاَ صُرِفَتْ فِيهَا دَقَائِقُ نِسْبَةٍ","وَلاَ حُقِّقَت فِيهَا طَوَالِعُ بُلْدَانِ",5,"ن",1,0],["وَلاَ صَاحِبٌ إِلاَّ سِنَانٌ وَصَارِمٌ","وَعَزْمٌ بِتَيْسِيرِ الْعَسِيرِ كَفِيلُ",6,"ل",1,0],["وَلَأَصبَحَت خَيلُ الفرنجِ مُغيرَةً","تَجتابُ ما بَينَ البَقيعِ إِلى كُدى",7,"د",2,0],["وَلاَ صَاحِبَ الخَيفِ الطَرِيدَ مُحَمَّداً","ولو أُكثِرَ الإِيعَادث لِي والتَرَهُّبُ",8,"ب",1,0],["وَلا صَحِبَتنِيَ الفُرسانُ إِن لَم","أُصاحِبها بِمَأمونِ الفِرارِ",9,"ر",1,0],["وَلَأَصدُقَنَّ إِلى حُذَيفَةَ مِدحَتي","لِفَتى اليَسارِ وَفارِسِ الأَجرافِ",10,"ف",1,1],["ولأُصلينَّك جاحمَ ال","شِعر الذي هِجت التهابهْ",11,"ب",2,0],["ولا صِرتُ أدعوهُ لدفعِ ملمّةٍ","من الدهر إلا كان إحدى النوائبِ",12,"ب",1,0],["ولا صِبغ إلا صبغُ من صبغ الدجى","دجوجيَّة والصبح أنور أزهرا",13,"ر",2,0],["ولا صمدت إلا إليكم ملمة","ولا كان فيكم يوم ذاك دفوعها",14,"ع",3,0],["ولا صِلُّ أصْلالٍ يبيت مُراقباً","بنْهشَتِهِ مقدارَ نفس متى يُحَمْ",15,"م",1,0],["ولا صلاح لفرد او لاسرته","الا اذا ارتد عن عادته البشر",16,"ر",1,0],["وَلَاِصطُلِمَت جُرثومَةٌ تَغلِبِيَّةٌ","بِها اِستُبقِيَت أَغصانُها وَفُروعُها",17,"ع",3,0],["وَلأَصلُ يَسقي أَبَداً فَرعَهُ","وَتُثمِرُ الأَكمامُ مِن مائِهِ",18,"ا",3,0],["وَلا صَنَعَت فيها ظُباهُ مَآدِباً","فَأَصبَحَ مِن أَضيافِهِ الذِئبُ وَالنَسرُ",19,"ر",1,0],["وَلا صارِمٌ ماضي الغِرارِ بِكَفِّهِ","مَضارِبُهُ في الرَوعِ بِالدَمِ تَرعَفُ",20,"ف",1,0],["وَلا صَبَوتُ إِلى ذِكرِ الجَليسِ لَكُم","لِأَنَّ ذِكرَكُمُ في خاطِري وَفَمي",21,"ي",1,0],["وَلا صَبَرْنَا عَلَى الدُّنْيَا وَأَسْهُمُها","قَبْلَ الثِّيابِ تَشُقُّ القَلْبَ والكَبِدَا",22,"د",2,0],["وَلا صاحِبُ التَطوافِ يَعمُرُ مَنهَلاً","وَرَبعاً إِذا لَم يُخلِ رَبعاً وَمَنهَلا",23,"ل",2,0],["وَلَاِصطُفِيَت شَولٌ فَظَلَّت شَوارِداً","قُرومُ عِشارٍ ما لَهُنَّ مَبارِكُ",24,"ك",1,0],["وَلا صاحِبٌ إِلّا طَريرُ مُهَنَّدٍ","وَمُعتَدِلٌ لَدنُ المَهَزَّةِ رَسمَرُ",25,"ر",1,0],["وَلا صَبرَ لي عَنها وَلا لِيَ سَلوَةٌ","سِوى سَقَراتٍ في الحَشا وَمَدامِعُ",26,"ع",1,0],["وَلا صيدَ إِلّا بِوَثّابَةٍ","تَطيرُ عَلى أَربَعٍ كَالعَذَب",27,"ب",1,0],["ولا صارِفٌ راياتِهِ عن مُحارِبٍ","ولا مُمْسِكٌ معروفَهُ عن مُسالم",28,"م",1,0],["ولا صائحاً كالعَير في يوم لذةٍ","يناظرُ في تفضيل عثمان أو علي",29,"ل",2,0],["وَلا صاحِبٌ أَشكو إِلَيهِ فَأَشتَفي","إِذا ما شَكا رَأسي مَكانَ الوَسائِد",30,"د",1,0],["ولا صاحَ بالخيل اقدُمي في عَجاجةٍ","إذا قيل حِيدي في ضنْكِها أُمّي",31,"م",2,0],["وَلا صَرّفَ الخَطّيَّ مثْلَ يَمينِهِ","يَمينٌ وإنْ كانَتْ مُعاوَدَةَ النُّعْمِ",31,"م",1,0],["ولا صبر حتى يمسك القرط رجفة","بآذانها أو قلبي المتهيج",32,"ج",1,0],["ولا صراطا كما يذ","كرونه مستقيما",33,"م",2,0],["ولا صَحِبْتُ ذئابَ الإنسِ طاويةً","تُراقِبُ الجَدْيَ في الخضراء مَسبوتا",34,"ت",2,0],["ولا صدّت سرايانا عدوا","ولا هاجت حمّيتنا كفاحا",35,"ح",2,0],["وَلا صَاحِبٌ غَيْرُ الْحُسامِ مَنُوطَةٌ","حَمَائِلُهُ مِنِّي عَلَى عَاتِقٍ صَلْدِ",36,"د",1,0],["ولا صناديق سوى رزمةٍ","تدس في شر الصناديق",37,"ق",1,0],["ولا صَفَنتْ به خيل عِرَابٌ","ولا وخَدت به نوقٌ عشار",38,"ر",1,0],["ولا صاحب إلا سنان وصارم","وعزم بتيسير السبيل كفيل",39,"ل",1,0],["ولا صاحبٌ أشكو إليه فأشتفي","إذا ما شكى رأسي مكان الوسائد",40,"د",1,0],["ولأُصلينَّك جاحمَ الش","شِعر الذي هِجت التهابهْ",41,"ب",2,0],["ولأصحابه النجوم وأهل البي","ت ساداتنا عيون الآل",42,"ل",1,0],["ولأصلِينّكَ بالصدودِ وأحرق","نَّكَ بالجحودِ وأحرمَنْكَ خطابي",43,"ب",2,0],["ولا صِيدَ في شَرَكِ النائباتِ","فتىً لشروطِ القتَى جامعُ",44,"ع",1,0],["ولا صدرت قصدا ولا اتصفوا بها","ولا طرقت إلا طروق المصيبة",45,"ه",1,0],["وَلَأَصبَحَت يأَجوجُ مَع مَأجوجِها","وَكَأَنَّ غابِرَها رَمادٌ أَرمَدُ",46,"د",1,0],["ولا صارفا عني حبال الهوى ولا","تصاممت عما يقطعن وصل وصلتي",47,"ت",2,0],["ولا صحبتْ كفّي على دلجِ السُرى","أبرَّ وأوفى منْ رقيق المضاربِ",48,"ب",1,0],["ولا صبّ ختور العهد يمشى","على جنباته مشى الحباب",49,"ب",1,0],["ولا صهباء يحسوها بنوه","وقد قبست من الذهب المذاب",49,"ب",1,0],["ولا صبا في الصبح نحو الصبا","ولا ثارت شجوه الأينق",50,"ق",1,0],["ولا صاحبٌ إلا المطيةُ حولَها","ذئابٌ تبارى في الفلاةِ وأضبع",51,"ع",1,0],["ولا صحبتني من أياديه أنعم","تقوم مقام الخصب في البلد المحل",52,"ل",1,0],["ولا صهيلاً زئيرُ الأُسدِ جاوبَه","ولا هجيراً يُذيبُ الصخرَ إلهابا",53,"ب",2,0],["وَلا صَدَّ عَن بابِ الإِشارَةِ قاسِط","مُفِيض الثنا فِي الأَرضِ كالعارِض الحدِّ",54,"د",1,0],["ولا صفا قلب به تبدل","ولا تقدس من يقل بثاني",55,"ي",1,0],["ولا صدى الحر في كفّه","وذاق الدخيل نعيم الصفاء",56,"ا",2,0],["وَلا صارَ وَقَد كانَ","لَبيباً تابَعَ الجَهلَ",57,"ل",1,0],["وَلا صامِتاً إِلّا وَقَد راحَ ناطِقاً","وَفي صَمتِهِ آياتِ إِحسانِكُم يَتلو",58,"ل",2,0],["وَلا صارَ ذاكَ البَهوُ مُلكاً مُحَجَّباً","وَلا جَرَّ ذاكَ الرَعبُ جَيشاً عَرَمرَما",59,"م",2,0],["ولا صَدَرت عنها الع