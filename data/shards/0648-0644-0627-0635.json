{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[53,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[47,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[23,"ولأصدقن إلى حذيفة مدحتي","https://www.aldiwan.net/poem21598.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"وزهدني في الناس معرفتي بهم","https://www.aldiwan.net/poem8680.html","الطويل"],[51,"كما لو أردنا أن نحيل شبابنا","https://www.aldiwan.net/poem64059.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[89,"أين القصيد التي أبياتها خزف","https://www.aldiwan.net/poem44782.html","البسيط"],[45,"منى النفس في أسماء لو تستطيعها","https://www.aldiwan.net/poem64701.html","الطويل"],[49,"يا طالب الحكمة من أهلها","https://www.aldiwan.net/poem10317.html","السريع"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[66,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[66,"والله ما سهرت عيني لبعدكم","https://www.aldiwan.net/poem40320.html","البسيط"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[44,"قرى دارهم مني الدموع السوافك","https://www.aldiwan.net/poem30391.html","الطويل"],[74,"سرى يرتمي ركضا به كل موجة","https://www.aldiwan.net/poem12927.html","الطويل"],[33,"إذا حجبت ليلى فما أنت صانع","https://www.aldiwan.net/poem25888.html","الطويل"],[52,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[48,"خليلي أقعد للصبوح ولا تقل","https://www.aldiwan.net/poem66601.html","الطويل"],[50,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85286","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85843","المجتث"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[50,"أَلاَ مَنْ لِصَبٍّ عَازِبِ النَّوْم سَاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21701",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""]],"verses":[["وَلَأَصبَحا في الرَوعِ مِن عَدَدي","كَرَماً وَفي اللَأواءِ مِن عُدَدي",0,"د",2,0],["وَلا صادَفوا في الدَهرِ مَنجىً لَخائِفٍ","وَلا وَجَدوا في الأَرضِ مَأوىً لِمُطرَدِ",1,"د",1,0],["وَلا صُلحَ حَتّى يَنظُروا مِن زُهائِها","شَواهِقَ لا يَبلُغنَ صَوتَ المُصَوِّتِ",2,"ت",1,0],["وَلا صَبَرتَ عَلى ذُلٍّ وَمَنقَصَةٍ","وَلا حَذِرتَ عَلى عَذلٍ وَتَأنيبِ",3,"ب",1,0],["ولا صَحْبَ لي إلا الأسنّةُ والظُّبا","بحيثُ عُيونُ الشُّهْبِ بالنّقْعِ تُكْحَلُ",4,"ل",1,0],["وَلاَ صُرِفَتْ فِيهَا دَقَائِقُ نِسْبَةٍ","وَلاَ حُقِّقَت فِيهَا طَوَالِعُ بُلْدَانِ",5,"ن",1,0],["وَلاَ صَاحِبٌ إِلاَّ سِنَانٌ وَصَارِمٌ","وَعَزْمٌ بِتَيْسِيرِ الْعَسِيرِ كَفِيلُ",6,"ل",1,0],["وَلَأَصبَحَت خَيلُ الفرنجِ مُغيرَةً","تَجتابُ ما بَينَ البَقيعِ إِلى كُدى",7,"د",2,0],["وَلاَ صَاحِبَ الخَيفِ الطَرِيدَ مُحَمَّداً","ولو أُكثِرَ الإِيعَادث لِي والتَرَهُّبُ",8,"ب",1,0],["وَلا صَحِبَتنِيَ الفُرسانُ إِن لَم","أُصاحِبها بِمَأمونِ الفِرارِ",9,"ر",1,0],["وَلَأَصدُقَنَّ إِلى حُذَيفَةَ مِدحَتي","لِفَتى اليَسارِ وَفارِسِ الأَجرافِ",10,"ف",1,1],["ولأُصلينَّك جاحمَ ال","شِعر الذي هِجت التهابهْ",11,"ب",2,0],["ولا صِرتُ أدعوهُ لدفعِ ملمّةٍ","من الدهر إلا كان إحدى النوائبِ",12,"ب",1,0],["ولا صِبغ إلا صبغُ من صبغ الدجى","دجوجيَّة والصبح أنور أزهرا",13,"ر",2,0],["ولا صمدت إلا إليكم ملمة","ولا كان فيكم يوم ذاك دفوعها",14,"ع",3,0],["ولا صِلُّ أصْلالٍ يبيت مُراقباً","بنْهشَتِهِ مقدارَ نفس متى يُحَمْ",15,"م",1,0],["ولا صلاح لفرد او لاسرته","الا اذا ارتد عن عادته البشر",16,"ر",1,0],["وَلَاِصطُلِمَت جُرثومَةٌ تَغلِبِيَّةٌ","بِها اِستُبقِيَت أَغصانُها وَفُروعُها",17,"ع",3,0],["وَلأَصلُ يَسقي أَبَداً فَرعَهُ","وَتُثمِرُ الأَكمامُ مِن مائِهِ",18,"ا",3,0],["وَلا صَنَعَت فيها ظُباهُ مَآدِباً","فَأَصبَحَ مِن أَضيافِهِ الذِئبُ وَالنَسرُ",19,"ر",1,0],["وَلا صارِمٌ ماضي الغِرارِ بِكَفِّهِ","مَضارِبُهُ في الرَوعِ بِالدَمِ تَرعَفُ",20,"ف",1,0],["وَلا صَبَوتُ إِلى ذِكرِ الجَليسِ لَكُم","لِأَنَّ ذِكرَكُمُ في خاطِري وَفَمي",21,"ي",1,0],["وَلا صاحِبُ التَطوافِ يَعمُرُ مَنهَلاً","وَرَبعاً إِذا لَم يُخلِ رَبعاً وَمَنهَلا",22,"ل",2,0],["وَلَاِصطُفِيَت شَولٌ فَظَلَّت شَوارِداً","قُرومُ عِشارٍ ما لَهُنَّ مَبارِكُ",23,"ك",1,0],["وَلا صاحِبٌ إِلّا طَريرُ مُهَنَّدٍ","وَمُعتَدِلٌ لَدنُ المَهَزَّةِ رَسمَرُ",24,"ر",1,0],["وَلا صَبرَ لي عَنها وَلا لِيَ سَلوَةٌ","سِوى سَقَراتٍ في الحَشا وَمَدامِعُ",25,"ع",1,0],["وَلا صيدَ إِلّا بِوَثّابَةٍ","تَطيرُ عَلى أَربَعٍ كَالعَذَب",26,"ب",1,0],["ولا صارِفٌ راياتِهِ عن مُحارِبٍ","ولا مُمْسِكٌ معروفَهُ عن مُسالم",27,"م",1,0],["ولا صائحاً كالعَير في يوم لذةٍ","يناظرُ في تفضيل عثمان أو علي",28,"ل",2,0],["وَلا صاحِبٌ أَشكو إِلَيهِ فَأَشتَفي","إِذا ما شَكا رَأسي مَكانَ الوَسائِد",29,"د",1,0],["ولا صاحَ بالخيل اقدُمي في عَجاجةٍ","إذا قيل حِيدي في ضنْكِها أُمّي",30,"م",2,0],["وَلا صَرّفَ الخَطّيَّ مثْلَ يَمينِهِ","يَمينٌ وإنْ كانَتْ مُعاوَدَةَ النُّعْمِ",30,"م",1,0],["ولا صبر حتى يمسك القرط رجفة","بآذانها أو قلبي المتهيج",31,"ج",1,0],["ولا صراطا كما يذ","كرونه مستقيما",32,"م",2,0],["ولا صَحِبْتُ ذئابَ الإنسِ طاويةً","تُراقِبُ الجَدْيَ في الخضراء مَسبوتا",33,"ت",2,0],["وَلا صَاحِبٌ غَيْرُ الْحُسامِ مَنُوطَةٌ","حَمَائِلُهُ مِنِّي عَلَى عَاتِقٍ صَلْدِ",34,"د",1,0],["ولا صناديق سوى رزمةٍ","تدس في شر الصناديق",35,"ق",1,0],["ولا صَفَنتْ به خيل عِرَابٌ","ولا وخَدت به نوقٌ عشار",36,"ر",1,0],["ولا صاحب إلا سنان وصارم","وعزم بتيسير السبيل كفيل",37,"ل",1,0],["ولا صاحبٌ أشكو إليه فأشتفي","إذا ما شكى رأسي مكان الوسائد",38,"د",1,0],["ولأُصلينَّك جاحمَ الش","شِعر الذي هِجت التهابهْ",39,"ب",2,0]]}