{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[53,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[47,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[23,"ولأصدقن إلى حذيفة مدحتي","https://www.aldiwan.net/poem21598.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"وزهدني في الناس معرفتي بهم","https://www.aldiwan.net/poem8680.html","الطويل"],[51,"كما لو أردنا أن نحيل شبابنا","https://www.aldiwan.net/poem64059.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[89,"أين القصيد التي أبياتها خزف","https://www.aldiwan.net/poem44782.html","البسيط"],[45,"منى النفس في أسماء لو تستطيعها","https://www.aldiwan.net/poem64701.html","الطويل"],[49,"يا طالب الحكمة من أهلها","https://www.aldiwan.net/poem10317.html","السريع"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[66,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[66,"والله ما سهرت عيني لبعدكم","https://www.aldiwan.net/poem40320.html","البسيط"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[44,"قرى دارهم مني الدموع السوافك","https://www.aldiwan.net/poem30391.html","الطويل"],[74,"سرى يرتمي ركضا به كل موجة","https://www.aldiwan.net/poem12927.html","الطويل"],[33,"إذا حجبت ليلى فما أنت صانع","https://www.aldiwan.net/poem25888.html","الطويل"],[52,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[48,"خليلي أقعد للصبوح ولا تقل","https://www.aldiwan.net/poem66601.html","الطويل"],[50,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85286","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85843","المجتث"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[50,"أَلاَ مَنْ لِصَبٍّ عَازِبِ النَّوْم سَاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21701",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[115,"لمعاليك جئت أعرض حالي","https://www.aldiwan.net/poem42171.html","الخفيف"],[135,"ما بال أصدق وعدها كسراب","https://www.aldiwan.net/poem49142.html","الكامل"],[142,"عزاء فما يصنع الجازع","https://www.aldiwan.net/poem58403.html","المتقارب"],[160,"رثت لنحولي في هواها وذلتي","https://www.aldiwan.net/poem59010.html","الطويل"],[169,"بعثت تهدد بالنوى وتوعد","https://www.aldiwan.net/poem1617.html",""],[184,"إذا ما وردنا ماء مدين أشرقت","https://www.aldiwan.net/poem23816.html","عموديه"],[198,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[231,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[241,"جرى الدمع حتى ليس في الجفن مدمع","https://www.aldiwan.net/poem45765.html","الطويل"],[261,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[270,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[275,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[304,"هبت رياح القرب والتداني","https://www.aldiwan.net/poem16780.html","الرجز"],[328,"دراهم يصنعها ربها","https://www.aldiwan.net/poem55042.html","المتقارب"],[349,"بنقط زاد في الخط","https://www.aldiwan.net/poem15837.html","الهزج"],[349,"سوى حبكم يسلى وغيري له يسلو","https://www.aldiwan.net/poem15860.html","مجزوء الطويل"],[366,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[371,"لئن حجبت نجل العيون وحورها","https://www.aldiwan.net/poem57450.html","الطويل"],[429,"لا ينفعنّ الفتى إلا سريرته","https://www.aldiwan.net/poem40997.html","البسيط"],[432,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[432,"الله يعلم أنني ما خلته","https://www.aldiwan.net/poem12780.html","الكامل"],[439,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[439,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[441,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[458,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[464,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[464,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[464,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[465,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[500,"رعى الزمان فرأى العجائبا","https://www.aldiwan.net/poem37663.html","الرجز"],[500,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[500,"بالله يا سائق الأظعان خذ خبرا","https://www.aldiwan.net/poem38017.html","البسيط"],[514,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[514,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[514,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[515,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[551,"أقلني ربي بالذين اصطفيتهم","https://www.aldiwan.net/poem47370.html","الطويل"],[551,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[551,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[558,"ألا إن ذاتي ذات كل الخلائق","https://www.aldiwan.net/poem34328.html","الطويل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[575,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"]],"verses":[["وَلَأَصبَحا في الرَوعِ مِن عَدَدي","كَرَماً وَفي اللَأواءِ مِن عُدَدي",0,"د",2,0],["وَلا صادَفوا في الدَهرِ مَنجىً لَخائِفٍ","وَلا وَجَدوا في الأَرضِ مَأوىً لِمُطرَدِ",1,"د",1,0],["وَلا صُلحَ حَتّى يَنظُروا مِن زُهائِها","شَواهِقَ لا يَبلُغنَ صَوتَ المُصَوِّتِ",2,"ت",1,0],["وَلا صَبَرتَ عَلى ذُلٍّ وَمَنقَصَةٍ","وَلا حَذِرتَ عَلى عَذلٍ وَتَأنيبِ",3,"ب",1,0],["ولا صَحْبَ لي إلا الأسنّةُ والظُّبا","بحيثُ عُيونُ الشُّهْبِ بالنّقْعِ تُكْحَلُ",4,"ل",1,0],["وَلاَ صُرِفَتْ فِيهَا دَقَائِقُ نِسْبَةٍ","وَلاَ حُقِّقَت فِيهَا طَوَالِعُ بُلْدَانِ",5,"ن",1,0],["وَلاَ صَاحِبٌ إِلاَّ سِنَانٌ وَصَارِمٌ","وَعَزْمٌ بِتَيْسِيرِ الْعَسِيرِ كَفِيلُ",6,"ل",1,0],["وَلَأَصبَحَت خَيلُ الفرنجِ مُغيرَةً","تَجتابُ ما بَينَ البَقيعِ إِلى كُدى",7,"د",2,0],["وَلاَ صَاحِبَ الخَيفِ الطَرِيدَ مُحَمَّداً","ولو أُكثِرَ الإِيعَادث لِي والتَرَهُّبُ",8,"ب",1,0],["وَلا صَحِبَتنِيَ الفُرسانُ إِن لَم","أُصاحِبها بِمَأمونِ الفِرارِ",9,"ر",1,0],["وَلَأَصدُقَنَّ إِلى حُذَيفَةَ مِدحَتي","لِفَتى اليَسارِ وَفارِسِ الأَجرافِ",10,"ف",1,1],["ولأُصلينَّك جاحمَ ال","شِعر الذي هِجت التهابهْ",11,"ب",2,0],["ولا صِرتُ أدعوهُ لدفعِ ملمّةٍ","من الدهر إلا كان إحدى النوائبِ",12,"ب",1,0],["ولا صِبغ إلا صبغُ من صبغ الدجى","دجوجيَّة والصبح أنور أزهرا",13,"ر",2,0],["ولا صمدت إلا إليكم ملمة","ولا كان فيكم يوم ذاك دفوعها",14,"ع",3,0],["ولا صِلُّ أصْلالٍ يبيت مُراقباً","بنْهشَتِهِ مقدارَ نفس متى يُحَمْ",15,"م",1,0],["ولا صلاح لفرد او لاسرته","الا اذا ارتد عن عادته البشر",16,"ر",1,0],["وَلَاِصطُلِمَت جُرثومَةٌ تَغلِبِيَّةٌ","بِها اِستُبقِيَت أَغصانُها وَفُروعُها",17,"ع",3,0],["وَلأَصلُ يَسقي أَبَداً فَرعَهُ","وَتُثمِرُ الأَكمامُ مِن مائِهِ",18,"ا",3,0],["وَلا صَنَعَت فيها ظُباهُ مَآدِباً","فَأَصبَحَ مِن أَضيافِهِ الذِئبُ وَالنَسرُ",19,"ر",1,0],["وَلا صارِمٌ ماضي الغِرارِ بِكَفِّهِ","مَضارِبُهُ في الرَوعِ بِالدَمِ تَرعَفُ",20,"ف",1,0],["وَلا صَبَوتُ إِلى ذِكرِ الجَليسِ لَكُم","لِأَنَّ ذِكرَكُمُ في خاطِري وَفَمي",21,"ي",1,0],["وَلا صَبَرْنَا عَلَى الدُّنْيَا وَأَسْهُمُها","قَبْلَ الثِّيابِ تَشُقُّ القَلْبَ والكَبِدَا",22,"د",2,0],["وَلا صاحِبُ التَطوافِ يَعمُرُ مَنهَلاً","وَرَبعاً إِذا لَم يُخلِ رَبعاً وَمَنهَلا",23,"ل",2,0],["وَلَاِصطُفِيَت شَولٌ فَظَلَّت شَوارِداً","قُرومُ عِشارٍ ما لَهُنَّ مَبارِكُ",24,"ك",1,0],["وَلا صاحِبٌ إِلّا طَريرُ مُهَنَّدٍ","وَمُعتَدِلٌ لَدنُ المَهَزَّةِ رَسمَرُ",25,"ر",1,0],["وَلا صَبرَ لي عَنها وَلا لِيَ سَلوَةٌ","سِوى سَقَراتٍ في الحَشا وَمَدامِعُ",26,"ع",1,0],["وَلا صيدَ إِلّا بِوَثّابَةٍ","تَطيرُ عَلى أَربَعٍ كَالعَذَب",27,"ب",1,0],["ولا صارِفٌ راياتِهِ عن مُحارِبٍ","ولا مُمْسِكٌ معروفَهُ عن مُسالم",28,"م",1,0],["ولا صائحاً كالعَير في يوم لذةٍ","يناظرُ في تفضيل عثمان أو علي",29,"ل",2,0],["وَلا صاحِبٌ أَشكو إِلَيهِ فَأَشتَفي","إِذا ما شَكا رَأسي مَكانَ الوَسائِد",30,"د",1,0],["ولا صاحَ بالخيل اقدُمي في عَجاجةٍ","إذا قيل حِيدي في ضنْكِها أُمّي",31,"م",2,0],["وَلا صَرّفَ الخَطّيَّ مثْلَ يَمينِهِ","يَمينٌ وإنْ كانَتْ مُعاوَدَةَ النُّعْمِ",31,"م",1,0],["ولا صبر حتى يمسك القرط رجفة","بآذانها أو قلبي المتهيج",32,"ج",1,0],["ولا صراطا كما يذ","كرونه مستقيما",33,"م",2,0],["ولا صَحِبْتُ ذئابَ الإنسِ طاويةً","تُراقِبُ الجَدْيَ في الخضراء مَسبوتا",34,"ت",2,0],["ولا صدّت سرايانا عدوا","ولا هاجت حمّيتنا كفاحا",35,"ح",2,0],["وَلا صَاحِبٌ غَيْرُ الْحُسامِ مَنُوطَةٌ","حَمَائِلُهُ مِنِّي عَلَى عَاتِقٍ صَلْدِ",36,"د",1,0],["ولا صناديق سوى رزمةٍ","تدس في شر الصناديق",37,"ق",1,0],["ولا صَفَنتْ به خيل عِرَابٌ","ولا وخَدت به نوقٌ عشار",38,"ر",1,0],["ولا صاحب إلا سنان وصارم","وعزم بتيسير السبيل كفيل",39,"ل",1,0],["ولا صاحبٌ أشكو إليه فأشتفي","إذا ما شكى رأسي مكان الوسائد",40,"د",1,0],["ولأُصلينَّك جاحمَ الش","شِعر الذي هِجت التهابهْ",41,"ب",2,0],["ولأصحابه النجوم وأهل البي","ت ساداتنا عيون الآل",42,"ل",1,0],["ولأصلِينّكَ بالصدودِ وأحرق","نَّكَ بالجحودِ وأحرمَنْكَ خطابي",43,"ي",1,0],["ولا صِيدَ في شَرَكِ النائباتِ","فتىً لشروطِ القتَى جامعُ",44,"ع",1,0],["ولا صدرت قصدا ولا اتصفوا بها","ولا طرقت إلا طروق المصيبة",45,"ه",1,0],["وَلَأَصبَحَت يأَجوجُ مَع مَأجوجِها","وَكَأَنَّ غابِرَها رَمادٌ أَرمَدُ",46,"د",1,0],["ولا صارفا عني حبال الهوى ولا","تصاممت عما يقطعن وصل وصلتي",47,"ت",2,0],["ولا صحبتْ كفّي على دلجِ السُرى","أبرَّ وأوفى منْ رقيق المضاربِ",48,"ب",1,0],["ولا صبّ ختور العهد يمشى","على جنباته مشى الحباب",49,"ب",1,0],["ولا صهباء يحسوها بنوه","وقد قبست من الذهب المذاب",49,"ب",1,0],["ولا صبا في الصبح نحو الصبا","ولا ثارت شجوه الأينق",50,"ق",1,0],["ولا صاحبٌ إلا المطيةُ حولَها","ذئابٌ تبارى في الفلاةِ وأضبع",51,"ع",1,0],["ولا صحبتني من أياديه أنعم","تقوم مقام الخصب في البلد المحل",52,"ل",1,0],["ولا صهيلاً زئيرُ الأُسدِ جاوبَه","ولا هجيراً يُذيبُ الصخرَ إلهابا",53,"ب",2,0],["وَلا صَدَّ عَن بابِ الإِشارَةِ قاسِط","مُفِيض الثنا فِي الأَرضِ كالعارِض الحدِّ",54,"د",1,0],["ولا صفا قلب به تبدل","ولا تقدس من يقل بثاني",55,"ي",1,0],["ولا صدى الحر في كفّه","وذاق الدخيل نعيم الصفاء",56,"ا",2,0],["وَلا صارَ وَقَد كانَ","لَبيباً تابَعَ الجَهلَ",57,"ل",1,0],["وَلا صامِتاً إِلّا وَقَد راحَ ناطِقاً","وَفي صَمتِهِ آياتِ إِحسانِكُم يَتلو",58,"ل",2,0],["وَلا صارَ ذاكَ البَهوُ مُلكاً مُحَجَّباً","وَلا جَرَّ ذاكَ الرَعبُ جَيشاً عَرَمرَما",59,"م",2,0],["ولا صَدَرت عنها العُفاةُ فلم تُعد","حقائبَها مملوءةً وصدورُها",60,"ر",3,0],["ولا صديق إذا جار الزمان وفا","لو كان صحبك مثل الرمل في عدد",61,"د",1,0],["ولا صاحبٌ إلا تنسمُ نفحةٍ","هزَزْتَ لها عِطْفي كأنيَ نشوانُ",62,"ن",1,0],["ولأصبِرَنّ على تغيّرِ حالِه","صبرَ الكرامِ وإن تزايَدَ عَنتُه",63,"ت",2,0],["ولأَصْرِمَنَّ علائِقَ الأَمَلِ الَّذِي","يقتادُني لِسِواكَ أَيَّ صِرامِ",64,"م",1,0],["ولا صِدْقَ إِلّا للرَّجاءِ الَّذِي سَرى","فقَصَّرَ طُولَ اللَّيْلِ واسْتَقْرَبَ النَّأْيا",65,"ي",2,0],["ولا صوم ولا عرفوا بملك ال","يمين وما دروا حكم العتيق",66,"ق",1,0],["ولا صديقَ غيرُ ذي صنائع","أحسنُ ما يُحسِنُ أن يخونا",67,"ن",2,0],["ولا صرَّ أعوادُ السرير به ولا","تغضَّن تحت التاج منه جبينُ",68,"ن",1,0],["ولا صَبَا أرضِكم هبَّت تروّحني","وفاءَ وعدٍ لكم بالمطلِ مكدودِ",69,"د",1,0],["ولا صدحت فوق الغصون بلابل","ولكنها للعاشقين بلابل",70,"ل",1,0],["ولا صبحُ تلك الأرض إلاّ وجوهها","ولا ليل ذاك الجوّ إلاّ قتامها",71,"م",3,0],["ولأصبحتْ لمحيّة","عطفت عليها كفُّ ماح",72,"ح",1,0],["ولا صَرَخنا كَما المَطعونُ يَصرخُ مِن","أعماق ِطَعنَتِهِ كِبْرا ً وَنُكرانا",73,"ن",2,0],["ولا صنوف العالمين خضعت","تروم من آلائهم مناصبا",74,"ب",2,0],["ولأصْحابٍ وآلٍ","دَأبُهُمْ نَشْرُ الفَضائلْ",75,"ل",1,0],["ولا صَديقٌ على هَمِّي يُساعدُني","ولا حَبيبي لهُ في حالَتي نَظَرُ",76,"ر",1,0],["ولا صافَح الخطّيُّ منّي يَدَ النّدى","ولا عانَقَتْ جِيدَ المَعالي حَمائِلي",77,"ل",2,0],["ولا صحَتْ من سُلافِ الدَّلِّ أعيُنُهم","ولا سَرى في سِواها منهُمُ الكَسَلُ",78,"ل",1,0],["ولا صحّ مُعتلُّ النّسيمِ ولا صحَتْ","بعصرِكَ فيها أعيُنُ الخرّدِ السّكْرى",79,"ر",2,0],["ولا صبر لي إلا التحرق والبكا","وتصعيد أنفاس من الزفرات",80,"ت",1,0],["ولا صَيّرتْ قلبي من النّاسِ كلّهمْ","لَها وَطَناً تأوي إليه الحقائقُ",81,"ق",1,0],["ولا صددتُ بوجهِي","عمّنْ جنى لِيَ صدّا",82,"د",2,0],["وَلا صاحبٌ لي إنْ كشفتُ ضميرَه","ودِدْتُ وِداداً أنّنِي لا أُصاحبُهْ",83,"ب",2,0],["ولا صفة إلا ومني تعينت","لموصوفها إذ كنت أصل 