oem.aspx?id=179291",""],[100,"خير ما في القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=50388",""],[45,"هَلْ فيكُمُ مِنْ وَاقِفٍ مُتَفَرِّسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31149",""],[94,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[94,"اتسألين عن الخمسين ؟","https://www.poetsgate.com/ViewPoem.aspx?id=15626",""],[94,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[142,"هل في جنوب اللوى وجد فأطربه","https://www.aldiwan.net/poem58378.html","البسيط"],[143,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[155,"قل لمريض الحدق","https://www.aldiwan.net/poem55592.html","مجزوء الرجز"],[160,"عاملت ربك وانتدبت خصالا","https://www.aldiwan.net/poem58816.html","الكامل"],[160,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[225,"لم يدر أن ملامه أغراكا","https://www.aldiwan.net/poem55231.html","الطويل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[262,"هل في البلاد لرزق الله مفترش","https://www.aldiwan.net/poem68202.html","الكامل"],[271,"جوامع الخير في الدارين تابعة","https://www.aldiwan.net/poem52128.html","البسيط"],[282,"لو لم أخف أمر عواديكم","https://www.aldiwan.net/poem32478.html","السريع"],[285,"ظهرت محاسن ذا الزمان فقابلت","https://www.aldiwan.net/poem39432.html","الكامل"],[298,"هل في البكاء على ما فات من حرج","https://www.aldiwan.net/poem36286.html","عموديه"],[298,"اعكف على جدث في عدوة الوادي","https://www.aldiwan.net/poem36820.html","عموديه"],[300,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[361,"هي الليالي فلا تغتر بالامل","https://www.aldiwan.net/poem68072.html","البسيط"],[361,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[364,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[364,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[364,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[371,"أما الحديث بما صنعت فقد بدا","https://www.aldiwan.net/poem57485.html","الكامل"],[380,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[403,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[403,"يا أيها البدر الذي بعلومه","https://www.aldiwan.net/poem33472.html","الكامل"],[403,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[403,"هو الهوى فاصطبر فيه لما يجب","https://www.aldiwan.net/poem34153.html","البسيط"],[409,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[409,"أبني السرى والبيد لا","https://www.aldiwan.net/poem32254.html","مجزوء الكامل"],[409,"بالله يا مغرى بهجراني","https://www.aldiwan.net/poem32526.html","السريع"],[409,"يا من مودته سحاب زائل","https://www.aldiwan.net/poem32578.html","الكامل"],[416,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[429,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[432,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[449,"تتجاهلين","https://www.aldiwan.net/poem1012.html",""],[458,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[458,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[461,"ضاقت بلاغة أشعاري بما رحبت","https://www.aldiwan.net/poem15395.html","البسيط"],[477,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[479,"صادت فؤادي غادة","https://www.aldiwan.net/poem37017.html","مجزوء الكامل"],[499,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[551,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[551,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[551,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"]],"verses":[["هَل في أُهَيلِكَ غَيري مَن تُزانُ بِهِ","أَم هَل لَهُم حين يُعزى مِن أَبٍ كَأَبي",0,"ي",1,0],["هَل فَهِمتُم أَسرارَ ما كانَ عِندي","مِن عُلومٍ مَخبوءَةٍ طَيَّ بَردي",1,"ي",1,0],["هَلْ فِي عِلاقَةِ مِصْرَ بِالسُّودَانِ","مَا لا يَوَدُّ دَوَامَهُ القُطْرَانِ",2,"ن",1,1],["هَلْ فِي أَزَاهِرِهَا وَفِي رَايَاتِهَا","إِلاَّ بَدِيعٌ لِلنُّهَى وَمَعَانِ",2,"ن",1,0],["هَلْ فِي المَوَاسِمِ مِثْلُ مَا تَجِدُونَهُ","فِي النَّفْسِ مِنْ بَهَجَاتِ هَذَا المَوْسِمِ",3,"م",1,0],["هَلْ فِي جَزَائِرِ كُمْ أَمْ فِي مَدَائِنِكُمْ","مَا لَمْ تَطَأْهُ له مِنْ سَالِفٍ قَدَمُ",4,"م",1,0],["هَلْ فِي الجُيُوشِ كَمَا فِيهِمْ مُبَاسَطَةٌ","مَعَ المكَارِهِ إِمَّا لَزَّتْ الأُزُمُ",4,"م",1,0],["هَلْ فِي العُلَى مُتَبَوَّأً لَكَ بَعْدَ أَنْ","بُوِّئْتَ عَنْ إِرْثٍ أَعَزَّ سَنَامِ",5,"م",1,0],["هَلْ فِي أَسَى الدُّنْيَا شُكُولِهَا","مَا كُنْتَ تُؤْثِرُ لَوْ بَقَيْتَ مُقِيمَا",6,"م",2,0],["هَلْ فِي الشَّبَابِ كَذَلِكَ","السَّبَّاقِ فِي أَجْدَى مَجَال",7,"ل",1,0],["هَل في مِئينَ وَفي مِئينَ سَبَقتُها","مَدَّ الأَعِنَّةِ غايَةٌ وَحِضارُ",8,"ر",1,0],["هَل في الغَواني لِمَن قَتَّلنَ مِن قَودٍ","أَو مِن دِياتٍ لِقَتلِ الأَعيُنِ الحورِ",9,"ر",1,0],["هل في غراب البين مُستمتَعٌ","حيّاً ولم يُقتل ولم يُصلبِ",10,"ب",1,0],["هل في الشريعة نصبُ صيدٍ حاصلٍ","للنَّبل ترشُقُه يدٌ بِصيابِها",11,"ب",3,0],["هل فيكما نصرة مؤزرةٌ","لزاهق النفس أو كزاهقها",12,"ق",3,0],["هل فُزْتَ في الدولة المباركة ال","غرّاءِ إلا بحظِ من سلما",13,"م",2,0],["هَل في حسابك ما تُؤَمِّلُهُ","أَم قَد تَصَرَّمَ عِندَك الأمدُ",14,"د",1,0],["هل في الحوادث شك أم بإمرتها","ريب ونحن لأحكام وأقدار",15,"ر",1,0],["هل في دم الفلاح سر الكيميا","أم هل يدين لكل باغٍ عاتي",16,"ت",2,0],["هَل في يَدَيَّ سِوى قَريضٍ خالِدٍ","أُزجيهِ بَينَ يَدَيكَ لِلإِتحافِ",17,"ف",1,0],["هَل فيكُمُ مِن واقِفٍ مُتَفَرِّسِ","يُعدي عَلى نَظَرِ الظِباءِ الأُنَّسِ",18,"س",1,1],["هَل في مَسامِعِكُم عَن دَعوَتي صَمَمٌ","أَم في نَواظِرِكُم عَن خِلَّتي وَسَنُ",19,"ن",1,0],["هَل في تَذَكُّرِ أَيّامِ الصِبا فَنَدُ","أَم هَل لِما فاتَ مِن أَيّامِهِ رِدَدُ",20,"د",1,1],["هَل فيكُمُ مِن مُخبِرٍ حَيثُ اِستَقَر","رَ قَرارُ أَرواحِ العِظامِ البالِياتِ",21,"ت",1,0],["هَل فيهِما لَكَ عِبرَةٌ","أَم خِلتَ أَنَّ لَكَ انفِلاتا",22,"ت",2,0],["هَل فيكُمُ أَو مِنكُمُ","مِن مُستَجارٍ أَو مُجيرِ",23,"ر",1,0],["هَل في يَدَيكَ عَلى الحَوادِثِ قُوَّةٌ","أَم هَل عَلَيكَ مِنَ المَنونِ خَفيرُ",24,"ر",1,0],["هل في العصيب المدلهم","مصغٍ لشاكٍ لم ينم",25,"م",1,1],["هَل في هَوى رَجُلٍ جُناحٌ زائِرٍ","جَهراً أَحَبَّ خَريدَةً مِعطارا",26,"ر",2,0],["هل في المشارقِ مَن يُردِّدُ صَيْحتي","أم في الكنانةِ من يُجيبُ دُعائي",27,"ا",2,0],["هل في كتابِكَ أن يَنالَ حُقوقَهُ","شَعبٌ يَرَى طَلَبَ الحُقوقِ فُضولا",28,"ل",2,0],["هَل في جُفونِكُما دَمعٌ لِمُمتاحِ","لَم يَبقَ مِن دَمعِهِ رِيٌّ لِمُلتاحِ",29,"ح",1,1],["هَل في فَلسطين بَعدَ البُؤس مِن دعةٍ","أَم لِلزَمان اِبتِسام بَعدَ تَقطيبِ",30,"ب",1,0],["هَل في ادِّكارِ الحَبيب مِن حَرَجِ","أَم هَل لِهَمِّ الفُؤادِ مِن فَرَجِ",31,"ج",1,1],["هَل في فُؤادي لِلهَوى","أَو جَسَدي شَيءٌ بَقي",32,"ي",1,0],["هَل فارِسٌ وَالرومُ وَالتُركُ أَو","رَبيعَةٌ أَو مُضَرٌّ أَو سَبَأ",33,"ب",2,0],["هَل فازَ بِالجَنَّةِ عُمّالُها","وَهَل ثَوى في النارِ نوبَختُ",34,"ت",1,0],["هَل في مَقالي الحقَّ في عهد به","قد أُعلن الدستور من محظور",35,"ر",1,0],["هَلْ في الْخَلاعَةِ وَالصِّبَا مِنْ بَاسِ","بَيْنَ الْخَلِيجِ وَرَوضَةِ الْمِقْيَاسِ",36,"س",1,1],["هَلْ فِي التّصَابِي عَلَى امْرِئٍ فَنَدُ","أَمْ هَلْ يَعِيبُ الْفَتَى الْكَرِيمَ دَدُ",37,"د",1,1],["هَلْ فِي الزَّمَانِ لَنَا حُكْمٌ فَنَشْتَرِطُ","أَمْ تِلْكَ أُمْنِيَةٌ فِي طَيِّهَا قَنَطُ",38,"ط",1,1],["هَلْ فِي المَسَرَّاتِ مَا يَرْضى الضَّمِيرُ بِهِ","مِثْلَ المَبَرَّاتِ للمَحْرُوبِ وَالبَاكِي",39,"ك",2,0],["هَل فِي الْغَوَانِي مِثْلُ هَذَا","الحُسْنِ والطَّبْعِ الأَنِيسْ",40,"س",1,0],["هلْ فِي الجَدِيدِ كَقَوْلِهِ ال","مأْثُورِ وَالمَعْنَى جَلِيبُ",41,"ب",1,0],["هَلْ فِي لِدَاتٍ أَبِي عَلِيٍّ نِدُّهُ","إِنْ يَصْدُرَا عَنْ هِمَّةٍ وَمَضَاءِ",42,"ا",2,0],["هَلْ فِي السَّمَاعِ لِبَث آلامِ الْجَوَى","كَنُوَاحِهِ وَكَشَدْوِهِ بِغِنَاءِ",42,"ا",2,0],["هَلْ فِي تَوَخِّي غَايَةٍ بَعْدَهُ","مِنْ مُرْتَقىً يَبْلُغُهُ المُرْتَقِي",43,"ق",2,0],["هَلْ فَرْحَةٌ فِي العُمْرِ أَشْهَى","مِن لِقَاءِ الأَوْفِياءْ",44,"ا",2,0],["هَلْ فِي يَدِ الدِّهْقَانِ أَبْهَجُ زِينَةً","مِنْ زِينَةِ البُسْتَانِ لِلْعَذْرَاءِ",45,"ا",2,0],["هَلْ فِي المَدَائح مَا يُوَفِّي حَقَّهُ","أَوْ مَا يُكَافيءُ صَحْبَهُ الأَبْرَارَا",46,"ر",2,0],["هَلْ فِي الرِّثَاءِ لِقَائِلِيهِ جَدِيدُ","وَالْمَوْتُ يُلْقِي الدَّرْسَ ثُمَّ يُعِيدُ",47,"د",1,1],["هلْ في الأَقاليمِ الَّتِي وُصِفَتْ","كَهَوَائِهَا برْءاً لأَجْسَادِ",48,"د",1,0],["هل فَكَّرا في الأُمِّ تندُب حَظَّها","والزَّوْجِ تُسْكِتُ وَالهِينَ يَتَامَى",49,"م",2,0],["هل في العيون التونسية شاطيء","ترتاح فوق رماله الأعصاب",50,"ب",1,0],["هل فيك شبرٌ لم يخضَّ","بْهُ دَمٌ جُرح ثائر؟",51,"ر",1,0],["هل في الربى يا شمسُ غيرُ الربى","هل للكُوَى معنىً خَبِيءُ الجيوب",52,"ب",1,0],["هَلْ فيكُمُ مِنْ وَاقِفٍ مُتَفَرِّسِ،","بَعدي على نَظَرِ الظّبَاءِ الأُنَّسِ",53,"س",1,1],["هلْ في الشآمِ وهلْ في القُدسِ والدةٌ","لا تشتكي الثُكل إعْوالاً وإرنانا",54,"ن",2,0],["هل في زواياه من راح الصبا عبق","كلّ الرحيق المندّى في زواياه",55,"ا",2,0],["هل في ثراك على المعرّة موضع","بين العيون لدمعي السحّاح",56,"ح",1,0],["هل في جُنوبِ اللِّوى وجدٌ فأطرَبهُ","بأنَّةٍ أرسلَتْها حَنَّةُ العِيرِ",57,"ر",1,1],["هَل فَوقَ مَجدِكَ غايَةٌ لِطِلابِ","أَم عَن ذَراكَ مُعَرَّجٌ لِرِكابِ",58,"ب",1,1],["هَلْ في فُؤادِي لِلضَّنى","أَوْ جَسَدِي شَيءٌ بَقِي",59,"ي",1,0],["هل فيهم لولا سعادة ماجدٍ","أحد يداني تلكم الأهوالا",60,"ل",2,0],["هل في القياس بأن الحرب موجبه","إرشاد من ضل أو وتأليف من نفرا",61,"ر",2,0],["هَل في السماءِ فَضيلَةٌ لم تَحوِها","تَبغى لأَجل منالِها الأَفلاكا",62,"ك",2,0],["هَل في السَّوابِقِ كَاللّزارِ وَسَكبه","وَلِخيفهِ وَالورد خَير حِصانِ",63,"ن",1,0],["هَل في السُّيوفِ كَذي الفِقارِ وَمخذَمٍ","وَالحَتفُ حَتفُ كَتائِبِ الشَيطانِ",63,"ن",1,0],["هَل في البِلادِ لِرِزقِ اللهِ مُفتَرَشٌ","أم لا فَفِي جِلدِهِ مِن خُشنَةٍ بَرَشُ",64,"ش",1,1],["هَل في كتاب مَضى أَوسنة سلفت","عز لعبد عَلى عصيانه لاهى",65,"ه",2,0],["هَل في سَماحِ الدَهرِ لي أَنَّني","فيهِ أُناديكُم بِناديكُمُ",66,"م",1,0],["هل في الدنا ملك يقاس بملكه","هيهات الا ان يؤسس من جديد",67,"د",1,0],["هَلْ في البكاءِ عَلَى ما فاتَ منْ حرَجِ","فذكرُه هَاجَ وَجْداً كان مدفوعا",68,"ع",2,1],["هل في سبيلٍ إلى الإنصافِ من زمنٍ","جَلَّتْ رزاياه عن حصرٍ وَتعداد",69,"د",1,0],["هَل في الثَماني مِنَ التِسعينَ مَظلمَةٌ","وَرَبُّها لِكِتابِ اللَهِ مُستَطِرُ",70,"ر",1,0],["هَل في زَمانِكَ أَو من قبلَه سَمعت","أُذُناكَ ان اينَ أُنثى غير مُنتَقِل",71,"ل",1,0],["هَل في فُؤادي غَير حُبِّكَ ساكِن","أَو غَير طَيفِكَ في الكَرى طَرّاق",72,"ق",1,0],["هل في معاهدِ أصفهانَ وحُسنها","مُتعلَّلٌ لنزيعِ خُوزِسْتان",73,"ن",1,0],["هل في الفضيلةِ أن أَعيشَ كذا","شِلْواً بكفِّ الدّهرِ أُعترَق",74,"ق",1,0],["هل في عتابِ الحادثاتِ غَناءُ","أم هل لعيشٍ في الزمانِ صفاءُ",75,"ا",2,1],["هل في النهايةِ غير ما أبصَرتَني","فيه وكيف يكونُ من بلغَ المَدى",76,"د",2,0],["هَل في شَريعتَك الغَرّاء يا حكمي","إِن لا أَزال جَليس الهَم مُنفَرِدا",77,"د",2,0],["هل في القلوب بيوم الحشر إذعان","وهل بما قاله الرحمن إيمان",78,"ن",1,1],["هل في العموم كلام ربي داخل","أم فيه قول إلهنا لم يدخل",79,"ل",1,0],["هل في الرفاق متيم مثلي","أملي عليه ومنه أستملي",80,"ي",1,1],["هل في خيامكم من مهجتي خبر","فإنها بعدكم في الأرض تضطرب",81,"ب",1,0],["هل في القضيّة يا من فضلُ دولتِه","وعدلُ سِيرتِه بين الورَى عَلَمُ",82,"م",1,0],["هل فيهِمُ رجلٌ يُغني غَنَاي إذَا","جَلاَ الحوادثَ حدُّ السّيفِ والقَلَمُ",82,"م",1,0],["هل فيكُمُ مِنْ مُبلِغٍ","عنّي السّلاَمَ أبَا سلامَهْ",83,"م",2,0],["هَلْ في القضَايا أَنَ مَن مَا جَنَى","يَخضعُ بالعُذرِ إِلى الجَاني",84,"ي",1,0],["هَل في القَضّيةِ أنَّ حُبّك زائِدٌ","أبداً وحَظّي كلَّ يومٍ نَاقصُ",85,"ص",1,0],["هل في العراق ومن عليه ومن له","منها وليس لأَلْفِهِمْ معشارها",86,"ر",3,0],["هل في ربي تلك الطلول مقيمة","كعهدي على الأفنان ورق صوادح",87,"ح",1,0],["هَلْ في قِطارِ النَّصْرِ نسرٌ واقعٌ","أَو في مَسَالِحَهَ سِماكٌ أَعْزَلُ",88,"ل",1,1],["هل فيك للدنف الجريح فؤاده","عطف يخفف من عناء الشاعر",89,"ر",1,0],["هل في البروقِ على الكثيبِ دلالةٌ","إن أعوزتك دلالةُ النيرانِ",90,"ن",1,0],["هل في الشموسِ التي تُحدَى بها العِيرُ","قلب إلى غير هذا الدينِ مفطورُ",91,"ر",1,1],["هل في القضيّةِ عندكم من نَهْلةٍ","تَرْوَى بها هذي القلوبُ اللُّوحُ",92,"ح",1,0],["هل فيهم مَنْ ملوكُ الأرض لاثمةٌ","بساطهُ من حديث القوم واليفَنِ",93,"ن",1,0],["هل في المنازلِ بعدَ القومِ آثارُ","نعمْ معالمُ لا تُغني وأحجارُ",94,"ر",1,1],["هل في الوصال طريقة","للمستهام العاشق",95,"ق",1,0],["هَلْ فِي السَّمَاءِ لِصَاعِدٍ مِنْ مُرْتَقًى","سِيَّانِ فِيْهِ مَنْ تَصَعْلَكَ واقْتَنَى",96,"ا",1,0],["هل في الزّيارةِ للنّسيمِ أذِنتُمُ","فلقد أشمُّ المِسكَ منه ينفَحُ",97,"ح",1,0],["هل فيه للظّنِّ الجميلِ معرَّسٌ","أو للقوافي السائِراتِ معرَّجُ",98,"ج",1,0],["هل في الهوى من غريمٍ لا يماطلني","أوْ من خليلٍ عليه لا يُعنّفني",99,"ن",2,0],["هَل فيكمُ إلّا أَخو سَوْءَةٍ","مُجَرَّحُ الجِلْدِ من اللُّوَّمِ",100,"م",1,0],["هَل فيكُمُ مِن دافعٍ لحِمامِهِ","في هابطٍ من أرضِهِ أوجاسِ",101,"س",1,0]]}