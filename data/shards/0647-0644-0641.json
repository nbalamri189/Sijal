w.poetsgate.com/ViewPoem.aspx?id=35880",""],[4929,"العام الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=199258",""],[5005,"على عتبة العمر..","https://www.poetsgate.com/ViewPoem.aspx?id=202133",""],[5005,"ملاحم الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=208156",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[585,"هل في العراق من الرفاق مواس","https://www.poetsgate.com/ViewPoem.aspx?id=161918",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5149,"يَا أَيُّهَا المُزْجِي حَنينَ غَرَامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=211188",""],[5150,"أي قلب تملكين ...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203781",""],[5185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[223,"البكاء خلف أسوار الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=190683",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[475,"هلْ في اكارِ الحبيبِ منْ حرجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20515",""],[709,"حتّامَ أسألها الذّنوَّ فتنزَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=2908",""],[5460,"أجمعت ظالمة على تركي","https://www.poetsgate.com/ViewPoem.aspx?id=200739",""],[5628,"يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=178452",""],[5628,"ابتهالات في محراب الورد","https://www.poetsgate.com/ViewPoem.aspx?id=178665",""],[5660,"يا قُنبُلُةَ الهَجرِ انفَجِري","https://www.poetsgate.com/ViewPoem.aspx?id=37065",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[402,"هل في علاقة مصر بالسودان","https://www.poetsgate.com/ViewPoem.aspx?id=36530",""],[402,"أمعيد الاستقلال مكتملا إلى","https://www.poetsgate.com/ViewPoem.aspx?id=35538",""],[402,"اليوم عيد البائس المتألم","https://www.poetsgate.com/ViewPoem.aspx?id=36427",""],[402,"أتحين في هذي النضارة والصبا","https://www.poetsgate.com/ViewPoem.aspx?id=36197",""],[402,"لبيكم يا رفقة النادي","https://www.poetsgate.com/ViewPoem.aspx?id=35474",""],[402,"قبس بدا من جانب الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=35058",""],[402,"لتاج تاج مملكين عظام","https://www.poetsgate.com/ViewPoem.aspx?id=36335",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"خبر يندى له الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=156844",""],[5829,"بالعشقِ أغراني","https://www.poetsgate.com/ViewPoem.aspx?id=214655",""],[5897,"زارنا الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=160573",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5943,"كلَّما وجَّهتُ وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=11287",""],[5956,"عينان","https://www.poetsgate.com/ViewPoem.aspx?id=182265",""],[5956,"خذني لعَطفك","https://www.poetsgate.com/ViewPoem.aspx?id=193808",""],[5989,"يا نجمةً ومضت","https://www.poetsgate.com/ViewPoem.aspx?id=181494",""],[6004,"واستباح العُرى","https://www.poetsgate.com/ViewPoem.aspx?id=33753",""],[6090,"بدت لنا بمحيا أخجل البدرا","https://www.poetsgate.com/ViewPoem.aspx?id=170914",""],[6124,"سينية العشق","https://www.poetsgate.com/ViewPoem.aspx?id=128751",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6152,"ليس في الشوق من عار","https://www.poetsgate.com/ViewPoem.aspx?id=203705",""],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""],[6238,"فجر الخليل...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86776&r=&rc=5",""],[2914,"يا دارَ أسماءَ، بالعلياءِ من إضمٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24243&r=&rc=9",""],[6341,"من أي السماء؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87278&r=&rc=7",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["هَل في أُهَيلِكَ غَيري مَن تُزانُ بِهِ","أَم هَل لَهُم حين يُعزى مِن أَبٍ كَأَبي",0,"ب",2,0],["هَل فَهِمتُم أَسرارَ ما كانَ عِندي","مِن عُلومٍ مَخبوءَةٍ طَيَّ بَردي",1,"د",2,0],["هَلْ فِي عِلاقَةِ مِصْرَ بِالسُّودَانِ","مَا لا يَوَدُّ دَوَامَهُ القُطْرَانِ",2,"ن",1,1],["هَلْ فِي أَزَاهِرِهَا وَفِي رَايَاتِهَا","إِلاَّ بَدِيعٌ لِلنُّهَى وَمَعَانِ",2,"ن",1,0],["هَلْ فِي المَوَاسِمِ مِثْلُ مَا تَجِدُونَهُ","فِي النَّفْسِ مِنْ بَهَجَاتِ هَذَا المَوْسِمِ",3,"م",1,0],["هَلْ فِي جَزَائِرِ كُمْ أَمْ فِي مَدَائِنِكُمْ","مَا لَمْ تَطَأْهُ له مِنْ سَالِفٍ قَدَمُ",4,"م",1,0],["هَلْ فِي الجُيُوشِ كَمَا فِيهِمْ مُبَاسَطَةٌ","مَعَ المكَارِهِ إِمَّا لَزَّتْ الأُزُمُ",4,"م",1,0],["هَلْ فِي العُلَى مُتَبَوَّأً لَكَ بَعْدَ أَنْ","بُوِّئْتَ عَنْ إِرْثٍ أَعَزَّ سَنَامِ",5,"م",1,0],["هَلْ فِي أَسَى الدُّنْيَا شُكُولِهَا","مَا كُنْتَ تُؤْثِرُ لَوْ بَقَيْتَ مُقِيمَا",6,"م",2,0],["هَلْ فِي الشَّبَابِ كَذَلِكَ","السَّبَّاقِ فِي أَجْدَى مَجَال",7,"ل",1,0],["هَل في مِئينَ وَفي مِئينَ سَبَقتُها","مَدَّ الأَعِنَّةِ غايَةٌ وَحِضارُ",8,"ر",1,0],["هَل في الغَواني لِمَن قَتَّلنَ مِن قَودٍ","أَو مِن دِياتٍ لِقَتلِ الأَعيُنِ الحورِ",9,"ر",1,0],["هل في غراب البين مُستمتَعٌ","حيّاً ولم يُقتل ولم يُصلبِ",10,"ب",1,0],["هل في الشريعة نصبُ صيدٍ حاصلٍ","للنَّبل ترشُقُه يدٌ بِصيابِها",11,"ب",3,0],["هل فيكما نصرة مؤزرةٌ","لزاهق النفس أو كزاهقها",12,"ق",3,0],["هل فُزْتَ في الدولة المباركة ال","غرّاءِ إلا بحظِ من سلما",13,"م",2,0],["هَل في حسابك ما تُؤَمِّلُهُ","أَم قَد تَصَرَّمَ عِندَك الأمدُ",14,"د",1,0],["هل في الحوادث شك أم بإمرتها","ريب ونحن لأحكام وأقدار",15,"ر",1,0],["هل في دم الفلاح سر الكيميا","أم هل يدين لكل باغٍ عاتي",16,"ت",2,0],["هَل في يَدَيَّ سِوى قَريضٍ خالِدٍ","أُزجيهِ بَينَ يَدَيكَ لِلإِتحافِ",17,"ف",1,0],["هَل فيكُمُ مِن واقِفٍ مُتَفَرِّسِ","يُعدي عَلى نَظَرِ الظِباءِ الأُنَّسِ",18,"س",1,1],["هَل في مَسامِعِكُم عَن دَعوَتي صَمَمٌ","أَم في نَواظِرِكُم عَن خِلَّتي وَسَنُ",19,"ن",1,0],["هَل في تَذَكُّرِ أَيّامِ الصِبا فَنَدُ","أَم هَل لِما فاتَ مِن أَيّامِهِ رِدَدُ",20,"د",1,1],["هَل فيكُمُ مِن مُخبِرٍ حَيثُ اِستَقَر","رَ قَرارُ أَرواحِ العِظامِ البالِياتِ",21,"ت",1,0],["هَل فيهِما لَكَ عِبرَةٌ","أَم خِلتَ أَنَّ لَكَ انفِلاتا",22,"ت",2,0],["هَل فيكُمُ أَو مِنكُمُ","مِن مُستَجارٍ أَو مُجيرِ",23,"ر",1,0],["هَل في يَدَيكَ عَلى الحَوادِثِ قُوَّةٌ","أَم هَل عَلَيكَ مِنَ المَنونِ خَفيرُ",24,"ر",1,0],["هل في العصيب المدلهم","مصغٍ لشاكٍ لم ينم",25,"م",1,1],["هَل في هَوى رَجُلٍ جُناحٌ زائِرٍ","جَهراً أَحَبَّ خَريدَةً مِعطارا",26,"ر",2,0],["هل في المشارقِ مَن يُردِّدُ صَيْحتي","أم في الكنانةِ من يُجيبُ دُعائي",27,"ا",2,0],["هل في كتابِكَ أن يَنالَ حُقوقَهُ","شَعبٌ يَرَى طَلَبَ الحُقوقِ فُضولا",28,"ل",2,0],["هَل في جُفونِكُما دَمعٌ لِمُمتاحِ","لَم يَبقَ مِن دَمعِهِ رِيٌّ لِمُلتاحِ",29,"ح",1,1],["هَل في فَلسطين بَعدَ البُؤس مِن دعةٍ","أَم لِلزَمان اِبتِسام بَعدَ تَقطيبِ",30,"ب",1,0],["هَل في ادِّكارِ الحَبيب مِن حَرَجِ","أَم هَل لِهَمِّ الفُؤادِ مِن فَرَجِ",31,"ج",1,1],["هَل في فُؤادي لِلهَوى","أَو جَسَدي شَيءٌ بَقي",32,"ق",2,0],["هَل فارِسٌ وَالرومُ وَالتُركُ أَو","رَبيعَةٌ أَو مُضَرٌّ أَو سَبَأ",33,"ب",2,0],["هَل فازَ بِالجَنَّةِ عُمّالُها","وَهَل ثَوى في النارِ نوبَختُ",34,"ت",1,0],["هَل في مَقالي الحقَّ في عهد به","قد أُعلن الدستور من محظور",35,"ر",1,0],["هَلْ في الْخَلاعَةِ وَالصِّبَا مِنْ بَاسِ","بَيْنَ الْخَلِيجِ وَرَوضَةِ الْمِقْيَاسِ",36,"س",1,1],["هَلْ فِي التّصَابِي عَلَى امْرِئٍ فَنَدُ","أَمْ هَلْ يَعِيبُ الْفَتَى الْكَرِيمَ دَدُ",37,"د",1,1],["هَلْ فِي الزَّمَانِ لَنَا حُكْمٌ فَنَشْتَرِطُ","أَمْ تِلْكَ أُمْنِيَةٌ فِي طَيِّهَا قَنَطُ",38,"ط",1,1],["هَلْ فِي المَسَرَّاتِ مَا يَرْضى الضَّمِيرُ بِهِ","مِثْلَ المَبَرَّاتِ للمَحْرُوبِ وَالبَاكِي",39,"ك",2,0],["هَل فِي الْغَوَانِي مِثْلُ هَذَا","الحُسْنِ والطَّبْعِ الأَنِيسْ",40,"س",1,0],["هلْ فِي الجَدِيدِ كَقَوْلِهِ ال","مأْثُورِ وَالمَعْنَى جَلِيبُ",41,"ب",1,0],["هَلْ فِي لِدَاتٍ أَبِي عَلِيٍّ نِدُّهُ","إِنْ يَصْدُرَا عَنْ هِمَّةٍ وَمَضَاءِ",42,"ا",2,0],["هَلْ فِي السَّمَاعِ لِبَث آلامِ الْجَوَى","كَنُوَاحِهِ وَكَشَدْوِهِ بِغِنَاءِ",42,"ا",2,0],["هَلْ فِي تَوَخِّي غَايَةٍ بَعْدَهُ","مِنْ مُرْتَقىً يَبْلُغُهُ المُرْتَقِي",43,"ق",2,0],["هَلْ فَرْحَةٌ فِي العُمْرِ أَشْهَى","مِن لِقَاءِ الأَوْفِياءْ",44,"ا",2,0],["هَلْ فِي يَدِ الدِّهْقَانِ أَبْهَجُ زِينَةً","مِنْ زِينَةِ البُسْتَانِ لِلْعَذْرَاءِ",45,"ا",2,0],["هَلْ فِي المَدَائح مَا يُوَفِّي حَقَّهُ","أَوْ مَا يُكَافيءُ صَحْبَهُ الأَبْرَارَا",46,"ر",2,0],["هَلْ فِي الرِّثَاءِ لِقَائِلِيهِ جَدِيدُ","وَالْمَوْتُ يُلْقِي الدَّرْسَ ثُمَّ يُعِيدُ",47,"د",1,1],["هلْ في الأَقاليمِ الَّتِي وُصِفَتْ","كَهَوَائِهَا برْءاً لأَجْسَادِ",48,"د",1,0],["هل فَكَّرا في الأُمِّ تندُب حَظَّها","والزَّوْجِ تُسْكِتُ وَالهِينَ يَتَامَى",49,"م",2,0],["هل في العيون التونسية شاطيء","ترتاح فوق رماله الأعصاب",50,"ب",1,0],["هل فيك شبرٌ لم يخضَّ","بْهُ دَمٌ جُرح ثائر؟",51,"ر",1,0],["هل في مصارع أجيال بهم فتكت","عذر المحيل عليها شنعة الأمل",52,"ل",1,0],["هل في الربى يا شمسُ غيرُ الربى","هل للكُوَى معنىً خَبِيءُ الجيوب",53,"ب",1,0],["هَلْ فيكُمُ مِنْ وَاقِفٍ مُتَفَرِّسِ،","بَعدي على نَظَرِ الظّبَاءِ الأُنَّسِ",54,"س",1,1],["هلْ في الشآمِ وهلْ في القُدسِ والدةٌ","لا تشتكي الثُكل إعْوالاً وإرنانا",55,"ن",2,0],["هل في زواياه من راح الصبا عبق","كلّ الرحيق المندّى في زواياه",56,"ا",2,0],["هل في ثراك على المعرّة موضع","بين العيون لدمعي السحّاح",57,"ح",1,0],["هل في جُنوبِ اللِّوى وجدٌ فأطرَبهُ","بأنَّةٍ أرسلَتْها حَنَّةُ العِيرِ",58,"ر",1,1],["هَل فَوقَ مَجدِكَ غايَةٌ لِطِلابِ","أَم عَن ذَراكَ مُعَرَّجٌ لِرِكابِ",59,"ب",1,1],["هَلْ في فُؤادِي لِلضَّنى","أَوْ جَسَدِي شَيءٌ بَقِي",60,"ق",2,0],["هل فيهم لولا سعادة ماجدٍ","أحد يداني تلكم الأهوالا",61,"ل",2,0],["هل في القياس بأن الحرب موجبه","إرشاد من ضل أو وتأليف من نفرا",62,"ر",2,0],["هَل في السماءِ فَضيلَةٌ لم تَحوِها","تَبغى لأَجل منالِها الأَفلاكا",63,"ك",2,0],["هَل في السَّوابِقِ كَاللّزارِ وَسَكبه","وَلِخيفهِ وَالورد خَير حِصانِ",64,"ن",1,0],["هَل في السُّيوفِ كَذي الفِقارِ وَمخذَمٍ","وَالحَتفُ حَتفُ كَتائِبِ الشَيطانِ",64,"ن",1,0],["هَل في البِلادِ لِرِزقِ اللهِ مُفتَرَشٌ","أم لا فَفِي جِلدِهِ مِن خُشنَةٍ بَرَشُ",65,"ش",1,1],["هَل في كتاب مَضى أَوسنة سلفت","عز لعبد عَلى عصيانه لاهى",66,"ه",2,0],["هَل في سَماحِ الدَهرِ لي أَنَّني","فيهِ أُناديكُم بِناديكُمُ",67,"م",1,0],["هل في الدنا ملك يقاس بملكه","هيهات الا ان يؤسس من جديد",68,"د",1,0],["هَلْ في البكاءِ عَلَى ما فاتَ منْ حرَجِ","فذكرُه هَاجَ وَجْداً كان مدفوعا",69,"ع",2,1],["هل في سبيلٍ إلى الإنصافِ من زمنٍ","جَلَّتْ رزاياه عن حصرٍ وَتعداد",70,"د",1,0],["هَل في الثَماني مِنَ التِسعينَ مَظلمَةٌ","وَرَبُّها لِكِتابِ اللَهِ مُستَطِرُ",71,"ر",1,0],["هَل في زَمانِكَ أَو من قبلَه سَمعت","أُذُناكَ ان اينَ أُنثى غير مُنتَقِل",72,"ل",1,0],["هَل في فُؤادي غَير حُبِّكَ ساكِن","أَو غَير طَيفِكَ في الكَرى طَرّاق",73,"ق",1,0],["هل في معاهدِ أصفهانَ وحُسنها","مُتعلَّلٌ لنزيعِ خُوزِسْتان",74,"ن",1,0],["هل في الفضيلةِ أن أَعيشَ كذا","شِلْواً بكفِّ الدّهرِ أُعترَق",75,"ق",1,0],["هل في عتابِ الحادثاتِ غَناءُ","أم هل لعيشٍ في الزمانِ صفاءُ",76,"ا",2,1],["هل في النهايةِ غير ما أبصَرتَني","فيه وكيف يكونُ من بلغَ المَدى",77,"د",2,0],["هَل في شَريعتَك الغَرّاء يا حكمي","إِن لا أَزال جَليس الهَم مُنفَرِدا",78,"د",2,0],["هل في القلوب بيوم الحشر إذعان","وهل بما قاله الرحمن إيمان",79,"ن",1,1],["هل في العموم كلام ربي داخل","أم فيه قول إلهنا لم يدخل",80,"ل",1,0],["هل في الرفاق متيم مثلي","أملي عليه ومنه أستملي",81,"ل",2,1],["هل في خيامكم من مهجتي خبر","فإنها بعدكم في الأرض تضطرب",82,"ب",1,0],["هل في القضيّة يا من فضلُ دولتِه","وعدلُ سِيرتِه بين الورَى عَلَمُ",83,"م",1,0],["هل فيهِمُ رجلٌ يُغني غَنَاي إذَا","جَلاَ الحوادثَ حدُّ السّيفِ والقَلَمُ",83,"م",1,0],["هل فيكُمُ مِنْ مُبلِغٍ","عنّي السّلاَمَ أبَا سلامَهْ",84,"م",2,0],["هَلْ في القضَايا أَنَ مَن مَا جَنَى","يَخضعُ بالعُذرِ إِلى الجَاني",85,"ي",1,0],["هَل في القَضّيةِ أنَّ حُبّك زائِدٌ","أبداً وحَظّي كلَّ يومٍ نَاقصُ",86,"ص",1,0],["هل في العراق ومن عليه ومن له","منها وليس لأَلْفِهِمْ معشارها",87,"ر",3,0],["هل في ربي تلك الطلول مقيمة","كعهدي على الأفنان ورق صوادح",88,"ح