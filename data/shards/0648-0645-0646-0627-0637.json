{"poems":[[55,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[55,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[75,"يا مستخفا بعاشقيه","https://www.aldiwan.net/poem11866.html","مجزوء البسيط"],[89,"قالت أراك عليل الجسم قلت لها","https://www.aldiwan.net/poem8274.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[48,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[128,"يا مدعي عام اللواء","https://www.aldiwan.net/poem23712.html","مجزوء الكامل"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[458,"طوبى ومرحى إذا الأحرار جمعهم","https://www.aldiwan.net/poem61266.html","البسيط"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[556,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[572,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63849","المجتث"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65130","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120510","المجتث"],[5273,"في الفخر","https://www.poetsgate.com/ViewPoem.aspx?id=215879",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""]],"verses":[["وَمَناطَ ما اِعتَقَلوا مِنَ البيضِ الظُبى","وَمَجَرَّ ما سَحَبوا مِنَ المُرّانِ",0,"ن",1,0],["وَمَناطُ أَطنابٍ وَمَقعَدُ فِتيَةٍ","تَخبو زِنادُ الحَيِّ غَيرَ زِنادِها",1,"د",3,0],["وَمَن أَطاعَ الوُشاةَ فينا","حَتّى أَطَعنا السُلُوَّ فيهِ",2,"ي",2,0],["وَمَنْ أَطَاعَ هَوَاهُ غَيْرَ مُكْتَرِثٍ","بِمَا يَكُونُ فَعُقْبَى أَمْرِهِ نَدَمُ",3,"م",1,0],["وَمَن أَطاعَ رَغبَةً وَرَهبَه","أَكثَرُ مِن قَومٍ أَطاعوا حَسبَه",4,"ه",1,0],["وَمَن أَطالَ خِلاجاً في مَوَدَّتِهِ","فَهَجرُهُ لَكَ خَيرٌ مِن تَلافيهِ",5,"ف",3,0],["وَمَنْ أَطَاعَ رُوَاةَ السُّوءِ نَفَّرَهُ","عَنِ الصَّدِيقِ سَمَاعُ الْقِيلِ وَالْقَالِ",6,"ل",1,0],["ومناط آمال القضاة","وحرز إنصاف الرعية",7,"ي",2,0],["ومن أطاعَ النَّبيَّ مُجْتَهداً","مجاهِداً لا يَعُوقُه كَسَلُ",8,"ل",1,0],["ومن إطاعته لا طوع عميان","بل طوع ذي بصر حر وإيمان",9,"ن",1,0],["ومناطيدٌ تَراهَا","حَجَبَت سُحبَ سَمَاها",10,"ه",2,0],["ومَن أطاعتْ أمرَه","عُرْبُ الفيافي والعَجَمْ",11,"م",1,0],["وَمَنْ أَطْفَأَ اللَّهُ نَارَ الضَّلاَلِ","بِهِ وَهْيَ تَرْمِي الهُدَى بِالشُّعَلْ",12,"ل",1,0],["ومن اطمأن فمرحباً بيقينه","ومن استراب فما عليك سبيل",13,"ل",1,0],["وَمَنْ أطالَ إلهي","في أسبغ العيشِ عُمْرَه",14,"ر",2,0],["ومناط النجم من همته","كم حمى من أربع المجد حمى",15,"م",2,0],["ومن أطاعتهُ بيض الهند لان له","كلّ العصاة ومن عن أمره نكلا",16,"ا",1,0],["وَمن اطاع امرءًا عَن مَأرب ترَه","أَغضى عَن الحَق يَوماً وَهو خزيان",17,"ن",1,0],["ومن اطال نجادا","ومن انال عتادا",18,"د",2,0],["ومِنْ أطايبِ شِعري اليومَ مائدةٌ","فكلْ هنيئاً وكنْ مِنْ خيرِ أنصاري",19,"ر",2,0],["ومناطق قد أغفلت رقباءها","وتجاهلت ما دوّن الرقباءُ",20,"ا",2,0]]}