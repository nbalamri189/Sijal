 الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=207444",""],[5016,"يا أكرم الكرماء يا من لم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=187102",""],[5018,"إن يجف عبد الله أو لم يجد","https://www.poetsgate.com/ViewPoem.aspx?id=96338",""],[5216,"مَلِكةُ الحُسْن","https://www.poetsgate.com/ViewPoem.aspx?id=187643",""],[5237,"ما حال من فارق ذاك الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=113108",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5277,"المغاضبة","https://www.poetsgate.com/ViewPoem.aspx?id=191930",""],[5277,"كأس الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193898",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5431,"من يخبر الأرض؟...","https://www.poetsgate.com/ViewPoem.aspx?id=198396",""],[5436,"موال حب للعراق(للشاعرجميل حسين الساعدي)","https://www.poetsgate.com/ViewPoem.aspx?id=138980",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5784,"ذكر الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=189817",""],[5939,"البوحُ في كتمانِنا","https://www.poetsgate.com/ViewPoem.aspx?id=185512",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[5956,"ألحانُ الحزن والفرح","https://www.poetsgate.com/ViewPoem.aspx?id=183900",""],[5956,"يا رب كيف أساعد الصنديدا","https://www.poetsgate.com/ViewPoem.aspx?id=194580",""],[5956,"يا رب إني أمدح الصنديدا","https://www.poetsgate.com/ViewPoem.aspx?id=194598",""],[5956,"سبحانَه القيُّومُ سمّاعُ الدُّعا","https://www.poetsgate.com/ViewPoem.aspx?id=204194",""],[5970,"أنا في العلم غلام لوذعي","https://www.poetsgate.com/ViewPoem.aspx?id=130659",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""],[463,"دعْ بين جلدى والعظام مكانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60212&r=&rc=268",""]],"verses":[["إِن يَجمَعِ اللَهَ شَملي يا هُذَيمُ بِهِم","فَلَستُ ما عِشتُ بِالزَّاري عَلى الزَمَنِ",0,"ن",1,0],["أَنِّي جَعَلْتُ كِتَابَ اللهِ معتمداً","لا تعرف النفس في تحصيله تعبا",1,"ب",2,0],["إِنْ يَجْهَلِ الشَّعْبُ فَالحُكْمُ الخَلِيقُ بِهِ","حَقُّ العَزِيزَينِ مِنْ وَالٍ وَسُلْطَانِ",2,"ن",1,0],["إِنّي جُعِلتُ فَما تُرجى مُقاسَرَتي","نِكلاً لِمُستَصعِبِ الشَيطانِ عِتريسِ",3,"س",1,0],["إِنّي جُعِلتُ فَلَن أُعافي تَغلِباً","لِلظالِمينَ عُقوبَةً وَنَكالا",4,"ل",2,0],["إن يُجرْني ابنُ يزيد مرّةً","منك لا يُلْمِم بِعَيْنَيَّ سُهودُ",5,"د",1,0],["إِن يَجرَحِ السَيفُ مَسلولاً فَلا عَجَبٌ","وَإِنَّما عَجَبي مِن مُغمَدٍ جَرَحا",6,"ح",2,0],["إِن يَجِدني يَتَحَدَّث أَو يَجِد","مَلَلاً يَطوي الأَحاديثَ اِقتِضابا",7,"ب",2,0],["إِن يَجهَلوكِ فَإِنَّ أُمَّكِ سورِيا","وَالأَبلَقُ الفَردُ الأَشَمُّ أَبوكِ",8,"ك",1,0],["إِن يَجمَحوا فَالسَيفُ مِن أَخلاقِهِ","رَدُّ الجَموحِ وَقَودُ مَن لا يُصحَبُ",9,"ب",1,0],["إن يجهلوهُ فقد عَرفتُ مَكانَهُ","والعدلُ عِندي لا محالةَ قائِمُ",10,"م",1,0],["إنّي جعلتُ لخالدٍ صَدَقاتِهم","تُجبَى إليَّ فما أحقَّ وأجدرا",11,"ر",2,0],["إن يجمعِ القومُ الجنودَ فإنّما","جمعوا مَزاعِمَ تُفتَرى ودعاويا",12,"ي",2,0],["إِني جَمعتكما وَلَكن لَم يَطل","أُنسي بِقُربكما فَواهاً واها",13,"ا",3,0],["إن يجز أن يعيش نا","سٌ فَما أنت منهمُ",14,"م",1,0],["إِنِّي جَزِعْتُ عَلَى صِبَاكِ وَهَلْ","جَزَعٌ يُكَافِيءُ فَادِحَ الأَمْرِ",15,"ر",1,0],["أَنَّى جرَى هَمس الخمائلُ باسمه","وتبسَّم النّسرينُ والنِّيلُوفَر",16,"ر",1,0],["إِنْ يَجْرِ فِي الْوَهْمِ يَوْماً","جَرَتْ دُمُوعِي اكْتِئَابا",17,"ب",2,0],["إني جعلتُك في بلاطي شاعرًا","كم في بلاطي شاعر وندامى!",18,"م",2,0],["إِني جَعلتُكَ ناطُوراً لرَوضَتِها","إِيَّاكَ أن تَجتَلِيها أعيُنُ الناسِ",19,"س",1,0],["إِن يَجحَدِ العُظماءُ فَضلَكَ فيهِمُ","فَبَنُوا السَبيلِ تُقِرُّ وَالأَيتامُ",20,"م",1,0],["أَن يَجحَدِ الحُسّادُ فَضلي فَما","يُخفيهِ بَينَ الناسِ أَن يَجحَدوهْ",21,"ه",1,1],["إِن يَجعلوا شخصَها بالبعد محتجباً","عنهُ فتَمثالها في القلب مجعولُ",22,"ل",1,0],["أَنّى جَزَوا عامِراً سُؤى بِفِعلِهِم","أَم كَيفَ يَجزونَني السُؤى مِنَ الحَسَنِ",23,"ن",1,0],["إن يجحَدِ القومُ والأوطانُ فَضلَكُمُ","لا القومُ قومي ولا الأوطانُ أوطاني",24,"ن",2,0],["إن يجهلوك فعين اللَه تحرسهم","من فتنةٍ كالرحيق الصرف هوجاء",25,"ا",2,0],["إن يجزع الورد مظلوما فلا عجبٌ","العيش للشوك يسقى ساقه الساقي",26,"ق",2,0],["إني جعلت عليك أعدل شاهدٍ","يرعاك حسن ودادِك المتسرع",27,"ع",1,0],["إني جعلت أجابتي في ظهرها","عمداً ليمكن فضها في المجلس",28,"س",1,1],["إن يُجحَدِ اليومَ إحسانٌ له فغداً","يُثنى عليهِ ويأتي الدَّهرُ مُعترفا",29,"ف",2,0],["إني جَنَيتُ الوَردَ منها شائكاً","وعليَّ فيها قد حنا التفَّاح",30,"ح",1,0],["إِني جُحَيشُ مَعشَري هَمدانِ","وَلَستُ عَبداً لِبَني حِمّانِ",31,"ن",1,0],["إن يَجرح اللَحظ وَهماً خَدّه فَلَكم","مِن مُهجَةٍ لَحظهُ بِالعَمد قَد جرحا",32,"ح",2,0],["إِنّي جَلَوتُ بِحُبِّها","قَلباً بغيرِكِ يَصدأُ",33,"ا",1,0],["إن يجهلوا قَدْرِي فلستُ بعاجب","أو يجهلوا وَجْدِي فليس بضائري",34,"ر",2,0],["إنّي جَنَيتُ ولم يزل نُبُلُ الورى","يهبون للخدّام ما يجنونَهُ",35,"ن",2,0],["إنِّي جنَيْتُ ولم يَزلْ أهلُ النُّهى","يَهبُونَ للخُدّامِ ما يَجنونَهُ",36,"ن",2,0],["إِنّي جَدير بِالنَجاحِ لأَنَّني","أَمَّلت لِلأَمرِ الجَليل جَليلا",37,"ل",2,0],["أَنَّى جَسَرْتَ عَلى الفِراقِ وأَنتَ في","قُربِ الدّيارِ بهم معنىًّ مُكمَدُ",38,"د",1,0],["إنْ يَجُدْ كانَ سحاباً ممطراً","أَو سطا كانَ عزيزاً ذا انتقام",39,"م",1,0],["إن يجمُدِ الجاري فكم من صخرةٍ","بيديْك سالتْ للعفاةِ شِعابُها",40,"ب",3,0],["إِنْ يَجْرِ زَاكِي دمٍ للحَمْدِ تُتْلِفُهُ","فَابْشِرْ بأَحْمَدَ منهُ الله يُخْلِفُهُ",41,"ف",2,1],["ان يجعلوا الطاعة فرضا لهم","في كل مشروع كما يعرض",42,"ض",1,0],["إن يجزع الاردن فهو بحزنه","مرآةُ أحزانٍ طفحنَ تُعمَّمُ",43,"م",1,0],["إن يَجتنِبْ منها الهشيمَ مصوِّحا","فيما اجتنى رَيعانَها ريحانا",44,"ن",2,0],["إن يجحد الناسُ عُلاهم فبما","أنكرَ روضٌ نِعَمَ الغمائمِ",45,"م",1,0],["أن يجمعَ الشملَ ما بيني وبينكم","حتى أعُدُّ له تلك الذنوبَ يَدا",46,"د",2,0],["إِنّي جَعَلتُ نَصيبي مِن مَوَدَّتِها","لِمَعبَدٍ وَمُعاذٍ وابنِ صَيّادِ",47,"د",1,0],["إِن يَجُل مُهرِيَ فيكُم جَولَةً","فَعَلَيهِ الكَرُّ فيكُم وَالغِوارُ",48,"ر",1,0],["أَن يَجعَلَ النُجحَ لي باباً إِلَيهِ وَأَن","يَخُصَّ حُسنَ رَجائي فيهِ بِالظَفرِ",49,"ر",1,0],["إن يجن صرف الردى ذنباً وفاقرة","فإنه بصلاح الدين يغتفر",50,"ر",1,0],["إنّي جليدٌ على الأهوالِ قاطبةً","ولستُ في فرقتي إيّاك بالبطلِ",51,"ل",1,0],["ان يجعل الحكم إلى ابن عمه","لعلمه بذهنه وعلمه",52,"ه",1,0],["إن يجزعوا فلقد أتتهم دولةٌ","وبها تَدول عليهمُ الأيّامُ",53,"م",1,0],["إِن يَجهل القاصِدُ المَعروفَ مِن ملكٍ","سواه فالعُرفُ مِن نُعماه مَعهودُ",54,"د",1,0],["ان يجن ذنبا من يوالي مدحك","السامي له كالورد في أوقاته",55,"ت",2,0],["إِنْ يَجرِ في صَدرِ الكَواغِدِ شَرحها","فَهيَ اللّواتي لِلصّدورِ شَوارحُ",56,"ح",1,0],["إِنّي جَنَيتُ مِنَ الذنوبِ كِبارَها","وَأَتيتُ مِن جَهلي بِكُلِّ عظيمةِ",57,"ه",1,0],["إنّي جعلتُ في الخطوبِ مَوْئِلي","محمداً والأنْزَع البَطينا",58,"ن",2,0],["إن يجمعِ اللَه شعباً بعد فُرقتهِ","فقد تريعُ إلى مقدارها الفُرَقُ",59,"ق",1,0],["إنّي جعلتك مستلاذاً لى ذما","سيل في طوفانه بلغ الربا",60,"ب",2,0],["أني جعلت الطير والضبعان","من لحم ودم",61,"م",1,0],["أن يجعل القرناص بين الناسِ","حتى يدوم الطير باستيناسِ",62,"س",1,0],["إني جعلتك جُنتى لجنايتي","ولكل أمر قد يجر إلى كمد",63,"د",1,0],["إن يجفُها جِلف تَقُل","في فَهمِك الآفاتُ لافي",64,"ف",2,0],["انى جسرت على اهانة سيد","اولى بحالك منه لثم بنان",65,"ن",1,0],["أن يجمعَ الشّملَ ما بينى وبينكمُ","ولا يكونَ لجمع الشَّملِ تفريقُ",66,"ق",1,0],["إن يجتمع إنسها والجنُّ ما قدروا","على مُحاكاتِهِ إذ عزّ أشباها",67,"ا",3,0],["إن يجرِ في حلباتِ الرأي مبتدراً","خلَّتْ له الوزراءُ الوردَ والصدرا",68,"ر",2,0],["أن يجتنى المجد غضاً من كمائمه","فإنما يجتنى من بعض غرسهما",69,"م",2,0],["أن يجر الشّنا إلى حرب نفس","كان من نفس أحمد منشاها",70,"ا",3,0],["إِن يَجلب اليَوم الهَوى لذَّة","فَفي غَد مِنهُ البُكا وَالعَويل",71,"ل",1,0],["ان يجعلوا الرمل لكم مرقداً","ويفرشوا للغير ريشَ النعام",72,"م",1,0],["إنِّي جعلتُ توكُّلي","أمني إذا ما القلبُ خافا",73,"ف",2,0],["إنّي جُننتُ بليلى وَهي غَافِلةٌ","عَن صَعبِ حالي وَلا ترثي إلى دَائي",74,"ي",1,1],["إني جعلت لكلِّ حقِّ موطناً","يدري به الشخصُ الذي في فيه",75,"ي",2,0],["إني جعلتُ رسولَ الله خيرَ شفيعٍ","فكن له يا وليّ اليومَ خيرَ سميع",76,"ع",1,1],["إني جعلتك يا محمد مفزعاً","في حاجتي وتشوقي لقضائها",77,"ه",2,1],["إِن يجد مَرَّةً حلاوة شكوا","هُ سيلقى نَدامَةً أَلف مَرَّه",78,"ر",2,0],["إِنّي جَناحُكَ قَد طالَت قَوادِمُهُ","فَهَل لِثابِتِ ريشٍ فيكَ إيجالُ",79,"ل",1,0],["اني جلستُ الى مياهِك ساعة","والبدرُ يغمر غمزة الايماءَِ",80,"ا",1,0],["إني جعلت اسمي ينوب ليرتوي","عنّي فقرّبه لحوض الكوثر",81,"ر",1,0],["أنَى جلست رأيت النفس في قلق","يثيرها فتعاف الصحب والسمرا",82,"ر",2,0],["أَن يَجعل الفَتوى قلادة جَوهر","في جيده فَتنال حَظاً أَوفَرا",83,"ر",2,0],["إن يجد لي الزّمانُ سهوا بنزر","منهُ تمنعهُ غيرةُ الحسّاد",84,"د",1,0],["إِن يَجهَلِ الأَقوامُ يوماً قَدرَه","فالكَنزُ يَجهَلُه سِوى المُتَطلِّع",85,"ع",1,0],["ان يجدهُ فهو مَشغوفٌ بِهِ","او توارى لا يزل يبحثُ عنهُ",86,"ه",1,0],["إني جدير أن أنال الذي","آمُلُ من نُعماكَ يا ذُخْري",87,"ر",2,0],["إني جنيت ذنوباً","وبئس ما كنت أجني",88,"ن",2,0],["إن يجهل الناس ما القديسُ في خلق","فأنت وحدَك قديس السماوات",89,"ت",1,1],["أن يجمع الشمل بمن شأنه","كسب المعالي واعتقال العوال",90,"ل",1,0],["أن يجعل النصر المبين قرينه","ويديله من فتحه الفتّاح",91,"ح",1,0],["ان يجل الخطب لا","تجدي عظات الحكماء",92,"ا",2,0],["إن يجر والذبول في الأرض تيهاً","فالأفاعي طويلةُ الأذناب",93,"ب",1,0],["اني جهول ضائع","مالي سواك فاهتدي",94,"د",2,0],["إنِّيَ جاهلٌ لكلِّ أمرِ","فكن معلِّمي كلَّ الدهرِ",95,"ر",1,1],["إني جعلتُ ربنا حسبي وبَخْ","لكي أنال أعلى ما ينال أخْ",96,"خ",1,1],["أني جبان أي يظن من حسب","وإن تقل يحسب بالكسر تصب",97,"ب",1,0],["إن يجرح الدهر مني غير جارحة","ففي البصائر ما يغني عن البصر",98,"ر",1,0],["ان يجتني الريق فما","يدري مداما ام فما",99,"م",2,0],["إِن يَجمَعنا الطيبُ عَلى ما ذَكَروا","لَكِنّيَ قَد جِئتُ بِفَرقٍ ظَهَرا",100,"ر",2,0],["ان يجريا للسبق خلتهما","سهمين منطلقين عن وتر",101,"ر",1,0],["أنى جرت والبرق في أمد","بلغت سواه الغاية القصوى",102,"و",2,0],["إنْ يجحدِ الشّاني عُلاكَ فما تَرَى","إشراقَ عينِ الشّمسِ عَيْنُ الأَكمَهِ",103,"ه",1,0],["إنْ يُجدِ لومي في الجودِ عاشقهُ","توران شاه كلانا غيرُ مُرتدعِ",104,"ع",1,0],["إني جعلتك في الفؤاد محدثي","وأبحت جسمي من أراد جلوسي",105,"ي",1,1],["إن يجدْ هفوة يصح ويولول","ويُقم للجدال قيّم فحص",106,"ص",1,0],["إن يُجَانفْ وُجُودِيَ الدهرُ حيناً","فحُضُوريْ مِن قبلُ فيهِ وبَعْدُ",107,"د",1,0],["إني جعلت إلى علاك وسيلتي","وشفيعيَ التوحيد والقرآنا",108,"ن",2,0],["إن يجف عبد الله أو لم يجد","يكفيك إنصافي والطافي",109,"ي",1,1],["إنّي جعلتُ الشِّعْرَ مدْحًا واقِفًا","في بابِ مُلْكِكِ فاسمَعيهِ وأَجْزِلي",110,"ل",2,0],["أن يجمع الشمل بكم عاجلا","في ذاكم المغنى العديم المثال",111,"ل",1,0],["إني جَلبْتُ لكُم شَواطئَ دجلة","وتركتُ حُزنَ الكرخِ في أعقابي",112,"ب",2,0],["إني جعلتك للديوانِ مطلعهُ","وأنت عنوانُه...لو ضاع عنواني",113,"ن",2,0],["إنّي جعلْتُكِ لي كبَدْرٍ في الدُّجى","وحضَنْتُ طيفاً ما لَنا إلّاهُ",114,"ا",2,0],["إنِّي جَزِعْتُ وما لنا الا هو","والنفسُ في أشلائِها أشْباهُ",115,"ا",2,1],["أني جلست فحانةٌ","تدع الجلوس بها طرابا",116,"ب",2,0],["أني جعلتك ياقوتا لجذوته","ماضلّ عنك شهاب الحب ..مابردا",117,"د",2,0],["إنّي جعلتُك َ وِرْدي غيرَ مُكترث","بما يصوّرُ شكّاك ٌ ومُتّثقُ",118,"ق",1,0],["أن يجعل البركات في","هم تنتشي مثل السحاب",119,"ب",1,0],["إني جعلتك أذكارا أرددها","والشوق في عمق نفسي ثابت راسي",120,"س",2,0],["إنّي جريحٌ في الهَوَى","بالقربِ قلبي أَسعفي",121,"ف",2,0],["أنْ يجعلَ فيكِ محبَّتَهُ","ويزيدَكِ بالخيراتِ هدى",122,"د",2,0],["إني جعلتك ملهمي","من طيبة وتفانيا",123,"ي",2,0],["إني جَرَحْتُ شعورَ شخص طيّب","ولذا اْنصهرتُ بحسرتي أتعذبُ",124,"ب",1,0],["إني جأرت إليك يا رب السما","في أن تعيد أجوره وتزيدا",125,"د",2,0],["إني جأرت إليك يا ربَّ السما","في أن تُجَوّدَ أجرهُ وتزيدا",126,"د",2,0],["إني جمعتكمو بشعرٍ واحدٍ","أدري تواضعكم يفيض تورُّعا",127,"ع",2,1],["إن يجنح الليل أسرى للعلا","متعينا بذكاء ألمعي",128,"ع",2,0],["إِنْ يَجْنَحوا لِلسِّلْمِ فَابْرَأْ مِنْهُمُ","وَ اجْنَحْ إِلى الأَحْجَارِ وَ ارْمِ البَاغِيَا",129,"ي",2,0],["ان يجهل التاريخ من شادوك من","عرب ومن روم ومن يونان",130,"ن",1,0],["إن يجتنب منها الهشيمَ مصوِّحا","فبما اجتنى ريعانها ريحانا",131,"ن",2,0]]}