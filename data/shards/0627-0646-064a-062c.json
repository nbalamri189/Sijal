{"poems":[[63,"أرض العذيب أما تنفك بارقة","https://www.aldiwan.net/poem45734.html","البسيط"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[27,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[70,"قالوا تعشقتها عمياء قلت لهم","https://www.aldiwan.net/poem42973.html","البسيط"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[85,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[105,"ولقد عجبت من الغواة وقولهم","https://www.aldiwan.net/poem43117.html","الكامل"],[105,"سر يا أسامة ما لجيشك هازم","https://www.aldiwan.net/poem43570.html","الكامل"],[105,"ترك الملوك ملوك كندة وانتحى","https://www.aldiwan.net/poem44009.html","الكامل"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[102,"يا زهرة الوادي أتيت بزهرة","https://www.aldiwan.net/poem33104.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85729","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54942","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[106,"فيم احتفالكم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=179398",""],[127,"علقت عودي على صفصافة اليأس","https://www.aldiwan.net/poem67430.html","البسيط"],[167,"ألقت إليك مقادها الأيام","https://www.aldiwan.net/poem1678.html",""],[180,"أن يجحد الحساد فضلي فما","https://www.aldiwan.net/poem67014.html","السريع"],[187,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[194,"بلغ حُبيباً وخلل في صراتهم","https://www.aldiwan.net/poem528.html",""],[195,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[209,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[209,"جارت على الورد في أيام نضرته","https://www.aldiwan.net/poem46779.html","البسيط"],[227,"عهد المحب المخلص المتطوع","https://www.aldiwan.net/poem50961.html","الكامل"],[254,"إني جعلت أجابتي في ظهرها","https://www.aldiwan.net/poem48423.html","الكامل"],[268,"من أين للكوكب السيار أن يقفا","https://www.aldiwan.net/poem35062.html","البسيط"],[268,"أعلى الخدود الورد والتفاح","https://www.aldiwan.net/poem35268.html","الكامل"],[272,"تخبرني شواحج الغدقان","https://www.aldiwan.net/poem2255.html","الرجز"],[351,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[374,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[400,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[402,"قل للأمير أدام ربي عزه","https://www.aldiwan.net/poem49387.html","الكامل"],[402,"قل للأمير أدام ربي عزه","https://www.aldiwan.net/poem49453.html","الكامل"],[403,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[406,"أتظن صبرك منجدا إن أنجدوا","https://www.aldiwan.net/poem32499.html","الكامل"],[413,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[429,"حاشا مكارمك الهتون سحابها","https://www.aldiwan.net/poem12563.html","الكامل"],[436,"إن يجر زاكي دم للحمد تتلفه","https://www.aldiwan.net/poem34844.html","البسيط"],[441,"نوابنا نوائب كلهم","https://www.aldiwan.net/poem55947.html","عموديه"],[451,"أهل الحمية والحمية أنتمو","https://www.aldiwan.net/poem61679.html","الكامل"],[456,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[456,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[459,"هل للزمان وقد جلت جرائمه","https://www.aldiwan.net/poem15130.html","البسيط"],[468,"ضنت عقيلة لما جئت بالزاد","https://www.aldiwan.net/poem4672.html","البسيط"],[488,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[491,"فإن رأى لا أراه الله نائبة","https://www.aldiwan.net/poem67371.html","البسيط"],[513,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[549,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِن يَجمَعِ اللَهَ شَملي يا هُذَيمُ بِهِم","فَلَستُ ما عِشتُ بِالزَّاري عَلى الزَمَنِ",0,"ن",1,0],["أَنِّي جَعَلْتُ كِتَابَ اللهِ معتمداً","لا تعرف النفس في تحصيله تعبا",1,"ب",2,0],["إِنْ يَجْهَلِ الشَّعْبُ فَالحُكْمُ الخَلِيقُ بِهِ","حَقُّ العَزِيزَينِ مِنْ وَالٍ وَسُلْطَانِ",2,"ن",1,0],["إِنّي جُعِلتُ فَما تُرجى مُقاسَرَتي","نِكلاً لِمُستَصعِبِ الشَيطانِ عِتريسِ",3,"س",1,0],["إِنّي جُعِلتُ فَلَن أُعافي تَغلِباً","لِلظالِمينَ عُقوبَةً وَنَكالا",4,"ل",2,0],["إن يُجرْني ابنُ يزيد مرّةً","منك لا يُلْمِم بِعَيْنَيَّ سُهودُ",5,"د",1,0],["إِن يَجرَحِ السَيفُ مَسلولاً فَلا عَجَبٌ","وَإِنَّما عَجَبي مِن مُغمَدٍ جَرَحا",6,"ح",2,0],["إِن يَجِدني يَتَحَدَّث أَو يَجِد","مَلَلاً يَطوي الأَحاديثَ اِقتِضابا",7,"ب",2,0],["إِن يَجهَلوكِ فَإِنَّ أُمَّكِ سورِيا","وَالأَبلَقُ الفَردُ الأَشَمُّ أَبوكِ",8,"ك",1,0],["إِن يَجمَحوا فَالسَيفُ مِن أَخلاقِهِ","رَدُّ الجَموحِ وَقَودُ مَن لا يُصحَبُ",9,"ب",1,0],["إن يجهلوهُ فقد عَرفتُ مَكانَهُ","والعدلُ عِندي لا محالةَ قائِمُ",10,"م",1,0],["إنّي جعلتُ لخالدٍ صَدَقاتِهم","تُجبَى إليَّ فما أحقَّ وأجدرا",11,"ر",2,0],["إن يجمعِ القومُ الجنودَ فإنّما","جمعوا مَزاعِمَ تُفتَرى ودعاويا",12,"ي",2,0],["إِني جَمعتكما وَلَكن لَم يَطل","أُنسي بِقُربكما فَواهاً واها",13,"ا",3,0],["إن يجز أن يعيش نا","سٌ فَما أنت منهمُ",14,"م",1,0],["إِنِّي جَزِعْتُ عَلَى صِبَاكِ وَهَلْ","جَزَعٌ يُكَافِيءُ فَادِحَ الأَمْرِ",15,"ر",1,0],["أَنَّى جرَى هَمس الخمائلُ باسمه","وتبسَّم النّسرينُ والنِّيلُوفَر",16,"ر",1,0],["إِنْ يَجْرِ فِي الْوَهْمِ يَوْماً","جَرَتْ دُمُوعِي اكْتِئَابا",17,"ب",2,0],["إني جعلتُك في بلاطي شاعرًا","كم في بلاطي شاعر وندامى!",18,"م",2,0],["إِني جَعلتُكَ ناطُوراً لرَوضَتِها","إِيَّاكَ أن تَجتَلِيها أعيُنُ الناسِ",19,"س",1,0],["إِن يَجحَدِ العُظماءُ فَضلَكَ فيهِمُ","فَبَنُوا السَبيلِ تُقِرُّ وَالأَيتامُ",20,"م",1,0],["أَن يَجحَدِ الحُسّادُ فَضلي فَما","يُخفيهِ بَينَ الناسِ أَن يَجحَدوهْ",21,"ه",1,1],["إِن يَجعلوا شخصَها بالبعد محتجباً","عنهُ فتَمثالها في القلب مجعولُ",22,"ل",1,0],["أَنّى جَزَوا عامِراً سُؤى بِفِعلِهِم","أَم كَيفَ يَجزونَني السُؤى مِنَ الحَسَنِ",23,"ن",1,0],["إن يجحَدِ القومُ والأوطانُ فَضلَكُمُ","لا القومُ قومي ولا الأوطانُ أوطاني",24,"ي",1,0],["إن يجهلوك فعين اللَه تحرسهم","من فتنةٍ كالرحيق الصرف هوجاء",25,"ا",2,0],["إن يجزع الورد مظلوما فلا عجبٌ","العيش للشوك يسقى ساقه الساقي",26,"ي",1,0],["إني جعلت عليك أعدل شاهدٍ","يرعاك حسن ودادِك المتسرع",27,"ع",1,0],["إني جعلت أجابتي في ظهرها","عمداً ليمكن فضها في المجلس",28,"س",1,1],["إن يُجحَدِ اليومَ إحسانٌ له فغداً","يُثنى عليهِ ويأتي الدَّهرُ مُعترفا",29,"ف",2,0],["إني جَنَيتُ الوَردَ منها شائكاً","وعليَّ فيها قد حنا التفَّاح",30,"ح",1,0],["إِني جُحَيشُ مَعشَري هَمدانِ","وَلَستُ عَبداً لِبَني حِمّانِ",31,"ن",1,0],["إن يَجرح اللَحظ وَهماً خَدّه فَلَكم","مِن مُهجَةٍ لَحظهُ بِالعَمد قَد جرحا",32,"ح",2,0],["إِنّي جَلَوتُ بِحُبِّها","قَلباً بغيرِكِ يَصدأُ",33,"ا",1,0],["إن يجهلوا قَدْرِي فلستُ بعاجب","أو يجهلوا وَجْدِي فليس بضائري",34,"ي",1,0],["إنّي جَنَيتُ ولم يزل نُبُلُ الورى","يهبون للخدّام ما يجنونَهُ",35,"ن",2,0],["إنِّي جنَيْتُ ولم يَزلْ أهلُ النُّهى","يَهبُونَ للخُدّامِ ما يَجنونَهُ",36,"ن",2,0],["إِنّي جَدير بِالنَجاحِ لأَنَّني","أَمَّلت لِلأَمرِ الجَليل جَليلا",37,"ل",2,0],["أَنَّى جَسَرْتَ عَلى الفِراقِ وأَنتَ في","قُربِ الدّيارِ بهم معنىًّ مُكمَدُ",38,"د",1,0],["إنْ يَجُدْ كانَ سحاباً ممطراً","أَو سطا كانَ عزيزاً ذا انتقام",39,"م",1,0],["إن يجمُدِ الجاري فكم من صخرةٍ","بيديْك سالتْ للعفاةِ شِعابُها",40,"ب",3,0],["إِنْ يَجْرِ زَاكِي دمٍ للحَمْدِ تُتْلِفُهُ","فَابْشِرْ بأَحْمَدَ منهُ الله يُخْلِفُهُ",41,"ف",2,1],["ان يجعلوا الطاعة فرضا لهم","في كل مشروع كما يعرض",42,"ض",1,0],["إن يجزع الاردن فهو بحزنه","مرآةُ أحزانٍ طفحنَ تُعمَّمُ",43,"م",1,0],["إن يَجتنِبْ منها الهشيمَ مصوِّحا","فيما اجتنى رَيعانَها ريحانا",44,"ن",2,0],["إن يجحد الناسُ عُلاهم فبما","أنكرَ روضٌ نِعَمَ الغمائمِ",45,"م",1,0],["أن يجمعَ الشملَ ما بيني وبينكم","حتى أعُدُّ له تلك الذنوبَ يَدا",46,"د",2,0],["إِنّي جَعَلتُ نَصيبي مِن مَوَدَّتِها","لِمَعبَدٍ وَمُعاذٍ وابنِ صَيّادِ",47,"د",1,0],["إِن يَجُل مُهرِيَ فيكُم جَولَةً","فَعَلَيهِ الكَرُّ فيكُم وَالغِوارُ",48,"ر",1,0],["أَن يَجعَلَ النُجحَ لي باباً إِلَيهِ وَأَن","يَخُصَّ حُسنَ رَجائي فيهِ بِالظَفرِ",49,"ر",1,0],["إن يجن صرف الردى ذنباً وفاقرة","فإنه بصلاح الدين يغتفر",50,"ر",1,0],["إنّي جليدٌ على الأهوالِ قاطبةً","ولستُ في فرقتي إيّاك بالبطلِ",51,"ل",1,0],["ان يجعل الحكم إلى ابن عمه","لعلمه بذهنه وعلمه",52,"ه",1,0]]}