{"poems":[[55,"يا ذاكر النعماء إن نسيت","https://www.aldiwan.net/poem30191.html","الكامل"],[65,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[74,"سيدي أصبحت مقروح الحشا","https://www.aldiwan.net/poem20346.html","الرمل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[47,"لئن بخلت بما تحوي يداك لقد","https://www.aldiwan.net/poem65623.html","البسيط"],[68,"زار والليل مؤذن بالبراز","https://www.aldiwan.net/poem38491.html","الخفيف"],[92,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[107,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[77,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[48,"ألا فانعموا واحذروا في الحياة","https://www.aldiwan.net/poem23437.html","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62224","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[92,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[107,"حملت سناك مواكب الأعوام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55086&r=&rc=256",""],[112,"يا غزال السفح من وادي زرود","https://www.aldiwan.net/poem16522.html","الخفيف"],[253,"زيارة قبر المصطفى غاية المنى","https://www.aldiwan.net/poem15064.html","الطويل"],[273,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[278,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[502,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[516,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[569,"ما بال طفشيلك قد أخرت","https://www.aldiwan.net/poem69459.html","السريع"]],"verses":[["زَخَرَت غَوارِبُهُ إِلَيَّ وَلَم","يَقُلِ الرَجاءُ لَعَلَّما وَعسى",0,"س",2,0],["زَخَرَتْ بهمْ أمُّ البَنين فأقبَلوا","كالمَشْرَفيّةِ نَجدَةً وعَزيما",1,"م",2,0],["زخرَتْ بأمواجِ الحديد وربما","ضاق الفضاء فما وَجَدْنَ مسيلا",2,"ل",2,0],["زخرف الألفاظ قد أرسلته","فعسى تملأ بيتي بالدُّخان",3,"ن",1,0],["زُخرفتْ يوم نُعمه حُجراتٌ","جِدُّ موطوءةٍ من الضيفان",4,"ن",1,0],["زَخرَفتُ فيكَ مَديحاً كُلُّهُ كَذِبٌ","فَكُنتُ أَكذَبَ مِن مَدحي وَتَأميلي",5,"ي",1,0],["زَخرَفَت جَنَّتي فَبِتُّ قَريراً","مُنعَماً يَسمَعُ الزَمانُ اِرتِجازي",6,"ز",2,0],["زَخَّ جوداً فَلا يَزالُ ثَناهُ","في اِزدِيادٍ وَمالُهُ في اِعوِزازِ",6,"ز",1,0],["زَخَّارة ً بشذا الأقَاحِ","يَمدُّهُ نَفْحُ الخُزَامِ",7,"م",1,0],["زخرت حوالَيْها القتوحُ فغيَّبت","غرقى الممالكِ في العُبابِ الطّامي",8,"م",2,0],["زخَرَتْ غواشي الموت ناراً تلتظي","فأرَتْ عَدوّكَ زندَك المقدوحا",9,"ح",2,0],["زَخارِفُ ما ثَبَتَت في العُقو","لِ عَمّى عَلَيكُم بِهِنَّ المُعَم",10,"م",1,0],["زُخَارِيَّ النَّبَاتِ كَأَنَّ فِيهِ","جِيَادَ العَبْقَرِيَّةِ والقُطُوعِ",11,"ع",1,0],["زَخارِفُ العَيشِ ذاهِباتٌ","وَظِلّهُ قالِصٌ فَآزِ",12,"ز",1,0],["زَخارِفُ دُنيانا الأَنيقَةُ أَصبَحَت","هَشيماً كَما رَثَّ الرِداءُ المُطَرَّزُ",13,"ز",1,1],["زخاريفُ قولٍ تعتليها ركاكةٌ","ويبدو عليهنّ الخنا والتبذل",14,"ل",1,0],["زخرت حواليها الفتوح فغيبت","غرقى الممالك في العباب الطامي",15,"م",2,0],["زَخرَف الواشي أَقاويلاً بِها","حلت عَن عَهدي وَأَشمت الحَسود",16,"د",1,0],["زخارف آمالٍ تحوزُ عُقُولنا","ولَسنا لإدراك المرامِ نجوزُ",17,"ز",1,0],["زَخرَفتُ حلمَ شبيبةٍ عربية","ورفعتُ مشعالاً لكلّ ضليل",18,"ل",1,0],["زُخْرُفَةُ العَذْلِ في هَوَاها","جَعْجَعَةٌ لا تُفيدُ طِحْنا",19,"ن",2,0],["زُخْرُفُ القولِ كَوى أَبصارَهُمْ","فعَموا وافْتَتَنوا بل هُتِكُوا",20,"ك",3,0],["زخْرَفْتَهُ ونقشْتَ فيه لمنْ يَرى","صوراً من التّعظيمِ والتّمجيدِ",21,"د",1,0],["زَخَارِفُ الوَشْي وَأَلْوَانُهُ","تِبْرٌ مِنَ الجَوْهَرِ مَنْثُورَا",22,"ر",2,0]]}