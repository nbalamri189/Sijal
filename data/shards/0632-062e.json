{"poems":[[53,"يا ذاكر النعماء إن نسيت","https://www.aldiwan.net/poem30191.html","الكامل"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[72,"سيدي أصبحت مقروح الحشا","https://www.aldiwan.net/poem20346.html","الرمل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[45,"لئن بخلت بما تحوي يداك لقد","https://www.aldiwan.net/poem65623.html","البسيط"],[66,"زار والليل مؤذن بالبراز","https://www.aldiwan.net/poem38491.html","الخفيف"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[75,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[46,"ألا فانعموا واحذروا في الحياة","https://www.aldiwan.net/poem23437.html","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[105,"حملت سناك مواكب الأعوام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55086&r=&rc=256",""],[109,"يا غزال السفح من وادي زرود","https://www.aldiwan.net/poem16522.html","الخفيف"],[250,"زيارة قبر المصطفى غاية المنى","https://www.aldiwan.net/poem15064.html","الطويل"],[270,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[275,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[500,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[567,"ما بال طفشيلك قد أخرت","https://www.aldiwan.net/poem69459.html","السريع"]],"verses":[["زَخَرَت غَوارِبُهُ إِلَيَّ وَلَم","يَقُلِ الرَجاءُ لَعَلَّما وَعسى",0,"س",2,0],["زَخَرَتْ بهمْ أمُّ البَنين فأقبَلوا","كالمَشْرَفيّةِ نَجدَةً وعَزيما",1,"م",2,0],["زخرَتْ بأمواجِ الحديد وربما","ضاق الفضاء فما وَجَدْنَ مسيلا",2,"ل",2,0],["زخرف الألفاظ قد أرسلته","فعسى تملأ بيتي بالدُّخان",3,"ن",1,0],["زُخرفتْ يوم نُعمه حُجراتٌ","جِدُّ موطوءةٍ من الضيفان",4,"ن",1,0],["زَخرَفتُ فيكَ مَديحاً كُلُّهُ كَذِبٌ","فَكُنتُ أَكذَبَ مِن مَدحي وَتَأميلي",5,"ي",1,0],["زَخرَفَت جَنَّتي فَبِتُّ قَريراً","مُنعَماً يَسمَعُ الزَمانُ اِرتِجازي",6,"ز",2,0],["زَخَّ جوداً فَلا يَزالُ ثَناهُ","في اِزدِيادٍ وَمالُهُ في اِعوِزازِ",6,"ز",1,0],["زَخَّارة ً بشذا الأقَاحِ","يَمدُّهُ نَفْحُ الخُزَامِ",7,"م",1,0],["زخرت حوالَيْها القتوحُ فغيَّبت","غرقى الممالكِ في العُبابِ الطّامي",8,"م",2,0],["زخَرَتْ غواشي الموت ناراً تلتظي","فأرَتْ عَدوّكَ زندَك المقدوحا",9,"ح",2,0],["زَخارِفُ ما ثَبَتَت في العُقو","لِ عَمّى عَلَيكُم بِهِنَّ المُعَم",10,"م",1,0],["زَخارِفُ العَيشِ ذاهِباتٌ","وَظِلّهُ قالِصٌ فَآزِ",11,"ز",1,0],["زَخارِفُ دُنيانا الأَنيقَةُ أَصبَحَت","هَشيماً كَما رَثَّ الرِداءُ المُطَرَّزُ",12,"ز",1,1],["زخاريفُ قولٍ تعتليها ركاكةٌ","ويبدو عليهنّ الخنا والتبذل",13,"ل",1,0],["زخرت حواليها الفتوح فغيبت","غرقى الممالك في العباب الطامي",14,"م",2,0],["زَخرَف الواشي أَقاويلاً بِها","حلت عَن عَهدي وَأَشمت الحَسود",15,"د",1,0],["زخارف آمالٍ تحوزُ عُقُولنا","ولَسنا لإدراك المرامِ نجوزُ",16,"ز",1,0],["زَخرَفتُ حلمَ شبيبةٍ عربية","ورفعتُ مشعالاً لكلّ ضليل",17,"ل",1,0],["زُخْرُفَةُ العَذْلِ في هَوَاها","جَعْجَعَةٌ لا تُفيدُ طِحْنا",18,"ن",2,0],["زُخْرُفُ القولِ كَوى أَبصارَهُمْ","فعَموا وافْتَتَنوا بل هُتِكُوا",19,"ك",3,0],["زخْرَفْتَهُ ونقشْتَ فيه لمنْ يَرى","صوراً من التّعظيمِ والتّمجيدِ",20,"د",1,0],["زَخَارِفُ الوَشْي وَأَلْوَانُهُ","تِبْرٌ مِنَ الجَوْهَرِ مَنْثُورَا",21,"ر",2,0]]}