.com/ViewPoem.aspx?id=201202",""],[5431,"يضحك الشفق...","https://www.poetsgate.com/ViewPoem.aspx?id=203089",""],[5497,"علل النفس بما يسعدها","https://www.poetsgate.com/ViewPoem.aspx?id=206747",""],[5526,"المطر","https://www.poetsgate.com/ViewPoem.aspx?id=193648",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5937,"هاربٌ مِن سَدِّ مَأرِب","https://www.poetsgate.com/ViewPoem.aspx?id=211810",""],[5956,"قررتُ معها أن أستقرَّ","https://www.poetsgate.com/ViewPoem.aspx?id=182055",""],[6055,"إلى الحداثة....مع التحية","https://www.poetsgate.com/ViewPoem.aspx?id=30577",""],[572,"ما بالُ طفشيلِكَ قد أخِّرتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9304&r=&rc=161",""]],"verses":[["زَخَرَت غَوارِبُهُ إِلَيَّ وَلَم","يَقُلِ الرَجاءُ لَعَلَّما وَعسى",0,"س",2,0],["زَخَرَتْ بهمْ أمُّ البَنين فأقبَلوا","كالمَشْرَفيّةِ نَجدَةً وعَزيما",1,"م",2,0],["زخرَتْ بأمواجِ الحديد وربما","ضاق الفضاء فما وَجَدْنَ مسيلا",2,"ل",2,0],["زخرف الألفاظ قد أرسلته","فعسى تملأ بيتي بالدُّخان",3,"ن",1,0],["زُخرفتْ يوم نُعمه حُجراتٌ","جِدُّ موطوءةٍ من الضيفان",4,"ن",1,0],["زَخرَفتُ فيكَ مَديحاً كُلُّهُ كَذِبٌ","فَكُنتُ أَكذَبَ مِن مَدحي وَتَأميلي",5,"ي",1,0],["زَخرَفَت جَنَّتي فَبِتُّ قَريراً","مُنعَماً يَسمَعُ الزَمانُ اِرتِجازي",6,"ز",2,0],["زَخَّ جوداً فَلا يَزالُ ثَناهُ","في اِزدِيادٍ وَمالُهُ في اِعوِزازِ",6,"ز",1,0],["زَخَّارة ً بشذا الأقَاحِ","يَمدُّهُ نَفْحُ الخُزَامِ",7,"م",1,0],["زخرت حوالَيْها القتوحُ فغيَّبت","غرقى الممالكِ في العُبابِ الطّامي",8,"م",2,0],["زخَرَتْ غواشي الموت ناراً تلتظي","فأرَتْ عَدوّكَ زندَك المقدوحا",9,"ح",2,0],["زَخارِفُ ما ثَبَتَت في العُقو","لِ عَمّى عَلَيكُم بِهِنَّ المُعَم",10,"م",1,0],["زُخَارِيَّ النَّبَاتِ كَأَنَّ فِيهِ","جِيَادَ العَبْقَرِيَّةِ والقُطُوعِ",11,"ع",1,0],["زَخارِفُ العَيشِ ذاهِباتٌ","وَظِلّهُ قالِصٌ فَآزِ",12,"ز",1,0],["زَخارِفُ دُنيانا الأَنيقَةُ أَصبَحَت","هَشيماً كَما رَثَّ الرِداءُ المُطَرَّزُ",13,"ز",1,1],["زخاريفُ قولٍ تعتليها ركاكةٌ","ويبدو عليهنّ الخنا والتبذل",14,"ل",1,0],["زخرت حواليها الفتوح فغيبت","غرقى الممالك في العباب الطامي",15,"م",2,0],["زَخرَف الواشي أَقاويلاً بِها","حلت عَن عَهدي وَأَشمت الحَسود",16,"د",1,0],["زخارف آمالٍ تحوزُ عُقُولنا","ولَسنا لإدراك المرامِ نجوزُ",17,"ز",1,0],["زَخرَفتُ حلمَ شبيبةٍ عربية","ورفعتُ مشعالاً لكلّ ضليل",18,"ل",1,0],["زُخْرُفَةُ العَذْلِ في هَوَاها","جَعْجَعَةٌ لا تُفيدُ طِحْنا",19,"ن",2,0],["زُخْرُفُ القولِ كَوى أَبصارَهُمْ","فعَموا وافْتَتَنوا بل هُتِكُوا",20,"ك",3,0],["زخْرَفْتَهُ ونقشْتَ فيه لمنْ يَرى","صوراً من التّعظيمِ والتّمجيدِ",21,"د",1,0],["زَخَارِفُ الوَشْي وَأَلْوَانُهُ","تِبْرٌ مِنَ الجَوْهَرِ مَنْثُورَا",22,"ر",2,0],["زَخرَفتَ مِن مَلَقٍ وَعَتب","وهُوَ حسبي",23,"ي",1,0],["زَخوُ النَسا وَالحالِبَينِ مُلَثَّماً","في مِثلِ جَحفَلَةِ الحِمارِ الدَيزَجِ",24,"ج",1,0],["زَخَارِفُ أَقْوَالٍ مِنَ الْحِبِّ لُفِّقَتْ","بِوَعْدٍ طَوِيلٍ عُمْرُهُ غَيْرُ نَاجِزِ",25,"ز",1,0],["زُخرِفت من وجهها لى جنّةٌ","كانتِ الرِّيقَةُ لى فيها مُداما",26,"م",2,0],["زخرت به أم اللغات ولم تزل","بعلاه تفترع اللغى وتطول",27,"ل",1,0],["زخر الدويُّ بها وندي أقبلت","بالملك في ركب الجلال ركاب",28,"ب",1,0],["زخرفٌ خادعٌ وصفوٌ كذُوب","ومتاع مهما تفاخرَ فانِ",29,"ن",1,0],["زخارف دنيانا لأحمد لم ترق","ولا كان شيء بها يتحيز",30,"ز",1,0],["زخرتُ بيمِّ علمٍ لم يَحُزْهُ","بفلْكِ الفهمِ زَجَّاجٌ ورازي",31,"ز",2,0],["زخرفتها نفس ملوكية العنص","ر من صفو جوهر الإيمان",32,"ن",1,0],["زخرتَ كأَن الضاريات زئيرها","علا وصداه من بعيدٍ يجاوبه",33,"ب",2,0],["زخارف أقوال ودنيا ضلالة","أليس لهذا الموت يا رب من حشر",34,"ر",1,0],["زخر العلم مِنهُ عَذباً فَأَبدى","عَن جمان وَجَوهَر مَنكوز",35,"ز",1,0],["زخارف شعر شادها فقر معوز","على جرف هار من الامل المحل",36,"ل",1,0],["زخارفُ دنيا تشغلُ المرءَ باطناً","فتلبسه بزّاً وتسلبه بزَّا",37,"ز",2,0],["زخرف في سواك مدحي وصدق","فيك والقائلون من عزبرا",38,"ر",2,0],["زخرت مدامع مقلتي","عن عندم أو عن دم",39,"م",1,0],["زَخُورُ جُيُوشٍ فِي حُنَينٍ ومَا رَمَت","يَداكَ لَهُم بزّا وَمَن عَزَّ قَد بَزَّا",40,"ز",2,0],["زَخرَفوا القَولَ في اِجتِياحِ هَديل","وَأَراها في الحُزنِ لَيسَ هُنالِك",41,"ك",1,0],["زَخَرَتْ بهم أَمواجُ آجكَ في الوغَى","غُزُراً وَطَمَّ بهم عُبابُ طُمانِ",42,"ن",1,0],["زخر البحر بالجيوش الضخام","آله الفتك في القرى والأنام",43,"م",1,1],["زَخَرَت براحَتِه بِحارُ سماحةٍ","ما أحْوَجت لِوَسيلةٍ مَنْ جاءها",44,"ا",3,0],["زَخَرت نَوادي لَهوِكُم بِمَجالسٍ","مَوصولَةٍ غَدواتُها بِأَصائِلِ",45,"ل",1,0],["زخروا بأقطار البلاد","خضارماً بالعلم فعما",46,"م",2,0],["زخرفتِ ليلي فالهوى أسطورةٌ","يحيا بها قلب المحبّ ويفنى",47,"ن",2,0],["زُخَّتْ حُقُوْلٌ بِأَمْطَاْرٍ لَهَاْ حَمَدٌ","بِالْخَيْرِ مُزْنَتُهُ تَهْمِيْ بِلَاْ تَعَبِ",48,"ب",1,0],["زَخَّاتُ قَوْلِي بِهَا مِنْ وَابِلٍ غَدِقٍ","مَا هَاجَ مِنْ لَوْعَةٍ فِي هَيْمَةِ الْكَدَرِ",49,"ر",1,0],["زُخّي فإنّ خوالجي","عطشى لقطرٍ من سحابكْ",50,"ك",1,0],["زخارف زور لفقوها بمكرهم","وراموا بما قد لفقوا الفوز والظفر",51,"ر",1,0],["زخمُ الحضارة حاضرٌ بقداسة","وتشيدُ أصرحة البهاء وتُبدعُ",52,"ع",1,0],["زخٌ على من أحببت مؤتمنٌ","وفوق أرضٍ بالقمح تأتلقُ",53,"ق",1,0],["‏زَخْرَفَتْ فِتْنَتَهَا ضَاحِكَةً","‏ فاحْذَرَنْ مِنْهَا وَأَحْسِنْ عَمَلَكْ",54,"ك",1,0],["زخ المطر بالجوف خلف الشبابيك","والمزن شرق الجوف تلعج بروقه",55,"ق",2,1],["زخر البحر من لآليك شعراً","وصفا ماؤه النمير الرواء",56,"ا",2,0],["زخرفتُ قلبي باسمك المنتَهى","حتى امتلا قلبي من الزخرفة",57,"ف",2,0],["زَخَّ المطرْ ‏وقت السَّفَرْ","‏وأنا وحبي ننتظِرْ",58,"ر",1,1],["زخرفوا تلكمُ الطلاسم بالسمِّ","وثاروا على المعاني النبيلة",59,"ل",2,0],["زخارفُ الوشْيِ وألوانُهُ","تبراً من الجوهَرِ مَنشْوُراً",60,"ر",2,0]]}