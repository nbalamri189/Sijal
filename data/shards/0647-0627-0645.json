s://www.poetsgate.com/ViewPoem.aspx?id=190305",""],[5829,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=153128",""],[5830,"يَا صَاحِبَ الكَلِمَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=200769",""],[5879,"يا نبض القلب","https://www.poetsgate.com/ViewPoem.aspx?id=215451",""],[5879,"السودان","https://www.poetsgate.com/ViewPoem.aspx?id=215936",""],[5894,"هيف بدا في حسن مغناه","https://www.poetsgate.com/ViewPoem.aspx?id=131435",""],[5956,"النقود الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=184581",""],[5956,"الله بوَّأ فريد الأطرش وأختَهُ رتبةً أُولى","https://www.poetsgate.com/ViewPoem.aspx?id=203554",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5969,"أنثى من روحي أفديها","https://www.poetsgate.com/ViewPoem.aspx?id=198928",""],[5970,"منفي الأنام حياتهم","https://www.poetsgate.com/ViewPoem.aspx?id=130628",""],[5977,"يا راحلين","https://www.poetsgate.com/ViewPoem.aspx?id=212731",""],[5977,"سعادة وأمان","https://www.poetsgate.com/ViewPoem.aspx?id=212739",""],[5977,"القلب المعنّى","https://www.poetsgate.com/ViewPoem.aspx?id=215894",""],[5978,"آمال عجاف","https://www.poetsgate.com/ViewPoem.aspx?id=191287",""],[6004,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=33680",""],[6035,"متى أردتمُ رفعَ الثوب تَمْتَثِلُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177094",""],[6093,"هامَ قلبيْ فيهِ وجْدا","https://www.poetsgate.com/ViewPoem.aspx?id=176097",""],[6142,"لمن أذيل عقيق الأدمع السجم","https://www.poetsgate.com/ViewPoem.aspx?id=155760",""],[5309,"هام الجهول بجمع الماس والذهب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573880",""],[5309,"إن لم تعظنا الآي والسور","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573556",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[5957,"يا ملاكاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82581&r=&rc=123",""],[2588,"شاخصة ( على نسق)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65582&r=&rc=11",""]],"verses":[["هامَت بِكِ العَينُ لَم تَتبَع سِواكِ هَوىً","مَن عَلَّمَ البَينَ أَنَّ القَلبَ يَهواكِ",0,"ك",1,0],["هامَ الفُؤادُ بِذِكراها وَخامَرَهُ","مِنها عَلى عُدَواءِ الدَارِ تَسقيمُ",1,"م",1,0],["هام بالركن هائم","عدَّلوا فرط حزنه",2,"ه",1,1],["هامٌ وأرغفةٌ وضاءٌ فخمةٌ","قد أخرجا من جاحم فوار",3,"ر",1,0],["هامَت بِه وَهيَ لا تَدري لِشَوقَتِها","بِأَنَّها قَد أَحَبَّت أَرقَماً ذَكَرا",4,"ر",2,0],["هامَ في العَيْنِ غَرْبُهُ","وهَمَى ثمَّ أغْدَقا",5,"ق",2,0],["هام الفؤاد بشادن","ألف الدلال على المدى",6,"د",2,1],["هام الأنام وسادات الأنام بها","وحرّك العصر أعطافا كنشوان",7,"ن",1,0],["هامَت عَلى أَثَرِ اللَذّاتِ تَطلُبُها","وَالنَفسُ إِن يَدعُها داعي الصِبا تَهِمِ",8,"م",1,0],["هامَ الفِراشُ بِها وَحامَ كَتائِباً","يَحكي حَوالَيها الغَمامُ مُسَيَّرا",9,"ر",2,0],["هامَ الفُؤادُ بِأَعرابِيَّةٍ سَكَنَت","بَيتاً مِنَ القَلبِ لَم تَمدُد لَهُ طُنُبا",10,"ب",2,0],["هامته في الأرض منكوسة","ورجله في فلك النارِ",11,"ر",1,0],["هامِي المدامع أو يُصابَ بعينهِ","حامي الأضالعِ أو يموتَ بدائهِ",12,"ا",3,0],["هامَ وَلَم يَألَفِ البِلادَ وَإِن","قَرَّت بِتِلكَ البِلادِ عَيناهُ",13,"ا",2,0],["هامساتٍ بين أذني وفمي","ساريات غرِداتٍ في دمي",14,"ي",1,0],["هامَ لا همتَ من الغيد بمن","حُبّها عَذْبٌ وإن كان عذاب",15,"ب",1,0],["هامَ إِلى رِئمٍ هَضيمِ الحَشا","عَذبِ الثَنايا طَيِّبِ المَبسِمِ",16,"م",1,0],["هامَ صَغيراً في طِلابِ العُلا","حَتّى عَلَتهُ رِقَّةٌ وَاِصفِرار",17,"ر",1,0],["هامَ قَلبي بِفَتاةٍ غادَةٍ","حَولَها الأَسيافُ في أَيدي الحَرَس",18,"س",1,0],["هامَت رَكائِبُنا إِلَيكَ فَما","يَخبِطنَ أَهلَ النارِ وَالنَبحِ",19,"ح",1,0],["هامَ الهَوى بِمُتَيَّمٍ قَلِقٍ","في الصَبرِ قَد سُدَّت مَذاهِبُهُ",20,"ب",2,0],["هامَ قَلبي مِنهُنَّ يا اِبنَةَ مَسؤ","رٍ وَأَودى صَبري وَكُنتُ صَبورا",21,"ر",2,0],["هامَ قَلبي بِاللَواتي","هُنَّ دائي وَشَقاتي",22,"ت",2,1],["هامَتْ بلُحْفِ الجِنَانِ فاتَّخَذَت","مِن سُنْدُسٍ في جِنَانِهَا لُحُفَا",23,"ف",2,0],["هاموا كما هام القطي","عُ تخلفت عنه رِعاؤه",24,"ا",3,0],["هامت به وهي لا تدري لشقوتها","بأنّها قد أحبّت أرقما ذكرا",25,"ر",2,0],["هامهجتي اسودت اجل","وابيض مني الناظر",26,"ر",1,0],["هامجتي في الخفا ناداك قائلها","في حالة البعد روحي كنت أرسلها",27,"ه",2,0],["هامَ بِالهِمَّةِ الحَصانِ فُؤاداً","فَهوَ عاصي المَلامِ قاصي المَلالِ",28,"ل",1,0],["هامٍ يَشِفُّ البِشرُ عَن أَمواهِهِ","وَالغَيمُ يُحمَدُ أَن يَكونَ رُكاما",29,"م",2,0],["هاموا بحبك بعد ما انقذتهم","من كل محذور وكل وعيد",30,"د",1,0],["هام كُلٌّ بِعَيشِهِ وَالمَنايا","راصِداتٌ حَولَ النُفوسِ قِيامُ",31,"م",1,0],["هام الفؤاد بأَنْجُمٍ من حيث ما","بصرتُهن رأيتُهن أُفولا",32,"ل",2,0],["هامَ قَلبي لِما كَسَرنَ غُضارا","تِ سُروري مَغارِفُ الشَحناءِ",33,"ا",2,0],["هام قلبي بمعدن الحسن حتى","صار فيه معادنُ الوسواس",34,"س",1,0],["هامهجتي قد بعتكم لا ادعي","بالبيع فيه صفقة المغبون",35,"ن",1,0],["هامت بنا الأحلام","هامت بنا هامت",36,"ت",1,0],["هامِسَةً فيكِ اِذكُري حُبَّه","في كُلِّ لَيلٍ مَرَّةً واحِدَه",37,"ه",1,0],["هَامَتْ بِهِ زُمَرُ الأَنَامِ فَمَا لِمَنْ","أَصْمَتْهُ أَسْهُمُ لَحْظِهِ مِنْ رَاقِ",38,"ق",1,0],["هَامَتْ بِيُمناهُ تَبْغِي أَنْ تُقَبّلَها","وَاستَشْرَفَتْ تَجْتَلِي مَرْآهُ مُطَّلِعَهْ",39,"ع",2,0],["هَامَتْ بِهِ السَّبْعُ الشِّدادُ يَحِلُّها","وَتَنَافَسَتْ فيهِ الجِهَاتُ الأَرْبَعُ",40,"ع",1,0],["هامَهُم أبْقَتْ وَحَدَّهُمُ","رَهْنَ تَفْليقٍ وتَضْليلِ",41,"ل",1,0],["هَامَتْ بهِ الأحْداق لمّا نادَمت","منهُ الحَدائقُ ساقِيا لا يشربُ",42,"ب",1,0],["هام بالسحر بالجمال وروى النفس","من شهده وخمر دنانه",43,"ن",2,0],["هامَ المحبُّونَ وجداً فيك فاِنزَعجوا","وهمتُ فيكَ بِقَلبٍ غير مُنزَعجِ",44,"ج",1,0],["هامتْ بها نفسي لوصفِك حسنها","حتى كأنْ موهومها محسوسها",45,"س",3,0],["هاموا بِأَوصافِها بِالغَيبِ وَاِطَّرَحوا","عِندَ الشَهادَةِ مِعناها الَّذي وَصَفوا",46,"ف",3,0],["هامَ بِها بَنيَ الظَلامِ وَالضِيا","وَصَدَّ عَنها إِذا دَعَتهُ في الظُلَل",47,"ل",1,0],["هامَت بِها روحي جَوىً وَصَبابَةً","وَلَطالَما بِهَوايَ كانَ هيامُها",48,"م",3,0],["هامُ الملوكِ له النِّعا","لُ ومَفْرِقُ المُلْكِ المَمَرّ",49,"ر",1,0],["هامٌ لِبيضٍ أضحى يُتوِّجُها","مُلْكاً وهامٌ بالبيضِ يَفْطَؤها",50,"ا",3,0],["هَام قَلبي وأبى السُّق","مُ لجِسمي أن يَهيما",51,"م",2,0],["هامَ قَلبي ولَستُ أذكرُ مِن قَب","ل هَواهُ هَذا متَى كانَ هائِم",52,"م",1,0],["هامُهجتي فَلتَفعل الأَحداقُ ما","شاءَت بمَحمولٍ على الأَحداق",53,"ق",1,0],["هام فيه فأَمَّهُ","كلُّ فَدْمٍ تَفَيهقا",54,"ق",2,0],["ها مريمٌ مولودةٌ بعجيبةٍ","من عاقرٍ لم تدر ما طعمُ الولدْ",55,"د",1,1],["هامَ الفُؤادُ بِشَمسٍ ما يُزايلها","غَربٌ مِنَ البَينِ أَو غيمٌ مِنَ الكِلَلِ",56,"ل",1,0],["هامَ الفؤاد بِأَنجُمٍ مِن حَيث ما","أَبصَرتهنَّ رأَيتهنَّ أَفولا",57,"ل",2,0],["هامَ الفؤاد بهم وزادَ صبابةً","يا شدَّ ما يلقى من الهَيَمان",58,"ن",1,0],["هاموا على الكون من وجدٍ ومن طربٍ","وما استقَلَّ بهم ربعٌ ولا طلَلُ",59,"ل",1,0],["هام الفؤاد بافرنجيةٍ جمعت","شمل المحاسن في خلقٍ وفي خلقِ",60,"ق",1,1],["هامياً مثل عطايا ذي الثنا","من حكى البحر بفياض اليدين",61,"ن",1,0],["هام بالأم التي قد عقَّها","في ضلالٍ وغرورٍ وتعامى",62,"م",2,0],["هامي البَنانِ بسيفهِ ونوالهِ","من أبيضٍ عَذْبٍ وأحمرَ قانِ",63,"ن",1,0],["هامةُ الفارِسِ أوْ لَبَّتُهُ","شاكياً رُمْحِك والعَضْبِ الذكَر",64,"ر",1,0],["هامي الحيا يستخفُّ حبوتهُ","حتَّى كأنّ بهِ نوعاً من اللَّمم",65,"م",1,0],["هامت بطلعتهِ وهام بحسنها","يا خبيثة الواشي وعي العذَّل",66,"ل",1,0],["ها مُقلَتاكَ ، وَفي لألاءِ ضَوئِهِما","أرى أعَزَّ حُدودِ اللَّهِ تَنْكَشِفُ",67,"ف",1,0],["هامَ بهمْ فكلَّما عذلْتَهُ","في حبَّهمْ من الغرامِ لا يَعي",68,"ع",2,0],["هاموا جميعا وليسوا كلهم شعرا","فهم يهبمون من واد إلى واد",69,"د",1,0],["هامت الأملاك جمعا","بالحبيب مولاي محمد",70,"د",1,0],["هامت من الوجد على وجهها","فما لها في طورها من قرار",71,"ر",1,0],["هاموا بسيِّدِ حزبِ من أرسلتهم","فالكلُّ منهم هائمٌ متواجدُ",72,"د",1,0],["هاموا بحُبِّكَ فارْتاحَتْ عَزائمُهُمْ","وفي دَواوينِكَ العَليا قد احْتَبَكوا",73,"ك",3,0],["هامُوا بذكرِ اللهِ جلَّ جلالُهُ","وقُلوبُ أَصحابِ الجُحودِ هَواءُ",74,"ا",2,0],["هامَ الزّمانُ به حبّاً فأوشكَ أنْ","يعودَ شوقاً إلى رُؤياهُ ماضِيهِ",75,"ي",2,0],["هامَت بواديه القُلوبُ فأصبحتْ","منّا النّفوسُ تَسيحُ في ساحاتِهِ",76,"ت",2,0],["ها مقلتِي قد عَشِيت","مِن طُولِ سَكبِ عَبرتِي",77,"ي",1,0],["هامت بها في السوى كل القلوب ولم","تشعر وقد شغفت في حبها ولها",78,"ه",2,0],["هامٌ يُنادي مُثكَلٌ إَثكَالا","تَخالَهُ مُؤَبِّناً مُختالا",79,"ل",2,0],["هامَ الجَهولُ بدُنياهُ الغَرورِ وقد","شابت وشابَ فزادتْ نفسُهُ شَغفَا",80,"ف",2,0],["هام قلبي على السماع وأمسى","ذكرُها لذَّتي وفيه نعيمي",81,"م",2,0],["هامَت بِحبك يا أَمير مَراتبٌ","شرّفتها بِمَعارف تَشريفا",82,"ف",2,0],["هامَ في الرَوض كُلُّ غُصنٍ رَطيبِ","بِاِنعِطاف إِلى الأَمير المُهيبِ",83,"ب",1,1],["هام الحَشا بِبَديع حُسن أَغيدِ","أَبداً يَميس كَغُصن بانٍ أَميدِ",84,"د",1,1],["ها مُهْجَتِي فَهيَ فُلْكٌ رِيْحُهُ نَفَسِي","وبَحْرُهُ فَيْضُ دَمْعِي فَلْتَمطَّاهُ",85,"ا",2,0],["هامَ صَرْفُ الرَّدَى بِهَامِ الأعادِي","أنْ سَمَتْ نَحْوَهُمْ لها أَجْيَادُ",86,"د",1,0],["هام الفؤاد بمن لولا ملاحتها","ما سفّهت من ذوي الأحلام أحلام",87,"م",1,0],["هام الفؤاد بخيت الناس بحت بها","إذ في الكنايات تلبيس وابهام",87,"م",1,0],["هام قَلبي حَيثُ فيهِ عَلِقا","فازَ مَنْ في حبِّه وَجداً يَهيم",88,"م",1,0],["هامي الجفون فما ترقا مدامعهُ","صالي الضلوع فما تنفكّ في لهب",89,"ب",1,0],["هاماتُنا لِلمَجدِ يَر","سُو حينَ نُبدِعُهُ قَواعِدْ",90,"د",1,0],["هامي سحاب الراحتين لآملٍ","سامي منار المجد ذاكي المصّدِ",91,"د",1,0],["هامي المواهب ليس يسكن سيفه","في الروع إلا هامة الصنديدِ",92,"د",1,0],["هامي عزالي الجود أنت مسالما","ومحاربا ما زلت ضارب هامِ",93,"م",1,0],["هام تدر عليك أنعمه","عفوا لوم تبس لها ضرعا",94,"ع",2,0],["هَامَ الوِشَاحُ بِعِطْفِهَا ولطالمَا","غَنِيَتْ رَوَادِفُهَا بِخصرٍ مُمْلِقِ",95,"ق",1,0],["هاماً وَهاماً وَرِقاباً رُقْبا","وَلَيْسَ مَن أَمْسَى عَلَيْنا حِزْبا",96,"ب",2,0],["هام قلبي بهواه وافتتن","وهفا شوقاً اليه وصبا",97,"ب",2,0],["هام قلبي بحبه واصطفاه","دون كل الورى خطيباً وحيدا",98,"د",2,0],["هامَ في حبهم مذ فطما","مغرمٌ فيهم لقبض النفسِ",99,"س",1,0],["هامَ الشَّقيُّ بِغِيدِ الخِدْرِ يَفْضَحُها","وِهِمْتَ بالأُسْدِ تُدْميها عَواليكا",100,"ك",2,0],["هامعُ الجَدْبِ إِ ذا خَطْبٌ طرا","قاطعُ العَضْب إِذا خَطْبٌ طَغى",101,"غ",2,0],["هامي سَحاب نَوالِهِ","هَطّالِهِ سَحّاحِهِ",102,"ح"