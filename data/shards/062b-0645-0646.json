8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""]],"verses":[["ثُمَّ نَنسى جُرحَ الحِمامِ وَإِن كا","نَ رَغيباً يا قُربَ ذا النَسيانِ",0,"ن",1,0],["ثَمَنُ المَجدِ وَالمَحامِدِ غالي","آلُ زَغلولَ فَاِصبِروا لِلَيالي",1,"ل",2,1],["ثُمَّ نَزَلنا وَطَرَحنا الصَيدا","حَتّى عَدَدنا مِئَةً وَزَيدا",2,"د",2,0],["ثم نادوا إلى الصبوح فقامت","قَينة في يمينها إبريق",3,"ق",1,0],["ثُمَّ ناجَت نَفسَها قائِلَةً","أَتُرى أَبلُغُ مِنهُ وَطَرا",4,"ر",2,0],["ثُمَّ ناديتُ حينما طفحَ السِّحْرُ","بأَرجاءِ قلبيَ المبتولِ",5,"ل",1,0],["ثمَّ نَضَّدْتُ من أَزاهيرِ قلبي","باقةً لمْ يمسَّها أيُّ إنْسِي",6,"س",2,0],["ثم نمضي إلى الحدائق نجني","ما نلاقي من كل زهر محبب",7,"ب",1,0],["ثم نابت جزيرة","عندها عن جزيرة",8,"ه",1,0],["ثُمَّ نَحيا في عَلِيٍّ بَعدَنا","وَبِهِ نُبعَثُ أولى البِعثَتَين",9,"ن",1,0],["ثَمَنُ البِحارِ السَبعِ جودُ يَمينِهِ","وَجَبينُهُ لِلنَيِّرَينِ يُثَلِّثُ",10,"ث",1,0],["ثُمَّ ناهَضتَ في الغُلولِ رِجالاً","وَرِجالاً بِالضَربِ وَالتَحريقِ",11,"ق",1,0],["ثُمَّ نَبَّهتُ صاحِباً","طَيِّبَ الخيمِ وَالشِيَم",12,"م",1,0],["ثُمَّ نَبَّهتُها فَمَدَّت كَعاباً","طَفلَةً ما تُبينُ رَجعَ الكَلامِ",13,"م",1,1],["ثُمَّ نَضَت تَعثُرُ في","فَضلَةِ بُردٍ شَرِقِ",14,"ق",1,0],["ثَمنُ الحياةِ لِمَنْ يُريدُ شِراءَها","وافٍ ويحسبه الغبيُّ طفيفا",15,"ف",2,0],["ثُمَّ ناموا نَومَةَ الدَهرِ وَما","غَفَلَت عَنهُم عُيونُ المِحَنِ",16,"ن",1,0],["ثُمَّ نَبَّهتُها فَهَبَّت كَسُولاً","فاهَةً ما تُبِينُ رَجعَ الكَلامِ",17,"م",1,0],["ثُمَّ نَفى كُلَّ دَخيلٍ قَد مَرَق","إِذا رَأى السَيفَ قَضى مِنَ الفَرَق",18,"ق",1,0],["ثم ناداهُ بعدَما سِيمَتِ الخَس","فَ العُلا وَقَد يُنْجِدُ الغريقَ النِّداءُ",19,"ا",2,0],["ثُمَّ نَهاني المَهدِيُّ فَاِنصَرَفَت","نَفسي صَنيعَ الموفَّقِ اللَقِنِ",20,"ن",1,0],["ثُمَّ نَزَلنا وَكَسَّرنا الرِماحَ وَجَر","رَدنا صَفِيحاً كَسَتهُ الرومُ دَجّالا",21,"ل",2,0],["ثم نبتون وَهُوَ آخر مادا","ر عَلى الشمس من بنات الفضاء",22,"ا",2,0],["ثُمَّ نَوَّمْنَ ونِمْنَا سَاعَةً","خُشَّعَ الطَّرْفِ سُجُوداً في الخُطُمْ",23,"م",1,0],["ثم نادتْ يا أحبَّايَ انهضوا","واغنموا الليلةَ حتى منتهاها",24,"ا",3,0],["ثُمَّ نادُوا على الصَّبُوحِ فجاءَت","قَينَةٌ في يَمينِها إبرِيقُ",25,"ق",1,0],["ثمَّ نادَى ذو أمْرِهِمْ نحن في يو","مٍ سعيدِ الغُدُوِّ والآصال",26,"ل",1,0],["ثمن العلا والمجد ما","قدَّمتموه من أضَاح",27,"ح",1,0],["ثمّ نسى الحزن بالحزن ومن","يا ضياع الردّ ينسينا السؤال ..؟",28,"ل",1,0],["ثم نادت : يا أحبائي انهضوا","واغنموا اللّيلة حتّى منتهاها",29,"ا",3,0],["ثُمَّ نَاوي لِمَنطِقِ الكُتبِ آناً","كَى نَعاني بِهِ غَرِيبَ المَعاني",30,"ن",2,0],["ثمّ ناداهُم فقالَ وهل يس","مِعُ أهلَ القبور منه النداءُ",31,"ا",2,0],["ثم نلهو على الرمال كطفلين","ونهتز نشوة ومراحا",32,"ح",2,0],["ثمَّ نظرنَ نظرةً","معقودةً بالأجلِ",33,"ل",1,0],["ثَمَنَ الغارِ ما دَفَع","تَ دُموعاً وَلا دَما",34,"م",2,0],["ثَمَنَ الغارِ ما دَفَع","تَ دُموعاً وَلا تَعَب",34,"ب",1,0],["ثم نزلت مسرِعاً عن مُهْري","أقطعُ من أوصالها وأفري",35,"ر",2,0],["ثم نمضى عن الوجود ومن فيه","لنفنى في الانتهاء الثاني",36,"ن",2,0],["ثم ناما فوق صدر ال","بحر مدنون العباب",37,"ب",1,0],["ثم نغنى في الكون أقدس روحين","لنحيا في عالم السبحات",38,"ت",1,0],["ثُمَّ نَهَضتُ وَوَرَد","تُ الحَوضَ ذا الماءِ الخَضِر",39,"ر",1,0],["ثَم نادَتك كل علياء صلني","اِن من يحفظ المَوَدّة أَجرا",40,"ر",2,0],["ثُمَّ نِحتُم عَلَيه زورا وَلكِن","ذاكَ أَمر قَضى الاله نَفادَه",41,"د",2,0],["ثم نكسى ونحظى بالصفات السنيه","ثم نستقي شراب القوم شربه هنيه",42,"ي",2,0],["ثم نفع اليدين يقصر عنه","كل عدّ تراه في كلماتك",43,"ك",1,0],["ثُمَّ نادِ الأَذواءَ عن ذِي الرياسا","تِ نداءً يُصغِي لَهُ كُلُّ نادِ",44,"د",1,0],["ثم نقل خطاك في وادي العي","نين وانظر مسارح الغزلان",45,"ن",1,0],["ثم نادى بفصيح الكلام","إي ورب العرش هذا الرجيم",46,"م",1,0],["ثمِّنْ بها الأرباحَ فهي بضاعةٌ","مازلتُ أذخَرُه لعلقٍ مثمَنِ",47,"ن",1,0],["ثَمَناً لودِّك إن يكن ثَمناً له","بذلُ القو