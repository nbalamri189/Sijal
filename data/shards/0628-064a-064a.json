{"poems":[[111,"هزت العالم أدوار البشر","https://www.poetsgate.com/ViewPoem.aspx?id=105",""],[102,"صياد البروق","https://www.poetsgate.com/ViewPoem.aspx?id=50408",""],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[203,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[408,"أنا غيظ كل مناصب","https://www.aldiwan.net/poem46976.html","مجزوء الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36315","الدوبيت"],[4908,"كومة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=207314",""],[5277,"هجاءُ البدر","https://www.poetsgate.com/ViewPoem.aspx?id=192282",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5563,"مدعوجة العينين ( نبطية )","https://www.poetsgate.com/ViewPoem.aspx?id=212820",""]],"verses":[["بيئة مخلصة صادقة","لم يدنسها رياء واشر",0,"ر",1,0],["بي يرفلون ليحفروا","بيدي في فخذيّ لحدي",1,"د",2,0],["بي يا وَقاك اللَهُ كُلّ مُلمَةٍ","أَمسى بِها جِلدي كَجَرفٍ هائرِ",2,"ر",1,0],["بئيسٌ على ما كان مكتئب لما","يكون بصدر واهن الصبر ضائق",3,"ق",1,0],["بي يَهتَدي بي يقْتَدي","الثقلانِ من إنسٍ وجان",4,"ن",1,0],["بي يا ساقي الطلا ابدأ أولا","وبي اختم دورها من قرقف",5,"ف",1,1],["بي يَختُمُ أَنجمَ المَعاني صُبحي","لا كَوكَبَ بَعدَ كَوكَب الإِصباحِ",6,"ح",1,0],["بِي يُتِمُ أَبْنَاء منْ مَاتُوا عَلَى جَسَدِي","وَكَابَدَوا اللَّيْلَ بَيْنَ الحُزْنِ وَالأَرَقِ",7,"ق",1,0],["بئيس الوصلِ يشربُ من حرامٍ","ونفحُ الطيبِ بالحضن الحلالِ",8,"ل",1,0],["بئيسٌ قويٌ في الشجاعةِ مغْنَمي","جسورٌ وصنديدٌ أُصَاحِبُ عاتيا",9,"ي",2,0],["بي يضيق الكون لا منّك تعبتي","ليت نفسي دون نفسك عن نكدها",10,"د",3,0]]}