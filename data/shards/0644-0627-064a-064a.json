{"poems":[[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[72,"لا ييأسن من الجراية معسر","https://www.aldiwan.net/poem19049.html","الكامل"],[45,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[69,"لا ييئسن مخلط","https://www.aldiwan.net/poem28028.html","مجزوء الرجز"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[46,"الناس بالأقدار نالوا كل ما","https://www.aldiwan.net/poem22722.html","الكامل"],[195,"حتى رأى الناظر الشعرى مبينة","https://www.aldiwan.net/poem54351.html","البسيط"],[562,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"]],"verses":[["لا ئيء أجمل من مجملةٍ إذا","صدقت وجاءت من وفيٍّ شاكر",0,"ر",1,0],["لا ييأسنَّ من الجراية معسر","أودى بمحضر حاله الإفلاس",1,"س",1,1],["لا يَيأَسَ المَرءُ أَن يُنَجِّيَهُ","ما يَحسِبُ الناسُ أَنَّهُ عَطَبُه",2,"ب",2,0],["لا ييئسَن مخلِّطٌ","مِنْ رحمةِ اللهِ العفو",3,"و",1,1],["لا ييأَسَنَّ من الفِكاكِ على المَدى","شعبٌ رهينُ أداهمٍ وكُبولِ",4,"ل",1,0],["لا يَيأَسَنَّ مِنَ الثَوابِ مُراقِبٌ","لِلَّهِ في الإيرادِ وَالإِصدارِ",5,"ر",1,0],["لا ييأسُ اللَّيلُ مِنها حينَ يَتبَعُهُ","ولا النَّهَارُ بِهَا لِلَّيلِ يَعتَرِفُ",6,"ف",1,0],["لا يَيْأسَنَّ مريضٌ من سَلامِتهِ","ما دامَ في جِسمهِ شيءٌ من الرَّمَقِ",7,"ق",1,0]]}