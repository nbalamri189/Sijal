مل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109279","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77414","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102555","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205438","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100213","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202589","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101609","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65197","الكامل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124097","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97891","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125939","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117855","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133259","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86400","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72441","المتقارب"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4778,"رسول السماء","https://www.poetsgate.com/ViewPoem.aspx?id=200413",""],[1012,"الحكمة الفلسفية","https://www.poetsgate.com/ViewPoem.aspx?id=186331",""],[1536,"أَصْبَحَ الْمُلْكُ عالياً بأَبي الْعَب","https://www.poetsgate.com/ViewPoem.aspx?id=85704",""],[3271,"مرثية غصن الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=103533",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""],[5183,"المصلى","https://www.poetsgate.com/ViewPoem.aspx?id=180159",""],[5183,"الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=180193",""],[5183,"إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=180188",""],[5284,"غيث الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=191798",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5447,"طعام القلب","https://www.poetsgate.com/ViewPoem.aspx?id=208339",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[402,"أيها النائمون في الشرق من خفض","https://www.poetsgate.com/ViewPoem.aspx?id=36256",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5956,"غرام رغم النّوى","https://www.poetsgate.com/ViewPoem.aspx?id=185527",""],[5956,"شهقتُ وقد جاءت إليّ رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=193803",""],[520,"هل لميعادك الكريم تمام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577695",""],[402,"يا مصر لو تقدر الأقدار بالكرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54084&r=&rc=936",""]],"verses":[["وغذَّته للعلياء قبلَ لبانهِ","لباناً لها من مثله مخضَ الزُّبدُ",0,"د",1,0],["وَغَذاءَ الجيلِ فَالجيلِ وَإِن","نَسِيَ الأَجيالُ كَالطِفلِ اللِبانا",1,"ن",2,0],["وغذاها من أمانينا ومن","حبنا الشهدَ المصفى وسقاهَا",2,"ا",3,0],["وَغَذا إِذ بَدَت لَهُ الشَمسُ يَجتا","بُ كَثيباً خَلا لَهُ عَقِدُه",3,"د",2,0],["وَغَذا الثَورُ يَعسِفُ البيدَ لا يَك","تَنُّ مِن جَريِهِ وَيَجتَهِدُه",3,"د",2,0],["وَغَذوْتَهُ وَكسَوْتَهُ وَأَسَوْتَهُ","وَكَفَيْتهُ عِلَلَ المَرِيضِ المُعْسِرِ",4,"ر",1,0],["وَغَذَتْ بِالمَعارِفِ طَالبِيهَا","فَأَخْرَجَتِ العَلِيمَ مِنَ الْجَهُولِ",5,"ل",1,0],["وَغَذَوْنَاه طَيِّباً بجُهودٍ","ضاعَفَتْ مِن ثِمَارِهِ الطَّيِّباتِ",6,"ت",1,0],["وغذتنا تآخينا كان أبقى","من ربى ريفها ووهج العواصم",7,"م",1,0],["وغذاها من أمانينا ومِن","حبنا الشهدَ المصفى وصقاهَا",8,"ا",3,0],["وغذا أسدلت ذوائبها السو","د حسبت الفجر المينر تستر",9,"ر",1,0],["وغذا ما نشا الضرير خليّا","من قضا فهو من فضال الزمان",10,"ن",1,0],["وغذا بدا سببُ النوى دون الهوى","عرفَ اللبيبُ بضعف رأي الأحمقِ",11,"ق",1,0],["وغذا البغانيش انتقاهم دورهم","وأقل كنت المطبق الجمّاعا",12,"ع",2,0],["وغذا الصديق هفا غفرت ذنوبه","وصرفت عنه الغل والحقدا",13,"د",2,0],["وَغَذتهُ بدرّها اليومَ حتّى","قالَ هذا الطعامُ هذا الشفاءُ",14,"ا",2,0],["وغذائي المسلوقُ في كلّ يومٍ","لا من اللحم بل من القلقاسِ",15,"س",1,0],["وغذوتني الدَّر الضريح وحبَّذا","در السماح إذا استهل نداه",16,"ا",2,0],["وغذا بالزهور تعبق بالنش","ر الذكي فتنتشي الأرجاء",17,"ا",2,0],["وغذا بنت لك مضجعا في صدرها","فذخيرة تهدى إلى أجيالها",18,"ل",3,0],["وغذتنا فجرد القدُّ رمحاً","سمهريّا واشهر الطرف نصلا",19,"ل",2,0],["وغذا ما صحبت فاصحب كريما","ذا سماحٍ وجانب الشريرا",20,"ر",2,0],["وغذا ما امتطى جوادا طمّراً","يوم حرب رأيت ليثا هصورا",20,"ر",2,0],["وغذا حاول الورى الفكر في جد","وى يديه تقصّر الأفهام",21,"م",1,0],["وغذا كنت في سرور وحظّ","حسدت عيدنا بك الأعياد",22,"د",1,0],["وغذا أناخ بنا السكون حسبته","ضوضاء من قلق ومن إنذار",23,"ر",1,0],["وغذا الحياة وقد رشفت نعيمها","ليست سواك بخاطري ودعائي",24,"ي",1,0],["وغذ نجت من أذى الطاغوت ظافرة","بعزها كنت ربانا يراعيها",25,"ي",3,0],["وغذا صلّت السيوف فللهام","سجودٌ لهنَّ كان إماماً",26,"م",2,0],["وغذا النهى بمجلة وجريدة","أَمرا غذاؤهما الشهيُّ الوفا",27,"ف",2,0],["وغذا جزعتَ وأنتَ أجلدُ سيِّدٍ","قَلباً جَزِعنَ النِّسوةُ الخَفِرات",28,"ت",1,0],["وغَذَتهُ الأيامُ فَهوَ أنابي","ب طوال على جفانٍ قِصارِ",29,"ر",1,0],["وغذا يهز لدى العجاج قناته","نفذت بكل مقدر في سرده",30,"د",2,0],["وغذي ألبان الفضائل راضعاً","ونيطت عليه قبل شد التمائم",31,"م",1,0],["وغذا سمعوا الصريخ تواثبوا","ما بين سافع مهره أو ملجم",32,"م",1,0],["وغذا خفضت فخفض","دنيا بالاضافة قد سكنْ",33,"ن",1,0],["وغذا عدت للمنازل فاشرح","قصة الصب واحذر التطعويلا",34,"ل",2,0],["وغذا حللت بمنزل بغنائه","أنخ المطيّ وقف بباب المربع",35,"ع",1,0],["وَغذا هامهمُ في","ذلكَ أفراخ هامِ",36,"م",1,0],["وغذاءُ جسمي من سماحِ يمينِهِ","وغذاءُ روحي من بدائعِ نظمِهِ",37,"م",2,0],["وَغَذتهُ أَبكارُ المَعالي دَرَّها","فَبَنى لَها بَيتاً بِهامِ الفَرقَدِ",38,"د",1,0],["وَغذا روحي غَريم","حبذا ذاكَ الغَريم",39,"م",1,0],["وَغَذا وَربي واجتنى","وَأَفاض عقلاً للفهم",40,"م",1,0],["وغذوته لبنا لطيفا باردا","في الصيف سخناً في الشتا متجانسا",41,"س",2,0],["وغذا الدعاوى لم تقم بدليلها","في العقل فهي على السفاه دليل",42,"ل",1,0],["وغذا رجوت وفاء وعدي لم أكن","إلا بتهنئة القبول حجابا",43,"ب",2,0],["وغذا كانت النفوس كباراً","لم يخف أهلها عناء الجسوم",44,"م",1,0],["وغذاه ماء النيل من صفواته","كرم الملوك ونجدة الصعلوك",45,"ك",1,0],["وغذا تخاطرت الفحول وأُفلِجت","خطباؤها فهو المُبين المِصقع",46,"ع",1,0],["وغذَته المجدَ الذي ورِثته","عن كرام الآباء والأمهات",47,"ت",1,0],["وغذا في ألأواء جف كرام","سح في الجود مدّة اللأواء",48,"ا",2,0],["وغذا نَظَرتِ تكشَّفَت لُغَةُ الهَوى","عن سحرٍ مَعنىً أذهَلَ الأذهانا",49,"ن",2,0],["وَغَذَا الفُرَاتُ يَقُولُ إنِّي أنَا كَمَنْ","حَاوِي العُلاَ البَاشَا عَلِيُّ كَفيلُهُ",50,"ل",2,0],["وغذا المسافلر والمريض تجرعا","فيه زُعافَ الموتِ والحشرِ",51,"ر",1,0],["وغذاك من قد غدا للورى","إماماً عليماً وغيثاً هطولا",52,"ل",2,0],["وغذا بدا أثر الحبيب فاعيني","تبدي من العبرات صوب عهاد",53,"د",1,0],["وغذوا بها أبناءكم لحياتهم","فما عاش ميت الجهل مهما يطل عمرا",54,"ر",2,0],["وَغَذَوتُهُ رخصَ اليَدَينِ وَعُلتُهُ","وَصَنَعتُ أَكرَمَ حانٍ والِدِ",55,"د",1,0],["وغذى بألبان المعارف والنهى","وحظي بنيل الواردات السرمدي",56,"د",2,0],["وغذا ما انتهت إليك فصلها","وافتضض ختمها بجبر انكساري",57,"ر",2,0],["وغذاني ثراك فاشتد غرسي","وصفا موردي وطاب قراري",58,"ر",2,0],["وغذا استمالك من هواي مؤنب","لم يستملني عن هواك مؤنب",59,"ب",1,0],["وغذا تأملت الملاحة خلتها","لجّاً به يطفو المحب ويرسب",59,"ب",1,0],["وغذّيت قرّائي بشعرٍ مفخّمٍ","فهل غزل يأتي لترويح قرّائي",60,"ي",1,0],["وَغِذاءه الصرف الحَلال وَغَيره","لَم يَدر بَين حَرامه وَحَلاله",61,"ل",2,0],["وغذا كنت مالكاً أمر روحي","مثلما أنت مالكٌ أمر نبضي",62,"ض",2,0],["وغذا يُنوّرُ لي السّراج وما درى","أنّ السّراج بوجهه يتلهّبُ",63,"ب",1,0],["وغذا يغادر منفق 