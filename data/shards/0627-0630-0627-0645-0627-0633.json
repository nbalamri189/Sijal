ل عزٍ لو يحل ابن مزنةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181358",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[463,"نعمْ منجميلة َ إحدى النِّعمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60321&r=&rc=377",""],[4222,"أجيران جيرون مالي مجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52786&r=&rc=78",""]],"verses":[["إِذا ما سَروا تَحتَ الدُجى فَوُجوهُهُم","لِضَوءِ الضُحى قَبلَ الصَباحِ طَلائِعُ",0,"ع",1,0],["إِذا ما ساَمَهُ اللؤَماءُ ضَيْماً","تَمَرَّغَ في الأذى ظَهْراً لِبَطْنِ",1,"ن",1,0],["إذا ما سَرى بَرْقٌ وقد هَبّتِ الصَّبا","كَلِفْتُ بذِكْرى أكْحَلِ العَيْنِ أدْعَجِ",2,"ج",1,0],["إذا ما سارَقوكَ اللّحْظَ أدْنَتْ","مَسافَتَهُ المُهَنّدَةُ الحِدادُ",3,"د",1,0],["إذا ما سأَلْتَ الحيَّ عنْ خَيْرِهِمْ أباً","أشارَتْ نِساءٌ نحوَهُ ورِجالُ",4,"ل",1,0],["إذا ما سَرَتْ لمْ يُمكِن القُلْبَ مَنطِقٌ","ولا حاوَلَ الخَلْخالُ أنْ يتكلَّما",5,"م",2,0],["إذا ما سَرى فاللّيْلُ بالبِيضِ مُقْمِرٌ","ولَوْنُ الضُّحى إن سارَ بالنّقْعِ حائِلُ",6,"ل",1,0],["إذا ما سِراجُ اليَومِ أطْفأَهُ الدُّجى","مَشى كَنَزيفِ القَومِ رنَّحَهُ السُّكْرُ",7,"ر",1,0],["إِذَا مَا سَرَحْتَ اللَّحْظَ فِي عَرَصَاتِهَا","تَبلَّدَ مِنْكَ الذِّهْنُ فِي الْعَالِمِ الثَّانِي",8,"ن",2,0],["إِذَا مَا سَرَى لَيْلاً فَبِالنَّجْمِ يَهْتَدِي","وَمَهْمَا انْتَمَى يَوْمَاً فَلِلْبَرْقِ يَنْتَمِي",9,"م",2,0],["إِذا ما سَمِعنَ الزَجرَ يَمَّمنَ مُقدَماً","عَلَيها أُسودُ الزارَتَينِ الضَراغِمُ",10,"م",1,0],["إِذا ما سارَ نَحوَ بِلادِ قَومٍ","أَزارَهُمُ المَنِيَّةُ وَالحِماما",11,"م",2,0],["إِذَا مَا سَكَبْتِ طَهُورَ النَّدَى","أَلِمِّي بِبَاحِثَةِ البَادِيَهْ",12,"د",3,0],["إذا ما سمعتُ الهند في قول قائل","تخيّلت فيلاً بالحديد مكبّلا",13,"ل",2,0],["إذا ما سمائي جاد بالذُلّ غَيْثها","أبَيْت عليها أن تكون سمائيا",14,"ي",2,0],["إذا ما سقيتم بالعطا نباتكم","توالت ثمارٌ من نداه وأوراق",15,"ق",1,0],["إذا ماسَتْ ذوائبُها تداعت","بواكي الطير فيها بانتحابِ",16,"ب",1,0],["إذا ما سَلَكْتُمْ في الصُّدورِ صُدُورَهَا","تَقَصَّدُ فيها عن دماءٍ تَفَصَّدُ",17,"د",1,0],["إِذا ما سِراعُ القَومِ كانوا كَأَنَّهُم","قَوافِلُ خَيلٍ جَريُها وَاِقوِرارُها",18,"ر",3,0],["إِذا مَا سَقاكَ الدَّهرُ من كأْسِهِ التي","قُرَارَتُها صابٌ مَريرٌ وعَلْقَمُ",19,"م",1,0],["إِذا ما سيلَتِ الأَرواحُ فيهِ","بَذَلناها كَأَن لَم نُعطِ شَيّا",20,"ي",2,0],["إِذا ما سِرتَ في آثارِ قَومٍ","تَخاذَلَتِ الجَماجِمُ وَالرِقابُ",21,"ب",1,0],["إِذا ماسَت رَأَيتَ لَها اِرتِجاجاً","لَهُ لَولا سَواعِدُها نَزوعا",22,"ع",2,0],["إِذا ما سَدَدنا بِالهَشيمِ فُروجَها","رَأى كُلُّ سارٍ ضَوءَها غَيرَ مُخمَدِ",23,"د",1,0],["إِذا ما سَقوها السَمنَ أَقبَلَ وَجهُها","بِعَينَي عَجوزٍ مِن عُرَينَةَ أَو عُكلِ",24,"ل",1,0],["إِذا ما سارَ في أَرضٍ تَراها","مُظَلَّلَةً عَلَيهِ مِنَ الغَمامِ",25,"م",1,0],["إذا ما سَابقَ الأَكفاءَ يَوماً","إلى الغاياتِ خَلَّفَهم رَزايا",26,"ا",3,0],["إذا ما سَقَتْ يُمْنَاهُ رَيّاً وقُبِّلَتْ","توَهَّمْتَ يُمناه الحطيمَ وزَمزَما",27,"م",2,0],["إذا ما سَقْتَهُنَّ السَّحائبُ شُربةً","خلَطْنَ بماءِ البَحرِ ماءَ السَّحائبِ",28,"ب",1,0],["إِذا ما سَمِعنا صارِخاً مَعَجَت بِنا","إِلى صَوتِهِ وُرقُ المَراكِلِ ضُمَّرُ",29,"ر",1,0],["إِذا ما سَأَلتَ المَرءَ هُنتَ عَلَيهِ","يَراكَ حَقيراً مَن رَغِبتَ إِلَيهِ",30,"ي",2,1],["إِذا ما سَخِطتَ الشَيءَ كانَ مُسَخَّطاً","وَإِن تَرضَ شَيئاً كانَ في الناسِ مَرضِيّا",31,"ي",2,0],["إِذا ما سابَقَتها الريحُ فَرَّت","وَأَبقَت في يَدِ الريحِ التَرابا",32,"ب",2,0],["إِذا ما سَبَت","بِسَناها الكُؤوسا",33,"س",2,0],["إذا ما سَطَوْا سرّوا بكفّ شذَاتِهمْ","وإن حاربوا جرّوا ذيولَ الجحافِلِ",34,"ل",1,0],["إذا ما ساقَ قُسطنطينُ جيشاً","رَمى الغازي فساق له المَنونا",35,"ن",2,0],["إِذا ما سَرى نَفَسي في الشِراعِ","أَعادَهُمُ نَحوَ حِمصٍ زَفيري",36,"ر",2,0],["إِذا ما سَفَرنَ وَإِمّا اِختَبَي","نَ أَبصَرتُ مِن ضَوئِهِنَّ الشَعاعا",37,"ع",2,0],["إِذا ما سَقى اللَهُ البَساتينَ كُلَّها","سَجالَ سَحابٍ دائِمِ الوَكفِ مُنسَكِب",38,"ب",1,1],["إذا ما سألتُ اللّهَ غيرَ بقائكُمْ","فلا بؤتُ بالإخلاصِ في السرِّ والجَهر",39,"ر",1,0],["إِذا ما سَفيحٌ راحَ في المُلكِ وَاِغتَدى","جَرَت ذَهَباً كَفّاهُ لِلقَومِ أَو جَدّا",40,"د",2,0],["إِذا ما سامَني الخُلَطاءُ خَسفاً","أَبَيتُ وَرُبَّما نَفَعَ الإِباءُ",41,"ا",2,0],["إِذا ما سَأَلنا عَن مُرادِ إِلَهِنا","كَنى عَن بَيانٍ في الإِجابَةِ كاني",42,"ي",1,0],["إِذا ما سَوءَةٌ غَرَّاءُ ماتَت","أَتَيتَ بسَوءَةٍ أُخرى بهيمِ",43,"م",1,0],["إذا ما سقسق العصفو","رُ في أعشاشِهِ الغُنِّ",44,"ن",1,0],["إِذا ما سُلَّ سالَ دَماً نَجيعاً","وَيَخرُقُ حَدُّهُ صُمَّ الجِبالِ",45,"ل",1,0],["إِذا مَا سَاءَتِ الأُولَى","عَسَى أَنْ تُحْسنَ الأُخْرَى",46,"ر",2,0],["إِذَا مَا سَبِيلُ اللهِ كَانَتْ سَبِيلَهُ","فَمَا فِي سَبِيلِ اللهِ حِرْصٌ وَلاَ بُخْلُ",47,"ل",1,0],["إِذَا مَا سِيمَتِ الذِّكْرَى وَبِيعَتْ","فَوَيْلٌ لِلْمَمَالِكِ والشُّعُوبِ",48,"ب",1,0],["إذا ما سرى الوسمي في شبح الثرى","تمخضت الأكوان مفتوقة الرتق",49,"ق",1,0],["إذا ما سلكتَ بها منهجا","وثبتَ الجبالَ وجُبت الحُزونا",50,"ن",2,0],["إِذا ما سَماءُ المَجدِ لَم يَهوِ بَدرُها","فَأَهوِن بِأَن تَنقَضَّ مِنها الكَواكِبُ",51,"ب",1,0],["إذا ما سددنا من فتى باب مطمع","أتانا بابواب تجل عن السد",52,"د",1,0],["إذا ما سار جيشك نحو أرض","أتت فيه الملائك سائرات",53,"ت",1,0],["إِذا ما سارَ تَحتَ السِترِ أَنسى","جَلالَة قَيصَرٍ وَالهُرمُزانِ",54,"ن",1,0],["إذا ما سل صارمه لحربٍ","أراك البرق في كف السحاب",55,"ب",1,0],["إِذا ما سُهَيلٌ أَبرَزتهُ غَمَامَةٌ","عَلَى مَنكِبٍ مِن جانِبِ الطُّورِ يَلمَحُ",56,"ح",1,1],["إذا ما سمته الوصل","بلا بر ولا رفد",57,"د",1,0],["إذا ما سهرنا لما نابنا","فما للنجومِ وما للسهرْ",58,"ر",1,0],["إذا ما سَهِدَ القلبُ","فإن القلبَ يستعدي",59,"د",2,0],["إذا ما سكبت الروح أرجو لقاءها","تراعد أملاك هناك وسكان",60,"ن",1,0],["إذا ما سعى والخلقُ تَتْبَعُ أثرَهُ","تضيقُ بها الأقفار والسهل والوعر",61,"ر",1,0],["إذا ما سعى والخلق تحت ركابِه","يسحّ لهم منه جمان ولائد",62,"د",1,0],["إِذَا مَا سَادَةٌ وَلَدَتْ أَبَاهَا","تَكَمَّلَ مَجْدُهَا وَسَمَا سُمَاهَا",63,"ا",3,0],["إذا ما سفيهٌ نالني منه قادِحٌ","من الذمّ لم يُحرِج بموقِفه صَدري",64,"ر",2,0],["اذا ماستا زهوا تميلان عن نقا","يجاذبه غصنان هزهما الزهو",65,"و",1,0],["إذا ما سألت القطر ثم سألته","توهمت ان القطر بسألك القطرا",66,"ر",2,0],["إذا ما سما أو بدا أو رنا","سبا البد