=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["إِذ يَلتَقي كُلُّ ذي دَينٍ وَماطِلَهُ","مِنّا وَيَجتَمِعُ المَشكوُّ وَالشاكي",0,"ك",2,0],["أُذيلُ لذكْراكُنَّ دَمْعِي وفي الحَشَى","هَوىً لِسَيالاتٍ بِكُنَّ مَصونُ",1,"ن",1,0],["إِذ يَتَّقونَ بِيَ الأَسِنَّةَ لَم أَخِم","عَنها وَلَكِنّي تَضايَقَ مُقدَمي",2,"م",2,0],["أَذيقونا الرَجاءَ فَقَد ظَمِئنا","بِعَهدِ المُصلِحينَ إِلى الوُرودِ",3,"د",1,0],["إذي جري ذكروا","تقول من الأشواق",4,"ق",1,0],["أذيالُهُ في حمده","مسكِيَّةُ الأنفاسِ",5,"س",1,0],["أذيل ماء جفوني بعدهُ أسفاً","لماء وجهي الذي قد كانَ يحميه",6,"ي",2,0],["إِذ يَنظُرونَ وَهُم يَجنونَ حَنظَلَهُم","إِلى الزَوابي فَقُلنا بُعدَ ما نَظَروا",7,"ر",3,0],["إِذ يَميني لِلبَذل يَومَ العَطايا","ولقبض الأَرواحِ يَومَ الكِفاحِ",8,"ح",1,0],["أُذيعُ جَدواكَ أَم أَكونُ كَمَن","يَكتُمُ شُؤبوبُها وَوابِلَها",9,"ل",3,0],["أَذى الجِسمِ شُربُ الراحِ قَبلَ اِغتِذائِهِ","وَلِلنَفسِ مِنهُ غايَةُ القَبضِ وَالثَقلِ",10,"ل",1,1],["أُذيقوا به حصراً أذلّ عرامهم","كما ضاق عِندَ المَوتِ عن نَفَسٍ صدرُ",11,"ر",1,0],["إِذ يَرى قَومَهُ أَعَزَّ وَأَعلى","وَحَياةَ البِلادِ فَوقَ حَياتِهْ",12,"ت",2,0],["آذَيتُمونا مُدمِنينَ فَجَرِّبوا","عُقبى الأَذى وَمَغَبَّةَ الإِدمانِ",13,"ن",1,0],["أَذىً ما لِلمَمالِكِ مِنهُ واقٍ","وَلا لبَني المَمالِكِ مِن مَفَرِّ",14,"ر",1,0],["إذ يَقُولُ اللَّهُ في عليائِهِ","لرسولِ اللَّهِ سَدِّدْ وارشُقِ",15,"ق",1,0],["آذى رسولَ اللهِ في مالهِ","وآثرَ الغدرَ ولم يحفِلِ",16,"ل",1,0],["إذ يقول النبيُّ لا تضربِ الشي","خَ وإن سبّني ودعه قريرا",17,"ر",2,0],["إِذ يَسَفّونَ بِالدَقيقِ وَكانوا","قَبلُ لا يَأكُلونَ شَيئاً فَطيرا",18,"ر",2,0],["إِذ يَرسِمانِ خِلالَ الجَيشِ مُحكَمَةً","أَرباقُ أَسرِهِما في مُحكَمِ ا لقِدَدِ",19,"د",1,0],["أُذيبُ عَن أَحسابِ قَحطانَ إِنَّني","أَنا اِبنُ بَني بِطحائِها حَيثُ حَلَّتِ",20,"ت",1,0],["أَذِئبُ القَفرِ أَم ذِئبٌ أَنيسٌ","أَصابَ البَكرَ أَم حَدَثُ اللَيالي",21,"ي",1,1],["إِذْ يَنْظُرُونَ وَهمْ لا يُبْصِرونَهُما","كَأَنَّ أَبصارَهمْ مِنْ زَيْغِهَا حُولُ",22,"ل",1,0],["إذ يتّقونَ حَرُورَ الشمس عن مُقَلٍ","مُغْرَوْرِقاتِ المآقي والأناسيّ",23,"ي",1,0],["إِذ يَنطوي كَعَهدِهِ مَذكورُ","باَنَت سُلَيمى فَمَتى الكُرورُ",24,"ر",1,0],["أَذىً مِنَ الدَهرِ مَشفوعٌ لَنا بِأَذىً","هَذا المَحَلُّ بِما تَخشاهُ مِربابُ",25,"ب",1,0],["أَذيتَ مِنَ الَّذينَ تَعُدُّ أَهلاً","وَجَنبَكَ الأَذاةَ الأَجنَبِيُّ",26,"ب",2,0],["إِذ يَشزِرونَ إِلَيَّ الظَرفَ عَن عُرُضٍ","كَأَنَّ أَعيُنَهُم مِن بُغضِهِم عورُ",27,"ر",1,0],["أذيقاهُ ما شئتما واغرسا","به الشرَّ ملتهباً مُرْمِضا",28,"ض",2,0],["إذ يرى فوقَ منكبٍ منه عاري","وصمةَ الذلّ صوّرَت بالنار",29,"ر",1,0],["إِذْ يَطْعَمُ الفَمُ فِيهِ أَشْهَى مَطْعمٍ","وَالعَيْنُ تَنْظُرُ فِيهِ أَبْهى مَنْظَرِ",30,"ر",1,0],["إِذْ يَخِفُّ الجِسْمُ مِنْ بُعْدٍ","فَيَبْدُو كَالخَيَالْ",31,"ل",1,0],["إِذْ يَعْلَمُونَ أَنَّنِي","صَاحِبُ هَذَا المُبْتَكَرْ",32,"ر",1,0],["إِذْ يُرَى قَاسِياً عَلَى المُسْتَبِدِّي","نَ فَمَا فِيهِ مَوْضِعٌ لِلِّينِ",33,"ن",1,0],["إذْ يُطرَحُونَ من سَنَمِ الطَّيْ","رِ تَرْقَّى لِقُنَّةِ الجَبَلِ",34,"ل",1,0],["إذْ يَهْتَدُونَ بجَعْفَرٍ وَلِوَائِهِ","قُدَّامَ أَوَّلِهِمْ فِنِعْمَ الأوَّلُ",35,"ل",1,0],["أذيّةٌ في جهاد نِلتَها طرباً","وهل جهادٌ بلا مسٍّ وإيذاء",36,"ا",2,0],["إذ يضمُّ القلبُ الجناحَ فترتدّ","الخوافي مهيضةً والقوادِم",37,"م",1,0],["إذ يحار الراؤون في حُسنك الفتّانِ","بل في ثيابك الفَتّانه",38,"ن",2,0],["إذ يقال: اتئب، ردت صبابته","إليه ثابت وجد ليس يتئب",39,"ب",1,0],["إذ يتاني الرسولُ منك بأمرٍ","يشبهُ الموتَ نفسَه أو رسوله",40,"ل",2,0],["آذى قواي وها اذيته","تسري له من حيث لا يدري",41,"ر",2,0],["أَذى الفَتَكاتِ اللائي لَو لَم تَبُح بِها","نِفوسُ العِدى ما اِلتَذَّ بِالماءِ شارِبُ",42,"ب",1,0],["إِذ يَستحيلُ على خلّاقِنا جهةٌ","وَالمُستحيلُ محالٌ أَن ندين بهِ",43,"ب",2,0],["إِذ يَرَونَ الهولَ هولاً أعظَما","يَستَوي المُحسنُ فيهِ والمُسي",44,"ي",1,0],["إِذ يُرى للَّه عبداً ساجدا","فَيقول اِرفَع وما شئت اِطلبِ",44,"ب",1,0],["إِذ يعمُّ الإسلام كلّ البرايا","وهوَ جبّارُهم فأين الفهيمُ",45,"م",1,0],["إِذ يَتَّقي بِبَني بَدرٍ وَأَردَفَهُم","خَلفَ المَناطِقِ مِنّا عانِدٌ يَكِفُ",46,"ف",1,0],["إذ يرى سائر المفاصل مني","راقصاتٍ إذ صفَّقت أَنيابي",47,"ب",2,0],["إذ يعبدون النارَ طول حياتهم","ومصيرهُم بعد الممات جهنَّمُ",48,"م",1,0],["إِذ يستَفادُ مِنَ النَسيم الأَريج","مِسكَ دارينا",49,"ن",2,0],["إذينا دون ادخلوها","بسلام آمنينا",50,"ن",2,0],["إِذ يُريكَ المنامُ من كلّ شيءٍ","غَيبهُ بالمثالِ أو بالعيانِ",51,"ن",1,0],["أذيب فيه خيالي","وذكرياتي وحسي",52,"ي",1,0],["أذى السكر مَقصورٌ عَلى شارب الطلا","وَمُؤذي الوَرى الإضرار مِنهُ بِهِ أَضَر",53,"ر",1,1],["إِذ يمنح القَوس باريها وَلا عَجَب","إِذا تَقَلّد قَوس الحَزم موترهُ",54,"ر",2,0],["إِذ يَرَونَ الطعنَ منّا","برماحٍ داعِصيَّه",55,"ي",2,0],["إذ يَسجَعانِ فيُخرجانِ منَ الهوى","هَذي فِعالُ سَواجِعُ الكُهّانِ",56,"ن",1,0],["إذ يَقصِم الطعنُ القَنا فالقَنا","كأنَّها الأشطانُ أشطارُ",57,"ر",1,0],["إِذ يُسكر الشُرب وَالحَميا","مِن فَمِهِ الشادن الرَبيب",58,"ب",1,0],["إذ يدَّعي النُّسْكَ ولا يهتدي","به وينعى بخراب الدِّيار",59,"ر",1,0],["إذ يسير النصر في موكبه","مُعلناً تأييده حيث يسير",60,"ر",1,0],["إذ يريك الحقَّ يبدو ظاهراً","لازماً في حكمه لا يتعدى",61,"د",2,0],["إذ يُحشَرُ الناس في ذاكَ النهار ضحًى","والخيل قد أقْبَلَتْ بالشاء والإِبل",62,"ل",1,0],["إذ يدَّعي بالملك من هو أهله","والحزم يقضي والسيوف شهود",63,"د",1,0],["إذ يختلي الأعناق ضرب سيفه","كأنها العيس وقد لسَّت خلا",64,"ا",1,0],["إذ يبصر في ورق الشجر المتهاوي","موتَ البذرة",65,"ه",1,0],["آذيتموني باستحالاتكمْ","حتى تَهَزَّأْتُ بآدابي",66,"ب",2,0],["إذ يروق السمع منشدها","يترامى نحوها الحسد",67,"د",1,0],["إذ يحسب السمن كطعم الموت","ولا يرى القلي بغير الزيت",68,"ت",1,0],["إِذ يناجيه لحن مَعْبَد بالشج","وكما شاء معملاً أوتارهْ",69,"ر",2,0],["إِذ يغنيه مالكُ بن أبي السم","ح وعمرو الوادي فينفي وقاره",69,"ر",2,0],["إذ يد الدهر يمينٌ والصِّبا","واسعُ الشوط وجيدُ الدهر حالي",70,"ل",2,0],["أذى كصدور السمهرية مرهف","وذل كعيدان الأراك الضعائف",71,"ف",1,0],["إذ يرى الخضراء في أثوابها","بلدة كانت على وفق المراد",72,"د",1,0],["إذ يدَى نَصرٍ وكَسرٍ","مَد