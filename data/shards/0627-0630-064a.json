{"poems":[[53,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[63,"أيا عقدات الرمل من أرض كوفن","https://www.aldiwan.net/poem45894.html","الطويل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[83,"فمنهج النصرا","https://www.aldiwan.net/poem54206.html","مخلع البسيط"],[83,"أهدي أبا العباس","https://www.aldiwan.net/poem54278.html","مجزوء الكامل"],[72,"ما للندى لا يلبي صوت داعيه","https://www.aldiwan.net/poem20565.html","البسيط"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[78,"كنت حلف الندى ورب السماح","https://www.aldiwan.net/poem14205.html","الخفيف"],[45,"قل لأبي جعفر وإن له","https://www.aldiwan.net/poem65621.html","المنسرح"],[66,"أذى الجسم شرب الراح قبل اغتذائه","https://www.aldiwan.net/poem39078.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[105,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"غشيت ديارها من بعد عشر","https://www.aldiwan.net/poem43399.html","الوافر"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[21,"كثمود التي تفتكت الدين","https://www.aldiwan.net/poem36208.html","الخفيف"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[22,"أذئب القفر أم ذئب أنيس","https://www.aldiwan.net/poem22072.html","الوافر"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[46,"قد أسرف الإنس في الدعوى بجهلهم","https://www.aldiwan.net/poem22087.html","البسيط"],[46,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55157","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67338","المنسرح"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[90,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"يشكو إليك هواك المدنف الوصب","https://www.poetsgate.com/ViewPoem.aspx?id=33094",""],[51,"دعْ لباكٍ رسومَه وطلولَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30335",""]],"verses":[["إِذ يَلتَقي كُلُّ ذي دَينٍ وَماطِلَهُ","مِنّا وَيَجتَمِعُ المَشكوُّ وَالشاكي",0,"ك",2,0],["أُذيلُ لذكْراكُنَّ دَمْعِي وفي الحَشَى","هَوىً لِسَيالاتٍ بِكُنَّ مَصونُ",1,"ن",1,0],["إِذ يَتَّقونَ بِيَ الأَسِنَّةَ لَم أَخِم","عَنها وَلَكِنّي تَضايَقَ مُقدَمي",2,"م",2,0],["أَذيقونا الرَجاءَ فَقَد ظَمِئنا","بِعَهدِ المُصلِحينَ إِلى الوُرودِ",3,"د",1,0],["إذي جري ذكروا","تقول من الأشواق",4,"ق",1,0],["أذيالُهُ في حمده","مسكِيَّةُ الأنفاسِ",5,"س",1,0],["أذيل ماء جفوني بعدهُ أسفاً","لماء وجهي الذي قد كانَ يحميه",6,"ي",2,0],["إِذ يَنظُرونَ وَهُم يَجنونَ حَنظَلَهُم","إِلى الزَوابي فَقُلنا بُعدَ ما نَظَروا",7,"ر",3,0],["إِذ يَميني لِلبَذل يَومَ العَطايا","ولقبض الأَرواحِ يَومَ الكِفاحِ",8,"ح",1,0],["أُذيعُ جَدواكَ أَم أَكونُ كَمَن","يَكتُمُ شُؤبوبُها وَوابِلَها",9,"ل",3,0],["أَذى الجِسمِ شُربُ الراحِ قَبلَ اِغتِذائِهِ","وَلِلنَفسِ مِنهُ غايَةُ القَبضِ وَالثَقلِ",10,"ل",1,1],["أُذيقوا به حصراً أذلّ عرامهم","كما ضاق عِندَ المَوتِ عن نَفَسٍ صدرُ",11,"ر",1,0],["إِذ يَرى قَومَهُ أَعَزَّ وَأَعلى","وَحَياةَ البِلادِ فَوقَ حَياتِهْ",12,"ت",2,0],["آذَيتُمونا مُدمِنينَ فَجَرِّبوا","عُقبى الأَذى وَمَغَبَّةَ الإِدمانِ",13,"ن",1,0],["أَذىً ما لِلمَمالِكِ مِنهُ واقٍ","وَلا لبَني المَمالِكِ مِن مَفَرِّ",14,"ر",1,0],["إذ يَقُولُ اللَّهُ في عليائِهِ","لرسولِ اللَّهِ سَدِّدْ وارشُقِ",15,"ق",1,0],["آذى رسولَ اللهِ في مالهِ","وآثرَ الغدرَ ولم يحفِلِ",16,"ل",1,0],["إذ يقول النبيُّ لا تضربِ الشي","خَ وإن سبّني ودعه قريرا",17,"ر",2,0],["إِذ يَسَفّونَ بِالدَقيقِ وَكانوا","قَبلُ لا يَأكُلونَ شَيئاً فَطيرا",18,"ر",2,0],["إِذ يَرسِمانِ خِلالَ الجَيشِ مُحكَمَةً","أَرباقُ أَسرِهِما في مُحكَمِ ا لقِدَدِ",19,"د",1,0],["أُذيبُ عَن أَحسابِ قَحطانَ إِنَّني","أَنا اِبنُ بَني بِطحائِها حَيثُ حَلَّتِ",20,"ت",1,0],["أَذِئبُ القَفرِ أَم ذِئبٌ أَنيسٌ","أَصابَ البَكرَ أَم حَدَثُ اللَيالي",21,"ي",1,1],["إِذْ يَنْظُرُونَ وَهمْ لا يُبْصِرونَهُما","كَأَنَّ أَبصارَهمْ مِنْ زَيْغِهَا حُولُ",22,"ل",1,0],["إذ يتّقونَ حَرُورَ الشمس عن مُقَلٍ","مُغْرَوْرِقاتِ المآقي والأناسيّ",23,"ي",1,0],["إِذ يَنطوي كَعَهدِهِ مَذكورُ","باَنَت سُلَيمى فَمَتى الكُرورُ",24,"ر",1,0],["أَذىً مِنَ الدَهرِ مَشفوعٌ لَنا بِأَذىً","هَذا المَحَلُّ بِما تَخشاهُ مِربابُ",25,"ب",1,0],["أَذيتَ مِنَ الَّذينَ تَعُدُّ أَهلاً","وَجَنبَكَ الأَذاةَ الأَجنَبِيُّ",26,"ب",2,0],["إِذ يَشزِرونَ إِلَيَّ الظَرفَ عَن عُرُضٍ","كَأَنَّ أَعيُنَهُم مِن بُغضِهِم عورُ",27,"ر",1,0],["أذيقاهُ ما شئتما واغرسا","به الشرَّ ملتهباً مُرْمِضا",28,"ض",2,0],["إذ يرى فوقَ منكبٍ منه عاري","وصمةَ الذلّ صوّرَت بالنار",29,"ر",1,0],["إِذْ يَطْعَمُ الفَمُ فِيهِ أَشْهَى مَطْعمٍ","وَالعَيْنُ تَنْظُرُ فِيهِ أَبْهى مَنْظَرِ",30,"ر",1,0],["إِذْ يَخِفُّ الجِسْمُ مِنْ بُعْدٍ","فَيَبْدُو كَالخَيَالْ",31,"ل",1,0],["إِذْ يَعْلَمُونَ أَنَّنِي","صَاحِبُ هَذَا المُبْتَكَرْ",32,"ر",1,0],["إِذْ يُرَى قَاسِياً عَلَى المُسْتَبِدِّي","نَ فَمَا فِيهِ مَوْضِعٌ لِلِّينِ",33,"ن",1,0],["إذْ يُطرَحُونَ من سَنَمِ الطَّيْ","رِ تَرْقَّى لِقُنَّةِ الجَبَلِ",34,"ل",1,0],["إذْ يَهْتَدُونَ بجَعْفَرٍ وَلِوَائِهِ","قُدَّامَ أَوَّلِهِمْ فِنِعْمَ الأوَّلُ",35,"ل",1,0],["أذيّةٌ في جهاد نِلتَها طرباً","وهل جهادٌ بلا مسٍّ وإيذاء",36,"ا",2,0],["إذ يضمُّ القلبُ الجناحَ فترتدّ","الخوافي مهيضةً والقوادِم",37,"م",1,0],["إذ يحار الراؤون في حُسنك الفتّانِ","بل في ثيابك الفَتّانه",38,"ن",2,0],["إذ يقال: اتئب، ردت صبابته","إليه ثابت وجد ليس يتئب",39,"ب",1,0],["إذ يتاني الرسولُ منك بأمرٍ","يشبهُ الموتَ نفسَه أو رسوله",40,"ل",2,0]]}