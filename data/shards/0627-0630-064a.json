{"poems":[[53,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[63,"أيا عقدات الرمل من أرض كوفن","https://www.aldiwan.net/poem45894.html","الطويل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[83,"فمنهج النصرا","https://www.aldiwan.net/poem54206.html","مخلع البسيط"],[83,"أهدي أبا العباس","https://www.aldiwan.net/poem54278.html","مجزوء الكامل"],[72,"ما للندى لا يلبي صوت داعيه","https://www.aldiwan.net/poem20565.html","البسيط"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[78,"كنت حلف الندى ورب السماح","https://www.aldiwan.net/poem14205.html","الخفيف"],[45,"قل لأبي جعفر وإن له","https://www.aldiwan.net/poem65621.html","المنسرح"],[66,"أذى الجسم شرب الراح قبل اغتذائه","https://www.aldiwan.net/poem39078.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[105,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"غشيت ديارها من بعد عشر","https://www.aldiwan.net/poem43399.html","الوافر"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[21,"كثمود التي تفتكت الدين","https://www.aldiwan.net/poem36208.html","الخفيف"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[22,"أذئب القفر أم ذئب أنيس","https://www.aldiwan.net/poem22072.html","الوافر"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[46,"قد أسرف الإنس في الدعوى بجهلهم","https://www.aldiwan.net/poem22087.html","البسيط"],[46,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55157","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67338","المنسرح"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[90,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"يشكو إليك هواك المدنف الوصب","https://www.poetsgate.com/ViewPoem.aspx?id=33094",""],[51,"دعْ لباكٍ رسومَه وطلولَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30335",""],[115,"منع الوصال ولج بالهجر","https://www.aldiwan.net/poem41086.html","عموديه"],[143,"تسد إذا حم الحمام المذاهب","https://www.aldiwan.net/poem11729.html","الطويل"],[189,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[189,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[189,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[249,"أي المنازل بعد الحي تعترف","https://www.aldiwan.net/poem2106.html","البسيط"],[250,"ضحك الروض من بكاء السحاب","https://www.aldiwan.net/poem14925.html","الخفيف"],[250,"رزق العباد براحتيك مقسم","https://www.aldiwan.net/poem15022.html","الكامل"],[257,"ما للموله من سكره لا يفيق","https://www.aldiwan.net/poem2656.html","المجتث"],[304,"خذ يمينا خذ يمينا","https://www.aldiwan.net/poem16907.html","مجزوء الرمل"],[305,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[342,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[353,"أذى السكر مقصور على شارب الطلا","https://www.aldiwan.net/poem40213.html","الطويل"],[353,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[365,"فاتنا بدر وأحد","https://www.aldiwan.net/poem44375.html","مجزوء الرمل"],[366,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[371,"يا حار إن الركب قد حاروا","https://www.aldiwan.net/poem57442.html","السريع"],[380,"وجد له في الحشا دبيب","https://www.aldiwan.net/poem49249.html","مخلع البسيط"],[416,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[416,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[416,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[416,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[416,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[422,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[432,"عليكم جانبت أصحابي","https://www.aldiwan.net/poem12326.html","السريع"],[437,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[443,"في بعلبك جنة الخوام","https://www.aldiwan.net/poem55930.html","عموديه"],[452,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[458,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[461,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15090.html","الطويل"],[479,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[538,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[551,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["إِذ يَلتَقي كُلُّ ذي دَينٍ وَماطِلَهُ","مِنّا وَيَجتَمِعُ المَشكوُّ وَالشاكي",0,"ك",2,0],["أُذيلُ لذكْراكُنَّ دَمْعِي وفي الحَشَى","هَوىً لِسَيالاتٍ بِكُنَّ مَصونُ",1,"ن",1,0],["إِذ يَتَّقونَ بِيَ الأَسِنَّةَ لَم أَخِم","عَنها وَلَكِنّي تَضايَقَ مُقدَمي",2,"م",2,0],["أَذيقونا الرَجاءَ فَقَد ظَمِئنا","بِعَهدِ المُصلِحينَ إِلى الوُرودِ",3,"د",1,0],["إذي جري ذكروا","تقول من الأشواق",4,"ق",1,0],["أذيالُهُ في حمده","مسكِيَّةُ الأنفاسِ",5,"س",1,0],["أذيل ماء جفوني بعدهُ أسفاً","لماء وجهي الذي قد كانَ يحميه",6,"ي",2,0],["إِذ يَنظُرونَ وَهُم يَجنونَ حَنظَلَهُم","إِلى الزَوابي فَقُلنا بُعدَ ما نَظَروا",7,"ر",3,0],["إِذ يَميني لِلبَذل يَومَ العَطايا","ولقبض الأَرواحِ يَومَ الكِفاحِ",8,"ح",1,0],["أُذيعُ جَدواكَ أَم أَكونُ كَمَن","يَكتُمُ شُؤبوبُها وَوابِلَها",9,"ل",3,0],["أَذى الجِسمِ شُربُ الراحِ قَبلَ اِغتِذائِهِ","وَلِلنَفسِ مِنهُ غايَةُ القَبضِ وَالثَقلِ",10,"ل",1,1],["أُذيقوا به حصراً أذلّ عرامهم","كما ضاق عِندَ المَوتِ عن نَفَسٍ صدرُ",11,"ر",1,0],["إِذ يَرى قَومَهُ أَعَزَّ وَأَعلى","وَحَياةَ البِلادِ فَوقَ حَياتِهْ",12,"ت",2,0],["آذَيتُمونا مُدمِنينَ فَجَرِّبوا","عُقبى الأَذى وَمَغَبَّةَ الإِدمانِ",13,"ن",1,0],["أَذىً ما لِلمَمالِكِ مِنهُ واقٍ","وَلا لبَني المَمالِكِ مِن مَفَرِّ",14,"ر",1,0],["إذ يَقُولُ اللَّهُ في عليائِهِ","لرسولِ اللَّهِ سَدِّدْ وارشُقِ",15,"ق",1,0],["آذى رسولَ اللهِ في مالهِ","وآثرَ الغدرَ ولم يحفِلِ",16,"ل",1,0],["إذ يقول النبيُّ لا تضربِ الشي","خَ وإن سبّني ودعه قريرا",17,"ر",2,0],["إِذ يَسَفّونَ بِالدَقيقِ وَكانوا","قَبلُ لا يَأكُلونَ شَيئاً فَطيرا",18,"ر",2,0],["إِذ يَرسِمانِ خِلالَ الجَيشِ مُحكَمَةً","أَرباقُ أَسرِهِما في مُحكَمِ ا لقِدَدِ",19,"د",1,0],["أُذيبُ عَن أَحسابِ قَحطانَ إِنَّني","أَنا اِبنُ بَني بِطحائِها حَيثُ حَلَّتِ",20,"ت",1,0],["أَذِئبُ القَفرِ أَم ذِئبٌ أَنيسٌ","أَصابَ البَكرَ أَم حَدَثُ اللَيالي",21,"ي",1,1],["إِذْ يَنْظُرُونَ وَهمْ لا يُبْصِرونَهُما","كَأَنَّ أَبصارَهمْ مِنْ زَيْغِهَا حُولُ",22,"ل",1,0],["إذ يتّقونَ حَرُورَ الشمس عن مُقَلٍ","مُغْرَوْرِقاتِ المآقي والأناسيّ",23,"ي",1,0],["إِذ يَنطوي كَعَهدِهِ مَذكورُ","باَنَت سُلَيمى فَمَتى الكُرورُ",24,"ر",1,0],["أَذىً مِنَ الدَهرِ مَشفوعٌ لَنا بِأَذىً","هَذا المَحَلُّ بِما تَخشاهُ مِربابُ",25,"ب",1,0],["أَذيتَ مِنَ الَّذينَ تَعُدُّ أَهلاً","وَجَنبَكَ الأَذاةَ الأَجنَبِيُّ",26,"ب",2,0],["إِذ يَشزِرونَ إِلَيَّ الظَرفَ عَن عُرُضٍ","كَأَنَّ أَعيُنَهُم مِن بُغضِهِم عورُ",27,"ر",1,0],["أذيقاهُ ما شئتما واغرسا","به الشرَّ ملتهباً مُرْمِضا",28,"ض",2,0],["إذ يرى فوقَ منكبٍ منه عاري","وصمةَ الذلّ صوّرَت بالنار",29,"ر",1,0],["إِذْ يَطْعَمُ الفَمُ فِيهِ أَشْهَى مَطْعمٍ","وَالعَيْنُ تَنْظُرُ فِيهِ أَبْهى مَنْظَرِ",30,"ر",1,0],["إِذْ يَخِفُّ الجِسْمُ مِنْ بُعْدٍ","فَيَبْدُو كَالخَيَالْ",31,"ل",1,0],["إِذْ يَعْلَمُونَ أَنَّنِي","صَاحِبُ هَذَا المُبْتَكَرْ",32,"ر",1,0],["إِذْ يُرَى قَاسِياً عَلَى المُسْتَبِدِّي","نَ فَمَا فِيهِ مَوْضِعٌ لِلِّينِ",33,"ن",1,0],["إذْ يُطرَحُونَ من سَنَمِ الطَّيْ","رِ تَرْقَّى لِقُنَّةِ الجَبَلِ",34,"ل",1,0],["إذْ يَهْتَدُونَ بجَعْفَرٍ وَلِوَائِهِ","قُدَّامَ أَوَّلِهِمْ فِنِعْمَ الأوَّلُ",35,"ل",1,0],["أذيّةٌ في جهاد نِلتَها طرباً","وهل جهادٌ بلا مسٍّ وإيذاء",36,"ا",2,0],["إذ يضمُّ القلبُ الجناحَ فترتدّ","الخوافي مهيضةً والقوادِم",37,"م",1,0],["إذ يحار الراؤون في حُسنك الفتّانِ","بل في ثيابك الفَتّانه",38,"ن",2,0],["إذ يقال: اتئب، ردت صبابته","إليه ثابت وجد ليس يتئب",39,"ب",1,0],["إذ يتاني الرسولُ منك بأمرٍ","يشبهُ الموتَ نفسَه أو رسوله",40,"ل",2,0],["آذى قواي وها اذيته","تسري له من حيث لا يدري",41,"ي",1,0],["أَذى الفَتَكاتِ اللائي لَو لَم تَبُح بِها","نِفوسُ العِدى ما اِلتَذَّ بِالماءِ شارِبُ",42,"ب",1,0],["إِذ يَستحيلُ على خلّاقِنا جهةٌ","وَالمُستحيلُ محالٌ أَن ندين بهِ",43,"ب",2,0],["إِذ يَرَونَ الهولَ هولاً أعظَما","يَستَوي المُحسنُ فيهِ والمُسي",44,"ي",1,0],["إِذ يُرى للَّه عبداً ساجدا","فَيقول اِرفَع وما شئت اِطلبِ",44,"ب",1,0],["إِذ يعمُّ الإسلام كلّ البرايا","وهوَ جبّارُهم فأين الفهيمُ",45,"م",1,0],["إِذ يَتَّقي بِبَني بَدرٍ وَأَردَفَهُم","خَلفَ المَناطِقِ مِنّا عانِدٌ يَكِفُ",46,"ف",1,0],["إذ يرى سائر المفاصل مني","راقصاتٍ إذ صفَّقت أَنيابي",47,"ي",1,0],["إذ يعبدون النارَ طول حياتهم","ومصيرهُم بعد الممات جهنَّمُ",48,"م",1,0],["إِذ يستَفادُ مِنَ النَسيم الأَريج","مِسكَ دارينا",49,"ن",2,0],["إذينا دون ادخلوها","بسلام آمنينا",50,"ن",2,0],["إِذ يُريكَ المنامُ من كلّ شيءٍ","غَيبهُ بالمثالِ أو بالعيانِ",51,"ن",1,0],["أذيب فيه خيالي","وذكرياتي وحسي",52,"ي",1,0],["أذى السكر مَقصورٌ عَلى شارب الطلا","وَمُؤذي الوَرى الإضرار مِنهُ بِهِ أَضَر",53,"ر",1,1],["إِذ يمنح القَوس باريها وَلا عَجَب","إِذا تَقَلّد قَوس الحَزم موترهُ",54,"ر",2,0],["إِذ يَرَونَ الطعنَ منّا","برماحٍ داعِصيَّه",55,"ي",2,0],["إذ يَسجَعانِ فيُخرجانِ منَ الهوى","هَذي فِعالُ سَواجِعُ الكُهّانِ",56,"ن",1,0],["إذ يَقصِم الطعنُ القَنا فالقَنا","كأنَّها الأشطانُ أشطارُ",57,"ر",1,0],["إِذ يُسكر الشُرب وَالحَميا","مِن فَمِهِ الشادن الرَبيب",58,"ب",1,0],["إذ يدَّعي النُّسْكَ ولا يهتدي","به وينعى بخراب الدِّيار",59,"ر",1,0],["إذ يسير النصر في موكبه","مُعلناً تأييده حيث يسير",60,"ر",1,0],["إذ يريك الحقَّ يبدو ظاهراً","لازماً في حكمه لا يتعدى",61,"د",2,0],["إذ يُحشَرُ الناس في ذاكَ النهار ضحًى","والخيل قد أقْبَلَتْ بالشاء والإِبل",62,"ل",1,0],["إذ يدَّعي بالملك من هو أهله","والحزم يقضي والسيوف شهود",63,"د",1,0],["إذ يختلي الأعناق ضرب سيفه","كأنها العيس وقد لسَّت خلا",64,"ا",1,0],["إذ يبصر في ورق الشجر المتهاوي","موتَ البذرة",65,"ه",1,0],["آذيتموني باستحالاتكمْ","حتى تَهَزَّأْتُ بآدابي",66,"ي",1,0],["إذ يروق السمع منشدها","يترامى نحوها الحسد",67,"د",1,0],["إذ يحسب السمن كطعم الموت","ولا يرى القلي بغير الزيت",68,"ت",1,0],["إِذ يناجيه لحن مَعْبَد بالشج","وكما شاء معملاً أوتارهْ",69,"ر",2,0],["إِذ يغنيه مالكُ بن أبي السم","ح وعمرو الوادي فينفي وقاره",69,"ر",2,0],["إذ يد الدهر يمينٌ والصِّبا","واسعُ الشوط وجيدُ الدهر حالي",70,"ي",1,0],["أذى كصدور السمهرية مرهف","وذل كعيدان الأراك الضعائف",71,"ف",1,0],["إذ يرى الخضراء في أثوابها","بلدة كانت على وفق المراد",72,"د",1,0],["إذ يدَى نَصرٍ وكَسرٍ","مَدَّ لِلمَملَكَتَينِ",73,"ن",1,0],["أُذِيدوا فلم يُغنَوْا ولم يُغنِ عنهُمُ","من الذّائدين ما أنالوا وخوّلوا",74,"ل",3,0],["آذِيَّ أَورادٍ يُغَيِّفنَ النَظَر","شُهبٌ إِذا ما مُجنَ مَوَّجنَ البَصَر",75,"ر",1,0],["آذَى ولكنْ أَفادَ تَجرِبَةً","فما ذَكَا مِقْوَلِي ولاَ خَمدا",76,"د",2,0]]}