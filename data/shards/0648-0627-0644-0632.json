{"poems":[[53,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[86,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[86,"مرت كعمر الورد بينا أجتلي","https://www.aldiwan.net/poem10939.html","الكامل"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[71,"الواعظ البلخي كان قرابتي","https://www.aldiwan.net/poem3778.html","الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[88,"كم قد لبست بها الضحا من روضة","https://www.aldiwan.net/poem44440.html","الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[4,"فاخرتني بيشكر بن بكر","https://www.aldiwan.net/poem21171.html","الرجز"],[23,"أعرض عن العوراء إن أسمعتها","https://www.aldiwan.net/poem21441.html","الكامل"],[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[89,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[85,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[85,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[62,"الزئبق الشرقي في سرنا","https://www.aldiwan.net/poem52180.html","السريع"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[62,"قد جاءنا في حكمة مكنونة","https://www.aldiwan.net/poem52204.html","الكامل"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[45,"رأى البرق مجتازا فبات بلا لب","https://www.aldiwan.net/poem10651.html","الطويل"],[45,"إن السماء إذا لم تبك مقلتها","https://www.aldiwan.net/poem64566.html","البسيط"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[61,"للخالديين جمال منظر","https://www.aldiwan.net/poem51665.html","الرجز"],[66,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[97,"اليوم يومك في الشباب فناد","https://www.aldiwan.net/poem24755.html","الكامل"],[31,"يا أم نوفل فكي عانيا مثلت","https://www.aldiwan.net/poem41855.html","البسيط"],[31,"لمن الديار رسومها قفر","https://www.aldiwan.net/poem42527.html","الكامل"],[74,"وألزمته حكم الهوى فالتقى به","https://www.aldiwan.net/poem13247.html","الطويل"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"حث الكؤوس ولا تطع من لاما","https://www.aldiwan.net/poem61485.html","الكامل"],[102,"يا زهرة الوادي أتيت بزهرة","https://www.aldiwan.net/poem33104.html","الكامل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[48,"لولا الأمير وأن العذر منقصة","https://www.aldiwan.net/poem63308.html","البسيط"],[48,"لما جفاني الحبيب وامتنعت","https://www.aldiwan.net/poem63333.html","المنسرح"],[48,"وجه بنان كأنه قمر","https://www.aldiwan.net/poem66152.html","المنسرح"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[46,"الحمد لله أضحى الناس في عجب","https://www.aldiwan.net/poem22916.html","البسيط"],[46,"دعاكم إلى خير الأمور محمد","https://www.aldiwan.net/poem23208.html","الطويل"],[46,"كم صرف المولود عن والد","https://www.aldiwan.net/poem23554.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54773","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[22,"أنا ابنُ بجدتهم علماً وتجربة","https://www.poetsgate.com/ViewPoem.aspx?id=19772",""],[45,"أأفاق صَبٌّ مِنْ هَوىً، فأُفِيقَا","https://www.poetsgate.com/ViewPoem.aspx?id=32851",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""]],"verses":[["وَالزاحِمينَ بِالقَنا أَعداءَها","عَلى الثَنايا مَنَعوا طَلّاعَها",0,"ع",3,0],["وَالزاغِبِيّاتِ إِن أُش","رِعوا عَنِ الدارِ ذَبّوا",1,"ب",3,0],["والزُّهْرُ تَسْقُطُ للغُروبِ كما ذَوى","زَهْرُ الرِّياضِ وفارَقَ الأدْواحا",2,"ح",2,0],["وَالزَّهْرُ فِي نَهْرِ المَجَرَّةِ بَعْضُهَا","يَطْفُو بِصَفْحَتِهَا وَ بَعْضٌ يَرْسُبُ",3,"ب",1,0],["وَاِلزَمِ النَوحَ أَيا طَيرُ وَلا","تَبتَهِج بِالشَدوِ فَالشَدوُ حَدَد",4,"د",1,0],["وَالزَهرُ يَحتَثُّ الكُؤوسَ بِلَحظِهِ","وَيَشوبُها بِأَريجِهِ الفَيّاحِ",5,"ح",1,0],["وَالزَهرُ مُصغٍ وَالخَمائِلُ خُشَّعٌ","وَالطَيرُ مُستَمِعٌ عَلى أَفنانِهِ",6,"ن",2,0],["وَالزاهِدُ الملّاقُ مَن أَخبارُهُ","ما قَد عَلِمتَ خَفِيَّةُ الأَسرارِ",7,"ر",1,0],["وَأَلْزَمَ المِدْرَه المِنْطِيقَ حُجَّتَهُ","مِنْ حَيْثُ كَانَ بِهَا لِلحَقُّ يَلْتَزِمُ",8,"م",1,0],["والزُّهرُ زَهُرٌ والسَّماءُ حديقةٌ","فتقتْ كمائمُ جنحها عن أَنجُمِ",9,"م",1,0],["والزهر ينبته السحاب بمائه","كالعلم ينبت غرسه التفكير",10,"ر",1,0],["وَاِلزَم بِحِلفِكَ في قُضاعَةَ إِنَّما","قَيسٌ عَلَيكَ وَخِندِفٌ أَخَوانِ",11,"ن",1,0],["وَالزُنمَتَينِ عِندَ سَيفِ البَحرِ","ذاكَ أَوانَ اِفتَقَرَت لِلنَصرِ",12,"ر",1,0],["وَاِلزَم مُجالَسَةَ الكِرامِ وَفِعلَهُم","وَإِذا اِتَّبَعتَ فَأَبصِرَن مَن تَتبَعُ",13,"ع",1,0],["والزهر كالضيف أمسى وهو مبتسم","على زِقاقٍ من الصهباءِ قد ذُبحت",14,"ت",1,0],["والزمانُ الذي لبسنا به العي","شَ جديداً كأنه بُردُ حالِ",15,"ل",1,0],["وَالزَهرُ تُرَحِّبُ بِالفَجرِ","وَيَظُنُّ الزَهرَ تُغازِلُهُ",16,"ه",1,0],["وَالزَهرُ في الجَنّاتِ فَيّاحُ الشَذا","بِنَدَى الصَباحِ مُتَوَّجٌ وَمُكَلَّلُ",17,"ل",1,0],["والزهر ينظر باسماً","والعندليب يغازل",18,"ل",1,0],["والزهر في اشواكه","كالعين حولها الهدب",19,"ب",1,0],["وَالزَمانُ سُنَّتُهُ","في السُلُوِّ يَجتَهِدُ",20,"د",1,0],["وَالزَهرُ في أَكمامِهِ","يَبكي بِدَمعِ الغادِياتِ",21,"ت",1,0],["وَالزَرعُ سُنبُلُهُ يَطيبُ وَحَبُّهُ","مِنها فَيَخرُجُ ذا وَهَذا يُفلَقُ",22,"ق",1,0],["والزئبق الأسفل سر لنا","دعوه في آخره ثفلا",23,"ل",2,0],["والزئبق الأصل هو الزئبق ال","غربي جسم طار فاستعلى",23,"ل",2,0],["والزرع بالماء يزكو وهو يغرقه","إن زدته فأقتصد في الماء واقتصر",24,"ر",1,0],["والزهرة الزهراء خارج بابها","ولها بأثناء الرموز صياحُ",25,"ح",1,0],["والزعفران صبغة","يتلوه لون العلق",26,"ق",1,0],["وَأَلزَمُهُم قَصدَ السَبيلِ حِذارُهُم","لِتِلكَ السَوافي مِن زَعازِعِهِ النُكبِ",27,"ب",1,0],["وَالزَهرُ لا تَنجَلي أَحداقُهُ أَبَداً","إِلّا إِذا مَرِضَت مِن كَثرَةِ المَطَرِ",28,"ر",1,0],["وَالزابِ إِذ حانَت أُمَيَّةُ فَاِغتَدَت","تُزجي لَنا جَعِيَّها الزِنديقا",29,"ق",2,0],["والزَّرْعُ إن تَمَّ به للأكبَرِ","أقول إذْ هَمّا بأمرٍ مُنكَرِ",30,"ر",1,0],["وَالزَهرُ قَد مَدَّ لَنا","بُسطاً مِنَ الإِستَبرَقِ",31,"ق",1,0],["والزرع نضر في الحقول وأهله","يتهيأون لمنجل الحصادِ",32,"د",1,0],["وَالزَنجَبيلُ مَعَ التُفّاحِ تَحسَبُهُ","مِن طيبِ ريقَتِها قَد خالَطَ العَسَلا",33,"ل",2,0],["وَالزَعفَرانُ عَلى تَرائِبِها","شَرِقٌ بِهِ اللَبّاتُ وَالنَحرُ",34,"ر",1,0],["وَأَلزَمتُهُ حُكمَ الهَوى فَاِلتَقى بِهِ","وَبي أَلِفٌ عِندَ العِناقِ وَلامُ",35,"م",1,1],["والزّمانُ الضّخمُ لولا أنّنا","من بنيهِ هَانَ قدراً ومَقاما",36,"م",2,0],["والزعيمُ الذي يَسنُّ ويقضِي","لبني الدهرِ غُيَّباً وحضورا",37,"ر",2,0],["وَالزَهرُ يَرنو عَن نَواظِرَ سَدَّدَت","لَحَظاتُهُنَّ إِلى الشُجونِ سِهاما",38,"م",2,0],["وَالزَهر أَبهى مَنظَراً مَعَ أُمه","فَنقلتها مَعها فَزادَ بهاها",39,"ا",3,0],["والزّاعِبِيّةُ شُرَّعٌ والمَشْرَفي","يَةُ لُمَّعٌ والمُقرَباتُ صُفون",40,"ن",1,0],["وَالزِقُّ يَرميهُمُ عَمّا تَضَمَّنَهُ","رَمياً يُصيبُ بِهِ مِن غَيرِ أَوتارِ",41,"ر",1,0],["وَأَلزَمُ الصَومَ وَالصَلاةَ وَلا","أَزالُ دَهري بِالخَيرِ آتَمِرُ",42,"ر",1,0],["وَالزَدُّ مِن حُسنِهِ وَبَهجَتِهِ","كَطاقَةِ الشَوكِ في الرَياحينِ",43,"ن",1,0],["وَأَلزَمتُ حَبلي حَبلَ مَن لا تُغِبُّهُ","عُفاةُ النَدى مِن حَيثُ يَدري وَلا يَدري",44,"ي",1,0],["وَالزَندُ في حُبِّ أَسوارٍ يُسَوَّرُهُ","كَالأُذنِ في حُبِّ تَشنيفٍ وَتَقريطِ",45,"ط",1,0],["وَأَلزَمَكُم ما لَيسَ يُعجِزُ حَملُهُ","أَخا الضَعفِ مِن فَرضٍ لَهُ وَنَوافِلُ",46,"ل",1,0],["وَالزَوجُ يَزوي النِصفَ أَبناؤُهُ","عَنهُ وَفي الدَهرِ خُطوبٌ كُمُن",47,"ن",1,0],["وَالزهر يضحك عَن لؤ","لؤٍ هناك وعسجد",48,"د",1,0],["وَالزعم قد يَصفو فيظهر صائِباً","وَعَلى الحَقيقة قَد يَكون غبار",49,"ر",1,0],["والزهدُ حالٌ للقلوب والنهى","ما أمر الله به ولا نهى",50,"ه",2,0],["والزهوُ أحيانًا من المعاني","إن سال من معاطف الشُّجْعان",51,"ن",1,0],["والزاهِرِيَّةُ بالمَراكِبِ تُزْهِرُ","والعامِرِيّةُ بالكَواكِبِ تُعْمَرُ",52,"ر",1,0],["وَالزعِيمُ الأَبَر أَطْيَبُهُمْ نَفْس","اً عَنِ النَّفْسِ فِي صِرَاعِ العَوَادِي",53,"د",2,0],["وَالزَّنْبَقُ الغَضُّ إِلى زَنْبَقٍ","يَنْفِسُهُ بِاللَّونِ وَالقَدِّ",54,"د",1,0],["والزهر لو كن أزراراً مفضضة","على الذيول الضوافي من مآزره",55,"ر",2,0],["والزَّهْرُ يَختَرِقُ الكِمَامَ لنَظْرةٍ","فَيرُدُّه للكِمِّ فَرْطُ حَيَائه",56,"ا",3,0],["والزهرُ في جِيدِ الرياضِ قلائدٌ","والنهرُ في خَصْرِ الرياضِ حِزام",57,"م",1,0],["وَألزَهْرُ يَنْضَحُ عِطْراً","بَيْنَ الربَا وَمَلابَا",58,"ب",2,0],["والزهرُ ينظرُ مفتوناً إلى قَبَسٍ","يُطِلُّ بين ثنايا السحْبِ مفتونا",59,"ن",2,0],["والزبرقانُ ذُناباهم وشَرُّهُمُ","ليس الذُّنابَى أبا العبَّاسِ كالرَّاسِ",60,"س",1,0],["وَالزّابُ، إذْ حانَتْ أميّةُ، فاعتَدَتْ","تُزْجي لَنَا جَعْدِيَّهَا الزّنْديقَا",61,"ق",2,0],["والزهر ينبته السحاب بمائه","يزهو فذلك في النهَى تنوير",62,"ر",1,0]]}