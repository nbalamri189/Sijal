فشيلك قد أخرت","https://www.aldiwan.net/poem69459.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَالزاحِمينَ بِالقَنا أَعداءَها","عَلى الثَنايا مَنَعوا طَلّاعَها",0,"ع",3,0],["وَالزاغِبِيّاتِ إِن أُش","رِعوا عَنِ الدارِ ذَبّوا",1,"ب",3,0],["والزُّهْرُ تَسْقُطُ للغُروبِ كما ذَوى","زَهْرُ الرِّياضِ وفارَقَ الأدْواحا",2,"ح",2,0],["وَالزَّهْرُ فِي نَهْرِ المَجَرَّةِ بَعْضُهَا","يَطْفُو بِصَفْحَتِهَا وَ بَعْضٌ يَرْسُبُ",3,"ب",1,0],["وَاِلزَمِ النَوحَ أَيا طَيرُ وَلا","تَبتَهِج بِالشَدوِ فَالشَدوُ حَدَد",4,"د",1,0],["وَالزَهرُ يَحتَثُّ الكُؤوسَ بِلَحظِهِ","وَيَشوبُها بِأَريجِهِ الفَيّاحِ",5,"ح",1,0],["وَالزَهرُ مُصغٍ وَالخَمائِلُ خُشَّعٌ","وَالطَيرُ مُستَمِعٌ عَلى أَفنانِهِ",6,"ن",2,0],["وَالزاهِدُ الملّاقُ مَن أَخبارُهُ","ما قَد عَلِمتَ خَفِيَّةُ الأَسرارِ",7,"ر",1,0],["وَأَلْزَمَ المِدْرَه المِنْطِيقَ حُجَّتَهُ","مِنْ حَيْثُ كَانَ بِهَا لِلحَقُّ يَلْتَزِمُ",8,"م",1,0],["والزُّهرُ زَهُرٌ والسَّماءُ حديقةٌ","فتقتْ كمائمُ جنحها عن أَنجُمِ",9,"م",1,0],["والزهر ينبته السحاب بمائه","كالعلم ينبت غرسه التفكير",10,"ر",1,0],["وَاِلزَم بِحِلفِكَ في قُضاعَةَ إِنَّما","قَيسٌ عَلَيكَ وَخِندِفٌ أَخَوانِ",11,"ن",1,0],["وَالزُنمَتَينِ عِندَ سَيفِ البَحرِ","ذاكَ أَوانَ اِفتَقَرَت لِلنَصرِ",12,"ر",1,0],["وَاِلزَم مُجالَسَةَ الكِرامِ وَفِعلَهُم","وَإِذا اِتَّبَعتَ فَأَبصِرَن مَن تَتبَعُ",13,"ع",1,0],["والزهر كالضيف أمسى وهو مبتسم","على زِقاقٍ من الصهباءِ قد ذُبحت",14,"ت",1,0],["والزمانُ الذي لبسنا به العي","شَ جديداً كأنه بُردُ حالِ",15,"ل",1,0],["وَالزَهرُ تُرَحِّبُ بِالفَجرِ","وَيَظُنُّ الزَهرَ تُغازِلُهُ",16,"ه",1,0],["وَالزَهرُ في الجَنّاتِ فَيّاحُ الشَذا","بِنَدَى الصَباحِ مُتَوَّجٌ وَمُكَلَّلُ",17,"ل",1,0],["والزهر ينظر باسماً","والعندليب يغازل",18,"ل",1,0],["والزهر في اشواكه","كالعين حولها الهدب",19,"ب",1,0],["وَالزَمانُ سُنَّتُهُ","في السُلُوِّ يَجتَهِدُ",20,"د",1,0],["وَالزَهرُ في أَكمامِهِ","يَبكي بِدَمعِ الغادِياتِ",21,"ت",1,0],["وَالزَرعُ سُنبُلُهُ يَطيبُ وَحَبُّهُ","مِنها فَيَخرُجُ ذا وَهَذا يُفلَقُ",22,"ق",1,0],["والزئبق الأسفل سر لنا","دعوه في آخره ثفلا",23,"ل",2,0],["والزئبق الأصل هو الزئبق ال","غربي جسم طار فاستعلى",23,"ل",2,0],["والزرع بالماء يزكو وهو يغرقه","إن زدته فأقتصد في الماء واقتصر",24,"ر",1,0],["والزهرة الزهراء خارج بابها","ولها بأثناء الرموز صياحُ",25,"ح",1,0],["والزعفران صبغة","يتلوه لون العلق",26,"ق",1,0],["وَأَلزَمُهُم قَصدَ السَبيلِ حِذارُهُم","لِتِلكَ السَوافي مِن زَعازِعِهِ النُكبِ",27,"ب",1,0],["وَالزَهرُ لا تَنجَلي أَحداقُهُ أَبَداً","إِلّا إِذا مَرِضَت مِن كَثرَةِ المَطَرِ",28,"ر",1,0],["وَالزابِ إِذ حانَت أُمَيَّةُ فَاِغتَدَت","تُزجي لَنا جَعِيَّها الزِنديقا",29,"ق",2,0],["والزَّرْعُ إن تَمَّ به للأكبَرِ","أقول إذْ هَمّا بأمرٍ مُنكَرِ",30,"ر",1,0],["وَالزَهرُ قَد مَدَّ لَنا","بُسطاً مِنَ الإِستَبرَقِ",31,"ق",1,0],["والزرع نضر في الحقول وأهله","يتهيأون لمنجل الحصادِ",32,"د",1,0],["وَالزَنجَبيلُ مَعَ التُفّاحِ تَحسَبُهُ","مِن طيبِ ريقَتِها قَد خالَطَ العَسَلا",33,"ل",2,0],["وَالزَعفَرانُ عَلى تَرائِبِها","شَرِقٌ بِهِ اللَبّاتُ وَالنَحرُ",34,"ر",1,0],["وَأَلزَمتُهُ حُكمَ الهَوى فَاِلتَقى بِهِ","وَبي أَلِفٌ عِندَ العِناقِ وَلامُ",35,"م",1,1],["والزّمانُ الضّخمُ لولا أنّنا","من بنيهِ هَانَ قدراً ومَقاما",36,"م",2,0],["والزعيمُ الذي يَسنُّ ويقضِي","لبني الدهرِ غُيَّباً وحضورا",37,"ر",2,0],["وَالزَهرُ يَرنو عَن نَواظِرَ سَدَّدَت","لَحَظاتُهُنَّ إِلى الشُجونِ سِهاما",38,"م",2,0],["وَالزَهر أَبهى مَنظَراً مَعَ أُمه","فَنقلتها مَعها فَزادَ بهاها",39,"ا",3,0],["والزّاعِبِيّةُ شُرَّعٌ والمَشْرَفي","يَةُ لُمَّعٌ والمُقرَباتُ صُفون",40,"ن",1,0],["وَالزِقُّ يَرميهُمُ عَمّا تَضَمَّنَهُ","رَمياً يُصيبُ بِهِ مِن غَيرِ أَوتارِ",41,"ر",1,0],["وَأَلزَمُ الصَومَ وَالصَلاةَ وَلا","أَزالُ دَهري بِالخَيرِ آتَمِرُ",42,"ر",1,0],["وَالزَدُّ مِن حُسنِهِ وَبَهجَتِهِ","كَطاقَةِ الشَوكِ في الرَياحينِ",43,"ن",1,0],["وَأَلزَمتُ حَبلي حَبلَ مَن لا تُغِبُّهُ","عُفاةُ النَدى مِن حَيثُ يَدري وَلا يَدري",44,"ي",1,0],["وَالزَندُ في حُبِّ أَسوارٍ يُسَوَّرُهُ","كَالأُذنِ في حُبِّ تَشنيفٍ وَتَقريطِ",45,"ط",1,0],["وَأَلزَمَكُم ما لَيسَ يُعجِزُ حَملُهُ","أَخا الضَعفِ مِن فَرضٍ لَهُ وَنَوافِلُ",46,"ل",1,0],["وَالزَوجُ يَزوي النِصفَ أَبناؤُهُ","عَنهُ وَفي الدَهرِ خُطوبٌ كُمُن",47,"ن",1,0],["وَالزهر يضحك عَن لؤ","لؤٍ هناك وعسجد",48,"د",1,0],["وَالزعم قد يَصفو فيظهر صائِباً","وَعَلى الحَقيقة قَد يَكون غبار",49,"ر",1,0],["والزهدُ حالٌ للقلوب والنهى","ما أمر الله به ولا نهى",50,"ه",2,0],["والزهوُ أحيانًا من المعاني","إن سال من معاطف الشُّجْعان",51,"ن",1,0],["والزاهِرِيَّةُ بالمَراكِبِ تُزْهِرُ","والعامِرِيّةُ بالكَواكِبِ تُعْمَرُ",52,"ر",1,0],["وَالزعِيمُ الأَبَر أَطْيَبُهُمْ نَفْس","اً عَنِ النَّفْسِ فِي صِرَاعِ العَوَادِي",53,"د",2,0],["وَالزَّنْبَقُ الغَضُّ إِلى زَنْبَقٍ","يَنْفِسُهُ بِاللَّونِ وَالقَدِّ",54,"د",1,0],["والزهر لو كن أزراراً مفضضة","على الذيول الضوافي من مآزره",55,"ر",2,0],["والزَّهْرُ يَختَرِقُ الكِمَامَ لنَظْرةٍ","فَيرُدُّه للكِمِّ فَرْطُ حَيَائه",56,"ا",3,0],["والزهرُ في جِيدِ الرياضِ قلائدٌ","والنهرُ في خَصْرِ الرياضِ حِزام",57,"م",1,0],["وَألزَهْرُ يَنْضَحُ عِطْراً","بَيْنَ الربَا وَمَلابَا",58,"ب",2,0],["والزهرُ ينظرُ مفتوناً إلى قَبَسٍ","يُطِلُّ بين ثنايا السحْبِ مفتونا",59,"ن",2,0],["والزبرقانُ ذُناباهم وشَرُّهُمُ","ليس الذُّنابَى أبا العبَّاسِ كالرَّاسِ",60,"س",1,0],["وَالزّابُ، إذْ حانَتْ أميّةُ، فاعتَدَتْ","تُزْجي لَنَا جَعْدِيَّهَا الزّنْديقَا",61,"ق",2,0],["والزهر ينبته السحاب بمائه","يزهو فذلك في النهَى تنوير",62,"ر",1,0],["وَالزَهر في أُفق السَماءِ كَأَنَّها","عقد تَبَدد في فِراش زَبَرجَد",63,"د",1,0],["والزهر نلمع في السماء وتنجلي","والزهر قد زان الربا ديناره",64,"ر",2,0],["والزَّمانُ الّذي تَوَلَّى يداها","مَن يُضاهي الزَّمانَ أو مَن يداني",65,"ي",1,0],["والزَّوجةُ الحَمقاءُ معظم وقتها","تبكي، وتَسْلَخُني عِتاباتٍ وذَمّْ",66,"م",1,0],["والزق يسأل عن سباة حريمه","والدف يسأل عن مصير قيانه",67,"ن",2,0],["والزم الشُّورى وإن شاورتَ في","فِعل أمرٍ لا تخالف وامْتَثِلْ",68,"ل",1,0],["والزَم الصمتَ لا تكن ذَا لسان","ذَلِقِ بالأسرار والتفسيرِ",69,"ر",1,0],["والزم مقامَكَ وه