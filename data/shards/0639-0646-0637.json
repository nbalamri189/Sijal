{"poems":[[216,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[261,"يا قمرا في تمامه طلعا","https://www.aldiwan.net/poem48481.html","المنسرح"],[463,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45416","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216544",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40138","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78192","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90835","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94446","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72719","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72511","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72512","الكامل"],[4883,"هزيمه تنتصر","https://www.poetsgate.com/ViewPoem.aspx?id=48367",""],[5444,"رُبَّ الادعاء","https://www.poetsgate.com/ViewPoem.aspx?id=205449",""],[773,"هو مورد للمعتفين وغلةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=134915",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["عَنَطْنَطَةٌ غنجاء غرثاء بضة","خَدَلَّجةٌ غصت عليها الخَلاخِلُ",0,"ل",1,1],["عن طيب معناه في لطافته","كأنه في الكنيف قد وقعا",1,"ع",2,0],["عن طارح لي بمنى","حين ارتبقت حبلَهْ",2,"ل",2,0],["عَنْ طامِس الأَعْلامِ أَوْ تَخَوَّفا","كَأَنَّما شَقَّقْن رَيْطاً يَقَقا",3,"ق",2,0],["عَنْ طَبَع الأَطْباعِ عَفّاً طاهِرا","يَنْجُو مِنَ الأَمْرِ عَلَى مَعَابِرا",4,"ر",2,0],["عَن طاعَةِ الرَحمنِ أَو خُلَفائِهِ","إِن رامَ اِفساداً وَكَرَّ عَنودا",5,"د",2,0],["عَن طَلبى أنتَ الذى قد أشرَقتَ","على قُلوبِ أوليائكَ إرتقت",6,"ت",1,0],["عَنْ طِبْ «طمْسْ» اغْناني اللمس","مِنْ يَنبك اللي يِخْجِل الحيب",7,"ب",1,0],["عَن طاعِنِ الفُرسانِ غَير مكذّب","وَمُتمِّم الإِحسانِ غَير مكدّرِ",8,"ر",1,0],["عَن طي مِضمار الرَهان اِذا اِشتَكَت","صَعب السِياق مطامح الرِكاب",9,"ب",1,0],["عن طلعة تسبي البدور فإن بدت","يوما تواري يا شموس وغيبي",10,"ب",2,0],["عن طيب بيت الدين نم عبيرها","يجلي لك التاريخ فيما سُطّرا",11,"ر",2,0],["عن طول باع يراعك الص","صمصام لما قصرا",12,"ر",2,0],["عن طه شقق المراحل في يد","كانت أناملها خفاف ركابه",13,"ه",1,0],["عن طيسه شقق المراحل في يد","كانت أناملها خفاف ركابه",14,"ه",1,0],["عن طفل للسحاب المخملي هز كتفه","عن حبيبة له قلب ٍ يخون وشريف!",15,"ف",1,0],["عن طفلةٍ أو عاجزٍ أو جاهلٍ","لم يدرِ معنى جلسةِ استجواب!",16,"ب",1,0],["عن طلعة كالشمس منها أشرقت","فالرمح يسجد والصوارم تركع",17,"ع",1,0],["عن طريقِ الخريفِ نمضيْ حيارى","أشعلَ الدمعُ للشتاءِ الهطولا",18,"ل",2,0]]}