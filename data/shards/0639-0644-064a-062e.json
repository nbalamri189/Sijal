x?id=20956",""],[5092,"أمامي يجلسُ الآنَ","https://www.poetsgate.com/ViewPoem.aspx?id=163332",""],[5151,"نبيذان من ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=189984",""],[5277,"للقدس..حنين ومدامع","https://www.poetsgate.com/ViewPoem.aspx?id=190394",""],[5277,"بنتُ الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=193830",""],[5277,"رجعُ الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=210288",""],[5277,"نهنهة","https://www.poetsgate.com/ViewPoem.aspx?id=210588",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5351,"خسرتم","https://www.poetsgate.com/ViewPoem.aspx?id=202633",""],[5385,"عهدنا بغرب مطلع البدر مشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=144220",""],[5431,"الساحر الضليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=207113",""],[5431,"سبحان الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=208038",""],[5497,"صلاتي وتسليمي وأزكى تحيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=208833",""],[5518,"حين تسجد الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=201119",""],[5672,"الأربعون...","https://www.poetsgate.com/ViewPoem.aspx?id=206407",""],[5691,"شهيد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=206246",""],[5790,"بدا كقضيب البان والظبى إذ يعطو","https://www.poetsgate.com/ViewPoem.aspx?id=112067",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5997,"حَنَاْنِيْكِ","https://www.poetsgate.com/ViewPoem.aspx?id=214254",""],[6093,"أرى الحُبُّ حَلَّ نَفْسَا","https://www.poetsgate.com/ViewPoem.aspx?id=178428",""],[6102,"غيبوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184544",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["على خطراتها ترد المعاني","ورود الناس للبيت احتسابا",0,"ب",2,0],["عَلى خُلُقٍ لَم تُلفِ أُمّاً وَلا أَباً","عَلَيهِ وَلَم تُدرِك عَلَيه أَخاً لَكا",1,"ك",2,0],["عَلى خَصرِها مِنهُ وِشاحٌ مُفَصَّلٌ","وَفي رَأسِها تاجٌ وَفي جيدِها سِمطُ",2,"ط",1,0],["عَلى خالِدٍ أَصبَحتُ أَبكي لِخالِدٍ","وَأَصدُقُ نَفساً قَد أُصيبَ خَليلُها",3,"ل",3,1],["عَلى خَيرِ مَن يَندُبُ المُعوَلونَ","وَالسَيِّدِ الأَيِّدِ الأَفضَلِ",4,"ل",1,0],["عَلى خَوصاءَ يَذرفُ مَأقياها","مِن العِيديِّ قَد لَقيِت كَلالا",5,"ل",2,0],["عَلى خَصِراتِ المُستَقى بَعدَ هَجعَةٍ","بِأَمثالِها تَروى الصَوادي فَتَنقَعُ",6,"ع",1,0],["عَلى خَيلِ الرَسولِ غَداةَ لاقوا","مَناياهُم وَلاقَتهُم بِقَدرِ",7,"ر",1,0],["عَلى خُبَيبٍ وَفي الرَحمَنِ مَصرَعُهُ","لا فاشِلٍ حينَ تَلقاهُ وَلا نَزِقِ",8,"ق",1,0],["على خدي حميم من دموعي","صديق إن دنوا ونأوا سواء",9,"ا",2,0],["على خلفاء كثيرٍ أبرّ","بسؤدده الراسخ السامق",10,"ق",1,0],["عليَّ خشوع ظاهر واستكانةٌ","كأني أسير كانع في إساره",11,"ر",2,0],["على خطأ منهم فما السيف باترا","ولا الرمح عسالا ليلى بامثال",12,"ل",1,0],["عَلى خَوفِ أَعداءٍ وَرِقبَةِ كاشِحٍ","وَعَتبِ مَليكٍ جاوَزَ الحَدَّ في العَتبِ",13,"ب",1,0],["عَلى خَيرِ مَنعِيَّينِ إِلّا خَليفَةً","وَأَولاهُ بِالمَجدِ الَّذي كانَ أَرفَعا",14,"ع",2,0],["عَلى خالِدِ بنِ يَزيدَ بنِ مَز","يَدِ أَمرِ دُموعاً نَجيعاً بِماءِ",15,"ا",2,0],["على خضيلٍ أعارته طلاقَتها","شمسُ الربيع وأهدته الرياحينا",16,"ن",2,0],["عَلَى خَرْقَاءَ يَكرهُ مَن يراها","طِلابَ الوُدِّ مِنها والوصالِ",17,"ل",1,0],["عَلى خَير ما نَرجوه كانَ كِلاهُما","جِهاداً وَإِسعاداً وَغَيباً وَمَشهَدا",18,"د",2,0],["عَلى خَطمِها وَاِستَوهَبَت ثُمَّ طَوقِها","وَقالَت أَلا لا تَجعَلِ الطَوقَ بالِيا",19,"ا",1,0],["عَلى خُزاماها وَحَوذانِها","وَمُشكِلٍ مِن حُلَلِ الزَهرِ",20,"ر",1,0],["عَلى خُبزِ إِسماعيلَ واقِيَةُ البُخلِ","فَقَد هَلَّ في دارِ الأَمانِ مِنَ الأَكلِ",21,"ل",1,1],["عَلى خَشَباتِ المُلكِ مِنكَ مَهابَةٌ","وَفي الدِرعِ عَبلُ الساعِدَينِ قَروعُ",22,"ع",1,0],["عَلى خَبيئِكَ أَستارٌ مُضاعَفَةٌ","بِالعَقلِ وَالصَمتِ وَالأَبوابِ وَالجُدُرِ",23,"ر",1,0],["عَلى خُلقِ العَجوز غَدا بَنوها","لَهُم وِردٌ مِنَ الغَدرِ المَعينِ",24,"ن",1,0],["عَلى خَيرِ ما أَبصَرتَها مِن بِضاعَةٍ","لِمُلتَمِسٍ بَيعاً بِها أَو تَبَكُّلا",25,"ل",2,0],["عَلى خُرسٍ خَلاخِلُها خِدالٍ","كَمَشي الخَيلِ بِالمِعزا وَجِينا",26,"ن",2,0],["على خديك خمرُ","صبابةٍ أفرغها دنَّا",27,"ن",2,0],["على خَيْرِ مَنْ حَمَلَتْ نَاقَةٌ","وأَتْقَى البَرِيَّةِ عِنْدَ التُّقَى",28,"ا",1,0],["على خير البرية من نزار","شفيع الخلق أحمدٍ النبيّ",29,"ي",1,0],["عَلى خَيرِ حافٍ مِن قُرَيش وَناعِلٍ","إِذا الخَيرُ يُرجى أَو إِذا الشَرُّ حاضِرُ",30,"ر",1,0],["عَلى خَيرِ مَخلوقٍ مِن الجِنِّ والإِنسِ","سَلامٌ عَلى مَن لَيسَ خَلقٌ كَمِثلِهِ",31,"ه",1,0],["عَلى خَطإِ في الذَنبِ أَو عَن تَعَمُّدٍ","جَرآئِرُنا تُمحى بِجاهِ مُحَمَّدٍ",32,"د",1,0],["على خطبٍ يندى لروض بيانها","ضباب من البارود فهو مطيرُ",33,"ر",1,0],["عَلى خَدِّهِ جَمرٌ مِنَ الحُسنِ مُضرَمٌ","يَشُبُّ وَلَكِن في فُؤادي حَريقُهُ",34,"ق",2,0],["عَلى خُوانٍ مِنَ القَتلى كَأَنَّهُمُ","عَلى التَبايُنِ مِن حَولَيهِ إِخوانُ",35,"ن",1,0],["عَلَى خَيْرِ الْوَرَى عَيْنِ الْعُ","لاَ أصْلِ الْكَمَالاَتِ",36,"ت",1,0],["على خَفَقاتِ القَلبِ ينظمُ شِعرَهُ","فما هو وزَّانٌ ولا هو نحَّال",37,"ل",1,0],["على خَدَّيكِ أرخي لي خِماراً","فَلولا اللّيلُ ما اشتَقتُ النّهارا",38,"ر",2,0],["عَلى خير خلق اللَه حيا وَمَيتا","وأشرف مَولود لا شرف والد",39,"د",1,0],["عَلَى خلافَتِهِ الإِجْمَاعُ مُنْعَقدٌ","فحَاضِرُ الخَلقِ طَوعاً مِثلُ بَادِيهِ",40,"ي",2,0],["عَلى خَصرِهِ تَنضَمُّ عَشرُ أَنامِلٍ","وَفي سَرجِهِ النُعمى مِنَ الرِدفِ وَالبوسى",41,"س",2,0],["على ختم نظمى أحمد اللّه شاكرا","على فضل خير الرسل صفوة عدنان",42,"ن",1,0],["عَلى خَيرَةٍ كانَت أَمِ العِرسُ جامِحٌ","وَكَيفَ وَقَد سُقنا إِلى الحَيِّ مالَها",43,"ل",3,0],["عَلى خَطَرٍ مِن خَطرَةٍ في فُؤادِهِ","نَهَتهُ عَنِ العَذبِ الزُلالِ مَعَ الظَما",44,"م",2,0],["على خير البرايا","وآله والصحابات",45,"ت",1,0],["على خليل الإِله قد جعلت","بدراً سلاماً بقوله فكن",46,"ن",1,0],["على خبرة واللّه لم أر مثله","ولا سمعت أذناي في الشرق والغرب",47,"ب",1,0],["على خبز بر مع أرز مفلفل","لكثر ما يسقى من السمن غرغرا",48,"ر",2,0],["عَلى خَروفٍ وافِرٍ مُدَوَّرٍ","كَأَنَّهُ مُرَصَّعٌ بِالجَوهَرِ",49,"ر",1,0],["عليٌّ خُزامِيُّ الشَذا نورُ عينِهِ","حِبالُ مَعانيهِ الطِّوالُ حِبَالُهُ",50,"ل",2,0],["عَلى خَمسِ الصَلاةِ وَصَومِ شَهرٍ","وَإيتاءِ الزَكاةِ بِلا اِقتِفافِ",51,"ف",1,0],["عَلى خِندِفِ القَومِ عِندَ البَلا","ءِ أَمسى يُغَيَّبُ في مُلحَدٍ",52,"د",1,0],["على خير خلق الله طه وآله","وأصحابه مع من لهم كان تاليا",53,"ي",2,0],["عَلى خَبَندى قَصَبٍ مَمكورِ","كَعُنقُراتِ الحائِرِ المَسكورِ",54,"ر",1,0],["عَلَى خَدَّيْهِ مَاءٌ عَسْجَدِيٌّ","إِذَا نَظَرَ الرَقِيْبُ إِلَيْهِ غَاضَا",55,"ض",2,0],["على خَاطِري يا شُغْله منكَ أَشْغَالُ","وفي ناظِري يا نورَه منكَ تِمْثَالُ",56,"ل",1,1],["على خلوةٍ لم يجرِ فيها تنَغُّصٌ","بها عاد وجهُ الليل عنديَ أبيضا",57,"ض",2,0],["على خدي ابريز","بمسك الخال مقشوش",58,"ش",1,0],["على خضيب الأطراف من دمه","يا هول أطرافه الخضيبات",59,"ت",1,0],["على خفاف المعارق","مْنحفات اللون",60,"ن",1,0],["عَلى خَدِّها مُسوَدُّ سالِفِها بَدا","وَفيهِ اِعوِجاجٌ لَيتَ روحي لَهُ الفِدا",61,"د",2,1],["عَليُّ خَلقٍ فَخُلقٍ مِن مَحاسِنِهِ","إِتيانُهُ فيهِ طبقَ الفَرضِ وَالسّننِ",62,"ن",1,0],["عَلى خَدِّهِ القاني لَقَد كَتَبَ البها","سُطورَ عِذار غِبت فيها عَنِ الحسِّ",63,"س",1,1],["عَلى خَدِّهِ خافَ البها أَعين الوَرى","فَخَطّ بِهِ مِن مِسكهِ آيةَ الكرسي",63,"ي",1,0],["عَلى خَيرٍ وَهَديٍ ثمّ سَمْتٍ","بِحُسنِ الخَلقٍ يَبدو ذا اِتّسامِ",64,"م",1,0],["عَلى خَدّهِ الخيلانِ مِنها ثَلاثَة","كَمِثلِ الثريّا فَأُخرى فَثِنتانِ",65,"ن",1,1],["عَلى خَدِّه الوردُ اِستَدارَ وَقَد زَها","وَفي نِصفِهِ خالٌ بِهِ كانَ هتْكي",66,"ي",1,1],["عَلى خصرِهِ والرِّدفِ قد ماجَ شعرُهُ","فَأَوقعَ قَلبي في الطَّويلِ العريضِ",67,"ض",1,1],["عَلى خَيرِ ما كانَ الرِجالُ رَأَيتُهُ","وَما الخَيرُ إِلّا طُعمَةٌ وَنَصيبُ",68,"ب",1,0],["على خطوكَ الباسِل ِالمُسْتفزِّ","جَميعُ مَنابِتِهَا تلتقي",69,"ق",2,0],["عَلَى خَدَّيْكِ تَنْتَحِرُ القَوَافِي","وَمِنْ لَهَبِ الجَوَى اللهُ أَكْبَرْ",70,"ر",1,0],["عَلىَ خَيْرِ مَبْعُوثٍ فَضَائِلُهُ تُرْوى","لَقَدْ ظَفِرُوا بِالْقُرْبِ مِنْ بَعْدِ بُعْدِهِمْ",71,"م",1,0],["على خضرائه استولى فريق","لآخر فيه من رطب ويبسِ",72,"س",1,0],["عَلَى خَدّهِ خَالٌ بِهِ بَدَأ الهَوَى","وَمِنْ نَقْطِهِ في اللَّوْحِ يَبْتَدِئُ الخَطُّ",73,"ط",1,0],["على خَطمِ جَونٍ قد بدا من ظلاله","غِطاءٌ يكفُّ الناظراتِ بَهيمُ",74,"م",1,0],["على خير ما كانت تكون جماعة","على الدين دينا ليس فيه صدوع",75,"ع",1,0],["عَلى خَير حزم في الأُمور وَلا تقىً","وَلا نائلٍ جزل تُعدّ مَواهبه",76,"ب",2,0],["على خاتمِ الرُّسُلِ السَّابقينَ","وأَوَّلِهِمْ في قَديم القَضاءِ",77,"ا",2,0],["على خير مرسول إلى خير أمة","صلاتك ربي مع عظيم التحية",78,"ه",1,1],["على خضوع وحب وافر وعلى","جميل زاد وارشاد وحسن ثنا",79,"ن",2,0],["على خلاف وهو عين الواجب","في مذهب رأى به ابن الحاجب",80,"ب",1,0],["على خلاف فيه ثم لا جرم","مثلّث وأيهم به التزم",80,"م",1,0],["على خَدٍ يُجمش وجنتيه","عناقيدٌ مُزرفنة البطاقِ",81,"ق",1,0],["على خيولِ الغرور يركضها","وفي ذيول السرور يسْحَبُها",82,"ب",3,0],["عَلى خَضيب كفها","من الضنى مشارب",83,"ب",1,0],["على خد موسى ما أقلَّت كؤوسُه","وما أترعت بين المحبين عيناه",84,"ه",1,1],["على خطر أو آن الليل منه","لعاد شباب راكبه اكتهالا",85,"ل",2,0],["على خَطرٍ لو أنّ الليل مِنْهُ","لعادَ شبابُ راكبه اكتهالا",86,"ل",2,0],["على خلاف الأصل في الرضاعه","فيما رووا وقرروا إتباعه",87,"ه",1,1],["على خير ما يعلى الفتى من مناقب","بناها له من قبله أبوان",88,"ن",1,0],["على خده ورد الشقائق طالع","وورد الاقاحي واللئالي ثناياه",89,"ا",2,0],["على خُطَطٍ منهنّ كَوْني مُعَظَّماً","ببيضَةِ عِزٍّ منكِ لا تَتَصَدَّعُ",90,"ع",1,0],["عَلى خَيرِ مَبعوثٍ إِلى خَيرِ أُمَّةٍ","كَذا آلِهِ الأَطهار مَع كُلِّ صاحِبِ",91,"ب",1,0],["على خدرها هجمت من بني","امية بالطف أرذالها",92,"ل",3,0],["على خطرٍ تمسي وتصبح لاهباً","أتدري بماذا لو عقلت تخاطرُ",93,"ر",1,0],["على خير خلق اللَه خاتم الأنبيا","شفيع الورى في منتهى النشر والحشر",94,"ر",1,0],["علَى خلُقٍ عَظِيمٍ كانَ إرثاً","مِن المختارِ أفعالاً وقِيلا",95,"ل",2,0],["على خامل مني بنفسيَ ثائر","وفي قانع مني طُموح تضرما",96,"م",2,0],["عَلى خائِف مثلي أَتى يَستَجيرها","كَفى مقلتي يوم القدوم وَحسبها",97,"ه",2,0],["عَلَى خَطْوِكَ الظَّافِرِ المُسْتَنِيْرْ","سَأَمْضِيْ وَحِيْدًا كَرِهْتُ الهَبَاءْ!",98,"ا",2,0],["على خدّه خطّ لهُ فضلُ دائر","لهُ غايةٌ في الإرتفاع مُنزّلُ",99,"ل",1,0],["على خيل تسير بلا ركاب","وتانف من مسابقة الجياد",100,"د",1,0],["على خلاف جرى في غير كعبتنا","بين الاكابر من اشياخ فقههم",101,"م",1,0],["على خَدِّه مُذْ لاح نَبْت