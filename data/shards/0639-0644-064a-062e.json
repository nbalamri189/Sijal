{"poems":[[24,"ألا أبلغا عني بجيرا رسالة","https://www.aldiwan.net/poem21874.html","الطويل"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[35,"على خالد أصبحت أبكي لخالد","https://www.aldiwan.net/poem39105.html","الطويل"],[10,"أعيني فيضي ولا تبخلي","https://www.aldiwan.net/poem21127.html","السريع"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[30,"أمن دمنة بين القلات وشارع","https://www.aldiwan.net/poem29572.html","الطويل"],[23,"على قتلى معونة فاستهلي","https://www.aldiwan.net/poem21358.html","الوافر"],[23,"ما بال عينك لا ترقا مدامعها","https://www.aldiwan.net/poem21362.html","البسيط"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[89,"نصبت لليلى من قريض نحته","https://www.aldiwan.net/poem44789.html","الطويل"],[45,"ذكرت وصيفا ذكرة الهائم الصب","https://www.aldiwan.net/poem10664.html","الطويل"],[28,"ألا سلت الله ابن سلتى كما نعى","https://www.aldiwan.net/poem5280.html","الطويل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[105,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[102,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[48,"آذنك الناقوس بالفجر","https://www.aldiwan.net/poem63267.html","السريع"],[48,"على خبز إسماعيل واقية البخل","https://www.aldiwan.net/poem65041.html","الطويل"],[50,"أأبكاك داع في الصباح سميع","https://www.aldiwan.net/poem62338.html","السريع"],[46,"ما للبصائر لا تخلو من السدر","https://www.aldiwan.net/poem22660.html","البسيط"],[46,"ذممتك أم دفر فاسمعيني","https://www.aldiwan.net/poem23527.html","الوافر"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[40,"","https://poetry.dctabudhabi.ae/diwan/poem/93187","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67357","المتقارب"],[126,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[132,"أرقت ودمع العين في العين غائر","https://www.aldiwan.net/poem21007.html","الطويل"],[148,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[148,"تبارك رب عمنا بحبائه","https://www.aldiwan.net/poem68601.html","الطويل"],[197,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[230,"حكاه من الغصن الرطيب وريقه","https://www.aldiwan.net/poem14810.html","الطويل"],[233,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[235,"ألا إن السيادات","https://www.aldiwan.net/poem18093.html","الهزج"],[268,"أحبتنا هل في النوى ينعم البال","https://www.aldiwan.net/poem35615.html","الطويل"],[268,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[269,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[273,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[280,"سقى الله ديرا فيه نادمت قسيسا","https://www.aldiwan.net/poem32728.html","الطويل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[335,"ألا أصبحت عرسي من البيت جامحا","https://www.aldiwan.net/poem45421.html","الطويل"],[364,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[400,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[400,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[466,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[498,"ولما أتينا أرض حيش وعندنا","https://www.aldiwan.net/poem37816.html","الطويل"],[534,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[534,"أيا عين جودي ولا تسأمي","https://www.aldiwan.net/poem23868.html","المتقارب"],[556,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[565,"غدا وغدا تورد وجنتيه","https://www.aldiwan.net/poem69626.html","الوافر"],[573,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"]],"verses":[["عَلى خُلُقٍ لَم تُلفِ أُمّاً وَلا أَباً","عَلَيهِ وَلَم تُدرِك عَلَيه أَخاً لَكا",0,"ك",2,0],["عَلى خَصرِها مِنهُ وِشاحٌ مُفَصَّلٌ","وَفي رَأسِها تاجٌ وَفي جيدِها سِمطُ",1,"ط",1,0],["عَلى خالِدٍ أَصبَحتُ أَبكي لِخالِدٍ","وَأَصدُقُ نَفساً قَد أُصيبَ خَليلُها",2,"ل",3,1],["عَلى خَيرِ مَن يَندُبُ المُعوَلونَ","وَالسَيِّدِ الأَيِّدِ الأَفضَلِ",3,"ل",1,0],["عَلى خَوصاءَ يَذرفُ مَأقياها","مِن العِيديِّ قَد لَقيِت كَلالا",4,"ل",2,0],["عَلى خَصِراتِ المُستَقى بَعدَ هَجعَةٍ","بِأَمثالِها تَروى الصَوادي فَتَنقَعُ",5,"ع",1,0],["عَلى خَيلِ الرَسولِ غَداةَ لاقوا","مَناياهُم وَلاقَتهُم بِقَدرِ",6,"ر",1,0],["عَلى خُبَيبٍ وَفي الرَحمَنِ مَصرَعُهُ","لا فاشِلٍ حينَ تَلقاهُ وَلا نَزِقِ",7,"ق",1,0],["على خدي حميم من دموعي","صديق إن دنوا ونأوا سواء",8,"ا",2,0],["على خلفاء كثيرٍ أبرّ","بسؤدده الراسخ السامق",9,"ق",1,0],["عليَّ خشوع ظاهر واستكانةٌ","كأني أسير كانع في إساره",10,"ر",2,0],["على خطأ منهم فما السيف باترا","ولا الرمح عسالا ليلى بامثال",11,"ل",1,0],["عَلى خَوفِ أَعداءٍ وَرِقبَةِ كاشِحٍ","وَعَتبِ مَليكٍ جاوَزَ الحَدَّ في العَتبِ",12,"ب",1,0],["عَلى خَيرِ مَنعِيَّينِ إِلّا خَليفَةً","وَأَولاهُ بِالمَجدِ الَّذي كانَ أَرفَعا",13,"ع",2,0],["عَلى خالِدِ بنِ يَزيدَ بنِ مَز","يَدِ أَمرِ دُموعاً نَجيعاً بِماءِ",14,"ا",2,0],["على خضيلٍ أعارته طلاقَتها","شمسُ الربيع وأهدته الرياحينا",15,"ن",2,0],["عَلَى خَرْقَاءَ يَكرهُ مَن يراها","طِلابَ الوُدِّ مِنها والوصالِ",16,"ل",1,0],["عَلى خَير ما نَرجوه كانَ كِلاهُما","جِهاداً وَإِسعاداً وَغَيباً وَمَشهَدا",17,"د",2,0],["عَلى خَطمِها وَاِستَوهَبَت ثُمَّ طَوقِها","وَقالَت أَلا لا تَجعَلِ الطَوقَ بالِيا",18,"ا",1,0],["عَلى خُزاماها وَحَوذانِها","وَمُشكِلٍ مِن حُلَلِ الزَهرِ",19,"ر",1,0],["عَلى خُبزِ إِسماعيلَ واقِيَةُ البُخلِ","فَقَد هَلَّ في دارِ الأَمانِ مِنَ الأَكلِ",20,"ل",1,1],["عَلى خَشَباتِ المُلكِ مِنكَ مَهابَةٌ","وَفي الدِرعِ عَبلُ الساعِدَينِ قَروعُ",21,"ع",1,0],["عَلى خَبيئِكَ أَستارٌ مُضاعَفَةٌ","بِالعَقلِ وَالصَمتِ وَالأَبوابِ وَالجُدُرِ",22,"ر",1,0],["عَلى خُلقِ العَجوز غَدا بَنوها","لَهُم وِردٌ مِنَ الغَدرِ المَعينِ",23,"ن",1,0],["عَلى خَيرِ ما أَبصَرتَها مِن بِضاعَةٍ","لِمُلتَمِسٍ بَيعاً بِها أَو تَبَكُّلا",24,"ل",2,0],["عَلى خُرسٍ خَلاخِلُها خِدالٍ","كَمَشي الخَيلِ بِالمِعزا وَجِينا",25,"ن",2,0],["على خديك خمرُ","صبابةٍ أفرغها دنَّا",26,"ن",2,0],["على خَيْرِ مَنْ حَمَلَتْ نَاقَةٌ","وأَتْقَى البَرِيَّةِ عِنْدَ التُّقَى",27,"ا",1,0],["على خير البرية من نزار","شفيع الخلق أحمدٍ النبيّ",28,"ي",1,0],["عَلى خَيرِ حافٍ مِن قُرَيش وَناعِلٍ","إِذا الخَيرُ يُرجى أَو إِذا الشَرُّ حاضِرُ",29,"ر",1,0],["عَلى خَيرِ مَخلوقٍ مِن الجِنِّ والإِنسِ","سَلامٌ عَلى مَن لَيسَ خَلقٌ كَمِثلِهِ",30,"ه",1,0],["عَلى خَطإِ في الذَنبِ أَو عَن تَعَمُّدٍ","جَرآئِرُنا تُمحى بِجاهِ مُحَمَّدٍ",31,"د",1,0],["على خطبٍ يندى لروض بيانها","ضباب من البارود فهو مطيرُ",32,"ر",1,0],["عَلى خَدِّهِ جَمرٌ مِنَ الحُسنِ مُضرَمٌ","يَشُبُّ وَلَكِن في فُؤادي حَريقُهُ",33,"ق",2,0],["عَلى خُوانٍ مِنَ القَتلى كَأَنَّهُمُ","عَلى التَبايُنِ مِن حَولَيهِ إِخوانُ",34,"ن",1,0],["عَلَى خَيْرِ الْوَرَى عَيْنِ الْعُ","لاَ أصْلِ الْكَمَالاَتِ",35,"ت",1,0],["على خَفَقاتِ القَلبِ ينظمُ شِعرَهُ","فما هو وزَّانٌ ولا هو نحَّال",36,"ل",1,0],["على خَدَّيكِ أرخي لي خِماراً","فَلولا اللّيلُ ما اشتَقتُ النّهارا",37,"ر",2,0],["عَلى خير خلق اللَه حيا وَمَيتا","وأشرف مَولود لا شرف والد",38,"د",1,0],["عَلَى خلافَتِهِ الإِجْمَاعُ مُنْعَقدٌ","فحَاضِرُ الخَلقِ طَوعاً مِثلُ بَادِيهِ",39,"ي",2,0],["عَلى خَصرِهِ تَنضَمُّ عَشرُ أَنامِلٍ","وَفي سَرجِهِ النُعمى مِنَ الرِدفِ وَالبوسى",40,"س",2,0],["على ختم نظمى أحمد اللّه شاكرا","على فضل خير الرسل صفوة عدنان",41,"ن",1,0],["عَلى خَيرَةٍ كانَت أَمِ العِرسُ جامِحٌ","وَكَيفَ وَقَد سُقنا إِلى الحَيِّ مالَها",42,"ل",3,0],["عَلى خَطَرٍ مِن خَطرَةٍ في فُؤادِهِ","نَهَتهُ عَنِ العَذبِ الزُلالِ مَعَ الظَما",43,"م",2,0],["على خير البرايا","وآله والصحابات",44,"ت",1,0],["على خليل الإِله قد جعلت","بدراً سلاماً بقوله فكن",45,"ن",1,0],["على خبرة واللّه لم أر مثله","ولا سمعت أذناي في الشرق والغرب",46,"ب",1,0],["على خبز بر مع أرز مفلفل","لكثر ما يسقى من السمن غرغرا",47,"ر",2,0],["عَلى خَروفٍ وافِرٍ مُدَوَّرٍ","كَأَنَّهُ مُرَصَّعٌ بِالجَوهَرِ",48,"ر",1,0],["عليٌّ خُزامِيُّ الشَذا نورُ عينِهِ","حِبالُ مَعانيهِ الطِّوالُ حِبَالُهُ",49,"ل",2,0],["عَلى خَمسِ الصَلاةِ وَصَومِ شَهرٍ","وَإيتاءِ الزَكاةِ بِلا اِقتِفافِ",50,"ف",1,0],["عَلى خِندِفِ القَومِ عِندَ البَلا","ءِ أَمسى يُغَيَّبُ في مُلحَدٍ",51,"د",1,0],["على خير خلق الله طه وآله","وأصحابه مع من لهم كان تاليا",52,"ي",2,0],["عَلى خَبَندى قَصَبٍ مَمكورِ","كَعُنقُراتِ الحائِرِ المَسكورِ",53,"ر",1,0],["عَلَى خَدَّيْهِ مَاءٌ عَسْجَدِيٌّ","إِذَا نَظَرَ الرَقِيْبُ إِلَيْهِ غَاضَا",54,"ض",2,0],["على خَاطِري يا شُغْله منكَ أَشْغَالُ","وفي ناظِري يا نورَه منكَ تِمْثَالُ",55,"ل",1,1]]}