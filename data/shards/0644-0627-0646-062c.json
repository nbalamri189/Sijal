{"poems":[[74,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[53,"لا تعذلوا عرس أبي غانم","https://www.aldiwan.net/poem66489.html","السريع"],[46,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85495","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[92,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[119,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[300,"سائل بنا خابر أكفائنا","https://www.aldiwan.net/poem1136.html",""],[408,"يا هاجرين ولا ذنب ولا سبب","https://www.aldiwan.net/poem46538.html","البسيط"],[411,"اعرف زمانك واقبل ما يجود به","https://www.aldiwan.net/poem49994.html","البسيط"],[415,"إليك فما تثني شؤونك شاني","https://www.aldiwan.net/poem32160.html","الطويل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48806","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77625","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112956","الطويل"],[1591,"","https://poetry.dctabudhabi.ae/diwan/poem/203986",""],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141316","البسيط"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198891","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111247","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65946","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132569","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127018","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4086,"","https://poetry.dctabudhabi.ae/diwan/poem/198808",""],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123509","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83184","الكامل"],[4768,"عشق دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=213022",""],[4796,"الى الاستاذ الشاعر يوسف الخطيب","https://www.poetsgate.com/ViewPoem.aspx?id=34722",""],[4578,"بفاتر جفنه فتن البريا","https://www.poetsgate.com/ViewPoem.aspx?id=49617",""],[4929,"مآلاتُ اللاءات","https://www.poetsgate.com/ViewPoem.aspx?id=208656",""],[4981,"إلى أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=190477",""],[5351,"خسرتم","https://www.poetsgate.com/ViewPoem.aspx?id=202633",""],[5674,"رباه هذا البعد ليل قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=189072",""],[5701,"جنود لصوص في القناة تجمعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164588",""],[5751,"أحزان أرضية لطفلٍ سماوي","https://www.poetsgate.com/ViewPoem.aspx?id=214761",""],[5791,"غزلٌ فتيّ ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208173",""],[5906,"حين ملَّ الصَّمت","https://www.poetsgate.com/ViewPoem.aspx?id=188225",""],[5956,"تقول الطماطم:","https://www.poetsgate.com/ViewPoem.aspx?id=193921",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""]],"verses":[["لأنجمها وصل السعود بذكرِكم","إذا أنجمٌ أخنت عليها قطوعها",0,"ع",3,0],["لأن جرذانَ أبي غانم","في اللوحِ مشكولٌ بتسكينه",1,"ن",2,0],["لا نَجمَ مِن مَعشَرٍ إِلّا وَهِمَّتُهُ","عَلَيكَ دائِرَةٌ يا أَيُّها القُطُبُ",2,"ب",1,0],["لا نجح إلا وَالمشقة أمُّه","كالنور يظهر حيث تَذكو النار",3,"ر",1,0],["لا نجم لا مصباح","يلمع في السهل",4,"ل",1,1],["لا نجمَ لا مصباح","يلمعُ من بُعد",4,"د",1,0],["لانجاب عُسْرٌ من فرائسه","صِيدُ الرجال ولا رتَمى اليسر",5,"ر",1,0],["لان جهل الزمان بشأن مثلي","فبعض خصاله السود التعامي",6,"م",2,0],["لا نجمَ فوقَ طُلولِها يُرعى ولا","بَرقٌ على الآفاقِ ثمَّ يُشام",7,"م",1,0],["لا نجعلُ الباطلَ حقَّاً ولا","نلظُّ دونَ الحقِّ بالباطِلِ",8,"ل",1,0],["لأن جَفوتمْ فَبابُ العذر مُتّسِعٌ","وإن قَطَعتُم فحبلُ الوِدِّ مُتّصِلُ",9,"ل",1,0],["لأنّ جُلَّ بنيهِ يقتدُونَ بِهِ","في حَلِّ ما حَلَّلهُ أو عَقْدِ ما عَقَدا",10,"د",2,0],["لأنَّ جميلَ الذكرِ يَبقى لأهلِه","وكلُّ الذي فوقَ البسيطة فانِ",11,"ن",1,0],["لأنجبتْ بطنُ حامل ولدتْ","محمداً وابنَ أمِّه الكَرَما",12,"م",2,0],["لا نجاة إلا بجمعكم الشم","لَ قوياً وبالنفوس كبارا",13,"ر",2,0],["لِأَن جلدي شَعرُهُ مَنقوش","تصرف في تَحصيلِه القُروش",14,"ش",1,0],["لأنَ جرحَكَ أذكى","منَ النحيبِ المُزيَّفْ",15,"ف",1,0],["لان جناب الحق سبحانه يحب أن","قد عفا عبد ويجزيه بالخير",16,"ر",1,0],["لا نجم إلا ناجم ال","راح بدا ثم أفل",17,"ل",1,0],["لا نجحد الفضل لكن قد يجوز لنا","عتب الأحبة من حين إلى حين",18,"ن",1,0],["لإنجيل عيسى في ثناه تتابع","وكان لما يثنى عليه له أهلا",19,"ل",2,0],["لأَنجُوَ مِن سُوءِ الإماتَةِ وَالرَّجيم","وَيَنزِلُ رُوحُ اللهش عِندِى وَيَطرُدَا",20,"د",2,0],["لَأَنجبت فاطمةٌ مَولداً","فيكَ رَعاكَ اللَه مِن فاطمي",21,"م",2,0],["لأَن جَرَت لَفظة التَوحيد في فَمه","فَسَيفه بِسوى التَوحيد ما فَتَكا",22,"ك",2,0],["لا نجدة يلقى العدو بها ولا","منجى يقيه من أذى الأعداء",23,"ا",2,0],["لأن جزعت لمرتحلي فإني","ظفرت بأن قصدت فتى جوادا",24,"د",2,0],["لأن جرت الأقلام بالحبر حجة","فمن بعدها بالبيض ماء القماحد",25,"د",1,0],["لا نجدة للمستغيث ولا روى","يشفي غليل حشاشة تتوقد",26,"د",1,0],["لان جلمود عليك من الاسى","فمروة قلب الموت ليس تلين",27,"ن",1,0],["لانجزت في اهدائه لي موعداً","به عاد مبيضا سواد مفارقي",28,"ق",2,0],["لِأَنَّ جَدَّهُ النَبِيُّ المُصطَفى","أَزكى جَميعُ الخَلقِ مِن غَيرِ خَفا",29,"ف",2,0],["لأنجاله، للشعب، للعُربِ والورَى","وللمسلمين الذَّاكرين عطاياه",30,"ا",2,0],["لانجاز ذى السخا الكثير العطا الشفا","توجه بصدق حايم غيظه ترضى",31,"ض",2,0],["لأن جباهكم دلت وحاشا","لذياك الدليل من احتمال",32,"ل",1,0],["لا نَجحَدُ الغَربيَّ سِحرَ بَيانِهِ","لَكنَّ سُوءَ العَقلِ عَنهُ يُحيلُ",33,"ل",1,0],["لأنّ جمالها يسبي عقولاً","وسحر عيونها صخراً يشقُّ",34,"ق",1,0],["لأنّ جذورها رسختْ وباتتْ","يؤمُّ ربوعَها غرْبٌ وشْرقُ",34,"ق",1,0],["لأنَّ جَلَّ وُلاة الأمر مصطَنَعٌ","والغرب قبلتهم والحج للنُّصُبِ",35,"ب",1,0],["لأن جل الأولى حمدوا بفضل","فإنك أنت أحمدهم سجيه",36,"ي",2,0],["لا نجتْ عِيرُكم مِنَ السلبِ أو عا","دتْ بَكَاراتُكُمْ كَمَا كُنَّ عُزْبَا",37,"ب",2,0],["لأنّ جوارَها أمنٌ وفيرٌ","وترياقٌ وسلطانٌ ومالُ",38,"ل",1,0],["لأن جراحاتنا كلها","غدت بالحميم هنا نازفة",39,"ف",2,0],["لا نجمةٌ ترنو لألثم سحرها","وتموسقت بالحب شدو كناري ..",40,"ر",2,0],["لانجلترا يعزون فاعجب لأمة","تجيع جميع العالمين لتشبعا",41,"ع",2,0],["لأنّ جميعَ العصورِ بهِ","توحّدنَ إذْ هُنَّ أزمانُهُ",42,"ن",2,0],["لأنَّ جراحنا غزلٌ فتيٌّ","بكلّ عيوننا سيقومُ كهفُ",43,"ف",1,0],["لا نجافي الغيض حتى لو دنا","من نفوس لا يهاديها المزاح",44,"ح",1,0],["لأن جمالَ رفاهٍ يُنَمِّي","جميع الجمال بخصبِ قواها..",45,"ا",3,0],["لا نجعة الريف والمرعى الوريف لها","قصد ولا الري مطلوب ومأمول",46,"ل",1,0],["لأن جبالها انهارت","تساوى الشَّمُّ والسفحُ",47,"ح",1,0]]}