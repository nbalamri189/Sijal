,"مجزوء الوافر"],[459,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[459,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[459,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[459,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[459,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[459,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[462,"قل للمجاهد قولا عن أخي ثقة","https://www.aldiwan.net/poem15159.html","البسيط"],[462,"معاذ الله أن أزجي عتابا","https://www.aldiwan.net/poem15178.html","الوافر"],[465,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[480,"هي الأعمار نقص في ازدياد","https://www.aldiwan.net/poem36938.html","الوافر"],[480,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[483,"ألا ليت شعري ما تقول عظائم الد","https://www.aldiwan.net/poem24527.html","عموديه"],[501,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[501,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[505,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[516,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[516,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[552,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[562,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[565,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[565,"أحبابنا لو تعلمون بحالنا","https://www.aldiwan.net/poem895.html",""]],"verses":[["ولو نظروا الغداة رأوا عظيما","محا ذكر الأواخر والأوالي",0,"ل",2,0],["وَلَو نَفَضَت تِلكَ الثَنِيّاتُ بَردَها","عَلى الصَبِرِ المَمرورِ كادَ يَطيبُ",1,"ب",1,0],["وَلو نِمْتُ زارَتني الَّتي ما ذكرْتُها","فَتَشرَقَ إِلّا بالنَجيعِ المدامِعُ",2,"ع",1,0],["وَلَوْ نِيلَتِ الأَرْزاقُ بِالفَضلِ وَالحِجَى","لَمَا كانَ يَرْجُو أَنْ يَثُوبَ لَهُ وَفْرٌ",3,"ر",1,0],["ولوْ نُتِجَتْ أضْحَتْ قَوابِلَها القَنا","ولمْ يُغْذَ إلا بالدِّماءث سَليلُها",4,"ل",3,0],["ولَوْ نَطَقَ المَطِيُّ لَبَثَّ وَجْداً","يؤرِّقُنا بألْسِنَةٍ فِصاحِ",5,"ح",1,0],["وَلَو نَطَقَت شَكوى الهَوى كُلُّ شَعرَةٍ","عَلى جَسَدي مِمّا تُجِنُّ الحَيازِمُ",6,"م",1,0],["وَلَوْ نُشِرَ الطَّائِي يَوْمَ اجْتِلاَئِهَا","لَجَلَّلَهُ مِنْ أَجْلِ إِيثَارِهَا غَمُّ",7,"م",1,0],["وَلَو نَظَروا الصَباحَ إِذاً لَذاقوا","بِأَطرافِ الأَسِنَّةِ ما قِرانا",8,"ن",2,0],["وَلو نَذِرَ الحَيّانِ غِبَّ السُرى بِنا","لَكَرَّت عُظالى أَو لَعادَ كُلابُ",9,"ب",1,0],["وَلَو نَزَلَت مِثلُ الَّذي نَزَلَت بِهِ","تَرَكنَ المُذَرّى مِن أَجا يَتَصَدَّعا",10,"ع",2,0],["وَلَو نادَيتَهُ لَأَتاكَ يَسعى","حَثيثَ الرَكضِ أَو لَأَتاكَ يَجري",11,"ر",2,0],["ولو نال بالأخلاص مُثرٍ ثراءه","لما كنت تلقي بيننا غير مفلس",12,"س",1,0],["وَلَو نَزَلوا بِالبَيتِ ما باتَ آمِناً","حَمامٌ لَدى البَيتِ الحَرامِ قَطونُ",13,"ن",1,0],["وَلَو نَحنُ عاقَدنا الزُبَيرَ لَقيتَهُ","مَكانَ أُنوقٍ ما تُنالُ وُكورُها",14,"ر",3,0],["وَلو نَزَلَ الزُبَيرُ بِنا لَجَلّى","زِيادُ فَوارِسي رَهَجَ القَتامِ",15,"م",1,0],["وَلَو نيلَتِ الدُنيا بِفَضلٍ مَنَحتُها","فَضائِلَ تَحويها وَتَبقى فَضائِلُ",16,"ل",1,0],["وَلَو نَطَقَت رِحالُ المَيسِ قالَت","ثَقيفٌ شَرُّ مَن فَوقَ الرِحالِ",17,"ل",1,0],["ولو نوزعت في فخرها قال ربها","نعم في يدي هذا الفخار وفي ملكي",18,"ك",2,0],["ولو نظرت عيني لغير جماله","لكان إذاً إنسانها غير إنسان",19,"ن",1,0],["ولو نُشروا لما نصروا وقالوا","أرَبْتَ فكان حقُّك ما يُريبُ",20,"ب",1,0],["ولو نشاء لقلنا","بل شفرتيه وحَدَّهْ",21,"د",2,0],["ولو نشاء لقلنا","مَهَزَّهُ وفِرِنْدَهْ",21,"د",2,0],["ولو نجا أقْسمَ لا يأتلي","أنْ ما رأى أثقبَ من نَجْمي",22,"م",2,0],["ولو نظرتْ عيْناكِ يا أمُّ نَظْرةً","إلى ما توارى عنك مِنِّيَ واكتتمْ",23,"م",1,0],["ولو نستطيع وقَيْناهُمُ","وصناهمُ لك بين الجفون",24,"ن",1,0],["ولو نِكتُ أيضاً أمَّه لم يبالني","كما أنه لم يلتبِس بهجائيا",25,"ي",2,0],["وَلَو نَهَضَت عَنهُ السَماءُ وَمَخَّضَت","بِهِ الأَرضُ كانَ المُزنَ وَالتِبرَ وَالكَرما",26,"م",2,0],["وَلَونَها صافِيَةً","وَطَعمَها مُكَدَّرَه",27,"ر",2,0],["وَلَو نَزَلتُمُ بِهِ وَالدَهرُ مُعتَدِلٌ","نَزَلتُمُ بِعَروسِ المُلكِ عُمرانا",28,"ن",2,0],["وَلَو نَقَصتُ كَما قَد زِدتُ مِن كَرَمٍ","عَلى الوَرى لَرَأَوني مِثلَ شانيكا",29,"ك",2,0],["ولو نامَ بعضُ الحَيِّ أو غابَ ليلةً","لقرَّتْ عيونٌ واطمأنَّ جُنوبُ",30,"ب",1,0],["وَلَو نُصحاً أَرادَ لَكانَ فيهِ","عُبَيدُ اللَهِ أَسبَقَ مِن نَجاحِ",31,"ح",1,0],["وَلَو نَشاءُ شَرَعنا في تَطَوُّلِهِ","شُروعَنا فَأَخَذنا مِنهُ ما شينا",32,"ن",2,0],["وَلَو نَفَرتَ بِقَيسٍ لَاِحتَقَرتُهُمُ","إِلى تَميمٍ تَقودُ الخَيلَ وَالعَكَرا",33,"ر",2,0],["وَلَو نَعلَمُ العِلمَ الَّذي مِن أَمامِنا","لَكَرَّ بِنا الحادي الرِكابَ فَأَسرَعا",34,"ع",2,0],["وَلَو ناهَزوهُ المَجدَ أَربى عَلَيهِمُ","بِخَيرَ سُقاةٍ تَعلَمونَ وَغارِفِ",35,"ف",1,0],["ولو نَطَقَ الحَديدُ لنَابَ عنّي","ذُبابُ السَّيفِ أو حَدُّ السِّنانِ",36,"ن",1,0],["وَلَو نِلتَها بِحَذافيرِها","لَمُتَّ وَلَم تَقضِ مِنها الوَطَر",37,"ر",1,0],["وَلو نَسَبوا إِلَيهِ جَميعَ عِلمي","لَكانَ كَنُقطَةٍ في لُجِّ بَحرِ",38,"ر",1,0],["ولَو نَظَم الديماسُ مَنثورَ هامِهم","لَقلّدَ جيدَ القَصرِ منهُ سَخابا",39,"ب",2,0],["وَلَو نَفَحَتكُم ريحُ قَحطانَ نَفحَةً","بِنَكباءَ عَن وَجهِ الرِياحِ عَقيمِ",40,"م",1,0],["وَلَونانِ لَونٌ لَها أَصفَرٌ","وَلَونٌ عَلى الماءِ كَالعُصفُرِ",41,"ر",1,0],["وَلَو نازَعَتهُ الريحُ يَوماً إِزارَهُ","لَأَرسَلَهُ جوداً وَلَم يَتَجَرَّدِ",42,"د",1,0],["وَلَو ناجَتكَ أَقداحُ النَدامى","عَدَت عَن حَملِها مُتَنَدِّماتِ",43,"ت",1,0],["وَلَو نَحِسَت طَيٌّ لَأُلحِقَ حاتِمٌ","بِحَيٍّ سِواها مِثلِ تَغلِبَ أَو بَكرِ",44,"ر",1,0],["وَلَو نالَت عُقابُ اللوحِ لُبّاً","عَداها عَن تَكَفُّئِها التَكَفّي",45,"ف",2,0],["وَلَو نَضَحتَ عَلى خَدَّيكَ مِن نَدَمٍ","رَشاشَ دَمعٍ بِجَفنَي تائِبٍ غَسَلَك",46,"ك",1,0],["ولو نَشَدَتْ نَعْشاً هناكَ بَناتُه","لماتتْ ولم تَسْمَعْ لَه صَوْتَ مُنشِدِ",47,"د",1,0],["ولو نال ذو القرْنينِ ما نِلْتَ من غِنًى","بَنى السّدَّ من ذَوْبِ النُّضَارِ وَسامِهِ",48,"م",2,0],["ولو نِيطَ من نجمِ السماءِ فضيلةٌ","لمد إليها الكفَّ حتى ينالَها",49,"ل",3,0],["ولو نَظَرَ النُّدْمَانُ خَتمَ إنائِها","لأسكَرَهُمْ من دونِها ذلكَ الختم",50,"م",1,0],["ولو نَضحوا منها ثرَى قبرِ مَيّتٍ","لعادتْ اليه الرّوحُ وانتَعَشَ الجسم",50,"م",1,0],["ولو نالَ فَدْمُ القومِ لَثْمَ فِدَامِها","لأكْسبَهُ مَعنى شمائِلها اللّثْم",50,"م",1,0],["ولو نَطَقَتْ يوْماً لَقالَت أظنّكُمْ","تَخالُونَ أنّي مِن حِذارِ الرّدى أبكي",51,"ك",2,0],["وَلَوْنٌ ذَاكَ أَمْ نُورٌ","يُنِيرُ غَيَاهِبَ الدَّهْرِ",52,"ر",1,0],["ولو نَطَقتْ قالتْ هَلمَّ لمَصبحٍ","جميلٍ على الشطَّينِ مني ومَغْبِق",53,"ق",1,0],["ولو نَفَعتْ عِبرةٌ في الورى","لكانت حياتك أمَّ العبر",54,"ر",1,0],["ولو نختلف بشيا الغضب والرواقه","مانيب قايل ماتسوّيه سوّه",55,"و",2,0],["ولونا من السّمراء صيغت فتونه","بياضا نعم لكن بياضا تعرّبا",56,"ب",2,0],["ولو نكت أيضاً لم يبالني","كما أنه لم يلتبِس بهجائياً",57,"ي",2,0],["وَلَوَ کنَّها بَرَزَتْ لِمُنْتَصِبٍ","قَسٍّ، طَوِيلِ اللَّيلِ، يَبْتَهِلُهُ",58,"ل",2,0],["ولو نَضَحوا مِنها ثَرى قَبْرِ مَيتٍ،","لعادَتْ إليهِ الرُّوحُ، وانْتَعَشَ الجسْمُر",59,"م",2,0],["ولو نلت من ريّاك ريحاً أشمّها","لأمسى بها الجثمان أخضر ناميا",60,"ي",2,0],["ولو نَسى الناسُ إحسانَه","فما أنا منه بناسِي الجميلْ",61,"ل",1,0],["ولو ناغت صريعا في جبيل","لزل لها الصريع عن الجبيل",62,"ل",1,0],["ولَو نَثَرتُم كنَائِنَا عَلِمتُم","يَقِيناً أنَّ قَيدَكُم مُدَانَى",63,"ن",2,0],["ولو نجا الهائبُ الجبانُ من ال","حتف تحامىَ إقدامَه البطلُ",64,"ل",1,0],["ولو ندري بماء المزن يزري","لكان لنا على الظمإ احتمال",65,"ل",1,0],["ولو نَصَبوا رَحى بإِزاءِ دَمعي","لَكَانَتْ مِنْ تَحَدُّرِهِ تدورُ",66,"ر",1,0],["ولو نظروا الحديد بعين سخط","تصدع واكتسى ذلا وهنا",67,"ن",2,0],["ولو نلت فيها مال قارون لم تنل","سوى لقمة في فيك منه وخرقة",68,"ه",1,0],["ولو نالكم ما ساءكم في نفوسكم","قبلتم أو على عزمكم للأواخر",69,"ر",1,0],["وَلَو نامَ سَيفٌ بِالحُصيبِ وَلَم يَلِج","عَلى الهَولِ لَم يُدعَ المَليكَ المَمَجَّدا",70,"د",2,0],["ولو نِلْتُ منها ما يُوازَن بالقَذى","شفى كلَّ داءٍ في فؤاديَ حالفِ",71,"ف",1,0],["ولو نطق المجد المؤثل عن فم","لقال به اسطو وعنه اضارب",72,"ب",1,0],["وَلَو نالَ نَجم الدُجى ثَروَةً","وَأَوطَأَ شَمسَ الضُحى أَخمَصَه",73,"ص",2,0],["ولو نظر القومُ الغلاةُ لأيقنوا","معادَهُم ما دام آباؤهم مبدا",74,"د",2,0],["ولو نفساهما بدتا لعيني","لما ميزتُ أيّهما الكعابُ",75,"ب",1,0],["وَلَو نِلتَهُ طُلَّت هُناكَ جِراحُهُ","وَكانَ حَرِيّاً أَن يُهانَ وَيُهدَرا",76,"ر",2,0],["ولو نال غيرُك ما نلتَهُ","لفارَقَ أحبابَه وانتفى",77,"ف",2,0],["ولو نطقت شمس النهار لسبحت","بحمد الذي قد صاغهن من التبر",78,"ر",1,0],["ولو نطقت أحجار أرضٍ لسَلَّمتْ","عليك المُصَلَّى أو أتتك تسير",79,"ر",1,0],["وَلَوْ نُعْطَى الْخِيَارَ لَمَا افْتَرَقْنَا","وَلَكِنْ لاَ خِيَارَ مَعَ اللَّيَالِي",80,"ل",2,0],["ولو نظرت أحلامهم بعد نظرة","دعى بثبور في الرواسي ثبيرها",81,"ر",3,0],["ولونُها كانَ لون نَفسي","أيّامَ كانَ النَّدى نَثيرا",82,"ر",2,0],["وَلَوْ نَظَمْتُ نُجُومَ اللَّيْلِ مُمْتَدِحاً","لُمْ أَقْضِ مِنْ حَقِّكُمْ بَعْضَ الَّذِي وَجَبا",83,"ب",2,0],["وَلَو نَظَرت عينُ الشجاعِ اِحتفاله","إِذاً طَرَفت بَهراً وَلَم تنقَلِب لأطا",84,"ط",2,0],["وَلو نَظَرت بِالسخطِ أعينُ عدلهِ","إِلَيها غَدَت عَصفاً أكيلاً حشودها",85,"د",3,0],["ولو نارٌ نفحتَ بها أضاءت","ولكنأنتَ تنفُخُ في رَمَادِ",86,"د",1,0],["وَلَو نَفَعَت عِندَ الحَبيبِ ضَراعَةٌ","كَفَت أَدمُعٌ عَن مُهجَةٍ تَتَضَرَّعُ",87,"ع",1,0],["ولو نسِيَ اللهُ العِبادَ دَعَوْتُهُ","لِيذكُرَني لكِنَّهُ ليسَ بالنَّاسي",88,"س",2,0],["ولون الأَسنة مِمّا خضبن","كلون الدُخان عَلَيهِ اللَهَب",89,"ب",1,0],["ولو نظم الجوزاء فيك لما وفى","بها نظمه المُثني عليك ونثره",90,"ر",2,0],["ولو نبكي دماً حزناً عليهم","لما استوفى حقوقَهُم البكاء",91,"ا",2,0],["ولو نّ البخيلةَ ساعفَتْنا","بطيفٍ طارقٍ منها وَصولِ",92,"ل",1,0],["ولو نَثَرَ البحرُ المُسَخَّرُ دُرَّهُ","لما كانَ إِلّا فِي ذَراك انتثارُهُ",93,"ر",2,0],["ولو نضحي بميلون فلا جرم","عز المضحى له عز المضحونا",94,"ن",2,0],["ولو نُشِرَ الكرامُ بنو عليّ","لها وفَدَتْ على المُعطي الْمُهَنّي",95,"ن",2,0],["ولوّنَه عليّ مُلَو","وِنُ الشعَراتِ في اللَّممِ",96,"م",1,0],["ولو نادت كمالَ الملك ألفتْ","على الأدواءِ حاسمها الرفيقا",97,"ق",2,0],["ولو نظرَتْ حسَناً لم تَمِلْ","عليَّ ومالِيَ فيها نظيرُ",98,"ر",1,0],["ولوَّنت أخلاقَها فقد غدا","بياضُها يشِفُّ عن سوادِها",99,"د",3,0],["ولو نهضتْ بي وثبةُ الجَدِّ زاحمتْ","على الماء هذي الآبياتُ القوامحُ",100,"ح",1,0],["ولو نشَزتْ عنك القلوبُ لردَّها","لسانُك هذا الحلوُ أو وجهُك الرّطْبُ",101,"ب",1,0],["ولو ناديتُ من كَثَبٍ عليّاً","تدفَّق ذلك الغيثُ السَّكوبُ",102,"ب",1,0],["ولو نزلْتَ سِباخاً أصبحت أُنُفاً","من الرياض بها رِيٌّ ومُرتبَعُ",103,"ع",1,0],["ولو نبأُ الخسيفةِ نَمَّ يوماً","لضاقَ القاعُ بالحُمْسِ الغضابِ",104,"ب",1,0],["ولو نصرتني منك أذن سمعته","لأفصح فضل كل أفعاله فضل",105,"ل",1,0],["ولو نارا نفخت بها أضاءت","ولكن أنت تنفخ في رماد",106,"د",1,0],["ولو نطقوا بها كانت نباحا","نحاشي عن إجابتها الكلابا",107,"ب",2,0],["ولو نجز المطلوب بالطور ما ردا","ه إلا بمقدار المرائي الموسويه",108,"ي",2,0],["ولو نَظَرْتُ لِصُعْلوكٍ رَقى رُتَباً","وراحَ يَرْفُلُ بالإنْعامِ والحُلَلِ",109,"ل",1,0],["ولو نَظرتُ لِمَعْبودٍ أُقَرِّبُهُ","بإذنِ رَبِّي لِصَدْرٍ في المَقامِ عَلي",109,"ل",2,0],["ولوْ نَصيبي جَعَلو","هُ بعدَ لَهْفي نَصَبَا",110,"ب",2,0],["ولو نظر الإدراك من قد لطفه","لفرق في الجسم الحواس من من القوا",111,"ا",1,0],["ولو نظمت النجوم الزهر ممتدحاً","لم أقض من حقك المفروض مايجب",112,"ب",1,0],["ولو نظمت النجوم النيرات إذاً","قلت فكيف ولم أنظم سوى الكلم",113,"م",1,0],["ولو نظرتَ إلينا بعد فُرقتنا","رَأيتَ منّا الّذي رتّقتَ مُنفتِقا",114,"ق",2,0],["وَلَو نَقولُ دَربِخوا لَدَربَخوا","لِفَحلِنا إِن سَرَّهُ التَنَوُّخُ",115,"خ",1,0],["ولو نوروا الأذهان بالعلم لاهتدت","إلى رشدها الأفهام والفدم راغم",116,"م",1,0],["ولو نالكم من قسمه الحب مثلنا","لما كانت اللذات تشغلكم عنا",117,"ن",2,0]]}