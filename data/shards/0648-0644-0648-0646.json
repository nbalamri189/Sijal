an.net/poem56088.html","الوافر"],[458,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[458,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[458,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[458,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[458,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[461,"قل للمجاهد قولا عن أخي ثقة","https://www.aldiwan.net/poem15159.html","البسيط"],[461,"معاذ الله أن أزجي عتابا","https://www.aldiwan.net/poem15178.html","الوافر"],[464,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[479,"هي الأعمار نقص في ازدياد","https://www.aldiwan.net/poem36938.html","الوافر"],[479,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[482,"ألا ليت شعري ما تقول عظائم الد","https://www.aldiwan.net/poem24527.html","عموديه"],[500,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[500,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[504,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[515,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[515,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[551,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[561,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[564,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[564,"أحبابنا لو تعلمون بحالنا","https://www.aldiwan.net/poem895.html",""]],"verses":[["وَلَو نَفَضَت تِلكَ الثَنِيّاتُ بَردَها","عَلى الصَبِرِ المَمرورِ كادَ يَطيبُ",0,"ب",1,0],["وَلو نِمْتُ زارَتني الَّتي ما ذكرْتُها","فَتَشرَقَ إِلّا بالنَجيعِ المدامِعُ",1,"ع",1,0],["وَلَوْ نِيلَتِ الأَرْزاقُ بِالفَضلِ وَالحِجَى","لَمَا كانَ يَرْجُو أَنْ يَثُوبَ لَهُ وَفْرٌ",2,"ر",1,0],["ولوْ نُتِجَتْ أضْحَتْ قَوابِلَها القَنا","ولمْ يُغْذَ إلا بالدِّماءث سَليلُها",3,"ل",3,0],["ولَوْ نَطَقَ المَطِيُّ لَبَثَّ وَجْداً","يؤرِّقُنا بألْسِنَةٍ فِصاحِ",4,"ح",1,0],["وَلَو نَطَقَت شَكوى الهَوى كُلُّ شَعرَةٍ","عَلى جَسَدي مِمّا تُجِنُّ الحَيازِمُ",5,"م",1,0],["وَلَوْ نُشِرَ الطَّائِي يَوْمَ اجْتِلاَئِهَا","لَجَلَّلَهُ مِنْ أَجْلِ إِيثَارِهَا غَمُّ",6,"م",1,0],["وَلَو نَظَروا الصَباحَ إِذاً لَذاقوا","بِأَطرافِ الأَسِنَّةِ ما قِرانا",7,"ن",2,0],["وَلو نَذِرَ الحَيّانِ غِبَّ السُرى بِنا","لَكَرَّت عُظالى أَو لَعادَ كُلابُ",8,"ب",1,0],["وَلَو نَزَلَت مِثلُ الَّذي نَزَلَت بِهِ","تَرَكنَ المُذَرّى مِن أَجا يَتَصَدَّعا",9,"ع",2,0],["وَلَو نادَيتَهُ لَأَتاكَ يَسعى","حَثيثَ الرَكضِ أَو لَأَتاكَ يَجري",10,"ي",1,0],["ولو نال بالأخلاص مُثرٍ ثراءه","لما كنت تلقي بيننا غير مفلس",11,"س",1,0],["وَلَو نَزَلوا بِالبَيتِ ما باتَ آمِناً","حَمامٌ لَدى البَيتِ الحَرامِ قَطونُ",12,"ن",1,0],["وَلَو نَحنُ عاقَدنا الزُبَيرَ لَقيتَهُ","مَكانَ أُنوقٍ ما تُنالُ وُكورُها",13,"ر",3,0],["وَلو نَزَلَ الزُبَيرُ بِنا لَجَلّى","زِيادُ فَوارِسي رَهَجَ القَتامِ",14,"م",1,0],["وَلَو نيلَتِ الدُنيا بِفَضلٍ مَنَحتُها","فَضائِلَ تَحويها وَتَبقى فَضائِلُ",15,"ل",1,0],["وَلَو نَطَقَت رِحالُ المَيسِ قالَت","ثَقيفٌ شَرُّ مَن فَوقَ الرِحالِ",16,"ل",1,0],["ولو نوزعت في فخرها قال ربها","نعم في يدي هذا الفخار وفي ملكي",17,"ك",2,0],["ولو نظرت عيني لغير جماله","لكان إذاً إنسانها غير إنسان",18,"ن",1,0],["ولو نُشروا لما نصروا وقالوا","أرَبْتَ فكان حقُّك ما يُريبُ",19,"ب",1,0],["ولو نشاء لقلنا","بل شفرتيه وحَدَّهْ",20,"د",2,0],["ولو نشاء لقلنا","مَهَزَّهُ وفِرِنْدَهْ",20,"د",2,0],["ولو نجا أقْسمَ لا يأتلي","أنْ ما رأى أثقبَ من نَجْمي",21,"م",2,0],["ولو نظرتْ عيْناكِ يا أمُّ نَظْرةً","إلى ما توارى عنك مِنِّيَ واكتتمْ",22,"م",1,0],["ولو نستطيع وقَيْناهُمُ","وصناهمُ لك بين الجفون",23,"ن",1,0],["ولو نِكتُ أيضاً أمَّه لم يبالني","كما أنه لم يلتبِس بهجائيا",24,"ي",2,0],["وَلَو نَهَضَت عَنهُ السَماءُ وَمَخَّضَت","بِهِ الأَرضُ كانَ المُزنَ وَالتِبرَ وَالكَرما",25,"م",2,0],["وَلَونَها صافِيَةً","وَطَعمَها مُكَدَّرَه",26,"ر",2,0],["وَلَو نَزَلتُمُ بِهِ وَالدَهرُ مُعتَدِلٌ","نَزَلتُمُ بِعَروسِ المُلكِ عُمرانا",27,"ن",2,0],["وَلَو نَقَصتُ كَما قَد زِدتُ مِن كَرَمٍ","عَلى الوَرى لَرَأَوني مِثلَ شانيكا",28,"ك",2,0],["ولو نامَ بعضُ الحَيِّ أو غابَ ليلةً","لقرَّتْ عيونٌ واطمأنَّ جُنوبُ",29,"ب",1,0],["وَلَو نُصحاً أَرادَ لَكانَ فيهِ","عُبَيدُ اللَهِ أَسبَقَ مِن نَجاحِ",30,"ح",1,0],["وَلَو نَشاءُ شَرَعنا في تَطَوُّلِهِ","شُروعَنا فَأَخَذنا مِنهُ ما شينا",31,"ن",2,0],["وَلَو نَفَرتَ بِقَيسٍ لَاِحتَقَرتُهُمُ","إِلى تَميمٍ تَقودُ الخَيلَ وَالعَكَرا",32,"ر",2,0],["وَلَو نَعلَمُ العِلمَ الَّذي مِن أَمامِنا","لَكَرَّ بِنا الحادي الرِكابَ فَأَسرَعا",33,"ع",2,0],["وَلَو ناهَزوهُ المَجدَ أَربى عَلَيهِمُ","بِخَيرَ سُقاةٍ تَعلَمونَ وَغارِفِ",34,"ف",1,0],["ولو نَطَقَ الحَديدُ لنَابَ عنّي","ذُبابُ السَّيفِ أو حَدُّ السِّنانِ",35,"ن",1,0],["وَلَو نِلتَها بِحَذافيرِها","لَمُتَّ وَلَم تَقضِ مِنها الوَطَر",36,"ر",1,0],["وَلو نَسَبوا إِلَيهِ جَميعَ عِلمي","لَكانَ كَنُقطَةٍ في لُجِّ بَحرِ",37,"ر",1,0],["ولَو نَظَم الديماسُ مَنثورَ هامِهم","لَقلّدَ جيدَ القَصرِ منهُ سَخابا",38,"ب",2,0],["وَلَو نَفَحَتكُم ريحُ قَحطانَ نَفحَةً","بِنَكباءَ عَن وَجهِ الرِياحِ عَقيمِ",39,"م",1,0],["وَلَونانِ لَونٌ لَها أَصفَرٌ","وَلَونٌ عَلى الماءِ كَالعُصفُرِ",40,"ر",1,0],["وَلَو نازَعَتهُ الريحُ يَوماً إِزارَهُ","لَأَرسَلَهُ جوداً وَلَم يَتَجَرَّدِ",41,"د",1,0],["وَلَو ناجَتكَ أَقداحُ النَدامى","عَدَت عَن حَملِها مُتَنَدِّماتِ",42,"ت",1,0],["وَلَو نَحِسَت طَيٌّ لَأُلحِقَ حاتِمٌ","بِحَيٍّ سِواها مِثلِ تَغلِبَ أَو بَكرِ",43,"ر",1,0],["وَلَو نالَت عُقابُ اللوحِ لُبّاً","عَداها عَن تَكَفُّئِها التَكَفّي",44,"ي",1,0],["وَلَو نَضَحتَ عَلى خَدَّيكَ مِن نَدَمٍ","رَشاشَ دَمعٍ بِجَفنَي تائِبٍ غَسَلَك",45,"ك",1,0],["ولو نَشَدَتْ نَعْشاً هناكَ بَناتُه","لماتتْ ولم تَسْمَعْ لَه صَوْتَ مُنشِدِ",46,"د",1,0],["ولو نال ذو القرْنينِ ما نِلْتَ من غِنًى","بَنى السّدَّ من ذَوْبِ النُّضَارِ وَسامِهِ",47,"م",2,0],["ولو نِيطَ من نجمِ السماءِ فضيلةٌ","لمد إليها الكفَّ حتى ينالَها",48,"ل",3,0],["ولو نَظَرَ النُّدْمَانُ خَتمَ إنائِها","لأسكَرَهُمْ من دونِها ذلكَ الختم",49,"م",1,0],["ولو نَضحوا منها ثرَى قبرِ مَيّتٍ","لعادتْ اليه الرّوحُ وانتَعَشَ الجسم",49,"م",1,0],["ولو نالَ فَدْمُ القومِ لَثْمَ فِدَامِها","لأكْسبَهُ مَعنى شمائِلها اللّثْم",49,"م",1,0],["ولو نَطَقَتْ يوْماً لَقالَت أظنّكُمْ","تَخالُونَ أنّي مِن حِذارِ الرّدى أبكي",50,"ك",2,0],["وَلَوْنٌ ذَاكَ أَمْ نُورٌ","يُنِيرُ غَيَاهِبَ الدَّهْرِ",51,"ر",1,0],["ولو نَطَقتْ قالتْ هَلمَّ لمَصبحٍ","جميلٍ على الشطَّينِ مني ومَغْبِق",52,"ق",1,0],["ولو نَفَعتْ عِبرةٌ في الورى","لكانت حياتك أمَّ العبر",53,"ر",1,0],["ولو نختلف بشيا الغضب والرواقه","مانيب قايل ماتسوّيه سوّه",54,"و",2,0],["ولونا من السّمراء صيغت فتونه","بياضا نعم لكن بياضا تعرّبا",55,"ب",2,0],["ولو نكت أيضاً لم يبالني","كما أنه لم يلتبِس بهجائياً",56,"ي",2,0],["وَلَوَ کنَّها بَرَزَتْ لِمُنْتَصِبٍ","قَسٍّ، طَوِيلِ اللَّيلِ، يَبْتَهِلُهُ",57,"ل",2,0],["ولو نَضَحوا مِنها ثَرى قَبْرِ مَيتٍ،","لعادَتْ إليهِ الرُّوحُ، وانْتَعَشَ الجسْمُر",58,"م",2,0],["ولو نلت من ريّاك ريحاً أشمّها","لأمسى بها الجثمان أخضر ناميا",59,"ي",2,0],["ولو نَسى الناسُ إحسانَه","فما أنا منه بناسِي الجميلْ",60,"ل",1,0],["ولو ناغت صريعا في جبيل","لزل لها الصريع عن الجبيل",61,"ل",1,0],["ولَو نَثَرتُم كنَائِنَا عَلِمتُم","يَقِيناً أنَّ قَيدَكُم مُدَانَى",62,"ن",2,0],["ولو نجا الهائبُ الجبانُ من ال","حتف تحامىَ إقدامَه البطلُ",63,"ل",1,0],["ولو ندري بماء المزن يزري","لكان لنا على الظمإ احتمال",64,"ل",1,0],["ولو نَصَبوا رَحى بإِزاءِ دَمعي","لَكَانَتْ مِنْ تَحَدُّرِهِ تدورُ",65,"ر",1,0],["ولو نظروا الحديد بعين سخط","تصدع واكتسى ذلا وهنا",66,"ن",2,0],["ولو نلت فيها مال قارون لم تنل","سوى لقمة في فيك منه وخرقة",67,"ه",1,0],["ولو نالكم ما ساءكم في نفوسكم","قبلتم أو على عزمكم للأواخر",68,"ر",1,0],["وَلَو نامَ سَيفٌ بِالحُصيبِ وَلَم يَلِج","عَلى الهَولِ لَم يُدعَ المَليكَ المَمَجَّدا",69,"د",2,0],["ولو نِلْتُ منها ما يُوازَن بالقَذى","شفى كلَّ داءٍ في فؤاديَ حالفِ",70,"ف",1,0],["ولو نطق المجد المؤثل عن فم","لقال به اسطو وعنه اضارب",71,"ب",1,0],["وَلَو نالَ نَجم الدُجى ثَروَةً","وَأَوطَأَ شَمسَ الضُحى أَخمَصَه",72,"ص",2,0],["ولو نظر القومُ الغلاةُ لأيقنوا","معادَهُم ما دام آباؤهم مبدا",73,"د",2,0],["ولو نفساهما بدتا لعيني","لما ميزتُ أيّهما الكعابُ",74,"ب",1,0],["وَلَو نِلتَهُ طُلَّت هُناكَ جِراحُهُ","وَكانَ حَرِيّاً أَن يُهانَ وَيُهدَرا",75,"ر",2,0],["ولو نال غيرُك ما نلتَهُ","لفارَقَ أحبابَه وانتفى",76,"ف",2,0],["ولو نطقت شمس النهار لسبحت","بحمد الذي قد صاغهن من التبر",77,"ر",1,0],["ولو نطقت أحجار أرضٍ لسَلَّمتْ","عليك المُصَلَّى أو أتتك تسير",78,"ر",1,0],["وَلَوْ نُعْطَى الْخِيَارَ لَمَا افْتَرَقْنَا","وَلَكِنْ لاَ خِيَارَ مَعَ اللَّيَالِي",79,"ي",1,0],["ولو نظرت أحلامهم بعد نظرة","دعى بثبور في الرواسي ثبيرها",80,"ر",3,0],["ولونُها كانَ لون نَفسي","أيّامَ كانَ النَّدى نَثيرا",81,"ر",2,0],["وَلَوْ نَظَمْتُ نُجُومَ اللَّيْلِ مُمْتَدِحاً","لُمْ أَقْضِ مِنْ حَقِّكُمْ بَعْضَ الَّذِي وَجَبا",82,"ب",2,0],["وَلَو نَظَرت عينُ الشجاعِ اِحتفاله","إِذاً طَرَفت بَهراً وَلَم تنقَلِب لأطا",83,"ط",2,0],["وَلو نَظَرت بِالسخطِ أعينُ عدلهِ","إِلَيها غَدَت عَصفاً أكيلاً حشودها",84,"د",3,0],["ولو نارٌ نفحتَ بها أضاءت","ولكنأنتَ تنفُخُ في رَمَادِ",85,"د",1,0],["وَلَو نَفَعَت عِندَ الحَبيبِ ضَراعَةٌ","كَفَت أَدمُعٌ عَن مُهجَةٍ تَتَضَرَّعُ",86,"ع",1,0],["ولو نسِيَ اللهُ العِبادَ دَعَوْتُهُ","لِيذكُرَني لكِنَّهُ ليسَ بالنَّاسي",87,"س",2,0],["ولون الأَسنة مِمّا خضبن","كلون الدُخان عَلَيهِ اللَهَب",88,"ب",1,0],["ولو نظم الجوزاء فيك لما وفى","بها نظمه المُثني عليك ونثره",89,"ر",2,0],["ولو نبكي دماً حزناً عليهم","لما استوفى حقوقَهُم البكاء",90,"ا",2,0],["ولو نّ البخيلةَ ساعفَتْنا","بطيفٍ طارقٍ منها وَصولِ",91,"ل",1,0],["ولو نَثَرَ البحرُ المُسَخَّرُ دُرَّهُ","لما كانَ إِلّا فِي ذَراك انتثارُهُ",92,"ر",2,0],["ولو نضحي بميلون فلا جرم","عز المضحى له عز المضحونا",93,"ن",2,0],["ولو نُشِرَ الكرامُ بنو عليّ","لها وفَدَتْ على المُعطي الْمُهَنّي",94,"ي",1,0],["ولوّنَه عليّ مُلَو","وِنُ الشعَراتِ في اللَّممِ",95,"م",1,0],["ولو نادت كمالَ الملك ألفتْ","على الأدواءِ حاسمها الرفيقا",96,"ق",2,0],["ولو نظرَتْ حسَناً لم تَمِلْ","عليَّ ومالِيَ فيها نظيرُ",97,"ر",1,0],["ولوَّنت أخلاقَها فقد غدا","بياضُها يشِفُّ عن سوادِها",98,"د",3,0],["ولو نهضتْ بي وثبةُ الجَدِّ زاحمتْ","على الماء هذي الآبياتُ القوامحُ",99,"ح",1,0],["ولو نشَزتْ عنك القلوبُ لردَّها","لسانُك هذا الحلوُ أو وجهُك الرّطْبُ",100,"ب",1,0],["ولو ناديتُ من كَثَبٍ عليّاً","تدفَّق ذلك الغيثُ السَّكوبُ",101,"ب",1,0],["ولو نزلْتَ سِباخاً أصبحت أُنُفاً","من الرياض بها رِيٌّ ومُرتبَعُ",102,"ع",1,0],["ولو نبأُ الخسيفةِ نَمَّ يوماً","لضاقَ القاعُ بالحُمْسِ الغضابِ",103,"ب",1,0],["ولو نصرتني منك أذن سمعته","لأفصح فضل كل أفعاله فضل",104,"ل",1,0],["ولو نارا نفخت بها أضاءت","ولكن أنت تنفخ في رماد",105,"د",1,0],["ولو نطقوا بها كانت نباحا","نحاشي عن إجابتها الكلابا",106,"ب",2,0],["ولو نجز المطلوب بالطور ما ردا","ه إلا بمقدار المرائي الموسويه",107,"ي",2,0],["ولو نَظَرْتُ لِصُعْلوكٍ رَقى رُتَباً","وراحَ يَرْفُلُ بالإنْعامِ والحُلَلِ",108,"ل",1,0],["ولو نَظرتُ لِمَعْبودٍ أُقَرِّبُهُ","بإذنِ رَبِّي لِصَدْرٍ في المَقامِ عَلي",108,"ل",2,0],["ولوْ نَصيبي جَعَلو","هُ بعدَ لَهْفي نَصَبَا",109,"ب",2,0],["ولو نظر الإدراك من قد لطفه","لفرق في الجسم الحواس من من القوا",110,"ا",1,0],["ولو نظمت النجوم الزهر ممتدحاً","لم أقض من حقك المفروض مايجب",111,"ب",1,0],["ولو نظمت النجوم النيرات إذاً","قلت فكيف ولم أنظم سوى الكلم",112,"م",1,0],["ولو نظرتَ إلينا بعد فُرقتنا","رَأيتَ منّا الّذي رتّقتَ مُنفتِقا",113,"ق",2,0],["وَلَو نَقولُ دَربِخوا لَدَربَخوا","لِفَحلِنا إِن سَرَّهُ التَنَوُّخُ",114,"خ",1,0],["ولو نوروا الأذهان بالعلم لاهتدت","إلى رشدها الأفهام والفدم راغم",115,"م",1,0],["ولو نالكم من قسمه الحب مثلنا","لما كانت اللذات تشغلكم عنا",116,"ن",2,0]]}