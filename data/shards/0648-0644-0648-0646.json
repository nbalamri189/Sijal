0],["ولون ترامتْ عليه الظنون","فأحكم حول الظنون الحصارْ",207,"ر",1,0],["ولونٌ تسربلَ ليلَ الربيعِ","وآخر يسبح فيه النهارْ",207,"ر",1,0],["ولونٌ يقول: ألا تبصرون","ولون يقول: حذار حذارْ",207,"ر",1,0],["ولون الكرهِ صار لنا","وشاحاً لا يقاصينا",208,"ن",2,0],["ولوّنْ قوسك الزمني زهوا","صفارا باخضرارٍ أو قرمزِ",209,"ز",1,0],["ولُوّنتِ الوجوهُ فلستَ تدري","أ\"معتصما\" تُحَدّثُ أمْ\"رُغالا\"(1)",210,"ل",2,0],["ولو نلت منها السؤال يوما سلوتها","فمن يك محبوبا ولم يمتنع يسلى",211,"ل",2,0],["ولو ناديتُ همَّ الليلِ يوماً","تمثّلَ لي بهِ بشَراً سويّا",212,"ي",2,0],["ولو نهضت للمشي تحمل ذيلها","وصائف أمثال الشموس نحورها",213,"ر",3,0],["ولو نظر البهلول بين فؤاده","لحقق أن الحب عند المطالب",214,"ب",1,0],["ولو نظرت الى الرمضاء تشهدهم","كالنحل يدوي بصوت الله ما فترا",215,"ر",2,0],["وَلَو نقعون الصَبر للمغرم الشَجي","يَخال لَهُ ذا شَهد صافي زلالها",216,"ل",3,0],["ولو نظرَ الإمام نورَ جمالهِ","لسجدَ إليه بدلا عن القِبلا",217,"ل",2,0],["ولو نظرتْ لها في أيِّ وقتٍ","مضى .. لرأى الولاءَ لها الدوامُ",218,"م",1,0],["ولوّنه عليّ مل","وّن الشعراتِ في اللِّمم",219,"م",1,0],["ولوّني أغنياتِ الصيف في شفتي","وقرّبي من وسادي النجم والقمرا",220,"ر",2,0]]}