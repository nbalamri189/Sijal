155,"ق",1,0],["وَلَو نُظِمَت فيكَ النُّجومُ مَدائِحاً","لَقَصَّرَ عَن حَدِّ الثَّناءِ مَسيرُها",156,"ر",3,0],["وَلَو نَزَلَت بِكَ فيها العُصاةُ","حَمَلتَ صَحائِفَ أَوزارِها",157,"ر",3,0],["وَلو نَظر ابن أَوس قال أَيهاً","فَكَم تَرك الأَوائك للأَخير",158,"ر",1,0],["وَلَو نَشرَ النَبيُّ لَكُنتُ مِنهُ","مَكانَ أَبي هُرَيرة غَيرَ مين",159,"ن",1,1],["وَلَو نَظَرنا بَعَدلٍ في قَضيّته","نَقضي بِأَنَّهُما بِالعَقل ما كمُلا",160,"ل",2,0],["ولو نظموه في سمط لاغنى","حسان الغيد عن عقد فريد",161,"د",1,0],["وَلَو نِلتُ أَلفاً مِن مَعَدٍّ حِيازَةً","لَما أُبتُ مِنهُم في أَبي بِعَديلِ",162,"ل",1,0],["ولو نشاءُ سَلَقْناكم بأَلِسنةٍ","لُدٍّ بها تلتقى الأَقدام والِقمَم",163,"م",1,0],["ولو نملة دبت على الخد أثرت","ولو رمت لحظ المتن من ساقها بدا",164,"د",2,0],["ولو نَظرَت في الفضل عين بصيرة","لما أبصرت يوماً على يده يدا",165,"د",2,0],["وَلَو نُعطِي الخِيَارَ لَمَا افتَرَقنَا","وَلَكِن لاَ خِيَارَ مَعَ الكِتَابِ",166,"ب",1,0],["ولو نلت يوماً صحة الجسم لم أجد","على النفس حتى في الحمالة من باس",167,"س",1,0],["وَلَو نظرت إِلَيه الشَمس حَقاً","لَذابَ شُعاعها خَجلاً وَحالا",168,"ل",2,0],["ولون سيادة الدنيا إباء","فإن يفقد فتربتها الخدود",169,"د",1,0],["ولونك مصفرٌ ورأسك مطرقٌ","وطرفك محسورٌ ووجهك كاب",170,"ب",1,0],["ولو نفيسا كياقوت زبر جدهم","مع الكراهة كاستعمال صفرهم",171,"م",1,0],["ولو نال ماءُ البحرِ من فِيهِ قَطْرةً","لأصْبَحَ ماءُ البحرِ مِن رِيقِه عَذْبَا",172,"ب",2,0],["وَلَو نِلتُ الخُلودَ وَلا أَراكُم","بِذاكَ الجِزعِ لامتَنَعَ الخُلودُ",173,"د",1,0],["ولو نظمت شهب السماء قصيدة","لمجدك مدحاً لم يسعني سوى العذر",174,"ر",1,0],["ولو نوت النجوم له خلافا","هوت في الجو يذروها انتثار",175,"ر",1,0],["وَلو نظمت الثريا في الرثاء لَها","أَفنى وَقَد بقيت في النَفس حاجات",176,"ت",1,0],["وَلو نَظر الدُنيا لبيبٌ مجرّبٌ","لما قال وافتني بما كُنت أَرتضي",177,"ض",2,0],["وَلَو نُقِدَت خَلائِقُهُ","لَبُهرِجَ عِندَها الذَهَبُ",178,"ب",1,0],["ولو نعطى الخيار لما افترقنا","ولكن لا خيار مع العيالِ",179,"ل",1,0],["ولو نظروا سبط النبي محمد","لقالوا بأنا لم نقل غير باطل",180,"ل",1,0],["ولو نهضت رجال الارض طرا