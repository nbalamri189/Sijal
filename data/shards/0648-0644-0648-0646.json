57","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135360","الوافر"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105260","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119464","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86479","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119616","الوافر"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106731","الطويل"],[4164,"","https://poetry.dctabudhabi.ae/diwan/poem/203839","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136645",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83501","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115322","الطويل"],[4427,"","https://poetry.dctabudhabi.ae/diwan/poem/203894","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104535","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112139","الطويل"],[4755,"وإِننا رُغمَ ضِيقِ الحالِ نُنكِرُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=204339",""],[4783,"أ أسْلو؟","https://www.poetsgate.com/ViewPoem.aspx?id=185446",""],[4927,"رسالة الى بلال الحبشي","https://www.poetsgate.com/ViewPoem.aspx?id=4585",""],[4979,"حبيبتى","https://www.poetsgate.com/ViewPoem.aspx?id=176549",""],[5000,"حنين الحنايا","https://www.poetsgate.com/ViewPoem.aspx?id=5072",""],[2177,"خليلي خلتكما تحسدان","https://www.poetsgate.com/ViewPoem.aspx?id=127094",""],[5033,"أنا باختصار","https://www.poetsgate.com/ViewPoem.aspx?id=182757",""],[5054,"تيهي بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=214800",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5147,"دعاه الهوى ما العصر عصر بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=166712",""],[5150,"بوحي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=202786",""],[5174,"حوار مع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187134",""],[5217,"مَاتَ أَبُو الطّيب وَا ويلتاه","https://www.poetsgate.com/ViewPoem.aspx?id=194876",""],[5348,"مسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=59561",""],[5410,"رسالة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=133058",""],[5431,"تاج فوز....","https://www.poetsgate.com/ViewPoem.aspx?id=203359",""],[5464,"ليالينا عقيمات ... ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=27774",""],[5689,"ترى أنت تهوي غير نفسك في ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=143396",""],[5703,"سوء الحظ","https://www.poetsgate.com/ViewPoem.aspx?id=208969",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[6068,"جنون الشعر -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175968",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6225,"إحياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78068&r=&rc=153",""],[463,"لمن دارٌ على إضم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60305&r=&rc=361",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""]],"verses":[["ولو نظروا الغداة رأوا عظيما","محا ذكر الأواخر والأوالي",0,"ل",2,0],["وَلَو نَفَضَت تِلكَ الثَنِيّاتُ بَردَها","عَلى الصَبِرِ المَمرورِ كادَ يَطيبُ",1,"ب",1,0],["وَلو نِمْتُ زارَتني الَّتي ما ذكرْتُها","فَتَشرَقَ إِلّا بالنَجيعِ المدامِعُ",2,"ع",1,0],["وَلَوْ نِيلَتِ الأَرْزاقُ بِالفَضلِ وَالحِجَى","لَمَا كانَ يَرْجُو أَنْ يَثُوبَ لَهُ وَفْرٌ",3,"ر",1,0],["ولوْ نُتِجَتْ أضْحَتْ قَوابِلَها القَنا","ولمْ يُغْذَ إلا بالدِّماءث سَليلُها",4,"ل",3,0],["ولَوْ نَطَقَ المَطِيُّ لَبَثَّ وَجْداً","يؤرِّقُنا بألْسِنَةٍ فِصاحِ",5,"ح",1,0],["وَلَو نَطَقَت شَكوى الهَوى كُلُّ شَعرَةٍ","عَلى جَسَدي مِمّا تُجِنُّ الحَيازِمُ",6,"م",1,0],["وَلَوْ نُشِرَ الطَّائِي يَوْمَ اجْتِلاَئِهَا","لَجَلَّلَهُ مِنْ أَجْلِ إِيثَارِهَا غَمُّ",7,"م",1,0],["وَلَو نَظَروا الصَباحَ إِذاً لَذاقوا","بِأَطرافِ الأَسِنَّةِ ما قِرانا",8,"ن",2,0],["وَلو نَذِرَ الحَيّانِ غِبَّ السُرى بِنا","لَكَرَّت عُظالى أَو لَعادَ كُلابُ",9,"ب",1,0],["وَلَو نَزَلَت مِثلُ الَّذي نَزَلَت بِهِ","تَرَكنَ المُذَرّى مِن أَجا يَتَصَدَّعا",10,"ع",2,0],["وَلَو نادَيتَهُ لَأَتاكَ يَسعى","حَثيثَ الرَكضِ أَو لَأَتاكَ يَجري",11,"ر",2,0],["ولو نال بالأخلاص مُثرٍ ثراءه","لما كنت تلقي بيننا غير مفلس",12,"س",1,0],["وَلَو نَزَلوا بِالبَيتِ ما باتَ آمِناً","حَمامٌ لَدى البَيتِ الحَرامِ قَطونُ",13,"ن",1,0],["وَلَو نَحنُ عاقَدنا الزُبَيرَ لَقيتَهُ","مَكانَ أُنوقٍ ما تُنالُ وُكورُها",14,"ر",3,0],["وَلو نَزَلَ الزُبَيرُ بِنا لَجَلّى","زِيادُ فَوارِسي رَهَجَ القَتامِ",15,"م",1,0],["وَلَو نيلَتِ الدُنيا بِفَضلٍ مَنَحتُها","فَضائِلَ تَحويها وَتَبقى فَضائِلُ",16,"ل",1,0],["وَلَو نَطَقَت رِحالُ المَيسِ قالَت","ثَقيفٌ شَرُّ مَن فَوقَ الرِحالِ",17,"ل",1,0],["ولو نوزعت في فخرها قال ربها","نعم في يدي هذا الفخار وفي ملكي",18,"ك",2,0],["ولو نظرت عيني لغير جماله","لكان إذاً إنسانها غير إنسان",19,"ن",1,0],["ولو نُشروا لما نصروا وقالوا","أرَبْتَ فكان حقُّك ما يُريبُ",20,"ب",1,0],["ولو نشاء لقلنا","بل شفرتيه وحَدَّهْ",21,"د",2,0],["ولو نشاء لقلنا","مَهَزَّهُ وفِرِنْدَهْ",21,"د",2,0],["ولو نجا أقْسمَ لا يأتلي","أنْ ما رأى أثقبَ من نَجْمي",22,"م",2,0],["ولو نظرتْ عيْناكِ يا أمُّ نَظْرةً","إلى ما توارى عنك مِنِّيَ واكتتمْ",23,"م",1,0],["ولو نستطيع وقَيْناهُمُ","وصناهمُ لك بين الجفون",24,"ن",1,0],["ولو نِكتُ أيضاً أمَّه لم يبالني","كما أنه لم يلتبِس بهجائيا",25,"ي",2,0],["وَلَو نَهَضَت عَنهُ السَماءُ وَمَخَّضَت","بِهِ الأَرضُ كانَ المُزنَ وَالتِبرَ وَالكَرما",26,"م",2,0],["وَلَونَها صافِيَةً","وَطَعمَها مُكَدَّرَه",27,"ر",2,0],["وَلَو نَزَلتُمُ بِهِ وَالدَهرُ مُعتَدِلٌ","نَزَلتُمُ بِعَروسِ المُلكِ عُمرانا",28,"ن",2,0],["وَلَو نَقَصتُ كَما قَد زِدتُ مِن كَرَمٍ","عَلى الوَرى لَرَأَوني مِثلَ شانيكا",29,"ك",2,0],["ولو نامَ بعضُ الحَيِّ أو غابَ ليلةً","لقرَّتْ عيونٌ واطمأنَّ جُنوبُ",30,"ب",1,0],["وَلَو نُصحاً أَرادَ لَكانَ فيهِ","عُبَيدُ اللَهِ أَسبَقَ مِن نَجاحِ",31,"ح",1,0],["وَلَو نَشاءُ شَرَعنا في تَطَوُّلِهِ","شُروعَنا فَأَخَذنا مِنهُ ما شينا",32,"ن",2,0],["وَلَو نَفَرتَ بِقَيسٍ لَاِحتَقَرتُهُمُ","إِلى تَميمٍ تَقودُ الخَيلَ وَالعَكَرا",33,"ر",2,0],["وَلَو نَعلَمُ العِلمَ الَّذي مِن أَمامِنا","لَكَرَّ بِنا الحادي الرِكابَ فَأَسرَعا",34,"ع",2,0],["وَلَو ناهَزوهُ المَجدَ أَربى عَلَيهِمُ","بِخَيرَ سُقاةٍ تَعلَمونَ وَغارِفِ",35,"ف",1,0],["ولو نَطَقَ الحَديدُ لنَابَ عنّي","ذُبابُ السَّيفِ أو حَدُّ السِّنانِ",36,"ن",1,0],["وَلَو نِلتَها بِحَذافيرِها","لَمُتَّ وَلَم تَقضِ مِنها الوَطَر",37,"ر",1,0],["وَلو نَسَبوا إِلَيهِ جَميعَ عِلمي","لَكانَ كَنُقطَةٍ في لُجِّ بَحرِ",38,"ر",1,0],["ولَو نَظَم الديماسُ مَنثورَ هامِهم","لَقلّدَ جيدَ القَصرِ منهُ سَخابا",39,"ب",2,0],["وَلَو نَفَحَتكُم ريحُ قَحطانَ نَفحَةً","بِنَكباءَ عَن وَجهِ الرِياحِ عَقيمِ",40,"م",1,0],["وَلَونانِ لَونٌ لَها أَصفَرٌ","وَلَونٌ عَلى الماءِ كَالعُصفُرِ",41,"ر",1,0],["وَلَو نازَعَتهُ الريحُ يَوماً إِزارَهُ","لَأَرسَلَهُ جوداً وَلَم يَتَجَرَّدِ",42,"د",1,0],["وَلَو ناجَتكَ أَقداحُ النَدامى","عَدَت عَن حَملِها مُتَنَدِّماتِ",43,"ت",1,0],["وَلَو نَحِسَت طَيٌّ لَأُلحِقَ حاتِمٌ","بِحَيٍّ سِواها مِثلِ تَغلِبَ أَو بَكرِ",44,"ر",1,0],["وَلَو نالَت عُقابُ اللوحِ لُبّاً","عَداها عَن تَكَفُّئِها التَكَفّي",45,"ف",2,0],["وَلَو نَضَحتَ عَلى خَدَّيكَ مِن نَدَمٍ","رَشاشَ دَمعٍ بِجَفنَي تائِبٍ غَسَلَك",46,"ك",1,0],["ولو نَشَدَتْ نَعْشاً هناكَ بَناتُه","لماتتْ ولم تَسْمَعْ لَه صَوْتَ مُنشِدِ",47,"د",1,0],["ولو نال ذو القرْنينِ ما نِلْتَ من غِنًى","بَنى السّدَّ من ذَوْبِ النُّضَارِ وَسامِهِ",48,"م",2,0],["ولو نِيطَ من نجمِ السماءِ فضيلةٌ","لمد إليها الكفَّ حتى ينالَها",49,"ل",3,0],["ولو نَظَرَ النُّدْمَانُ خَتمَ إنائِها","لأسكَرَهُمْ من دونِها ذلكَ الختم",50,"م",1,0],["ولو نَضحوا منها ثرَى قبرِ مَيّتٍ","لعادتْ اليه الرّوحُ وانتَعَشَ الجسم",50,"م",1,0],["ولو نالَ فَدْمُ القومِ لَثْمَ فِدَامِها","لأكْسبَهُ مَعنى شمائِلها اللّثْم",50,"م",1,0],["ولو نَطَقَتْ يوْماً لَقالَت أظنّكُمْ","تَخالُونَ أنّي مِن حِذارِ الرّدى أبكي",51,"ك",2,0],["وَلَوْنٌ ذَاكَ