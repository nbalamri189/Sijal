aldiwan.net/poem42456.html","مخلع البسيط"],[524,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[538,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[551,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[551,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[558,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[559,"كم ذا تموه بالشعبين والعلم","https://www.aldiwan.net/poem69345.html","البسيط"],[567,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"],[575,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[586,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["وَكَم تَعَرَّضَ لي الأَقوامُ قَبلَكُمُ","يَستَأذِنونَ عَلى قَلبي فَما وَصَلوا",0,"ل",3,0],["وَكَم تَلاحَمَ كَربٌ عِندَ مُعضِلَةٍ","فَاِنجابَ عَن قَدرٍ لِلَّهِ وَاِنفَسَحا",1,"ح",2,0],["وكم تَشيمُ بُروقاً غيرَ صادِقةٍ","والآلُ ليسَ بما يُرْوي صَداكَ يَفي",2,"ف",2,0],["وكمْ تطلّبْتُ ما أُهدي فما اقْتَصَرَتْ","على الذي بَلَغَتْهُ الطّاقةُ الهِمَمُ",3,"م",1,0],["وكم تَرِب تجسّس للأعادي","فاصبِح من تجسّسه ثريّا",4,"ر",3,0],["وكم تهتزّ أعطاف المعالي","إذا ما قلت قافيةً شرودا",5,"د",2,0],["وكم تقاضاك فيلسوف","حقيقة صعبة الأداء",6,"ا",2,0],["وكم تلطفُ كتبٍ في رسائله","وطيَّها لمزاج الخطب تلطيف",7,"ف",1,0],["وكم تركت بها كفًّ بلا عضد","وقد توسَّدها رأسٌ بلا عنق",8,"ق",1,0],["وَكَم تَشبَّثَ بي يَومَ الرَحيلِ ضُحَىً","وَأَدمُعِي مُستَهِلّاتٍ وَأَدمُعُهُ",9,"ع",2,0],["وكم تبعَ المولِّي منك سيبٌ","فلم يُقدَر له منك اعتصامُ",10,"م",1,0],["وَكَم تَستَكين وَتَستَسلِمُ","وَقَد بَلَغَ السَيلُ زُنّارَها",11,"ه",2,0],["وَكَم تَدورينَ حَولَ البَيتِ حائِرَةً","بِنتَ الرُبى لَيسَ مَأوى الناسِ مَأواكِ",12,"ك",1,0],["وَكَم تَرَجَّحتِ في مَهدِ الضِياءِ عَلى","تَوقيعِ لَحنِ الصِبا أَو رَجعِهِ الحاكي",12,"ك",2,0],["وَكَم تَعولينَ وَكَم تَصرُخينَ","كَعُصفورَةٍ راعَها الأَجدَلُ",13,"ل",1,0],["وَكَم تَصحَبُ مَن يُف","سِدُ في الأَرضِ وَلا يُصلِح",14,"ح",1,0],["وَكَمْ توَشَّحْتَ من ليلٍ ومن شَفَقٍ","ومِنْ صَباحٍ تُوَشِّي ذيلَهُ السُّدُمُ",15,"م",1,0],["وكم توسدت من ال","حسان أبهى معصم",16,"م",1,0],["وَكَم تَدَّعي السودانَ يا مَكسُ هازِلاً","وَما أَنتَ مُسَوَّدٌ وَلا أَنتَ قاتِمُ",17,"م",1,0],["وَكُمتَ إِذا كَلَّفتَ حاضِنَ ثَلَّةٍ","سُرى اللَيلِ دَنّى عَن فُروجِ المَحارِمِ",18,"م",1,0],["وكم تمنيت لو للرقص تطلبني","وحيرتني ذراعي أين ألقيها",19,"ي",3,0],["وكم تَسَربلتَ مِن سِربالِ مَكرُمةٍ","جَلَّت ولكَّنها دَقَّت مَعانِيها",20,"ي",3,0],["وَكَم تَرَكَ الدَهرُ مِن سَيِّدٍ","يَنوءُ عَلى قَدَمٍ واحِدَه",21,"د",2,0],["وَكَم تَخَرَّمَتِ الأَيّامُ مِن بَشَرٍ","كانوا ذَوي قُوَّةٍ فيها وَأَجسامِ",22,"م",1,0],["وَكَم تَقَنَّصتُ بِها جُؤذُراً","وَرُدتُ مِن عَينٍ بِها جارِيَه",23,"ه",1,0],["وكم تُبْلي الكروبُ عليك جسمي","ألا فَرَجٌ لديك من الكروبِ",24,"ب",1,0],["وَكَم تَحتَ أَرواقِ الصَبابَةِ مِن فَتىً","مِنَ القَومِ حُرٍّ دَمعُهُ لِلهَوى عَبدُ",25,"د",1,0],["وكمْ تخلّفُ في أوراسَ من سِيَرٍ","سارتْ بذكرك في الأسماع والكتب",26,"ب",1,0],["وَكَم تَرى في الأُفُقُِ مِن كَوكَبٍ","يَعظُمُ أَن يُرمى بِهِ المارِدُ",27,"د",1,0],["وَكَم تَعَدَّت يَبيسَ الأَرضِ راعِيَةٌ","مِنَ السَوامِ وَرامَت عَينُها الخُضَرا",28,"ر",2,0],["وَكَم تَرِكَت آهِلاً وَحدَهُ","وَكَم غادَرَت مُثريّاً مُملِقا",29,"ق",2,0],["وَكَم تَحبِسُ زِريابَكَ","في السِجنِ وَطاوُوسَك",30,"ك",1,0],["وَكَم تَرَكوا لَنا أَثَراً مُنيفاً","يَعودُ بِآيَةٍ مُتَأَوِّبوهُ",31,"ب",3,0],["وكم تدعي بالشعر علما ونقده","وأَنتَ عن العلم الَّذي تدعي عاري",32,"ي",1,0],["وكم تعد الأقوام أنك باذل","حقوقاً لهم مغصوبة ثم تبخل",33,"ل",1,0],["وَكَم تدَّعى في النقد أنك صادق","وتورد بالزعم الدَليل فأدحض",34,"ض",1,0],["وكم تمنّتْ رِجالٌ فيكِ مُغْضَبَةً","أنْ يُبْصِروهُ فلم يَظْهَرْ لهمْ سقَما",35,"م",2,0],["وَكَم تَمَنَّيتُ أَن أَراهُ","عَلَيَّ يَقرا لِكُلِّ راوِ",36,"و",1,0],["وكم تمنَى الربيعُ النَضْرُ لو سَعِدَتْ","بحلَّةِ العُرْسِ كَفَاهُ فَوَشَاها",37,"ا",3,0],["وكم ترنَّح سكرانًا بهبَّته","كما ترنح بالصهباء سكران",38,"ن",1,0],["وكم تحدى الملوك مبتسماً","يقول سلطانكم وسلطاني",39,"ن",2,0],["وكم تدّعي عفّة والوجود","بأصناف خسّتها مفعمُ !",40,"م",1,0],["وكم تحسنت وكم تشنَّعا","ولم يزل فضلك فيه مرتعا",41,"ع",2,0],["وكم تشفّعَ بي أن لا أُفَارِقَهُ","وللضروراتِ حالٌ لا تُشفّعُهُ",42,"ع",2,0],["وكُمَّت به الأفواه عن كشف سوءَةٍ","كأنْ لم يكن من ثَمَّ عتبٌ لعاتب",43,"ب",1,0],["وَكَم تَحظى ذَوي الاحساب مُعتَدياً","وَضيعُ جَرثومة في أَنفِهِ شمم",44,"م",1,0],["وكم تهتكنا","لما رأيناه",45,"ا",2,0],["وكَم تِرَةٍ أدركتُ غِبَّ طِلاَبِهَا","بِعَزمٍ كَمَاضِي الشَّفرَتَينِ يَمَاني",46,"ي",1,0],["وَكَم تَعَرَّضَ في أَبهى مَلابِسِهِ","لِعَينِهِ الإِثمُ مُختالاً فَما أَثِما",47,"م",2,0],["وكم تَسَابَقَ أقوامٌ على أمدٍ","لكنَّه لقليل يُسِّرَ السَّبَق",48,"ق",1,0],["وَكَم تَشَفَّعَ في أَن لا أُفارِقَهُ","وَلِلضَّرُورَةِ حَالٌ لا تُشَفِّعُهُ",49,"ع",2,0],["وكَمْ تَجَلَّدْتُ لا لِأَنِّي","عَلى عذابِ الهَوى جَليدُ",50,"د",1,0],["وَكَم تَتَرَدُّونَ الخُمولَ ضَراعَةً","وَلُؤماً وَتَشرونَ الغَباوَةَ بِالنُبلِ",51,"ل",1,0],["وَكَم تَخطَّأتُ في قَصدِيكَ مِن مَلِكٍ","لِي عِندَه لَو أَرَدتُ النَهلُ وَالعَلَلُ",52,"ل",1,0],["وَكَم تَرى مِن قَوِيٍّ فَكَّ قُوَّتَهُ","طولُ الزَمانِ وَسَيفاً صارِماً نَجَلا",53,"ل",2,0],["وكم تراءت له من خلفها صور","يختال فيها الربيع البكر في تبه",54,"ه",1,0],["وكم تنعقُ الغربانَ لكنَّ بومةً","تقولُ اسمعوا إنَّ الغرابَ حكيمُ",55,"م",1,0],["وكمْ تَلَجْلَجَ قلبي في هواها وكَمْ","لَجَّ العواذلُ في عَذلي وتَعْنِيفي",56,"ف",2,0],["وَكم تَعهَّدت جرحى من أُسودِ وغىً","إن يَكشِر الدهرُ عن أحداثهِ كَشَروا",57,"ر",3,0],["وَكَم تَموتونَ بِأَد","واءِ الهُمومِ المُدوِيَه",58,"ي",2,0],["وَكَم تعاميت عَن رشادي","وَمتهج الحق مُستَقيم",59,"م",1,0],["وَكَم تغيرت الايام وَالتبست","فَما تغيرت اخلاقي وَلا شيَمي",60,"م",2,0],["وَكَم تواجد من وَجدي لشبهتي","مَن لَيسَ تسعده بالدمع عَيناه",61,"ا",2,0],["وكم توَغّلتَ في الإعجاب مشتملا","بالجهل والحلم أسنى منه مشتمَلا",62,"ل",2,0],["وكَم تَمَلْمَلَ مِنْ حَيْفٍ ومَنْ جَنَفٍ","لِجَاعِلٍ نَصْرهُ المَشْرُوعَ خذْلانا",63,"ن",2,0],["وَكَمْ تَمامٍ يَكُونُ النقْصُ أَوَّله","قَطُّ الذُّبالِ يُوَفّي ضَوْؤُهُ السرُجا",64,"ج",2,0],["وَكَم تَجَرَّعتُ بِالجَرعاءِ مِن أَسَفٍ","قَلبي بِأَوصابِهِ مِلآنَ مَلآنُ",65,"ن",1,0],["وَكم تمطّى بأعطافٍ مرنَّحةٍ","في رفرفٍ كجنانِ الخلد فيّاح",66,"ح",1,0],["وكم ترشفت له مبسماً","نكهته أرخصت الغاليه",67,"ه",1,0],["وكم تلوين عن محمود فعل","وكم تقعين في قبح الفعال",68,"ل",1,0],["وكم تحفة كم طرفة كم عطية","به دونها بسطى وروحي وراحتي",69,"ي",1,0],["وَكُمتاً مُدَمّاةً كَأَنَّ مُتونَها","جَرى فَوقَها وَاِستَشعَرَت لَونَ مُذهَبِ",70,"ب",1,0],["وكم تَرَى في الزَّمانِ أصحابَ أق","لامٍ لظُفْرٍ بهنَّ ما قَلَموا",71,"م",3,0],["وكم تَعصَّبَ من جَهْلٍ عليَّ إلى","أن رُعتُه فأبَى إلاّ التَعصُّبَ لي",72,"ل",2,0],["وَكَم تَلعَب بي أَحَداً","ثُكِّ السودُ وَكَم تَسطو",73,"ط",2,0],["وَكَم تُرِّبَت وَاِنبَرَت لِلعَدُوِّ","كَوَثبِ الشَرارِ وَهَدَّ الجِبالِ",74,"ل",1,0],["وكم تَقتلُهُم صَبراً","فإنَّ القَتلَ قُربانُ",75,"ن",1,0],["وكَمتاءَ في حانوتِ قَسٍّ بِتاجِها","ركبتُ إلَيها مِن دُجى اللَّيلِ أدهَما",76,"م",2,0],["وكم تَباكَينا وما يَستَوي","هل تَلحقُ الكحلاءَ ذاتُ المرَه",77,"ر",2,0],["وكم تفضل وكم أنعم","لعبده الظالم الكفار",78,"ر",1,0],["وكم تحيات لنا أرسلوا","حياهم اللّه وبَيَّاهُمُ",79,"م",1,0],["وَكَم تَعَسَّفت في قَصديه مِن خَطَرٍ","لا يبلغ المَجدَ مَن لا يَركَبُ الخَطَرا",80,"ر",2,0],["وَكَم تدرعت مِن بَيداء مُقفِرَة","في لَيلَة خِلتُ أَن الصبح لَم يؤُبِ",81,"ب",1,0],["وكم تشاجَرَ أَقوامٌ فقلتُ لهُمْ","إِن الأَصولَ عليها تنبتُ الشجَرُ",82,"ر",1,0],["وكم تأَسَّفَ مِنْهُمْ فِي معاهِدَ قَدْ","آلَتْ معاهِدَ للأَحزانِ والهَبَلِ",83,"ل",1,0],["وكم تعالت لنا أصواتها هرجا","فأضحكتنا وشاقتنا بإيماء",84,"ا",2,0],["وكم تبيتون طُروحَ الشكّ في","ودّكمُ ورجمِ سوءِ الظِّننِ",85,"ن",1,0],["وكم تتزوَّى هضبةٌ بعد هضبةٍ","بهم ولرَضوَى منكِب لا يُزَيَّلُ",86,"ل",1,0],["وكم تحت درعي باللوي من جراحةٍ","لعَجماءَ ما فيها قَصاصٌ ولا عَقْلُ",87,"ل",1,0],["وكم تستقيمُ فتمشي الحظوظُ","وحظُّك أعمى الخُطى مُزلقُ",88,"ق",1,0],["وكم تُرَى تَسحرني بابلٌ","وبابلٌ بالطبع سحّارَهْ",89,"ر",2,0],["وكم تعيَّفتُ لكم سُفورَها","من قبل أن يبرُزَ وجهُ السافرِ",90,"ر",1,0],["وكم تَكتسِي في ظلِّ قومٍ أعزةٍ","قوادمُ ريشي ثم تَعرَى فتُسلَبُ",91,"ب",1,0],["وكم تصدَّى عمداً ليخدَعَني","يَسفِر عن غيهبٍ وينتقبُ",92,"ب",1,0],["وكم تحت أفق الغرب من أنت شمسهُ","وبالشام من طرفٍ كبرقكِ شائمِ",93,"م",1,0],["وكم توسلت الثكلى بمرضعها","تلك الليالي وجارى الأيم الهرم",94,"م",1,0],["وكم تلا القوم آيات الكتاب وكم","تلوا حديثا وكم حفت بك النعم",94,"م",1,0],["وكم تجهمت فيه من معاكسة","كي يستفزوا نهاي فيه للغضب",95,"ب",1,0],["وكم تنمرت في قنص الشوارد لا","يصدني سارب عنهم وما أثق",96,"ق",1,0],["وكم تسورت في أرض المعارف ما","أرى سواها ولو بالبين أحترق",96,"ق",1,0],["وكم تحت اذيالِ هذا الترا","بِ نفوسٌ قضت قبل نيل المنى",97,"ن",2,0],["وكمْ تمنّيتُ لو أعودُ","إلى سمائِي فلا أروبُ",98,"ب",1,0],["وَكَم تَجَلَت بَراهين وَمُعجزة","وَكَم تَوالَت كَرامات وَآيات",99,"ت",1,0],["وكم تغنَّى بِنَغَم","يطرُدُ عنك كلَّ غَم",100,"م",1,0],["وَكَم تَحملونا كلَّ يومٍ وليلةٍ","على ظَهرِ جمّاحٍ من الشّرِّ قامِصِ",101,"ص",1,0],["وَكَمْ تَلاقٍ لِقَومٍ مِنْ قلوبهمُ","كَما أَرادوا على بُعدِ المَسافاتِ",102,"ت",1,0],["وكم تلافيتَ بتفكيرةٍ","صافيةٍ شَعْباً من الشَّعْبِ",103,"ب",1,0],["وكم تنقلت الأشجار من ملأ","وما تعرش ممن جدَّ أو هزلا",104,"ل",2,0],["وكم تعبر عن سلْع وكاظمهِ","وعن زرود وجيران بذي سلم",105,"م",1,0],["وَكَمْ تَطَرَّبْتُ مُسْتَهَامَاً","إِلَيْكَ إِذْ عِيْلَ عَنْكَ صَبْرِي",106,"ر",2,0],["وكَمْ تمسَّكْتُ بأَعْطافِه","وها بقَايا مِسْكه في يَدِي",107,"ي",1,0],["وَكمْ تُهْت في غَوْرِ خَصْرٍ لهُ","وَأَشْرَفْتُ مِنْ فَوْقِ ذاك الكَفَلْ",108,"ل",1,0]]}