ewPoem.aspx?id=203029",""],[6189,"أروى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83571&r=&rc=38",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[463,"دعاها معقَّلة ً بالعراقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60165&r=&rc=221",""],[6300,"يوميات مكلوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82841&r=&rc=12",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[201,"البلبل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65295&r=&rc=4",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""],[6355,"من أجل عينيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66570&r=&rc=30",""]],"verses":[["وَكَم تَعَرَّضَ لي الأَقوامُ قَبلَكُمُ","يَستَأذِنونَ عَلى قَلبي فَما وَصَلوا",0,"ل",3,0],["وَكَم تَلاحَمَ كَربٌ عِندَ مُعضِلَةٍ","فَاِنجابَ عَن قَدرٍ لِلَّهِ وَاِنفَسَحا",1,"ح",2,0],["وكم تَشيمُ بُروقاً غيرَ صادِقةٍ","والآلُ ليسَ بما يُرْوي صَداكَ يَفي",2,"ف",2,0],["وكمْ تطلّبْتُ ما أُهدي فما اقْتَصَرَتْ","على الذي بَلَغَتْهُ الطّاقةُ الهِمَمُ",3,"م",1,0],["وكم تَرِب تجسّس للأعادي","فاصبِح من تجسّسه ثريّا",4,"ر",3,0],["وكم تهتزّ أعطاف المعالي","إذا ما قلت قافيةً شرودا",5,"د",2,0],["وكم تقاضاك فيلسوف","حقيقة صعبة الأداء",6,"ا",2,0],["وكم تلطفُ كتبٍ في رسائله","وطيَّها لمزاج الخطب تلطيف",7,"ف",1,0],["وكم تركت بها كفًّ بلا عضد","وقد توسَّدها رأسٌ بلا عنق",8,"ق",1,0],["وَكَم تَشبَّثَ بي يَومَ الرَحيلِ ضُحَىً","وَأَدمُعِي مُستَهِلّاتٍ وَأَدمُعُهُ",9,"ع",2,0],["وكم تبعَ المولِّي منك سيبٌ","فلم يُقدَر له منك اعتصامُ",10,"م",1,0],["وَكَم تَستَكين وَتَستَسلِمُ","وَقَد بَلَغَ السَيلُ زُنّارَها",11,"ه",2,0],["وَكَم تَدورينَ حَولَ البَيتِ حائِرَةً","بِنتَ الرُبى لَيسَ مَأوى الناسِ مَأواكِ",12,"ك",1,0],["وَكَم تَرَجَّحتِ في مَهدِ الضِياءِ عَلى","تَوقيعِ لَحنِ الصِبا أَو رَجعِهِ الحاكي",12,"ك",2,0],["وَكَم تَعولينَ وَكَم تَصرُخينَ","كَعُصفورَةٍ راعَها الأَجدَلُ",13,"ل",1,0],["وَكَم تَصحَبُ مَن يُف","سِدُ في الأَرضِ وَلا يُصلِح",14,"ح",1,0],["وَكَمْ توَشَّحْتَ من ليلٍ ومن شَفَقٍ","ومِنْ صَباحٍ تُوَشِّي ذيلَهُ السُّدُمُ",15,"م",1,0],["وكم توسدت من ال","حسان أبهى معصم",16,"م",1,0],["وَكَم تَدَّعي السودانَ يا مَكسُ هازِلاً","وَما أَنتَ مُسَوَّدٌ وَلا أَنتَ قاتِمُ",17,"م",1,0],["وَكُمتَ إِذا كَلَّفتَ حاضِنَ ثَلَّةٍ","سُرى اللَيلِ دَنّى عَن فُروجِ المَحارِمِ",18,"م",1,0],["وكم تمنيت لو للرقص تطلبني","وحيرتني ذراعي أين ألقيها",19,"ي",3,0],["وكم تَسَربلتَ مِن سِربالِ مَكرُمةٍ","جَلَّت ولكَّنها دَقَّت مَعانِيها",20,"ي",3,0],["وَكَم تَرَكَ الدَهرُ مِن سَيِّدٍ","يَنوءُ عَلى قَدَمٍ واحِدَه",21,"د",2,0],["وَكَم تَخَرَّمَتِ الأَيّامُ مِن بَشَرٍ","كانوا ذَوي قُوَّةٍ فيها وَأَجسامِ",22,"م",1,0],["وَكَم تَقَنَّصتُ بِها جُؤذُراً","وَرُدتُ مِن عَينٍ بِها جارِيَه",23,"ه",1,0],["وكم تُبْلي الكروبُ عليك جسمي","ألا فَرَجٌ لديك من الكروبِ",24,"ب",1,0],["وَكَم تَحتَ أَرواقِ الصَبابَةِ مِن فَتىً","مِنَ القَومِ حُرٍّ دَمعُهُ لِلهَوى عَبدُ",25,"د",1,0],["وكمْ تخلّفُ في أوراسَ من سِيَرٍ","سارتْ بذكرك في الأسماع والكتب",26,"ب",1,0],["وَكَم تَرى في الأُفُقُِ مِن كَوكَبٍ","يَعظُمُ أَن يُرمى بِهِ المارِدُ",27,"د",1,0],["وَكَم تَعَدَّت يَبيسَ الأَرضِ راعِيَةٌ","مِنَ السَوامِ وَرامَت عَينُها الخُضَرا",28,"ر",2,0],["وَكَم تَرِكَت آهِلاً وَحدَهُ","وَكَم غادَرَت مُثريّاً مُملِقا",29,"ق",2,0],["وَكَم تَحبِسُ زِريابَكَ","في السِجنِ وَطاوُوسَك",30,"ك",1,0],["وَكَم تَرَكوا لَنا أَثَراً مُنيفاً","يَعودُ بِآيَةٍ مُتَأَوِّبوهُ",31,"ب",3,0],["وكم تدعي بالشعر علما ونقده","وأَنتَ عن العلم الَّذي تدعي عاري",32,"ر",2,0],["وكم تعد الأقوام أنك باذل","حقوقاً لهم مغصوبة ثم تبخل",33,"ل",1,0],["وَكَم تدَّعى في النقد أنك صادق","وتورد بالزعم الدَليل فأدحض",34,"ض",1,0],["وكم تمنّتْ رِجالٌ فيكِ مُغْضَبَةً","أنْ يُبْصِروهُ فلم يَظْهَرْ لهمْ سقَما",35,"م",2,0],["وَكَم تَمَنَّيتُ أَن أَراهُ","عَلَيَّ يَقرا لِكُلِّ راوِ",36,"و",1,0],["وكم تمنَى الربيعُ النَضْرُ لو سَعِدَتْ","بحلَّةِ العُرْسِ كَفَاهُ فَوَشَاها",37,"ا",3,0],["وكم ترنَّح سكرانًا بهبَّته","كما ترنح بالصهباء سكران",38,"ن",1,0],["وكم تحدى الملوك مبتسماً","يقول سلطانكم وسلطاني",39,"ن",2,0],["وكم تدّعي عفّة والوجود","بأصناف خسّتها مفعمُ !",40,"م",1,0],["وكم تحسنت وكم تشنَّعا","ولم يزل فضلك فيه مرتعا",41,"ع",2,0],["وكم تشفّعَ بي أن لا أُفَارِقَهُ","وللضروراتِ حالٌ لا تُشفّعُهُ",42,"ع",2,0],["وكُمَّت به الأفواه عن كشف سوءَةٍ","كأنْ لم يكن من ثَمَّ عتبٌ لعاتب",43,"ب",1,0],["وَكَم تَحظى ذَوي الاحساب مُعتَدياً","وَضيعُ جَرثومة في أَنفِهِ شمم",44,"م",1,0],["وكم تهتكنا","لما رأيناه",45,"ا",2,0],["وكَم تِرَةٍ أدركتُ غِبَّ طِلاَبِهَا","بِعَزمٍ كَمَاضِي الشَّفرَتَينِ يَمَاني",46,"ن",2,0],["وَكَم تَعَرَّضَ في أَبهى مَلابِسِهِ","لِعَينِهِ الإِثمُ مُختالاً فَما أَثِما",47,"م",2,0],["وكم تَسَابَقَ أقوامٌ على أمدٍ","لكنَّه لقليل يُسِّرَ السَّبَق",48,"ق",1,0],["وَكَم تَشَفَّعَ في أَن لا أُفارِقَهُ","وَلِلضَّرُورَةِ حَالٌ لا تُشَفِّعُهُ",49,"ع",2,0],["وكَمْ تَجَلَّدْتُ لا لِأَنِّي","عَلى عذابِ الهَوى جَليدُ",50,"د",1,0],["وَكَم تَتَرَدُّونَ الخُمولَ ضَراعَةً","وَلُؤماً وَتَشرونَ الغَباوَةَ بِالنُبلِ",51,"ل",1,0],["وَكَم تَخطَّأتُ في قَصدِيكَ مِن مَلِكٍ","لِي عِندَه لَو أَرَدتُ النَهلُ وَالعَلَلُ",52,"ل",1,0],["وَكَم تَرى مِن قَوِيٍّ فَكَّ قُوَّتَهُ","طولُ الزَمانِ وَسَيفاً صارِماً نَجَلا",53,"ل",2,0],["وكم تراءت له من خلفها صور","يختال فيها الربيع البكر في تبه",54,"ه",1,0],["وكم تنعقُ الغربانَ لكنَّ بومةً","تقولُ اسمعوا إنَّ الغرابَ حكيمُ",55,"م",1,0],["وكمْ تَلَجْلَجَ قلبي في هواها وكَمْ","لَجَّ العواذلُ في عَذلي وتَعْنِيفي",56,"ف",2,0],["وَكم تَعهَّدت جرحى من أُسودِ وغىً","إن يَكشِر الدهرُ عن أحداثهِ كَشَروا",57,"ر",3,0],["وَكَم تَموتونَ بِأَد","واءِ الهُمومِ المُدوِيَه",58,"ي",2,0],["وَكَم تعاميت عَن رشادي","وَمتهج الحق مُستَقيم",59,"م",1,0],["وَكَم تغيرت الايام وَالتبست","فَما تغيرت اخلاقي وَلا شيَمي",60,"م",2,0],["وَكَم تواجد من وَجدي لشبهتي","مَن لَيسَ تسعده بالدمع عَيناه",61,"ا",2,0],["وكم توَغّلتَ في الإعجاب مشتملا","بالجهل والحلم أسنى منه مشتمَلا",62,"ل",2,0],["وكَم تَمَلْمَلَ مِنْ حَيْفٍ ومَنْ جَنَفٍ","لِجَاعِلٍ نَصْرهُ المَشْرُوعَ خذْلانا",63,"ن",2,0],["وَكَمْ تَمامٍ يَكُونُ النقْصُ أَوَّله","قَطُّ الذُّبالِ يُوَفّي ضَوْؤُهُ السرُجا",64,"ج",2,0],["وَكَم تَجَرَّعتُ بِالجَرعاءِ مِن أَسَفٍ","قَلبي بِأَوصابِهِ مِلآنَ مَلآنُ",65,"ن",1,0],["وَكم تمطّى بأعطافٍ مرنَّحةٍ","في رفرفٍ كجنانِ الخلد فيّاح",66,"ح",1,0],["وكم ترشفت له مبسماً","نكهته أرخصت الغاليه",67,"ه",1,0],["وكم تلوين عن محمود فعل","وكم تقعين في قبح الفعال",68,"ل",1,0],["وكم تحفة كم طرفة كم عطية","به دونها بسطى وروحي وراحتي",69,"ي",1,0],["وَكُمتاً مُدَمّاةً كَأَنَّ مُتونَها","جَرى فَوقَها وَاِستَشعَرَت لَونَ مُذهَبِ",70,"ب",1,0],["وكم تَرَى في الزَّمانِ أصحابَ أق","لامٍ لظُفْرٍ بهنَّ ما قَلَموا",71,"م",3,0],["وكم تَعصَّبَ من جَهْلٍ عليَّ إلى","أن رُعتُه فأبَى إلاّ التَعصُّبَ لي",72,"ل",2,0],["وَكَم تَلعَب بي أَحَداً","ثُكِّ السودُ وَكَم تَسطو",73,"ط",2,0],["وَكَم تُرِّبَت وَاِنبَرَت لِلعَدُوِّ","كَوَثبِ الشَرارِ وَهَدَّ الجِبالِ",74,"ل",1,0],["وكم تَقتلُهُم صَبراً","فإنَّ القَتلَ قُربانُ",75,"ن",1,0],["وكَمتاءَ في حانوتِ قَسٍّ بِتاجِها","ركبتُ إلَيها مِن دُجى اللَّيلِ أدهَما",76,"م",2,0],["وكم تَباكَينا وما يَستَوي","هل تَلحقُ الكحلاءَ ذاتُ المرَه",77,"ر",2,0],["وكم تفضل وكم أنعم","لعبده الظالم الكفار",78,"ر",1,0],["وكم تحيات لنا أرسلوا","حياهم اللّه وبَيَّاهُمُ",79,"م",1,0],["وَكَم تَعَسَّفت في قَصديه مِن خَطَرٍ","لا يبلغ المَجدَ مَن لا يَركَبُ الخَطَرا",80,"ر",2,0],["وَكَم تدرعت مِن بَيداء مُقفِرَة","في لَيلَة خِلتُ أَن الصبح لَم يؤُبِ",81,"ب",1,0],["وكم تشاجَرَ أَقوامٌ فقلتُ لهُمْ","إِن الأَصولَ عليها تنبتُ الشجَرُ",82,"ر",1,0],["وكم تأَسَّفَ مِنْهُمْ فِي معاهِدَ قَدْ","آلَتْ معاهِدَ للأَحزانِ والهَبَلِ",83,"ل",1,0],["وكم تعالت لنا أصواتها هرجا","فأضحكتنا وشاقتنا بإيماء",84,"ا",2,0],["وكم تبيتون طُروحَ الشكّ في","ودّكمُ ورجمِ سوءِ الظِّننِ",85,"ن",1,0],["وكم تتزوَّى هضبةٌ بعد هضبةٍ","بهم ولرَضوَى منكِب لا يُزَيَّلُ",86,"ل",1,0],["وكم تحت درعي باللوي من جراحةٍ","لعَجماءَ ما فيها قَصاصٌ ولا عَقْلُ",87,"ل",1,0],["وكم تستقيمُ فتمشي الحظوظُ","وحظُّك أعمى الخُطى مُزلقُ",88,"ق",1,0],["وكم تُرَى تَسحرني بابلٌ","وبابلٌ بالطبع سحّارَهْ",89,"ر",2,0],["وكم تعيَّفتُ لكم سُفورَها","من قبل أن يبرُزَ وجهُ السافرِ",90,"ر",1,0],["وكم تَكتسِي في ظلِّ قومٍ أعزةٍ","قوادمُ ريشي ثم تَعرَى فتُسلَبُ",91,"ب",1,0],["وكم تصدَّى عمداً ليخدَعَني","يَسفِر عن غيهبٍ وينتقبُ",92,"ب",1,0],["وكم تحت أفق الغرب من أنت شمسهُ","وبالشام من طرفٍ كبرقكِ شائمِ",93,"م",1,0],["وكم توسلت الثكلى بمرضعها","تلك الليالي وجارى الأيم الهرم",94,"م",1,0],["وكم تلا القوم آيات الكتاب وكم","تلوا حديثا وكم حفت بك النعم",94,"م",1,0],["وكم تجهمت فيه من معاكسة","كي يستفزوا نهاي فيه للغضب",95,"ب",1,0],["وكم تنمرت في قنص الشوارد لا","يصدني سارب عنهم وما أثق",96,"ق",1,0],["وكم تسورت في أرض المعارف ما","أرى سواها ولو بالبين أحترق",96,"ق",1,0],["وكم تحت اذيالِ هذا الترا","بِ نفوسٌ قضت قبل نيل المنى",97,"ن",2,0],["وكمْ تمنّيتُ لو أعودُ","إلى سمائِي فلا أروبُ",98,"ب",1,0],["وَكَم تَجَلَت بَراهين وَمُعجزة","وَكَم تَوالَت كَرامات وَآيات",99,"ت",1,0],["وكم تغنَّى بِنَغَم","يطرُدُ عنك كلَّ غَم",100,"م",1,0],["وَكَم تَحملونا كلَّ يومٍ وليلةٍ","على ظَهرِ جمّاحٍ من الشّرِّ قامِصِ",101,"ص",1,0],["وَكَمْ تَلاقٍ لِقَومٍ مِنْ قلوبهمُ","كَما أَرادوا على بُعدِ المَسافاتِ",102,"ت",1,0],["وكم تلافيتَ بتفكيرةٍ","صافيةٍ شَعْباً من الشَّعْبِ",103,"ب",1,0],["وكم تنقلت الأشجار من ملأ","وما تعرش ممن جدَّ أو هزلا",104,"ل",2,0],["وكم تعبر عن سلْع وكاظمهِ","وعن زرود وجيران بذي سلم",105,"م",1,0],["وَكَمْ تَطَرَّبْتُ مُسْتَهَامَاً","إِلَيْكَ إِذْ عِيْلَ عَنْكَ صَبْرِي",106,"ر",2,0],["وكَمْ تمسَّكْتُ بأَعْطافِه","وها بقَايا مِسْكه في يَدِي",107,"د",2,0],["وَكمْ تُهْت في غَوْرِ خَصْرٍ لهُ","وَأَشْرَفْتُ مِنْ فَوْقِ ذاك الكَفَلْ",108,"ل",1,0],["وكم تحقق في يسر لقاصدكم","ماكان أمل من قصد ومن أرب",109,"ب",1,0],["وَكَم تائه مِنا بِثَوب مُنَمَق","وَأَحرى بِهِ مِنهُ الأَديم المرقع",110,"ع",1,0],["وكم تجور الليالي في حوادثها","على فؤَادٍ بنار الحزن يلتهبُ",111,"ب",1,0],["وَكَم تاه عَن خَط الحِصار مجربٌ","بِما راع مِن فَيض المِياه المضرة",112,"ه",1,0],["وَكَم تكلّم في ذمّي يُمازحني","فَلَم تؤخّر لَهُ إِذناً إِذَن أُذني",113,"ن",2,0],["وكم تعنت ذو جهل علي به","فبان لي أنه دب بلا رسن",114,"ن",1,0],["وكم تتعالى غواربها","فترمي السفائن في لج قعر",115,"ر",1,0],["وكم تسابق أبطال القريض معي","إليك وازدحمت أبكار مدحهم",116,"م",1,0],["وكم توقَّفتُ يأساً وارتجعتُ أسىً","فما توقَّفَ عن هجري ولا ارتجعا",117,"ع",2,0],["وكم تضمُّ أَقاصي الأرض من أُمَمٍ","لولاك لم يجدوا في الأرض مُتسَّعَا",117,"ع",2,0],["وَكَم تَهدَّمَ بُرجٌ مِن مَدافِعِهم","كَأَنَّه عقبَ التّشييدِ هُذلولُ",118,"ل",1,0],["وَكَم تَساقطَ سورٌ مِن قَنابرهم","وَكَم تَجَندلَ قِرْمٌ وَهوَ مَتلولُ",118,"ل",1,0],["وَكَم تَقَرَّبَ يَومَ النَّحرِ منتدِبٌ","بِنَحرِهِ مُشرِكاً وَالنّحرُ مَقبولُ",118,"ل",1,0],["وَكَم تَحلَّلَ مِن إِحصارِهِ رَجُلٌ","بِذَبحِ عِلْجٍ وَمِنهُ الرَّأسُ مَفصولُ",118,"ل",1,0],["وَكَم تَلَقّانا بِها مِن فاضِل","مِن عالم وَمُقرِء وَكامِلِ",119,"ل",1,0],["وكم تراءَتْ ليَ الأطماعُ كافِلَةً","بما أُحبّ فما ذَلَّتْ لها عُنُقي",120,"ق",2,0],["وكم تصاممْتُ تعليلا بلا صَممٍ","عن ناصحٍ حين سمعي نُصْحُه طرَقا",121,"ق",2,0],["وكم تسأل الروض عن زهره","وفي مطلع الصبح منه اتضاح",122,"ح",1,0],["وكم تلوت السورا","وكم علوت المنبرا",123,"ر",2,0],["وكم تركت القسما","اياك أعني القسما",123,"م",2,0],["وَكَم تَرحَةٍ لَم أَحتَسِبها لَقيتُها","وَكَم فَرحَةٍ جاءَت عَلى غَيرِ مَوعِدِ",124,"د",1,1],["وَكَمْ تَركْتَ رُبُوعاً لَيْسَ يعمرهَا","سوَى الحَدَايَةِ وَالخُطَّافِ وَالصرَدِ",125,"د",1,0],["وكَمْ تَركْت أباً يَبْكِي عَلَى ولد","أذَقْتَهُ طَعْم ثُكْلِ الأمّ للولدِ",125,"د",1,0],["وَكَمْ تَوَسَّدْتَهَا رأساً بِلاَ عنق","كَمَا ارْتَدَيْتَ بِهَا ثَوْباً بِلاَ جَسَدِ",125,"د",1,0],["وَكَمْ تَرَكْتَ أميناً غَيْرَ مُؤْتَمَنٍ","كَمَا تَرَكْتَ عِمَاداً غَيْرَ مُعْتَمَدِ",125,"د",1,0],["وَكَمْ ترقَّيتَ مَرْقىً عَزَّ مَدْركُهُ","وكَمْ تَخَلَّلْتَ حَتَّى غَابَةِ الأسُدِ",125,"د",1,0],["وَكَمْ تصبرتُ حَتَّى لاَتَ مُصْطَبَرٍ","فَالآنَ أجْهُدُ حَتَّى لات مُجْتَهَدِ",125,"د",1,0],["وكم تزكى بمعناها شعيب كما","لذت لموسى بها تلك المناجاة",126,"ه",1,0],["وَكَمْ تشبّ بِنِيرَانٍ جَوَانِحُنَا","كَمَا تَفِيضُ بِطوفَانٍ مآقِينَا",127,"ن",2,0],["وكم تجدّين في تطلبك ال","علم ولا تجهدين بالعملِ",128,"ل",1,0],["وكم تصيح بتاريخي منكّدةٌ","على فرنسيس خلّي واه وأحزاني",129,"ي",1,0],["وكم ترى من شج لاهٍ اخي شغفٍ","قد راح للدهر نشواناً بها ثملا",130,"ل",2,0],["وكم ترى وشح الأيام حين بدا","من السرور ومن وافي البها حللا",130,"ل",2,0],["وكم تَعاطَى مِنْ فِعْلِ مَكْرُمَةٍ","وأَعْجَزَ النَّاسَ عن تَعاطيهِ",131,"ي",2,0],["وكَمْ تَقاضاهُ بالنَّدَى خُلُقٌ","يعاجِلُ الوَفْدَ عن تقاضيهِ",131,"ي",2,0],["وكم تَقَحَّمْتَ في الهَيجاءِ تَسْأَلُها","أَشَدَّ أَبطالِها بَأْساً فتُعْطِيكا",132,"ك",2,0],["وكمْ تَنازَلْتُ في ذُلِّ العِتابِ لَها","عن دَسْتِ عِزِّي ولم تَنْزِلْ عن البَغْلَهْ",133,"ل",2,0],["وَكَمْ تَلَهَّفَ لِلإعْجَازِ ذُوْ حَوَرٍ","شَدتْهُ فِيْ لهَفَةِ المغْنَى دَوَاعِيْهِ",134,"ي",2,0],["وكم تايه في مهمه اللهو والعما","وقبح فعال كسره آل للجبر",135,"ر",1,0],["وكم تفضل كم أسدى وكم منن","عظمى أنال كشمس في المنحى سفرت",136,"ت",1,0],["وكم تواضعت عن فضل وعن شرف","وهمةٍ هامةَ الجوزاء تنتعل",137,"ل",1,0],["وَكَم تَرى مِن فائِزٍ فيهِمُ","جَلَّلَهُ سِترٌ مِنَ اللَهِ",138,"ل",2,0],["وكم تألق عرسانا بغابتها","وكم تضاحك قلبانا بواديها",139,"ي",3,0],["وكم تعرض في مجراه من جهة","فاحدث الموت خلجانا وغدرانا",140,"ن",2,0],["وكم تطلبها ذو العلم فأمتنعت","عن المنال ومس الطالب اللغب",141,"ب",1,0],["وكم تعرَّض للقلب المعذَّب من","مستعذَب الدلّ لولاهُ لوالاهُ",142,"ا",2,0],["وَكَم تَأَلَّفَ فِيكَ الرُّومُ وَاجتَمَعُوا","وَأَنتَ فِي أَنفِ ذَاكَ الجَمعِ كَالشّمَمِ",143,"م",1,0],["وكم تكّدر يوما في زيادته","فراق عيش البرايا عنده وصفا",144,"ف",2,0],["وكم تحلق حتى خاض واردهم","فيه وقابل منه رقّةً بجفا",144,"ف",2,0],["وكم تنصل منها عاشق بشبا","قدّ فراح قتيل البيض والأسل",145,"ل",1,0],["وكم تعرض صب نحو حاجبها","فراحت الروح بين السهم والوتر",146,"ر",1,0],["وكم تسليت إذ جاءوا بإفكهم","وقلت صبرا ففي الأيام تحويل",147,"ل",1,0],["وكم تتلظَّى عُطاشُ السيوف","إلى وِرد ماء الطِلى الهامرِ",148,"ر",1,0],["وكم تعلِّلُ بيض الهندِ مغمدةً","عَن الضراب ولمَّا تعترق وَدَجا",149,"ج",2,0],["وَكَم تَأَزَّرَتِ الغيطانُ لي كَرَماً","وَاِستَنشَقَتنِيَ أَنفاسُ الشَناخيبِ",150,"ب",1,0],["وكم ترى كلما أمعنت من رجل","مثل النعامة لا طير ولا جمل",151,"ل",1,1],["وكم تَمَطّرَ بي في شأْوِ كلِّ علا","وإن غدا وهو للحرمان في شَكَل",152,"ل",1,0],["وكم تجود بجمّاتِ الثّوابِ غداً","وأنتَ توصف فينا اليومَ بالبُخُلِ",153,"ل",1,0],["وكم تَلظَّيت من أُناسٍ","أَشكو إليهِم شَكوى الجريحِ",154,"ح",1,0],["وكم تصبت سيوفاً فيك لامعةً","قد فارقت في ربى لبنانها الغمدا",155,"د",2,0],["وكم تفاصيل أُعدّتْ بالجُمَلْ","فرّقَها زيني على أَهْلِ الدُّوَلْ",156,"ل",1,0],["وَكَم تَضَمَّنَ قَومٌ في جِدالِهِمُ","أَن يَفهَموكَ فَما أَوفوا بِما ضَمِنوا",157,"ن",3,0],["وكم تطوق من جيد بجود يد","له نداها كحلي الطوق للجيد",158,"د",1,0],["وكم تباشر رهبان وقيل لهم","لزهد مال الذي تخشونه وصبا",159,"ب",2,0],["وكم تُطمع الأيامُ قلبي وناظري","بليلَى لقد حاولت أبعدَ مطمعِ",160,"ع",1,0],["وكم تنقلت تلذذاً بها","في اللهو واللذة بالتنقل",161,"ل",1,0],["وَكَم تَرَكتُ بِعَينِ الجَرِّ مِن بَطَلٍ","يَمشي العِرِضنَةَ فيهِ الرُمحُ مُعتَدِلُ",162,"ل",1,0],["وَكَم تَمرّ عَلى ذي العَقل معضلة","لا يَهتدي عَقلهُ فيها لَما عَضلا",163,"ل",2,0],["وكَم ترى في الغرب والجنوبِ","عنها منَ الأَوساخِ يا حبيبي",164,"ي",1,0],["وكَم ترى في الغرب ثُمَّ الشَّرقِ","عن جَاوَةٍ مِن وَسَخ ورقِ",164,"ق",1,0],["وكَم ترى شرقيَّ ذي الجزيرَه","جزايراً لَم تُعتَرَف كثيرَه",164,"ه",1,0],["وكم تجدد فينا كل نائبة","جلت فذاب لها من هولها الفطن",165,"ن",1,0],["وكم تمنين لو يبلغن مرتبة","يركعن منها لديه فهو معبود",166,"د",1,0],["وكم تجافى هل نيله","ومن أتاه يستنيل نالا",167,"ل",2,0],["وكم تامت القلب غيداء جيدا","بصبح الجبين وليل العقاص",168,"ص",1,0],["وكم تصيَّدتُ والصِّبا شركي","سِرْبَ ظِباء لحاظُهن ظُبا",169,"ب",2,0],["وَكَم تَرانا في ظَلام اللَيلِ","نَرفَعُ زَنبيلاً كَهَطل السَيلِ",170,"ل",1,0],["وكم تحيي الظلام وانت ميت","وكم تعلو النجوم وانت دون",171,"ن",1,0],["وكم تأخر عنها من يحق بان","يحل من صدرها في العلم والحسب",172,"ب",1,0],["وكم تركوا النساء تبيت تشكوا","وتسعدها الأُصبية الصغار",173,"ر",1,0],["وكم تبدي له عزم يمازجه","حزم تحل بايديه الصعوبات",174,"ت",1,0],["وكم تسامى إليها بارع فرأى","طريقها غير ما سهل ولا أمم",175,"م",1,0],["وكم تهاون بالأيام تدفعه","الى مواقف أهوال وأخطار",176,"ر",1,0],["وكم تردى بما ارداه ممتنع","من الل