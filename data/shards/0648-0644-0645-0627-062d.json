{"poems":[[79,"ولما حثثت السير والله حاكم","https://www.aldiwan.net/poem36475.html","الطويل"],[79,"جلا الحق قلبي حتى أنارا","https://www.aldiwan.net/poem36501.html","المتقارب"],[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[39,"ولم أحلل لصاعقة وبرق","https://www.aldiwan.net/poem7618.html","الوافر"],[74,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[74,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[53,"عاقنا أن نعود أنك أوليت","https://www.aldiwan.net/poem7954.html","الخفيف"],[53,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[53,"أزر صلة قدمتها أخواتها","https://www.aldiwan.net/poem8697.html","الطويل"],[53,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[53,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[53,"أقول لسائلي بك يا ابن يحيى","https://www.aldiwan.net/poem61900.html","الوافر"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[94,"أراك فتحلو لدي الحياة","https://www.aldiwan.net/poem38925.html","المتقارب"],[80,"وردت أبا الفتح سيدي","https://www.aldiwan.net/poem14189.html","المتقارب"],[64,"ولما حللنا جميع الرموز","https://www.aldiwan.net/poem52148.html","المتقارب"],[47,"إليك ما أنا من لهو ولا طرب","https://www.aldiwan.net/poem10655.html","البسيط"],[47,"وأظلمت حين لبست السواد","https://www.aldiwan.net/poem11050.html","المتقارب"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[47,"هب الدار ردت رجع ما أنت قائله","https://www.aldiwan.net/poem65535.html","الطويل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[77,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54657","الرمل"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[79,"ولما حثثت السير والله حاكم","https://www.poetsgate.com/ViewPoem.aspx?id=34115",""],[159,"وشمس بأعلاه وليلين أسبلا","https://www.aldiwan.net/poem55782.html","الطويل"],[189,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[190,"عدوك في النفاق عدو سوء","https://www.aldiwan.net/poem43656.html","الوافر"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[211,"أبى قومنا إلا الفرار ومن تكن","https://www.aldiwan.net/poem27898.html","الطويل"],[265,"حتام لا ينثني الجموح","https://www.aldiwan.net/poem38346.html","مخلع البسيط"],[308,"أموت بدائي والدوا في يديكم","https://www.aldiwan.net/poem16754.html","الطويل"],[332,"حبيبي جاني وهناني","https://www.aldiwan.net/poem54908.html","عموديه"],[342,"ذممتك أولا حتى إذا ما","https://www.aldiwan.net/poem68795.html","الوافر"],[353,"مذ أفقرت ممن أحب الأربع","https://www.aldiwan.net/poem15781.html","الكامل"],[368,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[395,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[436,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[445,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"],[451,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[461,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[461,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[461,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[464,"واقسم ما يممت بالعزم وجهة","https://www.aldiwan.net/poem15585.html","الطويل"],[467,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[467,"ولما حجبنا عنك سراً وجهرة","https://www.aldiwan.net/poem3390.html","عموديه"],[467,"أحب الحمى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[480,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[498,"أليلتنا بين العتابين والعذر","https://www.aldiwan.net/poem9855.html","الطويل"],[509,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[517,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[518,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[518,"الطويل","https://www.aldiwan.net/poem12121.html","الطويل"],[541,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[554,"أسيف الدين قد حملت ظهري","https://www.aldiwan.net/poem47308.html","الوافر"],[554,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[556,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[565,"لقد أبقى نقولا حين ولى","https://www.aldiwan.net/poem52603.html","الوافر"],[565,"ضريح قد سقاه سحاب فضل","https://www.aldiwan.net/poem52671.html","الوافر"],[1136,"","https://poetry.dctabudhabi.ae/diwan/poem/97803","الطويل"]],"verses":[["ولمّا حثَثْتَ السّيْرَ واللهُ حاكِمٌ","لمُلْكِكَ في الدُنْيا بعِزٍّ وفي الأخْرى",0,"ر",2,1],["ولمّا حلَلْنا بأكْنافِهِ","حلَلْنا الحُبا ونبَذْنا الوَقارا",1,"ر",2,0],["وَلَمّا حَضَرنا الإِذنَ وَالدَهرُ خادِمٌ","تُشيرُ فَيُمضي وَالقَضاءُ مُصَرِّفُ",2,"ف",1,0],["ولم أحلل لصاعقة وبرق","كما درَّت لحالبها الزَّجُومَ",3,"م",1,1],["ولم أحجب العذَّال منه بحاجبٍ","رَأَوا عنده حقّ الملاحة أبلجا",4,"ج",2,0],["ولما حللتَ البيتَ كاد مقامُه","للقياك يسعى فهو للسعي قائم",5,"م",1,0],["ولَمَا حَقَّ إن قَرُبْتَ التنائي","ولَمَا حَقّ إن بَرَرْتَ الجفاءُ",6,"ا",2,0],["ولما حُمَّ مرجِعُنَا وصحّتْ","على الإيجاف عَزْمات القلوبِ",7,"ب",1,0],["ولم أحْتَقِرْ ما كان مِنْك وإنهُ","لكُثْرٌ إذا عَدَّتْ رجالٌ صِلاتِها",8,"ت",3,0],["ولم أحتَبِسها إذ حبستَ مثوبتي","لأن مديحاً لم يجد بعدُ مَمْدحا",9,"ح",2,0],["ولمَا حباك بحظه لجهالةٍ","لكن لفضل مُمَنَّحِ منَّاح",10,"ح",1,0],["ولم أحمد به إلا حميداً","بإجماع المُصَالحِ والمُعَادي",11,"د",2,0],["ولَما حُبيتَ برتبةٍ","إلا وأنت بها جديرُ",12,"ر",1,0],["ولمَا حَظيتُ بعُرفه ولقد جَرَتْ","بوفاتِه مِحنٌ عليَّ ثِقالُ",13,"ل",1,0],["ولم أَحتمل فيه عِبئاً ثقيلاً","من الذِّكْرَياتِ التي لا تَبيدْ",14,"د",1,0],["وَلَمّا حَلَلتَ بِنا لَم تَحُلّ","مِن العين وَالقَلب غَيرَ السَوادْ",15,"د",1,0],["ولما حللنا جميع الرموز","ولم يبق من حلنا مشكلُ",16,"ل",1,1],["وَلَم أُحابِكَ في مَدحٍ تُكَذِّبُهُ","بِالفِعلِ مِنكَ وَبَعضُ المَدحِ مِن كَذِبِ",17,"ب",1,0],["وَلَمّا حَضَرنا لِإِذنِ الوَزي","رِ وَقَد رُفِعَ السِترُ أَو جانِبُه",18,"ب",2,0],["وَلَمّا حَبا أَرضَ العِراقِ بِقُربِهِ","طَما بَحرُهُ فيها وَنائِلُهُ الغَمرُ",19,"ر",1,0],["وَلَمّا حَضَرنا سُدَّةَ الإِذنِ أُخِّرَت","رِجالٌ عَنِ البابِ الَّذي أَنا داخِلُه",20,"ل",2,0],["ولمّا حثثْتَ الجيشَ لاحَ لأهْلِهِ","طريقٌ إلى أقصَى خُراسانَ مَهيَع",21,"ع",1,0],["ولمّا حططتُ الرَّحْلَ دون عِراصِهِ","أخذتُ أمانَ الدهر من نُوَب الدهر",22,"ر",1,0],["ولِمَ احتشادُ سرائري وخواطري","ولمن شفاهٌ بالدعاءِ تتمْتمُ",23,"م",1,0],["وَلِمَا حَاذَرْتُ مِنْ فِطْ","نَتِهِمْ فِينَا فَطِنْتِ",24,"ت",1,0],["ولما حللت بدار المزور","ومن عادة الدار ترحابها",25,"ب",3,0],["ولما حثثت السير والله حاكم","لملكك في الدنيا بعز وفي الأخرا",26,"ر",2,1],["ولمَّا حوى نصفَ الدُّجى نصفُ خدِّهِ","تحيَّر حتى ما درى أَيْنَ يذهبُ",27,"ب",1,0],["ولما حَباني الدهرُ منه بعودةٍ","وراجَعَ حظى بعدَ طولِ اجْتِنابه",28,"ب",2,0],["ولم أحذر مكائده لما قد","عرفت وكان قد كشف القناعا",29,"ع",2,0],["ولمّا حباهُ اللَّه منه نبوّةً","بِها فاقَ كلَّ الخلقِ في عصره خيرا",30,"ر",2,0],["وَلَم أَحتَسِب سُفيانَ حَتّى لَقيتُهُ","عَلى مَأقِطٍ إِذ بَينَنا عِطرُ مَنشِمِ",31,"م",1,0],["ولم احرفي الوداع حزنا","وربما الكن الفصيح",32,"ح",1,0],["ولما حدا بي حادي قاصدا","إليكم بجندي فطرتي وهوائي",33,"ا",3,0],["ولمّا حببته سقاني","من كارس غرامه ورواني",34,"ي",1,0],["وَلَم أَحمَدكَ مِن خَيرٍ وَلَكِن","رَأَيتُ سِواكَ شَرّاً مِنكَ جِدّا",35,"د",2,0],["وَلَمّا حَذا يَومَ النَوى بِنِياقِهِم","أَنّى أَصَمَّ السَمعَ وَهوَ المُسمِعُ",36,"ع",1,0],["ولمّا حجَجْتَ البيتَ حَجَّك لائذاً","بكَ البيتُ والوفدُ الحَجيجُ حُضور",37,"ر",1,0],["ولما حرت في شأنيوأمري","طفقت مستغيثا بالنداء",38,"ا",2,0],["ولما حان من قومٍ طغاةٍ","حِمامٌ حثّهُ قدَرٌ وحِينُ",39,"ن",1,0],["ولما حدتنا حداة السرى","إليها فكان الصباح المضيفه",40,"ف",2,0],["ولما حبست على معالم رامة","نضوي أسائل صامت الجلمود",41,"د",1,0],["ولم أحسبِ البلوى عليها مُزاحِمٌ","ولا أنَّ ضنكَ العيش فيه حسودُ",42,"د",1,0],["ولم أحسب دُجَيلا من مياهي","ولا أنّ المَطيرةَ من بلادي",43,"د",2,0],["ولم أحسَب الأطلالَ تُخضعها النّوى","ولا أنّ جسم الربع يُنحِلهُ الحبُّ",44,"ب",1,0],["ولما حويت الفخر من صدق حُبِّهِ","تناسيتُ صَيْفيَّ الفخارِ وأكْثما",45,"م",2,0],["ولما حل الأطلال هبَّ نسيمها","بالركبِ عن سرّ العبير معبرا",46,"ر",2,0],["ولَّما حجبنا عنك سرَّاً وجهرة","وقابلنا البوَّابُ بالمنظر الجهمِ",47,"م",1,1],["ولما حنى منحاجبيه حنيَّة","تيقنت أن الهدب أمثالُ نبلهِ",48,"ل",2,0],["ولم أحُلْ عمّا عهدْتُمْ","مِن قديمِ وجدي",49,"د",2,0],["ولما حبانا الصبح برد نسيمه","تحيز عن حجري ودمعته تجري",50,"ر",2,0],["ولما حَللنا فِناء الرّسول","نَزَلنا بأَكرمِ خلقِ جوارا",51,"ر",2,0],["ولم أحسَبِ الرُمّانِ من ثمرِ القَنا","إِلى أن رأتْهُ العينُ وهو نُهودُ",52,"د",1,0],["ولما حللت بأرجائها","نقعت الصدى وجلوت الصدا",53,"د",2,0],["ولما حضرنا مجلس الأنس لم يكن","على وجهة إذ غبت أنس ولا بشر",54,"ر",1,0],["ولم أحترِف يوماً مَديحَ قصَائِدي","إذا جَاء ذُو مَدحٍ وفي يَدِه قَعبُ",55,"ب",1,0],["وَلمّا حزتُمُ أملِي أَمرتمْ","لساني أنْ يقول لكمْ فقالا",56,"ل",2,0],["وَلَمّا حَضرناكَ عندَ البِياعِ","عَرَفنا بِهَديك طُرقَ الهُدى",57,"ا",1,0],["وَلَم أَحمَدِ الأَيّامَ وَالعَيشَ بَينَنا","نُعَلُّ مِنَ اللَذاتِ طَوراً وَنُنهَلُ",58,"ل",1,0],["ولمَّا حلَّ في فِرْدَوْسِ ربٍّ","وقامَ لهُ بتَسْبِحَةٍ هُتافُ",59,"ف",1,0],["ولمَّا حلَّ في أكنافِ تُرْبٍ","على عَهدِ الصبِّا والموتُ ظالِمْ",60,"م",1,0],["ولما حوت منه أمينة ما حوت","حوت منه فخراً ما لذلك ثاني",61,"ن",2,0]]}