{"poems":[[77,"ولما حثثت السير والله حاكم","https://www.aldiwan.net/poem36475.html","الطويل"],[77,"جلا الحق قلبي حتى أنارا","https://www.aldiwan.net/poem36501.html","المتقارب"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[37,"ولم أحلل لصاعقة وبرق","https://www.aldiwan.net/poem7618.html","الوافر"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[51,"عاقنا أن نعود أنك أوليت","https://www.aldiwan.net/poem7954.html","الخفيف"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"أزر صلة قدمتها أخواتها","https://www.aldiwan.net/poem8697.html","الطويل"],[51,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"أقول لسائلي بك يا ابن يحيى","https://www.aldiwan.net/poem61900.html","الوافر"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[92,"أراك فتحلو لدي الحياة","https://www.aldiwan.net/poem38925.html","المتقارب"],[78,"وردت أبا الفتح سيدي","https://www.aldiwan.net/poem14189.html","المتقارب"],[62,"ولما حللنا جميع الرموز","https://www.aldiwan.net/poem52148.html","المتقارب"],[45,"إليك ما أنا من لهو ولا طرب","https://www.aldiwan.net/poem10655.html","البسيط"],[45,"وأظلمت حين لبست السواد","https://www.aldiwan.net/poem11050.html","المتقارب"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[45,"هب الدار ردت رجع ما أنت قائله","https://www.aldiwan.net/poem65535.html","الطويل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54657","الرمل"],[77,"ولما حثثت السير والله حاكم","https://www.poetsgate.com/ViewPoem.aspx?id=34115",""],[156,"وشمس بأعلاه وليلين أسبلا","https://www.aldiwan.net/poem55782.html","الطويل"],[186,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[187,"عدوك في النفاق عدو سوء","https://www.aldiwan.net/poem43656.html","الوافر"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[208,"أبى قومنا إلا الفرار ومن تكن","https://www.aldiwan.net/poem27898.html","الطويل"],[262,"حتام لا ينثني الجموح","https://www.aldiwan.net/poem38346.html","مخلع البسيط"],[305,"أموت بدائي والدوا في يديكم","https://www.aldiwan.net/poem16754.html","الطويل"],[329,"حبيبي جاني وهناني","https://www.aldiwan.net/poem54908.html","عموديه"],[339,"ذممتك أولا حتى إذا ما","https://www.aldiwan.net/poem68795.html","الوافر"],[350,"مذ أفقرت ممن أحب الأربع","https://www.aldiwan.net/poem15781.html","الكامل"],[365,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[392,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[433,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[442,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"],[449,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[459,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[459,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[459,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[462,"واقسم ما يممت بالعزم وجهة","https://www.aldiwan.net/poem15585.html","الطويل"],[465,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[465,"ولما حجبنا عنك سراً وجهرة","https://www.aldiwan.net/poem3390.html","عموديه"],[465,"أحب الحمى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[478,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[496,"أليلتنا بين العتابين والعذر","https://www.aldiwan.net/poem9855.html","الطويل"],[507,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[515,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[516,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[516,"الطويل","https://www.aldiwan.net/poem12121.html","الطويل"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[552,"أسيف الدين قد حملت ظهري","https://www.aldiwan.net/poem47308.html","الوافر"],[552,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[554,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[563,"لقد أبقى نقولا حين ولى","https://www.aldiwan.net/poem52603.html","الوافر"],[563,"ضريح قد سقاه سحاب فضل","https://www.aldiwan.net/poem52671.html","الوافر"]],"verses":[["ولمّا حثَثْتَ السّيْرَ واللهُ حاكِمٌ","لمُلْكِكَ في الدُنْيا بعِزٍّ وفي الأخْرى",0,"ر",2,1],["ولمّا حلَلْنا بأكْنافِهِ","حلَلْنا الحُبا ونبَذْنا الوَقارا",1,"ر",2,0],["وَلَمّا حَضَرنا الإِذنَ وَالدَهرُ خادِمٌ","تُشيرُ فَيُمضي وَالقَضاءُ مُصَرِّفُ",2,"ف",1,0],["ولم أحلل لصاعقة وبرق","كما درَّت لحالبها الزَّجُومَ",3,"م",1,1],["ولم أحجب العذَّال منه بحاجبٍ","رَأَوا عنده حقّ الملاحة أبلجا",4,"ج",2,0],["ولما حللتَ البيتَ كاد مقامُه","للقياك يسعى فهو للسعي قائم",5,"م",1,0],["ولَمَا حَقَّ إن قَرُبْتَ التنائي","ولَمَا حَقّ إن بَرَرْتَ الجفاءُ",6,"ا",2,0],["ولما حُمَّ مرجِعُنَا وصحّتْ","على الإيجاف عَزْمات القلوبِ",7,"ب",1,0],["ولم أحْتَقِرْ ما كان مِنْك وإنهُ","لكُثْرٌ إذا عَدَّتْ رجالٌ صِلاتِها",8,"ت",3,0],["ولم أحتَبِسها إذ حبستَ مثوبتي","لأن مديحاً لم يجد بعدُ مَمْدحا",9,"ح",2,0],["ولمَا حباك بحظه لجهالةٍ","لكن لفضل مُمَنَّحِ منَّاح",10,"ح",1,0],["ولم أحمد به إلا حميداً","بإجماع المُصَالحِ والمُعَادي",11,"د",2,0],["ولَما حُبيتَ برتبةٍ","إلا وأنت بها جديرُ",12,"ر",1,0],["ولمَا حَظيتُ بعُرفه ولقد جَرَتْ","بوفاتِه مِحنٌ عليَّ ثِقالُ",13,"ل",1,0],["ولم أَحتمل فيه عِبئاً ثقيلاً","من الذِّكْرَياتِ التي لا تَبيدْ",14,"د",1,0],["وَلَمّا حَلَلتَ بِنا لَم تَحُلّ","مِن العين وَالقَلب غَيرَ السَوادْ",15,"د",1,0],["ولما حللنا جميع الرموز","ولم يبق من حلنا مشكلُ",16,"ل",1,1],["وَلَم أُحابِكَ في مَدحٍ تُكَذِّبُهُ","بِالفِعلِ مِنكَ وَبَعضُ المَدحِ مِن كَذِبِ",17,"ب",1,0],["وَلَمّا حَضَرنا لِإِذنِ الوَزي","رِ وَقَد رُفِعَ السِترُ أَو جانِبُه",18,"ب",2,0],["وَلَمّا حَبا أَرضَ العِراقِ بِقُربِهِ","طَما بَحرُهُ فيها وَنائِلُهُ الغَمرُ",19,"ر",1,0],["وَلَمّا حَضَرنا سُدَّةَ الإِذنِ أُخِّرَت","رِجالٌ عَنِ البابِ الَّذي أَنا داخِلُه",20,"ل",2,0],["ولمّا حثثْتَ الجيشَ لاحَ لأهْلِهِ","طريقٌ إلى أقصَى خُراسانَ مَهيَع",21,"ع",1,0],["ولمّا حططتُ الرَّحْلَ دون عِراصِهِ","أخذتُ أمانَ الدهر من نُوَب الدهر",22,"ر",1,0],["ولِمَ احتشادُ سرائري وخواطري","ولمن شفاهٌ بالدعاءِ تتمْتمُ",23,"م",1,0],["وَلِمَا حَاذَرْتُ مِنْ فِطْ","نَتِهِمْ فِينَا فَطِنْتِ",24,"ت",1,0],["ولما حثثت السير والله حاكم","لملكك في الدنيا بعز وفي الأخرا",25,"ر",2,1],["ولمَّا حوى نصفَ الدُّجى نصفُ خدِّهِ","تحيَّر حتى ما درى أَيْنَ يذهبُ",26,"ب",1,0],["ولما حَباني الدهرُ منه بعودةٍ","وراجَعَ حظى بعدَ طولِ اجْتِنابه",27,"ب",2,0],["ولم أحذر مكائده لما قد","عرفت وكان قد كشف القناعا",28,"ع",2,0],["ولمّا حباهُ اللَّه منه نبوّةً","بِها فاقَ كلَّ الخلقِ في عصره خيرا",29,"ر",2,0],["وَلَم أَحتَسِب سُفيانَ حَتّى لَقيتُهُ","عَلى مَأقِطٍ إِذ بَينَنا عِطرُ مَنشِمِ",30,"م",1,0],["ولم احرفي الوداع حزنا","وربما الكن الفصيح",31,"ح",1,0],["ولما حدا بي حادي قاصدا","إليكم بجندي فطرتي وهوائي",32,"ا",3,0],["ولمّا حببته سقاني","من كارس غرامه ورواني",33,"ي",1,0],["وَلَم أَحمَدكَ مِن خَيرٍ وَلَكِن","رَأَيتُ سِواكَ شَرّاً مِنكَ جِدّا",34,"د",2,0],["وَلَمّا حَذا يَومَ النَوى بِنِياقِهِم","أَنّى أَصَمَّ السَمعَ وَهوَ المُسمِعُ",35,"ع",1,0],["ولمّا حجَجْتَ البيتَ حَجَّك لائذاً","بكَ البيتُ والوفدُ الحَجيجُ حُضور",36,"ر",1,0],["ولما حرت في شأنيوأمري","طفقت مستغيثا بالنداء",37,"ا",2,0],["ولما حان من قومٍ طغاةٍ","حِمامٌ حثّهُ قدَرٌ وحِينُ",38,"ن",1,0],["ولما حدتنا حداة السرى","إليها فكان الصباح المضيفه",39,"ف",2,0],["ولما حبست على معالم رامة","نضوي أسائل صامت الجلمود",40,"د",1,0],["ولم أحسبِ البلوى عليها مُزاحِمٌ","ولا أنَّ ضنكَ العيش فيه حسودُ",41,"د",1,0],["ولم أحسب دُجَيلا من مياهي","ولا أنّ المَطيرةَ من بلادي",42,"د",2,0],["ولم أحسَب الأطلالَ تُخضعها النّوى","ولا أنّ جسم الربع يُنحِلهُ الحبُّ",43,"ب",1,0],["ولما حويت الفخر من صدق حُبِّهِ","تناسيتُ صَيْفيَّ الفخارِ وأكْثما",44,"م",2,0],["ولما حل الأطلال هبَّ نسيمها","بالركبِ عن سرّ العبير معبرا",45,"ر",2,0],["ولَّما حجبنا عنك سرَّاً وجهرة","وقابلنا البوَّابُ بالمنظر الجهمِ",46,"م",1,1],["ولما حنى منحاجبيه حنيَّة","تيقنت أن الهدب أمثالُ نبلهِ",47,"ل",2,0],["ولم أحُلْ عمّا عهدْتُمْ","مِن قديمِ وجدي",48,"د",2,0],["ولما حبانا الصبح برد نسيمه","تحيز عن حجري ودمعته تجري",49,"ر",2,0],["ولما حَللنا فِناء الرّسول","نَزَلنا بأَكرمِ خلقِ جوارا",50,"ر",2,0],["ولم أحسَبِ الرُمّانِ من ثمرِ القَنا","إِلى أن رأتْهُ العينُ وهو نُهودُ",51,"د",1,0],["ولما حللت بأرجائها","نقعت الصدى وجلوت الصدا",52,"د",2,0],["ولما حضرنا مجلس الأنس لم يكن","على وجهة إذ غبت أنس ولا بشر",53,"ر",1,0],["ولم أحترِف يوماً مَديحَ قصَائِدي","إذا جَاء ذُو مَدحٍ وفي يَدِه قَعبُ",54,"ب",1,0],["وَلمّا حزتُمُ أملِي أَمرتمْ","لساني أنْ يقول لكمْ فقالا",55,"ل",2,0],["وَلَمّا حَضرناكَ عندَ البِياعِ","عَرَفنا بِهَديك طُرقَ الهُدى",56,"ا",1,0],["وَلَم أَحمَدِ الأَيّامَ وَالعَيشَ بَينَنا","نُعَلُّ مِنَ اللَذاتِ طَوراً وَنُنهَلُ",57,"ل",1,0],["ولمَّا حلَّ في فِرْدَوْسِ ربٍّ","وقامَ لهُ بتَسْبِحَةٍ هُتافُ",58,"ف",1,0],["ولمَّا حلَّ في أكنافِ تُرْبٍ","على عَهدِ الصبِّا والموتُ ظالِمْ",59,"م",1,0]]}