,"https://poetry.dctabudhabi.ae/diwan/poem/199064","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119654","الطويل"],[4290,"","https://poetry.dctabudhabi.ae/diwan/poem/97803","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72733","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76705","الطويل"],[4711,"ولما حدا البين المشت بشملنا","https://www.poetsgate.com/ViewPoem.aspx?id=181426",""],[4778,"طفح الكيل","https://www.poetsgate.com/ViewPoem.aspx?id=196688",""],[4851,"ولما حمى الشوق المبرح ناظري","https://www.poetsgate.com/ViewPoem.aspx?id=182366",""],[3591,"تقرب كل للكريم أخي الجدا","https://www.poetsgate.com/ViewPoem.aspx?id=149402",""],[5145,"أعينا فؤادي على ما يعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108214",""],[5147,"وضاح وجهك من بالحسن جلله","https://www.poetsgate.com/ViewPoem.aspx?id=166739",""],[5183,"رداء الحياء","https://www.poetsgate.com/ViewPoem.aspx?id=186498",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5447,"أنا لي","https://www.poetsgate.com/ViewPoem.aspx?id=208295",""],[5447,"بنت القلب","https://www.poetsgate.com/ViewPoem.aspx?id=208348",""],[5616,"أغرِّد بالقصيدة كلَّ يومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205220",""],[5829,"يا ثغرها","https://www.poetsgate.com/ViewPoem.aspx?id=147423",""],[6152,"حبكِ قد كفاني","https://www.poetsgate.com/ViewPoem.aspx?id=206730",""],[520,"قدومك افرح قلب الهدى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577478",""],[5126,"فكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87793&r=&rc=8",""]],"verses":[["ولمّا حثَثْتَ السّيْرَ واللهُ حاكِمٌ","لمُلْكِكَ في الدُنْيا بعِزٍّ وفي الأخْرى",0,"ر",2,1],["ولمّا حلَلْنا بأكْنافِهِ","حلَلْنا الحُبا ونبَذْنا الوَقارا",1,"ر",2,0],["وَلَمّا حَضَرنا الإِذنَ وَالدَهرُ خادِمٌ","تُشيرُ فَيُمضي وَالقَضاءُ مُصَرِّفُ",2,"ف",1,0],["ولم أحلل لصاعقة وبرق","كما درَّت لحالبها الزَّجُومَ",3,"م",1,1],["ولم أحجب العذَّال منه بحاجبٍ","رَأَوا عنده حقّ الملاحة أبلجا",4,"ج",2,0],["ولما حللتَ البيتَ كاد مقامُه","للقياك يسعى فهو للسعي قائم",5,"م",1,0],["ولَمَا حَقَّ إن قَرُبْتَ التنائي","ولَمَا حَقّ إن بَرَرْتَ الجفاءُ",6,"ا",2,0],["ولما حُمَّ مرجِعُنَا وصحّتْ","على الإيجاف عَزْمات القلوبِ",7,"ب",1,0],["ولم أحْتَقِرْ ما كان مِنْك وإنهُ","لكُثْرٌ إذا عَدَّتْ رجالٌ صِلاتِها",8,"ت",3,0],["ولم أحتَبِسها إذ حبستَ مثوبتي","لأن مديحاً لم يجد بعدُ مَمْدحا",9,"ح",2,0],["ولمَا حباك بحظه لجهالةٍ","لكن لفضل مُمَنَّحِ منَّاح",10,"ح",1,0],["ولم أحمد به إلا حميداً","بإجماع المُصَالحِ والمُعَادي",11,"د",2,0],["ولَما حُبيتَ برتبةٍ","إلا وأنت بها جديرُ",12,"ر",1,0],["ولمَا حَظيتُ بعُرفه ولقد جَرَتْ","بوفاتِه مِحنٌ عليَّ ثِقالُ",13,"ل",1,0],["ولم أَحتمل فيه عِبئاً ثقيلاً","من الذِّكْرَياتِ التي لا تَبيدْ",14,"د",1,0],["وَلَمّا حَلَلتَ بِنا لَم تَحُلّ","مِن العين وَالقَلب غَيرَ السَوادْ",15,"د",1,0],["ولما حللنا جميع الرموز","ولم يبق من حلنا مشكلُ",16,"ل",1,1],["وَلَم أُحابِكَ في مَدحٍ تُكَذِّبُهُ","بِالفِعلِ مِنكَ وَبَعضُ المَدحِ مِن كَذِبِ",17,"ب",1,0],["وَلَمّا حَضَرنا لِإِذنِ الوَزي","رِ وَقَد رُفِعَ السِترُ أَو جانِبُه",18,"ب",2,0],["وَلَمّا حَبا أَرضَ العِراقِ بِقُربِهِ","طَما بَحرُهُ فيها وَنائِلُهُ الغَمرُ",19,"ر",1,0],["وَلَمّا حَضَرنا سُدَّةَ الإِذنِ أُخِّرَت","رِجالٌ عَنِ البابِ الَّذي أَنا داخِلُه",20,"ل",2,0],["ولمّا حثثْتَ الجيشَ لاحَ لأهْلِهِ","طريقٌ إلى أقصَى خُراسانَ مَهيَع",21,"ع",1,0],["ولمّا حططتُ الرَّحْلَ دون عِراصِهِ","أخذتُ أمانَ الدهر من نُوَب الدهر",22,"ر",1,0],["ولِمَ احتشادُ سرائري وخواطري","ولمن شفاهٌ بالدعاءِ تتمْتمُ",23,"م",1,0],["وَلِمَا حَاذَرْتُ مِنْ فِطْ","نَتِهِمْ فِينَا فَطِنْتِ",24,"ت",1,0],["ولما حللت بدار المزور","ومن عادة الدار ترحابها",25,"ب",3,0],["ولما حثثت السير والله حاكم","لملكك في الدنيا بعز وفي الأخرا",26,"ر",2,1],["ولمَّا حوى نصفَ الدُّجى نصفُ خدِّهِ","تحيَّر حتى ما درى أَيْنَ يذهبُ",27,"ب",1,0],["ولما حَباني الدهرُ منه بعودةٍ","وراجَعَ حظى بعدَ طولِ اجْتِنابه",28,"ب",2,0],["ولم أحذر مكائده لما قد","عرفت وكان قد كشف القناعا",29,"ع",2,0],["ولمّا حباهُ اللَّه منه نبوّةً","بِها فاقَ كلَّ الخلقِ في عصره خيرا",30,"ر",2,0],["وَلَم أَحتَسِب سُفيانَ حَتّى لَقيتُهُ","عَلى مَأقِطٍ إِذ بَينَنا عِطرُ مَنشِمِ",31,"م",1,0],["ولم احرفي الوداع حزنا","وربما الكن الفصيح",32,"ح",1,0],["ولما حدا بي حادي قاصدا","إليكم بجندي فطرتي وهوائي",33,"ا",3,0],["ولمّا حببته سقاني","من كارس غرامه ورواني",34,"ي",1,0],["وَلَم أَحمَدكَ مِن خَيرٍ وَلَكِن","رَأَيتُ سِواكَ شَرّاً مِنكَ جِدّا",35,"د",2,0],["وَلَمّا حَذا يَومَ النَوى بِنِياقِهِم","أَنّى أَصَمَّ السَمعَ وَهوَ المُسمِعُ",36,"ع",1,0],["ولمّا حجَجْتَ البيتَ حَجَّك لائذاً","بكَ البيتُ والوفدُ الحَجيجُ حُضور",37,"ر",1,0],["ولما حرت في شأنيوأمري","طفقت مستغيثا بالنداء",38,"ا",2,0],["ولما حان من قومٍ طغاةٍ","حِمامٌ حثّهُ قدَرٌ وحِينُ",39,"ن",1,0],["ولما حدتنا حداة السرى","إليها فكان الصباح المضيفه",40,"ف",2,0],["ولما حبست على معالم رامة","نضوي أسائل صامت الجلمود",41,"د",1,0],["ولم أحسبِ البلوى عليها مُزاحِمٌ","ولا أنَّ ضنكَ العيش فيه حسودُ",42,"د",1,0],["ولم أحسب دُجَيلا من مياهي","ولا أنّ المَطيرةَ من بلادي",43,"د",2,0],["ولم أحسَب الأطلالَ تُخضعها النّوى","ولا أنّ جسم الربع يُنحِلهُ الحبُّ",44,"ب",1,0],["ولما حويت الفخر من صدق حُبِّهِ","تناسيتُ صَيْفيَّ الفخارِ وأكْثما",45,"م",2,0],["ولما حل الأطلال هبَّ نسيمها","بالركبِ عن سرّ العبير معبرا",46,"ر",2,0],["ولَّما حجبنا عنك سرَّاً وجهرة","وقابلنا البوَّابُ بالمنظر الجهمِ",47,"م",1,1],["ولما حنى منحاجبيه حنيَّة","تيقنت أن الهدب أمثالُ نبلهِ",48,"ل",2,0],["ولم أحُلْ عمّا عهدْتُمْ","مِن قديمِ وجدي",49,"د",2,0],["ولما حبانا الصبح برد نسيمه","تحيز عن حجري ودمعته تجري",50,"ر",2,0],["ولما حَللنا فِناء الرّسول","نَزَلنا بأَكرمِ خلقِ جوارا",51,"ر",2,0],["ولم أحسَبِ الرُمّانِ من ثمرِ القَنا","إِلى أن رأتْهُ العينُ وهو نُهودُ",52,"د",1,0],["ولما حللت بأرجائها","نقعت الصدى وجلوت الصدا",53,"د",2,0],["ولما حضرنا مجلس الأنس لم يكن","على وجهة إذ غبت أنس ولا بشر",54,"ر",1,0],["ولم أحترِف يوماً مَديحَ قصَائِدي","إذا جَاء ذُو مَدحٍ وفي يَدِه قَعبُ",55,"ب",1,0],["وَلمّا حزتُمُ أملِي أَمرتمْ","لساني أنْ يقول لكمْ فقالا",56,"ل",2,0],["وَلَمّا حَضرناكَ عندَ البِياعِ","عَرَفنا بِهَديك طُرقَ الهُدى",57,"ا",1,0],["وَلَم أَحمَدِ الأَيّامَ وَالعَيشَ بَينَنا","نُعَلُّ مِنَ اللَذاتِ طَوراً وَنُنهَلُ",58,"ل",1,0],["ولمَّا حلَّ في فِرْدَوْسِ ربٍّ","وقامَ لهُ بتَسْبِحَةٍ هُتافُ",59,"ف",1,0],["ولمَّا حلَّ في أكنافِ تُرْبٍ","على عَهدِ الصبِّا والموتُ ظالِمْ",60,"م",1,0],["ولم أحضَ في يوم الزفاف بمجمعٍ","له اِحتفلت أهل العلى والمكارمِ",61,"م",1,0],["وَلَمَّا حَدَا الْحَادِي عَدِمْتُ تَحَمُّلي","شَقَقْتُ جُيُوباً لِلْوَدَاعِ وَحُقَّ لي",62,"ي",1,0],["وَلَمَّا حَدَا الْحَادِي بِتِلْكَ الْمَحَامِلِ","ظَلَلْتُ عَلىَ الأَطْلاَلِ أَبْكِي وَعَاذِلي",63,"ي",1,0],["وَلَمَّا حَدَا الْحَادِي سُحَيْراً وَزَمْزَمَا","قَدِمْنَا إلَى خَيْرِ النَّبِييِّنَ بَعْدَمَا",64,"م",2,0],["ولما حجبتم عن عيوني شهدتكم","بعين فؤادي في ذوات مسامعي",65,"ع",2,0],["ولما حضرنا للسباق تبادرت","خيول ومن أهواه أقدمها سبقا",66,"ق",2,1],["ولما حرضنا للسماع وضربنا ال","ملاهي وكل بالجوى يترنمُ",67,"م",1,1],["وَلَم أَحلُل بِوادٍ فيهِ ظُلمٌ","وَأَنتَ حَلَلتَ فيهِ وَاِنهَمَلتا",68,"ت",2,0],["ولم أحلَ من تلك المعاني بطائلٍ","وإن كان أهلوها أطالوا وأسرفوا",69,"ف",3,0],["ولما حكيت الحرف ضعفا ورقة","بنى خاطري شيخ الزمان على الكسر",70,"ر",1,0],["ولما حدا الحادي وهاج أهاجها","رواقص للادلاج هجن تطربا",71,"ب",2,0],["ولم أحمل ودادكمُ ادِّعاءً","ولا أظهرتُ مدحكمُ انتحالا",72,"ل",2,0],["ولمَّا حاسَ جوَّابٌ كلاباً","تمنَّع فَلُّهم بالحارثينا",73,"ن",2,0],["وَلمّا حَضَرنا للشّرابِ بِمجلسٍ","وَخفّ مِن عالم الغَيب أَسرارُ",74,"ر",1,0],["وَلَمّا حَلَلنا رأسَهُ مِن رباطِهِ","وَفاضَ دماً كالمِسكِ أَو عنبرِ الهندِ",75,"د",1,0],["ولما حلقنا حل لبس مخيطنا","فيا حلقة منها المخيط لبسناه",76,"ن",3,0],["ولما حرثتم رياض العلوم","سقاها الكريم بهتَّانه",77,"ن",2,0],["ولم أحسب الرمان من ثمر القنا","إلى أن رأت عيناي رمانة النهد",78,"د",1,0],["ولما حزت من مرضٍ شفاءً","تباشرت الأنام بكل جانب",79,"ب",1,0],["ولما حوته الشام عني وأيْمنَتْ","بلادي وهذا الدهر اجورُحَاكم",80,"م",1,0],["ولما حذرت أسنة لو أن من","أعطاف غزلته اتخذت سناني",81,"ن",2,0],["ولما حباه رفعة القدر منة","على خلقه اثنى بما ليس في الشعر",82,"ر",1,0],["ولما حمدنا للمعالي اغترابه","يشيد في هام السحاب قبابه",83,"ا",3,0],["ولم أحتجْ لنور البدر لكن","نظرت إليه حبّاً في الهناء",84,"ا",2,0],["ولم أحزن لفقد أخ كريم","كفقدك يا أحط الناس روحا",85,"ح",2,0],["ولم أحزن على سقمى لأني","أمنتُ من الوشاة بأن نزاني",86,"ن",2,0],["ولمَّا حدا الحادون بالبين والنَّوى","وشبَّ لنار الاشتياق وقودُ",87,"د",1,1],["ولما حدا حادي الفراق بشملنا","وأنجدتُ سراً والأحبة أتهموا",88,"م",3,0],["ولم أحتج إلى مال فأخشى","عليه من الضياع ومن نفاد",89,"د",1,0],["ولما حدا الحادي بعيس أحبتي","ونادى غراب البين بالبين يهتف",90,"ف",1,1],["ولما حوى در المفاخر جيدنا","غنينا بنا عن كل من لا يريدنا",91,"ا",1,0],["ولم أحضره يوم قضى فيشكو","تحمحمه الذي صنع السقام",92,"م",1,0],["ولمَّا حَلَلْتُمْ بالأَيادِ أَمِنْتُمُ","فَصُبَّ عليكم فَارسُ الغَدَوَانِ",93,"ن",1,0],["ولمّا حلّ كَركَرَ مُستَهلاً","يُضيفُ إلى الفراتِ نَداهُ نِيلا",94,"ل",2,0],["ولما حوت ابياتها حسن وجهها","تعشقتها حتى لثمت لها فما",95,"م",2,0],["وَلما حانَ ترحالُ","وَخالوا ما الَّذي خالوا",96,"ل",3,1],["ولم أحمد من الضيفا","ن ضيفًا مثل فنَّانِ",97,"ن",1,0],["وَلَمّا حَضَرنا لاِقتِسامِ تُراثِهِ","أَصَبنا عظيماتِ اللُّهى وَالمَآثِرِ",98,"ر",1,0],["ولمّا حباني الزما","نُ من حيثُ لم أحسبِ",99,"ب",1,0],["ولما حنيتُ على ضِرامِ تشوُّقٍ","يأْبَى الخمودَ جوانحاً وضلوعا",100,"ع",2,0],["ولما حبسناها على أيمن الغضا","وكل حشاً منا بجمرته تكوى",101,"و",2,0],["وَلمّا حَدَّثَ الرُكبان عَنهُ","بِما أَولاهُ مِن فَضلٍ وَآتى",102,"ت",2,0],["وَلَمّا حَلَها وَالسَعدُ فيها","أَرختُ بِهِ غَدَت دار الحبورِ",103,"ر",1,0],["وَلما حويت من المَساعي محرزاً","وَكَما جبلت عَلى الهُدى مجبولا",104,"ل",2,0],["ولم أحتمل فضلا وأطلب منة","يكبدني من بين لأوائها شكر",105,"ر",1,0],["ولم أحظَ من ليلي بمطلٍ وليته","يكون وإن قيل المماطِل ظالمُ",106,"م",1,0],["ولما حوت منه أمينة ما حوت","حوت منه فخراً ما لذلك ثاني",107,"ن",2,0],["ولم أحذر لصرف الدهر مكرا","ومن يك حب أهل البيت ذخرا",108,"ر",2,0],["ولما حكى في شكله قوس حاجب","على عين زوراء العراق مقوَّس",109,"س",1,0],["ولما حللت الناصرية أقبلت","اليك وفود الشعر وفداً على وفد",110,"د",1,0],["ولما حدا البين المشت بشملنا","ولم يبق إلا أن تثار الأيانق",111,"ق",1,1],["ولم أحنث بعهدي ذات يوم","وإن عاهدت في روحي وفيتُ",112,"ت",1,0],["ولما حمى الشوق المبرح ناظري","كراه حذاراً أن يريني مثاله",113,"ل",2,1],["ولم أحسب النهد الذي في صدوركم","سوى صدر ولهان عليهِ تنهدا",114,"د",2,0],["ولما حدا حادياً عيرها","بنفسي المطية والحاديان",115,"ن",1,0],["ولم أحل قبله يقتادني أحد","فراض مني الهوى صعباً وذلله",116,"ل",2,0],["ولم أحرك شفتيَّ قائلا","والجسم كالعصفور في هزته",117,"ت",2,0],["ولما حواه الغار كادله العدا","ليصرفهم عنه الحمام المطوق",118,"ق",1,0],["ولما حارَ خُذلانًا تسامى","وعانقَ ذاتَهُ.. فغدا نبيَّا",119,"ي",2,0],["ولم أحفلْ بعقلي حين ألوَى","بساح الخدِّ مجنونًا سفيها",120,"ي",3,0],["ولم أحنَثْ بعهدِكِ طولَ عُمري","ولم أحرصْ على دميَ المُباحِ",121,"ح",1,0],["ولما حسوت الشهد من ثغر الندى","ولما قطفت شقائقا وعقيقا",122,"ق",2,0],["ولم أحفل بهم يوما وإني","جعلتُ هواكِ خاتمة الأماني",123,"ن",2,0],["ولما حللت بأرجائها","نقعت الصدى وجلوت الصدى",124,"د",2,0],["وَلَمْ أحْتَقِبْ حُزْناً، ولَمْ أدْرِ لَذَّةً","فما الفَرْقُ بَيْن الحَيِّ والمَيْتِ ثَاوِيا؟!",125,"ي",2,0]]}