{"poems":[[65,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[87,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[68,"من كنت أنت رسوله","https://www.aldiwan.net/poem39228.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[119,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[236,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[302,"هو طود علم لا يبارى رفعة","https://www.aldiwan.net/poem33005.html","الكامل"],[466,"محمد الأفعال موفور النهى","https://www.aldiwan.net/poem16363.html","الرمل"],[520,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144089","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95549","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80055","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48966","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109454","الرمل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216395",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93781","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204636","الرمل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147346","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126274","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61268","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205887",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66603","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105528","الخفيف"],[4755,"خالد الرويشان","https://www.poetsgate.com/ViewPoem.aspx?id=198397",""],[4896,"وحشة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=180896",""],[5431,"الحدْس.....","https://www.poetsgate.com/ViewPoem.aspx?id=198676",""],[5431,"مهجة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205811",""],[5431,"أمنية ....(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=206102",""],[5431,"هدية بعيد الزواج ...","https://www.poetsgate.com/ViewPoem.aspx?id=207439",""],[5525,"طير السعد","https://www.poetsgate.com/ViewPoem.aspx?id=999",""],[5763,"فلسفةُ الحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=27060",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[5956,"أرجوك ربي صِلْ فؤاده بي","https://www.poetsgate.com/ViewPoem.aspx?id=204462",""],[5966,"الطائف","https://www.poetsgate.com/ViewPoem.aspx?id=158861",""],[6093,"محمد سيد السادات","https://www.poetsgate.com/ViewPoem.aspx?id=193786",""],[6093,"الكُلُّ يخطيءُ تارةً ويُصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205649",""],[6148,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=201828",""]],"verses":[["هوَ طَيْفُها وطُروقُهُ تَعْليلُ","فمَتى يفي لَكَ والوَفاءُ قَليلُ",0,"ل",1,1],["هُوَ طَيرُ اللَهِ في رَبوَتِهِ","يَبعَثُ الماءَ إِلَيهِ وَالغِذاء",1,"ا",2,0],["هُوَ طَلعَةُ الشَمسِ الَّذي","جاءَ الصَباحُ دَليلَه",2,"ل",2,0],["هو طَلْعةُ الرَّوْض النَّضِيرِ وظِلُّه","ونَمِيرُه ونسيمه المُتَعطِّر",3,"ر",1,0],["هو طبُّ الجسوم من كل داءٍ","وهْو طهرٌ لها من الأُدران",4,"ن",1,0],["هُوَ طيِّبُ الأخلاقِ مثلُكَ يا أبي","لم يَبْدُ في ظَمَأٍ إلى العُدوانِ",5,"ن",1,0],["هو طفلكم والسبع عيب أن يرى","أيدي الكلاب تصول في أشباله",6,"ل",2,0],["هو طاهر الأنساب لما يجتمع","أبوان في وقت عليه سفاحا",7,"ح",2,0],["هُوَ طودُ عِلمٍ لا يُبارى رفعَةً","وَمحيطُ فَضلٍ لا يَزال مَديدا",8,"د",2,1],["هو طَوْدٌ راسِخٌ في حِلْمِهِ","وتأنِّيهِ وسَيْفٌ إِنْ عَزَمْ",9,"م",1,0],["هو طودها الراسي وصالحها الذي","حد الفساد بحده مفلول",10,"ل",1,0],["هو طبعُه ولضَلّ رأيُ معاتِبٍ","يرجو انتقالَ طبيعةِ المطبوعِ",11,"ع",1,0],["هو طلعٌ وكلهم ذائقوه","هو حوضٌ وكلهم واردونا",12,"ن",2,0],["هو طِرسٌ أم خدُّ عذراء تُجلى","خطَّ فيها الإبداعُ ما كانَ أملى",13,"ل",2,1],["هو طلقُ العنان في الجود طلق ال","وجه طلق اليدين طلق اللسان",14,"ن",1,0],["هو طفلٌٌ فوق السرير صغيرٌ","ذابلُ الطرفِ يَسحرُ الآناما",15,"م",2,0],["هو طه ابن النصولي الذي","احرز الحسنى وطيب المخبر",16,"ر",1,0],["هو طِبّ عوقي يا غشيم","انْ كان باتِنْعَتْ دْواه",17,"ا",2,0],["هو طه إنسان عين البرايا","من قفا أثر هديه كل قاف",18,"ف",1,0],["هو طفل لم يفارق مهده","ولقد ذاق صنوف المحن",19,"ن",1,0],["هُوَ طَاعِنٌ فِي الذَّنْبِ مِلْءَ إِيَابِهِ","تَيَّارُ يَأْسٍ آكِلُ الأَكْتَافِ",20,"ف",1,0],["هو طلسم الأسرار وهو العابد ال","رحمن في غسق الدجى يتملق",21,"ق",1,0],["هُوَ طودٌ في مَوطن يَبعَثُ الخَو","فِ بِقَلبِ المُستَضعَفِ الرَعديدِ",22,"د",1,0],["هو طاغ يأنف الصغو إلى","سائل يسأله عما جنى",23,"ن",2,0],["هو طيف من حديد","هو طيف من ضرام",24,"م",1,0],["هُوَ طَوْراً مِنَ الطَّعامِ بِلا شَكٍّ","وَطَوْراً مِن أَطْيَبِ المَشْرُوبِ",25,"ب",1,0],["هو طب النفوس منه شفاهاً","يوم أشفت على شفير هار",26,"ر",1,0],["هو طِيبُ هذي الأَرضِ.. كيف لِمِثلِهِ","أَنْ لا يَضُوعَ لِكي يَصدَّ خبيثَها!",27,"ث",3,0],["هو طفل شاد الرمال قصورا","هى آماله ودك الرمالا",28,"ل",2,0],["هو طائر الإحساس نفسك سجنه","ويفتّح الأبواب حين يحلّق",29,"ق",1,0],["هو طفل القصيدة ال ...مات غرقاً","هو حشد الذباب في الشهد يبقى",30,"ق",2,0],["هو طفل الغمام بكل عينٍ","له بيتٌ يصبُ الحرف خمرا",31,"ر",2,0],["هو طيبٌ كالنيل في إغداقه","أصلٌ كريم كالندى الدفاق",32,"ق",1,0],["هو طيرنا اللي معجبتنا مهاويه","به نفتخر يا أهل الفعول الجميله",33,"ل",2,0],["هوَ طائرٌ لا يستريحُ بموطنٍ","هوَ طائرٌ فوق المُحالِ تعالى",34,"ل",2,0],["هُوَ طائِرٌ لكِنَّهُ","قَدْ ضَلَّ عن وطن الطُيُورْ",35,"ر",1,0],["هو طيفك البسّام يُبْكي مهجتي","أَعْجِبْ بمن يبكي من البسّامِ",36,"م",1,0],["هو \"طالعٌ\" لي في كثيرِ صفاته","في الحبِ والنّعمى.. وحُسْنِ تُقايا",37,"ا",3,0],["هو طاهرٌ لم يأتِ مثلُه غيرَ في","عهد الرسول وصحْبه العظماءِ",38,"ا",2,0],["هو طيبٌ ويظلُّ وُدّهُ مرتجى","منّي لأنّ لديه صبراً كالجملْ",39,"ل",1,0],["هوَ طائفُ المجدِ الذي يعنَى لهُ","بلدٌ لهُ في مهجَتي مِقْدارُ",40,"ر",1,0],["هُوَ طَاهِرُ الغُدْوَاتِ والرَّوَحَا","تِ والجَلَسَاتِ والحَرَكَاتِ والسَّكَنَاتِ",41,"ت",1,0],["هُوَ طَاهِرُ الأجْدَادِ والآبَا","ءِ والأوْلادِ والأحْفَادِ والزَّوْجَاتِ",41,"ت",1,0],["هُوَ طَيِّبُ الأخلاقِ طَيِّبُ مَعْشَرٍ","مِنْ مَعْشَرٍ فِيْهِ الثَّناءُ يَطِيْبُ",42,"ب",1,0],["هو طائرٌ أرقى المشاعر عشه","وعلى غصون سنا الضمائر يزهرُ",43,"ر",1,0]]}