{"poems":[[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[85,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[66,"من كنت أنت رسوله","https://www.aldiwan.net/poem39228.html","مجزوء الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[113,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[229,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[295,"هو طود علم لا يبارى رفعة","https://www.aldiwan.net/poem33005.html","الكامل"],[459,"محمد الأفعال موفور النهى","https://www.aldiwan.net/poem16363.html","الرمل"],[513,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"]],"verses":[["هوَ طَيْفُها وطُروقُهُ تَعْليلُ","فمَتى يفي لَكَ والوَفاءُ قَليلُ",0,"ل",1,1],["هُوَ طَيرُ اللَهِ في رَبوَتِهِ","يَبعَثُ الماءَ إِلَيهِ وَالغِذاء",1,"ا",2,0],["هُوَ طَلعَةُ الشَمسِ الَّذي","جاءَ الصَباحُ دَليلَه",2,"ل",2,0],["هو طَلْعةُ الرَّوْض النَّضِيرِ وظِلُّه","ونَمِيرُه ونسيمه المُتَعطِّر",3,"ر",1,0],["هو طبُّ الجسوم من كل داءٍ","وهْو طهرٌ لها من الأُدران",4,"ن",1,0],["هُوَ طيِّبُ الأخلاقِ مثلُكَ يا أبي","لم يَبْدُ في ظَمَأٍ إلى العُدوانِ",5,"ن",1,0],["هو طفلكم والسبع عيب أن يرى","أيدي الكلاب تصول في أشباله",6,"ل",2,0],["هو طاهر الأنساب لما يجتمع","أبوان في وقت عليه سفاحا",7,"ح",2,0],["هُوَ طودُ عِلمٍ لا يُبارى رفعَةً","وَمحيطُ فَضلٍ لا يَزال مَديدا",8,"د",2,1],["هو طَوْدٌ راسِخٌ في حِلْمِهِ","وتأنِّيهِ وسَيْفٌ إِنْ عَزَمْ",9,"م",1,0],["هو طودها الراسي وصالحها الذي","حد الفساد بحده مفلول",10,"ل",1,0]]}