اءهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=27702",""],[78,"تُؤَمِّلُ لِلنَّفسِ الشَجِيَّةِ فَرجَةً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87627&r=&rc=173",""],[105,"رويدك أيها الجبار فينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54873&r=&rc=43",""],[31,"أَفي رَسْمِ دَارٍ دَمْعُكَ المُتَرَقْرِقُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18981&r=&rc=244",""],[31,"أَهَاجَكَ رَبْعٌ عَفَا مُخْلِقُ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18974&r=&rc=237",""],[96,"جزيرة العشاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66433&r=&rc=109",""]],"verses":[["لَيالِيَ تَثنيني عَواطِفُ صَبوَتي","إِلى بَدَوِيّاتٍ تَثَنّى لِدانُها",0,"ن",3,0],["لَيالِيَ بَينَ بُرودِ الشَبا","بِ مَنِّيَ غُصنٌ رَطيبُ المَجاني",1,"ي",1,0],["لَيالِيَ أَسري في أُصَيحابِ لَذَّةٍ","وَمُخُّ الدُجى رارٌ وَقَد دَقَّ عَظمُهُ",2,"م",2,0],["لَياليهِ صُبحٌ مِنَ المُغبِطاتِ","وَأَيّامُهُ مِن سُكونٍ لَيالي",3,"ل",2,0],["لِيَ العَزمُ الَّذي قَد جَرَّبوهُ","يَقُدُّ مَضارِبَ البيضِ الخِفافِ",4,"ف",1,0],["لَيالي يوقِظُ التَذكارُ شَوقي","وَهَجعَةُ سَلوَتي فيها غِرارُ",5,"ر",1,0],["لِيَ الحَربُ مَعطوفاً عَليَّ هِياجُها","وَظِلُّ جَوادي قَيظُها وَعَجاجُها",6,"ج",3,1],["لي أَنَّهُ الشاكي إِذا بَعُدَ المَدى","ما بَينَنا وَتَنَفُّسُ المَكروبِ",7,"ب",1,0],["لَيالِيهِ أسحارٌ وفيهِ هَواجِرٌ","كما خَضِلَتْ والشّمسُ تَنعَسُ آصالُ",8,"ل",1,0],["لياليه أعلتْ سوأتيها بيارقاً","أزاغت؟ أكان الرَّصدُ من قبل أزيغا؟",9,"غ",2,0],["لِيَ النُفوسُ وَلِلطَيرِ اللُحومُ وَلِل","وَحشِ العِظامُ وَلِلخَيّالَةِ السَلَبُ",10,"ب",1,0],["ليَ الفخْرُ إنْ أبصرْتَني أو سمِعْتَ بي","على كلِّ مصْقولِ الغِرارَيْنِ مُرْهَفِ",11,"ف",1,1],["ليَ اللهُ كَمْ شَوْقٍ لِبُعْدِكَ غَالَنِي","وَوَجْدٍ لِذِكْرِ عَهْدِكَ الْمُتَقَدِّمِ",12,"م",1,0],["لِيَ اللَّهُ مِنْ نَفْسٍ شَعَاعٍ وَمُهْجَةٍ","إِذَا قُدِحَتْ لَمْ يَخْبُ مِنْ زَنْدِهَا سَقْطُ",13,"ط",1,0],["لي اللهُ من عُنْوانِ مُلْكٍ مجَدَّدِ","تَروحُ هِباتُ اللهِ نحْوي وتَغْتَدي",14,"د",2,1],["لي اللهُ كمْ أهْذي بنجْدٍ وحاجِرِ","وأكْني بدَعْدٍ في غَرامي أو سُعْدى",15,"د",2,0],["ليَ اللهُ منْ قلْبٍ خَفوق معذّبٍ","يَرى أنْ ما بالمَوْتِ في الحُبِّ منْ باسِ",16,"س",1,0],["لَيَأتِيَنهُ مَنطِقٌ سائِرٌ","مُستَوثِقٌ لِلمُسمِعِ الآثِرِ",17,"ر",1,0],["لَيالِيَ نَحتَلُّ المَراضَ وَعَيشُنا","غَريرٌ وَلا نُرعي إِلى عَذلِ عاذِلِ",18,"ل",1,0],["لَياليكَ أُنسٌ جَلاها الصَفا","فَأَسَرَت إِلَيكَ وُفودُ المَلا",19,"ا",1,0],["لِيَ الشَرَفُ الأَعلى الَّذي عَزَّ جانِبُه","فَلا أَحَدٌ إِلّا وَمَجدِيَ غالِبُه",20,"ب",2,1],["لي أَعبدٌ قَد ضاقَ ذَرعي بِهِم","وَأَضجَرَتهُم عِلَّتي مِنّي",21,"ن",2,0],["لَيالي نامَت عَيونُ الوُشا","ةِ عَنّا وَعَينُ الرِضى لَم تَنَم",22,"م",1,0],["لَيالِيَ ما اِنفَكَّ يُهدي السُرورَ","حَبيبٌ سَرى وَرَقيبٌ غَفَل",23,"ل",1,0],["لَيالِيَ سَلمى إِذ تُريكَ مُنَصَّب","وَجيداً كَجيدِ الرِئمِ لَيسَ بِمِعطالِ",24,"ل",1,0],["لَيالِيَ يَدعوني الهَوى فَأُجيبَهُ","وَأَعيُنُ مَن أَهوى إِلَيَّ رَواني",25,"ن",2,0],["لَيالٍ بِذاتِ الطَلحِ عِندَ مُحَجَّرِ","أَحَبُّ إِلَينا مِن لَيالٍ عَلى أُقَر",26,"ر",1,0],["لَيَالِيَ أَسبِى الغَانِيَاتِ بِحُمَّةٍ","مُعَثكَلَةٍ سَودَاءَ زَيَّنَهَا رجَل",27,"ل",1,0],["لَيالِيَ مِن عَيشٍ لَهَونا بِوَجهِهِ","زَماناً وَسُعدى لي صَديقٌ مُواصِلُ",28,"ل",1,0],["لَياليَ سُعدى في الَشبابِ الذي مَضى","وَنِسوَتُها بِيضُ السَوالِفِ غيدُ",29,"د",1,0],["لَيالي مِنها الوادِيانِ مَظِنَّةٌ","فَبُرَقُ العُنابِ دارُها فَالأَباطِحُ",30,"ح",1,0],["لَيالِيَ لا أَسماءُ قالٍ مُوَدِّع","وَلا مُرهِنٌ يومًا لَكَ البَذلَ جارِحُ",30,"ح",1,0],["لِيَ اللَهُ ثُمَّ النَبِيُّ الكَريمُ","وَأَكرَمُ صِهرٍ لَهُ وَاِبنِ عَم",31,"م",1,0],["لَياليَ لا مَيٌّ خَروجٌ بِذيَّةٌ","وَلَكِن رَداحٌ لَم يَشِنها قَوامُها",32,"م",3,0],["لَيالِيَ مَيٌّ مَوتَةٌ ثُمَّ نَشرَةٌ","لِما أَلمَحَت مِن نَظرَةٍ وَكَلامِ",33,"م",1,0],["لَياحِ السَبيبِ أَنجَلِ العَينِ آلِفِ","لِما بَينَ غُصنٍ مُعبِلٍ وَهُيامِ",33,"م",1,0],["لَيالِيَ مَيٌّ لَم يُحارِبكَ أَهلُها","وَلَم يَزحَلِ الحَيُّ النَوى كُلَّ مَزحَلِ",34,"ل",1,0],["لَيالي لا مَيٌّ بَعيدٌ مَزارُها","وَلا قَلبُهُ شَتّى الهَوى مُتَشَيَّعُ",35,"ع",1,0],["لَيالِيَّ أُبدي في الدِيارِ وَلَم أَلِح","مَراخِيَ لَم أَزجُر عَنِ الجَهلِ زاجِرُه",36,"ر",2,0],["لَيالي تَحتَلُّ الأَباطِحَ جُرهُمٌ","وَإِذ بِأَبِينا كَعبَةُ اللَهِ تَعمُرُ",37,"ر",1,0],["لَيالِيَ اللَهوُ يَطبيني فَأَتبَعُهُ","كَأَنَّني ضارِبٌ في غَمرَة لَعِبُ",38,"ب",1,0],["ليَ الله إِمّا أَومضَ البرق في الدجى","أقلب تحت الليل مقلة وسنانِ",39,"ن",1,0],["لَيالِيَ تَرتَميكَ بِنَبلِ جِنٍّ","صَموتُ الحِجلِ قانِيَةُ الخِضابِ",40,"ب",1,0],["لَيالِيَ حَبلُ وَصلِكُمُ جَديدٌ","وَما تُبقي اللَيالي مِن جَديدِ",41,"د",1,0],["لَيالِيَ هِندٌ حاجَةٌ لاتُريحُنا","بِبُخلٍ وَلا جودٍ فَيَنفَعَ جودُها",42,"د",3,0],["لِئامُ العالَمينَ كِرامُ تَيمٍ","وَسَيِّدُهُم وَإِن رَغَموا مَسودُ",43,"د",1,0],["لَيالِيَ تَسبي القَلبَ مِن غَيرِ ريبَةٍ","إِذا سَفَرَت عَن واضِحِ اللَونِ أَزهَرا",44,"ر",2,0],["لَيالِيَ لا سَرّي إِلَيهِنَّ شائِعُ","وَلا أَنتَ لِلمُستَودَعاتِ مُشيعُ",45,"ع",1,0],["لَيالِيَ لا سِرّي لَدَيهِنَّ شائِعٌ","وَلا أَنا لِلمُستَودَعاتِ مُضيعُ",46,"ع",1,0],["لَيالِيَ لا تُوَدِّعُنا بِصُرمٍ","فَتُؤيِسَنا وَلا بِجَداً تَنولُ",47,"ل",1,0],["لَيالِيَ إِذ أَهلي وَأَهلُكِ جيرَةٌ","وَإِذ لا نَخافُ الصَرمَ إِلّا عَلى وَصلِ",48,"ل",1,0],["لِيَ الفَضلُ في أَفناءِ عَمروٍ وَمالِكٍ","وَما زِلتُ مُذ جارَيتُ أَجري عَلى مَهلِ",48,"ل",1,0],["لَيالِيَ تَنتابُ النِباجَ وَتَبتَغي","مَراعِيَها بَينَ الجَداوِلِ وَالنَخلِ",48,"ل",1,0],["لِيَ النَصرُ مِنهُم وَالوَلاءُ عَلَيكُمُ","وَما كُنتُ فَقعاً أَنبَتَتهُ القَراقِرُ",49,"ر",1,0],["لَيالِيَ تَحتَ الخِدرِ ثِنيُ مُصيفَةٍ","مِنَ الأُدمِ تَرتادُ الشُروجَ القَوابِلا",50,"ل",2,0],["لَيالِيَ يَدعوني الهَوى فَأُجيبُهُ","حَثيثاً وَلا أُرعي إِلى قَولِ زاجِرِ",51,"ر",1,0],["لَيالِيَ نُمسي بَينَ جَوٍّ وَمِسطَحٍ","نَشاوى لَنا مِن كُلِّ سائِمَةٍ جَزَر",52,"ر",1,0],["ليالينا إذ لا تزالُ تروعنا","مُعَرَّضة منهم بكر وثيّبُ",53,"ب",1,1],["لِيَاحٌ كأن بالأتحَمِيَّةِ مُشبَعٌ","إزاراً وفي قُبطِيَّةٍ مُتَجَلبِبُ",54,"ب",1,0],["لِيَ التَخَيُّرُ مُشتَطّاً وَمُنتَصِفاً","وَلِلأَفاضِلِ بَعدي ما أُغادِرُهُ",55,"ر",2,0],["لِئامٌ مَساعيها كَذوبٌ حَديثُها","قَليلٌ غَناها حينَ يُنعى صُقورُها",56,"ر",3,0],["لِئامٌ مَساعيها قِصارٌ جُدودُها","عَلى الخَيرِ لِلجارِ الغَريبِ مَحاشِدُ",57,"د",1,0],["لَيالِيَ يُدعى دَيسَماً بِاِبنِ صَقعَبٍ","لِما ضَمَّ زَوجُ الكَلبَتَينِ ضَروبُ",58,"ب",1,0],["ليالي وفا ليلى صديقٌ ملازم","كما للتقى والبر في الشام صاحب",59,"ب",1,0],["لياليَ الصوم ما قطعتُ لها","فطراً وأيَّام العام بالنسبه",60,"ب",2,0],["لي ألفُ بيتٍ في مدائح بيتكم","فاردُد على المملوك بيتاً واحدا",61,"د",2,0],["ليالي تجني الحسن في أوجه الدّمى","وتجني على أجسامِها حين تنظر",62,"ر",1,0],["ليالي فطر الصوم إذ كلّ ليلةٍ","بإحسان نور الدِّين عيدٌ هو الفطر",63,"ر",1,0],["ليالٍ تولت ما أرقّ معاطفاً","وعيشاً تقضى ما ألذّ وأغبطا",64,"ط",2,0],["ليَ الله قلباً صير الوجد شرعةً","وجفناً قريحاً صير الدمعَ مشرعا",65,"ع",2,0],["ليَ الله نفساً لا يخفُّ نزاعها","إليكَ وروحاً لا يكفُّ نزوعها",66,"ع",3,0],["لي أشهر أربعة أخرت","فحظي المشؤوم بالأربعه",67,"ه",1,0],["ليَ الله قلباً في اتّباع صبابة","كعاذله من قالَ للفلكِ أرفق",68,"ق",1,0],["لياليَ أنشي في أبيك مدائحاً","وفيك فأروي مسند الفضل عنكما",69,"م",2,0],["ليَ الله قلباً لا يزال تهيجه","إلى الحبِّ أوطارٌ قدُمنَ وأوطان",70,"ن",1,0],["لياليَ وَدَّعت المؤيد والثنا","وفارقت أوقات الغِنى منه والمغنا",71,"ن",2,0],["ليالي لم أقلْ سَقْياً لعهدٍ","ولم أَرغَبْ إلى سُقيا سَحابِ",72,"ب",1,0],["لِي إلى ذاكَ ارْتياحٌ","وعليْهِ مُسْتَرَاحُ",73,"ح",1,0],["لي أربعون من السِّني","ن وأربعون من الولدْ",74,"د",1,1],["ليالي لا تنجو بنَبْلي خريدةٌ","وإن عزَّ حاميها وجمَّ عَديدُها",75,"د",3,0],["لياليَ لا يزال لها خليلٌ","ويُعملُها كإعمال القَعُودِ",76,"د",1,0],["لي ابن عمٍّ يجرُّ الشرَّ مجتهداً","عليَّ قدماً ولا يصلى له نارا",77,"ر",2,1],["لياليَ أفنانُ الزمان رطيبةٌ","تميد على أفيائها وتَهصَّرُ",78,"ر",1,0],["ليأْمن سِقاطي في الخطوب ونبوتي","جنان الذي يخشى عليّ ويحذر",78,"ر",1,0],["لَيأخذنَّ بسَمْعي دونَ لغوِكما","حسنُ المَزاهِر والأهزاج والهَزَز",79,"ز",1,0],["ليأمنْ صروفَ الدهرِ من أنت جارُهُ","فقد أفلَتْ عنه النجومُ النواحس",80,"س",1,0],["لئامٌ كالخنازيرِ","خساسٌ كاليرابيعِ",81,"ع",1,1],["لياليَ تنسيني الليالي حسابها","بُلَهنِيَةٌ أقضي بها الحول أجمعا",82,"ع",2,0],["ليالي لو نازعته رجع أم