,"https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63500",""],[5582,"ستبدي خفيّات الأمورِ العواقبُ","https://www.poetsgate.com/ViewPoem.aspx?id=63465",""],[2598,"أبا مُعْرِضٍ كُنْ أنْتَ إنْ مُتُّ دافني","https://www.poetsgate.com/ViewPoem.aspx?id=17295",""],[5720,"أبا موسىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=200637",""],[4442,"نظرت فخانني حدسي وفكري","https://www.poetsgate.com/ViewPoem.aspx?id=171205",""],[6084,"أبا موسى اليك شددت رحلي","https://www.poetsgate.com/ViewPoem.aspx?id=170864",""],[6235,"نسرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77693&r=&rc=8",""]],"verses":[["أَبا مَطَرٍ وَجَذمُكَ مِن مَعَدٍّ","كَذاتِ العُرِّ في السَرحِ السَليمِ",0,"م",1,1],["أَبَا مَالِكٍ أَنْتَ نَجْلُ الْمُلُوكِ","غُيُوثِ النَّدَى وَلُيُوثِ النِّزَالِ",1,"ل",1,1],["أَبا مِسمَعٍ إِنّي اِمرُؤٌ مِن قَبيلَةٍ","بَنى لِيَ مَجداً مَوتُها وَحَياتُها",2,"ت",3,0],["أَبا مِسمَعٍ أَقصِر فَإِنَّ قَصيدَةً","مَتى تَأتِكُم تَلحَق بِها أَخَواتُها",2,"ت",3,0],["أَبا مِسمَعٍ سارَ الَّذي قَد صَنَعتُمُ","فَأَنجَدَ أَقوامٌ بِذاكَ وَأَعرَقوا",3,"ق",3,0],["أَبا مَروانَ أَنتَ فيتى قُرَيشٍ","وَكَهلُهُمُ إِذا عُدَّ الكُهولُ",4,"ل",1,0],["أَبا مَخلَدٍ كُنّا حَليفَي مَوَدَّةٍ","هَوانا وَقَلبانا جَميعاً مَعاً مَعا",5,"ع",2,1],["أَبا مالِكٍ لِلحَيِّ فَضلٌ عَلَيكُمُ","فَكُل مِن خَنانيصِ الكُناسَةِ وَاِشرَبِ",6,"ب",1,0],["أَبا مالِكٍ مالَت بِرَأسِكَ نَشوَةٌ","وَبِالبِشرِ قَتلى لَم تُطَهَّر ثِيابُها",7,"ب",3,0],["أَبا مالِكٍ لَيسَت لِتَغلِبَ نَجوَةٌ","إِذا مابُحورُ المَجدِ عَبَّ عُبابُها",7,"ب",3,0],["أَبا مالِكٍ مالَت بِرَأسِكَ نَشوَةٌ","وَعَرَّدتَ إِذ كَبشُ الكَتيبَةِ أَملَحُ",8,"ح",1,0],["أَبا مالِكٍ ذا الفَلسِ إِنَّ عَداوَتي","تُقَطِّعُ أَنفاسَ الرِجالِ صَعودُها",9,"د",3,0],["أَبا مالِكٍ لا بُدَّ أَنّي قارِعٌ","لِعَظمِكَ إِنّي لِلعِظامِ قَروعُ",10,"ع",1,0],["أَبا مالِكٍ إِن كُنتَ بِالسَيرِ مُعجَباً","فَدونَكَ فَاِنظُر في عُيونِ نِسائِكا",11,"ك",2,0],["أَبا مالِكٍ إِنّي لِحُكمِكَ فارِكٌ","وَزَبّانُ قَد أَمسى لِحُكمِكَ فارِكا",11,"ك",2,0],["أبا منذرٍ بالله إلا صدقتني","علامَ ولمْ خَنَّثتني يا أخا النضرِ",12,"ر",1,1],["أَبا مالِكٍ لا تَنطُقِ الشِعرَ بَعدَها","وَأَعطِ القِيادَ القائِدينَ عَلى كَسرِ",13,"ر",1,0],["أَبا مَروانَ أَنتَ فَتى قُرَيشٍ","وَكَهلُهُم إِذا عُدَّ الكُهولُ",14,"ل",1,0],["أَبا مُسلِمٍ إِلقَ السَلامَ مُضاعَفاً","وَرُح سالِمَ القُطرَينِ إِنِّيَ غادِ",15,"د",1,0],["أَبا موسى وَما بِكَ مِن نُبُوٍّ","عَنِ الحَقِّ المُلِمِّ وَلا جُمودِ",16,"د",1,0],["أَبا مُسلِمٍ لا زِلتَ بَينَ مُوَدَّعٍ","مِنَ المُزنِ مَسكوبِ الحَيا وَمُسَلِّم",17,"م",1,0],["أَبا مُسلِمٍ إِن كانَ عِرضُكَ سالِماً","فَمالُكَ مِن جَدواكَ لَيسَ بِسالِمِ",18,"م",1,0],["أَبا مَعقِلٍ لَولا حَواجِزُ بَينَنا","وَقُربى ذَكَرناها لِآلِ المُجَبِّرِ",19,"ر",1,0],["أبا مُوسَى لَك البُشْرَى وأهلاً","بركبكَ في حِمَى خَيرِ الأنامِ",20,"م",1,0],["أبا موسى نَهضتَ إلى محلٍّ","يَشُقُّ على ذَوِي الهِمَمِ العِظامِ",20,"م",1,0],["أَبا مُحَمَّدٍ اِعذِرني فَحُبُّكَ قَد","جَرى بِنَفسيَ جَريَ الماءِ في العودِ",21,"د",1,1],["أَبا مَطَرٍ هَلُمَّ إِلى صَلاحٍ","فَتَكفيكَ النَدامى مِن قُريشِ",22,"ش",1,1],["أَبا مُنذِرٍ ما بالُ أَنسابِ مَذحَجٍ","مُرَجَّمَةٌ دوني وَأَنتَ صَديقي",23,"ي",1,1],["أَبا مُسلِمٍ ما طُولُ عَيشٍ بِدائِمِ","وَلا سالِمٌ عَمّا قَليلٍ بِسالِمِ",24,"م",1,1],["أَبا مُسلِمٍ ما غَيَّرَ اللَهُ نِعمَةً","عَلى عَبدِهِ حَتّى يُغيِّرَها العَبدُ",25,"د",1,1],["أَبا مالِكٍ طالَ النَهارُ وَطولُهُ","إِذا ما الهَوى بِالنَفسِ داءٌ يُصيبُها",26,"ه",2,1],["أَبا مُنذِرٍ كانَت غَروراً صَحيفَتي","وَلَم أُعطِكُم بِالطَوعِ مالي وَلا عِرضي",27,"ض",2,1],["أَبا مُنذِرٍ أَفنَيتَ فَاِستَبقِ بَعضَنا","حَنانَيكَ بَعضُ الشَرِّ أَهوَنَ مِن بَعضِ",27,"ض",1,0],["أَبَا مُنذرٍ جازيتَ بِالوِدِّ سُخطةً","فَمَاذا جَزاءُ المُبغِضِ المتَبَغِّضِ",28,"ض",1,1],["أبا مصرَ هل تُصغي وللشعرِ دَمعَةٌ","بها الحبُّ صَفْو والوفاءُ مُذاب",29,"ب",1,0],["أبا موسى وما بك من بنو","عن الحق الملم ولا جمود",30,"د",1,0],["أبا مُسلِمٍ! لا زِلْتَ بيِْنَ مُودَعٍ لنا","مِنَ المُزْنِ مَسكوبِ الحَيا وَمُسَلِّمِ",31,"م",1,0],["أبَا مَعشر الإسلام إنّ إمامكم","إِمام تقى لا تَعْتريه الرواجفُ",32,"ف",1,0],["أَبا ماجِدٍ لَم يَبقَ إِلّاكَ ماجِدٌ","يُرجّى لِأَبكارِ الخُطُوبِ النَواهِكِ",33,"ك",1,0],["أبا مسلم إن الإمارة خيّرت","قرينا كريما يتقي ويراقب",34,"ب",1,0],["أبا منجك السامي المسمى بجده","تعداك من حد الكرام غيورها",35,"ر",3,0],["أبا مُجرِمٍ ما غَيَّرَ اللهُ نِعمَةً","عَلَى عَبدِهِ حَتَّى يُغَيِّرَها العَبدُ",36,"د",1,1],["أبا مُجرِمٍ خَوَّفتَني القَتلَ فَانتَحَى","عَلَيكَ بما خَوَّفتَنِي الأسَدُ الوَردُ",36,"د",1,0],["أبا محمد المحمود يا حسن ال","إحسان والجود يا بحر الندى الطامي",37,"ي",1,1],["أَبا مُصطَفى اِستَمتِع فَحَظُّكَ وافِرٌ","وَطالِعُكَ المِسوَدُّ بِالعِزِّ أَومى لَك",38,"ك",1,1],["أباً ماجِداً يأْوي الورَى منه عِزّةً","إلى صاحبٍ حامي الحقيقةِ عادل",39,"ل",1,0],["أبا مُحمَّدٍ الصبرَ الجَميلَ فما","يرتاعُ من غُصُنٍ يَذوي له الشَّجَرُ",40,"ر",1,0],["أبا مصطفى زوَّجْتَ بالخيرِ والهَنا","أخاكَ وقد بُلِّغْتَ في عُرسِه المنى",41,"ن",2,1],["أبا مصطفى إنَّا ذكرناكَ بَيْنَنا","فهاجَ بنا شَوْقٌ إليكَ مع الذّكْرِ",42,"ر",1,1],["أبا مصطفى أَنْتَ صوبُ الغمام","ويا ربَّما فُقْتَ هطالها",43,"ل",3,0],["أبا مصطفى إنِّي وإنْ كنت أخرساً","فما زالَ كلِّي في ثنائك أَلسُنا",44,"ن",2,0],["أبا مصطفى أمَّا رضاكَ فمُنْيَتي","ومن عَجَبٍ فيك المنيَّة والمنى",44,"ن",2,0],["أبا مصطفى لم أر مدحَك لامرئ","من النَّاس ألا قال هذا مُسَلَّم",45,"م",1,0],["أبَا مُوسَى شَهِدتَ وَكُنتَ عَدلاً","مُزَكَّى حَيثُ تَشتَجِرُ الخُصُومُ",46,"م",1,1],["أبا مالك من للمعالي يشيدها","خلافك مذ أثبتها بالدعائم",47,"م",1,0],["أبا مالك أبكيك ما عشت باقياً","بكاء المعالي أو عوالي اللهاذم",47,"م",1,0],["أبا مالك إن مت مت مكرما","وبعدك قد أبقيت رب المكارم",47,"م",1,0],["أبا محمد يا شهما نكن له","محض الوداد كماء النهر ينساب",48,"ب",1,0],["ابا مَروان لَست بِخارِجِيّ","وَلَيسَ قَديم مجدِكَ بِاِنتِحال",49,"ل",1,1],["أبا محمد لستُ أوقظُ نائما","لمّا دَعوتُ ولا أذكّرُ ناسي",50,"س",2,0],["أَبا مُوسَى إذا جَلاَّكَ بَدرٌ","بِتَجليَةٍ فَلا يغرُركَ نَجمُ",51,"م",1,0],["أبا محمد إن الدين في دهش","قد لاذ فيك مروع وهو منذعر",52,"ر",1,0],["أبا مفرطاً في النَّدى المفرطِ","سريعاً إلى الجود غيرَ البطي",53,"ط",2,1],["أبا متنزَّهِي في ديرِ زكَّى","ألم تكُ نزهتي بك نزهتين",54,"ن",1,0],["أبا محمدٍ الماضي إلى أمَدٍ","من المكارم كلٌّ دونه يَقف",55,"ف",1,0],["أبا محمدٍ المكسوَّ نُورَ علاً","لم يَكْسُهُ اللهُ شمساً ولا قمرا",56,"ر",2,1],["أبا مَنْ فضْلُهُ غِبْطَهْ","ويا مَنْ هَجْرُهُ سخْطَهْ",57,"ط",2,1],["أَبا مالك لا زِلتَ للملك مالِكاً","لَكَ السَعد بيتٌ وَالسُيوف تَمائمُ",58,"م",1,0],["أَبا مَريَم قيلوا بِعسفانَ ساعَةً","وَروحوا عَلى اسمِ اللَهِ وَالبَرَكاتِ",59,"ت",1,0],["أبا محسن أحسن اللَه لي","وللمسلمين العزا مؤجرا",60,"ر",2,0],["أبا محمد لا آلوك معذرةً","أبا محمدٍ والأيام تعقد بي",61,"ب",2,0],["أَبا منعمٍ راحَت إليك وهجّرت","سَواجد مِن عيسِ الرجا ورواكعُ",62,"ع",1,0],["أبا موسى رميت بشر خصم","فلا تضع العراق فدتك نفسي",63,"س",2,1],["أبا مالكٍ هل لمتني أو حضضتني","على القتل أم هل لامني كل لائم",64,"م",1,1],["أَبا ماجِدٍ اِنظُر إِلى ذي قَرابَةٍ","بِعَينِ رِضاً يُغضي لَها الخائِنُ الخِبُّ",65,"ب",1,0],["أبا مزيد فيما قطعت مودتي","وغادرتني في الناس في سلك مرجف",66,"ف",1,1],["أَبا مَخايال لا تَعْدَمْ ضُحىً ودُجىً","سِجالَ كُلّ مُلِثِّ الوَدْقِ سَحّاحِ",67,"ح",1,0],["أبا مسلم إن الفتى بجنانه","ومقوله لا بالمراكب واللبس",68,"س",1,1],["أبا منصورٍ المغرورَ أقْصِرْ","وأبْصِرْ طُرْقَ أصحابِ الرَّشادِ",69,"د",1,1],["أبا مُوسَى وَأَي أَخِي وِدَادي","أُنَاجِي لَو سَمِعتُ إِذَا أَجَابا",70,"ب",2,0],["أبا من بالمطا والظعن جاد","فديتك قف وجز ليلا بحي",71,"ي",1,0],["أبا محمّد والأيّام شاهدةٌ","أنّ الّذي قد فعلت اليوم مشكور",72,"ر",1,1],["أَبا مُعاوِيَةَ اِشكُر فَضلَ واهِبِها","وَكُلَّما جِئتَها فَاِعمُر مُصلّاها",73,"ا",3,0],["أَبا منذِرٍ رُمتَ الامورَ فَقِستَها","وَساءلت عَنها كالحَريصِ المُساوِمِ",74,"م",1,1],["أَبا منذرٍ لَولا مَسيرُكَ لَم يَكُن","عراقٌ وَلا اِنقادَت مُلوكُ الأعاجِمِ",74,"م",1,0],["أبا مصرٍ أرى أبناء مصرٍ","تجللهم بك الكرب الجلاح",75,"ح",1,0],["أبا مصر انتهيت إلى مقر","لصدرك في النعيم به انشراح",75,"ح",1,0],["أبا مالك ماذا ترى رأى نسوة","تبدلنَ حبَّ بالندَفانِ",76,"ن",1,1],["أبا مَن أطلقوني في هواهم","وتيهاً عن سواهم قيّدوني",77,"ن",2,0],["أبا محمدَ يَهنا المجد إذ هو لا","يحظى سواك به في الأرض إنسانُ",78,"ن",1,0],["أبا محسن حال القضاءُ فلم تكن","تعي داعياً أو تستجيب مناديا",79,"ي",2,0],["أَبا مَعقِلٍ إِن كُنتَ أُشِّحتَ حُلَّةً","أَبا مَعقِلٍ فَاِنظُر بِنُبلِكَ مَن تَرمي",80,"م",2,1],["أَبا مَعقِلٍ لا توطِئَنكَ بَغاضَتي","رُءوسَ الأَفاعي في مَراصِدِها العُرمِ",80,"م",1,0],["ابا مراد لقد ضاقت مذاهبنا","واضطر بالموصل الشيخان والولد",81,"د",1,0],["ابا مراد بنو فنّي متى طعنت","صدور شعرى بهذا الضرب تعترف",82,"ف",1,0],["أبا مراد أبا ليث ابا قمر","ابا أديب أبا خير الانام ابا",83,"ب",2,0],["أبا مراد لقد ضاق الخناق ولم","تعهد سوى الحلم من ابائك النجبا",84,"ب",2,0],["أبا محمد بل عثمان لا برحت","تسقي ربوعك أمطاراً بامطارِ",85,"ر",1,0],["أبا محسن إن حسن الفعال","يعقب حسناً إلى الراغب",86,"ب",1,0],["أبا مسمعٍ من تنكر الحق نفسه","وتعجز عن المعروف يعرف ضلالها",87,"ل",3,0],["أبا مصر ومصدر نعمتيها","لقد شاخ الزمان وأنت كهلُ",88,"ل",1,1],["أبا مصر مضت حقب طوال","وأنت تجود بالخيرات مضرا",88,"ر",2,0],["أبا مصر أتدري كم شعوب","بواديك استعزّوا ثم هانوا",88,"ن",3,0],["أبا مصر مضت حجج طوال","أواصرها التخاذل والفناء",88,"ا",2,0],["أَبا مُسلِمٍ لا خَيرَ في العَيشِ أَو يَكُن","لِقُران يَومٌ لا تُوارى كَواكِبُه",89,"ب",2,0],["أبا مضر ليس الشريف وإن علا","بمحتده قدراً بمطر له سدى",90,"د",2,1],["أبا منذر إن كان عندي عتيبة","وحب فأعلمني لما أنت ناقمه",91,"م",2,0],["أَبا مَعبَدٍ بئسَ الفَراضةُ لِلفَتى","ثمانونَ لَم تَترُك لِحِلفِكُمُ عَبدا",92,"د",2,1],["أَبا مَعبَدٍ واللَهِ ما حَلَّ حُبَّها","ثمانونَ سوطاً بَل تَزيدُ بِها وَجدا",92,"د",2,0],["أبا موسى جزاك اللّه خيراً","عراقك إن حظّك في العراقِ",93,"ق",1,1],["أبا مكتوم هذا الدهر آبا","وعاد مسالما ونحا الصوابا",94,"ب",2,1],["أبا مكتوم قم فانهض وعلق","على داعي عروبتنا خطابا",94,"ب",2,0],["أبا مكتوم خذ بالشعب شوطا","فإن وراءنا مهوى وصابا",94,"ب",2,0],["أبا محسن أن الزمان وإن أتى","بداهية دهماء شتى البلابل",95,"ل",1,0],["أَبا مَطَرٍ شَلَّت يَمينٌ تَفَرَّعَت","بِسَيفِكَ رأسَ ابنِ الحَواريّ مُصعَبِ",96,"ب",1,1],["ابا محسَّدَ هذا الشرق قد لعبت","فيه الحُميّا وما إِلاَّك ساقيها",97,"ي",3,