{"poems":[[65,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[3,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem146.html",""],[85,"مولاي يوم الجمعه","https://www.aldiwan.net/poem54276.html","مجزوء الرجز"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[82,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[102,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[102,"في طريق الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50125",""],[227,"روح الروح واسقني بمدام","https://www.aldiwan.net/poem55471.html","الخفيف"],[266,"اصبر على الضر ولا تمس عن","https://www.aldiwan.net/poem38116.html","السريع"],[309,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[309,"خلها تجري بعين الله في","https://www.aldiwan.net/poem16878.html","الرمل"],[325,"كوكب اليمن بمصر قد ظهر","https://www.aldiwan.net/poem67195.html","الرمل"],[358,"الحمد لله أَتم الحمد","https://www.aldiwan.net/poem38727.html","الرجز"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[369,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[371,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[409,"كم تحيات طويناها لكم","https://www.aldiwan.net/poem33916.html","الرمل"],[409,"قد قلقنا من تأخركم","https://www.aldiwan.net/poem34128.html","الرمل"],[411,"إذا رأيت الوداع فاصبر","https://www.aldiwan.net/poem49612.html","مخلع البسيط"],[415,"وسر إلى بحر خضم له","https://www.aldiwan.net/poem32206.html","السريع"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[473,"أخمد من أحزاننا ما اضطرم","https://www.aldiwan.net/poem59705.html","السريع"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[505,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[563,"هو العظيم الذي علا شانه","https://www.aldiwan.net/poem33693.html","المنسرح"],[580,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86840","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48544","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64042","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77612","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77586","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145834","الخفيف"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145628","الرجز"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72300","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46567","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77977","الخفيف"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128765","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26522","الخفيف"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130224","الطويل"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142262","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52030","السريع"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88665","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60822","الخفيف"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142146","المتقارب"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100903","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204956","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87515","الوافر"],[3271,"","https://poetry.dctabudhabi.ae/diwan/poem/142240","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62925","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205923","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131061",""],[3852,"","https://poetry.dctabudhabi.ae/diwan/poem/124212","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135902","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111403","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83537","الخفيف"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123455","الخفيف"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[4691,"قبيلتي هيفاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=59824",""],[4715,"مرثية أمي","https://www.poetsgate.com/ViewPoem.aspx?id=204454",""],[4755,"قد وَهَبناكَ فَوقَ ما تَستَطِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184812",""],[4755,"ثُمَّ باعُوا جَنوبَنا والشمالا","https://www.poetsgate.com/ViewPoem.aspx?id=190112",""],[4869,"اطهر حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=151616",""],[4927,"أنا والوردُ والعصفورُ والحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=29617",""],[5005,"سوسن..","https://www.poetsgate.com/ViewPoem.aspx?id=189350",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5354,"همس القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=192159",""],[5525,"لا تعلمني","https://www.poetsgate.com/ViewPoem.aspx?id=7190",""],[5596,"ابوسرور فقيد الفقه والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206773",""],[5605,"مرثية محمود درويش","https://www.poetsgate.com/ViewPoem.aspx?id=159623",""],[5642,"الدمع والدم","https://www.poetsgate.com/ViewPoem.aspx?id=144554",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[5691,"أطبق الصمت...!","https://www.poetsgate.com/ViewPoem.aspx?id=206739",""],[5691,"العم سام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207063",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5770,"نحن سبعة","https://www.poetsgate.com/ViewPoem.aspx?id=178734",""],[5895,"فمن يا قلب قد بدأ البعادا؟","https://www.poetsgate.com/ViewPoem.aspx?id=214126",""],[5939,"سارقة الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=131444",""],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""],[6074,"غاب على حسن وصلنا الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=200376",""],[6152,"موت روح","https://www.poetsgate.com/ViewPoem.aspx?id=201743",""],[463,"لعلها واليأسُ منها أغلبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59974&r=&rc=30",""],[3271,"الانتظار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77478&r=&rc=7",""]],"verses":[["وأنْتظِرُ العُقْبى وإنْ بَعُدَ المَدى","وأرْقُبُ ضَوْءَ الفَجْرِ والليلُ دامِسُ",0,"س",1,0],["وَإِن تُظهِرِ الأَيّامُ كُلَّ عَظيمَةٍ","فَلي بَينَ أَضلاعي لَها أَسَدٌ وَردُ",1,"د",1,0],["وانتظر الفتح الذي","يأتيك بالنصر معَهْ",2,"ع",2,0],["وإن تظلمْه تجعلْه هجاء","أشدَّ على الكريم من النبالِ",3,"ل",1,0],["وانتَظرْ للحلمِ بعدي كرّةً","كم فسادٍ كان عُقْباهُ صلاح",4,"ح",1,0],["وَأَنْ تَظْفَرُوا فِي كِفَاحِ العُلَى","وَأَلاَّ يَفُوتَكُمُ مَغْنَمُ",5,"م",1,0],["وَاِنتَظِر مَن لَيسَ يُستَأذنُ في","رفعِ أَستارٍ وَلا فَتح غَلَق",6,"ق",1,0],["وانتظار الفرار والنصر وعد","يحتمي يدني المحالا",7,"ل",2,0],["وانتظرنا الصباح حتّى أفقنا","ليلة وهو ضجّة من طلاسم",8,"م",1,0],["وانتظرناه والدجى يرعش الحلم","على هجعة القبور العتيقة",9,"ق",2,0],["وانتظرنا طلائع الحسن حتى","جاءنا ثغر فجرها بابتسام",10,"م",1,0],["وانتظر الرحمة من قوله","لا تقنطوا من رحمة اللَه",11,"ه",1,0],["وانتظاراً لما به اللَه يأتي","من خفيات الألطاف والإقبال",12,"ل",1,0],["وانتظر لطفاً خفياً مردفاً","بالفرج واليسر من هذا البلا",13,"ل",2,0],["وَاِنتِظامَ الحالِ مِن أَغراضِهِ","إِينَما كانَ وَسَل تَلقَ الأَثَر",14,"ر",1,0],["وَاِنتَظَمت فَرائد الجَواب","في سلك عقد جيد ذا الكِتابِ",15,"ب",1,0],["وانتظَرْنا الزّمانَ يوماً فيَوْماً","واعتنَقْنا الخطوبَ وَفْداً فَوفْدا",16,"د",2,0],["وانتِظاري لخيالٍ منهمُ","زَورةً بين صباحي ومسائي",17,"ا",2,0],["وَأَنتَظِرُ العُتبى مِنَ الدَهرِ مِنكُمُ","فَلا يَلقَها مِن غَيرِكُم عُمرَ الدَهرِ",18,"ر",1,0],["وانتظرنا عودها من سفحكم","كانتظار العجم عصر المنتظر",19,"ر",1,0],["وانتظرنا بالصبوح لكم","واعترانا منه بعض سغب",20,"ب",1,0],["وانتظِرِ العَوْدَ مِن قَريبٍ","فإنَّ قَلْبَ الوَداعِ عادُوا",21,"د",3,0],["وأنت ظِلُّ اللهِ في أرضِه","تردَعُ من يظلِمُ أو يَغشِمُ",22,"م",1,0],["وانتظموا المجد نبيّاً صادعاً","بالمعجزات وإماماً صدَقا",23,"ق",2,0],["وإن تظفر بعُذرتها رجالٌ","حظَوا بطلاقةِ الزمن الأغرِّ",24,"ر",1,0],["وانتظم القلوبَ سِلكُ ودّه","فما يَرَى من لا يُحبّ ويَوَدْ",25,"د",1,0],["وانتظموا سودَدَهم نظْمَ القنا","لكن صدورٌ ليس فيها أكعبُ",26,"ب",1,0],["وَاِنتَظَمَ الشَملُ وَلَولا الَّذي","تَفَضَّلَ اللَهُ بِهِ ما اِنتَظَم",27,"م",1,0],["وانْتَظِمْ بي وافْنِ الزَّمانَ بحُبِّي","إنَّ حُبَّ المَوْلى بحُبِّ الوَلِيِّ",28,"ي",1,0],["وانتَظَرْنا طالِعَ الفجرِ لهم","فقرَأْنا من سَناهُ الكُتُبَا",29,"ب",2,0],["وانتظمت بالوجود سُبْحَتُنا","في سلكه المستطيل سبحانُهُ",30,"ن",2,0],["وانتظرت عودَكَ مشتاقةً","ما أَتْعب المشْتاقَ بالانْتِظَارْ",31,"ر",1,0],["وَاِنتَظر فُرصة يَكون عَلَيها","بَعد هَذا العَنا مَدار اليَسار",32,"ر",1,0],["وإن تظهر له عذراً ليسعى","ويلقى غير وجهك فهو عاذرْ",33,"ر",1,0],["وانتظاري لما يؤوبُ به عن","ك انتظارُ المستشرف المتشوِّف",34,"ف",1,0],["وَاِنتَظَم الجَيشان مَع بَعضهما","وَسالَت الدِماءُ مِن عَضِّهما",35,"م",2,0],["وَاِنتَظم الجَيشان في الهَواءِ","وَاِحمَرَّت الحَصباءُ بِالدِماءِ",36,"ا",2,0],["وانتظرنا تلويحة ثم قلنا","لا تُسِيءْ فهْمَ قلبِها يا وداعُ",37,"ع",1,0],["وانتَظَمَتْ صُفُوفُنا","تَردُّ كُلَّ مارِقِ",38,"ق",1,0],["وانتظرنا بزحفنا برء نور الدين","علماً منا بأنه سيفيق",39,"ق",1,0],["وَاِنتَظِري المَنيه","وَقَصري الأمنيه",40,"ه",1,0],["وانتظر بدوة الحمام وَهَل من","ملجأ عند بدوة للحمام",41,"م",1,0],["وانتظمنا بافقها كنجوم","ونبتنا بروضها كاقاح",42,"ح",1,0],["وَاِنتِظارُ الرِضى فَإِنَّ رضى السا","داتِ عِزٌّ وَعَتبَهُم تَقويمُ",43,"م",1,0],["وأنتظر الإقبال بالودّ منكم","وأصبر حتى أوجعتني المغايظ",44,"ظ",1,0],["وأنتظر العتبى وأغضي على القذى","ألاين طوراً مرةً وأغالظ",44,"ظ",1,0],["وأن تظهر الحق المبين إلهنا","لكي يستبين الحق والزيغ يقمع",45,"ع",1,0],["وَأنتَ ظَمآنٌ لَهُ أشْهُراً","وَكِدتَ مِنْ شَوقٍ لَهُ تَهْرَبُ",46,"ب",1,0],["وانتظر ما سوف منه يظهر","فهو المهدي ان لدّ الخصام",47,"م",1,0],["وانتظِر عطفَه الحبيب فكم منْ","فرجٌ قد أتاك بعْدَ انتظاره",48,"ر",2,0],["وأن تظهر الود للمارقين","وتستبطن البغض للأوفياء",49,"ا",2,0],["وإِن تظمأ بهِ فاذكر حسيناً","وثق بالماءِ فيهِ على ضمانى",50,"ن",2,0],["وأنتظر الرقب يموت يوماً","لو أن لعمري الماضي مردا",51,"د",2,0],["وانتظر النسيم لعلَّ فيهِ","لنا منها سلاماً في الهبوبِ",52,"ب",1,0],["وانتظرتُ الضُّحى فأقبل يرتا","عُ على ساعديه عُشبٌ ونَهر",53,"ر",1,0],["وانتظرتُ الأصيلَ حتى دنا مِنْ","نِي وجنباه للصبابات وَكْر",53,"ر",1,0],["وانتظرتُ المغيبَى وهو غريبٌ","أهلُه أورثوه ثُكْلاً ومَرّوا",53,"ر",3,0],["وانتظارُ الجييعِ أَنْ تعْقِبَ الدا","رُ ولا السيرُ في طِلاب الحُمُولِ",54,"ل",1,0],["وانتظر رافعي الدعائم حتى","يرفعوا بيتهم عزيز المثالِ",55,"ل",1,0],["وإن تظلم أخا حب","يقل هذا هو العدل",56,"ل",1,0],["وانتظروا حتى يلوح الحمى","والعيش فيه طيب طيب",57,"ب",1,0],["وأنت ظاهرٌ بنفس الباطنِ","وباطنٌ بظاهرٍ للكائنِ",58,"ن",1,0],["وَأنتَ ظَلَّ عَنِ الإِغرِيقِ مثعتَزِلاً","بِقُربِ فُلكِكَ لا تَلوي على لِينِ",59,"ن",1,0],["وانتَظَمَ الياقوتتينِ صَيِّبٌ","إذا أصابَ الرَوضَ مِعطالاً حلا",60,"ا",1,0],["وَاِنتَظم شَملَنا بهديك فينا","كلُّ هديٍ يَحلو بحسن اِنتِظامِ",61,"م",1,0],["وانتظاماً بسِلك مَن أسبلَ اللهُ","على عيشهم جميلَ الغطاء",62,"ا",2,0],["وانتظار وظل يفعل والظل","وظرف والظفر والإنعاظ",63,"ظ",1,0],["وأنتظر اللقى ليلا","وبالأشواق أضطرب",64,"ب",1,0],["وانتظرتيني وطال الأنتظار","واشتهيت انك على صدري تميلي",65,"ل",2,0],["وانتَظَرناكَ والمَدَى نِصفُ شِبرٍ","لَم نُقَصِّرْ.. فأينَ ضاعَ الصَّنِيعُ؟!",66,"ع",1,0],["وانتَظَرنا رُجُوعَهُم لا لِشَوقٍ","بَل لِنَنسَى وُعُودَهُم والمِطالا",67,"ل",2,0],["وانتَظَرنا انتِفاضَةَ الشَّعبِ لكن","سُخرَةً عاشَ مِثلَنا واتِّكالا",67,"ل",2,0],["وانتظر اسمك يحرك (مع شعوري بك) لساني","وانتظرك الليث واحلم اني اسكن في عرينه",68,"ن",2,0],["وَانْتَظَرْنَاْ عَوْدَةَ الأَمْنِ إِلَىْ","أَخْلَصِ الْعُشَاْقِ فِيْ إِيْمَاْنِهِ",69,"ن",2,0],["وأنتظر النجوم عسى أراها","تمر على ثرى حِبي سحابا",70,"ب",2,0],["وانتظرت الإلهام حتى إذا ما","رنّ بي هاتف الخيال المستّر",71,"ر",1,0],["وانتظار لقادم يملأ الدو","ر ابتهاجا يجدد الميلادا",72,"د",2,0],["وأنت ظل من الآمال وارفة","وأنت نبع من الإلهام دفاق",73,"ق",1,0],["وانتظر لي ليلة او ليلتين","لين ما يقفي السحاب وينجلي",74,"ل",2,0],["وأن تظلك منه سُحْب مغفرة","بغيث مرحمة كشفا من الغمم",75,"م",1,0],["وانتظرتك ربما لاح فجر","فإذا الحكم قال : حَانَ الرَّحِيلُ",76,"ل",1,0],["وإن تظلَّ بوَهدِ الغيِّ نُجعتُهُم","ففي الهلاكِ لهُم غوصٌ وتسويخ",77,"خ",1,0],["وانتظرنا أوهام صلح قريب","يجمع الصف مثل أمس متينا",78,"ن",2,0],["وانْتَظرْنا– ولم نزلْ– وعْدَ(عُرقوبَ)","سراباً أمامَنا رجْراجا !",79,"ج",2,0],["وانْتَظرنا إمْطارَ قمْح ٍووردٍ","منْ مناقيرها علينا الحمائِمْ !",80,"م",1,0],["وانْتَظَرْتُ الرغيفَ مِنْ كفِّ أمّي","لافِحاً ثَمَّ وجْهَها الطّابونُ",81,"ن",1,0],["وانتظرناهُ شتاءً ما أتى، غير أنا في انتظارٍ لا نزال","\"مريمٌ\" أختي ألا تعرفها؟ تُنشدُ الشعرَ بشوقٍ وانفعال",82,"ل",1,0],["وَأنْتَظِرُ الحَنَانَ وَمَا رَأينا","طُيُوفاً لِلْحَنَانِ وَلا وِدَادَا",83,"د",2,0],["وانتظري كي أحسِمَ أمري","إنّي في حُسنِكِ أتحيّرْ",84,"ر",1,0],["وَأَنْتَ ظِلالٌ في مُحيطِ نَوافذٍ","تُحِيْطُ بِضَوْءٍ فِيهِ بَدْرُكَ ذائبُ !",85,"ب",1,0],["وانتظمت أسهم الفراق له","جوانحا بين طيّها جسم",86,"م",1,0],["وأنتظر المساء بغير شوق","ولن أشكو بساعاتي إغترابا",87,"ب",2,0],["وانتظموا سوددهم القنا","لكن صدورٌ ليس فيها أكعبُ",88,"ب",1,0],["وانتظرتُ المغيبَ. وهو غريبٌ","أهلُه أورثوه ثُكْلاً ومَرّوا",89,"ر",3,0]]}