{"poems":[[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[56,"من كل عابرة إذا وجهتها","https://www.aldiwan.net/poem27592.html","الكامل"],[32,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[90,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[91,"من كل عاصمة الرشيد لاهلها","https://www.aldiwan.net/poem44655.html","الكامل"],[87,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[82,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[76,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[54,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[77,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[15,"دعا معاشر فاستكت مسامعهم","https://www.aldiwan.net/poem45275.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[27,"للمازنيّة ِ مُصْطافٌ ومُرْتَبَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=22834",""],[186,"يا مهدي الدر بين الحبر والورق","https://www.aldiwan.net/poem67045.html","البسيط"],[303,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[309,"يا سعد قلبي حزين","https://www.aldiwan.net/poem16802.html","المجتث"],[309,"أحسنت يا وجيه دين الله","https://www.aldiwan.net/poem16832.html","الرجز"],[309,"ولى الزمان وولت الأيام","https://www.aldiwan.net/poem16867.html","الكامل"],[358,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[384,"إنا إذا قلت طخارير القزع","https://www.aldiwan.net/poem4565.html","الرجز"],[396,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[438,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[445,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[445,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[458,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[543,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[556,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[556,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138269",""],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199595","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38159","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70905","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119934","المنسرح"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49941","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115248","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27768","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106853","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60966","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58322","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45747","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129330","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202334","البسيط"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32674","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114170","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133235","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4023,"","https://poetry.dctabudhabi.ae/diwan/poem/146892","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102739","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72457","المنسرح"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[4767,"مركز الماجد","https://www.poetsgate.com/ViewPoem.aspx?id=97448",""],[5158,"لا تاخذين الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=58967",""],[5213,"يا دار يومك بالغميم محجل","https://www.poetsgate.com/ViewPoem.aspx?id=170533",""],[5581,"أنذار","https://www.poetsgate.com/ViewPoem.aspx?id=22501",""],[186,"يا مهدي الدر بين الحبر والورق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55786&r=&rc=49",""],[6237,"الليل في الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77891&r=&rc=33",""]],"verses":[["منْ كُلِّ عَرّاصٍ إذا جَدَّ الرّدى","في الرّوْعِ لاعَبَ مَتْنَهُ العَسَلانُ",0,"ن",1,0],["مِن كُلِّ عابِرَةٍ إِذا وَجَّهتُها","طَلَعَت بِها الرُكبانُ كُلَّ نِجادِ",1,"د",1,1],["مِن كُلِّ عَجزآءَ في أَحشآئِها هَضَمٌ","كَأَنَّ حَليَ شَواها أُلبِسَ العُشَرا",2,"ر",2,0],["من كل عبد في السياسة باعه","وشراه هذا الدرهم المقبوض",3,"ض",1,0],["من كل عاصمة الرشيد لاهلها","لم يبق الا طيفها وخيالها",4,"ه",2,1],["مِن كُلِّ عالي القَدرِ مِن أَعلامِهِ","تَتَهَلَّلُ الفُصحى إِذا سُمّيتُهُ",5,"ت",2,0],["مِن كُلِّ عَينٍ عَليها مِثلُ تالِئها","مَكسورَةٍ ذاتِ فَتكٍ غَيرِ مَكسورِ",6,"ر",1,0],["من كلّ عارض نَبلٍ غيرِ منقشعٍ","في القَطْرِ منه شرارُ الموت يضطرمُ",7,"م",1,0],["مِن كُلِّ عارِفَةٍ كَما اِنسَجَمَ الحَيا","وَاِفتَرَّ بارِقُ مُزنَةٍ عَلى مَبسِمِ",8,"م",1,0],["مِن كُلِّ عَيشٍ قَد أَصَب","تُ لَذيذَهُ وَسَلَكتُ نَحوا",9,"و",2,0],["من كل عاري اللِّيتِ من نَظم التي","رَجَحَتْ بخيرِ تجارَةٍ أثمانها",10,"ن",3,0],["مِن كُلِّ عِجلِزَةٍ بادٍ نَواجِذُها","عَلى اللِجامِ تُباري الرَكبَ في عَنَدِ",11,"د",1,0],["مِنْ كُلِّ عِتْرِيفَةٍ لَمْ تَعْدُ أَنْ بَزَلتْ","لَمْ يَبْغِ دِرَّتَهَا رَاعٍ ولاَ رُبَعُ",12,"ع",1,0],["مِنْ كُلِّ عَائِرَةٍ تَسْتَنُّ فِي طَلَقٍ","يَغْتَالُ بِالْبُهْرِ أَنْفَاسَ الْمَحَاضِيرِ",13,"ر",1,0],["مِنْ كُلِّ عَاصِيَةِ النُّهُودِ بِهَا تُقًى","مِطْوَاعَةِ الأَعْطَافِ ذَاتِ حَيَاءِ",14,"ا",2,0],["من كل عرباء فوق حاجبها","أو ما نزار البيان أو مضره",15,"ر",2,0],["من كُلِّ عَادٍ له في الشرِّ فلسفةٌ","أسرارُها عند مُوشَى وابن غُرْيونا",16,"ن",2,0],["مِن كلِّ عِتْريقة ٍ لمْ تعُدْ أنْ بَزَلتْ","لم يَبغِ دِرَّتَها راعٍ ولا رُبَعُ",17,"ع",1,0],["مِن كُلِّ عَذراءَ وَافَت تَنجَلي فَجَلَت","كَأساً أَصَبتُ بِها سُكراً فَلَم أُفِقِِ",18,"ق",1,0],["من كُلِّ عبدٍ للطُّغاةِ وحِزبهمْ","وتراه شيطاناً علينا ماردا",19,"د",2,0],["من كل عاشق مكين","قد طال منه النزوع",20,"ع",1,0],["من كل علام إمام قدوة","صوفي مصفى للأنام صفوه",21,"ه",1,0],["من كل علام منيب خاشع","يحيا به الإيمان والإسلام",22,"م",1,0],["مِن كُلِّ علج عَلَيهِ مِثل جثَّتِهِ","سَوابِغٌ حَملها أَعياهُ عَن هَرَبِ",23,"ب",1,0],["من كل عراص اذا هز اهتزع","مثل قدامى النسر ما مس بضع",24,"ع",1,0],["من كل عالي وسافل","من كل ما يسخط الله",25,"ه",1,0],["من كل عذراء أحاديثُها","تملأُ أُذْن المثَلِ السائر",26,"ر",1,0],["من كلِّ عاقِدِ ميثاقٍ يداً بِيَدٍ","لَمْ تَخْلُ فِيهَا يدُ الرحمنِ من يَدِهِ",27,"د",2,0],["من كُلِّ عارٍ بالتَّجَمُّلِ مُكتَسٍ","ومُزَوَّدٍ بالصَّبْر غيرِ مُزَوَّدِ",28,"د",1,0],["من كل علج حقير يدعي شرفا","وهمه دون هم للمفاليك",29,"ك",1,0],["من كلّ عذراء مخلوعٍ إذا برزتْ","فيها العذارُ وما إن ليم خالعُهُ",30,"ع",2,0],["من كلِّ عَذراءٍ كَعابٍ رأسُها","يَعلوهُ من فَرطِ الحَياءِ خِمارُ",31,"ر",1,0],["من كلّ عُريانِ اليدين من ال","مَعروف ملآنٌ من البخلِ",32,"ل",1,0],["من كلّ عارٍ من المعروفِ منكبُهُ","هاعٍ إذا غِرْتَ في تفتيشه لاعِ",33,"ع",1,0],["من كل علم نال قسطاً وافراًُ","أضحى به فوق النوابغ جهبذا",34,"ذ",2,0],["من كل عذب وندّي","شلّ أريع يفال",35,"ل",1,0],["مِن كلِّ عَدلٍ ضابِطٍ ثِقةٍ أَخي","حِفظٍ وَثَبتٍ فَضلُهُ لَم يجحَدِ",36,"د",1,0],["مِنْ كل عدْل للمحامد جامعٍ","بين الرجال مكرمٍ ومبجَّل",37,"ل",1,0],["من كل عذراء ليس ترضي","غيرك إن خوطبت بمهرِ",38,"ر",1,0],["من كلّ عذراء تجلى في محاسنها","كما تزفّ بنات البيت بالنغم",39,"م",1,0],["من كلِّ عاطِلَةٍ بجبيدٍ جَدايةٍ","أَدْماءَ مُزْجِيّةٍ أَغنَّ موشَّحا",40,"ح",2,0],["من كلّ عبلِ الساعدين","تراهُ أو ضخمِ الدسيعه",41,"ع",2,0],["من كلِّ عذريّ الهوى قلبهُ","يرفُّ ما رفَّ عَذاراها",42,"ا",3,0],["مِن كُلِّ عادٍ في مَلابِسِ عادِلٍ","أَو ثَعلَبٍ يُزهى بِلُبدَةِ حَيدَرِ",43,"ر",1,0],["من كل عاتٍ كم تَخَيَّلَ أنه","بلغ السماءَ بِقُوَّةِ السلطانِ",44,"ن",1,0],["من كل عين كالمراة صفا","أو جدول كمهند القضب",45,"ب",1,0],["من كلِّ عينٍ تؤدّيها إلى عَطَب","ولو قد سعينا في تلافيها",46,"ي",3,0],["من كل عالية الجنابِ رفيعةٍ","تندى يداها أنعماً ومواهبا",47,"ب",2,0],["من كلّ عاسلةِ القَوامِ كأنها","في بردها المعسول عَسَالُ القنَا",48,"ن",2,0],["مِن كل عِلْقٍ مثل بدر الدجى","قيَمتُهُ في واحدٍ بَدْرَه",49,"ر",2,0],["من كلِ عَطشانِ الوِشا","حِ مُمَيَّلِ شَرِقِ السِّرارِ",50,"ر",1,0],["مِن كُلِ عَبد المهيمن طاعة","وَأَعان عانيه عَلى الطاعات",51,"ت",1,0],["من كل عذب مقلة أقلامه","صبت على الباغين سوط عذاب",52,"ب",1,0],["من كل عارض عضب فوق منكبه","كأنه نهَرٌ جار على ثغب",53,"ب",1,0],["مِن كُلِّ عَسجَدَةٍ في خِدرِها اِكتَتَمَت","عَذراءُ في بَطنِها الياقوتُ مُكتَمِنٌ",54,"ن",1,0],["مِن كُلِّ عِلمٍ فَائِقٍ رَائِقٍ","وَأدَبٍ كَالدُّرِّ نَضَّدَهُ",55,"د",2,0],["من كل عيساء تسرى وهي صامته","في ظهرها قتب في سيرها خبب",56,"ب",1,0],["مِن كُلِّ عِلمٍ قَد أَجَزتُ فيهِ","وَمِن كِتابٍ عالِم يَحويهِ",57,"ه",1,0],["مِن كُلِّ عِلمٍ مالِكٌ إِقليدُهُ","أَفَلا تَراهُ لِكُلِّ فَضلٍ مُعدَتا",58,"ت",2,0],["مِن كُلِّ عِلمٍ وَكِتاب حَصَّلَهُ","قِراءَة وَكُل ما أُجيزَ لَهُ",59,"ه",1,0],["من كل عَطشانِ الوشا","حِ مميّلٍ شَرِق السِّوارِ",60,"ر",1,0],["من كل عيناء نشوى من سلاف صبا","تغنيك بالجفن عن حانات شماس",61,"س",1,0],["من كل علم أحرزت زبدته","فللسوى ما تركت من زبد",62,"د",1,0],["مِن كُلِّ عَذراءَ حُبلى في تَرائِبِها","رَدعان مِن عَنبَرٍ وَردٍ وَكافورِ",63,"ر",1,0],["من كل علمٍ نافع أشرقَتْ","شَمسُ الصباح منه للراقدِ",64,"د",1,0],["من كل عقلي أرسمه داخل الماي !!","ومن كل قلبي .. انقهر ../ لامحيته !",65,"ت",2,0],["من كل عاطلة السوالف غادة","هيفاء تمرح بالحلي وترفل",66,"ل",1,0],["من كل عاطى الجيد ليل وصاله","صبح وصبح نواه ليل أليل",66,"ل",1,0],["من كل عود عله","فى مزارع الثوار",67,"ر",1,0],["من كل عذراء وافت تندلي فجلت","كأساً أصبت بها سكراً فلم أفق",68,"ق",1,0],["من كل عاطرة ريّا مضمخة","بالمسك ينداح من زهر ومن فننِ",69,"ن",1,0]]}