.poetsgate.com/ViewPoem.aspx?id=16092",""],[5055,"الأشخرة","https://www.poetsgate.com/ViewPoem.aspx?id=104391",""],[5081,"دُعَاءُ مُضْطَّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187761",""],[5089,"عرِّجْ على هذا الجمال الأقدسِ","https://www.poetsgate.com/ViewPoem.aspx?id=128710",""],[5136,"يا شمس أفق سما المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=121560",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5147,"ما أضمرت مني الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=166704",""],[5147,"يا ربع زحلة أين عنا","https://www.poetsgate.com/ViewPoem.aspx?id=166758",""],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""],[5213,"عرج النبي الى السماء وعرشها","https://www.poetsgate.com/ViewPoem.aspx?id=170447",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5397,"زهت ابتهاجاً ليلة الأسراء","https://www.poetsgate.com/ViewPoem.aspx?id=157893",""],[5408,"أبي...وعاد أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190865",""],[5431,"أيا ليته يجني الكريم عدالةً","https://www.poetsgate.com/ViewPoem.aspx?id=187715",""],[5431,"سريتَ إلى الأقصى كأنك فرقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=187915",""],[5431,"بريد مستعجل لمحمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=208569",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5464,"حكاية في ليل بهيّ","https://www.poetsgate.com/ViewPoem.aspx?id=27916",""],[5582,"عَرِّجْ فَهَذِي ( رُسُومُ ) الأَثْلِ وَالبانِ","https://www.poetsgate.com/ViewPoem.aspx?id=187310",""],[5660,"ما بَينَ ثائِرَةِ الرِّياحِ السَجسَجِ","https://www.poetsgate.com/ViewPoem.aspx?id=27724",""],[5671,"ضل الطريق وضلت العفر","https://www.poetsgate.com/ViewPoem.aspx?id=169350",""],[5691,"سجال(2)","https://www.poetsgate.com/ViewPoem.aspx?id=206440",""],[5720,"يا أيها الشبلُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199718",""],[5736,"مرام بنت الشام","https://www.poetsgate.com/ViewPoem.aspx?id=208480",""],[5765,"موتٌ ينادي للولادة !","https://www.poetsgate.com/ViewPoem.aspx?id=213304",""],[5790,"عرج بطويلع فلي ثم هوى","https://www.poetsgate.com/ViewPoem.aspx?id=111971",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[5937,"الأوركيديّة","https://www.poetsgate.com/ViewPoem.aspx?id=211800",""],[5961,"ماء الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=199791",""],[5974,"عَرَّابة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206697",""],[6069,"عرج فديت على الحبيب وحيه","https://www.poetsgate.com/ViewPoem.aspx?id=105723",""],[242,"أتلومني يا عاذلي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563753",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""]],"verses":[["عرِّجْ على الوادِي كَذا يسْرَةً","وابْلِغْ سَلامي ذلكَ المَرْبَعا",0,"ع",2,0],["عرّجْ على الوادي المقدّسِ والحِمى","واقْصِدْ ضَريحاً لا يَغيبُ جوارُهُ",1,"ر",2,0],["عَرِّج بِأَطرافِ الدِيارِ وَسَلِّمِ","وَإِن هِيَ لَم تَسمَع وَلَم تَتَكَلَّمِ",2,"م",1,1],["عرج على حرم المحبوب منتصباً","لقبلة الحسن واعْذرني على سهري",3,"ي",1,1],["عرِّج على قبرِ الكمال وقلْ له","سحبت عليكَ السحبُ من أذيالها",4,"ه",2,1],["عرج على حرم الجراية منشداً","يا دار ما صنعتْ بكِ الأيام",5,"م",1,0],["عرِّجْ على ذكرِ الصدي","قِ وَعَدِّ عن ذكرِ الحبيبِ",6,"ب",1,0],["عَرِّجْ علينا نُصِب غَدَاءً","ونُعْمِلِ العود والزجاجَهْ",7,"ج",2,0],["عَرِّجْ أبا عبدِ الإله ورُبَّمَا","كَفَّ الجَوَادُ عن الجِمَاحِ وما كُمحْ",8,"ح",1,0],["عرِّج أبا موسى عَليَّ فإنني","فيمن تليه ومن يليك مردَّدُ",9,"د",1,0],["عرِّجا صاحبيَّ بالبصرةِ الزَّهْ","راء تعريج مُدنفٍ ذي سقام",10,"م",1,0],["عرجت روحه الى الموطن الاعلى","بليل يدله جبريل",11,"ل",1,0],["عرج على وادي السلام تجد دما","فهناك ثم هناك كان المصرع",12,"ع",1,0],["عَرِّجوا فَالدُموعُ إِن أَبكِ في الرَب","عِ دُموعي وَالإِكتِئابُ اِكتِئابي",13,"ب",2,0],["عَرِّج عَلَينا جَزاكَ اللَهُ مَغفِرَةً","فَقَد تُرى وَقَليلٌ مِنكَ تَعريجُ",14,"ج",1,0],["عَرِّجُوا فالكثيبُ مَغنى الغَواني","وقِفُوا فهو مَوْقِفُ العشَّاقِ",15,"ق",1,0],["عرّجْ بأرض الناصرّية كي تَرَى","شَرَفَ المكان وقدْرَةَ الإمكانِ",16,"ن",1,0],["عَرِّجْ على حطّينَ واخ","شعْ يُشْجِ قلبكَ ما شجاني",17,"ن",2,0],["عَرِّج عَلى الدارِ الَّتي كُنّا بِها","تَغَيَّرَت مِن بَعدِ عَهدِنا بِها",18,"ب",3,1],["عَرِّجْ بِرامَة إنها لَمرامِي","وبِجيرةٍ فيها عَلَيَّ كِرامِ",19,"م",1,1],["عرجا صاحبيّ بالروض كخَرُود","صبَّغتها بوادِرُ الإحتشام",20,"م",1,0],["عرّجْ بطُوَيْلِعٍ فلي ثَمّ هُوَيّ","واذْكُر خَبَرَ الغَرام واسنِدْهُ إليّ",21,"ي",1,1],["عرِّج بِبَغداد تعرف مثل معرفتي","فَما عيان امرئٍ للشيء كالخبر",22,"ر",1,0],["عَرَّجْتُ فِيهَا أُحَيِّيهَا وأَسْأَلُهَا","فَكِدْنَ يُبْكِينَني شَوْقاً ويَبْكِينَا",23,"ن",2,0],["عَرَّجْتُهُ رَائداً في عَازِبٍ عَرِدٍ","جُنَّ النَّوَاصِفُ فِيهِ واليَحَامِيمُ",24,"م",1,0],["عَرِّجا بي عَلَى دِيَارٍ لِهِندٍ","لَيسَ إن عُجتُمَا المَطِيَّ كَبيرا",25,"ر",2,0],["عَرِّج عَلى حَلَبٍ فَحَيِّ مَحَلَّةً","مَأَنوسَةً فيها لِعُلوَةَ مَنزِلُ",26,"ل",1,0],["عرج على تمثاله","والثَم جوانب صخره",27,"ر",2,0],["عرج عليها والها لعلها","تريح شيئا من تباريح الجوى",28,"ا",1,0],["عرجوا عن الدنيا وأعرج في الهوى","شتان بين قرارهم وقراري",29,"ر",2,0],["عَرَّجْتُ أَسْأَلُهَا بِقَارِعة ِ الغَضَا","وكَأنَّهَا أَلْوَاحُ سَيْفٍ ثَامِلِ",30,"ل",1,0],["عَرَجتُ بِسرِّي نَحوَ مَن هُوَ سِرُّه","وإنّي لَرَاضٍ بالعَطاءِ وبالمَنعِ",31,"ع",1,0],["عَرِّجا في رُبوعها وَسَلاها","كَيفَ تَسلو مُتَيَّماً ما سَلاها",32,"ا",3,1],["عَرَّجَت غادَةٌ مُلَثَّمَةُ الوَج","هِ عَلى فُندقٍ بِزَحلَة حائِد",33,"د",1,0],["عرِّج بِرامَةَ إِنَّ رامَةَ مُنتَهى","أَمَلي وَغايَةَ بُغيَتي وَمُرادي",34,"د",2,0],["عَرِّج بِأَحمَدَ تَلقَ عِزّاً باذِخاً","وَبَلوغ آمالٍ وَنَيل مُرادِ",34,"د",1,0],["عَرِّج بِزَوراءِ العِراقِ تَجِد بِها","مِن جودِ مَجدِ الدينِ بَحراً مُزبِدا",35,"د",2,0],["عَرِّجْ بِأَنْجَادِ الْعُلاَ","مِنْ أَرْضِهِ تَسْعَدْ وَتُنْجَدْ",36,"د",1,0],["عَرِّجْ بِمُنْعَرِجِ الْهِضَا","بِ يَتِيمَةِ الْعِقْدِ الْمُنَضَّدْ",36,"د",1,0],["عَرِّجْ عَلَى وَادِي بَنِي دَرْكُولِ","وَأَنِخْ بِجَامِعِ قُبِّهَا الْمَأْهُولِ",37,"ل",1,1],["عَرِّجْ عَلَيْهَا إذِ ْ بِهَا","مَا أَعْجَبَ الصَّبَّ الْمُلاَطِفْ",38,"ف",1,0],["عَرِّجْ عَلَى قَبْرِ","قَدْ حُفَّ بِالسِّرِّ",39,"ر",1,1],["عرّج على كلِّ أرضٍ أهلُها عربٌ","وحيّهِم وافتقد في الغربِ أحبابا",40,"ب",2,0],["عَرِّج عَلى جِلَّقَ الفَيحاءِ غوطَتُها","فَحَيّ جامِعَها عَنّي وَأَهليها",41,"ي",3,0],["عَرّج عَلى ساحَة السادات تلقهم","أَهل الوَفاءِ وَقَد تَغنى الاِشارات",42,"ت",1,0],["عَرِّجْ بِها فَشُجاعٌ دونَها أَسَدٌ","هِيَ السَلامَةُ مَحفوفٌ بِها العَطَبُ",43,"ب",1,0],["عرجَ السيد المسيح مُعِدّاً","لجنانٍ يحوزها كلُّ راق",44,"ق",1,0],["عَرّجا بي عَلى الرِياض سَحيراً","وَهِلال الظَلماءِ كَالعَرجون",45,"ن",1,0],["عَرَجْ على أربعٍ للصَّبر قد درسَتْ","وقفْ على دمَنٍ منها وآثارِ",46,"ر",1,0],["عرِّج عليَّ فما في رونقي رَنَقٌ","لِمَن أُصافي ولا في خُلّتي خَلَلُ",47,"ل",1,0],["عرِّجْ على الشَّيخِ الجَليل المُرتَجى","وزر الوزارَةِ أحمَدِ بنِ مُحَمَّدِ",48,"د",1,0],["عرّج عن الأربعِ الأوائل","واقصِد بها أشرفَ الديار",49,"ر",1,0],["عرج على حوضٍ به طاف الصفا","يهدي المسرة والهناءَ لمن يرى",50,"ر",2,1],["عرج له سبتا تحز سبتا لدى","أفضال محيي السبت وهو بسيم",51,"م",1,0],["عرّج يا صاح لروضته","ان مسّك ضيم او تضما",52,"م",2,0],["عَرَّج عنها الصباحُ منطلقاً","وعادَ والليلُ رَهْنُ تَقْيِيدِ",53,"د",1,0],["عرج على وادي العقيق","إلى الحصب من منى",54,"ن",2,1],["عرِّجْ على الوادي ولو","إلمامةً لا حَلَّهْ",55,"ل",2,0],["عرِّج بروضاتِ الغَرِيِّ سائفاً","أزكى ثرىً وواطئاً أعلى محلّْ",56,"ل",1,0],["عرِّج على الوادي فقل عن كبدي","للبان ما شئت الجوى والحُرَقا",57,"ق",2,0],["عرَّجتُ عنها مُعرِضاً","وقد استقام مَزارُها",58,"ر",3,0],["عَرِّجْ وقُل لأبي عليٍّ مالئاً","أُذُنَيْه حيَّتك الغوادي الرُّوَّحُ",59,"ح",1,0],["عرج على الأَطلال صُبحةَ بينهِم","إن شئتَ أن تلقى الصباح الأسودا",60,"د",2,0],["عرج أخي حمى ليلى ومنعرج","مع بارق عن غراب البين في وهج",61,"ج",1,1],["عرج بمنعرج الكثيب 