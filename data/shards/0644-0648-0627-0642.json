{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[90,"ألا ما لأهل الشرق في برحاء","https://www.aldiwan.net/poem44973.html","الطويل"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[46,"أأيامنا ما كنت إلا مواهبا","https://www.aldiwan.net/poem30584.html","الطويل"],[52,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39497","الطويل"],[164,"من زاحم الأسد في غاباتها وقعا","https://www.aldiwan.net/poem58923.html","البسيط"],[164,"والله ما صدق الواشي الذي نقلا","https://www.aldiwan.net/poem58999.html","البسيط"],[189,"زيادة المال باب الهم والتعب","https://www.aldiwan.net/poem14693.html","البسيط"],[422,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[519,"لو أقسم المرء بالرحمن خالقه","https://www.aldiwan.net/poem20864.html","البسيط"],[520,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[591,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38138","البسيط"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93588","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104678","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100727","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89072","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103028","الكامل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107280","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120554","البسيط"],[4791,"خمر الأرياق","https://www.poetsgate.com/ViewPoem.aspx?id=28419",""],[5302,"قلبي شكا بعدا","https://www.poetsgate.com/ViewPoem.aspx?id=215932",""],[5387,"أميرة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=53848",""],[5848,"شلة حراميه","https://www.poetsgate.com/ViewPoem.aspx?id=53203",""],[5848,"مدي يدك ..","https://www.poetsgate.com/ViewPoem.aspx?id=48998",""],[5956,"وشاح الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182126",""],[5973,"الماس يصبح أغلي حين نفقده","https://www.poetsgate.com/ViewPoem.aspx?id=29237",""],[5309,"إن امست الأرض دار الهم والحزن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573922",""]],"verses":[["لَو أَقاموا لَها سِواكَ لَثَبَّت","صَعبَةً تَمَنعُ المَطا وَالعِذارا",0,"ر",2,0],["لو أقتصّ ربّ العلم للعلم منهم","لصبّ عليهم منه سَوْط بلاء",1,"ا",2,0],["لو أقطعوه صوفهم","غرس الخناجر في الحناجر",2,"ر",1,0],["لَوِ اِقتُسِمَت أَخلاقُهُ الغُرُّ لَم تَجِد","مَعيباً وَلا خَلقاً مِنَ الناسِ عائِبا",3,"ب",2,0],["لَو أَقامَت نَعِمتُ بالاً وَلَكِن","ذَهَبَت وَالشَقا عَلَيَّ الذَهابُ",4,"ب",1,0],["لَواقِحَ دُلَّحٍ بِالماءِ سُحمٍ","تَثُجُّ الماءَ مِن خَلَلِ الخَصاصِ",5,"ص",1,0],["لَواقطُ حبَّاتِ القُلوبِ إذا رنَتْ","بسحرِ عُيونٍ وانْكِسارِ جُفونِ",6,"ن",1,0],["لو اقتسمنا بقدرِ الحب منك رضىً","لكان لي فيه كل منهم تبعا",7,"ع",2,0],["لو اقتسمنا بقدر الحب منزلة","أعطيت علواً وأعطى غيري السفلا",8,"ل",2,0],["لو أقنع المرءَ من دنياه منزلةٌ","ينالُها كان معذورا على الطلب",9,"ب",1,0],["لو أقاموا فيها ولو بعض يوم","لأخذت الأَعداء أخذاً وبيلا",10,"ل",2,0],["لو أُقيمت معجزاتي فيكُمُ","قِبلةً صلَّى لها الشعرُ وصاما",11,"م",2,0],["لو أقسم المرءُ بالرحمنِ خالقه","بأنَّ بعضَ الورى لا شيءَ ما حنثا",12,"ث",2,1],["لو أقسم الغيث يوماً أن يصافحني","نابت أنامل بدر عنه في القسم",13,"م",1,0],["لَوْ أَقْسَم المُدْلِجُ السَّارِي على قَمَرٍ","باسْمِ الأميرِ دَعاهُ قَطُّ ما غَرَبا",14,"ب",2,0],["لَو أَقبَلَت لَرَأَيتَ الشّمسَ رَأد ضحى","أَو أَدبَرَت لَرَأَيت الشّمسَ في الطفلِ",15,"ل",1,0],["لو اقتسمت سماحتَهُ البرايا","لعز لبخلها ابدا وجود",16,"د",1,0],["لو أقامت على الوفاق لأودت","فكأنَّ النفاق سرّ بغاها",17,"ا",3,0],["لَو أَقبلت مضر تَقفو رَبيعتها","يَستنزلونهما الفوا هدىً وَنَدى",18,"د",2,0],["لَو اقتَفَت مَذهَبي في الحُبِّ لَم تُفِقِ","لَكِنَّها كَمُدامي قَطُّ لَم تَذُقِ",19,"ق",1,0],["لوا قواف تؤثر الفضل والنهى","لا سقيته منها الزعاف المسمما",20,"م",2,0],["لو اقليدسٌ وافى لَقَلَّدَ رأيَه","وما طال طاليسٌ مطال الذي أوجد",21,"د",1,0],["لو أقسم الصمصام أنك ربه","ما كان عندي حانثاً بيمينه",22,"ن",2,0],["لو اقتَرحنا على هذا الزَّمانِ فَتىً","كما نَشا خِلتَهُ فوقَ الذي اقتُرِحا",23,"ح",2,0],["لو اقتدى اهله يوما بحزمك لم","يكن به من ربوع بلو تخريب",24,"ب",1,0],["لو أقدر اسيطر على حر الأشواق","ما قلت أحبك عند الأقصى والأدنين",25,"ن",1,0],["لو أقبل الخل وزال الذي","يمنعه بالشوق قبلته",26,"ت",2,0],["لو أقدرُأنْ أصنع لغةً","كالعطرتُعبأُ وتراقُ",27,"ق",1,0],["لو اقدر اسجله باوراق رسميّه","يصير ملكك بتصريفك وتسنيعك !",28,"ك",1,0],["لو اقدر اجمع كل الايام في يوم !","جمعت كل ايامي ف يوم لقياك !",29,"ك",1,1],["لو أقَرُّوا اليومَ ذبحي","لست أخشى لن أفِرَّا",30,"ر",2,0],["لوأقلقوك ِ بقول ٍٍ لا أساس َ له","فلا عليك ِ.. ولا كانوا.. ولا القلق ُ",31,"ق",1,0],["لَو أَقلَعوا عَن نِظامِ الغابِ وَاتَّعَظوا","لَباتَ دَربُ المآسي مَنبَعَ المِنَنِ",32,"ن",1,0]]}