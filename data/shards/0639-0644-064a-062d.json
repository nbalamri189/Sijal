لى حينَ أَعطوهُ الأَمانَ فَعافَه","وَخُيِّرَ فَاِختارَ الرَدى غَيرَ نادِمِ",0,"م",1,0],["عَلى حينَ حاصَرتُ الظَلامَ إِلَيهِمُ","بِأَرعَنَ يَردي في الحَديدِ المُنَظَّمِ",1,"م",1,0],["عَلى حينَ أَعدَتُّ حَيرَتي قَلبَ صاحِبي","فَرُحنا وَسَوطَ العامِرِيِّ مُضيعُ",2,"ع",1,0],["عَلى حينَ سَدَّت ثُلمَةَ العارِ عَنكُمُ","صُدورُ العَوالي وَالمُطَهَّمَةِ الجُردِ",3,"د",1,0],["عَلى حينَ وَلاَني المُقارِبُ صَدَّهُ","وَزادَ عَلى الصَدِّ العَدُوُّ المُباعِدُ",4,"د",1,0],["عَلى حينَ طارَت بِالقُلوبِ مَخافَةً","أُطيرَ فَريصُ المُلكِ مِنها وَأَرعِدا",5,"د",2,0],["عَلى حينَ أُعطيكَ الوَفاءَ مُصَرَّحاً","وَأُصفيكَ مَحضَ الوُدِّ ما عَظُمَ الخَطبُ",6,"ب",1,0],["على حين نابَتْني خُطوبٌ كَثيرةٌ","تَؤودُ بِها الأيّامُ مَتْنِي وأحْمِلُ",7,"ل",1,0],["على حينَ نادَى بالظّعائِنِ أهْلُها","ولمْ يَحذَروا العُقْبى لِما في المُغَيَّبِ",8,"ب",1,0],["على حينَ لمْ يُرسَلْ إِلى الماءِ فارِطٌ","ولا شَدَّ أوْذاماً على السَّجْلِ ناهِزُ",9,"ز",1,0],["على حينِ أخْفى صَوتَهُ كُلُّ نابِحٍ","وبَرَّحَ تَعطيلُ القِداحِ بأيْسارِ",10,"ر",1,0],["على حينِ صاحَتْ بالضَّغائنِ فِتنةٌ","ومَدَّتْ هَوادِيها إِلى القَومِ آجالُ",11,"ل",1,0],["عَلى حَربِ قَومٍ كانَ فينا كِفايَةً","وَلَو أَنَّهُم مِثلُ البِحارِ الزَواخِرِ",12,"ر",1,0],["عَلى حينَ أَصبَحتِ حَسبَ الضَميرِ","وَلَم تَبغِ مِنكِ الأَماني بَدَل",13,"ل",1,0],["عَلى حالَي وِصالٍ وَاِجتِنابٍ","وَفي يَومي دُنُوٍّ وَانتِزاحِ",14,"ح",1,0],["عَلى حين صارَ الرَأسُ مِنّي كَأَنَّما","عَلَت فَوقَهُ نَدّافَةُ العَطَبِ الغَزلا",15,"ل",2,0],["عَلَى حَبِيبٍ فُجِعُنَا","فِيهِ بِرِزْءٍ أَلِيمِ",16,"م",1,0],["عَلى حِميَرِيّاتٍ كَأَنَّ عُيونَها","قِلاتُ الصَفا لَم يَبقَ إِلّا سُمولُها",17,"ل",3,0],["عَلى حِميَرِيّاتٍ كَأَنَّ عُيونَها","ذِمامُ الرَكايا أَنكَزَتها المَواتِحُ",18,"ح",1,0],["عَلى حينِ راهَقتُ الثَلاثينَ وَاِرعَوَت","لِداتي وَكادَ الحِلمُ بِالجَهلِ يَرجَحُ",19,"ح",1,0],["على حين شربُ الوصل غير مصرّد","وصفو الليالي لم يكدر بهجرانِ",20,"ن",1,0],["على حين العدوّ بهم محيط","يُذيقهم المَذَلّة والمَخافه",21,"ف",2,0],["على حينَ ثارت للنوائب ثورةٌ","أتت عن حزازات إلى الدين تنتمي",22,"م",2,0],["على حين الربابة في نواح","يساجلها به العود الرخيم",23,"م",1,0],["عَلى حَفَرِ السيدانِ لاقَيتَ خِزيَةً","وَيَومَ الرَحا لَم يُنقِ ثَوبَكَ غاسِلُه",24,"ل",2,0],["عَلى حينِ أَن وَلّى الشَبابُ لِشَأنِهِ","وَأَصبَحَ بِالشَيبِ المُحيلِ تَعَمَّما",25,"م",2,0],["عَلى حينَ مَن تَلبَث عَلَيهِ ذَنوبُهُ","يَجِد فَقدَها وَفي الذِنابِ تَداثُرُ",26,"ر",1,0],["على حادثة الأيا","م لي نصباً من النصب",27,"ب",1,0],["على حين إن دَنَت لكل قرارة","مذانبُ لا تُجدى على من أسالها",28,"ه",2,1],["عَلى حينِ أَن قالَت لِأَيمَنَ أُمُّهُ","جَبُنتَ وَلَم تَشهَد فَوارِسَ خَيبَرِ",29,"ر",1,1],["على حين أعطاف الشبيبة لدنةٌ","وروضتنا في الملك أو نفسها خضرا",30,"ر",2,0],["على حركات اليمن والأمن والهنا","سكنتَ بدارِ العلم والحلم والقرى",31,"ر",2,1],["على حبِّكم أنفقت عمري جاهداً","فإن رُمت سلواناً فيا ضيعة العمر",32,"ر",1,0],["على حين مسودُّ المفارق حالك","فكيف إذا ضاءَ المشيب بفحمها",33,"م",3,0],["على حين الشبيبة في اقتبالٍ","وفرع الملك زاهي المعطفين",34,"ن",1,0],["على حين لم ينضب من النجم قطرة","ولا فاض للظلماءِ للفجرِ طوفان",35,"ن",1,0],["على حمدِ ابن محمود اسْتقرَّت","عقول العالمين ولا جدالا",36,"ل",2,0],["على حَصْباءَ في أرضٍ هجانٍ","كأن تُرابها ذَفِرُ المَلابِ",37,"ب",1,0],["على حين لا عُذْرى لمُعتذريكُمُ","ولا لكُمُ من حُجة الله مخرجُ",38,"ج",1,0],["على حينََ شمْتُ الخيْرَ من لَمَحَاتِهِ","وآنَسْتُ من أفْعاله آيةَ الرُّشدِ",39,"د",1,0],["على حينَ لم تبعثه إلا طبيعةٌ","تَيَقَّظُ للعلياء والناسُ نُوَّمُ",40,"م",1,0],["على حين لم ألق المصيبة جاهلاً","ولا آهلاً والدَّهرُ دهر قد اعترمْ",41,"م",1,0],["عَلى حينِ أَن تَمَّ فيهِ الثَلا","ثُ حَدٌّ وَجودٌ وَلُبٌّ رَخِيُّ",42,"ي",1,0],["عَلى حينَ ساواهُ الشَبابُ وَقارَبَت","خُطايَ وَخِلتُ الأَرضَ وَعثاً سُهولُها",43,"ل",3,0],["عَلى حينِ لا يَدري أَما قَد مَضى لَها","مِنَ اللَيلِ أَم مُستَأخِرُ اللَيلِ أَعظَمُ",44,"م",1,0],["عَلى حينَ اِستَفاضَ الذِكرُ عَنهُ","وَحينَ أَتى كَما اِندَفَعَ الأَتِيُّ",45,"ي",1,0],["عَلى حينَ يَسلو الناسُ عَن طَلَبِ الصِبا","وَيَنسى اِتِّباعَ الوَصلِ مِنكِ خَليلُ",46,"ل",1,0],["عَلى حينَ وَلّى الأَمرُ عَنّا وَأَسمَحَت","عَصا البَينِ وَاِنبَتَّ الرَجاءُ المُؤَمَّلُ",47,"ل",1,0],["على حين كان الناس في صلواتهم","يؤدونها والملتقى خالياً صفرا",48,"ر",2,0],["على حينَ عرَّى منكِبُ الشرقِ جذبةً","من الصبح واسترخَى عِنانَ الغياهبِ",49,"ب",1,0],["عَلى حينِ اِستَتَمَّ الوَهنُ عَظمي","وَأُعطِيَ فِيَّ ما اِحتَكَمَ المَشيبُ",50,"ب",1,0],["عَلى حِفظِ عَهدِ الحُبِّ في كُلِّ مَوطِنٍ","يُنَسّي المُحِبّينَ اِدِّكارَ الحَبائِبِ",51,"ب",1,0],["عَلى حينَ لا نَقعٌ يُطَوِّحُهُ الصَبا","وَلا أَرضَ تُلفى لِلسَريعِ المُقَطَّرِ",52,"ر",1,0],["عَلى حينَ وَلّى الدَهرُ إِلّا أَقَلَّهُ","وَكادَت بَقايا آخِرِ العَيشِ تَذهَبُ",53,"ب",1,0],["عَلى حينَ لا تُحيا البَناتُ وَإِذ هُمُ","عُكوفٌ عَلى الأَنصابِ حَولَ المُدَوَّرِ",54,"ر",1,0],["عَلى حُرِّ خَدّي مِن يَدَي ثَقَفِيَّةٍ","تَناثَرَ مِن إِنسانِ عَيني نِظامُها",55,"م",3,0],["عَلى حَزَنٍ بَعدَ اللَذَينِ تَتابَعا","لَها وَالمَنايا قاطِعاتُ التَمائِمِ",56,"م",1,0],["عَلى حَدَثٍ لَو أَنَّ سَلمى أَصابَها","بِمِثلِ بَنِيَّ اِرفَضَّ مِنها هِضابُها",57,"ب",3,0],["عَلى حَدِّ مَتنَيها مِنَ الخَلقِ جُدَّةٌ","تَصيرُ إِذا صامَ النَهارُ لِدَولَجِ",58,"ج",1,0],["عَلى حَماةَ فَجُد فيها مَحَلَّتَنا","وَاِقرَ السَلامَ بِها عَنّا أَحِبَّتَنا",59,"ن",2,0],["على حينَ شابتْ لمَّةُ اللَّيل بالسنا","ونَفّرَ عنَّا نَوْمَنَا العودُ بالنقرِ",60,"ر",1,0],["عَلى حِينِ لَم أَركَبْ عِتاقَ صَبابتي","ولا ذُعِرَتْ في سِرْبِهنّ طَرائِدي",61,"د",2,0],["عَلى حينِ لاحَ الشيبُ وَاِستُنكِرَ الصِبا","وَراجَعَني حِلمي وَأَقصَرتُ عَن جَهلي",62,"ل",2,0],["عَلى حينَ لا غَيرَ اِعتِباري خَطابَةٌ","فَتوعى وَلا غَيرَ العَويلِ جَوابُ",63,"ب",1,0],["عَلى حينَ شَطَّت بِالحَبائِبِ نِيَّةٌ","وَحالَت فَيافٍ بَينَنا وَبِلادُ",64,"د",1,0],["عَلى حينَ لاذاكَ الغَمامُ يُظِلُّني","وَلا بَردُ تِلكَ الريحِ يَسري وَيَخلُصُ",65,"ص",1,0],["عَلى حينَ أَرخى الدُجُنُّ فَضلَ لِثامِهِ","عَلى كُلِّ أَقنى مِن أُنوفِ المَخارِمِ",66,"م",1,0],["عَلى حين قَلَّ الناصرون وَأَعرضت","رجالٌ متى تُحمَل عَلى الجِدِّ تَلعبِ",67,"ب",1,0],["عَلى حُوَلاءَ يَطفو السُخدُ فيها","فَراها الشَيذُمانُ عَنِ الجَنينِ",68,"ن",1,0],["عَلى حينَ اِبيِضاضُ الر