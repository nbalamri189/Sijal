{"poems":[[79,"يا قادما وافي بكل نجاح","https://www.aldiwan.net/poem36642.html","الكامل"],[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[75,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[74,"يا ناسيا عهدي ولست بناسي","https://www.aldiwan.net/poem19017.html","الكامل"],[93,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[93,"غلط القائل إنا خالدون","https://www.aldiwan.net/poem62825.html","عموديه"],[46,"قرب الحيا وانهل ذاك البارق","https://www.aldiwan.net/poem30393.html","الكامل"],[107,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[83,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[112,"علم الغايبيني","https://www.poetsgate.com/ViewPoem.aspx?id=8404",""],[121,"المها","https://www.aldiwan.net/poem24062.html","الرمل"],[146,"قد طال للماطل أن يقتضى","https://www.aldiwan.net/poem58443.html","السريع"],[173,"أيدي الحوادث في الأيام والأمم","https://www.aldiwan.net/poem1667.html",""],[202,"أهزز معاطف رائح ومبكر","https://www.aldiwan.net/poem51948.html","الطويل"],[382,"يا غافلا والإثم حل بأرضه","https://www.aldiwan.net/poem59360.html","الكامل"],[415,"إيها بحقك مجد الدين تعلم أن","https://www.aldiwan.net/poem32262.html","البسيط"],[445,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[458,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[520,"أصنيعة الطهر الإمام","https://www.aldiwan.net/poem12265.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122646","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122695","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122583","الكامل"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205359",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120004","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120026","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138138",""],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44831","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49566","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49567","السريع"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49609","السريع"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49605","البسيط"],[1783,"","https://poetry.dctabudhabi.ae/diwan/poem/198778","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76645","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114771","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109277","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121202","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60955","السريع"],[2545,"","https://poetry.dctabudhabi.ae/diwan/poem/73699","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130002","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216555",""],[3861,"","https://poetry.dctabudhabi.ae/diwan/poem/73552","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35626","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73320","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198193","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77687","الكامل"],[4665,"","https://poetry.dctabudhabi.ae/diwan/poem/97755","الرجز"],[4701,"الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=176660",""],[4916,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=177311",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[5465,"إيه أبا إسحاق مُليتها","https://www.poetsgate.com/ViewPoem.aspx?id=98435",""],[5843,"أعطني حريتي اطلق يديه","https://www.poetsgate.com/ViewPoem.aspx?id=51302",""],[5956,"أنعمْ بسيفٍ صارمٍ كأبيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193096",""],[5956,"وُصِفَ البلال الحلو مثل أبيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193440",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""],[5956,"إيهاب صهرٌ رائعٌ معناهُ","https://www.poetsgate.com/ViewPoem.aspx?id=205131",""],[5978,"رسالة إلى المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=191364",""],[6019,"طيفاً أُعانقُ في محرابَكَ الأجلا","https://www.poetsgate.com/ViewPoem.aspx?id=143419",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[5309,"دعني اقبل وجنتيك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573770",""]],"verses":[["إيهٍ أبا عَبْدِ الإلهِ وإنّهُ","لَنِداءُ وُدٍّ في عُلاكَ صُراحِ",0,"ح",1,0],["إِيهٍ أَبَا حَسَنٍ بِأَيِّ عِبَارَةٍ","أُثْنِي عَلَى عُلْيَاكَ عَزَّ المَطْلَبُ",1,"ب",1,0],["إيهِ أَبا الحَزمِ اِهتَبِل غِرَّةً","أَلسِنَةُ الشُكرِ عَلَيها فِصاح",2,"ح",1,0],["إيهاً بَني ذَكوانَ إِن غَلَبَ الأَسى","فَلَكُم إِلى الصَبرِ الجَميلِ مَآلُ",3,"ل",1,0],["إيهاً بلفظك يا عذول ولا تزد","نارَ الأسى بتردّدِ الأنفاس",4,"س",1,0],["إيهٍ أَبا المَأمونِ ذِكرُكَ آبِدٌ","في الأَرضِ مِثلُ الشامِخاتِ الراسِيَه",5,"ي",2,0],["إيهِ أَبناءَ الثَرى نَسلَ القُرود","عَلِّلوا أَنفُسَكُم بِالتُرَّهات",6,"ت",1,0],["إيهٍ أَبا زَيدٍ فَذَرعُكَ واسِعٌ","وَنَداكَ فَيّاحٌ وَمَجدُكَ باسِقُ",7,"ق",1,0],["إيهٍ أبا أيوبَ ما بِكَ رِيبةٌ","إنّ المحبَّ على الحبيبِ لَيسهرُ",8,"ر",1,0],["إيهٍ أبا جهلٍ نُصِرتَ بفارسٍ","يَلقى المنيَّةَ منه أغلبُ شيَّحُ",9,"ح",1,0],["إيهٍ أبا بكرٍ ظَفِرتَ بصفقةٍ","شَتَّى مَغانِمُها لمن يَتأَمَّلُ",10,"ل",1,0],["إيهٍ أبا بكرٍ خَليلُكَ مُطرِقٌ","يأبى وأنتَ بما يُريدُ مُوَكَّلُ",10,"ل",1,0],["اِيهٍ أَبا عَمرٍو وَوَصفُكَ قَد غَدا","عِزّاً تَسَمّى كافِياً لَكَ مَحسَبا",11,"ب",2,0],["إيه أبا الحطاب ما أحلى الهوى","تنظم من نواره وتنثر",12,"ر",1,0],["أيه أببعد وأنكس الحال .. ولابلّه","ينكشف ماكان ... مابينك وبيني",13,"ن",2,0],["آيةٌ أَبْدَعَها اللهُ، وما","أبدعَ الخالقُ لا يُعْطَى ثمن",14,"ن",1,0],["إيهٍ أبا نصرٍ وأنت امرؤٌ","لا يسترِدُّ الدهرُ ما أَقرضا",15,"ض",2,0],["إِيهاً بَني وائِلٍ قَد ماتَ لَيثُكُمُ","فَاِبكُوا عَلَيهِ بِدَمعٍ وَاكِفٍ وَدَمِ",16,"م",1,0],["إيه أبا بكرٍ فما لي لا أرى","تلكَ الشمائلَ بعدُ لم تتغير",17,"ر",1,0],["إيه ابن آدم فِق لأنك إبنُه","والكل يَدخل بعضُه في بعضه",18,"ض",2,0],["إِيهاً بحقِّكَ مجدَ الدّينِ تعلّمُ أَنْ","نَ الصبرَ عنكَ أو السُّلوانَ من خُلُقِي",19,"ق",2,1],["إِيهاً بني المنصورِ أَنْفُسُنا لكُمْ","ونفوسُ مَنْ فِي الشَّرْقِ والغربِ الفِدا",20,"د",2,0],["إيها بني الأرجاس أية نصفة","ترجونها وشروركم مضمونها",21,"ن",3,0],["إيه أبا البركات كن","عن خادمي نعم المحامي",22,"م",2,0],["إيهٍ أبا حَسَنٍ فإن نَسيَ امرُؤٌ","خَيراً ومَكرُمَةً فلستُ بناسي",23,"س",2,0],["إيهٍ أبا خالدٍ فأفعالُك الحُس","نيَ لأآلَ نِظامُها نَسَق",24,"ق",1,0],["إيهِ أبا الوهّاسِ غِثتَ ولم تُشِم","بَرقاً ولم تَبعَث لِغيثِكَ رائدا",25,"د",2,0],["إيه أبا عامر وأنت ال","جواد بالقول لا تجود",26,"د",1,0],["إِيهاً بهاء الدين الذي دعمت","أقواله الصادقات أفعالُه",27,"ل",2,0],["أيها بهاء الدين يا ملكا زكت","منه الخلال وطابت الأعراقُ",28,"ق",1,0],["ايه أبا الشعب أديت الأمانة لم","يخدعك زخرف أقوال ولا كلم",29,"م",1,0],["إِيهٍ أَبا بَكر نِدَاءَ تَعَرُّض","جَمِّع مَحاشَكَ يَا مُجَعجِعُ وَابرُزِ",30,"ز",1,0],["إيه أبراهيم يا بيت القصيد","شاعر الإِحساس والقلب السليم",31,"م",1,0],["إيهٍ أبا العبّاسِ دعوةَ آملٍ","عن صِدْقِ تقليدٍ وَحُسْنِ قياس",32,"س",1,0],["إيهٍ أبا غسحاقَ من صاحبٍ","ليس على خُلَّتِهِ باس",33,"س",1,0],["إيهٍ أبا بكرٍ وهذي المنى","تَفْتَنُّ منها في أفانين",34,"ن",1,0],["إيهٍ أبا قاسمٍ ما لي ظمئتُ وفي","كفّيك ريّيَ أنْ لو شِئْتَ تُرويني",35,"ن",2,0],["ايهٍ أبو ظبي افرحي واستبشري","نلت المرام بزايدِ الأمجادِ",36,"د",1,0],["إيهِ إبليسُ لعنةُ اللَهِ حلت","يا رحيماً خسئتَ من شيطانِ",37,"ن",1,0],["إيه أبا الحسن اختبرت فقل لنا","ماذا تقول اذا استشق عصام",38,"م",1,0],["إيهٍ أبا يحيى وأنتَ عُطاردٌ","إلا تكُنهُ فأنتُما من عُنصُرِ",39,"ر",1,0],["ايها بني وطني اقيموا عزّة","ان الديار تعزّ بالأقوام",40,"م",1,0],["أيهاب من أمسى بغاب غضنفر","وحماه من كيد العدا اساده",41,"د",2,0],["أيهاب من احضى مراد ذخره","هب قد تكاثر بالورى حساده",41,"د",2,0],["إيهٍ أبا يحيى أجب دعوةً","من شاعر جارت عليه السنون",42,"ن",1,0],["إيهٍ أَبا البَحرِ وَالأَيّامُ قاطِعَةٌ","وَالشَّوقُ يَتعَبُ بَينِ النَّفسِ وَالنَّفسِ",43,"س",1,1],["إيه أبا العباس بعدك لم أزل","مهما تدر مشمولة متجهّما",44,"م",2,0],["إيهاب شَنٍّ للتِّبَرّيد","وإيهاب شَنٍّ صابه اعصار",45,"ر",1,0],["إيهٍ أَبا بَحرٍ وَمَن لي أَن أُرى","مِنكُم بِشَاطِي زاخِرٍ مَسجُورِ",46,"ر",1,1],["إِيهِ أَبا الضّوءِ هَل يَقضي اللِّقاءُ لَنا","وَبَينَنا لججٌ وَالمَوج يَلتَطمُ",47,"م",1,1],["إِيهاً بلومِكَ عَن مُكابِدِ لوعةٍ","يأبَى لفرطِ هُيامِه تهويمُهُ",48,"م",2,0],["إيهِ ((ابنَ ثاني))فالبِلادُ بحاجَة ٍ","((لِلاتِّحَادِ))وللتكاتُفِ تَعمُدُ",49,"د",1,0],["إيه أبا عبد الآله","ودوننا مرمى بعيد",50,"د",1,0],["إِيهاً بَني شيبان صفّاً بعد صفّ","مَن يردِ العلياءَ لَم يخشَ التَلَف",51,"ف",1,1],["إيٍهٍ أبا الشهداءِ وابنَ شهيدِهم","وأخا الشهيدِ كأن يومَك أعْصُرُ",52,"ر",1,0],["ايه اب اكتب والشعر بوحه حضاري","يعكس من الواقع المذموم صوره",53,"ر",2,1],["إيهاً بني الفضل زيدوا في مفاخركم","فقد غدوتم لدارات العلى نقطاً",54,"ط",2,0],["إيه أبناءه عزاء على ما","قد أصبتم به من الخسران",55,"ن",1,0],["أيهِ ابنَ أميَ والأيامُ تَشهدُ لي","فتىً، ألوحُ - بوجهِ الشَمسِ- أو كَهِلا",56,"ل",2,0],["إيه أبا إسحاق مُليتها","في صحة منك وعمر طويل",57,"ل",1,1],["أيه أبترك حبك ال / سود الليالي","في رجى ليله تحسسك بغلايه",58,"ا",3,0],["إيهاب يشبه صاحباً متزوجاً","منّا ومعروفاً بحب بنيهِ",59,"ي",2,0],["إيهاب يشبه صاحباً متزوجاً","من بلدةٍ في الشامِ ذاتِ التيهِ",60,"ي",2,0],["إيهاب تحقيق الأماني كلها","لكنْ لماذا تستمر فجائعُهْ؟",61,"ع",2,0],["إيهاب إنسانٌ مهيبٌ ماردٌ","وأشَدُّ ما أهواه فيه تواضعُهْ",61,"ع",2,0],["إيهاب صهرٌ رائع معناهُ","شهمٌ رؤوفٌ دائماً بسواهُ",62,"و",3,1],["إيهاب إنسان يفيد حياتنا","يرضى إله الناس عن تقواهُ",62,"و",3,0],["إيهٍ أبا الطيِّبِ المصقولَ صارمُهُ","كم حاربوكَ فكنت النارَ بالخشبِ",63,"ب",1,0],["إيهٍ أبا الحسنينِ الجُرحُ يَحمِلُني","طيفاً أُعانقُ في محرابَكَ الأجلا",64,"ل",2,0],["إيهٍ (أبا يوسفٍ).. والأمسُ مجمرةٌ","من الرمادِ، أراها اليومَ تلتهبُ",65,"ب",1,0],["إيهٍ (أبا يوسفٍ).. والأمسُ غَلَّقَهُ","كفُّ الغيابِ لكي لا يخرجَ العَتَبُ",65,"ب",1,0],["إيهٍ (أبا يوسفٍ).. لا زَلَّ عن شفتي","اسمٌ على صفحاتِ الريحِ يَنْكَتِبُ",65,"ب",1,0],["أَيَهابُنا أَهلُ العُقولِ","وَنَحنُ في ذُلٍّ لَدَيك",66,"ك",1,0]]}