https://www.aldiwan.net/poem22585.html","الكامل"],[46,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[46,"أما الحياة ففقر لا غنى معه","https://www.aldiwan.net/poem22619.html","البسيط"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85309","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85305","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85302","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85407","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39589","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39564","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16670","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202695","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42550","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142007","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[45,"لَيْلي بِذي الأثْلِ عَنّاني تَطاوُلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32123",""],[92,"راعها منهُ صَمتُه ووجُومُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14597&r=&rc=42",""]],"verses":[["لي لَو عَلِمتُ إِلى ذُرى ال","عَلياءِ آمالٌ طِوالُ",0,"ل",1,0],["لَيلٌ مِنَ الهَمِّ لا يُدعى السَميرُ لَهُ","أَعمى المَطالِعِ لا نَجمٌ وَلا سَحَرُ",1,"ر",1,0],["لَيلي بِبَغداذَ لا أَقَرُّ بِهِ","كَأَنَّني فيهِ ناظِرُ الرَمَدِ",2,"د",1,0],["لَيلٌ تَرامى بِالعَبيرِ نَسيمُهُ","وَالتُربُ تَحفِزُهُ صَباً وَجَنائِبُ",3,"ب",1,0],["ليل لي قلب يحنّ","إلى العلا بأحرّ وجد",4,"د",1,0],["لَيلةٌ ضَمَّ ثَوبُ آمِنَةٍ فِي","جَنْحِهَا الطَّاهِرَ الرَّسُولَ الأَمِينَا",5,"ن",2,0],["ليْلُ أُنْسٍ دَجا وأقْصِرْ بلَيْلٍ","جاذَبَتْ بُرْدَهُ يَمينُ صَباحِ",6,"ح",1,0],["لِيَلتَمِسَن بِلادُكُمُ بِمَجرٍ","يُثيرُ بِكُلِّ بَلقَعَةٍ قَتاما",7,"م",2,0],["لَيلايَ ما أَنا حَيٌّ","يُرجى وَلا أَنا مَيتُ",8,"ت",1,1],["لَيلايَ لا تَحسَبيني","عَلى الحَياةِ بَكَيتُ",8,"ت",1,0],["لَيلى سِراجُ حَياتي","خَبا فَما فيهِ زَيتُ",8,"ت",1,0],["لَيلايَ عيشي وَقَرّي","إِذا الحِمامُ دَعاني",8,"ي",1,0],["لَيلايَ ساعاتُ عُمري","مَعدودَةٌ بِالثَواني",8,"ي",1,0],["لَيلٌ بِأَوَّلِ يَومِ الحَشرِ مُتَّصِلُ","وَمُقلَةٌ أَبداً إِنسانُها خَضِلُ",9,"ل",1,1],["لَيلُهُ هَمٌّ وَغَمٌّ","وَسَقامٌ وَأَنينُ",10,"ن",1,0],["لَيلَتُنا عاطِلَةٌ إِن تَغِب","عَنّا فَزُرنا كَي تُرى حالِيَه",11,"ل",3,0],["لَيْلَى اجْمَعِي النَّاسَ إِلَى محفِلٍ","مُصْغٍ وَكونِي القَيْنَةَ الشَّادِيَهْ",12,"ي",2,1],["لَيْلَى اسْتَوِي فِي التَّخْتِ سُلْطَانَةً","عَلَى قلُوبِ الرّفْقَةِ الصَّاغِيَهْ",12,"ي",2,0],["لَيْلَى أَثِيرِي مِنْ خَبايَا المُنى","كُنوزَ تِلْكَ النَّغْمَةِ الخَافِيَهْ",12,"ي",2,0],["لَيْلَى أَجِيلِي الطَّرْفَ فِيهِ تَنْظُرِي","سِرَّ الْكِيَانِ وَآيَةً الأَزْمَانِ",13,"ن",1,0],["لَيْلُكُمْ مُبْرِقُ الأَسِرَّةِ حَتَّى","كَادَ لا يُشْبِهُ الظَّلامَ الظَّلامُ",14,"م",1,0],["ليل بغيهبه الشخوص تلفّعت","فظللت أحسب كل شخص غولا",15,"ل",2,0],["لئلا يسمعوه فيعتريهم","ضَنى داءَين من شَلَل وفَلج",16,"ج",1,0],["لَيلَتَها كُلَّها حَتّى إِذا حَسَرَت","عَنها النُجومُ وَكادَ الصُبحُ يَنسَفِرُ",17,"ر",1,0],["لَيلَةُ العُرقوبِ لَمّا غامَرَت","جَعفَرٌ تُدعى وَرَهطُ اِبنِ شَكَل",18,"ل",1,0],["ليلة من شبابه لم يبعْها","من ليالي مشيبه بليالي",19,"ل",2,0],["لَيلَك ذا لَيلَك الطَّوِيلَ كَمَا","عالجَ تَبرِيحَ غُلِّهِ الشَّجِبُ",20,"ب",1,0],["لَيلُ وَغىً نُجومُهُ يَلامِقُه","وَأَبيَضٍ كَالصُبحِ لاحَ فاتِقُه",21,"ق",2,0],["ليلُ وصل معطرُ الأرجاء","لاحَ فيه الصباحُ قبلَ المساء",22,"ا",2,1],["ليلايَ كم ليلةٍ بالشعر ليلاء","وليلةٍ قبلها كالثغر غراء",23,"ا",2,1],["ليلي وعاذل مثلي","هذا وذا ما أجنى",24,"ن",2,0],["لي لسانٌ ما زال يُطريك في النث","روفي النظم غيرَ ما مستريحِ",25,"ح",1,1],["لِيَلْجَأ الناسُ إلى ظلِّكم","أدَّى نصيحٌ حقَّ منصوحِ",26,"ح",1,0],["ليلةَ الأربعاء وهو من الأي","يامِ يومٌ ما شئتَ من محمودِ",27,"د",1,0],["لَيل وَصُبحٌ بَينَ إِخوانِ الصَفا","ما كانَ أَجمَلَ لَيلَتي وَنَهار",28,"ر",1,0],["لَيلٌ يَسيرُ عَلى ضَوءِ السُيوفِ بِهِ","وَيَهتَدي بِالصَليلِ الفارِسُ البَطَلُ",29,"ل",1,0],["لَيلَةٌ ما أَمَرَّها","لَيلَةُ اليَأسِ أَلفُ عام",30,"م",1,0],["ليلةٌ أسبلَ الغرامُ عليها","سِحْرَهُ النَّاعمَ الطَّرِيرَ نعيمُهْ",31,"م",2,0],["ليلتنا بيضاء من","خير الليالي الساهره",32,"ر",2,0],["ليلى الجميلة صاحبتني برهة","ثم انتأت عني لغير معاد",33,"د",1,1],["ليل وزوبعة وبحر ثائر","ماذا سيفعل في العباب الزورق",34,"ق",1,0],["ليل وزوبعة وبحر زاخر","تعلوه امواج فهل انا ناج",35,"ج",1,0],["ليلى الحقيقة في حلي ومرتحلي","هي الخيال هي السلوى هي الامل",36,"ل",1,0],["ليلى التي انا منذ حين باسمها","في كل بيت من قصيدي اشهق",37,"ق",1,0],["ليلى اجل ليلى التي اعززتها","هي كل ما انا في حياتي اعشق",37,"ق",1,0],["ليل وزوبعة وبحر ثائر","انا لا أرى ان السفينة تسلم",38,"م",1,0],["ليلة الأمس قد ذهبت وما تذ","هب رؤيا أقصها شر رؤيا",39,"ي",2,1],["لَيلَتُكُم قَدرُها","فَوقَ غَوالي القِيَم",40,"م",1,0],["لَيلي بِمِصرَ وَلَيلُها","بِالغَربِ وَهوَ بِها سَعيد",41,"د",1,0],["لَيلَةٌ لِسَيِّدِنا","في الزَمانِ تُرتَقَبُ",42,"ب",1,0],["لَيلَةٌ عَلَت وَغَلَت","لَيتَ فَجرَها كَذِبُ",42,"ب",1,0],["لئلاَّ يرى الواشونَ قُرَّةَ أَعْيُنٍ","ولا يجدوا فينا مَعاباً لعائبِ",43,"ب",1,0],["لَيلُها صُبحُها مِنَ النارِ وَالإِص","باحُ لَيلٌ مِنَ الدُخانِ تَمامُ",44,"م",1,0],["لَيلَةٌ بِالشَآمِ ثُمَّت بِالأَه","وَزِ يَومَن وَلَيلَةً بِالسَوادِ",45,"د",1,0],["لَيلٌ تَقَضّى وَما أَدرَكتُ مَأرُبَتي","مِنَ اللِقاءِ وَلا قَضَّيتُ أَوطاري",46,"ي",1,0],["لَيلٌ بِذاتِ الطَلحِ أَسدافاتُهُ","أَشهى إِلى المُشتاقِ مِن أَسحارِهِ",47,"ر",2,0],["لِيَلبَخَ أَو طولونَ يُعزى فَقَد حَوَت","عَلى اِثنَينِ زَوجٍ مِنهُما وَعَشيقِ",48,"ق",1,0],["لَيلٌ بِذي الأَثلِ عَنّاني تَطاوُلُهُ","أَرى بِهِ مُقبِلاً قِرناً أُنازِلُهُ",49,"ل",2,1],["لَيلٌ يُصادِفُني وَمُرهَفَةَ الحَشا","ضِدَّينِ أَسهَرُهُ لَها وَتَنامُهُ",50,"م",2,0],["لَيلٌ بِذي الطَلحِ لَم تَثقُل أَواخِرُهُ","أَهوى لِقَلبِيَ مِن لَيلٍ بِعُسفانا",51,"ن",2,0],["لَيلَتي في هُمَانِياءَ جَديرٌ","صُبحُها أَن يَشوقُني عِرفانُه",52,"ن",2,0],["لَيلٌ تَنَعَّمتُ في وَصلِ الفَتاةِ بِهِ","حَتّى تَوَهَّمتُ أَنَّ البَدرَ مِن قِبَلي",53,"ل",2,0],["ليلى أَبعدُكِ أم جفاؤكِ أفدحُ","والموتُ فيكِ أم الجنونُ الأربح",54,"ح",1,1],["ليلى حببتُكِ كالحياةِ وذقت في","ناديكِ كأساً بالأماني تطفحُ",54,"ح",1,0],["ليلَى لقد زارَ البلى","قلبي وطيفُكِ لم يَزُر",55,"ر",1,0],["ليلي العشية مثل لي","لِي في غرامك من قدم",56,"م",1,0],["ليل الحياة وكان لي","لِي في الهواجس أطولا",57,"ل",2,0],["ليلتي أنواء","ونهاري غيوم",58,"م",1,0],["ليلي أطالَكَ بالأحزانِ مُعْقَبَةً","عليّ مَنْ كانَ بالأفراح قد قَصَرَك",59,"ك",1,0],["لَيلٌ حَبَاهُ الصبحُ درهمَ غُرّةٍ","وحجولَ أربعَةٍ بهنّ القوتُ",60,"ت",1,0],["لِيَ لا كانَ مِن هَواكَ خَلاصُ","وَبِجِسمي وَلا بِكَ الإِنتِقاصُ",61,"ص",1,1],["لَيلِيَّةٌ قَد وَقَّرَت هاماتِها","مِن قَبلُ أَصداءُ الفَلاةِ وَبومُها",62,"م",3,0],["لَيلَةَ السَبتِ إِذ نَظَرتُ إِلَيها","نَظرَةً زادَتِ الفُؤادَ جُنونا",63,"ن",2,0],["لَيلى هِيَ البَدرُ ما لي قَطُّ مُصطَبَرٌ","عَنها وَإِن كَثُرَت فيها الأَقاويلُ",64,"ل",1,0],["ليلُ الأباطيلِ ما التفَّتْ غياهِبُهُ","على الحقائِقِ إلا انجابَ وانْكَشَفَا",65,"ف",2,0],["لَيلة الكرمل عودي وَاِسأَلي","عَن مُحب كادَ يودي سَقما",66,"م",2,0],["لَيلة الكرمل عودي وَانظُري","أَيّ قَلب قَطَعته الزَفرات",66,"ت",1,0],["لَيلَةٌ هاجَت جُمادِيَّةٌ","ذاتُ صِرٍّ جِربِياءُ النِسام",67,"م",1,0],["لَيلَةَ صاحوا وَأَغرَوا بي سِراعَهُمُ","بِالعَيكَتَينِ لَدى مَعدى اِبنِ بَرّاقِ",68,"ق",1,0],["لَيلي كَما شِئتَ لَيلٌ لا اِنقِضاءَ لَهُ","بَخَلتَ حَتّى عَلى لَيلي بِإِصباحِ",69,"ح",1,0],["ليلةُ المولدِ الذي كَان للدِّي","نِ سرورٌ بيومِهِ وازْدِهاءُ",70,"ا",2,0],["لَيلَةً سُرَّ بِها إِب","ليسُ مِنكُم بِاِجتِماعِ",71,"ع",1,0],["لَيلي كَما شاءَت فَإِن لَم تَزُر","طالَ وَإِن زارَت فَلَيلي قَصير",72,"ر",1,0],["لَيلَةً تَلبَسُ البَياضَ منَ الشَه","رِ وَأُخرى تُدني جَلابيبَ سودا",73,"د",2,0],["لَيلٌ بَلا نورٍ أَجَنَّ بِمَهمَةٍ","حَبَسَ الأَدِلَّةَ لَيسَ فيهِ مَنارُ",74,"ر",1,0],["لَيلٌ يَجُنُّ وَفي حَنادِسِهِ","قَمَرٌ تَجاوَلَ تَحتَهُ قُمرُ",75,"ر",1,0],["لَيلاً مِنَ الغَيِّ لا أَنوارَ يُطلِعُها","فَالرَكبُ يَخبِطُ في ظَلمائِهِ الغَدَرا",76,"ر",2,0],["ليلتي هذه عُروسٌ من الزّنْ","جِ عليها قلائِدٌ مِن جُمانِ",77,"ن",1,0],["لَيلى قلتني فَما إِن","تُريد مني دنوّا",78,"و",2,0],["لَيلى أَطلِّي عَلى العا","شقين لَيلى أَطلي",79,"ي",1,1],["لَيلى لأَنتِ منَى نفسي وَحاجتها","وأنتَ وحدك يا لَيلى لها الوطر",80,"ر",1,0],["لَيلى بكت ما قد شجاها","حتى تقرح مقلتاها",81,"ا",3,1],["لَيلى أطلي علينا","تَري مثال السَجايا",82,"ي",2,0],["لَيلى وَترباها سعادُ وَزينبٌ","يمرحن فوق مناكب الكثبان",83,"ن",1,0],["لَيلى تغرد أو سعاد وَزينب","تترنمان بأَطيَب الألحان",83,"ن",1,0],["لَيلى تنيلني","أَو أَجتَني أَنا",84,"ن",2,0],["ليلى ارجعي إني شقيّ كئيب","أهتف مفقودَ الهُدَى والقرار",85,"ر",1,0],["ليلةٌ فوق ضِفافِ الرينِ حُلْمُ الشعراءِ","أليالي الشرقِ يا شاعرُ أم عرس السماءِ",86,"ا",2,0],["ليلتي ليلتي جنيت من الآ","ثامِ حتى حملتِ ما لم تطيقي",87,"ق",2,0],["ليلةً غوَّرتْ بها الأنجمُ الز","زهرُ وأضفت سوادفَ الظلماتِ",88,"ت",1,0],["ليلٌ من الأوهام طالَ سهاده","بين الجوى المضني وهجسِ الخاطرِ",89,"ر",1,0],["ليلُنا خمرٌ وأشواقٌ تُغنِّي حولنا","وشراعٌ سابحٌ في النُّور يَرْعى ظِلّنا",90,"ن",2,0],["ليْلي كما قُصّ الغُرابُ خِلالَه","بَرْقٌ يُرَنَّقُ دأبَ نَسْرٍ حائم",91,"م",1,0],["ليلى مناد دعا ليلى فخف له","نشوان في جنبات الصدر عربيد",92,"د",1,0],["ليلى انظروا البيد هل مادت بآهلها","وهل ترنم في المزمار داوود",92,"د",1,0],["ليلى نداء بليلى رن في اذني","سحر لعمرى له في السمع ترديد",92,"د",1,0],["ليلى تردد في سمعي وفي خلدي","كما تردد في الإيك الأغاريد",92,"د",1,0],["ليلى لعلي مجنون يخيل لي","لا الحى نادوا على ليلى ولا نودوا",92,"د",3,0],["ليلى، انتظر قيس، ليلى ما وراء أبي؟","هذا ابن عمك ما في بيتهم نار",93,"ر",1,0],["لَيْلٌ غَيَاهِبُهُ حَيْرَى وأَنْجُمُهُ","حَسْرَى وَساعاتُهُ فِي الطُّولِ كالْحِجَجِ",94,"ج",1,0],["لَيْلاَهُ مَا زَالَتْ عرُوسُ الشِّعْرِ","تَطْلَعُ شَمْساً تَحْتَ جُنْحِ الشَّعْرِ",95,"ر",1,0],["لَيْلاَءَ تُرْسِلُ مِنْ كُ","لِّ جَانِبٍ لأْلاَءَ",96,"ا",2,0],["ليلٌ حريريُّ النسيجِ، كأنهُ","شكوى الهوى وصبابةُ الملتاحِ",97,"ح",1,0],["ليلة ذي دوران هل كانت كما","حدثت أم أخيلة وصور",98,"ر",1,0],["لِيلَةَ جِئناها عَلى مَوعِدٍ","نَسري وَداعي الحُبِّ مَتبوعُ",99,"ع",1,0],["لَيلَةَ تَهليلِهِ بِصَوتٍ","أَرقهُ السقمُ وَالنُحولُ",100,"ل",1,0],["لَيلَةَ المَوتِ دَعاني فَدَعا","لي وَقَد قَبَّلَ رَأسي وَاِعتَنَق",101,"ق",1,0],["ليل أنس دجى وأقصر بليل","جاذبت برده يمين صباح",102,"ح",1,0],["ليلةٌ ألقَتْ اليكم ثِقْلَها !","وليالٍ سَوف تأتيكم \" حَبالى \" !",103,"ل",2,0],["لَيْلي بِذي الأثْلِ عَنّاني تَطاوُلُهُ،","أرَى بِهِ، مُقْبِلاً، قِرْناً أُنازِلُهُ",104,"ل",2,1],["ليلة ٌ أسبلَ الغرامُ عليها","سحرهُ، الناعمة الطريرَ نعيمَهُ",105,"م",2,0]]}