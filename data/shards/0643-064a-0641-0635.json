{"poems":[[55,"كيف صبحت أبا الغمر بها","https://www.aldiwan.net/poem30693.html","الرمل"],[57,"عسكر الحب في فؤادي مقيم","https://www.aldiwan.net/poem26125.html","الخفيف"],[68,"كيف صبري وأنت للعين قره","https://www.aldiwan.net/poem39667.html","الخفيف"],[99,"آه من وجدك بالهاجر آه","https://www.aldiwan.net/poem24926.html","الرمل"],[18,"هل عرفت الغداة من أطلال","https://www.aldiwan.net/poem23933.html","الخفيف"],[89,"أيها المغرور مهلا","https://www.aldiwan.net/poem8341.html","مجزوء الرمل"],[33,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[33,"لَيتَ شِعري هَل أَذوقن","https://www.aldiwan.net/poem42624.html","مجزوء الرمل"],[77,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[52,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[52,"قل لحباء إن تعيشي فموتي","https://www.aldiwan.net/poem64750.html","الخفيف"],[52,"حن قلبي إلى غزال ربيب","https://www.aldiwan.net/poem64826.html","الخفيف"],[52,"منع النوم طارق من حبابه","https://www.aldiwan.net/poem64856.html","الخفيف"],[234,"لما أمت إذ بعدت عند انطلاقك","https://www.aldiwan.net/poem50930.html","الخفيف"],[408,"أأطيع العذول في السلوان","https://www.aldiwan.net/poem46429.html","الخفيف"],[435,"يا حبيبا من بعده قد أبينا","https://www.aldiwan.net/poem41014.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38337","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109415","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87749","السريع"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145880","الرمل"],[3511,"","https://poetry.dctabudhabi.ae/diwan/poem/202632","الخفيف"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103621","الخفيف"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145129","الرمل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40099","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97085","الرمل"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117208","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104528","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33485","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33434","الخفيف"],[4984,"أنكروني","https://www.poetsgate.com/ViewPoem.aspx?id=175744",""],[4984,"الجرْس ( وحي العيد )","https://www.poetsgate.com/ViewPoem.aspx?id=180973",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5324,"شجون الصمت.","https://www.poetsgate.com/ViewPoem.aspx?id=211168",""],[5459,"قصيدة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=208707",""],[5533,"وَطَنِي","https://www.poetsgate.com/ViewPoem.aspx?id=176873",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[6093,"لو تراه سيدي خضر ( المديد)","https://www.poetsgate.com/ViewPoem.aspx?id=176023",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""]],"verses":[["كَيفَ صَبَّحتَ أَبا الغَمرِ بِها","صَعبَةً تَنزو نِزاءَ الجُندُبِ",0,"ب",1,1],["كَيفَ صَبرُ المُحِبِّ يَلذَعُهُ الشَو","قُ وَقَلبُ المُحِبِّ صَبٌّ سَقيمُ",1,"م",1,0],["كَيفَ صَبري وَأنتَ لِلعَينِ قُرَّهُ","وَهيَ ما إِن تَراكَ في العامِ مَرَّه",2,"ر",2,1],["كيف صدَّقنا أضاليلَ الهوى","بِنُهَى طفلٍ وإحساس صَبِي",3,"ي",1,0],["كَيفَ صَبري وَقَد قَتَلتُم كُلَيباً","وَشَقيتُم بِقَتلِهِ في الخَوالي",4,"ل",2,0],["كَيْفَ صَادَفْتَ الأَمَانِي","هَلْ رَأَيْتَ الصَّعْبَ سَهْلا",5,"ل",2,0],["كَيفَ صَبري عَن بَعضِ نَفسي وَهَل يَص","بِرُ عَن بَعضِ نَفسِهِ الإِنسانُ",6,"ن",1,0],["كَيفَ صَبري عَن فَتاةٍ","أَحسَنِ الناسِ لَعوبِ",7,"ب",1,0],["كيفَ صاحبتَهُ بأخلاقِ وَغْدٍ","لا يني في يُبوسَةٍ وجَفوف",8,"ف",1,0],["كَيفَ صَبري فَرداً عَلى غَيرِ نَيلٍ","طالَ هَذا بُخلاً وَطالَ اِنفِرادي",9,"د",2,0],["كَيفَ صَبري وَأَنتِ عِندي كَنَفسي","بِمَكانِ المُباعَدِ المَمقوتِ",10,"ت",1,0],["كَيفَ صَبري عَنِ الغَزالِ وَلَم أَل","قَ شِفاءً مِنَ الغَزالِ الرَبيبِ",11,"ب",1,0],["كَيفَ صَبري عوفيتِ مِمّا أُلاقي","بَينَ نارِ الهَوى وَغَمِّ الصَبابَه",12,"ب",2,0],["كيف صبري وقد غدوتُ بأرضٍ","لا أرى فوقَها سنا إشراقِكْ",13,"ك",1,0],["كيفَ صبري على هوانٍ ومِن","دون مرامي وهِمّتي الفرقدان",14,"ن",1,0],["كيف صبري ولا أرى يوم بيني","يا مليكي للصبر عنك نقولا",15,"ل",2,0],["كَيفَ صَبري وَالهَوى","في الحَشا زادَ اِضطِرام",16,"م",1,0],["كيف صح البيع مع ان الاسا","عنده جسمي غدا مرتهنا",17,"ن",2,0],["كَيفَ صَدفت عَن تَعاليمه","وَقست بِالنور دُجى ظلمتك",18,"ك",1,0],["كيف صار العرب شعبا واحدا","كيف أضحوا سادة الكون العظام",19,"م",1,0],["كيف صَبري وقد بدالي من السَّجْ","ف أَثِيثٌ جَعْدٌ وخَدٌّ أَسيلُ",20,"ل",1,0],["كيف صبري عن الكؤوس اذا ما","عثر الروض في ذيول النسيم",21,"م",1,1],["كيف صرتم تطمئنون إلى","سلطة الأشرار والعيش الزهيد",22,"د",1,0],["كَيفَ صَرَفتَني اِنسلَلت فَلا تَخْ","ش حِمامي ولا تؤثر فزّي",23,"ز",2,0],["كيف صبري والعدا","قد ضيقوا رحب القفار",24,"ر",1,0],["كيف صارت لأناس نعمةً","ثم صارت نقمةً للآخرين",25,"ن",1,0],["كيفَ صبري ومنزلي جرجانُ","والعراقُ البلادُ والأوطانُ",26,"ن",1,1],["كيف صار القرد","إنسانا سويا أنا أدري",27,"ي",1,0],["كَيف صَبري يا مَن إذا ازدادَ تيهاً","أبداً زدتهُ خضوعاً وذلا",28,"ل",2,0],["كيفَ صَبري وليسَ ين","صِفُني مَن يملكا",29,"ك",2,0],["كيف صارت عروش حب ودنيا","كصحارٍ بها الفؤاد كئيب",30,"ب",1,0],["كيف صارت مرابع الأمس قفرا","كيف أضحت زهور عمرك يبسا",31,"س",2,0],["كيف صار النثار شعرا رقيقا","وهو في ساحة البلاغة عاثر",32,"ر",1,0],["كيف صار الحزن ابداعا جليا","كيف صار الحزن صوتا عبقريا",33,"ي",2,1],["كيفَ صارتْ قصيدةُ العُمْرِ رَجْعًا","من حروفٍ عقيمةٍ ومُمِلّه ..؟!",34,"ل",2,0],["كَيْفَ صارَ الحبُّ حِقْداً","وَسْطَ أَشْلاءِ القَتِيْل؟",35,"ل",1,0],["كيف صليتم على جثمانها","وهي للموت حراب في الجفون",36,"ن",1,0],["كيف صبري عن مَحَاسِنِِه","ويْحَ قلبي كيف يصْطَبِرُ",37,"ر",1,0],["كيف صار المولود فينا رَضيعاً","ومتى حُقَّ للرضيع الفِطامُ؟",38,"م",1,0]]}