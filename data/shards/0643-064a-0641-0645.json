109915","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109896","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128882","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104528","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58099","السريع"],[4691,"منعتني ذكر اسمها في قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=123537",""],[4691,"السيد المقيم 2","https://www.poetsgate.com/ViewPoem.aspx?id=175081",""],[4767,"المأساة","https://www.poetsgate.com/ViewPoem.aspx?id=103647",""],[4767,"سوء العاقبة","https://www.poetsgate.com/ViewPoem.aspx?id=179822",""],[4767,"استجارة","https://www.poetsgate.com/ViewPoem.aspx?id=184946",""],[4830,"سليبُ الأضغرَين","https://www.poetsgate.com/ViewPoem.aspx?id=215235",""],[4832,"جود المسعى فكل قد وعى","https://www.poetsgate.com/ViewPoem.aspx?id=166705",""],[4869,"لاتضحك عليا","https://www.poetsgate.com/ViewPoem.aspx?id=151558",""],[4988,"تغتال الشّهيق","https://www.poetsgate.com/ViewPoem.aspx?id=186969",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5204,"أنت يا عمران جعس","https://www.poetsgate.com/ViewPoem.aspx?id=200372",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5409,"يا رواق المجلس الحا","https://www.poetsgate.com/ViewPoem.aspx?id=155291",""],[402,"يا وزيرا ليس الطبيب لأفراد","https://www.poetsgate.com/ViewPoem.aspx?id=35526",""],[5823,"ياصديقي","https://www.poetsgate.com/ViewPoem.aspx?id=59800",""],[5829,"قالت الاعوام صبرا","https://www.poetsgate.com/ViewPoem.aspx?id=214632",""],[5861,"لك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=188263",""],[5899,"شهيدة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=31491",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""],[6127,"ليلى قناع","https://www.poetsgate.com/ViewPoem.aspx?id=188182",""],[563,"قد أحاط الوجود بالأشياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56282&r=&rc=12",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["كَيْفَمَا سِرْنَ فَالطَّرِيقُ عُقُودٌ","نُظِمَتْ مِنْ مَحَاجِرٍ وَمَبَاسِمْ",0,"م",1,0],["كيفما كنتِ لي فلستِ ترى لي","لذَّةً للحياة حتى أراك",1,"ك",1,0],["كيف مرَّتْ تلك المذاقةُ حتَّى","أصبحت بعد طِيبها مسمومه",2,"م",2,0],["كيفما ئشت تفرد بالعلى","نسبا آنا وآنا حسبا",3,"ب",2,0],["كَيْفَمَا جرَّدْتَ أقلا","مَكَ أغنَتْ عن ذُكورِكْ",4,"ك",1,0],["كَيفَ ما فَرَّ مِنَ المَوتِ حَيٌّ","وَهوَ يُدنيهِ إِلَيهِ الفِرارُ",5,"ر",1,0],["كيف من كان له سيفا وغىً","منكما وهو كَمِيٌّ في الجِلاد",6,"د",1,0],["كَيفَ مَن لَم يَثنِهِ حَرَجٌ","دونَ قَتلي عَفَّ عَن سَلبي",7,"ب",2,0],["كَيفَ مُواتاتُ مَن عَلَيهِ","أَهوَنُ مِن ذَرَّةٍ حَياتي",8,"ت",2,0],["كَيْفَ مِصْرُ تَعَافَتْ وَأَضْحَتْ","بِبَنِيهَا مَصْدُوقَةَ التَّعْدَادِ",9,"د",1,0],["كيف ماتت ؟ كما يموت شباب العطر","في صفرة الغصون الخليعة",10,"ع",2,0],["كيف مرّغت وجهك الحرّ في الذّلّ","وأسلست للطغاة العنانا ؟",11,"ن",2,0],["كيفما شاء فليكنْ ، إن فكراً","عبقرياً على المَجرة حائم",12,"م",1,0],["كيفما الدهر سن طيشا غراري","ه لئام الانام فيه لئام",13,"م",1,0],["كَيفَما دارَتِ الزُجاجَةُ دُرنا","يَحسَبُ الجاهِلونَ أَنّا جُنِنّا",14,"ن",2,0],["كيف ما شئت كن فأنت يد","لله عندي وإن غدوت بعديا",15,"د",3,0],["كيف منها لا ابتغي لي نصيباً","وهي لم يخط سهمها احشائي",16,"ا",2,0],["كَيفَما أَلتَفِت أُحِسُّكِ حَولي","أَنتِ مِلءُ المُنى وَمِلءُ هوايا",17,"ا",3,0],["كَيفَما كُتتَ لَيسَ لي عَنكَ بُدٌّ","فَأَبِعني وُدّاً وَإِن شِئتَ صَدّا",18,"د",2,0],["كيف مات المجنون؟ هل سعدت لي","لى؟ سلوا هذه الصحاري الحزينة",19,"ه",1,1],["كيف مات الشَّدو ,بل كيف","سطا البعد بقربي",20,"ب",2,0],["كيف من يبني بيوتا دررا","يهدم اللَه له بيتا حجر",21,"ر",1,0],["كيفما شئتم لكم أن تخنقوا","أو تُجيعوني كما شاءَ الجنون",22,"ن",1,0],["كيفما كانت الخطوب الدَّواهي","أنا قلبٌ ومسمعٌ ولسان",23,"ن",1,0],["كيفما طوَّفتَ بي صدَّك عني","بيديه كالىءٌ منهم ووالي",24,"ل",2,0],["كيفما خالَفتْ عِطاشُ أماني","نا إليه كان النميرَ العِدَّا",25,"د",2,0],["كيفما طارتْ عِيافاتُ الندَى","حَوْلَه طِرنَ يميناً سُنُحا",26,"ح",2,0],["كيفما شئت فاحكمي","أنا من في الحزب انخرط",27,"ط",1,0],["كيفما شئت كنت بي وبغيري","ظاهراً للمشاعر الوهميه",28,"ي",2,0],["كيفما شاء عنه في الكون كنا","واحتراك لنا به وسكون",29,"ن",1,0],["كيفما شئتم عرفتم","ربكم مولى الموالي",30,"ل",2,0],["كيفما شاء فكن في يده","لك إن فرَّق أو إن جمعك",31,"ك",1,0],["كيفما شاء ولا عل","لة لا طبع عياذا",32,"ذ",2,0],["كيف محض الوجوه بالعدم الصر","ف يكون امتزاجه في الثراء",33,"ا",2,0],["كيف مُقامِي بَعدَكمْ سيّدي","والقلْبُ منّي مَعَكُمْ ذو ارتحالْ",34,"ل",1,1],["كيف ما أرعشت أنامل شمر","فأبت أن تطيع فيه إرتعاشاً",35,"ش",2,0],["كَيف ما خَلَّفتَ من","أَهل حَلالٍ أَو حَرام",36,"م",1,0],["كيف ما متُّ إنَّني لجليدٌ","وبه أنشبت يدُ الموت ظفرا",37,"ر",2,0],["كيفَ مدحُ امرىءٍ لكُلِّ ثناءٍ","دونَ علياءَ من علاهُ انتِهاءُ",38,"ا",2,0],["كيف مال عن صبه المغرم","وصار طبعه عليه ثاني",39,"ن",2,0],["كيف ما تلبس ثوب الحزن في","مأتم أحزن أملاكاً ورسلا",40,"ل",2,0],["كيف ما تحزن في شهر به","أصبحت فاطمة الزهراء ثكلى",40,"ل",2,0],["كيف ما تحزن في شهر به","أصبحت آل رسول اللَه قتلى",40,"ل",2,0],["كيف ما تحزن في شهر به","ألبس الاسلام ذلا ليس يبلى",40,"ل",2,0],["كيف ما تحزن في شهر به","رأس خير الخلق في رمح معلى",40,"ل",2,0],["كَيفَ مَرّت تِلكَ اللييلات بيضا","ثُمَ عادَت أَيامُنا وَهِيَ سُود",41,"د",1,0],["كيف مرّتْ على هواك القلوب","فتحيّرت من يكون الحبيب",42,"ب",1,1],["كيف من صحّ اصله عربياً","يجحد العرب والمكارم اصلا",43,"ل",2,0],["كيف من بعده يضيء أليس ال","بدر من نور وجهه مستعيرا",44,"ر",2,0],["كيف من دوننا خُصصت بملك","عمرك الله هل بذلت جهودا",45,"د",2,0],["كيف مدح يفي بحقك مهما","في البلاغات قد تسامى قصيده",46,"د",2,0],["كَيفَما صَرَّفَني الدَه","رُ فَإِنّي مِن رِجالِه",47,"ل",2,0],["كَيْفَ مَا شِئْتُ فَكُونُوا سِادَتي","أَنا في حُبِّى لَكُمْ بَعْضُ الْعَبِيدِ",48,"د",1,0],["كيف من الغرب له إشراقُ","بدر الهدى أرخ فيا أخلاقُ",49,"ق",1,0],["كيف مد الحمام كفا إليه","لم لا عاد في يد جذاء",50,"ا",2,0],["كيف ميّزت من عرفت اطراحاً","لمقامي وسمتني بالبديل",51,"ل",1,0],["كَيفَما كانت فإِنِّي","في تُقاها مُستَرِيبُ",52,"ب",1,0],["كَيفَما مِلتُ شِمتُ حُسنَكَ نحوي","بادياً في تَقَدُّمي وإِيابي",53,"ب",2,0],["كيفما دار مني اللحظ حولي","لا يرى غير خائن أو جبان",54,"ن",1,0],["كَيفَ مَرَّت بي وَلِمْ مَرَت وَما","تَبتَغي مِن ثائرِ الدَمعِ الصَبيبِ",55,"ب",1,0],["كيف من بعد البهى أضحى رميم","في الثرى ما بين تُربٍ وحجر",56,"ر",1,0],["كيف موجات الأثير","اكتشفتها ذي الصناعه",57,"ه",1,0],["كيف مُخيلِيقٌ ضعيفُ القُوَى","يقوَى على حَرٍّ لفي قَاتِلِ",58,"ل",1,0],["كيف مات الهوى وصار َ يُعابُ","نفانا إلى العذاب ِ عذاب ُ",59,"ب",1,1],["كيفما شاءتِ الحبيبةُ أصبحتُ","قريحًا تناوبتْهُ القروح ُ",60,"ح",1,0],["كيف من فوق الثريا قد سما","ضمه الآن من الترب ضريح",61,"ح",1,0],["كيف من أفنى جهاداً عمره","وسعى في دربه لا يستريح",61,"ح",1,0],["كيف من يتبعُ قوماً مثلَهُم لا يتدبر","أترى الظالمَ ينجو أو ترى المؤمنَ يخسر",62,"ر",1,0],["كيف من بعضها تكون النوايا","قاب قوسين دون أي امتناع",63,"ع",1,0],["كيفما شاءَتْ أُساقيها الهوى","مُغرَمٌ اِنّي أُجيدُ اللُّغتَينْ",64,"ن",1,0],["كيف محي من به ضاق الفضا","فرأى الرمس له متسعا",65,"ع",2,0],["كيف من حبك وصانك ..! مايعرف إلا يعَنيلك","ويتوسط شمس حُبك وابغلاتك إيتفيّا",66,"ي",2,0],["كيف من كفّه أواجه مصرعي","خابرٍ من بيننا عهدٍ .. وثيق",67,"ق",1,0],["كيف َ ماض ٍ تغافلت ْ في يديه ِ","بصمات ُ الغرام ِ والسنوات ُ",68,"ت",1,0],["كيف من يتقي سعيداً ومسعا","ه حميد وخصمه مقبوح",69,"ح",1,0],["كيفما كنت فبئس ال","شئ ملبوس ولابس",70,"س",1,0],["كيف من يشعر في غربته","عنك يصفو لك إلا مرغما",71,"م",2,0],["كيف مالت كفةُ المي","زان بالوزن الخفيف",72,"ف",1,0],["كيف مصر وقد تعافت وأضحت","ببنيها مصدوقة التعداد",73,"د",1,0],["كيف مالت بك الليالي؟ فإنّي","تائهٌ منذ حلَّ يوم الوداعِ",74,"ع",1,0],["كيفما يممت شطرا","تكتب المأساة سطرا",75,"ر",2,1],["كيف مرّ الطيف ليلا","في هواك ودلالِكْ",76,"ك",1,0],["كيف مني حين تشدو","يرتجي قلبي الفرارا",77,"ر",2,0],["كَيفَ مَزَّقتِ بِالخِيانَةِ قَلبًا","كانَ يَهواكِ؟ حَيثُ أَصبَحَ عِبرَةْ",78,"ر",2,0],["كيّفْ مدادك للاتي ولا تنمِ","لا تحرمِ الحرفَ ما يرجوه من أممِ",79,"م",1,1],["كيف محض الودود بالعدم الصرف","يكون امتزاجه في الثراء",80,"ا",2,0],["كَيْفَمَا كُنْتُمُو يُوَلَّى عَليْكُمْ","لَيْسَ غَيْرَ الشُّعُوبِ مِنْ مَسْؤُولِ",81,"ل",1,0]]}