ى هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[556,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[563,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[563,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86682","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87012","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48795","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77476","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120083","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119932","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56335","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56096","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56282","الطويل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130250","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79861","الكامل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124297","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132253","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52066","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108462","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108423","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109401","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139817",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100372","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74210","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130048","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67992","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112409","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89210","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61285","الكامل"],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178027","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36800","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85012","المديد"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131119",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130866","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83146","الرمل"],[5111,"طَالَ هَجْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=212271",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5136,"من عذيري مولاي منك فقد غا","https://www.poetsgate.com/ViewPoem.aspx?id=121657",""],[5198,"الممكن المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=135392",""],[5213,"انشقاني من ربع مية طيبا","https://www.poetsgate.com/ViewPoem.aspx?id=170409",""],[5246,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=187037",""],[5282,"بقايا من رحيق","https://www.poetsgate.com/ViewPoem.aspx?id=214471",""],[5302,"هام قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201901",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5461,"يا قديم الغوص","https://www.poetsgate.com/ViewPoem.aspx?id=5306",""],[5587,"جاني كلام","https://www.poetsgate.com/ViewPoem.aspx?id=197890",""],[5732,"قل لي هلا","https://www.poetsgate.com/ViewPoem.aspx?id=177874",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[6115,"لاتلومون الذي قال فيه الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=180485",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""]],"verses":[["وَشَجيجٍ طَمَّ الزَمانُ نَواصي","هِ كَما شَعَّثَ الوَليدُ السِواكا",0,"ك",2,0],["وَشَجوٌ لِنَفسِيَ لم أنسَهُ","بِمُعتَرَكِ الطَّفِّ فالمِجنَبِ",1,"ب",1,0],["وشجاعةٍ تنضي السيوف صقيلةً","وإلى المعامع ربها يشكو الصدى",2,"د",2,0],["وشجٍ أماويتُ الشجى في صوته","لأياً تنالُ مسامعَ المتوجِّس",3,"س",1,0],["وشجَّعنا على التَّوديع شوقٌ","تحرَّق بين أثناء الضلوعِ",4,"ع",1,0],["وَشُجونٌ كُلَّما جَنَّ المَساء","قَطَعَت بَينَ جُفوني وَالمَنام",5,"م",1,0],["وشجاني بالليل في كل بيت","من حماماته عليك الهديل",6,"ل",1,0],["وَشُجاعُ النَفسِ مِنهُم في الكُروب","كَشُجاعِ القَلبِ في وَقتِ الحُروب",7,"ب",1,0],["وَشَجاعَةٌ أَغناهُ عَنها ذِكرُها","وَنَهى الجَبانَ حَديثُها أَن يَجبُنا",8,"ن",2,0],["وَشَجَتكَ بِالتَفريقِ ظُعنُ فَريقِها","فَظَعَنتَ إِلّا الشَجوَ في الأَظعانِ",9,"ن",1,0],["وشجيُّ القلبِ يشدو للذكر","دَامِيَ الألحانِ مجروحَ الوتر",10,"ر",1,0],["وشَجاهُ أن يرى صَمْصَامهُ","غيرَ وضّاحِ السَّنا في المأزِق",11,"ق",1,0],["وَشَجَّجتِها حَمراءَ غَيرَ مُبَيَّنَةٍ","وَضحاً يُرى في ناصِعٍ أَدمَيتِها",12,"ت",3,0],["وشجا البحيرةَ واستخفَّ ضفافها","لحنٌ كفائرِ موجها المترامي",13,"م",2,0],["وَشَجَتْ بهَا أَعْرَاقُ مَجدٍ غَابرٍ","وَتَوَثَّقتْ أَعْرَاقُ مَجْدٍ حاضرِ",14,"ر",1,0],["وَشَجَتْ مِسْمَعِي أَفَانِينُ شَدُوٍ","مِنْ تَغَنِّي هَزَارِكِ الغِرِّيدِ",15,"د",1,0],["وَشَجِيٌّ أَنْ يَمُرَّ بِالْكَوْكَبِ السَّا","طِعِ ظِلٌّ فَيَبْتَلِي بِالْمُحَاقِ",16,"ق",1,0],["وَشَجَاعَةٍ فِي القَلْبِ","تُخْفِيها الْعُذُوبَةُ فِي النَّوَاظِرْ",17,"ر",1,0],["وَشَجَاهُ مِنْ أُمِّ الغَرِيقِ تَفَجُّعٌ","مُتَدَارِكٌ مِنْ مَوْضِعٍ مُتَقَارِبِ",18,"ب",1,0],["وشجى الرياض فقطّعت أطواقها","وبكت ففارق زهرها الأعوادا",19,"د",2,0],["وَشج الفَرعُ الكَريم فَوَلّى","وَشَجا القَلبَ فَوَيلُ الشَجِيِّ",20,"ي",1,0],["وَشَجَاعَةٌ فِي اللّه يَكْلؤُها الحِجَا","وَالْحَزْمُ فِي الإِدْبَارِ وَالإِقْبَال",21,"ل",1,0],["وشُجاعٌ في رأيه، ليس يَدْرِي","جيمَ جُبْنٍ، أو بَاءَه، أو نُونَه",22,"ن",2,0],["وشجونا حمرا وشوقا رخيصا","ونداء وثرثرات كثيره",23,"ر",2,0],["وشجون تهفو بقلبي إليها","وظنون تقصي مرادي وتدني",24,"ن",2,0],["وشجبت الرفقَ والرحمةَ من","نفر ليسوا بحق رُحَمَاء",25,"ا",2,0],["وشجبت أنّ الحكم في قاموسِهِمْ","سوطٌ يشدُّ وشهوة وعُرام",26,"م",1,0],["وِشجَّعتُ ما أقوى يراعةَ كاتبٍ","يُزيحُ بها عن كلِّ ذي عورةٍ سِترا",27,"ر",2,0],["وَشَجَتْكَ بالتَّفرِيق ظُغْنُ فَريقِهَا","فَظَعَنْتَ ، إِلاَّ الشَّجْوَ ، في الأَظعَانِ",28,"ن",1,0],["وشَجَّعتُ نَهْدَيْكِ فاسْتَكْبَرا","على اللهِ حتَّى فلم يَسْجُدا",29,"د",2,0],["وشجت بلاد المسلمين لموته","بكل فجاج الارض ضجة فاقد",30,"د",1,0],["وشجاعٌ علّم الفرسان في","الحرب تصريفَ العوالِي والأَسَلْ",31,"ل",1,0],["وشجاعٌ يخوضُ بحر المنايا","لم تَهِلْهُ من الردى غمراتُه",32,"ت",2,0],["وَشُجعانُها داموا عَبيداً له بها","مَساحيهمُ أنستهمُ البيضَ والسمرا",33,"ر",2,0],["وشجاك جسمى ناحلاً","وكأنه الطيف الطروق",34,"ق",1,0],["وشجعهم أن المخافر تُبتنى","خلافاً لميثاق العقير وتنصب",35,"ب",1,0],["وشجاعة بسكينة وشهامة","وإغاثة وحماية ووفاءُ",36,"ا",2,0],["وشجره مثمرة بين","شجرات هشيمات",37,"ت",1,0],["وَشجاعَةٌ لَمّا اِستَمَرَّ مَريرُها","لَم يُرضَ عَنتَرَةٌ وَلا شَدّاد",38,"د",1,0],["وشجاعةٍ علويّةٍ قد أَخْرسَتْ","ليتَ الشّرى في غابهِ أنْ يَزأرا",39,"ر",2,0],["وشجت بالفعل لتشبيهه","وهكذا كل كمال حويت",40,"ت",1,0],["وشجاها الأسى فقال رفيقي","إنَّ في هذه المطيِّ جنونا",41,"ن",2,0],["وشجتنا بنوحها حين ناحت","فكأَنَّ الورقاء إذ ذاك ثكلى",42,"ل",2,0],["وشجتني والصبّ بالبين يشجي","أنيق في ظعون ظمياء تحدى",43,"د",2,0],["وشجرتان على شطيه قد ثبتا","تقابلا مثل معشوق ومن عشقا",44,"ق",2,0],["وشَجَاهُ رَسْمُ عاطِلَةٍ","قَلَّدَتْها عَيْنُه وشَجَا",45,"ج",2,0],["وشجّت بماء الحسن منه فأظهرت","أشقّها في خدّه المتورّد",46,"د",1,0],["وشجوه كنعيق","ولا نعيق الغراب",47,"ب",1,0],["وشجيرات زهت بقربها","كاسيات حسنت للأعين",48,"ن",1,0],["وشجاك لحن العند","ليب ونغمة القُمريّ أشجى",49,"ج",2,0],["وشَجْرةً تحْتَها الصَّبيُّ","والجدُّ ووابلاً يَصُوبُ",50,"ب",1,0],["وَشجاعاً يَفرِي المرائر ما كل","لَ شُجاعٍ يفري الطُّلى والهَاما",51,"م",2,0],["وَشَجاهُمُ أنّي فَضَلتُهُمُ","وَعلى الفَضائِلِ يُحسَدُ النَّدْبُ",52,"ب",1,0],["وشجانا رقص بانات النقى","حين غنَّتها الصَبا والديم",53,"م",1,0],["وشج بين صبوة وغرام","واشتياق وحرقة وارتعاد",54,"د",1,0],["وَشَجِّعه في التَعليم مِنكَ برفعة","عَلى وَفق رأيٍ مِن عُلاك نَجيح",55,"ح",1,0],["وَشَجاعة وَسَعادة بِسياسة","وَصِيانة وَكَذا حَميد خِصال",56,"ل",1,0],["وشجاني اطلاعه لكم قب","ل ملاقاتكم على كل أمر",57,"ر",1,0],["وشجى ما أزال","أغبق منه وأصبحُ",58,"ح",1,0],["وَشجَّجَت أَعضاءَها فَاِمتَدَت","وَشَدَّدت أَعصابَها فَاِشتَدَّت",59,"ت",1,0],["وشج إذا غنَّت حما","م حنَّ أو عنَّت بروق",60,"ق",1,0],["وشجاعة تنسيك زي","دا في الوغى وتريك عمره",61,"ر",2,0],["وشجوّي في نموّ إنما","ركن حيلي والقوى في خسسِ",62,"س",1,0],["وشجت فنابت عن هزارٍ صادحٍ","وترنمت شدواً ففاقت معبدا",63,"د",2,0],["وشجو صدى الأمواه من فوقها عنى","لنا أنها ألواح موسى إلى النظرْ",64,"ر",1,0],["وشَجَتْ أميَّةُ بيننَا أرحامَها","فسَلكْنَ بين مُصَوِّبٍ ومُصعِّدِ",65,"د",1,0],["وشجا الطير المعنّى وانتحب","يندب المرعة ويبكي النّعمَا",66,"م",2,0],["وشجت قديماً سارياتُ عروقها","حيث المجرَّةُ نهرُها يتدفَّق",67,"ق",1,0],["وشجيت الا أنني مستسلم","راض بما فعل الجليل موحّد",68,"د",1,0],["وشجّوا بكاء بالدماء دموعكم","وإلا بكاء ما تالمت من ذنر",69,"ر",1,0],["وَشَجَتْ أمَيَّةَ في بَنيِهِ وَعَبَّسَتْ","لأولِي النَّباهَة مِنْ بَنِي العَباسِ",70,"س",1,0],["وَشَجاعَةٌ لا عامِرٌ كَمُلَت","فِيهِ كَما كَمُلَت وَلا عَمرُو",71,"ر",2,0],["وشجانا نواح آل طراد","والأسى ظل كاسفاً كل بال",72,"ل",1,0],["وشجاني نغمُ العود الذي","بات ينعي لوعة المكتئب",73,"ب",1,0],["وشجاع قدَّ السلاسلَ عزماً","لم تقدهُ يد القضاءِ بشعره",74,"ر",2,0],["وَشَجَاعَةُ الحُكَّامِ والعلماءِ زه","دٌ في الثَّنَا مِن كلِّ ذِي بُطلاَنِ",75,"ن",1,0],["وشجو علم الورقاء نوحاً","ووجد في الضلوع له سعير",76,"ر",1,0],["وشجوني بدواعي لوعتي","قلبت قلبي على الجنبين",77,"ن",1,0],["وشجى لو انَّ أصاب اوج سمائها","لهوت كواكبها وهنَّ افول",78,"ل",1,0],["وشجاني من العواميد ست","واقفات صفا يروع نظاما",79,"م",2,0],["وشجاني منهن هيفاء خود","سامها الحظ دونهن اهتضاما",79,"م",2,0],["وشجتني فيها مسارح لهو","وفنون تنوّر الافهاما",79,"م",2,0],["وَشَجاعة تَعنو الكماة لِبَأسها","وَتروغ الضرغام تَحتَ عَرينه",80,"ن",2,0],["وشجّعوه على الأعمالِ يَطلُبها","يرمي بِسهمَيهِ إن ذاك الغريب رَمى",81,"م",2,0],["وشجوتَني طرباً وَلَيْ","سَ يُمِيلني شَدْوُ الغِنا",82,"ن",2,0],["وشُجَيرَاتُ الرّوابي تَنثني","طَرَباً بالنسمَاتِ النّافحَات",83,"ت",1,0],["وشجاعة وهبت بها أسد الشرى","رغماً بأنف عدوه الخناس",84,"س",1,0],["وَشَجت إِلى عِرق النَبيِّ عُروقهُ","فَغدا وَحبلُ فَخارِه مُستحصِدُ",85,"د",1,0],["وشج شمولاً بالمزاج فطيرت","كألسنة الحيات خافت من القتل",86,"ل",1,0],["وَشَجاهُ مَسجور الفُؤادِ إِلى الحِمى","وُرقٌ سَواجِعُ هِجن مِن أَشجانِهِ",87,"ن",2,0],["وَشَجاه مَسجور الفُؤا","د بعيدَ عَهدٍ بِالوَطَن",88,"ن",1,0],["وَشَجا قَلبي بِنَغمَتِهِ","في تَغنيمِهِ وَنَقرَتِهِ",89,"ه",1,0],["وشجو تعلم ألحانه","هزار على بانة هاتف",90,"ف",1,0],["وَشَجَا فاريسَ زاَد الشَّجنَا","هكذا زَفسُ عَلَينا قَدَّرا",91,"ر",2,0],["وشجن بادٍ على الأفندة","ما أنت إلا يا فتى مظلوم",92,"م",1,0],["وشجا المشعر ذا الرزء الذي","ما صفا من بعده عيش الصفا",93,"ا",1,0],["وشجوا له وجها وسبوه عنوة","وبعض ثناياه تناهت إلى الكسر",94,"ر",1,0],["وَشُجونٌ طالَما أَخفَيتُها","نَفَذ العُودُ إِلَيها فَحَكاها",95,"ا",3,0],["وَشُجُونًا بَيْنَ آهٍ","بَيْن أف يَتَرَعّدْ",96,"د",1,0],["وشجاني افتخار صعد لما","صاغرت خدها على صنعاء",97,"ا",2,0],["وشجا قلبي الفراق فناجيتني","أن الفراق في الأحلام",98,"م",1,0],["وش جنينا من الواحة وطلع النخيل","ووش حصدنا من النرجس وعود الاراك",99,"ك",1,0],["وشجوني بالفضل طفلا وكهلا","ألبسوني الكمال برداً قشيبا",100,"ب",2,0],["وشجعني لما عرفتك سيدي","غفورا كريما راحما متفضلا",101,"ل",2,0],["وشُجَيرةُ الحُبِ التي غَنى لهَا","عُمراً طويلاً لم تَعُدْ بِجِنانهِ",102,"ن",2,0],["وشجاه شوق غادته","وعلى تذكارها صدحا",103,"ح",2,0],["وشجى على هولِ المصاب ِهَزَارُ","يشكو لفرْحٍ راحَ وهْو نَزَارُ",104,"ر",1,1],["وشجى الأردن المصاب كان قد","دمر المعتدي له عمانه",105,"ن",2,0],["وش جمع حلوه على مره سوا","هي حلاة الحب في الكاس المرير",106,"ر",1,0],["وَشْ جَابِكْ لِيَ يَا لَبْنَيَة","بْقَى جُرْحِي ضْرِيرْ مَا نَبْرَاش",107,"ش",1,0],["وش جابني لولا ان هذي مقادير","الا انها كتبت بلوحك ولوحي",108,"ح",2,0],["وشجا التقى فبكا التقى حزنا على","من كان شد من التقى بنطاق",109,"ق",1,0],["وشُجيْرة الليمون مُذْوًى زهرها","مِنْ روحها سَلبَ الشّذا إغمامُ",110,"م",1,0],["وشجعان يام والقحاطين ومطير","خيرة الفرسان عن يمين وشمالك",111,"ك",1,0],["وش جمال الكون لاقالوجمال","ماحسبت اللي تقول اللايمين",112,"ن",1,0],["وشجرة الحنظل أبد لاتشم ولاتذاق","والملجلج يقضى العمر في لجاجته",113,"ت",2,0],["وشجاعةٍ باسم القتيلِ مشيرةٍ","للقاتلين بغيرِما أسماءِ",114,"ا",2,0]]}