etsgate.com/ViewPoem.aspx?id=215210",""],[4119,"أبدى السلو خديعة للائم","https://www.poetsgate.com/ViewPoem.aspx?id=16040",""],[5106,".. إِنَّ النِّفْطَ قَدْ جَبُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=151384",""],[5106,"أَشرِعَة الجَمَال ..","https://www.poetsgate.com/ViewPoem.aspx?id=151426",""],[4478,"أعيني جودا بالدموع وأسعدا","https://www.poetsgate.com/ViewPoem.aspx?id=15136",""],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5302,"كن لي رفيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=200552",""],[5376,"تكالبتْ أممٌ والمجْدُ في حَلَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=188444",""],[5431,"مهما فعلت وكيفما ...","https://www.poetsgate.com/ViewPoem.aspx?id=198603",""],[709,"رنا فسلَّ على العشاق أحوره","https://www.poetsgate.com/ViewPoem.aspx?id=2883",""],[5536,"أعطني الناي َ وغنيّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=23194",""],[5538,"ترفع عن وضيع النفس تسلم","https://www.poetsgate.com/ViewPoem.aspx?id=142622",""],[4480,"لَعَمْرِي وما دَهْرِي بِتَأْبِينِ iiهَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18228",""],[5616,"اعتراف","https://www.poetsgate.com/ViewPoem.aspx?id=205767",""],[5660,"ما بَينَ ثائِرَةِ الرِّياحِ السَجسَجِ","https://www.poetsgate.com/ViewPoem.aspx?id=27724",""],[5881,"قسمت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=183797",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5956,"كل ما فيها مثيرُ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182656",""],[5956,"تقول لي: ليس في الحب حرام","https://www.poetsgate.com/ViewPoem.aspx?id=182679",""],[5956,"نعجةٌ رفرفتْ","https://www.poetsgate.com/ViewPoem.aspx?id=183393",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""]],"verses":[["وَأَرَمَّ مِثلَ الصِلِّ يَن","تَظِرُ الَّتي تَشفي النَسيسا",0,"س",2,0],["وَأَرمي إِلى أَمرٍ أَظُنُّكَ بابَهُ","أَلا إِنَّ بَعضَ الظَنِّ غَيرُ مُكَذَّبِ",1,"ب",1,0],["وَاِرمِ بي عَن يَدَيكَ إِحدى الطَريقَي","نِ فَما الشِعرُ جُلَّ مالي وَكَسبي",2,"ب",2,0],["وَأَرمَلَةٍ تَسعى بِشُعثٍ كَأَنَّها","وَإِيّاهُمُ رَبداءُ حَثَّت رِئالَها",3,"ل",3,0],["وَاِرمِ بِالسَبِّ نَجلَ شيثٍ وَلا تَخ","شَ تَجِدهُ تَيساً بِقَرنٍ عَظيمِ",4,"م",1,0],["وَأَرمَلَةٍ هَلكى ضعافٍ وَصَلتَها","وَأَسرى عُناةٍ قَد فَكَكتَ رِقَابَها",5,"ب",3,0],["وَأَرمي بِعَينَيَّ النُجومَ كَأّنَّني","عَلى الرَحل طاوٍ مِن عِتاقِ الأَجادِلِذ",6,"ل",2,0],["وَأَرمي بِها الأَهوالَ حَتّى أَحَلتُها","وَسَوَّيتُها بِالمُحرِثاتِ الحَدابِرِ",7,"ر",1,0],["وأُرمى وأرمي بالعَدَاوَةِ أهلَها","وإنّي لأوذَى فِيهُم وأُؤَنَّبُ",8,"ب",1,0],["وَأَرماحُنا في كُلِّ لَبَّةِ فارِسٍ","تُثَقِّبُ تَثقيبَ الجُمانِ وَتَنظِمُ",9,"م",1,0],["وارمد عينيّ التسهّد والبكى","وحسبك أني لا أرى بهجة الشمس",10,"س",1,0],["وارمِ المهماتِ بي في كلِّ حادثةٍ","ترتاعُ منها أسودُ الغابِ والأسلِ",11,"ل",1,0],["وارْمِ للَّيلِ والضَّبابِ بعيداً","فَنَّكَ العابسَ الكثيرَ وُجومُهْ",12,"م",2,0],["وارم الصفوفَ بمثلهنَّ وشُنَّها","شعواءَ يُنسَى عندَها صِفِّينُ",13,"ن",1,0],["وأرمي بها جَوْزَ الفلاةِ كأنني","أرنِّحُ منها أعقُبَاً في الشكائمِ",14,"م",1,0],["وَأَرمَلَةٍ تَدعو بِلالاً فَقيرَةٍ","وَمالُ بِلالٍ حينَ يُنفِضُ مالُها",15,"ل",3,0],["وَاِرمِ الكَريهَةَ بِالكَريمَةِ وَاِرتَشِف","صَفوَ الحَياةِ مِنَ العَجاجِ الأَكدَرِ",16,"ر",1,0],["وَأَرمي بِنَفسي في مَآزِقَ جَمَّةٍ","أُغيثُ أولي البَلوى وَأَشفي ذَوي العَمى",17,"م",2,0],["وَارمِ العِدا بِبَشائِرٍ عَن أَرمِيا","إذ كَفَّ نَبلُ كِنانِهِ مَتبُولا",18,"ل",2,0],["وارْمِ الخُطُوبَ بمِثْلِهَا","عَزْماً فأَنْتَ لها مُسَاهِم",19,"م",1,0],["وارمق المورقات خضراً جلاه","ن من الليل عارض هتان",20,"ن",1,0],["وَأَرمَلَةٍ وَمُعَتَّرٍ مُسَيفٍ","عَديم المال عَجزةِ أُمِّ صَخرِ",21,"ر",1,0],["وارمِ من عادَانا وخالفنا في","أمرِنا بالقِلَى ومن مَال شَقّا",22,"ق",2,0],["وارم العدى بسهامٍ ما رمْيتَ بها","إِلا أصبْتَ وقال الَمجدُ لا شَللُ",23,"ل",1,0],["وَأَرمِى الَّذِى يَرمُون عَن قَوسِ بِغضَةٍ","وَلَيسَ عَلى مَولاَىَ حَدِّى وَلاَ جِدِّى",24,"د",2,0],["وَاِرم أَعاديها بكلّ عارِ","أَلحِق بِهم يا ربّ كلّ خسرِ",25,"ر",1,0],["وأرمض روحك الشوق","وليس من النوى بدّ",26,"د",1,0],["وارمي له بعضَ ما يُرَجّى","فالحُبُّ أرضاهُ بِاليَسير",27,"ر",1,0],["وارم جمار الغير في السير إن","تكن لوصل الغيد لاوي العنان",28,"ن",1,0],["وارم الزَمان بعظم جاه محمد","مَهما رمتك من الزمان عظائمه",29,"م",2,0],["وَأرمَدتُ منهم أعيُناً قَد تَطامَحَت","بعثير سبقي سابقاً كلَّ مَن أَجرى",30,"ر",2,0],["وارْمِ بطرْفٍ من بعيدٍ فَمن","دونِ صِفاحِ البيِضِ بِيضٌ صِفاح",31,"ح",1,0],["وارموا كلام العاذلين وراءكم","إن كثروا في عذلهم أو قللوا",32,"ل",3,0],["وارم لعقبتكح يوم النحر للإنحلال","وبت ليالي منى بهامناك تنال",33,"ل",1,0],["وارم لعقبتك يوم النحر للإنحلال","وبت ليالي منى بها مناك تنال",33,"ل",1,0],["وارم الجمار الثلاث بعد ما الظل زال","وطف وداعا وهذا اجعله ختم الخصال",33,"ل",1,0],["وارم الخلائق كلهم أجمعين","وصف قلبك منهم صف",34,"ف",1,0],["وارم الخلايق عربهم والهنود","جميعهم والد ومولود",35,"د",1,0],["وأرمِي فِجاجَ الأرضِ نحوَ بِلادكم","بطرفٍ كليلٍ دمعُه بَعدَكم قَطرُ",36,"ر",1,0],["وارم بها عرضَ الفلا فإنها","ما خُلقتْ إلا رُجوماً للفلا",37,"ل",2,0],["وارمي الخرق بالقلص النواجي","تجوب الأرض موحشةَ النواحي",38,"ح",2,0],["وارم بي من تشاء تلقَ ربيطَ","الجأش سامي طود النَّهي مغوارا",39,"ر",2,0],["واِرْمِ العِدا بجمارِ النّبْلِ واِسْعَ إلى","مِنى وغىً يرهبُ الضرغامَ منحَرُهُ",40,"ر",2,0],["وارم بأيدي العيس كل قفرة","تضل فيها لحظات القافر",41,"ر",1,0],["وأرمي بنَفسي في صفُوفِ أراذِلٍ","ولستُ لهم شكلاً وليسوا على شكلِي",42,"ل",2,0],["وَأَرمي بِطَرفي إِذا ما نَظَرتُ","كَأَنَّ عَلى الطَرفِ مِنّي غَماما",43,"م",2,0],["وَأَرمَلَةٍ يَعتَريها النَحيبُ","إِذا نامَتِ الأَعيُنُ الناعِمَه",44,"م",2,0],["وَاِرمُق أَبا الفَتحِ الأَعَزَّ مُحَمَّداً","أَخنى عَلى جُرثومَةِ الرومانِ",45,"ن",1,0],["وَاِرمُق سَناوَتُهُ وَاِنظُر سَماوَتُهُ","تَرى دَرارِيِّها تَزدانُ بِالدُرَرِ",46,"ر",1,0],["وَارم النِبال إِلى مقاتل ضَيغم","لَم يَكتَرث بِالصَعدة السَمراء",47,"ا",2,0],["وَاِرمِ بِعَينَيكَ إِلى البَهارِ","فَإِنَّهُ مِن أَحسَنِ الأَنوارِ",48,"ر",1,0],["وارمِ المشارق باسمه فليفتحن","ما بين مصر إلى بلاد الرُخَّج",49,"ج",1,0],["وارم دعوى الغريم بالحجة البي","ضاءِ تمضي كصارم أو شهاب",50,"ب",1,0],["وَأَرمي الَّذي يَرمونَ عَن قَوسِ بَغضَةٍ","وَلَيسَ عَلى مَولايَ حَدّي وَلا عَهدي",51,"د",2,0],["وَاِرم إِليَّ بِالَّذي تُسَهِّلُه","نَجمعه سَويّة وَنَأكُلُه",52,"ه",1,0],["وَارم إِلى البَحر لِصَيدي شَبَكه","حَتّى تَقول الناس صادَ سَمَكَه",53,"ه",1,0],["وَأَرمي بِنَفسي عَلى ساعِدَيك","فَتَرفُقَ بِالخَصَر لا يَنكَسِرْ",54,"ر",1,0],["وأرملة جنت بفرط بكائها","لقلة حاميها إلى الله تضرع",55,"ع",1,0],["وأرمي ف ذراها من دموعي","جمارا لا تقايس بالجمار",56,"ر",1,0],["وارم القيود وبادر بالمتاب إلى","مولاك واعكف على الاذكار والقرب",57,"ب",1,0],["وارم وجلله برحمتك التي","وسعت جميع العالمين وسؤدد",58,"د",1,0],["وَأَرْمي فُؤَادِي بالشُّجُونِ رَبَتْ كَمَا","رَمَى الشَّنْفَرَى بِالحَرْبِ مِئْزَرَ لِحْيَانِ",59,"ن",1,0],["وأرماح مثقفة رواءٍ","بتامور القلوب مع الكلينا",60,"ن",2,0],["وارمها من حصى الحرام وكبر","حين ترمي وكن له غسالا",61,"ل",2,0],["وارم كل الجمارِ سبعاً مسبعاً","لا تقف عندها وكن معجالا",61,"ل",2,0],["وارمها من حد المسييل ولا","تعل عليها كما ترى الجهالا",61,"ل",2,0],["وأرم بكفيك الهوى ناوياً","تيمماً من عدمِ العفرِ",62,"ر",1,0],["وارم الأعادي والحسودَ بِبَغيهم","لا يهدمونَ بكيدِهم بنياني",63,"ن",2,0],["وَأَرمانُوسُ كانَ أَشَدَّ بَأساً","وَحَلَّ بِهِ عَلى يَدِكَ العَذابُ",64,"ب",1,0],["وارمق بعينك مغنى في جوانبه","ثاو تضمن علم اللوح والقلم",65,"م",1,0],["وأرمد عيني نور شمسي فاشتفت","إذ اكتحلت من عارضيه بإثمد",66,"د",1,0],["وارم العدوّ بعزمة تفري الطُّلى","تلقاه زحفاً في الرعيل الأولِ",67,"ل",1,1],["وأرمي بطرفي نحوكم كي أركم","فتأبى مرام بيننا وأكام",68,"م",1,0],["وأرماح المَعاطف باعتِدال","وَأَقواس الحَواجب بِاِعوجاج",69,"ج",1,0],["وارموا الصخور على الأخشاب والتمسوا","لها سبيلاً بهذا الطافح الجاري",70,"ر",2,0],["وارموا بنا نحو الخليل المرتضى","المفزع المأوى لكل دخيل",71,"ل",1,0],["وارمدت مقلتا عليّ","بتفله عاد في شفاء",72,"ا",2,0],["وأَرملةٌ عطلٌ منَ الزَّوج قد غدا","به أَمرُها بالخاطبينَ مُيَسّرا",73,"ر",2,0],["وارمي إلى الحمد لحظ البصير","وعن كل ذم اغض الجفونا",74,"ن",2,0],["وارمات الخدود من غير سوء","شحمات العيون والآذان",75,"ن",1,0],["وأرملة تسعى بنعلين طلقت","وأسيافنا آذنها بطلاق",76,"ق",1,0],["وَأَرماحُنا يَنهَزنَهُم نَهزَ جُمَّةٍ","يَعودُ عَلَيهِم وِردُنا فَنَميحُها",77,"ح",3,0],["واِرمِ في البَحر قطرَةً من مَزايا","ك يعد ملحه الأَجاج رواءَ",78,"ا",2,0],["وَأَرماحنا مِن صَدر كَل غَضَنفَر","لَها أَين كُنا مَورد وَصَدور",79,"ر",1,0],["وارمُق لممدودٍ بهِ متضيّقٍ","ضِيقاً بلا فَرَجٍ ليومِ مَعادي",80,"د",2,0],["وارمق السقي عندما تتثني","برباها أشجاره شرقيه",81,"ي",2,0],["وإرم به في سواد الخطب مهتديا","بدراً به يهتدي في سيره القمر",82,"ر",1,0],["وارمحي مغرماً يحاكي الخلالا","هكذا هكذا والأفلالا",83,"ل",2,0],["وأرماحٌ إذا ما هز","زت اهتزّ بها الجحفل",84,"ل",1,0],["وارمِ الطغاةَ بدردبيسٍ صَّمةٍ","لم يلقَ منها عن أولاك عيانُ",85,"ن",1,0],["وارمي إِلى الرفق بالإِنسان حَتّى إِذا","جاءَ احلساب اِنثَنى يَطري مَراميك",86,"ك",1,0],["وَأَرمِيهِما مِن فَوقِ عَرشٍ مُبَطَّنٍ","بِمَركَبةٍ أَذرُو سَحِيقاً مُكَسَّرا",87,"ر",2,0],["وارْمِ الأَعادي بالعَوادي إِنها","كَفلَتْ بفَلّ قديمهم والقادم",88,"م",1,0],["وارمى سهام الدعاء عن قوس صدقك في","المرمى فكل مرام عند مرماك",89,"ك",1,0],["وارمي بكوم العيس أجواز مهمه","تضل القطا ما بين تلك المخارق",90,"ق",1,0],["وارمضى حر الشمس باللفح أوجها","وظلت بها الحرباء تبغى مظللا",91,"ل",2,0],["وارم بنفسك في المهالك إنما","طلب المعالي للابي فخار",92,"ر",1,0],["وارمضت في التراقي واللها ضرما","لو ينقع الماء ما اذكت هواجره",93,"ر",2,0],["وَأَرمَلَةٍ تَبكي وَقَد شُقَّ جَيبُها","عَلَيهِ فَآبَت وَهيَ شُعثٌ قُرونُها",94,"ن",3,0],["وأرملةٍ تمشي بأشعَثَ مُحثلِ","كفَرخِ الحُبارى رأسه قد تصوَعا",95,"ع",2,0],["وارمهِ بالوَجدِ والشوقِ معاً","والتصابي والضَّنى والفِكَرِ",96,"ر",1,0],["وارم جوز الفلا بها ثم سمها","عجرفي النجاء بالتوخيد",97,"د",1,0],["وارم التواريخ من عرب ومن عجم","واكتب عليهن: ما بالربع من أحد",98,"د",1,0],["وارم المشارق والمغارب كلها","تأتيك عفوا دون نصب قتال",99,"ل",1,0],["وارميتني باحرابي","يا بو انهود ازمام",100,"م",1,0],["وأرملة تصيح لفقد زوج"