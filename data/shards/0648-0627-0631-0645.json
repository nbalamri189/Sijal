{"poems":[[53,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[53,"أسنة هذا المجد آل المهلب","https://www.aldiwan.net/poem30689.html","الطويل"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[9,"فيا أخوينا من عباد ومالك","https://www.aldiwan.net/poem21966.html","الطويل"],[71,"ذقن عبد الرحيم مع شاربيه","https://www.aldiwan.net/poem3819.html","الخفيف"],[35,"فكم من يتامى بوس قد جبرتها","https://www.aldiwan.net/poem39620.html","الطويل"],[30,"خليلي عوجا من صدور الرواحل","https://www.aldiwan.net/poem29541.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[72,"ظمئت إلى تقبيل كف كريمة","https://www.aldiwan.net/poem19043.html","الطويل"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[92,"راعها منه صمته ووجومه","https://www.aldiwan.net/poem38890.html","الخفيف"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[62,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[28,"وكائن أبى من خطة الديم واشترى","https://www.aldiwan.net/poem5423.html","الطويل"],[74,"هذا غراب دجاك ينعب فازجر","https://www.aldiwan.net/poem12962.html","الكامل"],[105,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[128,"تطاول همه ببراق سعر","https://www.aldiwan.net/poem24272.html","الوافر"],[129,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[161,"ما أنت في منزل يخشى به الرجل","https://www.aldiwan.net/poem58934.html","البسيط"],[182,"ألا هل من البين المفرق من بد","https://www.aldiwan.net/poem58877.html","الطويل"],[190,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[198,"سباك الجيد والقد","https://www.aldiwan.net/poem39863.html","مجزوء الوافر"],[226,"أميرة الغانيات أهلا","https://www.aldiwan.net/poem55160.html","مخلع البسيط"],[260,"من خمرة البكري قطب الأوان","https://www.aldiwan.net/poem35760.html","السريع"],[272,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[306,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[365,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[392,"كف السؤال عن الزمان وأهله","https://www.aldiwan.net/poem54533.html","عموديه"],[392,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[392,"يقول طاهر عسى الله يعين","https://www.aldiwan.net/poem54553.html","عموديه"],[392,"أشكو إلى الله الرحيم الودود","https://www.aldiwan.net/poem54592.html","عموديه"],[410,"أطاع الهوى من بعدهم وعصى الصبر","https://www.aldiwan.net/poem32477.html","الطويل"],[459,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[465,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[465,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[515,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[516,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[539,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"]],"verses":[["وَأَرَمَّ مِثلَ الصِلِّ يَن","تَظِرُ الَّتي تَشفي النَسيسا",0,"س",2,0],["وَأَرمي إِلى أَمرٍ أَظُنُّكَ بابَهُ","أَلا إِنَّ بَعضَ الظَنِّ غَيرُ مُكَذَّبِ",1,"ب",1,0],["وَاِرمِ بي عَن يَدَيكَ إِحدى الطَريقَي","نِ فَما الشِعرُ جُلَّ مالي وَكَسبي",2,"ب",2,0],["وَأَرمَلَةٍ تَسعى بِشُعثٍ كَأَنَّها","وَإِيّاهُمُ رَبداءُ حَثَّت رِئالَها",3,"ل",3,0],["وَاِرمِ بِالسَبِّ نَجلَ شيثٍ وَلا تَخ","شَ تَجِدهُ تَيساً بِقَرنٍ عَظيمِ",4,"م",1,0],["وَأَرمَلَةٍ هَلكى ضعافٍ وَصَلتَها","وَأَسرى عُناةٍ قَد فَكَكتَ رِقَابَها",5,"ب",3,0],["وَأَرمي بِعَينَيَّ النُجومَ كَأّنَّني","عَلى الرَحل طاوٍ مِن عِتاقِ الأَجادِلِذ",6,"ل",2,0],["وَأَرمي بِها الأَهوالَ حَتّى أَحَلتُها","وَسَوَّيتُها بِالمُحرِثاتِ الحَدابِرِ",7,"ر",1,0],["وأُرمى وأرمي بالعَدَاوَةِ أهلَها","وإنّي لأوذَى فِيهُم وأُؤَنَّبُ",8,"ب",1,0],["وَأَرماحُنا في كُلِّ لَبَّةِ فارِسٍ","تُثَقِّبُ تَثقيبَ الجُمانِ وَتَنظِمُ",9,"م",1,0],["وارمد عينيّ التسهّد والبكى","وحسبك أني لا أرى بهجة الشمس",10,"س",1,0],["وارمِ المهماتِ بي في كلِّ حادثةٍ","ترتاعُ منها أسودُ الغابِ والأسلِ",11,"ل",1,0],["وارْمِ للَّيلِ والضَّبابِ بعيداً","فَنَّكَ العابسَ الكثيرَ وُجومُهْ",12,"م",2,0],["وارم الصفوفَ بمثلهنَّ وشُنَّها","شعواءَ يُنسَى عندَها صِفِّينُ",13,"ن",1,0],["وأرمي بها جَوْزَ الفلاةِ كأنني","أرنِّحُ منها أعقُبَاً في الشكائمِ",14,"م",1,0],["وَأَرمَلَةٍ تَدعو بِلالاً فَقيرَةٍ","وَمالُ بِلالٍ حينَ يُنفِضُ مالُها",15,"ل",3,0],["وَاِرمِ الكَريهَةَ بِالكَريمَةِ وَاِرتَشِف","صَفوَ الحَياةِ مِنَ العَجاجِ الأَكدَرِ",16,"ر",1,0],["وَأَرمي بِنَفسي في مَآزِقَ جَمَّةٍ","أُغيثُ أولي البَلوى وَأَشفي ذَوي العَمى",17,"م",2,0],["وَارمِ العِدا بِبَشائِرٍ عَن أَرمِيا","إذ كَفَّ نَبلُ كِنانِهِ مَتبُولا",18,"ل",2,0],["وارْمِ الخُطُوبَ بمِثْلِهَا","عَزْماً فأَنْتَ لها مُسَاهِم",19,"م",1,0],["وارمق المورقات خضراً جلاه","ن من الليل عارض هتان",20,"ن",1,0],["وَأَرمَلَةٍ وَمُعَتَّرٍ مُسَيفٍ","عَديم المال عَجزةِ أُمِّ صَخرِ",21,"ر",1,0],["وارمِ من عادَانا وخالفنا في","أمرِنا بالقِلَى ومن مَال شَقّا",22,"ق",2,0],["وارم العدى بسهامٍ ما رمْيتَ بها","إِلا أصبْتَ وقال الَمجدُ لا شَللُ",23,"ل",1,0],["وَأَرمِى الَّذِى يَرمُون عَن قَوسِ بِغضَةٍ","وَلَيسَ عَلى مَولاَىَ حَدِّى وَلاَ جِدِّى",24,"د",2,0],["وَاِرم أَعاديها بكلّ عارِ","أَلحِق بِهم يا ربّ كلّ خسرِ",25,"ر",1,0],["وأرمض روحك الشوق","وليس من النوى بدّ",26,"د",1,0],["وارمي له بعضَ ما يُرَجّى","فالحُبُّ أرضاهُ بِاليَسير",27,"ر",1,0],["وارم جمار الغير في السير إن","تكن لوصل الغيد لاوي العنان",28,"ن",1,0],["وارم الزَمان بعظم جاه محمد","مَهما رمتك من الزمان عظائمه",29,"م",2,0],["وَأرمَدتُ منهم أعيُناً قَد تَطامَحَت","بعثير سبقي سابقاً كلَّ مَن أَجرى",30,"ر",2,0],["وارْمِ بطرْفٍ من بعيدٍ فَمن","دونِ صِفاحِ البيِضِ بِيضٌ صِفاح",31,"ح",1,0],["وارموا كلام العاذلين وراءكم","إن كثروا في عذلهم أو قللوا",32,"ل",3,0],["وارم لعقبتكح يوم النحر للإنحلال","وبت ليالي منى بهامناك تنال",33,"ل",1,0],["وارم لعقبتك يوم النحر للإنحلال","وبت ليالي منى بها مناك تنال",33,"ل",1,0],["وارم الجمار الثلاث بعد ما الظل زال","وطف وداعا وهذا اجعله ختم الخصال",33,"ل",1,0],["وارم الخلائق كلهم أجمعين","وصف قلبك منهم صف",34,"ف",1,0],["وارم الخلايق عربهم والهنود","جميعهم والد ومولود",35,"د",1,0],["وأرمِي فِجاجَ الأرضِ نحوَ بِلادكم","بطرفٍ كليلٍ دمعُه بَعدَكم قَطرُ",36,"ر",1,0],["وارم بها عرضَ الفلا فإنها","ما خُلقتْ إلا رُجوماً للفلا",37,"ل",2,0],["وارمي الخرق بالقلص النواجي","تجوب الأرض موحشةَ النواحي",38,"ح",2,0],["وارم بي من تشاء تلقَ ربيطَ","الجأش سامي طود النَّهي مغوارا",39,"ر",2,0],["واِرْمِ العِدا بجمارِ النّبْلِ واِسْعَ إلى","مِنى وغىً يرهبُ الضرغامَ منحَرُهُ",40,"ر",2,0],["وارم بأيدي العيس كل قفرة","تضل فيها لحظات القافر",41,"ر",1,0],["وأرمي بنَفسي في صفُوفِ أراذِلٍ","ولستُ لهم شكلاً وليسوا على شكلِي",42,"ل",2,0]]}