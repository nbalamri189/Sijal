m11503.html","عموديه"],[585,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"],[585,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"]],"verses":[["فَتَأمَنَ مِن حَيثُ يُخشى الأَذى","كَما خِبتَ مِن حَيثُ يُقضى الوَطَر",0,"ر",1,0],["فُتَّ المَدائِحَ حتى قالَ أفْصَحُنا","إنّ البَلاغَةَ في تَحْبيرِها حَصَرُ",1,"ر",1,0],["فَتَأَوَّت لَهُم قَراضِبَةٌ مِن","مُحلِّ حَيٍّ كَأَنَّهُم أَلقاءُ",2,"ا",2,0],["فَتاةٌ قَد كَساها الحُسنُ تاجاً","يُلَجلَجُ حينَ يُبصِرُها الفَصيحُ",3,"ح",1,0],["فَتَأوى لِمَن كادَت تَفيظُ حَياتُهُ","غَداةَ سَمَت نَحوي سَوائِرَ تَنعَبُ",4,"ب",1,0],["فَتَأَسَّيْتُ حِينَ أَبْصَرْتُ فَوْداً","للَّيْلِ قَدْ عَمَّهُ الصَّبَاحُ مَشيِبَا",5,"ب",2,0],["فَتَأَمَّل كَيفَ يَغشى","مُقلَةَ المَجدِ النُعاسُ",6,"س",1,0],["فَتَأَسَّ إِنَّ ذاكَ","الخَطبَ غالَ الأَنبِياءَ",7,"ا",2,0],["فَتَأَدّى مِنهُ بَيتا","غَزَلٍ مُنفَرِدانِ",8,"ن",1,0],["فَتَاللهِ مَا المُصْدِي لأَقْوَالِ غَيْرِهِ","بِأنْبَهَ عِنْدِي مِنْ جَوَادٍ يُحمْحِمُ",9,"م",1,0],["فَتَأمُرُ أَنتَ بِإِعطائِهِ","وَيَأمُرُ سَعدٌ بِحِرمانِهِ",10,"ن",2,0],["فَتَأتِيَكُم بما قُلنَا سَريعاً","ويبلُغَنا الذي قُلتُم قَرِيبَا",11,"ب",2,0],["فَتارَةً يَخِضُ الأَعناقَ عَن عُرُضٍ","وَخضاً وَتُنتَظَمُ الأَسحارُ وَالحُجُبُ",12,"ب",1,0],["فتاجُ بأعلاها وشاح بخصرها","وفي الساق منه قد أُديرت خلاخِلُ",13,"ل",1,0],["فتأمّلت في تقاطيع جسم","جعل الحسن كلّه عنوانه",14,"ن",2,0],["فتارة في ركود وهي واغِرةٌ","وتارة في عصوف وهي أعصار",15,"ر",1,0],["فتاة جَثَت في الأرض تبكي وحولها","صريع على وجه الثرى وطعين",16,"ن",1,0],["فتارةً في المَوامي فوق مُوَقرةٍ","وتارةً في الطوَامي فوق مشحون",17,"ن",1,0],["فتاوى على سمتِ الهدى وفتوَّة","تَجانسَ معنًى لفظها وتدَبجا",18,"ج",2,0],["فتانة الصبّ تجلى في حماه فيا","لها غزالة أفقٍ في منازله",19,"ل",2,1],["فتاة رأى اللاَّحي عليها مدامعِي","فقال رياضٌ قلت إنَّ وغدران",20,"ن",1,0],["فَتارَةً يَرفَعُني مَوجُها","وَتارَةً أَهوي وَأَنغَطُ",21,"ط",1,0],["فتأمُرُ أنْ يذكِّر بي","جليساً منكَ في تعبِ",22,"ب",1,0],["فَتَّاهُ شرخٌ شبابيٌّ وكهَّله","حِلمٌ إذ شال حلمٌ ناقصٌ رجَحا",23,"ح",2,0],["فَتَاه بِوجْهٍ يَطْرفُ العينَ قِبْحُهُ","له صورة كالشَّمسِ في الأعين الرُّمد",24,"د",1,0],["فتأمل الإِثنين مَنْ أدناهُما","شَبَهاً بوالده فذاك الماجدُ",25,"د",1,0],["فتارة تحسبها قينةً","تردد اللحنَ على الزامر",26,"ر",1,0],["فتَّاقُ ما يعيا الدهاة به","رتاق ما لم يَرتُقوا صدعه",27,"ع",2,0],["فتاةٌ من الأتراكِ ترمي بأسهُمٍ","يُصِبْنَ الحَشا في السّلم لا في المعارك",28,"ك",1,0],["فُتَّ العديلَ فما يقالُ كأنه","مَنْ ذا رأى لك في الأنامِ عديلا",29,"ل",2,0],["فُتَّ الرجالَ فلا كَسَعْيكَ للعلا","سعيٌ نراه ولا كخِيمك خيمُ",30,"م",1,0],["فتأمل الدنيا ولا تعجبْ لها","واعجبْ لمن أضحى إليها راكنا",31,"ن",2,0],["فَتاةٌ بَينَ مَبسَمِها","وَبَينَ عُقودِها نَسَبُ",32,"ب",1,0],["فَتاةٌ هِيَ الطاوُوُسُ عُجباً وَذَيلُها","وَلَم يَكُ ذَيلاً شَعرُها المُتَهَدِّلُ",33,"ل",1,0],["فَتأَلَّبوا وَتَهَدَّدوا وَتَوَعَّدوا","حَتّى طَلَعتَ فَأَجفَلوا إِجفالا",34,"ل",2,0],["فَتّانَةٌ خَلّابَةٌ","كَالياسَمينَةِ في شَذاها",35,"ا",3,0],["فَتَأَلَّفَت عِقداً يَروقُ نِظامُهُ","وَالعِقدُ أَحسَنُ مايَكونُ مُفَصَّلا",36,"ل",2,0],["فَتَأَمَّلوا فيهِ تَرَوا","أَثَرَ الدُموعِ بِكُلِّ سَطرِ",37,"ر",1,0],["فتأَلَّمتُ ثمَّ أسْكَتُّ آلامي","وكَفْكَفْتُ من شعوري وحسّي",38,"ي",1,0],["فَتَأَوَّدَتْ نَشوى بأَحلامِ","الحَياةِ وَنُورِهَا",39,"ه",2,0],["فَتَأَطَّرنَ ثُمَّ قُلنَ لَها","أَكرِميهِ حُيِّيتِ في نُزُلِه",40,"ل",2,0],["فتارة يبسطها","وتارة يلملم",41,"م",1,0],["فتاهم بالشباب ضحى","ما أعظم الذبح والفداء",42,"ا",2,0],["فتأمّل هل ترى من حيلة","في سلوك مرسلات من ذكاء",43,"ا",2,0],["فَتاةٌ تَساوى عِقدُها وَكَلامُها","وَمَبسِمُها الدُرِّيُّ في الحُسنِ وَالنَظمِ",44,"م",1,0],["فتارة في تجاويف العروق دم","وتارة في الثدايا ناصعاً لبنُ",45,"ن",1,0],["فَتَاللَهِ أَرضى بِالعِراقِ إِقامَةً","وَفي الأَرضِ لِلسَفرِ المُغِذِّ شَآمُ",46,"م",1,0],["فَتاها لِلعَظائِمِ إِن أَلَمَّت","وَلِلحَربِ المُشَمِّرَةِ العَوانِ",47,"ن",1,0],["فتاةٌ رمتْه بِسَهْمِ الجفونِ","ومدَّت إليه بَناناً خَضيبا",48,"ب",2,0],["فَتَأَهَّبي يا نَفسِ لا","يَلعَب بِكِ الأَمَلُ الطَويلُ",49,"ل",1,0],["فَتاً ما استَفادَ المالَ إِلّا أَفادَهُ","سِواهُ كَأَنَّ المالَ في كَفِّهِ حُلمُ",50,"م",1,1],["فَتَأَمَّلي ضَعفَ الحَرا","كِ وَكَلَّهُ بَعدَ السُكونِ",51,"ن",1,0],["فَتارَةً مِن قَدَحٍ","وَتارَةً مِن حَدَقِ",52,"ق",1,0],["فَتاةٌ كَالهِلالِ فَإِن تَجَلَّت","أَرَتنا البَدرَ في حالٍ ذَميمِ",53,"م",1,0],["فَتَأَمَّلتُ وَأَمَّلتُ مِنهُ جَم","عَ شَملي في عاجِلٍ وَاِقتِرابِ",54,"ب",1,0],["فَتَأَمَّلتُ في يَديهِ خُطوطاً","أَذكَرَتني مِن رَبَّها أَوقاتَه",55,"ت",2,0],["فَتَأَوَّلَ الرُؤيا سَطيحُ وَبَشَّرَت","بِظُهورِكَ الرُهبانُ وَالكُهّانُ",56,"ن",1,0],["فتَّانة تغرى ببسمتها","وتحدّد الميعاد في أدب",57,"ب",1,0],["فتّاكةٌ باللّحظِ وارحمتا","منها لقلبِ الدّنِفِ المستهام",58,"م",1,0],["فَتاةٌ تداوي كلَّ حين بِصحَّتي","سقامَ جفونٍ ما لها منه إبلالُ",59,"ل",1,0],["فتاةٌ أرَى طرفي لِطرفيَ حاسِداً","يغايِرُهُ في حُسنِها وَيُماحِكُه",60,"ك",2,0],["فتاةٌ لها في النفسِ أصلٌ منَ الهوى","وكُلُّ هَوىً في النفس مِن غيرِها بدعُ",61,"ع",1,0],["فتاةٌ إذا استعطفتَ باللين قلبها","على الصّبّ أضحى وهو من حجرٍ أَقسى",62,"س",2,0],["فُتّ السُّبَّاقَ بما كَحَلُوا","بغبارك عيناً في الأَمَدِ",63,"د",1,0],["فَتَأسّ في ابنكَ بابنِهِ وَخِلالِهِ","تَسْلُكْ بأُسْوَتِهِ سبيلَ رَشادِ",64,"د",1,0],["فتاةٌ إذا أحسنتُ في الحبِّ أذنَبَتْ","فمن أين لولا الجورُ تُلْزِمني الدنيا",65,"ي",2,0],["فَتَأَمَّلتُ وَجهَها","فَاِتَّقَتني بِكَفِّها",66,"ف",3,0],["فَتَأَبَّدَت مِن كُلِّ مُخطَفَةِ الحَشا","غَيداءَ تُكسى يارَقاً وَرُعاثا",67,"ث",2,0],["فَتَاةٌ تُرِيكَ الْبَدْرَ تَحْتَ قِنَاعِهَا","إِذَا سَفَرَتْ وَالْغُصْنَ فِي مَلْعَبِ الْحَقْوِ",68,"و",1,0],["فتَّاش دهاشاتِهِ","ساعي لصارخٍ ما رثي",69,"ي",1,0],["فَتَأَهَّبتُ لَها مِن خِفيَةٍ","حينَ مالَ اللَيلُ وَاِجتَنَّ القَمَر",70,"ر",1,0],["فَتَأَمَّلَت عَيناكَ فيكَ وَإِنَّما","زَورُ المَنِيَّةِ لِاِبنِ آدَمَ يَصحَبِ",71,"ب",1,0],["فَتَأَطَّرنَ ساعَةً","في مُناخِ الرَكائِبِ",72,"ب",1,0],["فتأهَّبا يا ابْنَيْ خُويلدَ وَاجْمَعَا","للحربِ جَمْعَكما ولا تَتَندَّما",73,"م",2,0],["فَتاةٌ مِسواكُها يَشهَد","بِشَهدٍ لَم يَدرِهِ الرَشفُ",74,"ف",1,0],["فَتَأَلَّفِ السُهّادَ في طَلَبِ العُلى","وَاِستَص