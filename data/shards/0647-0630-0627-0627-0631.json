{"poems":[[33,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[261,"قال له البرق وقالت له","https://www.aldiwan.net/poem48327.html","السريع"],[409,"زارت وقد ولى الهوى العذري","https://www.aldiwan.net/poem33903.html","الكامل"],[484,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[484,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[520,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[520,"فديت من لم ينقع بره","https://www.aldiwan.net/poem12222.html","السريع"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141348","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89414","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108210","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86397","البسيط"]],"verses":[["هَذا أَرادَت بِهِ بُخلاً لِنَعذِرُها","وَقَد نَرى أَنَّها لَن تَعدَمَ العِلَلا",0,"ل",2,0],["هذا ارْتِدَادُ الطّرْف قد فُتُّه","إلى المَدَى سَبقاً فمَنْ أنتُما",1,"م",2,0],["هذا أراه كله غلطاً","قد تُبْتُ عنه توبة القَسْر",2,"ر",1,0],["هذا أريج العبقري","ة في ابنه الزاكي الضليع",3,"ع",1,0],["هذا ارتجاج وهي جسم واحد","ولذا الحراك بنسبة الأعضاء",4,"ا",2,0],["هذا ارتجال روية يعنو لها","عصف الرياح الهوج يوم سباقها",5,"ق",3,0],["هذا ارتجال لم يكن قبله","روية تعرف ما تملي",6,"ل",2,0],["هذا ارتدى ثوب الكمال","فبات كلّ فتًى صديقة",7,"ق",2,0],["هذا ارتجال غضنفر","خذه ودع من قد عوى",8,"و",2,0],["هذا أراه فما عسى غيري يرى","ممن رأوا في ذا المقام تجاربا",9,"ب",2,0],["هذا إرخثونٌ ومنه نما","أطروس من طروادةً حكما",10,"م",2,0],["هذا أريجهم في الربع فانتشقا","وذي ثغورهم في الروض فارتشفا",11,"ف",2,0]]}