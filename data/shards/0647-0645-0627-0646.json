{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[65,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[79,"هم أن ينتف ذقني","https://www.aldiwan.net/poem36333.html","مجزوء الرمل"],[0,"لعمرك ما قلبي إلى أهله بحر","https://www.aldiwan.net/poem63.html",""],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[31,"بنو دارم عند السماء وأنتم","https://www.aldiwan.net/poem6091.html","الطويل"],[45,"أود من الأيام مالا توده","https://www.aldiwan.net/poem9553.html","الطويل"],[99,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[107,"هنا يا سراة الأزد حطوا رحالكم","https://www.aldiwan.net/poem44006.html","الطويل"],[107,"ما للدموع على التظنن تذرف","https://www.aldiwan.net/poem44039.html","الكامل"],[48,"إن كان قلبك فيه خوف بارئه","https://www.aldiwan.net/poem22456.html","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[108,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[23,"جزى اللهُ ربُّ الناسِ، خيرَ جزائهِ","https://www.poetsgate.com/ViewPoem.aspx?id=11420",""],[92,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[92,"أكلة الثريد","https://www.poetsgate.com/ViewPoem.aspx?id=179172",""],[119,"البرق حاجر ام لبرق الشام","https://www.aldiwan.net/poem40593.html","عموديه"],[138,"أرقت وقد تصوبت النجوم","https://www.aldiwan.net/poem21031.html","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[280,"تجافت عن مضاجعها جنوب","https://www.aldiwan.net/poem25449.html","الوافر"],[285,"سأشكر ما مننت به ومثلي","https://www.aldiwan.net/poem60758.html","الوافر"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[369,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[445,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[445,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[463,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[463,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[469,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[519,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[556,"أقلني ربي بالذين اصطفيتهم","https://www.aldiwan.net/poem47370.html","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62470","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119957","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112796","الوافر"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78176","الخفيف"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[415,"","https://poetry.dctabudhabi.ae/diwan/poem/144351","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79943","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79863","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100990","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101008","الرمل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17659","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11195","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75940","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205790","الكامل"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105732","الطويل"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105751","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74203","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74166","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132533","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110112","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85238","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131215",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66549","المنسرح"],[4132,"","https://poetry.dctabudhabi.ae/diwan/poem/200373","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139782",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139477",""],[4691,"ما أكثر العارين !!","https://www.poetsgate.com/ViewPoem.aspx?id=170079",""],[5005,"هما ندّان..","https://www.poetsgate.com/ViewPoem.aspx?id=190156",""],[5409,"قالت لصاحبها المطي","https://www.poetsgate.com/ViewPoem.aspx?id=155306",""],[5413,"فبدأتُ حيثُ توقفواْ","https://www.poetsgate.com/ViewPoem.aspx?id=200584",""],[6019,"هُما جميلان","https://www.poetsgate.com/ViewPoem.aspx?id=176595",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""]],"verses":[["هُمُ اِنتَعَلوا العَلياءَ قَبلَ نِعالِهِم","وَداسوا طُلى الأَعداءِ قَبلَ النَمارِقِ",0,"ق",1,0],["هُمُ أَنهَضوني بَعدَ ما قيلَ لا لَعاً","وَهُم أَغرَموا الأَيّامَ لي ما جَنى عَثري",1,"ر",2,0],["هُمُ اِنتَحَلوا إِرثَ النَبِيِّ مُحَمَّدٍ","وَدَبّوا إِلى أَولادِهِ بِالفَواقِرِ",2,"ر",1,0],["هُما نَزَلا منْ قَلبِ كُلِّ مُكاشِحٍ","بحَيثُ تُناجي سَوْرَةَ الهَمِّ أضْعانُ",3,"ن",1,0],["هَمَّ أَنْ يَنْتِفَ ذقنِي","وَأَرَانِيَ بِفَضْلِهْ",4,"ه",1,1],["هُما نَعجَتانِ مِن نِعاجِ تِبالَةِ","لَدى جُؤذَرَينِ أَو كَبَعضِ دُمى هَكِر",5,"ر",1,0],["همَّان من دنيا وآخرةٍ فيا","للحيرتين بمعضل وبمُضلع",6,"ع",1,0],["هما نعلانِ جلُّهما انخراقٌ","إلى خُفَّينِ جُلُّهما انخرامُ",7,"م",1,0],["هُم أَنقَذوا يَومَ الصُهَيباتِ سَبيَكُم","وَأَبناءُ رَهطِ الكَلبِ قُرعُ المَبارِكِ",8,"ك",1,0],["هُما ناصِرا مَن خانَهُ كُلُّ ناصِرٍ","وَأُسرَةُ مَن لَم يُكثِرِ النَسلَ جَدُّهُ",9,"د",2,0],["همٌّ أناخ فما انجلى","وخلا مكانُك لا خلا",10,"ل",2,1],["هَمّانَ في كُلِّ جَنبٍ مِنهُما ضَرَمٌ","عالٍ وَفي كُلِّ عَينٍ واكِفٌ سَرِبُ",11,"ب",1,0],["هُما نبّآهم فَارْعَوَوْا عن ضلالِهم","وقالوا رسولٌ جاءَ بالدِّينِ قيِّما",12,"م",2,0],["هُمْ أنصفوهُ مُشرَّداً يَجِدُ الأذَى","من كلِّ ذِي جَبريَّةٍ لا يُنْصِفُ",13,"ف",1,0],["هُما نَقيضانِ لا يَستَجمِعانِ بِهِ","وَالظَبيُ غَيرُ مُقيمٌ في ذَرا الأَسَدِ",14,"د",1,0],["هُم أَنشَبوا قِصَدَ القَنا مِن وائِلٍ","مِن حَيثُ نارُ الحِقدِ في إيقادِ",15,"د",1,0],["هم أنشئوه بلا وزن وقافية","فَلْيَأخُذُوا ألفَ بيت منه مُرْتجَل",16,"ل",1,0],["هم أنضبوا غدرانهم بجودهم","وفجروا في الناس ينبوع الغنى",17,"ا",1,0],["هما نزلاها بالهدى، واهتدتْ بهِ","فقدْ فازَ منْ أمسى رفيقَ محمدِ",18,"د",1,0],["هم أنكأوا قرحا فأعيت أساته","وهم اوسعوا خرقا فأعوز راقع",19,"ع",1,0],["هم أناسٌ تولّعوا بالثريدِ","واستُميلوا بزاهياتِ البُرود",20,"د",1,0],["هم ان نسيت خؤلتي وعمومتي","والفخر بالاخوال والاعمام",21,"م",1,0],["هُمُ اِنتَهَكوا المَحارِمَ مِن أَخيهِم","وَلَيسَ لَهُم بِغَيرِ أَخٍ حَريمُ",22,"م",1,0],["هُما نيّرا أفقِ الهُدى كلُّ مُهتدٍ","يَرى مِنهُما الشمسَ المُنيرةَ والبدرا",23,"ر",2,0],["هُمُ انْتُدِبُوا إلَى الأَوْرَادِ لَيْلاً","فَملْءُ قُلوبِهِمْ مِنْها نُدُوبُ",24,"ب",1,0],["هُمُ انْتُجِبُوا مِنَ الْحَسَبِ الْمُزَكّى","كَما قُدَّتْ مِنَ الأَدَمِ السُّيُورُ",25,"ر",1,0],["هُما نتيجةُ صدقٍ قد تعوّدهُ","قولاً وفعلاً وَهل ينفكّ ملتزمُ",26,"م",1,0],["هُما نَهارٌ وليلٌ أنت بَينَهما","فخُصَّ أيُّهما تَهوَى بنُقْصان",27,"ن",1,0],["هُمْ أَنجُمٌ لسماء العُلا","وعُثْمانُ شَمْسٌ لآفاقها",28,"ق",3,0],["هم أَنجَبُوكَ وقلَّدَوكَ سيوفَهُمْ","للنصرِ تُبْلِي فِي الإِلهِ وتَبْتَلِي",29,"ل",2,0],["هُمْ أَنجبوكَ لسانَ صدقٍ عَنهُمُ","فَرعاً يطيبُ لنا بطيبِ المَحْتِدِ",30,"د",1,0],["هم أنبضوا ذاك المَعي","نَ بها وهم ذاك المُعانُ",31,"ن",1,0],["هم انتقذوكَ والليالي ضواربٌ","بكلكلها في ضغطها وزحامِها",32,"م",3,0],["هم أنفساً تُدوِي عداك وألسناً","من جمرتيك سلائطٌ وشَرارُ",33,"ر",1,0],["هم أنجم العلياء في كل عالم","فمن سابق يمضى ومن لاحق يتلو",34,"ل",2,0],["هم ان يزالوا ليوثا في مرابضهم","ولن يزال عرين الأسد مأهولا",35,"ل",2,0],["هُما نجمانِ بينهُما اِشتراكٌ","لوِ اِقترَنا لقُلنا الفرقَدانِ",36,"ن",1,0],["هُمُ أنقذوا لمّا فَزِعتُ إليهمُ","وقد صَمّمت نحوي النُّيوبُ العوارقُ",37,"ق",1,0],["هما نعمتان استوفتا سائر القُرىَ","وشكرهُما حق على كل من عقَلْ",38,"ل",1,0],["هم إن طرا خطب ليوث خوادر","وأما عوى جدب غيوث هوامعُ",39,"ع",1,0],["هم أنجم أوقد الرحمن نورهم","فكيف يطفئه بهت مخاذيل",40,"ل",1,0],["هم أن رمتم الافصاح مني","أمام الانبيا حصن الحصون",41,"ن",1,0],["هُم أُناسٍ تَشَرَفوا بِإِنتِساب","لِلأَتاسي يا لَهُم مِن أُناس",42,"س",1,0],["هُمُ أَنْجَبُوا خَيْرَ المُلُوكِ مُحَمَّداً","رَفِيعَ العُلاَ والقَدْرِ وَالصِّيتِ وَالشَّأنِ",43,"ن",1,0],["هم انتَشروا فيه لردّ رَعِيلنا","فمن تربه يوم المعاد لهم نشر",44,"ر",1,0],["هم أنجمُ الأرضِ بأنوارِهم","أضاءَ أقصاها وأدناها",45,"ا",3,0],["هم أنجمُ العلم التي كم جلت","عن الورى ظلمةَ إِشكالها",46,"ل",3,0],["هم أنجمُ الدينِ وسبحانَ مَن","في أُفقهِ للرشدِ أبداها",47,"ا",3,0],["هم أنجم اللَه في الدنيا إذا طلعوا","وحجة اللَه في الأخرى إذا نشروا",48,"ر",3,0],["همَّ أن يحبسه فانسجما","وجرى كالعارض المندفع",49,"ع",1,0],["هُما نَعجَتانِ مِن نِعاجِ قَصيمَةٍ","إِذا مارَتا يَأتيهِما جُؤذَراهُما",50,"م",2,0],["هُمُ أَنفُ قَيسٍ مَن يَقُل مِثلَها لَهُم","مِنَ الناسِ يَخلِط قَولَ حَقٍّ وَباطِلِ",51,"ل",1,0],["هُم أَنجُمُ الهيرابِ للسفينَه","وللقياسِ أنجُمٌ مبينَه",52,"ه",1,0],["هُم أُناسٌ حَجُّوا وَزارُوا وفازُوا","ساعدتهُم في ذَلِكَ الأَقدارُ",53,"ر",1,0],["همّان أحمل واحداً في أضلعي","فأطيقُه بتجلّدي وأناتي",54,"ت",2,0],["هُمُ أنزلوا صُهبانَ قسراً واقعصوا","بحيراً واطرافُ القنى تتصبَّبُ",55,"ب",1,0],["هُمُ انزلوا يوم السُلى عزيزها","بسُمرِ العَوَالي والسُيوف الخواذم",56,"م",1,1],["هُما نقطتا ياء النبي فَطالَما","مِن المُصطَفى المُختار ضمَهُما الصَدر",57,"ر",1,0],["هُما نيرا مَجد وَعلم وَسَيدا","شَباب جنان الخلد فيما أتى الذكر",57,"ر",1,0],["هُما نيرانا نَهتدي بهداهما","وَمَن يَهتدي بِالحَق يَنجو مِن البَلوى",58,"و",2,0],["هم انتدبوني للعظائم فانجلت","عظائمهم مني بأشجع منتدب",59,"ب",1,1],["هم أَنْجَدوا وفؤادي ضاع بَيْنَهمُ","أم أَتْهَموا إنني بالحيِّ حَيْران",60,"ن",1,0],["هَمَّانِ راضَا شِماسَ مُعْتَزمٍ","للهِ هَمَّانِ ما هُما فَهمَا",61,"م",2,0],["هم انبياءُ الإِفك بِيحَ دماؤُهم","فشكوا الظما ممَّا ارتأَوهُ وما ارتَوَوا",62,"و",3,0],["هم أنصروا التوحيد بالبيض والقنا","فنال المنى بالنصر كل موحد",63,"د",1,0],["هما نقيضان لا هذا يعلب ولا","يقال في ذاك إلا كل ما يصم",64,"م",1,0],["هُمْ آَنسُوهُ لكِنْ بوَحْشَتِهِمْ","وَنَفَّرُوا عَنْ جُفونِهِ وَسَنَهْ",65,"ن",2,0],["هم أنكحوا بالغصب من فتياتكم","جهارا ومن شر المجاهرة الغصب",66,"ب",1,0],["هما نيِّرا أفق العلى أشرقا معاً","بوقتٍ وكلٌّ عروة المجد ماسك",67,"ك",1,0],["هما نجما الهدى بحرا الأيادي","هما بدرا العلا شمسا السناء",68,"ا",2,0],["هم إن تنلهم شدة ٌ أو نكبةٌ","لا يرفعوا ممّا اعتراهم باسا",69,"س",2,0],["هما ندّانِ قلبُكَ والعوادي","ووجها عُملةٍ بيدِ الكَسادِ",70,"د",1,1],["هم إن أتوا ركبوا مكا","نك واضطررت إلى النزول",71,"ل",1,0],["هم إن جهلتَ الحاصدون منَ الرجال","قساوة ومن النساء نفاقا",72,"ق",2,0],["هُما ندى الوردِ حطَّا قربَ بَسمَتِهِ ..",".. ثَغري فأضحى يُجيدُ الشَّعرَ مُتَّزِنَا",73,"ن",2,0],["هم أنت والسيد الهادي ومن لكما","إلى المدينة يحدو النوق بالخبب",74,"ب",1,0]]}