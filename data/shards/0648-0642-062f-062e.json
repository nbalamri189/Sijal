,90,"ت",2,0],["وقد خاب شخص ظن بالعشرة أنه","حوى عرف من ماشاه من أهل عرفان",91,"ن",1,0],["وقد خاب مغرور بفطنة عقلة","اذا استقرب القاصى وعف عن الدانى",91,"ن",2,0],["وَقد خَبَرت مِن حالتيكَ تكرّماً","وَرِفقاً وَإِسراعاً إِلى ما يُفيدها",92,"د",3,0],["وَقَدْ خَلَعْتُ حَيَاءً","أَمَالني عَنْكَ صَدَّا",93,"د",2,0],["وَقد خَجَلَ الوَرْدُ مُذْغِبْتَ عَنَّا","وَكاد يَكونُ شَقِيقَ الشَّقِيقِ",94,"ق",1,1],["وَقَد خَلَعتُ الحَيا عَنّي وَأَلبَسَني","مَذَلَّةَ النَفسِ فيهِ عِزُّ مَطلوبي",95,"ب",2,0],["وقد ختَمتْ منّي على كُلِّ ناظرٍ","وما كنتُ للمُستَوْدِعينَ بخَوّان",96,"ن",1,0],["وقد خلَصتْ فيه نَجيّاً عيونُنا","فما غادرَتْ في القَولِ من مُتردَّم",97,"م",1,0],["وقد خَطّأَتْ فَتْحَ حَرْفِ الرَّويِّ","فَضَمّتْ أَواخِرَ إطلاقها",98,"ق",3,0],["وقد خلَطوني بالنّفوسِ كأنّما","نَماهُم أَبو الأقيالِ عَمْروٌ وعامر",99,"ر",1,0],["وَقَد خَفَقَت راياتُهُ فَكَأَنَّها","أَنامِلُ في عُمرِ العَدُوِّ تُحاسِبُه",100,"ب",2,0],["وقد خَصَّ من بين التلاميذ بطرساً","زعيمَهم ذاك الشفيعُ المُشفَّع",101,"ع",1,0],["وقد خفقت بنود الجَورِ نصراً","وقدماً أخفقت منه البنود",102,"د",1,0],["وقد خدعتْهم عند إسعادهم لها","كخدع قصير عند حيلته الزَّبا",103,"ب",2,0],["وَقَد خُضِّبَت أَسيافَه فَكَأَنَّها","مِنَ الدم جَمرٌ وَالغُبارُ رَمادُ",104,"د",1,0],["وقد خابَ ساعٍ أَبْصَرَ البحر خلفه","إلى جرعة يروي بنهلتها الصدى",105,"د",2,0],["وقد خمدتْ نار القِرى دون طارق","فلا جود للجدوى ولا نار للقرى",106,"ر",2,0],["وقد خَلَعَتْ منه المعالي فؤادها","وإنسانُ عين المجد بالدَّمع عائم",107,"م",1,0],["وقد خلق الله كلتيهما","لحتف دنا أو لرزقٍ قسم",108,"م",1,0],["وقد خلّفتْ فينا أياديهِ روضة","سَقاها سحابُ العوجدِ غيث المدامع",109,"ع",1,0],["وقد خطبت منك المعالي مدائحاً","مهرن فجلّت عن قليل من المهر",110,"ر",1,0],["وقد خلقت قبل خلق الزمان","فجاءت لذاك تعُدّ الحقَب",111,"ب",1,0],["وَقَدْ خَفَقَتْ عليكَ بنودُ عِزٍّ","عَلَتْ واللهُ أَعلاهَا ويُعلي",112,"ل",2,0],["وَقَدْ خَسَفا كُرُنَّةَ بالعَوَالِي","وبُوغَةَ بادِئَيْنِ وعائِدَيْنِ",113,"ن",1,0],["وَقَدْ خَيَّلَتْ طُرْقُ المَجَرَّةِ أَنَّها","عَلَى مَفْرِقِ الليلِ البهيمِ قَتِيرُ",11