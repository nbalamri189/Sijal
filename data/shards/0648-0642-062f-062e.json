ُها","وَجُرَّت عَلى ذاكَ الصَعيدِ ذُيولُها",0,"ل",3,0],["وَقَد خَبَّرَتني عَنكَ أَنَّكَ ماجِدٌ","سَتَرقى مِنَ العَلياءِ أَبعَدَ مُرتقى",1,"ق",2,0],["وَقَد خَلَقَت فيها عُيوناً قَريحَةً","يَنامونَ عُمرَ اللَيلِ وَهيَ سَواهِدُ",2,"د",1,0],["وَقَد خاضَ صُبحُ الشَّيبِ لَيلَ شَبيبَةٍ","تَحَسَّرَ عَنّي وَالشَّبابُ لَهُ مَدى",3,"د",2,0],["وَقَد خَلفَتْ صَوبَ الغَمامِ شِمالُهُ","وَلَولاهُما لَم يُعرَفِ البأسُ وَالنَّدى",3,"د",2,0],["وَقَد خَضَعَت صيدُ المُلوكِ مَهابَةً","لِأَروَعَ مِن أَبناءِ سَلجوقَ أَصيَدا",3,"د",2,0],["وقد خيّمَتْ فيها بِدارِ مُقامَةٍ","فليسَ لَها عنْ رَبْعِهم مُتَحوَّلُ",4,"ل",1,0],["وقد خَلَصَتْ إليه بُعَيْدَ وَهْنٍ","صَباً عَثَرَتْ على لَغَبٍ بِرَنْدِ",5,"د",1,0],["وقد خَلَفَ الدّهْرُ الغَواني فصَرْفُهُ","كألحاظِها في مَنزِلِ الحَيّ مُغْتالُ",6,"ل",1,0],["وَقَد خَذَلَتهُمُ ثُعَلُ بنُ عَمروٍ","سَلامانيَّهُم وَالجَروَلِيِّ",7,"ي",1,0],["وَقَد خَلَعَت عَلَيهِ الشَمسُ تاج","فَلا يَغشى مَعالِمَهُ ظَلامُ",8,"م",1,0],["وَقَد خيرَ لي في الهَجرِ لَو كُنتُ صابِراً","وَمَن ذا عَلى هَجرِ الأَحِبَّةِ يَصبِرُ",9,"ر",1,0],["وَقَدْ خَبَرَتْ مِنْكَ خُلْقَاً جَمِيلاً","أَنَافَ عَلَى دَرَجَاتِ الْكَمَالِ",10,"ل",1,0],["وَقَد خَلَّفَت رَعنَ المَداخِلِ خَلفَها","وَنَكَّبَ عَنها مِن يَمينِ سَنيرُها",11,"ر",3,0],["وَقَد خَنَّقَ الآلُ الشِعافَ وَغَرَّقَت","جَواريهِ جَذعانَ القِضافِ النَوابِكِ",12,"ك",1,0],["وقد خلَب العقول لها جبين","تلوح على أسرّته النُكوب",13,"ب",1,0],["وَقَد خَلَتِ الطُلولُ مِن آلِ لَيلى","فَما لَكَ لا تُفيقُ عَنِ الطُلولِ",14,"ل",1,0],["وَقَد خُبِّرتُهُنَّ يَقُلنَ فانٍ","فَلا يَنظُرنَ مِن خَلَلِ القِرامِ",15,"م",1,0],["وَقَد خَلَطَ الخَوفُ لَمّا طَلَع","تَ دَلَّ الجَمالِ بِذُلِّ الرُعُب",16,"ب",1,0],["وقد خصصت أبا عيسى بلائمتي","إذ لم يكن منه تنبيهٌ وإذكارُ",17,"ر",1,0],["وقد خادعها الغاوي","بأفديكِ وأحميكِ",18,"ك",1,0],["وَقَد خَرَّ مِنهُم رَاجِلانِ وَفارِسٌ","كَمِيٌّ صَرَعناهُ وَخومٌ مُسَلَّبُ",19,"ب",1,0],["وقد خَضَّبَتْها غيومُ المساءِ","كغانيةٍ ضرَّجَتْها السُّيوفْ",20,"ف",1,0],["وَقَد خَذَلَت أَبو بَكرٍ بَنيها","وَخاذَلَها قُرَيظٌ وَالضِبابُ",21,"ب",1,0],["وَقَد خَفَقَت لَكَ الراياتُ فيهِ","فَظَلَّ يَموجُ بِالبيضِ الحِدادِ",22,"د",1,0],["وَقَد خَبَّرَ الفَتحُ المُعَجَّلُ رَنَّنا اِق","تَبَلناهُ مَيمونَ القِيامِ مُظَفَّرا",23,"ر",2,0],["وَقَد خَبَّرَ الشَيبُ الشَبيبَةَ أَنَّها","تَقَضَّت وَأَنّي ما سَبيلي سَبيلُها",24,"ل",3,0],["وَقَد خَبَّروا أَنَّ النَدامَةَ تَوبَةٌ","يُصَلّى بِها أَن تُقتَنى وَيُصامُ",25,"م",1,0],["وَقَد خَبَطَت رَحلي عَلَيها مَطِيَّتي","إِلَيكَ وَلَم تَعلَق قَلوصي بِصاحِبِ",26,"ب",1,0],["وَقَد خُفتُ حَتّى لَو أَرى المَوتَ مُقبِلاً","لِيَأخُذَني وَالمَوتُ يُكرَهُ زائِرُه",27,"ر",2,0],["وَقَد خَمَدَت نارُ النَدى بَعدَ غالِبٍ","وَقَصَّرَ عَن مَعروفِهِ كُلُّ فاعِلِ",28,"ل",1,0],["وَقَد خَذَلوا مَروانَ في الحَربِ وَاِبنَهُ","أَباكَ وَأَدلَوا فيهِما مَعَ مَن يُدلي",29,"ل",2,0],["وَقَد خانَ ما بَيني وَبَينَ مُحَمَّدٍ","لَيالٍ وَأَيّامٌ تَناءى اِلتِئامُها",30,"م",3,0],["وقد خضعتْ له كَعْبٌ وخافَت","سَطاه حينَ خوَّفَها كِلابُ",31,"ب",1,0],["وَقَد خَرَّمَ الطُرّادُ عَنهُ جِحاشَهُ","فَلَم يَبقَ إِلّا نَفسُهُ وَحَلائِلُه",32,"ل",2,0],["وَقَد خَرِبَت مَنازِلُهُم","فَلا عَينٌ وَلا أَثَرُ",33,"ر",1,0],["وقد خسرتُ حياةً","غَدَتْ من الربح ربحا",34,"ح",2,0],["وَقَد خَزَمَت بِالذُلِّ أَنفَ اِبنِ خازِمٍ","وَأَعيَت صَياصيها يَزيدَ بنَ مَزيَدِ",35,"د",1,0],["وَقَد خَفَّ خَطبُ الشَيبِ في جانِبِ الرَدى","فَصارَت بِهِ صُغرى الَّتي كانَتِ الكُبرى",36,"ر",2,0],["وَقَدٍّ خَلَعتُ البُردَ عَنهُ وَإِنَّما","نَشَرتُ بِهِ طَيَّ الصَحيفَةِ عَن سَطرِ",37,"ر",1,0],["وَقَد خَلَعَت لَيلاً عَلَينا يَدُ الهَوى","رِداءَ عِناقٍ مَزَّقَتهُ يَدُ الفَجرِ",37,"ر",1,0],["وقَد خَفَق البَرقُ الضَّرُوبُ كَأنَّهُ","حُسَامُ شُجَاعٍ أو فُؤادُ جَبَانِ",38,"ن",1,0],["وَقَد خَفَقَ البَرقُ الطَروبُ كَأَنَّهُ","حُسامُ شُجاعٍ أَو فُؤادُ جَبانِ",39,"ن",1,0],["وَقَد خِفتُ بِأَن أَحمِ","لَ ذَنباً مُوبِقاً فيهِ",40,"ي",2,0],["وَقَد خَلَّيتِني وَنَجِيِّ هَمٍّ","تَشَعَّبَ أَعظُمي حَتّى بَراها",41,"ا",3,0],["وقد خدّ في الشمس أُخدودَه","ولكن سَبَقْنا به في الثرى",42,"ا",1,0],["وَقَد خَطَّت حَواضِنُهُ","لَهُ مِن عَنبَرٍ طُرَرا",43,"ر",2,0],["وَقَد خَنَقتُ مَليحاً في مَنازِلِهِ","حَتى اِستَمَرَّ طَريداً غَيرَ مَصحوبِ",44,"ب",1,0],["وَقَد خِفتُ حَتّى ما تَزيدُ مَخافَتي","عَلى وَعِلٍ في ذي المَطارَةِ عاقِلِ",45,"ل",1,0],["وَقَد خَبِرتُ بَني الدُنيا فَلَيتَهُمُ","أَو لَيتَني حَمَلَتني عَنهُمُ العُصُفُ",46,"ف",1,0],["وَقَد خَطَرا فَحلَينِ لَو زالَ عَنهُما","غِطاءٌ لَكانا بِالوَعيدِ يَغِطّانِ",47,"ن",1,0],["وقد خلق العوالم بغتة","وكان زمانا قبلها ليس يخلق",48,"ق",1,0],["وَقَد خرجت من دارها للبانة","فأَحسست منها أَن روحي تخرج",49,"ج",1,0],["وقد خذلت أبو بكر بنيها","وخاذلها قريطٌ والضّباب",50,"ب",1,0],["وَقَد خَلَعَت عَلَيهِ الشَمسُ تاجاً","فَلا يَغشى مَعالِمَهُ ظَلامُ",51,"م",1,0],["وَقَد خَيَّروني كَأسَ خَمرٍ فَلَم أَجِد","سِوى لَوعَةٍ في الحَربِ ذاتِ ضِرامِ",52,"م",1,0],["وَقَدْ خَتمَا هَذِي الْعُهُودَ بِقُبْلَة","وأَكَّدَهَا صِدْقُ الْغَرَامِ بِمَدْمَعِ",53,"ع",1,0],["وقد خيَّم الحزنُ فوقَ الجميعِ","وأجَّجَ بين الضلوع الشَّرَر",54,"ر",1,0],["وقد خِفتُ، حتى ما تزيدُ مخافتي","على وعلٍ ، في المطاوة ِ ، عاقلِ",55,"ل",1,0],["وقد خَبَّأ السَمَّ الزُّعافَ فَبزَّهُ","خبيرٌ بما أبدى ، بصيرٌ بما خَبَّا",56,"ب",2,0],["وقد خَفَت الليل البَهيمُ فما به","سوى هاجساتِ الفكرِ لي من مَطارح",57,"ح",1,0],["وقد خبروني أن في الشرق وحدة","كنائسه تدعو فتبكي الجوامع",58,"ع",1,0],["وقد خبروني أن للعرب نهضة","بشائر قد لاحت لها وطلائع",58,"ع",1,0],["وقد خبروني أن مصر بعزمها","تناضل عن حق لها وتدافع",58,"ع",1,0],["وقد خبروني أن في الهند جذوة","تهاب إذا لم يمنع الشر مانع",58,"ع",1,0],["وقد خبر الفتح المعجل أننا أق","تبلناه ميمون القيام مظفراً",59,"ر",2,0],["وقد خُلقتْ عوجاءَ، مثلَ هِلالها","، يكونُ وإيّاها، القيامةَ، مُعْوجّا",60,"ج",2,0],["وقد خدّ في الشمس أخدودَه","فباتَ يظُنُّ الثّريّا السُّهَى",61,"ا",1,0],["وقد خضع الأكوان خوفاً لعزك ال","عظيم وقادات الملا سجدت ذلا",62,"ل",2,0],["وَقَد خَسِرَ الدًّنيَا والآخرَةَ امرُؤٌ","أتَاهُ لأمرٍ دِنيوي أو أُخروي",63,"ي",1,0],["وقَد خَادَعتُ قَلبي عَن هَواهَا","ولم يَجعَله مُنخَدعاً خِدَاعِى",64,"ع",2,0],["وقَد خُضتُ خَضخَاضَ الشوارِع دُونهُ","ولم يدرِ إلا اللهُ ما خضتُ عِندَهُ",65,"د",2,0],["وَقَد خِفتُ إِن