{"poems":[[53,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[53,"أبا حسن لي في الرجال فراسة","https://www.aldiwan.net/poem29932.html","الطويل"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[63,"أعد نظرا هل شارف الحي ثهمدا","https://www.aldiwan.net/poem45830.html","الطويل"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[63,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[3,"ألا يا دار عبلة بالطوي","https://www.aldiwan.net/poem119.html",""],[3,"فؤاد لا يسليه المدام","https://www.aldiwan.net/poem206.html",""],[55,"هجرت الندامى خشية السكر إنما","https://www.aldiwan.net/poem26345.html","الطويل"],[77,"أبا مالك أنت نجل الملوك","https://www.aldiwan.net/poem36372.html","المتقارب"],[71,"أشاقك من عليا دمشق قصورها","https://www.aldiwan.net/poem4027.html","الطويل"],[30,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[27,"ألا حي الديار وإن تعفت","https://www.aldiwan.net/poem5954.html","الوافر"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[47,"وما أنس لا أنس يوم المغار","https://www.aldiwan.net/poem25380.html","المتقارب"],[51,"أبلغ فتى آل بشر بل مؤملهم","https://www.aldiwan.net/poem62001.html","البسيط"],[51,"ألا يا قاتل الديك","https://www.aldiwan.net/poem65825.html","الهزج"],[12,"دعيني وقولي بعد ما شئت إنني","https://www.aldiwan.net/poem1203.html",""],[92,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[43,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[45,"لقد أمسك الله الخلافة بعد ما","https://www.aldiwan.net/poem63633.html","الطويل"],[45,"لديك هوى النفس اللجوج وسولها","https://www.aldiwan.net/poem65582.html","الطويل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[28,"إن بلالاً إن تلاقيه سالماً","https://www.aldiwan.net/poem1279.html",""],[28,"إلى ملك ما أمه من محارب","https://www.aldiwan.net/poem5115.html","الطويل"],[28,"نعائي ابن ليلى للسماح وللندى","https://www.aldiwan.net/poem5378.html","الطويل"],[28,"قضيت قضاء في الخلافة ثابتا","https://www.aldiwan.net/poem5465.html","الطويل"],[28,"لعمري لقد سلمت لو أن جثوة","https://www.aldiwan.net/poem5504.html","الطويل"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[49,"ألا يا أيها البشر","https://www.aldiwan.net/poem62097.html","مجزوء الوافر"],[80,"مشطت بالصبح صبحا","https://www.aldiwan.net/poem31508.html","المجتث"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[74,"أما وشباب قد ترامت به النوى","https://www.aldiwan.net/poem12950.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[81,"أقول وقد طال السهاد بذكره","https://www.aldiwan.net/poem61309.html","الطويل"],[81,"ضمان على عينيك أني عان","https://www.aldiwan.net/poem61478.html","الطويل"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[22,"ألا هبت أمامة بعد هدء","https://www.aldiwan.net/poem21646.html","الوافر"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[50,"يا صاح لا تجر في لومي وتأنيبي","https://www.aldiwan.net/poem64829.html","البسيط"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[46,"حسب الفتى من ذنوب وصفه رجلا","https://www.aldiwan.net/poem22980.html","البسيط"],[46,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85821","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85286","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141006",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9976","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[7,"أهاجَكَ، من أسماءَ، رَسمُ المَنازِلِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17583",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"على مجلسي","https://www.poetsgate.com/ViewPoem.aspx?id=179010",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[45,"لَقَدْ أمْسَكَ الله الخلافَةَ بَعدَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=31140",""],[46,"تيمّمَ، فجّاً واحداً، كلُّ راكبٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18240",""],[75,"ألا كلُّ آتٍ قريبُ المَدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""]],"verses":[["وَقَد خالَطَت ذاكَ الثَرى نَفَحاتُها","وَجُرَّت عَلى ذاكَ الصَعيدِ ذُيولُها",0,"ل",3,0],["وَقَد خَبَّرَتني عَنكَ أَنَّكَ ماجِدٌ","سَتَرقى مِنَ العَلياءِ أَبعَدَ مُرتقى",1,"ق",2,0],["وَقَد خَلَقَت فيها عُيوناً قَريحَةً","يَنامونَ عُمرَ اللَيلِ وَهيَ سَواهِدُ",2,"د",1,0],["وَقَد خاضَ صُبحُ الشَّيبِ لَيلَ شَبيبَةٍ","تَحَسَّرَ عَنّي وَالشَّبابُ لَهُ مَدى",3,"د",2,0],["وَقَد خَلفَتْ صَوبَ الغَمامِ شِمالُهُ","وَلَولاهُما لَم يُعرَفِ البأسُ وَالنَّدى",3,"د",2,0],["وَقَد خَضَعَت صيدُ المُلوكِ مَهابَةً","لِأَروَعَ مِن أَبناءِ سَلجوقَ أَصيَدا",3,"د",2,0],["وقد خيّمَتْ فيها بِدارِ مُقامَةٍ","فليسَ لَها عنْ رَبْعِهم مُتَحوَّلُ",4,"ل",1,0],["وقد خَلَصَتْ إليه بُعَيْدَ وَهْنٍ","صَباً عَثَرَتْ على لَغَبٍ بِرَنْدِ",5,"د",1,0],["وقد خَلَفَ الدّهْرُ الغَواني فصَرْفُهُ","كألحاظِها في مَنزِلِ الحَيّ مُغْتالُ",6,"ل",1,0],["وَقَد خَذَلَتهُمُ ثُعَلُ بنُ عَمروٍ","سَلامانيَّهُم وَالجَروَلِيِّ",7,"ي",1,0],["وَقَد خَلَعَت عَلَيهِ الشَمسُ تاج","فَلا يَغشى مَعالِمَهُ ظَلامُ",8,"م",1,0],["وَقَد خيرَ لي في الهَجرِ لَو كُنتُ صابِراً","وَمَن ذا عَلى هَجرِ الأَحِبَّةِ يَصبِرُ",9,"ر",1,0],["وَقَدْ خَبَرَتْ مِنْكَ خُلْقَاً جَمِيلاً","أَنَافَ عَلَى دَرَجَاتِ الْكَمَالِ",10,"ل",1,0],["وَقَد خَلَّفَت رَعنَ المَداخِلِ خَلفَها","وَنَكَّبَ عَنها مِن يَمينِ سَنيرُها",11,"ر",3,0],["وَقَد خَنَّقَ الآلُ الشِعافَ وَغَرَّقَت","جَواريهِ جَذعانَ القِضافِ النَوابِكِ",12,"ك",1,0],["وقد خلَب العقول لها جبين","تلوح على أسرّته النُكوب",13,"ب",1,0],["وَقَد خَلَتِ الطُلولُ مِن آلِ لَيلى","فَما لَكَ لا تُفيقُ عَنِ الطُلولِ",14,"ل",1,0],["وَقَد خُبِّرتُهُنَّ يَقُلنَ فانٍ","فَلا يَنظُرنَ مِن خَلَلِ القِرامِ",15,"م",1,0],["وَقَد خَلَطَ الخَوفُ لَمّا طَلَع","تَ دَلَّ الجَمالِ بِذُلِّ الرُعُب",16,"ب",1,0],["وقد خصصت أبا عيسى بلائمتي","إذ لم يكن منه تنبيهٌ وإذكارُ",17,"ر",1,0],["وقد خادعها الغاوي","بأفديكِ وأحميكِ",18,"ك",1,0],["وَقَد خَرَّ مِنهُم رَاجِلانِ وَفارِسٌ","كَمِيٌّ صَرَعناهُ وَخومٌ مُسَلَّبُ",19,"ب",1,0],["وقد خَضَّبَتْها غيومُ المساءِ","كغانيةٍ ضرَّجَتْها السُّيوفْ",20,"ف",1,0],["وَقَد خَذَلَت أَبو بَكرٍ بَنيها","وَخاذَلَها قُرَيظٌ وَالضِبابُ",21,"ب",1,0],["وَقَد خَفَقَت لَكَ الراياتُ فيهِ","فَظَلَّ يَموجُ بِالبيضِ الحِدادِ",22,"د",1,0],["وَقَد خَبَّرَ الفَتحُ المُعَجَّلُ رَنَّنا اِق","تَبَلناهُ مَيمونَ القِيامِ مُظَفَّرا",23,"ر",2,0],["وَقَد خَبَّرَ الشَيبُ الشَبيبَةَ أَنَّها","تَقَضَّت وَأَنّي ما سَبيلي سَبيلُها",24,"ل",3,0],["وَقَد خَبَّروا أَنَّ النَدامَةَ تَوبَةٌ","يُصَلّى بِها أَن تُقتَنى وَيُصامُ",25,"م",1,0],["وَقَد خَبَطَت رَحلي عَلَيها مَطِيَّتي","إِلَيكَ وَلَم تَعلَق قَلوصي بِصاحِبِ",26,"ب",1,0],["وَقَد خُفتُ حَتّى لَو أَرى المَوتَ مُقبِلاً","لِيَأخُذَني وَالمَوتُ يُكرَهُ زائِرُه",27,"ر",2,0],["وَقَد خَمَدَت نارُ النَدى بَعدَ غالِبٍ","وَقَصَّرَ عَن مَعروفِهِ كُلُّ فاعِلِ",28,"ل",1,0],["وَقَد خَذَلوا مَروانَ في الحَربِ وَاِبنَهُ","أَباكَ وَأَدلَوا فيهِما مَعَ مَن يُدلي",29,"ل",2,0],["وَقَد خانَ ما بَيني وَبَينَ مُحَمَّدٍ","لَيالٍ وَأَيّامٌ تَناءى اِلتِئامُها",30,"م",3,0],["وقد خضعتْ له كَعْبٌ وخافَت","سَطاه حينَ خوَّفَها كِلابُ",31,"ب",1,0],["وَقَد خَرَّمَ الطُرّادُ عَنهُ جِحاشَهُ","فَلَم يَبقَ إِلّا نَفسُهُ وَحَلائِلُه",32,"ل",2,0],["وَقَد خَرِبَت مَنازِلُهُم","فَلا عَينٌ وَلا أَثَرُ",33,"ر",1,0],["وقد خسرتُ حياةً","غَدَتْ من الربح ربحا",34,"ح",2,0],["وَقَد خَزَمَت بِالذُلِّ أَنفَ اِبنِ خازِمٍ","وَأَعيَت صَياصيها يَزيدَ بنَ مَزيَدِ",35,"د",1,0],["وَقَد خَفَّ خَطبُ الشَيبِ في جانِبِ الرَدى","فَصارَت بِهِ صُغرى الَّتي كانَتِ الكُبرى",36,"ر",2,0],["وَقَدٍّ خَلَعتُ البُردَ عَنهُ وَإِنَّما","نَشَرتُ بِهِ طَيَّ الصَحيفَةِ عَن سَطرِ",37,"ر",1,0],["وَقَد خَلَعَت لَيلاً عَلَينا يَدُ الهَوى","رِداءَ عِناقٍ مَزَّقَتهُ يَدُ الفَجرِ",37,"ر",1,0],["وقَد خَفَق البَرقُ الضَّرُوبُ كَأنَّهُ","حُسَامُ شُجَاعٍ أو فُؤادُ جَبَانِ",38,"ن",1,0],["وَقَد خَفَقَ البَرقُ الطَروبُ كَأَنَّهُ","حُسامُ شُجاعٍ أَو فُؤادُ جَبانِ",39,"ن",1,0],["وَقَد خِفتُ بِأَن أَحمِ","لَ ذَنباً مُوبِقاً فيهِ",40,"ي",2,0],["وَقَد خَلَّيتِني وَنَجِيِّ هَمٍّ","تَشَعَّبَ أَعظُمي حَتّى بَراها",41,"ا",3,0],["وقد خدّ في الشمس أُخدودَه","ولكن سَبَقْنا به في الثرى",42,"ا",1,0],["وَقَد خَطَّت حَواضِنُهُ","لَهُ مِن عَنبَرٍ طُرَرا",43,"ر",2,0],["وَقَد خَنَقتُ مَليحاً في مَنازِلِهِ","حَتى اِستَمَرَّ طَريداً غَيرَ مَصحوبِ",44,"ب",1,0],["وَقَد خِفتُ حَتّى ما تَزيدُ مَخافَتي","عَلى وَعِلٍ في ذي المَطارَةِ عاقِلِ",45,"ل",1,0],["وَقَد خَبِرتُ بَني الدُنيا فَلَيتَهُمُ","أَو لَيتَني حَمَلَتني عَنهُمُ العُصُفُ",46,"ف",1,0],["وَقَد خَطَرا فَحلَينِ لَو زالَ عَنهُما","غِطاءٌ لَكانا بِالوَعيدِ يَغِطّانِ",47,"ن",1,0],["وقد خلق العوالم بغتة","وكان زمانا قبلها ليس يخلق",48,"ق",1,0],["وَقَد خرجت من دارها للبانة","فأَحسست منها أَن روحي تخرج",49,"ج",1,0],["وقد خذلت أبو بكر بنيها","وخاذلها قريطٌ والضّباب",50,"ب",1,0],["وَقَد خَلَعَت عَلَيهِ الشَمسُ تاجاً","فَلا يَغشى مَعالِمَهُ ظَلامُ",51,"م",1,0],["وَقَد خَيَّروني كَأسَ خَمرٍ فَلَم أَجِد","سِوى لَوعَةٍ في الحَربِ ذاتِ ضِرامِ",52,"م",1,0],["وَقَدْ خَتمَا هَذِي الْعُهُودَ بِقُبْلَة","وأَكَّدَهَا صِدْقُ الْغَرَامِ بِمَدْمَعِ",53,"ع",1,0],["وقد خيَّم الحزنُ فوقَ الجميعِ","وأجَّجَ بين الضلوع الشَّرَر",54,"ر",1,0],["وقد خِفتُ، حتى ما تزيدُ مخافتي","على وعلٍ ، في المطاوة ِ ، عاقلِ",55,"ل",1,0],["وقد خَبَّأ السَمَّ الزُّعافَ فَبزَّهُ","خبيرٌ بما أبدى ، بصيرٌ بما خَبَّا",56,"ب",2,0],["وقد خَفَت الليل البَهيمُ فما به","سوى هاجساتِ الفكرِ لي من مَطارح",57,"ح",1,0],["وقد خبروني أن في الشرق وحدة","كنائسه تدعو فتبكي الجوامع",58,"ع",1,0],["وقد خبروني أن للعرب نهضة","بشائر قد لاحت لها وطلائع",58,"ع",1,0],["وقد خبروني أن مصر بعزمها","تناضل عن حق لها وتدافع",58,"ع",1,0],["وقد خبروني أن في الهند جذوة","تهاب إذا لم يمنع الشر مانع",58,"ع",1,0],["وقد خبر الفتح المعجل أننا أق","تبلناه ميمون القيام مظفراً",59,"ر",2,0],["وقد خُلقتْ عوجاءَ، مثلَ هِلالها","، يكونُ وإيّاها، القيامةَ، مُعْوجّا",60,"ج",2,0],["وقد خدّ في الشمس أخدودَه","فباتَ يظُنُّ الثّريّا السُّهَى",61,"ا",1,0]]}