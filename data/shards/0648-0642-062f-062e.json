,"https://www.poetsgate.com/ViewPoem.aspx?id=205923",""],[4578,"أصم ناعيك سمع الفضل حين نعى","https://www.poetsgate.com/ViewPoem.aspx?id=49472",""],[4578,"بروح العلا بالسعد أبدت سماؤها","https://www.poetsgate.com/ViewPoem.aspx?id=49341",""],[4878,"ببرج المجد قد دخل السعود","https://www.poetsgate.com/ViewPoem.aspx?id=170945",""],[4954,"كَفاني قَريضي مُؤْنِسًأ","https://www.poetsgate.com/ViewPoem.aspx?id=207724",""],[2177,"هما العلمان بالزوراء لاحا","https://www.poetsgate.com/ViewPoem.aspx?id=127085",""],[585,"خلا المجال وأودى الشاعر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=161942",""],[585,"نثلت لك الكنانة في العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=161849",""],[585,"يا رائد القوم إن القوم أنضاء","https://www.poetsgate.com/ViewPoem.aspx?id=161878",""],[5149,"رسولَ اللهِ قد عَظُمَ البَلاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=212566",""],[5156,"إمام الهدى أنصاركم آل طاهر","https://www.poetsgate.com/ViewPoem.aspx?id=99118",""],[5277,"بيني وبينها","https://www.poetsgate.com/ViewPoem.aspx?id=186896",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5319,"تذكر عزيز ليالينا","https://www.poetsgate.com/ViewPoem.aspx?id=189016",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5376,".أُبادله بكل هوى وألقى.إلى ولدي الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=188452",""],[5431,"لعمريَ إنّ قسوتهم ظنونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=186703",""],[5431,"وعاد معي إلى خلق جديد....","https://www.poetsgate.com/ViewPoem.aspx?id=190829",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5497,"معسولة اللمى","https://www.poetsgate.com/ViewPoem.aspx?id=208977",""],[5582,"أَلا كُلُّ عَيْشٍ صَفْوُهُ يَتَكَدَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187148",""],[2598,"خَرَجْتُ مِنَ المِصْرِ الحَوَارِيِّ أهْلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=20761",""],[5689,"بشير الأنس بلغ يا بشير","https://www.poetsgate.com/ViewPoem.aspx?id=143431",""],[5690,"إذا ما المجد داريهِ الكلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172178",""],[5725,"شيخ المتظاهرين","https://www.poetsgate.com/ViewPoem.aspx?id=198883",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[6070,"حياةُ المرءِ تحكمُها الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=188425",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6102,"ساق !!","https://www.poetsgate.com/ViewPoem.aspx?id=184410",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[520,"سجودا فهذا صاحب الركن والحجز","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577512",""],[6167,"تحت العرش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85552&r=&rc=35",""],[6299,"دَعِيني وَقُولِي بَعْدُ ما شِئْتِ إِنَّني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19675&r=&rc=0",""],[147,"شفاءُ الهدى ياسيفهُ العضبَ أنْ تشفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27434&r=&rc=1",""]],"verses":[["وَقَد خالَطَت ذاكَ الثَرى نَفَحاتُها","وَجُرَّت عَلى ذاكَ الصَعيدِ ذُيولُها",0,"ل",3,0],["وَقَد خَبَّرَتني عَنكَ أَنَّكَ ماجِدٌ","سَتَرقى مِنَ العَلياءِ أَبعَدَ مُرتقى",1,"ق",2,0],["وَقَد خَلَقَت فيها عُيوناً قَريحَةً","يَنامونَ عُمرَ اللَيلِ وَهيَ سَواهِدُ",2,"د",1,0],["وَقَد خاضَ صُبحُ الشَّيبِ لَيلَ شَبيبَةٍ","تَحَسَّرَ عَنّي وَالشَّبابُ لَهُ مَدى",3,"د",2,0],["وَقَد خَلفَتْ صَوبَ الغَمامِ شِمالُهُ","وَلَولاهُما لَم يُعرَفِ البأسُ وَالنَّدى",3,"د",2,0],["وَقَد خَضَعَت صيدُ المُلوكِ مَهابَةً","لِأَروَعَ مِن أَبناءِ سَلجوقَ أَصيَدا",3,"د",2,0],["وقد خيّمَتْ فيها بِدارِ مُقامَةٍ","فليسَ لَها عنْ رَبْعِهم مُتَحوَّلُ",4,"ل",1,0],["وقد خَلَصَتْ إليه بُعَيْدَ وَهْنٍ","صَباً عَثَرَتْ على لَغَبٍ بِرَنْدِ",5,"د",1,0],["وقد خَلَفَ الدّهْرُ الغَواني فصَرْفُهُ","كألحاظِها في مَنزِلِ الحَيّ مُغْتالُ",6,"ل",1,0],["وَقَد خَذَلَتهُمُ ثُعَلُ بنُ عَمروٍ","سَلامانيَّهُم وَالجَروَلِيِّ",7,"ي",1,0],["وَقَد خَلَعَت عَلَيهِ الشَمسُ تاج","فَلا يَغشى مَعالِمَهُ ظَلامُ",8,"م",1,0],["وَقَد خيرَ لي في الهَجرِ لَو كُنتُ صابِراً","وَمَن ذا عَلى هَجرِ الأَحِبَّةِ يَصبِرُ",9,"ر",1,0],["وَقَدْ خَبَرَتْ مِنْكَ خُلْقَاً جَمِيلاً","أَنَافَ عَلَى دَرَجَاتِ الْكَمَالِ",10,"ل",1,0],["وَقَد خَلَّفَت رَعنَ المَداخِلِ خَلفَها","وَنَكَّبَ عَنها مِن يَمينِ سَنيرُها",11,"ر",3,0],["وَقَد خَنَّقَ الآلُ الشِعافَ وَغَرَّقَت","جَواريهِ جَذعانَ القِضافِ النَوابِكِ",12,"ك",1,0],["وقد خلَب العقول لها جبين","تلوح على أسرّته النُكوب",13,"ب",1,0],["وَقَد خَلَتِ الطُلولُ مِن آلِ لَيلى","فَما لَكَ لا تُفيقُ عَنِ الطُلولِ",14,"ل",1,0],["وَقَد خُبِّرتُهُنَّ يَقُلنَ فانٍ","فَلا يَنظُرنَ مِن خَلَلِ القِرامِ",15,"م",1,0],["وَقَد خَلَطَ الخَوفُ لَمّا طَلَع","تَ دَلَّ الجَمالِ بِذُلِّ الرُعُب",16,"ب",1,0],["وقد خصصت أبا عيسى بلائمتي","إذ لم يكن منه تنبيهٌ وإذكارُ",17,"ر",1,0],["وقد خادعها الغاوي","بأفديكِ وأحميكِ",18,"ك",1,0],["وَقَد خَرَّ مِنهُم رَاجِلانِ وَفارِسٌ","كَمِيٌّ صَرَعناهُ وَخومٌ مُسَلَّبُ",19,"ب",1,0],["وقد خَضَّبَتْها غيومُ المساءِ","كغانيةٍ ضرَّجَتْها السُّيوفْ",20,"ف",1,0],["وَقَد خَذَلَت أَبو بَكرٍ بَنيها","وَخاذَلَها قُرَيظٌ وَالضِبابُ",21,"ب",1,0],["وَقَد خَفَقَت لَكَ الراياتُ فيهِ","فَظَلَّ يَموجُ بِالبيضِ الحِدادِ",22,"د",1,0],["وَقَد خَبَّرَ الفَتحُ المُعَجَّلُ رَنَّنا اِق","تَبَلناهُ مَيمونَ القِيامِ مُظَفَّرا",23,"ر",2,0],["وَقَد خَبَّرَ الشَيبُ الشَبيبَةَ أَنَّها","تَقَضَّت وَأَنّي ما سَبيلي سَبيلُها",24,"ل",3,0],["وَقَد خَبَّروا أَنَّ النَدامَةَ تَوبَةٌ","يُصَلّى بِها أَن تُقتَنى وَيُصامُ",25,"م",1,0],["وَقَد خَبَطَت رَحلي عَلَيها مَطِيَّتي","إِلَيكَ وَلَم تَعلَق قَلوصي بِصاحِبِ",26,"ب",1,0],["وَقَد خُفتُ حَتّى لَو أَرى المَوتَ مُقبِلاً","لِيَأخُذَني وَالمَوتُ يُكرَهُ زائِرُه",27,"ر",2,0],["وَقَد خَمَدَت نارُ النَدى بَعدَ غالِبٍ","وَقَصَّرَ عَن مَعروفِهِ كُلُّ فاعِلِ",28,"ل",1,0],["وَقَد خَذَلوا مَروانَ في الحَربِ وَاِبنَهُ","أَباكَ وَأَدلَوا فيهِما مَعَ مَن يُدلي",29,"ل",2,0],["وَقَد خانَ ما بَيني وَبَينَ مُحَمَّدٍ","لَيالٍ وَأَيّامٌ تَناءى اِلتِئامُها",30,"م",3,0],["وقد خضعتْ له كَعْبٌ وخافَت","سَطاه حينَ خوَّفَها كِلابُ",31,"ب",1,0],["وَقَد خَرَّمَ الطُرّادُ عَنهُ جِحاشَهُ","فَلَم يَبقَ إِلّا نَفسُهُ وَحَلائِلُه",32,"ل",2,0],["وَقَد خَرِبَت مَنازِلُهُم","فَلا عَينٌ وَلا أَثَرُ",33,"ر",1,0],["وقد خسرتُ حياةً","غَدَتْ من الربح ربحا",34,"ح",2,0],["وَقَد خَزَمَت بِالذُلِّ أَنفَ اِبنِ خازِمٍ","وَأَعيَت صَياصيها يَزيدَ بنَ مَزيَدِ",35,"د",1,0],["وَقَد خَفَّ خَطبُ الشَيبِ في جانِبِ الرَدى","فَصارَت بِهِ صُغرى الَّتي كانَتِ الكُبرى",36,"ر",2,0],["وَقَدٍّ خَلَعتُ البُردَ عَنهُ وَإِنَّما","نَشَرتُ بِهِ طَيَّ الصَحيفَةِ عَن سَطرِ",37,"ر",1,0],["وَقَد خَلَعَت لَيلاً عَلَينا يَدُ الهَوى","رِداءَ عِناقٍ مَزَّقَتهُ يَدُ الفَجرِ",37,"ر",1,0],["وقَد خَفَق البَرقُ الضَّرُوبُ كَأنَّهُ","حُسَامُ شُجَاعٍ أو فُؤادُ جَبَانِ",38,"ن",1,0],["وَقَد خَفَقَ البَرقُ الطَروبُ كَأَنَّهُ","حُسامُ شُجاعٍ أَو فُؤادُ جَبانِ",39,"ن",1,0],["وَقَد خِفتُ بِأَن أَحمِ","لَ ذَنباً مُوبِقاً فيهِ",40,"ي",2,0],["وَقَد خَلَّيتِني وَنَجِيِّ هَمٍّ","تَشَعَّبَ أَعظُمي حَتّى بَراها",41,"ا",3,0],["وقد خدّ في الشمس أُخدودَه","ولكن سَبَقْنا به في الثرى",42,"ا",1,0],["وَقَد خَطَّت حَواضِنُهُ","لَهُ مِن عَنبَرٍ طُرَرا",43,"ر",2,0],["وَقَد خَنَقتُ مَليحاً في مَنازِلِهِ","حَتى اِستَمَرَّ طَريداً غَيرَ مَصحوبِ",44,"ب",1,0],["وَقَد خِفتُ حَتّى ما تَزيدُ مَخافَتي","عَلى وَعِلٍ في ذي المَطارَةِ عاقِلِ",45,"ل",1,0],["وَقَد خَبِرتُ بَني الدُنيا فَلَيتَهُمُ","أَو لَيتَني حَمَلَتني عَنهُمُ العُصُفُ",46,"ف",1,0],["وَقَد خَطَرا فَحلَينِ لَو زالَ عَنهُما","غِطاءٌ لَكانا بِالوَعيدِ يَغِطّانِ",47,"ن",1,0],["وقد خلق العوالم بغتة","وكان زمانا قبلها ليس يخلق",48,"ق",1,0],["وَقَد خرجت من دارها للبانة","فأَحسست منها أَن روحي تخرج",49,"ج",1,0],["وقد خذلت أبو بكر بنيها","وخاذلها قريطٌ والضّباب",50,"ب",1,0],["وَقَد خَلَعَت عَلَيهِ الشَمسُ تاجاً","فَلا يَغشى مَعالِمَهُ ظَلامُ",51,"م",1,0],["وَقَد خَيَّروني كَأسَ خَمرٍ فَلَم أَجِد","سِوى لَوعَةٍ في الحَربِ ذاتِ ضِرامِ",52,"م",1,0],["وَقَدْ خَتمَا هَذِي الْعُهُودَ بِقُبْلَة","وأَكَّدَهَا صِدْقُ الْغَرَامِ بِمَدْمَعِ",53,"ع",1,0],["وقد خيَّم الحزنُ فوقَ الجميعِ","وأجَّجَ بين الضلوع الشَّرَر",54,"ر",1,0],["وقد خِفتُ، حتى ما تزيدُ مخافتي","على وعلٍ ، في المطاوة ِ ، عاقلِ",55,"ل",1,0],["وقد خَبَّأ السَمَّ الزُّعافَ فَبزَّهُ","خبيرٌ بما أبدى ، بصيرٌ بما خَبَّا",56,"ب",2,0],["وقد خَفَت الليل البَهيمُ فما به","سوى هاجساتِ الفكرِ لي من مَطارح",57,"ح",1,0],["وقد خبروني أن في الشرق وحدة","كنائسه تدعو فتبكي الجوامع",58,"ع",1,0],["وقد خبروني أن للعرب نهضة","بشائر قد لاحت لها وطلائع",58,"ع",1,0],["وقد خبروني أن مصر بعزمها","تناضل عن حق لها وتدافع",58,"ع",1,0],["وقد خبروني أن في الهند جذوة","تهاب إذا لم يمنع الشر مانع",58,"ع",1,0],["وقد خبر الفتح المعجل أننا أق","تبلناه ميمون القيام مظفراً",59,"ر",2,0],["وقد خُلقتْ عوجاءَ، مثلَ هِلالها","، يكونُ وإيّاها، القيامةَ، مُعْوجّا",60,"ج",2,0],["وقد خدّ في الشمس أخدودَه","فباتَ يظُنُّ الثّريّا السُّهَى",61,"ا",1,0],["وقد خضع الأكوان خوفاً لعزك ال","عظيم وقادات الملا سجدت ذلا",62,"ل",2,0],["وَقَد خَسِرَ الدًّنيَا والآخرَةَ امرُؤٌ","أتَاهُ لأمرٍ دِنيوي أو أُخروي",63,"ي",1,0],["وقَد خَادَعتُ قَلبي عَن هَواهَا","ولم يَجعَله مُنخَدعاً خِدَاعِى",64,"ع",2,0],["وقَد خُضتُ خَضخَاضَ الشوارِع دُونهُ","ولم يدرِ إلا اللهُ ما خضتُ عِندَهُ",65,"د",2,0],["وَقَد خِفتُ إِن لَم تَزجُرَنهُم وَتَرعَووا","تُلاقي وَنَلقى مِنكَ إِحدى البَلابِلِ",66,"ل",1,0],["وقد خفيتْ من قبله معجزاتُها","فأظهرها حتى أقرّ كَفورُها",67,"ر",3,0],["وَقَد خافَ كُلٌّ ما عَداهُ مِنَ الرَدى","وَقامَ بِها مِنهُ المَقامَ المُحَمَّدا",68,"د",2,0],["وَقَد خَرَقَ السَبعَ السَمواتِ راكِباً","إِلى حَضرَةِ القُدسِ العَليَّةِ ذاهِباً",69,"ب",2,0],["وقد خفقت راياتك اليض فوقها","خفوق قلوب هن منها على وعد",70,"د",1,0],["وقد خادع السلطان عنه بنسبة","تزيا والخدع يعمل في الحر",71,"ر",1,0],["وَقَد خَبِرَ الدُنيا فَلم تَأتِ عِندَهُ","غَريباً وَلَم تَبدو بِوَجه مُقنَّعِ",72,"ع",1,0],["وقد خانتْ سلاسلُها عُراها","فنِيطَ بحَمْلها سُمْرُ العَوالي",73,"ل",2,0],["وقد خفقَ النعاسُ بهمْ فمالوا","به مَيْلَ النزيفِ من المُدام",74,"م",1,0],["وقد خَفَقَتْ زُهْرُ النجومِ كأنما","تُهَزُّ بأيدي الريح منها نيازك",75,"ك",1,0],["وقد خرجتْ لتعزي السماءْ","عن ابنتها إذ طواها الأفولْ",76,"ل",1,0],["وقد خاب ظني في هواكم فليتني","لخلعة أشواقي عليكم أمزّق",77,"ق",1,0],["وقد خفقتْ فيها رياحٌ عواصفٌ","تَسِفُّ عليها الرملَ وهي دوارسُ",78,"س",1,0],["وقد خصّك الرحمنُ قبلَ مقالتي","بطولِ بقاءِ العمرِ في مرتضَى الذّكْرِ",79,"ر",1,0],["وقد خلق الله الجنان معدة","لأربابها فيها ظلال ومرتع",80,"ع",1,0],["وقد خلق الله الجحيم لأهلها","لبأس أذاها عنهم ليس ينزع",80,"ع",1,0],["وقد خصه البارى بنور بصيرة","وعقل عن الحق الصراح ينقب",81,"ب",1,0],["وقد خسرت تجارته إذا لم","يكن برضاء مولاه يتاجر",82,"ر",1,0],["وقد خفقت رايات نصرك في الوغى","كما خفقت أعضاء أعداك من جبن",83,"ن",1,0],["وقد خط من آيات شيبك ناسخ","الشبيبة في قرطاس رأسك احرفا",84,"ف",2,0],["وَقَد خُيِّرتَ فَاختَرتَ","صَديقاً مِثلهُ يُقلى",85,"ل",2,0],["وقد خلَّفتِني صبّاً كئيباً","أُعاني في الصَّبابةِ ما أُعاني",86,"ن",2,0],["وقد خيّم الصّفصافُ للماءِ عاشقاً","على ضفّةٍ خضراءَ في ظلّ أطواد",87,"د",1,0],["وَقَدْ خَبأَتْ لهُ الأَقْدَارُ مِنْهُ","فَتىً وافَاهُ بالحَيْنِ الجَنِيِّ",88,"ي",1,0],["وَقَدْ خَطَبَ الأَمْلاكُ مَدْحِي فَصُنْتُهُ","لأكْرَمِهِمْ نَجْراً وَأَشْرَفهِمْ قَدْرا",89,"ر",2,0],["وَقَد خَدَمتُك من شِعري بِقافيَةٍ","نَبَّتُّ فيها بديعَ القَولِ تَنبيتا",90,"ت",2,0],["وقد خاب شخص ظن بالعشرة أنه","حوى عرف من ماشاه من أهل عرفان",91,"ن",1,0],["وقد خاب مغرور بفطنة عقلة","اذا استقرب القاصى وعف عن الدانى",91,"ن",2,0],["وَقد خَبَرت مِن حالتيكَ تكرّماً","وَرِفقاً وَإِسراعاً إِلى ما يُفيدها",92,"د",3,0],["وَقَدْ خَلَعْتُ حَيَاءً","أَمَالني عَنْكَ صَدَّا",93,"د",2,0],["وَقد خَجَلَ الوَرْدُ مُذْغِبْتَ عَنَّا","وَكاد يَكونُ شَقِيقَ الشَّقِيقِ",94,"ق",1,1],["وَقَد خَلَعتُ الحَيا عَنّي وَأَلبَسَني","مَذَلَّةَ النَفسِ فيهِ عِزُّ مَطلوبي",95,"ب",2,0],["وقد ختَمتْ منّي على كُلِّ ناظرٍ","وما كنتُ للمُستَوْدِعينَ بخَوّان",96,"ن",1,0],["وقد خلَصتْ فيه نَجيّاً عيونُنا","فما غادرَتْ في القَولِ من مُتردَّم",97,"م",1,0],["وقد خَطّأَتْ فَتْحَ حَرْفِ الرَّويِّ","فَضَمّتْ أَواخِرَ إطلاقها",98,"ق",3,0],["وقد خلَطوني بالنّفوسِ كأنّما","نَماهُم أَبو الأقيالِ عَمْروٌ وعامر",99,"ر",1,0],["وَقَد خَفَقَت راياتُهُ فَكَأَنَّها","أَنامِلُ في عُمرِ العَدُوِّ تُحاسِبُه",100,"ب",2,0],["وقد خَصَّ من بين التلاميذ بطرساً","زعيمَهم ذاك الشفيعُ المُشفَّع",101,"ع",1,0],["وقد خفقت بنود الجَورِ نصراً","وقدماً أخفقت منه البنود",102,"د",1,0],["وقد خدعتْهم عند إسعادهم لها","كخدع قصير عند حيلته الزَّبا",103,"ب",2,0],["وَقَد خُضِّبَت أَسيافَه فَكَأَنَّها","مِنَ الدم جَمرٌ وَالغُبارُ رَمادُ",104,"د",1,0],["وقد خابَ ساعٍ أَبْصَرَ البحر خلفه","إلى جرعة يروي بنهلتها الصدى",105,"د",2,0],["وقد خمدتْ نار القِرى دون طارق","فلا جود للجدوى ولا نار للقرى",106,"ر",2,0],["وقد خَلَعَتْ منه المعالي فؤادها","وإنسانُ عين المجد بالدَّمع عائم",107,"م",1,0],["وقد خلق الله كلتيهما","لحتف دنا أو لرزقٍ قسم",108,"م",1,0],["وقد خلّفتْ فينا أياديهِ روضة","سَقاها سحابُ العوجدِ غيث المدامع",109,"ع",1,0],["وقد خطبت منك المعالي مدائحاً","مهرن فجلّت عن قليل من المهر",110,"ر",1,0],["وقد خلقت قبل خلق الزمان","فجاءت لذاك تعُدّ الحقَب",111,"ب",1,0],["وَقَدْ خَفَقَتْ عليكَ بنودُ عِزٍّ","عَلَتْ واللهُ أَعلاهَا ويُعلي",112,"ل",2,0],["وَقَدْ خَسَفا كُرُنَّةَ بالعَوَالِي","وبُوغَةَ بادِئَيْنِ وعائِدَيْنِ",113,"ن",1,0],["وَقَدْ خَيَّلَتْ طُرْقُ المَجَرَّةِ أَنَّها","عَلَى مَفْرِقِ الليلِ البهيمِ قَتِيرُ",114,"ر",1,0],["وقد خافت جفوني النوم فيها","فليس كرى ولا عنها كراء",115,"ا",2,0],["وقد خشيت بأني من تسببها","يوم القيامة أن أصلى على اللهب",116,"ب",1,0],["وقد خاب في أعماقه ما يطنه","ولم يحترس صرم الرجال المحززِ",117,"ز",1,0],["وقد خلصت طويتها جمالا","فلا حرج إذا اسود المحيا",118,"ي",2,0],["وقد خلَّفتني من كفِّ دهري","بطول الصدِّ في أَسرٍ لئيمِ",119,"م",1,0],["وقد خفقت تهفو برايات نصركم","رياحُ العلا منها صَباً وشَمالُ",120,"ل",1,0],["وقد خذل الأيام رأياً وفطنةً","كما خذل الأبطال حرباً وروعا",121,"ع",2,0],["وقد خفقت تحت السيوف قلوبهم","كما اضطربت تحت النصال العوامل",122,"ل",1,0],["وقد خانني صبري وما حمَّت النوى","فما قام عني المجد أن خانني الشكر",123,"ر",1,0],["وقد خضبت كفّ الثريا بردعها","ولاح هلالٌ كالقلامة من ظفر",124,"ر",1,0],["وقد ختمت بمسك عبقري","فقلت تمدنا للفكر مرسي",125,"س",2,0],["وقد خدشوا فيما رمتهم به فتا","وي أمثالهم إذ صاروا بين الجنادل",126,"ل",1,0],["وقد خلفتنا بالشعاب وما رثت","على من رمته النائبات بطعان",127,"ن",1,0],["وقد خلع التأييد فوقك حلة","وطرز بالإحسان والعدل والبر",128,"ر",1,0],["وقد خدمت سلطانك الأرض والسما","فأنوارها تسري وأنهارها تجري",128,"ر",2,0],["وَقَد خَرَجت مِنهُ إِلَيكَ فَلا تَكُن","بِمَوضِع بيضات الانوقِ من الوَكر",129,"ر",1,0],["وَقَدْ خَرَقُوا بِذَا الإجماعِ حَقّاً","وكُلُّ العالَمينَ بهِ شُهُودُ",130,"د",1,0],["وَقَدْ خَبِرتُ الوَرَى في كُلِّ حادِثَةٍ","فَلَمْ يكُنْ عِنْدَهُمْ في مَطْلَبٍ أَرَبُ",131,"ب",1,0],["وقد خفّ الأُلى كان","لَهمْ كالخِيسِ خَفّانُ",132,"ن",1,0],["وقد خَبَروني كلَّ يومٍ وليلةٍ","فَما أَنكروا منّي ولا كرهوا طعمي",133,"م",2,0],["وقد خبّر النيروزُ أنّ قدومَه","يُنيخُ السُّعودَ الغُرَّ فوق رجالكا",134,"ك",2,0],["وقد خطف الموتُ كلَّ الرّجالِ","ومثلك من بيننا ما خَطَفْ",135,"ف",1,0],["وقد خبا لِي الجمرَ في طيّهِ","لوامعٌ يُنذرنَ بالجَمْرِ",136,"ر",1,0],["وقد خفي عبدك عن نفسه","يا من هو الظاهر في غيبه",137,"ب",2,0],["وقد خلق الكل من أجلنا","ومن أجله الخلق منا استتم",138,"م",1,0],["وقد خص الإله رجال صدق","بما قد خَصَّ من كرم وجود",139,"د",1,0],["وقد خلَّد الطُّوسيُّ ما قد ذَكَرْتُه","ولكنَّه نحْو التَّصرِّف قد حَنَّا",140,"ن",2,0],["وَقَدْ خَلَعْنَا فَلاَ رَقِيْبٌ","يُخْشَى وَلاَ عَاذِلٌ يُطَاعُ",141,"ع",1,0],["وقد خانَني واللهِ عَقْلي بحُبِّهَا","فلا يغْتَرِرْ بعَقْلِهِ أَحدٌ بَعْدِي",142,"د",2,0],["وقد خُنْتُها في الوُدِّ إِذْ قِيل إِنَّها","كشمْسِ الضحى جَهْلاً فقلت كما قالوا",143,"ل",3,0],["وقد خَرِبَتْ أَعمالُهم بعُتُوِّهم","وشادَت له الأَعمالَ بالعدْل أَعْمالُ",143,"ل",1,0],["وقد خلفوا في دراهم خشية العدى","وكيداً وإرهاباً لكل مكائد",144,"د",1,0],["وَقَد خَطَبوا في الأَرضِ بِالحَقِّ مَن عَلى","مَنابِرِ عِزٍّ مِن مُتونِ الصَواهِلِ",145,"ل",1,0],["وقد خانتِ الدنيا قُرونا تتابعوا","كما خَانَ أعلى البيتِ يوماً أسَافِلُه",146,"ل",2,0],["وقَد خَتَلَتنَا باللَّطِيفِ مِنَ الهَوَى","كَما يَختِلُ الوحشيَّ بالشيء خاتِلُه",146,"ل",2,0],["وقد خذلوه وقد أسلموه","وغدرتهم لم تزل واضحه",147,"ح",2,0],["وقد خَدَمت هُوجَ النّعاجِ كباشُها","ضَياعاً ودانت للبُغاثِ صُقُورُها",148,"ر",3,0],["وقد خلطت في خلط كل مخلط","وورطها في الوهم كل مورط",149,"ط",1,0],["وقد خُنِقَت بالتَّبرِ حتّى كأنّما","تهمُّ بأن تشكو لهُ ضائق العَقدِ",150,"د",1,0],["وقد خَبَّرتُ أنك حارثي","فردّ مقالتي أولادُ كعب",151,"ب",1,0],["وقد خَزيَ الخَزُّ لمّا علاكَ","كما السَّكبُ أدْمعُهُ تُسكبُ",152,"ب",1,0],["وقد خلفت أسراب جون من القطا","زواحف إلا أنها تتزغم",153,"م",1,1],["وقد خصصت بقطار الحديد","فيسبق ما سار فوق الثرى",154,"ر",2,0],["وقد خُيِّبْتَ في سهم وترس","كما خيبت في قلم وطرس",155,"س",1,0],["وقد خجلت مصر مما انتهوا","إليه وما يعرفون الخجل",156,"ل",1,0],["وقد خاط الربيع لها ثياباً","لها وجهان من خضرٍ وصفر",157,"ر",1,0],["وقد خَوَّلْتُهُ شعري","وشعري أيما شعر",158,"ر",1,0],["وَقَد خَطَبتك الآنَ يا بَعل أُختها","فَكُنتَ لَها المَخطوبَ وَالصّهر والسِّلفا",159,"ف",2,0],["وَقَد خَرَّتِ الأَصنامُ عَن بَيتِ رَبّنا","وَإِيوان كِسرى شُقَّ بَل بَعضُهُ هُدّا",160,"د",2,0],["وَقَد خَلّصت جزِّيناً وَبرجا","وَإِتباعاً لَها حقّاً يَقينا",161,"ن",2,0],["وَقَد خَطَّ بِالخطّي أَوراقَ صَدرِهِم","وَقَد خَطَّ في رقّ المَناحِرِ بِالهِندي",162,"د",2,0],["وَقَد خِلْتُها كُرسِيَّ خَدِّ حَبيبَةٍ","وَأَمسَكَها صَبٌّ بِكلِّ الأَصابِعِ",163,"ع",1,0],["وَقَد خَضَب البيض النَجيعُ كَأَنَّهُ","رَقاشٌ وَأَطراف السُيوف مَعاصمُ",164,"م",1,0],["وَقَدْ خَلَّفُوني وَالْفُؤَادُ مُعَلَّلُ","نَعِمْتُ بِهِمُ دَهْراً فًلَمَّا تَرَحَّلُوا",165,"ل",3,0],["وَقَدْ خَفَّ مِنْ أَوْزَارِهَا مَا تَحَمَّلَتْ","ظَهِيرُ الْبَرَايَا وَالْمَوَاقِفُ أَعْضَلتْ",166,"ت",1,0],["وَقَدْ خَلَّفُولي الْجِسْمَ وَالْقَلْبَ عِنْدَهُمْ","ضُرِبْتُ بِسَيْفِ الْهَجْرِ فَازْدَدْتُ بَعْدَهُمْ",167,"م",1,0],["وَقَدْ خَصَّهُ الْمَوْلى بِغُفْرَانِ ذَنْبِهِ","زَرَعْتُ بِقَلْبي وَاعِداً وَعْدَ حُبِّهِ",168,"ه",1,0],["وَقَدْ خَصَّهُ فِيمَا أَشَارَ بِرَمْزِهِ","بِهِ يَتَحَلى نَاظِرُ الْمُتَنَزِّهِ",168,"ه",1,0],["وَقَدْ خَصَّهُ البَارِي بِعِزٍ وَنِعْمَةٍ","وَطَهَّرَهُ مِنْ كُلِّ عَيْبٍ ونِقْمَةٍ",169,"ه",1,0],["وَقَدْ خَصَّهُ بِالْقُرْبِ عَنْ كُلِّ مُرْسَلٍ","مَنَاقِبُهُ لَمْ يُحْصِهَا حَصْرَ مُجْمَلِ",170,"ل",1,0],["وَقَد خَلَّلتها لِلعُيونِ جَدَاوِلٌ","يُجَعِّدُها مَرُّ النَّسِيمِ الَّذي يَسري",171,"ر",2,0],["وقد خطبت فوق المنابر باسمه","وسكته ضرباً دنانير عسجد",172,"د",1,0],["وَقد خفقت قلوبهمُ جميعاً","مَخافات الردى خفق البنودِ",173,"د",1,0],["وَقَد خَلَطنا بِنَسيمِ الصِبا","نَسيمُ راحٍ وَرَياحينا",174,"ن",2,0],["وقد خطَّتْ على خدَّيَّ وَسماً","وصار بوَجْنَتيَّ لها رسومُ",175,"م",1,0],["وقَدْ خانني شَرْخُ الشَّبابِ وَرَاعَني","مشيبٌ وَحالِي مِنْهُ شَرْخٌ بِلا خَاءِ",176,"ا",2,0],["وقد خاطبته بالوقار حجارة","وعضو خفي سمه وبعير",177,"ر",1,0],["وقد خاط الربيعُ لها ثياباً","لها لونانِ من بِيضٍ وخُضرِ",178,"ر",1,0],["وقد خاب الرجاء ترى إزالا","تلقفها الصدى وأجاب زالا",179,"ل",2,0],["وقد خاف نومي ان يبيت بمدمعي","غريقا فقد عاف التواصل والقربا",180,"ب",2,0],["وقد خلوت بها في وجه جارية","حسنآء تعجبني حبَّاً وأعجِبها",181,"ب",3,0],["وَقَدْ خِلْتُهَا أُمَّ البُحَيْرَةِ مُرْضِعاً","عَلَى ظَهْرِهَا اسْتَلقت وَيَا لَكَ مِنْ ظَهْرِ",182,"ر",1,0],["وقد خبرت نفسي عنك خيرا","وأحر بأن يصدقني العيان",183,"ن",1,0],["وقد خصه اللَه قدما بما","يفوق وما ليس يعطى أراد",184,"د",1,0],["وقد خلعَ الدينَ خَلْعَ النَجادِ","وقد أكل الدِّينَ أكلَ الرِّبا",185,"ا",1,0],["وقد خرسوا من نطق وحشيّة الظبا","ووقع الظبا فيهم وصارمة الذكر",186,"ر",1,0],["وقد خَلَونا وَجَوُّ الحُبِّ راقَ لَنَا","وراح عنا شَديدُ الخوفِ والحَذَرِ",187,"ر",1,0],["وقد خلفوا فينا إماما ومرشدا","يخوض بحارا في العلوم بلا طرف",188,"ف",1,0],["وَقَد خَلا زَمَنٌ لو تَصرِمينَ لَهُ","وَصلي لأَيقَنتُ أَنّي مَيِّتٌ كَمِدُ",189,"د",1,0],["وقد خلفت زوجاً فمن ستةٍ جرت","مقاسمها ما خبَّ آلٌ ملمعُ",190,"ع",1,0],["وقد خلعت دين الوقار صراحة","فخف ولكن للبذاء وقورها",191,"ر",3,0],["وَقَد خَرَّ لِلرَّحمنِ أَحمَدُ سَاجِداً","وَنُودِى لِتَرفَع وَاشفَعَن أَنتَ شاكِرُ",192,"ر",1,0],["وقد خلفت لي نشأ صغارا","لأعينهم كعيني انهمال",193,"ل",1,0],["وَقَد خَسِروا وَالدُنيا مَع الدينِ وَاِشتَرَو","بِعِزِّ التُقى المَحمودِ ذُلَّ المَآثِمِ",194,"م",1,0],["وَقَد خَطَبتُ إِلَيهِم مِن بَناتِهِمُ","حبلَى وَإِنّي لَها لا بُدَّ مَزفوفُ",195,"ف",1,0],["وقد خصه الله العظيم بليلة","على ألف شهر فضلت فلترصد",196,"د",1,0],["وَقَد خُبِّرتَ عَن نَشَبٍ قَليلٍ","فَهَل خُبِّرتَ عَن خُلُقٍ ذَميمِ",197,"م",1,0],["وقد خلت خيمك يأبى العتاب","فوا ضيعتي أذ أفيك العتابا",198,"ب",2,0],["وقد خرجت ليلى تخندف خشية","وكادت لعمري ينبت عمران تسلب",199,"ب",1,0],["وقد خوّلتني منة بعد منة","يداك بواف من نداك ووافر",200,"ر",1,0],["وَقَد خَسأت عُيون الشُرك عَنا","تحاذر مِنكَ إِفرَنج وَرُوم",201,"م",1,0],["وقد خِفتُ أن ألقى المنايا وإنّني","لَتابِعُ من وافى حِمامَ الجوالب",202,"ب",1,0],["وقد خلفت فيهم من اراه","معي وان أيممه أمامي",203,"م",2,0],["وقد خفقت من نحو نجد أريجةُ","إذا نفحتُ جاءت بريا القرنفل",204,"ل",1,0],["وَقَد خانَ عَينَيهِ بَياضٌ وَخانَهُ","قَوائِمُ سَوءٍ حينَ يُزجَرُ في الوَحلِ",205,"ل",1,0],["وَقَد خَيَّروكَ فَإِن لَم تطِب","بِعرضِك نَفساً فَطِب بِالذَّهَب",206,"ب",1,0],["وَقَد خَتَمته بِالنَظير فَأَرخَت","قِران مَسَرات صفا بِكَ سَيد",207,"د",1,0],["وَقَد خَطرت تَتلو عَلَينا مَثانيا","تَهنى بِميلاد لِنَجل الأَكابر",208,"ر",1,0],["وقَد خَصَّنا بابنِ الأكارِمِ طالِبٍ","يَذُبُّ العِدا عن أَرضِنا وَيَذُودُها",209,"د",3,0],["وقَد خَتمَ الإِحسانُ فيهِم لَوَ اَنَّهُ","يَهُونُ بِهِ طُغيانُهُم وَجُحُودُها",209,"د",3,0],["وقد خضبت بالعطر ثم تدثرت","من عفرة يصبو الفتى لاصفرارها",210,"ر",3,0],["وقد خفِيا عن الرّقيب فما","نمّ بنا غيرُ نشرِه العَبِقِ",211,"ق",1,0],["وقد خضت في بحر تلاطم موجه","وأنت لدى الباحات منقطع السبح",212,"ح",1,0],["وقد خصك الباري بماخص نفسه","ومنك عرفناه فبان لنا الأمر",213,"ر",1,0],["وقد ختمت النظم بالصلاة","مع السلام في مدى الأوقات",214,"ت",1,0],["وقد خلعت بيض الايادي على الورى","وفي جنة الخلد اكتست سندساً خضرا",215,"ر",2,0],["وقد خلقت صريحا","فزدت في أعدائي",216,"ي",1,0],["وقد خصك المولى بكل مبرة","وتكرمة لم يحظ قبلاً بها الغير",217,"ر",1,0],["وقد خملت بعد النباهة والعلا","وقد املقت بعد الرغائب والجدا",218,"د",2,0],["وقدْ خَرَقت بُطُونَ الأرضِ عن نُطّفٍ","من أعذَبِ الماءِ نحوَ البَيْت نُجْريها",219,"ي",3,1],["وَقَدْ خُولطت نفسي بذكرى مَعاهِدي","وأيامِ صَفْوٍ كنتُ دهراً أَسودها",220,"د",3,0],["وقد خالط الفجر الظلام كما التقى","على روضة خضراء ورد وادهمُ",221,"م",1,1],["وقد خاضوا عباب الموت صبرا","وما بالحرب فيهم من جزوع",222,"ع",1,0],["وَقَد خَضَّبوا وَجهَ اِبنَ عُلبَةَ جَعفَرٍ","خِضابَ نَجيعٍ لا خِضابَ دِهانِ",223,"ن",1,0],["وقد خفيت جسماً ورقت كأنها","ذما حَوَرٍ أو ما يجسمه الشنب",224,"ب",1,0],["وقد خَلَت أَوجُهُها","من الخِلالِ الفائقه",225,"ق",2,0],["وقد خَطَّت يَدُ الأَيَّامِ خطّاً","بفَودِكَ مُذ بدا وَخطُ المَشِيبِ",226,"ب",1,0],["وقد خفقت منهم قلوب كأنها","سهيل إذا ما اشتد من خوفهم ذعر",227,"ر",1,0],["وقد خيمت كي يستريح ركابها","فلا فلك جارولا كوكب ساري",228,"ي",1,0],["وقد خطبوا العلياء وهي عزيزة","وما بذلوا غير الأسنة من مهر",229,"ر",1,0],["وَقَد خَلَتِ الأَفكارُ عَن كُلّ شاغلٍ","فَلا عاذلٌ غرٌّ وَلا الهَمُّ جالغُ",230,"غ",1,0],["وقد خرجت إلى المكسيك ينصرني","على الأسى هزج الأشعار والنعم",231,"م",1,0],["وقد خانني صبري الجميل فذقت من","مراراته ما كان من دونه الصبر",232,"ر",1,0],["وَقَد خِلتُها المَرّيخُ مِن بَعدِ مَزجِها","بَريقٌ تَروحُ الراحُ مِن مَزجِهِ سَكرى",233,"ر",2,0],["وقد خلتكم عَوْناً لكلِّ مصيبةٍ","فكنتم على بختي يداً للنوائب",234,"ب",1,1],["وقد خلعَ المولى عليهِ وآدَمٌ","بطينٍ نُبُوءَةً كما قال من روى",235,"و",2,0],["وقد خط المشيب بفود رأسى","سطورا أنهكت منى العظاما",236,"م",2,0],["وَقَد خُضِبَت بِالماءِ حَتّى كَأَنَّما","تَشَبَّهُ كُمتَ الخَيلِ مِنهُنَّ سودُها",237,"د",3,0],["وقد خطبت يا سعيد خِطبه","للمَصدر اكسرها والاسم الخُطبه",238,"ه",1,0],["وقد خفرته إذا أجرته","خُفارة وخُفرة بيّنته",239,"ه",1,0],["وَقَد خَيَّمَ الصَمتُ الهَتوفُ مَعَ البِلى","عَلَيكِ وَأَرواحُ الدُجى تَتَنافَرُ",240,"ر",1,0],["وَقَد خَفَقَت بَينَ العَرائِسِ نَسمَةٌ","يُعابِثُها في غَفوَةِ الفَجرِ ثامِرُ",240,"ر",1,0],["وَقَد خَيَّمَت فَوقَ العَرائِشِ وَحشَةٌ","وَصَمتٌ عَلى أَوراقِها الصُفرِ ناشِرُ",240,"ر",1,0],["وَقَد خَرَجَ الخُفّاشُ يَهمِسُ في الدُجى","وَدَبَت عَلى الشَطِّ الهَوامُ النَوافِرُ",241,"ر",1,0],["وَقَد خارَتِ الأَعصابُ مِنكَ وَلَم تَعُد","بِها فَضلَةً تَطوي عَلَيها الجَوانِحُ",242,"ح",1,0],["وَقَد خيم الحزن المجسم فوقهم","وواها اذا الحزن المجسم خيما",243,"م",2,0],["وقد خال زفس برى دونه","عماد القتال لنصر العدى",244,"د",2,0],["وَقَد خشعوا من هيبة فَتراهم","وان لَم يَكونوا ساجِدين كسجد",245,"د",1,0],["وقد خر الجبال الشم هدا","وقد أبدى الحمام له الزنينا",246,"ن",2,0],["وَقَد خَنَقَتها عَبرةٌ فَدموعُها","عَلى خَدّها بيضٌ وَفي نَحرِها صُفرُ",247,"ر",1,0],["وقد خَلتْ منهمُ المغاني","وأَقفرتْ منهمُ المنازلْ",248,"ل",1,0],["وقد خشعتْ أَصواتُ أَبطالها فما","يعي السّمعَ إلاَّ من صليلِ الظُّبى هَمْسا",249,"س",2,0],["وَقَد خَبَرتك يا ثَغ","ر بِسمة وَاِفتِرارا",250,"ر",2,0],["وَقَد خَرَجَت قُلوبُهُمُ فَماتوا","عَلى إِخوانِهِم وَهُمُ صِحاحُ",251,"ح",1,0],["وقد خان دهري وانقضى العمر بالجفا","ومن اكبر الآفات في مثله العمر",252,"ر",1,0],["وقد خلعت كف الربيع على الربا","خلاخل وشي من ملابسها الخضر",253,"ر",1,0],["وقد خلفت ولداً باسلاً","فصيحاً إذا ما قرا أو خطب",254,"ب",1,0],["وَقَد خَبا الجِدالُ","وَاِنقَطَعَ المَقالُ",255,"ل",1,0],["وقد خرس اللسان وثم فاهتْ","جوارحُه بأفعال الخناء",256,"ا",2,0],["وقد خلَّفَتْهُ وعمًّا لها","وأمًّا وأختاً لأم عَرُوب",257,"ب",1,0],["وقد خُضْتُ أقفو إثره لم أقف له","على خبر يُؤْتَى ببعد ولا قرب",258,"ب",1,0],["وقد خبزته سليمي الهموم","بمسجور تنورها المصطلى",259,"ل",2,0],["وقد خضبته أكف الغموم","خضابا إلى الحشر لم ينصل",259,"ن",3,0],["وقد ختمت بالمسك قد ضاع نشره","وحاشا أخ الفضل العميم يضيعها",260,"ع",3,0],["وقد خشيت من الأيام تمنعني","عن الوصول لباهي النور والشيم",261,"م",1,0],["وقَد خانكُم حتى عَلِمتُم بأنَّهُ","بَليدٌ يَرَاكُم نُسخةً مِن بَلادَتِهْ",262,"ت",2,0],["وقد خطا وسعى ريب المنون لمن","بصدره الرحب هول الدهر قد وسعا",263,"ع",2,0],["وقد خفقت بالعز رايات سوددٍ","أنيط على هام الثريا لواؤها",264,"ا",3,0],["وقد خضعت لك الفضلاء طرا","فأنت لفضلها العقد الفريد",265,"د",1,0],["وقدْ خِلتُ عُرْقوبًا مِثالًا لوَعْدِها","وإذْ بي أرَى نجْمًا سُهيْلًا أمامِيَا",266,"ي",2,0],["وقد خفضت جناح الذل شكرا","فقد كانت ولم تملك جناحا",267,"ح",2,0],["وقد خلعت على أعطافهم حللاً","من البيان فلم يمسسهم العدم",268,"م",1,0],["وقد خشي السماء فبات عنها","يحجب موجه تحت الضباب",269,"ب",1,0],["وقد خلا الحي إلا من سواسيةٍ","في الغي يغمسهم في الغي إغراء",270,"ا",2,0],["وقد خاضَ الأَكَابِرُ في هُرَاءٍ","فَيُمْضُونَ الفَتَاوَى كيفَ شَاءُوا",271,"ا",1,0],["وقد خلطوا صبراً يشكر ورابطوا","وغيرهم يعطى ويحبى ويهرب",272,"ب",1,0],["وقدْ خلصتُ نجيَّ الراحلينَ نوىً","من ذا كمثلي لناءٍ في البعادِ نجي",273,"ج",2,0],["وَ قَدْ خَبِرْنَا ضُرُوباً مِنْ تَعَنُّتِهِ","فَمَا دَعَوْنَا بِأَنَّ الله يَهْدِيهِ",274,"ي",2,0],["وقد خدمتنا ملوك الزمان","وقد قصدتنا من العدوتين",275,"ن",1,0],["وقد خلق الإنسان في هذه الدنيا","يكابد فيها للنكود الشواغل",276,"ل",1,0],["وقد خصك الرحمن منه برحمة","فأعلى بك الإسلام بعد التضاؤل",277,"ل",1,0],["وقد خاب مسعى كل حبر وجهبذ","وقد سلكوا نهجاً من الغي مظلما",278,"م",2,0],["وقد خرجوا عن منهج الحق والهدى","إلى دين عباد القبور ذوي الطرد",279,"د",1,0],["وقد خصه المولى بما لم نحط به","ونحصيه علماً أو حساباً محددا",280,"د",2,0],["وقد خاضوا للجته عباباً","وساروا نحو زاخره وعام",281,"م",1,0],["وقد خلت أن الربع أقفر منهمو","فأجريت أقلاماً من الجهل والعمى",282,"م",2,0],["وقد خضت الدنا شرقا وغربا","يعانق رسمه قلبي وعيني",283,"ن",2,0],["وقد خشعت لنورهم الحنايا","وهم سكنٌ لروحي كم يطيبُ",284,"ب",1,0],["وقد خلع الحياة بذات عشق","وجاء الحب ممتثلا رضاه",285,"ا",2,0],["وقد خاب شخص ظن بالعشرة أنه","حوى عرف من ما شاء من أهل عرفان",286,"ن",1,0],["وقد خلعتْ ذاك الوشاح غريرةً","بوجهٍ بهِ قد بدلتْ قمر السما",287,"م",2,0],["وَقَدْ خَسَفَ البَدْرُ التَّمامُ لِمَوْتِهِ","وَشُهْبُ الدُّجَى فِي غَيْهَبِ الجَوِّ كُدَّرُ",288,"ر",1,0],["وَقَدْ خَانَ عَيْنَهِ بَيَاضٌ وَخَانَة","ُ قَوَائِمُ سَوءٍ حِينَ يُزْجَرُ فِي الوَحْلِ",289,"ل",1,0],["وقد خلفته في الفلك ليلا","تكاد به على المدأما تطير",290,"ر",1,0],["وقد خفقت تنادي في سرورٍ","أيا بيروت يهنيك السلامُ",291,"م",1,0],["وقد خضّبتْ بالنصر شيبات مفرقي","سنيناً على الاهوال منتصراتِ",292,"ت",1,0],["وقد خارت عزائمنا وصرنا","على أهوائنا متفرّقينا",293,"ن",2,0],["وقدْخسرَ الذي يسعى لشرٍ","بقبحِ الفعلِ أو قبحِ اللسانِ",294,"ن",1,0],["وَقَدْ خَصَصتُ لَهُ شِعرِي فَأَنكَرَهُ","وَباعَنِي , وَدَواوِيينِي تُغازِلُهُ",295,"ل",2,0],["وَ قَدْ خارَتْ أَمانِيُّ اشتِياقي","فَجَمَّدَتِ العُرُوقَ وَ ما يُراقُ",296,"ق",1,0],["وقد خمر الغرام منّا عقولنا","كأنَّنا في خبل وليسَ بنا خبلا",297,"ل",2,0],["وقد خلع التأييد فوقك حلةً","تطرز بالإحسان والعدل والبر",298,"ر",1,0],["وقد خَوَّفُونى من حُتوفٍ تأَجَّلَتْ","وما الحتفُ ما الآجالُ في مُعجمِ العِبَرْ",299,"ر",1,0],["وَقَدْ خَرَّ مِنْهُمْ رَاجِلَانِ وَفَارِسٌ","كَمِيٌّ صَرَعْنَاهُ وقَرْمٌ مُسَلَّبُ",300,"ب",1,0],["وقدْ خافَ دهرٌ ألحقَ الأبعدينَ بي","وَعَدْلُكَ لاَ يَرْضى وَفَضْلُكَ بِي أَحْفا",301,"ف",2,0]]}