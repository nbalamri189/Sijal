{"poems":[[39,"تمشي بها ربد النعام","https://www.aldiwan.net/poem7180.html","مجزوء الكامل"],[53,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[87,"قام من علته الشاكي الوصب","https://www.aldiwan.net/poem62920.html","الرمل"],[64,"نجومنا سبعة في الكتب قد وضعت","https://www.aldiwan.net/poem52171.html","البسيط"],[69,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[78,"قصد المنون له فمات فقيدا","https://www.aldiwan.net/poem39456.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[69,"إنْ يدْعُهُ الإنجيلُ فارقليطهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14559",""],[275,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[371,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[447,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[484,"طلع الصباح فأشرقت","https://www.aldiwan.net/poem36930.html","مجزوء الكامل"],[505,"عهدت طريقتنا أصولا خمسة","https://www.aldiwan.net/poem37962.html","الكامل"],[505,"محاضر القوم لا تترك بها الأدبا","https://www.aldiwan.net/poem38080.html","البسيط"],[563,"عجبت من شيئين قد أجمعت","https://www.aldiwan.net/poem34079.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122805","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48837","الخفيف"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82301","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50026","المتدارك"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141348","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101890","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118344","الوافر"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131329","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/199974","الكامل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124768","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99078","البسيط"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2712,"","https://poetry.dctabudhabi.ae/diwan/poem/105722","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205855","الخفيف"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105093","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205550","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117852","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111393","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90965","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90811","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81237","الخفيف"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/205870","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28685","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28663","الهزج"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58054","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120499","الكامل"],[4702,"\" غبار الجهل \"","https://www.poetsgate.com/ViewPoem.aspx?id=155049",""],[4767,"دوحة الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179942",""],[4888,"الشاطئان مصر والإمارات","https://www.poetsgate.com/ViewPoem.aspx?id=207744",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5183,"الصاروخ","https://www.poetsgate.com/ViewPoem.aspx?id=180184",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5261,"رمضان الخير","https://www.poetsgate.com/ViewPoem.aspx?id=212889",""],[5363,"يا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=144178",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5652,"معالي / توفيق الربيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177752",""],[5720,"عيدٌ . . ويومٌ للبلاد","https://www.poetsgate.com/ViewPoem.aspx?id=199361",""],[5751,"المختلف","https://www.poetsgate.com/ViewPoem.aspx?id=214782",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[6070,"القولُ أصنافٍ كما ثَبتَ الدَّليلْ","https://www.poetsgate.com/ViewPoem.aspx?id=188866",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6225,"إلزام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80957&r=&rc=226",""]],"verses":[["والأخدريَّ بعانتيه","خليط آجال وباقرْ",0,"ر",1,0],["والأخ المخلص إن أقذيتَه","فالقذى فيك إلى أن يُنتزع",1,"ع",1,0],["وَالأَخضَرِ المورِقِ في يابِسٍ","أَو مِثلِ صاحٍ بَينَ نُوّامِ",2,"م",1,0],["وَالأَخُ الصادِقُ في الوُدِّ إِذا","ظَهَرَ الإِخوانُ بِالوُدِّ الكَذِب",3,"ب",1,0],["والآخر المظلم النحس الذي خفيت","فيه السعود فإرغام وإنعامُ",4,"م",1,0],["والآخِرونَ الأَوَّلونَ فَقَوْمُهُ","أَخَذُوا عَلَى العَمَلِ القَلِيلِ جَزِيلا",5,"ل",2,0],["وَالأخْفَشَينِ فَصاحَةً وَبَلاغَةً","والأَعشَيَيْنِ رِوايَةً وَنَشيدا",6,"د",2,0],["والإخاءُ الحرّ ما كان سوى","مدفعٍ يرمي بمرد ومبيد",7,"د",1,0],["والآخرونَ الأَوَّلونَ فقومهُ","وَعَلَى الجَمِيع لَهُ الأَيادِي الطُّولَى",8,"ل",2,0],["والأخطلُ المختالُ يترعُ كأسَهُ","ويقولُ يا دنيا لشعريَ ميلي",9,"ل",2,0],["وَالإِختِصارُ كَما يُقالُ بَلاغَةٌ","لَكِن وَلا ذا الإِختِصارُ بِمِرَّةِ",10,"ه",1,0],["والاخوة الأبرار والأعمام هم","نعم الخلائف نهجهم متبوع",11,"ع",1,0],["والآخرون مؤخرو","ن وللعقوبة في انتظار",12,"ر",1,0],["والأَخذُ بالشَّرْعِ الشَّريفِ تحَقُّقاً","رَغماً لمن بالزُّورِ والشَّطْحِ اكتَفَى",13,"ف",2,0],["والآخِذونَ إلى ربِّ العُلى سبباً","ياما أُحيلاهُ في تعريفِهِ سبَبَا",14,"ب",2,0],["والآخر الحق الوجود الذي","قَدَّر كل الخلق بالإنتظام",15,"م",1,0],["والأَخضَرُ السَّوحِ والأَيامُ قاتِمَةٌ","والأَبيَضُ الجُونُ تَحتَ العارِضِ الجُونِ",16,"ن",1,0],["والأخ الحامل المعاذير أهل","من أخيه أن لا يرى هجرانه",17,"ن",2,0],["وَالاََخْذُ وَاسْتِنْباطُها لا يُعْلَمُ","إلاّ لِشَخْصٍ بِالْجَمِيْعِ يَعْلَمُ",18,"م",1,0],["والأخذ فيه عن قريش قد وجب","لأنّهم اشرف بيت في العرب",19,"ب",1,0],["وَالآخَرُ النَبَطِيُّ وَالر","رومِيُّ أَيضاً وَاِبنُ حامِ",20,"م",1,0],["والآخِرُ بعدُ بلا أَمَدٍ","والأوّلُ قبلُ على القدمِ",21,"م",1,0],["والآخر اتّخذ الشّنار","فبئس خطّته الوبيقة",22,"ق",2,0],["والأخت في المرتبة المتصله","بما له تضاف لا المنفصله",23,"ه",1,0],["والا خليني وخلاك ذم","فان لدى احداقا غيرارا",24,"ر",2,0],["والأخرى جنانٌ للعامِل","ونعيمٌ يبقى فاستَقمِ",25,"م",1,0],["والاختصارُ بالمقامِ أليقُ","والحمد هو المُوَفِّقُ",26,"ق",1,0],["والآخَرُونَ أبَوا وَقَالُوا شَطرُهُ","خَلقٌ وَشَطرٌ قَامِ بالرَّحمنِ",27,"ن",1,0],["والآخَرُ المعنَى القَدَيمُ فقَائِمٌ","بالنَّفسِ لَم يُسمَع مِنَ الدَّيَّانِ",27,"ن",1,0],["والآخرُونَ أبَوا وَقَالُوا إنَّمَا","جِبرِيلُ أنشَاهُ عَنِ المنَّانِ",27,"ن",1,0],["والآخَرُونَ يَرَونَ هَذَا البَحثَ لَف","ظِيًّا ومَا فِيهِ كَبِيرُ مَعَانِ",27,"ن",1,0],["وَالآخَرُونَ أولُوا الحَدِيثِ كأحمَدٍ","ومُحَمَّدٍ وأئمةِ الإِيمَانِ",27,"ن",1,0],["وَالآخَرُ التَّكلِيمُ مِنهُ بالوَسَا","طَةِ وَهوَ أيضاً عِندَهُ ضَربَانِ",27,"ن",1,0],["وَالآخَرُونَ رَأوهُ أمراً حَادِثاً","بِالذَّاتِ قَامِ وَأنَّهُم نَوعَانِ",27,"ن",1,0],["وَالآخَرُونَ أولُوا الحَديثَ كَأحمَدٍ","ذَاكَ ابنُ حَنبَل الرِضَى الشَّيبَانِي",27,"ن",2,0],["وَالآخَرُونَ أولُو النِّفَاقَ فَأضمَرُوا","شَيئاً وَقَالُوا غَيرَهُ بِلِسَانِ",27,"ن",1,0],["وَالآخَرُونَ أتَوا بِمَا قَد قَالَهُ","مِن غَيرِ تَحرِيفٍ وَلا كِتمَانِ",27,"ن",1,0],["والآخِرَانِ هُمَا اللَّذَانِ عَلَيهِمَا","دَارَت رَحَى الحَربِ الَّتِي تَرَيَانِ",27,"ن",1,0],["والآخرُونَ فَأهلُ عَجزٍ عَن بُلُو","غِ الحَقِّ مَع قَصدٍ وَمَع إيمَانِ",27,"ن",1,0],["وَالآخرونَ فَطَالِبُونَ الحَقَّ لَ","كِن صَدَّهُم عَن عِلمِهِ شَيئَانِ",27,"ن",1,0],["والآخرون فعطّلوا ما جاء في","القرآن أقبح بالمقال مقالا",28,"ل",2,0],["والاخوان معهم إن أكلت فانبسط","ووانس ولا تذكر كلاما ينكد",29,"د",1,0],["والأخدعان فما زالا يرى بهما","لكثرة المزح توريم وتحمير",30,"ر",1,0],["والأخضرُ اللون مع البياض","بكثرة البرد عليه قاض",31,"ض",1,0],["وإلّا خلّني أبكي نهاري","ولَيلي بالدموعِ الجارياتِ",32,"ت",1,0],["والأخلاء عاكفون على ذك","ر لياليك شاعراً خيّاما",33,"م",2,0],["والآخرون يرون يومك في الردى","رزءاً لشعب في العراق مضام",34,"م",1,0],["والاخوان احمد وعمر","وكان عنهما الكمال يؤثر",35,"ر",1,0],["وَالأخطبوت يَرى النمال بطيئة","في السير خَلف الرزق وَهوَ نَماء",36,"ا",2,0],["والإخاء المحض كم أبصرته","حيث لم أبصر له قط شبيها",37,"ي",3,0],["والآخذو إرث الرسول أجازة","وتلقيا من كابر عن كابر",38,"ر",1,0],["والآخرون نصوا","بأنها أخص",39,"ص",1,0],["وإِلاَّ خِلتَني أَعتاضُ قَسراً","بِمالِ أياسَ اوذِسَ أو بمالِك",40,"ك",1,0],["والأخ الجهبذ محي الدين أو","رثهم عن جده اسما ولقب",41,"ب",1,0],["والاختصار به البلاغة فاقبلوا","عذري فهذا ما بوسعي امكنا",42,"ن",2,0],["وَالأَخ الحبر وَالفَتى الإِلَهي","النَفس خلو مِن الحجى وَالضَمير",43,"ر",1,0],["والأخضرُ الرفّافُ ظلَّ سبيلَهُ","فاخضوضرتْ في زهرِها البسّامِ",44,"م",1,0],["وَالآخَرونَ عَلى النَّبيذِ عُكوفُهُم","شَتّانَ إِن قِسناهُما بِقِياسِ",45,"س",1,0],["وَإِلَّا خِفتُ أَن يُفسِ","دُنا الدَّينُ فَلا يُقضى",46,"ض",2,0],["والأخ اثنان أعطوه وذلكمُ","استحبابُ أهلِ الهدى والنورِ والبصرِ",47,"ر",1,0],["والاخسرون هم الذين تقاعسوا","عنها فعقبى امرهم تحسير",48,"ر",1,0],["والا خذتك ام الحمية والهواش","والا تحسبنك من السلطة تحوش",49,"ش",1,0],["والآخر احتل في شعبانَ منزلةً","في كل أفقٍ من الآفاق تشتهرُ",50,"ر",1,0],["والآخرُ البحرُ والشُّطآنُ تحضُنُهُ","والنَّخلُ فوقَ كثيبِ الرملِ تِيجانُ",51,"ن",1,0],["والآخرونَ السارقونَ تسوقُهم","أطماعُهم حتّى بمالِكِ أُغرِقوا",52,"ق",3,0],["والاختراع على البسيطة ماثل","فجماده كالمستبين القاري",53,"ر",2,0],["وَالأَخْشَبَانِ وَقَدْ قَالَ المَلاكُ لَهُ","إِنْ شِئْتَ صَارُوا بَقَايَا عَادَ أَوْ إِرَمِ",54,"م",1,0],["٧- والآخرون على حطام زائل","يتقاتلون كأنهم جرذان",55,"ن",1,0],["والأخطبوط ونجم البحر كم خشعا","مثل المصلين في الأعماق والأجمِ",56,"م",1,0],["والأخبار منها ذايع الصيت منتشر","فلا يختفي لو كاتب الخط شاطبه",57,"ب",2,0],["والآخر أكثر ذنب بين الكثيرين","الي دبوره من فعايل صغاره ..!!",58,"ر",2,0],["والآخرُ .. اليومُ الذي قامتْ به","هذي البلادُ .. بحكمةٍ ورشادِ",59,"د",1,0],["والأخوةُ الأعداءُ والغةٌ","بهِ خناجرُهم وتختلفُ",60,"ف",1,0],["والآخرونَ استنكروا .. وتوعدوا ..","بعدَ الحميّةِ قدَّموا نزراً يسيرْ",61,"ر",1,0],["والأخسرون ذوو التقصير ويلهم","لم يستجيبوا ولم يلجوا إلى وعد",62,"د",1,0],["والأخت وا لهفاهُ دام حنانُها","يغنيك أنت وسائر الأعمامِ",63,"م",1,0],["والآخرُ الموصوفُ سمٌّ ناقعٌ","يردي العَدوَّ منازعاً أو كالقتيلْ",64,"ل",1,0],["والآخر عظيمُ القدر يعجَب بحالهِ","وهذا جميدُ الفكر كأنهُ حزلا",65,"ل",2,0],["والآخرون تعصبوا بوقاحة","للكفر حتى أشربوه مخدرا",66,"ر",2,0],["والآخرُ الطفلُ الذي في خاطري","من ألفِ عامٍ فكرة لا تَكْبُرُ!",67,"ر",1,0],["والإخوة ُ, الأهلُ , الأخِلاءُ ؟ .. الصفا","بين الأحبَّةِ طبعهُ التقتيرُ",68,"ر",1,0]]}