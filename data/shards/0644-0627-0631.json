ِعَنَّ اليَومَ ذاتَ المبسِمِ","بِنتَ لُكَيزَ الوائِلِيِّ الأَرقَمِ",178,"م",1,0],["لا رَعى اللَّهُ لي متى لم يجد عَهْ","دَهُمُ في جوانحي مَرْعِيّا",179,"ي",2,0],["لا رَوْنَقٌ لهمُ يرضاهُ لِي بصري","ولا لهمْ عَبَقٌ يرضاه عِرْنِيني",180,"ن",2,0],["لا راعنا فيك الزّمان ولا رأتْ","عينُ اِمرئٍ شِعْباً حللتَ مُعَطّلا",181,"ل",2,0],["لا رَعى اللّهُ مَن إلى","قول واشٍ لنا صغى",182,"غ",2,1],["لا رَعى اللّهُ مَعشراً","صدّعوا ما تصدّعا",183,"ع",2,0],["لا رَعى اللّهُ للوُشاةِ ولا نا","دَوْا مجيباً في النّائباتِ سميعا",184,"ع",2,0],["لا رِيبةٌ في كلّ ذاك ولا","قُرْبٌ ولا قُبَلٌ على ثَغْرِ",185,"ر",1,0],["لا رابَنا فيك الزّمانُ ولم تزلْ","يفديك مِنّا كلَّ يومٍ فادِ",186,"د",1,0],["لا راعهمْ منك بينٌ","ولا رأوْا منك بُعْدا",187,"د",2,0],["لا ربه في النفس منه يَحْلُل","أو باتحاد فيه عنه يَجْلُل",188,"ل",1,0],["لا رؤية ولا شهودْ","في غير مرآة الوجودْ",189,"د",1,1],["لا رغبة لي في الحياة وطيبها","ومعذبي عن ناظري حجبوه",190,"و",2,0],["لا ربْعُ دارٍ عفا ولا طَلَلُ","أوْحشَ لمَّا نَأْتِ ملائِحُهْ",191,"ح",2,0],["لا رأي لي في جيادِ الخيلِ أَرْكَبُها","إذا نَهضْتُ فَعَزْمي خَيْرُ مَرْكُوبِ",192,"ب",1,0]]}