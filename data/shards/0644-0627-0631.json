ا ربه في النفس منه يَحْلُل","أو باتحاد فيه عنه يَجْلُل",184,"ل",1,0],["لا رؤية ولا شهودْ","في غير مرآة الوجودْ",185,"د",1,1],["لا رغبة لي في الحياة وطيبها","ومعذبي عن ناظري حجبوه",186,"و",2,0],["لا ربْعُ دارٍ عفا ولا طَلَلُ","أوْحشَ لمَّا نَأْتِ ملائِحُهْ",187,"ح",2,0],["لا رأي لي في جيادِ الخيلِ أَرْكَبُها","إذا نَهضْتُ فَعَزْمي خَيْرُ مَرْكُوبِ",188,"ب",1,0]]}