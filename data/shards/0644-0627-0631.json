wan.net/poem48198.html","عموديه"],[538,"دع البخلاء إذا شحوا وضنوا","https://www.aldiwan.net/poem56854.html","الكامل"],[539,"لأفرجن اليوم كل الغمم","https://www.aldiwan.net/poem677.html",""],[549,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[549,"رم النجاء عن الفحشاء والهون","https://www.aldiwan.net/poem47160.html","البسيط"],[549,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[549,"لا رعى الله من إلى","https://www.aldiwan.net/poem47407.html","مجزوء الخفيف"],[549,"بأبي وجهك الذي","https://www.aldiwan.net/poem47712.html","مجزوء الخفيف"],[549,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[549,"ضنت عليك ضنينة الخدر","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[549,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[556,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[556,"لا رؤية ولا شهود","https://www.aldiwan.net/poem34577.html","مجزوء الرجز"],[562,"لم تبكي مثلي يا حمام تشوقا","https://www.aldiwan.net/poem909.html",""],[565,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["لَاِرتَشَفَ الخَمرَ وَهوَ يَلفِظُها","لَوَ اِنَّ ما تُضمِرُ الكُؤوسُ دَمُ",0,"م",1,0],["لَأَراكَ في مِرآةِ جودِكَ مِثلَما","يَلقى العِيانَ الناظِرُ المُتَوَسِّمُ",1,"م",1,0],["لا رُزءَ أَعظَمُ مِن مُصابِكَ إِنَّهُ","وَصَلَ الدُموعَ وَقَطَّعَ الأَوصالا",2,"ل",2,0],["لَأُرحِلَنَّ المَطايا ثُمَّ أُبرِكُها","حَيثُ اِطمَأَنَّ النَدى وَاِستَوطَنَ الشَرَفُ",3,"ف",1,0],["لا رَوَّعَت سَرحَكَ المَنونُ وَلا","أَصبَحَ سِربٌ حَمَيتَ مَنهوبا",4,"ب",2,0],["لَأَرْتَدينَّ بِالظَّلْماءِ حَتّى","تَشُقَّ عَزائِمي ثُغَرَ الدَّياجِي",5,"ج",2,0],["لأَرْفَعُ عَنْ شَمَمٍ واضِحٍ","لِثامِي وَأَرْقَعُ وَهْيَ الحَسَبْ",6,"ب",1,0],["لأرْوَعَ حَجَّ بيتَ اللهِ يَطْوي","إليهِ نِياطَ أغْبَرَ صَحْصَحانِ",7,"ن",1,0],["لا رَغبَةً ليَ في النُّعْمى إذا نُسِبَتْ","لمْ تتّصِلْ بغِياثِ الدّولَةِ الحَسَنِ",8,"ن",1,0],["لا رَفَعتُ الحُسامَ في الحَربِ حَتّى","أَترُكُ القَومَ في الفَيافي عِظاما",9,"م",2,0],["لا رَعى اللَهُ عَهدَها مِن جُدودِ","كَيفَ أَمسَيتَ يا اِبنَ عَبدِ المَجيدِ",10,"د",1,1],["لا رَعى اللَهُ ساكِنَ القِمَمِ الشُم","مِ وَلا حاطَ ساكِنَ القيعانِ",11,"ن",1,0],["لا رَعى اللَهُ لَيلَتي في بُخارى","ذِكرُها ما حُيّيتُ حَشو ضَميري",12,"ر",2,1],["لَأَرتاحُ مِن أَسماءَ لِلذِكرِ قَد خَلا","وَلِلرَبعِ مِن أَسماءَ بَعدَ اِحتِمالِها",13,"ل",3,0],["لا رُوحَ فِيهَا غَيْرَ إِيمَاضَةٍ","مِنْ جَانِبِ الإِعْجَازِ فِيهَا تُشَامْ",14,"م",1,0],["لارَعى اللَهُ ياخَليلَيَّ دَهراً","فَرَّقَتنا صُروفُهُ تَفريقا",15,"ق",2,0],["لا ردَّ سهمك على نحرِ العداة ولا","نالوا من السهم ما راموا من الغرض",16,"ض",1,0],["لا رأيَ لي في الشامِ بعد ما دعى","أحبَّتي وسادتي الرحيل",17,"ل",1,1],["لا رقى سفح دموعي","في هوى تلك الثنيَّه",18,"ي",2,0],["لأرخص دمعي غداة السرا","تأرِّج أنفاسك العاليه",19,"ي",2,0],["لا رُزئْنَاكَ عَاتباً طلب العُت","بَى بِإعْفَا مَعَاتِب الأُدَبَاءِ",20,"ا",2,0],["لا رَأْيَ في مَجهولَةٍ","يجتابُ ظُلمتَها اجتيابَهْ",21,"ب",2,0],["لا رمى اللَّه ذلك الطَّوْدَ واليم","مَ بتنضيبه ولا بانهدادِهْ",22,"د",2,0],["لا رحم اللَّهُ أُمَّ أخْفَشكمْ","ولا سقى قبر والد وَلَدَهْ",23,"د",2,0],["لا رعاك اللَّه شيخاً","غير محميِّ الذِّمار",24,"ر",1,0],["لا رغبة عن مطيف بالمطيف به","لكن نفسي شموس حين تُعتَنف",25,"ف",1,0],["لا رأتْ يَومَك الفظيعَ الموالي","فالموالي لما صنعت مَوالي",26,"ل",2,0],["لا راعت الأيامُ سرحَكَ بعدها","أبداً ولا نظرت إليك شوافِنا",27,"ن",2,0],["لا رعاكَ اللَّهُ عبداً","غيرَ راعٍ للوصايا",28,"ا",3,0],["لا رُخامٌ أَنا فَأَنحَتُ تِمثا","لاً وَلا صَخرَةٌ تَكونُ بِناءَ",29,"ا",2,0],["لا رَعى اللَهُ زَوجَةً تُنفِقُ الأَم","وال وَالعُمرَ في اِقتِناءِ البُرودِ",30,"د",1,0],["لِأَرى الغَزالَةَ قَبلَ سُكّانِ الحِمى","وَأُعانِقُ النَسَماتِ في الأَسحارِ",31,"ر",1,0],["لِأَرى رُعاتَكِ في المُروج وَفي الرُبى","وَالشِتاءَ سارِحَةً مَعَ الأَبقارِ",31,"ر",1,0],["لِأَرى الطُيورَ الواقِعاتِ عَلى الثَرى","وَالنَخلَ حائِمَةً عَلى الأَزهارِ",31,"ر",1,0],["لِأُراقِبَ الدَلوارَ في جَرَيانِهِ","وَأَرى خَيالَ البَدرِ في الالدَلوارِ",31,"ر",1,0],["لا رَعاكَ اللَهُ يا يَومَ الأَحَدِ","لا وَلا حَيّاكَ عَنّي المَطَرَ",32,"ر",1,0],["لا رَأيَ يَجمَعُكُم إِذا اِختَلَفَ القَنا","وَتَلاقَتِ الفُرسانُ بِافُرسانِ",33,"ن",1,0],["لا رايَةٌ لَكُم يُدافِعُ دونَها","مُردُ العَوارِضِ وَالحُتوفُ دَواني",33,"ن",2,0],["لا رَعاهُ اللَهُ ما أَطوَلَهُ","تَحبَلَُ المَرأَةُ فيهِ وَتَلِد",34,"د",1,0],["لا ربَّةُ النِّسيانِ ترحمُ","حُزْنَهُ وترى شقاهْ",35,"ه",1,0],["لا رَعْشَةٌ تَعْرُو يديْهِ","إِذا تملَّقَهُ الفُؤَادْ",36,"د",1,0],["لا ريب في ان الحجى","هو زينة للمحفل",37,"ل",1,0],["لا رأي لي في ثمُ يا حنا اختصر","يا ضيعة الأيام والساعات",38,"ت",1,0],["لا رَدَّهُ اللَهُ مِن أَسرٍ وَمِن خَبَلٍ","إِن كانَ في رَدِّهِ صَحوي وَسُلواني",39,"ن",2,0],["لا رَيبَ أَنَّ خُطا الآمالِ واسِعَةٌ","وَأَنَّ لَيلَ سُراها صُبحُهُ اِقتَرَبا",40,"ب",2,0],["لا رَعاكَ التاريخُ يا يَومَ قَمبي","زَ وَلا طَنطَنَت بِكَ الأَنباءُ",41,"ا",2,0],["لَأَرحَلَنَّ وَآمالي مُطَرَّحَةٌ","بِسُرَّ مَن راءَ مُستَبطاً لَها القَدَرُ",42,"ر",1,0],["لَأَرشُفُ ريحاً لَم تَكُن باهِلِيَّةً","وَلَكِنَّها ريحُ الكِرامِ الأَطايِبِ",43,"ب",1,0],["لا راحَ ما لم يَصْفُها الرّاووقُ","رَحْبُ الذَّرى ينحَطُّ فيه الضِّيقُ",44,"ق",1,1],["لَأَرتَحِلَن بِالفَجرِ ثُمَّ لَأَدأَبَن","إِلى اللَيلِ إِلّا أَن يُعَرِّجَني طِفلُ",45,"ل",1,0],["لا رَيطَتَينِ كَرَيطَتي مُتَنَسِّمٍ","روحَ الحَياةِ وَلا القَميصُ مُخَيَّطُ",46,"ط",1,0],["لارَهبَةٌ مِنّي وَلارَغبَةٌ","عِندي فَيَرجوني وَيَخشاني",47,"ي",1,0],["لَأَركَبَنَّ فيمَن","هَويتُهُ الصَرامَة",48,"م",2,0],["لِأَروَعٍ لا تَزالُ راحَتُهُ","تَجودُ لِلناسِ قَبلَما تُسَلا",49,"ل",2,0],["لَأَربُعُ المَجدِ مِنكَ آنِسَةٌ","فَلا خَلا رَبعُها وَلا عَطِلا",49,"ل",2,0],["لا راجَعَ الطَرفُ بِاللِقا وَسَنَه","إِن ذاقَ غُمضاً مِن بَعدِكُم وَسِنَه",50,"ن",2,1],["لا رعى الله مساءً قاسياً","قد أراني كل أحلامي سدى",51,"د",2,0],["لا رَوْضَ ذَوَى منها قِدماً","بالدّهْرِ ولا ماءٌ أسنا",52,"ن",2,