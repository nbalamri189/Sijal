ني","https://www.aldiwan.net/poem12132.html","المجتث"],[516,"قول لابني وقد قال الطبيب له","https://www.aldiwan.net/poem12159.html","البسيط"],[530,"أكثر ذا العام صرت في سفر","https://www.aldiwan.net/poem37333.html","المنسرح"],[539,"ذكروا ذا الكلب في مراكش","https://www.aldiwan.net/poem48198.html","عموديه"],[541,"دع البخلاء إذا شحوا وضنوا","https://www.aldiwan.net/poem56854.html","الكامل"],[542,"لأفرجن اليوم كل الغمم","https://www.aldiwan.net/poem677.html",""],[552,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[552,"رم النجاء عن الفحشاء والهون","https://www.aldiwan.net/poem47160.html","البسيط"],[552,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[552,"لا رعى الله من إلى","https://www.aldiwan.net/poem47407.html","مجزوء الخفيف"],[552,"بأبي وجهك الذي","https://www.aldiwan.net/poem47712.html","مجزوء الخفيف"],[552,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[552,"ضنت عليك ضنينة الخدر","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[552,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[559,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[559,"لا رؤية ولا شهود","https://www.aldiwan.net/poem34577.html","مجزوء الرجز"],[565,"لم تبكي مثلي يا حمام تشوقا","https://www.aldiwan.net/poem909.html",""],[568,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[587,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["لأروع أفزع الأيام حدبا","وبالصمصام أثخنها طبابا",0,"ب",2,0],["لَاِرتَشَفَ الخَمرَ وَهوَ يَلفِظُها","لَوَ اِنَّ ما تُضمِرُ الكُؤوسُ دَمُ",1,"م",1,0],["لَأَراكَ في مِرآةِ جودِكَ مِثلَما","يَلقى العِيانَ الناظِرُ المُتَوَسِّمُ",2,"م",1,0],["لا رُزءَ أَعظَمُ مِن مُصابِكَ إِنَّهُ","وَصَلَ الدُموعَ وَقَطَّعَ الأَوصالا",3,"ل",2,0],["لَأُرحِلَنَّ المَطايا ثُمَّ أُبرِكُها","حَيثُ اِطمَأَنَّ النَدى وَاِستَوطَنَ الشَرَفُ",4,"ف",1,0],["لا رَوَّعَت سَرحَكَ المَنونُ وَلا","أَصبَحَ سِربٌ حَمَيتَ مَنهوبا",5,"ب",2,0],["لَأَرْتَدينَّ بِالظَّلْماءِ حَتّى","تَشُقَّ عَزائِمي ثُغَرَ الدَّياجِي",6,"ج",2,0],["لأَرْفَعُ عَنْ شَمَمٍ واضِحٍ","لِثامِي وَأَرْقَعُ وَهْيَ الحَسَبْ",7,"ب",1,0],["لأرْوَعَ حَجَّ بيتَ اللهِ يَطْوي","إليهِ نِياطَ أغْبَرَ صَحْصَحانِ",8,"ن",1,0],["لا رَغبَةً ليَ في النُّعْمى إذا نُسِبَتْ","لمْ تتّصِلْ بغِياثِ الدّولَةِ الحَسَنِ",9,"ن",1,0],["لا رَفَعتُ الحُسامَ في الحَربِ حَتّى","أَترُكُ القَومَ في الفَيافي عِظاما",10,"م",2,0],["لا رَعى اللَهُ عَهدَها مِن جُدودِ","كَيفَ أَمسَيتَ يا اِبنَ عَبدِ المَجيدِ",11,"د",1,1],["لا رَعى اللَهُ ساكِنَ القِمَمِ الشُم","مِ وَلا حاطَ ساكِنَ القيعانِ",12,"ن",1,0],["لا رَعى اللَهُ لَيلَتي في بُخارى","ذِكرُها ما حُيّيتُ حَشو ضَميري",13,"ر",2,1],["لَأَرتاحُ مِن أَسماءَ لِلذِكرِ قَد خَلا","وَلِلرَبعِ مِن أَسماءَ بَعدَ اِحتِمالِها",14,"ل",3,0],["لا رُوحَ فِيهَا غَيْرَ إِيمَاضَةٍ","مِنْ جَانِبِ الإِعْجَازِ فِيهَا تُشَامْ",15,"م",1,0],["لارَعى اللَهُ ياخَليلَيَّ دَهراً","فَرَّقَتنا صُروفُهُ تَفريقا",16,"ق",2,0],["لا ردَّ سهمك على نحرِ العداة ولا","نالوا من السهم ما راموا من الغرض",17,"ض",1,0],["لا رأيَ لي في الشامِ بعد ما دعى","أحبَّتي وسادتي الرحيل",18,"ل",1,1],["لا رقى سفح دموعي","في هوى تلك الثنيَّه",19,"ي",2,0],["لأرخص دمعي غداة السرا","تأرِّج أنفاسك العاليه",20,"ي",2,0],["لا رُزئْنَاكَ عَاتباً طلب العُت","بَى بِإعْفَا مَعَاتِب الأُدَبَاءِ",21,"ا",2,0],["لا رَأْيَ في مَجهولَةٍ","يجتابُ ظُلمتَها اجتيابَهْ",22,"ب",2,0],["لا رمى اللَّه ذلك الطَّوْدَ واليم","مَ بتنضيبه ولا بانهدادِهْ",23,"د",2,0],["لا رحم اللَّهُ أُمَّ أخْفَشكمْ","ولا سقى قبر والد وَلَدَهْ",24,"د",2,0],["لا رعاك اللَّه شيخاً","غير محميِّ الذِّمار",25,"ر",1,0],["لا رغبة عن مطيف بالمطيف به","لكن نفسي شموس حين تُعتَنف",26,"ف",1,0],["لا رأتْ يَومَك الفظيعَ الموالي","فالموالي لما صنعت مَوالي",27,"ل",2,0],["لا راعت الأيامُ سرحَكَ بعدها","أبداً ولا نظرت إليك شوافِنا",28,"ن",2,0],["لا رعاكَ اللَّهُ عبداً","غيرَ راعٍ للوصايا",29,"ا",3,0],["لا رُخامٌ أَنا فَأَنحَتُ تِمثا","لاً وَلا صَخرَةٌ تَكونُ بِناءَ",30,"ا",2,0],["لا رَعى اللَهُ زَوجَةً تُنفِقُ الأَم","وال وَالعُمرَ في اِقتِناءِ البُرودِ",31,"د",1,0],["لِأَرى الغَزالَةَ قَبلَ سُكّانِ الحِمى","وَأُعانِقُ النَسَماتِ في الأَسحارِ",32,"ر",1,0],["لِأَرى رُعاتَكِ في المُروج وَفي الرُبى","وَالشِتاءَ سارِحَةً مَعَ الأَبقارِ",32,"ر",1,0],["لِأَرى الطُيورَ الواقِعاتِ عَلى الثَرى","وَالنَخلَ حائِمَةً عَلى الأَزهارِ",32,"ر",1,0],["لِأُراقِبَ الدَلوارَ في جَرَيانِهِ","وَأَرى خَيالَ البَدرِ في الالدَلوارِ",32,"ر",1,0],["لا رَعاكَ اللَهُ يا يَومَ الأَحَدِ","لا وَلا حَيّاكَ عَنّي المَطَرَ",33,"ر",1,0],["لا رَأيَ يَجمَعُكُم إِذا اِختَلَفَ القَنا","وَتَلاقَتِ الفُرسانُ بِافُرسانِ",34,"ن",1,0],["لا رايَةٌ لَكُم يُدافِعُ دونَها","مُردُ العَوارِضِ وَالحُتوفُ دَواني",34,"ن",2,0],["لا رَعاهُ اللَهُ ما أَطوَلَهُ","تَحبَلَُ المَرأَةُ فيهِ وَتَلِد",35,"د",1,0],["لا ربَّةُ النِّسيانِ ترحمُ","حُزْنَهُ وترى شقاهْ",36,"ه",1,0],["لا رَعْشَةٌ تَعْرُو يديْهِ","إِذا تملَّقَهُ الفُؤَادْ",37,"د",1,0],["لا ريب في ان الحجى","هو زينة للمحفل",38,"ل",1,0],["لا رأي لي في ثمُ يا حنا اختصر","يا ضيعة الأيام والساعات",39,"ت",1,0],["لا رَدَّهُ اللَهُ مِن أَسرٍ وَمِن خَبَلٍ","إِن كانَ في رَدِّهِ صَحوي وَسُلواني",40,"ن",2,0],["لا رَيبَ أَنَّ خُطا الآمالِ واسِعَةٌ","وَأَنَّ لَيلَ سُراها صُبحُهُ اِقتَرَبا",41,"ب",2,0],["لا رَعاكَ التاريخُ يا يَومَ قَمبي","زَ وَلا طَنطَنَت بِكَ الأَنباءُ",42,"ا",2,0],["لَأَرحَلَنَّ وَآمالي مُطَرَّحَةٌ","بِسُرَّ مَن راءَ مُستَبطاً لَها القَدَرُ",43,"ر",1,0],["لَأَرشُفُ ريحاً لَم تَكُن باهِلِيَّةً","وَلَكِنَّها ريحُ الكِرامِ الأَطايِبِ",44,"ب",1,0],["لا راحَ ما لم يَصْفُها الرّاووقُ","رَحْبُ الذَّرى ينحَطُّ فيه الضِّيقُ",45,"ق",1,1],["لَأَرتَحِلَن بِالفَجرِ ثُمَّ لَأَدأَبَن","إِلى اللَيلِ إِلّا أَن يُعَرِّجَني طِفلُ",46,"ل",1,0],["لا رَيطَتَينِ كَرَيطَتي مُتَنَسِّمٍ","روحَ الحَياةِ وَلا القَميصُ مُخَيَّطُ",47,"ط",1,0],["لارَهبَةٌ مِنّي وَلارَغبَةٌ","عِندي فَيَرجوني وَيَخشاني",48,"ن",2,0],["لَأَركَبَنَّ فيمَن","هَويتُهُ الصَرامَة",49,"م",2,0],["لِأَروَعٍ لا تَزالُ راحَتُهُ","تَجودُ