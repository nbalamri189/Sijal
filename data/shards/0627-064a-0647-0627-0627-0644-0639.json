ي الحب غلام لم أزل","https://www.poetsgate.com/ViewPoem.aspx?id=130642",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6075,"بسمة الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=200329",""],[6089,"عدتَ ياعيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213024",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""],[6315,"محاريب الحيرة .. حيرة الفراديس!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87576&r=&rc=1",""]],"verses":[["أَيُّها العاجِزُ المُكَدَّرُ وِردي","رُبَّما عَرَّفتَكَ تِلكَ الجُمامُ",0,"م",1,0],["أَيُّها العاتِبُ الَّذي يَتَجَنّى","كُلَّ يَومٍ لِيَصرِمَ الحَبلَ مِنّا",1,"ن",2,1],["أَيُّها العاشِقونَ قوموا جَميعاً","نَشتَكي ما بِنا إِلى الرَحمَنِ",2,"ن",1,0],["أَيُّها العالِمُ الرَئيسُ أَجِبني","عَن سُؤالي فَأَنتَ رَبُّ المَعاني",3,"ن",2,1],["أَيُّهَا الْعَاذِلُوهُ شَوْقاً إِلَى إِنْ","شَادِهِ قَدْ يُلامُ غَيْرُ مُلِيمِ",4,"م",1,0],["أَيُّها العَاذِلُونَ كَيفَ عِتَابي","بَعدَما شَابَ مَفرِقي وَقَذَالِي",5,"ل",2,0],["أيها العاملون أن أتحاداً","بينكم مرخص لكم كل غال",6,"ل",1,0],["أيها العاجز الضعيف رُوَيداً","أقْرَن الضأن فاتك بالاجمّ",7,"م",1,0],["أيُّها العاذِلُ الغبيُّ تأملْ","من غدا في صفاته القلب ذائب",8,"ب",1,1],["أيُّها العالم الذي حصَّن الدِّ","ين بأوراقِ كتبه في حصون",9,"ن",1,0],["أيُّهَا العاذل لا أَخْ","طَأَك الحَيْنُ المُتَاحُ",10,"ح",1,0],["أيها العائبي بخفّةِ لحمي","بَجلي منه كُسوةُ الأوصالِ",11,"ل",1,0],["أَيُّها العابِسُ لَن تُعطى عَلى التَقطيبِ أُجرَه","لا تَكُن مُرّاً وَلا تَجعَل حَياةَ الغَيرِ مُرَّه",12,"ر",2,0],["أَيُّها العاتِبُ ظُلماً","يا حَبيبي لَكَ أَعني",13,"ن",2,0],["أَيُّها العاشِقُ إِنَّ ال","عِشقَ مِن بَعدي حَرامُ",14,"م",1,0],["ايها العيش انت لست على لو","ن فخير ساعا وشر ساعا",15,"ع",2,0],["أيها العلم يا مناي فداء","لك مالي من طارف وتلاد",16,"د",1,0],["أيها العاذلون نمتم ورام الس","هد من مقتليّ أمرا فصارا",17,"ر",2,0],["أَيُّها العاذِلونَ نِمتُم وَرامَ الس","سُهدُ مِن مُقلَتَيَّ أَمراً فَصارا",18,"ر",2,0],["أَيُّها العُمّالُ أَفنوا ال","عُمرَ كَدّاً وَاِكتِسابا",19,"ب",2,1],["أَيُّها العاتِبُ الَّذي لَيسَ يَرضى","نَم هَنيئاً فَلَستُ أَطعَمُ غُمضا",20,"ض",2,1],["أَيُّها العَبدُ إِلى كَم","تَشتَري الغَيَّ بِرُشدِك",21,"ك",1,0],["أيّها العزمُ الذي منه زكا","في المعالي عنصُرُ المجدِ وطاب",22,"ب",1,0],["أيها العائبُ قولي عبثاً","إنَّ طيبَ الوردِ مؤذٍ بالجُعَلْ",23,"ل",1,0],["أَيُّها العاتِبُ الَّذي رامَ هَجري","وَاِبتَداني بِهَجرِهِ وَالتَجَنّي",24,"ن",2,1],["أَيُّها العاذِلُ الَّذي لَجَّ في الهَج","رِ عَلامَ الَّذي فَعَلتَ وَمِمّا",25,"م",2,1],["أَيُّها العاذِلي أَقِلَّ عِتابي","لَم أُطِع في وِصالِها العُذّالا",26,"ل",2,0],["أَيُها العاتِبُ الَّذي رامَ هَجري","وَبِعادي وَما عَلِمتُ بِذاكا",27,"ك",2,1],["أَيُّها العاتِبُ المُكَثِّرُ فيها","بَعضَ لَومي فَما بَلَغتَ مُناكا",28,"ك",2,1],["أَيُّها العاتِبُ فيها عُصيتا","لَن تُطاعَ الدَهرَ حَتّى تَموتا",29,"ت",2,1],["أَيُّها العاشق المناصبَ مَهلاً","أَبتاج ظَفرت أَم صولَجان",30,"ن",1,0],["أَيُّها العابِثُ بي","سَرَفاً وَغَلَطا",31,"ط",2,0],["أَيُّها العاذِلُ دَع لَو","مِيَ في شُربِ الرَحيقِ",32,"ق",1,0],["أَيُّها العاذِلانِ لا تَعذِلاني","في مُناساةِ خِلَّةِ الإِخوانِ",33,"ن",1,1],["أَيُّها العاتِبُ في الخَم","رِ مَتى صِرتَ سَفيها",34,"ي",3,1],["أَيُّها العاني لِيُكفى رِزقَهُ","هانَ ما يَكفيكَ مِن طولِ العَنا",35,"ا",1,0],["أَيُّها العقل لا تلمني فَما قَد","جاءَه القلب لَم يكن باطلاعي",36,"ع",2,0],["أيُّها العَقل أي بدع تَراه","إن جرت في الفضاء بنت الفضاء",37,"ا",2,0],["أَيُّها العلم لح إذا الجهل أَدجى","كوكباً وابعثِ الضياء رسولا",38,"ل",2,0],["أيها العائد من غاراته","راقداً تحت قباب الأنفليد",39,"د",1,0],["أَيُّهَا العَائبُ عِند أُمّ زَيدٍ","أَنتِ تَفدي مَن أَراكَ تَعيبُ",40,"ب",1,1],["أَيُّهَا العَارِفُونَ فَضْلَ أَخِيكُمْ","ذَلِكَ الْفَضْلُ هَلْ يُوَفَّى ثَوَابَا",41,"ب",2,0],["أيها العصر الذي آياته","سامتت آي الكتاب المنزل",42,"ل",1,0],["أيها العبقريّ يا شرف الأرز","كفى الأرز إن ذكرت فخارا",43,"ر",2,0],["أَيُّها العاوي عَلى القَمَرِ اِخسَأ","جِئتَ في الحَقِّ بِشَيءٍ فَريِّ",44,"ي",1,0],["أيها العيدُ قد تجهَّم وجهُ الأ","رض، فاطلَعْ بثغرك البسَّام",45,"م",1,0],["أيها العبدُ، لقِّنِ الناسَ درسَ ال","حبِّ، واعزِفْ لهم نشيدَ الوِئام",45,"م",1,0],["أيها العلم، كم هتكت حجابًا","فأمِطْ عن سر الحياة اللثاما",46,"م",2,0],["أيها العُرْبُ أرْهِفوا الآذانا","هل سمعتم -كما سمعتُ- الأَذانا؟",47,"ن",2,1],["أيها العاقل لا تحفل بها","سوف ترمي بك من رأس جبل",48,"ل",1,0],["أيها العاذل ذرها تنهمي","تلك احشائي فدعها تتقد",49,"د",1,1],["أيها العالم سعها جلدا","ان نصف الليل يتلوه السحر",50,"ر",1,0],["أيّها العابثون بالشعب زيدوا","ليلنا واملأوه بالأشباح",51,"ح",1,0],["أَيها العاذلون، نِمتم، ورام السُّ","هدُ من مقلتيَّ أَمراً، فصارا",52,"ر",2,0],["أيها العاقِلُ الذي شاءَ تَزْو","يجاً من الأقْرِباءِ والبُعَداءِ",53,"ا",2,1],["أيها العاشق الذي ملكته","من لحاظي جنودها المنصوره",54,"ر",2,1],["أيها العالِمُ ادّركني سماحاً","فلِمِثلي يحقّ منك السّماحُ",55,"ح",1,1],["أيها العاذلُ ابغي كبداً لم","تقصفْ بجانبيها النصولُ",56,"ل",1,0],["ايها العاذل فيه لا تلم","انا لا اصغي الى من عذلا",57,"ل",2,0],["أيها العيد والظباء ألوف","لست أدرى واللَه ماذا أصيد",58,"د",1,0],["أَيُّها العُمرُ كم تَعُدُّ صَباحاً","بَعدُ لي في أَيّامِكَ المَحطومَه",59,"ه",1,0],["أيها العاتب أضنا","ني النوى,فازداد حقدي",60,"د",2,0],["أيها العصفورُ قُل لي","أتُغنِّي أم تصلّي",61,"ل",2,1],["أيها العذّال في أدمُعِنا","حَدّثوا عَن بحْرِها لا حَرَجا",62,"ج",2,0],["أَيها العاذلُ قَدْ","أَسرفتَ في عذلي فحسب",63,"ب",1,0],["أيها العصر لاتته إن كوخى","ليس يخشى قساوة الزلزال",64,"ل",1,0],["أَيُّها العاشق إنّي","لَأَرى ودَّكَ مينا",65,"ن",2,0],["أيها العالِم الذي","شيَّد الرسمَ والكرم",66,"م",1,0],["أيها العبد إن شئت الأمان","والرضا والإقامة في الجنان",67,"ن",1,1],["أيها العبد دع هذا الكلام","أنه جله لوم أو حرام",67,"م",1,0],["أيُّها العالمُ جارَ الظالمون","وتمادى في التجنِّ الحاقدون",68,"ن",1,1],["أيها العالمُ جاوزتْ المدى","وترفقت بمن لايرحمون",68,"ن",1,0],["أيُّها العالمُ لا قانونُكم","يردعُ الباغي,ولا هم يحزنون",68,"ن",1,0],["أيها العاتب رفقاً","ليس ما تعتب حقا",69,"ق",2,1],["أيُّها العاذلُ يبغي ر