{"poems":[[55,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[55,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[53,"هل للقلوب من العيون خلاص","https://www.aldiwan.net/poem64936.html","الكامل"],[53,"نكهت شنطف ففاح كنيف","https://www.aldiwan.net/poem65728.html","الطويل"],[99,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[46,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[76,"أي عيش أو غذاء أو سنه","https://www.aldiwan.net/poem13272.html","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9919","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[246,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[449,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[469,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38258","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66314","الرمل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126389","الدوبيت"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109374","الرمل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58454","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118897","الدوبيت"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74322","الخفيف"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87580","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111484","الكامل"],[4797,"سرحت فالقلص من عزبة تميم","https://www.poetsgate.com/ViewPoem.aspx?id=178126",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5121,"التَّحَايَا","https://www.poetsgate.com/ViewPoem.aspx?id=215348",""]],"verses":[["قَلَّصَ عَن ثَغرِهِ مَضاحِكَهُ","كَأَنَّهُ في العُبوسِ مُبتَسِمُ",0,"م",1,0],["قَلَصَت أَظِلَّةُ كُلَّ فَضلٍ بَعدَهُ","وَأَمَرَّ مَشرَبُها عَلى الوُرّادِ",1,"د",1,0],["قلصتْ بمن لا صبر دون لقائه","نوقٌ تراهَقُ في البُرى وقِلاص",2,"ص",1,0],["قلَّصت درعَها وألقت على الأر","ض قفاها وأبدت المفلوقا",3,"ق",2,0],["قل صُن ذكر غرامنا فلقد","صين الشباب عليك أحقابا",4,"ب",2,0],["قَلَّصتُهُ بِالقِلاصِ تَهوي","بِالوَخدِ مِن سَيرِها الحَثيثِ",5,"ث",1,0],["قَلَّصَ الشَيبُ بِهِ ظِلَّ اِمرِئٍ","طالَما جَرَّ صِباهُ رَسَنَه",6,"ن",2,0],["قَلَّ صَبري عَلى فِراقِ غَصوبٍ","وَهوَ قَد كانَ عُدَّتي وَاِعتِمادي",7,"د",2,0],["قَلَّصَ التَشنيجُ مِنهُ شَفَة","عَن شَتيتٍ كُلَّما اِفتَرَّ بَرق",8,"ق",1,0],["قَلَّصَت صُحبَةُ الحَوادِثِ وَالأَي","يامَ مِن ذَيلِ سُترَتي المَجرورِ",9,"ر",1,0],["قَلَّصتَ ظلَّ اللَّيلِ عنه وَمَا","رعيتَ حقَّ اللَهِ في مَدّه",10,"د",2,0],["قَلَّ صَبري وَالهَجر مِنكَ مَليٌّ","وَبِإِكثاره أَرى إِقلاله",11,"ل",2,0],["قلصت أجسامنا فلا جلد","على الجليد ولا الوقود بقي",12,"ق",2,0],["قَلَّ صبري على اقتنائِيَ للمج","د وأمّا عنك الغداة فصبرا",13,"ر",2,0],["قلّص عني ظلَّه والفقيدُ ال","حسِ من يرجو بقاء الظّلال",14,"ل",1,0],["قَلَّ صَبري وَحيلَتي","دُلَّني كَيفَ أَصنَعُ",15,"ع",1,0],["قَلَّصْنَ عَنْهُ فِي لِهامِ السُبْلِ","مُغْبَر أَعْناق الجِبال الجُزْلِ",16,"ل",1,0],["قَلَّصَ بِالأَعْداءِ فَاصْلَهَبَّا","تَرَاهُ فِي أَجْلادِهِ خِدَبّا",17,"ب",2,0],["قلص ظلالك راحلاً","ودع البرية في الهجير",18,"ر",1,0],["قلص الليل وما ام","تاز غروب من شروق",19,"ق",1,0],["قل صبرتم وتجلدنا لها","نوب توهن عزم الصابرين",20,"ن",1,0],["قل صبّك ما زال به الوجد الى","ان مات غراماً أحسن الله عزاك",21,"ك",1,0],["قلَّ صبري بقديم الوجد من","فرط هجرٍ وبهِ شوقي تجدَّد",22,"د",1,0],["قل صبري وزاد حزني ووجدي","فهمومي سكري ودمعي مدامعي",23,"م",3,0],["قَلّصَ لي أنفَهْ كأنّي","في عُبهِ بِكُمي",24,"م",2,0],["قل صبكم قد ضاق صدراً فمتى","بالوصل يفوز أو بفتح البابِ",25,"ب",1,0],["قل صَبري عَن الرُبوع فَدَمعي","زادَ مِن لَوعة الغَرام إِندِفاقا",26,"ق",2,0],["قل صبري وضاع فكري وإني","طامع لم أزل بوصل ودادي",27,"ي",1,0],["قلَّ صبر الفؤاد وَالشوق غالب","وَالضنى وحدهُ لذا الشوق غالب",28,"ب",1,1],["قُل صادِقاً ما جِئتَ تَرقُبُ مُفرَداً","والنَّاسُ نامُوا والظَّلامُ تَقَطَّبا",29,"ب",2,0],["قلص هجن ٍ جنسها قدهو عديم","الركاب النادره هي والبكار",30,"ر",1,0],["قلصن فارق عيش عند مجتمع","حتى غدا محكم الأوضاع والنظم",31,"م",1,0],["قُلْ صَبَاحُ الْخَيْرَاتِ أَوْ يَا مَسَائِي","لَيْتَ مَرْحَىَ مِنَ الشِّفَاهِ تُنِيرُ",32,"ر",1,0]]}