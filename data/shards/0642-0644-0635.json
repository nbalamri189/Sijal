{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[51,"هل للقلوب من العيون خلاص","https://www.aldiwan.net/poem64936.html","الكامل"],[51,"نكهت شنطف ففاح كنيف","https://www.aldiwan.net/poem65728.html","الطويل"],[97,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[44,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[74,"أي عيش أو غذاء أو سنه","https://www.aldiwan.net/poem13272.html","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9919","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[236,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[242,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[354,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[444,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[459,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[465,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"]],"verses":[["قَلَّصَ عَن ثَغرِهِ مَضاحِكَهُ","كَأَنَّهُ في العُبوسِ مُبتَسِمُ",0,"م",1,0],["قَلَصَت أَظِلَّةُ كُلَّ فَضلٍ بَعدَهُ","وَأَمَرَّ مَشرَبُها عَلى الوُرّادِ",1,"د",1,0],["قلصتْ بمن لا صبر دون لقائه","نوقٌ تراهَقُ في البُرى وقِلاص",2,"ص",1,0],["قلَّصت درعَها وألقت على الأر","ض قفاها وأبدت المفلوقا",3,"ق",2,0],["قل صُن ذكر غرامنا فلقد","صين الشباب عليك أحقابا",4,"ب",2,0],["قَلَّصتُهُ بِالقِلاصِ تَهوي","بِالوَخدِ مِن سَيرِها الحَثيثِ",5,"ث",1,0],["قَلَّصَ الشَيبُ بِهِ ظِلَّ اِمرِئٍ","طالَما جَرَّ صِباهُ رَسَنَه",6,"ن",2,0],["قَلَّ صَبري عَلى فِراقِ غَصوبٍ","وَهوَ قَد كانَ عُدَّتي وَاِعتِمادي",7,"د",2,0],["قَلَّصَ التَشنيجُ مِنهُ شَفَة","عَن شَتيتٍ كُلَّما اِفتَرَّ بَرق",8,"ق",1,0],["قَلَّصَت صُحبَةُ الحَوادِثِ وَالأَي","يامَ مِن ذَيلِ سُترَتي المَجرورِ",9,"ر",1,0],["قَلَّصتَ ظلَّ اللَّيلِ عنه وَمَا","رعيتَ حقَّ اللَهِ في مَدّه",10,"د",2,0],["قَلَّ صَبري وَالهَجر مِنكَ مَليٌّ","وَبِإِكثاره أَرى إِقلاله",11,"ل",2,0],["قلصت أجسامنا فلا جلد","على الجليد ولا الوقود بقي",12,"ق",2,0],["قَلَّ صبري على اقتنائِيَ للمج","د وأمّا عنك الغداة فصبرا",13,"ر",2,0],["قلّص عني ظلَّه والفقيدُ ال","حسِ من يرجو بقاء الظّلال",14,"ل",1,0]]}