{"poems":[[46,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/117011","الوافر"],[119,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[215,"تأنق رب الخلق في صنع أعين","https://www.aldiwan.net/poem46242.html","الطويل"],[215,"عيونك فيها حديث أراه","https://www.aldiwan.net/poem46247.html","المتقارب"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[422,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72269","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102143","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27163","الرمل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130813",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134053","الوافر"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104831","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92164","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105107","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136559",""],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66912","الكامل"],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""]],"verses":[["بِأَثقَلَ مِنهُ وَطأَةً حينَ يَغتَدي","فَيُلقي وَراءَ المُلكِ نَحراً وَكَلكَلا",0,"ل",2,0],["باِثنين يُغَطّى البَيتُ ولا","يُكْسَي بالفرْدِ مُجَرَّدُهُ",1,"د",2,0],["بآثارٍ وفقه مع حديثٍ","كىيات الزبور على صحيفَه",2,"ف",2,0],["بآثار تصريف كسفت بها العمى","وأسرار تعريف دفعت بها الجهلا",3,"ل",2,0],["بأثياج هذا البحر دار بنا الهوى","كما دار شهد بأزاهير بستان",4,"ن",1,0],["بآثامنا في الهوى ننعم","فيشقى بنا العازل المجرم",5,"م",1,0],["بأثباجٍ كما انتطحَتْ وُعولٌ","بِشابةَ أَو كما انأطَرَتْ قِسيّ",6,"ي",1,0],["باثثْتُهُ وجْدي وقلتُ يَرِقِّ لي","فأجابَني بالصّمتِ والإطراقِ",7,"ق",1,0],["بآثاره أبداً يقتفى","وأقواله أبداً يقتدى",8,"ا",1,0],["بِأثْوابٍ أحياءٍ يَموتونَ لَهْفةً","تُخالِفُها الأمواتُ في سَكَنِ القَبْرِ",9,"ر",1,0],["باثياره بالقوت يطوي على الطوى","إذا أمه المسكين في الأزمات",10,"ت",1,0],["باثارى وشاني","وسنّاتي قيامي",11,"م",2,0],["بِأَثيلاتِ النَقا سِربُ قَطا","ضَرَبَ الحُسنُ عَلَيها طُنُبا",12,"ب",2,1],["باثنين من مستفعلن مبناها","ثم بمفعولات لا سواها",13,"ه",2,0],["بآثارهم في جلبة الجهل نسوة","عما هن اردى في الدنايا وارذل",14,"ل",1,0],["باثمار الرياض ومذ دعتنا","تهادينا الزهور فعطرتنا",15,"ن",2,0],["بأثبت قلباً منه والسمر تنحني","عليه وتردي منه بيض الصفائح",16,"ح",1,0],["باثقاً رُوحَهُ نظيرَ ابيهِ","فَهوَ والآبُ مَصدَرُ الإِنبِثاقِ",17,"ق",1,0],["بأثمانه أحظى وإلا ادخرتُه","أُأَجِّجُ منه النارَ ليلاً لمن طرَا",18,"ر",2,0],["باثنَتَي عَشرَةَ بالشُّكرِ الجزِيل","هَكذا كانَ الدُّعا لَكِن أُبي",19,"ي",1,0],["بأثيثه متبرقع وبجفنه","متدرع وبقوسه متنكب",20,"ب",1,0],["بآثارها كم من نُفوسٍ أسالها","وكم من شُجونٍ في القلوب أثارها",21,"ر",3,0],["بأثمان لقد جعلت","جميع الناس زواره",22,"ر",2,0],["بآثار آثارك الماضيةْ","أهيم فعودي ولو ثانيةْ",23,"ي",2,1]]}