{"poems":[[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117011","الوافر"],[113,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[209,"تأنق رب الخلق في صنع أعين","https://www.aldiwan.net/poem46242.html","الطويل"],[209,"عيونك فيها حديث أراه","https://www.aldiwan.net/poem46247.html","المتقارب"],[362,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[406,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[413,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[498,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"]],"verses":[["بِأَثقَلَ مِنهُ وَطأَةً حينَ يَغتَدي","فَيُلقي وَراءَ المُلكِ نَحراً وَكَلكَلا",0,"ل",2,0],["باِثنين يُغَطّى البَيتُ ولا","يُكْسَي بالفرْدِ مُجَرَّدُهُ",1,"د",2,0],["بآثارٍ وفقه مع حديثٍ","كىيات الزبور على صحيفَه",2,"ف",2,0],["بآثار تصريف كسفت بها العمى","وأسرار تعريف دفعت بها الجهلا",3,"ل",2,0],["بأثياج هذا البحر دار بنا الهوى","كما دار شهد بأزاهير بستان",4,"ن",1,0],["بآثامنا في الهوى ننعم","فيشقى بنا العازل المجرم",5,"م",1,0],["بأثباجٍ كما انتطحَتْ وُعولٌ","بِشابةَ أَو كما انأطَرَتْ قِسيّ",6,"ي",1,0],["باثثْتُهُ وجْدي وقلتُ يَرِقِّ لي","فأجابَني بالصّمتِ والإطراقِ",7,"ق",1,0],["بآثاره أبداً يقتفى","وأقواله أبداً يقتدى",8,"ا",1,0],["بِأثْوابٍ أحياءٍ يَموتونَ لَهْفةً","تُخالِفُها الأمواتُ في سَكَنِ القَبْرِ",9,"ر",1,0]]}