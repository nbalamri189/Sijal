{"poems":[[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[72,"لها من جبين البدر أو قامة الغصن","https://www.aldiwan.net/poem20204.html","الطويل"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[62,"قد خرج التنين من بحرنا","https://www.aldiwan.net/poem52176.html","السريع"],[28,"تلوم على هجاء بني كليب","https://www.aldiwan.net/poem5239.html","الوافر"],[61,"سل الملحي كيف رأى عقابي","https://www.aldiwan.net/poem51790.html","الوافر"],[80,"بني الثغر لستم في الوغى من بني أمي","https://www.aldiwan.net/poem31307.html","الطويل"],[80,"أمثلك مولى يبسط العبد بالعذر","https://www.aldiwan.net/poem31422.html","الطويل"],[105,"تغلغل في القلب حتى وقر","https://www.aldiwan.net/poem43073.html","المتقارب"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[21,"وما لي لا أحييه وعندي","https://www.aldiwan.net/poem36237.html","الوافر"],[48,"طربت إلى خمر وقصف الدساكر","https://www.aldiwan.net/poem63297.html","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10210","السريع"],[54,"لَولا حُوَيُّ بيْتِ لهيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=14506",""],[115,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[132,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[204,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[210,"أما ولماه ورشف القبل","https://www.aldiwan.net/poem13565.html","المتقارب"],[235,"ما ذقت قط أمر من أمري","https://www.aldiwan.net/poem31602.html","الطويل"],[300,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[304,"إلى متى لا تجف عيني","https://www.aldiwan.net/poem16884.html","مخلع البسيط"],[437,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[448,"ومقدم فى القوم تطلب فى السرى","https://www.aldiwan.net/poem53796.html","الكامل"],[461,"يفضله على ماء الغوادي","https://www.aldiwan.net/poem15693.html","الوافر"],[470,"فيا ليت أنا قد تعشقت الملا","https://www.aldiwan.net/poem4738.html","الطويل"],[562,"أمير أهام الفضل في ما بذاته","https://www.aldiwan.net/poem52708.html","البسيط"],[586,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"]],"verses":[["لَهُ دَرمَكٌ في رَأسِهِ وَمَشارِبٌ","وَمِسكٌ وَرَيحانٌ وَراحٌ تُصَفَّقُ",0,"ق",1,0],["له دولة فاقت على كلِّ دولةٍ","وخدَّام ملكٍ من بشيرٍ ومن يمن",1,"ن",1,0],["له دعاوٍ وله جُرأةٌ","كجُرأةِ الليث على الغُيَّبِ",2,"ب",1,0],["له دعوةٌ يشْفي بها من شكى الضَّنى","ويرزُقُ من أكدى ويُنْعِشُ من رزمْ",3,"م",1,0],["له دويٌ وحفيفٌ كما","للريح إذ جاءت باعصارِ",4,"ر",1,0],["لَهُ دُهدِيَّةٌ إِن خافَ شَيئاً","مِنَ الجِعلانِ أَحرَزَها اِحتِفارا",5,"ر",2,0],["له دارٌ إذا استخفيتَ فيها","خَفِيتَ فلم تَنَلْكَ يَدُ الطِّلابِ",6,"ب",1,0],["له دَخْلَةٌ في الجسْم تُخْرِجُ نَفْسَهُ","قُبَيْلَ خروج الحدّ منهُ عن الجسمِ",7,"م",1,0],["لَهَدّ قريضَ الفضلِ ما هدّ من قوى","وَحَلّ به ما حلّ من عُقْدةِ الصّبرِ",8,"ر",1,0],["لَهُ دَعوَةُ الخَيرِ تَجلو العَمى","وَتَهدي السَبيلَ وَتَنفي الغَرَرْ",9,"ر",1,0],["لَهُ دَعوَةُ الأَمرِ في حَفلِهِ","وَأُخرى إِلى اللَهِ مَهما خَلا",10,"ل",2,0],["لَهُ داعٍ بِمَكَةَ مُشمَعِلٌّ","وَآخَرَ فَوقَ دارَتِهِ يُنادي",11,"ي",1,0],["لَهُ دينُ قِسّيسٍ وَتَدبيرُ كاتِبٍ","وَإِطراقُ جَبّارٍ وَأَلفاظُ شاعِرِ",12,"ر",1,0],["لَهُ دَواةٌ في سَراويلِهِ","يُلقيها النازِحُ وَالداني",13,"ي",1,0],["لهُ دواة ٌ في سراويلهِ","يليقها النازحُ والداني",14,"ي",1,0],["له دولة الصدق التي شيدت لنا","منارا على عن مدرك المتطاول",15,"ل",1,0],["له درر منثورة وجواهرٌ","لدى الفكر يبدى بالنظام ثمينَها",16,"ه",2,0],["له دلائل إقبالٍ يوافقها","يمنٌ ورأي على التوفيق مدلولُ",17,"ل",1,0],["له در ثغر فما ذا عسى","أقول وفيه اللمى والعسل",18,"ل",1,0],["لِهَدِيَّةٍ جاءَت لِشاعِرِكُم","مِن غَيرِكُم مَنزورَةِ القَدرِ",19,"ر",1,0],["لِهَدَجدَجٍ جُربٍ مَساعِرُهُ","قَد عادَها شَهراً إِلى شَهرِ",20,"ر",1,0],["له دموع على خدود","كأنها ماطر المزين",21,"ن",1,0],["له دوحة يسمو بها عادليّة","وللمجد منها كلّ وقتٍ مجدّد",22,"د",1,0],["لهداية السارين فى غسق الدجى","وكرامة النزال توقد ناره",23,"ر",2,0],["له دون المَعابِ وقوفُ وانٍ","وفي طلَبِ العُلى عَنَقٌ حَثيثُ",24,"ث",1,0],["لَهُ دِسَعٌ فِيها حَياة وَسورَة","تُميتُ وَحلم يَفضلُ الحُلوَ بارِعُ",25,"ع",1,0],["لهُ دُرُّ نظمي قد أتاهَ قريحتي","أغرُّ حكى نظمَ القلائدِ بالطُّلا",26,"ل",2,0],["لَهُ دُرُّ ألفاظٍ وَدَرُّ مَواهَبٍ","يُحدِّثُ عَنْهَا الفاضِلُ المُتفضِّلُ",27,"ل",1,0]]}