{"poems":[[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[74,"لها من جبين البدر أو قامة الغصن","https://www.aldiwan.net/poem20204.html","الطويل"],[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[64,"قد خرج التنين من بحرنا","https://www.aldiwan.net/poem52176.html","السريع"],[30,"تلوم على هجاء بني كليب","https://www.aldiwan.net/poem5239.html","الوافر"],[63,"سل الملحي كيف رأى عقابي","https://www.aldiwan.net/poem51790.html","الوافر"],[82,"بني الثغر لستم في الوغى من بني أمي","https://www.aldiwan.net/poem31307.html","الطويل"],[82,"أمثلك مولى يبسط العبد بالعذر","https://www.aldiwan.net/poem31422.html","الطويل"],[107,"تغلغل في القلب حتى وقر","https://www.aldiwan.net/poem43073.html","المتقارب"],[83,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[21,"وما لي لا أحييه وعندي","https://www.aldiwan.net/poem36237.html","الوافر"],[50,"طربت إلى خمر وقصف الدساكر","https://www.aldiwan.net/poem63297.html","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10210","السريع"],[56,"لَولا حُوَيُّ بيْتِ لهيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=14506",""],[119,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[136,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[208,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[214,"أما ولماه ورشف القبل","https://www.aldiwan.net/poem13565.html","المتقارب"],[240,"ما ذقت قط أمر من أمري","https://www.aldiwan.net/poem31602.html","الطويل"],[305,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[309,"إلى متى لا تجف عيني","https://www.aldiwan.net/poem16884.html","مخلع البسيط"],[443,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[453,"ومقدم فى القوم تطلب فى السرى","https://www.aldiwan.net/poem53796.html","الكامل"],[466,"يفضله على ماء الغوادي","https://www.aldiwan.net/poem15693.html","الوافر"],[475,"فيا ليت أنا قد تعشقت الملا","https://www.aldiwan.net/poem4738.html","الطويل"],[567,"أمير أهام الفضل في ما بذاته","https://www.aldiwan.net/poem52708.html","البسيط"],[591,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138430",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63848","الهزج"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123399","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70872","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67832","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59107","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96694","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64896","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112826","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69360","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28038","الرجز"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101791","الطويل"],[2290,"","https://poetry.dctabudhabi.ae/diwan/poem/98016","المتقارب"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111260","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124096","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62808","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109912","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133237","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123508","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91021","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94579","الطويل"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"],[3464,"شموس سعوده هلت تبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158759",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5002,"متاحف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=212285",""],[5055,"( م . س . س )","https://www.poetsgate.com/ViewPoem.aspx?id=104296",""],[5183,"من وحي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=180196",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5704,"السلام عليك ايها القمر٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=202946",""]],"verses":[["لَهُ دَرمَكٌ في رَأسِهِ وَمَشارِبٌ","وَمِسكٌ وَرَيحانٌ وَراحٌ تُصَفَّقُ",0,"ق",1,0],["له دولة فاقت على كلِّ دولةٍ","وخدَّام ملكٍ من بشيرٍ ومن يمن",1,"ن",1,0],["له دعاوٍ وله جُرأةٌ","كجُرأةِ الليث على الغُيَّبِ",2,"ب",1,0],["له دعوةٌ يشْفي بها من شكى الضَّنى","ويرزُقُ من أكدى ويُنْعِشُ من رزمْ",3,"م",1,0],["له دويٌ وحفيفٌ كما","للريح إذ جاءت باعصارِ",4,"ر",1,0],["لَهُ دُهدِيَّةٌ إِن خافَ شَيئاً","مِنَ الجِعلانِ أَحرَزَها اِحتِفارا",5,"ر",2,0],["له دارٌ إذا استخفيتَ فيها","خَفِيتَ فلم تَنَلْكَ يَدُ الطِّلابِ",6,"ب",1,0],["له دَخْلَةٌ في الجسْم تُخْرِجُ نَفْسَهُ","قُبَيْلَ خروج الحدّ منهُ عن الجسمِ",7,"م",1,0],["لَهَدّ قريضَ الفضلِ ما هدّ من قوى","وَحَلّ به ما حلّ من عُقْدةِ الصّبرِ",8,"ر",1,0],["لَهُ دَعوَةُ الخَيرِ تَجلو العَمى","وَتَهدي السَبيلَ وَتَنفي الغَرَرْ",9,"ر",1,0],["لَهُ دَعوَةُ الأَمرِ في حَفلِهِ","وَأُخرى إِلى اللَهِ مَهما خَلا",10,"ل",2,0],["لَهُ داعٍ بِمَكَةَ مُشمَعِلٌّ","وَآخَرَ فَوقَ دارَتِهِ يُنادي",11,"د",2,0],["لَهُ دينُ قِسّيسٍ وَتَدبيرُ كاتِبٍ","وَإِطراقُ جَبّارٍ وَأَلفاظُ شاعِرِ",12,"ر",1,0],["لَهُ دَواةٌ في سَراويلِهِ","يُلقيها النازِحُ وَالداني",13,"ي",1,0],["لهُ دواة ٌ في سراويلهِ","يليقها النازحُ والداني",14,"ي",1,0],["له دولة الصدق التي شيدت لنا","منارا على عن مدرك المتطاول",15,"ل",1,0],["له درر منثورة وجواهرٌ","لدى الفكر يبدى بالنظام ثمينَها",16,"ه",2,0],["له دلائل إقبالٍ يوافقها","يمنٌ ورأي على التوفيق مدلولُ",17,"ل",1,0],["له در ثغر فما ذا عسى","أقول وفيه اللمى والعسل",18,"ل",1,0],["لِهَدِيَّةٍ جاءَت لِشاعِرِكُم","مِن غَيرِكُم مَنزورَةِ القَدرِ",19,"ر",1,0],["لِهَدَجدَجٍ جُربٍ مَساعِرُهُ","قَد عادَها شَهراً إِلى شَهرِ",20,"ر",1,0],["له دموع على خدود","كأنها ماطر المزين",21,"ن",1,0],["له دوحة يسمو بها عادليّة","وللمجد منها كلّ وقتٍ مجدّد",22,"د",1,0],["لهداية السارين فى غسق الدجى","وكرامة النزال توقد ناره",23,"ر",2,0],["له دون المَعابِ وقوفُ وانٍ","وفي طلَبِ العُلى عَنَقٌ حَثيثُ",24,"ث",1,0],["لَهُ دِسَعٌ فِيها حَياة وَسورَة","تُميتُ وَحلم يَفضلُ الحُلوَ بارِعُ",25,"ع",1,0],["لهُ دُرُّ نظمي قد أتاهَ قريحتي","أغرُّ حكى نظمَ القلائدِ بالطُّلا",26,"ل",2,0],["لَهُ دُرُّ ألفاظٍ وَدَرُّ مَواهَبٍ","يُحدِّثُ عَنْهَا الفاضِلُ المُتفضِّلُ",27,"ل",1,0],["له دمت يا مختار وليبق سالما","لنخلة عز انجبت اجود الغصن",28,"ن",1,0],["لهُ دَفاتِرٌ تُخْبِ","رُ عن كسرى وعن قَيصَر",29,"ر",1,0],["له دَفَرٌ في كلِّ جُزءٍ بجِسمه","إذا فاح قُلنا ذا الفتى كل إبطُ",30,"ط",1,0],["له دلٌّ كمنْ قد كا","نَ منسوباً إلى الأبْنهْ",31,"ن",2,0],["لَهُ دَعَوَاتٌ فِي الأَنَامِ مُجَابَةٌ","وَمِنْ حَرِّ شَمْسٍ ظَلَّلَتْهُ غَمَامَةٌ",32,"ه",1,0],["لَهُ دَولَةٌ فَاقَتْ عَلَى كُلّ دَوْلَةٍ","بِخُدَّامِ يُمْنٍ مِنْ نَجَاحٍ ومن نَصْرِ",33,"ر",1,0],["لَهُ دَوْلَةٌ أرْبَتْ عَلَى كُلّ دَوْلَة","بِتَأيِيدِ آرَاءٍ وَتَأيِيدِ نُصْرَة",34,"ه",1,0],["لَهُ دَوْلَةٌ أَرْبَتْ عَلَى كُلّ دَوْلَةٍ","بِمَا شِئْتَ من مَالٍ وَجَاهٍ وَمَقْسَمِ",35,"م",1,0],["لهُ درجاتٌ تباري الشكا","كَ حيثُ الشكاك يباري الشكاكا",36,"ك",2,0],["لهُ دَولةُ الإِطلاقِ والحَبْسِ في الهَوى","فمَحْبوسُها قَلْبي ودَمْعي طَليقُها",37,"ق",3,0],["له دعوة بالصدق يا فوز من لها","أجاب بصدق والعدو له البلا",38,"ل",2,0],["لِهَدهَدَةِ الرُعودِ بِهِ اِصطِخابٌ","كَما اِصطخَبَ اليَراعُ الفارِسيُّ",39,"ي",1,0],["لهداه صاحبا","للهوى منتبذا",40,"ذ",2,0],["له دحرجوا منذ كان حياً دبابهم","وقد نسبوا عند الوفات له الهجرا",41,"ر",2,0],["لَهُ دفرٌ كصنانِ التيوس","أَعيا عَلى المسكِ وَالغالِيَه",42,"ل",3,0],["له دار عز ما ألم بها فتى","شكا كربة إلا رأى منه تنفيسا",43,"س",2,0],["لَهُ دَرَجٌ فيهِ وفيهِ دَقَائِق","مِنَ القُطبِ للقُطبِ آستَفِد من غرايِبِي",44,"ب",2,0],["له دعوات في العباد مجابةٌ","بها اعتلّ عاديها وصحّ عليلها",45,"ل",3,0],["له دونَ المحامدِ والمَعالي","مُحاماة الغيورِ عن الحَريمِ",46,"م",1,0],["لهُ دُرَّةٌ ان غُيّبت صار موطناً","لدُرٍ جزيلٍ ثُمَّ نِيطَ بهِ السَخَب",47,"ب",1,0],["له درّت العجفا عداء وأصبحت","لبونا كما قد صح عن أم معبد",48,"د",1,0],["له دانت الدنيا انقيادا فلم يرد","لها عرضا بل صدّ عنها وأعرضا",49,"ض",2,0],["له دم إباحتي تشاهده أبا","وجدا سديد الراي بالحل والعقد",50,"د",1,0],["له دَيدنٌ يسمو الخلائق رحمةً","بعدلٍ وأنصافٍ أليفَينِ في فردِ",51,"د",1,0],["لَهُ دَعَواتُ أَهلِ الذِك","رِ وَالأَعلَينِ وَالسَلَبُ",52,"ب",1,0],["له دوماً جلالٌ فات حدّاً","جنابٌ راحمٌ باه حيمد",53,"د",1,0],["لهدى صاد من زمر","فعم هداه من قربا",54,"ب",2,0],["لهُ دَيَاجِيرهُ والَّليلُ مُتْحَفهُ","تُحكى به عللٌ.. يَفٰنى به السَّمِجُ",55,"ج",1,0],["له .. ديرةٍ آية بترتيل","يختار منْها رمح .. وحسام",56,"م",1,0],["له دعوة بالعلم طالت صروحها","على الكون في مألوفه وغريبه",57,"ب",2,0],["لَهُ دَرَجاتٌ يُباري السِّما","كَ حَيْثُ السِّماكُ يُباري السِّماكَا",58,"ك",2,0],["لهُ دَاخِلي قْلْ أَنْ يَصِيحَ يَصِيحَ : فِي","دمِي لِحَمَامِ السِّلْمِ فَلْيَنْبُتِ القَمْحُ !",59,"ح",1,0],["له داعج بالسواد كحيل","قد استل سهمًا به قد رمانا",60,"ن",2,0]]}