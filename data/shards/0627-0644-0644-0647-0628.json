ه يا ملك احمني","من كل سوء إن من لم تحم زل",7,"ل",1,0],["اللّه بسم اللّه قدوس حل","بيني وآفاتي الرواسخ كالجبل",7,"ل",1,0],["اللّه بسم اللّه سلم طاعتي","لك يا سلام إنني رهن العلل",7,"ل",1,0],["اللّه بسم اللّه أمنك إنني","يا مؤمن المذعور منك على وجل",7,"ل",1,0],["اللّه بسم اللّه أشكو ظالماً","طالت قواه ما مهيمن واهنبل",7,"ل",1,0],["اللّه بسم اللّه عزي ثابت","بك يا عزيز اعز والخصم الأذل",7,"ل",1,0],["اللّه بسم اللّه يا جبار خذ","خصمي ومزقه فقد غلب الحيل",7,"ل",1,0],["اللّه بسم اللّه يا متكبر","فلتمحق المتكبرين على عجل",7,"ل",1,0],["اللّه بسم اللّه جد يا خالق ال","أشياء من عدم بايجاد الأمل",7,"ل",1,0],["اللّه بسم اللّه كون مطلبي","يا بارىء المختار رجل عن العلل",7,"ل",1,0],["اللّه بسم اللّه صور في جنا","ني يا مصور حبك الأعلى الأجل",7,"ل",1,0],["اللّه بسم اللّه يا غفار قد","أسرفت فاغفر ما أسأت من العمل",7,"ل",1,0],["اللّه بسم اللّه يا قهار خذ","خصمي العنيد فأنت تعلم ما فعل",7,"ل",1,0],["اللّه بسم اللّه يا وهاب هب","لي رحمة دنيا وأخرى تشتمل",7,"ل",1,0],["اللّه بسم اللّه يا رزاق قد","أقللت فارزقني ورزقك لا يقل",7,"ل",1,0],["اللّه بسم اللّه يا فتاح أب","واب الفتوح افتح لعبدك ما انقفل",7,"ل",1,0],["اللّه بسم اللّه كشف جهالتي","بك يا عليم اكشف لعقلي ما جهل",7,"ل",1,0],["اللّه بسم اللّه خذ يا قابض ال","أرواح روح الظالمي الطاغي المضل",7,"ل",1,0],["اللّه بسم اللّه جد لي بسطة","يا باسط الخيرات للعبد المقل",7,"ل",1,0],["اللّه بسم اللّه خافض من طغى","بك أستجير من العدى اخفضهم بذل",7,"ل",1,0],["اللّه بسم اللّه رافع أهله ار","فعني من الدرجات في أسنى محل",7,"ل",1,0],["اللّه بسم اللّه ثبت عمرتي","لك اللّه بسم اللّه معز وذل خصمي يا مذل",7,"ل",1,0],["اللّه بسم اللّه سمعاً دعوتي","لك يا سميع وأنت تسمع من وأل",7,"ل",1,0],["اللّه بسم اللّه قو بصيرتي","بك يا بصير إلى المراشد استدل",7,"ل",1,0],["اللّه بسم اللّه يا حكم انتقم","من ظالمي أشكوه خذه بلا مهل",7,"ل",1,0],["اللّه بسم اللّه يا عدل اجترى","هذا الظلوم وأنت أعدل من عدل",7,"ل",1,0],["اللّه بسم اللّه لطفاً في النوا","زل يا لطيف الطف بنا فيما نزل",7,"ل",1,0],["اللّه بسم اللّه أظهر لي الحقا","ئق يا خبير لا يزال ولم يزل",7,"ل",1,0],["اللّه بسم اللّه عبدك مسرف","وعظيم حلمك يا حليم هو الأمل",7,"ل",1,0],["اللّه بسم اللّه أعظم بغيتي","فوزاً عظيماً يا عظيم تلا الأجل",7,"ل",1,0],["اللّه بسم اللّه بالغفران جد","لي يا غفور فما بعدلك لي قبل",7,"ل",1,0],["اللّه بسم اللّه هب لي الشكر في ال","نعم الدقيقة يا شكور وفي الجلل",7,"ل",1,0],["اللّه بسم اللّه أعل مكانتي","بعلو علمك يا علي وبالعلل",7,"ل",1,0],["اللّه بسم اللّه جلت كبريا","ؤك يا كبير فلا نديد ولا مثل",7,"ل",1,0],["اللّه بسم اللّه حفظاً شاملاً","أنا يا حفيظ بما تراه معتقل",7,"ل",1,0],["اللّه بسم اللّه أنت المنعم ال","معطي المقيت افتح وبارك ما حصل",7,"ل",1,0],["اللّه بسم اللّه حسبي اللّه في ال","تفصيل من قدر الحسيب وفي الجمل",7,"ل",1,0],["اللّه بسم اللّه جل جلاله","بك يا جليل اجل عن شين الخلل",7,"ل",1,0],["اللّه بسم اللّه أكرم موقفي","أنت الكريم وأنت أحفى من كفل",7,"ل",1,0],["اللّه بسم اللّه حسبي أن عل","مك يا رقيب بسوء حالي لم يحل",7,"ل",1,0],["اللّه بسم اللّه كاشف سوء مض","طر دعاه مجيب دعوة من سأل",7,"ل",1,0],["اللّه بسم اللّه دافع كل ض","ر يا حكيم ادفع بحكمتك العلل",7,"ل",1,0],["اللّه بسم اللّه ذي العرش المج","يد بحق ودك يا ودود اغث وصل",7,"ل",1,0],["اللّه بسم اللّه مجدك موئلي","بك يا مجيد الود باسمك ابتهل",7,"ل",1,0],["اللّه بسم اللّه فابعث باعث ال","موتى بلطفك يا لطيف لم يزل",7,"ل",1,0],["اللّه بسم اللّه أشهد لي عيو","بي مخلصاً لك يا شهيد بالعمل",7,"ل",1,0],["اللّه بسم اللّه يا حق اكفني","أسواء نفسي والمعالي والقبل",7,"ل",1,0],["اللّه بسم اللّه كن لي في أمو","ري يا وكيل ويا حسيب من اتكل",7,"ل",1,0],["اللّه بسم اللّه قو عزائمي","في مرضياتك يا قوي من العمل",7,"ل",1,0],["اللّه بسم اللّه متن حبل ح","ظي يا متين فإن حظي منبتل",7,"ل",1,0],["اللّه بسم اللّه رب تولني","بك يا ولي أولوذ في ضيق الحيل",7,"ل",1,0],["اللّه بسم اللّه أنت المنعم ال","ملك الحميد وحمدك الحمد الأجل",7,"ل",1,0],["اللّه بسم اللّه سخر لي الكوا","ئن أنت محصي كل شيء في الأزل",7,"ل",1,0],["اللّه بسم اللّه أوجد مطلبي","يا موجد الأشياء لا تحكي مثل",7,"ل",1,0],["اللّه بسم اللّه عد لي عودة","أنت المعيد وأنت أحفى من بذل",7,"ل",1,0],["اللّه بسم اللّه احي سريرتي","بالذكر يا محيي وصنعة من وصل",7,"ل",1,0],[