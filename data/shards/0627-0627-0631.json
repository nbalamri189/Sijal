ry.dctabudhabi.ae/diwan/poem/105557","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107491","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73103","الرجز"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132195","الطويل"],[4729,"أَرَاجِعٌ لي عَيشي الفَارِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=109457",""],[3464,"الحمد مقصور عليه ذي السنا","https://www.poetsgate.com/ViewPoem.aspx?id=158703",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5010,"ابنتي أريج","https://www.poetsgate.com/ViewPoem.aspx?id=189988",""],[5013,"نعى الدين والدنيا فعم ظلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170966",""],[5277,"قضاءٌ بلا قضاة","https://www.poetsgate.com/ViewPoem.aspx?id=187536",""],[5343,"عجزت عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=132536",""],[5442,"ذاك الفراق وان أصم مسامعي","https://www.poetsgate.com/ViewPoem.aspx?id=114744",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5582,"بَكَرَ الخَلِيطُ مِنَ الدِّيارِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186853",""],[5703,"حط العصفور بشباكي","https://www.poetsgate.com/ViewPoem.aspx?id=207400",""],[5768,"بَيْرُوتُ وأُمَّتُنَا الْجَرِيحَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=215488",""],[5804,"الريح","https://www.poetsgate.com/ViewPoem.aspx?id=180079",""],[5899,"تخيل , إنها تسأل","https://www.poetsgate.com/ViewPoem.aspx?id=31109",""],[5939,"طفلٌ بلا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=178610",""],[5956,"هلّا منحت إليّ بعض محبة","https://www.poetsgate.com/ViewPoem.aspx?id=194016",""],[5988,"ألا يا حماري كنت زيني وحليتي","https://www.poetsgate.com/ViewPoem.aspx?id=99720",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6055,"إلى الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=29789",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[463,"ألأجلِ تيسٍ لفظه وضُراطُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60177&r=&rc=233",""],[6263,"كما شئتَ يا شعر...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81062&r=&rc=13",""],[6288,"الشوق الحزين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79623&r=&rc=40",""],[5190,"دعاة الشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85051&r=&rc=126",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["أَأَرجو شِفاءً مِنهُ وَهوَ الَّذي جَنى","عَلى بَدَني داءَ الضَنى وَشَجاني",0,"ن",2,0],["أَأَرجو المَعالي بِغَيرِ الطِلابِ","وَمِن أَينَ يَحلُمُ مَن لَم يَنَم",1,"م",1,0],["أَأَرجو لِلحَواضِنِ كَاِبنِ لَيلى","أَحَلتُ إِذاً عَلى بَطنٍ عَقيمِ",2,"م",1,0],["أَأَرهَبُ القَتلَ حِذارَ ميتَةٍ","لا بُدَّ أَلقاها بِغَيرِ قاتِلِ",3,"ل",1,0],["أَأَرجو ذُبابَ السَيفِ ثُمَّ أَخافُهُ","وَأَرضى بِسُخطِ المَجدِ قَولَ عَذولِ",4,"ل",1,0],["أَأُرسِلُ خَيلَ اللِحظِ في طَلَبِ الهَوى","وَمِن ظَنِّها أَنَّ الخُدودَ طَرائِدُ",5,"د",1,0],["أَأَرجو وَقَد حاوَلتُ في الهِندِ عَودَةً","إِلَيهِم لَقَد حاوَلتُ أَطماعَ أَشعَبِ",6,"ب",1,0],["أأروم عنه رضاع كأس مسلياً","لا أم لي إن كان ذاك ولا أب",7,"ب",1,0],["أأرديتُم يحيى ولم يُطْو أيْطَلٌ","طِراداً ولم يُدبْر من الخيل مَنْسِجُ",8,"ج",1,0],["أَأَردْتَ ترفيهي فلم يَكُ فَادِحٌ","أَرْجُو بهِ الزُّلْفَى لديك ليَفْدَحا",9,"ح",2,0],["أأرِفض الاعتزَال رأياً","كلّا لَهنِّي به ضنينُ",10,"ن",1,0],["أَأَرقُدُ وَالخُطوبُ تَطوفُ حَولي","وَأَقعُدُ بَعدَما الثَقَلانِ قاما",11,"م",2,0],["أَأَرضُ الخَيالِ وَآياتِهِ","وَذاتُ الجَلالِ وَذاتُ السَنا",12,"ن",2,0],["أَأَرحَلُ مِن مِصرٍ وَطيبِ نَعيمِها","فَأَيُّ مَكانٍ بَعدَها لِيَ شائِقُ",13,"ق",1,1],["أارى الصباح ولا اغرد شاهقاً","اني اذاً حجر من الاحجار",14,"ر",1,0],["أأرملة الجندي لا تخجلي فمن","حقوق العلى أن الحكومة تخجل",15,"ل",1,0],["أَأَرضى أَن أَعيشَ وَلا أُكافي","عَلى ما لِلأَميرِ مِنَ الأَيادي",16,"د",2,0],["أَأَرهَبُ الدَهرَ أَو أَخشى تَصَرُّفَهُ","وَالمُستَعينُ مُعيني فيهِ أَو جاري",17,"ر",2,0],["أَأَراكَ الحَبيبَ خاطِرُ وَهمِ","أَم أَزارَتكَهُ أَضاليلُ حُلمِ",18,"م",1,1],["أَأَرغَبُ عن وَدادِ أبي تُرابٍ","وقد شحَنَ التَّرائبَ والضُّلوعا",19,"ع",2,0],["أَ أَرغَبُ في اللَّذَّاتِ من بعدِ فارسِ","وقد رُمِيَتْ من نُسكِهِ بالدَّهارسِ",20,"س",1,0],["أَأَرضى بِقَتلي في الهَوى وَهوَ ساخِطٌ","وَأَبسِطُ أَعذاري لَهُ وَهوَ مُجرِمُ",21,"م",1,0],["أأرى شروقك في أفول مغاربي","وأشم عطرك في ذبول شبابي",22,"ا",3,0],["أَأَرى الصَنيعَةَ مِنكَ ثُمَّ أُسِرُّها","إِنّي إِذاً لِيَدِ الكِرامِ لَسارِقُ",23,"ق",1,0],["أأرجعُ بعدَ العتقِ في الرقِّ ثانياً","فلا أمَّ لي إنْ كانَ ذاكَ ولا أبُ",24,"ب",1,0],["أَأُرضي بِلَيلى الكاشِحينَ وَأَبتَغي","كَرامَةَ أَعدائي بِها فَأُهينُها",25,"ن",3,0],["أأرادَ إلا أن تكونَ حياتُنا","كالدّارسِ العافي من الأطلالِ",26,"ل",1,0],["أَأَرى بِلاداً تَستَقِلُّ وَأُمَّةً","تَأبى الحِمايَةَ أَم أُشاهِدُ مَلعَبا",27,"ب",2,0],["أأرجعُ يا حِمَى الضُّعفاءِ وَلْهَى","وما لي في ظِلالِكَ مِن نَصيبِ",28,"ب",1,0],["أَأَرفَعُ نيرانَ القِرى لِعُفاتِها","وَأَضرِبُ يَومَ الرَوعِ في ثَغرَةِ الثَغرِ",29,"ر",1,0],["أَأَرَدتَ أَن تَأتي عَلَيَّ بِما","حَدَّثتَني وَتَغُمُّني دَهري",30,"ر",2,0],["أَأَرفُضُها وَاللَهُ لَم يَرفُضِ اسمَها","وَهَذا أَميرُ المُؤمِنينَ صَديقُها",31,"ق",3,0],["أَأَرِقتَ بَعدَ رُقادِكَ الأَوّابِ","بِهَواكَ أَم بِخَيالِهِ المُنتابِ",32,"ب",1,1],["أأرجِع أدراجي ولم أك عارفاً","جَليّة هذا الأمر أم كيف أصنع",33,"ع",1,0],["أأرحامٌ مقطَّعَةٌ وأرضٌ","تَعادى فوقَها أهلٌ وصَحْبُ",34,"ب",1,0],["أأراني عاجزاً عن دركِ ما","تتمنَّى امرأةٌ عزّت مناها",35,"ا",3,0],["أَأُرِيكُمْ مَا كَانَ يُنْفِقُ فِيهِ","وَقْتَهُ حِينَ يُسْتَطَابُ الجَمَامُ",36,"م",1,0],["أأرمي أخي يا ويلَ ما صنعتْ يدي","فيا ليتها كانتْ بغيرِ أنامل",37,"ل",1,0],["أأرغبُ أن أعيشَ أرى بناتي","عَوارِيَ، قد أضرَّ بها الحَفاءُ",38,"ا",2,0],["أارضي بملح من قليب اكده","عن العذب تياراً تموج خضارمه",39,"م",2,0],["أأَرعى السّفوح ولي همّةٌ","مُطنِّبةٌ في نَواصي القُنَنْ",40,"ن",1,0],["أََأَركَبُ صَعبَ الأَمرِ إِنَّ ذَلُولَهُ","بِنَجرَانَ قَد أَعيا بِكلِّ مَكانِ",41,"ن",1,0],["أَأَرضِى بلَيلَى الكاشِحينَ وَأَبتَغِى","كَرَامَةَ أَعدَائِى بِهَا وأُهِينُهَا",42,"ن",3,0],["أأرجو سَمِىَّ المصطفى وابنَ عمِّه","لحادثةٍ عَمَّت وأنت نصيح",43,"ح",1,0],["أأروم أنّني الذي أعطيتُها","كبر يغرّ النفس عن إلمامها",44,"م",3,0],["أَأُرجّي مَعاشراً فيهمُ الأر","واحُ موتى لها الجسوم قبورُ",45,"ر",1,0],["أَأَرى صورَةً وَأَسمَعُ صَوتاً","قَبلَ أَن يَرجعَ الحَبيبُ النائي",46,"ي",1,0],["أأردتَ من قلِقِ الحشى أن يرعوِي","ومنَ المتيّم قلبُه أن يُقلِعا",47,"ع",2,0],["أَأَرومُ مِن كَلَفي عَلَيهِ تَخَلُّصاً","لا وَالَّذي بَطحاء مَكَّةَ بيتُهُ",48,"ت",2,0],["أَأُرَى أَحْظَى بِوَصْلٍ بَعْدَمَا","بَعُدَتْ مِنْ طَاقَتِي تِلْكَ الدِّيَارْ",49,"ر",1,0],["أَأَرْفَعَ شَيْءٍ حَطَّ قَدْرِي بَيْنَكُمْ","وَقَدْ كُنْتُ مِنْ قَبْلِ النَّوَى شَأْنِيَ الشَّانُ",50,"ن",1,0],["أأرجو حياةً عِندِ من ماسَ أو رنا","ورامِحُهُ يَسطو على ونابله",51,"ل",2,0],["أأردُّ كفي عن ثيابكِ عفةً","والشوقُ يدفعُني إلى التمزيق",52,"ق",1,0],["أَأَراكِ تبتَسمينَ لي في خلوةٍ","أم قلبكِ القاسي يظلُّ ضنينا",53,"ن",2,0],["أأرحلُ عن مغناكِ غيرَ مزوَّدٍ","إِلى البلدِ المزدان بالآسِ والنخل",54,"ل",1,0],["أَأرضى لِنفسي أن تكونَ ذليلةً","وقد حَسدتها في سماءِ العُلى الزُّهر",55,"ر",1,0],["أأرتعُ في حماها بين صَحبي","وأشفي من أطايبها الغليلا",56,"ل",2,0],["أَأَرْتَجِي غَيْرَ عَمّارٍ لِنائِبَةٍ","إِذَنْ فَلا آمَنَتْنِي كَفُّهُ النُّوبَا",57,"ب",2,0],["أََأَرْجُو انْتِصاراً بَعْدَ ما خُذِلَ النَّدَى","وَآمُلُ عِزّاً والْكِرامُ تُطَحْطَحُ",58,"ح",1,0],["أَأَرهَبُ مِن رَمضاءِ عُسرٍ وَظِلُّهُ","مَديدٌ لِمَن يَأوي إِلَيهِ ظَليلُ",59,"ل",1,0],["أَأُراعِ في زَمَني بِإِعسارٍ وَلي","بابُ الإِلَهِ وَكَفُّكَ المِفتاحُ",60,"ح",1,0],["أَأراهُ سرّاً ثمّ آمنهم وحا","لهُم معي بادٍ لكلّ أريبِ",61,"ب",1,0],["أَأَرومُ طاعَةَ مَن مَلَكتُ وَحالُهُ","حالي وَأُعصي مالِكَ المُلّاكِ",62,"ك",1,1],["أَأَرعى نَجمَ لَيلك وَهوَ سارٍ","وَطَرفي ساهِرٌ وَالقَلب سالي",63,"ل",2,0],["أَأرجُو أن يُخَفِّفَ ثِقلُ وَجدِي","وَأنتَ تَنُوءُ بالعِبءِ الثَّقِيلِ",64,"ل",1,0],["أأرجو شِفائي أنْ يكونَ بكفِّها","وقد أصبَحتْ مخضوبةَ العَشْر من دمي",65,"م",2,0],["أَأَرجِعُ عنكَ الطَّرْفَ حتّى أُعيدَه","على عَجَلٍ إنّي إذَنْ لَصَبور",66,"ر",1,0],["أأراكةَ الوادي سقَتْكِ غُيوثُ","ونَماكِ مَوْلىُّ التلاعِ دَميثُ",67,"ث",1,1],["أَأَرجوا مِن الإِلمام بِالطَلل البالي","لَما بيَ أَبلالاً وَذَلِكَ أَبلى لي",68,"ل",2,1],["أَارى حِمامي كامِناً","في مُقلَتيكَ فَلا أُبالي",69,"ل",2,0],["أأروم طيفاً منك يطرق مقلتي","أيكون لليقظان طيف منام",70,"م",1,0],["أأرضى الطليق ابن الطليق وقد بغى","وقاد لحرب المرتضى كل مجتر",71,"ر",1,0],["أأرومُ في أيَامِ عِزِّكَ بَسْطَةٌ","في الجاهِ لي إنِّي لَعينُ الجاهِلِ",72,"ل",1,0],["أأرومُ بعدَكُم محبّاً صادقاً","هيهاتَ ضاقَ العمرُ عما رمتُهُ",73,"ت",2,0],["أأرود أملاك البلاد ورفدهم","سفها وربع الجود فيهم ممحل",74,"ل",1,0],["أأرضى بأن أرضى عمانا محلة","ولم أر لي فيها سحراً ولا حنسا",75,"س",2,0],["أأرضى مدى عمري وللعمر ساعةٌ","بأني من خمر الذنوب أزيف",76,"ف",1,0],["أأربابَ نُعمايَ التي مذ عدِمتها","علمتُ وقد أثريتُ أنّيَ معدمُ",77,"م",1,0],["أأركض أبغي في البلاد معوضةً","بكم طال تطوافي إذن فتركُّضي",78,"ض",2,0],["أَأُراعُ منه وما شَحَذْتُ عزيمَتي","اِلاّ وفلَّلتُ السيوفَ مواضيا",79,"ي",2,0],["أَأَرومُ وصلكِ بعدَما زجرَ النُّهَى","عنه طماعِيَتي وكفَّ غراميا",79,"ي",2,0],["أأرجِعُ بعدما بانتْ سَفاهاً","أُحاولُ أن يُخاطبَني الجمادُ",80,"د",1,0],["أأراها وإخوتي في شقاء","وأقضّي الحياة بالتمويه",81,"ي",2,0],["أأرى بها منعي على نشرية","ما بينهم وأنا من الشعراء",82,"ا",2,0],["أأرجو بقاء أم صفاء حياة","وقد بددت شملي النوى بشتات",83,"ت",1,1],["أُأُرسِلُه ولم أحسُدك شِعري","وأنتَ تَحوزُه وتُجيبُ شٍعرا",84,"ر",2,0],["أَأرغَب عَنهُ وَهوَ في الحُسن مُفرَدٌ","نَبيُّ جَمالٍ لا يُقاس بِثاني",85,"ن",2,0],["أَأُرَجّي مَعاشِراً فيهمُ الأَر","واحُ منّي لَها الجُسومُ قُبورُ",86,"ر",1,0],["أأرْضاهُم وما مِنهم رضياً","سَأوسعهم بعاداً وانصراما",87,"م",2,0],["أأرضى بشكواك الزمان وأهله","ولستُ بذي نابٍ يصُول وأظفار",88,"ر",1,1],["أأُرجي من العواذل نصحاً","ما قفا حارةَ الكلاب عظامُ",89,"م",1,0],["أأروم غيرك خلةً من بعد ما","أفنيت فيك نضارتي وشبابي",90,"ب",2,0],["أَأُرْضيهِمُ فيها ولِيْ مِ