َخافُ اِنهِيالُها","وَأَغصانُ بانٍ ما يُخافُ ذُبولُها",4,"ل",3,0],["حُقوقٌ عَلَيَّ رَأى أَنَّها","حُقوّقٌ عَليهِ فَوالى وَراعى",5,"ع",2,0],["حَقيبَةُ شَرٍّ بِئسَ ما اِختارَ رَبُّها","إِذا نُفِضَت عِندَ الإِيابِ المَآزِرُ",6,"ر",1,0],["حَقِّرْ لَهَا الْفَانِي وَحَاوِلْ زُهْدَهَا","وَشَوِّقْهَا إِلَى الَّذِي تَسْتَقْبِلُ",7,"ل",1,0],["حقٌّ على مَنْ يستَطيعُ لسانُهُ","صوْغَ النِّظامِ أو النثارِ بدارُهُ",8,"ر",2,0],["حقٌّ على المَوْلى ابْنِهِ إيثارُ ما","بَذَلوهُ منْ نصْرٍ ومنْ إيثارِ",9,"ر",1,0],["حقِّرْ لَها ما في يَديْها بَدْأةً","واضْمَنْ لَها عِوَضاً وإنْ لمْ يَحْضُرِ",10,"ر",1,1],["حَقيقٌ عليْنا أنْ نحُلَّ لكِ الحُبى","ونَقْريكِ منّا البِرَّ والشُّكْرَ والحَمْدا",11,"د",2,0],["حَقِّقْ ظُنُونَ بَنِيهِ فِيكَ فَإِنَّهُمْ","يَتَعَلَّلُونَ بِوَعْدِكَ الْمَرْقُوبِ",12,"ب",1,0],["حَقِّقِ القَولَ إِذا ما قُلتَهُ","واحذَرَن مَخزاتَهُ في المَجمَعَه",13,"ع",2,0],["حَقٌّ تُناصِرُهُ وَمَفخَرَةٌ","تَمشي إِلَيها غَيرَ مُنتَحِلِ",14,"ل",1,0],["حَقَنتَ بِالصُلحِ وَالرَأيِ السَديدِ دَماً","رَوّى الشِعابَ وَرَوّى الصارِمَ الذَكَرا",15,"ر",2,0],["حَقًّا أجْدْتَ وَأَنْتَ أحْ","رَى مَنْ أَجَادَ بِأَنْ تُثَابَا",16,"ب",2,0],["حَقُّهُ الذِّكْرَى تُخَلِّدُهُ","بِجَمِيلِ القَوْلِ لاَ النَّحْبِ",17,"ب",1,0],["حقيقٌ بوادي النيل إبداء سعده","على أن ما في النفس أضعاف ما بدا",18,"د",2,0],["حق لمن هذي مناسب فخره","أن يرن المجد الأثيل بأمثلا",19,"ل",2,0],["حَقَّقْتَ مَا رَجَّتْهُ فِيكَ بِهِمَّةٍ","لَمْ يَشْهَدِ الجِيلُ الحَدِيثُ نَدِيدَهَا",20,"د",3,0],["حَقِيقَةٌ إِنْ جَرَى هَذَا اللِّسَانُ بِهَا","فَعَنْ أَسىً لِلأُُولَى عَاتَبْتُ لا ضَغَنِ",21,"ن",1,0],["حَقُّ الضِّعَافِ مِنْ بَني الإنْسَانِ","يَا حُسْنَهَا مِنْ خُطَّةٍ نَبِيلَةْ",22,"ه",1,0],["حَقُّ البَنِينَ عَلَيْكَ كَيفَ يُضِيعُهُ","كَهْفُ الغَرِيبِ وَمَوْئِلُ المَحْرُومِ",23,"م",1,0],["حَقَّقْتُمُ الأُمْنِيَّةَ الكُبْرَى وَلَمْ","تُزْجَ الجُيُوشُ وَلَمْ يُسَلَّ حُسَامُ",24,"م",1,0],["حَقُّ البِلادِ طَلَبْتُمُوهُ كَامِلاً","لا خَوْفَ يَنْقُصُهُ وَلا اسْتِسْلامُ",24,"م",1,0],["حَقِيقَةَ البَدَوِيِّ الحُرِّ مُبْتَغِياً","لِقَوْمِهِ غَيْرَ بَاغٍ أُلْفَةَ الرَّحِمِ",25,"م",1,0],["حَقَائِقُ مَرَّتْ بِالحَيَاةِ هُنَيْهَةً","كَمَا مَرَّتِ الأَوْهَامُ فِي ذِهْنِ وَاهِمِ",26,"م",1,0],["حَقِّقْ مُنَاكَ الَّتِي جَدَّتْ فَحَسْبُكَ مَا","بِهِ زَهَتْ مِنْ دَرَارِي فِكْرِكَ الظُّلَمُ",27,"م",1,0],["حَق البِلادِ عَلَيْكَ أَعْلَى حُرْمَةً","مِنْ أَنْ يُضَاعَ بِمُزْرِيَاتِ سَخَائِمِ",28,"م",1,0],["حَقُّ الْبِلاَدِ كُلُّ تَفْدِيَةٍ","فِي الطَّارِئَاتِ مِنَ الأَحْدَاثِ وَالأُزُمِ",29,"م",1,0],["حقاً لقد أوضحتَ من آثارهم","لما أخذت لدينهم بالثارِ",30,"ر",1,0],["حقيقة مخلوقاته لم تكن سوى","حقيقته دع عنكَ حدس المحدّس",31,"س",1,0],["حُقّ للدمع أن يكون نشيدا","في بكائي أبا أمين رشيدا",32,"د",2,1],["حَقائِبُهُم راحٌ عَتيقٌ وَدَرمَكٌ","وَرَيطٌ وَفاثورِيَّةٌ وَسَلاسِلُ",33,"ل",1,0],["حَقّاً لَقَد ساءَني أَمرٌ ذُكِرتُ لَهُ","لَولا فِراقُكَ لَم يوجَد لَهُ أَلَمُ",34,"م",1,0],["حقًّا لقد أنجبتمو يا بني","شيبانَ في المجدِ وفي وُلده",35,"د",2,0],["حقّ عليه وفاؤه","في وقته ومكانِهِ",36,"ن",2,0],["حَقيقَةُ الحَقِّ تَستَنيرُ","صارِخَةً بِالنَبا خَبيرُ",37,"ر",1,1],["حَقيقَةٌ فيهِ قَد تَجَلَّت","مَطلَبُ مَن رامَها عَسيرُ",37,"ر",1,0],["حقّاً لقد أولَيتَنَا جَفوةً","يُمحِلُ منها البلدُ العاشبُ",38,"ب",1,0],["حَقَّقها بالشمس أن رُبِّيَتْ","في حِجْرها والشَّبَهُ الغالبُ",38,"ب",1,0],["حقاً لقد نطقَ البشيرُ بيمنهِ","ولربما نطق البشير فأعربا",39,"ب",2,0],["حقُّ الخليفةِ أن أُطيلَ مديحَهُ","لكنني أوجزتُ لما أطنبا",39,"ب",2,0],["حقُّك أن تستبيح منِّي","ما ليس منِّي بمستباحِ",40,"ح",1,0],["حَقَنْتَ دِمَاءَ العَقْرِ والعُقْرِ بعْدَمَا","هُريقَتْ حَرَاماً والخَليُّون رُقّدُ",41,"د",1,0],["حقُّه واجبٌ عليك وحقي","بانتحال المقال عين السديدِ",42,"د",1,0],["حَقِّيَ ظني بك الجميل إذا","ساءت ظنوني وخانت العُددُ",43,"د",1,0],["حُقَّ عند الرجاء فيك المرجّى","أن يحق المرجوُّ لا المحذورُ",44,"ر",1,0],["حقرتَ لي منه غير محتقرٍ","فراث عني لذاك إحضاره",45,"ر",2,0],["حقدتُ عليك ذنباً بعد ذنبٍ","ولو أحسنت كان الحقد شكرا",46,"ر",2,1],["حُقّ لذي الشيب أن يعفّرهُ","لا بل كفاه بالشيب من عَفر",47,"ر",1,0],["حُقّر الفضل ثم صُغّر عنهُ","زادك الله يا صغير الحقير",48,"ر",1,0],["حق لك الكبر على عاشق","نارك في جنبيه لذاعه",49,"ع",2,0],["حق أتاح الله لي قوله","وقد يتاح الصدق للناطق",50,"ق",1,0],["حُقِّق للسيد تأميلُه","فيه ولا حقق إشفاقه",51,"ق",2,0],["حقّاً لقد سَلَّكَ الهُدى ذكَراً","عضْباً وكان الضلالُ قد غمدكْ",52,"ك",1,0],["حُقَّ بالإنصافِ خصمٌ","رفعَ العَدْوَى إليكا",53,"ك",2,0],["حقَّ الذي أعطاك وهْوَ الفعّالْ","أنك مسئولٌ وأنا سُؤَّالْ",54,"ل",1,0],["حقُّ الأديب لازمٌ لذي الكرَمْ","فإن تناسى حقَّه فقد ظلَمْ",55,"م",1,1],["حقُّها لو يُسلَّفُ المحْسنُ الجَنْ","نَةَ تَسليفَها نعيمَ الجِنانِ",56,"ن",1,0],["حَقَنَ الدِماءَ وَرَدَّ أُلفَتَهُم لَهُم","وَجَزاهُمُ بِالعُرفِ وَالإِنكارِ",57,"ر",1,0],["حَقٌّ عَلى العِلمِ أَن يَبكي عَلَيهِ كَما","يَبكي الشَقيقُ أَخا وَالوالِدُ الوَلَدا",58,"د",2,0],["حِقدُ القُلوبِ عَلَيكُم لا يَزولُ وَإِن","زُلتُم وَزُلنا وَزالَ العالَمُ الفاني",59,"ن",2,0],["حَقٌّ عَلَيَّ وَواجِبٌ لَكَ أَنَّني","أَمشي عَلى عَيني إِلَيكَ وَراسي",60,"ي",1,0],["حقيقةٌ مرّةٌ يا ليلُ مُبْغَضَةٌ","كالموتِ لكنْ إليها الوِرْدُ والصَّدَرُ",61,"ر",1,0],["حقنا في ظهوره","مثل نار على علم",62,"م",1,0],["حق هناك وباطل","ولقد يلاقي الضد ضدا",63,"د",2,0],["حقائق قد اعجزت كل رأس","واعجز ما في الرؤس العقول",64,"ل",1,0],["حققتها فوجدتها","بين البنوّة والنبوّة",65,"و",2,0],["حقيقة وضعوها","فليس فيها كلام",66,"م",1,0],["حَقيقةٌ لَيسَ لَها مُفنِّدُ","كُل مُهنّد لَهُ مُهَنّدُ",67,"د",1,0],["حَقَّ الدَلالُ لِمَن لَهُ","في كُلِّ جارِحَةٍ مَكان",68,"ن",1,0],["حَقَرتَ لَها زِماماً كُنتَ فيهِ","لَعوباً بِالحُكومَةِ وَالذِمامِ",69,"م",1,0],["حَقٌّ أَعَزَّ بِكَ المُهَيمِنُ نَصرَهُ","وَالحَقُّ مَنصورٌ عَلى خُذّالِهِ",70,"ل",2,0],["حَقُّ العَشيرَةِ في نُبوغِكَ أَوَّلٌ","فَاِنظُر لَعَلَّكَ بِالعَشيرَةِ بادي",71,"د",2,0],["حَقُّ الكَواكِبِ أَن تَزورَكَ مِن عَلٍ","وَتَعودَكَ الآسادُ مِن غاباتِها",72,"ت",3,0],["حَقَرتَ الرُدَينِيّاتِ حَتّى طَرَحتَها","وَحَتّى كَأَنَّ السَيفَ لِلرُمحِ شاتِمُ",73,"م",1,0],["حقائق تشبه المجاز وأمثال","يحاكي صدقها الكذبا",74,"ب",2,0],["حقّاً لقد ولَّى الأمورَ مجرِّبَاً","إنْ همَّ أمضَى أو تدفَّق أغزرا",75,"ر",2,0],["حِقاقُ ت