{"poems":[[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[32,"وراد أسمال المياه السدم","https://www.aldiwan.net/poem29435.html","الرجز"],[29,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[74,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[40,"عفت بعدنا أجراع بكر فتولب","https://www.aldiwan.net/poem7688.html","الطويل"],[40,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[30,"لأمدحن بني المهلب مدحة","https://www.aldiwan.net/poem5176.html","الكامل"],[52,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[78,"ورادعة بأنفاس العبير","https://www.aldiwan.net/poem39303.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62237","البسيط"],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[305,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77623","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80015","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46852","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216787","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36799","الطويل"],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[5732,"انا من نجد يكفيني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=177852",""]],"verses":[["وِرادٌ وشُقْرٌ واضِحاتٌ شِياتُها","فأجْسامُها تِبْرٌ وأرْجُلُها دُرُّ",0,"ر",1,0],["وَرادِعَةٍ بِالمِسكِ صَفراءَ عِندَنا","لَجَسَّ النَدامى في يَدِ الدَرعِ مَفتَقُ",1,"ق",1,0],["وُرّادُ أَسمالِ المِياهِ السُدمِ","في أُخرَياتِ الغَبَشِ المِغَمِّ",2,"م",1,1],["وَرادَفَ الأَملاكَ مِنّا رِدفان","قَد عَلِمَت بَكرٌ وَقَيسُ عَيلان",3,"ن",1,0],["ورادف حسن خَلق حسن خُلق","فلم يقنع بإحدى الحسنيين",4,"ن",1,0],["وِرادُ الأَعالي أَقبَلَت بِنُحورِها","عَلى راشِحٍ ذي شامَةٍ مُتَقَوِّبِ",5,"ب",1,0],["وَرادَ طَرفُكَ في صَحراءَ ضاحِيَةٍ","فيها لِعَينَيكَ وَالأَظعانِ مُطَّرِدُ",6,"د",1,0],["وَرّادَةٌ شُعَبَ المَنِيَّةِ بِالقَنا","فَيُدِرُّ كُلُّ مُعانِدٍ نَعّارِ",7,"ر",1,0],["وَرّادَةٌ كُلَّ طامِي الجَمِّ عَرمَضُهُ","في ظِلِّ عِقبانِهِ مُستَأسِدٌ نَشِبُ",8,"ب",1,0],["ورادعةٍ بأنفاسِ العبيرِ","مُقنّعةِ المفارقِ بالقتيرِ",9,"ر",1,1],["وَرَّادُ نَقْعٍ عَلَى مَا كَانَ مِنْ وَحَلٍ","لاَ يُسْتَهَدُّ إِذَا مَا صَوَّتَ البُومُ",10,"م",1,0],["وَرَّادُ أَعْلَى دَحْلَ يَهْدِجُ دُونَهَا","قَرَباً يُواصِلُهُ بخِمْسٍ كاملِ",11,"ل",1,0],["وَرّادِ أَحواضِ المَنونِ إِذا طَغَت","وَالدُهمُ مِن عَلَقِ النَجيعِ وِرادُ",12,"د",1,0],["وَرّادَةٌ يَومَ نَعبِ المَوتِ رايَتُهُم","حَتّى يَفيءَ إِلَيها النَصرُ وَالظَفَرُ",13,"ر",1,0],["وِراداً وَحُوّاً مُشرِفاً حَجَباتُها","بَناتِ حِصانٍ قَد تُعولِمَ مُنجِبِ",14,"ب",1,0],["وَرادَ كُلَّ ما رَأى مِن جُحر","وَهوَ يَروغ خائِفاً وَيَجري",15,"ي",1,0],["ورادعَه طيباً ألست بناشقٍ","على جسمه طيبَ التقى ورداعه",16,"ع",2,0],["ورّادة حوض الردى كرّارة","في ساعة الجعجاع والاحجام",17,"م",1,0],["ورّادَ أمْواهِ الطِّلى طُرُقاً بها","فَكَأنَّ أشْرِبَةً هُناك لِذاذا",18,"ذ",2,0],["ورادته أشكال الجمال كأنها","خيالات أحلام دعاهنّ نوّم",19,"م",1,0],["وَرادَ جمامَ الطَبعِ مِن كَدِّ مَنصِبٍ","فَظَنَّ جَهُولٌ أَن ذَلِكَ عَن أَرطا",20,"ط",2,0],["وراد الضحى قد لاحت الزهر أذيناً","كسوف لشمس الفضل بين العوالم",21,"م",1,0],["ورا دنياي عقبه لوعتني","من الفرقا تكر لي صفاها",22,"ا",3,0]]}