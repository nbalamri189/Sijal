=187891",""],[5362,"رزء به للدين طاح دعام","https://www.poetsgate.com/ViewPoem.aspx?id=170391",""],[5376,"يا داحسَ الغبراءُ هيْتَ مُظفَّرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205986",""],[5533,"في ذكرى المولد النَّبَوي","https://www.poetsgate.com/ViewPoem.aspx?id=176283",""],[5535,"دنيا المحب ودينه أحبابه","https://www.poetsgate.com/ViewPoem.aspx?id=201492",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5574,"جرحُ الشام!","https://www.poetsgate.com/ViewPoem.aspx?id=206023",""],[5587,"أقات وأقات","https://www.poetsgate.com/ViewPoem.aspx?id=197787",""],[5628,"لقاء في هيروشيما(1)","https://www.poetsgate.com/ViewPoem.aspx?id=178534",""],[5628,"الوثنيون المتوحشون","https://www.poetsgate.com/ViewPoem.aspx?id=178537",""],[5707,"يَا مبدعاً فِي النّظم والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=189185",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""],[4209,"قد أشرقت القلوب بالأنوار","https://www.poetsgate.com/ViewPoem.aspx?id=118059",""],[5736,"نخل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208488",""],[5865,"هذيان...","https://www.poetsgate.com/ViewPoem.aspx?id=179829",""],[5873,"خدم الأعادي","https://www.poetsgate.com/ViewPoem.aspx?id=215352",""],[5873,"روعة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=215411",""],[5956,"اشتقت لأطفاليه","https://www.poetsgate.com/ViewPoem.aspx?id=182370",""],[5956,"تحنان للخلد المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=182999",""],[5956,"أولادي والحمد لله وعقبال أولاد الجميع وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=192025",""],[5956,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=194844",""],[5956,"غزة وإسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=202518",""],[6093,"أخْلو ، ونفسيَ للهمومِ مَطَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=176070",""],[6093,"دوبيت : ( الأَقْصَى مِنَ الجِراحِ أمْسَى نَسْيَا )","https://www.poetsgate.com/ViewPoem.aspx?id=181677",""],[6093,"يَسْتَحْسِنُ القُبْحَ مَنْ يَسْتَقْبِحُ الحَسَنَا(حرب بِرُسْغٍ)","https://www.poetsgate.com/ViewPoem.aspx?id=205621",""],[6134,"هيفاء أزري ميلها الغصونا","https://www.poetsgate.com/ViewPoem.aspx?id=169598",""],[520,"يا سيدا يشهد لي خلقه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577693",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""]],"verses":[["قد أشرق العدل في أيامه فَمَحت","أنواره كل ظلم أنتج الظُلمَا",0,"م",2,0],["قد اشتبكت مصالحهم فكلٌ","لكلٍ في مجال العيش ساع",1,"ع",1,0],["قَد اِشتَدَّ حالُ المُريدينَ فيهِ","لَفَقدِ الوِصالِ وَبُعدِ الحَبيبِ",2,"ب",1,0],["قد اشترى طولَ سهادٍ بكَرىً","وقد شَرى طولَ هدوءٍ بتعَبْ",3,"ب",1,0],["قد اشترى الدورَ من ذويها","وطالبَ القومَ بالبَتاتِ",4,"ت",1,0],["قَد أَشهَدُ الشَربَ فيهِم مِزهَرٌ رَنِمٌ","وَالقَومُ تَصرَعُهُم صَهباءُ خُرطومُ",5,"م",1,0],["قَد أَشهَدوكُم مِنَ الماضي وَما نَبَشَت","مِنهُ الضَغائِنُ ما لَم تَشهَدِ الضَبُعُ",6,"ع",1,0],["قَدِ اِشتَكَت وَحشَةَ الأَحياءِ أَربُعُهُ","وَخَبَّرَت عَن أَسى المَوتى مَقابِرُهُ",7,"ر",2,0],["قد أشعلَ الروضُ ناراً في شقائقهِ","ودسَّ مِكواتَهُ فيها من القَارِ",8,"ر",1,1],["قد أَشكَلَ الأمرُ فهل من فاحِصِ","حتَّامَ لا أنفَكُّ من مُقارِصِ",9,"ص",1,1],["قَد أَشهَدُ الشارِبَ المُعَذَّلَ لا","مَعروفُهُ مُنكَرٌ وَلا حَصِرُ",10,"ر",1,0],["قَد أَشرَقَ وَأَبرَقَ وَأَحرَقَ","قَلبي بِنارِ الوَجدِ وَالاِلتِياح",11,"ح",1,0],["قَد أَشرَقَت بِنورِهِ أَيّامُهُ","كَأَنَّما تَبسِمُ عَن أَحسابِهِ",12,"ب",2,0],["قَد أَشرَقَت في قَومِهِ مِنهُمُ","ناصِيَةٌ تَنأى عَنِ السافِعِ",13,"ع",1,0],["قَد أَشرَعَت سُنبُسٌ ذَوابِلَها","وَأَرهَفَت بُحتُرٌ مَعابِلَها",14,"ل",3,1],["قد أَشرقتْ بنُورهِ البلادُ","وانقطعَ التَّشغيبُ والفسادُ",15,"د",1,0],["قد أَشهدَ اللَّهَ على نفسهِ","بأنَّه من جَهلكمْ تائبُ",16,"ب",1,0],["قَدْ أَشْبَهَتْنِي في الْهَوى لَكِنَّها","لَمْ تَحْكِني في لَوْعَتِي وَبُكائِي",17,"ا",2,0],["قَد أَشبَهَ القَطرُ دَمعي","فَما أَرى القَطرَ ميزا",18,"ز",2,0],["قَدْ أَشَدْنَا بِفَضْلِكَ الْوَافِرِ الْجَمِّ","إِذَا اسْطَاعَ شَاعِرٌ أَنْ يُشِيدَا",19,"د",2,0],["قد اشقى قنك هذا الهج","ر متى بوصالك تسعده",20,"د",2,0],["قَد أَشرَبُ الخَمرَ لكِن لا أُدنِّسُها","وَأَقرَبُ الإِثمَ لكِن لَستُ أَرتَكِبُ",21,"ب",1,0],["قد أشبهتك مدامعي","لو لم أكن فيها غريقا",22,"ق",2,0],["قَد أَشرَقَت مُذ شرقَت بِمائِها","أَزهارُها ضَواحِكاً بكِيّا",23,"ي",2,0],["قَد أَشبَهَت لِحاظُهُ سَيفَ صَلاحِ الد","دينِ في الفَتكِ بابرنسِ الكَرَك",24,"ك",1,0],["قد اشتعنتك ربي","على مداواة قلبي",25,"ي",1,0],["قَدِ اِشتملتم له ثوبَ الشمالِ وأَو","جَفتم جنوباً لها من عزمكم لجمُ",26,"م",1,0],["قَد أَشغلَت بالي بِفتنتها","في مُقلَتَيها ملكٌ بابلي",27,"ل",2,0],["قَد أُشربَ الإيمانَ ملءَ إهابهِ","وَدلى إِلى إِحسانِهِ مَزجوجه",28,"ج",2,0],["قد اشتملت في يلمقٍ وأعارها","هناك غرابُ الماء خفيه للأجر",29,"ر",1,0],["قد أشرقت بِهِمُو ايام دولتهم","على سرورٍ كذا شملٌ قد التأما",30,"م",2,0],["قد أشْعَلَ الشّيْبُ رأسي للبِلى عَجِلاً","والشّمعُ عند اشْتعالِ الرّأسِ يَنْسبك",31,"ك",1,0],["قد أشرف الإِسلام أحيا مآثراً","بها بين أرباب الفضائل يحمد",32,"د",1,0],["قد أشرقت أحسابهم فوق العلى","نوراً فأصبح كل ذي صدرٍ رحب",33,"ب",1,0],["قد أشهرت تحت حواريت بيض ظبا","شهب البزاة وهزت فوقها اسلا",34,"ل",2,1],["قد أشرقت رتب العلى وتفاخرت","بسنا شهاب سعودك المتلالي",35,"ل",2,0],["قد اشرق البدر بها","وبشمس فضل الكزبري",36,"ي",1,0],["قد اشتركا في جود كفّيه ذو الفنى","وذو الفقر لم يخصص بجدواه معسرا",37,"ر",2,0],["قد اشتفى الدهرُ من قساوته","وما اشتفى العاذلاتُ من عذلي",38,"ل",2,0],["قد اشتاقك المُلْكُ الذي أنت أنسهُ","وأُوحِشَ صدرٌ منه وارتاعَ موكِبُ",39,"ب",1,0],["قد أشبهت أنملة","في فم بنت تلعب",40,"ب",1,0],["قد اشعلت أرجاؤه وتذهبت","وجناته فكأن علاه وجيب",41,"ب",1,0],["قد اشتغلت بنسج الشعر من صغري","حتى اكتهلت وما في غيره أربي",42,"ب",2,0],["قد اشرق الدين القويم بصيرتي","فغدوت بين الناس نور بصائر",43,"ر",1,0],["قد أشرقت في سما الإرشاد ناشرة","أعلام نصح لتحمينا من الخطل",44,"ل",1,0],["قد اشمخرت هامات همة مرغبي","فلا أكتفي إلا بمغنى المسارح",45,"ح",1,0],["قد اشبهت فيهم نصوص وإنهم","هم المذهب الأصفى ومن منه صعد",46,"د",1,0],["قد اشترينا مِنهُ لحمانيَّا","بشرطِ أَنْ يفهمنا المعنيَّ