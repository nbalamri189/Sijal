{"poems":[[46,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106911","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[3290,"","https://poetry.dctabudhabi.ae/diwan/poem/100714","الطويل"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145745","السريع"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108388",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""]],"verses":[["فَفَصَمتَ عُروَةَ جَمعِهِم فيهِ وَقَد","جَعَلَت تَفَصَّمُ عَن عُراها الهامُ",0,"م",1,0],["فَفُصِّلَ باسمِكَ فصلُ الخطابِ","كَمَا قَدْ حباكَ العزيزُ الحكيمُ",1,"م",1,0],["ففصلتُ عن قلبي هوا","كِ ثقيلَه وخفيفه",2,"ه",1,0],["ففصلُها الأوَّلُ خمسونَ عَدَد","وفوقَها خمسةُ أبياتٍ مَدَد",3,"د",1,0],["ففصّلها تفصيلَها فأتى بها","فجاءت كأمثال النجوم التي تهدي",4,"د",2,0],["ففصُّك المعلولُ في اللّعن لي","يحرّم القمرَ بلا بُدّ",5,"د",1,0],["ففصلتها ثوباً وغصناً قطعتها","لتشبيهها في الحسن مع هيف القد",6,"د",1,0],["ففصل تفز واستفت إن كنت جاهلاً","ودع عنك إطلاقاً بلا موجب حصل",7,"ل",1,0],["ففصاحةُ العشاقِ في الصمتِ الذي","يَصِفُ الهوى معَ دمعةٍ حَمراءِ",8,"ا",2,0],["ففصل البرد جمّدنا فصرنا","كجذع النخلِ لكن لا مجيب",9,"ب",1,0]]}