937","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108348",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108325",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108407",""],[3654,"","https://poetry.dctabudhabi.ae/diwan/poem/27105","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91293","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133258","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69979","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77141","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119637","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94560","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94545","الطويل"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/143550","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33079","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33544","السريع"],[3591,"أنيخوا مطاياكم غداة نودع","https://www.poetsgate.com/ViewPoem.aspx?id=149422",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5194,"عفة الزين","https://www.poetsgate.com/ViewPoem.aspx?id=32718",""],[5246,"نزلت غريبا أرض مصر لحاجة","https://www.poetsgate.com/ViewPoem.aspx?id=187025",""],[5302,"أودت بقلبي المتاعب","https://www.poetsgate.com/ViewPoem.aspx?id=204914",""],[5311,"لقد عثرَ القبطيُّ أو زَلَّ زلةً","https://www.poetsgate.com/ViewPoem.aspx?id=82841",""],[5344,"كن الشُغل متواصل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180838",""],[5582,"بِنَفْسِي هَوَىً بِالظَّاعِنِينَ كَوانِسا","https://www.poetsgate.com/ViewPoem.aspx?id=187157",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[5736,"من ذاوٍ لذابل","https://www.poetsgate.com/ViewPoem.aspx?id=208216",""],[5916,"سَلُوْ بَلْقَيْسَ","https://www.poetsgate.com/ViewPoem.aspx?id=190525",""],[5986,"أقدم سيدي منك اعتذارا","https://www.poetsgate.com/ViewPoem.aspx?id=162954",""],[463,"إذا رفعتْ من شرافَ الخدورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60064&r=&rc=120",""]],"verses":[["لَهُ حَفيفُ رُعادٍ","يُراعُ مِنهُ السِربُ",0,"ب",1,0],["لَهُ حاجَةٌ بالغَورِ وَالدَّارُ بِالحِمى","وَنَجدٌ هَواهُ وَهيَ تَعرِفُ ما أَعني",1,"ن",2,0],["لَهُ حاجِبٌ كَالنونِ فَوقَ جُفونِهِ","وَثَغرٌ كَزَهرِ الأُقحُوانِ مُفَلَّجُ",2,"ج",1,0],["لَهُ حَسَبٌ في الحَيِّ وارٍ زِنادُهُ","عَفارٌ وَمَرخٌ حَثَّهُ الوَريُ عاجِلُ",3,"ل",1,0],["لَهُ حاجِبٌ دونَهُ حاجِبٌ","وَحاجِبُ حاجِبِهِ مُحتَجِب",4,"ب",1,0],["لَهُ حَوضُ النَبِيِّ وَساقِياهُ","وَمَن وَرِثَ النُبُوَّةَ وَالكِتابا",5,"ب",2,0],["له حين يعلو قَوْنَسَ القِرن هَبَّةٌ","تُواصلُ ما بين الذؤابة والعَجْبِ",6,"ب",1,0],["له حُبُكٌ إذا اطَّردتْ عليه","قرأت بها سُطوراً في كتابِ",7,"ب",1,0],["له حلمٌ يَذُبُّ الجهلَ عنهُ","كذبِّ النحل عن عَسلِ اللِّصابِ",7,"ب",1,0],["له حاجة قد حال دون لقائها","عوائقُ موصولٍ من المَطْل مبرَز",8,"ز",1,0],["له حريمٌ إذا ما الجارُ حلَّ به","أضحى الزمانُ عليه جدَّ مؤتمنِ",9,"ن",1,0],["لَهُ حُرَّتانِ تَعرِفُ العِتقَ فيهِما","كَسامِعَتي مَذعورَةٍ وَسطَ رَبربِ",10,"ب",1,0],["له حِفاظ ورأى في مواصلتي","وأنت بالهجر يا غدّار تولعه",11,"ع",2,0],["له حَبَبٌ من بَيْضه وحَبيكُهُ","سوابغُه والمرهَفاتُ القراظيبُ",12,"ب",1,0],["لَهُ حَسَبٌ سَما في بَيتِ مَجدٍ","قَليلِ المِثلِ مَفقودِ الضَريبِ",13,"ب",1,0],["لَهُ حَرَكاتٌ موجِباتٌ بِأَنَّهُ","سَيَعلو عُلُوَّ البَدرِ بَينَ الفَراقِدِ",14,"د",1,0],["لَهُ حَسَبٌ في الأَفدَمينَ مُقَدَّمٌ","وَنابِهُ فَخرٍ في الفَخارِ عَتيقِ",15,"ق",1,0],["لَهُ حَسَبٌ لَو كانَ لِلشَمسِ لَم تُنِر","وَلِلماءِ لَم يَعذُب وَلِلنَجمِ لَم يَعلُ",16,"ل",1,0],["لَهُ حينَ أَلقى بِالمَقاليدِ وَالعُرى","أَتَتكَ مَعَ الأَيّامِ ذاتِ الشَقاشِقِ",17,"ق",1,0],["له حسام يرتجى","إنعامه من نقمه",18,"م",2,0],["لهُ حُسامٌ مُطلَقٌ حَدَّه","يَدْمى وطَوْراً ليسَ بالمُطلَقِ",19,"ق",1,0],["لَهُ حِلمُ كَهلٍ في صَرامَةِ حازِمٍ","وَفي العَينِ إِن أَبصَرَت أَبصَرَت ساهيا",20,"ي",2,0],["له حملةٌ عن فتكَتَينِ انفراجُها","كفتكِك من وجهين شاهَ الملَاعِبِ",21,"ب",1,0],["لَهُ حَظُّهُ الأَوفى إِذا كانَ غائِباً","وَإِن جاءَ يَبغي نَيلَنا لَم يُؤَنَّبِ",22,"ب",1,0],["له حُلَلُ الإكرامِ خُصَّ بفضلها","نَسائجَ بالتِّبْرِ المُلمَّعِ تَلمَع",23,"ع",1,0],["لَهُ حِرابٌ فَوقَ قُفّازِهِ","يَجمَعنَ تَأنيفاً وَتَسنينا",24,"ن",2,0],["لَهُ حينَ يَنأى مُذكِرٌ مِن سَماحَةٍ","يَعودُ بِهِ طَلقاً وَلا يَتَلَجلَجُ",25,"ج",1,0],["لَهُ حُكمُ لُقمانٍ وَجَزمُ مُوَفَّقٍ","وَلِلمَوتِ مِنهُ مَخرَجٌ حينَ يَغضَبُ",26,"ب",1,0],["لَهُ حَسَبٌ فوقَ كُلِّ الأَنا","مِ مِنْ هاشمٍ ذلِكَ المُرْتَجَى",27,"ا",1,0],["لَهُ حِلمُ أَحنَفَ وَهوَ اِبنُ تِسع","وَمِقوَلُ قُسٍّ إِذا لَظلَظا",28,"ظ",2,0],["له حُلم لقمانَ الحكيم فإن طغا","سفيهٌ فخلفُ الحلم صولةُ شيرِ",29,"ر",1,0],["له حَبُّ القلوبِ فليس يطوَى","وماءُ المقلتين فليس يصدى",30,"د",2,0],["له حججٌ يسميها كلاماً","وما هي غيرُ أسيافٍ تُسَلّ",31,"ل",1,0],["له حلَلٌ تحاكي الطيْف لونًا","بأزرار من الذهب اللباب",32,"ب",1,0],["له حين انتهاض الركب نوح","كما قد ناح ينتدب الحمام",33,"م",1,0],["له حكم بالفاظ رقاق","بها بحر عجائبه تموج",34,"ج",1,0],["له حلبةُ الخيلِ العتاقِ كأنّها","نشاوى تهادت تطلبُ العَزفَ والقَصفا",35,"ف",2,1],["لَهُ حَدَبٌ يَستَخرِجُ الذِئبَ كارِهاً","يُمِرُّ غُثاءً تَحتَ غارٍ مُطَلَّقِ",36,"ق",1,0],["له حدود بلطف الشكل قد نظمت","وما له في صفات الحسن تحديدُ",37,"د",1,0],["لَهُ حَرَمٌ هِنالِكَ لَم يُحَرَّم","بِهِ إِلّا السَلامَةُ وَالهُجودُ",38,"د",1,0],["لَهُ حِكَمٌ مَأثورَةٌ حينَ تَلتَقي","بِآرائِها عِندَ المُلوكِ المَجامِعُ",39,"ع",1,0],["له حركات تنثر الشكل بينها","إشارات لطفٍ واتِّقاد ذكاءِ",40,"ا",2,0],["له حجج علمية في خفيها","طَلائع نور السنة المتوقد",41,"د",1,0],["لَهُ حَنينٌ إِذا ما جاشَ مُبتَرِكاً","كَما تَحِنُّ إِلى أَطفالِها الإِبِلُ",42,"ل",1,0],["لَهُ حَسبٌ يَضِنُّ بِهِ لِيَبقى","وَلَيسَ لِما يَضِنُّ بِهِ بَقاءُ",43,"ا",2,0],["لَهُ حملات في المَكارِم مقدماً","إِلى جودِهِ والمَكرُماتِ طرادُ",44,"د",1,0],["له حيث حلّ الأكرمون من العلى","مقامٌ كريمٌ في العُلى ومقاعد",45,"د",1,0],["لَهُ حَرَمُ الإِتْهامِ والغَوْرُ غَوْرُهُ","ومَنْهَجُ سُبلِ الحَجِّ والنَّجدُ نَجدُهُ",46,"د",2,0],["له حنين إلى أوطانه ولها","وديدنن في هواها لم يزل ودد",47,"د",1,0],["له حسَبٌ في العلا أكمهٌ","أَضلّتْ محجَّتُه المهتدينا",48,"ن",2,0],["له حين يبطُشُ باعٌ أشل","لُ من دونكم وجَناحٌ كسيرُ",49,"ر",1,0],["له حليةُ الشَّهم الزميعِ مع العدى","وفي الله كاسٍ ثوبَ خَشْيان خاشع",50,"ع",1,0],["له حملت سراً قديماً قلوبنا","فحاشاه يبلى يوم السرائر",51,"ر",1,0],["لَهُ حاجَة قَد طالَما اِسرَّه","مِن الناسِ في صَدرِ بِها يَتَصَدَّع",52,"ع",1,0],["له حكمُهُ منّي ومن دون عَطفه","عليَّ غزيرُ اللُّجَّتين عميقُ",53,"ق",1,0],["لهُ حِليةٌ من كلِّ فضلٍ تزينُهُ","وليسَ بهِ مِن ريبةٍ فتَشينهُ",54,"ن",2,0],["له حركات حركت كل ساكن","فيستخرج المخزون من كل خازن",55,"ن",1,0],["له حزم مغوار وعزمة ملبد","تفلّ المواضي دأبها القدّ والقط",56,"ط",1,0],["لهُ حاجِبٌ كالقَوسِ وَالأَنفُ مُرهَفٌ","وَثَغرٌ حَكَى الصَّهباءَ ما زِلتُ أَرعاهُ",57,"ا",2,0],["له حسب سامي المحل إلى السما","فمن دونه يبدو السهى والفراقدُ",58,"د",1,0],["له حَبيبٌ إذا نا","ل ما يريد تجنّى",59,"ن",2,0],["له حنينٌ وشهيقٌ وبكا","يبلّ من أدمعه ترب الثرى",60,"ر",2,0],["لَهُ حَسَبٌ فيهِ المَفاخِرُ نُضِّدت","فَجالَ لِسانُ الشُّكرِ بِالحمدِ وَالثّنا",61,"ا",1,0],["لهُ حَديثٌ غَريبُ النّظْمِ سَلسَلهُ","بكلِّ معنىً لَطيفٍ حَيَّرَ العَقلا",62,"ل",2,0],["له حسام يقول الحق منصلت","في زمرة الجهل فتاك وبتار",63,"ر",1,0],["له حزم يسود به وعزم","طرير مثل ما شحذت نصالُ",64,"ل",1,0],["لَهُ حكمٌ يوافق ما","بهِ قَد جاءَ جبريلُ",65,"ل",1,0],["له حَاجِبٌ دَونَه حَاجِبٌ","وحَاجِبُ حَاجِبُ حَاجِبِه مُحتَجِب",66,"ب",1,0],["له حنينٌ ناهى نحو مشرقها","ولهفةٌ وانشغافٌ فايقٌ عجبُ",67,"ب",1,0],["له حسن التجاوز والعطايا","له حسن المواهب قد أحيلا",68,"ل",2,0],["له حسن عطف بالضعيف وانني","على غاية الضعف وظني به سما",69,"م",2,0],["له حسن الخلال وخير خلق","له جاه به محو الذنوب",70,"ب",1,0],["له حسن الشهود له خشوع الذين","حظوا بمعرفة الجلال",71,"ل",1,0],["له حسن اقتداء بالنبي الحبيب","المصطفى حسن الخصال",71,"ل",1,0],["له حسن خلق دونه نسمه الصبا","سحيرا ووجه دونه نضرة الفجر",72,"ر",1,0],["له حسن سير لا يباهى له الهدى","ومنهجه التقوى وأحسن سنة",73,"ه",1,0],["له حَرم له حُرم به فالرجا","وصلى به قبل الحمام",74,"م",1,0],["له حسن بشر متع اللَه جمعنا","به وبه أولا النوال الذي حلا",75,"ل",2,0],["له حسن فضل من بني المنن لم يضع","وافضل ذكر قد تضوع اذكاه",76,"ا",2,0],["له حسبٌ بالجود والبأس طارفٌ","ومجد عن الصّيد الأعزّة تالدُ",77,"د",1,0],["له حُسنُ صَبرٍ بالملمات ناهِض","وعود على عَض الخُطوبِ صليبُ",78,"ب",1,0],["له حبَّبتْ كسبَ الثناء سجيَّةٌ","بها وهو طفلٌ نفسه شغفت حبَّا",79,"ب",2,0],["له حَلف الدهرُ أن لا يجيء","بمثل وقد برَّ فيما حلف",80,"ف",1,0],["له حصلت من بعد هذا شهادة","بها نال في الفردوس طيب التنعّم",81,"م",1,0],["له حادثات الروح تعنو جملةً","اصلاً غدى في الغالبات واكملا",82,"ل",2,0],["لَهُ حَادِثَاتُ الرُّوحِ تَعنُو جملَةً","كُنهَ الحَياةِ غَدا وَجَلَّ رَجَاكُمُ",83,"م",1,0],["لَهُ حَادِثَاتُ الرُّوحِ تَعنُو جُملَةً","كُنهَ الحَيَاةِ غَدَى وَجَلَّ رَجَاكُم",84,"م",1,0],["له حلم كشامخة الرواسي","وطبع مثل معتل الجنوب",85,"ب",1,0],["له حقٌ وليس عليه حقٌ","ومهما قال فالحسن الجميل",86,"ل",1,1],["لَهُ حَلَقاتٌ فيهِ سَمرٌ يُحِبُّها ال","عُناةُ كَما حَبَّ الظِماءُ الخَوامِسُ",87,"س",1,0],["له حسن أخلاق وفضل وسؤدد","ظريف شريف بالفضائل والفخر",88,"ر",1,0],["له حكم داود وصورة يوسف","إلى فهم عثمان وخلق أبي بكر",88,"ر",1,0],["لَهُ حَنِينٌ وَزَفرَاتٌ لِمَوطِئِهِم","عَسَاهُمُو يَرقُبُوا ذَا حالَةٍ نَكِرِ",89,"ر",1,0],["له حلم يسمو حلوم البرايا","فتراها لديه أسرى قياما",90,"م",2,0],["له حاجب كالنون خط ابن مقلة","يزينها كالخال في خده نقط",91,"ط",1,0],["له حرمات في شهور تعينت","فواحدهم فردٌ وباقيهمُ سرد",92,"د",1,0],["له حافظٌ من ربه أينما سرى","يقيه وعنه كل ما سأيبعد",93,"د",1,0],["له حضرة جابت به حلل السنا","فطابت به اكنافُها ورحابُها",94,"ب",3,0],["له حنيني ومنه لوعتي وإلى","مغناه شوقي وأعلاق الهوى فيه",95,"ي",2,0],["له حرمٌ قد شرّف الله قدرَه","فلا جيه لا يخشى عُداةَ وحُسّدا",96,"د",2,0],["له حسن فاخر ريقه قد مزج بالعقار","قد زان بلور خدّه زهر ورده",97,"ه",1,0],["لَهُ حُسنُ خَلقٍ في العُيونِ إِذا بَدا","عَلى أَنَّهُ تُردي النفوسَ غَوائِلُه",98,"ل",2,1],["لَهُ حَظُّ أُنثى وَهوَ حَظٌ مُذَكَّرٌ","قَليلٌ لِعَيني أَن تُطيلَ اِنسِجامَ