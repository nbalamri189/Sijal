{"poems":[[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[63,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[35,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[54,"لنقل الرمال وقطع الجبال","https://www.aldiwan.net/poem27413.html","المتقارب"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"تمليت في النيروز عيش المنورز","https://www.aldiwan.net/poem64540.html","الطويل"],[51,"ما أشبه العرف والإحسان بالحسنِ","https://www.aldiwan.net/poem66441.html","البسيط"],[16,"ذهبت من الهجران في غير مذهب","https://www.aldiwan.net/poem27693.html","الطويل"],[85,"يا ناعس الطرف نومي كيف تمنعه","https://www.aldiwan.net/poem7355.html","البسيط"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"أمردود لنا زمن الكثيب","https://www.aldiwan.net/poem11044.html","الوافر"],[45,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[45,"أفق إن ظلم الدهر غير مفيق","https://www.aldiwan.net/poem65189.html","الطويل"],[45,"مدحت أبا العباس للحين ضلة","https://www.aldiwan.net/poem65551.html","الطويل"],[28,"دعاهم مزوني فجاؤوا كأنهم","https://www.aldiwan.net/poem5352.html","الطويل"],[61,"وآمن من ندمه","https://www.aldiwan.net/poem51325.html","مجزوء الرجز"],[61,"لله حسان فتى معرقا","https://www.aldiwan.net/poem51514.html","السريع"],[58,"ومحترس من نفسه خوف ذلة","https://www.aldiwan.net/poem30789.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[33,"أيا ويح من أمسى يخلس عقله","https://www.aldiwan.net/poem25988.html","الطويل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[48,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[50,"أعاتك بعض الود مر ممزج","https://www.aldiwan.net/poem63986.html","الطويل"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67357","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[115,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[115,"حثثنا الركب اقلقه الضجيج","https://www.aldiwan.net/poem41189.html","عموديه"],[119,"له حلبة الخيل العتاق كأنها","https://www.aldiwan.net/poem4343.html","الطويل"],[127,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[135,"هذا مكان به الإقبال معهود","https://www.aldiwan.net/poem48908.html","البسيط"],[143,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[169,"غرام أثارته الحمام السواجع","https://www.aldiwan.net/poem1638.html",""],[204,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[271,"سلام حواشيه كدر منضد","https://www.aldiwan.net/poem52051.html","الطويل"],[322,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[326,"بعيسا باذ حر من قريش","https://www.aldiwan.net/poem44293.html","الوافر"],[406,"ألمت بنا بعد الهدو سعاد","https://www.aldiwan.net/poem50185.html","الطويل"],[416,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[439,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[441,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[458,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[458,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[461,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[500,"قرأنا معاني السر فالحكم ظلهر","https://www.aldiwan.net/poem37685.html","الطويل"],[516,"فيا لك من ليل تمتعت طوله","https://www.aldiwan.net/poem48663.html","الطويل"],[551,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[562,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"]],"verses":[["لَهُ حَفيفُ رُعادٍ","يُراعُ مِنهُ السِربُ",0,"ب",1,0],["لَهُ حاجَةٌ بالغَورِ وَالدَّارُ بِالحِمى","وَنَجدٌ هَواهُ وَهيَ تَعرِفُ ما أَعني",1,"ن",2,0],["لَهُ حاجِبٌ كَالنونِ فَوقَ جُفونِهِ","وَثَغرٌ كَزَهرِ الأُقحُوانِ مُفَلَّجُ",2,"ج",1,0],["لَهُ حَسَبٌ في الحَيِّ وارٍ زِنادُهُ","عَفارٌ وَمَرخٌ حَثَّهُ الوَريُ عاجِلُ",3,"ل",1,0],["لَهُ حاجِبٌ دونَهُ حاجِبٌ","وَحاجِبُ حاجِبِهِ مُحتَجِب",4,"ب",1,0],["لَهُ حَوضُ النَبِيِّ وَساقِياهُ","وَمَن وَرِثَ النُبُوَّةَ وَالكِتابا",5,"ب",2,0],["له حين يعلو قَوْنَسَ القِرن هَبَّةٌ","تُواصلُ ما بين الذؤابة والعَجْبِ",6,"ب",1,0],["له حُبُكٌ إذا اطَّردتْ عليه","قرأت بها سُطوراً في كتابِ",7,"ب",1,0],["له حلمٌ يَذُبُّ الجهلَ عنهُ","كذبِّ النحل عن عَسلِ اللِّصابِ",7,"ب",1,0],["له حاجة قد حال دون لقائها","عوائقُ موصولٍ من المَطْل مبرَز",8,"ز",1,0],["له حريمٌ إذا ما الجارُ حلَّ به","أضحى الزمانُ عليه جدَّ مؤتمنِ",9,"ن",1,0],["لَهُ حُرَّتانِ تَعرِفُ العِتقَ فيهِما","كَسامِعَتي مَذعورَةٍ وَسطَ رَبربِ",10,"ب",1,0],["له حِفاظ ورأى في مواصلتي","وأنت بالهجر يا غدّار تولعه",11,"ع",2,0],["له حَبَبٌ من بَيْضه وحَبيكُهُ","سوابغُه والمرهَفاتُ القراظيبُ",12,"ب",1,0],["لَهُ حَسَبٌ سَما في بَيتِ مَجدٍ","قَليلِ المِثلِ مَفقودِ الضَريبِ",13,"ب",1,0],["لَهُ حَرَكاتٌ موجِباتٌ بِأَنَّهُ","سَيَعلو عُلُوَّ البَدرِ بَينَ الفَراقِدِ",14,"د",1,0],["لَهُ حَسَبٌ في الأَفدَمينَ مُقَدَّمٌ","وَنابِهُ فَخرٍ في الفَخارِ عَتيقِ",15,"ق",1,0],["لَهُ حَسَبٌ لَو كانَ لِلشَمسِ لَم تُنِر","وَلِلماءِ لَم يَعذُب وَلِلنَجمِ لَم يَعلُ",16,"ل",1,0],["لَهُ حينَ أَلقى بِالمَقاليدِ وَالعُرى","أَتَتكَ مَعَ الأَيّامِ ذاتِ الشَقاشِقِ",17,"ق",1,0],["له حسام يرتجى","إنعامه من نقمه",18,"م",2,0],["لهُ حُسامٌ مُطلَقٌ حَدَّه","يَدْمى وطَوْراً ليسَ بالمُطلَقِ",19,"ق",1,0],["لَهُ حِلمُ كَهلٍ في صَرامَةِ حازِمٍ","وَفي العَينِ إِن أَبصَرَت أَبصَرَت ساهيا",20,"ي",2,0],["له حملةٌ عن فتكَتَينِ انفراجُها","كفتكِك من وجهين شاهَ الملَاعِبِ",21,"ب",1,0],["لَهُ حَظُّهُ الأَوفى إِذا كانَ غائِباً","وَإِن جاءَ يَبغي نَيلَنا لَم يُؤَنَّبِ",22,"ب",1,0],["له حُلَلُ الإكرامِ خُصَّ بفضلها","نَسائجَ بالتِّبْرِ المُلمَّعِ تَلمَع",23,"ع",1,0],["لَهُ حِرابٌ فَوقَ قُفّازِهِ","يَجمَعنَ تَأنيفاً وَتَسنينا",24,"ن",2,0],["لَهُ حينَ يَنأى مُذكِرٌ مِن سَماحَةٍ","يَعودُ بِهِ طَلقاً وَلا يَتَلَجلَجُ",25,"ج",1,0],["لَهُ حُكمُ لُقمانٍ وَجَزمُ مُوَفَّقٍ","وَلِلمَوتِ مِنهُ مَخرَجٌ حينَ يَغضَبُ",26,"ب",1,0],["لَهُ حَسَبٌ فوقَ كُلِّ الأَنا","مِ مِنْ هاشمٍ ذلِكَ المُرْتَجَى",27,"ا",1,0],["لَهُ حِلمُ أَحنَفَ وَهوَ اِبنُ تِسع","وَمِقوَلُ قُسٍّ إِذا لَظلَظا",28,"ظ",2,0],["له حُلم لقمانَ الحكيم فإن طغا","سفيهٌ فخلفُ الحلم صولةُ شيرِ",29,"ر",1,0],["له حَبُّ القلوبِ فليس يطوَى","وماءُ المقلتين فليس يصدى",30,"د",2,0],["له حججٌ يسميها كلاماً","وما هي غيرُ أسيافٍ تُسَلّ",31,"ل",1,0],["له حلَلٌ تحاكي الطيْف لونًا","بأزرار من الذهب اللباب",32,"ب",1,0],["له حين انتهاض الركب نوح","كما قد ناح ينتدب الحمام",33,"م",1,0],["له حكم بالفاظ رقاق","بها بحر عجائبه تموج",34,"ج",1,0],["له حلبةُ الخيلِ العتاقِ كأنّها","نشاوى تهادت تطلبُ العَزفَ والقَصفا",35,"ف",2,1],["لَهُ حَدَبٌ يَستَخرِجُ الذِئبَ كارِهاً","يُمِرُّ غُثاءً تَحتَ غارٍ مُطَلَّقِ",36,"ق",1,0],["له حدود بلطف الشكل قد نظمت","وما له في صفات الحسن تحديدُ",37,"د",1,0],["لَهُ حَرَمٌ هِنالِكَ لَم يُحَرَّم","بِهِ إِلّا السَلامَةُ وَالهُجودُ",38,"د",1,0],["لَهُ حِكَمٌ مَأثورَةٌ حينَ تَلتَقي","بِآرائِها عِندَ المُلوكِ المَجامِعُ",39,"ع",1,0],["له حركات تنثر الشكل بينها","إشارات لطفٍ واتِّقاد ذكاءِ",40,"ا",2,0],["له حجج علمية في خفيها","طَلائع نور السنة المتوقد",41,"د",1,0],["لَهُ حَنينٌ إِذا ما جاشَ مُبتَرِكاً","كَما تَحِنُّ إِلى أَطفالِها الإِبِلُ",42,"ل",1,0],["لَهُ حَسبٌ يَضِنُّ بِهِ لِيَبقى","وَلَيسَ لِما يَضِنُّ بِهِ بَقاءُ",43,"ا",2,0],["لَهُ حملات في المَكارِم مقدماً","إِلى جودِهِ والمَكرُماتِ طرادُ",44,"د",1,0],["له حيث حلّ الأكرمون من العلى","مقامٌ كريمٌ في العُلى ومقاعد",45,"د",1,0],["لَهُ حَرَمُ الإِتْهامِ والغَوْرُ غَوْرُهُ","ومَنْهَجُ سُبلِ الحَجِّ والنَّجدُ نَجدُهُ",46,"د",2,0],["له حنين إلى أوطانه ولها","وديدنن في هواها لم يزل ودد",47,"د",1,0],["له حسَبٌ في العلا أكمهٌ","أَضلّتْ محجَّتُه المهتدينا",48,"ن",2,0],["له حين يبطُشُ باعٌ أشل","لُ من دونكم وجَناحٌ كسيرُ",49,"ر",1,0],["له حليةُ الشَّهم الزميعِ مع العدى","وفي الله كاسٍ ثوبَ خَشْيان خاشع",50,"ع",1,0],["له حملت سراً قديماً قلوبنا","فحاشاه يبلى يوم السرائر",51,"ر",1,0],["لَهُ حاجَة قَد طالَما اِسرَّه","مِن الناسِ في صَدرِ بِها يَتَصَدَّع",52,"ع",1,0],["له حكمُهُ منّي ومن دون عَطفه","عليَّ غزيرُ اللُّجَّتين عميقُ",53,"ق",1,0],["لهُ حِليةٌ من كلِّ فضلٍ تزينُهُ","وليسَ بهِ مِن ريبةٍ فتَشينهُ",54,"ن",2,0]]}