{"poems":[[74,"بالغت في شجني وفي تعذيبي","https://www.aldiwan.net/poem18225.html","الكامل"],[47,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[47,"هل أنت مستمع لمن ناداكا","https://www.aldiwan.net/poem65217.html","الكامل"],[35,"إذا نظرت نحوي تكلم طرفها","https://www.aldiwan.net/poem25981.html","الطويل"],[47,"وراءك عني يا عذول الأشايب","https://www.poetsgate.com/ViewPoem.aspx?id=33108",""],[287,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[310,"ما خلت لبي يستفز ويسحر","https://www.aldiwan.net/poem56534.html","الكامل"],[408,"بأبي قوام منك لم","https://www.aldiwan.net/poem46696.html","مجزوء الكامل"],[563,"هما إحاطتان بالأشياء","https://www.aldiwan.net/poem35075.html","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118139","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[1555,"","https://poetry.dctabudhabi.ae/diwan/poem/105604","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101063","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101067","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46471","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[3077,"","https://poetry.dctabudhabi.ae/diwan/poem/113635","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121584","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127234","الكامل"],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[6102,"ميرا","https://www.poetsgate.com/ViewPoem.aspx?id=185071",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""]],"verses":[["ولواحظٌ ترِثُ الملاحةَ في الظبا","إرثَ السماحةِ في بني أيوب",0,"ب",1,0],["وَلَو أَحاطَ عُبَيدُ اللَهِ مَعرِفَةً","بِعُظمِ شَأني اِتَّقى نابي وَأَظفاري",1,"ر",2,0],["وَلَوِ اِحتَضَنتَهُمُ بِأَيدِكَ لَالتَقَت","مِن خَلفِ أَمواجِ الخَليجِ يَداكا",2,"ك",2,0],["وَلَو أَحدَقوا بي الإِنسُ وَالجِنُّ كُلُّهُم","لِكَي يَمنَعوني أَن أَجيكِ لَجيتُ",3,"ت",1,0],["ولوا حرم الله المعظم قدره","وكانوا به حكام تلك الأخاشب",4,"ب",1,0],["وَلَو أَحرَزَت مِن قَبضَةِ المَوتِ هَيبَةٌ","لَكانَ لَهُ مِن بَأسِهِ حِرزُ إِحرازِ",5,"ز",1,0],["وَلو اِحتَسَبت بها عَلينا منّةً","لَكَفت وَلكن رمتَ ما هو أكبرُ",6,"ر",1,0],["ولواحظ قد أُورِثتْ","فتكُ الصَّوارمِ عَنْ كَلالَهْ",7,"ه",1,0],["ولو أحاط ربه علماً به","ولو وجوداً لعيون الرائي",8,"ا",2,0],["ولواحظ نحو القلوب رواشقٍ","ومعاطفٍ هيف القدود رشاق",9,"ق",1,0],["ولو أحسنَ استعدادَها لوفاتها","لهانَ لذكراها عليه حُضورُها",10,"ر",3,0],["ولواحظ أزرى بها","بالسيف وهو مجرد",11,"د",1,0],["ولواحظ تصمي القلوب إذا رمت","ومن اللحاظ مصارع الفرسان",12,"ن",1,0],["ولواحظ تسبي العقو","ل بسحر أجفان تبينه",13,"ن",2,0],["وَلَو أَحكَمت مِنها بَعض فَنٍ","لَما استبدلت مِنها بالحجابة",14,"ب",2,0],["وَلَو اِحتاجَت إِلى بَذلِ المُهى","وَعَزيزٍ لَن تَرى مَن أَحجَما",15,"م",2,0],["ولواحظٍ فتَّاكةٍ","في جفنها هاروت عاكفْ",16,"ف",1,0],["ولواحظ مرضى بها اعتل الصبا","والصب بالسقم المبرّح مكتسى",17,"س",2,0],["ولواحظ مهما رنت","ناديت يا رب السلامه",18,"م",2,0],["ولو أحست به الأقلام لانحطمت","رعباً ولو كان يدري اللفظ لاضطرما",19,"م",2,0],["وَ لَواحِظٌ خَلفَ الرُّمُوشِ ضَياغِمٌ","تَرمِي فَرِيسَتَها إِذا ما تَقنِصُ",20,"ص",1,0],["وَلَو أَحَبَّت بَديعَ الشِّعر لأَتَّخَذَت","حِماهُ مَغنىً وَهامَت باِالمُغَنِّينا",21,"ن",2,0]]}