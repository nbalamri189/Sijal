ps://poetry.dctabudhabi.ae/diwan/poem/54594","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54526","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67291","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142044","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43664","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43701","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[106,"رحلات عزام","https://www.poetsgate.com/ViewPoem.aspx?id=179550",""],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[74,"خُذْها إلَيْكَ، وإنّها لَنَضِيرَة ٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=3297",""],[77,"نعمنا بوصل من حبيب مساعد","https://www.poetsgate.com/ViewPoem.aspx?id=34091",""],[13,"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","https://www.poetsgate.com/ViewPoem.aspx?id=180808",""],[43,"بكيت يا ربع حتى كدت أبكيكا","https://www.poetsgate.com/ViewPoem.aspx?id=219",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"مَنْ قَائلٌ للزّمَانِ ما أرَبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31692",""],[45,"شُغْلانِ مِنْ عَذْلٍ وَمِنْ تَفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31609",""],[51,"ولقد يُؤلفُنا اللقاءُ بليلة","https://www.poetsgate.com/ViewPoem.aspx?id=30372",""],[105,"لعمري لئن خاس الرئيس بعهده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55002&r=&rc=172",""]],"verses":[["نَجُرُّ ما شِئتَ مِن لِسانِ فَتىً","إِن هَدَرَت ساعَةً شَقاشِقُنا",0,"ن",2,0],["نَجَوتَ عَنِ الغُمّاءِ وَهيَ قَريبَةٌ","نَجاءَ الثُرَيّا مِن يَدِ الدَبَرانِ",1,"ن",1,0],["نُجومُهُمُ في العِزِّ غَيرُ غَوارِبٍ","وَأَجدادُهُم في المَجدِ غَيرُ نِيامِ",2,"م",1,0],["نَجَوتُ وَمَن يَنجُ مِن مِثلِها","يَعِش آمِناً بَعدَها مِن زَلَل",3,"ل",1,0],["نَجائِبَ لا يودي بِأَخفافِها السُرى","وَإِن طالَ بِالبيدِ القِواءِ ذَميلُها",4,"ل",3,0],["نُجومٌ مِنَ الإِخوانِ يَرمي بِها الرَدى","مُقارِبُها فَوتُ العُيونِ الرَوامِقِ",5,"ق",1,0],["نَجَوتِ فَكَم مِن عَضَّةٍ في أَنامِلِ","عَلَيكِ وَلَهفٍ مِن قُلوبٍ لَواهِفِ",6,"ف",1,0],["نَجِدُ الضَراعَةَ وَالنَقيصَةَ نَزرَةً","إِنَّ القُلامَةَ شِكَّةٌ لِلأِصبَعِ",7,"ع",1,0],["نَجهَلُ فيهِ مَعَ الأَغاني","وَالجَهلُ في مِثلِهِ وَقارُ",8,"ر",1,0],["نَجَوتِ عَلى ما فيكِ مِن وِنيَةِ السُرى","وَطَيِّ المَوامي سَربَخاً بَعدَ سَربَخِ",9,"خ",1,0],["نُجومٌ إِذا شَهِدوا الأَندِياتِ","رُجومٌ إِذا أَقاموا ما الحُروبا",10,"ب",2,0],["نَجُرُّ إِلى العُداةِ سُلافَ جَيشٍ","كَعَرضِ اللَيلِ يَتَّبِعُ اللِواءَ",11,"ا",2,0],["نَجلاءُ إِن نَظَرَتْ قالَتْ بَنو ثُعَلٍ","عَيناكِ يابْنَةَ ذي البُردَينِ أَرمانا",12,"ن",2,0],["نُجيدُ الطَعنَ بِالسُمرِ العَوالي","وَنَضرِبُ بِالسُيوفِ المَشرَفِيَّه",13,"ي",2,0],["نُجومُ مَعانٍ في سَماءِ صَحيفةٍ","ولكنّها تسْري النّجومُ ولا تسْري",14,"ر",2,0],["نُجاذِبُ أهْدابَ العِتابِ لَطيفَةً","فنَسْقي بعِهْدِ الدّمْعِ ذِكْرى المَعاهِدِ",15,"د",1,0],["نَجَّيتُما مِن مَرَضٍ قاتِلٍ","مَطلَعَ آمالِ بَني الشَرقِ",16,"ق",1,0],["نَجيبٌ كَصَدرِ السَمهَرِيِّ مُنَجَّحَ ال","سَرايا كَريمُ الطَبعِ صافٍ لُبابُهُ",17,"ب",2,0],["نُجومُ هُدىً وَالمَعالي بُروجٌ","وَأُسدُ وَغىً وَالعَوالي أَجَم",18,"م",1,0],["نَجلُ الَّذي نُصحُهُ وَطاعَتُهُ","كَالحَجِّ تَتلوهُ بَرَّةُ العُمَرِ",19,"ر",1,0],["نَجُذُّ رُؤوسَهُم في غَيرِ بِرٍّ","فَما يَدرونَ ماذا يَتَّقونا",20,"ن",2,0],["نُجِدُّ لَكَ القَولَ الحَلِيَّ وَنَمتَطي","إِلَيكَ بَناتِ الصَيعَرِيِّ وَشَدقَمِ",21,"م",1,0],["نَجاءُ الثُرَيّا كَلَّ آَخِرِ لَيلَةٍ","يَجودُهُما جوداً وَيُتبِعُهُ وَبلا",22,"ل",2,0],["نجهله يا لطيف ما تجهلون","لعارف كيف يربي البنون",23,"ن",1,0],["نجعل اللهو للأداء أداة","لطفٍ أو فكل لهو حرام",24,"م",1,0],["نَجْلُ ذَاكَ الَّذِي فَضَائِلُهُ","أَنْزَلَتْهُ فِي أَوْجِ كِيوَانِ",25,"ن",1,0],["نَجَتْ كَرَامَةُ مِصْرٍ مِنْ مَهَانَتِهَا","فِيهَا وَشُرِّفَ ذَاكَ المَنْصِبُ السَّنِمُ",26,"م",1,0],["نَجْعَلُ اللَّهْوَ لِلأَدَاءِ أَدَاةً","لَطُفَتْ أَوْ فَكُلُّ لَهْوٍ حَرَامُ",27,"م",1,0],["نَجائِبُ لَيسَت مِن مُهورِ أَشابَةٍ","وَلا ديَةٍ كانَت وَلا كَسبِ مَأثَمِ",28,"م",1,0],["نَجائِبَ مِن نِتاجِ بَني غَريرٍ","طِوالَ السَمكِ مُفرِعَةً نِبالا",29,"ل",2,0],["نَجاةٌ يُقاسي لَيلَها مِن عُروقِها","إِلى حَيثُ لا يَسمو اِمرُؤٌ مُتَقاصِرُ",30,"ر",1,0],["نَجائِبُ مِن آلِ الجَديلِ وَشارَكَت","عَلَيهِنَّ في أَنسابِهِنَّ العصَافِرُ",30,"ر",1,0],["نَجاةُ مِنَ الشُدقِ اللَواتَي يَزينُها","خُشوعُ الأَعالي وَاِنضِمامُ الحَوالِبِ",31,"ب",1,0],["نجوم أمدتها بدور كواملُ","لها النور من شمس الخلافة شاملُ",32,"ل",1,1],["نجوم وآفاق الطراد مشارق","عليها بدورٌ من وجوهِ كواملُ",32,"ل",1,0],["نَجْواهُمُ مهما سمعت كلامهم","ونداؤهم مولايَ أو مولاكا",33,"ك",2,0],["نجوم اهتداء والمداد يجنُّها","وأسرار غيب واليراعُ تذيعُها",34,"ع",3,0],["نجيّت بالسدّ بغداداً من الغرق","فعمّها الأمن بعد الخوف والفرق",35,"ق",1,1],["نجمان صانهما الإله بلطفه","من أن يُراع سناهما بخفوق",36,"ق",1,0],["نجد الرجال قلوبها شتى الهوى","مدّ الشِقاق بها حِبالة غُوله",37,"ل",2,0],["نُجالس منه ذا خُلُق كريم","له بجليسه أثر عجيب",38,"ب",1,0],["نجيبة أقصري عنّي فإني","كفاني من لظى الندم اللهيب",39,"ب",1,0],["نَجاةٌ يَصِلُّ المَروُ تَحتَ أَظَلِّها","بِلاحِقَةِ الأَظلالِ حامٍ هَجيرُها",40,"ر",3,0],["نَجيبٌ أَريبٌ كانَ جَدُّكَ مُنجِباً","وَأَدَّت إِلَيكَ المُنجِباتُ العَفائِفُ",41,"ف",1,0],["نُجُبٌ مِنَ السِرِّ العَتيقِ نَمى بِها","فَوقَ النَجائِبِ شَدقَمٌ وَجَديلُ",42,"ل",1,0],["نُجُومُ الأُمُورِ اذا أدُلَمِّسَت","بِظَلمَاءَ دَيجُورِها الأَشهَبِ",43,"ب",1,0],["نُجيرُ فَلا يَخشى البَوادِرَ جارُنا","وَلاقى الغِنى في دورِنا فَتَمَوَّلا",44,"ل",2,0],["نَجّى حَكيماً يَومَ بَدرٍ رَكضُهُ","كَنَجاءِ مُهرٍ مِن بَناتِ الأَعوَجِ",45,"ج",1,1],["نُجالِدُ الناسَ لا نُبقي عَلى أَحَدٍ","وَلا نُضَيِّعُ ما توحي بِهِ السُوَرُ",46,"ر",1,0],["نَجَلَت بِهِ بَيضاءُ آنِسَةٌ","مِن عَبدِ شَمسٍ صَلتَهُ الخَدِّ",47,"د",1,0],["نَجَهتُ بَني قَيسٍ فَأَغضى سَفيهُهُم","وَزُهرَةُ لا تَزدادُ إِلّا تَمادِيا",48,"ي",2,1],["نجم الفواطم من كرائمِ هاشمٍ","والمرضعين من الكرامِ سحابا",49,"ب",2,0],["نجوم العلم أنواء العطايا","جياد السبق آساد الكفاح",50,"ح",1,0],["نجل الخلائف نبه عندها عمراً","وافخر بكل عمير البيت جحجاح",51,"ح",1,0],["نجومٌ تراعيها جفون سوافح","ولا طيفكم دانٍ ولا الليل نازح",52,"ح",1,1],["نجمٌ تولد بين الشمسِ والأسدِ","هنئتَ بالوالدِ الأزكى وبالولدِ",53,"د",1,1],["نجومُ حسنٍ أكراد أرضكم","قد مات فيها المحب أو كادا",54,"د",2,1],["نجل الملوك إذا جرُّوا عساكرهم","ألهتهم الطعنة النجلا عن النجل",55,"ل",1,0],["نُجبٌ تلوح إذا بَدَوْا","بوجُوهم غُررُ النجابهْ",56,"ب",2,0],["نجَّاك يا ابن الحاجِبِ الحاجبُ","وأين ينجو منّيَ الهاربُ",57,"ب",1,1],["نجا يونسُ في اللجَّ","ة من حاوية الحوتِ",58,"ت",1,1],["نَجَعَتْ في علاجه","حُقَنُ المُرْدِ فانْتَفَجْ",59,"ج",1,0],["نَجَلَتْهُ بيضاءُ من مَلِكَاتِ ال","روم تُدْعَى لقيْصَرٍ معْبُودِ",60,"د",1,0],["نجدةٌ لم تكن لَعْنترةَ العب","سِيِّ في عصره ولا شَدَّادِهْ",61,"د",2,0],["نجوت كمَنْجَاهُ كما اسمُك كاسمِه","فأنت نَقيذُ الله وهو نقيذُهُ",62,"ذ",2,0],["نُجِّدَتْ من خير نجدٍ","ملكتْ أيدي التِّجار",63,"ر",1,0],["نَجْرٌ لعمري با