{"poems":[[53,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[30,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[30,"ما نحن إن جارت صدور ركابنا","https://www.poetsgate.com/ViewPoem.aspx?id=20013",""],[136,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[164,"يشاركك المغتاب في حسناته","https://www.aldiwan.net/poem59137.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[416,"نفحت مكافئا عن قبر معن","https://www.aldiwan.net/poem67483.html","الطويل"],[454,"هو الدين","https://www.aldiwan.net/poem977.html",""],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18501","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118421","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131285",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3591,"من دولة الحسن أم من دولة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=149490",""],[5136,"بروحي طيفاً أتى في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=121707",""]],"verses":[["فكافأتني بازورار يفو","ق كل ازورار وكل انحراف",0,"ف",1,0],["فكافأتموني بالذي هو أهْلُه","من المنع والحرمان والرفضِ والخذلِ",1,"ل",1,0],["فَكافَرَني إِن لَم أُغِثهُ وَلَو تَرى","مُناخي بِهِ المِعزى غَداةَ النَعائِمِ",2,"م",1,0],["فَكافَرَني إنْ لمْ أُغِثْهُ، وعلَوْ تَرَى","مُناخي بهِ المِعزَى غَداةَ النّعائِمِ",3,"م",1,0],["فَكَافِحُوهُم بِمَا أبدَى الإلَهُ لَكُم","وَبَيِّنُوا في الهدى الوَجهَ الذي قَصَدُوا",4,"د",3,0],["فكافيه بالحسني وقل رب جازه","بخير وكفر عنه من سيئاته",5,"ت",2,0],["فَكافاهُ عن إِيمانهِ بأمانهِ","وَجازاهُ عَن فعلِ السجودِ له زجرا",6,"ر",2,0],["فَكافَأَ عَن صَدى مَعنٍ جَوادٌ","بِأَجوَدِ راحَةِ بَذَلت نَوالا",7,"ل",2,0],["فكافأك المولى على ما صنعته","بخير وإحسان أعم وأشملا",8,"ل",2,0],["فَكافَحَنا الحَجّاجُ دونَ صُفوفِنا","كِفاحاً وَلَم يَضرِب لِذَلِكَ مَوعِدا",9,"د",2,0],["فكافوه بأن قتلوا رعاه","وشلوهن شلّاً مسرعينا",10,"ن",2,0],["فك افدت صديقا أو أبدت عدا","وكم فديت رقيقا أو هديت غوي",11,"و",2,0],["فكافأتنا عمداً بنقضك عهدنا","وكان يسيراً ان تصد بلا عمد",12,"د",1,0],["فكافحوا عداهم كفاحاً","لسور إليونهم اكتساحا",13,"ح",2,0],["فكافئيني على الصبر الجميل ولا","تجزي على الجهد في المنظوم والنّصب",14,"ب",1,0],["فكافأه الله إحسانه","المواصل للخلق خاص وعام",15,"م",1,0]]}