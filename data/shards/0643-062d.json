tps://www.aldiwan.net/poem7695.html","الطويل"],[85,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[62,"سارية ذات عبوس برقها","https://www.aldiwan.net/poem52299.html","الرجز"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[61,"ليالينا بأحياء الغميم","https://www.aldiwan.net/poem51454.html","الوافر"],[61,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[58,"فلا تصحب أخا الجهل","https://www.aldiwan.net/poem30813.html","الهزج"],[66,"أرى فحش الكلام يروع قلبي","https://www.aldiwan.net/poem38582.html","الوافر"],[66,"عبث النسيم بقده فتأودا","https://www.aldiwan.net/poem39659.html","الكامل"],[80,"وكأنها نون تمط وعينها","https://www.aldiwan.net/poem31236.html","الكامل"],[80,"مصفرة الجسم وهي ناحلة","https://www.aldiwan.net/poem31240.html","المنسرح"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"وجدول جامد في الكف تحمله","https://www.aldiwan.net/poem31450.html","البسيط"],[80,"شوقي إليك مجدد","https://www.aldiwan.net/poem31468.html","مجزوء الكامل"],[44,"دع ابن الأعمش المسكين يبكي","https://www.aldiwan.net/poem30016.html","الوافر"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[46,"النفس عند فراقها جثمانها","https://www.aldiwan.net/poem22700.html","الكامل"],[46,"عجبت لملبوس الحرير وإنما","https://www.aldiwan.net/poem23128.html","الطويل"],[46,"العالم العالي برأي معاشر","https://www.aldiwan.net/poem23316.html","الكامل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39608","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39626","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[96,"راقصة الحانة","https://www.poetsgate.com/ViewPoem.aspx?id=17511",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[71,"ما سرُّ سكانِ الحِمى بِمُذاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28019&r=&rc=6",""],[4,"كُبَيْشَة ُ حَلَّتْ بَعْدَ عَهْدِكَ عاقلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10934&r=&rc=29",""]],"verses":[["كَحافِلَةِ المُزنِ آنَستُها","مُسَمَّحَةً في قِيادِ النُعامى",0,"م",2,0],["كَحُمَيّا الطَودِ رَأياً وَحِجاً","وَرِماحُ الخَطِّ غَرباً وَقِياما",1,"م",2,0],["كَحَمحَمَةِ الأَداهِمِ أَقبَلوها","لَيالي الوِردِ مائِلَةَ الجِلالِ",2,"ل",1,0],["كَحامِلٍ لِثِيابِ الناسِ يَغسِلُها","وَثَوبُهُ غارِقٌ في الرِجسِ وَالنَجَسِ",3,"س",1,0],["كَحَوصَلَةِ الرَألِ في دَنِّها","إِذا صُوِّبَت بَعدَ إِقعادِها",4,"د",3,0],["كَحَلفَةٍ مِن أَبي رِياحٍ","يَسمَعُها لاهُهُ الكُبارُ",5,"ر",1,0],["كَحَيَّةِ سَلعٍ مِنَ القاتِلاتِ","تَقُدُّ الصَرامَةُ عَنكَ القَميصا",6,"ص",2,0],["كَحافِظِ اِبراهيمَ لَكِنَّهُ","أَجمَلُ خَلقاً مِنهُ في الظاهِرِ",7,"ر",1,1],["كحلُ الشَريفِ مُقارِبٌ","كَم ناظِرٍ قَد أَغمَضا",8,"ض",2,1],["كَحلاءُ ضاقَت عَن إِجالَةِ مرودٍ","وَجِراحُها في القَلبِ جدُّ وِساعِ",9,"ع",1,0],["كَحَقفِ النَقا يَمشي الوَليدانِ فَوقَهُ","بِما اِحتَسَبا مِن لينِ مَسٍّ وَتَسهالِ",10,"ل",1,0],["كَحَواشي الرِداءِ قَد مُحَّ مِنهُ","بَعدَ حُسنٍ عَصائِبُ التَسهيمِ",11,"م",1,0],["كَحَاتِمٍ إِنْ يُقْرِ أَضْيَافَهُ","كَمَعْنَ إِنْ يُعْطِ وَإِنْ يَحْلُمِ",12,"م",1,0],["كُحِلَت بِمَنظَرِكَ العُيونُ عَمايَةً","وَأَصَمَّ نَعيُكَ كُلَّ أُذنٍ تَسمَعُ",13,"ع",1,0],["كَحَلتُ بِها إِنسانَ عَيني فَأَسبَلَت","بِمُعتَسِفِ بَينَ الجُفونِ تُؤامِ",14,"م",1,0],["كَحلاءُ في بَرَجٍ صَفراءُ في نَعَجٍ","كَأَنَّها فِضَّةٌ قَد مَسَّها ذّهَبُ",15,"ب",1,0],["كَحاجَةِ يَومٍ قَبلَ ذَلِكَ مِنهُمُ","عَشِيَّةَ رَدّوا بِالكُلابِ الجَمائِلا",16,"ل",2,0],["كَحَالِئَةٍ عن كُوعِها وهي تَبتَغِي","صَلاحَ أدِيمٍ ضَيَّعَتهُ وتَغمُلُ",17,"ل",1,0],["كحاجبٍ مقترنٍ بالبَها","فحبَّذا الكاتبُ والحاجب",18,"ب",1,0],["كحَّلت بالسهد جفنيها وقد وصلت","مسافة النأي أميالاً بأميال",19,"ل",1,0],["كحّلت جفوني بالسهادِ لبعدهم","فيا حبَّذا للسّهد والبعد أميال",20,"ل",1,0],["كحشو الخشكنان له صفات","فما وصفي دقيقاً أو علامه",21,"م",2,0],["كحليفِ العمى تَغَوَّطَ في الإي","وان جهلاً بأنه الإيوانُ",22,"ن",1,0],["كحيرانَ لا يدري الهدى كيف وجهُه","ضلالاً وما يَلقى إلى الرشدِ هاديا",23,"ي",2,0],["كَحَرّانِ مَنتوفِ الذِراعَينِ صَدَّهُ","عَنِ الماءِ فُرّاطٌ وَوِردٌ مُصَبَّحُ",24,"ح",1,0],["كحافظ أخي النهى","أو كالنواسي ذى الأدب",25,"ب",1,0],["كَحُلَّةٍ دكناءَ في حاشيةٍ","منها طِرازٌ ذهبٌ مسلسلُ",26,"ل",1,0],["كَحَبِيِّ الغَمامِ جادَ فَرَوّى","كُلَّ وادٍ مِنَ البِلادِ وَنيقِ",27,"ق",1,0],["كحَلْي الخَودِ مُؤتَلفِ النَّواحي","ووَشْيِ الرَّوض مُختلِفِ الرُّقُومِ",28,"م",1,0],["كَحْلاءُ حاليةٌ بكَت","حتَّى انثنتْ مَرهاءَ عاطل",29,"ل",1,0],["كَحَذو النَعلِ بِالنَعلِ","إِذا ما النَعلُ حاذاهُ",30,"ه",1,0],["كَحَلقِ البَكرِ يَجرَحُهُ زُلالٌ","وَلا يُدمي مَشافِرَهُ القَتادُ",31,"د",1,0],["كَحَلَ العُيونَ بِضَوءِ نورِ جَبينِهِ","عِندَ السُفورِ فَلا عَدِمتُ الإِثمِدا",32,"د",2,0],["كحلتْ جفونَ الصبح منها بالسرى","وتكحلتْ منه بلوْنِ الإثْمِدِ",33,"د",1,0],["كحيّةٍ باللّسانِ لاحسةٍ","ما أدرَكتْ من سوادِ غيهبها",34,"ب",3,0],["كحجيج مكة في ارْتفاع عجيجهم","وطوافهمْ بالبيتِ ذي الأركانِ",35,"ن",1,0],["كَحَلت عينِيَ إذ كَلَّتْ بِجَوهَره","أَما يُحَدّ بِكُحْلِ الجَوهَرِ البَصرُ",36,"ر",1,0],["كَحَلَ الهوَى والسِّحرُ مِن","ك جفونَ رئمٍ أحورِ",37,"ر",1,0],["كُحِلتُ بِقُبحِ صورَتِهِ فَأَضحى","لَها إِنسانُ عَيني في السِياقِ",38,"ق",1,0],["كَحُلقومِ القَطاةِ أُمِرَّ شَزراً","كَإِمرارِ المُحَدرَجِ ذي الأُسونِ",39,"ن",1,0],["كَحَدَّينِ مِن جَلَمٍ مُعلَمٍ","فَلا تِلكَ كَلَّت وَلا ذا بِها",40,"ب",3,0],["كُحِلَتْ بِتَقْوَى اللهِ مُقْلَتُهُ التي","لَمْ تَكْتَحِلْ أجْفانُها بِمَنَامِ",41,"م",1,0],["كَحمامَةٍ صيدَت فَثَنَّت جيدَها","أَسَفاً لِتَنظُرَ حالَ وَكرٍ دامِرِ",42,"ر",1,0],["كَحِلفَي مُغارٍ كُلَّ يَومٍ وَلَيلَةٍ","عَلى الآلِ أَو في المالِ تَرغو بَوازِلُه",43,"ل",2,0],["كَحَمائِمٍ ظَلَمَت فَنادى أَجدَلٌ","إِن كُنتِ ظالِمَةً فَإِنّي أَظلَمُ",44,"م",1,0],["كُحِلَتْ عَيني عَمىً إنْ غَيْرَها","نَظَرْتْهُ ايهِ عَنّي ذا الرُّشَيْ",45,"ي",1,0],["كحوريَّةِ النبعِ تطوي الرِّشاءَ","وتجذبُ ممتلئاتِ السِّجالْ",46,"ل",1,0],["كحارسةِ الميْتِ ليسَت ترِيمُ","مكاناً به وقفَتْ تضطربْ",47,"ب",1,0],["كحملٍ مدلّل صار الأسدْ","والصارم المسلول عاد كالمسدْ",48,"د",1,0],["كَحُقَّيْ لُجَيْنٍ بِقُفْلَيْ عَقِي","يقٍ وَكَنْزَيْنِ فِي رَصَدٍ مُرْصَدِ",49,"د",1,0],["كَحَمْزةَ لمّا وَفَى صادِقاً","بذي هِبَةٍ صارِمٍ سَلْجَجِ",50,"ج",1,0],["كَحلُوا جَفْنَها فَكَحَّلْتَ فيها","كُلَّ جَفنٍ أَسىً وَسُهْداً طَوِيلاَ",51,"ل",2,0],["كحوريّة النّبع تطوي الرّشاء","وتخذب ممتلئات السّجال",52,"ل",1,0],["كحلتِ له بسحر عينيك مُقلَةً","وأسبلتِ فرعاً فاق مسكاً إذا انْسَبَلْ",53,"ل",1,0],["كحلاءُ ضاقتْ عن إِجالة ِ مرْودٍ","وجراحها في القلبِ جدُّ جراعِ",54,"ع",1,0],["كحاجة ِ يومٍ قبلَ ذلكَ منهمُ","عشية َ ردُّو بالكُلابِ الجمائِلا",55,"ل",2,0]]}