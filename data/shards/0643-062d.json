,"https://www.poetsgate.com/ViewPoem.aspx?id=193071",""],[5939,"كحيل الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=195305",""],[5956,"طقوس الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=182261",""],[5977,"إشراقة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=212732",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6093,"أصابع ريح","https://www.poetsgate.com/ViewPoem.aspx?id=201753",""],[6096,"الحقُّ المسلوب","https://www.poetsgate.com/ViewPoem.aspx?id=177712",""],[6147,"أشْرَاكُ الرُّتَيْلاء.","https://www.poetsgate.com/ViewPoem.aspx?id=151599",""],[6171,"أميرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86321&r=&rc=1",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[5355,"دنيا القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87209&r=&rc=34",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[5490,"سنة حلوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81969&r=&rc=56",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""],[6302,"اشْتِبَاهْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86226&r=&rc=24",""]],"verses":[["كَحافِلَةِ المُزنِ آنَستُها","مُسَمَّحَةً في قِيادِ النُعامى",0,"م",2,0],["كَحُمَيّا الطَودِ رَأياً وَحِجاً","وَرِماحُ الخَطِّ غَرباً وَقِياما",1,"م",2,0],["كَحَمحَمَةِ الأَداهِمِ أَقبَلوها","لَيالي الوِردِ مائِلَةَ الجِلالِ",2,"ل",1,0],["كَحامِلٍ لِثِيابِ الناسِ يَغسِلُها","وَثَوبُهُ غارِقٌ في الرِجسِ وَالنَجَسِ",3,"س",1,0],["كَحَوصَلَةِ الرَألِ في دَنِّها","إِذا صُوِّبَت بَعدَ إِقعادِها",4,"د",3,0],["كَحَلفَةٍ مِن أَبي رِياحٍ","يَسمَعُها لاهُهُ الكُبارُ",5,"ر",1,0],["كَحَيَّةِ سَلعٍ مِنَ القاتِلاتِ","تَقُدُّ الصَرامَةُ عَنكَ القَميصا",6,"ص",2,0],["كَحافِظِ اِبراهيمَ لَكِنَّهُ","أَجمَلُ خَلقاً مِنهُ في الظاهِرِ",7,"ر",1,1],["كحلُ الشَريفِ مُقارِبٌ","كَم ناظِرٍ قَد أَغمَضا",8,"ض",2,1],["كَحلاءُ ضاقَت عَن إِجالَةِ مرودٍ","وَجِراحُها في القَلبِ جدُّ وِساعِ",9,"ع",1,0],["كَحَقفِ النَقا يَمشي الوَليدانِ فَوقَهُ","بِما اِحتَسَبا مِن لينِ مَسٍّ وَتَسهالِ",10,"ل",1,0],["كَحَواشي الرِداءِ قَد مُحَّ مِنهُ","بَعدَ حُسنٍ عَصائِبُ التَسهيمِ",11,"م",1,0],["كَحَاتِمٍ إِنْ يُقْرِ أَضْيَافَهُ","كَمَعْنَ إِنْ يُعْطِ وَإِنْ يَحْلُمِ",12,"م",1,0],["كُحِلَت بِمَنظَرِكَ العُيونُ عَمايَةً","وَأَصَمَّ نَعيُكَ كُلَّ أُذنٍ تَسمَعُ",13,"ع",1,0],["كَحَلتُ بِها إِنسانَ عَيني فَأَسبَلَت","بِمُعتَسِفِ بَينَ الجُفونِ تُؤامِ",14,"م",1,0],["كَحلاءُ في بَرَجٍ صَفراءُ في نَعَجٍ","كَأَنَّها فِضَّةٌ قَد مَسَّها ذّهَبُ",15,"ب",1,0],["كَحاجَةِ يَومٍ قَبلَ ذَلِكَ مِنهُمُ","عَشِيَّةَ رَدّوا بِالكُلابِ الجَمائِلا",16,"ل",2,0],["كَحَالِئَةٍ عن كُوعِها وهي تَبتَغِي","صَلاحَ أدِيمٍ ضَيَّعَتهُ وتَغمُلُ",17,"ل",1,0],["كحاجبٍ مقترنٍ بالبَها","فحبَّذا الكاتبُ والحاجب",18,"ب",1,0],["كحَّلت بالسهد جفنيها وقد وصلت","مسافة النأي أميالاً بأميال",19,"ل",1,0],["كحّلت جفوني بالسهادِ لبعدهم","فيا حبَّذا للسّهد والبعد أميال",20,"ل",1,0],["كحشو الخشكنان له صفات","فما وصفي دقيقاً أو علامه",21,"م",2,0],["كحليفِ العمى تَغَوَّطَ في الإي","وان جهلاً بأنه الإيوانُ",22,"ن",1,0],["كحيرانَ لا يدري الهدى كيف وجهُه","ضلالاً وما يَلقى إلى الرشدِ هاديا",23,"ي",2,0],["كَحَرّانِ مَنتوفِ الذِراعَينِ صَدَّهُ","عَنِ الماءِ فُرّاطٌ وَوِردٌ مُصَبَّحُ",24,"ح",1,0],["كحافظ أخي النهى","أو كالنواسي ذى الأدب",25,"ب",1,0],["كَحُلَّةٍ دكناءَ في حاشيةٍ","منها طِرازٌ ذهبٌ مسلسلُ",26,"ل",1,0],["كَحَبِيِّ الغَمامِ جادَ فَرَوّى","كُلَّ وادٍ مِنَ البِلادِ وَنيقِ",27,"ق",1,0],["كحَلْي الخَودِ مُؤتَلفِ النَّواحي","ووَشْيِ الرَّوض مُختلِفِ الرُّقُومِ",28,"م",1,0],["كَحْلاءُ حاليةٌ بكَت","حتَّى انثنتْ مَرهاءَ عاطل",29,"ل",1,0],["كَحَذو النَعلِ بِالنَعلِ","إِذا ما النَعلُ حاذاهُ",30,"ه",1,0],["كَحَلقِ البَكرِ يَجرَحُهُ زُلالٌ","وَلا يُدمي مَشافِرَهُ القَتادُ",31,"د",1,0],["كَحَلَ العُيونَ بِضَوءِ نورِ جَبينِهِ","عِندَ السُفورِ فَلا عَدِمتُ الإِثمِدا",32,"د",2,0],["كحلتْ جفونَ الصبح منها بالسرى","وتكحلتْ منه بلوْنِ الإثْمِدِ",33,"د",1,0],["كحيّةٍ باللّسانِ لاحسةٍ","ما أدرَكتْ من سوادِ غيهبها",34,"ب",3,0],["كحجيج مكة في ارْتفاع عجيجهم","وطوافهمْ بالبيتِ ذي الأركانِ",35,"ن",1,0],["كَحَلت عينِيَ إذ كَلَّتْ بِجَوهَره","أَما يُحَدّ بِكُحْلِ الجَوهَرِ البَصرُ",36,"ر",1,0],["كَحَلَ الهوَى والسِّحرُ مِن","ك جفونَ رئمٍ أحورِ",37,"ر",1,0],["كُحِلتُ بِقُبحِ صورَتِهِ فَأَضحى","لَها إِنسانُ عَيني في السِياقِ",38,"ق",1,0],["كَحُلقومِ القَطاةِ أُمِرَّ شَزراً","كَإِمرارِ المُحَدرَجِ ذي الأُسونِ",39,"ن",1,0],["كَحَدَّينِ مِن جَلَمٍ مُعلَمٍ","فَلا تِلكَ كَلَّت وَلا ذا بِها",40,"ب",3,0],["كُحِلَتْ بِتَقْوَى اللهِ مُقْلَتُهُ التي","لَمْ تَكْتَحِلْ أجْفانُها بِمَنَامِ",41,"م",1,0],["كَحمامَةٍ صيدَت فَثَنَّت جيدَها","أَسَفاً لِتَنظُرَ حالَ وَكرٍ دامِرِ",42,"ر",1,0],["كَحِلفَي مُغارٍ كُلَّ يَومٍ وَلَيلَةٍ","عَلى الآلِ أَو في المالِ تَرغو بَوازِلُه",43,"ل",2,0],["كَحَمائِمٍ ظَلَمَت فَنادى أَجدَلٌ","إِن كُنتِ ظالِمَةً فَإِنّي أَظلَمُ",44,"م",1,0],["كُحِلَتْ عَيني عَمىً إنْ غَيْرَها","نَظَرْتْهُ ايهِ عَنّي ذا الرُّشَيْ",45,"ي",1,0],["كحوريَّةِ النبعِ تطوي الرِّشاءَ","وتجذبُ ممتلئاتِ السِّجالْ",46,"ل",1,0],["كحارسةِ الميْتِ ليسَت ترِيمُ","مكاناً به وقفَتْ تضطربْ",47,"ب",1,0],["كحملٍ مدلّل صار الأسدْ","والصارم المسلول عاد كالمسدْ",48,"د",1,0],["كَحُقَّيْ لُجَيْنٍ بِقُفْلَيْ عَقِي","يقٍ وَكَنْزَيْنِ فِي رَصَدٍ مُرْصَدِ",49,"د",1,0],["كَحَمْزةَ لمّا وَفَى صادِقاً","بذي هِبَةٍ صارِمٍ سَلْجَجِ",50,"ج",1,0],["كَحلُوا جَفْنَها فَكَحَّلْتَ فيها","كُلَّ جَفنٍ أَسىً وَسُهْداً طَوِيلاَ",51,"ل",2,0],["كحسناء عرّى العتاب الخجول ،","هواها وبالبسمات استتر",52,"ر",1,0],["كحقل دود ، وسط رمّانة","كثوب لصّ ، خارج من حصار",53,"ر",1,0],["كحقيبة ملأى ولا تدري","كباب ، لا يؤدي",54,"د",2,0],["كحريق يبحث عن نار","فيه عن وقدته iيذهل",55,"ل",1,0],["كحوريّة النّبع تطوي الرّشاء","وتخذب ممتلئات السّجال",56,"ل",1,0],["كحلتِ له بسحر عينيك مُقلَةً","وأسبلتِ فرعاً فاق مسكاً إذا انْسَبَلْ",57,"ل",1,0],["كحلاءُ ضاقتْ عن إِجالة ِ مرْودٍ","وجراحها في القلبِ جدُّ جراعِ",58,"ع",1,0],["كحاجة ِ يومٍ قبلَ ذلكَ منهمُ","عشية َ ردُّو بالكُلابِ الجمائِلا",59,"ل",2,0],["كحيلٌ وخصرٌ نحيل يشتكِي ألمَ النوى","مِن الردفِ إنْ قامتْ ينوءُ به الثُّقْلُ",60,"ل",1,0],["كَحَلتُ جُفُونِي بالسُّهادِ عُقوبَةً","لِسِرٍّ يُرَى بَينَ التَّقلُّبِ والسَّفكِ",61,"ك",1,0],["كَحَقباءَ مِن عونِ السراةِ رَجيلَةٍ","مَراتِعُها جَنبا قَنانٍ فَمُنكِفُ",62,"ف",1,0],["كحرفِ جامٍ من البَلّورِ قابَلَه","ضوءٌ وأخفَى الدُّجى إشراقَ سائرِهِ",63,"ر",2,0],["كحظِّ السعيدِ إذا ما ارتقى","وحظِّ الشقيِّ إذا ما انحدرْ",64,"ر",1,0],["كُحِلت عُيونٌ حُسَّدٌ لَكَ بالقَذَى","كي لا تَرَى وفُقِئْنَ إن لم تُكْحَلِ",65,"ل",1,0],["كُحِلَت جُفوني بِالسُها","دِ بِناظِرٍ مِنها كَحيلِ",66,"ل",1,0],["كحّليني بجلا عين الحشا","كمّليني بِحُلَى رضواننا",67,"ن",2,0],["كحالة ملق عبئه عنه فيا لكرى","إذا انتبهت عيناه عاد لبهظه",68,"ظ",2,0],["كحمامةٍ بيضاءَ كنتِ لطيفةً","وخفيفةً لما لبستِ اللاذا",69,"ذ",2,0],["كحباتِه ضاءت عيونُ أحبتي","بقَلبي فكانت منه أغلى وأسطعا",70,"ع",2,0],["كحل العيونَ وكانَ في أَجفانه","عضبٌ حَكى نابَ الشُجاعِ وسمَّهُ",71,"م",2,0],["كَحنينِ العَوْد يوماً للعَطَنْ","وانثنى نحو حشاه باليدِ",72,"د",1,0],["كَحَجَّةِ أُمِّ شَعلٍ حينَ حَجَّت","بِكَلبتِها فَلَم تَرمِ الجِمارا",73,"ر",2,0],["كَحبشيّةٍ قَد أقبلت في مُلاءةٍ","تَقول لزوجٍ مِن رُضابي فاِستقِ",74,"ق",1,0],["كَحيتان البِحار تَجور ظُلماً","فَيَفتَرس القويُّ بِها الضَعيفا",75,"ف",2,0],["كحضرة مَولَى الورى إذ تظَلُّ","ومن شَرف الدّينِ فيها سَديد",76,"د",1,0],["كحب المال والمد","ح يا ذا والوجاهات",77,"ت",1,0],["كَحَبيبٍ منافِقٍ كُلَّما هَم","مَ بِوَصلٍ أَحالَهُ بِصُدودِ",78,"د",1,0],["كَحيَّةٍ سوداءَ مَجَّت على","وَجهِ الضُّحى ظَلمَة ليلٍ بَهيمْ",79,"م",1,1],["كحلت بالسحر وبالدعج","أسماء لتفتك بالمهج",80,"ج",1,1],["كَحَدِّ سيفِكَ يَا منصورُ إِن سَلِمَتْ","منهُ ملوكُ العِدى ماتوا لَهُ حَسَدَا",81,"د",2,0],["كحلت بهمّي عين كل كريهة","إليها تخطّيت الأساوِدَ والأُسدا",82,"د",2,0],["كَحُلُومِهِمْ وعُلُومِهِمْ","البَرُّ والبَّحْرُ العُبابْ",83,"ب",1,0],["كَحَبيبٍ قد جادَ بِالوَصلِ لكن","ما لهُ قُدرةٌ على الإدخالِ",84,"ل",1,0],["كَحلاءُ لَم تَكتَحِل بِكاحِلَةٍ","وَسنانَةُ الطَرفِ ما بِها وَسَنُ",85,"ن",1,0],["كَحَملَةِ السَيلِ تَأتي بَعدَ عاشِرَةٍ","لَهُ قَراقيرُ بِالآذِيِّ وَال