","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[96,"راقصة الحانة","https://www.poetsgate.com/ViewPoem.aspx?id=17511",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[71,"ما سرُّ سكانِ الحِمى بِمُذاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28019&r=&rc=6",""],[4,"كُبَيْشَة ُ حَلَّتْ بَعْدَ عَهْدِكَ عاقلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10934&r=&rc=29",""],[126,"أأحبابنا منكم حياة لنا الوصل","https://www.aldiwan.net/poem50554.html","الطويل"],[148,"كتمت الهوى حتى تبدت سماته","https://www.aldiwan.net/poem68555.html","الطويل"],[161,"أرسم ديار لإبنة القين تعرف","https://www.aldiwan.net/poem397.html",""],[183,"أما رأيت هلال العيد حين بدت","https://www.aldiwan.net/poem14526.html","البسيط"],[197,"زهته الملاحة حتى سفر","https://www.aldiwan.net/poem45638.html","المتقارب"],[227,"شهر الصيام أجل شهر مقبل","https://www.aldiwan.net/poem50852.html","الكامل"],[233,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[257,"أسعفي يا ذات ربي بالمنى","https://www.aldiwan.net/poem35956.html","الرمل"],[259,"أتعجب خلى من زيارة هاجري","https://www.aldiwan.net/poem38130.html","الطويل"],[268,"طربا أهجت لنا برقصك هذا","https://www.aldiwan.net/poem35267.html","الكامل"],[268,"ليالي النوى حتام ترخين برقعا","https://www.aldiwan.net/poem35627.html","الطويل"],[295,"ومورد الوجنات أغيد خاله","https://www.aldiwan.net/poem33159.html","الكامل"],[296,"حق للمخزون أن ترثي له","https://www.aldiwan.net/poem36287.html","عموديه"],[298,"ألم تسأل بفاضحة الديارا","https://www.aldiwan.net/poem45488.html","الوافر"],[303,"وذهبي نمر فضضوه بسكر","https://www.aldiwan.net/poem56454.html","البسيط"],[351,"بنو الدنيا علو طمعا وغدرا","https://www.aldiwan.net/poem40032.html","الوافر"],[362,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[390,"نحن والله من هوائك يا جر","https://www.aldiwan.net/poem53567.html","الخفيف"],[402,"كحية سوداء مجت على","https://www.aldiwan.net/poem49463.html","السريع"],[426,"كحلت بالسحر وبالدعج","https://www.aldiwan.net/poem41429.html","المتدارك"],[436,"وطن فؤادك إن كان الرحيل غدا","https://www.aldiwan.net/poem34827.html","البسيط"],[493,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[527,"قد مد مطرفه السحاب","https://www.aldiwan.net/poem37526.html","مجزوء الكامل"],[536,"ليس من كربة وغصة نفس","https://www.aldiwan.net/poem47982.html","عموديه"],[551,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[551,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[556,"يا خبرا عني إذا","https://www.aldiwan.net/poem34498.html","مجزوء الرجز"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[560,"لمن طلل بوادي الرمل باد","https://www.aldiwan.net/poem52899.html","الوافر"],[565,"محبرة جاد لي بها قمر","https://www.aldiwan.net/poem69587.html","المنسرح"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[573,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[573,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[573,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[573,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[573,"حسنها كل ساعة يتجدد","https://www.aldiwan.net/poem3089.html","الخفيف"]],"verses":[["كَحافِلَةِ المُزنِ آنَستُها","مُسَمَّحَةً في قِيادِ النُعامى",0,"م",2,0],["كَحُمَيّا الطَودِ رَأياً وَحِجاً","وَرِماحُ الخَطِّ غَرباً وَقِياما",1,"م",2,0],["كَحَمحَمَةِ الأَداهِمِ أَقبَلوها","لَيالي الوِردِ مائِلَةَ الجِلالِ",2,"ل",1,0],["كَحامِلٍ لِثِيابِ الناسِ يَغسِلُها","وَثَوبُهُ غارِقٌ في الرِجسِ وَالنَجَسِ",3,"س",1,0],["كَحَوصَلَةِ الرَألِ في دَنِّها","إِذا صُوِّبَت بَعدَ إِقعادِها",4,"د",3,0],["كَحَلفَةٍ مِن أَبي رِياحٍ","يَسمَعُها لاهُهُ الكُبارُ",5,"ر",1,0],["كَحَيَّةِ سَلعٍ مِنَ القاتِلاتِ","تَقُدُّ الصَرامَةُ عَنكَ القَميصا",6,"ص",2,0],["كَحافِظِ اِبراهيمَ لَكِنَّهُ","أَجمَلُ خَلقاً مِنهُ في الظاهِرِ",7,"ر",1,1],["كحلُ الشَريفِ مُقارِبٌ","كَم ناظِرٍ قَد أَغمَضا",8,"ض",2,1],["كَحلاءُ ضاقَت عَن إِجالَةِ مرودٍ","وَجِراحُها في القَلبِ جدُّ وِساعِ",9,"ع",1,0],["كَحَقفِ النَقا يَمشي الوَليدانِ فَوقَهُ","بِما اِحتَسَبا مِن لينِ مَسٍّ وَتَسهالِ",10,"ل",1,0],["كَحَواشي الرِداءِ قَد مُحَّ مِنهُ","بَعدَ حُسنٍ عَصائِبُ التَسهيمِ",11,"م",1,0],["كَحَاتِمٍ إِنْ يُقْرِ أَضْيَافَهُ","كَمَعْنَ إِنْ يُعْطِ وَإِنْ يَحْلُمِ",12,"م",1,0],["كُحِلَت بِمَنظَرِكَ العُيونُ عَمايَةً","وَأَصَمَّ نَعيُكَ كُلَّ أُذنٍ تَسمَعُ",13,"ع",1,0],["كَحَلتُ بِها إِنسانَ عَيني فَأَسبَلَت","بِمُعتَسِفِ بَينَ الجُفونِ تُؤامِ",14,"م",1,0],["كَحلاءُ في بَرَجٍ صَفراءُ في نَعَجٍ","كَأَنَّها فِضَّةٌ قَد مَسَّها ذّهَبُ",15,"ب",1,0],["كَحاجَةِ يَومٍ قَبلَ ذَلِكَ مِنهُمُ","عَشِيَّةَ رَدّوا بِالكُلابِ الجَمائِلا",16,"ل",2,0],["كَحَالِئَةٍ عن كُوعِها وهي تَبتَغِي","صَلاحَ أدِيمٍ ضَيَّعَتهُ وتَغمُلُ",17,"ل",1,0],["كحاجبٍ مقترنٍ بالبَها","فحبَّذا الكاتبُ والحاجب",18,"ب",1,0],["كحَّلت بالسهد جفنيها وقد وصلت","مسافة النأي أميالاً بأميال",19,"ل",1,0],["كحّلت جفوني بالسهادِ لبعدهم","فيا حبَّذا للسّهد والبعد أميال",20,"ل",1,0],["كحشو الخشكنان له صفات","فما وصفي دقيقاً أو علامه",21,"م",2,0],["كحليفِ العمى تَغَوَّطَ في الإي","وان جهلاً بأنه الإيوانُ",22,"ن",1,0],["كحيرانَ لا يدري الهدى كيف وجهُه","ضلالاً وما يَلقى إلى الرشدِ هاديا",23,"ي",2,0],["كَحَرّانِ مَنتوفِ الذِراعَينِ صَدَّهُ","عَنِ الماءِ فُرّاطٌ وَوِردٌ مُصَبَّحُ",24,"ح",1,0],["كحافظ أخي النهى","أو كالنواسي ذى الأدب",25,"ب",1,0],["كَحُلَّةٍ دكناءَ في حاشيةٍ","منها طِرازٌ ذهبٌ مسلسلُ",26,"ل",1,0],["كَحَبِيِّ الغَمامِ جادَ فَرَوّى","كُلَّ وادٍ مِنَ البِلادِ وَنيقِ",27,"ق",1,0],["كحَلْي الخَودِ مُؤتَلفِ النَّواحي","ووَشْيِ الرَّوض مُختلِفِ الرُّقُومِ",28,"م",1,0],["كَحْلاءُ حاليةٌ بكَت","حتَّى انثنتْ مَرهاءَ عاطل",29,"ل",1,0],["كَحَذو النَعلِ بِالنَعلِ","إِذا ما النَعلُ حاذاهُ",30,"ه",1,0],["كَحَلقِ البَكرِ يَجرَحُهُ زُلالٌ","وَلا يُدمي مَشافِرَهُ القَتادُ",31,"د",1,0],["كَحَلَ العُيونَ بِضَوءِ نورِ جَبينِهِ","عِندَ السُفورِ فَلا عَدِمتُ الإِثمِدا",32,"د",2,0],["كحلتْ جفونَ الصبح منها بالسرى","وتكحلتْ منه بلوْنِ الإثْمِدِ",33,"د",1,0],["كحيّةٍ باللّسانِ لاحسةٍ","ما أدرَكتْ من سوادِ غيهبها",34,"ب",3,0],["كحجيج مكة في ارْتفاع عجيجهم","وطوافهمْ بالبيتِ ذي الأركانِ",35,"ن",1,0],["كَحَلت عينِيَ إذ كَلَّتْ بِجَوهَره","أَما يُحَدّ بِكُحْلِ الجَوهَرِ البَصرُ",36,"ر",1,0],["كَحَلَ الهوَى والسِّحرُ مِن","ك جفونَ رئمٍ أحورِ",37,"ر",1,0],["كُحِلتُ بِقُبحِ صورَتِهِ فَأَضحى","لَها إِنسانُ عَيني في السِياقِ",38,"ق",1,0],["كَحُلقومِ القَطاةِ أُمِرَّ شَزراً","كَإِمرارِ المُحَدرَجِ ذي الأُسونِ",39,"ن",1,0],["كَحَدَّينِ مِن جَلَمٍ مُعلَمٍ","فَلا تِلكَ كَلَّت وَلا ذا بِها",40,"ب",3,0],["كُحِلَتْ بِتَقْوَى اللهِ مُقْلَتُهُ التي","لَمْ تَكْتَحِلْ أجْفانُها بِمَنَامِ",41,"م",1,0],["كَحمامَةٍ صيدَت فَثَنَّت جيدَها","أَسَفاً لِتَنظُرَ حالَ وَكرٍ دامِرِ",42,"ر",1,0],["كَحِلفَي مُغارٍ كُلَّ يَومٍ وَلَيلَةٍ","عَلى الآلِ أَو في المالِ تَرغو بَوازِلُه",43,"ل",2,0],["كَحَمائِمٍ ظَلَمَت فَنادى أَجدَلٌ","إِن كُنتِ ظالِمَةً فَإِنّي أَظلَمُ",44,"م",1,0],["كُحِلَتْ عَيني عَمىً إنْ غَيْرَها","نَظَرْتْهُ ايهِ عَنّي ذا الرُّشَيْ",45,"ي",1,0],["كحوريَّةِ النبعِ تطوي الرِّشاءَ","وتجذبُ ممتلئاتِ السِّجالْ",46,"ل",1,0],["كحارسةِ الميْتِ ليسَت ترِيمُ","مكاناً به وقفَتْ تضطربْ",47,"ب",1,0],["كحملٍ مدلّل صار الأسدْ","والصارم المسلول عاد كالمسدْ",48,"د",1,0],["كَحُقَّيْ لُجَيْنٍ بِقُفْلَيْ عَقِي","يقٍ وَكَنْزَيْنِ فِي رَصَدٍ مُرْصَدِ",49,"د",1,0],["كَحَمْزةَ لمّا وَفَى صادِقاً","بذي هِبَةٍ صارِمٍ سَلْجَجِ",50,"ج",1,0],["كَحلُوا جَفْنَها فَكَحَّلْتَ فيها","كُلَّ جَفنٍ أَسىً وَسُهْداً طَوِيلاَ",51,"ل",2,0],["كحوريّة النّبع تطوي الرّشاء","وتخذب ممتلئات السّجال",52,"ل",1,0],["كحلتِ له بسحر عينيك مُقلَةً","وأسبلتِ فرعاً فاق مسكاً إذا انْسَبَلْ",53,"ل",1,0],["كحلاءُ ضاقتْ عن إِجالة ِ مرْودٍ","وجراحها في القلبِ جدُّ جراعِ"