{"poems":[[74,"له إذا غازلتك عيناه","https://www.aldiwan.net/poem20512.html","المنسرح"],[469,"ليلة خففت من الهم عنا","https://www.aldiwan.net/poem3550.html","عموديه"],[591,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216396",""],[3998,"","https://poetry.dctabudhabi.ae/diwan/poem/34824","الخفيف"],[3591,"من دولة الحسن أم من دولة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=149490",""]],"verses":[["لو لقته العذَّال ما عذلت","دعها ولا في المنامِ تلقاه",0,"ا",2,0],["لو لقينا بها العِدى لغنينا","عن ظبى الهند والرّماح الهيف",1,"ف",1,0],["لَوْ لُقّبُوا بِالغُصونِ السُّمْرِ صَدَّقهُمْ","جَعْلُ الرُّؤوس لها يَوْمَ الوَغى كُثَبا",2,"ب",2,0],["لو لقيت اللي ليَ يْسَلّي","حالفٍ بالعهد ما اخونه",3,"ن",2,0],["لَو لَقوا ما لَقيتُ مِن حرفَةِ العَق","لِ لَساروا إِلى الحَماقَةِ رَسلا",4,"ل",2,0],["لو لقبّوك بما نادوا به ملكاً","ما كان عزّك أسنى منه باللقب",5,"ب",1,0]]}