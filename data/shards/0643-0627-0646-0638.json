{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[65,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[94,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[68,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[77,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[113,"عصرت ماء حسنه الأيام","https://www.aldiwan.net/poem16520.html","الخفيف"],[199,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[203,"بنوه على تلك اللحاظ الفواتك","https://www.aldiwan.net/poem45368.html","الطويل"],[208,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[215,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[254,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[445,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[466,"فضلت التهاني بالمراتب والعلى","https://www.aldiwan.net/poem15150.html","الطويل"],[469,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[488,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[558,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[564,"حرك الوجد في هواكم سكوني","https://www.aldiwan.net/poem69337.html","الخفيف"],[575,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138077",""],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16729","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64640","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121990","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79873","الخفيف"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121879","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96027","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33878","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87733","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141193","الرمل"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112292","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62890","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48311","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48444","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85272","البسيط"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67620","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73146","الخفيف"],[4755,"كان ظَنِّي أنهم قد صَعَدُوا","https://www.poetsgate.com/ViewPoem.aspx?id=208128",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5183,"أبا دواؤد","https://www.poetsgate.com/ViewPoem.aspx?id=180195",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[1043,"الأعمى","https://www.poetsgate.com/ViewPoem.aspx?id=89181",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[5608,"أدري ما عندك إجابة","https://www.poetsgate.com/ViewPoem.aspx?id=34582",""],[5621,"كيفَ تمضي","https://www.poetsgate.com/ViewPoem.aspx?id=24563",""],[5741,"رب روض أزرته بدر تم","https://www.poetsgate.com/ViewPoem.aspx?id=187456",""]],"verses":[["كانَ ظَلاماً فَاِنجَلى ال","يَومَ وَظِلّاً فَاِنحَسَر",0,"ر",1,0],["كأنّ ظَلامَ الليلِ والنّجمُ جانِحٌ","إِلى الغَرْبِ غِمْدٌ والصّباحُ حُسامُهُ",1,"م",2,0],["كَأَنَّ ظِباءَ وَجرَةَ مُشرِفاتٍ","عَلَيهِنَّ المَجاسِدُ وَالبُرودُ",2,"د",1,0],["كانَ ظنِّي أنَّ النُّفوسَ كبارٌ","فوجدتُ النُّفوس شيئاً حقيرا",3,"ا",1,0],["كَأَنَّ ظَلامَها بِالشَمعِ فَودٌ","وَقَد وَخَطَ القَتيرُ بِهِ فَشابا",4,"ب",2,0],["كأنّ ظلامَ الليلِ إذ مالَ مَيْلَةً","صريعُ مُدامٍ باتَ يشرَبُها صِرفا",5,"ف",2,0],["كأنّ ظِلالَ الخافِقاتِ أمامَهُ","غمائِمُ نَصْرِ اللّه لا تَتَقَشّع",6,"ع",1,0],["كان ظني أنَّ الأثيرَ هوَ الر","بُّ كريماً يمدني ويجير",7,"ر",1,0],["كأنّ ظِماءَهُنّ بناتُ نَعْشٍ","يَرِدْنَ إذا وَرَدنا بِنا الثِّمادا",8,"د",2,0],["كانَ ظبياً جُفونَهُ شرك العَق","ل وَغُصناً عَلَيهِ بَدر تَمام",9,"م",1,0],["كَأَنَّ ظَعنَهُمُ في الآلِ حينَ نَأَوا","إِذا اِستَقَلَّت بِهِم بَيداءُ أَو شَرَفُ",10,"ف",1,0],["كأنَّ ظلامَ القبرِ في لَمَعانِها","شعورُ الغواني بينَ حالٍ وحالكِ",11,"ك",1,0],["كان ظنّي به جميلاً فصَرَّف","تُ ظنوني إلى وجوهٍ حسانِ",12,"ن",1,0],["كان ظني والأماني ضلّة","أن حبى للمليحات مزاح",13,"ح",1,0],["كَأَنَّ ظِباءَ أَسنُمَةٍ عَلَيها","كَوانِسَ قالِصاً عَنها المَغارُ",14,"ر",1,0],["كَأَنَّ ظُهورَها حُزَمٌ أَنابَت","بِها أُصُلاً إِلى الحَيِّ الإِماءُ",15,"ا",2,0],["كَأَنَّ ظلامَ الليلِ سَدَّ طَرِيقَهُ","تعلُّقُ أَجفانِي بِرَعْيِ الفراقِدِ",16,"د",1,0],["كأنَّ ظُباهُ في متونِ عجاجةٍ","بوارق يقتدن السَّحاب الكَنَهْورا",17,"ر",2,0],["كان ظنّي أنَّ صبري منجدٌ","ثمَّ لما أنجدوا خيّب ظنّي",18,"ن",2,0],["كأن ظعنهم والآل يرفعها","نخل المشقر أو ما زينت هجر",19,"ر",1,0],["كَأَنَّ ظِباءً عُكَّفاً في رِياضِها","أَباريقُها أَوجَسنَ قَعقَعَةَ النَبلِ",20,"ل",1,0],["كان ظَنِّي رجوعهُم لي قرِيباً","فانْقضَت مُدَّتي وخابت ظُنوني",21,"ن",2,0],["كان ظلمي قتل سارةِ بني بدرٍ","فأصبحت بعدهم مرحوما",22,"م",2,0],["كان ظلمي وكان ظلمهم أمسِ","عظيماً ورأيهم موصوما",22,"م",2,0],["كأن ظلام العين يشتد كلما","تقضت شهورٌ أثرهن شهور",23,"ر",1,0],["كَأَنَّ ظَلامَ اللَيلِ أَذرى دُموعَهُ","فَظَلَّت عَلى خَدِّ الصَباحِ تَصوبُ",24,"ب",1,0],["كأن ظلال الأنس لما تقلصت","طوتها بأيديها قلاص كعقبان",25,"ن",1,0],["كَأَنَّ ظُبَاهُمْ فِي الهِيَاجِ أَكُفُّهُمْ","تَجُودُ وَأَرْوَاحُ العُدَاةِ مَوَاهِبُ",26,"ب",1,0],["كان ظنِّي بأن على إثر إن نا","ديتُ أغدو بما رجوتُ مُجابا",27,"ب",2,0],["كان ظامي الوشاح ريان من ما","ء التصابي أضنى المحب وعنى",28,"ن",2,0],["كأن ظلام النقع يبدي لعينه","ضياء صباح بالمسرة مقبل",29,"ل",1,0],["كأَنَّ ظل النقع من فوقه","ظُلَّةُ وَبْلٍ مُصْعِقٍ مُبْرِق",30,"ق",1,0],["كَأَنَّ ظَريفاً لَم يُشَمِّر ثِيابَهُ","لِخِدمَةِ بَيتي وَالعُيونُ رَواقِدُ",31,"د",1,0],["كَأَنَّ ظَريفاً لَم يُبَلِّغ رِسالَتي","وَيَشهَد لَهُ بِالنُصحِ عِندي شَواهِدُ",31,"د",1,0],["كَأَنَّ ظَريفاً لَم يَكُن لي مُساعِداً","إِذا غابَ عَنّي في الأُمورِ المُساعِدُ",31,"د",1,0],["كَأَنَّ ظَريفاً لَم تَطِب لي بِقُربِهِ","مَصادِرُ لِذّاتِ الهَوى وَالمَوارِدُ",31,"د",1,0],["كَأَنَّ ظَريفاً لَم يَذُق رَوحَ ساعَةٍ","وَلَم يَغذُهُ يَومٌ مِنَ العَيشِ واحِدُ",31,"د",1,0],["كَأَنَّ ظُهور الصافِنات لَهُم سَما","يَجرُّون فَوقَ النجم ضافي أَذيال",32,"ل",1,0],["كان ظرفاً مستقراً وكرها","جاء زيد قام عمرو ذكرها",33,"ه",2,0],["كان ظلا كلما امتد له","أمل في الشدة النكراء مدا",34,"د",2,0],["كان ظَنّي فيهِ يبقى طالَما","أنا باقٍ عندما الدنيَا تجُور",35,"ر",1,0],["كان ظني أن نجمي لا يغِيب","فإذا بالنجمِ قد ولَّى وَغَاب",36,"ب",1,0],["كأَن ظهورَ الطير دونَ مَقيلِهِ","زَرابيُّ سَدَّى وشيَهُهنَّ المنمِّقُ",37,"ق",1,0],["كأنّ ظِباءَ القفْرِ ضلّتْ فأتْلَعَتْ","هواديَ بينْ الأيْكِ والبانِ والطّلْحِ",38,"ح",1,0],["كأنّ ظلامَ الليلِ فيه غدائِرٌ","تُلاثُ على هامِ النّجومِ وتُعْقَصُ",39,"ص",1,0],["كأن ظلام الليل خيم جنحه","على الشعرا ومد الجناح ظليم",40,"م",1,0],["كَأَنَّ ظِباءَ السِيِّ أَو عينَ عالِجٍ","عَلى العيرِ أَو أَبهى بَهاءً وَأَفخَما",41,"م",2,0],["كأنَ ظني بك الجميلَ فألفي","تُكَ من كلِّ ما ظننتُ بعيدا",42,"د",2,0],["كانَ ظنِّي أنَّ الحمائمَ تَشفي","فسقاني نَوحُ الحَمامِ الحِماما",43,"م",2,0],["كان ظَنِّي أنهم قد صَعَدُوا","سُلَّمَ الوَهمِ، وعَنَّا ابتَعدوا",44,"د",3,1],["كان ظَنِّي أنهم ما شَعَروا","بِمَآسِينا.. فقيل ارتَعَدُوا",44,"د",3,0],["كَاْنَ ظَنِّيْ طَيِّبَاً رِئْمَاْنُ أَنْفٍ قَدْ نَحَىْ وَجْ","هَ الْهَوَىْ حُسْنَىْ فَسَاْرَ الْحُسْنُ فِيْ ظَنِّيْ خَسَاْرَاْ",45,"ر",2,0],["كأن ظباها في الرياض رواتعا","دمىً تترامى بين لاه ومعجب",46,"ب",1,0],["كأن ظِباها في الخمائل رتعا","سهام القضا لكن على المتطاول",47,"ل",1,0],["كأن ظلام العين يشتد كلما","نقضت شهورٌ اثرهن شهورُ",48,"ر",1,0],["كان ظلما ..كان غيا","اصطبر واهجر مليا",49,"ي",2,1],["كان ظني في محلّه .. بَبتعد ما في جدال","وكان ظني غير صايب ببقى يمّك لو تشيبي",50,"ب",2,0],["كان ظنّي بأنْ تقولَ رثائي","يا سخيَّ العَطاءِ أينَ الرّثاءُ ؟",51,"ا",2,0],["كان ظني أن يفضح القد بالغص","ن وأن الزلال بالريق يزري",52,"ر",2,0]]}