{"poems":[[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[63,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[92,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[66,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"]],"verses":[["كانَ ظَلاماً فَاِنجَلى ال","يَومَ وَظِلّاً فَاِنحَسَر",0,"ر",1,0],["كأنّ ظَلامَ الليلِ والنّجمُ جانِحٌ","إِلى الغَرْبِ غِمْدٌ والصّباحُ حُسامُهُ",1,"م",2,0],["كَأَنَّ ظِباءَ وَجرَةَ مُشرِفاتٍ","عَلَيهِنَّ المَجاسِدُ وَالبُرودُ",2,"د",1,0],["كانَ ظنِّي أنَّ النُّفوسَ كبارٌ","فوجدتُ النُّفوس شيئاً حقيرا",3,"ا",1,0],["كَأَنَّ ظَلامَها بِالشَمعِ فَودٌ","وَقَد وَخَطَ القَتيرُ بِهِ فَشابا",4,"ب",2,0],["كأنّ ظلامَ الليلِ إذ مالَ مَيْلَةً","صريعُ مُدامٍ باتَ يشرَبُها صِرفا",5,"ف",2,0],["كأنّ ظِلالَ الخافِقاتِ أمامَهُ","غمائِمُ نَصْرِ اللّه لا تَتَقَشّع",6,"ع",1,0],["كان ظني أنَّ الأثيرَ هوَ الر","بُّ كريماً يمدني ويجير",7,"ر",1,0],["كأنّ ظِماءَهُنّ بناتُ نَعْشٍ","يَرِدْنَ إذا وَرَدنا بِنا الثِّمادا",8,"د",2,0]]}