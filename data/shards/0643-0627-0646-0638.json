{"poems":[[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[63,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[92,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[66,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[110,"عصرت ماء حسنه الأيام","https://www.aldiwan.net/poem16520.html","الخفيف"],[196,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[200,"بنوه على تلك اللحاظ الفواتك","https://www.aldiwan.net/poem45368.html","الطويل"],[205,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[212,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[250,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[323,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[440,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[462,"فضلت التهاني بالمراتب والعلى","https://www.aldiwan.net/poem15150.html","الطويل"],[465,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[484,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[554,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[560,"حرك الوجد في هواكم سكوني","https://www.aldiwan.net/poem69337.html","الخفيف"],[571,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"]],"verses":[["كانَ ظَلاماً فَاِنجَلى ال","يَومَ وَظِلّاً فَاِنحَسَر",0,"ر",1,0],["كأنّ ظَلامَ الليلِ والنّجمُ جانِحٌ","إِلى الغَرْبِ غِمْدٌ والصّباحُ حُسامُهُ",1,"م",2,0],["كَأَنَّ ظِباءَ وَجرَةَ مُشرِفاتٍ","عَلَيهِنَّ المَجاسِدُ وَالبُرودُ",2,"د",1,0],["كانَ ظنِّي أنَّ النُّفوسَ كبارٌ","فوجدتُ النُّفوس شيئاً حقيرا",3,"ا",1,0],["كَأَنَّ ظَلامَها بِالشَمعِ فَودٌ","وَقَد وَخَطَ القَتيرُ بِهِ فَشابا",4,"ب",2,0],["كأنّ ظلامَ الليلِ إذ مالَ مَيْلَةً","صريعُ مُدامٍ باتَ يشرَبُها صِرفا",5,"ف",2,0],["كأنّ ظِلالَ الخافِقاتِ أمامَهُ","غمائِمُ نَصْرِ اللّه لا تَتَقَشّع",6,"ع",1,0],["كان ظني أنَّ الأثيرَ هوَ الر","بُّ كريماً يمدني ويجير",7,"ر",1,0],["كأنّ ظِماءَهُنّ بناتُ نَعْشٍ","يَرِدْنَ إذا وَرَدنا بِنا الثِّمادا",8,"د",2,0],["كانَ ظبياً جُفونَهُ شرك العَق","ل وَغُصناً عَلَيهِ بَدر تَمام",9,"م",1,0],["كَأَنَّ ظَعنَهُمُ في الآلِ حينَ نَأَوا","إِذا اِستَقَلَّت بِهِم بَيداءُ أَو شَرَفُ",10,"ف",1,0],["كأنَّ ظلامَ القبرِ في لَمَعانِها","شعورُ الغواني بينَ حالٍ وحالكِ",11,"ك",1,0],["كان ظنّي به جميلاً فصَرَّف","تُ ظنوني إلى وجوهٍ حسانِ",12,"ن",1,0],["كان ظني والأماني ضلّة","أن حبى للمليحات مزاح",13,"ح",1,0],["كَأَنَّ ظِباءَ أَسنُمَةٍ عَلَيها","كَوانِسَ قالِصاً عَنها المَغارُ",14,"ر",1,0],["كَأَنَّ ظُهورَها حُزَمٌ أَنابَت","بِها أُصُلاً إِلى الحَيِّ الإِماءُ",15,"ا",2,0],["كَأَنَّ ظلامَ الليلِ سَدَّ طَرِيقَهُ","تعلُّقُ أَجفانِي بِرَعْيِ الفراقِدِ",16,"د",1,0],["كأنَّ ظُباهُ في متونِ عجاجةٍ","بوارق يقتدن السَّحاب الكَنَهْورا",17,"ر",2,0],["كان ظنّي أنَّ صبري منجدٌ","ثمَّ لما أنجدوا خيّب ظنّي",18,"ن",2,0],["كأن ظعنهم والآل يرفعها","نخل المشقر أو ما زينت هجر",19,"ر",1,0],["كَأَنَّ ظِباءً عُكَّفاً في رِياضِها","أَباريقُها أَوجَسنَ قَعقَعَةَ النَبلِ",20,"ل",1,0],["كان ظَنِّي رجوعهُم لي قرِيباً","فانْقضَت مُدَّتي وخابت ظُنوني",21,"ن",2,0],["كان ظلمي قتل سارةِ بني بدرٍ","فأصبحت بعدهم مرحوما",22,"م",2,0],["كان ظلمي وكان ظلمهم أمسِ","عظيماً ورأيهم موصوما",22,"م",2,0]]}