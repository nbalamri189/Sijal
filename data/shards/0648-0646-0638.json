ي الغَضَى",2,"ض",2,0],["وَنَظَرتُ بِركَتَهُ تَفيضُ وَماؤُه","يَحكي مَواهِبَهُ وَجودَ بَنانِهِ",3,"ن",2,0],["ونظَمْتَ المَجْدَ فوافِرُهُ","غنّاكَ السّعْدُ بهِ وسَقَى",4,"ق",2,0],["وَنَظَلُّ تَجري بَينَنا","وَمُفَدَّمٌ يَسقي بِها",5,"ب",3,0],["وَنَظرَةَ عَينٍ عَلى غِرَّةٍ","مَحَلَّ الخَليطِ بِصَحراءِ زُم",6,"م",1,0],["وَنَظَرتُها تَنقَضُّ مِن كَفَّيهِما","فَوقَ الطُروسِ فَخِلتُها كَشِهابِ",7,"ب",1,0],["وَنَظَرتَ تَطوافَ القُلو","بِ بِساحَةِ العَرشِ المُفَدّى",8,"د",2,0],["وَنَظَرتَ في الطَيَرانِ نَظ","رَةَ مُصلِحٍ لَم يَألُ جُهدا",8,"د",2,0],["وَنَظمُ ثَناءٍ في نِظامِ وِلايَةٍ","تَحَلَّت بِهِ الدُنيا لَآلِئُهُ وَسطُ",9,"ط",1,0],["وَنَظَرنَ حينَ سَمِعنَ رَجعَ تَحِيَّتي","نَظَرَ الجِيادِ سَمِعنَ صَوتَ لِجامِ",10,"م",1,0],["ونظيمةٍ دَرَتِ البداةُ أن في","حَضرِ الممالك عندها أعرابا",11,"ب",2,0],["ونظّمت شعري فيك تزهى قصيدةٌ","على كلِّ ذي بيتٍ من الشعر يعمر",12,"ر",1,0],["ونظم ونثر يخرجان ذوي النهى","لعمرك من أرض التثبت بالسّحر",13,"ر",1,0],["ونظمك الزَّهر لكن بعضه زهرٌ","مع أنه النَّوْر إلاَّ أنَّه النور",14,"ر",1,0],["ونظم أسلاك السطور فحليت","من التاج أجياد الممالك جوهرا",15,"ر",2,0],["ونظيمة من طيّب الكلمِ الذي","لسوى مقامك في الورى لم ترفع",16,"ع",1,0],["ونظمٌ يجاري الناظمين جوادُه","إذا شاءَ أن يلهو بلحيةِ أحمق",17,"ق",1,1],["وَنَظرةَةٌ مِنكَ يا سُؤلي وَيا أَمَلي","أَشهى إِلَيَّ مِنَ الدُنيا وَما فيها",18,"ي",3,0],["ونظرتُ ما بخلُ امرىءٍ وسماحُهُ","والرأي يُوجدُ أهلَهُ التأويلا",19,"ل",2,0],["وَنَظَرت وَالأَوصابُ تَنهَشُ قَلبَها","فَرَأَيتَ كُلَّ لَذاذَةٍ أَوصابا",20,"ب",2,0],["وَنَظَرتِ فَلَم تَرَي","غَيرَ عَظمٍ مُجَرَّدِ",21,"د",1,0],["وَنَظَنُّ ضِحكَ الدَهرِ فاتِحَةَ الرِضى","وَالدَهرُ يَهزَءُ بِالأَنام وَيَسخَرُ",22,"ر",1,0],["وَنَظَرتُ إِلَيهِ في البَرِّ","يَتَمَنّى لَو خاضَ البَحرا",23,"ر",2,0],["وَنَظَرتُ إِلَيهِ في البَحرِ","يَتَمَنّى لَو بَلَغَ البَرّا",23,"ر",2,0],["وَنَظُنُّ أَنَّ الرَوضَ يَنشُرُ عِطرَهُ","مِن أَجلِنا وَلَنا يُغَنّي البُلبُلُ",24,"ل",1,0],["ونَظَلُّ نَرْكُضُ خلفَ","أَسرابِ الفَراشِ المُسْتَطيرْ",25,"ر",1,0],["ونَظَلُّ ننثُرُ للفضاءِ","الرَّحْبِ والنَّهرِ الكبيرْ",25,"ر",1,0],["ونَظَلُّ نعبثُ بالجليلِ","منَ الوُجُودِ وبالحقيرْ",25,"ر",1,0],["ونَظَلُّ نقفزُ أو نُثَرْثِرُ","أَو نغنِّي أَو نَدورْ",25,"ر",1,0],["ونَظَرْتُ حولي لَمْ أَجِدْ","إلاَّ شُكُوكَ المُسْتَريبْ",26,"ب",1,0],["ونظمت فيه وفي وضاءة ليله","مالم تزل تجرى به الأسمار",27,"ر",1,0],["ونظام كأنه فلك اللي","ل إذا لاح وهو بالزهر حال",28,"ل",1,0],["ونظهر النصوصا","ونطرد اللصوصا",29,"ص",2,0],["وَنِظامُ الأُمورِ عَقلٌ وَعَدلٌ","فَإِذا وَلَّيا تَوَلّى النِظامُ",30,"م",1,0],["وَنِظامٍ كَأَنَّهُ فَلَكُ اللَي","لِ إِذا لاحَ وَهوَ بِالزُهرِ حالي",31,"ل",2,0],["ونَظَرْتُ سِبْطَ مُحَمّدٍ في كَرْبُلا","فَرْداً يُعاني حُزْنَهُ المَكْظُوما",32,"م",2,0],["ونظرْنَ من خَللِ السُّجوفِ بأعيُنٍ","أهدابُهنَّ وقد نُصبنَ حَبائِلُ",33,"ل",1,0],["ونظرتَ للميسورِ تُدْرِكُهُ","حتَّى إِذا أدْركتَهُ انْحَسَرا",34,"ر",2,0],["ونِظامٌ فيه الحَلالُ من السِّحْ","رِ تَعالَى عن كلِّ سِحْرٍ حَرامِ",35,"م",1,0],["ونِظامِ ثَغْرٍ ما تهلَّلَ وَشْيُه","إلا بكى خَجَلاً نِظامُ الجَوهَرِ",36,"ر",1,0],["وَنَظيرُ المَرءِ في مَعروفِهِ","شافِعٌ مَتَّ إِلَيهِ فَشَفَع",37,"ع",1,0],["وَنَظَمتُ البَديعَ فيكُم وَقَد أَل","قى مَقاليدَهُ إِلَيَّ الكَلامُ",38,"م",1,0],["وَنَظَرتَ خَلفَكَ كَالإِمامِ بِخاتَمٍ","أَضحى لَديهِ الشَكُّ وَهوَ عِيانُ",39,"ن",1,0],["ونظل ننسج من أمانينا","وشيا من الأحلام براقا",40,"ق",2,0],["وَنَظَّمتَ حبّاتِ القُلوبِ مَحَبَّةً","عَلَيكَ وقَد كانَت مباينةَ النَثرِ",41,"ر",1,0],["وَنَظَرتُ نَظرَةَ عاشِقٍ دَنِفٍ","بادي الصَبابَةِ عازِمٍ نَظَرُه",42,"ر",2,0],["وَنَظَمتُ مِن قُبَلٍ بِصَفحَةِ جيدِهِ","عِقداً وَقَد لَبِسَ العِناقَ شِعارا",43,"ر",2,0],["ونَظمتَ شَملَ المُلكِ بالقَلَمِ الّذي","حَلَّيْتَ منه للسُّطورِ طُروسا",44,"س",2,0],["وَنَظَرٍ راعٍ وَهادٍ نَهدِ","وَهامَةٍ مَلمومَةٍ كَالصَلدِ",45,"د",1,0],["وَنَظرَةُ عَينٍ لَم تُخالِط عَباءَةً","رَأَت مَجلِسي فَرداً وَفِيَّ عُزوبُ",46,"ب",1,0],["وَنَظمُ أُناسٍ تَناهى إِلَيَّ","مِن عَهدِ آدَمَ ثُمَّ اِنقَطَع",47,"ع",1,0],["ونِظامَ الدُّرِّ لا تَعْ","قِدُهُ من غَيرِ سِلكِ",48,"ك",1,0],["ونظمت مرثية تخذت لها ذرى ال","مستنصرية موضع الإنشاد",49,"د",1,0],["وَنَظَرتُ بِركَتَهُ تَفيضُ وَماؤُها","يَحكي مَواهِبَهُ وَجودَ بَنانِهِ",50,"ن",2,0],["وَنَظرْنَهُ فِي شَكْلِ مَنْ","أَبْكَى بِمَا هُوَ عَنْه ذَاكِرْ",51,"ر",1,0],["وَنَظَرتُ في قطعِ الرُعافِ فَلَم تَمط","حُكمَ المَنِيَّةِ حيلَةُ الحُكَماءِ",52,"ا",2,0],["ونَظْمٍ له نَفَحَاتُ الرِّياضِ","إذَا نَقَّط الطَّلُّ أزهارَها",53,"ر",3,0],["وَنَظَمْتُ فِيكَ فَرَائِداً","كَانَتْ لِجِيدِكَ خَيْرَ عِقْدِ",54,"د",1,0],["ونظل نركض خلف اسراب الفراش المستطير","نشدو ونرقص كالبلابل للحياة وللحبور",55,"ر",1,0],["ونظموا عقد مجد باجتماعهم","لا زال عقدا بعين الله مجتمعا",56,"ع",2,0],["ونظرنا في الأفق وهو بقايا","من ظلام محمرّة الوجه غضبى",57,"ب",2,0],["ونظنّ ضحك الدهر فاتحة الرضى","والدهر يهزأ بالأنام ويسخر",58,"ر",1,0],["ونظمأ لولا نهلة من رحيقه","أديرت فلا الساقي أفاق ولا الشرب",59,"ب",1,0],["ونظيره الاهمال والاعجام في ال","قرآن اذ بهما يؤول الى الغير",60,"ر",1,0],["ونظيره جهل المخارج للحرو","ف على الصلاة لمن يؤم به ضرر",60,"ر",1,0],["ونظرت العزيز يوسف من بع","د انقطاع الرجاء بالاعلاء",61,"ا",2,0],["ونظرته عدت بحق عبادة","وأوصافه كالدر في أبحر الكتب",62,"ب",1,0],["ونظرت أحلاس الوظا","ئف سادة بين البرية",63,"ي",2,0],["ونَظَلُّ نَرقُبُ غَيبَةَ الرُّقَبَاءِ كَى","نَصطَادَ بِيضاً كالظِّبَاءِ خَوَاذِلا",64,"ل",2,0],["ونظمت في سلك الفخار مناقبا","حارت لديها فطنة النظام",65,"م",1,0],["ونظرتك الشفيقة نحو وجهي","ورفرفت الضلوع تقول هيا",66,"ي",2,0],["وَنَظلُّ نُظهِرُ بالحَوَاجِبِ بَينَنا","مافِى النُّفُوسِ وَنَحنُ لا نَتَكَلَّمُ",67,"م",1,0],["وَنَظفَر بَعدَ طُولِ عَناً وَجُهدٍ","بِما سلَبتَهُ أَيدينا الدُّهورُ",68,"ر",1,0],["ونظرتُ ثغركِ ضاحكاً","وبقيتِ لي لم تعبسي",69,"س",2,0],["ونظن أن الأرض تخطِر تحته","بلباقة الحركات ساعة يخطرُ",70,"ر",1,0],["ونظرةُ الليث قبدٌ","لألفِ ألفِ غزال",71,"ل",1,0],["وَنَظَمتُ فيكَ مِنَ الثَناءِ قَلائِداً","سِترُ المُلوكِ بِمِثلِها يَتَجَمَّلُ",72,"ل",1,0],["وَنَظرَةٌ رُبَّما أَرسَلتُ رائِدَها","وَالطَرفُ يُنكِرُ مِن مَعناكَ ما عَرَفا",73,"ف",2,0],["وَنَظْمٍ يُنْسِيكَ شِعْرَ جَرِيرٍ","إِذَا أَنْتَ عَايَنْتَ مِنْهُ سُطُورَا",74,"ر",2,0],["وَنَظّ