{"poems":[[371,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58285","المنسرح"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"]],"verses":[["بِرذَونُنا اليَومَ ما بِهِ عُجُبُ","وَكُلُّ ما في حَديثِهِ عَجَبُ",0,"ب",1,1],["برذادهم ضنوا على إخوانهم","وعلى القمار تفوق كفهم المطر",1,"ر",1,0],["برذونُ سوء مولايَ يَعْرفُه","أعرجُ أعمى أصمٌّ ذو خرسِ",2,"س",1,0],["برذاذ دون سكب أوسياح","وسقى الخضراء حتى تمرعا",3,"ع",2,0]]}