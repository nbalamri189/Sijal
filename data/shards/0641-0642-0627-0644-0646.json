{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[53,"شجتك رسوم دارسات بثهمد","https://www.aldiwan.net/poem61881.html","الطويل"],[53,"عنفت شيخي أذان في مواثبة","https://www.aldiwan.net/poem65949.html","البسيط"],[30,"ألم ترني ناديت سلما ودونه","https://www.aldiwan.net/poem5650.html","الطويل"],[107,"تقدم فهذا مطلع الحق والهدى","https://www.aldiwan.net/poem44054.html","الطويل"],[53,"شجتْك رسومٌ دارسات بثَمْهَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27804",""],[136,"وأحوى في الملاحة ذي افتتان","https://www.aldiwan.net/poem54706.html","الوافر"],[173,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[264,"لك السعد أسعد يا صبا ما المشام","https://www.aldiwan.net/poem35738.html","الطويل"],[473,"وأهيف القد نال طرفي","https://www.aldiwan.net/poem60143.html","مخلع البسيط"],[473,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[564,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124369",""],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44738","الوافر"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28330","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59477","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114557","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75706","البسيط"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101296","السريع"],[4829,"التوابع والزوابع","https://www.poetsgate.com/ViewPoem.aspx?id=34253",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[5594,"بقيت غداة النّوى حائرا","https://www.poetsgate.com/ViewPoem.aspx?id=201060",""],[5701,"مغن من ذوات الريش غنّى","https://www.poetsgate.com/ViewPoem.aspx?id=164647",""],[5807,"عاتبتُ طيفَ الذي أهوى وقلتُ لتُ له","https://www.poetsgate.com/ViewPoem.aspx?id=187233",""]],"verses":[["فقال: نَبَّهتِ منِّي غافلاً فدَعي","هذي الدَّراهِمَ إذْ لا حَقَّ لي فيها",0,"ي",3,0],["فقال نعم ما إن تزالي قرينتي","إلى يوم بعث من ضريح وجلمدِ",1,"د",1,0],["فقال نحنُ ديوك الله عادتُنا","أنا نؤذِّنُ أحياناً ونقتتلُ",2,"ل",1,0],["فَقالَ نَعَم خُذهُ فَما أَقبَلَت بِهِ","يَمينِيَ حَتّى أَصرَخَتها شِمالِيا",3,"ي",2,0],["فقال نَعَمْ عُدْ يا غلامُ وَقُلْ له","أبا الفضلِ أبْشِرْ وانتظِرْ مَقدمي غدا",4,"د",2,0],["فقال نعم ما إن تزالي قرينتي","إلى يوم بعثي من ضريح وجلمدِ",5,"د",1,0],["فَقَال نَعَم بَنَانَ فَقُلتُ إني","لَمُشتَاقٌ أحِنُّ ِإلَى بَنَانِ",6,"ن",1,0],["فَقالَ نَعَم لَم آتِ حَتّى تَناوَحَت","عَلى يَومِهِ بِيضُ الخُدورِ بِأَلحانِ",7,"ن",1,0],["فَقالَ نَهجُكَ في ما تَدَّعي خَطَرٌ","عَلى الرَعِيَّةِ يَحدوها لِعِصيانِ",8,"ن",1,0],["فقال نعم أوقات سعدك أشرقت","ومنها تراءى البدر وهو تمام",9,"م",1,0],["فَقالَ نَل ما تَشاءُ مِنهُ","فَقُلتُ مَن لي بِبَعضِ هَذا",10,"ذ",2,0],["فَقالَ نَعَم عِندي سُلافَةُ كَرمَةٍ","كَوَجنَةِ مَعشوقِ الشَمائِلِ أَغيَدِ",11,"د",1,0],["فقالَ نَعمْ إني شُغفتُ بِحُبها","سَأجعلُها بيني وبينكُمُ وصلا",12,"ل",2,0],["فَقالَ نَفس رَضيت بِالذل","وَخَضَعت طالِبَة لِلأَكل",13,"ل",1,0],["فقال نديمي ليلة القدر هكذا","فقلت وما أدراك ما ليلة القدر",14,"ر",1,0],["فَقالَ نَعَم فَقالوا اَلحِقَنَّا","بِهِ قَد لاحَ لِلرائي صَباحُ",15,"ح",1,0],["فَقالَ نَحنُ وَبنو أَعمامي","نَشدّ حَزمَ العزمِ لِلإِقدامِ",16,"م",1,0],["فَقالَ نَعم جَرَينَ بِبَينِ سَلمى","وبَعضُ البَينِ مُنتَعِفٌ شَطُوفُ",17,"ف",1,0],["فقالَ نعم كنا قرينيْ محبةٍ","ففرقنا خطبٌ من البين فاجعُ",18,"ع",1,0],["فقال نعم عدولي عنه ظلمٌ","وإن الظلمَ من شيمِ النفوسِ",19,"س",1,0],["فَقالَ نَعَم وَأَنا الآنَ أُلف","بِرُمحِيَ تَهتَزُّ لِلفَتكِ كَفّي",20,"ي",1,0],["فقالَ نَعَم كُلَّ ذَا أَعلَمُ","وَعنكِ الحَقَيقَةَ لا أَكتُمُ",21,"م",1,0],["فقالَ نَسطورُ وَأَينَ يَلقى","أَخيلُ بِالإِغريقِ هَذا الرِفقا",22,"ق",2,0],["فقال نعم بالحق فهت وخير ما","يكون رسولٌ عالمٌ بالحقائق",23,"ق",1,0],["فَقالَ نوم عَراني ما اِستطعت له","دَفعا فأنشدته بَيتاً لذي لسن",24,"ن",1,0],["فقال نار قلت يا سيدي","بها فؤادي بات رهناً لديك",25,"ك",1,0],["فقال(ن)والذي ارسل محمد بالقلم مع قاف","بفاتحة الكتاب الى اله الناس مع عمّه",26,"م",2,0],["فقال نشدت رب البيت شخصا","له علم بمقتل ذا الغلام",27,"م",1,0],["فقال نبيٌ خير من وطئ الثرى","وأفضل من في الخير قد راح واغتدى",28,"د",2,0],["فقال نصيح من القوم لى","وقد كاد يقضى علىّ الغليل",29,"ل",1,0],["فقال نظمت في الاثنين روحي","أناجي في الرياض بها الحبيبا",30,"ب",2,0],["فقالَ: نِسْبَتُنا في الحال واحدةٌ","أنا الخيالُ ونارُ الشوق تَخييلُ",31,"ل",1,0]]}