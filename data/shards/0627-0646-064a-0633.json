html","مجزوء الرجز"],[353,"خذ في هوى الغيد عني أحسن الخبر","https://www.aldiwan.net/poem40343.html","البسيط"],[364,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[366,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[371,"ما بال همك لا يزيد","https://www.aldiwan.net/poem57503.html","مجزوء الكامل"],[380,"لو كنت تبصر حالتي","https://www.aldiwan.net/poem48774.html","مجزوء الكامل"],[380,"هذا الصباح قد ابتسم","https://www.aldiwan.net/poem48800.html","مجزوء الكامل"],[403,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[406,"إيها أبا حسن حللت من العلى","https://www.aldiwan.net/poem50131.html","الكامل"],[409,"إن يستروا وجه إحساني بكفرهم","https://www.aldiwan.net/poem32042.html","البسيط"],[409,"أنيسي في ليل القطيعة مشبهي","https://www.aldiwan.net/poem32243.html","الطويل"],[416,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[429,"إني سألت العلى هل في معالمها","https://www.aldiwan.net/poem40078.html","البسيط"],[429,"قمر بأفلاك الخدورِ","https://www.aldiwan.net/poem40082.html","مجزوء الكامل"],[437,"صب قتيل المقلتين","https://www.aldiwan.net/poem2556.html","مجزوء الكامل"],[439,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[441,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[461,"وبالقصر أريحي","https://www.aldiwan.net/poem15360.html","المضارع"],[461,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[470,"أقول لما التقينا وهي صادفة","https://www.aldiwan.net/poem4834.html","البسيط"],[479,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[505,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[505,"النسيان","https://www.aldiwan.net/poem42457.html","السريع"],[515,"أيها السيد الذي أنا عبده","https://www.aldiwan.net/poem12085.html","الخفيف"],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[551,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[564,"أمن هجر من تهواه قلبك واجد","https://www.aldiwan.net/poem838.html",""],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"]],"verses":[["أَنيسٍ بُلُقيانِ الحُروبِ كَأَنَّما","تَمَطَّت بِهِ في ناشِرِ النَقعِ أُمُّهُ",0,"م",2,0],["إِن يَستَعِض مِنّي فَلا","مَغبوطَةٌ أَعواضُهُ",1,"ض",2,0],["أَنيسُ سُروجِ الخَيلِ في كُلِّ ظُلمَةٍ","وَبَينَ الغَواني مَضجَعٌ مِنهُ بارِدُ",2,"د",1,0],["أَنيسِ اليَدينِ بِبَذلِ النَوالِ","إِذا اِحتَشَمَت راحَةُ الواهِبِ",3,"ب",1,0],["إن يَسْحَبِ النّاسُ أذيالَ الظّنونِ بِها","فلا يُخاطِرُ لَيثَ الغابَةِ السّيدُ",4,"د",1,0],["إِنّي سَمِعتُ بِعابِدينَ عُواءَهُ","فَعَجِبتُ كَيفَ يَسودُ مَن لا يَعقِلُ",5,"ل",1,0],["إِنّي سَأَلتُ العارِفينَ فَلَم أَفُز","مِنهُم عَلى عِرفانِهِم بِجَوابِ",6,"ب",1,0],["أَن يَستَجيبَ دُعاءَها","في حِفظِ صاحِبِكَ الأَخيرِ",7,"ر",1,0],["أَنّى سَلَكتَ سَمِعتَ أَد","عِيَةً لَهُ وَسَمِعتَ حَمدا",8,"د",2,0],["إِنّي سَأَبكي أَبا حَسّانَ نادِبَةً","ما زِلتُ في كُلِّ إِمساءٍ وَإِشراقِ",9,"ق",1,0],["أَنَّى سَكَتَّ وَكُنْتَ غِرِّيدَ الحِمَى","وَصَدَاكَ فِيهِ مِلْءُ كُلِّ مَكَانِ",10,"ن",1,0],["إِنّي سَأُخبِرُ عَن بَلاءِ مُجاشِعٍ","مَن كانَ بِالنَخَباتِ غَيرَ خَبيرِ",11,"ر",1,0],["إِنّي سَأَشكُرُ ما أَولَيتَ مِن حَسَنٍ","وَخَيرُ مَن نِلتَ مَعروفاً ذَوّ الشُكُرِ",12,"ر",1,0],["إِنّي سَيَأتيكُمُ وَالدارُ نازِحَةٌ","شُكري وَحُسنُ ثَناءِ الوَفدِ إِن رَجَعوا",13,"ع",3,0],["إِنّي سَأَنصُرُ عِرضي مِن سَراتِكُمُ","إِنَّ الحَماسَ نَسِيٌّ غَيرُ مَذكورِ",14,"ر",1,0],["إن يُسْلَى قلبي بنارٍ في محبَّتها","فلا وحقّ هواها لست بالسالي",15,"ي",1,0],["إن يسم سلطان مصرٍ في حمى بلدٍ","تزجف على أنَّها آذان حيطانِ",16,"ن",1,0],["إنِّي سألت ندى كفيك ريَّ صداً","وما سألت ندى كفيك طوفانا",17,"ن",2,0],["إني سألتُ ابن أبي طاهرٍ","لِمْ تنبح البدرَ إذا ما بَهَرْ",18,"ر",1,1],["إِنّي سَكَبتُ الخَمرَ حينَ سَكَبتُها","لِلناسِ لا لِلأَنجُمِ الزَهراءِ",19,"ا",2,0],["أَنيسُ الفَتى إِن غابَ عَنهُ أَنيسُهُ","وَأَنجُمُهُ إِن غابَتِ الأَنجُمُ الزُهرُ",20,"ر",1,0],["إِنّي سَكَتُّ وَما عَدِمتُ المَنطِقا","لَولا أَخوكَ سَبَقتُ فيكَ الأَسبَقا",21,"ق",2,1],["إِنّي سَأَحفَظُ في قَلبي جَميلَكُمُ","وَسَوفَ أَذكُرُهُ في العُسرِ وَاللينِ",22,"ن",1,0],["أَنِّي سأَظمأُ للحياةِ وأَحتسي","مِنْ نهْرِها المتوهِّجِ النَّشوانِ",23,"ن",1,0],["إِن يسلب القَومُ العدى","مُلكي وتسلمني الجُموعُ",24,"ع",1,0],["اني سأعرف ما هنا","ك من الحقيقة في جوابك",25,"ك",1,0],["اني ساحمل في فؤاد خافق","ذكراك ما مرت بي الازمان",26,"ن",1,0],["ان يسيروا من الثقافة في ضو","ء يقيهم معرة العثرات",27,"ت",1,0],["إني سئمت من الحياة وطولها","وسئمت ذكر اللَه والشيطان",28,"ن",1,0],["إن يسبقوك لفضل أو لمكرمة","فالسبق في الدهر لا في الفضل للأُوَل",29,"ل",1,0],["إن يستعينوا بالسباب فإنه","حولُ الضعيف وحيلة المخوار",30,"ر",1,0],["إِنْ يَسْرِ جَيْشُ الهُمُومِ مِنْكَ إلى","شَمْسِ مِنىً والمَقَامِ والحُجُبِ",31,"ب",1,0],["أَنّى سَبيلُ الغَيِّ مِنكَ وَقَد نَضا","مِن صِبغِ رَيعانِ الشَبيبَةِ ما نَضا",32,"ض",2,0],["إِن يُسافِر في صالِحٍ مِن فَعالٍ","غَلَطاً تَلفَهُ سَريعَ القُدومِ",33,"م",1,0],["إِنّي سَمِعتُ بِجَيشٍ أَنتَ قائِدُهُ","وَوَقعَةٍ رَفَعَت أَيّامُها مُضَرا",34,"ر",2,0],["إنْ يَسمَحُوا في الحِينِ أو يَتكَلَّفوا","كَرَمَ النُّفوس فقد خُلِقْتَ كَريما",35,"م",2,0],["إِنّي سَأَلتُ القَبرَ ما فَعَلَت","بَعدي وُجوهٌ فيكَ مُنعَفِرَه",36,"ر",2,1],["أَنيسُ الهوى لِلمَوْتِ حَوْلَيهِ وَحشَةٌ","فَأُسْدُ الشّرَى مَخذولَةٌ عَن خَواذِلِه",37,"ل",2,0],["إِن يَسَّرَ اللَهُ أَمراً أَثمَرَت مَعَهُ","مِن حَيثُ أَورَقَتِ الحاجاتُ وَالأَمَلُ",38,"ل",1,0],["إِن يُستَضَم بَعدَ الإِباءِ فَإِنَّهُ","قَد يُستَضامُ المُصعَبُ المَعقولُ",39,"ل",1,0],["إِنّي سَأَنثُرُ مِن لِساني لُؤلُؤاً","يَرِدُ العِراقَ نِظامُهُ مَعقودُ",40,"د",1,0],["إِنّي سَمِعتُ رِجالاً مِن ذَوي رَحِمي","هُمُ العَدُوُّ بِظَهرِ الغَيبِ قَد نَذَروا",41,"ر",3,0],["إن يُسألوا الهُون يُعطوهُ وإن طُرِدوا","عن موطن الذُلِّ ظنّوا أنهم ظُلموا",42,"م",3,0],["إِن يسجنِ الظُلمُ النُفوسَ فَعِندَهُ","بابُ الفِكاكِ وَعِندَها المِفتاحُ",43,"ح",1,0],["إِن يَسأَلوا غَيرَ ما تَرضى فَقَد جَهِلوا","أَنَّ اِعتِناقَ المَنايا دونَ ما سَأَلَوا",44,"ل",3,0],["إِنّي سَجَعتُ حَمامَةً بِمَديحِهِ","فَأَفادَني لَونَ الحَمامِ الأَورَقِ",45,"ق",1,0],["أَن يَسأَلَ القَومُ عَنّي أَهلَ مَعرِفَةٍ","فَلا يُخَبِّرُهُم عَن ثابِتٍ لاقِ",46,"ق",1,0],["إِنّي سَأَمنَحُكِ الهِجرانَ مُعتَزِلاً","مِن غَيرِ بُغضٍ لَعَلَّ الهَجرَ يُسلِيني",47,"ن",2,0],["إنْ يُسْأَلوا كَرَماً وَعِلْماً أُعْجَزُوا","بِبَدِيعِ أَجْوِبَةِ لتلكَ الأَسْئِلَهْ",48,"ل",2,0],["إِن يَسمَعوا شَرّاً تَوافَوا لَهُ","حِفظاً وَمِثلُ الشاعِرِ الراوِيَه",49,"و",3,0],["إني سأهبط فيه","وَهداً وأعلو يفاعا",50,"ع",2,0],["إني سأهجر بعد ال","ستين بغداد هجرا",50,"ر",2,0],["إنّي سألتُكَ بالذي","زانَ الإمامةَ بالوصِيّ",51,"ي",1,1],["إن يَسألوا عنه ففارسُ حَلْبة","لم يَخْلُ من وثْباتِه مضمارُ",52,"ر",1,0],["إنِّي سُررتُ على ما كانَ مِن وَصَبٍ","بما يُنَبِّئُ قَيسٌ عَنكَ أَخبارا",53,"ر",2,0],["إِنْ يَسُؤْنِي حِمَامُهُمْ فَعَزَائِي","أَنْ أَرَاهُم فِي النَّاسِ أَحْيَاءَ ذِكْرِ",54,"ر",1,0],["أَنِيسٍ عَلَى مَا بِهِ مِنْ أَسىً","شَجِيِّ التَّبَسُّمِ مَسْتَعْذَبِ",55,"ب",1,0],["إِنْ يَسْلَمِ المرءُ من قَتْلٍ ومِنْ مَرَضٍ","في لَذَّةِ العَيْشِ أبلاَهُ الجَدِيدانِ",56,"ن",1,0],["إني سكبتُ بها البيان على الطلا","في عزلتي وجعلتها مصباحي",57,"ح",2,0],["إِن يُسلَبوا ضافي الدُروعِ فَإِنَّهُم","كاسونَ مِن عَلَقٍ دُروعَ جِسادِ",58,"د",1,0],["إن يسألوا عني وقد راعهم","أن أبصروا هيكلي الموصدا",59,"د",2,0],["إنْ يسطَعِ الصبح قلنا الصبح أشبههَا","أو يسطع المسكُ قُلنا المسكُ حاكاها",60,"ا",3,0],["إن يسلطه على نجْم هَوَى","أو على أركان طوْد صَدَّعه",61,"ع",2,0],["إن يُسْألوا مالَهم، في السلم، ما بخلوا","أو يُسْألوا، في الوغى، أرواحَهم جادوا",62,"د",3,0],["إني ساقط لأنّ لأمّي","عند أغنى الرجال أعلى مكانه",63,"ن",2,0],["إني سيف لمن يحملني","خادم الأسياد ، كلّ الأزمنه",64,"ن",2,0],["ان يسلب القوم العدا","ملكي وتسلمني الجموع",65,"ع",1,0],["إن يسألو عنه ، ففارس حلبة","لم يخل من وثباته مضمار",66,"ر",1,0],["إن يُسْرِجِ المستعمرون خيولَهم","فلهم تِراتٌ جمّةٌ وذُحول",67,"ل",1,0],["إني سألتُ الدهرَ عن تخطيطهِ","عن سَطحه، عن عَرضه ، عن طُوله",68,"ل",2,0],["إني سمعت ، وما سمعت بمثله ،","نبأً يرن على مدى الآماد",69,"د",1,0],["إني سأحفظ في قلبي جميلكم","وسوف أذكره في العسر واللي",70,"ي",1,0],["إِنّي سَيَنهى عَنّي وَعيدَهُم","بيضٌ رِهابٌ وَمُجنَأٌ أُجُدُ",71,"د",1,0],["إن يستخف بما ألقى أخو عنفٍ","لا رفق فيه فإن البحر حنان",72,"ن",1,0],["إني سمعت في الدجى اصطخابا","كأن في إهابه ذئابا",73,"ب",2,0],["أن يسلب الدهر ما أولاه من هبة","فشيمة الدهر أعراء الفتى الكاسي",74,"ي",1,0],["أَنّي سَمِعتُ خَليلي","نَحوَ الرُصافَةِ رَنَّه",75,"ن",2,1],["إني سئمت هوى الدنيا وزهرتها","ومل قلبي ذرا روضاتها الأنف",76,"ف",1,0],["إِنِّي سأَلتُكَ بالنَّبِيِّ محمد","ووصيِّهِ الهادِي الأَمينِ المهتدي",77,"د",2,1],["إني سمعت بقوم أوطنوا هجرا","والدومتين وطابت عندهم هجر",78,"ر",1,0],["إنّي سمِعتُ نداءَها وسمِعتُ تَل","بيةَ الضياغمِ من بني عدنان",79,"ن",1,0],["إني سقيت الليالي","من هذه الأوهام",80,"م",1,0],["إني سأنسى ولكن كيف واتبعي","من نقمة هي عندي كل نعمائي",81,"ي",1,0],["إني سأنساك آه كيف يخطر لي","أني سأنساك يا حبي وبغضائي",81,"ي",1,0],["إني سممتك من يوم إلى سنة","بشائكٍ لدماء القلب فصّاد",82,"د",1,0],["إني سممتك فانظر كيف تهجرني","وكيف تخلف يوم الوصل ميعادي",82,"ي",1,0],["إني ساذكر ما حييت حجى","وسجية طبتي بها فرعا",83,"ع",2,0],["أَنيسَةِ الأَشجانِ في وُحدَتِه","وَبَعدَ أَن مَرَّت عَلَيهِ ثَوان",84,"ن",1,0],["إِنّي سَأَلتُ لكِ الأَيّامَ صافيةً","يا مَيُّ قولي معي بِاللَهِ آمينا",85,"ن",2,0],["إني سأَشغَل بالمَناقبِ فِكْرتي","حتى أَمدَّ لها عليك ظِلالا",86,"ل",2,0],["أَنيسُكَ فيهِ عِزَّةٌ وَشَهادَةٌ","فَنورٌ عَلى نورٍ وَأَجرٌ عَلى أَجرِ",87,"ر",1,0],["إِنِّي سَأَلْتُكَ بِخَيْرِ مُرْسَلِ","مُحَمَّدٍ نَبِيِّكَ الْمُكَمَّلِ",88,"ل",1,1],["إِنِّي سَأَلْتُكَ بِالرَّسُولِ","وَبِالْكِرَامِ الْكَاتِبِينْ",89,"ن",1,1],["إنّي سألتُ النَّاسَ بَعدَكَ كُلَّهُم","فَوَجَدتُ أسمَحَ مَن سَألتُ بَخيلا",90,"ل",2,0],["ان يستحلوا بالفراق دمى فَلي","يَومَ القيامة حجة لا تدحض",91,"ض",1,0],["إني سألتك ذاهلاً","والفكرُ في كفِّ الضياعْ",92,"ع",1,0],["إِن يَسرِقِ الفُقَهاءُ نَع","لي يَفعَلوا فِعلاً قَبيحاً",93,"ح",2,1],["إني سأبقى خالداً أبداً","ما دمت في شفتيك والفكر",94,"ر",1,0],["إني سلوت وكنت شاغلتي","وحديث إمسائي وإصباحي",95,"ي",1,0],["أنْ يستباحَ ذراعٌ من مواطننا","في سهلِ سيناءَ أو في حَزْنِ لبنانا",96,"ن",2,0],["إني سألتك بالهادي النبي الطاهر","محمد المصطفى الصابر الشاكر",97,"ر",1,0],["إِن يستزركَ لحاجةٍ عرضت له","فَكما اِستزارَ أَخو السقام الآسي",98,"ي",1,0],["أَنيسة الطَبع سَمت","بِطبعها المُستَلطفِ",99,"ف",1,0],["إِن يَسمح الدَهر لي يَوماً بِرؤيَتِها","لَم يَبقَ لِلدَهر ذَنب غَير مُغتَفرِ",100,"ر",1,0],["إنّي سمَحْتُ له بقلبي طائعاً","يا لائِمينَ فأقصِروا وأَطِيلوا",101,"ل",3,0],["أَنّى سَرَيتَ وَبَينَنا ما بَينَنا","لِلَّيلَةِ السَوداءِ وَالسَوّادَةِ",102,"ه",1,0],["إني سرقتُ إليكَ نف","سي والخطوبُ معي شهودُ",103,"د",1,0],["إِن يَسقِني سابِقاً","ماءَ الحَياة يَد التَلاقي",104,"ق",2,0],["أَني سَامزج صَرفَها","مِن دَمع أَجفاني بِدَم",105,"م",1,0],["إني سأرجع طيبة أو أنتحي","ثغراً وإلا فالأمير أوافي",106,"ي",1,0],["أَنّى سحا بك ذا الزَمان وَإِنَّهُ","لمبخِّلٍ بِالكامِلِ ابن الكامِلِ",107,"ل",1,0],["إن يستُروا وجْهَ إحساني بكُفرهِمُ","فالشَّمسُ أدنى سحابٍ عَنَّ يَستُرُها",108,"ه",2,1],["أنِيسِيَ في ليلِ القطيعةِ مُشْبِهي","نُحولاً وتَسهيداً ولوناً وأدْمُعَا",109,"ع",2,1],["إنْ يَسُؤْني الدَّهر في أحداثه","سرَّني عبد الغنيّ الدَّهر طولا",110,"ل",2,0],["إني سألت العلى هل في معالمها","للعلم حسنٌ وللآداب تفنينُ",111,"ن",1,1],["أني سمع مسلسلاً","عن كل ذي أدبٍ شهير",112,"ر",1,0],["إنّي سأحرمُ جودكم","وأعود صغر الراحتين",113,"ن",1,0],["أَنيسُ القُلُوبِ فِي الصدورِ وَلَمْ يَكُنْ","لِيُوحِشَ مَثْوَاهُ الفَرَاقِدَ والجَدْيا",114,"ي",2,0],["أنيس المرء طاعته","مدى ما عاش للرب",115,"ب",1,0],["أنيسٌ إِلى المعالي","وعن عارِها نَوارُ",116,"ر",1,0],["أنيسٌ بالمنَاقِب والمَعالي","وعند العار وَحْشِيٌّ نَوارُ",117,"ر",1,0],["إِنّي سَأَمنَحُكِ الهجرانَ مُعتَزِماً","مِن غَيرِ بُغضٍ لَعَلَّ الهَجرَ يُسليني",118,"ي",1,0],["إني سجنت فزدتني شرفا فلا","تبكي بكاؤك قد يجر بكائي",119,"ا",2,0],["إنِّي سئمتُ البقاءَ في أرْ","ضٍ ملءُ أنفاسِها الذنوبُ",120,"ب",1,0],["إنّي سألتُ اللهَ أنْ يغفرَ","فما عداك أنتِ لا ذنبَ لِيْ",121,"ي",1,0],["إن يسد يافعاً فذلك عمر","ساد في مثله أبوه وجده",122,"د",2,0],["إن يستجدوا على أبلي