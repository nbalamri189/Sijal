{"poems":[[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[53,"سأنظر نحو دارك حين أخشى","https://www.aldiwan.net/poem61955.html","الوافر"],[53,"سليمان مفسدة المملكه","https://www.aldiwan.net/poem65768.html","المتقارب"],[107,"يا أيها القوم ماذا في حقائبكم","https://www.aldiwan.net/poem43072.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[107,"يا أيها القوم ماذا في حقائبكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54986&r=&rc=156",""],[257,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206064","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204640","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145046","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117912","الكامل"],[4701,"ثلاثون عامًا تمرُّ الظباءْ","https://www.poetsgate.com/ViewPoem.aspx?id=45009",""],[5638,"اخسأ ولا تطغى أيا سلمي","https://www.poetsgate.com/ViewPoem.aspx?id=198250",""],[5782,"أوزان وشطآن","https://www.poetsgate.com/ViewPoem.aspx?id=185767",""]],"verses":[["سَيَترُكُ زيقٌ صِهرَ آلِ مُجاشِعٍ","وَيَمنَعُ زيقٌ ما أَرادَ لِيَمنَعا",0,"ع",2,0],["سيتْلَفُ في الهوى وجداً فؤادي","ولو كان الفؤادُ من الحديدِ",1,"د",1,0],["سَيُتْبِعُها طبرِسْتانَها","تَصَبَّر لذاك فما أوشكَهْ",2,"ك",2,0],["سَيَتبَعُ الجِدَّ مَن لا يَستَفيدُ لَهُ","وَيَعرِفُ الحَقَّ مَن يَهذي وَيَختَلِقُ",3,"ق",1,0],["سَيَتْلُوها فَيَطْرَبُ ذَاكِرُوَها","كَمَا يَتْلونَ آيَاتِ الكِتَابِ",4,"ب",1,0],["سيتبع الجد من لا يستقيد له","ويعرف الحق من يهذي ويختلق",5,"ق",1,0],["سَيَتَضيكُم بِضَربٍ عِند أَهوَنِه","أَلبيضُ كالبيضِ والأدراع كالحُلَلِ",6,"ل",1,0],["سيتركها أن سلم الله أمرها","بنو الخلحانيات وهي رتوع",7,"ع",1,1],["سيتفق الورى في الدين يوما","إذا دانوا بتزكية الضمير",8,"ر",1,1],["سيتلو على الأجيال شكرك مومئا","إليك وأنباء الورى سور تتلى",9,"ل",2,0],["سيتوب عمّا قد جنى متندّماً","حيث اجترى متجاوزاً أقصى الحدود",10,"د",1,0],["سيتَّسع الجرح يا صاحبي","إلى أن يضيق عليه الفضاء",11,"ا",2,0],["سَيَتِمُّ نُورُ اللهِ فَانْتَظِرَنْ","غَضَبًا يَثُورُ يُبِيدُ كَالْحُمَمِ",12,"م",1,0],["سيتم تجديدُ البحور أو اكتشا","فُ سوائها ونفوزُ بالخَزَّانِ",13,"ن",1,0]]}