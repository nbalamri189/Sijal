{"poems":[[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[72,"رب عيش واصلتنا فيه غيد","https://www.aldiwan.net/poem18601.html","الرمل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[72,"لهفي على فاتر الأجفان منعطف","https://www.aldiwan.net/poem20463.html","البسيط"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[51,"يا أيها النفر الذين تعجبوا","https://www.aldiwan.net/poem65464.html","الكامل"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"حبستنا السماء حبسا كريما","https://www.aldiwan.net/poem66305.html","الخفيف"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[89,"أذكى تعصب ثلة جهال","https://www.aldiwan.net/poem44909.html","الكامل"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[45,"إما ألم فبعد فرط تجنب","https://www.aldiwan.net/poem11055.html","الكامل"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[66,"عبث النسيم بقده فتأودا","https://www.aldiwan.net/poem39659.html","الكامل"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[97,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[74,"قل للقبيح الفعال يا حسنا","https://www.aldiwan.net/poem13263.html","المنسرح"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85603","البسيط"],[81,"","https://poetry.dctabudhabi.ae/diwan/poem/11439","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12534","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43855","البسيط"],[77,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[108,"الطايش","https://www.poetsgate.com/ViewPoem.aspx?id=8376",""],[160,"يا من هو الملجأ والمعقل","https://www.aldiwan.net/poem58721.html","السريع"],[160,"أبشر ببشرى بابها قد فتحا","https://www.aldiwan.net/poem58772.html","الرجز"],[199,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[204,"يا قمرا صار حسنه علما","https://www.aldiwan.net/poem53175.html","المنسرح"],[210,"لطائر البشر بالأفراح تغريد","https://www.aldiwan.net/poem13312.html","البسيط"],[210,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[229,"لما أمت إذ بعدت عند انطلاقك","https://www.aldiwan.net/poem50930.html","الخفيف"],[239,"في ليلة صبغ الظلام أديمها","https://www.aldiwan.net/poem23837.html","الكامل"],[254,"أمل","https://www.aldiwan.net/poem24947.html","مجزوء الرمل"],[261,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[282,"من قد من قد قلبي يخجل البان","https://www.aldiwan.net/poem32339.html","البسيط"],[297,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[297,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[320,"الحب ما أقساه ليس يطاق","https://www.aldiwan.net/poem61735.html","الكامل"],[328,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[349,"بي مبغض لي على محبته","https://www.aldiwan.net/poem15787.html","المنسرح"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[391,"بالله يا طالب التقوى ونيل القبول","https://www.aldiwan.net/poem54540.html","عموديه"],[391,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[403,"هو الهوى فاصطبر فيه لما يجب","https://www.aldiwan.net/poem34153.html","البسيط"],[410,"قاسيت شدة أيامي فما ظفرت","https://www.aldiwan.net/poem67477.html","البسيط"],[429,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[439,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[443,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[461,"تخشى الصوارم بأسه","https://www.aldiwan.net/poem16138.html","مجزوء الكامل"],[479,"زاد المحب صبابة","https://www.aldiwan.net/poem37024.html","مجزوء الكامل"],[514,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[538,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[563,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[586,"قاسيت بك الغرام والوجد سنين","https://www.aldiwan.net/poem17825.html","الدوبيت"]],"verses":[["قَاسُوا الحُسَيْنَ إِلى غَيْرِ الحُسَيْنِ فَلَمْ","تَصْدُقْ فِرَاسَتُهُمْ فِيهِ وَلَمْ تُصِبِ",0,"ب",1,0],["قَاسَمَتْكُمْ مِصْرُ الرَّزِيئَةِ فِيهِ","وَعَلَى قَدْرِهَا مَدَى الاِقْتِسَامِ",1,"م",1,0],["قاسموني خطَّتيها عَنَتاً","فيهم الحلوى وفي قلبي الوقود",2,"د",1,0],["قاسي الجوانح لين الأعطاف","أهواه في الحالين غصن خلاف",3,"ف",1,1],["قاست ذوائبه بالليل حسّده","حتى نضى فإذا بالفرقِ قد بانا",4,"ن",2,0],["قاس الملابِسَ والحُليَّ بوجهه","فرأى محاسن وجهه فتسلَّبا",5,"ب",2,0],["قَاسِمُ يا قَاسِمَ أمْوالِهِ","لا زِلْتَ بَحْراً غير مَنْزوحِ",6,"ح",1,0],["قاسيْتُ بعدَك لا قاسيَت مِثْلَهُما","نَهارَ شكْوى يُبَاري ليْلَ تَسْهِيدِ",7,"د",1,0],["قاسم الخير أمْض أمرَكَ في أمْ","ري فما جرَّبَ الندى تبليدَكْ",8,"ك",1,0],["قاسيتُ منها ليلةً مُرّةً","وخُطةً أيتما خُطه",9,"ط",2,0],["قاسيت منه ليلة مذكورة","لولا دفاع الله لم تتكشَّف",10,"ف",1,0],["قاسمٌ قاسمُ العطايا الصفايا","زادهُ اللَّه بالعلا استقلالا",11,"ل",2,0],["قاسمٍ قاسمِ العطايا الذي حا","ز العُلى وحْدَهُ بغيرِ قسيمِ",12,"م",1,0],["قاسيت في البدء آلاما مبرحة","لكن لسانك منها ما شكا الما",13,"م",2,0],["قاسيت اهوال الليالي جمة","يالليالي ثم للاهوال",14,"ل",1,0],["قاسَيتُهُ حَتّى اِنجَلى بِالصُبحِ عَن","سِرّي المَصونِ وَمَدمَعي المَهتوكِ",15,"ك",1,0],["قاسَمَتكَ المَنونُ شَخصَينِ جَوراً","جَعَلَ القِسمُ نَفسَهُ فيكَ عَدلا",16,"ل",2,0],["قاسَمتَها تَلَّ بِطريقٍ فَكانَ لَها","أَبطالُها وَلَكَ الأَطفالُ وَالحُرَمُ",17,"م",1,0],["قاسي الضَميرِ عَلى التِلادِ كَأَنَّما","يَغدو عَلى تَفريقِ مالٍ مُذنِبِ",18,"ب",1,0],["قاسَمتَهُ أَخلاقَهُ وَهيَ الرَدى","لِلمُعتَدي وَهِيَ النَدى لِلمُعتَفي",19,"ف",2,0],["قاسوكَ بِالغُصنِ الرَطيبِ جَهالَةً","تَاللَهِ قَد ظَلَمَ المُشَبِّهُ وَاِعتَدى",20,"د",2,0],["قاسمتها أشجانها","ووفيت ما شاءَ الوفاء",21,"ا",2,0],["قاسمتني الورقاء أحزان قلبي","وشجاه وغَرَّدَت حين غرّد",22,"د",1,0],["قاسى حَياةَ الكَلبِ إِلّا أَنَّهُ","قَد ماتَ صَبراً ميتَةَ الرِئبالِ",23,"ل",1,0],["قاسَمتُ فيهِ الرُزءَ أَكرَمَ صاحِبٍ","فَمَضى يَنوءُ بِأَثقَلِ الأَعباءِ",24,"ا",2,0],["قاسَمَني طَرفُكَ الضَنى أَفَلا","قاسَمَ جَفَنَيَّ ذَلِكَ الوَسَنا",25,"ن",2,0],["قاسِ الهُمومَ تَنَل بِها نُجُحا","وَاللَيلَ إِنَّ وَراءَهُ صُبُحا",26,"ح",2,1],["قاسيت عدواناً من ال","متغطرسين فكنت جلدا",27,"د",2,0],["قاس تخال فؤاده","حجراً من الأحجار صلدا",27,"د",2,0],["قاسيت ليلاً طويلاً بالهموم دجا","حتى أَتى الصبح بالأفراح في العقب",28,"ب",1,0],["قاسي الَّذي بَينَ الجَوانِحِ فَظُّهُ","لَدنُ الَّذي بَينَ البُرودِ رَطيبُهُ",29,"ب",2,0],["قَاسَ العَتِيدَ عَلَى الْعَهِيدِ لِوَهْمِهِ","أَنَّ الجُمُودَ بَعِيدُ الاسْتِئْصالِ",30,"ل",1,0],["قاسِميني هَذا البَلاءَ وَإِلّا","فاِجعَلي لي مِنَ السُلُوِّ نَصيبا",31,"ب",2,0],["قاسَيتُ مِن عِلَّتَيكَ ما قَد","رَقَّ لَهُ المَوتُ وَهوَ قاسِ",32,"س",1,1],["قاسَمْتُكَ الشَّجْو المُقاسَمة َ التي","صارتْ بِخالصِ ما مَحَضْتُك مَذْهبا",33,"ب",2,0],["قاسٍ تحمل وقع كل عظيمة","جللٍ تحطُ البدر في عليائه",34,"ا",3,0],["قاسي ولو أتضايقه.؟ ماقال أوووه","وقساوته.؟ أأأأأخر دلع مياعته",35,"ت",2,0],["قاسوكَ بالبحرِ فكذبتهم","البحرُ لا يبذلُ ما تبذلُ",36,"ل",1,0],["قاسوا الذي بين الثريا والثرى","وميزوا بين العشاء والضحى",37,"ح",2,0],["قاسوكِ يا شمسَ الضُّحى","بالبدرِ ظلماً والهلالِ",38,"ل",1,1],["قاسمت بدرَ الدجى محاسنَه","وازددتَ طَرفاً ومبسماً وفما",39,"م",2,0],["قاسوك بالغير من جهل فقلت لهم","شتان في الفضل معدوم وموجود",40,"د",1,0],["قاس بالوصل به ملل","بدنيه الصب فيبعده",41,"د",2,0],["قاسَمَتْني النّوى وصالكَ حتّى","لكأنّ الفراقَ مِن عُشّاقك",42,"ك",1,0],["قاسوه يا لضلالهم بنفوسهم","كالنمل حين تظلها الاطواد",43,"د",1,0],["قاسميني دمع عيني","شِئْتِ أو لا، فاتركيني",44,"ن",2,0],["قاسمتها الصبر في تكابده","وقاسمتني الخفاء في جسدي",45,"د",2,0],["قاسٍ عَلى عاشِقَيهِ ساخِطٌ فَمَتى","تَكونُ لي رَحمَةٌ مِنهُ وَرِضوانُ",46,"ن",1,0],["قاسوه بالبَحر وَالتَفريقُ متَّضحٌ","أَينَ الأُجاجُ من المستَعذَب الشَبِمِ",47,"م",1,0],["قاسوه بالبَدرِ في ظَلماء طُرَّته","وَالفَرقُ يَظهَرُ مِثلَ الصبح واضحهُ",48,"ح",2,0],["قاسٍ عَلَيَّ فَكَيفَ يَسعَدُ صَبُّهُم","وَلَكُم أَقولُ وَقَد تَبَدَّلَ قُربُهُم",49,"م",1,0],["قاسموني مجدي وظنّوا نعيمي","خالداً غير مؤذنٍ بضياع",50,"ع",1,0],["قاسٍ لِشَكوايَ لا يَلينُ وَلا","يَثنيهِ عَن جَورِهِ مُعَنِّفُه",51,"ف",2,0],["قاسم طول دهره القول ما بي","ن جفاء للصب واستجفاء",52,"ا",2,0],["قاسي وناسى تقضي وقته في الذهول","يا رب نسألك توبه صادقه والحلول",53,"ل",1,0],["قاسي وناسي غافل وساهي","وإن وعظته جاب جملة أعذار",54,"ر",1,0],["قاس على كل من رقت مدامعه","مصدق كل واش قوله كذب",55,"ب",1,0],["قاسَيتُ شِدَّةَ أَيّامي فَما ظَفَرَت","يَدايَ مِنها بِصابٍ وَلا عَسَلِ",56,"ل",1,1],["قاسوك بالبدر من جهل فقيل لهم","من أين للبدر كفٌّ فاض بالكرمِ",57,"م",1,0],["قاسيتُهُنَّ غوارباً كَغَياهبٍ","وَسريتُهُنَّ غياهباً كَغواربِ",58,"ب",1,0],["قاسوا الفضاء وقربوا ال","أقصى وقد فشل المكابر",59,"ر",1,0],["قاسٍ إذا اشْتَجَرَ الرِّماحُ","وعند نُصْرَتِهِ رَحيمُ",60,"م",1,0],["قاسى العذاب نجيها","للّه يا قيساه",61,"ا",2,0],["قاسَمْتُه الوردَ لَونَيهِ فأحمرُه","في وجنتَيْهِ وفي خدَّيَّ أصفَرُهُ",62,"ر",2,0],["قاسَ الأنامُ به الغمامَ وما يروا","أنّ الغَمامَ بجُودِه يتسرّجُ",63,"ج",1,0],["قاسِ على الهِجران ذي إصرارِ","نِك ما قَدرتَ بِدونِ ما حَرَجٍ ولا",64,"ل",2,0],["قاسَت بِعِطفٍ خِفافٍ","حِملانَ رِدف ثِقالِ",65,"ل",1,0],["قاسَيْتُ بِكَ الغَرامَ والوَجْدَ سِنينْ","ما بَيْنَ بُكاءٍ وَحَنين وأَنينْ",66,"ن",1,1]]}