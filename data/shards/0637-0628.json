ع","https://www.aldiwan.net/poem3521.html","عموديه"],[501,"كانوا ربيعا للقلوب","https://www.aldiwan.net/poem37766.html","مجزوء الوافر"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[501,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[515,"خر الورى حيدري عم نائله","https://www.aldiwan.net/poem20836.html","البسيط"],[515,"فخر الورى ذو المعالي الباهرات علي","https://www.aldiwan.net/poem20842.html","البسيط"],[515,"فخر الورى","https://www.aldiwan.net/poem20845.html","مجزوء الرجز"],[515,"فخر الورى حيدري عم نائله","https://www.aldiwan.net/poem20847.html","البسيط"],[515,"فخر الورى","https://www.aldiwan.net/poem20850.html","مجزوء الرجز"],[515,"فخر الورى حيدري عم نائله","https://www.aldiwan.net/poem20851.html","البسيط"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[516,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[530,"طبل شيطاني ومزمار الهوى","https://www.aldiwan.net/poem37357.html","السريع"],[539,"آه بشرى لنا بعودة باشا","https://www.aldiwan.net/poem48295.html","عموديه"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[541,"وعميمة قد سقت فيها عائرا","https://www.aldiwan.net/poem56670.html","الكامل"],[552,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[559,"تستر السر بإفشائه","https://www.aldiwan.net/poem33527.html","السريع"],[559,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[559,"ظهرت لي يا غيب يا مطلق","https://www.aldiwan.net/poem34302.html","السريع"],[559,"كيف يا قوم يوصف المخلوق","https://www.aldiwan.net/poem34317.html","الخفيف"],[559,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"],[559,"بنغمة العود لاح لي أثر","https://www.aldiwan.net/poem34531.html","المنسرح"],[559,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[559,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[563,"ذكر النقا فاهتز من ذكر النقا","https://www.aldiwan.net/poem52720.html","الكامل"],[563,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[563,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[563,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[563,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[563,"نزع القريض إلى حمى نقاشه","https://www.aldiwan.net/poem52908.html","الكامل"],[563,"سقاني حبه كأسا دهاقا","https://www.aldiwan.net/poem52982.html","الوافر"],[565,"كم ذا التجافي يا رشا","https://www.aldiwan.net/poem859.html",""],[568,"الحمد لله قد وجدت أخا","https://www.aldiwan.net/poem69721.html","المنسرح"],[568,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[576,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[586,"الصفو من ماء العنب","https://www.aldiwan.net/poem1563.html",""],[588,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"]],"verses":[["طِبتُ بِهِ نَفساً وَمَن لَم يَجِد","إِلّا الرَدى أَذعَنَ وَاِستَقبَلا",0,"ل",2,0],["طُبِعتُم نُصولاً لِلعَدوِّ قَواطِعاً","وَلَيسَ عَلَيكُم لِلضِرابِ شِكاكُ",1,"ك",1,0],["طِبَّ الْمَسِيحِ بَعَثْت يَا ابْنَ سمِيّهِ","فِي رُقْيَةٍ خَفِيَتْ عَنْ الأَذْهَانِ",2,"ن",1,0],["طَبَقٌ منْ أزاهِرٍ رائِقاتٍ","سقَطَتْ فوْقَهُ منَ الخَتْمِ ورْدَهْ",3,"ه",1,0],["طِبُّ المَسيحِ لدَيّ منْهُ مَسْحَةٌ","أيُقِيمُ دَاءٌ كلّما داوَيْتُهُ",4,"ت",2,0],["طَبَعَ الظُلمُ عَلى أَقفالِها","بِلَظاهُ خاتَماً مِن رَهَبِ",5,"ب",1,0],["طَبِيبٍ بِالمَعَارِفِ لاَ يُضَاهَى","أدِيبٍ غَيْرِ خَالٍ مِنْ مُجُونِ",6,"ن",1,0],["طِبْتَ نَفْساً لِحَدِي","ثٍ سُقْتُهُ مُعْتَذِرا",7,"ر",2,0],["طَبَعَتْهُ شَمْسُ الصَّعِيدِ وَلَكِنْ","لَمْ يَطُلْ مِنْهُ مَحْمِلُ الصَّمْصَامِ",8,"م",1,0],["طبائعهم شتّى على أن بينهم","كريماً تُواليه ووغداً تُجانبه",9,"ب",2,0],["طُبِعت على حبّ العَلاء فسعيُها","للمكْرُمات يُعَدّ من دَيْدانها",10,"ن",3,0],["طبخت بنار خدوده في كفِّه","فقبلتها وشربت منه حلالها",11,"ل",3,0],["طِبْتَ خِلّاً فاسلمْ على نَكد الده","ر وعش آمناً من الأَسْواءِ",12,"ا",2,0],["طَبٌّ بأحكامِ الهجاءِ مُبصِّرٌ","أهلَ السَّفاهِ بزَيغهِ وصوابِهِ",13,"ب",2,0],["طبخوهُ ثم أتوا به قد أُبرِمتْ","أوْتارُهُ لمنادفٍ وبرابِطِ",14,"ط",1,0],["طبيعةً لا تزالُ تُخْلِصُها ال","أيَّامُ والتّبر عِنْد مُنْسبكهْ",15,"ك",2,0],["طباهجةٌ كأعرافِ الديوكِ","تروقُ العين من شرط الملُوكِ",16,"ك",1,1],["طبيعةُ بُخْلٍ أكَّدتْها خليقةٌ","تخلَّقْتُها خوفَ احتياجي إلى مثلي",17,"ل",2,0],["طبيبٌ كم شفاني من سَقامٍ","وما جدحَ الدواءَ ولا رقاني",18,"ن",2,0],["طَبَعتهُ لُجِّيّا فَذابَت صَفحَةٌ","مِنهُ وَلَو جَمُدَت لَكانَ مُهَنَّدا",19,"د",2,0],["طب بالحياة ومالها من ظاهر","يلهيك منه عن الخفى الزخرف",20,"ف",1,0],["طبنا بوصلك بُرهةً واليوم قد","وقع الفراق فقلت يا نفس اشجعي",21,"ع",2,0],["طُبِعَت مِنَ السُمِّ الحَياةُ طَعامُها","وَشَرابُها وَهَوائُها المُتَنَشَّقُ",22,"ق",1,0],["طِباقاً في العُلى مُتَفاوِتاتِ","سَما بَرٌّ بِها وَاِنحَطَّ بَرُّ",23,"ر",1,0],["طُبِعَ الحَديدُ فَكانَ مِن أَجناسِهِ","وَعَلِيٌّ المَطبوعُ مِن آبائِهِ",24,"ا",3,0],["طَبَت فُرسانَنا وَالخَيلَ حَتّى","خَشيتُ وَإِن كَرُمنَ مِنَ الحِرانِ",25,"ن",1,0],["طبيعة خامسة ولّدت","فيها انبساط الغائص الذائبِ",26,"ب",1,0],["طبيعتنا التي لا ظل فيها","لها من نسل أربعة تتاجُ",27,"ج",1,1],["طبعي البرودة واليبوسة ولّدت","مني الهموم ومني الأفراحُ",28,"ح",1,0],["طبائع من واحد أربع","قد طال فيها القال والقيلُ",29,"ل",1,0],["طبقات نارك لا تلّهب","ها ولا إجمادُها",30,"د",3,0],["طُبِعَتْ مضاربُه الرِّقاقُ غوامِضَاً","فكأنها مرهومَةٌ لم تُطْبَعِ",31,"ع",1,0],["طُبِعْتَ على حلمٍ فلو شئتَ غيرَهُ","غُلِبتَ عليه والتكلُّفُ مغلوبُ",32,"ب",1,0],["طِبتُ نَفساً عَنِ الشَبابِ وَما سُ","وِّدَ مِن صِبغِ بُردِهِ الفَضفاضِ",33,"ض",1,0],["طُبِعتَ عَلى الإِسلامِ وَالحَزمِ وَالنَدى","أَلا إِنَّما تُبدي الأُمورَ الطَبائِعُ",34,"ع",1,0],["طبق فيه خدود","وقدود ونهود",35,"د",1,0],["طبعت على حب الوصي ولم يكن","لينقل مطبوع الهوى عن طباعه",36,"ع",2,0],["طَباها ضَحاءٌ أَو خَلاءٌ فَخالَفَت","إِلَيهِ السِباعُ في كِناسٍ وَمَرقَدِ",37,"د",1,0],["طِبتُم حَديثاً كَما قَد طابَ أَوَّلُكُم","وَالشَوكُ لا يُجتَنى مِن فَرعِهِ العِنَبُ",38,"ب",1,0],["طِبتُ عَيشاً لَمّا رَأَيتُ يَدَ الصُب","حِ لِدُرِّ النُجومِ ذاتَ اِلتِقاطِ",39,"ط",1,0],["طَبَّ هَذا الزَمانَ وَهوَ جَسيمٌ","قَصَّرَت دونَهُ يَدا بِقِراطِ",39,"ط",1,0],["طُبِعَت راحَتاهُ مِن جَوهَرِ الجو","دِ وَلَيسَ المَعطِيُّ كَالمُتَعاطي",39,"ط",2,0],["طُبِعَ الأَنامُ عَلى الخِلافِ وَجودُهُ","في الناسِ مَسأَلَةٌ بِغَيرِ خِلافِ",40,"ف",1,0],["طَبَّقَ الأَفاقَ حَتّى خِلتُهُ","مِن نَدى أَيدي عَليٍّ قَد نَشا",41,"ش",2,0],["طبعُه الجودُ فلما هتفت","مصرُ تدعوه تناهى في الكرم",42,"م",1,0],["طَبَقاتُ شَحمِكَ لَيسَ يَخفى أَنَّها","لَم يَبنِها آءٌ وَلا تَنّومُ",43,"م",1,0],["طَبَلَت رَبيعَ رَبيعَةَ المُهمي لَها","فَوَرَدنَ ظِلَّ رَبيعَةَ المَمدودا",44,"د",2,0],["طَبَعنا لَهُم سَيفاً فَكُنّا لَحَدِّهِ","ضَرائِبَ عَن أَيمانِهِم وَالسَواعِدِ",45,"د",1,0],["طَبَقَاتٌ فِي جَوْفِهَا حُجُرَاتٌ","ضُمِّنَتْ كُلَّ حِكْمَةٍ وَبَيَانِ",46,"ن",1,0],["طَبَائِعُ لا تُغبُّ مُرَدّدَاتٍ","كَمَا تَعْرَى وَتَشْتَمِلُ الْحُقُولُ",47,"ل",1,0],["طبيبٌ القبلةُ في خدِّهِ","من المعاصي خيفةَ النارِ",48,"ر",1,0],["طباعُ عفيفٍ لا يرى حبَّ منصبٍ","ولكنْ تشفِّي حاسديهِ بهِ مرُّ",49,"ر",1,0],["طَبَعَت عَلى النُوّارِ بيضَ دَراهِمٍ","مَدَّت إِلَيكَ بِها بَنانُ غُصونِ",50,"ن",1,0],["طِبٌّ من الوحْي المفصَّلِ آخِذٌ","بِمجامعِ الأَرواحِ والأجسادِ",51,"د",1,0],["طبيبَ النّيلِ هل للنِّيلِ شافٍ","وهل للدّاءِ بعدَك من طبيبِ",52,"ب",1,0],["طِبُّ الهُدى الشّافِي وأعجبُ ما أرى","طِبٌّ تَصِحُّ به النُّفوسُ وتَسْقُمُ",53,"م",1,0],["طَبَّقَ الأَرضَ ذِكرُهُ فَلَهُ في","كُلِّ أُفقٍ مَعَ الهَواءِ اِنتِشارُ",54,"ر",1,0],["طَباهُنَّ حَتّى أَطفَلَ اللَيلُ دونَها","تَفاطيرُ وَسمِيٍّ رَواءٍ جُذورُها",55,"ر",3,0],["طَبيبُ الكَفِّ لا يَذبُ","لُ في قَبضَتِهِ عِرقُ",56,"ق",1,0],["طَبعي كَطَبعِ المُشتَري ما فيهِ مِن","شَوبِ فَهَل مِن مُشتَرٍ لِلمُشتَري",57,"ر",2,0],["طَبَعَتْ رَأْسُهُ دَماً وَبِسَاطِي","جلْدَةً أَوْ حَسِبتُهُ جُلَّنَارَهْ",58,"ر",2,0],["طَبٌّ أرِيبٌ بأيّامِ الحروب زعي","مٌ بالخُطوب عليمٌ بالمآتيِّ",59,"