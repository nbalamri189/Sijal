"https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43645","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43843","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[106,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[106,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[77,"ذكروا العهود فهاج من أشجاني","https://www.poetsgate.com/ViewPoem.aspx?id=34168",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"]],"verses":[["طِبتُ بِهِ نَفساً وَمَن لَم يَجِد","إِلّا الرَدى أَذعَنَ وَاِستَقبَلا",0,"ل",2,0],["طُبِعتُم نُصولاً لِلعَدوِّ قَواطِعاً","وَلَيسَ عَلَيكُم لِلضِرابِ شِكاكُ",1,"ك",1,0],["طِبَّ الْمَسِيحِ بَعَثْت يَا ابْنَ سمِيّهِ","فِي رُقْيَةٍ خَفِيَتْ عَنْ الأَذْهَانِ",2,"ن",1,0],["طَبَقٌ منْ أزاهِرٍ رائِقاتٍ","سقَطَتْ فوْقَهُ منَ الخَتْمِ ورْدَهْ",3,"ه",1,0],["طِبُّ المَسيحِ لدَيّ منْهُ مَسْحَةٌ","أيُقِيمُ دَاءٌ كلّما داوَيْتُهُ",4,"ت",2,0],["طَبَعَ الظُلمُ عَلى أَقفالِها","بِلَظاهُ خاتَماً مِن رَهَبِ",5,"ب",1,0],["طَبِيبٍ بِالمَعَارِفِ لاَ يُضَاهَى","أدِيبٍ غَيْرِ خَالٍ مِنْ مُجُونِ",6,"ن",1,0],["طِبْتَ نَفْساً لِحَدِي","ثٍ سُقْتُهُ مُعْتَذِرا",7,"ر",2,0],["طَبَعَتْهُ شَمْسُ الصَّعِيدِ وَلَكِنْ","لَمْ يَطُلْ مِنْهُ مَحْمِلُ الصَّمْصَامِ",8,"م",1,0],["طبائعهم شتّى على أن بينهم","كريماً تُواليه ووغداً تُجانبه",9,"ب",2,0],["طُبِعت على حبّ العَلاء فسعيُها","للمكْرُمات يُعَدّ من دَيْدانها",10,"ن",3,0],["طبخت بنار خدوده في كفِّه","فقبلتها وشربت منه حلالها",11,"ل",3,0],["طِبْتَ خِلّاً فاسلمْ على نَكد الده","ر وعش آمناً من الأَسْواءِ",12,"ا",2,0],["طَبٌّ بأحكامِ الهجاءِ مُبصِّرٌ","أهلَ السَّفاهِ بزَيغهِ وصوابِهِ",13,"ب",2,0],["طبخوهُ ثم أتوا به قد أُبرِمتْ","أوْتارُهُ لمنادفٍ وبرابِطِ",14,"ط",1,0],["طبيعةً لا تزالُ تُخْلِصُها ال","أيَّامُ والتّبر عِنْد مُنْسبكهْ",15,"ك",2,0],["طباهجةٌ كأعرافِ الديوكِ","تروقُ العين من شرط الملُوكِ",16,"ك",1,1],["طبيعةُ بُخْلٍ أكَّدتْها خليقةٌ","تخلَّقْتُها خوفَ احتياجي إلى مثلي",17,"ل",2,0],["طبيبٌ كم شفاني من سَقامٍ","وما جدحَ الدواءَ ولا رقاني",18,"ي",1,0],["طَبَعتهُ لُجِّيّا فَذابَت صَفحَةٌ","مِنهُ وَلَو جَمُدَت لَكانَ مُهَنَّدا",19,"د",2,0],["طب بالحياة ومالها من ظاهر","يلهيك منه عن الخفى الزخرف",20,"ف",1,0],["طبنا بوصلك بُرهةً واليوم قد","وقع الفراق فقلت يا نفس اشجعي",21,"ي",1,0],["طُبِعَت مِنَ السُمِّ الحَياةُ طَعامُها","وَشَرابُها وَهَوائُها المُتَنَشَّقُ",22,"ق",1,0],["طِباقاً في العُلى مُتَفاوِتاتِ","سَما بَرٌّ بِها وَاِنحَطَّ بَرُّ",23,"ر",1,0],["طُبِعَ الحَديدُ فَكانَ مِن أَجناسِهِ","وَعَلِيٌّ المَطبوعُ مِن آبائِهِ",24,"ا",3,0],["طَبَت فُرسانَنا وَالخَيلَ حَتّى","خَشيتُ وَإِن كَرُمنَ مِنَ الحِرانِ",25,"ن",1,0],["طبيعة خامسة ولّدت","فيها انبساط الغائص الذائبِ",26,"ب",1,0],["طبيعتنا التي لا ظل فيها","لها من نسل أربعة تتاجُ",27,"ج",1,1],["طبعي البرودة واليبوسة ولّدت","مني الهموم ومني الأفراحُ",28,"ح",1,0],["طبائع من واحد أربع","قد طال فيها القال والقيلُ",29,"ل",1,0],["طبقات نارك لا تلّهب","ها ولا إجمادُها",30,"د",3,0],["طُبِعَتْ مضاربُه الرِّقاقُ غوامِضَاً","فكأنها مرهومَةٌ لم تُطْبَعِ",31,"ع",1,0],["طُبِعْتَ على حلمٍ فلو شئتَ غيرَهُ","غُلِبتَ عليه والتكلُّفُ مغلوبُ",32,"ب",1,0],["طِبتُ نَفساً عَنِ الشَبابِ وَما سُ","وِّدَ مِن صِبغِ بُردِهِ الفَضفاضِ",33,"ض",1,0],["طُبِعتَ عَلى الإِسلامِ وَالحَزمِ وَالنَدى","أَلا إِنَّما تُبدي الأُمورَ الطَبائِعُ",34,"ع",1,0],["طبق فيه خدود","وقدود ونهود",35,"د",1,0],["طبعت على حب الوصي ولم يكن","لينقل مطبوع الهوى عن طباعه",36,"ع",2,0],["طَباها ضَحاءٌ أَو خَلاءٌ فَخالَفَت","إِلَيهِ السِباعُ في كِناسٍ وَمَرقَدِ",37,"د",1,0],["طِبتُم حَديثاً كَما قَد طابَ أَوَّلُكُم","وَالشَوكُ لا يُجتَنى مِن فَرعِهِ العِنَبُ",38,"ب",1,0],["طِبتُ عَيشاً لَمّا رَأَيتُ يَدَ الصُب","حِ لِدُرِّ النُجومِ ذاتَ اِلتِقاطِ",39,"ط",1,0],["طَبَّ هَذا الزَمانَ وَهوَ جَسيمٌ","قَصَّرَت دونَهُ يَدا بِقِراطِ",39,"ط",1,0],["طُبِعَت راحَتاهُ مِن جَوهَرِ الجو","دِ وَلَيسَ المَعطِيُّ كَالمُتَعاطي",39,"ط",2,0],["طُبِعَ الأَنامُ عَلى الخِلافِ وَجودُهُ","في الناسِ مَسأَلَةٌ بِغَيرِ خِلافِ",40,"ف",1,0],["طَبَّقَ الأَفاقَ حَتّى خِلتُهُ","مِن نَدى أَيدي عَليٍّ قَد نَشا",41,"ش",2,0],["طبعُه الجودُ فلما هتفت","مصرُ تدعوه تناهى في الكرم",42,"م",1,0],["طَبَقاتُ شَحمِكَ لَيسَ يَخفى أَنَّها","لَم يَبنِها آءٌ وَلا تَنّومُ",43,"م",1,0],["طَبَلَت رَبيعَ رَبيعَةَ المُهمي لَها","فَوَرَدنَ ظِلَّ رَبيعَةَ المَمدودا",44,"د",2,0],["طَبَعنا لَهُم سَيفاً فَكُنّا لَحَدِّهِ","ضَرائِبَ عَن أَيمانِهِم وَالسَواعِدِ",45,"د",1,0],["طَبَقَاتٌ فِي جَوْفِهَا حُجُرَاتٌ","ضُمِّنَتْ كُلَّ حِكْمَةٍ وَبَيَانِ",46,"ن",1,0],["طَبَائِعُ لا تُغبُّ مُرَدّدَاتٍ","كَمَا تَعْرَى وَتَشْتَمِلُ الْحُقُولُ",47,"ل",1,0],["طبيبٌ القبلةُ في خدِّهِ","من المعاصي خيفةَ النارِ",48,"ر",1,0],["طباعُ عفيفٍ لا يرى حبَّ منصبٍ","ولكنْ تشفِّي حاسديهِ بهِ مرُّ",49,"ر",1,0],["طَبَعَت عَلى النُوّارِ بيضَ دَراهِمٍ","مَدَّت إِلَيكَ بِها بَنانُ غُصونِ",50,"ن",1,0],["طِبٌّ من الوحْي المفصَّلِ آخِذٌ","بِمجامعِ الأَرواحِ والأجسادِ",51,"د",1,0],["طبيبَ النّيلِ هل للنِّيلِ شافٍ","وهل للدّاءِ بعدَك من طبيبِ",52,"ب",1,0],["طِبُّ الهُدى الشّافِي وأعجبُ ما أرى","طِبٌّ تَصِحُّ به النُّفوسُ وتَسْقُمُ",53,"م",1,0],["طَبَّقَ الأَرضَ ذِكرُهُ فَلَهُ في","كُلِّ أُفقٍ مَعَ الهَواءِ اِنتِشارُ",54,"ر",1,0],["طَباهُنَّ حَتّى أَطفَلَ اللَيلُ دونَها","تَفاطيرُ وَسمِيٍّ رَواءٍ جُذورُها",55,"ر",3,0],["طَبيبُ الكَفِّ لا يَذبُ","لُ في قَبضَتِهِ عِرقُ",56,"ق",1,0],["طَبعي كَطَبعِ المُشتَري ما فيهِ مِن","شَوبِ فَهَل مِن مُشتَرٍ لِلمُشتَري",57,"ي",1,0],["طَبَعَتْ رَأْسُهُ دَماً وَبِسَاطِي","جلْدَةً أَوْ حَسِبتُهُ جُلَّنَارَهْ",58,"ر",2,0],["طَبٌّ أرِيبٌ بأيّامِ الحروب زعي","مٌ بالخُطوب عليمٌ بالمآتيِّ",59,"ي",1,0],["طَبَخَتهُ الشَمسُ لَمّا","بَخِلَ العِلجُ بِنارِه",60,"ر",2,0],["طَبيخُ الشَمسِ لَم تَطبُخهُ قِدرٌ","بِماءٍ لا وَلَم تَلذَعهُ نارُ",61,"ر",1,0],["طِبتَ وَالعِفَّةُ عَن تَق","بيلِ خَدَّيكَ حَرامُ",62,"م",1,0],["طَبيبي داوِني وَتَأَنَّ سُقمي","لَكَ اليَومَ التِلادُ عَلى النَجاحِ",63,"ح",1,0],["طَبائِعُ أَربَعٌ جُشَّمنَ أَمراً","فَإِضنَ لِحَملِهِ مُتَجَشِّماتِ",64,"ت",1,0],["طِباعُ الوَرى فيها النِفاقُ فَأَقصِهِم","وَحيداً وَلا تَصحَب خَليلاً تُنافِقُه",65,"ق",2,1],["طَبعٌ خُلِقتَ عَلَيهِ لَيسَ بِزائِلٍ","طولَ الحَياةِ وَآخَرٌ مُتَعَلَّمُ",66,"م",1,0],["طِبْتُ نفْساً إذ لاحَ صُبْحُ ثنايا","كَ لِعَيْنِي وفاحَ طيبُ شذاكا",67,"ك",2,0],["طبيعةٌ في الخلْقِ ركَّبتها","وما أرى لي في بِناها يدا",68,"د",2,0],["طَبيبانِ لَو داوَيتُماني أُجِرتُما","فَما لَكُما تَستَغنِيانِ عَنِ الأَجرِ",69,"ر",1,1],["طَبَعَتْهُ فِي لَوْحِ الْفُؤَادِ مَخِيلَتي","بِزُجَاجَةِ الْعَينَينِ فَهُوَ مُصَوَّرُ",70,"ر",1,0],["طُبِعُوا على حَسَدٍ فَأَنْتَ تَرَاهُمُ","مَرْضَى الْقُلُوبِ أَصِحَّةَ الأَجْسَادِ",71,"د",1,0],["طَبِيبٌ طَابَ عُنْصرُهُ وَصَحَّتْ","بِهِ شِيَمُ الزَّمَانِ مِنِ اعْتِلاَلِ",72,"ل",1,0],["طَبِيبٌ لِلعُيُونِ بِهِ شِفَاءٌ","إِذَا مَا الطِّبُّ أَعْيي وَالطَّبِيبُ",73,"ب",1,0],["طُبِعَتْ مِنَ الحُسْنِ العَتِيقِ بِطَابَعٍ","وَضَّاحِ آيَاتٍ بَدِيعِ رُوَاءِ",74,"ا",2,0],["طبُّكَ بُرْءٌ وَفِيكَ مَعْرِفَةٌ","بِالنَّفْسِ تَشْفِي الضَّمِيرَ مُعتَلاَ",75,"ل",2,0],["طبت وادي بردى من جنةٍ","طهرَت أرواحها من كلّ رجسِ",76,"س",1,0],["طِباعي أَبَت إِلّا التَذَلُّلَ في الهَوى","وَلا زالَ خَدّي لِلحَبيبِ بِساطا",77,"ط",2,1],["طَبيبهُ لا سَلِمتُ ما لي","أَحسَبهُ يُذبحُ اِشتِحاطا",78,"ط",2,0],["طَبَعاتٌ فيها من الحسن طبعٌ","قيمةُ المرءِ في مدَى إحسانه",79,"ن",2,0],["طبعتَ على الإباء، فكن وليًّا","على شمٍّ أُباة الضيم صِيد",80,"د",1,0],["طبعَ النِّقشُ عليها شامةً","كالتي في خدها الملتهب",81,"ب",1,0],["طبقاتُ الفضاء عَزَّت على «الرُّو","سِ»، ودانت للشاعر الغِرِّيد",82,"د",1,0],["طب المسيح بعثت يا بن سميه","في رقية خفيت عن الأذهان",83,"ن",1,0],["طبقّت شهرتي البلادَ وما","جاوز عمري عشراً وسبعاً وخمساً",84,"س",2,0],["طب بعيش به الحياة تجود","إنها إن تصرمت لا تعود",85,"د",1,0]]}