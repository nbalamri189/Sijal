{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[102,"الفاتح الأعزل","https://www.poetsgate.com/ViewPoem.aspx?id=50351",""],[161,"قلمي","https://www.aldiwan.net/poem23654.html","الهزج"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101857","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79698","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79699","الخفيف"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70398","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108390",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85261","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66534","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76443","الرمل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124622","الطويل"],[4722,"نفيتم صفات الله فالله أكمل","https://www.poetsgate.com/ViewPoem.aspx?id=26476",""],[4767,"عقد الجمان","https://www.poetsgate.com/ViewPoem.aspx?id=178711",""],[5848,"سعاد الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=53195",""],[6052,"الشذا","https://www.poetsgate.com/ViewPoem.aspx?id=52572",""]],"verses":[["في كسادِ القريضِ أخفيتُ دُرِّي","وخَزنتُ الغريبَ من مَرْجاني",0,"ن",2,0],["فِيكَ سِرٌّ الْجَلالِ وَالْخطْبُ فِيهِ","كَانَ يَا قَبْرُ لَوْ عَلِمْتَ جَليلاَ",1,"ل",2,0],["في كسل تثني أغنية","أنثى لهواه تتجمل",2,"ل",1,0],["فَيَكْسِي حَرْثَهَا زَرْعًا","ونَبْتًا فَرْعُهُ هُدْبُ",3,"ب",1,0],["فيكسو جسوم الدارعين مطارفا","من الضرب حمراً إن تعرى من الغمد",4,"د",1,0],["فيك سر الجمال من كل شيءٍ","فأميطي لثامك المسدولا",5,"ل",2,0],["فيك سر الغرام والأشواق","يا رسول الحسناء للعشاق",6,"ق",1,1],["فيك سر سحر الش","شباب فِي استحسان ذاتك",7,"ك",1,0],["فيكسبهُ سلكاً وحسناً ومنهجاً","وما رابحٌ منهم سوى قلة القدر",8,"ر",1,0],["فيكسر صلبان النصارى بكفه","فيقضي به بين الأنام ويعدل",9,"ل",1,0],["فِيكَ سِرُّ لَوْلاَهُ ما قَسَمَ اللّ","هُ عَلى النَّاسِ جَنَّةً وَسَعِيرَا",10,"ر",2,0],["فيك سيف في يد الخل الوَفي","يوقظ الرقاد",11,"د",1,0],["فيكسو السهوب الشعث من بعد محلها","تهاويل فيها كل وشي منمّق",12,"ق",1,0],["فيكسر صلبان النصارى بكفه","وما دام حيا للخنازير يقتل",13,"ل",1,0],["فيُكسَى بالأمان بكل عطفٍ","فقلب الوالدين عليه لانا",14,"ن",2,0],["فيك سر الغموض وفيك سحر الوضوح","مثل كلمة غضب هبت وشافت سماح",15,"ح",1,0],["فيكسوها جمال لا نراه","كأنا قد سقانا الحسن مدح",16,"ح",1,0]]}