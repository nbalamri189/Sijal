{"poems":[[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[53,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[53,"إذا ضافني هم أمل طروقه","https://www.aldiwan.net/poem30420.html","الطويل"],[63,"سرت وظلام الليل ستر على الساري","https://www.aldiwan.net/poem46202.html","الطويل"],[57,"إذا المرء أفشى سره بلسانه","https://www.aldiwan.net/poem24661.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[42,"إذا ضاق صدر المرء عن سر نفسه","https://www.aldiwan.net/poem50285.html","الطويل"],[86,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[71,"وما حيوان يتقي الناس شره","https://www.aldiwan.net/poem3894.html","الطويل"],[71,"أبعد مقامي في دباوند أبتغي","https://www.aldiwan.net/poem3994.html","الطويل"],[35,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[35,"ولولا حبكم لتضاعفتني","https://www.aldiwan.net/poem39122.html","الوافر"],[30,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[88,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[27,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[37,"وهات الثناء لأهلي العلى","https://www.aldiwan.net/poem7675.html","المتقارب"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[23,"لقد غضبت جهلا سليم سفاهة","https://www.aldiwan.net/poem21364.html","الطويل"],[72,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[51,"إذا ضحكتم ضحكنا في مفارحكم","https://www.aldiwan.net/poem65465.html","البسيط"],[51,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[29,"ألا حييا دارا لأم هشام","https://www.aldiwan.net/poem6085.html","الطويل"],[12,"ولا تقبروني إن دفني محرم","https://www.aldiwan.net/poem1212.html",""],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[43,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[43,"أنا لائمي إن كنت وقت اللوائم","https://www.aldiwan.net/poem10544.html","الطويل"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[28,"حملت من جرم مثاقيل حاجتي","https://www.aldiwan.net/poem5364.html","الطويل"],[28,"ألم تر جنبي عن فراشي جفا به","https://www.aldiwan.net/poem5434.html","الوافر"],[61,"غداة الشك ندعوك","https://www.aldiwan.net/poem51402.html","الهزج"],[58,"وكم لله من لطف خفي","https://www.aldiwan.net/poem30793.html","الوافر"],[58,"إذا ضاق الزمان عليك فاصبر","https://www.aldiwan.net/poem31140.html","الوافر"],[49,"ألم تر أن الحق أبلج لائح","https://www.aldiwan.net/poem62027.html","الكامل"],[49,"هو الموت فاصنع كلما أنت صانع","https://www.aldiwan.net/poem62154.html","الطويل"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[66,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[87,"ألا حي بالمقياس ريا المعالم","https://www.aldiwan.net/poem8288.html","الطويل"],[105,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[40,"ألا من لعين لا تزال تسيل","https://www.aldiwan.net/poem42331.html","الطويل"],[52,"إذا أنا لم أجز الزمان بفعله","https://www.aldiwan.net/poem26764.html","الطويل"],[52,"سلمت أمير المؤمنين على الدهر","https://www.aldiwan.net/poem27019.html","الطويل"],[48,"ومستعبد إخوانه بثرائه","https://www.aldiwan.net/poem63397.html","الطويل"],[48,"طرحتم من الترحال ذكرا فغمنا","https://www.aldiwan.net/poem66141.html","الطويل"],[50,"تبوح بسرك ضيقا به","https://www.aldiwan.net/poem62236.html","المتقارب"],[46,"أرى بشرا عقولهم ضعاف","https://www.aldiwan.net/poem22691.html","الوافر"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[76,"وما روضة بالحزن حاك لها الندى","https://www.aldiwan.net/poem39251.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140906",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42601","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/19803","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142044","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[106,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[49,"هوَ المَوْتُ، فاصْنَعْ كلَّ ما أنتَ صانعُ،","https://www.poetsgate.com/ViewPoem.aspx?id=25222",""],[46,"أرَى بَشَراً، عقولُهُم ضِعافٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=20266",""],[35,"أمِن آلِ سَلْمى دِمنَة ٌ بالذنَّائِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=21920",""]],"verses":[["إِذا ضَرَعَ الأَقوامُ مِن سوءِ نَكبَةٍ","جَلاها قَويمُ الأَنفِ فيها أَشَمُّهُ",0,"م",2,0],["إِذا ضَرَبوا رَدّوا الحَديدَ مُثَلَّماً","وَإِن طَعَنوا رَدّوا الوَشيجَ مُدَقَّقا",1,"ق",2,0],["إِذا ضَرَبوا في الأَرضِ فَهيَ مَهالِكٌ","وَإِن أَوطَنوا الأَبياتِ فَهيَ مَحابِسُ",2,"س",1,0],["إِذا ضافَتِ الحَيَّ الحَريدَ مُغيرَةٌ","أَدَرَّ عَليها لَقحَةَ الطَعنِ عامِرُ",3,"ر",1,0],["إِذا ضافَني هَمٌّ أَمَلُّ طُروقَهُ","بِبَعضِ اللَيالي أَو أَضيقُ بِهِ صَدرا",4,"ر",2,1],["إذا ضَجَّ فيها الرَّعْدُ أُلْبِسَتِ الرُّبا","حَياً وألاحَ البَرْقُ بالمِنْصَلِ العاري",5,"ر",2,0],["إِذا ضاقَ صَدرُ المَرءِ عَن سِرِّ نَفسِهِ","فَصَدرُ الَّذي يُستَودَعُ السِرَّ أَضيَقُ",6,"ق",1,0],["إِذَا ضَمَّ أَبْطَالَ الْهِيَاجِ مُعَانِقاً","فَكَمْ مُفْرَدٍ أَوْدَى عَلاَمَتُهُ الضَّمُّ",7,"م",1,0],["إِذا ضاقَ صَدرُ المَرءِ عَن سِرَّ نَفسِهِ","فَفاضَ فَفي صَدري لَسِرِّيَ مُتَّسَع",8,"ع",1,1],["إِذا ضاءَتِ الأَحسابُ يَوماً لِمُعرِقٍ","فَعُثمانُ خَيرُ الفاتِحينَ لَهُم أَبُ",9,"ب",1,0],["إِذا ضَعَّفوا نِصفَ اِسمِهِ صارَ طائِراً","وَإِن ضَعَّفوا باقيهِ صارَ مِنَ الوَحشِ",10,"ش",1,0],["إِذا ضاعَ رَيّاهُ أَذاعَت طُيورُهُ ال","حَديثَ فَتَغني عَن قِيانٍ وَمشحبِ",11,"ب",1,0],["إِذا ضَحِكَت لَم تَنتَهِز وَتَبَسَّمَت","ثَنايا لَها كَالمُزنِ غُرٌّ ظُلومُها",12,"م",3,0],["إِذا ضَمرِيَّةٌ عَطَسَت فَنِكها","فَإِنَّ عُطاسَها طَرَفُ الوِداقِ",13,"ق",1,0],["إِذا ضَرَبَتهُ الرِيحُ رَنَّقَ فَوقَنا","عَلى حَدِّ قَوسَينا كَما رَنَّقَ النَسرُ",14,"ر",1,0],["إذا ضربت أوتار قلبي شجونه","بدت نغمات ترقص الدمع منصبّا",15,"ب",2,0],["إِذا ضَرَحنَ حَصا مَعزاءُ هاجِرَةٍ","مَدَّت سَوالِفَها في لينِ أَعضادِ",16,"د",1,0],["إِذا ضَمَّ في الرَّوعِ يَومَ الهِيَا","جِ أَخِّر وأَقدِم الى أرحِبِ",17,"ب",1,0],["اذا ضمّ في الروع يوم الوهاج","أخر واقدم الى ارحب",18,"ب",1,0],["إِذا ضُرِبَت فَوقَ الخَليجِ قِبابُنا","وَأَمسى عَلَيكَ الذِلُّ وَهوَ مُخَيِّمُ",19,"م",1,0],["إِذا ضِفتَهُم أَلفَيتَ حَولَ بُيوتِهِم","كِلاباً لَها في الدارِ عالٍ هَريرُها",20,"ر",3,0],["إذا ضحك السمار حجب ثغره","كذلك يحمي العابد الثغر والثغرا",21,"ر",2,0],["إذا ضاقت الأخلاقُ أفضتْ خلائقي","إلى سعةٍ مثلي إلى مثلها يُفضي",22,"ي",1,0],["إذا ضحكتم ضحكنا في مفارحكم","وإن بكيتم فمنا الأدمع الذُّرُفُ",23,"ف",1,1],["إذا ضاقتْ على أملٍ بلادٌ","فما سُدَّتْ على عزمٍ سبيلُ",24,"ل",1,0],["إِذا ضَحِكَت لَم تَنتَهِت وَتَبَسَّمَت","بِأَبيَضَ لَم تَكدِم مُتونَ عِظامِ",25,"م",1,0],["إِذا ضَرَبوا رَأسي وَفي الرَأسِ أَكثَري","وَغودِرَ عِندَ المُلتَقى ثَمَّ سائِري",26,"ر",2,0],["إِذا ضَحِكَت زَهواً إِلَيَّ سَماوَها","بَكَيتُ النَدى في الأَرضِ وَالبَأسَ وَالحَزما",27,"م",2,0],["إِذا ضَرَبَت في الحَربِ بِالسَيفِ كَفُّهُ","تَبَيَّنتَ أَنَّ السَيفَ بِالكَفِّ يَضرِبُ",28,"ب",1,0],["إِذا ضَرَبَ الأَميرُ رِقابَ قَومٍ","فَما لِكَرامَةٍ مَدَّ النُطوعا",29,"ع",2,0],["إِذا ضَرَبَتهُ الريحُ ماجَ كَأَنَّهُ","تَجولُ مَذاكيهِ وَتَدأى ضَراغِمُه",30,"م",2,0],["إِذا ضَوؤُها لاقى مِنَ الطَيرِ فُرجَةً","تَدَوَّرَ فَوقَ البَيضِ مِثلَ الدَراهِمِ",31,"م",1,0],["إِذا ضاقَ ما بين الحسامينِ لم يزلْ","يجولُ مجالَ العِقْدِ فوقَ الترائبِ",32,"ب",1,0],["إِذا ضُمَّ أَصحابُ الرِهانِ وَجَدتَهُ","أَخا حَلَباتٍ سابِقاً وَاِبنَ سابِقِ",33,"ق",1,0],["إِذا ضَمَّتِ الناسَ المَنازِلُ وَاِلتَقى","وَرائِيَ طَودا خِندِفٍ وَفُحولُها",34,"ل",3,0],["إِذا ضاقَ عَن قَومٍ مَكانٌ رَأَيتَنا","لَنا العَرضُ مِن أَرضِ السَماءِ وَطولُها",34,"ل",3,0],["إذا ضاحكَها البَرقُ","غَدا الغيثُ يبُاكِيها",35,"ي",3,0],["إِذا ضاقَت بِكَ الأَحوالُ يَوماً","فَثِق بِالواحِدِ الفَردِ العَلِيِّ",36,"ي",1,0],["إِذا ضاقَ الزَمانُ عَلَيكَ فَاِصبِر","وَلا تَيأَس مِنَ الفَرَجِ القَريبِ",37,"ب",1,1],["إِذا ضاقَ صَدرُ المَرءِ لَم يَصفُ عَيشُهُ","وَما يَستَطيبُ العَيشَ إِلّا المُسامِحُ",38,"ح",1,0],["إِذا ضَنَّ مَن تَرجو عَلَيكَ بِنَفعِهِ","فَدَعهُ فَإِنَّ الرِزقَ في الأَرضِ واسِعُ",39,"ع",1,0],["إِذا ضَمَّ أَقسامَ الجَمالِ تَحَيِّزٌ","فَإِنَّ جَميلَ الصَبرِ بِالحُرِّ يَقبَحُ",40,"ح",1,0],["إِذا ضاقَت بِهِ أَرضٌ جَفاها","وَلو مَلأَ النُضارُ بِها الرَكايا",41,"ا",3,0],["إذا ضَحِكَتْ لُمْبِصِرِها رياضٌ","بواكٍ فَوْقَها سُحُبٌ غِزارُ",42,"ر",1,0],["إِذا ضَارَبوا في مأزِقِ الضربِ جرّدوا","صواعقَ من أيديهمُ في سحائِبِ",43,"ب",1,0],["إِذا ضَلَّ قومٌ عن سَبيلِ الهُدى اهتدوا","وأيّ ضَلالٍ للنّجوم الثواقِبِ",43,"ب",1,0],["إِذَا ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ مُتُونُهَا","رَفِيفَ الثَّنَايَا خَلْفَ حُمْرِ الْمَبَاسِمِ",44,"م",1,0],["إذا ضاقَ الخِناقُ به تنحَّى","يَلوذُ بكلِّ مُرتكَضٍ رَحيبِ",45,"ب",1,0],["إذا ضجّ الدّمُ المُهراقُ ضَجَّتْ","شعوبُكِ رحمةً للمُهرِقينا",46,"ن",2,0],["إِذا ضاقَت فِجاجُ الأرضِ عَنها","سَمَت في الجَوِّ فَاِنفَرَجَ المَضيقُ",47,"ق",1,0],["إِذا ضاقَ عَنهُم بِأسُهُم جاشَ بَأسُهُ","وَإِن أَحجَموا في حَومَةِ الحَربِ أَقدَما",48,"م",2,0],["إذا ضلَّت دَهاقينُ الثّقاتِ","وأمسى الناسُ أسرى التُّرَّهاتِ",49,"ت",1,0],["إِذا ضَرَبَت بِالبُردِ مِن دُونِ وَجهِها","تَلالا أَحَمُّ المُقلَتَينِ أَسِيلُ",50,"ل",1,0],["إِذا ضَحِكَت حَربٌ عَنِ البيضِ وَالقَنا","رَأَيتَ الدُموعَ الحُمرَ تَجري عَلى نَصلي",51,"ي",1,0],["إِذا ضَمَّ قِرناً بَينَ كَفَّيهِ خِلتَهُ","يُعاني عَروساً في غَلائِلِها الحُمرِ",52,"ر",1,0],["إِذا ضَمَّني يَوماً وَإِيّاهُ مَحفِلٌ","رَأى جانِبي وَعراً يَزيدُ عَلى الوَعرِ",53,"ر",1,0],["إِذا ضَنَّ رَبُّ المالِ أَعلَنَ جودُهُ","بِحَيَّ عَلى مالِ الأَميرِ وَأَذَّنا",54,"ن",2,0],["إِذا ضاعَ سِرُّكَ مِن مُخبِرٍ","فَأَنتَ إِذا لُمتَهُ أَلوَمُ",55,"م",1,0],["إِذا ضَحِكوا لِزَيدٍ أَو لِعَمرٍ","فَإِنَّ السَمَّ يُخَبَّأُ في العُمورِ",56,"ر",1,0],["إذا ضُرِبَتْ خِيامُكَ في مَكانٍ","فذلك حيثُ يُلتَقَطُ الجُمانُ",57,"ن",1,0],["إذا ضَحِكَتْ عُجْباً به كلُّ بلْدةٍ","بكَى مالُه مِنْ ظُلْمِهِ واهتِضامِهِ",58,"م",2,0],["إذا ضَنّ زَنْدٌمَدّ بالشّخْتِ كفَّه","ليَقْبِسَ من بعضِ الكواكبِ نارا",59,"ر",2,0],["إذا ضاحَكَتها الشَّمسُ تَبكي بأعيُنٍ","مُكلَّلةِ الأَجفانِ صُفْرِ الحَمالِقِ",60,"ق",1,0],["إذا ضوءها لاقى من الطير فرجةً","تدور فوق البيض مثل الدراهم",61,"م",1,0],["إذا ضَحِكَ القِرْضَابُ تِيهاً فإنّه","متى يَرَها بادِي النّدامةِ عابِس",62,"س",1,0],["إِذَا ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ كَأَنَّما","عَلَى صَفْحَتَيْهَا سُنْدُسٌ وَحَرِيرُ",63,"ر",1,0],["إِذَا ضَحَا ظِلُّكَ مَا حَالُهُمَا","مُعَاقَبَينِ وَهُمَا مَا أَذْنَبَا",64,"ب",2,0],["إِذا ضَبَبُوا يَومًا بِها الآلَ زَيَّنوا","مَسانِدَ أَشراقٍ بِها وَمَغارِبِ",65,"ب",1,0],["إذا ضمن المرء الخلود على الصبا","فما عمره الباقي سوى فضلات",66,"ت",1,0],["إذا ضيّع التاريخَ أبناءُ أمّةٍ","فأنفُسَهُم في شِرْعَةِ الحقِّ ضيِّعوا",67,"ع",3,0],["إذا ضَنَّ دهري بما أبتغيه","وباتَت عليَّ الليالي شِحاحا",68,"ح",2,0],["إذا ضَنّ مَنْ تَرْجو عَلَيكَ بنَفْعِهِ،","فذَرْهُ، فإنّ الرّزْقَ، في الأرْضِ، واسعُ",69,"ع",1,0],["إذا ضَحِكوا لزَيدٍ أو لعمرٍو،","فإنّ السّمَ يُخبأُ في العمور",70,"ر",1,0],["إذا ضَرَبُوا يوماً بها الآلَ زيّنوا","مَسانِدَ أَشراقٍ بها وَمَغارِبِ",71,"ب",1,0]]}