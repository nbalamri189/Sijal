ق الزمان فكن صبوراً","ففي الأيام ضيقٌ واتساعُ",107,"ع",1,0],["إذا ضمت أناملهُ يراعا","سل الهنديّ ما فعل اليراعُ",107,"ع",1,0],["إذا ضرب الخالين من سورة الهوى","يفجّر من حبّ القلوب له حبّا",108,"ب",2,0],["إذا ضَلَّ العجاجُ بِهَا هَدَاها","جبينُكَ أنْ تُعَرِّجَ أو تَضِلّا",109,"ل",2,0],["إذا ضاق أمر فارج بعد مضيقه","عليك من اللَه الكريم اتساعه",110,"ع",2,0],["إذا ضرب الرباب لهم نساء","تجيب السبق سجلاء النهيق",111,"ق",1,0],["إذا ضحكت لك الأيام فاحذر","هجوم النائبات من العبوس",112,"س",1,0],["إِذا ضمَّها عَرْفُ الكمائم ضمختْ","صَباه وسامته معاطفها اللُّطفا",113,"ف",2,0],["إذا ضاقت رحابُ الرأي جاءت","بصيرته ففرجت ازدحامه",114,"م",2,0],["إذا ضلَّ فهمُ الدليل الحليم","هدَى الناسَ منه دليلٌ جهولُ",115,"ل",1,0],["إذا ضاق بالسير ذرعُ الرفيق","ملأتُ بهنّ فروجَ الملا",116,"ل",2,0],["إذا ضممن في الدجى القَرابصا","نمَّ عليهن الحُليُّ آبصا",117,"ص",2,0],["إذا ضمّني مؤيّد الملك مانعاً","فما لدمِ الأيّام عندِيَ ثارُ",118,"ر",1,0],["إذا ضاقت الأهب الفسيحة بالجوى","نشقن نسيماً أو تسمعن حاديا",119,"ي",2,0],["إذا ضمئتْ من هجير الضَّحاء","عَلَّ دَمَ الهام ظَمْآنُها",120,"ن",3,0],["اذا ضاقت الدُّنيا عليهم خصاصةً","فنائلهُ رحْبٌ ومنزلهُ رحْبُ",121,"ب",1,0],["إِذا ضل عافيهم عن القصد في الدجى","أضاؤوه نيرانَ القِرى والمَجاليا",122,"ي",2,0],["اذا ضَمنَ التَّنَسُّكُ فيه أجْراً","فمدحُ عُلاكَ يكْفلُ بالنَّولِ",123,"ل",1,0],["إذا ضاق شُكري عن نداهُ الذي له","بكُلِّمقامٍ زَخْرَةٌ وعُبابُ",124,"ب",1,0],["إذا ضَلَّتْ رَويَّةُ أَلْمَعِيٍّ","أصابَ الأمر في الرَّأي ارْتجالا",125,"ل",2,0],["إذا ضمَّهُ والأرحبي تنوفه","تشابهَ فيها جسمهُ ووضينه",126,"ن",2,0],["اِذا ضللتُ هداني برقُ مبسمِها","حتى كأني قد استنورتُ مِصباحا",127,"ح",2,0],["إِذا ضَرَبَت أَعناقَها في رِضا الدُجى","أَعارَتهُ مِن أَنوارِها خِلَعَ الفَجرِ",128,"ر",1,0],["إِذا ضَلَّ عَنهُم ضَيفُهُم رَفَعوا لَهُ","مِن النارِ في الظَلماءِ أَلويَةً حُمرا",129,"ر",2,1],["إذا ضرّني يوماً صديقي وساءَنِي","فَما هوَ إلّا كالعدوِّ المكاشِحِ",130,"ح",1,0],["إِذا ضُيِّعَ الرَأيُ اِستَشَفَّ كَأَنَّهُ","شَواهِقُ رَضوى لَيسَ في خُلقِهِ دَخلُ",131,"ل",1,0],["إِذا