id=92218",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[778,"وحانة خمار انخت مطيتي","https://www.poetsgate.com/ViewPoem.aspx?id=89223",""],[778,"رايت الدهر حالا بعد حال","https://www.poetsgate.com/ViewPoem.aspx?id=89220",""],[307,"جَمَالُ الشّيْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=214156",""],[5334,"عَدَدْنا فُقَيْماً وآباءَهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=96977",""],[5376,"أناختْ على هجرِ المطايا نجائبي........يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=188567",""],[5387,"وأنت الغيث!!!","https://www.poetsgate.com/ViewPoem.aspx?id=53779",""],[5409,"شقاءٌ في شبابي والمشيب","https://www.poetsgate.com/ViewPoem.aspx?id=155252",""],[5431,"كثيرٌ أبا الخطاب","https://www.poetsgate.com/ViewPoem.aspx?id=204980",""],[5431,"غناء ...","https://www.poetsgate.com/ViewPoem.aspx?id=207456",""],[5493,"عساكَ تحدّث الأحلام سرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=196977",""],[5493,"تراب الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205057",""],[5605,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=159457",""],[1715,"أَذا ضَيَّقتَ أَمراً زادَ ضيقاً","https://www.poetsgate.com/ViewPoem.aspx?id=93964",""],[5690,"إذا ضاقت الدنيا عليَّ برحبها","https://www.poetsgate.com/ViewPoem.aspx?id=172196",""],[5736,"سها","https://www.poetsgate.com/ViewPoem.aspx?id=208478",""],[5746,"عهد قلم","https://www.poetsgate.com/ViewPoem.aspx?id=207121",""],[5880,"رضاك إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=208579",""],[5953,"إذا ضاق صدري وقل العزا","https://www.poetsgate.com/ViewPoem.aspx?id=93876",""],[5953,"إذا ضاق صدري بالهموم رأيتني","https://www.poetsgate.com/ViewPoem.aspx?id=93873",""],[5956,"إذا ضعفُ عينيَّ لم يستبِنْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=194206",""],[5973,"هل تسمعين أنين الروح جومانا","https://www.poetsgate.com/ViewPoem.aspx?id=14048",""],[6031,"إلى الملكِ الوهَّابِ ما في يمينِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46259",""],[6097,"إذا ضاقَتْ...","https://www.poetsgate.com/ViewPoem.aspx?id=197428",""],[6115,"الايازماني كلما عدلك تنعاج","https://www.poetsgate.com/ViewPoem.aspx?id=180740",""],[321,"إذا ما علا في الصدر والنهى والأمر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606417",""],[3520,"أخَطْبٌ هوى بالنّيراتِ من العُلا","https://diwany.org/%D8%A3%D8%AE%D9%8E%D8%B7%D9%92%D8%A8%D9%8C-%D9%87%D9%88%D9%89-%D8%A8%D8%A7%D9%84%D9%86%D9%91%D9%8A%D8%B1%D8%A7%D8%AA%D9%90-%D9%85%D9%86-%D8%A7%D9%84%D8%B9%D9%8F%D9%84%D8%A7/","الطويل"],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""]],"verses":[["إِذا ضَرَعَ الأَقوامُ مِن سوءِ نَكبَةٍ","جَلاها قَويمُ الأَنفِ فيها أَشَمُّهُ",0,"م",2,0],["إِذا ضَرَبوا رَدّوا الحَديدَ مُثَلَّماً","وَإِن طَعَنوا رَدّوا الوَشيجَ مُدَقَّقا",1,"ق",2,0],["إِذا ضَرَبوا في الأَرضِ فَهيَ مَهالِكٌ","وَإِن أَوطَنوا الأَبياتِ فَهيَ مَحابِسُ",2,"س",1,0],["إِذا ضافَتِ الحَيَّ الحَريدَ مُغيرَةٌ","أَدَرَّ عَليها لَقحَةَ الطَعنِ عامِرُ",3,"ر",1,0],["إِذا ضافَني هَمٌّ أَمَلُّ طُروقَهُ","بِبَعضِ اللَيالي أَو أَضيقُ بِهِ صَدرا",4,"ر",2,1],["إذا ضَجَّ فيها الرَّعْدُ أُلْبِسَتِ الرُّبا","حَياً وألاحَ البَرْقُ بالمِنْصَلِ العاري",5,"ر",2,0],["إِذا ضاقَ صَدرُ المَرءِ عَن سِرِّ نَفسِهِ","فَصَدرُ الَّذي يُستَودَعُ السِرَّ أَضيَقُ",6,"ق",1,0],["إِذَا ضَمَّ أَبْطَالَ الْهِيَاجِ مُعَانِقاً","فَكَمْ مُفْرَدٍ أَوْدَى عَلاَمَتُهُ الضَّمُّ",7,"م",1,0],["إِذا ضاقَ صَدرُ المَرءِ عَن سِرَّ نَفسِهِ","فَفاضَ فَفي صَدري لَسِرِّيَ مُتَّسَع",8,"ع",1,1],["إِذا ضاءَتِ الأَحسابُ يَوماً لِمُعرِقٍ","فَعُثمانُ خَيرُ الفاتِحينَ لَهُم أَبُ",9,"ب",1,0],["إِذا ضَعَّفوا نِصفَ اِسمِهِ صارَ طائِراً","وَإِن ضَعَّفوا باقيهِ صارَ مِنَ الوَحشِ",10,"ش",1,0],["إِذا ضاعَ رَيّاهُ أَذاعَت طُيورُهُ ال","حَديثَ فَتَغني عَن قِيانٍ وَمشحبِ",11,"ب",1,0],["إِذا ضَحِكَت لَم تَنتَهِز وَتَبَسَّمَت","ثَنايا لَها كَالمُزنِ غُرٌّ ظُلومُها",12,"م",3,0],["إِذا ضَمرِيَّةٌ عَطَسَت فَنِكها","فَإِنَّ عُطاسَها طَرَفُ الوِداقِ",13,"ق",1,0],["إِذا ضَرَبَتهُ الرِيحُ رَنَّقَ فَوقَنا","عَلى حَدِّ قَوسَينا كَما رَنَّقَ النَسرُ",14,"ر",1,0],["إذا ضربت أوتار قلبي شجونه","بدت نغمات ترقص الدمع منصبّا",15,"ب",2,0],["إِذا ضَرَحنَ حَصا مَعزاءُ هاجِرَةٍ","مَدَّت سَوالِفَها في لينِ أَعضادِ",16,"د",1,0],["إِذا ضَمَّ في الرَّوعِ يَومَ الهِيَا","جِ أَخِّر وأَقدِم الى أرحِبِ",17,"ب",1,0],["اذا ضمّ في الروع يوم الوهاج","أخر واقدم الى ارحب",18,"ب",1,0],["إِذا ضُرِبَت فَوقَ الخَليجِ قِبابُنا","وَأَمسى عَلَيكَ الذِلُّ وَهوَ مُخَيِّمُ",19,"م",1,0],["إِذا ضِفتَهُم أَلفَيتَ حَولَ بُيوتِهِم","كِلاباً لَها في الدارِ عالٍ هَريرُها",20,"ر",3,0],["إذا ضحك السمار حجب ثغره","كذلك يحمي العابد الثغر والثغرا",21,"ر",2,0],["إذا ضاقت الأخلاقُ أفضتْ خلائقي","إلى سعةٍ مثلي إلى مثلها يُفضي",22,"ض",2,0],["إذا ضحكتم ضحكنا في مفارحكم","وإن بكيتم فمنا الأدمع الذُّرُفُ",23,"ف",1,1],["إذا ضاقتْ على أملٍ بلادٌ","فما سُدَّتْ على عزمٍ سبيلُ",24,"ل",1,0],["إِذا ضَحِكَت لَم تَنتَهِت وَتَبَسَّمَت","بِأَبيَضَ لَم تَكدِم مُتونَ عِظامِ",25,"م",1,0],["إِذا ضَرَبوا رَأسي وَفي الرَأسِ أَكثَري","وَغودِرَ عِندَ المُلتَقى ثَمَّ سائِري",26,"ر",2,0],["إِذا ضَحِكَت زَهواً إِلَيَّ سَماوَها","بَكَيتُ النَدى في الأَرضِ وَالبَأسَ وَالحَزما",27,"م",2,0],["إِذا ضَرَبَت في الحَربِ بِالسَيفِ كَفُّهُ","تَبَيَّنتَ أَنَّ السَيفَ بِالكَفِّ يَضرِبُ",28,"ب",1,0],["إِذا ضَرَبَ الأَميرُ رِقابَ قَومٍ","فَما لِكَرامَةٍ مَدَّ النُطوعا",29,"ع",2,0],["إِذا ضَرَبَتهُ الريحُ ماجَ كَأَنَّهُ","تَجولُ مَذاكيهِ وَتَدأى ضَراغِمُه",30,"م",2,0],["إِذا ضَوؤُها لاقى مِنَ الطَيرِ فُرجَةً","تَدَوَّرَ فَوقَ البَيضِ مِثلَ الدَراهِمِ",31,"م",1,0],["إِذا ضاقَ ما بين الحسامينِ لم يزلْ","يجولُ مجالَ العِقْدِ فوقَ الترائبِ",32,"ب",1,0],["إِذا ضُمَّ أَصحابُ الرِهانِ وَجَدتَهُ","أَخا حَلَباتٍ سابِقاً وَاِبنَ سابِقِ",33,"ق",1,0],["إِذا ضَمَّتِ الناسَ المَنازِلُ وَاِلتَقى","وَرائِيَ طَودا خِندِفٍ وَفُحولُها",34,"ل",3,0],["إِذا ضاقَ عَن قَومٍ مَكانٌ رَأَيتَنا","لَنا العَرضُ مِن أَرضِ السَماءِ وَطولُها",34,"ل",3,0],["إذا ضاحكَها البَرقُ","غَدا الغيثُ يبُاكِيها",35,"ي",3,0],["إِذا ضاقَت بِكَ الأَحوالُ يَوماً","فَثِق بِالواحِدِ الفَردِ العَلِيِّ",36,"ي",1,0],["إِذا ضاقَ الزَمانُ عَلَيكَ فَاِصبِر","وَلا تَيأَس مِنَ الفَرَجِ القَريبِ",37,"ب",1,1],["إِذا ضاقَ صَدرُ المَرءِ لَم يَصفُ عَيشُهُ","وَما يَستَطيبُ العَيشَ إِلّا المُسامِحُ",38,"ح",1,0],["إِذا ضَنَّ مَن تَرجو عَلَيكَ بِنَفعِهِ","فَدَعهُ فَإِنَّ الرِزقَ في الأَرضِ واسِعُ",39,"ع",1,0],["إِذا ضَمَّ أَقسامَ الجَمالِ تَحَيِّزٌ","فَإِنَّ جَميلَ الصَبرِ بِالحُرِّ يَقبَحُ",40,"ح",1,0],["إِذا ضاقَت بِهِ أَرضٌ جَفاها","وَلو مَلأَ النُضارُ بِها الرَكايا",41,"ا",3,0],["إذا ضَحِكَتْ لُمْبِصِرِها رياضٌ","بواكٍ فَوْقَها سُحُبٌ غِزارُ",42,"ر",1,0],["إِذا ضَارَبوا في مأزِقِ الضربِ جرّدوا","صواعقَ من أيديهمُ في سحائِبِ",43,"ب",1,0],["إِذا ضَلَّ قومٌ عن سَبيلِ الهُدى اهتدوا","وأيّ ضَلالٍ للنّجوم الثواقِبِ",43,"ب",1,0],["إِذَا ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ مُتُونُهَا","رَفِيفَ الثَّنَايَا خَلْفَ حُمْرِ الْمَبَاسِمِ",44,"م",1,0],["إذا ضاقَ الخِناقُ به تنحَّى","يَلوذُ بكلِّ مُرتكَضٍ رَحيبِ",45,"ب",1,0],["إذا ضجّ الدّمُ المُهراقُ ضَجَّتْ","شعوبُكِ رحمةً للمُهرِقينا",46,"ن",2,0],["إِذا ضاقَت فِجاجُ الأرضِ عَنها","سَمَت في الجَوِّ فَاِنفَرَجَ المَضيقُ",47,"ق",1,0],["إِذا ضاقَ عَنهُم بِأسُهُم جاشَ بَأسُهُ","وَإِن أَحجَموا في حَومَةِ الحَربِ أَقدَما",48,"م",2,0],["إذا ضلَّت دَهاقينُ الثّقاتِ","وأمسى الناسُ أسرى التُّرَّهاتِ",49,"ت",1,0],["إِذا ضَرَبَت بِالبُردِ مِن دُونِ وَجهِها","تَلالا أَحَمُّ المُقلَتَينِ أَسِيلُ",50,"ل",1,0],["إِذا ضَحِكَت حَربٌ عَنِ البيضِ وَالقَنا","رَأَيتَ الدُموعَ الحُمرَ تَجري عَلى نَصلي",51,"ل",2,0],["إِذا ضَمَّ قِرناً بَينَ كَفَّيهِ خِلتَهُ","يُعاني عَروساً في غَلائِلِها الحُمرِ",52,"ر",1,0],["إِذا ضَمَّني يَوماً وَإِيّاهُ مَحفِلٌ","رَأى جانِبي وَعراً يَزيدُ عَلى الوَعرِ",53,"ر",1,0],["إِذا ضَنَّ رَبُّ المالِ أَعلَنَ جودُهُ","بِحَيَّ عَلى مالِ الأَميرِ وَأَذَّنا",54,"ن",2,0],["إِذا ضاعَ سِرُّكَ مِن مُخبِرٍ","فَأَنتَ إِذا لُمتَهُ أَلوَمُ",55,"م",1,0],["إِذا ضَحِكوا لِزَيدٍ أَو لِعَمرٍ","فَإِنَّ السَمَّ يُخَبَّأُ في العُمورِ",56,"ر",1,0],["إذا ضُرِبَتْ خِيامُكَ في مَكانٍ","فذلك حيثُ يُلتَقَطُ الجُمانُ",57,"ن",1,0],["إذا ضَحِكَتْ عُجْباً به كلُّ بلْدةٍ","بكَى مالُه مِنْ ظُلْمِهِ واهتِضامِهِ",58,"م",2,0],["إذا ضَنّ زَنْدٌمَدّ بالشّخْتِ كفَّه","ليَقْبِسَ من بعضِ الكواكبِ نارا",59,"ر",2,0],["إذا ضاحَكَتها الشَّمسُ تَبكي بأعيُنٍ","مُكلَّلةِ الأَجفانِ صُفْرِ الحَمالِقِ",60,"ق",1,0],["إذا ضعفت عن بغض بعض صديقها","بطون سبيع حملته ظهورها",61,"ر",3,1],["إذا ضمرت صارت جداية حلب","أمر أعاليها وخف الأسافل",62,"ل",1,0],["إذا ضوءها لاقى من الطير فرجةً","تدور فوق البيض مثل الدراهم",63,"م",1,0],["إذا ضَحِكَ القِرْضَابُ تِيهاً فإنّه","متى يَرَها بادِي النّدامةِ عابِس",64,"س",1,0],["إِذَا ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ كَأَنَّما","عَلَى صَفْحَتَيْهَا سُنْدُسٌ وَحَرِيرُ",65,"ر",1,0],["إِذَا ضَحَا ظِلُّكَ مَا حَالُهُمَا","مُعَاقَبَينِ وَهُمَا مَا أَذْنَبَا",66,"ب",2,0],["إِذا ضَبَبُوا يَومًا بِها الآلَ زَيَّنوا","مَسانِدَ أَشراقٍ بِها وَمَغارِبِ",67,"ب",1,0],["إذا ضمن المرء الخلود على الصبا","فما عمره الباقي سوى فضلات",68,"ت",1,0],["إذا ضيّع التاريخَ أبناءُ أمّةٍ","فأنفُسَهُم في شِرْعَةِ الحقِّ ضيِّعوا",69,"ع",3,0],["إذا ضَنَّ دهري بما أبتغيه","وباتَت عليَّ الليالي شِحاحا",70,"ح",2,0],["إذا ضَنّ مَنْ تَرْجو عَلَيكَ بنَفْعِهِ،","فذَرْهُ، فإنّ الرّزْقَ، في الأرْضِ، واسعُ",71,"ع",1,0],["إذا ضَحِكوا لزَيدٍ أو لعمرٍو،","فإنّ السّمَ يُخبأُ في العمور",72,"ر",1,0],["إذا ضَرَبُوا يوماً بها الآلَ زيّنوا","مَسانِدَ أَشراقٍ بها وَمَغارِبِ",73,"ب",1,0],["إذا ضاع عز الدين فالعز ضائع","وإن صيح هذا العز لا كسر للجبر",74,"ر",1,0],["إذا ضقت ذرعاً لأمر دها","وبهتان نفس بلا طائل",75,"ل",1,1],["إذا ضحِكوا الىَّ رأَوْه بِرًّا","أكلُّ البِرّ تقبيلٌ وضمَُّ",76,"م",1,0],["إِذا ضربنا فلا راسٌ له عنقٌ","وإِن وهبنا فلا فَقرٌ له رجلُ",77,"ل",1,0],["إِذا ضرمت أعداه ناراً فإنهم","لها حطب يوم اللقا ووقود",78,"د",1,0],["إِذا ضاق الخناق فما يرجى","فتى بسواه للضيق انفراجا",79,"ج",2,0],["إذا ضيمت فليس لها ورود","سوى لبات عاتية الطغاة",80,"ه",1,0],["إِذا ضَمّني يَوماً وَإِيَّاك مَجلِسٌ","تَشاغل في مَعناك عَن غَيرِهِ رشدي",81,"د",2,0],["إذا ضحكت أيامك البيض ناشئا","غريرا بكاك المعلقون الأشايب",82,"ب",1,0],["إذا ضممتك ثار الكون 