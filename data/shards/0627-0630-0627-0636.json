عاذل شكتي بدني ورمحي","https://www.aldiwan.net/poem44515.html","الوافر"],[372,"إذا ضاق عذر المرء في جنب ذنبه","https://www.aldiwan.net/poem4306.html","الطويل"],[383,"أمن بعد ما بان الفريق وأدلجا","https://www.aldiwan.net/poem48769.html","الطويل"],[408,"إذا ضاق أمر فارج ربك إنه","https://www.aldiwan.net/poem49972.html","الطويل"],[409,"خليلي هل من رقدة أستعيرها","https://www.aldiwan.net/poem50173.html","الطويل"],[409,"ألا هل لعهد العامرية جاحد","https://www.aldiwan.net/poem50184.html","الطويل"],[412,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[412,"سل بي كماة الوغى في كل معركة","https://www.aldiwan.net/poem32179.html","البسيط"],[419,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[432,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[440,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[442,"ويوم كسوتها رهج المصلى","https://www.aldiwan.net/poem34769.html","الوافر"],[444,"أودع من لا أستطيع وداعه","https://www.aldiwan.net/poem14325.html","الطويل"],[444,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[444,"سرور المرء مقرون ببوس","https://www.aldiwan.net/poem14375.html","الوافر"],[454,"حبانا لذيذ العيش آذار واغتدت","https://www.aldiwan.net/poem13847.html","الطويل"],[460,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[460,"وما زائد أبدا ناقص","https://www.aldiwan.net/poem55977.html","المتقارب"],[460,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[460,"روحها مخمسة خمائصا","https://www.aldiwan.net/poem56149.html","الرجز"],[460,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[463,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[463,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[463,"أقول وقد طاب النسيم بمدرجي","https://www.aldiwan.net/poem15372.html","الطويل"],[463,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[463,"هنا رجب الشهور وما يليه","https://www.aldiwan.net/poem15668.html","الوافر"],[463,"وأبلج سمح من ذؤابة خندف","https://www.aldiwan.net/poem16113.html","الطويل"],[463,"ومعسول الشمائل من نزار","https://www.aldiwan.net/poem16140.html","الوافر"],[466,"ضلالاً لواشيها وتبت يمينه","https://www.aldiwan.net/poem3410.html","عموديه"],[479,"أبارقا شمته بالغور لماحا","https://www.aldiwan.net/poem15196.html","الرجز"],[495,"وصفر كأطراف العوالي قدودها","https://www.aldiwan.net/poem67369.html","الطويل"],[542,"إذا ضل عنهم ضيفهم رفعوا له","https://www.aldiwan.net/poem56830.html","الطويل"],[553,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[555,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[555,"سرت بملام حين هوم عذلي","https://www.aldiwan.net/poem68431.html","الطويل"],[564,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[564,"كثيب فوقه غصن رطيب","https://www.aldiwan.net/poem52890.html","الوافر"],[577,"إذا ضن إلف على إلفه","https://www.aldiwan.net/poem2987.html","المتقارب"],[836,"","https://poetry.dctabudhabi.ae/diwan/poem/199898","الوافر"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/117825","الطويل"]],"verses":[["إِذا ضَرَعَ الأَقوامُ مِن سوءِ نَكبَةٍ","جَلاها قَويمُ الأَنفِ فيها أَشَمُّهُ",0,"م",2,0],["إِذا ضَرَبوا رَدّوا الحَديدَ مُثَلَّماً","وَإِن طَعَنوا رَدّوا الوَشيجَ مُدَقَّقا",1,"ق",2,0],["إِذا ضَرَبوا في الأَرضِ فَهيَ مَهالِكٌ","وَإِن أَوطَنوا الأَبياتِ فَهيَ مَحابِسُ",2,"س",1,0],["إِذا ضافَتِ الحَيَّ الحَريدَ مُغيرَةٌ","أَدَرَّ عَليها لَقحَةَ الطَعنِ عامِرُ",3,"ر",1,0],["إِذا ضافَني هَمٌّ أَمَلُّ طُروقَهُ","بِبَعضِ اللَيالي أَو أَضيقُ بِهِ صَدرا",4,"ر",2,1],["إذا ضَجَّ فيها الرَّعْدُ أُلْبِسَتِ الرُّبا","حَياً وألاحَ البَرْقُ بالمِنْصَلِ العاري",5,"ر",2,0],["إِذا ضاقَ صَدرُ المَرءِ عَن سِرِّ نَفسِهِ","فَصَدرُ الَّذي يُستَودَعُ السِرَّ أَضيَقُ",6,"ق",1,0],["إِذَا ضَمَّ أَبْطَالَ الْهِيَاجِ مُعَانِقاً","فَكَمْ مُفْرَدٍ أَوْدَى عَلاَمَتُهُ الضَّمُّ",7,"م",1,0],["إِذا ضاقَ صَدرُ المَرءِ عَن سِرَّ نَفسِهِ","فَفاضَ فَفي صَدري لَسِرِّيَ مُتَّسَع",8,"ع",1,1],["إِذا ضاءَتِ الأَحسابُ يَوماً لِمُعرِقٍ","فَعُثمانُ خَيرُ الفاتِحينَ لَهُم أَبُ",9,"ب",1,0],["إِذا ضَعَّفوا نِصفَ اِسمِهِ صارَ طائِراً","وَإِن ضَعَّفوا باقيهِ صارَ مِنَ الوَحشِ",10,"ش",1,0],["إِذا ضاعَ رَيّاهُ أَذاعَت طُيورُهُ ال","حَديثَ فَتَغني عَن قِيانٍ وَمشحبِ",11,"ب",1,0],["إِذا ضَحِكَت لَم تَنتَهِز وَتَبَسَّمَت","ثَنايا لَها كَالمُزنِ غُرٌّ ظُلومُها",12,"م",3,0],["إِذا ضَمرِيَّةٌ عَطَسَت فَنِكها","فَإِنَّ عُطاسَها طَرَفُ الوِداقِ",13,"ق",1,0],["إِذا ضَرَبَتهُ الرِيحُ رَنَّقَ فَوقَنا","عَلى حَدِّ قَوسَينا كَما رَنَّقَ النَسرُ",14,"ر",1,0],["إذا ضربت أوتار قلبي شجونه","بدت نغمات ترقص الدمع منصبّا",15,"ب",2,0],["إِذا ضَرَحنَ حَصا مَعزاءُ هاجِرَةٍ","مَدَّت سَوالِفَها في لينِ أَعضادِ",16,"د",1,0],["إِذا ضَمَّ في الرَّوعِ يَومَ الهِيَا","جِ أَخِّر وأَقدِم الى أرحِبِ",17,"ب",1,0],["اذا ضمّ في الروع يوم الوهاج","أخر واقدم الى ارحب",18,"ب",1,0],["إِذا ضُرِبَت فَوقَ الخَليجِ قِبابُنا","وَأَمسى عَلَيكَ الذِلُّ وَهوَ مُخَيِّمُ",19,"م",1,0],["إِذا ضِفتَهُم أَلفَيتَ حَولَ بُيوتِهِم","كِلاباً لَها في الدارِ عالٍ هَريرُها",20,"ر",3,0],["إذا ضحك السمار حجب ثغره","كذلك يحمي العابد الثغر والثغرا",21,"ر",2,0],["إذا ضاقت الأخلاقُ أفضتْ خلائقي","إلى سعةٍ مثلي إلى مثلها يُفضي",22,"ض",2,0],["إذا ضحكتم ضحكنا في مفارحكم","وإن بكيتم فمنا الأدمع الذُّرُفُ",23,"ف",1,1],["إذا ضاقتْ على أملٍ بلادٌ","فما سُدَّتْ على عزمٍ سبيلُ",24,"ل",1,0],["إِذا ضَحِكَت لَم تَنتَهِت وَتَبَسَّمَت","بِأَبيَضَ لَم تَكدِم مُتونَ عِظامِ",25,"م",1,0],["إِذا ضَرَبوا رَأسي وَفي الرَأسِ أَكثَري","وَغودِرَ عِندَ المُلتَقى ثَمَّ سائِري",26,"ر",2,0],["إِذا ضَحِكَت زَهواً إِلَيَّ سَماوَها","بَكَيتُ النَدى في الأَرضِ وَالبَأسَ وَالحَزما",27,"م",2,0],["إِذا ضَرَبَت في الحَربِ بِالسَيفِ كَفُّهُ","تَبَيَّنتَ أَنَّ السَيفَ بِالكَفِّ يَضرِبُ",28,"ب",1,0],["إِذا ضَرَبَ الأَميرُ رِقابَ قَومٍ","فَما لِكَرامَةٍ مَدَّ النُطوعا",29,"ع",2,0],["إِذا ضَرَبَتهُ الريحُ ماجَ كَأَنَّهُ","تَجولُ مَذاكيهِ وَتَدأى ضَراغِمُه",30,"م",2,0],["إِذا ضَوؤُها لاقى مِنَ الطَيرِ فُرجَةً","تَدَوَّرَ فَوقَ البَيضِ مِثلَ الدَراهِمِ",31,"م",1,0],["إِذا ضاقَ ما بين الحسامينِ لم يزلْ","يجولُ مجالَ العِقْدِ فوقَ الترائبِ",32,"ب",1,0],["إِذا ضُمَّ أَصحابُ الرِهانِ وَجَدتَهُ","أَخا حَلَباتٍ سابِقاً وَاِبنَ سابِقِ",33,"ق",1,0],["إِذا ضَمَّتِ الناسَ المَنازِلُ وَاِلتَقى","وَرائِيَ طَودا خِندِفٍ وَفُحولُها",34,"ل",3,0],["إِذا ضاقَ عَن قَومٍ مَكانٌ رَأَيتَنا","لَنا العَرضُ مِن أَرضِ السَماءِ وَطولُها",34,"ل",3,0],["إذا ضاحكَها البَرقُ","غَدا الغيثُ يبُاكِيها",35,"ي",3,0],["إِذا ضاقَت بِكَ الأَحوالُ يَوماً","فَثِق بِالواحِدِ الفَردِ العَلِيِّ",36,"ي",1,0],["إِذا ضاقَ الزَمانُ عَلَيكَ فَاِصبِر","وَلا تَيأَس مِنَ الفَرَجِ القَريبِ",37,"ب",1,1],["إِذا ضاقَ صَدرُ المَرءِ لَم يَصفُ عَيشُهُ","وَما يَستَطيبُ العَيشَ إِلّا المُسامِحُ",38,"ح",1,0],["إِذا ضَنَّ مَن تَرجو عَلَيكَ بِنَفعِهِ","فَدَعهُ فَإِنَّ الرِزقَ في الأَرضِ واسِعُ",39,"ع",1,0],["إِذا ضَمَّ أَقسامَ الجَمالِ تَحَيِّزٌ","فَإِنَّ جَميلَ الصَبرِ بِالحُرِّ يَقبَحُ",40,"ح",1,0],["إِذا ضاقَت بِهِ أَرضٌ جَفاها","وَلو مَلأَ النُضارُ بِها الرَكايا",41,"ا",3,0],["إذا ضَحِكَتْ لُمْبِصِرِها رياضٌ","بواكٍ فَوْقَها سُحُبٌ غِزارُ",42,"ر",1,0],["إِذا ضَارَبوا في مأزِقِ الضربِ جرّدوا","صواعقَ من أيديهمُ في سحائِبِ",43,"ب",1,0],["إِذا ضَلَّ قومٌ عن سَبيلِ الهُدى اهتدوا","وأيّ ضَلالٍ للنّجوم الثواقِبِ",43,"ب",1,0],["إِذَا ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ مُتُونُهَا","رَفِيفَ الثَّنَايَا خَلْفَ حُمْرِ الْمَبَاسِمِ",44,"م",1,0],["إذا ضاقَ الخِناقُ به تنحَّى","يَلوذُ بكلِّ مُرتكَضٍ رَحيبِ",45,"ب",1,0],["إذا ضجّ الدّمُ المُهراقُ ضَجَّتْ","شعوبُكِ رحمةً للمُهرِقينا",46,"ن",2,0],["إِذا ضاقَت فِجاجُ الأرضِ عَنها","سَمَت في الجَوِّ فَاِنفَرَجَ المَضيقُ",47,"ق",1,0],["إِذا ضاقَ عَنهُم بِأسُهُم جاشَ بَأسُهُ","وَإِن أَحجَموا في حَومَةِ الحَربِ أَقدَما",48,"م",2,0],["إذا ضلَّت دَهاقينُ الثّقاتِ","وأمسى الناسُ أسرى التُّرَّهاتِ",49,"ت",1,0],["إِذا ضَرَبَت بِالبُردِ مِن دُونِ وَجهِها","تَلالا أَحَمُّ المُقلَتَينِ أَسِيلُ",50,"ل",1,0],["إِذا ضَحِكَت حَربٌ عَنِ البيضِ وَالقَنا","رَأَيتَ الدُموعَ الحُمرَ تَجري عَلى نَصلي",51,"ل",2,0],["إِذا ضَمَّ قِرناً بَينَ كَفَّيهِ خِلتَهُ","يُعاني عَروساً في غَلائِلِها الحُمرِ",52,"ر",1,0],["إِذا ضَمَّني يَوماً وَإِيّاهُ مَحفِلٌ","رَأى جانِبي وَعراً يَزيدُ عَلى الوَعرِ",53,"ر",1,0],["إِذا ضَنَّ رَبُّ المالِ أَعلَنَ جودُهُ","بِحَيَّ عَلى مالِ الأَميرِ وَأَذَّنا",54,"ن",2,0],["إِذا ضاعَ سِرُّكَ مِن مُخبِرٍ","فَأَنتَ إِذا لُمتَهُ أَلوَمُ",55,"م",1,0],["إِذا ضَحِكوا لِزَيدٍ أَو لِعَمرٍ","فَإِنَّ السَمَّ يُخَبَّأُ في العُمورِ",56,"ر",1,0],["إذا ضُرِبَتْ خِيامُكَ في مَكانٍ","فذلك حيثُ يُلتَقَطُ الجُمانُ",57,"ن",1,0],["إذا ضَحِكَتْ عُجْباً به كلُّ بلْدةٍ","بكَى مالُه مِنْ ظُلْمِهِ واهتِضامِهِ",58,"م",2,0],["إذا ضَنّ زَنْدٌمَدّ بالشّخْتِ كفَّه","ليَقْبِسَ من بعضِ الكواكبِ نارا",59,"ر",2,0],["إذا ضاحَكَتها الشَّمسُ تَبكي بأعيُنٍ","مُكلَّلةِ الأَجفانِ صُفْرِ الحَمالِقِ",60,"ق",1,0],["إذا ضعفت عن بغض بعض صديقها","بطون سبيع حملته ظهورها",61,"ر",3,1],["إذا ضمرت صارت جداية حلب","أمر أعاليها وخف الأسافل",62,"ل",1,0],["إذا ضوءها لاقى من الطير فرجةً","تدور فوق البيض مثل الدراهم",63,"م",1,0],["إذا ضَحِكَ القِرْضَابُ تِيهاً فإنّه","متى يَرَها بادِي النّدامةِ عابِس",64,"س",1,0],["إِذَا ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ كَأَنَّما","عَلَى صَفْحَتَيْهَا سُنْدُسٌ وَحَرِيرُ",65,"ر",1,0],["إِذَا ضَحَا ظِلُّكَ مَا حَالُهُمَا","مُعَاقَبَينِ وَهُمَا مَا أَذْنَبَا",66,"ب",2,0],["إِذا ضَبَبُوا يَومًا بِها الآلَ زَيَّنوا","مَسانِدَ أَشراقٍ بِها وَمَغارِبِ",67,"ب",1,0],["إذا ضمن المرء الخلود على الصبا","فما عمره الباقي سوى فضلات",68,"ت",1,0],["إذا ضيّع التاريخَ أبناءُ أمّةٍ","فأنفُسَهُم في شِرْعَةِ الحقِّ ضيِّعوا",69,"ع",3,0],["إذا ضَنَّ دهري بما أبتغيه","وباتَت عليَّ الليالي شِحاحا",70,"ح",2,0],["إذا ضَنّ مَنْ تَرْجو عَلَيكَ بنَفْعِهِ،","فذَرْهُ، فإنّ الرّزْقَ، في الأرْضِ، واسعُ",71,"ع",1,0],["إذا ضَحِكوا لزَيدٍ أو لعمرٍو،","فإنّ السّمَ يُخبأُ في العمور",72,"ر",1,0],["إذا ضَرَبُوا يوماً بها الآلَ زيّنوا","مَسانِدَ أَشراقٍ بها وَمَغارِبِ",73,"ب",1,0],["إذا ضاع عز الدين فالعز ضائع","وإن صيح هذا العز لا كسر للجبر",74,"ر",1,0],["إذا ضقت ذرعاً لأمر دها","وبهتان نفس بلا طائل",75,"ل",1,1],["إذا ضحِكوا الىَّ رأَوْه بِرًّا","أكلُّ البِرّ تقبيلٌ وضمَُّ",76,"م",1,0],["إِذا ضربنا فلا راسٌ له عنقٌ","وإِن وهبنا فلا فَقرٌ له رجلُ",77,"ل",1,0],["إِذا ضرمت أعداه ناراً فإنهم","لها حطب يوم اللقا ووقود",78,"د",1,0],["إِذا ضاق الخناق فما يرجى","فتى بسواه للضيق انفراجا",79,"ج",2,0],["إذا ضيمت فليس لها ورود","سوى لبات عاتية الطغاة",80,"ه",1,0],["إِذا ضَمّني يَوماً وَإِيَّاك مَجلِسٌ","تَشاغل في مَعناك عَن غَيرِهِ رشدي",81,"د",2,0],["إذا ضحكت أيامك البيض ناشئا","غريرا بكاك المعلقون الأشايب",82,"ب",1,0],["إذا ضممتك ثار الكون أجمعه","ثور الرياح بقلب البلبل الغرد",83,"د",1,0],["إذا ضجّ موج البحر عانيت لوعة","مصلصلة النيران مرهوبة الغبّ",84,"ب",1,0],["إذا ضاق جيبٌ من جميل فإنني","اشقّ جيوبي ما أراد وأفضل",85,"ل",1,0],["إذ أضاعَ الجنَّاتِ آدمُ جَهلاً","خَفَّفَت عنهُ همَّهُ حواء",86,"ا",2,0],["إِذا ضُنَّ عَنْكَ بِنَوْرِ الرِّياضِ","حَبَتْكَ غَرائِبَ نَوْرِ الْكَلامِ",87,"م",1,0],["إِذا ضَلَّت قُلوبٌ عن هُداها","فَلَم تَدرِ العقابَ من الثوابِ",88,"ب",1,1],["إِذا ضَممت إلى صَدري ترائبَه","كادَت تَذوبُ تَراقيهِ من التَرفِ",89,"ف",1,0],["إِذا ضَيَّعتَ أَوَّلَ كُلِّ أَمرٍ","أَبَت أَعجازُهُ إِلّا التِواءَ",90,"ا",2,1],["إِذ أضمرَ الشاذليّ أن يسائلهُ","عَن أعظمِ اِسمٍ لِمولانا له العظمُ",91,"م",1,0],["إذا ضمها والورد فوة وكفه","فلا فرق بين اللون والطعم والتشر",92,"ر",1,0],["إذا ضُرِبَ اللِّجامُ لَهُ وَغَنَّى","فَدَعْ عنكَ الأَساحِق والمَعابِدْ",93,"د",1,0],["إذا ضَنَّ عَنّي بَاخِلٌ بِعَطائِه","فَقَد قلَّدَ الإحسانَ من حَيْثُ لا يَدرِي",94,"ي",1,1],["إِذا ضيق ألمَّ بِصَدر حرٍّ","عَلَيهِ بِالزِيارَة لِلقُبورِ",95,"ر",1,0],["إِذا ضربت خماساً في سُداس","عَلى أَعضاه تَرجع بِالكُسورِ",95,"ر",1,0],["إذا ضَربوا بكاظمةَ الخِياما","فهل لكَ مَن يُبلِّغُها السَّلاما",96,"م",2,1],["إذا ضافَهُ هَمٌّ يصافِحُ قَلّبَه","ورَتْ منه ما بين الأضالعِ نار",97,"ر",1,0],["إذا ضُرِبَت سمعتَ لها أَزيزاً","كَوَقع القطرِ في الأُدُمِ الجِلادِ",98,"د",1,0],["إذا ضاق عذر المرء في جنب ذنبه","فعذري إِلى مولاي بالصدق واسع",99,"ع",1,1],["إِذا ضاقَ القرحان أَحمى شُجونَهُ","وَإِن خالج القَلب المُؤَجَج أَثلَجا",100,"ج",2,0],["إذا ضاقَ أمرٌ فارجُ ربَّكَ إنَّهُ","قديرٌ على تَيسيرِ كُلِّ عَسيرِ",101,"ر",1,1],["إِذا ضاقَ صَدرُ المجتَدي أَو فَناؤُهُ","فَقَد رَحُبَت ساحاتها وَصُدورُها",102,"ر",3,0],["إِذا ضَلَّتِ القُصّاد عَن حَوض ماجِدٍ","يَكونُ لَها مِن مكرماتك راشِدُ",103,"د",1,0],["إذا ضَاق بالخَطِّيِ مُعتَركُ الوغَى","وهالَ الرّدَى وقعُ الظُّبا في الجَماجِمِ",104,"م",1,1],["إذا ضربتُ به قِرناً أُنازِلُه","أوحاهُ عن عائِدٍ يَغشاهُ أو آسِي",105,"س",2,0],["إذا ضعضعَ الخطب الجبال فاًنَّه","هو الجبل الطود الذي لا يضعضعُ",106,"ع",1,0],["إذا ضاق الزمان فكن صبوراً","ففي الأيام ضيقٌ واتساعُ",107,"ع",1,0],["إذا ضمت أناملهُ يراعا","سل الهنديّ ما فعل اليراعُ",107,"ع",1,0],["إذا ضرب الخالين من سورة الهوى","يفجّر من حبّ القلوب له حبّا",108,"ب",2,0],["إذا ضَلَّ العجاجُ بِهَا هَدَاها","جبينُكَ أنْ تُعَرِّجَ أو تَضِلّا",109,"ل",2,0],["إذا ضاق أمر فارج بعد مضيقه","عليك من اللَه الكريم اتساعه",110,"ع",2,0],["إذا ضرب الرباب لهم نساء","تجيب السبق سجلاء النهيق",111,"ق",1,0],["إذا ضحكت لك الأيام فاحذر","هجوم النائبات من العبوس",112,"س",1,0],["إِذا ضمَّها عَرْفُ الكمائم ضمختْ","صَباه وسامته معاطفها اللُّطفا",113,"ف",2,0],["إذا ضاقت رحابُ الرأي جاءت","بصيرته ففرجت ازدحامه",114,"م",2,0],["إذا ضلَّ فهمُ الدليل الحليم","هدَى الناسَ منه دليلٌ جهولُ",115,"ل",1,0],["إذا ضاق بالسير ذرعُ الرفيق","ملأتُ بهنّ فروجَ الملا",116,"ل",2,0],["إذا ضممن في الدجى القَرابصا","نمَّ عليهن الحُليُّ آبصا",117,"ص",2,0],["إذا ضمّني مؤيّد الملك مانعاً","فما لدمِ الأيّام عندِيَ ثارُ",118,"ر",1,0],["إذا ضاقت الأهب الفسيحة بالجوى","نشقن نسيماً أو تسمعن حاديا",119,"ي",2,0],["إذا ضمئتْ من هجير الضَّحاء","عَلَّ دَمَ الهام ظَمْآنُها",120,"ن",3,0],["اذا ضاقت الدُّنيا عليهم خصاصةً","فنائلهُ رحْبٌ ومنزلهُ رحْبُ",121,"ب",1,0],["إِذا ضل عافيهم عن القصد في الدجى","أضاؤوه نيرانَ القِرى والمَجاليا",122,"ي",2,0],["اذا ضَمنَ التَّنَسُّكُ فيه أجْراً","فمدحُ عُلاكَ يكْفلُ بالنَّولِ",123,"ل",1,0],["إذا ضاق شُكري عن نداهُ الذي له","بكُلِّمقامٍ زَخْرَةٌ وعُبابُ",124,"ب",1,0],["إذا ضَلَّتْ رَويَّةُ أَلْمَعِيٍّ","أصابَ الأمر في الرَّأي ارْتجالا",125,"ل",2,0],["إذا ضمَّهُ والأرحبي تنوفه","تشابهَ فيها جسمهُ ووضينه",126,"ن",2,0],["اِذا ضللتُ هداني برقُ مبسمِها","حتى كأني قد استنورتُ مِصباحا",127,"ح",2,0],["إِذا ضَرَبَت أَعناقَها في رِضا الدُجى","أَعارَتهُ مِن أَنوارِها خِلَعَ الفَجرِ",128,"ر",1,0],["إِذا ضَلَّ عَنهُم ضَيفُهُم رَفَعوا لَهُ","مِن النارِ في الظَلماءِ أَلويَةً حُمرا",129,"ر",2,1],["إذا ضرّني يوماً صديقي وساءَنِي","فَما هوَ إلّا كالعدوِّ المكاشِحِ",130,"ح",1,0],["إِذا ضُيِّعَ الرَأيُ اِستَشَفَّ كَأَنَّهُ","شَواهِقُ رَضوى لَيسَ في خُلقِهِ دَخلُ",131,"ل",1,0],["إِذا ضافَهُ هَمُّ قَراهُ عَزيمَةً","هِيَ الهَمُّ ما لَم يَغشَ وِرداً فَيَنزِلِ",132,"ل",1,0],["إذا ضلَّ عنكَ الشِّعرُ فاطلُبْهُ تلقَهُ","إلى غربِ لُبنانَ اهتَدَى من ضَلالِهِ",133,"ل",2,0],["إذا ضاقت جوانبُهُ بوَفْدٍ","تَوَسَّعَ صدرُ صاحبِهِ الرَّحيبُ",134,"ب",1,0],["إِذا ضَنَّ إِلفٌ على إِلْفِه","فإِلفي ضَنينٌ بأَن لا تَهَب",135,"ب",1,1],["إذا ضيقت أمراً ضاق جداً","وإن هونت ما قد ضاق هانا",136,"ن",2,1],["إذا ضَيَّعَ الأنذالُ في المحلِ خيلَهُم","فلم يركبوا حتى تهيجَ المصائِف",137,"ف",1,1]]}