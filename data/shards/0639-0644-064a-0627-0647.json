{"poems":[[52,"ذكرت شبابي اللذ غير قريب","https://www.aldiwan.net/poem64805.html","الكامل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39470","السريع"],[242,"على أهل العلاء أبي علي","https://www.aldiwan.net/poem19757.html","الوافر"],[412,"أيا من نعاه لسان القريض","https://www.aldiwan.net/poem50146.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126855","الطويل"],[804,"","https://poetry.dctabudhabi.ae/diwan/poem/73831","المتقارب"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72308","الطويل"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130644","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112868","الطويل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146358","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89116","الكامل"],[4702,"علام الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155110",""],[4759,"ومن أحرى بحبك؟","https://www.poetsgate.com/ViewPoem.aspx?id=204362",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[5703,"أحلام تحتضر","https://www.poetsgate.com/ViewPoem.aspx?id=207022",""],[5787,"سلام كما هبت شمال مريضة","https://www.poetsgate.com/ViewPoem.aspx?id=169335",""],[5829,"ونرجوا في أماسينا سرورا","https://www.poetsgate.com/ViewPoem.aspx?id=165997",""],[5893,"ما للعرب تاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=141278",""],[6259,"أيا من نعاه لسانُ القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59411&r=&rc=59",""]],"verses":[["عَلى أَهلِها تَجني بَراقِشُ فَاِتَّقوا","جِنايَةَ عَبدٍ وَاِسعَدوا بِقُلوبِ",0,"ب",1,0],["على أَهازيجِ ظُباً بَينَها","ما شِئتَ من حَذْفٍ ومن خَرْمِ",1,"م",1,0],["عَلَى أَهْلِ الْعَلاَءِ أَبِي عَلِيِّ","سَلاَمٌ مِنْ أَخِي سَلَمٍ صَفِيِّ",2,"ي",1,1],["عَلى أَهل مَكَّةَ مني السَلامُ","ومن ثًفني الودَّ أَو أَصفِهِ",3,"ف",2,0],["على أهل صفا معهم زماني","فأدبر عندما أودوا صفايا",4,"ا",3,0],["على أهل دين اللّه ظلماً قدِ اِعتَدى","ولم يرعَ عهداً للبلادِ ولا ذِمَم",5,"م",1,0],["عَلى أَهلِ مُرسِيَةٍ لَعنَةٌ","تَعُمُّ الدِّيارَ وَأَربابَها",6,"ب",3,1],["على أهل بيت المصطفى من الاههم","صلاة لها غيث يسح هطول",7,"ل",1,0],["علياه أضحت غرة","في جبهة الايام غرا",8,"ر",2,0],["على أهل طاعات الإله أذلة","وعند جميع الكافرين ترفعوا",9,"ع",3,0],["عَلياه تحت عَجاج الحالِ واضحةٌ","كطلعة البدر ما أَزرى بها الكَلَف",10,"ف",1,0],["على أهل إفريقيّة من صبرها","بكم منّت الوطفا على الأرض بالخصب",11,"ب",1,0],["علياه في حرم السرور تنزهت","وتنزهت عن غير ذاك الحيدر",12,"ر",1,0],["على اهل الشعر محسوبين مثل الكسر جا مجبور","كمل فيه العدد واحد بعد ماتم تعديله",13,"ل",2,0],["على أهدابها كحلت عيون","وفوق جفونها ينداح سعد",14,"د",1,0],["علِّي أهيب به من فوق ربوته","فإنما هو أنغام وألحان",15,"ن",1,0],["علّي أُهَدْهدُ في لحونِ صبابتي","قلباً منَ الأشواقِ باتَ مَريضا",16,"ض",2,0],["على أهل ذاك الحي من تلكم الربى","سلام وهل يجدي السلام سليمها",17,"م",3,0],["على أهوائنا سرنا وثرنا","وصار الرأي مذموما حسيرا",18,"ر",2,0],["على اهل الإسلام يبرون الأقلام","وعلى النسا دارت رحاهم زياده",19,"د",2,0],["على أهل مكة مني السلامُ","ومن يُصفني الوُدَّ أو أصفه",20,"ف",2,0]]}