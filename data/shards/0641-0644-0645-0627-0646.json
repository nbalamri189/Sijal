{"poems":[[55,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[57,"وصلت فلما لم أر الوصل نافعي","https://www.aldiwan.net/poem26185.html","الطويل"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[90,"سيوف لحاظ أم قسي حواجب","https://www.aldiwan.net/poem44401.html","الطويل"],[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[40,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[45,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[47,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[30,"عجبتُ لركب فرحتهم مليحة","https://www.aldiwan.net/poem1235.html",""],[33,"لقد حببت نعم إلي بوجهها","https://www.aldiwan.net/poem42251.html","الطويل"],[41,"لحى الله قوما أسلموا يوم بابل","https://www.aldiwan.net/poem53758.html","الطويل"],[13,"ألا من مبلغ فتيان فهم","https://www.aldiwan.net/poem2194.html","الوافر"],[54,"بادرت منه موعدا حاضرا","https://www.aldiwan.net/poem27336.html","السريع"],[52,"تثاقل ليلي فما أبرح","https://www.aldiwan.net/poem63978.html","المتقارب"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[119,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[146,"لقاؤك يا لبنى خيال","https://www.aldiwan.net/poem58405.html","الطويل"],[146,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[240,"لحا الله ليلا في العراق سهرته","https://www.aldiwan.net/poem32089.html","الطويل"],[261,"سقاني كأسه سحرا بوقت","https://www.aldiwan.net/poem48365.html","الوافر"],[275,"أعيناك حينا ترنوان إلى الزهر","https://www.aldiwan.net/poem35619.html","الطويل"],[302,"دع الندامة لا يذهب بك الندم","https://www.aldiwan.net/poem33172.html","البسيط"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[374,"رعى الله عيشاً نعمنا به","https://www.aldiwan.net/poem4289.html","المتقارب"],[376,"أرى جمرات في مسالك أنفاسي","https://www.aldiwan.net/poem57359.html","الطويل"],[388,"فلم أنسهم يوم الخميس وكرهم","https://www.aldiwan.net/poem24192.html","الطويل"],[409,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[454,"العبور","https://www.aldiwan.net/poem1007.html",""],[457,"حنانيك يا ورقاء حتى م تسجعي","https://www.aldiwan.net/poem13832.html","الطويل"],[463,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[518,"ولما أتونا بالمطايا وقربوا","https://www.aldiwan.net/poem67763.html","الطويل"],[520,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[543,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104036","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119352","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96584","الطويل"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131924",""],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136790",""],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35696","المتقارب"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82546","المتقارب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48941","المنسرح"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144594","الهزج"],[1694,"","https://poetry.dctabudhabi.ae/diwan/poem/144684","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46470","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48261","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121928","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77357","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77281","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106991","الطويل"],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102023","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201754","الوافر"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99493","المتقارب"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99470","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112414","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112333","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89398","الطويل"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/11","المتقارب"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36743","الطويل"],[3735,"","https://poetry.dctabudhabi.ae/diwan/poem/26587","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135096","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66145","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"قوافي الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=181926",""],[4834,"فيا عجبا من غلة كلما ارتوت","https://www.poetsgate.com/ViewPoem.aspx?id=170957",""],[4884,"لقاضٍ مهاب","https://www.poetsgate.com/ViewPoem.aspx?id=212244",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5092,"لهُ الحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=179342",""],[5593,"لخمرة عندي حديث يطول","https://www.poetsgate.com/ViewPoem.aspx?id=181056",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5911,"دببت على الْخَطِيب قبيل نوم","https://www.poetsgate.com/ViewPoem.aspx?id=188974",""],[6112,"تطاول ليلي لم أنمه تقلباً","https://www.poetsgate.com/ViewPoem.aspx?id=186531",""],[2220,"خليليّ عُوجا بالكَثِيبِ وعَرِّجَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19262&r=&rc=804",""]],"verses":[["فَلِم أَنا كَالغَريبِ وَراءَ قَومٍ","لَوِ اِختُبِروا لَقَد كانوا وَرائي",0,"ا",2,0],["فَلَمّا نَقَلتُ الدَمعَ مِن مُستَقَرِّهِ","إِلى ساحَةٍ مِن خَدِّ حَرّانِ مُعوِلِ",1,"ل",1,0],["فَلَمّا نَضَحنَ اللَوحَ إِنصافَ نَضحَةٍ","بِجَونٍ لِأَدواءِ الصَرائِرِ قاصِعِ",2,"ع",1,0],["فلم أنسها واللهّ يوم تعّرضت","لنا بين هاتيك الظباء السوارب",3,"ب",1,0],["فلما نفيتم عن تهامة كلِّها","بيوتاً هي الأدنى إليكم نسيبُها",4,"ب",3,0],["فَلَمّا نَشَّتِ الغُدرانُ عَنهُ","وَهاجَ البَقلُ وَاِقطَرَّ اِقطِرارا",5,"ر",2,0],["فَلَمّا نَشَحناهُنَّ مِنهُ بِشَربَةٍ","رَكِبنا فَيَمَّمنا بِهِنَّ الفَيافِيا",6,"ي",2,0],["فَلَمّا نَظَرتُ إِلى عَقلِهِ","رَأَيتُ النُهى كُلَّها في الخُصى",7,"ا",1,0],["فَلَمّا نَشِفنَ لَقينَ السِياطَ","بِمِثلِ صَفا البَلَدِ الماحِلِ",8,"ل",1,0],["فَلَم أَنظُر بِهِ السُكرَ","وَخَيرُ الأَمرِ ما اِستُعجِل",9,"ل",1,0],["فَلَمّا نَزَلنا وَاِختَلَطنا بِأَهلِها","بَكوا وَاِشتَكَينا أَيَّ ساعَةَ مُشتَكى",10,"ا",1,0],["فَلَم أَنسَ مِلأَشياءِ لا أَنسَ نَظرَتي","إِلَيها وَتِربَيها وَنَحنُ لَدى سَلعِ",11,"ع",1,0],["فَلَمّا نَعى الناعي يَزيدَ تَزَلزَلَت","بِنا الأَرضُ وَاِرتَجَّت بِمِثلِ الصَواعِقِ",12,"ق",1,0],["فَلَم أَنفَكُّ مُتَّكِئً لَدَيها","لِأَنظُرَ مُصبِحاً ماذا أَتاني",13,"ن",2,0],["فَلَم أَنَل مِنهُ سِوى قُبلَةٍ","وَأَرجَفَ الناسُ بِأَشياءِ",14,"ا",2,0],["فَلَمّا نَهاني إِمامُ الهُدى","وَلاحَ لي المَطلَعُ الأَفيَحُ",15,"ح",1,0],["فَلَمّا نَجا مِن ذَلِكَ الكَربِ لَم يَزَل","يُمَظِّعُها ماءَ اللِحاءِ لِتَذبُلا",16,"ل",2,0],["فَلَما نَعَوْا تِلْكَ الْفَتَاةَ لأُمِّهَا","أَلَمَّ بِهَا سُكْرٌ وَمَا هِيَ فِي سُكْرِ",17,"ر",1,0],["فَلَمّا نَما كَالهِلالِ اِستَوى","وَكَالزَرعِ آزَرَ فَاِستَغلَظا",18,"ظ",2,0],["فَلَمّا نَما وَسَما يافِعاً","وَرُعتُ بِهِ الصمَم الفُتَّكا",19,"ك",2,0],["فلم اندبك والايام تبدي","قطوبا غير يعقبه ابتسام",20,"م",1,0],["فلْمِ أنا في ميزان عدلك كِفَّتِى","تشِفُّ إذا قابلتَها بمثالِ",21,"ل",1,0],["فلما نَمَى الدينَ أشبالُه","أناب وأطلقَ تلك الفنونا",22,"ن",2,0],["فَلَمّا نَضى عَنّي الظَلامُ رِدائَهُ","تَيَمَّمتُ سوقاً لِلمَدائِحِ كاسِدا",23,"د",2,0],["فلما نمت قام وقال بروا","لمن حولي خوى خاني بجفت",24,"ت",1,0],["فلم أنتصح حتى أذبتُ حَشاشتي","وعانيتُ ما عانى الشُّجاعُ من الأسر",25,"ر",1,0],["فَلَم أَنَل عندها مِمّا أُؤمِّلُه","إِلّا أَمانيَّ نفس كلُّها حُلمُ",26,"م",1,0],["فلمّا نَضا الأُفْقُ بُرْدَ الظّلا","مِ ثاروا إلى خَيلهمْ باللُّجُم",27,"م",1,0],["فلمّا نَشْرتَ لواءَ الأصي","لِ نالَتْكَ عيني وفي الوقتِ ضيق",28,"ق",1,0],["فلما نأى أخملتني الخطوبُ","لمُن قَدرُه بالحيا خامل",29,"ل",1,0],["فلِم أنا في وَهدٍ من الأرضِ هابطٍ","وبالقُربِ مني للعُلى جَبلٌ راسِ",30,"س",1,0],["فَلَم أَنسَهُم يَومَ الخَميسِ وَكَرَّهُم","عَلَيهِ وَيَومَ القَصرِ إِذ حُرِسَ القَصرُ",31,"ر",1,1],["فلم أنس إذ وافى الصباح كأنه","عدو بتفريق الأحبة مولع",32,"ع",1,0],["فلما نهلنا من معين فراته","غدونا بآيات البيان ندرس",33,"س",1,0],["فلم أنسَ لا أنسى الوداع وموقفاً","وقفت به أبكي ويبكي مودعي",34,"ع",2,0],["فلمْ أنت رَاضٍ لي وللمجد وقفةً","تزَاحَمَ دمع اليأس فيها على خدِّي",35,"د",2,0],["فلم أنس إذ قيدت رحل مطيتي","وقلت لحادي الذود لم لا تقودها",36,"د",3,0],["فلم أنفت أن تعد منهم","أوائلاً زاكية الأواخر",37,"ر",1,0],["فلم أنسَ يا مولاي إنقاذَ مُهجَتي","وقد نشبوا في مُهجتي النَّابَ والظُّفرا",38,"ر",2,0],["فَلَمّا نَحَينَ النورَ خَرَّينَ تَحتَهُ","عَلى أَمَلٍ يُشجى بِهِ اليَأسُ وَالمَطلُ",39,"ل",1,0],["فَلَم أَنَّ سُبحانَ الفَصاحَةِ قائِمٌ","في بَابِها ما قالَ غَيرَ مُتَعتَعِ",40,"ع",1,0],["فلما نشا النّوار فيها ظَننتُها","قبابك يا منصورُ حين تُرفعُ",41,"ع",1,0],["فلما نأى عني الصلاح وصافحت","أنامل حظي والأديم أديمها",42,"م",3,0],["فلما نهاها اليأسُ أَن تُؤنِسَ الحِمَى","حِمَى البئرِ جَلَّى عَبرَةَ العينِ جالُها",43,"ل",3,0],["فلما نما الإسلامُ واعتزَّ أهلُه","غدتْ عَرَقاً منه العِدى تتصبَّب",44,"ب",1,0],["فلم أنس أوقات أنسٍ بها","تقضت وكانت لعمري قصارا",45,"ر",2,0],["فَلَمّا نَظَرتَ إِلى جُرحِها","وَضَعتَ الدَواءَ عَلى دائِها",46,"ا",3,0],["فَلَمّا نَأَت كَيفَ كُنّا لها","وَلَما دنت كَيف كنّا بِها",47,"ب",3,0],["فلم أَنل في القريض غيرَ رضى","نفسي وهذي فوائدُ الشعرِ",48,"ر",1,0],["فلمّا نَزلَ الأقَمّ","رُ للريِّ إلى النهرِ",49,"ر",1,0],["فلما نأت عنا العشيرة كلها","أقمنا وحالفنا السيوف على الدهر",50,"ر",1,0],["فَلَمّا نَأَت داري وَمالَ بِكَ الهَوى","إِلَيها وَلَم يَسكُن إِلَيكَ رَشيدُها",51,"د",3,0],["فلَمّا نَزَلنا بِبَعضِ الهُجولِ","شَكَونا إلى البرِّ طُولَ القَوى",52,"ا",1,0],["فَلَما نَعى الناعي بِهِ طاشَت النُهى","وَخامَرَها خُبل هُناكَ عَجيب",53,"ب",1,0],["فلم أنْسَها واللهِ ما عشتُ ليلةً","جلا سُدْفَتَيها وجهُك المتهَلِّلُ",54,"ل",1,0],["فلم أنتبه الا وقلبى متيم","يطوف به داعى الهوى ويدور",55,"ر",1,0],["فَلَم أَنظُر لِأَموالٍ جِسامٍ","وَلَم أَحفِل بِأَلقابٍ ضِخامِ",56,"م",1,0],["فَلِما نَخافُ عَلى المَزارِعِ وَالقُرى","غَرَقاً تَظَلُّ لَهُ الجُسورُ تُرَمَّمُ",57,"م",1,0],["فلم أنس يوم الهجر يبسم ثغرها","وابكي بطرف واكف الدمع وارق",58,"ق",1,0],["فلم أنس لا والله يومك يا أبي","وهيهات إن ينساك قلبي مدى المدى",59,"د",2,0],["فلما نال تغذيةً وريّاً","بمائي رام ريّاً من دمائي",60,"ا",2,0],["فلما نذرت بهم صاحبي","ولاحت موائده أوجعوا",61,"ع",3,0],["فلما نهضت أتاني الكتاب","وجاء الهدايا ووافى الرسول",62,"ل",1,0],["فَلَمّا نزَلنَا بها","مشَينَا بوادٍ عميق",63,"ق",1,0],["فلم أنظُر لَهُ أثراً","ولم أسمع لَهُ ذكرا",64,"ر",2,0],["فلما نظرت الطين طيَّنَ فكرتي","وقطَّع نخلي من نجيل وأحجان",65,"ن",1,0],["فَلَمّا نَأَوا سَبَقَت عَبرَتي","وَأَذرَت لَها بَعدَ سَجلٍ سِجالا",66,"ل",2,0],["فَلَم أَنسَ إِذ جاءَت تَهُزُّ مَعاطِفاً","عَلَيها مِنَ الدِيباجِ وَشيَ مُذَهَّبُ",67,"ب",1,0],["فَلَم أَنكُل وَلَم أَجبُن وَلَكِن","يَمَمتُ بِها أَبا صَخرِ بنِ عَمرِو",68,"ر",2,0],["فلم أنس سرا قد أذاعته عندما","سترت بكفي الدمع وهو يفور",69,"ر",1,0],["فلم انثن عنها لبعدي وطالما","أحاول وصلا كان كالعظم والدم",70,"م",1,0],["فَلما نَجا مِنْها وافْرَخَ رُوْعُهُ","اغارَتْ كَلَيْثٍ من طِلا الضَّغْنِ شارِب",71,"ب