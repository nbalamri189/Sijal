0,"البَصْمَة","https://www.poetsgate.com/ViewPoem.aspx?id=200696",""],[5752,"في محراب الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=1331",""],[5809,"ذهول","https://www.poetsgate.com/ViewPoem.aspx?id=205301",""],[5829,"نوبة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=190684",""],[5837,"كسر الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=191880",""],[5848,"أوراق الزهر","https://www.poetsgate.com/ViewPoem.aspx?id=49230",""],[5885,"البئر قد جف","https://www.poetsgate.com/ViewPoem.aspx?id=203025",""],[5956,"كما الشوق شاء","https://www.poetsgate.com/ViewPoem.aspx?id=182091",""],[5956,"شكراً لمن رعى","https://www.poetsgate.com/ViewPoem.aspx?id=183592",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"إلهي هل لديك مزيدُ حب؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=192558",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[5969,"شِفاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=204788",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6056,"حبات دمعي","https://www.poetsgate.com/ViewPoem.aspx?id=130313",""],[6056,"رحيق الذات","https://www.poetsgate.com/ViewPoem.aspx?id=130317",""],[6127,"صُفِّ الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=189733",""],[6127,"أبى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190758",""],[5377,"لحظات الإشراق الفني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79566&r=&rc=22",""],[6171,"أميرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86321&r=&rc=1",""],[6264,"طيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79107&r=&rc=29",""],[5490,"العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81965&r=&rc=52",""],[4222,"قد خطبنا للمستضيء بمصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52791&r=&rc=83",""]],"verses":[["وَأَشعَثِ المَفرِقِ ذي هِمَّةٍ","طَوَّحَهُ الهَمُّ بَعيداً فَطاح",0,"ح",1,0],["وَأَشْعَرَ قَلْبَهُ فَرَقَ المنايا","وَأَوْدَعَ سَمْعَهُ نَغَمَ المُغَنِّي",1,"ن",2,0],["وَأَشْعَثَ مُنْقَدِّ القَميصِ تَلُفُّهُ","إِلى الدِّفءِ هَوْجاءُ الهُبوبِ عَقيمُ",2,"م",1,1],["وَأَشعَثَ رِخوِ المَنكِبَينِ بَعَثتُهُ","وَلِلنَومِ مِنهُ في العِظامِ دَبيبُ",3,"ب",1,1],["وَأَشعَلتُ جِلدَ اللَيلِ مِنّي بِزَفرَةٍ","غَرامِيَّةٍ مِنها الشَرارُ يَطيرُ",4,"ر",1,0],["وَأَشعِرُهُ أَنّي اِنتَحَبتُ البَديلَ","وَأُعلِمهُ أَنّي اِستَجَدتُ العِوَض",5,"ض",1,0],["وَأَشعَرتُها نَفثاً بَليغاً فَلَو تَرى","وَقَد جُعِلَت أَن تَرعِيَ النَفثَ بالَها",6,"ل",3,0],["وَأَشعَثَ قَد سامَيتُهُ جَوزَ قَفرَةٍ","سَواءٌ عَلَينا ضَحوُها وَظَلامُها",7,"م",3,0],["وَأَشعَثَ قَد نَبَّهتُهُ عِندَ رَسلَةٍ","طَليحَينِ بَلوى شِقَّةٍ وَتَنائِفِ",8,"ف",1,0],["وَأَشعَثَ عاري الضَرَّتَينِ مُشَجَّجٍ","بِأَيدي السَبايا لا تَرى مِثلَهُ جَبرا",9,"ر",2,0],["وَأَشعَثُ مِثلِ السَيفِ قَد لاحَ جِسمُهُ","وَجيفُ المَهارى وَالهُمومُ الأَباعِدُ",10,"د",1,0],["وَأَشعَثَ مَغلوبٍ عَلى شَدَنيَّةٍ","يَلوحُ بِها تَحجينُها وَصَليبُها",11,"ب",3,0],["وَأَشعَثَ قَد قايَستُه عَرضَ هَوجَل","سَواءٌ عَلَينا صَحوُهُ وَغَياهِبُه",12,"ب",2,0],["واشعث في الدار ذي لِمةٍ","يطيل الحفُوف ولا يَقْمَلُ",13,"ل",1,1],["وَأَشعَثَ مالَهُ فَضَلاتُ ثَولٍ","عَلى أَركانِ مَهلَكَةٍ زَهوقِ",14,"ق",1,1],["وَأَشعَثَ بَوشِىٍّ شَفَينا أُحاحَهُ","غَداتَئِذٍ ذي جَردَةٍ مُتَماحِلِ",15,"ل",1,0],["وَأَشعَثَ في الدارِ ذي لِمَّةٍ","لَدى إِرِثِ حَوضٍ نَفاهُ الأَتِيُّ",16,"ي",1,0],["وأُشعِرُ قلبي اليأسَ عنها تصبُّراً","فيرجِعُ مرتاباً به لا يُصَدِّقُ",17,"ق",1,0],["وَأَشعَثَ قَد طارَت قَنازِعُ رَأسِهِ","دَعَوتُ عَلى طولِ الكَرى وَدَعاني",18,"ن",2,0],["وأشعرني العذاب بعمق جرحي","وأعمق منه جرح الكبرياءِ",19,"ا",2,0],["وأَشَعْتَ فيها الرأيَ لا مُتَهَيِّبَاً","حَرَجَاً، ولا مُتَرَجِّيَاً تَهْلِيلا",20,"ل",2,0],["وَاِشعِر فُؤادَكَ سَلوَةً","عَنها وَعَن أَترابِها",21,"ب",3,0],["وَأَشعَثَ إِن دَعَوتَ أَجابَ وَهناً","عَلى طولِ الكَرى وَعَلى الدُؤوبِ",22,"ب",1,0],["وَأَشعَثَ هَبّالاً إِلى الكورِ رَأسُهُ","أُشَبِّهُهُ في آخِرِ اللَيلِ هُدهُدا",23,"د",2,0],["وَأَشعَثَ يَهوى النَومَ قُلتُ لَهُ اِرتَحِل","إِذا ما النُجومُ أَعرَضَت وَاِسبَطَرَّتِ",24,"ت",1,0],["وأشعلَ ورديٍّ وأصفرَ مُذْهَبٍ","وأدهمَ وضّاحٍ وأشهبَ أقمرا",25,"ر",2,0],["وَأَشعُرُ أَنَّ العَقلَ يَصحَبُ تارَةً","وَيَنفُرُ أُخرى وَهوَ غَيرُ عَليمِ",26,"م",1,0],["وَأَشْعُرُ أَنْ الشِّعْرَ لَيْسَ بِمَانِحِي","لَدَى خَطْبِهِ إِلاَّ نَحِيبَ المُعَدِّدِ",27,"د",1,0],["وَأَشعَرَها وَأَخطَبَها","وَأَضرَبَها وَأَطعَنَها",28,"ن",3,0],["وأَشْعُرُ أَنّ الْكَوْنَ عَأدَتْ حَيَاتُه","إِليهِ وَأَنّ الأُنْسَ قَدْ آبَ غَائِبُه",29,"ب",2,0],["وأشعتم في الحيّ أنّي شرّ","يتفادى دنوّه ... ونذيره",30,"ر",2,0],["وأَشِعْ غِناكَ وَكُنْ لِفَقْرِكَ صائِنا","يضني حشاك وأنت لا",31,"ل",2,0],["وأشعرت فيه بالصلاة فأقبلت","جيوشك واستنت من العجم والعربِ",32,"ب",1,0],["وأَشعْتَ في الثَّقَليْن موقعَ ذكرِه","فجرتْ به الأفواهُ بعدَ خموله",33,"ل",2,0],["وَأَشِعَّةً من بَدرِ لَيلكِ نَوَّرَت","ياقوتَ خنجَرِ خصرِكِ المشكوكِ",34,"ك",1,0],["وَأَشعَلتَ في لَيليَ المكفهرِّ","مشاعِلَ حُبِّكَ في أَعيُني",35,"ي",1,0],["وأشعارُنا لغةٌ بَيننا","ولكنَّها عجمةٌ للأنام",36,"م",1,0],["وأشعثَ مثلِ السَّيف قد مَنَّهُ السُّرَى","وقطعُ الفيافي مُهْرَقاً بعدَ مُهْرَقِ",37,"ق",1,0],["واشعر القلب خوفاً لا يفارقه","من ربه معه مثل من الرغب",38,"ب",1,0],["وَأَشعَثَ قَد قَدَّ السِفارُ قَميصَهُ","وَجَرُّ الشِواءِ بِالعَصا غَيرُ مُنضَجِ",39,"ج",1,0],["وَأَشعَثَ يَزهاهُ النُبوحُ مُدَفَّعٍ","عَنِ الزادِ مِمَّن خَلَّفَ الدَهرُ مُحثَلِ",40,"ل",1,0],["وأَشَعيا يَقولُ قَولَ صَدوقٍ","وصَريحٍ يَبُثُّهُ الإيماءُ",41,"ا",2,0],["وأشعلا نار حرب بينهم سنة","حتى أضرا بمن قد حل في اليمن",42,"ن",1,0],["وأشعثَ مثلُ أهلِ النارِ ثاوٍ","بأخضرَ كلُّ شطٍّ منهُ جَنّهْ",43,"ن",2,1],["واشعت افراحاً مكان","مآتم ومقابر",44,"ر",1,0],["وَأَشعَثَ مَهدومِ السَراةِ كَأَنَّهُ","هِلالٌ تَوَفّى عِدَّةَ الشَهرِ أَحدَبا",45,"ب",2,0],["وَأشعَثَ سَجَّادٍ بآيَاتِ رَبِّهِ","قَلِيلِ الاَذَى فِيمَا تَرَى العَينُ مُسلِمِ",46,"م",1,1],["وأشعرنا الحزمُ قبلَ اللّقاءِ","بيومٍ يسيل ردىً أرْدَنانِ",47,"ن",1,0],["وأَشعَرِيُّ الحبِّ لا","يقولُ بالمعدوم",48,"م",1,0],["وأَشِعْ بشائِرَ بُرئِه ثم انظروا","كَمدَ الصليِبِ به وبُشْرى المصحَفِ",49,"ف",1,0],["وَأَشعُرُ أَنّي في بِلادي كَأَنَّما","تُخاطِبُني الأَرواحُ مِن كُلِّ مَقبَرِ",50,"ر",1,0],["وأشعل دون موطنه سعيرا","فهز الأرض بينهم اصطدامُ",51,"م",1,0],["وأشعثٍ يَحْسِرُ سِتْ","رَ المورِ عن جَعْدٍ قطَط",52,"ط",1,0],["وأَشْعُرُ بالشوقِ حتى يزيدَ","فَيُغْمَى عليَّ ولا أَشْعُر",53,"ر",1,0],["وأشعارٌ... وأوزانٌ تُغنَّى","وبعضٌ من قوافي قد بنيت",54,"ت",1,0],["واشعل وجودي من بارق فيضه","بلامعة تمحو ظلام صفاتيا",55,"ي",2,0],["وأشعرتني نفعي وضري مهيئاً","مسالك نفعي وابتعاد مضرتي",56,"ت",2,0],["وَأَشعَث يَسعى عَلى صِبيَةٍ","مِثل فِراخِ الطَيرِ مَجهودِ",57,"د",1,0],["وأَشعلتُ في الصدر نارَ اللِّقا","ورأسي بشيبِ البِعادِ اشتعل",58,"ل",1,0],["وأشعرهم من في المَشاعِر أَنَّهم","بشاطي مني يَبدو لهم ربّهم معا",59,"ع",2,0],["وأشعار وَأَلحان","وَرضوان وَمختار",60,"ر",1,0],["وأشعثُ ليس أرفع ذي يمانٍ","وما هو إن عددت من الذوينا",61,"ن",2,0],["وأشعر قلبي من صفات محمد","شمائل ميمون النقيبة ماجد",62,"د",1,0],["واشعار المرقش من تروى","بكأس الحب قاتله المرير",63,"ر",1,0],["وأشْعَلَتْ لظلامِ الخطبِ إِن حُجِبَتْ","نجومُه كلَّ نبراسٍ ومِقْباسِ",64,"س",1,0],["وأشعِرتُ لما أن عَلَوثُ على الهُدى","عُلاً وهدىً إني إلى اللَهِ شاكرُ",65,"ر",1,0],["وأشعاره عما ذكرت مبنيةٌ","صريحا لو القى السمع للحق ذو حجر",66,"ر",1,0],["وَاِشعَثَ قَد جَفا عَنهُ المَوالي","لَقىً كَالحِلسِ لَيسَ بِهِ زَماعُ",67,"ع",1,0],["وَأَشعَثَ حَيَّينا بِهِ غُرَّةَ الدُّجى","وَقَد نَشِطَ التَّهويمُ عَن مُقَلِ الرَّكبِ",68,"ب",1,0],["وأشعر بالعزم الأكيد يضمه","فؤاد على لذاته يتألم",69,"م",1,0],["وَأَشعَثَ راضٍ في الحَياةِ بِصُحبَتي","وَإشن مِتُّ آسِ فِعلَ خِرقٍ شَمَردَلِ",70,"ل",1,0],["وَأَشعَثَ قَد أَلقى الوِسادَةَ فَاِنطوى","إِلى دَفِّ مَنجاةِ الذِراعَينِ عَيهَلِ",70,"ل",1,0],["وأشعث محلول القميص معقص ال","ذوائب لم يعلق بوفرته المشط",71,"ط",1,0],["وأشعرتها قطع الأكف بما جنت","وأبطلت ما أبدت به من شعارها",72,"ر",3,0],["وَأَشعَتَ فينا قُوَّةً دَفّاعَةً","وَتَنافُساً حَتى هَزَزتَ الأَجبَنا",73,"ن",2,0],["وَأَشِع حَربَ الإِنتاجِ وَكُن","وَأَخاكَ مُحِبّاً لِلوَطَنِ",74,"ن",1,0],["واشعة الشمس المنيرة اسهم","يرمي بها قوس الغمام فتثبت",75,"ت",1,0],["واشعارٍ مجنّحة القوافي","غدت تعتزّ بي فأنا أبوها",76,"و",3,1],["واشعر في نزعها نزع روحي","أو انَي باليد أقلع ظفري",77,"ر",2,0],["وأشعِلوا الحرب دون ما سببٍ","وصيّروا الشعب كله حطبا",78,"ب",2,0],["وأشعر بين قومي بانكماش","كأني داخل فيهم سجونا",79,"ن",2,0],["وأشعاركم مصبوغة كحبيبكم","اذا قابلتها شمسنا نصلت نصلا",80,"ل",2,0],["وأشعر بالعظام مكسرات","جميعا قد طحن بمطحنات",81,"ت",1,0],["وأشعث نار به لا يرى","إلا الأثافي حوله جثما",82,"م",2,0],["واشعث مشتاق رمى في جفونه","غريب الكرى بعد الفجاج السباسب",83,"ب",1,0],["وأشعثَ قد طارت قنازعُ رأسِهِ","دعوتُ على طُول السُّرى وَدَعاني",84,"ي",1,1],["وأشعلت مصباحي وواترت المنى","إلى نصف ليلي ثم دب فُتور",85,"ر",1,0],["وَأَشعَثَ طَلّاعِ الثَنايا مُبارَكٍ","يَغولُ نَجادَ السَيفِ وَهُوَ طَويلُ",86,"ل",1,1],["وَأَشعَثُ قَد شَفَّ الهَواجُرُ وَجهَهُ","وَعَيساءُ تَسدو مَرَّةً وَتُواغِدُ",87,"د",1,0],["وأَشعَثٍ لم تُبقِ منه المورُ إِلا","مثلَ ما أَبقَت من الصَبرِ النَوى",88,"ا",1,0],["وأشعثٌ مُسْلَهِم شجَّ هامتَه","ضربُ الوَلائدِ بالأفهارَ موشومُ",89,"م",1,0],["وأشعثُ مشجوجٌ ونؤيٌ مُثلَّم","وأوْرَقُ ذُخلول وسُفع طوامسُ",90,"س",1,0],["واشعلوها وشبوها على رغم لاغيار","واظهروا ما غبي منها وخلوا التستار",91,"ر",1,0],["وأَشعنا بها شعارَ بني الع","باسِ فاستبشرتْ وجوهُ النصرِ",92,"ر",1,0],["وأَشْعَرَ الوهم إِلى خدّه","فانصبغ الخدّان منه بدمْ",93,"م",1,0],["وأشعَرهُ أنَّ الثريا تساقطتْ","خواتِمُها لما بردن خواتمه",94,"م",2,0],["وأشعاري تضيقُ بها القوافي","بلا بحرٍتقادُ ولا نُطافةْ",95,"ف",2,0],["وأشعر أني مُنِحْتُ السلامَ","وأني رُزِقتُ بخير النِعَم",96,"م",1,0],["وأشعمت من ملك اليتامى فوانيس","لو ما خيانة (إبن أرض القبارس)",97,"س",1,0],["وأشعلنا القَلَق شَمعَه","بها كم ذُبت بيني بَين!!",98,"ن",1,0],["وأَشعَلُوا اللَّيلَ.. حتى لا نَجَاةَ بهِ..","مَن لَم يَمُتْ بالشَّظايا ماتَ بالسَّهَرِ",99,"ر",1,0],["وأشعلتَ المشاعلَ في الليالي","فأصبح ليلُه مثلَ النهار",100,"ر",1,0],["وأَشعلتُم بأرضِ الطفِّ حرباً","بِلا برهانِ