/www.poetsgate.com/ViewPoem.aspx?id=212497",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5386,"ياسمين بريحةٍ من نار","https://www.poetsgate.com/ViewPoem.aspx?id=34998",""],[5409,"أتراهم من وحشةِ الأرض طاروا","https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5431,"الى قمرٍ أسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=198438",""],[5491,"يا نديمي","https://www.poetsgate.com/ViewPoem.aspx?id=215015",""],[5526,"عين القرير","https://www.poetsgate.com/ViewPoem.aspx?id=198471",""],[5531,"أذكريني يامنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=128418",""],[5539,"مزون السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=194074",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5725,"قل لهند","https://www.poetsgate.com/ViewPoem.aspx?id=195182",""],[402,"من يبتني للعلم دارا إنما","https://www.poetsgate.com/ViewPoem.aspx?id=36533",""],[5829,"درة الدهر الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=152342",""],[5829,"اسمحي لي","https://www.poetsgate.com/ViewPoem.aspx?id=157491",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5858,"ياسمين الشام","https://www.poetsgate.com/ViewPoem.aspx?id=188175",""],[5982,"يا سماك البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176599",""],[6008,"احترتُ بالحاير","https://www.poetsgate.com/ViewPoem.aspx?id=59158",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["يَا سَمِيَّ الوصيِّ يا شِقَّ نفسي","وأخي في الملمَّة النَّكراءِ",0,"ا",2,0],["يا سَميَّ النبي ذي الصفح والتا","بعَ مَسعاتَهُ التي لن تخيبا",1,"ب",2,0],["ياسميَّ الخليلِ إياك أدعو","دعوةً يمَّمْت سميعاً مُجيبا",2,"ب",2,1],["يا سميَّ الصدوق في الوعد إسما","عيل أنّى يكون إلا صدوقا",3,"ق",2,0],["يا سميَّ الفتى الذي كان باباً","لِجحودِ المكارمِ المعدومه",4,"م",2,0],["يا سمكا عواما","يا طائرا حواما",5,"م",2,0],["يا سماء أطبقت هالاتها","أمطري أقمار عز وسعادة",6,"د",2,0],["يا سَمِيَّ النَبِيِّ في سورَةِ الصَف","فِ وَمَن بِاِسمِهِ تُشَرَّفُ كُتُبي",7,"ب",2,0],["يا سَمِيَّ الَّذي لَهُ دانَتِ الجِن","نُ وَجاءَت بِعَرشِها بَلقيسُ",8,"س",1,1],["يا سَمِيَّ الَّذي بِهِ اِتُّهِمَ الذِئ","بُ وَأَفضى إِلَيهِ مُلكُ العَزيزِ",9,"ز",1,1],["يا سَمِيَّ الَّذي لَهُ خَبَتِ النا","رُ وَكانَت لَهُ سَلاماً وَبَردا",10,"د",2,1],["يا سَمِيَّ الَّذي فَدى اللَهُ إِكرا","ماً لَهُ نَجلَهُ بِذَبحٍ عَظيمِ",11,"م",1,0],["يا سَمِيَّ الصِديقِ ما كُنتَ في صَد","دَكَ إِلّا مُصَدِّقاً قَولَ ضِدّي",12,"د",2,0],["يا سَمِيَّ اِبنِ سَمحَةٍ","في غُدُوٍّ وَفي عَشي",13,"ش",2,0],["يا سَمِيَّ المَجهولِ حينَ يُسَمّى","وَالَّذي خُصَّ بِالجَمالِ وَعُمّا",14,"م",2,1],["يا سَمِيَّ النَبِيِّ في سورَةِ الجِنِّ","وَيا ثانِيَ العَزيزِ بِمِصرِ",15,"ر",1,1],["يا سَمِيًّ الَّذي تَبَهَّلَ يَدعو","رَبَّهُ مُخلِصاً لَهُ في قُل أوحي",16,"ح",2,1],["يا سَمِيَّ المُصطَفى يا بُغيَتي","يا مُنى نَفسي وَحَظّي مِن زَماني",17,"ن",2,1],["يا سَماء اِنقضّي وَيا أَرض ميدي","قَتلت أُمَةً وَبادَت بِلادا",18,"د",2,0],["يا سماء العراق خانتك أَقما","رٌ لليل العراق كانت تنير",19,"ر",1,0],["يا سَماء العِراق إني مَريض","يا سَماء العراق أَنت شفائي",20,"ا",2,0],["يا سماءَ الخيالِ ما كلّ يومٍ","من بني الشعر تظفرينَ بكوكبْ",21,"ب",1,0],["يَا سَمِيِّي وَهَكَذَا كُنْتَ تَدْعُو","نِي وَأَدْعُوكَ وَالْكَرِيمُ وَصولُ",22,"ل",1,0],["يا سِميَّ الخَليلِ يا تاجَ دينِ ال","لَهِ يا مَن بِهِ يَزينُ الثَناءُ",23,"ا",2,0],["يا سمير الأمس يا من","فيه لم يخل محلّي",24,"ي",1,0],["يا سمِيَّ النبيّ لا الدار دارٌ","حين تنعى لنا ولا العهد عهد",25,"د",1,0],["يا سَمير الأَبراجِ في مُنتَهى الأَج","واءِ ماذا في مُنتَهى الأَجواءِ",26,"ا",2,0],["ياسَمِيَّ النَبِيِّ يا اِبنَ عَلِيٍّ","قاتِلِ الشِركِ وَالبَتولِ الطَهورِ",27,"ر",1,1],["يا سُمَيرَ الفَعالِ مَن لِحُروبٍ","مُسعَراتٍ يَجُلنَ بِالأَبطالِ",28,"ل",1,0],["يا سُمَيرٌ مَن لِلنِساءِ إِذا ما","قَحَطَ القَطرُ أُمَّهاتِ العِيالِ",28,"ل",1,0],["يا سماء اسقطي ويا أرض ميدي","قد تولى الوزارة ابن البريدي",29,"د",2,1],["يا سَميريَّ في السُرى عَرّجا بي","حَيث مالَت تَخدي نِياقُ الرَجا بي",30,"ب",2,1],["يا سَمَيّ الخَليل نارك بَرد","لكِن القَلب زادَ مِنها اِشتِعالا",31,"ل",2,0],["يا سماءً رفيعةً من سَماحٍ","ليس يُخْلِي من قَطْرِها الدَّهرَ قُطرا",32,"ر",2,0],["يا سماءً يزيدها اللَه مدحاً","وتعيد الأنام مدحك سبحا",33,"ح",2,0],["يا سماءً للعلى أنظمُ في","مدحِه غرَّ القوافي أنجما",34,"م",2,0],["يا سمي النبي رفقا بصبّ","عبد حق ما رام شوقا سواكا",35,"ك",2,1],["يا سميري ليلةَ السف","ح وقد نادَوا بَراكِ",36,"ك",1,0],["يا سَمِيَّ المُصطفى بَرَّحَ بي","مَطْلُ أيامي بتحقيق الأملْ",37,"ل",1,0],["يا سماءً عاشت جدودٌ كِرامٌ","تَحتَها خَلفَّت بَنينَ كِراما",38,"م",2,0],["يا سماعاً كان من آلته","من به جاء وراق النغمُ",39,"م",1,1],["يا سميا لابن عم المصطفى","يا كَثير العَفو عَن جان وَجار",40,"ر",1,0],["يا سَميراً للسعيد المُرتَجى","لِلنَدى وَالبَأس فينا وَالعَمار",40,"ر",1,0],["يا سمى ابن عم خَير الأَنامِ","أَنتَ بَينَ الوَرى أجلّ إِمامِ",41,"م",1,1],["يا سميّ الإِمام صدّيق طَه","جدِّك الطاهرِ النبيِّ العَظيمِ",42,"م",1,1],["يا سميّ الخَليل لا زلت تَرقى","رُتَب العز وَالبَها وَالسِيادهْ",43,"د",2,1],["يا سَما أَمطري عَلَيهِ صُخورَاً","وَاَلحِقيه بِقَوم لُوط وَعاد",44,"د",1,0],["يا سميَّ الذّبيحِ لِم تذبحُ القل","بَ بلا حُرمةٍ بِمُديةٍ هَجرِ",45,"ر",1,0],["يا سماءَ الشعرِ التي لي عليها","كلَّ يومٍ سماءُ دمعٍ تفيضُ",46,"ض",1,0],["يَاسَمِينَ حكَى قُرَاضَةَ تِبْرٍ","فَتَقُوا طِيبَهُ بِمَرْمَاحُوزِ",47,"ز",1,0],["يا سَمَاءً بها الجراحُ نجومُ","فلتُضِيءْ وليطلْ ظلامٌ بهيمُ",48,"م",1,1],["يا سَمِيري في الهَوى إِذ لا فتىً","مِنكَ أَولى بالوفَا فيمَن علِمنا",49,"ن",2,0],["يا سمع حتى متى لا تتئد أبدا","عن سمع ما ليس يغنى من مناجات",50,"ت",1,0],["يا سميري رفقاً بصب حزين","دنف لا يزال من شدة الهم",51,"م",1,0],["يا سميري غرد بذكر سليمى","ثم ليلى المليحة العامريه",52,"ي",2,0],["يا سميع اكشف لي ستائر أسرا","ر الاسامي واسمع دعائي ووهلي",53,"ل",2,0],["يا سماء البيان إني عصاني","فيك هذا القريض والانشاء",54,"ا",2,0],["يا سَمِيَّ النَبِيِّ يا اِبنَ العَب","باسِ حَقَّقتَ عِندِيَ المَحذورا",55,"ر",2,0],["يا سَميري كُن عَذيري حانَ مِني الحين","ما اِحتِيالي ما إِحتِمالي هد صَبري البين",56,"ن",1,0],["يا سميري والهوى ما ذاقه","غير فانٍ بات في صورة حي",57,"ي",1,0],["يا سميَّ الذي فَداهُ من الذبح","إلهُ السما بذبحٍ عظيمِ",58,"م",1,1],["يا سماءً ما طاولتها سماء","جُزت إذ فتّحت لك الحجبُ فَتحا",59,"ا",1,0],["يا سماءً تُزهى على الكائناتِ","خفّفي العُجبَ في سَنى النيِّراتِ",60,"ت",1,1],["يا سمامَ الأشوَسِ القاسي ويا","عُصرةَ الملهوفِ في الخَطبِ الجَلَل",61,"ل",1,0],["يا سمي العفيف ما العيد إلّا","كوكب منك بالملاحة هلّا",62,"ل",2,1],["يا سمي النبي إدريس اَجرني","من زمانٍ أطال مدة حزني",63,"ن",2,1],["يا سَميري وَلَم أَقُل يا سَميري","قَط إِلّا أَجابَ عِشق وَحُبُّ",64,"ب",1,0],["يا سماءَ الحياة في مصر جودي","أنفُساً فوق نيلها صاديات",65,"ت",1,0],["يا سَماءَ الجَمالِ وَالأَدَبِ العا","لي وَيا جَنَّةَ الخَيالِ الزَكِيَّه",66,"ي",2,0],["يا سميع الدُّعاءِ هَب لي وَليّاً","يَرِثُ النور كي يدوم الضِّياء",67,"ا",2,0],["يا سمحة بدمي على تحريمه","فيما يظن أصادق وأعادي",68,"د",2,0],["يا سميَّ النبي بالعَربيَّة","وسمِىَّ الليوثِ بالفارسَّية",69,"ه",1,1],["يا سماء النوالِ قد صَوَّحَ النب","تُ فأرْضي مغبرَّةٌ جدباءُ",70,"ا",2,1],["يا سميرى سلِّ الهمومَ ولا يَشْ","نوكَ ما عشتَ كاشحٌ همّازُ",71,"ز",1,0],["يا سميري لقد تقرح جفني","سهراً مذاتي الردى أن تنبه",72,"ب",2,0],["يا سماءاً قد زينت واستنارت","وبها البدر زائد الاشراق",73,"ق",1,0],["يا سميري من حريمةَ شِيْمَا","وَامضاً للبُوَيْرق المتلآلي",74,"ل",2,0],["يا سميّ المصطفى يا ذا الصَّفَا","والوفا عندَ المكانِ العَسِرِ",75,"ر",1,0],["يا سميي وإن افاد اشتراك","غير ما يرتضيه فضل وود",76,"د",1,1],["يا سَميعَ الدُّعاءِ كن عندَ ظَنّي","واكفِني من كفيتَهُ الشَرَّ مِنِّي",77,"ي",1,1],["يا سماكا بمسكه القلمَ الأع","لى بدا بين أنجم الملك رامح",78,"ح",1,0],["يا سميري والليل ساج وللطي","ر رفيفٌ من حولنا في الغصون",79,"ن",1,0],["يا سميري والليالي وضاء","وشباب الفؤاد في ريعان",80,"ن",1,0],["يا سما لا تفخري أو تعجبي","فلنا في الأرض أبهى قمرين",81,"ن",1,0],["يا سميري ونديمي","ذره يهذي وقل الله",82,"ل",2,0],["ياسمياً لخليل الله دم","في هنا بالشبل بدء أو مآل",83,"ل",1,0],["يا سميَّ الحُسامِ والنَّيِّرِ الاع","ظمِ لا استبدلتْ بكَ الأَيامُ",84,"م",1,0],["يا سميا الصادق الوعد يامن","جنسه قد سما على كل جنس",85,"س",1,0],["يا سَماءَ الحِجَى ويا شمسَ فضلٍ عمَّتِ","العالمين نفعاً ولمعا",86,"ع",2,0],["يا سميري اذا اعترتني همةم","وأنيسي في مظلمات الليالي",87,"ي",1,0],["يا سمي النبي عيسى فدتك ال","نفس لم لا تكن كعيسى النبي",88,"ي",1,1],["يا سماءً ما طاوَلَتها سَماءُ","ولكَ الكَونُ كانَ إِذ كُنتَ فَتحاً",89,"ح",2,0],["يا سَماء ارفعيه ايتها الأَر","ض ابلعيه عَسى يَكون السَليما",90,"م",2,0],["يا سَمِيَّ المرميّ في ظُلْمة الجُب","بِ لِمَن ساقَهُ القضاءُ إليها",91,"ي",3,1],["يا سَمِيَّ النَبِيِّ الَّذي خَ","صَّ بِهِ اللَهُ عَبدَهُ زَكَرِيّا",92,"ي",2,1],["يا سميري بلى تذكَّرتُ ظبياً","أُولِع القلب في هواه ولوعا",93,"ع",2,0],["يا سميري قم بالعشيرة نادِ","معلناً بالمصاب في كل نادِ",94,"د",1,1],["يا سميع الدعاء يا مالك الملك وحده","سالك يا ملتجا عبده إذا ضاق عبده",95,"د",2,0],["يا سَميري بِلَيلَتي وَنَهاري","وَنَديمي بِقَهوَتي وَخُماري",96,"ر",2,1],["يا سماء لها سما المجد أرض","ما لما أبرمته كفك نقض",97,"ض",1,1],["يا سمهري القد يا عذب اللما ما الجفا","ما هكذا الظن من بعد الوداد النصوح",98,"ح",1,0],["ياسمينٌ قد غدت أن","وارنا طوعاً لملكه",99,"ك",2,0],["يا سماء امطري عذاباً لحربٍ","وأردفيهم من بعده بعذاب",100,"ب",1,0],["يا سميَّ الحي يهنيك قرانٌ","قرينٌ للهنا والظفرِ",101,"ر",1,1],["يا سَميري عَزَّ غَيثُ الْمُلْتقى","وَانْتهى الطّوفانُ في جُبٍّ خَسَفْ",102,"ف",1,0],["يَا سَمَاءَ الآمَالِ .! يَا خَاشِعَاتِ الْ","بيدِ يَا ذِكْرَ مَنْ دَعَتْهُ الشُّجُونُ",103,"ن",1,0],["يا سميرًا ليلهُ ألقي","ما أرى نجمًا ولا سَمَرا",104,"ر",2,0],["يَا سَمَاءً يَا نُجُومًا","يَا لَيَالٍ فِيْ مُنَاكْ",105,"ك",1,0],["يَاسَمِيِنِي مِنْ 