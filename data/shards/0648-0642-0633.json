iwan/poem/199021","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85071","المتقارب"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85200","الوافر"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114159","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95339","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111414","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111516","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77179","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44727","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123488","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45150","الخفيف"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83191","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104533","الرجز"],[4691,"تهيّف شعري","https://www.poetsgate.com/ViewPoem.aspx?id=136805",""],[4692,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=213369",""],[4767,"راية الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=179929",""],[5120,"صَيْدُ اَلْمَعَانِي ...","https://www.poetsgate.com/ViewPoem.aspx?id=213618",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5582,"أَلا هَلْ نَفَتْ عَنْكَ طِيبَ الرُّقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=186965",""],[5701,"أخي يا أخا الآيات في الشعر والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=164601",""],[5956,"مفاتيح الدخول إلى بلادي العربية","https://www.poetsgate.com/ViewPoem.aspx?id=192786",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[463,"سألَ اللِّوى وسؤالهُ إلحافُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60147&r=&rc=203",""]],"verses":[["وَقَسطَلٍ شَرِقَت شَمسُ النَهارِ بِهِ","فَأَسفَرَ النَقعُ وَالآفاقُ تَعتَجِرُ",0,"ر",1,0],["وَقِس بَينَهُما شِبراً","فَإِن زِدتَ فَلا باسا",1,"س",2,0],["وَقِس آتِياً مِنْ أَمْرِهِ بالَّذِي مَضَى","فَرُبَّ قِيَاسٍ كَانَ أَصْلاً لِبُرْهَانِ",2,"ن",1,0],["وقسِّم الشعر فاجْعل في محاسنهِ","شذر القلائد واهدِ الدُّرَّ للتاج",3,"ج",1,0],["وقِسْ راحةً تجني عليك مسبَّةً","بمَتْعَبةٍ تَحْميكَها وتقيكا",4,"ك",2,0],["وقَسَوْتَ إذْ أَبقيتَنِي في","الكونِ أَذْرَعُ كُلَّ وَعْرِ",5,"ر",1,0],["وقست بك الأعيان حيا وميتا","فوالله ما جاء القياس بأمثال",6,"ل",1,0],["وَقَسَّمَ الأَرضَ آكاماً وَأَودِيَةً","وَفَصَّلَ البَحرَ أَصدافاً وَمُرجانا",7,"ن",2,0],["وقُسمْتُ عن أَمر إلهي أَخْطُبُ","فيهمْ وأَعْطاهُمْ كَما قَدْ طَلَبُوا",8,"ب",3,0],["وَقِسِيٍّ رُميتَ عَنها فَرَدَّت","في قُلوبِ الرُماةِ عَنكَ النِصالا",9,"ل",2,0],["وَقَسا فُؤادُكِ أَن يَلينَ لِلَوعَةٍ","باتَت تَقَلقَلُ في صَميمِ فُؤادِهِ",10,"د",2,0],["وَقَسَّمتُ التَفَكُّرَ فيهِ لَمّا","أَخَذتُ بِهِ مِنَ اللَذّاتِ قِسمي",11,"م",2,0],["وقسا الحبيب على الغري","بِ فلا الدموع ولا الصَّلاه",12,"ا",2,0],["وَقَسَّمُونا كَمَا شَاؤُوا فَلَو دَخَلُوا","مَا بَيْنَ شِقَّي نَواةِ التَّمْرِ مَا اْتَّحَدَا",13,"د",2,0],["وقَسوَرةٍ أَفضى إِلى نَزعِ روحِهِ","وشقّ إليها بين أنيابه العُصْلِ",14,"ل",1,0],["وقَسوَرةُ الحَربِ الَّذي يُرجعُ القَنا","رَواعِفَ تَكسو الأَرضَ من عَلَقٍ وَرْدا",15,"د",2,0],["وَقِسمَتُنا الضيزى بِنَجدٍ وَأَرضِها","لَنا خُطوَةٌ في عَرضِها وَلَهُم فِترُ",16,"ر",1,0],["وَقَسَمتُ طَرفَ العَينِ بَينَ رَباوَةٍ","مُخضَرَّةٍ وَقَرارَةٍ زَرقاءِ",17,"ا",2,0],["وَقُسٌّ إِذا ما شاءَ حِلماً وَنائِلاً","وَإِن كانَ أَمضى مِن أَحَذَّ وَقيعِ",18,"ع",1,0],["وَقَسَتْ منهم قلوبٌ عَلَى مَنْ","بَكَتِ الأرضُ فقدَهم والسماءُ",19,"ا",2,0],["وَقَسرِيَّةٍ أَبصَرتُها فَهَوَيتُها","هَوى عُروَةَ العُذرِيَّ وَالعاشِقِ النَجدي",20,"د",2,1],["وَقِس بِما كانَ أَمراً لَم يَكُن تَرَه","فَالرِجلُ تَعرِفُ بَعضَ المَوتِ بِالخَدَرِ",21,"ر",1,0],["وقساوة الإنسان يظهر قبحها","في حومة للحرب تصبغ بالدم",22,"م",1,0],["وقست ليلى فما تع","بأ ليلى بدموعي",23,"ي",1,0],["وقسَا عليكِ المرجِفون وحدَّثوا","أنْ ليس تمضي ليلةٌ ونهارُ",24,"ر",1,0],["وَقَسَا الْفِرَاقُ عَلَى قُلُوبٍ","شَدَّ مَا قَاستْ وَعَانَتْ",25,"ت",1,0],["وَقَسا فَما لِلّينِ فيهِ مَطمَعٌ","وَنَأى فَما لِلقُربِ مِنهُ سَبيلُ",26,"ل",1,0],["وَقِسمَةُ الأعلى مِنَ الجِنسَينِ","خَأرِجُها زِيادَةُ الأسَّين",27,"ن",1,0],["وقسىَ صُقْر بأيدي شيوخٍ","ليس نُخطِى مَتينة الأعوادِ",28,"د",1,0],["وقس كل قولٍ إن أردت مَقالةً","فإنك مسئولٌ وقولك يكتَبُ",29,"ب",1,0],["وقسمت دهرك ليله ونهاره","في ورد ورد بعد سرو صيام",30,"م",1,0],["وَقسِيُّ أُسدٍ لا تَرُدُّ نِصالَها","زُبرُ الحَديدِ وَلا صَفيحُ المَرمَرِ",31,"ر",1,0],["وقُسِّمْنا عرايا دونَ باقٍ","وبِتنا في إطارِ القيدِ ربْقا",32,"ق",2,0],["وَقَسَمت همَّك ين رَعيِ عهودهِ","وَرعايةِ المَلكِ الذي اِستَرعاكا",33,"ك",2,0],["وَقُسٌّ وَسَحْبَانٌ وَكَعْبٌ وَحَاتِمُ","وَمَالِكُنَا وَالشَّافِعِيُّ وَنُعْمَانُ",34,"ن",1,0],["وقسّم أجناد الضلال عصائباً","وفرقهم أن المشيئة تغلب",35,"ب",1,0],["وقسورةَ الليلِ الذي بينَ نصفهِ","وبين العِشاء قد دأبتُ أسيرُها",36,"ر",3,0],["وقسا طبع ابن قيس وقسٍ","عن مداناتها وبان البيان",37,"ن",1,0],["وقِس أُنثى بأُنثى فالغَواني","سواءٌ عندَ ما تَلِجُ الخُدورا",38,"ر",2,0],["وَقَسَمُ اللَهِ جَمَعَ المُبغِضينَ لَهُ","هَذاكَ ذُلٌّ وَذا حانَت مُنيَتُهُ",39,"ت",2,0],["وقست عليه السافيا","تُ فمزّقت منه الشراع",40,"ع",1,0],["وَقِس عَلى قِسٍّ وَرُح مَواسِياً","أُوَيسَ بِالنَفسِ وَلِلَّهِ فَقِر",41,"ر",1,0],["وَقِس حال أَبناء الزَمان بِضدّهِ","تَرَ الفَرق ما بَين السَعادة وَالشَقا",42,"ق",2,0],["وَقس الخليّ عَلى الشجي","ي تَخَل هُنالك عَكس طَردك",43,"ك",1,0],["وقِسْمُه الأَدنَى خَطَر","نَصْباً لكلِّ مَن حَضَر",44,"ر",1,0],["وقَسا قلبُها عَليهنَّ لمَّا","رأَت العزَّ في يَدَي غياضِ",45,"ض",1,0],["وَقَسى عَلى ضُعفي زَماني عِندَما","لانَت لبثي قسوة الأَعداءِ",46,"ا",2,0],["وقسمان أهل الحشر ذلك ظالم","وآخر مظلوم لذاك ملازم",47,"م",1,0],["وقس الفؤاد على الفؤاد مقرباً","إن الذي عندي أجل وأكثر",48,"ر",1,0],["وقِسْ على الشَّيءِ بأشكالِهِ","يدلُّكَ الشَّيءُ على الشَّيءِ",49,"ي",2,0],["وقسمتَ الفَرِنجَ بالغزوِ شطري","ن فهذَا عانٍ وهذَا قتيلُ",50,"ل",1,0],["وقسموها لأجناس معددةٍ","بازٍ وحرٍّ وشاهينٍ بنو الصقرِ",51,"ر",1,0],["وقِسِيٍّ كأَنَّما الدهرُ عنها","قائمٌ يقذفُ الوبالَ نِبالا",52,"ل",2,0],["وقست بعين العقل عن كل واحد","له تجعل الأيام فيها مسالكا",53,"ك",2,0],["وقسموا الحرب أثلاثاً ومالهمو","قد أهملوه لمن يحتاج تهميلا",54,"ل",2,0],["وقسا فلولا أن أحاشيَ مجدَه","منها لقلتُ ملولةٌ مِطرافُ",55,"ف",1,0],["وقسمتم بذابل ونوال","في العدى والوفود قصماً وقسما",56,"م",2,0],["وقسم أوقات الفراغ وكلها","فراغ على أفراسه والزوارق",57,"ق",1,0],["وقسم ساكن جهلا","وليس العلم إلهاما",58,"م",2,0],["وقسم قلبه دام","وكان الفقر إلجاما",58,"م",2,0],["وقسم حاكم طاغ","يسوق الناس أنعاما",58,"م",2,0],["وقسم خائن يمشي","وراء الناس نمّاما",58,"م",2,0],["وقسم خائف يدري","غدا في الناس حلّاما",58,"م",2,0],["وقسم ساخر يهذي","يزيد القلب إضراما",58,"م",2,0],["وقسم عارف حيّ","يرى الإذلال إعداما",58,"م",2,0],["وقس الخطي بين النشاوى ضابطا","مقدار ما تخطوه بالمقياس",59,"س",1,0],["وقِسْمٍ ما لَهُ في الْعِلْمِ حَظٌّ","وكانَ لَهُ حُظُوظٌ في النِّزالِ",60,"ل",1,0],["وقسم في ذوي الإيمان خافٍ","عن الساهي من العبد الكنود",61,"د",1,0],["وَقَسوت قسوة معتد متكبر","وَإِلى الجُنون نَسبتَ عَقلاً قَد بلي",62,"ل",2,0],["وقسمه على السواءِ دانِ","وفيهِ للقاسمِ صورتانِ",63,"ن",1,0],["وقسطَ مديحي يسروا ليَ وليكنْ","على قدر تجويدي المديحَ وإحساني",64,"ن",2,0],["وقسّ بن ساعدة في عكاظ","يبين للناس شر المجانه",65,"ن",2,0],["وقس ذاك فيما عليك وما","ك تجن نتائج ذات سناء",66,"ا",2,0],["وقسمت قلبي بين إشفاق على","أمم وإخلاص لهذا النادي",67,"د",2,0],["وقسورة بادرت والليل ضارب","سرادق دجن لا يزول مربه",68,"ب",2,1],["وقسْ أمورَك من قبل القضاءِ فما","ترى العواقبُ إلا بالتفاسير",69,"ر",1,0],["وقَسَّمَ أعمالَ الخِلافةِ بينَهُم","فلا زِلتُ مربوطاً بِذا الشُّكرِ مُرتَهَن",70,"ن",1,0],["وقسّيه في النقع تنشد حزبه","نحن الأهلة في ظلام الحندس",71,"س",1,0],["وقِسِيٌّ مِنَ الحَواجِبِ تَرمِي","بِنِبَالٍ أَغراضُهُنَّ الكُبودُ",72,"د",1,0],["وقسناك بالشامخات الشمام","فكنت أشم وأسمى ذرى",73,"ر",2,0],["وَقَسَا قَلْبُهُ ولاَنَ فَخِلْنَا","جِسْمَ مِاءٍ عَلَى فُؤَادٍ حَدِيدِ",74,"د",1,0],["وَقسّمك التوديع اِثنين واحد","معَ الظاعنِ الغادي وآخر نازلُ",75,"ل",1,0],["وقسمتي من نفيس ما كسبوا","من أنْعُم الله أنْفَس القِسَم",76,"م",1,0],["وَقَسيمَهُ في المَعلواتِ وَذُخرَهُ","لِلمُسلِمينَ وِقايَةً وَعِصاما",77,"م",2,0],["وقسطل تتغطى","منه رؤوس الجبالِ",78,"ل",1,0],["وقسَّمِهمْ على قَتْلَى وأَسْرَى","أُسودَ عرينةٍ وظباءَ كِلَّهْ",79,"ل",2,0],["وقسموا في لغة موجهه","بالقصد والقدر ومثل والجهه",80,"ه",1,0],["وقس مكثّرا كأين ناصبا","مميّزا لكن بجرّ غالبا",80,"ب",2,0],["وقس على زال بما في أربعه","تليه بالرفع ونصب متبعه",80,"ه",1,0],["وقس على الحرفين في الفعلين ما","من الأسامي ذكره تقدّما",80,"م",2,0],["وقس على المديد في السباعي","زحافه معاقبا وراعي",81,"ي",1,0],["وقس عليه باتفاقٍ كلما","ضارعَه أو لقياسه انتمي",82,"ي",1,0],["وقس عليه عقدة اللام ألف","فالقول في انفتاحها لا يختلف",82,"ف",1,0],["وقس عليه الكسر وأنزل أسفلا","به وقالوا مُسبلٌ فقلت لا",82,"ل",2,0],["وقس نظيراً ضارعَ الذي جُمع","على اختلافِ حُكمِه الذي وُضع",82,"ع",1,0],["وَقِس على الاول في الرحمن","وفي الرحيم قِس بوضعِ الثاني",82,"ي",1,0],["وقس عليه ما أتى من خطّه","كجنسه بعد كمال شرطهِ",82,"ه",1,0],["وقس فليس تحصرُ الاوضاعُ","فالنقلُ حتمٌ قاله الاجماعُ",82,"ع",1,0],["وقَسمك في الصّالحات الموفّى","وسهمك عند الفخار المُعلّى",83,"ل",2,0],["وقس على جميع ما قد ذكرا","أولادهم أنثاهم والذكرا",84,"ر",2,0],["وقس على أصوله الفروعا","كل عليها لم يكن ممنوعا",85,"ع",2,0],["وَقَسَوا عَلَيكِ وَما قَسَوتِ وَرُبَّما","أَجدى التَرَفُّقُ بِالمُسيءِ المُجتَري",86,"ر",2,0],["وَقِسنا الجُودَ بِالجُودِ","وَحُسنَ الذِكرِ بِالذِكرِ",87,"ر",1,0],["وقسط الصحافة من كفهِ","كقسطِ مؤملِ احسانه",88,"ن",2,0],["وَقِس عَلى ما مَضى باقي الزَمانِ فَكَم","نَورٍ تَفَتَّقَ عَن مُرٍّ مِنَ الثَمَرِ",