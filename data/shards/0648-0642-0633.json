{"poems":[[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[55,"إذا ما شئت أن تصنع","https://www.aldiwan.net/poem26264.html","الهزج"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[72,"واحيلتي بظلام الطرة الداجي","https://www.aldiwan.net/poem18450.html","البسيط"],[51,"أيا ابن المعلى كن معلى ولا تكن","https://www.aldiwan.net/poem65791.html","الطويل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[85,"يقولون رشدي مات","https://www.aldiwan.net/poem7790.html","الطويل"],[85,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[56,"إن الرسول لم يزل يقول","https://www.aldiwan.net/poem58534.html","الرجز"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[66,"كتبت فما علمت أنور نجم","https://www.aldiwan.net/poem40640.html","الوافر"],[97,"قست الحياة على الطري","https://www.aldiwan.net/poem24856.html","مجزوء الكامل"],[80,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[74,"ومجر ذيل غمامة قد نمقت","https://www.aldiwan.net/poem12818.html","الكامل"],[22,"تبينت ما فيه بخفان إنني","https://www.aldiwan.net/poem21695.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"وقسرية أبصرتها فهويتها","https://www.aldiwan.net/poem62571.html","الطويل"],[46,"ما للبصائر لا تخلو من السدر","https://www.aldiwan.net/poem22660.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54661","البسيط"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5786","الكامل"]],"verses":[["وَقَسطَلٍ شَرِقَت شَمسُ النَهارِ بِهِ","فَأَسفَرَ النَقعُ وَالآفاقُ تَعتَجِرُ",0,"ر",1,0],["وَقِس بَينَهُما شِبراً","فَإِن زِدتَ فَلا باسا",1,"س",2,0],["وَقِس آتِياً مِنْ أَمْرِهِ بالَّذِي مَضَى","فَرُبَّ قِيَاسٍ كَانَ أَصْلاً لِبُرْهَانِ",2,"ن",1,0],["وقسِّم الشعر فاجْعل في محاسنهِ","شذر القلائد واهدِ الدُّرَّ للتاج",3,"ج",1,0],["وقِسْ راحةً تجني عليك مسبَّةً","بمَتْعَبةٍ تَحْميكَها وتقيكا",4,"ك",2,0],["وقَسَوْتَ إذْ أَبقيتَنِي في","الكونِ أَذْرَعُ كُلَّ وَعْرِ",5,"ر",1,0],["وقست بك الأعيان حيا وميتا","فوالله ما جاء القياس بأمثال",6,"ل",1,0],["وَقَسَّمَ الأَرضَ آكاماً وَأَودِيَةً","وَفَصَّلَ البَحرَ أَصدافاً وَمُرجانا",7,"ن",2,0],["وقُسمْتُ عن أَمر إلهي أَخْطُبُ","فيهمْ وأَعْطاهُمْ كَما قَدْ طَلَبُوا",8,"ب",3,0],["وَقِسِيٍّ رُميتَ عَنها فَرَدَّت","في قُلوبِ الرُماةِ عَنكَ النِصالا",9,"ل",2,0],["وَقَسا فُؤادُكِ أَن يَلينَ لِلَوعَةٍ","باتَت تَقَلقَلُ في صَميمِ فُؤادِهِ",10,"د",2,0],["وَقَسَّمتُ التَفَكُّرَ فيهِ لَمّا","أَخَذتُ بِهِ مِنَ اللَذّاتِ قِسمي",11,"ي",1,0],["وقسا الحبيب على الغري","بِ فلا الدموع ولا الصَّلاه",12,"ا",2,0],["وقَسوَرةٍ أَفضى إِلى نَزعِ روحِهِ","وشقّ إليها بين أنيابه العُصْلِ",13,"ل",1,0],["وقَسوَرةُ الحَربِ الَّذي يُرجعُ القَنا","رَواعِفَ تَكسو الأَرضَ من عَلَقٍ وَرْدا",14,"د",2,0],["وَقِسمَتُنا الضيزى بِنَجدٍ وَأَرضِها","لَنا خُطوَةٌ في عَرضِها وَلَهُم فِترُ",15,"ر",1,0],["وَقَسَمتُ طَرفَ العَينِ بَينَ رَباوَةٍ","مُخضَرَّةٍ وَقَرارَةٍ زَرقاءِ",16,"ا",2,0],["وَقُسٌّ إِذا ما شاءَ حِلماً وَنائِلاً","وَإِن كانَ أَمضى مِن أَحَذَّ وَقيعِ",17,"ع",1,0],["وَقَسَتْ منهم قلوبٌ عَلَى مَنْ","بَكَتِ الأرضُ فقدَهم والسماءُ",18,"ا",2,0],["وَقَسرِيَّةٍ أَبصَرتُها فَهَوَيتُها","هَوى عُروَةَ العُذرِيَّ وَالعاشِقِ النَجدي",19,"ي",1,1],["وَقِس بِما كانَ أَمراً لَم يَكُن تَرَه","فَالرِجلُ تَعرِفُ بَعضَ المَوتِ بِالخَدَرِ",20,"ر",1,0],["وقساوة الإنسان يظهر قبحها","في حومة للحرب تصبغ بالدم",21,"م",1,0],["وقست ليلى فما تع","بأ ليلى بدموعي",22,"ي",1,0],["وقسَا عليكِ المرجِفون وحدَّثوا","أنْ ليس تمضي ليلةٌ ونهارُ",23,"ر",1,0],["وَقَسَا الْفِرَاقُ عَلَى قُلُوبٍ","شَدَّ مَا قَاستْ وَعَانَتْ",24,"ت",1,0],["وَقَسا فَما لِلّينِ فيهِ مَطمَعٌ","وَنَأى فَما لِلقُربِ مِنهُ سَبيلُ",25,"ل",1,0]]}