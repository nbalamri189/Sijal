{"poems":[[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[55,"إذا ما شئت أن تصنع","https://www.aldiwan.net/poem26264.html","الهزج"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[72,"واحيلتي بظلام الطرة الداجي","https://www.aldiwan.net/poem18450.html","البسيط"],[51,"أيا ابن المعلى كن معلى ولا تكن","https://www.aldiwan.net/poem65791.html","الطويل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[85,"يقولون رشدي مات","https://www.aldiwan.net/poem7790.html","الطويل"],[85,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[56,"إن الرسول لم يزل يقول","https://www.aldiwan.net/poem58534.html","الرجز"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[66,"كتبت فما علمت أنور نجم","https://www.aldiwan.net/poem40640.html","الوافر"],[97,"قست الحياة على الطري","https://www.aldiwan.net/poem24856.html","مجزوء الكامل"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[74,"ومجر ذيل غمامة قد نمقت","https://www.aldiwan.net/poem12818.html","الكامل"],[22,"تبينت ما فيه بخفان إنني","https://www.aldiwan.net/poem21695.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"وقسرية أبصرتها فهويتها","https://www.aldiwan.net/poem62571.html","الطويل"],[46,"ما للبصائر لا تخلو من السدر","https://www.aldiwan.net/poem22660.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54661","البسيط"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5786","الكامل"],[111,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[128,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[128,"قضى اللّه فيما بيننا بقرابة","https://www.aldiwan.net/poem50668.html","الكامل"],[150,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[169,"قسماً بأعراف الجياد الضمر","https://www.aldiwan.net/poem1628.html",""],[178,"الزفت","https://www.aldiwan.net/poem50700.html","الوافر"],[225,"لم يدر أن ملامه أغراكا","https://www.aldiwan.net/poem55231.html","الطويل"],[237,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[239,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[246,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[261,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[270,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[320,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[328,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[353,"عليك بتقوى الله والصدق إنما","https://www.aldiwan.net/poem40024.html","الطويل"],[353,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[364,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[371,"من لمأسورة رهينة عامين","https://www.aldiwan.net/poem57348.html","الخفيف"],[380,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[403,"على توبة باللّه هل أنت عازم","https://www.aldiwan.net/poem33452.html","الطويل"],[403,"يا زين أرباب الكمال ومن غدا","https://www.aldiwan.net/poem33910.html","الكامل"],[405,"تأن في الشيء إذا رمته","https://www.aldiwan.net/poem49434.html","السريع"],[409,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[429,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[432,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[441,"أيا قاطع الحبل الذي إن قطعته","https://www.aldiwan.net/poem14468.html","الطويل"],[441,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[458,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[464,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[479,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[479,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[529,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[558,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"]],"verses":[["وَقَسطَلٍ شَرِقَت شَمسُ النَهارِ بِهِ","فَأَسفَرَ النَقعُ وَالآفاقُ تَعتَجِرُ",0,"ر",1,0],["وَقِس بَينَهُما شِبراً","فَإِن زِدتَ فَلا باسا",1,"س",2,0],["وَقِس آتِياً مِنْ أَمْرِهِ بالَّذِي مَضَى","فَرُبَّ قِيَاسٍ كَانَ أَصْلاً لِبُرْهَانِ",2,"ن",1,0],["وقسِّم الشعر فاجْعل في محاسنهِ","شذر القلائد واهدِ الدُّرَّ للتاج",3,"ج",1,0],["وقِسْ راحةً تجني عليك مسبَّةً","بمَتْعَبةٍ تَحْميكَها وتقيكا",4,"ك",2,0],["وقَسَوْتَ إذْ أَبقيتَنِي في","الكونِ أَذْرَعُ كُلَّ وَعْرِ",5,"ر",1,0],["وقست بك الأعيان حيا وميتا","فوالله ما جاء القياس بأمثال",6,"ل",1,0],["وَقَسَّمَ الأَرضَ آكاماً وَأَودِيَةً","وَفَصَّلَ البَحرَ أَصدافاً وَمُرجانا",7,"ن",2,0],["وقُسمْتُ عن أَمر إلهي أَخْطُبُ","فيهمْ وأَعْطاهُمْ كَما قَدْ طَلَبُوا",8,"ب",3,0],["وَقِسِيٍّ رُميتَ عَنها فَرَدَّت","في قُلوبِ الرُماةِ عَنكَ النِصالا",9,"ل",2,0],["وَقَسا فُؤادُكِ أَن يَلينَ لِلَوعَةٍ","باتَت تَقَلقَلُ في صَميمِ فُؤادِهِ",10,"د",2,0],["وَقَسَّمتُ التَفَكُّرَ فيهِ لَمّا","أَخَذتُ بِهِ مِنَ اللَذّاتِ قِسمي",11,"ي",1,0],["وقسا الحبيب على الغري","بِ فلا الدموع ولا الصَّلاه",12,"ا",2,0],["وَقَسَّمُونا كَمَا شَاؤُوا فَلَو دَخَلُوا","مَا بَيْنَ شِقَّي نَواةِ التَّمْرِ مَا اْتَّحَدَا",13,"د",2,0],["وقَسوَرةٍ أَفضى إِلى نَزعِ روحِهِ","وشقّ إليها بين أنيابه العُصْلِ",14,"ل",1,0],["وقَسوَرةُ الحَربِ الَّذي يُرجعُ القَنا","رَواعِفَ تَكسو الأَرضَ من عَلَقٍ وَرْدا",15,"د",2,0],["وَقِسمَتُنا الضيزى بِنَجدٍ وَأَرضِها","لَنا خُطوَةٌ في عَرضِها وَلَهُم فِترُ",16,"ر",1,0],["وَقَسَمتُ طَرفَ العَينِ بَينَ رَباوَةٍ","مُخضَرَّةٍ وَقَرارَةٍ زَرقاءِ",17,"ا",2,0],["وَقُسٌّ إِذا ما شاءَ حِلماً وَنائِلاً","وَإِن كانَ أَمضى مِن أَحَذَّ وَقيعِ",18,"ع",1,0],["وَقَسَتْ منهم قلوبٌ عَلَى مَنْ","بَكَتِ الأرضُ فقدَهم والسماءُ",19,"ا",2,0],["وَقَسرِيَّةٍ أَبصَرتُها فَهَوَيتُها","هَوى عُروَةَ العُذرِيَّ وَالعاشِقِ النَجدي",20,"ي",1,1],["وَقِس بِما كانَ أَمراً لَم يَكُن تَرَه","فَالرِجلُ تَعرِفُ بَعضَ المَوتِ بِالخَدَرِ",21,"ر",1,0],["وقساوة الإنسان يظهر قبحها","في حومة للحرب تصبغ بالدم",22,"م",1,0],["وقست ليلى فما تع","بأ ليلى بدموعي",23,"ي",1,0],["وقسَا عليكِ المرجِفون وحدَّثوا","أنْ ليس تمضي ليلةٌ ونهارُ",24,"ر",1,0],["وَقَسَا الْفِرَاقُ عَلَى قُلُوبٍ","شَدَّ مَا قَاستْ وَعَانَتْ",25,"ت",1,0],["وَقَسا فَما لِلّينِ فيهِ مَطمَعٌ","وَنَأى فَما لِلقُربِ مِنهُ سَبيلُ",26,"ل",1,0],["وَقِسمَةُ الأعلى مِنَ الجِنسَينِ","خَأرِجُها زِيادَةُ الأسَّين",27,"ن",1,0],["وقسىَ صُقْر بأيدي شيوخٍ","ليس نُخطِى مَتينة الأعوادِ",28,"د",1,0],["وقس كل قولٍ إن أردت مَقالةً","فإنك مسئولٌ وقولك يكتَبُ",29,"ب",1,0],["وقسمت دهرك ليله ونهاره","في ورد ورد بعد سرو صيام",30,"م",1,0],["وَقسِيُّ أُسدٍ لا تَرُدُّ نِصالَها","زُبرُ الحَديدِ وَلا صَفيحُ المَرمَرِ",31,"ر",1,0],["وقُسِّمْنا عرايا دونَ باقٍ","وبِتنا في إطارِ القيدِ ربْقا",32,"ق",2,0],["وَقَسَمت همَّك ين رَعيِ عهودهِ","وَرعايةِ المَلكِ الذي اِستَرعاكا",33,"ك",2,0],["وَقُسٌّ وَسَحْبَانٌ وَكَعْبٌ وَحَاتِمُ","وَمَالِكُنَا وَالشَّافِعِيُّ وَنُعْمَانُ",34,"ن",1,0],["وقسّم أجناد الضلال عصائباً","وفرقهم أن المشيئة تغلب",35,"ب",1,0],["وقسورةَ الليلِ الذي بينَ نصفهِ","وبين العِشاء قد دأبتُ أسيرُها",36,"ر",3,0],["وقسا طبع ابن قيس وقسٍ","عن مداناتها وبان البيان",37,"ن",1,0],["وقِس أُنثى بأُنثى فالغَواني","سواءٌ عندَ ما تَلِجُ الخُدورا",38,"ر",2,0],["وَقَسَمُ اللَهِ جَمَعَ المُبغِضينَ لَهُ","هَذاكَ ذُلٌّ وَذا حانَت مُنيَتُهُ",39,"ت",2,0],["وقست عليه السافيا","تُ فمزّقت منه الشراع",40,"ع",1,0],["وَقِس عَلى قِسٍّ وَرُح مَواسِياً","أُوَيسَ بِالنَفسِ وَلِلَّهِ فَقِر",41,"ر",1,0],["وَقِس حال أَبناء الزَمان بِضدّهِ","تَرَ الفَرق ما بَين السَعادة وَالشَقا",42,"ق",2,0],["وَقس الخليّ عَلى الشجي","ي تَخَل هُنالك عَكس طَردك",43,"ك",1,0],["وقِسْمُه الأَدنَى خَطَر","نَصْباً لكلِّ مَن حَضَر",44,"ر",1,0],["وقَسا قلبُها عَليهنَّ لمَّا","رأَت العزَّ في يَدَي غياضِ",45,"ض",1,0],["وَقَسى عَلى ضُعفي زَماني عِندَما","لانَت لبثي قسوة الأَعداءِ",46,"ا",2,0],["وقسمان أهل الحشر ذلك ظالم","وآخر مظلوم لذاك ملازم",47,"م",1,0],["وقس الفؤاد على الفؤاد مقرباً","إن الذي عندي أجل وأكثر",48,"ر",1,0],["وقِسْ على الشَّيءِ بأشكالِهِ","يدلُّكَ الشَّيءُ على الشَّيءِ",49,"ي",2,0],["وقسمتَ الفَرِنجَ بالغزوِ شطري","ن فهذَا عانٍ وهذَا قتيلُ",50,"ل",1,0],["وقسموها لأجناس معددةٍ","بازٍ وحرٍّ وشاهينٍ بنو الصقرِ",51,"ر",1,0],["وقِسِيٍّ كأَنَّما الدهرُ عنها","قائمٌ يقذفُ الوبالَ نِبالا",52,"ل",2,0],["وقست بعين العقل عن كل واحد","له تجعل الأيام فيها مسالكا",53,"ك",2,0],["وقسموا الحرب أثلاثاً ومالهمو","قد أهملوه لمن يحتاج تهميلا",54,"ل",2,0],["وقسا فلولا أن أحاشيَ مجدَه","منها لقلتُ ملولةٌ مِطرافُ",55,"ف",1,0],["وقسمتم بذابل ونوال","في العدى والوفود قصماً وقسما",56,"م",2,0],["وقسم أوقات الفراغ وكلها","فراغ على أفراسه والزوارق",57,"ق",1,0],["وقسم ساكن جهلا","وليس العلم إلهاما",58,"م",2,0],["وقسم قلبه دام","وكان الفقر إلجاما",58,"م",2,0],["وقسم حاكم طاغ","يسوق الناس أنعاما",58,"م",2,0],["وقسم خائن يمشي","وراء الناس نمّاما",58,"م",2,0],["وقسم خائف يدري","غدا في الناس حلّاما",58,"م",2,0],["وقسم ساخر يهذي","يزيد القلب إضراما",58,"م",2,0],["وقسم عارف حيّ","يرى الإذلال إعداما",58,"م",2,0],["وقس الخطي بين النشاوى ضابطا","مقدار ما تخطوه بالمقياس",59,"س",1,0],["وقِسْمٍ ما لَهُ في الْعِلْمِ حَظٌّ","وكانَ لَهُ حُظُوظٌ في النِّزالِ",60,"ل",1,0],["وقسم في ذوي الإيمان خافٍ","عن الساهي من العبد الكنود",61,"د",1,0]]}