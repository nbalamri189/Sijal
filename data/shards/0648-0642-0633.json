1,0],["وقس على ذلك تعشَّ فاعلم","أَما إِذا قيل لك ادنُ فاطعَم",140,"م",1,0],["وقسمه نصيبه والمصدر","القَسم والصَّدق القوي يذكر",141,"ر",1,0],["وَقُسِّمَتِ الإِغرِيقُ بالعَشَرَاتِ وَال","كُؤُوسَ بَنُو إِليُونَ أَجرت ضَوَافِيا",142,"ي",2,0],["وقسمة الجزاء بالسواء","لكن آخيل بلا إبطاء",143,"ا",2,0],["وَقِس عَلَى هَذا جَمِيعَ مَا اشتَبَه","فِى الذِّكرِ وَالحَدِيثِ وَادرِ المَرتَبَه",144,"ه",1,0],["وقس على عرف نسيم الريح","اذا سرى من نحو أرض نجد",145,"د",1,0],["وَقَس مَضى طولَ الحَياة موحَداً","وَما نَقَل التَثليث عَنهُ وَلا اِجتَرا",146,"ر",2,0],["وَقسمٌ ذَليلٌ النَفسِ ماتَ بِجَهلِهِ","فَلا أُنكرُ الحُكمَ الإِلَهيَّ وَعَدلِهِ",147,"ه",1,0],["وقساء قلب للنصوح مخالف","ومخالف لذوى الاثام مداجى",148,"ج",2,0],["وقسم بالذي أولاك حزما","هز بريا وعقلا هز بريا",149,"ي",2,0],["وَقسّي مِنَ الحَواجِبِ راشَت","لِقِتنالي مِن ذَلِكَ الجَفنِ نَبلا",150,"ل",2,0],["وقِس بنيَّ على ماقلَ من حكَمٍ","ما كلُّ شيءٍ يُقال خيفةَ العذَل",151,"ل",1,0],["وَقسمَةُ العُلومِ وَالأَخلاقِ","كَقسمَةِ الأَعمارِ وَالأَرزاقِ",152,"ق",1,0],["وقسة بالشمس فإن الشيء قد","يعرف بالاشباه والنظائر",153,"ر",1,0],["وقسّمتني للحزن والهم والعنا","أضرّ بقلبي عفّةً لي تقصّفُ",154,"ف",1,0],["وقسموه على أهوائهم شيعا","فوضفوه بما يقضي به الطلب",155,"ب",1,0],["وقسطاً ليس ينشره","على أرضٍ سوى الأَولى",156,"ل",2,0],["وَقِسِ اَلْمَرَامِي كُلَّمَا هِيَ أَشْكَلَتْ","حَتَّى تَصِيرَ إِلَى سَبِيلٍ مَاحِصِ",157,"ص",1,0],["وقسوت في ضغط النهو","د فكدن يخرقن الثيابا",158,"ب",2,0],["وَقِسْهُ بِقَعْقاعٍ أَوْ بِيَزِيدٍ","وَعَمْروِ العُلا أَوْ مُجِيرِ الجَرادِ",159,"د",1,0],["وقسمته في الشعر شطرا إلى شطر","وقسمته في النثر سطرا إلى سطر",160,"ر",1,0],["وقسوة قلبهم زادت علينا","بوحيِ بلادة العقل المُعادي",161,"د",2,0],["وقسم اللّه تساوق الخير","بسر كن عند مراد الخالق",162,"ق",1,0],["وقسمتم قيد الفخار فنصفه","للعالمين ونصفه للموصل",163,"ل",1,0],["وقسا فلولاً أنْ أحاشيَ مجدهُ","منها لقلتُ كلولة ٌ مطرافُ",164,"ف",1,0]]}