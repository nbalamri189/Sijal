{"poems":[[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[63,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[93,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[66,"تنزه عتبي عن خطاك صواب","https://www.aldiwan.net/poem39643.html","الطويل"],[40,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"وكأن غلي دنانهم في دورهم","https://www.aldiwan.net/poem63866.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[161,"يا من عطاياه منها النصر والظفر","https://www.aldiwan.net/poem58802.html","البسيط"],[212,"قصر الرشيد رأيته","https://www.aldiwan.net/poem46778.html","مجزوء الكامل"],[280,"ذرا السعي في نيل العلا والفضائل","https://www.aldiwan.net/poem2630.html","الطويل"],[288,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[288,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[349,"كانت سطورك ترياقا لقيت بها","https://www.aldiwan.net/poem20113.html","البسيط"],[349,"أنضيت هرتي الغضبى وجدياني","https://www.aldiwan.net/poem20761.html","البسيط"],[354,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[367,"لم يبق بعدكم دموع","https://www.aldiwan.net/poem17225.html","مجزوء الكامل"],[394,"أشكو إليك زمانا ظل يعركني","https://www.aldiwan.net/poem53398.html","البسيط"],[404,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[409,"وكان غريب الحسن قبل عذاره","https://www.aldiwan.net/poem4194.html","الطويل"],[417,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[459,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[465,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[494,"سألت زماني بمن أستغيث","https://www.aldiwan.net/poem67359.html","المتقارب"]],"verses":[["وَكَأَنَّ غُرَّتَهُ وَراءَ لِ","ثامِ لَيلَتِهِ شِهابُ",0,"ب",1,0],["وكانَ غُرابُ البَيْنِ يُخْشى نَعيبُهُ","فكيفَ دَهَتْني بالفِراقِ بُروقُ",1,"ق",1,0],["وَكَانَ غَيْثاً وَغَوْثاً","لِلْمُعْتَفِي وَالْهَضِيمِ",2,"م",1,0],["وكان غروراً كل ما حالفوا به","وشرّ الحليفَين الذي خان أو غرّا",3,"ر",2,0],["وكأنَّ غُرَّةَ وجْهِها","شمسٌ تُطالِع من غُيومِ",4,"م",1,0],["وَكانَ غَرامي فيكَ إِذ كُنتَ وامِقاً","بِصَوني كَما صانَ الحُسامُ قِرابُ",5,"ب",1,0],["وَكَأنَّ غالِيَةً تُباشِرُها","تَحتَ الثِيابِ إِذا صَفا النَجمُ",6,"م",1,0],["وكانَ غيرَ عجيبٍ أن يجيءَ لهُ ال","معنى العِراقيّ في اللفظِ الحجازيّ",7,"ي",1,0],["وكأنَّ غَيضاتِ الرِّماحِ حدائقٌ","لُمَعُ الأسِنّةِ بينها أزهار",8,"ر",1,0],["وَكَأَنَّ غَليَ دِنانِهِم في دورِهِم","لَغَطُ العَتيكِ عَلى خِوانِ زِيادِ",9,"د",1,1],["وكان غير أنابيبٍ يحوط بها","ضلوعَ صدركَ قهّارٌ وظلَّامُ",10,"م",1,0],["وكان غيرك يجبي ما سمحت به","وليس يعطي الذي يعطي ولا العشرُ",11,"ر",1,0],["وكأنّ غيم ظلالها","شاماتُ حسن في الخدود",12,"د",1,0],["وكان غيوراً ذب عن دين أحمدٍ","وأدفع عنه من شجاعٍ مقاتل",13,"ل",1,0],["وَكَأَنَّ غِزلانَ الصَرائِمِ إِذ","مَتَعَ النَهارُ وَأَرشَقَ الحَدَقُ",14,"ق",1,0],["وَكَأَنَّ غارِبَها رَباوَةُ مَخرَمٍ","وَتَمُدُّ ثِنيَ جَديلِها بِشِراعِ",15,"ع",1,0],["وَكانَ غَايتُها أَرجُوهُ كَفَّ أَذًى","فَأَتْبَعَ الكَفَّ بالإحسانِ مِنهُ يَدا",16,"د",2,0],["وكانَ غايةُ قصدِي أَنْ أُبدَّلَ من","لَفظِ الأَدِيبِ بِأَنْ أُدعَى بحوبانِ",17,"ن",1,0],["وَكَأَنَّ غُصن البان مِن فنن الرُبى","خودٌ يرنِّحها الدلال رداحُ",18,"ح",1,0],["وَكَأَنّ غُرَّةَ وَجهِهِ","في لَيلِها فَجرٌ صَديعُ",19,"ع",1,0],["وَكانَ غالي بِهِ حيناً فَأَرخَصه","يا من رَأى صَفو ودٍ بيع بِالثَمَن",20,"ن",1,0],["وكان غنياً آمناً متنعماً","فأضحى فقيراً خائفاً غير طاعم",21,"م",1,0],["وكان غريبَ الحُسنَ قبل عِذاره","فلمّا بدا صار الغَريبَ المُصنَّفا",22,"ف",2,1],["وكان غايته الحرمان يومئذٍ","ولو أطاعك واسترضاك ما حرما",23,"م",2,0],["وكان غبيناً من أميَّةَ من شَرَى","مديحَ غِياثٍ وهو مغلٍ فبائعُ",24,"ع",1,0],["وكانَّ غصن ألبان في أوراقهِ","هيفاءُ خاطرةٌ بكمٍّ مسبل",25,"ل",1,0],["وَكانَ غِذائي نَقِيُّ الأَرُزِّ","فَها أَنا مُقتَنِعٌ بِالحَشيشِ",26,"ش",1,0]]}