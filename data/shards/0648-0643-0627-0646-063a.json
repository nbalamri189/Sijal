{"poems":[[55,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[65,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[95,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[90,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[53,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[68,"تنزه عتبي عن خطاك صواب","https://www.aldiwan.net/poem39643.html","الطويل"],[42,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[52,"وكأن غلي دنانهم في دورهم","https://www.aldiwan.net/poem63866.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[164,"يا من عطاياه منها النصر والظفر","https://www.aldiwan.net/poem58802.html","البسيط"],[215,"قصر الرشيد رأيته","https://www.aldiwan.net/poem46778.html","مجزوء الكامل"],[284,"ذرا السعي في نيل العلا والفضائل","https://www.aldiwan.net/poem2630.html","الطويل"],[292,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[292,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[353,"كانت سطورك ترياقا لقيت بها","https://www.aldiwan.net/poem20113.html","البسيط"],[353,"أنضيت هرتي الغضبى وجدياني","https://www.aldiwan.net/poem20761.html","البسيط"],[358,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[371,"لم يبق بعدكم دموع","https://www.aldiwan.net/poem17225.html","مجزوء الكامل"],[398,"أشكو إليك زمانا ظل يعركني","https://www.aldiwan.net/poem53398.html","البسيط"],[409,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[414,"وكان غريب الحسن قبل عذاره","https://www.aldiwan.net/poem4194.html","الطويل"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[463,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[498,"سألت زماني بمن أستغيث","https://www.aldiwan.net/poem67359.html","المتقارب"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82804","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137646",""],[857,"","https://poetry.dctabudhabi.ae/diwan/poem/73709","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96633","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16779","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44808","الكامل"],[1681,"","https://poetry.dctabudhabi.ae/diwan/poem/146778","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114711","الطويل"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143781","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53033","الكامل"],[2372,"","https://poetry.dctabudhabi.ae/diwan/poem/146240","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2792,"","https://poetry.dctabudhabi.ae/diwan/poem/123625","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205847",""],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118796","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100736","الطويل"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/10","الكامل"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131367","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103806","الكامل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114632","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22087","الكامل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123953","الطويل"],[4988,"خبروهاااا ., الوطن بدوا الشمآل","https://www.poetsgate.com/ViewPoem.aspx?id=180843",""],[5582,"تَهْنا أَبَيْتَ اللَّعْنَ بِالمَوْلُودِ","https://www.poetsgate.com/ViewPoem.aspx?id=63486",""],[6069,"وأهيف القد سهل الخد أسمر","https://www.poetsgate.com/ViewPoem.aspx?id=105667",""],[463,"لكلِّ هوى منْ رائدِ الحزمِ رادعٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60127&r=&rc=183",""]],"verses":[["وَكَأَنَّ غُرَّتَهُ وَراءَ لِ","ثامِ لَيلَتِهِ شِهابُ",0,"ب",1,0],["وكانَ غُرابُ البَيْنِ يُخْشى نَعيبُهُ","فكيفَ دَهَتْني بالفِراقِ بُروقُ",1,"ق",1,0],["وَكَانَ غَيْثاً وَغَوْثاً","لِلْمُعْتَفِي وَالْهَضِيمِ",2,"م",1,0],["وكان غروراً كل ما حالفوا به","وشرّ الحليفَين الذي خان أو غرّا",3,"ر",2,0],["وكأنَّ غُرَّةَ وجْهِها","شمسٌ تُطالِع من غُيومِ",4,"م",1,0],["وَكانَ غَرامي فيكَ إِذ كُنتَ وامِقاً","بِصَوني كَما صانَ الحُسامُ قِرابُ",5,"ب",1,0],["وَكَأنَّ غالِيَةً تُباشِرُها","تَحتَ الثِيابِ إِذا صَفا النَجمُ",6,"م",1,0],["وكانَ غيرَ عجيبٍ أن يجيءَ لهُ ال","معنى العِراقيّ في اللفظِ الحجازيّ",7,"ي",1,0],["وكأنَّ غَيضاتِ الرِّماحِ حدائقٌ","لُمَعُ الأسِنّةِ بينها أزهار",8,"ر",1,0],["وَكَأَنَّ غَليَ دِنانِهِم في دورِهِم","لَغَطُ العَتيكِ عَلى خِوانِ زِيادِ",9,"د",1,1],["وكان غير أنابيبٍ يحوط بها","ضلوعَ صدركَ قهّارٌ وظلَّامُ",10,"م",1,0],["وكان غيرك يجبي ما سمحت به","وليس يعطي الذي يعطي ولا العشرُ",11,"ر",1,0],["وكأنّ غيم ظلالها","شاماتُ حسن في الخدود",12,"د",1,0],["وكان غيوراً ذب عن دين أحمدٍ","وأدفع عنه من شجاعٍ مقاتل",13,"ل",1,0],["وَكَأَنَّ غِزلانَ الصَرائِمِ إِذ","مَتَعَ النَهارُ وَأَرشَقَ الحَدَقُ",14,"ق",1,0],["وَكَأَنَّ غارِبَها رَباوَةُ مَخرَمٍ","وَتَمُدُّ ثِنيَ جَديلِها بِشِراعِ",15,"ع",1,0],["وَكانَ غَايتُها أَرجُوهُ كَفَّ أَذًى","فَأَتْبَعَ الكَفَّ بالإحسانِ مِنهُ يَدا",16,"د",2,0],["وكانَ غايةُ قصدِي أَنْ أُبدَّلَ من","لَفظِ الأَدِيبِ بِأَنْ أُدعَى بحوبانِ",17,"ن",1,0],["وَكَأَنَّ غُصن البان مِن فنن الرُبى","خودٌ يرنِّحها الدلال رداحُ",18,"ح",1,0],["وَكَأَنّ غُرَّةَ وَجهِهِ","في لَيلِها فَجرٌ صَديعُ",19,"ع",1,0],["وَكانَ غالي بِهِ حيناً فَأَرخَصه","يا من رَأى صَفو ودٍ بيع بِالثَمَن",20,"ن",1,0],["وكان غنياً آمناً متنعماً","فأضحى فقيراً خائفاً غير طاعم",21,"م",1,0],["وكان غريبَ الحُسنَ قبل عِذاره","فلمّا بدا صار الغَريبَ المُصنَّفا",22,"ف",2,1],["وكان غايته الحرمان يومئذٍ","ولو أطاعك واسترضاك ما حرما",23,"م",2,0],["وكان غبيناً من أميَّةَ من شَرَى","مديحَ غِياثٍ وهو مغلٍ فبائعُ",24,"ع",1,0],["وكانَّ غصن ألبان في أوراقهِ","هيفاءُ خاطرةٌ بكمٍّ مسبل",25,"ل",1,0],["وَكانَ غِذائي نَقِيُّ الأَرُزِّ","فَها أَنا مُقتَنِعٌ بِالحَشيشِ",26,"ش",1,0],["وَكانَ غائر هَذا الأَنف مُزدَهيا","تَعلوه أَرنبة بِالحُسن شماء",27,"ا",2,0],["وكان غلام على ظهره","ومن ثم رام يشق الحاما",28,"م",2,0],["وَكانَ غَنيمَةً لأَميرِ قَومٍ","مَسالِكُهُ إِلى الغاراتِ فيحُ",29,"ح",1,0],["وَكأَنّ غدوة يوم مولده لنا","وَحسن بهجته صبيحة عيدِ",30,"د",1,0],["وَكَأَنَّ غُرَّتَهُ تُفَضِّضُ وَجهَهُ","وَالنَقعُ يُذهِبُهُ وَإِن لَم يُذهَبِ",31,"ب",1,0],["وكان غبّ ثراهُ في مرابعها","مرعىٍ من الأمن في مرعى اليعاسيبِ",32,"ب",1,0],["وَكَأَنَّ غضَّ الزهرِ فِي خُضرِ الرُّبَى","زهرُ النجُومِ تَلُوحُ بِالخَضراءِ",33,"ا",2,0],["وكأن غيم الجو يسكب دمعه","من حزنه والروض يضحك شامتا",34,"ت",2,0],["وكانَ غياثَ الناسِ في كلِّ شدَّةٍ","وفرحةَ مَن أَوفى وتَرحةَ مَن ظَعَن",35,"ن",1,0],["وكان غالى به حيناً فأرخصه","يا من رأى صفو ود بيع بالغبن",36,"ن",1,0],["وكأن غصن البان حين تهزه","نفحات أنفاس الرياح لواؤه",37,"ا",3,0],["وكأن غصن أراكة ميادة","خضراء قد طلت بماء غمام",38,"م",1,0],["وكان غريغوري لدى القحط باسطاً","يد البذل وهو الغوث للناس والرفد",39,"د",1,0],["وكان غيثاً لأيتام وأرملة","وعصمة الناس في الأقتار واليسر",40,"ر",1,0],["وكان غصناً فأذبلته","نكباءُ في لفحة الهجير",41,"ر",1,0],["وكان غِناه في الوقوف بباباه","ففي باب مولانا المهيمن مقنعُ",42,"ع",1,0],["وكان غلاماً في نضارة وجهه","وطلعته ماء الشباب يجول",43,"ل",1,0],["وَكَأَنَّ غِزلانَ الصَريمِ بِها","تَحتَ الخُدورِ يُظِلُّها الظُلَلُ",44,"ل",1,0],["وكان غوثا لنا في كل معضلة","يفيىء ظلّ علينا منه ممدود",45,"د",1,0],["وكان غَماماً يُحيّي الوجودَ","ويُحْيي فقدْ منعَتْ سَكْبَهُ",46,"ب",2,0],["وكأن غائرة النجوم بأفقها","عن وجهه تغضي عيوناً حولا",47,"ل",2,0],["وكأن غصن قوامه","من ماء دمعى يشرب",48,"ب",1,0],["وكانَ غُلُوكُس لَهُ ابناً كَما","لِهَذا بَلِيرُوفُنٌ قَد نَما",49,"م",2,0],["وَكأَن غاليَةً تُباشِرُها","تَحتَ الثيابِ إِذا صَغا النَجمُ",50,"م",1,0],["وكان غدير الماء سبطا فمذ هفت","على متنه ريح الشمال تدرجا",51,"ج",2,0],["وكان غرّك يا غشيمه بعض أذناب وعيال","ما جذبتي في حظورك غير خايس أو بيلد",52,"د",1,0],["وَكَأَنَّ غُدْوَةَ يَوْمِ مَوْلِدِهِ لَنا","مِنْ حُسْنِ بَهْجَتِهِ صَبِيحَةُ عِيدِ",53,"د",1,0],["وكان غير عجيبٍ من ملاحته","أن يجمع الحسن فيه الغصن والقمرا",54,"ر",2,0],["وكانَ غبيناً في أميَّة َ منْ شرى","مديحَ غياثٍ وهو مغلٍ فبائعُ",55,"ع",1,0]]}