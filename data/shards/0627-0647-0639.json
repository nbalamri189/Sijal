/www.poetsgate.com/ViewPoem.aspx?id=120506",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5246,"أرقا أُعايشُ والفراق يؤرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187072",""],[5320,"آه على الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=41642",""],[5338,"دار النبي ومن بها ولد الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=187758",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5413,"أرجو بها بردةً أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=200583",""],[5443,"جنَّة الدُّنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185139",""],[5464,"وفي حقول فؤادي أتمَرَ القصب","https://www.poetsgate.com/ViewPoem.aspx?id=21368",""],[5582,"لِغِبْطَةِ العَيْشِ عِلاَّتٌ وَآفاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=186754",""],[5674,"أمشي ودربي غائرة","https://www.poetsgate.com/ViewPoem.aspx?id=186057",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5842,"الموت/ صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=128792",""],[5851,"عودة الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=175281",""],[5969,"معارضة القمر","https://www.poetsgate.com/ViewPoem.aspx?id=199870",""],[6102,"وهم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185329",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[6225,"تسرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78013&r=&rc=100",""],[6235,"نسرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77693&r=&rc=8",""]],"verses":[["آهٍ على قلبي وإنْ","شَقيتُ كَشَقْوَتِهِ قُلُوبْ",0,"ب",1,0],["آهٍ على العمر كيف ولَّى","آه على العيش إذ تبدَّلف",1,"ف",1,0],["آه على أيام دين قد خلت","آه عليها ثم آه آه",2,"ه",1,0],["آهٍ على الحُلْوِ في مرٍّ نَغَصُّ بهِ","تَقَطَّرَا عَسَلاً في السُّمِّ واصْطَفَقا",3,"ق",2,0],["آهٍ على حائرٍ ساهٍ ويَرشُدنا","وجائرِ القصد ضِلِّيلٍ ويَهدينا",4,"ن",2,0],["آهٍ على ملعبٍ أن نستبدَّ به","ويستبدَّ بنا أقصى أمانينا",4,"ن",2,0],["آهٍ على أيمنٍ من ربعِ صبوتنا","كنَّا نجولُ به غرًّا ميامينا",4,"ن",2,0],["آهٍ على الفُرصةِ ضيعتَها","والآن إذ تطلُبها لا تُتاح",5,"ح",1,0],["آه على الحلو في مر نغصّ به","تفطرا عسلاً في السم واصطفقا",6,"ق",2,0],["آهٌ عَلى زَمَن الشَبا","ب وَظله ذاكَ الظَليلِ",7,"ل",1,0],["آه على وقت مضى","مع الحبيب في اللوا",8,"و",2,0],["آه على شهبائهم وربوعها","ورياض ذاك الموطن البسام",9,"م",1,0],["آه على ليالي","انعمن بالوصال",10,"ل",1,0],["آه على ايام قرب قد مضت","والحب دان والعذول خجيل",11,"ل",1,0],["آه على ذاك الزمان ولطفه","قد راح يسكن زفرتي تذكارهع",12,"ر",3,0],["آه على قرب هاتيك الديار ويا","لهفاه شطت بنا عن اهلها الدار",13,"ر",1,0],["آه على تقبيل اعتابه","فتربها لمقلتي اثمد",14,"د",1,0],["آه على وقت مع الاحباب","قد مر لكن مر بعد ذهاب",15,"ب",1,1],["آه على حسنها وآه","لو ينفح الواجد الغليل",16,"ل",1,0],["آه على ليلة وصل ذهبت","قابلت بين بدرها وبدرى",17,"ر",2,0],["آهٍ عليك وآهٍ منك يا رشأ","عيونه السود محرابٌ لأهوائي",18,"ي",1,0],["آهِ عَيناكِ كَيفَ أُنكِرُ عَينَي","كِ وَقَلبي عَلَيهِما وَفُتوني",19,"ي",1,0],["آه على تلك الديار وأهلها","من حادث الدهر الممض الموجع",20,"ع",1,0],["آه على تلك الخيام وما حوت","من كل غان بالجمال المبدع",20,"ع",1,0],["آه على تلك القباب وما بها","من قاصر ومحجب ومبرقع",20,"ع",1,0],["آه على تلك الرياض وكل ما","فيها من الغيد الحسان الرتع",20,"ع",1,0],["آه على تلك الحياض ومن بها","من وارد أو شارب متضلع",20,"ع",1,0],["آه على غزلان حاجر والنقا","وظباء وادي المنحنى والأجرع",20,"ع",1,0],["آه على آرام رامة ترتعي","بسفوحها وحماثها المتمتع",20,"ع",1,0],["آه على أقمار أفلاك العلا","وشموسها المشرقات السطع",20,"ع",1,0],["آه عليه وآه بعده وعسى","يثبت اللَه إن السفر مرتحل",21,"ل",1,0],["آه على بعدها وآه","إذ عوقاني ديني وميني",22,"ن",2,0],["آه على عمري الذي ضيعته","وأتيت في أيامه بدواهي",23,"ي",1,0],["آه على عمر مضى أكثره","ولم أنل فيه من الدهر المنى",24,"ا",1,0],["آه على ريحانه","لو كان مما يُقطفُ",25,"ف