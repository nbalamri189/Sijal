erses":[["سَلَوتُ الهَوى وَالشَوقُ إِلّا ذُؤابَةٌ","تُراجِعُ قَلبي مِن نَوىً وَتَداني",0,"ي",1,0],["سَلوانَ لا أُعطي الجَآذِرَ لَفتَةً","أَو نَظرَةً إِلّا بِعَينِ لَمامِ",1,"م",1,0],["سَلوا مَضجَعِ عَنّي وَعَنها فَإِنَّنا","رَضينا بِما يُخبِرنَ عَنّا المَضاجِعُ",2,"ع",1,0],["سَلوّا الدُروعَ مِنَ العُبابِ وَأَقبَلوا","يَتَحَدَّبونَ عَلى القَنا المَيّادِ",3,"د",1,0],["سَلّوا مِنَ الأَبرادِ جِسمَكَ وَاِنثَنى","جِسمي يُسِلُّ عَلَيكَ في الأَبرادِ",3,"د",1,0],["سَلوني عَن مَجدِ المُفَعَّلِ وَاِسأَلوا","أَبي عَن أَبيهِ ذي الجَلالِ المُهَذَّبِ",4,"ب",1,0],["سَلَوتُ المَعالي إِن سَلَوتُكَ ساعَةً","وَما أَنا إِلّا مُغرَمٌ بِالعُلى صَبُّ",5,"ب",1,0],["سَلوا صَرفَ هَذا الدَهرِ كَم شَنَّ غارَةً","فَفَرَّجتُها وَالمَوتُ فيها مُشَمِّرُ",6,"ر",1,0],["سَلوا جَوادِيَ عَنّي يَومَ يَحمِلُني","هَل فاتَني بَطَلٌ أَو حُلتُ عَن بَطَلِ",7,"ل",1,0],["سَلوا عَنّا جُهَينَةَ كَيفَ باتَت","تَهيمُ مِنَ المَخافَةِ في رُباها",8,"ا",3,1],["سَلوا عَنّا دِيارَ الشامِ طُرّ","وَفُرسانَ المُلوكِ اقَيصَرِيَّه",9,"ي",2,0],["سَلوا النُعمانَ عَنّي يَومَ جاءَت","فَوارِسُ عُصبَةِ النارِ الحَمِيَّه",9,"ي",2,0],["سَلوا عَن قَميصي مِثلَ شاهِدِ يوسُفٍ","فَإِنَّ قَميصي لَم يَكُن قُدَّ مِن قُبلِ",10,"ل",1,0],["سَلُو عَنْ فُؤَادِي بَعْدَكُمْ كَيْفَ حَالُهُ","وَقَدْ قُوِّضَتْ عِنْدَ الصَّبَاحِ رِحَالُهُ",11,"ل",2,1],["سَلوا عنِ الحُبِّ منْ قَلْبي مُجرِّبَهُ","فَما المُقَلِّدُ يوماً مثْلَ مُجْتَهِدِ",12,"د",1,0],["سَلَوتَ عَنِ الدُنيا وَلَكِنَّهُم صَبَوا","إِلَيها بِما تُعطيهِمُ وَتَميرُ",13,"ر",1,0],["سَلوا الحِجا هَل قَضَت أَربابُهُ وَطَراً","دونَ المَقاديرِ أَو فازَت بِمَقصودِ",14,"د",1,0],["سَلوهُ أَأَغنَت عَنهُ في يَومِ خَلعِهِ","عَجائِبُهُ أَو أَحرَزَتهُ غَرائِبُه",15,"ب",2,0],["سَلوا التُركَ عَمّا أَدرَكوا فيهِ مِن مُنىً","وَما بَدَّلوا في المَشرِقَينِ وَغَيَّروا",16,"ر",3,0],["سَلوا الفُرسَ عَن ذِكرى أَياديهِ عِندَهُم","فَقَد كانَ فيهِ الفُرسُ عُمياً فَأَبصَروا",16,"ر",3,0],["سَلوا بَغدادَ وَالإِسلامَ دينُ","أَكانَ لَها عَلى الدُنيا قَرينُ",17,"ن",1,0],["سَلوا الفَلَكَ الدَوّارَ هَل لاحَ كَوكَبٌ","عَلى مِثلِ هَذا العَرشِ أَو راحَ كَوكَبُ",18,"ب",1,0],["سَلوهُ إِن أَجابَكُمُ سَلَوهُ","سَلوهُ جُنَّ حَتّى سَلسَلوهُ",19,"ه",1,1],["سَلوا صَهواتِ الخَيلِ يَومَ الوَغى عَنّا","إِذا جُهِلَت آياتُنا وَالقَنا اللُدنا",20,"ن",2,1],["سَلوكٌ حينَ تَشتَبهُ الفَيافي","وَيُخطِئُ قَصدَ وِجهَتِهِ الدَليلُ",21,"ل",1,0],["سلو البارقَ النجديِّ من عَلَمَيْ نجدِ","تبسَّمِ فاستبكى جفوني من الوجدِ",22,"د",1,1],["سلوا بذلكم اليرموك واديَه","فإنه بسوى ما قلت لم يُجب",23,"ب",1,0],["سَلوهُنَّ إِن كَذَّبتُموني مَتى الفَتى","يَذوقُ المَنايا أَو مَتى الغَيثُ واقِعُ",24,"ع",1,0],["سلوت لكن قلبي يا سعاد سلي","وأنت في الحلّ من قلبي ومن قِبَلي",25,"ل",2,1],["سلوا عنهُ مصراً والشآم ففيهما","شواهد من آثارِه ودلائل",26,"ل",1,0],["سلونيَ عن جود الوزيرين إنَّ لي","ثناً يبدئ الذكر الجميل ويختمُ",27,"م",1,0],["سَلَوْتُ شَبابي والرّضاعَ كليهما","فكيف تُراني سالياً ما سِواهُما",28,"م",2,1],["سلوتُ عن خطَّة الخليط وعن","مرتبِعٍ منهمُ ومخترِفِ",29,"ف",1,0],["سلوتُ مراضعي وصِبا شبابي","فكيف يعزُّ أن يُسْلَى خليل",30,"ل",1,0],["سلوتُ الرضاعَ والشبابَ كليهما","فكيف تُراني سالياً ما سواهما",31,"م",2,1],["سلوا الكُبراءَ عن عيدَيْن شتَّى","متى كانا كذا يتجاوران",32,"ن",1,0],["سَلوا دَمعَ عَيني عَن أَحاديثِ لَوعَتي","لِتُعرِبَ عَن تِلكَ الشُؤونِ شُؤوني",33,"ي",1,0],["سَلوا الدارَ عَمّا يَزعَمُ الناسُ بَينَنا","لَقَد عَلِمَت أَنّي أَعِفُّ وَأَظرَفُ",34,"ف",1,0],["سَلوا النَجمَ يُخبِركُم بِحالِيَ في الدُجى","وَلا تَسأَلوا عَمّا تَجِنُّ ضُلوعي",35,"ي",1,0],["سَلوا الرَكبَ إِن وافى مِنَ الغَورِ نَحوَكُم","يُخَبِّركُمُ عَن لَوعَتي وَرَسيسي",36,"ي",1,1],["سلوا كؤوس الطلا هل لامست فاها","واستخبروا الراح هل مسّت ثناياها",37,"ا",3,1],["سلوا باراللواء وصُلت عني","ومصطبة السِرى الشيخ الأجل",38,"ل",1,0],["سلوا عنه القضية هل حماها","وكان حمى القضية مستباحا",39,"ح",2,0],["سلوا الآثار من يغدو يغالى","بها ويروح محتفظا حفيا",40,"ي",2,0],["سلوا تاريخنا وسلوا عليا","ألم يملأ بنا الدنيا دويا",41,"ي",2,0],["سلوه وأهله أيام ثاروا","ألم نقبض عليه وهو نار",41,"ر",1,0],["سَلُّوا خَراسانَ وَنعمَ الماضي","في الأَمر مُستقبلِهِ وَالماضي",42,"ي",1,0],["سَلوا عَنهُ ميلونا وَما في شِعابِهِ","وَفي ذِروَتَيهِ مِن نُسورٍ وَأَعظُمِ",43,"م",1,0],["سَلوا أَهلَ الكِنانَةِ هَل تَداعَوا","فَإِنَّ الخَصمَ بَعدَ غَدٍ تَداعى",44,"ع",2,0],["سَلوا الأَرضَ هَل زُيِّنَت لِلعَليمِ","وَهَل أُرِّجَت كَالجِنانِ الحُفَر",45,"ر",1,0],["سَلو الحُرِيَّةَ الزَهراءَ عَنّا","وَعَنكُم هَل أَذاقَتنا الوِصالا",46,"ل",2,0],["سَلوهُ هَل تَرَجَّلَ في هُبوبٍ","مِنَ النيرانِ أَرجَلَتِ الجِبالا",46,"ل",2,0],["سَلوا غَزالاً غَزا قَلبي بِحاجِبِهِ","أَما كَفى السَيفُ حَتّى جَرَّدَ القَلَما",47,"م",2,0],["سَلوا صاحِبَ المُلكَينِ هَل مَلَك القُوى","وَأُسدُ الشَرى تَعنو لَهُ وَتُحارِبُه",48,"ب",2,0],["سَلو قَلبي غَداةَ سَلا وَثابا","لَعَلَّ عَلى الجَمالِ لَهُ عِتابا",49,"ب",2,1],["سَلوا اللّهَ إبقاءَ الوزيرِ فإنَّهُ","سيحمِلُهُ يوماً على مركَبٍ وَعْرِ",50,"ر",1,0],["سَلَوتُ عَنِ الدَهرِ الَّذي كانَ مُعجِباً","وَمِثلُ الَّذي قَد كانَ مِن دَهرِنا يُسلي",51,"ي",1,1],["سَلوا خالِداً لا أَكرَمَ اللَهُ خالِداً","مَتى وَلِيَت قَسرٌ قُرَيشاً تَدينُها",52,"ن",3,1],["سَلَوْتُ محمَّداً لمَّا تَمادى","به الهِجرانُ وانقطَع العِتابُ",53,"ب",1,1],["سَلوا بَعدَ تَسآلِ الوَرى عَنكُمُ عَنّي","فَقَد شاهَدوا ما لَم يَرَوا مِنكُمُ مِنّي",54,"ي",1,1],["سلونيَ عنه واسْمعوا الصدق إنّني","أُحَدّثُ عن هِمّاتهِ وفواضِلِه",55,"ل",2,0],["سَلُوهُ وراعوا لفظةً من خِطابهِ","لتُعْلَمَ من نجواه ناجيةُ الحبِّ",56,"ب",1,0],["سَلَوتُ إِن كُنتُ أَدري ما تَقولُ إِذَن","مَجَّت مَقالَتَها في وَجهِها أُذُني",57,"ن",2,0],["سلوا مَنْ ذاقَهُ يوماً","فلستُ بعالمٍ ما هو",58,"ا",3,0],["سَلوا أُمَّ عَمروٍ هَل يُنَوَّلُ عاشِقٌ","أَخو سَقَمٍ أَم هَل يُفَكُّ أَسيرُ",59,"ر",1,0],["سلوا البطل الصريع بأي جرح","رمى كبدي ففي فمه الجواب",60,"ب",1,0],["سلوا كلّ ذي مأربٍ هل قَضاهْ","بغير الجهادِ وطولِ الكفاحْ",61,"ح",1,0],["سلوا الشرّقَ والإسلامَ ما بالُ لاعجٍ","من الوجدِ ما ينفكُّ حرَّانَ ثائرا",62,"ر",2,0],["سلوا يثربَ الوَلْهَى بمن شفَّها الأسى","سلوا البيتَ ماذا هاجه والمشاعرا",62,"ر",2,0],["سلوا المسجد الأقصى أما بات واجداً","يُكابد ليلاً في فلسطينَ ساهرا",62,"ر",2,0],["سلوا المَلِكَ المُلقَى بِمُعتَركِ البِلىَ",