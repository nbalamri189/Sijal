om/ViewPoem.aspx?id=195029",""],[5573,"ياحاتم","https://www.poetsgate.com/ViewPoem.aspx?id=200215",""],[5587,"عمر","https://www.poetsgate.com/ViewPoem.aspx?id=196902",""],[5670,"يَا مَلاذِي !","https://www.poetsgate.com/ViewPoem.aspx?id=211204",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5732,"حنا من المعروف تندا يدينا","https://www.poetsgate.com/ViewPoem.aspx?id=177858",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5893,"ما للعرب تاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=141278",""],[5956,"لله درك يا أحنَّ حبيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=193815",""],[5975,"يا إله الخلق..","https://www.poetsgate.com/ViewPoem.aspx?id=58780",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6213,"بعد المدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76304&r=&rc=52",""]],"verses":[["ياعِزَّ مَن أَضحى إِلَيهِ يَنتَمي","وَعُلوَّ مَن أَمسى بِهِ يَتَعَلَّقُ",0,"ق",1,0],["يا عزيزا يسعى لعز الرعايا","فله تجزل الثناء الناس",1,"س",1,1],["يا عَزيزاً لَنا بِمِصرَ عَلِمنا","أَنَّهُ بِالرِضا الخِديوِيِّ فائِزُ",2,"ز",1,1],["يا عَزيزُ دامَ لَنا","رَوضُ عِزِّكَ الأَشِبُ",3,"ب",1,0],["يا عَزيزَ السِجنِ بِالبابا إِلى","كَم تَرَدّى في الثَرى ذُلَّ السَجين",4,"ن",1,0],["يا عزيز الجنى عليك سلام","كيف جادت بقربك الأقدار",5,"ر",1,0],["يا عزيز الأنام والعصر سمعا","فلقد شاق منطقي الإصغاء",6,"ا",2,0],["يَا عَزِيزَيْنَا اللَّذَيْنِ اقْتَرَنَا","لِيَكُنْ عَيْشُكُمَا عَيْشَ صَفَاءْ",7,"ف",3,1],["يا عزَّ ما أبصرتُ فوق جبينه","إلا اقتضانى بالسجودِ جبينى",8,"ن",2,0],["يا عزاءً لحبيب","واهتماما بالندامة",9,"م",2,0],["يا عِزَّ ما فَعَل الزَمانُ بِصُحبَةٍ","كانَت قَديماً بَينَنا في أَربلِ",10,"ل",1,1],["يا عزاء المحزون إن حزب الكرب","وسلوى العاني إن اشتد جه",11,"ه",1,0],["يا عزيزاً أذلُّ طوعاً لديه","والهوى يترك الأعزَّ الأذلا",12,"ل",2,0],["يا عِزَّ دِينِ اللهِ لاَ","تَجْزَعْ لِبَيْنٍ شَتَّ جَمْعَا",13,"ع",2,0],["يا عزة العز يا جمل الجمال ويا","لبنا اللبنات يا عرباء يا عرب",14,"ب",1,0],["يا عزُّ إن تُعرِضي عنّا وتَنتصحي","قولَ الوشاةِ ومن يَلحاكمُ فِينا",15,"ن",2,0],["يا عَزيزاً كُلَّ وَقتٍ عَدلُه","لَم يَزَل في مَصر مَنشورَ العلم",16,"م",1,0],["يا عزيز الوادي زمانك هذا","في سلام الوادي وفي اطمئنانه",17,"ن",2,0],["يا عزيزاً على الآله وفي فص","ل القضا المستبدّ بالتقريب",18,"ب",1,0],["يا عَزيزي هَل تَرى الكَشرَةَ قَد","أَرجَعَت مِن فائِتٍ بَعدَ فَواتِ",19,"ت",1,0],["يا عزة الإِسلام مِن","ك وَنصرة الدين الغَريب",20,"ب",1,0],["يا عزيز المعز من ذل في خد","مته أرفع بعز عزك ذلي",21,"ل",2,0],["يا عزيزاً لا يُضَاهَى أبَداً","عِزُّهُ يكسُو العِدَا ثوبَ الهوان",22,"ن",1,0],["يا عز لا تعدو بلاد النيل","منازل الآباء والأجداد",23,"د",1,0],["يا عَزُّ إن عاد زمان المنى","فنعمة الأيام لا تُكفر",24,"ر",1,0],["يا عزة الباقي الأعظم","عطفه على ذلة الفاني",25,"ن",2,0],["يا عزّ دين الهدى إن يخش منقصة","بكلّ قَرْمٍ من الإِسلام صنديد",26,"د",1,0],["يا عِزّتالي يا نديم","يا طول صبري يا وِزاه",27,"ا",2,0],["يا عَزيز القَلب يا ذا ال","طَلعة الغرا البَهيّه",28,"ي",2,0],["يا عزيزاً علا على كل عال","وارتقى في الفخار أرفع ذروه",29,"و",2,0],["يا عِزَّ آل محمدٍ وهُمامَها","ولسانَها فيما حوى وكلامَها",30,"م",3,0],["يا عزمات العرب البواسل","هبي لحل هذه المشاكل",31,"ل",1,1],["يا عزائي في شقائي يا هدى","مهجتي إن أظلم الخطب دجاها",32,"ا",3,0],["يا عزيز البتول كل مصاب","بك ان مر عز فيه اصطباري",33,"ر",2,1],["يا عزيز البتول كيف سلوي","عن مصاب غض مدى الأعمار",33,"ر",1,0],["يا عزيز البتول كيف العزا عن","فجعةٍ أحرقت حشى المختار",33,"ر",1,0],["ياعزيز البتول ما خلت تمسى","خائفاً في جوار أمنع جار",33,"ر",1,0],["يا عزيز البتول ما خلت تمسى","نازحا خوف عصبة الأشرار",33,"ر",1,0],["يا عزيز البتول ما خلت تأوي","بعد مثوى النبي بيد القفار",33,"ر",1,0],["يا عزيز البتول ما خلت تمسى","لا ترى في البلاد دار قرار",33,"ر",1,0],["يا عزيز البتول ما خلت تمسى","في الوغى مفراً بلا انصار",33,"ر",1,0],["يا عزيز البتول كيف أمي","أدركت فيك سالف الأوتار",33,"ر",1,0],["يا عزيز البتول ما خلت تظما","حول شط الفرات والماء جاري",33,"ر",2,0],["ياعزيز البتول ما خلت يمسى","لك قلب من الظما كالنار",33,"ر",1,0],["يا عزيز البتول ما خلت ترمى","غرة المجد منك بالأحجار",33,"ر",1,0],["يا عزيز البتول ما خلت سهماً","يتخطى حجاب سر الباري",33,"ر",2,0],["يا عزيز البتول ما خلت تمسى","في الوغى نهب ذبل وشفار",33,"ر",1,0],["يا عزيز البتول ما خلت شمراً","لك يفرى نحراً بماضي الغرار",33,"ر",1,0],["يا عزيز البتول ما خلت شمراً","يرتقي منك معدن الاسرار",33,"ر",1,0],["يا عزيز البتول ما خلت صدراً","لك يغدو للخيل كالمضمار",33,"ر",1,0],["يا عزيز البتول ما خلت كفاً","لك تغدو مقطوعة بالشفار",33,"ر",1,0],["يا عزيز البتول ما خلت ثقلاً","لك يضحى نهباً إلى الأشرار",33,"ر",1,0],["يا عزيز البتول ما خلت تبدى","حرم صنتها من الاستار",33,"ر",1,0],["يا عزيز البتول ما خلت تسبى","حرم قد حميت بالبتار",33,"ر",1,0],["ياعزيز البتول ما خلت تستا","ق بنات الهدى على الاكوار",33,"ر",1,0],["ياعزيز البتول ما خلت يبقى","لك جسم مبضعاً في القفار",33,"ر",1,0],["يا عزيز البتول ما خلت يمسي","لك جسم مكفناً بالذاري",33,"ر",2,0],["يا عزيز البتول ما خلت تبقى","عارياً بالعرى بلا اقبار",33,"ر",1,0],["يا عزيز البتول ما خلت يهدى","لك رأس على القنا الخطار",33,"ر",1,0],["يا عزيز البتول ما خلت تغدو","صعدة الرمح مطلع الأنوار",33,"ر",1,0],["يا عزيز البتول ما خلت يعلو","ثغرك الخيزران من جبار",33,"ر",1,0],["يا عز من أنت يا مولاي سيده","يا ذل من لست يا مولاي مولاه",34,"ا",2,0],["يا عزمَ قلبٍ كنت فيه على النوى","ما كان أقاساه ولم يك قاسيا",35,"ي",2,0],["يا عزة الفتيان يومك لم يدع","للناس صبراً في الرزية منجدا",36,"د",2,0],["يا عزُّ عَزَّ الوَجد صَبري بِما","أَصبَحتِ مِن حُسنِك تُبدينَه",37,"ن",2,1],["يا عزَهُ لو لم يعزُّ عزاؤه","يا ذلّهُ إنْ لم تُعنه دموعُهُ",38,"ع",2,0],["يا عَزيزَ السرِّ يغلو","وصلُهُ الدهرَ بِسَومِ",39,"م",1,0],["يا عزيزاً لم تَبتَذله العيونُ","فَهو عن أعينِ الأنامِ مَصونُ",40,"ن",1,1],["يا عزائي أسلمتني لاشتياقي","حين عز الهوى وذل العبادُ",41,"د",1,0],["يا عزيز المثلِ في البشرِ","جلَّ عن ندٍّ وعن قدرِ",42,"ر",1,1],["يا عِزي ال حالي ويا ويل .. يا ويل","وَحدي أنا .. ما غَيره الوهم يِختال",43,"ل",1,0],["يا عزتي لك يالشرف لو تنعي","قدرك وكف العهر لك خنّاقه",44,"ق",2,0],["يا عزيزاً على الحشاشةِ أنّي","لست أسلوكَ لو تزولُ الرواسي",45,"س",2,0],["ياعزاء فيض المشاعر وألوفاء","ياعزاء غيض ألمشاعر والوعد",46,"د",1,0],["ياعزائه لذكر طيب وفاء","عن عزائه بذكرك روح جسد",46,"د",1,0],["يا عزَّةَ النَّفسِ والأمْجادُ تَعْشقُنا","هلْ يُسْعفُ العُمْرُ والأحْلامُ والشِّيَمُ",47,"م",1,0],["يا عزيز النّدى ويا جوهر الجو","هر من آل هاشم بالبطاح",48,"ح",1,1],["ياعزم طالوت ياإقدام من وثبوا","اقتل بنا اليأس خلِّ النصرَ ينسكبُ",49,"ب",1,0],["ياعزم طالوت لاتأبه لنائبةٍ","مهما تراءت لنا الآلام والنوبُ",49,"ب",1,0],["ياعزم طالوت لاتأبه لفتنتهم","إنّا على الدرب مهما هدّنا النَصَبُ",49,"ب",1,0],["ياعزمَ طالوتَ لاتأبَه لنائِبةٍ","مهما تراءى على أعتابِكَ الشظفُ",50,"ف",1,0],["ياعزّة الروح شدّي الجرح واصطبري","وحسبك الله سلطان السلاطين",51,"ن",1,0],["يا عزوةً في ظلمة الليل ما تخيب","تقبل بشايرها مع علوم الذيابه",52,"ب",2,0],["يا عزتي ويدي تلامس وجنة","هل لامست شيئا من الجناتِ",53,"ت",1,0],["يا عزّة الله العظيم تنزّلي","فدماء أهلي أغرقت أنهارا",54,"ر",2,0],["ياعزى الي لويطوله بالدهر كثر النكايد","لالقاك يزول همه من ضلوعه والنكيده",55,"د",2,0],["يَا عِزَّ خَيْرِ الأَمَانِي كَيْفَ رُغْنَ بِهِ","فِي سِيرَةٍ نَثَرَتْ مَا أَوْرَقَ العُودُ",56,"د",1,0],["يا عزائي إذا كتمتُ أنيني","يا أنيسي في وحشتي وانفرادي",57,"د",2,0],["يا عزة أنت واللّه الذي حسنت","أسماؤه أنت محفوفٌ بعزتهِ",58,"ت",2,0],["يا عزنا يا ذخرنا بالملمات","زرق المعارف خلهم عنك ينحون",59,"ن",1,0],["يا عز راسي شفت ما خبث البال","شي ٍ يهوّل شيّب الجاهلينا",60,"ن",2,0],["ياعزُّ هل نضبتْ شطآننا وغدتْ","قاعا يجففُهُ الترحالُ والجَفلَ",61,"ل",1,0],["ياعزنا يا أهلنا في ربى الشام","أقسم قسم مايخذل الله عباده",62,"د",2,0],["يا عزةَ الدنيا ونورَ حنانها","ومخفِّفَ البأساء عن مَكروبِ",63,"ب",1,0],["يا عزيزاً يا كريما","يا عليماً يا عظيما",64,"م",2,1],["يا ( عزيز ) ان شفتني رايح تراني","انهك التلويع كلي يوم اغيب",65,"ب",1,0],["يا عزّ أهلينا أراك مضمَّراً","صحو النفوس كشفرة المقطاف",66,"ف",1,0]]}