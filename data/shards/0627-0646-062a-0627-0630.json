{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[159,"صولج لامين في عذارين","https://www.aldiwan.net/poem55539.html","المنسرح"],[287,"لا تخافي من الوشاة وزوري","https://www.aldiwan.net/poem32767.html","الخفيف"],[463,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122670","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122558","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120039","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120085","السريع"],[1058,"","https://poetry.dctabudhabi.ae/diwan/poem/198786","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203781",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25352","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106887","السريع"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105398","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58253","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133055","المنسرح"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205667",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76439","الرمل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143844","الخفيف"]],"verses":[["أنتَ أذبلتَ بالأسى قلبك الغضَّ","وحطَّمَت من رقيقِ كيانكْ",0,"ك",1,0],["أَنْتَ إِذا جُدْتَ ضَاحِكٌ أَبَداً","وَهْوَ إِذا جَادَ دَامِعُ العَيْنِ",1,"ن",1,0],["أَنتِ أَذلَلتِني وَكُنتُ عَزيزاً","في حِمىً مِن مَحَلَّةِ الشاغورِ",2,"ر",1,0],["أنت إذا الدهر رمى شاكلتي","دِرعي وأنت مُنذِري إن فوَّقا",3,"ق",2,0],["أنتَ إذا حُصلَت مَناسِبُ أهلِ ال","بَيتِ نَسلُ الخَليفَتَينِ مَعا",4,"ع",2,0],["أنتَ أذكى بَديهَةً أن تُبارَى","ثُم أزكى رَويَّةً أن تُحاجَى",5,"ج",2,0],["أنت أذكى وأنت أزكى إذا ما","فخر الناس عرف عرض وعرفا",6,"ف",2,0],["أنت إذا اسود الدجى راهب","وأنت ما أبيض الضحى مرهبُ",7,"ب",1,0],["أنت إذْ مت كم يهون البقاءُ!","وتنادي قصيدَها الشعراءُ!",8,"ا",2,1],["أنتِ أذكى لو تنفستِ شذاً","أنت أسمى لو تكلمت بيانا",9,"ن",2,0],["أَنْتَ إِذَا ما عَضَّ بِالناسِ العَدَمْ","أَنْتَ رَبِيع الأَقْرَبِينَ وَالعَمَمْ",10,"م",1,0],["أنتِ إذا استسقاك أَسقيته","من منهل الروح الطهور الكريم",11,"م",1,0],["أنتِ إذا استعطاك أعطيتِه","نظرةَ سعدٍ هي كنزٌ عظيم",11,"م",1,0],["أنت أذللتني وكنت عزيزاً","وكذاك الهوى يذل العزيزا",12,"ز",2,0],["أنتَ أذكى الملوكِ نَشراً وإن حا","ولتَ أمراً فأنتَ في الرأي أذكى",13,"ك",2,0],["أنت إذا جُدتَ ضاحِكٌ أبداً","وذَاكَ إِن جَادَ دامِعُ العَينِ",14,"ن",1,0],["أنت آذنت بخوفٍ","في هوانا وارتياب",15,"ب",1,0],["أَنت أذللت كِراما تحت خف","أَنت أَذبلت غصونا يانِعات",16,"ت",1,0],["أنت أذكرتني دموعي وقد صوَّ","بن بين العتاب والهجران",17,"ن",1,0]]}