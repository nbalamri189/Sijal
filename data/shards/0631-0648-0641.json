{"poems":[[154,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87052","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67842","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67830","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67827","الطويل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216673",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112818","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102130","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109449","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134193","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123487","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123525","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4875,"سلامتك","https://www.poetsgate.com/ViewPoem.aspx?id=133837",""],[5307,"آه يا من صوب وحاني","https://www.poetsgate.com/ViewPoem.aspx?id=10546",""],[5307,"يا عويد البان","https://www.poetsgate.com/ViewPoem.aspx?id=10540",""],[5480,"بت ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=4104",""]],"verses":[["رَؤُفٌ بِهِم حالاً شَفيعُهُمُ غَدا","ضَمينٌ بِإِنقاذِ العِبادِ مِنَ الرَدى",0,"د",2,0],["ر وفَى فسمَا أعلى الدرجِ","ولباب العلم ومن أولى",1,"ل",2,0],["رؤف بِالعِباد بِهم رَحيم","شَفيع فيهمُ يَوم الزِحام",2,"م",1,0],["رَؤُفٌ بِمَنْ يَسْعَى إلَيْهِ وَيَلْطُفُ","فَلُذْ بِحِمَاهُ تَنْجُ يَا مُتَخَوِّفُ",3,"ف",1,0],["رَؤُفٌ فَلَمْ يُوَجدْ غَلِيظاً وَلاَ فَظَّا","لَهَ السَّبْقُ فِي الْعُلْيَا عَلىَ مَا تَقَدَّمَا",4,"م",2,0],["رَؤُفٌ رَحِيمٌ بِالْعُصَاةِ شَفِيعُهُمْ","وَقَدْ غَرِقُوا فِي أَبْحُرِ الذَّنْبِ والوزر",5,"ر",1,0],["روف باْحمَد روف لا تْصدِّ","رِيح نفْسٍ فيك مجبوره",6,"ر",2,0],["رؤف مشفق بر رحيم","كريم محسن حسن القوام",7,"م",1,0],["رؤف لخلق اللَه منتجع لدى","الشدائد جالي ليل كفر وظلمة",8,"ه",1,0],["رَؤُفٌ رَحِيمٌ خُصَّ بِاسْمَيْنِ عُظِّمَا","لأَنَّهُمَا لِلَّهِ سُبْحَانَهُ اسْمَانِ",9,"ن",1,0],["رؤفنا في النوبَه","عليه اللَه صلّى",10,"ل",2,0],["رؤف بذي القرى حفيٌّ بصحبه","وفي عسرهم يلقون من فضله يسرا",11,"ر",2,0],["رؤف بالرعية ف","هو عنهم يدرء النقما",12,"م",2,0],["رؤف رحيم محسن متواضع","لدى السلم شهم في الحروب مغالث",13,"ث",1,0],["رؤف عطوف ذو حياء وعفة","جميع جهات الحسن في ذاته تحوى",14,"و",2,0],["روف ود لو كفل البرايا","وصير كل ذي فقر غنيا",15,"ي",2,0],["روفي بحالي عاد يا خير منطوق","ملّيت أراقب ساعتي والدقيقه",16,"ق",2,0],["روف بي ياريم لوطاني","لك مسلم ماليه دوره",17,"ر",2,0],["روف بي يا كامل الدلي","لا تعذب نفس ولهانه",18,"ن",2,0],["روف يا حلو التماثيلي","اسقي زرعن دوم مضمنه",19,"ن",2,0]]}