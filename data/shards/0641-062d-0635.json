{"poems":[[47,"للعلاء ابن صاعد في مدح","https://www.aldiwan.net/poem63607.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[92,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[132,"ورد الكتاب وسرني إتيانه","https://www.aldiwan.net/poem50487.html","الكامل"],[170,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[409,"أهنيك بالعام الجديد وإنما","https://www.aldiwan.net/poem33935.html","الطويل"],[469,"تجاوز دنيات العجيل وجهله","https://www.aldiwan.net/poem3301.html","عموديه"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103116","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53904","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77504","المنسرح"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102306","الكامل"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100686","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50030","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130696","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114797","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27937","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109593","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137123",""],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102565","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75906","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65959","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205036","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65253","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128910","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128899","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119617","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139674",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5736,"كما تدين تدان","https://www.poetsgate.com/ViewPoem.aspx?id=203842",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""]],"verses":[["فَحَصَلنا عَلى ثَناءٍ وَمَدحٍ","وَاِنصِرافٍ بِاللَيلِ في الطَيّارِ",0,"ر",1,0],["فحصت بطون الكون فحصاً فَلَم أَجِد","سوى حركات فيه لَم أَدرِ ماهيا",1,"ي",2,0],["فحِصّةُ مستحفزٍ مجرمٍ","لأشرفُ من حِصّةِ المجتدي",2,"د",2,0],["فحصورُه كمنيبه لأولى التقَى","وفؤادُه يُنْبيك عنه لسانُه",3,"ن",2,0],["فحصَ النسيمُ ترابَها فانشقَّ عن","نهرٍ كتنسيمِ الرحيقِ بَرَادِ",4,"د",1,0],["فَحَصَ التُرابَ لَهُ فَأُنبِعَ ماؤُهُ","فَأَراهُ كَيفَ وَضوءُ ذي قُربانِ",5,"ن",1,0],["فحَصَّنَ ما أولاك من كل نعمة","بحصن من الشكر للطرز بالحمد",6,"د",1,0],["فحصّل لهُ نعلاً يزين أديمهُ","فلا بدَّ للسيف الصقيلِ من النعل",7,"ل",1,0],["فحصنٌ مشيدٌ بالسّيوف مهدّمٌ","وبابٌ منيعٌ بالأنامل يُقْذَفُ",8,"ف",1,0],["فحصولها في الذهن بعد سلامة","إن طابقت في الذهن من غاياتها",9,"ت",3,0],["فحصلتُ في الأَسر الذي أدواؤُه","لرهينةٍ من أعْظمِ الأدواءِ",10,"ا",2,0],["فَحَصَلوا غابة فَحَطوا","لِراحة زانَها المَكانُ",11,"ن",1,0],["فَحِصنَ فثار على رأسهِ","من القاع مُعتَبَط أصهبُ",12,"ب",1,0],["فحصنت منك على الأياس وليته","لم يتبعه مرارة الترحال",13,"ل",1,0],["فحص خلل الأصابع منك واجهد","عسى أن لا يطوف ولا يبولا",14,"ل",2,0],["فحصحَص الحقُّ ولاح لاهدى","واقصر الغيُّ وكفّ الغرامْ",15,"م",1,0],["فحصُوا كُرَاتِ دَمِ الوريدِ وكيف قد","ردَّ الحياةَ لها دَمُ الشُّريَانِ",16,"ن",1,0],["فحصَّلَ من تلكَ البِقاعِ مَغانِماً","مغانم فتحٍ لا تُرامُ",17,"م",1,0],["فحصُ القباب إلى فحص الصعاب إلى","أوُريولةٍ مداسات إلى السّككِ",18,"ك",1,0],["فحصَّلتُ منها كلَّ خيرٍ وإنني","أسايف أوقاتاً ووقتاً أطاعنُ",19,"ن",1,0],["فحصنته باللَه حين رأيته","وعوذته من أعين الناس بالشب",20,"ب",1,0],["فحصصت بالتكريم من كلتيهما","يا من له قد عزت الاقران",21,"ن",1,0],["فحصّ بما رآه بغير شك","وأذهب بالبشارة كلّ حزنه",22,"ن",2,0],["فَحَصَّنتُهُ بِالصَبرِ فيكِ وَعِندَما","نَبَضت أَتاه السَهمُ مِن كُلِّ منفَذِ",23,"ذ",1,0],["فحصة احدى الفردتين تسيعه","وربع تسيعيه به قد قضى الباري",24,"ر",2,0],["فحصت الجيب كي ألقى نصيبا","لها فيه فأخطأها النصيب",25,"ب",1,0],["فحصّن على الطّير الفؤاد فإنّني","أخافُ عليه أن يُصاد من البازي",26,"ي",1,0],["فحصَتْ عن المعْنى الشّرودِ فأعْجَزَتْ","كيفَ اقتضَى إعْجابُها فُصَحاءَها",27,"ا",3,0],["فحصوا بطون الكائنات ليكشفوا","عما تكن هناك من أسرار",28,"ر",1,0],["فحصت بطون الكون فحصا فلم اجد","بذا الكون شخصا للمضلين هاديا",29,"ي",2,0],["فَحَصَرته فَفَتَحتَ معقِلها","فتحاً يطيش لفتكه العَقلُ",30,"ل",1,0],["فحصَّن ذاك القصر داوود فاغتدى","حصيناً وعنه انحطَّت الأنجم الزهر",31,"ر",1,0],["فحصل منهم في سماح مآتما","يقيمونها في ذلك الوقت والمحل",32,"ل",1,0],["فحصادُ نفسكِ ما زرعت لآخرٍ","واربأ بها، فكما تدينُ تدانُ",33,"ن",1,0],["فَحُصونُ الحياءِ أمْنَعُ، أَبْقى","مِنْ قرارٍ لِلْحَظْرِ أَعْمى العُيونِ",34,"ن",1,0],["فحصتها فوجدت المجد تربتها","ومنبع الشرف المآثور يرويها",35,"ي",3,0]]}