{"poems":[[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[261,"يا أيها السيد الجليل المرجو","https://www.aldiwan.net/poem48354.html","مخلع البسيط"],[382,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[443,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[556,"يا مليك الورى ومن عقد الله","https://www.aldiwan.net/poem48114.html","الطويل"],[580,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63739","المنسرح"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85235","الرمل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130440","البسيط"],[5386,"يحمدون الموت","https://www.poetsgate.com/ViewPoem.aspx?id=35634",""]],"verses":[["كل مدحٍ قد قيل في الناس قِدْماً","لك فيه بحَقِّك الثُّلثان",0,"ن",1,0],["كل مدح في غيركم فمُثاب","ما أُثيبت عبادة الأوثان",0,"ن",1,0],["كُلُّ مَدْحٍ أَرَاهُ فيكَ قَليلاً","وَكَثيرٌ مَا يَقْتَضيني فُؤادي",1,"د",2,0],["كلُّ مدحٍ في غيركم هذيانٌ","والهذاءُ الرَّدِىُّ يورِثُ حُمْقَا",2,"ق",2,0],["كلُّ مَدحٍ له وللناس طرّاً","كان فيه من مادحٍ إطراءُ",3,"ا",2,0],["كل مديحٍ أجملت فيه","يقصر عن فعلك الجميل",4,"ل",1,0],["كل مدحٍ لغير أهلِ مديحٍ","فهجاءٌ وخدعةٌ ومَعاب",5,"ب",1,0],["كل مدح يقال فيكم ويتلا","فهو حق يرضي الإله القديرا",6,"ر",2,0],["كُلُّ مَدحٍ وَإِن تَأنّق ذو الإح","سانِ فيهِ أَرضٌ وكنتَ سماءا",7,"ا",3,0],["كلُّ مدحٍ فيه فإِيَّاكَ أَعْنِي","وبأَسماءِ مَنْ مَدحْت أُوَرِّي",8,"ر",2,0],["كلُّ مديحِ يَقِلُّ فيكَ ولو","كانَ من الرَّمْلِ والحصى أكْثَر",9,"ر",1,0],["كُلُّ مدحٍ تَراهُ قِيلَ قَديماً","فَلَهُ القائِلُ القديم لَنَاحِ",10,"ح",1,0],["كُلُّ مَدحٍ قيلَ فيكا","خَبَرٌ عَن مُبتَداكا",11,"ك",2,0],["كل مدح لم يكن في المصطفى","فهو أخبار بأمر لا يصح",12,"ح",1,0],["كل مدام وإن شككت ها شفتي","وهذه الكأس فاختر ما تشاوذق",13,"ق",1,0],["كل مداين غربتين استوقفتني وعرفتني","كل تاريخٍ جمعنا / ( ليت ) مصنوع بوهن!",14,"ن",1,0]]}