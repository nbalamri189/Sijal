{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[9,"يظن الناس بالملكي","https://www.aldiwan.net/poem21983.html","مجزوء الوافر"],[88,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[37,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[11,"هل الدهر إلا اليوم أو أمس أو غد","https://www.aldiwan.net/poem233.html",""],[74,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[47,"نفقت نفوق الحمار الذكر","https://www.aldiwan.net/poem63583.html","الخفيف"],[63,"خلالك ما اختل الصديق سحائب","https://www.aldiwan.net/poem51388.html","الطويل"],[63,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[71,"مديد الزحاف سريع الخلاف","https://www.aldiwan.net/poem29132.html","المتقارب"],[107,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[42,"ألا من لعين لا تزال تسيل","https://www.aldiwan.net/poem42331.html","الطويل"],[54,"ألا رب يوم بالدويرة صالح","https://www.aldiwan.net/poem27084.html","الطويل"],[50,"أنا أبصرت صاح الشمس","https://www.aldiwan.net/poem64383.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62221","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[102,"زامر القفر العامر","https://www.poetsgate.com/ViewPoem.aspx?id=50393",""],[11,"هل الدهرُ إلا اليوم، أو أمسِ أو غدُ","https://www.poetsgate.com/ViewPoem.aspx?id=16837",""],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[47,"نفقت نفوق الحمار الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=31266",""],[87,"أنْدَلُسِيَّة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9527&r=&rc=17",""],[118,"رعى الله أياما تقضت بشيخون","https://www.aldiwan.net/poem41763.html","الطويل"],[134,"دعوت الحي نصرا فاستهلوا","https://www.aldiwan.net/poem24171.html","الوافر"],[135,"وإبريق بهى فيه شى","https://www.aldiwan.net/poem54682.html","الوافر"],[146,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[163,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[163,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[172,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[180,"خليلي من عليا هلال بن عامر","https://www.aldiwan.net/poem4498.html","الطويل"],[202,"عرش بطول مدار السبعة الشهب","https://www.aldiwan.net/poem45349.html","البسيط"],[214,"خطابك لا أسميه خطابا","https://www.aldiwan.net/poem46267.html","الوافر"],[214,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[215,"وافاكم النصر بالتوفيق موصولا","https://www.aldiwan.net/poem37844.html","البسيط"],[240,"أخذنا طريق القوم حمدا لسيد","https://www.aldiwan.net/poem18181.html","الطويل"],[252,"عفا رسم برامة فالتلاع","https://www.aldiwan.net/poem2111.html","الوافر"],[273,"عيادة ذات اللطف نحسبها فرضا","https://www.aldiwan.net/poem35196.html","الطويل"],[273,"تعالي فأحييني بفنجان قهوة","https://www.aldiwan.net/poem35265.html","الطويل"],[273,"على جزع أروم ولا أحوز","https://www.aldiwan.net/poem35350.html","الوافر"],[274,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[285,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[288,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[307,"قل للذي قد لامني","https://www.aldiwan.net/poem16785.html","مجزوء الرجز"],[307,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[307,"جزى الله خيرا سيدا وابن سيد","https://www.aldiwan.net/poem16831.html","الطويل"],[364,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[369,"يعاب له الزمان وذاك أولى","https://www.aldiwan.net/poem17279.html","الوافر"],[419,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[446,"سلام على شيخ المشايخ أحمد","https://www.aldiwan.net/poem56037.html","عموديه"],[463,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[470,"سقاني شبيهة أخلاقه","https://www.aldiwan.net/poem60087.html","المتقارب"],[470,"قم فاصطبح قبل يكبو","https://www.aldiwan.net/poem60326.html","المجتث"],[479,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[495,"سلوا الصبابة عني هل خلوت بمن","https://www.aldiwan.net/poem67292.html","عموديه"],[502,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[553,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[553,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[560,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[560,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2559","الوافر"]],"verses":[["على جسد قد مزق النبل نعشه","وكان شفا برد اليمان يداعبه",0,"ب",2,0],["عَلى جُمالِيَةٍ توفي الزَمامَ خُطاً","تَكادُ تَسبُقُهُ مِن خِفَّةِ القَدَمِ",1,"م",1,0],["عَلى جُردٍ مُسَوَّمَةٍ","عَوابِسَ تَعلُكُ اللُجُما",2,"م",2,0],["عَلى جَبينِكَ آياتُ الرِضا اِرتَسَمَت","وَبَينَ جَنَبَيكَ قَلبٌ غَيرُ وَسنانِ",3,"ن",1,0],["عَلى جِلَّةٍ كَالهَضبِ تَختالُ في البُرى","فَأَحمالُها مَقصورَةٌ وَكؤورُها",4,"ر",3,0],["عَلى جُبُنٍ إِذ كُنتُ وَاِشتَدَّ جانِبي","أُسامُ الَّتي أَعيَيتُ إِذ أَنا أَمرَدُ",5,"د",1,0],["على جهةٍ إن قيل ستّ فإنها","عليها من الستّ الجهات تفجع",6,"ع",1,0],["عَلى جَنَباتِهِ وَعَلى ذَراهُ","جَمالٌ يُبهِرُ المُتَأَمِّلينا",7,"ن",2,0],["عَلى جَوانِبِها رَفَّت تَمائِمُنا","وَحَولَ حافاتِها قامَت رَواقينا",8,"ن",2,0],["عُلَيجٌ يَدينُ بِأَن لا إِلَ","هَ وَأَن لا قَضاءَ وَأَن لا قَدَر",9,"ر",1,0],["على جسد مثل الزبرجد لم يزل","يشاكله في لونه ويناسب",10,"ب",1,0],["على جرعاءَ مَيثَاءَ النَّواحي","يُلبِّدُ نَقْعَ تُربتِها نَداها",11,"ا",3,0],["على جانبيهِ الدوحُ لا بلْ عرائسٌ","ترومُ لنثرِ الدرِّ أن تتنفضا",12,"ض",2,0],["على جهله بضروب العروضِ","لكلِّ قبيحٍ فعولٌ فعولُ",13,"ل",1,0],["على جانِبَيْها من جهادِكَ هَبوةٌ","تُريكَ الصّباح الطلق أغبرَ أقتما",14,"م",2,0],["عَلى جِيدِ أَدماءٍ مِنَ الوَحشِ حُرَّةٍ","لَها نَظَرٌ يُبلي المَشُوقَ كَلِيلُ",15,"ل",1,0],["عَلى جَدوَلٍ رَيّانَ لا يَكتُمُ القَذى","كَأَنَّ سَواقِيهِ مُتونُ المَبارِدِ",16,"د",1,0],["عَلى جَبهَتِهِ الشَعرى","وَفي وَجنَتِهِ الهَنعَه",17,"ع",2,0],["عَلى جانَبي حائِرٍ مُفرِطٍ","بِبَرثٍ تَبَوَّأنَهُ مُعشِبِ",18,"ب",1,0],["على جدث موفٍ جديد ترابه","هناك هناك الجود والنائل الغمر",19,"ر",1,0],["عَلَى جُرْدِ السَّوَالِفِ بَاقِيَاتٍ","كِرَامِ الوَشْمِ وَاضِحَةِ النِّجَارِ",20,"ر",1,0],["على جفنينِ ظمآنَي","نِ للأنداءِ والصبحِ",21,"ح",1,0],["عَلَى جَبَلٍ تُنَضِّرُهُ","يَنَابِيعٌ وَأَنْهَارُ",22,"ر",1,0],["على جلدك البنكوتي ، على","سعال العشايا ، وبيع المنام",23,"م",1,0],["على جبن، إذا كنت، واشتد جانبي","أسام التي أعييت، إذْ أنا أمردُ",24,"د",1,0],["على جيلٍ كأنَّ عليه مما","بَنَى البانون من وِزْرٍ قلاعا",25,"ع",2,0],["عليج يدين بأن لا إل","ه وأن لا قضاء، أن لا قدر",26,"ر",1,0],["على جوانبها رفت تمانمنا","وحول حافاتها قامت رواقينا",27,"ن",2,0],["علي جناب شاد آثار أهله","بسر فشته الأوليا في الدواوين",28,"ن",1,0],["عَلى جُردٍ كَأَمثالِ السَعالي","وَرَجلٍ مِثلِ أَهمِيَةِ الكَثيبِ",29,"ب",1,0],["عَلَى جَنَبَاتِ أَكؤُسِهِ رَشَاشٌ","كَمَا رَشَحت مِنَ العَسَلِ النَّحِيُّ",30,"ي",1,0],["عَلى جَميعِ الَّذي تَحويهِ مِن نَشَبٍ","مِنَ المَكارِمِ والٍ لَيسَ يَنعَزِلُ",31,"ل",1,0],["على جهاد باللسان أقوله","وأنت ابن إسماعيل جاهدهم فعلا",32,"ل",2,0],["على جواز الذي قد سد مسمعه","عنه وولى سريعا غير منقلب",33,"ب",1,0],["عَلى جَدَثٍ أَضحى بِهِ المَجدُ ثاوياً","بِحَيثُ يَرى شَطَّ العَذارِ مُقابِلُه",34,"ل",2,0],["على جَسْرَةِ الأَصلابِ ناجيةِ السُّرى","تُقطِّعُ عَرْضَ البيدِ بِالْوَخَذانِ",35,"ن",1,0],["على جوانبهِ نورٌ تلألأَ منْ","نورِ الأميرِ وأجدادٍ لهُ وأبِ",36,"ب",1,0],["عليّ جنت وما زالت تنادى","بفرض الظلم حينا بعد حين",37,"ن",1,0],["على جلواتهم في الصيف كانت","تزفّ أطايب الحسن اللباب",38,"ب",1,0],["على جيادٍ تُباري الريحَ نَشْأتُها","وَعَزْمةٍ قد عَلَت الجَوْزا وأكليلا",39,"ل",2,0],["عَلَى جَدِّهِ مَنْ خَصَّهُ بِسِيَادَةٍ","صَلاَةُ عَظِيمٍ ذَاتُ رُوْحٍ مُؤَبَّدِ",40,"د",1,0],["عَلى جَرداءَ يَقطَعُ أَبهَراها","حِزامَ السَرجِ في خَيلٍ سِراعِ",41,"ع",1,0],["على جهدِ ما نلقى أتينا نعودُها","ونأملُ منها أن تُعيدَ لنا القرضا",42,"ض",2,0],["على جمرِ كانونٍ وفنجانِ قهوةٍ","وكأسِ مدامٍ واستماعِ حكاية",43,"ه",1,0],["على جزعٍ أرومُ ولا أحوزُ","فإن أسأَلْ تقُل ذا لا يجوزُ",44,"ز",1,1],["عَلى جملالته أَنوار هيبته","كالسَيف ان راق حسنا رق حداه",45,"ا",2,0],["عَلَيَّ جَنى ما جَنى رِدفُهُ ال","ثَقيلُ عَلى خَصرِهِ النَّاحِلِ",46,"ل",1,0],["على جمع في بنداو","تنظر ساعة الظهر",47,"ر",1,0],["علي جميع المسلمين","وقصده المولى الكريم",48,"م",1,0],["على جلبه المحبوب من كل نافع","على دفعه المرهوب من كل ضائر",49,"ر",1,0],["على جمعه كتبا يعز اجتماعها","لنفع عباد اللَه من كل طالب",50,"ب",1,0],["عَلى جَدّك الهادي البَشير تَحية","تَليق بِهِ ما غَرَّدت في الربا القَمر",51,"ر",1,0],["عُلىً جَرَّت لَهُ حالاً فَحالاً","وَلَولا الزُجُّ ما اِرتَفَعَ السِنانُ",52,"ن",1,0],["على جبينك خَطَّ المجدُ أسطُرَه","وكم قرأت لذاك الخطّ عنوانا",53,"ن",2,0],["على جامع اللطف الخفي وسدرة ال","وفا ومقر الوحي وحي ابن عجرد",54,"د",1,0],["على جبة ما قد تكفن قبله","بها ذو حياة ولاهو كالأسد الورد",54,"د",1,0],["على جيادٍ كذئاب الغضى","من رامحٍ فيها ومن عاذم",55,"م",1,0],["عَلى جَمرِ وَردٍ كَوانينُهُ","إِذا شَبَّهَ الطَلُّ أَشجارُهُ",56,"ر",2,0],["عَلى جُسومِ مِياهٍ","أَعكانُها الأَمواجُ",57,"ج",1,0],["على جيرةٍ بانوا فلي بعدما نأوا","على الربعِ جفنٌ بالمدامعِ مُترَعُ",58,"ع",1,0],["على جناب العلا حلي ومرتحلي","وفي حمى المجد مصطافي ومرتبعي",59,"ع",2,0],["على جمرِ الغَضا منِّي فُؤادٌ","عَليلٌ لا تُعَلِّلُهُ الأَغَانِي",60,"ن",2,0],["على جرداءَ إنْ حُبِسَتْ فقصرٌ","وإنْ ركضتْ لِهَمٍّ فالظّليمُ",61,"م",1,0],["على جَدَثٍ تشبّث من لُؤَيٍّ","بِيَنبوعِ العِبادَةِ والصَّلاحِ",62,"ح",1,0],["على جميع الورى إن شاء عذبهم","عدلاً وخلَّدهم في نار سجين",63,"ن",1,0],["على جيد الإجازة قد أضاءت","به نار الهدى بعد الخمود",64,"د",1,0],["عَلى جُردٍ مُسَوَّمَةٍ عِتاقٍ","تَوَقَّصُ بِالشَبابِ وَبِالكُهولِ",65,"ل",1,0]]}