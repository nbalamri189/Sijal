em.aspx?id=177642",""],[5447,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=208363",""],[5461,"سرى سرى","https://www.poetsgate.com/ViewPoem.aspx?id=5067",""],[5545,"أغارُ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=184793",""],[5601,"صقيع","https://www.poetsgate.com/ViewPoem.aspx?id=23514",""],[5672,"الحياة...بعد الخمسين","https://www.poetsgate.com/ViewPoem.aspx?id=212476",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5736,"حروف مصلوبة","https://www.poetsgate.com/ViewPoem.aspx?id=208496",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5848,"ياضياع الحال","https://www.poetsgate.com/ViewPoem.aspx?id=50623",""],[5943,"على جدران أفئدة البرايا","https://www.poetsgate.com/ViewPoem.aspx?id=34376",""],[5943,"أغمضتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=92984",""],[5956,"الحمد لله أعطانا أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=192130",""],[5956,"تَدَيُّنكَ الأصيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=193764",""],[6035,"رَغِبْتُ بفضحِكمْ في بعضِ شِعْرٍ !","https://www.poetsgate.com/ViewPoem.aspx?id=177506",""],[6056,"ملتقى الخطين","https://www.poetsgate.com/ViewPoem.aspx?id=130529",""],[6070,"على جنبيهِ ينشتلُ الوئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=188426",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6084,"على جوار لكطع قفر والحي","https://www.poetsgate.com/ViewPoem.aspx?id=170894",""],[6097,"وتزعم أنني أنسى!","https://www.poetsgate.com/ViewPoem.aspx?id=197433",""],[6102,"لا كرامة لنبي في قومه ..","https://www.poetsgate.com/ViewPoem.aspx?id=186289",""],[6124,"جرح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=174707",""],[1352,"الحمد لله الوهوب المجزل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=499950",""],[6167,"تلك القمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85544&r=&rc=27",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[5107,"صورة مناضل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83046&r=&rc=38",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""],[2220,"يا قمرَ الأسرارِ يا مُلبسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11482&r=&rc=356",""],[6346,"جَمْرُ الوَدَاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84888&r=&rc=13",""],[6355,"اليأس ينحت عمري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66549&r=&rc=9",""]],"verses":[["على جسد قد مزق النبل نعشه","وكان شفا برد اليمان يداعبه",0,"ب",2,0],["عَلى جُمالِيَةٍ توفي الزَمامَ خُطاً","تَكادُ تَسبُقُهُ مِن خِفَّةِ القَدَمِ",1,"م",1,0],["عَلى جُردٍ مُسَوَّمَةٍ","عَوابِسَ تَعلُكُ اللُجُما",2,"م",2,0],["عَلى جَبينِكَ آياتُ الرِضا اِرتَسَمَت","وَبَينَ جَنَبَيكَ قَلبٌ غَيرُ وَسنانِ",3,"ن",1,0],["عَلى جِلَّةٍ كَالهَضبِ تَختالُ في البُرى","فَأَحمالُها مَقصورَةٌ وَكؤورُها",4,"ر",3,0],["عَلى جُبُنٍ إِذ كُنتُ وَاِشتَدَّ جانِبي","أُسامُ الَّتي أَعيَيتُ إِذ أَنا أَمرَدُ",5,"د",1,0],["على جهةٍ إن قيل ستّ فإنها","عليها من الستّ الجهات تفجع",6,"ع",1,0],["عَلى جَنَباتِهِ وَعَلى ذَراهُ","جَمالٌ يُبهِرُ المُتَأَمِّلينا",7,"ن",2,0],["عَلى جَوانِبِها رَفَّت تَمائِمُنا","وَحَولَ حافاتِها قامَت رَواقينا",8,"ن",2,0],["عُلَيجٌ يَدينُ بِأَن لا إِلَ","هَ وَأَن لا قَضاءَ وَأَن لا قَدَر",9,"ر",1,0],["على جسد مثل الزبرجد لم يزل","يشاكله في لونه ويناسب",10,"ب",1,0],["على جرعاءَ مَيثَاءَ النَّواحي","يُلبِّدُ نَقْعَ تُربتِها نَداها",11,"ا",3,0],["على جانبيهِ الدوحُ لا بلْ عرائسٌ","ترومُ لنثرِ الدرِّ أن تتنفضا",12,"ض",2,0],["على جهله بضروب العروضِ","لكلِّ قبيحٍ فعولٌ فعولُ",13,"ل",1,0],["على جانِبَيْها من جهادِكَ هَبوةٌ","تُريكَ الصّباح الطلق أغبرَ أقتما",14,"م",2,0],["عَلى جِيدِ أَدماءٍ مِنَ الوَحشِ حُرَّةٍ","لَها نَظَرٌ يُبلي المَشُوقَ كَلِيلُ",15,"ل",1,0],["عَلى جَدوَلٍ رَيّانَ لا يَكتُمُ القَذى","كَأَنَّ سَواقِيهِ مُتونُ المَبارِدِ",16,"د",1,0],["عَلى جَبهَتِهِ الشَعرى","وَفي وَجنَتِهِ الهَنعَه",17,"ع",2,0],["عَلى جانَبي حائِرٍ مُفرِطٍ","بِبَرثٍ تَبَوَّأنَهُ مُعشِبِ",18,"ب",1,0],["على جدث موفٍ جديد ترابه","هناك هناك الجود والنائل الغمر",19,"ر",1,0],["عَلَى جُرْدِ السَّوَالِفِ بَاقِيَاتٍ","كِرَامِ الوَشْمِ وَاضِحَةِ النِّجَارِ",20,"ر",1,0],["على جفنينِ ظمآنَي","نِ للأنداءِ والصبحِ",21,"ح",1,0],["عَلَى جَبَلٍ تُنَضِّرُهُ","يَنَابِيعٌ وَأَنْهَارُ",22,"ر",1,0],["على جنبات النهروان عقائر","كما وقيت بالمشعرين نذور",23,"ر",1,0],["على جلدك البنكوتي ، على","سعال العشايا ، وبيع المنام",24,"م",1,0],["على جبن، إذا كنت، واشتد جانبي","أسام التي أعييت، إذْ أنا أمردُ",25,"د",1,0],["على جيلٍ كأنَّ عليه مما","بَنَى البانون من وِزْرٍ قلاعا",26,"ع",2,0],["عليج يدين بأن لا إل","ه وأن لا قضاء، أن لا قدر",27,"ر",1,0],["على جنبات النهروان عقائر","كما وفيت بالمشعرين نذور",28,"ر",1,0],["على جوانبها رفت تمانمنا","وحول حافاتها قامت رواقينا",29,"ن",2,0],["علي جناب شاد آثار أهله","بسر فشته الأوليا في الدواوين",30,"ن",1,0],["عَلى جُردٍ كَأَمثالِ السَعالي","وَرَجلٍ مِثلِ أَهمِيَةِ الكَثيبِ",31,"ب",1,0],["عَلَى جَنَبَاتِ أَكؤُسِهِ رَشَاشٌ","كَمَا رَشَحت مِنَ العَسَلِ النَّحِيُّ",32,"ي",1,0],["عَلى جَميعِ الَّذي تَحويهِ مِن نَشَبٍ","مِنَ المَكارِمِ والٍ لَيسَ يَنعَزِلُ",33,"ل",1,0],["على جهاد باللسان أقوله","وأنت ابن إسماعيل جاهدهم فعلا",34,"ل",2,0],["على جواز الذي قد سد مسمعه","عنه وولى سريعا غير منقلب",35,"ب",1,0],["عَلى جَدَثٍ أَضحى بِهِ المَجدُ ثاوياً","بِحَيثُ يَرى شَطَّ العَذارِ مُقابِلُه",36,"ل",2,0],["على جَسْرَةِ الأَصلابِ ناجيةِ السُّرى","تُقطِّعُ عَرْضَ البيدِ بِالْوَخَذانِ",37,"ن",1,0],["على جوانبهِ نورٌ تلألأَ منْ","نورِ الأميرِ وأجدادٍ لهُ وأبِ",38,"ب",1,0],["عليّ جنت وما زالت تنادى","بفرض الظلم حينا بعد حين",39,"ن",1,0],["على جلواتهم في الصيف كانت","تزفّ أطايب الحسن اللباب",40,"ب",1,0],["على جيادٍ تُباري الريحَ نَشْأتُها","وَعَزْمةٍ قد عَلَت الجَوْزا وأكليلا",41,"ل",2,0],["عَلَى جَدِّهِ مَنْ خَصَّهُ بِسِيَادَةٍ","صَلاَةُ عَظِيمٍ ذَاتُ رُوْحٍ مُؤَب