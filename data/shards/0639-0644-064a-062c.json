{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[9,"يظن الناس بالملكي","https://www.aldiwan.net/poem21983.html","مجزوء الوافر"],[86,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[35,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[11,"هل الدهر إلا اليوم أو أمس أو غد","https://www.aldiwan.net/poem233.html",""],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"نفقت نفوق الحمار الذكر","https://www.aldiwan.net/poem63583.html","الخفيف"],[61,"خلالك ما اختل الصديق سحائب","https://www.aldiwan.net/poem51388.html","الطويل"],[61,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[69,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[69,"مديد الزحاف سريع الخلاف","https://www.aldiwan.net/poem29132.html","المتقارب"],[105,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[40,"ألا من لعين لا تزال تسيل","https://www.aldiwan.net/poem42331.html","الطويل"],[52,"ألا رب يوم بالدويرة صالح","https://www.aldiwan.net/poem27084.html","الطويل"],[48,"أنا أبصرت صاح الشمس","https://www.aldiwan.net/poem64383.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[100,"زامر القفر العامر","https://www.poetsgate.com/ViewPoem.aspx?id=50393",""],[11,"هل الدهرُ إلا اليوم، أو أمسِ أو غدُ","https://www.poetsgate.com/ViewPoem.aspx?id=16837",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[45,"نفقت نفوق الحمار الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=31266",""],[85,"أنْدَلُسِيَّة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9527&r=&rc=17",""],[115,"رعى الله أياما تقضت بشيخون","https://www.aldiwan.net/poem41763.html","الطويل"],[131,"دعوت الحي نصرا فاستهلوا","https://www.aldiwan.net/poem24171.html","الوافر"],[132,"وإبريق بهى فيه شى","https://www.aldiwan.net/poem54682.html","الوافر"],[143,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[160,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[160,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[169,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[177,"خليلي من عليا هلال بن عامر","https://www.aldiwan.net/poem4498.html","الطويل"],[199,"عرش بطول مدار السبعة الشهب","https://www.aldiwan.net/poem45349.html","البسيط"],[211,"خطابك لا أسميه خطابا","https://www.aldiwan.net/poem46267.html","الوافر"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[212,"وافاكم النصر بالتوفيق موصولا","https://www.aldiwan.net/poem37844.html","البسيط"],[237,"أخذنا طريق القوم حمدا لسيد","https://www.aldiwan.net/poem18181.html","الطويل"],[249,"عفا رسم برامة فالتلاع","https://www.aldiwan.net/poem2111.html","الوافر"],[270,"عيادة ذات اللطف نحسبها فرضا","https://www.aldiwan.net/poem35196.html","الطويل"],[270,"تعالي فأحييني بفنجان قهوة","https://www.aldiwan.net/poem35265.html","الطويل"],[270,"على جزع أروم ولا أحوز","https://www.aldiwan.net/poem35350.html","الوافر"],[271,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[282,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[285,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[304,"قل للذي قد لامني","https://www.aldiwan.net/poem16785.html","مجزوء الرجز"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[304,"جزى الله خيرا سيدا وابن سيد","https://www.aldiwan.net/poem16831.html","الطويل"],[361,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[366,"يعاب له الزمان وذاك أولى","https://www.aldiwan.net/poem17279.html","الوافر"],[416,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[443,"سلام على شيخ المشايخ أحمد","https://www.aldiwan.net/poem56037.html","عموديه"],[461,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[468,"سقاني شبيهة أخلاقه","https://www.aldiwan.net/poem60087.html","المتقارب"],[468,"قم فاصطبح قبل يكبو","https://www.aldiwan.net/poem60326.html","المجتث"],[477,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[493,"سلوا الصبابة عني هل خلوت بمن","https://www.aldiwan.net/poem67292.html","عموديه"],[500,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[551,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[551,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[558,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[558,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"]],"verses":[["عَلى جُمالِيَةٍ توفي الزَمامَ خُطاً","تَكادُ تَسبُقُهُ مِن خِفَّةِ القَدَمِ",0,"م",1,0],["عَلى جُردٍ مُسَوَّمَةٍ","عَوابِسَ تَعلُكُ اللُجُما",1,"م",2,0],["عَلى جَبينِكَ آياتُ الرِضا اِرتَسَمَت","وَبَينَ جَنَبَيكَ قَلبٌ غَيرُ وَسنانِ",2,"ن",1,0],["عَلى جِلَّةٍ كَالهَضبِ تَختالُ في البُرى","فَأَحمالُها مَقصورَةٌ وَكؤورُها",3,"ر",3,0],["عَلى جُبُنٍ إِذ كُنتُ وَاِشتَدَّ جانِبي","أُسامُ الَّتي أَعيَيتُ إِذ أَنا أَمرَدُ",4,"د",1,0],["على جهةٍ إن قيل ستّ فإنها","عليها من الستّ الجهات تفجع",5,"ع",1,0],["عَلى جَنَباتِهِ وَعَلى ذَراهُ","جَمالٌ يُبهِرُ المُتَأَمِّلينا",6,"ن",2,0],["عَلى جَوانِبِها رَفَّت تَمائِمُنا","وَحَولَ حافاتِها قامَت رَواقينا",7,"ن",2,0],["عُلَيجٌ يَدينُ بِأَن لا إِلَ","هَ وَأَن لا قَضاءَ وَأَن لا قَدَر",8,"ر",1,0],["على جسد مثل الزبرجد لم يزل","يشاكله في لونه ويناسب",9,"ب",1,0],["على جرعاءَ مَيثَاءَ النَّواحي","يُلبِّدُ نَقْعَ تُربتِها نَداها",10,"ا",3,0],["على جانبيهِ الدوحُ لا بلْ عرائسٌ","ترومُ لنثرِ الدرِّ أن تتنفضا",11,"ض",2,0],["على جهله بضروب العروضِ","لكلِّ قبيحٍ فعولٌ فعولُ",12,"ل",1,0],["على جانِبَيْها من جهادِكَ هَبوةٌ","تُريكَ الصّباح الطلق أغبرَ أقتما",13,"م",2,0],["عَلى جِيدِ أَدماءٍ مِنَ الوَحشِ حُرَّةٍ","لَها نَظَرٌ يُبلي المَشُوقَ كَلِيلُ",14,"ل",1,0],["عَلى جَدوَلٍ رَيّانَ لا يَكتُمُ القَذى","كَأَنَّ سَواقِيهِ مُتونُ المَبارِدِ",15,"د",1,0],["عَلى جَبهَتِهِ الشَعرى","وَفي وَجنَتِهِ الهَنعَه",16,"ع",2,0],["عَلى جانَبي حائِرٍ مُفرِطٍ","بِبَرثٍ تَبَوَّأنَهُ مُعشِبِ",17,"ب",1,0],["على جدث موفٍ جديد ترابه","هناك هناك الجود والنائل الغمر",18,"ر",1,0],["على جفنينِ ظمآنَي","نِ للأنداءِ والصبحِ",19,"ح",1,0],["عَلَى جَبَلٍ تُنَضِّرُهُ","يَنَابِيعٌ وَأَنْهَارُ",20,"ر",1,0],["على جلدك البنكوتي ، على","سعال العشايا ، وبيع المنام",21,"م",1,0],["على جبن، إذا كنت، واشتد جانبي","أسام التي أعييت، إذْ أنا أمردُ",22,"د",1,0],["على جيلٍ كأنَّ عليه مما","بَنَى البانون من وِزْرٍ قلاعا",23,"ع",2,0],["عليج يدين بأن لا إل","ه وأن لا قضاء، أن لا قدر",24,"ر",1,0],["على جوانبها رفت تمانمنا","وحول حافاتها قامت رواقينا",25,"ن",2,0],["علي جناب شاد آثار أهله","بسر فشته الأوليا في الدواوين",26,"ن",1,0],["عَلى جُردٍ كَأَمثالِ السَعالي","وَرَجلٍ مِثلِ أَهمِيَةِ الكَثيبِ",27,"ب",1,0],["عَلَى جَنَبَاتِ أَكؤُسِهِ رَشَاشٌ","كَمَا رَشَحت مِنَ العَسَلِ النَّحِيُّ",28,"ي",1,0],["عَلى جَميعِ الَّذي تَحويهِ مِن نَشَبٍ","مِنَ المَكارِمِ والٍ لَيسَ يَنعَزِلُ",29,"ل",1,0],["على جهاد باللسان أقوله","وأنت ابن إسماعيل جاهدهم فعلا",30,"ل",2,0],["على جواز الذي قد سد مسمعه","عنه وولى سريعا غير منقلب",31,"ب",1,0],["عَلى جَدَثٍ أَضحى بِهِ المَجدُ ثاوياً","بِحَيثُ يَرى شَطَّ العَذارِ مُقابِلُه",32,"ل",2,0],["على جَسْرَةِ الأَصلابِ ناجيةِ السُّرى","تُقطِّعُ عَرْضَ البيدِ بِالْوَخَذانِ",33,"ن",1,0],["على جوانبهِ نورٌ تلألأَ منْ","نورِ الأميرِ وأجدادٍ لهُ وأبِ",34,"ب",1,0],["عليّ جنت وما زالت تنادى","بفرض الظلم حينا بعد حين",35,"ن",1,0],["على جلواتهم في الصيف كانت","تزفّ أطايب الحسن اللباب",36,"ب",1,0],["على جيادٍ تُباري الريحَ نَشْأتُها","وَعَزْمةٍ قد عَلَت الجَوْزا وأكليلا",37,"ل",2,0],["عَلَى جَدِّهِ مَنْ خَصَّهُ بِسِيَادَةٍ","صَلاَةُ عَظِيمٍ ذَاتُ رُوْحٍ مُؤَبَّدِ",38,"د",1,0],["عَلى جَرداءَ يَقطَعُ أَبهَراها","حِزامَ السَرجِ في خَيلٍ سِراعِ",39,"ع",1,0],["على جهدِ ما نلقى أتينا نعودُها","ونأملُ منها أن تُعيدَ لنا القرضا",40,"ض",2,0],["على جمرِ كانونٍ وفنجانِ قهوةٍ","وكأسِ مدامٍ واستماعِ حكاية",41,"ه",1,0],["على جزعٍ أرومُ ولا أحوزُ","فإن أسأَلْ تقُل ذا لا يجوزُ",42,"ز",1,1],["عَلى جملالته أَنوار هيبته","كالسَيف ان راق حسنا رق حداه",43,"ا",2,0],["عَلَيَّ جَنى ما جَنى رِدفُهُ ال","ثَقيلُ عَلى خَصرِهِ النَّاحِلِ",44,"ل",1,0],["على جمع في بنداو","تنظر ساعة الظهر",45,"ر",1,0],["علي جميع المسلمين","وقصده المولى الكريم",46,"م",1,0],["على جلبه المحبوب من كل نافع","على دفعه المرهوب من كل ضائر",47,"ر",1,0],["على جمعه كتبا يعز اجتماعها","لنفع عباد اللَه من كل طالب",48,"ب",1,0],["عَلى جَدّك الهادي البَشير تَحية","تَليق بِهِ ما غَرَّدت في الربا القَمر",49,"ر",1,0],["عُلىً جَرَّت لَهُ حالاً فَحالاً","وَلَولا الزُجُّ ما اِرتَفَعَ السِنانُ",50,"ن",1,0],["على جبينك خَطَّ المجدُ أسطُرَه","وكم قرأت لذاك الخطّ عنوانا",51,"ن",2,0],["على جامع اللطف الخفي وسدرة ال","وفا ومقر الوحي وحي ابن عجرد",52,"د",1,0],["على جبة ما قد تكفن قبله","بها ذو حياة ولاهو كالأسد الورد",52,"د",1,0],["على جيادٍ كذئاب الغضى","من رامحٍ فيها ومن عاذم",53,"م",1,0],["عَلى جَمرِ وَردٍ كَوانينُهُ","إِذا شَبَّهَ الطَلُّ أَشجارُهُ",54,"ر",2,0],["عَلى جُسومِ مِياهٍ","أَعكانُها الأَمواجُ",55,"ج",1,0],["على جيرةٍ بانوا فلي بعدما نأوا","على الربعِ جفنٌ بالمدامعِ مُترَعُ",56,"ع",1,0],["على جناب العلا حلي ومرتحلي","وفي حمى المجد مصطافي ومرتبعي",57,"ي",1,0],["على جمرِ الغَضا منِّي فُؤادٌ","عَليلٌ لا تُعَلِّلُهُ الأَغَانِي",58,"ي",1,0],["على جرداءَ إنْ حُبِسَتْ فقصرٌ","وإنْ ركضتْ لِهَمٍّ فالظّليمُ",59,"م",1,0],["على جَدَثٍ تشبّث من لُؤَيٍّ","بِيَنبوعِ العِبادَةِ والصَّلاحِ",60,"ح",1,0],["على جميع الورى إن شاء عذبهم","عدلاً وخلَّدهم في نار سجين",61,"ن",1,0],["على جيد الإجازة قد أضاءت","به نار الهدى بعد الخمود",62,"د",1,0]]}