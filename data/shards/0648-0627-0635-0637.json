أفولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197691",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5436,"فجّر الثورة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35273",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5596,"سمائل المذهلة","https://www.poetsgate.com/ViewPoem.aspx?id=206486",""],[5596,"البردة الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=206751",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5691,"عراقة شعب","https://www.poetsgate.com/ViewPoem.aspx?id=206063",""],[349,"موقف","https://www.poetsgate.com/ViewPoem.aspx?id=146247",""],[5720,"عَهدُ سَلمانَ","https://www.poetsgate.com/ViewPoem.aspx?id=201141",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5913,"الحنين المكتَّمُ المفضوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=183248",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6124,"يوم أن كنت المغني","https://www.poetsgate.com/ViewPoem.aspx?id=201236",""],[6142,"كلما اغصوصبوا عليه دحاهم","https://www.poetsgate.com/ViewPoem.aspx?id=155706",""]],"verses":[["وَاِصطَفوهُنَّ لِيُنتِجنَ العُلى","بِالعَوالي لا لِيُنتِجنَ المِهارا",0,"ر",2,0],["وَاِصطَبِح كَأسَ الرِضى مِن مَلِكٍ","سِرتَ في إِرضائِهِ أَزكى السِيَر",1,"ر",1,0],["واصْطنعني فللصنيعة عندِي","موضع الغيث في زكي الأراضي",2,"ض",2,0],["واصْطد بها العنقاء فهي حبالة","واقْتد بها الجوزاء فهي عنان",3,"ن",1,0],["واصطنعْه واتخذه للعلا","إنه أهل اصطناع واتخاذِ",4,"ذ",1,0],["واصطنعْ عندي صنيعاً إنني","من إذا استُنْهض بالشكر نَهَض",5,"ض",1,0],["واصطبحناها على نه","رٍ بصَفوِ الماءِ يَجري",6,"ر",2,1],["وَاصْطَفَى مَحْتِدَهُ مِنْ دَوْحَةٍ","أنْبَتَتْ أَفْنانُها عِلماً ودِينا",7,"ن",2,0],["وَاصْطَحِبْ بِمَنْ","يَبْعَثُ الْمَرَحْ",8,"ح",1,0],["واصْطَلَحَتْ بَعْدَ طُولِ عَتْبٍ","بَيْنَهُمَا الأَرْضُ والسَّمَاءُ",9,"ا",2,0],["واصطادَ درَّ البحر ثم أذابَه","طَلاًّ يسيلُ على فَمِ النُّوار",10,"ر",1,0],["واصطبغَتْ بحُمْرَةُ العِتَاب","وانطفأتْ جمْرَةُ الالتهاب",11,"ب",1,0],["وَاِصطِناع المَعروف في العُسر وَاليُسر","وَبَذل النَوال قَبل الطلاب",12,"ب",1,0],["واصطفاه مرسلا بل كلَّمهْ","لم يزل يَتقْوُ هدى ما عَلَّمَهُ",13,"ه",1,0],["واصطلاَحَاتِ كُلِّ فَنٍّ وَحَالَى","قَصدِهِ في التَّضِييقِ والتَّوسِيعِ",14,"ع",1,0],["واصطفى المكرُماتِ حتى لقلنا","أبِرِقٍّ إنتاجُها أم بَعقدِ",15,"د",1,0],["واصطفي بالعلم والأدب","ناطق بالزور والكذب",16,"ب",1,0],["وَاِصطفى بنتهُ النبيُّ عَروساً","هُم جَميعاً لأجلها عتقاءُ",17,"ا",2,0],["واصطخاب الموج شدوٌ","ودموع المزن راح",18,"ح",1,0],["واصطبر واعتبر بحزم أولي العز","م إذا عزّ في المصاب العزاء",19,"ا",2,0],["وَاِصطَفاهُ عَبد الحَميد وَلكِن","لَم يَكُن مِن رِجال عَبدِ الحَميدِ",20,"د",1,0],["واِصطَنعني بِنَفحَةٍ مِن زَرودٍ","إِنَّ قَلبي بِغَيرِها لَيسَ يُشفى",21,"ف",2,0],["وَاِصطَفاهُم مِن كُلِّ أَغلَبَ مَش","بوحِ الذِراعَينِ لِلعِدى فَرّاسِ",22,"س",1,0],["وَاصْطَفِ الْمُصْطَفَى لِرَبِّكَ وَاعْلَمْ","إِنَّمَا يُصْطَفَى الذِينَ اصْطَفَوْهُ",23,"و",2,0],["واصطد بها العنقاء فهي حبائلٌ","واطعن بها الأعداء فهي سنان",24,"ن",1,0],["واصطبح في الغبوق صبح هداها","وهو يعدو بالنور في ظلماتك",25,"ك",1,0],["واصطاد أدنى المعتدين أجلها","ويد الظلوم مصائد ومصائب",26,"ب",1,0],["واِصطَبح الراحَ فقد أَشرَقَت","وَالصبحُ إِشراقه في اِنبِلاج",27,"ج",1,0],["وَاِصطبارُ الفقيرِ أفضل من","شكرِ غنيّ بحظه جذلانِ",28,"ن",1,0],["واِصطفاه وزيرَ خيرِ مليك","صادقِ الفعلِ والمقال الصوابِ",29,"ب",1,0],["واصطنعني كما اصطنعت بإسدا","ء يد من شفاعة أو وسيله",30,"ل",2,0],["وَاِصطَفاهُ مُلوكُ مِصرَ شَباباً","كَأَصطَفا سَيِّدُ المَلا لِأُسامَه",31,"م",2,0],["واصطبحنا واغتبقنا","ولثمنا شفتينا",32,"ن",2,0],["واصطَنِعْني بها فلم أر كالحُرْ","رِ تَراه لدى الصَّنيعةِ عَبدا",33,"د",2,0],["وَاِصطِبار مَع شَوق لا يَكون","مَرَّ عَيشي في هَوى عَذب اللَمى",34,"م",2,0],["واصطبر للحق فالأعدا له","أمم تدعو إلى غير الصحيح",35,"ح",1,0],["واصطَلَحَ الناس عَلى فَضلِهِ","واختَلِفوا بَعدُ فَلَيسَ اصطِلاح",36,"ح",1,0],["وَاصْطَبِحْ مِنْ مَدَائِحٍ خَنْدَرِيساً","صُفِّقَتْ لِلسَّماعِ لا للتَّحَسِّي",37,"س",2,0],["واصطباحات مُدامٍ","بين راحاتِ نديمِ",38,"م",1,0],["واصطفت الأطيار جندا فوقه","وسياجها التنظيم والترتيب",39,"ب",1,0],["واصطِبارا وَاحتسَابا يا أبا","هُ فإنَّ الصَّبرَ مِن طَبع السَّرِي",40,"ي",1,0],["واصطبَاحٍ واصلتُه باغتِباقٍ","واغتباقٍ واصلتُه باصطِبَاحِ",41,"ح",1,0],["وَاِصطِناعٍ لكِرامٍ","وَاِمتناعٍ من مَضامِ",42,"م",1,0],["وَاِصطَبر مؤثراً تفُز بِثَوابٍ","لا تُضِعْهُ بِأَن صَبرتَ اِضطِرارا",43,"ر",2,0],["واصطباري يوم جفوتكم","زال والتهيام لم يزل",44,"ل",1,0],["واصطباري يوم جفوته","ما بقى والوجد فيه بقي",45,"ق",2,0],["واصطبِح قهوةً كَحُمرَةِ صُبحٍ","بعد هَزمِ الكَرى قُبَيلَ الأذانِ",46,"ن",1,0],["وَاصطفاه لما رآه لَبيباً","عاقِلاً سامياً عَلى رُفَقاه",47,"ا",2,0],["واصطفاه الرأْيُ الرشِيدُ على العَا","لَمِ فَهْو الأَمينُ والمأْمُونُ",48,"ن",1,0],["واصطلوا نارها وقد غالبوا النا","ر بما سال من طهور الدماء",49,"ا",2,0],["واصطلم البين صبره ونفى","عن جفنه المستلذ من وسنه",50,"ن",2,0],["وَاصطبِحْها على ميادينِ خير","يٍّ ووردٍ ونرجسٍ وَبَهار",51,"ر",1,0],["واصْطِفاقٍ مِنَ الأَكُفِّ دِرَاكاً","واجْتِمَاعٍ مَوفٍ وَعَزْمٍ مُفَاضِ",52,"ض",1,0],["واصطفاه عن السوا واجتباه","وأراه وجه الجمال الجليلا",53,"ل",2,0],["واصطنعني بما اصطنعت الحميرا","وزليخا ومريما والبتولا",53,"ل",2,0],["واصطفاه مكانة ونوالا","واعتزازا ورفعة وقرارا",54,"ر",2,0],["واصطنعني إذا احتضرت ونادى","هاتف البرزخ البدار البدارا",54,"ر",2,0],["واصطرعا ساعة وعاجله","بضربة آذنت بصرعته",55,"ت",2,0],["واصطفى حسن التقا والتحفا","بوشاح الفضل أبهى ملبسِ",56,"س",1,0],["واصطفّت الغلمان في العرضانِ","في رأي شخصٍ فاق بالعرفانِ",57,"ن",1,0],["واصطفيت المسير من دار سجن","مستخيراً بذاك رباًّ جليلا",58,"ل",2,0],["واصطفاها إلى السفينة نوح","فأضاءَت مسابحَ القَيدُومِ",59,"م",1,0],["واصطباري بان آه لو تدري","جفاني رشدي",60,"ي",1,0],["وَاصْطَنِعْنِي مُشَايعاً لك لا","يَشْغَلُه عنك الصَّفْقُ في الأسواق",61,"ق",1,0],["وَاِصطَبِحها وَردِيَّةً فَإِذا حُث","ثَت تَبَيَّنتَ وَردَها في الخُدودِ",62,"د",1,0],["وَاِصطِحابُ الكِعابِ مِن كُلِّ خَودٍ","جَمَّةِ اللُطفِ مِن ذَواتِ الحِجالِ",63,"ل",1,0],["واصطفاها على النساءِ جميعاً","آيةُ الطُّهرِ دُرَّةٌ عَصماء",64,"ا",2,0],["واصطفَّت الحورُ الحِسانُ كأنَّها","نظمُ الضُّفُوفِ يمجدُ الإسكندَرَا",65,"ر",2,0],["واصطنعتني بنعمة منك لطفا","إن قلبي بغيرها ليس يشفى",66,"ف",2,0],["واصطبارٍ أضيع ما بين إيضا","ع المطايا وفي المحل المحيلِ",67,"ل",1,0],["وَاصطَبِح مِن سُلافَةٍ كَسَنا الشَم","سِ وَلَكِن حُبابُها كَالجُمانِ",68,"ن",1,0],["واصطفاها لحبه فحماها","في ذمارٍ من زهدها وتقاها",69,"ا",3,0],["واصطفته لها حبيباً ولم تر","حم من الناس هالكاً بهواها",69,"ا",3,0],["واصطحبت هندٌ أباها إلى","مرتعها يقضي شتاءَ الحياة",70,"ه",1,0],["واصطفى قلبي حبيباً واحداً","وهو راضٍ بالحبيب المصطفى",71,"ف",2,0],["واصطد ببازي العزم أطيار الرضا","فأخوك غاية بازه التحقيق",72,"ق",1,0],["وَاِصطَفِ الأَلفاظَ مِن دَمعِ النَدى","وَالمَعاني مِن أَنينِ الشَمأَلِ",73,"ل",1,0],["واصطل الوجد يا فؤاد صليا","وتقلب عليه بطنا وظهرا",74,"ر",2,0],["وَاصطكاكُ الشِفاهِ باللَثمِ حَتّى","يَشفي الصبَّ من صَداهُ التِثامُ",75,"م",1,0],["وَاصطكاكِ الشِفاه بِاللَثمِ رَشفاً","وَاحتِكاكِ الصُدورِ فَوقَ الصُدورِ",76,"ر",1,0],["واصطفاها سفنا تجري بنا","فوق موج كالجبال الراسيات",77,"ت",1,0],["واصطبار على الزمان","وتأليف قلوب وغيرة واياء",78,"ا",2,0],["وأصطاف من دنيا القريض بجنة","وإن كنت في صيدا من الحر مسعرا",79,"ر",2,0],["وَاِصطَبِح في الديرِ الأَعلى","في السَعانينِ اِصطِباحا",80,"ح",2,0],["واصطفت الأمواج والهةً","لعناقها مفتوحة الصدر",81,"ر",1,0],["واصطفى قلبه هواكم ولإنْ كا","ن كما قيل صفوُهُ أكدارا",82,"ر",2,0],["واصْطبِحَاها عَلى مُفَوَّفةٍ","باتَ لَها بِالقُطَارِ مُغْتَبَقُ",83,"ق",1,0],["واصطفاه الإله إذ لا سماءٌ","لا ولا أرض ربها ما دحاها",84,"ا",3,0],["واصطفى الأنبياء لما أجابوا","لولاه كان فيه اصطفاها",84,"ا",3,0],["واصطَدتَهم لما طرحتَ","عليهمِ منك الشبائِك",85,"ك",1,0],["وَاِصطِفاقِ العودِ وَالنا","ياتِ في جَوفِ الظَلامِ",86,"م",1,0],["واصطفوا ما راق من أُنسها","وافرحوا بالنيل واستبشروا",87,"ر",3,0],["واصطبر أَيها العَزيز المفدّى","إن صبر الفَتى مع اليَأس أجدر",88,"ر",1,0],["واصطبرْ إن عناك نثر ونظم","سوف تتلو نثرًا وتنظم شعرًا",89,"ر",2,0],["وَاِصطَحَبتُ الراحَ يَوماً","ثُمَّ أَنشَدتُ أُغَنّي",90,"ن",2,0],["واصطدم الجيشان تحت الغبار","وهاجت الأرباب كل السرى",91,"ر",2,0],["وأصطاد الوحوش به يجري","بلا ركل كما السيل البُعاق",92,"ق",1,0],["وَاِصطَبَحنا وَاِغتَبَقنا","وَاِرتَشَفنا وَاِنتَشَقنا",93,"ن",2,0],["وَاِصطَبَحنا الآنَ مِن فَضلَةِ ما","قَد شَرِبنا ذلِكَ المُغتَبَقا",94,"ق",2,0],["واصطفى الله آدما ثم صفا","ه وفيه عفا عن الحوباء",95,"ا",2,0],["واصْطَفَّ قَلبي ودَربي والهَوى فِرَقَاً","كلٌّ يُصارعُ بالأهوالِ مُشتَاقَا",96,"ق",2,0],["واصطفيت الشعر أهدي دره","مصطفى أهل المعالي باتفاق",97,"ق",1,0],["واصطفى دوراً فاقت محاسنها","لمصطفى المجد عالي الجدّ والجودِ",98,"د",1,0],["واصطَفتني بِنتُ النِّصالِ حَبيباً","مَن رأى ذابِحاً أحبَّ ذَبيحا؟!",99,"ح",2,0],["واصطباري عاد جمرًا","جعل النِّيرانَ تَسْني",100,"ن",2,0],["واصطفوا في ما يشبه الأبطال","لتنالوا أوسمة الحقارة حالا",101,"ل",2,0],["وأصطاد مِنه بريقَ اللآلئَْ","وقد شاب رأسيَ بطولِ احتكاكْ",102,"ك",1,0],["واصطل الأشواق موقدة","موصليات الهوى وهم",103,"م",1,0],["واصطفت الصافات صفا محكما","ليري عدو الله في أمكانه",104,"ن",2,0],["واصطخاب الأمواج في كل بحر","واشتعال الشهاب في أفق ناظر",105,"ر",1,0],["واصطباح يحلو بيوم خميس","حين نغدو مع انبلاج الصباح",106,"ح",1,0],["واصطباري على البلاء طويلٌ","صبر أيوب عبرةٌ ودليلُ",107,"ل",1,0],["واصطراعٍ معنّفٍ فيه نُلقى","كي تُصفى (من طينها) الأذهانُ",108,"ن",1,0],["واصطبارٍ مطهّرٍ من ذنوب","وقبولٍ بطاعةٍ قد يُصانُ",108,"ن",1,0],["واصطفانا من بين روم وفرسِ","بلسانٍ مخاطبٍ قوم عبسِ",109,"س",1,0],["واصطنِعْ نهرَ دمٍ، يعلو الرِّكابا","قلْ لهمْ في صرخةٍ هادرةٍ:",110,"ه",1,0],["واصطفاه على البرايا وآتا","ه كتاباً مطهراً عربيا",111,"ي",2,0],["وأصطبح الجنان ندىً وعطراً","وشعراً بابلياً مستذابا",112,"ب",2,0],["واصطفى المُصطفَيْن قلباً وروحاً","في هواهُ بحُبهِ جوهريّا",113,"ي",2,0],["واصطبح بالندى بها لؤلؤياً","طرّز الغصن وشيه بسناها",114,"ا",3,0],["واصْطَفى القُدْسَ كيْ تكونَ سَماءً","لثَرانا يَرودُها مُصْطَفاهُ",115,"ا",2,0],["واصطفاقُ المجداف مثل جناح الطْ","طَيْر آوى ليلاً إلى الأوكار",116,"ر",1,0],["واصطفىٰ من أرضهِ مُخْتَارَهُ","حِينَمَا أهدىٰ لهُ خَيرَ نَبِيْ",117,"ب",2,0],["واصطفّتْْ الخيلُ في إثري فكنتُ لها","نِدا فأشطرُهُم، وانزاحتْ الظللُ",118,"ل",1,0],["واصطبارٌ ولوعةٌ وشرودٌ","ذكرياتٌ وعبرةٌ وقروحُ",119,"ح",1,0],["وَاصطِبارِي عَلَى ادِّكارِيَ صَلبٌ","لِشُعُورِي, وَأَدمُعِي صُلبانُ",120,"ن",1,0],["وَاصْطَفَانِي لِلْجَوَى بَحْرُ الرَّحِيْلِ","كُلُّ هَذَا يَوْمَ أَنْ كُنْتُ المُغَنِّي",121,"ن",2,0],["واصطفاه أخا له وحباه","إمرةً لم تزل ليوم الخلود",122,"د",1,0]]}