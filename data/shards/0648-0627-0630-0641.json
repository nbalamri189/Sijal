{"poems":[[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[111,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[402,"أمولاي لا تجزع إذا عضك الدهر","https://www.aldiwan.net/poem46511.html","الطويل"]],"verses":[["وَإِذ فينا فَوارِسُ كُلِّ هَيجا","إِذا فَزِعوا وَفِتيانُ الخُروقِ",0,"ق",1,0],["وَإِذ فينا مُعاوِيَةُ بنُ عَمروٍ","عَلى أَدماءَ كَالجَمَلِ الفَنيقِ",0,"ق",1,0],["وإذ فسادي بكم يذكِّرني","لنُفْسِدَنَّ الطواف في عمرِ",1,"ر",1,0],["وإذ فيك أمثال الظباء ملاحةً","ونَفْراً عن الفحشاء بل هن أنفر",2,"ر",1,0],["وَإذ فَرَغنا مِن بَيانِ الخامِسَه","فلنُوضِّح الآنَ بَيانَ السَادِسَه",3,"ه",1,0],["وإذ فُتنَّا سبقاً إلى غاية العُلَى","فأجدرُ مِنّا أن يحاربك الدَّهرُ",4,"ر",1,0]]}