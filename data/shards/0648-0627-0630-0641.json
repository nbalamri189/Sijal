{"poems":[[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[115,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[408,"أمولاي لا تجزع إذا عضك الدهر","https://www.aldiwan.net/poem46511.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83297","الوافر"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94090","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93784","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86288","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86286","الطويل"],[4984,"أَيُعْقَلُ أَنْ أَنْسَى","https://www.poetsgate.com/ViewPoem.aspx?id=201808",""]],"verses":[["وَإِذ فينا فَوارِسُ كُلِّ هَيجا","إِذا فَزِعوا وَفِتيانُ الخُروقِ",0,"ق",1,0],["وَإِذ فينا مُعاوِيَةُ بنُ عَمروٍ","عَلى أَدماءَ كَالجَمَلِ الفَنيقِ",0,"ق",1,0],["وإذ فسادي بكم يذكِّرني","لنُفْسِدَنَّ الطواف في عمرِ",1,"ر",1,0],["وإذ فيك أمثال الظباء ملاحةً","ونَفْراً عن الفحشاء بل هن أنفر",2,"ر",1,0],["وَإذ فَرَغنا مِن بَيانِ الخامِسَه","فلنُوضِّح الآنَ بَيانَ السَادِسَه",3,"ه",1,0],["وإذ فُتنَّا سبقاً إلى غاية العُلَى","فأجدرُ مِنّا أن يحاربك الدَّهرُ",4,"ر",1,0],["وَإِذ فارَقَتهُ في أَرضٍ وَجَّ","وَجا قَلبي التِياعَ كَالسِنانِ",5,"ن",1,0],["وَإِذ فَتَكَ النُعمانُ بِالنّاسِ مُحرِماً","فَمُلِّأَ مِن عَوفِ بنِ كَعبٍ سَلاسِلُه",6,"ل",2,0],["وإذ فشا سالفه أرخته","سالف طرد مورث ملالا",7,"ل",2,0],["وإذ فتاة بني سعد به سعدت","شياهها قد سقاها ضرعها البأه",8,"ا",2,0],["وَاذ فازَ في خُلد بِرِضوان رَبِّهِ","وَباتَ بِبال في رِضى اللَهُ ناعِم",9,"م",1,0],["وَاِذ فَرقت يُمناهُ جَمعاً لِشَملُهُم","دَعوهُ فَريقاً وَهو من ذاكَ اكبَر",10,"ر",1,0],["وإذ فتحت بابا ورمزا مطلسما","أعادت بدايات العبور لعهدتي",11,"ت",2,0]]}