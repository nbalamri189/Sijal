{"poems":[[55,"وذي ضغن معسولة كلماته","https://www.aldiwan.net/poem29846.html","الطويل"],[55,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[56,"فلا تفسدن خمسين ألفا وهبتها","https://www.aldiwan.net/poem27647.html","الطويل"],[29,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[23,"لقد علمت بنو النجار","https://www.aldiwan.net/poem21437.html","الوافر"],[23,"ألا إن ادعاء بني قصي","https://www.aldiwan.net/poem21438.html","الوافر"],[23,"لعمرك إن إلك من قريش","https://www.aldiwan.net/poem21483.html","الوافر"],[23,"فلا تفش سرك إلا إليك","https://www.aldiwan.net/poem21545.html","المتقارب"],[74,"سرى طيفها حيث العواذل هجع","https://www.aldiwan.net/poem19163.html","الطويل"],[53,"رأيت الأخلاء في دهرنا","https://www.aldiwan.net/poem65957.html","الطويل"],[47,"فدتك يدي من عاتب ولسانيا","https://www.aldiwan.net/poem66867.html","الطويل"],[30,"ألا ليت شعري ما أرادت مجاشع","https://www.aldiwan.net/poem5103.html","الطويل"],[68,"سرك إن صنته بصمت","https://www.aldiwan.net/poem38561.html","مجزوء البسيط"],[33,"يقول عتيق إذ شكوت صبابتي","https://www.aldiwan.net/poem42548.html","الطويل"],[48,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[96,"تعالوا نعدّ الصّيد","https://www.poetsgate.com/ViewPoem.aspx?id=15668",""],[136,"واسكب مدمع العينين وأذر","https://www.aldiwan.net/poem54820.html","الوافر"],[146,"عيوب لابن مالك قد كفتنى","https://www.aldiwan.net/poem58334.html","الوافر"],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[164,"أراني الله رأسك يا صلاح","https://www.aldiwan.net/poem58709.html","البسيط"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[190,"كثير الشر ينتج من قليله","https://www.aldiwan.net/poem43472.html","الوافر"],[275,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[360,"فأبلغ مالكا عني رسولا","https://www.aldiwan.net/poem61026.html","الوافر"],[443,"أأبناء شماس إليكم رسالتي","https://www.aldiwan.net/poem2505.html","الطويل"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[469,"لقد وافيت بابك مستغيثاً","https://www.aldiwan.net/poem3568.html","عموديه"],[469,"حميت الأسيل بجد الأسل","https://www.aldiwan.net/poem3630.html","عموديه"],[532,"تأخر عن كتبي الجواب وإنما","https://www.aldiwan.net/poem45974.html","الطويل"],[556,"وأعرضت حتى لا أراك وإنما","https://www.aldiwan.net/poem47769.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77590","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202105","الطويل"],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143767","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112721","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46474","الوافر"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143012","الخفيف"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18698","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27855","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27613","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143116","المتقارب"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13110","الوافر"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11296","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100830","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130081","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32728","المتقارب"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132948","الطويل"],[3705,"","https://poetry.dctabudhabi.ae/diwan/poem/145356","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21387","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114202","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111417","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119603","الوافر"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93317","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204265",""],[4831,"العين تحكي","https://www.poetsgate.com/ViewPoem.aspx?id=208033",""],[4858,"حبائلُ الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=35576",""],[4984,"تّعِيشُ بِوَهْمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201288",""],[5064,"قوافل الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199088",""],[585,"ذكرت له أيامنا فتنهدا","https://www.poetsgate.com/ViewPoem.aspx?id=161845",""],[5186,"فتاة السترة استمعي لنصحي","https://www.poetsgate.com/ViewPoem.aspx?id=156502",""],[5189,"أيا أيُّها المذنبُ","https://www.poetsgate.com/ViewPoem.aspx?id=193552",""],[5299,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=210542",""],[5573,"بكت عيني اليمنى بدمع وزجرتها","https://www.poetsgate.com/ViewPoem.aspx?id=200219",""],[6079,"سنن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=212718",""],[6124,"فلا","https://www.poetsgate.com/ViewPoem.aspx?id=194304",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""]],"verses":[["فَلا تَفتَقِد خِلّاً يَسوءُكَ بَعضُهُ","وَإِن غابَ يَوماً عَنكَ ساءَكَ كُلُّهُ",0,"ل",2,0],["فَلا تُفزِعوني بِالوَعيدِ سَفاهَةً","فَلي هامَةٌ لا تَقشَعِرُّ شَواتُها",1,"ت",3,0],["فَلا تُفسِدَن خَمسينَ أَلفاً وَهَبتَها","وَعِشرَةَ أَحوالٍ وَحَقَّ تَناسُبِ",2,"ب",1,1],["فَلا تَفخَر وَأَنتَ مُجاشِعيٌّ","نَخيبُ القَلبِ مُنخَرِقُ الحِجابِ",3,"ب",1,0],["فَلا تَفخَر فَقَد غَلَبَت قَديماً","عَلَيكَ مَشابِهٌ مِن آلِ حامِ",4,"م",1,0],["فَلا تَفخَر فَإِنَّ بَني قُصَيٍّ","هُمُ الرَأسُ المُقَدَّمُ وَالسَنامُ",5,"م",1,0],["فَلا تَفخَر بِقَومٍ لَستَ مِنهُم","فَإِنَّ قَبيلَكَ الهُجُنُ اللِئامُ",5,"م",1,0],["فَلا تَفخَر بِقَومٍ لَستَ مِنهُم","وَلا تَكُ كَاللِئامِ بَني هِشامِ",6,"م",1,0],["فَلا تُفشِ سِرَّكَ إِلّا إِلَيكَ","فَإِنَّ لِكُلِّ نَصيحٍ نَصيحا",7,"ح",2,1],["فلا تفتخر من نيل مصر أصابع","فما النيل إلا من يمينك أصبع",8,"ع",1,0],["فلا تفزعنّ إلى نصرِهمْ","وكن للمظالم ظهراً ذليلا",9,"ل",2,0],["فَلا تُفسِدَن بِالمَطلِ مَنّاً تَمُنُّهُ","فَخَيرُ السَحابِ ما يَكونُ غَوادِيا",10,"ي",2,0],["فَلا تَفرَحا يا اِبنَي رَقاشٍ بِنَأيِها","فَقَد كانَ مِمّا أَن تَطِمَّ بُحورُها",11,"ر",3,0],["فَلا تَفُه لِاِمرِىءٍ بِسِرٍّ","وَلا تُحَرِّك بِهِ لِسانَك",12,"ك",1,0],["فَلا تَفتَضِح عَيناً أَتَيتَ الَّذي تَرى","وَطاوَعتَ هَذا القَلبَ إِذ أَنتَ سادِرُ",13,"ر",1,0],["فَلا تَفرَح إِذا رَجَّبتَ فيهِم","فَقَد رَفَعوا الدَنِيَّ وَرَجَّبوهُ",14,"ب",3,0],["فَلاَ تَفَرَقُّوا وَلاَ تنازَعُوا","أَعدَاؤُنا شُوسٌ وَلَيسُوا رُمْدا",15,"د",2,0],["فلا تفخروا : ألفخر للعرب وحدهم","وللعرب قعساء العلى والمكارم",16,"م",1,0],["فَلاَ تَفخَر بِعِلمِ أبٍ وجَدٍّ","فَعِلمُ أَبٍ وجَدٍّ غَيرُ فَخرِ",17,"ر",1,0],["فلا تفْرِر بها شرقا وغربا","فما أحدٌ من الحدثانِ ناجِ",18,"ج",1,0],["فلا تُفنِيَنَّ العِيسَ بالعَقْر إنها","متى تَفنَ تجزُرْهُم إماءً وأعبُدا",19,"د",2,0],["فلا تفرح بفتك دم ابن زيدٍ","فما يرجى لقاتلهِ فلاحُ",20,"ح",1,0],["فلا تَفْتِنَنَّك دنيا الغِنى","ومَثِّلْ مُقامَكما في الرِّجام",21,"م",1,0],["فلا تفرح بود أخ إذا لم","يدع يمناك تلعب في زبيله",22,"ل",2,0],["فلا تَفتحي جرحي القديمَ لأنّهُ","عميقٌ فيَستَولي على قلبكِ الذُّعر",23,"ر",1,0],["فلا تَفعَل فإن أخاك جلدٌ","على العزّاء فيها ذو احتيال",24,"ل",1,0],["فلا تفررنكم كثرة من أراذل","فمالائق إلا بكم ذلك الرهط",25,"ط",1,0],["فلا تُفجَع الدنيا بمجدك إنه","لمجدِ بنيها قِبلةٌ ومِثالُ",26,"ل",1,0],["فلا تفخر بأنك ربُّ قصد","فما من رفعة يؤتى الكنيف",27,"ف",1,0],["فلا تفرحنَّ بطول الحيا","ة أخفُّ العذاب عذابٌ قتل",28,"ل",1,0],["فلا تفسدن عشرين ألفاً وهبتها","بعشرين حرفاً كلامك تُستمرى",29,"ر",2,0],["فلا تفُتَنوا بعدي بشيءٍ فإنّنِي","فُتِنْتُ بمملوءِ الجفون من السِّحْرِ",30,"ر",1,0],["فلا تفخرْ بأهلٍ لم","توافِقهُمْ على السَّجع",31,"ع",1,0],["فَلأتفضَّل أجبرن خاطِرها","وَمُذ أَتى يَأكلها لَم يَرَها",32,"ه",2,0],["فلا تَفْرحنْ إنْ كان يَوْماً مقاربا","ولا تَجْزَعنْ إن كان يوما مجانبا",33,"ب",2,0],["فلا تفاخر بما تقضى","كان الخرا مرة هريسه",34,"س",2,0],["فلا تفضح ولا تترك لغير","وقل لي فزت مني باتصال",35,"ل",1,0],["فَلا تَفرَح إِذا دَنَت الأَماني","وَلا تَحزَن إِذا دَهتِ الخُطوب",36,"ب",1,0],["فلا تفزعي من ناظريَّ إذا هُما","ألحَّا فهذا الحسنُ يغري ويؤنس",37,"س",1,0],["فَلا تُفسِدوا ما كانَ بَيني وَبَينَكُم","بَني قَطنٍ أَن المُليمَ مَليمُ",38,"م",1,0],["فلا تفتح فخلفَ البابِ ريحٌ","إذا هبَّت عليّ تهين عظمي",39,"م",2,0],["فلا تفزعن إلا إليها فإنها","هي الحكم الأعلى الإمام المقدَّمُ",40,"م",1,0],["فَلا تَفشِيا سِرّي وَلا تَخذُلا أَخاً","أَبثَّكُما مِنهُ الحَديثَ المُكتَّما",41,"م",2,0],["فلا تفش لله سرا ولا","تبث البرايا علوم الحجى",42,"ا",1,0],["فَلا تُفسِد صَبوحَ أَخيكَ فيهِ","فَأَنتَ بِكُلِّ مَكرُمَةٍ جَديرُ",43,"ر",1,0],["فلا تفرح بأمرٍ قد تولى","ولا تأيس من الأمرِ السحيقِ",44,"ق",1,0],["فلا تفكوا عرى القربى ولو رجعت","عنكم شفار الظبا مخضوبة بدم",45,"م",1,0],["فلا تفرحوا أعداء مصر فخصمكم","تولّى وكلّ القطر يرغي ويُزبِدُ",46,"د",1,0],["فَلا تَفخَر فَإِنَّكَ مِن كُلَيبٍ","وَقارِب إِن وَجَدتَ لَهُ اِقتِرابا",47,"ب",2,0],["فَلا تَفرَحَنَّ فَكَم مِثلَ ذا","رَأَيناهُ ما تَمَّ حَتّى اِنقَضى",48,"ض",2,0],["فلا تفضَحَنَّ النَّفسَ يوماً بِشُربِها","إذا لم تَثِق منها بحسنِ السرائر",49,"ر",1,0],["فلا تفرحن إلا بتقديم طاعة","فذاك الذي ينجي غدا ويسلم",50,"م",1,0],["فَلا تَفغَروا أَفواهكُم إِنَّني شَجّاً","إِلى الحَلقِ والأضراسِ غَيرُ حَبيبِ",51,"ب",1,0],["فَلاَ تَفخَرُونَ عَلَينَا بِنَا","فَإِنَّا لَكُم أبَداً مَفخَرَا",52,"ر",2,0],["فلا تَفكِرُوا بالعَودِ ما لم تُقَوِّمُوا","لِهيلانَةٍ ثَأراً لِبؤسٍ يَكِيدُها",53,"د",3,0],["فلا تفخَر بنو الحدبا عليكم","وإن فخروا على بعض العباد",54,"د",1,0],["فلا تفتخر مصرٌ علينا بنيلها","فيمناكَ نيلٌ كلُّ مِصْرٍ به مِصْرُ",55,"ر",1,0],["فلا تَفرحَن يوماً بنفسك انني","ارى الموتَ وقّاعاً على من تَشَجّعا",56,"ع",2,0],["فلا تفلحوا بالحظّ منها فإنه","قليل على هذا المحال بقاؤها",57,"ا",3,0],["فَلا تَفِرَّ لئنْ جاءَتْك َ ضاحِكَةً","سِحْرُ الحياةِ بأَنْ تَلْقاها نَشْوانا",58,"ن",2,0],["فلا تَفْتِنْكَ، بعدَ اليَومِ، أُنثى","ولا تُسْلِمْ لها ذُلَّ القِيادِ",59,"د",1,0],["فلا تفقد الآمال إن حياتنا","مقاطع فلتظفر لحين بمقطع",60,"ع",1,0],["فلا تَفْرَحْ لِمَا يأتِي التذَاذًا","ولا تَحزَنْ لمَا يَمضِي أذَاهُ",61,"ا",2,0],["فلا تفتحوا باب الخلاف وسارعوا","إلى السعي إن الشرق قد طاب معهدا",62,"د",2,0],["فلا تفريط تقصير سفاها","ولا إفراط تطويل سفالا",63,"ل",2,0],["فلا تفرحنَّ ولا تزهوَنَّ","فإنّك والله مستنكرُ",64,"ر",1,0],["فَلا تَفْزَعِي إنْ جِئتُ أرْكُضُ دَامِيًا","وَقَدْ طَرَّزَتْ صَدْري رمَاحٌ وَأسْهُمُ",65,"م",1,0],["فلا..تفضحين الحال ياعين مالكِ","ولاتنبشين أحزان دامي قبرتها",66,"ت",3,0],["فَلا تَفْرَحْ وَلا تَجْزَعْ وَعادِلْ","فَإِنَّ الدَّهْرَ مُضْطَرِبٌ لَعوبُ",67,"ب",1,0],["فَلا تَفْرَحْ وَلا تَأْسَ","فَكُلُّ العِيْرِ مَأْمُوْرٌ!.",68,"ر",1,1],["فَلا تَفخَر بِبَأسٍ أَو بِمالٍ","فَما أَغناكَ عَن سَقَدِ المَتاعِ",69,"ع",1,0]]}