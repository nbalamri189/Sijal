{"poems":[[60,"يا عمرو قد لاقيت فارس همة","https://www.aldiwan.net/poem30872.html","الكامل"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[333,"أكبرت عيدك هجرة المختار","https://www.aldiwan.net/poem54964.html","الكامل"],[484,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[563,"يا نافخ الناي هذا النفخ عمن كان","https://www.aldiwan.net/poem33723.html","المواليا"],[823,"","https://poetry.dctabudhabi.ae/diwan/poem/198756","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137946",""],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108076","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131039",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90863","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120305","الكامل"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4988,"ظايق قهر","https://www.poetsgate.com/ViewPoem.aspx?id=152341",""],[5376,"أشكو السَقَاَمَةَ بالهوى يا شامُ","https://www.poetsgate.com/ViewPoem.aspx?id=189708",""],[5956,"ولدي المرضيُّ عنه مريض","https://www.poetsgate.com/ViewPoem.aspx?id=193194",""]],"verses":[["وَاللَهُ ناصِرُ دينِهُ وَنَبيِّهِ","وَمُعينُ كُلِّ مُوَحِّدٍ مِقدامِ",0,"م",1,0],["واللهُ نِعمَ المُستعانُ إذا الهَوَى","غَلبَ النُّفوسَ وقَلَّتِ الأَعْوانُ",1,"ن",1,0],["واللَه نظم عقد ذا","ك العقد عن حكم قضاها",2,"ا",3,0],["والله ناصر حزبه ومن اتقى","بالله أمّنه من الأخطار",3,"ر",1,0],["والله ناصره وربك قائل","الأرض أرضي والسماء سمائي",4,"ا",2,0],["والله نافخْ ترى أم أنت هذا الآنْ","كالبرق يلمعْ ويفنى أيها الإنسانْ",5,"ن",1,0],["والله ندعو أن يداوي كسرنا","ويغيثنا بالصبر والسلوانِ",6,"ن",1,0],["واللهَ ندعو ان يكون لسؤلنا","هذا مجيباً للدعاء سميعا",7,"ع",2,0],["والله نَاصِرُ دِينِهِ وَكِتَابِهِ","وَرسُولِهِ فِي سَائِرِ الأزمَانِ",8,"ن",1,0],["والله نزل في آيات محكمه","زواج اربعة فاعلم بأمر على",9,"ل",2,0],["والله نشتاق عهداً للحبيب مضى","فيا زمان حبيبي جادكَ الديم",10,"م",1,0],["والله نسأل أن يوليك نعمته","وأن يعزز بالتوفيق مسعاكا",11,"ك",2,0],["واللَه نور الكائنات فلا تكن","في مرية من هذه الآيات",12,"ت",1,0],["واللَه ناصره ومعلى امره","حتى تذل لرايه الاراء",13,"ا",2,0],["والله ناصرُ ناصرٍ لِوليه","ما كان في سلمٍ له أو واقعة",14,"ع",2,0],["والله نعيش اليوم غفله والوضع جدآ خطر","الموت يخطفنا وجرحك يا عروبه ما برى",15,"ر",2,0],["والله نسألُ لا نسائلُ غيره","بزغ الصباحُ وديننا الإسلامُ",16,"م",1,0],["واللهِ نسْتَحْيي لضعفِ أدائنا","بسبيلهِ أن نستكين ونحزنا",17,"ن",2,0]]}