{"poems":[[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[63,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[63,"ألا ليت شعري هل أرى الدور بالحمى","https://www.aldiwan.net/poem45807.html","الطويل"],[63,"أما والخيل تعثر في العجاج","https://www.aldiwan.net/poem45895.html","الطويل"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[73,"قل لأبي حفص ولم تكذب","https://www.aldiwan.net/poem11984.html","السريع"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[89,"قلت الحقيقة طالباً أن ينظروا","https://www.aldiwan.net/poem45119.html","الكامل"],[56,"قالوا السلام عليك يا أطلال","https://www.aldiwan.net/poem58537.html","الكامل"],[80,"ولى شبابي وراع شيبي","https://www.aldiwan.net/poem31395.html","مخلع البسيط"],[46,"إذا كف صل أفعوان فما له","https://www.aldiwan.net/poem22114.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42630","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42601","الطويل"],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[130,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[141,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[190,"بخدي من قطر الدموع ندوب","https://www.aldiwan.net/poem27463.html","الطويل"],[202,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[209,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[254,"ولي شفيع إليك شرفني","https://www.aldiwan.net/poem48504.html","المنسرح"],[269,"أغيب وذو اللطائف لا يغيب","https://www.aldiwan.net/poem52126.html","الوافر"],[280,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[280,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[295,"لك الخير إن جزت اللوى والمطاليا","https://www.aldiwan.net/poem33081.html","الطويل"],[301,"تأنق في شكلي ونفسي صانعي","https://www.aldiwan.net/poem57711.html","الطويل"],[301,"ولي شبابي والآمال مقبلة","https://www.aldiwan.net/poem58303.html","البسيط"],[302,"ألا ليت شعري والفؤاد به ثأر","https://www.aldiwan.net/poem16805.html","الطويل"],[303,"وروضة حسن بات ينشقنا الصبا","https://www.aldiwan.net/poem56422.html","الطويل"],[362,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[362,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[374,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[388,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[406,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[413,"جاء الربيع بورده وبهاره","https://www.aldiwan.net/poem54045.html","الكامل"],[426,"أمن خدها الوردي افتنك الخال","https://www.aldiwan.net/poem40062.html","الطويل"],[429,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[438,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[462,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[513,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[549,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"]],"verses":[["وَلي شُغُلٌ في طالِبٍ ضَلَّ قَصدَهُ","أُسائِلُ عَنهُ ما يَقولُ المَقاصِدُ",0,"د",1,0],["وَلي شيمَةٌ عَسراءُ تَرأَمُ نَخوَةً","تُحَلِّىءُ سَيفي عَن مُضاجَعَةِ الغِمدِ",1,"د",1,0],["وَلي شَجَنٌ أَخشى إِذا ما ذَكَرتُهُ","عَدوّاً مُبيناً أَو صَديقاً مُداجِيا",2,"ي",2,0],["وَلي شِيمٌ أَوابِدُ آنِساتٌ","يُشابُ العَذْبُ مِنْها بِالأُجَاجِ",3,"ج",1,0],["وَلّى شَبابُكَ فيهِ","ما بَينَ مَدٍّ وَغَنِّ",4,"ن",1,0],["وَليَشرَبِ الأَكثَرَ مِن كَأسِهِ","وَاِعمِد إِلى فَضلَتِهِ فَاِشرَبِ",5,"ب",1,0],["وليشكرِ النَّاجِمَ عن هذه","فإنها من بعضِ ما بوَّبا",6,"ب",2,0],["وليشكرنَّك وهو أعلم عالمٍ","أن المديح به ينير ويَبْهجُ",7,"ج",1,0],["وليشهد الثقلان أني مارق","إن كان في قول الصواب مروق",8,"ق",1,0],["وَلْيَشْفِيَنْ حُبِّي فَمٌ وَجَنَى يَدٍ","وكِلاهُما لي بارِدٌ سَلْسَالُ",9,"ل",1,0],["ولّى شبابي وَرَاعَ شَيبْي","مِنّيَ سِرْبَ المَها وَفَضّهْ",10,"ه",1,1],["وَلي شَرقٌ بِالحَتفِ ما هُوَ مُغرَبٌ","أَيَمَّمتُ شَرقاً في المَسالِكِ أَم غربا",11,"ب",2,0],["وَلِي شِيمَةٌ تَأْبَى الدَّنَايَا وَعَزْمَةٌ","تَرُدُّ لُهَامَ الْجَيْشِ وَهْوَ يَمُورُ",12,"ر",1,0],["وَلْيَشْتَهِرْ تَارِيخُهُ","رَجَعَ الْخِديو لِمِصْرِهِ",13,"ر",2,0],["وَلِي شِيمَةٌ تَأْبَى الدَّنَايَا وَعَزْمَةٌ","تَفُلُّ شَباةَ الْخَطْبِ وَهْوَ عَسِيرُ",14,"ر",1,0],["وليشهَد التاريخُ «لليَرْمُوك»، أو","«ذي قارَ» في العصر الحديث مثيلا",15,"ل",2,0],["ولَّى شبابٌ فهلْ يعودُ","ولاحَ شَيْبٌ فما يُريدُ ؟",16,"د",1,1],["وَلِى شَيخٌ يَذُبُّ الشَّرَّ عني","فَمِمَّا كُنتُ مُختَشِياً حَمَاني",17,"ي",1,0],["وَليَشيموا نَداكَ فَالوِردُ صافٍ","وَليَفيؤوا إِلَيكَ فَالظِلُّ ضافِ",18,"ف",1,0],["وَلي شاهِدٌ مِن ضَرِّ نَفسي وَسَقمِه","يُخبِرُ عَنّي أَنَّني لَكَئيب",19,"ب",1,0],["ولي شغل في صلح قلبي وناظري","على تَلفي حتى فنيتُ من الوجدِ",20,"د",1,0],["ولي شبابك لم ننعَم بنَضرتِه","ولم نفُز من تمنينا بمأمول",21,"ل",1,1],["ولي شفيعٌ إليك شرفني","إيجابه لي وزاد في قدري",22,"ي",1,1],["وَلي شجن باطفال صغار","أَكادَ اذا ذكرتهم أذوب",23,"ب",1,0],["وَلي شَرَفُ الدينِ في بانِياسَ","فَلَستُ لِفُرقَةِ مَن بانَ آسى",24,"س",2,0],["وَلّى شبابي وَاِستَشَنَّ أَديمُهُ","وَهريقَ ماءُ رُوائِهِ السَّفّاحُ",25,"ح",1,0],["وَلي شيمَةٌ في وَجنة الدهر شامةٌ","تُنيرُ على رغم الصَباح الدياجيا",26,"ي",2,0],["ولي شفةٌ رقت وراق زلالها","فمن أجل ذا تصبو النفوس إلى لثمي",27,"ي",1,0],["ولي شبابي والآمال مقبلةٌ","فالشيب قد راع والإمهال قد راعى",28,"ع",2,1],["ولي شجن فيهم ولي ولع بهم","ولي مدمع في البين في الخد مدرار",29,"ر",1,0],["وَلي شاهدٌ أنّ القُرنفلَ سيّدٌ","عَلى الوردِ في طيبٍ وحسنِ تشكّلِ",30,"ل",1,0],["ولي شِبْلُ صِدْقٍ غيرَ أنْ ليس حاضري","فَتُنجِدُني أَنيابُه والأظافر",31,"ر",1,0],["ولِيشْهَدَ عندَ اللهِ غداً","وسَيصْدُقُ إذْ يَستَشْهِده",32,"د",2,0],["وليشتهرْ بعبادتي مستمسكاً","قانونيَ المرسومَ من تلقائي",33,"ي",1,0],["وليشهد الخيرة في القضاء","وفي جميع الضر والبلاء",34,"ا",2,0],["ولي شكوَى من الأيّامِ أضحَتْ","لها نَفْسِي تَرَدَّدُ في التّراقي",35,"ي",1,0],["وليشربنَّ الرَّاح ناشد لذَّة","لم يُلفِها إلاَّ لدى أزهاره",36,"ر",2,0],["ولي شيمةٌ طابت ثناءً وعفةٌ","تصاحبني حتى يصاحبني الخال",37,"ل",1,0],["وليشكروا عنِّي الشَّمالَ فقد","جَمَعَتْ بأَلْطَفَ منهمُ الشَّمْلا",38,"ل",2,0],["ولي شغل بما لا في","ه لي نفع وتلديد",39,"د",1,0],["ولى شباة عزمه مراتباً","يعزل عنهن السماك الأعزل",40,"ل",1,0],["وليشكروك على الجميل فشكرهم","سبب يديم سوابغ النعماء",41,"ا",2,0],["ولِي شُغُلٌ عن هوى الغانياتِ","وَما الحبُّ إلّا فَراغُ الجَنانِ",42,"ن",1,0]]}