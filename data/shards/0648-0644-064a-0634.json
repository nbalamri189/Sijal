{"poems":[[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[65,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[65,"ألا ليت شعري هل أرى الدور بالحمى","https://www.aldiwan.net/poem45807.html","الطويل"],[65,"أما والخيل تعثر في العجاج","https://www.aldiwan.net/poem45895.html","الطويل"],[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[75,"قل لأبي حفص ولم تكذب","https://www.aldiwan.net/poem11984.html","السريع"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[91,"قلت الحقيقة طالباً أن ينظروا","https://www.aldiwan.net/poem45119.html","الكامل"],[58,"قالوا السلام عليك يا أطلال","https://www.aldiwan.net/poem58537.html","الكامل"],[82,"ولى شبابي وراع شيبي","https://www.aldiwan.net/poem31395.html","مخلع البسيط"],[48,"إذا كف صل أفعوان فما له","https://www.aldiwan.net/poem22114.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42630","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42601","الطويل"],[108,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[92,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[136,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[147,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[196,"بخدي من قطر الدموع ندوب","https://www.aldiwan.net/poem27463.html","الطويل"],[208,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[215,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[261,"ولي شفيع إليك شرفني","https://www.aldiwan.net/poem48504.html","المنسرح"],[276,"أغيب وذو اللطائف لا يغيب","https://www.aldiwan.net/poem52126.html","الوافر"],[287,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[287,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[302,"لك الخير إن جزت اللوى والمطاليا","https://www.aldiwan.net/poem33081.html","الطويل"],[308,"تأنق في شكلي ونفسي صانعي","https://www.aldiwan.net/poem57711.html","الطويل"],[308,"ولي شبابي والآمال مقبلة","https://www.aldiwan.net/poem58303.html","البسيط"],[309,"ألا ليت شعري والفؤاد به ثأر","https://www.aldiwan.net/poem16805.html","الطويل"],[310,"وروضة حسن بات ينشقنا الصبا","https://www.aldiwan.net/poem56422.html","الطويل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[369,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[396,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[422,"جاء الربيع بورده وبهاره","https://www.aldiwan.net/poem54045.html","الكامل"],[435,"أمن خدها الوردي افتنك الخال","https://www.aldiwan.net/poem40062.html","الطويل"],[438,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[447,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[520,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[556,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138361",""],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130206","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38852","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62474","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136218","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136215","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6754","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49957","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100975","المجتث"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144759","الطويل"],[1796,"","https://poetry.dctabudhabi.ae/diwan/poem/198800","البسيط"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130684","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123278","المواليا"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123154","الطويل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108474","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89530","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67874","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87340","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105663","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137364",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201430","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100824","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91153","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92055","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59476","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78278","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94328","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94597","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94365","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94599","الوافر"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105512","المتقارب"],[4755,"ولِي شَوقٌ بهَجرِكِ ما تَأَسَّى","https://www.poetsgate.com/ViewPoem.aspx?id=186714",""],[4932,"وحلاه من حسنى اساميه جملَة","https://www.poetsgate.com/ViewPoem.aspx?id=187281",""],[5055,"الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=104034",""],[585,"حييت من وطنٍ كالركن مستلم","https://www.poetsgate.com/ViewPoem.aspx?id=161912",""],[5213,"بماضي رهيف العزم أقتحم الصعبا","https://www.poetsgate.com/ViewPoem.aspx?id=170408",""],[5431,"ويسكنني كما لو كان جِنّا","https://www.poetsgate.com/ViewPoem.aspx?id=187294",""],[5463,"جيتي فجأة تتركيني","https://www.poetsgate.com/ViewPoem.aspx?id=35642",""],[5480,"ابكي وليفي ناحل العود","https://www.poetsgate.com/ViewPoem.aspx?id=5143",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5688,"رحيل العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200936",""],[5701,"سهرت أنظمه والناس قد هجعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164586",""],[5861,"ألم الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=190619",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[6033,"نفرتُ إلى ربّي","https://www.poetsgate.com/ViewPoem.aspx?id=215800",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6202,"بنت قحطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86713&r=&rc=14",""],[463,"منْ حاكمٌ وخصوميَ الأقدارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60069&r=&rc=125",""],[6252,"أحزانٌ لسيدة الصحو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79805&r=&rc=0",""],[147,"قَدْ كَفى اللَّهُ وَهْوَ نِعْمَ الْكَافِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27436&r=&rc=3",""]],"verses":[["وَلي شُغُلٌ في طالِبٍ ضَلَّ قَصدَهُ","أُسائِلُ عَنهُ ما يَقولُ المَقاصِدُ",0,"د",1,0],["وَلي شيمَةٌ عَسراءُ تَرأَمُ نَخوَةً","تُحَلِّىءُ سَيفي عَن مُضاجَعَةِ الغِمدِ",1,"د",1,0],["وَلي شَجَنٌ أَخشى إِذا ما ذَكَرتُهُ","عَدوّاً مُبيناً أَو صَديقاً مُداجِيا",2,"ي",2,0],["وَلي شِيمٌ أَوابِدُ آنِساتٌ","يُشابُ العَذْبُ مِنْها بِالأُجَاجِ",3,"ج",1,0],["وَلّى شَبابُكَ فيهِ","ما بَينَ مَدٍّ وَغَنِّ",4,"ن",1,0],["وَليَشرَبِ الأَكثَرَ مِن كَأسِهِ","وَاِعمِد إِلى فَضلَتِهِ فَاِشرَبِ",5,"ب",1,0],["وليشكرِ النَّاجِمَ عن هذه","فإنها من بعضِ ما بوَّبا",6,"ب",2,0],["وليشكرنَّك وهو أعلم عالمٍ","أن المديح به ينير ويَبْهجُ",7,"ج",1,0],["وليشهد الثقلان أني مارق","إن كان في قول الصواب مروق",8,"ق",1,0],["وَلْيَشْفِيَنْ حُبِّي فَمٌ وَجَنَى يَدٍ","وكِلاهُما لي بارِدٌ سَلْسَالُ",9,"ل",1,0],["ولّى شبابي وَرَاعَ شَيبْي","مِنّيَ سِرْبَ المَها وَفَضّهْ",10,"ه",1,1],["وَلي شَرقٌ بِالحَتفِ ما هُوَ مُغرَبٌ","أَيَمَّمتُ شَرقاً في المَسالِكِ أَم غربا",11,"ب",2,0],["وَلِي شِيمَةٌ تَأْبَى الدَّنَايَا وَعَزْمَةٌ","تَرُدُّ لُهَامَ الْجَيْشِ وَهْوَ يَمُورُ",12,"ر",1,0],["وَلْيَشْتَهِرْ تَارِيخُهُ","رَجَعَ الْخِديو لِمِصْرِهِ",13,"ر",2,0],["وَلِي شِيمَةٌ تَأْبَى الدَّنَايَا وَعَزْمَةٌ","تَفُلُّ شَباةَ الْخَطْبِ وَهْوَ عَسِيرُ",14,"ر",1,0],["وليشهَد التاريخُ «لليَرْمُوك»، أو","«ذي قارَ» في العصر الحديث مثيلا",15,"ل",2,0],["ولَّى شبابٌ فهلْ يعودُ","ولاحَ شَيْبٌ فما يُريدُ ؟",16,"د",1,1],["وَلِى شَيخٌ يَذُبُّ الشَّرَّ عني","فَمِمَّا كُنتُ مُختَشِياً حَمَاني",17,"ن",2,0],["وَليَشيموا نَداكَ فَالوِردُ صافٍ","وَليَفيؤوا إِلَيكَ فَالظِلُّ ضافِ",18,"ف",1,0],["وَلي شاهِدٌ مِن ضَرِّ نَفسي وَسَقمِه","يُخبِرُ عَنّي أَنَّني لَكَئيب",19,"ب",1,0],["ولي شغل في صلح قلبي وناظري","على تَلفي حتى فنيتُ من الوجدِ",20,"د",1,0],["ولي شبابك لم ننعَم بنَضرتِه","ولم نفُز من تمنينا بمأمول",21,"ل",1,1],["ولي شفيعٌ إليك شرفني","إيجابه لي وزاد في قدري",22,"ي",1,1],["وَلي شجن باطفال صغار","أَكادَ اذا ذكرتهم أذوب",23,"ب",1,0],["وَلي شَرَفُ الدينِ في بانِياسَ","فَلَستُ لِفُرقَةِ مَن بانَ آسى",24,"س",2,0],["وَلّى شبابي وَاِستَشَنَّ أَديمُهُ","وَهريقَ ماءُ رُوائِهِ السَّفّاحُ",25,"ح",1,0],["وَلي شيمَةٌ في وَجنة الدهر شامةٌ","تُنيرُ على رغم الصَباح الدياجيا",26,"ي",2,0],["ولي شفةٌ رقت وراق زلالها","فمن أجل ذا تصبو النفوس إلى لثمي",27,"م",2,0],["ولي شبابي والآمال مقبلةٌ","فالشيب قد راع والإمهال قد راعى",28,"ع",2,1],["ولي شجن فيهم ولي ولع بهم","ولي مدمع في البين في الخد مدرار",29,"ر",1,0],["وَلي شاهدٌ أنّ القُرنفلَ سيّدٌ","عَلى الوردِ في طيبٍ وحسنِ تشكّلِ",30,"ل",1,0],["ولي شِبْلُ صِدْقٍ غيرَ أنْ ليس حاضري","فَتُنجِدُني أَنيابُه والأظافر",31,"ر",1,0],["ولِيشْهَدَ عندَ اللهِ غداً","وسَيصْدُقُ إذْ يَستَشْهِده",32,"د",2,0],["وليشتهرْ بعبادتي مستمسكاً","قانونيَ المرسومَ من تلقائي",33,"ي",1,0],["وليشهد الخيرة في القضاء","وفي جميع الضر والبلاء",34,"ا",2,0],["ولي شكوَى من الأيّامِ أضحَتْ","لها نَفْسِي تَرَدَّدُ في التّراقي",35,"ق",2,0],["وليشربنَّ الرَّاح ناشد لذَّة","لم يُلفِها إلاَّ لدى أزهاره",36,"ر",2,0],["ولي شيمةٌ طابت ثناءً وعفةٌ","تصاحبني حتى يصاحبني الخال",37,"ل",1,0],["وليشكروا عنِّي الشَّمالَ فقد","جَمَعَتْ بأَلْطَفَ منهمُ الشَّمْلا",38,"ل",2,0],["ولي شغل بما لا في","ه لي نفع وتلديد",39,"د",1,0],["ولى شباة عزمه مراتباً","يعزل عنهن السماك الأعزل",40,"ل",1,0],["وليشكروك على الجميل فشكرهم","سبب يديم سوابغ النعماء",41,"ا",2,0],["ولِي شُغُلٌ عن هوى الغانياتِ","وَما الحبُّ إلّا فَراغُ الجَنانِ",42,"ن",1,0],["وليشدُ من طرب به عمالها","اهلا وسهلا بالمكارم والعلى",43,"ل",2,0],["ولي شرف عال وفي الشمس أسوتي","لئن اشمت الحساد صرفي ورحلتي",44,"ي",1,0],["وَلي شَرعٌ هوَ المِيزانُ قِسطاً","وَعِندي لَيسَ لِلميزانِ عينُ",45,"ن",1,0],["ولي شَجَنٌ بالدُّرِّ والبرق مَوهناً","وما ذاك إلا ثغرُها وابتسامُها",46,"م",3,0],["ولي شاهد في الذوق ابداه ناطقي","على أهل فني فيه ايما وتذكره",47,"ر",2,0],["ولي شاهد في الذوق اخفيت بعضه","وما كل ذوق بين أهليه يظهر",48,"ر",1,0],["وَليَّ شَأوٌ بِمَيدانِ الخَطايا","بَعيدٌ لا يُبارى بِالرِياحِ",49,"ح",1,0],["ولي شجَن سَمعي وقَلْبي وناظري","على فتنتَي أنصارُهُ وجنودُهُ",50,"د",2,0],["ولي شفيع ولاءٍ","لديكم لن يردا",51,"د",2,0],["ولي شاطئ الوادي بشرقي ضارج","حمى سكن لم انتجع دونه حصنا",52,"ن",2,0],["وليشرق الغد للأجيال قاطبة","من لم يشبوا ومن شبوا عن الحلم",53,"م",1,0],["ولي شغل عن الاخوان طرا","لما بالجسم من فرط السقام",54,"م",1,0],["وليش على الغصن","بالأوراق تتستر",55,"ر",1,0],["وليش يا ملوخيا بليّا تزركشت","يُرى منك يا أم الوشام تمانع",56,"ع",1,0],["ولي شهاب الأنس عنه فاظلمت","تلك المعاهد بعد نأي شبابه",57,"ب",2,0],["وَليَشكُرِ الثَقلانِ ما أَولَتهُم","مِن أَمنِهِم مِن بَعدِ خَوفٍ أَعسَرِ",58,"ر",1,0],["ولي شاهِداً عَدلٍ سهادٌ وعَبرةٌ","وكم مُدَّعٍ للحقِّ من غيرِ شاهِدِ",59,"د",1,0],["ولي شَاهِدٌ أنَّ الجديَّ نَظيرُهُ","قَرينٌ لِهُ الفَرغُ المُقَدَّمُ ما بَقي",60,"ق",2,0],["ولي شبابه وما مر له","أنس به ولم ينل أوطاره",61,"ر",2,0],["ولي شاهدا عدل دموع غزيرة","ونار لظاها في الفؤاد تسعرا",62,"ر",2,0],["ولي شعر سيطوي كل عصر","ويذهب وهو يهزأ بالعصور",63,"ر",1,0],["ولي شاغل في الحب عنك عسى الهوى","يهدّئ روعا أو يكفكف مدمعا",64,"ع",2,0],["وَلي شيم من فَوق كُل مهذبٍ","وَأَكمل خَلق دُونه كُل كامل",65,"ل",1,0],["وَلّى شريفاً عَفيف النَفس طاهرَها","مهذبَ الخَلق عن عَيب الوَرى سَلما",66,"م",2,0],["ولي شرفٌ يعلو السّماكينِ باذخٌ","وعيص بما في سّرٍ غسَّان ناصعُ",67,"ع",1,0],["وَلي شَوق يَلي شَجنا","وَكَم لي في الهَوى وَلَهِ",68,"ه",1,0],["وَليّ شيمةٌ شمّاءُ في القرب والنَوى","أَليف عهودٍ في المحبة والجَفا",69,"ف",2,0],["ولي شيمةٌ فوق السحاب وديدني","ثبات الولا عمري على القرب والبعدِ",70,"د",1,0],["ولي شيمةٌ في الحب فالسحب دونها","ولا تَتقي خطبا إذا البينُ خوَّفا",71,"ف",2,0],["ولي شأنٌ تفرَّد في ودادٍ","وأعمالي أتت أقوى دليلِ",72,"ل",1,0],["ولي شادن قد غدا مولعاً","بهجري وفيه يراني الولوع",73,"ع",1,0],["ولِي شَوقٌ بهَجرِكِ ما تَأَسَّى","وشِعرٌ عَنكِ صَبَّحَنِي ومَسَّى",74,"س",2,1],["وليٌّ شكور صَادِق فِي مقاله","عَفْو كريم بالنوال يعود",75,"د",1,0],["وليش يدّي تهتوي شيءٍ لمسته","وليش قلبي تحكمه وانا الأمير",76,"ر",1,0],["وليشهد الحفل أنى جئت يعثر بي","فرط الحياء لما أضفوه من نعم",77,"م",1,0],["ولي شيمة تابى الهو ان وان رضت","لآل معز الدين ان تخضع الجنبا",78,"ب",2,0],["ولي شغف المحب إذا تعنّى","ويسكنني كما لو كان جِنّا",79,"ن",2,1],["وليش لما جيت حدّك ما قدرتي تمنعيني","وليش ما خليتي قلبي يتّقي شرّ الخيانه",80,"ن",2,0],["وليش الليالي ما طاوعني؟","وبات الجفن مالهم مسهود",81,"د",1,0],["وليش من الهوى يابوي محروم","ونسمات الهوى تطيب الخاطر",82,"ر",1,0],["ولّى شعور الهوى من مهجتي هربا","كما تولّى لخوف خارب عجل",83,"ل",1,0],["وليشمل العدل شعب النيل أجمعه","فلا يكون به بغي ولا طمع",84,"ع",1,0],["ولي شهقةُ الذكرى بقلبي ولم تزلْ","وأسعى إلى سعيٍ بكفِّ مثيلِهِ",85,"ل",2,0],["ولي شكوةُ المحزونِ حتّى كأنه","بدمْعات إسرائيلَ إذ ضاع يوسفُ",86,"ف",1,0],["ولي شَرفٌ في الذُّلِّ حيثُ تذَّلُّلي","به أكْرَعُ التَّسنيمَ سَلْسَلَ جاريا.",87,"ي",2,0],["وليشتمِ المتلوّثونَ شتائمي","وليستروا عوراتهم بردائي",88,"ا",2,0],["ولّى شبابي وها قد بت أرقب ما","يصير من بعده الإنسان والبهم",89,"م",1,0],["وليَّ شنعاء تذهبُ نفسهُ","فيها ويبقى لومها والعارُ",90,"ر",1,0],["ولي شبرُ أحزانٍ يقيسُ مسافتي","وكنتُ أنا المحتار كيف أقيسُها",91,"س",3,0],["وليشيموا نداكَ فالوردُ صافٍ","ولفيؤوا إليكَ فالظِّلُّ ضافِ",92,"ف",1,0]]}