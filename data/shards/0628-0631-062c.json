habi.ae/diwan/poem/120747","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74258","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87524","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69952","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119702","السريع"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45047","الكامل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123458","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139592",""],[4764,"جرحي القديم","https://www.poetsgate.com/ViewPoem.aspx?id=29851",""],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[4927,"شهيد الحق السوري","https://www.poetsgate.com/ViewPoem.aspx?id=80799",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[5055,"الليل أسدل","https://www.poetsgate.com/ViewPoem.aspx?id=100737",""],[5055,"الليل أسدل","https://www.poetsgate.com/ViewPoem.aspx?id=104292",""],[5092,"سيمفونية قصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=139889",""],[5302,"خير الأحبة نجود","https://www.poetsgate.com/ViewPoem.aspx?id=201738",""],[5415,"الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=212225",""],[5776,"لا يُسمّى....؟","https://www.poetsgate.com/ViewPoem.aspx?id=199322",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""],[5956,"فتِّشْ بكل الكوكب المأنوسِ","https://www.poetsgate.com/ViewPoem.aspx?id=205171",""],[6205,"محاولة لاقتفاء الضوء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88159&r=&rc=11",""]],"verses":[["بِرِجالٍ كَالأَسدِ حَرَّبَها الزَج","رُ وَخَيلٍ ما تُنكِرُ الإِقداما",0,"م",2,0],["بِرِجالٍ لَستُمُ أَمثالَهُم","أُيِّدوا جِبريلَ نَصراً فَنَزَل",1,"ل",1,0],["برجائه اكتست الركابُ رحالها","وبجودِه عَريتْ من الأحلاس",2,"س",1,0],["بِرَجاءِ جودِكَ يُطرَدُ الفَقرُ","وَبِأَن تُعادى يَنفَدُ العُمرُ",3,"ر",1,1],["بِرَجمٍ كَوَقعِ الهُندُوانِيِّ أَخلَصَ ال","صَياقِلُ مِنهُ عَن حَصيرٍ وَرَونَقِ",4,"ق",1,0],["بِرجيم لَمّا أَتاهُم وَقاح","كانَ إِتيانُهُ عَلَيهِ وَبالا",5,"ل",2,0],["بِرِجْلٍ رَأْدَةٍ لاَ عَيْبَ فِيهَا","أَضَرَّ بِهَا العِثَارُ ولاَ ظَلُوعِ",6,"ع",1,0],["برجال القلوب شرقا وغربا","اهل كشف الحجاب بالعلماء",7,"ا",2,0],["برجُ الخلافة غابت شمس حجرته","فاظلمَ الأفق واسودّت جوانبهُ",8,"ب",2,0],["برج سعيد زانه ساكنه","أفديه من محترم مقر",9,"ر",1,0],["برجفة حاملها لم يزل","ممزقاً في القلب لا يلتئم",10,"م",1,0],["بِرِجَالِهَا تَسْمُو الْبِلاَدُ فَهُمْ لَهَا","كَالدُّرِّ فِي اللَّبَّاتِ وَالأَجْيَادِ",11,"د",1,0],["بُرجٌ يُؤَثِّمُني وَيَكفُرُ نِعمَتي","صَمّي لِما قالَ الكَفيلُ صَمامِ",12,"م",1,1],["برجالها ونسائِها تُحمى كما","تحمي العرينَ لُبوءةٌ وغضنفر",13,"ر",1,0],["برجلِ دِفاعٍ راعَها واستَذلَّها","فصَيَّرَ أرضَ الشامِ طرّاً مُعسكَرا",14,"ر",2,0],["برِجالٍ على الرِّحالِ نَشاوَى","للسُّرى تُلزِمُ القُتودَ الأكُفّا",15,"ف",2,0],["بُرْجٌ لشمسِ الأرضِ مُكتنَفٌ","بالأُسْدِ تَزأرُ حَولَهُ زأرا",16,"ر",2,0],["بُرجٌ وجِسرٌ قلبُه وجنانُه","فاطرح بقلبِ العاجز التمكين",17,"ن",1,0],["بَرَجراجةٍ لا يُنفِدُ الطَرفُ عَرضَها","لَها زَجَلٌ قَد احزأَلَّ وَمَلحَبُ",18,"ب",1,0],["برجال الديوان والقوم أهل ال","حل والعقد والهدى والوفاء",19,"ا",2,0],["بِرَجْوَى اللهِ يُفْرَجُ كُلُّ كَرْبٍ","وتَنْكَشِفُ الْمَضرَّةُ والبَلاءُ",20,"ا",2,0],["بِرجالِ الإسلامِ نرجو بأن لا","يتركوا للعدوِّ يوماً قرارا",21,"ر",2,0],["برجم ظنون مثل أضغاث حلمه","فكيف وقيد الوهم مطلق علمه",22,"ه",1,0],["برجم الظن غير يقين علمٍ","كما شيم الحيا حين استطارا",23,"ر",2,0],["برجال أهاجها يوم بدر","ما تولى أبوه من آباها",24,"ا",3,0],["برجٌ عظيمُ الشأنِ في الأبراجِ","قد بَاهَتِ الحمراءُ منه بتاجِ",25,"ج",1,1],["بُرج بِهِ قَمَر الأَفراح مُرتَفع","حَكَت لَنا عَنهُ جامات وَبَلور",26,"ر",1,0],["بَرجٌ عَظيمٌ كل البروجُ لَهُ","حجارةٌ تستهين بالقُللِ",27,"ل",1,0],["برجاك قَد عصف الردى","فَعلى رَجائك سلّمي",28,"م",2,0],["برجليه هاتيك التلال تستاقطت","إلى جوفه حتى استوى الجوف بالجرف",29,"ف",1,0],["برجَّة الأَرضِ مِن مَرهوب صَولَتِهِ","فَلا يَبقىعَلى مال وَيلقي",30,"ي",1,0],["بِرَجمِ قَوافٍ تُخرِجُ الخَبءَ في الصَفا","وَتُنزِلُ بَيضاتِ الأَنوقِ مِنَ الوَكرِ",31,"ر",1,0],["برَّجني حبُّك يا ذا البها","يا ذا البها حبك برّجني",32,"ن",2,0],["بُرجٌ تَجَلّى بِالمسَرَّةِ وَالهَنا","وَبَدا بِما بهرَ العُيونَ منَ السَنى",33,"ن",2,1],["برجالٍ قد أنيلوا","مِنَّة المولى القديرِ",34,"ر",1,0],["برجعة ندبٍ راض صعباً من العلا","فذلله من بعدما كان جامحا",35,"ح",2,0],["برجٍ تِنحى عن مساره ، وتعميم","من بعد تغيير المسارات (سكرات)",36,"ت",1,0],["برجال شنوا الإغارة في الأعداء","تحوي المشاة والركبانا",37,"ن",2,0],["بِرِجَاْلٍ صَدَقُوْا فِيْ عَهْدِهِمْ","مَاْ هُمُ وَالصِّدْقُ إِلاّ تَوْأَمَاْنِ",38,"ن",1,0],["بِرُجْحَانِ عَقْلٍ سَايَرَ الشَّعْبُ ظَرْفَهُ","يُعَزِّزُ مَا يَبْنِى بِعَزْمٍ وَإِيمَانِ",39,"ن",1,0],["برجع لأرض الظل وانظر من الباب","وعيش فالظلما وراوح مكاني",40,"ن",2,0],["برجع لأرض الظل وانظر من الباب","وَاعيش فالظلما وَراوح مكاني",41,"ن",2,0],["بَرْجاء يا طهراً بقافيتي","هل كان شعري غيرآلامي",42,"م",2,0],["بر جواد لا يمن بفضله","متواضع متسامح وشفيق",43,"ق",1,0],["بِرِجَالنَا وَنِسَائِناَ وَشَبَابِنا","بِشَجَاعَةٍ وَعَزِيمَةٍ وَإِيمَانِ",44,"ن",1,0],["برجهُ الحبُ نجمُهُ في القلوبِ","فكانَ خلّي وخصمي",45,"م",2,0],["برجولةٍ وسيادةٍ وبثروةٍ","فيقُمْن باستغلاله بتحايا..",46,"ا",3,0],["برجاحةٍ في عقله وإدارةٍ","عِلْميةٍ عمَليّةِ التأسيسِ",47,"س",1,0],["برجي بقصر العشق أوصده الدجى","في صحوة الاضواء حاولْ سُلَّما",48,"م",2,0]]}