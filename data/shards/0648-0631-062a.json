[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72464","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132203","الطويل"],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5277,"المزّمّلة","https://www.poetsgate.com/ViewPoem.aspx?id=191649",""],[5582,"بِاللهِ ما سَرَتْ الجَنُوبُ نَسِيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63576",""],[5771,"ليسَ إلَّا","https://www.poetsgate.com/ViewPoem.aspx?id=189110",""],[5784,"جف الشعر في السطر الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=190846",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5848,"ثلاثة اهداف","https://www.poetsgate.com/ViewPoem.aspx?id=53375",""],[5309,"وطني هو الأرض التي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573566",""],[6240,"مُثْقَلَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87019&r=&rc=3",""],[6248,"تراتيل العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""],[6259,"أبان لنا من دره يوم ودّعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59387&r=&rc=35",""],[6268,"زفرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82925&r=&rc=11",""]],"verses":[["ورتّبها فهي معروضة","لمن يتناولها من كتب",0,"ب",1,0],["ورت بك عيدان المكارم كلها","وأورق عودي في ثراك وأنضرا",1,"ر",2,1],["ورتل من أسلافه سوَرَ العلى","خواتمها موصولة بالفواتح",2,"ح",1,0],["ورتبة في الأفقِ قد رجَحت","من قبل أن يرصد ميزانه",3,"ن",2,0],["ورتِّلي حولَ بيتِ الحُزْنِ أُغنيةً","تجلُو عن النَّفسِ أَحوانَ الأَحايينِ",4,"ن",1,0],["وَرُتَّةٌ تَحتَ غُنَّةٍ قَذُرَت","مِن هالِكِ الراءِ دامِرِ الأَلِفِ",5,"ف",1,0],["وَرَتَّلَ مِن شِعري نَسيباً مُنَقَّحاً","يَكادُ يُعيرُ الراحَ سُكراً وَيوشَكُ",6,"ك",1,0],["ورتمين على طوغيتِ بيتٍ","أبيض ٍ ملءُ قلبه لظلمءُ...",7,"ا",1,0],["ورتحوا بِحزنٍ ليسَ فيهمْ نبيهمْ","وقدْ وهنتْ منهمْ ظهورٌ، وأعضدُ",8,"د",1,0],["ورِتاجُ صَرحِ الموتِ دونهما","وسورٌ لا يُهَدُّ",9,"د",1,0],["ورتبته الدنيا لديه لأنه","من تابعيه في الأمور الظواهر",10,"ر",1,0],["ورتلَ مما شجاهُ الحمامُ","أفانينَ شجوٍ بأفنانها",11,"ن",3,0],["ورتبته يعلو السماك محلها","وطائره الميمون يسمو على النسر",12,"ر",1,0],["وَرُتْبَةُ مَنْ لَمْ يجْعَلِ الْحَظَّ وَحْدَهُ","طَرِيقاً إِلى الْعالِي مِنَ الرُّتَبِ الشُّمِّ",13,"م",1,0],["وَرَتَّبَتِ الأَقدارُ قَدرَكَ أَوَّلاً","كَما جاءَنا التَرتيبُ في لَيلَةِ القَدرِ",14,"ر",1,0],["ورتب الكل لا","تقع في المبطلات",15,"ت",1,0],["ورتَّبته فَوقَ السَموات رُتبَةً","فَلَم يَبقَ في جودٍ لغيركَ مَطمَعا",16,"ع",2,0],["ورتعت في اليت الحسيني مانعا","عنهم سواك لتحكم الإقليما",17,"م",2,0],["ورتِّلْ كتابَك وغادرْ كتابَنا","فما كنت مؤمناً ولا عربيّا",18,"ي",2,0],["وَرَتَّبُوا الأَطْرافَ مِنْ","خَلْفِ الْقُرَى والْمُدُنِ",19,"ن",1,0],["ورُتْبَةٌ ما فوقها رُتْبَةٌ","لأَنَّها أَعْلَى مِنَ الفَرْقَدِ",20,"د",1,0],["وَرتبتُهُ العُليا بِهِ قَد تَشرَّفت","وَلاحَت تُهنّيها لَديهِ الكَواكب",21,"ب",1,0],["ورتبتي في هوى الغيد الحسانِ سمتْ","حتّى بدتْ للورى من دونها الرُّتَبُ",22,"ب",1,0],["ورت بك زند المكرمات كما خبت","بنجلك نار الكيد من ضدك الوغد",23,"د",1,0],["ورتل كلام الله وأنس بذكره","فإن كلام الله أجمل مؤنس",24,"س",1,0],["ورتل القرآن وكن طائعا","فإن في القرآن نيل المرام",25,"م",1,0],["ورتل الذكر آناء النهار وقف","بباب مولى الموالي واهجر الحلما",26,"م",2,0],["ورتَّبتُ القصيد لأجل (زايد)","أمجِّد فيه ما فيه بشعري",27,"ر",2,0],["ورتب الأحقّ في اتصاله","وقدّمن ما شئت في انفصاله",28,"ه",1,0],["ورتّعنا في حدائقه","فحمدنا الظَّلَّ والثَمَرا",29,"ر",2,0],["ورُتعْت بيْنَ الغانيات مقَبِّلاً","وردَ الخدودُ مُعَضْعِضاً تُفَّاحَها",30,"ح",3,0],["ور توارثه جدودٌ شأنها","شنأ الخيانة واجتنابُ المنكر",31,"ر",1,0],["ورتعت في فلواته","وعلوت مرتقياً أكامه",32,"م",2,0],["وَرُتْبَةَ الوُسْطَى مِنَ العِقْدِ العَلِي","وَجْهُكَ بالإحْسانِ والحُسْنِ مَلِي",33,"ل",2,0],["ورتلي حمد اسماعيل إن له","عليك خير يدٍ من خير معوان",34,"ن",1,0],["ورتّب الظهّار والتّمتّعا","والقتل كلّ في اليمين اجتمعا",35,"ع",2,0],["ورتبتي في الإلاهيات يعلمها","ما نالها أحدٌ قبلي من العربِ",36,"ب",1,0],["ورتب العلم إذ يناجي","سرك بالسرِّ في الهوادي",37,"د",2,0],["ورتبةَ أزميرَ ازدهت وتشرفت","بمن حمدُهُ فرضٌ علينا وشكرُهُ",38,"ر",2,0],["وَرَّت إِلْيِهْ في الحشا عِلّي","الذخاتر ما يرومونه",39,"ن",2,0],["وَرَتِّب لَهَا النَّتخَاتِ مِن أرضِ فَرتَكٍ","إذا جِيتَهُ عِندَ الغروبِ فَحاذِر",40,"ر",1,0],["وَرَتَّبَ أبدَالاً على نَتَخَاتكُم","عَلَى العَكسِ لَم يَحظَى بِهَا كُلُّ طَالِبِ",41,"ب",1,0],["وَرَتَّبَ نَتخَاتِ البُرُورِ وَبَلدَهَا","بِهَادِيَةٍ تَهدي المَلاَ في الغَيَاهِبِ",41,"ب",1,0],["وَرَتَّبِ المَجرَى مَعَ القِيَاس","في نَتخَةٍ البرِّ فَكُن ذا بَاسِ",42,"س",1,0],["ورتلي آية الشكر الجميل على","مولى برحماه بعد الموت أحياك",43,"ك",1,0],["ورتبة زاك في المعالي فأرخا","قلادة عز في الورى زانها صدر",44,"ر",1,0],["وَرتَّبتُهُ بِالعَقلِ وَاختَرتُ لَفظهُ","وَمَثَّلتُهُ كَي يُستفادَ بِإِيقاضِ",45,"ض",1,0],["وَرَتَّلَ القَومُ أُوصَنّا فَواطَرَبا","وَلَوَّحَت بِكرابِ النَخلِ كُهّالُ",46,"ل",1,0],["ورتبة أنت فيها أنه أزلاً","في رتبة غيرها فاكشف عن الرتب",47,"ب",1,0],["وَرَتّب الناس عَلى البُروج","وَما تَرى في السور مِن فُروجِ",48,"ج",1,0],["ورَتِّل حديثَ الحب يَا سعد إنني","لقد عَزَّني سعدُ التجلدُ والصبر",49,"ر",1,0],["ورتّبِ المقدّمات وانظرا","صحيحها من فاسد مختبرا",50,"ر",2,0],["ورتبة نعمة المهداة جوهرة","لو لم ينلها الذي من دونها حسبا",51,"ب",2,0],["ورَتقُ الفتوق وفتقُ الرتوقِ","ونقض الأمور وإبرامها",52,"م",3,0],["وَرَتِّبَنَّ الفَضلَ فِيمَا بَينَهُم","عَلَى خِلاَفَةٍ وَقَدِّم عَينَهُمُ",53,"م",1,0],["ورتَعْنا مِن المُنَى في رياضٍ","وسكناً مِن المغاني جِنَانا",54,"ن",2,0],["ورتب ديوان إِجلاله","وكلَّ أكف الدعا ناشر",55,"ر",1,0],["ورتلت آيات نعت جدَّه","فاهتز مرتاحا إلى أن قد غفا",56,"ا",1,0],["ورتب ضريحي كيفما شاءه الهوى","تكون أمامي أو أكون أمامها",57,"م",3,0],["ورت بنشر الشعر نقطة خالها","فغدا الشذى يهدي المحب الغائبا",58,"ب",2,0],["وَرَتْقٍ عَلَى فَتْقٍ وَكَشْفٍ عَلَى عَمَىً","وَوَصْلٍ عَلَى فَصْلٍ لِصَدْعٍ طَوَى شَعْبَا",59,"ب",2,0],["ورتقتُ من خيطِ السنا","ثوبَ الثريّا من شبابكْ",60,"ك",1,0],["وَرَتَعْتُ فِي زَهْرِ التَّصابِي وَالهَوَى","وَرَعَيْتُ شِيحَ اللَّهْوِ وَالقَيْصُوما",61,"م",2,0],["ورتَّلَ سورةَ الأشواقِ سِرًّا","وجَهرًا ثمّ ودّعني وولَّى",62,"ل",2,0],["ورتلت الطلاسم في حروفي","فجف الشعر في السطر الأخيرِ",63,"ر",1,0],["ورتق فتق الجهل وانجاب حكمه","وسلسلت الأنوار فوق البسيطتي",64,"ت",2,0],["ورتني الظلم والإنصاف","تقسى عليّه بحنيّه",65,"ي",2,0],["وَرَتعتُ في أَرجائِكَ","الفَيحاءِ تَخفُقُ رايَتي",66,"ت",2,0],["ورتَّلَتْ خصبها في كلّ سنبلةٍ","لكنَّهُ قاحلٌ في سمعهِ صممُ",67,"م",1,0],["ورتبتُ أسرار العناقيد ، لا انتهت","إليها لذاذاتي ، ولا اهتزّ معبدُ",68,"د",1,0],["ورتبتهُ فوق السماوات رتبة ً","فلم تبق في جود لغيركَ مطمعا",69,"ع",2,0],["ورتل من المخبرين العتاة","يعربد في كل بيتٍ وحارة",70,"ر",2,0]]}