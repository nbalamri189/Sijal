{"poems":[[88,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[37,"ورت بك عيدان المكارم كلها","https://www.aldiwan.net/poem7163.html","الطويل"],[72,"بكى الشعر أيام المنى والمنائح","https://www.aldiwan.net/poem18477.html","الطويل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[92,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[66,"الجيش الحيا في مأقظ الروض معرك","https://www.aldiwan.net/poem39076.html","الطويل"],[104,"شهداء","https://www.aldiwan.net/poem26158.html","عموديه"],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[129,"يا صاح ما لك لا ترد","https://www.aldiwan.net/poem67453.html","مجزوء الكامل"],[160,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[199,"صبا للقصور وغزلانها","https://www.aldiwan.net/poem45545.html","المتقارب"],[210,"أماني الهنا بالحمد وافت وبالشكر","https://www.aldiwan.net/poem13524.html","الطويل"],[280,"أيا بين ما سلطت إلا على ظلمي","https://www.aldiwan.net/poem60729.html","الطويل"],[366,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[391,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[406,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[505,"المُقنَّع","https://www.aldiwan.net/poem27796.html","الطويل"],[529,"قل لإمام الزمن","https://www.aldiwan.net/poem37130.html","الرجز"],[575,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"]],"verses":[["ورتّبها فهي معروضة","لمن يتناولها من كتب",0,"ب",1,0],["ورت بك عيدان المكارم كلها","وأورق عودي في ثراك وأنضرا",1,"ر",2,1],["ورتل من أسلافه سوَرَ العلى","خواتمها موصولة بالفواتح",2,"ح",1,0],["ورتبة في الأفقِ قد رجَحت","من قبل أن يرصد ميزانه",3,"ن",2,0],["ورتِّلي حولَ بيتِ الحُزْنِ أُغنيةً","تجلُو عن النَّفسِ أَحوانَ الأَحايينِ",4,"ن",1,0],["وَرُتَّةٌ تَحتَ غُنَّةٍ قَذُرَت","مِن هالِكِ الراءِ دامِرِ الأَلِفِ",5,"ف",1,0],["وَرَتَّلَ مِن شِعري نَسيباً مُنَقَّحاً","يَكادُ يُعيرُ الراحَ سُكراً وَيوشَكُ",6,"ك",1,0],["ورتمين على طوغيتِ بيتٍ","أبيض ٍ ملءُ قلبه لظلمءُ...",7,"ا",1,0],["ورتحوا بِحزنٍ ليسَ فيهمْ نبيهمْ","وقدْ وهنتْ منهمْ ظهورٌ، وأعضدُ",8,"د",1,0],["ورِتاجُ صَرحِ الموتِ دونهما","وسورٌ لا يُهَدُّ",9,"د",1,0],["ورتبته الدنيا لديه لأنه","من تابعيه في الأمور الظواهر",10,"ر",1,0],["ورتلَ مما شجاهُ الحمامُ","أفانينَ شجوٍ بأفنانها",11,"ن",3,0],["ورتبته يعلو السماك محلها","وطائره الميمون يسمو على النسر",12,"ر",1,0],["وَرُتْبَةُ مَنْ لَمْ يجْعَلِ الْحَظَّ وَحْدَهُ","طَرِيقاً إِلى الْعالِي مِنَ الرُّتَبِ الشُّمِّ",13,"م",1,0],["وَرَتَّبَتِ الأَقدارُ قَدرَكَ أَوَّلاً","كَما جاءَنا التَرتيبُ في لَيلَةِ القَدرِ",14,"ر",1,0],["ورتب الكل لا","تقع في المبطلات",15,"ت",1,0],["ورتَّبته فَوقَ السَموات رُتبَةً","فَلَم يَبقَ في جودٍ لغيركَ مَطمَعا",16,"ع",2,0],["ورتعت في اليت الحسيني مانعا","عنهم سواك لتحكم الإقليما",17,"م",2,0],["ورتِّلْ كتابَك وغادرْ كتابَنا","فما كنت مؤمناً ولا عربيّا",18,"ي",2,0],["وَرَتَّبُوا الأَطْرافَ مِنْ","خَلْفِ الْقُرَى والْمُدُنِ",19,"ن",1,0],["ورُتْبَةٌ ما فوقها رُتْبَةٌ","لأَنَّها أَعْلَى مِنَ الفَرْقَدِ",20,"د",1,0]]}