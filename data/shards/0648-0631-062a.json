{"poems":[[88,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[37,"ورت بك عيدان المكارم كلها","https://www.aldiwan.net/poem7163.html","الطويل"],[72,"بكى الشعر أيام المنى والمنائح","https://www.aldiwan.net/poem18477.html","الطويل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[92,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[66,"الجيش الحيا في مأقظ الروض معرك","https://www.aldiwan.net/poem39076.html","الطويل"],[104,"شهداء","https://www.aldiwan.net/poem26158.html","عموديه"],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""]],"verses":[["ورتّبها فهي معروضة","لمن يتناولها من كتب",0,"ب",1,0],["ورت بك عيدان المكارم كلها","وأورق عودي في ثراك وأنضرا",1,"ر",2,1],["ورتل من أسلافه سوَرَ العلى","خواتمها موصولة بالفواتح",2,"ح",1,0],["ورتبة في الأفقِ قد رجَحت","من قبل أن يرصد ميزانه",3,"ن",2,0],["ورتِّلي حولَ بيتِ الحُزْنِ أُغنيةً","تجلُو عن النَّفسِ أَحوانَ الأَحايينِ",4,"ن",1,0],["وَرُتَّةٌ تَحتَ غُنَّةٍ قَذُرَت","مِن هالِكِ الراءِ دامِرِ الأَلِفِ",5,"ف",1,0],["وَرَتَّلَ مِن شِعري نَسيباً مُنَقَّحاً","يَكادُ يُعيرُ الراحَ سُكراً وَيوشَكُ",6,"ك",1,0],["ورتمين على طوغيتِ بيتٍ","أبيض ٍ ملءُ قلبه لظلمءُ...",7,"ا",1,0],["ورتحوا بِحزنٍ ليسَ فيهمْ نبيهمْ","وقدْ وهنتْ منهمْ ظهورٌ، وأعضدُ",8,"د",1,0]]}