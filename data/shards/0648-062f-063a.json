{"poems":[[96,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[234,"لو تقصيت وصف شوقي وتوقي","https://www.aldiwan.net/poem50809.html","الخفيف"],[2084,"","https://poetry.dctabudhabi.ae/diwan/poem/146128","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131067",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[5408,"أدر كأسا","https://www.poetsgate.com/ViewPoem.aspx?id=190870",""],[5411,"شَعائِر الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=185729",""]],"verses":[["ودغدغته فللأغصان هيمنة","كأنّها بثّ غيران لغيران",0,"ن",1,0],["وُدُّ غَيْري تصنُّعٌ ورِياءٌ","وهَواه بشاشةٌ وسَلامُ",1,"م",1,0],["ودغدغ الكأس فإني امرؤٌ","يعجبني دغدغةُ الكاسِ",2,"س",1,0],["ود غيري دوام عصر شباب","حينما جئت استحث المشيبا",3,"ب",2,0],["ودغدغ من شغفٍ ثديها","وحدث عن وجده مسهبا",4,"ب",2,0],["ودغدغ لي مشاوير الحكايا","وكان ببرجه العاجي عصيّا",5,"ي",2,0],["وَدَغْدَغَتْ نارُ آهاتي رُؤى فِكْري","وَصاغَ حَرفي بِجُرْفِ الرَمْلِ مَنْ راحوا",6,"ح",3,0]]}