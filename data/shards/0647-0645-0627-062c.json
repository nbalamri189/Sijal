{"poems":[[55,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[30,"ليس أب كحنظلة بن رعد","https://www.aldiwan.net/poem5153.html","الوافر"],[30,"وكانت أثافي قدرنا رأس بعلها","https://www.aldiwan.net/poem5347.html","الطويل"],[107,"خفوا يلاقون النبي بيثرب","https://www.aldiwan.net/poem44019.html","الكامل"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8329","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55190","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[519,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[520,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39114","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136164","الطويل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17659","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69385","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89548","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121017","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67253","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205073","المنسرح"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74206","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100814","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100188","البسيط"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20559","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131083",""],[5751,"نَهارُ عينَيك","https://www.poetsgate.com/ViewPoem.aspx?id=215014",""],[6019,"هُما جميلان","https://www.poetsgate.com/ViewPoem.aspx?id=176595",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""]],"verses":[["هُم أُجلِسوا عَلى الصِفاحِ وَالذُرى","إِذ رَضِيَ القَومُ بِما تَحتَ الثَفَن",0,"ن",1,0],["هُما جَبَلانِ جارُهُما مَنيعٌ","إِذا ما أَعطَيا عَقدَ الجِوارِ",1,"ر",1,0],["هُما جَبَلا اللَهِ اللَذانِ ذُراهُما","مَعَ النَجمِ في أَعلى السَماءِ المُحَلِّقِ",2,"ق",1,0],["هُمْ أجْرَمُوا فَهُوَ الجزاءُ وَهكذا","يُجْفَى ويُجْتَنَبُ المُسِيءُ المجرِمُ",3,"م",1,0],["هُما جُرِّبا قَبلَ الجِيادِ وَقُلِّدا","فَأَيَّهُما أَشبَهتَ كُنتَ المُقَلِّدا",4,"د",2,0],["هُما جَرَّدا أُمُّ الحُسَينِ وَأَوقَعا","أَمَرَّ وَأَدهى مِن وَقيعَةِ سالِمِ",5,"م",1,0],["هُمَا جنَاحَانِ لِي وَالقَلْبُ بَيْنَهُمَا","يَغُزُو الأمانِي جَوَّالاً وَصوَّالاَ",6,"ل",2,0],["هم أجدبوا سوحهم من وفرهم","وهم لأرض الله غيث وحيا",7,"ا",1,0],["هُم أَجَلُّ الحُكّام في دولةِ الإس","لامِ والجاهليّةِ الجَهْلاء",8,"ا",2,0],["همُ اِجتمعوا على قتْلي بجمعٍ","ففيمَ على المنازِلِ فرّقوني",9,"ن",2,0],["هما جمعا ضغثاً كثيراً ومنيا","نفوسهما منهم بأضغاث حالم",10,"م",1,0],["هُمْ أجالُوا لِحاظَهُمْ فِيهِ حتَّى","نَفَضتْ فِيهِ صِبْغَها الأحداقُ",11,"ق",1,0],["هما جامعا وصف الوراثة كاملا","هما حايزا سر المحبة الود",12,"د",1,0],["هُما جارَتايَ لا تَعودانِ هالِكاً","عَلى سَفَرٍ فَكُلُّ حَيٍّ يَطاهُما",13,"م",2,0],["هُما جانِبا ثَغرٍ إِذا مالَ مِنهُما","إِلى السَلمِ جَنبٌ مالَ مِن بَعدِهِ جَنب",14,"ب",1,0],["هُمُ أَجاروا عَلى كِسرى طَريدَتَهُ","لَمّا تَبَرَّأَ مِنها كُلُّ شَحشاحِ",15,"ح",1,0],["هما جميعاً من بني النجار","والأفضلُ أصلٌ في حنين الجذعِ",16,"ع",1,0],["هما جَرحا حَشايَ بغيرِ ذنبٍ","وكانَ كلاهما لي قاتلين",17,"ن",1,0],["هما جوازاي في الغداة متى","رمت دخولا لهيئة الأمم",18,"م",1,0],["هُما جَنحا للرشد في كُل مَوطن","فَكُل فَتى يُدعى بِحَقٍّ رَشيدها",19,"د",3,0],["هم أججوا بيد التعسف فتنة","حفروا لهم في جوفها اخدودا",20,"د",2,0],["هم اجمعوا أمرهم والليل منسدل","على الكماة فلا عين لمرتقب",21,"ب",1,0],["هما جوادا رهان للعلى جريا","في حلبة دونها العيوق قد ضلعا",22,"ع",2,0],["هما جميعا كفّة الميزان","وبيد العقرب يعرفان",23,"ن",1,0],["هُما جارَتاكَ اليَومَ شَطَّت نواهُما","وأَصبَحَ يُبكى ذا الهَوى طَلَلاهُما",24,"م",2,1],["هما جرحا قلبي المبتلى","وما عوقبا وهما جانيان",25,"ن",1,0],["هما جناحايَ تحليقي بسِحرِهِما","يا (بَعَدْ گلبي) يُداوي الرُّوحَ والبَدَنا",26,"ن",2,0],["هما جميلان .. تحتَ الضِّلعِ مُذ سَكَنَا","وصيّرا القلبَ من تِحنانِهِ وَطَنَا",27,"ن",2,1],["هُم أجادوا تأليفَ فكرٍ جديدٍ","قل : أجادوا مع الصَّفاقةِ جَمْعَهْ",28,"ع",2,0]]}