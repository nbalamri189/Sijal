َيَبني مَجدَهُ","بِكَرائِمِ الأَنقاضِ وَالأُشَلاءِ",5,"ا",2,0],["مِن كُلِّ هَيفاءِ المَعاطِفِ قُوِّمَت","قَدّاً كَقَدِّ الصَعدَةِ السَمراءِ",6,"ا",2,0],["مِن كُلِّ هَيفاءِ الكَلامِ رَشيقَةٍ","في طَيِّها مَعنىً أَدَقُّ وَأَرشَقُ",7,"ق",1,0],["مِن كُلِّ هَيفاءَ غُلاميّةٍ","مُلْتَبِسٌ بالغُصْنِ منها القَوَام",8,"م",1,0],["مِن كُلِّ هَضبَةِ سُؤدُدٍ هَزَّ النَدى","أَعطافَهُ طَرَباً فَسالَ سَماحا",9,"ح",2,0],["مِنْ كُلِّ هَيْفَاءَ كَخُوطِ الْقَنَا","بِلَحْظَةٍ كَاللَّهْذَمِ الأَزْرَقِ",10,"ق",1,0],["من كلِّ هيفاءَ كان الخدرُ يحجبها","إن أسفرَ النجمُ في الظلماءِ والقمر",11,"ر",1,0],["من كل هاوٍ بُرجُه وكأنَّة","قَمَرٌ على كَبِدِ السَماءِ تَمام",12,"م",1,0],["من كل هَتْرٍ إذا غنى الرواة ُ بها","أصحى لها شعراء الناس قد ضَمَزوا",13,"ز",3,0],["من كل هَيّ ابن بي لا ثباتَ له","جَعْد اليدين قَئول غير مِفعال",14,"ل",1,0],["من كل هيفاء كالغصن الرطيب على","حقف يؤلف بين الصبح والفسق",15,"ق",1,0],["مِن كُلّ هَيفاءِ المَعاطف كُلَّما","قامَت تُجاذب ردفَها وَقَوامها",16,"م",3,0],["مِن كُلّ هَيفاءَ وَطفاء الجُفون إِذا","رنت جَعلت فُؤادي نَحوَها هَدَفا",17,"ف",2,0],["من كل هوجاء لها جوف هبل","ظلت ينهي البردان تغتسل",18,"ل",1,1],["من كل هذا وهذا أستمد غنى","كأنما نظراتي لوح فنان",19,"ن",1,0],["من كلِّ هيفاءَ إلا الرِّدفَ تحسبهُ","غصناً من البان معقوداً بجلُمودِ",20,"د",1,0],["من كل هيفاء ثنت رداءها","على قضيب البان من غيرانها",21,"ن",3,0],["من كلّ هامةِ شامخٍ","لاث العمامة كالغمامة",22,"م",2,0],["من كل هوجاء السُّرى وخَّادة ال","غدوات قاطعة الفلاة أمونها",23,"ن",3,0],["مِن كُلِّ هِملاجٍ لِحافِرِهِ","في شَعبِ كُلِّ مُلِمَّةٍ صَدعُ",24,"ع",1,0],["مِن كلَّ هيفاءَ يُعيرُ قدُّها ال","غصنَ إذا ما خطرتْ قواما",25,"م",2,0],["مِن كلِّ هيفاءَ ما مالتْ ولا خطرتْ","اِلاّ أغارتْ غصونَ البانِ بالمَيَلِ",26,"ل",1,0],["من كلِّ هوجاءَ كالسِّرحان عاديةٍ","كأنّما مسّها في الرَّوْعِ شيطانُ",27,"ن",1,0],["مِن كُلِّ هَرّاجٍ نَبيلٍ مَحزِمُه","رابي المَعَدَّينِ أَسيلٍ مَلطَمُه",28,"م",2,0],["مِن كُلِّ هَيفاءَ قَد قامَت عَلى سُرُرٍ","مَرفوعَةٍ مِن زَبَرجَدٍ عَلى عَمَدِ",29,"د",1,0],["من كلّ هاضبةٍ تألّف برقُها","فأتتك تتبع عينها أبكارها",30,"ر",3,0],["مِن كُلِّ هَفهافِ العنانِ كَأَنَّهُ","نَفسُ المشوقِ تَعاوَرَتهُ اللُوَّمُ",31,"م",1,0],["من كلِّ هيفاءَ إلا فضلةٌ ثَقُلَتْ","عن الوِشَاحِ فلم يَنْهَضْ بها الهَيَف",32,"ف",1,0],["مِن كُلِّ هَيفاءَ مَصقُولٍ تَرائِبُها","في طَرفِها صارِمٌ لِلمَوتِ مَصقُول",33,"ل",1,0],["من كلِّ هيفاء إذا ما بدت","تختال أذرت بغصون النَّقا",34,"ا",1,0],["من كل همازٍ طفا شرهُ","نغترف البأساء من بحره",35,"ر",2,0],["من كل هيفاء هضيم الحشا","رود الصبا طيبة الملتثم",36,"م",1,0],["من كل هيفاء يهوى الحسن غرّتها","يصادف الودّ تكميلاً وخالصه",37,"ص",2,0],["مِن كُل هَولٍ بَعضُهُ","لَو يَلتقي رَضوى يَميد",38,"د",1,0],["من كل هيفاءٍ قطوف الخطى","مكحولة الألحاظ بالسحر",39,"ر",1,0],["من كل هندي وكل يماني","ما للسيوف فضيلة لكنها",40,"ه",2,0],["مِنْ كُلِّ هَيْفاءَ نَشْوَى العَطْفِ تَرْقُصُ مَعْ","غُصْنٍ منَ البانِ ساهِي الطَرْفِ ذِي هَيَفِ",41,"ف",1,0],["من كل هم نازل","عذابه أضحى صعد",42,"د",1,0],["من كل هفهاف القميص بأنفه","شمم سوى روح الأبي لم يشمم",43,"م",1,0],["من كلَ هيفاءَ إلا الردفَ تحسبهُ","غصنا من البان معقودا بجملودِ",44,"د",1,0]]}