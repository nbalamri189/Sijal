ewPoem.aspx?id=205646",""],[4960,"عَودةُ كعب","https://www.poetsgate.com/ViewPoem.aspx?id=210399",""],[2177,"هما العلمان بالزوراء لاحا","https://www.poetsgate.com/ViewPoem.aspx?id=127085",""],[585,"أجل إنه الفجر الذي أنت آمله","https://www.poetsgate.com/ViewPoem.aspx?id=161921",""],[5145,"وزير المليك ورثت البقاءا","https://www.poetsgate.com/ViewPoem.aspx?id=108059",""],[5183,"قالا","https://www.poetsgate.com/ViewPoem.aspx?id=186483",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5190,"العكاز","https://www.poetsgate.com/ViewPoem.aspx?id=153354",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5452,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=112743",""],[5458,"الحب قوة","https://www.poetsgate.com/ViewPoem.aspx?id=71979",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[5688,"إذا ما القلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208900",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6070,"إذا ما كنتَ تَرغَبُ في النَّجاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=191615",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""]],"verses":[["هُما البازِلانِ المُقرَمانِ تَناوَبا","عُرى المَجدِ لَمّا عَجَّ بِالعِبءِ لاهِثُ",0,"ث",1,0],["هُمُ اأُسدُ عِندَ البَأسِ وَالحَشدُ في القِرى","وَهُم عِندَ عَقدِ الجارِ يَوفون بِالذِمَم",1,"م",1,0],["هُما اِقتَسَما العَمى نِصفَينِ قَدراً","كَما اِقتَسَما قَضاءَ الجانِبَينِ",2,"ن",1,0],["هُما الحَيّانِ إِن فَزِعا يَطيرا","إِلى جُردٍ كَأَمثالِ السَعالي",3,"ل",2,0],["هُما اِستَنفَذاهُ بَعدَما شابَ رَأسُهُ","بِدَهرٍ حَذارَ العارِ أَو سُبَّةِ الدَهرِ",4,"ر",1,0],["هما أمران مكروهان فاخترْ","طَويقَ السهل واجتنب الدروّا",5,"و",2,0],["هما الطرفان العارمانِ كلاهما","سواءٌ على من كان غيران حاميا",6,"ي",2,0],["هُما أَخَوانِ يَصطَلِيانِ ناراً","رِداءُ المَوتِ بَينَهُما جَديدُ",7,"د",1,0],["هُما أَخَوانِ مِن غَنِيٍّ وَأَعصُرٍ","فَكَيفَ يُعَزّى عِندَ ذاكَ جَليدُ",8,"د",1,0],["هُما اِثنانِ دانٍ في التَغَرُّبِ آمِنٌ","وَناءٍ عَلى قُربِ الدِيارِ مُروَعُ",9,"ع",1,0],["هُما الأَطيَبانِ الأَكثَرانِ تَلاقَيا","إِلى حَسَبٍ عِندَ السَماءِ قَديمِ",10,"م",1,0],["هُما أَمرانِ يوضِحُ عَنهُما لي","كِتابي حينَ أَنظُرُ في كِتابي",11,"ب",2,0],["هُما اللَذانِ غَمَرا لي جانِبا","يا سَعدُ باكِر فَاللَبيبُ مَن بَكَر",12,"ر",1,0],["هُما اللَذانِ عَمَّرا","لي جانِباً مِنَ الرَجا",13,"ا",1,0],["هُما أَظلَما حالَيَّ ثُمَّتَ أَجلَيا","ظَلامَيهِما عَن وَجهِ أَمرَدَ أَشيَبِ",14,"ب",1,0],["هُما أَخوا العِزِّ الَّذي دونَ شَأوِهِ","تَخِرُّ الصَياصي خُشَّعاً وَالمَخارِمُ",15,"م",1,0],["هُما الذُخرُ لِلأَوطانِ إِن جَلَّ حادِثٌ","فَضاقَت بِهِ ذَرعاً وَأَعوزَها الذُخرُ",16,"ر",1,0],["هُما أسلما لما بَدَا الحقُّ واضحاً","وللحقِّ نورٌ للعَمَايَةِ صادعُ",17,"ع",1,0],["هما أزمعا أن يأخذا اللّيثَ خادِراً","على غِرَّةٍ والجهلُ يُعمِي البصائرا",18,"ر",2,0],["هما استَبَقَا نُفوسَ القومِ نَهباً","ورُوحُ اللَّهِ بينهما رَسِيلُ",19,"ل",1,0],["هُما أَنصَفاني قَبلُ إِذ أَنا ناشِئٌ","وَقَد صارَعاني بَعدُ أَيَّ صِراعِ",20,"ع",1,0],["هُما أَقاما عَصا الإِسلامِ وَاِرتَجَعا","أَعوادَ أَحمَدَ مِن شَرقٍ وَأَعوادِ",21,"د",1,0],["هُما أَنَّباني أَن نَعِمتُ بِبَدرَةٍ","وَما مِنهُما إِلّا لَئيمٌ مُؤَنَّبُ",22,"ب",1,0],["هُما الفَتَيانِ اِستَولَيا بِتَعاقُبٍ","وَما لَهُما لُبٌّ فَكَيفَ يَشُطّانِ",23,"ن",1,0],["هُما العَبْدانِ إنْ بَغَياكَ غَدْراً","فما فَعَلا إبَاقٌ أو دِفانُ",24,"ن",1,0],["هُما أَورَداني المَوتَ عَمداً وَجَرَّدا","عَلى الغَدرِ خَيلاً ما تَمَلُّ مِنَ الرَكضِ",25,"ض",1,0],["هما الحبُّ والإِيمانُ والمجدُ والنّدى","تمثّلَ في آياتها ملكانِ",26,"ن",1,0],["هما النقيضان -في ديوانك اجتمعا-:","فكْرُ الأواخر، في ديباجة الأُول",27,"ل",1,0],["هما أمران مكروهان فاخترْ","طَريقَ السهل واجتنب الدروّا",28,"و",2,0],["هما أثيران علّاتي على ظمأ","وبالشراب على سرى يغوصان",29,"ن",1,0],["هما الأحبة لي إن خانني زمن","أسلتُ جرحي إن عزّ المداوونا",30,"ن",2,0],["هُما أَخَوانِ كَعَظمِ اليَمين","أَمرّا عَلَينا بِعقدِ الكَرب",31,"ب",1,0],["هُما أَغمَزا لِلقَومِ في أَخَوَيهِما","فَقَد أَصبَحا مِنهُم أَكُفُّهُما صِفرُ",32,"ر",1,0],["هُما أَشرَكا في المَجدِ مَن لا أَبا لَهُ","مِنَ الناسِ إِلّا أن يُرَسَّ لَهُ ذِكرُ",32,"ر",1,0],["هُما أَنعَما قَبلَ السُؤالِ وَأَجزَلا","فَأَعظِم بِمَتبوعٍ وَأَكرِم بِتابِعِ",33,"ع",1,0],["هُما اللَذانِ أَثبَتا لي أَملاً","قَد وَقَفَ اليَأسُ بِهِ عَلى شَفا",34,"ا",1,0],["هُما اللَذانِ سَمَوا بِناظِري","مِن بَعدِ إِغضائي عَلى لَذعِ القَذى",34,"ا",1,0],["هُما اللَذانِ عَمَّرا لي جانِباً","مِنَ الرَجاءِ كانَ قِدماً قَد عَفا",34,"ا",1,0],["هُمَا اقتَادَتَا لُبِّى جَنِيباً وَلَم يَكُن","لِمَن لاَ يُجازِى بِالمَوَدَّةِ يَجنُبُ",35,"ب",1,0],["هُما الدينُ والدُنيا كميزانِ تاجرٍ","إِذا اِنحطّ منهُ كفّةٌ عَلتِ الأخرى",36,"ر",2,0],["هما اسمان شُقَّا من علاً ومحامدٍ","رأوا فيكما منها قديماً مخائلا",37,"ل",2,0],["هُما أَخَوانِ ودُّهُما صَحيحٌ","إِذا شابَ المَوَدّاتِ السَقامُ",38,"م",1,0],["هُما الفَرقدانِ الهاديانِ لقطبها","فَمن بهما لَم يَستبن نَهجها أخطا",39,"ط",2,0],["هما النيران الطالعان على الهدى","بآياتفتح شأنهن عجيب",40,"ب",1,0],["هُما أَنشآه طبق ما اِقتَرح المنى","فَأَصبَح نَفعاً لِلدِيار عَميما",41,"م",2,0],["هُما الشاهِدانِ بِأَنَّ العَلاءَ","إِلَيكَ اِنتَهى وَالزَمانُ الحَكَم",42,"م",1,0],["هُما اِثنانِ ما لَهُما ثالِثٌ","إِذا ما عَدَدتَ كِبارَ النِعَم",42,"م",1,0],["هما اللّذانِ إذا مالا على أُمَمٍ","لم يُبْقِ مَرُّهما شيئاً ولم يَذَر",43,"ر",1,0],["هُما اللَّتانِ إذا ولَّى الزَّمانُ بما","أهواهُ عوَّضَتاني مِنه أَزمانا",44,"ن",2,0],["هما اللذانِ به دانَ الوَرى لهما","بلا خلافٍ من القاصي أو الداني",45,"ن",2,0],["هُما ألبساني عنك ثوبَ تصبُّرٍ","وأعلاقُ وجْدي باقياتٍ كما هيا",46,"ي",2,0],["هما الولدان من صلةٍ وبِرٍّ","إذا ولدت من الناس العُقوقا",47,"ق",2,0],["هما الشمس زفَّت في الدياجي إلى البدرِ","أو الصبحُ وافى مطلعَ الأنجمُ الزُّهرِ",48,"ر",1,1],["هما أسدا غيل وغثيا غمامة","وسيفان لا ذما من النقع صقيلا",49,"ل",2,0],["هما أليفا هوى هذا فراقهما","ما عن رضّى فارق الإنسان من ألفا",50,"ف",2,0],["هما أخوا أيوب والملك الذي","أتى بهما تلواً له وهو بكره",51,"ر",2,0],["هما الضدان في الأشياء آلا","إليه فأشبها في الكشف آلا",52,"ل",2,1],["هما الإسم والذات من غير مين","وراياتك الحمر في الخافقين",53,"ن",1,0],["هما الكثيفان والسر اللطيف له","علاقة بهما فيها التفاتات",54,"ت",1,0],["هما إحاطتان بالأشياءِ","إحاطة العلم بلا اختفاءِ",55,"ا",2,1],["هما الأميرانِ من قومٍ إمارَتُهُم","من عَهْدِ عادٍ ومَن مِن قبلهِ عُهِدُوا",56,"د",3,0],["هُما القَمَرانِ في أكنافِ أَرضٍ","يَغارُ النَجْمُ منها في سَماهُ",57,"ا",2,0],["هُما النيلانِ من ذَهبٍ وماءٍ","قَدِ اجتَمعَا فَلْيسَ تَخافُ مَحْلا",58,"ل",2,0],["هما أخَوان ذا هادٍ إلى ذا","وذا فينا لأُمّته نذيرُ",59,"ر",1,0],["هما الحسن الزاكي النجار وصنوه","الفتى أحمد الأفعال يعزى له الشكر",60,"ر",1,0],["هُما أخوانِ هُما توأمانِ","على قَدَرِ واحدٍ في الشَّيَم",61,"م",1,0],["هُما اِنشِقاقانِ هَذا يَوم مَولِدِهِ","وَذا بمبعثهِ الزاكي هُدىً سَلَفا",62,"ف",2,0],["هما الى اللَهِ قاما بالشّفاعةِ لي","تلطُّفاً منهما بِرّاً واحسانا",63,"ن",2,0],["هما احتلالان ِهذا ظاهرٌ أشِرٌ","وذاك َخافٍ خطاهُ اللّيل ُوَالسُدُفُ",64,"ف",1,0],["هُما الأَصغَرانِ الذائِدانِ عَنِ الفَتى","مَكارِهَهُ وَالصاحِبانِ عَلى الخَطبِ",65,"ب",1,0],["هُما أنعشاني بهجة وكرامة","كما أنت بالاحسان بلغتني الأمَلْ",66,"ل",1,0],["هما اقتسما ما حل بي وتعاهدا","على أن يكونا بين دام ودامع",67,"ع",1,0],["هُما أَعلى الورى رُتباً","هُما أوفى الوَرى ذِمما",68,"م",2,0],["هما الفرقدان الفايقان تنوّرا","على كل أقمار العلاء هما هما",69,"م",2,0],["هُما الثَقلانِ بارك اللَهُ فيهُما","وَخصَّ أَميرَ المُؤمنين مُحمّدا",70,"د",2,0],["هما اللتان وهما اللتانِ","من سقم الفقر تداويان",71,"ن",1,0],["هما اكلا ما لذ طعما ومنظرا","وقد حل سهم الموت في قلب صائم",72,"م",1,0],["هُمَا المعجِبَانِ فَأَمَّا العَجُوزُ","فَتُؤتَى النِسَاء مَعاً وَالرِّجَالا",73,"ل",2,0],["هُمَا أَخَوانِ أَمَّا ذَا فَجُورٌ","وَأَمَّا ذَا فَأَصهَبُ ذُو سِبَال",74,"ل",1,0],["هما السّيّدانِ الماجدانِ كلاهُما","تَراه رَحيبَ الباعِ أصيدَ أرْوَعا",75,"ع",2,0],["هُما اقتفيا آثارهم فاعلين مَا","همُ فعلوه حَذوك النّعلَ بالنّعلِ",76,"ل",1,0],["هُما أخوا في الحربِ مَن لا أخاً له","إِذا خافَ يوماً نبوةً فدعاهما",77,"م",2,0],["هُما الفَتَيانِ المُترَفانِ إِذا اِنقَضت","شيبَة يَومَ عادَ آخرُ ناشِيا",78,"ي",2,0],["هُما اِعتوراني نَظرَةً ثُم فِكرَة","فَما أَبقيا لي مِن رُقاد وَلا لبّ",79,"ب",1,0],["هما أبرزا زوج النبي تعمداً","يسوقُ بها الحادي المنيخ على جمل",80,"ل",1,0],["هما الجَديدان وَالدُنيا وعاؤهما","فَكَم لَها فرَّغا منا وَكَم ملآ",81,"ل",2,0],["هما اقتسما شبه الرسول تعادلا","وماذا عسى تحصيه مهما تعدد",82,"د",1,0],["هُما النَقيضان سَمعي وَالمُام فَما","تَجَمَّعا وَلَعمري طالَما اِفتَرَقا",83,"ق",2,0],["هُما الدَواءُ لِأَقوامٍ إِذا صَعَرَت","خُدودُهُم وَاِستَحَقّوا صَولَةَ الغَضَبِ",84,"ب",1,0],["هما أحرزا علياء غازي بن يوسف","وما ضيَّعَا المجد الذي هو كاسبه",85,"ب",2,0],["هما التواقيع التي أبرزت","من حضرةِ الحقِّ فلا تندموا",86,"م",3,0],["هما الحجابُ لها ولم يقم بهما","إحراقها لا ولا ما فيه من ضرر",87,"ر",1,0],["هما ألحا على نفسي فما ضمنت","لنفسها غير جمر في الحشا اشتعلا",88,"ل",2,0],["هما اقتسما العمى نصفين قداً","كما اقتسما قضاء الجانبين",89,"ن",1,0],["هُما اللذانِ منعا عبادِكَ","العارفين الأتقِيا عُبَّادَك",90,"ك",1,0],["هُما أَلبَسا جسمي سَقاماً وَأَورَثا","فُؤادي غَراماً حِملُهُ الصَبَّ قَد أَعيا",91,"ي",2,0],["هُما أَظهَرا في الناسِ حُبَّيهِما مَعاً","وَحُبّي مَستورٌ لَدى الناسِ ما يَبدو",92,"د",2,0],["هما السيف والسوط اللذان هما الدوا","فإني حمول للدواء جليد",93,"د",1,0],["هما أحلى من العقدين نييطا","بحيث النحر من جيد الفتات",94,"ت",1,1],["هُما إِلى الحين دلَّتا وهما","ذلّ على من أُحِبُّ دَمعهُما",95,"م",2,0],["هما اليوم أرجعتا صبوتي","ولم ترجعا لي صبا هُدِّما",96,"م",2,0],["هما الشاعران الحق في النظم أم أنا","وأنت بهذ