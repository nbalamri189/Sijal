{"poems":[[75,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[51,"طالما احلولى معاشي وطابا","https://www.aldiwan.net/poem10344.html","المديد"],[51,"ما رأيت العيش يصفو لأحد","https://www.aldiwan.net/poem62038.html","الطويل"],[48,"المشيدات التي رفعت","https://www.aldiwan.net/poem22788.html","المديد"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54819","الرمل"],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[190,"ذكرك الموت قد يفت","https://www.aldiwan.net/poem43892.html","مجزوء الخفيف"],[280,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[484,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[567,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76560","الخفيف"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90610","الرمل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141305","الرمل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76888","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114709","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34676","الرمل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120422","الرمل"],[4875,"مظلم الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=132225",""],[4929,"فاقدُ الهمَّةِ ما صَعَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=204721",""],[5136,"إنما دنياك كالظل إذا","https://www.poetsgate.com/ViewPoem.aspx?id=121640",""],[5136,"رق قلبي ومدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=121941",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[6135,"إنما دنياك ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=186826",""]],"verses":[["إِنَّما دَولَتُكُم واسِطَةٌ","أَهدَتِ الحُسنَ إِلى عِقدِ الدُوَل",0,"ل",1,0],["إِنَّما داعي المَنايا يُنادي","إِحمِلوا الزادَ وَشُدّوا الرِكابا",1,"ب",2,0],["إِنَّما دُنياكَ يَومٌ واحِدٌ","فَإِذا يَومُكَ وَلّى لَم يَعُد",2,"د",1,0],["إِنَّما دُنياكَ غانِيَةٌ","لَم يُهَنِّئ زَوجَها العُرُسُ",3,"س",1,0],["إِنَّمَا دَهرِيَ عَنْكُمْ عَاقَني","فَأَنَا الْقَاعِدُ لَكِنْ بِاضْطِرارِ",4,"ر",1,0],["إنما دنياك فاعلمْ كلها","شبهاتٌ إن تعمَ فيها تضلْ",5,"ل",1,0],["إنما دُنياك بالمالِ تُرى","في ذُرى العليا وأخرى بالعَمَلْ",5,"ل",1,0],["إنما دارت النحو","م لكي تقطع المدد",6,"د",1,0],["إنَّما دَوْلةُ يَحْيَى رَحْمَةٌ","للبَرايا وَحَياةٌ لِلْهُدَى",7,"د",2,0],["إنما دار لا قلت يسقيك الحيا أبدا","فقد سقاك من الأجفان هتان",8,"ن",1,0],["إِنَّما دارُنا التي نحنُ فيها","دارُ حربٍ فليس فيها أمانُ",9,"ن",1,0],["إنّما دبّ نحو شهدٍ بفيه","فلذاك انتهى إلى شفَتَيه",10,"ي",2,0],["إنما دنيايَ نفسي فإذا","تَلفت نفسي فلا عاشَ أحَد",11,"د",1,1],["إنمّا دنياك مضمار فمن","جدّ فيه فاز فوزاً أبديّا",12,"ي",2,0],["إِنَّما دنياك عاره","وَهي بين الناس عارَه",13,"ر",2,1],["إِنَّما دَهريَ نَجوى","بكَ لا تَنفَكُّ تُملى",14,"ل",2,0],["إِنما دَولةُ الطَعام مَنامٌ","وكذا صَولةُ اللِئام خَيالُ",15,"ل",1,0],["إنما دامت على الغد","رِ لما تعرفُ مني",16,"ن",2,0],["انما دبسنا مريق وما يغني","وجود الاشياء والدبس مائع",17,"ع",1,0],["إنما دنياي وعد","كل حرف منه مهمل",18,"ل",1,1],["ان ما دحمت جموع موجك وفرّقت","علّمهم انّي من كذا عام ميّت",19,"ت",1,0],["إنَّما دنياكَ مرحلةٌ","قُصُرَتْ فيها الحياةُ مدى",20,"د",2,0],["إنما دنياك كالظل إذا","رمت للظل لحاقاً سبقك",21,"ك",1,1],["إنما دائي الذي","قد تمادى فلا ارعواى",22,"و",3,0],["إنما دون هواء إنْ تَبَقَّى","لحظاتٍ يتعالى لتعالى",23,"ل",2,0],["إنما دنياك ساعة","فاجعل الساعة طاعهْ",24,"ع",2,1]]}