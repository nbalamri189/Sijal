{"poems":[[85,"الأزبكية فيها درة عجب","https://www.aldiwan.net/poem7748.html","البسيط"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[81,"رحب بضيف الأنس قد أقبلا","https://www.aldiwan.net/poem61405.html","الطويل"],[46,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[268,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[269,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[374,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[429,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[429,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[450,"إِذا ما مضى للمرء يوم من البشر","https://www.aldiwan.net/poem13763.html","الطويل"],[456,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[456,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[459,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[536,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[549,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"]],"verses":[["وكم ثريا وكم جوزاء ما لبثت","حتى خبت غير رسم في مهاويها",0,"ي",3,0],["وَكَم ثَلَمتَ بِهِم مِن مَعقِلٍ أَشِبٍ","وَكَم هَزَمتَ بِهِم مِن جَحفَلٍ لَجِبِ",1,"ب",1,0],["وَكَمِثلِ الأَحبابِ لَو يَعلَمُ العا","ذِلُ عِندي مَنازِلُ الأَحبابِ",2,"ب",1,0],["وَكَم ثَناءٍ قَد تَوانَت خُطاه","كَسَوتَهُ ريشَ الأَيادي فَطار",3,"ر",1,0],["وَكَم ثَوى لَكَ جَدٌّ ما دَرى فَطِنٌ","مِنكُم عَلى أَيِّ أَمرٍ إِذ مَضى قَدِما",4,"م",2,0],["وكم ثم قلباً طارَ حباً وصبوةً","ورأساً غدا يحنى لمجدٍ وعزّة",5,"ه",1,0],["وَكَم ثملوا وجداوكمولهو اهوى","وَكَم سكبوا دماوكم عفر واخدا",6,"د",2,0],["وكم ثمْرةٍ من أجلِها بات غصنُها","هشيماً ولولاها لما كان يُقصَف",7,"ف",1,0],["وكم ثبتّ بحيث الأمن مضطرب","وما لغيرك في الآراءِ مضطربُ",8,"ب",1,0],["وكم ثغورِ أقاحٍ في مراشفِها","رضابُ طائفةٍ بالرِّيّ وَطفاءِ",9,"ا",2,0],["وكمثل الوليد ذي القصف إذ كا","نَ يغب اصطباحه وابتكاره",10,"ر",2,0],["وكم ثوّب الداعي به لصَبُوحهم","وما العمر إِلا كالخيال الذي يسري",11,"ر",2,0],["وكم ثوبِ عزّ أغفل القِسمُ حظَّه","وقد غَضَّ منه والتغافلُ هُونُ",12,"ن",1,0],["وكم ثَمَّ من مسترزقٍ حلَفتْ له","لُهاك وبَرَّتْ أنه لا يُخيَّبُ",13,"ب",1,0],["وكم ثلمت غروب البيض مُرهفةً","بمُضمرِ القدِّ في أعطافه هَيَفُ",14,"ف",1,0],["وكم ثقيلٍ رأت عينِي وما نَظَرَت","فيهِم مَثيلاً لِرَبِّ المطعم البلدي",15,"د",2,0],["وَكَم ثَوَتْ منكُمُ الأحوالُ فاسدةً","حتّى صرفتُ إليها وجهَ إصلاحِي",16,"ي",1,0],["وَكَم ثنيتُ لِحاظي عَن هوادِجكمْ","وَفي الهَوادِجِ أَوطاري وحاجاتي",17,"ت",2,0]]}