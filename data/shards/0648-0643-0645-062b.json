{"poems":[[87,"الأزبكية فيها درة عجب","https://www.aldiwan.net/poem7748.html","البسيط"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[47,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[83,"رحب بضيف الأنس قد أقبلا","https://www.aldiwan.net/poem61405.html","الطويل"],[48,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[275,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[276,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[438,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[438,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[457,"إِذا ما مضى للمرء يوم من البشر","https://www.aldiwan.net/poem13763.html","الطويل"],[463,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[466,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[543,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[556,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[556,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64145","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177900","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56293","الكامل"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101099","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122105","الطويل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146092","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141289","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42472","الطويل"],[2163,"","https://poetry.dctabudhabi.ae/diwan/poem/124035","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137273",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137302",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137126",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137139",""],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100781","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71382","الطويل"],[3498,"","https://poetry.dctabudhabi.ae/diwan/poem/157804","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83144","البسيط"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138821",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139481",""],[4679,"يجد الفتى كما يعيش مُخلَّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=142735",""],[4699,"ويبقى الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193392",""],[4978,"تشطير لأبيات أستاذي محمد ذيب سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=211981",""],[5295,"بَيْنَ الثُّلُوجِ","https://www.poetsgate.com/ViewPoem.aspx?id=177209",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[463,"ألم أتحدّثْ والحديثُ شجونُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60200&r=&rc=256",""]],"verses":[["وكم ثريا وكم جوزاء ما لبثت","حتى خبت غير رسم في مهاويها",0,"ي",3,0],["وَكَم ثَلَمتَ بِهِم مِن مَعقِلٍ أَشِبٍ","وَكَم هَزَمتَ بِهِم مِن جَحفَلٍ لَجِبِ",1,"ب",1,0],["وَكَمِثلِ الأَحبابِ لَو يَعلَمُ العا","ذِلُ عِندي مَنازِلُ الأَحبابِ",2,"ب",1,0],["وَكَم ثَناءٍ قَد تَوانَت خُطاه","كَسَوتَهُ ريشَ الأَيادي فَطار",3,"ر",1,0],["وَكَم ثَوى لَكَ جَدٌّ ما دَرى فَطِنٌ","مِنكُم عَلى أَيِّ أَمرٍ إِذ مَضى قَدِما",4,"م",2,0],["وكم ثم قلباً طارَ حباً وصبوةً","ورأساً غدا يحنى لمجدٍ وعزّة",5,"ه",1,0],["وَكَم ثملوا وجداوكمولهو اهوى","وَكَم سكبوا دماوكم عفر واخدا",6,"د",2,0],["وكم ثمْرةٍ من أجلِها بات غصنُها","هشيماً ولولاها لما كان يُقصَف",7,"ف",1,0],["وكم ثبتّ بحيث الأمن مضطرب","وما لغيرك في الآراءِ مضطربُ",8,"ب",1,0],["وكم ثغورِ أقاحٍ في مراشفِها","رضابُ طائفةٍ بالرِّيّ وَطفاءِ",9,"ا",2,0],["وكمثل الوليد ذي القصف إذ كا","نَ يغب اصطباحه وابتكاره",10,"ر",2,0],["وكم ثوّب الداعي به لصَبُوحهم","وما العمر إِلا كالخيال الذي يسري",11,"ر",2,0],["وكم ثوبِ عزّ أغفل القِسمُ حظَّه","وقد غَضَّ منه والتغافلُ هُونُ",12,"ن",1,0],["وكم ثَمَّ من مسترزقٍ حلَفتْ له","لُهاك وبَرَّتْ أنه لا يُخيَّبُ",13,"ب",1,0],["وكم ثلمت غروب البيض مُرهفةً","بمُضمرِ القدِّ في أعطافه هَيَفُ",14,"ف",1,0],["وكم ثقيلٍ رأت عينِي وما نَظَرَت","فيهِم مَثيلاً لِرَبِّ المطعم البلدي",15,"د",2,0],["وَكَم ثَوَتْ منكُمُ الأحوالُ فاسدةً","حتّى صرفتُ إليها وجهَ إصلاحِي",16,"ح",2,0],["وَكَم ثنيتُ لِحاظي عَن هوادِجكمْ","وَفي الهَوادِجِ أَوطاري وحاجاتي",17,"ت",2,0],["وكم ثنايا تسبى بنكهتها","وكم عيونٍ تُصبي بلحظتها",18,"ت",3,0],["وكم ثنى الفات الوصل معطفه","فجئن بالقطع للأصداغ همزات",19,"ت",1,0],["وكم ثريا في الغصن طالعةً","منها جميع النهار لم تغب",20,"ب",1,0],["وكمثل كثر غنا رأفتك التي","لاقت بعفوك امحُ كل مآثمي",21,"م",2,0],["وكم ثلث ميت قد حواه بكفه","له حيل إذ ليس تحصى معايبه",22,"ب",2,0],["وَكَمْ ثَمَّ مِنْ وَادٍ وَلَكِنْ بِقُدْسِهِ","تَشَرَّفَ لَمَّا مَرَّ مُوسَى بِذِي طُوَى",23,"و",2,0],["وكم ثملٍ من نشوة الحبِّ يرتعي","هوى عامرٍ ما بين حجلٍ ودملج",24,"ج",1,0],["وكم ثقيلٍ كوقع الصّخر منطقه","أو كالصّفاة الّتي تهوي من القنن",25,"ن",1,0],["وكم ثم خدٍّ في التراب معفر","إلى حر وجه بالشواظ محرق",26,"ق",1,0],["وكم ثمَّ دون الجيدِ منهُ مآربٌ","من الخصرِ تدعو العاشقين إلى النحرِ",27,"ر",1,0],["وكم ثلمة في الدين أثبت جبرها","له ثابت عن جابر وابي جبر",28,"ر",1,0],["وكم ثمر جان بارضك خيمت","له شجرات ريها في الصفا العد",29,"د",1,0],["وكمثله سيكون عادل وهو قد","بلغ البلاغة وهو طفل يرضع",30,"ع",1,0],["وكمثلها جاءت شقيقتها التي","ناديك بات بنشرها يتضوع",30,"ع",1,0],["وكمثل والده يكون مثقفاً","تعنو له العلماء والاعلام",31,"م",1,0],["وكمثل اتباع المسيح بحبه","اتباع طه احمد المحمود",32,"د",1,0],["وكمثل لبنان يذيل مدامعاً","ابناء ادرنة مع الالبان",33,"ن",1,0],["وكم ثل ربك عرش امرئ","فخور بموكبه الحافل",34,"ل",1,0],["وَكَمْ ثَّمَّ جِيدٍ للرِّنَا لَيْسَ عَاطِلاً","ضَمَمْنَا عَلَيْهِ الَّثْمَ عِقْداً على عِقْدِ",35,"د",1,0],["وكم ثنيت يدي عنه وقد نعمت","وظل منها فتيت المسك ينتثر",36,"ر",1,0],["وكم ثنى طبعه العلوي ركب منى","يجثو لنجم معاليه على الركب",37,"ب",1,0],["وكمثل سيح الماء من كف له","قد سبحت فيها حصى الغبراء",38,"ا",2,0],["وكمثل تسبيح الحصى أيضا رمى","أعداءه بالكف من حصباء",38,"ا",2,0],["وَكَم ثَرى في تُرابِ الأَرضِ تَحقِرُه","وَفي ثَناياهُ لَو فَتَّشتَه الذَهَبُ",39,"ب",1,0],["وَكَم ثَقيل الحَديثِ لَولا","جُمودُها أَوسَعَته سَبّا",40,"ب",2,0],["وكم ثوى فيه بدرٌ خرَّ من فَلكٍ","له تخرُّ من الأفلاك أركان",41,"ن",1,0],["وكم ثواقبٍ بها قد أوقدت","عاد نهاراً مشرقاً مساؤها",42,"ا",3,0],["وكم ثلَّ عرشاً في ذرى المجد باذخاً","وأبعد مطلوباً وخيب مقصدا",43,"د",2,0],["وكم ثارَ الحنينُ إليكَ لكن","خشيت ُ بأن تكون حَمَلت غَدرا\"",44,"ر",2,0],["(وكم ثغر كثغري جاء يجثو)","(على قدميك يصطف اصطفافا)",45,"ف",2,0],["وكَمِثْلهِ قدْ حَاكَ حُبُكَ بَهْجَتِي","فلَبِسْتُ دونَ النَّاسِ ثوْباً أَمْجَدَا",46,"د",2,0],["وكمثل أحْييْنا ويستحيي مِثْ","لِ الغِيِّ مما جاء في القرآن",47,"ن",1,0],["وكم ثوبِ عزّ أغفل القسمث حظَّه","وقد غضَّ منه والتغافلُ هونُ",48,"ن",1,0]]}