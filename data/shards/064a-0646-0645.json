https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72501","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139667",""],[1663,"الى امرئ نصبت قحطان رايتها","https://www.poetsgate.com/ViewPoem.aspx?id=93229",""],[4796,"الى الاستاذ الشاعر يوسف الخطيب","https://www.poetsgate.com/ViewPoem.aspx?id=34722",""],[4119,"أبدى السلو خديعة للائم","https://www.poetsgate.com/ViewPoem.aspx?id=16040",""],[5061,"انا اذنب ياربي","https://www.poetsgate.com/ViewPoem.aspx?id=153002",""],[5111,"الإشْرَاق","https://www.poetsgate.com/ViewPoem.aspx?id=212050",""],[307,"ما زادني قولُ المديحِ جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=213806",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5431,"أهواه ملتحما...بالروح ينصهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=186938",""],[5543,"يشير بأطرافٍ لطافٍ كأنها","https://www.poetsgate.com/ViewPoem.aspx?id=181701",""],[5672,"من ادب الاخوانيات","https://www.poetsgate.com/ViewPoem.aspx?id=213893",""],[5717,"عدتك تخمينات قوم لطموا","https://www.poetsgate.com/ViewPoem.aspx?id=170598",""],[402,"لقد آن أن يستمرئ النوم ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=35475",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5859,"الموعد","https://www.poetsgate.com/ViewPoem.aspx?id=29421",""],[5956,"نفحاتٌ وحِكَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=192564",""],[5956,"يا رب رتِّبْ أمره","https://www.poetsgate.com/ViewPoem.aspx?id=193873",""],[6070,"ما أجملَ الشِّعرَ حِينَ الرُّوحُ تَسْكبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=197535",""],[6093,"تبرج صوت","https://www.poetsgate.com/ViewPoem.aspx?id=206314",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[6259,"هي البدرُ لكن تستسرّ مدى الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59382&r=&rc=30",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""]],"verses":[["يُنمى إِلى أَعياصِ خَيرِ أَرومَةٍ","لَيسَت بِعَشّاتِ الفُروعِ ضَواحِ",0,"ح",1,0],["يُنمى إِلَيهِ الشيحُ وَال","حَوذانُ وَالإِبِلُ الجِرابُ",1,"ب",1,0],["ينُمُّ بمَجْدي حينَ أفْخَرُ مَنْطِقي","ويُعْرِبُ عن عِتْقِ المَذاكي صَهيلُها",2,"ل",3,0],["ينُمُّ علَيْنا الحَلْيُ حتى إذا رَمى","بهِ باتَ واشِي العِطْرِ عنّا يُحدِّثُ",3,"ث",1,0],["يَنُمُّ على أعراقِها مِنْ رُوائِها","تَباشِيرُ عِتْقٍ قَبلَ أن يُخْبَرَ الحُضْرُ",4,"ر",1,0],["يَنْمُو وَيَأْوِي مِنْكَ فِي","رَغْدٍ إِلَى الصَّدْرِ الأَحَنِّ",5,"ن",1,0],["ينمحي بعضها ويظهر بعضٌ","فهي تنساب بين خاف وباد",6,"د",1,0],["ينمي به المدح إلى أسرةٍ","ما دهر داعيهم بمذموم",7,"م",1,0],["يَنْمى إلى دِعْص لها مُنَضَّدٍ","تكسو عقودَ الدُرِّ والزبرجدِ",8,"د",1,0],["ينمُّ على الأمرين فرطُ صفائها","وسوْرتِها حتى يبوحَ المُجمجمُ",9,"م",1,0],["يَنمو فَتَذوي فَهيَ عُلَّيقَةٌ","وَحذَرُها الطائِفُ بِالرَوضَةِ",10,"ه",1,0],["يَنمو فَتَذوي فَهِيَ عُلَّيقَةٌ","يَحذَرُها الطائِفُ بِالرَوضَةِ",10,"ه",1,0],["يَنَمنَ فيها نيمَةَ المِكسالِ","عَلى القُفِيِّ أَعجَلَ العِجالِ",11,"ل",1,0],["يُنمى إِلى ذُروَةِ الدينِ الَّتي قَصُرَت","عَنها الأَكُفُّ وَعَن إِدراكِها القَدَمُ",12,"م",1,0],["يُنْمَي‌ إلَی‌ ذَرْوَةِ العِزِّ الَّتِي‌ قَصُرَتْ","عَنْ نَيْلِهَا عَرَبُ الإسْلاَمِ وَالعَجَمُ",13,"م",1,0],["يُنمَى العَفافُ إليَّ مُغترِباً كما","يُنمَى السماحُ إلى الأمير إذا انتمَى",14,"م",2,0],["يَنمي إِلى ميراثِ والِدِهِ","كُلُّ اِمرِئٍ لِأَرومَةٍ يَنمي",15,"م",2,0],["يَنمي إِلى القَومِ الَّذينَ إِذا سَطوا","أَغنَت عَزائِمُهُم عَنِ الأَسيافِ",16,"ف",1,0],["يَنُمُّ بِهِم جودُهُم مِثلَما","تَنُمُّ الرِياحُ عَلى المَندِلِ",17,"ل",1,0],["يَنِمُّ عَلَيها طيبُ رَيّا كَلامها","فَيَدري غيورٌ أَنَّها تَتَكلَّمُ",18,"م",1,0],["يَنُمُّ بِهَا صُبْحٌ مِنَ الْبِيضِ أَزْهَرٌ","وَيَكْتُمُهَا نَقْعٌ مِنَ اللَّيْلِ مُظْلِمُ",19,"م",1,0],["يَنُمُّ ريَّاها على زَهْرِ الرُّبى","بذاتِ أحداقٍ تَرى ما لا يُرى",20,"ا",1,0],["ينمنم الأحلام فضّيّة","وتنسج الشمس لك الأرجوان",21,"ن",1,0],["ينمُّ على الأمرين فرطُ صفائها","ترقرق دمعاً ، بل ثغور تبسَّم",22,"م",1,0],["ينمُّ على الأمرين فرطُ صفائها","ربيبُ الفيافي والربيب المتوَّمُ",22,"م",1,0],["ينمّ بكل الجبينُ دجىً فأرسل","على شمسِ الجبين ظلام شعرِ",23,"ر",1,0],["يَنميهِ عَبدُ اللَهِ وَالفَضلُ اِبنُهُ","وَأَبو سِنانٍ لِلفَخارِ وَأَحمَدُ",24,"د",1,0],["يُنمى إِلى البَيتِ العُيونِيِّ إِلى","أَجَلِّ بَيتٍ في العُلى وَأَرفَعِ",25,"ع",1,0],["يُنمى إِلى الشُمِّ الغَطارِفِ وَالذُرى","مِن حارِثٍ وَالسادَةِ الحُكّامِ",26,"م",1,0],["يُنمى لِفَضلٍ وَصبّارٍ وَإِخوَتِهِ","بَني عَلِيٍّ كِعامِ الخَطبِ إِذ هَجَما",27,"م",2,0],["ينمون حين تَرى الموارد طُفَّحا","والروضَ غَضَّا والنسيمَ عليلا",28,"ل",2,0],["ينمق قول الزور فينا تعمدا","ومن حسد يلقي الحديث المزخرفا",29,"ف",2,0],["يَنِمُّ عليه العِطْرُ حين يَزُورني","ويُخْفِي على آثارِ أرجلِه المِرْطُ",30,"ط",1,0],["يُنَمِّقُ الطَلُّ أطراساً مُنَمْنمةً","والطيرُ يقرا بوَعظٍ في صحيفتِهِ",31,"ت",2,0],["يَنمى ويزداد ودينُ العدى","أئمة الزيغ به تمحق",32,"ق",1,0],["يُنمي إِذا لَبِسَ البَياضَ بَهاؤُهُ","وَيُنيرُ إِن وافى بِأَحمَرَ قانِ",33,"ن",1,0],["يُنمى إِلى كُلِّ قَعي","دٍ في العُلا مُعَرَّقِ",34,"ق",1,0],["يُنمى إِلى بيضِ المَآ","ثِرِ طابَ خَيمُهُمُ فَطابوا",35,"ب",3,0],["يَنْمِي إِلَى مِثْلِيَ غَدْراً وَهْوَ مَنْ","مَا زَالَ أَفْرَاسَ الْوَفَاءِ يَسُوسُ",36,"س",1,0],["ينمو بأنمله اليراع ويرتوى","من راحيته ذابل ومهند",37,"د",1,0],["ينميه بين خؤلة وَعمومة","جدان في التَفضيل مستويان",38,"ن",1,0],["يَنْميهِمُ المُرْتَضَى واهاً لَه شَرَفاً","أعْيا القِيامَ بِه حَمْدٌ وإِحْمادُ",39,"د",1,0],["يَنْميهِ لِلشّرف الذِي لا يُرْتَقى","بَيْتٌ غَدَا جَار النجوم وَراحا",40,"ح",2,0],["يَنْميه عَبْد الواحِد الأرْضى إلى","عُلْيا تَجَنّح بَأسها وَسَخَاءَها",41,"ا",3,0],["يَنُمُّ بِهِ ماكَسَتْها يَدا","كَ مِنْ مَعْجِزِ الْوَشْيِ وَالنَّمْنَمَهْ",42,"م",2,0],["يَنْمِيكَ صَفْوَةُ مَعْشَرٍ لَوْلاهُمُ","ما كانَ يُرْفَعُ لِلْعَلاءِ مَنارُ",43,"ر",1,0],["يُنميهِ مِن شَرَفِ الأُمومَةِ مَغرَسٌ","كَرَمُ الأُبُوَّةِ عِندَهُ مَبذورُ",44,"ر",1,0],["يَنميهِ حَربٌ وَمَروانُ وَأَصلُهُما","إِلى جَراثيمُ مَجدٍ غَيرِ مَأشوبِ",45,"ب",1,0],["يَنمي بهم آباؤهُم لِلعُلى","وَنِسوَةٌ بيضٌ مَناجيبُ",46,"ب",1,0],["ينم بأخفى سرها غير كاتم","صداها فأخفى السر فيها من الجهر",47,"ر",1,0],["يَنمّ ثَناؤُها كَرَماً وَطيباً","وَيَنمو عزّها شَرَفاً وَسَعدا",48,"د",2,0],["يَنُمُّ به نَفَسٌ للحسو","دِ يَنقَدُّ من كبِدٍ منه حَرّى",49,"ر",2,0],["يَنميهِ إِن تَفاخَروا أَمجادُهُ","الغُرُّ الأَلى مَهما بَنوا يُشَيَّدُ",50,"د",1,0],["يَنِمُّ عَلى ما في الإِناءِ بِرَشحِهِ","وَلَولا اِنصِداعُ القَلبِ ما أَلِفَ الرَشحا",51,"ح",2,0],["ينميه من زيدانٍ يشبه مَعشَرٌ","لَهُمُ من الشَرَفِ الرَفيع ذراهُ",52,"ا",2,0],["يَنُمُّ عَلَيكَ الفَضلَ في كُلِّ مَوطنٍ","نزلت كَما نَمَّ النَسيم عَلى العِطرِ",53,"ر",1,0],["ينم على المعايب والمساوي","كما نم النصول على الخضاب",54,"ب",1,0],["ينم بهم مجد رفيع ومنطق","وينبي عن الخيل العتاق صهيلها",55,"ه",2,0],["يُنْمى لها وكذا يُنمى إليكَ فهلْ","من يَحسُبُ البدرَ إذ ما فاتَه الحسبُ",56,"ب",1,0],["ينمّ ارتيادي فيه عن حسن ما أرى","ويفصح غرسي فيه عن طيب ما أجني",57,"ن",2,0],["ينميه من أسدٍ عِرقٌ يُوَشجهُ","إلى عفيفٍ وعرقُ المجد مبتورُ",58,"ر",1,0],["ينمي الوليدُ على ذكراكَ مُعتقداً","في نفسه أنَّكَ العنقاءُ في الجبلِ",59,"ل",1,0],["ينمُّ على فتكاتهِ زهر القنا","كذلك حديث الزهر يحلو إذا نمَّا",60,"م",2,0],["ينمُّ بها نورٌ جليٌّ وادمعٌ","ويضمرها قلبٌ شجيٌّ وحوده",61,"ه",1,0],["ينمقون القول ما غبتُ فإن","حضرتهم يومَ مقال وجموا",62,"م",3,0],["ينمُّ وشاحاها ويصمت فلبها","ويسكن حجلاها ويضطرب القرط",63,"ط",1,0],["ينمُّ شحوبي بالذي أنا كاتمٌ","ويفصح جفني واللسانُ بليد",64,"د",1,0],["ينم باديه على المضمار","يبكي على الرأس بلا استعبار",65,"ر",1,0],["ينمُّ عليه الدّمعُ وهو جَحودُ","وينتحِلُ السُّلوانَ وهو وَدودُ",66,"د",1,1],["ينم عليها كلما نمت الصبا","على الروض وهناً مسكها وعبيرها",67,"ر",3,0],["ينمو ويزداد ليس يحوجني","إلى اتجارٍ ولا إلى شركهْ",68,"ك",2,0],["ينمُّ إِليكَ وطوْراً عليْكَ","فتمَّ له أَمْرُه حين نَمْ",69,"م",1,0],["يُنَمْنِمُ في القِرْطاس روضاً موشعاً","له ثمرٌ كِدْنا نقوم لِقَطْفه",70,"ف",2,0],["ينمُّ عن عرف أخلاقٍ له عطرت","وعن فضائل زانت أفضل الناس",71,"س",1,0],["ينمو الولاء إذا تقادم عهده","في قلبنا ويزيد أي مزيد",72,"د",1,0],["ينمى إِلى الدوحة الّتي كرمت","وإنّه فرع ذلك الغصنِ",73,"ن",1,0],["ينمى إلى الصيدِ الأكارمِ من بني","كمّونة وضراغم وأسودِ",74,"د",1,0],["يَنمُّ على فُطيمةَ مستغيضا","فيفضَحُها اليَلنجَجُ والجساد",75,"د",1,0],["يُنميهِ هاشِمُه وعَبدُ مَنافِه","وقُصَيُّه نَسَباً وإسماعيلُه",76,"ل",2,0],["يُنمِّقُها مِن كُلِّ ما راقَ مُخلصٌ","وَيَنشرها في شَرقِها وَالمَغارب",77,"ب",1,0],["ينِمُّ عَلَينا عَرفُهُ حينَ يَنثَني","فَيهزا بأغصان وَيُزري بأَزهارِ",78,"ر",1,0],["يَنُمُّ بِسِرِّ مُستَرعيهِ لُؤماً","كَما نَمَّ الظَلامُ بِسِرِّ نارِ",79,"ر",1,1],["ينم علي الضوء طوراً واختفى","ببطن الفلا لما أثير غبارها",80,"ر",3,0],["ينمو ورفقك يا ابن توفيقٍ به","رفق يرد إلى الشباب الشيبا",81,"ب",2,0],["ينمى إِلى سِبطٍ من الكرمِ الذي","أَسباطُهُ من أكرمِ الأسباط",82,"ط",1,0],["ينِمُّ به الوَلاّفُ طوراً وتارة","يُواريه يحْمومٌ من الليلِ دحمسُ",83,"س",1,0],["ينمُّ وشاحاها ويصمت قُلبها","ويسكن حجلاها ويضطرب القرط",84,"ط",1,0],["ينم على سرائره نسيم","ضعيف فاتر الحركات وإني",85,"ن",2,0],["ينميه من آل الرفيل مساعر","بيض أعادوا البيض حمر متونِ",86,"ن",1,0],["ينم نمامها بعرف","نسيمه بالعبير ناسم",87,"م",1,0],["يَنْمِي إِلَى طايِفِهِ الشِنْعافِ","بَيْنَ حَوَامِي رُتَبِ النِيَافِ",88,"ف",1,0],["يُنْميكَ مِنْ هَذَبانٍ كلُّ مُضْطَلعٍ","الحَرْبِ لا وَرَعٍ فيها ولا وَكَلِ",89,"ل",1,0],["ينمُّ عن أفراطه لونها","في مقلتيهِ وعلى وجنتيه",90,"ي",2,0],["يَنمازُ عَنهُ دُخَّلٌ عَن دُخَّلِ","كَالجَندَلِ المَطوِيِّ فَوقَ الجَندَلِ",91,"ل",1,0],["ينميه حيانِ هما الحيانِ","إلى بناء أكرمِ البنيانِ",92,"ن",1,0],["يُنمي إلى طيِّبي الأعراق مَن عقدوا","على العفاف قديماً طاهرَ الأزر",93,"ر",1,0],["يُنميه من مَهديّ آل محمدٍ","هذا الذي نَعَشَت يَداه ضعافَها",94,"ف",3,0],["يُنمى إلى قبيلة المجد التي","طريفها يعربُ عن تلادها",95,"د",3,0],["يُنمى لقومٍ في الزمانِ خُلِقوا","جواهراً يُزانُ فيها الأبد",96,"د",1,0],["يَنمُّ بِيَ الثَغرانِ صُبحٌ وَصارِمٌ","وَيَكتُمني القَلبانِ نَقع وَغَيهَبِ",97,"ب",1,0],["يَنْميكِ كلُّ بعيدِ الشأوِ فائِتُهُ","له البسالةُ أمٌّ والسمَّاحُ أب",98,"ب",1,0],["يَنمِيك للمجد أبو قاسمٍ","ما أقْرَبُ الفَرْعَ من الأصْلِ",99,"ل",1