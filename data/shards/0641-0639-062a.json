{"poems":[[53,"في جلنار وأختها دبسية","https://www.aldiwan.net/poem8493.html","الكامل"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[87,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[33,"وآخر عهدي بالرباب مقالها","https://www.aldiwan.net/poem41817.html","الطويل"],[190,"إذا صح لي قوت وقوت لعيلتي","https://www.aldiwan.net/poem43705.html","الطويل"],[240,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123382","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119871","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120020","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56289","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124726","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42474","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61282","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142877","الطويل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101153","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4927,"مَجْدُ الْعِرَاْق","https://www.poetsgate.com/ViewPoem.aspx?id=30480",""],[5324,"ما عاد سجيل العراق يقضّهم .","https://www.poetsgate.com/ViewPoem.aspx?id=207471",""],[5736,"محراب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208492",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""]],"verses":[["فعتبتُ عتباً خلت فيه كفايةً","ثم انصرفت إلى التي هي أصوبُ",0,"ب",1,0],["فعتا ويَهْيَهَ في الكلامِ تَعارُباً","حتى كنيناه أبا اليهْياه",1,"ه",1,0],["فَعَتِبتُ في رُكنِ القَضا","ءِ عَلى القَضاءِ المُنزَلِ",2,"ل",1,0],["فَعُتباكَ مِنّي أَنَّني غَيرُ عائِدٍ","وَأُقسِمُ بِالرَحمَنِ لا نَتَكَلَّمُ",3,"م",1,0],["فعتبي على الأيّام عتب مشقة","إذا كان حظّي اليوم حظّيَ في أمس",4,"س",1,0],["فَعَتادُهُ عَضبُ المَضارِبِ باتِرٌ","وَأَصَمُّ عَسّالٌ وَأَجرَدُ شَيظَمُ",5,"م",1,0],["فَعَتْبي له عَتْبُ البريء وخِيفَتي","لحِرصي على عُتْباه خِيفَةُ جانِ",6,"ن",1,1],["فعتاده في كل يوم أكدر","صافي الحديد فرنده موار",7,"ر",1,0],["فعتاده في الروع أبيض صارم","ومثقف لدن ونهد أجردَ",8,"د",1,0],["فعتقت من أعداي طراً فأبعدوا","يا صانعي الأثم فالرب اقتربْ",9,"ب",1,0],["فعتقٌ وإلا الصوم إن هو لم يجد","وليس لإطعامِ المساكين مدخلُ",10,"ل",1,0],["فعتقٌ أو فشهران صياماً","عليه والعكوفُ به يبورُ",11,"ر",1,0],["فعتبتُ حظِّي واللعينُ زجرتُهُ","بغرائبِ الألفاظِ من لعناتِهِ",12,"ت",2,0],["فَعتيقُ سابقُهم وَلَيسَ بِمُنكَرٍ","سَبقُ العَتيقِ وَفَضلُه لا يُجحَدُ",13,"د",1,1],["فَعِتَابُ الإِلاَهِ جَلَّ ثَنَاهُ","لِعِتَابِ حَبِيبِهِ إِبدَاءُ",14,"ا",2,0],["فعِتقاً لعبدٍ قد أتى لك مازِجا","ذنوباً بحُسنِ الظنِّ فهو سَجينُ",15,"ن",1,0],["فعتبي على حظي عداه فانما","يحق لهذا الحظ أني أعاتبه",16,"ب",2,0],["فعتبى للزَّمانِ على اهتضامي","وشكوى من جنونِ المنجنونِ",17,"ن",1,0],["فعتَوْا عُتوّاً خالفوا مولاهمُ","فأتاهمُ طوفانُه التَّيَّارُ",18,"ر",1,0],["فَعَتَبْتُ جَهْرًا º وَ الْعِتَاْبُ مُوَجَّهٌ","لِلْفُرْسِ وَ الأَعْرَاْبِ وَ الأَكْرَاْدِ",19,"د",1,0],["فعِتاد أهلي من جهنمَ ثورةٌ","وعتادُ من خذَل القضيّةَ خلّبُ",20,"ب",1,0],["فعتمٌ في الهوى يجلوه فجرٌ","وقلبُ الصبِّ يحييه الولوعُ",21,"ع",1,0],["12. فعترةُ المُصْطفى ليست بشيعتكم","وحزبكم عنْدَ فَحْصِِ القول شيطانُ",22,"ن",1,0]]}