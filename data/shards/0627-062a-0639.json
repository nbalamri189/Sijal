,"https://www.aldiwan.net/poem61342.html","الخفيف"],[456,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[456,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[456,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[456,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[456,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[459,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"أتعبث بي غائباً يا سعيد","https://www.aldiwan.net/poem3361.html","عموديه"],[462,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[475,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[484,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[536,"قل للذي رام تفريقا وشيطنة","https://www.aldiwan.net/poem47607.html","عموديه"],[538,"أتعذر سلمى بالنوى أم تلومها","https://www.aldiwan.net/poem56665.html","الطويل"],[542,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[556,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[560,"أتعلم ما هاجت بقلبي من الشغل","https://www.aldiwan.net/poem52926.html","الطويل"],[565,"أه من بحة بغير انقطاع","https://www.aldiwan.net/poem69605.html","الخفيف"],[565,"يا حبذا الصرة أهدى لنا","https://www.aldiwan.net/poem69727.html","السريع"],[573,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[585,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"]],"verses":[["أَتَعلَمُ مَن تُخاطِرُ أَو تُسامي","غُروراً ما أَراكَ بِهِ المَنامُ",0,"م",1,0],["أَتَعذِلُني فاهاً لفيكَ عَلى الهَوى","لأَرمِيَ بِالحَبلِ الَّذي أَنتَ قاضِبُهْ",1,"ب",2,0],["أَتُعْوِزُهُ السُّقْيَا وَأنْتَ غِيَاثُهُ","أَتُتْلِفُهُ الْبَلْوَى وَأَنْتَ رَحِيمُهُ",2,"م",2,0],["أَتَعجَبُ أَن أَوفَيتَ لِلجارِ مَرَّةً","فَنَحنُ لَعَمري اليَومَ مِن ذاكَ نَعجَبُ",3,"ب",1,0],["أَتَعرِفُ رَسماً بَينَ رَهمانَ فَالرَقَم","إِلى ذي مَراهيطٍ كَما خُطَّ بِالقَلَمِ",4,"م",1,1],["أتعدون هذهه حسنات","لي فتاللَه مال قارون مالي",5,"ي",1,0],["أَتْعَبَ قُوَّامٍ بِمَجدِ الحِمَى","في سَعَةِ العَيْشِ وَفِي الكَرْبِ",6,"ب",1,0],["أَتَعِزَّ أَمْصَارٌ بِفِتْيَتِهَا","وَتَهُونَ تِلْكَ بِهِمْ وَتُمْتَهَنُ",7,"ن",1,0],["أَتْعَبَ العَالَمِينَ فِي العَيْشِ","ذُو النَّفْسِ الَّتِي يَسْتَفِزُّهَا الإِقْدَامُ",8,"م",1,0],["أَتُعَلُّ صِحَّتُهَا وَعَنْ كَثَبٍ لَهَا","مِنْهُ خَبِيرٌ بِالشِّفَاءِ عَلِيمُ",9,"م",1,0],["أَتَعجَبُ لِلأَجلافِ أَن يَتَخَيَّفوا","مَعالِمَ دينِ اللَهِ وَهوَ مُبينُ",10,"ن",1,0],["أَتَعرِفُ أَطلالاً بميسَرةِ اللِّوى","إلى أَرعَبٍ قَد حَالَفَتكَ به الصِّبا",11,"ا",1,1],["أَتَعرِفُ دارَ الحَيّ بادَت رُسومُها","عَفَت بَعدَنا جَرعاؤُها وَهُشومُها",12,"م",3,1],["أَتَعرِفُ أَطلالاً بِوَهبينَ وَالحَضرِ","لِمَيٍّ كَأَنيارِ المُفَوَّفَةِ الخُضرِ",13,"ر",1,1],["أَتعرِفُ الدارُ تَعَفَّت أَبَداً","بِحَيثُ ناصى الخَيراتِ الأَوهَدا",14,"د",2,1],["أَتعطشُ أولادي وأنت غمامة","تعم جميع الخلق بالنفع والسقيا",15,"ي",2,1],["أتعلم أن أمك في البغايا","تبيح النيك من قبل ودبر",16,"ر",1,0],["أتعجَبُ من حزني وتعلمَ أنني","قَرِيع تباريح تُشيب النواصيا",17,"ي",2,0],["أَتَعدِلُ لا أَبا لَكُمُ الخَناثى","بِيَربوعٍ تَباعَدَ ذاكَ بَينا",18,"ن",2,0],["أَتَعدِلُ في الشَكيرِ أَبا جُبَيرٍ","إِلى كَعبٍ وَرابِيَتَي كِلابِ",19,"ب",1,0],["أَتَعدِلُ دِمنَةً خَبُثَت وَقَلَّت","إِلى فَرعَينِ قَد كَثُرا وَطابا",20,"ب",2,0],["أَتَعدِلُ مَن يَدعو بِقَيسٍ وَخِندَفٍ","لَعَمرُكَ ميزانٌ بِوَزنِكَ راجِحُ",21,"ح",1,0],["أَتَعرِفُ أَم أَنكَرتَ أَطلالَ دِمنَةٍ","بِأَثبيتَ فَالجَونَينِ بالٍ جَديدُها",22,"د",3,1],["أَتُعذَرُ إِن أَبدَيتَ بَعدَ تَجَلُّدٍ","شَواكِلَ مِن حُبٍّ طَريفٍ وَتالِدِ",23,"د",1,0],["أَتَعدِلُ لَيلَ أَيسَرَ مُستَنيماً","بِلَيلِ المُلجَماتِ عَلى سَفارِ",24,"ر",1,0],["أَتَعدِلُ مَسعوداً وَقَيساً وَخالِداً","بِأَقيانِ لَيلى لا نَرى لَكَ مَقنَعا",25,"ع",2,0],["أَتَعدِلُ يَربوعاً خَناثى مُجاشِعٍ","إِذا هُزَّ بِالأَيدي القَنا فَتَزَعزَعا",25,"ع",2,0],["أَتَعدِلُ أَحساباً كِراماً حُماتُها","بِأَحسابِكُم إِنّي إِلى اللَهِ راجِعُ",26,"ع",1,0],["أَتَعدِلُ كَهفاً لا تُرامُ حُصونُهُ","بِهاري المَراقي جولُهُ يَتَقَصَّفُ",27,"ف",1,0],["أَتَعدِلُ يَربوعاً وَأَيّامَ خَيلِها","بِأَيّامِ مَضفونينَ في الحَربِ عُزَّلِ",28,"ل",1,0],["أَتَعرِفُ أَطلالاً وَنُؤياً مُهَدَّم","كَخَطِّكَ في رَقٍّ كِتاباً مُنَمنَما",29,"م",2,1],["أتعرف رسماً بالغريَّين مقفرا","لظبية أم أنكرتَه أم تنكَّرا",30,"ر",2,1],["أَتَعُزُّ أَنتَ عَلى رُسومِ مَغانِ","فَأُقيمُ لِلعَبَراتِ سوقَ هَوانِ",31,"ن",1,1],["أَتَعجَبُ أَن مَلَكنا الأَرضَ قَسراً","وَأَن تُمسي وَسائِدَنا الرِقابُ",32,"ب",1,1],["أَتَعجَبُ إِن أَقصَدتَ حَمزَةَ مِنهُمُ","نَجيباً وَقَد سَمَّيتَهُ بِنَجيبِ",33,"ب",1,0],["أتَعذَلُ أقلامُ المدائح إن غدت","له سجداً لا للأنام وركّعا",34,"ع",2,0],["أتعطي سوايَ الأمهاتِ من اللُّهى","وَتَخْتصُّني منها بصغرى بناتِها",35,"ت",3,0],["أتعجب من أنثى تُناك بحقِّها","وهأنذا شيخٌ أُكَبُّ فأُنكَحُ",36,"ح",1,0],["أتَعُدُّ نائلَ كفه عوضاً","منه لَهِنَّكَ لَلْفَتَى الغُمرُ",37,"ر",1,0],["أتعلمني من مدح غيرك صائماً","صياماً له قِدماً على فِيَّ طابع",38,"ع",1,0],["أتعولُ ويحك إخوةً","لا من أبيك وأنت غافلْ",39,"ل",1,0],["أَتَعُدُّ مَأثُرَةً لِغَيرِكَ ذِكرُها","وَسَناؤُها في سالِفِ الأَزمانِ",40,"ن",1,0],["أَتُعجِزُنا في بَسطَةِ الأَرضِ كُلِّها","فَتِلَك وَبَيتِ اللَهِ إِحدى العَجائِبِ",41,"ب",1,0],["أَتَعرِفُ مِن أَسماءَ بِالجُدِّ رَوسَما","مُحيلاً وَنُؤياً دارِساً قَد تَهَدَّما",42,"م",2,1],["أَتَعلَم أَنَّ قَلبي غَيرُ صاحِ","وَأَنّي مِن سُلوِّكَ في اِنتِزاحِ",43,"ح",1,1],["أَتَعجَبُ أَن طَرِبتُ لِصَوتِ حادِ","حَدا بُزلاً يَسِرنَ بِبَطنِ وادِ",44,"د",1,1],["اتعست اقواما لتسعد غيرهم","والشر كل الشر في الاتعاس",45,"س",1,0],["اتعس الخلق شاعر طعنته","حادثات الايام طعناً دراكا",46,"ك",2,1],["اتعبتك الحياة حتى مللت العيش","فاخترت في المنايا السكونا",47,"ن",2,0],["أتعرف البنت يا رشاد","وأعرف الأم يا جمال",48,"ل",1,1],["أتعلو علينا في المشارق أمة","وجدّك دل الشرق كيف يسير",49,"ر",1,0],["أتعهدين حنيني في الزمان لها","وسكبي الدمع من تذكارها قانى",50,"ن",2,0],["أَتعبَها مُختَلَطٌ مختَبَلٌ","يَهدِمُ إِن ثارَ وَيَبني إِن هَذا",51,"ا",1,0],["أَتَعودُ في رَكبِ الرَبيعِ إِذا اِنثَنى","بَهِجاً يَزُفُّ الوَردَ وَالنِسرينا",52,"ن",2,0],["أَتَعَلَّمُ الغاياتِ كَيفَ تُرامُ في","مِضمارِ فَضلٍ أَو مَجالِ قَوافي",53,"ي",1,0],["أَتعَبَت مُعالِجَها","وَاستَراحَ مُعتَقِدُ",54,"د",1,0],["أَتَعلَمُ أَنَّهُم صَلِفوا وَتاهوا","وَصَدّوا البابَ عَنّا موصِدينا",55,"ن",2,0],["أَتعَبَ الريحَ مَدى ما سَلَكَت","مِن سُهولٍ وَأَجازَت مِن حُزون",56,"ن",1,0],["أَتعَبتَ شُكري فَأَضحى مِنكَ في نَصَبٍ","فَاِذهَب فَمالِيَ في جَدواكَ مِن أَرَبِ",57,"ب",1,0],["أَتَعتَدُّهُ ذُخراً كَريماً فَإِنَّما","مَرامُ كَريمِ القَومِ أَن يَكرُمَ الذُخرُ",58,"ر",1,0],["أَتعَبَتهُ العُلا فَأَبقَت نُدوباً","مُتعَباتٍ بِجِسمِهِ وَكُلوما",59,"م",2,0],["أَتَعدِلُ حَومَتي بِبَني كُلَيبٍ","إِذا بَحرِي رَأَيتَ لَهُ اِضطِرابا",60,"ب",2,0],["أَتَعدِلُ أَحساباً لِئاماً أَدِقَّةً","بِأَحسابِنا إِنّي إِلى اللَهِ راجِعُ",61,"ع",1,0],["أَتَعجَبُ مِمّا جَنَتهُ يَدي","فَما كانَ ذاكَ بِغَيرِ اِختِياري",62,"ي",1,0],["أَتَعتَزُّهُ الأَعداءُ في يَومِ لَهوِهِ","فَهَلّا أَتوهُ جَحفَلاً يَومَ حَربِهِ",63,"ب",2,0],["أَتعَبتَ بِالشُكرِ جُهدَ مُهجَتِهِ","كَأَنَّها بِالنَعيمِ مُمتَحَنَه",64,"ن",2,0],["أَتعَبتَني بِالشُكرِ أَعجَزَ طاقَتي","وَظَنَنتَ أَنَّكَ بِالنَوالِ أَرَحتَني",65,"ي",1,0],["أتعصاني مغردة بنفسي","معودة هنالك أن تطيعا",66,"ع",2,0],["أَتُعجِمُ نبعَ العربِ عجمٌ ولا يُرَى","لما اشتدّ منها في نَواجِذِها كَسرُ",67,"ر",1,0],["أتعرفُ لي عن شبابي سُلُوّاً","ومَن يجدِ الداءَ يبغِ الدواءَ",68,"ا",2,0],["أُتَعتِعُ في الحَوائِجِ إِن خِفافاً","غَدَوتُ بِها عَلَيكَ وَإِن ثِقالا",69,"ل",2,0],["أُتَعتِعُ في الحَوائِجِ إِن خِفاقاً","غَدَوتُ بِها عَلَيكَ وَإِن ثِقالا",70,"ل",2,0],["أتعتادُ التكاسلَ والتصابي","إذا اعتادَ الفتى خوضَ المنايا",71,"ا",3,1],["أَتَعذِرُ لَيلى ما لِغَيري بِلَومِها","وَلَيلى فِدى نَفسي الَّتي لا أَلومُها",72,"م",3,0],["أَتَعجَبُ أَن تَرى قَنَصَ الضَواري","وَتَغضَبُ أَن يَكونَ لَها أَكيلا",73,"ل",2,0],["أَتُعيبُني أَن كُنتُ تِربَ خَصاصَةٍ","تِربُ الغِنى في مِثلِ شَأنِكَ أَعيَبُ",74,"ب",1,0],["أتُعطَى من العزِّ البهيمةُ رِزقَها","ويُحرَمُ منه المرءُ تِلكَ العجائبُ",75,"ب",1,0],["أتُعْوِزُهُمْ لَدَى الزَّحفِ المطايا","ويَسْبِقُهم إلى اللهِ الرِّفاقُ",76,"ق",1,0],["أتعجَبُ منها كيف تحمي ذِمارَها","وَتَدْرَأُ عنها الشَّرَّ إن هاجها الشَّرُّ",77,"ر",1,0],["أتعتزلانِ دِينَ اللَّهِ خَوْفاً","فَمنْ أولَى بخوفٍ وَابْتِهالِ",78,"ل",1,0],["أتعِيبُها أن لم تكن عربيَّةً","أفما رأيتَ جَمالَها المتناهيا",79,"ي",2,0],["أَتَعمُرُ بُستاناً زَكا لَكَ غَرسُهُ","وَتَخرِبُ وُدّاً مِن خَليلٍ مُوافِقِ",80,"ق",1,1],["أَتَعذُلُني في يوسُفٍ وَهوَ مَن تَرى","وَيوسُفُ أَبلاني وَيوسُفُ يوسُفُ",81,"ف",1,0],["أَتعَبتُمُ يَدَيهِ","بِالقَلَباتِ دَهرا",82,"ر",2,0],["أَتَعبَدُ مِن إِثامٍ تَتَّقيهِ","ظَوالِمُ بِالأَذى مُتَعَبِّداتُ",83,"ت",1,0],["أَتُعوِجُ أَمَ لَيسَ المَشوقُ بِعائِجِ","هاجَت وَساوِسُهُ لِبَرقٍ هائِجِ",84,"ج",1,1],["أَتَعلَمُ أُسدُ الغيلِ بَعدَ اِفتِراسِها","تُحاوِلُ دُرّاً أَو تُحاوِلُ عَسجَدا",85,"د",2,0],["أَتِعارُ عَينُكَ يا بنَ أَحمَرَ ضِلَّةً","وَيَسومُ لَيسَ بِبارِحٍ وَتِعارُ",86,"ر",1,1],["أَتَعقُلُ ساعَةً فَتَرومَ عَقلاً","لِعَنسِكَ أَم خُلِقتَ بِغَيرِ عَقلِ",87,"ل",1,0],["أَتَعجَبُ مِن مُلوكِ الأَرضِ أَمسَوا","لِلَذّاتِ النُفوسِ عَبيدَ قِنِّ",88,"ن",1,0],["أَتَعلَمُ الأَرضُ وَهيَ أُمٌّ","خَفَّ زَمانٌ فَما اِزدَهاها",89,"ا",3,0],["أَتَعلَمُ جارِساتٌ في جِبالٍ","أَراها قَبلَها سَلَفٌ أَراها",90,"ا",3,0],["أَتَعرِفُ رَسمَ الدارِ قَفراً مَنازِلُه","كَجَفنِ اليَمانِ زَخرَفَ الوَشيَ ماثِلُه",91,"ل",2,1],["أتْعَبتَ نفسَكَ في نصيحَة مَن يَرى","أنْ لا يرى الإِقبالَ والإِفلاحا",92,"ح",2,0],["أتعبتني الأيام إذ كنت حيا","فأنا اليوم للسكون فقير",93,"ر",1,0],["أَتعود بعد تصرم ونفادِ","أيام بغدادٍ إلى بغدادِ",94,"د",1,1]