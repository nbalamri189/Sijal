{"poems":[[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[45,"تريك الذي حدثت عنه من السحر","https://www.aldiwan.net/poem63612.html","الطويل"],[45,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[61,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[48,"متتايه بجماله صلف","https://www.aldiwan.net/poem66181.html","الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[257,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[278,"لاح الهلال كما تعوج مرهفا","https://www.aldiwan.net/poem60618.html","الكامل"],[362,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[400,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[406,"هذا كتاب فتى أحلته النوى","https://www.aldiwan.net/poem32249.html","الكامل"],[413,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[459,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[513,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[538,"متتبع خطأي يود لو انني","https://www.aldiwan.net/poem56751.html","الطويل"],[565,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"]],"verses":[["مُتَتابِعاً كتَتابُعِ الأيّامِ لا","يَذَرُ التّعاقُبَ جُمْعَةً وخَميسا",0,"س",2,0],["مُتتابعَ الأسقام من تُخمَاتِهِ","لا يَشفِ ذاك الداء طبُّ طبيبِ",1,"ب",1,0],["مَتَتُّ بِأَسبابٍ إِلَيهِ كَثيرَةٍ","وَقَد تُدرِكُ الحاجاتُ بِالسَبَبِ النَزرِ",2,"ر",1,0],["مُتَتابَعَ السَرّاءِ وَالضَرّاءِ لَم","يُخلَق هَيوباً لِلخُطوبِ هَلوعا",3,"ع",2,0],["متتابعُ المعروفِ يَنبُعُ في النَّدى","والبأسِ أدواءٌ له وتَبايعا",4,"ع",2,0],["مَتَتُّ إِلَيهِ بِالقَرابَةِ بَينَنا","وَبِالرَحِمِ الدُنيا فَأَغنَت عَنِ الوُدِّ",5,"د",1,0],["مُتَتايِهٍ بِجَمالِهِ صَلِفٌ","لا يُستَتاعُ كَلامُهُ تيها",6,"ي",3,1],["مُتَتابِعينَ فَبايَعوهُ بِبَيعَةٍ","عُقِدَت بِحُسنِ السَمعِ وَالآذانِ",7,"ن",1,0],["مت تعش في ظلال روض التجلّي","تجنِ فيه قطوف عيشٍ هنيّ",8,"ي",1,0],["مُتَتابِعَيْنِ تَتابُعَ الْكَعْبَيْنِ فِي","رُمْحٍ أُقِيمَ الصَّدْرُ مِنْهُ وَثُقِّفا",9,"ف",2,0],["مُتتبِّعوكَ وما رأَوْا لكَ عَثْرةً","ويُواصلونَ عِثارَهمْ وتُقيل",10,"ل",1,0],["متتبعاً من درها في قعرها","حلياً لجيد نظائري ومعاشري",11,"ي",1,0],["مُتَتَابعِ الزّفَرات بَين ضُلوعِه","قَلبٌ يبوحُ بسرِّهِ خَفقَانُهُ",12,"ن",2,0],["متتابع النعماء جلَّ مآربي","فيه ومعظم ثروتي من ماله",13,"ل",2,0],["مُتَتابعٍ جَمٍّ كأنَّ سَحابهُ","كبَّاتُ قيصَر أو سرايا تُبَّعِ",14,"ع",1,0],["متتابع كالغيث إلا أنه","يهمي ولا ينسى أخير أولا",15,"ل",2,0],["مُتَتَبِّعٌ خَطأي يَودُّ لَوَ اَنَّني","هابٍ بِمدرَجَةِ الصِبا مَنسوعُ",16,"ع",1,1],["مُتَتَايِهُ التَّكْرِيْهِ يُحْسَبُ ظَالِماً","فَإِذَا دَنَا فَكَأَنَّهُ مَظْلومُ",17,"م",1,0]]}