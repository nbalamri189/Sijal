{"poems":[[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[53,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[47,"تريك الذي حدثت عنه من السحر","https://www.aldiwan.net/poem63612.html","الطويل"],[47,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[63,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[46,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[50,"متتايه بجماله صلف","https://www.aldiwan.net/poem66181.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[264,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[285,"لاح الهلال كما تعوج مرهفا","https://www.aldiwan.net/poem60618.html","الكامل"],[369,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[409,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[415,"هذا كتاب فتى أحلته النوى","https://www.aldiwan.net/poem32249.html","الكامل"],[422,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[545,"متتبع خطأي يود لو انني","https://www.aldiwan.net/poem56751.html","الطويل"],[572,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122672","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96629","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49936","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122023","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79950","الكامل"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71059","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53083","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132711","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129374","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4343,"","https://poetry.dctabudhabi.ae/diwan/poem/123795","الكامل"],[5442,"العيد عيد مهنأ بقبوله","https://www.poetsgate.com/ViewPoem.aspx?id=114786",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[402,"إلى مصر أزف عن الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=36214",""],[5943,"شوق","https://www.poetsgate.com/ViewPoem.aspx?id=11024",""],[6032,"طنب الجريحة","https://www.poetsgate.com/ViewPoem.aspx?id=181528",""],[6093,"مبتدا وخبر(مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=178393",""]],"verses":[["مُتَتابِعاً كتَتابُعِ الأيّامِ لا","يَذَرُ التّعاقُبَ جُمْعَةً وخَميسا",0,"س",2,0],["مُتتابعَ الأسقام من تُخمَاتِهِ","لا يَشفِ ذاك الداء طبُّ طبيبِ",1,"ب",1,0],["مَتَتُّ بِأَسبابٍ إِلَيهِ كَثيرَةٍ","وَقَد تُدرِكُ الحاجاتُ بِالسَبَبِ النَزرِ",2,"ر",1,0],["مُتَتابَعَ السَرّاءِ وَالضَرّاءِ لَم","يُخلَق هَيوباً لِلخُطوبِ هَلوعا",3,"ع",2,0],["متتابعُ المعروفِ يَنبُعُ في النَّدى","والبأسِ أدواءٌ له وتَبايعا",4,"ع",2,0],["مَتَتُّ إِلَيهِ بِالقَرابَةِ بَينَنا","وَبِالرَحِمِ الدُنيا فَأَغنَت عَنِ الوُدِّ",5,"د",1,0],["مُتَتايِهٍ بِجَمالِهِ صَلِفٌ","لا يُستَتاعُ كَلامُهُ تيها",6,"ي",3,1],["مُتَتابِعينَ فَبايَعوهُ بِبَيعَةٍ","عُقِدَت بِحُسنِ السَمعِ وَالآذانِ",7,"ن",1,0],["مت تعش في ظلال روض التجلّي","تجنِ فيه قطوف عيشٍ هنيّ",8,"ي",1,0],["مُتَتابِعَيْنِ تَتابُعَ الْكَعْبَيْنِ فِي","رُمْحٍ أُقِيمَ الصَّدْرُ مِنْهُ وَثُقِّفا",9,"ف",2,0],["مُتتبِّعوكَ وما رأَوْا لكَ عَثْرةً","ويُواصلونَ عِثارَهمْ وتُقيل",10,"ل",1,0],["متتبعاً من درها في قعرها","حلياً لجيد نظائري ومعاشري",11,"ر",2,0],["مُتَتَابعِ الزّفَرات بَين ضُلوعِه","قَلبٌ يبوحُ بسرِّهِ خَفقَانُهُ",12,"ن",2,0],["متتابع النعماء جلَّ مآربي","فيه ومعظم ثروتي من ماله",13,"ل",2,0],["مُتَتابعٍ جَمٍّ كأنَّ سَحابهُ","كبَّاتُ قيصَر أو سرايا تُبَّعِ",14,"ع",1,0],["متتابع كالغيث إلا أنه","يهمي ولا ينسى أخير أولا",15,"ل",2,0],["مُتَتَبِّعٌ خَطأي يَودُّ لَوَ اَنَّني","هابٍ بِمدرَجَةِ الصِبا مَنسوعُ",16,"ع",1,1],["مُتَتَايِهُ التَّكْرِيْهِ يُحْسَبُ ظَالِماً","فَإِذَا دَنَا فَكَأَنَّهُ مَظْلومُ",17,"م",1,0],["مُتَتابِعُ المَعرُوفِ يَفرِشُ ضَيفَه","خُلُقاً إذا ضاقَ الزَّمانُ وُسُوعا",18,"ع",2,0],["متتوّج تاجَ العلا","مُتسربلاً بالسؤددِ",19,"د",1,0],["متتابعَ الرّوعاتِ بالأصْوات من","زَجْر الحُداةِ ومن نعيبِ الشُّحّجِ",20,"ج",1,0],["مَتَتْتَ وَبَعْدَ الْمُلْكِ أَسْجَحْتَ مُنْعِماً","فَلِلَّهِ مَا أَسْدَيْتَ فَضْلاً وَمَا تُسْدِي",21,"د",2,0],["مُت تحتَ ظلِّ المرهفاتِ","فإنَّ هذا العمر فاني",22,"ن",2,0],["متتبعا نهج الصواب، مجافيا","نهج الغلو، وإن أصبت قليلا",23,"ل",2,0],["مُتَتابعُ الزَّفَرات يُرْجِعُ غَمْرُها","عُوَج الضلوع بها إلى التقويم",24,"م",1,0],["متتوج تزجى الركائب باسمه","متبلج ترجى وفود وفوده",25,"د",2,0],["مُتَتابِعٌ كَفِتٌ كَأَنَّ صَهيلَهُ","جَرسٌ تَضَمَّنَ صَوتَهُ الحُلقومُ",26,"م",1,0],["مُتَتَبِّعٌ لِطلابه فَكَأنهُ","في القيظ يَطلبُ ظلَّهُ لمقيلِ",27,"ل",1,0],["متتبعاً نهج الرضا ان الرضا","نعم الدليل لحائر ومضلل",28,"ل",1,0],["متتوِّجاً تاجَ الجَلالَةِ لابِسا","حُلَلَ الوَقارِ وَأَنتَ فيها أَليقُ",29,"ق",1,0],["متتاليا بسوابق وسوابغ","ومغافر وعوامل وبواتر",30,"ر",1,0],["متتبعاً للتائهين على","بعد المسافة أينما حلَّوا",31,"ل",3,0],["متت طرفي في بديع محاسن","من وجهه الزاكي بمسك نواس",32,"س",1,0],["متتبع طرق الحلال وإن نأت","في شربه ورعاً وفي مأكوله",33,"ل",2,0],["مُتَتَوِّجٌ تاجَ العُلا مُتَحَمِّلٌ","يَوْمَ المَغارِمِ وَالنَّدَى الأَثْقالا",34,"ل",2,0],["متتم إمارة الأصل المعلى","بفضل باذخ كالأصل سام",35,"م",1,0],["متتبعٌ طيفًا أطلَّ بما","فيه لقاءٌ بالمنى سعدُ",36,"د",1,0],["متتشدقين بقدرة في شأنهم","بئسوا بذاك الوهم والطغيان ِ",37,"ن",1,0],["مُتَتَبِّعاً أثر الضِّيا","كالشمسِ يتبعُهَا القَمرْ",38,"ر",1,0]]}