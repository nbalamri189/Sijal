{"poems":[[53,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[83,"وغريبة قطعت إليك على الونى","https://www.aldiwan.net/poem54295.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[72,"زحفت بيض الظبا لما رنا","https://www.aldiwan.net/poem20619.html","الرمل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"قلبي من الضيق مما ضم قرقرها","https://www.aldiwan.net/poem64024.html","البسيط"],[51,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[92,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[66,"رقت لنا حين هم الصبح بالسفر","https://www.aldiwan.net/poem38492.html","البسيط"],[66,"وأغن مسكي الإهاب ووجهه","https://www.aldiwan.net/poem39216.html","الكامل"],[66,"كيف صبري وأنت للعين قره","https://www.aldiwan.net/poem39667.html","الخفيف"],[66,"راقني من لفظك المستطاب","https://www.aldiwan.net/poem40337.html","المديد"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[74,"يا لين عطفي واخضرار جنابي","https://www.aldiwan.net/poem12874.html","الكامل"],[81,"أهدت نجاتك عوذة المتخوف","https://www.aldiwan.net/poem61460.html","الطويل"],[81,"أخذوا موثق العذار على الخد","https://www.aldiwan.net/poem61501.html","الخفيف"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"وغريرة في المكتبه","https://www.aldiwan.net/poem33124.html","مجزوء الكامل"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141992","الرمل"],[106,"مأتم الخلق!","https://www.poetsgate.com/ViewPoem.aspx?id=179664",""],[100,"كلّنا في انتظار ميلاد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50117",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[102,"غريرة في المكتبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5759&r=&rc=1",""],[96,"الشّاطئ المهجور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66348&r=&rc=24",""],[109,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[132,"راق قلبي ومقلتي والطور","https://www.aldiwan.net/poem54825.html","الطويل"],[132,"أبدلت راءها بظاء فتاة","https://www.aldiwan.net/poem54899.html","الخفيف"],[133,"بجد عزمك نال الدين ما طلبا","https://www.aldiwan.net/poem4249.html","البسيط"],[135,"أحسن الأيام أيام التلاق","https://www.aldiwan.net/poem49117.html","الرمل"],[160,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[164,"رب ليل أطاله ألم الشوق","https://www.aldiwan.net/poem67868.html","الخفيف"],[182,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[182,"رواية جاد منشيها اللبيب بما","https://www.aldiwan.net/poem67084.html","البسيط"],[185,"لله حمام كروض أنيق","https://www.aldiwan.net/poem14603.html","السريع"],[189,"زعموني أحب هندا وميا","https://www.aldiwan.net/poem35145.html","الخفيف"],[193,"يا جميل الظن بالأيام","https://www.aldiwan.net/poem13092.html","مجزوء الرمل"],[230,"نمت على نفس الشمال شمول","https://www.aldiwan.net/poem4042.html","الكامل"],[230,"يا مولعا بالبهار زرنا","https://www.aldiwan.net/poem4053.html","مخلع البسيط"],[232,"هبت نسيمة رامة فتأرقا","https://www.aldiwan.net/poem14840.html","الكامل"],[237,"كل يوم لك عيد الودود","https://www.aldiwan.net/poem18177.html","المديد"],[237,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[237,"راقت عشية رأس الطرف طرف فتى","https://www.aldiwan.net/poem19501.html","البسيط"],[250,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[275,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[275,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[304,"يا وجيه الدين والكرم","https://www.aldiwan.net/poem16840.html","المديد"],[320,"لست أنسى يوما لمجلس أنس","https://www.aldiwan.net/poem61649.html","البسيط"],[353,"يا حسن مرآة زها حسنها","https://www.aldiwan.net/poem40187.html","السريع"],[353,"تقارن النيران الشمس والقمر","https://www.aldiwan.net/poem40339.html","البسيط"],[367,"راقه منها بياض ناصع","https://www.aldiwan.net/poem4619.html","الرمل"],[394,"قيس وليلى","https://www.aldiwan.net/poem24310.html","عموديه"],[400,"تشكو الفتاوى","https://www.aldiwan.net/poem6741.html","عموديه"],[403,"قف وقفة العبد الذليل الحقير","https://www.aldiwan.net/poem33747.html","السريع"],[403,"آه يا قلب إلى كم ذا التصابي","https://www.aldiwan.net/poem34162.html","الرمل"],[409,"ما لي رأيت الثلج عمم شيبه","https://www.aldiwan.net/poem31982.html","الكامل"],[409,"كم إلى كم أكاتم الناس","https://www.aldiwan.net/poem32596.html","مخلع البسيط"],[416,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[429,"راقت لعينيك يوم البين دمياط","https://www.aldiwan.net/poem40264.html","البسيط"],[429,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[429,"أقبلت تنثني بأعدل قامه","https://www.aldiwan.net/poem40713.html","الخفيف"],[429,"بسم السرور فسرت الأحياء","https://www.aldiwan.net/poem40833.html","الكامل"],[432,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[435,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[458,"قل لها أيها الخيال الطروق","https://www.aldiwan.net/poem56105.html","الخفيف"],[464,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[464,"وبروحي من وجهه شفقي اللون","https://www.aldiwan.net/poem3257.html","عموديه"],[464,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[464,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[464,"راقت الخمر وقد رق النسيم","https://www.aldiwan.net/poem3418.html","عموديه"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[468,"راق الوصال من الجفاء","https://www.aldiwan.net/poem60517.html","مجزوء الكامل"],[468,"راقبتني العيون فيك فأشفق","https://www.aldiwan.net/poem60549.html","الخفيف"],[479,"سيقارة لطيفة","https://www.aldiwan.net/poem36886.html","مجزوء الرجز"],[479,"راق النشيد ورقت نغمة العود","https://www.aldiwan.net/poem37170.html","البسيط"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[500,"دار الولي إذا ما مات عامرة","https://www.aldiwan.net/poem37758.html","البسيط"],[514,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[529,"قل للإمام ابن الإمام","https://www.aldiwan.net/poem37134.html","مجزوء الرجز"],[551,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[558,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[562,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[562,"ربيبة من ذوات الغنج والحور","https://www.aldiwan.net/poem52918.html","البسيط"],[562,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[584,"راقص فدتك نفسي","https://www.aldiwan.net/poem69377.html","مجزوء الرجز"]],"verses":[["راقٍ تَفَرَّدَ بِالإِحسانِ يَفرَعُها","وَزايَدَ النَجمَ في العَلياءِ وَاِشتَرَكا",0,"ك",2,0],["راق العيونَ أديمها فكأنه","روضٌ تفتح عن شقيق بهارِ",1,"ر",1,0],["راقت بدائعُ وشيها فكأنها","وشيُ الربيع بمسقط الأنداءِ",2,"ا",2,0],["راقت مبانيه اتقاناً وهندسةً","مستوقفاً صنعها من مرّ عجلانا",3,"ن",2,0],["راقبَ الله وأسدى المننا","فهوَ الوسميّ فينا والولي",4,"ي",1,0],["راقِي صَعُودٍ من العلا أبداً","إذا تهاوَى بحارضٍ صَبَبُهْ",5,"ب",2,0],["راقتْ محاسنها عيناً أراق دماً","بعد الدموع حذارَ البين مَحْجِرُها",6,"ر",3,0],["راقتِ النَّاس منظراً ومَشمّاً","فهْيَ ريحانةٌ لهمْ مشمومه",7,"م",2,0],["راق معنىً ورقّ لفظاً فيحكي","رائقَ الخمر في رقيق الصِّحان",8,"ن",1,0],["راقِصاتٍ يخلُبْنَ في حَلَكِ اللَّيلِ","ويلعبْنَ بالقُلوبِ الدَّوامي",9,"ي",1,0],["راقَ العِتابُ فَأَبدَت لي سَرائِرَها","في لَيلَةِ الوَصلِ بَل في غُرَّةِ القَمَرِ",10,"ر",1,0],["راقَ العُيونِ بِمَنظَرٍ ذي بَهجَةٍ","وَنَواظِرٍ مِنها الدِماءُ تِراقُ",11,"ق",1,0],["راقِبِ اللَهَ في حُشاشَةِ نَفسي","إِنَّهُ لا يَضيعُ مِثقالُ ذَرَّه",12,"ر",2,0],["راقَني مِن لَفظِكَ المُستَطابِ","حِكمَةٌ فيهِ وَفَصلُ الخِطابِ",13,"ب",1,1],["راقصات فوق أشلاء الهوى","معولات فوق أجداث الأمل",14,"ل",1,0],["راقا وَرَقّا فَاِلتَقى بِهِما مَعاً","ثَغرُ الحَبابِ وَأَوجُهُ الأَحبابِ",15,"ب",1,0],["راقَتكَ تَسهيماً وَصابَت أَسهُماً","فَأَتَتكَ بَينَ مُفَوَّقٍ وَمُفَوَّفِ",16,"ف",1,0],["راقَ خَلقاً وَفاقَ خُلُقاً فَقُلنا","أَنجُمُ الأُفقِ أَم نُجومُ المَعالي",17,"ي",1,0],["راقِدٌ يَنعمُ في ضجعته","خلّف الدُنيا بِهِ في شغلِ",18,"ل",1,0],["راقبتُها فشهدتُ أن","نَ الله أْجزَلَ في الهبةَ",19,"ب",2,0],["راقَبَت وُدّي فَلَمّا اِستَمكَنَت","وَضَعَت نيراً عَلى غَيرِ سَدا",20,"د",2,0],["راقَهُمْ مَنْظَراً وهَابوهُ خَوْفاً","فهْوَ مِلءُ العُيونِ مِلء الصّدورِ",21,"ر",1,0],["راقصاتِ الأمواج علِّمْنَ قلبي","رقصاتِ المغرِّدِ المطرابِ",22,"ب",1,0],["راقصاتٍ به على هزَجِ المو","جِ عرايا مهدَّلاتِ الشعورِ",23,"ر",1,0],["راقصاً بين ازرقاق الجدول","والسما الزرقاء",24,"ا",2,0],["راقَ العيونَ على الكرسيِّ منظرُهُ","حتى إذا خانه الكرسُّي، لم يَرُقِ",25,"ق",1,0],["راقد في الطريق يتّسد الصم","ت º ويومي بألف ناب ، وظفر",26,"ر",1,0],["راقت الوحدةُ لي في غربتي","أنا لا أهوى ضجيج الزُمِر",27,"ر",1,0],["رَاقَبْتُهَا فَشَهِدْتُ أَنَّ","اللهَ أَجْزَلَ في الْهِبَهْ",28,"ب",2,0],["راقصات به على هزج الم","ج عريا مهدّلات الشّعور",29,"ر",1,0],["راقياً بِالفَخار كُل عَليٍّ","ساحِباً فَوقَ هامة الشُهب ردنا",30,"ن",2,0],["رَاقَ قَلبِي ومُقلَتِي والطُّورِ","مَا أَتى فِي كِتَابِكَ المَسطُورِ",31,"ر",1,1],["رَاقني ما تقولُ في الرَّاءِ حَتَّى","غَيرةً صِرتُ اقتَفِيهِ إقتِفَاءَ",32,"ا",2,0],["راقَ النضارُ عُيونَ الناظرينَ وقَد","غُدا اسمُكَ المُعتلي أعلاهُ مُكتتبا",33,"ب",2,0],["راق لفظاً وتسامى رتبةً","وهو طولُ الدهرِ في العلياءِ راقْ",34,"ق",1,0],["راقت ورقت جلابيب النسيم بها","لما بدا الغيم في أبراده الصفق",35,"ق",1,0],["راقَهُ مَنظَرٌ أَنارَ فَأَورى","لِسَناهُ ضَوء الصَباحِ المُنيرُ",36,"ر",1,0],["راقَ البلَى في الأَسى وَرداً لِعاشِقها","فَلَم أَقُلْ يا عَذابي في الأَسى إِيها",37,"ي",3,0],["راقَى سَماءَ عُلىً جازَت مَعارِجُها ال","اكفاءَ وَاِمَتَنَعَتْ عَمَن يُحاكيها",37,"ي",3,0],["راقَت بِها كَلمٌ جاءَت بِسُؤدُدِهِ","تَحكي عُقوداً بِهِ فاقَت لَآليها",37,"ي",3,0],["راقَت مَحاضِرُها أُنساً وَقَد أَخَذَتْ","مِن حاضريها بِأَسماعٍ وَأَلبابِ",38,"ب",1,0],["راقتْ حياضا فأقلُّ القَذى","فيها كشمسٍ تحت غيمٍ رقيق",39,"ق",1,0],["راقَ للعالمينَ عذب هداهُ","وَعَلى العرشِ قد أناف رقيّا",40,"ي",2,0],["راقِبِ اللَهَ وَفَرّغ","لِلتُقى وَالخَيرِ ذِهنَك",41,"ك",1,0],["راقَتْ ورقتْ في العيانِ فلمْ يَنلْ","إدْراكَهَا وصْفٌ ولا تَمْثيلُ",42,"ل",1,0],["راقَ سَناهُ العُيُونَ لما","واسَطَ مُبْيَضه اصْفِرَارُ",43,"ر",1,0],["راقَ الفِراقُ لِجيرَةٍ مِن بَعدِهِم","ما راقَ لي عَيشٌ وَلا جَفني رَقا",44,"ق",2,0],["رَاقَ فِي جِيدِ الزمانِ حُلاَهُ","مِثْلَ مَا رَاقَ حُلَيٌّ بِجِيدِ",45,"د",1,0],["رَاقَتْ فَرَاقَ نَسِيبِي","فَهَامَ وَصْفِي بِرَصْفِي",46,"ف",2,0],["رَاقَتْ عَشِيَّةُ رَأْسِ الطَّرْفِ طَرْفَ فَتىً","لَمْ يَثْنِ رَأْسَ الْجَوَى عَنْ قَلْبِهَ طَرْفهْ",47,"ف",2,1],["راق طرفي من خدِّه الأحمر والأبيَ","ضِ ذاك التذهيبُ والتَّفضيضُ",48,"ض",1,0],["رَاقِي الرِّواقِ علَى الأَفْلاكِ صَاعِدُهُ","فَمَنْ يُعَالِيهِ فَرداً في مَعَالِيهِ",49,"ي",2,0],["رَاقَ الرِّيَاحَ بِذِكْرِهِ فَإِذا","نَشَرَتْ مَحَاسِنَهُ انْطَوَى الغَزَلُ",50,"ل",1,0],["راق معناها وصورتها","فغدت من أحسن الكلم",51,"م",1,0],["راقٍ مَعنى وَرقٍ طَبعاً خَصرا","وَاِختِصاراً قَد أَعدَمَ العَقلَ رُشدَه",52,"د",2,0],["راقَت وَرَقّ الطَبع حَتّى غَدَت","كَالماء في الرقّة إِذ يقطرُ",53,"ر",1,0],["راقَت وَرقّت على صَفوٍ مَناهلها","حَتّى اِنتَفى الشائِبان الهمّ وَالكَدَرُ",54,"ر",1,0],["راقَهُ مِنها بَياضٌ ناصِعٌ","يُؤْنِقُ العَينَ وَضافٍ مُسبَكِرّْ",55,"ر",1,1],["راقدا عند حافة القبر لا يف","تأ يشكو إلى الصبا والغيوم",56,"م",1,0]