{"poems":[[95,"يا شاعر النيل جار النيل بالشيم","https://www.aldiwan.net/poem11298.html","البسيط"],[90,"من مبسم الغازي إلى الفاروق","https://www.aldiwan.net/poem44800.html","الكامل"],[29,"سرت الهموم فبتن غير نيام","https://www.aldiwan.net/poem6021.html","الكامل"],[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[48,"أجزاء دهر ينقضين ولم يكن","https://www.aldiwan.net/poem22576.html","الكامل"],[62,"لا تعذليه فإن العذل يولعه","https://www.poetsgate.com/ViewPoem.aspx?id=15018",""],[136,"بلغ سلامى إذا جئت البتول لها","https://www.aldiwan.net/poem54771.html","البسيط"],[237,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[266,"كف العتاب فما يمل العاتب","https://www.aldiwan.net/poem38371.html","الكامل"],[276,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[302,"وافتك تنهج للخطاب سبيلا","https://www.aldiwan.net/poem33192.html","الكامل"],[315,"حي المعاهد كانت قبل تحييني","https://www.aldiwan.net/poem59516.html","البسيط"],[422,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[534,"بالله يا علم الهدى","https://www.aldiwan.net/poem37382.html","مجزوء الكامل"],[543,"شوقا أجبت إلى وقوفك في منى","https://www.aldiwan.net/poem47602.html","عموديه"],[556,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[580,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48632","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62454","الكامل"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100619","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49045","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89526","البسيط"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131369","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52989","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48309","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66532","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77076","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125808","الكامل"],[4830,"فريضةُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=204758",""],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[5273,"رسول النواعير","https://www.poetsgate.com/ViewPoem.aspx?id=215990",""],[5519,"دموع !!!","https://www.poetsgate.com/ViewPoem.aspx?id=13093",""],[5660,"إِنَّ البُكاءَ لَدى التَّفَرُّقِ أَجمَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24647",""],[5956,"الحب الخائب","https://www.poetsgate.com/ViewPoem.aspx?id=181997",""],[5956,"هيئتها كرؤوسُ العيس","https://www.poetsgate.com/ViewPoem.aspx?id=183158",""],[5956,"وداعاً للغيريَّة","https://www.poetsgate.com/ViewPoem.aspx?id=183735",""],[5956,"لا تعط خيرات لأهل الضغنِ","https://www.poetsgate.com/ViewPoem.aspx?id=184143",""],[5956,"سابقاني نحو السما","https://www.poetsgate.com/ViewPoem.aspx?id=192101",""],[5956,"سابقونا نحو السما","https://www.poetsgate.com/ViewPoem.aspx?id=193893",""],[5956,"متوسّم فيه السموَّ إلى الذرى","https://www.poetsgate.com/ViewPoem.aspx?id=193978",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""],[5956,"هذي الحياة مشقة ومشاكلُ","https://www.poetsgate.com/ViewPoem.aspx?id=203755",""],[5956,"ودّعتُ حبَّه مِن صَوبي","https://www.poetsgate.com/ViewPoem.aspx?id=204250",""]],"verses":[["إِنِّي أَوَدُّ لَهَا وَصْفاً وَيَرْجِعُنِي","عَنْهُ قُصُورِي إِذَا حَثَّ الْهَوَى قَلَمِي",0,"م",2,0],["إني أودّعكم ودَاع مواصل","يرجو اللَحاق بكم بلا تعويق",1,"ق",1,0],["إِنّي أُواصِلُ مَن أَرَدتُ وِصالَهُ","بِحِبالِ لا صَلِفٍ وَلا لَوّامِ",2,"م",1,0],["إِنّي أَوَسِّعُ عُذري فِي جَنايَتِهِ","بِالبينِ عِنهُ وَجُرمي لا يُوَسِّعُهُ",3,"ع",2,0],["إِنّي أُواري خَلَّتي فَأُريهِمُ","رِيّاً وَفي سِرِّ الفُؤادِ أَوارُ",4,"ر",1,0],["إِنّي أَوَسِّعُ عُذري فِي جَنايَتِهِ","بِالبينِ عِنهُ وَقلبي لا يُوَسِّعُهُ",5,"ع",2,0],["إني أُؤَمِّلُ منها أَن تُنَولني","لأنَّ مُنيَةَ نَفسِى أَن تُنَوِّلَهَا",6,"ل",3,0],["إِنّي أُؤَمِّلُ أَن أَرى لَكَ عارِضاً","فَلَعَلَّهُ عَنّي الظَلام يُكشِفُ",7,"ف",1,0],["إني أؤمل يوم جاءتك المنى","ببشائر ترقي لها وتراقب",8,"ب",1,0],["اني أَورى لِغَيري حينَ يَسألني","بذكر زينَب عَن لَيلى فأوهمه",9,"م",2,0],["إِنّي أؤمِّل أَن أُزيل بكَ الجَوى","وأبلُّ من حرِّ الفؤادِ غَليلا",10,"ل",2,0],["أني أويت من العليا إلى حرم","كادت مغانيه بالبشرى تحييني",11,"ن",2,0],["إنِّي أؤمل أن أكون بفضله","ممَّن يؤمَّل فضله وعطاؤه",12,"ا",3,0],["أَنّي أَوَدُّ بِأَنْ تَمُدَّ","بِدَعْوَةٍ تَقْضِي الوَطَرْ",13,"ر",1,0],["إنِّي أودِّع مِنك قلباً صَادِقاً","حاشَاه ينسَانِي هُنَالك أَو هُنَا",14,"ن",2,0],["إنّي أودّك والمود","دَةُ خيرُ ما حُبِيَ الأنامُ",15,"م",1,0],["إِني أُؤمِّل أَن أَكو","نَ أَجلَّ مَنْ وَالاَك قَسْما",16,"م",2,0],["إني أود لقومك ال","حكم النزيه من الشوائبْ",17,"ب",1,0],["إني أودّهم وأبغض منصباً","لسواهم ووداد غيرهم سمجْ",18,"ج",1,0],["اني اودُّ دنوّهُ","مني يكون مؤبَّدا",19,"د",2,0],["إني أؤيد شوقي في تعرّضهِ","شيخَ المعرّةِ في هذا جناه أَبي",20,"ي",1,0],["أَنّي أَوَيتُ مِنَ العَليا إِلى حَرَمٍ","قَبلَ الإِناخَةِ بِالبُشرى يُحَيّيني",21,"ن",2,0],["إني أوافقه حقا وأتبعه","هل مهتد ناعلٌ كالحائر الحاف",22,"ف",1,0],["إني أورِّي عَذُولي حين يسألني","بذكر زينب عن ليلى فأوهمه",23,"م",2,0],["أنّى أوَفّي وقدْ أصْبَحْتُ ممْتدِحاً","ذاتاً بآيِ كِتاب اللهِ قد مُدِحَتْ",24,"ت",1,0],["إني أوسّع عذري في جنايتِهِ","بالبين مني وجرمي لا يوسِّعُهُ",25,"ه",1,0],["إنّي أَوَدُّ إِذْا وَطِئْتُمْ أَرْضَها","لَو أنَّ تُرْبَتَها لِعَينَيْ إثْمِدُ",26,"د",1,0],["إِنّي أُؤمِل مِن خِلّي مُعامَلَتي","لِسَترِ تَقصير هذا المُخلِص الخجل",27,"ل",1,0],["إِنّي أُؤدي كَنه اِجلال الَّتي","خاضَت لِلقِياي الخضم الأَدكَنا",28,"ن",2,0],["إني أؤمل إذ رأيتك باسماً","أن تنجلي عنا غيوم غياهب",29,"ب",1,0],["اِنّي اُُوَلّي شَطْرَهُ مُتَزَلّفاً","مااِنْ سمعتُ مؤذناً وقتَ الصلاةْ",30,"ه",1,0],["إني أويت لكل مأوى في الحياة","فما رأيت أعز من مأواكا",31,"ك",2,0],["أنّي أواعِدُ طيفًا بالخفاءِ ولا","يُفيدُ حِرصِيَ إمّا خَاتَلَ القَدَرا",32,"ر",2,0],["إنّي أواري جبيني عن ليالينا","حين استوىالبدر ينسيني تجافينا",33,"ن",2,0],["إِنّي أَوَدُّ صَغيرَكُم وَ كَبيرَكُم","وَ رِجالَكُم وَ نِسائَكُم لا أُغفِلُ",34,"ل",1,0],["إني أواسي الذي خابت محبتُهُ","ولم يَدَعْ حسرةً في القلب تحتدمُ",35,"م",1,0],["إني أودّع زهراً لا أفارقه","إلا وحسرةُ قلبي في ذؤابتها",36,"ت",3,0],["إني أودع منتهى غيريَّتي","وسخرت منها بادئاً عصرَ ‏اْلهنا",37,"ن",2,0],["‏ ‏إني أودِّعهم وداعاً دائماً","‏ ‏ لا يستحقه غير أهلِ الضَّنِّ",38,"ن",1,0],["إني أواسي الأهلَ - آهِ – أحِبُّهم","وأريد منهم أن يحبوني كما..",39,"م",2,0],["إني أواسي أهلنا وأحِبُّهم","وأريد منهم أن يحبوني كما..",40,"م",2,0],["إني أُؤيده بمِلء قصائدي","وجوارحي لمراتب التقديسِ",41,"س",1,0],["إني أواسيهم ومعتذر عنِ الت","تّقصير بالإيثارِ والأشعارِ",42,"ر",1,0],["إني أودِّعهم جميعاً مدركاً","أني قريباً عن ثراهم راحلُ",43,"ل",1,0],["إني أودع هذا الحبَّ من طرفي","ما دام قلبُ حبيبي ما تَقَبَّلَهُ",44,"ل",2,0]]}