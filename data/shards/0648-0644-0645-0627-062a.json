7.html","الطويل"],[464,"ولما توسطنا مدى النيل غدوة","https://www.aldiwan.net/poem3201.html","عموديه"],[466,"بنفسي من لا بد أني هاجره","https://www.aldiwan.net/poem50433.html","الطويل"],[468,"ولما تبدى الصبح في أثر الفجر","https://www.aldiwan.net/poem60111.html","الطويل"],[477,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[477,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[477,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[477,"متى ينجلي بالقرب ذا الناظر القذي","https://www.aldiwan.net/poem15282.html","الطويل"],[500,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[500,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[500,"أعد ذكر من نهوى فنحن على الهوى","https://www.aldiwan.net/poem38056.html","البسيط"],[506,"ألا هل نسيم للرصافي مبلغ","https://www.aldiwan.net/poem2464.html","الطويل"],[515,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[515,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[515,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[540,"ولم أتنحل الأشعار فيها","https://www.aldiwan.net/poem56857.html","الوافر"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"ولما تعانقنا ولم يك بيننا","https://www.aldiwan.net/poem47150.html","الطويل"],[551,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[551,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[551,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[551,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[551,"حللت بنا والليل مرخ سدوله","https://www.aldiwan.net/poem47374.html","الطويل"],[551,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[551,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[551,"ومنتقبات بالجمال على منى","https://www.aldiwan.net/poem47763.html","الطويل"],[551,"أيا زائرا بالليل من غير أن يسري","https://www.aldiwan.net/poem47771.html","الطويل"],[551,"أتتني كما بلغت منية","https://www.aldiwan.net/poem47799.html","المتقارب"],[551,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[551,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[551,"ولما تفرقنا كما شاءت النوى","https://www.aldiwan.net/poem47872.html","الطويل"],[551,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[551,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[551,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[553,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[558,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[558,"أنا الهيكل الذاتي لمظهر قدرة","https://www.aldiwan.net/poem34334.html","الطويل"],[567,"وجارية مثل شمس النهار","https://www.aldiwan.net/poem69698.html","المتقارب"],[575,"تلاقى تلاقي سورة ليس تعلم","https://www.aldiwan.net/poem2857.html","الطويل"],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["وَلَمّا تَجاهَشنا البُكاءَ وَلَم نُطِق","عَنِ الوَجدِ إِقلاعاً عَذَرنا البَواكِيا",0,"ي",2,0],["وَلَمّا تَعاطَينا النِزالَ اِنبَرى لَنا","مَلَبٌّ عَلى أَعوادِهِ بِلُبانِ",1,"ن",1,0],["وَلَمّا تَواقَفنا ذَهَلتُ وَلَم يَحِن","لِطَيرِ قُلوبِ العاشِقينَ وُقوعُ",2,"ع",1,0],["وَلَمّا تاهَ مَدحي في","هِ دَلَّتهُ مَآثِرُه",3,"ر",2,0],["وَلَمّا تَدانى البَينُ قالَ لِيَ الهَوى","رُوَيداً وَقالَ القَلبُ أَينَ تُريدُ",4,"د",1,0],["وَلَمّا تَجَلَّتْ لِلوَداعِ وَأَشرَقَتْ","وجوهٌ كَأَنَّ الشَّمسَ مِنهُنَّ تَطلُعُ",5,"ع",1,0],["ولما تَنادَيْتُمُ بالرّحي","لِ لَمْ يَتْرُكِ الدّمْعُ سِراً مَصونا",6,"ن",2,0],["ولمّا تَعانَقْنا فَذابَتْ عُقودُهُ","بِحَرِّ الجَوى صارَتْ ثُغوراً وأْمُعا",7,"ع",2,0],["وَلَمّا تَجاذَبنا السُيوفَ وَأُفرِغَت","ثِيابُ المَنايا كُنتُ أَوَّلَ لابِسِ",8,"س",1,0],["ولمّا ترعْرَعَ منْها البُسوقُ","وأجْمَعَ ريْعانُها واسْتَوى",9,"و",2,0],["ولمْ آتِ بحْرَ المَدْحِ فيكَ لِغايةٍ","تُرى دونَها الأبْصارُ حاسِرةَ الطّرْفِ",10,"ف",1,0],["ولَما تلاشَوْا جُفَّلاً ورَمتْ بهِمْ","أيْدي النّبيطِ أقاصيَ الأنْبارِ",11,"ر",1,0],["ولمّا تَفانى الصبْرُ إلا صُبابَةً","تسهِّلُ من وقعِ الحوادثِ ما اشْتَدّا",12,"د",2,0],["ولمّا تَناهى وَرْدُ خدِّكَ نظرةً","وأنْشأَ في طَيِّ القُلوبِ هِياجا",13,"ج",2,1],["وَلَمّا تَفعلوا إِلّا وَعيداً","كَفى بِوَعيدِكُم لَهُمُ قِتالا",14,"ل",2,0],["وَلَمّا تَلاقَينا جَرَت مِن عُيونِنا","دُموعٌ كَفَفنا ماءَها بِالأَصابِعِ",15,"ع",1,0],["وَلَمّا تَنَمَّت تَأَكُلُ الرِمَّ لَم تَدَع","ذَوابِلَ مِمّا يَجَمعونَ وَلا خُضرا",16,"ر",2,0],["ولما تراءى السرب قلت لصاحبي","وأيقنت أن الحبّ ما عشتُ دانيا",17,"ي",2,0],["ولما تناهى من يهودا خطابه","وقد سرّنا من حيث ندري ولا ندري",18,"ر",2,0],["ولم أتبَّين ما هنالك من علاً","لكثرة ما قد دبّ فيه نُحُول",19,"ل",1,0],["ولما تناهتْ في البكاء تضاحكت","من اليأس ضحك الهازئ المتهكّم",20,"م",1,0],["وَلَمّا تَغَشّى اللُؤمُ ما حَولَ أَنفِهِ","تَبَوَّأَ في الدارِ الَّتي لا يَريمُها",21,"م",3,0],["ولما تخلف عنك الدليل","رأوك لها جحفل الجحفل",22,"ل",1,0],["وَلَمّا تَخَيَّرتِ الأَخِلّاءَ لَم أَجِد","صَبوراً عَلى حِفظِ المَوَدَّةِ وَالعَهدِ",23,"د",1,1],["ولم أترشف بعد فيه مدامةً","على يده دفَّاعةً حجّةَ الحجى",24,"ج",2,0],["ولم أتلقَّ النهدَ في الصدر جالساً","وأسرى به حالي الشكيم مهملجا",24,"ج",2,0],["ولمَّا تجاذبنا العتاب موشعاً","نزول اليماني بالعتابِ الجمَّل",25,"ل",1,0],["ولم أتعلم قط من ذي سباحةٍ","سوى الغوص والمضعوف غيرُ مغالِب",26,"ب",1,0],["ولم أتنفس الصُّعداءَ لَهفاً","على عيشٍ تداعَى بانقضابِ",27,"ب",1,0],["وَلَمَا تلك ضَعْفَةٌ أنطق الل","هُ قديماً بغير تلك شَهيدَكْ",28,"ك",1,0],["ولما تولاها اسمُكَ الخير أصبحتْ","وجانبُها الوحشي باسمك آنس",29,"س",1,0],["ولما تنقَّصْتُ الفتى لكنه","لجميله بقبيحه متنقِّصُ",30,"ص",1,0],["ولما تناهى بي مسيري إليهمُ","أنختُ قلوصي في مُناخ قِلاص",31,"ص",1,0],["ولما تعمد رقهم لكنه","لا بد للمعروف من أرباق",32,"ق",1,0],["ولما تأملتَ الهلال ابن ليلة","تَكَبَّرَ إذ عاينتَه وتعظَّما",33,"م",2,0],["وَلَمّا تَطِب نَفسي بِإِرسالِها لَكُم","وَهَل يَنفَعَن نَفسي إِلَيكُم أَناتُها",34,"ت",3,0],["وَلَمّا تَبَيَّنّا ضَلالَةَ مُصعَبٍ","فَتَحنا لِأَهلِ الشامِ باباً مِنَ النَصرِ",35,"ر",1,0],["وَلَمّا تَوَلَّت دَراري السَماءُ","وَغابَ الهِلالُ عَنِ الناظِرِ",36,"ر",1,0],["ولم أتجنَّبْ وُعورَ الشِّعابِ","ولا كُبَّةَ اللَّهَبِ المُستَعِرْ",37,"ر",1,0],["ولما توردنا لسائمة دما","نفدى نفوسا ما لها من فادي",38,"ي",1,0],["وَلَمّا تَلَقّاكَ السَحابُ بِصَوبِهِ","تَلَقّاهُ أَعلى مِنهُ كَعباً وَأَكرَمُ",39,"م",1,0],["وَلَما تَفاضَلَتِ النُفوسُ وَدَبَّرَت","أَيدي الكُماةِ عَوالِيَ المُرّانِ",40,"ن",1,0],["ولم أتَّرِكْ أمراً أخافُ اغتيالَه","ولا طمعَت نفسي إلى غير مطمَع",41,"ع",1,0],["ولما تطارحنَا الأحاديثَ بيننَا","وبُحْنَا بأسرارِ القلوب ولم نكْنَ",42,"ن",1,0],["ولمَّا تراءَى السِّربُ قلت لصاحبي","لِيَهْنِكَ فيما لا يُنَالُ طموعُ",43,"ع",1,1],["وَلَمّا تَزايَلنا مِنَ الجِزعِ وَاِنتَأى","مُشَرِّقُ رَكبٍ مُصعِداً عَن مَغَرِّبِ",44,"ب",1,0],["وَلَمّا تَلاقَوا قُلتُ مَنٌّ وَنِعمَةٌ","مِنَ اللَهِ أَيُّ العُصبَتَينِ تَرَدَّتِ",45,"ت",1,0],["وَلَمّا تَلاقَوا عِندَ دِجلَةَ أَضمَرَت","مَهابَةَ أَشخاصِ المَوالي عَبيدُها",46,"د",3,0],["وَلَمّا تَوَلَّيتَ الرَعِيَّةَ مُحسِناً","مَنَعتَ أَقاصي سِر بِها أَن يُنَفَّرا",47,"ر",2,0],["وَلَمّا تَوَلّى البَحرَ وَالجودُ صِنوُهُ","غَدا البَحرُ مِن أَخلاقِهِ بَينَ أَبحُرِ",48,"ر",1,0],["وَلَمّا تَباذَينا فَرَرتُ مِنَ الخَنا","بِأَشياخِ صِدقٍ لَم يَفِرّوا مِنَ الزَحفِ",49,"ف",1,0],["وَلَمّا تَضَمَّنتَ أَمري قَعَد","تُ عَنِ السَعيِ ذا ثِقَةٍ مُتَّكِل",50,"ل",1,0],["ولمَّا تراءَى للعدوِّ مُصَمِّماَ","تراءَتْ له تحتَ العَجاجِ مَصارِعُه",51,"ع",2,0],["ولمَّا تَبادَلْنا العِناقَ وأعنَقَتْ","دُموعيَ مَمزوجاً بهنَّ دُموعُها",52,"ع",3,0],["وَلَم أَتَبِع خُطاكَ لِضُعفِ رَأيِي","وَلا أَنّي أُريدُ بِهِ رَداكا",53,"ك",2,0],["ولَمّا تنازَعنَ مَعنى الحديث","بمختلف اللفظ أو متّفِقْ",54,"ق",1,1],["وَلمّا تَلاقَينا تَكَلَّمَ مِقْوَلٌ","بسرِّ الهوى منها ومنِّيَ مدمَعُ",55,"ع",1,0],["ولمّا تناهى جمعُهُمْ ركبوا به","قَرَا زاخِرِ الآذيِّ آفاقُهُ غُبرُ",56,"ر",1,0],["وَلَمَّا تَلَظَّى جَمرُها وتَجَدَّلَتْ","وَقُصَّتْ بِأَيدِينا ذَوائِبُها الحمرُ",57,"ر",1,0],["ولَمّا تَلاقَينا وأثْبَتَ عِندَها","نُحولي وَتَبريحي مِنَ الحُبِّ ما عِندي",58,"د",2,1],["وَلَم أَتَسَقَّط رَيبَ دَهري بِرَأيِهِ","فَلَم يَجتَمِع لي رَأيُهُ وَالنَوائِبُ",59,"ب",1,0],["ولما تأملتُ الأمورَ وبانَ لي","بتجريبِها معتلُّها وصحيحُها",60,"ح",3,0],["وَلَمّا تَراءَت لِلمَشيبِ بُرَيقَةٌ","وَأَقشَعَ مِن ظِلِّ الشَبابِ سَحابُ",61,"ب",1,0],["وَلَمّا تَفَرّى مِن دُجى اللَيلِ طِحلِبٌ","وَأَعرَضَ مِن ماءِ الصَباحِ ثِمادُ",62,"د",1,0],["وَلَمّا تَجَلّى ضَوءُ صُبحٍ كَأَنَّهُ","مَشيبٌ بِفَودِ اللَيلِ طالِعَ مِن قَطرِ",63,"ر",1,0],["وَلَم أَتحامَل بَينَ ظِلٍّ بِسَرحَةٍ","وَسَجعٍ لِغِرّيدٍ وَماءٍ بِأَجرَعا",64,"ع",2,0],["وَلَمّا تَراءَت لي أَثافِيُّ مَنزِلٍ","أَرَتني مُحَيّا ذَلِكَ الرَبعِ أَهيَما",65,"م",2,0],["وَلَمّا تَرَنَّمتُ أَطرَبتُهُ","بِما صُغتُ أُطريكُمُ فَاِبتَسَم",66,"م",1,0],["وَلَم أَتَلَقَّ الريحَ تَندى عَلى الحَشى","شَذاءً وَلَم أَطرَب إِلى الطَيرِ شادِيا",67,"ي",2,0],["وَلَمّا تَبَرَّجَ خُضرُ البِطاحِ","تَوَهَّمتُها جُهِّزَت حَجَّلا",68,"ل",2,1],["وَلَم آتِ ما قَد حَرَّمَ اللَهُ في الهَوى","وَلَم أَتَّرِك مِمّا عَفا اللَهُ باقِيا",69,"ي",2,0],["ولمّا تَلَقّتْكَ المَواسِمُ آنِفاً","تَرَبّصْتُ حتى جئتُ فَرداً بمَوسم",70,"م",1,0],["ولمّا تسَنّمْتَ الجبِالَ إزاءَهُ","تَراءتْ له الراياتُ تَخفِقُ والجَمْع",71,"ع",1,0],["ولمّا تولّتْ دولةُ النُّصْبِ عنهمُ","تولّى العمى والجهلُ واللؤمُ والغدرُ",72,"ر",1,0],["ولمّا تجَلّى جعْفَرٌ صَعِقتْ لَهُ","وأقبلَ منها طورُ سَيناءَ يَنهدُّ",73,"د",1,0],["ولمّا تَهادَى نكّبَ البِيدَ مُعْرِضاً","وأتْأقَ سَجْلاً للرّياض فَطفّحا",74,"ح",2,0],["ولمّا تَخَيّرَ أنسابَها","تَخَيّرَ أسْماءها والكُنَى",75,"ا",1,0],["وَلَمّا تَوَلّى اللَيلُ أَو كادَ أَقبَلَت","إِلَينا بِميزانٍ لِتَنقُدَنا الوَزنا",76,"ن",2,0],["وَلَمّا تَناءَت بَلدَةٌ عَنَمِيَّةٌ","مِن الغَورِ أَبدَينَ البَنانَ المُعَنَّما",77,"م",2,0],["ولما تولتْ نضرةُ العيشِ ردَّها","فآلتْ إلى العبدِ القديمِ مَآلها",78,"ل",3,0],["ولمّا تَمَلأَ مِن سُكْرِهِ","فنامَ ونامَت عُيونُ العَسَسْ",79,"س",1,1],["وَلَمَّا تَدَاعَى الْقَوْمُ واشْتَبَكَ الْقَنَا","ودَارَتْ كَمَا تَهْوَى عَلَى قُطْبِها الْحَرْبُ",80,"ب",1,1],["وَلَمّا تَوَفّى اللَهُ مَن كُنتُ أَرتَجي","وَعاشَ الَّذي يشكى الأَذى مِنهُ وَالقَذى",81,"ذ",2,0],["ولم أتغزَّلْ في الكرام وفضلهم","وغيري بهم -لا بالكواعب- مغرم",82,"م",1,0],["ولم أَتَسَامَحُ عن صَغَار؛ وإنما","يسامح مثلي كبْرَةً وتعاليا",83,"ي",2,0],["ولما تبدت للمحاق حجبتها","تصادم فيهن الجوى وتصادر",84,"ر",1,0],["ولما تلاشوا جبلا ورمت بهم","أيدي النبيط أقاصي الأنبار",85,"ر",1,0],["ولما تناهى ورد خدك نضرة","وأنشأ في طي القلوب هياجا",86,"ج",2,1],["ولما تمَايزَتِ النُّفوسُ بخَيرها","وبشرِّها ، ولما استَتَبَّ نِظام",87,"م",1,0],["ولم أتكفَّفْ باليسيرِ ولم أكنْ","كمستأنِسٍ بالقُلِّ مستكثِرٍ نَزْرا",88,"ر",2,0],["وَلمّا تَوَلّيْتَ الرّعِيّةَ، مُحْسِناً،","مَنَعْتَ أقاصي سِرْبهِا أن تُنَفّرَا",89,"ر",2,0],["ولما تأملتَ الهلال ابن ليلة","تَكَبَّرَ إذا عاينتَه وتعظَّما",90,"م",2,0],["ولما توسطت الأمور كفيتَها","وأقبلتَ محموداً بوجه بشير",91,"ر",1,0],["ولم أتردّد وانتقيت .. وحبّها","وأحلامها ما اخترت حين تسوم",92,"م",1,0],["ولم اتجاوز نعمة الله ذاكرا","اساليب دعوى لا وسادات اسرتي",93,"ي",1,0],["ولما تناشدْنا وطالَ عتابُنا","جرَت عَبَرَاتٌ ما عَدَتْها المطارِفُ",94,"ف",1,0],["وَلمّا تَبِن مِنّا وَمِنكُم سَوالِفٌ","وَأَيدٍ أُتِرَّت بِالقُساسيّةِ الشُهبِ",95,"ب",1,0],["وَلَمّا تَعَدّى التُركُمانِيُّ طَورَهُ","وَأَضمَرَ بَغياً ضِدَّ ما كانَ يُظهِرُ",96,"ر",1,0],["وَلَمّا تَعَدّى الدَهرُ بِالأَمسِ طَورَهُ","فَأَحدَثَ خَطباً ما أَجَلَّ وَأَفظَعا",97,"ع",2,0],["وَلَم آتِهِ أَشكو اِتِّصالَ هِباتِهِ","وَضَعفِيَ عَن شُكريهِ إِلّا وَأَضعَفا",98,"ف",2,0],["وَلَمّا تَعَدّى الرومُ جَهلاً بَعَثتَها","كَتائِبَ يَحمِلنَ الوَشيجَ المُقَوَّما",99,"م",2,0],["ولما تطارحنا الأحاديث بيننا","وأحلى تلاقي الخل بالمنزل الخالي",100,"ل",2,0],["وَلَما تَجَلّى لِلوَرى نورَ قُدوَةٍ ثَوى","قَبلَ نورِ الوَحي في نورِ خَلوَةٍ",101,"ه",1,0],["ولما تراخى العيشُ وانجاب عيثر","وأجلى اليقين الشك من بعد الياسِ",102,"س",1,0],["ولما تجلى وجهك الطلق للورى","وحير أفكارا العقول شهوده",103,"د",2,0],["ولما تلقيت السرور بحقه","علمنا بأن الله سوف يديمه",104,"م",2,0],["ولما تولّوا وأحشاؤهم","منَ النارِ مَملؤةٌ بالشُّواظْ",105,"ظ",1,0],["وَلَمّا تَولّى المُلكَ باءَ مُشَمِّراً","بِأَعبائِهِ مِن غَيرِ لَهثٍ وَلا بُهرِ",106,"ر",1,0],["ولَم آتِها إِلّا عَلى اِسمِ رَجائِهِ","وَلِلخَطبِ يُرجى ذُو العُلى وَيُؤَمَّلُ",107,"ل",1,0],["ولم أَتْبَعِ الأَظْعانَ في رَوْنَقِ الضُّحى","ورَحْلي على نهّاضةِ الخَدَيانِ",108,"ن",1,0],["وَلَمّا تَمادى بِهِ عَتبُهُ","وَلَم أَرَ عِندي لِصَبرٍ نَصيبا",109,"ب",2,0],["وَلَما تَتابَعَ صَرفُ الزَمانِ","فَزِعنا اِلى سَيّدٍ نابِهِ",110,"ه",1,1],["ولما تلاقينا ومالتْ تجافياً","كما تحذرُ الورقاءُ جارحة الصقرِ",111,"ر",1,0],["ولمّا تسارقنا الوداعَ تخالُساً","لعَيني رقيبٍ يغلب الليلَ خزرُها",112,"ر",3,0],["وَلما تَرى أَبقى لَنا","من ريش حُسنِك جانِحاك",113,"ك",1,0],["وَلما تَقيسونَ الصَلا","ةَ إِذا عَدَلتُم في الأُمور",114,"ر",1,0],["ولما تضمنت الجمال فأفصحت","بك منه ساحرة من التعبير",115,"ر",1,0],["ولمّا تبدّت مَراجِيحُنا","تحرِّكها بالغَوالي الغَواني",116,"ي",1,0],["ولما تلاقينا ولم نُظهِرِ البكا","حِذارا من الواشِي ولم نجدِ اللفظا",117,"ظ",2,1],["ولما تلقّى الغيثُ حسن غنائنا","تلقتْ نجوم السعدِ أنجمنا كرّا",118,"ر",2,1],["ولم أتخلَّف أَنني عنك صابِر","فكيف تُطِيقُ العين عن نورها صبرا",119,"ر",2,0],["ولما تيقّنَّ أن الفراق","يزوِّد عشاقهنّ البعادا",120,"د",2,0],["ولما تلاقَيْنا ولم نَخْش كاشحاً","ولم نَتكاتم ما بنا من جوى الحبِّ",121,"ب",1,1],["ولمّا تقابلت الجَحْفلان","وعاد كُجْنحِ الظّلامِ الضُّحى",122,"ا",1,0],["ولما تحلّى بالنبوة وانتهى","إلى مستوٍ عنه الملائك توزع",123,"ع",1,0],["وَلَمّا تَوافَقنا وَقَرَّبنَ لِلنَوى","تَرَحَّلنَ أَقماراً وَغادَرنَ أَرماقا",124,"ق",2,0],["وَلَمّا تَلاقَت بِالصَراةِ رِكابُنا","وَرَقَّ لَنا مِن حَرِّ أَنفاسِنا الرَكبُ",125,"ب",1,0],["وَلَمّا تَقَلَّصَ ظِلُّ الرِجالِ","لَجَأتُ إِلى عيصِهِ المُؤتَشِب",126,"ب",1,0],["ولما تمادوا في الضلال دعوتهم","وهيهات أن يلقى العدالة مذنب",127,"ب",1,0],["وَلَمّا تَلتَبِس خَيلٌ بِخَيلٍ","فَيَطَّعِنوا وَيَضطَرِبوا اِضطِرابا",128,"ب",2,0],["ولما تراجعتم كسالى تدرّأوا","وشدوا عليكم في أساطيل ضخمة",129,"ه",1,0],["ولما تلاقينا على حين غفلة","وقد مرَّ بي شهرانِ في الحبّ أو أكثر",130,"ر",1,0],["ولما تناءى عن حِماها حُماتُها","تَناولها الغلمانُ والدُّخلاء",131,"ا",2,0],["ولما تبينّا (دمشقَ) تهلَّلتْ","وجوهٌ عليها البشرُ أصبح باديا",132,"ي",2,0],["ولما تراءينا الهلال بدا لنا","محيا حبيبٍ لم يغب قط عن فكري",133,"ي",1,1],["ولما تجافيتم تعشقت غيركم","لعلي أن ألقى بذلك سلوانا",134,"ن",2,1],["وَلَمّا تَلاقَينا وَجَدتُ بَنانَها","مُخَضَّبَةً تَحكي عُصارَةَ عَندَمِ",135,"م",1,1],["وَلَمّا تَمادَت بَينَنا مُدَّةُ النَوى","وَضاقَت بِحالي في التَباعُدِ حيلَتي",136,"ي",1,0],["ولمّا تَوسَّمْتُ المنازلَ شاقَني","تَذكُّرُ أَيامٍ عَهدْتُ وإخْوان",137,"ن",1,0],["ولم أَتَزوَّدْ من خَسيسِ مَطالبي","وأَبناءُ دَهري بينَ ذُلٍّ وحِرْمان",137,"ن",1,0],["ولمّا توجّه تلقاءه","تحاميتَه كرماً لا سأم",138,"م",1,0],["ولمّا تَجنّبتَ الحرامَ وشُربَه","أتَتْكَ حلالاً من يَديَّ عُقار",139,"ر",1,0],["ولمّا تلاقَيْنا وللعَيْنِ عادةٌ","تثيرُ وشاةً عند كلِّ لِقاء",140,"ا",2,0],["وَلَم آتِ هَذا البَيتَ مِن غَيرِ بابِهِ","وَبابُ أَميرِ القَومِ فَهوَ وَزيرُهُ",141,"ه",1,1],["وَلَم أَتَأَلَّ لَكِن لي رَجاءٌ","بِهِ أَرجو كَريمَ المُستَقَرِّ",142,"ر",1,0],["وَلَمّا تَبدّى لي طرازُ عذارِهِ","رَأَيتُ طرازَ اللَهِ في ثَوب حُسنِهِ",143,"ه",1,0],["وَلَمّا تَناءَت بِالحَبيب دِيارُهُ","وَغودِرتُ مِمَّن غارَ فيهِ عَلى وَهمِ",144,"م",1,1],["ولمّا تَناسَى سيّدي كتبَ عبدِهِ","ولم يأتِنَا منه كِتابٌ ولا رسلُ",145,"ل",1,1],["ولمّا تخوّفتُ ما قَدْ عَلمتَ","تقَنّعتُ عن بحرِه بالوشَلْ",146,"ل",1,0],["وَلَمّا تَرَحَّلَت عَنّي بَكَيتُ","بِدَمعٍ سَكوبٍ يَفيض اِنهِمالا",147,"ل",2,0],["وَلَمّا تُضِف في نَصرَةِ اللَهِ طعنه","إِلى ضَربَةٍ كالبِئرِ فَوقَ شَفا نَهرِ",148,"ر",1,0],["وَلَمّا تَقُم لِلَّهِ بِالقِسطِ مَوقِفاً","سَأَقضي وَلمّا أَقضِ مِن مِثلِهِ نذري",148,"ر",2,0],["وَلَمّا تَبارى النَجم ضوءاً ورِفعَةً","وَصيتاً وَأَنواءً وَهَدياً إِذا يَسري",148,"ر",2,0],["وَلَمّا تَقم في مَشهَدٍ بَعدَ مَشهَدٍ","تَصدّق أَخبار المَخايلَ بِالخُبرِ",148,"ر",1,0],["وَلَمّا تَجارَينا وَغايَة سَبقنا","إِلى المَوتِ كانَ السَبقُ لِلجَذَعِ الغَمرِ",148,"ر",1,0],["ولما تدع مني الثمانون منة","كأني إذا رمت القيام كسير",149,"ر",1,0],["ولمّا تَصافَينا وأَخلَصَ وُدُّنَا","ورُدَّ بيأسٍ كاشحٌ وحَسودُ",150,"د",1,1],["ولم أَتَّبعْ ضَنّاً بكم سَقَطَاتِكُم","لأسبُرَكُم والكَلْمُ يُدميه سَبْرُهُ",151,"ر",2,0],["ولما تَلَفَّتْنا فلم نَرَ أنجماً","هنالك إلاَّ قد غربن غروبا",152,"ب",2,0],["ولمَّا تعالى بالفضائل رفعة","تخيلته يبغي العروج إلى السما",153,"م",2,0],["ولما تولّى الخَدَّ وال عِذارهِ","رفعتُ إليه قِصّتي أتظلَّمُ",154,"م",1,1],["ولما تولى طرفها كل مهجةٍ","على قدها من فرعها عقد الخال",155,"ل",1,0],["ولما تولى البحر ثاني مرةً","خليل المعالي والوزير المؤيدُ",156,"د",1,0],["ولما توافينا وقد غاب كاشح","ونام رقيب واطمأن بنا الخدر",157,"ر",1,0],["ولم أتكلّفْ مثلَ غيري صُنْعَها","ولم آتِ فيما قلتُ مفتخراً نُكرا",158,"ر",2,0],["ولما تقاضى غَرْبُ سيفِكَ نَفْسَهُ","وحاطَتْ لَهُ الأَقدارُ مُحْتَقَنَ الدِّمَا",159,"م",2,0],["ولم أَتَّخِذْ جُنْحَ لَيْلِ المحاقِ","جَناحاً إِلَى نُورِ لَيْلِ السَّواءِ",160,"ا",2,0],["ولَمْ أَتَزَوَّدْ هَبِيدَ القِفارِ","إِلَى بَحْرِ أَرْيٍ جزيلِ العَطَاءِ",160,"ا",2,0],["ولَمَّا تدانَتْ للوداعِ وَقَدْ هَفا","بصَبْرِيَ منها أَنَّةٌ وزَفيرُ",161,"ر",1,0],["ولما تَوافَوْا للسَّلامِ ورُفِّعَتْ","عن الشمسِ فِي أُفْقِ الشُّروقِ سُتورُ",161,"ر",1,0],["ولما تحكمت اليهود بقدسن","ولما استبد بقهرنا دايان",162,"ن",1,0],["ولمّا تفاوضنا الحديثَ عشيةً","ومالَتْ بعطْفَيْهِ المُدامةُ فاسْتَعفى",163,"ف",2,1],["ولما تواقفنا وفي العيس فضلةٌ","بقدر الوقوفِ ساعةً ثم تنقضي",164,"ي",1,0],["ولما تعيَّفتُ فاستعجمت","مَيامنُ كانت بخيرٍ تطيرُ",165,"ر",1,0],["ولما تَمَّ في الميلادِ فَضْلاً","دعوهُ في المبادي بالكمالِ",166,"ل",1,0],["ولما تلاقينا وللشوقِ سَوْرَةٌ","تَرُدُّ جيادَ القوْلِ وهي بِطاءُ",167,"ا",2,1],["ولمَّا تَراءتْ كَعْبَةُ البيتِ كَعْبَةً","منَ الناسِ كَنَّتْها العُلى بأبي الفضْلِ",168,"ل",1,1],["ولمّا توسّطنا مدى النيل غدوةً","ظننتُ وقلبُ اليوم باللهو جذلانُ",169,"ن",1,1],["وَلَمّا تَناهى الحُبُّ في القَلبِ وارِداً","أَقامَ وَسَدَّت بَعدَ عَنّا مَصادِرُه",170,"ر",2,0],["وَلَمّا تَبَدّى الصُبحُ في أَثَرِ الفَجرِ","وَسارَ الدُجى عَنّا بِأَنجُمِهِ الزُهرِ",171,"ر",1,1],["ولما تمادَى البينُ أصبحتُ خاضعاً","وقد كنتُ مِن قبلِ النوى غيرَ خاضعِ",172,"ع",1,0],["ولما تفرَّقنا وودعن خفية","أنامل في حنائها كالأسارعِ",172,"ع",1,0],["ولما تبارى الغيثُ في عرصاتِها","ودمعي فتَهماعٌ ألثَّ وتهمالُ",173,"ل",1,0],["ولمّا تذاكرنا مِنَ العيشِ طيبَهُ","وصفوَ وصالٍ لم نجدْ فيه أكدارا",174,"ر",2,0],["ولمّا تفرَّقنا وأمسيتُ ممسكاً","بكفِّي على أعشارِ قلبٍِ مغلَّذِ",175,"ذ",1,0],["ولمّا ترامَى السربُ قلتُبليةٌ","تراءتْ لمسلوبِ الفؤادِ مجذَّذِ",175,"ذ",1,0],["ولمَّا توسَّطْنا البِطاحَ عشيَّةً","ولاحَتْ لنا الأَنْوارُ في حيِّها الأسمَى",176,"م",2,1],["ولَمَّا تَلافَيْنا التِّلالَ بِلَعْلَعٍ","ولَفَّتْ بنا آرامُ جَرْعاءِ لَعْلَعِ",177,"ع",1,1],["ولمَّا تَقيَّدنا بقيْدِ غَرامنا","بِصدقٍ فمن قيْدِ الوُجوداتِ أفلَتْنا",178,"ن",2,0],["وَلَم أتّهِم تَسويفَه غَيرَ أنّني","أقولُ له شوقي لعلَّ له عُذرا",179,"ر",2,0],["ولما تراءت للهلال بصائر","يغطي الهوا أبصارها بضباب",180,"ب",1,0],["ولما تجاوزت النهاية في العلى","ولاذت بعطفيك الملوك الجحاجح",181,"ح",1,0],["ولما تشكى الأمن خوفاً من العدى","وكاد الهدى يسطو عليه ضلال",182,"ل",1,0],["وَلَم أَتَنَحَّلِ الأَشعارَ فيها","وَلَم تُعجِزِنيَ المِدَحُ الجيادُ",183,"د",1,1],["ولمّا تباكينا عليه وعُرِّيَتْ","طَماعتُنا منه شَأَوْتُ البَواكيا",184,"ي",2,0],["ولمّا تعانقنا ولم يكُ بيننا","سوى صارمٍ في جَفْنِهِ لا من الجُبْنِ",185,"ن",1,1],["ولمّا تركتَ السَّيفَ فيهمْ وحُكمَه","جعلتَ بُكاها في مكان اِبتسامِها",186,"م",3,0],["وَلمّا تَركنا الأثلَ من جَنَباتِنا","وأطربني منهنّ نَوْحُ حَمامٍ",187,"م",1,0],["ولمّا تراخى منك نصرٌ عهدتَه","وظنّوا جواداً بالنّجاحِ مَطولا",188,"ل",2,0],["ولمّا تنادَوْا غفلةً برحيلهمْ","فما شئتَ بين الحيّ من متهالكِ",189,"ك",1,0],["ولمّا تفرّقنا ولم يكُ بيننا","هُنالك لولا النّومُ إلّا التفرُّقُ",190,"ق",1,0],["ولمّا تعسّفْتَ الطّريقَ وجدتَه","وراءَك منقدّاً من النّاس يَعْسِفُ",191,"ف",1,0],["وَلمّا تولّوْا يَحمِلون قُلوبنا","عَلى راتِكاتٍ بالحُدوج رواقِصِ",192,"ص",1,0],["ولمّا تفرّقنا ولم يبق بيننا","سوى ذُكْرةٍ من عاشقٍ متذكّرِ",193,"ر",1,0],["وَلَمّا تَعاتَبنا على الهجر صُغتَ لِي","دَنُوَّك من بُعدٍ ووصلكَ من هجرِ",194,"ر",1,0],["ولمّا تعلّق زين القضا","ة قلبيَ صار لمثواي جارا",195,"ر",2,0],["وَلَمّا تَبيّن عُقبى الأمورِ","وأسفَر دَيجورُها فَاِستَنارا",196,"ر",2,0],["وَلَمّا تَراءَتْ لي مَغبَّةُ قبحِها","وَعُرِّيَ عن دارِ المُجازاةِ بُرْدُها",197,"د",3,0],["وَلَمّا تفرَّقنا كما شاءَتِ النّوى","تبيّنَ حبٌّ خالصٌ وتودُّدُ",198,"د",1,1],["ولمّا تلاقينا بشِعْبِ مُغَمِّسٍ","على شَرَفٍ فيه الوكورُ الجوارحُ",199,"ح",1,0],["وَلَمّا تَناهبنا الثّناءَ بفضلِهِ","وجاشتْ بما تولِي يداهُ القرائحُ",199,"ح",1,0],["ولمّا تُوفِّي الزينبيُّ محمّدٌ","وسارت بما لاقاه أيدي الرَّكائبِ",200,"ب",1,0],["ولمّا تناهبنا النّدى جئتُ راكباً","سنامَ النّدى في كلّ يومِ نِهابِ",201,"ب",1,0],["وَلَمّا تَلاقَينا قَضى اللَيلُ نَحبَهُ","بِوَجهٍ لِوَجهِ الشَمسِ مِن مائِهِ المَحلُ",202,"ل",1,0],["وَلَمّا تَعالى اللَيلُ شَقَّت بِنا السُرى","جَلابيبَهُ حَتّى رَأى دُبرَهُ القُبلُ",202,"ل",1,0],["وَلَمّا تَناءَت بِالقَراباتِ مِنهُمُ","حَوادِثُ تَمريها الوَقائِعُ وَالأَزلُ",202,"ل",1,0],["ولما تم ذا التنزيه منه","وألزم في تحققه الرجالا",203,"ل",2,0],["ولما تأملت الوجود بفكرةٍ","رأيت خيال الظلِّ أكبر عبرةٍ",204,"ه",1,0],["ولما تَغَنّتْ غِناءَ الوداعِ","بَكيْتُ وقلتُ لِبَعْضِ الجواري",205,"ي",1,0],["ولمَّا تولَّى الخدَّ والي عِذارِه","رفَعْت إِليه قِصَّتي أَتَظَلَّم",206,"م",1,0],["ولما تَعَمَّمَ قام الدَّلي","لُ على نَقْصِ مَنْ زِيُّها المِعْجَرُ",207,"ر",1,0]]}