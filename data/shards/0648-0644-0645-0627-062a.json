تراءت كعبة البيت كعبة","https://www.aldiwan.net/poem16377.html","الطويل"],[465,"ولما توسطنا مدى النيل غدوة","https://www.aldiwan.net/poem3201.html","عموديه"],[467,"بنفسي من لا بد أني هاجره","https://www.aldiwan.net/poem50433.html","الطويل"],[469,"ولما تبدى الصبح في أثر الفجر","https://www.aldiwan.net/poem60111.html","الطويل"],[478,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[478,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[478,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[478,"متى ينجلي بالقرب ذا الناظر القذي","https://www.aldiwan.net/poem15282.html","الطويل"],[501,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[501,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[501,"أعد ذكر من نهوى فنحن على الهوى","https://www.aldiwan.net/poem38056.html","البسيط"],[507,"ألا هل نسيم للرصافي مبلغ","https://www.aldiwan.net/poem2464.html","الطويل"],[516,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[516,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[541,"ولم أتنحل الأشعار فيها","https://www.aldiwan.net/poem56857.html","الوافر"],[552,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[552,"ولما تعانقنا ولم يك بيننا","https://www.aldiwan.net/poem47150.html","الطويل"],[552,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[552,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[552,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[552,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[552,"حللت بنا والليل مرخ سدوله","https://www.aldiwan.net/poem47374.html","الطويل"],[552,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[552,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[552,"ومنتقبات بالجمال على منى","https://www.aldiwan.net/poem47763.html","الطويل"],[552,"أيا زائرا بالليل من غير أن يسري","https://www.aldiwan.net/poem47771.html","الطويل"],[552,"أتتني كما بلغت منية","https://www.aldiwan.net/poem47799.html","المتقارب"],[552,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[552,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[552,"ولما تفرقنا كما شاءت النوى","https://www.aldiwan.net/poem47872.html","الطويل"],[552,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[554,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[559,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[559,"أنا الهيكل الذاتي لمظهر قدرة","https://www.aldiwan.net/poem34334.html","الطويل"],[568,"وجارية مثل شمس النهار","https://www.aldiwan.net/poem69698.html","المتقارب"],[576,"تلاقى تلاقي سورة ليس تعلم","https://www.aldiwan.net/poem2857.html","الطويل"],[576,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["ولما توارى لاحق إثر سابق","وفيك على من حل قِدماً تعاقدوا",0,"د",3,0],["وَلَمّا تَجاهَشنا البُكاءَ وَلَم نُطِق","عَنِ الوَجدِ إِقلاعاً عَذَرنا البَواكِيا",1,"ي",2,0],["وَلَمّا تَعاطَينا النِزالَ اِنبَرى لَنا","مَلَبٌّ عَلى أَعوادِهِ بِلُبانِ",2,"ن",1,0],["وَلَمّا تَواقَفنا ذَهَلتُ وَلَم يَحِن","لِطَيرِ قُلوبِ العاشِقينَ وُقوعُ",3,"ع",1,0],["وَلَمّا تاهَ مَدحي في","هِ دَلَّتهُ مَآثِرُه",4,"ر",2,0],["وَلَمّا تَدانى البَينُ قالَ لِيَ الهَوى","رُوَيداً وَقالَ القَلبُ أَينَ تُريدُ",5,"د",1,0],["وَلَمّا تَجَلَّتْ لِلوَداعِ وَأَشرَقَتْ","وجوهٌ كَأَنَّ الشَّمسَ مِنهُنَّ تَطلُعُ",6,"ع",1,0],["ولما تَنادَيْتُمُ بالرّحي","لِ لَمْ يَتْرُكِ الدّمْعُ سِراً مَصونا",7,"ن",2,0],["ولمّا تَعانَقْنا فَذابَتْ عُقودُهُ","بِحَرِّ الجَوى صارَتْ ثُغوراً وأْمُعا",8,"ع",2,0],["وَلَمّا تَجاذَبنا السُيوفَ وَأُفرِغَت","ثِيابُ المَنايا كُنتُ أَوَّلَ لابِسِ",9,"س",1,0],["ولمّا ترعْرَعَ منْها البُسوقُ","وأجْمَعَ ريْعانُها واسْتَوى",10,"و",2,0],["ولمْ آتِ بحْرَ المَدْحِ فيكَ لِغايةٍ","تُرى دونَها الأبْصارُ حاسِرةَ الطّرْفِ",11,"ف",1,0],["ولَما تلاشَوْا جُفَّلاً ورَمتْ بهِمْ","أيْدي النّبيطِ أقاصيَ الأنْبارِ",12,"ر",1,0],["ولمّا تَفانى الصبْرُ إلا صُبابَةً","تسهِّلُ من وقعِ الحوادثِ ما اشْتَدّا",13,"د",2,0],["ولمّا تَناهى وَرْدُ خدِّكَ نظرةً","وأنْشأَ في طَيِّ القُلوبِ هِياجا",14,"ج",2,1],["وَلَمّا تَفعلوا إِلّا وَعيداً","كَفى بِوَعيدِكُم لَهُمُ قِتالا",15,"ل",2,0],["وَلَمّا تَلاقَينا جَرَت مِن عُيونِنا","دُموعٌ كَفَفنا ماءَها بِالأَصابِعِ",16,"ع",1,0],["وَلَمّا تَنَمَّت تَأَكُلُ الرِمَّ لَم تَدَع","ذَوابِلَ مِمّا يَجَمعونَ وَلا خُضرا",17,"ر",2,0],["ولما تراءى السرب قلت لصاحبي","وأيقنت أن الحبّ ما عشتُ دانيا",18,"ي",2,0],["ولما تناهى من يهودا خطابه","وقد سرّنا من حيث ندري ولا ندري",19,"ر",2,0],["ولم أتبَّين ما هنالك من علاً","لكثرة ما قد دبّ فيه نُحُول",20,"ل",1,0],["ولما تناهتْ في البكاء تضاحكت","من اليأس ضحك الهازئ المتهكّم",21,"م",1,0],["وَلَمّا تَغَشّى اللُؤمُ ما حَولَ أَنفِهِ","تَبَوَّأَ في الدارِ الَّتي لا يَريمُها",22,"م",3,0],["ولما تخلف عنك الدليل","رأوك لها جحفل الجحفل",23,"ل",1,0],["وَلَمّا تَخَيَّرتِ الأَخِلّاءَ لَم أَجِد","صَبوراً عَلى حِفظِ المَوَدَّةِ وَالعَهدِ",24,"د",1,1],["ولم أترشف بعد فيه مدامةً","على يده دفَّاعةً حجّةَ الحجى",25,"ج",2,0],["ولم أتلقَّ النهدَ في الصدر جالساً","وأسرى به حالي الشكيم مهملجا",25,"ج",2,0],["ولمَّا تجاذبنا العتاب موشعاً","نزول اليماني بالعتابِ الجمَّل",26,"ل",1,0],["ولم أتعلم قط من ذي سباحةٍ","سوى الغوص والمضعوف غيرُ مغالِب",27,"ب",1,0],["ولم أتنفس الصُّعداءَ لَهفاً","على عيشٍ تداعَى بانقضابِ",28,"ب",1,0],["وَلَمَا تلك ضَعْفَةٌ أنطق الل","هُ قديماً بغير تلك شَهيدَكْ",29,"ك",1,0],["ولما تولاها اسمُكَ الخير أصبحتْ","وجانبُها الوحشي باسمك آنس",30,"س",1,0],["ولما تنقَّصْتُ الفتى لكنه","لجميله بقبيحه متنقِّصُ",31,"ص",1,0],["ولما تناهى بي مسيري إليهمُ","أنختُ قلوصي في مُناخ قِلاص",32,"ص",1,0],["ولما تعمد رقهم لكنه","لا بد للمعروف من أرباق",33,"ق",1,0],["ولما تأملتَ الهلال ابن ليلة","تَكَبَّرَ إذ عاينتَه وتعظَّما",34,"م",2,0],["وَلَمّا تَطِب نَفسي بِإِرسالِها لَكُم","وَهَل يَنفَعَن نَفسي إِلَيكُم أَناتُها",35,"ت",3,0],["وَلَمّا تَبَيَّنّا ضَلالَةَ مُصعَبٍ","فَتَحنا لِأَهلِ الشامِ باباً مِنَ النَصرِ",36,"ر",1,0],["وَلَمّا تَوَلَّت دَراري السَماءُ","وَغابَ الهِلالُ عَنِ الناظِرِ",37,"ر",1,0],["ولم أتجنَّبْ وُعورَ الشِّعابِ","ولا كُبَّةَ اللَّهَبِ المُستَعِرْ",38,"ر",1,0],["ولما توردنا لسائمة دما","نفدى نفوسا ما لها من فادي",39,"د",2,0],["وَلَمّا تَلَقّاكَ السَحابُ بِصَوبِهِ","تَلَقّاهُ أَعلى مِنهُ كَعباً وَأَكرَمُ",40,"م",1,0],["وَلَما تَفاضَلَتِ النُفوسُ وَدَبَّرَت","أَيدي الكُماةِ عَوالِيَ المُرّانِ",41,"ن",1,0],["ولم أتَّرِكْ أمراً أخافُ اغتيالَه","ولا طمعَت نفسي إلى غير مطمَع",42,"ع",1,0],["ولما تطارحنَا الأحاديثَ بيننَا","وبُحْنَا بأسرارِ القلوب ولم نكْنَ",43,"ن",1,0],["ولمَّا تراءَى السِّربُ قلت لصاحبي","لِيَهْنِكَ فيما لا يُنَالُ طموعُ",44,"ع",1,1],["وَلَمّا تَزايَلنا مِنَ الجِزعِ وَاِنتَأى","مُشَرِّقُ رَكبٍ مُصعِداً عَن مَغَرِّبِ",45,"ب",1,0],["وَلَمّا تَلاقَوا قُلتُ مَنٌّ وَنِعمَةٌ","مِنَ اللَهِ أَيُّ العُصبَتَينِ تَرَدَّتِ",46,"ت",1,0],["وَلَمّا تَلاقَوا عِندَ دِجلَةَ أَضمَرَت","مَهابَةَ أَشخاصِ المَوالي عَبيدُها",47,"د",3,0],["وَلَمّا تَوَلَّيتَ الرَعِيَّةَ مُحسِناً","مَنَعتَ أَقاصي سِر بِها أَن يُنَفَّرا",48,"ر",2,0],["وَلَمّا تَوَلّى البَحرَ وَالجودُ صِنوُهُ","غَدا البَحرُ مِن أَخلاقِهِ بَينَ أَبحُرِ",49,"ر",1,0],["وَلَمّا تَباذَينا فَرَرتُ مِنَ الخَنا","بِأَشياخِ صِدقٍ لَم يَفِرّوا مِنَ الزَحفِ",50,"ف",1,0],["وَلَمّا تَضَمَّنتَ أَمري قَعَد","تُ عَنِ السَعيِ ذا ثِقَةٍ مُتَّكِل",51,"ل",1,0],["ولمَّا تراءَى للعدوِّ مُصَمِّماَ","تراءَتْ له تحتَ العَجاجِ مَصارِعُه",52,"ع",2,0],["ولمَّا تَبادَلْنا العِناقَ وأعنَقَتْ","دُموعيَ مَمزوجاً بهنَّ دُموعُها",53,"ع",3,0],["وَلَم أَتَبِع خُطاكَ لِضُعفِ رَأيِي","وَلا أَنّي أُريدُ بِهِ رَداكا",54,"ك",2,0],["ولَمّا تنازَعنَ مَعنى الحديث","بمختلف اللفظ أو متّفِقْ",55,"ق",1,1],["وَلمّا تَلاقَينا تَكَلَّمَ مِقْوَلٌ","بسرِّ الهوى منها ومنِّيَ مدمَعُ",56,"ع",1,0],["ولمّا تناهى جمعُهُمْ ركبوا به","قَرَا زاخِرِ الآذيِّ آفاقُهُ غُبرُ",57,"ر",1,0],["وَلَمَّا تَلَظَّى جَمرُها وتَجَدَّلَتْ","وَقُصَّتْ بِأَيدِينا ذَوائِبُها الحمرُ",58,"ر",1,0],["ولَمّا تَلاقَينا وأثْبَتَ عِندَها","نُحولي وَتَبريحي مِنَ الحُبِّ ما عِندي",59,"د",2,1],["وَلَم أَتَسَقَّط رَيبَ دَهري بِرَأيِهِ","فَلَم يَجتَمِع لي رَأيُهُ وَالنَوائِبُ",60,"ب",1,0],["ولما تأملتُ الأمورَ وبانَ لي","بتجريبِها معتلُّها وصحيحُها",61,"ح",3,0],["وَلَمّا تَراءَت لِلمَشيبِ بُرَيقَةٌ","وَأَقشَعَ مِن ظِلِّ الشَبابِ سَحابُ",62,"ب",1,0],["وَلَمّا تَفَرّى مِن دُجى اللَيلِ طِحلِبٌ","وَأَعرَضَ مِن ماءِ الصَباحِ ثِمادُ",63,"د",1,0],["وَلَمّا تَجَلّى ضَوءُ صُبحٍ كَأَنَّهُ","مَشيبٌ بِفَودِ اللَيلِ طالِعَ مِن قَطرِ",64,"ر",1,0],["وَلَم أَتحامَل بَينَ ظِلٍّ بِسَرحَةٍ","وَسَجعٍ لِغِرّيدٍ وَماءٍ بِأَجرَعا",65,"ع",2,0],["وَلَمّا تَراءَت لي أَثافِيُّ مَنزِلٍ","أَرَتني مُحَيّا ذَلِكَ الرَبعِ أَهيَما",66,"م",2,0],["وَلَمّا تَرَنَّمتُ أَطرَبتُهُ","بِما صُغتُ أُطريكُمُ فَاِبتَسَم",67,"م",1,0],["وَلَم أَتَلَقَّ الريحَ تَندى عَلى الحَشى","شَذاءً وَلَم أَطرَب إِلى الطَيرِ شادِيا",68,"ي",2,0],["وَلَمّا تَبَرَّجَ خُضرُ البِطاحِ","تَوَهَّمتُها جُهِّزَت حَجَّلا",69,"ل",2,1],["وَلَم آتِ ما قَد حَرَّمَ اللَهُ في الهَوى","وَلَم أَتَّرِك مِمّا عَفا اللَهُ باقِيا",70,"ي",2,0],["ولمّا تَلَقّتْكَ المَواسِمُ آنِفاً","تَرَبّصْتُ حتى جئتُ فَرداً بمَوسم",71,"م",1,0],["ولمّا تسَنّمْتَ الجبِالَ إزاءَهُ","تَراءتْ له الراياتُ تَخفِقُ والجَمْع",72,"ع",1,0],["ولمّا تولّتْ دولةُ النُّصْبِ عنهمُ","تولّى العمى والجهلُ واللؤمُ والغدرُ",73,"ر",1,0],["ولمّا تجَلّى جعْفَرٌ صَعِقتْ لَهُ","وأقبلَ منها طورُ سَيناءَ يَنهدُّ",74,"د",1,0],["ولمّا تَهادَى نكّبَ البِيدَ مُعْرِضاً","وأتْأقَ سَجْلاً للرّياض فَطفّحا",75,"ح",2,0],["ولمّا تَخَيّرَ أنسابَها","تَخَيّرَ أسْماءها والكُنَى",76,"ا",1,0],["وَلَمّا تَوَلّى اللَيلُ أَو كادَ أَقبَلَت","إِلَينا بِميزانٍ لِتَنقُدَنا الوَزنا",77,"ن",2,0],["وَلَمّا تَناءَت بَلدَةٌ عَنَمِيَّةٌ","مِن الغَورِ أَبدَينَ البَنانَ المُعَنَّما",78,"م",2,0],["ولما تولتْ نضرةُ العيشِ ردَّها","فآلتْ إلى العبدِ القديمِ مَآلها",79,"ل",3,0],["ولمّا تَمَلأَ مِن سُكْرِهِ","فنامَ ونامَت عُيونُ العَسَسْ",80,"س",1,1],["وَلَمَّا تَدَاعَى الْقَوْمُ واشْتَبَكَ الْقَنَا","ودَارَتْ كَمَا تَهْوَى عَلَى قُطْبِها الْحَرْبُ",81,"ب",1,1],["وَلَمّا تَوَفّى اللَهُ مَن كُنتُ أَرتَجي","وَعاشَ الَّذي يشكى الأَذى مِنهُ وَالقَذى",82,"ذ",2,0],["ولم أتغزَّلْ في الكرام وفضلهم","وغيري بهم -لا بالكواعب- مغرم",83,"م",1,0],["ولم أَتَسَامَحُ عن صَغَار؛ وإنما","يسامح مثلي كبْرَةً وتعاليا",84,"ي",2,0],["ولما تبدت للمحاق حجبتها","تصادم فيهن الجوى وتصادر",85,"ر",1,0],["ولما تلاشوا جبلا ورمت بهم","أيدي النبيط أقاصي الأنبار",86,"ر",1,0],["ولما تناهى ورد خدك نضرة","وأنشأ في طي القلوب هياجا",87,"ج",2,1],["ولما تمَايزَتِ النُّفوسُ بخَيرها","وبشرِّها ، ولما استَتَبَّ نِظام",88,"م",1,0],["ولم أتكفَّفْ باليسيرِ ولم أكنْ","كمستأنِسٍ بالقُلِّ مستكثِرٍ نَزْرا",89,"ر",2,0],["وَلمّا تَوَلّيْتَ الرّعِيّةَ، مُحْسِناً،","مَنَعْتَ أقاصي سِرْبهِا أن تُنَفّرَا",90,"ر",2,0],["ولما تأملتَ الهلال ابن ليلة","تَكَبَّرَ إذا عاينتَه وتعظَّما",91,"م",2,0],["ولما توسطت الأمور كفيتَها","وأقبلتَ محموداً بوجه بشير",92,"ر",1,0],["ولم أتردّد وانتقيت .. وحبّها","وأحلامها ما اخترت حين تسوم",93,"م",1,0],["ولم اتجاوز نعمة الله ذاكرا","اساليب دعوى لا وسادات اسرتي",94,"ي",1,0],["ولما تناشدْنا وطالَ عتابُنا","جرَت عَبَرَاتٌ ما عَدَتْها المطارِفُ",95,"ف",1,0],["وَلمّا تَبِن مِنّا وَمِنكُم سَوالِفٌ","وَأَيدٍ أُتِرَّت بِالقُساسيّةِ الشُهبِ",96,"ب",1,0],["وَلَمّا تَعَدّى التُركُمانِيُّ طَورَهُ","وَأَضمَرَ بَغياً ضِدَّ ما كانَ يُظهِرُ",97,"ر",1,0],["وَلَمّا تَعَدّى الدَهرُ بِالأَمسِ طَورَهُ","فَأَحدَثَ خَطباً ما أَجَلَّ وَأَفظَعا",98,"ع",2,0],["وَلَم آتِهِ أَشكو اِتِّصالَ هِباتِهِ","وَضَعفِيَ عَن شُكريهِ إِلّا وَأَضعَفا",99,"ف",2,0],["وَلَمّا تَعَدّى الرومُ جَهلاً بَعَثتَها","كَتائِبَ يَحمِلنَ الوَشيجَ المُقَوَّما",100,"م",2,0],["ولما تطارحنا الأحاديث بيننا","وأحلى تلاقي الخل بالمنزل الخالي",101,"ل",2,0],["وَلَما تَجَلّى لِلوَرى نورَ قُدوَةٍ ثَوى","قَبلَ نورِ الوَحي في نورِ خَلوَةٍ",102,"ه",1,0],["ولما تراخى العيشُ وانجاب عيثر","وأجلى اليقين الشك من بعد الياسِ",103,"س",1,0],["ولما تجلى وجهك الطلق للورى","وحير أفكارا العقول شهوده",104,"د",2,0],["ولما تلقيت السرور بحقه","علمنا بأن الله سوف يديمه",105,"م",2,0],["ولما تولّوا وأحشاؤهم","منَ النارِ مَملؤةٌ بالشُّواظْ",106,"ظ",1,0],["وَلَمّا تَولّى المُلكَ باءَ مُشَمِّراً","بِأَعبائِهِ مِن غَيرِ لَهثٍ وَلا بُهرِ",107,"ر",1,0],["ولَم آتِها إِلّا عَلى اِسمِ رَجائِهِ","وَلِلخَطبِ يُرجى ذُو العُلى وَيُؤَمَّلُ",108,"ل",1,0],["ولم أَتْبَعِ الأَظْعانَ في رَوْنَقِ الضُّحى","ورَحْلي على نهّاضةِ الخَدَيانِ",109,"ن",1,0],["وَلَمّا تَمادى بِهِ عَتبُهُ","وَلَم أَرَ عِندي لِصَبرٍ نَصيبا",110,"ب",2,0],["وَلَما تَتابَعَ صَرفُ الزَمانِ","فَزِعنا اِلى سَيّدٍ نابِهِ",111,"ه",1,1],["ولما تلاقينا ومالتْ تجافياً","كما تحذرُ الورقاءُ جارحة الصقرِ",112,"ر",1,0],["ولمّا تسارقنا الوداعَ تخالُساً","لعَيني رقيبٍ يغلب الليلَ خزرُها",113,"ر",3,0],["وَلما تَرى أَبقى لَنا","من ريش حُسنِك جانِحاك",114,"ك",1,0],["وَلما تَقيسونَ الصَلا","ةَ إِذا عَدَلتُم في الأُمور",115,"ر",1,0],["ولما تضمنت الجمال فأفصحت","بك منه ساحرة من التعبير",116,"ر",1,0],["ولمّا تبدّت مَراجِيحُنا","تحرِّكها بالغَوالي الغَواني",117,"ن",2,0],["ولما تلاقينا ولم نُظهِرِ البكا","حِذارا من الواشِي ولم نجدِ اللفظا",118,"ظ",2,1],["ولما تلقّى الغيثُ حسن غنائنا","تلقتْ نجوم السعدِ أنجمنا كرّا",119,"ر",2,1],["ولم أتخلَّف أَنني عنك صابِر","فكيف تُطِيقُ العين عن نورها صبرا",120,"ر",2,0],["ولما تيقّنَّ أن الفراق","يزوِّد عشاقهنّ البعادا",121,"د",2,0],["ولما تلاقَيْنا ولم نَخْش كاشحاً","ولم نَتكاتم ما بنا من جوى الحبِّ",122,"ب",1,1],["ولمّا تقابلت الجَحْفلان","وعاد كُجْنحِ الظّلامِ الضُّحى",123,"ا",1,0],["ولما تحلّى بالنبوة وانتهى","إلى مستوٍ عنه الملائك توزع",124,"ع",1,0],["وَلَمّا تَوافَقنا وَقَرَّبنَ لِلنَوى","تَرَحَّلنَ أَقماراً وَغادَرنَ أَرماقا",125,"ق",2,0],["وَلَمّا تَلاقَت بِالصَراةِ رِكابُنا","وَرَقَّ لَنا مِن حَرِّ أَنفاسِنا الرَكبُ",126,"ب",1,0],["وَلَمّا تَقَلَّصَ ظِلُّ الرِجالِ","لَجَأتُ إِلى عيصِهِ المُؤتَشِب",127,"ب",1,0],["ولما تمادوا في الضلال دعوتهم","وهيهات أن يلقى العدالة مذنب",128,"ب",1,0],["وَلَمّا تَلتَبِس خَيلٌ بِخَيلٍ","فَيَطَّعِنوا وَيَضطَرِبوا اِضطِرابا",129,"ب",2,0],["ولما تراجعتم كسالى تدرّأوا","وشدوا عليكم في أساطيل ضخمة",130,"ه",1,0],["ولما تلاقينا على حين غفلة","وقد مرَّ بي شهرانِ في الحبّ أو أكثر",131,"ر",1,0],["ولما تناءى عن حِماها حُماتُها","تَناولها الغلمانُ والدُّخلاء",132,"ا",2,0],["ولما تبينّا (دمشقَ) تهلَّلتْ","وجوهٌ عليها البشرُ أصبح باديا",133,"ي",2,0],["ولما تراءينا الهلال بدا لنا","محيا حبيبٍ لم يغب قط عن فكري",134,"ي",1,1],["ولما تجافيتم تعشقت غيركم","لعلي أن ألقى بذلك سلوانا",135,"ن",2,1],["وَلَمّا تَلاقَينا وَجَدتُ بَنانَها","مُخَضَّبَةً تَحكي عُصارَةَ عَندَمِ",136,"م",1,1],["وَلَمّا تَمادَت بَينَنا مُدَّةُ النَوى","وَضاقَت بِحالي في التَباعُدِ حيلَتي",137,"ي",1,0],["ولمّا تَوسَّمْتُ المنازلَ شاقَني","تَذكُّرُ أَيامٍ عَهدْتُ وإخْوان",138,"ن",1,0],["ولم أَتَزوَّدْ من خَسيسِ مَطالبي","وأَبناءُ دَهري بينَ ذُلٍّ وحِرْمان",138,"ن",1,0],["ولمّا توجّه تلقاءه","تحاميتَه كرماً لا سأم",139,"م",1,0],["ولمّا تَجنّبتَ الحرامَ وشُربَه","أتَتْكَ حلالاً من يَديَّ عُقار",140,"ر",1,0],["ولمّا تلاقَيْنا وللعَيْنِ عادةٌ","تثيرُ وشاةً عند كلِّ لِقاء",141,"ا",2,0],["وَلَم آتِ هَذا البَيتَ مِن غَيرِ بابِهِ","وَبابُ أَميرِ القَومِ فَهوَ وَزيرُهُ",142,"ه",1,1],["وَلَم أَتَأَلَّ لَكِن لي رَجاءٌ","بِهِ أَرجو كَريمَ المُستَقَرِّ",143,"ر",1,0],["وَلَمّا تَبدّى لي طرازُ عذارِهِ","رَأَيتُ طرازَ اللَهِ في ثَوب حُسنِهِ",144,"ه",1,0],["وَلَمّا تَناءَت بِالحَبيب دِيارُهُ","وَغودِرتُ مِمَّن غارَ فيهِ عَلى وَهمِ",145,"م",1,1],["ولمّا تَناسَى سيّدي كتبَ عبدِهِ","ولم يأتِنَا منه كِتابٌ ولا رسلُ",146,"ل",1,1],["ولمّا تخوّفتُ ما قَدْ عَلمتَ","تقَنّعتُ عن بحرِه بالوشَلْ",147,"ل",1,0],["وَلَمّا تَرَحَّلَت عَنّي بَكَيتُ","بِدَمعٍ سَكوبٍ يَفيض اِنهِمالا",148,"ل",2,0],["وَلَمّا تُضِف في نَصرَةِ اللَهِ طعنه","إِلى ضَربَةٍ كالبِئرِ فَوقَ شَفا نَهرِ",149,"ر",1,0],["وَلَمّا تَقُم لِلَّهِ بِالقِسطِ مَوقِفاً","سَأَقضي وَلمّا أَقضِ مِن مِثلِهِ نذري",149,"ر",2,0],["وَلَمّا تَبارى النَجم ضوءاً ورِفعَةً","وَصيتاً وَأَنواءً وَهَدياً إِذا يَسري",149,"ر",2,0],["وَلَمّا تَقم في مَشهَدٍ بَعدَ مَشهَدٍ","تَصدّق أَخبار المَخايلَ بِالخُبرِ",149,"ر",1,0],["وَلَمّا تَجارَينا وَغايَة سَبقنا","إِلى المَوتِ كانَ السَبقُ لِلجَذَعِ الغَمرِ",149,"ر",1,0],["ولما تدع مني الثمانون منة","كأني إذا رمت القيام كسير",150,"ر",1,0],["ولمّا تَصافَينا وأَخلَصَ وُدُّنَا","ورُدَّ بيأسٍ كاشحٌ وحَسودُ",151,"د",1,1],["ولم أَتَّبعْ ضَنّاً بكم سَقَطَاتِكُم","لأسبُرَكُم والكَلْمُ يُدميه سَبْرُهُ",152,"ر",2,0],["ولما تَلَفَّتْنا فلم نَرَ أنجماً","هنالك إلاَّ قد غربن غروبا",153,"ب",2,0],["ولمَّا تعالى بالفضائل رفعة","تخيلته يبغي العروج إلى السما",154,"م",2,0],["ولما تولّى الخَدَّ وال عِذارهِ","رفعتُ إليه قِصّتي أتظلَّمُ",155,"م",1,1],["ولما تولى طرفها كل مهجةٍ","على قدها من فرعها عقد الخال",156,"ل",1,0],["ولما تولى البحر ثاني مرةً","خليل المعالي والوزير المؤيدُ",157,"د",1,0],["ولما توافينا وقد غاب كاشح","ونام رقيب واطمأن بنا الخدر",158,"ر",1,0],["ولم أتكلّفْ مثلَ غيري صُنْعَها","ولم آتِ فيما قلتُ مفتخراً نُكرا",159,"ر",2,0],["ولما تقاضى غَرْبُ سيفِكَ نَفْسَهُ","وحاطَتْ لَهُ الأَقدارُ مُحْتَقَنَ الدِّمَا",160,"م",2,0],["ولم أَتَّخِذْ جُنْحَ لَيْلِ المحاقِ","جَناحاً إِلَى نُورِ لَيْلِ السَّواءِ",161,"ا",2,0],["ولَمْ أَتَزَوَّدْ هَبِيدَ القِفارِ","إِلَى بَحْرِ أَرْيٍ جزيلِ العَطَاءِ",161,"ا",2,0],["ولَمَّا تدانَتْ للوداعِ وَقَدْ هَفا","بصَبْرِيَ منها أَنَّةٌ وزَفيرُ",162,"ر",1,0],["ولما تَوافَوْا للسَّلامِ ورُفِّعَتْ","عن الشمسِ فِي أُفْقِ الشُّروقِ سُتورُ",162,"ر",1,0],["ولما تحكمت اليهود بقدسن","ولما استبد بقهرنا دايان",163,"ن",1,0],["ولمّا تفاوضنا الحديثَ عشيةً","ومالَتْ بعطْفَيْهِ المُدامةُ فاسْتَعفى",164,"ف",2,1],["ولما تواقفنا وفي العيس فضلةٌ","بقدر الوقوفِ ساعةً ثم تنقضي",165,"ض",2,0],["ولما تعيَّفتُ فاستعجمت","مَيامنُ كانت بخيرٍ تطيرُ",166,"ر",1,0],["ولما تَمَّ في الميلادِ فَضْلاً","دعوهُ في المبادي بالكمالِ",167,"ل",1,0],["ولما تلاقينا وللشوقِ سَوْرَةٌ","تَرُدُّ جيادَ القوْلِ وهي بِطاءُ",168,"ا",2,1],["ولمَّا تَراءتْ كَعْبَةُ البيتِ كَعْبَةً","منَ الناسِ كَنَّتْها العُلى بأبي الفضْلِ",169,"ل",1,1],["ولمّا توسّطنا مدى النيل غدوةً","ظننتُ وقلبُ اليوم باللهو جذلانُ",170,"ن",1,1],["وَلَمّا تَناهى الحُبُّ في القَلبِ وارِداً","أَقامَ وَسَدَّت بَعدَ عَنّا مَصادِرُه",171,"ر",2,0],["وَلَمّا تَبَدّى الصُبحُ في أَثَرِ الفَجرِ","وَسارَ الدُجى عَنّا بِأَنجُمِهِ الزُهرِ",172,"ر",1,1],["ولما تمادَى البينُ أصبحتُ خاضعاً","وقد كنتُ مِن قبلِ النوى غيرَ خاضعِ",173,"ع",1,0],["ولما تفرَّقنا وودعن خفية","أنامل في حنائها كالأسارعِ",173,"ع",1,0],["ولما تبارى الغيثُ في عرصاتِها","ودمعي فتَهماعٌ ألثَّ وتهمالُ",174,"ل",1,0],["ولمّا تذاكرنا مِنَ العيشِ طيبَهُ","وصفوَ وصالٍ لم نجدْ فيه أكدارا",175,"ر",2,0],["ولمّا تفرَّقنا وأمسيتُ ممسكاً","بكفِّي على أعشارِ قلبٍِ مغلَّذِ",176,"ذ",1,0],["ولمّا ترامَى السربُ قلتُبليةٌ","تراءتْ لمسلوبِ الفؤادِ مجذَّذِ",176,"ذ",1,0],["ولمَّا توسَّطْنا البِطاحَ عشيَّةً","ولاحَتْ لنا الأَنْوارُ في حيِّها الأسمَى",177,"م",2,1],["ولَمَّا تَلافَيْنا التِّلالَ بِلَعْلَعٍ","ولَفَّتْ بنا آرامُ جَرْعاءِ لَعْلَعِ",178,"ع",1,1],["ولمَّا تَقيَّدنا بقيْدِ غَرامنا","بِصدقٍ فمن قيْدِ الوُجوداتِ أفلَتْنا",179,"ن",2,0],["وَلَم أتّهِم تَسويفَه غَيرَ أنّني","أقولُ له شوقي لعلَّ له عُذرا",180,"ر",2,0],["ولما تراءت للهلال بصائر","يغطي الهوا أبصارها بضباب",181,"ب",1,0],["ولما تجاوزت النهاية في العلى","ولاذت بعطفيك الملوك الجحاجح",182,"ح",1,0],["ولما تشكى الأمن خوفاً من العدى","وكاد الهدى يسطو عليه ضلال",183,"ل",1,0],["وَلَم أَتَنَحَّلِ الأَشعارَ فيها","وَلَم تُعجِزِنيَ المِدَحُ الجيادُ",184,"د",1,1],["ولمّا تباكينا عليه وعُرِّيَتْ","طَماعتُنا منه شَأَوْتُ البَواكيا",185,"ي",2,0],["ولمّا تعانقنا ولم يكُ بيننا","سوى صارمٍ في جَفْنِهِ لا من الجُبْنِ",186,"ن",1,1],["ولمّا تركتَ السَّيفَ فيهمْ وحُكمَه","جعلتَ بُكاها في مكان اِبتسامِها",187,"م",3,0],["وَلمّا تَركنا الأثلَ من جَنَباتِنا","وأطربني منهنّ نَوْحُ حَمامٍ",188,"م",1,0],["ولمّا تراخى منك نصرٌ عهدتَه","وظنّوا جواداً بالنّجاحِ مَطولا",189,"ل",2,0],["ولمّا تنادَوْا غفلةً برحيلهمْ","فما شئتَ بين الحيّ من متهالكِ",190,"ك",1,0],["ولمّا تفرّقنا ولم يكُ بيننا","هُنالك لولا النّومُ إلّا التفرُّقُ",191,"ق",1,0],["ولمّا تعسّفْتَ الطّريقَ وجدتَه","وراءَك منقدّاً من النّاس يَعْسِفُ",192,"ف",1,0],["وَلمّا تولّوْا يَحمِلون قُلوبنا","عَلى راتِكاتٍ بالحُدوج رواقِصِ",193,"ص",1,0],["ولمّا تفرّقنا ولم يبق بيننا","سوى ذُكْرةٍ من عاشقٍ متذكّرِ",194,"ر",1,0],["وَلَمّا تَعاتَبنا على الهجر صُغتَ لِي","دَنُوَّك من بُعدٍ ووصلكَ من هجرِ",195,"ر",1,0],["ولمّا تعلّق زين القضا","ة قلبيَ صار لمثواي جارا",196,"ر",2,0],["وَلَمّا تَبيّن عُقبى الأمورِ","وأسفَر دَيجورُها فَاِستَنارا",197,"ر",2,0],["وَلَمّا تَراءَتْ لي مَغبَّةُ قبحِها","وَعُرِّيَ عن دارِ المُجازاةِ بُرْدُها",198,"د",3,0],["وَلَمّا تفرَّقنا كما شاءَتِ النّوى","تبيّنَ حبٌّ خالصٌ وتودُّدُ",199,"د",1,1],["ولمّا تلاقينا بشِعْبِ مُغَمِّسٍ","على شَرَفٍ فيه الوكورُ الجوارحُ",200,"ح",1,0],["وَلَمّا تَناهبنا الثّناءَ بفضلِهِ","وجاشتْ بما تولِي يداهُ القرائحُ",200,"ح",1,0],["ولمّا تُوفِّي الزينبيُّ محمّدٌ","وسارت بما لاقاه أيدي الرَّكائبِ",201,"ب",1,0],["ولمّا تناهبنا النّدى جئتُ راكباً","سنامَ النّدى في كلّ يومِ نِهابِ",202,"ب",1,0],["وَلَمّا تَلاقَينا قَضى اللَيلُ نَحبَهُ","بِوَجهٍ لِوَجهِ الشَمسِ مِن مائِهِ المَحلُ",203,"ل",1,0],["وَلَمّا تَعالى اللَيلُ شَقَّت بِنا السُرى","جَلابيبَهُ حَتّى رَأى دُبرَهُ القُبلُ",203,"ل",1,0],["وَلَمّا تَناءَت بِالقَراباتِ مِنهُمُ","حَوادِثُ تَمريها الوَقائِعُ وَالأَزلُ",203,"ل",1,0],["ولما تم ذا التنزيه منه","وألزم في تحققه الرجالا",204,"ل",2,0],["ولما تأملت الوجود بفكرةٍ","رأيت خيال الظلِّ أكبر عبرةٍ",205,"ه",1,0],["ولما تَغَنّتْ غِناءَ الوداعِ","بَكيْتُ وقلتُ لِبَعْضِ الجواري",206,"ر",2,0],["ولمَّا تولَّى الخدَّ والي عِذارِه","رفَعْت إِليه قِصَّتي أَتَظَلَّم",207,"م",1,0],["ولما تَعَمَّمَ قام الدَّلي","لُ على نَقْصِ مَنْ زِيُّها المِعْجَرُ",208,"ر",1,0]]}