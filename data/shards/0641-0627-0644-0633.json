oem.aspx?id=194108",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6082,"كل الخطى","https://www.poetsgate.com/ViewPoem.aspx?id=60243",""],[6093,"فالسر في ذات وفي طاقاتها","https://www.poetsgate.com/ViewPoem.aspx?id=215221",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[463,"راشَ نبالا في جفنه ورمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60296&r=&rc=352",""]],"verses":[["فَالسَمعُ وَالطاعةُ مِنّي لَكُم","حَسبي بِما تَرضَونَ لي حَسبي",0,"ب",2,0],["فَالسُّهْدُ بَعْدَهُمُ أَلِيفُ مَحَاجِرٍ","وَالْوَجْدُ إِثْرَهُمُ حَلِيفُ جَنَانِ",1,"ن",1,0],["فَالسَفحُ يَجري فَخِنزيرٌ فَبُرقَتُهُ","حَتّى تَدافَعَ مِنهُ الرَبوُ فَالجَبَلُ",2,"ل",1,0],["فَالسَّهْلُ قَدْ دُفِنَتْ فِيهِ مَعَاقِلُنَا","وَالبَحْرُ قَدْ فُقِدَتْ فِيهِ جَوَارِينَا",3,"ن",2,0],["فالسيف أحسن ما يكو","ن إذا تجرّد من قِرابه",4,"ب",2,0],["فَالسِحرُ في ضَحِكِ النَدى مُتَرَقرِقاً","كَالسِحرِ في رَقصِ الضِياءِ مُعَطَّرا",5,"ر",2,0],["فَالسَرايُ جَوهَرَةٌ","لِلعُقولِ تَختَلِبُ",6,"ب",1,0],["فَالسَيفُ يَهدِمُ فَجراً ما بَنى سَحَراً","وَكُلُّ بُنيانِ عِلمٍ غَيرُ مُنهَدِمِ",7,"م",1,0],["فالسّيفُ يَقطعُ وهوَ ذو صَدأٍ","والنّصْلُ يَفْرِي الهامَ لا الغِمْدُ",8,"د",1,0],["فَالسَلمُ يَكسِرُ مِن جَناحَي مالِهِ","بِنَوالِهِ ما تَجبُرُ الهَيجاءُ",9,"ا",2,0],["فَالسَمعُ وَالطاعَةُ مِنّي لَكُم","حَسبي بِما يُرضيكُمُ حَسبي",10,"ب",2,0],["فالسَّيفُ يُبدي ابتساماً عند هَزَّتِه","وقد أسَرَّ المنايا أيَّ إسرارِ",11,"ر",1,0],["فالسُّكرُ بَرِّيِّةٌ بلا عَلَمٍ","يَضَلُّ فيها أخو الهِداياتِ",12,"ت",1,0],["فَالسُكرُ فيما بَينَ ذَينِ مَرَكَّبٌ","كَسَلُ الحَشيشِ وَنَشطَةُ الصَهباءِ",13,"ا",2,0],["فالسحبُ والبرقُ يتلوها كغاشيةٍ","منَ الدخانِ على آثارها لهبُ",14,"ب",1,0],["فَالسَيفِ لا تَذكو بِكَفِّكَ نارُهُ","حَتّى يَسيلَ بِصَفحَتَيهِ ماؤُهُ",15,"ا",3,0],["فَالسَيفُ مَضحَكُهُ وَالقَوسُ حاجِبُهُ","وَالسَهمُ عَيناهُ وَالأَهدابُ أَرماحُ",16,"ح",1,0],["فَالسَوطُ ما اِستَمسَكَتهُ","يَمينَكَ اِستِمساكا",17,"ك",2,0],["فَالسَيفُ تَعرِفُ ذاتُ الخِدرِ مَوضِعَهُ","مِن قَومِها وَهيَ لَم تَضرِب بِقِرضابِ",18,"ب",1,0],["فَالسِلكُ ما اِسطاعَ يَوماً ثَقَبَ لُؤلُؤَةٍ","لَكِن أَصابَ طَريقاً نافِذاً فَسَلَك",19,"ك",1,0],["فَأَلسِنوني أُبَيِّن مُشكِلاتِكُمُ","أَم لَيسَ فيكُم لِأَهلِ الحَقِّ إِلسانُ",20,"ن",1,0],["فالسيف لا تأمنه أن ينقلبْ","كم غلب الحقّ به وكم غُلب",21,"ب",1,0],["فالسببُ الخَفيفُ إِذ يُعدُّ","مُحَرّكٌ وساكِنٌ لا يَعْدُو",22,"و",1,0],["فَالسَّيْفُ لا يَمْضِي بِدُونِ رَويَّةٍ","وَالرَّأْيُ لا يَمْضِي بِغَيرِ مُهَنَّدِ",23,"د",1,0],["فَالسَّعْدُ مُؤْتَنِفٌ لِرَبِّ القَ","صْرِ فِي عُمْرٍ جَدِيدْ",24,"د",1,0],["فَالسَّيْفُ غِمْدٌ ما أَقَا","مَ وَلَمْ يُفَارِقْ جَوْفَ غِمْدِ",25,"د",1,0],["فالسفح يجري فخنزيرٌ فبرقته","حتى تدافع منه الربو فالحبل",26,"ل",1,0],["فالسنّ ضاحِكةٌ والكفُّ مانِحةٌ","والصدرُ متسعٌ والوجهُ منبسِطُ",27,"ط",1,0],["فالسب نشربه مذسبهم عسلا","وشارب المدح منا شارب الصِّبَر",28,"ر",1,0],["فَالسُّلحَفَاةَ فَالقُوَيسِى فالطّي","بِ فَالقَصَّ فالحِمَارَ القَدِيمَا",29,"م",2,0],["فالسدرُ كالرمان وال","جميْزُ كالبيض المحنى",30,"ن",2,0],["فَالسِلمُ مِثلُ الحَربِ مُنذُ تُخُوِّفَت","وَثَباتُ بَأسِكَ وَالإِقامَةُ كَالسُرى",31,"ر",2,0],["فَالسَبعَةُ الشُهبُ لَو نالَت أَمانِيَها","لَأَصبَحَت خَوَلاً مَعَ هَذِهِ الخَوَلِ",32,"ل",1,0],["فالسعيَّ يوجب رزقَ محرومٍ ولا","ترك المساعي يوجبُ الحِرمانا",33,"ن",2,0],["فالسيف يخشى حده في غمده","وإذا تجرد فالمخافة أكثر",34,"ر",1,0],["فالسحب قد تقلع حيث ترتجي","ثم يكون الخير فيما يعقب",35,"ب",1,0],["فالسبعة الخضر تسموها أنامله","وعزمه هازىء بالسبعة الشهب",36,"ب",1,0],["فالسيد البهلول خلف منهم","للناسبين السيد البهلولا",37,"ل",2,0],["فالسمر لولا السطا يوم اللقا قصب","والمسك لولا الشذا ضرب من العلق",38,"ق",1,0],["فَالسَيفُ أَكرَمُ مُجتَدىً يَمَّمتَهُ","فَإِذا تَلُوذُ بِهِ فَأَمنَعُ مَعقِلِ",39,"ل",1,0],["فالسيف يقطع ما بقى","حدّاهُ إن أودى نجاده",40,"د",2,0],["فالسيف في غمده كفت مكارهه","وحدذه فيه إن غابت مضاربُه",41,"ب",2,0],["فالسحرُ والزارُ والأسيادُ جملتها","لأهلها نكدٌ ما مثلهِ نكدُ",42,"د",1,0],["فالسيفْ والخيلُ تَرْوي عن مَعارِكه","وأشْهَرتْ علمَه لي أصدقُ الكُتُبِ",43,"ب",1,0],["فالساكن أبدلن بحرف جانس","حركة الذ قبله كيونس",44,"س",1,0],["فَالسَماءُ الَّتي أَنارَت شَبابي","وَضَعَت مُهجَتي عَلى شَفَتَيّا",45,"ي",2,0],["فَالسَلامُ رائِدُها","لا الشِقاقُ وَالعَطبُ",46,"ب",1,0],["فَالسِلمُ دَرسٌ وقد عَلِما","مَغبَّةَ السِلمِ كيف تحمي",47,"م",2,0],["فَالسُحبُ تَبعُدُ أَن تُنالَ وَصَوبُها","دانٍ قَريبٌ مِن يَدِ المُتَناوِلِ",48,"ل",1,0],["فَالسَّعْدُ مِنْ أَنْصَارِهِ","وَالْحِلْمُ رَائِدُهُ الْمُسَدَّدْ",49,"د",1,0],["فالسمر ما أَصبحت وَالشَمسُ ما أَفلَتِ","وَالسَيفُ ما فُلّ وَالأَطواد لَم تَزُلِ",50,"ل",1,0],["فالسكر طلاه قد أخذا","منّا الأرواح وطاب شذا",51,"ذ",2,0],["فالسقم قد نمّ عن غرامي","ورقّ لي في الهوى حسودي",52,"د",2,0],["فالسباق السباق حيّ على السا","قي بشمس النهار في راحاتك",53,"ك",1,0],["فالسَموات السَبع وَالعرش وَالكر","سي وَالحجب ذكرها التَهليل",54,"ل",1,0],["فَالسَيفُ في كَفِّهِ لَهُ وَمَضا","نُ البَرقِ ماضٍ عَظيمُ تَأثيرِ",55,"ر",1,0],["فَالسُيوفُ النيرانُ فَاِعجَب لنيرا","نٍ تُرى مِن أَكُفِّهِم في بُحورِ",56,"ر",1,0],["فَالسَعدُ يَخدِمُهُ وَالنَصرُ يقدمُهُ","فَلو يَشاءُ لَفَضَّ النَبعَ بِالغَرَبِ",57,"ب",1,0],["فَالسَمع تَاللّه لَم يسمع بذي نَظرٍ","أَعلى يَداً مِنهُ بِالسَمعيِّ وَالنَظرِ",58,"ر",1,0],["فَالسَماح السَماح يا بَهجَة الوَقت","وَرَوض العُلوم نُظما وَنثرا",59,"ر",2,0],["فَالسيد الحبر عَبد الخالِق اِنتَصَبت","لِمَجدِهِ بَينَ أَهلِ الفَضلِ رايات",60,"ت",1,0],["فالسّاخِطُ الحُرُّ له رَجْعةٌ","والصّعْبُ أمْرُ السّاخطِ السّاقط",61,"ط",1,0],["فالسُّمْرُ مركوزةٌ والبِيضُ مُغمَدةٌ","لكنّها في طُلىً منهمْ وفي ثُغَر",62,"ر",1,0],["فَالسِرُّ مَحمولٌ وَلَيسَ بِحامِلٍ","أَو لا فَمَوجودٌ وَلا بِمَكانِ",63,"ن",1,0],["فالسيف إن أغمدتَه أصدأتَه","وإذا انتُضِي في البؤس كان شُموسا",64,"س",2,0],["فالسيف معناه الطبيعةُ نفسُها","أما الكتاب فشرع ربٍّ يَرؤس",65,"س",1,0],["فالسيف من خدامها فإذا بدت","أبصرتها موتاً بدا أخَّاذا",66,"ذ",2,0],["فالسيف يزهو رونقاً بصقاله","إن جال ماءُ فرنده في حدهِ",67,"ه",1,0],["فالسيف مهما هزه ال","سياف يبهره صفيحه",68,"ح",2,0],["فألسنة الأكوان تحمد فعلها","وتمدحها في فاتحاتٍ فصيحة",69,"ه",1,0],["فالسلام السليم من كلِّ زورٍ","وادِّعاءٍ يؤمِّن الخائفينا",70,"ن",2,0],["فالسعدُ والإقبالُ من خُدّامه","لا بل هما في الرقّ بعض عبيده",71,"د",2,0],["فالسَّعْدُ والإِقبالُ من خُدَّامها","والعالم العلويُّ من أَعوانها",72,"ن",3,0],["فالسّقامُ الذي أَنالَكَ ظِلُّ","سُجِّرَتْ نارُهُ بجاحِمِ جَمْرِهْ",73,"ر",2,0],["فَالسَّيْرَ حتى تَقُولَ العِيسُ من خمر","صِرْنَا رُسُوماً وكُنَّا أَيْنُقاً رُسُما",74,"م",2,0],["فالسُّقاةَ السُّقاةَ أَسعدكَ الل","ه على حَثِّكَ السُّقاة السُّقاتا",75,"ت",2,0],["فالسِّقْطِ فالأراكِ فالثرثارِ فال","جِزعِ ففيْدٍ فالعقيقِ فالحُوى",76,"ا",1,0],["فالسهمُ لو لم ينجُ منْ","شرَكِ الحنيّة لم يُصِبْ",77,"ب",1,0],["فالسُحْبُ ترشَحُ إذ جرتْ","في إثْرِه بالجهدِ قطْرا",78,"ر",2,0],["فالسيفُ يُقرعُ بينَهُم","بشقيقِه والضيفُ يُقْرى",78,"ر",2,0],["فالسيفُ يروي منه عن جارِمٍ","والضيفُ يَروي منهُ عن عادِلِ",79,"ل",1,0],["فالسُمرُ في غاباتِها","معدودةٌ في القصَبِ",80,"ب",1,0],["فالسعد في أرجائها متضوّع","قد فضّ عنه لذاك خير ختام",81,"م",1,0],["فالسعدُ بالنصرِ العزيزِ مُخَبِّرٌ","واليُمْنُ بالفتحِ المُبينِ بَشِيرُ",82,"ر",1,0],["فالسّحْرُ أدْنى عنْدَ غَنْجِ لحاظها","من أنْ نُمثّلها به ونقيسا",83,"س",2,0],["فالسيفُ لا يصدُق القضاءُ له","بالعين إلا ما فُلَّ أو ثُلما",84,"م",2,0],["فالسيف يعلَقُ بالأنامل حدُّه","والعين تأباه بغَير صقالِ",85,"ل",1,0],["فالسيفُ يجمع ماله","والمكرمات تفرِّقُهْ",86,"ق",2,0],["فالسيف ما لم يمض قُدماً زُبرةٌ","والليثُ كلبُ البيت ما لم يفرِسِ",87,"س",1,0],["فألسنهُم غَيظاً بواردُ رَطْبَةٌ","وأكبادُهم خلفَ الضلوع حِرارُ",88,"ر",1,0],["فالسيفُ منهم في يمين المنتضِي","كالسيف منهم في يمين الغامدِ",89,"د",1,0],["فالسيفُ يأخذُ حُكمَهُ من مِغفَر","وطُلىً ويأخذُ منه سِنُّ المِبرَدِ",90,"د",1,0],["فالسيف يُخْبَرُ قَطْعاً وهو مدَّخَرٌ","والطِّرْفُ يكرَمُ طبعاً وهو مجنوبُ",91,"ب",1,0],["فالسيفُ لم يسم