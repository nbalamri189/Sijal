{"poems":[[90,"متى نرجو لغمتنا انكسافا","https://www.aldiwan.net/poem44828.html","الوافر"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56012","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60819","الكامل"],[121,"إلى مفدي زكريا","https://www.poetsgate.com/ViewPoem.aspx?id=186221",""]],"verses":[["نحِجّ لأجله بيت المخازي","ونكثر حول كعبته الطوافا",0,"ف",2,0],["نَحُجُّهُ بالرَّسْمِ","فَهْوَ دَليلٌ عِلْمي",1,"ي",1,0],["نحجبة في الخدر لكنّ أمرها","كسهمٍ مصيبٍ جلَّ ذاك التحجّبُ",2,"ب",1,0],["نحج لبيت حجه الرسل قبلنا","لنشهد نفعاً في الكتاب وعدناه",3,"ن",3,0],["نحجُّ إلى هذا الضريحين كُلُمَّا","أردنا فنلقي البَيْتَ والحجرِ والْصَفَا",4,"ف",2,0],["نَحُجُّ إلى شَعبِ الجَزائرِ مِثْلَما","تَحُجُّ وُفُودُ اللهِ مَكَّةَ لِلرُّشْدِ",5,"د",1,0]]}