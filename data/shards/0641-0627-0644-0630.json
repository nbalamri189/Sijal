{"poems":[[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[77,"بلد قد غزاه صرف الليالي","https://www.aldiwan.net/poem36639.html","الخفيف"],[86,"فيا وليدي كن غدا شاعرا","https://www.aldiwan.net/poem68859.html","السريع"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[92,"سر مع الدهر لا تصدنك","https://www.aldiwan.net/poem38962.html","الخفيف"],[56,"ليتني لم أكن لعطفك نلت","https://www.aldiwan.net/poem58631.html","الخفيف"],[45,"سقيا لمجلسنا الذي آنسته","https://www.aldiwan.net/poem62650.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21104","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[77,"بلد قد غزاه صرف الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=33558",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[161,"الحمد لله حمدا ليس يحصيه","https://www.aldiwan.net/poem58981.html","البسيط"],[167,"وفت السعود بوعدها المضمون","https://www.aldiwan.net/poem46843.html","الكامل"],[233,"عودي علي ولو كلمح الناظري","https://www.aldiwan.net/poem14832.html","الكامل"],[238,"نحن قوم إن غاب عنا الساقي","https://www.aldiwan.net/poem19520.html","الخفيف"],[260,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[321,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[378,"الذكر يحدث أشباحا مخيلة","https://www.aldiwan.net/poem59173.html","البسيط"],[381,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[392,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[392,"الحمدلله حمدا كل آن","https://www.aldiwan.net/poem54458.html","عموديه"],[392,"ذاوقت ما فيه شى يعجب","https://www.aldiwan.net/poem54559.html","عموديه"],[406,"كل يرتقى إليه بوهم","https://www.aldiwan.net/poem49651.html","الخفيف"],[410,"أبا الفوارس إن أنكرت قبض يدي","https://www.aldiwan.net/poem31643.html","عموديه"],[462,"سلم الأمر إلى مالكه","https://www.aldiwan.net/poem16011.html","الرمل"],[462,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[469,"طلق الغرة التي أنت فيها","https://www.aldiwan.net/poem60520.html","الخفيف"],[494,"غادني بالصبوح قبل الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[501,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[530,"أكؤوس مترعات من عقار","https://www.aldiwan.net/poem37409.html","الرمل"],[530,"الجواب الذي أراه صوابا","https://www.aldiwan.net/poem37448.html","الخفيف"],[539,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[552,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[559,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[559,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[559,"نحن علم الله في الله وما","https://www.aldiwan.net/poem34569.html","الرمل"],[559,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[568,"كيف يبقى من يعرضه","https://www.aldiwan.net/poem69513.html","المديد"],[576,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["فالذّابِلُ الخَطّيُّ يَشكو الصّدى","حتّى يُرَوّى بالنّجيعِ المُفاحْ",0,"ح",1,0],["فالذي خرّ منْ بِناهُ قَتيلٌ","والذي قَرّ منْهُ بعْضٌ جَريحُ",1,"ح",1,0],["فَالذَنبُ ذَنبي وَأَنا المُعتَدي","هَل يَسلَمُ الشاعِرُ مِن شاعِرِ",2,"ر",1,0],["فَالذَنبُ ذَنبُ شُدودي","فَاِلعَن شُدودي وَدَعني",3,"ن",2,0],["فالذي فيه إنْ نَظَرْنَا من الشَّر","رِ لِعادٍ بكُفْرها وثمودِ",4,"د",1,0],["فَالَّذي يَتَّقي العَواذِلَ يَلقى","كُلَّ حينٍ في كُلِّ شَخصٍ عَذولا",5,"ل",2,0],["فالذي يُرْهِبُ الحياةَ شقيٌّ","سَخِرَتْ من مصيرهِ الأَجْداثُ",6,"ث",1,0],["فالذي مِنِّي اشْتَمَلْتِ عليهِ","أَلِعَارٍ ما قَدْ عليهِ اشْتَمَلْتُ",7,"ت",1,0],["فَالذِكرُ مِنكَ لَنا نَديمٌ حاضِرٌ","وَالشَخصُ مِنكَ لِغَيرِنا صَيَّرتَهُ",8,"ت",2,0],["فالّذي يُمِسكُهُ يَحمَدُهُ","تَثِقٌ كالسِّيدِ مُمتَدُّ الرَّسَن",9,"ن",1,0],["فالَّذِي أَوْلدَهُ الفتْكُ بِهِمْ","أَنَّهُمْ قُلٌّ غدَوْا بِالقتْلِ كُثرَا",10,"ر",2,0],["فَالَّذي صَحَّ لَهُ عَنهُ صَحا","وَإِذا اِعتَلَّ بِهِ القَلبُ اِعتَلَق",11,"ق",1,0],["فالذي خر من بناه قتيل","والذي خر منه بعض جريح",12,"ح",1,0],["فالذينَ استَمدَحُوكَ استَذأَبُوا","ويُقالُ اليَومَ عَنهُم صُنتَ قَدحَك",13,"ك",1,0],["فالذكْرَياتُ الغُرُّ يَشهدُها","رقراقُهُ الصافي وتَشْهَده",14,"د",2,0],["فالذيب والشاة في أيامه اصطلحا","صلحا نفى المتعدى عن تعديه",15,"ي",2,0],["فالذنْبُ ذنبُ السامريِّ وعجْلِهِ","والعَتْبُ من موسى على هارونِ",16,"ن",1,0],["فَأَلَذُّ عَيشٍ ما اِنقَضى وَتَراجَعَت","كَرَماً بِهِ أَيدي الزَمانِ الغادِرِ",17,"ر",1,0],["فَالذِي عِنْدَكُمْ مِنَ الْفَضْلِ لاَ يَنْ","فِدُ وَالْمَرْءُ ذُو هَوىً تَوَّاقِ",18,"ق",1,0],["فالذوق من الممزوج يفرْ","يا صاحب حان الخمر أدرْ",19,"ر",1,0],["فالذَمُّ للطَعام","من شيمةِ الطَغامِ",20,"م",1,0],["فَالذَنبُ أَجرَمَ لَم تَغرِب جَسامَتُهُ","وَالرَبُّ أَكرَمَ لَم تَعزِب كَرامَتُهُ",21,"ت",2,0],["فالذكر كالشم موضوعاً ومحمولا","عن حسه العام مجلوّاً ومصقولا",22,"ل",2,0],["فَالذُل إِن صَبَروا وَالرُعب إِن نَفَروا","وَالقَتل إِن ظَهَروا وَالنار إِن قَبَروا",23,"ر",3,0],["فالذكر لله يجلي عن فؤادك صداه","والذكر لله يحيى القلب بل هو غذاه",24,"ا",2,0],["فالذكر لله يجلي كل ران","ويبعد الشر وابليس اللعين",25,"ن",1,0],["فالذكر لله ما مثله","تبعد به ابليس والخناس",26,"س",1,0],["فالَّذي أبدَعَ البَرِيَّةَ أعلى","مِنهُ سُبْحانَ خالِقِ الأشياءِ",27,"ا",2,0],["فالذنب للموت أرجاني إلى زمن","غلت أكف الندى بؤساه بالعدم",28,"م",1,0],["فالذي يمْلِكهُ ذو قُدْرةٍ","يجعلُ العجزَ طَريقاً للغِنى",29,"ن",2,0],["فالذي حازَ رِضيً منْ رَبِّهِ","وتَسامى منْ جَلالٍ لِجلالِ",30,"ل",1,0],["فَأَلَذُّ الأَنامِ عِندِيَ عَيشاً","مَن تَسَرّى بِخُلَّةِ السَرّاءِ",31,"ا",2,0],["فَأَلَذّ الحَياةِ ما خَلَطَ العا","قِلُ فيهِ فَسادَهُ بِصَلاحِ",32,"ح",1,0],["فالَّذي أَغْناهُ في آزالِهِ","بجُحودِ النَّاسِ لا يفتَقِرُ",33,"ر",1,0],["فالّذي قَدْ حَلّ في الْقَلْبِ من ال","حُبِّ يُغْني عَنْ عَناءِ الاِعْتِذارِ",34,"ر",1,0],["فالذي قَالَ إنَّ عُمرانَ رَبْعِ ال","حُبِّ بالحُبِّ نافِعٌ في الْبِعادِ",35,"د",1,0],["فالذكرُ منه بُجلا","على لِسان الحِقَبِ",36,"ب",1,0],["فالذّكرُ عندي مقيمٌ إنْ نُسِيتَ وإِنْ","سُلِيتَ يوماً فغيري قلبُه السّالي",37,"ل",2,0],["فالذُّلُّ للنَفسِ إذا ما عَصتْ","والعزّ للنّفسِ إذا ولّتِ",38,"ت",1,0],["فالذي من قسم طاعات","محض إنعامٍ بلا إهمال",39,"ل",1,0],["فالذي منك قد وفى فتدلى","لم ينقِّصه كونه ابن العواتك",40,"ك",1,0],["فالذي يؤمن بالحق الذي","قلته نال مقامات السعود",41,"د",1,0],["فالذي أمنعه يشقى ومن","أجعل الحق له قد سعدا",42,"د",2,0],["فَالَّذِي يَشْفِيْهِ يُمْرِضُهُ","وَالَّذِي يُحْيِيْهِ يَحْتَرِمُهْ",43,"م",2,0],["فالذي قرَّ منهم قَرَّ عَيْنَاً","والَّذِي فَرَّ لاَ يَكَادُ يَكيدُه",44,"د",2,0]]}