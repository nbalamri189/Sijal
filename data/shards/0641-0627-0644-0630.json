89",""],[5506,"إن جِئتَ بَدراً فَطِب وَاِنزِل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[5691,"أعشاب ضارة","https://www.poetsgate.com/ViewPoem.aspx?id=206082",""],[5704,"يا سيد الرسل ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=198742",""],[5906,"غدا يشيّعنا التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=193749",""],[5950,"فالذاكرة ياما وياما من الناس","https://www.poetsgate.com/ViewPoem.aspx?id=139976",""],[5956,"اكتم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185360",""],[6079,"يا تعسَ قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=207048",""],[6142,"عمد البرق والكؤوس وما امتد","https://www.poetsgate.com/ViewPoem.aspx?id=155690",""],[5309,"دعني الاقي اضطهدا من بني بلدي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573903",""],[6324,"سهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87940&r=&rc=5",""]],"verses":[["فالذّابِلُ الخَطّيُّ يَشكو الصّدى","حتّى يُرَوّى بالنّجيعِ المُفاحْ",0,"ح",1,0],["فالذي خرّ منْ بِناهُ قَتيلٌ","والذي قَرّ منْهُ بعْضٌ جَريحُ",1,"ح",1,0],["فَالذَنبُ ذَنبي وَأَنا المُعتَدي","هَل يَسلَمُ الشاعِرُ مِن شاعِرِ",2,"ر",1,0],["فَالذَنبُ ذَنبُ شُدودي","فَاِلعَن شُدودي وَدَعني",3,"ن",2,0],["فالذي فيه إنْ نَظَرْنَا من الشَّر","رِ لِعادٍ بكُفْرها وثمودِ",4,"د",1,0],["فَالَّذي يَتَّقي العَواذِلَ يَلقى","كُلَّ حينٍ في كُلِّ شَخصٍ عَذولا",5,"ل",2,0],["فالذي يُرْهِبُ الحياةَ شقيٌّ","سَخِرَتْ من مصيرهِ الأَجْداثُ",6,"ث",1,0],["فالذي مِنِّي اشْتَمَلْتِ عليهِ","أَلِعَارٍ ما قَدْ عليهِ اشْتَمَلْتُ",7,"ت",1,0],["فَالذِكرُ مِنكَ لَنا نَديمٌ حاضِرٌ","وَالشَخصُ مِنكَ لِغَيرِنا صَيَّرتَهُ",8,"ت",2,0],["فالّذي يُمِسكُهُ يَحمَدُهُ","تَثِقٌ كالسِّيدِ مُمتَدُّ الرَّسَن",9,"ن",1,0],["فالَّذِي أَوْلدَهُ الفتْكُ بِهِمْ","أَنَّهُمْ قُلٌّ غدَوْا بِالقتْلِ كُثرَا",10,"ر",2,0],["فَالَّذي صَحَّ لَهُ عَنهُ صَحا","وَإِذا اِعتَلَّ بِهِ القَلبُ اِعتَلَق",11,"ق",1,0],["فالذي خر من بناه قتيل","والذي خر منه بعض جريح",12,"ح",1,0],["فالذينَ استَمدَحُوكَ استَذأَبُوا","ويُقالُ اليَومَ عَنهُم صُنتَ قَدحَك",13,"ك",1,0],["فالذكْرَياتُ الغُرُّ يَشهدُها","رقراقُهُ الصافي وتَشْهَده",14,"د",2,0],["فالذيب والشاة في أيامه اصطلحا","صلحا نفى المتعدى عن تعديه",15,"ي",2,0],["فالذنْبُ ذنبُ السامريِّ وعجْلِهِ","والعَتْبُ من موسى على هارونِ",16,"ن",1,0],["فَأَلَذُّ عَيشٍ ما اِنقَضى وَتَراجَعَت","كَرَماً بِهِ أَيدي الزَمانِ الغادِرِ",17,"ر",1,0],["فَالذِي عِنْدَكُمْ مِنَ الْفَضْلِ لاَ يَنْ","فِدُ وَالْمَرْءُ ذُو هَوىً تَوَّاقِ",18,"ق",1,0],["فالذوق من الممزوج يفرْ","يا صاحب حان الخمر أدرْ",19,"ر",1,0],["فالذَمُّ للطَعام","من شيمةِ الطَغامِ",20,"م",1,0],["فَالذَنبُ أَجرَمَ لَم تَغرِب جَسامَتُهُ","وَالرَبُّ أَكرَمَ لَم تَعزِب كَرامَتُهُ",21,"ت",2,0],["فالذكر كالشم موضوعاً ومحمولا","عن حسه العام مجلوّاً ومصقولا",22,"ل",2,0],["فَالذُل إِن صَبَروا وَالرُعب إِن نَفَروا","وَالقَتل إِن ظَهَروا وَالنار إِن قَبَروا",23,"ر",3,0],["فالذكر لله يجلي عن فؤادك صداه","والذكر لله يحيى القلب بل هو غذاه",24,"ا",2,0],["فالذكر لله يجلي كل ران","ويبعد الشر وابليس اللعين",25,"ن",1,0],["فالذكر لله ما مثله","تبعد به ابليس والخناس",26,"س",1,0],["فالَّذي أبدَعَ البَرِيَّةَ أعلى","مِنهُ سُبْحانَ خالِقِ الأشياءِ",27,"ا",2,0],["فالذنب للموت أرجاني إلى زمن","غلت أكف الندى بؤساه بالعدم",28,"م",1,0],["فالذي يمْلِكهُ ذو قُدْرةٍ","يجعلُ العجزَ طَريقاً للغِنى",29,"ن",2,0],["فالذي حازَ رِضيً منْ رَبِّهِ","وتَسامى منْ جَلالٍ لِجلالِ",30,"ل",1,0],["فَأَلَذُّ الأَنامِ عِندِيَ عَيشاً","مَن تَسَرّى بِخُلَّةِ السَرّاءِ",31,"ا",2,0],["فَأَلَذّ الحَياةِ ما خَلَطَ العا","قِلُ فيهِ فَسادَهُ بِصَلاحِ",32,"ح",1,0],["فالَّذي أَغْناهُ في آزالِهِ","بجُحودِ النَّاسِ لا يفتَقِرُ",33,"ر",1,0],["فالّذي قَدْ حَلّ في الْقَلْبِ من ال","حُبِّ يُغْني عَنْ عَناءِ الاِعْتِذارِ",34,"ر",1,0],["فالذي قَالَ إنَّ عُمرانَ رَبْعِ ال","حُبِّ بالحُبِّ نافِعٌ في الْبِعادِ",35,"د",1,0],["فالذكرُ منه بُجلا","على لِسان الحِقَبِ",36,"ب",1,0],["فالذّكرُ عندي مقيمٌ إنْ نُسِيتَ وإِنْ","سُلِيتَ يوماً فغيري قلبُه السّالي",37,"ل",2,0],["فالذُّلُّ للنَفسِ إذا ما عَصتْ","والعزّ للنّفسِ إذا ولّتِ",38,"ت",1,0],["فالذي من قسم طاعات","محض إنعامٍ بلا إهمال",39,"ل",1,0],["فالذي منك قد وفى فتدلى","لم ينقِّصه كونه ابن العواتك",40,"ك",1,0],["فالذي يؤمن بالحق الذي","قلته نال مقامات السعود",41,"د",1,0],["فالذي أمنعه يشقى ومن","أجعل الحق له قد سعدا",42,"د",2,0],["فَالَّذِي يَشْفِيْهِ يُمْرِضُهُ","وَالَّذِي يُحْيِيْهِ يَحْتَرِمُهْ",43,"م",2,0],["فالذي قرَّ منهم قَرَّ عَيْنَاً","والَّذِي فَرَّ لاَ يَكَادُ يَكيدُه",44,"د",2,0],["فالذَّلُ أبقَى لِبَعضِ الذُّلِ في نَعَمٍ","كانَ الهُزالُ لَها أوفَى مِنَ السِّمَنِ",45,"ن",1,0],["فالذات في ذاتها تبدى خواطرها","في وصفها لا بعين الجسم تنتقل",46,"ل",1,0],["فالذي يزرع البلاءَ بقومٍ","آمِن السِرب يحصُد التأديبا",47,"ب",2,0],["فالذي اختارَ أقرَبَ الطُّرقِ منها","غالبٌ من يختارُ طولَ المجالِ",48,"ل",1,0],["فَالَّذِي فِي الفَخْرِ يَلْحَا","نِي مُسِيءٌ قَدْ تعَدّا",49,"د",2,0],["فالذّلُّ من قِبَل المُلو","كِ أجَلُّ من عِزِّ الخَوَلْ",50,"ل",1,0],["فَأَلذُّ شربِ الراحِ بَل أَحلاهُ ما","يَبدو عَلى وَردِ الخُدودِ وَنَرجسِ",51,"س",1,0],["فَالّذي ما بَينَها أَسنى اللّمى","يُذهِبُ الغمَّ وَضيق النّفسِ",52,"س",1,0],["فالذي يحضُرُ يَدري","من يلي وجهَ البِساطِ",53,"ط",1,0],["فَالذِكْرُ مِنْهَا عِنْدَنَا وَالأَجْرُ لَكْ","إِذ حالَ دُونِي مِصْرَعُ البابِ المِصَكْ",54,"ك",1,0],["فالذات بعد العدّ أو قدر فزن","وامسح وكل شبّه وفرّع تستبن",55,"ن",1,0],["فالذي قد بنوه نبني له مث","لاً ونجري له على مِضمارِ",56,"ر",1,0],["فالذل لم تلحق شوائبُ وقعه","عبداً يلوذ بأكرم الكرماء",57,"ا",2,0],["فأََلذُّ وصلٍ كان من بعدِ الجَفا","والقربُ يَحلو بعد طُول بِعاد",58,"د",1,0],["فالذي كنت أتقي","شر عدوانه شرد",59,"د",1,0],["فالذنب منى والسماحة منك أعهدها","وشمس العفو لى لم تأفل",60,"ل",1,0],["فالذي لا وفاق فيه وأبعا","د لأرحامه ونكر ولاها",61,"ا",3,0],["فالذي كان فيه هدس شقيق","تلكم الصورة التي أبداها",61,"ا",3,0],["فالذي رام عين إدراك معنى","وصفكم رام أن يجاري الاها",61,"ا",3,0],["فالذي أعرب السؤال ولو را","م جميع الدنيا بكم لاحتداها",61,"ا",3,0],["فالذي أنزلَ ابراهيمَ في","قصره أمسى نزيلاً في حفير",62,"ر",1,0],["فالذكر يحجبني والذكر يكشفُ لي","خَبأَ السماءِ وخبأ الأرض في نبأ",63,"ا",1,0],["فالذي يرى وجودي","لتصاريفِ الزمانِ",64,"ن",1,0],["فالذي يدري الذي أقصده","كلما قلتُ ألا قال ألم",65,"م",1,0],["فالذي آمن منهم","لم يزل حّياً بحيّ",66,"ي",1,0],["فالذي يفهمه","يدر قولي ويجل",67,"ل",1,0],["فالذي أطلق منهم علمه","ربُّ حربٍ ونزاعٍ وكفاح",68,"ح",1,0],["فالذَّاتُ خُصَّت بالسَّمَاءِ وإنَّمَا ال","مَعلُومُ عَمَّ ذِي الأكوَانِ",69,"ن",1,0],["فَالذلّ بَينَ معشر تركتهم","عَنهُم يزاح الكَرب بانتِزاح",70,"ح",1,0],["فالذاكرون تلعثموا غلطاً به","والمنصتون لهوا بسمع حداء",71,"ا",2,0],["فَالَّذي في الخَدِّ طوراً آفلٌ","تَحتَ صُدغٍ فَوقَ صُبحٍ قَد رَحَل",72,"ل",1,0],["فَالَّذي نَعشَقُهُ يَأساً قَضى","وَالَّذي نَطلُبُه مَلَّ وَراح",73,"ح",1,0],["فَالَّذي جادَت بِهِ أَيدي الدُّهور","سلَبَته خلسَةً كَفُّ الشّقاء",73,"ا",2,0],["فَالَّذي عاشَ رَبيعاً","كَالَّذي عاشَ الدُّهور",74,"ر",1,0],["فَالَّذي يَحيا بِعَجزٍ","فَهوَ في بُطءٍ يَموت",74,"ت",1,0],["فالذكر أسير في الافاق من مثل","والعلم اشهر من نار على علم",75,"م",1,0],["فالذهبُ الأكسيرُ كالجمانِ","عن جابرٍ يروى غِنى هذا الزمنْ",76,"ن",1,0],["فالذي قاسَني بقَيْسٍ وقد ها","مَ بِلَيْلاهُ مُخْطئٌ في المَقايِسْ",77,"س",1,0],["فَأَلذُّ عيشكَ ما قضيتَ زَمانَه","مع ذي وَدادٍ صانَ أَو قولٍ صَدَق",78,"ق",1,0],["فَألذُّ عيشكَ ما قضيتَ غَبوقَهُ","مع غادةٍ وصَبوحَه مع أَغيد",79,"د",1,0],["فَالذَنب مني شيمتي وَالرضا","وَالعَفو مِنكَ يا مُنى مَن سَألْ",80,"ل",1,0],["فالذي يرتضي العذاب لأرضَى","كيف أدعوه ما اسمه في البيان",81,"ن",1,0],["فالذكر والنظر العيان كلاهما","حلم بها متشابه الأفواف",82,"ف",1,0],["فالذم للطعام","من عادة الطغام",83,"م",1,0],["فالذكر عمر آخر","يبقى على كر الدهور",84,"ر",1,0],["فالذي منهما مزيجاً أنالا","زفس يلقى خيراً ويلقى وبالا",85,"ل",2,0],["ف الذي قد أديت مالاً لبابا","قام فريام ينهض الفيج رعبا",85,"ب",2,0],["فالذي قد أَسرَرتُ هاكُم جَهاراً","لِجَميعِ الإِغرِيقِ لَستُ بِناكِس",86,"س",1,0],["فالَّذي عِندَ ما يُوافِينَهُ يُب","دِي احتِراماً فَعَنهُ يَدفَعنَ ضُراًّ",87,"ا",1,0],["فالذنب أقعده عن العلياء","قهرا بل أنامه",88,"م",2,0],["فالذي به بطء","كالذي به عجل",89,"ل",1,0],["فالذكر قد يغني عن اللقيا إذا","طال النوى وتقادم العهد",90,"د",1,0],["فالذئبُ ضارٍ فاتكٌ مهما بدا","في أُلفةٍ لجليسهِ يتودد",91,"د",1,0],["فالذي كان منكِ قد صار عذراً","مُبعِداً لي عَن الذي في ركابك",92,"ك",1,0],["فالذنبُ يسكنني والصبرُ يخذلني","وباب عفوِك مفتوحٌ لمن سألا",93,"ل",2,0],["فالذِّكرُ تَبقَى بصَدرِ الكَونِ مُهْجَتُهُ","والفَضلُ رُغمَ لُهاثِ العُمرِ لا يَقِفُ",94,"ف",1,0],["فالذل خزي وعار ليس مئذنة","أو عاد صومعة فالذل يخزينا",95,"ن",2,0],["فالذّئْبُ والْحمَلُ الْوديعُ تجاورا","وتطيرُ أسْرابُ الْحَمامِ مَعَ الصّقرْ",96,"ر",1,0],["فالذل في دعةٍ والنبل في ضعةٍ","يا للمعرة والأحقاب ترويها",97,"ي",3,0],["فالذي منكم يعيش قليلاً","منشد الحال قولة الأشقياء",98,"ا",2,0],["فالذي في يد العباد بعيد","والذي في يد الإله قريب",99,"ب",1,0],["فالذنب ذنبي إذ أجبت وكان لي","دون الإجابة نفرة الكرماء",100,"ا",2,0],["فالذلُّ أعلى مقاماتِ العلى رُتَباً","والعزُّ صهينةُ الأعرابِ .. يا عَرَبُ",101,"ب",1,0],["فالذئب، والظربان، والفأر،","والحلوف، للشورى وللبرلمان",102,"ن",1,0],["فالذئب يحنو للنعاج بنظرة","وإذا تكشر نابه لا يرفق",103,"ق",1,0],["فالذي ينحني لغير إلهي","ليس بالمسلم الأصيل الحقيقي\"",104,"ق",2,0],["فالذكر معتمرٌ والشكرٌ منهمر","يانور شمسكمُ كم ذوّبت مُهجا",105,"ج",2,0],["فالذي قد راعني اليأس به","يقتضي أكثر مما قد جرى",106,"ر",2,0],["فَالذّات في مَدَدٍ وَالوَصفُ في مَننٍ","وَالخَلقُ في شَرَفٍ وَالخُلقُ في عِظَمِ",107,"م",1,0],["فالذي خَطَّ شَطْرَ بيْتٍ مَليئاً","بالسَّخافاتِ والعُيوبِ الجِسامِ...!",108,"م",1,0],["فالذنب عوقني والإثم طوّقني","كم صرت أخجل من آيات مولانا",109,"ن",2,0],["فالذُّلُّ مِنْ شَتّى الجِهاتِ يُؤمُّنا","وَ يُراقُ فوقَ صَديدهِ البُسَطاءُ",110,"ا",2,0],["فالذاكرة ياما وياما من الناس","ظلّت ملامحهم رهينة وراحوا",111,"ح",3,1],["فالّذي خَابَ حُبّهُ ما عسَاهُ","يرْتجي مِنْ نارهِ غيرَ الرَّمَادِ ؟",112,"د",1,0],["فالذلُّ عند الناسِ خِزيٌ كلّه","لا يرتضون تسلُّطًا وتمنُّعا",113,"ع",2,0],["فالذي ابيض من أقاح ثنايا","ها وما احمر من شقيق الورود",114,"د",1,0],["فَالذَّنبُ أَنَّي ضِياءٌ باتَ شَمعُهُمُ","إِزاءَ إِشراقِهِ كَالأَمسِ في الأَبَدِ",115,"د",1,0],["فالذكرياتُ العاطرات تهزُّه","تسقيه من عذب الهوى وعذابه",116,"ب",2,0]]}