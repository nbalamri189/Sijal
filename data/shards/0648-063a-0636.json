{"poems":[[74,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[31,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[58,"وغضفا ينتظمن الأرض نظما","https://www.aldiwan.net/poem58565.html","المتقارب"],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[64,"يا أيها الباحث عن سرنا","https://www.aldiwan.net/poem52141.html","السريع"],[64,"ومفرد بالحسن أفردته","https://www.aldiwan.net/poem52330.html","السريع"],[68,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[82,"أقول لبرق شمته في غمامه","https://www.aldiwan.net/poem31298.html","الطويل"],[82,"وسامية الألحاظ للصيد قربت","https://www.aldiwan.net/poem31469.html","الطويل"],[33,"وغضيض الطرف مكسال الضحى","https://www.aldiwan.net/poem41298.html","الرمل"],[76,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[107,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[107,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[54,"يا أيها المتتايه المتغاضب","https://www.aldiwan.net/poem27272.html","الكامل"],[50,"خذ العيش الهني من المجوس","https://www.aldiwan.net/poem66598.html","الوافر"],[52,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[48,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42627","السريع"],[92,"الجيل الجَديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=179209",""],[92,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[33,"وَغَضِيضِ الطَّرْفِ مِكْسَالِ الضُّحَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19104&r=&rc=366",""],[119,"منذ الذي يغريك يا ريم الغضا","https://www.aldiwan.net/poem40917.html","عموديه"],[119,"هات ذكر الغزالة الخود هات","https://www.aldiwan.net/poem41681.html","الخفيف"],[190,"رويدا أيا إسحاق واسمع فإنني","https://www.aldiwan.net/poem44118.html","الطويل"],[208,"من حديثي أن ابن بكر دعاني","https://www.aldiwan.net/poem52998.html","الخفيف"],[226,"أيسلو فؤادي أو أكتم","https://www.aldiwan.net/poem55305.html","المتقارب"],[234,"سقى السفح من دير القصير إلى النهر","https://www.aldiwan.net/poem51045.html","الطويل"],[240,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[353,"سلام كأنفاس الصبا مست الربى","https://www.aldiwan.net/poem20257.html","الطويل"],[358,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[358,"لولا البشائر في لقا الأحباب","https://www.aldiwan.net/poem40779.html","الكامل"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[371,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[415,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[438,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[463,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[469,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[484,"سمعا لصوتك سمعا أيها الشادي","https://www.aldiwan.net/poem36952.html","البسيط"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[511,"صن العقل عن لحظة في هوى","https://www.aldiwan.net/poem2438.html","المتقارب"],[543,"لفي ضناك ضنى العلياء والحسب","https://www.aldiwan.net/poem48273.html","عموديه"],[556,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87033","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87022","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86812","الطويل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132444","الكامل"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107109","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136101","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112956","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112796","الوافر"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79545","الخفيف"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111847","الخفيف"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206241",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49584","المتقارب"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110338","الكامل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124785","الوافر"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124782","الطويل"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130766","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65942","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62777","الطويل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89990","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114311","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114124","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29312","الخفيف"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113702","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70154","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101359","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119705","الكامل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67640","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83199","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57973","البسيط"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4830,"رسول الرحمة محمدﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=193598",""],[4830,"سجيّةُ الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=194089",""],[4830,"أياشيخ","https://www.poetsgate.com/ViewPoem.aspx?id=195032",""],[4906,"على وادي النقا قِفْ لي صباحا","https://www.poetsgate.com/ViewPoem.aspx?id=173612",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[585,"أنا في الطائف أستوحي الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=161867",""],[5183,"بين العزاء والبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=180220",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5457,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213104",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[6056,"عديم المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130516",""],[6097,"يَقْظَة","https://www.poetsgate.com/ViewPoem.aspx?id=197426",""]],"verses":[["وغضضت جفني عن مغازلة الظبا","ولقد أجرّ لبرْدِه أهدابا",0,"ب",2,0],["وَغُضّوا بَني عَبسٍ لَها مِن عُيونِكُم","وَلَمّا تُصِبكُم نَفحَةٌ مِن هِجائِيا",1,"ي",2,0],["وَغَضِبتَ كَالمَنصورِ أَو","هارونَ في خالي العُصور",2,"ر",1,0],["وغُضْفاً يَنْتَظِمْنَ الأرضَ نَظْماً","تنثّرُ فيهِ حَبَّاتُ النُّفوسِ",3,"س",1,1],["وَغَضبى مِنَ الإِدلالِ سَكرى مِنَ الصِبا","شَفَعتُ إِلَيها مِن شَبابي بِرَيِّقِ",4,"ق",1,0],["وغَضَّ من ماء الحديد الذي","اشتد ولم يذعن لأن يكسرا",5,"ر",2,0],["وغضَّ من نخوتِه علمُهُ","بأنني وحديَ مُشتاقُه",6,"ق",2,0],["وَغَضَّ جَفنُ الدَهرِ أَيَّ مَخضِ","فَبِتُّ مِن صُروفِهِ أَستَقضي",7,"ض",2,0],["وغضْنٌ ذبولي في الهوى باخضرَارِهِ","وبدرٌ محاقي بالضّنا من تَمامهِ",8,"م",2,0],["وَغُضْفٌ تَرى آذانَهُنَّ لواحِظاً","بِهنَّ صُرورٌ وهيَ من هبوةٍ غُبْرُ",9,"ر",1,0],["وَغَضيضِ الطَرفِ مِكسالِ الضُحى","أَحوَرِ المُقلَةِ كَالريمِ الأَغَن",10,"ن",1,1],["وَغَضَّ مِن أَصواتِها صَوتُهُ","إِنَّ زَئيرَ اللَيثِ غَيرُ النُباح",11,"ح",1,0],["وغَضِبتَ للفلّاحِ غَضْبَةَ مُكرِمٍ","لِلنّيلِ يَأنَفُ أن يَراهُ مُهانا",12,"ن",2,0],["وغِضبتِ للأخلاقِ غَضْبَةَ حُرَّةٍ","تَأْبَى الحياةَ مَشوبةً بفَسادِ",13,"د",1,0],["وَغَضِبتَ لَمّا قُلتُ هَجرُكَ قاتِلي","إِن عادَ وَصلُكَ لي فَإِنّي كاذِبُ",14,"ب",1,0],["وغُضفاً ينسفنَّ الأرض نسفاً","تنافرُ فيه حبّاتُ النفوس",15,"س",1,0],["وَغَضّات الشَبابِ مِنَ العَذارى","عَلَيهنَّ السُموطُ لَها إِباءُ",16,"ا",2,0],["وَغَضِبنا مِن قَولِ زاعِمِ حَقٍّ","إِنَّنا في أُصولِنا لُؤَماءُ",17,"م",3,0],["وَغُضَّ مِنْ طَرْفِكَ إِنْ خِفْتَهُ","فَحَاجِبُ الشَّهْوَةِ غَضُّ الْبَصَرْ",18,"ر",1,0],["وغضِبت أن تجدَ الرعايا مَغْنَماً","بيدِ الرُّعاة كأنهم أنعام",19,"م",1,0],["وغضبةُ المرء في حيثُ الرضا حَسَنٌ","قبيحةٌ كالرضا في موقع الغضب",20,"ب",1,0],["وَغَضِيضِ الطَّرْفِ مِكْسَالِ الضُّحَى","أحورش المقلة ِ، كالريمِ الأغنّ",21,"ن",1,1],["وغضبت بل اغضبت كل مرؤة","عرفت خصالي فانتهج نهج الرضا",22,"ض",2,0],["وغضا المكتم وانقطاع رجاء","ودموع الهوى مع المرسلات",23,"ت",1,0],["وغضّ الشحا أو جال في المقلة القذى","وزاد الأذى والعتب ثمّ ولا عتب",24,"ب",1,0],["وَغضَار الألوان جاءت ولكن","ليس فيها روائح الألوانِ",25,"ن",1,0],["وغضي جفونك كي تسلمي","من الموبقات وكي يسلموا",26,"م",3,0],["وغضبيّ من الإدلال والتيه في الهوى","بلا غَضَب سَكْرَي الجفونِ بلا سُكر",27,"ر",1,0],["وَغَضِبتَ لِلدينِ الحَنيفِ وَلَم تَزَل","في اللَهِ تَرضى مُنذُ كُنتَ وَتغضَبُ",28,"ب",1,0],["وَغَضَّ لها كالنَّرْجِسِ الفضيّ نَاظِرٌ","يُكَفْكِفُ في أَجفانهِ أَدْمُعَ القَطْرِ",29,"ر",1,0],["وَغَضنَفر يَطس الجَماجم مسعرا","حرَّ الوَطيس وَيَنثَني مُتبخترا",30,"ر",2,0],["وَغَضَنفر بِاللَه لا بِمهنّد","لَيسَ الغَضَنفر كُلّ ذي مِخلابِ",31,"ب",1,0],["وغُضْفٌ تُسابِقُ عَصْفَ الرِّياح","فَيسبِقُه حُضْرُها إنْ نَسَم",32,"م",1,0],["وَغَضُّكَ أَيَّ عَينٍ لَم تُجِلها","فَتَعرِفَ في العِدا عَينَ الظُهورِ",33,"ر",1,0],["وغضبت لله الذي أعطاك فص","ل الحكم غضبة ثائر حران",34,"ن",1,0],["وغَضَنْفَرَانِ وإِنَّما عاباهما","بيض مهندة وسمر ذبلُ",35,"ل",1,0],["وغضبَى بأن تُلوَى لديكم وتُقتَضَى","حقوقٌ لها ممطولةٌ وديونُ",36,"ن",1,0],["وغضبان من جنّ المِراح كأنه","عصا النبع لولا رادفٌ وحزيمُ",37,"م",1,0],["وغضبتَ إي أني بحب","بك مذنبٌ فامنن بعفو",38,"و",1,0],["وغض طرفك عن تلك الجروح فما","أسنى تغاضيك من آس وضماد",39,"د",1,0],["وغض من نجدته وغيضا","وقلت لا أفلت مني معرضا",40,"ض",2,0],["وغضنَّ الجفون على عِفةٍ","فإنَّ زناءَ العُيونِ النِّظر",41,"ر",1,0],["وغَضبةُ اللهِ عمَّن بات يشنَاُ مَن","يَصبُو لجامدِ بلَّورٍ ومُنسَكِبِ",42,"ب",1,0],["وَغضّوا اللّحْظَ عن شَغَفٍ إليهِ","فما لكُمُ العَشيَّة مِنْ طَماحِ",43,"ح",1,0],["وَغضبتَ مِن بَعد الرضا","وَهجرتني الهَجر الجلي",44,"ل",2,0],["وَغضبت بَعد رضاك عَني مُدة","وَنسيت تَربيتي وَحسن تَأمّلي",45,"ل",2,0],["وَغضّ عَن الشَمس ازدراء بنورها","وَأَطلَع بَدراً قَد أَنار مهادها",46,"د",3,0],["وغضارة الأيام تأبي أن يُرى","فيها لأبناء الذكاءِ نصيبُ",47,"ب",1,0],["وغضّ عن الدنيا وزخرف أهلها","جفونك واكحلها بطول سهاد",48,"د",1,0],["وَغضنفر في الغابِ يحمي شبله","طوراً وينشب في القنيصة مخلبا",49,"ب",2,0],["وغض طرفك عن تخييل زينة ه","ذي الدار دار الفنا واللهو واللعب",50,"ب",1,0],["وغض مدى الايام طرفك خاشعا","وخل سيول الدمع منه المدى تجرى",51,"ر",2,0],["وغض الطرف واذكر بعض ما بي","هناك وقل لساداتي أدركوني",52,"ن",2,0],["وغضَضْنَ اللحاظَ منِّيَ إلاّ","عن هلال يرنو بمقلةِ ريمِ",53,"م",1,0],["وغضت الطرف نحو الارض فارتقب","عند العقيق النظم الدر عقيانا",54,"ن",2,0],["وغضون تحكي القدود طوالٌ","يذهل الفكرَ والنهى مرآها",55,"ا",3,0],["وغضّت عيون الّلي مِنْ النوم مصطابه","عسى كلّ عينٍ همّها الأمر تغضي به",56,"ب",2,0],["وغضبانَ إن سُؤتُهُ حالني","إليك وإن العلا لم تحل",57,"ل",1,0],["وغضرفوط ماله قبلةٌ","وهدهدُ يكفره بكر",58,"ر",1,0],["وَغُضونٍ تَزدادُ يَوماً فَيَوماً","وَعُيونٍ حَوراءَ أَمسَت كَليلَه",59,"ل",2,0],["وغضنفر في أرضِ كو","لمبٍ يعزُّ به عرين",60,"ن",1,0],["