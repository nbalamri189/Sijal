{"poems":[[48,"شكوت من أهل هذا العصر غدرهم","https://www.aldiwan.net/poem22983.html","البسيط"],[203,"سحر عينيك سال في تشبيبي","https://www.aldiwan.net/poem45600.html","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122324","الكامل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124684","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127962","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110308","الكامل"],[501,"غنيت مكة","https://www.poetsgate.com/ViewPoem.aspx?id=205279",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[4849,"جتني إضافه","https://www.poetsgate.com/ViewPoem.aspx?id=53511",""],[5542,"حرقة عالى حال الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=10062",""],[5784,"سفر المجاز","https://www.poetsgate.com/ViewPoem.aspx?id=215226",""],[6102,"قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=184624",""],[5561,"قل لي من تكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86133&r=&rc=1",""]],"verses":[["إِنّا اِئتَلَفنا لِأَنَّ اللَهَ رَكَّبَنا","مِن أَربَعٍ ثُمَّ صِرنا بَعدُ نَختَلِفُ",0,"ف",1,0],["أنا أيوبُ في هواكِ فأينَ الصب","رُ يسرو الهمومَ عن أيوبِ",1,"ب",1,0],["انا أيها الاستاذ قلبي واثق","بك وهو في أيدي الظبا موثوق",2,"ق",1,0],["أنا أيّ شعّة نجمة","أنا أيّ لونٍ مثل لوني",3,"ن",2,0],["أنا أيها العزيز ذليل","مخلص في صداقتى وودادى",4,"د",2,0],["أنا آيةٌ منقوشةٌ في صخره","وشرارةٌ مطبوعةٌ بغراره",5,"ر",2,0],["أنا أينما صلى الأنام رأت","عيني السماء تفتحت جودا",6,"د",2,0],["أنا آيسٌ ضاقت علىَّ برحبها الد","دُنيا فها أنا هائمٌ أتعسَّفُ",7,"ف",1,0],["أنا إيمان من دولة شقيقة","وقلت أهلين وأبديت الضيافه",8,"ف",2,0],["أنا أيها الأحباب مسلمة لها","قلب إلى شرع الهدى تواقُ",9,"ق",1,0],["أنا أيها الموبوء من لبس العلا","لما شجاك الحسنُ في أثوابهِ",10,"ب",2,0],["أَنا - أَيُّها المَحتُومُ - فِي شَرِّ وِقفَةٍ","فَلَيتِيَ مَحمُولٌ ! وَ لَيتَكَ حامِلُ !",11,"ل",1,0],["أنا أيّها الإنسانُ مثلُكَ سائحٌ بين السجونْ","في الأرض تسجنني الأماني كلّ يومٍ كلّ حينْ",12,"ن",1,0]]}