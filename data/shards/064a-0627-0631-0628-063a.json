{"poems":[[0,"حي الحمول بجانب العزل","https://www.aldiwan.net/poem82.html","الكامل"],[29,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[53,"تأمل العيب عيب","https://www.aldiwan.net/poem8150.html","المجتث"],[99,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[50,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[78,"يا ويلتا من موقف ما به","https://www.aldiwan.net/poem38997.html","الوافر"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1944","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9447","السريع"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[189,"حكم العيون على القلوب يجوز","https://www.aldiwan.net/poem14549.html","الكامل"],[197,"يا رب غصن نوره","https://www.aldiwan.net/poem13088.html","مجزوء الرجز"],[264,"يا رب غصن وجودي أنت غارسه","https://www.aldiwan.net/poem35804.html","البسيط"],[366,"يا ابن الرسول بامك الزهرا البتول","https://www.aldiwan.net/poem68097.html","الكامل"],[434,"يا رب غيثٍ قد قرى عازبٍ","https://www.aldiwan.net/poem770.html",""],[443,"يا رب غفرانك لا تخله","https://www.aldiwan.net/poem2519.html","السريع"],[543,"يا رب غربة بتها","https://www.aldiwan.net/poem48315.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59075","الدوبيت"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138122",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64860","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27685","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47180","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99369","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138693",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85045","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58008","البسيط"]],"verses":[["يا رُبَّ غانِيَةٍ لَهَوتُ بِه","وَمَشَيتُ مُتَّئِداً عَلى رُسلي",0,"ل",2,0],["يا رُبُّ غابِطِنا لَو كانَ يَطلُبُكُم","لاقى مُباعَدَةً مِنكُم وَحِرمانا",1,"ن",2,0],["يا رُبَّ غُمّةِ خَطْبٍ","فيها من الصُّنع جَيبُ",2,"ب",1,0],["يا ربِّ غفرانك إنا صغار","ندبّ في الدنيا دبيب الغرور",3,"ر",1,0],["يا رُبَّ غَيثٍ آمِنِ السُروبِ","حُبارِياتِ جَلهَتَي مَلحوبِ",4,"ب",1,1],["يا ربِّ غُفرانَك عن مُذنبٍ","أسرفَ إلا أَنَّهُ نادِمُ",5,"م",1,0],["يا رُبَّ غانِيَةٍ لَهَوتُ بِها","وَمَشَيتُ مُتَّئِداً عَلى رُسلي",6,"ل",2,0],["يا رَبَّ غَيِّر كُلَّ شَيءٍ سِوى","رَأيِ أَبي العَباسِ فَاِترُكهُ لي",7,"ل",2,1],["يا رُبّ غدرٍ وفيٍّ قد رأيت لهُ","أخنى على ملك واغتال جبارا",8,"ر",2,0],["يا رُبَّ غِيلٍ بعد صيحة أُسْده","قد بات يملؤه الغراب نعيبا",9,"ب",2,0],["يا رُبَّ غانيةٍ أَضرَّ بقلبها","أنِّى بلفظِة مُعْدِمٍ مَنْبوز",10,"ز",1,0],["يا رُبّ غُصنٍ نُورُه","يُزري بِنورِ الشَفقِ",11,"ق",1,1],["يا ربّ غصنُ وجودي أنت غارسُهُ","فماد في روضة التوحيد مائسُهُ",12,"س",2,1],["يا رَبّ غوثا بِالَّذي عَوّذته","من غاسِق يَسطو وَمن خناس",13,"س",1,0],["يا رُبَّ غَيثٍ قَد قَرى عازِبٍ","أَجَشَّ أَحوى في جُمادى مَطير",14,"ر",1,1],["يا رب غفرانك لا تخله","يزيد كي تدخله الجنّه",15,"ن",2,1],["يَا رَبَّ غٌُربةٍ بِتُّها","وعرَفتُ فيها لَيلةَ الغُربَاءِ",16,"ا",2,1],["يَا رب غَزَالَةٍ كَشَمْسِ وضحتْ","للَّيْلِ مَحَتْ",17,"ت",1,1],["يا رب غصنين تجرى الريحُ بينهما","حينا ليحلوَ بعد النأى لقيان",18,"ن",1,0],["يا رَبِّ غُفْراً عن ذُنوبي فلي","نَفْسٌ على أَهوائِها نازِعَهْ",19,"ع",2,0],["يا رب غفرانك في مداه","بحق لا إله إلا اللّه",20,"ه",1,0],["يا ربّ غفراً وعفواً إنني رجلٌ","من يطلب الأمر مني لست أعلمه",21,"م",2,0],["يا رُبَّ غَاوٍ قد هدى ولَكَمْ فَتىً","عَانى الهوى فافتكَّه من سِجنه",22,"ن",2,0],["يا رب غفرا قد طغت أقلامنا","يا رب معذرة من الطغيان",23,"ن",1,0],["يا رب غانية بيضاء تصحبني","من العتاب كؤوساً ليس تنساغُ",24,"غ",1,1],["يا رب غاية سؤلي أن ابلغ ما","ترضى ويصبح سعيي فيك مشكورا",25,"ر",2,0],["يا رَبِّ غانِيَةٍ خَرودٍ كاعِبِ","كَالبَدرِ وَجهاً ذاتَ ثَغرِ أَلعَسِ",26,"س",1,0],["يا ربِّ غَوْثَكَ إنِّي هالِكٌ أَبَداً","إنْ لم تكُنْ ناصِرِي منهم ومُعْتَمَدِي",27,"د",2,0]]}