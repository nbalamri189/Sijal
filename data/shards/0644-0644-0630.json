oetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27845","المديد"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27396","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27204","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109415","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77306","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104983","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87765","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205857","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204786",""],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3265,"","https://poetry.dctabudhabi.ae/diwan/poem/89515","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66581","البسيط"],[3910,"","https://poetry.dctabudhabi.ae/diwan/poem/131371","البسيط"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33655","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139623",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139481",""],[4767,"البر والتقوى","https://www.poetsgate.com/ViewPoem.aspx?id=213423",""],[5101,"ثمار عين مالحة","https://www.poetsgate.com/ViewPoem.aspx?id=197579",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5386,"ريش الذباب","https://www.poetsgate.com/ViewPoem.aspx?id=34996",""],[5413,"كان وكان","https://www.poetsgate.com/ViewPoem.aspx?id=200538",""],[5453,"مراتيع الخنا","https://www.poetsgate.com/ViewPoem.aspx?id=28014",""],[5628,"الوثنيون المتوحشون","https://www.poetsgate.com/ViewPoem.aspx?id=178537",""],[5720,"جمعيةُ التحفيظِ","https://www.poetsgate.com/ViewPoem.aspx?id=199528",""],[5776,"ورطة","https://www.poetsgate.com/ViewPoem.aspx?id=199417",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[2220,"بالشمِّ أدركَ أحياناً وبالنظرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11426&r=&rc=300",""]],"verses":[["لِلذُلِّ بَينَ الأَقرَبينَ مَضاضَةٌ","وَالذُلُّ ما بَينَ الأَباعِدِ أَروَحُ",0,"ح",1,0],["للذّي يفني النصاره","وصل اللّه انتصاره",1,"ه",1,0],["للذُّرَى فالذُّرَى من الحَسَبِ الثَّا","قِبِ بَينَ القَمقَامِ فالقَمقَامِ",2,"م",1,0],["للذَّبْح من غَذَوا مِنَّا ومن حَضنا","لا بلْ ومن تركاهُ غيرَ مَحضون",3,"ن",1,0],["للذي يبتغي الولوج جريئا","ليس باب السماء بالمسدود",4,"د",1,0],["لِلذِّكْرِ آفَاقٌ سَحِيقَاتُ المَدَى","وَلِزُهْرهَا المُتَأَلِّقَاتِ مَجَالِي",5,"ل",2,0],["لِلذّاتِ فَرَغتُ وَإِنَّما","جُهدُ المُهَنّا أَن يَعود مُنَغَّصا",6,"ص",2,0],["لِلَّذي نالَ سادَتي","مِن رَزاياً مُشَمِّره",7,"ر",2,0],["لِلّذي جاءتِ مِنْ غَدْرٍ شنيع","أَوْهَى قُوى الإسلامِ",8,"م",1,0],["لِلَّذِي نِلْتُ عندَهُ سِمَنَ الكِي","سِ وقد كانَ غَايةً في الهُزالِ",9,"ل",1,0],["للذي قد خلا من الأربَعِ الأش","هُرِ وُقّيتَ سطوةَ الأيامِ",10,"م",1,0],["للذى ظلَّ في كفاحٍ يُعليِ","يها وما زال في أمرِّ الكفاحِ",11,"ح",1,0],["للذى لا يرى رعاياه في البؤ","سِ فماتوا به مِراراً وعانوا",12,"ن",3,0],["لِلَّذي يَفرِطُ مِنهُ","مِن بِصاقٍ وَمُخاطِ",13,"ط",1,0],["للَّذي حَلَّ بِنا اليَو","مَ مِنَ الأَمرِ الفَظيعِ",14,"ع",1,0],["لِلَذَاذَةٍ ولِمُتعَة شوَّالُ مَع","ذي قِعدة لا شَهر صَومٍ مُوجِع",15,"ع",1,0],["للذي قد فَطَر الأر","ضَ بأنواعِ الفعال",16,"ل",1,0],["للذي أنواره سطعت","فأحالت صبغة الغسق",17,"ق",1,0],["للذنب سر عجيبُ","وفيه خبثٌ وطيبُ",18,"ب",1,1],["للذات ذات وللأسماء أسماءُ","تدري حقيقته سعدى وأسماءُ",19,"ا",2,1],["للذكر والتاريخ هذا المال لا","لتجارةٍ وهوىً ولا لنفاد",20,"د",1,0],["للذي قال للمريدِ اقتصاصاً","اقتصصْ ما تريدُ منِّي عُكَاشا",21,"ش",2,0],["للذي يغنم من أق","داحها فوز القداحِ",22,"ح",1,0],["للذكريات بداجي الليل عِطرا","أريجها كالورد ما بين الاكمام",23,"م",1,0],["للذي نشدو ونتغَنّى","به وتترنّم قوافينا",24,"ن",2,0],["للذهب اجعل من غرا أو من عسل","كوزن درهم وفي الصيني يحل",25,"ل",1,0],["للذين اتقوا أُعِدَّت قصورٌ","عالياتٌ في خالداتِ الجِنانِ",26,"ن",1,0],["للذي أرجوه من منح","جلها أني لها جار",27,"ر",1,0],["للذوقِ أخذ شريف لا يكفيه","في فعله غير أهل الضربِ والبصر",28,"ر",1,0],["للذاتِ كان مصيرهم فحباهمُ","بشهوده عيناً بلا أكوان",29,"ن",1,0],["للذي حسن الوفا من طبعه","وله المعروف اضحى ديدنا",30,"ن",2,0],["لِلَّذي بِالبَيانِ حَلّى لِساني","وَهَداني مَعارِجَ التَفكيرِ",31,"ر",1,0],["للذبِّ أوردهم كسرى ممالكه","فعاد حيران لا ورد ولا صدر",32,"ر",1,0],["لِلذي قَد أَثَّلت أَيديكُم","مِن أَساس لَعلاها وَكيان",33,"ن",1,0],["للذي رنّ صوته في حنايا","مصر وانهلّ بالنمير الزلال",34,"ل",1,0],["للذوق أكل لا يرى","يعجب منه البُلَها",35,"ل",3,0],["للَذعِ المشارط في ذي معون","وقطع العروق لحدّ الشباب",36,"ب",1,0],["للذع ألف مَنه","ولا احتما مِنه",37,"ه",1,0],["لِلَذَّةِ العَيْشِ وَالأَفْراحِ أَوْقاتُ","فَانْشُرْ لِواءً لَهُ بِالنَّصْرِ عاداتُ",38,"ت",1,1],["للذه درك في علم وفي عمل","وفي مقال وفي فعل وفي كرم",39,"م",1,0],["للذي في الأساس ما كان كونا","للذي لا يكون في الكون أصلا",40,"ل",2,0],["للذي قد كانت الفتوى به","هي والتقوى معا مقترنان",41,"ن",1,0],["للذي ذَلَّ من الشوقِ فَلن","وإذا عزَّ الذي تَهوى فهُن",42,"ن",1,1],["للذي قمتَ به من خدمةٍ","ببناء فيه للدين استناد",43,"د",1,0],["للذَّة أبدلها في خدمةٍ","أبدل أيَّ راحةٍ عناؤها",44,"ا",3,0],["للذاكرين اللهَ منزلةٌ","يومَ الجزا في جنةِ المأوى",45,"و",2,0],["للذكريات روائح لا تنتهي","ولها نصالٌ للجوارح جارحة",46,"ح",2,0],["للذكريات تحدّبُ المعنى على","أشباهه كل المعاني واضحة",46,"ح",2,0],["للذّلِّ والإخفاقِ سَارَ كأنّهُ","بالعَدْوِ أسرَعَ مِن خُطى سَعدانِ",47,"ن",1,0],["للذباب الدِّين.. (ناوين الخراب","المجون ... وجوههم.. أصحابها",48,"ب",3,0],["للذكرياتِ الطيباتِ مكانةٌ","في كل قلبٍ يعشق الإحسانا",49,"ن",2,0],["للذي مثلك على ذله يذلا ّ","في مراتيع الخنا فلة حجاجي",50,"ج",2,0],["للذود عن مُدن العراقِ بِهمّة ٍ","عربيّة لا ترتضي التسليما",51,"م",2,0],["للذكرِ والقولِ المبينِ مرتلٌ","ومجودٌ لكتابِ ربي . . ذاكرُ",52,"ر",1,0],["للذات أروقة إذا أبصرتها","أبصرت ما لم أستطع زمنا",53,"ن",2,0],["لِلَّذي عَنهُ بِالحَقيقَة يشرف","هاديا للرشاد وَهوَ له كف",54,"ف",1,0],["للذوقِ أخذ شريف لا يكيفه","في فعلهِ غيرُ أهلِ الضربِ والبصرِ",55,"ر",1,0]]}