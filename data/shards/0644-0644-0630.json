{"poems":[[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[83,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[393,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[402,"غير مستنكر من الأيام","https://www.aldiwan.net/poem46973.html","الخفيف"],[432,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[432,"يا إماما أحسن به من إمام","https://www.aldiwan.net/poem12528.html","الخفيف"],[453,"خطرت آسيا بعيد أبيها","https://www.aldiwan.net/poem61621.html","الخفيف"],[453,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[468,"ومغن ضربه أو","https://www.aldiwan.net/poem59913.html","مجزوء الرمل"],[470,"قد لعمري بت ليلي","https://www.aldiwan.net/poem4761.html","مجزوء الرمل"],[538,"من ذا الذي لا يستجيب إذا دعي","https://www.aldiwan.net/poem47564.html","عموديه"],[558,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[558,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[558,"للذنب سر عجيب","https://www.aldiwan.net/poem34971.html","المجتث"],[558,"للذات ذات وللأسماء أسماء","https://www.aldiwan.net/poem34974.html","البسيط"]],"verses":[["لِلذُلِّ بَينَ الأَقرَبينَ مَضاضَةٌ","وَالذُلُّ ما بَينَ الأَباعِدِ أَروَحُ",0,"ح",1,0],["للذّي يفني النصاره","وصل اللّه انتصاره",1,"ه",1,0],["للذُّرَى فالذُّرَى من الحَسَبِ الثَّا","قِبِ بَينَ القَمقَامِ فالقَمقَامِ",2,"م",1,0],["للذَّبْح من غَذَوا مِنَّا ومن حَضنا","لا بلْ ومن تركاهُ غيرَ مَحضون",3,"ن",1,0],["للذي يبتغي الولوج جريئا","ليس باب السماء بالمسدود",4,"د",1,0],["لِلذِّكْرِ آفَاقٌ سَحِيقَاتُ المَدَى","وَلِزُهْرهَا المُتَأَلِّقَاتِ مَجَالِي",5,"ل",2,0],["لِلذّاتِ فَرَغتُ وَإِنَّما","جُهدُ المُهَنّا أَن يَعود مُنَغَّصا",6,"ص",2,0],["لِلَّذي نالَ سادَتي","مِن رَزاياً مُشَمِّره",7,"ر",2,0],["لِلّذي جاءتِ مِنْ غَدْرٍ شنيع","أَوْهَى قُوى الإسلامِ",8,"م",1,0],["لِلَّذِي نِلْتُ عندَهُ سِمَنَ الكِي","سِ وقد كانَ غَايةً في الهُزالِ",9,"ل",1,0],["للذي قد خلا من الأربَعِ الأش","هُرِ وُقّيتَ سطوةَ الأيامِ",10,"م",1,0],["للذى ظلَّ في كفاحٍ يُعليِ","يها وما زال في أمرِّ الكفاحِ",11,"ح",1,0],["للذى لا يرى رعاياه في البؤ","سِ فماتوا به مِراراً وعانوا",12,"ن",3,0],["لِلَّذي يَفرِطُ مِنهُ","مِن بِصاقٍ وَمُخاطِ",13,"ط",1,0],["للَّذي حَلَّ بِنا اليَو","مَ مِنَ الأَمرِ الفَظيعِ",14,"ع",1,0],["لِلَذَاذَةٍ ولِمُتعَة شوَّالُ مَع","ذي قِعدة لا شَهر صَومٍ مُوجِع",15,"ع",1,0],["للذي قد فَطَر الأر","ضَ بأنواعِ الفعال",16,"ل",1,0],["للذي أنواره سطعت","فأحالت صبغة الغسق",17,"ق",1,0],["للذنب سر عجيبُ","وفيه خبثٌ وطيبُ",18,"ب",1,1],["للذات ذات وللأسماء أسماءُ","تدري حقيقته سعدى وأسماءُ",19,"ا",2,1]]}