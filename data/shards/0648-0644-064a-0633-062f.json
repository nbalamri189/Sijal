{"poems":[[74,"مزجت بتذكار العقيق بكائي","https://www.aldiwan.net/poem18199.html","الطويل"],[53,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[47,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[51,"نموت جميعا كلنا غير ما شك","https://www.aldiwan.net/poem62199.html","الطويل"],[164,"دعوت بأن لا يجمع الله بينكم","https://www.aldiwan.net/poem59199.html","الطويل"],[369,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[580,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122710","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44813","الوافر"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101895","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93559","الوافر"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122499","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204782","الطويل"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31667","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68012","البسيط"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145129","الرمل"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36050","الطويل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105524","الرمل"],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""]],"verses":[["وليس دوائي غير تربة أحمدٍ","بطيبةَ عال فوقَ كلِّ سماء",0,"ا",2,0],["وليس دهري إلا أن يتاركني","بحيث لا جفوة منه ولا لَطَف",1,"ف",1,0],["وَلَيسَ دَمُ اللَعينِ وَإِن شَفانا","كَفِيّاً عِندَنا لِدَمِ الشَهيدِ",2,"د",1,0],["وَلَيسَ دَبيبُ الذَرِّ فَوقَ الصَفاةِ في ال","ظَلامِ بِأَخفى مِن رِياءٍ وَلا شِركِ",3,"ك",1,0],["وليس دعاء الكافرين لربهم","وإن طال إلا في ضلال كما يقرا",4,"ر",2,0],["وليس دَمٌ يَجرِي من العينِ بعدكم","بشيءٍ سوى قلبٍ من الشّوقِ ذائب",5,"ب",1,0],["ولَيْسَ دماً دمع الجفونِ وَإِنَّما","فُؤادِي بماءِ الدَّمعِ قَدْ ذَاب جَمْرُه",6,"ر",2,0],["وَلَيسَ دِماءُ النّاسِ كُفؤَ دِمائِكُم","وَهل يَستوي في الطّاعَةِ الفَرضُ والنَّفل",7,"ل",1,0],["وَلَيسَ دَم الحُسَينِ أَرَقتَ لَكِن","مَزَجتَ دَم الرَّسُولِ مَعَ التُّرابِ",8,"ب",1,0],["وليس دون العدد المذكور","من موجب للنشر في المشهور",9,"ر",1,0],["وَلَيسَ دَواء أَنف ذي عطاس","سِوى أَسعاطه بِدَم الشجاج",10,"ج",1,0],["وليسَ دوائِي أن أقُولَ لَكض اعطِني","دُخَاناً ولا شمّاً أخاهُ وَلاَ دنَّا",11,"ن",2,0],["وليس دليل للطلاق على خطا","به ندم حيث الندامة لا تجدي",12,"د",2,0],["ولَيْسَ دُنْياهُ ولا دينُهُ","إِلا مَهاً مِثْلَ الدُّمى حُورُ",13,"ر",1,0],["وَلَيْسَ دمعيَ حقاً حين أَنثُره","لكنها النفسُ من عينيَّ تُعْتَصَر",14,"ر",1,0],["وليسد دين التآخي وليزل","ظل الاستعمار من هذا الوجود",15,"د",1,0],["وَلَيسَ دَوامُ الشُكرِ يَوماً بِواجِدٍ","لِمَن لَم يَدُم مِنهُ الوَفاءُ عَلى العَهدِ",16,"د",1,0],["وليس دهراً يحث النجبا","تترامى بطريق يبس",17,"س",1,0],["وليس دليلاً أنهم في قبورهم","يصلون لا الله ما ذاك في الأثر",18,"ر",1,0]]}