{"poems":[[53,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[30,"أمن دمنة بين القلات وشارع","https://www.aldiwan.net/poem29572.html","الطويل"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[38,"يا عجبا للدهر شتى طرائقه","https://www.aldiwan.net/poem7734.html","الطويل"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[43,"أتاني كلام الجاهل ابن كيغلغ","https://www.aldiwan.net/poem10133.html","الطويل"],[62,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[62,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[40,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[48,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55087","الهزج"],[153,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[158,"شهدت لقد أعليت كعب المكارم","https://www.aldiwan.net/poem58777.html","الطويل"],[164,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[235,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[303,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[326,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[326,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[362,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[429,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[429,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[429,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[456,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[462,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[513,"أقول والصدق فيما قلت يعضدني","https://www.aldiwan.net/poem12281.html","البسيط"],[534,"أجدك ما لعينك لا تنام","https://www.aldiwan.net/poem23869.html","الوافر"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"]],"verses":[["وَأَسحَبَكُم صافِناتِ العَلاءِ","جَرَّ الشَموسِ طِراقَ الجِلالِ",0,"ل",1,0],["وَأَسحَبُ فيها بُردَ جَذلانَ شامِتٍ","إِذا شاءَ غَنَّتهُ الرَقاقُ البَوارِدُ",1,"د",1,0],["وَأَسحَمُ رَيّانُ العَسيبِ كَأَنَّهُ","عَثاكيلُ قِنوٍ مِن سَميحَةَ مُرطِبِ",2,"ب",1,0],["وَأَسحَمَ كَالأَساوِدِ مُسبَكِراً","عَلى المَتنَينِ مُنسَدِلاً جُفالا",3,"ل",2,0],["وَأَسحَمَ مَيّالٍ كَأَنَّ قُرونَهُ","أَساوِدُ واراهُنَّ ضالٌ وَخِروَعُ",4,"ع",1,0],["وأسحب والأولاد فضل ملابسٍ","نصافي بها الأيام حين نصافي",5,"ي",1,0],["وَأَسحَمَ حَنّانٍ مِنَ المُزنِ ساقَهُ","طُروقاً إِلى جَنبَي زُبالَةَ سائِقُه",6,"ق",2,0],["واسحقي الكَائِناتِ كوْناً بكَوْنٍ","قبل أنْ تنتهي أذلّ تَنَاهِ",7,"ه",1,0],["وَاِسحاقُ مَأمونٌ عَلى مَن أَهانَهُ","وَلَكِن تَسَلّى بِالبُكاءِ قَليلا",8,"ل",2,0],["واسحقهما بمائنا المصفى","واسقهما حقهما موفّى",9,"ف",2,0],["وأُسحبُكمْ ذيلَ التجاوزِ عنكمُ","لعلَّكمُ أن تَقْرعُوا سنَّ نادمِ",10,"م",1,0],["وأسحمَ غربيبَ المُلاءةِ ناعباً","وأورقَ غرّيدَ الضحى مترنِّما",11,"م",2,0],["وَأَسحَبُ أَذيالَ الدُجى فَيَهيجُني","حَمامٌ تَداعى سَحرَةً فَتَكَلَّما",12,"م",2,0],["وَأَسحَمُ رَجّافٌ مِنَ الدَلوِ مُرزِمٌ","جَرُورٌ إِذا ما رَجَّهُ الرَعدُ مُمطِرُ",13,"ر",1,0],["واسحب ذيولكَ في الصبا","ودعِ العواذلَ في سقَر",14,"ر",1,0],["وَأَسْحَارُكْ مَا خَطْبٌ","شوَادِيهَا وَآصَالُكْ",15,"ك",1,0],["وأَسْحبُ ذيلَ العزمِ في أرضِ هِمَّةٍ","إِلى واهبٍ أَموالَه للمَواهبِ",16,"ب",1,0],["وأسحر من موج السراب مكائدا","وأسرى وأهدى من سيول التهائم",17,"م",1,0],["وأسحبُ ذيالي عَليها وكرخُها","مظِنَّةُ إطرابي ودَجْلتُها شربي",18,"ي",1,0],["وَأَسَحَّ مِنْ وَبْلِ الْحَيَا","وَأَعَمَّ مِنْهُ جَداً وَأَفْيَدْ",19,"د",1,0],["وَأسحرُ من ثغر يُناغيك باسماً","بمنثورِ منضود من اللّؤلؤ الرطبِ",20,"ب",1,0],["واسحريني ظلّاً لظلّك في العا","لمِ وامضى كما تشائين عنّي",21,"ي",1,0],["واسحقوا هيكلي وألقوا إلى الري","ح حطامى وبعثروا أغنياتي",22,"ي",1,0],["واسحَبَني ذيل الكرامة جاهُهُ","وذو الفضل لا يشقى به من يصاحب",23,"ب",1,0],["واسحَبْ على السُّحْبِ إِنْ كَفَّتْ وإِنْ وَكَفَتْ","أَذيالَ منسكبٍ جارٍ بمُنْسَبِكِ",24,"ك",1,0],["واسحَبْ بعسكرك السحابَ فبيضَهُ","من برقِه وصهيلَه من رعدِه",25,"د",2,0],["واسحَبْ ذيولَ الفخرِ لابسَ وشيِهِ","حُلَلاً جديداً نسجُها أن يَخلَقا",26,"ق",2,0],["واسحب ذيولاً من كراماتها","لم تَبلَ بالسحب ولم تُخلقِ",27,"ق",1,0],["وأسحّهم كفاً وأشمخ همة","وأعَّمهم رفداً واشرف محتدا",28,"د",2,0],["واسحب على السحب فضل الذيل من خلع","أعرتها فضل عرض غير ذي درن",29,"ن",1,0],["وَإِسحاقٌ وَإِسماعيلُ فيها","بِما صَلّوا لِرَبِّهِمُ وَصاموا",30,"م",3,0],["وإسحاقاً ويعقوباً","ويوسف ذا البَها المفهمْ",31,"م",1,0]]}