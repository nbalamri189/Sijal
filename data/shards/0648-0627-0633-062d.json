{"poems":[[55,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[32,"أمن دمنة بين القلات وشارع","https://www.aldiwan.net/poem29572.html","الطويل"],[74,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[40,"يا عجبا للدهر شتى طرائقه","https://www.aldiwan.net/poem7734.html","الطويل"],[94,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[45,"أتاني كلام الجاهل ابن كيغلغ","https://www.aldiwan.net/poem10133.html","الطويل"],[64,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[64,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[64,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[76,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[42,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[50,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62220","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55087","الهزج"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[164,"شهدت لقد أعليت كعب المكارم","https://www.aldiwan.net/poem58777.html","الطويل"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[333,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[333,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[438,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[438,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[438,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[469,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[520,"أقول والصدق فيما قلت يعضدني","https://www.aldiwan.net/poem12281.html","البسيط"],[541,"أجدك ما لعينك لا تنام","https://www.aldiwan.net/poem23869.html","الوافر"],[563,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122679","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53936","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64115","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38019","الكامل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96373","الوافر"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119307","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119977","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96727","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61035","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61057","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64784","المتقارب"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101829","السريع"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101834","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69417","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89552","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121910","الكامل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115233","الطويل"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115387","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46744","الطويل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34741","الوافر"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32747","المتقارب"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/4","المنسرح"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111435","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117300","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72499","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204235","البسيط"],[5168,"انته ابتسم","https://www.poetsgate.com/ViewPoem.aspx?id=33674",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5183,"اجتلاء العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180227",""],[5324,"لعن الله جميع الزعماء .","https://www.poetsgate.com/ViewPoem.aspx?id=207664",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5415,"الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=212225",""],[5512,"يا أيها الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=204865",""],[5573,"طال السهر","https://www.poetsgate.com/ViewPoem.aspx?id=200217",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5727,"الشاطئ البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=205417",""],[5829,"اسمحي لي","https://www.poetsgate.com/ViewPoem.aspx?id=157491",""],[5956,"وأسحق كفيك بين يديَّ","https://www.poetsgate.com/ViewPoem.aspx?id=182654",""],[520,"أقول والصدق فيما قلت يعضدني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577664",""]],"verses":[["وَأَسحَبَكُم صافِناتِ العَلاءِ","جَرَّ الشَموسِ طِراقَ الجِلالِ",0,"ل",1,0],["وَأَسحَبُ فيها بُردَ جَذلانَ شامِتٍ","إِذا شاءَ غَنَّتهُ الرَقاقُ البَوارِدُ",1,"د",1,0],["وَأَسحَمُ رَيّانُ العَسيبِ كَأَنَّهُ","عَثاكيلُ قِنوٍ مِن سَميحَةَ مُرطِبِ",2,"ب",1,0],["وَأَسحَمَ كَالأَساوِدِ مُسبَكِراً","عَلى المَتنَينِ مُنسَدِلاً جُفالا",3,"ل",2,0],["وَأَسحَمَ مَيّالٍ كَأَنَّ قُرونَهُ","أَساوِدُ واراهُنَّ ضالٌ وَخِروَعُ",4,"ع",1,0],["وأسحب والأولاد فضل ملابسٍ","نصافي بها الأيام حين نصافي",5,"ف",2,0],["وَأَسحَمَ حَنّانٍ مِنَ المُزنِ ساقَهُ","طُروقاً إِلى جَنبَي زُبالَةَ سائِقُه",6,"ق",2,0],["واسحقي الكَائِناتِ كوْناً بكَوْنٍ","قبل أنْ تنتهي أذلّ تَنَاهِ",7,"ه",1,0],["وَاِسحاقُ مَأمونٌ عَلى مَن أَهانَهُ","وَلَكِن تَسَلّى بِالبُكاءِ قَليلا",8,"ل",2,0],["واسحقهما بمائنا المصفى","واسقهما حقهما موفّى",9,"ف",2,0],["وأُسحبُكمْ ذيلَ التجاوزِ عنكمُ","لعلَّكمُ أن تَقْرعُوا سنَّ نادمِ",10,"م",1,0],["وأسحمَ غربيبَ المُلاءةِ ناعباً","وأورقَ غرّيدَ الضحى مترنِّما",11,"م",2,0],["وَأَسحَبُ أَذيالَ الدُجى فَيَهيجُني","حَمامٌ تَداعى سَحرَةً فَتَكَلَّما",12,"م",2,0],["وَأَسحَمُ رَجّافٌ مِنَ الدَلوِ مُرزِمٌ","جَرُورٌ إِذا ما رَجَّهُ الرَعدُ مُمطِرُ",13,"ر",1,0],["واسحب ذيولكَ في الصبا","ودعِ العواذلَ في سقَر",14,"ر",1,0],["وأسحم ميال القرون كأنه","أساود رمان السباط الأطاول",15,"ل",1,0],["وأَسْحَمَ مَجَّاجَ الدِّهَانِ كَأَنَّهُ","عَنَاقِيدُ مِنْ كَرْمٍ دَنَا فَتَهَصَّرَا",16,"ر",2,0],["وَأَسْحَارُكْ مَا خَطْبٌ","شوَادِيهَا وَآصَالُكْ",17,"ك",1,0],["وأَسْحبُ ذيلَ العزمِ في أرضِ هِمَّةٍ","إِلى واهبٍ أَموالَه للمَواهبِ",18,"ب",1,0],["وأسحر من موج السراب مكائدا","وأسرى وأهدى من سيول التهائم",19,"م",1,0],["وأسحبُ ذيالي عَليها وكرخُها","مظِنَّةُ إطرابي ودَجْلتُها شربي",20,"ب",2,0],["وَأَسَحَّ مِنْ وَبْلِ الْحَيَا","وَأَعَمَّ مِنْهُ جَداً وَأَفْيَدْ",21,"د",1,0],["وَأسحرُ من ثغر يُناغيك باسماً","بمنثورِ منضود من اللّؤلؤ الرطبِ",22,"ب",1,0],["واسحريني ظلّاً لظلّك في العا","لمِ وامضى كما تشائين عنّي",23,"ن",2,0],["واسحقوا هيكلي وألقوا إلى الري","ح حطامى وبعثروا أغنياتي",24,"ي",1,0],["واسحَبَني ذيل الكرامة جاهُهُ","وذو الفضل لا يشقى به من يصاحب",25,"ب",1,0],["واسحَبْ على السُّحْبِ إِنْ كَفَّتْ وإِنْ وَكَفَتْ","أَذيالَ منسكبٍ جارٍ بمُنْسَبِكِ",26,"ك",1,0],["واسحَبْ بعسكرك السحابَ فبيضَهُ","من برقِه وصهيلَه من رعدِه",27,"د",2,0],["واسحَبْ ذيولَ الفخرِ لابسَ وشيِهِ","حُلَلاً جديداً نسجُها أن يَخلَقا",28,"ق",2,0],["واسحب ذيولاً من كراماتها","لم تَبلَ بالسحب ولم تُخلقِ",29,"ق",1,0],["وأسحّهم كفاً وأشمخ همة","وأعَّمهم رفداً واشرف محتدا",30,"د",2,0],["واسحب على السحب فضل الذيل من خلع","أعرتها فضل عرض غير ذي درن",31,"ن",1,0],["وَإِسحاقٌ وَإِسماعيلُ فيها","بِما صَلّوا لِرَبِّهِمُ وَصاموا",32,"م",3,0],["وإسحاقاً ويعقوباً","ويوسف ذا البَها المفهمْ",33,"م",1,0],["واسحاق ويعقوب لكل","ضريح غير زوجته الوفيه",34,"ي",2,0],["وإسحاقُ خِلفِ الجُودِ مِن بَعدِ دَرِّهِ","يَبُلُّ أكُفَّ الرّاغِبينَ وَكيفًها",35,"ف",3,0],["وأسحَبُ ذيلَ الأنسِ في ظِلِّ نعمةٍ","من الوصل أُمْسِي فِي حماها وأُصبحُ",36,"ح",1,0],["واسحمَ ينثر من طلِّه","على درّ نواره درَّ ماءِ",37,"ا",2,0],["وَاِسحَرْ وَفتِّكْ واِسطُ مُفتَرِساً","وَاِقتُلْ وَكُنْ بِالقَتلِ ذا لَهجِ",38,"ج",1,0],["واسحاقٌ اخونا قد علمتُم","علينا من مواسِمِه النجارُ",39,"ر",1,0],["وأسحب رفلاً في الاخاء مضوعاً","بعطر ولاء لا يدنس بالقص",40,"ص",1,0],["واسحب ذيولَ سعادةٍ","ما أن تحول إلى نفاد",41,"د",1,0],["وَأسحم كالغمام له غمامٌ","فعقّب فضله فضل الغمامِ",42,"م",1,0],["وَاِسحب ذُيول العُلى وَالعز في دعة","فَالدهر طوعك وَالأَقدار تَخدمكا",43,"ك",2,0],["وَاِسحَب ذُيول اللهو في لَذة","وَاعكف عَلى حَث كُؤوس المدام",44,"م",1,0],["وأَسْحارُ أَلحاظِ غِزلانَها","ينافثُهَا لفظُهُ السَّاحِرُ",45,"ر",1,0],["واسحب الأفراح قد أصبحت","تشمل منا الحر والعبدا",46,"د",2,0],["واسحب ذيول التهاني ما حييت ولا","برحت من أعين الحساد محروسا",47,"س",2,0],["واسحَب عَلى الشِعرى العَبُورِ مَلابِساً","عَبَرَت عَلى جَسَدِ الإِمامِ الأَمجَدِ",48,"د",1,0],["وَأَسحَنُ خَتمٍ لِلنِّظام إِذا اِنتَهى","صَلاةٌ وَتَسليمُ الإِلهِ المُضاعَفُ",49,"ف",1,0],["واسحب ذيول الحزن واقرع وجنتى","خديك بالدمع الذى يرضيهمو",50,"م",2,0],["وإسحاق التّقي وفتى نجيحٍ","وعبد اللّه ذي مدحٍ طوال",51,"ل",1,0],["واسحم ملآنٍ جررتُ لفتية","كرامٍ أبوهم خير بكر بن وائل",52,"ل",1,1],["واسحب ذيلي في الرخاء بخرد","حسان كنظم الدر لما ترصعا",53,"ع",2,0],["وَأَسحَم مَجّاجِ الدهانِ كَأَنَّهُ","بِأَيدي النِّساءِ الماشِطاتِ مَثاني",54,"ن",2,0],["وأُسحَبُ في سَراويلي بقَيد","إلى حسَّانَ مُعتقلَ اللسانِ",55,"ن",1,0],["وَاِسحاقُ عِمرانُ يُدعى الأَميرَ","لَداهِيَةٌ أَيُّما داهِيَه",56,"ي",2,0],["وَأَسحَبُ الرَيطَ وَالبُرودَ إِلى","أَدنى تِجاري وَأَنفُضُ اللِمَما",57,"م",2,0],["وأسحم فاحم مُسحنكك كشِف","جثل طويل أثيثُ النَبت يَحمومُ",58,"م",1,0],["واسحَقهُ سَحقاً في يدي يَكُ عِبرَةً","لِنَزِيلِ سُوءٍ عَقَّ فَضلَ قُراتِهِ",59,"ت",2,0],["واسحب ذيول سريرة السر الذي","يطوى عليه من صفاك ضلوع",60,"ع",1,0],["وأسحارها عن رقة السحر قد روت","كما قد روت عنها لحاظ غوانيها",61,"ي",3,0],["واسحب بذا العيد أذيالاً مجددة","واستقبل العيش في إفطاره رغدا",62,"د",2,0],["واسحن بروحي الحزينة","وزيد هم وبعد هم",63,"م",1,0],["واسحق الأيام عابسة","في غنا إسحاق تغتنم",64,"م",1,0],["واسحب على روض الرضا برد الهنا","واطرب عليه بنغمة الغرّيد",65,"د",1,0],["واسحقوا من خان منكم وارفضوا من","هان من باع زكيّات الدماء",66,"ا",2,0],["وإسحاق والثوري وكابن عيينة","ويحيى وكابن الماجشون الذي حما",67,"م",2,0],["وَاسْحَرْ بِأَحْرُفِهَا قُلُوبًا حَيَّةً","بِتَحَمُّسٍ وَصِيَاغَةٍ وَمَعَانِ",68,"ن",1,0],["واسحبْ ملوحةَ دمعٍ كي يصيرَ ندى","إنَّ النَّدى فاعلٌ كالرُّوحِ في الجسدِ",69,"د",1,0],["واسحب على بحر الطواريق موال","واجر صوتي بالحروف المصاخير",70,"ر",1,0],["واسحق فؤادً غوى وأقرع جناحيهُ","وأصفق بكفيك لكن صفقة الندمِ",71,"م",1,0],["واسحبيني إليكِ في ظُلَلِ الأعم","اقِ فإني أضَلَّني تَهْوِيمِي",72,"م",2,0],["واسحبي الشلال في شعر تهادى","موجه الرقراق منساب إليك",73,"ك",1,0],["‏وأسحق كفيك بين يديَّ","‏ ‏ ويسحقني الحب بين يديكِ",74,"ك",1,0],["واسحب على السحب فضل الذيل من خلعٍ","أعرتها فضل عرض غير درن",75,"ن",1,0]]}