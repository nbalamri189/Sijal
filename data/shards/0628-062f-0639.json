{"poems":[[95,"قد قلدوك قلائد الدرر","https://www.aldiwan.net/poem9844.html","أحذ الكامل"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[90,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[53,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[47,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[63,"أقطعتني روض الغنى كرما ولم","https://www.aldiwan.net/poem51380.html","الكامل"],[63,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[63,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[63,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[63,"يا أبا إسحاق زاد الله","https://www.aldiwan.net/poem51668.html","مجزوء الرمل"],[63,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[63,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[63,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[63,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[54,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[47,"إنّ طَيْفاً يزُورُني في المَنامِ","https://www.poetsgate.com/ViewPoem.aspx?id=31854",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[177,"أنكر العبد بزه وحلاه","https://www.aldiwan.net/poem4381.html","عموديه"],[193,"عيس لها في الآل رقص","https://www.aldiwan.net/poem35160.html","مجزوء الكامل"],[236,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[240,"عسى الدهر يوما بالبخيلة يسمح","https://www.aldiwan.net/poem32121.html","الطويل"],[266,"زد علا ما لحده من تناه","https://www.aldiwan.net/poem38145.html","الخفيف"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[409,"بلد ما أقول فيها وقد","https://www.aldiwan.net/poem33911.html","الخفيف"],[435,"رشف المجد بالمسرة كاسه","https://www.aldiwan.net/poem39875.html","الخفيف"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[484,"الله أكبر في ضريح واحد","https://www.aldiwan.net/poem37048.html","الكامل"],[563,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[563,"لك قد رمت وجودا فأبى","https://www.aldiwan.net/poem34921.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122660","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59644","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136191","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64630","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50013","المتقارب"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26662","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108705","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108750","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66295","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28067","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35867","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117859","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4689,"عبقري الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=152814",""],[4727,"دولة الحلاقة","https://www.poetsgate.com/ViewPoem.aspx?id=215835",""],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[4800,"رقص الزار","https://www.poetsgate.com/ViewPoem.aspx?id=104751",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[259,"ما لعيني لم تعني","https://www.poetsgate.com/ViewPoem.aspx?id=214199",""],[5776,"سرةٌ تبلعُ ذقنَ المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=199337",""],[5854,"أهزّك الوجد لما بانت الرُسُم ((بالتوحيد نتحد))","https://www.poetsgate.com/ViewPoem.aspx?id=192157",""],[5956,"بدعوتها لتكريمي تحققتِ الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=194272",""],[6046,"حدود... بلا حدود!","https://www.poetsgate.com/ViewPoem.aspx?id=37247",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6202,"ألف سلمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86706&r=&rc=7",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6304,"ضفاف الغدير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1614&r=&rc=4",""]],"verses":[["بدعاء خير الوالدين وفي","يمن الذين دعوك بالصهر",0,"ر",1,0],["بدعائه انقشع الغمام وقبلها","والت بدعوته الغمام همولا",1,"ل",2,0],["بِدَع في حياتنا مُنكرات","غضب اللّه فوقها مسدول",2,"ل",1,0],["بدعةُ عندي كاسمها بدعَهْ","لا إفك في ذاك ولا خدعَهْ",3,"ع",2,1],["بِدَعٌ لِبِدعٍ في السَماحَةِ ما تَرى","مِن أَمرِهِ إِلّا عَجيباً مُجذِلا",4,"ل",2,0],["بدع تخلدها الرواة صدورها","حبا فتحسب للصدور قلوبا",5,"ب",2,0],["بِدَعٌ كأطرافِ الدَّما","لجِ والأساورِ والخَلاخِل",6,"ل",1,0],["بِدَعٌ لو تحقَّقَتْ ببَقاءٍ","كُنَّ أَولى من الحِلَى بالحِقاقِ",7,"ق",1,0],["بِدَعٌ كالسُّيوفِ أُرْهِفْنَ حُسْناً","وسِقاهُنَّ رَوْنَقَ الطَّبْعِ ساقي",8,"ق",2,0],["بِدَعٌ ترتَعُ منها ال","عينُ في وَشْيِ حَبيرِكْ",9,"ك",1,0],["بِدَعٌ تضوَّع نَشْرُها فكأنَّما","كُتِبَتْ صَحائِفُها بمِسْكِ أذفرِ",10,"ر",1,0],["بدع إذا ما الفكر حاول وصفها","يوما تحير دونها وتبلدا",11,"د",2,0],["بِدَعٌ إذا نظمَ الثَّناءُ عقودَها","كانت لأعناقِ الملوكِ قَلائِدا",12,"د",2,0],["بِدَعٌ لو أنَّ الصَّبَّ يستَشفي بها","ألمَ الفِراقِ شَفَتْه من أوصابِه",13,"ب",2,0],["بِدَعٌ مِن مَكارِمِ الفِعلِ وَالقَو","لِ وَإِخوانِ مَحضِرٍ وَمَغيبِ",14,"ب",1,0],["بِدَعٌ أُنشِأَت لِأُولى عِبادِ اللَ","هِ بِالرُكنِ وَالصَفا وَالمَقامِ",15,"م",1,0],["بدعة الذلّ أن تحنّ وتبكي","وتغنّي \" الرشيد \" و\" والخيزرانا \"",16,"ن",2,0],["بِدَعٌ أُنْشِئَتْ لأوْلى عِبادِ الله","بالرّكْنِ، والصّفا، والمَقَامِ",17,"م",1,0],["بدعة الذلّ حين لا يذكر الان","سان في الشام أنّه إنسان",18,"ن",1,0],["بدعة الذلّ أن يصاغ من ال","فرد إله مهيمن ديّان",18,"ن",1,0],["بدعة الظرف والأناقة يرضيك","دعابا عفا ويرضيك جدّا",19,"د",2,0],["بِدُعَاء مُبَارَكٍ مُستَجَاب","كَشَفَ الضُّرَّ وَالضَّنَى وَجَلاَهُ",20,"ا",2,0],["بِدعائهِ زالَ الغلا","ءُ وعمّ في الآفاق رخصُ",21,"ص",1,0],["بدعوته في المحل حُلت حيا الحيا","فجاد بغيث مغدق غر مشحذ",22,"ذ",1,0],["بِدَعوَتِهِ صابَ الحَيصَ وَبِعَدلِهِ","وَرَأفَتِهِ رَفَّ الهَشيمُ المُصَوِّحُ",23,"ح",1,0],["بدعاء كابدته باجتهاد","واشتهار له بغير اشتباه",24,"ه",1,0],["بِدْعاً يَراها وَلا فَخْرَ البَدِيع كَما","يَرودُ مُهْرَقَها البُسْتِيُّ بُسْتَانا",25,"ن",2,0],["بِدَعوَةٍ مِنهُ أَو في صَوبِ ساكِبِها","بِعارِضٍ جادَ أَو خَلَتِ البِطاحَ بِها",26,"ه",2,0],["بِدَعٌ لم تَدعْ لوُسْعِ بليغٍ","صَرْفَ حَرْفٍ له بآخرَ نَقدا",27,"د",2,0],["بدعاء مشفع بابتهال","والتجاء قد زانه الافتقار",28,"ر",1,0],["بدعاءٍ يبدي التهاني ومدحٍ","شيد الناس بالوفاق أساسه",29,"س",2,0],["بدْعاً من النظمِ النفيسِ تَشابَهَت","فِيهَا الجواهِرُ دُرُّها وفَريدُها",30,"د",3,0],["بدعا كما له في الحياة وبره","بكما اهتدى واللّه أصدق شاهد",31,"د",1,0],["بدعوة يندكُّ منها الجبل","ودعوةٍ غيثُ المنى ينهمل",32,"ل",1,0],["بدعاويك له حيث دنا","منك يا تقديره واقتربا",33,"ب",2,0],["بِدَعٌ له في الجُودِ يَدرُسُها بَنُو","أيّامهِ فَكَأنَّهُنَّ شَرائع",34,"ع",1,0],["بِدْعٌ من النَظْمِ مَوْشِيُّ الحُلَى عَجَبٌ","تُنْسي الفحولَ وما حاكوا وما حكَأَوا",35,"ا",1,0],["بِدعٌ تعبثُ في أهل الهوى","عبثَ الظالم في نفس البري",36,"ر",2,0],["بدعوتهم للخلق فيما به الهدى","وتذكيرهم فيما سيحدث في الحشر",37,"ر",1,0],["بدع من الأمر إذ حلت جلالته","تلك السراية في الأفلاك لم تطر",38,"ر",1,1],["بدعج مراض وصفو بَياض","فلا بالمفاض ولا بالأزلْ",39,"ل",1,0],["بدعة كون ونشأة بدرت","أهُمُّ في صدقها بتكذيب",40,"ب",1,0],["بدعائه فاض الغمام على","قطر الشآم وبورك القطر",41,"ر",1,0],["بدع الغرام جليلةٌ وأجلها","حبي لغير مطيعة ومطاوع",42,"ع",1,0],["بدعاك للقيا ف","إنَّ بها دعاءَكَ مستجاب",43,"ب",1,0],["بدعوك رب بالاسماء الحسنى","وما لها من الكمال الاسنى",44,"ن",2,0],["بِدَعدٍ وَلَن تَلقى لَها ذا مَوَدَّةٍ","وَلا قَيِّماً في الحَيِّ إِلّا مُحَسَّدا",45,"د",2,0],["بدعوة وردت في سنة رويت","كمن يبيعان قل حقا ولا تهم",46,"م",1,0],["بدع أصاب من الزلزال أرضها","فأزاح بهجة عيشها وأزالها",47,"ل",3,0],["بِدُعائِكُم ظلّ الإِلَه بِأَرضِهِ","إِذ أَنتَ لَطفٌ لِلبَرِيَّةِ شامِلُ",48,"ل",1,0],["بِدَعٌ لهم كُفريَّةٌ وكذا ابنهُ ال","زبليُّ أَضحى مَسكِنَ الشَيطانِ",49,"ن",1,0],["بدعوته أحيى شريعة جدّه","إلى أن نفى عنها التأيم واليتما",50,"م",2,0],["بَدْعي عسى الموشين عِطْيَو حِريجِ","شَروات مَا شَبَّوا بقْلْبي حَرايِج",51,"ج",1,0],["بدعوةٍ من رسول الله أعقبها","عزٌ ونصرٌ ففي إقباله ظفر",52,"ر",1,0],["بدعة الدهر وآيٌ","من أعاجيبِ الرَّقيقِ",53,"ق",1,0],["بِدَعٌ أَظَلَّتْ كَالغَمَامِ فِنَاءَنَا","وَحُظُوظُ نَفْسٍ تَقْضِى بِالأَهْوَاءِ",54,"ا",2,0],["بدعها احْساس فاقد للغوالي","يجرّّ الصوت ياكبر المصيبه",55,"ب",2,0],["بدعاءٍ علَّمت صار بصيراً","فكأن لم يكن بعينه داء",56,"ا",2,0],["بدعوته الغراء بالعروة التي","إذا استمسكت بها لم تخف فصما",57,"م",2,0],["بدعاء فيه وصْلٌ","لا تسيئي فيك ظنّي",58,"ن",2,0],["بدعوى الجِهادِ تخُبئُ رِجسَاً","وَعُقمُ الفَتَاوى يُحبّ الشّواذا",59,"ذ",2,0],["بِدَعْوَةِ الحَقِّ فِي الجَوْزَاءِ هَامَتُهُمْ","بِعِزَّةِ الدِّينِ فِي عِرْنِينِهِمْ شَمَمُ",60,"م",1,0],["بِدعوتها تحققتِ الأماني","فتاة في حياتي مثل نجمِ",61,"م",1,1],["«بِدَعٌ» من التّفتيتِ، صارتْ «سُنَّةً»","فإذا رفضْتُ، وُصِفْتُ بالمُتَشَدِّدِ",62,"د",1,0],["بدعوات الأولياء الخيره","بحق اذكار الكرام البرره",63,"ه",1,0],["بدعجاوين منها يأسراني","رأيت من اللمى حلوا شفاها",64,"ا",3,0],["بدعةٌ مّا من جنة الخلد ما في","الأرض مِثْلٌ لها على الإطلاقِ",65,"ق",1,0],["بدعة الشعر أن تشوب الغديرال","عذب في أكؤس القصيد البحور",66,"ر",1,0]]}