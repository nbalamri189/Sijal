مع الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=208722",""],[5007,"إنّهَا لا تَدْرِي...مَنْ يُخْبِرُهَا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=142528",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5028,"مرت على بالي اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=62108",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[307,"الكنوز","https://www.poetsgate.com/ViewPoem.aspx?id=213659",""],[5317,"قالب عسل","https://www.poetsgate.com/ViewPoem.aspx?id=177085",""],[5351,"سؤال الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202130",""],[5419,"عقدة","https://www.poetsgate.com/ViewPoem.aspx?id=32215",""],[5431,"صفقة العهر ...ليس من خان منّا","https://www.poetsgate.com/ViewPoem.aspx?id=209119",""],[5433,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=36261",""],[5463,"قصه كذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25529",""],[5606,"سعيد وسعيده","https://www.poetsgate.com/ViewPoem.aspx?id=198393",""],[5691,"عراقة شعب","https://www.poetsgate.com/ViewPoem.aspx?id=206063",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5776,"هامشٌ من مسوّدات الغيب على مقعدٍ خشبيّ","https://www.poetsgate.com/ViewPoem.aspx?id=199406",""],[5781,"عراقُ فاتحةُ القصيدةِ والنهايات","https://www.poetsgate.com/ViewPoem.aspx?id=202842",""],[402,"فجع القريض وقد ثوى حسان","https://www.poetsgate.com/ViewPoem.aspx?id=36468",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[6019,"رثاءٌ لا يكفي لوعةَ الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=175386",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[5190,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78337&r=&rc=50",""]],"verses":[["مَنْ يُحْكِمِ الإِفْنَاءَ بَعْدَ سَلِيمِهِ","وَبِهِ الرِّضَى وَإِلَيْهِ الاِطْمِئْنَانُ",0,"ن",1,0],["منيح خصال لا تعد خصاله","خصالاً زميل حظه الكفل مُحْقَبُ",1,"ب",1,1],["من يحارب حوادث الدهر يخفى","لون فُؤدَيهِ في غبار الحروب",2,"ب",1,0],["من يحسب الاوهام منه حقائقا","يجد الحقائق كلها اوهاما",3,"م",2,0],["من يحمل العبءَ يصبر","له على كلِّ حالِ",4,"ل",1,0],["من يَحْدِرُ فقراً عنك إذا","فاضَتْ نعماهُ عليك غِنَى",5,"ن",2,0],["مَن يَحسُدُ الأَرضَ لِإِشفاقِهِ","مَوطِئَ نَعلَيكَ مِنَ الأَرض",6,"ض",1,0],["من يحتقر بالمهذب","من أين لو تهذيبْ",7,"ب",1,0],["مَن يَحفَظُ التاجَ إِن أَلوى بِهِ قَدَرٌ","يَرمي بِهِ صُعُداً في الجَوِّ أَو صَبَبا",8,"ب",2,0],["مَن يَحرُسُ المُلكَ إِن هَمَّت بِحَوزَتِهِ","سَوالِبُ المَلِكِ الجَبّارِ ما سَلَبا",8,"ب",2,0],["من يحل المشكلات المرتجى","حيث لا ينفع من دق وجل",9,"ل",1,0],["مَنْ يَحسُنُ الدُّنيا بإحسانِهِ،","ويَجْمُلُ الدَّهْرَ بإجْمَالِهِ",10,"ل",2,0],["من يحبّ العزّ يَدأبْ إليه","وكذا من طلب الدُّرَّ غاصا",11,"ص",2,0],["مَن يُحِبُّ الحَبيبَ فَهوَ حَبيبٌ","وَعُداةُ الحَبيبِ هُم أَعداءُ",12,"ا",2,0],["من يحييهِ والنسيمُ إذا هبَّ جفا","ني والصبحُ أطولُ هجرا",13,"ر",2,0],["مَن يَحفَظُ الفِيلَ بَعْدَ الشِّبْلِ والأَسَدِ","هَيْهاتَ والمَوْتُ لا يُبقي على أَحَدِ",14,"د",1,1],["من يحببِ اللَه يبغضْ كل مكرمةٍ","سواه والنفسَ والجثمانَ والشرفا",15,"ف",2,0],["مَن يحاول في الدهر مجداً أثيلا","فليجرّد الحُسامَ الصقيلا",16,"ل",2,1],["من يحمَدُ الآن ذا الزمانَ فما","أصبحت ممّنْ غدا له حامدْ",17,"د",1,0],["من يحللنهما جحود كفور","ما له في الاديان طرا دليل",18,"ل",1,0],["من يحسدِ المجدَ غَصّانٌ بحسرتِهِ","وعاشقُ المجد لا يُلفى على مَلَلِ",19,"ل",1,0],["من يحمد اللَه يأتيه المزيد ومن","يكفر نعمٍ آلت إلى نقم",20,"م",1,0],["من يُحلِّي العَروضَ بعدكَ لاَ مَن","حين يُعْرَى من الحُلِيِّ العَروض",21,"ض",1,0],["مَن يَحْبُني منه عَيناً","حَبَوْتُهُ ألفَ عَينِ",22,"ن",1,1],["من يَحظ بالتوفيق يمضي مسرعاً","كالبرق في جسر المقام الهائلِ",23,"ل",1,0],["من يحشر يوم المعاد تحت لواه","شيت وأبوه والأنبياء والأرسال",24,"ل",1,0],["من يحسب الطيب دفيناً متى","جارت على الورد صروف القضاء",25,"ا",2,0],["مَن يَحُث الخَمر في غَير كبر","هائِماً بِالغانيات الحسان",26,"ن",1,0],["من يحسّ بخافقٍ جرحه شنيع","تنزف اطرافه، ولكنَّه صبور",27,"ر",1,0],["من يَحمل الخَطب الجَلي","لَ وَيُبطِل البَطل الحُلاحِل",28,"ل",1,0],["من يحمه اللَه ساوى في حمايته","فعل الجمادات فعل الناس والبهم",29,"م",1,0],["من يحمِلَن خطرَك","سبحانَك اللَه",30,"ه",1,0],["من يحرم طيّب ما يعطى","يستبدل بالمن العدسا",31,"س",2,0],["من يحاكيه في بديع حلاه","هل تحاكي ورق الجنادب ضيغم",32,"م",1,0],["من يحتمل صعب الامور يقودها","مطواعة سلس القياد ذلولا",33,"ل",2,0],["من يحظ فيها فارقته بلحظة","مثل السعادة مبدء وختام",34,"م",1,0],["من يحتمل ثقل من يأتيه معتفياً","لم يتَّجه نحوه ذمٌ ولم يُعَبِ",35,"ب",1,1],["من يحاذر لقاء حمر المنايا","فليحاذر تلك الجفون السّودا",36,"د",2,0],["مَن يحفظ التاريخُ آثاره","ما زال حيَاً وهوَ نحتَ التراب",37,"ب",1,0],["مَن يَحمِلِ الأمواتَ يُجزَ من الوَرى","والحاملُ الأَحياءِ من ربِّ البَشَر",38,"ر",1,0],["من يحتفر بئرَ سوءٍ كان أول من","يهوي به ويًردَّى قبل من قصدا",39,"د",2,1],["من يحفظ الجند بالإحسان يلقهم","أن يدعهم في الوغى يأتوه إرسالا",40,"ل",2,0],["مَن يحتقر راس الملا يسقط عَلى","حجر الرحي وَبِهِ يُطوَّق جَيدُهُ",41,"د",2,0],["من يحجر العلم والأقطار حافلة","بأهله وهم في الناس نظار",42,"ر",1,0],["من يحمد صوغ المديح فيه ويحلو","كم طاب لمن فاه فيه طيب انشاد",43,"د",1,0],["من يحييها يحيَ بها قلبه","ولم يمت يوم تموت القلوبْ",44,"ب",1,0],["مَن يحسد الناس على فضلهم","تجرَّع الغَمَّ على غِرَّهْ",45,"ر",2,0],["من يحسنُ الوجدُ بهِ والهوى","له ولا يحسنُ أن يسعِفا",46,"ف",2,0],["مَن يَحتَمي بِمَقامِكُم وَبِجاهِكُم","يَأمَنُ طَوارِقَ طارِئٍ طَرّاقِ",47,"ق",1,0],["من يحبك لا ما يخونك","لو تراه يزعل عليك",48,"ك",1,0],["من يحط إذنه على كل سمّاعه","جاه فرقاً مابعدها تجمَاعي",49,"ع",2,0],["مَن يَحفِرُ الأنفاقَ, مَن يَعِدُ الرَّدَى","بِدَمِ الجَنُوبِ لِكَي يَبيعَ شِمَالا",50,"ل",2,0],["مَن يَحمِلُ الإسلامَ \"حَملًا كاذِبًا\"","يُخفي فَسَادًا خَلفَهُ ونَكَالا",50,"ل",2,0],["من يحمي صرح عقيدتنا","فالصرح العالي معتصم",51,"م",1,0],["من يحدثني حديث الدمْع عن غزة واريحه","ومسجد ٍ صلى صَلاح بداخله واشفَى جِراحه",52,"ح",2,1],["من يحرم الشيء تكبر فيه رغبته","عشقا ، لإشباعه تلقاه مشتعلا",53,"ل",2,0],["من يَحْلب الحبّ من ثَدْي الزّمان يَمُت","موت الغريب فقلْ للحيّ شتّانا !",54,"ن",2,0],["من يحتكم بالذي تدعو شريعتها","نال الأمان ولم يصبح على ندم",55,"م",1,0],["من يحرم من العشق يعيش محروم","كم روح من قل الوصال استضرت",56,"ت",1,0],["من يحبّ الأوطان يعرف قدر ال","فضل لا يزدري أولي الألباب",57,"ب",1,0],["مَن يحملُ الرايةَ البيضاءَ في ثِقَةٍ","يَغدو لهُ الحبُّ خفَّاقًا ورفرافا",58,"ف",2,0],["من يحمل الدين نهجاً في مسيرته","كحامل الجمر فوق الجلدِ والعصبِ",59,"ب",1,0],["من يحبك.. ذق من وقته الوبال","يااختصار العمر في(قالب عسل)",60,"ل",1,0],["من يحكم الناس فيهِ","من ليس للحكم أهلا",61,"ل",2,0],["من يحمي بيت المال إذا","ما كان المحتسب اللصا؟",62,"ص",2,0],["من يُحابي جلاده ليس منّا","لا ولا من أذاع بالناس وَهنا",63,"ن",2,1],["من يحدثني حديث الثلج للجمر بثغرها","والله اني كنت ناوي لي بهاك الجمر نية",64,"ي",2,0],["(( من يحبّك لا تبيعه .. ! ومن يذمّ قلبك وباعه .. ! ))","اتركه وأسقيه عَلْقَم مُُرّ بالكاسه شُرُوبه .. ! !",65,"ب",2,0],["من يحسب المعصوب مثل العصيده","ماهو بعيد يسمي القرص مرقوق",66,"ق",1,0],["منْ يُحاولْ مَسَّ النَّسيجِ بضُرٍّ","خابَ مسْعاهُ بلْ وتبَّتْ يَداهُ",67,"ا",2,0],["مَنْ يحدّقْ إليه يُبصرْ ملاكاً","نُورُهُ ساطعٌ بكلِّ جهاتهْ",68,"ت",2,0],["مَنْ يحكُمُنا نصٌ؟ شورى؟؟؟","يحتاجُ الأمرُ إلى تشخيصْ",69,"ص",1,0],["مَنْ يَحْسَبِ المَوْتَ وَالأَقْدارَ طيِّعةً","فَهْوَ المُلاقي لِعُمْرٍ ظَهْرُهُ حَدِبُ",70,"ب",1,0],["من يحكم الإفناء بعد سليمه","وبه الرضى وغليه الاطمئنان",71,"ن",1,0],["من يحفظ التنزيل من يدرى الذي","فيه ومن لم يدر ذاك سواء",72,"ا",2,0],["من يحفظ الاخبار عن اهل النهى","وتعين ذلك فطنة وذكاء",72,"ا",2,0],["مَنْ يَحمِلِ النَّعشَ؟ .. أكتافٌ بهِ ارتعشتْ","وفي الوداعِ تلا بالذِّكرِ شِريانُ",73,"ن",1,0],["من يَحمنا يَا أمتي منْ خوفِنَا","إنً كنتُ أبنى والصديق يُزيحُ",74,"ح",1,0],["من يحجب القمرَ المنيرَ بليلةٍ","يا نجمةً في الأفْقِ، ضلَّ وضاعا",75,"ع",2,0]]}