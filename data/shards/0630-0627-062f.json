{"poems":[[95,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[31,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[87,"ذاد الكرى عن مقلتيك حمام","https://www.aldiwan.net/poem63014.html","الكامل"],[48,"إذا جلست على أقتاد ناجية","https://www.aldiwan.net/poem22790.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54727","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54662","الرمل"],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[119,"سارت تزمزم للحمى الركبان","https://www.aldiwan.net/poem40480.html","عموديه"],[199,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[226,"يا خليلا أجل كل خليل","https://www.aldiwan.net/poem55251.html","الخفيف"],[240,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[303,"خلف الأسى كبدي","https://www.aldiwan.net/poem36805.html","عموديه"],[303,"ورقاء ذات تفجع","https://www.aldiwan.net/poem36852.html","عموديه"],[310,"تونس الأنس بلدة ميمونه","https://www.aldiwan.net/poem56392.html","الخفيف"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[369,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[391,"ذاد عنى النوم هم بعد هم","https://www.aldiwan.net/poem1843.html","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64160","السريع"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99986","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137849",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49975","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52087","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69365","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69353","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138800",""],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84519","الكامل"],[2933,"","https://poetry.dctabudhabi.ae/diwan/poem/198220","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65131","الرجز"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138688",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138512",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216704","الرمل"],[5156,"يا والي الإمام هنأك الله","https://www.poetsgate.com/ViewPoem.aspx?id=99178",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5674,"بحة النايات","https://www.poetsgate.com/ViewPoem.aspx?id=191359",""]],"verses":[["ذادوا جسوماً عن تحية ركبهم","هل عن تحيته النفوس تذاد",0,"د",1,0],["ذادني عن مواردٍ ليَ كانتْ","شافياتٍ من الغليلِ الهُيام",1,"م",1,0],["ذادَ عن مُقْلِتي لذيذَ المنامِ","شُغلها عنهُ بالدموعِ السجامِ",2,"م",1,1],["ذادَ الضِراءَ بِرَوقَيهِ وَكَرَّ كَما","ذادَ الكَتيبَةَ عَنهُ الرامِحُ النَجِدُ",3,"د",1,0],["ذاد عنها ذياد حر شجاع","وهو فيه بنفسه مدفوع",4,"ع",1,0],["ذادَ الكَرى عَن مُقلَتَيكَ حِمامُ","لَبّاهُ شَوقٌ ساهِرٌ وَغَرامُ",5,"م",1,1],["ذادَ المَكارِمَ عَن كَرَمٍ وَذاتِ جِنىً","في النَخلِ شِربٌ أَبى إِخراجَهُ البَلَسُ",6,"س",1,0],["ذَادُوا عَنِ اسْتِقْلالِهِمْ","وَدِيَارِهِمْ ذَوْدَ البُهَمْ",7,"م",1,0],["ذَادُوا جُسُوماً عَنْ تضحِيةِ رَكْبِهِمْ","هَلْ عَنْ تَحِيَّتهِ النفُوسُ تذَادُ",8,"د",1,0],["ذَادُوه عَنْكَ فَبُتَّ أَقْلَقَ مَنْ ثَوَى","حَيْثُ القَرَارُ يَكُونُ أَمْنَ الهَائِبِ",9,"ب",1,0],["ذَادَ ذَوْداً رَائعاً عَنْ حَوْضِهِ","يَتَجَارَى لَفْظُهُ وَالْعَبَرَاتُ",10,"ت",1,0],["ذادت الامُّ عن البيت وقاء","وارتمى الطفلُ على الامِّ افتداء",11,"ا",2,0],["ذا دفتري قد سودته مآثمي","لكن فؤادي حشوه ايمان",12,"ن",1,0],["ذادَها وَهيَ تَشتَهي الوَردَ حَتّى","غَلَبَت أَن تَقَرَّها الأَكلاءُ",13,"ا",2,0],["ذا دليل على وفائك يا صا","ح ودمعي على الوفاء دليلي",14,"ل",2,0],["ذادَ الرَدى عَن ذَودِها","وَحَمى بِسَطوَتِهِ حِماها",15,"ا",3,0],["ذادَها عَن مَوقِفِ الشِركِ وَقَد","عَكَفَت جَهلاً عَلى أَوثانِها",16,"ن",3,0],["ذاده توهّجها","أنْ يمسَّها بيد",17,"د",1,0],["ذادَ الكرى عن مقلتي","وَمضى به لم يرجِعِ",18,"ع",1,0],["ذا دعاءٌ جارى المؤرّخ نفعاً","فَليبن كلّ سامعٍ تَأمينَه",19,"ن",2,0],["ذا دَولَةٍ عَلى الوَلِيِّ تُسبَغُ","ظِلالُها وَلِلعَدُوِّ تَدمَغُ",20,"غ",1,0],["ذا دولةٍ للهُدَى تُدبِرُها","وعيشةٍ في العُلا تُهَنّؤها",21,"ا",3,0],["ذادَ عَنى النَومَ هَمٌّ بَعدَ هَمّ","وَمِن الهَمِّ عَناءٌ وَسَقَم",22,"م",1,1],["ذا دمُهُ ينصبُّ من حلقه","كما رأينا حبشياً ذبِح",23,"ح",1,0],["ذادَتْ مَوارِدُهُ الكَرى عَنْ مُقْلَتِي","وَأَبَى عَلَيَّ حِذَارَهُ أَنْ أُغْمضا",24,"ض",2,0],["ذاده مزعجه طيب الكرى","فهو في الدهر حليف السهر",25,"ر",1,0],["ذادَ وِردَ الغَيِّ عَن صَدَرِهْ","وَارعَوى وَاللَهوُ مِن وَطَرِهْ",26,"ر",2,1],["ذا دأب أحرار الورى لم يرهبوا","شرعا ولا حكما ولا تهديدا",27,"د",2,0],["ذادوا عن الإسلام بين بيوتهم","مأوى النّبيّ فكلهم أَنصارُهُ",28,"ر",2,0],["ذَادَ الأذَى عَمَّنْ يَلُوذ بِمُلْكِه","مَا فِيه صَاحِب حَاجَةٍ مَخْبُونُ",29,"ن",1,0],["ذَادُوكُمُ بِالعَوالي عَن خِيامِهِم","فَما استُبيحَ لَها طُنبٌ وَلا وَتِدُ",30,"د",1,0],["ذادَ العِدى بَأسُهُ عَنها وَشَرَّدَهُم","حَتّى الأُسودَ العَوادي مِن نَواحيها",31,"ي",3,0],["ذادوا عن الماء ظمانا مراضعه","من جده المصطفى الساقي أصابعه",32,"ع",2,1],["ذا دوا الكئب وأعرضوا عَن وصله","فهم بالبان التقاطع قد غذوا",33,"ذ",3,0],["ذاد الكرى عن مقلتيَّ خيالُكُم","فالنوم أقلع والسهاد مخيم",34,"م",1,0],["ذا دهرُ افريقيّة","أضحى بهم مُعتدلا",35,"ل",2,0],["ذادة قادة نمتهم رجال","من كرام العناصر العامليه",36,"ي",2,0],["ذا دره لم أزل أفوه به","منتظماً تارةً ومنتثرا",37,"ر",2,0],["ذا درة العلم فذر","سواه يا من اتجر",38,"ر",1,0],["ذا داؤُك الزَّمنُ العُقا","مُ فلا سبيلَ إلى دَوائِك",39,"ك",1,0],["ذاد عن أوطانه ثم افتدى","دوحة المجد بغصن مزهر",40,"ر",1,0],["ذا دعائي وصلته بثنائي","ومناي انتظمتها في نظام",41,"م",1,0],["ذَادَ الكَرَى عَنْ جُفُوني طَائِفٌ وَثبَا","مِنْ غَيْرِ مَا مَوْعِدٍ أَوْ حَاجَةٍ وَجَبَا",42,"ب",2,1],["ذادَهُ لِلْمَوْتِ دَهْرٌ ذائِدٌ","فَتَمادَى زَمَناً ثُمَّ وَفَدْ",43,"د",1,0],["ذا دأبُهُ قدٓري يسوقُ متاهتي","ويٓسيلُ نهرُ الحُزْنِ منْ دمعاتي",44,"ت",2,0]]}