{"poems":[[93,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[93,"ملك العراق تجلة وسلام","https://www.aldiwan.net/poem11313.html","الكامل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[54,"ما أكثر الناس لا بل ما أقلهم","https://www.aldiwan.net/poem27602.html","البسيط"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"وقينة أبرد من ثلجه","https://www.aldiwan.net/poem9259.html","السريع"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[91,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[70,"حتى متى وإلى متى","https://www.aldiwan.net/poem42433.html","مجزوء الكامل"],[70,"يا معرضا متجنبا","https://www.aldiwan.net/poem42698.html","مجزوء الكامل"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[89,"لاقى اسامة وهو الضيغم الضاري","https://www.aldiwan.net/poem44740.html","البسيط"],[89,"لهفي على الحر الموس","https://www.aldiwan.net/poem44925.html","مجزوء الكامل"],[45,"طيف الحبيب ألم من عدوائه","https://www.aldiwan.net/poem10198.html","الكامل"],[49,"الحمد لله على ما نرى","https://www.aldiwan.net/poem10323.html","السريع"],[97,"أبي أخي كعبة آمالنا","https://www.aldiwan.net/poem24966.html","السريع"],[31,"ما اكتحلت مقلة برؤيتحا","https://www.aldiwan.net/poem42555.html","المنسرح"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[105,"من يسعد الأوطان غير بنيها","https://www.aldiwan.net/poem43401.html","الكامل"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[105,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[105,"ما الكيد ما الغدر ما هذي الأباطيل","https://www.aldiwan.net/poem44204.html","البسيط"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[105,"وضح اليقين لمن يرى أو يسمع","https://www.aldiwan.net/poem44221.html","الكامل"],[67,"ما أكلنا في ذا الصيام كنافه","https://www.aldiwan.net/poem18075.html","الخفيف"],[75,"يا ذا البديهة في المقال أما كفت","https://www.aldiwan.net/poem69033.html","الكامل"],[46,"النفس في العالم العلوي مركزها","https://www.aldiwan.net/poem22943.html","البسيط"],[46,"ما أكرم الله عز من ملك","https://www.aldiwan.net/poem23418.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85352","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55028","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[184,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[268,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[268,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[364,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[369,"وقد التقينا بعد ذاك","https://www.aldiwan.net/poem57288.html","مجزوء الكامل"],[400,"مهجة طول التنائي قد براها","https://www.aldiwan.net/poem33362.html","الرمل"],[438,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[441,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[456,"يا دار لهوي بالنجيل من قطن","https://www.aldiwan.net/poem55854.html","الرجز"],[456,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[456,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[456,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[560,"لمن الخيام ومن هنالك نازل","https://www.aldiwan.net/poem52901.html","الكامل"]],"verses":[["مَا أَكْرَمَ الدِّينَ عَلَى أَهْلِهِ","إِذَا الْتَقَى فِيهِ التُّقَى وَالْهُيَامْ",0,"م",1,0],["مَا أَكْبَرَ الأَمْرَ الَّذِي تُرْجَى لَهُ","فَاكْبَرْ وَلِلعِزِّ المَتِينِ دَوَامُ",1,"م",1,0],["مَا أَكْرَمَ الشورَى عَلَى مَلِكٍ يَرَى","أَلاَّ يَسُوقَ الشَّعْبَ سَوْقَ سَوَامِ",2,"م",1,0],["ما أَكثَرَ الناسَ لا بَل ما أَقَلَّهُمُ","اللَهُ يَعلَمُ أَنّي لَم أَقُل فَنَدا",3,"د",2,1],["ما أكتم القلب لتبريحه","وقد توارت منه نيرانه",4,"ن",2,0],["ما اكتستْ شَيْبَةً سوى نظمِها الدُّر","رَ على رأسها البَهيمِ الغرابي",5,"ب",2,0],["ما أكذبَ المطِنبَ في وصفها","لا صَدَّق الله له لهجَهْ",6,"ج",2,0],["ما اكتسى مَلْبس شينٍ","لا ولا ملبس عار",7,"ر",1,0],["ما أكرمَ البيهقي من رجلٍ","كم من نديم له ومن غاش",8,"ش",1,0],["ما أَكرَمَ الأَشجارِ في هَذا الحِمى","فيها لِقاصِدِها البَشاشَة وَالقِرى",9,"ر",2,0],["ما أَكمَلَ السِتّينَ حَت","تى ذاقَ طَعمَ الفُرقَتَينِ",10,"ن",1,0],["ما أَكثَرَ العُذّالَ في","وَلَهي عَلَيكَ وَفي غَرامي",11,"م",2,0],["ما اكثر العطشى على","منهله تزدحم",12,"م",1,0],["ما اكثر الدمع الذي","له من العين انسكب",13,"ب",1,0],["ما اكثر الوحش في الآجام واغلة","وما بها كل ذي ناب بمغوار",14,"ر",1,0],["ما أكبر النفس التي","في ذلك لجسد النحيف",15,"ف",1,0],["ما أَكثَرَ الآمالَ عِندي وَالمُنى","إِلّا دِفاعُ اللَهِ عَن حَوبائِهِ",16,"ا",3,0],["ما أَكرَمَ الصَبرَ وَما أَحسَنَ ال","صِدقَ وَما أَزيَنَهُ بِالفَتى",17,"ا",1,0],["ما أكرم الخلق وأسماه","وأعذب الطبع وأصفاه",18,"ا",2,0],["ما اِكتَحَلَت مُقلَةٌ بِرُؤيَتِحا","فَمَسَّها الدَهرَ بَعدَها رَمَدُ",19,"د",1,1],["ما أكرمَ الشُّهداءَ طَاحَ بشيخِهم","قَومٌ لهم في الظُّلم شَيْخٌ أَشْأمُ",20,"م",1,0],["ما أكثرَ الأبطالَ إلا أنّهم","أبطالُ وَهْمٍ في سلاحِ كلامِ",21,"م",1,0],["ما أَكثَرَ المُتَفاخِرينَ وَإِنَّما","فَخرُ الكِرامِ بِما حَبَت أَيديها",22,"ي",3,0],["ما أكرم الأنصارَ والصَّحْبَ الأُلى","حُرِمُوا فَمِن صَبرٍ ومن إغضاءِ",23,"ا",2,0],["ما أكذَبَ الأحزابَ يوم تعاهدوا","أن لا يبالوا الصادقَ المعصوما",24,"م",2,0],["ما أكذبَ ابنَ أُبيٍّ إذ يقولُ لكم","لا تتّقوا القومَ إنّ النصرَ مكفول",25,"ل",1,0],["ما أكرمَ الأبطالَ يَومَ تَفيَّأوا","ظُلَل المنايا يبتغون جَناها",26,"ا",3,0],["ما أكثرَ الباكِينَ مِلءَ جُفونهم","للجمعِ بالبيضِ البَواتر يُصدَعُ",27,"ع",1,0],["ما أكلنا في ذا الصِّيامِ كُنافَه","آهِ وابُعْدَها علينا مسافَه",28,"ف",2,1],["ما أكثرَ الأسْماءَ حِينَ أعُدُّهَا","من ماجِدٍ وسَمَيْذَعٍ وهُمام",29,"م",1,0],["ما أَكثَرَ الوَرَعَ المَزؤودَ مِن جُبُنٍ","فينا وَإِن قَلَّ في أَشياعِنا الوَرَعُ",30,"ع",1,0],["ما أَكرَمَ اللَهَ عَزَّ مِن مَلِكٍ","وَرِزقُنا مِن دَلائِلِ الكَرَمِ",31,"م",1,1],["ما أَكثر الإنسان حر","صاً وَهْوَ يشبعه الرَغيف",32,"ف",1,0],["ما أكبر الحزن في قلب امرئٍ كلف","شطت بمن هُوَ يَهواهم نوى قذف",33,"ف",1,0],["ما أكثر ما اخترعت يده","إن الإنسان ليقتدر",34,"ر",1,0],["ما أَكثر الأشياع للنعش الَّذي","نَقلوه محمولاً عَلى الأكتاف",35,"ف",1,0],["ما أَكثر الأوهام جا","ءتنا من العُصُرِ الخوالي",36,"ي",1,0],["مَا أكْرَمَ الصِّلةَ الَّتِي جَمَعَتْهُمَا","وَقوَامُهَا كَلِفٌ بِغيْرِ تكلَّفِ",37,"ف",1,0],["مَا أَكْرَبَتْ تَبدو بِآفَاقِهَا","نجُومُ نَحْسٍ شَرُّهَا مُسْعَرُ",38,"ر",1,0],["مَا أَكْرَمَ النَّسَبَيْنِ حَينَ الْمُلْتَقَى","وَهُمَا مآثِرُ تَلْتقِي بِمَآثِرِ",39,"ر",1,0],["مَا أَكْلَفَ الإِنْسَانَ","بِالبَقَاءِ حَتَّى فِي خَبَرْ",40,"ر",1,0],["ما أكره الشيب إلاأنه سببٌ","إلى صدود الغواني فهو مصدود",41,"د",1,0],["ما اِكتَفت بالجلوسِ في الحجرِ حتّى","ضمّه مِن حنوّها الأحشاءُ",42,"ا",2,0],["ما أكثرَ الهمَّ في الدنيا الغرورِ فكم","دَعا المنيَّةَ مَن بَلواهُ تَصرَعه",43,"ع",2,0],["ما أكذب الناس في التقوى وأخبثهم","فهم مراؤون كالذؤبان والعُبُد",44,"د",1,0],["ما أَكثَرَ الإِطرابَ بِالبُعدِ الَّذي","يُزري بِهَمِّ كُثَيِّرٍ مِن عَزَّةِ",45,"ه",1,0],["ما أكتَفي بنداكَ يا","عَبدَ المَسيحِ فكُن كَفافَه",46,"ف",2,0],["ما اكتحلت النوم من بعدهم","ليتني كحلت عيني بثراها",47,"ا",3,0],["ما أكذب الطيف لولا طيب زورته","لمن تحب ولا طيف به صدقا",48,"ق",2,0],["ما أكثر الأدعياء إن سئلوا","وما أقل المجيب بالصدق",49,"ق",1,0],["ما أكثرَ الشاكين من دنياهُمُ","فليت شعري هذه الدنيا لمَنْ",50,"ن",1,0],["ما أكثر الودَّ وإن","صحّ فما أقلَّهْ",51,"ل",2,0],["ما أكثرَ المُنحِي على مجده","لبُلغةٍ تُرجَى ورزقٍ يُفادْ",52,"د",1,0],["ما أكثرَ الناسَ وما أقلَّهم","وما أقلَّ في القليل النُّجبَا",53,"ب",2,0],["ما أكثَرَ الشُّعرَاءَ حينَ تَعُدُّهم","سَرْداً ولكنَّ الفُحولَ قلائلُ",54,"ل",1,0]]}