{"poems":[[55,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[88,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[53,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[99,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[99,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[50,"الدار أطبق إخراس على فيها","https://www.aldiwan.net/poem66195.html","البسيط"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39557","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[409,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[422,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[463,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[463,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[463,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[482,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[580,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53722","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48541","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70909","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56593","الخفيف"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18483","البسيط"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124020","البسيط"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17653","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53039","الرجز"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33008","البسيط"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143083","الكامل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124715","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130751","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83214","المتدارك"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115593","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132595","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132616","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48304","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[4690,"لَحَظاتٌ مَسْروقَة","https://www.poetsgate.com/ViewPoem.aspx?id=186152",""],[4691,"حجم قهري","https://www.poetsgate.com/ViewPoem.aspx?id=85442",""],[4755,"تَجْتَاحُنِيْ فِيْ هَذِهِ الآوِنَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=184716",""],[4983,"يا مالكا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=11017",""],[5002,"نيروز الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=204940",""],[5121,"لآلِئ","https://www.poetsgate.com/ViewPoem.aspx?id=215130",""],[5183,"نحن","https://www.poetsgate.com/ViewPoem.aspx?id=180151",""],[5254,"من سدرة البوح","https://www.poetsgate.com/ViewPoem.aspx?id=207981",""],[5277,"عينٌ على الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=200564",""],[5277,"وجعُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=200927",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[5324,"يامظهر الوجه الضحك.","https://www.poetsgate.com/ViewPoem.aspx?id=211079",""],[5368,"يا ساكناً قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184313",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5431,"ومضغة القلب في الأفواه تفاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186050",""],[5431,"لم تروها شفتي...","https://www.poetsgate.com/ViewPoem.aspx?id=190639",""],[5452,"القِبلة المستديرة","https://www.poetsgate.com/ViewPoem.aspx?id=119011",""],[5470,"سديم التداني","https://www.poetsgate.com/ViewPoem.aspx?id=11241",""],[5490,"غفلة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=176296",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5720,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=202925",""],[5725,"ونعيم ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=194801",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[5906,"غدا يشيّعنا التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=193749",""],[5943,"هتَّانُ ياقلمَ الفسادِ","https://www.poetsgate.com/ViewPoem.aspx?id=37442",""],[1920,"حمى تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=192008",""],[5956,"أودَى شقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=192798",""],[5956,"ذكرى حبي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=196838",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""],[6004,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=33680",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""],[6128,"‏اركب مَعي","https://www.poetsgate.com/ViewPoem.aspx?id=212857",""]],"verses":[["تَجتَرُّ وَدقاً وَتَرغو مِن جَوانِبِها","رَعداً إِذا قيلَ قَد هَمَّت بِإِقلاعِ",0,"ع",1,0],["تَجتازُنا عَبقَةٌ مِن رَوضَةٍ أُنُفٍ","إِذا أَلَمَّت بِنا ذِكرى سُلَيمانِ",1,"ن",1,0],["تَجتافُ أَصلاً قالِصاً مُتَنَبِّذاً","بِعُجوبِ أَنقاءٍ يَميلُ هُيامُها",2,"م",3,0],["تُجتَلى في غُمَّةِ الكفْر كما","يُجتلى في ظُلمةِ الليل العَمودُ",3,"د",1,0],["تجتلي خلقها فتلقَى قواماً","خيزراناً وصِبْغةً أرجوانا",4,"ن",2,0],["تجتازُ عابرةٌ ويسرعُ عابر","وتمرُّ أشباحٌ يواريها الدُجَى",5,"ج",2,0],["تجتاز وامضة فمذ وثبت","وثب الهوى وتمهّل القدر",6,"ر",1,0],["تَجتَني ثامِرَ جُدّادِهِ","مِن فُرادى بَرَمٍ أَو تُؤام",7,"م",1,0],["تَجتابُ أَغبَرَ تَفتَنُّ الرِياحُ بِهِ","صَبّاً جَنوباً تُهامِيّاً شَآميها",8,"ي",3,0],["تَجتابُ أَرضاً إِلى أَرضٍ بِذي زَجَلٍ","ماضٍ عَلى الهَولِ هادٍ غَيرِ مِحيارِ",9,"ر",1,0],["تجتلي ريشة المصوّرِ منه","كلَّ عذراءَ لا ترُدُّ بنانَه",10,"ن",2,0],["تَجْتَازُ مِن خَطَرٍ إِلى خَطَرٍ","وَتَذُودُ عَنْ يُمْنَى وَعَنْ يُسْرَى",11,"ر",2,0],["تَجْتَلِيكَ النُّفوسُ طَالِعَ سَعْدٍ","وَتَرَاكَ الْعُيُونُ لَمْحَ رَجَاءِ",12,"ا",2,0],["تَجْتَلِيِه العُيُونُ مُسْتَبْشراتٍ","وبَرِيقُ السُّرور فيها وماؤُه",13,"ا",3,0],["تَجْتَلِيه العُيونُ بَدْراً وتفْدِيهِ","عُيونُ الزَّمانِ بالحَدَقاتِ",14,"ت",1,0],["تَجتَلي ظُلمَةَ الحِباءِ كَما","يَنكَشِفُ الصُبحُ عَن مَهاةِ الصَريمِ",15,"م",1,0],["تجتني طيب المعاني منها","ثم تسبي بها العقول الزكيه",16,"ي",2,0],["تجتلي قَرماً إماماً بالنَّدى","بأَبي ذيَّالك القرم الإِماما",17,"م",2,0],["تجتمع الأضدادُ حينا ولا","يجتمع الشاكي بها والرحيمْ",18,"م",1,0],["تجتاب بي أجواز كلِّ تنوفة","عذراءَ ما وُطئتْ وخَرقٍ أعجمِ",19,"م",1,0],["تجتليك الأبصارُ بدراً مكانَ ال","تاج منه عِمامةٌ كالهالَهْ",20,"ل",2,0],["تجتابُ أربَعُها الوهادَ وطرفُها","بالراسياتِ موكَّلُ الإشغالِ",21,"ل",1,0],["تجتابُ خرقاً بالرياحِ مُخَرَّقاً","ويبيدُ بيداً سيرُها وفيافيا",22,"ي",2,0],["تجْتَني النَّصْر من ظُباكَ كأَنَّ ال","غَضْبَ قد صحَّفوه أَو صَار غُصنا",23,"ن",2,0],["تَجتلي من وجهه ذهباً","وهو يجلو فضةً فتكتْ",24,"ت",1,0],["تجتنب الذي أمَلْ","لُه ومنه أنفر",25,"ر",1,0],["تجتذبْهنُّ كلهن بلا شكٍّ","وتبلغْ مرادَك المستطابا",26,"ب",2,0],["تجتليك الآمال لا بعيون","إنما تجتليك بالأفهام",27,"م",1,0],["تجتازُهنَّ وقد خفت ثميلتُها","وطالَ فضلُ قصيرِ النسعِ فاضطَرَبا",28,"ب",2,0],["تجتاب بيدا عريضات وتسلمُها","أثباج بيد عريضات لاثباج",29,"ج",1,0],["تَجتابُ كُلَّ مَطاً ناءٍ مَسافَتُهُ","وَمَهمَهٍ ما بِهِ حَبسٌ لِمَن حَبَسا",30,"س",2,0],["تجتلي النجم في الحدوج وهل أب","صرت نجماً من الحدوج اجتلاها",31,"ا",3,0],["تجْتَني زهرَ روضةِ المجدِ ما قه","قَهَ رعدٌ وانهلَّ وَبْلُ السحاب",32,"ب",1,0],["تجتنب الأحداث ما لا تشتهي","وتسرع الأقدار فيما تطلب",33,"ب",1,0],["تَجتابُ أَودِيَةَ الأَفزاعِ آمِنَةً","كَأَنَّها أُسُدٌ تَقتادُها أُسُدُ",34,"د",1,0],["تجتاب أبواب الخمول، فقلت عن","كره ولست بجاهل راضيها",35,"ي",3,0],["تجتلي العين منهمو صور الأن","وهم من هوامل الأنعامِ",36,"م",1,0],["تجتليها واسمعيها ان شدت","وانظري في وجهها لما اعتدت",37,"ت",1,0],["تَجتازُ بِنَهضَتِها سُبُلاً","حُفَّت بِمَصاعِبَ لِلوَطَنِ",38,"ن",1,0],["تجتلى النفسُ دائماً من عذارَي","هِ وصدغَيهِ جنّةً وحريرا",39,"ر",2,0],["تجتلي العين فيه بدر جمال","طالع الصب في هواه سعيد",40,"د",1,0],["تجتلي وجهه العيون فيغدو","في معانيه بالقلوب مصور",41,"ر",1,0],["تجتاح أرواح الشقاء ديارها","وتجوس أشباح الفناء خلالها",42,"ل",3,0],["تُجْتَلى في البلادِ غرْباً وشرقاً","فتُباهِي الكواكبَ السّيارَهْ",43,"ر",2,0],["تجتلي العين منه أبهى مرأىً","هو أشهى للنفس من أن يملا",44,"ل",2,0],["تَجْتاحُني تَرْتاحُ بي","تَنْثالُ كالبُشرى نَبِيّةْ",45,"ي",2,0],["تجتثه خطراتي","تكويه نيران صدري",46,"ر",2,0],["تَجْتَاحُنِيْ فِيْ هَذِهِ الآوِنَهْ","قَصِيْدَةٌ هَاءَاتُهَا سَاكِنَهْ",47,"ن",2,1],["تجتاحني الأشواق تشعل مهجتي","ويظن قلبك معلنا بجفاك",48,"ك",1,0],["تجتاحنا رندا","نحيا بها أنساما",49,"م",2,0],["تَجْتَاحُكَ الأَشْعَارُ مِنْ عُمْقِ الْمَدَى","وَيْ إِنَّ حَرْفَكَ فِي السَّمَا مِغْوَارُ",50,"ر",1,0],["تجتليه فينا لتغرس منا","شتلات تشب في الأحضان",51,"ن",1,0],["تجتاحني طهرا توضأ بالجوى","حيرى أنا آلجسمُ لي والظلُ لكْ",52,"ك",1,0],["تجتاحني من بقايا الأمس قاتلتي","وقدْ تناثرَ حولَ القلبِ مصرعُهُ",53,"ع",2,0],["تجتاحُنا الذكرى وصفحةُ أمسِنا","وحنينُنا مثلَ النّدى ينسابُ",54,"ب",1,0],["تجتني الخير في دناك وتمضي","باجتهاد في فلكه الكل غنى",55,"ن",2,0],["تجترّ ما نهب الزّمانُ بحسرة","وتشاء لو رجع الزّمان مجدّدا",56,"د",2,0],["تَجْتاحني أنَّاتُ مَنْ راحُوا","والدَّمْعُ فاضَ ومُقْلَتِي مَرْتَعْ",57,"ع",1,0],["تجتاحه الحَسَرات حارقةً","ما لم يَصُنْهُ المالُ والظَفَرُ",58,"ر",1,0],["تجتاح قلبي كالطوفان تغرقه","ومضغة القلب في الأفواه تفاحُ",59,"ح",1,0],["تجتاحني بهوى في الجوف مشتعلٌ","جحافلٌ بدمي والحربُ في لغتي",60,"ت",2,0],["تجتثّ إسرائيل تقتل عارنا","ستّون عاما عمرنا والعارُ",61,"ر",1,0],["تَجتَدِي الرِّيحُ مَوسِمًا مِن سَمُومٍ","والرَّيَاحينُ يَرتَوِيهَا الذُّبُولُ",62,"ل",1,0],["تجتاحُنا لججُ الإحساس مجمرةً","بين الجفون وفي أضلاعنا حممُ",63,"م",1,0],["تجتاحُني اللَّكماتُ منْ هُمْ؟ ليسَ لي","صحْبٌ فأعْلَمُهُمْ ، كذوبٌ تعْلَمُ",64,"م",1,0],["تجتاحني في كل يومٍ حَيْرَةٌ","وتهزّني كالوحشِ حينَ يُكاسِرُ",65,"ر",1,0],["تجتاحني نارا يدب حسيسها","فكأن حبات الدموع هشيمُ",66,"م",1,0],["تَجتَرُّني الآلامُ تُوقِدُ صَحوتي","فَتَثُورُ فيَّ مَشَاهِدٌ تتمرّدُ",67,"د",1,0],["تَجتاَحُها الأمطارُ عندَ مَسيلِها","ويَلُوكُها بَردٌ بَدا يَتَوَعََّدُ",67,"د",1,0],["تَجتاحُنا وَقتُ الظَّهيرةِ عِزَّةٌ","وَ تَحيدُ عَنّا إذ يَحِلُّ مَساءُ",68,"ا",2,0],["تجتازُ أصعبَ مسلكِ بنعومةٍ","لتُقِيدَ نارًا زادُها الثقلانِ",69,"ن",1,0],["تجتاحني بصقيعها ولهيبها","فأكاد من لهب الصقيع أموتُ",70,"ت",1,0],["تجتاحني الذكرَى بفرْيٍ فاتكٍ","بمشاعري، والدمع مِنِّي ينتجُ",71,"ج",1,0],["تجتاحني الذكرى وعقلي ذاهلٌ","والقلب ينبض تائقاً ميؤوسا",72,"س",2,0],["تجترّ ذكراه متى ما احتجتَه","فيكونُ عونَك وقتَ كلِّ مسيرِ..",73,"ر",1,0],["تَجْتَاْحُ قَلْبيِ الأمَاْنِي ، ثُمّ تَسْبِقُنِي","تَعدُوْ قِبِالِي بِِطََيْفٍ ، لاْ يُفَاْرِقُنِيْ",74,"ن",2,0],["تَجتَلي العينُ منهُمُ صُوَرَ الأُنْ","سِ وهم من هَوَامِلِ الأنْعَامِ",75,"م",1,0],["تَجتاحُني الأشياءُ ضِمْن مَشاهدٍ","ومُشاهدٌ قلبي لأشْياء دقيقةْ",76,"ق",2,0]]}