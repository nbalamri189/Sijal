{"poems":[[65,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[87,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[52,"ما أنت يا كردي بالهش","https://www.aldiwan.net/poem62357.html","السريع"],[111,"ماذا تريد من الدنيا تعنيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66822&r=&rc=1",""],[87,"تاجَ البلادِ، تحية ٌ وسلامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9638&r=&rc=128",""],[458,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[469,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48689","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143011","الخفيف"],[2660,"","https://poetry.dctabudhabi.ae/diwan/poem/203351","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127395","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109854","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128892","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131030",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36595","الدوبيت"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4927,"الْفَتَاْةُ الْمُكَاْفِحَة","https://www.poetsgate.com/ViewPoem.aspx?id=29949",""],[5002,"هلال وحدتنا...","https://www.poetsgate.com/ViewPoem.aspx?id=206180",""],[307,"هلْ زجّ في الأملِ القنوطُ سقاما","https://www.poetsgate.com/ViewPoem.aspx?id=213805",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5956,"الهوى الملغوم بين الإنسان والحيوان","https://www.poetsgate.com/ViewPoem.aspx?id=183425",""],[5956,"الهواء لفح جيد فراس","https://www.poetsgate.com/ViewPoem.aspx?id=193304",""],[6019,"ما لي أراني","https://www.poetsgate.com/ViewPoem.aspx?id=176718",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["لم تَهجُرِ الأغمادَ إلاّ رَيْثَما","تَعرى لِتُغْمَدَ في طُلَى الأعداءِ",0,"ا",2,0],["لم تهجُهُم إلا لكي","تهجي فتُذكَرَ في عِصابهْ",1,"ب",2,0],["لَمَّتهُ مِن لَهَبِ الحَريقِ أَنامِلٌ","بَردٌ عَلى ما لامَسَت وَسَلامُ",2,"م",1,0],["لَمْ تُهَذِّبْهُ كلُّ قاصِرَةِ الطَّر","فِ أَجَادَتْ بأَخْدَعَيْهِ القصارَهْ",3,"ر",2,0],["لَم تُهدِنا نَعلاً وَلا خاتَماً","مِن أَينَ أَقبَلتَ مِنَ الحَشِّ",4,"ش",1,0],["لم تهدء الدور من نوح وصارخة","ولا المقابر من مستودع فيها",5,"ي",3,0],["لمَّتهُ من لهبِ الحريق أنامٌ","بَرْدٌ على ما لامَسَتْ، وسَلام",6,"م",1,0],["لم تُهَّدمهُ ولكن أشبعت","عَقلهُ فهماً وحزماً ومضاء",7,"ا",2,0],["لم تهمِ سحب الدمع بعد جمودهِ","إلاَّ وقلبي البرقُ في الخفقان",8,"ن",1,0],["لم تُهدِ طنفسة إليَّ وإنما","أهديت تاجاً غالياً وسريرا",9,"ر",2,0],["لم تهد حيرانَ يا طيفَ الخيال ويا","ماءَ الصّبابة ما أَرويتَ حَرّانا",10,"ن",2,0],["لَم تَهبَني حَوادِثُ الدَهرِ إِلّا","مُذ تَعَلَّقتُ مِن حِبالِكَ حَبلا",11,"ل",2,0],["لم تهن عندها النفوس وكانت","في سواها تكابد الاذلالا",12,"ل",2,0],["لم تهز العطف منه طربا","عندما يسمع منه وترا",13,"ر",2,0],["لم تهلك اليابان وال","ألمان عنا والخصوم",14,"م",1,0],["لم تهبني من يوسف عفة الق","لب ولا الصبر فيه من ايوب",15,"ب",1,0],["لم تهجرني واني","ما عشت فيك متيم",16,"م",1,0],["لم تهدهم لمعات من صوارمنا","بهن كانت حواشي الليل تتسم",17,"م",1,0],["لم تهنه غضاضة الشباب","لما تصدى لي بالسباب",18,"ب",1,0],["لَم تُهدِ رُوَيحَةُ الصَبا رَيّاكِ","إِلّا وَلِهَ الفُؤادُ مِن ذِكراكِ",19,"ك",1,1],["لِمَّتُه أَم أَرقمٌ هائِجٌ","ذا سائِف طوراً وذا نابل",20,"ل",1,0],["لَمْ تَهَبْ جَيْشاً لَئِيْماً غَاْدِراً","يَقْذِفُ التَّدْمِيْرَ مِنْ ذَاْتِ الْجَنَاْحْ",21,"ح",1,0],["لم تُهزم ِالعرب والإسلام قائدنا","محمد هيأ الفرسان في رجل",22,"ل",1,0],["لم تهفُ عنّا النائباتُ لأنّنا","لم نخش في فكّ الهُمامِ حِماما",23,"م",2,0],["[ لَمْ تُهْدِ يَوْمَ الوَغَى غاراتُ عَسْكَرِهِ","إِلَى الأَعادِي سِوَى بُؤْسٍ وَآجالِ ]",24,"ل",1,0],["لم تهبْني قط ما","أرجوهُ أو أبغي وصولَهْ",25,"ل",2,0],["لِمَ تهربون وإنني أهواكمو","أو ما يفيدكُمُ الهوى الملغومُ ؟",26,"م",1,1],["لم تهدإِ الأدواءُ والدعواتُ عن","تحسينه، والحمدُ.. أصبح أحسنا",27,"ن",2,0],["لَم تَهمِسِ الكلماتُ - حينَ هوانِهِ -","إلا بحرفٍ لاهِبٍ يَتَوسَّدُهْ",28,"د",2,0],["لم تهجري طوعاً – كُفيتِ – وإنّما","تُقصيكِ سطوةُ غاصبٍ وتَحُولُ",29,"ل",1,0]]}