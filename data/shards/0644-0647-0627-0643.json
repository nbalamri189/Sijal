{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[36,"إذا عبتها شبهتها البدر طالعا","https://www.aldiwan.net/poem4893.html","الطويل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[9,"صحا القلب من ذكرى قتيلة بعدما","https://www.aldiwan.net/poem21967.html","الطويل"],[32,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[32,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[53,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[93,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[63,"سوداء لم تنتسب لحام","https://www.aldiwan.net/poem51456.html","مخلع البسيط"],[63,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[63,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[53,"صفا لك شِربُ العيشِ غيرَ مُثَرَّبِ","https://www.poetsgate.com/ViewPoem.aspx?id=27037",""],[53,"ألا قُل لنحويِّك الأخفش","https://www.poetsgate.com/ViewPoem.aspx?id=29398",""],[41,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[136,"أحاجيكم ما لحية غير كثة","https://www.aldiwan.net/poem54873.html","الطويل"],[146,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[168,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[173,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[186,"حياة أسر العيش فيها مذمم","https://www.aldiwan.net/poem67033.html","الطويل"],[228,"كعاب أتت في الحسن فخر الكواعب","https://www.aldiwan.net/poem41907.html","الطويل"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[409,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[412,"تراءت لنا حوراء في صورة الإنس","https://www.aldiwan.net/poem50152.html","الطويل"],[427,"أدرها لنا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[544,"مهفهفة الكشحين محطوطة المطا","https://www.aldiwan.net/poem2047.html","الطويل"],[563,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"],[563,"ألا يا لقومي من غزالة وجرة","https://www.aldiwan.net/poem34924.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83264","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83334","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122374","الرجز"],[1159,"","https://poetry.dctabudhabi.ae/diwan/poem/205986","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31582","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79910","المتقارب"],[1893,"","https://poetry.dctabudhabi.ae/diwan/poem/146600","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71084","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132373","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204576",""],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102384","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34592","المتقارب"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35483","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136931",""],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139633",""],[4830,"أتلو جمالَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=206865",""],[4884,"فردوس بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=210403",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5582,"خَيالٌ سَرَى وَهْناً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=63489",""]],"verses":[["لَها كُلَّ يَومٍ مَوقِفٌ مَع مُوَدِّعٍ","وَمُلتَفِتٍ في عَقبِ ماضٍ مُفارِقِ",0,"ق",1,0],["لَها كَفَلٌ يَرتَجُّ مِنها إِذا مَشَت","وَمَتنٌ كَغِصنِ البانِ مُضطَمِّرُ الخَصرِ",1,"ر",1,0],["لَهُ أَكاليلُ بِالياقوتِ زَيَّنَها","صُوّاغُها لا تَرى عَيباً وَلا طَبَعا",2,"ع",2,0],["لَها كَبِدٌ مَلساءُ ذاتُ أَسِرَّةٍ","وَنَحرٌ كَفاثورِ الصَريفِ المُمَثَّلِ",3,"ل",1,0],["لَها كُلُّ مَشبوحِ الذِراعَينِ تُتَّقى","بِهِ الحَربُ شَعشاعٍ وَأَبيَضَ فَدغَمِ",4,"م",1,0],["لَها كَفَلٌ كَالعانِكِ اِستَنَّ فَوقَهُ","أَهاضيبُ لَبَّدنَ الهَذاليلَ نُضَّحُ",5,"ح",1,0],["لها كلُّ سلطانٍ على قلبِ أمردٍ","ولم تعطُ سلطاناً على قلب أشيبِ",6,"ب",1,0],["لَها كُلَّ يَومٍ بينَنا حُكُمُ جائِرٍ","وَإِقدامُ مَوتورٍ وَفَتكَةُ ثائِرِ",7,"ر",1,0],["لها كلامٌ إذا تَناهَت","غيرُ فصيحٍ من الكَلامِ",8,"م",1,0],["لها كَرٌّ مَحا الأوضاحَ منها","وخاطَ من العَجاجِ لها جِلالا",9,"ل",2,0],["لها كالئ يُذكي اللِّحاظَ خِلالَها","حَذاراً عليها من سِخاطِ النوائبِ",10,"ب",1,0],["لَها كُلَّما ريعَت صَداةٌ وَرَكدَةٌ","بِمُصدانِ أَعلى اِبنَي شَمامِ القَوائِنِ",11,"ن",1,0],["لَها كَضَواةِ النابِ شُدَّت بِلا عُرىً","وَلا خَرزِ كَفِّ بَينَ نَحرٍ وَمَذبَحِ",12,"ح",1,0],["لَها كَبِدٌ مَلساءُ ذاتُ أَسِرَّةٍ","وَكَشحانِ لَم يَنقُض طِوائُهُما الحَبَل",13,"ل",1,0],["لها كلُّ سلطانٍ على قلبِ أمردٍ","لم تُعط سلطاناً على قلب أشيبِ",14,"ب",1,0],["لها كلّ يومٍ إلى فاسقٍ","حَنينُ قطامٍ إلى جَحْوش",15,"ش",1,0],["لهَا كلَّما ريعَتْ صداة ٌ وركدة","ٌ بمصدانِ أعلى ابنَيْ شمامِ البوائنِ",16,"ن",1,0],["لها كُرُباتٌ في القلوب مُرِبَّةٌ","فياليتها قد فًرِّجت كُربَاتُهَا",17,"ت",3,0],["لها كلَّ يوم بنا وقعةٌ","فهلاَّ تناوبَ عامٌ وعامُ",18,"م",1,0],["لَها كُلَّ يَومٍ في حِمى المَجدِ وَطَأَة","تَظَلُّ لَها أَسبابُهُ تَتَجذَّمُ",19,"م",1,0],["لَها كُلَّ يَومٍ مِنهُ شَعواءُ لا تَني","تَؤُزُّ نَواحيها وَجَيشٌ عَرَمرَمُ",20,"م",1,0],["لَها كُلّ يَومِ بَيننا كُلّ مُنذِرٍ","يُنادي عَلينا مُسمِعاً وَهوَ أَبكمُ",21,"م",1,0],["لَها كَوكَبٌ في كُلِّ عينٍ منوِّرٌ","يُفاخِرُ بِالأَنوارِ كلّ الكَواكِبِ",22,"ب",1,0],["لها كَلامٌ تَخُلُّ القَلبَ بَهجَتُهُ","كَأَنُّهُ زَهوُ نَخلٍ مِنهُ يُختَرَفُ",23,"ف",1,0],["لَها كاهِلٌ مِثلُ الغَبيطِ مُؤَرَّبٌ","وَأَتلَعُ مَصفوحُ العَلابي عَشَنَّقُ",24,"ق",1,0],["لها كل يوم غارة بعد غارة","تفرق ما بين المحبين والحب",25,"ب",1,0],["لَها كُلُّ يَومٍ حُلَّة مستجِدَّةً","مِنَ الحُسنِ تُنسي صورَةَ الحُسنِ بِالأَمسِ",26,"س",1,0],["لها كل روح تعرف العهد عهدها","وفي كل قلب جاهل للسوى معنى",27,"ن",2,0],["لها كلَّ يومٍ نَشطةٌ وعِقالُ","وفي كلّ دار حلّةٌ وزِيالُ",28,"ل",1,1],["لها كلّ عامٍ من سماحك ناهزٌ","ومن عهدك الوافي رِشاءٌ وماتحُ",29,"ح",1,0],["لها كلُّ صوتٍ كلُّ راويه مُبلغٌ","فصيحٌ ومَن غنَّى به فهو مُطرِبُ",30,"ب",1,0],["لها كنتُ أستبقي الحياةَ وأحتمي","وأجمعُ بُرْدِي من أكفِّ الجواذبِ",31,"ب",1,0],["لها كلّ يومٍ ناشدٌ غير واحدٍ","تَقَفَّى المُنَى آثارَها فيُخيبُها",32,"ب",3,0],["لَها كفلٌ كالدعصِ لبّده الندى","وَثغرٌ نقيٌّ كالأقاحي المنوَّرِ",33,"ر",1,0],["لها كرم لا منتهى لعداده","به زاد في تقصيره من يبالغ",34,"غ",1,0],["لها كل حسن في البرية ينتمي","بذلت لها روحي وجسمي مرتمي",35,"ي",1,0],["لَها كُلُّ آنٍ في البَرِيَّةِ مَظهَرٌ","يُخبِرُ أَنَّ اللَهَ أَودَعَها سَرا",36,"ر",2,0],["لَها كُلَّ يَومٍ في البَرِيَّةِ فَتكَةً","تُناديكَ لا مُنجاةُ مِمّا تُحاذِرُه",37,"ر",2,0],["له اكف مسكت","مسته غير ممسك",38,"ك",1,0],["لها كفل راب وبطن معكن","وأجثم مثل القعب غير منور",39,"ر",1,0],["لُهاكَ أَوْجَدَتِ الآَمالَ ما فَقَدَتْ","وقَرَّبَتْ لِمُنى الرّاجينَ ما بَعُدا",40,"د",2,0],["لها كهفُ عزِّك أمنُ المروعِ","وجودُك كافلُ وفّادها",41,"د",3,0],["لها كتب في كل قلب فان وعى","لهن وإلا شيعتها كتائب",42,"ب",1,0],["لها كلَّ يومٍ في العبيد وَقِيعَةٌ","تُشِيبُ قّذالَ الدهر وَهْوَ غُلامُ",43,"م",1,0],["لَها كَفَلٌ رابٍ وَساقٌ عَميمَةٌ","وَكَعبٌ عَلاهُ اللَحمُ لَيسَ لَهُ حَجمُ",44,"م",1,0],["لها كفلٌ ترجرجُهُ احتفالاً","يزينُ الغُصنَ والحقفَ الهُيَالا",45,"ل",2,1],["لها كشباكها ثقوبٌ","أنظر منهن حيث شيت",46,"ت",1,0],["لَها كُحلٌ بِالمُقلَتَينِ فَإِن غَدَت","لِكُحلِهِما فَالسَيفُ أَمضى القَواضِبِ",47,"ب",1,0],["لها كفَلٌ لأياً إذا ما تدافعَتْ","بهِ قامَ جُهداً من ذَنوبٍ ومن خصرِ",48,"ر",1,0],["له أكد الوحيُ ميراثَه","ومن ذا يُخالِفُ وحيَ السُّوَر",49,"ر",1,0],["لَها كَنفٌ مِن رَحمَةِ اللَهِ واسِعٌ","وَمَنزلُ صِدقٍ عِندَ فردوسهِ رَحبُ",50,"ب",1,0],["لها كرةٌ بيضاءُ حين تخالها","تهاوت على العشرين تهوي على الخمس",51,"س",1,0],["لَهَا كاهِلٌ مُدَّ في شِدَّةٍ","إِذا ذُعِرَت خِلتَ فيهِ ازوِرَارا",52,"ر",2,0],["لَهَا كَفَلٌ مِثلُ مَتن الطِّرا","فِ مَدَّدَ فِيهِ البُنَاةُ الحِتَارا",52,"ر",2,0],["لها كان يَعْنُو مُصْعَبُ الدَّهْرِ صاغرا","ويَدْنُو إِليها منْ مُناها بَعيدُها",53,"د",3,0],["لها كل قلبٍ نارُ وجدٍ","يسعِّرها أوارُ هوىً جديد",54,"د",1,0],["لها كُلُّ القلوبِ غَدَونَ طَرْدى","الا فافعَلْ بِهِنَّ كما بدا لَكْ",55,"ك",1,0],["لها كلُّ أسبابِ الفخارِ بداهةً","وتخطبُ من سمتِ الملاحةِ جاها",56,"ا",3,0],["لها كل يوم حالة وتطور","قصاراهما النهب المبرر والسلب",57,"ب",1,0],["لَهَا كِبَرٌ فَمَا عَرَفَتْ \"زِحَافاً\"","وَلا \"خَبْناً\" إِذَا طَالَ المَسِيْر\"( 2)",58,"ر",1,0],["[ لَها كُلَّ يَوْمٍ فِي مَعاشِرِ أَهْلِها","نِزالُ حُرُوبٍ طائِلٌ وَجِلادِ ]",59,"د",1,0]]}