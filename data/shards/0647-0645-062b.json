{"poems":[[95,"مصر تناديكم فمن يحجم","https://www.aldiwan.net/poem11320.html","السريع"],[47,"مني وصل ومنك هجر","https://www.aldiwan.net/poem63631.html","مجزوء البسيط"],[47,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[107,"ألا فاذكروا من قومنا كل مقدام","https://www.aldiwan.net/poem43047.html","الطويل"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[556,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49546","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100404","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121615","الخفيف"],[5355,"نعيٌ مُبارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=188456",""],[6070,"تراتيل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=188420",""]],"verses":[["هُمْ ثَرْوَةٌ مَفْقُودَةٌ لِلحِمَى","فَعَلِّمُوهُمْ عِلمُواّ عَلِّمُوا",0,"م",3,0],["هُمُ ثِمادٌ وَأَنتَ بَحرٌ","وَهُم ظَلامٌ وَأَنتَ فَجرُ",1,"ر",1,0],["هُمُ ثَأَروا الأُخدودَ لَيلَةَ أَغرَقَت","رِماحُهُمُ في لُجَّةِ البَحرِ تُبَّعا",2,"ع",2,0],["همُ ثروةُ الأجيالِ لولاهمُ انْطَوتْ","على فاقةٍ ما تُستطاعُ وإعدامِ",3,"م",1,0],["هَمٌّ ثوى بين الضلوعِ مُبرِّحٌ","لولا الوزيرُ وفضلهُ لم يُنْجمِ",4,"م",1,0],["هُمُ ثوّروها فتنةً لم تفِدهُمُ","سوى حزِّهم أَوصالَها واِنتقامها",5,"م",3,0],["هُمْ ثَبَّتوا الدينَ إذْ ضاقتْ مَذَاهِبُهُ","بأنْفُسٍ صِيغَ منها الدينُ والحسب",6,"ب",1,0],["هم ثمار الشجر النضر الذي","ليس يجنى الفضل الا منه يجنى",7,"ن",2,0],["هُمث أودعوا قلبي أسى يوم ودّعوا","وهُم نزلوا في القلب يوم ترحّلوا",8,"ل",3,0],["هم ثِفالٌ إذا رَحَى الحرب دارتْ","وبنادِيهمُ همُ الأرْجاءُ",9,"ا",2,0],["هَمٌّ ثَقيلٌ فِي الْمَسَا","والصُّبْحُ يُسْفِرُ بالْكُرَبْ",10,"ب",1,0],["همْ ثلةٌ زرعوا السعادةَ والهنا","في قلبِ طفلٍ نائمٍ فوقَ الصَّفاءْ",11,"ا",2,0]]}