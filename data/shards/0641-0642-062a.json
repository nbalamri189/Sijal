{"poems":[[65,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[65,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[79,"فقت الحسان بحلتي وبتاجي","https://www.aldiwan.net/poem36666.html","الكامل"],[95,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[85,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[29,"عفا قو وكان لنا محلاً","https://www.aldiwan.net/poem4445.html","الوافر"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[53,"يا غصنا من لؤلؤ رطب","https://www.aldiwan.net/poem8331.html","السريع"],[53,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[31,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[87,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[58,"أشفقت أن يرد الزمان بغدره","https://www.aldiwan.net/poem58585.html","الطويل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[68,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[18,"فقتلاً بتقتيل وعقرا بعقركم","https://www.aldiwan.net/poem23954.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[131,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[131,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[135,"غني بشدوك لي تكيبر وذري","https://www.aldiwan.net/poem54826.html","الطويل"],[146,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[188,"ماذا يقول المادحو","https://www.aldiwan.net/poem14113.html","مجزوء الكامل"],[192,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[228,"يا خير مولى بندى كفه","https://www.aldiwan.net/poem55228.html","السريع"],[232,"لمن أشكو تظلمي","https://www.aldiwan.net/poem50793.html","مجزوء الخفيف"],[235,"لاموا على حب المليح وعنفوا","https://www.aldiwan.net/poem14727.html","الكامل"],[253,"أيها الفاضل الذي قد حباه","https://www.aldiwan.net/poem14983.html","الخفيف"],[285,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[285,"يا رفيقي إن كنت نعم الرفيق","https://www.aldiwan.net/poem32689.html","الخفيف"],[300,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[300,"بانوا فليت غرامي بعدهم بانا","https://www.aldiwan.net/poem33149.html","البسيط"],[301,"(أدمشق) ما للحسن لا يعدوك","https://www.aldiwan.net/poem36849.html","عموديه"],[308,"خير حام مجير عبد المجيد","https://www.aldiwan.net/poem56552.html","الطويل"],[308,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[367,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[367,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[369,"وقاك الله من غلب الرجال","https://www.aldiwan.net/poem17258.html","الوافر"],[380,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[406,"مولاي يا علم المعالي","https://www.aldiwan.net/poem33483.html","مجزوء الكامل"],[412,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[442,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[446,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[460,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[463,"يا جوادا محرزا سبق العلى","https://www.aldiwan.net/poem16137.html","الرمل"],[466,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[484,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[517,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[517,"لبس البهاء بسعيك الإسلام","https://www.aldiwan.net/poem12241.html","الكامل"],[545,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[555,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[572,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"],[588,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/200300","الخفيف"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/20580","الرمل"],[1180,"","https://poetry.dctabudhabi.ae/diwan/poem/31518","الطويل"]],"verses":[["فُقْتُ الأعاريبَ في شِعْرٍ نأمْتُ بهِ","كأنّه لُؤلُؤٌ في السِّلْكِ مَنضودُ",0,"د",1,0],["فُقْتَ الثَّناءَ فلمْ أبْلُغْ مَداكَ بهِ","حتى توهَّمْتُ أنَّ العَجْزَ منْ قِبَلي",1,"ل",2,0],["فُقْتُ الحِسانَ بحُلّتي وبِتاجي","فهَوَتْ إليّ الشُّهْبُ في الأبْراجِ",2,"ج",1,1],["فُقْتَ الَّذِينَ أَخَذْتَ عَنْهُمْ يَافِعاً","وَبَزَزْتَ مَنْ جَلُّوا مِنَ الأَقْرَانِ",3,"ن",1,0],["فُقت الملوك جلالة وبسالة","وشأوْتَهُم في الحِلم والإجمالِ",4,"ل",1,0],["فَقَتَّلنا الرُهونَ بِغَيرِ رَهنٍ","وَأَشطَطنا القَضِيَّةَ وَاِعتَدَينا",5,"ن",2,0],["فَقَتَّلنا جَبابِرَةً مُلوكاً","وَأَطلَقنا المُلوكَ عَلى اِحتِكامِ",6,"م",1,0],["فَقَتَلنا كُلَّ رَأسٍ مِنهُمُ","وَقَتَلنا كُلَّ جَحجاحٍ رِفَلّ",7,"ل",1,0],["فُقْتِ المُغنِّينَ كما فاقنا","كواكبُ الدنيا بنو وَهْب",8,"ب",1,0],["فقَت الفَياشُل عينَهُ في بطنها","فأتت به أعمى قبيح المنظر",9,"ر",1,0],["فُقْتَ الأنام صنيعة وصنائعاً","لا زلت تستعلي وقِرنك يسفُلُ",10,"ل",1,0],["فَقَتَلنَ مَن حَمَلَ السِلاحَ وَغَيرَهُم","وَتَرَكنَ فَلَّهُمُ عَلَيكَ عِيالا",11,"ل",2,0],["فقتلته ورزحت مقتولا به","رب اجتهاد قاتل كجهاد",12,"د",1,0],["فقتلتُهُ ولَهُ عَلَيَّ كَرامَةٌ","مِلْءَ الحَشا ولهُ الفُؤادُ بأَسْرِهِ",13,"ر",2,0],["فَقَتَلتَ جَيشَهُمُ وَجِئتَ بِسَيبِهِم","وَتَرَكتَهُم بِالغورِ كَالأَكداسِ",14,"س",1,0],["فَقَتيلٌ تَحتَ السَنابِكِ يَدمى","وَأَسيرٌ يُراقِبُ القَتلَ عانِ",15,"ن",1,0],["فُقتَ المُلوكَ جَميعاً في عَطاً وَسَطاً","فَأَنتَ كَالبَحرِ فيهِ النَفعُ وَالضَرَرُ",16,"ر",1,0],["فَقَتلاً بِتَقتيلٍ وَعَقراً بِعَقرِكُم","جَزاءَ العُطاسِ لا يَموتُ مَنِ اِثَّأَر",17,"ر",1,1],["فقُتِّلوا قتلاً ذَرِيعاً فاشيا","وأَدبر العِلْجُ ذَمِيماً خازيا",18,"ي",2,0],["فقُتِّلوا في بَطنِ كلِّ وادِي","وجاءتِ الرُّؤوسُ في الأعْوادِ",18,"د",1,0],["فَقُتِّلوا مَقْتلَةَ الفَناءِ","فارتوتِ البِيضُ منَ الدِّماءِ",18,"ا",2,0],["فُقْتَ أهْلَ الجمال حُسْناً وحُسْنى","فَبِهِمْ فاقةٌ إلى معناكا",19,"ك",2,0],["فقتَ الأنامَ مواهباً","تَتْرى وفقتهمُ صميما",20,"م",2,0],["فُقْتَ البريَّة في عدْل وفي خُلق","وكل خَلْقٍ سِواك اليوم مُحْتَقَرُ",21,"ر",1,0],["فُقتِ الإنَاثَ وَما فِي القُطرِ مِن ذَكَرِ","لِلهِ دَرُّكِ مِن أُنثَى ومِن ذَكَرِ",22,"ر",1,0],["فُقتَ هَذا الورى جُدوداً وَآبا","ءً وَفُقتَ اللآباءَ وَالأَجدادا",23,"د",2,0],["فُقْتَ الكواكبَ ضِعْف ما","فاقت على الأرضِ الكواكب",24,"ب",1,0],["فقتَ جِبريلَ فقتَ ميكائيلا","فُقتَ كلَّ الأنامِ فجيلا",25,"ل",2,0],["فُقتَ الوَرى في الفَضل أَو سُدتَه","فَحَبَّذا الفَضلُ وَنِعمَ الأَمير",26,"ر",1,0],["فقتِ كل الورى بلح","ظٍ ولفظٍ ومبسمِ",27,"م",1,0],["فُقتَ الوَرى حُسناً وَزِدت علَيهم","حَتّى كَأَنَّكَ يوسُفٌ يا يوسُفُ",28,"ف",1,0],["فُقتَ أهل الآدابِ جَدّاً وهزلا","فَتميَّز عنهم بذا التمييز",29,"ز",1,0],["فُقتَ مُلوكَ الإِنسِ بِالعَزمِ وَقَد","ذلَّت مُلوكُ الجِنِّ بِالتَعزيمِ لَك",30,"ك",1,0],["فُقتُ حُزناً إِذ فاقَ حُسناً وَمِن سك","رِ هَواهُ أَمسَيتُ لَيسَ أَفيقُ",31,"ق",1,0],["فُقتَ أَبا أمامَه","جوداً على ابن مامَه",32,"ه",1,0],["فُقتَ الكرامَ بما أَولَيتَ من كَرَمٍ","لِلَّه درُّك مِفضالاً ومِعوانا",33,"ن",2,0],["فقْتِ الحواضرَ وَالبلادَ بنسبةٍ","من (قاسيون) إِلى الذرى تنميكِ",34,"ك",1,0],["فُقتَ نجراً أما المجلّ بصدرٍ","فَنجومٌ راقتكَ برج السعودِ",35,"د",1,0],["فُقتَ نجراً أم أصل المجد برّ","رُمتَ لِلبجلِ نجر صدق فرودِ",36,"د",1,0],["فُقْتَ اشْتِهاراً كما بدا عَلَمٌ","مِن فوقه خافقاً بدا عَلَم",37,"م",1,0],["فُقْتَ كُلاًّ فانت للجوِّ نَجمٌ","ومُباري عُلاكَ في القاعِ فَقْعه",38,"ع",2,0],["فَقَتلاهُ تُقَدُّ بِلا قِتالٍ","وَأَسراهُ تُقادُ بِلا حِبالِ",39,"ل",1,0],["فقتِ الورى بطهارةٍ","عنها الملائك نائيه",40,"ي",2,0],["فقت الرجال مع الفتو","ة في المروءة والكمال",41,"ل",1,0],["فقتلت من صدق الوغى ووسمت من","نجى الفرار بذلة وهوان",42,"ن",1,0],["فَقتلْتَ هَمّاً ذُقْتُ حَدَّ سيوفِهِ","بسيوفِ إِنعامٍ بِهَا استحيَيتَنِي",43,"ن",2,0],["فقتل صب من سروره وقت","ل الزوج ذاك الشيخ قتل الغيرة",44,"ه",1,0],["فُقتُ الورى قولا وفُقتم نائلا","فالمجدُ بين أكفّكم ولساني",45,"ن",2,0],["فُقْتَ أبْناءَ المَعالي يافِعاً","وشَأوْتَ القومَ سَعْياً ونِجارا",46,"ر",2,0],["فقتيلهُ هدرٌ فلا قودٌ لهُ","وأسيرهُ علقٌ بغير فكاك",47,"ك",1,0],["فقت الطباع والثبات","لما نظرت ذا الحياة",48,"ه",1,0],["فقت الملوك مهابة وجلالاً","وطرائقاً وخلائقاً وخلالا",49,"ل",2,1],["فقت الملوك فضائلاً وفواضلاً","وعزائماً عزت فليس ترام",50,"م",1,0],["فَقَتَلنا بِوارِداتٍ رِجالاً","إِذ بَدا كاضِمُ الضَميرِ ضُباحا",51,"ح",2,0],["فُقتَ البَرِيَّةَ مِن كَهلٍ وَمِن حَدَثٍ","وَفاقَ أَباؤُكَ الماضونَ ماضيها",52,"ي",3,0],["فقتل الله به أشرافهم","وانهزموا وأمكنوا أكتافهم",53,"م",1,0],["فقتل الخائن فيه أربعة","ولم يمت وكان في الدار معه",53,"ه",1,0],["فقتلت الجميع من حذرِ الثكلِ","لقد كُنت في الدماءِ منهوما",54,"م",2,0],["فُقْتَ فِي الحُسْنِ البُدُورَ مَدا","يَا مُذِيباً مُهْجَتِي كَمَدا",55,"د",2,0],["فقتلْنَا لكَ ابنَ أُمِّك والمُلْ","كُ عَقِيمٌ مُقَطِّعُ الأَنْسابِ",56,"ب",1,0],["فَقَتَلنا الضعفَ مِن أَشرافِهُم","وَعَدَلنا مَيلَ بَدرٍ فَاِعتَدَل",57,"ل",1,0],["فَقَتلى بِقَتلاهُم وَسَبياً بِسَبيِهِم","وَمالاً بِمالٍ عاهِنٍ لَم يُفَرَّقِ",58,"ق",1,0]]}