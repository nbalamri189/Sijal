{"poems":[[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[63,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[77,"فقت الحسان بحلتي وبتاجي","https://www.aldiwan.net/poem36666.html","الكامل"],[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[27,"عفا قو وكان لنا محلاً","https://www.aldiwan.net/poem4445.html","الوافر"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[51,"يا غصنا من لؤلؤ رطب","https://www.aldiwan.net/poem8331.html","السريع"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[56,"أشفقت أن يرد الزمان بغدره","https://www.aldiwan.net/poem58585.html","الطويل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[66,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""]],"verses":[["فُقْتُ الأعاريبَ في شِعْرٍ نأمْتُ بهِ","كأنّه لُؤلُؤٌ في السِّلْكِ مَنضودُ",0,"د",1,0],["فُقْتَ الثَّناءَ فلمْ أبْلُغْ مَداكَ بهِ","حتى توهَّمْتُ أنَّ العَجْزَ منْ قِبَلي",1,"ل",2,0],["فُقْتُ الحِسانَ بحُلّتي وبِتاجي","فهَوَتْ إليّ الشُّهْبُ في الأبْراجِ",2,"ج",1,1],["فُقْتَ الَّذِينَ أَخَذْتَ عَنْهُمْ يَافِعاً","وَبَزَزْتَ مَنْ جَلُّوا مِنَ الأَقْرَانِ",3,"ن",1,0],["فُقت الملوك جلالة وبسالة","وشأوْتَهُم في الحِلم والإجمالِ",4,"ل",1,0],["فَقَتَّلنا الرُهونَ بِغَيرِ رَهنٍ","وَأَشطَطنا القَضِيَّةَ وَاِعتَدَينا",5,"ن",2,0],["فَقَتَّلنا جَبابِرَةً مُلوكاً","وَأَطلَقنا المُلوكَ عَلى اِحتِكامِ",6,"م",1,0],["فَقَتَلنا كُلَّ رَأسٍ مِنهُمُ","وَقَتَلنا كُلَّ جَحجاحٍ رِفَلّ",7,"ل",1,0],["فُقْتِ المُغنِّينَ كما فاقنا","كواكبُ الدنيا بنو وَهْب",8,"ب",1,0],["فقَت الفَياشُل عينَهُ في بطنها","فأتت به أعمى قبيح المنظر",9,"ر",1,0],["فُقْتَ الأنام صنيعة وصنائعاً","لا زلت تستعلي وقِرنك يسفُلُ",10,"ل",1,0],["فَقَتَلنَ مَن حَمَلَ السِلاحَ وَغَيرَهُم","وَتَرَكنَ فَلَّهُمُ عَلَيكَ عِيالا",11,"ل",2,0],["فقتلته ورزحت مقتولا به","رب اجتهاد قاتل كجهاد",12,"د",1,0],["فقتلتُهُ ولَهُ عَلَيَّ كَرامَةٌ","مِلْءَ الحَشا ولهُ الفُؤادُ بأَسْرِهِ",13,"ر",2,0],["فَقَتَلتَ جَيشَهُمُ وَجِئتَ بِسَيبِهِم","وَتَرَكتَهُم بِالغورِ كَالأَكداسِ",14,"س",1,0],["فَقَتيلٌ تَحتَ السَنابِكِ يَدمى","وَأَسيرٌ يُراقِبُ القَتلَ عانِ",15,"ن",1,0],["فُقتَ المُلوكَ جَميعاً في عَطاً وَسَطاً","فَأَنتَ كَالبَحرِ فيهِ النَفعُ وَالضَرَرُ",16,"ر",1,0],["فقُتِّلوا قتلاً ذَرِيعاً فاشيا","وأَدبر العِلْجُ ذَمِيماً خازيا",17,"ي",2,0],["فقُتِّلوا في بَطنِ كلِّ وادِي","وجاءتِ الرُّؤوسُ في الأعْوادِ",17,"د",1,0],["فَقُتِّلوا مَقْتلَةَ الفَناءِ","فارتوتِ البِيضُ منَ الدِّماءِ",17,"ا",2,0],["فُقْتَ أهْلَ الجمال حُسْناً وحُسْنى","فَبِهِمْ فاقةٌ إلى معناكا",18,"ك",2,0]]}