{"poems":[[79,"سلو عن فؤادي بعدكم كيف حاله","https://www.aldiwan.net/poem36368.html","الطويل"],[53,"أظنك مما قد مطلت مثوبتي","https://www.aldiwan.net/poem62907.html","الطويل"],[53,"سقيا لعيش مضى ما فيه تكدير","https://www.aldiwan.net/poem64040.html","البسيط"],[53,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[63,"هلم فقد بردت راحنا","https://www.aldiwan.net/poem51414.html","المتقارب"],[76,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[112,"قطعة الحلوى","https://www.poetsgate.com/ViewPoem.aspx?id=8390",""],[119,"اخا الاشجان حي على الفلاح","https://www.aldiwan.net/poem41176.html","عموديه"],[139,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[139,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[275,"من غصن قلبك زهر الحب ينتثر","https://www.aldiwan.net/poem35472.html","البسيط"],[302,"هاتا أعيدا لي حديثي القديم","https://www.aldiwan.net/poem33164.html","السريع"],[376,"حبل الهوى ملقى على الغارب","https://www.aldiwan.net/poem57530.html","السريع"],[422,"زارت وجنح الدجى يا سعد معتكر","https://www.aldiwan.net/poem53872.html","البسيط"],[435,"كفي فإن سحاب الجفن قد وكفا","https://www.aldiwan.net/poem41398.html","البسيط"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104582","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70836","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59577","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56188","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128699","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113935","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100976","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27442","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132671","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132580","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62821","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48346","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110087","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91285","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91739","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131022",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77177","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107500","الهزج"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117247","الطويل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77696","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141670","الهزج"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139759",""],[5464,"يا جبل الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=6672",""],[5464,"رويدك لا الملام ولا العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=703",""]],"verses":[["وَعَلَّلْتُ نَفْسِي بِاللِّقَاءِ فَإِنَّنِي","لآمُلُ لُطْفَ اللهِ جَلَّ جَلاَلُهُ",0,"ل",2,0],["وعُلِّلتُ من وردٍ سواه بموعدٍ","فليس لأمري آخرَ الدهر آخر",1,"ر",1,0],["وعلِّلانيَ إنّ الصبر ممتنِعٌ","والحزن مكتنِعٌ والدمع محدور",2,"ر",1,0],["وعلَّلنا من قبله بمناظرٍ","لهونا بها حتى نسينا المطاعما",3,"م",2,0],["وعُلِّلَ من مائِه وَرْدُنا","وغُيِّرَ بالمِسكِ تُفَّاحُنا",4,"ن",2,0],["وَعَلِّل بِرَيّا الرَندِ نَفساً عَليلَةً","مَعَ الصُبحِ يَندى أَو مَعَ اللَيلِ هادِيا",5,"ي",2,0],["وعلل هاتيك المشاهد روحه","وريحانه ما لاح برق جنابها",6,"ب",3,0],["وعلَّلتُ نفسي بذوب الصديد","كما علَّلتْ وارداً \" زمزم \"",7,"م",1,0],["وعَلَّلتُ أطفالي بَشرِّ تعلِّةٍ","خُلودِ أبيهم في بُطونِ المجامع",8,"ع",1,0],["وعللميها...أني؟....؟ على حد......؟ السحاب.,.,","ويوم؟. قلتيلي... سالتس... هي.؟؟ وين.؟",9,"ن",1,0],["وعلل قلبك المحزون حينا","باحبار الاخلاء الصحاح",10,"ح",1,0],["وعللتها حيناً فصدّتْ تعللي","وصبّرتها حتى إذا لم تجد صبراً",11,"ر",2,0],["وعللوهم بآمالٍ مفَرحةٍ","فطالما سرّت الآمالُ محزونا",12,"ن",2,0],["وعلِّليني بآمالٍ مزخرفةٍ","وصافِحيني ليبقى في يَدي أثر",13,"ر",1,0],["وعلِّلاني بنسيم الصبا","إِن كانَ يستشفي عليلاً سَقيم",14,"م",1,0],["وعللّوني بالذي عندَهم","كمُستتابٍ ليسَ بالتائبِ",15,"ب",1,0],["وعلَّلَتْنا وتَعْليلُ المشوق بما","يَشفي فؤاداً شَديد الشّوق مُلتاحا",16,"ح",2,0],["وعللاني بذكراها ومعهدها","وأطربا مغرما في حبها دنفا",17,"ف",2,0],["وعللّتها بالمنعمين ذوي الندى","فلم ترضَ إلاّ بالملوك المقاول",18,"ل",1,0],["وَعِلَلٍ تُعجِزُ إِحصاءَ العَدَدْ","مِن جَرَبٍ وَمِن دُوارٍ وَرَمَدْ",19,"د",1,0],["وعَلّلِ النّفسَ عنهم بالحديثِ بهم","انَّ الحديثَ عن الأحبابِ أسمارُ",20,"ر",1,0],["وعلِّلْنا سُلافَتَها","وسقِّ القومَ جِرْيالا",21,"ل",2,0],["وعلل فؤادي بالحبيب فإنني","أردّدُ ذِكرَى حُسنه وأعيد",22,"د",1,0],["وعلّلوه وقد أشفوا بيوسفهم","يعقوبهم ولأَيّوب البلا رحموا",23,"م",3,0],["وعللني من نغبة من شرابه","وسرت مع المختار تحت ركابه",24,"ه",1,0],["وعلليه بجيران النقا فعسى","يشفي غليل فؤادي من تلظيه",25,"ي",2,0],["وعَلِّل لدى مغنى الأُحَيمِرِ مَنهَجاً","لنا نعتَريهِ حين نَذهَبُ أو نَجي",26,"ج",2,0],["وعللتني بوعد في الغرام له","صح الغرام بأمراض المواعيد",27,"د",1,0],["وعلله الفاروقُ إذ كان معلنا","ليطردَ شيطاناً ويوقظَ وَسنانا",28,"ن",2,0],["وعللتا رياح الشام رائحةً","يا حب رائحها الذاكي وعاديها",29,"ي",3,0],["وعلل فؤادي بمدح الوصي","ليروى بسلساله الريق",30,"ق",1,0],["وعلل الصب باخبار الغضا","وإن يكن بين ضلوعي رقده",31,"د",2,0],["وعللِ الهمّ إنْ عنّاكَ طارقُهُ","بباردٍ من عصيرِ الكرمِ مقرورِ",32,"ر",1,0],["وعلّلْ قلْبَكَ المُضْنَى وشَفّعْ","جَديدَ هَواكَ بالخَمْرِ القَديمِ",33,"م",1,0],["وعلَّ ليالي البُؤس كفَّ ظلامُها","وأَشرقَ فيها بدرُها ونُجومُها",34,"ه",2,0],["وَعلل بتغرير المُنى النفسَ إنَّها","كَنَفس سِواها قَد تُغَرّ بآمال",35,"ل",1,0],["وَعَلل بتغريرِ المُنى النَفسَ إِنَّها","كَنَفسٍ سِواها قَد تغرّ بآمالي",36,"ل",2,0],["وعلّلت نفسي بالشفاء تفاؤلا","فما راعني إلا نداء الذي نعى",37,"ع",2,0],["وَعَللاني بِذِكرى مَن وَلَعتَ بِهِم","وَخبراني عن نَجد بِأَخبار",38,"ر",1,0],["وعلِّلني بعنَّابٍ","ورمان وتفَّاح",39,"ح",1,0],["وعلّل بوصل الطيف نفساً عليلة","ومن للمعنّى أن يساعده الطيفُ",40,"ف",1,0],["وَعَلّلوني بِأَخبارِ العُذَيب فَلي","عَلى العُذيب أَسى للصَبر ينتَزعُ",41,"ع",1,0],["وعللها بكاس ثم","عما شئت فاسألها",42,"ه",2,0],["وعلِّل النفس بالآمال منه تجد","غنىً وخيراً فما خابت مساعيه",43,"ي",2,0],["وعلّلَ فالعيونُ اليهِ تُصغي","بدهشِتها أجابَ وما أجابوا",44,"ب",3,0],["وعلَّلَ ... والعيونُ إليه تُصْغي","بِدهشَتِها ... أجابَ وما أجابوا",45,"ب",3,0]]}