{"poems":[[79,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[107,"أمشي على خوف وطول تلفت","https://www.aldiwan.net/poem43122.html","الكامل"],[77,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85401","الخفيف"],[107,"أمشي على خوفٍ وطول تلفتٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54939&r=&rc=109",""],[458,"أيها الشعب لماذا تنتحر","https://www.aldiwan.net/poem61615.html","الرمل"],[463,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[505,"قمنا لنساوت النبي مثالا","https://www.aldiwan.net/poem37629.html","الكامل"],[556,"لا در در الحرص والطمع","https://www.aldiwan.net/poem47708.html","أحذ الكامل"],[556,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123680","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121141","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93866","الكامل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127830","البسيط"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[1901,"رَبٍّ إني طغى عليَّ مَشيبي","https://www.poetsgate.com/ViewPoem.aspx?id=160419",""],[3271,"لم يطب للنبوغ فيك مقام","https://www.poetsgate.com/ViewPoem.aspx?id=103537",""],[5290,"رعي الحقوق كما علمت حقيق","https://www.poetsgate.com/ViewPoem.aspx?id=113130",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""],[5909,"هلّا بقيِتَ وفي الحبيب عزاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210580",""],[6102,"نَفَقَ الحِمارُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185211",""],[6159,"مدارات عسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85856&r=&rc=2",""]],"verses":[["وَإِذَا ثَنَتْهُمْ أَرْيَحِيَّةُ مُطْرِبٍ","قُلْتَ النُّعَامَى فِي غُصُونِ الْبَانِ",0,"ن",1,0],["وَإِذا ثَيبَةٌ لِعيسى وَمَنفي","سُ وَنَيلُ الثَراءِ وَالبَطحاءُ",1,"ا",2,0],["وَإِذا ثُويتُ بِمَنزِلي أَلفَيتَني","مَيتَ المَفاصِلِ مُحرَجُ المُتَنَفَّسِ",2,"س",1,0],["وإذا ثنَيْتَ إلى الخلافة أصبعاً","وفّيتَ حقَّ النقض والتوكيد",3,"د",1,0],["وإذا ثارَت الجَماعَة يوماً","فَهيَ قَد لا تَدري لماذا تَثور",4,"ر",1,0],["وإذا ثويت بمنزلي ألفيتني","ميت المفاصل مخرج المتنفس",5,"س",1,0],["وإذا ثارَ فَمن ثورِته","يَطلعُ الفجرُ إذا الليلُ اعتكر",6,"ر",1,0],["وإذا ثوّبَ الصريخُ توافَوا","يملأون الفضا كهولاً وغلْمَهْ",7,"م",2,0],["وإذا ثملت بحبِّ من همنا به","خلِّ الدلال وجانب الإدلالا",8,"ل",2,0],["وَإذا ثَويتُ بدار مَخصبةٍ","وشَرِكتُ فيها فالورى شِيَعِي",9,"ع",2,0],["وَإِذا ثَكِلْتَ فلا تزرْ","إِلّا دِيار الثّاكلاتِ",10,"ت",1,0],["وإذا ثوى في مجمع أو محفل","فتراه بدراً كاملاً بتمامه",11,"م",2,0],["وإذا ثنت سهما رميته","فدع الرمية واعرف السهما",12,"م",2,0],["وإذا ثنايا الثغر لاح وميضها","فاحذر بوارقه فتلك خواطف",13,"ف",1,0],["واذا ثوت قيل أَرخ فوق حجرتها","تملَّكي دار عزّ السعد يا ملكه",14,"ه",1,0],["وإذا ثوى بالبقاع الطاهرات غدت","في رتبة لم تكن للثّور والأسد",15,"د",1,0],["وإذا ثقلت من الطعام وغيره","تلقى به من ثقلة تخفيفا",16,"ف",2,0],["وإذا ثار أو تَميّز غيظاً","لم يُخدَّدْ خدودَه بالقُطوبِ",17,"ب",1,0],["وإذا ثارَ خلتهُ شُهُبَ اللّيْ","ل أطارت لهيبها الأجرام",18,"م",1,0],["وإذا ثنى عطف النزيف صبوحه","فلنا صبوح باسمه وغبوق",19,"ق",1,0],["وإذا ثأرْنا مرَّةً صرخَتْ","أحبارُهم وتواقحَ الجدلُ؟",20,"ل",1,0],["وإذا ثملتُ فلا أطيق ثمالتي","ما لم تعانقْ مثلها الأحشاءُ",21,"ا",2,0],["وِ إِذا ثُغُورُ الحَربِ فاهَتْ , يا تُرَى","رَغمًا تَجُرُّ الكارِهِينَ حِبالُ ؟",22,"ل",1,0],["وإذا ثياب الحزن تصبح حُلَّةً","وإذا غراب الشؤم يصبح نورسا",23,"س",2,0]]}