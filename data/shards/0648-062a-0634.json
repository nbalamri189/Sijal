 ابن عفان الإما م","https://www.poetsgate.com/ViewPoem.aspx?id=15896",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[67,"وارمِ العِدا ببشائرٍ عنْ أرميا","https://www.poetsgate.com/ViewPoem.aspx?id=14566",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[99,"ضحكة","https://www.poetsgate.com/ViewPoem.aspx?id=36725",""],[95,"طلل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=240&r=&rc=3",""]],"verses":[["وَتَشاكَينَ وَالشُكاةُ بُكاءٌ","وَتَنادَينَ وَالنِداءُ عَويلُ",0,"ل",1,0],["وَتَشتاقُ نَفسي حالَةً بَعدَ حالَةٍ","وَأَزجُرُها إِنّي إِذا لَقَنوعُ",1,"ع",1,0],["وَتَشهَدُ بِالعَفافِ عَلى","بَواطِنِهِ ظَواهِرُه",2,"ر",2,0],["وتُشْرِقُ بالوَرْدِ الخُدودُ نَواضِراً","إذا ابْتَسَمَتْ عن أقْحُوانٍ مُفَلَّجِ",3,"ج",1,0],["وتَشُبُّ شَعْثاءَ الفُروعِ وتَمْتَري","أخْلافَ حَرْبٍ للمَنونِ وَلودِ",4,"د",1,0],["وتَشكُو إليكَ الدَّهْرَ تَفْري خُطوبُهُ","بقيّةَ شِلْوٍ من ذَويكَ مُقَدَّدِ",5,"د",1,0],["وَتَشهَدُ لي الخَيلُ يَومَ الطِعانِ","بِأَنّي أُفَرِّقُها أَلفَ سُربَه",6,"ب",2,0],["وَتَشَرَّفَت مِن قَصرِها فَلَمَحتُها","فَلَأُسأَلَنَّ عَنِ النَعيمِ الأَكبَرِ",7,"ر",1,0],["وَتَشرَقَ بِالقولِ الَّذي قَد أَذَعتَهُ","كَما شَرِقَت صَدرُ القَناةِ مِنَ الدَمِ",8,"م",1,0],["وَتَشَاكَيَا كُلٌّ إِلَى آلامِهِ","شَكْوَى أَدَلَّ عَلَى وَفَاءِ العَانِي",9,"ي",1,0],["وَتُشعِرُهُ أَعطافَها وَتَسوفُهُ","وَتَمسَحُ مِنهُ بِالتَرائِبِ وَالنَحرِ",10,"ر",1,0],["وتشرب أنت كأس المجد صِرفاً","ويشربها سواؤك ذات مَزج",11,"ج",1,0],["وتُشرق في سماء الشعر منه","كواكب ليس يدركها مغيب",12,"ب",1,0],["وَتَشكو الماشِياتُ إِلَيكَ جَهداً","وَلا صَعبٌ لَهُنَّ وَلا ذَلولُ",13,"ل",1,0],["وَتَشاهَدَت صَيدُ المُلوكِ بِفَضلِهِ","وَأَرى المَكارِمَ مِن مَكانٍ عالِ",14,"ل",1,0],["وتشكو عقوق المعرضين وبخلهم","إليك فتلقى عندك البرّ والبحرا",15,"ر",2,0],["وتشتاق من إحسانك الحلو رسمها","ولا عجب شوق الرياض إلى القطر",16,"ر",1,0],["وتشاغلي فيما يضر وحسبه","لو لم يضرّ بأيّه لم ينفع",17,"ع",1,0],["وتشدو على عيدانها فتثير لي","كمائن وجدٍ ضمنتها الأضالع",18,"ع",1,0],["وتشرَّفت أرضٌ بموطئِ نعلهِ","وسمت حصاها فالرجوم نجوم",19,"م",1,0],["وتشرح أرض الشام فيك غرامها","بضعفِ نسيم أو حنين حمام",20,"م",1,0],["وتشتكيه من رياح الجَنْبِ","نافرةُ الصَّوت خَرُوج الضَّربِ",21,"ب",1,0],["وتشكو الخندريس أذىً إذا ما","تنفَّس في كؤوس الخندريس",22,"س",1,0],["وتشيم الأمور غير مضاهٍ","راعي الثلَّةِ النؤوم النعوقا",23,"ق",2,0],["وتشفعُ ذاك مُسمعةٌ","لنا بالسّحْرِ مُكْتحلَهْ",24,"ل",2,0],["وتشاغلٌ عن ذكر ربٍّ لم يزل","حسنَ الصنائعِ سابغَ الإنعام",25,"م",1,0],["وتَشفِي من جَوَى الأبراحِ صبّاً","يكاد يموتُ سُقماً واغتماما",26,"م",2,0],["وَتُشرِقُ أَجبالُ العَويرِ بِفاعِلٍ","إِذا خَبَتِ النيرانُ بِاللَيلِ أَوقَدا",27,"د",2,0],["وَتُشجيكَ بِأَلحانٍ","تُذيبُ الجَلمَدَ الصَلدا",28,"د",2,0],["وَتَشرِبُ أَسآرِيَ القَطا الكُدرُ بَعدَما","سَرَت قَرَباً أَحناؤُها تَتَصَلصَلُ",29,"ل",1,0],["وتشكو أَساها بَيَاضَ النَّهارِ","وتندُبُ حَظَّ الحَيَاةِ السَّخيفْ",30,"ف",1,0],["وَتُشِيدينَ في خرائبِ روحي","مَا تلاشَى في عهديَ المجدودِ",31,"د",1,0],["وتشربون به كاساً مسنمة","وتأكلون به نخلاً ورمانا",32,"ن",2,0],["وَتَشَمُّ رائِحَةَ الرُفاتِ كَريهَةً","وَتَشَمُّ مِنها الثاكِلاتُ العَنبَرا",33,"ر",2,0],["وَتَشُدُّ بَيتَ النَحلِ فَهوَ مُطَنَّبٌ","وَتَمُدُّ بَيتَ النَملِ فَهوَ مُرَوَّقُ",34,"ق",1,0],["وَتَشهَدُ ما آذَيتُ نَفساً وَلَم أَضِر","وَلَم أَبغِ في جَهري وَلا خَطَراتي",35,"ي",1,0],["وتَشَعّبَتْ طُرُقُ الضَّلالِ فَلَو","لاكُمْ مَشَوا بالشِّرْكِ والكُفْرِ",36,"ر",1,0],["وتشميع أجسادنا الباليات","بالماء كان وبالدهن تم",37,"م",1,0],["وتشتاقُه الجُرْدُ الصوافِنُ شُزَّبَاً","يجوسُ بها أرضَ العِدى فتُدَوَّخُ",38,"خ",1,0],["وَتَشاكَينا مِنَ الحُبِّ جَوى","مَلا الأَحشاءَ ناراً تَتَّقِدّ",39,"د",1,0],["وتَشريفي القيامُ إزاءَ مَلْكٍ","ملوكُ العالَمِينَ له قِيامُ",40,"م",1,0],["وتَشَقَّقَتْ قُمْصُ الشَّقيقِفَخِلْتُهُ","في الرَّوْضِ كاساتٍ مُلِئْنَ مُداما",41,"م",2,0],["وتَشرَقَ من شرقيِّ دِجلةَ بالقَنا","ضَحاضحُ أنتُم سيلُها وإِكامُ",42,"م",1,0],["وتشُقُّ العُبابَ كالحيَّةِ السَّوْ","داءِ أبقَتْ في الرَّمْلِ أثْرَ انسيابِ",43,"ب",1,0],["وتشتيتُنا شَمْلَ سِرْبِ الظِّبا","بمُدمَجةٍ مثلِ سِربِ الظِّباءِ",44,"ا",2,0],["وَتَشَوَّفَت لِذَوي مَخايِلِها المُنى","وَكَتَمنَ سُمّاً تَحتَهُنَّ نَقيعا",45,"ع",2,0],["وَتَشَتَّتَت عَنها الجُمو","عُ وَفارَقَتها الغاشِيَه",46,"ي",2,0],["وَتَشَكّى يَعقوبُ إِذ ذَهَبَت عَينا","هُ مِن حُزنِهِ وَكانَ كَظيما",47,"م",2,0],["وتشفق بعد ما تقسو فتمضي","لتقرع كل نافذةٍ وبابِ",48,"ب",1,0],["وتُشْعِلُ في جانبيها البروقُ","بريقَ السيوف تُهزّ انتضاءَ",49,"ا",2,0],["وَتَشتَري نَفسُهُ المَعروفَ بِالثَمَنِ ال","غالي وَلَو أَنَّها كانَت مِنَ الثَمَنِ",50,"ن",1,0],["وَتَشَرَّفُ العُليا وَهَل بِكَ مَذهَبٌ","عَنها وَأَنتَ عَلى المَكارِمِ قَيِّمُ",51,"م",1,0],["وتشكَّى خصرُهُ مِنْ ردفِهِ","قلتُ قَدْ أتعبنَهُ ما أثقلَكْ",52,"ك",1,0],["وتشريدَهَا كُلَّ مَنْ يَدَّلِي","بِحَبْلٍ لأهْلِيكَ أو مَقْطَعِ",53,"ع",1,0],["وَتَشَتُّتَ الأَهواءِ يَخلِجُني","نَحوَ العِراقِ وَمَطلَعِ الشَمسِ",54,"س",1,0],["وَتشهدُ أنه البطلُ المُرَجَّى","إذا فَزَعَ الرُّماةُ إلى النِّبالِ",55,"ل",1,0],["وَتَشرَبُ بِالقَعبِ الصَغيرِ وَإِن تُقَد","بِمِشفَرِها يَوماً إِلى الرَحلِ تَنقَدِ",56,"د",1,0],["وتَشَرَّفَت باسمٍ جَدِيدٍ فادعُها","حَرَمَ الإِلهِ بَلَغْتَ منه السُّولا",57,"ل",2,0],["وَتَشَوَّقَت حورُ الجِنا","نِ مِنَ الخُلودِ إِلى مِثالِك",58,"ك",1,0],["وَتُشرِكُ لَيلَةَ شَهرِ الصِيام","حَلالاً كَما نَظَرَ الأَربَدُ",59,"د",1,0],["وَتَشَبَّهوا بِأَبٍ وَعَمٍّ صالِحٍ","مُتَعَبِّدَينِ لَنا وَنِعمَ العُبَّدُ",60,"د",1,0],["وَتُشرِقُ الأَرضُ مِن مَحاسِنِهِ","كَأَنَّ نوراً في الشَمسِ مُجتَلَبا",61,"ب",2,0],["وَتَشاجَروا في قُبَّةِ الفَلَكِ الَّتي","مازالَ يَعظُمُ في النُفوسِ عَمودَها",62,"د",3,0],["وَتَشوقُني في الجِنحِ زامِرَةٌ","ما دينُها لَعِبٌ وَلا زَمرُ",63,"ر",1,0],["وَتَشابَهَت أَجسامُنا وَتَخالَفَت","أَغراضُنا فَمُغَرِّبٌ وَمُشَرِّقُ",64,"ق",1,0],["وَتَشَبَّه بِالطَيرِ تَغدو خِماصاً","وَتَعُدُّ اليَسارَ مِلءَ الحَواصِل",65,"ل",1,0],["وَتَشابُهُ الأَخلاقِ مِن مُتَباعِدي نَجرٍ","وَلَيسَ خُزَيمَةٌ مِن أَخزَمِ",66,"م",1,0],["وَتَشَكّى النَفسُ ما صابَ بِها","فَاِصبِري إِنَّكِ مِن قَومٍ صُبُر",67,"ر",1,0],["وَتشخص طول الليل أَبصاره إلى","سماء نأت عنه بعيد حدودها",68,"د",3,0],["وتشتجرُ الرُّجُمُ الهاوياتُ","وتعتنقُ الظُّلمُ الزَّاحفَه",69,"ف",2,0],["وتُشْبي شَباةُ الرّمْحِ منها كأنّها","شَباً وهْيَ لِيناً من تَرائِبِ مِكْسال",70,"ل",1,0],["وتَشَوَّفَتْ فتَطامنَتْ","أَجْيادُ أَظْبِيها الحوائِمْ",71,"م",1,0],["وَتَشْدُو فِيهِ أَطْيَارٌ","تُجَاوِبُهُنَّ أَوْتَارُ",72,"ر",1,0],["وَتَشفَى النَّفْسَ آصَالٌ","بَديعَاتٌ وَأسْحَارُ",72,"ر",1,0],["وتَشْهَدُ هَذِي الشَّمْسُ عِنْدَ غُرُوبِهَا","وَمَا حَوْلَنا مِنْ نُورِهَا المُتَفَرِّعِ",73,"ع",1,0],["وتَشْبِيبِ لاهٍ لَعُوبِ الشَّبابِ","يُناجي السّماءَ وأقْمارَها",74,"ر",3,0],["وتشتت سبل الرشا","دِ بصادِرين وواردينا",75,"ن",2,0],["وتشيع الرَّخاء في كلِّ واد","وتَصُبُّ الغِنَى بكلِّ الجهات",76,"ت",1,0],["وتَشَرَّفَتْ باسمٍ جديدٍ فادعها","حَرَمَ الإِلهِ بَلَقْتَ منه السُّولا",77,"ل",2,0],["وتشرب بالقعب الصغير وإن تقد","بمشفرها يوماً إلى الليل تنقد",78,"د",1,0],["وتُشبعُها -قُبَيْل البثِّ-","ترخيماً وترقيقا",79,"ق",2,0],["وتشدو البلابلُ في سعده","وتجري المقاديرُ في نحسه",80,"س",2,0]]}