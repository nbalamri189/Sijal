poem56182.html","المتقارب"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[456,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[456,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[459,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[459,"صدوق الشيم منهل العطايا","https://www.aldiwan.net/poem15482.html","الوافر"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[498,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[512,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[513,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[522,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[536,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[549,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[556,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[560,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[561,"إلى الله أشكو طوع نفسي للهوى","https://www.aldiwan.net/poem13617.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[585,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَتَشاكَينَ وَالشُكاةُ بُكاءٌ","وَتَنادَينَ وَالنِداءُ عَويلُ",0,"ل",1,0],["وَتَشتاقُ نَفسي حالَةً بَعدَ حالَةٍ","وَأَزجُرُها إِنّي إِذا لَقَنوعُ",1,"ع",1,0],["وَتَشهَدُ بِالعَفافِ عَلى","بَواطِنِهِ ظَواهِرُه",2,"ر",2,0],["وتُشْرِقُ بالوَرْدِ الخُدودُ نَواضِراً","إذا ابْتَسَمَتْ عن أقْحُوانٍ مُفَلَّجِ",3,"ج",1,0],["وتَشُبُّ شَعْثاءَ الفُروعِ وتَمْتَري","أخْلافَ حَرْبٍ للمَنونِ وَلودِ",4,"د",1,0],["وتَشكُو إليكَ الدَّهْرَ تَفْري خُطوبُهُ","بقيّةَ شِلْوٍ من ذَويكَ مُقَدَّدِ",5,"د",1,0],["وَتَشهَدُ لي الخَيلُ يَومَ الطِعانِ","بِأَنّي أُفَرِّقُها أَلفَ سُربَه",6,"ب",2,0],["وَتَشَرَّفَت مِن قَصرِها فَلَمَحتُها","فَلَأُسأَلَنَّ عَنِ النَعيمِ الأَكبَرِ",7,"ر",1,0],["وَتَشرَقَ بِالقولِ الَّذي قَد أَذَعتَهُ","كَما شَرِقَت صَدرُ القَناةِ مِنَ الدَمِ",8,"م",1,0],["وَتَشَاكَيَا كُلٌّ إِلَى آلامِهِ","شَكْوَى أَدَلَّ عَلَى وَفَاءِ العَانِي",9,"ي",1,0],["وَتُشعِرُهُ أَعطافَها وَتَسوفُهُ","وَتَمسَحُ مِنهُ بِالتَرائِبِ وَالنَحرِ",10,"ر",1,0],["وتشرب أنت كأس المجد صِرفاً","ويشربها سواؤك ذات مَزج",11,"ج",1,0],["وتُشرق في سماء الشعر منه","كواكب ليس يدركها مغيب",12,"ب",1,0],["وَتَشكو الماشِياتُ إِلَيكَ جَهداً","وَلا صَعبٌ لَهُنَّ وَلا ذَلولُ",13,"ل",1,0],["وَتَشاهَدَت صَيدُ المُلوكِ بِفَضلِهِ","وَأَرى المَكارِمَ مِن مَكانٍ عالِ",14,"ل",1,0],["وتشكو عقوق المعرضين وبخلهم","إليك فتلقى عندك البرّ والبحرا",15,"ر",2,0],["وتشتاق من إحسانك الحلو رسمها","ولا عجب شوق الرياض إلى القطر",16,"ر",1,0],["وتشاغلي فيما يضر وحسبه","لو لم يضرّ بأيّه لم ينفع",17,"ع",1,0],["وتشدو على عيدانها فتثير لي","كمائن وجدٍ ضمنتها الأضالع",18,"ع",1,0],["وتشرَّفت أرضٌ بموطئِ نعلهِ","وسمت حصاها فالرجوم نجوم",19,"م",1,0],["وتشرح أرض الشام فيك غرامها","بضعفِ نسيم أو حنين حمام",20,"م",1,0],["وتشتكيه من رياح الجَنْبِ","نافرةُ الصَّوت خَرُوج الضَّربِ",21,"ب",1,0],["وتشكو الخندريس أذىً إذا ما","تنفَّس في كؤوس الخندريس",22,"س",1,0],["وتشيم الأمور غير مضاهٍ","راعي الثلَّةِ النؤوم النعوقا",23,"ق",2,0],["وتشفعُ ذاك مُسمعةٌ","لنا بالسّحْرِ مُكْتحلَهْ",24,"ل",2,0],["وتشاغلٌ عن ذكر ربٍّ لم يزل","حسنَ الصنائعِ سابغَ الإنعام",25,"م",1,0],["وتَشفِي من جَوَى الأبراحِ صبّاً","يكاد يموتُ سُقماً واغتماما",26,"م",2,0],["وَتُشرِقُ أَجبالُ العَويرِ بِفاعِلٍ","إِذا خَبَتِ النيرانُ بِاللَيلِ أَوقَدا",27,"د",2,0],["وَتُشجيكَ بِأَلحانٍ","تُذيبُ الجَلمَدَ الصَلدا",28,"د",2,0],["وَتَشرِبُ أَسآرِيَ القَطا الكُدرُ بَعدَما","سَرَت قَرَباً أَحناؤُها تَتَصَلصَلُ",29,"ل",1,0],["وتشكو أَساها بَيَاضَ النَّهارِ","وتندُبُ حَظَّ الحَيَاةِ السَّخيفْ",30,"ف",1,0],["وَتُشِيدينَ في خرائبِ روحي","مَا تلاشَى في عهديَ المجدودِ",31,"د",1,0],["وتشربون به كاساً مسنمة","وتأكلون به نخلاً ورمانا",32,"ن",2,0],["وَتَشَمُّ رائِحَةَ الرُفاتِ كَريهَةً","وَتَشَمُّ مِنها الثاكِلاتُ العَنبَرا",33,"ر",2,0],["وَتَشُدُّ بَيتَ النَحلِ فَهوَ مُطَنَّبٌ","وَتَمُدُّ بَيتَ النَملِ فَهوَ مُرَوَّقُ",34,"ق",1,0],["وَتَشهَدُ ما آذَيتُ نَفساً وَلَم أَضِر","وَلَم أَبغِ في جَهري وَلا خَطَراتي",35,"ي",1,0],["وتَشَعّبَتْ طُرُقُ الضَّلالِ فَلَو","لاكُمْ مَشَوا بالشِّرْكِ والكُفْرِ",36,"ر",1,0],["وتشميع أجسادنا الباليات","بالماء كان وبالدهن تم",37,"م",1,0],["وتشتاقُه الجُرْدُ الصوافِنُ شُزَّبَاً","يجوسُ بها أرضَ العِدى فتُدَوَّخُ",38,"خ",1,0],["وَتَشاكَينا مِنَ الحُبِّ جَوى","مَلا الأَحشاءَ ناراً تَتَّقِدّ",39,"د",1,0],["وتَشريفي القيامُ إزاءَ مَلْكٍ","ملوكُ العالَمِينَ له قِيامُ",40,"م",1,0],["وتَشَقَّقَتْ قُمْصُ الشَّقيقِفَخِلْتُهُ","في الرَّوْضِ كاساتٍ مُلِئْنَ مُداما",41,"م",2,0],["وتَشرَقَ من شرقيِّ دِجلةَ بالقَنا","ضَحاضحُ أنتُم سيلُها وإِكامُ",42,"م",1,0],["وتشُقُّ العُبابَ كالحيَّةِ السَّوْ","داءِ أبقَتْ في الرَّمْلِ أثْرَ انسيابِ",43,"ب",1,0],["وتشتيتُنا شَمْلَ سِرْبِ الظِّبا","بمُدمَجةٍ مثلِ سِربِ الظِّباءِ",44,"ا",2,0],["وَتَشَوَّفَت لِذَوي مَخايِلِها المُنى","وَكَتَمنَ سُمّاً تَحتَهُنَّ نَقيعا",45,"ع",2,0],["وَتَشَتَّتَت عَنها الجُمو","عُ وَفارَقَتها الغاشِيَه",46,"ي",2,0],["وَتَشَكّى يَعقوبُ إِذ ذَهَبَت عَينا","هُ مِن حُزنِهِ وَكانَ كَظيما",47,"م",2,0],["وتشفق بعد ما تقسو فتمضي","لتقرع كل نافذةٍ وبابِ",48,"ب",1,0],["وتُشْعِلُ في جانبيها البروقُ","بريقَ السيوف تُهزّ انتضاءَ",49,"ا",2,0],["وَتَشتَري نَفسُهُ المَعروفَ بِالثَمَنِ ال","غالي وَلَو أَنَّها كانَت مِنَ الثَمَنِ",50,"ن",1,0],["وَتَشَرَّفُ العُليا وَهَل بِكَ مَذهَبٌ","عَنها وَأَنتَ عَلى المَكارِمِ قَيِّمُ",51,"م",1,0],["وتشكَّى خصرُهُ مِنْ ردفِهِ","قلتُ قَدْ أتعبنَهُ ما أثقلَكْ",52,"ك",1,0],["وتشريدَهَ