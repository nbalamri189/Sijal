.html","مجزوء الكامل"],[459,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[459,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[459,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[459,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[459,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[462,"صدوق الشيم منهل العطايا","https://www.aldiwan.net/poem15482.html","الوافر"],[465,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[501,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[515,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[516,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[525,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[539,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[552,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[559,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[563,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[564,"إلى الله أشكو طوع نفسي للهوى","https://www.aldiwan.net/poem13617.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[576,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَتَشاكَينَ وَالشُكاةُ بُكاءٌ","وَتَنادَينَ وَالنِداءُ عَويلُ",0,"ل",1,0],["وَتَشتاقُ نَفسي حالَةً بَعدَ حالَةٍ","وَأَزجُرُها إِنّي إِذا لَقَنوعُ",1,"ع",1,0],["وَتَشهَدُ بِالعَفافِ عَلى","بَواطِنِهِ ظَواهِرُه",2,"ر",2,0],["وتُشْرِقُ بالوَرْدِ الخُدودُ نَواضِراً","إذا ابْتَسَمَتْ عن أقْحُوانٍ مُفَلَّجِ",3,"ج",1,0],["وتَشُبُّ شَعْثاءَ الفُروعِ وتَمْتَري","أخْلافَ حَرْبٍ للمَنونِ وَلودِ",4,"د",1,0],["وتَشكُو إليكَ الدَّهْرَ تَفْري خُطوبُهُ","بقيّةَ شِلْوٍ من ذَويكَ مُقَدَّدِ",5,"د",1,0],["وَتَشهَدُ لي الخَيلُ يَومَ الطِعانِ","بِأَنّي أُفَرِّقُها أَلفَ سُربَه",6,"ب",2,0],["وَتَشَرَّفَت مِن قَصرِها فَلَمَحتُها","فَلَأُسأَلَنَّ عَنِ النَعيمِ الأَكبَرِ",7,"ر",1,0],["وَتَشرَقَ بِالقولِ الَّذي قَد أَذَعتَهُ","كَما شَرِقَت صَدرُ القَناةِ مِنَ الدَمِ",8,"م",1,0],["وَتَشَاكَيَا كُلٌّ إِلَى آلامِهِ","شَكْوَى أَدَلَّ عَلَى وَفَاءِ العَانِي",9,"ن",2,0],["وَتُشعِرُهُ أَعطافَها وَتَسوفُهُ","وَتَمسَحُ مِنهُ بِالتَرائِبِ وَالنَحرِ",10,"ر",1,0],["وتشرب أنت كأس المجد صِرفاً","ويشربها سواؤك ذات مَزج",11,"ج",1,0],["وتُشرق في سماء الشعر منه","كواكب ليس يدركها مغيب",12,"ب",1,0],["وَتَشكو الماشِياتُ إِلَيكَ جَهداً","وَلا صَعبٌ لَهُنَّ وَلا ذَلولُ",13,"ل",1,0],["وَتَشاهَدَت صَيدُ المُلوكِ بِفَضلِهِ","وَأَرى المَكارِمَ مِن مَكانٍ عالِ",14,"ل",1,0],["وتشكو عقوق المعرضين وبخلهم","إليك فتلقى عندك البرّ والبحرا",15,"ر",2,0],["وتشتاق من إحسانك الحلو رسمها","ولا عجب شوق الرياض إلى القطر",16,"ر",1,0],["وتشاغلي فيما يضر وحسبه","لو لم يضرّ بأيّه لم ينفع",17,"ع",1,0],["وتشدو على عيدانها فتثير لي","كمائن وجدٍ ضمنتها الأضالع",18,"ع",1,0],["وتشرَّفت أرضٌ بموطئِ نعلهِ","وسمت حصاها فالرجوم نجوم",19,"م",1,0],["وتشرح أرض الشام فيك غرامها","بضعفِ نسيم أو حنين حمام",20,"م",1,0],["وتشتكيه من رياح الجَنْبِ","نافرةُ الصَّوت خَرُوج الضَّربِ",21,"ب",1,0],["وتشكو الخندريس أذىً إذا ما","تنفَّس في كؤوس الخندريس",22,"س",1,0],["وتشيم الأمور غير مضاهٍ","راعي الثلَّةِ النؤوم النعوقا",23,"ق",2,0],["وتشفعُ ذاك مُسمعةٌ","لنا بالسّحْرِ مُكْتحلَهْ",24,"ل",2,0],["وتشاغلٌ عن ذكر ربٍّ لم يزل","حسنَ الصنائعِ سابغَ الإنعام",25,"م",1,0],["وتَشفِي من جَوَى الأبراحِ صبّاً","يكاد يموتُ سُقماً واغتماما",26,"م",2,0],["وَتُشرِقُ أَجبالُ العَويرِ بِفاعِلٍ","إِذا خَبَتِ النيرانُ بِاللَيلِ أَوقَدا",27,"د",2,0],["وَتُشجيكَ بِأَلحانٍ","تُذيبُ الجَلمَدَ الصَلدا",28,"د",2,0],["وَتَشرِبُ أَسآرِيَ القَطا الكُدرُ بَعدَما","سَرَت قَرَباً أَحناؤُها تَتَصَلصَلُ",29,"ل",1,0],["وتشكو أَساها بَيَاضَ النَّهارِ","وتندُبُ حَظَّ الحَيَاةِ السَّخيفْ",30,"ف",1,0],["وَتُشِيدينَ في خرائبِ روحي","مَا تلاشَى في عهديَ المجدودِ",31,"د",1,0],["وتشربون به كاساً مسنمة","وتأكلون به نخلاً ورمانا",32,"ن",2,0],["وَتَشَمُّ رائِحَةَ الرُفاتِ كَريهَةً","وَتَشَمُّ مِنها الثاكِلاتُ العَنبَرا",33,"ر",2,0],["وَتَشُدُّ بَيتَ النَحلِ فَهوَ مُطَنَّبٌ","وَتَمُدُّ بَيتَ النَملِ فَهوَ مُرَوَّقُ",34,"ق",1,0],["وَتَشهَدُ ما آذَيتُ نَفساً وَلَم أَضِر","وَلَم أَبغِ في جَهري وَلا خَطَراتي",35,"ت",2,0],["وتَشَعّبَتْ طُرُقُ الضَّلالِ فَلَو","لاكُمْ مَشَوا بالشِّرْكِ والكُفْرِ",36,"ر",1,0],["وتشميع أجسادنا الباليات","بالماء كان وبالدهن تم",37,"م",1,0],["وتشتاقُه الجُرْدُ الصوافِنُ شُزَّبَاً","يجوسُ بها أرضَ العِدى فتُدَوَّخُ",38,"خ",1,0],["وَتَشاكَينا مِنَ الحُبِّ جَوى","مَلا الأَحشاءَ ناراً تَتَّقِدّ",39,"د",1,0],["وتَشريفي القيامُ إزاءَ مَلْكٍ","ملوكُ العالَمِينَ له قِيامُ",40,"م",1,0],["وتَشَقَّقَتْ قُمْصُ الشَّقيقِفَخِلْتُهُ","في الرَّوْضِ كاساتٍ مُلِئْنَ مُداما",41,"م",2,0],["وتَشرَقَ من شرقيِّ دِجلةَ بالقَنا","ضَحاضحُ أنتُم سيلُها وإِكامُ",42,"م",1,0],["وتشُقُّ العُبابَ كالحيَّةِ السَّوْ","داءِ أبقَتْ في الرَّمْلِ أثْرَ انسيابِ",43,"ب",1,0],["وتشتيتُنا شَمْلَ سِرْبِ الظِّبا","بمُدمَجةٍ مثلِ سِربِ الظِّباءِ",44,"ا",2,0],["وَتَشَوَّفَت لِذَوي مَخايِلِها المُنى","وَكَتَمنَ سُمّاً تَحتَهُنَّ نَقيعا",45,"ع",2,0],["وَتَشَتَّتَت عَنها الجُمو","عُ وَفارَقَتها الغاشِيَه",46,"ي",2,0],["وَتَشَكّى يَعقوبُ إِذ ذَهَبَت عَينا","هُ مِن حُزنِهِ وَكانَ كَظيما",47,"م",2,0],["وتشفق بعد ما تقسو فتمضي","لتقرع كل نافذةٍ وبابِ",48,"ب",1,0],["وتُشْعِلُ في جانبيها البروقُ","بريقَ السيوف تُهزّ انتضاءَ",49,"ا",2,0],["وَتَشتَري نَفسُهُ المَعروفَ بِالثَمَنِ ال","غالي وَلَو أَنَّها كانَت مِنَ الثَمَنِ",50,"ن",1,0],["وَتَشَرَّفُ العُليا وَهَل بِكَ مَذهَبٌ","عَنها وَأَنتَ عَلى المَكارِمِ قَيِّمُ",51,"م",1,0],["وتشكَّى خصرُهُ مِنْ ردفِهِ","قلتُ قَدْ أتعبنَهُ ما أثقلَكْ",52,"ك",1,0],["وتشريدَهَا كُلَّ مَنْ يَدَّلِي","بِحَبْلٍ لأهْلِيكَ أو مَقْطَعِ",53,"ع",1,0],["وَتَشَتُّتَ الأَهواءِ يَخلِجُني","نَحوَ العِراقِ وَمَطلَعِ الشَمسِ",54,"س",1,0],["وَتشهدُ أنه البطلُ المُرَجَّى","إذا فَزَعَ الرُّماةُ إلى النِّبالِ",55,"ل",1,0],["وَتَشرَبُ بِالقَعبِ الصَغيرِ وَإِن تُقَد","بِمِشفَرِها يَوماً إِلى الرَحلِ تَنقَدِ",56,"د",1,0],["وتَشَرَّفَت باسمٍ جَدِيدٍ فادعُها","حَرَمَ الإِلهِ بَلَغْتَ منه السُّولا",57,"ل",2,0],["وَتَشَوَّقَت حورُ الجِنا","نِ مِنَ الخُلودِ إِلى مِثالِك",58,"ك",1,0],["وَتُشرِكُ لَيلَةَ شَهرِ الصِيام","حَلالاً كَما نَظَرَ الأَربَدُ",59,"د",1,0],["وَتَشَبَّهوا بِأَبٍ وَعَمٍّ صالِحٍ","مُتَعَبِّدَينِ لَنا وَنِعمَ العُبَّدُ",60,"د",1,0],["وَتُشرِقُ الأَرضُ مِن مَحاسِنِهِ","كَأَنَّ نوراً في الشَمسِ مُجتَلَبا",61,"ب",2,0],["وَتَشاجَروا في قُبَّةِ الفَلَكِ الَّتي","مازالَ يَعظُمُ في النُفوسِ عَمودَها",62,"د",3,0],["وَتَشوقُني في الجِنحِ زامِرَةٌ","ما دينُها لَعِبٌ وَلا زَمرُ",63,"ر",1,0],["وَتَشابَهَت أَجسامُنا وَتَخالَفَت","أَغراضُنا فَمُغَرِّبٌ وَمُشَرِّقُ",64,"ق",1,0],["وَتَشَبَّه بِالطَيرِ تَغدو خِماصاً","وَتَعُدُّ اليَسارَ مِلءَ الحَواصِل",65,"ل",1,0],["وَتَشابُهُ الأَخلاقِ مِن مُتَباعِدي نَجرٍ","وَلَيسَ خُزَيمَةٌ مِن أَخزَمِ",66,"م",1,0],["وَتَشَكّى النَفسُ ما صابَ بِها","فَاِصبِري إِنَّكِ مِن قَومٍ صُبُر",67,"ر",1,0],["وَتشخص طول الليل أَبصاره إلى","سماء نأت عنه بعيد حدودها",68,"د",3,0],["وتشتجرُ الرُّجُمُ الهاوياتُ","وتعتنقُ الظُّلمُ الزَّاحفَه",69,"ف",2,0],["وتُشْبي شَباةُ الرّمْحِ منها كأنّها","شَباً وهْيَ لِيناً من تَرائِبِ مِكْسال",70,"ل",1,0],["وتَشَوَّفَتْ فتَطامنَتْ","أَجْيادُ أَظْبِيها الحوائِمْ",71,"م",1,0],["وَتَشْدُو فِيهِ أَطْيَارٌ","تُجَاوِبُهُنَّ أَوْتَارُ",72,"ر",1,0],["وَتَشفَى النَّفْسَ آصَالٌ","بَديعَاتٌ وَأسْحَارُ",72,"ر",1,0],["وتَشْهَدُ هَذِي الشَّمْسُ عِنْدَ غُرُوبِهَا","وَمَا حَوْلَنا مِنْ نُورِهَا المُتَفَرِّعِ",73,"ع",1,0],["وتَشْبِيبِ لاهٍ لَعُوبِ الشَّبابِ","يُناجي السّماءَ وأقْمارَها",74,"ر",3,0],["وتشتت سبل الرشا","دِ بصادِرين وواردينا",75,"ن",2,0],["وتشيع الرَّخاء في كلِّ واد","وتَصُبُّ الغِنَى بكلِّ الجهات",76,"ت",1,0],["وتشتمّ فوق احمرار التراب","صدى غائما من أغاني السيوف",77,"ف",1,0],["وتشعرنا بهدير الطبول","على أنّها لم تزل تحكمُ",78,"م",1,0],["وتَشَرَّفَتْ باسمٍ جديدٍ فادعها","حَرَمَ الإِلهِ بَلَقْتَ منه السُّولا",79,"ل",2,0],["وتشرب بالقعب الصغير وإن تقد","بمشفرها يوماً إلى الليل تنقد",80,"د",1,0],["وتُشبعُها -قُبَيْل البثِّ-","ترخيماً وترقيقا",81,"ق",2,0],["وتشدو البلابلُ في سعده","وتجري المقاديرُ في نحسه",82,"س",2,0],["وتشقى على الحقد النّفوس كما انطوت","قلوب على جمر الغضا وحلوم",83,"م",1,0],["وتشهد بالذوائب منه ليلا","وفي الخدين للشمس المثالا",84,"ل",2,0],["وتشوقت أن أصلى لربي","ويدي فوق حسنها المعبود",85,"د",1,0],["وتشد ازر هواجس شعرية","من كل فاكهة بها زوجان",86,"ن",1,0],["وَتَشرَبَ مِن لَظى حَربي كُؤوساً","أَمَرَّ بِفَيِّكَ مِن سُمٍّ ذُعافِ",87,"ف",1,0],["وتشتّتت أموالهم وتحيَّرت","آراؤهم وتخاذلَ الحكماءُ",88,"ا",2,0],["وَتُشبِهُ في الخَطِّ الشَّيبةُ شَيبَةً","ونَفسُ الفَتَى في الفَهمِ تَقفُو التَّمَنِيَا",89,"ي",2,0],["وَتشُدقِى وَتَعمُّقِى وَتَفَيهُقِى","وخُشُونَتِى ومُلُوحَتِآ وَزُعَاقِى",90,"ق",2,0],["وتشب حيث توجهت عزماته","حرباً كما وصفت لنا صفين",91,"ن",1,0],["وتشوقهُ الدنيا وأنتَ صددتها","وتميلُ عنه إلى النوى ويطيقُ",92,"ق",1,0],["وتشقيق الجيوب عليك أمرٌ","يسيرٌ لا يقومُ به العزاءُ",93,"ا",2,0],["وَتُشَرِّدُ الآباءَ عَن أَبنائِهِم","فَتَعيشُ ذاتُ البَعلِ عَيشُ الأَيَّمِ",94,"م",1,0],["وتشنأ ما تأتي به السنُّ منهما","وبالأمس قد جاءت به منك فأعجب",95,"ب",1,0],["وتشخصُ أبصار وتلقي سلاحها","أيادٍ بها تومي إِليك وأكففُ",96,"ف",1,0],["وتشريف مراكيبا ولبسا","وإقطاع أقاليما ومدنا",97,"ن",2,0],["وتشبيههم عار على كل مسلم","وذنب به يلقى الإله المسبب",98,"ب",1,0],["وتشرئبُّ غصونُ الوَردِ طامِعَةً","في أن تكونَ لمَرعى نوقها عُشبا",99,"ب",2,0],["وَتُشاهدُ الأَسيافَ مَن آرائِهِ","ما لَو تَعمَّدَ حَدَّها لتفلَّلا",100,"ل",2,0],["وَتَشَبَّهو