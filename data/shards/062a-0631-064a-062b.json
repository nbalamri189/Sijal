{"poems":[[29,"ما ذات أرواق تصدى لجؤذر","https://www.aldiwan.net/poem5789.html","الطويل"],[87,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[189,"ترى ثغر ذاك الثغر بالقرب يبسم","https://www.aldiwan.net/poem14655.html","الطويل"],[201,"أخي مطلقٌ والقلب مني مشبع","https://www.aldiwan.net/poem38730.html","الطويل"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120059","المنسرح"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69423","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93599","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135733","الرجز"],[4859,"ولا عز إلا بخلع الظلام.","https://www.poetsgate.com/ViewPoem.aspx?id=207404",""],[4980,"إذا حِرتَ","https://www.poetsgate.com/ViewPoem.aspx?id=199849",""],[709,"أَتُنْكِرُ بَأْسَ أَحْدَاقِ الْعَذَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=2929",""],[5525,"عقد وسوار","https://www.poetsgate.com/ViewPoem.aspx?id=965",""],[6019,"حقيقةُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=176653",""],[6070,"تَريَّثْ باستِماعِكَ للحديثِ","https://www.poetsgate.com/ViewPoem.aspx?id=192164",""],[6079,"في العجلة الندامة!","https://www.poetsgate.com/ViewPoem.aspx?id=207376",""],[6113,"يامجنوووووووون","https://www.poetsgate.com/ViewPoem.aspx?id=12872",""],[6183,"سُدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79863&r=&rc=53",""]],"verses":[["تَرى ثَمَّ شِرباً بارِداً لا يَنالُهُ","عَلى هَولِهِ إِلّا رَدٍ أَو مُخالِسُ",0,"س",1,0],["ترى ثَم القرائح والروابي","تبارين افتنانا واختراعا",1,"ع",2,0],["تُرى ثغرُ ذاك الثغرِ بالقربِ يَبْسِمُ","فأغدو وعيشِى مثل ما كان مَعْكُمُ",2,"م",1,1],["تريث إلى أن يأتي الفرج الذي","به دينكم تشتاق نفسي لدفعه",3,"ه",1,0],["تَريّثَ حتّى اِنجابَ عثيرَ جهلها","وَلاحَت له أَغوارها وَنجودها",4,"د",3,0],["ترى ثُعبانَه الأفلاكُ تسعى","فيخفِقُ قلبُ عقرَبِها حذارا",5,"ر",2,0],["ترى ثريّ الفخار تلحق جد","واه مقلا منا بمن أثرى",6,"ر",2,0],["تَرى ثَمَرَ الخُطبانِ فِيها كَأَنَّهُ","عَلى صَفحَةِ البَيداءِ هامٌ مُدَحرَجُ",7,"ج",1,0],["تَرى ثَوب الكَمال عَلَيهِ ضاف","فَينفض حينَ يَسحبه العطارا",8,"ر",2,0],["ترى ثمارَها ترى الزروعا","ترى مواشيها ترى الضروعا",9,"ع",2,0],["تريّث فؤادي وكفّ الملام","فبعدَ السكوتِ سيحلو الكلام",10,"م",1,1],["تَرَيَّث ولا تستعجِلِ الأمرَ مُطلَقًا","وَكُن صابِرًا لا تبتئس لاستِطاله",11,"ل",2,0],["تَرَى ثعباانَهُ الأَفْلاَكُ تَسْعَى","فيخفقُ قلبُ عقربها حذارا",12,"ر",2,0],["تريثيي يا قرة العين مقدار","ما تشرب عروق القصيد الوصايف",13,"ف",1,0],["تَريَّثي .. لَم يزلْ في الوقتِ مُتَّسِعٌ","لِقُبلَةِ الحُبِّ مِنهُ نَرتوي عَسَلَهْ",14,"ل",2,0],["تَريَّثْ باستِماعِكَ للحديثِ","على قَولِ اللطيفِ أو الغثيثِ",15,"ث",1,1],["تريَّثْ إذا شئتَ العواقبَ في سِلْمِ","وفكِّرْ فإنّ العقلَ أهدى إلى العِلمِ",16,"م",1,1],["تريث لوسمحت شوي يوم السبت بالتحديد","لاتفضحنادخيل اهلك كفاناالله من شره",17,"ر",2,0],["تَرَيَّثْ وَدَعْنا نَعُدْ حَيثُ جِئنا","قُبَيلَ فَواتِ الأَوانِ فَقالْ:",18,"ل",1,0]]}