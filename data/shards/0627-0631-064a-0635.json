{"poems":[[64,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[64,"وكنت أراني مفلتا شرك الهوى","https://www.aldiwan.net/poem52468.html","الطويل"],[51,"ألا أيها القلب الكثير علائقه","https://www.aldiwan.net/poem62195.html","الطويل"],[51,"أرى صاحب الدنيا بها حيثما أما","https://www.aldiwan.net/poem64901.html","الطويل"],[107,"يقولون لي ماذا قرأت لعلهم","https://www.aldiwan.net/poem43113.html","الطويل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[107,"يقولون لي ماذا قرأت لعلهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54948&r=&rc=118",""],[369,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[422,"أقول لسعد حين لام على الهوى","https://www.aldiwan.net/poem53950.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[463,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[463,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[520,"قد كان حبي محض","https://www.aldiwan.net/poem12302.html","المجتث"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145678","البسيط"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10495","الطويل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28304","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29304","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78250","الوافر"],[4578,"تكمَّل بالتوفيق حجك والمنا","https://www.poetsgate.com/ViewPoem.aspx?id=49533",""],[5861,"ألم الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=190619",""],[5956,"أ آتي وأجلس قربك عمري؟","https://www.poetsgate.com/ViewPoem.aspx?id=206264",""]],"verses":[["أرى صدمةَ الأيامِ هبَّة ناسمٍ","وخوضَ غِمار الموتِ تهويمَ نائمِ",0,"م",1,0],["أرى صَبواتِ الحبِ قد جَدَّ جدُّهَا","وقد كان بدء الحب مَزْحَةُ عابثِ",1,"ث",1,0],["أَرى صاحِبَ الدُنيا مُقيماً بِجَهلِهِ","عَلى ثِقَةٍ مِن صاحِبٍ لا يُوافِقُه",2,"ق",2,0],["أَرى صاحِبَ الدُنيا بِها حَيثُما أَمّا","إِذا ازدادَ مالاً زادَهُ مالُهُ غَمّا",3,"م",2,1],["أَرى صُحُفاً تَزوَرُّ مِن سوءِ ما بِها","عَنِ القَومِ تَستَحيي العُيونَ الرَوانِيا",4,"ي",2,0],["أرى صُوَراً يستعبدُ النفسَ مثلُها","إذا وجدتْهُ أو رأتْهُ مُصَوَّرا",5,"ر",2,0],["أرى صُوَرَ الماضي تفزِّعني إذا","هَجَعْتُ، وتغزوني إذا كنتُ صاحيا",6,"ي",2,0],["أرى صنعاء كاسفة النواحي","وكانت منك زاهرة الجبين",7,"ن",1,0],["أرى صحفاً تزور من سوء ما بها","عن القوم تستحي العيون الروانيا",8,"ي",2,0],["أَرى صَنَعَ الأنواء أَظْهرَ حذْقَه","فَوشّعَ أَبرادَ الرّياضِ وَصبّغا",9,"غ",2,0],["أرى صبوة المشتاق دائمة المدى","فما بال صبر الصّبّ ليس يدوم",10,"م",1,0],["أرى صادحاً في صفحتيه وباغما","فيوقظ من كانَ في الطيف حالما",11,"م",2,0],["أرى صُورا وشاراتٍ حساناً","مصايدَ للطَّماعَةِ والأماني",12,"ن",2,0],["أرى صِبغة العيش عند الحسا","ن حالت مع الشعَر الحائلِ",13,"ل",1,0],["أرىْ صِباً عمرُهُ الزّمانُ","وليسَ يقْهرُهُ المشيبُ",14,"ب",1,0],["أرى صروف الليالي","ويعنها لا تراني",15,"ن",2,0],["أرى صباحا منيرا فوق جبهته","ليل كأن دجاه حالك السبج",16,"ج",1,1],["أُرَيصِعُ حَلّافٌ عَلى كُلِّ بَيعَةٍ","وَآدَرُ مُستَلقٍ بِمَكَّةَ أَعفَلُ",17,"ل",1,1],["أَرى صارِماً في كَفِّ أَشمَطَ ثائِرٍ","طَوى سِرَّهُ في الصَّدرِ فَهوَ ضَميرُ",18,"ر",1,0],["أَرى صَفحَةَ الآمالِ قَد ضاقَ أُفقُها","وَلاحَ عَلى اليَأسِ البَعيدِ مَديدا",19,"ا",1,0],["أَرى صَدر الرِسالَة عين بِر","وَما في ثَديِها أَثَر الحَنين",20,"ن",1,1],["أرى صفراً أمسى ربيعاً بقربكم","وقد وافى بغايات قصدنا",21,"ن",2,0],["أرى صوتَ روحي بالطلولِ بطولِهِ","هسيسٌ وروحي شهقةٌ بشمولِهِ",22,"ل",2,1],["أرى صورة لكِ تشغل بالي","لأنك لا شكَّ ملكٌ لغيري",23,"ر",2,0]]}