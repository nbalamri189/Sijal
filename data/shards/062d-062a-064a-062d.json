{"poems":[[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[29,"نبئت كلبا تمنى أن تسافهنا","https://www.aldiwan.net/poem6096.html","البسيط"],[91,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[85,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[56,"أما ترى راهب الأسحار قد هتفا","https://www.aldiwan.net/poem58552.html","البسيط"],[61,"يأبى إذا خطر العقيق بباله","https://www.aldiwan.net/poem51464.html","الكامل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[22,"سالت قرابين بالخيل الجياد لكم","https://www.aldiwan.net/poem21698.html","البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[48,"بفتية باصطباح الراح حذاق","https://www.aldiwan.net/poem64428.html","البسيط"],[50,"يا بنت من لم يك يهوى بنتا","https://www.aldiwan.net/poem64729.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85316","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[106,"«جحا» وقريبه","https://www.poetsgate.com/ViewPoem.aspx?id=179539",""],[167,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[167,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[176,"كعبة الحسن","https://www.aldiwan.net/poem50713.html","البسيط"],[183,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[202,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[223,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[247,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[273,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[351,"يا للهوى من لصب لم ينل وطرا","https://www.aldiwan.net/poem40793.html","البسيط"],[351,"عطفا على مستهام رق وانتحلا","https://www.aldiwan.net/poem40795.html","البسيط"],[351,"عطفا على مستهام رق وانتحبا","https://www.aldiwan.net/poem40797.html","البسيط"],[362,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[397,"عمر رضي الله عنه","https://www.aldiwan.net/poem6771.html","عموديه"],[397,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[403,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[429,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[436,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[456,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[488,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[511,"ما زلت أكذب فيك أرجاف العدى","https://www.aldiwan.net/poem67716.html","الكامل"],[513,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[527,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[549,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"]],"verses":[["حَتَّى حَلَلْتَ بِعُنْصِرِ الْمُلْكِ الَّذِي","يُرْعَى الدَّخِيلُ بِهِ وَيُكْفَى الْمُعْضِلُ",0,"ل",1,0],["حَتّى حَسِبتُكَ في الأَنا","ةِ وَالاِختِبارِ وَالاِختِيارِ",1,"ر",1,0],["حَتى حُمِلْتَ وَقَدْ حُمَّ القَضَاءُ إِلى","دَارٍ مِنَ المَسْجِدِ الأَقْصَى على كَثَبِ",2,"ب",1,0],["حتى حكت معركاً خرّت بساحته","صرعى بُيوت وأموال وآمال",3,"ل",1,0],["حَتّى حَدَونا إِلى البَلقاءِ فَلَّهُمُ","وَالذُلُّ مُجحِرُ كَلبٍ حَيثُما اِنجَحَروا",4,"ر",3,0],["حَتّى حَسِبنا أَنَّهُ يَنحَطُّ عَن","كَسَلٍ وَلَم يَكُ قَطُّ بِالكَسلانِ",5,"ن",1,0],["حَتّى حاكَ الرَبيعُ لِلرَوضِ ثَوباً","كانَ أَحلى لَدَيهِ لَو تَرتَدينَه",6,"ن",2,0],["حتى حباك باصحاب ذوي جلد","مناصرين وحتى فزت بالظفر",7,"ر",1,0],["حَتّى حَبا اللَه بَني فاطِمَةٍ","ما ماتَ دُونَهُ الأُبُوّةُ العُلا",8,"ا",1,0],["حَتّى حَوَتكَ سَماءُ النيلِ عالِيَةٍ","عَلى الغُيوثِ وَإِن كانَت مَيامينا",9,"ن",2,0],["حَتّى حَواكِ مَقابِراً وَحَوَيتِهِ","جُثَثاً فَلا غَبنٌ وَلا اِستِذمامُ",10,"م",1,0],["حَتّى حَوَتها سَماءُ النيلِ فَاِنحَدَرَت","كَالنَسرِ أَعيا فَوافى الوَكرَ فَاِعتَصَما",11,"م",2,0],["حتى حَسِبْتُ أنو شروانَ مِنْ خَوَلي","وخِلْتُ أَنَّ نَديمي عاشِرُ الخُلفا",12,"ف",2,0],["حتَّى حَسِبتُ الوَردَ من أشجارِه","عَبِقاً أو الرَّيحانَ من آصالِه",13,"ل",2,0],["حتّى حَللتَ من الإلهِ مَحلّةً","ما جازها عُمرٌ ولا عُثمانُ",14,"ن",1,0],["حَتّى حَطَمنَ بِأولي حَدِّ سُنبُكِها","عَوفَ اِبنِ بَدرٍ فَلا عَوفاً وَلا إِرَما",15,"م",2,0],["حَتّى حَواهُ كَفُّهُ أَسيراً","وَأَلبَسوهُ الوَشيَ وَالحَريرا",16,"ر",2,0],["حَتّى حَسِبتُ سَحابَهُ","نوقاً تَحامَلُ زُحَّفا",17,"ف",2,0],["حَتّى حَساها فَلَم يَلبَث وَما لَبَثَت","أَن خَرَّ مَيتاً صَريعاً ما لَهُ راقِ",18,"ق",1,0],["حَتّى حَلَلتِ في الحَشى وَحَتّى","فَتَّتِّ قَلبي مِن جَوىً فَاِنفَتّا",19,"ت",2,0],["حَتّى حَلا بك فيما قَد حلا غزلي","وأَنتَ تلك التي يحلو بها الغزل",20,"ل",1,0],["حتى حوى الجيش القرى فصارا","بين ديار العرب النصارى",21,"ر",2,0],["حتى حوى لعمر الإقليما","وحاز للإسلام أورشليما",22,"م",2,0],["حتى حباه الله بالجزيل","واختاره للوحي والتنزيل",23,"ل",1,0],["حَتَّى حَجَجْنَاهَا فَيَا لُطْفُ مَا","فِيَها لَقَيْنَا مِنْ جَزَاءِ الْنُّصَبْ",24,"ب",1,0],["حَتَّى حَلِيتِ بِهِ فَقَرَّ مُنَعَّماً","وَغَدَا تَحَرُّقُهُ تَوَهُّجَ مَاءِ",25,"ا",2,0],["حتى حسبتُ جحا ابن سينا عصرِه","أو من أقاربِ «كامل الكيلاني»",26,"ن",2,0],["حَتّى حَمى خَيلَهُ غَصباً وَساعَدَهُ","قَلبٌ جَرِيءٌ وَرَأيٌ غَيرُ ذي خَطَلِ",27,"ل",1,0],["حَتّى حَمَينا عَلى الإِسلامِ وَاِنتَدَبَت","مِنّا فَوارِسُ تَجلُو الكربَ وَالظُلما",28,"م",2,0],["حَتّى حَباني ربيعُ العَيْنِ باصِرَتي","أردْتُ أسْرِقَهُ لكنّهُ سَبَقا",29,"ق",2,0],["حتى حَوى أقصى مقامٍ ما حَوى","من قبله ملكا ولا إنسانا",30,"ن",2,0],["حتّى حسبنا نسيمَ الريح صار لظىً","يشوي القلوب وصار الظلُّ يحموما",31,"م",2,0],["حَتّى حَكمتَ فجاء حُكمُك آيةً","لِلنّاسِ طيَّ صحيفَةٍ تَتَأَلَّقُ",32,"ق",1,0],["حَتّى حَلَلتُ نُسوعَ رَحلِ مَطِيَّتي","بِفَناءِ لا بَرِمٍ وَلا مُتَغَضِّبِ",33,"ب",1,0],["حَتّى حَسَدَتْه خَصَائِصُه","والأنْفَسُ يَكْثُر حُسَّدُهُ",34,"د",2,0],["حَتّى حَكوا بِالقَنا لِحِما عَلى وَضَمِ","حَمِيَ الوَطيسُ وَخالوا وَسطَ غَيهَبِهِ",35,"ه",1,0],["حَتّى حَوى ظافِراً فيما يبادره","عَون القَضا غَير مَعصيّ بِما أَمَرا",36,"ر",2,0],["حَتّى حَوى ظافِراً فيما يحاوله","عَون القَضا غَير مَعصيّ بِما سألا",37,"ل",2,0],["حَتّى حَوى ظافِراً فيما يُراقبه","عَون القَضا غَير مَعصيّ بِما طَلَبا",38,"ب",2,0],["حتّى حطَطْنا إلى الزّوراء أرحُلَها","وعُوجُ أضلاعِها يُعدَدْن من ضُمُر",39,"ر",1,0],["حتى حملت لها كيس الطحين وفي","عينيك من أدمع محبوسة أثر",40,"ر",1,0],["حتىَ حَمْلتُ شهادتي متفوَّق","وبها انطلقتُ كفارسٍ مقدامِ",41,"م",1,0],["حَتّى حَلَلتُ بِبابِ ربعكَ آمِناً","وَالسَعدُ من خَلفي وَمِن قُدّامي",42,"ي",1,0],["حَتَّى حَصَلْتُ وما حصَّلْتُ مِنْكَ سِوى","مَلْقَى عَبُوسٍ ولَفْظٍ دُونَهُ التَّلَفُ",43,"ف",1,0],["حَتَّى حَلَلْتَ من السماءِ مراتِباً","تركَت كَواكِبَها بغيرِ مَراتِبِ",44,"ب",1,0],["حتّى حواني أوّلاً فأوّلاً","وواحدٌ أوّلُ ألفٍ في العددْ",45,"د",1,0],["حَتّى حَنى مِنّي قَناةَ المَطا","وَعَمَّمَ الرَأسَ بِلَونِ خَليس",46,"س",1,0],["حتى حسرت لناظري عن سوءةٍ","أغنت أعاديكم عن الأرجاف",47,"ف",1,0],["حتى حللت رواق عالية الذرى","أمست ذرى الهرمين عنها تقصر",48,"ر",1,0],["حَتّى حَكَى في الْغَايَهْ","تَوَاتُرَ الرِّوايَهْ",49,"ه",1,0],["حتّى حميتَ جانبَ الملكِ وقد","خِيف عليه ثَلَلٌ بعد ثَلَلْ",50,"ل",1,0]]}