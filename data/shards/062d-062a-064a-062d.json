{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[88,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[90,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[31,"نبئت كلبا تمنى أن تسافهنا","https://www.aldiwan.net/poem6096.html","البسيط"],[93,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[93,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[91,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[87,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[58,"أما ترى راهب الأسحار قد هتفا","https://www.aldiwan.net/poem58552.html","البسيط"],[63,"يأبى إذا خطر العقيق بباله","https://www.aldiwan.net/poem51464.html","الكامل"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[22,"سالت قرابين بالخيل الجياد لكم","https://www.aldiwan.net/poem21698.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[50,"بفتية باصطباح الراح حذاق","https://www.aldiwan.net/poem64428.html","البسيط"],[52,"يا بنت من لم يك يهوى بنتا","https://www.aldiwan.net/poem64729.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85316","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[108,"«جحا» وقريبه","https://www.poetsgate.com/ViewPoem.aspx?id=179539",""],[173,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[182,"كعبة الحسن","https://www.aldiwan.net/poem50713.html","البسيط"],[189,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[208,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[230,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[254,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[358,"يا للهوى من لصب لم ينل وطرا","https://www.aldiwan.net/poem40793.html","البسيط"],[358,"عطفا على مستهام رق وانتحلا","https://www.aldiwan.net/poem40795.html","البسيط"],[358,"عطفا على مستهام رق وانتحبا","https://www.aldiwan.net/poem40797.html","البسيط"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[406,"عمر رضي الله عنه","https://www.aldiwan.net/poem6771.html","عموديه"],[406,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[412,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[438,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[495,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[518,"ما زلت أكذب فيك أرجاف العدى","https://www.aldiwan.net/poem67716.html","الكامل"],[520,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[556,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54093","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62507","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64827","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79557","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77941","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108655","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108817","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76602","الكامل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119237","المنسرح"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53041","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77322","المجتث"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198480","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93650","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93922","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204756","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200216","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3113,"","https://poetry.dctabudhabi.ae/diwan/poem/29449","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108324",""],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90829","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90910","المجتث"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33691","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120365","الكامل"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105478","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52132","الكامل"],[4680,"دنياك تستهويك أم دنياها","https://www.poetsgate.com/ViewPoem.aspx?id=210882",""],[3591,"قد زار طيفك ثم ولّى مسرعاً","https://www.poetsgate.com/ViewPoem.aspx?id=149421",""],[5219,"الأماني المنشودة","https://www.poetsgate.com/ViewPoem.aspx?id=194625",""],[5295,"بَيْنَ الثُّلُوجِ","https://www.poetsgate.com/ViewPoem.aspx?id=177209",""],[5370,"خوية الذات","https://www.poetsgate.com/ViewPoem.aspx?id=87460",""],[5431,"أرجوك ياألمي ..أرجوك أن تقفا","https://www.poetsgate.com/ViewPoem.aspx?id=190391",""],[709,"حتّامَ أسألها الذّنوَّ فتنزَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=2908",""],[5490,"يادار غزة","https://www.poetsgate.com/ViewPoem.aspx?id=176357",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5674,"الرأي لي","https://www.poetsgate.com/ViewPoem.aspx?id=186942",""],[5720,"الْهِنْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=205305",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""]],"verses":[["حَتَّى حَلَلْتَ بِعُنْصِرِ الْمُلْكِ الَّذِي","يُرْعَى الدَّخِيلُ بِهِ وَيُكْفَى الْمُعْضِلُ",0,"ل",1,0],["حَتّى حَسِبتُكَ في الأَنا","ةِ وَالاِختِبارِ وَالاِختِيارِ",1,"ر",1,0],["حَتى حُمِلْتَ وَقَدْ حُمَّ القَضَاءُ إِلى","دَارٍ مِنَ المَسْجِدِ الأَقْصَى على كَثَبِ",2,"ب",1,0],["حتى حكت معركاً خرّت بساحته","صرعى بُيوت وأموال وآمال",3,"ل",1,0],["حَتّى حَدَونا إِلى البَلقاءِ فَلَّهُمُ","وَالذُلُّ مُجحِرُ كَلبٍ حَيثُما اِنجَحَروا",4,"ر",3,0],["حَتّى حَسِبنا أَنَّهُ يَنحَطُّ عَن","كَسَلٍ وَلَم يَكُ قَطُّ بِالكَسلانِ",5,"ن",1,0],["حَتّى حاكَ الرَبيعُ لِلرَوضِ ثَوباً","كانَ أَحلى لَدَيهِ لَو تَرتَدينَه",6,"ن",2,0],["حتى حباك باصحاب ذوي جلد","مناصرين وحتى فزت بالظفر",7,"ر",1,0],["حَتّى حَبا اللَه بَني فاطِمَةٍ","ما ماتَ دُونَهُ الأُبُوّةُ العُلا",8,"ا",1,0],["حَتّى حَوَتكَ سَماءُ النيلِ عالِيَةٍ","عَلى الغُيوثِ وَإِن كانَت مَيامينا",9,"ن",2,0],["حَتّى حَواكِ مَقابِراً وَحَوَيتِهِ","جُثَثاً فَلا غَبنٌ وَلا اِستِذمامُ",10,"م",1,0],["حَتّى حَوَتها سَماءُ النيلِ فَاِنحَدَرَت","كَالنَسرِ أَعيا فَوافى الوَكرَ فَاِعتَصَما",11,"م",2,0],["حتى حَسِبْتُ أنو شروانَ مِنْ خَوَلي","وخِلْتُ أَنَّ نَديمي عاشِرُ الخُلفا",12,"ف",2,0],["حتَّى حَسِبتُ الوَردَ من أشجارِه","عَبِقاً أو الرَّيحانَ من آصالِه",13,"ل",2,0],["حتّى حَللتَ من الإلهِ مَحلّةً","ما جازها عُمرٌ ولا عُثمانُ",14,"ن",1,0],["حَتّى حَطَمنَ بِأولي حَدِّ سُنبُكِها","عَوفَ اِبنِ بَدرٍ فَلا عَوفاً وَلا إِرَما",15,"م",2,0],["حَتّى حَواهُ كَفُّهُ أَسيراً","وَأَلبَسوهُ الوَشيَ وَالحَريرا",16,"ر",2,0],["حَتّى حَسِبتُ سَحابَهُ","نوقاً تَحامَلُ زُحَّفا",17,"ف",2,0],["حَتّى حَساها فَلَم يَلبَث وَما لَبَثَت","أَن خَرَّ مَيتاً صَريعاً ما لَهُ راقِ",18,"ق",1,0],["حَتّى حَلَلتِ في الحَشى وَحَتّى","فَتَّتِّ قَلبي مِن جَوىً فَاِنفَتّا",19,"ت",2,0],["حَتّى حَلا بك فيما قَد حلا غزلي","وأَنتَ تلك التي يحلو بها الغزل",20,"ل",1,0],["حتى حوى الجيش القرى فصارا","بين ديار العرب النصارى",21,"ر",2,0],["حتى حوى لعمر الإقليما","وحاز للإسلام أورشليما",22,"م",2,0],["حتى حباه الله بالجزيل","واختاره للوحي والتنزيل",23,"ل",1,0],["حَتَّى حَجَجْنَاهَا فَيَا لُطْفُ مَا","فِيَها لَقَيْنَا مِنْ جَزَاءِ الْنُّصَبْ",24,"ب",1,0],["حَتَّى حَلِيتِ بِهِ فَقَرَّ مُنَعَّماً","وَغَدَا تَحَرُّقُهُ تَوَهُّجَ مَاءِ",25,"ا",2,0],["حتى حسبتُ جحا ابن سينا عصرِه","أو من أقاربِ «كامل الكيلاني»",26,"ن",2,0],["حَتّى حَمى خَيلَهُ غَصباً وَساعَدَهُ","قَلبٌ جَرِيءٌ وَرَأيٌ غَيرُ ذي خَطَلِ",27,"ل",1,0],["حَتّى حَمَينا عَلى الإِسلامِ وَاِنتَدَبَت","مِنّا فَوارِسُ تَجلُو الكربَ وَالظُلما",28,"م",2,0],["حَتّى حَباني ربيعُ العَيْنِ باصِرَتي","أردْتُ أسْرِقَهُ لكنّهُ سَبَقا",29,"ق",2,0],["حتى حَوى أقصى مقامٍ ما حَوى","من قبله ملكا ولا إنسانا",30,"ن",2,0],["حتّى حسبنا نسيمَ الريح صار لظىً","يشوي القلوب وصار الظلُّ يحموما",31,"م",2,0],["حَتّى حَكمتَ فجاء حُكمُك آيةً","لِلنّاسِ طيَّ صحيفَةٍ تَتَأَلَّقُ",32,"ق",1,0],["حَتّى حَلَلتُ نُسوعَ رَحلِ مَطِيَّتي","بِفَناءِ لا بَرِمٍ وَلا مُتَغَضِّبِ",33,"ب",1,0],["حَتّى حَسَدَتْه خَصَائِصُه","والأنْفَسُ يَكْثُر حُسَّدُهُ",34,"د",2,0],["حَتّى حَكوا بِالقَنا لِحِما عَلى وَضَمِ","حَمِيَ الوَطيسُ وَخالوا وَسطَ غَيهَبِهِ",35,"ه",1,0],["حَتّى حَوى ظافِراً فيما يبادره","عَون القَضا غَير مَعصيّ بِما أَمَرا",36,"ر",2,0],["حَتّى حَوى ظافِراً فيما يحاوله","عَون القَضا غَير مَعصيّ بِما سألا",37,"ل",2,0],["حَتّى حَوى ظافِراً فيما يُراقبه","عَون القَضا غَير مَعصيّ بِما طَلَبا",38,"ب",2,0],["حتّى حطَطْنا إلى الزّوراء أرحُلَها","وعُوجُ أضلاعِها يُعدَدْن من ضُمُر",39,"ر",1,0],["حتى حملت لها كيس الطحين وفي","عينيك من أدمع محبوسة أثر",40,"ر",1,0],["حتىَ حَمْلتُ شهادتي متفوَّق","وبها انطلقتُ كفارسٍ مقدامِ",41,"م",1,0],["حَتّى حَلَلتُ بِبابِ ربعكَ آمِناً","وَالسَعدُ من خَلفي وَمِن قُدّامي",42,"م",2,0],["حَتَّى حَصَلْتُ وما حصَّلْتُ مِنْكَ سِوى","مَلْقَى عَبُوسٍ ولَفْظٍ دُونَهُ التَّلَفُ",43,"ف",1,0],["حَتَّى حَلَلْتَ من السماءِ مراتِباً","تركَت كَواكِبَها بغيرِ مَراتِبِ",44,"ب",1,0],["حتّى حواني أوّلاً فأوّلاً","وواحدٌ أوّلُ ألفٍ في العددْ",45,"د",1,0],["حَتّى حَنى مِنّي قَناةَ المَطا","وَعَمَّمَ الرَأسَ بِلَونِ خَليس",46,"س",1,0],["حتى حسرت لناظري عن سوءةٍ","أغنت أعاديكم عن الأرجاف",47,"ف",1,0],["حتى حللت رواق عالية الذرى","أمست ذرى الهرمين عنها تقصر",48,"ر",1,0],["حَتّى حَكَى في الْغَايَهْ","تَوَاتُرَ الرِّوايَهْ",49,"ه",1,0],["حتّى حميتَ جانبَ الملكِ وقد","خِيف عليه ثَلَلٌ بعد ثَلَلْ",50,"ل",1,0],["حتى حواهُ العدا غدراً وصار لهمْ","لغزوكمْ عمدةً من أفضل العمدِ",51,"د",1,0],["حتى حداني للندى","شهابُ فضلٍ مرشدُ",52,"د",1,0],["حتى حمت بيضة الإسلام سطوته","في عشّها بالرماح السمهريات",53,"ت",1,0],["حتى حوى قصب السباق فأبصروا","فرأوا عليه لواءه معقودا",54,"د",2,0],["حتى حفظت على العبادِ بلادَها","مِنْ رُومِها الأقصى إِلى أُحْبوشِها",55,"ش",3,0],["حتَّى حسبتُ نسيمَ الروضِ أقرأَني","كتبَ ابنِ مشكانَ عن صدرِ السلاطينِ",56,"ن",1,0],["حَتّى حباه بمن يَهوى فَعانقه","فصار للسين من حاميمه قافا",57,"ف",2,0],["حتى حظيت ببكرٍ دون مضربها","ضرب الطلى وفراق السمع والبصر",58,"ر",1,0],["حتى حظيت بكل ما","يت