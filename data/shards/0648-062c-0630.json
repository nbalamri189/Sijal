{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[32,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[47,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[99,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"جدث أريح وأستريح بلحده","https://www.aldiwan.net/poem22345.html","الكامل"],[48,"إذا لم يكن للميت أهل فقلما","https://www.aldiwan.net/poem23364.html","الطويل"],[102,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[148,"سطا جيش أهواء على من بكم لاذا","https://www.aldiwan.net/poem4459.html","الطويل"],[190,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[447,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[556,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112813","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137849",""],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132263","الوافر"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131341","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53209","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130837",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58243","الطويل"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146491","الرمل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17681","الطويل"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40115","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35105","الوافر"],[4755,"لأني كلما انزَلَقُوا ثَبَتُّ","https://www.poetsgate.com/ViewPoem.aspx?id=184178",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[4929,"لعينيك يرقصُ نبضي","https://www.poetsgate.com/ViewPoem.aspx?id=204163",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5438,"هِيَ مِنِّي وَ أَنَا مِنْهَا","https://www.poetsgate.com/ViewPoem.aspx?id=202060",""],[5486,"الدهشة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=210725",""],[5536,"إهداء إلى كل امرأه ( المطلقه )","https://www.poetsgate.com/ViewPoem.aspx?id=37058",""],[5809,"اشباه","https://www.poetsgate.com/ViewPoem.aspx?id=205191",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""]],"verses":[["وَجَذَبتَنا جَذبَ الجَريرِ إِلى العُلى","وَإِذا اِرتَقى مُتَمَطِّرٌ لَم يَنزِلِ",0,"ل",1,0],["وَجَذَبتُ بِالطولِ الَّذي لَم يَجذِبوا","وَمَتَحتُ بِالغَربِ الَّذي لَم يَمتَحوا",1,"ح",3,0],["وَجَذبُ البُرى أَمراسَ نَجرانَ رُكَّبَت","أَواخِيُّها بِالمُرأَياتِ الرَواجِفِ",2,"ف",1,0],["وَجَذيمَةَ الوَضّاحَ عَطَّلَ تاجَهُ","مِنهُ وَأَتبَعَ تُبَّعاً بِالمُنذِرِ",3,"ر",1,0],["وَجُذوَةُ حُسنٍ في الحُدودِ لَهيبُها","يَشُبُّ وَلَكِن في القُلوبِ سَعيرُها",4,"ر",3,0],["وجذبتها بذراعها نمشي","نمشي وما ندري لنا غرضا",5,"ض",2,0],["وَجِذْعُ النَّخْلِ حَنَّ حَنِينَ ثَكْلَى","لهُ فأَجابهُ نِعْمَ المُجِيبُ",6,"ب",1,0],["وَجَذَبتُ مِن مَرَسِ الحَياةِ مُغارَهُ","فَالآنَ أَخشى البَتُّ عِندَ جِذابِهِ",7,"ب",2,0],["وَجذبِ رِداءٍ يَدرُجُ النَملُ فَوقَهُ","لِتَعميمِ رَأسِ الهِبرِزِيِّ المُعَمَّمِ",8,"م",1,0],["وجذوعا ، لها وجوه ، وأذقان","وإطراقة الحمار العليف",9,"ف",1,0],["وجذبكم باللطيف يأخذ كله","على حسن تقويم ليفرح من عاذا",10,"ذ",2,0],["وجذر ثم قابل في المجصطى","ودان لفضله الضد المكيد",11,"د",1,0],["وَجَذَبتُ فَضلَ زِمامِها","عَن مَرتَعِ الطَمَعِ الوَبيلِ",12,"ل",1,0],["وجذوة نارٍ في الخدود لهيبها","تشب ولكن في القلوب وقودها",13,"د",3,0],["وجذابٌ للّذي يه","وَوْنَ إِنْ قلّ الجِذابُ",14,"ب",1,0],["وجذبوا بساطه من تحته","وأظهروا عصيانه في وقته",15,"ه",1,0],["وجذ واردات النفس بالورد في صفا","بحار جميل العلم وانزل لدى الربع",16,"ع",1,0],["وجذبت عقلك بالنياق معقلا","بزمامهن مقيدا معمودا",17,"د",2,0],["وجذب الردف مرط الساق مهما","يجاذبه انخفاض وارتفاع",18,"ع",1,0],["وجذوع النخيل مثل العذارى","مائلات مع النسيم اضطرارا",19,"ر",2,0],["وجَذْبها منكَ عطاءٌ وكرَمْ","ولا تقل لا بَعْدَ ما قُلْتَ نَعمْ",20,"م",1,0],["وجذيمة استعلى الزحام به إلى","شماء لا يسمو إليها القشعم",21,"م",1,0],["وَجَذوَةِ نارٍ دونَ ذِكرِ مَكانِها","سَريرَةُ حُبٍّ لا يُخافُ ظُهورُها",22,"ر",3,0],["وجذل الطعان الفحل وابن مكدم","فتى لم توركه الولائد شرغب",23,"ب",1,0],["وجذبتها من بين أن","ياب كاسيافٍ ذكورِ",24,"ر",1,0],["وَجَذْ لان في ظِلِّ العَريشِ مُحاولاً","جنى كُلِّ قَطْفٍ كالجُمانِ المنَضَدِ",25,"د",1,0],["وجذبنا في لبانٍ","ودفعنا بمداري",26,"ر",2,0],["وَجِذلٍ حِكاكٍ مَن يَرُمهُ مِن اِمرىءٍ","يَجِد بِذِراعَيهِ وَلَبَّتِهِ دَما",27,"م",2,0],["وجذ عرنين ذاك المجد وانفصمت","منه العرى وانحنت من ظهره الفقر",28,"ر",1,0],["وجَذَمْتَ كُلَّ يدٍ تَسور على يدٍ","فَأَحلتَ ذاكَ السُّورَ وهوَ سوارُ",29,"ر",1,0],["وَجِذمٌ في الخِلافَةِ مُستَقِرٌّ","تَمُرُّ عَلى أَصالَتِهِ الدُهورُ",30,"ر",1,0],["وجذري ناحِتٌ في الرِّيحِ, إني","لِأجلِ الرِّيحِ أَقرأُ ما نَحَتُّ",31,"ت",1,0],["وجذّوا حِبالَ الإخوّةِ إنّي","قطَعتُ علائقَ قلبي المُعَلقْ",32,"ق",1,0],["وجذبٌ تُشَدُّ القلوبُ به","وِثاقاً فتُفضي إليه أسارى",33,"ر",2,0],["وجذب البرى يبري البراء وفي الرغى","لذات رغاءٍ لا تسح بقاء",34,"ا",2,0],["وَ جِذْعُهَا جَذْوَةُ المَعْنَى، أُصَوِّرُهُ","طِفْلًا يُكَفْكِفُ دَمْعِي حِينَ أَذْرُفُهَا",35,"ف",3,0],["وجذع بكى شوقا إليه ولوعة","وماء غزير قد سقى صحبه طرا",36,"ر",2,0],["وجذبتني فوقَ السريرٍ وقلت لي","هيا استفيقي وانهظي يا قطتي",37,"ت",2,0],["وجذوةُ الشوقِ في قلبِ المحبِّ اذا","مثَّلتها ،فَهْيَ مثلُ النارِ والقَبَسِ",38,"س",1,0],["وَ جَذِيلَةُ شَعرٍ ناءِ بِها","مَتنٌ , مُذْ خَطَرَتْ يَنحَدِبُ",39,"ب",1,0],["وجِذعٌ يَحِنُّ إلي نوْرهِ","حَنيْنَ الرَّضيْع لضَمَّةِ أم",40,"م",1,0]]}