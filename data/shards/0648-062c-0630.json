{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[46,"جدث أريح وأستريح بلحده","https://www.aldiwan.net/poem22345.html","الكامل"],[46,"إذا لم يكن للميت أهل فقلما","https://www.aldiwan.net/poem23364.html","الطويل"],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[145,"سطا جيش أهواء على من بكم لاذا","https://www.aldiwan.net/poem4459.html","الطويل"],[187,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[236,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[442,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[552,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَجَذَبتَنا جَذبَ الجَريرِ إِلى العُلى","وَإِذا اِرتَقى مُتَمَطِّرٌ لَم يَنزِلِ",0,"ل",1,0],["وَجَذَبتُ بِالطولِ الَّذي لَم يَجذِبوا","وَمَتَحتُ بِالغَربِ الَّذي لَم يَمتَحوا",1,"ح",3,0],["وَجَذبُ البُرى أَمراسَ نَجرانَ رُكَّبَت","أَواخِيُّها بِالمُرأَياتِ الرَواجِفِ",2,"ف",1,0],["وَجَذيمَةَ الوَضّاحَ عَطَّلَ تاجَهُ","مِنهُ وَأَتبَعَ تُبَّعاً بِالمُنذِرِ",3,"ر",1,0],["وَجُذوَةُ حُسنٍ في الحُدودِ لَهيبُها","يَشُبُّ وَلَكِن في القُلوبِ سَعيرُها",4,"ر",3,0],["وجذبتها بذراعها نمشي","نمشي وما ندري لنا غرضا",5,"ض",2,0],["وَجِذْعُ النَّخْلِ حَنَّ حَنِينَ ثَكْلَى","لهُ فأَجابهُ نِعْمَ المُجِيبُ",6,"ب",1,0],["وَجَذَبتُ مِن مَرَسِ الحَياةِ مُغارَهُ","فَالآنَ أَخشى البَتُّ عِندَ جِذابِهِ",7,"ب",2,0],["وَجذبِ رِداءٍ يَدرُجُ النَملُ فَوقَهُ","لِتَعميمِ رَأسِ الهِبرِزِيِّ المُعَمَّمِ",8,"م",1,0],["وجذوعا ، لها وجوه ، وأذقان","وإطراقة الحمار العليف",9,"ف",1,0],["وجذبكم باللطيف يأخذ كله","على حسن تقويم ليفرح من عاذا",10,"ذ",2,0],["وجذر ثم قابل في المجصطى","ودان لفضله الضد المكيد",11,"د",1,0],["وَجَذَبتُ فَضلَ زِمامِها","عَن مَرتَعِ الطَمَعِ الوَبيلِ",12,"ل",1,0],["وجذوة نارٍ في الخدود لهيبها","تشب ولكن في القلوب وقودها",13,"د",3,0],["وجذابٌ للّذي يه","وَوْنَ إِنْ قلّ الجِذابُ",14,"ب",1,0],["وجذبوا بساطه من تحته","وأظهروا عصيانه في وقته",15,"ه",1,0]]}