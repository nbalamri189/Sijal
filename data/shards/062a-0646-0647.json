{"poems":[[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[90,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[74,"تنهدت لما أذكرتني النواهد","https://www.aldiwan.net/poem18571.html","الطويل"],[94,"على ساحل البحر أنى يضج","https://www.aldiwan.net/poem38936.html","المتقارب"],[94,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[68,"أهلا بها قوادما رواحلا","https://www.aldiwan.net/poem40943.html","الرجز"],[82,"ولما التقى الأجسام من غير ريبة","https://www.aldiwan.net/poem31416.html","الطويل"],[82,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[76,"يا رب ليل بته","https://www.aldiwan.net/poem12940.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39677","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[203,"يا للهوى والغزل","https://www.aldiwan.net/poem45354.html","مجزوء الرجز"],[228,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[234,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[240,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[240,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[287,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[422,"علي لا زلت مسرورا بسلمان","https://www.aldiwan.net/poem53863.html","البسيط"],[422,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[435,"انشا البشير لدى الجياد مجددا","https://www.aldiwan.net/poem40697.html","الكامل"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[484,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[520,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[543,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138371",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122726","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101487","الرمل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66995","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59129","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96747","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109271","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95554","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95547","المجتث"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53084","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93561","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106995","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203637","المنسرح"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67994","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48455","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102943","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75686","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4362,"","https://poetry.dctabudhabi.ae/diwan/poem/146021","البسيط"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123851","الطويل"],[4702,"علام الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155110",""],[4755,"العَمَّارُ الغَريب","https://www.poetsgate.com/ViewPoem.aspx?id=184179",""],[4755,"إِطفاؤُها صَعبٌ وإِحراقُها","https://www.poetsgate.com/ViewPoem.aspx?id=186976",""],[4830,"نَخلُ العِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207898",""],[4902,"مريض اللي فقد \"سلطان\"","https://www.poetsgate.com/ViewPoem.aspx?id=22951",""],[4984,"تَسْعَى إِلَى الْجَاهِ","https://www.poetsgate.com/ViewPoem.aspx?id=201287",""],[585,"يا نازح الدار هل أحسست بالدار","https://www.poetsgate.com/ViewPoem.aspx?id=161940",""],[5111,"مَرَاكِبُ العشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212250",""],[1420,"تنهنه وحاذر أن ينالك بغتة","https://www.poetsgate.com/ViewPoem.aspx?id=87626",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5277,"شموخُنا ليس مغروراً","https://www.poetsgate.com/ViewPoem.aspx?id=205353",""],[5278,"أرضي محلقة حولي...","https://www.poetsgate.com/ViewPoem.aspx?id=202480",""],[5284,"حكايةُ عاشقَين","https://www.poetsgate.com/ViewPoem.aspx?id=190603",""],[5431,"ماأحلى قبلته السكرى","https://www.poetsgate.com/ViewPoem.aspx?id=183054",""],[5431,"بورصة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199785",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[482,"ما لم تزوروا فالمامُ الكرى زورُ","https://www.poetsgate.com/ViewPoem.aspx?id=111256",""],[5704,"تطريز لكلمة \" إغتراب\"","https://www.poetsgate.com/ViewPoem.aspx?id=202960",""],[5725,"بان المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=212475",""],[5739,"حضن السراب","https://www.poetsgate.com/ViewPoem.aspx?id=126714",""],[5758,"مجنونة","https://www.poetsgate.com/ViewPoem.aspx?id=211576",""],[5776,"للأخضرِ المغمورِ يومٌ أحمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206107",""],[5781,"فاتِحةُ الجمالِ وأولُ جرحٍ ...أنت","https://www.poetsgate.com/ViewPoem.aspx?id=208986",""],[5848,"قصر وقبر","https://www.poetsgate.com/ViewPoem.aspx?id=48958",""],[5848,"نظرة عيون دارين","https://www.poetsgate.com/ViewPoem.aspx?id=48844",""],[5912,"هاج.الأنين","https://www.poetsgate.com/ViewPoem.aspx?id=205004",""],[5939,"عاشقةٌ من حزب الكنبة!","https://www.poetsgate.com/ViewPoem.aspx?id=180001",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[6152,"تنهدت اشتياقا","https://www.poetsgate.com/ViewPoem.aspx?id=213200",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""],[3155,"بين الجدران","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72291&r=&rc=3",""],[6245,"حالات مطرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87629&r=&rc=0",""],[6333,"جرح وقصيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7035&r=&rc=6",""],[5567,"ناسكة الأسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81812&r=&rc=62",""]],"verses":[["تَنْهَى الجَلالَةُ رَبَّهَا وَرَبِيبَهَا","عَنْ كُلِّ مَوْقِفِ سُوقَةٍ وَطَغَامِ",0,"م",1,0],["تنهال كالرمل بالنيران أدؤرها","حتى تكاد لها الأرواح تنهال",1,"ل",1,0],["تنهشها تارةً وآوانَةً","تنبح من حولها وتصطخب",2,"ب",1,0],["تنهدت لمَّا أذكرتني النواهدُ","زمان الصبى والعيش ريَّان مائد",3,"د",1,1],["تنهَّدتُ من مُهْجَةٍ أُتْرِعَتْ","بدَمْعِ الشَّقاءِ وشوْك الأَسى",4,"س",2,0],["تَنَهَّدَ اللَّيْلُ حتَّى قلتُ قَدْ نُثِرَتْ","تِلكَ النُّجومُ وماتَ الجنُّ والبَشَرُ",5,"ر",1,0],["تَنهى وَتَأمُرُ ما بَدا","لَكَ في الكَبيرِ وَفي الصَغير",6,"ر",1,0],["تَنهَضُ مِن صَرحِ الجَليلِ تَحتَها","بِأَرجُلٍ لِبَردِهِ قَوابِلا",7,"ل",2,0],["تنهّدْتُ مرتاعَ الفؤادِ وإنّما","تنهدتُ للصبح الّذي يَتَنَفَّسُ",8,"س",1,0],["تَنَهّدَ لمّا عَنّ سِرْبُ النواهِدِ","على بُعْدِ عَهْدٍ بِالصّبا والمَعاهِدِ",9,"د",1,1],["تَنهَلُّ مُزنَةُ دَمعَتي","فيهِ وَيَندى نَورُ ذِكرِك",10,"ك",1,0],["تنهدات الرياح","رتيبةٌ النواح",11,"ح",1,1],["تنَهَّدَ حينَ أبصَرَهُمْ","مُحِبٌّ مُوغَرُ الصَّدرِ",12,"ر",1,0],["تَنْهَبُ الدُرَّ مِنْ عُقودِ الغَوَانِي","ثُمَّ تَدْعُوهُ فاعِلاتُنْ فَعُولاَ",13,"ل",2,0],["تنهل العين من بشاشة سعد","ريّها والعيون تروى وتصدى",14,"د",2,0],["تنهضُ خصراً لم يزلْ","من ردفها في مللِ",15,"ل",1,0],["تنهجُ نَهجَ الطَيرِ في مَرجِهِ","لا تَنتَمي يَوماً لِغَيرِ الدَدِ",16,"د",1,0],["تَنْهاهُ عن بطشه وتأمرُه","وليس يَسْطِيعها فيَنْهاها",17,"ا",3,0],["تَنهَلُّ جوداً فَالحَبِيُّ","الجَودُ دونَ حِبائِها",18,"ا",3,0],["تَنهَلُّ مُغدِقَةً عَلى ال","عافينَ مُنبَجِساً حَياها",19,"ا",3,0],["تَنهَلُّ يُمناهُ بِجَدواهُ فَخَم","سُ بنانِهِ لِلخَلقِ خَمسَةُ أَنهُرِ",20,"ر",1,0],["تَنهَلُّ يُمناهُ بِخَمسَةِ أَبحُرٍ","وَتُلاثُ حُبوَته بِرَضوى ذي الرُبا",21,"ب",2,0],["تَنهى عَنِ السوءِ وَالفَحشاءِ تَحذِرُنا","وَحَيثُ كانَت بِما في اللَوحِ تُنذِرُنا",22,"ن",2,0],["تنهلُّ ما اعترض العافي سماحتها","فأنتَ والعارض المنهل سيّان",23,"ن",1,0],["تنهلُّ راحته بصيّبِ جودِه","عذب الموارد منهلٌ للوارد",24,"د",1,0],["تنهل من روض الجنان مياههُ","أرخ تفز واشرب هناء صافيا",25,"ي",2,0],["تنهضُ أشباحُها النواحلُ في","حاجاتنا بالجسائم العُظُمِ",26,"م",1,0],["تنهال أطواد الخطوب حوله","فلا ترى منهن خطباً هاله",27,"ل",2,0],["تنهال كالديم الكوارث إنما","تنجاب عن شمس تريك النورا",28,"ر",2,0],["تنهل في الأزمات حمة مشفق","منه وفي العزمات صولة محنق",29,"ق",1,0],["تَنَهُّدُ مَحزونٍ ورَجعُ تَنَهُّدٍ","بفرطِ سُرورٍ عادَ في القلبِ هَاويا",30,"ي",2,0],["تنهى وتأمر من تشاء بما تشا","وحليفك الفوز المجيد الاعظم",31,"م",1,0],["تَنَهَّدَت والدُّجَى طِفلٌ فَما سَكَتَت","مِن التَّنَهُدِ حَتَّى شابَ فاكتَهَلا",32,"ل",2,0],["تنهب الارضينَ سَيراً مُعجزاً","بين نَوحٍ وأَنينٍ وزفير",33,"ر",1,0],["تَنْهَى النُّهَى عَنْهُمْ ويَأْمُرُنِي الهَوَى","والنَّفْسُ تُعْرِضُ والمُنَى تَتَعرَّضُ",34,"ض",1,0],["تَنْهَلُّ أدْمُعُهَا بِوَجْنَةِ صَحْنِهَا","فَتَفِيضُ قِمَّتُهَا كَذَوْْبِ زُلاَلِ",35,"ل",1,0],["تنهى عن الحبِّ يا ناهي وتأمر بالس","سلوان فاِستبق يا ذا الآمر الناهي",36,"ا",3,0],["تنهل اثر سرى الأظعان أدمعها","وحسبها من جواها أنها سجم",37,"م",1,0],["تنهض في الصبح فلا تلاقي","غير ندى الطل على الأوراق",38,"ق",1,0],["تنهى الشؤون بحكمة","وتسهل الأمر العسير",39,"ر",1,0],["تنهدات توالت","بقلب مصر تكدُّ",40,"د",1,0],["تَنهى عَن السَب الَّذي قَد جئته","وَتَراه فعل الرَعن وَالضعفاء",41,"ا",2,0],["تنهض الطير حائمات إذا سار لح","رب في عده والعديد",42,"د",1,0],["تَنهلّ إن بخل الغمام يَمينه","فَكَأَنَّما هِيَ عارض دلّاح",43,"ح",1,0],["تنهدت والتمست نهودها","في حذر تلمسها بالأنمل",44,"ل",1,0],["تنهال مثل الرمل تحت سلالهم","وكذا الحصا هزم الجيوش برمية",45,"ه",1,0],["تنهى عن القذع باللسان ولا","ينهاك عذل أن تهلك الأمما",46,"م",2,0],["تنهبُ الأرض تهتِك العِرض","من أديم الجِبال صُمَّ حَصاها",47,"ا",3,0],["تنهدت عَن مفلّج عطر","فَهاجَ برح الجَوى تنهدها",48,"د",3,0],["تُنْهي إليْكَ بشائِرَ الفتْحِ التي","تُلْقي لديْكَ لواءَها المَعْقودا",49,"د",2,0],["تنهى القناعة إن أفارق مسقطى","والحزم يأمر أن تجاب البيد",50,"د",1,0],["تَنهَبُ الأَرضَ حَيثُ تُلقِي الوَبالا","يَتَتَبَّعنَها فَيَشفينَ حالا",51,"ا",1,0],["تنهل من علمه بين الوَرى ديم","كَما تفتح أَفواه من القرب",52,"ب",1,0],["تنهض إلى سؤدد أو رتبة وعلا","فالمجد عن كل كسلان نأى وعلا",53,"ل",2,0],["تنهدت ثم ولت أي لمعتبة","نفسي فداء عتاب في تنهدها",54,"د",3,0],["تنهد اشواقي لكم والقصائد","بها القصد انتم لا الحسان النواهد",55,"د",1,0],["تنهّد واستدار ولملم الموج وعطاني شور","يوصيني بشعر آباي واجدادي يا عزّي له",56,"ل",2,0],["تَنَهُّدُ الحَقِّ أَمْضَى طَعنَةً ويَدًا","وزَفرَةُ الحَقِّ وَيلٌ يَبْهَتُ الصَّخَبَا",57,"ب",2,0],["تَنهِيدَةُ الشَّاكِينَ أَنفاسُها","تَلويحَةُ البَاكِينَ أَعماقُها",58,"ق",3,0],["تَنهى وتَزجِرُ ماقَ عينِكَ لو بَدَتْ","منها قُطَيراتٌ تَبُلُّ محاجِرا",59,"ر",2,0],["تنهّد بالقصيد طويق .. سالت دمعة الصمان","من أنفاس القصيدة .. انصرم طلع النخل صافي",60,"ف",2,0],["تنهى وتأمر أو تعطي وتمنع ما","تشاء ، لا تقبل التقدير من أحد",61,"د",1,0],["تنهى وتأمر عن علمٍ ومعرفةٍ","وتنشد الحق في نقضٍ وإمرار",62,"ر",1,0],["تنَهّدَتْ لُغَتِي نَارًا عَلىَ كَبِدِي","آهٍ..عُيُونُ الْهَوَى جَفّتْ مَآقِيْهَا",63,"ي",3,0],["تنهنه وحاذر أن ينالك بغتة","حسام كَلامي أو كِلام حسامي",64