{"poems":[[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[74,"عاش وصلا وغيره مات صدا","https://www.aldiwan.net/poem18558.html","الطويل"],[93,"عادت رياض القوافي وهي حالية","https://www.aldiwan.net/poem8742.html","عموديه"],[93,"يا شاعرا حلو المودة","https://www.aldiwan.net/poem8762.html","عموديه"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[47,"ألما فات من تلاق تلاف","https://www.aldiwan.net/poem65153.html","الخفيف"],[77,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[50,"اسقني الراح على وجه","https://www.aldiwan.net/poem64407.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42561","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[79,"لمن طلل نائي المزار بعيده","https://www.poetsgate.com/ViewPoem.aspx?id=33818",""],[164,"ما زلن في طاعاتك الأقدار","https://www.aldiwan.net/poem59066.html","الكامل"],[173,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[190,"بعد يأسي من صاحب غدار","https://www.aldiwan.net/poem43828.html","الخفيف"],[197,"هل إلى سلوة وصبر سبيل","https://www.aldiwan.net/poem13106.html","الخفيف"],[466,"ورب قوم عدى قد فل غربهم","https://www.aldiwan.net/poem15670.html","البسيط"],[567,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70697","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62563","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59116","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96742","الرمل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80206","الرمل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73996","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46507","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77832","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77798","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89541","الرمل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84534","الخفيف"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84882","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87372","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216538",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74035","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69905","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54353","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119559","الخفيف"],[4578,"مسعاك والحج مشكورٌ ومبرورُ","https://www.poetsgate.com/ViewPoem.aspx?id=49423",""],[4955,"قلبي تألم مما كان في الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190115",""],[4968,"تعويذة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208104",""],[5376,"والفجرِ وليالٍ عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205810",""],[5956,"شوقي لك يزدادُ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182224",""],[5956,"فريد الأطرش *","https://www.poetsgate.com/ViewPoem.aspx?id=184896",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""]],"verses":[["مُسْعِدُ مَنْ يَمَّمَ سَاحَاتِهِ","إِنْ يَعْدِمِ المُسْعِدَ أَوْ يُعْدَمِ",0,"م",1,0],["مسعد الرأيِ ذابحٌ للأعادِي","فهو مهما خبرتهُ كانَ سعدا",1,"د",2,0],["مَسعودُ عيدُكَ وَالشَهرُ الجَميلُ مَعاً","قَد أَقبَلا وَأَنا في الأَرضِ أَضطَرِبُ",2,"ب",1,0],["مَسعودُ أَهوِن بِالمَشي","بِ فَما اِمَّحى إِلّا الخُضاب",3,"ب",1,0],["مسعودٍ الميمونِ طائرهُ الذي","جَدُّ المُنيخ ببابِه ميمونُ",4,"ن",1,0],["مُسعِفٌ بِالَّذي مَتى سُئِلتَهُ","عَدِمَت حَظَّها مِنَ الإِسعافِ",5,"ف",1,0],["مُسعِدي عُجْ فقد رأيتَ مَعاجي","يومَ أبكي على الدّيارِ وتبكي",6,"ك",2,0],["مُسعِرٌ في القَلبِ حُبَّي","نِ تَليداً وَطَريفا",7,"ف",2,0],["مِسْعَرٌ لِلْوَغَى أَخُو غَدَوَاتٍ","تَجْعَلُ الأَرْضَ مَأْتَماً وصِيَاحَا",8,"ح",2,0],["مَسْعُودُ مَهَّدَ فِي مِصْرَ السَّبِيلَ لَهَا","فَحازَ فَضْلَيْنِ مِنْ سَبْقٍ وَتَمْهِيدِ",9,"د",1,0],["مَسْعُودُ يَبْكِيكَ أَبْنَاءٌ بَرَرْتَ بِهِمْ","فَنُشِّئُوا نَشْأَةَ الغُرِّ الأَمَاجِيدِ",9,"د",1,0],["مسعى كل آمل غاية","وأخلق من عصب الزمان جديده",10,"د",2,0],["مسعاك في العلياء لا تقفو به","أثرا ولا تعفى له آثار",11,"ر",1,0],["مَسعُودِ الخَيلِ نَقِيِّ الذَي","لِ سَنِيِّ النَيلِ لَدى القُحَمِ",12,"م",1,0],["مسعد مؤنس ظريف ودود","رجل من بقيّة الأخيار",13,"ر",1,0],["مسعدٌ في الرَخاءِ سَمحٌ شَفيقٌ","وَلَهُ في النائِباتِ برّ وصولُ",14,"ل",1,0],["مسعى الوزير حميدٌ في مواردهِ","فأُحْمدتْ في مَساعيهِ مَصادرهُ",15,"ر",2,0],["مسعودُ وَجهٍ حيثُ سارَ ركابُهُ","كانَتْ ملائكةُ السَّما أجنادُهُ",16,"د",2,0],["مسعْى ابنِ سيفِ ابنِ سلطا","نَ في الورى خيرُ مسعى",17,"ع",2,1],["مسعداً للكرام أهل الأيادي","ذروة العز من بني سلطانِ",18,"ن",1,0],["مُسعَوَّدَةٍ سحرَ البيَانِ فَبَيْنَمَا","تَرُوقُ مَعَانِيهَا يَرُوعُ كَلاَمُهَا",19,"م",3,0],["مسعرُ الحربِ ضروب ال","هام بين الجحفلينِ",20,"ن",1,0],["مسعدي عَودي لِعلياكَ كَما","عَودَكَ السامي نَفى عَني السُهاد",21,"د",1,0],["مسعودنا الذمي في حبسكم","وصبره واهٍ كميثاقه",22,"ق",2,0],["مسعر حَرب أَصمَعي القَلب","مُؤدب العَبد حَليم الكَلب",23,"ب",1,0],["مَسعى الصفا حجر الشفا","عمر الوفا عيد الهنا",24,"ن",2,0],["مسعى الهدى عرفاته","وَصفاه بل مرواته",25,"ه",1,0],["مِسعرُ الهَيجاءِ في يَومِ الوَغى","مُمطِرُ النَعماءِ وَالأَيّامُ كُلحُ",26,"ح",1,0],["مسعد السيف بالأَنامل حملا","مسعف الضيف بالأَيادي الجسام",27,"م",1,0],["مَسعاك ما مال إِلّا لِلعُلا أَبَدا","فَلِلمَعالي أَدام اللَه مرقاكا",28,"ك",2,0],["مَسعودُ جَدٍّ قارن التَوفيقَ في","قُطرٍ غدا باليُمنِ يَزهو بِشرُهُ",29,"ر",2,0],["مِسْعافْ لَي ما بَدّل وْحَطّ","غيري وعارف ناسْ عَنْ ناس",30,"س",1,0],["مَسعاك لِلعَدل المحبّب في الوَرى","محيي وَللظلم الذَميم مبيرُ",31,"ر",1,0],["مِسعر الهيجاءِ شرّيب الطّلا","محصَد النجدةِ وهَّاب الوَرقْ",32,"ق",1,0],["مسعدُ السادات اهدى","مِن سَناهُ للبدور",33,"ر",1,1],["مسعودةٌ غدواتُهُ محمودةٌ","روحاتُهُ ميمونةٌ ضَحَواتُهُ",34,"ت",2,0],["مسعدٌ لي مقاله","فاتك لي مطاله",35,"ل",2,0],["مسعاك والحج مشكورٌ ومبرورُ","والذنب والأجر ممحوٌ ومسطورُ",36,"ر",1,1],["مسعورةٌ هيَ تمشي خلفَ قائدها","مفتونةٌ بوعودٍ ساقها الأشقى",37,"ا",1,0],["مسعى الأحبّة ضمّاتٌ تُتوّجُهَا","سحائبُ الودّ في غَيْمٍ من القُبَلِ",38,"ل",1,0],["مسعاك لا تُرضي به أحدا","فاللهُ أولى ما به تُبلي",39,"ل",2,0],["مُسْعِدي، روحي، حياتي، أمنياتي","أسألُ الرحمن يكفيك المشاقا",40,"ق",2,0],["مُسْعِدُ الدنيا فريدٌ بالغنا","دونه الفنّ انحطاطٌ ومللْ",41,"ل",1,0],["مسعاه يصبحُ ضده متهاوياً","دون الأماني في الظلام القاتمِ",42,"م",1,0]]}