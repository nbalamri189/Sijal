"مواوِيل الخلاص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88102&r=&rc=0",""],[5355,"حالة واحدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87212&r=&rc=37",""],[6242,"أرق المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87553&r=&rc=1",""],[2220,"أنا العقابُ لي المقامُ الأرفعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11528&r=&rc=402",""],[6320,"سَهْمُ العَنَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84366&r=&rc=63",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""],[6346,"ذهابٌ بلا عودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84887&r=&rc=12",""],[6349,"صُورَة جماعِيَّة لِشَخْصٍ وَاحِد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85447&r=&rc=1",""],[5567,"عتم الآهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81816&r=&rc=66",""],[6366,"آتٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86672&r=&rc=1",""]],"verses":[["أَمضي وَتَعطِفُني إِلَيكَ نَوازِعٌ","بِتَنَفُّسٍ كَتَنَفُّسِ العُشّاقِ",0,"ق",1,0],["أَمُضِرَّةٌ بِالبَدرِ طالِعَةٌ","عِندَ العُيونِ وَضَرَّةُ الشَمسِ",1,"س",1,1],["أَمَضَّتها الشَكائِمُ فَهيَ خُرسٌ","تَسيلُ لَها دَماً بَدَلَ اللُعابِ",2,"ب",1,0],["أَمضى الزَمانُ حُكمَهُ غَلّابا","أَصابَنا وَطالَ ما أَصابا",3,"ب",2,0],["أَمَضَّكَ مَا كَابَدْتَهُ مِنْ شِئُونِهَا","وَأَكْثَرِ هَاتِيكَ الشُّؤون شُجُونُ",4,"ن",1,0],["إِمْضَوا رِفَاقاً كِرَاماً حَسْبُكُمْ عِوَضاً","مَجْدٌ عَزِيزٌ عَلَى الخُطَّابِ إِن رِيمَا",5,"م",2,0],["أُمْضُوا رِفَاقاً كِراماً حَسْبُكُمُ عِوَضاً","فَخْرٌ عَزِيزٌ عَلَى الخُطَّابِ إنْ رِيمَا",6,"م",2,0],["أَمضى عَلى الهَولِ مِنَ الطَريدِ","سآء لِذي الأَجِنَّةِ الحَسودِ",7,"د",1,0],["أمضى من النصلِ في نصرِ الهدَى فإذا","سلَّت نِصال العِدَى أوقى من اليلب",8,"ب",1,0],["امض من دربي فما أحسبه","في خريف العمر إلا هينا",9,"ن",2,0],["أمضَّ ما كنتُ من أقذاءِ مَعْتَبٍة","أغضَّ ما كنتُ للإخوان أجفانا",10,"ن",2,0],["أَمضى وَأَنفَذَ مِنها وَهيَ خارِجَةٌ","مِن فيهِ كَالسَهمِ مِن أَحشاءِ مِرنانِ",11,"ن",1,0],["أَمَضروبَةٌ لَيلى عَلى أَن أَزورَها","وَمُتَّخِذٌ ذَنباً لَها أَن تَرانِيا",12,"ي",2,0],["ام ضمه البحر في احضان لجته","ام ليس للبحر مثل الام احضان",13,"ن",1,0],["إمض أنفق ماتشا واص","بر إلى يوم الحسابِ",14,"ب",1,0],["أَمضى نُفوذاً مِن زُبَي","دَةَ في الإِمارَةِ وَالأَمير",15,"ر",1,0],["أَمضى الفَريقَينِ في أَقرانِهِ ظُبَةً","وَالبيضُ هادِيَةً وَالسُمرُ ضُلّالُ",16,"ل",1,0],["أَمضى إِرادَتَهُ فَسَوفَ لَهُ قَدٌ","وَاِستَقرَبَ الأَقصى فَثَمَّ لَهُ هُنا",17,"ن",2,0],["إِمضِ في غَيرِ صُحبَةِ اللَهِ ما عِش","تَ مُلَقّىً في كُلِّ فَجٍّ وَوادِ",18,"د",1,0],["أَمضَيتُ ما أَمضَيتُ فيهِ وَلَو ثَنى","بِإِشارَةٍ أَمضَيتُ ما لَم أُمضِهِ",19,"ض",2,0],["أَمضى عَلى خَصمٍ غِرارَ لِسانِهِ","فَكَأَنَّما أَمضى غِرارَ حُسامِهِ",20,"م",2,0],["أَمضي وَصَدِّق ما إِمِرتَ فَإِنَّني","بِالصَبرِ مُحتَسِباً لِخَيرُ غُلامِ",21,"م",1,0],["أمضَى منَ القَدَرِ المَحتومِ صارِمُه","إلى النُّفوسِ وأمضى منه حامِلُه",22,"ل",2,0],["أمضي أمازحُه لأنسيه الضنى","وأقولُ في تهليلةِ الأفراحِ",23,"ح",1,0],["أَمَضَّهُ جُرحٌ دَخيلٌ بِهِ","إِنَّ الرَزايا مِن أَمَضِّ الجِراح",24,"ح",1,0],["أَمَضروبَةٌ لَيلى عَلى أَن أَزورُها","وَمُتَخِذٌ جُرماً عَلى أَن تَرانِيا",25,"ي",2,0],["امْضِ لا تُشمِتْ بنا القومَ الأُلىَ","مارسوا مِنكَ القضاءَ المُبرما",26,"م",2,0],["أَمَضَّ قُلوبَنا داءٌ دَخيلٌ","وَهُمٌّ في جَوانِحِنا لَصيقُ",27,"ق",1,0],["أَمضّت جراحاتُ الخُطوبِ قُلوبَنا","وَلَيسَ لَها في غَير كَفَّيكَ مَرهَمُ",28,"م",1,0],["امضِ في صحبِكَ إنّي ها هنا","في حِمَى اللَّهِ الأجلِّ الأعظمِ",29,"م",1,0],["أمضَّك وَجدٌ مُتلِفٌ من مُحمدٍ","ولستَ أبا سُفيانَ إن لم تَزِدْ وجدا",30,"د",2,0],["أَمضَّ حَياتي لليلى الهوى","فلست أُعالج غير الجوى",31,"ج",3,0],["أمْ ضرباتٍ قاسياتٍ تُلينْ","بهنَّ قلبَ الفظِّ والأشرسِ",32,"س",1,0],["إمضِ حتى ترى المدائنَ غرقى","وترى الكونَ زخرةً من عُبابِ",33,"ب",1,0],["إمض عبر السماءِ واطغ على الأف","لاكِ واغمرْ في الجوِّ مسرى العقابِ",33,"ب",1,0],["أم ضلّلته وهو في لهوهِ","أرجاءُ حيٍّ قبلُ ما ارتادَهُ",34,"ه",1,0],["أم ضوّأتْ سيناءُ في غسَقِ الدُّجى","وجلا النبوءةَ برْقُها المتكلمُ",35,"م",1,0],["امض قيس امض جئت تطلب نارا","أم تري جئت تشعل البيت نارا",36,"ر",2,0],["أَمْضِي على الهوْل قدْما لا ينهنِهني","وأَنثنِي لسفِيهي وهْو حرْدانُ",37,"ن",1,0],["أُمْضِي بِهِ الْهَوْلَ مِقْدَامَاً وَيَصْحَبُنِي","مَاضِي الْغِرَارِ إِذَا مَا اسْتَفْحَلَ الْوَهَلُ",38,"ل",1,0],["امْضُوا دُعَاةً لِلهُدَى وَاسْتَنْصِفُوا","بِالحَقِّ لِلْبَلَدِ العَزِيزِ الْجَارِ",39,"ر",1,0],["إِمْضِ فِي الْجِدِّ وَانْتَهِزْ","فُرَصَ المَجدْدِ مَا تُتَحْ",40,"ح",1,0],["أَمْضَى مَلِيكٍ تَوَلّى","إِدَارَةً وَقَضَاءَ",41,"ا",2,0],["أمضى وأنفذ منك إذ","تثبين للأمر العصيب",42,"ب",1,0],["أَمْضُوا الْجُهُودَ وأخْلِصُوا لِبلادِكُمْ","في الْجَهْدِ والإِخْلاص كلُّ نَجاحِ",43,"ح",1,0],["أمضَى لدعوةِ صارخٍ","من لمح كرّات الخواطرْ",44,"ر",1,0],["أمضى سواد الليل، وهْ","ولكل شاردة طَلَوب",45,"ب",1,0],["أمضغ القات كي أبيت حزينا","والقوافي تهمي أسّى غير قاتي",46,"ت",2,0],["إمض يا جندي ومزقهم نعم","فرصة أخرج ، أرمي السلطنه",47,"ن",2,0],["أمضّ الأسى أن تجوز الخطوب","وأشكو فلا أجد المسعدا",48,"د",2,0],["أمضيت حاجة عشرقٍ","برِق الحمامة وارْعَدِ",49,"د",1,0],["أمضِ فينا القانونَ لا فرق فيهِ","بين زيد من الرعايا وعمرو",50,"ر",2,0],["أمضيت ما قالوا وأنت مقلد","فأتيت معروفا وجاؤا منكرا",51,"ر",2,0],["أَم ضِعافٌ عَن ثَأرِكُم فَتَلَذّوا","مَشرَبَ الذُلِّ وَالضَعيفُ الذَليلُ",52,"ل",1,0],["أَمضى مِن الصِّمصامِ عَزماً وَالدِما","تَكسو المَناكِبَ وَالنُفوسُ تُسَلَّبُ",53,"ب",1,0],["أُمضي عَلى السَيفِ عَزماً حينَ تُبصِرُهُ","مِثلَ الجِداءِ إِذا ما بَلَّها المَطَرُ",54,"ر",1,0],["أَمضى إِذا ما هَمَّ مِن ذِي رَونَقٍ","صافي الحَديدَةِ ذي فِرِندٍ مُنصلِ",55,"ل",1,0],["أَمضى عَلى الأَهوالِ مِن ذي رَونَقٍ","صافي الحَديدَةِ مِخذَمٍ صَمصامِ",56,"م",1,0],["أَمْضِي منَ الأَجَلِ المُعَجَّلِ أَمْرُنا","يَأْتِيكَ قَبْلَ الفِكْرِ والأَوْهَامِ",57,"م",1,0],["أَمضى مِن السَّهمِ المذلَّقِ نَظرَةً","في كُلِّ مُشكِلَةٍ وَأَفتَكَ مقتَلا",58,"ل",2,0],["أمضرَّجٌ بدمائه هي ميتة","وَقْفٌ عليها السيد القمقام",59,"م",1,0],["أَمْضَى نوافذَ حُكْمِهِ حتَّى على","صَرْفِ الحوادثِ فهي لا تتنكر",60,"ر",1,0],["أمضى وأنفذ في القلو","ب من الخناجر في الحناجر",61,"ر",1,0],["أمضى 