{"poems":[[53,"لولا يذم الركب عندك موقفي","https://www.aldiwan.net/poem29948.html","الكامل"],[53,"أمضرة بالبدر طالعة","https://www.aldiwan.net/poem30185.html","الكامل"],[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[93,"هو العيش جهد طائل وفتون","https://www.aldiwan.net/poem11186.html","الطويل"],[93,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[93,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[30,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[72,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[95,"رسالتها المترجمة","https://www.aldiwan.net/poem60152.html","عموديه"],[51,"إني لأغضي عن الزلات أثبتها","https://www.aldiwan.net/poem66380.html","البسيط"],[91,"لا نبغيض الروس لكن لا نحبهم","https://www.aldiwan.net/poem62766.html","عموديه"],[32,"أتاني عن مروان بالغيب أنه","https://www.aldiwan.net/poem27812.html","الطويل"],[89,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[85,"وركوبي يا صديقي وذهابي وإيابي","https://www.aldiwan.net/poem6956.html","مجزوء الرمل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[43,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[45,"يا ثقيلا على القلوب إذا عن","https://www.aldiwan.net/poem63535.html","الوافر"],[45,"أما الشباب فقد سبقت بغضه","https://www.aldiwan.net/poem64623.html","الكامل"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[97,"فيم الغدو غداً وأين رواحي","https://www.aldiwan.net/poem24401.html","الكامل"],[74,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[105,"من ينم عن لهذم أو مخذم","https://www.aldiwan.net/poem44193.html","الرمل"],[105,"تأن ابن حرب لست في مثلها جلدا","https://www.aldiwan.net/poem44214.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85645","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30497","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[50,"عجِّلْ أَبَا مُحمَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21814",""]],"verses":[["أَمضي وَتَعطِفُني إِلَيكَ نَوازِعٌ","بِتَنَفُّسٍ كَتَنَفُّسِ العُشّاقِ",0,"ق",1,0],["أَمُضِرَّةٌ بِالبَدرِ طالِعَةٌ","عِندَ العُيونِ وَضَرَّةُ الشَمسِ",1,"س",1,1],["أَمَضَّتها الشَكائِمُ فَهيَ خُرسٌ","تَسيلُ لَها دَماً بَدَلَ اللُعابِ",2,"ب",1,0],["أَمضى الزَمانُ حُكمَهُ غَلّابا","أَصابَنا وَطالَ ما أَصابا",3,"ب",2,0],["أَمَضَّكَ مَا كَابَدْتَهُ مِنْ شِئُونِهَا","وَأَكْثَرِ هَاتِيكَ الشُّؤون شُجُونُ",4,"ن",1,0],["إِمْضَوا رِفَاقاً كِرَاماً حَسْبُكُمْ عِوَضاً","مَجْدٌ عَزِيزٌ عَلَى الخُطَّابِ إِن رِيمَا",5,"م",2,0],["أُمْضُوا رِفَاقاً كِراماً حَسْبُكُمُ عِوَضاً","فَخْرٌ عَزِيزٌ عَلَى الخُطَّابِ إنْ رِيمَا",6,"م",2,0],["أَمضى عَلى الهَولِ مِنَ الطَريدِ","سآء لِذي الأَجِنَّةِ الحَسودِ",7,"د",1,0],["أمضى من النصلِ في نصرِ الهدَى فإذا","سلَّت نِصال العِدَى أوقى من اليلب",8,"ب",1,0],["امض من دربي فما أحسبه","في خريف العمر إلا هينا",9,"ن",2,0],["أمضَّ ما كنتُ من أقذاءِ مَعْتَبٍة","أغضَّ ما كنتُ للإخوان أجفانا",10,"ن",2,0],["أَمضى وَأَنفَذَ مِنها وَهيَ خارِجَةٌ","مِن فيهِ كَالسَهمِ مِن أَحشاءِ مِرنانِ",11,"ن",1,0],["أَمَضروبَةٌ لَيلى عَلى أَن أَزورَها","وَمُتَّخِذٌ ذَنباً لَها أَن تَرانِيا",12,"ي",2,0],["ام ضمه البحر في احضان لجته","ام ليس للبحر مثل الام احضان",13,"ن",1,0],["إمض أنفق ماتشا واص","بر إلى يوم الحسابِ",14,"ب",1,0],["أَمضى نُفوذاً مِن زُبَي","دَةَ في الإِمارَةِ وَالأَمير",15,"ر",1,0],["أَمضى الفَريقَينِ في أَقرانِهِ ظُبَةً","وَالبيضُ هادِيَةً وَالسُمرُ ضُلّالُ",16,"ل",1,0],["أَمضى إِرادَتَهُ فَسَوفَ لَهُ قَدٌ","وَاِستَقرَبَ الأَقصى فَثَمَّ لَهُ هُنا",17,"ن",2,0],["إِمضِ في غَيرِ صُحبَةِ اللَهِ ما عِش","تَ مُلَقّىً في كُلِّ فَجٍّ وَوادِ",18,"د",1,0],["أَمضَيتُ ما أَمضَيتُ فيهِ وَلَو ثَنى","بِإِشارَةٍ أَمضَيتُ ما لَم أُمضِهِ",19,"ض",2,0],["أَمضى عَلى خَصمٍ غِرارَ لِسانِهِ","فَكَأَنَّما أَمضى غِرارَ حُسامِهِ",20,"م",2,0],["أَمضي وَصَدِّق ما إِمِرتَ فَإِنَّني","بِالصَبرِ مُحتَسِباً لِخَيرُ غُلامِ",21,"م",1,0],["أمضَى منَ القَدَرِ المَحتومِ صارِمُه","إلى النُّفوسِ وأمضى منه حامِلُه",22,"ل",2,0],["أمضي أمازحُه لأنسيه الضنى","وأقولُ في تهليلةِ الأفراحِ",23,"ح",1,0],["أَمَضَّهُ جُرحٌ دَخيلٌ بِهِ","إِنَّ الرَزايا مِن أَمَضِّ الجِراح",24,"ح",1,0],["أَمَضروبَةٌ لَيلى عَلى أَن أَزورُها","وَمُتَخِذٌ جُرماً عَلى أَن تَرانِيا",25,"ي",2,0],["امْضِ لا تُشمِتْ بنا القومَ الأُلىَ","مارسوا مِنكَ القضاءَ المُبرما",26,"م",2,0],["أَمَضَّ قُلوبَنا داءٌ دَخيلٌ","وَهُمٌّ في جَوانِحِنا لَصيقُ",27,"ق",1,0],["أَمضّت جراحاتُ الخُطوبِ قُلوبَنا","وَلَيسَ لَها في غَير كَفَّيكَ مَرهَمُ",28,"م",1,0],["امضِ في صحبِكَ إنّي ها هنا","في حِمَى اللَّهِ الأجلِّ الأعظمِ",29,"م",1,0],["أمضَّك وَجدٌ مُتلِفٌ من مُحمدٍ","ولستَ أبا سُفيانَ إن لم تَزِدْ وجدا",30,"د",2,0],["أَمضَّ حَياتي لليلى الهوى","فلست أُعالج غير الجوى",31,"ج",3,0],["أمْ ضرباتٍ قاسياتٍ تُلينْ","بهنَّ قلبَ الفظِّ والأشرسِ",32,"س",1,0],["إمضِ حتى ترى المدائنَ غرقى","وترى الكونَ زخرةً من عُبابِ",33,"ب",1,0],["إمض عبر السماءِ واطغ على الأف","لاكِ واغمرْ في الجوِّ مسرى العقابِ",33,"ب",1,0],["أم ضلّلته وهو في لهوهِ","أرجاءُ حيٍّ قبلُ ما ارتادَهُ",34,"ه",1,0],["أم ضوّأتْ سيناءُ في غسَقِ الدُّجى","وجلا النبوءةَ برْقُها المتكلمُ",35,"م",1,0],["امض قيس امض جئت تطلب نارا","أم تري جئت تشعل البيت نارا",36,"ر",2,0],["أَمْضِي على الهوْل قدْما لا ينهنِهني","وأَنثنِي لسفِيهي وهْو حرْدانُ",37,"ن",1,0],["أُمْضِي بِهِ الْهَوْلَ مِقْدَامَاً وَيَصْحَبُنِي","مَاضِي الْغِرَارِ إِذَا مَا اسْتَفْحَلَ الْوَهَلُ",38,"ل",1,0],["امْضُوا دُعَاةً لِلهُدَى وَاسْتَنْصِفُوا","بِالحَقِّ لِلْبَلَدِ العَزِيزِ الْجَارِ",39,"ر",1,0],["إِمْضِ فِي الْجِدِّ وَانْتَهِزْ","فُرَصَ المَجدْدِ مَا تُتَحْ",40,"ح",1,0],["أَمْضَى مَلِيكٍ تَوَلّى","إِدَارَةً وَقَضَاءَ",41,"ا",2,0],["أمضى وأنفذ منك إذ","تثبين للأمر العصيب",42,"ب",1,0],["أَمْضُوا الْجُهُودَ وأخْلِصُوا لِبلادِكُمْ","في الْجَهْدِ والإِخْلاص كلُّ نَجاحِ",43,"ح",1,0],["أمضَى لدعوةِ صارخٍ","من لمح كرّات الخواطرْ",44,"ر",1,0],["أمضى سواد الليل، وهْ","ولكل شاردة طَلَوب",45,"ب",1,0],["أمضيت حاجة عشرقٍ","برِق الحمامة وارْعَدِ",46,"د",1,0]]}