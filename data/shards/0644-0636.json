{"poems":[[53,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[77,"نووا سفرا عني الغداة وأزمعوا","https://www.aldiwan.net/poem35980.html","الطويل"],[73,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[51,"وليس حراما شتم من كان مفحما","https://www.aldiwan.net/poem66352.html","الطويل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[48,"لضوء برق ظللت مكتإبا","https://www.aldiwan.net/poem10770.html","المنسرح"],[46,"تنكر صالح فضباب قيس","https://www.aldiwan.net/poem22866.html","الوافر"]],"verses":[["لَضاعَ بُكاءُ مَن يَبكيكَ شَجواً","ضَياعَ الدَمعِ بِالطَلَلِ الطَماسِ",0,"س",1,0],["لَضَيّعْتُ قَلْبي ثمّ أصْبَحْتُ ناشِداً","وقدْ قِيلَ أوْلَى بالخَسارِ المُضَيِّعُ",1,"ع",1,0],["لَضاعَفَ مِن شَرَفِ النَيِّرَي","نِ حَظّاً بِهِ قارَنَ الأَسعُدا",2,"د",2,0],["لضحكةٌ منه أوْلى أن أُسَرَّ بها","من ضحكة الروض وشَّى بردَهُ الزهرُ",3,"ر",1,0],["لَضَلَلتُ إن أمَّلتُ مرجع ما مضى","أو منطق الربع الأصم الأخرس",4,"س",1,0],["لَضعْفٌ وإعزارٌ أقَلُّ مضرةً","منَ الأيْدِ أُوتاهُ ولي منه ضائم",5,"م",1,0],["لَضَرَبْنَ لِلأمْثالِ لابنِ نِفايَةٍ","مِنْ كثرةِ الأَبقارِ والأَغْنامِ",6,"م",1,0],["لِضَوءِ بَرقٍ ظَلَلتَ مُكتَإِباً","شَقَّ سَناهُ في الجَوِّ وَاِلتَهَبا",7,"ب",2,1],["لِضَربَةُ فارِسٍ في يَومِ حَربٍ","تُطيرُ الرَوحَ مِنكَ مَعَ الفِراشِ",8,"ش",1,0]]}