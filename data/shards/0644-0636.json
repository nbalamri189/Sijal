tsgate.com/ViewPoem.aspx?id=130337",""],[6082,"فتاة شرقية","https://www.poetsgate.com/ViewPoem.aspx?id=60252",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""]],"verses":[["لَضاعَ بُكاءُ مَن يَبكيكَ شَجواً","ضَياعَ الدَمعِ بِالطَلَلِ الطَماسِ",0,"س",1,0],["لَضَيّعْتُ قَلْبي ثمّ أصْبَحْتُ ناشِداً","وقدْ قِيلَ أوْلَى بالخَسارِ المُضَيِّعُ",1,"ع",1,0],["لَضاعَفَ مِن شَرَفِ النَيِّرَي","نِ حَظّاً بِهِ قارَنَ الأَسعُدا",2,"د",2,0],["لضحكةٌ منه أوْلى أن أُسَرَّ بها","من ضحكة الروض وشَّى بردَهُ الزهرُ",3,"ر",1,0],["لَضَلَلتُ إن أمَّلتُ مرجع ما مضى","أو منطق الربع الأصم الأخرس",4,"س",1,0],["لَضعْفٌ وإعزارٌ أقَلُّ مضرةً","منَ الأيْدِ أُوتاهُ ولي منه ضائم",5,"م",1,0],["لَضَرَبْنَ لِلأمْثالِ لابنِ نِفايَةٍ","مِنْ كثرةِ الأَبقارِ والأَغْنامِ",6,"م",1,0],["لِضَوءِ بَرقٍ ظَلَلتَ مُكتَإِباً","شَقَّ سَناهُ في الجَوِّ وَاِلتَهَبا",7,"ب",2,1],["لِضَربَةُ فارِسٍ في يَومِ حَربٍ","تُطيرُ الرَوحَ مِنكَ مَعَ الفِراشِ",8,"ش",1,0],["لِضاحِيَةِ الشَمسِ في رَأسِهِ","شُعاعٌ يُلَألِئُ كَالكَوكَبِ",9,"ب",1,0],["لِضَيفٍ قَد أَلَمَّ بِها عِشاءً","عَلى الخَسفِ المُبَيِّنِ وَالجُدوبِ",10,"ب",1,0],["لضَربهم انفكّت قيودٌ ثقيلةٌ","وهدَّم سورَ الظلمِ ترديدُ صيحة",11,"ه",1,0],["لضَيفِ النّدَى يُمسي بأَفنائِكَ القِرَى","وخَيْلِ العُلا يُضْحِي بأبوابك الربط",12,"ط",1,0],["لِضاربِ هاماتٍ يَعزُّ منالُها","مُغيِّرِ حالات يَبينُ اختِلالُها",13,"ل",3,0],["لضرت بنظمك السنن اللواتي","بنور شموسها هُدَى الأنام",14,"م",1,0],["لضياء الدين ذكر وثناء","وطدته في البرايا المكرمات",15,"ت",1,0],["لضريحِ إبراهيمَ نخلةَ رحمةٌ","مِن ربهِّ الرَّحمنِ وَهْوَ صَفيُّهُ",16,"ه",1,1],["لضل عن الإرشاد بعد سلوكه","وخال رشاداً ذاك بعد الترهب",17,"ب",1,0],["لضربُ الطُّلَى بالسيف والخدشُ بالمُدى","أحبُّ إلى ذى العقلِ منْ خدش عرضه",18,"ض",2,0],["لضعفنا وعجوزنا قل العدد","وفقرنا لفضله جلّ المدد",19,"د",1,0],["لِضِرابِ بِيْضِ سُيوفِهِ","وطِعانِ سُمْرِ رِماحِهِ",20,"ح",2,0],["لضيق الغلائل فعْم الخلاخِلِ","طاوي الأياطل عالي الكفلْ",21,"ل",1,0],["لضريح نمساويِّ قومٍ دينه","دين اللتينيين يا ابن المجد عجْ",22,"ج",1,1],["لَضَعيفٍ ما ضَمَّت جَوانِحُ صَدرِهِ","إِن لَم يَكُفُّ إِلى الجُنودِ جُنودا",23,"د",2,0],["لضمّا أَناخَ أَميرُ المُؤمِنينَ بِهِم","وَالخَيلُ عابِسَةٌ وَالمَوتُ مُكتَنِعُ",24,"ع",1,0],["لضاق الفضاء على أهله","ولم يك ناس ولا منزل",25,"ل",1,0],["لضيا الشمس من علاك اقتباس","ولصفو الزمان منك ائتناس",26,"س",1,1],["لضاعفت حكم السجن ان رضيت به","وأبقيت إن شاءت قيودي في رجلي",27,"ل",2,0],["لِضَيفهمِ البشرُ الَّذي لهمُ بِهِ","لطيب سجاياهم فبِشرٌ على بِشرِ",28,"ر",1,0],["لضريح سيدة المكارم بادروا","زمراً وأفواجاً لأكرم مطلب",29,"ب",1,0],["لضربت في شوط المجل","لي آمِلا أَن يبدعا",30,"ع",2,0],["لضمّ على أحشائِها رُكباتِها","وقال رِدي قبلَ الحياضِ جِناني",31,"ن",2,0],["لضم ولضلض دل العوض لعض ال","علوض علض فهذي ضادها حفظا",32,"ظ",2,0],["لضرورة لا تنقضي أَيامُها","أَو حيلة طالَت وَلم تَكُ تَنتهي",33,"ي",1,0],["لضعيف النخاع إن رمي اليو","مَ بخيل كأنها الأشلاءُ",34,"ا",2,0],["لضمانه رزق الأنام تكفلاً","طوعاً وحبس الصامتين يليق",35,"ق",1,0],["لضريحهِ سُقيا السّحاب فإنْ يغبْ","تحضَرْ لرحمةِ رَبِّه سَقْيانُهُ",36,"ه",1,0],["لضربة أو غيرها خُذْ لها الْ","إثمدَ مسحوقاً وفيها ذرِ",37,"ر",1,0],["لضفة ثانية واحمل عليها موجزي في اكتاب","حروفٍ للورى تحوي حروب اليوم خضناها",38,"ا",3,0],["لضيعة القدس في بغداد ما انتبهوا","ولا الشآم .. فقوموا واجرعوا الندما",39,"م",2,0],["لضيف قلبك فضت مصخر واكرمت","وانا بضمى بعَدك وهالحين رويان",40,"ن",1,0],["لضيوفنا لا شك تقدير واكبار","في جو صيفي وجونا فيه ناري",41,"ر",2,0],["لِضَيْفَيْهِ عِيدُ الجُرْحِ قالَ : تفَضَّلاَ","فَذا كُوخِيَ النَّاجي من الحربِ والبَلاَ",42,"ل",2,1],["لضربةِ شمسٍ بشاطئ الرَّاحهْ","وشُرْبِ المُلوحةِ بأوسعِ مشرَبِ",43,"ب",1,0],["لضحكةِ وجهها المنسوجِ فجراً","لرِقّة قلبها الوَرِعِ الّلهوفِ",44,"ف",1,0],["لضاحكةٍ كسّرت صوتَها","فأينعَ فيه النبيذُ الحلالْ",45,"ل",1,0],["لضغاثك اضلال واوهامك لهااعناقي","نادمت الاوهام لاتطلق مناطقها",46,"ق",3,0],["لضية وثيقها حريقها","وقودها يقودها رقيقها",47,"ق",3,0],["لضيوفِ بيتِ اللهِ حتىٰ غادروا","فسَموا بأعينِ سائرِ العُبَّادِ",48,"د",1,0],["لضَجيجِ رُوحي في السكونِ مهابةٌ","ودمايَ ذي جَيشانِ يصطرعانِ",49,"ن",1,0],["لضيفٍ تباريه الأهازيجُ بهجة","وطيفٍ عليه الدمع مذْ بانَ رقراقُ",50,"ق",1,0],["لضربتُ ظَهر العيسِ في فلواتها","حتى تبلِّغني مُناي كما أرى",51,"ر",2,0],["لضامرات البطون ومترفات الدلال","بالتغنّج ، دلعهن ، عالي ، المستوى",52,"و",2,0],["لضفاف بحورٍ هادئةٍ","لكروم العشق الخمرية",53,"ي",2,0],["لضفائرٍ رحلتْ أصُبُّ واحتسي","ذكرى الطفولة والامومة ساهرا",54,"ر",2,0]]}