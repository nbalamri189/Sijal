{"poems":[[53,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[77,"نووا سفرا عني الغداة وأزمعوا","https://www.aldiwan.net/poem35980.html","الطويل"],[73,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[51,"وليس حراما شتم من كان مفحما","https://www.aldiwan.net/poem66352.html","الطويل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[48,"لضوء برق ظللت مكتإبا","https://www.aldiwan.net/poem10770.html","المنسرح"],[46,"تنكر صالح فضباب قيس","https://www.aldiwan.net/poem22866.html","الوافر"],[195,"أحب القرينة لم تصحب","https://www.aldiwan.net/poem54399.html","المتقارب"],[249,"تغيرت المنازل بالكثيب","https://www.aldiwan.net/poem2130.html","الوافر"],[270,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[364,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[371,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[403,"صفي الدين قد وافى النظام","https://www.aldiwan.net/poem33417.html","الوافر"],[437,"أترى حان لكم نحوي التفات","https://www.aldiwan.net/poem2562.html","الرمل"],[562,"لضريح إبراهيم نخلة رحمة","https://www.aldiwan.net/poem52649.html","الكامل"],[587,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["لَضاعَ بُكاءُ مَن يَبكيكَ شَجواً","ضَياعَ الدَمعِ بِالطَلَلِ الطَماسِ",0,"س",1,0],["لَضَيّعْتُ قَلْبي ثمّ أصْبَحْتُ ناشِداً","وقدْ قِيلَ أوْلَى بالخَسارِ المُضَيِّعُ",1,"ع",1,0],["لَضاعَفَ مِن شَرَفِ النَيِّرَي","نِ حَظّاً بِهِ قارَنَ الأَسعُدا",2,"د",2,0],["لضحكةٌ منه أوْلى أن أُسَرَّ بها","من ضحكة الروض وشَّى بردَهُ الزهرُ",3,"ر",1,0],["لَضَلَلتُ إن أمَّلتُ مرجع ما مضى","أو منطق الربع الأصم الأخرس",4,"س",1,0],["لَضعْفٌ وإعزارٌ أقَلُّ مضرةً","منَ الأيْدِ أُوتاهُ ولي منه ضائم",5,"م",1,0],["لَضَرَبْنَ لِلأمْثالِ لابنِ نِفايَةٍ","مِنْ كثرةِ الأَبقارِ والأَغْنامِ",6,"م",1,0],["لِضَوءِ بَرقٍ ظَلَلتَ مُكتَإِباً","شَقَّ سَناهُ في الجَوِّ وَاِلتَهَبا",7,"ب",2,1],["لِضَربَةُ فارِسٍ في يَومِ حَربٍ","تُطيرُ الرَوحَ مِنكَ مَعَ الفِراشِ",8,"ش",1,0],["لِضاحِيَةِ الشَمسِ في رَأسِهِ","شُعاعٌ يُلَألِئُ كَالكَوكَبِ",9,"ب",1,0],["لِضَيفٍ قَد أَلَمَّ بِها عِشاءً","عَلى الخَسفِ المُبَيِّنِ وَالجُدوبِ",10,"ب",1,0],["لضَربهم انفكّت قيودٌ ثقيلةٌ","وهدَّم سورَ الظلمِ ترديدُ صيحة",11,"ه",1,0],["لضَيفِ النّدَى يُمسي بأَفنائِكَ القِرَى","وخَيْلِ العُلا يُضْحِي بأبوابك الربط",12,"ط",1,0],["لِضاربِ هاماتٍ يَعزُّ منالُها","مُغيِّرِ حالات يَبينُ اختِلالُها",13,"ل",3,0],["لضرت بنظمك السنن اللواتي","بنور شموسها هُدَى الأنام",14,"م",1,0],["لضياء الدين ذكر وثناء","وطدته في البرايا المكرمات",15,"ت",1,0],["لضريحِ إبراهيمَ نخلةَ رحمةٌ","مِن ربهِّ الرَّحمنِ وَهْوَ صَفيُّهُ",16,"ه",1,1],["لضل عن الإرشاد بعد سلوكه","وخال رشاداً ذاك بعد الترهب",17,"ب",1,0]]}