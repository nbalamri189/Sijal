{"poems":[[95,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[29,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[53,"لولا فواكه أيلول إذا اجتمعت","https://www.aldiwan.net/poem7933.html","البسيط"],[31,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[47,"إني تركت الصبا عمدا ولم أكد","https://www.aldiwan.net/poem63458.html","البسيط"],[30,"يا ابن المراغة والهجاء إذا التقت","https://www.aldiwan.net/poem5645.html","الكامل"],[68,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[68,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[83,"خذ من حديث شؤونه وشجونه","https://www.aldiwan.net/poem61302.html","الكامل"],[41,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[50,"إذهب نجوت من الهجاء ولذعه","https://www.aldiwan.net/poem62528.html","الكامل"],[52,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[48,"إذا فزعنا فإن الأمن غايتنا","https://www.aldiwan.net/poem22962.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[147,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[164,"إن له فرط غرام وأسا","https://www.aldiwan.net/poem58976.html","الرجز"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[237,"ما زلت عليه في الكرى محتالا","https://www.aldiwan.net/poem14913.html","الدوبيت"],[242,"نفسي فداؤك يا من قد نأى فدنا","https://www.aldiwan.net/poem19273.html","البسيط"],[266,"أمعذبي وعذوبة الثغر الذي","https://www.aldiwan.net/poem38186.html","الكامل"],[276,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[438,"بكرت لنصحك يا أبا بكر","https://www.aldiwan.net/poem12637.html","أحذ الكامل"],[484,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[519,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[657,"","https://poetry.dctabudhabi.ae/diwan/poem/200323","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96729","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64717","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144139","البسيط"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133869","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11990","المنسرح"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123704","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100220","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48425","الكامل"],[3670,"","https://poetry.dctabudhabi.ae/diwan/poem/198357","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66551","الكامل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126346","الكامل"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100667","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33586","المنسرح"],[4797,"كهربتني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=132232",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5582,"شَمْسٌ تَجَلَّتْ لَنا مِنْ بَيْنِ سِجْفَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=63582",""],[402,"كانت عيون الريب الساهرة","https://www.poetsgate.com/ViewPoem.aspx?id=36585",""],[5956,"زادٌ وجوادٌ وبلادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183588",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[6301,"نشيد أُمِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80680&r=&rc=44",""]],"verses":[["لَوْلا فَتى جَمٌّ مُرُوءاتهُ","شِيمَتهُ فِي عَصْرِهِ نَادِرَهْ",0,"ر",2,0],["لَولا فَوارِسُ يَربوعٍ بِذي نَجبٍ","ضاقَ الطَريقُ وَعَيَّ الوِردُ وَالصَدَرُ",1,"ر",1,0],["لولا فواكهُ أَيلولٍ إذا اجتمعتْ","من كل نوعٍ ورَقَّ الجوُّ والماءُ",2,"ا",2,1],["لَولا فَواضِلُهُ غَداةَ لَقيتُهُ","بِالجُدِّ شابَ مَسائِحي وَعِذاري",3,"ر",2,0],["لَولا فَعالُهُمُ وَاللَهُ كَرَّمَهُ","لَماتَ ذِكرُ المَعالي آخِرُ الأَبَدِ",4,"د",1,0],["لَولا فَوارِسُ تَغلِبَ اِبنَةِ وائِلٍ","نَزَلَ العَدُوُّ عَلَيكَ كُلَّ مَكانِ",5,"ن",1,0],["لَولا فَرارُ الأَعادي مِن يَديكَ بِهِ","لَأَصبَحوا في فَمِ الأَيّامِ كَالمَثَلِ",6,"ل",1,0],["لَولا فَنا المالِ لَم تُحمَد مَكارِمُهُ","وَالراحُ لَولا فَناءُ العَقلِ ما مُدِحَت",7,"ت",1,0],["لَولا فَضِيحَةُ خَدّهِ بِدُمُوعِهِ","مَا زال شَكُّ رقِيبِهِ بِيَقِينِهِ",8,"ن",2,0],["لَولا فَوارِسُ مَذحِجِ اِبنَةِ مَذحِجٍ","وَالأَزدِ زُعزِعَ وَاِستُبيحَ العَسكَرُ",9,"ر",1,1],["لَولا فُتورٌ في كَلامِكَ يُشتَهى","وَتَرَفُّقي بِكَ بَعدُ وَاِستِملاحي",10,"ح",2,0],["لَولا فُضولُ سُلَيمانٍ وَنائِلُهُ","لَم يَدرِ طالِبُ عُرفٍ أَينَ يَنشَعِبُ",11,"ب",1,0],["لَولا فَوارِسُ فَوقَ الأَرضِ مُشرِعَةً","ما هابَت الوَحشَ قُربَ الشُزَّبِ المُزَعِ",12,"ع",1,0],["لَوْلا فُؤَادٌ أَبُو الفَارُوقِ مَا وجَدَتْ","إِلَى الْحَيَاةِ ابنَةُ الأَعْرَابِ مِنْ سَبَبِ",13,"ب",1,0],["لَولا فِعالُكَ بِالطَواغي لَم تَلُذ","حَذَرَ البَوارِ بِرومِها أَعرابُها",14,"ب",3,0],["لولا فتور في مقاه وسجى","ما أوثق القلب هواه وسجن",15,"ن",1,0],["لولا فُتورُ العيونِ ما قوِيَتْ","ولا غَدَتْ دونَ لحظِها الأَسَل",16,"ل",1,0],["لَولا فَزَعٌ مِن رَقدَةِ تفَجعني","في النَومِ إِذاً قُمتُ لَهُ إِجلالا",17,"ل",2,0],["لَوْلاَ فُؤَادِي أَخْشَى أَنْ يَذُوبَ ضَنىً","لَقُلْتُ أَنْتَ فُؤَادِي أَوْ لَأَنْتَ أَنَا",18,"ن",2,0],["لولا فساد تصور العقل الذي","ظن الخصوص بأن يكون عموما",19,"م",2,0],["لَولا فراق الفَريق النازلين عَلى","حكم الهَوى ما وشى دَمعي باسراري",20,"ر",2,0],["لَولا فَتاويهِ لكا","نَ أَجَلُّهُم يَقظانَ راقِد",21,"د",1,0],["لَولا فَتاويهِ الَّتي نَجَّتهُمُ","لَتَهالَكوا بِتَعَسُّفٍ وَتَجَهُّلِ",22,"ل",1,0],["لولا فَحاماتي لفازَ بها","فأقامَ نسبتَهُ الى حُجْرِ",23,"ر",1,0],["لولا فريق قليل من معارفنا","يؤمنا لقضينا العمر في تعب",24,"ب",1,0],["لولا فصاحتُه ونسبةُ حَيدَرٍ","لظنَنْتُه يومَ الكريهةِ رُستما",25,"م",2,0],["لولا فوارس مالك وكفاحهم","لهوت فوارسنا لغاة الأثلب",26,"ب",1,0],["لَولا فراخ فيرجوني لما طلبت","نَفسي رحيلاً ولو جاوزت عامينِ",27,"ن",1,0],["لَوْلا فِراقُكَ ما فارَقْتُ أَفْراحي","وَلا أَقامَ بِقَلْبي وَفْدُ أَتْراحي",28,"ح",2,1],["لولا فلانة ما استوزرت ثانية","فاشكر حرا صرت مولانا الوزير به",29,"ه",1,0],["لولا فضول فيه لم","يصرف إلى دبري اهتمامه",30,"م",2,0],["لَولا فَتى يَوسُفَ الصَلاحِ لَقَد","كُنتُ كَيَعقوبَ في يَدِ البَخَلِ",31,"ل",1,0],["لولا فتىً جم المروءة أقبلت","تشكو إليه عثارها فأقالها",32,"ل",3,0],["لولا فراق أحبتي وبعادهم","ما بت أروى لوعة المحزون",33,"ن",1,0],["لولا فخامة شيبهم وشبابهم","شرفا لرق بهم لي التشبيب",34,"ب",1,0],["لَولا فُؤاد في العَنا كَالراسي","شَغلته بالحبر وَالكراسي",35,"ي",1,0],["لولا فتاةٌ أعجَزَتْ","لفْظَ المُطيبِ أوِ المُطيلْ",36,"ل",1,0],["لولا فوارس لا ميل ولا عزل","من اللهازم ما قظتم بذي قار",37,"ر",1,1],["لَولا فَضيحَةُ قَلْبِهِ بِدُمُوعِهِ","ما زالَ شَكُّ رَقيبِهِ بِيَقِينِهِ",38,"ن",2,0],["لولا فروعُ الفضلِ في جنَّاتهِ","نضدت ثمارُ العلمِ من بستانهِ",39,"ن",2,0],["لولا فضائل احمدٍ قُصَّت لنا","فيها وفي آياتها الاخبارُ",40,"ر",1,1],["لولا فُؤادِي وضعفُ قُوَّتهِ","لقلتُ ما كانَ أنت ما أثما",41,"م",2,0],["لولا فيوزٍ وسط قلبي توماتيك","ماكان عيّن من فؤادي بقايا",42,"ا",3,0],["لولا فؤاد عبقري يقظ","ما بين جنبي لأصبحت سدى",43,"ا",1,0],["لولا فراقي للعراقِ","ومُهْجَتي ألِفَتْ جِوارَه",44,"ر",2,0],["لَوْلا فِراخٌ يُرَجُّونِي لَما طَلَبَتْ","نَفْسِي رَحِيلاً وَلَو جاوَزْتُ عامَيْنِ",45,"ن",1,0],["لولا فتى جم مروءاته","شيمته في عصره نادرة ه",46,"ر",3,0],["لولا فعلتُ الفعلَ هذا مسرعاً","لَحُبسْتُ طول العمر في الأصفادِ",47,"د",1,0],["لولا فراق الألي نحبهمو","ما فارقت دمعة مجاريها",48,"ي",3,0],["لَوْلا فَيْضٌ منْ دُعَاءٍ","جَرَّحَ الغَدْرُ زَمَاني",49,"ن",2,0]]}