{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[132,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[189,"وإني لأعجب من شائب","https://www.aldiwan.net/poem14653.html","المتقارب"],[190,"وهل ذاك إلا مهمه بين ثلة","https://www.aldiwan.net/poem44178.html","الطويل"],[203,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[408,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[422,"سألتك عن منازلنا بنجد","https://www.aldiwan.net/poem53908.html","الوافر"],[438,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[443,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39024","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130197","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48850","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204058","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113756","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47194","الطويل"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143972","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112304","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145146","الطويل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138606",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131278",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59489","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59449","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57997","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120517","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4857,"قد قام الدين, قد قام الدين","https://www.poetsgate.com/ViewPoem.aspx?id=30118",""],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[592,"ألا حدثاني بالأمور الحوادث","https://www.poetsgate.com/ViewPoem.aspx?id=128835",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""]],"verses":[["وَهَل ذنب هَذا الدهر إذ غال دلبراً","وأَبقى سليمى في الحَياة يُكفَّر",0,"ر",1,0],["وهل ذرى القفص فالمقراة معشبة","وهل قطين بعليا قاعر بانوا",1,"ن",3,0],["وهلْ ذاكرٌ ذاك الحبيبُ الذي نأَى","عهوداً تناساهن أمْ غيرُ ذاكرِ",2,"ر",1,0],["وهل ذاك إلا كقَطِّ الذُّبالِ","إذا خمدت فبِهِ تَضْطَرم",3,"م",1,0],["وهل ذاك إلا مهمه بينَ ثلةٍ","تطيف بها من جانبيها الثعالب",4,"ب",1,1],["وهلْ ذكرتني هندُ يوماً فأشفقتْ","لما بي وحاكتني بكا أو تباكيا",5,"ي",2,0],["وهل ذاكري أحباب قلبي على النّوى","أم الحُلبّ أغرَى مَن أحبّ بنسياني",6,"ن",2,0],["وهل ذكرت نداماي الأوالي","غبوقي في رباها واصطباحي",7,"ح",2,0],["وهل ذاكِرِي من لا تزالُ لذكرِهِ","عَلوقٌ بقلبي دائماً ولِساني",8,"ن",2,0],["وهل ذا يرى طيف الخيال وقد أبت","جفوني على طول النوى أن تهوّما",9,"م",2,0],["وهل ذا البُريْقُ التاحَ من نَحْوِ رامةٍ","وإلّا فَلِمْ باتَتْ جفونُكَ تَرْعاهُ",10,"ا",2,0],["وهل ذاك إلا ذو المعالي أبو الندى","أخو الفضل رب المنزل المتفرد",11,"د",1,0],["وهل ذكروني عند شملٍ مؤلفٍ","وهل سألوا عن علتي وشجوني",12,"ن",2,0],["وَهَلْ ذَاقَنِي دَمْعٌ من الدمعِ مُخْصبٌ","وَرَبْع اصطبَار القلبِ بعدَكَ مَاحِل",13,"ل",1,0],["وهل ذرفت يوم النوى مقلتاكما","علي كما أمسي وأصبح باكيا؟",14,"ي",2,0],["وهل ذاكمُ وادي العقيقِ الذي غَدا","عقيقُ دموعي بَعدَهُ دائمَ الهَمعِ",15,"ع",1,0],["وهل ذاك إلاّ أنّ ذُخْراً تُعِدّه","وذكرا تولّى نَشْرَهُ لك عارفُ",16,"ف",1,0],["وهل ذرفت عند النوى مقلتكما","علي كما أمسي وأصبح باكيا",17,"ي",2,0],["وهل ذلكَ الوادي الذي بِشمالِهِ","ترَعرَعتُ حُرّاً يذكُرُ اليوم نائِيَا",18,"ي",2,0],["وهل ذاق طعم العيش من عاش وحده","بعيدا عن الأصحاب في المهمه الخالي",19,"ل",2,0],["وهل ذكرت أيامها أم تنوسيت","وهل رعيت أم هل أضيعت عهودها",20,"د",3,0],["وهل ذمة فيه ترعى وذا","ذمام بني المصطفى ما رعى",21,"ع",2,0],["وهل ذلك الإصلاح إلا مفاسدٌ","رميت بهن الشعب حتى تألما",22,"م",2,0],["وهل ذمَّ كفي في هياج مهنَّدي","وهل خطلتْ يوماً عليّ حَمائلي",23,"ل",2,0],["وَهل ذلك الرَّيمُ الأغنُّ لبعِدنا","عن العهد أم شابته بعدي شوائبُهْ",24,"ب",2,0],["وهل ذلك السبط المرجل لم يزل","يمج فتيت المسك من بينه المشط",25,"ط",1,0],["وهل ذهَبُ الإبريز ينقص قيمة","إذا أُدْخِلَنَّ النارَ يوماً وأُخْرِجَا",26,"ج",2,0],["وهل ذي نساء في مواحلها ترى","وإلا فكل حين تخطر جاموس",27,"س",1,0],["وهل ذا شرار يجلب الهمّ في الدجى","إلى البال إن نبصر به أم نباريس",27,"س",1,0],["وهل ذوى منك دوح باسق اسفا","كما ذوى من فوادي كل سلوان",28,"ن",1,0],["وهل ذي نجوم ترجم الهمّ في الدجى","عن البال أن يخطر به أم نباريس",29,"س",1,0],["وهل ذاق المرارة غير جان","جنى قبل الأوان الإنهزاما",30,"م",2,0],["وهل ذمني إلا الحسود فإه","ليعلم ما شجيه مني ويرغم",31,"م",1,0],["وهل ذحلط المأفون والمدرة التجى","بكهف هزيع هيرع أو خنابث",32,"ث",1,0],["وهل ذاك حد فاصل بين ربنا","وبين الورى فيما رأى وتوهما",33,"م",2,0],["وهل ذاك يخفى من أتى نحو دارهم","ثكلتك دعنا من خرافاتك العضل",34,"ل",1,0]]}