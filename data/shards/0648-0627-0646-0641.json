em/85827","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85292","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21045","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/870","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142329","المتقارب"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10152","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[91,"فتح اورشليم","https://www.poetsgate.com/ViewPoem.aspx?id=53229",""],[46,"تلقّبَ مَلكٌ قاهراً، مِن سَفاهةٍº","https://www.poetsgate.com/ViewPoem.aspx?id=20069",""],[64,"غِبْتَ وما غبتَ عن ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=8512",""],[99,"التمثيلية","https://www.poetsgate.com/ViewPoem.aspx?id=36365",""],[99,"التمثيلية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67013&r=&rc=146",""]],"verses":[["وَأَنفُضُ ثِقلَكَ عَن عاتِقي","فَقَد طالَ ما أُدتَني يا جَبَل",0,"ل",1,0],["وَاِنفَكَّ سِلكُ نِظامِنا بَدَداً","وَلَقَد غَنينا وَهوَ مُؤتَلِفُ",1,"ف",1,0],["وَاِنفُض يَدَيكَ مِنَ الثَراءِ فَكَم مَضى","مِن دونِ ثَروَتِهِ البَخيلُ المُصلِحُ",2,"ح",1,0],["وَاِنفُض رِجالاً سَقوكَ الغَيظِ أَذنَبَةً","وَأَورَثوكَ مَضيضَ الداءِ وَالكَشَحا",3,"ح",2,0],["وَأَنْفَعُ مِنْ وَصْلِ الأَقَارِبِ لِلْفَتى","إِذَا زَهِدوا فِيهِ جِوارُ الأَباعِدِ",4,"د",1,0],["وإنّ في كَلِماتِ العُرْبِ شاردَةً","أداءَ ما شَرَطَتْهُ قَبْلَنا العَجَمُ",5,"م",1,0],["وإنْ فزِعَ الحيُّ منْ غالِبٍ","تدثَّرَهُ أسَدٌ أغْلَبُ",6,"ب",1,0],["وأنفُضُ اليَدَ منْ مالٍ إذا انْبَسَطَتْ","إليهِ عادَتْ بعِرْضٍ عنهُ مُمتَهَنِ",7,"ن",1,0],["وَإِنَّ فُؤادي لا يَلينُ إِلى هَوى","سِواكِ وَإِن قالوا بَلى سَيَلينُ",8,"ن",1,0],["وَأَنِفْتَ للِدِّينِ الْحَنِيفِ وَأَهْلِهِ","مِنْ أَنْ يَطِيحَ نَجِيعُهُ الْمَطْلُولُ",9,"ل",1,0],["وَإنْ فُقْتَهُ بِالْحِلْمِ وَالْعِلْمِ وَالنَّدَى","وَشَارَكْتَهُ فِي نُورِهِ وَانْتِقَالِهِ",10,"ل",2,0],["وإنْ فسحَ الرّحْمانُ في العُمْرِ برْهَةً","فلابُدّ من حثِّ المطيّةِ لابُدّا",11,"د",2,0],["وأنْفاسُنا سَكَتَتْ دَفْعَةً","كَجَهْرِ الصّلاةِ تَلاهُ القُنوتْ",12,"ت",1,0],["وَإِن فَحَصَ الناسُ عَن سَيِّدٍ","فَسَيِّدُكُم عَنهُ لا يُفحَصُ",13,"ص",1,0],["وَاِنفَحهُ عَنّا يا رَبيعُ بِكُلِّ ما","أَطلَعتَ مِن رَندٍ وَنَورِ أَقاحِ",14,"ح",1,0],["وَاِنفَحِ الرَوضَ بِنَشرٍ طَيِّبٍ","عَلَّهُ يوقِظُ سُكّانَ الشَجَر",15,"ر",1,0],["وَإِنَّ في لُكنَةِ اِبنِ عَونٍ لَما","يَشغَلُهُ عَن فَصاحَةِ العُربِ",16,"ب",1,0],["وَإِن فَخَروا يَوماً أَتَوا بِمُحَمَّدٍ","وَجِبريلَ وَالفُرقانِ ذي السوراتِ",17,"ت",1,0],["وَإِن فارَقَتهُ فُرَّقُ المُزنِ شايَعَت","بِهِ مُرجَحَّناتُ الغَمامِ الدَوالِحُ",18,"ح",1,0],["وإن فتنت بإحدى المزعجات نُرِق","منّا الدماء إلى أن نُخمد الفِتَنا",19,"ن",2,0],["وإن في البدر لخطباً به","في البدر لاحت بقع أربع",20,"ع",1,0],["وإن فضاءً شاسعاً قد تضاربت","بأبعاده أيدي القوى لرهيب",21,"ب",1,0],["وَإِن فَتَنَ الشَيطانُ أَهلَ ضَلالَةٍ","لَقوا مِنكَ حَرباً حَميُها غَيرُ بارِدِ",22,"د",1,0],["وانفذ حتى النملُ ما في بيوتهم","وعُلل بالسَّوفِ الوليدُ المهذَّبُ",23,"ب",1,1],["وانفذ النمل بالصرائم ما","جمع الحاطبون ما اتنشبوا",24,"ب",3,0],["وَإِنَّ فُؤادي لِاِفتِقادِ أَسيرِهِ","أَسيرٌ بِأَيدي الحادِثاتِ رَهينُ",25,"ن",1,0],["وإن فتح الراوي معاني فخاره","فدع ما رواه آل خاقان للفتح",26,"ح",1,0],["وأنفق الخاءآتِ لكنه","لعبدهِ من وفرِها ما رضخ",27,"خ",1,0],["وإن فاضَ درًّا على سامع","فأنمل حامله الجسَّر",28,"ر",1,0],["وأنفقت عمرِي في المليحِ محبَّةً","فإن يسلني عذلٌ فيا ضيعة العمر",29,"ر",1,0],["وأنفقوا تبره عليهِ ثناً","في حالتيه إنفاق أكياس",30,"س",1,0],["وإن فاتني ماء الحياة بثغره","فكم نصبٍ لاقيت من دون ريه",31,"ي",2,0],["وانْفق له دينار من ضنٍّ وشح","ولا تبل أخفّ وزناً أم رجح",32,"ح",1,0],["وانفضي الكف من فتى ما تردى","برداء الأجداد والآباء",33,"ا",2,0],["وأنفاسٌ كأنفاسِ الخُزامَى","قبيلَ الصبحِ بَلَّتها السماءُ",34,"ا",2,0],["وإنَّ فَضْلَةَ كأْسٍ أنتَ مُفْضِلُها","لَذاتُ بَرْدٍ على الأحْشَاء والكَبدِ",35,"د",1,0],["واَنفِ السَّوادَ عن البياض فإنه","ما في بياض يد الكريم سوادُ",36,"د",1,0],["وإنّ فقيراً عدّ عَمْراً لفقره","مسدَّاً لذو فقرين فقر على فقر",37,"ر",1,0],["وإن فينا لبُقيا بعدما سلمت","نفس الإمام لنا من كل محذور",38,"ر",1,0],["وانفتق الجو بريح غدت","رَوحاً بمنِّ الفاتق الراتق",39,"ق",1,0],["وإنَّ فوْتَ الذي أُبادرُهُ","أرمضُ لي مِنْ مُردَّدِ العذَلِ",40,"ل",1,0],["وأنَّ فيهم وفاءً لا نقومُ به","ولن يكونَ مع النُّقصانِ رُجحان",41,"ن",1,0],["وانفث من الصدر ما يُضِرُّ به","لا تتركِ الداء فيه مدفونا",42,"ن",2,0],["وَاِنفَحنَ بِالبَسَماتِ كُلَّ شُمَيذَعٍ","خاضَ العَجاجَ وَوَجهُهُ يَتَلالا",43,"ل",2,0],["وَإِن فازَ سَهمي كَفَّكُم عَن مَقاعِدٍ","لَكُم خَلفَ أَدبارِ البُيوتِ وَمُنظَرِ",44,"ر",1,0],["وَإِن فُزتَ بِالتَقبيلِ يَوماً لِكَفِّهِ","رَأَيتُ بِحارَ الجودِ يَجري نَميرُها",45,"ر",3,0],["وَآنَفُ إِمّا عِزَّةً مِنكَ نِلتُها","وَإِمّا لِإِذلالٍ بِهِ أَتَعَتَّبُ",46,"ب",1,0],["وانفحيني مِنْ روحِكِ الفَخْمِ مَا يُبْ","لغُ صَوْتي آذَانَ هذا الإِلهِ",47,"ه",1,0],["وانْفُخِ النَّايَ فالحَيَاةُ ظَلامٌ","مَا لِمُرْتادِهِ من الهَوْلِ حَامِ",48,"م",1,0],["وانْفخي في مَشاعِري مَرَحَ الدُّنيا","وشُدِّي مِنْ عزميَ المجهودِ",49,"د",1,0],["وَأُنفِقُ في كَسبِ المَحامِدِ مُهجَتي","وَلَو كانَ في الذِكرِ الجَميل حِمامي",50,"ي",1,0],["وَاِنفَضَّ نادٍ بِالشَآمِ وَسامِرٌ","في مِصرَ أَنتَ هَزارُهُ الصَدّاحُ",51,"ح",1,0],["وَاِنفَع بِوُسعِكَ كُلِّهِ","إِنَّ المُوَفَّقَ مَن نَفَع",52,"ع",1,0],["وَأَنَّ في راحَتَي مِصرٍ وَصاحِبِها","عَهداً وَعَقداً بِحَقٍّ كانَ مُغتَصَبا",53,"ب",2,0],["وَإِن فارَقَتنِيَ أَمطارُهُ","فَأَكثَرُ غُدرانِها ما نَضَب",54,"ب",1,0],["وَأَنفُسُهُم مَبذولَةٌ لِوُفودِهِم","وَأَموالُهُم في دارِ مَن لَم يَفِد وَفدُ",55,"د",1,0],["وَإِن فَقَدَ الإِعطاءَ حَنَّت يَمينُهُ","إِلَيهِ حَنينَ الإِلفِ فارَقَهُ الإِلفُ",56,"ف",1,0],["وَأَنفَسُ ما لِلفَتى لُبُّهُ","وَذو اللُبِّ يَكرَهُ إِنفاقَهُ",57,"ق",2,0],["وَآنَفُ مِن أَخي لِأَبي وَأُمّي","إِذا ما لَم أَجِدهُ مِنَ الكِرامِ",58,"م",1,0],["وَأَنفُسٌ يَلمَعِيّاتٌ تُحِبُّهُمُ","لَها اِضطِراراً وَلَو أَقصَوكَ شَنآنا",59,"ن",2,0],["وآنف أن أجاوبه ولكن","رأيت الحلم لا يَزَعُ العبيدا",60,"د",2,0],["وانف الغرائب فالأركان تجمعها","أخوة في فتاء السن والكبرِ",61,"ر",1,0],["وأَنفقتُ من عُمْرِي وذاتِ يدي بها","بضائِعَ لم أملِكْ لهُنَّ حسابَا",62,"ب",2,0],["وَإِن فَصَدتَ اِبتِغاءَ البُرءِ مِن سَقَمٍ","فَقَد أَرَقتَ دَماً يَشفي مِنَ الكَلَبِ",63,"ب",1,0],["وَأَنفٌ إِذا اِحمَرَّ في وَجهِهِ","وَقامَ تَوَهَّمتَهُ مِحجَمَه",64,"م",2,0],["وَآنَفُ لِلدَيّانِ أَن تَرتَمي بِهِ","غِضابُ قَوافي الشِعرِ خَمساً وَأَربَعا",65,"ع",2,0],["وَأَنفَقتَ مالَ اللَهِ في غَيرِ حَقِّهِ","عَلى نَهرِكَ المَشؤومِ غَيرِ المُبارَكِ",66,"ك",1,0],["وَأَنَّ فِرارَ المُسلِمينَ خَزايَةٌ","وَأُحدوثَةٌ تَنمي إِلى كُلِّ مَوسِمِ",67,"م",1,0],["وَإِنَّ في الجَنَّةِ لِلرَوحَ وَالر","رَيحانَ وَالراحَةَ وَالسَلسَبيل",68,"ل",1,0],["وانفاقُ الحياةِ واضحكُ الأيامِ","مني واكذبةُ السلوانِ",69,"ن",1,0],["وأنفق فيه قلبه وشبابه","فلم يَبقَ إلا الجرح والشفق الدامي",70,"ي",1,0],["وَإِن فاتَني إِعذارُ شِبليكَ بِالغنى","فإنَّ بترك العزم مُتّضِحَ العُذرِ",71,"ر",1,0],["وأنفاسها أذكى إذا انصرف الدجى","وريقتُها أشهى ومقلتها أسبى",72,"ب",2,0],["وَأَنفُسٌ تَسَعُ الأَرضَ الفَضاءَ وَلا","يَرضَونَ أَو يُجشِموها فَوقَ ما تَسَعُ",73,"ع",1,0],["وَاِنفَح لَنا مِن طيبِ خَيمِكَ نَفحَةً","إِن كانَتِ الأَخلاقُ مِمّا توهَبُ",74,"ب",1,0],["وانفسْ بنفسِ عزوفٍ","تواقةٍ للمعالي",75,"ي",1,0],["وأنفرُ عن علمِ الكلامِ لثغرها","لئلا أورِّي عنهُ بالجوهرِ الفردِ",76,"د",1,0],["وإنَّ في عمرٍ عدلاً ومعرفةً","فكيفَ يُصْرَفُ عن هذا بلا سببِ",77,"ب",1,0],["وأنفذَهُ إلى كعبٍ كتاباً","كأنّ سُطُورَهُ البِيضُ الحِدادُ",78,"د",1,0],["وَأَنفَسُ حَظَّيكَ الَّذي لا تَنالُهُ","وَأَنكى عَدُوَّيكَ الَّذي لا تُقاتِلُه",79,"ل",2,0],["وَانفتح الباب عَن مصلّبة","خيفة شَرّ هُناك ينذرها",80,"ر",3,0],["وَاِنفخ إِباءَك في آنافهم غَضَباً","فَقَد تُحَرِّكُ أَصنامَ المَحاريبِ",81,"ب",1,0],["وَأَنفٍ كَحَدِّ السَيفِ دَقَّ وَحاجِبٍ","وَصَدرٍ كَفا ثَورِ اللُجَينِ وَمِعصَمِ",82,"م",1,0],["وَاِنفِلاقُ الأَمواجِ طَورَينِ عَن مو","سى وَبَعدُ المُمَلَّكُ الطالوتُ",83,"ت",1,0],["وَأَنفُهُ كَسُترَةٍ","تُحشى مِنَ الإِفريزِ",84,"ز",1,0],["وَإِنَّ فيها بَناتِ الكَرمِ ما تَرَكَت","مِنها اللَيالي سِوى تِلكَ الحُشاشاتِ",85,"ت",1,0],["وإنّ في النيكِ لمستمتعاً","عنه اعتياضُ الخبزِ للمستضيف",86,"ف",1,0],["وَاِنفَرَجَت عَن أَسَدٍ أَلَدِّ","وَعَن نُمورٍ حَولَهُ وَأُسدِ",87,"د",1,0],["وَأََنفُسُ هَذِهِ الأَجسامِ طَيرٌ","بُزاةُ حِمامِها مُتَصَيِّداتُ",88,"ت",1,0],["وَإِن فَرَعوا جَبَلاً شامِخاً","فَلَيسَ يُعَنَّفُ أَن يَحدَبا",89,"ب",2,0],["وَإِن فِضتَ لِلأَقوامِ بِالمالِ وَالغِنى","فَيا بَحرُ أَيقِن بِالنُضوبِ وَإِن جِشتا",90,"ت",2,0],["وَاِنفَرِدي في بَلَدٍ عازِبٍ","عَنّا وَعيشي ذاتَ بالٍ رَخي",91,"ي",1,0],["وَأَنفَقتُ بِالأَنفاسِ عُمري مُجَزِّئاً","بِها اليَومَ ثُمَّ الشَهرَ يَتبَعُهُ الشَهرُ",92,"ر",1,0],["وَإِن فَهِما خِطابَ الدَهرِ مِثلي","فَما سَعِدا بِما يَمنيهِ مانِ",93,"ن",1,0],["وَأَنفاسي مُوَكَّلَةٌ بِروحٍ","أَراحَتها وَعُمرٍ أَمحَقَتهُ",94,"ت",2,0],["وَاِنفُض هُمومَكَ عَن فُؤادِكَ إِنَّنا","نَلقى الهُمومَ بِكُلِّ أَغلَبَ أَضخَمِ",95,"م",1,0],["وإنَّ في القلب مني","لحبِّ لَيلى نموّا",96,"و",2,0],["وإن فؤادي أوه يا أم فاِعلمي","يكاد عليه بالأسى يتصدع",97,"ع",1,0],["وأن فيه نصيبي","هو العذاب الوبيل",98,"ل",1,0],["وإن فراق الشيخ أَرضاً له بها","مُنىً مشهدٌ أَكبرْ بذلك مشهدا",99,"د",2,0],["وإن فاتَني عصر الشباب الَّذي خلا","فَما فاتَني يوماً لأفراحه الذكر",100,"ر",1,0],["وأنفذ ما تلقاه حكماً إذا قضى","قضاءً ملوك الأرض منه غضاب",101,"ب",1,0],["وانفخ به من بأسِ روحكَ سورةً","يرمي سُطاها المستخفّ فيُحجِمُ",102,"م",1,0],["وأنفُسٌ قرشيّاتٌ يُطرِّبها","صوتٌ يرنُّ به رمحٌ وصمصامُ",103,"م",1,0],["وأَنفَقَ ما أَفادَ بِحُسنِ هَديٍ","وتَقديرٍ بِلا سَرَفٍ مُبيرِ",104,"ر",1,0],["وَآنَفُ سَعْياً فِي رِكَابٍ فَكَيْفَ بِي","وَِلي كُلَّ حَوْلٍ آَخْذَةٌ بِرِكَابِ",105,"ب",1,0],["وَإِنَّ فِي ظِلِّهِ النَّادِي بِرَحْمَتِهِ","لبَلْسَماً لِجَراحِ القلْبِ وَالرَّاسِ",106,"س",1,0],["وَإِنَّ فَتىً لَم يَكسِرِ الأَسرُ قَلبَهُ","وَخَوضُ المَنايا جِدَّهُ لَنَجيبُ",107,"ب",1,0],["وأنفقت النور أمّ الضحا","فزادت ثراء إلى سؤدد",108,"د",1,0],["وَأَنفٌ عَلى وَجهِها مُلصَقٌ","قَصيرُ المَناخِرِ كَالفُستُقَه",109,"ق",2,0],["وأنفسُ الناسِ في ضيقٍ وفي كمدٍ","كأنّها زفرةٌ في صدرِ معمود",110,"د",1,0],["وَانفُوا عن الطبِّ الرَطانةَ إنّها","نَمَشٌ يَعيثُ بوجههِ الوضَّاح",111,"ح",1,0],["وأن فَتَاها لم يقفْ في ثيابه","أخو نجدَةٍ في يومٍ حربٍ ولا سلمِ",112,"م",1,0],["وأنفسُ شيءٍ في الحياةِ أزاهِرٌ","يُبعثرها شعبٌ على قدمَيْ شهمِ",112,"م",1,0],["وأنفًا أشمَّ يزيد ارتفاعًا","إذا شمَّ بعضُ الأنوف الصعيدا",113,"د",2,0],["وأنفت من صيد البزا","ة قصدت صياد البُزاة",114,"ا",2,0],["وإن فسح الرحمن في العمر برهة","فلا بد من حث المطية لا بدا",115,"د",2,0],["وان \" فراتاً \" للكفيءُ بشكرها","اذا مِتُ فليردُدْ عليها العواديا",116,"ي",2,0],["وأنفِت من هذي الطبيعة حرةً","يعاتقُها التدليسُ أن تتمخَّضا",117,"ض",2,0],["وأنفاسُ المُروج معطَّراتٌ","بأنفاسِ الرُعاة إلى المَراح",118,"ح",1,0],["وأن فؤاداً شع نوراً وقوَّةً","هو اليوم مسودُّ الجوانب بارد",119,"د",1,0],["وإنْ فاتَها وحشٌ صَليبٌ فؤادُه","تَعَرَّضَ وحشٌ منه أقسى وأصلَب",120,"ب",1,0],["وانفخن بالبسمات كلّ سيمذع","خاض العجاج ووجهه يتلالا",121,"ل",2,0],["وأنفقتُ، بالأنفاسِ، عُمري، مُجزّءاً","، بها اليَومَ ثمّ الشّهرَ، يتبعُهُ الشهر",122,"ر",1,0],["وانفصل الفصل بافتراق","فصار في غيبتي حضوري",123,"ر",2,0],["وأنفي إشاعات الهوى ، وهي حلوة","وأجعل تاريخي الجميل خرئبا",124,"ب",2,0],["وأنفي إشاعات الهوى.. وهي حلوة","وأجعل تاريخي الجميلَ خرائبا",125,"ب",2,0]]}