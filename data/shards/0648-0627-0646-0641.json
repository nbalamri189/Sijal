ر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[484,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[485,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[502,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[531,"أعن ذكرها يسلو الفؤاد المبلبل","https://www.aldiwan.net/poem37271.html","الطويل"],[531,"ولي سلف فوق المجرة خيموا","https://www.aldiwan.net/poem37515.html","الطويل"],[531,"سددت الأذن عن داعي التصابي","https://www.aldiwan.net/poem37528.html","الوافر"],[553,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[553,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[553,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[553,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[553,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[560,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[560,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[560,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[560,"كن غنيا في صورة الفقراء","https://www.aldiwan.net/poem35079.html","الخفيف"],[561,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[564,"خير الرثاء الذي بالقلب قد لطفا","https://www.aldiwan.net/poem52788.html","البسيط"],[564,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[566,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[577,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[577,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"],[577,"تكمل فضلي قبل عشرين حجة","https://www.aldiwan.net/poem2819.html","الطويل"],[577,"يأيها البرق الذي","https://www.aldiwan.net/poem2864.html","مجزوء الرجز"],[577,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[577,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[611,"","https://poetry.dctabudhabi.ae/diwan/poem/18846","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18053","الوافر"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18710","الوافر"]],"verses":[["وَأَنفُضُ ثِقلَكَ عَن عاتِقي","فَقَد طالَ ما أُدتَني يا جَبَل",0,"ل",1,0],["وَاِنفَكَّ سِلكُ نِظامِنا بَدَداً","وَلَقَد غَنينا وَهوَ مُؤتَلِفُ",1,"ف",1,0],["وَاِنفُض يَدَيكَ مِنَ الثَراءِ فَكَم مَضى","مِن دونِ ثَروَتِهِ البَخيلُ المُصلِحُ",2,"ح",1,0],["وَاِنفُض رِجالاً سَقوكَ الغَيظِ أَذنَبَةً","وَأَورَثوكَ مَضيضَ الداءِ وَالكَشَحا",3,"ح",2,0],["وَأَنْفَعُ مِنْ وَصْلِ الأَقَارِبِ لِلْفَتى","إِذَا زَهِدوا فِيهِ جِوارُ الأَباعِدِ",4,"د",1,0],["وإنّ في كَلِماتِ العُرْبِ شاردَةً","أداءَ ما شَرَطَتْهُ قَبْلَنا العَجَمُ",5,"م",1,0],["وإنْ فزِعَ الحيُّ منْ غالِبٍ","تدثَّرَهُ أسَدٌ أغْلَبُ",6,"ب",1,0],["وأنفُضُ اليَدَ منْ مالٍ إذا انْبَسَطَتْ","إليهِ عادَتْ بعِرْضٍ عنهُ مُمتَهَنِ",7,"ن",1,0],["وَإِنَّ فُؤادي لا يَلينُ إِلى هَوى","سِواكِ وَإِن قالوا بَلى سَيَلينُ",8,"ن",1,0],["وَأَنِفْتَ للِدِّينِ الْحَنِيفِ وَأَهْلِهِ","مِنْ أَنْ يَطِيحَ نَجِيعُهُ الْمَطْلُولُ",9,"ل",1,0],["وَإنْ فُقْتَهُ بِالْحِلْمِ وَالْعِلْمِ وَالنَّدَى","وَشَارَكْتَهُ فِي نُورِهِ وَانْتِقَالِهِ",10,"ل",2,0],["وإنْ فسحَ الرّحْمانُ في العُمْرِ برْهَةً","فلابُدّ من حثِّ المطيّةِ لابُدّا",11,"د",2,0],["وأنْفاسُنا سَكَتَتْ دَفْعَةً","كَجَهْرِ الصّلاةِ تَلاهُ القُنوتْ",12,"ت",1,0],["وَإِن فَحَصَ الناسُ عَن سَيِّدٍ","فَسَيِّدُكُم عَنهُ لا يُفحَصُ",13,"ص",1,0],["وَاِنفَحهُ عَنّا يا رَبيعُ بِكُلِّ ما","أَطلَعتَ مِن رَندٍ وَنَورِ أَقاحِ",14,"ح",1,0],["وَاِنفَحِ الرَوضَ بِنَشرٍ طَيِّبٍ","عَلَّهُ يوقِظُ سُكّانَ الشَجَر",15,"ر",1,0],["وَإِنَّ في لُكنَةِ اِبنِ عَونٍ لَما","يَشغَلُهُ عَن فَصاحَةِ العُربِ",16,"ب",1,0],["وَإِن فَخَروا يَوماً أَتَوا بِمُحَمَّدٍ","وَجِبريلَ وَالفُرقانِ ذي السوراتِ",17,"ت",1,0],["وَإِن فارَقَتهُ فُرَّقُ المُزنِ شايَعَت","بِهِ مُرجَحَّناتُ الغَمامِ الدَوالِحُ",18,"ح",1,0],["وإن فتنت بإحدى المزعجات نُرِق","منّا الدماء إلى أن نُخمد الفِتَنا",19,"ن",2,0],["وإن في البدر لخطباً به","في البدر لاحت بقع أربع",20,"ع",1,0],["وإن فضاءً شاسعاً قد تضاربت","بأبعاده أيدي القوى لرهيب",21,"ب",1,0],["وَإِن فَتَنَ الشَيطانُ أَهلَ ضَلالَةٍ","لَقوا مِنكَ حَرباً حَميُها غَيرُ بارِدِ",22,"د",1,0],["وانفذ حتى النملُ ما في بيوتهم","وعُلل بالسَّوفِ الوليدُ المهذَّبُ",23,"ب",1,1],["وانفذ النمل بالصرائم ما","جمع الحاطبون ما اتنشبوا",24,"ب",3,0],["وَإِنَّ فُؤادي لِاِفتِقادِ أَسيرِهِ","أَسيرٌ بِأَيدي الحادِثاتِ رَهينُ",25,"ن",1,0],["وإن فتح الراوي معاني فخاره","فدع ما رواه آل خاقان للفتح",26,"ح",1,0],["وأنفق الخاءآتِ لكنه","لعبدهِ من وفرِها ما رضخ",27,"خ",1,0],["وإن فاضَ درًّا على سامع","فأنمل حامله الجسَّر",28,"ر",1,0],["وأنفقت عمرِي في المليحِ محبَّةً","فإن يسلني عذلٌ فيا ضيعة العمر",29,"ر",1,0],["وأنفقوا تبره عليهِ ثناً","في حالتيه إنفاق أكياس",30,"س",1,0],["وإن فاتني ماء الحياة بثغره","فكم نصبٍ لاقيت من دون ريه",31,"ي",2,0],["وانْفق له دينار من ضنٍّ وشح","ولا تبل أخفّ وزناً أم رجح",32,"ح",1,0],["وانفضي الكف من فتى ما تردى","برداء الأجداد والآباء",33,"ا",2,0],["وأنفاسٌ كأنفاسِ الخُزامَى","قبيلَ الصبحِ بَلَّتها السماءُ",34,"ا",2,0],["وإنَّ فَضْلَةَ كأْسٍ أنتَ مُفْضِلُها","لَذاتُ بَرْدٍ على الأحْشَاء والكَبدِ",35,"د",1,0],["واَنفِ السَّوادَ عن البياض فإنه","ما في بياض يد الكريم سوادُ",36,"د",1,0],["وإنّ فقيراً عدّ عَمْراً لفقره","مسدَّاً لذو فقرين فقر على فقر",37,"ر",1,0],["وإن فينا لبُقيا بعدما سلمت","نفس الإمام لنا من كل محذور",38,"ر",1,0],["وانفتق الجو بريح غدت","رَوحاً بمنِّ الفاتق الراتق",39,"ق",1,0],["وإنَّ فوْتَ الذي أُبادرُهُ","أرمضُ لي مِنْ مُردَّدِ العذَلِ",40,"ل",1,0],["وأنَّ فيهم وفاءً لا نقومُ به","ولن يكونَ مع النُّقصانِ رُجحان",41,"ن",1,0],["وانفث من الصدر ما يُضِرُّ به","لا تتركِ الداء فيه مدفونا",42,"ن",2,0],["وَاِنفَحنَ بِالبَسَماتِ كُلَّ شُمَيذَعٍ","خاضَ العَجاجَ وَوَجهُهُ يَتَلالا",43,"ل",2,0],["وَإِن فازَ سَهمي كَفَّكُم عَن مَقاعِدٍ","لَكُم خَلفَ أَدبارِ البُيوتِ وَمُنظَرِ",44,"ر",1,0],["وَإِن فُزتَ بِالتَقبيلِ يَوماً لِكَفِّهِ","رَأَيتُ بِحارَ الجودِ يَجري نَميرُها",45,"ر",3,0],["وَآنَفُ إِمّا عِزَّةً مِنكَ نِلتُها","وَإِمّا لِإِذلالٍ بِهِ أَتَعَتَّبُ",46,"ب",1,0],["وانفحيني مِنْ روحِكِ الفَخْمِ مَا يُبْ","لغُ صَوْتي آذَانَ هذا الإِلهِ",47,"ه",1,0],["وانْفُخِ النَّايَ فالحَيَاةُ ظَلامٌ","مَا لِمُرْتادِهِ من الهَوْلِ حَامِ",48,"م",1,0],["وانْفخي في مَشاعِري مَرَحَ الدُّنيا","وشُدِّي مِنْ عزميَ المجهودِ",49,"د",1,0],["وَأُنفِقُ في كَسبِ المَحامِدِ مُهجَتي","وَلَو كانَ في الذِكرِ الجَميل حِمامي",50,"م",2,0],["وَاِنفَضَّ نادٍ بِالشَآمِ وَسامِرٌ","في مِصرَ أَنتَ هَزارُهُ الصَدّاحُ",51,"ح",1,0],["وَاِنفَع بِوُسعِكَ كُلِّهِ","إِنَّ المُوَفَّقَ مَن نَفَع",52,"ع",1,0],["وَأَنَّ في راحَتَي مِصرٍ وَصاحِبِها","عَهداً وَعَقداً بِحَقٍّ كانَ مُغتَصَبا",53,"ب",2,0],["وَإِن فارَقَتنِيَ أَمطارُهُ","فَأَكثَرُ غُدرانِها ما نَضَب",54,"ب",1,0],["وَأَنفُسُهُم مَبذولَةٌ لِوُفودِهِم","وَأَموالُهُم في دارِ مَن لَم يَفِد وَفدُ",55,"د",1,0],["وَإِن فَقَدَ الإِعطاءَ حَنَّت يَمينُهُ","إِلَيهِ حَنينَ الإِلفِ فارَقَهُ الإِلفُ",56,"ف",1,0],["وَأَنفَسُ ما لِلفَتى لُبُّهُ","وَذو اللُبِّ يَكرَهُ إِنفاقَهُ",57,"ق",2,0],["وَآنَفُ مِن أَخي لِأَبي وَأُمّي","إِذا ما لَم أَجِدهُ مِنَ الكِرامِ",58,"م",1,0],["وَأَنفُسٌ يَلمَعِيّاتٌ تُحِبُّهُمُ","لَها اِضطِراراً وَلَو أَقصَوكَ شَنآنا",59,"ن",2,0],["وآنف أن أجاوبه ولكن","رأيت الحلم لا يَزَعُ العبيدا",60,"د",2,0],["وانف الغرائب فالأركان تجمعها","أخوة في فتاء السن والكبرِ",61,"ر",1,0],["وأَنفقتُ من عُمْرِي وذاتِ يدي بها","بضائِعَ لم أملِكْ لهُنَّ حسابَا",62,"ب",2,0],["وَإِن فَصَدتَ اِبتِغاءَ البُرءِ مِن سَقَمٍ","فَقَد أَرَقتَ دَماً يَشفي مِنَ الكَلَبِ",63,"ب",1,0],["وَأَنفٌ إِذا اِحمَرَّ في وَجهِهِ","وَقامَ تَوَهَّمتَهُ مِحجَمَه",64,"م",2,0],["وَآنَفُ لِلدَيّانِ أَن تَرتَمي بِهِ","غِضابُ قَوافي الشِعرِ خَمساً وَأَربَعا",65,"ع",2,0],["وَأَنفَقتَ مالَ اللَهِ في غَيرِ حَقِّهِ","عَلى نَهرِكَ المَشؤومِ غَيرِ المُبارَكِ",66,"ك",1,0],["وَأَنَّ فِرارَ المُسلِمينَ خَزايَةٌ","وَأُحدوثَةٌ تَنمي إِلى كُلِّ مَوسِمِ",67,"م",1,0],["وَإِنَّ في الجَنَّةِ لِلرَوحَ وَالر","رَيحانَ وَالراحَةَ وَالسَلسَبيل",68,"ل",1,0],["وانفاقُ الحياةِ واضحكُ الأيامِ","مني واكذبةُ السلوانِ",69,"ن",1,0],["وأنفق فيه قلبه وشبابه","فلم يَبقَ إلا الجرح والشفق الدامي",70,"م",2,0],["وَأَنْفَدَ الصَّبْرَ مِنِّي ثُمَّ جَدَّدَهُ","يَا لَيْتَهُ لَمْ يُجَدِّدْ مِنْهُ مَا نَفِدَا",71,"د",2,0],["وَإِن فاتَني إِعذارُ شِبليكَ بِالغنى","فإنَّ بترك العزم مُتّضِحَ العُذرِ",72,"ر",1,0],["وأنفاسها أذكى إذا انصرف الدجى","وريقتُها أشهى ومقلتها أسبى",73,"ب",2,0],["وَأَنفُسٌ تَسَعُ الأَرضَ الفَضاءَ وَلا","يَرضَونَ أَو يُجشِموها فَوقَ ما تَسَعُ",74,"ع",1,0],["وَاِنفَح لَنا مِن طيبِ خَيمِكَ نَفحَةً","إِن كانَتِ الأَخلاقُ مِمّا توهَبُ",75,"ب",1,0],["وانفسْ بنفسِ عزوفٍ","تواقةٍ للمعالي",76,"ل",2,0],["وأنفرُ عن علمِ الكلامِ لثغرها","لئلا أورِّي عنهُ بالجوهرِ الفردِ",77,"د",1,0],["وإنَّ في عمرٍ عدلاً ومعرفةً","فكيفَ يُصْرَفُ عن هذا بلا سببِ",78,"ب",1,0],["وأنفذَهُ إلى كعبٍ كتاباً","كأنّ سُطُورَهُ البِيضُ الحِدادُ",79,"د",1,0],["وَأَنفَسُ حَظَّيكَ الَّذي لا تَنالُهُ","وَأَنكى عَدُوَّيكَ الَّذي لا تُقاتِلُه",80,"ل",2,0],["وَانفتح الباب عَن مصلّبة","خيفة شَرّ هُناك ينذرها",81,"ر",3,0],["وَاِنفخ إِباءَك في آنافهم غَضَباً","فَقَد تُحَرِّكُ أَصنامَ المَحاريبِ",82,"ب",1,0],["وَأَنفٍ كَحَدِّ السَيفِ دَقَّ وَحاجِبٍ","وَصَدرٍ كَفا ثَورِ اللُجَينِ وَمِعصَمِ",83,"م",1,0],["وَاِنفِلاقُ الأَمواجِ طَورَينِ عَن مو","سى وَبَعدُ المُمَلَّكُ الطالوتُ",84,"ت",1,0],["وَأَنفُهُ كَسُترَةٍ","تُحشى مِنَ الإِفريزِ",85,"ز",1,0],["وَإِنَّ فيها بَناتِ الكَرمِ ما تَرَكَت","مِنها اللَيالي سِوى تِلكَ الحُشاشاتِ",86,"ت",1,0],["وإنّ في النيكِ لمستمتعاً","عنه اعتياضُ الخبزِ للمستضيف",87,"ف",1,0],["وَاِنفَرَجَت عَن أَسَدٍ أَلَدِّ","وَعَن نُمورٍ حَولَهُ وَأُسدِ",88,"د",1,0],["وَأََنفُسُ هَذِهِ الأَجسامِ طَيرٌ","بُزاةُ حِمامِها مُتَصَيِّداتُ",89,"ت",1,0],["وَإِن فَرَعوا جَبَلاً شامِخاً","فَلَيسَ يُعَنَّفُ أَن يَحدَبا",90,"ب",2,0],["وَإِن فِضتَ لِلأَقوامِ بِالمالِ وَالغِنى","فَيا بَحرُ أَيقِن بِالنُضوبِ وَإِن جِشتا",91,"ت",2,0],["وَاِنفَرِدي في بَلَدٍ عازِبٍ","عَنّا وَعيشي ذاتَ بالٍ رَخي",92,"خ",2,0],["وَأَنفَقتُ بِالأَنفاسِ عُمري مُجَزِّئاً","بِها اليَومَ ثُمَّ الشَهرَ يَتبَعُهُ الشَهرُ",93,"ر",1,0],["وَإِن فَهِما خِطابَ الدَهرِ مِثلي","فَما سَعِدا بِما يَمنيهِ مانِ",94,"ن",1,0],["وَأَنفاسي مُوَكَّلَةٌ بِروحٍ","أَراحَتها وَعُمرٍ أَمحَقَتهُ",95,"ت",2,0],["وَاِنفُض هُمومَكَ عَن فُؤادِكَ إِنَّنا","نَلقى الهُمومَ بِكُلِّ أَغلَبَ أَضخَمِ",96,"م",1,0],["وإنَّ في القلب مني","لحبِّ لَيلى نموّا",97,"و",2,0],["وإن فؤادي أوه يا أم فاِعلمي","يكاد عليه بالأسى يتصدع",98,"ع",1,0],["وأن فيه نصيبي","هو العذاب الوبيل",99,"ل",1,0],["وإن فراق الشيخ أَرضاً له بها","مُنىً مشهدٌ أَكبرْ بذلك مشهدا",100,"د",2,0],["وإن فاتَني عصر الشباب الَّذي خلا","فَما فاتَني يوماً لأفراحه الذكر",101,"ر",1,0],["وإِنَّ فِينَا صَبُوحاً إِنْ أَرِبْتَ بِهِ","جَمْعاً بَهِيّاً وآلاَفاً ثَمَانِينَا",102,"ن",2,0],["وأنفذ ما تلقاه حكماً إذا قضى","قضاءً ملوك الأرض منه غضاب",103,"ب",1,0],["وانفخ به من بأسِ روحكَ سورةً","يرمي سُطاها المستخفّ فيُحجِمُ",104,"م",1,0],["وأنفُسٌ قرشيّاتٌ يُطرِّبها","صوتٌ يرنُّ به رمحٌ وصمصامُ",105,"م",1,0],["وأَنفَقَ ما أَفادَ بِحُسنِ هَديٍ","وتَقديرٍ بِلا سَرَفٍ مُبيرِ",106,"ر",1,0],["وَآنَفُ سَعْياً فِي رِكَابٍ فَكَيْفَ بِي","وَِلي كُلَّ حَوْلٍ آَخْذَةٌ بِرِكَابِ",107,"ب",1,0],["وَإِنَّ فِي ظِلِّهِ النَّادِي بِرَحْمَتِهِ","لبَلْسَماً لِجَراحِ القلْبِ وَالرَّاسِ",108,"س",1,0],["وَإِنَّ فَتىً لَم يَكسِرِ الأَسرُ قَلبَهُ","وَخَوضُ المَنايا جِدَّهُ لَنَجيبُ",109,"ب",1,0],["وأنفقت النور أمّ الضحا","فزادت ثراء إلى سؤدد",110,"د",1,0],["وَأَنفٌ عَلى وَجهِها مُلصَقٌ","قَصيرُ المَناخِرِ كَالفُستُقَه",111,"ق",2,0],["وأنفسُ الناسِ في ضيقٍ وفي كمدٍ","كأنّها زفرةٌ في صدرِ معمود",112,"د",1,0],["وَانفُوا عن الطبِّ الرَطانةَ إنّها","نَمَشٌ يَعيثُ بوجههِ الوضَّاح",113,"ح",1,0],["وأن فَتَاها لم يقفْ في ثيابه","أخو نجدَةٍ في يومٍ حربٍ ولا سلمِ",114,"م",1,0],["وأنفسُ شيءٍ في الحياةِ أزاهِرٌ","يُبعثرها شعبٌ على قدمَيْ شهمِ",114,"م",1,0],["وأنفًا أشمَّ يزيد ارتفاعًا","إذا شمَّ بعضُ الأنوف الصعيدا",115,"د",2,0],["وأنفت من صيد البزا","ة قصدت صياد البُزاة",116,"ا",2,0],["وإن فسح الرحمن في العمر برهة","فلا بد من حث المطية لا بدا",117,"د",2,0],["وانفضي عن رباك سود اللّيالي","واستفيقي على زئير الأسود",118,"د",1,0],["وإن فخروا بانتصار اللئام","فخذلاننا شرف مرغمُ",119,"م",1,0],["وان \" فراتاً \" للكفيءُ بشكرها","اذا مِتُ فليردُدْ عليها العواديا",120,"ي",2,0],["وأنفِت من هذي الطبيعة حرةً","يعاتقُها التدليسُ أن تتمخَّضا",121,"ض",2,0],["وأنفاسُ المُروج معطَّراتٌ","بأنفاسِ الرُعاة إلى المَراح",122,"ح",1,0],["وأن فؤاداً شع نوراً وقوَّةً","هو اليوم مسودُّ الجوانب بارد",123,"د",1,0],["وإنْ فاتَها وحشٌ صَليبٌ فؤادُه","تَعَرَّضَ وحشٌ منه أقسى وأصلَب",124,"ب",1,0],["وانفخن بالبسمات كلّ سيمذع","خاض العجاج ووجهه يتلالا",125,"ل",2,0],["وأنفقتُ، بالأنفاسِ، عُمري، مُجزّءاً","، بها اليَومَ ثمّ الشّهرَ، يتبعُهُ الشهر",126,"ر",1,0],["وانفصل الفصل بافتراق","فصار في غيبتي حضوري",127,"ر",2,0],["وأنفي إشاعات الهوى ، وهي حلوة","وأجعل تاريخي الجميل خرئبا",128,"ب",2,0],["وأنفي إشاعات الهوى.. وهي حلوة","وأجعل تاريخي الجميلَ خرائبا",129,"ب",2,0],["وانفذت في الخافقين امرها","وهاب قلب الدهر من اخطارها",130,"ر",3,0],["وانفض يديك من الحياة إِذا","يوماً أطقت عن الهوْى صبرا",131,"ر",2,0],["وإنّ في العلم آداباً وتذكرةً","للغافلين وتذكيراً لِمدّكِرِ",132,"ر",1,0],["وإن فاض معك فكه تجيب جوز سَبح","وجلْد حنّه معْ صفيحة مياه",133,"ه",1,0],["وأنَّ فروعَ البان من أرض بِيشَةٍ","حبيبٌ إلىّ ظلُّها وحَرورُها",134,"ر",3,0],["وَآنِفُهُ بِعَدلِكَ سَوفَ تَبقى","عَلى مَرِّ اللَيالي ما بَقينا",135,"ن",2,0],["وانفض يديك من العباد فكلُّهم","عجزاً يحل وأنت جهلاً تعقد",136,"د",1,0],["وأنفس طَهُرَت أنفاسها فسرت","في السرّ تنفح حباً حين تنتشق",137,"ق",1,0],["وأنفاسي تطاردُ مسرعاتَ","وفي قلبي لهيبتهِ رجيفُ",138,"ف",1,0],["وانفق كسبه في غير شيء","وكسب أبيه في علل الاداح",139,"ح",1,0],["وإن فرعن صمصام عنتر قرنه","فكم من جيوش عنك فرت من الذعر",140,"ر",1,0],["وان فوت الذي ترجوه أهون من","ادراكه بلئيم غير محتفل",141,"ل",1,0],["وأنفق أموالا كثيراً عديدها","والهمه البارى فنا في ذوى السر",142,"ر",1,0],["وان فرعون في دعوى ربوبية","أتى بحق ولم يكذب ولم يرب",143,"ب",1,0],["وإن فنيت أعمالكم فتجملوا","بما قلتم وزرى فحسبي ما زرى",144,"ر",2,0],["وَآنفُ أَن يُصبِحنَ في غَيرِ مَعشَري","فَأُصبِحُ قَد رَدّوا عَلَيَّ النَصائِبا",145,"ب",2,0],["وَأَنفَذتُها في حِكمَةٍ وَبَلاغَةٍ","كَسَت حُلَّةً مِن بَعدِ عَهدِكَ عاقِلا",146,"ل",2,0],["وَإِنَّ في مَجدِ تاجِ الدِينِ مُفتَخَراً","لَها مِن السَلَفِ الماضينَ يَكفيها",147,"ي",3,0],["وَآنَفُ مِن دَعوى الدَناني ضَلالَةً","بِناءَ المَعالي يا شَقاها مَعاليا",148,"ي",2,0],["وَإِنَّ فُؤادي عِندَ ذِكرِكَ ذائِبٌ","فَكَيفَ بِماءِ الدَمعِ في مُقلَةٍ شَكرى",149,"ر",2,0],["وأنفق البيض في مواضعها","صرت له من اقل غلمانه",150,"ن",2,0],["وإن فهم النجيب وشكّ غفلٌ","غبيّ فيه بردٌ وانقطاع",151,"ع",1,0],["وإن فاخروا بالتين جئنا بمثله","وزدنا عليهم بالمعرّق والبسر",152,"ر",1,0],["وَإِن فاتَني ما حازهُ كلُّ صالِحٍ","بِكنزٍ منَ الأعمالِ قد ذَخر الأجرا",153,"ر",2,0],["وانفح بذي سَلَمٍ نسيم ظلاله","وإذا مررتَ على العقيق فسلم",154,"م",1,0],["وأنفاسُ النسائمِ كهرباءٌ","توصلُ بينَ قلبيَ والخدودِ",155,"د",1,0],["وأنفقتُ أيامي كما أسرفتْ يدي","جواداً بمالي في هواها وبالعمرِ",156,"ر",1,0],["وأنفَذُ من وقع السهام تغازلٌ","على القرب أو حُسن الإشارة من بُعدِ",157,"د",1,0],["وأنفاسها بالليل كالمسك نفحةً","وظلماؤها كالخال في صفحة الخد",158,"د",1,0],["وأنفقت عمري في هواه لأنه","ظبي بهي أبدع الله حسنه",159,"ه",1,0],["وأنفقها في شدَّتي ورخائي","أجود بدمعي في محبة شامت",159,"ت",1,0],["وَاِنفَجَرَ البُركانُ حَتّى اِنثَنَت","تَدُبُّ نارُ اليَأسِ في مَرقَدي",160,"د",2,0],["وَأنَّ فِرعَونَ في حولٍ وَمَقدِرَةٍ","وَقومَ فِرعَونَ في الإِقدامِ كُفؤانِ",161,"ن",1,0],["وأنَفذُ من رمح الشّجاع سياستي","وأبصَرُ من عين البصيرِ ضِيا فهمي",162,"م",2,0],["وانفتح النرجِس عن أعين","مصفرَّةِ الأحداقِ من بُوسها",163,"س",3,0],["وإن فاته المعنى علته كثافة","وأصبح في أفعاله متلونا",164,"ن",2,0],["وَاِنفَعُ لي مِن بارِدِ الماءِ غِلَّةً","وَأَشهى مِنَ الدُنيا لِقَلبي مَواهِبا",165,"ب",2,0],["وَاِنفِ سِواهُ فَإِنَّهُ زَبَدٌ","وَاِصغِ إِلَيهِ فَإِنَّهُ زُبَدُ",166,"د",1,0],["وَإِنْ فَاحَ مِنْ نَجْدٍ نَسِيمُ عَرَارِهِ","يَطِيرُ بِهِ قَلْبٌ إِلَيْهِمُ حَنَّانُ",167,"ن",1,0],["وَانْفِ عَنَّا التَّلْبِيسَ وَالتَّدْلِيسَا","فَعَسَى لاَ نَرَى عَذَاباً بِيسَا",168,"س",2,0],["وَأَنفق مِن اِنعاهم في هلاكهم","جَزاءً بِهِ عَمري خَليقٌ وَلائِق",169,"ق",1,0],["وانف الأغيار وعنك أزل","وادخل للحان خليلِ وملْ",170,"ل",1,0],["وانفقت ما تحويه في طلب العلا","نوالا واحراز العلا عند بذله",171,"ل",2,0],["وان فاه في نظم يناظرها به","توهمته في فيه العهن لائكا",172,"ك",2,0],["وأنفاسكن العاطراتُ حملنَ لي","زفيراً وشعراً من شذا المسكِ أضوعا",173,"ع",2,0],["وان فَتى رمته جفون لَيلى","وَماتَ عَلى الفِراش هوَ الشَهيد",174,"د",1,0],["وان فَتى يمرّ بارض لَيلى","وَيَلثَم حيث موطئها سعيد",174,"د",1,0],["وان فجر اليَنبوع موسى من الصفا","فأحمد أَروى من أَنامله الركبا",175,"ب",2,0],["وان فض في الاكوان مسك ختامها","تعطر منها كل نجد وَغائر",176,"ر",1,0],["وان فتحت جنات عدن لداخل","فَقُل يا عِبادي هَذه الجنة ادخلوا",177,"ل",3,0],["وَإنْ فجَرتْ أعادِيه انْتِقاضاً","ولَجَّتْ في العُتوّ وفي النُّفورِ",178,"ر",1,0],["وأنْفَسُ مِنها ما أُفيدَ من الهُدى","وإن جَعَلَتْ تُربي عَلَى عَددِ التُّرْبِ",179,"ب",1,0],["وأنْفَذَ عدْوَ الخَيْلِ في طلبِ العِدى","وَبنْدُ الهُدى منهُ إلى ملكٍ نَدْبِ",179,"ب",1,0],["وَإِنَّ فَتىً رَآكَ لَهُ رَجاءَ","لأَهْلٌ أَنْ يُبَلَّغَ كُلَّ سُولِ",180,"ل",1,0],["وَأَنفاسَ صَبٍّ لَو دَنا مِن زَفيرِهِ","لَظى الرُمح قَيدَ الرُمحِ أَحرَقَتِ الجَمرا",181,"ر",2,0],["وَأَنفُضُ كُمّي في وُجوهِ مَعاشِرٍ","هُمُ زَجَروني فيكَ عَن سنَنِ القَصدِ",182,"د",1,0],["وإِنَّ فؤادي وهو شاكٍ من الهَوى","ليثنيه عن نهج السلوِّ حفاظُ",183,"ظ",1,0],["وأَنفضتْ برأْسها","كأنها مكفره",184,"ر",2,0],["وأنفق منه مهما كان مال","وقدم منه لليوم الثقيل",185,"ل",1,0],["وَإنّ فداءَ الكلِّ بالبعضِ سنّةٌ","تواترَ مِن شرعٍ وطبعٍ شهودها",186,"د",3,0],["وَإِنَّ فراقَهُ في كُلِّ أَمرٍ","وَصَرمَ حِبالِ خُلَّتِهِ شِفاءُ",187,"ا",2,0],["وَإِن فَتَرَت بَعدَ الهِبابِ ذَعَرتُها","بِأَسمَرَ شَختٍ ذابِلِ الصَدرِ مُدرَجِ",188,"ج",1,0],["وَأَنفَذَ في النَوائِبِ إِن أَلَمَّت","فَما فَضلُ الكَبيرِ عَلى الصَغيرِ",189,"ر",1,0],["وَأَنفُسُنا إِلى أَجَلٍ قَريب","سَيَأخُذُها المُعيرُ مِنَ المُعارِ",190,"ر",1,0],["وانفكِ الاقنى به فتنة","تدب في الاحشاء والاضلع",191,"ع",1,0],["وانفجرنا في نحيب","ولطمنا وجنتينا",192,"ن",2,0],["وانفحيني هناك","قبلة في الشفاء",193,"ا",2,0],["وانفري كالغزال","واحلمي كالعروس",193,"س",1,0],["وانفث الآلام حرى كبد","ان في الآلام سلوى وعزاء",194,"ا",2,0],["وَأَنفَقَ في نَصرِهِ مالِهِ","وَأَصفاهُ مِن وُدِّهِ كُلَّ صافِ",195,"ف",1,0],["وَآنف مِن مَدح الدنيِّ كَراهَةً","كَمَن باتَ بِالزرنيخ يَدهَن أَقرَعا",196,"ع",2,0],["وَاِنفح برفدك مِن جَفا","ك تَكرّماً وَاِرحب بِوَفدك",197,"ك",1,0],["وأنفُسٍ كَرُمَتْ منّا نَفائسُها","لو لم تَسِرْ ظُعْنُهمْ في الصُّبْح لم تَسَل",198,"ل",1,0],["وأنّ فتىً ما أنت مَقْصودُه عَمٍ","وأنّ يداً ما أنت مالِئُها صِفر",199,"ر",1,0],["وَإِن فَرَطَت مِنّا وَأَعيا اِتِّباعُها","فَيا لَيتَ أَنَّ النَفسَ لا تَتَتَبَّعُ",200,"ع",1,0],["وَأَنفاسُكُم لَيلُ الوِصالِ وَصَدُّكُم","لَهُ أَثَرٌ ما سَرَّكُم بِعِذاري",201,"ر",2,0],["وَأَنفُسٍ قَد جَهِلَت","أَنَّ النُفوسَ عابِرَه",202,"ر",2,0],["وإن فتى يلقى من البين مثلما","لقيتُ لمَعذور عليه مشيب",203,"ب",1,0],["وانفذ إليَّ الميقدُونيَّ كَي","يَحملَ مِن هَمِّي ما قَد حَمَل",204,"ل",1,0],["وإِنَّ في الخَيلِ لمَحمولَةٍ","مَحبوسَةٌ كالحامِلِ المُطلِقِ",205,"ق",1,0],["وإنَّ فُؤاداً يَحملُ البينُ بعضَ ذا","عليهِ ولا يأذى بهِ لَصبورُ",206,"ر",1,0],["وأنفعُ صومٍ كان يوماً مقدّراً","على أن أوفاه يعود بقلَّةِ",207,"ه",1,0],["وانفراد واعتزال","وانزواء وذبول",208,"ل",1,0],["وأنفاسك جواهر","عزيزات ثمينات",209,"ت",1,0],["وأنفذ سكان المغارب منهم","وكانوا عليهم من أشد المصائب",210,"ب",1,0],["وأنفقت ريعان الشبيبة والصبا","أفتش عن دُرّ الفوائد في الكتب",211,"ب",1,0],["وانفق الساعات في العلم وكن","آخذاً للعلم عن بحر عباب",212,"ب",1,0],["وَإِن فَطموا أَطفالهم بعد بُرهةٍ","فَعَن دَرِّها لا عَن عُلاها فِطامُها",213,"م",3,0],["وانفرادي رشد لي والهوى","أبدا يصرف عن سبل الرشادِ",214,"د",1,0],["وإنْ فاضَ دمعي لا أزال أُريقه","فمن كبدٍ تصلى ومن لوعةٍ تصلي",215,"ل",2,0],["وأَنْفَقْتَ مالاً لو قنعت ببعضه","إذَنْ لكفاك العمر مرعًى وموردا",216,"د",2,0],["وأنفقتُ أيَّامي على غير طائل","فلا منهلاً عذباً ولا عيشة رغدا",217,"د",2,0],["وأنفِق ما ملكتَ ولا تبالِ","فناصرُنا ثراءٌ للفقير",218,"ر",1,0],["وانفِق نفيس العمر في قهوة","تقضي على الهمّ قضاءً متاح",219,"ح",1,0],["وإن في أخويه خير تعزية","بل فيهما عوض فيه زياداتُ",220,"ت",1,0],["وإن في الصيد معنى ذاقه الأسدُ","فلازموه فأوقات الهنا جدُدُ",221,"د",1,0],["وإن فزت في تقبيل راحة كفه","رايت سحاب الجود يجري غزيرهُ",222,"ه",1,0],["وانْفَسَخَتْ هُدْنَةُ السُّلُوِّ فَمَا","تُوثَقُ منها عُقُودُ مِيثَاقِ",223,"ق",1,0],["وإِن فَنِيتُ فعندي","إِلى مَعَادٍ معادِنُ",224,"ن",1,0],["وإنّ فيما أرى من أمرِه عجَباً","يكادُ يُنكِرُهُ مَنْ ظلّ يسمعُهُ",225,"ع",2,0],["وأنِفْتَ للآدابِ أنْ يَسْطُو بِهَا","جَهْلُ الزَّمانِ وعَثْرَةُ الأيَّامِ",226,"م",1,0],["وأَنْفَسُ نفسٍ فِي الوَرى غيرَ أَنَّهُ","إِذَا لَقِيَ الأَعداءَ فَهْوَ بِهَا سَمْحُ",227,"ح",1,0],["وإِنْ فَزِعُوا نحو الصَّريخ فلا ونَى","وإِن وَرَدوا حَوْضَ المَنايا فلا فَرْقا",228,"ق",2,0],["وإِن فشت في نوادي القوم فاحشة","فشى الردى فيهم لا شك فاختبر",229,"ر",1,0],["وإن فقدت حبيباً من مواطنه","فاعلم بأنك بعد الفقد مفقود",230,"د",1,0],["وإن فؤادي صار من حرة الأسى","كمقروعة ملساء من حرة الحزن",231,"ن",1,0],["وانفث أشكو فرقة فيطبها","بأخرى كأن البين يطرب من نفثى",232,"ث",2,0],["وأنفاسه من طيب رياك تنتشي","ولولاك ما طابت ونثت عطوره",233,"ر",2,0],["وأنفقتُ عمري في المحبةِ للورى","فلم القَ إلا غادراً بعد غادر",234,"ر",1,0],["وإن فروضَ الجودِ كيف بعثتَها","إلى مفصِح حرٍّ فإنك تُقضاها",235,"ا",3,0],["وأنفُخُ بالشكوى وقلبيَ شاكر","وكم حركاتٍ تحتهنّ سكونُ",236,"ن",1,0],["وإنّ فرعاً أنت من","ه لكريمُ الجِذْمِ",237,"م",1,0],["وأنفٌ يجيشُ به منخراه","إذا سُدّ في آخرٍ منخرُ",238,"ر",1,0],["وإن فاتني مِن جودِهِ واصطفائِهِ","إلى اليوم ما تُسنِي يداه ويوهَبُ",239,"ب",1,0],["وانفدتُ دمع العين حتى وددتُني","بكيت دماً من لوعتي ولكَ الفضلُ",240,"ل",1,0],["وإِنْ فاخرتْ عُلْيا كِنانةَ سَرَّها","بأنْكَ شِهاب الحضرتين لها نجْلُ",241,"ل",1,0],["وانفقه في ملك يدوم بلا انقضا","به الأنبياء والصالحين مجاهرا",242,"ر",2,0],["وإن فارقت مالاً وأهلاً سوابقي","فعند المليك الظافر المال والأهل",243,"ل",1,0],["وآنف مما يقول الأنام","فأهدي الغزالة لمياء رودا",244,"د",2,0],["وَأَنفَسُ عَيشِ المَرءِ ما لَم يَكُن لَهُ","إِذا هَمَّ بِاللِذاتِ مِن دونِها ضِدُّ",245,"د",1,0],["وأنفسُ العُشّاقِ بعدَ النوى","قد بقيتْ منهنَّ أَرْماقُ",246,"ق",1,0],["وإن فاجأتني الحادثات توقعوا","حوادث أخرى لم أزل لها لاقيا",247,"ي",2,0],["وإن فكرت مما تركب هيكل","تجده على شكل الأصول الحقيقيه",248,"ي",2,0],["وإن فينا صبوحاً غير ممتزج","يصري الدماء عليه الصاب والصبر",249,"ر",1,0],["وإِنَّ فنِّي في الوُجودِ حُبُّهُ","إِنْ شُغِلَ الأَقوامُ بالفُنونِ",250,"ن",1,0],["وإنَّ فَتًى قَدْ طالَ شَوْطُ غَرامِهِ","وقَدْ ناهَزَ الْخَمْسينَ يُلْحَى ويَعْذَلُ",251,"ل",1,0],["وإنّ فَتىً يَغْشى الدَّنايا وبَيْتُهُ","عَلَى قِمَّةِ الْعَلْيا فَتىً غَيْرُ مُعيبِ",252,"ب",1,0],["وأنْفَقْتُ الشَّبِيبَةَ غَيْرَ وانٍ","لِمَجْدِ الشَّيْبِ فَلْيَهْنَ الْمَشيبُ",253,"ب",1,0],["وإنْ فخروا بطِخْفَةَ أوْ كلابٍ","فخرنا باللّيالي الغُرِّ فينا",254,"ن",2,0],["وإنْ فَنِيَتْ في الرّجالِ الحلو","مُ كان إلى حلمك المَفْزَعُ",255,"ع",1,0],["وإنْ فُقِدْتُ فلم يُفقَدْ كما علموا","قهري الأساودَ والآسادَ في الخِيسِ",256,"س",1,0],["وإنْ فُتّكُمْ فضلاً فكم فات قبلكمْ","سَبوقٌ على بُعد المدى لكوابِ",257,"ب",1,0],["وَإِن فاتَنا مِنهُ لَيثُ العَرين","فَقَد حاطَنا مِنكَ لَيثُ الشَّرى",258,"ا",1,0],["وانفض العثير يا ريح الحمى","عن سنا الوجه فداعيه دعا",259,"ع",2,0],["وانفصلنا أبدا من أزل","عين ماء دافق منسفح",260,"ح",1,0],["وأنفخ مزماري وأصغي لصوته","وأضرب دفي حين ترقص قينتي",261,"ي",1,0],["وانفض القلب من غبار الترجي","والتمني لجاههم والعلاء",262,"ا",2,0],["وإِن فَهم الاسماءَ كان خليفةً","وعاملهُ فِي الرفع يعملُ في الجرّ",263,"ر",1,0],["وأنفعُ العملِ المطلوبِ حينئذٍ","صبرٌ جميلٌ لجُرْحِ القلبِ فيهِ شَفا",264,"ف",2,0],["وإنْ فارَقتهُ يدعوكَ شَوقٌ","إليهِ قائداً بِزمامِ جَذْبِ",265,"ب",1,0],["وأنفقت ما تحويه في رفع شانها","كأن بها أوصاك من قبل آدم",266,"م",1,0],["وإِن فَنِيَتْ من ناظِرِي فيه أَدمُعٌ","لما فَنِيَتْ مِن مَقوْلِي فِيهِ أَشْعَارُ",267,"ر",1,0],["وأَنفقتُ من تِبْرِ المدامِع للأَسى","كنوزاً لهذا اليوم كُنْتُ ذخَرْتُها",268,"ت",3,0],["وأُنفقتُ عمري في مدائحِ معشرٍ","كَمَوتَى ولو أَنْصَفْتُ كُنَّ مراثِي",269,"ي",1,0],["وإِن فعلت فحَوَيْ","تَ لَمْعَةً مِنْ مَبْسِمِه",270,"م",2,0],["وانفَلَّ عَزْمِي واسْتُبي","حَت قلْعتي وانهدَّ رُكني",271,"ن",2,0],["وإِنَّ فمي مُغرىً بفيها لأَنَّه","رحيمٌ به أَبْصَرتم الثَّدْيَ للطفل",272,"ل",1,0],["وأَنفُسهُم عَاريةٌ منه عِنْدهم","مَتى ما أَرادَ اسْتَرجَعَتها يدُ الْقَتْل",272,"ل",1,0],["وَإِن فاتَ أَمرٌ قَدَّموني فَرُمتُهُ","ذِيادَ العَوادي عِندَ إِحدى الزَلازِلِ",273,"ل",1,0],["وَأَنفٍ مِثلِ عِرقِ السامِ حُرٍّ","وَتَسمَعُ مَنطِقاً مِنها رَخيما",274,"م",2,0],["وَآنف أَن أَعُدَّ عَلى نُمَيرٍ","وَقائِعَنا بِرَوضاتِ الرَبابِ",275,"ب",1,0]]}