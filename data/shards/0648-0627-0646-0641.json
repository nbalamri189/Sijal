للاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"]],"verses":[["وَأَنفُضُ ثِقلَكَ عَن عاتِقي","فَقَد طالَ ما أُدتَني يا جَبَل",0,"ل",1,0],["وَاِنفَكَّ سِلكُ نِظامِنا بَدَداً","وَلَقَد غَنينا وَهوَ مُؤتَلِفُ",1,"ف",1,0],["وَاِنفُض يَدَيكَ مِنَ الثَراءِ فَكَم مَضى","مِن دونِ ثَروَتِهِ البَخيلُ المُصلِحُ",2,"ح",1,0],["وَاِنفُض رِجالاً سَقوكَ الغَيظِ أَذنَبَةً","وَأَورَثوكَ مَضيضَ الداءِ وَالكَشَحا",3,"ح",2,0],["وَأَنْفَعُ مِنْ وَصْلِ الأَقَارِبِ لِلْفَتى","إِذَا زَهِدوا فِيهِ جِوارُ الأَباعِدِ",4,"د",1,0],["وإنّ في كَلِماتِ العُرْبِ شاردَةً","أداءَ ما شَرَطَتْهُ قَبْلَنا العَجَمُ",5,"م",1,0],["وإنْ فزِعَ الحيُّ منْ غالِبٍ","تدثَّرَهُ أسَدٌ أغْلَبُ",6,"ب",1,0],["وأنفُضُ اليَدَ منْ مالٍ إذا انْبَسَطَتْ","إليهِ عادَتْ بعِرْضٍ عنهُ مُمتَهَنِ",7,"ن",1,0],["وَإِنَّ فُؤادي لا يَلينُ إِلى هَوى","سِواكِ وَإِن قالوا بَلى سَيَلينُ",8,"ن",1,0],["وَأَنِفْتَ للِدِّينِ الْحَنِيفِ وَأَهْلِهِ","مِنْ أَنْ يَطِيحَ نَجِيعُهُ الْمَطْلُولُ",9,"ل",1,0],["وَإنْ فُقْتَهُ بِالْحِلْمِ وَالْعِلْمِ وَالنَّدَى","وَشَارَكْتَهُ فِي نُورِهِ وَانْتِقَالِهِ",10,"ل",2,0],["وإنْ فسحَ الرّحْمانُ في العُمْرِ برْهَةً","فلابُدّ من حثِّ المطيّةِ لابُدّا",11,"د",2,0],["وأنْفاسُنا سَكَتَتْ دَفْعَةً","كَجَهْرِ الصّلاةِ تَلاهُ القُنوتْ",12,"ت",1,0],["وَإِن فَحَصَ الناسُ عَن سَيِّدٍ","فَسَيِّدُكُم عَنهُ لا يُفحَصُ",13,"ص",1,0],["وَاِنفَحهُ عَنّا يا رَبيعُ بِكُلِّ ما","أَطلَعتَ مِن رَندٍ وَنَورِ أَقاحِ",14,"ح",1,0],["وَاِنفَحِ الرَوضَ بِنَشرٍ طَيِّبٍ","عَلَّهُ يوقِظُ سُكّانَ الشَجَر",15,"ر",1,0],["وَإِنَّ في لُكنَةِ اِبنِ عَونٍ لَما","يَشغَلُهُ عَن فَصاحَةِ العُربِ",16,"ب",1,0],["وَإِن فَخَروا يَوماً أَتَوا بِمُحَمَّدٍ","وَجِبريلَ وَالفُرقانِ ذي السوراتِ",17,"ت",1,0],["وَإِن فارَقَتهُ فُرَّقُ المُزنِ شايَعَت","بِهِ مُرجَحَّناتُ الغَمامِ الدَوالِحُ",18,"ح",1,0],["وإن فتنت بإحدى المزعجات نُرِق","منّا الدماء إلى أن نُخمد الفِتَنا",19,"ن",2,0],["وإن في البدر لخطباً به","في البدر لاحت بقع أربع",20,"ع",1,0],["وإن فضاءً شاسعاً قد تضاربت","بأبعاده أيدي القوى لرهيب",21,"ب",1,0],["وَإِن فَتَنَ الشَيطانُ أَهلَ ضَلالَةٍ","لَقوا مِنكَ حَرباً حَميُها غَيرُ بارِدِ",22,"د",1,0],["وانفذ حتى النملُ ما في بيوتهم","وعُلل بالسَّوفِ الوليدُ المهذَّبُ",23,"ب",1,1],["وانفذ النمل بالصرائم ما","جمع الحاطبون ما اتنشبوا",24,"ب",3,0],["وَإِنَّ فُؤادي لِاِفتِقادِ أَسيرِهِ","أَسيرٌ بِأَيدي الحادِثاتِ رَهينُ",25,"ن",1,0],["وإن فتح الراوي معاني فخاره","فدع ما رواه آل خاقان للفتح",26,"ح",1,0],["وأنفق الخاءآتِ لكنه","لعبدهِ من وفرِها ما رضخ",27,"خ",1,0],["وإن فاضَ درًّا على سامع","فأنمل حامله الجسَّر",28,"ر",1,0],["وأنفقت عمرِي في المليحِ محبَّةً","فإن يسلني عذلٌ فيا ضيعة العمر",29,"ر",1,0],["وأنفقوا تبره عليهِ ثناً","في حالتيه إنفاق أكياس",30,"س",1,0],["وإن فاتني ماء الحياة بثغره","فكم نصبٍ لاقيت من دون ريه",31,"ي",2,0],["وانْفق له دينار من ضنٍّ وشح","ولا تبل أخفّ وزناً أم رجح",32,"ح",1,0],["وانفضي الكف من فتى ما تردى","برداء الأجداد والآباء",33,"ا",2,0],["وأنفاسٌ كأنفاسِ الخُزامَى","قبيلَ الصبحِ بَلَّتها السماءُ",34,"ا",2,0],["وإنَّ فَضْلَةَ كأْسٍ أنتَ مُفْضِلُها","لَذاتُ بَرْدٍ على الأحْشَاء والكَبدِ",35,"د",1,0],["واَنفِ السَّوادَ عن البياض فإنه","ما في بياض يد الكريم سوادُ",36,"د",1,0],["وإنّ فقيراً عدّ عَمْراً لفقره","مسدَّاً لذو فقرين فقر على فقر",37,"ر",1,0],["وإن فينا لبُقيا بعدما سلمت","نفس الإمام لنا من كل محذور",38,"ر",1,0],["وانفتق الجو بريح غدت","رَوحاً بمنِّ الفاتق الراتق",39,"ق",1,0],["وإنَّ فوْتَ الذي أُبادرُهُ","أرمضُ لي مِنْ مُردَّدِ العذَلِ",40,"ل",1,0],["وأنَّ فيهم وفاءً لا نقومُ به","ولن يكونَ مع النُّقصانِ رُجحان",41,"ن",1,0],["وانفث من الصدر ما يُضِرُّ به","لا تتركِ الداء فيه مدفونا",42,"ن",2,0],["وَاِنفَحنَ بِالبَسَماتِ كُلَّ شُمَيذَعٍ","خاضَ العَجاجَ وَوَجهُهُ يَتَلالا",43,"ل",2,0],["وَإِن فازَ سَهمي كَفَّكُم عَن مَقاعِدٍ","لَكُم خَلفَ أَدبارِ البُيوتِ وَمُنظَرِ",44,"ر",1,0],["وَإِن فُزتَ بِالتَقبيلِ يَوماً لِكَفِّهِ","رَأَيتُ بِحارَ الجودِ يَجري نَميرُها",45,"ر",3,0],["وَآنَفُ إِمّا عِزَّةً مِنكَ نِلتُها","وَإِمّا لِإِذلالٍ بِهِ أَتَعَتَّبُ",46,"ب",1,0],["وانفحيني مِنْ روحِكِ الفَخْمِ مَا يُبْ","لغُ صَوْتي آذَانَ هذا الإِلهِ",47,"ه",1,0],["وانْفُخِ النَّايَ فالحَيَاةُ ظَلامٌ","مَا لِمُرْتادِهِ من الهَوْلِ حَامِ",48,"م",1,0],["وانْفخي في مَشاعِري مَرَحَ الدُّنيا","وشُدِّي مِنْ عزميَ المجهودِ",49,"د",1,0],["وَأُنفِقُ في كَسبِ المَحامِدِ مُهجَتي","وَلَو كانَ في الذِكرِ الجَميل حِمامي",50,"ي",1,0],["وَاِنفَضَّ نادٍ بِالشَآمِ وَسامِرٌ","في مِصرَ أَنتَ هَزارُهُ الصَدّاحُ",51,"ح",1,0],["وَاِنفَع بِوُسعِكَ كُلِّهِ","إِنَّ المُوَفَّقَ مَن نَفَع",52,"ع",1,0],["وَأَنَّ في راحَتَي مِصرٍ وَصاحِبِها","عَهداً وَعَقداً بِحَقٍّ كانَ مُغتَصَبا",53,"ب",2,0],["وَإِن فارَقَتنِيَ أَمطارُهُ","فَأَكثَرُ غُدرانِها ما نَضَب",54,"ب",1,0],["وَأَنفُسُهُم مَبذولَةٌ لِوُفودِهِم","وَأَموالُهُم في دارِ مَن لَم يَفِد وَفدُ",55,"د",1,0],["وَإِن فَقَدَ الإِعطاءَ حَنَّت يَمينُهُ","إِلَيهِ حَنينَ الإِلفِ فارَقَهُ الإِلفُ",56,"ف",1,0],["وَأَنفَسُ ما لِلفَتى لُبُّهُ","وَذو اللُبِّ يَكرَهُ إِنفاقَهُ",57,"ق",2,0],["وَآنَفُ مِن أَخي لِأَبي وَأُمّي","إِذا ما لَم أَجِدهُ مِنَ الكِرامِ",58,"م",1,0],["وَأَنفُسٌ يَلمَعِيّاتٌ تُحِبُّهُمُ","لَها اِضطِراراً وَلَو أَقصَوكَ شَنآنا",59,"ن",2,0],["وآنف أن أجاوبه ولكن","رأيت الحلم لا يَزَعُ العبيدا",60,"د",2,0],["وانف الغرائب فالأركان تجمعها","أخوة في فتاء السن والكبرِ",61,"ر",1,0],["وأَنفقتُ من عُمْرِي وذاتِ يدي بها","بضائِعَ لم أملِكْ لهُنَّ حسابَا",62,"ب",2,0],["وَإِن فَصَدتَ اِبتِغاءَ البُرءِ مِن سَقَمٍ","فَقَد أَرَقتَ دَماً يَشفي مِنَ الكَلَبِ",63,"ب",1,0],["وَأَنفٌ إِذا اِحمَرَّ في وَجهِهِ","وَقامَ تَوَهَّمتَهُ مِحجَمَه",64,"م",2,0],["وَآنَفُ لِلدَيّانِ أَن تَرتَمي بِهِ","غِضابُ قَوافي الشِعرِ خَمساً وَأَربَعا",65,"ع",2,0],["وَأَنفَقتَ مالَ اللَهِ في غَيرِ حَقِّهِ","عَلى نَهرِكَ المَشؤومِ غَيرِ المُبارَكِ",66,"ك",1,0],["وَأَنَّ فِرارَ المُسلِمينَ خَزايَةٌ","وَأُحدوثَةٌ تَنمي إِلى كُلِّ مَوسِمِ",67,"م",1,0],["وَإِنَّ في الجَنَّةِ لِلرَوحَ وَالر","رَيحانَ وَالراحَةَ وَالسَلسَبيل",68,"ل",1,0],["وانفاقُ الحياةِ واضحكُ الأيامِ","مني واكذبةُ السلوانِ",69,"ن",1,0],["وأنفق فيه قلبه وشبابه","فلم يَبقَ إلا الجرح والشفق الدامي",70,"ي",1,0],["وَأَنْفَدَ الصَّبْرَ مِنِّي ثُمَّ جَدَّدَهُ","يَا لَيْتَهُ لَمْ يُجَدِّدْ مِنْهُ مَا نَفِدَا",71,"د",2,0],["وَإِن فاتَني إِعذارُ شِبليكَ بِالغنى","فإنَّ بترك العزم مُتّضِحَ العُذرِ",72,"ر",1,0],["وأنفاسها أذكى إذا انصرف الدجى","وريقتُها أشهى ومقلتها أسبى",73,"ب",2,0],["وَأَنفُسٌ تَسَعُ الأَرضَ الفَضاءَ وَلا","يَرضَونَ أَو يُجشِموها فَوقَ ما تَسَعُ",74,"ع",1,0],["وَاِنفَح لَنا مِن طيبِ خَيمِكَ نَفحَةً","إِن كانَتِ الأَخلاقُ مِمّا توهَبُ",75,"ب",1,0],["وانفسْ بنفسِ عزوفٍ","تواقةٍ للمعالي",76,"ي",1,0],["وأنفرُ عن علمِ الكلامِ لثغرها","لئلا أورِّي عنهُ بالجوهرِ الفردِ",77,"د",1,0],["وإنَّ في عمرٍ عدلاً ومعرفةً","فكيفَ يُصْرَفُ عن هذا بلا سببِ",78,"ب",1,0],["وأنفذَهُ إلى كعبٍ كتاباً","كأنّ سُطُورَهُ البِيضُ الحِدادُ",79,"د",1,0],["وَأَنفَسُ حَظَّيكَ الَّذي لا تَنالُهُ","وَأَنكى عَدُوَّيكَ الَّذي لا تُقاتِلُه",80,"ل",2,0],["وَانفتح الباب عَن مصلّبة","خيفة شَرّ هُناك ينذرها",81,"ر",3,0],["وَاِنفخ إِباءَك في آنافهم غَضَباً","فَقَد تُحَرِّكُ أَصنامَ المَحاريبِ",82,"ب",1,0],["وَأَنفٍ كَحَدِّ السَيفِ دَقَّ وَحاجِبٍ","وَصَدرٍ كَفا ثَورِ اللُجَينِ وَمِعصَمِ",83,"م",1,0],["وَاِنفِلاقُ الأَمواجِ طَورَينِ عَن مو","سى وَبَعدُ المُمَلَّكُ الطالوتُ",84,"ت",1,0],["وَأَنفُهُ كَسُترَةٍ","تُحشى مِنَ الإِفريزِ",85,"ز",1,0],["وَإِنَّ فيها بَناتِ الكَرمِ ما تَرَكَت","مِنها اللَيالي سِوى تِلكَ الحُشاشاتِ",86,"ت",1,0],["وإنّ في النيكِ لمستمتعاً","عنه اعتياضُ الخبزِ للمستضيف",87,"ف",1,0],["وَاِنفَرَجَت عَن أَسَدٍ أَلَدِّ","وَعَن نُمورٍ حَولَهُ وَأُسدِ",88,"د",1,0],["وَأََنفُسُ هَذِهِ الأَجسامِ طَيرٌ","بُزاةُ حِمامِها مُتَصَيِّداتُ",89,"ت",1,0],["وَإِن فَرَعوا جَبَلاً شامِخاً","فَلَيسَ يُعَنَّفُ أَن يَحدَبا",90,"ب",2,0],["وَإِن فِضتَ لِلأَقوامِ بِالمالِ وَالغِنى","فَيا بَحرُ أَيقِن بِالنُضوبِ وَإِن جِشتا",91,"ت",2,0],["وَاِنفَرِدي في بَلَدٍ عازِبٍ","عَنّا وَعيشي ذاتَ بالٍ رَخي",92,"ي",1,0],["وَأَنفَقتُ بِالأَنفاسِ عُمري مُجَزِّئاً","بِها اليَومَ ثُمَّ الشَهرَ يَتبَعُهُ الشَهرُ",93,"ر",1,0],["وَإِن فَهِما خِطابَ الدَهرِ مِثلي","فَما سَعِدا بِما يَمنيهِ مانِ",94,"ن",1,0],["وَأَنفاسي مُوَكَّلَةٌ بِروحٍ","أَراحَتها وَعُمرٍ أَمحَقَتهُ",95,"ت",2,0],["وَاِنفُض هُمومَكَ عَن فُؤادِكَ إِنَّنا","نَلقى الهُمومَ بِكُلِّ أَغلَبَ أَضخَمِ",96,"م",1,0],["وإنَّ في القلب مني","لحبِّ لَيلى نموّا",97,"و",2,0],["وإن فؤادي أوه يا أم فاِعلمي","يكاد عليه بالأسى يتصدع",98,"ع",1,0],["وأن فيه نصيبي","هو العذاب الوبيل",99,"ل",1,0],["وإن فراق الشيخ أَرضاً له بها","مُنىً مشهدٌ أَكبرْ بذلك مشهدا",100,"د",2,0],["وإن فاتَني عصر الشباب الَّذي خلا","فَما فاتَني يوماً لأفراحه الذكر",101,"ر",1,0],["وأنفذ ما تلقاه حكماً إذا قضى","قضاءً ملوك الأرض منه غضاب",102,"ب",1,0],["وانفخ به من بأسِ روحكَ سورةً","يرمي سُطاها المستخفّ فيُحجِمُ",103,"م",1,0],["وأنفُسٌ قرشيّاتٌ يُطرِّبها","صوتٌ يرنُّ به رمحٌ وصمصامُ",104,"م",1,0],["وأَنفَقَ ما أَفادَ بِحُسنِ هَديٍ","وتَقديرٍ بِلا سَرَفٍ مُبيرِ",105,"ر",1,0],["وَآنَفُ سَعْياً فِي رِكَابٍ فَكَيْفَ بِي","وَِلي كُلَّ حَوْلٍ آَخْذَةٌ بِرِكَابِ",106,"ب",1,0],["وَإِنَّ فِي ظِلِّهِ النَّادِي بِرَحْمَتِهِ","لبَلْسَماً لِجَراحِ القلْبِ وَالرَّاسِ",107,"س",1,0],["وَإِنَّ فَتىً لَم يَكسِرِ الأَسرُ قَلبَهُ","وَخَوضُ المَنايا جِدَّهُ لَنَجيبُ",108,"ب",1,0],["وأنفقت النور أمّ الضحا","فزادت ثراء إلى سؤدد",109,"د",1,0],["وَأَنفٌ عَلى وَجهِها مُلصَقٌ","قَصيرُ المَناخِرِ كَالفُستُقَه",110,"ق",2,0],["وأنفسُ الناسِ في ضيقٍ وفي كمدٍ","كأنّها زفرةٌ في صدرِ معمود",111,"د",1,0],["وَانفُوا عن الطبِّ الرَطانةَ إنّها","نَمَشٌ يَعيثُ بوجههِ الوضَّاح",112,"ح",1,0],["وأن فَتَاها لم يقفْ في ثيابه","أخو نجدَةٍ في يومٍ حربٍ ولا سلمِ",113,"م",1,0],["وأنفسُ شيءٍ في الحياةِ أزاهِرٌ","يُبعثرها شعبٌ على قدمَيْ شهمِ",113,"م",1,0],["وأنفًا أشمَّ يزيد ارتفاعًا","إذا شمَّ بعضُ الأنوف الصعيدا",114,"د",2,0],["وأنفت من صيد البزا","ة قصدت صياد البُزاة",115,"ا",2,0],["وإن فسح الرحمن في العمر برهة","فلا بد من حث المطية لا بدا",116,"د",2,0],["وانفضي عن رباك سود اللّيالي","واستفيقي على زئير الأسود",117,"د",1,0],["وإن فخروا بانتصار اللئام","فخذلاننا شرف مرغمُ",118,"م",1,0],["وان \" فراتاً \" للكفيءُ بشكرها","اذا مِتُ فليردُدْ عليها العواديا",119,"ي",2,0],["وأنفِت من هذي الطبيعة حرةً","يعاتقُها التدليسُ أن تتمخَّضا",120,"ض",2,0],["وأنفاسُ المُروج معطَّراتٌ","بأنفاسِ الرُعاة إلى المَراح",121,"ح",1,0],["وأن فؤاداً شع نوراً وقوَّةً","هو اليوم مسودُّ الجوانب بارد",122,"د",1,0],["وإنْ فاتَها وحشٌ صَليبٌ فؤادُه","تَعَرَّضَ وحشٌ منه أقسى وأصلَب",123,"ب",1,0],["وانفخن بالبسمات كلّ سيمذع","خاض العجاج ووجهه يتلالا",124,"ل",2,0],["وأنفقتُ، بالأنفاسِ، عُمري، مُجزّءاً","، بها اليَومَ ثمّ الشّهرَ، يتبعُهُ الشهر",125,"ر",1,0],["وانفصل الفصل بافتراق","فصار في غيبتي حضوري",126,"ر",2,0],["وأنفي إشاعات الهوى ، وهي حلوة","وأجعل تاريخي الجميل خرئبا",127,"ب",2,0],["وأنفي إشاعات الهوى.. وهي حلوة","وأجعل تاريخي الجميلَ خرائبا",128,"ب",2,0],["وانفذت في الخافقين امرها","وهاب قلب الدهر من اخطارها",129,"ر",3,0],["وانفض يديك من الحياة إِذا","يوماً أطقت عن الهوْى صبرا",130,"ر",2,0],["وإنّ في العلم آداباً وتذكرةً","للغافلين وتذكيراً لِمدّكِرِ",131,"ر",1,0],["وإن فاض معك فكه تجيب جوز سَبح","وجلْد حنّه معْ صفيحة مياه",132,"ه",1,0],["وأنَّ فروعَ البان من أرض بِيشَةٍ","حبيبٌ إلىّ ظلُّها وحَرورُها",133,"ر",3,0],["وَآنِفُهُ بِعَدلِكَ سَوفَ تَبقى","عَلى مَرِّ اللَيالي ما بَقينا",134,"ن",2,0],["وانفض يديك من العباد فكلُّهم","عجزاً يحل وأنت جهلاً تعقد",135,"د",1,0],["وأنفس طَهُرَت أنفاسها فسرت","في السرّ تنفح حباً حين تنتشق",136,"ق",1,0],["وأنفاسي تطاردُ مسرعاتَ","وفي قلبي لهيبتهِ رجيفُ",137,"ف",1,0],["وانفق كسبه في غير شيء","وكسب أبيه في علل الاداح",138,"ح",1,0],["وإن فرعن صمصام عنتر قرنه","فكم من جيوش عنك فرت من الذعر",139,"ر",1,0],["وان فوت الذي ترجوه أهون من","ادراكه بلئيم غير محتفل",140,"ل",1,0],["وأنفق أموالا كثيراً عديدها","والهمه البارى فنا في ذوى السر",141,"ر",1,0],["وان فرعون في دعوى ربوبية","أتى بحق ولم يكذب ولم يرب",142,"ب",1,0],["وإن فنيت أعمالكم فتجملوا","بما قلتم وزرى فحسبي ما زرى",143,"ر",2,0],["وَآنفُ أَن يُصبِحنَ في غَيرِ مَعشَري","فَأُصبِحُ قَد رَدّوا عَلَيَّ النَصائِبا",144,"ب",2,0],["وَأَنفَذتُها في حِكمَةٍ وَبَلاغَةٍ","كَسَت حُلَّةً مِن بَعدِ عَهدِكَ عاقِلا",145,"ل",2,0],["وَإِنَّ في مَجدِ تاجِ الدِينِ مُفتَخَراً","لَها مِن السَلَفِ الماضينَ يَكفيها",146,"ي",3,0],["وَآنَفُ مِن دَعوى الدَناني ضَلالَةً","بِناءَ المَعالي يا شَقاها مَعاليا",147,"ي",2,0],["وَإِنَّ فُؤادي عِندَ ذِكرِكَ ذائِبٌ","فَكَيفَ بِماءِ الدَمعِ في مُقلَةٍ شَكرى",148,"ر",2,0],["وأنفق البيض في مواضعها","صرت له من اقل غلمانه",149,"ن",2,0],["وإن فهم النجيب وشكّ غفلٌ","غبيّ فيه بردٌ وانقطاع",150,"ع",1,0],["وإن فاخروا بالتين جئنا بمثله","وزدنا عليهم بالمعرّق والبسر",151,"ر",1,0],["وَإِن فاتَني ما حازهُ كلُّ صالِحٍ","بِكنزٍ منَ الأعمالِ قد ذَخر الأجرا",152,"ر",2,0],["وانفح بذي سَلَمٍ نسيم ظلاله","وإذا مررتَ على العقيق فسلم",153,"م",1,0],["وأنفاسُ النسائمِ كهرباءٌ","توصلُ بينَ قلبيَ والخدودِ",154,"د",1,0],["وأنفقتُ أيامي كما أسرفتْ يدي","جواداً بمالي في هواها وبالعمرِ",155,"ر",1,0],["وأنفَذُ من وقع السهام تغازلٌ","على القرب أو حُسن الإشارة من بُعدِ",156,"د",1,0],["وأنفاسها بالليل كالمسك نفحةً","وظلماؤها كالخال في صفحة الخد",157,"د",1,0],["وأنفقت عمري في هواه لأنه","ظبي بهي أبدع الله حسنه",158,"ه",1,0],["وأنفقها في شدَّتي ورخائي","أجود بدمعي في محبة شامت",158,"ت",1,0],["وَاِنفَجَرَ البُركانُ حَتّى اِنثَنَت","تَدُبُّ نارُ اليَأسِ في مَرقَدي",159,"د",2,0],["وَأنَّ فِرعَونَ في حولٍ وَمَقدِرَةٍ","وَقومَ فِرعَونَ في الإِقدامِ كُفؤانِ",160,"ن",1,0],["وأنَفذُ من رمح الشّجاع سياستي","وأبصَرُ من عين البصيرِ ضِيا فهمي",161,"ي",1,0],["وانفتح النرجِس عن أعين","مصفرَّةِ الأحداقِ من بُوسها",162,"س",3,0],["وإن فاته المعنى علته كثافة","وأصبح في أفعاله متلونا",163,"ن",2,0],["وَاِنفَعُ لي مِن بارِدِ الماءِ غِلَّةً","وَأَشهى مِنَ الدُنيا لِقَلبي مَواهِبا",164,"ب",2,0],["وَاِنفِ سِواهُ فَإِنَّهُ زَبَدٌ","وَاِصغِ إِلَيهِ فَإِنَّهُ زُبَدُ",165,"د",1,0],["وَإِنْ فَاحَ مِنْ نَجْدٍ نَسِيمُ عَرَارِهِ","يَطِيرُ بِهِ قَلْبٌ إِلَيْهِمُ حَنَّانُ",166,"ن",1,0],["وَانْفِ عَنَّا التَّلْبِيسَ وَالتَّدْلِيسَا","فَعَسَى لاَ نَرَى عَذَاباً بِيسَا",167,"س",2,0],["وَأَنفق مِن اِنعاهم في هلاكهم","جَزاءً بِهِ عَمري خَليقٌ وَلائِق",168,"ق",1,0],["وانف الأغيار وعنك أزل","وادخل للحان خليلِ وملْ",169,"ل",1,0],["وانفقت ما تحويه في طلب العلا","نوالا واحراز العلا عند بذله",170,"ل",2,0],["وان فاه في نظم يناظرها به","توهمته في فيه العهن لائكا",171,"ك",2,0],["وأنفاسكن العاطراتُ حملنَ لي","زفيراً وشعراً من شذا المسكِ أضوعا",172,"ع",2,0],["وان فَتى رمته جفون لَيلى","وَماتَ عَلى الفِراش هوَ الشَهيد",173,"د",1,0],["وان فَتى يمرّ بارض لَيلى","وَيَلثَم حيث موطئها سعيد",173,"د",1,0],["وان فجر اليَنبوع موسى من الصفا","فأحمد أَروى من أَنامله الركبا",174,"ب",2,0],["وان فض في الاكوان مسك ختامها","تعطر منها كل نجد وَغائر",175,"ر",1,0],["وان فتحت جنات عدن لداخل","فَقُل يا عِبادي هَذه الجنة ادخلوا",176,"ل",3,0],["وَإنْ فجَرتْ أعادِيه انْتِقاضاً","ولَجَّتْ في العُتوّ وفي النُّفورِ",177,"ر",1,0],["وأنْفَسُ مِنها ما أُفيدَ من الهُدى","وإن جَعَلَتْ تُربي عَلَى عَددِ التُّرْبِ",178,"ب",1,0],["وأنْفَذَ عدْوَ الخَيْلِ في طلبِ العِدى","وَبنْدُ الهُدى منهُ إلى ملكٍ نَدْبِ",178,"ب",1,0],["وَإِنَّ فَتىً رَآكَ لَهُ رَجاءَ","لأَهْلٌ أَنْ يُبَلَّغَ كُلَّ سُولِ",179,"ل",1,0],["وَأَنفاسَ صَبٍّ لَو دَنا مِن زَفيرِهِ","لَظى الرُمح قَيدَ الرُمحِ أَحرَقَتِ الجَمرا",180,"ر",2,0],["وَأَنفُضُ كُمّي في وُجوهِ مَعاشِرٍ","هُمُ زَجَروني فيكَ عَن سنَنِ القَصدِ",181,"د",1,0],["وإِنَّ فؤادي وهو شاكٍ من الهَوى","ليثنيه عن نهج السلوِّ حفاظُ",182,"ظ",1,0],["وأَنفضتْ برأْسها","كأنها مكفره",183,"ر",2,0],["وأنفق منه مهما كان مال","وقدم منه لليوم الثقيل",184,"ل",1,0],["وَإنّ فداءَ الكلِّ بالبعضِ سنّةٌ","تواترَ مِن شرعٍ وطبعٍ شهودها",185,"د",3,0],["وَإِنَّ فراقَهُ في كُلِّ أَمرٍ","وَصَرمَ حِبالِ خُلَّتِهِ شِفاءُ",186,"ا",2,0],["وَإِن فَتَرَت بَعدَ الهِبابِ ذَعَرتُها","بِأَسمَرَ شَختٍ ذابِلِ الصَدرِ مُدرَجِ",187,"ج",1,0],["وَأَنفَذَ في النَوائِبِ إِن أَلَمَّت","فَما فَضلُ الكَبيرِ عَلى الصَغيرِ",188,"ر",1,0],["وَأَنفُسُنا إِلى أَجَلٍ قَريب","سَيَأخُذُها المُعيرُ مِنَ المُعارِ",189,"ر",1,0],["وانفكِ الاقنى به فتنة","تدب في الاحشاء والاضلع",190,"ع",1,0],["وانفجرنا في نحيب","ولطمنا وجنتينا",191,"ن",2,0],["وانفحيني هناك","قبلة في الشفاء",192,"ا",2,0],["وانفري كالغزال","واحلمي كالعروس",192,"س",1,0],["وانفث الآلام حرى كبد","ان في الآلام سلوى وعزاء",193,"ا",2,0],["وَأَنفَقَ في نَصرِهِ مالِهِ","وَأَصفاهُ مِن وُدِّهِ كُلَّ صافِ",194,"ف",1,0],["وَآنف مِن مَدح الدنيِّ كَراهَةً","كَمَن باتَ بِالزرنيخ يَدهَن أَقرَعا",195,"ع",2,0],["وَاِنفح برفدك مِن جَفا","ك تَكرّماً وَاِرحب بِوَفدك",196,"ك",1,0],["وأنفُسٍ كَرُمَتْ منّا نَفائسُها","لو لم تَسِرْ ظُعْنُهمْ في الصُّبْح لم تَسَل",197,"ل",1,0],["وأنّ فتىً ما أنت مَقْصودُه عَمٍ","وأنّ يداً ما أنت مالِئُها صِفر",198,"ر",1,0],["وَإِن فَرَطَت مِنّا وَأَعيا اِتِّباعُها","فَيا لَيتَ أَنَّ النَفسَ لا تَتَتَبَّعُ",199,"ع",1,0],["وَأَنفاسُكُم لَيلُ الوِصالِ وَصَدُّكُم","لَهُ أَثَرٌ ما سَرَّكُم بِعِذاري",200,"ي",1,0],["وَأَنفُسٍ قَد جَهِلَت","أَنَّ النُفوسَ عابِرَه",201,"ر",2,0],["وإن فتى يلقى من البين مثلما","لقيتُ لمَعذور عليه مشيب",202,"ب",1,0],["وانفذ إليَّ الميقدُونيَّ كَي","يَحملَ مِن هَمِّي ما قَد حَمَل",203,"ل",1,0],["وإِنَّ في الخَيلِ لمَحمولَةٍ","مَحبوسَةٌ كالحامِلِ المُطلِقِ",204,"ق",1,0],["وإنَّ فُؤاداً يَحملُ البينُ بعضَ ذا","عليهِ ولا يأذى بهِ لَصبورُ",205,"ر",1,0],["وأنفعُ صومٍ كان يوماً مقدّراً","على أن أوفاه يعود بقلَّةِ",206,"ه",1,0],["وانفراد واعتزال","وانزواء وذبول",207,"ل",1,0],["وأنفاسك جواهر","عزيزات ثمينات",208,"ت",1,0],["وأنفذ سكان المغارب منهم","وكانوا عليهم من أشد المصائب",209,"ب",1,0],["وأنفقت ريعان الشبيبة والصبا","أفتش عن دُرّ الفوائد في الكتب",210,"ب",1,0],["وانفق الساعات في العلم وكن","آخذاً للعلم عن بحر عباب",211,"ب",1,0],["وَإِن فَطموا أَطفالهم بعد بُرهةٍ","فَعَن دَرِّها لا عَن عُلاها فِطامُها",212,"م",3,0],["وانفرادي رشد لي والهوى","أبدا يصرف عن سبل الرشادِ",213,"د",1,0],["وإنْ فاضَ دمعي لا أزال أُريقه","فمن كبدٍ تصلى ومن لوعةٍ تصلي",214,"ي",1,0],["وأَنْفَقْتَ مالاً لو قنعت ببعضه","إذَنْ لكفاك العمر مرعًى وموردا",215,"د",2,0],["وأنفقتُ أيَّامي على غير طائل","فلا منهلاً عذباً ولا عيشة رغدا",216,"د",2,0],["وأنفِق ما ملكتَ ولا تبالِ","فناصرُنا ثراءٌ للفقير",217,"ر",1,0],["وانفِق نفيس العمر في قهوة","تقضي على الهمّ قضاءً متاح",218,"ح",1,0],["وإن في أخويه خير تعزية","بل فيهما عوض فيه زياداتُ",219,"ت",1,0],["وإن في الصيد معنى ذاقه الأسدُ","فلازموه فأوقات الهنا جدُدُ",220,"د",1,0],["وإن فزت في تقبيل راحة كفه","رايت سحاب الجود يجري غزيرهُ",221,"ه",1,0],["وانْفَسَخَتْ هُدْنَةُ السُّلُوِّ فَمَا","تُوثَقُ منها عُقُودُ مِيثَاقِ",222,"ق",1,0],["وإِن فَنِيتُ فعندي","إِلى مَعَادٍ معادِنُ",223,"ن",1,0],["وإنّ فيما أرى من أمرِه عجَباً","يكادُ يُنكِرُهُ مَنْ ظلّ يسمعُهُ",224,"ع",2,0],["وأنِفْتَ للآدابِ أنْ يَسْطُو بِهَا","جَهْلُ الزَّمانِ وعَثْرَةُ الأيَّامِ",225,"م",1,0],["وأَنْفَسُ نفسٍ فِي الوَرى غيرَ أَنَّهُ","إِذَا لَقِيَ الأَعداءَ فَهْوَ بِهَا سَمْحُ",226,"ح",1,0],["وإِنْ فَزِعُوا نحو الصَّريخ فلا ونَى","وإِن وَرَدوا حَوْضَ المَنايا فلا فَرْقا",227,"ق",2,0],["وإِن فشت في نوادي القوم فاحشة","فشى الردى فيهم لا شك فاختبر",228,"ر",1,0],["وإن فقدت حبيباً من مواطنه","فاعلم بأنك بعد الفقد مفقود",229,"د",1,0],["وإن فؤادي صار من حرة الأسى","كمقروعة ملساء من حرة الحزن",230,"ن",1,0],["وانفث أشكو فرقة فيطبها","بأخرى كأن البين يطرب من نفثى",231,"ث",2,0],["وأنفاسه من طيب رياك تنتشي","ولولاك ما طابت ونثت عطوره",232,"ر",2,0],["وأنفقتُ عمري في المحبةِ للورى","فلم القَ إلا غادراً بعد غادر",233,"ر",1,0],["وإن فروضَ الجودِ كيف بعثتَها","إلى مفصِح حرٍّ فإنك تُقضاها",234,"ا",3,0],["وأنفُخُ بالشكوى وقلبيَ شاكر","وكم حركاتٍ تحتهنّ سكونُ",235,"ن",1,0],["وإنّ فرعاً أنت من","ه لكريمُ الجِذْمِ",236,"م",1,0],["وأنفٌ يجيشُ به منخراه","إذا سُدّ في آخرٍ منخرُ",237,"ر",1,0],["وإن فاتني مِن جودِهِ واصطفائِهِ","إلى اليوم ما تُسنِي يداه ويوهَبُ",238,"ب",1,0],["وانفدتُ دمع العين حتى وددتُني","بكيت دماً من لوعتي ولكَ الفضلُ",239,"ل",1,0],["وإِنْ فاخرتْ عُلْيا كِنانةَ سَرَّها","بأنْكَ شِهاب الحضرتين لها نجْلُ",240,"ل",1,0],["وانفقه في ملك يدوم بلا انقضا","به الأنبياء والصالحين مجاهرا",241,"ر",2,0],["وإن فارقت مالاً وأهلاً سوابقي","فعند المليك الظافر المال والأهل",242,"ل",1,0],["وآنف مما يقول الأنام","فأهدي الغزالة لمياء رودا",243,"د",2,0],["وَأَنفَسُ عَيشِ المَرءِ ما لَم يَكُن لَهُ","إِذا هَمَّ بِاللِذاتِ مِن دونِها ضِدُّ",244,"د",1,0],["وأنفسُ العُشّاقِ بعدَ النوى","قد بقيتْ منهنَّ أَرْماقُ",245,"ق",1,0],["وإن فاجأتني الحادثات توقعوا","حوادث أخرى لم أزل لها لاقيا",246,"ي",2,0],["وإن فكرت مما تركب هيكل","تجده على شكل الأصول الحقيقيه",247,"ي",2,0],["وإن فينا صبوحاً غير ممتزج","يصري الدماء عليه الصاب والصبر",248,"ر",1,0],["وإِنَّ فنِّي في الوُجودِ حُبُّهُ","إِنْ شُغِلَ الأَقوامُ بالفُنونِ",249,"ن",1,0],["وإنَّ فَتًى قَدْ طالَ شَوْطُ غَرامِهِ","وقَدْ ناهَزَ الْخَمْسينَ يُلْحَى ويَعْذَلُ",250,"ل",1,0],["وإنّ فَتىً يَغْشى الدَّنايا وبَيْتُهُ","عَلَى قِمَّةِ الْعَلْيا فَتىً غَيْرُ مُعيبِ",251,"ب",1,0],["وأنْفَقْتُ الشَّبِيبَةَ غَيْرَ وانٍ","لِمَجْدِ الشَّيْبِ فَلْيَهْنَ الْمَشيبُ",252,"ب",1,0],["وإنْ فخروا بطِخْفَةَ أوْ كلابٍ","فخرنا باللّيالي الغُرِّ فينا",253,"ن",2,0],["وإنْ فَنِيَتْ في الرّجالِ الحلو","مُ كان إلى حلمك المَفْزَعُ",254,"ع",1,0],["وإنْ فُقِدْتُ فلم يُفقَدْ كما علموا","قهري الأساودَ والآسادَ في الخِيسِ",255,"س",1,0],["وإنْ فُتّكُمْ فضلاً فكم فات قبلكمْ","سَبوقٌ على بُعد المدى لكوابِ",256,"ب",1,0],["وَإِن فاتَنا مِنهُ لَيثُ العَرين","فَقَد حاطَنا مِنكَ لَيثُ الشَّرى",257,"ا",1,0],["وانفض العثير يا ريح الحمى","عن سنا الوجه فداعيه دعا",258,"ع",2,0],["وانفصلنا أبدا من أزل","عين ماء دافق منسفح",259,"ح",1,0],["وأنفخ مزماري وأصغي لصوته","وأضرب دفي حين ترقص قينتي",260,"ي",1,0],["وانفض القلب من غبار الترجي","والتمني لجاههم والعلاء",261,"ا",2,0],["وإِن فَهم الاسماءَ كان خليفةً","وعاملهُ فِي الرفع يعملُ في الجرّ",262,"ر",1,0],["وأنفعُ العملِ المطلوبِ حينئذٍ","صبرٌ جميلٌ لجُرْحِ القلبِ فيهِ شَفا",263,"ف",2,0],["وإنْ فارَقتهُ يدعوكَ شَوقٌ","إليهِ قائداً بِزمامِ جَذْبِ",264,"ب",1,0],["وأنفقت ما تحويه في رفع شانها","كأن بها أوصاك من قبل آدم",265,"م",1,0],["وإِن فَنِيَتْ من ناظِرِي فيه أَدمُعٌ","لما فَنِيَتْ مِن مَقوْلِي فِيهِ أَشْعَارُ",266,"ر",1,0],["وأَنفقتُ من تِبْرِ المدامِع للأَسى","كنوزاً لهذا اليوم كُنْتُ ذخَرْتُها",267,"ت",3,0],["وأُنفقتُ عمري في مدائحِ معشرٍ","كَمَوتَى ولو أَنْصَفْتُ كُنَّ مراثِي",268,"ي",1,0],["وإِن فعلت فحَوَيْ","تَ لَمْعَةً مِنْ مَبْسِمِه",269,"م",2,0],["وانفَلَّ عَزْمِي واسْتُبي","حَت قلْعتي وانهدَّ رُكني",270,"ي",1,0],["وإِنَّ فمي مُغرىً بفيها لأَنَّه","رحيمٌ به أَبْصَرتم الثَّدْيَ للطفل",271,"ل",1,0],["وأَنفُسهُم عَاريةٌ منه عِنْدهم","مَتى ما أَرادَ اسْتَرجَعَتها يدُ الْقَتْل",271,"ل",1,0]]}