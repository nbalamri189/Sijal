{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[24,"بان الشباب وأمسى الشيب قد أزفا","https://www.aldiwan.net/poem21869.html","البسيط"],[90,"نزلت تجر إلى الغروب ذيولا","https://www.aldiwan.net/poem44454.html","الكامل"],[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[72,"أرسلته في حاجة","https://www.aldiwan.net/poem42821.html","مجزوء الكامل"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[71,"قالوا يجوز خمول شخص في الصبا","https://www.aldiwan.net/poem29014.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[146,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[203,"هات اسقنيها والدجى ساحب","https://www.aldiwan.net/poem45641.html","السريع"],[242,"أفدي رشا للوصال قالي","https://www.aldiwan.net/poem18859.html","مجزوء البسيط"],[255,"من منصفي من معشر","https://www.aldiwan.net/poem14962.html","مجزوء الكامل"],[369,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[409,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[415,"إني لأعرف من وجه العدو وإن","https://www.aldiwan.net/poem32039.html","البسيط"],[426,"كالخط في كتب الغلام أجاده","https://www.aldiwan.net/poem4859.html","الكامل"],[469,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[469,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[572,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[584,"نفسي تميل إِلى الهوى فأَردها","https://www.aldiwan.net/poem56776.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122774","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44616","السريع"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16829","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18483","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77258","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65112","الكامل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110836","الرمل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108075","البسيط"],[3705,"","https://poetry.dctabudhabi.ae/diwan/poem/145364","البسيط"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141469","الكامل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99263","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111483","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36580","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36556","الدوبيت"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81274","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72562","البسيط"],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[3591,"ضعفٌ ألم بقلبي بعدما ارتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=149393",""],[5213,"أهي الطلول تلوح من ربواتها","https://www.poetsgate.com/ViewPoem.aspx?id=170424",""],[5277,"بصراويّة","https://www.poetsgate.com/ViewPoem.aspx?id=185787",""],[5277,"سنابلُ الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=192165",""],[5277,"أبتي.. عُدْ لي.. واكْتلْ منّي كيْلَ سعير..","https://www.poetsgate.com/ViewPoem.aspx?id=199927",""],[3957,"وقد تلين ببعض القول تبذله","https://www.poetsgate.com/ViewPoem.aspx?id=201173",""],[5409,"عش في زمانك ما استطعت نبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155496",""],[5425,"إِبْتِهَالْ","https://www.poetsgate.com/ViewPoem.aspx?id=198924",""],[5442,"مادون رامة من معرس","https://www.poetsgate.com/ViewPoem.aspx?id=114778",""],[5493,"جنة اللقيا","https://www.poetsgate.com/ViewPoem.aspx?id=205178",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[566,"بكيت والمحتزن البكي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507632",""]],"verses":[["كَالخَيلِ رُبِّطنَ دُهماً في مَواقِفِها","وَالبُزلِ قُطِّرنَ بَينَ الحَوضِ وَالعَطَنِ",0,"ن",1,0],["كَالخَمرِ يَعبِسُ حاسيها عَلى مِقَةٍ","وَالكَأسُ تَجلو عَليهِ ثَغرَ مُبتَسِمِ",1,"م",1,0],["كَالخالِيَينِ إِذا ما صَوَّبا اِرتَفَعا","لا يَحقِرانِ مِنَ الخُطبانِ ما نَقِفا",2,"ف",2,0],["كالخود ظلّت يوم ودّع الفها","ترنو وترفع خلفه المنديلا",3,"ل",2,0],["كالخيزران لعاطفيه وإن","عجمته نائبة فكالنبعه",4,"ع",2,0],["كَالخَمرِ يُرسَلُ لِلفُؤا","دِ بِها فَتَصعَدُ لِلدِماغِ",5,"غ",1,0],["كَالخوطِ في القَدِّ وَالغَزالَةِ في البَه","جَةِ وَاِبنِ الغَزالِ في غَيَدِه",6,"د",2,0],["كَالخالِ في وَجنَةٍ زِيدَت مَحاسِنُها","بِنُقطَةٍ مِنهُ أَضعافاً مِنَ القِيَمِ",7,"م",1,0],["كالخمرِ ذَلَّتْ في مبادئِ عمرِها","وتحكَّمَتْ في العقلِ وهي عجوزُ",8,"ز",1,0],["كالخَوْدِ أبْدَتْ للمحِبْ","بِ جَفاءَها وَدَلالَها",9,"ل",3,0],["كالخطب يدوي له كون بجملته","إذا أصاب الردى شعباً بشاعره",10,"ر",2,0],["كالْخَوْدِ ضَمَّتْ ثِيَاباً","عُجْباً وَأَرْخَتْ ثِيَابَا",11,"ب",2,0],["كالخمر للشارب كيف شاءها","تصرَّفت مصطبَحا ومغتَبق",12,"ق",1,0],["كالخدِ والدمعِ ولكنها","ليست من الوردِ ولا النرجسِ",13,"س",1,0],["كَالْخَوْطِ وَالظَّبْيِ وَالْهِلاَل ِ","فِي الْقَدِّ وَاللَّحْظِ وَالْجَمَالِ",14,"ل",1,0],["كالخطِّ يسهل في الطُّرو","س ومَحوُهُ مُتَعَذِّرُ",15,"ر",1,0],["كالخِضْرِ في حَضَرٍ وبَدْوٍ موغِلاً","دهْري أُمزِّق سبْسباً عن سبْسَب",16,"ب",1,0],["كالخمر إلا أنه","حِلٌّ أراه بلا ارتياب",17,"ب",1,0],["كالخَطِّ يلحَظُهُ القاري فيوصِلُ مَعْ","ناهُ إلى قَلْبِه في الوقتِ ناظرُهُ",18,"ه",1,0],["كَالخَطِّ في كُتُبِ الغُلامِ أَجادَه","بِمدادِهِ وَأَسَدَّ مِن أَقلامِهِ",19,"م",2,1],["كالخمر حسناً في أكفّ سقاتها","وبوجهِ شاربها وفي عنقودها",20,"د",3,0],["كالخمر بالأفواهِ دائرةٌ على الأسما","ع تغنى عن أكفّ سقاتها",21,"ت",3,0],["كَالْخَدِّ لاقَتْهُ العُيُونُ فَعَصْفَرَتْ","مُبْيَضَّ وَجْنَتِهِ بِلَحْظٍ مُخْجِلِ",22,"ل",1,0],["كالْخيلِ جامحةَ العريكةِ تبتغي","فَكَّ اللِّجامِ؛ فتنتشي قَدَماها!",23,"ا",3,0],["كالخَشفِ دَبَّت فيهِ قَزقَفُ خَمرَةٍ","في عَينيه سِنَةٌ وَلَيسَ بِنائِمِ",24,"م",1,0],["كَالخَمرِ أَروى ما يَكونُ الفَتى","مِن شُربِها أَعطَشَ ما كانا",25,"ن",2,0],["كالخيلِ يصهلُ فيكَ الجرحُ مطرداً","فدعهُ يصهلُ مثلَ الخيلِ مطّردا",26,"د",2,0],["كَالخَدِّ يَصبُغُهُ الحَياءُ بِحُمرَةٍ","وَجَرى عَلَيهِ الدَمعُ خُلطَ الإِثمِدِ",27,"د",1,0],["كالخيل لا يسبق منها إلا","مضمِّر لأكله ما قلا",28,"ل",2,0],["كالخورِ نور الخزامى بينها قطعٌ","مما جذبن ومما كان قد جذبا",29,"ب",2,0],["كَالخَزِّ إِلّا أَنَّها أَليَنُ","كَفُّ فَتاةٍ لَحظُها يُثخِنُ",30,"ن",1,1],["كالخلّ فارق خلّهُ وتلاقيا","بعد اشتياقهما وفرط صبابة",31,"ه",1,0],["كالختانين إذا ما التقيا","وجب الغسل وإن لم ينزل",32,"ل",1,0],["كالخوض في غيبة فيه وفي كذب","والاشتغال بذكر البيع والسلم",33,"م",1,0],["كالخيزرانة قد لانت معاطفه","ومن ثانياه سالت بنت عنقود",34,"د",1,0],["كالخودِ ألقتْ رواقَ الخدرِ ناظرةً","ثمَّ استردَّت حياءً فوقها الطنبا",35,"ب",2,0],["كالخمر يعلو الماء حُمرة لونه","وشعاعُها يعلو بياض الماء",36,"ا",2,0],["كالخيزرانةِ ما لاحتْ لها وَرَقٌ","إلا من الوَشْي بين التِّبْر والوَرِقِ",37,"ق",1,0],["كالخَيطَلَينِ مُثَقَّفَينِ تَأَثَّرا","في الغابِ أَرنَبَةً وَخِشفاً يَرتَعُ",38,"ع",1,0],["كَالخَاتَمِ طَوعَ كَفِّها تَملِكُني","كَالقرط بِها مَدى اللَيالي عَلِقا",39,"ق",2,0],["كالختمِ مِنَ المِسكِ عَلى صَفوِ طِلى","كالنَدِّ عَلى النار زَهاه العَرفُ",40,"ف",1,0],["كَالخاطر الوَهمي جالَ مُحَمَد","في البَيت ثُمَ مَضى مضي الخاطر",41,"ر",1,0],["كالخمر يورث منها الصرف عربدة","والماء يكسر حين المزج شرَّتها",42,"ه",2,0],["كالخال أبيض حل وجنة أسود","هل كان إلا للملاحة سالبا",43,"ب",2,0],["كالخائف انتهز الفرار تسللا","فمشى الضراء ولج في الإيغال",44,"ل",1,0],["كالخوخ يؤكل لم يلذذ بلذته","ولا يلذه إلا الذي أكلا",45,"ل",2,0],["كالخشف في لحظاتها والظبي ف","لفتانها والريم في نغماتها",46,"ت",3,0],["كالخيزران..عليها تلتوي غنجاً","ساقٌ كأنّ به الفيروزُ والدررُ",47,"ر",1,0],["كالخيزرانِ..طريّةٌ أعوادُها","ينبيكَ عن خيلائها أعلاها",48,"ا",3,0],["كالخيزرانِ تلفّتتْ أعوادهُ","لترى الجمالَ بظلِّ غصنِ البانِ",49,"ن",1,0],["كالخيزران منيعا منك مكسره","وقد يرى ليّنا فى كفّ لاويه",50,"ي",2,0],["كالخيل إن عرفتك من فرسانها","جعلتك تعتقد اللجام فضولا",51,"ل",2,0],["كالخَمْرِ تَغْفُو بِجَوفِ الدِنِّ مَا عَتِقَتْ","حَتَّى تُحِيلُ طُيُوفَ الحُبِّ أَرْوَاحَا",52,"ح",2,0],["كالخود تجلى في الثيا","ب تظل تخلعها وتلبس",53,"س",1,0],["كَالخَافِقين تقابلَا عندَ المسَا","ليلً تغشَّى شَمسَهُ واحتلَّا",54,"ل",2,0],["(كالخضر) أعلم إذ أقيم جدارهُ","أيُّ الكنوز تنام تحت جداريا",55,"ي",2,0],["كَالخَيلِ هَبَّ القَهرُ يَقطَعُنِي","- بِيدًا - إِذا تَعدُو النَّوَى أُطْوى",56,"و",2,0],["كَالخُصِّ إِذ جَلَّلَه الباريُّ","بِحَيثُ مالَ الهائِلُ الشَرقِيُّ",57,"ي",1,0]]}