ml","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85438","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140953",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42614","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42678","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54779","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54651","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54643","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55102","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54662","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43777","الرمل"],[87,"إنْ شئتَ أنْ تحوى المعاليَ","https://www.poetsgate.com/ViewPoem.aspx?id=14068",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[77,"أنتم من مناسب الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=33807",""],[77,"لمّا دعا داعي الهوى لبّيْتُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=33806",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[54,"اصْرِميني يا خِلْقَة َ المجْدارِ","https://www.poetsgate.com/ViewPoem.aspx?id=14279",""],[45,"وَصْلٌ تُقَارِبُ مِنْهُ ثُمّ تُبَاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31620",""],[29,"بان الشّبابُ، ورُبّما عَلّلْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17433&r=&rc=6",""],[31,"ذَكَرَ القَلْبُ ذِكْرَة ً أُمَّ زَيْدٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18749&r=&rc=12",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["فَلَقَت ظُبى الأَسيافِ مِنكَ بَعَرجَةٍ","فَيَكادُ يُنهِضُها مِنَ الأَجفانِ",0,"ن",1,0],["فَلَقَد سَقى خَدَّيَّ ذِك","رُكَ دَمعَ عَينَيَّ السَجوما",1,"م",2,0],["فَلَقَلَّما غَضِبَت عَلى","أَشبالِها أُسدُ الأَجَم",2,"م",1,0],["فَلَقَد تَخَلَّفَ مَجدُهُ","عِبأً عَلى الدُنيا ثَقيلا",3,"ل",2,0],["فَلَقَد عَهِدتُ بِها كَنافِرَةِ المَها","مِن كُلِّ مَمشوقِ القَوامِ قَضيفِ",4,"ف",1,0],["فَلَقَد جَرَرتُ عَلى الزَمانِ عَوائِدي","إِنّي أَدُقُّ زُحوفَهُ بِزُحوفي",4,"ي",1,0],["فَلَقَد حَلَلتَ مِنَ الفُؤادِ مَحَلَّةً","في حَيثُ لَيسَ مِنَ الوَرى لَكَ جارُ",5,"ر",1,0],["فَلَقَد تَمَعَّكَ في مَواطِئِ عيسيكُم","يَومَ الوَداعِ تَمَعُّكَ المَؤودِ",6,"د",1,0],["فَلَقَد مَضى حامي السُروحِ مِنَ العِدى","وَمُبيحُ أَسوُقِها غِرارَ القاضِبِ",7,"ب",1,0],["فَلَقَد فُجِعتُ بِكُلِّ فَرعٍ باذِخٍ","مِن عيصِ مُدرِكَةَ الأَعَزِّ الأَطيَبِ",8,"ب",1,0],["فَلَقَد أَصابَ بِسَهمِهِ ال","غَرَضَينِ مِن عَيني وَقَلبي",9,"ي",1,0],["فَلَقَد رَجَعتَ عَنِ المُطيعِ بِسَلوَةٍ","مِن بَعدِ ما جَرَتِ الدُموعُ دِماءَ",10,"ا",2,0],["فَلَقيتُ سَلمى وَالكَرى","في عَينِهِ فُقِئَتْ يَعيثُ",11,"ث",1,0],["فَلِقِلَّة الأَشباهِ فيما أُوتِيَتْ","أَضحَت تُدلُّ بكثرةِ العشُّاقِ",12,"ق",1,0],["فلَقَّيْتَني سُوْءاً لَقيتَ مَسرَّةً","وخَيَّبْتَ آمالي بَقيتَ مُؤمَّلا",13,"ل",2,0],["فلقدْ ذَكَرْتُ العامريّةَ ذِكْرَةً","لا يُسْتَشَفُّ وَراءَها النّسيانُ",14,"ن",1,0],["فلقد صَحِبْتُ أُزَيهِرَ بنَ مُحَلِّمٍ","حيثُ السّيوفُ يَبُلُّ غُلَّتَها الدَّمُ",15,"م",1,0],["فَلَقَد نِلتِ في الفُؤادِ مَحَلاً","لَو تَمَنَّيتِ زادَ فَوقَ التَمنّي",16,"ن",2,0],["فَلَقَد خَصَصتُكِ بِالهَوى وَصَرَفتُهُ","عَمَّن يُحَدَّثُ عَنكُمُ فَيَغارُ",17,"ر",1,0],["فَلَقَد أَتاكَ مِنَ المُهَيمِنِ عَفوُهُ","وَأَفاضَ مِن نِعَمٍ عَلَيكَ مَزيدا",18,"د",2,0],["فَلَقَدْ فَازَ سَالِكٌ جَعَلَ الل","ه إلى الله قَصْدَهُ وَمَأَمَّهْ",19,"م",2,0],["فَلَقَدْ شَهِدْتَ وَمَا شَهِدْتُ كَمَوْقِفٍ","وَالنَّاسُ قَدْ وَصَلُوا الصَّرَاخَ وَأَعْوَلُوا",20,"ل",3,0],["فلَقٌ على شَفَقٍ يكُرّ لحكمَةٍ","خفِيَتْ وأمْرٌ تحْتَهُ أسْرارُ",21,"ر",1,0],["فلقَدْ أمِنْتَ منَ الزّمانِ ورَيْبِهِ","وهُوَ المروِّعُ للمُسيءِ وللبَري",22,"ي",1,0],["فلقَدْ أنْجَبوكَ يا عُمْدَةَ الحيْ","يِ وربِّ البيْتِ الرّفيعِ العِمادِ",23,"د",1,0],["فلقَدْ شَهِدْتُ بأنّ قُرْبَكَ جنّةٌ","حقّاً وأنّي بالغرام شهيدُ",24,"د",1,0],["فلَقَدْ هَمَمْتُ بأن أقومَ بواجِبي","منْ حَقِّ مَدْحِكَ ثمّ ما وَفّيتُهُ",25,"ت",2,0],["فَلَقَد نَحُلُّ بِهِ وَنَرعى رِعيَهُ","وَلَقَد نَليهِ بِقُوَّةٍ وَعَتادِ",26,"د",1,0],["فَلَقَد تُصلَقُ القِداحُ عَلى النَي","بِ إِذا كانَ يَسرُهُنَّ غَراما",27,"م",2,0],["فَلَقَد وَلّى فَريدٌ وَاِنطَوى","رُكنُ مِصرٍ وَفَتاها وَالسَنَد",28,"د",1,0],["فَلَقَد زانَكِ المَشيبُ بِتاجٍ","لا يُدانيهِ في الجَلالِ مُداني",29,"ن",2,0],["فَلَقَد حَلَلتُ بِها حَنيفاً مُسلِماً","وَرَحَلتُ عَنها بِاِعتِقادِ يَهودي",30,"ي",1,0],["فَلَقَد مَضَيتَ وَما كَسَبتَ خَطيئَةً","وَتَرَكتَ دارَ بَليَّةٍ وَفَسادِ",31,"د",1,0],["فَلَقَد كُنتُ لَعَمري فادِياً","لَكِ بِالمالِ وَبَعضِ الوَلَدِ",32,"د",1,0],["فَلَقَد أَقَرَّ العَينَ أَنَّكَ","غُرَّةُ الزَمَنِ البَهيم",33,"م",1,0],["فَلَقّى مُناوِئَهُ ما اِتَّقى","وَأَعطى مُؤَمِّلَهُ ما سَأَل",34,"ل",1,0],["فَلَقَدْ شَهِدْنَا مِنْكَ كُل فَضِيلَةٍ","شَفَّتْ عَنِ الغَدِ مِنْ أَرَقِّ لِثَامِ",35,"م",1,0],["فَلَقَدْ تَبَلَّغَ التُّجْارُ بِحَقٍّ","رُتْبَةً فَوْقَ رُتْبَةِ الأقْيَالِ",36,"ل",1,0],["فَلَقَد بَكَتهُ في السَماءِ مَلائِكٌ","زُهرٌ كِرامٌ راكِعونَ وَسُجَّدُ",37,"د",1,0],["فَلَقَد سُمَيتي بِوَجهِكِ وَالوَص","لِ قُروحاً أُعيتُ عَلى المِسبارِ",38,"ر",1,0],["فَلَقَد حَدا بِكَ حادِيانِ إِلى البِلى","وَدَعاكَ داعٍ لِلرَحيلِ فَصيحُ",39,"ح",1,0],["فلقد ظهرت من الكمال بمستوى","ما بعده لذوي الخلافة مَأْمَلُ",40,"ل",1,0],["فَلَقُ الصباح بوجهه","عوَّذْتُه بالناسِ",41,"س",1,0],["فلقد رأيت ضياء مجدك مشرقاً","في وجه كل حلاحل ديان",42,"ن",1,0],["فلقد وفاك الجيش حقك سابغاً","إذ قام فيك على البلاد مهيمنا",43,"ن",2,0],["فلقد عفا المجد القديم بأرضه","وعليه جرّ الدهر ذيل خُمُوله",44,"ل",2,0],["فلقد فقدنا سّيد الظرفا","وأجلّ ساعٍ للعلاء سعى",45,"ع",2,0],["فَلَقَد يُطاعُ بِنا الشَفيعُ لَدَيكُمُ","وَنُطيعُ فيكِ مَوَدَّةً مَن يَشفَعُ",46,"ع",1,0],["فَلَقَد أَنى لَكَ أَن تُوَدِّعَ خُلَّةً","فَنِيَت وَكانَ حِبالُها أَرماما",47,"م",2,0],["فَلَقَد أُعوِصُ بِالخَصمِ وَقَد","أَملَأُ الجَفنَةَ مِن شَحمِ القُلَل",48,"ل",1,0],["فَلَقَد يَراني موعِدِيَّ كَأَنَّني","في قَصرِ دومَةَ أَو سَواءِ الهَيكَلِ",49,"ل",1,0],["فَلَقَد رَأَيتُ بِبَطنِ بَدرٍ مِنهُمُ","قَتلى تَسِحُّ لَها العُيونُ وَتَدمَعُ",50,"ع",1,0],["فلقد وجدت ديارَ مل","كك بالسعادةِ عامره",51,"ر",2,0],["فلقد طربت إلى المصي","ف ووقته الحسن العزيز",52,"ز",1,0],["فَلَقَد صَيَّرَكَ الوَج","دُ مِنَ الأَحشاءِ داني",53,"ن",2,0],["فلقد ترى المعروف يحسُن عند من","لم يصْطَنِعْه وحمدُه لسواهُ",54,"ه",1,0],["فلقد يأذنُ الكريمُ على جدْ","وَى يديه ووجهُهُ مَحْجُوبُ",55,"ب",1,0],["فَلِقَلْبي تحرُّكٌ وسُكُونٌ","كلّما هاجَ 