{"poems":[[55,"هل كان يومك إلا بعد أيام","https://www.aldiwan.net/poem29754.html","البسيط"],[53,"يا قحطبي كما يقال وربما","https://www.aldiwan.net/poem66533.html","البسيط"],[68,"وما أتاني كتاب منك يأمرني","https://www.aldiwan.net/poem38432.html","البسيط"],[128,"سكينة عندها دعد","https://www.aldiwan.net/poem23778.html","مجزوء الوافر"],[376,"يا من يرى أن كل ما ملكت","https://www.aldiwan.net/poem57145.html","المنسرح"],[473,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[487,"بجزع الحمى ظبي حمى ذلك الحمى","https://www.aldiwan.net/poem24477.html","عموديه"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124296","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101249","الطويل"],[3635,"","https://poetry.dctabudhabi.ae/diwan/poem/199874",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4984,"نذيرُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=175528",""],[5145,"سقياً لها مقطنة غضة","https://www.poetsgate.com/ViewPoem.aspx?id=108212",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""]],"verses":[["أَلا اِتَّقَيتَ بِما سَوَّمتَ مِن عُدَدٍ","وَما تَعَلَّمتَ مِن نَقضٍ وَإِبرامِ",0,"م",1,0],["ألّا اتَّعظْتَ وقد رأيتَ مَواسمي","هيهاتَ ثَقَّل رَأسَك القرنان",1,"ن",1,0],["إلا أتيتك من فرط السرور به","عجلان أعثر في أذيال آمالي",2,"ي",1,0],["ألا أتحف أَلا أسعف","فمن قيس ومن هند",3,"د",1,0],["ألا أتوا ما أتوه في رَهجِ ال","حَربِ غَداةَ الوَغى إذا عَزَمُوا",4,"م",3,0],["إِلّا أَتَيتِ عَلى الصِبا","لِلإِعتِذارِ عَلى التَصابي",5,"ب",2,0],["ألا أتلات الطرد محضرة الذرى","وإن مر بالعسفان فهو أناثما",6,"م",2,0],["ألا أت بقُلّ من كثير وعدّه","كسرد ثمين الدر في سلك ناظم",7,"م",1,0],["إلا اتّقت بِرضاهُ سَورَةَ الغَضَبِ","أمطَتهُ قُورِيّةٌ أَعنانَ صَهوتِها",8,"ه",2,0],["ألا اتفقوا إن رمتم المجد والعلى","ليحمد عقباكم بكل زمان",9,"ن",1,0],["إلا أتيت مبادراً عجلاً","وأرحت من نكد ومن مطل",10,"ل",1,0],["ألا أتعس الرحمان من أطمع العدى","ومن يرتضي فينا الضراعة والجبنا",11,"ن",2,0],["الا اتهام الخل والنصيح","اذا لجميع قولهم كالريح",12,"ح",1,0],["ألا اترك لماضيك ذكرى القبور","لتقتحم اللحظة الفادحهْ",13,"ح",2,0],["إلا أتت من دونها غصة","تمري من العين أحاليبها",14,"ب",3,0],["إلا أتتهم به فيحتكموا","فيه بحق ما فيه من حيف",15,"ف",1,0],["10. ألاَ اتقِ اللهَ يا مَنْ ليسَ يشْبِههُ","الاّ ظِّباء النَّقا في تَلِ مِكناسِ",16,"س",1,0]]}