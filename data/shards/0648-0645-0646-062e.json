{"poems":[[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[42,"لنا جيرة سدوا المجازة بيننا","https://www.aldiwan.net/poem50356.html","الطويل"],[42,"أبلغ حصينا إذا جئته","https://www.aldiwan.net/poem50400.html","المتقارب"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"كأن ديار الحي بالزرق خلقة","https://www.aldiwan.net/poem29600.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[23,"أهاجك بالبيداء رسم المنازل","https://www.aldiwan.net/poem21249.html","الطويل"],[51,"جزى القاسم الحسنى محسن وجهه","https://www.aldiwan.net/poem62855.html","الطويل"],[26,"عرفت الديار كرقم الدوا","https://www.aldiwan.net/poem24098.html","المتقارب"],[70,"دعوتك لما أن بدت لي حاجة","https://www.aldiwan.net/poem42733.html","الطويل"],[70,"أأرحل من مصر وطيب نعيمها","https://www.aldiwan.net/poem42799.html","الطويل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[43,"فديناك أهدى الناس سهما إلى قلبي","https://www.aldiwan.net/poem9453.html","الطويل"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[45,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[45,"لو أسعدت سعدى بتنويلها","https://www.aldiwan.net/poem65586.html","السريع"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[45,"أمن بعد وجد الفتح بي وغرامه","https://www.aldiwan.net/poem66788.html","الطويل"],[28,"وكيف بنفس كلما قلت أشرفت","https://www.aldiwan.net/poem5383.html","الطويل"],[80,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[74,"مر بنا وهو بدر تم","https://www.aldiwan.net/poem12858.html","مجزوء البسيط"],[21,"لك الحمد والنعماء والملك ربنا","https://www.aldiwan.net/poem36236.html","الطويل"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[46,"عليكم بإحسانكم إنكم","https://www.aldiwan.net/poem22164.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39549","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[96,"على الصّخرة البيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=13151",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[45,"بوُدّيَ لَوْ يَهْوَى العَذولُ، وَيَعْشَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32173",""],[109,"عذرا لعبدك قد ماتت قرائحه","https://www.aldiwan.net/poem16301.html","البسيط"],[115,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[129,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[133,"أحاطت بغايات العلا والمفاخر","https://www.aldiwan.net/poem4236.html","الطويل"],[150,"حروب النوى والقرب فيك سجال","https://www.aldiwan.net/poem68535.html","الطويل"],[155,"يا من هو الماء في تكوين خلقته","https://www.aldiwan.net/poem55744.html","البسيط"],[160,"يغر بحسن الرأى راج ويخدع","https://www.aldiwan.net/poem58992.html","الطويل"],[160,"هلموا فقد قامت على ساقها الحرب","https://www.aldiwan.net/poem59019.html","الطويل"],[181,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[185,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[186,"يا ليت لي عوضا من نحل بصرتهم","https://www.aldiwan.net/poem43907.html","البسيط"],[186,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[231,"لمن طلل دون الربا والتنائث","https://www.aldiwan.net/poem44596.html","الطويل"],[261,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[261,"تذكرت عقبى كل أمر اصابني","https://www.aldiwan.net/poem38275.html","الطويل"],[262,"لقد خاصمتني دهاة الرجال","https://www.aldiwan.net/poem68184.html","المتقارب"],[270,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[270,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[271,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[275,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[275,"كفاني الحر منتجع الغمام","https://www.aldiwan.net/poem25530.html","الوافر"],[280,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[280,"سقوه كأس فرقتهم دهاقا","https://www.aldiwan.net/poem60789.html","الوافر"],[300,"ومن خطيب إذا ما انساح مسحله","https://www.aldiwan.net/poem45490.html","البسيط"],[305,"إلهي إن قصدي من قصيدي","https://www.aldiwan.net/poem56561.html","الوافر"],[353,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[366,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[366,"رأينا عطاياك الكريمة ما لها","https://www.aldiwan.net/poem17917.html","الطويل"],[403,"أهذا الذي في كأس نظمك قرقف","https://www.aldiwan.net/poem33638.html","الطويل"],[403,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[403,"وحرمة ما بيني وبينك من حب","https://www.aldiwan.net/poem34138.html","الطويل"],[432,"للكاتب الشيخ عين مسها عمش","https://www.aldiwan.net/poem12705.html","البسيط"],[441,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[441,"رأيت الزمان وإخوانه","https://www.aldiwan.net/poem14395.html","المتقارب"],[452,"ألا مرحبا باقتبال الربيع","https://www.aldiwan.net/poem13766.html","المتقارب"],[453,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[464,"حي ظباء بالعقيق غيدا","https://www.aldiwan.net/poem3466.html","عموديه"],[468,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[477,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[505,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"خليفة عيسى في الشفاء من الضر","https://www.aldiwan.net/poem48178.html","عموديه"],[551,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[551,"ألا إن قلبي من بعدكم","https://www.aldiwan.net/poem47260.html","المتقارب"],[551,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[551,"في كل يوم أرى عجيبا","https://www.aldiwan.net/poem48077.html","مخلع البسيط"],[575,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[575,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[575,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[586,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"],[587,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَمُنخَرِقٍ لا يَقطَعُ الطَرفُ عَرضَه","وَلا يَنزَوي عَن أَعيُنِ الرَكبِ خَرمُهُ",0,"م",2,0],["وَمُنخَرِقٍ كَأَنَّ عَلى رُباهُ","مِنَ الظُلمِ الأَكِنَّةِ وَاللِياطا",1,"ط",2,0],["وَمَن خَوَّضَ الدَهرُ مِن مالِهِ","قَوارِحَ أَحداثِهِ وَالمَهارى",2,"ر",2,0],["وَمُنخَرِقٍ أَخوتَ السَيفَ فيهِ","وَحَبلُ اللَيلِ يَندَمِجُ اِندِماجا",3,"ج",2,0],["ومَنْ خافَ أن يَسْتَضْرِعَ الفَقْرُ خَدّهُ","وفَى بالغِنى لي أعْوَجيٌّ ومُنْصُلُ",4,"ل",1,0],["وَمِن خَيرِ ما أَلصَقتَ بِالدارِ حائِطٌ","تَزِلُّ بِهِ سُفعُ الخَطاطِيفِ أَملَسُ",5,"س",1,0],["وَمِن خَيرِ ما يَتعاطى الرِجالُ","نَصيحَةُ ذي الرأيِ لِلمُجتَبيها",6,"ي",3,0],["وَمِن خَلفِهِ ذو قُتَرَةٍ مُتَسَمِّعٌ","طَويلُ الطَوى خِفٌّ بِها مُتعالِمُ",7,"م",1,0],["وَمِن خَصرِهِ كَيفَ اِستَقَلَّ وَقَد غَدَت","تُجاذِبُهُ أَردافُهُ وَالمَناكِبُ",8,"ب",1,0],["وَمِنْ خَطَرَاتِ ذَاكَ الفِكْرِ تَجْرِي","بِهَا الفَطَرَاتُ مِنْ تِلْكَ البَنَانِ",9,"ن",1,0],["وَمُنخَرِقِ السِربالِ أَشعَثَ يَرتَمي","بِهِ الرَحلُ فَوقَ العيسِ وَاللَيلِ دامِسُ",10,"س",1,0],["وَمِن خاضِب كَالبَكرِ أَدلَجَ أَهلُهُ","فَراعَ مِنَ الأَحفاضِ تَحتَ بِجادِ",11,"د",1,0],["وَمُنخَرَق خاوي اَلمَمِّر قَطَعتُهُ","بِمُنعَقِد خَلفَ الشَراسيفِ حالِبُه",12,"ب",2,0],["ومن خاطرات النفس ما لم يقم به","بيان ولم يَنهض بأعبائه الشعر",13,"ر",1,0],["وَمِن خَيرِ حَيٍّ تَعلَمونَ لِسائِلٍ","عَفافاً وَعانٍ موثَقٍ في السَلاسِلِ",14,"ل",1,0],["وَمِن خَيرِ حَيٍّ تَعلَمونَ لِجارِهِم","إِذا اِختارَهُم في الأَمنِ أَو في الزَلازِلِ",14,"ل",1,0],["ومن خِيَرِ الأشياء باقٍ تحوزُهُ","بفانٍ إذا ما اسْتثَبتَ المتبصِّر",15,"ر",1,0],["وَمِن خَيرِ ما عَمِلَ الناشِىءُ ال","مُعَمَّمُ خَيرٌ وَزَندٌ وَرِيُّ",16,"ي",1,0],["وَمِن خُلُقي المَشهورِ مُذ كُنتُ أَنَّني","لِغَيرِ حَبيبٍ قَطُّ لَن أَتَذَلَّلا",17,"ل",2,0],["وَمِن خُلُقي أَنّي أَلوفٌ وَأَنَّهُ","يَطولُ اِلتِفاتي لِلَّذينَ أُفارِقُ",18,"ق",1,0],["وَمَن خَلفَهُ ماضي العَزائِمِ ماجِدٌ","يُبيدُ العِدى مِن سَطوَةٍ وَيُبيرُها",19,"ر",3,0],["وَمَن خُلِقَت عَيناكَ بَينَ جُفونِهِ","أَصابَ الحُدورَ السَهلَ في المُرتَقى الصَعبِ",20,"ب",1,0],["وَمَن خَبَرَ الغَواني فَالغَواني","ضِياءٌ في بَواطِنِهِ ظَلامُ",21,"م",1,0],["وَمِن خِلَعٍ فازَت بِلُبسِكَ فَاغدى","بِها أَرَجٌ مِن طيبِ عَرفِكَ يَعبَقُ",22,"ق",1,0],["وَمِن خُدودٍ مُشبَعٍ صِبغُها","في لَثمِها الفَوزُ وَتَقبيلِها",23,"ل",3,0],["وَمِن خَلفِ بابِ الجِسرِ خَمسُ حَفائِرٍ","ظِماءِ التُرابِ عابِساتِ الجَنادِلِ",24,"ل",1,0],["وَمِن خُلُقٍ يَستَنكِفُ الكَلبُ أَن يُرى","لَهُ جارَ بَيتٍ أَو رَضيعَ لِبانِ",25,"ن",1,0],["وَمِن خَلفِها ثِنتانِ كِلتاهُما لَها","تَعَلَّقَ بِالأَهدامِ وَالشَرُّ حالُها",26,"ل",3,0],["ومن خطِّ رمسٍ دارسٍ فكأنّما","أمرّ البلى محواً عَلَيها الأَصابِعا",27,"ع",2,0],["وَمَن خَدَمَ الأَقوامَ يَرجو نَوالَهُم","فَإِنّي لَم أَخدِمكَ إِلّا لِأُخدَما",28,"م",2,0],["وَمِن خُفوقِ البُروقِ فيها","أَلوِيَةٌ جُمِّرَت خِضابا",29,"ب",2,0],["وَمِن خَوفِ رَبّي سَبَّحَ الرَعدُ فَوقَنا","وَسَبَّحَهُ الأَشجارُ وَالوَحشُ أُبَّدُ",30,"د",1,0],["وَمِن خَلفِهِ صَفراءُ غَرثٌ وِشاحُها","تَأَوَّدُ في المَمشى القَريبِ تَأَوُّدا",31,"د",2,0],["وَمِنخَرٍ كَالكيرِ لَم تَشقَ بِهِ","أَنفاسُهُ وَلَم يَخُنها في تَعَب",32,"ب",1,0],["ومنْ خاضَ الهواجِرَ وَهُوَ ظامٍ","إلَى أَنْ أُوْرَثَ التَّتَرَ المَنُونا",33,"ن",2,0],["ومِنْ خَيْلِهِ تلك الجوافِلُ إنّهَا","إلى الآن لم تُحْطَطْ لهُنّ لُبود",34,"د",1,0],["وَمِن خَيرِ مافَعَلَ الفاعِلونَ","أَنَّهُمُ بِتُقىً أَخبَتوا",35,"ت",3,0],["ومن خَلْفها تبدو النخيلُ كأنها","خيالاتُ حِنٍّ أو ظلالُ مساحرِ",36,"ر",1,0],["ومِن خُطْبَة في كَبّة الصَّكِّ فَيْصَلٍ","حَسَمْتَ بها أَهْواءَهَا ومِراءَهَا",37,"ا",3,0],["وَمِنْ خُلُقِ التُّرْكِ أَنْ يُوْرِدُوا","سُيُوفَهُمُ مُهَجَ الخُرَّدِ",38,"د",1,0],["وَمَن خَذَلتَهُ عبرَةٌ عِندَ عبرَةٍ","فَذاكَ جَمادٌ عُدَّ في الحَيَوانِ",39,"ن",1,0],["ومن خطَبَ المجدَ، شدّ الرِّحال","إليه، وخاضَ الدّمَ الأحمرَا",40,"ر",2,0],["ومن خَلْفها تبدو النخيلُ كأنها","خيالاتُ جِنٍّ أو ظلالُ مساحرِ",41,"ر",1,0],["ومن خُططِ السياسةِ إنْ أرادتْ","فساد المُلك أفسدَتَ الطّباعا",42,"ع",2,0],["وَمِنْ خِلَعٍ فازَتْ بلُبْسِكَ فاغتدى","بها أرَجٌ مِن طيبِ عَرْفِكَ، يَعْبَقُ",43,"ق",1,0],["وَمِن خَليل وَلا برضيهِ غَير دَمي","غَضبان طَرفي عَلى روحي تُصالحهُ",44,"ح",2,0],["ومن خابط يروي علوما مغالطا","عزا هاله عن زيد جاءت وعن عمرو",45,"ر",2,0],["ومن خلفِ هذا الخِضَمِّ البعيدِ","نُحيِّيكِ بالدَمعةِ المُحرِقة",46,"ق",2,0],["ومن خطبةٍ تستنزلُ العصمَ من علٍ","وتقضِي بتكبيلِ النفوسِ النوافر",47,"ر",1,0],["ومن خانَهُ في مقصدِ الخير عقلُهُ","ففي رجله مما جناه عقال",48,"ل",1,0],["وَمَنْ خَلَعْتُ عِذاري في هَوَايَ لَهُ","ومن تَهَتَّكَ سِتْري في مَحَبَّتِهِ",49,"ت",2,0],["ومن خص بالإعراض منهم وجاءه","وعيدك أنسى جفنه كيف يهجع",50,"ع",1,0],["ومن خيله تغشى البلاد ورجله","فليس له نحو العدى غيرها كتب",51,"ب",1,0],["وَمِن خَطَرَاتٍ تَعتَرِينِى وَزَفرَةٍ","لَها بَينَ لَحمِى وَالعِظَامِ دَبِيبُ",52,"ب",1,0],["ومن خامرَتْ خمر الهوى كأس لُبِّه","فإنّ نجومَ الشيبِ بعضُ حَبابه",53,"ب",2,0],["ومن خباء ومن رمح ومن فرس","في مرسه وتد في البيت موتود",54,"د",1,0],["ومن خاف أعاديه","بنافي الخوف يستعدي",55,"د",2,0],["ومنخرق السربال يخترق الفلا","ويقدم أقدام الشجاع الدلاهث",56,"ث",1,0],["ومن خطل الأيام اخطلها ومن","جرائرها في القوم عد جريرها",57,"ر",3,0],["ومن خطل بالرأي ثقفني النهى","وزجر النهى هاد لمن ضل واقترى",58,"ر",2,0],["ومن خِفتُ جَورِهِ في القَضَاءِ","فَلَستُ أخَافُكَ يَا عَافِيَه",59,"ف",3,0],["ومن خلفائي للأساطيل نجدةٌ","لغزوِ بلادٍ أو لفتحِ جزيرة",60,"ه",1,0],["ومن خدٍّ مجوسيٍّ وصدرٍ","يهوديٍّ لموسى كان طُورا",61,"ر",2,0],["ومن خلفهم بأس شَديد وَنجدة","وَرأى يَراه السمهري المزجج",62,"ج",1,0],["وَمنْ خُبْثِهِ يَوْمَ الهياجِ سَليقَةً","تَسَلُّقُهُ مِنْ بَيْنِ آسَادِهِ سَلْقَا",63,"ق",2,0],["وَمَنْ خَدَمَ الخَلِيفَةَ فالليالي","خَوادِمُهُ إلى غَيْرِ انْصِرامِ",64,"م",1,0],["وَمِنْ خِرافٍ لَهُمُ مِنْها الَّذِي","طابَ وَلِيَ ما ضُمِّنَتْ كُرُوشُها",65,"ش",3,0],["وَمَنْ خَطَبَ الْمَعالِيَ بِالْعوَالِي","وَبِالْجَدْوى فَقدْ أَرْبى الصِّدَاقا",66,"ق",2,0],["وَمِن خَطيبٍ إِذا ما اِنساحَ مِسحَلُهُ","مُفَرِّجِ القَولِ مَيسوراً وَمَعسورا",67,"ر",2,1],["وَمَن خصّصتهُ منهم بذكرٍ","فَعَن ودّ لِنَجلهم الودودِ",68,"د",1,0],["وَمِن خَفرٍ لَما زَها وَرد خَدّه","تَولّى عَلَيهِ قيّم القَدِّ يَخفرُ",69,"ر",1,0],["وَمَن خَطَبَ الحَسناءَ مُرخِصَ مَهرِها","فَإِنَّكَ أَنصَفتَ المَكارِمَ في المَهرِ",70,"ر",1,0],["وَمِن خَلفِ تِلكَ الحُجبِ نورُ بِشاشَةٍ","وَقَد آنَسَت عَيني على نورِها الهُدى",71,"د",2,0],["ومن خرف قد خاض في غير بحركم","خشى غرقاً إن خاضه وهو مدنف",72,"ف",1,0],["ومن خفتم من شره وفساده","كردمان وابن الحاج أهل العشائر",73,"ر",1,0],["ومن خلق خير الرسل غفرانه لمن","أتى مذنباً فاغفر فإنِّيَ ذو ذنب",74,"ب",1,0],["ومنخَرٌ يجذبُ الأنفاسَ منه كما","طُجاذبُ الساقَ كعباً ضمّه الوحْلُ",75,"ل",1,0],["ومن خروص إذا أنسبتني نسبي","وأنت حسبي ومولاي ومنتخبي",76,"ي",1,0],["ومن خالط الناس في شأنهم","رأى منهم كل ما شانه",77,"ن",2,0],["ومن خطه زهره المجتلى","يرف بحافات أنهارهِ",78,"ر",2,0],["ومن خطراتِ النور تُضفى حَنانَها","فيلثمها في بِرَّها التربُ والحجر",79,"ر",1,0],["ومن خصور سقمي من سقمها","ومن غصونِ أطلعتْ نهودا",80,"د",2,0],["وَمَن خَبَأتُ العَفوَ مِنهُ لِما","يَغشاهُ مِن زَلّاتِنا مُحصِبُ",81,"ب",1,0],["ومُنْخَرَقٍ تبقى الرَّكابُ بعَرضِه","مطلَّحةً مما تَمُدُّ مجاهلُه",82,"ل",2,0],["ومن خبزِها ائتني ولو بقليلِ","ومن مائِها ولو بكفّكِ كيلي",83,"ي",1,0],["ومنْ خُمْسٍ علىْ ورقٍ وعُشرٍ","على الأرْضِ تلقّطُهُ النّواقرْ",84,"ر",1,0],["ومَنْ خَفِيَت عَلَيْهِ الشَّمْسُ يَوْماً","فكَيْفَ تَراهُ يَظْفَرُ بالسُّهاءِ",85,"ا",2,0],["ومَن خُلقهُ يَشفيكَ قبلَ عِلاجِهِ","وذلكَ إذ يَلقاكَ وجهُه بالبِشرِ",86,"ر",1,0],["ومَن خضعتْ لغُرّتِهِ النّواصي","وقِيدَتْ في أزمّتِهِ القُرومُ",87,"م",1,0],["ومن خُدَعٍ لبُدور النُّضار","وهبن المذلّةَ للسّائلِ",88,"ل",1,0],["ومن خصامِ النائباتِ اللُّدِّ","قد زارك الحولُ بكلِّ سَعدِ",89,"د",1,0],["وَمِن خطوبٍ يَزرنَ قَلبي","شِبتُ وَما آنَ أَن أَشيبا",90,"ب",2,0],["ومن خدها يحمَرُّ ياقوتُ عِقْدِها","ويصفَرُّ إِمَّا خَجْلةً أَو تَهيُّبا",91,"ب",2,0],["ومِنْ خَمرِه أَو فَمِن ثَغْرِه","يقال لناظِره بابلُ",92,"ل",1,0],["ومن خوفه الشَّمسُ المنيرةُ في الضُّحى","تموتُ وفي نَقْع الحوافِر تُرمَسُ",93,"س",1,0],["وَمِنْ خدودٍ بالوردِ يانعةً","إن لاحَ جَانِيهِ حَالَ جَانيها",94,"ي",3,0],["ومن خاف من عيد كذاك وجمعة","فواتاً وليس الماء يوماً بحاصل",95,"ل",1,0]]}