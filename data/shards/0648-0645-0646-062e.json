m/117315","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66190","الطويل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107129","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4699,"ويبقى الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193392",""],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4755,"لِأَنَّ هذا الحُزنَ بِي لائِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=200623",""],[4767,"يوم العسكري","https://www.poetsgate.com/ViewPoem.aspx?id=197293",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4884,"أرى الظّلمَ كالدّجّالِ أعورَ","https://www.poetsgate.com/ViewPoem.aspx?id=201727",""],[4888,"جنات الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=207675",""],[4962,"سطور في حواء","https://www.poetsgate.com/ViewPoem.aspx?id=201627",""],[5005,"قفا نبكِ..","https://www.poetsgate.com/ViewPoem.aspx?id=189391",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5145,"ترى الجيرة قد جاروا","https://www.poetsgate.com/ViewPoem.aspx?id=108119",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5355,"حقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=203962",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5411,"دروب السالكين","https://www.poetsgate.com/ViewPoem.aspx?id=187258",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5458,"الحج غدفة","https://www.poetsgate.com/ViewPoem.aspx?id=72397",""],[5459,"أراك تَحنّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=203153",""],[5459,"نصر وخُسر","https://www.poetsgate.com/ViewPoem.aspx?id=214873",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5538,"ومن خوفي عليك أتيت ليلاً","https://www.poetsgate.com/ViewPoem.aspx?id=142623",""],[5564,"ياللْه يا كافي الأمور الشدايد","https://www.poetsgate.com/ViewPoem.aspx?id=186845",""],[5638,"طريق العلم","https://www.poetsgate.com/ViewPoem.aspx?id=198010",""],[5725,"على استحياء","https://www.poetsgate.com/ViewPoem.aspx?id=180382",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[5943,"كليني ياهموم فلن أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=34857",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[6019,"خذيني","https://www.poetsgate.com/ViewPoem.aspx?id=61401",""],[6125,"جُنَاةُ الأمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=210567",""],[6125,"فمن عينيكِ ألتمسُ المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=210908",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""]],"verses":[["وَمُنخَرِقٍ لا يَقطَعُ الطَرفُ عَرضَه","وَلا يَنزَوي عَن أَعيُنِ الرَكبِ خَرمُهُ",0,"م",2,0],["وَمُنخَرِقٍ كَأَنَّ عَلى رُباهُ","مِنَ الظُلمِ الأَكِنَّةِ وَاللِياطا",1,"ط",2,0],["وَمَن خَوَّضَ الدَهرُ مِن مالِهِ","قَوارِحَ أَحداثِهِ وَالمَهارى",2,"ر",2,0],["وَمُنخَرِقٍ أَخوتَ السَيفَ فيهِ","وَحَبلُ اللَيلِ يَندَمِجُ اِندِماجا",3,"ج",2,0],["ومَنْ خافَ أن يَسْتَضْرِعَ الفَقْرُ خَدّهُ","وفَى بالغِنى لي أعْوَجيٌّ ومُنْصُلُ",4,"ل",1,0],["وَمِن خَيرِ ما أَلصَقتَ بِالدارِ حائِطٌ","تَزِلُّ بِهِ سُفعُ الخَطاطِيفِ أَملَسُ",5,"س",1,0],["وَمِن خَيرِ ما يَتعاطى الرِجالُ","نَصيحَةُ ذي الرأيِ لِلمُجتَبيها",6,"ي",3,0],["وَمِن خَلفِهِ ذو قُتَرَةٍ مُتَسَمِّعٌ","طَويلُ الطَوى خِفٌّ بِها مُتعالِمُ",7,"م",1,0],["وَمِن خَصرِهِ كَيفَ اِستَقَلَّ وَقَد غَدَت","تُجاذِبُهُ أَردافُهُ وَالمَناكِبُ",8,"ب",1,0],["وَمِنْ خَطَرَاتِ ذَاكَ الفِكْرِ تَجْرِي","بِهَا الفَطَرَاتُ مِنْ تِلْكَ البَنَانِ",9,"ن",1,0],["وَمُنخَرِقِ السِربالِ أَشعَثَ يَرتَمي","بِهِ الرَحلُ فَوقَ العيسِ وَاللَيلِ دامِسُ",10,"س",1,0],["وَمِن خاضِب كَالبَكرِ أَدلَجَ أَهلُهُ","فَراعَ مِنَ الأَحفاضِ تَحتَ بِجادِ",11,"د",1,0],["وَمُنخَرَق خاوي اَلمَمِّر قَطَعتُهُ","بِمُنعَقِد خَلفَ الشَراسيفِ حالِبُه",12,"ب",2,0],["ومن خاطرات النفس ما لم يقم به","بيان ولم يَنهض بأعبائه الشعر",13,"ر",1,0],["وَمِن خَيرِ حَيٍّ تَعلَمونَ لِسائِلٍ","عَفافاً وَعانٍ موثَقٍ في السَلاسِلِ",14,"ل",1,0],["وَمِن خَيرِ حَيٍّ تَعلَمونَ لِجارِهِم","إِذا اِختارَهُم في الأَمنِ أَو في الزَلازِلِ",14,"ل",1,0],["ومن خِيَرِ الأشياء باقٍ تحوزُهُ","بفانٍ إذا ما اسْتثَبتَ المتبصِّر",15,"ر",1,0],["وَمِن خَيرِ ما عَمِلَ الناشِىءُ ال","مُعَمَّمُ خَيرٌ وَزَندٌ وَرِيُّ",16,"ي",1,0],["وَمِن خُلُقي المَشهورِ مُذ كُنتُ أَنَّني","لِغَيرِ حَبيبٍ قَطُّ لَن أَتَذَلَّلا",17,"ل",2,0],["وَمِن خُلُقي أَنّي أَلوفٌ وَأَنَّهُ","يَطولُ اِلتِفاتي لِلَّذينَ أُفارِقُ",18,"ق",1,0],["وَمَن خَلفَهُ ماضي العَزائِمِ ماجِدٌ","يُبيدُ العِدى مِن سَطوَةٍ وَيُبيرُها",19,"ر",3,0],["وَمَن خُلِقَت عَيناكَ بَينَ جُفونِهِ","أَصابَ الحُدورَ السَهلَ في المُرتَقى الصَعبِ",20,"ب",1,0],["وَمَن خَبَرَ الغَواني فَالغَواني","ضِياءٌ في بَواطِنِهِ ظَلامُ",21,"م",1,0],["وَمِن خِلَعٍ فازَت بِلُبسِكَ فَاغدى","بِها أَرَجٌ مِن طيبِ عَرفِكَ يَعبَقُ",22,"ق",1,0],["وَمِن خُدودٍ مُشبَعٍ صِبغُها","في لَثمِها الفَوزُ وَتَقبيلِها",23,"ل",3,0],["وَمِن خَلفِ بابِ الجِسرِ خَمسُ حَفائِرٍ","ظِماءِ التُرابِ عابِساتِ الجَنادِلِ",24,"ل",1,0],["وَمِن خُلُقٍ يَستَنكِفُ الكَلبُ أَن يُرى","لَهُ جارَ بَيتٍ أَو رَضيعَ لِبانِ",25,"ن",1,0],["وَمِن خَلفِها ثِنتانِ كِلتاهُما لَها","تَعَلَّقَ بِالأَهدامِ وَالشَرُّ حالُها",26,"ل",3,0],["ومن خطِّ رمسٍ دارسٍ فكأنّما","أمرّ البلى محواً عَلَيها الأَصابِعا",27,"ع",2,0],["وَمَن خَدَمَ الأَقوامَ يَرجو نَوالَهُم","فَإِنّي لَم أَخدِمكَ إِلّا لِأُخدَما",28,"م",2,0],["وَمِن خُفوقِ البُروقِ فيها","أَلوِيَةٌ جُمِّرَت خِضابا",29,"ب",2,0],["وَمِن خَوفِ رَبّي سَبَّحَ الرَعدُ فَوقَنا","وَسَبَّحَهُ الأَشجارُ وَالوَحشُ أُبَّدُ",30,"د",1,0],["وَمِن خَلفِهِ صَفراءُ غَرثٌ وِشاحُها","تَأَوَّدُ في المَمشى القَريبِ تَأَوُّدا",31,"د",2,0],["وَمِنخَرٍ كَالكيرِ لَم تَشقَ بِهِ","أَنفاسُهُ وَلَم يَخُنها في تَعَب",32,"ب",1,0],["ومنْ خاضَ الهواجِرَ وَهُوَ ظامٍ","إلَى أَنْ أُوْرَثَ التَّتَرَ المَنُونا",33,"ن",2,0],["ومِنْ خَيْلِهِ تلك الجوافِلُ إنّهَا","إلى الآن لم تُحْطَطْ لهُنّ لُبود",34,"د",1,0],["وَمِن خَيرِ مافَعَلَ الفاعِلونَ","أَنَّهُمُ بِتُقىً أَخبَتوا",35,"ت",3,0],["ومن خَلْفها تبدو النخيلُ كأنها","خيالاتُ حِنٍّ أو ظلالُ مساحرِ",36,"ر",1,0],["ومِن خُطْبَة في كَبّة الصَّكِّ فَيْصَلٍ","حَسَمْتَ بها أَهْواءَهَا ومِراءَهَا",37,"ا",3,0],["وَمِنْ خُلُقِ التُّرْكِ أَنْ يُوْرِدُوا","سُيُوفَهُمُ مُهَجَ الخُرَّدِ",38,"د",1,0],["وَمَن خَذَلتَهُ عبرَةٌ عِندَ عبرَةٍ","فَذاكَ جَمادٌ عُدَّ في الحَيَوانِ",39,"ن",1,0],["ومن خطَبَ المجدَ، شدّ الرِّحال","إليه، وخاضَ الدّمَ الأحمرَا",40,"ر",2,0],["ومن خَلْفها تبدو النخيلُ كأنها","خيالاتُ جِنٍّ أو ظلالُ مساحرِ",41,"ر",1,0],["ومن خُططِ السياسةِ إنْ أرادتْ","فساد المُلك أفسدَتَ الطّباعا",42,"ع",2,0],["وَمِنْ خِلَعٍ فازَتْ بلُبْسِكَ فاغتدى","بها أرَجٌ مِن طيبِ عَرْفِكَ، يَعْبَقُ",43,"ق",1,0],["وَمِن خَليل وَلا برضيهِ غَير دَمي","غَضبان طَرفي عَلى روحي تُصالحهُ",44,"ح",2,0],["ومن خابط يروي علوما مغالطا","عزا هاله عن زيد جاءت وعن عمرو",45,"ر",2,0],["ومن خلفِ هذا الخِضَمِّ البعيدِ","نُحيِّيكِ بالدَمعةِ المُحرِقة",46,"ق",2,0],["ومن خطبةٍ تستنزلُ العصمَ من علٍ","وتقضِي بتكبيلِ النفوسِ النوافر",47,"ر",1,0],["ومن خانَهُ في مقصدِ الخير عقلُهُ","ففي رجله مما جناه عقال",48,"ل",1,0],["وَمَنْ خَلَعْتُ عِذاري في هَوَايَ لَهُ","ومن تَهَتَّكَ سِتْري في مَحَبَّتِهِ",49,"ت",2,0],["ومن خص بالإعراض منهم وجاءه","وعيدك أنسى جفنه كيف يهجع",50,"ع",1,0],["ومن خيله تغشى البلاد ورجله","فليس له نحو العدى غيرها كتب",51,"ب",1,0],["وَمِن خَطَرَاتٍ تَعتَرِينِى وَزَفرَةٍ","لَها بَينَ لَحمِى وَالعِظَامِ دَبِيبُ",52,"ب",1,0],["ومن خامرَتْ خمر الهوى كأس لُبِّه","فإنّ نجومَ الشيبِ بعضُ حَبابه",53,"ب",2,0],["ومن خباء ومن رمح ومن فرس","في مرسه وتد في البيت موتود",54,"د",1,0],["ومن خاف أعاديه","بنافي الخوف يستعدي",55,"د",2,0],["ومنخرق السربال يخترق الفلا","ويقدم أقدام الشجاع الدلاهث",56,"ث",1,0],["ومن خطل الأيام اخطلها ومن","جرائرها في القوم عد جريرها",57,"ر",3,0],["ومن خطل بالرأي ثقفني النهى","وزجر النهى هاد لمن ضل واقترى",58,"ر",2,0],["ومن خِفتُ جَورِهِ في القَضَاءِ","فَلَستُ أخَافُكَ يَا ع