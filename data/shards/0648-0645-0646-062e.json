{"poems":[[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[42,"لنا جيرة سدوا المجازة بيننا","https://www.aldiwan.net/poem50356.html","الطويل"],[42,"أبلغ حصينا إذا جئته","https://www.aldiwan.net/poem50400.html","المتقارب"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"كأن ديار الحي بالزرق خلقة","https://www.aldiwan.net/poem29600.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[23,"أهاجك بالبيداء رسم المنازل","https://www.aldiwan.net/poem21249.html","الطويل"],[51,"جزى القاسم الحسنى محسن وجهه","https://www.aldiwan.net/poem62855.html","الطويل"],[26,"عرفت الديار كرقم الدوا","https://www.aldiwan.net/poem24098.html","المتقارب"],[70,"دعوتك لما أن بدت لي حاجة","https://www.aldiwan.net/poem42733.html","الطويل"],[70,"أأرحل من مصر وطيب نعيمها","https://www.aldiwan.net/poem42799.html","الطويل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[43,"فديناك أهدى الناس سهما إلى قلبي","https://www.aldiwan.net/poem9453.html","الطويل"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[45,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[45,"لو أسعدت سعدى بتنويلها","https://www.aldiwan.net/poem65586.html","السريع"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[45,"أمن بعد وجد الفتح بي وغرامه","https://www.aldiwan.net/poem66788.html","الطويل"],[28,"وكيف بنفس كلما قلت أشرفت","https://www.aldiwan.net/poem5383.html","الطويل"],[80,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[74,"مر بنا وهو بدر تم","https://www.aldiwan.net/poem12858.html","مجزوء البسيط"],[21,"لك الحمد والنعماء والملك ربنا","https://www.aldiwan.net/poem36236.html","الطويل"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[46,"عليكم بإحسانكم إنكم","https://www.aldiwan.net/poem22164.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39549","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[45,"بوُدّيَ لَوْ يَهْوَى العَذولُ، وَيَعْشَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32173",""]],"verses":[["وَمُنخَرِقٍ لا يَقطَعُ الطَرفُ عَرضَه","وَلا يَنزَوي عَن أَعيُنِ الرَكبِ خَرمُهُ",0,"م",2,0],["وَمُنخَرِقٍ كَأَنَّ عَلى رُباهُ","مِنَ الظُلمِ الأَكِنَّةِ وَاللِياطا",1,"ط",2,0],["وَمَن خَوَّضَ الدَهرُ مِن مالِهِ","قَوارِحَ أَحداثِهِ وَالمَهارى",2,"ر",2,0],["وَمُنخَرِقٍ أَخوتَ السَيفَ فيهِ","وَحَبلُ اللَيلِ يَندَمِجُ اِندِماجا",3,"ج",2,0],["ومَنْ خافَ أن يَسْتَضْرِعَ الفَقْرُ خَدّهُ","وفَى بالغِنى لي أعْوَجيٌّ ومُنْصُلُ",4,"ل",1,0],["وَمِن خَيرِ ما أَلصَقتَ بِالدارِ حائِطٌ","تَزِلُّ بِهِ سُفعُ الخَطاطِيفِ أَملَسُ",5,"س",1,0],["وَمِن خَيرِ ما يَتعاطى الرِجالُ","نَصيحَةُ ذي الرأيِ لِلمُجتَبيها",6,"ي",3,0],["وَمِن خَلفِهِ ذو قُتَرَةٍ مُتَسَمِّعٌ","طَويلُ الطَوى خِفٌّ بِها مُتعالِمُ",7,"م",1,0],["وَمِن خَصرِهِ كَيفَ اِستَقَلَّ وَقَد غَدَت","تُجاذِبُهُ أَردافُهُ وَالمَناكِبُ",8,"ب",1,0],["وَمِنْ خَطَرَاتِ ذَاكَ الفِكْرِ تَجْرِي","بِهَا الفَطَرَاتُ مِنْ تِلْكَ البَنَانِ",9,"ن",1,0],["وَمُنخَرِقِ السِربالِ أَشعَثَ يَرتَمي","بِهِ الرَحلُ فَوقَ العيسِ وَاللَيلِ دامِسُ",10,"س",1,0],["وَمِن خاضِب كَالبَكرِ أَدلَجَ أَهلُهُ","فَراعَ مِنَ الأَحفاضِ تَحتَ بِجادِ",11,"د",1,0],["وَمُنخَرَق خاوي اَلمَمِّر قَطَعتُهُ","بِمُنعَقِد خَلفَ الشَراسيفِ حالِبُه",12,"ب",2,0],["ومن خاطرات النفس ما لم يقم به","بيان ولم يَنهض بأعبائه الشعر",13,"ر",1,0],["وَمِن خَيرِ حَيٍّ تَعلَمونَ لِسائِلٍ","عَفافاً وَعانٍ موثَقٍ في السَلاسِلِ",14,"ل",1,0],["وَمِن خَيرِ حَيٍّ تَعلَمونَ لِجارِهِم","إِذا اِختارَهُم في الأَمنِ أَو في الزَلازِلِ",14,"ل",1,0],["ومن خِيَرِ الأشياء باقٍ تحوزُهُ","بفانٍ إذا ما اسْتثَبتَ المتبصِّر",15,"ر",1,0],["وَمِن خَيرِ ما عَمِلَ الناشِىءُ ال","مُعَمَّمُ خَيرٌ وَزَندٌ وَرِيُّ",16,"ي",1,0],["وَمِن خُلُقي المَشهورِ مُذ كُنتُ أَنَّني","لِغَيرِ حَبيبٍ قَطُّ لَن أَتَذَلَّلا",17,"ل",2,0],["وَمِن خُلُقي أَنّي أَلوفٌ وَأَنَّهُ","يَطولُ اِلتِفاتي لِلَّذينَ أُفارِقُ",18,"ق",1,0],["وَمَن خَلفَهُ ماضي العَزائِمِ ماجِدٌ","يُبيدُ العِدى مِن سَطوَةٍ وَيُبيرُها",19,"ر",3,0],["وَمَن خُلِقَت عَيناكَ بَينَ جُفونِهِ","أَصابَ الحُدورَ السَهلَ في المُرتَقى الصَعبِ",20,"ب",1,0],["وَمَن خَبَرَ الغَواني فَالغَواني","ضِياءٌ في بَواطِنِهِ ظَلامُ",21,"م",1,0],["وَمِن خِلَعٍ فازَت بِلُبسِكَ فَاغدى","بِها أَرَجٌ مِن طيبِ عَرفِكَ يَعبَقُ",22,"ق",1,0],["وَمِن خُدودٍ مُشبَعٍ صِبغُها","في لَثمِها الفَوزُ وَتَقبيلِها",23,"ل",3,0],["وَمِن خَلفِ بابِ الجِسرِ خَمسُ حَفائِرٍ","ظِماءِ التُرابِ عابِساتِ الجَنادِلِ",24,"ل",1,0],["وَمِن خُلُقٍ يَستَنكِفُ الكَلبُ أَن يُرى","لَهُ جارَ بَيتٍ أَو رَضيعَ لِبانِ",25,"ن",1,0],["وَمِن خَلفِها ثِنتانِ كِلتاهُما لَها","تَعَلَّقَ بِالأَهدامِ وَالشَرُّ حالُها",26,"ل",3,0],["ومن خطِّ رمسٍ دارسٍ فكأنّما","أمرّ البلى محواً عَلَيها الأَصابِعا",27,"ع",2,0],["وَمَن خَدَمَ الأَقوامَ يَرجو نَوالَهُم","فَإِنّي لَم أَخدِمكَ إِلّا لِأُخدَما",28,"م",2,0],["وَمِن خُفوقِ البُروقِ فيها","أَلوِيَةٌ جُمِّرَت خِضابا",29,"ب",2,0],["وَمِن خَوفِ رَبّي سَبَّحَ الرَعدُ فَوقَنا","وَسَبَّحَهُ الأَشجارُ وَالوَحشُ أُبَّدُ",30,"د",1,0],["وَمِن خَلفِهِ صَفراءُ غَرثٌ وِشاحُها","تَأَوَّدُ في المَمشى القَريبِ تَأَوُّدا",31,"د",2,0],["وَمِنخَرٍ كَالكيرِ لَم تَشقَ بِهِ","أَنفاسُهُ وَلَم يَخُنها في تَعَب",32,"ب",1,0],["ومنْ خاضَ الهواجِرَ وَهُوَ ظامٍ","إلَى أَنْ أُوْرَثَ التَّتَرَ المَنُونا",33,"ن",2,0],["ومِنْ خَيْلِهِ تلك الجوافِلُ إنّهَا","إلى الآن لم تُحْطَطْ لهُنّ لُبود",34,"د",1,0],["وَمِن خَيرِ مافَعَلَ الفاعِلونَ","أَنَّهُمُ بِتُقىً أَخبَتوا",35,"ت",3,0],["ومن خَلْفها تبدو النخيلُ كأنها","خيالاتُ حِنٍّ أو ظلالُ مساحرِ",36,"ر",1,0],["ومِن خُطْبَة في كَبّة الصَّكِّ فَيْصَلٍ","حَسَمْتَ بها أَهْواءَهَا ومِراءَهَا",37,"ا",3,0],["وَمِنْ خُلُقِ التُّرْكِ أَنْ يُوْرِدُوا","سُيُوفَهُمُ مُهَجَ الخُرَّدِ",38,"د",1,0],["وَمَن خَذَلتَهُ عبرَةٌ عِندَ عبرَةٍ","فَذاكَ جَمادٌ عُدَّ في الحَيَوانِ",39,"ن",1,0],["ومن خطَبَ المجدَ، شدّ الرِّحال","إليه، وخاضَ الدّمَ الأحمرَا",40,"ر",2,0],["ومن خُططِ السياسةِ إنْ أرادتْ","فساد المُلك أفسدَتَ الطّباعا",41,"ع",2,0],["وَمِنْ خِلَعٍ فازَتْ بلُبْسِكَ فاغتدى","بها أرَجٌ مِن طيبِ عَرْفِكَ، يَعْبَقُ",42,"ق",1,0]]}