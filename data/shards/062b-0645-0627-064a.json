{"poems":[[54,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[133,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[333,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[563,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127398","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139985","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111517","الرجز"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31277","الخفيف"],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""]],"verses":[["ثُمَّ إِيّايَ وَأُخرى مِثلَها","تَكحَلُ العَينَ بِمَملولِ السُهادِ",0,"د",1,0],["ثم أيقظني فإِن لم","أَصحُ من سُكرِ الغُرور",1,"ر",1,0],["ثمّ أيقَظتهِ على فجرِ دنيا","كِ فسمّاكِ جنّة الشعراء",2,"ا",2,0],["ثم إيمان من يقلد حقٌّ","منه تبدو الأعمال والتوحيد",3,"د",1,0],["ثم أيدٍ وأجُلٌ وجلودٌ","تنطِقُ الحقَّ أنهم شهداء",4,"ا",2,0],["ثم أيها الليث فالأشبال ساهرة","على حماها فلا سهو ولا ضجر",5,"ر",1,0],["ثمائن درِّ الدمع أثمان حبّه","فأجنى الأماني من رياض أثائث",6,"ث",1,0],["ثم أياس الكبر المغوار","والقرم إفيوس وصفا داروا",7,"ر",3,0],["ثُمَ أَيقنَت مُؤمِناً ثُم ما أَد","ري وَكَم ذا لَدَيك مِن لِأواء",8,"ا",2,0],["ثَمَّ أَيدٍ لَهُ طُوالٍ إِذا ما","خَطَرَت بِالرِماحِ مِثلَ الرِماحِ",9,"ح",1,0],["ثم ائت بطحاء الحطي","م وحيّ زمزم والمقاما",10,"م",2,0],["ثم ائت أكاف البقي","ع وحتى أصداءً وهاما",10,"م",2,0]]}