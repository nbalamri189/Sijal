{"poems":[[33,"حي طيفا من الأحبة زارا","https://www.aldiwan.net/poem42489.html","الخفيف"],[54,"يا رب قد أبلاني","https://www.aldiwan.net/poem26628.html","المجتث"],[203,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[287,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[567,"في ساحة الحي من تيماء غزلان","https://www.aldiwan.net/poem52848.html","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64552","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35803","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79841","الرمل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120748","الكامل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135789","الرجز"],[5186,"الماء لج بسطحه المتمدد","https://www.poetsgate.com/ViewPoem.aspx?id=156432",""],[5198,"شمع وشمعدان","https://www.poetsgate.com/ViewPoem.aspx?id=135070",""],[5282,"ضاد النور... خالدة السطور","https://www.poetsgate.com/ViewPoem.aspx?id=214176",""],[5294,"متتاليات الفوضى","https://www.poetsgate.com/ViewPoem.aspx?id=98132",""],[5431,"لم يبقِ دمعا مُحزِنا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198188",""]],"verses":[["حَيِّ طَيفاً مِنَ الأَحِبَّةِ زارا","بَعدَما صَرَّعَ الكَرى السُمّارا",0,"ر",2,1],["حيطانُهُ مِن نورٍ","وَالسَقفُ مِن نيرانِ",1,"ن",1,0],["حَيٌّ طريحٌ يراهم يُلحِدونَ لهُ","لم يستحقوا أَن تراهم منهُ عينانِ",2,"ن",1,0],["حيطانُها الذَهَبُ السَبيكُ وَماؤُها","ذَوبُ اللُجَينِ لِمَن أَرادَ وُرودا",3,"د",2,0],["حيٌّ طَرَقناهُ والنِيرانُ ساطعةٌ","فيهِ وللشوقِ في الأكبادِ نيرانُ",4,"ن",1,0],["حيطة العلم بي مناب سؤالي","وسؤالي فقري وذل محلي",5,"ل",2,0],["حَيِّ طَيفاً أَتاكَ بَعد المَنامِ","يَتَخَطّى إِلَيكَ هَولَ الظَلامِ",6,"م",1,1],["حيّ طيفاً زارَ من سعدي لِماما","لم يزوّد صبّها إلاَّ غراما",7,"م",2,1],["حِيطَانُهَا فيها رَقُومٌ أعجَزَت","أمَدَ البليغ فَحُسنُهَا لا يُوصَفُ",8,"ف",1,0],["حيطة الأصل نكتة الإيجاد","سر باب الرجا لكل نبي",9,"ي",1,0],["حيطاً لنا تكون بالتمامِ","ربِّ بذي الجلالِ والإكرامِ",10,"م",1,0],["حيطان جامعهم وسقف كنيستهم","ومدى كنيستهم موحد معبد",11,"د",1,0],["حي طيفك صان ودّي واحترف","الوفا رغم ان راع الطيف خان",12,"ن",1,0],["حِيطانُ عَنْتَرَ والخَليلِ تَرى لَهَا","نَخْلاً لنُورِ الشَمسِ تَنْظُرُ باسِقاتْ",13,"ت",1,0],["حيطان الجرن متاكلا","والناس لساها متاكله",14,"ه",1,0],["حيطانه من رعشة","وعلى السحائب سقفنا",15,"ن",2,0]]}