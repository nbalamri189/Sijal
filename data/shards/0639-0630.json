ewPoem.aspx?id=34171",""],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[77,"إن كنت تنكر ما تكن ضلوعي","https://www.poetsgate.com/ViewPoem.aspx?id=34176",""],[50,"طربتَ إلى \"حوضى \" وأنت طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16891",""],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[45,"يا يَوْمُ عَرّجْ بَلْ وَرَاءَكَ يا غَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31631",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[46,"سرَيْنا، وطالبنا هاجعٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=16598",""],[28,"ألَمْ يَأتِ بالشّأمِ الخَليفَةَ أنّنَا","https://www.poetsgate.com/ViewPoem.aspx?id=16947",""],[88,"قسَماً بالإله عزَّ وجلاَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19555&r=&rc=58",""],[96,"على صخور المكس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66372&r=&rc=48",""]],"verses":[["عَذارى بَغَت فيكُم بَغاءَ نِسائِكُم","وَقَد كُنَّ عِندي في ثِيابِ الحَواضِنِ",0,"ن",1,0],["عَذيرِيَ مِمَّن ذَمَّ عَهدي وَقَد نَبا","مِراراً وَقَلبي وادِعٌ لا يَذُمُّهُ",1,"م",2,0],["عَذولِيَ مَن أَوطا قَرا العَجزِ مَركَباً","وَلَكِنَّ ظَهرَ العَزمِ غَيرُ ذَلولِ",2,"ل",1,0],["عَذَّبتَ قَلبي عَنَتاً","وَالطَرفُ لا القَلبُ بَدا",3,"د",2,0],["عَذيرِيَ مِن سَيفٍ رَجَوتُ قِراعَهُ","أَعادِيَّ طُرّاً مِن قَديمٍ وَحادِثِ",4,"ث",1,0],["عَذيري مِنَ العِشرينَ يَغمِزنَ صَعدَتي","وَمِن نُوَبِ الأَيّامِ يَقرَعنَ مَروتي",5,"ي",1,1],["عَذَرتُكَ أَنتَ أَردى الناسِ أَصلاً","وَأَخبَثُ مَنصِباً وَأَذَلُّ جَنبا",6,"ب",2,0],["عَذَلتُ هُذَيماً حينَ صَدَّ عَنِ الحِمى","بِأَيدي المَطايا مُسرِعاً غَيرَ لابِثِ",7,"ث",1,1],["عَذَرتُ الذُّرا لَو خاطَرَتْني قُرومُها","فَما بالُ أَكَّاريِهِ فُدْع القوائِمِ",8,"م",1,1],["عَذَّبتَ بِالجَفوَةِ قَلبي فَلَو","تَكَلَّمَ القَلبُ بِشَيءٍ شَكاك",9,"ك",1,0],["عَذَّبتُمُ جَسَدي بِحُ","بِّكُمُ فَلَو يَسطيعُ يَنطِق",10,"ق",1,0],["عَذابُ هاروتَ في الدُنيا وَصاحِبِهِ","أَلَذُّ مِن حُبِّ بَعضِ الناسِ لِلناسِ",11,"س",1,0],["عَذَّبتِ قَلبي بِالعِتابِ فَكُلَّما","فَنِيَ العِتابُ بَدَأتِهِ بِعِتابِ",12,"ب",1,1],["عذَّبْتَني وأبَحْتَ جِسْمي للضّنَى","ومَنَعْتَني ما ليْسَ بالمَمْنوعِ",13,"ع",1,0],["عَذّبْ بِمَا تَرْضَى وَمَا تَخْتَارُه","قَلْبِي بِغَيْرِ الصَّد وَالإِعْرَاضِ",14,"ض",1,0],["عِذَارُهُ الْمِسْكِيُّ فِي خَدِّهِ","أَنْبَتهُ اللَّهُ النَّبات الحَسَنْ",15,"ن",1,0],["عُذْراً لكُمْ يَا أَهْلَ عُذْرَةَ شَأْنُكُمْ","سَلَّمْتُ فِيهِ لكُمْ فَقُولُوا وَافْعَلُوا",16,"ل",3,0],["عَذِيِرِيَ مِنْ قَوْمٍ تَجِيشُ صُدُورُهُمْ","لَهُمْ عَنْ طَرِيقِ الْعَدْلِ مِنِّي عُدُولُ",17,"ل",1,0],["عُذْراً لقوْمِكَ عنْ مَقامِ مقصِّرٍ","والعَبْدُ يَغْفِرُ ذنْبَهُ إقْرارُهُ",18,"ر",2,0],["عِذارٌ كَما دبَّ الحُبابُ على الورْدِ","مَحاسِنُهُ أرْبَتْ على الحَصْرِ والعَدِّ",19,"د",1,1],["عذري لتقصيري وعجزي ناسخ","ويجل منك العفو عن تثريب",20,"ب",1,0],["عُذْري لَمْ يَدِنْ للهِ فِيكَ بِقُرْبَةٍ","هُوْ مِنْ جَنَابِ اللهِ غَيْرُ قَريبِ",20,"ب",1,0],["عَذَلَتني فَقُلتُ لا تَعذُليني","قَد أُغادي المُعَذَّل المَخمورا",21,"ر",2,0],["عَذَلَتُهُ حَتّى إِذا قال إِنّي","فَذَريني سَأَعقِلُ التَفكيرا",21,"ر",2,0],["عُذافِرَةٍ تَختالُ بِالرَحلِ حُرَةٍ","تُباري قِلاصاً كَالنَعامِ الجَوافِلِ",22,"ل",1,0],["عُذافِرَةً حُرَّةَ الليطِ لا","سَقوطاً وَلا ذاتَ ضِغنٍ لَجونا",23,"ن",2,0],["عَذبُ القَريضِ قَريضٌ باتَ يَعصِمُهُ","ذِكرُ اِبنِ تَوفيقَ عَن لَغوٍ وَعَن كَذِبِ",24,"ب",1,0],["عَذيري مِن خَليلٍ يَستَطيلُ","يَميلُ مَعَ الزَمانِ كَما يَميلُ",25,"ل",1,1],["عَذبُ الجَنى لِلأَولِياءِ فَإِن يَهِج","فَالسَمُّ يَأبى أَن يَسوغَ لِجارِعِ",26,"ع",1,0],["عِذَري إِن عَذَلتَ في خَلعِ عُذري","غُصُنٌ أَثمَرَت ذُراهُ بِبَدرِ",27,"ر",1,1],["عَذَرتُكَ في سَلمى بِآنِفَةِ الصِبا","وَمَيعَتِهِ إِذ تَزدَهيكَ ظِلالُها",28,"ل",3,0],["عذراً فما التقصير مني في","ودي فمني وأقبلي عذري",29,"ر",2,0],["عَذِيرِي مِنْ ضَنَى الْقَلْبِ الْحَزِينِ","عَلَى الإِلْفِ المُفَارِقِ مَكْسَوينِي",30,"ي",1,1],["عُذْراً إذَا الأُمُّ الثَّكُولُ تَوَلَّتْ","وَفَقِيدُهَا هو آثَرُ الفِتْيَانِ",31,"ن",1,0],["عَذِيري مِنْ قَلْبِي وَشِدَّةِ بَثِّهِ","وَلَكِنَّهُ يَهْوَى فَلا يَتَكَتَّمُ",32,"م",1,0],["عَذِيرِيَ مِنْ سَبْقِ الْيَرَاعِ إلَى الَّذِي","أُدَاجِي بِهِ نَفْسِي وَلاَ أَتَكَلَّمُ",33,"م",1,0],["عَذَرتُ الذُرى لَو خاطَرَتني قُرومُها","فَما بالُ أَكّارينَ فُدعِ القَوائِمِ",34,"م",1,0],["عذراء راق العيدَ رونقُ حسنها","فغدا بنظم حليّها يتجمّلُ",35,"ل",1,0],["عذيريَ من لحظ ضعيف وقد غدا","يحكَّم منافي جسوم وأنفسِ",36,"س",1,0],["عذراء أَرضعها البيان لبانَهُ","وأطال مَغدىً عندها ومَرَاحَا",37,"ح",2,0],["عذراء راق الصنعَ رونقُ حسنها","فغدا بنظم حُليّها يتكلَّلُ",38,"ل",1,0],["عذرةً يا أبا الحسين بماذا","نصف الرز وهو رزء جليل",39,"ل",1,0],["عُذافِرَةٌ تَقَمَّصُ بِالرُدافى","تَخَوَّنَها نُزولي وَاِرتِحالي",40,"ل",2,0],["عُذافِرَةٌ حَرفٌ كَأَنَّ قُتودَها","تَضَمَّنَهُ جَونُ السَراةِ عَذومُ",41,"م",1,0],["عَذيرِيَ مِن طَوالِعَ في عِذاري","وَمِن رَدِّ الشَبابِ المُستَعارِ",42,"ر",1,1],["عُذوبَةٌ صَدَرَت عَن مَنطِقٍ جَدَدٍ","كَالماءِ يَخرُجُ يُنبوعاً مِنَ الحَجَرِ",43,"ر",1,0],["عَذيري مِنَ اللائي يَلُمنَ عَلى اَلهَوى","أَما في الهَوى لَو ذُقنَ طَعمَ الهَوى عُذرُ",44,"ر",1,0],["عَذبِ الخَلائِقِ مَحمودٍ طَرائِقُهُ","عَفَّ المَسامِعِ حَتّى يَرغَمَ اللاحي",45,"ح",2,0],["عذلوني على هواهُ فأغرَوا","فهواه نصبٌ على الأغراء",46,"ا",2,0],["عذَلوهُ على النوالِ فأغروا","فنداه نصبٌ على الإغراء",47,"ا",2,0],["عذراءُ تُنجزُ ميعادَ السرورِ فما","تومي إليك بكفٍّ غيرِ مختضب",48,"ب",1,0],["عَذيريَ منه معرِضاً متجنِّياً","كأنِّي له نحوَ الودادِ أجاذِب",49,"ب",1,1],["عذراً لمن هزت هباتك طودَهُ","ولمن أطاشَ ندىً يديك نباته",50,"ت",2,0],["عذلوه في مكارمه","وهو ماض غير مكترث",51,"ث",1,0],["عذولي منك في أمر مريج","وسمعي منك في ذكر أريج",52,"ج",1,1],["عذيريَ من ساجي اللواحظ أغيد","يصول بأسياف الجفون ولا يد",53,"د",1,1],["عذلوني في هوى أغيد قد","زاد أشجاني وفي تركي لغاده",54,"ه",1,1],["عذرنا فيك دهراً زادَ حبًّا","لما ميزْت منه على الدهور",55,"ر",1,0],["عذوليَ خذ لكَ عين الصواب","ودعْ في الهوى ليَ عين الخطا",56,"ط",2,0],["عذراً لنظميَ والدنيا مطابقة","شكواي مستورة والحال مكشوف",57,"ف",1,0],["عذراً على تأخير عبدٍ عنكمُ","أضحى بترسيم الهموم معوّقا",58,"ق",2,0],["عذاره لا يغيث دمعي","وسائل لا يجيب سائل",59,"ل",1,0],["عذولٌ لست أسمع منه عذلاً","على غيداء مثل البدر تمَّا",60,"م",2,1],["عذَّبوني في هواها عذَّلي","ونهوني زائداً والقلب مفتون",61,"ن",1,1],["عذراً لجاجتي المهدي لأنعمكم","يا خجلتي منه في سرٍّ وفي علن",62,"ن",1,1],["عذار خدّيه راقَ مرآها","فحبَّذا ماؤها ومرْعاها",63,"ا",3,1],["عذلوا جوده وشيمته الغرَّا","ء ترضي الورَى وتعطي العذولا",64,"ل",2,0],["عذلوني وفي الحشا عقد ودّ","لم يدع لاسْتماع عذلٍ محلاَّ",65,"ل",2,0],["عَذابُهُ عِندي عَذبٌ","وَبُعدُهُ عَنكَ قُربُ",66,"ب",1,0],["عَذَرْنَا النَّخل في إبداء شوكٍ","يذودُ به الأناملَ عن جناهُ",67,"ا",2,1],["عذراءَ لاحت في يدَيْ عذراءِ","أحسنُ من تَظاهُرِ النَّعْماءِ",68,"ا",2,0],["عُذِرْتَ ولكن كشفتَ الغطا","ء عنه ولَمَّا تُنِلْهُ الثوابا",69,"ب",2,0],["عَذُبَتْ خلائقُهُ فكا","دَ من العذوبة يُشرَبُ",70,"ب",1,0],["عُذراً بعذر وإلا رُحتَ مُحتقِباً","لوماً بلوم ولومي شرُّ مُحتقَبِ",71,"ب",1,0],["عذرتُك لو كانت سماءٌ تقشَّعت","سحائبها أو كان روضٌ تَصوَّحا",72,"ح",2,0],["عذْرتُكَ لوْ عرفْتُكَ خارجيَّاً","طَريفَ المجْد ليس له تليدُ",73,"د",1,0],["عَذَرْتُكُما لو تُشْغَلانِ عن البُكا","بِنَوْمٍ وما نَوْمُ الشَّجِيِّ أخي الجَهْدِ",74,"د",1,0],["عذرناه أيام إعدامه","فما عذرُ ذي بَخَلٍ واجِدِ",75,"د",1,0],["عذلتُكما عَذلِيْ وليس بجارح","فإن كان عذلاً جارحاً فهو القصدُ",76,"د",1,0],["عَذيري من الدنيا تخيبُ سُعَاتُها","ويحظى بمنفوس الأحاظي قُعودُها",77,"د",3,0],["عَذيريَ من بدر السماء لحظتُه","فوكَّل إنساني برعيْ الفراقِدِ",78,"د",1,1],["عذرتك لو كان المطال وقد سقَى","جنابي ربيع من سمائك باكر",79,"ر",1,0],["عُذراتُهُ مَختومةٌ وثمارُهُ","مكهُومَةٌ وجديدُه لم يُلْبس",80,"س",1,0],["عذيري من ابن التي لم تزل","تُقلَّبُ كالطائر المَرْعش",81,"ش",1,0],["عذلتَ فلم تترك مقالاً لعاذلٍ","فيا عجباً للعذل من صافحٍ مُغضي",82,"ي",1,0],["عذَّبني منكِ يا معذبتي","ونُزْهتي في المنام واليقظه",83,"ظ",2,0],["عذارى قواف كالعذارى خريدها","يقود الفتى نحو الصبا وشَموعها",84,"ع",3,0],["عذرتُ ذاك الوجهَ لو أنَّهُ","يصلح للرأسِ منديلا",85,"ل",2,0],["عذلتكمُ على استمرار ظُلمي","ولولا الظلم ما عذلَ العذولُ"