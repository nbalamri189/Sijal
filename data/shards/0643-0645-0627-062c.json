{"poems":[[32,"كم اجتبن من ليل إليك وواعست","https://www.aldiwan.net/poem29467.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[53,"يا رب ما أطول البلاء وما","https://www.aldiwan.net/poem66335.html","المنسرح"],[30,"إليك ابن سيار فتى الجود واعست","https://www.aldiwan.net/poem5297.html","الطويل"],[63,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[82,"ومن راقصات ساحبات ذيولها","https://www.aldiwan.net/poem31503.html","الطويل"],[48,"أيا شيعة إسماعي","https://www.aldiwan.net/poem23181.html","الهزج"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[53,"يا ربِّ ما أطولَ البلاءَ وما","https://www.poetsgate.com/ViewPoem.aspx?id=30503",""],[111,"سميري وهل للمستهام سمير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545431",""],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[131,"ألا تلك عرسي إذا أمعرت","https://www.aldiwan.net/poem24263.html","المتقارب"],[137,"فتح مبين جل أن يتخيلا","https://www.aldiwan.net/poem4220.html","الكامل"],[141,"طرقتني وصحابي هجوع","https://www.aldiwan.net/poem67958.html","المديد"],[173,"أبى الدهر أن يلقاك إلا محارباً","https://www.aldiwan.net/poem1599.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[255,"كفى ما جرى يا عين من دمع حسرة","https://www.aldiwan.net/poem15075.html","الطويل"],[376,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[385,"قفوا بالناجيات على زرود","https://www.aldiwan.net/poem49202.html","الوافر"],[411,"فتى جمع العلياء علما وعفة","https://www.aldiwan.net/poem49833.html","الطويل"],[422,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"جهلت شهاب الدين ثم بلوته","https://www.aldiwan.net/poem16035.html","الطويل"],[505,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[534,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[563,"يخاطب كلا في المناجاة صاحبه","https://www.aldiwan.net/poem33525.html","الطويل"],[563,"ألا إنما المخلوق يعرف بالعقل","https://www.aldiwan.net/poem34212.html","الخفيف"],[580,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[591,"أما وتمايل الغصن النضير","https://www.aldiwan.net/poem17536.html","الوافر"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2477","الخفيف"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62647","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124300","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48936","الخفيف"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82849","المتقارب"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89520","الطويل"],[2164,"","https://poetry.dctabudhabi.ae/diwan/poem/101864","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53165","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27623","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27846","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27772","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27755","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27861","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28039","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27911","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27622","الطويل"],[2315,"","https://poetry.dctabudhabi.ae/diwan/poem/198762","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93732","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100321","الخفيف"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9611","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201748","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88990","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91074","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36717","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105265","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90821","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45142","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94640","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138726",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72467","السريع"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105170","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139793",""],[4647,"","https://poetry.dctabudhabi.ae/diwan/poem/141852","الطويل"],[4679,"هو البشرُ للفؤاد فيطربُ","https://www.poetsgate.com/ViewPoem.aspx?id=142759",""],[4755,"كَأَنَّ لَيلًا ما بِصَدري أَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=197465",""],[4767,"شمس الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179940",""],[5038,"كيف يغنيك القليل","https://www.poetsgate.com/ViewPoem.aspx?id=190125",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5431,"حبيبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=189358",""],[5431,"يالقلبي واأساه ...","https://www.poetsgate.com/ViewPoem.aspx?id=191671",""],[5444,"حيث لهيب الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=205073",""],[5459,"صبابة ..","https://www.poetsgate.com/ViewPoem.aspx?id=196539",""],[121,"لانى انت ياوطنى","https://www.poetsgate.com/ViewPoem.aspx?id=176719",""],[5846,"رعشةُ إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=123431",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[6069,"سفرت فخلت سواد معجرها","https://www.poetsgate.com/ViewPoem.aspx?id=105666",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""],[2220,"تبارك الله ما في اليأس من باسٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11498&r=&rc=372",""]],"verses":[["كَمِ اِجتَبنَ مِن لَيلٍ إِلَيكِ وَواعَسَت","بِنا البيدُ أَعناقُ المُهارى الشَعاشِعِ",0,"ع",1,1],["كَمَا جُدِّلَتْ فاسْتَحْكَمَتْ عنْدَ جَدْلِها","مرائرُ في أيْدِي المُمرِّين تُمسَدُ",1,"د",1,0],["كما جرى الطرف غير ذي صكك","يفلُّ من غربه ولا طَرق",2,"ق",1,0],["كم أجازت إلىالأميرِ عُبَيْدَ الْ","لهِ حامِي الحمى وراعي الذِّمام",3,"م",1,0],["كم أجلِبُ العذرَ من مذاقتِه","لكن وتستشعرون إتْهامي",4,"م",2,0],["كَمِ اِجتَبنَ مِن لَيلٍ يَطَأنَ خُدودَهُ","إِلَيكَ وَنَشرٍ بِالضُحى مُتَخاشِعِ",5,"ع",1,0],["كما جادَ السَّحابُ الجَودُ أرضاً","فأبرَزَ من مَحاسِنها الخَبايا",6,"ا",3,0],["كما جَرّرَتْ أذيالَها في هديلها","حمائمُ أيْكٍ أو طَواويسُ تَبذَخُ",7,"خ",1,0],["كَما جُزِّئَ بَيتُ الشِع","رِ تَقطيعاً وَتَفعيلا",8,"ل",2,0],["كما جاوبتْ \" بومةٌ ! \" بومةً","تَقارَضُ ما بينها بالثَّنا",9,"ا",1,0],["كم أجلِبُ العذرَ من مذاقتِه","لكم وتستشعرون إتْهامي",10,"م",2,0],["كما جاهدوا في اللّه حق جهاده","وقاموا بما يرضى وفيه أبيروا",11,"ر",3,0],["كما جد في احيائه الدين جده","وفارق دنياه رضيا مكملا",12,"ل",2,0],["كم اجج الحسرات جمرا موقدا","قد شب يلهب في قلوب رجاله",13,"ل",2,0],["كَما جاشَ بِالماءِ عِندَ الوَقودِ","مِرجَلُ طَبّاخِهِ ثُمَّ فارا",14,"ر",2,0],["كم أجدلٍ منهُم أدلَّ ببأسِهِ","ما همَّ أن ينقضَّ حتى جدِّلا",15,"ل",2,0],["كَم أَجازَت نَحوَنا مِن بِلادٍ","وَحشَةٍ قَتّالَةٍ لِلرِّجّالِ",16,"ل",1,0],["كَما جاءَ قَبلي مُستَكيناً إِلى أَبي","وَقَد همَّ أَن يَلوي عَلَيهِ المَخالِبا",17,"ب",2,0],["كَما جاءَ في الدجّال يكتبُ لَفظها","فَيقرأُ مَن يَقرا ومن لم يكن يقرا",18,"ر",2,0],["كما جاء في القرآن يغفر ذنوبنا","إذا شاء كلَّ السيئات سوى الشِّرك",19,"ك",1,0],["كما جاءَ يومٌ في المُحرَّمِ واحدٌ","خَبا نُورُه لمَّا استُحلَّت مَحارِمُه",20,"م",2,0],["كَما جَمع الهَوى مِن بَعد شَوق","يَذيب النَفس بَين فَم وَجيد",21,"د",1,0],["كما جَمعَ التُّفّاحُ شكلاً وصِبغَةً","ورائحَةً محبوبَةً ومَذاقا",22,"ق",2,0],["كم أجَّجتْ من الفؤاد لوعةً","وأهْرَقَتْ من عَبرة شؤونا",23,"ن",2,0],["كم أجهضتْ قبلَك مِن عَدّهم","لها شهورَ الحاملِ المُقرِبِ",24,"ب",1,0],["كما جهل السَّاري مخائل سُحْبه","فأخْبَرَهُ عن صِدْقِها سبلُ القطْرِ",25,"ر",1,0],["كم أَجتلي لحَياتي رُوحَ نسمَتِهِمْ","مستأْنِساً فعلِ ذي لُبٍّ فتًى دَرِبِ",26,"ب",1,0],["كما جَعَلُوا ظُلْمَ الرَّعايا بِمالِها","حُقُوقاً خِداعاً وهْيَ عَيْنُ المظالِمِ",27,"م",1,0],["كما جمعوا خلداً بلفظ مباعد","وما فيه حرف منه يدريه طالبه",28,"ب",2,0],["كما جاء في القرآن والسنة التي","عن المصطفى بالحسن تهدي ذوي العقل",29,"ل",1,0],["كم اجتهدتُ بِجهدي في اللَّحاق به","وقَدْ أَصَابَ ولَو أَخْطَا مَن اجْتَهدا",30,"د",2,0],["كما جَهِلَتْ ذَوَائِبُهُ غَرَامي","عَليه وَهي تُنْسَبُ لِلشُّعورِ",31,"ر",1,0],["كَم أَجازَت مِن مَهمَهٍ يَترُكُ العي","سَ بِهِ ظُلَّعاً قِياماً وَحَسرى",32,"ر",2,0],["كَما جئت في داج مِن النَحس قائم","سَتَرجع في داج يَغشيك أَسوَدا",33,"د",2,0],["كم أجرُ هَادٍ حائِراً","قصد السَّبيل المؤتمنْ",34,"ن",1,0],["كم أجاحوا حليف ريح عناد","لم يزده الدعاء إلا فرارا",35,"ر",2,0],["كَمَا جَلَا عَنْ بَرَدٍ بَسّامِ","بَرْقٌ أَغَرَّ طَيِّبَ الأَنْسامِ",36,"م",1,0],["كَما جَرى في نَوبة المخلوع","وَقصة الطائع وَالمُطيع",37,"ع",1,0],["كما جرى واتّفَقا","لملك مصر الأحمَق",38,"ق",1,0],["كم أجازت من شاعر وأَديب","فإذا ما جهلتَها سَلْ جريرا",39,"ر",2,0],["كما جعلت دماؤهم شراباً","لهن بكل أرض ما ظَمِينا",40,"ن",2,0],["كَما جادَ أَعلامهم بِالرِّثا","ءِ بِشعر وَتَأبينه بِالخطب",41,"ب",1,0],["كَما جاءَ في الأَخبارِ نَصّاً مُوَكَّداً","فَلَسنا بِأَدنى شُبهَةٍ نَتَعَلَّقُ",42,"ق",1,0],["كم أجدب العام مغبرا فأزهره","ندى لكفيك مثل الغيث متدفق",43,"ق",1,0],["كم أججت نار الوغى فتدرعوا","غدر السوابغ حاملين جداولا",44,"ل",2,0],["كما جاء في الوحي المقرَّرِ صدقه","على ألسن الأرسالِ والقولُ للحق",45,"ق",1,0],["كما جاد لي بالحل من كل حرمة","صبيحةَ يوم الرمي من ليلةِ النحر",46,"ر",1,0],["كما جاءنا نصُّ الكتابِ مخبراً","بغفرانِ ذنبِ المصطفى بقيودِ",47,"د",1,0],["كما جاء عنا في صريح كلامنا","على ألسن الأرسالِ من كلِّ حاكم",48,"م",1,0],["كما جاء في الشرع المطهر أنه","يمل إذا مل العبيد فما فزنا",49,"ن",2,0],["كما جاء من أسرى إليه به على","بُراقِ الهدى نحو الذي قلت يشتدّ",50,"د",1,0],["كما جُعلتْ لموسى النارُ حاجبةٌ","حتى أكلمه من ذاتِ مقباس",51,"س",1,0],["كما جاء في الشورى وفيه تنبُّه","لكلِّ لبيبٍ في المحاضر واصل",52,"ل",1,0],["كم أجلب الشعراء حول متوج","لكنهم بعد الرحيل تفرقوا",53,"ق",3,0],["كَما جَبَّبَت كَدراءُ تَسقي فِراخَها","بِشمظَةَ رِفهاً والمياهُ شُعوبُ",54,"ب",1,0],["كَما جَللت وَجه السَماء سَحابة","فَسحت عَلى سَهل الفَلا وَحزونها",55,"ن",3,0],["كم اجاري جواك حثاً وريثا","واداري هواك وثبا وربضا",56,"ض",2,0],["كَما جالَ مُهرٌ في الرِباطِ يَشوقُهُ","عَلى الشَرَفِ الأَقصى المَحَلِّ خُيولُ",57,"ل",1,0],["كم أجاري غرور شخص كبير","وهو في قبضتي كطفل صغير",58,"ر",1,0],["كما جهل الداعي لحبك والذي","يراد من المحبوب في ذلك الحب",59,"ب",1,0],["كَم أُجهِدُ النفس الأَبيةَ في هَوى","مَن لَم يَكُن بِأَخي الشَقيق وَلا أَبي",60,"ب",2,0],["كَمِ اِجتَلَيتُ بُدوراً مِن مَطالِعِها","كَم نيل تَحتَ سَناها مِن سَنا قَمرِ",61,"ر",1,0],["كما جندنا هلعاً هربت","لديه فعنقي لا شك بت",