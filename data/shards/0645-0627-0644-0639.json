{"poems":[[73,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[49,"ما لعبيد من الذي","https://www.aldiwan.net/poem25230.html","مجزوء الكامل"],[49,"المجد بالرقة مجموع","https://www.aldiwan.net/poem25233.html","السريع"],[74,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[31,"ما لعياض جب خصييه مسحت","https://www.aldiwan.net/poem6195.html","الطويل"],[93,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[45,"يا من رأيت الحليم وغدا","https://www.aldiwan.net/poem9546.html","مجزوء البسيط"],[47,"قد لعمري يا ابن المغيرة أصبحت","https://www.aldiwan.net/poem64687.html","الخفيف"],[51,"ما لعذالي ومالي","https://www.aldiwan.net/poem64298.html","مجزوء الرمل"],[71,"ما لعميد ملكهم","https://www.aldiwan.net/poem28033.html","مجزوء الرجز"],[52,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140921",""],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"],[121,"المحراب","https://www.aldiwan.net/poem24022.html","الخفيف"],[131,"أوحشت النخل من معاقل فالرو","https://www.aldiwan.net/poem24262.html","المنسرح"],[147,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[190,"ما لعيني مذ هويت اغتماض","https://www.aldiwan.net/poem43663.html","الخفيف"],[228,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[237,"لي حبيب من رآه","https://www.aldiwan.net/poem14841.html","مجزوء الرمل"],[262,"أيها الساقي إليك المشتكى","https://www.aldiwan.net/poem2661.html","الرمل"],[303,"ثكلت مقلته طيب الكرى","https://www.aldiwan.net/poem36847.html","عموديه"],[325,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[325,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[333,"أنا وحدي أواه من أنا وحدي","https://www.aldiwan.net/poem55016.html","الخفيف"],[354,"إن لم أخالف زاجر العقل","https://www.aldiwan.net/poem15847.html","أحذ الكامل"],[376,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[398,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[463,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[469,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[563,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216442",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38679","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120011","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96703","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133762","الرمل"],[1253,"","https://poetry.dctabudhabi.ae/diwan/poem/146571","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144073","الرمل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18485","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79851","الخفيف"],[1594,"","https://poetry.dctabudhabi.ae/diwan/poem/97781","الخفيف"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102071","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53241","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27840","المنسرح"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216395",""],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127381","الرمل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34727","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202029","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118784","المديد"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101603","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100770","الخفيف"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104267","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126933","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108337",""],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125970","الرمل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202340","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114566","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136805",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83620","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141680","الخفيف"],[4929,"بحار عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=200189",""],[4929,"مرثية الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=204918",""],[4929,"تسونامي الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=213359",""],[5033,"عاشقٌ ليسَ إلّا","https://www.poetsgate.com/ViewPoem.aspx?id=183177",""],[5155,"الذكريات والطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=176154",""],[5179,"مَا لعين جنت على الْقلب ذَنْب","https://www.poetsgate.com/ViewPoem.aspx?id=190272",""],[5324,"كن أبي النفس.","https://www.poetsgate.com/ViewPoem.aspx?id=211647",""],[5328,"إلى جريئة","https://www.poetsgate.com/ViewPoem.aspx?id=211983",""],[259,"ما لعيني لم تعني","https://www.poetsgate.com/ViewPoem.aspx?id=214199",""],[5431,"نبضُ الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=183029",""],[5455,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=35554",""],[5561,"تحدّي الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=192956",""],[5563,"ألهب الشوق فؤاد المغترب","https://www.poetsgate.com/ViewPoem.aspx?id=212350",""],[5840,"فيك برحت بالعذول إباء","https://www.poetsgate.com/ViewPoem.aspx?id=181437",""],[5846,"رجاء..","https://www.poetsgate.com/ViewPoem.aspx?id=123430",""],[5937,"مآذِنٌ ناسِفة","https://www.poetsgate.com/ViewPoem.aspx?id=211826",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""],[6124,"ما لعيني","https://www.poetsgate.com/ViewPoem.aspx?id=159898",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""],[520,"قل للأمير الأكرم الكمال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577602",""]],"verses":[["ما لِعيسي وَما لِعَيشي وَمالي","كُلَّ يَومٍ نَلقى عَناءً وَكَدّا",0,"د",2,0],["ما لعيش تشكون منه سَقاماً","بسوى الأتحاد من ابلال",1,"ل",1,0],["ما لِعَبيدِ مِنَ الَّذي","يَقضي بِهِ اللَهُ اِمتِناعُ",2,"ع",1,1],["ما لِعَصا قَومِيَ قَد شَقَّها","تَفارُطٌ مِنهُم وَتَضيِيعُ",3,"ع",1,0],["ما لعداك راية تقام","وليس غير الكسر والسلام",4,"م",1,0],["ما لِعِياضٍ جَبَّ خُصيَيهِ مُسحِتٌ","بِموسى مِنَ الخُثمِ الأُنوفِ خِتانِ",5,"ن",1,1],["ما لِعَيني لا تُبصِرُ العَيّوقا","وَلَقَد كانَ ساطِعاً وَقّادا",6,"ا",1,0],["مالَ عَلَيَّ الشَرابُ جِدّاً","وَأَنتَ بِالمَكرُماتِ أَهدى",7,"د",2,0],["ما لِعَينَيكَ تَغزِلانِ إِذا ما","رَأَتا في الرُؤوسِ رَأساً صَليعا",8,"ع",2,0],["ما لِعُذّالي وَمالي","أَمَروني بِالصَلالِ",9,"ل",1,1],["ما لعميدٍ ملكهمْ","منْ عاصمٍ أو نافعِ",10,"ع",1,1],["ما لِعَينَيكَ لَم تَذوقا مِنَ اللَي","لِ رُقاداً وَلَم تُريدا جُمودا",11,"د",2,0],["مال علي الشراب جداً","وأنت للمكرمات أهدى",12,"ا",1,0],["ما لعيني تبكي عليها وقلبي","يتمنى سواده لو فداها",13,"ا",3,0],["ما لِعَبْدِ الوَلِيّ في مَوكِبِ التَّو","بةِ إلّا لُزُومَه مِحْرابَه",14,"ب",2,0],["مالَ عَلى قُبَّةِ البُثاءِ فعز","زَ المَترُ بَينَ الرَجلاءِ فَالجُمُدِ",15,"د",1,0],["ما لِعِرقِ الأَتراكِ لا اِجتَثَّهُ الدَه","رُ وَلا مالَ دَوحُهُ لِاِنقِصافِ",16,"ف",1,0],["ما لعينَيّ مذ هويت اغتماض","هل من النوم للجفون اعتياض",17,"ض",1,1],["ما لِعَينَيَّ تَغشيانِ رُوَيداً","وَرُوَيداً تُطارِدانِ الأَناما",18,"م",2,0],["ما لِعُشّاقِ سُلَيمي","في الهَوى لا يَعقِلون",19,"ن",1,0],["ما لِعَيني عَشيت بِالنَظَرِ","أَنكَرَت بَعدَكَ ضوءَ القَمَرِ",20,"ر",1,0],["ما لعينِ النجمِ تغضي حينما","يتجلى الفجرُ وَضّاحَ السنا",21,"ا",1,0],["ما لَ عَنهُم مُستَحقِراً بِتَواري","مَظهَراً أَنَّهُ يُعافُ الأَطالَه",22,"ل",2,0],["ما لِعَينَيَّ قَريرُهُ","وَلَمِ الدُنيا مُنيرُهُ",23,"ر",2,1],["ما لعقلي خلقت يا رب فارحم","أنا يا رب قد خلقت لقلبي",24,"ي",1,0],["ما لعقلي خلقت فليمض عقلي","ولتدَع لي الأيام أشلاءَ حبّي",24,"ي",1,0],["ما لعِزُّ إِلّا أَن أَذَلَّ لَكُم","وَأَرى دَوامَ العِزِّ في الذُلِّ",25,"ل",1,0],["ما لِعَيني وفُؤادي كلَّما","كتَمَت باحَ وإن باحَت كَتَم",26,"م",1,0],["ما لِعَليِّ العَلاءِ أَشباهُ","لا وَالَّذي لا الهَ الاهُ",27,"ا",2,1],["ما لعينيّ قُرّةٌ ولقلبي","غيرُكم إذ أرى غداً أطلالَهْ",28,"ل",2,0],["مالَ عني كميلِ","عطفيهِ حتَّى خيالهُ",29,"ل",2,0],["ما لعلع حادي النوق وما","سار الركبان على السرج",30,"ج",1,0],["مِ العَضاد ايديِه ماجوره","لي يفرّي ضيقْةِ البالي",31,"ل",2,0],["مالَ عنّي إِلى الجَفاءِ حَبيبي","وَنَكاني بِجَفاهُ أَقوى نِكايهْ",32,"ه",1,1],["ما لعبيد ولا لبيد","رونقه لا ولا جريرِ",33,"ر",1,0],["ما لعذّالي وما لي","قد أطالوا في المقالِ",34,"ل",1,1],["ما لعيني لا ترى غير الجمال","في اتضاع السهل في شم الجبال",35,"ل",1,0],["ما لعلي فيه من نسبة","تؤويه إلا أنه للفراش",36,"ش",1,0],["ما لِعرقِ الرّزقِ إن لم","يُجْرِه جاهُك نبْضُ",37,"ض",1,0],["مال علينا حادِثُ الزمانِ","تمايُل الجل عن الحصانِ",38,"ن",1,0],["ما لعليا محمدٍ حسنِ الأخلاق","تلقى الشعرى العبور عبورا",39,"ر",2,0],["ما لعيني لا تجودانِ رَيا","قد رُزِينا خير البرية حيا",40,"ي",2,1],["ما لعلع الحادي بهم","أو يدع داع في السهر",41,"ر",1,0],["ما لعلم الا في صدور رجاله","أبدا وماالثمرات في الاوراق",42,"ق",1,0],["مَا لِعَمدُونَ عَمَوا عَنْ شَأنِهِ","وَهْوَ كَالشَمسِ دَنَتْ لِلطَّفلِ",43,"ل",1,0],["ما لعاب الشمس إلا عبرة","قد أعدتها له في الموجعين",44,"ن",1,0],["مال عِطفاً وماد رِدفاً ب","دا كل فن من حسنه اليوسفيِّ",45,"ي",1,0],["ما لعبةٌ تراها","إلا تؤوَّل",46,"ل",1,0],["مِ العشب تِخْضَرّ الزِميم","والسيح جاه امّا كفاه",47,"ا",2,0],["ما لعيني لا ترى السر العجيب","في اختفاء الروح بالجسم الثقيل",48,"ل",1,0],["ما لعيني تفيضُ غير جَمودِ","ليس تَرقَا ولا لها من هُجودِ",49,"د",1,1],["ما لعقلي لكل عقل مُغايرْ","ولدربي عكسَ البرّية سائر",50,"ر",1,1],["ما لعشقي فيك مبتدأ","فاترك الإطناب في خبرِه",51,"ر",2,0],["ما لعيني والنور شعّ بقربي","لم تميّز إلا فراغاً خليّا",52,"ي",2,0],["ما لعقبانك اتخمن وغدرا","نك أصبحن بالدماء طوامى",53,"م",2,0],["ما لعينيك والسهر","وخط الشيب فاعتبر",54,"ر",1,1],["مالعين العلا سواه سواد","لا ولا غيره لها من حبيب",55,"ب",1,0],["ما لعيني تراهم نافسوا نم","راً ومنهم اعلى واسمى مكانا",56,"ن",2,0],["مال عنى ومضى","غاضباً ظبي الفضا",57,"ض",2,1],["مال عني بما أومل دهر","كلما قلت سوف يأسو أساء",58,"ا",2,0],["مالَ عطفاً لا بل تَثَنِّيهِ مِمَّا","بِثَنَاياهُ من رَحِيقٍ ثَنَاهُ",59,"ا",2,0],["ما لعطا مكتسب","هيهات ما لبخت يكسب",60,"ب",1,0],["ما لعيني من نواهُ إن تَروق","ما لقلبي الدهر يرتاح الفِكَر",61,"ر",1,0],["ما لِعَذراء بِالإِلَه وَما للقُ","دس مِن آدم وَمِن حَواء",62,"ا",2,0],["ما لِعَيني لا تَراكا","وَهي تَشتاقُ لِقاكا",63,"ك",2,0],["ما لعمري دهاؤك اليوم مُنج","لك إن كدت شيخنا أو محصّي",64,"ص",2,0],["مالعينيَّ منذُ أنْ حالَ سدّاً","طيفُ مرآك بالمنامِ اقتحامُ",65,"م",1,0],["ما لِعُمْرِ الكبارِ في الدهر سقفٌ","أو لِكَفِّ البِلى به إبلاءُ",66,"ا",2,0],["مالِ (عزرائيلٍ) ينقِّبُ عن با","قي حياةٍ في موتِنا لازالا !",67,"ل",2,0],["مَا لِعَينَيْكِ تَرْسُمُ الآنَ بَحْرَاً ؟","يَسْبَحُ الْبَدْرُ فيهِمَا حِينَ ضَلّا",68,"ل",2,0],["ما لعيني تحجر الدمع فيها","ودموع الشجي تشفي غليله",69,"ل",2,0],["مَا لعين جنت على الْقلب ذَنْب","إِنَّمَا يُرْسل اللحاظ الْقلب",70,"ب",1,1],["ما لعبد عند عبد أيّ رزق *","عند ربّ العرشِ أرزاق الجميعْ",71,"ع",1,0],["ما لعينيك كلما صادفتني","كالت الحب واستدارت برئية",72,"ي",2,0],["ما لعيني لم تُعنّي","لمَ تقسو وهْيَ مني",73,"ن",2,1],["مالعمر إلاّ فعل خيرٍ مجتبى.","فكن السحابة مفعما بعطاءِ",74,"ا",1,0],["مالعب فيك الزمان ولاقرفتي جوعه","ولاوقفتي من همومك وقفة محنيه",75,"ي",2,0],["ما لعينيكِ طالَها الإغفاءُ","أم بعينيكِ آهةٌ وعناءُ",76,"ا",2,1],["ما لعينٍ غير جفْنَيْها ذَرَا","وهْيَ دون الجفْنِ دمعٌ منْسكِبْ",77,"ب",1,0],["مال عني بما أؤمل فيه","كلما قلت سوف يأسو أساء",78,"ا",2,0],["مالِعمرٍ في بدايات المُنى","يكتوي..يمضي عليلاً مُجْهَدا!!",79,"د",2,0],["مالعمر إلّا نقصُهُ ، وقصيدةٌ","تكفي لأدرك أن عمريَ كامِلُ",80,"ل",1,0],["ما لِعَمْرِي شَكَوْتُ بَلْ شَكَتِ الأيْ","يامُ والمُسْلِمونَ والإسْلامُ",81,"م",1,0],["ما لعيني تبصرُ الماضي جراحا","قلَّما شافتْ ضياءً أو براحا",82,"ح",2,1],["ما لِعودِي قد ذوى منْ بعد شدوِي","ما لِنورِي قد خبا قد كانَ سعْدَا",83,"د",2,0],["مال عليك الدهر لكنه","لم يستند منك إلى مائل",84,"ل",1,0]]}