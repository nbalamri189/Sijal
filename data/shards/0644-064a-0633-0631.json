{"poems":[[75,"أقدم كما قدم الربيع الباكر","https://www.aldiwan.net/poem11942.html","الكامل"],[50,"لا أحط الحزام طوعا عن المحذوف","https://www.aldiwan.net/poem62424.html","السريع"],[15,"ليس رسم على الدفين ببالي","https://www.aldiwan.net/poem45253.html","الخفيف"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66748","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16807","الخفيف"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206182",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108612","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110334","الرمل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[4759,"وكيف إلتفاتي؟","https://www.poetsgate.com/ViewPoem.aspx?id=204067",""]],"verses":[["لِيُسَرَّ مُكتَئِبٌ وَيُغفِيَ ساهِرٌ","وَيَراحَ مُرتَقِبٌ وَيوفِيَ ناذِرُ",0,"ر",1,0],["لَيسَ راويسُ حينَ سارَ أَمامَ ال","حوتِ وَالبَدرُ إِذ هَوى لِاِنصِبابِ",1,"ب",1,0],["لَيسَ رَسمٌ عَلى الدَفينِ بِبالي","فَلِوى ذَروَةٍ فَجَنبَي أُثالِ",2,"ل",1,1],["لَيسَ ريحٌ هُبوبُها يَقطَعُ النَس","لَ كَريحٍ تَطغى فَتَذرو الفيلا",3,"ل",2,0],["لِيَسُرَّ مخلوقاً ويُسخِطَ خالقاً","إن الشقيَّ بكلّ شرٍّ مولعُ",4,"ع",1,0],["لَيسَ ريحُ التُفّاحِ عِندي بِريحِ","لا وَلَكِنَّهُ صَديقٌ لِروحي",5,"ي",1,1],["لي سِرْت سِر سير التأنّي والآداب","واحْزب تشطّ بسيد جَمْل الكواعيب",6,"ب",1,0],["ليسر قلبي بالوصال كما","سرت دمشق بحالت المجد",7,"د",1,0],["ليس رب العلم من قال أنا","إن رب العلم من قد فعلا",8,"ل",2,0],["لَيسَ رُؤيا عَلَيهِ غَيرُ ظِلامٍ","لَيسَ حِسٌّ عَلَيهِ غَيرَ اِنقِباضِ",9,"ض",1,0],["ليسرقني الدرب عن لهفتي","وينثر من شوقها ما احتواك.",10,"ك",1,0]]}