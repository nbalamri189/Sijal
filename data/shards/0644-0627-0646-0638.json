{"poems":[[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[47,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[35,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[240,"ألا أبلغ عماد الدين عني","https://www.aldiwan.net/poem32153.html","الوافر"],[275,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[445,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[466,"يقر بعيني أن أجشمها السرى","https://www.aldiwan.net/poem15454.html","الطويل"],[569,"سلاماً وأهلاً أيها السيد الشهم","https://www.aldiwan.net/poem891.html",""],[591,"سرى لأرض الكرى فما وصلا","https://www.aldiwan.net/poem17662.html","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96616","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109023","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104698","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45766","الطويل"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132185","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119703","المجتث"],[4930,"مات شيء","https://www.poetsgate.com/ViewPoem.aspx?id=213400",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""]],"verses":[["لأَنظُرَ هَل تَبدو لِعينَيَّ نَظرَةً","بِحومانَةِ الزُرقِ الحُمولُ البَواكِرُ",0,"ر",1,0],["لَأَنظِمَنَّ القَوافي في مَثالِبِهِ","كَنَظمِ عِقدِ كَسولِ المَشيِ مِعطارِ",1,"ر",1,0],["لَإِن ظَعَنَ الأَحبابُ يا أُمَّ مالِكٍ","لَما ظَعَنَ الحُبُّ الَّذي في فُؤادِيا",2,"ي",2,0],["لا نظامٌ حرُّ فيرْعى الكفاءاتِ","ولا مَن يُقيمُ للحر وزْنا",3,"ن",2,0],["لا نظيرٌ له ولا من شبيهٍ","في عُلاه وخُلْقه وسَنَائِه",4,"ا",3,0],["لِأَنظُرَ ما يَكونُ مآلَ أَمري","أَأَخطَأَ فيهِ ظَنّي أَم أَصابا",5,"ب",2,0],["لأنظمَها عقداً يَليقُ بجيدِها","ولكنَّ ما في القلبِ أغلى من الدُّرَر",6,"ر",1,0],["لا نَظْمُ أَشعارِي ولا نثري ولا","صُحُفِي ولا جَهْدُ اللسانِ ولا القَلَمْ",7,"م",1,0],["لأنظر بالحصباء من سيف دجلةٍ","أغرَّ كنصلِ السيف جمَّ المناقبِ",8,"ب",1,0],["لإن ظاهراً فارقت حكماً موقتاً","فإن على الأرواح باقٍ لك الحكم",9,"م",1,0],["لأَنْظِمَنَّ المَدِيحَ مِنْ دُرَرٍ","لَمْ تَدْرِ عَلْياكَ بَعْدَهُ عَطَلا",10,"ل",2,0],["لأنْظُم فِي عَلْيَاكَ عقدَ مَدَائِحٍ","تُرَابِطُ فِي بَذْلِ الثَّنَا وَتُشَاعِرُ",11,"ر",1,0],["لا نظر بعدَ السفح لي سفحاً ولا","بعدَ الكثيبِ نبت شرح كثيبِ",12,"ب",1,0],["لا نظم من دراري الظرف عقدا","وأُطلع في سما الحسنى شهابا",13,"ب",2,0],["لأنظُرَ لِلأَملاَكِ حِينَ تَحِيتَّى","فَرَكبَّهُ مِمَّا أَرَادَ بِعَطفَةِ",14,"ه",1,0],["لا نظرون لمخلوق بمصلحة","عمىٌ عن الحق خرسٌ كاملوا اليكم",15,"م",1,0],["لِأَنظم أَشتات المَعاني بَديعة","عَلى الجيد مِن عَلياك نَظم القَلائد",16,"د",1,0],["لأنظر نجما قد فتنت بحسنه","يغيب دلالا في السماء ويظهر",17,"ر",1,0],["لأنظمن قريضاً","عن مدح ذاتك يبحث",18,"ث",1,0],["لا نظامٌ أو قيامٌ في انكسارَهْ","ليسَ عِيْرٌ أو نفيرٌ لانتصارَهْ",19,"ر",2,0],["لا نظنُّ الأعْرافَ تَجْهَلُنا","وعليٌّ مِنْ فوقِها يَقِفُ",20,"ف",1,0]]}