{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[95,"يا من أتتني بلا سلك رسالته","https://www.aldiwan.net/poem11166.html","البسيط"],[93,"في ذلك الروض الأغن بدى فتى","https://www.aldiwan.net/poem8735.html","عموديه"],[237,"يا غادرا نقض العهود وخانا","https://www.aldiwan.net/poem14838.html","الكامل"],[280,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[556,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119938","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73979","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129965","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86274","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138542",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85080","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90805","الكامل"],[5101,"زَرّر قميصك","https://www.poetsgate.com/ViewPoem.aspx?id=212659",""]],"verses":[["لِلَّهِ زَهرَةُ مُلكٍ قامَ حاسِدُها","وَلَيسَ يَعلَمُ أَنَّ الشَمسَ في الحَمَلِ",0,"ل",1,0],["للهِ زَفْرَةُ مُشْتَاقٍ تَنَاقَهَلَا","رَحْبُ الأَثِيرِ بِخَافِي النَّبْضِ رَنَّانِ",1,"ن",1,0],["لِلَّهِ زَورَتُها وَقَد قَنِطَ الفَتى","فَكَأَنَّها روحٌ جَرى فيمَن تَوى",2,"ا",1,0],["لِلَهِ زَورٌ مِن خَيالِكَ زارَني","بَعَثَ الهُمومَ وَهَيَّجَ الأَحزانا",3,"ن",2,0],["للَّهِ زَحْفُ خَمِيسهِ بِزَعِيمِهِ","تَحْتَ اللوَاءِ لعُبَّدِ الأَصْنَامِ",4,"م",1,0],["للَّهِ زَوْرٌ زارَنا وقتَ الكرى","واللّيل جَوْنُ أديمِهِ لا يوضِحُ",5,"ح",1,0],["لله زين الدين من متواضع","مازال للجلساء زين المجلس",6,"س",1,0],["للّه زورته وقد حلى الدجى","جيد السماء بكل نجم زاهر",7,"ر",1,1],["لِلَّهِ زائِرَةٌ بِلَيلٍ لَم تَخَف","عَسَسَ الاميرِ وَمَرصَدَ السَّجَانِ",8,"ن",1,0],["للّه زوبَعَةٌ أثير بها الثرى","فتعَلّق بذوائبِ الآفاق",9,"ق",1,1],["لِلَّهِ زاهي مُحَيّاً ما بَدا سِحرا","إِلّا وَعَقل المُعَنّى في الهَوى سِحرا",10,"ر",2,1],["لله زينب ما رأته","زينب أم المصائب",11,"ب",1,0],["للَه زائرتي التي","أزرت بأنوار الزهور",12,"ر",1,0],["للَه زاوية زها تاريخها","مذ شادها كنز الكمال أبو الهدى",13,"د",2,0],["لله زِرُّكَ كيف النّارُ تلفَحُهُ","فلا يذوبُ، وبي من وَهْجِها شَلَلُ",14,"ل",1,0]]}