.aldiwan.net/poem47229.html","الرجز"],[553,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[553,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[553,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[553,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[553,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[553,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[560,"لا تأخذ الخلاق يا قوم","https://www.aldiwan.net/poem34085.html","أحذ الكامل"],[563,"قلت لعنس قد ونت طليح","https://www.aldiwan.net/poem27836.html","الرجز"],[564,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[577,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[824,"","https://poetry.dctabudhabi.ae/diwan/poem/103391","البسيط"],[971,"","https://poetry.dctabudhabi.ae/diwan/poem/21157","الكامل"],[1015,"","https://poetry.dctabudhabi.ae/diwan/poem/21220","البسيط"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/17483","الكامل"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29454","الكامل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/18793","البسيط"]],"verses":[["لا تَأمَنَنَّ عَدوّاً لانَ جانِبُهُ","خُشونَةُ الصِلِّ عُقبى ذَلِكَ اللينِ",0,"ن",1,0],["لا تَأمَنِ الدُنيا عَلَيكَ فَإِنَّها","ذاتُ البُعولِ تُبَدِّلُ الأَبدالا",1,"ل",2,0],["لا تَأسَفَنَّ مِنَ الدُنيا عَلى سَلَفٍ","فَآخِرُ الشَهدِ فينا أَعذَبُ العَسَلِ",2,"ل",1,0],["لا تَأمَنَنها إِن أَسَأتُ بِها","هِيَ ما عَلِمتَ وَأَنتَ تَعرِفُها",3,"ف",3,0],["لا تَأخُذيني بِالمَشيبِ فَإِنَّهُ","تَفويفُ ذي الأَيّامِ لا تَفويفي",4,"ف",2,0],["لا تَأسِيَنَّ عَلى خَليطٍ زايَلو","بَعدَ الأُلى قُتِلوا بِذي أَغيالِ",5,"ل",1,0],["لا تَأخُذيني بِشَيءٍ","جَرَت عَلَيهِ السُيولُ",6,"ل",1,0],["لاَ تَأمَنِ الدَّهْرَ وَعُدْوَانَهُ","عَلَيْكَ فَالدَّهْرُ سَرِيعُ الْحِسَابْ",7,"ب",1,0],["لا تَأَخُذَنّي بِأَقوالِ الوُشاةِ وَلَم","أُذِنب وَلَو كَثُرَت عَنّي الأَقاويلُ",8,"ل",1,0],["لا تَأخُذونا بِالكَلا","مِ فَلَيسَ في الشَكوى جِنايَه",9,"ا",3,0],["لا تأخذ الجاني بما هو اهله","واغفر بجاه المصطفى المختار",10,"ر",1,0],["لا تَأْخُذِ الْغُمَّةُ الْكُبْرَى مَآخِذَهَا","مِنْكُمْ وَإِنْ صَغُرَتْ تِلْقَاؤهَا الْغُمَمُ",11,"م",1,0],["لا تَأخُذا بِظُلامَتي أَحَداً","قَلبي وَطَرفي في دَمي اِشتَرَكا",12,"ك",2,0],["لا تأمَنن دنياك في حالة","مهما تكن زاهية زاهرة",13,"ر",2,1],["لا تَأمَنَنَّ فَإِنّي غَيرُ آمِنِهِ","غَدرَ الخَليلِ إِذا ما كانَ أَلوانا",14,"ن",2,0],["لا تَأمَنَنَّ بَني مَيثاءَ إِنَّهُمُ","مِن كُلِّ مُنتَفِجِ الجَنبَينِ حَيّادِ",15,"د",1,0],["لا تَأمُريني أَن أُلامَ فَإِنَّني","آبى وَأَكرَهُ أَمرَ كُلِّ مُليمِ",16,"م",1,0],["لا تأسَ إن فَنيَ الكرامُ وإذ","وُجد ابنُ يحياها فقل حسبي",17,"ب",2,0],["لا تأمرنِي بمدحِ الحاضرين فما","أراهُ بل لا أرى قلبي له يجب",18,"ب",1,0],["لا تَأَثَمَا فِي مَنْح شعْري مَهْرهُ","يا صَالِحان فإنَّهُ فَرْجٌ نُكِحْ",19,"ح",1,0],["لا تأمننَّ الهوى وسطوتَه","واخْشى رَداه ومنه فاحْترس",20,"س",1,0],["لا تأسينَّ لها فقدْ زَوَّجتَها","كُفؤا وضمَّنت الصَّداقَ مَليكا",21,"ك",2,0],["لا تَأمَنَنَّ زُبالِيّاً بِذِمَّتِهِ","إِذا تَقَنَّعَ ثَوبَ الغَدرِ وَأتَزَرا",22,"ر",2,0],["لا تأمَنَنَّ الدَّهْرَ إمَّا غَفَا","في كهفِهِ الدَّاجي وطالتْ رُؤَاهْ",23,"ا",2,0],["لا تأخذنك عند سيرك رهبة","ما في طريق الخلد شيء موبق",24,"ق",1,0],["لا تأخذن بريئنا بمسيئنا","فالعدل كلٌّ حاصد ما يزرع",25,"ع",1,0],["لا تَأخُذَنَّ مِنَ الأُمورِ بِظاهِرٍ","إِنَّ الظَواهِرَ تَخدَعُ الرائينا",26,"ن",2,0],["لا تأمُلُنَّ بني الزمان فطالما","أكدَى وخابَ الآمِلُ المتأمِّلُ",27,"ل",1,0],["لا تَأمُرَنّي بِالعَزاءِ وَقَد تَرى","أَثَرَ الخَليطِ وَلاتَ حينَ عَزاءِ",28,"ا",2,0],["لا تَأخُذوا حَظَّ أَقوامٍ تَليقُ بِهِم","إِذا بَدَت مِنهُمُ الأَخلاقُ وَالخِلَقُ",29,"ق",1,0],["لا تَأخُذَنَّ عَلَيَّ قَولَ مُحَدِّثٍ","ضَغِنٍ عَلى وَتَرٍ بِهِ مَتبولِ",30,"ل",1,0],["لا تأنَفنَّ من العِتابِ وَقَرصِه","فالمِسكُ يُسحَقُ كي يَزيدَ فَضائِلا",31,"ل",2,0],["لا تأسَفَنَّ على الصَّباحِ فحسْبُنا","ضوءُ السَّوالفِ والسُّلافُ صَباحا",32,"ح",2,0],["لا تأخُذَنِّي بجُرمِ كاساتِ","فما جناياتُها جِناياتي",33,"ت",2,1],["لا تَأمَنِ المَوتَ في ظَرفٍ وَلا نَفَسٍ","وَلَو تَمَنَعتَ بِالحُجّابِ وَالحَرَسِ",34,"س",1,1],["لا تَأثَمَنَّ فَإِمّا كُنتَ مُنهَمِكاً","في العِلمِ يَوماً وَإِمّا كُنتَ مُنغَمِسا",35,"س",2,0],["لا تَأمَنِ الدَهرَ الصَروفَ فَإِنَّهُ","لا زالَ قِدماً لِلرِجالِ يُهذِّبُ",36,"ب",1,0],["لا تَأَمَنِ الأُنثى حَياتَكَ إِنَّها","كَالأُفعُوانِ يُراعُ مِنهُ الأَنيَبُ",36,"ب",1,0],["لا تَأَمَنِ الأُنثى زَمانَكَ كُلَّهُ","يَوماً وَلَو حَلَفَت يَميناً تَكذِبُ",36,"ب",1,0],["لا تَأمَنَنَّ مَعَ الحَوا","دِثِ عَثرَةَ الدَهرِ العَثورِ",37,"ر",1,0],["لا تَأمَنِ المَوتَ في طَرفٍ وَلا نَفَسٍ","وَإِن تَمَنَّعتَ بِالحُجّابِ وَالحَرَسِ",38,"س",1,0],["لا تَأمَنِ الحَتفَ فيما تَستَلِذُّ وَإِن","لانَت مَلامِسَهُ في كَفِّ مُلتَمِسِ",38,"س",1,0],["لاتَأمَنِ الدُنيا عَلى غَدرَةٍ","كَم غَدَرَت قَبلُ بِأَمثالِكا",39,"ك",2,0],["لا تَأمَنَنَّ اللَيالي","فَكُلُّهُنَّ خَأونُ",40,"ن",1,0],["لا تَأمَنَنَّ إِلى الخَريفِ وَإِن غَدا","عَذبَ الهَواءِ يَلَذُّ لِلأَجسامِ",41,"م",1,1],["لا تَأخُذني بِجُرمِ مَن قَد غَلِطا","في حالَةِ سُكرِهِ وَإِن كانَ خَطا",42,"ط",2,1],["لا تَأمَنَنْ مَنِيَّةً","إنّ عَصَاها تَقْرَعُك",43,"ك",1,0],["لا تأمننّ الردى من سيف مُقلَتِها","فإنّه عَرَضٌ في جَوهَرِ الحَوَرِ",44,"ر",1,0],["لا تَألَفُ الفَحشاءُ بُردَيهِ وَلا","يَسري إِلَيهِ مَعَ الظَلامِ المَأثَمُ",45,"م",1,0],["لا تَأخُذيني بِالزَمانِ فَلَيسَ لي","تَبَعاً وَلَستُ عَلى الزَمانِ كَفيلا",46,"ل",2,0],["لا تَأْمُلَنَّ بِكُلِّ عَامٍ مُقْبِلٍ","خَيْرَاً فَكُلُّ الدَّهْرِ عَامُ جِوَانِ",47,"ن",1,0],["لا تأسفنَّ لما مضى واحرصْ على","إصلاحِ ما أبقيتَ باستكثارِ",48,"ر",1,0],["لا تَأمَنَنَّ الدَهرَ أُنثى بَعدَها","إِنّي لا مِن غَدرِهِنَّ نَذيرُ",49,"ر",1,0],["لا تَأسَ يا خيرَ الغُزاةِ لناشئٍ","يهذِي ويَخدعُ نفسه بخيال",50,"ل",1,0],["لا تأمنوه فما لكم من عصمةٍ","تُرجَى إذا عَصفتْ يداه ولا لي",50,"ل",2,0],["لا تَأخُذوا بِيَدِ السِياسَةِ إِنَّها","تَرمي المَمالِكَ عَن يَدَي عِزريلِ",51,"ل",1,0],["لا تَأمَنَن فَتَكاتِ لَحظٍ أَرمَدٍ","فَالعَضبُ يَقطَعُ ماضِياً وَصَقيلا",52,"ل",2,0],["لا تَأمَنَنَّ تَميمِيّاً عَلى جسد","قَد ماتَ ما لَم تَزايَل أَعظُمُ الجَسَدِ",53,"د",1,0],["لا تَأمَنوا مِن بَعدِ حِلمٍ شَرّا","كَم غُصُنٍ أَخضَرَ صارَ جَمرا",54,"ر",2,0],["لاَ تَأمَنَنَّ عَلَى الأَمْوَالِ سَارِقَها","ولا تُقَرِّبْ عّدُوُّ اللهِ والدِّينِ",55,"ن",1,0],["لا تَأتِيَنَّ بِلادَ مَكَّةَ مُحرِماً","وَلَوَ اَنَّ مَكَّةَ عِندَ بابِ الدارِ",56,"ر",1,0],["لا تأخذنّي من ورائي سيّدي","واغمد فخذني هاك من قدّاميه",57,"ي",2,0],["لا تَأمَني أَن تَجورَ مَظلَمَةٌ","بِرَبِّها وَالزَمانُ يَنقَلِبُ",58,"ب",1,0],["لا تَأمَنَنَّ مِنَ الدُهورِ تَغَيُّراً","حَتّى تَكونُ ظِبائُها كَذِئابِها",59,"ب",3,0],["لا تَألَفُ الإِنسَ وَلا تَعرِفُ القَن","سَ وَلا تَسمو إِلَيها الأُشُب",60,"ب",1,0],["لا تَأمَنِ الكَفُّ مِن أَيّامِها شَلَلاً","وَلا النَواظِرُ كَفّاً عَنِّ أَو رَمَدا",61,"د",2,0],["لا تَأسَفَنَّ لِفائِتٍ ما واحِدٌ","يُقضى لَهُ في نَفسِهِ إيثارُ",62,"ر",1,1],["لا تَأنَفَنَّ مِن اِحتِرافِكَ طالِباً","حِلّاً وَعَدِّ مَكاسِبَ الفُجّارِ",63,"ر",1,1],["لا تَأسَفَنَّ عَلى شَيءٍ تُفاتُ بِهِ","فَقَد تَساوى لَدَيكَ الجَونُ وَالكَرِكُ",64,"ك",1,1],["لا تَأمَنَنَّ أَخا داءٍ وَلا ضَمَنٍ","قَد يُحدِثُ السَيفُ كَلماً وَهوَ مَفلولُ",65,"ل",1,0],["لا تَأمَنُ الأَغفارُ في النيقِ أَن","تُصبِحَ مَوصولاً بِها الأَحبُلُ",66,"ل",1,0],["لا تَأمَنوا بَرقَ الغَمامِ فَإِنَّما","تِلكَ السُيوفُ مِنَ القَضاءِ مُسَلَّلَه",67,"ل",2,0],["لا تَأسَفَنَّ حَواجِلُ الغِربانِ وَال","فِتيانُ كُلُّهُمُ بِقَيدٍ حاجِلِ",68,"ل",1,0],["لا تَأذَنونَ إِلى النُهاةِ مَصيفَكُم","وَتُجانِبونَ البِرَّ في مَشتاكُمُ",69,"م",1,0],["لا تَأمَنِ الدَهرَ وَتَحويلَهُ المُل","كَ إِلى آلِ إِماءٍ ضَبَبنَ",70,"ن",1,0],["لا تَأمَنوا آراءَهُ وَظُنونَهُ","إِنَّ العُيونَ لَها مِنَ الأَمدادِ",71,"د",1,1],["لا تَأْتدِمْ شَيئاً على أَكلهِ","فإنَّهُ بالجوعِ مَأدومُ",72,"م",1,0],["لا تأسَفِ الدَّهرَ عَلى ما مَضَى","والقَ الذي ما دونَهُ مِنْ مَحيصْ",73,"ص",1,0],["لا تأمن الذئب مهما كان ذا دعة","فالذئب إِن يلقَ يوماً فرصةً يثبِ",74,"ب",1,0],["لاَ تَأْمَنُ السَّيْفَ إذْ رَوَّحْتُهَا إِبِلي","حَتَّى تَرَى نِيبَهَا يَضْمِزْنَ بِالْجِرَرِ",75,"ر",1,0],["لا تأسفن لها فإن نعيمها","كشقائها وسقامه كشفائها.",76,"ا",3,0],["لا تأمَنَنّ فَوارِساً من عامرٍ","إلاّ بذمّةِ فارِسٍ من وائِلِ",77,"ل",1,0],["لا تأل لا سعيا ولا تكلانا","لا ينفع التوكّل الكسلانا",78,"ن",2,0],["لا تَأسِيَنَّ عَلى خَليطٍ زايَلوا","بَعدَ الأُلى قُتِلوا بِذي أَغيالِ",79,"ل",1,0],["لا تَأْسَ يَا قَلْبُ عَلَى مَا مَضَى","لا بُدَّ لِلْمِحْنَةِ مِنْ مَقْطَعِ",80,"ع",1,0],["لا تأخذوا بالذنب غيرَ جنُاتِهِ","إن الصواب تلمُّسُ الأعذار",81,"ر",1,0],["لا تَأخذنَّكَ في الإصلاحِ تَنْشُدُهُ","هَوَادةٌ، رُبَّ ريْثٍ يُورثُ العَطَبَا",82,"ب",2,0],["لا تأخذوه بِوزْرٍ ليس وازَرهُ","فَتُشْعِلوا في الصدور الحِقد والغضبا",83,"ب",2,0],["لا تأسَفَنَّ على الحياة؛ فإنها","كانتْ -ومازالتْ- مجالَ نفاق",84,"ق",1,0],["لا تأمنوا المستعمرين؛ فكم لهم","حربٌ تَقنَّع وجهُها بسلام",85,"م",1,0],["لا تأمن الدهر الصروف فإنه","لا زال قدماً للرحال يهذب",86,"ب",1,0],["لا تأمننَّ من النساء ولو أخاً","ما في الرِّجالِ على النِّساءِ أَمِيْنُ",87,"ن",1,1],["لا تأسَ إنْ غفل النديمُ فلم يُدرِ","كأساً فعند جفونه تَعويضه",88,"ض",2,0],["لا تأمننّ من الدّهورِ تغيُّراً،","حتّى تكونُ ظباؤها كذئابها",89,"ب",3,0],["لا تأمني بأس الأعراب إنّهم","كادت تفارق بيضهم أغمادها",90,"د",3,0],["لا تأبهي لي.. إنني بركن ٍ","ملءَ ثيابي لؤلؤٌ مُشِعُّ..",91,"ع",1,0],["لاَ تأمننَّ تميميّاً على جسدٍ","قدْ ماتَ ما لمْ ترازيلْ أعظمُ الجسدِ",92,"د",1,0],["لا تأسينّ على ما كان من مرضٍ","فربَّ جسم بداءٍ قد عرا صلحا",93,"ح",2,1],["لأ تأمنَنّى على مراجعةٍ","مَن دبَّر الحبَّ قبلَنا بحِجَا",94,"ج",2,0],["لا تَأمَنوا رَبَّ الجُيوشِ إِذا غَزَت","فَلَها بِهاماتِ الرِجالِ قُفولُ",95,"ل",1,0],["لا تَأمَنُ الأَموالُ بَطشَ هِباتِهِ","هَل يَأمَنُ المَصروفُ بَطشَ الوالي",96,"ل",2,0],["لا تأخذنك رأفة أو رحمة","فيمن له بعدو ربك علقة",97,"ه",1,1],["لا تأسفنّ فلستَ أول من رجا","ربحاً ففوت رأسَ مال يرقبُ",98,"ب",1,0],["لا تأسفنَّ فما يفوت وسعدَكم","سعدٌ له جندُ السعودِ تجنّدُ",99,"د",1,0],["لا تأخذنَّك وحشةٌ مما جرى","هذا الزمانُ ولا يهولك ما ترى",100,"ر",2,1],["لا تأسفن عليهم إن هزمتهم","أشد من قتلهم حزنا وتسخيفا