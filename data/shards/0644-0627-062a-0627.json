","حكم الخطا والفعل فيه حاب",132,"ب",1,0],["لا تأسفوا مهما حزنتم للألى","ذهبوا الضحايا في القناة حرائر",133,"ر",1,0],["لا تأتلي تحفِرُ عن كنزٍ لها","تُنفِقُ منه عاجلا وتَقتَني",134,"ي",1,0],["لا تأخذِ الدهرَ بزلاَّتهِ","وسَعْهُ بالعفو وبالإعتمادْ",135,"د",1,0],["لا تأخذِ النَّفْرَ بتفريقنا","فربّما عاد لنا موعِدا",136,"د",2,0],["لا تَأمَني الصَرمَ مِنّي أَن تَري كَلَفي","وَإِن مَضى لِصَفاءِ الوُدِّ أَعصارُ",137,"ر",1,1],["لا تأوِيَنَّ لِحَزميٍّ رَأَيتَ بِهِ","ضُرّاً وَلَو طُرِحَ الحَزميُّ في النارِ",138,"ر",1,0],["لا تأمن البازل الكوماء عدوته","ولا الأمون إذا ما اخروط السفر",139,"ر",1,0],["لا تأس إن هلكت قريظة فاتبع","آثارها بالنابح العَضاض",140,"ض",1,0],["لا تأمنن أبا الرذائل بعدها","واحذر أمانة سارق خطاف",141,"ف",1,0],["لا تَأخُذَنهُ فيه لومةٌ لائمٍ","وكذلك الإيمانُ والإسلامُ",142,"م",1,0],["لا تأمَنِي لأصابِعِي فأنا","أدري بأنَّ أصابِعي حَمْقَى",143,"ق",2,0],["لا تَأمنُ الأعداءُ منِّي نَجدَةً","ظَفَري بهمْ يلقاهُمُ بأماني",144,"ي",1,0],["لا تأمُلَنْ زمناً يؤلّف وِردُهُ","بين الأسودِ الشُّوسِ والسِّرْحانِ",144,"ن",1,0],["لا تَأمنوا اللّيثَ على إطْراقِهِ","قد يعزم اللّيثُ إذا ما أرزما",145,"م",2,0],["لا تأنسنّ بلين الصّعبِ في كَلَفٍ","فاللّيثُ يصبو ويعلو منكِبَ البَطَلِ",146,"ل",1,0],["لا تألفُ الرِّيبةُ أبوابَه","ولا خلا في سيّئٍ إنْ خلا",147,"ل",2,0],["لا تألمنَّ بنافعٍ لك دهرَه","يُعطي المرادَ ولا تُجَوِّر أعدلا",148,"ل",2,0],["لا تأمننَّ صروفَ الدهر مُغمِضَةً","إغماضَ ليثٍ من الأرواح مُمتارِ",149,"ر",1,0],["لا تَأمَنوا غضّ النّوا","ظِرِ مِن قلوبٍ مُرصِداتِ",150,"ت",1,0],["لا تَأخُذا بِدَمي مَتى أُخِذَت","نَفسي سوايَ فَما له ذَنبُ",151,"ب",1,0],["لا تأخذُ الخلاقَ يا قومُ","في خلقه سنة ولا نومُ",152,"م",1,1],["لا تَأَمُلينَ في السُرى تَرويحي","وَإِن تَشَكَّيتِ أَذى القُروحِ",153,"ح",1,0],["لا تأمُلِ الخيرَ من ذي نعمةٍ حَدَثَت","فَهْوَ الحريصُ على أثوابهِ الجُدُدِ",154,"د",1,0],["لا تأْتِه وأَقِمْ يا مُعْتَفِيه تَجِدْ","جَدْواه تأْتِيكَ والدُّنْيا تُواتِيكا",155,"ك",2,0]]}