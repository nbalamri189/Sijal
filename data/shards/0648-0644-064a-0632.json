{"poems":[[88,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[37,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[53,"يا ابن حسان لا تشكن في دينى","https://www.aldiwan.net/poem66483.html","الخفيف"],[72,"على من لا أسميه السلام","https://www.aldiwan.net/poem42707.html","الوافر"],[107,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[77,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[108,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[108,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[92,"شكوى وآمال","https://www.poetsgate.com/ViewPoem.aspx?id=178932",""],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[203,"على الشمس من نسج الغمام ستور","https://www.aldiwan.net/poem45202.html","الطويل"],[255,"سقى الله أكناف الكنافة بالقطر","https://www.aldiwan.net/poem14973.html","الطويل"],[309,"ألا ليت شعري والفؤاد به ثأر","https://www.aldiwan.net/poem16805.html","الطويل"],[362,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[371,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[445,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[447,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[487,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[510,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145628","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79867","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79856","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76055","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76019","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58333","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201711","الخفيف"],[3091,"","https://poetry.dctabudhabi.ae/diwan/poem/141754","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103058","الوافر"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36549","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119672","الطويل"],[4239,"","https://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136594",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117234","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33344","الطويل"],[4726,"ايا جسر اهل الله يا مركز السعد","https://www.poetsgate.com/ViewPoem.aspx?id=146655",""],[4755,"أَهلِي.. وحَسبي أَنني عَنهُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183825",""],[5101,"بلفور عِد ما شئت","https://www.poetsgate.com/ViewPoem.aspx?id=193170",""],[5219,"الرجولة موقف","https://www.poetsgate.com/ViewPoem.aspx?id=193709",""],[5219,"تطريز اسم مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=193712",""],[5219,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=194937",""],[5274,"قهوة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=205058",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5351,"آخر الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202029",""],[5526,"لا تامن سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=194420",""],[5573,"جمة البير","https://www.poetsgate.com/ViewPoem.aspx?id=200345",""],[5818,"الحبّ بيتٌ بابه الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=199974",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5957,"لا وقت عندي","https://www.poetsgate.com/ViewPoem.aspx?id=180033",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[6125,"ولَّى زمانُك","https://www.poetsgate.com/ViewPoem.aspx?id=210712",""]],"verses":[["وَلّى زَمانُ المُعتَدينَ كَما اِنطَوَت","حِيَلُ الشُيوخِ وَإِمرَةُ الخِصيانِ",0,"ن",1,0],["وَلي زَفراتٌ لَو يَدُمنَ قَتَلنَنَي","تَوالي الَّتي تَأتي المُنى قَد تَوَلَّتِ",1,"ت",1,0],["وَلْيَزْهَرِ الْفَرْقَدُ الْبَاقِي إِذَا حَجَبَتْ","رَفِيقَهُ غَمَرَاتُ الْغَيْبِ وَالسُّدُمُ",2,"م",1,0],["وَليزَعك المشيبُ عن بعض ما تفْ","عَلُ أو وجهك المشوه المَشين",3,"ن",1,0],["وَلي زَمَنٌ أُكاتِمُهُ هَواهُ","وَقَلبي فيهِ صَبُّ مُستَهامُ",4,"م",1,0],["وَلَّى زَمانُكَ يا صريعَ هُمومهِ","فَاسألهُ هل وَلَّى زَمانُ عَنائِه",5,"ا",3,0],["ولي زَفَراتٌ تُذيبُ المَطِيّ","وقلْبٌ يَسُدُّ عليّ الفَلا",6,"ا",1,0],["وَلْيَزنْ صَدْركَ الرَّحيب وَسَامٌ","بَاتَ فيه وَقَدْرُهُ في ازْدياد",7,"د",1,0],["ولَّى زمانُ القول يُسْبَك عسجدًا","ما المجدُ في قول يُقالُ منمَّقَا",8,"ق",2,0],["ولَّى زمانُ القيصريَّ","ة والقياصرة العظام",9,"م",1,0],["ولي زفرة لا يوسع القلب ردها","وكيف وتيار الأسى يتدفع",10,"ع",1,0],["وَليَزِد أَمرُكَ المُطاعُ نَفَاذاً","وَليَزِد كَيدُ شانِئيكَ نَفادا",11,"د",2,0],["ولي زفراتٌ لو تجسمَ حرُّها","لأصبحَ شمساً في الفضاءِ تنيرُ",12,"ر",1,0],["ولي زوجة إن تَشتَهي قاهريَّةً","أقول لها ما القاهريَّةُ في مِصرِ",13,"ر",1,0],["ولي زفرة تعلو متى ما ذكرتهم","وكم بي من فرط الصبابة آثار",14,"ر",1,0],["وَلِي زُغبٌ كَزُغب الطَّيرِ فُلّت","بِهِنّ شَباةُ حَدِّي واعتِزَامِي",15,"م",2,0],["ولْيَزِدْ عَودُه على البَدْءِ نُوراً","مثْلما بعْدَ غُرّةِ الشّهْرِ دُرْعه",16,"ع",2,0],["وَلي زَفَراتٌ نَمنَمَ الخَدَّ دَمعُها","وَنَمَّت بِأَسرارِ الحَشا وَالحَيازِمِ",17,"م",1,0],["ولَيُزْهَيَنَّ عَلَى الغمامِ نَفاسَةً","مَن صادَ مِثْلي فِي حَبائِلِ عُرْفِهِ",18,"ف",2,0],["ولي زفرة في إثر أخرى تصعدت","تكاد بروحي للخياشيم تصعد",19,"د",1,0],["ولي زفرات بالغرام تأججت","لها في فؤادي نار قلبي الذائب",20,"ب",1,0],["ولي زفرات أبلت الكون جهرة","إذا برزت ضاق الفضاء للوعتي",21,"ي",1,0],["ولّى زمانُ الصّبا واحدودبَ الجسدُ","والقلبُ من نبضهِ حلٌ ومُنسرِقُ",22,"ق",1,0],["وَلَّى زَمَانُ الغَسَقِ","يَا يَمَنَ الطُّهْرِ النَّقِي",23,"ق",2,0],["وَلِي زَفْرَةٌ لَوْلاَ دَوَامُ الْتِظَائِهَا","لَقُلْتُ وَمِيضُ الْبَرْقِ لِلْمُتَوَقِّدِ",24,"د",1,0],["وليزهُ فيه مصطفى المجد الذي","بغير أبكار المعالي ما افتنن",25,"ن",1,0],["وليزه في عبد العزيز فلقد","زها به جميع ما ضمَّ الفضا",26,"ض",2,0],["وليزوّد ربع المكارم زهواً","إنَّكم تعمرون منه الديارا",27,"ر",2,0],["وَلي زَمَنٌ لَم أُبصِرَ السيِّدَ الَّذي","إِذا لَم نَزُرهُ زارَنا مِنهُ نائِلُه",28,"ل",2,0],["وَلي زَمَنٌ أَهواهُ وَالقَلبُ كاتِمٌ","فَهَل هُوَ يَدري أَنَّني فيهِ عاشِقُ",29,"ق",1,0],["وَلي زمناً يا نور لم أركم به","وَغَايةُ بُرء العين أَنْ تُبصِرَ النّورا",30,"ر",2,0],["وليزيدوا تعالياً فعساني","أتدانى للمحهم من سمائي",31,"ي",1,0],["وليزيدوا تطاولاً عَلَّ رجلي","تتدانى لصفعهم بحذائي",31,"ي",1,0],["ولى زماني وانقضت أوقاته","وذهابه من جملة الأشراط",32,"ط",1,0],["وَليزهُ ذو جَهلٍ بما أَملت لَهُ","فَاليَوم حَظ السافل العلياء",33,"ا",2,0],["ولي زمن بذي سلم تقضّى","على أيام ذي سلم سلامي",34,"م",2,0],["وَلّى زَمَنُ الصِبا وَلا زورَةَ طيف","فاِعتضتُ شَبيبَةً حَكَت مزنةَ صَيف",35,"ف",1,1],["ولي زفرة من حرّها أوقدت لظى","ولي مدفع من سفحه السفح سائل",36,"ل",1,0],["وليزن الكلام عند المرضى","وليتخذ ذاك عليه فرضا",37,"ض",2,0],["ولي زفرةٌ بين الضُلوع أجنُّها","برغمي وعلمي انني لا أطيقُها",38,"ق",3,0],["ولى زمان شبابه عنه وما","بلّت بماء شئونه أردانهُ",39,"ن",2,0],["ولي زفرةٌ أذكى من النارِ حالفَت","أوائلَ شوقٍ ما لهنَّ أواخِرُ",40,"ر",1,0],["ولي زفرات من فؤاد تضرمت","به نار فقد دونها النار في الوقد",41,"د",1,0],["وَلَّى زَمانُ الجَهلِ, وانْجَابَ عَن","كُلِّ العيونِ الواقِعُ المُبهَمُ",42,"م",1,0],["ولّى زمانُ الخوفِ فاسمعْ وعدنا","واكتب بِخَطِّ الدّهرِ إني القائلُ",43,"ل",1,0],["ولى زمان للمروءة وامحت","تلك الشمائل عهدها ينسانا",44,"ن",2,0],["ولى زمان وما في القوس من وتر","حتى القصائد ما أجزت قوافيها",45,"ي",3,0],["ولى زمان الهوى يا صاح ليس له","سوى الأماني فشد العزم وارتحلا",46,"ل",2,0],["ولَّى زمَانُ الصِبَا يَا هنْدُ قلتُ لهَا","ما عادَ في القلبِ لا لَهْوٌ ولا لَعِبُ",47,"ب",1,0],["ولى زمان أذل الشعبَ جَوْرُكُمُ","فيه احتقارا، فأدنى دائه الجزعُ",48,"ع",1,0],["ولى زمان تركتم فيه أمتنا","أرضا تمزقها  بالفتنة - الشيعُ",48,"ع",1,0],["وليزدهي ضجر الأنين بسر منْ","أخذ المساء يقولها ويقولني",49,"ن",2,0],["ولّى زمان رجال عاشوا حلاحيل","واليوم حتى رمش عينك يخونك",50,"ك",1,0],["ولى زمان الثار مع سالم الزير","روح يجر الهم والهم جره",51,"ر",2,0],["ولّى زمان الرِقِّ والنخّاس","ولّى ولكنْ للكلام قياس",52,"س",1,0],["وَلِيْ زفرةٌ قد هدهدتْ كلَّ مُكْتَوٍ","بنار غرامٍ فالمحاجرُ ذُرَّفُ",53,"ف",1,0],["ولى زمان الحب يا نغما","لا تروَ أرضيَ بالخطيئاتِ",54,"ت",1,0],["ولَّى زمانُ الجائرينَ بظلمهِ","وأَتى زَمانٌ غائِرٌ بدماكِ",55,"ك",1,0],["ولَّى زمانك أم قد خانك الأثرُ","وبت يا صاح في الأحزان تعتصرُ",56,"ر",1,1]]}