{"poems":[[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[35,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[51,"يا ابن حسان لا تشكن في دينى","https://www.aldiwan.net/poem66483.html","الخفيف"],[70,"على من لا أسميه السلام","https://www.aldiwan.net/poem42707.html","الوافر"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[90,"شكوى وآمال","https://www.poetsgate.com/ViewPoem.aspx?id=178932",""],[141,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[197,"على الشمس من نسج الغمام ستور","https://www.aldiwan.net/poem45202.html","الطويل"],[248,"سقى الله أكناف الكنافة بالقطر","https://www.aldiwan.net/poem14973.html","الطويل"],[302,"ألا ليت شعري والفؤاد به ثأر","https://www.aldiwan.net/poem16805.html","الطويل"],[355,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[362,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[364,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[436,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[438,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[480,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[480,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[503,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"]],"verses":[["وَلّى زَمانُ المُعتَدينَ كَما اِنطَوَت","حِيَلُ الشُيوخِ وَإِمرَةُ الخِصيانِ",0,"ن",1,0],["وَلي زَفراتٌ لَو يَدُمنَ قَتَلنَنَي","تَوالي الَّتي تَأتي المُنى قَد تَوَلَّتِ",1,"ت",1,0],["وَلْيَزْهَرِ الْفَرْقَدُ الْبَاقِي إِذَا حَجَبَتْ","رَفِيقَهُ غَمَرَاتُ الْغَيْبِ وَالسُّدُمُ",2,"م",1,0],["وَليزَعك المشيبُ عن بعض ما تفْ","عَلُ أو وجهك المشوه المَشين",3,"ن",1,0],["وَلي زَمَنٌ أُكاتِمُهُ هَواهُ","وَقَلبي فيهِ صَبُّ مُستَهامُ",4,"م",1,0],["وَلَّى زَمانُكَ يا صريعَ هُمومهِ","فَاسألهُ هل وَلَّى زَمانُ عَنائِه",5,"ا",3,0],["ولي زَفَراتٌ تُذيبُ المَطِيّ","وقلْبٌ يَسُدُّ عليّ الفَلا",6,"ا",1,0],["وَلْيَزنْ صَدْركَ الرَّحيب وَسَامٌ","بَاتَ فيه وَقَدْرُهُ في ازْدياد",7,"د",1,0],["ولَّى زمانُ القول يُسْبَك عسجدًا","ما المجدُ في قول يُقالُ منمَّقَا",8,"ق",2,0],["ولَّى زمانُ القيصريَّ","ة والقياصرة العظام",9,"م",1,0],["ولي زفرة لا يوسع القلب ردها","وكيف وتيار الأسى يتدفع",10,"ع",1,0],["وَليَزِد أَمرُكَ المُطاعُ نَفَاذاً","وَليَزِد كَيدُ شانِئيكَ نَفادا",11,"د",2,0],["ولي زفراتٌ لو تجسمَ حرُّها","لأصبحَ شمساً في الفضاءِ تنيرُ",12,"ر",1,0],["ولي زوجة إن تَشتَهي قاهريَّةً","أقول لها ما القاهريَّةُ في مِصرِ",13,"ر",1,0],["ولي زفرة تعلو متى ما ذكرتهم","وكم بي من فرط الصبابة آثار",14,"ر",1,0],["وَلِي زُغبٌ كَزُغب الطَّيرِ فُلّت","بِهِنّ شَباةُ حَدِّي واعتِزَامِي",15,"م",2,0],["ولْيَزِدْ عَودُه على البَدْءِ نُوراً","مثْلما بعْدَ غُرّةِ الشّهْرِ دُرْعه",16,"ع",2,0],["وَلي زَفَراتٌ نَمنَمَ الخَدَّ دَمعُها","وَنَمَّت بِأَسرارِ الحَشا وَالحَيازِمِ",17,"م",1,0],["ولَيُزْهَيَنَّ عَلَى الغمامِ نَفاسَةً","مَن صادَ مِثْلي فِي حَبائِلِ عُرْفِهِ",18,"ف",2,0],["ولي زفرة في إثر أخرى تصعدت","تكاد بروحي للخياشيم تصعد",19,"د",1,0],["ولي زفرات بالغرام تأججت","لها في فؤادي نار قلبي الذائب",20,"ب",1,0],["ولي زفرات أبلت الكون جهرة","إذا برزت ضاق الفضاء للوعتي",21,"ي",1,0],["ولّى زمانُ الصّبا واحدودبَ الجسدُ","والقلبُ من نبضهِ حلٌ ومُنسرِقُ",22,"ق",1,0]]}