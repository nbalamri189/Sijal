{"poems":[[57,"يا أبا الفضل يا كريم التصافي","https://www.aldiwan.net/poem26235.html","الخفيف"],[57,"فوز ماذا عليك أن تؤنسيني","https://www.aldiwan.net/poem26432.html","الخفيف"],[90,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[48,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54255","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[280,"ما بسيط الحياة إلا وجيز","https://www.aldiwan.net/poem25401.html","الخفيف"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[371,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[382,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[435,"بشراكم يا آلنا بكرامة","https://www.aldiwan.net/poem41003.html","الكامل"],[445,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[463,"للنقص من أعمارنا ما يكمل","https://www.aldiwan.net/poem56077.html","الكامل"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138402",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138375",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138339",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87267","المتدارك"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120073","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56174","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112832","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46984","الكامل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32721","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138698",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136938",""],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21523","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58170","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33581","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67485","الرمل"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[4767,"تألق","https://www.poetsgate.com/ViewPoem.aspx?id=181189",""],[5046,"الشهيد فادي","https://www.poetsgate.com/ViewPoem.aspx?id=198117",""],[5121,"شِعْرُ العَرَب","https://www.poetsgate.com/ViewPoem.aspx?id=213482",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5425,"بَغداد .. حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=199911",""],[402,"ذلك كالرزء في الصديق الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=36332",""],[463,"هل عند ريح الصبا من رامة ٍ خبرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60060&r=&rc=116",""]],"verses":[["فَوزُ وَاللَهِ ما مَلِلتُ وَلا كُن","تُ لِقَومٍ سِواكُمُ بِالمُصافي",0,"ف",2,0],["فَوزُ ماذا عَلَيكِ أَن تُؤنِسيني","بِحِقابٍ أَو خاتَمٍ أَو وِشاحِ",1,"ح",1,1],["فوزير القوم لا يعْ","مل من غير اشاره",2,"ر",2,0],["فَوَزَّ الرَكبُ يَبتَغونَ صَلاحاً","مِن حِمامٍ وَالفَوزُ لِلفَوّازِ",3,"ز",1,0],["فوزيرُ العَصرِ وَكاتِبُه","ومرسِّلُه ومُقَصِّدهُ",4,"د",2,0],["فوزيةً بنتَ المُلو","كِ الصِّيدِ والغُرِّ السَّراة",5,"ه",1,0],["فوزيةٌ دُرَةُ التاجِ التي لمعتْ","فوقَ الجبينِ فحيَّتْه وحيَاها",6,"ا",3,0],["فوزَ يدٍ عانقت الخرائدا","في جنَّة ٍ يُضحي جَناها مائدا",7,"د",2,0],["فوّزَ المتقون حقا وفازوا","وتخطّاك الفوز والتفويز",8,"ز",1,0],["فوزع على الاوقات شغلك دائما","بتذكرة الاجرا صباحا لقضيان",9,"ن",1,0],["فوزع لاحوال الحياة سفينة","بترتيب أيام السنين لاشحان",9,"ن",1,0],["فَوَزنُ هَواهُ الآنَ في عَيني","كَما طارَ في ساقي الرِياحِ تُرابُ",10,"ب",1,0],["فوزناتك اللاتي ربحتَ عدادَها","تبشِّرُنا في كل خيرٍ مساعد",11,"د",1,0],["فوزوا بميراث النعيم ومجده","بشهادة الحبر التقي ارميا",12,"ي",2,0],["فوزاً بأسنى القِسمِ من مَلِكٍ حَوى","من صِدْقِ سَعيِكَ أجزَلَ الأقْسامِ",13,"م",1,0],["فوْزاً له إذ كان قبلك يومُهُ","كم موتةٍ هي من حياةٍ أفضلُ",14,"ل",1,0],["فوَّزَ في البيدِ لا ظلٌّ يَفيء له","ظُهْراً ولا يتّقيه من ندىً سَحَرُ",15,"ر",1,0],["فوزا مبينا ملا أرواحنا فرحا","فيه الرياض وباقي الارض سيان",16,"ن",1,0],["فوزارة الاشغال ادركت المنى","اذ أحرزت ما تبتغي وتروم",17,"م",1,0],["فوزان أنت ولست فوزاً واحدا","والفوز كان لكل عزم صادق",18,"ق",1,0],["فوزي برضاه وَاِنتَظِري","إِحسانَ الصَدر المحتشمِ",19,"م",1,0],["فوز قدحي من أبي الفض","ل المرجى بامتداحي",20,"ح",2,0],["فوزوا بشرب الشهد من","هذا السبيل الرايقِ",21,"ق",1,1],["فوز المرجى غوث امته وخير","مبرة جاد الكريم بها",22,"ه",2,0],["فَوزان هَذَا النَّفيُ مَا قَد قُلتُهُ","حَرفا بِحَرفٍ أنتُمَا صِنوَانِ",23,"ن",1,0],["فُوزُوا بِسَبْقِكُمُ وَفُوهُوا بِالذِي","حَمَّلْتُكُمْ شَوْقاً إِلَى المُخْتَارِ",24,"ر",1,0],["فَوَزيرٌ شَنِجُ الوَج","هِ بَطينٌ كَالغَرارَه",25,"ر",2,0],["فوزعت البيض اشلائه","وسمر الرماح نهبن الفؤاد",26,"د",1,0],["فوزي أبعدك من أصاحبه","حراً له اخلاقك الغر",27,"ر",1,0],["فوزي فجعت الشعر فانصدعت","اصلابه وتعذر الجبر",27,"ر",1,0],["فوزي وانت الان في ملأ","متموج في افقه الشعر",27,"ر",1,0],["فوزي سلاماً كلما خفقت","مني الضلوع وهاجني الذكر",27,"ر",1,0],["فَوَزَّعَني بَعدَ الجَهالةِ والصِبا","عَنِ الجَهلِ عَهدٌ بالشَبيبَةِ قَد ذَهَب",28,"ب",1,0],["فوزاً لهمْ إذْ أدخلوا جنَّاتِهم","بيضُ الوجوهِ بمَوْقِفِ الرَّيَّانِ",29,"ن",1,0],["فَوَزَفرَةٍ فيه بجسمي مِثلُها","ما زلتُ من نظري إليهِ سَقيما",30,"م",2,0],["فوزير شنج الوج","ه بطيم كالغراره",31,"ر",2,0],["فوزان ففوز بالمقام ومثله","بعظيم شأن فضله لا ينكر",32,"ر",1,0],["فوزاً عظيماً مستمراً واصعدي","طودَ العلا بالارتقاء وحلقي",33,"ق",2,0],["فوزٌ برفعِ القدس رغم أنوفِهم","وشهادةٍ هي أحسنُ الأمرين",34,"ن",1,0],["فَوَزْنُ الحُرُوفِ جَوَاهِرُ كَنْزٍ","وَبَعْضُ التَّعَابِيرِ لَمْ تُحْتَسَبْ",35,"ب",1,0],["\" فَوزُ\" القَصِيدَةِ ، مُنتَهَى أَبيَاتِهَا","وأَمِيرَةُ البَحرِ البَسِيطِ بِفَائِهَا",36,"ا",3,0],["فُوزِيْ بِدِجْلَةِ والصَوبَيْنِ كُلِّهِمَا","وَاسْتَأْثِرِيْ بِنِسَاءِ الكَونِ إِلَّاهَا",37,"ا",3,0],["فوزيرا به الوزارة تزهى","فوليا للعلم والتعليم",38,"م",1,0],["فوزَ في البيدِ لا ظلٌّ يفء له","ظهراً ولا يتقيه من ندى سحرُ",39,"ر",1,0]]}