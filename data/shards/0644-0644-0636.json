{"poems":[[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[69,"إن لمت حظي فلا تلمني","https://www.aldiwan.net/poem28967.html","مخلع البسيط"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[94,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[288,"بكرت لتحزن عاشقاً طفل","https://www.aldiwan.net/poem1914.html","أحذ الكامل"],[339,"للضيف أن يقرى ويعرف حقه","https://www.aldiwan.net/poem68815.html","الكامل"],[407,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"]],"verses":[["لِلضَّادِ عَصْرٌ بِالنُّثُورِ مُبَشِّرٌ","إِنْ تَتحِدْ شَتَّى القُوَى وَتُنَظَّمِ",0,"م",1,0],["للضَّبابِ المورّد المتلاشي","كخيالاتِ حالمٍ مفتونِ",1,"ن",1,0],["للضدِّ رزقٌ بلا حسابٍ","ولي حسابٌ بغيرِ رزقِ",2,"ق",1,0],["لِلضَيفِ ثُمَّ الضَيفِ بَع","دَ الضَيفِ وَالبُسُطِ السَلاطِح",3,"ح",1,0],["للضاد شاد اليسوعيُّون مكتبةً","لم تحوها زمن المأمون بغْدان؟",4,"ن",1,0],["للضاد في مصرَ بل في الشرق أجمعِهِ","حصْنٌ بَنُوها له: أسٌّ، وأركان",4,"ن",1,0],["للضّاد ترجع أنساب مفرّقة","فالضاد بحلق غريب الدار مغتصب",5,"ب",1,0],["لِلضَيفِ وَالجارِ الغَريبِ وَلِل","طِفلِ التَريكِ كَأَنَّهُ رَألُ",6,"ل",1,0],["لِلضَيفِ أَن يُقرى وَيُعرَفَ حَقُّهُ","وَالشَيبُ ضَيفُكَ فَاِقرِهِ بِخِضابِ",7,"ب",1,1],["للضَوءِ أَرساغه إِلّا حَوافِره","فَأَنَّهُنَ مَع الجِلبابِ لِلظُّلَمِ",8,"م",1,0]]}