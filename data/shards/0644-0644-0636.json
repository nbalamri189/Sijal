{"poems":[[95,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[71,"إن لمت حظي فلا تلمني","https://www.aldiwan.net/poem28967.html","مخلع البسيط"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[108,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[96,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[292,"بكرت لتحزن عاشقاً طفل","https://www.aldiwan.net/poem1914.html","أحذ الكامل"],[343,"للضيف أن يقرى ويعرف حقه","https://www.aldiwan.net/poem68815.html","الكامل"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198606","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87273","المجتث"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70807","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62462","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79812","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100207","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216539",""],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77716","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91699","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132139","الكامل"],[4767,"الذكر الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179785",""],[4899,"سينيه وصاديه","https://www.poetsgate.com/ViewPoem.aspx?id=177050",""],[5002,"لغة الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=202661",""],[402,"عد لابسا ثوب الخلود وعلم","https://www.poetsgate.com/ViewPoem.aspx?id=36321",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""]],"verses":[["لِلضَّادِ عَصْرٌ بِالنُّثُورِ مُبَشِّرٌ","إِنْ تَتحِدْ شَتَّى القُوَى وَتُنَظَّمِ",0,"م",1,0],["للضَّبابِ المورّد المتلاشي","كخيالاتِ حالمٍ مفتونِ",1,"ن",1,0],["للضدِّ رزقٌ بلا حسابٍ","ولي حسابٌ بغيرِ رزقِ",2,"ق",1,0],["لِلضَيفِ ثُمَّ الضَيفِ بَع","دَ الضَيفِ وَالبُسُطِ السَلاطِح",3,"ح",1,0],["للضاد شاد اليسوعيُّون مكتبةً","لم تحوها زمن المأمون بغْدان؟",4,"ن",1,0],["للضاد في مصرَ بل في الشرق أجمعِهِ","حصْنٌ بَنُوها له: أسٌّ، وأركان",4,"ن",1,0],["للضّاد ترجع أنساب مفرّقة","فالضاد بحلق غريب الدار مغتصب",5,"ب",1,0],["لِلضَيفِ وَالجارِ الغَريبِ وَلِل","طِفلِ التَريكِ كَأَنَّهُ رَألُ",6,"ل",1,0],["لِلضَيفِ أَن يُقرى وَيُعرَفَ حَقُّهُ","وَالشَيبُ ضَيفُكَ فَاِقرِهِ بِخِضابِ",7,"ب",1,1],["للضَوءِ أَرساغه إِلّا حَوافِره","فَأَنَّهُنَ مَع الجِلبابِ لِلظُّلَمِ",8,"م",1,0],["للضيفِ دارٌ وللأيتامِ منزلةٌ","تبني المعاليَ والأمجَادَ تنتخِبُ",9,"ب",1,0],["لِلضدّ يَوم الغبارِ","لُهَ جُيوشٌ شَديدهْ",10,"ه",1,0],["للضيف ضيق لديهم","وذلةٌ وصَغار",11,"ر",1,0],["للضيف مما أنضجَتْهُ","وللقلوب الاستِعارْ",12,"ر",1,0],["للضيم في حسب الأبيّ جِراحةٌ","هيهاتَ يبلغ قعرَها المِسبارُ",13,"ر",1,0],["للضيم أصبحت وشالَت ضُحًى","نَعامةُ العزِّ بذاك الإِبا",14,"ب",2,0],["للضاد شرطٌ لا يكون لغيره","فاسمعه فيه العون للأملاء",15,"ا",2,0],["للضه ليلتنا بوجرة بعد ما","حل الربيع مرابع البطحاء",16,"ا",2,0],["للضيف أهلاً وْ سَهلاً وِاقْرَبْ","مِنْ زودهم ما يْطيح لِهْ يال",17,"ل",1,0],["للضيفِ فيه حكمُهُ","منهمْ ويُولونَ المزيدا",18,"د",2,0],["للضم قدّاً حوى كغصن","للَّثمِ خدّاً حَوى كَزَهر",19,"ر",1,0],["للضاد فيك وللشآم عصابة","هي من أشعَّة ذلك النبراس",20,"س",1,0],["للضياء الذي أبى الله لما","ناوئته الدجى سوى أن يدوما",21,"م",2,0],["للضرب مجموع ناتجها فراديه","لا هي بلا مكتبيه او اثاثيه",22,"ث",3,0],["للضَّادِ روْنقُهُ تلألَأ في السَّمَا","ولُه جواهِرُه تفيضُ تكَلُّما",23,"م",2,1],["للضاد عصر بالنشور مبشر","إن تتحد شتى القوى وتنظم",24,"م",1,0],["23. للضادِ حسنٌ كالسماءِ وجِدَّةٌ","تفنى الدُّهورُ وتبقيانِ شبابا",25,"ب",2,0],["للضَّادِ سِرٌّ تَهَابُ النَّاسُ تَنطِقُهُ","جَناحُ كِبرٍ وَ فوقَ الريحِ ما مُهِضَا",26,"ض",2,0]]}