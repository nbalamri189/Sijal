{"poems":[[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"يمشي الزمان بمن ترقب حاجة","https://www.aldiwan.net/poem8796.html","عموديه"],[91,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[85,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[43,"سر حل حيث تحله النوار","https://www.aldiwan.net/poem9562.html","الكامل"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[49,"وإذا صفى ودي له","https://www.aldiwan.net/poem64190.html","مجزوء الكامل"],[66,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[66,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[80,"سلم الأمر منك لله واعلم","https://www.aldiwan.net/poem31257.html","الخفيف"],[69,"في حشيش قد ترقى","https://www.aldiwan.net/poem28894.html","مجزوء الرمل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85639","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117015","الرمل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117004","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[45,"لا جَديدُ الصِّبَا، وَلاَ رَيَعَانُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31846",""],[91,"الإله الثرثار","https://www.poetsgate.com/ViewPoem.aspx?id=53349",""],[109,"أيها الفاسي أتى ريحك","https://www.aldiwan.net/poem2369.html","مجزوء الرمل"],[126,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[140,"قد حصلنا من الماش كما قي","https://www.aldiwan.net/poem58431.html","البسيط"],[219,"بعد أن طال في هواه صدودي","https://www.aldiwan.net/poem55280.html","الخفيف"],[221,"هذه القصة لا شأن لها","https://www.aldiwan.net/poem41916.html","الرمل"],[227,"لو تقصيت وصف شوقي وتوقي","https://www.aldiwan.net/poem50809.html","الخفيف"],[227,"يا دهر ما أقساك من متلون","https://www.aldiwan.net/poem50949.html","الكامل"],[227,"ليس بعد الديار منا وإن شط","https://www.aldiwan.net/poem51015.html","الخفيف"],[245,"إن كنت عاذلتي فسيري","https://www.aldiwan.net/poem1933.html","مجزوء الكامل"],[248,"زمن الغضا في القلب بعدك لوعة","https://www.aldiwan.net/poem14991.html","الكامل"],[250,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[273,"جار من أهوى على لب","https://www.aldiwan.net/poem25455.html","مجزوء الرمل"],[273,"طلعت عليك مع المساء صباحا","https://www.aldiwan.net/poem25602.html","الكامل"],[336,"ليس شيء مما يدبره العاقل","https://www.aldiwan.net/poem68640.html","الوافر"],[346,"نفق الإكديش يا منتخب","https://www.aldiwan.net/poem19909.html","مجزوء الرمل"],[369,"قلت للخفض والخمول استقيما","https://www.aldiwan.net/poem57164.html","الخفيف"],[369,"علم الهوى أني عليها قادر","https://www.aldiwan.net/poem57409.html","الكامل"],[377,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[400,"قد رأينا ما دار في الريحان","https://www.aldiwan.net/poem33368.html","الخفيف"],[400,"آه من برق إليكم قد روى","https://www.aldiwan.net/poem33915.html","الرمل"],[406,"إن خان عهدك من توده","https://www.aldiwan.net/poem32602.html","مجزوء الكامل"],[413,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[429,"أتروم خلا في الوداد صدوقا","https://www.aldiwan.net/poem12679.html","الكامل"],[450,"لي حبيب حسن الود","https://www.aldiwan.net/poem13625.html","مجزوء الرمل"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[540,"صل من هويت ودع مقالة حاسد","https://www.aldiwan.net/poem34051.html","الكامل"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[549,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[549,"لا توعدني الشر ترهبني","https://www.aldiwan.net/poem47817.html","أحذ الكامل"],[549,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[556,"هو صبغة العدم الذي هو كلنا","https://www.aldiwan.net/poem33850.html","الكامل"]],"verses":[["وَإِذا صَحَوتُ فَما أُقَصِّرُ عَن نَدىً","وَكَما عَلِمتِ شَمائِلي وَتَكَرُّمي",0,"م",2,0],["وَإِذا صَيحَةٌ عَلَت مِن فَتاةٍ","بَرَزَت مِن صُفوفِ ذاكَ الزِحامِ",1,"م",1,0],["وإذا صحَّ رأيُ ذي الرأي لم تن","ظر بعيني مَشُورةٍ عَوْراءِ",2,"ا",2,0],["وإذ اصْطَنَعْتَ صَنِيعةً وكتمتَها","وطَوَيْتَها فجديرةٌ أن تُمْصَحَا",3,"ح",2,0],["وإذا صوَّحتْ نتائجُ وعدٍ","قد ترامتْ به شهورُ المِطالِ",4,"ل",1,0],["وَإِذا صَباحُ أَخي الأَسى أَو لَيلُهُ","مُتَجَدِّدٌ مَعَ هَمِّهِ المُتَجَدِّدِ",5,"د",1,0],["وَإِذا صِرتَ غَيرَ شَخصِكَ في الءُ","خرى فَهَذا الفَنا الَّذي تَخشاهُ",6,"ا",2,0],["واذا صح العقا","ب فان الويل لك",7,"ك",1,0],["وَإِذا صَلَّيتَ خَف مَن تَعبُدُ","كَم مُصَلٍّ ضَجَّ مِنهُ المَسجِدُ",8,"د",1,0],["وَإِذا صَحِبتَ رَأى الوَفاءَ مُجَسَّماً","في بُردِكَ الأَصحابُ وَالخُلَطاءُ",9,"ا",2,0],["وَإِذا صُحِبتَ فَكُلُّ ماءٍ مَشرَبٌ","لَولا العِيالُ وَكُلُّ أَرضٍ دارُ",10,"ر",1,0],["وَإِذا صَحَّ فَالزَمانُ صَحيحٌ","وَإِذا اِعتَلَّ فَالزَمانُ عَليلُ",11,"ل",1,0],["وَإِذا صَحَّتِ الرَوِيَّةُ يَوماً","فَسَواءٌ ظَنُّ إِمرِئٍ وَعِيانُه",12,"ن",2,0],["وَإِذا صَفى وُدّي لَهُ","زادَت مَوَدَّتَهُ كُدورَه",13,"ر",2,1],["وَإِذا صارَ الجِدالُ جِلاداً","أَخمَدَ الحَربَ وَأَفنى الجِدالا",14,"ل",2,0],["وَإِذا صَبَّرَ القَناعَةَ دِرعاً","كانَ أَدعى إِلى بُلوغِ المُرادِ",15,"د",1,0],["وإذا صَحّ ذاكَ عندك فافْهَم","أنّ شُغْلَ الضّمير منك جنونُ",16,"ن",1,0],["وإذا صارَ رئيساً","فالخُصَى عضوٌ رئيسُ",17,"س",1,0],["وإذا صَحِبْتَ العيشَ أوّلُهُ","صَفْوٌ فَهَيْنٌ بعده كَدر",18,"ر",1,0],["وإذا صحَّ أن يكون قديماً","فهو في غنية عن الإيجاد",19,"د",1,0],["وإذا صادَفَتْ حَدوراً جَرَتْ فِي","هِ إراقَ الشّريبِ ماءَ الذَّنوب",20,"ب",1,0],["وَإِذَا صَلَّى فَفِي جِثْوَتِهِ","للْمُرَامَاةِ سُجُودٌ وَصَلاَةُ",21,"ه",1,0],["وَإِذا صَحَّ أَنَّ خمسَ مئٍ ما","يَلبَثُ المُصطَفى دَفيناً فَوَشكُ",22,"ك",1,0],["وإذا صاحَبتَ فاصحَب ماجداً","ذا حياءٍ وعفافٍ وكرَم",23,"م",1,1],["وإذا صنَعتَ صنيعةً أتمَمتها","بيَدين ليسَ نداهما بمُكَدَّر",24,"ر",1,0],["وإذا صفَّقَ الغديرُ انثنى الغُصْ","نُ نضيرَ الشبابِ في رَقَصاتهْ",25,"ت",2,0],["وإذا صدقتُ فللخلودِ مصايدٌ","أبداً تَلَقَّفُ من أتاه صائدا",26,"د",2,0],["وإذا صدقتُ فانَّ عينَ أبيكما","قد خَبَّرَتْ عن قلبِه الصدوع",27,"ع",1,0],["وإذا صدقتْ فانه بدَنٌ","لأطايب اللذاتِ مُخْتَبَر",28,"ر",1,0],["وإذا صَحّتِ الرّوِيّةُ يَوْماً،","فَسَوَاءٌ ظَنٌّ امرِىءٍ وَعِيَانُهْ",29,"ن",2,0],["وإذا صرت غير شخصك في الأ","خرى فهذا الفنا الذي تخشاه",30,"ا",2,0],["وَإِذا صَلّى رياء","كانَ فيها مثلَ أَبكَم",31,"م",1,0],["وإذا صاحبتَ فاصحبْ سيِّداً","صادقَ اللهجة ذا إن عَدَلْ",32,"ل",1,0],["وإذا صافاك خِلٌّ صافِه","بالوفاءِ المحضِ لا تبغِ البَدَلْ",32,"ل",1,0],["وإذا صحَّ لي هوى شرف الدي","ن تولَّى النعيمُ قتلَ البوسِ",33,"س",1,0],["وإذا صح ظنهم فلماذا","ما ارتقى للكمال باقي القرود",34,"د",1,0],["وإذا صح ما ادعوه فماذا","يصبح الناس بعد دهر بعيد",34,"د",1,0],["وَإِذا صَوتٌ تَعالى مُلحِناً","مِن بَعيدٍ مِثل أَوتارِ النَغَم",35,"م",1,0],["وإذا صَحّت الحقائقُ في الأَن","فسُ صحّ المُرادُ والاِعتِزام",36,"م",1,0],["وإذا صَفوْتَ كَدِرت شيمةَ باخِلٍ","وإذا وفَيتَ نَقَضْتَ أَسباب الوفا",37,"ف",2,0],["وإذا صحَّ مَعْقِدُ الحبِّ في الأَنْ","فُسِ واستأْنَسَتْ به الأَفكار",38,"ر",1,0],["وَإِذا صَحَوتُ فَإِنَّني","رَبُّ الشُوَيهَةِ وَالبَعيرِ",39,"ر",1,0],["وإذا صَبَوتُ لدارساتِ رُسومه","قال المعيد لدرسهِ هذا مَضَى",40,"ض",2,0],["واذا صَباً أَو شَمالٌ مالَت ضُحىً","بالغُصنِ مالَ بِه صِبّاً وَشَمولُ",41,"ل",1,0],["وَإِذا صُحِّفَ بَعْدَ ال","قَلْبِ لَمْ يَخْفَ مُعَمَّى",42,"م",2,0],["وإِذا صُراحُ المَدْحِ لاقَى رَبّها","لاقى لُبَاباً في المُلوكِ صُراحا",43,"ح",2,0],["وَإِذا صَيَّرَ البَعيدَ قَريباً","عادَ فيهِ فَاِزدادَ بُعداً قَريبُه",44,"ب",2,0],["وإذا صَلَّ لِجَامٌ لكَ في","رَأْسهِ هَزَّكَ مِنهُ الطَّرَبُ",45,"ب",1,0],["وإِذا صُرِّفَت بَنانُ بَنانٍ","في يَراعٍ فالصَّبر والتَّسليما",46,"م",2,0],["وإذا صَبرتُ على التَّصابي ردَّني","قلبٌ يُراوِحُني بِها ويُباكِرُ",47,"ر",1,0],["وَإِذا صَنَعت صَنيعة فَاِكتُم وَلا","تَمنن فَظَلَ المَنّ مَن يَحموم",48,"م",1,0],["وإذا صار للخدود ضجيجاً","مدفاه إلى ثغور الجمان",49,"ن",1,0],["وإذا صدقه ساءكم","فالذي عندي من العذر ظهر",50,"ر",1,0],["وإذا صرفتَ القلبَ فَهْ","وَ كأمسِ لا يُسطاعُ رَدُّهْ",51,"د",2,0],["وإذا صحوت ففي حديثك نشوتي","وإذا مَرِضتُ فأنت من يشفيني",52,"ن",2,0],["وإذا صديقُكَ لم يكنْ لك مُنصِفاً","فاجعلْ نكاحَ ودادِه التطْليقا",53,"ق",2,0],["وإِذا صُحِّفَ مقلوباً","فَحرْزُ الخلفاء",54,"ا",2,0],["وإِذا صُحِّفَ هذا","غير قلب باستواء",54,"ا",2,0],["وإذا صرتَ نصيبي منهُمُ","فقد استوفيتُ من دهري نصيبي",55,"ب",2,0],["وإذا صَفا لكَ من زمانِكَ واحِدٌ","فهو المُراد وعِش بذاكَ الواحدِ",56,"د",1,0],["وإذا صححتَ من الكُلومِ فدع بنا","مَن شئتَ مجروحاً بكلّ كِلامِ",57,"م",1,0],["وإذا صححتَ فإنّ قلبي مُقسِمٌ","أنْ لا يبالي في الورى بعليلِ",58,"ل",1,0],["وإذا صححتَ فكلُّ شيءٍ نافعي","وَإذا اِعْتلَلْتَ فَليسَ شيءٌ مُقنِعي",59,"ي",1,0],["وَإِذا صِينَ بالدُّروعِ جسومٌ","جعلَ الطّعنَ للجسومِ دُروعا",60,"ع",2,0],["وإذا صفا يومٌ ظفرتُ به","فلمن يعيش إلى غدٍ كدرُهْ",61,"ر",2,0],["وإذا صُددتُ عن المواردِ جمّةً","فمتى يكون وقد ظمئتُ ورودِي",62,"د",2,0],["وإذا صبغناه يكون ولم نكن","فتحققوا يا قوم هذا واعلموا",63,"م",3,0]]}