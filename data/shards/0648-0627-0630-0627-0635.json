ps://poetry.dctabudhabi.ae/diwan/poem/117940","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131259",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103016","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69962","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70155","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77003","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101369","الخفيف"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107297","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54395","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83670","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35125","الكامل"],[4755,"(قَرَضَ) البِلادَ، وأَهلَها الفُقراءَ","https://www.poetsgate.com/ViewPoem.aspx?id=214816",""],[5012,"فمان الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=24471",""],[5039,"على كثر القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=48129",""],[3591,"حيّا منازلنا الغزال الأمنع","https://www.poetsgate.com/ViewPoem.aspx?id=149381",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5206,"في علم الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187418",""],[2365,"أيها الطالب أجمل واقتصد","https://www.poetsgate.com/ViewPoem.aspx?id=200664",""],[5246,"يا نسيم الصبح هل أخبرتني","https://www.poetsgate.com/ViewPoem.aspx?id=187067",""],[5296,"لك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=154776",""],[5528,"قلب على مسرح الاحتضار","https://www.poetsgate.com/ViewPoem.aspx?id=201290",""],[5660,"أَوَ كُلُّ ذاكَ الهَجرُّ شَوقٌ لِلقَصائِد","https://www.poetsgate.com/ViewPoem.aspx?id=37021",""],[5725,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=186576",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[5943,"ويلاهُ يامسرى الرسول من الخنا","https://www.poetsgate.com/ViewPoem.aspx?id=45264",""],[6051,"بَانَتْ لِطِيَّتِها الغَداةَ جَنُوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=85169",""],[6056,"حكم المقاديري","https://www.poetsgate.com/ViewPoem.aspx?id=156705",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[433,"نومة الراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87053&r=&rc=6",""]],"verses":[["وَإِذا صَحَوتُ فَما أُقَصِّرُ عَن نَدىً","وَكَما عَلِمتِ شَمائِلي وَتَكَرُّمي",0,"م",2,0],["وَإِذا صَيحَةٌ عَلَت مِن فَتاةٍ","بَرَزَت مِن صُفوفِ ذاكَ الزِحامِ",1,"م",1,0],["وإذا صحَّ رأيُ ذي الرأي لم تن","ظر بعيني مَشُورةٍ عَوْراءِ",2,"ا",2,0],["وإذ اصْطَنَعْتَ صَنِيعةً وكتمتَها","وطَوَيْتَها فجديرةٌ أن تُمْصَحَا",3,"ح",2,0],["وإذا صوَّحتْ نتائجُ وعدٍ","قد ترامتْ به شهورُ المِطالِ",4,"ل",1,0],["وَإِذا صَباحُ أَخي الأَسى أَو لَيلُهُ","مُتَجَدِّدٌ مَعَ هَمِّهِ المُتَجَدِّدِ",5,"د",1,0],["وَإِذا صِرتَ غَيرَ شَخصِكَ في الءُ","خرى فَهَذا الفَنا الَّذي تَخشاهُ",6,"ا",2,0],["واذا صح العقا","ب فان الويل لك",7,"ك",1,0],["وَإِذا صَلَّيتَ خَف مَن تَعبُدُ","كَم مُصَلٍّ ضَجَّ مِنهُ المَسجِدُ",8,"د",1,0],["وَإِذا صَحِبتَ رَأى الوَفاءَ مُجَسَّماً","في بُردِكَ الأَصحابُ وَالخُلَطاءُ",9,"ا",2,0],["وَإِذا صُحِبتَ فَكُلُّ ماءٍ مَشرَبٌ","لَولا العِيالُ وَكُلُّ أَرضٍ دارُ",10,"ر",1,0],["وَإِذا صَحَّ فَالزَمانُ صَحيحٌ","وَإِذا اِعتَلَّ فَالزَمانُ عَليلُ",11,"ل",1,0],["وَإِذا صَحَّتِ الرَوِيَّةُ يَوماً","فَسَواءٌ ظَنُّ إِمرِئٍ وَعِيانُه",12,"ن",2,0],["وَإِذا صَفى وُدّي لَهُ","زادَت مَوَدَّتَهُ كُدورَه",13,"ر",2,1],["وَإِذا صارَ الجِدالُ جِلاداً","أَخمَدَ الحَربَ وَأَفنى الجِدالا",14,"ل",2,0],["وَإِذا صَبَّرَ القَناعَةَ دِرعاً","كانَ أَدعى إِلى بُلوغِ المُرادِ",15,"د",1,0],["وإذا صَحّ ذاكَ عندك فافْهَم","أنّ شُغْلَ الضّمير منك جنونُ",16,"ن",1,0],["وإذا صارَ رئيساً","فالخُصَى عضوٌ رئيسُ",17,"س",1,0],["وإذا صَحِبْتَ العيشَ أوّلُهُ","صَفْوٌ فَهَيْنٌ بعده كَدر",18,"ر",1,0],["وإذا صحَّ أن يكون قديماً","فهو في غنية عن الإيجاد",19,"د",1,0],["وإذا صادَفَتْ حَدوراً جَرَتْ فِي","هِ إراقَ الشّريبِ ماءَ الذَّنوب",20,"ب",1,0],["وَإِذَا صَلَّى فَفِي جِثْوَتِهِ","للْمُرَامَاةِ سُجُودٌ وَصَلاَةُ",21,"ه",1,0],["وَإِذا صَحَّ أَنَّ خمسَ مئٍ ما","يَلبَثُ المُصطَفى دَفيناً فَوَشكُ",22,"ك",1,0],["وإذا صاحَبتَ فاصحَب ماجداً","ذا حياءٍ وعفافٍ وكرَم",23,"م",1,1],["وإذا صنَعتَ صنيعةً أتمَمتها","بيَدين ليسَ نداهما بمُكَدَّر",24,"ر",1,0],["وإذا صفَّقَ الغديرُ انثنى الغُصْ","نُ نضيرَ الشبابِ في رَقَصاتهْ",25,"ت",2,0],["واذا صحت المحبة لم تح","فل برقص النعيم والانكاد",26,"د",1,0],["وإذا صاح جوعه في الحنايا","فرقات المنى بقيّة زاده",27,"د",2,0],["وإذا صارعت قوى العقل قلبا","عبقريا زادت قواه قواء",28,"ا",2,0],["وإذا صدقتُ فللخلودِ مصايدٌ","أبداً تَلَقَّفُ من أتاه صائدا",29,"د",2,0],["وإذا صدقتُ فانَّ عينَ أبيكما","قد خَبَّرَتْ عن قلبِه الصدوع",30,"ع",1,0],["وإذا صدقتْ فانه بدَنٌ","لأطايب اللذاتِ مُخْتَبَر",31,"ر",1,0],["وإذا صَحّتِ الرّوِيّةُ يَوْماً،","فَسَوَاءٌ ظَنٌّ امرِىءٍ وَعِيَانُهْ",32,"ن",2,0],["وإذا صرت غير شخصك في الأ","خرى فهذا الفنا الذي تخشاه",33,"ا",2,0],["وَإِذا صَلّى رياء","كانَ فيها مثلَ أَبكَم",34,"م",1,0],["وإذا صاحبتَ فاصحبْ سيِّداً","صادقَ اللهجة ذا إن عَدَلْ",35,"ل",1,0],["وإذا صافاك خِلٌّ صافِه","بالوفاءِ المحضِ لا تبغِ البَدَلْ",35,"ل",1,0],["وإذا صحَّ لي هوى شرف الدي","ن تولَّى النعيمُ قتلَ البوسِ",36,"س",1,0],["وإذا صح ظنهم فلماذا","ما ارتقى للكمال باقي القرود",37,"د",1,0],["وإذا صح ما ادعوه فماذا","يصبح الناس بعد دهر بعيد",37,"د",1,0],["وَإِذا صَوتٌ تَعالى مُلحِناً","مِن بَعيدٍ مِثل أَوتارِ النَغَم",38,"م",1,0],["وإذا صَحّت الحقائقُ في الأَن","فسُ صحّ المُرادُ والاِعتِزام",39,"م",1,0],["وإذا صَفوْتَ كَدِرت شيمةَ باخِلٍ","وإذا وفَيتَ نَقَضْتَ أَسباب الوفا",40,"ف",2,0],["وإذا صحَّ مَعْقِدُ الحبِّ في الأَنْ","فُسِ واستأْنَسَتْ به الأَفكار",41,"ر",1,0],["وَإِذا صَحَوتُ فَإِنَّني","رَبُّ الشُوَيهَةِ وَالبَعيرِ",42,"ر",1,0],["وإذا صَبَوتُ لدارساتِ رُسومه","قال المعيد لدرسهِ هذا مَضَى",43,"ض",2,0],["واذا صَباً أَو شَمالٌ مالَت ضُحىً","بالغُصنِ مالَ بِه صِبّاً وَشَمولُ",44,"ل",1,0],["وَإِذا صُحِّفَ بَعْدَ ال","قَلْبِ لَمْ يَخْفَ مُعَمَّى",45,"م",2,0],["وإِذا صُراحُ المَدْحِ لاقَى رَبّها","لاقى لُبَاباً في المُلوكِ صُراحا",46,"ح",2,0],["وَإِذا صَيَّرَ البَعيدَ قَريباً","عادَ فيهِ فَاِزدادَ بُعداً قَريبُه",47,"ب",2,0],["وإذا صَلَّ لِجَامٌ لكَ في","رَأْسهِ هَزَّكَ مِنهُ الطَّرَبُ",48,"ب",1,0],["وإِذا صُرِّفَت بَنانُ بَنانٍ","في يَراعٍ فالصَّبر والتَّسليما",49,"م",2,0],["وإذا صَبرتُ على التَّصابي ردَّني","قلبٌ يُراوِحُني بِها ويُباكِرُ",50,"ر",1,0],["وَإِذا صَنَعت صَنيعة فَاِكتُم وَلا","تَمنن فَظَلَ المَنّ مَن يَحموم",51,"م",1,0],["وإذا صار للخدود ضجيجاً","مدفاه إلى ثغور الجمان",52,"ن",1,0],["وإذا صدقه ساءكم","فالذي عندي من العذر ظهر",53,"ر",1,0],["وإذا صرفتَ القلبَ فَهْ","وَ كأمسِ لا يُسطاعُ رَدُّهْ",54,"د",2,0],["وإذا صحوت ففي حديثك نشوتي","وإذا مَرِضتُ فأنت من يشفيني",55,"ن",2,0],["وإذا صديقُكَ لم يكنْ لك مُنصِفاً","فاجعلْ نكاحَ ودادِه التطْليقا",56,"ق",2,0],["وإِذا صُحِّفَ مقلوباً","فَحرْزُ الخلفاء",57,"ا",2,0],["وإِذا صُحِّفَ هذا","غير قلب باستواء",57,"ا",2,0],["وإذا صرتَ نصيبي منهُمُ","فقد استوفيتُ من دهري نصيبي",58,"ب",2,0],["وإذا صَفا لكَ من زمانِكَ واحِدٌ","فهو المُراد وعِش بذاكَ الواحدِ",59,"د",1,0],["وإذا صححتَ من الكُلومِ فدع بنا","مَن شئتَ مجروحاً بكلّ كِلامِ",60,"م",1,0],["وإذا صححتَ فإنّ قلبي مُقسِمٌ","أنْ لا يبالي في الورى بعليلِ",61,"ل",1,0],["وإذا صححتَ فكلُّ شيءٍ نافعي","وَإذا اِعْتلَلْتَ فَليسَ شيءٌ مُقنِعي",62,"ع",2,0],["وَإِذا صِينَ بالدُّروعِ جسومٌ","جعلَ الطّعنَ للجسومِ دُروعا",63,"ع",2,0],["وإذا صفا يومٌ ظفرتُ به","فلمن يعيش إلى غدٍ كدرُهْ",64,"ر",2,0],["وإذا صُددتُ عن المواردِ جمّةً","فمتى يكون وقد ظمئتُ ورودِي",65,"د",2,0],["وإذا صبغناه يكون ولم نكن","فتحققوا يا قوم هذا واعلموا",66,"م",3,0],["وإذا صنعت الصالحات لك الجزا","ورأيت مدحك في الورى مبثوثا",67,"ث",2,0],["وإذا صَبَرْتِ على إساءَةِ ظالِمٍ","لا تَندَمي فثوابُهُ بِكِ لا بِهِ",68,"ه",1,0],["وإذا صباح العيد جاءت خالتي","بهدية وتساءلت عن مصرعى",69,"ع",2,0],["وَإِذا صَبوَت فَلا يصدَّك عاذلٌ","عَن شادنٍ أَصمى فُؤادَك وَاِحتجب",70,"ب",1,0],["وإذا صحت العزائم فيها","فالمرام البعيد ليس بعيدا",71,"د",2,0],["وإذا صاحبت ذا حَمَقٍ","قدرُه في الأرض مُتَّضِع",72,"ع",1,0],["وإذا صدا قَرْنُ البغاة بقرية","أهدى إليه سحائباً من أنصُلِ",73,"ل",1,0],["وَإذَا صِرْتَ فِي رَحِيبِ حِمَاهُ","قُلْ لِيَحْيَى خُذِ الكِتَابَ بِقُوَّهْ",74,"ه",1,0],["وإذا صفت هاجت بتكدير وإن","هشت رضا ولت كأن لم تفعل",75,"ل",1,0],["وإِذا صَحَّ لَكَ القُو","تُ على الدُّنيا العَفاءُ",76,"ا",2,0],["واذا صادف الوضيع وضيعاً","ليس يلفى الا إليه انصبابه",77,"ب",2,0],["وَإذَا صَنَعْتَ غَدَاءَنا","فَاجْعَلْهُ غَيْرَ مُبَذْنَجِ",78,"ج",1,1],["وإذا صِحَبت مذَبذِبَه","بِتشوف حالٍ تَنكِرَه",79,"ر",2,0],["وإذا صحت المحبة في القل","ب فآثارها لهن ضياء",80,"ا",2,0],["وإذا صَلحَت نيّةٌ وَصحَتْ","نَشوة وضَحت للهدى سُبُلُ",81,"ل",1,0],["وَإِذا صاحَبتَ فَاِصحَب ماجِداً","ذا عَفافٍ وَحَياءٍ وَكَرَم",82,"م",1,1],["وإِذا صددت فإن حبك واصل","للقلب ثاوٍ في أى ثواءِ",83,"ا",2,0],["وَإِذا صُبَّت لِشِربٍ خلتَها","حَبَشِيّاً قطعَت منه الرُّكَبْ",84,"ب",1,0],["واذا صَوّحَت رياض الأماني","أزهرَت من نَوَالهِ السَّمَّاح",85,"ح",1,0],["وإذا صرت عبدها قلت للده","ر طروبا بالله دعها ودعني",86,"ن",2,0],["وإذا صحت من سكرة فلسكرة","لكنها سكرى بغير جناح",87,"ح",1,0],["وإذا صَبَرتَ لجهد نازلةٍ","فكأنّه ما مَسَّكَ الجَهدُ",88,"د",1,0],["وإذا صعدتُ عُلواً","فلتحليل المباني",89,"ن",2,0],["وَإِذا صَنَعتَ يَداً ظَفِرتَ بجاهِدٍ","في حَمدِها وَمُوَثَّقٍ في غَلِّها",90,"ل",3,0],["وإذا صفا لك مثلنا في دهرنا","فاذكر عواقب ليلة كدراء",91,"ا",2,0],["وإذا صفا لذوي المكارم صبحه","أمسى فرنق صفوه لنكاد",92,"د",1,0],["وإذا صرخت إلى عساكرك التي","لا يبلغنك جمعها ما تطمع",93,"ع",1,0],["وإذا صحوت خجلت من","نفسي كأني مرتكب",94,"ب",1,0],["وإذا صيح باسمه هاج بشرا","ولوى رأسه على الأعتاب",95,"ب",1,0],["وإذا صوروا الغواني بفلك","فخيالي مصور ذو فنون",96,"ن",1,0],["وإذا صح ما أقول فلا يبعدُ","أن قد فهمتَ ضدّ الصواب",97,"ب",1,0],["وإ