زامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5150,"الرسام ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202939",""],[5246,"يا نسيم الصبح هل أخبرتني","https://www.poetsgate.com/ViewPoem.aspx?id=187067",""],[5277,"حمامةٌ هجرتْ هديلَها","https://www.poetsgate.com/ViewPoem.aspx?id=187687",""],[5324,"مصافحة","https://www.poetsgate.com/ViewPoem.aspx?id=211751",""],[5431,"كن صديقي...","https://www.poetsgate.com/ViewPoem.aspx?id=200252",""],[5461,"من يقول الزين ما يكمل","https://www.poetsgate.com/ViewPoem.aspx?id=8547",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[5674,"الحديث يطول","https://www.poetsgate.com/ViewPoem.aspx?id=195391",""],[5687,"حريق الماء","https://www.poetsgate.com/ViewPoem.aspx?id=208075",""],[5749,"القلب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=129775",""],[5794,"صباح الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=80279",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[5954,"أسطورتي","https://www.poetsgate.com/ViewPoem.aspx?id=195113",""],[5956,"عانقتُ هذا الصدر رغم حيائه ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182644",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[5976,"قلبي زجاجي ..","https://www.poetsgate.com/ViewPoem.aspx?id=30697",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""],[6093,"لا تأخذوا رأيي بشعر معاصر","https://www.poetsgate.com/ViewPoem.aspx?id=192870",""],[6152,"وجهكِ الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=204659",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""],[4222,"إذا شئتما من غير قلبي تحدثا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52741&r=&rc=33",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["صافَحتُ راحَتَهُ وَحَش","وُ بَنانِها عَبَقُ الكَرَم",0,"م",1,0],["صَافَحَتْ فَوْرَةُ العِشا","ءِ بِهِ نَهْضَةَ الضُّحى",1,"ح",2,0],["صافي الأديمِ مُسْتَنيرِ السِّرْبالْ","كأنّما رُشّ عليهِ الجرْيالْ",2,"ل",1,0],["صَافٍ إذَا كَدِرَ الصَّفِيُّ","وَافٍ إذَا بَخِسَ الْمُكَائِلْ",3,"ل",1,0],["صافَحَ العَلياءَ فيها وَاِلتَقى","بِالمَعَرّي فَوقَ هامِ الشُهُبِ",4,"ب",1,0],["صافي أَديمِ العَرضِ لا يَنأى النَدى","عَنهُ وَلا يَدنو إِلَيهِ العارُ",5,"ر",1,0],["صافي الضَمائِرِ مَرضِيُّ السَرائِرِ مَح","مودُ المَآثِرِ تُزهى بِاِسمِهِ الخُطَبُ",6,"ب",1,0],["صافي أَديم الوَجهِ ما خَطَّت يَدا ال","أَيّامِ في خَدَّيهِ سَطراً مشكلا",7,"ل",2,0],["صَافِي الطَّوِيَّةِ لَيْسَ فِي إِعْلانِهِ","صَلَفٌ وَلا فِي سِرِّهِ إِبْهَامُ",8,"م",1,0],["صافي الأَديمِ إِذا وَضَعتَ جِلالَهُ","ضافي السَبيبِ يَبيتُ غَيرَ مُذالِ",9,"ل",1,0],["صافيته فحباك النومُ زورته","وكان ذلك حق النُّبهِ لو صافى",10,"ف",2,0],["صافِ دون الأموال عرضك واعلم","أنه دون بذلها لن يصافى",11,"ف",2,0],["صافي العطايا يظلُّ يمنع إخ","ساري من أن ينوبَ إغنامي",12,"م",2,0],["صافٍ يَرِفُّ كَأَنَّما اِبتَسَمَت بِهِ","عَن غِبِّ غادِيَةٍ غَداةَ شَمالِ",13,"ل",1,0],["صافى الرَسولَ وَمِن قَومٍ هُمُ ضَمِنوا","مالَ الغَريبِ وَمَن ذا يَضمَنُ الأَبَدا",14,"د",2,0],["صافَحَ الجَحفَلُ فيهِ الجَحفَلا","وَاِستَراحَ السَيفُ فيه وَالسِنان",15,"ن",1,0],["صافحني يبكي وصافحته","وكنت كالمأخوذ والذاهل",16,"ل",1,0],["صافٍ عَلى الدَهرِ لَم تُقفِر خَلِيَّتُهُ","وَلا تَغَيَّرَ في أَبياتِها الشُهُدُ",17,"د",1,0],["صافي الأَديمِ أَغَرَّ أَبلَجَ لَم يَزِد","في الشَيبِ غَيرَ جَلالَةٍ وَرُواءِ",18,"ا",2,0],["صافِحاً عَن خَفِيِّ ذَنبٍ وَقَد صا","فَحتُ في ساعَةِ الوَداعِ خِضابَه",19,"ب",2,0],["صافِ أَمثالَ أَحمَدَ اِبنِ عَلِيٍّ","تَعتَرِف فَضلَهُ عَلى مَن تُصافي",20,"ف",2,0],["صافِياتٌ عَلى قُلوبِ المُصافي","نَ رِقاقٌ في وَهمِهِنَّ الرَقيقِ",21,"ق",1,0],["صافي الأَديمِ كَأَنَّما عُنِيَت لَهُ","بِصَفاءِ نُقبَتِهِ مَداوِسُ صَيقَلِ",22,"ل",1,0],["صافَحَت في وَداعِها فَأَرَتنا","ذَهَباً مِن خِضابِها في لُجَينِ",23,"ن",1,0],["صافي الأَديمِ كَأَنَّ غُرَّةَ وَجهِهِ","فَلَقُ الصَباحِ انجابَ عَنهُ دُجاهُ",24,"ا",2,0],["صافٍ تمُدُّ الرِّيحُ خُطوتَها","ويَفيضُ فيه فلا تكدِّرُه",25,"ر",2,0],["صافحَ الرُّكبانُ منه","صَفْحَتَيْ عَذْبٍ فُراتِ",26,"ت",1,0],["صافا يَطوفُ بِها عَلى قُلَلِ الصُوى","وَشَتا كَذَلقِ الزُجِّ غَيرَ مُقَهَّدِ",27,"د",1,0],["صافِ الكِرامِ فَإِنَّهُم أَهلُ النُهى","وَاِحذَر عَلَيكَ مَوَدَّةَ الأَنذالِ",28,"ل",1,0],["صافَحتُهُ يَوماً عَلى خَلوَةٍ","فَقالَ دَع كَفّي وَخُذ رِجلي",29,"ل",2,0],["صافي الحَديدَةِ في مَضارِبِهِ الرَدى","بادٍ وَشَكلُ المَوتِ فيهِ مُشخَصُ",30,"ص",1,0],["صافي الأَديمِ تَرى إِذا شاهَدتَهُ","تِمثالَ شَخصِكَ في صَفاءِ خُدودِهِ",31,"د",2,0],["صافَحتَ هاماتِ العِدى بِصَفائِحٍ","دَبَّت نِمالُ المَوتِ في صَفَحاتِها",32,"ت",3,0],["صافي الفِرِندِ حَكى صَباحاً جامِداً","أَبدى النَجيعَ بِهِ شُعاعاً ذائِبا",33,"ب",2,0],["صافحتني من نواحيك يدٌ","تمسح الدمعة عن جفن الغريب",34,"ب",1,0],["صافحَ الموتَ والصفائحُ غَضْبَى","وَلَغَتْ منه في دماءِ رَضيِّ",35,"ي",1,0],["صافي الأَديمِ كَأَنَّما أَلبَستَهُ","مِن سُندُسٍ بُرداً وَمِن إِستَبرَقِ",36,"ق",1,0],["صافنٌ طِرْفٌ ثلاثٌ سنُّهُ","كمْ بهِ كسَّرْتُ جمعاً وَهْوَ مفردْ",37,"د",1,1],["صَافحوهُ مُحبَّبَ الوجهِ سَمْحاً","والزموهُ مُباركاً مَيمونا",38,"ن",2,0],["صَافَحتُهُ وَاللَّيلُ يُذكِي تَحتَنَا","نَارَينِ مِن نَفَسِي وَمِن وَجَنَاتِهِ",39,"ت",2,0],["صافَت سِهامُكُمُ وَقَرطَسَ غَيُّكُم","فَشَتا بِأَربُعَةِ الصُدورِ وَقاظا",40,"ظ",2,0],["صَافي الأَدِيمِ رَقِيقُ المِنْخَرَيْنِ إِذَا","سَافَ المَرَابِضَ في أَرْسَاغِهِ كَرَعُ",41,"ع",1,0],["صَافِي البَدَاهَةِ مَا تَرَاهُ وَاقِفاً","فِي أَزْمةٍ تَشْتَّدُ وَقْفَةَ حَائِرِ",42,"ر",1,0],["صَافِيَاتِ الأَفْكَارَِ مِنْ كُلِّ هَمٍّ","خَالِيَاتِ الْقُلُوبِ مِنْ كُلِّ وَجْدِ",43,"د",1,0],["صافحتك القلوب قبل النواظر","واستطارت إلى لقاك الخواطر",44,"ر",1,1],["صافحت مصر فزدت في بنيانها","\" هرما \" إلى الهرم الأشم الأكبر",45,"ر",1,0],["صافي أَديم الوجه ما خطَّت يد ال",