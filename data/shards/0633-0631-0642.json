202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""],[201,"هاتي الدواء وكحلي بصري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65302&r=&rc=11",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""],[6320,"قُنْصُلِيَّةُ المَوْت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84343&r=&rc=40",""],[6322,"احتِرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82626&r=&rc=7",""],[6325,"صورة أخرى للحرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88018&r=&rc=0",""],[6355,"اللصوص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66664&r=&rc=124",""]],"verses":[["سَرَقَت بِطَرفِ الريمِ مُهجَتَهُ","وَمِنَ النَواظِرِ قاطِعٌ لُصُّ",0,"ص",1,0],["سَرَقَ البَدرُ حُسنَها وَاِستَعارَت","سِحرَ أَجفانِها ظِباءُ الصَريمِ",1,"م",1,0],["سرَقْتَ العِمادَ الأصْبَهانيَّ بَرْقَهُ","وماذا تَرى في شاعِرٍ سرَقَ البَرْقَا",2,"ق",2,0],["سَرَقْتِ حَظَّ الإِلَهِ مِنْ يَدِهِ","فَهَانَ مَا كَانَ مِنْكَ يُحْتَرَمُ",3,"م",1,0],["سرَقْتُ صُواعَ العَزْمِ يوْمَ فِراقِهِ","فلَجَّ ولمْ يَرْقُبْ سُواعاً ولا وُدّا",4,"د",2,0],["سرَقَ الدّهْرُ شَبابي منْ يَدي","فَفُؤادي مُشْعِرٌ بالكَمَدِ",5,"د",1,1],["سرقتَ من عيني كحل الورى","ونمتَ عن دمعِي وتسهادِي",6,"د",2,0],["سرقوك مجدَك وهْوَ مدَّخَرٌ","منْ قبْلِ أن تُلقى إلى المهدِ",7,"د",1,0],["سَرَقَ التُفّاحُ مِن وَجنَتِها","وَاِستَعارَ الظَبيُ مِنها الحَوَرا",8,"ر",2,0],["سَرَقتَ سِهامَ المُسلِمينَ وَلَم تَكُن","لَهُم يَومَ زَحفِ المُشرِكينِ بِحاضِرِ",9,"ر",1,0],["سَرِقاتٌ مِنّي خُصوصاً فَألاً","مِن عَدُوٍّ أَو صاحِبٍ أَو جارِ",10,"ر",1,0],["سَرَقْتَ شِعْري وكُردوسٌ أَخوكَ فقَد","شُهِرْتُما عندَ كلِّ الناسِ بالسَّرَقِ",11,"ق",1,0],["سَرَقوا نِصفَ إِسمِها","فَهيَ دُنيا وَآخِرَه",12,"ر",2,0],["سَرَقَ الصَنيعَةَ فَاِستَمَرَّ بِلَعنَةٍ","يَدعو عَلَيهِ النائِلُ المَظلومُ",13,"م",1,0],["سَرَقوهُم مِنَ السُيوفِ وَمِن سُم","رِ العَوالي لَيالِيَ الساروقِ",14,"ق",1,0],["سرقْتُ منها نظرةً فاستضحكتْ","واستترتْ عني وسدَّتْ طاقَها",15,"ق",3,1],["سِر قَليلاً وَلا تَلُمني خَليلي","لِوَداعِ الرَبابِ قَبلَ الرَحيلِ",16,"ل",1,1],["سَرَق النِّصْفَ واشتَرى النِّصْف بالنِّص","فِ وَأَفْتَى بأَنَّ هذا تِجارَهْ",17,"ر",2,0],["سرقنَ وقد نزلنَ عليه أيري","فلم أظفر بهِ حتى الصباح",18,"ح",1,0],["سِرٌّ قَديمٌ وَأَمرٌ غَيرُ مُتَّضِحٍ","فَهَل عَلى كَشفِنا لِلحَقِّ إِسعادُ",19,"د",1,0],["سرَقَ النيلُ الندَى من كفِّه","فأسَالَ التِبْرَ فوق الواديينْ",20,"ن",1,0],["سَرَقَ التَدَلُّلَ مِنْ عِنَا","نٍ وَالتَفَنُّن مِنْ وَحِيدِ",21,"د",1,0],["سَرَقَ اللَّيْلُ مِنْك لَوْناً فأمْسَى","مَسْرَحَ اللَّهْوِ مَوْطِنَ الإِطْرَابِ",22,"ب",1,0],["سرقوا أصابعنا وعطر حروفنا","فبأي شيء يكتب الكتاب",23,"ب",1,0],["سرقوك مجدَك وهو ومدَّخرٌ","من قبلِ أن تُلقى إلى المهدِ",24,"د",1,0],["سَرق الرَسول بَلَحظِهِ مِن وَجهِهِ","حُسناً أَبى عَن ناظِري أَن يَكتما",25,"م",2,0],["سرقوا ثباب الناس واستتروا بها","وكأن اضرار الانام حلال",26,"ل",1,0],["سرقوا العقل والمدارك مني","وعتوا على شدوا العقالا",27,"ل",2,0],["سُرَّ قلباً وبتْ قرير عيونِ","لا تبتْ في دُجاك غيرَ قريرِ",28,"ر",1,0],["سِر قبل أن تَحجُبَ الغَوادي","عن ناظِرَينا ذُرى السماء",29,"ا",2,0],["سرَقَ ابن آوى ديكَنا سحَراً","ودجاجُنا منه على خطَرِ",30,"ر",1,0],["سِرْ قاصِداً سرعاً يا حادي النُّجُبِ","وَقِفْ على التعلةِ العلياءِ من غربِ",31,"ب",1,1],["سَرَقن الرياضَ حُلَى رَقْمها","ونَمْنَمْنَها تحت وَشْي البُرُودِ",32,"د",1,0],["سَرَقناهُ مُخالَسَةً وَداعي ال","نَوى عَن شَملِ أُلفَتِنا غَفولُ",33,"ل",1,0],["سرقوا القوافي واستعار واحليها","فتحيروا في الوضع والتكوين",34,"ن",1,0],["سرق الأديب محاسنَ الوراقِ","مما خطه المسكين في الأدراج",35,"ج",1,1],["سرقاتُ الأديب بعض المعاني","جوزوها في مذهب الشعر شرعا",36,"ع",2,1],["سَرَقُوا لي في لَيْلَةِ العِيد دِيكاً","هُوَ لِلعيشِ والعُيُونِ سَواءُ",37,"ا",2,0],["سَرَقُوهُ وَخلَّفُوا الفَحْمَ والثَّلْ","جَ فَحَسْبي مُصِيبةٌ بَلْياءُ",37,"ا",2,0],["سرقوا مدادي حين خافوا كِلمتي","فتفقتُ أكتبُ بالدمِ الأشعارا",38,"ر",2,0],["سَرق الزّمانُ من الأوائلِ فانقضَتْ","بدْراً وزادَتْها الأواخِرُ طُولا",39,"ل",2,0],["سَرَقتَ قَلبي وَعَينُكَ اِعتَرَفَت","ما تَكتُمُ العَينُ ريبَةَ السارِقْ",40,"ق",1,0],["سَرَقت بِالسحر وَالغَن","ج رَقادي وَفُؤادي",41,"د",2,0],["سَرق العَبدَ كَأَنَّ ال","عبدَ من مال اليَتامى",42,"م",2,0],["سَرَقتَ شعري وَغَيري","يُضامُ فيهِ وَيُخدَع",43,"ع",1,1],["سَرَقتَ يا ظبيُ كُتبي","أَلحَقتَ كتبي بِقَلبي",44,"ي",1,1],["سُرقتْ عباءتُها ، ومزِّق ثوبها","وأضيعَ في يوم الزفافِ سِوارُها",45,"ر",3,0],["سَرِقاتٌ لكنها من سجايا","ك بها صرتَ تفتحُ الأقفالا",46,"ل",2,0],["سرق الغشوم بلادكم وإذا به","صار الوصي عليكم لأذاكموا",47,"م",3,0],["سَرقَ الروائعَ من مفاخرِ غيره","وأماتهَّن ولا يزال يفاخر",48,"ر",1,0],["سرقاتٌ خُلْسٌ كما يرد المذ","عورُ خوفاً أن يصطلي المقرورُ",49,"ر",1,0],["سَرَقَتها لِيَ الحظوظُ وخَنسا","ءُ استلاباً من الزمان وطَرَّا",50,"ر",2,0],["سَرقتُ على سؤرِ البخيلة نهلةً","بها لم أكن أدرى أتُسكر أم تُصحي",51,"ح",2,0],["سرق الكرى جفني فجور قطعهُ","والقطعُ يلزم للخؤون السارق",52,"ق",1,0],["سرقتْ غصونُ البانِ لينَ شمائلي","فقطعتُها والقطعُ حدُّ السارقِ",53,"ق",1,0],["سرقت له شعراً ولو وصلت يدي","سرقت له الشعرى ولم أسرق الشعرا",54,"ر",2,0],["سرقت من طرته شعرة","حتى غدا يمشطها بالمشاط",55,"ط",1,0],["سرقتَ المكانَ وائْتسى بكَ أرذلُ","الزمانِ وكنت للّئامِ وليّا",56,"ي",2,0],["سَرَقت ليلة الجِما","رِ فؤادي بحسنها",57,"ن",3,0],["سرقتَ يا طيفُ نَوْمِي","متى عَهدتُكَ لِصّاً",58,"ص",2,0],["َسُرُّ قلباً قد تعذَّ","بَ بالفراقِ أَسىً وهَمَّا",59,"م",2,0],["سرقتَ قلبي ولمْ أَنكرتَ سِرقته","أَليس خدُّك مسروقاً من السَّرق",60,"ق",1,0],["سِر قَد أَنَى لَكَ أَيُّها المُتَحَوِّسُ","فالدارُ قَد كادَت لِعَهدِكَ تُدرَسُ",61,"س",1,1],["سرقت عزيمتُك الرُّقا","دَ فبتّ مهجور المَراقد",62,"د",1,0],["سَرَقَ اللصُّ وهو رَبُّ الدهاءِ","بعض مالٍ ممن جيب عبد الثراءِ",63,"ا",2,1],["سر قلبي برغم ما يتغشى","صفحتيه من الأسى والشقاء",64,"ا",2,0],["سَرَّ قلبي سرورُ قلبكَ يا حُسْ","نَ سرورِ السرورِ بالمسرور",65,"ر",1,0],["سَرقت عَيني لمّا أَنْ بدَا","خَالُهُ البادي بِإِحدى الوَجنتَينِ",66,"ن",1,1],["سرقت ريَّا الغواني","فلذا ضاءت ختاما",67,"م",2,0],["سرقت ضياءً من أشعة نورها","فقضى عليها الحدَّ حكمُ الخالقِ",68,"ق",1,0],["سرق الكرى جفني فجُوِّزَ قطعُهُ","والقطعُ يلزم للخؤون السارق",69,"ق",1,0],["سرقَ النسيمُ حُلى الغصونِ بسحرةٍ","لما أتاها وهي في أطرابها",70,"ه",2,1],["سرقوكِ منِّي، ليتهُم بعدَ الذِي","فعلُوا بقلبِي رأفةً قتَلُونِي",71,"ن",2,0],["سرق الفضل عامداً كيس توتني","وانزوى خائفاً بدار خليصي",72,"ص",2,0],["سَرَقتِ رُمانَتَي نَهديك من شَجَري","قالَت وَقد بَهَتَت من قَولِهِ خَجَلا",73,"ا",1,0],["سرقوا جبتي وسيفي وسكي","ني وخفي وجوربي وراني",74,"ن",2,0],["سرقوا السرج والقناديل والزي","ت وأقداحنا وكل الناني",74,"ن",2,0],["سرقوا الراح في الزقاق وراحوا","بطعام منضد في الصواني",74,"ن",2,0],["سرقت فيها من الواشين خلوتنا","ونلتها منكِ عن وعدٍ يدا بيدِ",75,"د",1,0],["سرقناه من شرخ الشباب وروْقه","فلما سرقنا الصفو منه سُرقناه",76,"ن",3,0],["سرق الزهور من الرياض لطافة","وعليه عدل شاهد من قده",77,"د",2,0],["سِرُّ قَرَا رَسْلاَنَ فِي مُحمَّد","أَلقاه محمود إلى مودود",78,"د",1,0],["سرقَ اللَّحظَ من محاسنِ والٍ","يظنُّ العذابَ قلتُ هناكَ",79,"ك",1,1],["سرقت سراقتها سوارق طرفها","من حرزِ طرفٍ مشرق الأقطار",80,"ر",1,0],["سَرَقوا النيلَ هَل رَأَيتَ طُغاةً","بعضُ ما يَسرِقونَ نَهرٌ شَهيرُ",81,"ر",1,0],["سَرَقتُ بِالنَّومِ وَصلاً من خَيالِكُمُ","فَصارَ نَومي مَقطوعاً عَلَى السَّرَقِ",82,"ق",1,0],["سَرَقت ما سَرَقت ثُمَّ اِدّعت","أَنَّها أَطهَر مِن ماءِ المُزن",83,"ن",1,0],["سَرَقَ الخَصْرَ الرَّقيق وقد","باتَ مَقطوعاً بما سَرَقا",84,"ق",2,0],["سرقوكم وأكثروا الخيلاء","حين صاروا من فقركم أغنياء",85,"ا",2,0],["سرقوا من نفيس شعرك درا","ثم ردوا عنهم بذمك تهمه",86,"م",2,0],["سرق الطامع أبهى مجدنا","ومضى يعدو فأين العسس",87,"س",1,0],["سرقتم من عُيون الظّبي سحرا","فأجريتم لأدمُعنا عُيونا",88,"ن",2,1],["سرقت فؤادي ثم لا ترجعينه","وبعض الغواني للقلوب سروق",89,"ق",1,0],["سرَق المَنام بطَرْفِه الْ","فَتَّانِ ذُو الحُسْنِ الغَزِيرِ",90,"ر",1,1],["سرَق الغُصْنُ لِنَهُ فلهذا","لَزِمَتْهُ جِنايَةُ السُّرَّاقِ",91,"ق",1,0],["سرق الفضل عامداً كيس تتني","وانزوى خائفا بدار خليصي",92,"ص",2,0],["سَرقَتْهُ من حَافظيهِ جِهاراً","نَظَرَ العينِ انَّها لَسَرُوقُ",93,"ق",1,0],["سرقتْ حُسْنَ خ