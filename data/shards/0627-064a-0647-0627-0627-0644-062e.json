{"poems":[[95,"عاش هذا الفتى محبا شقيا","https://www.aldiwan.net/poem11096.html","الخفيف"],[72,"أيها الخائف من أمر","https://www.aldiwan.net/poem42404.html","مجزوء الرمل"],[50,"أيها الخادم الذي لو أتيت الأمر","https://www.aldiwan.net/poem65248.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141980","الخفيف"],[108,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[303,"لاح في جنح الظلام","https://www.aldiwan.net/poem36799.html","عموديه"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[333,"ابن عمي مات فامضوا","https://www.aldiwan.net/poem54961.html","مجزوء الرمل"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[333,"هتف الليل فلب الهاتفا","https://www.aldiwan.net/poem55046.html","الرمل"],[366,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[411,"أيها الخاطبون شكرا كريما","https://www.aldiwan.net/poem49477.html","الخفيف"],[569,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88610","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203775","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95550","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48936","الخفيف"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2107,"","https://poetry.dctabudhabi.ae/diwan/poem/203816",""],[2149,"","https://poetry.dctabudhabi.ae/diwan/poem/115170","الخفيف"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105384","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110224","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216575","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35580","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107502","الخفيف"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135107","الخفيف"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104889","الخفيف"],[4679,"صانك الله من صروف البلاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=142762",""],[4929,"فاقدُ الهمَّةِ ما صَعَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=204721",""],[5409,"يا رواق المجلس الحا","https://www.poetsgate.com/ViewPoem.aspx?id=155291",""],[5691,"الخان الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=205927",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""]],"verses":[["أَيُّهَا الخَاطِبُ الثُّرَيَّا وَمَا","تِلْكَ سِوَى طَالِعٌ مِنَ السَّعدِ حيَّى",0,"ي",2,0],["أَيُّها الخائِفُ مِن أَم","رٍ عَناهُ وَعَساهُ",1,"ا",2,1],["أَيُّها الخادِمُ الَّذي لَو أُتيتُ ال","أَمرَ كانَ المُكَرَّمَ المَخدوما",2,"م",2,1],["أيُّها الخمَّارُ قمْ وافتح لنا","واسقِنا قبلَ رحيلِ القافلهْ",3,"ه",1,0],["أيها الخالدُ في الدنيا غراما","أينَ نيْسابورُ والروضُ الأنيقْ",3,"ق",1,0],["أيها الخافق المعذب يا قلبي","نزحت الدموع من مقلتيّا",4,"ي",2,0],["أيها الخِلُّ الذي خاصمني","غيرَ مُبقٍ، لستُ آلوكَ خصاما",5,"م",2,0],["أيها الخمّارُ زدني","فصريعُ الكأْس ظامي",6,"م",2,0],["أيها الخالد الذي كان بالأم","س سراجا يضيءُ في الظلمات",7,"ت",1,0],["أيها الخلّان والراحة","والموت هنا",8,"ن",2,0],["أيها الخالد لا تغنى","لمعناه معان",8,"ن",1,0],["أيّها الخالدُ الذي أفناني","لهفَ قلبي على الصبا والشباب",9,"ب",1,0],["أيها الخالد يروى بدموعي الخالدات","قل له حسبُ عليل ما يلاقى",10,"ق",2,0],["أَيُّها الخل قَد صَحِبناكَ دَهراً","وَبلونا حلاك سِرّا وَجهرا",11,"ر",2,1],["أيُّها الخاطِبونَ شُكْراً كَريماً","أينَ أنتُمْ عن مَهْرِ شُكْرٍ كَريمِ",12,"م",1,1],["أيها الخادعون للعرب مهلاً","دون ما تأملون بحر المنية",13,"ي",2,0],["أَيُّها الخابط الظلام مجداً","بسراه في ظهر كوماء عنس",14,"س",1,0],["أيها الخفاق عزاً ، إننا","لم نزل نهفو إلى العهد السعيد",15,"د",1,0],["أيها الخطب قد أثرت القوافى","وأذبت القلوب دمعا سخيّا",16,"ي",2,0],["أيها الخدرُ مرحباً وشُكورا","فلقد جئتَ مصلحاً وبشيرا",17,"ر",2,1],["أيها الخدر أَنت باكورةُ النهضة","فالفوزُ أن تكون صَبورا",17,"ر",2,0],["أيها الخابط في وجنائه","مهمه البيد سهولا وحزون",18,"ن",1,0],["أيها الخائف المكا","ره وطّنْ لها الحشا",19,"ش",2,1],["أيّها الخائنُ الذي دمّرَ البص","رةَ أبشِر من بعدها بدمار",20,"ر",1,1],["أيها الخائف المروع قلباً","من وباء أولى فؤادك رعبا",21,"ب",2,1],["أيها الخِلُّ المحاجي","وأَخا القولِ اليقينِ",22,"ن",1,1],["أيها الخالق القدير تقبّل","من عباد النضار آيَ الثناء",23,"ا",2,1],["أَيُّها الخِلُّ الَّذي جَد","دَدَ لِلقَصف نَشاطي",24,"ط",2,1],["أيها الخالق العظيم الذي أبد","عَ في خلقهِ الورى ما شاءَ",25,"ا",2,0],["أيها الخمر قد أطلت ملامي","فاترك اللوم واستمع لكلامي",26,"م",2,1],["أيها الخال دع طريق العناد","واتركن أكل أسود كالمداد",27,"د",1,1],["أيها الخل أنت مهجة جسم","الفضل بل أنت رحلهُ الفضلاء",28,"ا",2,0],["أيها الخاملُ كنْ نشِطاً","يأسنُ الماءُ إذا رَكَدَا",29,"د",2,0],["أيها الخازن أنقا","ضاً وأخشاب سقوف",30,"ف",1,0],["أيُّها الخانُ أنْتَ لوْنُ دِمائي","لا تُبالي وَحْشِيَّةَ الأعْداءِ !",31,"ا",2,1],["أيُّها الخصْمانِ ما خطْبُكُما","حدِّثاني بلسانِ المَنْطقِ",32,"ق",1,0],["أيها الخائفون... شكراً","د.أيمن أحمد رؤوف القادري",33,"د",3,1],["أيها الخائفونَ مِنْ طُهْرِ نَفسي","هلْ مَذاقُ النفاقِ في النفسِ أَجْوَدْ ؟",33,"د",1,0],["أيها الخائفونَ مِنْ صِدْقِ قَوْلي","لستُ شيطاناً أخرسَ الفَمِ مُبْعَدْ !",33,"د",1,0],["أيها الخائفونَ، شكراً جزيلاً","فلقدْ حَرَّرْتُمْ فؤادِي المقَيَّدْ",33,"د",1,0],["أَيُّها الخائِنُ عَهدِي","أَنتَ فِي الأَحشاءِ جُرحُ",34,"ح",1,0],["أَيُّها الخاضِعُ الذَّلِيلُ إِلَيها","لا تَكُنْ تَحتَ حُكمِها كالمَطايا",35,"ا",3,0]]}