{"poems":[[63,"صب بغرات الصبا مكلف","https://www.aldiwan.net/poem51549.html","الرجز"],[99,"هي صفحة طويت وحان ختام","https://www.aldiwan.net/poem24984.html","الكامل"],[463,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/107328","السريع"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53895","البسيط"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46530","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52121","الرجز"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103818","الطويل"],[4691,"أيا هندُ هلاّ زرتِ بيت صبابتي","https://www.poetsgate.com/ViewPoem.aspx?id=156951",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6093,"أهلاً وسهلاً بمَنْ للحفِل قدْ زَانَا","https://www.poetsgate.com/ViewPoem.aspx?id=206221",""]],"verses":[["ألحفتُهُنَّ والحِمامُ ألحَفُ","شبَّهتُه بالدِّرْعِ حينَ تُرصَفُ",0,"ف",1,0],["الحفل منتظم تكامل عقده","أين العشيَّ خيالك البسام",1,"م",1,0],["ألْحفتْ حاليَ منها نعمةٌ","نعمةُ المزنةِ تنثوها الحديقَهْ",2,"ق",2,0],["ألحَّ في العذلِ ولم يَرعَوِ","في عاشقٍ يَبكي الدِما في الدُما",3,"م",2,0],["الحفظُ حِلْيَتُهُ والفهم شيمتُه","والفضلُ وصُفٌ له أَرْبَى ولم يَبِن",4,"ن",1,0],["ألْحفتهم مُلاءة الأمان","وسستهم بالعهد والضمان",5,"ن",1,0],["الحفظ للسان","في السر وَالإِعلان",6,"ن",1,0],["الحفنويّ الشافعي","محمد بن سالم",7,"م",1,0],["ألح فإن النساء يكدح في الصفا","إذا طال مأتي عليه ويذهب",8,"ب",1,0],["ألحّفه ُ صفو الودادة ِ والعطا","له مهجتي بالحبّ عشتُ أغلّفُ",9,"ف",1,0],["أَلْحفَتْ في السؤالِ هل من فَكاكٍ","لأَسِيرٍ ما لَهُ من سَرَاحِ",10,"ح",1,0],["الحَفْلُ أنتمْ وأنتمْ كلُّ فرحتِنا","جعلتمُ الكَهْلَ مثلَ الطفلِ فرحَانَا",11,"ن",2,0]]}