{"poems":[[104,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85499","الخفيف"],[111,"ليس في الحب قياس","https://www.poetsgate.com/ViewPoem.aspx?id=612",""],[92,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[113,"يا غزالا يقل مسكا فتيقا","https://www.aldiwan.net/poem16499.html","الخفيف"],[215,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[333,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[347,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[422,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[469,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72344","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49089","المتدارك"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27451","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27452","الطويل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124712","الكامل"],[2939,"","https://poetry.dctabudhabi.ae/diwan/poem/146985","الطويل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113678","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201534","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204591","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132782","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145057","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48374","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101225","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135736","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4963,"شاعر سعودي والدواسر لابتي","https://www.poetsgate.com/ViewPoem.aspx?id=35635",""],[5032,"حال شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=191236",""],[5183,"قرينة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=186604",""],[5370,"خوية الذات","https://www.poetsgate.com/ViewPoem.aspx?id=87460",""],[470,"لماذا..؟!","https://www.poetsgate.com/ViewPoem.aspx?id=178067",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5848,"منين ياحسرة","https://www.poetsgate.com/ViewPoem.aspx?id=48962",""],[5952,"أسير شُرْفةٍ وناي","https://www.poetsgate.com/ViewPoem.aspx?id=213322",""],[5956,"اخضعي لي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182616",""],[5956,"أيها البحر الحبيب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183232",""],[5956,"خلَفٌ أتانا طاهراً مثل السّلفْ","https://www.poetsgate.com/ViewPoem.aspx?id=193487",""],[5956,"ما قلتَ لي كلاّ أيا خير المَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193507",""],[5956,"محبوبُ القطرين","https://www.poetsgate.com/ViewPoem.aspx?id=193589",""],[6001,"الله من قدي","https://www.poetsgate.com/ViewPoem.aspx?id=695",""],[6031,"عُجْ بالمَطِيِّ علَى مَعَالمِ بُورِي","https://www.poetsgate.com/ViewPoem.aspx?id=46320",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["أَنا اِستغفر الوَفا لَم يَبيدوا","يَوم خلدت بَعدَهُم أَعمالا",0,"ل",2,0],["إنّا استَلَمنا رُكنَكُم ودَنَوْتُمُ","حتى استَلمْتُمْ عَرشَهُ المحمولا",1,"ل",2,0],["أَنا أستنهض الشعوب بشعري","وَعَسى أَن يفيدها اِستنهاضي",2,"ض",2,0],["أنا أسلو عن حبيبي ساعة","يا عذولي \" قل هو الله أحد\"",3,"د",1,0],["أنَّا استعَضْنا ثوباً بثوبٍ","وطالما استُبْدلَتْ بُرود",4,"د",1,0],["أَنا أَسعى وَفي سَلاسل صَدغي","ك فُؤادي فَاِرحَم أَسيراً طَليقا",5,"ق",2,0],["أنا اسرفتُ في الرجاء فأمسى","خيب هذا الرجاء إحدى الأماني",6,"ي",1,0],["أَنا أَسيرٌ في بِلادي فَهل","في مِصر أَفكار الفَتى تُؤسَرُ",7,"ر",1,0],["أنا أستقبل الربيع بقلب","هامد الحس قاهل الخفقات",8,"ت",1,0],["أنا أستشهد السماء على ما","أمطرتني السماء من نكبات",8,"ت",1,0],["انا أسير غرامي","روحي وعبد الجمال",9,"ل",1,0],["أنا أستشفي ولكنْ مِنْهُمُ","بشِفاءٍ لم يغادرْ سقما",10,"م",2,0],["أنا أسيرُ ليلٍ راقبت أدبي","فعوَّضتني من الأغلال بالغللِ",11,"ل",1,0],["أنا أسخو بالمال لكن بديني","أن تأملتني فغير سخي",12,"ي",1,0],["إنَّا أَسَسنا الجمعيةْ","لنبثَّ الروحَ القومّيهْ",13,"ه",1,0],["أنا أسعى الدهر في تحصيل ما","عالم الأمر أرى يهمله",14,"ل",2,0],["أنا أسوة فيه كما قال ربنا","تلوناه في الأحزاب في محكم الذكر",15,"ر",1,0],["انا أسعد الثقلين إن ادناهمو","منّي رواحي نحوهم وبكوري",16,"ر",2,0],["أنا أسعى إليك سعي محب","ومحق بفعله ما يقول",17,"ل",1,0],["أنا أستبقي حياتي","لتُقَضَّى في حياتكْ",18,"ك",1,0],["أنا أسمو في عالم الروح دوماً","في زمان لم يعترف بالروح",19,"ح",1,0],["أنا أسعى للمجد ما دمت حيا","قد تساوى غدي ويومي وأمسي",20,"س",2,0],["أنا اسكنتك الفؤاد فرفقاً","فيه يا بنت مدعي الوطنيه",21,"ي",2,0],["أنا أسرع الفتيان في","ما ترتضيه وأسبق",22,"ق",1,0],["أنا أسْمى في الحُسْنِ قَدْراً وأعْلا","حيثُ أصبحْتُ لابنِ نصْرٍ مَحَلّا",23,"ل",2,1],["أنا اسكنتها فؤادي ليغدو","من دياجي همي بها استصباحي",24,"ح",2,0],["انا أَستميحكَ يا الهي مِنَّةً","يا بحرَ كل تعطُّفٍ وحَنانِ",25,"ن",1,0],["إنا استغثناك أغثنا ربّنا","بهذه الأسماء فرّج كربنا",26,"ن",2,0],["أنا أساد الشر دون الشرى","تتقيني فلماذا أتقيه",27,"ه",1,0],["انا اساس الشعر والباقي دخلاء","وجيش الشعر غصب(ن) يقدم رايتي",28,"ت",2,0],["أنا آسفٌ جداً إذا لم أنْتبهْ","لك تَحْضنينَ كتابتي وفنوني",29,"ن",2,0],["أنا أسماء والعروبة مهدي","والثريا والدين أفق سمائي",30,"ا",2,0],["أنا آسفة يا قصيدة وابعدي عني","الوقت كله عطيته لامتحاناتي",31,"ت",2,1],["أنا أسرَجتُ كلَّ عمري شموعاً","لأضيءَ الشطآن في عينيكِ",32,"ك",1,0],["أنا أسْنانُ الأقاحي وضَحاً","وزُها الفلِّ وتاجُ الزَّنْبقِ",33,"ق",1,0],["انا اسأل عنك يا اللي ما سألت وما طرى تسأل","عن اللي.. كل ما تطري عليّه .. يوّلم العبرة !",34,"ر",2,1],["أنا أسير الناي ال أظلُّ به","عمراً حبيساً لم أعْبرِ الوترا",35,"ر",2,0],["‏أنا أسقي كل تشكيل جديد","‏ ‏ فاتنٍ ما شاء أنواعَ الغذاء",36,"ا",2,0],["‏ ‏أنا أُسعِدُ الأسماك دون تحايل","‏ ‏ أنا مخلصٌ للكون لا فرداً معَكْ",37,"ك",1,0],["أنا أستحق رعاية منكم كما","ترعى الأمَيمة طفلها مهما اقترفْ",38,"ف",1,0],["أنا أستطيع من الكريم تمكُّناً","عكس الألى احترفوا التباخل والقِلى",39,"ل",2,0],["أنا أسرع في نشر قصيدي","إسراعي الفذ بردّ الدّينْ",40,"ن",1,0],["أنا أسعد بشر وانته أعز الناس والْطَفْهَا","وأغلى حب في قلبي عزيز وغالي عندي",41,"د",2,0],["أنَا أسعدُ الثِّقَلَينِ إنْ أدناهُمُ","مِنِّي رَوَاحِي نحوَهُمْ وبُكُوري",42,"ر",2,0],["أنا آسى من الحيا(ة) لا من المو","تِ ، فخذ من أيام عمري البواقي",43,"ق",2,0]]}