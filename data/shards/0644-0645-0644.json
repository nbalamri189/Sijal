{"poems":[[77,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"لم لا تنال العلى أو يعقد التاج","https://www.aldiwan.net/poem36654.html","البسيط"],[77,"قد زرت قبرك عن طوع بأغمات","https://www.aldiwan.net/poem36684.html","البسيط"],[77,"عجب الأمير لجرأتي يوم الوغى","https://www.aldiwan.net/poem36731.html","الكامل"],[54,"زر خير قبر بالعراق يزار","https://www.aldiwan.net/poem27432.html","الكامل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[88,"فعدت بقارعة الطريق تنوح","https://www.aldiwan.net/poem43672.html","الكامل"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[47,"إبنان أم شبلان ذان فإنني","https://www.aldiwan.net/poem25154.html","الكامل"],[72,"أهلا وسهلا بوافي الفضل كم شهدت","https://www.aldiwan.net/poem18253.html","البسيط"],[72,"اسكنت قلبي لحدك","https://www.aldiwan.net/poem18565.html","المنسرح"],[72,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"مالي أسل من القراب وأغمد","https://www.aldiwan.net/poem61901.html","الكامل"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"ساءلت يوما خالدا","https://www.aldiwan.net/poem65011.html","مجزوء الكامل"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[91,"قال الغراب وقد رأى كلف الورى","https://www.aldiwan.net/poem8788.html","عموديه"],[70,"أمحمد والجود فيك سجية","https://www.aldiwan.net/poem42784.html","الكامل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"شرفاً نصير ارفع جبينك عالياً","https://www.aldiwan.net/poem8081.html","الكامل"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"في مهرجان الحق أو يوم الدم","https://www.aldiwan.net/poem62949.html","الكامل"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[43,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[43,"لم لا يغاث الشعر وهو يصيح","https://www.aldiwan.net/poem10608.html","الكامل"],[45,"لم لا ترق لذل عبدك","https://www.aldiwan.net/poem63495.html","مجزوء الكامل"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"خرس الثرى وتكلم الزهر","https://www.aldiwan.net/poem63621.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[45,"يأبى الخلي بكاء المنزل الخالي","https://www.aldiwan.net/poem65572.html","البسيط"],[61,"ولقد مررت على المحدث مرة","https://www.aldiwan.net/poem51568.html","الكامل"],[49,"لم لا نبادر ما نراه يفوت","https://www.aldiwan.net/poem10389.html","الكامل"],[97,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[97,"طلق شجونك في ثرى الأحبابِ","https://www.aldiwan.net/poem24392.html","الكامل"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[44,"رأيت في النوم أن الصلح قد فسدا","https://www.aldiwan.net/poem30264.html","البسيط"],[44,"أطفأت نار هواك من قلبي","https://www.aldiwan.net/poem30285.html","الكامل"],[69,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[46,"لم لا أؤمل رحمة من قادر","https://www.aldiwan.net/poem23247.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140892",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54806","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[95,"النسر","https://www.poetsgate.com/ViewPoem.aspx?id=706",""],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"حسن ترقى","https://www.poetsgate.com/ViewPoem.aspx?id=179749",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[77,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[77,"عجب الأميرُ لجرأتي يوم الوغى","https://www.poetsgate.com/ViewPoem.aspx?id=33272",""],[77,"لم لا تنال العلا أو يعقد التاج","https://www.poetsgate.com/ViewPoem.aspx?id=33564",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[85,"لك في الأرض والسماءِ مآتمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9626&r=&rc=116",""]],"verses":[["لِمَ لاَ وَرَبَّكَ قَدْ قَضَى لَكَ بِالْعُلاَ","وَبِنَصْرِ مُلْكِكَ أَحْكَمَ الأَحْكَامَا",0,"م",2,0],["لِمُلْكِكَ عُقْبَى النَّصْر فارْقبْ طُلُوعَهَا","فَقَدْ آنَ لِْلإِسْلاَمِ آنُ اقْتِبَالِهِ",1,"ل",2,0],["لِم لا تُنالُ العُلى أو يُعْقَدُ التّاجُ","والمُشْتَري طالِعٌ والشّمْسُ هِلاجُ",2,"ج",1,1],["لِمْ لا أزُورُكَ يا أنْدَى المُلوكِ يَداً","ويا سِراجَ اللّيالي المُدْلَهِمّاتِ",3,"ت",1,0],["لِمَ لاَ يَكُونُ اللَّيْثُ وَالنَّقْدُ الْعِدَى","مَنْ كُنْتَ أَنْتَ مُصَوَّراً فِي قَلْبِهِ",4,"ه",1,0],["لِمَ لا أَزورُكَ يا حُسَينُ لَكَ الفِدا","قَومي وَمَن عَطَفَت عَلَيهِ نِزارُ",5,"ر",1,0],["لِمَ لا يطاوعُه الوجودُ وقد غدا","من نوره في خلقه معلولا",6,"ل",2,0],["لِمْ لا أحنُّ وهذا الجِذْعُ حَنَّ لَهُ","لما تباعد عن لُقياه وانْتَزَحَا",7,"ح",2,0],["لمَ لم تعوا ما قلن قبل مكرّراً","أو ما كفاكم ذلك التصريح",8,"ح",1,0],["لمَ لم تحفَظوا أخوّة دين","جاءكم ناطقاً بها التنزيل",9,"ل",1,0],["لِم لا يَفوقانِ الأَنامَ مَكارِماً","وَالسَيِّدانِ كِلاهُما جَدّاهُما",10,"م",2,0],["لِمْ لا يكون أميناً في ممالِكها","وهو العزيزُ عليها وابن يعقوب",11,"ب",1,0],["لم لأنسَ لثمكَ لما","أحسستُ بالموتِ بعدَك",12,"ك",1,0],["لم لا أشبّب بالعيش الذي سلفت","أوقاته وهو باللذَّات موصول",13,"ل",1,0],["لِمْ لا وذكراهُمْ له","رَوْحٌ إذا ما الهمُّ نابهْ",14,"ب",2,0],["لِمَ لا نَوَدُّ لكَ البقاءَ مُنَفَّلاً","طولَ السَّلامةِ والمعاشَ الأفسحا",15,"ح",2,0],["لِمَ لا أجرَّبُ في الضرائب مرة","يا للرجال وإنني لَمُهندُ",16,"د",1,0],["لم لا أُحلَّى حليةً أنا أهلُها","فيُزان بي بَطَلٌ ويُكْفَى مشهدُ",16,"د",1,0],["لملاقاةِ ليثِ غيلٍ هَصورٍ","ومُداهاةِ حيَّةٍ نَضْناض",17,"ض",1,0],["لِم لُمتني متغطْرساً","لا درّ درُّك من خليط",18,"ط",1,0],["لم لا يكون كذا وقد أُلبِستَه","فلبست فيه سكينة وخشوعا",19,"ع",2,0],["لِمْ لا تكونُ لدى إمامِك مُرتضىً","لا يبتغي بك في الكُفاةِ بديلا",20,"ل",2,0],["لمْ لا تلوذ بك الخلافةُ بعدما","أثبتّ مرساها وفيه تزلزلُ",21,"ل",1,0],["لم لا وأنت إذا سألنا مُفضلٌ","ومتى هفونا هفوةً فحليمُ",22,"م",1,0],["لِمَ لا تَهيمُ بِيَ المَسامِعُ مِثلَهُ","ما الفَرقُ بَينَ جَناحِه وَجَناحي",23,"ح",2,0],["لِم لايُرَجّى مِنكَ إِدراكُ المُنى","وَأَبوكَ في يَومِ الفَخارِ أَبوكا",24,"ك",2,0],["لم لا أقيمك للشباب منارة","وسبيل خير يسلكون سواءها",25,"ا",3,0],["لِمَ لا يَلينُ لَكَ الحَديدُ وَلَم تَزَل","تَتلو عَلَيهِ وَتَقرَأُ التَنزيلا",26,"ل",2,0],["لِمَ لَم تَدعُهُم إِلى الهِمَّةِ الشَم","ماءِ وَالعِلمِ وَالطِماحِ المُزاحِم",27,"م",1,0],["لِم لا تُطِلُّ مِنَ السَماءِ وَإِنَّما","بَينَ السَحابِ قُبورُها وَالأَنجُمِ",28,"م",1,0],["لِمَ لا يُفتَنُ فِتيانَ الحِمى","ذَلِكَ الإِقدامُ أَو ذاكَ الطِماح",29,"ح",1,0],["لِمَ لا تَحذَرُ العَواقِبَ في غَي","رِ الدَنايا أَما عَلَيكَ حَرامُ",30,"م",1,0],["لم لا يُغاث الشعر وهو يصيحُ","ويُرى منار الحق وهو يلوحُ",31,"ح",1,1],["لِمَ لا تَرِقُّ لِذُلِّ عَبدِك","وَخُضوعِهِ فَتَفي بِوَعدِك",32,"ك",1,1],["لِم لا أَمُدُّ يَدي حَتّى أَنالَ بِها","مَدى النُجومِ إِذا ما كُنتَ لي عَضُدا",33,"د",2,0],["لِمَ لا يَموتُ فَتىً يُعَذِّبُهُ","صَنَمٌ لَهُ مِن فِضَّةٍ نَحرُ",34,"ر",1,0],["لِمُلوكٍ في الذُرى مِن مَذحِجٍ","وَقَعَت مُبعِدَةً عَنها السُوَق",35,"ق",1,0],["لِم لَم أُعَوِّضهُ شُكراً عَن تَطَوُّلِهِ","إِذ لَم أُكايِلهُ إِفضالاً بِإِفضالِ",36,"ل",1,0],["لِمَ لا ألاحِظُهُ بِعَيْنِ جَلالَةٍ","وبه إلى اللهِ الصَّحائِفُ تُرفِعُ",37,"ع",1,0],["لِمَ لا نُبادِرُ ما نَراهُ يَفوتُ","إِذ نَحنُ نَعلَمُ أَنَّنا سَنَموتُ",38,"ت",1,1],["لِمَ لا يكرمُ ذلك الليث الذي","جَمَعَ الضراغمَ كلها في غابِهِ",39,"ب",2,0],["لم لا تفيضُ مدامعاً ومواجعاً","لصديقكَ الثاوي بغيرِ مآبِ",40,"ب",1,0],["لم لا توفيك الجَمي","ل وتَستَقلّ لك الفداء",41,"ا",2,0],["لِمَ لا أثور اليومَ ثورتهم","لِمَ لا أجرّبُ ما يحبونا",42,"ن",2,0],["لِمَ لا أصيح اليوم صيحتهم","لِمَ لا أضجّ كما يضجونا",42,"ن",2,0],["لِمَ لا تذوق كؤوسهم شفتي","إنَّ الحجا سمّي وتدميري",42,"ي",1,0],["لِم لا ترقُّ لَنا بِقَلبِكَ قَسوَة","أَخُلِقْتِ إِلّا غادَة مِكسالا",43,"ل",2,0],["لِمَ لَم أَمُت حُزناً لِمَ لَم أَمُت أَسَفاً","لِمَ لَم أَمُت جَزَعاً لِمَ لَم أَمُت كَمَدا",44,"د",2,0],["لِمَ لَم أَقُل حَسبي فَأَذهَلَ عَن","مَن لَم يَقُل مِن هَجرِهِ حَسبي",45,"ي",1,0],["لمَ لا ترقُّ لدمعِ عينِ ما رقا","وجوارحٍ جرْحَى وبالٍ قدْ بلي",46,"ي",1,0],["لمْ لا تضرِّجْ أدمعي خدي وقدْ","أُذكرتُ ظلاً بالمدينةِ سجسجا",47,"ج",2,0],["لمْ لا تحنُّ إليه يا قلبي وقدْ","غلبَ الحنينُ الجذعَ فيهِ وهيّجا",47,"ج",2,0],["لِمَ لا تُزْجَى السبايا فَتُرَى","مُرْدَفاتٍ تَشتَكِي مما تَجِدْ",48,"د",1,0],["لم لا يشُوبُ دُمُوعَهُ بِدِمائِه","ذو شيبَةٍ عَوْرَاتُها مَا تُخْضَبُ",49,"ب",1,0],["لِم لا يغارُ وقد رآني دونَه","أدركْتُ مِنْ خَيْرِ الوَرَى ما أطلُبُ",49,"ب",1,0],["لِمَ لا يُداوي نفسَه من جودهِ","مَن كان يمكنُه دواءُ الجود",50,"د",1,0],["لِمَ لا وقد ألبَستَني النِّعَمَ التي","لم تُبقِ لي في الناس غيرَ حسود",50,"د",1,0],["لِم لا أُؤَمِّلُ رَحمَةً مِن قادِرٍ","وَالسولُ يُطَلَبُ في السَحابِ الأَسوَلِ",51,"ل",1,1],["لم لا تحذر العواقب في غي","ر الدنايا؟ أو ما عليك حرام",52,"م",1,0],["لِمَ لا أغنيكم قوافيَّ التي","غنَّى بملحمة الحياة طروبها",53,"ب",3,0],["لِمَ لاَ تَشَابُهِ بَيْنَ أَيَّ","امٍ تَمُرُّ عَلَى اطِّرَادِ",54,"د",1,1],["لم لا تقولون إن العرب قاطبة","تيتموا كان زغلول أباً لهم",55,"م",1,0],["لم لاتقولون أن الغرب مضطرب","لم لاتقولون أن الشرق مضطرم",55,"م",1,0],["لِم لا وَأَنتَ اِبنُ بَحرٍ","تَمتارُ مِنهُ البِحارُ",56,"ر",1,0],["لملمي يا ذرا الجبال بقايا النسر","وارمي بها صدور العصور",57,"ر",1,0],["لم لا، وأنت بحقه","في كل آونة تُهيب؟",58,"ب",1,0],["لِمَ لا، ولم أرَ بينه","أبدًا وبينَ الجحش فرقا؟",59,"ق",2,0],["لِمَ لا، وأعمدةُ الضيا","ء بها بُدُورٌ في الكمال؟",60,"ل",1,0],["لِمَ لا وأنت لديَّ سابِقٌ حَلْبة ٍ","تُزْهَى بمنْ في السَّابقين تأدَّبا",61,"ب",2,0],["لم لا يكونُ الليث والنَّقد العِدا","من كنت أنت مصوراً في قلبِه",62,"ه",1,0],["لم لا تنال العلا أو يعقد التاج","والمشتري طالع والشمس هيلاج",63,"ج",1,1],["لم لا يناديها ؟ وكيف ؟ ويختفي","عنه اسمها ، ويضيع في الاوصاف",64,"ف",1,0],["لِمَ لَمْ تَدْعُهم إلى الهمّة ِ الشَّ","ماءِ والعلمِ والطِّماحِ المُزاحم؟",65,"م",1,0]]}