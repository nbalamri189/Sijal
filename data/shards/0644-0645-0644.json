ا",122,"ل",2,0],["لَم لا أَهيم بِه وَوَجنَتِه حكت","نيران قَلبي حينَ هامَ بوجده",123,"د",2,0],["لِمْلاّكِ قلبي بالهوَى ولِمالِكي","بسالفةِ النُّعْمَى الّتي كان أَنْعَما",124,"م",2,0],["لِمْ لستِ تَلقَيْنَ قَصْداً مَن على يدِه","أضحَتْ أيادي مُلوكِ الأرضِ تَلْقاك",125,"ك",1,0],["لمُلْكِ بني العبّاسِ تَعْدو بهامِها","فيشْكُرُ منها السّعْيَ مَلْكٌ مُؤَيَّد",126,"د",1,0],["لِمَ لا يَطيرُ القَلبُ لِل","خَفَقانِ نَحوَكُمُ جَنَاحا",127,"ح",2,0],["لِمَ لا تُفَدّى بِالعُيونِ يَدٌ إِذا","أَعَطت فَكُلُّ يَدٍ تَروحُ بِعَينِ",128,"ن",1,0],["لِمَ لا أُهَوِّنُهُ وَقَد","قَدَّمتُ روحِيَ قَبلَ جِسمي",129,"م",2,0],["لمُلِمٍّ مِن الحَوادِثِ لا يَك","شِفُهُ غَيرُ لَفِّ خَيلٍ بِخَيلِ",130,"ل",1,0],["لم لا أكون مُشاركاً لك قائماً","بالذل مضنوكاً بفعلك مُهْجِسا",131,"س",2,0],["لم لا تكذِّبُها متى ما حدثت","بالسوء إن السوء فيها يَهجِس",132,"س",1,0],["لِم لا وَفَتح اللُهِ مِنها","عادَ المرّاءِ جالب",133,"ب",1,0],["لِمَ لا يرق فُؤادَهُ القاسي","لِمدنفِهِ وَيَرحَم",134,"م",1,0],["لِمَ لا تَرثي لِصَب","مَن تَجنيك سَقيم",135,"م",1,0],["لم لا يَحلل لي الشَفا","ءَ مِن السقام المُسقم",136,"م",1,0],["لِمَ لا أَبيتُ عَلى الفِراشِ مسهَّداً","وَقَد اِشتَكى عُضوٌ من اِعضاءِ النَبِيِّ",137,"ي",1,0],["لِم لا يَعودُ العَذلُ يُر","ميني حَواصِبَهُ صَوارِد",138,"د",1,0],["لِم لا أَرى ظَبياً تَخَط","طَرَ في الربايب وَالمهادد",138,"د",1,0],["لَمْلِموا أوراقَكم وارتحلو","عن حمى الإسلامِ يامستخربون",139,"ن",1,0],["لِمَ لا يطول على الورى","من كان حيدرةٌ إمامه",140,"م",2,0],["لِمَ لاَ وقَد وَشَّتْ مطارفَها","كفُّ المليكِ النَّدبِ ذي الكرمِ",141,"م",1,1],["لِمْ لاَ تَصامَمتْ عن داعِي الفِراقِ ومَا","بَالِي صَلِيتُ لَظَاهُ وهو يَحتدِمُ",142,"م",1,0],["لِمَ لا تَرِقُّ لناظرٍ أرَّقْتَه","وحَشا حشاهُ الوجدُ جَذْوةَ واقِدِ",143,"د",1,0],["لِمُلِمٍ تَتَرجَّى نَقْصَه","ونوالٍ تبتَغي منه ازديادا",144,"د",2,0],["لِمْ لَمْ يُشرَّف على الدُّنيا بأجمعها","من كانَ أشرف هذي الكائنات إبا",145,"ب",2,0],["لمَ لا يُؤَمَّل للإِغاثة كلّها","من كانَ قطب الغوث من أجداده",146,"د",2,0],["لِمَ لا أُسَرُّ بأيَّام الهنا وأنا","إنْ سُرَّ محمود يوماً كنت مسرورا",147,"ر",2,0],["لم لا أفيض الدما من مقلتيّ كما","فاضت أياديهِ بين الناس تيارا",148,"ر",2,0],["لِمَ لا أَخِرُّ وهذا الطُّولُ يأْمُرُنِي","بما تقدَّمَهُ من غيرِيَ الطُّورُ",149,"ر",1,0],["لم لا يكون الشكْرُ عندك مُنتِجاً","ويداكَ قد قاما بأمرِ لقاحه",150,"ح",2,0],["لم لا وقد صادفتَ بحراً لو أتى","أولادُ جَفنةَ غُرِّقوا بجِفانِه",151,"ن",2,0],["لِمُلْكٍ لا يُراعُ بِرَيْبِ دَهْرٍ","وسَعْدٍ لا يحورُ إِلَى انقضاءِ",152,"ا",2,0],["لمَلْءِ عيونِهِمُ من بهاءٍ","ومَلْءِ صدورِهمُ من وِدَادِ",153,"د",1,0],["لمُلكٍ نَمى عَبدُ المَلِيكِ مُلُوكَهُ","وأَنْجُمِ نورٍ من هِشامٍ تُمِدُّهُ",154,"د",2,0],["لم لا نفتش في شعور مخلص","للحق دون تحزّب وهوان",155,"ن",1,0],["لم لا وللنيروز روعة ساحر","قد جال بين عواطف ومرائي",156,"ي",1,0],["لمَ لا وكل الخلقِ يغمرهم رضىً","حتى الذين سعوا الى التزييدِ",157,"د",1,0],["لملمها المجدُ وهي منه","تبرقُ ما بين الراحتينِ",158,"ن",1,0],["لملمها عبد الرحيم وسقى","أيوب بالمفعَم من سِجالها",159,"ل",3,0],["لِم لا وَقد رُسِمَت قبلاً لها صورٌ","لَم يولِ هندسةً فيها وإتقانا",160,"ن",2,0],["لِمْ لا أتيتهُ على الرِّماحِ اذا","فخُرَتْ وتحسُدني الظُّبى البُتر",161,"ر",1,1],["لم لا تلاقوا يا محلقة اللحى","يا رفضة الرفض الخسيس الخاسيه",162,"ي",2,0],["لم لا يدافعُ عن علائك وازعاً","أحداثه وبكم علا مقداره",163,"ر",2,0],["لملكتَ الحسنَ فكلٌّ من","ك يحوز الحسنَ ويكتسب",164,"ب",1,0],["لِمَ لَيسَ تَخضِبُ قُل لي","وَفي الخِطابَ جَمالُ",165,"ل",1,0],["لِمَ لا نُوَفّي يَومَنا حَقَّه","وَنَشمُتُ الفَطنَةَ بِالغِرَّه",166,"ر",2,0],["لِمَ لا يَجودُ بِهَجرِ هَجرِه","مَن ما لَهُ عُذرٌ بِعُذرِه",167,"ر",2,1],["لِمَ لا تَرِقُّ لِعاشِقٍ","مُتَعَثِّرٍ بِذُيولِ كَربِه",168,"ب",2,0],["لِمَ لا تَكونُ طِرازاً","لِحُلَّةِ الأَتقِياءِ",169,"ا",2,0],["لَمُلِمٌّ بِها وإِن أُبتُ مِنها","صادِراً كالَّذي وَرَدتُ بِداءِ",170,"ا",2,0],["لِمْ لا تَقَطَّعُ بعدَ البينِ مِن حَزَنٍ","حتى تحدَّرَ مِن أهوالِه قِطَعا",171,"ع",2,0],["لم لا وأنت هو المطالب أولا","بحقوقكم وأنا هو المصلوب",172,"ب",1,0],["لم لا يكون شجيا","وفيه أحرف مصرا",173,"ر",2,0],["لم لا وفيك خلال لا نظير لها","لطفا وحلما وفي أخلاقك الكرم",174,"م",1,0],["لم لا ورائدنا الدين المتين وفي","أصلابنا غذيت من دره النسم",174,"م",1,0],["لم لا وصالح عصره ابن ملوكة","سماك منجيا فكان مشيرا",175,"ر",2,0],["لِم لَمْ تَخرِّي يا سما","ء ولم تصبّي يا غمامه",176,"م",2,0],["لم لا اراعي بالاطاعة حاكياً","تختل اوضاع الهوى بملاله",177,"ل",2,0],["لَملت عَلى لَيلى بِنَفسي ميلَةً","وَلَو كانَ في يَومِ التِحالقِ وَالنَحرِ",178,"ر",1,0],["لمَليكنا المَحبوبِ كلُّ سعادةٍ","وله إلهُ العالَمينَ نَصيرُ",179,"ر",1,0],["لِمَ لمّا أردتَ بيعي ولم أُحْ","وِجْ إلى البيع بعتنِي بالطّفيفِ",180,"ف",1,0],["لِمَ لا أُصِرّ على البَطَالَةِ والهَوَى","وعلى بَرْدِ شَبِيْبَتي وإِزَارِها",181,"ر",3,1],["لِمْ لا أَجبتَ ولو بِنَثْرٍ","عما كَتُبْتُ ولو بِعُذْر",182,"ر",1,1],["لِمْ لا أُهينُ صِغارَهم","وكبارَهم تيهاً وكِبْرَا",183,"ر",2,0],["لِمَ لا أَخون ولم أَفِ أَبداً","وأَبي الزّمانُ وأُميَ الدُّنْيا",184,"ي",2,0],["لِمَ لا تُصالحِ قُبْلَتي يا خدَّها","والماءُ فيكَ مع اللَّهيبِ قَد اصْطَلح",185,"ح",1,0]]}