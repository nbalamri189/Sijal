"رام قلبي السلو عن أسماء","https://www.aldiwan.net/poem4621.html","الخفيف"],[479,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[481,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[481,"أبدى البيانو بيانا","https://www.aldiwan.net/poem36976.html","المجتث"],[481,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[481,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[497,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[506,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[518,"الام على ليلى ولو استطيعها","https://www.aldiwan.net/poem48669.html","الطويل"],[540,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[553,"قل لخل له وإن كان لا يد","https://www.aldiwan.net/poem47384.html","الخفيف"],[569,"لم لا أصر على البطالة والهوى","https://www.aldiwan.net/poem69690.html","الكامل"],[577,"لم لا أجبت ولو بنثر","https://www.aldiwan.net/poem2720.html","مجزوء الكامل"],[577,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[577,"أتخون يا سكني فقال نعم","https://www.aldiwan.net/poem2824.html","أحذ الكامل"],[577,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["لِمَ لاَ وَرَبَّكَ قَدْ قَضَى لَكَ بِالْعُلاَ","وَبِنَصْرِ مُلْكِكَ أَحْكَمَ الأَحْكَامَا",0,"م",2,0],["لِمُلْكِكَ عُقْبَى النَّصْر فارْقبْ طُلُوعَهَا","فَقَدْ آنَ لِْلإِسْلاَمِ آنُ اقْتِبَالِهِ",1,"ل",2,0],["لِم لا تُنالُ العُلى أو يُعْقَدُ التّاجُ","والمُشْتَري طالِعٌ والشّمْسُ هِلاجُ",2,"ج",1,1],["لِمْ لا أزُورُكَ يا أنْدَى المُلوكِ يَداً","ويا سِراجَ اللّيالي المُدْلَهِمّاتِ",3,"ت",1,0],["لِمَ لاَ يَكُونُ اللَّيْثُ وَالنَّقْدُ الْعِدَى","مَنْ كُنْتَ أَنْتَ مُصَوَّراً فِي قَلْبِهِ",4,"ه",1,0],["لِمَ لا أَزورُكَ يا حُسَينُ لَكَ الفِدا","قَومي وَمَن عَطَفَت عَلَيهِ نِزارُ",5,"ر",1,0],["لِمَ لا يطاوعُه الوجودُ وقد غدا","من نوره في خلقه معلولا",6,"ل",2,0],["لِمْ لا أحنُّ وهذا الجِذْعُ حَنَّ لَهُ","لما تباعد عن لُقياه وانْتَزَحَا",7,"ح",2,0],["لمَ لم تعوا ما قلن قبل مكرّراً","أو ما كفاكم ذلك التصريح",8,"ح",1,0],["لمَ لم تحفَظوا أخوّة دين","جاءكم ناطقاً بها التنزيل",9,"ل",1,0],["لِم لا يَفوقانِ الأَنامَ مَكارِماً","وَالسَيِّدانِ كِلاهُما جَدّاهُما",10,"م",2,0],["لِمْ لا يكون أميناً في ممالِكها","وهو العزيزُ عليها وابن يعقوب",11,"ب",1,0],["لم لأنسَ لثمكَ لما","أحسستُ بالموتِ بعدَك",12,"ك",1,0],["لم لا أشبّب بالعيش الذي سلفت","أوقاته وهو باللذَّات موصول",13,"ل",1,0],["لِمْ لا وذكراهُمْ له","رَوْحٌ إذا ما الهمُّ نابهْ",14,"ب",2,0],["لِمَ لا نَوَدُّ لكَ البقاءَ مُنَفَّلاً","طولَ السَّلامةِ والمعاشَ الأفسحا",15,"ح",2,0],["لِمَ لا أجرَّبُ في الضرائب مرة","يا للرجال وإنني لَمُهندُ",16,"د",1,0],["لم لا أُحلَّى حليةً أنا أهلُها","فيُزان بي بَطَلٌ ويُكْفَى مشهدُ",16,"د",1,0],["لملاقاةِ ليثِ غيلٍ هَصورٍ","ومُداهاةِ حيَّةٍ نَضْناض",17,"ض",1,0],["لِم لُمتني متغطْرساً","لا درّ درُّك من خليط",18,"ط",1,0],["لم لا يكون كذا وقد أُلبِستَه","فلبست فيه سكينة وخشوعا",19,"ع",2,0],["لِمْ لا تكونُ لدى إمامِك مُرتضىً","لا يبتغي بك في الكُفاةِ بديلا",20,"ل",2,0],["لمْ لا تلوذ بك الخلافةُ بعدما","أثبتّ مرساها وفيه تزلزلُ",21,"ل",1,0],["لم لا وأنت إذا سألنا مُفضلٌ","ومتى هفونا هفوةً فحليمُ",22,"م",1,0],["لِمَ لا تَهيمُ بِيَ المَسامِعُ مِثلَهُ","ما الفَرقُ بَينَ جَناحِه وَجَناحي",23,"ح",2,0],["لِم لايُرَجّى مِنكَ إِدراكُ المُنى","وَأَبوكَ في يَومِ الفَخارِ أَبوكا",24,"ك",2,0],["لم لا أقيمك للشباب منارة","وسبيل خير يسلكون سواءها",25,"ا",3,0],["لِمَ لا يَلينُ لَكَ الحَديدُ وَلَم تَزَل","تَتلو عَلَيهِ وَتَقرَأُ التَنزيلا",26,"ل",2,0],["لِمَ لَم تَدعُهُم إِلى الهِمَّةِ الشَم","ماءِ وَالعِلمِ وَالطِماحِ المُزاحِم",27,"م",1,0],["لِم لا تُطِلُّ مِنَ السَماءِ وَإِنَّما","بَينَ السَحابِ قُبورُها وَالأَنجُمِ",28,"م",1,0],["لِمَ لا يُفتَنُ فِتيانَ الحِمى","ذَلِكَ الإِقدامُ أَو ذاكَ الطِماح",29,"ح",1,0],["لِمَ لا تَحذَرُ العَواقِبَ في غَي","رِ الدَنايا أَما عَلَيكَ حَرامُ",30,"م",1,0],["لم لا يُغاث الشعر وهو يصيحُ","ويُرى منار الحق وهو يلوحُ",31,"ح",1,1],["لِمَ لا تَرِقُّ لِذُلِّ عَبدِك","وَخُضوعِهِ فَتَفي بِوَعدِك",32,"ك",1,1],["لِم لا أَمُدُّ يَدي حَتّى أَنالَ بِها","مَدى النُجومِ إِذا ما كُنتَ لي عَضُدا",33,"د",2,0],["لِمَ لا يَموتُ فَتىً يُعَذِّبُهُ","صَنَمٌ لَهُ مِن فِضَّةٍ نَحرُ",34,"ر",1,0],["لِمُلوكٍ في الذُرى مِن مَذحِجٍ","وَقَعَت مُبعِدَةً عَنها السُوَق",35,"ق",1,0],["لِم لَم أُعَوِّضهُ شُكراً عَن تَطَوُّلِهِ","إِذ لَم أُكايِلهُ إِفضالاً بِإِفضالِ",36,"ل",1,0],["لِمَ لا ألاحِظُهُ بِعَيْنِ جَلالَةٍ","وبه إلى اللهِ الصَّحائِفُ تُرفِعُ",37,"ع",1,0],["لِمَ لا نُبادِرُ ما نَراهُ يَفوتُ","إِذ نَحنُ نَعلَمُ أَنَّنا سَنَموتُ",38,"ت",1,1],["لِمَ لا يكرمُ ذلك الليث الذي","جَمَعَ الضراغمَ كلها في غابِهِ",39,"ب",2,0],["لم لا تفيضُ مدامعاً ومواجعاً","لصديقكَ الثاوي بغيرِ مآبِ",40,"ب",1,0],["لم لا توفيك الجَمي","ل وتَستَقلّ لك الفداء",41,"ا",2,0],["لِمَ لا أثور اليومَ ثورتهم","لِمَ لا أجرّبُ ما يحبونا",42,"ن",2,0],["لِمَ لا أصيح اليوم صيحتهم","لِمَ لا أضجّ كما يضجونا",42,"ن",2,0],["لِمَ لا تذوق كؤوسهم شفتي","إنَّ الحجا سمّي وتدميري",42,"ي",1,0],["لِم لا ترقُّ لَنا بِقَلبِكَ قَسوَة","أَخُلِقْتِ إِلّا غادَة مِكسالا",43,"ل",2,0],["لِمَ لَم أَمُت حُزناً لِمَ لَم أَمُت أَسَفاً","لِمَ لَم أَمُت جَزَعاً لِمَ لَم أَمُت كَمَدا",44,"د",2,0],["لِمَ لَم أَقُل حَسبي فَأَذهَلَ عَن","مَن لَم يَقُل مِن هَجرِهِ حَسبي",45,"ب",2,0],["لمَ لا ترقُّ لدمعِ عينِ ما رقا","وجوارحٍ جرْحَى وبالٍ قدْ بلي",46,"ل",2,0],["لمْ لا تضرِّجْ أدمعي خدي وقدْ","أُذكرتُ ظلاً بالمدينةِ سجسجا",47,"ج",2,0],["لمْ لا تحنُّ إليه يا قلبي وقدْ","غلبَ الحنينُ الجذعَ فيهِ وهيّجا",47,"ج",2,0],["لِمَ لا تُزْجَى السبايا فَتُرَى","مُرْدَفاتٍ تَشتَكِي مما تَجِدْ",48,"د",1,0],["لم لا يشُوبُ دُمُوعَهُ بِدِمائِه","ذو شيبَةٍ عَوْرَاتُها مَا تُخْضَبُ",49,"ب",1,0],["لِم لا يغارُ وقد رآني دونَه","أدركْتُ مِنْ خَيْرِ الوَرَى ما أطلُبُ",49,"ب",1,0],["لِمَ لا يُداوي نفسَه من جودهِ","مَن كان يمكنُه دواءُ الجود",50,"د",1,0],["لِمَ لا وقد ألبَستَني النِّعَمَ التي","لم تُبقِ لي في الناس غيرَ حسود",50,"د",1,0],["لِم لا أُؤَمِّلُ رَحمَةً مِن قادِرٍ","وَالسولُ يُطَلَبُ في السَحابِ الأَسوَلِ",51,"ل",1,1]