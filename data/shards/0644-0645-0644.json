ُ لَفِّ خَيلٍ بِخَيلِ",126,"ل",1,0],["لم لا أكون مُشاركاً لك قائماً","بالذل مضنوكاً بفعلك مُهْجِسا",127,"س",2,0],["لم لا تكذِّبُها متى ما حدثت","بالسوء إن السوء فيها يَهجِس",128,"س",1,0],["لِم لا وَفَتح اللُهِ مِنها","عادَ المرّاءِ جالب",129,"ب",1,0],["لِمَ لا يرق فُؤادَهُ القاسي","لِمدنفِهِ وَيَرحَم",130,"م",1,0],["لِمَ لا تَرثي لِصَب","مَن تَجنيك سَقيم",131,"م",1,0],["لم لا يَحلل لي الشَفا","ءَ مِن السقام المُسقم",132,"م",1,0],["لِمَ لا أَبيتُ عَلى الفِراشِ مسهَّداً","وَقَد اِشتَكى عُضوٌ من اِعضاءِ النَبِيِّ",133,"ي",1,0],["لِم لا يَعودُ العَذلُ يُر","ميني حَواصِبَهُ صَوارِد",134,"د",1,0],["لِم لا أَرى ظَبياً تَخَط","طَرَ في الربايب وَالمهادد",134,"د",1,0],["لَمْلِموا أوراقَكم وارتحلو","عن حمى الإسلامِ يامستخربون",135,"ن",1,0],["لِمَ لا يطول على الورى","من كان حيدرةٌ إمامه",136,"م",2,0],["لِمَ لاَ وقَد وَشَّتْ مطارفَها","كفُّ المليكِ النَّدبِ ذي الكرمِ",137,"م",1,1],["لِمْ لاَ تَصامَمتْ عن داعِي الفِراقِ ومَا","بَالِي صَلِيتُ لَظَاهُ وهو يَحتدِمُ",138,"م",1,0],["لِمَ لا تَرِقُّ لناظرٍ أرَّقْتَه","وحَشا حشاهُ الوجدُ جَذْوةَ واقِدِ",139,"د",1,0],["لِمُلِمٍ تَتَرجَّى نَقْصَه","ونوالٍ تبتَغي منه ازديادا",140,"د",2,0],["لِمْ لَمْ يُشرَّف على الدُّنيا بأجمعها","من كانَ أشرف هذي الكائنات إبا",141,"ب",2,0],["لمَ لا يُؤَمَّل للإِغاثة كلّها","من كانَ قطب الغوث من أجداده",142,"د",2,0],["لِمَ لا أُسَرُّ بأيَّام الهنا وأنا","إنْ سُرَّ محمود يوماً كنت مسرورا",143,"ر",2,0],["لم لا أفيض الدما من مقلتيّ كما","فاضت أياديهِ بين الناس تيارا",144,"ر",2,0],["لِمَ لا أَخِرُّ وهذا الطُّولُ يأْمُرُنِي","بما تقدَّمَهُ من غيرِيَ الطُّورُ",145,"ر",1,0],["لم لا يكون الشكْرُ عندك مُنتِجاً","ويداكَ قد قاما بأمرِ لقاحه",146,"ح",2,0],["لم لا وقد صادفتَ بحراً لو أتى","أولادُ جَفنةَ غُرِّقوا بجِفانِه",147,"ن",2,0],["لِمُلْكٍ لا يُراعُ بِرَيْبِ دَهْرٍ","وسَعْدٍ لا يحورُ إِلَى انقضاءِ",148,"ا",2,0],["لمَلْءِ عيونِهِمُ من بهاءٍ","ومَلْءِ صدورِهمُ من وِدَادِ",149,"د",1,0],["لمُلكٍ نَمى عَبدُ المَلِيكِ مُلُوكَهُ","وأَنْجُمِ نورٍ من هِشامٍ تُمِدُّهُ",150,"د",2,0],["لم لا نفتش في شعور مخلص","للحق دون تحزّب وهوان",151,"ن",1,0],["لم لا وللنيروز روعة ساحر","قد جال بين عواطف ومرائي",152,"ي",1,0],["لمَ لا وكل الخلقِ يغمرهم رضىً","حتى الذين سعوا الى التزييدِ",153,"د",1,0],["لملمها المجدُ وهي منه","تبرقُ ما بين الراحتينِ",154,"ن",1,0],["لملمها عبد الرحيم وسقى","أيوب بالمفعَم من سِجالها",155,"ل",3,0],["لِم لا وَقد رُسِمَت قبلاً لها صورٌ","لَم يولِ هندسةً فيها وإتقانا",156,"ن",2,0],["لِمْ لا أتيتهُ على الرِّماحِ اذا","فخُرَتْ وتحسُدني الظُّبى البُتر",157,"ر",1,1],["لم لا تلاقوا يا محلقة اللحى","يا رفضة الرفض الخسيس الخاسيه",158,"ي",2,0],["لم لا يدافعُ عن علائك وازعاً","أحداثه وبكم علا مقداره",159,"ر",2,0],["لملكتَ الحسنَ فكلٌّ من","ك يحوز الحسنَ ويكتسب",160,"ب",1,0],["لِمَ لَيسَ تَخضِبُ قُل لي","وَفي الخِطابَ جَمالُ",161,"ل",1,0],["لِمَ لا نُوَفّي يَومَنا حَقَّه","وَنَشمُتُ الفَطنَةَ بِالغِرَّه",162,"ر",2,0],["لِمَ لا يَجودُ بِهَجرِ هَجرِه","مَن ما لَهُ عُذرٌ بِعُذرِه",163,"ر",2,1],["لِمَ لا تَرِقُّ لِعاشِقٍ","مُتَعَثِّرٍ بِذُيولِ كَربِه",164,"ب",2,0],["لِمَ لا تَكونُ طِرازاً","لِحُلَّةِ الأَتقِياءِ",165,"ا",2,0],["لَمُلِمٌّ بِها وإِن أُبتُ مِنها","صادِراً كالَّذي وَرَدتُ بِداءِ",166,"ا",2,0],["لِمْ لا تَقَطَّعُ بعدَ البينِ مِن حَزَنٍ","حتى تحدَّرَ مِن أهوالِه قِطَعا",167,"ع",2,0],["لم لا وأنت هو المطالب أولا","بحقوقكم وأنا هو المصلوب",168,"ب",1,0],["لم لا يكون شجيا","وفيه أحرف مصرا",169,"ر",2,0],["لم لا وفيك خلال لا نظير لها","لطفا وحلما وفي أخلاقك الكرم",170,"م",1,0],["لم لا ورائدنا الدين المتين وفي","أصلابنا غذيت من دره النسم",170,"م",1,0],["لم لا وصالح عصره ابن ملوكة","سماك منجيا فكان مشيرا",171,"ر",2,0],["لِم لَمْ تَخرِّي يا سما","ء ولم تصبّي يا غمامه",172,"م",2,0],["لم لا اراعي بالاطاعة حاكياً","تختل اوضاع الهوى بملاله",173,"ل",2,0],["لَملت عَلى لَيلى بِنَفسي ميلَةً","وَلَو كانَ في يَومِ التِحالقِ وَالنَحرِ",174,"ر",1,0],["لمَليكنا المَحبوبِ كلُّ سعادةٍ","وله إلهُ العالَمينَ نَصيرُ",175,"ر",1,0],["لِمَ لمّا أردتَ بيعي ولم أُحْ","وِجْ إلى البيع بعتنِي بالطّفيفِ",176,"ف",1,0],["لِمَ لا أُصِرّ على البَطَالَةِ والهَوَى","وعلى بَرْدِ شَبِيْبَتي وإِزَارِها",177,"ر",3,1],["لِمْ لا أَجبتَ ولو بِنَثْرٍ","عما كَتُبْتُ ولو بِعُذْر",178,"ر",1,1],["لِمْ لا أُهينُ صِغارَهم","وكبارَهم تيهاً وكِبْرَا",179,"ر",2,0],["لِمَ لا أَخون ولم أَفِ أَبداً","وأَبي الزّمانُ وأُميَ الدُّنْيا",180,"ي",2,0],["لِمَ لا تُصالحِ قُبْلَتي يا خدَّها","والماءُ فيكَ مع اللَّهيبِ قَد اصْطَلح",181,"ح",1,0]]}