iwan.net/poem51677.html","الرمل"],[58,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[105,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[48,"من غائب في الحب لم يؤب","https://www.aldiwan.net/poem62414.html","البسيط"],[48,"إن البرامكة الذين تعلموا","https://www.aldiwan.net/poem64340.html","الكامل"],[48,"صفة الطلول بلاغة القدم","https://www.aldiwan.net/poem65092.html","الكامل"],[48,"ذكر الكرخ نازح الأوطان","https://www.aldiwan.net/poem66142.html","الخفيف"],[48,"لله أعيننا وهن من الخدى","https://www.aldiwan.net/poem66240.html","الكامل"],[50,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[50,"يا بان ضاق المذهب","https://www.aldiwan.net/poem64810.html","مجزوء الكامل"],[46,"أزعمت أنك آخذ من لذة","https://www.aldiwan.net/poem22956.html","الكامل"],[46,"وفر هذا الفتى مديد بسيط","https://www.aldiwan.net/poem23155.html","الخفيف"],[76,"يا دهر ما لي أطبي","https://www.aldiwan.net/poem39475.html","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117004","الكامل"],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[58,"أَحُسَيْنُ إنِّيَ واعِظٌ وَمُؤَدِّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=10082",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[113,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[126,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[133,"مطران ما حققت أمرك","https://www.aldiwan.net/poem49133.html","مجزوء الكامل"],[140,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.htm