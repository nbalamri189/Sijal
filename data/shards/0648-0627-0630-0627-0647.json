ww.poetsgate.com/ViewPoem.aspx?id=187721",""],[5131,"شرف الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=55359",""],[5186,"عتبي على الشعرآء نزق شعورهم","https://www.poetsgate.com/ViewPoem.aspx?id=156498",""],[5186,"أبدا تعن عليكم الأرباح","https://www.poetsgate.com/ViewPoem.aspx?id=156526",""],[5296,"لك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=154776",""],[5344,"حٌب وطيش ..","https://www.poetsgate.com/ViewPoem.aspx?id=155073",""],[5376,"وإذا هفتْ قبل الصباحِ ببسمها","https://www.poetsgate.com/ViewPoem.aspx?id=198992",""],[5725,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=186576",""],[5841,"قريته عكس ما يتلا","https://www.poetsgate.com/ViewPoem.aspx?id=34957",""],[5848,"الجهات الخمس","https://www.poetsgate.com/ViewPoem.aspx?id=53463",""],[5880,"الوحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=208578",""],[5956,"ألحانُ الحزن والفرح","https://www.poetsgate.com/ViewPoem.aspx?id=183900",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِذا هَمَمتُ بِمَن أُحِبُّ أَمالَني","حَصَرٌ يَعوقُ وَعِفَّةٌ تَنهاني",0,"ن",2,0],["وَإِذا هَتَفتَ بِهِم لِنائِبَةٍ","جَذَبوا وَراءَكَ بِالقَنا الذُبلِ",1,"ل",1,0],["وَإِذا هَتَفتَ بِهِم لِيَومِ كَريهَةٍ","تَدمى غَوارِبُ نَحرِها المَورودِ",2,"د",1,0],["وَإذا هُمُ رَغِمُوا وَقَدْ بَسَطَ العُلا","باعي فَذاكَ لَدَيَّ رَغْمٌ هَيِّنُ",3,"ن",1,0],["وَإِذا هُمُ عَادُوا لِمَا عَنْهُ نُهُوا","فَغِرَارُ سَيْفِكَ لِلْعُصَاةِ جَزَاءُ",4,"ا",2,0],["وَإِذا هَوَت فَكَما هَوَت","أُنثى العُقابِ عَلى الهَزاز",5,"ز",1,0],["وَإِذا هَبَّت شَمالٌ","أَو جَنوبٌ عَصِفَه",6,"ف",2,0],["وإذا هم جرُّوا الجرائر يوماً","فعلينا تكون فيها الحَماله",7,"ل",2,0],["وإذا هاتف يصيح به اقرأ","فيدوي الوجود بالأصداء",8,"ا",2,0],["وإذا هم تأوَّهوا","عند مرِّ القوارع",9,"ع",1,0],["وإذا هما عند الفعال تَباريا","فكأنما بارَى ابنُ مامةَ حاتما",10,"م",2,0],["وإذا هفا أهل الحلوم رسا به","حلمٌ يشولُ بَيَذْبُلٍ وأبان",11,"ن",1,0],["وَإِذا هَمَمنَ بِغِدرَةٍ أَزمَعنَها","خُلُفاً فَلَيسَ وِصالُهُنَّ يَدومُ",12,"م",1,0],["وَأَذاها في سُكوني كَأَذاها في اِضطِرابي","وَهيَ كَالقَيدِ لِساقي وَلِجيدي كَالسَخابِ",13,"ب",1,0],["وَإِذا هَوَت مِن حالِقٍ","هَوَتِ القُلوبُ مِنَ الصُدورِ",14,"ر",1,0],["وإذا هبَّتِ الطُّيورُ مع الفجرِ","تُغنِّي بَيْنَ المروجِ الجميلهْ",15,"ه",1,0],["واذا هلكت فكل شيء","بعد هلكي لا يضر",16,"ر",1,0],["وَإِذا هُمو حَجّوا القُبورَ حَسِبتَهُم","وَفدَ العَتيقِ بِهِم تَرامى الأَينُقُ",17,"ق",1,0],["وإِذا همُ حمِيَ الوطيسُ عليهِمُ","في مُشْكلٍ دَعَوُا الْأجلَّ الأفضلا",18,"ل",2,0],["وإِذا هَمَمْتَ جَرى القضاءُ بما تَرى","فكأنكَ المُتحكِّمُ المختارُ",19,"ر",1,0],["وَإِذا هَبَّتِ الجَنوبُ نَسيماً","فَعَلى رَسمِ دارِها وَالجَنابِ",20,"ب",1,0],["وَإِذا هَفا خِلّي بِغَيرِ تَعَمُّدٍ","أَغضَيتُ غَيرَ مُبايِنٍ وَمُمانِعِ",21,"ع",1,0],["وَإِذا هُمُ قَحَطوا فَأَعشَبُ مَربَعٍ","وَإِذا هُمُ فَزِعوا فَأَقرَبُ مَفزَعِ",22,"ع",1,0],["وإذا هي انغمست أفادت ربها","ما لا ينال بأعين البصراء",23,"ا",2,0],["وإذا هُزَّ لمَعروفٍ مضَى","كالحُسامِ العَضبِ إن هُزَّ بتَر",24,"ر",1,0],["وَإِذا هَمَمتَ بِسَيِّءٍ فَاِغمِض لَهُ","وَتَجَنَّبِ الأَمرَ الَّذي يُتَجَنَّبُ",25,"ب",1,0],["وَإِذا هَذَّبَ الرُواةُ قَريضاً","فيهِ قَد هَذَّبَ القَريضُ رُواتَه",26,"ت",2,0],["وإذا هُمُ ذكروا المحالَ فَقُلْ لهم","ما في الأُمور على الرجالِ مُحالُ",27,"ل",1,0],["وَإِذا هَبَّ نَفحَةً مِن نَعيم الط","طهر قامَت رَكينة أَركانُه",28,"ه",1,0],["وَإِذا هُمُ لِحَديثِهِم جَلَسوا","عَطَفوا أَكُفَّهُمُ عَلى الرُكَبِ",29,"ب",1,0],["وَإِذا هُمُ صَنَعوا الصَنيعَةَ في الوَرى","جَعَلوا لَها طولَ البَقاءِ لِباسا",30,"س",2,0],["وَإِذا هَتَفنَ بِها لِنازِلَةٍ","قَدَّمنَ كُنيَتَها عَلى الإِسمِ",31,"م",1,0],["وَإِذا هَزَّهُ الخَليفَةُ لِلجُل","لى مَضاها كَالصارِمِ الهُندُواني",32,"ن",2,0],["وإذا همُ فقدوا الأيورَ تعلّلوا","بذُرى الأصابع إنّهم لحراصُ",33,"ص",1,0],["وَإِذا هَويتَ فَلا يُعَيِّرُكَ الهَوى","إِلّا مَقالَةُ آخَرينَ صِحاحِ",34,"ح",1,0],["وَإِذا هَرَبتُ مِنَ الصَبا","بَةِ لَم يَكُن لي مَهرَبُ",35,"ب",1,0],["وَإِذا هَمَمتَ بِمَطلَبٍ لِتَنالَهُ","لاقيتَ مِن نوبِ الزَمانِ مُفَجَعا",36,"ع",2,0],["وَإِذا هَوَّلَت عَلَيَّ المَنايا","راقَني مِن وَعيدِها التَهويلُ",37,"ل",1,0],["وإِذا هُمُ ذَكرُوا الإسَا","ءَةَ أَكْثَرُوا الحَسَناتِ",38,"ت",1,0],["وإذا هذهِ الزنابقُ تمسي","وهي تهتزّ بالأريجِ المضاعِ",39,"ع",1,0],["وَإِذا هَمَمتُ بِوَصلِ غَيرِكَ رَدَّني","وَلَهُ إِلَيكَ وَشافِعٌ لَكَ أَوَّلُ",40,"ل",1,0],["وإذا همَمتُ لمُعتَفيكَ بنائلٍ","قال الندى فأطعته لك أكثِر",41,"ر",1,0],["وإذا هانَ أمرُهُ عند شعبٍ","فعَفاءٌ عليه أيُّ عفَاء",42,"ا",2,0],["وإذا هو انحَلَّت عُرى أَخْلاقِه","لم تُجْدِ فيه حِيلةُ المُحْتالِ",43,"ل",1,0],["وإذا هَمَمْتَ بِسَيِّىء ٍ فاغْمُضْ لهُ","وتجنب الأمر الذي يتجنب",44,"ب",1,0],["واذا هما – والموت بينهما -","مدّا من الجْيدينِ فاعتَنَقا",45,"ق",2,0],["وإذا هجته تلفّتت الدنيا","وهمّت أفلاكها بالسجود",46,"د",1,0],["واذا هفهف النسيم بطيب","هو لا شك هب فيه شذاكا",47,"ك",2,0],["وإذا هممتُ بذمِّ أهل زماني","فكرتُ في عيبي وفي نقصانِ",48,"ن",1,0],["وإذا هوِيت خلبتَ مَن","تهواهُ واستنزلت بدركْ",49,"ك",1,0],["وإذا هُم عدِموا مَقاودَ خيلهم","فتلوا لهنَّ ذوائبَ الفُرسانِ",50,"ن",1,0],["وَإِذا هُمُ اِفتَكَروا وَضَلَّ رَشادُهُم","أَوضَحتَ غَيرَ مُفَكِّرٍ ما أَشكَلا",51,"ل",2,0],["وَإِذا هَمَمتَ فَخُذ بِعَزمِكَ إِنَّهُ","قَمِنٌ بِما تَهوى وَخَلِّ الفالا",52,"ل",2,0],["وَإِذا هُمُ لَم يَبلُغوا شَأوَ العُلى","عَدَلوا إِلى الأَعمامِ وَالأَخوالِ",53,"ل",1,0],["وإذا هَواهُ أحاط بي فكأنني","فيه على التحريرِ نُقْطةُ قُطبِه",54,"ب",2,0],["وإذا همُ احتملوا إلى ترب","جسدي وإن رجعوا وقد قبروا",55,"ر",3,0],["وَإِذا هِيَ اِبتَسَمَت بَذا مُتَشَتَّتٌ","عَذبٌ تَروعُ بهِ فُؤادَ الحَالِمِ",56,"م",1,0],["وإذا همَّ أن تنولني يمنى يدي","هِ همتْ بسلبي يسرى",57,"ر",2,0],["واذا هُمُ مَلُّوا وفاءً أنكروا","ما لم يكن من قبل ذلك يُنكَرُ",58,"ر",1,0],["وَإِذا هَمَمتَ بِأَمرِ شَرٍّ فَاِتَّئِد","وَإِذا هَمَمتَ بِأَم