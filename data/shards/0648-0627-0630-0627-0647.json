],[145,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[146,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[146,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[146,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[188,"لو ذقت حين عتبت أيسر حبه","https://www.aldiwan.net/poem14091.html","الكامل"],[189,"يا غرفتي إن غرفة نطقت","https://www.aldiwan.net/poem43871.html","الكامل"],[198,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[202,"غير قلبي أراه يسطيع صبرا","https://www.aldiwan.net/poem45561.html","الخفيف"],[207,"هجر الملاح نصيب من لا يهجر","https://www.aldiwan.net/poem53308.html","الكامل"],[219,"أجُبيل إن أباك كاربُ يومه","https://www.aldiwan.net/poem683.html",""],[224,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[226,"أسمعيني لحن الردى أسمعيني","https://www.aldiwan.net/poem41621.html","الخفيف"],[274,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[300,"من لصب شفه جور النوى","https://www.aldiwan.net/poem32934.html","الرمل"],[307,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[331,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[331,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[341,"لا بر أعظم من مساعدة","https://www.aldiwan.net/poem68801.html","الكامل"],[345,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[352,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[356,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[364,"أيها الاهيف الذي أهواه","https://www.aldiwan.net/poem68044.html","الخفيف"],[367,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[367,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[374,"سل من أقام من استقلا","https://www.aldiwan.net/poem57228.html","مجزوء الكامل"],[380,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[380,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[405,"ما زلت عن درن الدنايا صائنا","https://www.aldiwan.net/poem46552.html","الكامل"],[406,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[409,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[409,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[413,"ذهب الفرزدق بالفخار وإنما","https://www.aldiwan.net/poem67499.html","الكامل"],[419,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[435,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[460,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[460,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[466,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[484,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[502,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[509,"أبلغ لديك أبا خليد وائلاً","https://www.aldiwan.net/poem2135.html","الكامل"],[517,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[517,"يا أيها الملك الذي","https://www.aldiwan.net/poem12304.html","مجزوء الكامل"],[540,"يا جلال العصر علما","https://www.aldiwan.net/poem47938.html","عموديه"],[542,"وإذا هرقت بكل دار عبرة","https://www.aldiwan.net/poem56749.html","الكامل"],[553,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[553,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[553,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[553,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[553,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[553,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[553,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[553,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[553,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[553,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[553,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[553,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[553,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[560,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[564,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[577,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29456","الكامل"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"]],"verses":[["وَإِذا هَمَمتُ بِمَن أُحِبُّ أَمالَني","حَصَرٌ يَعوقُ وَعِفَّةٌ تَنهاني",0,"ن",2,0],["وَإِذا هَتَفتَ بِهِم لِنائِبَةٍ","جَذَبوا وَراءَكَ بِالقَنا الذُبلِ",1,"ل",1,0],["وَإِذا هَتَفتَ بِهِم لِيَومِ كَريهَةٍ","تَدمى غَوارِبُ نَحرِها المَورودِ",2,"د",1,0],["وَإذا هُمُ رَغِمُوا وَقَدْ بَسَطَ العُلا","باعي فَذاكَ لَدَيَّ رَغْمٌ هَيِّنُ",3,"ن",1,0],["وَإِذا هُمُ عَادُوا لِمَا عَنْهُ نُهُوا","فَغِرَارُ سَيْفِكَ لِلْعُصَاةِ جَزَاءُ",4,"ا",2,0],["وَإِذا هَوَت فَكَما هَوَت","أُنثى العُقابِ عَلى الهَزاز",5,"ز",1,0],["وَإِذا هَبَّت شَمالٌ","أَو جَنوبٌ عَصِفَه",6,"ف",2,0],["وإذا هم جرُّوا الجرائر يوماً","فعلينا تكون فيها الحَماله",7,"ل",2,0],["وإذا هاتف يصيح به اقرأ","فيدوي الوجود بالأصداء",8,"ا",2,0],["وإذا هم تأوَّهوا","عند مرِّ القوارع",9,"ع",1,0],["وإذا هما عند الفعال تَباريا","فكأنما بارَى ابنُ مامةَ حاتما",10,"م",2,0],["وإذا هفا أهل الحلوم رسا به","حلمٌ يشولُ بَيَذْبُلٍ وأبان",11,"ن",1,0],["وَإِذا هَمَمنَ بِغِدرَةٍ أَزمَعنَها","خُلُفاً فَلَيسَ وِصالُهُنَّ يَدومُ",12,"م",1,0],["وَأَذاها في سُكوني كَأَذاها في اِضطِرابي","وَهيَ كَالقَيدِ لِساقي وَلِجيدي كَالسَخابِ",13,"ب",1,0],["وَإِذا هَوَت مِن حالِقٍ","هَوَتِ القُلوبُ مِنَ الصُدورِ",14,"ر",1,0],["وإذا هبَّتِ الطُّيورُ مع الفجرِ","تُغنِّي بَيْنَ المروجِ الجميلهْ",15,"ه",1,0],["واذا هلكت فكل شيء","بعد هلكي لا يضر",16,"ر",1,0],["وَإِذا هُمو حَجّوا القُبورَ حَسِبتَهُم","وَفدَ العَتيقِ بِهِم تَرامى الأَينُقُ",17,"ق",1,0],["وإِذا همُ حمِيَ الوطيسُ عليهِمُ","في مُشْكلٍ دَعَوُا الْأجلَّ الأفضلا",18,"ل",2,0],["وإِذا هَمَمْتَ جَرى القضاءُ بما تَرى","فكأنكَ المُتحكِّمُ المختارُ",19,"ر",1,0],["وَإِذا هَبَّتِ الجَنوبُ نَسيماً","فَعَلى رَسمِ دارِها وَالجَنابِ",20,"ب",1,0],["وَإِذا هَفا خِلّي بِغَيرِ تَعَمُّدٍ","أَغضَيتُ غَيرَ مُبايِنٍ وَمُمانِعِ",21,"ع",1,0],["وَإِذا هُمُ قَحَطوا فَأَعشَبُ مَربَعٍ","وَإِذا هُمُ فَزِعوا فَأَقرَبُ مَفزَعِ",22,"ع",1,0],["وإذا هي انغمست أفادت ربها","ما لا ينال بأعين البصراء",23,"ا",2,0],["وإذا هُزَّ لمَعروفٍ مضَى","كالحُسامِ العَضبِ إن هُزَّ بتَر",24,"ر",1,0],["وَإِذا هَمَمتَ بِسَيِّءٍ فَاِغمِض لَهُ","وَتَجَنَّبِ الأَمرَ الَّذي يُتَجَنَّبُ",25,"ب",1,0],["وَإِذا هَذَّبَ الرُواةُ قَريضاً","فيهِ قَد هَذَّبَ القَريضُ رُواتَه",26,"ت",2,0],["وإذا هُمُ ذكروا المحالَ فَقُلْ لهم","ما في الأُمور على الرجالِ مُحالُ",27,"ل",1,0],["وَإِذا هَبَّ نَفحَةً مِن نَعيم الط","طهر قامَت رَكينة أَركانُه",28,"ه",1,0],["وَإِذا هُمُ لِحَديثِهِم جَلَسوا","عَطَفوا أَكُفَّهُمُ عَلى الرُكَبِ",29,"ب",1,0],["وَإِذا هُمُ صَنَعوا الصَنيعَةَ في الوَرى","جَعَلوا لَها طولَ البَقاءِ لِباسا",30,"س",2,0],["وَإِذا هَتَفنَ بِها لِنازِلَةٍ","قَدَّمنَ كُنيَتَها عَلى الإِسمِ",31,"م",1,0],["وَإِذا هَزَّهُ الخَليفَةُ لِلجُل","لى مَضاها كَالصارِمِ الهُندُواني",32,"ن",2,0],["وإذا همُ فقدوا الأيورَ تعلّلوا","بذُرى الأصابع إنّهم لحراصُ",33,"ص",1,0],["وَإِذا هَويتَ فَلا يُعَيِّرُكَ الهَوى","إِلّا مَقالَةُ آخَرينَ صِحاحِ",34,"ح",1,0],["وَإِذا هَرَبتُ مِنَ الصَبا","بَةِ لَم يَكُن لي مَهرَبُ",35,"ب",1,0],["وَإِذا هَمَمتَ بِمَطلَبٍ لِتَنالَهُ","لاقيتَ مِن نوبِ الزَمانِ مُفَجَعا",36,"ع",2,0],["وَإِذا هَوَّلَت عَلَيَّ المَنايا","راقَني مِن وَعيدِها التَهويلُ",37,"ل",1,0],["وإِذا هُمُ ذَكرُوا الإسَا","ءَةَ أَكْثَرُوا الحَسَناتِ",38,"ت",1,0],["وإذا هذهِ الزنابقُ تمسي","وهي تهتزّ بالأريجِ المضاعِ",39,"ع",1,0],["وَإِذا هَمَمتُ بِوَصلِ غَيرِكَ رَدَّني","وَلَهُ إِلَيكَ وَشافِعٌ لَكَ أَوَّلُ",40,"ل",1,0],["وإذا همَمتُ لمُعتَفيكَ بنائلٍ","قال الندى فأطعته لك أكثِر",41,"ر",1,0],["وإذا هانَ أمرُهُ عند شعبٍ","فعَفاءٌ عليه أيُّ عفَاء",42,"ا",2,0],["وإذا هو انحَلَّت عُرى أَخْلاقِه","لم تُجْدِ فيه حِيلةُ المُحْتالِ",43,"ل",1,0],["وإذا هَمَمْتَ بِسَيِّىء ٍ فاغْمُضْ لهُ","وتجنب الأمر الذي يتجنب",44,"ب",1,0],["واذا هما – والموت بينهما -","مدّا من الجْيدينِ فاعتَنَقا",45,"ق",2,0],["وإذا هجته تلفّتت الدنيا","وهمّت أفلاكها بالسجود",46,"د",1,0],["واذا هفهف النسيم بطيب","هو لا شك هب فيه شذاكا",47,"ك",2,0],["وإذا هممتُ بذمِّ أهل زماني","فكرتُ في عيبي وفي نقصانِ",48,"ن",1,0],["وإذا هوِيت خلبتَ مَن","تهواهُ واستنزلت بدركْ",49,"ك",1,0],["وإذا هُم عدِموا مَقاودَ خيلهم","فتلوا لهنَّ ذوائبَ الفُرسانِ",50,"ن",1,0],["وَإِذا هُمُ اِفتَكَروا وَضَلَّ رَشادُهُم","أَوضَحتَ غَيرَ مُفَكِّرٍ ما أَشكَلا",51,"ل",2,0],["وَإِذا هَمَمتَ فَخُذ بِعَزمِكَ إِنَّهُ","قَمِنٌ بِما تَهوى وَخَلِّ الفالا",52,"ل",2,0],["وَإِذا هُمُ لَم يَبلُغوا شَأوَ العُلى","عَدَلوا إِلى الأَعمامِ وَالأَخوالِ",53,"ل",1,0],["وإذا هَواهُ أحاط بي فكأنني","فيه على التحريرِ نُقْطةُ قُطبِه",54,"ب",2,0],["وإذا همُ احتملوا إلى ترب","جسدي وإن رجعوا وقد قبروا",55,"ر",3,0],["وَإِذا هِيَ اِبتَسَمَت بَذا مُتَشَتَّتٌ","عَذبٌ تَروعُ بهِ فُؤادَ الحَالِمِ",56,"م",1,0],["وإذا همَّ أن تنولني يمنى يدي","هِ همتْ بسلبي يسرى",57,"ر",2,0],["واذا هُمُ مَلُّوا وفاءً أنكروا","ما لم يكن من قبل ذلك يُنكَرُ",58,"ر",1,0],["وَإِذا هَمَمتَ بِأَمرِ شَرٍّ فَاِتَّئِد","وَإِذا هَمَمتَ بِأَمرِ خَيرٍ فَاِفعَلِ",59,"ل",1,0],["وإذا هم بالنهيق ترى الكلب","بضرب من النهيق يجاري",60,"ر",2,0],["وَإِذا هزَّكِ التذكّرُ بِالرُغ","مِ وَشاءَ الودادُ أَن تذكريني",61,"ن",2,0],["واذا هبت صبا نجد لهم","فهمتهم عَن ربا نحد كلاما",62,"م",2,0],["وإذا هبَّت صَبا نَجدٍ صَبا","قَلبُه شَوقاً إلى نَجدٍ وحَنّا",63,"ن",2,0],["وإذا هممت يمنعني الح","ظ وشؤم الذنوب والاحترام",64,"م",1,0],["وإذا هاتفٌ يهزُّ سكوني","أنت أخطأت في التمني ظنوني",65,"ي",1,0],["وإذا همسةٌ ممزّقة الجر","س صداها كهمهمات الغريق",66,"ق",1,0],["وَإِذا هَفا فَأَقِلهُ هَفوَتَهُ","حَتّى يَعودَ أَخاً كَعادَتِه",67,"ت",2,0],["واذا هم تخاطروا","نحوه بالاصابع",68,"ع",1,0],["واذا هم تأوهوا","للمنايا الصوادع",68,"ع",1,0],["وَإِذا هاجَرتُ مَن هاجَرَني","بِالَّذي أَظهَرتَ لي زِيّاً بِزِي",69,"ي",1,0],["وَإِذا هَبَّت نُسَيمات الصبا","فَاِدَّكر صَبوَة أَيّام التَصابي",70,"ب",2,0],["وَاِذا هيج الهَوى نار أَحشا","تَولى وَقالَ وا أَسَفاه",71,"ا",2,0],["وإذا هَزَّ لخَطْبٍ قَلماً","ناب عن كُلِّ رقيقِ الشَّفْرتَين",72,"ن",1,0],["وإذا هجَمْتَ بجَمْعِهمْ كي يُصبِحوا","سَيْفاً على هامِ العِدا مَسلولا",73,"ل",2,0],["وَإذا هَمَمتُ وقَصَّرت","حالِي رَجعتُ أَموتُ هَزلا",74,"ل",2,0],["وإذا هفا قامت بعبء سقوطه","إخوانُه كي يُنهضوه إن رُمي",75,"م",2,0],["وإذا هَمَمتُ بأن أراكِ بمُقلةٍ","حَوراءِ عُدتُ بمُقلَةٍ شَكراءِ",76,"ا",2,0],["وإذا همُو وصفوا محاسِنَ شادنٍ","مُستكملٍ لِمَحاسِنِ الأوصافِ",77,"ف",1,0],["وإذا هزت قواماً مائلاً","فله أهتز كلي طربا",78,"ب",2,0],["وإذا هزّ يراعاً وجرى","منه بالخط رأيت العجبا",78,"ب",2,0],["وَإِذا هَزَّكَ الإِمام لِحَربٍ","أَو لِسلمٍ فَأَنتَ نَصرٌ وَنَصلُ",79,"ل",1,0],["وَإِذا هوَ اعتَقَلَ القَناة حَسِبتُها","صِلاً تأبَّطُهُ هزبَرٌ ضاري",80,"ر",2,0],["وَإِذا هَدَرتُ مَعَ القُرومُ مُحاضِراً","في مَوطِنٍ فَضَحَ القُرومَ هَديري",81,"ر",2,0],["وإذا هبَّت به ريحُ صَبا","راح يستشفي عليلٌ بعليل",82,"ل",1,0],["وإِذا هَوَّمَتْ صروفُ الليالي","فاطْرِحْ باعتناقِها التَّهويما",83,"م",2,0],["وإذا هُمُ وجدوا السيوف قصيرةً","في موطنٍ وجدوا خُطاك طِوالا",84,"ل",2,0],["وإذا هُجْنُ القوافي نُسِبَتْ","كانت العُربَ وكُنَّ النبطا",85,"ط",2,0],["وإذا همُ شاموا بروق غمودهم","تخذوا الغمودَ الهامَ بعد غمودها",86,"د",3,0],["وإذا هممت فطالب سع","د الذي",87,"ي",1,0],["وإذا هفهف النسيم تداعى","ولها من وجوده بنيانه",88,"ن",2,0],["وَإِذا هُمُ لَعِبوا عَلى أَحيانِهِم","لَم أَنصَرِف لَأَبيتَ حَتّى أَلعَبا",89,"ب",2,0],["وإذا هما افترقا ولم يتناصرا","عز العدو وذلت الأنصار",90,"ر",1,0],["وإذا هممت بكشف با","طنها أبت نفس أبيه",91,"ي",2,0],["وإذا هُم حَرَموهُ","ملأَ الآفاقَ شَتما",92,"م",2,0],["وَإِذا هَرَقتَ بِكُلِّ دارٍ عَبرَةً","نُزِفَ الشؤونُ وَدَمعُكَ اليَنبوعُ",93,"ع",1,1],["وإذا هبّت الخطوبُ ولم تك","فِ كَفَيْنا العظيم ثمّ العظيما",94,"م",2,0],["وإذا هُمُ قِيدوا إلي","ك فأنت رضوى أو شَمامُ",95,"م",1,0],["وإذا هُمُ سلموا وبات وليُّهمْ","مستهلكاً فكأنّهمْ لم يسلموا",96,"م",3,0],["وإذا هُمُ سُئِلوا ندىً وجدوا وقد","سَبقوا إليه قبل كلّ سؤالِ",97,"ل",1,0],["وإذا هُمُ لم يُحسنوا في قولهم","أشعارَهْم أحسنت كيف أقولُ",98,"ل",1,0],["وإذا هُمُ لبسوا المحاسِنَ أهْوَنوا","بملابسِ التِّيجانِ والأطواقِ",99,"ق",1,0],["وإِذا هُمُ طعنوا تريبَ مُجَرَّدٍ","أضحى بنسجِ نقيعه في فَيلقِ",100,"ق",1,0],["وإذا هَوَوْا من نجدةٍ في خُطَّةٍ","لم يَثْنِهمْ عنها نعيقُ النّاعقِ",101,"ق",1,0],["وإذا هُمُ نَكِروا غريباً فاجئاً","فَزِعوا بنُكرهمُ إلى تعريفي",102,"ف",2,0],["وإذا هبَّت الرِّياحُ فما زَعْ","زعنَ فينا إلّا البناءَ الرَّفيعا",103,"ع",2,0],["وَإِذا هُمُ اِعتَذَروا إِلى مَن لامَهُمْ","في الحِرصِ قالوا ما تراهُ طباعُ",104,"ع",1,0],["وَإِذا هُمُ بِالرغمِ منّا أدلجوا","أودى المُتَيَّمَ ذلك الإدلاجُ",105,"ج",1,0],["وإذا هُجرنَ فلا هُجِرْ","تَ مدى الزّمان ولا جُفيتا",106,"ت",2,0],["وإذا هبت الصبا هب قلبي","معها لايني ولا يتراخى",107,"خ",2,0],["وإذا همُ اعتَنقوا الكُماةَ تَلاحَموا","مثلَ الحُروفِ يضُمُّها التَّشديدُ",108,"د",1,0],["وإِذا هيَ اسْتترتْ صدوداً عَنْهمُ","فانظرْ لما هَتَكَتْهُ من أَسْتَارِهم",109,"م",1,0],["وَإِذا هَوَازِنُ جمَّعُوا فَتَناشَدُوا","جَنباتِهِم ألفَيتَني لَم أُنشدِ",110,"د",1,0],["وَإِذا هَبَّت شِمالاً أَطعَموا","في قُدورٍ مُشبَعاتٍ لَم تُجَع",111,"ع",1,0]]}