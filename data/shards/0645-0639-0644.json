,"https://www.poetsgate.com/ViewPoem.aspx?id=202840",""],[5595,"أطلقْ دموعَك ، فالأحزانُ تستعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=144533",""],[5595,"نعلّمُ جيلنا الكتبا","https://www.poetsgate.com/ViewPoem.aspx?id=158559",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5725,"الى ......","https://www.poetsgate.com/ViewPoem.aspx?id=202868",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5770,"تكريم المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=178686",""],[5997,"غريب","https://www.poetsgate.com/ViewPoem.aspx?id=214230",""],[5997,"غريب","https://www.poetsgate.com/ViewPoem.aspx?id=214478",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""]],"verses":[["مُعَلَّقَةٌ بِبَقايا الرَجاءِ","تَرى المَوتَ في كُلِّ يَومِ مِرارا",0,"ر",2,0],["معلّم أبناء البلاد طبيبهم","يُداوي سَقام الجهل والجهل مُسقِم",1,"م",1,0],["مُعلِناً للمُعَالِنين مُسرَّاً","للمُسِرِّينَ غَيرَ دَحضِ المَقَامِ",2,"م",1,0],["مُعَلِّلَتي بِالوَصلِ وَالمَوتُ دونَهُ","إِذا مِتَّ ظَمآناً فَلا نَزَلَ القَطرُ",3,"ر",1,0],["معلومي الثلث ويا ليته","ورسميَ النسخ وثوبي الرقاع",4,"ع",1,0],["معللة ماذا يفيد بها الفتى","تبايع كفّيه بحبل موصّل",5,"ل",1,0],["مُعَلَّلين بآمال تُخادعنا","وزخرف من غُرورِ العيش موصون",6,"ن",1,0],["مُعَلَّقَةٌ تَنَظَّرُ صَولَجاناً","يَخُرُّ عَنِ السَماءِ بِها لِعابا",7,"ب",2,0],["مُعلِقاً ما جَنى الزَمانُ وَذَنبي","في جِناياتِ صَرفِهِ ذَنبُ صُحرِ",8,"ر",1,0],["مُعَلِّلُهُ بِالوَعدِ لَيسَ يَفي بِهِ","وَقاتِلُهُ بِالحُبِّ لَيسَ يَديهِ",9,"ي",2,0],["مُعَلَّقَةً بِثُغرَتِهِ المَنايا","وَفَوقَ جَبينِهِ الأَجَلُ الخَدوعُ",10,"ع",1,0],["مُعْلَمٌ في الوغى إذا خاف غفلٌ","شُهرَةً مِنهُ للإِلالِ الحرارِ",11,"ر",1,0],["مُعلَماتٌ كَأَنَّها بِالدَمِ المُه","راقِ أَيّامُ النَحرِ وَالتَشريقِ",12,"ق",1,0],["معلّمٌ كالبدرِ مِنْ حولِهِ","كواكبٌ ترقبُ أوقاتا",13,"ت",2,1],["مُعلِمٌ يَضرِبُ المُدَجَّجَ بِالسَي","فِ إِذا صالَ دونَ سُمرِ العَوالي",14,"ل",2,0],["مُعَلَّمٍ مُنَخِّرٍ فَشّاشِ","يُسائِلُ الأَرضَ عَنِ المَعاشِ",15,"ش",1,0],["مُعَلَّمَةً مِن بَناتِ الرِيا","حِ إِذا سَأَلَت عَدوَها زادَها",16,"د",3,0],["م على الأسرة والأرائك","فأجبتها إني كذلك",17,"ك",1,0],["معلّم ما له ضريب","معهدهُ المسرحُ الحبيبُ",18,"ب",1,0],["مُعَلَّلين بآمال تُخدعنا","وزخرف من غُرورِ العيش موصون",19,"ن",1,0],["مُعَلهَجٌ فيهِم خَبيثٌ مَقعَدُه","إِذا أَتاهُ سائِلٌ لا يَحمَدُه",20,"د",2,0],["مُعلِناتٍ لَكَ الوَلا وَالتَهاني","بِثُغورٍ وَأَوجُهُ بَسامَه",21,"م",2,0],["مُعَلِّلُ النَفسَ مِن يَأسٍ وَموجِدَةً","بِقَولٍ مَن قالَ إِنَّ العِزَّ في النَقلِ",22,"ل",1,0],["مَعْلَمُ العِلْمِ عادَ منه جَديداً","بَعدما كانَ رَسْمُه قد تَعفَّى",23,"ف",2,0],["مُعِلّمَةُ الأمطارِ عَيْني على الثّرى","إذا ما سَما إن لم يكنْ كَفَّ ثابت",24,"ت",1,0],["مُعلَّقُ قَوْسٍ للنِضالِ وأسهمٍ","لها مَنظرٌ لولا الغرامُ مَهيب",25,"ب",1,0],["معلِّماً غُربةً قد زانها شَرفاً","دَلٌّ كما شانَها كبرٌ يُريك نكدْ",26,"د",1,0],["مُعلِّلتي بممرضتي حَديثاً","لقد داويت بالخمرِ الخمارا",27,"ر",2,0],["معلمة الأحرار كيف صمودهم","وجاعلة أحلامهم كل ما صحا",28,"ح",2,0],["معلوطةً بذكركم وُسومها","في الخيل والإبل على وسامِها",29,"م",3,0],["مُعلِقٌ من هواك كفِّي بحبلٍ","لم يزده البعادُ إلا عَقْدا",30,"د",2,0],["مُعَلِّمُ الخَيرِ وفَيَّاضُ النَّدى","ومُسْبِلُ الذَّيْلِ على الجَميعِ",31,"ع",1,0],["معلومٌ هو الدنيا فكن متخذراً","فما العشق الا للملامة جاذب",32,"ب",1,0],["معلَّلاً كلّما يدوِي ويُسقِمُه","وربّما ضرّ ذا سُقمٍ بتعليلِ",33,"ل",1,0],["معلقين به في كل حالتنا","نلجا إليه بإكرام وإعزاز",34,"ز",1,0],["مُعَلَّقاً عِرنِينُهُ وَمِعصَمُه","صَغيرَ إِثمٍ وَكَبيراً مَأَثَمُه",35,"م",2,0],["معلنةُ الأوتار صخابة","لها حنينٌ كحنين الغريبْ",36,"ب",1,1],["معلماً صامتاً عُد الكتاب فكم","منه استفدنا ولم نسمع له صخبا",37,"ب",2,0],["مُعَلِّلَتي بِوَعدِ حَياتي","لَعمرُ أبيكَ في تِلكَ العُلالَة",38,"ل",2,0],["معلمَ الصبيان فاسمعْ لنا","نسمْعك بيتاً بعد بيتٍ فبيْتْ",39,"ت",1,1],["مُعلقٌ بالخيطِ فهوَ دُميةٌ","كيفَ الدُمى سَتحكمُ البلادْ",40,"د",1,0],["مُعلم أن دَينه يتقاضى","بين جُود وبين حثّ جواد",41,"د",1,0],["مُعَلَّقَةً أَولادُهُن يرينها","إِلى شُزُنيها فى حُفِىّ وأَرجُل",42,"ل",1,0],["معلّم كل أغنية حنينا","وهدي الورد في سبل الغوالي",43,"ل",2,0],["مع لذة في انتباه","وضجرة في غموض",44,"ض",1,0],["معلولة الآراء والأنظار","عارية السوءات للنظّار",45,"ر",1,0],["معلومة حسب ما هيأتها وعلى","ما اختارها مالها في نفسها خير",46,"ر",1,0],["معلِّلي بالعزاء رفقاً","تحنو على قلبي العليل",47,"ل",1,0],["معلَّقةٌ مثلَ الثريا على الثرى","وإنَّ فؤادي في هواها مُعلَّق",48,"ق",1,0],["معلل نهايتي تعلل","بكم أمني مهجتي غداً غدا",49,"د",2,0],["معللتي والموت دون وفائها","بما عقدت من موثق وذمام",50,"م",1,0],["معلناً للضياء دعوةَ صبحٍ","أشرقت شمسهُ على الأكوانِ",51,"ن",1,0],["معللتي من ليس لي غيرها شغل","هنيئاً لعينٍ لحظةً منك لا تخلو",52,"ل",2,1],["معلل لي بوعد غير منجزه","ومطمعٌ في وصال غير باذله",53,"ه",1,1],["معلنات (الله اكبر) لبوا","أيها الناس داعي الرحمن",54,"ن",1,0],["معلمي لست بالناسي جميلك ما","عرفت في لغتي معنى لعرفان",55,"ن",1,0],["معلم أسباب السعادة كلها","لكلِّ لبيبٍ عاقلٍ ماجدٍ حرّ",56,"ر",1,0],["مَعلومَةٌ للعَقلِ أو مشهودَةٌ","للحسِّ أو في فِطرَة الرحمنِ",57,"ن",1,0],["مُعَلِّلَتي بالوصل والموت دونَه","إذا بتُّ عطشاناً فلا نزل القطرُ",58,"ر",1,0],["معلمك الأصل هذا الوجود","فلا تغترر أيها العالم",59,"م",1,1],["معلم ودرسه محدود","ليس له أجر زهيد",60,"د",1,0],["معليا صمته المهيب زئيرا","ساكنا خضرة السما آجاما",61,"م",2,0],["معلمتي والأجر حبة سكّر","وفضل طعام ليس لي فيه من جدوى",62,"ا",1,0],["مُعلّلا بالأماني من رضاهُ كما","يُعلّلون فطيم الثّدي بالنّشح",63,"ح",1,0],["مَعْلُومِيَ المعلومُ يا سيِّدي","يحْفظُه الدِّيوانُ والدَّفْتَرُ",64,"ر",1,1],["معللا نفسي بذكر عذره","إذ لم تكن أنته من غدره",65,"ه",1,0],["معلناً كفراً بسب المرتضى","وعليها بشبا ماضيه حلا",66,"ل",2,0],["معلم العالم هاد يهم","ملهم جبريل صواب الجواب",67,"ب",1,0],["معلماً باجتبا الآله علياً","وبنيه وبافتراض ولاها",68,"ا",3,0],["معلمة الإنسان ما ليس يعلم","وقائلةً ما لا يبوح به الفم",69,"م",1,1],["معلي منار العلم فارس بحثه","ومعين فائض عذبه المتفجر",70,"ر",1,0],["معلمتي لطفها يسكر","وتحريك أجفانها يسحر",71,"ر",1,1],["معلمتي لا يسؤك انتقاد","فإنّ فوائده تؤثر",71,"ر",1,0],["مَعْلَمٌ مُعْلَمٌ وَشَى بُسْطَةُ الزَّهْ","رُ وَحاكَتْهُ دِيمَةٌ هَطَّالَهُ",72,"ل",2,0],["معلقا له على تقدير أن","يثبت غيره كذا النفي اجعلن",73,"ن",1,0],["معلمهُ الكتابَ والحكمةَ التي","أبانت رسول اللَهِ وهو المعلمُ",74,"م",1,0],["مُعلمُ خلقِ اللَهِ في أولٍ لَهُ","وفي آخرِ رضيعُهُ ليسَ يُفطَمُ",74,"م",1,0],["معلقهُ قلائدٌ قد تعلقَت","بأجياد أملاحٍ فشمها تنظَّمُ",74,"م",1,0],["معلِّمٌ ميسِّرٌ مسهِّلُ","فعّالُ كلّ الخير لي تسهِّلُ",75,"ل",1,0],["مُعلي ومحيي بالكريم أعلي","ذكري أيا عليُّ عند الكلِّ",76,"ل",1,0],["معلنا للبنت ما ازعجه","حاسبا فيه وجود الدامية",77,"ه",1,0],["مُعلَمَ الطَرزِ موَشّىً بِانتِساق","تَعلَقُ اللَذّاتُ في أَكنافِهِ",78,"ه",1,0],["معلَّمة لا تَشتَكي الأَينَ والوَجى","وَلا تَشتَكي عَضَّ النُسوع وَلا الدَأب",79,"ب",1,0],["معلقاً في يَد الأَيام مطرحاً","في هامش الغَيب لا عِيسى وَلا نوح",80,"ح",1,0],["مُعَلَّقٌ بِالرَّجاءِ ظاهِرُهُ","يُخبِرُ عَمَّا أَجَنَّ مِن خَبرِه",81,"ر",2,0],["مع لطيف الرياح","بحجله والحزان",82,"ن",1,0],["مُعلِّلَتي بالوصل طال ترَقُّبي","أَريحي بيأْسٍ فالرَّجاءُ مُعذِّبي",83,"ب",2,1],["معلقات السبع مع شرحها","في خط سقيم غلط",84,"ط",1,1],["معلناً في الكونِ حرباً","ناشراً فيه بيانه",85,"ن",2,0],["(معللتي بالوصل والموت دونه)","متى تأذني ليت التلاقي مدانيا",86,"ي",2,0],["مع لابة شاركوا في زمرة الاحتفال","وقفات ند العزاوي فالنهار الطويل",87,"ل",1,0],["معلّم الخيرِ كم أشتاقُ رؤيتهُ","الصّادق الشهمُ من لايعرفُ الريَبا",88,"ب",2,0],["معلوق قلبي ياعرب يطلب الثار","ركايب همومه لفتني عطاشى",89,"ش",2,0],["مُعَلِّقةَ الآمالِ في اللهِ ربِّها","ومن دقَّ بابَ اللهِ يبلُغْ مطامعَهْ",90,"ع",2,0],["مُعَلِّمِي سَوفَ تَبقَى لي السِّراجَ وإن","بَعُدتَ عنِّي فللأرواحِ إسرَاءُ",91,"ا",2,0],["معلمةٌ قد أتقنت بذكائها","عروضا بحد للتفاعيل حُجّبا",92,"ب",2,0],["معلنا عن توبة يمحو بها","ما بدا من ذنبه أو ما استتر",93,"ر",1,0],["معلنا وقفَ كفاحٍ","مستميت دام دهرا",94,"ر",2,0],["معلِّمنَا كم دعونا لهٌ","جميلَ المُحيَّا فما أجملا!",95,"ل",2,0],["مُعلِّمٌ أنتَ بالأفعالِ مَدرَسَةٌ","قبيلَةٌ أَنتَ مالي دوْنَها حَسبُ",96,"ب",1,0],["معلم والمعلم فضله يعدي نجوم سهيل","وطلابه لو يسوون كل شي مايوفونه",97,"ن",2,0],["معلم والمعلم له نقدم روحنا ونحيل","عن الطعنات لاجاته من الي مايعرفونه",97,"ن",2,0],["مُعلَّقُ لا سمَاءً للوِصَالِ سمَتْ","إِلَيكَ يَومًا ولا أَرضًا تُراضِيني",98,"ن",2,0],["معلمات من عبقري حسان","لا تحاكى ولم تحكها الكفوف",99,"ف",1,0],["معلنا أسماء ربي التي بها","تخلق أو أثنى على خلقه الله",100,"ه",1,0],["معلَّقينَ على الأوهامِ في عملٍ","فإن أتاكَ يُدَكُّ الفعلُ بالنّدمِ",101,"م",1,0],["معلَّقينَ على أشباحِها وطناً","كنّا نَمدُّ لهُ الأرواحَ لو مرقوا",102,"ق",3,0],["معلّقونَ على حُلم ٍ وأمنية ٍ","تهدَّلَ الصَّمتُ من أحداقِهم جُمَلا",103,"ل",2,0],["معلق كالضأن من عنقه","وما تعوفني الكلاليبُ",104,"ب",1,0],["معلمي تاجُ شرياني وأوردتي","هوَ الضِّياءُ لهُ في القلبِ تعظيمُ",105,"م",1,0],["معلّمي رحلوا لا سين لا ألف","لا صاد لا صفة ما الحل ماالعملُ",106,"ل",1,0],["مُعلمُ الجيل ِأضحَى لا يُروعهُ","صَوتُ الرّصاص ِوأهوالٌ بها الخطرُ",107,"ر",1,0],["معلّمُ جيلنا خِبءٌ","بطيِّ شبيبة ٍ عجبا",108,"ب",2,0],["معلما بأفضل الاخلاق في","كرامة لم تبد من معلم",109,"م",1,0],["معلمتي وجوب الحرف شكر","وانت الحرف يسكنني كتابا",110,"ب",2,1],["معلقونَ على أقصى مباهجِنا","ومُزهقون ببخسٍ صائفِ الخُطَبِ",111,"ب",1,0],["معلمنا العبقري الأبي","رعته وصانته عين الإله",112,"ا",3,0],["معلم الجيل والأنظار ضارعةٌ","إليه، قد أودعته الروح والعصبا",113,"ب",2,0],["مُعَلِّلَتَي لَعَل َّالصَّبْرَ صَبْرِي","سَيَأْتِي إِن َّيَعُودُ الْحُبّ عَادَ",114,"د",1,0],["معللتي لعل الصبر صبري","سيأتي لو يعود الحب عادَا",115,"د",2,0],["مُعَلِّمُنا بأنّ الصبرَ طودٌ","وأنّ السيفَ لا يُرْدي اليَقينا",116,"ن",2,0],["معلق في سماء التيه لا وطن","يؤوي تراتيل روح لم تبُحْ بهُدى",117,"د",2,0],["مُعَلَّقَتِي لَوْ شِئْتُ تَرْجَمْتُهَا إلى","لُغَاتٍ عَدِيدَاتٍ إِذِ اسْتُصْغِرَتْ رَاسِي",118,"ي",1,1],["معلَّقٌ قلبه في الريح يتبعها","وينتهي الشوق في عينيه حيث بَدَا",119,"د",2,0]]}