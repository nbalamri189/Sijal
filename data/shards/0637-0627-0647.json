قمرية","https://www.poetsgate.com/ViewPoem.aspx?id=200597",""],[5431,"كرب وابتلاء...(1)","https://www.poetsgate.com/ViewPoem.aspx?id=206534",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[6093,"فَازَ بِالشِّعْرِ ظَرِيْفْ ( مجزوء الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=180593",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[572,"أيُّ حِرَاكٍ غالَ منكَ السكونْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9491&r=&rc=348",""]],"verses":[["طَاهِرَ الرَّأْيِ لَمْ يَضَعْ","نَفْسَهُ مَوْضِعَ التُّهَمْ",0,"م",1,0],["طاهِرُ اللَفظِ وَالشَمائِلِ وَالأَخ","لاقِ عَفُّ الضَميرِ وَاللَحَظاتِ",1,"ت",1,0],["طاهراتٌ كأنَّها أرَجُ الأزهارِ","في مَوْلدِ الرَّبيعِ الجَديدِ",2,"د",1,0],["طاهِرُ الجَدِّ جَدُّهُ كُلَّ يَومٍ","في صُعودٍ وَضِدُّهُ في اِنحِطاطِ",3,"ط",1,0],["طاهرُ الأخلاق مألوفُ العلى","طيّبُ الأعراق مصقول الحسب",4,"ب",1,0],["طاهِر الأَثوابِ يَحمي عِرضَهُ","مِن خَنَى الذّمَّةِ أو طَمثِ العَطَن",5,"ن",1,1],["طَاهِرُ الْعُرْقِ صَادِقُ الْقَوْلِ وَالْفِعْلِ","وَلُوعٌ بِكُلِّ فَضْلٍ جَدِيدْ",6,"د",1,0],["طاهرٌ، لم يَحُسم حواليه شَكٌّ","أيُّ شكٍّ يرقى إلى الجَوزاء؟",7,"ا",2,0],["طاهرة طيبة دأبها التق","وى كما شاع بأقوامها",8,"م",3,0],["طاهر القلب ألوف","راجح العقل حصيف",9,"ف",1,0],["طاهِرٌ مِن كُلِّ عَيبٍ","جَيبُهُ عَفٌّ إِزارُه",10,"ر",2,0],["طاهَرْتِ بينَ طوائلٍ وطوائلٍ","وظَهرْتِ منها في حُلىً لم تُعْهَد",11,"د",1,0],["طاهر العرض لم يزل وهو طفلٌ","في مراضي الإله عَزَّ وجَلاَّ",12,"ل",2,0],["طاهر الذيل ما تصابى للهو","إنما لهوه العلوم العليه",13,"ي",2,0],["طاهرٌ لا يمسّه دنس السُّو","ءِ عفافاً ولا يداني أثاما",14,"ا",1,0],["طاهر لا يشوبه دنس الآ","ثام فما لاث قطُّ بالآثام",15,"م",1,0],["طاهرُ العِرْضِ والملابس والآرا","ءِ والمأرباتِ والألاّفِ",16,"ف",1,0],["طاهر الشيمتين معتدل الأخ","لاق جمّ العطاء عذب الجُمَّهْ",17,"م",2,0],["طاهرٌ طاهرٌ من الغشِّ لم يس","بق إليه ريْبٌ ولم تَسِر تهمَهْ",17,"م",2,0],["طاهرٌ يُخطَفُ بالأي","دي الخبيثاتِ السِّهاكِ",18,"ك",1,0],["طاهرة إذا عركتَ جانبي","من ودّ قومٍ بالخبيثِ النجِسِ",19,"س",1,0],["طاهِرُ السَّعْي كريمُ المُلْتَقى","مُخْبتُ الأخلاق عُلويُّ المَحَلْ",20,"ل",1,0],["طاهر الخيم والخلائق والأف","عال زاكي الفروع والأوصاف",21,"ف",1,0],["طاهرٌ لو سبقَ الدّهرُ به","جاذبَ العِترةَ في فضلِ كِساها",22,"ا",3,0],["طاهرة أعراقه","آخرهن والأول",23,"ل",1,0],["طَاهِي قُدُورٍ طَيَّبَتْ كَفُّهُ","مَذَاقَهَا فَالْغَثُّ مِنْهَا يَبِينْ",24,"ن",1,0],["طاهر أنت من كواذب أخلا","ق وللمعتفين عذب طهور",25,"ر",1,0],["طاهر الجَد سَجايا","في عُلاهُ شَوَقَتني",26,"ن",2,0],["طاهر الذيل صادق القول ندبا","لا يمارى لدى الحقيقة شيّا",27,"ي",2,0],["طاهر الأَعراق منطيقٌ أجل","خير من طالع سفراً وكتب",28,"ب",1,0],["طاهر النفس طاهر الجيب والأب","راد عفٌّ في السرِّ والإِعلان",29,"ن",1,0],["طاهِرَ النفسِ من جميع المعاصي","مُؤمنَ القَلبِ صادقَ الإيمانِ",30,"ن",1,0],["طاهِرُ الذَيلِ وَالخَلائِقِ لا يُز","رى عَلَيهِ الخَنا وَلا الكِبرِياءُ",31,"ا",2,0],["طاهِرُ المَجذُوبُ عَبدٌ جاءَكم","فاحسِبُوهُ فاحسِبُوه مِن بُنَى",32,"ا",1,0],["طاهرَ الجنان","فاتِح الجنان",33,"ن",1,0],["طاهِراتٌ كَأَنَّهُنَ مَزيجٌ","مِن رُضابِ الإِنجيلِ وَالفُرقانِ",34,"ن",1,0],["طاهِرُ القَلبِ جَميلُ الر","روحِ مَعسولُ اللِسانِ",35,"ن",1,0],["طاهِرُ الآدابِ لا عَن فِعلِهِ","تَصدُرُ الصُغرى وَلا عَن قيلِهِ",36,"ل",2,0],["طاهر الذيل لم يزن بسوء","صين ما عليه تؤثر سبه",37,"ب",2,0],["طاهر يوحي إلى القلب شذاً","كان طهراً ثم منه فقدا",38,"د",2,0],["طاهِرُ الماءِ من فُيُوضِ عُلُومى","مَشَّطُونِى بِفَيضَةِ تَمشِطاً",39,"ط",2,0],["طاهر الصدرِ والطويةِ لمَّا","يَسْرِ في صدره ظلامُ الحَقودِ",40,"د",1,0],["طاهر بر جواد","فأتخذناه طريقا",41,"ق",2,0],["طاهر الأعراق في","تطهيره التنزيل يشهد",42,"د",1,0],["طاهر والذيل قد عصوا لهوى النف","س وفي ذا قد خالفوا الاقرانا",43,"ن",2,0],["طاهِرُ الشيمةَ عَفُّ الذَيلِ لا","يَزدَهيهِ جانِبا الدُنيا مُريعا",44,"ع",2,0],["طاهر ثوب كأن خالقه","من عرض قاضي القضاة قد خلقه",45,"ق",2,0],["طَأْهُمْ بِجَيْشكَ لا تَحْفِلْ بِكَثْرَتِهِمْ","فَإِنَّهُمْ لِبُغاثِ الطَّيْرِ أَقْواتُ",46,"ت",1,0],["طَاهِرُ الجَيبِ ظَاهِرُ اليُمنِ إِذ مَا","لَوَّثتهُ الأدوَاءُ والأهوَاءُ",47,"ا",2,0],["طاهِرِيُّ في مَواكِبِهِ","عُرفُهُ في الناسِ مَبذولُ",48,"ل",1,0],["طاها على رغم حاسد نكد","فما عليها سواك من أحد",49,"د",1,1],["طاهر من نسل طهر طاهر","والدالاطهار من سادوا الأناما",50,"م",2,0],["طاهر طهر الإله ذراه","فهو ينجي من الهموم الثقال",51,"ل",1,0],["طاهِرَ القلبِ لستُ أُوجِسُ شَرّاً","جاهِلاً ما تُخْبِئُ الأيامُ",52,"م",1,0],["طاهره متعاليه والليل يطربه التغنّي","ويعذر القلب المولّع من لها بالعين شافي",53,"ف",2,0],["طاه الذي أعطى الإله رسالة","للذكر يسرها فهل من مدكر",54,"ر",1,0],["طاهر النبع ماسُكبتَ غلّوا","لا وربي ولا جريتَ عتيّا",55,"ي",2,0],["طاهر الثوب نقيٌ جيبه","باسط الكف لكشف الكرب",56,"ب",1,0],["طاهرات التقى فما زقّها فك","ري إلَّا إلى الجواد العفيف",57,"ف",1,0],["(طاهرا) يغمر الملائك نورا","مذ يراها تطوف في حجراته",58,"ت",2,0],["طَاهِرُ الأُزْرِ كَرِيْمٌ","لَيسَ بالفَحْشَا يُطِيْفْ",59,"ف",1,0],["طاهرة على الهدى نصصتها","خالصة من الهوى محصتها",60,"ه",2,0],["طَاهي قُدُورٍ طيّبٌ كفّه","مذاقُها فالغَثُّ فيها سَمينْ",61,"ن",1,0]]}