com/ViewPoem.aspx?id=178890",""],[4767,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=179435",""],[4767,"زرقة السماء","https://www.poetsgate.com/ViewPoem.aspx?id=180059",""],[4830,"حُلْمُ الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=212911",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[4578,"نيل السعادة من أحلى الماني","https://www.poetsgate.com/ViewPoem.aspx?id=49621",""],[4578,"قلبي لعيناك نيشان الهوى فيه","https://www.poetsgate.com/ViewPoem.aspx?id=49604",""],[4868,"عمان في عيدها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=178425",""],[5010,"في غيهب الذكرى أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=189863",""],[5038,"كيف يغنيك القليل","https://www.poetsgate.com/ViewPoem.aspx?id=190125",""],[5050,"إن جاء نصر الله والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=38195",""],[5147,"أيقل أرحلك الصعيد الهامد","https://www.poetsgate.com/ViewPoem.aspx?id=166697",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5226,"للقدس .. كلام آخر","https://www.poetsgate.com/ViewPoem.aspx?id=27720",""],[404,"دُمُوْعُ امرأةٍ من ميانْمارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191589",""],[5411,"روحي تُحبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=185917",""],[5533,"عَوْدَةُ مُهاجِر","https://www.poetsgate.com/ViewPoem.aspx?id=176272",""],[2110,"قل لي بحقك أيهذا الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=156283",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[5861,"ارجع لقلبي صباه","https://www.poetsgate.com/ViewPoem.aspx?id=188052",""],[5956,"خذني إليك أيا ربي","https://www.poetsgate.com/ViewPoem.aspx?id=182488",""],[5956,"لبّت مطالبَ أبِّها أنْؤونُ","https://www.poetsgate.com/ViewPoem.aspx?id=206255",""],[6068,"خسرا كلامي بجنب العشق والسقم -08-","https://www.poetsgate.com/ViewPoem.aspx?id=177359",""],[6075,"في صفحة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=190530",""],[6106,"موسم حج حكام الأمة للبيت الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=6305",""]],"verses":[["قَد أَحسَنَ اللَهُ في الَّذي صَنَعَه","عارِضُ كَربٍ بِلُطفِهِ رَفَعَه",0,"ع",2,1],["قَدْ أَحْدَقَ السُّوءُ بِهَا مُنْذِراً","بِالوَيْلِ مِمَّا تَزِرُ الوَازِرَهْ",1,"ر",2,0],["قَدْ أَحْرَزَ الرَّاجِي بِهَا","خَيْراً وَمَا هُوَ بِالقَلِيلْ",2,"ل",1,0],["قَد اِحتَمَلَت مَيُّ فَهاتيكَ دارُها","بِها السُحمُ تَردي وَالحَمامُ المُوَشَّحُ",3,"ح",1,0],["قد أحرز الشيمَ الخطيرةَ عندما","أمطى العزائم صهوة الأخطارِ",4,"ر",1,0],["قد أحوجت عبدك الليالي","لسفرة أمرها فظيع",5,"ع",1,0],["قد أحسَن اللَّه بأسماعنا","إذْ سَلمتْ منها فلم تُصْمَخِ",6,"خ",1,0],["قد أحسنوا وتجشموا كُلّ الأذى","إذْ أهْدفوه مسامعَ الآذان",7,"ن",1,0],["قد احسنت فردوس في ادوارها","فكأنها القمر الذي لا يخسف",8,"ف",1,0],["قدْ أحرقتْ قلبي بهجرانِها","فالنارُ ممنْ يعبدُ النارا",9,"ر",2,0],["قَدِ اِحتالَت عَلى السَفَهِ البَرايا","بِما اِتَّخَذَتهُ مِن راحٍ وَمِزرِ",10,"ر",1,0],["قَد أَحبَلَت سَمُراتُ الجَزعِ سامِعَةً","أَمرَ القَضاءِ وَما هَمَّت بِإِحبالِ",11,"ل",1,0],["قد أَحرَجوني بما جاؤوه من سفه","فأَخرجونيَ من أَرضي عَلى كبري",12,"ر",2,0],["قد أحرقَ الرُّبانُ كلَّ سفينةٍ","من خلفه إلَّا شراعَ رجاءِ",13,"ا",2,0],["قَدْ أَحَاطَتْ بِشَاطِئَيْهِ قُصُورٌ","مُشْرِقَاتٌ يَلُحْنَ مِثْلَ الْقِبابِ",14,"ب",1,0],["قَدْ أَحْكَمَتْهُ عَشِيرَةٌ","إِن تدْعَ لَمْ تَكُ بِالعَقِيدَهْ",15,"د",2,0],["قَدْ أُحْكِمَتْ في كُلِّهِ أَجْزَاؤُهُ","فَبَدَا تَمَامُ الْكُلِّ بِالأَجْزَاءِ",16,"ا",2,0],["قَدَّاحةٌ جاءَتْكَ من قدَّاح","قداحِ زَنْدِ المجدِ والسَّمَاح",17,"ح",1,1],["قد احيى القلب بموعده","لو ينجز حينا موعده",18,"د",2,0],["قد أحكمته يدُ الطاهى فناشَله","كجاذب القوس عن نزعٍ وتوتيرِ",19,"ر",1,0],["قِداحُهُمُ يومَ الفخار فوائزٌ","وأسهمُهم إن نازلوا غيرُ أنكاسِ",20,"س",1,0],["قَد أَحمِلُ العِبءَ الثَقيلَ وَبَعضُهُم","فيهِ يُصَوِّبُ طَرفَهُ وَيُصَعِّدُ",21,"د",1,0],["قَد أَحسَنَ المُتَنَبّي إِذ يَقولُ وَما","زالَت لَهُ حِكَمٌ تُروى وَأَمثالُ",22,"ل",1,0],["قَد أحجَم الرسلُ حتّى قال قائلهُم","في ظلِّ أحمدَ يا كلّ الورى قيلوا",23,"ل",3,0],["قد احسنت فيك المديح وابدعت","في حسنها ناهيك بالحسناء",24,"ا",2,0],["قَد أَحبَّ الفَتيُّ فيها جمالاً","وَأَحَبَّت فيه ثَراءً وَقَدرا",25,"ر",2,0],["قَد أَحاطَت بِيَ الهُمومُ وَما أَح","سِبُ أَنّي مِن دَأبِهِا بِمُفيقِ",26,"ق",1,0],["قَد أَحصَبَ العامُ وَعَمَّ الوَرى","أَنداؤُهُ وَهوَ يَرودُ اليَبَس",27,"س",1,0],["قَدْ أَحَلَّتْ جَمِيعَنَا دَارُ سُكْنَا","هُ ذَرَاهَا وَلَمْ يَكُنْ بِالنَّاسِ",28,"س",1,0],["قد أحرز السبق مولانا الحريزي","وهو الحري بفضل لا الحريريّ",29,"ي",1,1],["قَدْ أَحْجَمَ المُتَظَلِّمونَ مَخافَةً","مِنْهُ وَقالوا ما نَرومُ مُحالُ",30,"ل",1,0],["قد أحكمته يدا صناعه فغدا","يستوقف الطرف حسناً أن يرى وسنا",31,"ن",2,0],["قِداحُ عُلاً خُلِقْتَ لها مُجِيلاً","وخَيلُ نُهىً فَسَحْتَ لها مَجالا",32,"ل",2,0],["قَد أَحدَقَ الهَمُّ بِأَرجائِهِ","جَيشاً فَضَرّابٌ وَطَعّانُ",33,"ن",1,0],["قد أَحدَقَت بِفِناك أَشراكُ العِدى","فالسيفُ لم يسبُقهُ عَدوُ عِداءِ",34,"ا",2,0],["قَد أَحرَقَ القَلب الزَفير","وَقرَّح الدَمع المَآقي",35,"ق",2,0],["قد أحبوا أيامهم وتمّرد","ت عليها فعشت في أحلامي",36,"ي",1,0],["قد أحرزوا كل كمال فما","يدرك أهل السبق مسعاهم",37,"م",1,0],["قد أحرزوا كل الكما","ل فَمِنْ علاهم نستفيده",38,"د",2,0],["قَد أَحكم الحاكِم المَنصور دولَتَهُ","بآلَ حَيدَرَةٍ في السَهلِ وَالجَبَلِ",39,"ل",1,0],["قد أحالا من بينَ قَصدي وبيني","طَعَنَتْ في مضاضة العيش شنِّي",40,"ي",1,0],["قد أحَلَّتْهم نفوسٌ شَرُفَتْ","بمكان الأنجم الزهر حلولا",41,"ل",2,0],["قد أحسن اللَه فيه الصبر عندكم","وفيه وفقتموا أحرا به حسنا",42,"ن",2,0],["قد احتكروا الحكومة واستبدوا","بتوزيع الوظائف والمراتب",43,"ب",1,1],["قد أحرقت كبدي ليلى ولا حرج","فإن عاشقها في أرفع الدرج",44,"ج",1,0],["قد احتوشته الكائنات وأبطنت","طلاسمه حجب الذوات الجسمانيه",45,"ي",2,0],["قَد أَحسَنَت أَودٌ وَما نَأنَأَت","مَذحِجُ في ضَربِ الكُلى وَالرُؤوس",46,"س",1,0],["قد أَحدث الناس أموراً فلا","تَعَمل بها إني امروءٌ ناصح",47,"ح",1,1],["قد أحاط الوجود بالأشياءِ","وتبدى بها بغير خفاءِ",48,"ا",2,1],["قدْ أحرَقْت سُبُحاتُ المجد كل حجي","أقرّ بالعجزِ والاذعانِ والكسلِ",49,"ل",1,0],["قَد أَحزَنَتهُ شُماتاتُ السُيوفِ بِهِ","لَمّا وَلينَ وَأَضحىى حائِنَ العَصَبَه",50,"ب",2,0],["قد احتفى بهما كل لجهدهما","إذ كان للكل مبذولاً ومنصرفا",51,"ف",2,0],["قد أحقد الخطر العظيم وهل تنى","همم الكماة إذا عدو عسكرا",52,"ر",2,0],["قد احتفلت به أي احتفال","محافلنا شعوبا مع جنود",53,"د",1,0],["قد أحبوكَ في وفاءٍ وصدقٍ","كلهم للجميلِ ذو عرفانِ",54,"ن",1,0],["قد أحاطوا به وقد يئسوا منه","وهانت نفوسهم في فداه",55,"ا",2,0],["قد أحدث الناس ظرفاً","يزهو على كل ظّرفِ",56,"ف",1,1],["قَد أحسَنَ الحسنُ المنصورُ سيرَتَه","فاحمَد بِه في مَعَدِّ أيَّ إحماد",57,"د",1,0],["قد أُحوجَت أيدي الملوكِ إلى فمي","فأنا على الأيدي شَبيهةُ أرقَمِ",58,"م",1,1],["قَدِ احْمَرَّ ثُمَّ اصفرّ لا عَنْ ضَغِينةٍ","ولكنَّهُ هابَ العُلا إذْ تَقدَّما",59,"م",2,0],["قد أحكم الطبع خطا في تمائمه","يرضى المعالي ويروي الصارم الذكرا",60,"ر",2,0],["قد أَحْدَقَ الوردُ بالشقيق","خلالَ بستانِكَ الأنيقِ",61,"ق",1,1],["قَد أَحَضروا صورة سَبع وافي","في غاية الدقَّة وَالإِنحافِ",62,"ف",1,1],["قَدْ أَحَاطَتْ بِهِ عُيُونُ المَعَانِي","وأضَاءَتْ في جَانِبَيْهِ الظُّلُومُ",63,"م",1,0],["قد احتملت لهذا","فما أشدَّ احتمالَكْ",64,"ك",1,0],["قد أحسنوا في اتّباعٍ","الأُسْد تُنتج أُسْدَا",65,"د",2,0],["قد أحاط العلوم لفظا ومعنى","فأزاح الشكوك والأغبارا",66,"ر",2,0],["قد أحرزوا السبق في مضمار معلوة","ما آنفك طائلها يستقر الهمما",67,"م",2,0],["قد أحكم المهدي قعر أساسه","وازاد ركن صراحه تشييدا",68,"د",2,0],["قد أحاطت بكم كتائب كفر","منعوهم من الفرات الورودا",69,"د",2,0],["قد أحكمت علم النجو","م وأتقنت سحرَ البيانِ",70,"ن",1,0],["قَدْ أَحْكَمَتْ مِنِّي التَّجا","رِبُ كُلَّ شَيءٍ غَيْرَ جُودي",71,"د",2,1],["قد احتبيا في مجد عمرو بن عامرٍ","ببيتي علاء ليس ينهدمانِ",72,"ن",1,0],["قد أحرزَ الغايات مَن","أجرى لهنَّ عتاقَها",73,"ق",3,0],["قد أحدقت منهُ بأزهدِها كما","تُمسي بأزهرها الكواكبُ تحدق",74,"ق",1,0],["قد احتفل المولى بحبوة قاصدٍ","عساه أنا العبد الذي نظم الشعرا",75,"ر",2,0],["قداح زند المجد لا ينفك من","نار الوغى إلا الى نار القرى",76,"ر",2,0],["قد احللتهم دار المقامة لم يكن","يمسهم فيها لغوب ولا نصب",77,"ب",1,0],["قد أحبط الرحمن أعماله","والعمل الفاسد للحبط",78,"ط",1,0],["قَد أَحدَثَت عِندِي يَداكَ مَواهِباً","أَغنَينَني فَكَفَينَني الأَحداثا",79,"ث",2,0],["قَد أَحرَزَ البأسَ وَالإِحسانَ في نَسَقٍ","وَالعِلمَ وَالحِلمَ قَبلَ الدَّركِ لِلحُلُمِ",80,"م",1,0],["قد أحكمته النهى في حسن تجربة","فهو البصير بما يأتي وما يذر",81,"ر",1,0],["قد احتمى بشوقه لا شوكه","عن قوة تجنيه وهو مضعف",82,"ف",1,0],["قد أحسَّ الله في وجودي","عند أداءِ الفروضِ عوني",83,"ن",2,0],["قَد أَحاطَ الحِسابُ وَاِنتَصَبَ المِي","زانُ عَدلاً وَقَلَّتِ الحسَناتُ",84,"ت",1,0],["قد احتذيا في كل فضلٍ أباهما","وهل أرقمٌ إلا ويعقب أرقما",85,"م",2,0],["قد أحرق القلب فلو لم يطفه","عرس الأمين لاذبته الحرق",86,"ق",1,0],["قد أحرقت مني الجوانح بالجفا","يا ليتها لا أحرقت مثواها",87,"ا",3,0],["قد احتَبي طفلا بابراد النهى","طفلا بابراد النهى قد احتبا",88,"ب",2,0],["قد أحاط العلم الشريف بما بي","من تنائي الأمين عني بعدا",89,"د",2,0],["قد احكمتها أكف المزن واكفةً","وطرّزتَها بما تُهمي من الدّررِ",90,"ر",1,0],["قد أحاطت بك العيونُ فما أمْ","لكُ ألقي مكان عيني منك",91,"ك",1,1],["قد أُحبُّ الرَّبيع لِلَّهو فيه","بلطيف الهواء والأزهارِ",92,"ر",1,1],["قد احتفوا بي فرحت أمنحهم","أحلى قريضي طعماً وأنعمه",93,"م",2,0],["قد احتاج كل ترجمانا لقوله","لنفهمه رغم اللسان الموحد",94,"د",1,0],["قَد أَحسَن اللَهُ لَنا نَباته","حَتّى سَما نَجل الفَتى نَباته",95,"ه",1,0],["قَد أَحكم التَضبيرُ مِن إضمارِهِ","فوَسطُهُ يُدمَجُ في أقطارِهِ",96,"ر",2,0],["قد احترقت فيه النجوم فما بدا","بها من دخان أو لظى أي بارق",97,"ق",1,0],["قد أحرجوهم فزادوا في مطالبهم","كالريح للنار تصليها وتذكيها",98,"ي",3,0],["قَدْ أُحكمت بالقضا آياتُ نشأتِه","إِذ قيل يَا فيصلٌ مَا شئتَ فاحتِكم",99,"م",1,0],["قَدْ احْتَسيتُ شهدَها وصابَها","فما وجدتُ طعمَ ذَاكَ المُحتسَى",100,"ا",1,0],["قد أَحرَموني حُقوقاً ليس يُنكِرَها","عَلَيَّ في الناس إِلّا بِالفَضل وَالحَذقِ",101,"ق",1,0],["قد أحرم الإيوان من رونق","وأهرم الأهرام منه البها",102,"ه",2,0],["قد أحسن الدهر فيما قد أساء به","إذ لم تُصِبْ حسناً تلك الإساءات",103,"ت",1,0],["قد أحْرَزوا للسّبْقِ أقصى غايةٍ","بمدَى الكتائِبِ أو مَدى الكُتّابِ",104,"ب",1,0],["قَد أَحسَنَ اللَهُ إِلَينا مَعاً","أَن كانَ رَأسُ 