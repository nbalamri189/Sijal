{"poems":[[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28528","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121183","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[6152,"مجنون بهواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203733",""]],"verses":[["همُ ظنوا الكنانة زاد يوم","كظن النمل في نسف الهضاب",0,"ب",1,0],["هُمُ ظَفَروا بِالعِزِّ عَن سَيفِ صالِح","وَغرِّ المَعالي عَن ثِمالٍ وَعَن نَصرِ",1,"ر",1,0],["هم ظباء رعوا كناس قليبي","واسود لهم فؤادي عرين",2,"ن",1,0],["هُمُ ظعنوا والبرُّ يُطوى أمامهم","ومن خلفهم بحر المدامع يهملُ",3,"ل",1,0],["همُ ظنوا بأن هواكِ لهوُ","فكيف أجيبهم إن أحرجوني",4,"ن",2,1]]}