{"poems":[[55,"نأت القلوب وسوف تنأى الدار","https://www.aldiwan.net/poem30435.html","الكامل"],[95,"لا تحقر الدرهم من مسعد","https://www.aldiwan.net/poem11340.html","السريع"],[87,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[47,"قل للأرند إذا أتى الروحين لا","https://www.aldiwan.net/poem64596.html","الكامل"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[107,"نهض الغزاة فأين تمضي العير","https://www.aldiwan.net/poem43998.html","الكامل"],[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[469,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[549,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138071",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48933","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100812","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110083","البسيط"],[5652,"صدر الشمالي","https://www.poetsgate.com/ViewPoem.aspx?id=206703",""]],"verses":[["إيهاً مُؤَمِّلَ طَيِّءٍ لا تَنقُضَن","وُدّاً لَهُ مِن ذِمَّةٍ إِمرارُ",0,"ر",1,0],["إِيهاً مُحِبِّي مِصْرَ هَاتُوا عَلَى","دَعْوَى هَوَاهَا حُجَّةَ المُفْحِمِ",1,"م",1,0],["إيهِ أَمينُ لَمَستَ كُلَّ مُحَجَّبٍ","في الحُسنِ مِن أَثَرِ العُقولِ وَبادي",2,"د",2,0],["إيهاً مَلامَ بَني عُصَيرٍ إِنَّهُم","ذَهَبوا بِلُؤمِ مَناصِبٍ وَنُفوسِ",3,"س",1,0],["إيهاً مُلوكَ الشَرقِ إِنَّ وَراءَكُم","قَوماً يُوالونَ المَغارَ عجالا",4,"ل",2,0],["إيهٍ أميرَ الجندِ ليس كمثلهِ","جُندٌ ولا مِثلَ الأميرِ أميرُ",5,"ر",1,0],["إيهِ أُمّاهُ ما أرابَ شقيقَ النفسِ","منّا حتى تَبعَّدَ عنّا",6,"ن",2,0],["إيه أُمّاهُ إن نفسي أحسَّت","ما يُُقذِّي عينا ويُوقِرُ أُذْنا",6,"ن",2,0],["إيهاً ملامكَ إنَّ بين جوانحي","ناراً من البرحاءِ ذاتَ وقود",7,"د",1,0],["إيهٍ أمير المتعبين... إلى متى","تبقى، وهمُّ ضميرك الإنسان",8,"ن",1,0],["أيها مجيرَ العالمين من الأسى","وملاذ كلِّ مسهَّد حيران",9,"ن",1,0],["إيه أميرَ الليل اْطلُع على","هذا الدّجى بالقمر الأَكملِ",10,"ل",1,0],["إيه أمي لا تحزَني واحمليني","سوف يبدو لِلقومِ هذا الضِّياء",11,"ا",2,0],["إيهاً محمد في جود ومكرمةٍ","واربأ بكف تحاكى الصيّب الغدقا",12,"ق",2,1],["إيهاً معيد النظمِ ير","فُلُ منك في البُرد القشب",13,"ب",1,0],["ايهٍ امستمنياً بالكفّ مرتعشاً","يا ليتَ بالشلّ ذاكَ الكفُّ منكَ رُمِي",14,"م",2,0],["إيه آمريني وإتركيني على الضوووح","أرسم وصوفك نور يضوي ب جهره",15,"ر",2,0]]}