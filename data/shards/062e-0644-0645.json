{"poems":[[70,"خانني من لم أخنه","https://www.aldiwan.net/poem42430.html","مجزوء الرمل"],[49,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[208,"خل من لام وفيه نصحا","https://www.aldiwan.net/poem13352.html","الرمل"],[227,"خل من يأتم بالصل","https://www.aldiwan.net/poem50968.html","مجزوء الرمل"],[233,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[233,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[369,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[549,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"]],"verses":[["خَلِّ مَن خَلّاكَ يا قَل","بُ وَمَن خانَكَ خُنهُ",0,"ن",2,0],["خَلَّ ما عَزَّ لِمَن يَمنَعُهُ","قَد تَرى الشَيءَ إِذا عَزَّ مُنِع",1,"ع",1,0],["خلّ من لام وفيه نصحا","ان قلبي عن هواه ما صحا",2,"ح",2,1],["خَلِّ من يأتمّ بالصل","بانِ يغدو في اختلاطِ",3,"ط",1,1],["خَلِّ مَلامي في حُبِّ ظالِمَةٍ","لَم يَخلُ قَلبي فيها مِنَ الأَلَمِ",4,"م",1,0],["خَلِّ مِن دَمعِكَ ما تَب","كي بِهِ الرَبعَ الخَلاءا",5,"ا",3,0],["خلِّ ما بينَ مقلتَيكَ وقلبي","فعَلينا يدٌ من السُّلطانِ",6,"ن",1,0],["خَلِّ مَن كانَ لِلجنادلِ جارا","لا تُعِرهُ تلهّفاً واِدّكارا",7,"ر",2,1]]}