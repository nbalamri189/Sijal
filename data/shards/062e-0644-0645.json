{"poems":[[72,"خانني من لم أخنه","https://www.aldiwan.net/poem42430.html","مجزوء الرمل"],[51,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[214,"خل من لام وفيه نصحا","https://www.aldiwan.net/poem13352.html","الرمل"],[234,"خل من يأتم بالصل","https://www.aldiwan.net/poem50968.html","مجزوء الرمل"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[240,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[376,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[556,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202173",""],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104725","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107007","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93249","الرمل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136822",""],[5463,"خل من راح يرحل بكره شوقه يجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27213",""]],"verses":[["خَلِّ مَن خَلّاكَ يا قَل","بُ وَمَن خانَكَ خُنهُ",0,"ن",2,0],["خَلَّ ما عَزَّ لِمَن يَمنَعُهُ","قَد تَرى الشَيءَ إِذا عَزَّ مُنِع",1,"ع",1,0],["خلّ من لام وفيه نصحا","ان قلبي عن هواه ما صحا",2,"ح",2,1],["خَلِّ من يأتمّ بالصل","بانِ يغدو في اختلاطِ",3,"ط",1,1],["خَلِّ مَلامي في حُبِّ ظالِمَةٍ","لَم يَخلُ قَلبي فيها مِنَ الأَلَمِ",4,"م",1,0],["خَلِّ مِن دَمعِكَ ما تَب","كي بِهِ الرَبعَ الخَلاءا",5,"ا",3,0],["خلِّ ما بينَ مقلتَيكَ وقلبي","فعَلينا يدٌ من السُّلطانِ",6,"ن",1,0],["خَلِّ مَن كانَ لِلجنادلِ جارا","لا تُعِرهُ تلهّفاً واِدّكارا",7,"ر",2,1],["خَلِّ ما بالدِّنانِ واستنطِقِ العي","دانَ يَنطِقنَ مِن أكُفِّ الجَوارِ",8,"ر",1,0],["خَلِّ مَيْدانَ الحنين لِمَنْ","قلبُه للشَّوْق مَيْدانُ",9,"ن",1,0],["خَلمَّا شَوقاً لِلحَبِيبِ وَأطرَبا","فَمَن كانَ يَرجُو اللهَ قَصداً وَمأرَبا",10,"ب",2,0],["خلّ ماء السما وشعشع حميا ال","كأس مجلوة بماء لماها",11,"ا",3,0],["خَلِّ ما بينَ دُماها ودَمي","فعلى تلك الدُّمى تجري الدِّماءُ",12,"ا",2,0],["خل مولاك يفعل ما يشاء في عبيده","فإنه إلا يصرفهم على ما يريده",13,"د",2,0],["خَلّ من راح يرحل .. عن حياتك ينوعي","خَلّ من راح يرحل بكره شوقه يجيبه",14,"ب",2,0]]}