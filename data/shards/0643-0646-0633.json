{"poems":[[59,"كن ساكنا في ذا الزمان بسيره","https://www.aldiwan.net/poem24685.html","الكامل"],[74,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[87,"شرفاً نصير ارفع جبينك عالياً","https://www.aldiwan.net/poem8081.html","الكامل"],[71,"وفتاة إن شدت أو أنشدت","https://www.aldiwan.net/poem28141.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[102,"أمسية حجرية","https://www.poetsgate.com/ViewPoem.aspx?id=50362",""],[124,"أجوب فيافي العيش سدمان حئرا","https://www.aldiwan.net/poem49282.html","الطويل"],[159,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[173,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[259,"قلب عنيد","https://www.aldiwan.net/poem24960.html","مجزوء الرمل"],[366,"محبك يا شقيق الروح يرجو","https://www.aldiwan.net/poem68102.html","الوافر"],[369,"اليوم عاد رجائي مورق العود","https://www.aldiwan.net/poem60929.html","البسيط"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[435,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80211","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136160","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79440","الخفيف"],[1555,"","https://poetry.dctabudhabi.ae/diwan/poem/105606","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125366","الوافر"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76829","الرجز"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142819","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109684","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93907","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204703","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74045","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114671","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121279","الخفيف"],[4978,"الدكتور عبدالعزيز محمد الغانم","https://www.poetsgate.com/ViewPoem.aspx?id=189771",""],[5061,"حب بدوي","https://www.poetsgate.com/ViewPoem.aspx?id=148017",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5491,"فيض الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203217",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5791,"تعويذة حبر داخن ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208589",""],[5818,"ابتسام المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=197055",""],[5853,"((لمن ..أغني ؟))","https://www.poetsgate.com/ViewPoem.aspx?id=175660",""],[5956,"كنسمة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=192707",""]],"verses":[["كُن ساكِناً في ذا الزَمانِ بِسَيرِهِ","وَعَنِ الوَرى كُن راهِباً في دَيرِهِ",0,"ر",2,1],["كنسيم الصبا جنائب خطوٍ","كلّ طرفٍ يقبِّل البرق نعله",1,"ل",2,0],["كنسيمِ الرياضِ في غلسِ اللي","لِ إذا ساقه نسيمُ الشمالِ",2,"ل",1,0],["كُن سابِقاً فيهِ أَوِ اِبقَ بِمَعزِلٍ","لَيسَ التَوَسُّطُ لِلنُبوغِ سَبيلا",3,"ل",2,0],["كنسيمٍ هزَّ أغصانَ النقا","يعذبُ الغيَّ ويغوي العذبا",4,"ب",2,0],["كَنَسِيبِهِ الأَخَّاذِ بِ","الألْبَابِ فَلْيَكُنِ النَّسِيبُ",5,"ب",1,0],["كنسيج الطّحلب الصيفي نمت","أعشبت فيها ، وفي وجهي البلاده",6,"د",2,0],["كنسر يريد النهض لا يستطيعه","وهيهات منه والجناح ثقيل",7,"ل",1,0],["كنَسيمِ الشَّمالِ في آخرِ اللي","لِ إِذا هَبَّ في الليالي القِصارِ",8,"ر",1,0],["كَنِسيانيَ الأَوطانَ في ظِلِّ سَيِّدٍ","جَلى الغَمَّ عَن سَوداءِ قَلبي وَكَشَّفا",9,"ف",2,0],["كَنَسوهم مِنَ الشآم ولَكن","بَقِيَت في القمامةِ الأخثاءُ",10,"ا",2,0],["كُنْ سميعاً يافؤادي","عند عقلي خُذْ دواكَ",11,"ك",1,0],["كَنِسبَة قطرة يَوما أَضيفَت","اِلى بَحر عَظيم أَو بُحور",12,"ر",1,0],["كَنَسجِ مَسرودَةِ العِطفَينِ سابِغَةٍ","أَو نَظمِ مُنخَرِطٍ في السِلكِ مَسرودِ",13,"د",1,0],["كنسيجِ الرياضِ وشّتْه بالأن","وا رِ صُبْحاً أناملُ الأنواء",14,"ا",2,0],["كن سليماً فإن من فطر النا","س مفيض في خلقه أنعامه",15,"م",2,0],["كَنَسيمةٍ هَبَّت عَلى النار الَّتي","تَحتَ الرَماد فَأَسفَرَت كَسَناكا",16,"ك",2,0],["كن سالكا سبيل من","عن السوى قد انجرد",17,"د",1,0],["كنسيمٍ مُعَقَّدٍ","وشعاعٍ مُجَسَّدِ",18,"د",1,0],["كن سهيلا فيه صب متيم","يؤمل أن يلقي بطلعته ألفا",19,"ف",2,0],["كنسوَةِ يُوسُفٍ لما تجَلَّى","يُقطِّعنَ الأنامِلَ بالنِّصَالِ",20,"ل",1,0],["كن سامرِيَّاً لا تكن","مِمَّن إليها التفتا",21,"ت",2,0],["كن ساجداً للقِردِ في زمانِه","ومُدَّ للجاهل في عِنانِه",22,"ه",1,1],["كنسوة السوء يكرهن اللحى ابداً","حتى العمائم في أبصارهنَّ عما",23,"م",2,0],["كن سهماً منك لها نَبذاً","وأسلَك فيها قلباً جَبَذاَ",24,"ذ",2,0],["كنسيم الصبا وعهد التصابي","أو كراح دارت بها الأكواب",25,"ب",1,0],["كن سبعا وأربعٌ متن منها","معقبات في مهجتي آلاما",26,"م",2,0],["كَنَسيمِ الرياضِ هبّ عَليلاً","وَكَبَدرِ السَماء تمّ كَمالا",27,"ل",2,0],["كن سميري ومؤنسي في الليالي","أيها البدر يا اله الجمال",28,"ل",1,1],["كن ساعيا ومصافعا ومضارطا","تنل الرغائب فى الزمان وتنفق",29,"ق",1,0],["كنسيم الصّباح جَمَّشَ حدَّ الر","راح فرَّتْ عنهُ ثغورُ القناني",30,"ن",2,0],["كنسرٍ من على السحب","يزف إلى ربي كثب",31,"ب",1,0],["كنَسيمِ النعيم حيثُ حلَلتم","حلّ بالواردين روح وبُشرى",32,"ر",2,0],["كن سابقي في كل خير، إنني","حسبي يؤم بي النبيل العالمُ",33,"م",1,0],["كنسل الثنتين يرحم جدتك","قدر انك طايح بحب بدوي",34,"و",2,0],["كنسيم تسنيم يفوح ختامه","مسكاً فيغشى خاتم الرسلاء",35,"ا",2,0],["كَنَسْمَة فَجْرٍ في الْعُيونِ مَلاذُها","وَ فَتْكَةُ عَيْنَيْهِ سُيوفٌ قَواطِعُ",36,"ع",1,0],["كَنَسَتْ فِي حِجَالِ هَوادِجِها","خُرَّدٌ كالدُّمَى لُعُسٌ عُرُبُ",37,"ب",1,0],["كن سطرَ موّالها المحفوفِ بالجمرِ","واقرأْ على رأسِها تعويذةَ الحبرِ",38,"ر",1,1],["كنْ سماءً ف ثمّ فرْحٌ بعيدٌ","يؤجر المرء ب ارتقاء النوايا",39,"ا",3,0],["كنسمة الفجر كالإشراق نبصرها","في بسمة الطفل كالأزهار تبهجنا",40,"ن",2,0],["كنسمة الصبح آتيكم وأوقظكم","بدهشةِ الحبِ كالعصفور في الفننِ",41,"ن",1,1]]}