"https://www.aldiwan.net/poem55933.html","الرمل"],[456,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[459,"تتبارى أقلامه وقناه","https://www.aldiwan.net/poem16166.html","الخفيف"],[459,"أرج النسيم فقلت نشر خميلة","https://www.aldiwan.net/poem16338.html","الكامل"],[462,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[462,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[462,"أيها الكامل المروءة والمفحم","https://www.aldiwan.net/poem3234.html","عموديه"],[462,"ما جماد يفيد مالاً وعدماً","https://www.aldiwan.net/poem3460.html","عموديه"],[462,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[466,"يا أيها الغيث الذي","https://www.aldiwan.net/poem59632.html","مجزوء الكامل"],[466,"يا موردا من جود","https://www.aldiwan.net/poem60181.html","المجتث"],[466,"لنا صديق صادق الوعد","https://www.aldiwan.net/poem60217.html","السريع"],[475,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[475,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[477,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[498,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[498,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[503,"نسوة الحيّ الشرقيّ","https://www.aldiwan.net/poem27890.html","الخفيف"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[514,"ما جاوزت ناقتي حفلا ولا سلكت","https://www.aldiwan.net/poem48594.html","البسيط"],[549,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[549,"لا تسلني عن المشيب فمذ جل","https://www.aldiwan.net/poem47238.html","الخفيف"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[562,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[565,"قد أتانا الذي بعثت إلينا","https://www.aldiwan.net/poem69461.html","الخفيف"],[573,"رب لهو رفلت في أثوابه","https://www.aldiwan.net/poem2992.html","الخفيف"],[573,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[573,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[573,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[573,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[583,"لا تلق دهرك بالعتاب","https://www.aldiwan.net/poem1570.html",""]],"verses":[["ما جَزَعي لِمَن مَضى","وَأَنتَ لي فيمَن غَبَر",0,"ر",1,0],["ما جَزِعنا تَحتَ العَجاجَةِ إِذ وَ","لَّت بِأَقفائِها وَحَرَّ الصِلاءُ",1,"ا",2,0],["ماجِداً مُفْضِلاً شُجاعاً حَليماً","واسِعَ المُنْتَدى كثيرَ الرّمادِ",2,"د",1,0],["ما جالَ بَعدَكِ لَحظي في سَنا القَمَرِ","إِلّا ذَكَرتُكِ ذِكرَ العَينِ بِالأَثَرِ",3,"ر",1,1],["ما جَزاءُ الوَزيرِ مِنكَ إِذا اِخ","تَصَّكَ أَن تَستَمِرَّ في إِدمانِك",4,"ك",1,0],["ما جرأتي من بعد ذا","ك على خطابك يا همام",5,"م",1,0],["مَا جَزِعْنَا عَلَيْكَ إِذْ","بِعْتَ بِالجَنَّةِ الدِّمَنْ",6,"ن",1,0],["مَا جَنَاهُ الرَّدَى بَحَجْبِكَ عَنْهُمْ","سَبَقَتْهُ جِنَايَةُ الأَسْقَامِ",7,"م",1,0],["مَا جَاهُهَا إِنْ رَقِيَتْ قِلَّةٌ","وَلَمْ يُدَانِ القِلَّةَ المُعْظَمُ",8,"م",1,0],["ما جَعفَرُ اِبنِ مُحَمَّدِ اِبنِ الأَشعَثِ","عِندِيَ بِخَيرٍ اِبُوَّةً مِن عَثعَثِ",9,"ث",1,1],["ما جئت منزلة إلاّ بَنَيت بها","بيتاً من الشعر لابيتاً من الشَعَر",10,"ر",1,0],["مَاجِدٌ حاربَ الحوادثَ دوني","بنَدى حاتمٍ وبأسِ شَبيبِ",11,"ب",1,0],["ما جَربُ المرءِ داءَ جِلْدتِهِ","بل إنّما داءُ عِرضهِ جَرَبُهْ",12,"ب",2,0],["ما جَنْينَا إليك ذنباً فلا تَعْ","جَلْ علينا بمثل هذا العقابِ",13,"ب",1,0],["ما جُنَّ من عشقٍ فؤادٌ بها","كلّا ولا ذابت بها مهجَهْ",14,"ج",2,0],["ماجدٌ يَحْمي لَدَيْهِ","حَسَبٌ محضٌ صُرَاحُ",15,"ح",1,0],["ما جُمِع الفطرُ إلى جُمْعةٍ","إلا لِمُلك ولتخليدِ",16,"د",1,0],["ماجدٌ لم يَسْتَثِبْ قطُّ يداً","وهو إن أبْدَيت بالشكر رصودُ",17,"د",1,0],["ماجدٌ ينفُذُ في حكمته","ومساعي بِرِّه كل النفاذِ",18,"ذ",1,0],["ماجدٌ يزجر الخطوبَ فترْفضْ","ضُ عن الآمليه أيَّ ارفضاض",19,"ض",1,0],["ما جاء من سوء بذري خُبثُ ريعكمُ","عند ازدراعيَ بل من خُبث مُزْدرعي",20,"ع",2,0],["ما جعل اللَّه بين علمكُمُ","وبينكم غيرَ مَجدِكم وُصَلا",21,"ل",2,0],["ماجدٌ سائرُ النَدى في فَيافٍ","مقفراتٍ من أهله أفلالِ",22,"ل",1,0],["ما جاورتْ نبطيَّ الزلِّ نبعتُه","بل جاورت النبع والشم",23,"م",1,0],["ماجدٌ ساخ عرقُهُ في ثرى المجْ","دِ وأوفت على الغصون غُصونه",24,"ن",2,0],["ماجدٌ يبذل الجزيلَ بلا مَنْ","نٍ ويُعدي على صروف زمانه",25,"ن",2,0],["ما جاء في الأير نهيٌ عن عبادتهِ","لا في زَبورٍ ولا تنزيل فُرقان",26,"ن",1,0],["ما جِذعُ سَوءٍ خَرَّقَ السوسُ أَصلَهُ","لِما حَمَّلَتهُ وائِلٌ بِمُطيقِ",27,"ق",1,1],["ما جَنَتهُ الزُنودُ حَتّى يَنالَ ال","عُريُ مِنها يا عارِياتِ الزُنودِ",28,"د",1,0],["ماجَتِ الدارُ بِمَن فيها كَما","ماجَ نَهرٌ ثائِرٌ مُنكَدِرُ",29,"ر",1,0],["ما جَحِدَ الحُبَّ غَيرَ جاهِلِهِ","أَيَجحَدُ الشَمسَ مَن لَهُ بَصَرُ",30,"ر",1,0],["ما جاءَنا بِكَ صاحَ بُطرُسُ غاضِباً","يا شَرَّ إِنسانٍ عَلى الإِنسانِ",31,"ن",1,0],["ما جنت أيديه ثمار المساعي","يوم مدت منهم إليها البوع",32,"ع",1,0],["ما جمال يحس بالسمع الا","كجمال يحس بالابصار",33,"ر",1,0],["ما جنى الفلك ولا ربانه","غير ان القدر الاعمى جنى",34,"ن",2,0],["ما جاءنا الشر إلا من تهاوننا","ما عمنا الظلم إلا من تغاضينا",35,"ن",2,0],["ما جرى ذكره بناديك حتى","وقف الدمع في الشؤون فأثنى",36,"ن",2,0],["ماجت دمنهو بسكانها","وهزها الشوق إلى قربه",37,"ب",2,0],["ماج السراى وميدان السراى بها","وماج متسع الساحات والرحب",38,"ب",1,0],["ما جَلَّ خَطبٌ ثُمَّ قيسَ بِغَيرِهِ","إِلّا وَهَوَّنَهُ القِياسُ وَصَغَّرا",39,"ر",2,0],["ما جَلَّ فيهِم عيدُكَ المَأثورُ","إِلّا وَأَنتَ أَجَلُّ يا فِكتورُ",40,"ر",1,1],["ما جُهِّزَت راياتُكُم لِمُخالِفٍ","إِلّا تَهَدَّمَ كَهفُهُ المُستَصعَبُ",41,"ب",1,0],["ما جُرمُ مَن هامَ بِذي لَوعَةٍ","شَبيهَةٌ شَمسُ الضُحى الأَكبَرِ",42,"ر",1,0],["ما جَرى خاطِرُ ذاكَ الكَ","رَم المَحضِ بِبالِه",43,"ل",2,0],["ماجَوُّ خَبتٍ وَإِن نَأَت ظُعُنُه","تارِكُنا أَو تَشوقُنا دِمَنُه",44,"ن",2,1],["ماجَتْ صَوارِمُه عليهم فانثَنَتْ","ولُجَيْنُ دِجلةَ مُذْهَبُ المَوْجَينِ",45,"ن",1,0],["ما جَمَّلَتكَ مدائحي لكنَّها","أضحَت بذِكركَ في الورَى تَتجمَّلُ",46,"ل",1,0],["ما جَوابٌ أَولى بِكُلِّ جَميلٍ","مِن جَوابٍ يُرَدُّ مِن بَعدِ شَهرِ",47,"ر",1,0],["ما جاءَ عَبدَكَ مَسطورٌ بَعَثتَ بِهِ","إِلّا تَقَبَّلَهُ حُبّاً وَقَبَّلَهُ",48,"ل",2,1],["ما جَمَعَت شَملَ العُلى كَفُّه","إِلّا تَداعى مالُهُ بِالشَتات",49,"ت",1,0],["ما جادَ لِلناسِ إِلّا قَبلَ ما سَأَلوا","وَلا عَفا قَطُّ إِلّا بَعدَما قَدَرا",50,"ر",2,0],["ما جاء في درعه يعدو بحدّته","إلا وأشْبَهَ منه لبدةً غممُ",51,"م",1,0],["ما جادَ جودَكَ إِذ تُعطي بِلا عِدَةٍ","ما يُرتَجى مِنكَ لا كَعبٌ وَلا هَرِمُ",52,"م",1,0],["ماجِدٌ أَفرَطَت عِنايَتُهُ حَت","تى تَوَهَّمتُ أَنَّها في المَنامِ",53,"م",1,0],["ما جادَ عذارُهُ لدمعي ال","سائلِ لا ما يحبُّ سائلْ",54,"ل",1,0],["ماجِدٌ قَد صَبا بِكُم","وَالصِبى غَيرُ طائِلِ",55,"ل",1,0],["ما جَنَّةُ الخُلدِ إِلّا في دِيارِكُمُ","وَلَو تَخَيَّرتُ هَذا كُنتُ أَختارُ",56,"ر",1,0],["ما جَرَت هَذِهِ عَلى الخَدِّ حَتّى","لَحِقَت تِلكَ بِالَّتي سَبَقَتها",57,"ت",3,0],["ما جَادَ بَاذِلُ نفسِه لِبلادِه","وإنِ احْتَفَى مُثْنٍ ولَجَّ شَكُورُ",58,"ر",1,0],["ما جالَ إلا انْجلَتْ عن مِصرَ أبؤسُها","ولا تبلَّج إلا انْجابت الظُّلَمُ",59,"م",1,0],["ما جِئتُهُم بِالقَوافي الغُرِّ مُمتَدِحاً","إِلّا وَجَدتُهُمو مِن فَوقِ تَمداحي",60,"ح",2,0],["ماجَت فِجاجُ المَشرِقينَ مَصائِباً","وَطَغَت شِعابُ الوادِيَينِ دَواهِيا",61,"ي",2,0],["ما جلَّ مُدَّخرٌ فَخِيمٌ شأنُهُ","إلا الذي ادَّخروا أَجَلُّ وأفخم",62,"م",1,0],["ماجَ كالبحرِ طغتْ أثباجُه","وارتمت أهوالهُ حولَ السّفِينْ",63,"ن",1,0],["مَاجتِ الأرضُ حوله وتجلَّى ال","لَهُ يَنهَى بُركانَها أن يفورا",64,"ر",2,0],["ماجِدٌ حازَ في المَعالي اِحتِفالاً","هُوَ في طُرُقِهِ إِلَيها اِختِصارُ",65,"ر",1,0],["ما جَحَدنا أفضالكم غير أنَّا","لم تزل في نفوسنا أُمنيَّةْ",66,"ي",2,0],["ما جَفَّ دَمعُكِ حَتّى اليَومِ مِن حَزَنٍ","مِن ذِكرِها وَاِستَخَفَّ القَلبُ لِلذِكَرِ",67,"ر",1,0],["ما جِئتُ سُخطاً لَكُم عَلِمتُ بِهِ","وَلا تَبَدَّلتُ غَيرَكُم بَدَلا",68,"ل",2,0],["ما جَهِلَ المَيدانُ فُرسانَهُ","قد بانَتِ الهُجْنُ منَ العُتْق",69,"ق",1,0],["ما جازَ هَذا إِلَينا ال","أَقوامَ إِلّا لِحُبّي",70,"ي",1,0],["ما جِئتُ ذَنباً بِهِ اِستَوجَبتُ سَخطَكُمُ","أَستَغفِرُ اللَهَ إِلّا شِدَّةُ النَظَرِ",71,"ر",1,1],["ما جَمَعَت راحَتاكَ مالاً","وَمُعدِماً قَطُّ في مَكانِ",72,"ن",1,0],["ما جاءني أحدٌ يخبّر أنّهُ","في جنّةٍ مُذ ماتَ أو في نارِ",73,"ر",1,0],["ما جِئتُ سَلمى طَوعاً لِتَجعَلَني","ذِبحاً وَلَكِن أَطاعَني النُجُبُ",74,"ب",1,0],["ما جُلِبَ الخَيرُ إِلى","صاحِبِ عَقلٍ وَكَسَد",75,"د",1,1],["ما جُدَرِيٌّ أَماتَ صاحِبَهُ","مِن جُدَرِيٍّ أَتَت بِهِ جَدَرُ",76,"ر",1,1],["ما جاءَ مِنها وافِدٌ مُتَسَرِّعٌ","فَنَقولُ لِلنَّبإِ الجَديدِ بَدارِ",77,"ر",1,0],["ما جادَ مِن دَمِهِ المَصونِ بِقَطرَةٍ","وَأَجادَ وَصفَ دِمائِها بِجُبارِ",78,"ر",1,0],["ما جارَ شَمّاسُكَ في حُكمِهِ","وَلا يَهودِيُّكَ بِالطامِعِ",79,"ع",1,0],["ماجَتْ نُمَيرٌ فهاجَتْ منكَ ذا لِبَدٍ","واللّيْثُ أفْتَكُ أفعالاً من النّمِرِ",80,"ر",1,0],["ما جِئْتُ مِني أَبْغِي قرى كالضّيفِ","عندي بك شغلٌ عن نزولِ الخَيفِ",81,"ف",1,1],["ما جئتُ إلا لِلْبَنِيَّةِ زائراً","أَقضِي لربِّي حقَّها وأُعَظّمُ",82,"م",1,0],["ما جزاءُ الذين قد كفروا إل","لا عذابٌ برحٌ وإلا سعير",83,"ر",1,0],["ما جاز أن يهضم الإنسان أخوته","وأن يجرب في الإذلال قدرته",84,"ه",1,0],["ما جاءَ وصف وَليٍّ في مصاحبة","إلا وَفضل وليٍّ فوق ما وصفوا",85,"ف",3,0],["ما جئت أَستَبِق الحَياة مُسارِعاً","لَو كانَ لي قبل المَجيء خيار",86,"ر",1,0],["ماجاءَ الأمر كَما أَرجو","ه وقد تدري ما أَقصده",87,"د",2,0],["ما جاءَ يفسده الجنو","ب تعيده أَيدي الشمال",88,"ل",1,0],["ماجت خمائلَ بالبشرى وأوديةً","فهن فاكهةٌ تَندى وصهباءُ",89,"ا",2,0],["ما جِئتُ بابَكَ مادِحاً بَل داعِياً","وَمِنَ المَديحِ تَضَرُّعٌ وَدُعاءُ",90,"ا",2,0],["مَا جَهِلَتْ خَيْلُ العِدَى فيْصَلاً","وَالطَّعْنُ فِي لَبَّاتِهَا هَبْرُ",91,"ر",1,0],["مَا