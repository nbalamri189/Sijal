ملحة بالعذل تحسب أنني","https://www.aldiwan.net/poem66630.html","الكامل"],[50,"يا صاح دعني فإنني نصب","https://www.aldiwan.net/poem64857.html","المنسرح"],[46,"ما جلب الخير إلى","https://www.aldiwan.net/poem22496.html","مجزوء الرجز"],[46,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[46,"ما حركت قدم ولا بسطت يد","https://www.aldiwan.net/poem22709.html","الكامل"],[46,"المرء يأبر خسة في طبعه","https://www.aldiwan.net/poem22716.html","الكامل"],[46,"الطيلسان اشتق في لفظه","https://www.aldiwan.net/poem22967.html","السريع"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[68,"ما جئت مني أبغي قرى كالضيف","https://www.aldiwan.net/poem1511.html",""],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49137","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85560","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85496","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141985","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141965","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[106,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"سيصدني وأصده","https://www.poetsgate.com/ViewPoem.aspx?id=179085",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[54,"مَا جَعفرُ بنُ محمَّدٍ بنِ الأَشعَثِ","https://www.poetsgate.com/ViewPoem.aspx?id=13996",""],[45,"أطنبت في اللوم فلا تكثري","https://www.poetsgate.com/ViewPoem.aspx?id=31204",""],[91,"فلنعش","https://www.poetsgate.com/ViewPoem.aspx?id=24256",""],[51,"لا تحسب النَّبطُ الأوغادُ أنَّهُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=30508",""]],"verses":[["ما جَزَعي لِمَن مَضى","وَأَنتَ لي فيمَن غَبَر",0,"ر",1,0],["ما جَزِعنا تَحتَ العَجاجَةِ إِذ وَ","لَّت بِأَقفائِها وَحَرَّ الصِلاءُ",1,"ا",2,0],["ماجِداً مُفْضِلاً شُجاعاً حَليماً","واسِعَ المُنْتَدى كثيرَ الرّمادِ",2,"د",1,0],["ما جالَ بَعدَكِ لَحظي في سَنا القَمَرِ","إِلّا ذَكَرتُكِ ذِكرَ العَينِ بِالأَثَرِ",3,"ر",1,1],["ما جَزاءُ الوَزيرِ مِنكَ إِذا اِخ","تَصَّكَ أَن تَستَمِرَّ في إِدمانِك",4,"ك",1,0],["ما جرأتي من بعد ذا","ك على خطابك يا همام",5,"م",1,0],["مَا جَزِعْنَا عَلَيْكَ إِذْ","بِعْتَ بِالجَنَّةِ الدِّمَنْ",6,"ن",1,0],["مَا جَنَاهُ الرَّدَى بَحَجْبِكَ عَنْهُمْ","سَبَقَتْهُ جِنَايَةُ الأَسْقَامِ",7,"م",1,0],["مَا جَاهُهَا إِنْ رَقِيَتْ قِلَّةٌ","وَلَمْ يُدَانِ القِلَّةَ المُعْظَمُ",8,"م",1,0],["ما جَعفَرُ اِبنِ مُحَمَّدِ اِبنِ الأَشعَثِ","عِندِيَ بِخَيرٍ اِبُوَّةً مِن عَثعَثِ",9,"ث",1,1],["ما جئت منزلة إلاّ بَنَيت بها","بيتاً من الشعر لابيتاً من الشَعَر",10,"ر",1,0],["مَاجِدٌ حاربَ الحوادثَ دوني","بنَدى حاتمٍ وبأسِ شَبيبِ",11,"ب",1,0],["ما جَربُ المرءِ داءَ جِلْدتِهِ","بل إنّما داءُ عِرضهِ جَرَبُهْ",12,"ب",2,0],["ما جَنْينَا إليك ذنباً فلا تَعْ","جَلْ علينا بمثل هذا العقابِ",13,"ب",1,0],["ما جُنَّ من عشقٍ فؤادٌ بها","كلّا ولا ذابت بها مهجَهْ",14,"ج",2,0],["ماجدٌ يَحْمي لَدَيْهِ","حَسَبٌ محضٌ صُرَاحُ",15,"ح",1,0],["ما جُمِع الفطرُ إلى جُمْعةٍ","إلا لِمُلك ولتخليدِ",16,"د",1,0],["ماجدٌ لم يَسْتَثِبْ قطُّ يداً","وهو إن أبْدَيت بالشكر رصودُ",17,"د",1,0],["ماجدٌ ينفُذُ في حكمته","ومساعي بِرِّه كل النفاذِ",18,"ذ",1,0],["ماجدٌ يزجر الخطوبَ فترْفضْ","ضُ عن الآمليه أيَّ ارفضاض",19,"ض",1,0],["ما جاء من سوء بذري خُبثُ ريعكمُ","عند ازدراعيَ بل من خُبث مُزْدرعي",20,"ع",2,0],["ما جعل اللَّه بين علمكُمُ","وبينكم غيرَ مَجدِكم وُصَلا",21,"ل",2,0],["ماجدٌ سائرُ النَدى في فَيافٍ","مقفراتٍ من أهله أفلالِ",22,"ل",1,0],["ما جاورتْ نبطيَّ الزلِّ نبعتُه","بل جاورت النبع والشم",23,"م",1,0],["ماجدٌ ساخ عرقُهُ في ثرى المجْ","دِ وأوفت على الغصون غُصونه",24,"ن",2,0],["ماجدٌ يبذل الجزيلَ بلا مَنْ","نٍ ويُعدي على صروف زمانه",25,"ن",2,0],["ما جاء في الأير نهيٌ عن عبادتهِ","لا في زَبورٍ ولا تنزيل فُرقان",26,"ن",1,0],["ما جِذعُ سَوءٍ خَرَّقَ السوسُ أَصلَهُ","لِما حَمَّلَتهُ وائِلٌ بِمُطيقِ",27,"ق",1,1],["ما جَنَتهُ الزُنودُ حَتّى يَنالَ ال","عُريُ مِنها يا عارِياتِ الزُنودِ",28,"د",1,0],["ماجَتِ الدارُ بِمَن فيها كَما","ماجَ نَهرٌ ثائِرٌ مُنكَدِرُ",29,"ر",1,0],["ما جَحِدَ الحُبَّ غَيرَ جاهِلِهِ","أَيَجحَدُ الشَمسَ مَن لَهُ بَصَرُ",30,"ر",1,0],["ما جاءَنا بِكَ صاحَ بُطرُسُ غاضِباً","يا شَرَّ إِنسانٍ عَلى الإِنسانِ",31,"ن",1,0],["ما جنت أيديه ثمار المساعي","يوم مدت منهم إليها البوع",32,"ع",1,0],["ما جمال يحس بالسمع الا","كجمال يحس بالابصار",33,"ر",1,0],["ما جنى الفلك ولا ربانه","غير ان القدر الاعمى جنى",34,"ن",2,0],["ما جاءنا الشر إلا من تهاوننا","ما عمنا الظلم إلا من تغاضينا",35,"ن",2,0],["ما جرى ذكره بناديك حتى","وقف الدمع في الشؤون فأثنى",36,"ن",2,0],["ماجت دمنهو بسكانها","وهزها الشوق إلى قربه",37,"ب",2,0],["ماج السراى وميدان السراى بها","وماج متسع الساحات والرحب",38,"ب",1,0],["ما جَلَّ خَطبٌ ثُمَّ قيسَ بِغَيرِهِ","إِلّا وَهَوَّنَهُ القِياسُ وَصَغَّرا",39,"ر",2,0],["ما جَلَّ فيهِم عيدُكَ المَأثورُ","إِلّا وَأَنتَ أَجَلُّ يا فِكتورُ",40,"ر",1,1],["ما جُهِّزَت راياتُكُم لِمُخالِفٍ","إِلّا تَهَدَّمَ كَهفُهُ المُستَصعَبُ",41,"ب",1,0],["ما جُرمُ مَن هامَ بِذي لَوعَةٍ","شَبيهَةٌ شَمسُ الضُحى الأَكبَرِ",42,"ر",1,0],["ما جَرى خاطِرُ ذاكَ الكَ","رَم المَحضِ بِبالِه",43,"ل",2,0],["ماجَوُّ خَبتٍ وَإِن نَأَت ظُعُنُه","تارِكُنا أَو تَشوقُنا دِمَنُه",44,"ن",2,1],["ماجَتْ صَوارِمُه عليهم فانثَنَتْ","ولُجَيْنُ دِجلةَ مُذْهَبُ المَوْجَينِ",45,"ن",1,0],["ما جَمَّلَتكَ مدائحي لكنَّها","أضحَت بذِكركَ في الورَى تَتجمَّلُ",46,"ل",1,0],["ما جَوابٌ أَولى بِكُلِّ جَميلٍ","مِن جَوابٍ يُرَدُّ مِن بَعدِ شَهرِ",47,"ر",1,0],["ما جاءَ عَبدَكَ مَسطورٌ بَعَثتَ بِهِ","إِلّا تَقَبَّلَهُ حُبّاً وَقَبَّلَهُ",48,"ل",2,1],["ما جَمَعَت شَملَ العُلى كَفُّه","إِلّا تَداعى مالُهُ بِالشَتات",49,"ت",1,0],["ما جادَ لِلناسِ إِلّا قَبلَ ما سَأَلوا","وَلا عَفا قَطُّ إِلّا بَعدَما قَدَرا",50,"ر",2,0],["ما جاء في درعه يعدو بحدّته","إلا وأشْبَهَ منه لبدةً غممُ",51,"م",1,0],["ما جادَ جودَكَ إِذ تُعطي بِلا عِدَةٍ","ما يُرتَجى مِنكَ لا كَعبٌ وَلا هَرِمُ",52,"م",1,0],["ماجِدٌ أَفرَطَت عِنايَتُهُ حَت","تى تَوَهَّمتُ أَنَّها في المَنامِ",53,"م",1,0],["ما جادَ عذارُهُ لدمعي ال","سائلِ لا ما يحبُّ سائلْ",54,"ل",1,0],["ماجِدٌ قَد صَبا بِكُم","وَالصِبى غَيرُ طائِلِ",55,"ل",1,0],["ما جَنَّةُ الخُلدِ إِلّا في دِيارِكُمُ","وَلَو تَخَيَّرتُ هَذا كُنتُ أَختارُ",56,"ر",1,0],["ما جَرَت هَذِهِ عَلى الخَدِّ حَتّى","لَحِقَت تِلكَ بِالَّتي سَبَقَتها",57,"ت",3,0],["ما جَادَ بَاذِلُ نفسِه لِبلادِه","وإنِ احْتَفَى مُثْنٍ ولَجَّ شَكُورُ",58,"ر",1,0],["ما جالَ إلا انْجلَتْ عن مِصرَ أبؤسُها","ولا تبلَّج إلا انْجابت الظُّلَمُ",59,"م",1,0],["ما جِئتُهُم بِالقَوافي الغُرِّ مُمتَدِحاً","إِلّا وَجَدتُهُمو مِن فَوقِ تَمداحي",60,"ح",2,0],["ماجَت فِجاجُ المَشرِقينَ مَصائِباً","وَطَغَت شِعابُ الوادِيَينِ دَواهِيا",61,"ي",2,0],["ما جلَّ مُدَّخرٌ فَخِيمٌ شأنُهُ","إلا الذي ادَّخروا أَجَلُّ وأفخم",62,"م",1,0],["ماجَ كالبحرِ طغتْ أثباجُه","وارتمت أهوالهُ حولَ السّفِينْ",63,"ن",1,0],["مَاجتِ الأرضُ حوله وتجلَّى ال","لَهُ يَنهَى بُركانَها أن يفورا",64,"ر",2,0],["ماجِدٌ حازَ في المَعالي اِحتِفالاً","هُوَ في طُرُقِهِ إِلَيها اِختِصارُ",65,"ر",1,0],["ما جَحَدنا أفضالكم غير أنَّا","لم تزل في نفوسنا أُمنيَّةْ",66,"ي",2,0],["ما جَفَّ دَمعُكِ حَتّى اليَومِ مِن حَزَنٍ","مِن ذِكرِها وَاِستَخَفَّ القَلبُ لِلذِكَرِ",67,"ر",1,0],["ما جِئتُ سُخطاً لَكُم عَلِمتُ بِهِ","وَلا تَبَدَّلتُ غَيرَكُم بَدَلا",68,"ل",2,0],["ما جَهِلَ المَيدانُ فُرسانَهُ","قد بانَتِ الهُجْنُ منَ العُتْق",69,"ق",1,0],["ما جازَ هَذا إِلَينا ال","أَقوامَ إِلّا لِحُبّي",70,"ي",1,0],["ما جِئتُ ذَنباً بِهِ اِستَوجَبتُ سَخطَكُمُ","أَستَغفِرُ اللَهَ إِلّا شِدَّةُ النَظَرِ",71,"ر",1,1],["ما جَمَعَت راحَتاكَ مالاً","وَمُعدِماً قَطُّ في مَكانِ",72,"ن",1,0],["ما جاءني أحدٌ يخبّر أنّهُ","في جنّةٍ مُذ ماتَ أو في نارِ",73,"ر",1,0],["ما جِئتُ سَلمى طَوعاً لِتَجعَلَني","ذِبحاً وَلَكِن أَطاعَني النُجُبُ",74,"ب",1,0],["ما جُلِبَ الخَيرُ إِلى","صاحِبِ عَقلٍ وَكَسَد",75,"د",1,1],["ما جُدَرِيٌّ أَماتَ صاحِبَهُ","مِن جُدَرِيٍّ أَتَت بِهِ جَدَرُ",76,"ر",1,1],["ما جاءَ مِنها وافِدٌ مُتَسَرِّعٌ","فَنَقولُ لِلنَّبإِ الجَديدِ بَدارِ",77,"ر",1,0],["ما جادَ مِن دَمِهِ المَصونِ بِقَطرَةٍ","وَأَجادَ وَصفَ دِمائِها بِجُبارِ",78,"ر",1,0],["ما جارَ شَمّاسُكَ في حُكمِهِ","وَلا يَهودِيُّكَ بِالطامِعِ",79,"ع",1,0],["ماجَتْ نُمَيرٌ فهاجَتْ منكَ ذا لِبَدٍ","واللّيْثُ أفْتَكُ أفعالاً من النّمِرِ",80,"ر",1,0],["ما جِئْتُ مِني أَبْغِي قرى كالضّيفِ","عندي بك شغلٌ عن نزولِ الخَيفِ",81,"ف",1,1],["ما جئتُ إلا لِلْبَنِيَّةِ زائراً","أَقضِي لربِّي حقَّها وأُعَظّمُ",82,"م",1,0],["ما جزاءُ الذين قد كفروا إل","لا عذابٌ برحٌ وإلا سعير",83,"ر",1,0],["ما جاز أن يهضم الإنسان أخوته","وأن يجرب في الإذلال قدرته",84,"ه",1,0],["ما جاءَ وصف وَليٍّ في مصاحبة","إلا وَفضل وليٍّ فوق ما وصفوا",85,"ف",3,0],["ما جئت أَستَبِق الحَياة مُسارِعاً","لَو كانَ لي قبل المَجيء خيار",86,"ر",1,0],["ماجاءَ الأمر كَما أَرجو","ه وقد تدري ما أَقصده",87,"د",2,0],["ما جاءَ يفسده الجنو","ب تعيده أَيدي الشمال",88,"ل",1,0],["ماجت خمائلَ بالبشرى وأوديةً","فهن فاكهةٌ تَندى وصهباءُ",89,"ا",2,0],["ما جِئتُ بابَكَ مادِحاً بَل داعِياً","وَمِنَ المَديحِ تَضَرُّعٌ وَدُعاءُ",90,"ا",2,0],["مَا جَهِلَتْ خَيْلُ العِدَى فيْصَلاً","وَالطَّعْنُ فِي لَبَّاتِهَا هَبْرُ",91,"ر",1,0],["مَا جُهْدُ نَظْمِي أَوْ وَفَاءُ نَثْرِي","بِمَدْحِ يُوسُفَ السَّنِيِّ الْقَدْرِ",92,"ر",1,0],["مَا جُنْدُ قَيْصَرَ أَوْ كِسْرَى إِذا افْتَخَروا","كَهَؤُلاء الأَعِزَّاءِ الْمَطَارِيدِ",93,"د",1,0],["مَا جَاهُنَا فِي النَّاسِ مَا عُنْوانُنَا","أَأُولئِكَ المُتَشرِّدُون الظلَّعُ",94,"ع",1,0],["مَا جَالَ إِلاَّ جوْلتَيْ","أَسَدٍ يُبَرْبِرُ وَهْوَ زائِرْ",95,"ر",1,0],["ما جئتها إلا هداك معلّمٌ","فوق المنابر أو شجاك متيّمُ",96,"م",1,0],["ما جَرَّدَ الدَّهْرُ سَيْفاً مِثْلَ«سَيْفِهِمِ»‏‏","يُجْري بِهِ الدَّمَ أَوْ يُجْري بِهِ الذَّهَبا‏‏‏",97,"ب",2,0],["ما جَالَ في الآفاقِ أصْدقُ جَوْهراً","مِنْه وأَصْفَى مِنْ نَقي صَفائِه",98,"ا",3,0],["ما جرَّدَ الخَصْمُ غيرَ الحقِّ في يده","والحقُّ يمضي، وينبو الصارم الذَّكر",99,"ر",1,0],["ما جمالٌ في الأرض إلا أمانٍ","لبني العُرْب صُوِّرَتْ إنسانا",100,"ن",2,0],["ما جَنَيْنا من الخلافِ ورودا","بل جنينا القَتَادِ والسَّعْدَانا",100,"ن",2,0],["ما جزعنا تحت العجاجة إذ ول","وا شلالاً وإذ تلظى الصلاء",101,"ا",2,0],["مأجورةٍ لم تَقُمْ يوماً ولا قعَدَتْ","إلاَّ على هَتْكِ أعراضٍ وأستار",102,"ر",1,0],["ماج الفراتُ فلم يُطِق","صبراً عليه سدّه",103,"د",2,0],["ما جال في جَلبَات طِرسِكَ سابقاً","الا وجاءَ من النَدى برديفه",104,"ف",2,0],["مَا جَعفرُ بنُ محمَّدٍ بنِ الأَشعَثِ","عندي بخيرٍ أبوة من عثعثِ",105,"ث",1,1],["ما جرم من هام بذي لوعة","شبيهة سمش الضحى الأكبر",106,"ر",1,0],["ماجتِ الدنيا بمن فيها ، كما","ماج نهرٌ ثائرٌ مُنكدرٌ",107,"ر",1,0],["ما جاورتْ نبطي الزل نبعته","بل جاورت .. النبع والبشم",108,"م",1,0]]}