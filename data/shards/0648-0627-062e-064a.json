{"poems":[[0,"حي الحمول بجانب العزل","https://www.aldiwan.net/poem82.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[16,"وأخي محافظة طليق وجهه","https://www.aldiwan.net/poem27689.html","الكامل"],[72,"سيدي يومك هذا","https://www.aldiwan.net/poem42727.html","مجزوء الرمل"],[87,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[68,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[82,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[33,"هاج ذا القلب منزل","https://www.aldiwan.net/poem41864.html","مجزوء الخفيف"],[54,"لمن دار وربع قد تعفى","https://www.aldiwan.net/poem27164.html","الوافر"],[50,"وأخي حفاظ ماجد","https://www.aldiwan.net/poem62521.html","مجزوء الكامل"],[52,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[52,"من لم يردك فلا ترده","https://www.aldiwan.net/poem63840.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24726","الكامل"],[52,"فمن لم يردك فلا تُرِدْه","https://www.poetsgate.com/ViewPoem.aspx?id=22620",""],[132,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[228,"وترامى الصباح فوق الهضاب","https://www.aldiwan.net/poem41603.html","الخفيف"],[287,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[347,"كسف هذي تراها ام ليالي","https://www.aldiwan.net/poem55324.html","الرمل"],[366,"يا ابن الرسول بامك الزهرا البتول","https://www.aldiwan.net/poem68097.html","الكامل"],[376,"كتبت جفونك فوق خدك أسطرا","https://www.aldiwan.net/poem57467.html","الكامل"],[376,"قالوا أقم في صور عن","https://www.aldiwan.net/poem57469.html","مجزوء الكامل"],[385,"دعك من نهي النهاة","https://www.aldiwan.net/poem48799.html","مجزوء الرمل"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[408,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[453,"قد أسمع القلب داعي الحب حين دعا","https://www.aldiwan.net/poem53812.html","البسيط"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[458,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[473,"وأخ يجرر فضل ذيل إخائي","https://www.aldiwan.net/poem60495.html","الكامل"],[484,"صفر تجلى مسفرا","https://www.aldiwan.net/poem37052.html","مجزوء الكامل"],[543,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[554,"رب هامة تبكي عليك كريمة","https://www.aldiwan.net/poem448.html",""],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145907","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97047","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64042","الخفيف"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138819",""],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126622","الخفيف"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93125","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79864","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79794","الخفيف"],[2035,"","https://poetry.dctabudhabi.ae/diwan/poem/198280","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96041","الكامل"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18691","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110646","الكامل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111149","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102555","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201014","السريع"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130128","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82808","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108328",""],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35066","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59456","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103048","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103028","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111399","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3986,"","https://poetry.dctabudhabi.ae/diwan/poem/20931","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123502","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90864","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[4684,"خيبة","https://www.poetsgate.com/ViewPoem.aspx?id=201488",""],[4690,"زمانُ الوَصْل","https://www.poetsgate.com/ViewPoem.aspx?id=120304",""],[4702,"قماش الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=155162",""],[4755,"لِصَمتِكِ وهْو يَقرَؤُنِي استِماعا","https://www.poetsgate.com/ViewPoem.aspx?id=197893",""],[4935,"يا رب فرج كربتي بمحمد","https://www.poetsgate.com/ViewPoem.aspx?id=129295",""],[5061,"النصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=155783",""],[5136,"وأخ يأكل لحمي ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=121522",""],[5155,"يا دنيا ..!","https://www.poetsgate.com/ViewPoem.aspx?id=176238",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5200,"يا سميى ان دعيت ومن","https://www.poetsgate.com/ViewPoem.aspx?id=200791",""],[5232,"أمنيات شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=211670",""],[5324,"وجع فلسطيني.","https://www.poetsgate.com/ViewPoem.aspx?id=211245",""],[5434,"ذباحة التيس","https://www.poetsgate.com/ViewPoem.aspx?id=37625",""],[470,"سلامٌ على بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=178093",""],[5586,"جلل ألم على الكرام فهالا","https://www.poetsgate.com/ViewPoem.aspx?id=173782",""],[5691,"لسان حال الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=207076",""],[5770,"نحن سبعة","https://www.poetsgate.com/ViewPoem.aspx?id=178734",""],[5956,"قصة‎ ‎اللص والبَصَل","https://www.poetsgate.com/ViewPoem.aspx?id=184623",""],[5956,"عجوزٌ يصف لي جانباً من حياته مع زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=214990",""],[5309,"غرها الحسن فيا بؤس المصير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573871",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["وَأَخي إِخاءٍ ذي مُحافَظَةٍ","سَهلَ الخَليقَةِ ماجِدِ الأَصلِ",0,"ل",1,0],["وَأَخي مِنَ الجِنِّ البَصيرُ إِذا","حاكَ الكَلامَ بِأَحسَنَ الحَبرِ",1,"ر",1,0],["وَأَخي مُحافَظَةٍ طَليقٍ وَجهُهُ","هَشٍ جَرَرتُ لَهُ الشِواءَ بمِسعَرِ",2,"ر",1,1],["وَأَخٌ يُرضيكَ مِنهُ","فَضلُهُ الجَمُّ وَفَهمُه",3,"م",2,0],["وأخي القري وإن شقيت بظلمه","أدنى إلىّ من الغريب العادي",4,"د",2,0],["وَأَخي ثَمانينَ اِستُبيحَ وَقارُهُ","لَم يُغنِ عَنهُ الضَعفُ وَالأَعوامُ",5,"م",1,0],["وَأَخيكَ في يَومِ الغَديرِ وَقَد بَدا","نورُ الهُدى وَتَآخَتِ الأَقرانُ",6,"ن",1,0],["وأخي وَفْضَةٍ كأمٍّ ولودٍ","ما أصابتكَ من بنات القسيِّ",7,"ي",1,0],["وَأَخيذٍ رَأى المَنِيَّةَ حَتّى","قالَ بِالصِدقِ وَهوَ غَيرُ صَدوقِ",8,"ق",1,0],["وَأَخٌ يَستَحِثُّني","وَيُنادي وَيَبذُلُ",9,"ل",1,0],["وَآخى النارَ وَالنيرانَ مَوتى","مُشَهَّرَةٌ تُبَشِّرُ بِالنَجاحِ",10,"ح",1,0],["وَأَخي حِفاظٍ ماجِدٍ","حُلوِ الشَمائِلِ غَيرِ لاحِ",11,"ح",1,1],["وَأَخٍ يَلحى وَلا أَعبا بِهِ","حَلَبَ اليَومَ لَها وُدّي فَدَر",12,"ر",1,0],["وَأَخي مَناسِبَةٍ يَسو","ؤُكَ غِبُّهُ إِن لَم تَفِده",13,"د",2,0],["وأخيراً في جوفها قذفا بي","مثلما يقذفُ المتاعُ الحقير",14,"ر",1,0],["وأخي انكسار رحت ترأب صدعه","فعدى عليك مع الزمان العادي",15,"د",2,0],["وأخي كبعض الغَرس كنتَ تَرُبّه","حتى تخوَّن يُبسه عيدانَهُ",16,"ن",2,0],["وأخي مناسبة ٍ يسو","ءك غبه إن لم تفده",17,"د",2,0],["وأخِي الموائدِ والفوا","ئِد والمروءَاتِ الجِسَامِ",18,"م",1,0],["وَأَخيراً مَضوا إِلى القَبرِ حَتّى","يَطمَئِنّوا لِلمَشهَدِ العُجّابِ",19,"ب",1,0],["وا خَيبَتي حَزِنَ الوَلِي","يُ بِما بِهِ سُرَّ الحَسودُ",20,"د",1,0],["واخيراً قد رزئنا بعلي","المليك المرتجى سامي الفعال",21,"ل",1,0],["وَأَخيه حمزة ثُم كُل الصحب وَال","آل الكِرام السادة الاكياس",22,"س",1,0],["وأخي اقتدارٍ بالنوى لولا الهَوى","والشوقُ كنتُ بها عَليه أقدَرا",23,"ر",2,0],["وأخي أبو الحدثانِ أو","وَلُ كلِّ نائبةٍ وشدَّة",24,"د",2,0],["وَأَخي وَجد بِغَني","ك شَجيَّ النَغَمات",25,"ت",1,0],["وَأَخي المُصطَفى وَمَن","حَسَدَ الفَخرُ مَفخَرَه",26,"ر",2,0],["وَأَخيهِ خَيرِ نَفسٍ","شَرَّفَ اللَهُ بناها",27,"ا",3,0],["وأخي غدَتْ تَسْعى لَهُ مِن نَكْثكمْ","حيّاتُ غَدْرٍ سُمّهنَ زُعَاقُ",28,"ق",1,0],["وأخي قال له خير الورى","وهو أمر ظاهر ليس خفياً",29,"ي",2,0],["واخيبة الطرف لا يغفى وليس يرى","جمال أشخاصكم الا اذا هجعا",30,"ع",2,0],["وأخيراً من بعد لأىٍ مديدٍ","وعدوه بأنه سيلبَّى",31,"ب",2,0],["وأخيراً بعد لأىٍ قال بل","سوف تغدونَ أمامي كالشِّواء",32,"ا",2,0],["وَأَخٍ يُجَرِّرُ فَضلَ ذَيلِ إِخائي","ما بَينَ إِنصافي وَبَينَ وَفائي",33,"ا",3,1],["وأخي أبوها الخزندا","ري ناطق بالبينات",34,"ت",1,0],["وأخٍ يبكِي أخَاه","حالةٌ تُبكِي الجَمَاد",35,"د",1,0],["وَأَخٍ يُوازِنُ ما جَنَيتُ بِقُوَّةٍ","وَإِذا غَوَيتُ الغَيَّ لا يَلحاني",36,"ي",1,0],["وأخي حروب صده رشق القنا","عما قدود مثلهن رقاق",37,"ق",1,0],["وأخيبة المشتاق عن كان الذي","أخفيته مثل الذي أبديته",38,"ت",2,0],["وأخي مدركٌ فنفسي التي أح","نو عليها وأَنحني وأرفرف",39,"ف",1,0],["وأخي المساجد والمدارس","والمحابر والمنابر",40,"ر",1,0],["وأخي لوعةٍ لقيت فما زا","ل بماء الجفون يبكي الجفنا",41,"ن",2,0],["وأخي العباس مقطوع الوتين","قطعوا من بعد يمناه الشمال",42,"ل",1,0],["وأخيه مصطفى الفخرِ الذي","لم تزل طلعتُه تجلو الهموما",43,"م",2,0],["وأخي الشمس طلعةً تُبهِت الشم","سَ إذا وجههُ استهلَّ منيرا",44,"ر",2,0],["وأخي الغيثِ راحةً تخج","ل الغيثَ ولو ساجلته نوءً غزيرا",44,"ر",2,0],["وأخ يجيب المستضاف إذا دعا","والخيل تعثر في الغبار رزيت",45,"ت",1,0],["وأخي ندى ان سال فيض بنانه","غمر الزمان مغاوراً ونجادا",46,"د",2,0],["وَأَخي مُحافِطَة عَصى عَذّالَهُ","وَأَطاعَ لِذَّتَهُ مُعَمٍّ مخوَلِ",47,"ل",1,0],["وأخي المحامد في الأنام محمد","من فيه قام من العلوم دعامها",48,"م",3,0],["واخي فكرة إذا سد باب","الحق بالريب تفتح المسدودا",49,"د",2,0],["وأخي الذي صدق الإخا أوليته","وخصصته مني بصدق تودّدي",50,"د",2,0],["واخيبتي ادعوكُم للعلا","وما بكم غير وضيع دني",51,"ي",1,1],["وآخيت بعدي واِطّرحت أُخوَّتي","كأنّي بلا علمٍ جَنيت جِناية",52,"ه",1,0],["وَأَخي كُربَة أَرادَ اِنفِراجاً","بدّل اللَهُ عسره بعدُ يُسرا",53,"ر",2,0],["وأخيُّ ميثاقٍ فمن ناط الرجا","فيه تعلق في متين حبال",54,"ل",1,0],["وَأَخيكَ أَبرَهَةَ الهِجانِ أَخي ال","حرابِ العَوانِ وَموقدِ الجَمرِ",55,"ر",1,0],["وأخي الذي خضعت له أُسدُ الشرى","وَعنت إليه شراسةً وكفاحا",56,"ح",2,0],["وأخيه الفتى حذيفة لا ير","هج قولا ولا يرنق فعلا",57,"ل",2,0],["واخيبة الرواد من روض سرت","نسمات روح القدس من نسرينه",58,"ن",2,0],["وأخيلٌ فطرقل يبكي وفيلا","لبثا ينحبان ثمة حتى",59,"ت",2,0],["وأخيلٌ ألقاه خلف الدار","فوق نعشٍ وذان باستعجال",59,"ل",1,0],["وآخيلٌ بعزته إلى","الأجناد أو ما أن",60,"ن",1,0],["وآخيل انبرى متضر","رماً غيظاً بعزمته",60,"ه",1,0],["وآخيلٌ مذ انتزعا","جيمع سلاحه هرعا",60,"ع",2,0],["وأخيل إن ردا وإن ردعا","فناك بأس أكفنا صدعا",61,"ع",2,0],["وأخيل صاح تروع هدته","وبعزمه بين العدى اندفعا",61,"ع",2,0],["وأخيل ذيمول بن انطنر","ذا الباس أورده منيته",61,"ه",1,0],["وأخيل للشرف الرفيع وللعز","ز المنيع به المرام حدا",61,"د",2,0],["وأخيلَ صافِ وراعنِي فلقد غدا","في ذا الوَغى حُبصنَ الأخَائِيينا",62,"ن",2,0],["وآخيل لن يغتاله متعسفاً","ويحميه ممن رامه يتعسف",63,"ف",1,0],["وآخيل ألقاه من قدمه","إلى ال