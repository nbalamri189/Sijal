3,"وَلَقَدْ عَلِمْتُ لَتَعْدُوَنّ","https://www.poetsgate.com/ViewPoem.aspx?id=180801",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"رُدّي، على المُشتاقِ، بَعضَ رُقادِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31610",""],[64,"التلبية","https://www.poetsgate.com/ViewPoem.aspx?id=3094",""],[88,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["يا كاشِفَ الكَربِ المُلِم","مِ وَكافِيَ الداءِ العُقامِ",0,"م",1,0],["يا كاشِفَ الأَمحالِ كَيفَ رَضيتَهُ","لِمَقيلِ جَنبِكَ مَنزِلاً مِمحالا",1,"ل",2,0],["يا كَوكَبَ الأَحسابِ أَع","جَلَكَ الدُجى عَنّا أُفولا",2,"ل",2,0],["يا كَمالَ العُلى وَيا وَزَرَ المُل","كِ إِذا لَم يَجِد مَعاناً وَداراً",3,"ر",2,0],["يا كَبِدي تَجَلُّداً","فَما أُطيقُ الجَلَدا",4,"د",2,0],["يا كَثيرَ الأَلوانِ ما أَجفاكا","لِمُحِبٍّ مُعَذَّبٍ في هَواكا",5,"ك",2,1],["يا كِتابي اِقرَإِ السَلامَ عَلى مَن","لا أُسَمّي وَقُل لَهُ يا كِتابي",6,"ب",2,0],["يا كوْكَبَ الهُدَى الذي منْ بعْدِه","ركَدَ الظّلامُ بهذِهِ الآفاقِ",7,"ق",1,0],["يا كافِلَ الأيْتامِ يُدْفَعُ عنْهُمُ","بِنَداهُ جوْرُ الدّهْرِ أو أضْرارُهُ",8,"ر",2,0],["يا كَمِدَ اللّوْنِ ينْطَفي كمَدا","منْ حسَدٍ يسْتَطيرُ بالشّرَرِ",9,"ر",1,0],["يا كوْكَبَ الحُسْنِ يا مَعْناهُ يا قَمَرَهْ","يا روْضَةَ المُتناهي الرّيْعِ يا ثَمَرَهْ",10,"ه",1,1],["يا كَعْبَةَ الحُسْنِ الذي قَلْبي لهُ","مرْمى الجِمارِ وأضْلُعي أسْتارُهُ",11,"ر",2,0],["يا كِتابي إذا بَلَغْتَ مَحَلاًّ","فيهِ غَيْثُ النّدى وغَوْثُ الرّاجي",12,"ي",1,1],["يَا كَوْكَبَ النَّحْسِ مِنْ قُرْبٍ عَلَى الْحِقَبِ","تِلْكَ الذُّنَابَى أَتَتْ بِالْحَرْبِ وَالْخَرَبِ",13,"ب",1,1],["يا كَبيرَ الفُؤادِ وَالنَفسِ وَالآ","مالِ أَينَ اِعتَزَمتَ عَنّا الذَهابا",14,"ب",2,0],["يا كَريماً حَلَلتَ ساحَ كَريمٍ","وَضَعيفاً حَلَلتَ ساحَ القَوِيِّ",15,"ي",1,0],["يا كاتِبَ الشَرقِ وَيا خَيرَ مَن","تَتلو بَنو الشَرقِ مَقاماتِهِ",16,"ه",1,1],["يا كَوكَبَ الشَرقِ أَشرِق","فَالحادِثاتُ تَجِدُّ",17,"د",1,1],["يا كاسِيَ الخُلُقِ الرَضِيِّ وَصاحِبَ ال","أَدَبِ السَرِيِّ وَيا فَتى الفِتيانِ",18,"ن",1,1],["يا كاسِيَ الأَخلاقِ في","بَلَدٍ عَنِ الأَخلاقِ عاري",19,"ي",1,1],["يا كَرمَةَ المَطَرِيَّةِ اِبتَهِجي بِهِ","وَاِستَقبِلي الظَمآنَ مِن أَخدانِهِ",20,"ن",2,0],["يا كَعبَةَ الفَضلِ الَّذي نادَيتُهُ","بِالحَجِّ أَقدِمني إِلَيها مُحرِما",21,"م",2,0],["يا كَوكَباً بارى سَناهُ سَناءَهُ","تُزهى القُصورُ بِهِ عَلى الأَفلاكِ",22,"ك",1,0],["يَا كَائِلاً فِي غَيْرِ كَيْلٍ لَمْ يُصِبْ","مِمَّا يُرَجِّي غَيْرَ خَيْبَةِ قَصْدِهِ",23,"د",2,0],["يأكلون الُباب من كدِّ قوم","أعوزتهم سخينة من نُخاله",24,"ل",2,0],["يا كوكباً عجل الردى بافوله","من بعد ما ملأ السماء شروقا",25,"ق",2,0],["يا كَعبُ قَد مَلَأَ القُبورَ مَهابَةً","مَلِكٌ تَقَطَّعُ دونَهُ الأَبصارُ",26,"ر",1,0],["يا كلب مالك أم في بني أسد","معروفة فاحترق يا كلب في النارِ",27,"ر",1,1],["ياكَثيباً مِن تَحتِ غُصنٍ رَطيبٍ","يَتَثَنّى مِن تَحتِ بَدرٍ مُنيرِ",28,"ر",1,0],["يا كاتباً تبَّ مسعى من يناضلهُ","فراحَ يحملُ من أقلامِهِ حطبا",29,"ب",2,0],["يا كافِلَ الحسبة التي شهدت","بأنَّها فوقَ قدرِها رُتبه",30,"ب",2,0],["يا كاتبَ الملكِ تهنأ به","هلالَ عيدٍ سعدَه واجب",31,"ب",1,1],["يا كاتباً خلت أقلاماً بمهرقه","عقائلاً رقمت طرزاً على لاذ",32,"ذ",1,0],["يا كعبة الحسن الممنع لا يكن","بيني وبينك للجفاء حجاز",33,"ز",1,1],["يا كاتمَ الجدوى وتلك شهيرة","كالمسكِ إن تكتم نوافحه فشى",34,"ش",2,0],["يا كاتب الخاصّ ويا شاعراً","أصبحَ بالآدابِ يختال",35,"ل",1,1],["يا كاسراً بالرأي جيش العدى","تكسير ماضي الفعل مجزوم",36,"م",1,0],["يا كريماً قد طابق الإسم بالفع","ل وأنسى في الفضل كل قديم",37,"م",1,1],["يا كريم الأب والصه","ر نسا في حرمين",38,"ن",1,1],["يا كريماً يخفي أياديهِ لو كا","نَ شذا المسك والصباح خفيّا",39,"ي",2,0],["يا كُلَّ كُلّي فَكُن لي","إِن لَم تَكُن لي فَمَن لي",40,"ل",2,0],["يا كُلَّ كُلّي وَأَهلي","عِندَ اِنقِطاعي وَذُلّي",40,"ل",2,0],["يا كُلَّ كُلّي وَيا سَمعي وَيا بَصَري","يا جُملَتي وَتَباعيضي وَأَجزائي",41,"ا",3,0],["يا كُلَّ كُلّي وَكُلُّ الكُلِّ مُلتَبِسٌ","وَكُلُّ كُلِّكَ مَلبوسٌ بِمَعنائي",41,"ا",3,0],["يا كعبةً لِلنَّيْك منصوبةً","لكنها ليست بمحجوجَهْ",42,"ج",2,0],["يا كائناً بين أوعاثٍ وأوعارِ","من صَرْف دهرٍ على أبنائه ضاري",43,"ر",2,1],["يأكلها تارة ويُؤكِلها","طوراً وكيلاً بأغلظ الأجر",44,"ر",1,0],["يا كوكبَ الدهر قِدْماً في غياهبه","يا مَعْلمَ الدهر قدْماً في مَجاهلِهِ",45,"ل",2,0],["يأكلون الآكالَ دوني وليسوا","لشكر المُؤثِرين بالأُكَّالِ",46,"ل",1,0],["يا كثيباً عليهِ غصنٌ من البا","نِ وفرعٌ يمجُّ مِسْكاً وبانا",47,"ن",2,0],["يا كريماً لم يزل محتمِلاً","محناً في عبده بعدَ مِحَنْ",48,"ن",1,1],["يا كَعبُ لا تَهجُوَنّا العامَ مُعتَرِضاً","فَإِنَّ شِعرَكَ إِن لاقَيتَني غَرَرُ",49,"ر",1,1],["يا كَلبُ أَن لَم تَكُن فيكُم مُحافَظَةٌ","ما في قُضاعَةَ مَنجاةٌ وَلا خَطَرُ",50,"ر",1,0],["يا كِتابَ الدَهرِ قُل لي أَلَهُ قَبل وَبَعدُ","أَنا كَالزَورَقِ فيه وَهوَ بَحرٌ لا يُحَدُّ",51,"د",1,0],["يا كاشِفَ الضُرِّ عَمَّن طالَ صَبرُهُمُ","عَلى النَوائِبِ لا مَرَّت بِكَ العِلَلُ",52,"ل",1,0],["يا كِتاباً مِن حَبيبٍ","أَنا مُشتاقٌ إِلَيهِ",53,"ي",2,1],["يا كَثيرَ الجَميلِ مِثلُكَ مَولىً","يَشتَريني جَميلُهُ وَيَبيعُ",54,"ع",1,0],["يا كَثيرَ الصُدودِ وَالإِعراضِ","أَنا راضٍ بِما بِهِ أَنتَ راضِ",55,"ض",1,1],["يا كَليلَ الطَرفِ إِلاّ","في فُؤادي ما أَحَدَّه",56,"د",2,0],["يا كاهِنَ الأَحزانِ والآلامِ","فاخلعْ مُسُوحَ الحزنِ تَحْتَ ظِلالِهِ",57,"ه",1,0],["يا كَوكَبَ الحُسنِ الَّذي","أَزرى بِزُهر الشهُبْ",58,"ب",1,0],["يا كَريمَ المَحَلِّ في كُلِّ معنى","وَالكَريمُ المحلُّ لَيسَ يُعَنّى",59,"ن",2,1],["يا كوكبا قد كان يمحو نوره","صدأ الدجى أحسن به من ماح",60,"ح",1,0],["يا كتاب الملوك انت كتاب","فيه للناس حكمة وصواب",61,"ب",1,0],["يا كوكب الصبح لك","الصبح من الاقارب",62,"ب",1,0],["يا كوكب الصبح قل لي اين انت وقل","لي اين ما كان يذكو فيك من ضرم",63,"م",1,0],["يأكلون الطعام اكلا ذريعا","ثم يشكون بطنة وزحيرا",64,"ر",2,0],["يا كعبة العلم في الإسلام من قدم","لا يزعجنّك إعصار الأباطيل",65,"ل",1,1],["يا كافى البيت لا تجزع لحادثة","وثق بنفسك إن الله كافيها",66,"ي",3,0],["يا كريم العهد يا ابن الأكرمين","كل عيد لك عيد للبنين",67,"ن",1,1],["يا كافِيَ الناسِ بَعدَ اللَهِ أَمرَهُمُ","النَصرُ إِلّا عَلى أَيديكَ خِذلانُ",68,"ن",1,0],["يا كابِراً مِن كابِرينَ وَطاهِراً","مِن آلِ طُهرٍ عارِفٍ بِاللَهِ",69,"ه",1,0],["يا كَثيرَ الصَيدِ لِلصَيدِ العُلا","قُم تَأَمَّل كَيفَ صادَتكَ المَنون",70,"ن",1,0],["يا كثيرَ الدَّلِ والغَنَجِ","لَكَ سُلْطانٌ على المُهَجِ",71,"ج",1,1],["يا كُلَّ مَنْيٍ وكُلَّ طالِعَةٍ","نَحْسٍ ويا كُلَّ سَاعةٍ عَسِرَهْ",72,"ر",2,0],["يا كالِئَ الإِسلامَ في غَفَلاتِهِ","وَمُقيمَ نَهجى حَجِّهِ وَجِهادِهِ",73,"د",2,0],["ياكَثيرَ المِطالِ كَم وَإِلى كَم","أَتَقاضاكَ مَوعِداً لَيسَ يُقضى",74,"ض",2,0],["يا كاهِلَ المَجدِ الَّذي بِفَعالِهِ","أَرسى قَواعِدَ طَودِهِ رُكناهُ",75,"ا",2,0],["يا كَذِبَ القُربِ المُفيدِ نِعمةً","منها ويا صِدْقَ البُعادِ المُنتَقِمُ",76,"م",1,0],["يا كَثيرَ الكُنوزِ إِنَّ الَّذي يَك","فيكَ مِمّا أَكثَرتَ مِنها لَدونُ",77,"ن",1,0],["يا كُربَتي يَومَ لا جارٌ يَبَرُّ وَلا","مَولى يُنَفِّسُ إِلّا اللَهُ كُربَتِيَه",78,"ت",3,0],["يَأكُلُ وَالغِلمانَ في يَومِهِ","فَضلَةَ ما قَد كانَ بِالأَمسِ",79,"س",1,0],["يا كَريماً طابَ أَصلاً وَفَرعاً","وَسَما أُمّاً وَعَمّاً وَخالا",80,"ل",2,0],["يا كم شدوتُ بلحني","ما بين حزني ودمعي",81,"ي",1,0],["يا كيْفَ أكْتُمُ حبّ فاتكةٍ","يبديه إسراري وإعلاني",82,"ن",2,0],["يأكلها وهيَ غذاءٌ له","منها لسانٌ وهوَ في غَيرِ فم",83,"م",1,0],["يا كيفَ بات عليّ قلبُكِ جامداً","يَقْسو فليْسَ يُلينُهُ استعطافُ",84,"ف",1,0],["يا كَعبُ بَذلاً لِلعَطايا وَيا","أَصفَقَ وَجهاً مِن أَبي شاسِ",85,"س",1,0],["يا كاملَ الخلقةِ معْ فقدِهِ","لأصبعيهِ ما بذا ذامُ",86,"م",1,1],["يا كاملَ الفضلِ جمَّ البذلِ وافرَه","جوداً مديدَ القوافي غيرَ مقتضبِ",87,"ب",1,0],["يا كعب مالك تؤذيه وتنكره","وما الولوع بقول الزور والشغف",88,"ف",1,0],["يا كَعبَةً لِلمَجدِ طافَ مُحَلِّقاً","مَجدُ السَماكِ بِها فَعادَ مُقَصِّرا",89,"ر",2,0],["يَأكُلنَ أَوصالاً وَلَحماً","كَالشُكاعى غَيرَ جادِل",90,"ل",1,0],["يا كَفُّ ما حَيِّتِ إِذ غَدَوتِ","بِباشِقٍ يُعطيكِ ما اِبتَغَيتِ",91,"ت",1,1],["يا كاتِباً كَتَبَ الغَداةَ يَسُبُّني","مَن ذا يُطيقُ بَراعَةَ الكُتّابِ",92,"ب",1,1],["يا كِتاباً بِطَلاقٍ","يا عَزاءً بِمُصابَه",93,"ب",2,0