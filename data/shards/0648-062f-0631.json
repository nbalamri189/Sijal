56032.html","عموديه"],[456,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[456,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[459,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[498,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[512,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[513,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[513,"أما وخدود ألفن الصدودا","https://www.aldiwan.net/poem12070.html","المتقارب"],[527,"لعمري أنت بعض الترهات","https://www.aldiwan.net/poem37499.html","الوافر"],[536,"وجمرة الوجنة ذاب","https://www.aldiwan.net/poem47912.html","عموديه"],[549,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[549,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[549,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[560,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[560,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"]],"verses":[["وَدَرَّت عَلَيكَ ثُدِيُّ الغَمامِ","كَأَنَّ رُباكَ سِقابُ الدِيَم",0,"م",1,0],["ودَرَّتْ علَيْنا راحَةٌ خَلَصَتْ بِها","إلينا اليدُ البيْضاءُ والعِيشةُ الرَّغْدُ",1,"د",1,0],["وَدُرنا كَما دارَت عَلى قَطبِها الرُحى","وَدارَت عَلى هامِ الرِجالِ الصَفائِحُ",2,"ح",1,0],["وَدَراري النُجومِ غارَت وَغابَت","وَضِياءُ الآفاقِ صارَ قَتاما",3,"م",2,0],["وَدُرتَ بِأَعداءٍ حَبيبُكَ فيهُمُ","كَما قَد تَراني بِالعَدوِّ أَدورُ",4,"ر",1,0],["وَدُرتَ بِأَعداءٍ حَبيبُكَ فيهِمُ","كَما قَد تَراني بِالحَبيبُ أَدورُ",5,"ر",1,0],["ودُرَّ ثَناءٍ منْ عُلاكَ انْتَخبْتُهُ","ومنْ عجَبٍ يُهْدى الى البحْرِ دُرُّهُ",6,"ر",2,0],["ودُرْتُ على مرْكَزي دوْرَةً","يُحَقِّرُ مَنْ دارَها مُلْكَ دَارا",7,"ر",2,0],["ودُرّةِ نَوْرٍ في غِلافِ زَبَرْجَدٍ","كما لاحَ في الخَضْراءِ لألاءُ فَرقَدِ",8,"د",1,1],["وَدُروعٌ مِن نَسجِ داوُودَ في الحَر","بِ وَسوقٌ يُحمَلنَ فَوقَ الجِمالِ",9,"ل",1,0],["وَدَرى الشَرقُ كَيفَ يَستَمرِئُ اللَه","وَ فَيُفضي بِهِ إِلى شَرِّ حالِ",10,"ل",1,0],["ودرت ذات أيدينا وكانت","كحلب النوق أيام الغراز",11,"ز",1,0],["وَدُرتَ عَلى عاسي العُروقِ وَلَم يَكُن","لِيَسقِيَ أَفواهَ العُروقِ دُرورُها",12,"ر",3,0],["ودَرى المدح عجزه عنه لكن","خاف عنه الكتمان من آثامه",13,"م",2,0],["ودرّ بكائي حين يبسم ثغرها","لقد لاح فرقٌ بين نثري ونظمها",14,"م",3,0],["ودرى سرها الرهيب علي","فاشتهى لو يكون كبش الفداء",15,"ا",2,0],["ودرَّ لي درُّ الكلامِ وحَشَكْ","وأوجف السير بشعرِي ورتكْ",16,"ك",1,0],["ودرعٍ إذا أنا أسلمتُها","وقتْني وإن أحمها أُكلمِ",17,"م",1,1],["ودرَّت حماليقُهُ والتوى","كما يلتوي حين يُثنى الهَرِسْ",18,"س",1,0],["وَدُرٌّ وَلَكِن بَينَ جنبيكَ بَحرهُ","وَزَهرٌ وَلَكِن الفُؤادَ كِمامُ",19,"م",1,0],["وَدُروسٍ لَم يُذَلِّل قَطفَها","عالِمٌ إِن نَطَقَ الدَرسَ سَحَر",20,"ر",1,0],["وَدَرى مَن أَعَزَّهُ الدَفعُ عَنهُ","فيهِما أَنَّهُ الحَقيرُ الذَليلُ",21,"ل",1,0],["ودَرَّتِ الجُودَ وَعْداً صادقاً يَدُه","وكان ظَنّاً على الأيامِ مَكذوبا",22,"ب",2,0],["وَدَرَوا بِأَنَّهُم بِذَلِكَ أَخطَأوا","فَأَتاكَ كُلٌّ تائِباً يَستَغفِرُ",23,"ر",1,0],["وَدَرى بِأَنَّ نِظامَ شِعري جَوهَرٌ","وَسِواهُ نَحرٌ لا يَليقُ بِعِقدِهِ",24,"د",2,0],["وَدُروعٌ قد ضوعِفَ النسيجُ منها","وَتَناهَى في سَردِها التقديرُ",25,"ر",1,0],["وَدُرّاً وَياقوتاً أَرَغنَ اِلتِقاطَهُ","تَداعَت بِهِ كَفُّ الصِبا فَتَبَدَّدا",26,"د",2,0],["ودَرَى أسامةُ فانثنَى في جيشهِ","والحزنُ طامٍ والدُّموعُ سَواجِمُ",27,"م",1,0],["وَدَرى أنَما السُّجودُ لغيرِ ال","لَهِ إثمٌ يَحيقُ بالسّاجدينا",28,"ن",2,0],["وَدُروعٌ كَأَنَّها شَمَطُ الجَع","دِ دَهيناً تَضَلُّ فيها المَداري",29,"ر",2,0],["وَدُروعاً كَأَنَّها وَجهُ ماءٍ","صافَحَتهُ ريحٌ وَعَضباً مِحَذّا",30,"ذ",2,0],["ودَرُّ القُصورِ البِيضِ يَعمُرُ مُلكَها","ملوكُ بني الدّنيا وهنّ الكَرائِمُ",31,"م",1,0],["وَدِرعُكَ إِن وَقَتكَ سِهامَ قَومٍ","فَما هِيَ مِن رَدى يَومٍ وِقاءُ",32,"ق",3,0],["وَدِرعُ حَديدٍ عِندَهُ دِرعُ كاعِبٍ","مِنَ الوُدِّ وَاِسمُ الحَربِ هِندٌ وَزَينَبُ",33,"ب",1,0],["وَدِرعُ الفَتى في حُكمِهِ دِرعُ غادَةٍ","وَأَبياتُ كِسرى مِن بُيوتِ العَناكِبِ",34,"ب",1,0],["ودُرّاً خِلْتِ أنْجُمَه عليه","فهلاّ خِلْتِهِنّ به ذُبالا",35,"ل",2,0],["ودروبٍ حولها ملتفّةٍ","كأفاعٍ سُمِّرتْ في منحناها",36,"ا",3,0],["ودرى أثالة ان عروة في الحمى","وبما بعروة من هوى وهوان",37,"ن",1,0],["ودُرَّةُ خِدْرٍ أَقْسَمَ الْخِدْرُ إنَّهُ","عَلَى مِثْلِهَا لَمْ تُلْقَ يَوْماً سَدَائلُهْ",38,"ل",2,0],["ودُرَّةٌ لم تَرَ الأصدافُ مُشْبههَا","بينَ الكُنوز الغَوالي من خباياها",39,"ا",3,0],["ودرِّع الشعبَ إن خطبٌ ألم به","درعًا من الخُلْق، لا درعًا من الزَّرَدِ",40,"د",1,0],["ودرِّسي نشأك تاريخَه","فان فيه المنهج الأصوبا",41,"ب",2,0],["ودريئةٍ يرمي الأبيَّ بها","وغدٌ ، ويُصمي البّرَةَ الفُجر",42,"ر",1,0],["ودُرْ بالفكر في خَلَدِ الليالي","وجُلْ في الكون رأياً مُستعادا",43,"د",2,0],["ودَرِّسوا نشْكم من شِعرِهم قِطَعاً","مُصوِّراتٍ لأفراحٍ وأحزان",44,"ن",1,0],["ودَرَجتُ اقتنصُ الشباب خَسِرتُه","ذا رِبحةٍ ورَبِحته خسرانا",45,"ن",2,0],["ودروعٌ قد ضوعف النسجُ منها","وتناهَى في سردها التقدير",46,"ر",1,0],["ودرعٍ إذا أنا أسملتُها","وقتْني وإن أحمها أُكلمِ",47,"م",1,1],["ودروا أنه حقيقة كل ال","أمر عند الإظهار والإضمار",48,"ر",1,0],["ودُرًّا ونَوراً ناضرا متفتقا","وحِقفاً وبَانَةً ميسةً وتثنيا",49,"ي",2,0],["وَدُر فِيهَا فَبِالدَّوَرَانِ فِيهَا","تَسَامَى لِلمُؤمِّل كُل حَيِّ",50,"ي",1,0],["وَدَراهِماً وَقَناطِراً وَمَوائِداً","وَأَرائِكاً وَوَلائِداً وَحُلاحِلا",51,"ل",2,0],["ودرت نفوسهم بأنك ظافرٌ","فأتت تقدم ما إليه تؤول",52,"ل",1,0],["وَدَرَّت لَهُ في كُلِّ أُفقٍ غَمامَةٌ","تَدُلُّ عَلى بُخلِ الغُيوثِ الهَوامِعِ",53,"ع",1,0],["وَدَرى هُنالِكَ مِن أَشَدُّ شَكيمَةً","عِندَ اللِقاءِ وَمِن أَلَدُّ خِصاما",54,"م",2,0],["ودرى بأنك لا يخاشنك امرؤ","إِلاّ لقى بك ما يسوء ويضهدُ",55,"د",1,0],["ودرهم الجور ممحوق يلم به","من الحوادث ما يمحو به أثراً",56,"ر",2,0],["ودرجة في لسع الزنابير تجتري","على لسع حيات هناك عظيمة",57,"ه",1,0],["وَدِرعٌ كَأنَّ البيضَ وَالقُضبَ وَالقَنا","إِذا صافَحتَها بُورَقٌ وَثُمامُ",58,"م",1,0],["وَدَرُّ بَلائِى مِن هَواكِ فإنَّهُ","لِعَلِى وَإِن غالَبتُهُ لَغَلُوبُ",59,"ب",1,0],["ودَرَّجْن بالقَصْرين رملا كأنه","غُصونُ جباهِ الروم وهْي عوابِس",60,"س",1,0],["ودَرَّجتْ ماءَه الصَّبا فحكى","ثوبَ حريرٍ مُدَمْقَسٍ أزرق",61,"ق",1,0],["وَدَروا أنّه نبيّ الجهادِ","وَلهُ كتبهُم منَ الأشهادِ",62,"د",1,0],["وَدَروهُ الليثَ الجريءَ فإن أُح","رِجَ زادَ الإقدام والإجتراءُ",63,"ا",2,0],["ودَرَتْ عيوني بعدها كيفَ البكا","ودرى بعيني بعدها التسهادُ",64,"د",1,0],["وَدَرى بَعلُها وَلَم يكُ يَدري","أَيّ خَمرٍ تَحول في الأَعراقِ",65,"ق",1,0],["وَدرى بِالتَقصير منه فَأَضحى","من حياءٍ بوَجنَةٍ حمراء",66,"ا",2,0],["ودرّت له في الجدب عجفاء حائلٌ","وبكل على نزل الفحول تمنع",67,"ع",1,0],["وَدَرَت قُرَيشٌ بِالحَديثِ فَأَظهَرَت","ما عِندَها مِن مُضمَرِ الأَضعانِ",68,"ن",1,0],["وَدَرّاعَةٌ مِن تَحتِها وَعِمامَةٌ","سَوادُهُما في وَجنَةِ الدَهرِ كَالخالِ",69,"ل",1,0],["وَدَرَسْتُ حُبَّكَ مِنْ فُؤَا","دِي مِثْلَمَا دَرَسَ الطَّلَلْ",70,"ل",1,0],["ودرها يطغو لطلابه","والدر في قاموسه يرسب",71,"ب",1,0],["ودرها الموت يقري في مخالبها","للواردين يوفي شربه القدرُ",72,"ر",1,0],["وَدر فراد يس العقيقين هيدب","عَلى كل شعب منه يَرفض هيدب",73,"ب",1,0],["ودرّ له الثَدى الاجد كَرامَة","كَما اِنشق بدر في السَماء مُنير",74,"ر",1,0],["وَدرع محمد القرآن لما","تَلا وَاللَه يعصمك اطمأنا",75,"ن",2,0],["وَدَرَتْ أنْ لَيْسَ يَدْرَأُ بِي","طُولُ تَعْذيبٍ وَتَعْذيلِ",76,"ل",1,0],["وَدَرُّ نَوائِبٍ صَرَفَتْ عِنانِي","إِلى تِلْقائِهِمْ عِنْدَ الرَّحِيلِ",77,"ل",1,0],["وَدِرعُهُ مِثلُ أَحداقِ الجَرادِ عُيو","نُها تَرَقرَقُ ماءً غَيرَ مُنسَجِمِ",78,"م",1,0],["ودرى الأهل بالفضيحة فاهتاج","أخوها وهب يطلب ثأرا",79,"ر",2,0],["وَدرةً مصونةً","وَإِنْ تكنْ لم تحجب",80,"ب",1,0],["وَدرَّتْ عروقٌ حين شَدَّ خناقَها","لها اللهُ قبل الذبح توشك تخنق",81,"ق",1,0],["ودر الغمام وهب النسيم","وغنى الحمام وزمزم حاد",82,"د",1,0],["وَدُروعٍ وَسُيوفٍ","كُلُّ عَضبٍ كَالغَديرِ",83,"ر",1,0],["وَدرُّ مرآةِ المَعاني فَما","في الجيد دُرٌّ مَعَها يُذكرُ",84,"ر",1,0],["ودرَّعَ قلْبَهُ بالصّبْرِ حتّى","رماني بالصَّبابةِ واتَّقاني",85,"ي",1,0],["ودُرّاً كما لاح دُرًىُّ نَجمٍ","وشِعراً كما أهدَتِ النّورَ شِعْري",86,"ر",2,0],["ودَرَّجتْه إليها أوّلونَ دَعَوا","للمؤمنينَ فذادوا عنهمُ أُمَرا",87,"ر",2,0],["ودرَّجتُه بينَ البُيوتِ أُروضه","وقلتُ عساهُ أن يَفوتَ فَيَسبِقا",88,"ق",2,0],["ودِرهَمٌ واحِدٌ فصَّلتَ جُملتَه","ملأتَ منه نِثاراً قاعَةَ الدارِ",89,"ر",1,1],["ودرةِ لِلفخار أسلَمها العقدُ","وكانت كالروحِ للجسدِ",90,"د",1,0],["ودُرِيّ ثغرٍ ما لَه مِن مُشابهٍ","وربّتما لِلّناسِ في النّاسِ أشباهُ",91,"ه",1,0],["ودرّسْتُ في العلمين أعلام عصرنا","فكلٌّ تلاميذي فسل وتَنشَّدِ",92,"د",1,0],["وَدُرُّ نظم أتى لم يأت من صدف","ولا روى مثله في غيثه الصفدي",93,"د",2,0],["ودِرعاً حَصيناً يعلمُ الله أنَّه","مدى الدَّهر لم يبرح من الدَّهر واقيا",94,"ي",2,0],["ودُر بحيث ترى الأقداح دائرة","فإنها لمدار الأنس كالقطب",95,"ب",1,0],["ودُرُّ قريضٍ رُمْتُ إذ ذاكَ شأوَهُ","فقصَّرَ عنهُ ساعدي ونَبا كدّي",96,"د",2,0],["ودرّةً يحجُبُ عن نيلها","بحرُ وغًى بالبأسِ زخّارُ",97,"ر",1,0],["ودرى الوابل من بعد الوشل","وعليه ستدور الدائره",98,"ه",1,0],["ودرجتْ في البيت فالبيتُ على","مَرازبِ الملوك أو أقيالها",99,"ل",3,0],["ودَرَّتْ راحتاه ولم تُعصَّبْ","وكم من مُزنةٍ لا تستماحُ",100,"ح",1,0],["ودُرُّ بُحورٍ عادَ حصْباءَ أمْعَزٍ","تدوس سَناهُ أرْجُلٌ وحَوافِرُ",101,"ر",1,0],["ودُرَرُ الإِتْحافِ لو عرفْتَها","أَذْيالُنا بفَذِّها مُرَصَّعَهْ",102,"ع",2,0],["ودربٍ دون أنوارٍ وحجْرٍ","على قمرٍ وليلٍ دون دابِرْ",103,"ر",1,0],["ودَرَّ درُّهُمُ من جيرةٍ معهم","لم يبرحِ القلبُ إن ساروا وإنْ نزَلوا",104,"ل",3,0],["ودرجت الفؤاد على التسلي","إلى أن صار من خلقي وعادي",105,"ي",1,0],["ودر كأن الطلى والنحور","أعرن المباسم منه العقود",106,"د",1,0],["ودُرْ في الأَرْضِ قُطْراً بَعْدَ قُطْرٍ","لِتَظْفَرَ بالْمُنَى أَو بالْمَمَاتِ",107,"ت",1,0],["ودُرُّ ثَغرِكَ وَمَا","لِدُرِّهِ مِن ثَمَنِ",108,"ن",1,0],["ودرّتِ النُّعمى عليكمْ ثَرَّةً","ونلتموها عَلَلاً بعد نَهَلْ",109,"ل",1,0],["ودرى بأنّ النُّجحَ ليس لعاقلٍ","فينا وأنَّ الحظَّ حظُّ المائقِ",110,"ق",1,0],["وَدَرّوا بَعد ما رشحوا فَأَضحَوا","وَقَد مَلأوا مِنَ الشرّ الجِرابا",111,"ب",2,0],["ودُرُّ الغيث منظومٌ","لأثوابِ الرُّبا نَمنَمْ",112,"م",1,0],["ودِرعٌ نَسجُ داودٍ منيعٌ","بنصرِ الله مَنعَتُهُ تزيدُ",113,"د",1,0],["ودُرْ مَعَ الدَّهرِ وانظُرْ في عَواقبِهِ","حِذارَ أن تُبتَلى عَيناكَ بالرَّمَدِ",114,"د",1,0]]}