px?id=215451",""],[5943,"ألا انتبهتا","https://www.poetsgate.com/ViewPoem.aspx?id=56465",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5957,"جُرح الوَطَن","https://www.poetsgate.com/ViewPoem.aspx?id=12233",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6056,"حبات دمعي","https://www.poetsgate.com/ViewPoem.aspx?id=130313",""],[6093,"حادٍ وليس له بعير","https://www.poetsgate.com/ViewPoem.aspx?id=176447",""],[6093,"الدُّرَّةُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=181003",""],[520,"أما وخدود الفن الصدودا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577480",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""],[6213,"مناهل الرحمن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81911&r=&rc=86",""],[5957,"صباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82616&r=&rc=140",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["وَدَرَّت عَلَيكَ ثُدِيُّ الغَمامِ","كَأَنَّ رُباكَ سِقابُ الدِيَم",0,"م",1,0],["ودَرَّتْ علَيْنا راحَةٌ خَلَصَتْ بِها","إلينا اليدُ البيْضاءُ والعِيشةُ الرَّغْدُ",1,"د",1,0],["وَدُرنا كَما دارَت عَلى قَطبِها الرُحى","وَدارَت عَلى هامِ الرِجالِ الصَفائِحُ",2,"ح",1,0],["وَدَراري النُجومِ غارَت وَغابَت","وَضِياءُ الآفاقِ صارَ قَتاما",3,"م",2,0],["وَدُرتَ بِأَعداءٍ حَبيبُكَ فيهُمُ","كَما قَد تَراني بِالعَدوِّ أَدورُ",4,"ر",1,0],["وَدُرتَ بِأَعداءٍ حَبيبُكَ فيهِمُ","كَما قَد تَراني بِالحَبيبُ أَدورُ",5,"ر",1,0],["ودُرَّ ثَناءٍ منْ عُلاكَ انْتَخبْتُهُ","ومنْ عجَبٍ يُهْدى الى البحْرِ دُرُّهُ",6,"ر",2,0],["ودُرْتُ على مرْكَزي دوْرَةً","يُحَقِّرُ مَنْ دارَها مُلْكَ دَارا",7,"ر",2,0],["ودُرّةِ نَوْرٍ في غِلافِ زَبَرْجَدٍ","كما لاحَ في الخَضْراءِ لألاءُ فَرقَدِ",8,"د",1,1],["وَدُروعٌ مِن نَسجِ داوُودَ في الحَر","بِ وَسوقٌ يُحمَلنَ فَوقَ الجِمالِ",9,"ل",1,0],["وَدَرى الشَرقُ كَيفَ يَستَمرِئُ اللَه","وَ فَيُفضي بِهِ إِلى شَرِّ حالِ",10,"ل",1,0],["ودرت ذات أيدينا وكانت","كحلب النوق أيام الغراز",11,"ز",1,0],["وَدُرتَ عَلى عاسي العُروقِ وَلَم يَكُن","لِيَسقِيَ أَفواهَ العُروقِ دُرورُها",12,"ر",3,0],["ودَرى المدح عجزه عنه لكن","خاف عنه الكتمان من آثامه",13,"م",2,0],["ودرّ بكائي حين يبسم ثغرها","لقد لاح فرقٌ بين نثري ونظمها",14,"م",3,0],["ودرى سرها الرهيب علي","فاشتهى لو يكون كبش الفداء",15,"ا",2,0],["ودرَّ لي درُّ الكلامِ وحَشَكْ","وأوجف السير بشعرِي ورتكْ",16,"ك",1,0],["ودرعٍ إذا أنا أسلمتُها","وقتْني وإن أحمها أُكلمِ",17,"م",1,1],["ودرَّت حماليقُهُ والتوى","كما يلتوي حين يُثنى الهَرِسْ",18,"س",1,0],["وَدُرٌّ وَلَكِن بَينَ جنبيكَ بَحرهُ","وَزَهرٌ وَلَكِن الفُؤادَ كِمامُ",19,"م",1,0],["وَدُروسٍ لَم يُذَلِّل قَطفَها","عالِمٌ إِن نَطَقَ الدَرسَ سَحَر",20,"ر",1,0],["وَدَرى مَن أَعَزَّهُ الدَفعُ عَنهُ","فيهِما أَنَّهُ الحَقيرُ الذَليلُ",21,"ل",1,0],["ودَرَّتِ الجُودَ وَعْداً صادقاً يَدُه","وكان ظَنّاً على الأيامِ مَكذوبا",22,"ب",2,0],["وَدَرَوا بِأَنَّهُم بِذَلِكَ أَخطَأوا","فَأَتاكَ كُلٌّ تائِباً يَستَغفِرُ",23,"ر",1,0],["وَدَرى بِأَنَّ نِظامَ شِعري جَوهَرٌ","وَسِواهُ نَحرٌ لا يَليقُ بِعِقدِهِ",24,"د",2,0],["وَدُروعٌ قد ضوعِفَ النسيجُ منها","وَتَناهَى في سَردِها التقديرُ",25,"ر",1,0],["وَدُرّاً وَياقوتاً أَرَغنَ اِلتِقاطَهُ","تَداعَت بِهِ كَفُّ الصِبا فَتَبَدَّدا",26,"د",2,0],["ودَرَى أسامةُ فانثنَى في جيشهِ","والحزنُ طامٍ والدُّموعُ سَواجِمُ",27,"م",1,0],["وَدَرى أنَما السُّجودُ لغيرِ ال","لَهِ إثمٌ يَحيقُ بالسّاجدينا",28,"ن",2,0],["وَدُروعٌ كَأَنَّها شَمَطُ الجَع","دِ دَهيناً تَضَلُّ فيها المَداري",29,"ر",2,0],["وَدُروعاً كَأَنَّها وَجهُ ماءٍ","صافَحَتهُ ريحٌ وَعَضباً مِحَذّا",30,"ذ",2,0],["ودَرُّ القُصورِ البِيضِ يَعمُرُ مُلكَها","ملوكُ بني الدّنيا وهنّ الكَرائِمُ",31,"م",1,0],["وَدِرعُكَ إِن وَقَتكَ سِهامَ قَومٍ","فَما هِيَ مِن رَدى يَومٍ وِقاءُ",32,"ق",3,0],["وَدِرعُ حَديدٍ عِندَهُ دِرعُ كاعِبٍ","مِنَ الوُدِّ وَاِسمُ الحَربِ هِندٌ وَزَينَبُ",33,"ب",1,0],["وَدِرعُ الفَتى في حُكمِهِ دِرعُ غادَةٍ","وَأَبياتُ كِسرى مِن بُيوتِ العَناكِبِ",34,"ب",1,0],["ودُرّاً خِلْتِ أنْجُمَه عليه","فهلاّ خِلْتِهِنّ به ذُبالا",35,"ل",2,0],["ودروبٍ حولها ملتفّةٍ","كأفاعٍ سُمِّرتْ في منحناها",36,"ا",3,0],["ودروب خضر عليها خطى","الشاء تعيد التغريب والتشريقا",37,"ق",2,0],["ودرى أثالة ان عروة في الحمى","وبما بعروة من هوى وهوان",38,"ن",1,0],["ودُرَّةُ خِدْرٍ أَقْسَمَ الْخِدْرُ إنَّهُ","عَلَى مِثْلِهَا لَمْ تُلْقَ يَوْماً سَدَائلُهْ",39,"ل",2,0],["ودُرَّةٌ لم تَرَ الأصدافُ مُشْبههَا","بينَ الكُنوز الغَوالي من خباياها",40,"ا",3,0],["ودرِّع الشعبَ إن خطبٌ ألم به","درعًا من الخُلْق، لا درعًا من الزَّرَدِ",41,"د",1,0],["ودروب الكفاح تنبيك عنه","كم طواها وأتعب الأهوالا",42,"ل",2,0],["ودرِّسي نشأك تاريخَه","فان فيه المنهج الأصوبا",43,"ب",2,0],["ودريئةٍ يرمي الأبيَّ بها","وغدٌ ، ويُصمي البّرَةَ الفُجر",44,"ر",1,0],["ودُرْ بالفكر في خَلَدِ الليالي","وجُلْ في الكون رأياً مُستعادا",45,"د",2,0],["ودَرِّسوا نشْكم من شِعرِهم قِطَعاً","مُصوِّراتٍ لأفراحٍ وأحزان",46,"ن",1,0],["ودَرَجتُ اقتنصُ الشباب خَسِرتُه","ذا رِبحةٍ ورَبِحته خسرانا",47,"ن",2,0],["ودروعٌ قد ضوعف النسجُ منها","وتناهَى في سردها التقدير",48,"ر",1,0],["ودرعٍ إذا أنا أسملتُها","وقتْني وإن أحمها أُكلمِ",49,"م",1,1],["ودروا أنه حقيقة كل ال","أمر عند الإظهار والإضمار",50,"ر",1,0],["ودُرًّا ونَوراً ناضرا متفتقا","وحِقفاً وبَانَةً ميسةً وتثنيا",51,"ي",2,0],["وَدُر فِيهَا فَبِالدَّوَرَانِ فِيهَا","تَسَامَى لِلمُؤمِّل كُل حَيِّ",52,"ي",1,0],["وَدَراهِماً وَقَناطِراً وَمَوائِداً","وَأَرائِكاً وَوَلائِداً وَحُلاحِلا",53,"ل",2,0],["ودرت نفوسهم بأنك ظافرٌ","فأتت تقدم ما إليه تؤول",54,"ل",1,0],["وَدَرَّت لَهُ في كُلِّ أُفقٍ غَمامَةٌ","تَدُلُّ عَلى بُخلِ الغُيوثِ الهَوامِعِ",55,"ع",1,0],["وَدَرى هُنالِكَ مِن أَشَدُّ شَكيمَةً","عِندَ اللِقاءِ وَمِن أَلَدُّ خِصاما",56,"م",2,0],["ودرى بأنك لا يخاشنك امرؤ","إِلاّ لقى بك ما يسوء ويضهدُ",57,"د",1,0],["ودرهم الجور ممحوق يلم به","من الحوادث ما يمحو به أثراً",58,"ر",2,0],["ودرجة في لسع الزنابير تجتري","على لسع حيات هناك عظيمة",59,"ه",1,0],["وَدِرعٌ كَأنَّ البيضَ وَالقُضبَ وَالقَنا","إِذا صافَحتَها بُورَقٌ وَثُمامُ",60,"م",1,0],["وَدَرُّ بَلائِى مِن هَواكِ فإنَّهُ","لِعَلِى وَإِن غالَبتُهُ لَغَلُوبُ",61,"ب",1,0],["ودَرَّجْن بالقَصْرين رملا كأنه","غُصونُ جباهِ الروم وهْي عوابِس",62,"س",1,0],["ودَرَّجتْ ماءَه الصَّبا فحكى","ثوبَ حريرٍ مُدَمْقَسٍ أزرق",63,"ق",1,0],["وَدَروا أنّه نبيّ الجهادِ","وَلهُ كتبهُم منَ الأشهادِ",64,"د",1,0],["وَدَروهُ الليثَ الجريءَ فإن أُح","رِجَ زادَ الإقدام والإجتراءُ",65,"ا",2,0],["ودَرَتْ عيوني بعدها كيفَ البكا","ودرى بعيني بعدها التسهادُ",66,"د",1,0],["وَدَرى بَعلُها وَلَم يكُ يَدري","أَيّ خَمرٍ تَحول في الأَعراقِ",67,"ق",1,0],["وَدرى بِالتَقصير منه فَأَضحى","من حياءٍ بوَجنَةٍ حمراء",68,"ا",2,0],["ودرّت له في الجدب عجفاء حائلٌ","وبكل على نزل الفحول تمنع",69,"ع",1,0],["وَدَرَت قُرَيشٌ بِالحَديثِ فَأَظهَرَت","ما عِندَها مِن مُضمَرِ الأَضعانِ",70,"ن",1,0],["وَدَرّاعَةٌ مِن تَحتِها وَعِمامَةٌ","سَوادُهُما في وَجنَةِ الدَهرِ كَالخالِ",71,"ل",1,0],["وَدَرَسْتُ حُبَّكَ مِنْ فُؤَا","دِي مِثْلَمَا دَرَسَ الطَّلَلْ",72,"ل",1,0],["ودرها يطغو لطلابه","والدر في قاموسه يرسب",73,"ب",1,0],["ودرها الموت يقري في مخالبها","للواردين يوفي شربه القدرُ",74,"ر",1,0],["وَدر فراد يس العقيقين هيدب","عَلى كل شعب منه يَرفض هيدب",75,"ب",1,0],["ودرّ له الثَدى الاجد كَرامَة","كَما اِنشق بدر في السَماء مُنير",76,"ر",1,0],["وَدرع محمد القرآن لما","تَلا وَاللَه يعصمك اطمأنا",77,"ن",2,0],["وَدَرَتْ أنْ لَيْسَ يَدْرَأُ بِي","طُولُ تَعْذيبٍ وَتَعْذيلِ",78,"ل",1,0],["وَدَرُّ نَوائِبٍ صَرَفَتْ عِنانِي","إِلى تِلْقائِهِمْ عِنْدَ الرَّحِيلِ",79,"ل",1,0],["وَدِرعُهُ مِثلُ أَحداقِ الجَرادِ عُيو","نُها تَرَقرَقُ ماءً غَيرَ مُنسَجِمِ",80,"م",1,0],["ودرى الأهل بالفضيحة فاهتاج","أخوها وهب يطلب ثأرا",81,"ر",2,0],["وَدرةً مصونةً","وَإِنْ تكنْ لم تحجب",82,"ب",1,0],["وَدرَّتْ عروقٌ حين شَدَّ خناقَها","لها اللهُ قبل الذبح توشك تخنق",83,"ق",1,0],["ودر الغمام وهب النسيم","وغنى الحمام وزمزم حاد",84,"د",1,0],["وَدُروعٍ وَسُيوفٍ","كُلُّ عَضبٍ كَالغَديرِ",85,"ر",1,0],["وَدرُّ مرآةِ المَعاني فَما","في الجيد دُرٌّ مَعَها يُذكرُ",86,"ر",1,0],["ودرَّعَ قلْبَهُ بالصّبْرِ حتّى","رماني بالصَّبابةِ واتَّقاني",87,"ن",2,0],["ودُرّاً كما لاح دُرًىُّ نَجمٍ","وشِعراً كما أهدَتِ النّورَ شِعْري",88,"ر",2,0],["ودَرَّجتْه إليها أوّلونَ دَعَوا","للمؤمنينَ فذادوا عنهمُ أُمَرا",89,"ر",2,0],["ودرَّجتُه بينَ البُيوتِ أُروضه","وقلتُ عساهُ أن يَفوتَ فَيَسبِقا",90,"ق",2,0],["ودِرهَمٌ واحِدٌ فصَّلتَ جُملتَه","ملأتَ منه نِثاراً قاعَةَ الدارِ",91,"ر",1,1],["ودرةِ لِلفخار أسلَمها العقدُ","وكانت كالروحِ للجسدِ",92,"د",1,0],["ودُرِيّ ثغرٍ ما لَه مِن مُشابهٍ","وربّتما لِلّناسِ في النّاسِ أشباهُ",93,"ه",1,0],["ودرّسْتُ في العلمين أعلام عصرنا","فكلٌّ تلاميذي فسل وتَنشَّدِ",94,"د",1,0],["وَدُرُّ نظم أتى لم يأت من صدف","ولا روى مثله في غيثه الصفدي",95,"د",2,0],["ودِرعاً حَصيناً يعلمُ الله أنَّه","مدى الدَّهر لم يبرح من الدَّهر واقيا",96,"ي",2,0],["ودُر بحيث ترى الأقداح دائرة","فإنها لمدار الأنس كالقطب",97,"ب",1,0],["ودُرُّ قريضٍ رُمْتُ إذ ذاكَ شأوَهُ","فقصَّرَ عنهُ ساعدي ونَبا كدّي",98,"د",2,0],["ودرّةً يحجُبُ عن نيلها","بحرُ وغًى بالبأسِ زخّارُ",99,"ر",1,0],["ودرى الوابل من بعد الوشل","وعليه ستدور الدائره",100,"ه",1,0],["ودرجتْ في البيت فالبيتُ على","مَرازبِ الملوك أو أقيالها",101,"ل",3,0],["ودَرَّتْ راحتاه ولم تُعصَّبْ","وكم من مُزنةٍ لا تستماحُ",102,"ح",1,0],["ودُرُّ بُحورٍ عادَ حصْباءَ أمْعَزٍ","تدوس سَناهُ أرْجُلٌ وحَوافِرُ",103,"ر",1,0],["ودُرَرُ الإِتْحافِ لو عرفْتَها","أَذْيالُنا بفَذِّها مُرَصَّعَهْ",104,"ع",2,0],["ودربٍ دون أنوارٍ وحجْرٍ","على قمرٍ وليلٍ دون دابِرْ",105,"ر",1,0],["ودَرَّ درُّهُمُ من جيرةٍ معهم","لم يبرحِ القلبُ إن ساروا وإنْ نزَلوا",106,"ل",3,0],["ودرجت الفؤاد على التسلي","إلى أن صار من خلقي وعادي",107,"د",2,0],["ودر كأن الطلى والنحور","أعرن المباسم منه العقود",108,"د",1,0],["ودُرْ في الأَرْضِ قُطْراً بَعْدَ قُطْرٍ","لِتَظْفَرَ بالْمُنَى أَو بالْمَمَاتِ",109,"ت",1,0],["ودُرُّ ثَغرِكَ وَمَا","لِدُرِّهِ مِن ثَمَنِ",110,"ن",1,0],["ودرّتِ النُّعمى عليكمْ ث