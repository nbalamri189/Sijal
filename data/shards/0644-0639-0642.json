{"poems":[[83,"إن الدقيق ولعقه","https://www.aldiwan.net/poem61348.html","مجزوء الرمل"],[289,"أخذ الفأر برجلي","https://www.aldiwan.net/poem44343.html","مجزوء الرمل"],[422,"سقى الله عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53888.html","الطويل"],[438,"أنا من جوارك في أعز مكان","https://www.aldiwan.net/poem12752.html","الكامل"],[580,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201704","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204731","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204640","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134027","الطويل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216564",""],[5277,"قميصُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=192064",""]],"verses":[["لَعَقَ الهَرِيسَةَ جَاهِداً","وَاللَّيلُ مَسدُول الإزَار",0,"ر",1,0],["لعقوا وقالوا","ريح مسك بسلافِ",1,"ف",1,0],["لعقيدة صَبري أوهَنَتْ نفثاتُها","إذا ما رَنَتْ أو رُتّلت كلماتها",2,"ه",2,0],["لعقدتُ آمالَ الذُرى بك همّةً","أُسِرَ الطليقُ بها وفكّ العاني",3,"ن",2,0],["لعقَلتَ عقْلِي في الهَوى","يا لَلْهوى وخلبْتَ لُبِّي",4,"ب",2,0],["لعقلك علم في قواه عوالم","كما قيل معلوم له وهو عالم",5,"م",1,0],["لعقله وأنت شاهد الجمم","وفي السلامة نقص قد ألم",6,"م",1,0],["لعقله وهمه وعزمه","شورى فعين الرشد ما به قضى",7,"ا",1,0],["لعقولِ الخَلق بِمُندَرَجِ","فِيهِ للخلَقِ نَجاتُهُم",8,"م",1,0],["لعقرب الطالع خسه الحمل","وقوسه ترمي لثور درل",9,"ل",1,0],["لعقلي في الحياة فصيح نطق","ولي بعد الردى عقل صموت",10,"ت",1,0],["لعقلي من بلدتي مرشد","فباب اجتهاد بها دون سدْ",11,"د",1,0],["لعقلك كل يوم ألف سهو","وما ينفك عقلك في غرور",12,"ر",1,0],["لعقد نظيم الدر طال تشوقي","فشاهدته يزهو بصدر الصحائف",13,"ف",1,1],["لِعقُود لَي تَزْرِي بالاموال","أزرى بِهَا وبطور سينا",14,"ن",2,0],["لعقتْ غرامي ثم قالتْ لم أذقْ","إلا مرارتَهُ..فما جدوى العشقْ",15,"ق",1,1]]}