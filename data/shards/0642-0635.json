ِ المَساعي","وَقَولُ الناسِ لَم يَنجَح فُلانُ",0,"ن",1,1],["قَصَفَت قَنا جَدَلِ الطِعانِ وَثَوَّرَت","بَعدَ الأَمانِ بِعامِرِ الضَحيانِ",1,"ن",1,0],["قُصاقِصَةٌ ما باتَ إِلّا عَلى دَمٍ","تَمَضمَضَ مِنهُ عِرسُهُ ثُمَّ شِبلُهُ",2,"ل",2,0],["قَصَدتُ العُلى وَالمَكرُماتُ سَبيلُ","وَطُلّابُها لَولا الكِرامُ قَليلُ",3,"ل",1,1],["قَصايِرُ في بُيوتِ العِزِّ تُنمى","مَناسِبُها إِلى المَجدِ الطَوالِ",4,"ل",1,0],["قَصيرُ ما بَينَ أولاهُ وَآخِرِهِ","كَأَنَّما العُنقُ مَعقودٌ بِها الكَفَلُ",5,"ل",1,0],["قَصَّرتَ رُمحَكَ طولاً في صُدورِهِمُ","وَرُمحُ غَيرِكَ لَم يَقصُر وَلَم يَطُلِ",6,"ل",1,0],["قَصَفَ الدَهرُ فيكَ رُمحاً مِنَ الكَي","دِ وَحامى عَنِ المَعيبِ المَؤوفِ",7,"ف",1,0],["قَصائِدُ أَنسَتِ الشُعَراءَ طُرّاً","عُواؤَهُمُ عَلى أَثَرِ القَوافي",8,"ي",1,0],["قَصَّرَ الدَهرُ مِن ذُراهُ وَقَد كا","نَ بِتِلكَ الظُبى طَويلَ النِجادِ",9,"د",1,0],["قَصائِدٌ بَدَوِيَّاتٌ وَصَلْتُ بها","مُقَطّعاتٍ عَليها رِقّةُ الحَضَرِ",10,"ر",1,0],["قَصائِدُ مِن قيلِ اِمرِئٍ يَحتَذيكُمُ","بَني العُشَراءِ فَاِرتَدوا وَتَقَلَّدوا",11,"د",3,0],["قصَدْتُ الى المَوْلى أبي عُمَرَ الرِّضى","غدَتْ بالذي يُرْضي المَشيئَةَ جارِيَهْ",12,"ر",3,1],["قُصارَى مُنانا أنْ نَفوزَ بنَظْرَةٍ","ونقْنَعُ منْ نيْلِ الوِصالِ بِما قَلاّ",13,"ل",2,0],["قصَدَتْ سُلَيْمانَ الزّمانِ وقارَبَتْ","في الخَطْوِ تحْسِبُ نفْسَها بِلْقيسا",14,"س",2,0],["قَصَدَتْهُ عَادِيَةُ الزَّمَانِ فَأَقْصَدَتْ","وَالْعِزُّ سَامٍ وَالْخَمِيسُ لُهَامُ",15,"م",1,0],["قَصَدَتْ بِهِمْ بَحْرَ الزُّقَاقِ عَزِيمَةٌ","قَدْ جَرَّدَتْ أَسْيَافَهَا لَمْ تَكْهَمِ",16,"م",1,0],["قصَدَتْهُ عاديةُ الزّمانِ فاقْصَدَتْ","لمْ تُغْنِ عنْهُ عندَها أنصارُهُ",17,"ر",2,0],["قصدْناكَ يا خيْرَ المُلوكِ على النّوى","لتُنْصِفَنا ممّا جَنى عبْدُكَ الدّهْرُ",18,"ر",1,0],["قصَفَتْ صَعْدَةَ انْتِصاري وفلّتْ","غرْبَ عَزْمي المُعَدَّ يومَ كِفاحي",19,"ح",2,0],["قَصُرَتْ خُطاها بعْدَما ضمّرْتُها","منْ كُلِّ موْفورِ الجِمامِ جَموحِ",20,"ح",1,0],["قَصيرَ البِنانِ دَقيقَ الشَوى","يَقولُ أَيَأتينَ أَم لا يُجينا",21,"ن",2,0],["قَصرَ الدوبارَةِ ما لِلَيثِكَ رابِضاً","وَالذِئبُ في قَصرِ الإِمارَةِ يَحجِلُ",22,"ل",1,1],["قَصَفَتهُ المَنونُ وَهوَ نَضيرٌ","مورِقٌ عودُهُ جَنِيُّ الثِمارِ",23,"ر",1,0],["قِصارٌ وَحَسبُ النُهى أَنَّها","لَها مُعجِزاتٌ قِصارِ السُوَر",24,"ر",1,0],["قَصرَ الدُبارَةِ قَد نَقَض","تَ العَهدَ نَقضَ الغاصِبِ",25,"ب",1,1],["قَصّوا حَواشِيَها وَظَنّوا أَنَّهُم","أَمِنوا صَواعِقَها فَكانَت أَصعَقا",26,"ق",2,0],["قُصارى مُنى أَوطانِكُم أَن تَرى لَكُم","يَداً تَبتَني مَجداً وَرَأساً يُفَكِّرُ",27,"ر",1,0],["قَصرَ الدُبارَةِ هَل أَتاكَ حَديثُنا","فَالشَرقُ ريعَ لَهُ وَضَجَّ المَغرِبُ",28,"ب",1,1],["قَصَدتُ الجَزيرَةَ أَبغي النَجاةَ","وَجِسمي شَواهُ اللَظى فَاِشتَوى",29,"ا",1,0],["قُصورٌ كَأَنَّ بُروجَ السَماءِ","خُدورُ الغَواني بِأَدوارِها",30,"ر",3,0],["قَصَرتُ عَلَيكَ العُمرَ وَهوَ قَصيرُ","وَغالَبتُ فيكَ الشَوقَ وَهوَ قَديرُ",31,"ر",1,1],["قَصرٌ يُقِرُّ العَينَ مِنهُ مَصنَعٌ","بَهِجُ الجَوانِبِ لَو مَشى لَاِختالا",32,"ل",2,0],["قَصَّرَ الوَصلُ عُمرَها وَبِوُدّي","أَن يَطولَ القَصيرُ مِنها بِعُمري",33,"ر",2,0],["قِصارُهُ قَيصَرٌ إِن قامَ مُفتَخِراً","لِلَّهِ أَوَّلُهُ مَجداً وَآخِرُهُ",34,"ر",2,0],["قَصدَ لَفتٍ وَهُنَّ مُتَّسِقاتٌ","كَالعَدَولِيِّ لا حِقاتِ التَوالي",35,"ل",2,0],["قَصَدتَ لَها حَتّى إِذا ما لَقيتَها","ضَرَبتَ بِبُصرِيِّ الصَفيحِ قَذالَها",36,"ل",3,0],["قصيدي ما قصيدي في","هوى وطني وفي آلي",37,"ي",1,0],["قصر عن أدنى علاك الحسد","أنت بناء وبنوك العمد",38,"د",1,1],["قصر دون المقام وصفى","فيا مزاياه أسعدينا",39,"ن",2,0],["قَصِيدَةٌ رَائِعَةٌ أَكْمَلَتْ","حَلَى مَبَانِيَها معانِيَهَا",40,"ي",3,0],["قَصَصْتَ عَلَيَّ مِنْ عِبْرِ اللَّيَالِي","غَرَائِبَ لا تُدَانِيهَا الظُّنُونُ",41,"ن",1,1],["قَصَرَ الغَوايَةَ عَن هَوى قَمَرٍ","وَجَدَ السَبيلَ إِلَيهِ مُشتَرَكا",42,"ك",2,0],["قُصارايَ مِنهُم أَن أَأوبَ بِغُصَّةٍ","تَرَدَّدُ بَينَ الصَدرِ واللَهواتِ",43,"ت",1,0],["قِصارَ الخُطى يَمشينَ هَوناً كَأَنَّهُ","دَبيبُ القَطا بَل هُنَّ في الوَعثِ أَوجَلُ",44,"ل",1,0],["قصر أطلّ على البسفور مرتفعاً","إليه يشخص طرف العقل حيرانا",45,"ن",2,0],["قصدوا الرياضة لاعبين وبينهم","كرة تراض بلعبها الأجسام",46,"م",1,1],["قصور علت في الجوّ لم تلق بينهما","وبين النجوم الزهر في حسنها فرقا",47,"ق",2,0],["قصّرت منه كمّه عن يديها","وأطالت إلى النهود الجيوبا",48,"ب",2,0],["قصّرتها يد الحوادث لكن","قد اطالت بها على الحيّ باسه",49,"س",2,0],["قَصُرَت يَداكَ عَنِ السَماءِ فَلَم يَكُن","في الأَرضِ لِلشَجَرِ الخَبيثِ قَرارُ",50,"ر",1,0],["قَصُرَت يَداكَ عَنِ السَماءِ وَلَم تَجِد","كَفّاكَ لِلشَجَرِ الخَبيثِ قَرارا",51,"ر",2,0],["قَصُرَت يَداكَ عَنِ الفَعالِ وَطالَما","غالَت أَباكَ عَنِ المَكارِمِ غولُ",52,"ل",1,0],["قصرت كأني وامتداحي خالداً","واسرته حادٍ وليس له ابلْ",53,"ل",1,0],["قُصَّ جَناحَيهِ يَكُن في الدارِ","مَعَ الدَباسي وَمَعَ القَماري",54,"ي",1,0],["قَصَّرنَ دونَ مَداهُ تَق","صيرَ الحُروفِ عَنِ الأَلِف",55,"ف",1,0],["قِصارٌ مَساعيها تَظَلُّ كِلابُها","إِذا ضافَ ضَيفٌ مُستَحِنّاً هَريرُها",56,"ر",3,0],["قصدتك للتنويه والجاه لا لما","تبيض من هذي اللّهى وتصفّر",57,"ر",1,0],["قصيرٌ لأمرٍ ما يجدّع أنفه","إلى أن رأينا الملك قد عزَّ نصره",58,"ر",2,0],["قصدتك ظمآناً فجدت بزاخرٍ","أشقّ كما قد قيل فيه وأذرع",59,"ع",1,0],["قصرت نظميَ إلا أنه نخبٌ","وطوَّل الناس إلاَّ أنهم لبكوا",60,"ك",3,0],["قصار تحاماها الرماح طويلةٌ","نواحل يستشفى بها الحال من وعك",61,"ك",1,0],["قصرت في الكلام مرتبة الأس","ماء واعتل سائر الأفعال",62,"ل",1,0],["قصدتُ حماك أرجي الغنى","وأشكو من العسر داءً دفينا",63,"ن",2,1],["قَصَّرتَ بالشعر حين تعرضه","على مُبين العمى إذا انتقدَهْ",64,"د",2,0],["قصيرةُ البيتِ وهي سابغةٌ","على هوى السامعين مُقتَدِره",65,"ر",2,0],["قصَّر من يسأل الحقائر أم","ثالك جِدّاً وآنَ إقصاره",66,"ر",2,0],["قُصارك أن ترقى لعينيك نظرةٌ","إليّ وقد حزتَ المدى حين تفخر",67,"ر",1,0],["قصدتُ بأسباب إليك كثيرةٍ","ووعدٍ قديمٍ منك لم تَقْضِه نُكر",68,"ر",1,0],["قصائدٌ مُقْصِداتٌ من أصيب بها","وإن رجَزَتْ أتاك الرِّجْز لا الرَّجَز",69,"ز",1,0],["قصد المحامدَ حين أكسد تجْرها","فابتاع كاسدها بغير مِكاس",70,"س",1,0],["قصدت سهامُ الشعر غُرَّةَ مالِهِ","فأصَبْنَ دون المال غُرةَ عِرضِهِ",71,"ض",2,0],["قصرُكَ الشيب فاقض ما أنت قاضِ","مِن هوى البيض قبلَ حين البياضِ",72,"ض",1,1],["قصيرة القامة مقصوعةٌ","للقمل فوق الطبل قصّاعه",73,"ع",2,0],["قُصَيِّر