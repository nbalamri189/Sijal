5256.html","الوافر"],[475,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[480,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[491,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[498,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[512,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[513,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[534,"عرفت دياراً بالحمى فشرائث","https://www.aldiwan.net/poem23857.html","الطويل"],[549,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[549,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[556,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[560,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[565,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[573,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[573,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[584,"متى بالقرب يخبرني الرسول","https://www.aldiwan.net/poem17645.html","الوافر"],[585,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"]],"verses":[["وَصُبحٍ تُطلَقُ الآجالُ فيهِ","وَناظِرُ شَمسِهِ في النَقعِ عاني",0,"ي",1,0],["وَصَبَرتُ حَتّى نِلتُهُنَّ وَلَم أَقُل","ضَجَراً دَواءُ الفارِكِ التَطليقُ",1,"ق",1,0],["وصُبَّتْ علَيهِ الطُّلْسُ وهْيَ سَواغِبٌ","تَجوبُ إليهِ البيدَ بالنّسَلانِ",2,"ن",1,0],["وصَبا الدُّهورُ إلَيْكَ بَعْدَ مُضِيِّها","لتَرى نَضارَةَ عَصرِكَ المُتأخّرِ",3,"ر",1,0],["وصبت نواحيها وجن جنونه","فرحاً وكاد الصمت أن يتكلما",4,"م",2,0],["وَصَبٌّ لا يَقَرُّ لَهُ قَرارٌ","وَلا يَسلو وَلَو طالَ الرَحيلُ",5,"ل",1,0],["وَصَبَّرتُ نَفسي فَلَمّا رَأَي","تُ أَنَّ التَصَبُّرَ لَن يَستَقيما",6,"م",2,0],["وَصَبَرتُ حَتّى عيلَ صَبري كُلُّهُ","وَهَوَيتُكُم يا حِبَّ نَفسي لِلشَّقا",7,"ا",1,0],["وصَباحُ شَيْبِ الفَوْدِ لاحَ بمَفْرِقي","فغدَوْتُ منْ فقْدِ الصِّبا مفْؤودا",8,"د",2,0],["وصَبّحْتَ جَمْعَ الكُفْرِ في مُستقَرِّه","فخابَتْ مَساعِيهِ وساءَ صَباحُهُ",9,"ح",2,0],["وَصَبرٌ عَلى الدَهرِ في رُزئِهِ","وَإِعطاءُ كَفٍّ وَإِجزالُها",10,"ل",3,0],["وَصَبَرتُ مِنهُ عَلى الَّذي يَعيا بِهِ","حِلمُ الحَليمِ وَيَتَّقيهِ الأَحمَقُ",11,"ق",1,0],["وَصَبرُ الفَتى في المَأزِقِ الضَنكِ فادِحٌ","وَلكِنَّهُ أَهدى طَريقٍ إِلى الفَخرِ",12,"ر",1,0],["وصبّ عليها من بئار صروفه","سجالاً من الكذب المموَّه والحنث",13,"ث",1,0],["وَصَباً غَداةَ إِقامَةٍ وَزَّعتُها","بِجِفانِ شيزى فَوقَهُنَّ سَنامُ",14,"م",1,0],["وَصَبوحِ صافِيَةٍ وَجَذبِ كَرينَةٍ","بِمُوَتَّرٍ تَأتالُهُ إِبهامُها",15,"م",3,0],["وصُب له شول من الماء غابر","به كفَّ عنه الحِيبة المتحوبُ",16,"ب",1,0],["وَصَبَّ عَلى الأَتراكِ نِقمَةَ مُنعِمٍ","رَماهُ بِكُفرانِ الصَنيعَةِ غادِرُ",17,"ر",1,0],["وصَبتْ إلى لقياك غير ملولةٍ","نفسٌ رأت جدواك أصلَ حياتها",18,"ت",3,0],["وصبرني الواشي فيا لمصبر","قتيل بمسنون اللحاظ مشيه",19,"ي",2,0],["وصبراً فإن الحُرَّ باللَّوْمِ تُبتغى","إثابَتُهُ والعبدُ بالشتمِ والضرب",20,"ب",1,0],["وصبري على الإقتار أيسرُ مَحْملاً","عليَّ مِنَ التغرير بعد التجاربِ",21,"ب",1,0],["وصبورٌ عليه إنْ","شَقّ مَفْسَاهُ أو سَحَجْ",22,"ج",1,0],["وصبّتْ على غيري فجادت بطلِّها","سماؤك حتى غرّق الناس هَطلُها",23,"ل",3,0],["وَصَبرٌ عَلى حَدَثِ النائِباتِ","وَحِلمٌ رَزينٌ وَقَلبٌ ذَكِيُّ",24,"ي",1,0],["وَصُبَّ عَلَيها الطيبُ حَتّى كَأَنَّها","أَسِيٌّ عَلى أُمِّ الدِماغِ حَجيجُ",25,"ج",1,0],["وَصَبَحتُها غُرَّ الوُجوهِ غَرانِقاً","مِن تَغلِبَ الغَلباءِ لا أَسفالَها",26,"ل",3,0],["وَصَبا لِلنُجومِ مَن قَد عَلاهُ","أَصبَحَ الجَوُّ تَحتَهُ كَالصَعيدِ",27,"د",1,0],["وَصَبَرتُم فَلَيتَني","كُنتُ أُعطيتُ صَبرَكُم",28,"م",1,0],["وَصَبَّحَت بِرَكَ الرَيّانِ فَاِتَّبَعَت","فيهِ الجَحافِلُ حَتّى خُضنَ بِالسُرَرِ",29,"ر",1,0],["وَصَبَّحنَ بِالصَقرَينِ صَوبَ غَمامَةٍ","تَضَمَّنَها لَحيا غَديرٍ وَخانِقُه",30,"ق",2,0],["وَصَبَّحنَ مِن سَمنانَ عَيناً رَوِيَّةً","وَهُنَّ إِذا صادَفنَ شُرباً صَوادِقُه",30,"ق",2,0],["وَصَبَّحنَ لِلعَذراءِ وَالشَمسُ حَيَّةٌ","وَلِيَّ حَديثِ العَهدِ جَمٍّ مَرافِقُه",30,"ق",2,0],["وصبايا رواقصٌ يتراشقْ","نَ بزهرِ التُّفَّاحِ والياسَمينِ",31,"ن",1,0],["وصَباحُ الحَيَاةِ لا يُوقِظُ الموْتَى","ولا يَرْحَمُ الجفونَ الكليلهْ",32,"ه",1,0],["وصبونا الى اللقاء ولكن","حال دون اللقاء شحط المزار",33,"ر",1,0],["وصبغن من دمها الخدود تنصلا","ولقين أرباب الهوى بسواد",34,"د",1,0],["وَصِبياناً يَضِجّونَ","كَما يَلقَونَ طَيّارَه",35,"ر",2,0],["وَصَبِيَّةٍ هُتِكَت خَميلَةُ طُهرِها","وَتَناثَرَت عَن نَورِهِ الأَكمامُ",36,"م",1,0],["وَصَبوحَنا مِن بَندِلارَ وَشَرشَرٍ","وَغَبوقَنا بِتَرابِيا وَبُيوكِ",37,"ك",1,0],["وَصَبِيٍّ أَزرَتِ الدُنيا بِهِ","شَبَّ بَينَ العِزِّ فيها وَالخَطَر",38,"ر",1,0],["وصبَّحتكِ من الأرآمِ جازيةٌ","ترعى رُباكِ وترعَى حسنَها المقلُ",39,"ل",1,0],["وصَبَا النسيمُ إِلى ثَراكَ برَوْحِه","وجرَى على مغناكَ غيرَ مُرَوَّعِ",40,"ع",1,0],["وَصُبتَ بَينَهُما حَتّى تُسيلَهُما","بِمُستَهَلٍّ مِنَ الوَسمِيِّ مُنسَجِمِ",41,"م",1,0],["وَصَبَّحَ أَهلَ الجَوفِ وَالجَوفُ آمِنٌ","بِمِثلِ الدَبا وَالدَهرُ جَمٌّ بَلابِلُه",42,"ل",2,0],["وَصَبَوْتُ فيه إلى الصَّبا","والشَّيبُ يَضحكُ في عِذاري",43,"ر",2,0],["وصبْراً إذا هَبَّ وَجْدُ الحَشا","تعلَّقْتُ منه بمثلِ الهَباء",44,"ا",2,0],["وَصَبري حينَ جِدِّ الأَمرِ نَفسي","إِذا ما أُرعِدَت رِئَةُ الجَبانِ",45,"ن",1,0],["وصباباتُ أعينٍ","يشهد الليل لَم تنم",46,"م",1,0],["وَصَبْرِي عَلَى الأَيَّامِ لا مِنْ مَذَلَّةٍ","وَلَكِنْ يَدٌ مَغْلُولَةٌ وَحُسَامُ",47,"م",1,0],["وصباباتٌ مضافاتٌ إلى","حرِّ قلبي وَهْيَ لا تنصرفُ",48,"ف",1,0],["وَصَبا القَلبُ إِلى بَهنانَةٍ","مِثلِ قَرنِ الشَمسِ يَبدو في الظُلَم",49,"م",1,0],["وَصَبا وَمالَ بِهِ الهَوى وَاِعتادَهُ","لَهوُ الصِبا بِجُنونِ قَلبٍ مُسهَبِ",50,"ب",1,0],["وَصَبا إِلَيها أَسمَرٌ أَعدَيتُهُ","فَلَوى مَعاطِفَهُ لَها تَخطارا",51,"ر",2,0],["وَصَبَّ سَجّانٌ