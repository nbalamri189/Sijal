oem55850.html","الهزج"],[461,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[461,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[461,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[461,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[461,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[464,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[464,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[464,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[467,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[468,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[480,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[480,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[480,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[485,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[496,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[503,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[508,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[517,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[518,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[539,"عرفت دياراً بالحمى فشرائث","https://www.aldiwan.net/poem23857.html","الطويل"],[554,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[554,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[561,"نحن الملوك الفقرا","https://www.aldiwan.net/poem34493.html","مجزوء الرجز"],[565,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[570,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[578,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[578,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[589,"متى بالقرب يخبرني الرسول","https://www.aldiwan.net/poem17645.html","الوافر"],[590,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/76776","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/18023","الطويل"],[1049,"","https://poetry.dctabudhabi.ae/diwan/poem/206021","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2528","الخفيف"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/31516","الوافر"]],"verses":[["وَصُبحٍ تُطلَقُ الآجالُ فيهِ","وَناظِرُ شَمسِهِ في النَقعِ عاني",0,"ن",2,0],["وَصَبَرتُ حَتّى نِلتُهُنَّ وَلَم أَقُل","ضَجَراً دَواءُ الفارِكِ التَطليقُ",1,"ق",1,0],["وصُبَّتْ علَيهِ الطُّلْسُ وهْيَ سَواغِبٌ","تَجوبُ إليهِ البيدَ بالنّسَلانِ",2,"ن",1,0],["وصَبا الدُّهورُ إلَيْكَ بَعْدَ مُضِيِّها","لتَرى نَضارَةَ عَصرِكَ المُتأخّرِ",3,"ر",1,0],["وصبت نواحيها وجن جنونه","فرحاً وكاد الصمت أن يتكلما",4,"م",2,0],["وَصَبٌّ لا يَقَرُّ لَهُ قَرارٌ","وَلا يَسلو وَلَو طالَ الرَحيلُ",5,"ل",1,0],["وَصَبَّرتُ نَفسي فَلَمّا رَأَي","تُ أَنَّ التَصَبُّرَ لَن يَستَقيما",6,"م",2,0],["وَصَبَرتُ حَتّى عيلَ صَبري كُلُّهُ","وَهَوَيتُكُم يا حِبَّ نَفسي لِلشَّقا",7,"ا",1,0],["وصَباحُ شَيْبِ الفَوْدِ لاحَ بمَفْرِقي","فغدَوْتُ منْ فقْدِ الصِّبا مفْؤودا",8,"د",2,0],["وصَبّحْتَ جَمْعَ الكُفْرِ في مُستقَرِّه","فخابَتْ مَساعِيهِ وساءَ صَباحُهُ",9,"ح",2,0],["وَصَبرٌ عَلى الدَهرِ في رُزئِهِ","وَإِعطاءُ كَفٍّ وَإِجزالُها",10,"ل",3,0],["وَصَبَرتُ مِنهُ عَلى الَّذي يَعيا بِهِ","حِلمُ الحَليمِ وَيَتَّقيهِ الأَحمَقُ",11,"ق",1,0],["وَصَبرُ الفَتى في المَأزِقِ الضَنكِ فادِحٌ","وَلكِنَّهُ أَهدى طَريقٍ إِلى الفَخرِ",12,"ر",1,0],["وصبّ عليها من بئار صروفه","سجالاً من الكذب المموَّه والحنث",13,"ث",1,0],["وَصَباً غَداةَ إِقامَةٍ وَزَّعتُها","بِجِفانِ شيزى فَوقَهُنَّ سَنامُ",14,"م",1,0],["وَصَبوحِ صافِيَةٍ وَجَذبِ كَرينَةٍ","بِمُوَتَّرٍ تَأتالُهُ إِبهامُها",15,"م",3,0],["وصُب له شول من الماء غابر","به كفَّ عنه الحِيبة المتحوبُ",16,"ب",1,0],["وَصَبَّ عَلى الأَتراكِ نِقمَةَ مُنعِمٍ","رَماهُ بِكُفرانِ الصَنيعَةِ غادِرُ",17,"ر",1,0],["وصَبتْ إلى لقياك غير ملولةٍ","نفسٌ رأت جدواك أصلَ حياتها",18,"ت",3,0],["وصبرني الواشي فيا لمصبر","قتيل بمسنون اللحاظ مشيه",19,"ي",2,0],["وصبراً فإن الحُرَّ باللَّوْمِ تُبتغى","إثابَتُهُ والعبدُ بالشتمِ والضرب",20,"ب",1,0],["وصبري على الإقتار أيسرُ مَحْملاً","عليَّ مِنَ التغرير بعد التجاربِ",21,"ب",1,0],["وصبورٌ عليه إنْ","شَقّ مَفْسَاهُ أو سَحَجْ",22,"ج",1,0],["وصبّتْ على غيري فجادت بطلِّها","سماؤك حتى غرّق الناس هَطلُها",23,"ل",3,0],["وَصَبرٌ عَلى حَدَثِ النائِباتِ","وَحِلمٌ رَزينٌ وَقَلبٌ ذَكِيُّ",24,"ي",1,0],["وَصُبَّ عَلَيها الطيبُ حَتّى كَأَنَّها","أَسِيٌّ عَلى أُمِّ الدِماغِ حَجيجُ",25,"ج",1,0],["وَصَبَحتُها غُرَّ الوُجوهِ غَرانِقاً","مِن تَغلِبَ الغَلباءِ لا أَسفالَها",26,"ل",3,0],["وَصَبا لِلنُجومِ مَن قَد عَلاهُ","أَصبَحَ الجَوُّ تَحتَهُ كَالصَعيدِ",27,"د",1,0],["وَصَبَرتُم فَلَيتَني","كُنتُ أُعطيتُ صَبرَكُم",28,"م",1,0],["وَصَبَّحَت بِرَكَ الرَيّانِ فَاِتَّبَعَت","فيهِ الجَحافِلُ حَتّى خُضنَ بِالسُرَرِ",29,"ر",1,0],["وَصَبَّحنَ بِالصَقرَينِ صَوبَ غَمامَةٍ","تَضَمَّنَها لَحيا غَديرٍ وَخانِقُه",30,"ق",2,0],["وَصَبَّحنَ مِن سَمنانَ عَيناً رَوِيَّةً","وَهُنَّ إِذا صادَفنَ شُرباً صَوادِقُه",30,"ق",2,0],["وَصَبَّحنَ لِلعَذراءِ وَالشَمسُ حَيَّةٌ","وَلِيَّ حَديثِ العَهدِ جَمٍّ مَرافِقُه",30,"ق",2,0],["وصبايا رواقصٌ يتراشقْ","نَ بزهرِ التُّفَّاحِ والياسَمينِ",31,"ن",1,0],["وصَباحُ الحَيَاةِ لا يُوقِظُ الموْتَى","ولا يَرْحَمُ الجفونَ الكليلهْ",32,"ه",1,0],["وصبونا الى اللقاء ولكن","حال دون اللقاء شحط المزار",33,"ر",1,0],["وصبغن من دمها الخدود تنصلا","ولقين أرباب الهوى بسواد",34,"د",1,0],["وَصِبياناً يَضِجّونَ","كَما يَلقَونَ طَيّارَه",35,"ر",2,0],["وَصَبِيَّةٍ هُتِكَت خَميلَةُ طُهرِها","وَتَناثَرَت عَن نَورِهِ الأَكمامُ",36,"م",1,0],["وَصَبوحَنا مِن بَندِلارَ وَشَرشَرٍ","وَغَبوقَنا بِتَرابِيا وَبُيوكِ",37,"ك",1,0],["وَصَبِيٍّ أَزرَتِ الدُنيا بِهِ","شَبَّ بَينَ العِزِّ فيها وَالخَطَر",38,"ر",1,0],["وصبَّحتكِ من الأرآمِ جازيةٌ","ترعى رُباكِ وترعَى حسنَها المقلُ",39,"ل",1,0],["وصَبَا النسيمُ إِلى ثَراكَ برَوْحِه","وجرَى على مغناكَ غيرَ مُرَوَّعِ",40,"ع",1,0],["وَصُبتَ بَينَهُما حَتّى تُسيلَهُما","بِمُستَهَلٍّ مِنَ الوَسمِيِّ مُنسَجِمِ",41,"م",1,0],["وَصَبَّحَ أَهلَ الجَوفِ وَالجَوفُ آمِنٌ","بِمِثلِ الدَبا وَالدَهرُ جَمٌّ بَلابِلُه",42,"ل",2,0],["وَصَبَوْتُ فيه إلى الصَّبا","والشَّيبُ يَضحكُ في عِذاري",43,"ر",2,0],["وصبْراً إذا هَبَّ وَجْدُ الحَشا","تعلَّقْتُ منه بمثلِ الهَباء",44,"ا",2,0],["وَصَبري حينَ جِدِّ الأَمرِ نَفسي","إِذا ما أُرعِدَت رِئَةُ الجَبانِ",45,"ن",1,0],["وصباباتُ أعينٍ","يشهد الليل لَم تنم",46,"م",1,0],["وصِبْيةٍ مُذْ أَجَابُوا الحَرْبَ مَا سَأَلَتْ","صَارُوا المَشَايخَ والأقطابَ والعُمَدا",47,"د",2,0],["وَصَبَرنا تَحتَ البَوارِقِ حَتّى","رَحَدَت فيهِمِ السُيوفُ طَويلا",48,"ل",2,0],["وَصَبْرِي عَلَى الأَيَّامِ لا مِنْ مَذَلَّةٍ","وَلَكِنْ يَدٌ مَغْلُولَةٌ وَحُسَامُ",49,"م",1,0],["وصباباتٌ مضافاتٌ إلى","حرِّ قلبي وَهْيَ لا تنصرفُ",50,"ف",1,0],["وَصَبا القَلبُ إِلى بَهنانَةٍ","مِثلِ قَرنِ الشَمسِ يَبدو في الظُلَم",51,"م",1,0],["وَصَبا وَمالَ بِهِ الهَوى وَاِعتادَهُ","لَهوُ الصِبا بِجُنونِ قَلبٍ مُسهَبِ",52,"ب",1,0],["وَصَبا إِلَيها أَسمَرٌ أَعدَيتُهُ","فَلَوى مَعاطِفَهُ لَها تَخطارا",53,"ر",2,0],["وَصَبَّ سَجّانٌ عَلَيهِ الزَيتا","فَصارَ بَعدَ بِزَّةٍ كُمَيتا",54,"ت",2,0],["وصبَوا إِلى الأَوثانِ بَعدَ وَفاتِهِ","وَالرُّسْلُ مِنْ أسَفٍ عليهم تَنْدُبُ",55,"ب",1,0],["وصُبَّ عليهم عارضٌ مِنْ حِجَارةٍ","ونَبْلٍ وكُلٌّ بالعَذابِ مَطِيرُ",56,"ر",1,0],["وَصَبَّرَ عِيْنَها حِمْلاً وَلكِنْ","لِمَنْزِلِهِ وَغَلَّتَها خَزِينا",57,"ن",2,0],["وَصَبَّحَهُ فُلجٌ وَلا زالَ كَعبُهُ","عَلى كُلِّ مَن عادى مِنَ الناسِ ظاهِرا",58,"ر",2,0],["وَصَبابَةُ الإِنسانِ بِالدُن"