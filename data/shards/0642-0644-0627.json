{"poems":[[108,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[53,"يا ناشد النعماء يقفو إثرها","https://www.aldiwan.net/poem30480.html","الرجز"],[53,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[93,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[30,"أمن دمنة بين القلات وشارع","https://www.aldiwan.net/poem29572.html","الطويل"],[27,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[37,"قلات بالخطيطة جاوزتها","https://www.aldiwan.net/poem6977.html","الوافر"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[70,"قل الثقات فلا تركن إلى أحد","https://www.aldiwan.net/poem42854.html","الطويل"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[28,"حلفت برب مكة والمصلى","https://www.aldiwan.net/poem4958.html","الوافر"],[28,"يا ابن ربيع هل رأيت أحدا","https://www.aldiwan.net/poem5035.html","الرجز"],[61,"قسمت قلبي بين الهم والكمد","https://www.aldiwan.net/poem51715.html","البسيط"],[66,"وجنبني حب الكواعب أنني","https://www.aldiwan.net/poem38456.html","الطويل"],[66,"قفي ودعينا قبل وشك التفرق","https://www.aldiwan.net/poem38481.html","الطويل"],[66,"زمان الربيع","https://www.aldiwan.net/poem40962.html","المتقارب"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"ذريني منك سافحة المآقي","https://www.aldiwan.net/poem30396.html","الوافر"],[44,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[105,"نزيل النيل أين تركت ملكا","https://www.aldiwan.net/poem43074.html","الوافر"],[105,"تأن ابن حرب لست في مثلها جلدا","https://www.aldiwan.net/poem44214.html","الطويل"],[48,"لنا خمر وليس بخمر نخل","https://www.aldiwan.net/poem62463.html","الوافر"],[48,"طرحتم من الترحال ذكرا فغمنا","https://www.aldiwan.net/poem66141.html","الطويل"],[50,"مهلا أخي لم تلق ما قد لقيت","https://www.aldiwan.net/poem64744.html","السريع"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[100,"بعد سقوط المكياج","https://www.poetsgate.com/ViewPoem.aspx?id=50368",""],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[94,"أهوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=15665",""],[38,"على الدّارِ بالرمانتينِ تعوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=21138",""],[116,"ما للقلوب من العيون امان","https://www.aldiwan.net/poem40440.html","عموديه"],[116,"لله في طي هذا الكون آيات","https://www.aldiwan.net/poem41202.html","عموديه"],[116,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[116,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[120,"قلائد فتح كان يذخرها الدهر","https://www.aldiwan.net/poem4345.html","الطويل"],[129,"ألا إنني في نعمة ومسرة","https://www.aldiwan.net/poem50629.html","الطويل"],[129,"بنينا بأرض الله لله مسجدا","https://www.aldiwan.net/poem50632.html","الطويل"],[144,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[161,"إذا كان من عاداك يصبح نادما","https://www.aldiwan.net/poem58900.html","الطويل"],[182,"خليلى روحا بالهجين فسلما","https://www.aldiwan.net/poem58814.html","الطويل"],[212,"لولا الغرام بكم لعشت طويلا","https://www.aldiwan.net/poem46322.html","الكامل"],[226,"إذا كنت يا زين زين الأدب","https://www.aldiwan.net/poem55194.html","المتقارب"],[230,"على الطائر الميمون والطالع السعيد","https://www.aldiwan.net/poem51134.html","الطويل"],[233,"قيد يكابده وسجن ضيق","https://www.aldiwan.net/poem14857.html","الكامل"],[236,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[236,"حرام على الأجفان أن ترد الغمضا","https://www.aldiwan.net/poem31900.html","الطويل"],[238,"تطوان ما أدراك ما تطوان","https://www.aldiwan.net/poem19100.html","الكامل"],[255,"أبعد العشق أحيا","https://www.aldiwan.net/poem36217.html","مجزوء الرمل"],[272,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[272,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[272,"أفق هديت من التبريح والكمد","https://www.aldiwan.net/poem52105.html","البسيط"],[272,"أرياح نجد تممي الهابا","https://www.aldiwan.net/poem52113.html","الكامل"],[291,"بلبل في الرياض يلهمه الوحي","https://www.aldiwan.net/poem11715.html","الخفيف"],[304,"وذي دلال نافر قده","https://www.aldiwan.net/poem57938.html","السريع"],[354,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[358,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[365,"زف المنام إلي طيف خياله","https://www.aldiwan.net/poem60669.html","الكامل"],[372,"ببعض الدمى قام بعض الفتن","https://www.aldiwan.net/poem57084.html","البسيط"],[378,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[401,"يا مسجد الإسراء","https://www.aldiwan.net/poem6713.html","عموديه"],[430,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[454,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[459,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[478,"أعيدوا حديث الظاعنين على سمعي","https://www.aldiwan.net/poem15344.html","الطويل"],[480,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[480,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[501,"قل استريحوا بني الدنيا فمذهبنا","https://www.aldiwan.net/poem37755.html","البسيط"],[507,"قل إذا جئت مجلسا","https://www.aldiwan.net/poem2375.html","مجزوء الخفيف"],[515,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[528,"ما لي رأيت بني العباس قد فتحوا","https://www.aldiwan.net/poem45969.html","البسيط"],[552,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[559,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[563,"شوق يهيج وقلب طالما خفقا","https://www.aldiwan.net/poem52893.html","البسيط"],[576,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"]],"verses":[["قلا تنكري لهفي فقد طالت السرى","وأجهد من ثقل الحديد ملازبه",0,"ب",2,0],["قَلائِدُ المَجدِ لَكُنتَ دُرَّها","نَرى الأَعادي إِن عَزَمتَ ثَغرَها",1,"ر",3,0],["قَلائِدُ في الأَعناقِ بِالعارِ لا تَهي","عَلى مَرِّ أَيّامِ الزَمانَ وَلا تَصدا",2,"د",2,0],["قَلائِدُ مِن نَظمي يَوَدُّ لِحُسنِها","قُلوبُ الأَعادي أَن تَكونَ تَرائِبا",3,"ب",2,0],["قَلَّ الصِحابُ فَإِن ظَفِر","تَ بِنِعمَةٍ كَثُرَ الصِحابُ",4,"ب",1,0],["قَلاَئِدُ فَتْحٍ هُنَّ لَكِنَّ قَدْرَهَا","تَرَفَّعَ أَنْ يُدْعَى قَلاَئِدَ عِقْيَانِ",5,"ن",1,0],["قِلاَصٌ بَرَاهَا السَّيْرُ حَتَّى كَأَنَّهَا","خَوَاطِرُ فِي فِكْرِ الْفَلاَةِ تَجُولُ",6,"ل",1,0],["قَلَّ الثَّنَاءُ عَلَيْهَا في الْوَفَاءِ بِهَا","لَوْ قُرْبَهُ مِنَ أَنْفُسِ الْقُرَبِ",7,"ب",1,0],["قَلائِلُ فِينَا وَالشُّرُورُ كَثِيرةٌ","تُقَوِّضُ مِنْ أَخْلافِنَا وَتُهْدِّمُ",8,"م",1,0],["قُلِ الْحَقَّ مَا إِنْ يَنْفَعُ النَّاسَ مِثْلُهُ","وَلَوْ بَعْدَ حِينٍ وَاتْرُكِ الزُّورَ يَنْقِمُ",9,"م",1,0],["قُلِ الْحَقَّ إِنْ يُعْجِبْ فَذَاكَ وَإِنْ يَسُوءْ","فَذَاكَ وَلاَ يَصْدُدْكَ مَا قَدْ تُجَشَّمُ",9,"م",1,0],["قِلاصاً رَحَلناهُنَّ مَن حَيثُ تَلتَقي","بِوَهبينَ فَوضى رَبرَبٍ وَنَعامِ",10,"م",1,0],["قَلائِصَ لا تَنفَكُّ تَدمى أُنوفُها","عَلى طَلَلٍ مِن عَهدِ خَرقاءَ شاعِفِ",11,"ف",1,0],["قَلائِصُ ما يُصبَحنَ إِلّا رَوافِعا","بِنا سيرَةً أَعناقُهُنَّ تَزَعزَعُ",12,"ع",1,0],["قَلائِصُ عَذَّبَت لَيلى عَلَيها","وَعَذَّبَ لَيلَها نِسعٌ وَكورُ",13,"ر",1,0],["قِلات بالخَطيطة جاوزتها","فَنَضَّ سِمالُها العينُ الذرورُ",14,"ر",1,1],["قِلاك براءةٌ وهَواك عُرٌّ","ودينُ الناس حمدُ مُذمّميكا",15,"ك",2,0],["قل اعفُ عني عثرت في عدتي","يأتك عفوي وليس ممنونا",16,"ن",2,0],["قَلَّ الثُقاتُ فَلا تَرَكنَ إِلى أَحَدٍ","فَأَسعَدُ الناسِ مَن لا يَعرِفُ الناسا",17,"س",2,1],["قل ايها الشعر معي","تبت يدا ابي لهب",18,"ب",1,0],["قُل إِذا خاطَبتَ غَيرَ المُسلِمين","لَكُمو دينٌ رَضيتُم وَلِيَ دين",19,"ن",1,0],["قُل إِذا شِئتَ صُروفٌ وَغِيَر","وَإِذا شِئتَ قَضاءٌ وَقَدَر",19,"ر",1,0],["قَلَّ الكِرامُ فَصارَ يَكثُرُ فَذُّهُم","وَلَقَد يَقِلُّ الشَيءُ حَتّى يَكثُرا",20,"ر",2,0],["قَلائِدَ لَيسَ مِن ذَهَبٍ وَلَكِن","مَواسِمَ مِن جَهَنَّمَ مَنضِجاتِ",21,"ت",1,0],["قَلائِصٌ إِذا عَلَونَ فَدفَدا","يَرمينَ بِالطَرفِ النَجاءَ الأَبعَدا",22,"د",2,0],["قِلادةٌ جالَ فيها الفِكْرُ فانتظَمَتْ","نظْمَ القلائدِ لم تَنْقُصْ ولم تَزِدِ",23,"د",1,0],["قل الحق من ربي بوصف وفائهم","فمن شاء فليؤمن ومن شاء فليكفر",24,"ر",1,0],["قَلائِدُ أَعناقِ الرِجالِ هِباتُهُ","تَرى الناسَ مِنها كَالحَمامِ المُطَوَّقِ",25,"ق",1,0],["قُلِ الحَمدُ لِلَّهِ","وَاللَهُ أَكبَر",26,"ر",1,0],["قِلاصٌ حَناهنّ الهزالُ كَأنها","حنِيّات نَبْعٍ في أكفِّ جواذِبِ",27,"ب",1,0],["قَلائِصَ ما يَقيها حَدَّ هَمّي","وَلا سَيفي غَداةَ الهَمِّ واقِ",28,"ق",1,0],["قَلَّ الغَضى لا شَكَّ في أَوطانِهِ","مِمّا حَشَدتَ إِلَيهِ مِن جَمرِ الغَضى",29,"ض",2,0],["قُلِ اللَهُمَّ غَفّارَ الخَطايا","إِلَيكَ نَتوبُ فَاِرزُقنا القُبولا",30,"ل",2,0],["قُلِ الحقَّ ما للعالمين سكينةٌ","على الأرضِ حتى يَعبدُوا الواحدَ الفردا",31,"د",2,0],["قَلائِصُ في الرُؤوسِ لَها ضُروعٌ","تَدِرُّ عَلى أَكُفِّ الحالِباتِ",32,"ت",1,0],["قَلائِصُ لَم تُسقِط جَنيناً مِنَ الوَجى","وَلَم تَدرِ ما قَرعُ الفَنيقِ وَلا الهَنا",33,"ن",2,0],["قُل أَيُّها اللائِمُ في حُبِّها","لَم تَدرِ ما وُدّي وَلا ما هَويتُ",34,"ت",1,0],["قَلائِصُ إِن حَرَّكتَ كَفّاً تَكَمَّشَت","كَأَنَّ عَلى أَكسائِها الجِنَّ تُجلِبُ",35,"ب",1,0],["قل الحقيقة لا يأ","خذنْك فيها الهلاع",36,"ع",1,0],["قَلائِصُ لا يَرْعَيْنَ عَازِبَةَ الْكَلا","وَلا يَسْتَبِقْنَ الْمَاءَ إِنْ فَاتَهَا الْعِشْرُ",37,"ر",1,0],["قِلاصٌ حَداها راكِبٌ مُتَعَمِّمٌ","هَجائِنُ قَد كادَت عَلَيهِ تَفَرَّقُ",38,"ق",1,0],["قل أنا الكذاب ، وامنحني على","حسّك الإنساني الشعبي ، مثل",39,"ل",1,0],["قل إن أتيتَ من \" الحليفة \" دارَها","ولقيِتَ شعباً للشعوب مكافحا",40,"ح",2,0],["قل إن سُئلتَ عن الجزيرة مُفصحاً","ما أشبهَ الأحفادَ بالأجداد",41,"د",1,0],["قل إن جلست مخاطبا طاغوتها","ومحاورا في بغيه جزّارها",42,"ر",3,0],["قَلاَ دِينَهُ وَکهْتَاجَ لِلشَّوْقِ إنَّهَا","عَلَى الشَّوْقِ إِخْوَانَ الْعَزَاءِ هَيُوجُ",43,"ج",1,0],["قلّ الذين اذا الملمة ازعجت","حرسوك حبا بالنفوس وصانوا",44,"ن",3,0],["قل الكرام وقد جل اللئام ولم","ترفع لا عزاز امر الحق رايات",45,"ت",1,0],["قل الكرام وقل من هو عارف","ما هم عيه وقلت العرفاء",46,"ا",2,0],["قل أجبناك فكن في أمننا","طيب القلب أميناً مثلما",47,"م",2,0],["قلائدُ فتح كان يذخرُها الدهرُ","فلما أردتَ الغزو أبرَزُها النَصرُ",48,"ر",1,1],["قلائدُ شعرى زينتْ بمديحه","وهل في قريض زانَ كاسم محمدِ",49,"د",1,0],["قلائدُ في أعناقِها ونحورِها","مفصلةٌ من لؤْلؤ وزبرْجَدِ",50,"د",1,0],["قِلاصاً إِذا رامَت خَلاصاً مِنَ السُرى","مَرَقنَ فَأَنكَرنَ الجَديلَ وَشَدقَما",51,"م",2,0],["قلاه الورى حتى الاقارب اصبحت","عقارب تسعى نحوه وأراقما",52,"م",2,0],["قَلائِصُ فِيهِنَّ الَّتِى الّتِى كِبرُ هَمِّها","أَنِينٌ وَتُذرِى الدَّمعَ بالزَّفَرَاتِ",53,"ت",1,0],["قل الوفاء فلست تعرف عاشقاً","إلا خشيت الغدر والتبديلا",54,"ل",2,0],["قَلائِدُ حَلَّيتَ صدرَ البيان","بهنَّ وَطوَّفت جيدَ العرَب",55,"ب",1,0],["قلا زِلتَ تبقَي مدّة الدهر مالكاً","ولو لم أَخَفْ عيناً لبَشَّرْتُ بالخلدْ",56,"د",1,0],["قَلَّ الصَديقُ أَخو الوَفاءِ وَأعوَزِ ال","خِلُّ الشَقوقِ وَأَينَ خِلّق مُشفِقُ",57,"ق",1,0],["قَلَّ أَن أَضرَعَ أَو أَر","كَبَ لِلأَطماعِ صَهوَه",58,"و",2,0],["قَلائِدَ حَمدٍ لَم أَزِدكَ بِنَظمِها","جَلالاً وَلَكِنّي قَضَيتُ بِها الفَرضا",59,"ض",2,0],["قُلْ إِنْ لَحَاكَ مُكَابِرٌ فِي حُبِّهَا","هِيَ جَنَّةٌ فِرْدَوْسُهَا الْكِيتَانُ",60,"ن",1,0],["قل أبعد العشق أحيا","مرة إذْ أنتَ قربي",61,"ب",2,0],["قل أَنتما من اصيحاني وَحاشيَتي","وَمن خصائص اتباعي وَمن حشمي",62,"م",2,0],["قل أَنتَ يا عَبدَ الرَحيم وكل من","واليته في ذمة لم تخفر",63,"ر",1,0],["قل أَنتَ منا عَلى ما كانَ منك فجز","عَلى الصراط وَهَذا حوضنا فرد",64,"د",1,0],["قل أَنتَ في الدارين منا لا تَخف","من بعدها يا صاحب النيابا",65,"ب",2,0],["قُل أخا الشعر ما الفناء وما البعث","وما الخلد في بديع جنانه",66,"ن",2,0],["قلا محبيه الذين اغتدوا","من خده صيد شباك الحرير",67,"ر",1,0],["قَلائدُ مِن سحر البَيان لَوَ اِنَّها","بِنا نَفَثَت أَغنَت عَن النَحو وَالصَرفِ",68,"ف",1,0],["قَلَّ أَن يُوجِفَ جَيشُ نَحوَهَا","أَو تشنّ الخَيلُ فِيهَا غَلَسَا",69,"س",2,0],["قَلّ الهوَى في العينِ منه مثْلما","يَلْقَى الأميرُ نَداهُ باسْتِقْلاله",70,"ل",2,0],["قَلائِدُه في رِقابِ الرِّجا","لِ مُعلَّقةٌ كلُّها بالمِنَن",71,"ن",1,0],["قُلْ أكرمُ الإكرام رهبانيّةٌ","فكأنها نورٌ بليلٍ أدهم",72,"م",1,0],["قُلْ أيُّها الأقصى لمَنْ وَهِمُوا:","هل تلجأُ الأغصانُ للفَأْسِ؟",73,"س",1,0],["قلائد عقيان البديع كتابه","عبارته الفصحاء تغني عن القطر",74,"ر",1,0],["قل أجبني يا ولي","دا كل وحي منه طهر",75,"ر",1,0],["قلَّ الثِّقاتُ فإن عَلِقتَ بواحدٍ","فاشدد يديك عليه فهو وحيدُ",76,"د",1,0],["قلْ إن وصلتَ لناصر الدين استمع","فِقَراً تُجمِّعُ كلَّ أنسٍ شاردِ",77,"د",1,0],["قلا قلبي فلا تسأل إذا ما","أصيب بقلبه المضنى الهنيف",78,"ف",1,0],["قلائدُ أشعارٍ أُنضَّدُ دُرَّها","اِذا نضَّدَ الأقوامُ شِعراً مِنَ الوَدْعِ",79,"ع",1,0],["قل اللهم أياما تراها","محلقة حوالينا تحوم",80,"م",1,0],["قل أين حق الحمايه","من نشر أمن وعلم",81,"م",1,0],["قُلِ اسْتَريحوا بَني الدُّنيا فمذْهَبُنا","لم يَزْحَمَنْهِمْ طَريقٌ كلُّهُ دِينُ",82,"ن",1,1],["قل إذا جئت مجلسا","وسمعت المزاح مه",83,"ه",1,1],["قِلادةُ المجدِ والعُليا صنائِعُه","وزينةُ الدّينِ والدُّنيا مَساعِيهِ",84,"ي",2,0],["قلّ الدراهم في كفيّ خليفتنا","هذا فأنفق في الأقوام ألقابا",85,"ب",2,0],["قلائدٌ مثلُ أطواقِ الحمامِ لنا","تبيدُ أُخرى اللّيالِي وهْيَ لم تَبِدِ",86,"د",1,0],["قل اعملوا قال ربي ثم قال لهم","لا يقدرون على شيء وإن زعموا",87,"م",3,0],["قلائدٌ خِلْتُها حبراً على وَرَقٍ","فكانتِ الدُرَّ لا حِبراً ولا وَرَقا",88,"ق",2,0],["قَلَّ الملوكُ بعيْني بَعْد رُؤْيتِه","ومن رأَى البحرَ لا يستكثرُ الوشَلا",89,"ل",2,0]]}