tps://www.poetsgate.com/ViewPoem.aspx?id=214099",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[4115,"قل المعنى مذ همت عبراته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607622",""],[6185,"بوح !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87022&r=&rc=8",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[6229,"قلادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65192&r=&rc=17",""],[6253,"اختيار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6417&r=&rc=0",""],[5616,"الرّاحلون ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1934&r=&rc=4",""],[2220,"نحنُ حزبُ اللهِ من يلحقنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11806&r=&rc=676",""],[6339,"مناجاة قلب..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87891&r=&rc=3",""]],"verses":[["قلا تنكري لهفي فقد طالت السرى","وأجهد من ثقل الحديد ملازبه",0,"ب",2,0],["قَلائِدُ المَجدِ لَكُنتَ دُرَّها","نَرى الأَعادي إِن عَزَمتَ ثَغرَها",1,"ر",3,0],["قَلائِدُ في الأَعناقِ بِالعارِ لا تَهي","عَلى مَرِّ أَيّامِ الزَمانَ وَلا تَصدا",2,"د",2,0],["قَلائِدُ مِن نَظمي يَوَدُّ لِحُسنِها","قُلوبُ الأَعادي أَن تَكونَ تَرائِبا",3,"ب",2,0],["قَلَّ الصِحابُ فَإِن ظَفِر","تَ بِنِعمَةٍ كَثُرَ الصِحابُ",4,"ب",1,0],["قَلاَئِدُ فَتْحٍ هُنَّ لَكِنَّ قَدْرَهَا","تَرَفَّعَ أَنْ يُدْعَى قَلاَئِدَ عِقْيَانِ",5,"ن",1,0],["قِلاَصٌ بَرَاهَا السَّيْرُ حَتَّى كَأَنَّهَا","خَوَاطِرُ فِي فِكْرِ الْفَلاَةِ تَجُولُ",6,"ل",1,0],["قَلَّ الثَّنَاءُ عَلَيْهَا في الْوَفَاءِ بِهَا","لَوْ قُرْبَهُ مِنَ أَنْفُسِ الْقُرَبِ",7,"ب",1,0],["قَلائِلُ فِينَا وَالشُّرُورُ كَثِيرةٌ","تُقَوِّضُ مِنْ أَخْلافِنَا وَتُهْدِّمُ",8,"م",1,0],["قُلِ الْحَقَّ مَا إِنْ يَنْفَعُ النَّاسَ مِثْلُهُ","وَلَوْ بَعْدَ حِينٍ وَاتْرُكِ الزُّورَ يَنْقِمُ",9,"م",1,0],["قُلِ الْحَقَّ إِنْ يُعْجِبْ فَذَاكَ وَإِنْ يَسُوءْ","فَذَاكَ وَلاَ يَصْدُدْكَ مَا قَدْ تُجَشَّمُ",9,"م",1,0],["قِلاصاً رَحَلناهُنَّ مَن حَيثُ تَلتَقي","بِوَهبينَ فَوضى رَبرَبٍ وَنَعامِ",10,"م",1,0],["قَلائِصَ لا تَنفَكُّ تَدمى أُنوفُها","عَلى طَلَلٍ مِن عَهدِ خَرقاءَ شاعِفِ",11,"ف",1,0],["قَلائِصُ ما يُصبَحنَ إِلّا رَوافِعا","بِنا سيرَةً أَعناقُهُنَّ تَزَعزَعُ",12,"ع",1,0],["قَلائِصُ عَذَّبَت لَيلى عَلَيها","وَعَذَّبَ لَيلَها نِسعٌ وَكورُ",13,"ر",1,0],["قِلات بالخَطيطة جاوزتها","فَنَضَّ سِمالُها العينُ الذرورُ",14,"ر",1,1],["قِلاك براءةٌ وهَواك عُرٌّ","ودينُ الناس حمدُ مُذمّميكا",15,"ك",2,0],["قل اعفُ عني عثرت في عدتي","يأتك عفوي وليس ممنونا",16,"ن",2,0],["قَلَّ الثُقاتُ فَلا تَرَكنَ إِلى أَحَدٍ","فَأَسعَدُ الناسِ مَن لا يَعرِفُ الناسا",17,"س",2,1],["قل ايها الشعر معي","تبت يدا ابي لهب",18,"ب",1,0],["قُل إِذا خاطَبتَ غَيرَ المُسلِمين","لَكُمو دينٌ رَضيتُم وَلِيَ دين",19,"ن",1,0],["قُل إِذا شِئتَ صُروفٌ وَغِيَر","وَإِذا شِئتَ قَضاءٌ وَقَدَر",19,"ر",1,0],["قَلَّ الكِرامُ فَصارَ يَكثُرُ فَذُّهُم","وَلَقَد يَقِلُّ الشَيءُ حَتّى يَكثُرا",20,"ر",2,0],["قَلائِدَ لَيسَ مِن ذَهَبٍ وَلَكِن","مَواسِمَ مِن جَهَنَّمَ مَنضِجاتِ",21,"ت",1,0],["قَلائِصٌ إِذا عَلَونَ فَدفَدا","يَرمينَ بِالطَرفِ النَجاءَ الأَبعَدا",22,"د",2,0],["قِلادةٌ جالَ فيها الفِكْرُ فانتظَمَتْ","نظْمَ القلائدِ لم تَنْقُصْ ولم تَزِدِ",23,"د",1,0],["قل الحق من ربي بوصف وفائهم","فمن شاء فليؤمن ومن شاء فليكفر",24,"ر",1,0],["قَلائِدُ أَعناقِ الرِجالِ هِباتُهُ","تَرى الناسَ مِنها كَالحَمامِ المُطَوَّقِ",25,"ق",1,0],["قُلِ الحَمدُ لِلَّهِ","وَاللَهُ أَكبَر",26,"ر",1,0],["قِلاصٌ حَناهنّ الهزالُ كَأنها","حنِيّات نَبْعٍ في أكفِّ جواذِبِ",27,"ب",1,0],["قَلائِصَ ما يَقيها حَدَّ هَمّي","وَلا سَيفي غَداةَ الهَمِّ واقِ",28,"ق",1,0],["قَلَّ الغَضى لا شَكَّ في أَوطانِهِ","مِمّا حَشَدتَ إِلَيهِ مِن جَمرِ الغَضى",29,"ض",2,0],["قُلِ اللَهُمَّ غَفّارَ الخَطايا","إِلَيكَ نَتوبُ فَاِرزُقنا القُبولا",30,"ل",2,0],["قُلِ الحقَّ ما للعالمين سكينةٌ","على الأرضِ حتى يَعبدُوا الواحدَ الفردا",31,"د",2,0],["قَلائِصُ في الرُؤوسِ لَها ضُروعٌ","تَدِرُّ عَلى أَكُفِّ الحالِباتِ",32,"ت",1,0],["قَلائِصُ لَم تُسقِط جَنيناً مِنَ الوَجى","وَلَم تَدرِ ما قَرعُ الفَنيقِ وَلا الهَنا",33,"ن",2,0],["قُل أَيُّها اللائِمُ في حُبِّها","لَم تَدرِ ما وُدّي وَلا ما هَويتُ",34,"ت",1,0],["قَلائِصُ إِن حَرَّكتَ كَفّاً تَكَمَّشَت","كَأَنَّ عَلى أَكسائِها الجِنَّ تُجلِبُ",35,"ب",1,0],["قل الحقيقة لا يأ","خذنْك فيها الهلاع",36,"ع",1,0],["قَلائِصُ لا يَرْعَيْنَ عَازِبَةَ الْكَلا","وَلا يَسْتَبِقْنَ الْمَاءَ إِنْ فَاتَهَا الْعِشْرُ",37,"ر",1,0],["قِلاصٌ حَداها راكِبٌ مُتَعَمِّمٌ","هَجائِنُ قَد كادَت عَلَيهِ تَفَرَّقُ",38,"ق",1,0],["قل أنا الكذاب ، وامنحني على","حسّك الإنساني الشعبي ، مثل",39,"ل",1,0],["قل إن أتيتَ من \" الحليفة \" دارَها","ولقيِتَ شعباً للشعوب مكافحا",40,"ح",2,0],["قل إن سُئلتَ عن الجزيرة مُفصحاً","ما أشبهَ الأحفادَ بالأجداد",41,"د",1,0],["قل إن جلست مخاطبا طاغوتها","ومحاورا في بغيه جزّارها",42,"ر",3,0],["قَلاَ دِينَهُ وَکهْتَاجَ لِلشَّوْقِ إنَّهَا","عَلَى الشَّوْقِ إِخْوَانَ الْعَزَاءِ هَيُوجُ",43,"ج",1,0],["قلّ الذين اذا الملمة ازعجت","حرسوك حبا بالنفوس وصانوا",44,"ن",3,0],["قل الكرام وقد جل اللئام ولم","ترفع لا عزاز امر الحق رايات",45,"ت",1,0],["قل الكرام وقل من هو عارف","ما هم عيه وقلت العرفاء",46,"ا",2,0],["قل أجبناك فكن في أمننا","طيب القلب أميناً مثلما",47,"م",2,0],["قلائدُ فتح كان يذخرُها الدهرُ","فلما أردتَ الغزو أبرَزُها النَصرُ",48,"ر",1,1],["قلائدُ شعرى زينتْ بمديحه","وهل في قريض زانَ كاسم محمدِ",49,"د",1,0],["قلائدُ في أعناقِها ونحورِها","مفصلةٌ من لؤْلؤ وزبرْجَدِ",50,"د",1,0],["قِلاصاً إِذا رامَت خَلاصاً مِنَ السُرى","مَرَقنَ فَأَنكَرنَ الجَديلَ وَشَدقَما",51,"م",2,0],["قلاه الورى حتى الاقارب اصبحت","عقارب تسعى نحوه وأراقما",52,"م",2,0],["قَلائِصُ فِيهِنَّ الَّتِى الّتِى كِبرُ هَمِّها","أَنِينٌ وَتُذرِى الدَّمعَ بالزَّفَرَاتِ",53,"ت",1,0],["قل الوفاء فلست تعرف عاشقاً","إلا خشيت الغدر والتبديلا",54,"ل",2,0],["قَلائِدُ حَلَّيتَ صدرَ البيان","بهنَّ وَطوَّفت جيدَ العرَب",55,"ب",1,0],["قلا زِلتَ تبقَي مدّة الدهر مالكاً","ولو لم أَخَفْ عيناً لبَشَّرْتُ بالخلدْ",56,"د",1,0],["قَلَّ الصَديقُ أَخو الوَفاءِ وَأعوَزِ ال","خِلُّ الشَقوقِ وَأَينَ خِلّق مُشفِقُ",57,"ق",1,0],["قَلَّ أَن أَضرَعَ أَو أَر","كَبَ لِلأَطماعِ صَهوَه",58,"و",2,0],["قَلائِدَ حَمدٍ لَم أَزِدكَ بِنَظمِها","جَلالاً وَلَكِنّي قَضَيتُ بِها الفَرضا",59,"ض",2,0],["قُلْ إِنْ لَحَاكَ مُكَابِرٌ فِي حُبِّهَا","هِيَ جَنَّةٌ فِرْدَوْسُهَا الْكِيتَانُ",60,"ن",1,0],["قل أبعد العشق أحيا","مرة إذْ أنتَ قربي",61,"ب",2,0],["قل أَنتما من اصيحاني وَحاشيَتي","وَمن خصائص اتباعي وَمن حشمي",62,"م",2,0],["قل أَنتَ يا عَبدَ الرَحيم وكل من","واليته في ذمة لم تخفر",63,"ر",1,0],["قل أَنتَ منا عَلى ما كانَ منك فجز","عَلى الصراط وَهَذا حوضنا فرد",64,"د",1,0],["قل أَنتَ في الدارين منا لا تَخف","من بعدها يا صاحب النيابا",65,"ب",2,0],["قُل أخا الشعر ما الفناء وما البعث","وما الخلد في بديع جنانه",66,"ن",2,0],["قلا محبيه الذين اغتدوا","من خده صيد شباك الحرير",67,"ر",1,0],["قَلائدُ مِن سحر البَيان لَوَ اِنَّها","بِنا نَفَثَت أَغنَت عَن النَحو وَالصَرفِ",68,"ف",1,0],["قَلَّ أَن يُوجِفَ جَيشُ نَحوَهَا","أَو تشنّ الخَيلُ فِيهَا غَلَسَا",69,"س",2,0],["قَلّ الهوَى في العينِ منه مثْلما","يَلْقَى الأميرُ نَداهُ باسْتِقْلاله",70,"ل",2,0],["قَلائِدُه في رِقابِ الرِّجا","لِ مُعلَّقةٌ كلُّها بالمِنَن",71,"ن",1,0],["قُلْ أكرمُ الإكرام رهبانيّةٌ","فكأنها نورٌ بليلٍ أدهم",72,"م",1,0],["قُلْ أيُّها الأقصى لمَنْ وَهِمُوا:","هل تلجأُ الأغصانُ للفَأْسِ؟",73,"س",1,0],["قلائد عقيان البديع كتابه","عبارته الفصحاء تغني عن القطر",74,"ر",1,0],["قل أجبني يا ولي","دا كل وحي منه طهر",75,"ر",1,0],["قلَّ الثِّقاتُ فإن عَلِقتَ بواحدٍ","فاشدد يديك عليه فهو وحيدُ",76,"د",1,0],["قلْ إن وصلتَ لناصر الدين استمع","فِقَراً تُجمِّعُ كلَّ أنسٍ شاردِ",77,"د",1,0],["قلا قلبي فلا تسأل إذا ما","أصيب بقلبه المضنى الهنيف",78,"ف",1,0],["قلائدُ أشعارٍ أُنضَّدُ دُرَّها","اِذا نضَّدَ الأقوامُ شِعراً مِنَ الوَدْعِ",79,"ع",1,0],["قل اللهم أياما تراها","محلقة حوالينا تحوم",80,"م",1,0],["قل أين حق الحمايه","من نشر أمن وعلم",81,"م",1,0],["قُلِ اسْتَريحوا بَني الدُّنيا فمذْهَبُنا","لم يَزْحَمَنْهِمْ طَريقٌ كلُّهُ دِينُ",82,"ن",1,1],["قل إذا جئت مجلسا","وسمعت المزاح مه",83,"ه",1,1],["قِلادةُ المجدِ والعُليا صنائِعُه","وزينةُ الدّينِ والدُّنيا مَساعِيهِ",84,"ي",2,0],["قلّ الدراهم في كفيّ خليفتنا","هذا فأنفق في الأقوام ألقابا",85,"ب",2,0],["قلائدٌ مث