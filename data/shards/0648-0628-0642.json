{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[55,"يا قوم طال إلى الحجاز تشوقي","https://www.aldiwan.net/poem26223.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"مولاي مذ بعدت دياري لا تسل","https://www.aldiwan.net/poem36641.html","الكامل"],[42,"ذهب الرجال المقتدى بفعالهم","https://www.aldiwan.net/poem50227.html","الكامل"],[86,"ملك النهى لا تبعدي","https://www.aldiwan.net/poem10479.html","مجزوء الكامل"],[73,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[73,"أحمدت عاقبة الدواء","https://www.aldiwan.net/poem11922.html","مجزوء الكامل"],[93,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[72,"هنئتها خلع السيادة والتقى","https://www.aldiwan.net/poem19309.html","الكامل"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[51,"قبلته فمج في جوف فيها","https://www.aldiwan.net/poem65434.html","الخفيف"],[70,"آيات مجدك مالها تبديل","https://www.aldiwan.net/poem42766.html","الكامل"],[70,"جعل الرقاد لكي يواصل موعدا","https://www.aldiwan.net/poem42964.html","الكامل"],[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[85,"العيد هلل في ذراك وكبرا","https://www.aldiwan.net/poem6817.html","الكامل"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"كأس من الدنيا تدار","https://www.aldiwan.net/poem62885.html","مجزوء الكامل"],[85,"قف بروما وشاهد الأمر واشهد","https://www.aldiwan.net/poem63737.html","الخفيف"],[43,"صلة الهجر لي وهجر الوصال","https://www.aldiwan.net/poem10110.html","الخفيف"],[62,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[62,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[45,"رحلوا فأية عبرة لم تسكب","https://www.aldiwan.net/poem10645.html","الكامل"],[45,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[45,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[45,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[45,"قد زاد في كمدي وأضرم لوعتي","https://www.aldiwan.net/poem65588.html","الكامل"],[61,"لامت قبلك يا أخي لا باخلا","https://www.aldiwan.net/poem51287.html","الكامل"],[58,"ذهب الرجال المقتدى بفعالهم","https://www.aldiwan.net/poem31041.html","الكامل"],[97,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[97,"يا سجين الحياة أين الفرار","https://www.aldiwan.net/poem24992.html","الخفيف"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[44,"إني على ما نالني لصبور","https://www.aldiwan.net/poem30044.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[48,"منع الصوم العقارا","https://www.aldiwan.net/poem63295.html","مجزوء الرمل"],[50,"يا خليلي أصيبا أو ذرا","https://www.aldiwan.net/poem62387.html","الوافر"],[76,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55134","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43666","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117005","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[80,"أرأيتَ لنَا ولهم ظُعُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=3765",""],[99,"حزب الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=15743",""],[51,"قبَّلتْه فمجَّ في جوفِ فيها","https://www.poetsgate.com/ViewPoem.aspx?id=29575",""]],"verses":[["وَبَقيتَ طولَ الدَهرِ لا","يَجتاحُكَ الأَجَلُ الخَؤونُ",0,"ن",1,0],["وَبَقايا مِن دارِساتِ طُلولٍ","خَبَّرَتنا عَن أَهلِها الأَخبارا",1,"ر",2,0],["وَبَقيتُ أَسبَحُ في بُحورِ هَواهُمُ","ما أَحسَنَ الحالاتِ إِن لَم نَغرَقِ",2,"ق",1,0],["وَبقيّةٌ مِنْ قَوْمِ عَادٍ أُهْلِكُوا","بِبَقِيَّةِ الرِّيحِ الْعَقِيمِ وَجُدِّلُوا",3,"ل",3,0],["وبَقيتُ جِسْماً دونَ روحٍ لا تَسَلْ","عنْ حالِ أجْسامٍ بِلا أرْواحِ",4,"ح",1,0],["وَبَقيتُ في خَلَفٍ يُزَكّي بَعضُهُم","بَعضاً ليَدفَعَ مُعوِرٌ عَن مُعوِرِ",5,"ر",1,0],["وَبِقَدرِ صَبرِ المُبتَلى","طولُ المُصيبَةِ وَالقِصَر",6,"ر",1,0],["وَبَقاءُ الحُسامِ في الجَفنِ يَثني","مِنهُ بَعدَ المَضاءِ وَالتَصميمِ",7,"م",1,0],["وَبَقيتَ لِلدُنيا فَأَن","تَ دَواؤُها مِن كُلِّ داءِ",8,"ا",2,0],["وَبَقيتَ مَفدِيّاً بِنا","إِن نَحنُ جُزنا في الفِداءِ",8,"ا",2,0],["وَبِقَلْبِهِ لَوْلا أَعَادِي قَوْمِهِ","لَمْ تَتَّقِدْ يَوْماً لَظَى شَنَآنِ",9,"ن",1,0],["وبقربه من نهر بُوقٍ دارة","تَنْفي الهموم مروجها الخَضِرات",10,"ت",1,0],["وبقيت ممدوح العلا عيناً لها","ألِف الندى ولكلّ ملك كافي",11,"ي",1,0],["وبقيت للمدَّاح تجلب عيسهم","جلباً بغير بلادكم لا ينفق",12,"ق",1,0],["وَبَقائي في صِفاتي","مِن قَبيحِ السَيِّئاتِ",13,"ت",1,0],["وبقدر الغناء إذ تدّعيه","لا بحق بل باطل مدموغ",14,"غ",1,0],["وَبَقَيتَ مَجدَ الدينِ أَلفاً مِثلَهُ","وَجَنابُكَ المَأهولُ وَالمَأمولُ",15,"ل",1,0],["وَبَقَيتَ حَيّاً أَلفَ عامٍ مِثلَهُ","مُتَضاعِفاً لَكَ أَجرُهُ مُتَعَدِّدا",16,"د",2,0],["وبقيتُ في وادي الزَّمانِ","الجهْمِ أَدأَبُ في المسيرْ",17,"ر",1,0],["وبقيت في الملك السعيد مؤيدا","بالله والهادي البشير مظفَّرا",18,"ر",2,0],["وَبَقايا هَيكَلٍ مِن كَرمٍ","وَحَياةٍ أَترَعَ الأَرضَ حَياها",19,"ا",3,0],["وَبَقِيَّةُ الزُمَرِ الَّتي","كانَت تَذودُ عَنِ الذِمار",20,"ر",1,0],["وَبَقايا هَياكِلٍ وَقُصورٍ","بَينَ أَخذِ البِلى وَدَفعِ المَتانَه",21,"ن",2,0],["وَبَقايا وَقارِهِ عافَتِ النا","سَ فَصارَت رَكانَةً في الجِبالِ",22,"ل",1,0],["وبقي الملك لأعقابه","فمنهم الإحسان والعدلُ",23,"ل",1,0],["وبقين أجساداً خوالد بعدما","بليت رمائهن في أطباقها",24,"ق",3,0],["وَبَقِيَّةَ العُربِ الَّذي شَهِدَت لَهُ","أَبناءُ أُدٍّ بِالفَخارِ وَيَعرُبِ",25,"ب",1,0],["وَبَقيتَ حَتّى تَستَضيءَ بِرَأيِهِ","وَتَرى الكُهولَ الشيبَ مِن أَولادِهِ",26,"د",2,0],["وَبَقيهِ ذَمَّ الرِجالِ إِذا شا","ءَ رِجالٌ عَنِ المَعالي قُعودُ",27,"د",1,0],["وَبَقيتَ يَفديكَ الأَنامُ وَإِنَّهُ","لَيَقِلُّ لِلمَفدِيِّ قَدرُ الفادي",28,"د",2,0],["وَبَقاءُ ضَربِ الخَثعَمِيِّ وَصِنفِهِ","مِن كُلِّ مَكدودِ القَريحَةِ مُجبِلِ",29,"ل",1,0],["وبقيت لي وبقيت فيك ممتعا","بالبر والنعماء والفضل",30,"ل",1,0],["وَبَقيتُ في خَلَفٍ يَزَيِّنُ بَعضُهُم","بَعضاً لِيَدفَعَ مُعوِراً عَن مُعوِرِ",31,"ر",1,0],["وبقائي أبكي على أملٍ با","لٍ وأحنو على جريحٍ موسَّد",32,"د",1,0],["وبقاء البساط بعد الندامى","كأس سم بها يدور البوار",33,"ر",1,0],["وبقايا الظل من ركب رحل","وخيوط النور من نجم أفل",34,"ل",1,0],["وبقيتَ بقاءَ مجاهدة","وسلكتَ لكلّ عُلاً سفُنُا",35,"ن",2,0],["وبقيتَ للأعياد عيداً مبهجاً","ما لاجَ في الليل البهيم صَبَاحُ",36,"ح",1,0],["وَبَقيتُ لَولا أَنَّني في طَيِّئٍ","عَلَمٌ لَقالَ الناسُ أَنتَ جَريرُ",37,"ر",1,0],["وَبَقاءً حَتّى يَفوتَ أَبو يَع","قوبَ في سِنِّهِ أَبا يَعقوبا",38,"ب",2,0],["وَبَقَيتَ تَجتَلِبُ النُفوسَ نَفاسَةً","وَبَشاشَةً وَوُقيتَ عَينَ النافِسِ",39,"س",1,0],["وَبَقايا نَواقفٍ رخم المَو","ت عَلَيها مخضَّب الأَظفارِ",40,"ر",1,0],["وَبَقايا مِن نُؤيِ مُحتَجِزٍ","وَمصامٍ مُشَعَّثٍ وَتِدُه",41,"د",2,0],["وَبَقَّقَ في الأَرضِ غَيداقُهُ","وَساحَت سَوائِلُهُ السائِحَه",42,"ح",2,0],["وَبِقَودِ الجِيادِ تَقذِفُ بِالأَش","لاءِ شُعثاً كَأَنَّهُنَّ السَعالي",43,"ل",2,0],["وَبَقايا الأَسباطِ أَسباطِ يَعقو","بَ دارِسِ التَوراةِ وَالتابوتُ",44,"ت",1,0],["وَبَقيتُ بَعدَ مَعاشِرٍ","مِثلَ الرَديِّ تَخَلَّفا",45,"ف",2,0],["وَبَقينا في سُجونِ ال","صَومِ لِلهَمِّ أَسارى",46,"ر",2,0],["وَبَقينا في زَمانٍ مُعضِلٍ","يَشرَبُ الصَفوَ وَيُبقي الكَدَرا",47,"ر",2,0],["وبقيّةٌ في الحصنِ أُرتجَ دونَهمْ","بابُ السلامةِ أيَّما إرتاجِ",48,"ج",1,0],["وبقايا النيرانِ في الموقدِ الدَّا","بل تبكي الحياةَ في الأرماقِ",49,"ق",1,0],["وبقيثارةِ السَّكينةِ في ك","فَّيْكَ تَنْهَلُّ رَنَّةُ المَكْروبِ",50,"ب",1,0],["وَبُقْيَا عَلَى قَلْبِي فَلَوْ لَمْ يَكُنْ بِهِ","سِوَى حُبِّ عَبْدِ اللَّهِ كَانَ لَهُ عُذْرُ",51,"ر",1,0],["وَبِقدْرِ مَا أَصْفَيْتُمُوهُ حُبَّكُمْ","زِيدُوا مَفاخِرَ ذِكْرِهِ بِمَفَاخِرِ",52,"ر",1,0],["وَبِقيِتَ وَحْدَكَ بَعْدَهُ رَجُلاً فَسُدْ","وَارْعَ النِّسَاءَ وَدَبِّرِ الأَطْفَالاَ",53,"ل",2,0],["وَبِقَدْرِ مَا تَرْبُو فَضَا","ئِلُ نَشْئِهَا فَالمَجْدُ رَابِ",54,"ب",1,0],["وَبَقَيْتَ مَرْفُوعَ المَكَانَةِ","هَانِئاً فِي كُلِّ حَالِ",55,"ل",1,0],["وَبَقيتُ توبِقُني البَوائِقُ بَعدَهُ","وَالدَهرُ لَو أَبقاهُ لي أَنجى بِهِ",56,"ه",1,0],["وبقيتَ وحدك فوق هذا","الصخر وقفة عنفوانْ!",57,"ن",1,0],["وبقيتُ في خلَفٍ يُزَيِّنُ بعضُهم","بعضا ليأخذ معورٌ من معورِ",58,"ر",1,0],["وبقلبي إليك ألف عتاب","وحوار وحين ألقاك أخجل",59,"ل",1,0],["وبِقِيعَانٍ هَبَطْتَ بِها","وبما شَاهَدْتَ مِنْ مُدُن",60,"ن",1,0],["وبِقَلْبٍ شَفَّهُ وَلَهٌ","حافِظٍ لِلْعَهْدِ لم يَخُن",60,"ن",1,0],["وبقلبي إليك شهر سأروي","ه وشعر في خاطري ليس يروي",61,"و",2,0],["وبقيتَ بقاءَ مجاهدة","وسلكتَ لكلّ عُلى ً سُفُنا",62,"ن",2,0],["وبقطّةِ البيت السوداء، مِثْلي..","إذا كان الوطنُ ممنوعاً من ارتكاب الكتابة مثلي..",63,"ي",1,0],["وبقدر الغناءِ إذا تدَّعيه","لا بحقٍّ بل باطل مدْمُوغ",64,"غ",1,0]]}