wan.net/poem50165.html","الطويل"],[409,"هذي ديارهم عفت وتفرقوا","https://www.aldiwan.net/poem31674.html","عموديه"],[409,"حيا ربوعك من ربى ومنازل","https://www.aldiwan.net/poem31851.html","الكامل"],[409,"أصبحت لا أشكو الخطوب وإنما","https://www.aldiwan.net/poem31855.html","الكامل"],[409,"يا ثانيا للنفس وهو","https://www.aldiwan.net/poem32283.html","مجزوء الكامل"],[416,"ناشداها عن فؤادي وسلاها","https://www.aldiwan.net/poem53959.html","الطويل"],[416,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[416,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[416,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[416,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[421,"يا قلب زرت وما انطوى ذاك الجوى","https://www.aldiwan.net/poem46393.html","الكامل"],[432,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[441,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[452,"ما آل برمك في ذرى بغداد","https://www.aldiwan.net/poem13714.html","الكامل"],[452,"لا زلت مسعود الصباح","https://www.aldiwan.net/poem13835.html","مجزوء الكامل"],[458,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[458,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[458,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[458,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[461,"أذنت لك العلياء نازحها","https://www.aldiwan.net/poem15363.html","أحذ الكامل"],[461,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[461,"يا جوادا محرزا سبق العلى","https://www.aldiwan.net/poem16137.html","الرمل"],[464,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[464,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[464,"حال من دونك يا أخت الكلل","https://www.aldiwan.net/poem3613.html","عموديه"],[468,"يا شريف الأغراس والأغراق","https://www.aldiwan.net/poem59811.html","الخفيف"],[482,"غين بين المحو قد بان","https://www.aldiwan.net/poem24417.html","عموديه"],[483,"لمن الديار عفون بالجزع","https://www.aldiwan.net/poem2073.html","أحذ الكامل"],[495,"حرج على الأيام إن لم تحرج","https://www.aldiwan.net/poem9803.html","الكامل"],[500,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[500,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[500,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[500,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[500,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[515,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[515,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[515,"أسماء ملك تحتها لك مقعد","https://www.aldiwan.net/poem12059.html","الكامل"],[515,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[515,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[515,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[529,"يا من له من ذهنه","https://www.aldiwan.net/poem37411.html","مجزوء الكامل"],[529,"يا ناظم الدرر البهية أشرقت","https://www.aldiwan.net/poem37539.html","الكامل"],[538,"الطالبون واتصل","https://www.aldiwan.net/poem47417.html","عموديه"],[538,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[538,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[538,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[538,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[544,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[544,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[551,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[551,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[553,"ذهب في ذهب راح","https://www.aldiwan.net/poem68235.html","مجزوء الرمل"],[553,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"صدق الكتاب لمن به يتمسك","https://www.aldiwan.net/poem34273.html","الكامل"],[558,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[558,"سق مطاياك بالحدا يا حادي","https://www.aldiwan.net/poem34596.html","الخفيف"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[575,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[575,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"]],"verses":[["وَبَقيتَ طولَ الدَهرِ لا","يَجتاحُكَ الأَجَلُ الخَؤونُ",0,"ن",1,0],["وَبَقايا مِن دارِساتِ طُلولٍ","خَبَّرَتنا عَن أَهلِها الأَخبارا",1,"ر",2,0],["وَبَقيتُ أَسبَحُ في بُحورِ هَواهُمُ","ما أَحسَنَ الحالاتِ إِن لَم نَغرَقِ",2,"ق",1,0],["وَبقيّةٌ مِنْ قَوْمِ عَادٍ أُهْلِكُوا","بِبَقِيَّةِ الرِّيحِ الْعَقِيمِ وَجُدِّلُوا",3,"ل",3,0],["وبَقيتُ جِسْماً دونَ روحٍ لا تَسَلْ","عنْ حالِ أجْسامٍ بِلا أرْواحِ",4,"ح",1,0],["وَبَقيتُ في خَلَفٍ يُزَكّي بَعضُهُم","بَعضاً ليَدفَعَ مُعوِرٌ عَن مُعوِرِ",5,"ر",1,0],["وَبِقَدرِ صَبرِ المُبتَلى","طولُ المُصيبَةِ وَالقِصَر",6,"ر",1,0],["وَبَقاءُ الحُسامِ في الجَفنِ يَثني","مِنهُ بَعدَ المَضاءِ وَالتَصميمِ",7,"م",1,0],["وَبَقيتَ لِلدُنيا فَأَن","تَ دَواؤُها مِن كُلِّ داءِ",8,"ا",2,0],["وَبَقيتَ مَفدِيّاً بِنا","إِن نَحنُ جُزنا في الفِداءِ",8,"ا",2,0],["وَبِقَلْبِهِ لَوْلا أَعَادِي قَوْمِهِ","لَمْ تَتَّقِدْ يَوْماً لَظَى شَنَآنِ",9,"ن",1,0],["وبقربه من نهر بُوقٍ دارة","تَنْفي الهموم مروجها الخَضِرات",10,"ت",1,0],["وبقيت ممدوح العلا عيناً لها","ألِف الندى ولكلّ ملك كافي",11,"ي",1,0],["وبقيت للمدَّاح تجلب عيسهم","جلباً بغير بلادكم لا ينفق",12,"ق",1,0],["وَبَقائي في صِفاتي","مِن قَبيحِ السَيِّئاتِ",13,"ت",1,0],["وبقدر الغناء إذ تدّعيه","لا بحق بل باطل مدموغ",14,"غ",1,0],["وَبَقَيتَ مَجدَ الدينِ أَلفاً مِثلَهُ","وَجَنابُكَ المَأهولُ وَالمَأمولُ",15,"ل",1,0],["وَبَقَيتَ حَيّاً أَلفَ عامٍ مِثلَهُ","مُتَضاعِفاً لَكَ أَجرُهُ مُتَعَدِّدا",16,"د",2,0],["وبقيتُ في وادي الزَّمانِ","الجهْمِ أَدأَبُ في المسيرْ",17,"ر",1,0],["وبقيت في الملك السعيد مؤيدا","بالله والهادي البشير مظفَّرا",18,"ر",2,0],["وَبَقايا هَيكَلٍ مِن كَرمٍ","وَحَياةٍ أَترَعَ الأَرضَ حَياها",19,"ا",3,0],["وَبَقِيَّةُ الزُمَرِ الَّتي","كانَت تَذودُ عَنِ الذِمار",20,"ر",1,0],["وَبَقايا هَياكِلٍ وَقُصورٍ","بَينَ أَخذِ البِلى وَدَفعِ المَتانَه",21,"ن",2,0],["وَبَقايا وَقارِهِ عافَتِ النا","سَ فَصارَت رَكانَةً في الجِبالِ",22,"ل",1,0],["وبقي الملك لأعقابه","فمنهم الإحسان والعدلُ",23,"ل",1,0],["وبقين أجساداً خوالد بعدما","بليت رمائهن في أطباقها",24,"ق",3,0],["وَبَقِيَّةَ العُربِ الَّذي شَهِدَت لَهُ","أَبناءُ أُدٍّ بِالفَخارِ وَيَعرُبِ",25,"ب",1,0],["وَبَقيتَ حَتّى تَستَضيءَ بِرَأيِهِ","وَتَرى الكُهولَ الشيبَ مِن أَولادِهِ",26,"د",2,0],["وَبَقيهِ ذَمَّ الرِجالِ إِذا شا","ءَ رِجالٌ عَنِ المَعالي قُعودُ",27,"د",1,0],["وَبَقيتَ يَفديكَ الأَنامُ وَإِنَّهُ","لَيَقِلُّ لِلمَفدِيِّ قَدرُ الفادي",28,"د",2,0],["وَبَقاءُ ضَربِ الخَثعَمِيِّ وَصِنفِهِ","مِن كُلِّ مَكدودِ القَريحَةِ مُجبِلِ",29,"ل",1,0],["وبقيت لي وبقيت فيك ممتعا","بالبر والنعماء والفضل",30,"ل",1,0],["وَبَقيتُ في خَلَفٍ يَزَيِّنُ بَعضُهُم","بَعضاً لِيَدفَعَ مُعوِراً عَن مُعوِرِ",31,"ر",1,0],["وبقائي أبكي على أملٍ با","لٍ وأحنو على جريحٍ موسَّد",32,"د",1,0],["وبقاء البساط بعد الندامى","كأس سم بها يدور البوار",33,"ر",1,0],["وبقايا الظل من ركب رحل","وخيوط النور من نجم أفل",34,"ل",1,0],["وبقيتَ بقاءَ مجاهدة","وسلكتَ لكلّ عُلاً سفُنُا",35,"ن",2,0],["وبقيتَ للأعياد عيداً مبهجاً","ما لاجَ في الليل البهيم صَبَاحُ",36,"ح",1,0],["وَبَقيتُ لَولا أَنَّني في طَيِّئٍ","عَلَمٌ لَقالَ الناسُ أَنتَ جَريرُ",37,"ر",1,0],["وَبَقاءً حَتّى يَفوتَ أَبو يَع","قوبَ في سِنِّهِ أَبا يَعقوبا",38,"ب",2,0],["وَبَقَيتَ تَجتَلِبُ النُفوسَ نَفاسَةً","وَبَشاشَةً وَوُقيتَ عَينَ النافِسِ",39,"س",1,0],["وَبَقايا نَواقفٍ رخم المَو","ت عَلَيها مخضَّب الأَظفارِ",40,"ر",1,0],["وَبَقايا مِن نُؤيِ مُحتَجِزٍ","وَمصامٍ مُشَعَّثٍ وَتِدُه",41,"د",2,0],["وَبَقَّقَ في الأَرضِ غَيداقُهُ","وَساحَت سَوائِلُهُ السائِحَه",42,"ح",2,0],["وَبِقَودِ الجِيادِ تَقذِفُ بِالأَش","لاءِ شُعثاً كَأَنَّهُنَّ السَعالي",43,"ل",2,0],["وَبَقايا الأَسباطِ أَسباطِ يَعقو","بَ دارِسِ التَوراةِ وَالتابوتُ",44,"ت",1,0],["وَبَقيتُ بَعدَ مَعاشِرٍ","مِثلَ الرَديِّ تَخَلَّفا",45,"ف",2,0],["وَبَقينا في سُجونِ ال","صَومِ لِلهَمِّ أَسارى",46,"ر",2,0],["وَبَقينا في زَمانٍ مُعضِلٍ","يَشرَبُ الصَفوَ وَيُبقي الكَدَرا",47,"ر",2,0],["وبقيّةٌ في الحصنِ أُرتجَ دونَهمْ","بابُ السلامةِ أيَّما إرتاجِ",48,"ج",1,0],["وبقايا النيرانِ في الموقدِ الدَّا","بل تبكي الحياةَ في الأرماقِ",49,"ق",1,0],["وبقيثارةِ السَّكينةِ في ك","فَّيْكَ تَنْهَلُّ رَنَّةُ المَكْروبِ",50,"ب",1,0],["وَبُقْيَا عَلَى قَلْبِي فَلَوْ لَمْ يَكُنْ بِهِ","سِوَى حُبِّ عَبْدِ اللَّهِ كَانَ لَهُ عُذْرُ",51,"ر",1,0],["وَبِقدْرِ مَا أَصْفَيْتُمُوهُ حُبَّكُمْ","زِيدُوا مَفاخِرَ ذِكْرِهِ بِمَفَاخِرِ",52,"ر",1,0],["وَبِقيِتَ وَحْدَكَ بَعْدَهُ رَجُلاً فَسُدْ","وَارْعَ النِّسَاءَ وَدَبِّرِ الأَطْفَالاَ",53,"ل",2,0],["وَبِقَدْرِ مَا تَرْبُو فَضَا","ئِلُ نَشْئِهَا فَالمَجْدُ رَابِ",54,"ب",1,0],["وَبَقَيْتَ مَرْفُوعَ المَكَانَةِ","هَانِئاً فِي كُلِّ حَالِ",55,"ل",1,0],["وَبَقيتُ توبِقُني البَوائِقُ بَعدَهُ","وَالدَهرُ لَو أَبقاهُ لي أَنجى بِهِ",56,"ه",1,0],["وبقيتَ وحدك فوق هذا","الصخر وقفة عنفوانْ!",57,"ن",1,0],["وبقيتُ في خلَفٍ يُزَيِّنُ بعضُهم","بعضا ليأخذ معورٌ من معورِ",58,"ر",1,0],["وبقلبي إليك ألف عتاب","وحوار وحين ألقاك أخجل",59,"ل",1,0],["وبِقِيعَانٍ هَبَطْتَ بِها","وبما شَاهَدْتَ مِنْ مُدُن",60,"ن",1,0],["وبِقَلْبٍ شَفَّهُ وَلَهٌ","حافِظٍ لِلْعَهْدِ لم يَخُن",60,"ن",1,0],["وبقلبي إليك شهر سأروي","ه وشعر في خاطري ليس يروي",61,"و",2,0],["وبقيتَ بقاءَ مجاهدة","وسلكتَ لكلّ عُلى ً سُفُنا",62,"ن",2,0],["وبقلبي رضوان يهفو لمرآك","وندّى سريرتي جبريل",63,"ل",1,0],["وبقطّةِ البيت السوداء، مِثْلي..","إذا كان الوطنُ ممنوعاً من ارتكاب الكتابة مثلي..",64,"ي",1,0],["وبقدر الغناءِ إذا تدَّعيه","لا بحقٍّ بل باطل مدْمُوغ",65,"غ",1,0],["وَبَقية الصَحب الكِرا","م أَولي الثَنا المُتَأرجِ",66,"ج",1,0],["وَبَقيت ما أَبدى مَديحك شاعِرٌ","وَتَلاهُ مَحفوظاً مِن التَحريف",67,"ف",1,0],["وَبَقيتُما رَيحانَتين بِرَوضَةٍ","هِيَ غَرس مَجدٍ جاءَ مِن جديكُما",68,"م",2,0],["وبقطع حبل من بني الدنيا ووص","ل القصد في ساحاته بصفاء",69,"ا",2,0],["وبَقايا مِنْ دُمُوعٍ سُكِبَتْ","فوقَ ثَوْبٍ أَثَرِيٍّ عَفِنِ",70,"ن",1,0],["وبقلبي من عشيات الحمى","ذكريات في حناياه تلح",71,"ح",1,0],["وبقلب عنوان العروبة","والحجا سكن الوتين",72,"ن",1,0],["وبقى لساني وحدَه لي زاجرا","هيهات لا غَلَبَ الجماعةَ واحُد",73,"د",1,0],["وَبَقيتَ ما شِئتَ البَقاءَ لِمُنكِرٍ","تَمتازُ عَنهُ وَسُؤدُدٍ تَمتازُهُ",74,"ه",1,0],["وَبَقيتَ ما مَتَعَ النَهارُ مُمَتَّعاً","بِهِما وَدامَ بِكَ الزَمانُ مُمَتَّعا",75,"ع",2,0],["وَبِقُربِكَ اِنقَشَعَت غَمائِمُ لَم يَزَل","ماءُ الحَياةِ بِهِنَّ غَيرَ زُلالِ",76,"ل",1,0],["وَبَقيتَ لِلمَولى الَّذي شَرُفَت بِهِ","أَيّامُهُ وَتَطاوَلَت أَزمانُهُ",77,"ن",2,0],["وبِقلَّة الصَّبر البري","ءِ وكثرة الشوقِ المريبِ",78,"ب",1,0],["وبقت تعاطيني حديث ذللت","في مسمعي قطوفه تذليلا",79,"ل",2,0],["وبقتلهم أمر الأَله وأوجبته","على لسان المرسلين شريعة",80,"ه",1,0],["وبقدر ما يزدادُ في الحبِّ الفتى","يزدادُ منه على الحبيب حِذارُ",81,"ر",1,0],["وَبَقِيَّةُ المالِ المُحرَّزِ قِسمَةٌ","أَرَّثتَهُ في أَعبُدٍ وَإِماءِ",82,"ا",2,0],["وَبَقاءُ الدُّنا بِقاؤُكَ لا طا","لَ لِمَن يَشتَهي رداكَ بقاءُ",83,"ا",2,0],["وَبِقَوسِكُم في كُلِّ يَومٍ أَرتَمي","وَبِسَيفِكُم في كُلِّ يَومٍ أُضرَبُ",84,"ب",1,0],["وَبَقيتَ مَعمورَ الجَنابِ مُؤَيّداً","ما قامَ داعٍ بِالصَّلاةِ يُثَوِّبُ",84,"ب",1,0],["وَبَقيتَ لِلمَعرُوفِ أَيضاً وَالعُلا","أَبَداً بَقاءَهُما ثَبيرَ وَيَذبُلا",85,"ل",2,0],["وَبَقيتَ ما بَقِيَ الزَمانُ مُخَلَّداً","في حَيثُ تَقعُدُ وَالأَنامُ قِيامُ",86,"م",1,0],["وبقيتَ ما بقي الزمانُ مكرما","وثَناك مكتوبٌ على جَبَهاته",87,"ت",2,0],["وبقي دونه المنى","والمنى مثل حدسه",88,"س",2,0],["وَبِقلبي مُستقرٌّ حبّه","بِهواهُ لم أزل أعمرهُ",89,"ه",1,0],["وَبِقلبي وَقالبي كلّ داءٍ","شفَّ روحي وأنتَ أنت الشفاءُ",90,"ا",2,0],["وَبَقيتُ حَتّى ما أُسائَلُ عالِماً","عَن عِلم واحِدَةٍ لِكَي أَزدادَها",91,"د",3,0],["وبقَلبي داءٌ وفي النفسِ ما فيها","وعاثَ الضنى بجسمي النحيلِ",92,"ل",1,0],["وبقيتَ زيناً للبلادِ ورِفْعَةً","إنَّ الصوارمَ زينةُ الأغماد",93,"د",1,0],["وبقيتُ يعذلني المنامُ بصدِّهِ","ويسومني التبريحُ في إذلالهِ",94,"ل",2,0],["وبقيتُ أَنظر شاخصاً","نظَرَ المُنازِع للماتِ",95,"ت",1,0],["وبقيتَ ما بقيَ الزَّما","نُ أميرَ عزٍّ واقتدارِ",96,"ر",1,0],["وبقي عظمي ولحمي مع دمي","وعروقي في انتقاص وانتحال",97,"ل",1,0],["وبقيت محروس الجناب ولم يزل","يزهو بمرآك الزمان ويزهر",98,"ر",1,0],["وبقيت ما بقي الزمان ولم تزل","تولي النوال وسحب جودك مرتجي",99,"ج",2,0],["وبقيت للنعم التي لي طوقت","ما بات يسجع في الرياض مطوّق",100,"ق",1,0],["وبقيت ما بقي الزمان ولم تزل","في نعمة ومسرة وهناء",101,"ا",2,0],["وبقيت محروس الجناب مؤيدا","والدهر عبد والزمان غلام",102,"م",1,0],["وبقيت بالافراح مسروراً على","غيظ الحسود ورغم كل مداحي",103,"ي",1,0],["وبقيت بالرأي المسدد رافلاً","في نعمة ابوابها لا تغلق",104,"ق",1,0],["وَبَقايا من المعرّي تَمَشَّت","في دماه لَم تَمحُها الأَزمانُ",105,"ن",1,0],["وَبقَوسِ حاجبِها وسهم لحاظِها","ربخَصرها وَقَوامِها وَالجيد",106,"د",1,0],["وبقيت مسلوب القرين بلا","عدد أسر به ولا عدد",107,"د",1,0],["وَبَقاؤُهُ غَضّاً جَديداً رائِقاً","بِالحُسنِ لِلأَبصارِ وَالآذانِ",108,"ن",1,0],["وَبِقَبرِهِ المَلِكُ الكَريمُ مُوَكَّلٌ","لِيُبَلِّغَ التَسليمَ لِلبُعدانِ",108,"ن",1,0],["وَبَقيتَ تَنتَسِفُ العَدُ","وَ بَريحِ إِقبالٍ عَصوفِ",109,"ف",1,0],["وَبَقيتَ ما رَكَدَ النَسيمُ","وَهَبَّتِ الهوجُ العَواصِف",110,"ف",1,0],["وَبَقيتَ ما غ