ا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[409,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[432,"خود من الروم في أعطافها لين","https://www.aldiwan.net/poem40080.html","البسيط"],[435,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[435,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[435,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[440,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[440,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[440,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[442,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[460,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[463,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[466,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[466,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[470,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[470,"الطل من فوق الشقيق","https://www.aldiwan.net/poem59801.html","مجزوء الكامل"],[470,"ستائر الأوراق منصوبة","https://www.aldiwan.net/poem59807.html","السريع"],[470,"قد راق هذا الزمان من كدره","https://www.aldiwan.net/poem60082.html","المنسرح"],[470,"الزهر مطوي ومنشور","https://www.aldiwan.net/poem60116.html","المنسرح"],[470,"الراح قد صاغ المزا","https://www.aldiwan.net/poem60434.html","مجزوء الكامل"],[484,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[484,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[502,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[502,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[517,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[560,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[560,"الله يفتح كل باب مغلق","https://www.aldiwan.net/poem34332.html","الكامل"],[560,"الروح كالريح إن جازت شذا النطف","https://www.aldiwan.net/poem34341.html","البسيط"],[577,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[577,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[588,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"],[643,"","https://poetry.dctabudhabi.ae/diwan/poem/104189","المنسرح"],[765,"","https://poetry.dctabudhabi.ae/diwan/poem/31498","الوافر"]],"verses":[["فالجِسمُ مِن لُؤلُؤٍ وَالشَعرُ مِن ظُلَمٍ","وَالنَشرُ مِن مِسكَةٍ وَالوَجهُ مِن نورِ",0,"ر",1,0],["فَالْجَوُّ بِالقُطْبَيْنِ طِرْسٌ دَائِرٌ","وَالبَرْقُ أَسْرَعُ مَا تَرَى مِرْقَمِ",1,"م",1,0],["فالجزير الكل دارك","وإليك هيت مشيرا",2,"ر",2,0],["فالجود إلاّ من يديك مُقتّر","والغيثُ إلاّ من نَداك مُبَخِّلُ",3,"ل",1,0],["فالجيش تَلتَهِم النيران أنفسه","وقائد الجيش لاهٍ في مَجانته",4,"ت",2,0],["فالجوّ فيه منيرة أوضاحه","والحسن فيه دقيقه كجليله",5,"ل",2,0],["فالجار ليس بآمن من جاره","والخِلّ ليس بواثق بخليله",5,"ل",2,0],["فَالجَوسَقُ المَيمونِ فَال","سُقيا بِها فَالنَهرُ أَعلى",6,"ل",2,0],["فالجوّ تصدح بالمحامد عجمهُ","والتربُ تنطقُ بالثنا خرساؤه",7,"ا",3,0],["فالجَدّ بالجدِّ مُؤْتَمٌّ يُماثِلُه","والرأْيُ بالرأي في نقْض وتَوْكيدِ",8,"د",1,0],["فَالجَهلُ أَنّى كانَ فَهوَ عُقوبَةٌ","وَالعِلمُ أَنّى كانَ كانَ ثَوابا",9,"ب",2,0],["فَالجَوُّ مِمّا فاضَ مِن أَرواحِهِم","لا تَستَبينُ نُجومُهُ عَينانِ",10,"ن",1,0],["فالجِسْمُ أَضْحَى في الصَّعيدِ مُوَزَّعاً","والرَّأْسُ أَمْسَى في الصِّعادِ كَريما",11,"م",2,0],["فالجَدُّ إنْ ساعدَ نالَ الفَتَى","بُغْيَتَه من حيثُ لا يَدرِي",12,"ر",2,0],["فَالجَوُّ كابي الأَوراقِ أَكلَفُها","وَالماءُ طَرقٌ نَميرُهُ كَدِرُه",13,"ر",2,0],["فالجَوُّ مِنها في لظىً","والأرضُ منها في مَناهِل",14,"ل",1,0],["فَالجَيشُ وَالنَقعُ تَحتَ الجونِ مُرتَكِمٌ","في ظِلِّ مُرتَكِمٍ في ظِلِّ مُرتَكِمِ",15,"م",1,0],["فألجمتُهُ بالمزج حتى وَجَدْتُهُ","بما شحّ من حُسنِ الرياضةِ يسمحُ",16,"ح",1,0],["فَالجودُ حَيٌّ ما حَييتَ وَإِن تَمُت","غاضَت مَناهِلُهُ وَماتَ الجودُ",17,"د",1,0],["فَالجَوُّ جَوّي إِن أَقَمتَ بِغِبطَةٍ","وَالأَرضُ أَرضي وَالسَماءُ سَمائي",18,"ا",2,0],["فالجاهلونَ بنو كلابٍ عندَهُمْ","واليومَ أهلُ الفضلِ آلُ يسارِ",19,"ر",1,0],["فالجسرُ عن جانبيه خفقُ أشرِعةٍ","رفّافةٍ في أعالي الجو كالطررِ",20,"ر",1,0],["فَالجاهِليَّةُ خَيرٌ مِن إِباحَتِهِم","سَجيَّةَ الحارِثِ الحَرّابِ أَو حُجُرِ",21,"ر",1,0],["فَالجِنحُ أَخضَرُ كَالسُدوسِ تَخالُهُ","مِن حَيَّةٍ خَضراءَ غُشِّيَ سُندُسا",22,"س",2,0],["فَالجِسمُ إِن زايَلَتهُ الروحُ صارَ لَقىً","كَلّاً عَلى القَومِ ما فيهِ مِنَ الضَخَمِ",23,"م",1,0],["فَالجُمُدُ الحافِظُ الطَريقَ مِنَ ال","زَيغِ فَصَحنُ الشَقيقِ فَالأُمُلُ",24,"ل",1,0],["فَأَلْجَمْتُهُ مِنْ بَعْدِ جَهْدٍ وقَدْ أَتَى","مِنَ الأَرْضِ دُونَ الوَحْشِ غَيْبٌ مُجاهِلُهْ",25,"ل",2,0],["فَالْجَوُّ قَدْ باحَ بِمَكْنُونِهِ","وَالأَرْضُ قَدْ أَنْجَزَتِ الْمَوْعِدَا",26,"د",2,0],["فالجود من كرم الفتى","والمَطْلُ دَاءٌ في اليَدِ",27,"د",1,0],["فالجو كابي الأرواق أكلفها","والماء طرق نميره كدره",28,"ر",2,0],["فألجمتُهُ حتى وَجَدْتُهُ","بما شحّ من حسن الرياضة يسمح",29,"ح",1,0],["فالجوّ مّما من أرواحهم","لا تستبين نجومه عينان",30,"ن",1,0],["فالجهل أنّي كان فهو عقوية ،","والعلم أنّى كان كان ثوابا",31,"ب",2,0],["فَالجسم يَبرأ بِالعِلاج سَقامهُ","وَشَفا النُفوس صَداقة الخِلّان",32,"ن",1,0],["فَالجَوّ راقَ كَأَنَّما","صَقَلتهُ أَنفاس النَسيم",33,"م",1,0],["فالجيد منك فجر","والوجه زبرقان",34,"ن",1,0],["فالجأ لدولة عزه يا صاح إن","خفت العدا وشماته الحساد",35,"د",1,0],["فالجيدُ يَزْهُو بالقلا","ئِد واللآلى والدرَر",36,"ر",1,0],["فالجسم منه في تهامةَ نازلٌ","والقلبُ منه غائبٌ في نجده",37,"د",2,0],["فَالجودُ وَالعَدلُ مَفروضٌ وَمُتَّبَعٌ","وَالجَورُ وَالبُخلُ مَرفوضٌ وَمُجتَنَبُ",38,"ب",1,0],["فَالجَورُ قَد أَلغاهُ مَن لَم يُلغِهِ","وَالحَقُّ مُعتَرِفٌ بِهِ مَن أَنكَرا",39,"ر",2,0],["فَالجودُ إِلّا مِن يَدَيكَ مُصَرَّدٌ","وَالظَنُّ إِلّا في نَداكَ مُرَجَّمُ",40,"م",1,0],["فالجو برَّاق الشُّعاع مفضض","والماء فياض الأتيّ معسجد",41,"د",1,0],["فأَلْجمتُه عَضْبَ الغِرارين كاسرا","هو الموتُ لولا أنْ يقال حديد",42,"د",1,0],["فالجامع الاموي اصبح يزدهي","ومن الجمال عليه عظم رونق",43,"ق",1,0],["فالجمر في وجنتيه","مما عليه خلعتُ",44,"ت",1,0],["فالجود من قرنائه والحمد من","أسمائه والشكر من أقواله",45,"ل",2,0],["فَالجَمالُ الَّذي يَسيلُ عَلَينا","ما طَفا مِثلهُ عَلى أَحداقِ",46,"ق",1,0],["فَالجنينُ الَّذي دفنّاهُ بِالأَمسِ","اِجعَليهِ في سِرٍّ صَدرِك قَبرا",47,"ر",2,0],["فالجُود ليس بمستطاب طعمُه","إلا إذا لم يُتعب السُّؤَّالا",48,"ل",2,0],["فالجسم بان وأودى","وروحه فيك يجري",49,"ر",2,0],["فالجوّ ملتحِف بُسْطاً مفوَّفةً","كأنهن اختلافُ الوشي والحَبَر",50,"ر",1,0],["فَالجَوهَرُ الباقي هُوَ ال","إِحسانُ وَالدُنيا عَرَض",51,"ض",1,0],["فَأَلجَأَهُ شَفّانُ قَطرٍ وَحاصِبٌ","بِصَحراءَ مَرتٍ غَيرِ ذاتِ مُعَرَّسِ",52,"س",1,0],["فالجنّة والنار اندرجا","في برّهما وعقوقهما",53,"م",2,0],["فالجامِعُ الأمويُّ يجمَعُ أُمَّةً","لأذانِهِ فيها دويُّ الرّاعد",54,"د",1,0],["فَالجِسرُ جِسرُ اِبنِ شَواسٍ فَنَيرَبُها","تَحلو مَعانيهِ لا تَخلو مَغانيهِ",55,"ي",2,0],["فَالجَلابيبُ القَشيباتُ مِنَ ال","عِلمِ مِن بَعدِكَ أَسمالٌ بَوالي",56,"ل",2,0],["فَالجِذعُ لي جُمّارُهُ وَالعَظمُ غُض","روفٌ بِهِ لينٌ وَكانَ الأَصلَبا",57,"ب",2,0],["فَالجَيشُ مِثلُ كُعوبِ الرُمحِ مُطَّرِداً","وَهوَ السِنانُ أَمامَ الجَحفَلِ اللَجِبِ",58,"ب",1,0],["فالجيادُ العِتاقُ لا تَبلغُ الغا","يةَ حتّى تستصحبَ الأفلاءَ",59,"ا",2,0],["فَالجودُ إِن آمَنوا وَإِن شَكَروا","وَالقَهرُ إِن كَذَبوا وَإِن كَفَروا",60,"ر",3,0],["فَالجهلُ وَالتقليدُ ضربةُ لازبٍ","أَبداً عليه فأيّ حكمٍ يقطعُ",61,"ع",1,0],["فالجُودُ والصّبرُ وجَمعُ الفتَى","شَمْلَ بني الجِنْسِ بنُعْماه",62,"ا",2,0],["فالجاهلانِ اثْنانِ من بَيْنِ الورَى","فافْطُنْ أُخَيَّ وإنْ هما لم يَفْطُنا",63,"ن",2,0],["فالجوُّ طولَ اليومِ تبرٌ ماطرٌ","والتُربُ طولَ العام مِسْكٌ أذْفَر",64,"ر",1,0],["فالجيشُ فَضْلٌ إذن","للمُلْكِ يَومَ الطِّراد",65,"د",1,0],["فالجودُ فِعْلٌ واحدٌ وبه","لك شاكرانِ العَبْدُ والرَّبّ",66,"ب",1,0],["فالجوهر الممدوح تعلن حسنَه","فخراً وقبحُ العار يُخفيه الخجل",67,"ل",1,0],["فالجهل يخفض شأن كل ممنَّعٍ","والعلمُ يَرفَع كل من لم يُرفَع",68,"ع",1,0],["فالجري في الأرض الكُلام","يُبلي الفتى بالعطبِ",69,"ب",1,0],["فالجهل يدركه الحكيم لأنه","قد كان قدماً جاهلاً خطّاء",70,"ا",2,0],["فالجَوُّ مُنبَجسٌ بالنورِ مَفرِقُهُ","والأَرضُ قد بَسَمَت عَن ثَغر لَمياءِ",71,"ا",2,0],["فالجهل أولى من علو","م للمعاصي لا تذود",72,"د",1,0],["فالجِسمُ مِنهُ مُنحَفٌ","وَالحالُ زائِدَةٌ القصور",73,"ر",1,0],["فالجود مِن فَضلٍ لَدَيهِ مُشرِّق","أَبَداً وَمال في البِلادِ مغربِ",74,"ب",1,0],["فالجود من كفه الفياض منطلقٌ","والخير في قوله الفصال مرهونُ",75,"ن",1,0],["فالجَوُّ مكسُوَّةٌ جَوانِبُهُ","بالنَّقْعِ والجُرْدُ فيه مُنْجَرِدَه",76,"د",2,0],["فالجِزْع فالمُنحنَى فبُرقة تَيْ","ماءَ فَوادي الأراكِ فاللّبَبِ",77,"ب",1,0],["فالجوّ في مِسكيّةِ الغيمِ انبرى","والأرضُ في موشيّةِ الأزهارِ",78,"ر",1,0],["فالجوى لم يبق من بعد النى","فضلة يلحظها الناظر مني",79,"ن",2,0],["فالجود في عرصاتها والأمن في","أبوابها بالفضل والإكرام",80,"م",1,0],["فالجود أعشار فجزء في الورى","ولديه تلك التسعة الأجزاء",81,"ا",2,0],["فالجَوُّ من فحواهُ مِسكٌ فائِحٌ","والأَرْضُ من يُمْناهُ روضٌ يانِعُ",82,"ع",1,0],["فالجيرةُ الجيرةُ وال","أنعم منهم أنعمُ",83,"م",1,0],["فالجارُ والجاني وسائلُهُ","لهمُ بمَشْرِعِ فَضْلهِ نَهَلُ",84,"ل",1,0],["فالجدُ إلا فيهِ بات مذمَّماً","والصَّبر إلاَّ عنهُ أصبح هيِنّا",85,"ن",2,0],["فالجسمُ في ثوب السَّقام له لقى","والقلبُ في قيد الهموم به رسفْ",86,"ف",1,0],["فَالجيزَةُ الحَسناءُ في حُلَّةٍ","مِن حُلُلِ الخَيرِيِّ تِبرِيَّه",87,"ي",2,0],["فَالجُلَّنارُ كَأَنَّهُ","في الإِحمِرارُ أَخو الخَلوقِ",88,"ق",1,0],["فَالجَوُّ في عاتِقِ نَفّاطِهِ","زَرّاقَةٌ نيرانُها البَرقُ",89,"ق",1,0],["فَالجَوُّ في خَزِّهِ وَمُصمَتِهِ","وَالرَوضُ في وَشيِهِ وَفي حِبَرِه",90,"ر",2,0],["فَالجَوُّ قَد أَصبَحَ خُلدِيُّهُ","بِطانَةً وَالغَيمُ سَمّورُ",91,"ر",1,0],["فَالجُلَّنارُ خَلوقُهُ","قَد غابَ في مِسكِ الضَبابِ",92,"ب",1,0],["فالجسم منهمك من نغمة الهمم","والجفن منهمر من جرحة الودج",93,"ج",1,0],["فالجسم في سفر بالطيف وحور","والجفن منهمر من حرقة الودج",93,"ج",1,0],["فالجيد جيد وإني أقتفي أثرا","من أجلها وهلال الأفق منمحق",94,"ق",1,0],["فالجأ إليه يربط قلبٍ إن بغى","باغٍ وربُّك يخلق الأنصارا",95,"ر",2,0],["فالجأ لنا واحفظ صميم عهودنا","ما ثم بابٌ للنبي سوانا",96,"ن",2,0],["فالجور والبخل والإلحاد منصدع","والعدل والجود والإيمان ملتئم",97,"م",1,0],["فالجأ إليه وكن به متمسكاً","وليستَوِ الإسرار والإعلان",98,"ن",1,0],["فالجأ إليه وكن به متعلقاً","لا فاز من هو ليس بالمتعلق",99,"ق",1,0],["فالجأ إلى الله إن رمت النجاة بها","واسلك سبيل أولي التقوى ولا تقف",100,"ف",1,0],["فالجِيدُ أَحسنُ ما يكون لمسمَعٍ","أَضحى بجوهرِه النفيسُ مُزَيَّنَا",101,"ن",2,0],["فالجسمُ والعينانِ من لَثْمها","والضَّمُّ تحتَ القُفْلِ والختْمِ",102,"م",1,0],["فَالجِسْمُ مُذْ غِبْتُمُ بِالسّفْحِ مُتّشِحٌ","وَالقلبُ مُضْطَرِبٌ بالشَّوْقِ مُضْطَرِمُ",103,"م",1,0],["فالجسرُ فالقصرانِ فالنهرَ المُريدُ","بين النخيل والأجمِ",104,"م",1,0],["فَأَلجَمَها فَأَرسَلَها عَلَيهِ","وَوَلّى وَهُوَ مُنتَفِدٌ بَعيدُ",105,"د",1,0]]}