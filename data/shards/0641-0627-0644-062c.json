30",""],[5717,"فالجأ لواجب الوجود واستبن","https://www.poetsgate.com/ViewPoem.aspx?id=170600",""],[5723,"امواج نمردت على البحر","https://www.poetsgate.com/ViewPoem.aspx?id=180950",""],[402,"عد لابسا ثوب الخلود وعلم","https://www.poetsgate.com/ViewPoem.aspx?id=36321",""],[5785,"لا رعى الله من بالجفا والهجر شار","https://www.poetsgate.com/ViewPoem.aspx?id=131574",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[5853,"العاشق الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=188361",""],[5906,"دع عنك أجواء الغرور","https://www.poetsgate.com/ViewPoem.aspx?id=188018",""],[5906,"سَمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188806",""],[5906,"آمال نافقة","https://www.poetsgate.com/ViewPoem.aspx?id=188823",""],[5939,"مهلك","https://www.poetsgate.com/ViewPoem.aspx?id=178591",""],[5956,"أدعو إلهي أن يعيدك هانئاً","https://www.poetsgate.com/ViewPoem.aspx?id=194106",""],[5956,"لا أقبل ما يرفضه عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=194413",""],[5956,"رضيعٌ يزحف كسُلْحُفاةٍ حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=205158",""],[5992,"الثلجُ يسقطُ في أثنائِه بَرَدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=41809",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[5309,"زار الهوى زهر الربى الأغيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573748",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[5126,"الطائف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87785&r=&rc=0",""]],"verses":[["فالجِسمُ مِن لُؤلُؤٍ وَالشَعرُ مِن ظُلَمٍ","وَالنَشرُ مِن مِسكَةٍ وَالوَجهُ مِن نورِ",0,"ر",1,0],["فَالْجَوُّ بِالقُطْبَيْنِ طِرْسٌ دَائِرٌ","وَالبَرْقُ أَسْرَعُ مَا تَرَى مِرْقَمِ",1,"م",1,0],["فالجزير الكل دارك","وإليك هيت مشيرا",2,"ر",2,0],["فالجود إلاّ من يديك مُقتّر","والغيثُ إلاّ من نَداك مُبَخِّلُ",3,"ل",1,0],["فالجيش تَلتَهِم النيران أنفسه","وقائد الجيش لاهٍ في مَجانته",4,"ت",2,0],["فالجوّ فيه منيرة أوضاحه","والحسن فيه دقيقه كجليله",5,"ل",2,0],["فالجار ليس بآمن من جاره","والخِلّ ليس بواثق بخليله",5,"ل",2,0],["فَالجَوسَقُ المَيمونِ فَال","سُقيا بِها فَالنَهرُ أَعلى",6,"ل",2,0],["فالجوّ تصدح بالمحامد عجمهُ","والتربُ تنطقُ بالثنا خرساؤه",7,"ا",3,0],["فالجَدّ بالجدِّ مُؤْتَمٌّ يُماثِلُه","والرأْيُ بالرأي في نقْض وتَوْكيدِ",8,"د",1,0],["فَالجَهلُ أَنّى كانَ فَهوَ عُقوبَةٌ","وَالعِلمُ أَنّى كانَ كانَ ثَوابا",9,"ب",2,0],["فَالجَوُّ مِمّا فاضَ مِن أَرواحِهِم","لا تَستَبينُ نُجومُهُ عَينانِ",10,"ن",1,0],["فالجِسْمُ أَضْحَى في الصَّعيدِ مُوَزَّعاً","والرَّأْسُ أَمْسَى في الصِّعادِ كَريما",11,"م",2,0],["فالجَدُّ إنْ ساعدَ نالَ الفَتَى","بُغْيَتَه من حيثُ لا يَدرِي",12,"ر",2,0],["فَالجَوُّ كابي الأَوراقِ أَكلَفُها","وَالماءُ طَرقٌ نَميرُهُ كَدِرُه",13,"ر",2,0],["فالجَوُّ مِنها في لظىً","والأرضُ منها في مَناهِل",14,"ل",1,0],["فَالجَيشُ وَالنَقعُ تَحتَ الجونِ مُرتَكِمٌ","في ظِلِّ مُرتَكِمٍ في ظِلِّ مُرتَكِمِ",15,"م",1,0],["فألجمتُهُ بالمزج حتى وَجَدْتُهُ","بما شحّ من حُسنِ الرياضةِ يسمحُ",16,"ح",1,0],["فَالجودُ حَيٌّ ما حَييتَ وَإِن تَمُت","غاضَت مَناهِلُهُ وَماتَ الجودُ",17,"د",1,0],["فَالجَوُّ جَوّي إِن أَقَمتَ بِغِبطَةٍ","وَالأَرضُ أَرضي وَالسَماءُ سَمائي",18,"ا",2,0],["فالجاهلونَ بنو كلابٍ عندَهُمْ","واليومَ أهلُ الفضلِ آلُ يسارِ",19,"ر",1,0],["فالجسرُ عن جانبيه خفقُ أشرِعةٍ","رفّافةٍ في أعالي الجو كالطررِ",20,"ر",1,0],["فَالجاهِليَّةُ خَيرٌ مِن إِباحَتِهِم","سَجيَّةَ الحارِثِ الحَرّابِ أَو حُجُرِ",21,"ر",1,0],["فَالجِنحُ أَخضَرُ كَالسُدوسِ تَخالُهُ","مِن حَيَّةٍ خَضراءَ غُشِّيَ سُندُسا",22,"س",2,0],["فَالجِسمُ إِن زايَلَتهُ الروحُ صارَ لَقىً","كَلّاً عَلى القَومِ ما فيهِ مِنَ الضَخَمِ",23,"م",1,0],["فَالجُمُدُ الحافِظُ الطَريقَ مِنَ ال","زَيغِ فَصَحنُ الشَقيقِ فَالأُمُلُ",24,"ل",1,0],["فَأَلْجَمْتُهُ مِنْ بَعْدِ جَهْدٍ وقَدْ أَتَى","مِنَ ال