ة الدوافع من","https://www.aldiwan.net/poem45255.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[50,"عجِّلْ أَبَا مُحمَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21814",""],[45,"تفتأ عجبا بالشيء تدكره","https://www.poetsgate.com/ViewPoem.aspx?id=31188",""],[80,"وأشقر من خيل الدنان وكبته","https://www.poetsgate.com/ViewPoem.aspx?id=3062",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[91,"تحيّة الشام","https://www.poetsgate.com/ViewPoem.aspx?id=53441",""],[110,"سعدت دمشق بطالع الشعراني","https://www.aldiwan.net/poem16211.html","الكامل"],[110,"أدر المدامة يا نديمي","https://www.aldiwan.net/poem16378.html","مجزوء الكامل"],[116,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[116,"لمعت بوارق دولة الإرشاد","https://www.aldiwan.net/poem41762.html","الكامل"],[129,"سمعا وطوعا للإمام","https://www.aldiwan.net/poem50606.html","مجزوء الكامل"],[129,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[144,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[144,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[144,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[151,"نعم الإله بشكره تتقيد","https://www.aldiwan.net/poem68454.html","الكامل"],[186,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[211,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[212,"ما عبقر بقدير أن يصوغ هوى","https://www.aldiwan.net/poem46581.html","البسيط"],[223,"قمر تجلى في سماء كماله","https://www.aldiwan.net/poem55413.html","الكامل"],[224,"أحبها وأحبته","https://www.aldiwan.net/poem39717.html","الخفيف"],[224,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[230,"يأيها الملك المصفى جوهرا","https://www.aldiwan.net/poem50837.html","الكامل"],[230,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[230,"أما ترى حركات الريح مخبرة","https://www.aldiwan.net/poem51115.html","الخفيف"],[236,"يا سيدا هو عدتي","https://www.aldiwan.net/poem31896.html","مجزوء الكامل"],[250,"أمن دمنة عادية لم تأنس","https://www.aldiwan.net/poem2113.html","الطويل"],[260,"دن للأبوين وبرهما","https://www.aldiwan.net/poem35826.html","المتدارك"],[271,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[283,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[283,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[283,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[283,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[304,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[305,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[365,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[365,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[365,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[365,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[365,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[378,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[378,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[378,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[378,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[378,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[404,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[407,"شهر غدا مشتهرا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[407,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[430,"خود من الروم في أعطافها لين","https://www.aldiwan.net/poem40080.html","البسيط"],[433,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[433,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[433,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[438,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[438,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[438,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[440,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[459,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[462,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[465,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[469,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[469,"الطل من فوق الشقيق","https://www.aldiwan.net/poem59801.html","مجزوء الكامل"],[469,"ستائر الأوراق منصوبة","https://www.aldiwan.net/poem59807.html","السريع"],[469,"قد راق هذا الزمان من كدره","https://www.aldiwan.net/poem60082.html","المنسرح"],[469,"الزهر مطوي ومنشور","https://www.aldiwan.net/poem60116.html","المنسرح"],[469,"الراح قد صاغ المزا","https://www.aldiwan.net/poem60434.html","مجزوء الكامل"],[483,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[483,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[501,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[501,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[516,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[559,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[559,"الله يفتح كل باب مغلق","https://www.aldiwan.net/poem34332.html","الكامل"],[559,"الروح كالريح إن جازت شذا النطف","https://www.aldiwan.net/poem34341.html","البسيط"],[576,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[576,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[587,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"]],"verses":[["فالجِسمُ مِن لُؤلُؤٍ وَالشَعرُ مِن ظُلَمٍ","وَالنَشرُ مِن مِسكَةٍ وَالوَجهُ مِن نورِ",0,"ر",1,0],["فَالْجَوُّ بِالقُطْبَيْنِ طِرْسٌ دَائِرٌ","وَالبَرْقُ أَسْرَعُ مَا تَرَى مِرْقَمِ",1,"م",1,0],["فالجزير الكل دارك","وإليك هيت مشيرا",2,"ر",2,0],["فالجود إلاّ من يديك مُقتّر","والغيثُ إلاّ من نَداك مُبَخِّلُ",3,"ل",1,0],["فالجيش تَلتَهِم النيران أنفسه","وقائد الجيش لاهٍ في مَجانته",4,"ت",2,0],["فالجوّ فيه منيرة أوضاحه","والحسن فيه دقيقه كجليله",5,"ل",2,0],["فالجار ليس بآمن من جاره","والخِلّ ليس بواثق بخليله",5,"ل",2,0],["فَالجَوسَقُ المَيمونِ فَال","سُقيا بِها فَالنَهرُ أَعلى",6,"ل",2,0],["فالجوّ تصدح بالمحامد عجمهُ","والتربُ تنطقُ بالثنا خرساؤه",7,"ا",3,0],["فالجَدّ بالجدِّ مُؤْتَمٌّ يُماثِلُه","والرأْيُ بالرأي في نقْض وتَوْكيدِ",8,"د",1,0],["فَالجَهلُ أَنّى كانَ فَهوَ عُقوبَةٌ","وَالعِلمُ أَنّى كانَ كانَ ثَوابا",9,"ب",2,0],["فَالجَوُّ مِمّا فاضَ مِن أَرواحِهِم","لا تَستَبينُ نُجومُهُ عَينانِ",10,"ن",1,0],["فالجِسْمُ أَضْحَى في الصَّعيدِ مُوَزَّعاً","والرَّأْسُ أَمْسَى في الصِّعادِ كَريما",11,"م",2,0],["فالجَدُّ إنْ ساعدَ نالَ الفَتَى","بُغْيَتَه من حيثُ لا يَدرِي",12,"ر",2,0],["فَالجَوُّ كابي الأَوراقِ أَكلَفُها","وَالماءُ طَرقٌ نَميرُهُ كَدِرُه",13,"ر",2,0],["فالجَوُّ مِنها في لظىً","والأرضُ منها في مَناهِل",14,"ل",1,0],["فَالجَيشُ وَالنَقعُ تَحتَ الجونِ مُرتَكِمٌ","في ظِلِّ مُرتَكِمٍ في ظِلِّ مُرتَكِمِ",15,"م",1,0],["فألجمتُهُ بالمزج حتى وَجَدْتُهُ","بما شحّ من حُسنِ الرياضةِ يسمحُ",16,"ح",1,0],["فَالجودُ حَيٌّ ما حَييتَ وَإِن تَمُت","غاضَت مَناهِلُهُ وَماتَ الجودُ",17,"د",1,0],["فَالجَوُّ جَوّي إِن أَقَمتَ بِغِبطَةٍ","وَالأَرضُ أَرضي وَالسَماءُ سَمائي",18,"ا",2,0],["فالجاهلونَ بنو كلابٍ عندَهُمْ","واليومَ أهلُ الفضلِ آلُ يسارِ",19,"ر",1,0],["فالجسرُ عن جانبيه خفقُ أشرِعةٍ","رفّافةٍ في أعالي الجو كالطررِ",20,"ر",1,0],["فَالجاهِليَّةُ خَيرٌ مِن إِباحَتِهِم","سَجيَّةَ الحارِثِ الحَرّابِ أَو حُجُرِ",21,"ر",1,0],["فَالجِنحُ أَخضَرُ كَالسُدوسِ تَخالُهُ","مِن حَيَّةٍ خَضراءَ غُشِّيَ سُندُسا",22,"س",2,0],["فَالجِسمُ إِن زايَلَتهُ الروحُ صارَ لَقىً","كَلّاً عَلى القَومِ ما فيهِ مِنَ الضَخَمِ",23,"م",1,0],["فَالجُمُدُ الحافِظُ الطَريقَ مِنَ ال","زَيغِ فَصَحنُ الشَقيقِ فَالأُمُلُ",24,"ل",1,0],["فَالْجَوُّ قَدْ باحَ بِمَكْنُونِهِ","وَالأَرْضُ قَدْ أَنْجَزَتِ الْمَوْعِدَا",25,"د",2,0],["فالجود من كرم الفتى","والمَطْلُ دَاءٌ في اليَدِ",26,"د",1,0],["فالجو كابي الأرواق أكلفها","والماء طرق نميره كدره",27,"ر",2,0],["فألجمتُهُ حتى وَجَدْتُهُ","بما شحّ من حسن الرياضة يسمح",28,"ح",1,0],["فالجوّ مّما من أرواحهم","لا تستبين نجومه عينان",29,"ن",1,0],["فالجهل أنّي كان فهو عقوية ،","والعلم أنّى كان كان ثوابا",30,"ب",2,0],["فَالجسم يَبرأ بِالعِلاج سَقامهُ","وَشَفا النُفوس صَداقة الخِلّان",31,"ن",1,0],["فَالجَوّ راقَ كَأَنَّما","صَقَلتهُ أَنفاس النَسيم",32,"م",1,0],["فالجيد منك فجر","والوجه زبرقان",33,"ن",1,0],["فالجأ لدولة عزه يا صاح إن","خفت العدا وشماته الحساد",34,"د",1,0],["فالجيدُ يَزْهُو بالقلا","ئِد واللآلى والدرَر",35,"ر",1,0],["فالجسم منه في تهامةَ نازلٌ","والقلبُ منه غائبٌ في نجده",36,"د",2,0],["فَالجودُ وَالعَدلُ مَفروضٌ وَمُتَّبَعٌ","وَالجَورُ وَالبُخلُ مَرفوضٌ وَمُجتَنَبُ",37,"ب",1,0],["فَالجَورُ قَد أَلغاهُ مَن لَم يُلغِهِ","وَالحَقُّ مُعتَرِفٌ بِهِ مَن أَنكَرا",38,"ر",2,0],["فَالجودُ إِلّا مِن يَدَيكَ مُصَرَّدٌ","وَالظَنُّ إِلّا في نَداكَ مُرَجَّمُ",39,"م",1,0],["فالجو برَّاق الشُّعاع مفضض","والماء فياض الأتيّ معسجد",40,"د",1,0],["فأَلْجمتُه عَضْبَ الغِرارين كاسرا","هو الموتُ لولا أنْ يقال حديد",41,"د",1,0],["فالجامع الاموي اصبح يزدهي","ومن الجمال عليه عظم رونق",42,"ق",1,0],["فالجمر في وجنتيه","مما عليه خلعتُ",43,"ت",1,0],["فالجود من قرنائه والحمد من","أسمائه والشكر من أقواله",44,"ل",2,0],["فَالجَمالُ الَّذي يَسيلُ عَلَينا","ما طَفا مِثلهُ عَلى أَحداقِ",45,"ق",1,0],["فَالجنينُ الَّذي دفنّاهُ بِالأَمسِ","اِجعَليهِ في سِرٍّ صَدرِك قَبرا",46,"ر",2,0],["فالجُود ليس بمستطاب طعمُه","إلا إذا لم يُتعب السُّؤَّالا",47,"ل",2,0],["فالجسم بان وأودى","وروحه فيك يجري",48,"ر",2,0],["فالجوّ ملتحِف بُسْطاً مفوَّفةً","كأنهن اختلافُ الوشي والحَبَر",49,"ر",1,0],["فَالجَوهَرُ الباقي هُوَ ال","إِحسانُ وَالدُنيا عَرَض",50,"ض",1,0],["فَأَلجَأَهُ شَفّانُ قَطرٍ وَحاصِبٌ","بِصَحراءَ مَرتٍ غَيرِ ذاتِ مُعَرَّسِ",51,"س",1,0],["فالجنّة والنار اندرجا","في برّهما وعقوقهما",52,"م",2,0],["فالجامِعُ الأمويُّ يجمَعُ أُمَّةً","لأذانِهِ فيها دويُّ الرّاعد",53,"د",1,0],["فَالجِسرُ جِسرُ اِبنِ شَواسٍ فَنَيرَبُها","تَحلو مَعانيهِ لا تَخلو مَغانيهِ",54,"ي",2,0],["فَالجَلابيبُ القَشيباتُ مِنَ ال","عِلمِ مِن بَعدِكَ أَسمالٌ بَوالي",55,"ل",2,0],["فَالجِذعُ لي جُمّارُهُ وَالعَظمُ غُض","روفٌ بِهِ لينٌ وَكانَ الأَصلَبا",56,"ب",2,0],["فَالجَيشُ مِثلُ كُعوبِ الرُمحِ مُطَّرِداً","وَهوَ السِنانُ أَمامَ الجَحفَلِ اللَجِبِ",57,"ب",1,0],["فالجيادُ العِتاقُ لا تَبلغُ الغا","يةَ حتّى تستصحبَ الأفلاءَ",58,"ا",2,0],["فَالجودُ إِن آمَنوا وَإِن شَكَروا","وَالقَهرُ إِن كَذَبوا وَإِن كَفَروا",59,"ر",3,0],["فَالجهلُ وَالتقليدُ ضربةُ لازبٍ","أَبداً عليه فأيّ حكمٍ يقطعُ",60,"ع",1,0],["فالجُودُ والصّبرُ وجَمعُ الفتَى","شَمْلَ بني الجِنْسِ بنُعْماه",61,"ا",2,0],["فالجاهلانِ اثْنانِ من بَيْنِ الورَى","فافْطُنْ أُخَيَّ وإنْ هما لم يَفْطُنا",62,"ن",2,0],["فالجوُّ طولَ اليومِ تبرٌ ماطرٌ","والتُربُ طولَ العام مِسْكٌ أذْفَر",63,"ر",1,0],["فالجيشُ فَضْلٌ إذن","للمُلْكِ يَومَ الطِّراد",64,"د",1,0],["فالجودُ فِعْلٌ واحدٌ وبه","لك شاكرانِ العَبْدُ والرَّبّ",65,"ب",1,0],["فالجوهر الممدوح تعلن حسنَه","فخراً وقبحُ العار يُخفيه الخجل",66,"ل",1,0],["فالجهل يخفض شأن كل ممنَّعٍ","والعلمُ يَرفَع كل من لم يُرفَع",67,"ع",1,0],["فالجري في الأرض الكُلام","يُبلي الفتى بالعطبِ",68,"ب",1,0],["فالجهل يدركه الحكيم لأنه","قد كان قدماً جاهلاً خطّاء",69,"ا",2,0],["فالجَوُّ مُنبَجسٌ بالنورِ مَفرِقُهُ","والأَرضُ قد بَسَمَت عَن ثَغر لَمياءِ",70,"ا",2,0],["فالجهل أولى من علو","م للمعاصي لا تذود",71,"د",1,0],["فالجِسمُ مِنهُ مُنحَفٌ","وَالحالُ زائِدَةٌ القصور",72,"ر",1,0],["فالجود مِن فَضلٍ لَدَيهِ مُشرِّق","أَبَداً وَمال في البِلادِ مغربِ",73,"ب",1,0],["فالجود من كفه الفياض منطلقٌ","والخير في قوله الفصال مرهونُ",74,"ن",1,0],["فالجَوُّ مكسُوَّةٌ جَوانِبُهُ","بالنَّقْعِ والجُرْدُ فيه مُنْجَرِدَه",75,"د",2,0],["فالجِزْع فالمُنحنَى فبُرقة تَيْ","ماءَ فَوادي الأراكِ فاللّبَبِ",76,"ب",1,0],["فالجوّ في مِسكيّةِ الغيمِ انبرى","والأرضُ في موشيّةِ الأزهارِ",77,"ر",1,0],["فالجوى لم يبق من بعد النى","فضلة يلحظها الناظر مني",78,"ن",2,0],["فالجود في عرصاتها والأمن في","أبوابها بالفضل والإكرام",79,"م",1,0],["فالجود أعشار فجزء في الورى","ولديه تلك التسعة الأجزاء",80,"ا",2,0],["فالجَوُّ من فحواهُ مِسكٌ فائِحٌ","والأَرْضُ من يُمْناهُ روضٌ يانِعُ",81,"ع",1,0],["فالجيرةُ الجيرةُ وال","أنعم منهم أنعمُ",82,"م",1,0],["فالجارُ والجاني وسائلُهُ","لهمُ بمَشْرِعِ فَضْلهِ نَهَلُ",83,"ل",1,0],["فالجدُ إلا فيهِ بات مذمَّماً","والصَّبر إلاَّ عنهُ أصبح هيِنّا",84,"ن",2,0],["فالجسمُ في ثوب السَّقام له لقى","والقلبُ في قيد الهموم به رسفْ",85,"ف",1,0],["فَالجيزَةُ الحَسناءُ في حُلَّةٍ","مِن حُلُلِ الخَيرِيِّ تِبرِيَّه",86,"ي",2,0],["فَالجُلَّنارُ كَأَنَّهُ","في الإِحمِرارُ أَخو الخَلوقِ",87,"ق",1,0],["فَالجَوُّ في عاتِقِ نَفّاطِهِ","زَرّاقَةٌ نيرانُها البَرقُ",88,"ق",1,0],["فَالجَوُّ في خَزِّهِ وَمُصمَتِهِ","وَالرَوضُ في وَشيِهِ وَفي حِبَرِه",89,"ر",2,0],["فَالجَوُّ قَد أَصبَحَ خُلدِيُّهُ","بِطانَةً وَالغَيمُ سَمّورُ",90,"ر",1,0],["فَالجُلَّنارُ خَلوقُهُ","قَد غابَ في مِسكِ الضَبابِ",91,"ب",1,0],["فالجسم منهمك من نغمة الهمم","والجفن منهمر من جرحة الودج",92,"ج",1,0],["فالجسم في سفر بالطيف وحور","والجفن منهمر من حرقة الودج",92,"ج",1,0],["فالجيد جيد وإني أقتفي أثرا","من أجلها وهلال الأفق منمحق",93,"ق",1,0],["فالجأ إليه يربط قلبٍ إن بغى","باغٍ وربُّك يخلق الأنصارا",94,"ر",2,0],["فالجأ لنا واحفظ صميم عهودنا","ما ثم بابٌ للنبي سوانا",95,"ن",2,0],["فالجور والبخل والإلحاد منصدع","والعدل والجود والإيمان ملتئم",96,"م",1,0],["فالجأ إليه وكن به متمسكاً","وليستَوِ الإسرار والإعلان",97,"ن",1,0],["فالجأ إليه وكن به متعلقاً","لا فاز من هو ليس بالمتعلق",98,"ق",1,0],["فالجأ إلى الله إن رمت النجاة بها","واسلك سبيل أولي التقوى ولا تقف",99,"ف",1,0],["فالجِيدُ أَحسنُ ما يكون لمسمَعٍ","أَضحى بجوهرِه النفيسُ مُزَيَّنَا",100,"ن",2,0],["فالجسمُ والعينانِ من لَثْمها","والضَّمُّ تحتَ القُفْلِ والختْمِ",101,"م",1,0],["فَالجِسْمُ مُذْ غِبْتُمُ بِالسّفْحِ مُتّشِحٌ","وَالقلبُ مُضْطَرِبٌ بالشَّوْقِ مُضْطَرِمُ",102,"م",1,0]]}