{"poems":[[55,"إني طربت إلى شمس إذا طلعت","https://www.aldiwan.net/poem26368.html","البسيط"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[88,"يا موطنا ما انتضيناها مهندة","https://www.aldiwan.net/poem44465.html","البسيط"],[88,"إن العراق بعرضه وبطوله","https://www.aldiwan.net/poem44817.html","الكامل"],[47,"قف في رسوم المستجا","https://www.aldiwan.net/poem25172.html","مجزوء الكامل"],[72,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[51,"يا ابن الوزيرين وابن السادة الصيد","https://www.aldiwan.net/poem10866.html","البسيط"],[91,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[56,"أصبحت ملقى في الفراش سقيما","https://www.aldiwan.net/poem58506.html","الكامل"],[62,"لا تجزعن إن فات ما رمته","https://www.aldiwan.net/poem52423.html","السريع"],[45,"تفتأ عجبا بالشيء تدكره","https://www.aldiwan.net/poem63626.html","المنسرح"],[61,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[80,"وأشقر من خيل الدنان ركبته","https://www.aldiwan.net/poem31512.html","الطويل"],[44,"غنى فشاقك طائر غريد","https://www.aldiwan.net/poem30528.html","الكامل"],[44,"يا موضع الشدنية الوجناء","https://www.aldiwan.net/poem30593.html","الكامل"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[90,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[46,"فعلت فعل تجار مخسرين به","https://www.aldiwan.net/poem22667.html","البسيط"],[46,"القدس لم يفرض عليك مزاره","https://www.aldiwan.net/poem22814.html","الكامل"],[46,"إن طاب خيمك في الدنيا فلا تخم","https://www.aldiwan.net/poem23386.html","البسيط"],[15,"أقفر من مية الدوافع من","https://www.aldiwan.net/poem45255.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[50,"عجِّلْ أَبَا مُحمَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21814",""],[45,"تفتأ عجبا بالشيء تدكره","https://www.poetsgate.com/ViewPoem.aspx?id=31188",""],[80,"وأشقر من خيل الدنان وكبته","https://www.poetsgate.com/ViewPoem.aspx?id=3062",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[107,"سعدت دمشق بطالع الشعراني","https://www.aldiwan.net/poem16211.html","الكامل"],[107,"أدر المدامة يا نديمي","https://www.aldiwan.net/poem16378.html","مجزوء الكامل"],[113,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[113,"لمعت بوارق دولة الإرشاد","https://www.aldiwan.net/poem41762.html","الكامل"],[126,"سمعا وطوعا للإمام","https://www.aldiwan.net/poem50606.html","مجزوء الكامل"],[126,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[141,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[141,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[141,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[148,"نعم الإله بشكره تتقيد","https://www.aldiwan.net/poem68454.html","الكامل"],[183,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[208,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[209,"ما عبقر بقدير أن يصوغ هوى","https://www.aldiwan.net/poem46581.html","البسيط"],[220,"قمر تجلى في سماء كماله","https://www.aldiwan.net/poem55413.html","الكامل"],[221,"أحبها وأحبته","https://www.aldiwan.net/poem39717.html","الخفيف"],[221,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[227,"يأيها الملك المصفى جوهرا","https://www.aldiwan.net/poem50837.html","الكامل"],[227,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[227,"أما ترى حركات الريح مخبرة","https://www.aldiwan.net/poem51115.html","الخفيف"],[233,"يا سيدا هو عدتي","https://www.aldiwan.net/poem31896.html","مجزوء الكامل"],[247,"أمن دمنة عادية لم تأنس","https://www.aldiwan.net/poem2113.html","الطويل"],[257,"دن للأبوين وبرهما","https://www.aldiwan.net/poem35826.html","المتدارك"],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[280,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[280,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[280,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[280,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[301,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[302,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[362,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[362,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[362,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[362,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[362,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[374,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[374,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[374,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[374,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[374,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[400,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[403,"شهر غدا مشتهرا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[403,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[426,"خود من الروم في أعطافها لين","https://www.aldiwan.net/poem40080.html","البسيط"],[429,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[429,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[429,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[434,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[434,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[434,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[436,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[456,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[459,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[462,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[466,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[466,"الطل من فوق الشقيق","https://www.aldiwan.net/poem59801.html","مجزوء الكامل"],[466,"ستائر الأوراق منصوبة","https://www.aldiwan.net/poem59807.html","السريع"],[466,"قد راق هذا الزمان من كدره","https://www.aldiwan.net/poem60082.html","المنسرح"],[466,"الزهر مطوي ومنشور","https://www.aldiwan.net/poem60116.html","المنسرح"],[466,"الراح قد صاغ المزا","https://www.aldiwan.net/poem60434.html","مجزوء الكامل"],[480,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[480,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[498,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[498,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[513,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[556,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[556,"الله يفتح كل باب مغلق","https://www.aldiwan.net/poem34332.html","الكامل"],[556,"الروح كالريح إن جازت شذا النطف","https://www.aldiwan.net/poem34341.html","البسيط"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[584,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"]],"verses":[["فالجِسمُ مِن لُؤلُؤٍ وَالشَعرُ مِن ظُلَمٍ","وَالنَشرُ مِن مِسكَةٍ وَالوَجهُ مِن نورِ",0,"ر",1,0],["فَالْجَوُّ بِالقُطْبَيْنِ طِرْسٌ دَائِرٌ","وَالبَرْقُ أَسْرَعُ مَا تَرَى مِرْقَمِ",1,"م",1,0],["فالجزير الكل دارك","وإليك هيت مشيرا",2,"ر",2,0],["فالجود إلاّ من يديك مُقتّر","والغيثُ إلاّ من نَداك مُبَخِّلُ",3,"ل",1,0],["فالجيش تَلتَهِم النيران أنفسه","وقائد الجيش لاهٍ في مَجانته",4,"ت",2,0],["فالجوّ فيه منيرة أوضاحه","والحسن فيه دقيقه كجليله",5,"ل",2,0],["فالجار ليس بآمن من جاره","والخِلّ ليس بواثق بخليله",5,"ل",2,0],["فَالجَوسَقُ المَيمونِ فَال","سُقيا بِها فَالنَهرُ أَعلى",6,"ل",2,0],["فالجوّ تصدح بالمحامد عجمهُ","والتربُ تنطقُ بالثنا خرساؤه",7,"ا",3,0],["فالجَدّ بالجدِّ مُؤْتَمٌّ يُماثِلُه","والرأْيُ بالرأي في نقْض وتَوْكيدِ",8,"د",1,0],["فَالجَهلُ أَنّى كانَ فَهوَ عُقوبَةٌ","وَالعِلمُ أَنّى كانَ كانَ ثَوابا",9,"ب",2,0],["فَالجَوُّ مِمّا فاضَ مِن أَرواحِهِم","لا تَستَبينُ نُجومُهُ عَينانِ",10,"ن",1,0],["فالجِسْمُ أَضْحَى في الصَّعيدِ مُوَزَّعاً","والرَّأْسُ أَمْسَى في الصِّعادِ كَريما",11,"م",2,0],["فالجَدُّ إنْ ساعدَ نالَ الفَتَى","بُغْيَتَه من حيثُ لا يَدرِي",12,"ي",1,0],["فَالجَوُّ كابي الأَوراقِ أَكلَفُها","وَالماءُ طَرقٌ نَميرُهُ كَدِرُه",13,"ر",2,0],["فالجَوُّ مِنها في لظىً","والأرضُ منها في مَناهِل",14,"ل",1,0],["فَالجَيشُ وَالنَقعُ تَحتَ الجونِ مُرتَكِمٌ","في ظِلِّ مُرتَكِمٍ في ظِلِّ مُرتَكِمِ",15,"م",1,0],["فألجمتُهُ بالمزج حتى وَجَدْتُهُ","بما شحّ من حُسنِ الرياضةِ يسمحُ",16,"ح",1,0],["فَالجودُ حَيٌّ ما حَييتَ وَإِن تَمُت","غاضَت مَناهِلُهُ وَماتَ الجودُ",17,"د",1,0],["فَالجَوُّ جَوّي إِن أَقَمتَ بِغِبطَةٍ","وَالأَرضُ أَرضي وَالسَماءُ سَمائي",18,"ا",2,0],["فالجاهلونَ بنو كلابٍ عندَهُمْ","واليومَ أهلُ الفضلِ آلُ يسارِ",19,"ر",1,0],["فالجسرُ عن جانبيه خفقُ أشرِعةٍ","رفّافةٍ في أعالي الجو كالطررِ",20,"ر",1,0],["فَالجاهِليَّةُ خَيرٌ مِن إِباحَتِهِم","سَجيَّةَ الحارِثِ الحَرّابِ أَو حُجُرِ",21,"ر",1,0],["فَالجِنحُ أَخضَرُ كَالسُدوسِ تَخالُهُ","مِن حَيَّةٍ خَضراءَ غُشِّيَ سُندُسا",22,"س",2,0],["فَالجِسمُ إِن زايَلَتهُ الروحُ صارَ لَقىً","كَلّاً عَلى القَومِ ما فيهِ مِنَ الضَخَمِ",23,"م",1,0],["فَالجُمُدُ الحافِظُ الطَريقَ مِنَ ال","زَيغِ فَصَحنُ الشَقيقِ فَالأُمُلُ",24,"ل",1,0],["فَالْجَوُّ قَدْ باحَ بِمَكْنُونِهِ","وَالأَرْضُ قَدْ أَنْجَزَتِ الْمَوْعِدَا",25,"د",2,0],["فالجود من كرم الفتى","والمَطْلُ دَاءٌ في اليَدِ",26,"د",1,0],["فالجو كابي الأرواق أكلفها","والماء طرق نميره كدره",27,"ر",2,0],["فألجمتُهُ حتى وَجَدْتُهُ","بما شحّ من حسن الرياضة يسمح",28,"ح",1,0],["فالجوّ مّما من أرواحهم","لا تستبين نجومه عينان",29,"ن",1,0],["فَالجسم يَبرأ بِالعِلاج سَقامهُ","وَشَفا النُفوس صَداقة الخِلّان",30,"ن",1,0],["فَالجَوّ راقَ كَأَنَّما","صَقَلتهُ أَنفاس النَسيم",31,"م",1,0],["فالجيد منك فجر","والوجه زبرقان",32,"ن",1,0],["فالجأ لدولة عزه يا صاح إن","خفت العدا وشماته الحساد",33,"د",1,0],["فالجيدُ يَزْهُو بالقلا","ئِد واللآلى والدرَر",34,"ر",1,0],["فالجسم منه في تهامةَ نازلٌ","والقلبُ منه غائبٌ في نجده",35,"د",2,0],["فَالجودُ وَالعَدلُ مَفروضٌ وَمُتَّبَعٌ","وَالجَورُ وَالبُخلُ مَرفوضٌ وَمُجتَنَبُ",36,"ب",1,0],["فَالجَورُ قَد أَلغاهُ مَن لَم يُلغِهِ","وَالحَقُّ مُعتَرِفٌ بِهِ مَن أَنكَرا",37,"ر",2,0],["فَالجودُ إِلّا مِن يَدَيكَ مُصَرَّدٌ","وَالظَنُّ إِلّا في نَداكَ مُرَجَّمُ",38,"م",1,0],["فالجو برَّاق الشُّعاع مفضض","والماء فياض الأتيّ معسجد",39,"د",1,0],["فأَلْجمتُه عَضْبَ الغِرارين كاسرا","هو الموتُ لولا أنْ يقال حديد",40,"د",1,0],["فالجامع الاموي اصبح يزدهي","ومن الجمال عليه عظم رونق",41,"ق",1,0],["فالجمر في وجنتيه","مما عليه خلعتُ",42,"ت",1,0],["فالجود من قرنائه والحمد من","أسمائه والشكر من أقواله",43,"ل",2,0],["فَالجَمالُ الَّذي يَسيلُ عَلَينا","ما طَفا مِثلهُ عَلى أَحداقِ",44,"ق",1,0],["فَالجنينُ الَّذي دفنّاهُ بِالأَمسِ","اِجعَليهِ في سِرٍّ صَدرِك قَبرا",45,"ر",2,0],["فالجُود ليس بمستطاب طعمُه","إلا إذا لم يُتعب السُّؤَّالا",46,"ل",2,0],["فالجسم بان وأودى","وروحه فيك يجري",47,"ي",1,0],["فالجوّ ملتحِف بُسْطاً مفوَّفةً","كأنهن اختلافُ الوشي والحَبَر",48,"ر",1,0],["فَالجَوهَرُ الباقي هُوَ ال","إِحسانُ وَالدُنيا عَرَض",49,"ض",1,0],["فَأَلجَأَهُ شَفّانُ قَطرٍ وَحاصِبٌ","بِصَحراءَ مَرتٍ غَيرِ ذاتِ مُعَرَّسِ",50,"س",1,0],["فالجنّة والنار اندرجا","في برّهما وعقوقهما",51,"م",2,0],["فالجامِعُ الأمويُّ يجمَعُ أُمَّةً","لأذانِهِ فيها دويُّ الرّاعد",52,"د",1,0],["فَالجِسرُ جِسرُ اِبنِ شَواسٍ فَنَيرَبُها","تَحلو مَعانيهِ لا تَخلو مَغانيهِ",53,"ي",2,0],["فَالجَلابيبُ القَشيباتُ مِنَ ال","عِلمِ مِن بَعدِكَ أَسمالٌ بَوالي",54,"ي",1,0],["فَالجِذعُ لي جُمّارُهُ وَالعَظمُ غُض","روفٌ بِهِ لينٌ وَكانَ الأَصلَبا",55,"ب",2,0],["فَالجَيشُ مِثلُ كُعوبِ الرُمحِ مُطَّرِداً","وَهوَ السِنانُ أَمامَ الجَحفَلِ اللَجِبِ",56,"ب",1,0],["فالجيادُ العِتاقُ لا تَبلغُ الغا","يةَ حتّى تستصحبَ الأفلاءَ",57,"ا",2,0],["فَالجودُ إِن آمَنوا وَإِن شَكَروا","وَالقَهرُ إِن كَذَبوا وَإِن كَفَروا",58,"ر",3,0],["فَالجهلُ وَالتقليدُ ضربةُ لازبٍ","أَبداً عليه فأيّ حكمٍ يقطعُ",59,"ع",1,0],["فالجُودُ والصّبرُ وجَمعُ الفتَى","شَمْلَ بني الجِنْسِ بنُعْماه",60,"ا",2,0],["فالجاهلانِ اثْنانِ من بَيْنِ الورَى","فافْطُنْ أُخَيَّ وإنْ هما لم يَفْطُنا",61,"ن",2,0],["فالجوُّ طولَ اليومِ تبرٌ ماطرٌ","والتُربُ طولَ العام مِسْكٌ أذْفَر",62,"ر",1,0],["فالجيشُ فَضْلٌ إذن","للمُلْكِ يَومَ الطِّراد",63,"د",1,0],["فالجودُ فِعْلٌ واحدٌ وبه","لك شاكرانِ العَبْدُ والرَّبّ",64,"ب",1,0],["فالجوهر الممدوح تعلن حسنَه","فخراً وقبحُ العار يُخفيه الخجل",65,"ل",1,0],["فالجهل يخفض شأن كل ممنَّعٍ","والعلمُ يَرفَع كل من لم يُرفَع",66,"ع",1,0],["فالجري في الأرض الكُلام","يُبلي الفتى بالعطبِ",67,"ب",1,0],["فالجهل يدركه الحكيم لأنه","قد كان قدماً جاهلاً خطّاء",68,"ا",2,0],["فالجَوُّ مُنبَجسٌ بالنورِ مَفرِقُهُ","والأَرضُ قد بَسَمَت عَن ثَغر لَمياءِ",69,"ا",2,0],["فالجهل أولى من علو","م للمعاصي لا تذود",70,"د",1,0],["فالجِسمُ مِنهُ مُنحَفٌ","وَالحالُ زائِدَةٌ القصور",71,"ر",1,0],["فالجود مِن فَضلٍ لَدَيهِ مُشرِّق","أَبَداً وَمال في البِلادِ مغربِ",72,"ب",1,0],["فالجود من كفه الفياض منطلقٌ","والخير في قوله الفصال مرهونُ",73,"ن",1,0],["فالجَوُّ مكسُوَّةٌ جَوانِبُهُ","بالنَّقْعِ والجُرْدُ فيه مُنْجَرِدَه",74,"د",2,0],["فالجِزْع فالمُنحنَى فبُرقة تَيْ","ماءَ فَوادي الأراكِ فاللّبَبِ",75,"ب",1,0],["فالجوّ في مِسكيّةِ الغيمِ انبرى","والأرضُ في موشيّةِ الأزهارِ",76,"ر",1,0],["فالجوى لم يبق من بعد النى","فضلة يلحظها الناظر مني",77,"ي",1,0],["فالجود في عرصاتها والأمن في","أبوابها بالفضل والإكرام",78,"م",1,0],["فالجود أعشار فجزء في الورى","ولديه تلك التسعة الأجزاء",79,"ا",2,0],["فالجَوُّ من فحواهُ مِسكٌ فائِحٌ","والأَرْضُ من يُمْناهُ روضٌ يانِعُ",80,"ع",1,0],["فالجيرةُ الجيرةُ وال","أنعم منهم أنعمُ",81,"م",1,0],["فالجارُ والجاني وسائلُهُ","لهمُ بمَشْرِعِ فَضْلهِ نَهَلُ",82,"ل",1,0],["فالجدُ إلا فيهِ بات مذمَّماً","والصَّبر إلاَّ عنهُ أصبح هيِنّا",83,"ن",2,0],["فالجسمُ في ثوب السَّقام له لقى","والقلبُ في قيد الهموم به رسفْ",84,"ف",1,0],["فَالجيزَةُ الحَسناءُ في حُلَّةٍ","مِن حُلُلِ الخَيرِيِّ تِبرِيَّه",85,"ي",2,0],["فَالجُلَّنارُ كَأَنَّهُ","في الإِحمِرارُ أَخو الخَلوقِ",86,"ق",1,0],["فَالجَوُّ في عاتِقِ نَفّاطِهِ","زَرّاقَةٌ نيرانُها البَرقُ",87,"ق",1,0],["فَالجَوُّ في خَزِّهِ وَمُصمَتِهِ","وَالرَوضُ في وَشيِهِ وَفي حِبَرِه",88,"ر",2,0],["فَالجَوُّ قَد أَصبَحَ خُلدِيُّهُ","بِطانَةً وَالغَيمُ سَمّورُ",89,"ر",1,0],["فَالجُلَّنارُ خَلوقُهُ","قَد غابَ في مِسكِ الضَبابِ",90,"ب",1,0],["فالجسم منهمك من نغمة الهمم","والجفن منهمر من جرحة الودج",91,"ج",1,0],["فالجسم في سفر بالطيف وحور","والجفن منهمر من حرقة الودج",91,"ج",1,0],["فالجيد جيد وإني أقتفي أثرا","من أجلها وهلال الأفق منمحق",92,"ق",1,0],["فالجأ إليه يربط قلبٍ إن بغى","باغٍ وربُّك يخلق الأنصارا",93,"ر",2,0],["فالجأ لنا واحفظ صميم عهودنا","ما ثم بابٌ للنبي سوانا",94,"ن",2,0],["فالجور والبخل والإلحاد منصدع","والعدل والجود والإيمان ملتئم",95,"م",1,0],["فالجأ إليه وكن به متمسكاً","وليستَوِ الإسرار والإعلان",96,"ن",1,0],["فالجأ إليه وكن به متعلقاً","لا فاز من هو ليس بالمتعلق",97,"ق",1,0],["فالجأ إلى الله إن رمت النجاة بها","واسلك سبيل أولي التقوى ولا تقف",98,"ف",1,0],["فالجِيدُ أَحسنُ ما يكون لمسمَعٍ","أَضحى بجوهرِه النفيسُ مُزَيَّنَا",99,"ن",2,0],["فالجسمُ والعينانِ من لَثْمها","والضَّمُّ تحتَ القُفْلِ والختْمِ",100,"م",1,0],["فَالجِسْمُ مُذْ غِبْتُمُ بِالسّفْحِ مُتّشِحٌ","وَالقلبُ مُضْطَرِبٌ بالشَّوْقِ مُضْطَرِمُ",101,"م",1,0]]}