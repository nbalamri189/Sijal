{"poems":[[100,"وحدي هنا","https://www.aldiwan.net/poem24837.html","عموديه"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[81,"يوم تضاحك نوره الوضاء","https://www.aldiwan.net/poem61561.html","الكامل"],[48,"إني أتيتكم من القبر","https://www.aldiwan.net/poem63371.html","الكامل"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[81,"يومٌ تضاحكَ نورهُ الوضاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10959&r=&rc=0",""],[142,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[223,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[223,"شاعر القلب ضاق عنه البيان","https://www.aldiwan.net/poem41612.html","الخفيف"],[223,"هل إن فكرك من يراعك أسرع","https://www.aldiwan.net/poem41634.html","الكامل"],[235,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[251,"قف شامخاً","https://www.aldiwan.net/poem27798.html","عموديه"],[338,"إن ظني بحسن عفوك يا رب","https://www.aldiwan.net/poem68762.html","الخفيف"],[366,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[458,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[461,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[464,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[479,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[551,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"]],"verses":[["لقّن التاريخ آيا","تي ويروي الخلد خلدي",0,"ي",1,0],["لُقِّنَ الحَقَّ عَلَيهِ كَهلُها","وَاِستَقى الإيمانُ بِالحَقِّ فَتاها",1,"ا",3,0],["لَقِنَ الوَقارُ إِذ اِرتَقى مِن فَوقِهِ","نَدبٌ أَشَمُّ وَهَضبَةٌ شَمّاءُ",2,"ا",2,0],["لُقِّنتُها مِن مُفهِمٍ فَهِمٍ","فَعَقَدتُها بِأَنامِلٍ عَشرِ",3,"ر",1,0],["لقنوا النشء وعد «بلفور» درسًا","وأروهم خيام كلِّ طريد",4,"د",1,0],["لقَّنْتَ قادتَها درو","س المنطِقِ الحقِّ السليمِ",5,"م",1,0],["لقنَ الوقار إذا ارتقى مِنْ فوقه","ندبٌ أشمُّ وهضبة ٌ شماء",6,"ا",2,0],["لقَّنهُ الطبعُ الكريمُ صُحُفا","من مذهب الجودِ فجاء حاذقا",7,"ق",2,0],["لَقَّنتُ في مُقلَتَيكِ فَنّي","لِلعاشِقين",8,"ن",1,0],["لَقَّنَتهُ الأَيّامُ مَوعِظَة النا","رِ فَثارَت في صَدرِهِ النيرانُ",9,"ن",1,0],["لَقَّنتَهُ شَدوَ الهِيامِ مودِّعاً","وَرَحلتَ عَنهُ وَالعُيونُ تودَّعُ",10,"ع",1,0],["لِقنَ النَدى وَالبأسَ في قُضبانِهِ","عَن أَيهَمٍ طاوٍ وَأَغلَبَ باسِلِ",11,"ل",1,0],["لقنتم الدنيا الدروس صريحة","لا تقبل التزييف والتدجيلا",12,"ل",2,0],["لَقِّني حُجَّتي وَإِن لَم تَكُن يا","رَبِّ لي حُجَّةٌ وَلا وَجهُ عُذرِ",13,"ر",1,0],["لَقَنِعتُ مِن عِدَةٍ وَوَص","لٍ بِالخَيالِ وَبِالمُحالِ",14,"ل",1,0],["لقِنَ النفارَ من الغزالة واحتذَى","لَيَّ العهودِ من القضيبِ المائلِ",15,"ل",1,0],["لقِنَتْ مخادعُه الصَّلاةَ لفرط ما","تُزْجى بهنَّ فريضةٌ وتَنَفُّلُ",16,"ل",1,0],["لقّنت أخلاق بني الدهر في","ليِّ المواعيد وطول المطال",17,"ل",1,0],["لقنتها في ديار الترك من صغر","حين الدراسة عن سلطانها فيها",18,"ي",3,0],["لِقناهُمُ بين الأضالعِ في الوغى","زَجَلٌ ولا زجلُ الأَباءِ المُحْرَقِ",19,"ق",1,0]]}