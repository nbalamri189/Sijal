{"poems":[[102,"وحدي هنا","https://www.aldiwan.net/poem24837.html","عموديه"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[83,"يوم تضاحك نوره الوضاء","https://www.aldiwan.net/poem61561.html","الكامل"],[50,"إني أتيتكم من القبر","https://www.aldiwan.net/poem63371.html","الكامل"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[108,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[83,"يومٌ تضاحكَ نورهُ الوضاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10959&r=&rc=0",""],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[228,"شاعر القلب ضاق عنه البيان","https://www.aldiwan.net/poem41612.html","الخفيف"],[228,"هل إن فكرك من يراعك أسرع","https://www.aldiwan.net/poem41634.html","الكامل"],[240,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[256,"قف شامخاً","https://www.aldiwan.net/poem27798.html","عموديه"],[343,"إن ظني بحسن عفوك يا رب","https://www.aldiwan.net/poem68762.html","الخفيف"],[371,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[466,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[469,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[484,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[556,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61159","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93714","السريع"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131998","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136900",""],[4733,"راحلةُ السّنين","https://www.poetsgate.com/ViewPoem.aspx?id=206870",""],[4862,"يامن ضُمِمتَ لزمرة الشرفاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=55633",""],[4968,"معراج الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=206757",""],[5057,"أرقّ قلوبا","https://www.poetsgate.com/ViewPoem.aspx?id=197518",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[5183,"الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=180193",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5431,"والرؤى دهماءُ...","https://www.poetsgate.com/ViewPoem.aspx?id=213000",""],[5614,"شموخ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=4261",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""]],"verses":[["لقّن التاريخ آيا","تي ويروي الخلد خلدي",0,"د",2,0],["لُقِّنَ الحَقَّ عَلَيهِ كَهلُها","وَاِستَقى الإيمانُ بِالحَقِّ فَتاها",1,"ا",3,0],["لَقِنَ الوَقارُ إِذ اِرتَقى مِن فَوقِهِ","نَدبٌ أَشَمُّ وَهَضبَةٌ شَمّاءُ",2,"ا",2,0],["لُقِّنتُها مِن مُفهِمٍ فَهِمٍ","فَعَقَدتُها بِأَنامِلٍ عَشرِ",3,"ر",1,0],["لقنوا النشء وعد «بلفور» درسًا","وأروهم خيام كلِّ طريد",4,"د",1,0],["لقَّنْتَ قادتَها درو","س المنطِقِ الحقِّ السليمِ",5,"م",1,0],["لقنَ الوقار إذا ارتقى مِنْ فوقه","ندبٌ أشمُّ وهضبة ٌ شماء",6,"ا",2,0],["لقَّنهُ الطبعُ الكريمُ صُحُفا","من مذهب الجودِ فجاء حاذقا",7,"ق",2,0],["لَقَّنتُ في مُقلَتَيكِ فَنّي","لِلعاشِقين",8,"ن",1,0],["لَقَّنَتهُ الأَيّامُ مَوعِظَة النا","رِ فَثارَت في صَدرِهِ النيرانُ",9,"ن",1,0],["لَقَّنتَهُ شَدوَ الهِيامِ مودِّعاً","وَرَحلتَ عَنهُ وَالعُيونُ تودَّعُ",10,"ع",1,0],["لِقنَ النَدى وَالبأسَ في قُضبانِهِ","عَن أَيهَمٍ طاوٍ وَأَغلَبَ باسِلِ",11,"ل",1,0],["لقنتم الدنيا الدروس صريحة","لا تقبل التزييف والتدجيلا",12,"ل",2,0],["لَقِّني حُجَّتي وَإِن لَم تَكُن يا","رَبِّ لي حُجَّةٌ وَلا وَجهُ عُذرِ",13,"ر",1,0],["لَقَنِعتُ مِن عِدَةٍ وَوَص","لٍ بِالخَيالِ وَبِالمُحالِ",14,"ل",1,0],["لقِنَ النفارَ من الغزالة واحتذَى","لَيَّ العهودِ من القضيبِ المائلِ",15,"ل",1,0],["لقِنَتْ مخادعُه الصَّلاةَ لفرط ما","تُزْجى بهنَّ فريضةٌ وتَنَفُّلُ",16,"ل",1,0],["لقّنت أخلاق بني الدهر في","ليِّ المواعيد وطول المطال",17,"ل",1,0],["لقنتها في ديار الترك من صغر","حين الدراسة عن سلطانها فيها",18,"ي",3,0],["لِقناهُمُ بين الأضالعِ في الوغى","زَجَلٌ ولا زجلُ الأَباءِ المُحْرَقِ",19,"ق",1,0],["لَقن يراجعك الحَديث وَلَيس إن","رامَ التكلم ذا لسان ناطق",20,"ق",1,0],["لقن الوحي آيه لنبي","عز قدراً عن سائرِ الإنسانِ",21,"ن",1,0],["لقَّنته لَفظة تَوحيده","سويعةَ الميلاد فاستلقنا",22,"ن",2,0],["لقنت سكان الخمائل شدوها","وتعلمت مني الكواكب سهدها",23,"د",3,1],["لقنتني درس المحبة والصد","ق وهذان حلية الانسان",24,"ن",1,0],["لقن الطير حوله نغم الحب","فغنّت على رخيم قراره",25,"ر",2,0],["لقَّننا الصَّبرُ أحادِيثَهُ","ونهجُهُ إطالةُ الدَّرسِ",26,"س",1,0],["لقنتهم درساً بأن الحرّ لا","يرضى الهوان كسائر العملاءِ",27,"ا",2,0],["لقَّنْتُهُ مِنْ تَمَاسِ العِشْقِ فِي شَبَقٍ","فِي صَمْتِ مِحْرَابِهِ صُغْتَ التَّرَاتِيلاَ",28,"ل",2,0],["لقِّنهُ درساً قاسياً ليتوبا","واجعلهُ يقضيْ ليلَهُ مكروبَا",29,"ب",2,1],["لقنتك الدنيا من الغدر درساً","إن نسيت الحياة لن تنساه",30,"ا",2,0],["لقن الغادر درسا ما درى","قبله كيف وقوع القدر",31,"ر",1,0],["لقنته سحر البيان فغنى","فهو شعر تمده شعراها",32,"ا",3,0],["لقنته حوادث الدهر درسا","نال منه مرونة التفقية",33,"ي",2,0],["لقنها الشعبُ بقوته","درساً آخرهُ الإفحامُ",34,"م",1,0],["لقنينا معنى التضامن حتى","يشعر العرب بالملاذ الوحيد",35,"د",1,0],["لقّنَ السحر أنْ يُصيب غريما","أو يقال : بوكره صهباءُ",36,"ا",2,0],["لقنيني كيف اجاوب من سأل","مقصده يجرح وغطى بالقناع",37,"ع",1,0],["لقَّنْتَهُم درساً وقد حسِبُوا","أنْ قد عَرَانا اليأسُ والشلَلُ",38,"ل",1,0]]}