/poem/110004","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91345","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40134","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75690","البسيط"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111053","البسيط"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132185","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86470","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81273","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147277","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139540",""],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124652","السريع"],[4755,"تَهَوَّدَ الجُولانُ","https://www.poetsgate.com/ViewPoem.aspx?id=203993",""],[4578,"رنا جفنه للأسد بالسحر يقنص","https://www.poetsgate.com/ViewPoem.aspx?id=49452",""],[5168,"يالعندك جمال من الجمال اكثر","https://www.poetsgate.com/ViewPoem.aspx?id=92218",""],[5186,"يا بروحي لاعبات التنس","https://www.poetsgate.com/ViewPoem.aspx?id=156500",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5431,"موغلٌ في حنينه لم يخُنّا...","https://www.poetsgate.com/ViewPoem.aspx?id=197423",""],[5431,"طيب القلب طعمه كيف أنسى؟","https://www.poetsgate.com/ViewPoem.aspx?id=198032",""],[5431,"اقيض الروح ياحبيبي وخذني","https://www.poetsgate.com/ViewPoem.aspx?id=198171",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5573,"لك البقا مع طول الايام ياخال","https://www.poetsgate.com/ViewPoem.aspx?id=200175",""],[5725,"دهم العيون","https://www.poetsgate.com/ViewPoem.aspx?id=177935",""],[5948,"ربَّ مغمومِ بعَافيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=100597",""],[5950,"أبيات ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=126254",""],[5950,"مورقه يا طواريق الطريق الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=139963",""],[6320,"جَوَى الأَشْجَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84337&r=&rc=34",""]],"verses":[["مَورِدٌ يَنقَعُ الغَليلَ وَيَزدا","دُ صَفاءً عَلى طُروقِ الرَشيفِ",0,"ف",1,0],["مُوَرِّثَةٍ مالاً وَفي الحَمدِ رِفعَةَ","لِما ضاعَ فيها مِن قُروءِ نِسائِكا",1,"ك",2,0],["مُوَرَّثُ المَجدِ مَيمونٌ نَقيبَتُهُ","ضَخمُ الدَسيعَةِ في العَزّاءِ مِغوارُ",2,"ر",1,0],["مُورِيسُ سِرُّ أَبِيهِ","فِي كَرَمِ الشَّمَائِلِ وَالخِلاَلِ",3,"ل",1,0],["موردُهُ شهدٌ إذا شيمَ برّه","وإن شيمَ حربٌ فالمواردُ صاب",4,"ب",1,0],["موردك المذلة القصيه","لذتّك النقائصُ البذية",5,"ي",2,0],["مَوروثِ كُلَّ مَضِنَّةٍ","إِلّا الذَخيرَةِ مِن ثَوابِ",6,"ب",1,0],["مُوَرَّدةٌ مِنْ كَفِّ ظَبْيٍ كأنّما","تَناوَلَها مِنْ خَدِّهِ فَأدَارَها",7,"ر",3,0],["مُورَّسَةُ الأطرافِ يلفظُ صدرُها","مُجاجةَ أكبادِ العِدى والجَماجمِ",8,"م",1,0],["مُوَرَّدُ ما دونَ العِذارِ مِنَ الخَدِّ","بِوَردٍ بَديعٍ لَيسَ مِن جَوهَرِ الوِ",9,"و",1,1],["مُؤّرَّقَةُ العيونِ تَبيتُ تَسْري","فتَطرُقُ فتيةً كانوا نِياما",10,"م",2,0],["مُورَّدُ السَّيلِ يُضحي من تَنسُّمِه","لطيبِه عن جَنِيِّ الوَردِ في شُغُلِ",11,"ل",1,0],["مُوَرَّدَةَ اللَّونِ مِسكِيَّةً","تُعِزُّ الدَّليلَ وتُغني الفَقيرا",12,"ر",2,0],["موردة اللون مسكية","تعز الذليل وتغني الفقيرا",13,"ر",2,0],["مُوَرَّثُ المَجدِ لا يَغتالُ هَمَّتَهُ","عَنِ الرِياسَةِ لا عَجزٌ وَلا سَأَمُ",14,"م",1,0],["مُؤَرِّثُ نارٍ وَالإِمامُ يَشُبُّها","وَقائِلُ فَصلٍ وَالخَليفَةُ فاعِلُ",15,"ل",1,0],["مورى الفُؤادِ فَلَو كانَت بِعَزمَتِهِ","تُذكى المَصابيحُ لَم تَخبُ المَصابيحُ",16,"ح",1,0],["مُورَّدةٌ إذا دارتْ ثلاثاً","يُفتِّحُ وردُها ورْدَ الخدودِ",17,"د",1,1],["مُوَرَّدَةً إِذَا اتَّقَدَتْ بِكَفٍّ","جَلَتْها لِلأَشِعَّةِ في خِضَابِ",18,"ب",1,0],["مُوَرَّدَةٌ تَمْتَدُّ مِنْهَا أَشِعَّةٌ","تَدُورُ بِهَا في ظِلِّ أَلْوِيَةٍ حُمْرِ",19,"ر",1,0],["مُورِيسُ مِنْ بَيْتٍ رَفِيعِ الذُّرَى","مَوْضِعُهُ فِي الْجَاهِ لاَ يُنْكَرُ",20,"ر",1,0],["موردٌ يمشي إلى قُصَّادِه","فيه رِيٌّ وحيَاةٌ وشِفاء",21,"ا",2,0],["مورد ما دون العذار من الخد","بورد بديع ليس من جوهر الورد",22,"د",1,1],["موروثة منا لآبائنا","والبشر مبسوط بأرجإنا",23,"ن",2,0],["مَوردٌ غصَّ بالزحامِ فلولا","سبقُ من جاء قبلَنا لورَدنا",24,"ن",2,0],["موردة الوجنات ساحرة الربا","تدانا وبعد الشمس من قربها أدنا",25,"ن",2,0],["مُورِّثُهُ مِن عَهدِ عادٍ وَجُرهمٍ","وُهَيبُ بنُ أَفصى وَالقُرونِ الذَواهِبِ",26,"ب",1,0],["مُوَرَّدَةً إذا مُزِجَتْ","كَوردِ الخدّ مِن خَجلِ",27,"ل",1,0],["مَورِدُ عِصيانِهِ وَخَيمٌ","وَرَوضُ إِحسانِهِ مَريعُ",28,"ع",1,0],["مَورِدُ البيضِ وَالأَسِنَّةِ في الرَو","عِ ظِماءً ماءَ الطُلى وَالنُحورِ",29,"ر",1,0],["مورِدوا البيضِ وَالأَسِنَّةِ في يَو","مِ الوَغى نَحرَ كُلِّ أَغلَبَ وَردِ",30,"د",1,0],["مورَّدُ الخَدِّ لَدنُ القدِّ ذو هَيفٍ","خَفيفُ روحٍ ثَقيلُ الرِدفِ راجحُهُ",31,"ح",2,0],["مورَّس الوَجه أَغدو حينَ أَنظره","مَورَّد الخَدّ مِن تيه وَمِن خَفرِ",32,"ر",1,0],["مَوْرِدٌ أَصْدُرُ عنه بالَّذي","أَبْتَغيه منه في جاهٍ ومال",33,"ل",1,0],["مورّدة في الكأس بعد مزاجها","كأنْ مزجت من ماء خدٍّ مورّد",34,"د",1,0],["مورد الخد ساجي الطرف مبتسم","عن الحباب وعن طلع وعن درر",35,"ر",1,0],["موردُ جودٍ وجيادٍ وفي","تاريخه شرابه كوثرُ",36,"ر",1,0],["مُوَرَّثِ المُلكِ من عُليا تَبابِعِهِ","والسَّيفِ من عَمْرِهِ والسَّيب من أُدَدِهْ",37,"د",2,0],["مورِّثون العلاء مثلك تب","نيه وحفظُ الأحسابِ بُنيانُ",38,"ن",1,0],["موْرِدُ جودٍ خالصٌ سائغٌ","يَشْرَبُ منهُ البَرُّ والفاجِرُ",39,"ر",1,0],["مورّد الوجنة لا أنفكُّ من","وشاته إلاَّ إلى عذّاله",40,"ل",2,0],["مَوردٌ أَشهَى مِنَ العَسَلِ","صُبح لَيلِ الحادِثِ الجَلَلِ",41,"ل",1,0],["مَورِدِ العَسَّالَةِ الذُّبُلِ","نَجلُ خَيرِ الخَلقِ والرُّسُلِ",41,"ل",1,0],["موردُك الشَّامُ على هَوْلِه","به احتَمى المورِدُ من زَمْزِم",42,"م",1,0],["مورِثَةُ القَومِ أَضغاناً بِلا إِحَنٍ","مُزرِيَةٌ بِالفَتى ذي النَجدَةِ الحالِ",43,"ل",1,0],["موردة لا يذبل الرشف خدها","وتذبل أزهار البساتين بالرشف",44,"ف",1,0],["مؤرخه داع لحكم وبعده","وزارة سلطان البلاد بعهده",45,"د",2,0],["مورَّدِ الخدِّ في قُمْصٍ مُوَرَّدَةٍ","له من الوردِ إِكليلٌ على الراس",46,"س",1,0],["موردة الخدين تدمي من الحيا","معقربة الصدغين مسلولة الثغر",47,"ر",1,0],["مورد هيم الموا","ضي دم أشلاء وهامِ",48,"م",1,0],["موَّردُ البرقِ يضا","هي نبتَه الموَّردا",49,"د",2,0],["مُوَرَّدَةُ الخَدَّيْنِ مَعْسُولَةُ اللَّمَى","لَهَا الزَّهْرُ عِقْدٌ وَالْخَلِيجُ لَهُ سِمْطُ",50,"ط",1,0],["مورد الخد لدن القد تحسبه","شمس على غصن بان مزهر ترفا",51,"ف",2,0],["مُوَرَّدُ الخَدّ مَا اخْضَرَّتْ غدَائِرُهُ","الاّ اكْتَسَى الروضُ مِنْ خَدَّيْهِ ألْوَانَا",52,"ن",2,0],["مورد الخد إلا أنه قمر","به تكامل سعدي حينما سفرا",53,"ر",2,0],["مؤرخ الأقمار بعد خسوفها","وظلامها أرخ ضريح بشاره",54,"ر",2,0],["مُورِدٌ مِنْ مَشَارِعٍ الجُودِ عَذْبٌ","نَاصِرُ الدِّين مُظْهِرٌ حُكْمَ شَرْعِ",55,"ع",1,0],["مورّدُ ما بين العذارين زارني","فنزَّه أحداقي بلونِ الحدائق",56,"ق",1,0],["مورَّدُ الوجنة ما استخجلته","إلاَّ وماء الورد منها بدد",57,"د",1,0],["مورداً يروي من الصادي الأُواما","هل بَناتُ السير في تلك الفلا",58,"ل",2,0],["\"مورد الخد\" شهيّ اللمىَ","\"في لثمه كل المنى\" لو ينال",59,"ل",1,0],["مورّدة لو ذاقها شيخ تسعة","وتسعين أضحى الخد منه موردا",60,"د",2,0],["مورثة القوم أضغانا بلا إحن","مزرية بالفتى ذي النجدة الحالي",61,"ل",2,0],["موردٌ للعفَاةِ شطُّ نَداهُ","فهْو للربعِ مخصبٌ والرُّسُومِ",62,"م",1,0],["مورَّد الوجنتين حلو","سواه في الناس ما حلا لي",63,"ل",2,0],["مَوْرِدُ البيضِ مَصْدَرُ السُّمْرِ ع","ن رزق الأعادي وصدرها مخضوبُ",64,"ب",1,0],["مؤرَّقٌ من سَهَدِه","مُعذَّبٌ من كِمَدِه",65,"د",2,1],["مورّدة في كفّه مثل خدِّه","يكاد سناها للقلوب يُطيرها",66,"ر",3,0],["موروثة في بنيك لابل","بينهم برْدُها جديد",67,"د",1,0],["مَوروثة من أَب لابن مسلمة","السَعد وشعها وَاليمن طرَّزها",68,"ز",3,0],["مورد يوردراجي","ه إلى أعذب ورد",69,"د",1,0],["مورّدات الخدود الكمل الباهيه","رعى اللَه أوقات تلك الأعين الساجيه",70,"ي",2,0],["مورّدُ الخد شميّ اللمى","منغّم الردف جديب الوشاح",71,"ح",1,0],["مَوردُ الحِلمِ مَنهَلُهُ كَرماً","كفُّهُ بالسخا واكِفٌ لا يَبيد",72,"د",1,0],["موردة إذا الساقي جلاها","شممت لها كنشر المسك ريا",73,"ي",2,0],["مُوَرَّدُ خَدَّيها لِدَمعي مُشابِةٌ","وَناحِلُ خِصرَيها لِجسمِي مُناسِبُ",74,"ب",1,0],["مورّدة الخدَّين من نار حسنها","ومن عجبٍ ان ينضرَ الورد في الجمرِ",75,"ر",1,0],["مورَّدَةُ الخَدَّينِ كَالشَهدِ ريقُها","يُعيدُ نَشاطي ثُمَّ يُحيي تَرائِبي",76,"ب",2,0],["مؤرخ إبراهيم يزهو بواصل","لمصر بعزٍ لا يخيب مسلّم",77,"م",1,1],["موري دجا النقعِ قدحاً زندُ سنبكِهِ","لولا التحمحم في الهيجاء لالتهبا",78,"ب",2,0],["مورِدَ الفضلِ ناقعاً بحجاهُ","كلَّ صادٍ لفضلهِ ملهوفِ",79,"ف",1,0],["مَورّدُ الخَدّ في أَلحاظه دعجٌ","مقوّم القدّ مهما لاين اقتدرا",80,"ر",2,0],["مورياً إذ كان قد سقاه","سماً وحياً قاطعاً حشاه",81,"ه",1,0],["مُورِّثُ أَركاسِها مِن أَبٍ","أَكولِ الفَوَارِسِ شَرّابِها",82,"ب",3,0],["مورد غر الشاء والثيار","فوقفوا بالرمح والبتار",83,"ر",1,0],["مورد الخد مَعسولاً مقبله","أَحلى من النَوم في أَجفان ذي سهر",84,"ر",1,0],["مورد الخد معسول اللمى خجل","يدير شمس الحميا وهو في خجل",85,"ل",1,0],["موردة الخدين مسكية الشذا","مهفهفة الاعطاف كالغصن تخطر",86,"ر",1,0],["مورد الوجنة قد عنعنت","حمرتها عن دم عشاقه",87,"ق",2,0],["مُورِقات أَكفها مِثلَما يَو","رق جثل النَبات مِن أَفنانه",88,"ن",2,0],["موردي أنت وعشقي ودمي","لا ولولاك لما عاد الأملْ",89,"ل",1,0],["مورداص بالتهاب حدِّ شباهُ","كلَّ رجسٍ إلى أشدِّ العذاب",90,"ب",1,0],["مورد الوجنة معسول اللمى","نشوان يحلو لك ثغرا أشنبا",91,"ب",2,1],["مُؤَرِّقٌ كالشِّعرِ هجرَانُهُ","ومُؤلِمٌ كالطَّعنِ خَوفُ الطِّعَانْ",92,"ن",1,0],["مورد خداً ورد الصب ورده","شجوناً بها قلب المحبين يقرص",93,"ص",1,0],["مو رقت الحالي الناس كل الناس","ما ادري انته قلبك يمته يتاثر",94,"ر",1,0],["مورد الأهوآء كدر نجس","فاحذرن يا طهر ورد النجس",95,"س",1,0],["مورد الأدم من الآ","رام والبيض النقيه",96,"ي",2,0],["مورق الحسّ أنت يالاشتهائي","في جِنانٍ جعلتني منك غضنا",97,"ن",2,0],["مورق الحس صغتني منك زهرا","وتدلت ثمار ماجُدتَ غرسا",98,"س",2,0],["مورق الحس كن مع الشعر أهلي","لك تشدو حمائم البوح فني",99,"ن",2,0],["مؤرق الجفن لا يلوي على وطن","وإن صفا العيش في أفيائه وصفا",100,"ف",2,0],["مورق رطيب اغصانها ناهل ازلال","ويانع ثمرها مرتوي من شرابه",101,"ب",2,0],["مورياتٍ سوادها في اجيجٍ","فترائت مثل الاسنّةِ قدحا",102,"ح",2,0],["مُوردٌ أمراً يُسرّ به","فرأى المكروهَ في صدرهْ",103,"ر",2,0],["مورق كثر ما يحسّ أن الأماكن محل","ممحل كثر وحشة المنفى وضيق القبور",104,"ر",1,0],["مورقه يا طواريق الطريق الطويل","ماتمدّين غير الجزلة من التعب",105,"ب",1,1],["مُؤَرَّقَ الجَفْنِ تَحْتَ الدَّمْعِ مُنْسَكِباً","أَطْوِي غِمَارَ الأَسَى لِلْحُزْنِ أَصْطَحِبُ",106,"ب",1,0]]}