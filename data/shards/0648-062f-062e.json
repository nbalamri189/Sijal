{"poems":[[102,"وحدة الشاعر","https://www.aldiwan.net/poem24839.html","عموديه"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[87,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[87,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[87,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[47,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[63,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[99,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[47,"كُلّما شاءَتِ الرُّسُومُ المُحيلَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32140",""],[119,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[121,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[193,"طال شوقي لطيبة الطيبات","https://www.aldiwan.net/poem35171.html","الخفيف"],[201,"يا جارة الوادي طربت وعادني","https://www.aldiwan.net/poem39810.html","الكامل"],[215,"جئت وحدى إلى الشواطىء ظهرا","https://www.aldiwan.net/poem46265.html","الخفيف"],[240,"ياابن الدوامي الذي","https://www.aldiwan.net/poem32128.html","مجزوء الكامل"],[287,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[333,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[358,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[372,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[409,"لله درك يا ابن إسماعيلا","https://www.aldiwan.net/poem33595.html","الكامل"],[435,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[469,"نظرت إلي بطرف أحوى أحور","https://www.aldiwan.net/poem3579.html","عموديه"],[484,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[549,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[563,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[563,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2468","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103117","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48643","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77584","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77516","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77585","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77606","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77586","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120105","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112825","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112858","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128715","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48913","الكامل"],[1776,"","https://poetry.dctabudhabi.ae/diwan/poem/84765","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77299","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87335","الطويل"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107321","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201563",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133974","الخفيف"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3276,"","https://poetry.dctabudhabi.ae/diwan/poem/121439","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112346","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20615","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69971","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44732","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4729,"الحُشُّ والبَرَمُالكثيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=109451",""],[182,"انبجاسات روح","https://www.poetsgate.com/ViewPoem.aspx?id=71648",""],[5054,"‏ثورة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213745",""],[5281,"وفاءُ التَّاريخِ","https://www.poetsgate.com/ViewPoem.aspx?id=200243",""],[5370,"البريء","https://www.poetsgate.com/ViewPoem.aspx?id=86526",""],[5431,"لاسلمَ في عرْفِ الهوى لأسايره","https://www.poetsgate.com/ViewPoem.aspx?id=192058",""],[5536,"الحب والهندسه","https://www.poetsgate.com/ViewPoem.aspx?id=22591",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""],[5573,"خيرتك اختار","https://www.poetsgate.com/ViewPoem.aspx?id=200220",""],[5725,"موت عراقي الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=207163",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6220,"القَلمُ الذّهَبيُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86695&r=&rc=0",""],[6223,"حثالة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1211&r=&rc=6",""]],"verses":[["ودخان الحقد في أهدابه","كالخطايا فوق عرض عاهر",0,"ر",1,0],["ودخَلتُهُ وحدي وحوْلي موكبٌ","هَزِجٌ من الأَحلامِ والأَوهامِ",1,"م",1,0],["وَدَخل العِراقُ في وَلائِهِ","وَخَرَجَت مصرُ عَلى أَعدائِهِ",2,"ه",1,0],["ودخَلْتُ فِي ليلين: فَرْعِك والدُّجى","ولثمتُ كالصّبح المنوِّرِ فاكِ",3,"ك",1,0],["وَدُخاناً يَلُفُّ جُنحاً بِجُنحٍ","لا تَرى فيهِ مِعصَمَيها اليَمامَه",4,"م",2,0],["وَدَخيلاً مِنَ الصَبابَةِ لا يَت","رُكُ ماءَ الدُموعِ حَتّى يُسيلَه",5,"ل",2,0],["ودخلتُ أبوابَ الندامةِ بعدَما","عصفَت بيَ الأحداثُ عن أبوابِه",6,"ب",2,0],["ودخلتُه أجتازُ مزدحماً","بالخَلقِ أفواجاً وأفواجا",7,"ج",2,0],["ودخل المستضعفون فيها","كلّهمو خوف الأذى يخفيها",8,"ه",2,0],["ودخلتُ نفسَك لم أزاحِمْ حاجباً","عنها ، ولم ألجِ \" الرِواقَ \" فضولا",9,"ل",2,0],["وَد َخيلاٍ مِنَ الصّبَابَةِ مَا يَتْ","رُكُ مَاءَ الدَّمُوعِ، حتّى يُسيلَهْ",10,"ل",2,0],["ودخلنا بجاهه وبجاه ال","قوم آبائه بني الكرام",11,"ر",3,0],["ودُخانُ اللَّهيبِ تحت ضُلُوعي","كم أُخَبِّيهِ ساخرًا مِن دُخاني",12,"ن",2,0],["وَدَخلُتم مِن نوره في حصونٍ","فَسلمتُم مِن هذه الظلماتِ",13,"ت",1,0],["ودخلت في ليلين فرعك والدجى","والسكر أغراني بما أغراك",14,"ك",1,0],["ودخلت العباب في الظهر وحدى","وبقلبي من لج في الهجران",15,"ن",1,0],["وَدَخيلَ هَمٍّ لَو دَخَل","تَ إِلى عِيادَتِهِ خَرَج",16,"ج",1,0],["وَدَخَلتَها فَأَضاءَتِ اللُّمَعُ الَّتي","أَبدى بِها جُمَلَ السَنا الإيضاحُ",17,"ح",1,0],["ودخلنا المسجد الذي أسس على","التقوى بتأسيس خير إمام",18,"م",1,0],["ودخانٍ معطّرٍ نتعاطا","ه بعيدا في وكرِنا المستكنّ",19,"ن",1,0],["وَدُخان بارود الوَغى أَذكى لَهُ","مِن أَن تروِّحَهُ المَجامِرُ عَنبَرا",20,"ر",2,0],["وَدَخَلت البابَ لا أُعطِي الرُّشى","فَحَباني مَلِكٌ غَيرُ زَمِرْ",21,"ر",1,0],["ودخلت جنته التي قد ذُلِّلتْ","للعارفين قطوفُها تذليلا",22,"ل",2,0],["ودخان النار مذ عم بنا","ضيق النفس وأبكى مقلي",23,"ل",2,0],["ودخلت جنّة وجهها فأباحني","رضوانها المرجوُّ شرب المسكر",24,"ر",1,0],["ودخلت جنات النعي","م دخول حر ظافر",25,"ر",1,0],["ودخلتُ بيتَكِ في القصيدةِ خادماً","طوعَ البيانِ.. يغارُ مِنِّيَ (قنبرُ)",26,"ر",1,0],["ودخلنا كلنا جنتنا","لا نرى ذلاً ولا نلقى انهضاما",27,"م",2,0],["ودخولهم عين الخرو","ج بمقتضى القول السديد",28,"د",1,0],["ودخلوا في جملة الوفود","وعدد الجماعة العديد",29,"د",1,0],["وَدَخَلنا الدِيارَ ما نَشتَهيها","طَمَعاً أَن نَنالَها أَو تَرانا",30,"ن",2,0],["ودخلت جنات الوصال فحبذا","ما يجتنيه الطرف من صرفاتها",31,"ت",3,0],["ودخلت عاصمة الخلافة شيقاً","والصلحُ مَرْضِيُّ الشروطِ مليح",32,"ح",1,0],["وَدَخَلوا عِندَ السَمين المُعتَكف","وَهوَ بِها بالسَعد أَضحى مُكتَنف",33,"ف",1,0],["وَدَخَلوا الواحد بَعدَ الواحِدِ","وَلَم أَكُن أَحصيهم في العَدَدِ",34,"د",1,0],["وَدَخَلَت فيهِ عَواني الوالي","وَسَلَبوا الخَير مِن الأَموال",35,"ل",1,0],["وَدَخلَ الإِسطبل وَهوَ يَرتَعِد","وَلَم يُلاق مَن عَلَيهِ يَعتمد",36,"د",1,0],["وَدَخلَ الميدان مِنهُم طفَّه","وَأَخَذتهم بِالنسور الرَأفه",37,"ه",1,0],["ودخلت دارا ليس يب","رح من زواياها النخيرُ",38,"ر",1,0],["ودخيله فهو المظفر والذي","ياوي إليه له المواهب مغنمه",39,"م",2,0],["ودخلت جنات النعيم بهذه الدنيا","وفي الأخرى علا مثواكا",40,"ك",2,0],["ودخلت جنة حضرة لك طامعا","أن لست منها ما حييت بمخرج",41,"ج",1,0],["ودخلتُ في سلك القضاء مجاهداً","وحمِدتُ في فتح القلوب جهادي",42,"د",2,0],["وَدُخولُنا تِلكَ الرِياضُ","وَقَد خَلَت مِن كُلِّ طارِقِ",43,"ق",1,0],["ودخلتُمُ للحقِّ مِن بَابٍ وَمَا","دَخَلُوه وَاعَجَباً لِذَا الخُذلانِ",44,"ن",1,0],["وَدَخَلتُ رَوضَ الأَزبَكِيَّةِ وَالهَوى","يُزجي لِبَهجَتِها كَريمَ وِدادي",45,"د",2,0],["ودخلتُهَا بالليلِ لم تَقضِ حاجَةً","وَرُبَّ سُهُولِ في نهارٍ وحاجَةِ",46,"ه",1,0],["وَدُخَانُ مَائِكِ لَيسَ فِيهِ مَدخَلٌ","لِلخَلقِ بَل تَقدِيرُ مَولىً يُوجَدُ",47,"د",1,0],["ودخلنا حديقة ذات زهر","يانع في رباه غصنٌ رطيب",48,"ب",1,0],["ودخلت بيتاً لا أَنيس به","لكن جلست أُسامر الأملا",49,"ل",2,0],["ودخولية بثغر رشيد","وتلاشت مؤخرات المواضي",50,"ض",2,0],["ودخلوا في ظلِّ سامي القدر","قد نعموا وصار كلٌّ في منن",51,"ن",1,0],["ودخلن معرضهن بين جنينة","فيحاء رَوحُ رياضها فياح",52,"ح",1,0],["ودخلنَ بي للبيت واستجلسنني","فجلستُ كالمقرور يوم زعازعِ",53,"ع",1,0],["ودخلتُ عبقرَ وهي لي وَطَنٌ","منها حملتُ بدائعَ الفَنّ",54,"ن",1,0],["وَدَخَلتُ في حَرَمِ الذِمامِ وَحاطَني","خَفَرٌ أَخَذتُ بِه وَعَهدٌ مولِعُ",55,"ع",1,0],["وَدخولُ بَعضِ المُسلمينَ جَهَنَّماً","بِكَبائِرِ الآثامِ وَالطُغيانِ",56,"ن",1,0],["وَدُخان لَوعات القُلوبِ مخيماً","وَتنفُّسَ الصَعداءِ كَالنيرانِ",57,"ن",1,0],["وَدُخانُ هَذا الجَِّو أَنفاسٌ عَلَت","لِجَهَنَّم مِن صَدر أَقوامٍ لِئامْ",58,"م",1,0],["ودخوا بعزمهم قراكم","وأسَروا نساء مَن والاكم",59,"م",1,0],["ودخلوا المسجد أجمعينا","وهم بحمد الله معلنينا",60,"ن",2,0],["ودخلوا إلى فناء زمزم","وشربوا من مائها المكرم",60,"م",1,0],["ودخلوا من بعد ذا في العقبه","وقد رموا جمرتها المنتصبة",60,"ه",1,0],["ودَخلَ الدخالَ كُلُّ خارِجٍ","مِن بَحرِهِ كأنَّهُ رِجلُ الدّبى",61,"ا",1,0],["ودُخَانُ عودِ الهند","والشَّمعِ الُكَفر والعَبير",62,"ر",1,0],["ودخلتُ في ليلِ السُّهاد مؤرقاً","متهالِكاً مستوحِشاً ظِلّ الورى",63,"ر",2,0],["ودخلنا الهوى ومن كل فجٍ","وعجبنا من الهوى كيف ثارا",64,"ر",2,0],["وَدَخلْتُمَا التَّارِيخَ مِن أَبوَابِهِ","مِثلُ الأوائلِ أَيُّهَا العُظَمَاءُ",65,"ا",2,0],["ودخلوا له شيخٍ قال له.. إغتسل","ولقنوه الشهادة ولبسوه القناع",66,"ع",1,0],["ودخلتُ في بركان شوقك ذائبا","لم أسألِ الدرب الجريح محاذره",67,"ر",2,0],["ودخلت فصلها ما تدري ان العقاب","ينتظرها على باكورة الانسه",68,"س",2,0],["ودخلتُ عالمَكَ الجميلَ فما رأت","عينايَ إلاَّ دَوحةَ القرآنِ",69,"ن",1,0],["ودخلت في غربتي واقفلت بيباني","وصار الفرح والهنا دايم مجافيني",70,"ن",2,0],["ودخان الغدر محمود الدجى","ابلج الصبح بفجرٍ مخضلِ",71,"ل",1,0],["ودخلت البلاد من ألف بابٍ","وأقيمت » معابد « وجسورُ",72,"ر",1,0],["ودُخانُ الشَّذى عَبِقٌ","مَائِسٌ طيفُهُ كاَلْخَبَبْ",73,"ب",1,0],["ودخيلٍ تهزّه كلُّ ثكلى","لم تذق من مراضع البلغاء!",74,"ا",2,0]]}