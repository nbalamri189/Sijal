{"poems":[[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[85,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[85,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[45,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[61,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"كُلّما شاءَتِ الرُّسُومُ المُحيلَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32140",""],[113,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[115,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[187,"طال شوقي لطيبة الطيبات","https://www.aldiwan.net/poem35171.html","الخفيف"],[195,"يا جارة الوادي طربت وعادني","https://www.aldiwan.net/poem39810.html","الكامل"],[209,"جئت وحدى إلى الشواطىء ظهرا","https://www.aldiwan.net/poem46265.html","الخفيف"],[233,"ياابن الدوامي الذي","https://www.aldiwan.net/poem32128.html","مجزوء الكامل"],[280,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[302,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[326,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[351,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[365,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[400,"لله درك يا ابن إسماعيلا","https://www.aldiwan.net/poem33595.html","الكامل"],[426,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[462,"نظرت إلي بطرف أحوى أحور","https://www.aldiwan.net/poem3579.html","عموديه"],[477,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[542,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[556,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[556,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["ودخَلتُهُ وحدي وحوْلي موكبٌ","هَزِجٌ من الأَحلامِ والأَوهامِ",0,"م",1,0],["وَدَخل العِراقُ في وَلائِهِ","وَخَرَجَت مصرُ عَلى أَعدائِهِ",1,"ه",1,0],["ودخَلْتُ فِي ليلين: فَرْعِك والدُّجى","ولثمتُ كالصّبح المنوِّرِ فاكِ",2,"ك",1,0],["وَدُخاناً يَلُفُّ جُنحاً بِجُنحٍ","لا تَرى فيهِ مِعصَمَيها اليَمامَه",3,"م",2,0],["وَدَخيلاً مِنَ الصَبابَةِ لا يَت","رُكُ ماءَ الدُموعِ حَتّى يُسيلَه",4,"ل",2,0],["ودخلتُ أبوابَ الندامةِ بعدَما","عصفَت بيَ الأحداثُ عن أبوابِه",5,"ب",2,0],["ودخلتُه أجتازُ مزدحماً","بالخَلقِ أفواجاً وأفواجا",6,"ج",2,0],["ودخل المستضعفون فيها","كلّهمو خوف الأذى يخفيها",7,"ه",2,0],["ودخلتُ نفسَك لم أزاحِمْ حاجباً","عنها ، ولم ألجِ \" الرِواقَ \" فضولا",8,"ل",2,0],["وَد َخيلاٍ مِنَ الصّبَابَةِ مَا يَتْ","رُكُ مَاءَ الدَّمُوعِ، حتّى يُسيلَهْ",9,"ل",2,0],["ودخلنا بجاهه وبجاه ال","قوم آبائه بني الكرام",10,"ر",3,0],["ودُخانُ اللَّهيبِ تحت ضُلُوعي","كم أُخَبِّيهِ ساخرًا مِن دُخاني",11,"ي",1,0],["وَدَخلُتم مِن نوره في حصونٍ","فَسلمتُم مِن هذه الظلماتِ",12,"ت",1,0],["ودخلت في ليلين فرعك والدجى","والسكر أغراني بما أغراك",13,"ك",1,0],["ودخلت العباب في الظهر وحدى","وبقلبي من لج في الهجران",14,"ن",1,0],["وَدَخيلَ هَمٍّ لَو دَخَل","تَ إِلى عِيادَتِهِ خَرَج",15,"ج",1,0],["وَدَخَلتَها فَأَضاءَتِ اللُّمَعُ الَّتي","أَبدى بِها جُمَلَ السَنا الإيضاحُ",16,"ح",1,0],["ودخلنا المسجد الذي أسس على","التقوى بتأسيس خير إمام",17,"م",1,0],["ودخانٍ معطّرٍ نتعاطا","ه بعيدا في وكرِنا المستكنّ",18,"ن",1,0],["وَدُخان بارود الوَغى أَذكى لَهُ","مِن أَن تروِّحَهُ المَجامِرُ عَنبَرا",19,"ر",2,0],["وَدَخَلت البابَ لا أُعطِي الرُّشى","فَحَباني مَلِكٌ غَيرُ زَمِرْ",20,"ر",1,0],["ودخلت جنته التي قد ذُلِّلتْ","للعارفين قطوفُها تذليلا",21,"ل",2,0],["ودخان النار مذ عم بنا","ضيق النفس وأبكى مقلي",22,"ي",1,0],["ودخلت جنّة وجهها فأباحني","رضوانها المرجوُّ شرب المسكر",23,"ر",1,0],["ودخلت جنات النعي","م دخول حر ظافر",24,"ر",1,0],["ودخلتُ بيتَكِ في القصيدةِ خادماً","طوعَ البيانِ.. يغارُ مِنِّيَ (قنبرُ)",25,"ر",1,0],["ودخلنا كلنا جنتنا","لا نرى ذلاً ولا نلقى انهضاما",26,"م",2,0],["ودخولهم عين الخرو","ج بمقتضى القول السديد",27,"د",1,0],["ودخلوا في جملة الوفود","وعدد الجماعة العديد",28,"د",1,0]]}