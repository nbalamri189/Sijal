{"poems":[[88,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[46,"قولا لإبراهيم والفضل الذي","https://www.aldiwan.net/poem30402.html","الكامل"],[54,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[121,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[154,"حننت إلى العهد الذي كان فانقضى","https://www.aldiwan.net/poem68571.html","الطويل"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[290,"طرب الهزار وعمت البشرى فما","https://www.aldiwan.net/poem39429.html","الكامل"],[438,"دون بيض الخدور سمر العوالي","https://www.aldiwan.net/poem12694.html","الخفيف"],[438,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[469,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[495,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[509,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[580,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48767","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48516","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48849","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119978","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102691","المواليا"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112597","الكامل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71354","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108171","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91510","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139215","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76767","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52127","الكامل"],[4680,"سيُدبر الكرب","https://www.poetsgate.com/ViewPoem.aspx?id=186800",""],[4859,"روحٌ موحدةٌ.","https://www.poetsgate.com/ViewPoem.aspx?id=207843",""],[4955,"ألا يا ويح من ظلموا","https://www.poetsgate.com/ViewPoem.aspx?id=188778",""],[4962,"ابتَسِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=201737",""],[5096,"نسيم الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=206571",""],[5135,"مَا أَخْلَفَ الرَّحْمَٰنُ يَوْماً مَوْعِدَا","https://www.poetsgate.com/ViewPoem.aspx?id=201976",""],[5206,"مسألَة في قراءة القرآن على القبر","https://www.poetsgate.com/ViewPoem.aspx?id=187420",""],[5413,"ديغول عادَ","https://www.poetsgate.com/ViewPoem.aspx?id=208605",""],[5431,"تعويذة","https://www.poetsgate.com/ViewPoem.aspx?id=201776",""],[5512,"إلى العرب","https://www.poetsgate.com/ViewPoem.aspx?id=204925",""],[5612,"حَتْماً سَيَشْفى الجُرْح","https://www.poetsgate.com/ViewPoem.aspx?id=181614",""],[5660,"أَنتَ الشَريفُ شَريفٌ في مُحَيّاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=23714",""],[5783,"لم تعقمي يا أمة الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=34050",""],[5906,"يا عازف النّاي","https://www.poetsgate.com/ViewPoem.aspx?id=188074",""],[5916,"صرخة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=190527",""],[5966,"يا أمة العُرْب","https://www.poetsgate.com/ViewPoem.aspx?id=158310",""],[6093,"يا جاثياً في رسُوم الحيِّ معتكفا (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176186",""],[6152,"نبض وفي","https://www.poetsgate.com/ViewPoem.aspx?id=202540",""],[6152,"ياسمين الشام","https://www.poetsgate.com/ViewPoem.aspx?id=208661",""],[6152,"لا بأس يا بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215639",""]],"verses":[["حَتمٌ قَضاؤُهُما حَتمٌ جَزاؤُهُما","فَاِربَأ بِنَفسِكَ أَن تُمنى بِخُسرانِ",0,"ن",1,0],["حَتَمٌ عَلَيهِ لَعاً لِعَثرَةِ حالِهِم","قَد تَعثُرُ الحالاتُ ثُمَّ تُقالُ",1,"ل",1,0],["حَتمٌ عَلَيكَ إِذا حَلَلتَ مَغانَهُم","أَلّا تَراهُ عافِياً مِن عافِ",2,"ف",1,0],["حَتمٌ عَلى الفَلَواتِ يَطوي بُعدَها","بِالنَصِّ وَالإِرمالِ وَالإِدلاجِ",3,"ج",1,0],["حتمٌ عليَّ رحيلي","فإنني قد نويت",4,"ت",1,0],["حتم المصير له الى دار البقا","ولنعم دار بدلت من دار",5,"ر",1,0],["حَتْمًا، وأَكْثَرُكُمْ على إخوانِهِ","مُتَآمِرٌ ومُخادِعٌ كَذَّابُ",6,"ب",1,0],["حَتمتُ عَلى قَلبِي تَرقُّبَ بَابهِ","عَسى مُغلِقُ الأوابِ يُعقِبُها فَتحا",7,"ح",2,0],["حَتمٌ مِنَ اللَهِ أَن يُطاعوا فَما","تُعصى لَهُم إِمرَةٌ إِذا أَمَروا",8,"ر",3,0],["حتما يدين بطاعة لخليفة ال","إسلام جهرا لا يرى عنها محيد",9,"د",1,0],["حتّم الله أنّ ذكرَك يبقى","في المعالي به ممرّ الليالي",10,"ل",2,0],["حتّم اللهُ أن علياكَ لا تَف","نَى برُغْم الحَسودِ حتى القيامَهْ",11,"م",2,0],["حتم على الأعناق طاعة سيفه","والحرب شامسة على أبنائها",12,"ا",3,0],["حَتَمَ الدَهرُ عَلَينا أَنَّهُ","ظَلَفٌ ما نالَ مِنّا وَجُبارُ",13,"ر",1,0],["حتم على النظار عند لقائه","التسبيح والتكبير والتلهيل",14,"ل",1,0],["حتَّمتُ أَنِّي ضَائِعٌ إِنْ جَرى","عليه حُكْمُ القَدْرِ في الجِسْمِ",15,"م",1,0],["حتم تحديك المُصِرَّ على الأذى","من بعد عفوك عنه والإغضاء",16,"ا",2,0],["حتمٌ على ابن النيل ذكرى طلعة","لك قد أضاءت أعيناً وقلوبا",17,"ب",2,0],["حتمٌ على الأكفاء والأنداد أن","يسعوا رفاقاً للحمى وصِحابا",18,"ب",2,0],["حتم عليه بذل جود راتب","ما كن قط لحانم في النادرِ",19,"ر",1,0],["حتم يصبر من طلب وصل الملاح","أو يكن عنده إلى العليا ارتياح",20,"ح",1,1],["حتما سيأخذكم على أعناقكم","يوم بأخذ الظالمين رهيب",21,"ب",1,0],["حتم بالإقامة النواتي","في مهمة ليس به مواتي",22,"ي",1,0],["حَتَمْتُ عَلى قَلْبِي مَرَاقِبَ بَابِهِ","عَسَى مُغْلِقُ الأَبْوَابِ يُعْقِبُهَا فَتْحَا",23,"ح",2,0],["حتم على الاجفان ان تجري اسفاً","لكنها تجري بدون تحتم",24,"م",1,0],["حتمٌ عَلى كُلِّ ذي ذَوقٍ وَذي أَدَبٍ","ذلُّ الهَوى كَيفما تقضي بهِ الصدف",25,"ف",1,0],["حتم الحب على ذي الحب أن","لا يرى المحبوب إلا في كمال",26,"ل",1,0],["حتمٌ على الملك أن يقوى وقد وصلت","بالشرق والغرب يمناه ويسراه",27,"ا",2,0],["حَتَمت عليَّ صفاتُك الغرّاء أَن","أَقِفَ الزمانَ لها اللسانَ شكورا",28,"ر",2,0],["حتماً سيأتي إليك الدهرُ معتذراً","عمّا مضى تائباً يهتزَّ مُرتعدا",29,"د",2,0],["حتما سينبيكَ عن نفسٍ ذوت شغفاً","وعن رياح نوىً كم بعثرت باسَك",30,"ك",1,0],["حتماً ستغرقُ في قاعِ العذابِ أيا","مَنْ قد سبحتَ ببحرٍ ماؤهُ ندمُ",31,"م",1,0],["حتماً سيأتي بعده","يسرٌ به تُجلى الظلم",32,"م",1,0],["حتما سيُبْترُ شُؤْماً جاء مكْتسحًا","بطرْفهِ طال فكْراً فاض كالودقِ",33,"ق",1,0],["حَتْماً سَيَمْحًُوْهَا الصَّبَاحُ بِنُوْرِهِ","فِي لَحْظَةٍ أَجِدُ الحَنَادِسَ عَسْجَدَا",34,"د",2,0],["حَتمُ النَّدَى سُمُّ العِدَى بَدْرُ الدُّجَى","شَمْسُ الوَرَى نَقْبُ الهُدَى خُلْصَانِ",35,"ن",1,0],["حتما سنبقى له حتَّى يكون لنا","حريةٌ حرةٌ منْ كلِّ ما رسما",36,"م",2,0],["حتما سيبعثها موتٌ وتغبطه","لو أنّ نجم الهوى قد ضلّ أو هبطا",37,"ط",2,0],["حتماً سيهوي فوقَ أضلُعِكُمْ","إنْ نامتِ الأرواحُ كالصَّنمِ",38,"م",1,0],["حَتْماً سَيَشْفى الجُرْحُ بعْدَ تألُّمٍ","وبُعيْدَ نأْيِكَ - يا غريبُ - تلاقي",39,"ق",2,0],["حَتماً سَنَذكُرُ ، هَل نَنساكَ أَحكَمَنا","أَم كَيفَ نَهنا إِذا كُنّا نَسيناكَ",40,"ك",1,0],["حتما سيأتي ذلك اليوم الذي","النور يصحو..والظلام يهون",41,"ن",1,0],["حتما سأرقص إن أطربتني ألما","ليلي عليك ولن تحتاج لي فجرا",42,"ر",2,0],["حَتْمَاً لَنَا سَاعَةٌ منْ غَيْرِ جَارِحَةٍ","نَصْبُوْ لَهَا حَمَقَاً منْ غيْرَةِ الْسَبَبِ",43,"ب",1,0],["حتْماً سنبني شِرَاعَ النَّصْرِ فارِهَةً","ونرتَقي في العُلا بالعِزِّ والرُّتَبِ",44,"ب",1,0],["حتماًَ سنطردُ مِنْ أقْداسنا نَجَسَاً","لصَوْلةُ النَّخلِِ قلبُ الغرقدُ ارتجفا",45,"ف",2,0],["حتما ستبقين الأخيرة في دمي","فالنبض لا يُغتال في قلب الوفي",46,"ف",2,0],["حتما سينقشع الظلام بشامنا","ويزول ليل الظلم مهما طالا",47,"ل",2,0],["حتما سيرجع للحقول أريجها","ويعود للوطن الجريح وئام",48,"م",1,0]]}