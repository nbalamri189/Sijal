{"poems":[[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[73,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[44,"قولا لإبراهيم والفضل الذي","https://www.aldiwan.net/poem30402.html","الكامل"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[117,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[150,"حننت إلى العهد الذي كان فانقضى","https://www.aldiwan.net/poem68571.html","الطويل"],[235,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[285,"طرب الهزار وعمت البشرى فما","https://www.aldiwan.net/poem39429.html","الكامل"],[432,"دون بيض الخدور سمر العوالي","https://www.aldiwan.net/poem12694.html","الخفيف"],[432,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[464,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[490,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[504,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[575,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"]],"verses":[["حَتمٌ قَضاؤُهُما حَتمٌ جَزاؤُهُما","فَاِربَأ بِنَفسِكَ أَن تُمنى بِخُسرانِ",0,"ن",1,0],["حَتَمٌ عَلَيهِ لَعاً لِعَثرَةِ حالِهِم","قَد تَعثُرُ الحالاتُ ثُمَّ تُقالُ",1,"ل",1,0],["حَتمٌ عَلَيكَ إِذا حَلَلتَ مَغانَهُم","أَلّا تَراهُ عافِياً مِن عافِ",2,"ف",1,0],["حَتمٌ عَلى الفَلَواتِ يَطوي بُعدَها","بِالنَصِّ وَالإِرمالِ وَالإِدلاجِ",3,"ج",1,0],["حتمٌ عليَّ رحيلي","فإنني قد نويت",4,"ت",1,0],["حَتْمًا، وأَكْثَرُكُمْ على إخوانِهِ","مُتَآمِرٌ ومُخادِعٌ كَذَّابُ",5,"ب",1,0],["حَتمتُ عَلى قَلبِي تَرقُّبَ بَابهِ","عَسى مُغلِقُ الأوابِ يُعقِبُها فَتحا",6,"ح",2,0],["حَتمٌ مِنَ اللَهِ أَن يُطاعوا فَما","تُعصى لَهُم إِمرَةٌ إِذا أَمَروا",7,"ر",3,0],["حتما يدين بطاعة لخليفة ال","إسلام جهرا لا يرى عنها محيد",8,"د",1,0],["حتّم الله أنّ ذكرَك يبقى","في المعالي به ممرّ الليالي",9,"ل",2,0],["حتّم اللهُ أن علياكَ لا تَف","نَى برُغْم الحَسودِ حتى القيامَهْ",10,"م",2,0],["حتم على الأعناق طاعة سيفه","والحرب شامسة على أبنائها",11,"ا",3,0],["حَتَمَ الدَهرُ عَلَينا أَنَّهُ","ظَلَفٌ ما نالَ مِنّا وَجُبارُ",12,"ر",1,0],["حتم على النظار عند لقائه","التسبيح والتكبير والتلهيل",13,"ل",1,0],["حتَّمتُ أَنِّي ضَائِعٌ إِنْ جَرى","عليه حُكْمُ القَدْرِ في الجِسْمِ",14,"م",1,0]]}