{"poems":[[79,"يحييك بالريحان والروح من قبر","https://www.aldiwan.net/poem36490.html","الطويل"],[24,"نفى شعر الرأس القديم حوالقه","https://www.aldiwan.net/poem21873.html","الطويل"],[75,"قل لأبي حفص ولم تكذب","https://www.aldiwan.net/poem11984.html","السريع"],[29,"وباكية من نأي قيس وقد نأت","https://www.aldiwan.net/poem5707.html","الطويل"],[87,"يمد الدجى في لوعتي ويزيد","https://www.aldiwan.net/poem63672.html","الطويل"],[58,"وباكرت الصبوح على صباح","https://www.aldiwan.net/poem58550.html","الوافر"],[64,"بالله يا ريح إن مكنت ثانية","https://www.aldiwan.net/poem52410.html","البسيط"],[47,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[63,"وباكر لغيره ما يرزق","https://www.aldiwan.net/poem51501.html","الرجز"],[63,"وباكية ليلها كله","https://www.aldiwan.net/poem51732.html","المتقارب"],[68,"يا من غدا للأنام غيثا","https://www.aldiwan.net/poem39069.html","مجزوء البسيط"],[82,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42523","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67299","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43722","الوافر"],[173,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[186,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[190,"وأول جمرة سقطت أثارت","https://www.aldiwan.net/poem43635.html","الوافر"],[234,"وباكية متوجة بنار","https://www.aldiwan.net/poem51027.html","الوافر"],[234,"وباكية من غير دمع بأعين","https://www.aldiwan.net/poem51070.html","الطويل"],[240,"عسى الدهر يوما بالبخيلة يسمح","https://www.aldiwan.net/poem32121.html","الطويل"],[254,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[257,"بكا آمناً أن صار ستراً عَلى الحب","https://www.aldiwan.net/poem1439.html",""],[264,"رويدك حادي الركب فالجد مسعر","https://www.aldiwan.net/poem35933.html","الطويل"],[302,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[327,"ما الناس إلا في رماق وصالح","https://www.aldiwan.net/poem56355.html","الطويل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[435,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[435,"ساقي المدام فزند الشوق قد قدحا","https://www.aldiwan.net/poem40532.html","البسيط"],[463,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[466,"وراءك أقوال الوشاة الفواجر","https://www.aldiwan.net/poem15085.html","الطويل"],[469,"وباك أسى خداه تحت دموعه","https://www.aldiwan.net/poem3593.html","عموديه"],[487,"أطلعن في قمر الأفوق شموسنا","https://www.aldiwan.net/poem24426.html","عموديه"],[566,"يا رب أنت تجبر الكسيرا","https://www.aldiwan.net/poem27849.html","الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96970","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54089","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104568","السريع"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18519","الطويل"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115098","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62538","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62523","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138115",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72280","الخفيف"],[1120,"","https://poetry.dctabudhabi.ae/diwan/poem/73939","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73982","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80015","الطويل"],[1612,"","https://poetry.dctabudhabi.ae/diwan/poem/147585","الهزج"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123676","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110343","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110328","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113736","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53057","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93712","الوافر"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110660","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65981","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100178","الطويل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123880","المتقارب"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99313","الطويل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116848","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129462","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36735","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123528","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139838",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59449","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59463","الوافر"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114859","الوافر"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75713","الرمل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105261","الطويل"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147649","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93250","الرمل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81921","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4916,"عوااافي","https://www.poetsgate.com/ViewPoem.aspx?id=157546",""],[5183,"المصاب المؤلم","https://www.poetsgate.com/ViewPoem.aspx?id=180255",""],[5183,"منزل الشان","https://www.poetsgate.com/ViewPoem.aspx?id=180213",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5525,"الطير","https://www.poetsgate.com/ViewPoem.aspx?id=993",""],[5953,"وباكي يبكي على ربه","https://www.poetsgate.com/ViewPoem.aspx?id=93796",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["وباكَرَ عيد الفِطْرِ والأمْرُ مُبْرَمٌ","وليسَ سِوى كأس الشّهادَةِ من فِطْرِ",0,"ر",1,0],["وَباكَرنَ جَوفاً تَنسُجُ الريحُ مَتنَهُ","تَناءَمُ تَكليمَ المَجوسِ غَرانِقُهُ",1,"ق",2,0],["وَباكِرا الطيبَ وَروحا لَهُ","فَأَنتُما في زَمَنٍ طَيِّبِ",2,"ب",1,0],["وَباكِيَةٍ مِن نَأيِ قَيسٍ وَقَد نَأَت","بِقَيسٍ نَوى بَينٍ طَويلٍ بِعادُها",3,"د",3,1],["وَباكٍ وَلا دَمعٌ وَشاكٍ وَلا جَوىً","وَجَذلانُ يَشدو في الرُبى وَيُشيدُ",4,"د",1,0],["وباكَرْتُ الصَّبوحَ على صَبَاحٍ","يَلُوحُ مِنَ السّوالِفِ والسُّلافِ",5,"ف",1,1],["وباكرِي وِرْدَ عذبٍ من مُقَبَّلِهِ","مقابل الطعمِ بين الطِيبِ والخَصرِ",6,"ر",1,0],["وَباكِيَةٍ تَشكو الفِراقَ بِأَدمُعٍ","تُبادِرُها سَحّاً كَما اِنتَثَرَ العِقدُ",7,"د",1,0],["وباكِرٍ لِغَيْره ما يُرْزَقُ","مُثْرٍ به طَوْراً وطَوْراً مُخْفِقُ",8,"ق",1,1],["وباكيةٍ ليلَها كلَّه","تحاكي الصَّباحَ بمِصباحِها",9,"ح",3,1],["وَباكِرِ الراحَ كُلَّ يَومٍ","وَلا تَرُم دونَها اِلتِباثا",10,"ث",2,0],["وباكيةٍ بعيونِ الجراحِ","إذا ضحكت عن ثغور الأسَل",11,"ل",1,1],["وباكرتها سماءٌ من مآثره","فيها لكلِّ صنيعٍ منه لألاءُ",12,"ا",2,0],["وَبَاكِيَةٍ شَجَتْ قَلْبِي بِلَحْنٍ","تَهِيجُ لَهُ الْمَسامِعُ وَالْقُلوبُ",13,"ب",1,1],["وباكيةٍ حِراءَ تَحْزَنُ بالبُكا","وَتَلْطمُ مِنها خَدَّها والمُقلَّدا",14,"د",2,1],["وَباكِيَةٍ تَقولُ بَغى","عَلى اِبنِكَ صنوُهُ وسطا",15,"ط",2,1],["وَباكِر الراحَ فَاِشرَبها مُعتَّقَةً","صِرفاً تُحَدِّثُ عَن حِجرٍ وَبانيها",16,"ي",3,0],["وَباكية لَما أَظَلَّ فراقَنا","وَما أَوشَكَت تَرجو لِوَصليَ مَرجَعا",17,"ع",2,0],["وباكرنا بها غيثٌ مغيثٌ","على عطش المنابت والزروع",18,"ع",1,0],["وباكيةٍ متَوَّجةٍ بنارِ","كأنّ دموعَها حَبَبُ العُقَارِ",19,"ر",1,1],["وباكيةٍ من غير دمع بأعينٍ","على غير خدّ دائماً تتحدّرُ",20,"ر",1,1],["وَباكِيَةٍ لَم تَشكُ فَقداً وَلا رَمى","بِجَمرَتِها الأَدنينَ نَأيٌ مُطَوِّحُ",21,"ح",1,0],["وَباكَرَهُ عِندَ الشُروقِ مُكَلِّبُ","أَزَلُّ كَسِرحانِ القَصيمَةِ أَغبَرُ",22,"ر",1,0],["وَباكٍ بأَرض الشام امّا صَبابَةً","إِلى الاَهلِ أَو غَيظاً لِمعجز عَن الكُتب",23,"ب",1,0],["وباكر إذا الركب اليمانيّ قد نوى","لنجد الصبا إذ لا يليق التأخّر",24,"ر",1,0],["وباكر وصل في بكرة وأصائل","صلاةً على الأصل الّذي فيه تفخر",24,"ر",1,0],["وَباكرتُ رميي لِلجِمار وإِنَّما","رَميتُ بها قَلب التَباعُدِ بالجَمرِ",25,"ر",1,0],["وَباكٍ شَجاً وَضاحِكٌ عِندَ بَهجَةٍ","وَآخَرُ مُعطىً صِحَّةً وَضَريرُ",26,"ر",1,0],["وباك على أمسه ضاحك","لغرّة فجر بعيد الظلال",27,"ل",1,0],["وباكٍ على يومه قبل أن","يحرّره الغيب من قيده",27,"ه",1,0],["وباكيةٍ تَحِنُّ لغَيْرِ وَجْدٍ","وتَندُبُ في الغُدُوِّ وفي العَشايا",28,"ا",3,0],["وباكٍ بما جرَّ الفِراقُ جَهولُ","نَعَمْ هذهِ الأطْلالُ قَفْرٌ فَأَرْبعِ",29,"ع",1,0],["وباكر روضها معطار وجدٍ","تطيب به المنازل والرباعُ",30,"ع",1,0],["وباكر الروض وانشق عرفه سحراً","واجلُ الكؤوس وخذها بكرةً وضحا",31,"ح",2,0],["وباكرتْ ربعَك التهاني بمو","شيٍّ من المدح رصفُه رقْمُ",32,"م",1,0],["وباكرتْ وراوحتْ","ربعَك سُحْبُ نظمي",33,"م",2,0],["وباكٍ إذا ما أجْدبَ العامُ عنده","سقى التُرابَ من أجفانه بالمواطرِ",34,"ر",1,0],["وباكٍ أسىً خدّاه تحت دموعهِ","كوجنة كأس زيّنتها فواقعُ",35,"ع",1,1],["وبأكؤس أطلعن في جنح الدجى","شمس السلافة في سما خندريسا",36,"س",2,0],["وَباكَرَت واجِمَةً نَميرا","لا آجِنَ الماءِ وَلا مَأطورا",37,"ر",2,0],["وباكية حرى الفؤاد دموعها","تصعد عن قلب من الوجد ذائب",38,"ب",1,0],["وباكور بستان دنا وقت جنيه","فأضحى يروق الطرف عند التوسمِ",39,"م",1,1],["وباكَرَ العلياءَ فافتضّها","وكانتِ الناهِدَةَ البِكرا",40,"ر",2,0],["وباكرِ اللّذّةَ في حِينها","وقُم بنا ننتهبُ العُمرا",40,"ر",2,0],["وَباكِيَةٍ تَبكي عَلى قَبرِ فَندَشٍ","فَقُلتُ لَها أَذري دُموعَكِ وَاِخمِشي",41,"ش",2,0],["وباكٍ على من لا تواتيك دارُهُ","ورامٍ بعينيك الفجاجَ فزَافرُ",42,"ر",1,0],["وبأكباد الأعادي","كم له سهم مصيبْ",43,"ب",1,0],["وبأكناف رامةٍ ظَبَياتٌ","جرّدت للأسود بيض ظُبَاها",44,"ا",3,0],["وباكية فوق الغصون ترنمت","فهاجت هياماً في الجوانح ثاويا",45,"ي",2,0],["وبأكواب فضة وقوارير","قوارير قدرت تقديرا",46,"ر",2,0],["وَباكورَةٍ سَوداءَ مَخطوطَةٍ بَدَت","كَمِثلِ غُرابٍ في ذَر الغُصنِ أَبقَعِ",47,"ع",1,1],["وباكرِ الشرب على","وجه الربيع المسفر",48,"ر",1,0],["وَباكر السوق وَعادَ تاجِرا","وَلَم يَكُن بَينَ التجار خاسِرا",49,"ر",2,0],["وباكيَه لا تبكي بالدمع وحده","بلى بدم الأحشاء مدّ اندفاعه",50,"ع",2,0],["وباكيةٍ على النّهر","تنوحُ ودمعُها يَجري",51,"ي",1,1],["وبأكناف الحمى لي جيرة","حبهم فرض على طول المدى",52,"د",2,0],["وباكري الأزهر الميمون منبئةً","عن اخته فهي والخنساء اختان",53,"ن",1,0],["وباكري محفل اليوبيل ناثرةً","على مطالعه أزهار نيسان",54,"ن",1,0],["وباكَرَني في حاجةٍ لم يجد لها","سوايَ ولا من نَكبَةِ الدهر ناصرُ",55,"ر",1,0],["وباكرته النعامى وهي حاملة","ريح الخزامى إلى ما فيه من طيبِ",56,"ب",1,0],["وَباكرها مِن الوسميِّ غَيثٌ","تَريع بِهِ البَطايحُ وَالحزوم",57,"م",1,0],["وباكر بكاسات المدام منادما","فأطيب كاسات المدام بكورها",58,"ر",3,0],["وباك على ما كان مني وقد جرى","من القول فيهم في الليالي الأوائل",59,"ل",1,0],["وباكرها صرف القضاء وكم غدا","يجور على أهل المعالي ويعتدي",60,"د",2,0],["وباكر معتقة زانها","مرور الليالي بها والحقب",61,"ب",1,0],["وباكرني أشياخ قومي فاكثروا ال","فضول لعمري والاذى والتعجبا",62,"ب",2,0],["وباكيةٍ تبكي زباباً وقائلٌ","جزى اللَه خيراً ما أعفَّ وأمنعا",63,"ع",2,0],["وباكرتها في مسهل رعوده","صهيل الجياد الصافنات متى همى",64,"م",2,0],["وَباكرها الوَسميُّ يَنثُر لُؤلُؤاً","مِنَ الطَلّ في سلك البَهاءِ تَنظّما",65,"م",2,0],["وبَاكَرتْ ذاك الضَّرِيحَ سُحْرةً","حَوامِلُ المُزْن يُحثُّها الصَّبَا",66,"ا",1,0],["وباكرها رطب النسيم معطرا","بما الكرام القطر من أرج الذكر",67,"ر",1,0],["وباكرتهم تحيات حقائبها","راحت تفتق الربى في روضها النضر",68,"ر",1,0],["وباكر بطحاءَ الفُليج بعارضٍ","همي فابنَّت وارتعَنَّتْ هواضُبهْ",69,"ب",2,0],["وبَاكرَها الذّراع بمُسْبكِرٍّ