{"poems":[[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67299","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119360","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64428","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106868","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125820","الطويل"],[4959,"خَيْطُ الْفَجْر ؛ وَخَطُّ الْفَقْر","https://www.poetsgate.com/ViewPoem.aspx?id=216040",""],[5431,"على لسان نازح سوري...","https://www.poetsgate.com/ViewPoem.aspx?id=209152",""],[5776,"فراغُ الفهارس","https://www.poetsgate.com/ViewPoem.aspx?id=199333",""],[5309,"يطيب لبعض الناس ابداء تحبيذ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573942",""]],"verses":[["وأفْظَعِهِمْ فَقْداً على كُلِّ مُسْلِمٍ","وأعْظَمِهمْ في النّاسِ كُلِّهمُ يَدا",0,"د",2,0],["وأفظع من ضرب النحور وأسرها","مجاورة تؤذي رجال المكارم",1,"م",1,0],["وَأَفْظَعَتْ داهِيَةٌ صَمَامِ","ذَبَّبْتَ تَذْبِيبَ امْرِئٍ مُحامِ",2,"م",1,0],["وافظع يا جبار صدعي وبرحت","بضعفي يا جبار كل رزيئة",3,"ه",1,0],["وأفظعُ خطبٍ أن تموتَ عواطف","وتُقفرَ منها أنفسٌ وجسوم",4,"م",1,0],["وأفظَعث من شجن يعضك قيدُهُ","صديق بما لاقيته بات مسرورا",5,"ر",2,0],["وَأَفْظَعُ مَا يَرَوْنَ بِهَا","هُوَ الْإِذْلَالُ وَالْقَهْرُ",6,"ر",1,0],["وأفظع مايكون ضباع حكم","بأنياب من الحقد الزهوق",7,"ق",1,0],["وأفظعُ منْ لحنِ كلِ المراثي","وأقذرُ من صدّ كل الدّسائسْ",8,"س",1,0],["وَأَفظَعُ تَدجيلٍ دَهَتنا شُرورُهُ","صِياغَةُ قانونٍ وَإِهمالُ تَنفيذِ",9,"ذ",1,0]]}