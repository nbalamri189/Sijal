{"poems":[[87,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[47,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[111,"سميري وهل للمستهام سمير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545431",""],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[154,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[203,"وبي زهرة في جانب النيل قد نمت","https://www.aldiwan.net/poem45140.html","الطويل"],[241,"يا رب أدفئني فقد خصرت","https://www.aldiwan.net/poem18091.html","الرجز"],[241,"بك الدر يا درا به حلية الدهر","https://www.aldiwan.net/poem18815.html","الطويل"],[275,"لا عين العين فعل البيض والاسل","https://www.aldiwan.net/poem52059.html","البسيط"],[361,"سأرمي بنبلي ذائدا عن حمى نبلي","https://www.aldiwan.net/poem4151.html","الطويل"],[561,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[565,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"],[578,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"]],"verses":[["وَفي زاوِيَةِ السِجنِ","وَفي سِلسِلَةِ القَيدِ",0,"د",1,0],["وَفي زَرودَ تَبيعٌ لَيسَ يُمهِلُنا","تَقاضِياً وَغَريمٌ لَيسَ يَقضينا",1,"ن",2,0],["وَفِي زِيَادَتِهِمْ آثَارُ مُنْجِبِهِمْ","مَعْنىً مِنَ الكَرَمِ المُورُوثِ قَدْ لَطفَا",2,"ف",2,0],["وفي زخرف القول إزدهاء لمن غوى","والهنة عن لب الصواب قشور",3,"ر",1,0],["وفي زخرف القول ازدهاء لمن غوى","والهتة عن لب الصواب قشور",4,"ر",1,0],["وَفي زَمانِكَ خَلّى الدَهرُ عادَتَهُ","وَعادَ مِن فِعلِهِ المَذمومِ يَعتَذِرُ",5,"ر",1,0],["وَفي زَورَةِ المُختارِ أَقصى مُؤَمَّلي","سابكي لِبُعدِ الدارِ عَنهُ فَإِنَّ لي",6,"ي",1,0],["وفي زمن تصفو علي كما صفا","وفي زمن ما من تكدرها بد",7,"د",1,0],["وَفِي زِمَامِ حُبِّهِ ارْتَسَمْتُ","وَإِنْ أَكُنْ عَنْ هَدْيِهِ قَدْ نِمْتُ",8,"ت",1,0],["وَفِي زَهَرٍ مِنْ رَوْضِ شِعْرِكَ يَانِعٍ","حَيَاةُ النُّهَى الْعُظْمَى وَمَا ذَاكَ فِي الزَّهْرِ",9,"ر",1,0],["وَفي زيارتهم نجح المطالب من","محو الذنوب وَستر الحوب وَالزلل",10,"ل",1,0],["وَفي زَمَنٍ أغضَى لِيَخبُرَ أهلَهُ","فَأكسَبَهُ الإِغضَاءُ ضَرباً مِنَ الخَبلِ",11,"ل",1,0],["وفي زمزم الإقبال كان اغتسالنا","عشية أجنبنا بمس الأجانب",12,"ب",1,0],["وفي زِيارةِ مِصرٍ لو ظَفِرتُ بها","مَشَقَّةٌ تُعقِبُ الأتعابَ بالظَفَرِ",13,"ر",1,0],["وفي زمانِ ابن أَيوبٍ غَدتْ حلبٌ","من أَرض مصرَ وعادت مصرُ من حلبِ",14,"ب",1,0]]}