{"poems":[[87,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[47,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[111,"سميري وهل للمستهام سمير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545431",""],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[154,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[203,"وبي زهرة في جانب النيل قد نمت","https://www.aldiwan.net/poem45140.html","الطويل"],[242,"يا رب أدفئني فقد خصرت","https://www.aldiwan.net/poem18091.html","الرجز"],[242,"بك الدر يا درا به حلية الدهر","https://www.aldiwan.net/poem18815.html","الطويل"],[276,"لا عين العين فعل البيض والاسل","https://www.aldiwan.net/poem52059.html","البسيط"],[362,"سأرمي بنبلي ذائدا عن حمى نبلي","https://www.aldiwan.net/poem4151.html","الطويل"],[563,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[567,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"],[580,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107331","الرجز"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66978","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46515","الرجز"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216506","المتقارب"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123175","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71077","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47108","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68098","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88970","الوافر"],[3771,"","https://poetry.dctabudhabi.ae/diwan/poem/67774","المتقارب"],[4676,"ثورة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=206651",""],[4578,"لولد لي الأنس بعيش رغيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=49399",""],[4984,"الإضراب","https://www.poetsgate.com/ViewPoem.aspx?id=196918",""],[4984,"نُغَالِبُ دُنْيَانَا","https://www.poetsgate.com/ViewPoem.aspx?id=206076",""],[5237,"أبت همي إلا الولوع بمن تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=113109",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5431,"أوصيك","https://www.poetsgate.com/ViewPoem.aspx?id=183196",""],[5437,"بياض الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=144443",""],[5459,"رقصنا","https://www.poetsgate.com/ViewPoem.aspx?id=190907",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5582,"أَلا كُلُّ عَيْشٍ صَفْوُهُ يَتَكَدَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187148",""],[6025,"وسواس","https://www.poetsgate.com/ViewPoem.aspx?id=35606",""],[6045,"همسات السراجي","https://www.poetsgate.com/ViewPoem.aspx?id=135937",""]],"verses":[["وَفي زاوِيَةِ السِجنِ","وَفي سِلسِلَةِ القَيدِ",0,"د",1,0],["وَفي زَرودَ تَبيعٌ لَيسَ يُمهِلُنا","تَقاضِياً وَغَريمٌ لَيسَ يَقضينا",1,"ن",2,0],["وَفِي زِيَادَتِهِمْ آثَارُ مُنْجِبِهِمْ","مَعْنىً مِنَ الكَرَمِ المُورُوثِ قَدْ لَطفَا",2,"ف",2,0],["وفي زخرف القول إزدهاء لمن غوى","والهنة عن لب الصواب قشور",3,"ر",1,0],["وفي زخرف القول ازدهاء لمن غوى","والهتة عن لب الصواب قشور",4,"ر",1,0],["وَفي زَمانِكَ خَلّى الدَهرُ عادَتَهُ","وَعادَ مِن فِعلِهِ المَذمومِ يَعتَذِرُ",5,"ر",1,0],["وَفي زَورَةِ المُختارِ أَقصى مُؤَمَّلي","سابكي لِبُعدِ الدارِ عَنهُ فَإِنَّ لي",6,"ي",1,0],["وفي زمن تصفو علي كما صفا","وفي زمن ما من تكدرها بد",7,"د",1,0],["وَفِي زِمَامِ حُبِّهِ ارْتَسَمْتُ","وَإِنْ أَكُنْ عَنْ هَدْيِهِ قَدْ نِمْتُ",8,"ت",1,0],["وَفِي زَهَرٍ مِنْ رَوْضِ شِعْرِكَ يَانِعٍ","حَيَاةُ النُّهَى الْعُظْمَى وَمَا ذَاكَ فِي الزَّهْرِ",9,"ر",1,0],["وَفي زيارتهم نجح المطالب من","محو الذنوب وَستر الحوب وَالزلل",10,"ل",1,0],["وَفي زَمَنٍ أغضَى لِيَخبُرَ أهلَهُ","فَأكسَبَهُ الإِغضَاءُ ضَرباً مِنَ الخَبلِ",11,"ل",1,0],["وفي زمزم الإقبال كان اغتسالنا","عشية أجنبنا بمس الأجانب",12,"ب",1,0],["وفي زِيارةِ مِصرٍ لو ظَفِرتُ بها","مَشَقَّةٌ تُعقِبُ الأتعابَ بالظَفَرِ",13,"ر",1,0],["وفي زمانِ ابن أَيوبٍ غَدتْ حلبٌ","من أَرض مصرَ وعادت مصرُ من حلبِ",14,"ب",1,0],["وفي زكيِّ الطبع للدونِ رضا","والاعتراضُ في الجهولِ مقتضَى",15,"ض",2,0],["وفي زَنْدِهِ الرَّيَّانِ سُوْرٌ تَعَضُّهُ","فَيَدْمَى كما ثَارَ الشَّرارُ من الزَّنْدِ",16,"د",1,0],["وَفي زرود شبل لَيث في أَجم","لا يَدفع الخصم إِذا الخَصم هَجَم",17,"م",1,0],["وفي زحمة من صراع الحنين","ستذكر آصالنا والبكر",18,"ر",1,0],["وفي زواجي تصدّت للجلاء عسى","على المنصّة تلقاني بتزييني",19,"ن",2,0],["وفي زمن الطُّهْر المُطَهَّرِ أَحمد","نصرتم وجاهدتم بأُحْدٍ وفي بدْرِ",20,"ر",1,0],["وفي زور الكثيبِ وفي مقامٍ","لواءٍ جد بهذا من نداكا",21,"ك",2,0],["وفي زعمهم أنّ الغنى ذا قربةٌ","ورقصٌ بتصفيقٍ وصَعْقٌ بِمُخْتَلَجْ",22,"ج",1,0],["وفي زمانك ارباب التصوف قد","غروا بالاتباع والسجاد والعلم",23,"م",1,0],["وفي زقاق السيدا شباك","لقبّة فيها الفتى الفتاك",24,"ك",1,0],["وفي زمانه يَسْري العلمُ فِي البيدِ","أَعلى منارَ الهدى قَدْراً بعزته",25,"ه",1,0],["وفي زمن الهناء أقول أرخ","لغيطاس به باهى بقاء",26,"ا",2,0],["وفي زفك الأشعري البلاءُ","وما يقْضَ من حادثٍ ينزلِ",27,"ل",1,0],["وفي زهوِ تَشييعِ الحُروف لنفسها","تَعودُ إلى أدراجِ موتي المقابرُ",28,"ر",1,0],["وفي زوايا ألحان كن اللهو مستجلياً","كؤوسها من كف ظبي يصيد",29,"د",1,0],["وفي زَعْمِهِ أن القرار مُحَيِّرٌ","وفي زَعْمِهُمْ أن ليس في سلكهم أَغْرَاب",30,"ب",1,0],["وفي زَخَمِ الآراءِ نُدْلي بدَلْوِنا","فرُبَّ اقْتِرَاحٍ قد نزيد به نَفْعا",31,"ع",2,0],["وفي زكي كامل الخلق والحجى","وليس له في العلم والحكم من شروى",32,"و",2,0],["وفي زعم هذا الأحمق الوغد أنه","وأصحابه أهل الهدى حين نسما",33,"م",2,0],["وفي زمن المصائب والشقاء","وهدرٍ للأمانة.. للوفاءِ",34,"ا",2,1],["وفي زحمة الاحساس ناديتك شعور","لين اجتمع فيني من الضد جلاس",35,"س",1,0],["وفي زور وبهتان","وجري خلف ألقاب..",36,"ب",1,0],["وَفِي زُخْرُفِ العَيْشِ كَمْ جاهِلٍ","قَدْ اغْتَرَّ فِيما دَهاهُ اغْتِرارا",37,"ر",2,0],["وَفِي زَعْمِنا أَنَّا نُحاذِرُ صَرْفَها","وَهَلْ يَسْلَمُ الإِنْسانُ مِنْ حَيْثُ يَحْذَرُ",38,"ر",1,0],["وفي زحمة خطاوي الناس","يتمتم شارع سنيني",39,"ن",2,1],["وفي زواياي أنفاسٌ معطّرةٌ","تفوح بشراً.. بقايا من بقاياكم",40,"م",1,0]]}