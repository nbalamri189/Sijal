{"poems":[[85,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[45,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[141,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[148,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[197,"وبي زهرة في جانب النيل قد نمت","https://www.aldiwan.net/poem45140.html","الطويل"],[235,"يا رب أدفئني فقد خصرت","https://www.aldiwan.net/poem18091.html","الرجز"],[235,"بك الدر يا درا به حلية الدهر","https://www.aldiwan.net/poem18815.html","الطويل"],[269,"لا عين العين فعل البيض والاسل","https://www.aldiwan.net/poem52059.html","البسيط"],[355,"سأرمي بنبلي ذائدا عن حمى نبلي","https://www.aldiwan.net/poem4151.html","الطويل"],[556,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[560,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"],[573,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"]],"verses":[["وَفي زاوِيَةِ السِجنِ","وَفي سِلسِلَةِ القَيدِ",0,"د",1,0],["وَفي زَرودَ تَبيعٌ لَيسَ يُمهِلُنا","تَقاضِياً وَغَريمٌ لَيسَ يَقضينا",1,"ن",2,0],["وَفِي زِيَادَتِهِمْ آثَارُ مُنْجِبِهِمْ","مَعْنىً مِنَ الكَرَمِ المُورُوثِ قَدْ لَطفَا",2,"ف",2,0],["وَفي زَمانِكَ خَلّى الدَهرُ عادَتَهُ","وَعادَ مِن فِعلِهِ المَذمومِ يَعتَذِرُ",3,"ر",1,0],["وَفي زَورَةِ المُختارِ أَقصى مُؤَمَّلي","سابكي لِبُعدِ الدارِ عَنهُ فَإِنَّ لي",4,"ي",1,0],["وفي زمن تصفو علي كما صفا","وفي زمن ما من تكدرها بد",5,"د",1,0],["وَفِي زِمَامِ حُبِّهِ ارْتَسَمْتُ","وَإِنْ أَكُنْ عَنْ هَدْيِهِ قَدْ نِمْتُ",6,"ت",1,0],["وَفِي زَهَرٍ مِنْ رَوْضِ شِعْرِكَ يَانِعٍ","حَيَاةُ النُّهَى الْعُظْمَى وَمَا ذَاكَ فِي الزَّهْرِ",7,"ر",1,0],["وَفي زيارتهم نجح المطالب من","محو الذنوب وَستر الحوب وَالزلل",8,"ل",1,0],["وَفي زَمَنٍ أغضَى لِيَخبُرَ أهلَهُ","فَأكسَبَهُ الإِغضَاءُ ضَرباً مِنَ الخَبلِ",9,"ل",1,0],["وفي زمزم الإقبال كان اغتسالنا","عشية أجنبنا بمس الأجانب",10,"ب",1,0],["وفي زِيارةِ مِصرٍ لو ظَفِرتُ بها","مَشَقَّةٌ تُعقِبُ الأتعابَ بالظَفَرِ",11,"ر",1,0],["وفي زمانِ ابن أَيوبٍ غَدتْ حلبٌ","من أَرض مصرَ وعادت مصرُ من حلبِ",12,"ب",1,0]]}