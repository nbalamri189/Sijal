.","https://www.poetsgate.com/ViewPoem.aspx?id=36887",""],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[1420,"أقام رجالاً في معارجه ملكاً","https://www.poetsgate.com/ViewPoem.aspx?id=87617",""],[5145,"فديتك هل طالعت أجنحة الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=108225",""],[5186,"رفعت إلى أوج العلى راية الهند","https://www.poetsgate.com/ViewPoem.aspx?id=156480",""],[5213,"منعت سبيل الماء والماء بذله","https://www.poetsgate.com/ViewPoem.aspx?id=170463",""],[5232,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213462",""],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[5413,"إنه الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=200596",""],[5546,"فإن تسأليني كيف أنت فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=181005",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5582,"دَعاهُ يَعُجْ فِي حُبِّهِ لِمَعاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63476",""],[5660,"أَحَقُّ النّاسِ أَن تُهجى الشُعوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=23712",""],[5660,"قِفا أُوَدِّعكُما يا صاحِبايَ قِفا","https://www.poetsgate.com/ViewPoem.aspx?id=23717",""],[5668,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=178829",""],[5690,"مليك الورى أهدى إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=172240",""],[5693,"وبين يديك يهلّ الحنان .","https://www.poetsgate.com/ViewPoem.aspx?id=35145",""],[5725,"للآن يا قاطول","https://www.poetsgate.com/ViewPoem.aspx?id=212171",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""],[6167,"لا رجعية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85486&r=&rc=15",""]],"verses":[["فَإِن أَنا لَم أَركَب عَظيماً فَلا مَضى","حُسامي وَلا رَوّى الطِعانَ سِناني",0,"ن",2,0],["فَإِن أَنا لَم أَقُم فيها فَقامَت","عَلى قَبري النَوادِبُ بِالمَآلِ",1,"ل",1,0],["فَإِن أَنا لَم أَركَب إِلَيها مُخاطِراً","وَأُعظِمُ قَولاً دونَها وَقِتالا",2,"ل",2,0],["فَإِن أَنتَ لَم تَستَبقِ بِالصَونِ بَعضَه","تَتابَعَ مَطلولاً عَلى الذُلِّ سائِرُه",3,"ر",2,0],["فَإِن أَنجُ مِن ذا اليَومِ قاطِعَ رِبقَةٍ","فَقَصرِيَ مِن رَيبِ المَنونِ عَلى غَدِ",4,"د",1,0],["فَإِن أَنَلها فَكَما رُمتُهُ","أَولا فَقَد يَكذِبُني رائِدي",5,"د",2,0],["فَإِن أَنتَ لَم تُعطِ النَصيحَةَ حَقَّها","فَرُبَّ جَموحٍ كَلَّ عَنهُ المُؤَنِّبُ",6,"ب",1,0],["فَإِن أَنتُمُ لَم تَغضَبوا بَعدَ هَذِهِ","رَمَينا إِلى أَعدائِنا بِالجَرائِمِ",7,"م",1,0],["فَإِن أَنتَ لَم تُخبِر بِشَيءٍ عَلِمتَهُ","فَلا طُرتَ إِلّا وَالجَناحُ كَسيرُ",8,"ر",1,0],["فَإِنَّ اِنهِمالَ العَينِ بِالدَمعِ كُلَّما","ذَكَرتُكِ وَحدي خالِياً لَسَريعُ",9,"ع",1,0],["فإنْ أنا لمْ أمْحَضْكَ منّي بخالِصٍ","منَ الوُدِّ صافٍ في قَرارتِه صِرْفِ",10,"ف",1,0],["فَإِن أَنأَ عَنكُم لا أُصالِح عَدوَّكُم","وَلا أُعطِهِ إِلّا جِدالاً وَمِحرَبا",11,"ب",2,0],["فَإِن أَنتُمُ لَم تَعرِفوا ذاكَ فَاِسأَلوا","أَبا مالِكٍ أَو سائِلوا رَهطَ أَشيَمِ",12,"م",1,0],["فَإِن أَنتُمُ لَم تَفعَلوا ما أَمَرتُكُم","فَأَوفوا بِها إِنَّ العُهودَ وَدائِعُ",13,"ع",1,0],["فَإِن أَنا لَم أَبلُغ مَقاماً أَرومُهُ","فَكَم حَسَراتٍ في نُفوسِ كِرامِ",14,"م",1,0],["فَإِن أَنتُما لَم تُسعِداني عَلى الهَوى","ذَراني وَشَوقي عَزَّهُ لي وَعارُهُ",15,"ر",2,0],["فَإِن أُنيئَت فَالنَفسُ أَنأى نَفيسَةٍ","إِذِ الجِسمُ لا يَسمو لِتَذكيرِهِ ذِكرُ",16,"ر",1,0],["فَإِن أَنجَدَت كانَ الهَوى بِكَ مُنجِداً","وَإِن أَتهَمَت يَوماً بِها الدارُ أَتهَما",17,"م",2,0],["فَإِن أَنا لَم أُعلَم كِلاباً بِأَنَّها","كِلابٌ وَأَنّي باسِلُ النَقِماتِ",18,"ت",1,0],["فَإِن أَنتَ لَم تَصدُقكَ نَفسُكَ فَاِنتَسِب","لَعَلَّكَ تَهديكَ القُرونُ الأَوائِلُ",19,"ل",1,0],["فَإِن أَنا لَم أَمنَحكَ صِدقَ مَوَدَّتي","فَما لي إِلى المَجدِ المُؤَثَّلِ مِن عُذرِ",20,"ر",1,0],["فإن أنتَ صدَّقت الرجاءَ ببُغيتي","فكم من رجاءٍ فيك غيرِ مكذَّبِ",21,"ب",1,0],["فإن أنت شاهدْتَهم مرةً","فكن مِنهُمُ الأبعد الأبعدا",22,"د",2,0],["فإن أنشدوا مدحه غادروا","من المسك في كل شيء عبق",23,"ق",1,0],["فإنْ أنتُمُ لم تحفظوا لمودّتي","ذِماماً فكونوا لا عليها ولا لَها",24,"ل",3,0],["فَإِن أَنِستُم فَليَكُن أُنسُكُم","في الصَبرِ لِلدَهرِ وَفي عَتبِهِ",25,"ب",2,0],["فإن أنت أبَّقتَهُم لي يكن","لنسل بقاء ولا لي حويلُ",26,"ل",1,0],["فإن أنتم كررتم عقد حلّه","مراراً تباعاً كان اغلى واثمنا",27,"ن",2,0],["فإن أنت رطبت أجزاءه","جعلت تلتحم",28,"م",1,0],["فإن أنت أحسنت تدبير ما","ذكرناه حزت كنوز النعم",28,"م",1,0],["فَإِن أَنتَ والَيتَ الصَديقَ فَوالِ بي","وَإِن أَنتَ عادَيتَ العَدُوَّ فَعادِ بي",29,"ب",2,0],["فَإِن أَنا لَم أَشكُركَ نُعماكَ جاهِداً","فَلا نِلتُ نُعمى بَعدَها توجِبُ الشُكرا",30,"ر",2,0],["فَإِن أَنتُما لَم تَجعَلا بِأَخيكُما","صَدىً بَينَ أَكماعِ السِباقِ يُجاوِبُه",31,"ب",2,0],["فإنْ أنتَ لم تُدْرِكْ ثِقاتَكَ عاجلاً","طلعْتَ عليهم والعُقولُ أفولُ",32,"ل",1,0],["فإنْ أنْقَلِبْ منها إلى الأرضِ واطئاً","على التُّرْبِ يوماً إنَّني لسعيدُ",33,"د",1,0],["فَإِن أَنتَ شَكَّكتَ فيما سُئِل","تَ فَخيرُ جَوابِكَ لا أَعلَمُ",34,"م",1,0],["فَإِن أَنتَ أَتحَفتَني بِالحُضورِ","فَمِن أَينَ لِلعَبدِ هَذي السَعادَه",35,"د",2,0],["فَإِن أَنت لم تُنفِقْهُ أنفقَ نفسه","وصارَ إِلى ما كانَ تَدري ولَم تدرِ",36,"ر",1,0],["فَإِن أَنا لَم يَحمَدكَ عَنِّيَ صاغِراً","عَدُوُّكَ فَاِعلَم أَنَّني غَيرُ حامِدِ",37,"د",1,0],["فَإِن أَنتَ لَم تَفعَل وَلَستَ بِفاعِلٍ","وَلا قابِلٍ نُصحاً لِمَن هُوَ زاجِرُ",38,"ر",1,0],["فَإِن أَنا لَم أَشكُركَ وَالدارُ غُربَةٌ","فَلا جادَني غادٍ مِن المُزنِ رائِحُ",39,"ح",1,0],["فَإِن أَنتُما لَم تَعلَماها فَلَستُما","بِأَوَّلَ باغٍ حاجَةً لا يَنالُها",40,"ل",3,0],["فَإِن أَنا لَم أَفطِم تَميماً وَعَمَّها","فَلا يَحذَروا لِأُمَّتي شاعِراً بَعدي",41,"د",2,0],["فَإِن أَنتَ حُمِّلتَ الأَمانَةَ فَاصطَبر","عَلَيها فَقَد حُمِّلتَ مِن أَمرِها ثِقلا",42,"ل",2,0],["فَإِنّا نَخافُ الحَيَّ أَن يَفزَعُوا بِنا","وَعَينَ عَدُوٍّ أَن يَراكَ بَصِيرِ",43,"ر",1,0],["فَإِن آنَسَت حِسّاً مِنَ السَوطِ عارَضَت","بِيَ القَصدَ حَتّى تَستَقيمَ ضُحى الغَدِ",44,"د",1,0],["فإنْ أنا لم أستحيِ ممَا فعلتُمُ","فلستُ بمستحيٍ من اللؤمِ والغَدْر",45,"ر",1,0],["فَإِن أَنتَ عاشَرتَ الكَعابَ فَصادِها","وَحاوِل رِضاها وَاِحذَرَ نَّغَضابَها",46,"ب",3,0],["فَإِن أَنتَ لَم تَملِك وَشيكَ فِراقِها","فَعِفَّ وَلا تَنكِح عَواناً وَلا بِكرا",47,"ر",2,0],["فإنَّ إنساناً ابن قردٍ","أفضل من قردٍ ابن إنسانْ",48,"ن",1,0],["فَإِن أَنا لَم أُصبِح سَوامَكَ غارَةً","كَرَيعِ الجَرادِ شَلَّهُ الريحُ وَالرِهَم",49,"م",1,0],["فإنْ أنكَرْتُموهُ بأرضِ مِصْرٍ","فأوْصافي لكمْ معَكُمْ مِثال",50,"ل",1,0],["فإِن أَنا أَشكركَ أبيضَ مُعرِقاً","فَلا هَزَّني لِلمَجدِ أَبيض مُعرِقُ",51,"ق",1,0],["فَإِن أَنتُما اِسطَترَبتُما أَو أَرَدتُما","لَحاقاً بِأَطلالِ الغَضى فَاِتبَعانِيا",52,"ي",2,0],["فَإِنْ أَنَا سَالَمْتُ الْهَوَى فَلَطَالَمَا","شَهِدْتُ الْوَغَى وَالطَّعْنُ يَذْكُو وَقُودُهُ",53,"د",2,0],["فَإِنْ أَنَا لَمْ أَمْلِكْ صَدِيقاً فَإِنَّني","لِنَفسِي صَدِيقٌ لا تَخِيسُ عُهُودُهُ",53,"د",2,0],["فإن أنا لم تحظُظْ لديكم وسائلي","فمن ذا الذي تُلفى لديه حَظائظا",54,"ظ",2,0],["فإن أنأَ عن مصرٍ، فحسبي: أنني","أحج إليها كلَّ عام، وأُحرم",55,"م",1,0],["فإن أنا لم أمحضك مني بخالص","من الود صاف في قراراته صرف",56,"ف",1,0],["فإِنْ أَنا لم أَصْدَعْ بِشُكْرِكَ إِنَّني","وحَاشايَ من خُلْقِ البَخِيلِ بَخِيلُ",57,"ل",1,0],["فإن أنت واليت الصديق فوال بي","وإن كنت عاديت العدو فعاد بي",58,"ب",2,0],["فإن أنتَ عاشرتَ الكَعابَ فَصادِه","، وحاوِل رضاها، واحذرنّ غَضابها",59,"ب",3,0],["فإنْ أنأ عنكمْ لاأصالحْ عدوّكم،","ولا أعطيهِ إلاّ جدالاً ومحربا",60,"ب",2,0],["فَإنْ أَنْتَ لَمْ تَفْعَلْ وَلَسْتَ بِفَاعِلٍ","وَلاَ قَابِلٍ نُصْحاً لِمَنْ هُوَا زَاجِرُ",61,"ر",1,0],["فان انكرت آيات فضلى حواسدي","فقد عرفتها شوس كل قبيلة",62,"ه",1,0],["فإن أنشيتَ هاجَ الشرُّ فيهم","وإن أخفيتَ أرضيتَ الجميعَا",63,"ع",2,0],["فإِن أنتُمَا حَيِّيتُمَا كُلَّ مَربَعٍ","وأَبنتُمَا مِن رَسمِهَا المُتَعَفِّيَا",64,"ي",2,0],["فإن أنت ارتضيت بها فهذا","تمام القصد يا كلّ الأماني",65,"ن",2,0],["فإن أنتمُ لم تنصفونا فإننا","سنقتصُّ من أعراضكم ذلك الوِترا",66,"ر",2,0],["فَإِن أَنالَتني المَقاديرُ الَّذي","أَكيدُهُ لَم آلُ في رَأبِ الثَأى",67,"ا",1,0],["فَإِن أَنَل فَبِسَعيي ما أَتَيتُ بِهِ","بِدعاً وإِلّا فَقد أَعذَرتُ في الطَلبِ",68,"ب",1,0],["فَإِن أَنتُمُ لَم تَمنَعُوهُنَّ فَاِصبِرُوا","لِآبِدَةٍ يَبقى عَلى الدَهرِ ذامُها",69,"م",3,0],["فَإِن أَنتُمُ أَمطَرتُموها تَحَدَّثَت","وَجادَت وَآتَت أُكلَها كُلَّ طاعِمِ",70,"م",1,0],["فَإِن أَنتُمُ لَم تَقبَلُوها نَصِيحَةً","فَلَستُ لَكُم فيما تُحِبُّونَ لاحيا",71,"ي",2,0],["فإنْ أنّ \"أني\" فلا تعذلوني","فروحيَ قفرٌ وطيني جَدوبُ",72,"ب",1,0],["فَإِن أَنتُما كَلَّمتُمَاهُنَّ فَاشكُوا","دَوَىً دَنَفاً يَزدَادُ كُلَّ صَبَاحِ",73,"ح",1,0],["فإنْ أنت كافيتهم ناصَبوك","وما ثلتَهم بالأذى والأَثام",74,"م",1,0],["فإن أنا لم آخذ قليلا حرمته","ولا بدّ من شيء يعين على الدهر",75,"ر",1,0],["فَإِن أَنتُمُ لَم تَثأَروا بِرِجالِكُم","فَدوكوا الَّذي أَنتُم عَلَيهِ بِمِدوَكِ",76,"ك",1,0],["فإن أنا لم أرجع إليك فإنني","سألقاك يوم الحشر في ذلك الجمع",77,"ع",1,0],["فَإِن أَنجُ يا لَيلى فَرُبَّ فَتىً نَجا","وَإِن تَكُنِ الأُخرى فَشَيءٌ أُحاذِرُه",78,"ر",2,0],["فَإِن أَنجُ مِنها أَنجُ مَن ذي عَظيمَةٍ","وَإِن تَكُن الأُخرى فَتِلكَ سَبيلُ",79,"ل",1,0],["فَإِنْ أَنَا أَمْسَى بَابُ شُكْرِيَ مُرْتَجىً","وَكُنْتُ كَمَنْ أضْحَى حَقِيراً وَيَنْتَأُ",80,"ا",1,0],["فإن أنا لم أعد فالله أولى","بعذري ثم أنت بلا كلام",81,"م",1,0],["فَإِن أَنتُمُ لَم تَفعَلوا لا أَبا لَكُم","فَلا تُعلِقونا ما كَرِهنا فَنَغضَبا",82,"ب",2,0],["فإن أنا جرّعت الحياة بذلة","وساغت مذاقاً والمنية كالمهل",83,"ل",1,0],["فان أَنستَ غيابات الفؤاد بهم","فهم أَحباب قَلبي يا غيابات",84,"ت",1,0],["فَإِن أَنَّبتنِي سُوقة وَتَعَنَّتَت","عَلي وَظَنت رِيبَةً أَلسنُ النقدِ",85,"د",1,0],["فَإِنْ آنَ لي مِنْ بَعْد فيها تَأَخُّرٌ","فَقَدْ كَانَ لِي مِنْ قَبْل فيها تَقَدُّمُ",86,"م",1,0],["فَإِنْ أَنا لَمْ أُطْلِقُ لِسانِي بِحَمْدِها","فَأُمُّ الْعُلى وَالْمَجْدِ مِنِّيَ طالِقُ",87,"ق",1,0],["فان انتهيت إلى الذي عرفته","شاهدت من عرش إلى بهموت",88,"ت",1,0],["فَإِن أنتَ ناواكَ في الدهرِ صعبٌ","فَقاتِل بسعدٍ وإلّا فَدَع",89,"ع",1,0],["فَإن أَنا لم ألف المقام بواجب","فَإنّ لِمثلي من أبي النخبة العذرا",90,"ر",2,0],["فَإن أَنكرتهُ غرّةٌ أو حَميّةٌ","فَكَم ظاهرٍ قد ساءَ عن باطِن سرّا",91,"ر",2,0],["فإن أنا أحسنت الولاية أحسنت","إلى العالم العل