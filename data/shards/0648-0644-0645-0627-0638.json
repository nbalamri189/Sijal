{"poems":[[55,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[215,"ولما صار ود الناس ختلا","https://www.aldiwan.net/poem46611.html","الوافر"],[215,"وأوحش ربعهم من بعد أنس","https://www.aldiwan.net/poem46811.html","الوافر"],[409,"ولما ظمئنا من حرارة فقدكم","https://www.aldiwan.net/poem33430.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70967","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70804","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59331","الوافر"],[1285,"","https://poetry.dctabudhabi.ae/diwan/poem/31526","الطويل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28327","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94767","الطويل"],[5216,"قَيْس","https://www.poetsgate.com/ViewPoem.aspx?id=187654",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""]],"verses":[["وَلَم أَظفَر بِها مِنكَ","جِذابَ العِلقِ بِالعَضبِ",0,"ب",1,0],["ولم أظفر على جهدي بحُرّ","تركت هواهمُ وصحبتُ نفسي",1,"ي",1,0],["ولم أظفر على جهدى بحر","تركت هواهمو وصحبتُ نفسي",2,"ي",1,0],["ولما ظمئنا من حرارة فقدكم","وقربكم يطفي لهيب أوامي",3,"م",2,1],["ولم أُظهر الشكوى إلى ابن فلانةً","ونجل فلانً لا ولو كظَّنى العُدْم",4,"م",1,0],["ولم أظهر الشكوى إلى من يلومني","فيُعلم منهم غائبا كل حاضر",5,"ر",1,0],["وَلَمْ أظْفَرَ بِطَائِلَةٍ وَيَا هَلْ","أرَانِي لاَ عَلَيَّ وَلاَ لَدَيَّا",6,"ي",2,0],["وَلَمّا ظَنَنتُ أَنَّهُ مُتَعَبَّطٌ","دَعَوتُ بَني زَيدٍ وَأَلحَفتَهُ جَردي",7,"د",2,0],["ولَم أَظلِم ولَم أَقطَع طَريقاً","وتسمعُ بي أَقاوِيلَ الأعادِي",8,"د",2,0],["ولمّا ظلامُ الجهل أفشى ضلالهُ","أتوني فعابوا من أحبُّ جمالهُ",9,"ه",1,0],["ولَمّا ظَفَرْتُ بقلبِكِ حُبِّي","رأيتُ يديَّ تطولُ السماءْ",10,"ا",2,1],["ولما ظغا صوب الحيارا كتفوا به","أشارت يداه نحوه فتمزقا",11,"ق",2,0]]}