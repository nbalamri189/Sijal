{"poems":[[302,"زهر الدراري أم نظام الجوهر","https://www.aldiwan.net/poem33261.html","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137854",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87333","الرجز"],[3256,"","https://poetry.dctabudhabi.ae/diwan/poem/20935","الكامل"],[4693,"أهوى السحاب","https://www.poetsgate.com/ViewPoem.aspx?id=29939",""],[5974,"الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=207543",""]],"verses":[["وَالنَثرةُ العَليا هوت من نَثره","خَجَلاً وَقالَت ليتَه لم ينثرُ",0,"ر",1,0],["والنثر اصبح ناثرا جمل الاسى","والدمع صار اجل منثوراته",1,"ت",2,0],["وَالنَّثرُ نَجمَانِ خَفِيَّا المَنظر","وَلَطخَةٌ بَينَهُمَا شِبهُ الأثَر",2,"ر",1,0],["وَالنَثرَةُ الحَصداءُ وَال","بيضُ المُكَلَّلُ وَالرِماحُ",3,"ح",1,0],["والنثر نعزفه لحنا وأغنية","كي يرقص الصخر نشوانا من الطرب",4,"ب",1,0],["والنثر بات يأن في شطآنه","مثل الغريق .. فهل تجير غريقا",5,"ق",2,0]]}