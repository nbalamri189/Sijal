افي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4755,"يا حافِيَ العَينَينِ والخاطِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=186419",""],[4769,"أما لظلام ليلي من صباحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180981",""],[4818,"غول","https://www.poetsgate.com/ViewPoem.aspx?id=203564",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5363,"ألْطُفْ بعبدك","https://www.poetsgate.com/ViewPoem.aspx?id=144171",""],[5376,"بأيِّ الذنبِ ذاك الطفلُ يُقْتلْ","https://www.poetsgate.com/ViewPoem.aspx?id=196896",""],[5525,"ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=7195",""],[5542,"غدا يتحدث الرطب","https://www.poetsgate.com/ViewPoem.aspx?id=10030",""],[470,"والآن ها قد قطعنا الشوط يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=178097",""],[5616,"كمل النصاب","https://www.poetsgate.com/ViewPoem.aspx?id=203468",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5725,"إمام العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=215791",""],[5758,"وجع الذّاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=201278",""],[5848,"شهرك مبارك","https://www.poetsgate.com/ViewPoem.aspx?id=50618",""],[5918,"أُحبُّكِ فلتسألي الذَّارياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=177711",""],[5956,"أمضي للقيا متعب ووليدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194150",""],[5956,"من تأثير منام كان نصفه صحيحاً","https://www.poetsgate.com/ViewPoem.aspx?id=194779",""],[6045,"زفرات روح","https://www.poetsgate.com/ViewPoem.aspx?id=135936",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""],[5190,"القفاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85045&r=&rc=120",""]],"verses":[["كأن الأذن إن ألقى خطابا","ظلاما قد قذفت به شهابا",0,"ب",2,0],["كأنَّ الإِلى طاروا إِلى الحَرْبِ ضَلّةً","نَعامٌ يُباري خَطْرَةَ الرّيحِ جافِلُ",1,"ل",1,0],["كأنّ الأساطينَ مهْما نظَرْتَ","إلَيْها موَسَّدةً فوقَ عُودْ",2,"د",1,0],["كَانَ الإِمَامُ عَلَى أَسىً لِبِلادِهِ","مِنْ سُوءِ سَيْرِ أَمِيرهَا المُتحَكِّمِ",3,"م",1,0],["كَأَنَّ الآلُ يرَفَعُ بيَن حزُوى","وَرابِيَةٍ الخَويِّ بِهِم سَيالا",4,"ل",2,0],["كأن الأم أمَ صداه لما","جلوا عنه غُطاطة حابلينا",5,"ن",2,0],["كَأَنَّ الأُمَّ أُمَّ صَدَاهُ لَمَّا","جلوا عنها غَطَاطَةَ حابِلِينَا",6,"ن",2,0],["كأنَّ الأسى آلى عليه أليةً","فما فيه إلا النفس والعظم والجلد",7,"د",1,0],["كأنَّ الأرض تحتكمُ سماءٌ","تجلّت بالأهلة والبدور",8,"ر",1,0],["كأن الأمانيَّ مَثَّلنها","فقال لها الله كوني كذا",9,"ذ",2,0],["كَأَنَّ الأَرضَ قَد مادَت وَفُضَّت","عَنِ المَوتى الصَفائِحُ وَالرُجامُ",10,"م",1,0],["كَأَنَّ الأَرضَ لَم تَشهَد لِقاءً","تَكادُ لَهُ تَميدُ وَلا وَداعا",11,"ع",2,0],["كَأَنَّ الأَسوَدَ اللابِيَّ فيهِم","غُرابٌ حَولَهُ رَخَمٌ وَبومُ",12,"م",1,0],["كأنَّ الأميرَ أعارَ الرُّبا","شمائلَه فاشتملْنَ المُعَارَا",13,"ر",2,0],["كَأَنَّ الأَرضَ قَد طُوِيَت عَلَيّا","وَقَد أُخرِجتُ مِمّا في يَدَيّا",14,"ي",2,1],["كأنّ الأُلى جاءوا بها جاوزوا المَدى","كأن الذي لا يَقبلُ الزُّورَ كاشحُ",15,"ح",1,0],["كَأَنَّ الأُلى صَبّوا عَلى أَهلِها الرَدى","زَبانِيَةٌ مِنها حَديدٌ وَجَلمَدُ",16,"د",1,0],["كَأَنَّ الأَرضَ والِهَةً تَوالَت","فَجائِعُها وَأَعوَزَها الشَفيقُ",17,"ق",1,0],["كَأَنَّ الأُلى زانوا المَنابِرَ بِاِسمِهِ","أَحَلّوا بِدينَ اللَهِ ما لا يُناسِبُه",18,"ب",2,0],["كَأَنَّ الأَنجُمَ السَب","عَةَ في لُعبَةٍ بُقّارا",19,"ر",2,0],["كانَ الأسَى فَرْضاً لو أنّ الرّدى","قال لنا افْدوهُ فلم نَفْدِهِ",20,"د",2,0],["كأنّ الأنُوقَ الخُرْسَ فوقَ غُبارِهِ","طَوالِعُ شَيبٍ في مَفَارِقِ أسوَدِ",21,"د",1,0],["كأنّ الأَقَبّ الأخْدَريّ بأنّه","سَمِيٌّ له في آلِ أعْوَجَ مُدّع",22,"ع",1,0],["كان الإمام وهو للعدل علمْ","لم ينصف الرّومَ وللبحر ظلمْ",23,"م",1,0],["كَأَنَّ الأشِعَّةَ أَثْنَاءَهُ","مَغَاوِرُ في مَنْجَمٍ مِنْ ذَهَبْ",24,"ب",1,0],["كَانَ الأَدِيبُ وَلَيسَ يَرْعَى حَقَّهُ","وَاليَوْمَ تُرْعَى لِلأَدِيبِ حُقُوقُ",25,"ق",1,0],["كَانَ الأَمِيرُ مُهندٌ","بطلاً شَهِيراً فِي الْعَشَائِرْ",26,"ر",1,0],["كان الأمين بحبل الله معتصماً","لا يعرف الرجس بل واللهو يجتنب",27,"ب",1,0],["كأنَّ الأمورَ بمقياسهِ","تُقاسُ فتؤخذُ أو تُطرح",28,"ح",1,0],["كأن الأشياء بعد جفاء","قد أرادت أن يسعد الإنسان",29,"ن",1,0],["كأنّ الأرض قد قد مادت وفضّت","عن الموتى الصفائح والرّجام",30,"م",1,0],["كان الاحبة جيراني وقد بعدوا","والهف قلبي على وقت لنا خال",31,"ل",1,0],["كان الإله بعون قومك","يا فتاة بني عطية",32,"ي",2,0],["كأنَّ الأسَى والحزنَ والشوق والهوى","تودّ فؤادِى والفؤادُ لها قبرُ",33,"ر",1,0],["كان الأسى من أجل حرمة مسجد","هتكت بأمر مقدم الحكام",34,"م",1,0],["كأنَّ الأقحوانَ به ثغور","مُفلَّجةٌ مُؤشَّرةٌ عِذاب",35,"ب",1,0],["كأن الأَقاحي والبَهار دراهمٌ","خِلال دنانيرٍ تُقابل ناقِدا",36,"د",2,0],["كأنّ الأرضَ من عدلٍ وأمنٍ","وإنعامٍ تُواصله جِنان",37,"ن",1,0],["كانَ الإمامَ وكلّهم مأموما","صلّوا عليهِ وسلّموا تَسليما",38,"م",2,0],["كأنّ الأحبّة مِن طَعْمِه","يُقَبّلْنَنا فيزُلْن الضَّنَى",39,"ن",2,0],["كأنّ الأرض مِسْكٌ أو عَبِير","إذا أومَتْ إليها بالسجود",40,"د",1,0],["كَأَنَّ الأَرضَ ما اِتَسَعَت لِساعٍ","مَناكِبُها وَلا لِلرِزقِ بابُ",41,"ب",1,0],["كَأَنَّ الأَتحَمِيَّةَ قامَ فيها","لِحُسنِ دَلالِها رَشَأٌ مُوافي",42,"ف",2,0],["كَأَنَّ الأرْضَ مِنْها في بِحَارٍ","زَوَاخِرَ فِي ارْتِجَاجٍ واصْطِفَاقِ",43,"ق",1,0],["كأنَّ آلاءهُ آلَتْ فَما حَنِثَتْ","أنْ يُمْتَطَى نَحْوَهُ الدَّأْمَاءُ والآلُ",44,"ل",1,0],["كَأَنَّ الأَقاحي ثُغورُ المِلاحِ","بَسَمنَ لِعاشِقِها عَن رِضاها",45,"ا",3,0],["كأنّ الأماني مغنطيسٌ لبرّه","فَما خَطَرت إلّا وَأَتبعها برّا",46,"ر",2,0],["كأنّ الأقاحي والشّقائقَ في الثَّرى","خدودٌ بها مَصقولةٌ وثُغور",47,"ر",1,0],["كأنّ الإِثمِدَ الحارِيَّ فيها","يُسَفُّ بحيثُ تَبتَدِرُ الدُموعُ",48,"ع",1,0],["كأَنَّ الأَكرَمينَ مَضَوا","وَلَم يَستَخلِفوا خَلَفا",49,"ف",2,0],["كأنَّ الأشمطَ المحذورَ فيها","يحطُّ قراهُ من خلفِ الجدارِ",50,"ر",1,0],["كانَ الإمام به الأئمة تقتدي","فَلَه الهدى ولغيره التقليد",51,"د",1,0],["كان الأراقم في فرعها","وأسود عبس بجفن قطن",52,"ن",1,0],["كأنّ الأثيرَ المُستَماحَ أعارَها","شمائلَهُ فالطيْبُ منها يُعاود",53,"د",1,0],["كَأَنَّ الأَرضَ جاءَتْنَا تَهادى","بِوَجْرَةَ أَوْ بِشِعْبَيْ رَامَتَيْنِ",54,"ن",1,0],["كَأَنَّ الأَمانِيَ مَنٌّ عَلَيْهِ","فلا آيِبٌ دونَ ضِعْفِ الجزاءِ",55,"ا",2,0],["كأن الأرض تضحك من سرورٍ","بحيث على الرياض بكى حياها",56,"ا",3,0],["كان الألى رغم ما في الجهل من نكد","لا يصبرون على ضيم إذا سلبوا",57,"ب",3,0],["كأنَّ الأخاءَ السمحَ في ظل أسرهِ","فلما انقضى صرنا نرى بعده الغبنا",58,"ن",2,0],["كأنّ الأباريق طافت علَي","هِ أو مسَّ أعطافَه أَفكَلُ",59,"ل",1,0],["كأنّ الأولى دارتْ عليهم بيوتُها","بنو نشوةٍ دارت عليهم سُقاتُها",60,"ت",3,0],["كأنَّ الإِمامَ المُسْتَضيء وهَديَهُ","غَداةَ أدالَ الحَقَّ مِنْ كُلِّ باطِلِ",61,"ل",1,0],["كأن الأَنام صحيفةً وزمانُهُ","بوجودهِ ختمَ الكتاب وعَنونا",62,"ن",2,0],["كأنَّ الأقاحي طلَّةُ لؤلؤُ الندى","ثغورُ الغواني والحيا أدمعُ الصّبِّ",63,"ب",1,0],["كأنَّ الأرض وجهٌ من حبيبٍ","تبلّج عن سرورٍ وابتهاج",64,"ج",1,0],["كأن الأمير اختصها فاعتلت به","معارجُ أسبابُ السماء لها سفل",65,"ل",1,0],["كَأَنَّ الأَرضَ بَعدَكَ طارَ فيها","فَأَشعَلَها بِساكِنِها ضِرامُ",66,"م",1,0],["كانَ الأَميرُ لِجَيشِهِم مُستَنَّةً","فُرسانَهُم في الظِلِّ مِن راياتِهِ",67,"ت",2,0],["كانَ الأَوائِلُ في الأَنظارِ مُزعِجَةٌ","حَتّى أَتى فَشَأى مَن جَدَّ مَن قَدُما",68,"م",2,0],["كأن الاقتباس بكم ينادي","أحلوا قومهم دار البوار",69,"ر",1,0],["كأنّ الأسودَ العامريةَ فَوقها","تهمُّ بمكروهٍ إليكَ فتفزعُ",70,"ع",1,0],["كانَ الأَنامُ جَميعاً قَبلَ مَبعَثِهِ","عَلى شَفا جُرُفٍ هارٍ فَعادَ شِفا",71,"ف",2,0],["كأن الأذى مفروضه واجبُ الأدا","عليهم وليس الفرضُ مثل التنفلِ",72,"ل",1,0],["كأن الأرضَ م صُفْرِ وحُمْرٍ","عروسٌ تُجتلى في حُلّتين",73,"ن",1,0],["كأنَّ الأرضَ ضاقتْ ليسَ فيها","مكانٌ لا لِإنس ٍأو لجَانِ",74,"ن",1,0],["كأنَّ الأسودَ الحجرَ استلمنا","ولكن بالعيون لنا استلام",75,"م",1,0],["كَأنَّ الأرْضَ قَدْ فَقَدَتْ وَلِيداً","فَأبْكَتْ أعْيُنَ الآفَاقِ حِينَا",76,"ن",2,0],["كأن الأقحوان فصوص تبرٍ","تركب في اللجين موسطات",77,"ت",1,0],["كأن ألاعيب الليالي تديرنا","ويضحك مِنّا الدهر ما شاء لاهيا",78,"ي",2,0],["كأن الأرض إرث عن جدود","وهذا الشعب سرب من عبيد",79,"د",1,0],["كَأَن الأَرض شَخص وَهيَ وَجه","وَأَنتَ بِوَجهِها وَضح اِبتِسام",80,"م",1,0],["كأن الأَمير ابن الأَمير اذا سَطا","صواعق ترمي النار أو أسد يَحثو",81,"ث",2,0],["كأنّ الأسُودَ الزُّرْقَ ركّبْنَ فوقها","بإرماحِهمِ بين الحَمَاحِمِ والزَّجْرِ",82,"ر",1,0],["كأنّ الأَيمَنَينِ بني نُمَيرٍ","وإيانا وقد حَسِرَ القتالُ",83,"ل",1,0],["كأن الأحمر المريخ مغضٍ","على حنقٍ يشب به شهابا",84,"ب",2,0],["كأن الأرض ما شملتك إلّا","لتمرح في جوانبها سبوحا",85,"ح",2,0],["كَأَنَّ الأَثافي السُفعَ في عَرَصاتِها","حَمائِمُ وُرقٌ يَومَ قرٍّ شَوامِسُ",86,"س",1,0],["كأن الأثافي السودَ كبدي قطعنَها","ظُبى البَين أثلاثاً كتقسيمِ قاسمِ",87,"م",1,0],["كانَ الأَمانَ لَنا مِن كُل نازِلَةٍ","حَتّى مِن المَوت مَن يَهرب لَهُ أَمنا",88,"ن",2,0],["كأنَّ الأرض قد رفَعَتهُ صرحاً","تُطالعُ منهُ أسبابَ السماءِ",89,"ا",2,0],["كأَنَّ الأَعوجيَّة يوم فَرّوا","مُقَيَّدةُ القوائِم أَو صُفون",90,"ن",1,0],["كان الأديب من الغنيّ يساره","واليوم منه لذي الغنى إيسار",91,"ر",1,0],["كأن الأجادل نحل به","قصير مدى جنحها الأطول",92,"ل",1,0],["كأن الأفق شدقك رحت منه","تكشر عن نجوم كالنيوب",93,"ب",1,0],["كَأَنَّ الأَيكَ حينَ صَدَحنَ فيهِ","نَوائِحُ يَلتَدِمنَ بِهِ التِداما",94,"م",2,0],["كأن الاحتلال رأى قطيعاً","فهم اليه من نمر وذيب",95,"ب",1,0],["كأنَّ الآبداتِ الرُّبْدِ فيهِ","أُلاتُ الوحفِ من حِزَقِ النِّعامِ",96,"م",1,0],["كانَ الالهُ لَهُ نَصيراً مُسعَفاً","إِذ أَنَّهُ بِسِواهُ لا يُستَنصَرُ",97,"ر",1,0],["كأن الأقاحي إزاء الشقي","ق تضمها نفحة الريح ضما",98,"م",2,1],["كأن الأقحوانة قبلتها","بمبسمها فأبقت فيه شكلا",99,"ل",2,0],["كأن الأسنة مخضوبةٌ","غوان تشير بكف خضيب",100,"ب",1,0],["كأنَّ (الأربعينَ) عليه عهدٌ","سيَمْضيها لتُستوفَى عقوده",101,"د",2,0],["كأنّ الآهَ في شَكواكِ نَوحٌ","على شعبٍ تُعاقِره البُحورُ",102,"ر",1,0],["كأنَّ الأرضَ قد لبستْ شموخاً","فكان الشعبُ للأرضِ الثيابا",103,"ب",2,0],["كانَ الأَسَى شِبرَينِ أَو خُطوَةً","تَجتازُها فِي حَظِّها العاثِرِ",104,"ر",1,0],["كأن الأفق سد فليس يرجى","به نهج إلى كل النواحي",105,"ح",2,0],["كأنّ الآهَ بي حلباتُ خيْلٍ","تُسابقُ بعضَها بعْضاً تجولُ