90,"تطويق","https://www.poetsgate.com/ViewPoem.aspx?id=179173",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[45,"لَهَا الله عَنّي ضَامِنٌ وَكَفِيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32127",""],[45,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""],[45,"يُهدي الخيَالُ لَنَا ذِكْرَى، إذا طَافَا","https://www.poetsgate.com/ViewPoem.aspx?id=32542",""],[45,"عَزَمْتُ عَلى المَنَازِلِ أنْ تَبينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31886",""],[45,"أقَصْرَ حُمَيدٍ! لا عَزَاءَ لمَغْرَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31730",""],[105,"إلام تجن الحادثات وتظلم","https://www.poetsgate.com/ViewPoem.aspx?id=12839",""],[35,"حِبَالُ سُجَيْفَة َ أمْسَتْ رِثَاثَا","https://www.poetsgate.com/ViewPoem.aspx?id=21988",""],[28,"عسى أسد أن يطلق الله لي به","https://www.poetsgate.com/ViewPoem.aspx?id=22099",""],[28,"لقد كنت أحيانا صبورا فهاجني","https://www.poetsgate.com/ViewPoem.aspx?id=16950",""],[38,"أحارِ بنَ عبدٍ للدّموعِ البوادرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21197",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[51,"توهَّمْتُ قد سوَّفتَ بالغوث راجياً","https://www.poetsgate.com/ViewPoem.aspx?id=29504",""],[51,"وأما بلاءُ البحر عندي فإنه","https://www.poetsgate.com/ViewPoem.aspx?id=25877",""],[39,"أَمِنْ دِمَنٍ بِشاجِنَة ٍ الحَجُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=4310",""],[87,"هَل فى الخلاعة ِ والصِبا من باسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23987&r=&rc=249",""]],"verses":[["نَوائِبُ أَلقَتِ الجُلّى عَلَيهِ","فَقامَ بِعِبئِهِنَّ وَما أُعينا",0,"ن",2,0],["نَوائِبُ أَيّامٍ نَسَرنَ خَصائِلي","مُغالَبَةً حَتّى عَرَقنَ عِظامي",1,"ي",1,0],["نَوائِبُ ما أَصَخنَ إِلى عِتابٍ","يَطولُ وَلا خَدِرنَ عَلى مَلامِ",2,"م",1,0],["نُؤَمِّلُ الخُلدَ وَالأَيّامُ ماضِيَةٌ","وَبَعضُ آمالِنا ضَربٌ مِنَ الخَطَلِ",3,"ل",1,0],["نُؤَمِّلُ أَن نَروى مِنَ العَيشِ وَالرَدى","شَروبٌ لِأَعمارِ الرِجالِ أَكولُ",4,"ل",1,0],["نَواصِبِ آذانٍ إِلى كُلِّ نَبأَةٍ","طَوامِحِ أَلحاظٍ إِلى كُلِّ مارِقِ",5,"ق",1,0],["نَوالُهُم بَينَ صَعبِ النَيلِ مُمتَنِعٌ","بِالمَطلِ أَو مُستَخَسِّ القَدرِ مَردودِ",6,"د",1,0],["نُؤيٌ كَمُنعَطِفِ الحَنِيَّةِ دونَهُ","سُحمُ الخُدودِ لَهُنَّ إِرثُ رَمادِها",7,"د",3,0],["نُوَجِّهُ بِالثَناءِ لَهُ مَصوناً","وَنَرتَعُ مِنهُ في مالٍ مُباحِ",8,"ح",1,0],["نُوّارُها المَجدُ لا حَن","وَةُ الرُبى وَالعِربُ",9,"ب",1,0],["نُوادِعُ أَحداثَ اللَيالي عَلى شَفاً","مِنَ الحَربِ لَو سالَمنَ مَن لَم يُحارِبِ",10,"ب",1,0],["نَؤُمُّ بِكَعبِ العامِريِّ نُجومَها","إِذا ما نَظَرناها اِنتَظَرنا غِيابَها",11,"ب",3,0],["نَواحِلَ لَم يَدَع ضَربُ الهَوادي","بِها أَبَداً مَكاناً لِلجُلاءِ",12,"ا",2,0],["نَواصِلَ من أعْقابِ لَيلٍ كأنّما","سَقاها الكرى عانيَّةً وسَقاني",13,"ن",2,0],["نَوى ظَعَناً قبْلَ الوَداعِ مُبادِراً","فجادَ الحَيا مثْواهُ أنْ يتَماحَلا",14,"ل",2,0],["نوَيْتُ الجَنى قبْلَ يوْمِ النّوى","وكُلُّ امْرِئٍ فلَهُ ما نَوى",15,"و",2,0],["نَوَوْا سَفَراً عنّي الغَداةَ وأزْمَعوا","فيا لَيْتَ شِعْري بعْدَهُمْ كيفَ أصْنَعُ",16,"ع",1,1],["نورٌ كما متَعَ الصّباحُ لناظِرٍ","وخَلائِقٌ كالرّوْضِ غِبَّ قِطارِ",17,"ر",1,0],["نَوّاحَةٌ رَخوَةُ الضَبعَين لَيسَ لَها","لَمّا نَعى بِكرَها الناعونَ مَعقولُ",18,"ل",1,0],["نورُ اليَقينِ وَنورُ الشَيبِ بَينَهُما","سَكينَةٌ حَرَّكَت نَفسي وَوِجداني",19,"ي",1,0],["نَؤُمُّ بِها بِلادَ بَني أَبين","عَلى ما كانَ مِن نَسَبٍ وَصِهرِ",20,"ر",1,0],["نَواعِمُ يُتبِعنَ الهَوى سُبُلَ الرَدى","يَقُلنَ لِأَهلِ الحِلمِ ضُلَّ بِتِضلالِ",21,"ل",1,0],["نَواعِمُ عُمٌّ عَلى مِثَبٍ","عِظامُ الجُذُوعِ أُحِلَّت بُعاثا",22,"ث",2,0],["نوهوا بي فصرت رب القوافي","جعلوني من صالح الأبدال",23,"ل",1,0],["نَوَاكُمْ أَرْخَصَ العَبَرَاتِ حَتَّى","لَيَبْخَلَ بَاذِلُ الدُّرِّ المُذَابِ",24,"ب",1,0],["نَوَدُّ بَقَاءً عَالِمِينَ بِمَا بِهِ","وَفِي كُلِّ يَوْمٍ حَسْرَةٌ وَأَنِينُ",25,"ن",1,0],["نَوَابِغُ آدَابٍ وَعِلْمٍ تَلاحَقُوا","وَكَانُوا مِنَ الآدَابِ وَالعِلْمِ مَا كَانُوا",26,"ن",3,0],["نُورٌ يَمُدُّ جِرَاباً","فِي أعْيُنِ المُبْصِرِينَا",27,"ن",2,0],["نُورُ الهُدَى أَهْدَتْ إِلَى شَاعِرِهَا","مِحْبَرَةً تَبْتَعِثُ الإلهَامَا",28,"م",2,1],["نُوَبُ الدَّهْرِ لا تُرَفَّهُ بِالبَ","ثِّ تَبَارِيحُهَا وَلا بِالْوُجُومِ",29,"م",1,0],["نوفي عَلى هامِ الخَلائِفِ مِثلَما","توفى الجِبالُ عَلى رُؤوسِ القَردَدِ",30,"د",1,0],["نَواشِطُ مِن يَبرينَ أَو مِن حِذائِهِ","مِنَ الأَرضِ تَعمي في النُحاسِ المُخَزَّمِ",31,"م",1,0],["نَواشِطُ بِالرُكبانِ في كُلِّ رِحلَةٍ","تَهالَكَ مِن بَينِ النُسوعِ سِخالُها",32,"ل",3,0],["نَواعِمُ رَخصاتٌ كَأَنَّ حَديثَها","جَنى النَحلِ في ماءِ الصَفا مُتَشَمَّلُ",33,"ل",1,0],["نَواجٍ إِذا ما اللَيلُ أَرخى سُتورَهُ","وَكانَ سَواءً سودُ أَرضٍ وَبيضُها",34,"ض",3,0],["نَؤُمُّ بِآفاقِ السَماءِ وَتَرتَمي","بِنا بَينَها أَرجاءُ دَوِيَّةٍ غُبرُ",35,"ر",1,0],["نورٌ على نورٍ بأبهى منظرٍ","في حسنه لمؤمِّلٍ ما يأمُلُ",36,"ل",1,0],["نورية كجبينة وكلاهما","يجلو ظلامَ الليل بالوجه الأغرْ",37,"ر",1,0],["نَوار تستجِدّ بها المعالي","وتَبلى دون عفتها العيوب",38,"ب",1,0],["نَواحِلُ يَخبِطنَ السَريحَ إِلَيكُمُ","مِنَ الرَملِ حَتّى خاضَ رُكبانُها البَحرا",39,"ر",2,0],["نُؤَدّي العَظيمَ لِلجِوارِ وَنَبتَني","فَعالاً وَقَد نُنكي العَدُوَّ المُساجِلا",40,"ل",2,0],["نَوائِبُ مِن خَيرٍ وَشَرٍّ كِلَيهِما","فَلا الخَيرُ مَمدودٌ وَلا الشَرُّ لازِبُ",41,"ب",1,1],["نوحي عَلَيَّ بِحَسرَةٍ","مِن خَلفِ سِترِكِ وَالحِجابِ",42,"ب",1,0],["نُوَلّيها المَلامَةَ إِن أَلَمنا","إِذا ما كانَ مَغثٌ أَو لِحاءُ",43,"ا",2,0],["نَواضِحَ قَد عَلَّمَتها اليَهودُ","عُلَّ إِلَيكَ وَقَولاً هَلُم",44,"م",1,0],["نوراً أَضاءَ عَلى البَرِيَّةِ كُلِّها","مَن يُهدَ لِلنورِ المُبارَكِ يَهتَدِ",45,"د",1,0],["نوعٌ من الصدقِ مرفوع المنارِ غدا","في الصالحاتِ من الأعمالِ في الكتب",46,"ب",1,0],["نوالٌ تلظى الغيث بالبرق حرقةً","لتقصيره عنه وبالرَّعد عيَّطا",47,"ط",2,0],["نوالك السعديّ يا سيدي","أرجو على عاداته مربعه",48,"ه",1,1],["نوال عزٍّ أضافته الصفات إلى","تدبيرِ محتنكٍ في عزم مكتهل",49,"ل",1,0],["نوعاً من الشعر لا يدعى سواك له","إن المدائح كالعليا لها قيم",50,"م",1,0],["نُوائِلُ من زلزالها محو خسفها","فلا خيرَ في أوساطها والجوانبِ",51,"ب",1,0],["نواجٍ في البطائح ملقِيَاتٌ","حيازمَها على الهول المهيبِ",52,"ب",1,0],["نورُ عينٍ سُرور نفسٍ وَقَانا","ربُّنا فقدَه ولو بِفُقودِ",53,"د",1,0],["نَوَّلَتْ وهْي منيعٌ نيْلُها","وسَرتْ وهْي قطيعُ الخطْوِ رُودُ",54,"د",1,0],["نوى بإسدائه رضا ملك","نفَّله الحمد بعد ما أجَره",55,"ر",2,0],["نواها نواهم في الرمايا كأنما","مواقعُها فيما يشاؤون يُقدَر",56,"ر",1,0],["نوالُك كالسيل المسهِّل بعضُه","لبعض طريق الجري في السهل والوعر",57,"ر",1,0],["نوَّهتُ باسمك مُحسناً","بعد الخمول ألا فشكرا",58,"ر",2,0],["نورٌ ونار لهما وقدةٌ","لو قُرِنا بالماء لم يَجمُس",59,"س",1,0],["نواله كالغيث في أزمة","ورأيه كالنجم في حِنْدِس",59,"س",1,0],["نوال أبي عيسى قريبٌ ومن بغى","منالَ أبي عيسى فأدناه شاحِطُ",60,"ط",1,0],["نوالُك يا ابن الأكرمين مُناهزاً","به فُرصاً قد أمكَنَتْ فهي شُرَّعُ",61,"ع",1,0],["نؤلف منها بين شتّى وإنما","نشتت من ألّافها ما تجمعا",62,"ع",2,0],["نوسعها ذماً على أنها","بذّالة ليست بمنّاعه",63,"ع",2,0],["نواهد لا يُعَدُّ لهن عيبٌ","سوى منع المحب من العناق",64,"ق",1,0],["نوازلُ بين الانبساطِ إلى الخنا","وبين انقباضِ المُخبتاتِ النواسك",65,"ك",1,0],["نُولّيه أطرافَ الثنايا وإنّه","ليَدْمَى من الألحاظِ بل حين يُوهمُ",66,"م",1,0],["نُواهقُ أشباهاً لها ونظائراً","مُلمَّعةً بالودع سُفْعَ الملاطمِ",67,"م",1,0],["نوالك إني لم أشِم بك خُلَّباً","كذوباً ولا استسقيتُ منك جهاما",68,"م",2,0],["نوِّلْ فإنك مَجْزِيٌّ وإنَّ معي","شُكراً إذا شئتَ لم يخلطْهُ كُفران",69,"ن",1,0],["نوْكٌ وغَيٌّ وعيُّ","وأنت مَعْ ذا دَعيُّ",70,"ي",1,1],["نَواعِمُ لَم يَقِظنَ بِجُدِّ مَقلٍ","وَلَم يَقذِفنَ عَن حَفَضٍ غُرابا",71,"ب",2,0],["نورٌ أَضاءَ لَنا البِلادَ وَقَد دَجَت","ظُلَمٌ تَكادُ بِها الهُداةُ تَجورُ",72,"ر",1,0],["نَواعِمَ لَم يَلقَينَ في العَيشِ تَرحَةً","وَلا عَثرَةً مِن جَدِّ سَوءٍ يُزيلُها",73,"ل",3,0],["نَوائِمَ كُسيَت بَعدَ عُريٍ وَأُلبِسَت","بَرانِسَ كُدراً لَم تُعَنَّ الغَوازِلا",74,"ل",2,0],["نورٌ لا يُشرِقُ في النَفسِ","كَغَباءٍ في أُذنِ الحَجرِ",75,"ر",1,0],["نَواجٍ إِذا وَقَدَ الحَزوَرُ","إِذا الرَملُ قَدَّمَ أَثباجَهُ",76,"ه",1,0],["نَواعِمُ أَبكارٌ تُواري خُدورَها","نِعاجُ المَلا نامَت لَهُنَّ الجَآذِرُ",77,"ر",1,0],["نُوَضِّحُ