{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[79,"قد زرت قبرك يا أبا الشرف","https://www.aldiwan.net/poem35694.html","الكامل"],[88,"لله عيد كبير","https://www.aldiwan.net/poem68945.html","المجتث"],[95,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[95,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[53,"يا لهف نفسي للأحبه","https://www.aldiwan.net/poem8185.html","مجزوء الكامل"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"شنطف يا عوذة السموات والأرض","https://www.aldiwan.net/poem62918.html","المنسرح"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[53,"عيد يعود كعود عرفك دائما","https://www.aldiwan.net/poem66029.html","الكامل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[93,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[94,"يا ليت شعري هل لليل الن","https://www.aldiwan.net/poem38974.html","مجزوء الكامل"],[87,"لم تقل لي عن الفتى ما أيوه","https://www.aldiwan.net/poem6961.html","الخفيف"],[87,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[58,"وغرير يقضي بحكين في الراح","https://www.aldiwan.net/poem58529.html","الخفيف"],[47,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[47,"حاشاك من ذكر ثنته كئيبا","https://www.aldiwan.net/poem10895.html","الكامل"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[47,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[51,"الخير والشر عادات وأهواء","https://www.aldiwan.net/poem10313.html","البسيط"],[51,"إياك أعني يا ابن آدم فاستمع","https://www.aldiwan.net/poem62153.html","الكامل"],[33,"أصبح القلب للقتول صريعا","https://www.aldiwan.net/poem42240.html","الخفيف"],[54,"بخلا بهذا الدهر لست أراك","https://www.aldiwan.net/poem26770.html","الكامل"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[50,"دق معنى الخمر حتى","https://www.aldiwan.net/poem65285.html","مجزوء الرمل"],[48,"ضمكم جنس وأزرى بكم","https://www.aldiwan.net/poem23547.html","السريع"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20249","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55019","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[108,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[124,"آنستني بالأملا المغري","https://www.aldiwan.net/poem49283.html","السريع"],[226,"صمدت للعظات هذي الطلول","https://www.aldiwan.net/poem55287.html","الطويل"],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[303,"حيتك باسمة ثغور الزنبق","https://www.aldiwan.net/poem36840.html","عموديه"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[369,"حشو فؤادي فرح","https://www.aldiwan.net/poem60967.html","مجزوء الرجز"],[373,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem1880.html","السريع"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[463,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[484,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[520,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[556,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[567,"ما دام هذا اليوم يخلفه الغد","https://www.aldiwan.net/poem52845.html","الكامل"],[580,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122617","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54060","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63933","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96731","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79471","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79969","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79998","الكامل"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144599","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101038","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108460","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143173","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87728","الرجز"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198453",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138465",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216465","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111397","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86389","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93759","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104879","السريع"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104900","الكامل"],[4767,"حسن الخاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178993",""],[5101,"بلفور عِد ما شئت","https://www.poetsgate.com/ViewPoem.aspx?id=193170",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5320,"بطاقة عضوية","https://www.poetsgate.com/ViewPoem.aspx?id=43258",""],[5376,"ما حالُنا يخفاك يا ربي","https://www.poetsgate.com/ViewPoem.aspx?id=192708",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5667,"آهِ من أرضِ دبي","https://www.poetsgate.com/ViewPoem.aspx?id=214804",""],[5691,"شهيد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=206246",""],[5776,"لعنة القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=199405",""],[5956,"لم تقع عيني على أجمل منكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182269",""],[5956,"لِمَ تقطعين الغاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=182417",""],[5956,"تركتِ وُدَّكِ قاصيا","https://www.poetsgate.com/ViewPoem.aspx?id=182527",""],[5956,"يا ألفَ شكر للسمية بِنْتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=206261",""],[6070,"ياقافلَ الأبوابِ بالسَّكتِ","https://www.poetsgate.com/ViewPoem.aspx?id=188868",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["لَم تَقُل لا وَلَم تَشُدَّ عَلى خِل","فِ النَدى بَينَ راحَتَيكَ صِرارا",0,"ر",2,0],["لم تقدر الأيام قيمتها","فاسترجعت صوناً إلى الصدف",1,"ف",1,0],["لَم تَقتَبِلهُ البَرايا","إِلّا لِلَثمِ يَمينِك",2,"ك",1,0],["لَمْ تَقْتَضِيهَا زِينَةً فَازّيَنَتْ","بِخُلُوصِهَا فِي وُدِّهَا المُتَكَتَّمِ",3,"م",1,0],["لَمْ تَقُمْ أُمَّةٌ بِسُوقَةِ جَهْلٍ","إٍنَّمَا الأُمَّة الرِّجَالُ العِظَامُ",4,"م",1,0],["لم تُقْضَ حاجتُهم ولا","نَفعتْهُمُ نفسٌ مُحِبّهْ",5,"ب",2,0],["لم تقتحمك العيون من صِغَرٍ","ولا قَلتْك النفوس من كِبرِ",6,"ر",1,0],["لم تَقطعي قطُّ ذا مُكايدةٍ","بل تقطعين الوتين بالبخَر",7,"ر",1,0],["لم تَقُمْ سُوقُهُمْ وسوق تجار ال","حمدِ إلا تَفَرَّقا عن تَراضي",8,"ض",2,0],["لم تَقْرِ إبهاميك فاك ندامةً","يوماً إذا عضّ الرجالُ أَباهما",9,"م",2,0],["لم تُقِرُّوا العيونَ منهم بِنَصْرٍ","فأقِرُّوا عيونهمْ بانتقام",10,"م",1,0],["لَم تَقنَعوا كَالخامِلينَ بِأَنَّكُم","لَكُمُ شَرابٌ في الحَياةِ وَمَطعَمُ",11,"م",1,0],["لم تَقْتَرفْ إِثمَ الحياةِ","وكان مأواها اللَّهيبْ",12,"ب",1,0],["لم تقل لي عن الفتى ما أيوه","كان فخر الرجال كان مديرا",13,"ر",2,1],["لِم تَقاعَدَت دونَها وَتَوانى","سائِقُ الفُلكِ وَاِضمَحَلَّ شِراعُه",14,"ع",2,0],["لَم تَقُم عَلى","مِثلِهِ القُبَب",15,"ب",1,0],["لَمْ تُقَسْ بالذي عداكَ مِنَ الخَلْ","قِ فما الشّامِخاتُ مِثْلَ الرِّمالِ",16,"ل",1,0],["لَم تُقَصِّر عُلاوَةُ الرُمحِ عَنهُ","قيدَ رُمحٍ وَلَم تَضَعهُ خَطاءَ",17,"ا",2,0],["لَم تَقصُرِ الأَيدي وَلَم تَنبُ الظُبا","مِنكُم وَلَم تَكُنِ المَقالَةُ حوبا",18,"ب",2,0],["لَم تُقَلِّد لَهُ قِياماً بِأَمرٍ","فَاِحتَوى غِبَّ ذَلِكَ التَقليدِ",19,"د",1,0],["لَم تُقَلَّب قُلوبُنا يَومَ هَيجا","ءَ وَلَيسَت أَيدي سَبا أَيدينا",20,"ن",2,0],["لَم تَقتَحِم بي دَواعي النَفسِ مَعصيةً","إِلّا وَبَيني وَبَينَ النورِ ظَلماءُ",21,"ا",2,0],["لَم تَقبَلِ الدُنيا عَلى أَحَدٍ بِزي","نَتِها فَمَلَّ مِنَ الحَياةِ وَلا شَبَع",22,"ع",1,0],["لُمتُ قَلبي في حَبِّها فَعَصاني","وَلَقَد كانَ لي زَماناً مُطيعا",23,"ع",2,0],["لَم تُقلِعا حَتّى تَخَضَّبَ مِن دَمي","سَهماهُما وَحُسِبتُ مِن قَتلاكِ",24,"ك",1,0],["لَمْ تَقْتَرِنْ بِزمانٍ وَهْيَ تُخْبِرُنا","عَنِ المعادِ وعَنْ عادٍ وعَنْ إرَمِ",25,"م",1,0],["لَم تَقُم في الوَهمِ إِلّا","كَذَّبَت عَينَ اليَقينِ",26,"ن",1,0],["لَم تَقتَنوا مَجداً وَأَصبَحتُمُ","قِنَّ فُروجٍ لَكُم أَو بُطون",27,"ن",1,0],["لَم تَقِف آفَةُ العُيونِ حِجازاً","بَينَ وَثباتِهِ وَبَينَ الشُموسِ",28,"س",1,0],["لَمْ تَقْرِضِ الشَّعْرِ قَدِيماً فَهَلْ","وَاتَاكَ عَفْواً سَهْلُهُ وَالَمنِيعْ",29,"ع",1,0],["لَمْ تَقُمِ الْعِبْرةُ فِي حادِثٍ","قيَامَها فِي موْتِكَ الْفَاجِعِ",30,"ع",1,1],["لَمْ تَقْنِ جُهْدِكَ نَاشِئاً وَمُنْشِئاً","في الصَّالِحِيَّةِ وَالصَّلاحُ طَريقُ",31,"ق",1,0],["لَمْ تُقَصِّرْ وَلَمْ يَصُدَّكَ عَمَّا","تَبْتَغِيهِ مُلْك عَزِيزٌ وَقَصْرُ",32,"ر",1,0],["لم تقض في النوم الحيا","ةَ كما قضى فيه الحياة",33,"ا",2,0],["لم تقتل القوم عن سوء بدينهم","وانما الأمر مبني على القدر",34,"ر",1,0],["لم تقض لي منه سوى حبه","وذا قضاء بين الجور",35,"ر",1,0],["لم تقم هذه الخرائب إلا","فوق ملك عنه الكلام يطول",36,"ل",1,0],["لَم تَقنَعِ الأَيّامُ لا قَنِعَت بِأَن","نَسَفَت بُحوراً مِنهُمُ وَجِبالا",37,"ل",2,0],["لم تقوَ صغراها عَلى برْدِ الندى","أَفما تراها ذاتَ ثغرٍ أَزرق",38,"ق",1,0],["لَم تَقرِن بِزَمانٍ وَهيَ تُخبِرُنا","عَنِ المَعادِ وَعَن عادِ وَعَن أَرَمِ",39,"م",1,0],["لم تَقَدَّمْ شُرْبُها","إلا تلاهُ الفَرح",40,"ح",1,0],["لم تَقْرإ القَيْظَ جَنِيناً وَلا","أَصُرُّها تَحْمِل بَهْمَ الغَنَمْ",41,"م",1,0],["لم تقتعدها رغبةً في اللُّها","ولم تخف ضيماً ولم تفرَقِ",42,"ق",1,0],["لم تقصِّر بي مجاري أدمعي","فأَرُود الغيثَ أستبكي بروقَهْ",43,"ق",2,0],["لم تقرض الشعر حتى تستحق به","حقا يخولها الإحكام واعجبي",44,"ب",2,0],["لم تقتنع أحلامها بركوبها","ظهر النفاق وغارب العدوان",45,"ن",1,0],["لم تَقصدي رَميَ الجِمارِ إنّما","رميتِنا دون الجِمارِ بالفِتَنْ",46,"ن",1,0],["لم تقدني قهراً إليك فمن قب","لك بالقهرْ نحوه لم يقُدْني",47,"ن",2,0],["لَم تَقبَلِ السِلمَ إِلّا بَعدَ مَقدِرَةٍ","وَلا تَأَلَّفتَ إِلّا بَعدَ تَبديدِ",48,"د",1,0],["لم تُقطَعِ الأغصانُ من شَجراتها","إلاّ رأينا غَيرها يتَولَّدُ",49,"د",1,0],["لم تقفْ قطُّ في المعارِك إِلاَّ","كنت يا يوسفُ كيوسفَ حُسْنا",50,"ن",2,0],["لم تَقفُ كعباً ولا زهيرا","ولا حبيباً ولا كثيرا",51,"ر",2,0],["لم تقض فيها النفس حق وصالها","حتى رأيت خضاب ظلمتها نصل",52,"ل",1,0],["لم تُقَلِّبْ لها تميمٌ ولا ضبَّ","ةُ قلبَ الحزين دون قُرَيْش",53,"ش",1,0],["لم تقتصر عَن بلوغ المشكلات به","لمّا تماديت عن أهلٍ وأوطانِ",54,"ن",1,0],["لم تَقْذَ عيني بأذاهُ ولم","يَطِرْ فُؤادي بيَدِ الذُّعْرِ",55,"ر",1,0],["لم تقض من وصله بكرُ العُلى وطراً","حتَّى من الهام يقضي سيفُه وطرا",56,"ر",2,0],["لم تقض