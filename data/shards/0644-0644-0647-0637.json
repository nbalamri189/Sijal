{"poems":[[74,"لله طرف الغداة قد همعا","https://www.aldiwan.net/poem19195.html","البسيط"],[53,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[50,"لله طيف سرى فأرقني","https://www.aldiwan.net/poem66127.html","المنسرح"],[52,"يا طيب سيان عندي أنت والطيب","https://www.aldiwan.net/poem64855.html","البسيط"],[48,"ما أمس بالشبح الذي إن مر بي","https://www.aldiwan.net/poem23459.html","الكامل"],[92,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[280,"يا قرة العين إن العين تهواك","https://www.aldiwan.net/poem25546.html","البسيط"],[302,"يا دار مية بالجرعاء حياك","https://www.aldiwan.net/poem33201.html","البسيط"],[302,"جلا الكؤوس فجلى ظلمة السدف","https://www.aldiwan.net/poem33219.html","البسيط"],[302,"قم هاتها حمراء قبل المزاج","https://www.aldiwan.net/poem33308.html","السريع"],[310,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[519,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71022","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130637","البسيط"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117613","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56632","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93086","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122045","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100976","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48255","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109350","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89517","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138792",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53239","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87716","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140080",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48305","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66505","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133231","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133227","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102742","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90898","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45068","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94410","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117300","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76743","الكامل"],[4859,"وأدت طيفك!","https://www.poetsgate.com/ViewPoem.aspx?id=207181",""],[5956,"الله كرَّر لي نبيلِ ميشيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194195",""],[6152,"نعاس غجرية","https://www.poetsgate.com/ViewPoem.aspx?id=203041",""]],"verses":[["لله طرف الغداة قد همعا","وحملته الليالي فوقَ ما وسعا",0,"ع",2,1],["للّه طوْلك يا محمد إنه","لَيثور منه الشكْرُ والأحقادُ",1,"د",1,0],["للَّه طولٌ سيجزي غيرَ ما كذبٍ","طَوْلاً قصرتُ به ساعاتِيَ الطُّوَلا",2,"ل",2,0],["لِلَّهِ طَيفٌ سَرى فَأَرَّقَني","نَفَّرَ عَنّي لِشَقوَتي وَسَني",3,"ن",2,1],["لِلَّهِ طَيبَةُ لا تُبقي عَلى رَجُلٍ","بِقَلبِهِ هاجِسٌ كَالنارِ مَشبوبُ",4,"ب",1,0],["لِلَّهِ طاعَةُ رَبِّنا مِن خَلَّةٍ","فيها اِستَوى فُصَحاؤُنا وَالأَلكُنُ",5,"ن",1,0],["لله طِبُّك في السياسة إنه","رَوْح الوَنَى ودواءُ كلّ سقيم",6,"م",1,0],["للَّهِ طرفَيَّ أضحا لا يَشُوقُهما","إلا سناكِ وإلا طيبَ مغناكِ",7,"ك",1,0],["لِلَّه طيبُ لَيالٍ فيكِ مشرقةٍ","مرَّت فَما كانَ أَحلاها وأَحلاكِ",8,"ك",1,0],["لِلَّه طيب وصالٍ نلتُ من رشأ","بالحسن متَّسمٍ بالطيب متَّصفِ",9,"ف",1,0],["لِلَّه طَيفٌ من حَبيبٍ نأى","سَرى يَخوضُ اللَيلَ وَاللَيلُ داج",10,"ج",1,0],["للّه طالعُ سعدٍ قَد وَردت به","في يومِ حفلٍ إِلى لقياك مشهودِ",11,"د",1,0],["للّه طينَتُه أكانَتْ نُقطةً","نقطَتْ ببسمِ اللّه تحت الباءِ",12,"ا",2,0],["لله طيبٌ بذيَّاكَ الزمانِ مضى","عنا ولكن طيبَ الذّمْر لم يدمِ",13,"م",1,0],["للّه طارقة في الدين ما طرقت","سمع امرئٍ في الورى إلا وقد فزعا",14,"ع",2,1],["لله طرفٌ بعضُ ما أنا واصفٌ","من عدوهِ اللسانَ كليلا",15,"ل",2,1],["لله طنطا ما أشد سرورها","لله أعين أهلها من تبصر",16,"ر",1,0],["لله طائفة بعرصة كربلا","بفنائها طاف البقا بصفائها",17,"ا",3,0],["لِلَّهِ طَيْفُكَ إِذْ أَلَمَّ وَلِلدُّجَى","بُرْدٌ بِإِيمَاضِ البُرُوقِ مَطَرَّزُ",18,"ز",1,0],["للَه طيفٌ على بعد المزار سرى","يطوي البهيمين من ليلٍ ومن بيد",19,"د",1,0],["لله طلعةُ شمسهِ فصَريمُنا","صبحٌ بمفْعَمةِ الضيا لم يختفِ",20,"ف",1,0],["للّه طود من العرفان زلزله","كفّ القضاء ولولا اللَه اعياه",21,"ا",2,0],["لِلَّهِ طَلّابُ أَوتارٍ أَعَدَّ لَها","سَيراً حَثيثاً بِعَزمٍ غَيرِ مُؤتَشِبِ",22,"ب",1,0],["لله طهر تولى الله عصمته","أرداه رجس عظيمات جرائمه",23,"م",2,0],["لله طرف يوم شرقيِّ الحمى","شام بنجد بارقاً شَآمِيَا",24,"ي",2,1],["لِلّه طَعمُكِ يا حَياةُ","فَإِنَّهُ كَالعَلقَم",25,"م",1,1],["لله طيب زمان بالغوير مضى","والوصل غنى لنا في الدوح طايره",26,"ر",2,0],["لله طَلْعَتُها التي قد أُطْلِعَتْ","فجَلتْ على العُشّاقِ شمْسَ ضُحاها",27,"ا",3,0],["للَّه طرس قد أتى","من ماجد حاز المفاخر",28,"ر",1,1],["لله طيبة قد طابت بساكنها","والله جل بنور العز جلاها",29,"ا",3,0],["لله طيبة قد طابت مساكنها","إن المدائن بر وهى دأماء",30,"ا",2,0],["للّه طيف من أعالي بارق","قد زارني والجفن مني مغمض",31,"ض",1,0],["للَه طفل بالغ في مهده","حدا بدور التم دون حدوده",32,"د",2,0],["لِلَّهِ طيبُ عَشيَّة","زالَت بِها الأَكدارُ",33,"ر",1,1],["لِلَّه طودٌ سما حتىّ السماك عُلا","في ظلّ من أسَّس الإنصاف تأَسيسا",34,"س",2,0],["للَه طالع موالدٍ بطلوعه","لذوى السعادة أمن الترويع",35,"ع",1,0],["لِلّه طرف جال يا ابن محمد","فجنت به حوباؤه التأميلا",36,"ل",2,1],["لله طيفكَ كم غنّى على زمنٍ","ولّى، وكم كابدَ العذالَ ما اكترثا!",37,"ث",2,0],["لله طيبةُ طاهرَيْنِ أراهما","عيسى بْنَ مريمَ في جوار بَتولِ",38,"ل",1,0],["لله طيف ما ألذ عناقه","وله إذا حان الفراق عويل",39,"ل",1,0]]}