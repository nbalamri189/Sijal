px?id=185087",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5106,"هَٰذَا الحَبِيْبُ مِنَ العِرَاق","https://www.poetsgate.com/ViewPoem.aspx?id=150031",""],[5112,"طموح","https://www.poetsgate.com/ViewPoem.aspx?id=211420",""],[5277,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=186873",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[2215,"وساحرة الأجفان معسولة اللمى","https://www.poetsgate.com/ViewPoem.aspx?id=113145",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5703,"إلى المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=206078",""],[6093,"يا جاثياً في رسُوم الحيِّ معتكفا (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176186",""],[6164,"إلى الشاعر الواجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66079&r=&rc=88",""],[6223,"يا حادي الركب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1210&r=&rc=7",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["سِر في طَريقِكَ وادِعاً","فَلَأَنتَ مَأمونُ العِثارِ",0,"ر",1,0],["سر في حياتك سير نابه","ولُم الزمان ولا تُحابه",1,"ب",2,1],["سرْ في سناه إذا أضاء وإي","يَاكَ وأُلْهُوبَهُ إذا احْتَدَما",2,"م",2,0],["سر في سبيلك راشداً","واذهب كما ذهب الربيع",3,"ع",1,0],["سر في سبيل المجد ميتاً مثلما","قد سرت حيا ثم انت موفق",4,"ق",1,0],["سر في طريقك للسماء فعندها","شمس تغيب والف شمس تشرق",4,"ق",1,0],["سِر في الهَواءِ وَلُذ بِناصِيَةِ السُها","المَوتُ لا يَخفى عَلَيهِ سَبيلُ",5,"ل",1,0],["سِر في لِواءِ العَبقَرِيَّةِ وَاِنتَظِم","شَتّى المَواكِبِ فيهِ وَالأَتباعِ",6,"ع",1,0],["سِرْ في الدُّهورِ وقُمْ على هَاماتِها","عَلَماً يُضييءُ فَتهتدِي الرُّكبانُ",7,"ن",1,0],["سِر فَالسَعادَةُ حَيثُ كُنتَ تَكونُ","وَمِنَ السَعادَةِ سَيرُكَ المَيمونُ",8,"ن",1,1],["سِر فَالقُلوبُ عَلى ركابِكَ حُوَّمٌ","يَبدو لِعَينِكَ سِرُّها المَكنونُ",8,"ن",1,0],["سِرْ في ذِمامِ اللهِ دِحْيَةُ إنّها","لك حاجةٌ ما دونها مُتخَلَّفُ",9,"ف",1,0],["سِرْ في عبيدِكَ يا ابنَ حربٍ إنّما","لاقيتَ منهم سادةً ومَواليا",10,"ي",2,0],["سَرفتُ وَاللَهُ يُرجى أَن يُسامِحَنا","وَفي القَديمِ خَلا مِن أَهلِهِ سَرِفُ",11,"ف",1,0],["سَرَفاً فِي الذُّلِّ حَتَّى إِنهَا","لَمْ تَكُنْ تَدْرِي لِمَا تَفْعَلُ قَدْرا",12,"ر",2,0],["سرْ في طَرَابُلْسَ أنَّى شئتَ تَمْشِ بها","على طريق من البِلَّوْرِ منصقلِ",13,"ل",1,0],["سر في الحقول، ترَ الرياضة عندهم","فنَّا، وخطًا عندنا مكتوبا",14,"ب",2,0],["سر في الدهور وقم على هاماتها","علما يضيئ فتهتدي الركبان",15,"ن",1,0],["سِرْ في الهواءِ، ولُذ بناصية ِ السُّها","الموتُ يرفرفُ فيه عزرائيل",16,"ل",1,0],["سر فرقان المعاني","باشارات البيان",17,"ن",1,1],["سِرْ فِي ضَمانِ اللهِ مُكَتَنَفاً","حَتّى تَعُودَ مُبَلَّغَ الأَمَلِ",18,"ل",1,0],["سِر فما يلقاكَ في الز","زَعرورِ ما يوحشُ قَلبي",19,"ب",2,1],["سر في زمام أريجها تجدِ الهدى","يا نفحةً رَدَّت إليَّ فؤادي",20,"د",2,0],["سرفى طريق لهم","إلى الكريم والودود",21,"د",1,0],["سر في ركاب المحسنين مخلدا","بالعذب والمأنوس من سلساله",22,"ل",2,0],["سِرْ في أَمَانِ اللهِ فالْفَتْ","حُ المبينُ إِلَيْكَ سَائِرْ",23,"ر",1,0],["سَرِفٌ مَنزِلٌ لِسَلمَةَ فَالظَه","رانُ مِنّا مَنازِلٌ فَالقَصيمُ",24,"م",1,0],["سِر في أمانِ اللّه سالم","يا ذا المَفاخِر والمَكارِم",25,"م",1,1],["سر في المسامع والقلوب مكرماً","سمحاً يسايرك الربيع الأخضر",26,"ر",1,0],["سر في سبيل اللّه مت","بوع العقيدة واليقين",27,"ن",1,0],["سرْ فما نهجك إِما","سرتَ نهجي وطريقي",28,"ق",2,1],["سر في أمان فإن الحجب قد رفعت","كيما ترى الحق يا خير الورى شيما",29,"م",2,0],["سَر في أَمانِ اللَهِ يا رُوحَ الذَكا","وَأَحيي البِلاد بِفَضلِكَ المُستَقطَفِ",30,"ف",1,0],["سر في أمان الله في ألطافه","ما ثم لا تعب ولا إعياء",31,"ا",2,0],["سر في فضاء بني الورى وتجوّل","وإذا نزلت بدار ذلّ فارحل",32,"ل",1,0],["سر فداك الدهر مما قد جنى","فإليك الدهر قد ألقى الزماما",33,"م",2,0],["سر فما منا فتى الا وقد","ملئت أحشاءه مصر غراما",33,"م",2,0],["سر فقد ضاقت على سكانها","مصر لم تهنأ شرابا وطعاما",33,"م",2,0],["سِر في ضمانِ الله محفوفاً بما","تهوى من الإسعادِ والإسعافِ",34,"ف",1,0],["سِر فَالعِناية فَوقَ رَأسك حارس","في كُلّ مَغدى لِلسُرى وُمُعرَّس",35,"س",1,0],["سر في امان الله يا خير الورى","وعليك الف تحية وسلام",36,"م",1,0],["سِر فالهِلالُ كمالُهُ في سَيْرِهِ","والماءُ أَطيَبُ ما يكونُ إذا جرى",37,"ر",2,0],["سر في طريقك لا تخف","فالشوك للورد النضير",38,"ر",1,0],["سر في طريق المعالي غير مضطلع","باللغو في أمة أودت من الشغب",39,"ب",1,0],["سر في طريقك لا تحفل بذمهم","ولا يهزك مغرور اذا غضبا",40,"ب",2,0],["سر فكفى بفيض دمعيَ سلاّ","وأحاديث صبوتي فيك تبلّى",41,"ل",2,1],["سرٌّ فهمنا كنههُ لَمْ يَشْتَبِهْ","فنشكَّ فِيهِ وَلَمْ يهنْ فَيُفَسَّرَا",42,"ر",2,0],["سر في سبيلك رائدا فطنا فما","كطريق رواد العقول طريق",43,"ق",1,0],["سر في أمان الله بين جواحى","ولك البقاء فإننى لا أرجع",44,"ع",1,0],["سر في سُرور بَينَ أَعلام الهُدى","بِالعزّ يَرفعها سناً وَسَناءُ",45,"ا",2,0],["سِر في سُرور نَحوَ مَن سارَت لَهُ","شمّ الأَنوف السادة الخُلفاءُ",45,"ا",2,0],["سرّ فيها النّديم أيّ سرورٍ","حين راقت وطاب منها الجليس",46,"س",1,0],["سِرْ في طريقكَ بينَ اللائمين ولا","تحفَلْ بمن جدَّ في لومٍ ومن لَعِبا",47,"ب",2,1],["سِر في سبيل الحقِّ لا تخشَ الردى","أبداً ولو زأرت قساورةُ الرَّدى",48,"د",2,1],["سرفا يحرمه وإن هو لم يكن","يا صاح في العصيان يأتيك الحرج",49,"ج",1,0],["سِر في الوَرى بِسيرَةِ الأَمينِ","لا تَشتَرِ الدُنيا بِبَيع الدينِ",50,"ن",1,0],["سُرَّ في وصلها ولا كسرورٍ","سَرَّ عبدالكريم ربَّ الأيادي",51,"د",2,0],["سُرَّ فيه من بنى خير الملا","حلفاءُ الفضل بل والخُلفا",52,"ف",2,0],["سُرَفُ النائبات رَغماً وقهراً","عبَرتْ فوق سادةٍ وعبيدِ",53,"د",1,0],["سَرَفَ الْفَجْرِ أَتَىْ فَوْقَ غَمَاْمٍ مِنْ أَمَاْنٍ","شَمْسُهُ وَجْهٌ تَثَرَّتْ مِنْ رَنَاْهَاْ يَتَمَاْرَىْ",54,"ر",2,0],["سَرَفُ الجَمَاْلِ عَلَىْ صَبَاْحَاتِ الطُّفُوْ","لَةِ قَدْ سَجَىْ وَجْهَاً بِأَحْلَاْمٍَ نَدِيَّا",55,"ي",2,0],["سِرْ فِي حُقُولِ الْحُلْمِ نَهْرَ لآلئ","يَسْقِيهِ مِنْ صَدْرِ السَّمَاءِ غَمَامُ",56,"م",1,0],["سرْ في ربوعِ الوردِ تلقَ حبيبةً","نظراتُها في العينِ كم تتوغَّلُ",57,"ل",1,0],["سرفٌ أعقب شعباً معدماً","كل عضوٍ منه يشكو محجما",58,"م",2,0],["سر في بلاد الله واطلب الغنى","تفز منجداً إن شئت أو شئت متهما",59,"م",2,0],["سر في طريق الحق والفصحى تجد","أعلام هدي في علا القمات",60,"ت",1,0],["سِرْ في طريقكَ لنْ تراني بعدَما","أعْددتُ للسَّفَرِ الأكيدِ شراعا",61,"ع",2,0],["سِرْ في البلاد فلن تلقى بها أحداً","إلا الخلافَ وإلا الدَّاء والعَجَفا",62,"ف",2,0],["سِرْ في طرِيقِكَ. إنَّه مُستَعْذَبٌ","ولو أنَّه أَصْلى الحَسُودَ جَهنَّما!",63,"م",2,0],["سر فالمطايا بها شوقٌ يسيّرها","وفي النفوسِ أزيز الشوق يشتعلُ",64,"ل",1,0],["سر في رحابٍ إلى الرحمن ما بقيتْ","بك السنون وما أبقى بك الأجل",64,"ل",1,0],["سرْ في طريقك قد وصلت إلى العلا","السرّ في أمرٍ تجلّ فشاء",65,"ا",2,0]]}