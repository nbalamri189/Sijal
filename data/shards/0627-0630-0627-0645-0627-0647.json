{"poems":[[79,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[88,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[95,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[85,"أإنسان عين الدهر جفنك قد غدا","https://www.aldiwan.net/poem54320.html","الطويل"],[29,"ألا حي بالبردين دارا ولا أرى","https://www.aldiwan.net/poem6020.html","الطويل"],[4,"إذا ما هتفنا هتفة في ندينا","https://www.aldiwan.net/poem21222.html","الطويل"],[53,"تفاءلت والفأل لي معجب","https://www.aldiwan.net/poem9220.html","المتقارب"],[53,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[14,"أليس ورائي أن أدب على العصا","https://www.aldiwan.net/poem38288.html","الطويل"],[58,"كلانا غصن شطب","https://www.aldiwan.net/poem58654.html","الهزج"],[47,"منى النفس في أسماء لو تستطيعها","https://www.aldiwan.net/poem64701.html","الطويل"],[30,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[63,"ألا غادها مخطئا أو مصيبا","https://www.aldiwan.net/poem51792.html","المتقارب"],[71,"إذا ما هجاني ناقص لا أجيبه","https://www.aldiwan.net/poem29062.html","الطويل"],[76,"أما ومسيل ماثل الغيث كالسطر","https://www.aldiwan.net/poem12949.html","الطويل"],[76,"كفى حزنا أن الديار قصية","https://www.aldiwan.net/poem13209.html","الطويل"],[42,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[54,"نؤوم على غيظ الأعاد محسد","https://www.aldiwan.net/poem27051.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[58,"كلانا غُصُنٌ شَطْبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17690&r=&rc=10",""],[132,"سقى بالمنحنى رسما وربعا","https://www.aldiwan.net/poem50581.html","الوافر"],[141,"إذا لم يكن خير مع الشر لم تجد","https://www.aldiwan.net/poem67974.html","الطويل"],[146,"أؤمل بعد هذا الأسر حلا","https://www.aldiwan.net/poem58406.html","الطويل"],[199,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[202,"دعا بإقامة الشوق الرحيل","https://www.aldiwan.net/poem51908.html","الوافر"],[203,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[276,"حروف معان أو عقود جواهر","https://www.aldiwan.net/poem52109.html","الطويل"],[283,"سرى موهناً طيف الخيال المؤرق","https://www.aldiwan.net/poem2481.html","الطويل"],[285,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[285,"متى أنا طاعن قلب الفجاج","https://www.aldiwan.net/poem60722.html","الوافر"],[303,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[303,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[371,"أسكان قلبي كيف جاورتم الأسى","https://www.aldiwan.net/poem17085.html","الطويل"],[382,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[382,"أما وأبيك أرماني زماني","https://www.aldiwan.net/poem59389.html","الوافر"],[411,"إذا ما هممت بكشف الظلم","https://www.aldiwan.net/poem49467.html","المتقارب"],[422,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[438,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[445,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[466,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[469,"وهيفاء تقتل عشاقها","https://www.aldiwan.net/poem3318.html","عموديه"],[505,"ألا يا ابن عم المصطفى لحظة لمن","https://www.aldiwan.net/poem37668.html","الطويل"],[556,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[556,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[580,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122792","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66647","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18535","المتقارب"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70768","الطويل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130870","الطويل"],[1267,"","https://poetry.dctabudhabi.ae/diwan/poem/144502","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100974","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101043","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11222","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11214","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69366","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53167","الطويل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115198","الطويل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17701","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100425","الوافر"],[3215,"","https://poetry.dctabudhabi.ae/diwan/poem/147370","الهزج"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100200","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62880","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62793","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129362","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131026",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131087",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131224",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34646","المتقارب"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101353","الهزج"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/201301","المتقارب"],[4578,"بفاتر جفنه فتن البريا","https://www.poetsgate.com/ViewPoem.aspx?id=49617",""],[4857,"الإنتفاضة","https://www.poetsgate.com/ViewPoem.aspx?id=30117",""],[5064,"خلا بِكَ شوقٌ يا فُؤادُ جديدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199128",""],[5582,"أَتَعْلَمُ ذاتُ الغُنْجِ أَمْ لَيْسَ تَعْلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=187302",""],[5768,"سُلُوكُ الْمَحَجَّةِ إلَى عَشْرِ ذِي الْحِجَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=215594",""],[5804,"السر الخطير ( لغز )","https://www.poetsgate.com/ViewPoem.aspx?id=214755",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5953,"إذا ما همومي أسرجت ثم ألجمت","https://www.poetsgate.com/ViewPoem.aspx?id=93874",""],[6152,"قريبا ستطوي سجل الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=215638",""],[6228,"فيض الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85976&r=&rc=13",""]],"verses":[["إِذَا مَا هِبَاتُ اللهِ كَانَتْ صَحِيفَةً","فَمَا هِيَ إلاَّ سَجْدَةٌ فِي الْمَوَاهِبِ",0,"ب",1,0],["إِذا ما هُمُ جَلَسوا بِالعَشِي","يِ فَأَحلامُ عادٍ وَأَيدي هُضُم",1,"م",1,0],["إِذا ما هاجَهُنَّ أَسىً جَديدٌ","هَتَكنَ سَرائِرَ القَلبِ الجَليدِ",2,"د",1,0],["إِذا ما هِيَ اِستَوفَت مِنَ البِرِّ غايَةً","تَأَتَّت لِأُخرى لا تَرى تِلكَ مَقنَعا",3,"ع",2,0],["إِذا ما هَرَقنَ الماء ثُمَّ اِستَقينَهُ","سَقاهُنَّ جَمٌّ مِن سُميحَةَ طافِحُ",4,"ح",1,0],["إذَا مَا هَزَّ لِحْيَتَهُ خَطِيباً","يَقُولُ الْخَصْمُ يَا أرْضُ ابْلَعِينِي",5,"ن",2,0],["إذا ما هفا فوق الرؤوس شراعُهُ","أراك جناحاً مُدَّ للجزر والمدِّ",6,"د",1,0],["إِذا ما هَوى في صَكَّةٍ وَقَعَت بِهِ","أَظَلَّت حَوامي صَكَّةٍ يَستَديمُها",7,"م",3,0],["إِذا ما هَتَفنا هَتفَةً في نَدِيِّنا","أَتانا الرِجالُ الصائِدونَ القَساوِرُ",8,"ر",1,1],["إذا ما هما اكتنفا حاجتي","فما ضرَّها عُقَدُ النافثِ",9,"ث",1,0],["إذا ما هززتُ الرمح يوم كريهةٍ","لجمعٍ فذاك الجمع أولُ منفضّ",10,"ض",1,0],["إِذا ما هَبَطنا مَنهَلاً في مَخوفَةٍ","بَعَثنا رَبيئاً في المَرابِئِ كَالجِذلِ",11,"ل",1,0],["إذا ما هَاجتِ الرِّيحُ","ومالَ المِرْطُ والإِتبُ",12,"ب",1,0],["إِذا ما هَبَطنا بَلدَةً كَرَّ أَهلُها","أَحاديثَ إِحسانِ نَداهُ يُذيعُها",13,"ع",3,0],["إِذا ما هَبَطنا بَلدَةً كانَ أَهلُها","بِها وُلِدوا يَظعَن بِها كُلُّ جارِمِ",14,"م",1,0],["إذا ما هممْنا بِغِشْيَانِها","رَكِبْنا لها وَلَداً أو نسيبا",15,"ب",2,0],["إذا ما هجاني ناقصٌ لا أُجيبُهُ","فإنِّيَ إنْ جاوبتُهُ فلِيَ الذَّنْبُ",16,"ب",1,1],["إِذا ما هَوى رُكنٌ فَأَهوى فَإِنَّني","لَأَشجى مِنَ الخَنساءِ تَبكي عَلى صَخرِ",17,"ر",1,0],["إِذا ماهَدانا فيهِ بارِقُ مَبسِمٍ","أَجَنُّ دُجىً فَرعٌ فَخِرتُ ضَلالا",18,"ل",2,0],["إِذا ما هُوَ قَفّى أَوَّ","لَ النَجمِ تَواليهِ",19,"ي",2,0],["إِذا ما هُوَ اِستَغنى اِهتَدى لِاِفتِقارِهِم","وَلا يَهتَدي يَوماً إِلَيهِ مُفاقِرُه",20,"ر",2,0],["إذا ما هوتْ ورقاتُ الخريفِ","أحسَّ لها وَخَزَاتِ السَّنانْ",21,"ن",1,0],["إذا ما هاجتِ الريحُ","ومالَ المرطُ والإثبُ",22,"ب",1,0],["إذا ما همَّ عاشقها وِداداً","برشْفِ لَثَاتها رامته لَسْعَا",23,"ع",2,0],["إِذا ما هُمُ هَمّوا بِإِحدى هَناتِهِم","حَسَرتُ لَهُم رَأسي فَلا أَتَقَنَّعُ",24,"ع",1,0],["إذا ما هزَّ في بُرديْه عِطفا","هززتُ عليه من كفَّىَّ نَصلا",25,"ل",2,0],["إِذا ما هَبَطنا بَلدَةً غَصَّ فَرجُها","بِنا وَكَسا الأَحدابَ أَصهَبُ ثائِرُ",26,"ر",1,0],["إذا ما همَّ أن ينجابَ ليلٌ","أَمَدَّتْهُ بعثيرَها الخيول",27,"ل",1,0],["إذا ما هجرتِ عذرنا الدلال","فليسَ دلالكِ إلا اعتذارا",28,"ر",2,0],["اذا ما هممنا بالزِيارة عاقنا","بعادك عنا لا الجفا وَالتجنب",29,"ب",1,0],["اذا ما هَداها الفكر أَهدت لذي النهي","شَمائل أَشهى من شمول المعاصر",30,"ر",1,0],["إذا ما هضابُ المجد سدّ طلوعها","ولم يَرْقَها من سائر النّاس مُرْتَقِ",31,"ق",1,0],["إِذا ما هَزَزْتُ الدَّهْرَ بِاسْمِكَ مادَحاً","تَتَثّنّى تَثَنِّي ناضِرِ الْعُودِ رَطْبِهِ",32,"ب",2,0],["إِذا ما هَجْمَةٌ وَرَدَتْ لِخِمْسٍ","كَفاها ظِمْئُها زَجَلَ المُجاجي",33,"ج",2,0],["إِذا ما همى دمعاً عَلَى ذابلِ المنى","يعود به غُصْنُ الأَمانيِّ مخضرّا",34,"ر",2,0],["إذا ما هبّتا لبلوغِ قصدٍ","بدا لهما فَوُجِّهتا لثان",35,"ن",1,0],["إِذا ما هَجَرتُم وَالدِيارُ قَريبَةٌ","فَلي عَنكُمُ قَبلَ الرَحيلِ رَحيلُ",36,"ل",1,0],["إذا ما هم تلوا الإنجيل قرت","نفوسٌ كنَّ في شَرَك الضلال",37,"ل",1,0],["إذا ما هز مِن بلواه سيفاً","أذوق الموت منه بكل هزَّهْ",38,"ز",2,0],["إذا ما هَمَمْتَ بكَشْفِ الظُّلَمْ","وحِفظ الثُّغورِ وسَدِّ الثُّلَمْ",39,"م",1,1],["إذا ما هزَزْناه هزَزْنا مهنَّداً","وهيهات منه المشرفيُّ المهنَّد",40,"د",1,0],["إذا ما همّ يعرفْ نُكولاً","ولمْ يُنكِرْ أعاديه نَكالا",41,"ل",2,0],["إِذا مَا هوى للطعنِ أَيقنتَ أَنه","لصرف الرَّدَى نحو النفوس رسولُ",42,"ل",1,0],["إذا ما هيج عنها ثارَ منه","إلى الهَجهاجِ عاصفةٌ بقُرِّ",43,"ر",1,0],["إذا ما هَمى مُسْحَنْفِرَ الوَدْقِ أصبحت","لهُ الهامِداتُ الغُبْرُ وهي مَراتِعُ",44,"ع",1,0],["إذا ما هدت بصباح الجبين","قلباً أضلت بليل الشعر",45,"ر",1,0],["إذا ما هززنا منك عضبا مهنَّداً","أتانا بآيات الغيوب العجائب",46,"ب",1,0],["إِذا ما همّ طوّح بالتّمادي","وداس السِّلْمَ في طرقِ القتالِ",47,"ل",1,0],["إذا ما هَبَطْن الرّملَ رمْلَ مُغَمَّسٍ","زحفن ولا زَحْفَ الصّلالِ الزّواحفِ",48,"ف",1,0],["إذا ما هجتَه هيّجتَ منه","وقد حَدَق العُداة به قِطارا",49,"ر",2,0],["إِذا ما همومي خالطَ الماءُ مَتْنها","تكدَّر لوناً بعد ما كانَ صَافييا",50,"ي",2,0],["إذا ما هِمتُ فيهِ ثَمِلت سُكراً","بِهِ وَكَأنَّني عاقَرتُ دَنّا",51,"ن",2,0],["إذا ما هداكَ الله عايَنت جَعفراً","فقل لوليِّ اللهِ وابن المهذبِ",52,"ب",1,0],["إِذا ما هَبَطنَ بِنا سَبسَباً","وَجاوَزنَ بَعدَ جِبالٍ جِبالا",53,"ل",2,0],["إذا ما هَوَت والعُثْر قدامها هوى","غدا العُثْر مقنوصاً بهويْتها قنصا",54,"ص",2,0],["اذا ما هممنا أن نبوح بما جنت","علينا الليالي لم يدعه الحيا منا",55,"ن",2,0],["إذا ما هممنا بغشيانها","ركبت لها ولداً أو نسيبا",56,"ب",2,0],["إذا ما هال صحبك بأس يوم","تذوب له المروءة والسماح",57,"ح",1,0],["إذا ما هزمت في الجوم خلنا","جبال النجم تنهد انهداما",58,"م",2,0],["إذا ما هم أقعده أخوه","وزاد إلى اللقاء جوى فقاما",59,"م",2,0],["إِذا ما هَبَطنَ الأ