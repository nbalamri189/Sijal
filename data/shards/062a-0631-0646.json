 رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[463,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[475,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[477,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[493,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[513,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[513,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[513,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[513,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[513,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[513,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[549,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[556,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[560,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"],[584,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem17611.html","الكامل"]],"verses":[["تَرنو إِلَيَّ بِعَينِ مُطفِلَةٍ","رَعَتِ النَوى وَمَساقِطَ المُزنِ",0,"ن",1,0],["تَرِنُّ لَهُ هامُ الرِجالِ وَإِن رَمَت","بِأَعيُنِها فيهِ النِساءُ أَرَنَّتِ",1,"ت",1,0],["تَرنو بِطَرْفِ غَزالٍ فاتِرٍ دَعِجٍ","نَفسي الفِداءُ لِطَرفٍ فاترٍ دَعِجِ",2,"ج",1,0],["تَرنو إِليَّ عَلى رُعبٍ يُخامِرُها","تَلَفُّتَ الظَّبيِ حينَ اِعتادَهُ الوَجَلُ",3,"ل",1,0],["تَرْنو بِخَوْصاءَ قَدْ أَلْقى الكَلالُ يَداً","فيها كَماوِيَةٍ في كَفِّ مُرْتَعِشِ",4,"ش",1,0],["ترَنّحَ منْ بَرْحِ الغَرامِ مَشوقُ","عشيّةَ زُمَّتْ للتّفرُّقِ نُوقُ",5,"ق",1,1],["تُرَنّحُني ذِكْراكُمُ فكأنّما","تَميلُ بيَ الصّهْباءُ حينَ أميلُ",6,"ل",1,0],["تَرْنو وقد وَلِعَ الفُتورُ بعَيْنِها","وَلَعَ الهَوى بفؤادِيَ المَفْتونِ",7,"ن",1,0],["تُرَنِّحُها ذِكراهُ حتّى كأنّنا","نَهُزُّ بِها أعْطافَهُنّ منَ السُّكْرِ",8,"ر",1,0],["تَرنو خِلالَ القَنا حَيْرى غَزالتُهُ","عن ناظِرٍ بِمُثارِ النّقْعِ مُكتَحِلِ",9,"ل",1,0],["تُرَنِّحُنِي الذِّكْرَى وَيَهْفُو بِيَ الْجَوَى","كَمَا مَالَ غُصْنٌ فِي الرِّيَاضِ رَطِيبُ",10,"ب",1,0],["ترنو بنجلاوين شبه الأصيل","تلطفت أنواره في المسيل",11,"ل",1,0],["ترنو إلى البحر ترجو نقع غلَتها","لحظ المهّجر إذ يبدو له الآل",12,"ل",1,0],["ترنو إليه بعين الخوف فاعلةً","ما كان يصدر من أمرٍ ومن طلب",13,"ب",1,0],["ترنو إلى الناس بالشكوى فتحسبها","ظمآن يشكو لآلٍ حُرقة اللُوح",14,"ح",1,0],["ترنو وقد عقد المُصاب لسانها","فشكت مصيبتها بمنطق حالها",15,"ل",3,0],["ترنَّحت وهي في كفَّيه من طربٍ","حتى لقد رقصت تلك الزجاجات",16,"ت",1,0],["ترنو لواحظها إلى عشَّاقها","فتصول بالأسياف في الأجفان",17,"ن",1,0],["ترنو بطرف لها مريض","بين جفون لها صحاحِ",18,"ح",1,0],["ترنُّ تحت الأكف الواقعات بها","حتى ترن لها أكناف بغداذِ",19,"ذ",1,0],["ترنو بطرف مؤنِسٍ قاتلٍ","لولا عمى الأهواء لم تؤنس",20,"س",1,0],["تَرنو بِمُقلَةِ جُؤذُرٍ بِخَميلَةٍ","وَبِمُشرِقٍ بَهِجٍ وَجيدِ غَزالِ",21,"ل",1,0],["تَرنو إِلى الأُفُقِ البَعيدِ بِمُقلَةٍ","كَلمى وَتَشتُمُ أَنجُمَ أَنجُمَ الجَوزاءِ",22,"ا",2,0],["تَرَنَّحَ عَصرُكُم فَخراً وَهَشَّت","لِصُنعِكُم عِظامُ المائِتينا",23,"ن",2,0],["ترنو إلى الدُّنيا","ومَا فيها بعينٍ باسِمَهْ",24,"ه",1,0],["تَرنُو إلى الشَّفقِ البَعيدِ","تغُرُّها أَحْلامُها",25,"ه",2,0],["تر نعمة موفورة وبجنبها","تبصر شقاء دائما وجهادا",26,"د",2,0],["تَرنو إِلَيَّ بِعَينِ الظَبيِ مُجهِشَةً","وَتَمسَحُ الطَلَّ فَوقَ الوَردِ بِالعَنَمِ",27,"م",1,0],["تَرنو فَتَنقَلِبُ القُلوبُ لِلَحظِها","مَرضى السُلُوِّ صَحائِحَ الأَوصابِ",28,"ب",1,0],["تَرَنّحُ بالبدرِ غُصْناً رطيباً","وترتجّ في السيرِ دِعْصاً ركاما",29,"م",2,0],["تَرْنُو الْعُيُونُ إِلَيْهِ فِي أَفْعَالِهِ","وَتَسِيرُ تَحْتَ لِوَائِهِ الأَقْوَامُ",30,"م",1,0],["تُرِنُّ بِها الرُكبانُ شَرقاً وَمَغرِباً","فَتُشئِمُ طَوراً بِالثَناءِ وَتُعرَقُ",31,"ق",1,0],["تَرَنَّحَ بي لَذعٌ مِنَ الشَوقِ موجِعٌ","نَسيتُ لَهُ الصَبرَ الجَميلَ تَأَلُّما",32,"م",2,0],["تُرَنِّقُ الطَيرُ إِذا ما عَدَت","أَنفاسَها في قُبلِ إِرخامِها",33,"م",3,0],["تَرنُو بِعَينَي جُؤذَرٍ خَرِقٍ","أَحوى المَدامشعِ فاتِرِ الطَرفِ",34,"ف",1,0],["تَرنو بِعَينِ غَزالٍ","سَحّارَةٍ بابِلِيَّه",35,"ي",2,0],["تَرنو بِناظِرَةٍ كَأَنَّ حِجاجَها","وَقبٌ أَنافَ بِشاهِقٍ لَم يُحلَلِ",36,"ل",1,0],["تَرَنُّمَ العيدانِ وَالزَميرِ","أَو كَدَوِيِّ النَحلِ في القَفيرِ",37,"ر",1,0],["تَرَنَّحَ الشَربُ وَاِغتالَت حُلومَهُمُ","شَمسٌ تَرَجَّلُ فيهِم ثُمَّ تَرتَحِلُ",38,"ل",1,0],["ترنّمُ بالأزجالِ حين نحتّهُ","ولو نكتهُ في الجوفِ يوما لقصّدا",39,"د",2,0],["تَرنو إِليَّ البَقَراتُ الحورُ","ثُمَّ اِرعويتُ وَالهَوى تَبصيرُ",40,"ر",1,0],["تَرنو إِلَيهِ العَروسُ عائِذَةً","فَلا يَمَلُّ الحَدّابُ مِن عَجَبِه",41,"ب",2,0],["تَرَنَّم في نَهارِكَ مُستَعيناً","بِذِكرِ اللَهِ في المُتَرَنِّماتِ",42,"ت",1,1],["تَرنو العيون الى السماء كأَنَّها","تَرجو هبوطَ مفرِّج رباني",43,"ن",2,0],["ترنم يَشدو بلبل فوق أيكه","وَيهتف صبحاً بين أَغصانه الخضر",44,"ر",1,0],["ترنو لكم وتكاد من أشواقها","تمشي وكيف حراكها ودبيبها",45,"ب",3,0],["تُرنِّحها سَكراتُ الهوى","وتُوقظها الفِتنُ النائمه",46,"ه",1,0],["ترْنو بأبْصارٍ سَواهِدَ لم تَذُقْ","طَعْماً لمَسْهَدِها ولا تَهْجاعها",47,"ع",3,0],["تَرَنَّمَ فِيهَا مِنْ ثَنَائِي بُلْبُلٌ","بِلَحْنٍ لَهُ فِي السَّمْعِ نَبْرَةُ مِعْزَفِ",48,"ف",1,0],["تَرْنُو بِأَحْوَرَ لَوْ تَمَكَّنَ لَحْظُهُ","مِنْ صَخْرَةٍ لَارْفَضَّ مِنها الماءُ",49,"ا",2,0],["تَرَنَّمْ بِأَشْعَارِي وَدَعْ كُلَّ مَنْطِقٍ","فَمَا بَعْدَ قَوْلِي مِنْ بَلاغٍ لِمُفْلِقِ",50,"ق",1,1],["تَرَنَّحَ الْغُصْنُ مِنْ أَشْوَاقِهِ طَرَباً","لَمَّا رَأَى الطَّيْرَ في أَوْكَارِهَا صَدَحَتْ",51,"ت",1,0],["تَرْنُو لِمَنْ غَشِيَ الوَغَى","وَلَهَا بِأَكْلِهِمُ وَحَمْ",52,"م",1,0],["تَرْنو إِلَيْهِ لَمَا تَرَى إِلاَّ نَدًى","حَيْثُ الهُمُومُ تَهُم بِالإِشْعَالِ",53,"ل",1,0],["تُرِنُّ إِرْنَانَ ثَكْلَى","مَفْقُودَةِ الأَوْلاَدِ",54,"د",1,0],["تَرْنُو بِعَيْنٍ أُفْرِغَتْ مِنْ نُورِهَا","وَتَمَدَّدَتْ أَرَأَيْتَ عَينَ الهَائِبِ",55,"ب",1,0],["تَرْنو رُنوَّ المُقَلِ القَواذي","وذُو الرِّعاثِ باليَفاعِ هاذِ",56,"ذ",1,0],["ترنو إلى الأمل المولّي مثلما","يرنو الغريق إلى المغيث النائي",57,"ا",2,0],["ترنو إليه فتُغضِي من مهابتهِ","فالطرفُ ما بينَ موصولٍ ومصدود",58,"د",1,0],["تَرْنُو لها الْجَوْزاءُ نَظْرةَ حَاسِدٍ","وبِذكْرِها تَلْهو النُّجومُ وتَسْمُر",59,"ر",1,0],["تَرْنُو العُيونُ فَتَجْتلي من نوره","فَيْضاً ويَغْلِبُها السَّنا فَتَحَيَّر",59,"ر",1,0],["ترنو إليها نجومُ الأفْقِ مُعْجَبَةً","تَوَدُّ لو قَبَسَتْ من نورِ مرْآها",60,"ا",3,0],["ترْنُو إِلى أبنائِها بنَواظرٍ","غَرِقَتْ بماءِ شُؤُونِها الهَطّالِ",61,"ل",1,0],["ترنو العيونُ يا ابنة المليك","من عالَمِ الغيب إلى أخيك",62,"ك",1,0],["ترنَّحَ النيلُ لما صاح من بَردَى","صوتٌ يعاونُه والحرُّ مِعوان",63,"ن",1,0],["تَرْنُو إلى اليَرْمُوك وَهْي مُشيحَةٌ","وتقول: إني لا أُصدِّقُ ما أرَى!",64,"ر",2,0],["ترنِّحني الذِّكرى ويهفوني الجوى","كما مال غصنٌ في الرِّياض رطيب",65,"ب",1,0],["ترنا غفونا أم ترى عبرت بنا","نفاثة سحر خدّرتنا غرائبه ! ؟",66,"ب",2,0],["تَرنُّ النوادي من مقالٍ يَقوله","كما رنَّ في بيتٍ يُهَدَّمُ مِعْوَل",67,"ل",1,0],["ترنو له زُهرُ النجوم وإنها","لو انصفته لسَوّدتْ احداقها",68,"ق",3,0],["ترنو ألى الأفق البعيد بمقلة","كلمى ،وتشتم أنجم الجوزاء",69,"ا",2,0],["ترنو إلى أجيادِها العطائل","على صدورٍ لسنَ بالقواحل",70,"ل",1,0],["تَرنُو إِلَى فَتَيَاتٍ فيهِ بَاسِمَةٍ","عَن كالأقَاحِى المُسَقَّى الطَّلّ والدِّيمَا",71,"م",2,0],["تَرنُو إلى الدَّاهِمِ المُسوَدِّ مُتَّئِداً","جِدّاً وتَحكُمُ فِيهِ حُكمَ مُتَئِدِ",72,"د",1,0],["ترنو بمغناطيسَ أحداقها","فتُجذَب الأرواحَ والأعينُ",73,"ن",1,0],["تَرنو إِلَيَّ الحادِثاتُ كَما رَنا","ظُهراً إِلى الشَمسِ المُنيرَةِ أَرمَدُ",74,"د",1,0],["تُرنِّحُ ريحُ الصَّبا قَدَّه","كغصنٍ بريح الصَّبا يَلْعب",75,"ب",1,0],["ترنوا إليك جُموعُ النَّاسِ مُصغِيةً","والخَصْمُ يُنْصِتُ والأقوامُ والدُّوَلُ",76,"ل",1,0],["ترنو لحاضرنا الشق","ي وتندب الماضي السعيد",77,"د",1,0],["ترنو الحمائمُ منها في ذُرى قُضُبٍ","تَخْتالُ مائسةً في سُنْدُسِ الورق",78,"ق",1,0],["ترنو إلى ساقٍ لها من حالِقٍ","سمحٍ يجود بواكفٍ مدرارِ",79,"ر",1,0],["ترنو النجوم إلينا وهي مصغية","لأنجم الليل أجفان وآذانُ",80,"ن",1,0],["تر