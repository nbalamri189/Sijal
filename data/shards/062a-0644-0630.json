{"poems":[[55,"خذي حديثك من نفسي عن النفس","https://www.aldiwan.net/poem30189.html","البسيط"],[53,"ذريني قسطنطين آكل شهوتي","https://www.aldiwan.net/poem64951.html","الطويل"],[53,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[53,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[53,"ألا يا زينة الدنيا جميعا","https://www.aldiwan.net/poem66039.html","الوافر"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[45,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[68,"ومجلس لذة أمسى دجاه","https://www.aldiwan.net/poem40674.html","الوافر"],[89,"ألم يأن أن يرضى عن الدهر مغرم","https://www.aldiwan.net/poem8248.html","الطويل"],[76,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[48,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/199045","الكامل"],[147,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[154,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[242,"ألا قل لمن يبغي إلى العز منفذا","https://www.aldiwan.net/poem18189.html","الطويل"],[255,"تلذ لي الآمال عجزا وإنما","https://www.aldiwan.net/poem14993.html","الطويل"],[275,"تحاول إنكارا ودمعك موضح","https://www.aldiwan.net/poem35613.html","الطويل"],[343,"تلذذت في الدنيا بكل طريفة","https://www.aldiwan.net/poem68696.html","الطويل"],[371,"تلذ بجنتها أعين","https://www.aldiwan.net/poem17013.html","المتقارب"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[422,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[422,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[438,"متى يملك الحلم الدنو على البعد","https://www.aldiwan.net/poem12601.html","الطويل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[445,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[457,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[466,"هنيئا لعيد أنت شاهد يومه","https://www.aldiwan.net/poem15903.html","الطويل"],[469,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[473,"أبو إسحاق شاعرنا إذا ما","https://www.aldiwan.net/poem59942.html","الوافر"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[505,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[519,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96982","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101534","الطويل"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/120172","الوافر"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130226","الوافر"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121550","الطويل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202554","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198858","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71063","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104725","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70318","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200024","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204579","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112611","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62942","المتقارب"],[3532,"","https://poetry.dctabudhabi.ae/diwan/poem/146253","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108332",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66463","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117318","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4691,"أقول لها أعيدي ما أحيلى","https://www.poetsgate.com/ViewPoem.aspx?id=175102",""],[5183,"روضة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=180198",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5781,"بين شوكه والألم....","https://www.poetsgate.com/ViewPoem.aspx?id=206644",""],[5897,"بين رمضان والعيد","https://www.poetsgate.com/ViewPoem.aspx?id=156847",""]],"verses":[["تَلَذُّ عَيني وَقَلبي مِنكَ في أَلَمٍ","فَالقَلبُ في مَأتَمٍ وَالعَينُ في عُرُسِ",0,"س",1,0],["تلذّين أُولاه ويُوردُ غبُّهُ","حياضاً من المكرُوهِ بعد حِياض",1,"ض",1,0],["تلَذُّ قرينيه عقودٌ كأنها","رؤوسُ مدارى ما أشدَّ وأوكعا",2,"ع",2,0],["تَلذُّ من كلّ سامع أُذناً","حُسناً ومن كل مُنشدٍ حنكا",3,"ك",2,0],["تلذُّ كأنها روْحٌ وراحٌ","وتمشي في العروقِ وفي العظامِ",4,"م",1,0],["تلذ بما يشقّ على العباد","وتنعم بانفرادك والسهاد",5,"د",1,0],["تَلَذُّ لَهُ المُروءَةُ وَهيَ تُؤذي","وَمَن يَعشَق يَلَذُّ لَهُ الغَرامُ",6,"م",1,0],["تَلَذَّذَتِ الحَواسُ اللَمسُ فيهِ","بِخَمسٍ يَستَتِمُّ بِها السُرورُ",7,"ر",1,0],["تَلَذُّ بِهِ الآلامُ وَهْيَ مُبِيرَةٌ","وَيَحْلُو بِهِ طَعْمُ الرَّدَى وَهْوَ عَلْقَمُ",8,"م",1,0],["تَلَذَّذ بِدارِ القَصفِ عَنِّيَ ساعَةً","وَأَبلِغ نَداماها أَعَمَّ سَلامِ",9,"م",1,0],["تَلَذُّ لِطَعمِهِ وَتَخالُ فيهِ","إِذا نَبَّهتَها بَعدَ المَنامِ",10,"م",1,0],["تَلَذُّ العَوالي والظُّبَى في بَنانِهِ","لِقاءَ الرّزايا من فُلولٍ ومن حَطمِ",11,"م",1,0],["تلذ لي الملامة في هواه","لذكراه واستحلي أذاها",12,"ه",2,0],["تَلَذُّ لَهُ الشَكوى وَإِن لَم يُفِدبِها","صَلاحاً كَما يَلتَذُّ بِالحَكِّ أَجرَبُ",13,"ب",1,0],["تَلَذُّ لهم مواردها","كان شرابَهَا ضَرَبُ",14,"ب",1,0],["تَلَذَّذْ بِهَا تَظْفَرْ بِلَذَّةِ حُبِّهِ","فَيَا فَوْزَ مَنْ أَمْسَى بِهَا مُتَلَذِّذَا",15,"ذ",2,0],["تَلذُّ لي الآمالُ عجزاً وإنما","أَلذُّ من الآمال عندي بلوغُها",16,"ه",2,1],["تلذُّ لهُ الآلامُ فهو أليفُها","فأثمنُ ما يُعطيكَ وهوَ مجرَّح",17,"ح",1,0],["تَلَذَّذتَ في الدُنيا بِكُلِّ طَريفَةٍ","عَلى أَنَّها أَيضاً حَرامٌ مُحَرَّمُ",18,"م",1,1],["تَلَذُّ بِجَنَّتِها أَعيُنٌ","وَفيها الَّذي تَشتَهي الأَنفُسُ",19,"س",1,1],["تَلِذُّ لِلمُملِقِ والغَنيِّ","والحاذِق المُتقِنِ والغَبي",20,"ي",1,0],["تَلَذُّ لنا القِيان بها سماعاً","إذا اتَّصَلَتْ بمنقطع الكلام",21,"م",1,0],["تَلَذُّ لك المكارم والعطايا","وتطربك الشَّجاعة والنزال",22,"ل",1,0],["تلذُّ لي أنت في سمعي وفي بصري","وما ألذّك في سمعي وفي بصري",23,"ر",2,0],["تلَذَّذْتُ في حَرِّ الهجير تلذُّذا","وبدَّلتُ هذا بعد أن عفته بذا",24,"ذ",2,0],["تلذّذْ بمصر فهيَ ربعُ أحبّتي","وخبِّرْ فتاها عن غرامي وعن وجدي",25,"د",2,0],["تَلَذُّ الليالي لَحْمَها ودِماءها","وَطَعْمُ الليالي عِنْدَهُنَّ عَلاقِمُ",26,"م",1,0],["تَلَذُّ بحَمْلِكُمُ عاتِقاهُ","عَلَى حَمْلِهِ كُلَّ عِبءٍ ثقيلِ",27,"ل",1,0],["تَلذُّ لنا ذكرَاهُمُ كلّما بَدا","صباحُ دجى تنشقّ عنه الحَنادس",28,"س",1,0],["تَلَذُّ لي الأشعارُ فيك صَبابةً","مُقَطَّعُها في محْفلٍ وقَصيدُها",29,"د",3,0],["تلذُّ بها الأشواقُ وهي مريرةٌ","ويعذبُ فيها الحبُّ والحبُّ قتّال",30,"ل",1,0],["تَلَذُّ لَهُ عِمارَتِها إِذا ما","أَصابَ لَها الدَعائِمَ آبَنوسا",31,"س",2,0],["تلذ لي العذل في جنب حبها","فما ثم إلا الحسن في كل رتبة",32,"ه",1,0],["تلِذُّ لنا المَتاعِبُ فيه ذَوْقاً","كما لذَّ الشِّفاءُ إلى السَّقيمِ",33,"م",1,0],["تلَذُّذُه بالبأسِ والعَفْو والتُقى","وبَذْلِ العَطايا لا بطِيبِ المآكِلِ",34,"ل",1,0],["تلذذ في بعد أحبابه","ليدنو من اللَه أو يقترب",35,"ب",1,0],["تلذُّ لاسماع الزمان كأنما","تردَّد فيه من معذّبتي ذكرُ",36,"ر",1,0],["تلذ لك المروأة وهى توذي","ومن يعشق يلذ له الغرام",37,"م",1,0],["تَلّذُ اليمين انتضاءً به","إذا الغمدُ عن متنه يُسلبُ",38,"ب",1,0],["تلذّذ في طعمِ الصبابة لذّةً","أَواخرُها محبوبة والأوائلُ",39,"ل",1,0],["تلذذ مقلتي ويذوب جسمي","وعيشي منك مقرون بحتفي",40,"ف",2,0],["تلذذه بالحلم والعلم والتقى","أرانا خفايا الرأى من دون ماستر",41,"ر",1,0],["تلذ لكم طعم الصبابة مهجتي","وينعم فيكم بالغرام فؤادي",42,"د",2,0],["تلذذ بنا واسمعْ لذيذ خطابنا","وعينيك نزه في عجائب قدرتي",43,"ت",2,0],["تَلَذُّ صِيامَ الدهر غيرَ مُطِيقَةٍ","ولكنَّه زُهْدٌ بها وتَوَرُّعُ",44,"ع",1,0],["تَلَذَّذ بِهذَا المَدحِ إِن كُنتَ طَالِبا","مَقامَ شُهُودٍ لِلنَّبىِّ وَأطنِبا",45,"ب",2,0],["تلذُّ لي في هَوَى ليلى معاتبتي","لأَنَّ في ذكرها بَرْداً على كَبدي",46,"د",2,1],["تلذّ لمقلتي سنةٌ كنومٍ","فيأتي الشعر لي شبه المنام",47,"م",1,1],["تلذ لدى نفسي مخالفة الورى","ويطربني صوت الملامة والذم",48,"م",1,0],["تلذّذوا للبذلِ للأرواحِ","واستأنسوا بالموتِ والكفاحِ",49,"ح",1,0],["تلذ المدامة أَخلاقَه","فتشربُ منه كما يَشرَبُ",50,"ب",1,0],["تلذ في حبك الأيام لي وأرى ال","تعذيب عذباً به والقلب مجهود",51,"د",1,0],["تلذ له المرؤة مثل صبٍ","يلذ له هوى ذات الحجالش",52,"ل",2,0],["تلذذت فيه بالهوى وهو سائغ","ومورده إذ ذاك أعذب مورد",53,"د",1,0],["تَلَذُّ ليَ الأشواقُ فيهِ كأَنَّها","حَلاوةُ قندٍ أو خلائقهُ الشهدُ",54,"د",1,0],["تلذّذتُ دهرى واغتذيت بعذبه","وفي زورة تدنى على نيل قربه",55,"ه",1,0],["تَلَذُّ لِيَ الآلامُ إِذ أَنتَ مُسقِمي","وَإِن تَمتَحِنّي فَهيَ عِندي صَنائِعُ",56,"ع",1,0],["تلذذ كل حرف من شفاه","وأسكر كل معنى ثغر ليلى",57,"ل",2,0],["تلذذت بنقيع الموت فيه فلم","تخفق لها راية في الحرب والحرب",58,"ب",1,0],["تَلَذَّذْ فَفِي طَعْمِ الصَّبابَةِ لَذَّةٌ","أَواخِرُها مَحْبُوبَةٌ وَالأَوائِلُ",59,"ل",1,0],["تَلَذّذْتَ في رَشْفِ عُمْري فَخُذْهُ","وإنْ شِئْتَ عُمْرًا رَضيعًا قَضَيْتْ",60,"ت",1,0],["تلذ بها الأرواح في مبسم الندى","وتسري بريّاها ورودٌ وأشواقُ",61,"ق",1,0]]}