{"poems":[[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[123,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4356.html","البسيط"],[147,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[556,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48767","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37870","البسيط"],[909,"","https://poetry.dctabudhabi.ae/diwan/poem/99817","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123376","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204467","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119383","البسيط"],[4869,"التطفل","https://www.poetsgate.com/ViewPoem.aspx?id=137910",""],[5829,"العبد التائب","https://www.poetsgate.com/ViewPoem.aspx?id=148784",""],[5952,"الشعر في مايا عجيب","https://www.poetsgate.com/ViewPoem.aspx?id=204159",""]],"verses":[["ولوافاك كي تُمهْرِجَ فيه","غير أنْ ليس ذاك في الإمكان",0,"ن",1,0],["وَلُّوا فلا صاحبٌ عن نَفس صاحِبِه","يُغنِي ولا والدٌ يَرجُوهُ مَولُودُ",1,"د",1,0],["وَلَو أَفَضتُ حَياتي لِلثَناءِ بِهِ","لَما نَهَضتُ بِمِعشارِ الَّذي يَجِبُ",2,"ب",1,0],["وَلَو أَفادَهُمُ عَمروٌ مَكايِدَهُ","ما فَكَّهُم مِن إِسارِ الرُعبِ إِفكُهُمُ",3,"م",1,0],["ولَّوُا فَلَما رجوْنا عدلَهم ظلموا","فليتَهم حكموا فينا بِما علِموا",4,"م",3,0],["ولو اِفتُديتَ فداك بادرةَ الرّدى الْ","أقوامُ بالمهجاتِ والأحداقِ",5,"ق",1,0],["ولو افتدت وطني دمائي من يد","عسراء حينئذ بذلت دمائي",6,"ا",2,0],["وَلّوا فِراراً بِلَيلٍ لا نُجومَ لَهُ","سِرّاً وَقَلبُهُم بِالرُّعبِ مَشمولُ",7,"ل",1,0],["ولّوا فكم تركوا هناك مصانعا","ومقاصرا ومخالدا ومجالسا",8,"س",2,0],["ولو أفاق من الأهواءِ فاقَهمُ","فإنه من يُفِقْ من سُكْرِها يَفُق",9,"ق",1,0],["ولوا فربّي غير ربكم فما","يعنيه أن أدعوه يوما سيدا",10,"د",2,1],["ولوا فعلوا ألقيت أيهم اجترا","من السدة العليا صريعاً إلى الثرى",11,"ر",2,0],["ولو أفضت دموعي حسب واجبها","أفضت من كل عضو مدمعا سربا",12,"ب",2,0],["ولو افكر ,, جيت شر مستطير","لكن الحآله تهون بنظرتي",13,"ت",2,0],["ولّوا فما تركوا في النفس من أملٍ","والشمسُ قد تركتْ من خلفها الشفقا",14,"ق",2,0],["ولو أَفَلََتْ عن العينين يبقى","لها من شِعْر خَفَّاقي نصيبُ",15,"ب",1,0]]}