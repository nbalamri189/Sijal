habi.ae/diwan/poem/136949",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54408","المتقارب"],[4236,"","https://poetry.dctabudhabi.ae/diwan/poem/76595","الخفيف"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138847",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33174","الخفيف"],[4600,"","https://poetry.dctabudhabi.ae/diwan/poem/203583","الرجز"],[4691,"عطرها يملؤني فرحا","https://www.poetsgate.com/ViewPoem.aspx?id=61363",""],[4858,"رحماك ربي","https://www.poetsgate.com/ViewPoem.aspx?id=34590",""],[4858,"صبراً أحبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=35641",""],[4884,"سَبْعٌ يَأْكُلُهُنَّ سَبْعْ","https://www.poetsgate.com/ViewPoem.aspx?id=201761",""],[5056,"<< صدح البلبلُ..>>","https://www.poetsgate.com/ViewPoem.aspx?id=34078",""],[5150,"الخائنة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202894",""],[5208,"الرجعه","https://www.poetsgate.com/ViewPoem.aspx?id=176847",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5409,"بدلت وجهه الحميا بوجهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155393",""],[5525,"سافري","https://www.poetsgate.com/ViewPoem.aspx?id=923",""],[5582,"لَمْ أَسْتَمِعْ يا هِنْدُ نَوْحَ حَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=187299",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5587,"شيان حالي","https://www.poetsgate.com/ViewPoem.aspx?id=210594",""],[5678,"أهلاً وسهلاً بخيار الناس","https://www.poetsgate.com/ViewPoem.aspx?id=96327",""],[178,"وصلت رقعة فأوصلت الوحشة","https://www.poetsgate.com/ViewPoem.aspx?id=200973",""],[5952,"لا وجه لي","https://www.poetsgate.com/ViewPoem.aspx?id=205983",""],[5956,"حكاية شخص فوق الرمال","https://www.poetsgate.com/ViewPoem.aspx?id=182719",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[5956,"أنا سكرانٌ بحبي لحفيدي","https://www.poetsgate.com/ViewPoem.aspx?id=193151",""],[5970,"ما بقائي في العيش بعد الذي بي","https://www.poetsgate.com/ViewPoem.aspx?id=130636",""],[6093,"ما لي أراك مع العتاب تطيل","https://www.poetsgate.com/ViewPoem.aspx?id=207802",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[321,"الحمد لله على ما ارى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606413",""]],"verses":[["بَدَّلوا الدورَ فَلَمّا","نَزَلوا القَلبَ أَقاموا",0,"م",3,0],["بُدِّلنَ مِن لُبسِ الشَكيمِ مَقاوِداً","مَربوطَةً وَمِنَ السُروجِ جِلالا",1,"ل",2,0],["بَدَّلوا ديني وَنالوا أُسرَتي","بِالعَظيماتِ وَلَم يَرعَوا أَلى",2,"ا",1,0],["بُدِّلتُ مِنهُ بِقَيدٍ لَستُ أُفلَتُهُ","وَكَيفَ أُفلَتُ قَيداً صاغَهُ اللَهُ",3,"ه",1,0],["بَدَّلَ السَفحَ في اليَلابِنَ مِنها","كُلُّ أَدماءَ مُرشِحٍ وَظَليمِ",4,"م",1,0],["بُدِّلنَ بَعدَ النَفَشِ الوَجيفا","وَبَعدَ طولِ الجِرَّةِ الصَريفا",5,"ف",2,1],["بدَلٌ من الأبدالِ في أوصافِه","يعزَى إلى قطبٍ من الأقطاب",6,"ب",1,0],["بدلت منا الليالي وانتهى","عبث الكأس وإغراء الجنى",7,"ن",2,0],["بدَّلك الدهرُ يا أبا الصقر من","خالِكَ خالاً ومن أبيكَ أبا",8,"ب",2,0],["بُدِّلَ الطرفُ من النوم السهرْ","حين صدّ الظبيُ عَنِّي وهجرْ",9,"ر",1,1],["بدلٌ بالحبيبِ وكْسٌ كما استُب","دلَ بالجنتينِ أثلٌ وخَمط",10,"ط",1,0],["بدلاً من القُربانِ عنك وإن غدا","قربان سوْءٍ ليس بالمرفوع",11,"ع",1,0],["بُدِّلنَ آراماً خوا","ذلَ بعدَ آرامٍ خواذلْ",12,"ل",1,0],["بدِّلتْ تِلكُمُ القصورِ تِلالا","من رمادٍ ومن تُراب رُكامِ",13,"م",1,0],["بَدَّلَتها السُنونُ شَوكاً مِنَ الزَه","رِ وَبِالوَحشِ مِن بَني حَوّاءِ",14,"ا",2,0],["بِدَلوٍ غَيرِ مُكرَبَةٍ أَصابَت","حَماماً في مَساكِنِهِ فَطارا",15,"ر",2,0],["بدلتهم سمومها من بياض","كان يطرى الوجوه لون السواد",16,"د",1,0],["بدّلت جيرانه وبِلْيته","في خطّ كفّ الأمير من ورَقِهْ",17,"ق",2,0],["بَدَلاً شَنيئاً مِن مَحاسِنِ صورَةٍ","وَصَلَ القُلوبَ بِناظِرَيها اللَهُ",18,"ه",1,0],["بَدَّلتَ مِن مِسكِكَ كافورَةً","فَقُلتُ بَل بِالعَنبَرِ الأَشهَبِ",19,"ب",1,0],["بُدِّلتُ مِن مَعشَرِ الأَدْنَين مَعشَرها","لا فَرَّقَ اللَّهُ فيما بَينَنا أَبَدا",20,"د",2,0],["بَدَّلَ الدَهرُ ثَوبَ حُسنِكَ حَتّى","غالَهُ بَعدَ جِدَّةٍ إِخلاقُ",21,"ق",1,0],["بُدِّلتَ بَعدَ تَأَنُّسٍ بِتَوَحُّشِ","وَأَعَرتَ سَمعَكَ مَن يُبَلِّغُ أَو يَشي",22,"ش",2,1],["بَدَّلتَ أَرؤُسَهُم يَومَ الكَريهَةِ مِن","قَنا الظُهورِ قَنا الخَطِّيِّ مُدَّعَما",23,"م",2,0],["بُدِّلنَ طولَ إِذالَةٍ بِصِيانَةٍ","وَكُسورَ خيمٍ مِن كُسورِ حِجالِ",24,"ل",1,0],["بُدِّلَت عَبرَةً مِنَ الإيماضِ","يَومَ شَدّوا الرِحالَ بِالأَغراضِ",25,"ض",1,1],["بُدِّلتَ مِن بَرقِ الثُغورِ وَبَردِها","بَرقاً إِذا ظَعَنَ الأَحِبَّةُ أَومَضا",26,"ض",2,0],["بَدَلاً فَاِستَغنِ عَنّا","بَدَلاً يُغني غِناكا",27,"ك",2,0],["بَدَّلَ الرَبعُ بَعدَ نُعمٍ نَعاماً","وَظِباءً يَخِدنَ كَالأَمهارِ",28,"ر",1,0],["بدَّلَتْهُ همومُهُ","كفناً من وسادِتهْ",29,"ه",1,0],["بُدِّلتُ مِن لَيلِ الشَبابِ بِمَفرِقَي","صُبحَ النُهى أَحبِب بِذاكَ بَديلا",30,"ل",2,0],["بُدِّلَ الإقْدامُ فيه هَلَعاً","فاستوى الأبطالُ والهِيفُ الخُرُد",31,"د",1,0],["بِدَلالٍ وَحَديثٍ","مِثلِ تَنويرِ النَباتِ",32,"ت",1,0],["بَدَّلَتهُ الشَمسُ مِن مَنبَتِهِ","بَرَداً أَبيَضَ مَصقولَ الأُشُر",33,"ر",1,0],["بُدِّلَت مِنهُمُ الدِيارُ نَعاماً","خاضِباتٍ يُزجينَ خَيطَ الرِئالِ",34,"ل",1,0],["بُدِّلتْ تلك العصا جمجمةً","رِيعَ لمّا شرَعتها فاتقاها",35,"ا",3,0],["بُدِّلتُ من عطفٍ لديك ورقةٍ","بحنين مهجورٍ وقسوةِ هاجرِ",36,"ر",1,0],["بدلتني الأقدارُ منها بليلٍ","مدلهم الآفاقِ جهمِ الستورِ",37,"ر",1,0],["بُدّلْتُ مِن بُرْدِ الصِّبا شامِلاً","جَوْناً بلَوْنٍ كبَيَاضِ الأُجَيْل",38,"ل",1,0],["بُدِّلتُ بِالعَيشِ اللَّذيذِ ونِعمَةِ ال","عُمرَينِ هَمّاً شاهِداً ومُغَيَّبَا",39,"ب",2,0],["بِدَلاَلِ غُصْنٍ فِي حُلَى نَوَّارِه","وَجَمَالِ شَمْسٍ فِي غِلاَلَة نُورِ",40,"ر",1,0],["بَدَّلَني بِالسُرورِ هَمّاً","خَطبٌ تَباهى بِهِ الخُطوبُ",41,"ب",1,0],["بَدَّلَتني الأَيّامُ بُؤسي بِنُعمى","يَومَ فارَقتُهُ وَذُلّاً بِعِزِّ",42,"ز",1,0],["بُدلتُ من معشري الأدنين معشرها","لا فرّقَ الله فيما بيننا أبدا",43,"د",2,0],["بُدِّلتِ الوَحشَ بِالأَنيسِ لِما","مَرَّ عَلَيها مِن سالِفِ الأَبَدِ",44,"د",1,0],["بُدِّلتُ فيها جَلالي","بحُلَّةٍ من عِظام",45,"م",1,0],["بدلا من القُب العِتاق ضوامرٌ","رُقشُ المتونِ صريرُهن صهيلُ",46,"ل",1,0],["بدلتم بسيوفها الا عدا سيو","فاً من عصيى مالها اغمادُ",47,"د",1,0],["بُدِّلَتِ الوَحشَة مِن أُنسِها","وَأُلبِسَت بَعدَ الضِياءِ الظَلام",48,"م",1,0],["بُدِّلتُ من عذْبِ الوصالِ بآسِنٍ","كَدرٍ ومن روض الوفا بسِباخ",49,"خ",1,0],["بَدّلوهُ وحرّفوه وزادوا","فيهِ ما شاء من ضلالٍ وشاؤوا",50,"ا",1,0],["بَدَّل الحُزنُ وَجهَها فَهو لَم يَبق","كَما كانَ يَهرق الحُسنَ سحرا",51,"ر",2,0],["بدّلتنا بها الشَّآمَ ليالٍ","حكمت بالبِعاد والتفريق",52,"ق",1,0],["بَدَّلتَها مِن يَومِ شِدَّتِها","بِيَومِ رَخائِها",53,"ا",3,0],["بدّل الدهر قربنا ببعادٍ","مثل أنسٍ قد عاد للإيحاش",54,"ش",1,0],["بدل إِذا طارَت شرارة بأسه","طمست محال الزائغ المتمرد",55,"د",1,0],["بُدِّلت بَعدَ المُعَلّى","في حُبِّهِ بِالمَنيحِ",56,"ح",1,0],["بُدِّلتُ مِن بَعدِ الغُرابِ الحا لِك ال","لَونِ عَلى رَغمِيَ بازاً أَشهَبا",57,"ب",2,0],["بَدَّلتَ أَسمالَهُم وَقَد عَرَوا","فِناءَكَ الرَّحبَ بِأَبرادٍ قُشُب",58,"ب",1,0],["بدّلتها الأيامُ بالسعد بؤساً","وشقاءً وبالهناءة ضرا",59,"ر",2,0],["بدَّلَ من طلولِه","بصرحكِ الممرّد",60,"د",1,0],["بدلت من بعد الغنى حاجة","الى كلاب يلسبون الفرا",61,"ر",2,0],["بُدِّلَ الرُبعُ وُحوشاً","مِن كَبيرٍ وَصَغيرِ",62,"ر",1,0],["بُدِّلَ بَعدَ العَزِّ ذُلّاً فَغَدا","مِن بَعدِ ما كانَ مُهاباً مُحتَقَر",63,"ر",1,0],["بدّل لنفسِكَ روحا","لعلّ أن تستريحا",64,"ح",2,1],["بدلائلٍ ومنَاصِلٍ وشمائل","ورَدتْ بها الآمالُ أعذبَ مَوْرِد",65,"د",1,0],["بدَّلَها من نَشرِه فَسوةً","وصارَ ما في عِرضِهِ فِيها",66,"ه",2,0],["بدلتُ من قلبي سواه فلقد","أقلقني بين ظباءٍ ومَهى",67,"ا",1,0],["بُدّلتُ شيبا قد عَلا لمتي","بعد شَبابٍ حَسنٍ مُعجبِ",68,"ب",1,0],["بدّلَتْ أجسامهم عَنْ","وشيها تُرباً ودودا",69,"د",2,0],["بدَّلت بالوصل هجراً وبما","نَعِمَتْ بؤساً وبالرّيّ غليلا",70,"ل",2,0],["بدَلٌ له من فرط تقوى رَبِّهِ","شُرْبٌ يُجنِّبهُ الورودَ ومأكلُ",71,"ل",1,0],["بَدَّلَ الدَهرُ مِن ضُبَيعَةَ عَكّاً","جِيرَةً وَهوَ يُعقِبُ الأَبدالا",72,"ل",2,1],["بُدَّلْتَهُ بعدَماقد كنتَ مغتبطاً","بالقربِ تصحبُ راحاتٍ وأفراحا",73,"ح",2,0],["بُدِّلتُ بالهجرِ بعدَ الوصلِ فاندفعتْ","عينايَ تهمي على التعويضِ والبَدَلِ",74,"ل",1,0],["بدِّلوا العُسْرَ بيسرٍ أَبيضٍ","فلكم يُنْمى السَّخا والكرَمُ",75,"م",1,0],["بَدِّلِ البُعدَ والجَفاءَ بِقُرْبٍ","وحَنانٍ فالبُعْدُ حَتْفُ الرِّجالِ",76,"ل",1,0],["بدل العيش بعد فقد حسين","بهموم وترحة وهوان",77,"ن",1,0],["بُدِّلتُ مِن جِدَّةِ الشَبيبَةِ وال","أبدالُ ثَوبُ المَشيبِ أَردَؤُها",78,"ه",2,1],["بدّلْ بحزنك غيرَه","فلربّما نَدِم الحزينُ",79,"ن",1,0],["بدّلْ بلادَك إِمّا كنتَ كارهها","داراً بدارٍ وأجراعاً بأجراعِ",80,"ع",1,0],["بَدّلتَ رَأسي أسوداً","لمّا هجرتَ بأبيضا",81,"ض",2,0],["بدليل يستنبطون هداه","وهو وهمٌ إلى الردى مترامي",82,"م",2,0],["بَدَّلَها إِلّا بِاحسانٍ كَما","أَتَمَّ نُعماهُ عَلى مَن أَسلَما",83,"م",2,0],["بَدَلٌ لشَخصِ أبيهِ حَلَّ مَحلَّهُ","فَهُوَ الذي يُنحَى إليهِ ويُقصَدُ",84,"د",1,0],["بُدِلتَ غَيرَ الرِضى وَشَطَّ بِهِم","عَنكَ صُروفُ المَنونِ وَالأَبَدِ",85,"د",1,0],["بُدِّلَت بِالشَعيرِ وَالخَفضِ وَالقَت","تِ وَمَسحِ الغُلامِ تَحتَ الجِلالِ",86,"ل",1,0],["بُدِّلتُ بَعدَ بَني رَبي","عَةَ وَالزَمانُ مُعاقِبُ",87,"ب",1,0],["بدلالها وجمالها فوصالها","أحيت فؤادي أيما إحياء",88,"ا",2,0],["بُدِّلَت مِن هَذِهِ الدُنيا سَماءُ عُلاً","فَاِبشِر أَمُستَبدِلُ الباقي مِنَ الفاني",89,"ن",2,0],["بُدّلتُ مِن قُوتي ضَعفاً ومَسكَنةً","والمرءُ يُخلَقُ طوراً بعدَ أطوار",90,"ر",1,0],["بُدِّلت كافوراً بِمسكٍ أذفرٍ","في لِمَّتي وَحَمامَةٌ بِغُرابِ",91,"ب",1,0],["بدلوا اليوم طريقاً","بطريق يبتلونا",92,"ن",2,0],["بدّلت في ساعة من شأن مملكة","ما لا تبدّله من شأنها الحقب",93,"ب",1,0],["بُدِّلتُ بَعدَ أَبي بِشرٍ وَصُحبَتِهِ","قَوماً عَلَيَّ مَعَ الأَحزابِ أَعوانا",94,"ن",2,0],["بَدَّلَ الإِفصاحَ مِنهُن","نَ بِإِفسادٍ عَجيبِ",95,"ب",1,0],["بدل الحياة الدنيوية بالبقا","واختار مجداً سرمدياًّ دوّما",96,"م",2,0],["بُدِّلْتُ عنهمْ بقُرْبِ مَنْ لا","يأْسو جِراحي ولا يُؤَاسي",97,"س",2,0],["بُدِّلا ما اِستُبدِلَ الدا","ئِرُ فيها وَالمُديرُ",98,"ر",1,0],["بَدليسُ قد جددتِ لي صبوَة","بعد التقى والنسك والسمت",99,"ت",1,1],["بدل من الابدال بل علم من ال","أعلام أَورع أَزهد متعبد",100,"د",1,0],["بدل المخلصون كل نفيس","دون أن يبتغوا على السعى أجرا",101,"ر",2,0],["بدلَ العابثون توراةَ مو