ل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[5508,"جدَّ الصبَّا في أباطيل الهوى لعب","https://www.poetsgate.com/ViewPoem.aspx?id=110820",""],[5573,"ارق لهم ولست لهم براقي","https://www.poetsgate.com/ViewPoem.aspx?id=200225",""],[1547,"قومي يا هذه وتأملي","https://www.poetsgate.com/ViewPoem.aspx?id=17071",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""],[463,"نفَّرها عنْ وردها بحاجرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60081&r=&rc=137",""]],"verses":[["مُؤْيِسٌ مُطْمِعٌ قَريبٌ بَعيدٌ","فَهْوَ أُنْسُ المُقيمِ زادُ الرِّفاقِ",0,"ق",1,0],["مُؤَيَّداً بِقُلُوبٍ مِنْ رَعِيَّتِهِ","تَصْفَى لَهُ الحُبَّ فِي سِرِّ وَإِعْلانِ",1,"ن",1,0],["مؤيد تفصح يوم الوغى","في مدحه ألسن خرسان",2,"ن",1,0],["مؤيّدٌ في مُلا مراتبهِ","يتَّضح الملك في مناقبهِ",3,"ه",1,0],["مؤيدات من الأركان أربعة","يأوي إليهن محروم ومضطعَف",4,"ف",1,0],["مَوئِلَها وَكَهفَها وَرِدَّها","وَاِبنَ الَّذينَ قَوَّموا مَقَدَّها",5,"د",3,0],["مُؤَيَّداً بِكَ في حِلّي وَمُرتَحَلي","وَما هُما غَيرُ إِصباحي وَإِمسائي",6,"ي",1,0],["مؤيَّداً يتحامى الدَّهرُ صولَته","فليس يلقاه إلا وهو هائِبُه",7,"ب",2,0],["مُؤَيَّدُ العَزمِ وَالأَبطالُ في قَلَقٍ","مُؤَمَّلُ الصَفحِ وَالهَيجاءُ في ضَرَمِ",8,"م",1,0],["مُؤيَّدٌ باللَّه ذو عِصْمَةٍ","للدين تأييدٌ به واعتصام",9,"م",1,0],["مُؤيَّدٌ بمضاءِ الرأيِ يَحْمَدُهُ","لا يُحمَدُ السيفُ إلا ماضياً ذكرا",10,"ر",2,0],["موَئِلي يا أَبا عَلِيٍّ","يا رَجائي مِن كُلِّ أَين",11,"ن",1,0],["مؤيد باختيار الله يصحبه","ولن ترى في اختيار الله من خلل",12,"ل",1,0],["مُؤيَّداً باختيارِ اللّهِ يَصْحَبُه","وليسَ فيما أراهُ اللّهُ من خَلَل",13,"ل",1,0],["مُؤيَّدِ العزْمِ في الجُلّى إذا طرَقَتْ","منَدَّدِ السمْع في النّادي إذا نودي",14,"د",2,0],["مُؤَيَّدٍ بِالنَصرِ وَالنَجاحِ","غَذَتهُ أَظآرٌ مِنَ اللِقاحِ",15,"ح",1,0],["مُؤيَّدٌ حَكّمَ في عُداتِه","سيفاً يَسيلُ الموتُ من ظُباتِهِ",16,"ه",1,0],["مؤيد النعت والأفعال ذو شيمٍ","لباسة لبرود الحمد مفتخرة",17,"ر",2,0],["مؤيد الدين الذي صفاته","وذكره المحمود سارت مثلا",18,"ل",2,0],["مَوْئلٌ تَسْبَحُ البحارُ إليه","وإليه انتهتْ عُلومُ اللِّسانِ",19,"ن",1,0],["موينحة عويشقها غديرا","هويجرة موينعة الوصيل",20,"ل",1,0],["مُويجِيدٌ مُعَيدِيمٌ حُوَىٌّ","مُمَيتٌ مِن وَغَيدٍ مِن نُذَيلِ",21,"ل",1,0],["مُوَيصِيفٌ بِكُلِّ وُصَيفٍ سُوءٍ","مُعيرِيفُ السُّؤَيلِ والبُخَيلِ",21,"ل",1,0],["مؤيدةٌ عزائمه","إذا ما اصطكت الركب",22,"ب",1,0],["مُؤَيَّدَ الصُّلبِ رَحبَ الجَوفِ مُطَّرِداً","كالسِّيدِ لا جَنَباً كَزّاً وَلاَ طَنَبَا",23,"ب",2,0],["مؤيّس العقل لو عاشرته نسقا","تسعين عاما لما أحمدت أخلاقه",24,"ق",2,0],["مُؤَيَّدُ العَزمِ مَنصورُ الكَتائِبِ أَم","لاكُ السَماءِ لَهُ في الأَرضِ أَعوانُ",25,"ن",1,0],["مُؤَيَّدَ العَزمِ مِن آلِ المُظَفَّرِ مَح","مودُ الخَلائِقِ تُرعى عِندَهُ الذِمَمُ",26,"م",1,0],["مُؤَيَّدٌ إِذا اِدلَهَم","مَ لَيلُ خَطبٍ وَجَنَح",27,"ح",1,0],["مؤيدا بكتاب اللَه معتصما","بِاللَه منتصرالِلَّه محتسبا",28,"ب",2,0],["مُؤَيَّدٌ لَو رَمَى نَجْماً لأَثْبَتَهُ","وَلَوْ دَعَا أفُقاً لَبَّى وَما احتَبَسا",29,"س",2,0],["مُؤَيّدُ إِبْرَامٍ وَنَقْضٍ مُبَارَكٌ","لَهُ النَّصْرُ خِلْصٌ حَبَّذَا النَّصْرُ مِن خِلْصِ",30,"ص",1,0],["مُؤَيَّدٌ أسْلَمَتْ عِداه","سَهْلاً إلى أيْدِهِ وحَزْنا",31,"ن",2,0],["مُؤَيَّدٌ كُلَّما حَلَّتْ كَتَائِبُه","بِسَاحَةٍ آذَنَ الأعْمَارَ تَرْحالُ",32,"ل",1,0],["مؤَيَّداً بجنودٍ من ملائكهِ","وحفظهُ لك مِمّا تَتَّقي وَزَرُ",33,"ر",1,0],["مؤيد راسخ في العلم متبع","أثر الرسول بإخلاص وإحسان",34,"ن",1,0],["مؤيد بجنود اللَه من ملك","ومؤمن وبنصر اللَه والظفر",35,"ر",1,0],["موئِلُ المذنبين في موقف الهو","ل إذا ما تأذّنوا بالعذاب",36,"ب",1,0],["مُؤيِّدُ دينِ اللهِ ما زال بالنهي","إذا أبدتِ الأيّامُ عن حادثٍ إدّ",37,"د",1,0],["مؤيّدُ دينٍ ينتضِي الدّهرَ دونَه","له سَيفُ عَزْمٍ لم تَخُنْهُ المَضارب",38,"ب",1,0],["مُؤَيِّدُ الدَولَة وَاِبنُ ركنِها","وَاِبنُ أَخي مُعِزِّها أَخو العَضُد",39,"د",1,0],["مؤيد الرأي إلا أنّ همته","أمضى من البيض والخطية الذبل",40,"ل",1,0],["مؤيسةِ المرامِ في باطنِها","مُطمِعةٍ في نفسها بالظاهرِ",41,"ر",1,0],["مؤيد الدين بَذَّالُ النَّوالِ اذا","ما أمسك الغيث واغبْرَ المخاصيب",42,"ب",1,0],["مؤيد خفاق اللواء على العدى","مؤثل عادي المعالي قديمها",43,"م",3,0],["مؤيّدُ ملّةِ الإسلامِ هادٍ","إذا ضلّ الهُداةُ ولا مَنارا",44,"ر",2,0],["مؤيد سمر القنا بنانه","مظفر بيض الظبى أظفاره",45,"ر",2,0],["مؤيد العزم يوم الحرب مدرع","بهيبة الفاخرين العز والشمم",46,"م",1,0],["مُؤيَّدٌ بيمينِ اللهِ مُعتَضِدٌ","تَرعاهُ عينٌ تَولَتْ حِفظَ ذي النُونِ",47,"ن",1,0],["مُؤَيَّدٌ بيَمينِ اللهِ مُقتدِرٌ","لهُ مَلائِكةُ الرَّحمنِ أعوانُ",48,"ن",1,0],["مُؤَيَّدٌ بِيَمينِ اللهِ مُقتدرٌ","يَرعَى العِبادَ بعينٍ نَومُها السَّهَرُ",49,"ر",1,0],["مُؤَيَّدَ سَنَةِ العَدلِ الَّتي شَرَفَت","وَرافِعَ رايَةِ الإِرشادِ في البِشرِ",50,"ر",1,0],["مَوئلُ السائلينَ فالأبغضُ الأب","غضُ أمسى له الأودَّ الأوَدّا",51,"د",2,0],["مؤيدة الإمداد في طبع وضعها","وكثرة مثلي في توسع وسعها",52,"ه",2,0],["مؤيداً بِجُنود كَالأسود لَها","مَع سائر الخَلق أَشواق إِلى نَظره",53,"ر",2,0],["مؤيّد لو به البرّ استمدّ على","البحر المحيط اغارته مغايره",54,"ر",2,0],["مؤيد الحَقِّ نَبي الملحمة","مُحَمَّد ماحي ظَلام المظلمة",55,"ه",1,0],["مؤَيَّداً مِنه مَنصوراً لَهُ وَبِهِ","وَدُمتَ للَّه لِلأعداء مُنتَقما",56,"م",2,0],["مُؤيِّد السُّنّةِ الغَرَّاءِ لا بَرِحَتْ","بِمِثلِهِ غُرَّةٌ مِن أَجمَلِ الغُرَرِ",57,"ر",1,0],["مؤيداً منه في تاييده أبداً","مساعداً منه في إدراك أوطار",58,"ر",1,0],["مُؤيِّد الدين مَن ناجَتْهُ هِمَّتُهُ","كانت إلى مُبْتغاه أَقْصَدَ الطُّرُق",59,"ق",1,0],["مؤيد العزم لو أبدى عصاهُ على","هام الخِضّمّ بإذن الله لانفلقا",60,"ق",2,0],["مُؤيداً بالنصرِ","وذل حال من كفر",61,"ر",1,0],["مؤيد المجد تنميه غطارفه","صِيدٌ يمانون قاداتُ الورى نُجُبا",62,"ب",2,0],["مؤيد بالهدى من ربه وبه","لشرعة الملة الغراء تأييد",63,"د",1,0],["مؤيد الإسلام يا منعما","سمت معالي مجده والرتب",64,"ب",1,0],["موئلي من هو معنى","ى بمدحي ذو اهتمامِ",65,"م",1,0],["مؤيد الإسلام يا من غدا","كالدهر نفاعا وضرارا",66,"ر",2,0],["مُؤَيَّدُ الرَّأْيِ والرَّاياتِ عادَتُهُ","تَقَنُّصُ النَّصْرِ بَيْنَ الرّيْثِ والعَجَلِ",67,"ل",1,0],["مُؤَيَّدُ الْعَزْمِ مِنْ أَهْلِ الْحُرُوبِ دَنَا","وَعَنْ رُبُوعِ بَنِي الرَّاحَاتِ قَدْ شَحَطَا",68,"ط",2,0],["مؤيَّداً بجنودٍ من مهابته","قد انتضى معه آراءه زبرا",69,"ر",2,0],["مويد العزم لا يشكو إلى أحد","صرف الزمان إذا حلت به المحن",70,"ن",1,0],["مؤيدين بسادات خضرامة","كل مزايا أبيهم جمعت فيه",71,"ي",2,0],["مُؤَيَّداً بِكِتَابِ اللهِ مُعتَصِما","ياللهُ تَطلُبُ ما تَبغِى مشنَ أوطَارِ",72,"ر",1,0],["مُؤَيَّدُ العَزمِ مَيمونٌ نَقيبَتُهُ","مُسَدَّدُ الرَأي في بَدءٍ وَتَعقيبِ",73,"ب",1,0],["موئل مطرود وظلّ لاجئ","وأمن مزؤود وكفّ آمل",74,"ل",1,0],["موئل المعتفين في السّنة الشهباء غي","ث الراجي غياث الطريد",75,"د",1,0],["مؤيّدنا فيه على كلِّ حالة","إله السما وهو النَّصير المؤيد",76,"د",1,0],["موئل الإحسان والفضل الحسين","فضله قد شاع ملء الخافقين",77,"ن",1,0],["مؤيد الشرعة الغراء حاكمها","وحارس الملة البيضاء ناصرها",78,"ر",3,0],["مؤيد بالهدى والحق ملتمس","رضا البرية لاسترضاء باريها",79,"ي",3,0],["مؤيدِ الخُلقِ إذا هَمَّ عَزَم","يُمكِّنُ السيف إذا الرمحُ انفصم",80,"م",1,0],["مؤيد جاءت الدنيا إلى يده","عفواً ولبته من قرب أمانيه",81,"ي",2,0],["مُؤَيِّدِ الدينِ والأصحابُ حائِرَةٌ","والعُربُ نافِرةٌ من زاغ أو كَفَرَا",82,"ر",2,0],["مؤيد ظاهر الدين القَويم وَلَم","يَزل لحزب رسول اللَه مُنتَصِرا",83,"ر",2,0],["مؤيد العزم منصور اللواء إذا","رام العدو فان الله ناصره",84,"ر",2,0],["مؤيّداً يغدو بروح القدس","يُصبِحُ في تأييده ويُمسي",85,"ي",1,0],["مُؤَيَداً وَلاها","بباسِ ليثٍ أروع",86,"ع",1,0],["مؤيدين بروح القدس كالئة","شخصيكما عين مبدي الحق باريها",87,"ي",3,0],["مُؤَيَّدُ الرَّأيِ مَنْ يُنافِسُهُ","تَحْتَ حَضِيضِ الْخُمولِ قَد دَفَنَهْ",88,"ن",2,0],["مُؤَيَّدُ الرَّاياتِ وَالرَّأْي فِي","حالَةِ تَدْميرِ وَتَدْبيرِ",89,"ر",1,0],["مُؤَيَّدٌ تُنْصَرُ أَعْلامُهُ","بِجَيْشِ أَقْدارٍ وَجَيْشِ اقْتِدارْ",90,"ر",1,0],["مؤيد العزّ يستسقى الرشاد به","أنواء عز بلطف اللَه منهمر",91,"ر",1,0],["مؤيداً لك فوق المشتري طنب","مؤسساً لك في العيوق بنيان",92,"ن",1,0],["مؤيد تهتك الأستار فكرته","حتى يحيط بكنه الكل بالفكر",93,"ر",1,0],["مؤيد أُمورَه بعزمةٍ","من السمواتِ العُلى تأييدها",94,"د",3,0],["مؤيدة أقواله بفعاله","قؤل بما قال الكرام فعول",95,"ل",1,0],["مؤيد لخم هل تؤمل رجعة","فكم أمل أضحى الى النجم سلما",96,"م",2,0],["مؤيد الوصل ما أروم ولا","أعد شيئاً نعيمه الأبدي",97,"د",2,0],["مؤيد العزم والرحمن ناصره","مسدد الراي والمقدور مجهول",98,"ل",1,0],["مؤيد العزم ماضي الراي متخذ","من خشية الله جيشا سابغ العدد",99,"د",1,0],["موئل المأثرات خدن معالٍ","لم نجد في العلى لها أخدانا",100,"ن",2,0],["موئل المعتفين يوم النوال","معقل الخائفين يوم النزال",101,"ل",1,0],["مؤيدٌ بشعاع الله معتصمٌ","بسبلهِ وضياءُ الحق يرشدهُ",102,"د",2,0],["مؤيّدٌ لِبِنا المروِيِّ ناشرُه","مباركُ الوجه في يُمنٍ وإيمان",103,"ن",1,0],["مؤيدُ ملَّة ِ الإسلامِ هادٍ","إِذَا ضَلَّ الهُدَاة ُ وَلامنَازا",104,"ز",2,0],["مؤيدٌ ظاهرٌ برٌّ بزمرتهِ","شَريفُ سرٍّ كريمٌ عمّ كلّ ظمِ",105,"م",1,0],["مؤيّد الرأي والرايات قد ألفت","ذوائب القوم من راياتها العذبُ",106,"ب",1,0],["مؤيدة صوارمهم بجند","تطير بهاالرؤس عن الاضاحي",107,"ح",2,0],["موىي قد يمَّمتُ جودك ظامئاً","وشربتَ من دهري نقيع الحنظلِ",108,"ل",1,0],["مؤيد بالوحي معصوم به","بنوره يهدي الذي لم يعصم",109,"م",1,0],["موئلٌ للناس نجلي معجزاتٌ","تغسل الأرواح من كل كدرْ",110,"ر",1,0],["مؤيسة ِ الغرامِ في باطنها","مطعمة ٍ في نفسها بالظَّاهرِ",111,"ر",1,0]]}