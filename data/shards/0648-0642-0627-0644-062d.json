{"poems":[[65,"ركبت طرفي فأذرى دمعه أسفا","https://www.aldiwan.net/poem45822.html","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38483","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77535","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77669","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77645","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77497","الرجز"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73498","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121182","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116518","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100173","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136630",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58168","الطويل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141100","المنسرح"],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[6229,"حواء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65186&r=&rc=12",""]],"verses":[["وَقالَ حَتّامَ تؤذيني فإِن سَنَحَتْ","جَوانِحٌ لَكَ فاركَبني إِلى النَّاسِ",0,"س",1,0],["وقال حَوْضُهُمْ والسَّيْلُ يَغْمُرُهُ","قَطْنِيْ فقد هَدَمَ الأَرْجاءَ مُمْتَلأُ",1,"ا",1,0],["وَقالَ حَلَقت عِذاري لأنّي","عَلى خَدّهِ قَد خَلعت العِذار",2,"ر",1,0],["وَقالَ حلماً أَيُّها السُلطان","السَبع قَطُّ ما لَهُ أَمان",3,"ن",1,0],["وَقالَ حِلماً أَيُّها السُلطانُ","الدَهرُ قَطُّ ما لَهُ أَمانُ",4,"ن",1,0],["وَقالَ حزبٌ لا وَإِنَّما هِيَ","شَيء إِذا نَظَرت فيهِ واهي",5,"ي",1,0],["وقالَ حَقّ ما رَآه الراعي","فَرضٌ عَلَينا السَعيُ بِالإِجماع",6,"ع",1,0],["وَقالَ حاشا أَن أَكون كاذِبا","كُنت أَتيتُ وَحَملتُ أَرنَبا",7,"ب",2,0],["وَقالَ حَسودي أَينَ إِرثُكَ مِنهُم","فَقُلت لَهُم مالُ الأَكارِمِ نافِدُ",8,"د",1,0],["وَقالَ حلوا قَيده وَالغلا","وَأنكر الفعل بِهِ فحلا",9,"ل",2,0],["وقال حتى متى تلهو وتلعب قم","واقرأ وكن خير من يملى ومن كتبا",10,"ب",2,0],["وقال حلا عندي وعندك قوله","انا قثم جامع الفضل والخير",11,"ر",1,0],["وقال حاكيته نظماً فقلت له","أجل حكيت ولكن فاتك الشنب",12,"ب",1,0],["وقال حياك قصدت أجرى","وجئت لا واش معى بل وحدى",13,"د",2,0],["وقال حراماً أرى قُربه","فقلت وقربكَ عند حَرام",14,"م",1,0],["وقال حكيمٌ فاستَمِعْ لمقالَةٍ","ونفسَك فَرِّجْ من همومٍ ومِن ضَغَنْ",15,"ن",1,0],["وقال حالي يصون خالي","يدني فويحي بالحال والخال",16,"ل",1,0],["وقال حين أبو الدردا أتاه بما","لديه بالحق لا مينا وتشويها",17,"ي",3,0],["وقال حين رآه في تَململهِ","يُقلّب الطرفَ بين الزهرِ والماء",18,"ا",2,0]]}