{"poems":[[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[95,"فوجئت فيك بأنكر الأنباء","https://www.aldiwan.net/poem9849.html","الكامل"],[74,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[63,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[124,"يا شاعر النفس كم أبكاك مصرعها","https://www.aldiwan.net/poem49358.html","البسيط"],[133,"يا صاحبي لقد غفا","https://www.aldiwan.net/poem67428.html","مجزوء الكامل"],[186,"تنبهوا واستفيقوا أيها العرب","https://www.aldiwan.net/poem67087.html","البسيط"],[214,"لله صرة كاعب أبدت لنا","https://www.aldiwan.net/poem13426.html","الكامل"],[237,"ما للدموع تسيل سيل الوادي","https://www.aldiwan.net/poem14701.html","الكامل"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[435,"لله صب غدا بالرسم منشغفا","https://www.aldiwan.net/poem41056.html","البسيط"],[435,"سرى النسيم بعرف من ربي الطلل","https://www.aldiwan.net/poem41399.html","البسيط"],[435,"من الأحبة أم من طيب ربعهم","https://www.aldiwan.net/poem41426.html","البسيط"],[469,"لله صيداء من بلاد","https://www.aldiwan.net/poem3509.html","عموديه"],[505,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[569,"عما تكن الحشى تنبيك أدمعه","https://www.aldiwan.net/poem903.html",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122373","البسيط"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138819",""],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75744","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105421","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95385","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67216","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67200","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58303","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115814","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112662","الرجز"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145543","البسيط"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145134","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138567",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138657",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108364",""],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125779","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91457","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92358","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123539","السريع"],[3838,"","https://poetry.dctabudhabi.ae/diwan/poem/105690","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103025","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136473",""],[4679,"لله صوتٌ دعا في جلقٍ سحراً","https://www.poetsgate.com/ViewPoem.aspx?id=142879",""],[4767,"قلب العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=146549",""],[4767,"أفظع الأنباء","https://www.poetsgate.com/ViewPoem.aspx?id=179272",""],[4767,"نور الكون","https://www.poetsgate.com/ViewPoem.aspx?id=179802",""],[4767,"جرح لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=215436",""],[4935,"فارقت من أهوى بغير إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=129356",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""]],"verses":[["لِلَّهِ صَبرُكَ حَيثُ تَفتَرِقُ الظُبى","بَينَ الهَوادي وَالقَنا مُتَشاجِرُ",0,"ر",1,0],["للَه صبحك ما أشد ظلامه","والضوء فيه باهر اللألاء",1,"ا",2,0],["لله صبحٌ تجلى للشريعة عن","ذاك الجلال لقد جلَّت مآثره",2,"ر",2,0],["للهِ صادرةُ الَّليالي إنها","صدرَتْ بطيبِ العَيْشِ أسرعَ مَصدَرِ",3,"ر",1,0],["للهِ صُبْحٌ رَأَيْتُهَا ابْتَرَدَتْ","بِمِثْلِ مَاءِ اللُّجَيْنِ مُنْهَمِرِ",4,"ر",1,0],["لِلَّهِ صَبْرِي وَهْوَ لِلُّ","غَةِ الَّتِي انْتُهِكَتْ غَضُوبُ",5,"ب",1,0],["للّهِ صَوْتكَ في الأَثِيرِ فَإِنّه","أَخَذَ الهُدَى والْحُسْنَ عَنْ دَاوُدِ",6,"د",1,0],["للَه صرخة وجدٍ أنت مرسلها","ضاعت عليك بواد غير ممراع",7,"ع",1,0],["لِلّه صَرحٌ شامخٌ","قد صارَ قاعاً صَفصَفا",8,"ف",2,0],["لِلّهِ صَبركُمُ لَو أَن صَبرَكُمُ","في مُلتَقى الخَيلِ حينَ الخَيلُ تَضطَرِبُ",9,"ب",1,0],["لله صرة كاعب أبدت لنا","خالا به شمس المشارق أشرقت",10,"ت",1,1],["لِلَهِ صَبٌّ بِالعِراقِ مُتَيَّمٌ","ظامٍ إِلى ماءِ المُحَصَّبِ صادي",11,"د",2,0],["للَّهِ صيدٌ زنَاتِيُّونَ تَحْسَبُهُم","أُسْداً إِذا افْتَرَسُوا الأَقْرَان سِيدَانا",12,"ن",2,0],["للَه صبّ غدا بالرسم منشغفا","ولم ير الجسم ذا من أعجب العجب",13,"ب",1,1],["للَه صبّ غدا بالوجد منفردا","مؤرق الطرف بياتا على العلل",14,"ل",1,0],["للَه صبّ غريب نازحٌ قلقٌ","مقرّح الجفن يجري الدمع كالعنم",15,"م",1,0],["لله صيداءُ من بلاد","لم تبقِ عندي هماً دفيناً",16,"ن",2,1],["للهِ صاحِبُها ولابِسُ بُرْدَها","وادي الهُدى حَسَنٌ أَبو البَرَكَاتِ",17,"ت",1,0],["لله صب شجي بات مكتئباً","آنا له لم يزل في الوصل تطمعه",18,"ع",2,0],["للّه صب له قلب بهم ابدا","متيم لا يزال الدهر ولهانا",19,"ن",2,0],["لله صب بات ساهر","والدمع من عينيه هامر",20,"ر",1,1],["لِلّه صب ما له من حيلة","إِلّا المنى وَمَدامِع تتدفق",21,"ق",1,0],["للَه صحبك إذ وقوك بأنفس","بذلوا لنصرك في الوغى مهجاتها",22,"ت",3,0],["للَه صدر بغاجة حيا على","وقت به لذت لنا الحلواء",23,"ا",2,0],["لله صبٌ في هواه كأنّه","قلمٌ غرار المشرفي براه",24,"ا",2,0],["لله صَحبٌ أحرزت قصبَ العُلى","بمفاخرٍ جلّت فلن تَتَحددا",25,"د",2,0],["لله صَبٌّ لا يُضيعُ","عهدَهُ وَمَوْثقَة",26,"ق",2,0],["للّه صبح قضى من بعد بينكم","مع الرقاد وليل بت أحييه",27,"ي",2,0],["للَه صبرك من حليم","لا توازي الهضب حلمه",28,"م",2,0],["للَهِ صَبرُ زَينبَ العقيلَه","كم صابَرَت مصائِباً مهولَه",29,"ه",1,1],["لله صنع تلقاها السرور به","من قبل أن تتلقى البرد والكتب",30,"ب",1,0],["لله صبرك في الكفاح فإنه","أمضى السلاح لقطع كل وريد",31,"د",1,0],["لله صبر والارزاء صارت مثلاً","من مثلها ابتلى وصبراً أحرزا",32,"ز",2,0],["لله صبرك كيف رحت مكابداً","غصصاً يحير ذا الحجى المامها",33,"م",3,0],["لله صحة رأيه ولئن سرى","نفس به مثل النسيم سقيم",34,"م",1,0],["لله صان دماءَ أُمتنا","في جاَّفٍ يوم فيضها غدرا",35,"ر",2,0],["لِلّه صَبٌّ دائمُ الحَسراتِ","متواصلُ الزفراتِ وَالعبراتِ",36,"ت",1,1],["لِلّه صَبٌّ قد تَذلل في الهَوى","لما تعزّز عَنهُ آرامُ اللَوى",37,"ل",3,1],["للهِ صَبٌّ مدْحُ مَعْشوقِهِ","دَِيْدنُه مُتَّبِعٌ نَهْجَهْ",38,"ه",1,1],["لله صبر المرتضى مما رأى","فقد النبي وفرحة الحساد",39,"د",1,0],["للَه صخرة وادي الطفّ ما صدعت","إلا جواهر كانت حلية الزمن",40,"ن",1,0],["للَه صبرك كم تطيق تحملاً","وعداك منك يمنظر وبمسمع",41,"ع",1,0],["لله صارمُكَ الذي لولاه قد","ظفرت عُتاة الشرك بالاسلام",42,"م",1,0],["لله صوتٌ دعا في جلقٍ سحراً","فرنَّ منه هتافُ البشر في حلبِ",43,"ب",1,1],["لله صبر الليث من غنمٍ","بين الخلائق لم تزل رمَما",44,"م",2,0],["لله صبر الثاكلاتِ لكم ومَن","أُلبِسْنَ فيها ضافيَ اللأواء",45,"ا",2,0],["لله صبرُكَ كم حُمِّلْتَ مِن ألَمٍ","ما زال في الصدرِ مثل السهمِ قد نَشِبَا",46,"ب",2,0],["لله صبركِ أيها الغيداءُ","شُنَّت عليكِ معاركٌ شعواءُ",47,"ا",2,1],["لله صبح جبين يوم شمته","يجلي بحسن تحت ظرة ليلة",48,"ه",1,0],["لله صدرك ما انحنى لرصاصة","من حاقد أو ملحد متحلل",49,"ل",1,0],["لله صوني بنيك إنهم عشقوا","فيك الشجاعة لا خوف ولا حذرُ",50,"ر",1,0]]}