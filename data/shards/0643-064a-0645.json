َية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4767,"تقريع","https://www.poetsgate.com/ViewPoem.aspx?id=178421",""],[4789,"نعم الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=215708",""],[4858,"أيّامٌ وأيّامٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34855",""],[4858,"ماذا بركبك يا أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=137598",""],[4955,"ليس البطولة بافتعال شجار","https://www.poetsgate.com/ViewPoem.aspx?id=198612",""],[4984,"إِنِّي هُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=206075",""],[5046,"من عاند الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=198513",""],[5102,"عيد الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=18921",""],[5121,"غَرِّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=183758",""],[5160,"يحيى عياش","https://www.poetsgate.com/ViewPoem.aspx?id=175161",""],[5183,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=186425",""],[5183,"أَلْفَرَاهيدِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=186453",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5353,"المغزل","https://www.poetsgate.com/ViewPoem.aspx?id=212464",""],[5376,"ما زال قلبي من الهجران يلتاعُ","https://www.poetsgate.com/ViewPoem.aspx?id=188291",""],[5376,"كيما تشاءُ عشِ الأهواءَ في رَغَدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193188",""],[5425,"الرِهانْ","https://www.poetsgate.com/ViewPoem.aspx?id=207506",""],[5691,"يا قدْسُ...!","https://www.poetsgate.com/ViewPoem.aspx?id=206847",""],[5791,"بنيّة الخبز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208643",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6070,"قُمْ وافتَحْ الصََندوقَ والأبوابا","https://www.poetsgate.com/ViewPoem.aspx?id=193902",""],[313,"إلى شباب بلادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66490&r=&rc=15",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["كَيما أَنالَ بِقَرضٍ","ما لَم أَنَل بِشَفاعَه",0,"ه",1,0],["كَيما نَقولُ إِذا بَلَّغتَ حاجَتَنا","أَنتَ الأَمينُ إِذا مُستَأمَنٌ خانا",1,"ن",2,0],["كَيْما تَراني في الذي","أبصرتُ فيكَ من القضاءِ",2,"ا",2,0],["كيما يقولوا حين تُرضيهمُ","يا حبذا المُنهزمُ التائبُ",3,"ب",1,0],["كيما يكونُ له بابان تدخلُهُ","عُجرُ الفِياشِ من البابين والحوبُ",4,"ب",1,0],["كيما يكونَ لأقوام به أدبٌ","وفي النَّكال عن الزلات مزدجَر",5,"ر",1,0],["كَيما تُقَبِّلُ ثَغرَهُ","وَيُقَبِّلُ المَعشوقُ فاها",6,"ا",3,0],["كَيما تَجُرَّ بِنا ذَيلاً فَتَطرَحنا","عَلى الَّتي دونَها مُغبَرَّةٌ سوحُ",7,"ح",1,0],["كَيما يَقولَ مُحَدَّثٌ لِجَليسِهِ","كَذَبوا عَلَيها وَالَّذي سَمَكَ العُلى",8,"ا",1,0],["كَيمينِ اِبنِ خالِدٍ حينَ تُدعى","راحَةً وَهيَ ديمَةٌ مِدرارُ",9,"ر",1,0],["كَيْمَا تَفُوزَ بِوَصْلٍ أَيِّ مُسْتَتِرٍ","عَنِ العُيُونِ وَسِرٍّ أَيِّ مُكْتَتِمِ",10,"م",1,0],["كَيما أَفوزَ بِقُربٍ مِنهُ يَنفَعُني","وَيَنجِلي سَقَمي وَالبَثُّ وَالكَرَبُ",11,"ب",1,0],["كَيما أَكونَ لَهُ عَبداً يُقارِضُني","وَصلاً بِوَصلٍ وَهُجراناً بِهُجرانِ",12,"ن",1,0],["كَيما أَقولُ فِراقٌ لا لِقاءَ لَهُ","وَتُضمِرُ النَفسُ يَأساً ثُمَّ تَسلاها",13,"ا",3,0],["كيما تتُم لك الصنعيةُ عنده","حَياً ومَيْتاً لابساً أكفانَهُ",14,"ن",2,0],["كِيمِياءُ العُقُولِ أنتِ تصوغِينَ","نضاراً من النُحاسِ المُذَابِ",15,"ب",1,0],["كيما تصانَ مصالحٌ لك عنده","\" صوني لابناء العراق مصالحا \"",16,"ح",2,0],["كيما تتُم لك الصنيعة ُ عنده","حَيا ومَيْتاً لابساً أكفانه",17,"ن",2,0],["كيما يقاس علهيا ما يشابهُها","من الأصول التي في الشرعِ تمتثِلُ",18,"ل",1,0],["كَيمَا أرى النفس لُقياهُ آمنة","شَرَّاً ولاقِيةً خَيراً وعافِيةً",19,"ه",1,0],["كَيُمناهُ الَّتي تَهمي نَوالاً","يَعُمُّ الخَلقَ طُرّاً وَهيَ حافِل",20,"ل",1,0],["كَيما تُرى عَضُدِيَّةً تُركِيَّةً","قَد طالَما اِستَولَت عَلَيها الدَيلَمُ",21,"م",1,0],["كَيما تَعُودَ إِلى الأَوطانِ آيِبَةً","قَومٌ رَأَوا قَبلُ فيها خَيبَةَ الأَمَلِ",22,"ل",1,0],["كَيما أُلاقِي مَلِكاً عِندَهُ","لِلماجِدِ الأَحسابِ مِثلي مُقام",23,"م",1,0],["كيما تجُرّ ذُيولاً منكِ جرَّرها","من قَبلِنا التُركُ في أَوطانِهم تيها",24,"ي",3,0],["كيما أراك على الوفاءِ وأجْتَني","مَعْسولَ وَصْلِك وهو غير مَشُوب",25,"ب",1,0],["كيما أقول مؤيدا لك دافعا","عنك الملامة اذ عناك زميل",26,"ل",1,0],["كيما يَروا وَيَسمَعوا","لربربٍ ما تصنَعُ",27,"ع",1,0],["كَيما يقالُ له اِطّلاعٌ واسعٌ","وَذكاءُ فكر مشرق متشعشعُ",28,"ع",1,0],["كَيما أرى سَمعي يَلَذُّ بمَنطِقي","وتَميلَ من طيبِ الشَذا أَعضائي",29,"ي",1,0],["كيما أُباشِرَها بِرو","حِيَ انَّ بَرحَ الشَوقِ زائِد",30,"د",1,0],["كَيَمين عَبّاسٍ أَبي الحسن الَّذي","بَهَرَ الأَنامَ سَناؤُهُ وَسِناهُ",31,"ا",2,0],["كيما أمثل في المقام مقبّلاً","ذيلاً يجرُّ عل المجرّة ذيله",32,"ه",1,0],["كيما يتمّ جمالُها بِلباسِه","فيُضيءُ منها كلُّ ليلٍ مظلِم",33,"م",1,0],["كيما يجدد نورا تلو ليته","يضيفه ابدا للنير الابدي",34,"د",2,0],["كيما أُميتَ مطامعي بتجاربي","وأكفَّ أخباراً كبُرْنَ بمخبري",35,"ر",2,0],["كيم خيَّب الدُجنُ من يرجو القطار به","ولم يخْب مِن ندى كفَّيكَ راجيكا",36,"ك",2,0],["كَيما أَبيعَ جيداً","مِنهُ بِرِفدٍ جَديدِ",37,"د",1,0],["كَيمَا تَرى مادام إيضَاعٌ لهَا","لا تَشتَكِي من وضعِ خُفِّ دامِ",38,"م",1,0],["كيما يروا أن السماع مقصر","من فضله عما ترى العينان",39,"ن",1,0],["كيمياء الهدى أحاديث علمي","فاتركوها تشيع بين الممالك",40,"ك",1,0],["كيما تصيب نجحا ولم تلم","وَالمَرءُ مَرهونٌ فَمَن لا يُختَرَم",41,"م",1,0],["كَيما يقال فلان حازَ جائِزة","في عُمره أَذهبت ما كانَ مِن وَصب",42,"ب",1,0],["كَيما بِها تَلقى أَمامك سحنة","بِالمَسخ قَد كسيت وَبِالأقذاء",43,"ا",2,0],["كيما أراك وتلك أعظم نعمة","وملكت يداك بها منيع قيادي",44,"د",2,0],["كيما أغير ما بها من حاجة","وتود أني لا أؤوب فجار",45,"ر",1,0],["كَيْما يَجُودُ بِغَلَّةٍ","نَظَراً يُكَشِّفُ ما أعَلا",46,"ل",2,0],["كيْمَا يَلوذُ الخلقُ طُرًّا بِهِمُ","خُصَّوا بهذا النورِ من رِّبهمُ",47,"م",1,0],["كيما عتيق الريش منه يبتدلْ","في غيره ريشاً جديداً مكتملْ",48,"ل",1,0],["كيما يرى نارك من يمرّ","إن جلبت ضيفاً فأنت حرّ",49,"ر",1,0],["كيما تجد يداً بذلك عنده","غراء يشكرها ليالي عمره",50,"ر",2,0],["كيما تقر بذاك عينا","أَدنى التَواصل بالسلام",51,"م",1,0],["كَيْمَا يَرَاهَا بَائسٌ مُرْمِلٌ","أوْ فَرْدُ قَوْمِ لَيْسَ بِالآهِلِ",52,"ل",1,0],["كيما نكون الموالى عند خائفة","عما تروم به الإسلام والدينا",53,"ن",2,0],["كَيما أَعَدَّهُم لِأَبعَدَ مِنهُم","وَلَقَد يُجاءُ إِلى ذَوي الأَحقادِ",54,"د",1,0],["كَيْمَا نَرَى زَائِرَ المُخْتَارِ سَيِّدنا","نَجْلِ ابنِ عَبدِ العزِيزِ الخازِنِ الدَّارِ",55,"ر",1,0],["كيما يعدى القول عن لغوه","في المصطفى الخاتم خير الورى",56,"ر",2,0],["كيمامة مهجورة","لا تتركيني",57,"ي",1,0],["كيما أقضي وطري","منك بيومي أو غدي",58,"د",2,0],["كَيما تَلَذّ بِتكرارِ الكَلامِ مَعي","أُذني وَتلفِظ مِنهُ الدُرَّ في الكَلِمِ",59,"م",1,0],["كيمياء السر تبدو للذي","هو بالتدبير فيها يعتني",60,"ن",2,0],["كَي ما تَفوز بوصل أَي مُستَتِر","من صاحب العرش رب الناس وَالنعم",61,"م",1,0],["كي منهما يجيء خيرُ بكرِ","وبعد أن أجرى له إملاكا",62,"ك",2,0],["كيما تشيرَ بانَّ فيهِ تحتها","شبهاً لها باللطف والميلانِ",63,"ن",1,0],["كيْما تتمَّ لكَ النَّعْماءُ كاملةً","ويأمن النّاسُ من فَقْرٍ ومن هَبَلِ",64,"ل",1,0],["كيما يُراميه بمرقومةٍ","مثل شريج النبلِ والضالَهْ",65,"ل",2,0],["كيْما تنالَ من الدّنيا نهايتَها","إمّا حِماماً وإمّا حُسْنَ مُنقَلَبِ",66,"ب",1,0],["كيما يراه الله في المعاد من","دما أخيه جسمه مخضبا",67,"ب",2,0],["كيما اميلَ بها فما","تخطو ويُشغِفني الغَرام",68,"م",1,0],["كيما يُصَمخِنَ الذي ما مَسَّهُ","موتٌ وهل باللَهِ موتٌ يُلمِمُ",69,"م",1,0],["كيما يبارك للأمير رقية","عرشا سواد العين من أستاره",70,"ر",2,0],["كيما يَنالُ مِنَ الخُطوبِ فَوائِداً","وَيردُّ كَيدَ زَمانِهِ وَيَذودُ",71,"د",1,0],["كيما نرى الدنيا وما شأنها","سربالها المبتذل المخلق",72,"ق",1,0],["كيما تخلد ذكرة","تتلى بأفواه العصور",73,"ر",1,0],["كَيَمٍّ عَلَيهِ النَّسِيمُ انتَشَر","فَأُرجِفَ وَاربَدَّ يُوهِي النَّظَر",74,"ر",1,0],["كيما تهد من العليا دعامتها","فجرعته الردى في جرعة اللبن",75,"ن",1,0],["كيما أروى ثراها","بعارض رقراق",76,"ق",1,0],["كيما يجاور حيدراً في قبره","ويفوز في جناتها تخليدا",77,"د",2,0],["كيما اشاهد نور وجهك ظاهراً","ولكي يظللني خباك الأنور",78,"ر",1,0],["كيمياء ابن جابر أظهرت أشياء","كانت عن العيون خفيَّة",79,"ي",2,0],["كيما يرى للأمر من فرجة","يفرجها المعبود رب السماء",80,"ا",2,0],["كيما يعود الطفل سالف عهده","ريان ينعشه الربيع كأنه",81,"ن",2,0],["كيما تعود إلى روضي بلابلُهُ","فنسمع الشّدوَ ،في شُكْرٍ لباريها",82,"ي",3,0],["كيما يعود لنا عزٌّ ومرتبةٌ","بين الورى وننير الأرض بالفِكَر",83,"ر",1,0],["كيما نسودَ كما تسوَّدَ قبلنَا","صحبُ النبيِّ بمنهجِ المختارِ",84,"ر",1,0],["كيما يرى خلفَهُ حَلاًّ لِمعْضِلَةٍ","فَأَبْعَدُ القَصْدِ قد يُدْنِيهِ أقربُهُ",85,"ب",2,0],["كيما أُعاودَ فيك الفَقْدَ ثانيةً","أرنُو لطيفك في الآفاقِ حيثُ رَمَى",86,"م",2,0],["كيْما أُقَََضِّي في اخضرارِ المُنتدى","ما بين ماجد والممجّد فالمجيدْ",87,"د",1,0],["كَيْمَا يُنَادِمنِي عَلَى كَأْسِ الرِّوَى","مَنْ جَاءَ يَرْوِي بِالْخُمُورِ هَيَالِيَا",88,"ل",3,0],["كيما تغرّد عَازفاً ألحانَكمْ","لا بدَّ يحيى أنْ تظلَّ مُغرِّدَا",89,"د",2,0],["كيما أسود به الطاقات محتكما","في طوقها املأ الأقوال أفعالا",90,"ل",2,0],["كيما ترى المختار في محرابه","يَدعو الورى للواحد الغفار",91,"ر",1,0],["كَيْمَا تَقِرَّ العَينُ بَعْدَ سُهَادِها","هَلَّا أَفَقْتِ.. أَمَا انْتَهَى الإِغْفاءُ ؟",92,"ا",2,0],["كيما يطيرُ إلى شواطئ أمنِهِ","وتظلُّ أنت تدورُ تختصرُ الفلَكْ",93,"ك",1,0],["كيما تميل بنا في اليم أشرعةٌ","فالقلب للريح والأهواء ينصاعُ",94,"ع",1,0],["كيما تشاءُ عشِ الأهواءَ في رَغَدٍ","دُنياك لهوٌ وفيها العمرُ محدودُ",95,"د",1,1],["كَيْمَا أَرَى فِيْهِ التَوَرُّدَ قَد سَرَى","إِنِّي احتَمَلْتُكِ رَاضِيَاً ، كَيْمَا أَرَى",96,"ر",2,0],["كَيْما يُدنِّسَ أرْضاً","قدْ طُهِّرَتْ للسُّجودِ",97,"د",1,0],["كيما يغادرَنا . لونين وامتزجا","فكانَ أنْ دوّنا معنيهما .. جمرا",98,"ر",2,0],["كيما نظل كنبتٍ ماله ثمرٌ","يعيش في الظل مفتوناً بما شاؤوا",99,"ا",1,0],["كي ما تشارك في الكلام فنهتدي","بالفحص في الموضوع للارشاد",100,"د",1,0],["كيما أُسَطّرَ في مديحِ محمدٍ","حرفاً سليماً طيباً مُنسابا",101,"ب",2,0],["كيما نرى فوق السها","كيما نمجد في المآب",102,"ب",1,0],["كيما أصوغ الهوى سفراً أرتله","استمطر المدح موصولا به اللهف",103,"ف",1,0],["كيما تنال من القصيد قليله","ظناً بأن الشعر فيه بقاء",104,"ا",2,0],["كيما نبادلك الجميل بمثله","يا طالما رد الجميل وفاء",104,"ا",2,0],["كَيْمَا يَرَوا غَرْسَهُمْ، أَحْفَادَ ما سَغِبُوا،","ماتُوا انْتِظَارًا عسى أنْ يُوْرِقَ الشَّجَرُ",105,"ر",1,0],["كيما تنال رضا اليهودِ وَ مَالَهُمْ","ويُقالُ:هذا الغِرُّ فارسُ عصرِهِ",106,"ر",2,0]]}