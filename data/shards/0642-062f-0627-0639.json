.aspx?id=34307",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[2220,"ما رحَّلوا يومَ بانوا البزَّلَ العيسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19261&r=&rc=803",""]],"verses":[["قد أعرجوا الروح خلداً عند بارئها","وفي الثرى خلفوا الأجساد ترتكم",0,"م",1,0],["قَدِ اِعتَنَقوا الأَجداثَ لا مِن صَبابَةٍ","وَيا رُبَّ زُهدٍ في الضَجيعِ المُعانِقِ",1,"ق",1,0],["قد أعجزتني عن تالتخصيص كثرتكم","فمن أقول له شكراً ومن ومن",2,"ن",1,0],["قَد أَعسِفُ النازِحَ المَجهولَ مَعسِفَهُ","في ظِلِّ أَغضَفَ يَدعو هامَهُ البومُ",3,"م",1,0],["قَد أَعانَتني الحَمِيَّةُ لَمّا","لَم أَجِد مِن عَشيرَتي أَعوانا",4,"ن",2,1],["قد أعجبت فيها الشهور وأعشبت","للقاصدين فكلّهنّ ربيع",5,"ع",1,0],["قد اعتضدتَ بأشدِّ الأعضادْ","بالله مولاك لقتل الأضدادْ",6,"د",1,0],["قد اعتَضَدَتْ بالله والحقِّ نفسُه","فأصبح مَعضوداً وما زال يُعْضَدُ",7,"د",1,0],["قد أعدَّتْهُمُ الملوكُ وكانوا","للمرامينَ نِعمَ حشْو الوفاض",8,"ض",1,0],["قد أعظمتْ جُرماً فعاقِبها به","واجعل لها غير الأيورِ سياطا",9,"ط",2,0],["قَدِ اِعتَصَبَت بِفُصوصِ العَقيقِ","مُفَصَّلَةً بِشُذورِ الذَهَب",10,"ب",1,0],["قَدِ اِعتَنَقا تَحتَ الدُخانِ كَما اِلتَقى","كَمِيّانِ في داجٍ مِن النَقعِ مُنجالِ",11,"ل",1,0],["قَدِ اِعتَلَلتَ أَوانَ اِعتَلَّ مِن شَفَقٍ","عَلَيهِ فَاِصلُح لَنا بُرءاً كَما صَلَحا",12,"ح",2,0],["قَد أُعطِيَت بَغدادُ مِنكَ نِهايَةَ ال","حَظِّ المُقَدَّمِ وَالنَصيبِ الأَوفَرِ",13,"ر",1,0],["قَد أَعَلَّ الفُؤادَ تَوريدُ خَدَّي","هِ وَتَفتيرُ لَحظِهِ وَاِعتِلالُه",14,"ل",2,0],["قَدِ اِعتَرَفَت نَفسٌ عُلَيَّةَ داؤُها","بِطولِ ضَنىً مِنها إِذا لَم تُساعِفِ",15,"ف",1,0],["قَدِ اِعتَدَلَت فَالنِصفُ مِن غُصنِ بانَةٍ","وَنِصفٌ كَثيبٌ لَبَّدَتهُ سَجومُ",16,"م",1,0],["قَد أَعزَبَ العالَمُ أَحلامَهُم","يا عازِبَ الحِلمِ عَنِ الناسِ ثُب",17,"ب",1,1],["قَد أَعرَسَت عِرسُ الأَميرِ بِتابِعٍ","ضَرَعٍ فَأَينَ حَليلُها المِغيارُ",18,"ر",1,0],["قَد أَعبَلَت شَجَراتٌ غَيرَ عاذِبَةٍ","وَسَوفَ يُبكِرُ جانٍ يَطلُبُ العَبَلا",19,"ل",2,0],["قد أُعلنت للورى حرية فمضى","زمان سخرة ذي أمر وقرباج",20,"ج",1,0],["قَد أَعَدّوا لِحادِثاتِ اللَيالي","عُدَّةً لا يَحوزُها التَقديرُ",21,"ر",1,0],["قد أعدّتْه رَحْمةُ اللّهِ لِلْحُكْمِ","كَرِيماً مُبَارَكاً فاسْتَعَدّا",22,"د",2,0],["قَدْ أَعَدْنَا عهْد العُرُوبَةِ فِي مِصْرَ","وذِكْرَى فِرْدَوْسِهَا المفْقُودِ",23,"د",1,0],["قد أَعادتْ عَهْدَ الأعارِيبِ في مِصْرَ","إلى ناعمٍ من العَيْشِ هاني",24,"ن",2,0],["قد أعجزَت قرَّاءَهُ","عن أن يسيروا في ركابه",25,"ب",2,0],["قد اعيا القلب وفطره","زور المفتون اخى الحسد",26,"د",1,0],["قد أعطي الناس ما شاءوا وما رغبوا","أما الرزايا فقد كانت عطايانا",27,"ن",2,0],["قد أُعفىَ المارنُ من خَشاشهِ","ورُوّحَ الغاربُ من أقتابهِ",28,"ب",2,0],["قَد أَعوَزَ الماءُ الطَهورُ وَما بَقي","غَيرُ التَيَمُّمِ لَو يَطيبُ صَعيدُ",29,"د",1,0],["قَد أُعجِمَت طاءُ طُعّانِ العِدى فَتُرى","لِخَوفِها قَبلَ وَشكِ الرَوعِ ظُعّانا",30,"ن",2,0],["قَدِ اعتَدتَ هِجرَاني فَلَو قالَ قائِلٌ","أمامَك وَصلٌ قلتُ لَستُ أصَدِّقُ",31,"ق",1,0],["قد اعتمدتْ عليك لكلِّ أمرٍ","كما اعتمدتْ على الكفِّ البَنان",32,"ن",1,0],["قَدِ اِعتَقدوا كلَّ المَساوي محاسناً","لهُ وَرأوا تلكَ الشرورَ به خيرا",33,"ر",2,0],["قد أُعطِيا من فنون الشكل ما اشتهيا","وحُكِّما في صروف الدهر فاحتكما",34,"م",2,0],["قَد أَعَدّوا لَهُ جُيوباً مِنَ الرَع","دَةِ مُلساً تَزِلُّ عَنها النِصالُ",35,"ل",1,0],["قد اعتورتهم للنسور مخالب","وقد ساورتهم للقساور أنيب",36,"ب",1,0],["قد اعتصمت بالصبر نفسي وفوضت","إلى الله ما يُعطى الزمانُ ويمنَعُ",37,"ع",1,0],["قد اعتصمت بمصرٍ واؤتمنت بها","فكل من في رشيد منك مهدي",38,"ي",1,0],["قد أعطي السهم للرامي فلا سبع","يعدو لا ثعلب يا راحة الغنم",39,"م",1,0],["قد أَعجز البلغاءَ مُعجزُ أَحمَدٍ","فأقرَّ كلُّهمُ بعجزِ مُقصِّرِ",40,"ر",1,0],["قد أَعجزَت بِبَديع مِدحَتِها","أَهلَ البَديع وَصاغَةَ الشِعرِ",41,"ر",1,0],["قَد أعظمَ اللّه في التوارةِ نعتهمُ","حتّى تمنّى الكليمُ نيل نعتهمُ",42,"م",1,0],["قَدْ أَعَارَتْ ضِياءَها أَلَقَ الشَّم","سِ فَمَاذا يُجْدِي ضِياءُ السِّراجِ",43,"ج",1,0],["قَد أَعرب اللحنَ صَوت العَندليب بِها","فَوصفه لِبيان الفرق تَأكيدُ",44,"د",1,0],["قد أعادُوا ما كانَ مُنتقَصَ الخَل","قِ من المَكرُماتِ خَلقاً سَويَّا",45,"ي",2,0],["قد اعتَرفَت عَيناكَ بالقَتل عِندهم","وما قَتلُ مِثلي يا مقاتِلُ يُنكَرُ",46,"ر",1,0],["قد أعلمنا أن المعالي عطايا","ما بهذا مخالف أو مماري",47,"ر",2,0],["قد أعرض الناس عن علم الحديث وقد","أضحت أئمته في باطن الحفر",48,"ر",1,0],["قد أعادَ الأسى نهاريَ لَيْلاً","مُذْ أعادَ المَشِيبُ لَيلي نَهارا",49,"ر",2,0],["قد أعْلَنْتَ بالتهاني فهيَ معلنة","كما نؤمّلُ فيها أيَّ إعلان",50,"ن",1,0],["قد أَعدُّوا لكلِّ أمر عظيم","واستعدُّوا للنقض والإِبرام",51,"م",1,0],["قد اعتادت رماحهم انتصاراً","وقد ألفت عداتهم انخذالا",52,"ل",2,0],["قد أعادت شيب الزمان عطايا","ه شبابا فراح وهو غلام",53,"م",1,0],["قد أعطيت رتبة الإمارة من","أخلاقك العُزّ فوق ما تسع",54,"ع",1,0],["قد أعرب الدمع عن وجدي وكتماني","وأعجم القلب في صبري وسلواني",55,"ن",2,1],["قد أعدمتني صروف الدهر عن عرضٍ","يا مالك الرف فامشس لي بإتجاد",56,"د",1,0],["قد أعجزت بفنون من فصاحتها","لولا التأخر كانت حجة العرب",57,"ب",1,0],["قد أعلنت بالثناء تنشره","وابتهلت بالدُّعاءِ تُخلِصُه",58,"ص",2,0],["قد اعتنقنا الهدى لكن تصوفنا","بزّ التصوف في آيات ذكرا",59,"ر",2,0],["قد أعجف الضَّرعُ وقد","أصفرَ بعدَك الإنا",60,"ن",2,0],["قد أعقم الرأيُ فاستدرك بقيَّتَها","منكَ برأيٍ وَلودِ البطن مِذكارِ",61,"ر",1,0],["قد أعتذر الزمانُ بودّ خِلٍّ","محا ما كان أسلفَ من ذُنوبِ",62,"ب",1,0],["قد أعْتبَ الدهرُ الخؤونُ لعاتبٍ","أوسعتَه صدراً ولم يكُ يُعْتِبُ",63,"ب",1,0],["قد اعتدلت فيه الحقائق فهي في","خطوط استواء في نعوت العبوديه",64,"ي",2,0],["قد أعْجَزَ اللاَّحِقَ شَوْطُ هِمَّتي","وصِرْتُ في أهلِ الغَرامِ مَثَلا",65,"ل",2,0],["قدْ أُعرِقَتْ بفُنونِ الذَّوقِ طِينَتُنا","من عالَمِ الخلْقِ والتَّكْوينِ إعْراقَا",66,"ق",2,0],["قد أعظَموا من أعظَمَتْهُ بغيبِها","أَسرارُهُ فهمُ بها عُلَماءُ",67,"ا",2,0],["قَدْ أَعَدَّ النُّقُوضَ مِنْ كُلِّ وَجْهٍ","وأَبانَ العِراضَ في كُلّ بابِ",68,"ب",1,0],["قد أعجزَت صِفاتُه الحُسنَى جَمي","عَ قالَةِ الشِّعرِ الكثيرِ الرَّونَقِ",69,"ق",1,0],["قد أعارَ السَّمعَ مني","بعد لِينِ القولِ صَرما",70,"م",2,0],["قد أعقَبَهُ مني السُّرورُ وفرحةٌ","وشارَكني كلُّ الأخِلاَّءِ في امري",71,"ر",2,0],["قَد أَعظَموكَ