{"poems":[[55,"أعقل قلوصك بالإجراع من إضم","https://www.aldiwan.net/poem29782.html","البسيط"],[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[88,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[75,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[53,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[87,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[47,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[46,"أعقبك الله صحة البدن","https://www.aldiwan.net/poem30336.html","المنسرح"],[33,"حن قلبي من بعد ما قد أنابا","https://www.aldiwan.net/poem42655.html","الخفيف"],[107,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[54,"يا طالبا مستعجلا رزقه","https://www.aldiwan.net/poem26708.html","السريع"],[77,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[92,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[47,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""],[164,"هكذا فليكن قرار العيون","https://www.aldiwan.net/poem58946.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[310,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[369,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[443,"أيها الصاحب المعظم إني","https://www.aldiwan.net/poem2605.html","الخفيف"],[458,"من دمعة الشعب ومن كده","https://www.aldiwan.net/poem61803.html","السريع"],[463,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[469,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[487,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[558,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[563,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[563,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122788","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122757","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39071","الكامل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67014","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62667","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202115","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64774","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79953","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78016","الكامل"],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117135","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114791","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113715","الطويل"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18696","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33857","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77395","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28614","المتقارب"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121229","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60913","الخفيف"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137349",""],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109822","الخفيف"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96129","الرجز"],[3377,"","https://poetry.dctabudhabi.ae/diwan/poem/205993",""],[3444,"","https://poetry.dctabudhabi.ae/diwan/poem/130736","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62890","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126930","الخفيف"],[3724,"","https://poetry.dctabudhabi.ae/diwan/poem/145223","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103062","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102958","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35527","السريع"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107517","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101390","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101388","الوافر"],[4043,"","https://poetry.dctabudhabi.ae/diwan/poem/205126","المنسرح"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136395",""],[5147,"يا ربع زحلة أين عنا","https://www.poetsgate.com/ViewPoem.aspx?id=166758",""],[5200,"أعقب أعزّك ربّ العباد","https://www.poetsgate.com/ViewPoem.aspx?id=200809",""],[5213,"يا خليلي ان عزمتم رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170524",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5431,"امرأة ترغب بالانفصال...","https://www.poetsgate.com/ViewPoem.aspx?id=202032",""],[5431,"بلقيس...","https://www.poetsgate.com/ViewPoem.aspx?id=204633",""],[5526,"أوفى شخص","https://www.poetsgate.com/ViewPoem.aspx?id=196448",""],[5594,"أعقبت من فعلى النّدامه","https://www.poetsgate.com/ViewPoem.aspx?id=201058",""],[5605,"البحر والموج","https://www.poetsgate.com/ViewPoem.aspx?id=160692",""],[5674,"روائع ساحره","https://www.poetsgate.com/ViewPoem.aspx?id=197551",""],[5956,"قدَرٌ عليك بأن تُخان دواما","https://www.poetsgate.com/ViewPoem.aspx?id=193214",""],[5997,"عرفتك","https://www.poetsgate.com/ViewPoem.aspx?id=214243",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[463,"تعالينَ نعالجْ نف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60213&r=&rc=269",""]],"verses":[["أُعقُل قَلوصَكَ بِالإِجراعِ مِن إِضَمِ","حَيثُ اِستُسيغَ النَدى وَاِستُلفِظَ اللُومُ",0,"م",1,1],["أَعَقيلَةَ الحَيّينِ دونَكِ فَاِرفَعي","ما شِئتِ مِن عَذَبِ القِناعِ المُسبَلِ",1,"ل",1,0],["أَعقَبَتهُ الخَلاصَ مِن بَعدِ ضيقٍ","وَحَبَتهُ السُعودَ مِن بَعدِ نَحسِ",2,"س",1,0],["أَعَقيلَةَ السَربِ المُباحَ لِوِردِها","صَفوُ الهَوى إِذ حُلِّىءَ الوُرّادُ",3,"د",1,0],["اِعقِلي إِن كُنتُ لَمّا تَعقِلي","وَلَقَد أَفلَحَ مَن كانَ عَقَل",4,"ل",1,0],["أعقب القربَ من حبيبك شحطُ","ولأيدي الخطوب قبضٌ وبسطُ",5,"ط",1,1],["أعقب المجدبين من أهل خصب","قد رعوا روضك المريع ائتنافا",6,"ف",2,0],["أعقِبهمُ لا تقم بمخترق ال","ذم فتُلفى بأيِّ مخترق",7,"ق",1,0],["أَعُقابٌ في عَنانِ الجَوِّ لاح","أَم سَحابٌ فَرَّ مِن هَوجِ الرِياح",8,"ح",1,1],["أَعقابُ أَملاكٍ لَهُم عاداتُها","مِن كُلِّ نَيلٍ مِشلَ مَدِّ النيلِ",9,"ل",1,0],["أَعقَبَكَ اللَهُ صِحَّةَ البَدَنِ","ما هَتَفَ الهاتِفاتُ في الغُصُنِ",10,"ن",1,1],["أَعقَبَتهُ ريحُ الدَبورِ فَما تَن","فَكُّ مِنهُ أُخرى تَسوقُ سَحابا",11,"ب",2,0],["أعقبَ البشرَ عُبوسٌ وبدا","من رسولِ اللهِ ما لا ترتضِينْ",12,"ن",1,0],["أَعقِلُ في قَولي وَلَكِنَّني","مِن بَعدِهِ أَجهَلُ في فِعلي",13,"ي",1,0],["أعَقيلةَ الملِكِ المُشَيِّعِها","هذا الثَّناءُ وهِذه الزُّمَرُ",14,"ر",1,0],["أَعقَبَتهُ القَبولُ رَوقاً مِنَ الأَر","نَبِ حَتّى حَبا حُبُوَّ الأَميرِ",15,"ر",1,0],["أعُقماً وأُمَّاتُ البلادِ ولودةٌ","وإنَّكِ يا أُمَّ الفراتينِ أنجب",16,"ب",1,0],["أعْقَابُ أمْلاكٍ، لَهُمْ عَاداتُهَا","منْ كُلّ نَيْلٍ مثلِ مَدّ النِّيلِ",17,"ل",1,0],["أَعقل العاقلين من لا يلاقيك","بسيف في يوم حربٍ زبون",18,"ن",1,0],["أَعقَلُ العاقِلينَ في كُلِّ عَصرٍ","عُقِلَت عَن لحاقِهِ العُقَلاءُ",19,"ا",2,0],["أعقبتها بصرخة ردّد الأفق","وقد خيّم السكون صداها",20,"ا",3,0],["أَعقلُ الناسِ من يكون خليّ ال","قلبِ عن فرحةٍ وعن أحزانِ",21,"ن",1,0],["أعقيلةَ الحيِّ المُطنَّب بيتُها","حيث القَنا من دُونها تَتكَسَّر",22,"ر",1,0],["أعقبتني الصهباء أمسِ خمارا","راح في القلب مثل وخزِ الحرابِ",23,"ب",1,0],["أعقلكم دون دفينِ الثرى","لو يعقل الميت في لحدهِ",24,"د",2,0],["أعِقبانٌ بهم طرن","أم العِيسُ تباكيْنا",25,"ن",2,0],["أعقيلة الحي المقيمِ بعالجٍ","فأقمتِ بين مواقدٍ ومناهل",26,"ل",1,0],["أعقود نحر أم ثياب مطارق","أصبوح شرب ما له غايات",27,"ت",1,0],["أعقب الدهر بؤسه بنعيم","رب حزن في الطي منه سرور",28,"ر",1,0],["أَعقَبَهُ اللَهُ سُروراً بِهِ","وَقَرَّتِ العَينانِ وَالنَفسُ",29,"س",1,0],["أعقل الشيء منكرا فهما","حاش لله أن أكون أنا",30,"ن",2,0],["اعقل الأمر تارك الشرع أعمى","عن طريق الهدى وتحصيل سول",31,"ل",1,0],["أعَقيقٌ أُذيبَ في القَدَحِ الدّا","ئِرِ للشّارِبينَ أَمن نيرانُ",32,"ن",1,0],["أعقَبَ الإنكار مَعرِفَةً","ومَحا الإيحاشَ إيناسُ",33,"س",1,0],["أعِقدُهُ مِن ثَناياهُ وَخَمرَتُهُ","مِن خَدِّهِ عُصفِرت أم فوهُ خاتَمُهُ",34,"م",2,0],["أعقابَ شَعْبانٍ عَجِبْتُ لَها","بِيْضاً نَصَلْنَ أواخِرَ الشَّهْرِ",35,"ر",1,0],["اعقلْ قلوصاً جانبا لا ترعَها","واقرنْ وظيفَ ذراعِها بالآخرِ",36,"ر",1,0],["أَعَقِيْلَةَ الأَمْلاَكِ والمَلْكِ الذي","لَبِسَ السَّناءُ به جَلابِيْبَ السَّنَا",37,"ن",2,0],["أعقود تبرٍ أم دُرَر","ونجوم فجر أم غُرَر",38,"ر",1,1],["أعقدة حَلَّها الباري بقدرته","من حيث لم تحتسب قد جئت تعقدها",39,"د",3,0],["أَعَقُّ أَصحابَي مَنْ لامَني","لأَنَّهُ أَغْرَى وَما غَيَّرا",40,"ر",2,0],["أعقيلةَ الحيَّين شقتُ فنوِّلي","كبداً هوتك فكابدتْ أوصابها",41,"ب",3,0],["أعقل أفق أنفق أنب لا تكتسب","إلا المحاسن يجزك الوهاب",42,"ب",1,0],["أعْقِبِي آل هاشِمٍ يا أُميَّا","جعلَ اللَّهُ بيْتَ مالِكِ فَيَّا",43,"ي",2,1],["أعقل العاقلين شمسٌ جحاه","عقلت عن وصولها العقلاء",44,"ا",2,0],["أعُقُّ بها أوصالهُ لو فعلتهُ","وأرهقُهُ في غيرِ محمَدةٍ عُسرا",45,"ر",2,0],["أعُقبَةُ جُبنا أجبُلاً وعقاباً","أضَلّت مواميها قطاً وعُقاباً",46,"ب",2,1],["أعُقبَةُ سل مولاكَ جلّ جلالُهُ","يُؤَمِّنُنا كي لا نخافَ عِقاباً",46,"ب",2,0],["أَعقَبتُهُ بَدَلاً مِنهُ وَفارَقَني","لِلَّهِ دَرُّ مَشيبِ الرَأسِ مِن بَدَلِ",47,"ل",1,0],["أَعقَبَت مِنكَ اللَيالي","حُلوَ عَيشٍ بِمرارَه",48,"ر",2,0],["أَعَقيقٌ سالَ تَح","تَ الجِذعِ أَم كَأسُ مُدام",49,"م",1,0],["أعقُّ خَليلَيَّ فيهِ القَديمُ","وَأَغدرُ إِخوانِيَ المُؤتَمَن",50,"ن",1,0],["اعقل قلوصك وارع الروض واتكل","هذا المراد فلا عذر لمرتحل",51,"ل",1,1],["أعقيق الحمى عقيق الحمى والعَ","لَمُ الفرْدُ والخيامُ الخيامُ",52,"م",1,0],["أعقيق دمع الأعين القرحاء","ابدا يسيل لفرقة البطحاء",53,"ا",2,1],["أعقِب له مستعجِلا للماء","مضمضةً في آخر الغذاء",54,"ا",2,0],["أَعقَبَهُم مِن خَلفِهِم بِالخيل","نُسوقهم تَجري بِهِم كَالسَيلِ",55,"ل",1,0],["اعقبتني صبراً به بعض اما","ل وان الامال تعقب صبرا",56,"ر",2,0],["أعقر بوال يغذي في الشجر","كالحية النضناض في أصل الحجر",57,"ر",1,0],["اعقد لقاسم بيعة","واقدح له في الملك زندا",58,"د",2,0],["أعقلتَهُم من عبادِ الذُلِّ معتقلاً","ارغمتَ منهم أُنُوفاً بعدَ إسهادِ",59,"د",1,0],["أَعقكما أَو فاكما وكلاكما","به غَدرةٌ من شَابِكِ العِرقِ أَعرَقُ",60,"ق",1,0],["أعقبوا بعدما مضوا خير شهم","ماله في بني العلا من ضريب",61,"ب",1,0],["أعققته فتركت رجع جوابه؟","ما اعتاد منك أذى العقوق الوالد",62,"د",1,0],["أعقمت أصلابهم غزواً فلم يلدوا","سوى المخاوف والوهم الدغاميّ",63,"ي",1,0],["أعقيلة الحي الطويل رماحه","من كل يعبوب طويل نجاد",64,"د",1,0],["أَعَقدها أُلفَ مِن ثَغرِها","أَم ثَغرُها أُلف من عَقدِها",65,"د",3,0],["أَعقيلةُ الجنرالَ تسعى مثلما","تسعى النساءُ العاملاتُ وتعرِقُ",66,"ق",1,0],["اعقيق ماشقه الحسن ام فم","شق قلب البروق حين تبسم",67,"م",1,1],["اعق المجد وهو ابي اذا لم","اسل دمعي عقيقا بالعقيق",68,"ق",1,0],["أعقبك الله من فظاعته","أسوغ صنع في مثله صنعه",69,"ع",2,0],["أَعقيلةَ الحيِّ اللَّقاحِ ودُونَها","بيضٌ وسُمْرٌ من ظُبىً وذوابلِ",70,"ل",1,0],["أعقائلقد عزّت على