{"poems":[[53,"أعقل قلوصك بالإجراع من إضم","https://www.aldiwan.net/poem29782.html","البسيط"],[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[44,"أعقبك الله صحة البدن","https://www.aldiwan.net/poem30336.html","المنسرح"],[31,"حن قلبي من بعد ما قد أنابا","https://www.aldiwan.net/poem42655.html","الخفيف"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[52,"يا طالبا مستعجلا رزقه","https://www.aldiwan.net/poem26708.html","السريع"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[45,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""],[161,"هكذا فليكن قرار العيون","https://www.aldiwan.net/poem58946.html","الخفيف"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[198,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[306,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[365,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[438,"أيها الصاحب المعظم إني","https://www.aldiwan.net/poem2605.html","الخفيف"],[454,"من دمعة الشعب ومن كده","https://www.aldiwan.net/poem61803.html","السريع"],[459,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[465,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[483,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[554,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[559,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[559,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"]],"verses":[["أُعقُل قَلوصَكَ بِالإِجراعِ مِن إِضَمِ","حَيثُ اِستُسيغَ النَدى وَاِستُلفِظَ اللُومُ",0,"م",1,1],["أَعَقيلَةَ الحَيّينِ دونَكِ فَاِرفَعي","ما شِئتِ مِن عَذَبِ القِناعِ المُسبَلِ",1,"ل",1,0],["أَعقَبَتهُ الخَلاصَ مِن بَعدِ ضيقٍ","وَحَبَتهُ السُعودَ مِن بَعدِ نَحسِ",2,"س",1,0],["أَعَقيلَةَ السَربِ المُباحَ لِوِردِها","صَفوُ الهَوى إِذ حُلِّىءَ الوُرّادُ",3,"د",1,0],["اِعقِلي إِن كُنتُ لَمّا تَعقِلي","وَلَقَد أَفلَحَ مَن كانَ عَقَل",4,"ل",1,0],["أعقب القربَ من حبيبك شحطُ","ولأيدي الخطوب قبضٌ وبسطُ",5,"ط",1,1],["أعقب المجدبين من أهل خصب","قد رعوا روضك المريع ائتنافا",6,"ف",2,0],["أعقِبهمُ لا تقم بمخترق ال","ذم فتُلفى بأيِّ مخترق",7,"ق",1,0],["أَعُقابٌ في عَنانِ الجَوِّ لاح","أَم سَحابٌ فَرَّ مِن هَوجِ الرِياح",8,"ح",1,1],["أَعقابُ أَملاكٍ لَهُم عاداتُها","مِن كُلِّ نَيلٍ مِشلَ مَدِّ النيلِ",9,"ل",1,0],["أَعقَبَكَ اللَهُ صِحَّةَ البَدَنِ","ما هَتَفَ الهاتِفاتُ في الغُصُنِ",10,"ن",1,1],["أَعقَبَتهُ ريحُ الدَبورِ فَما تَن","فَكُّ مِنهُ أُخرى تَسوقُ سَحابا",11,"ب",2,0],["أعقبَ البشرَ عُبوسٌ وبدا","من رسولِ اللهِ ما لا ترتضِينْ",12,"ن",1,0],["أَعقِلُ في قَولي وَلَكِنَّني","مِن بَعدِهِ أَجهَلُ في فِعلي",13,"ي",1,0],["أعَقيلةَ الملِكِ المُشَيِّعِها","هذا الثَّناءُ وهِذه الزُّمَرُ",14,"ر",1,0],["أَعقَبَتهُ القَبولُ رَوقاً مِنَ الأَر","نَبِ حَتّى حَبا حُبُوَّ الأَميرِ",15,"ر",1,0],["أعُقماً وأُمَّاتُ البلادِ ولودةٌ","وإنَّكِ يا أُمَّ الفراتينِ أنجب",16,"ب",1,0],["أعْقَابُ أمْلاكٍ، لَهُمْ عَاداتُهَا","منْ كُلّ نَيْلٍ مثلِ مَدّ النِّيلِ",17,"ل",1,0],["أَعقل العاقلين من لا يلاقيك","بسيف في يوم حربٍ زبون",18,"ن",1,0],["أَعقَلُ العاقِلينَ في كُلِّ عَصرٍ","عُقِلَت عَن لحاقِهِ العُقَلاءُ",19,"ا",2,0],["أعقبتها بصرخة ردّد الأفق","وقد خيّم السكون صداها",20,"ا",3,0],["أَعقلُ الناسِ من يكون خليّ ال","قلبِ عن فرحةٍ وعن أحزانِ",21,"ن",1,0],["أعقيلةَ الحيِّ المُطنَّب بيتُها","حيث القَنا من دُونها تَتكَسَّر",22,"ر",1,0],["أعقبتني الصهباء أمسِ خمارا","راح في القلب مثل وخزِ الحرابِ",23,"ب",1,0],["أعقلكم دون دفينِ الثرى","لو يعقل الميت في لحدهِ",24,"د",2,0],["أعِقبانٌ بهم طرن","أم العِيسُ تباكيْنا",25,"ن",2,0],["أعقيلة الحي المقيمِ بعالجٍ","فأقمتِ بين مواقدٍ ومناهل",26,"ل",1,0],["أعقود نحر أم ثياب مطارق","أصبوح شرب ما له غايات",27,"ت",1,0],["أعقب الدهر بؤسه بنعيم","رب حزن في الطي منه سرور",28,"ر",1,0],["أَعقَبَهُ اللَهُ سُروراً بِهِ","وَقَرَّتِ العَينانِ وَالنَفسُ",29,"س",1,0],["أعقل الشيء منكرا فهما","حاش لله أن أكون أنا",30,"ن",2,0],["اعقل الأمر تارك الشرع أعمى","عن طريق الهدى وتحصيل سول",31,"ل",1,0]]}