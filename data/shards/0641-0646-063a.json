{"poems":[[90,"مضى عبد وهاب الهبات لربه","https://www.aldiwan.net/poem45046.html","الطويل"],[87,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[47,"تخطى الليالي معشرا لا تعلهم","https://www.aldiwan.net/poem10898.html","الطويل"],[102,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[112,"غني بربي","https://www.poetsgate.com/ViewPoem.aspx?id=8379",""],[325,"الدهر لا تصفو له صافية","https://www.aldiwan.net/poem61760.html","السريع"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[518,"كفى حزنا ألا أعاين بقعة","https://www.aldiwan.net/poem67705.html","الطويل"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31487","الوافر"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82206","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109825","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202511","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67971","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77692","الطويل"],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5285,"هَنا","https://www.poetsgate.com/ViewPoem.aspx?id=203529",""],[5410,"معاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=138984",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5704,"جفاءٌ .. فصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=191336",""],[6052,"الشذا","https://www.poetsgate.com/ViewPoem.aspx?id=52572",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""]],"verses":[["فنغضب أحياناً ونطرب تارة","وأنت على الحالين مبتسم الثغر",0,"ر",1,0],["فنغم الهدير","فهذر العصفور",1,"ر",1,0],["فَنَغدو نُقاسي عِلَّتَينِ وَيَغتَدي","صَحيحاً كَنَصلِ السَيفِ صَحَّت مَضارِبُه",2,"ب",2,0],["فنغّمت ضحكة كسلى ، طفولتها","جذلى ، على الرقة المغتاج تنقصف",3,"ف",1,0],["فن غبت. يانفر العقل وأشتياقه","مانيب راغب بعد خوّتك خوّه",4,"و",2,0],["فَنَغَصَّةُ العَيشِ لَنا قِسمَةً","وَسَكرَةً المَوتُ لَنا كافِيَةِ",5,"ي",2,0],["فنغدو بوصل واتصال ولا ندع","أطاييب فيض إلا دان وأدناني",6,"ن",2,0],["فنغص تذكاري لها طيب عيشتي","فقلت سيفني ذا فيأسي عليكم",7,"م",1,0],["فَنُغرى الثائِرينَ بِهِم وَقُلنا","شِفاءُ النَفسِ أَن بَعَثوا الحُروبا",8,"ب",2,0],["فنغفرها كأن لم يفعلوها","وطول العفو أدرب للظلوم",9,"م",1,0],["فن غدا يلقي عليك رجاءه","ويروم من علياك رفع مكانه",10,"ن",2,0],["فنغدو معاً عبدين أُشرى وتُشترى","وان عشتُ حراً عشت يا ورقي حرا",11,"ر",2,0],["فَنَغدو ونُمسي والليالي تسوقنا","إِلَى مَنْهلٍ كأسُ المنايا مَشاربه",12,"ب",2,0],["فن غرور الملام دعنى","فما حوى الحمد من يغر",13,"ر",1,0],["فَنُغّص مِن ذاكَ السُرور مُهنّأ","وَكُدّر مِن ذاكَ النَعيم معينُ",14,"ن",1,0],["فنغص بالماء الزلال حلوقهم","وارحمتاه لمن يغص الماء",15,"ا",2,0],["فنغيبُ عن عينِ الوجودِ كأننا","جئنا لنزرعَ في الشواطئِ عِشقَنا",16,"ن",2,0],["فنغسل الهمّ عن أركان حاضرنا","عسى يزغرد بالآمال آتينا",17,"ن",2,0],["فنغص الدهر أحلامي وضيعها","بالبعد عن وجهك المرسوم في مقلي",18,"ل",2,0],["فنغدو في البراري بانتشاءٍ","نجوبُ الوأدِ والسهلَ الرحيبا",19,"ب",2,0],["فنغرق في مغان من جلال","عرائس زهوها للروح فتح",20,"ح",1,0],["فنغرف من عزّها ما نشاءُ","وتستر من عيبنا ما تشاء",21,"ا",2,0]]}