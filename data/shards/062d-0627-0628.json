{"poems":[[55,"ربما رد عنك سهم المرامي","https://www.aldiwan.net/poem29779.html","الخفيف"],[32,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[74,"قل عوني على الزمان فأصبح","https://www.aldiwan.net/poem20465.html","الخفيف"],[51,"نعت الدنيا إلينا نفسها","https://www.aldiwan.net/poem62131.html","الرمل"],[107,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[21,"اصبر النفس عند كل ملم","https://www.aldiwan.net/poem36167.html","الخفيف"],[48,"الحظ لي ولأهل الأرض كلهم","https://www.aldiwan.net/poem22201.html","البسيط"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[566,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104608","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38104","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99971","الخفيف"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77300","الكامل"],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[5587,"مذهول","https://www.poetsgate.com/ViewPoem.aspx?id=197805",""]],"verses":[["حابِسُ الفيلِ بِالمُغَمَّسِ وَالأُح","بوشُ يَزجُرنَهُ قَدامٍ قَدامِ",0,"م",1,0],["حابي الشَراسيفِ أَقنى الصُلبِ مُنسَرِحٌ","سَدوُ الذِراعَينِ جافي رَجعَةِ العَضُدِ",1,"د",1,0],["حابس اللفظ واليراع عن النا","سِ فلا من يديَّ ولا من لساني",2,"ي",1,0],["حابِسُ الدُنيا لَها مِن حَبسِهِ","فَلَتاتٍ لَم يُمَلَّك حَبسَها",3,"س",3,0],["حاباكِ مِن جَعلَ المَحاسِنَ آيَةً","لَكِ مِن رَوائِعِها الطِرازُ الأَبدَعُ",4,"ع",1,0],["حابِساً جَوفَهُ عَلَيهِ رَسولاً","مِن خِفافِ الحَمامِ كَالتِمثالُ",5,"ل",1,0],["حابي كَثيرٌ وَما نَبلي بِصائِبَةٍ","وَكَيفَ لي في مَراميهِنَّ باِلحابي",6,"ب",2,0],["حابِسي رَسمٌ وَقَفتُ بِهِ","لَو أُطيعُ النَفسَ لَم أَرِمُه",7,"م",2,0],["حابسَ ظِلٍّ لا يزال راكدا","مُجريَ ماءٍ لا يزال ماكدا",8,"د",2,0],["حابي ضُلوعِ الزَورِ دَوسَرِيُّ","كَأَنَّهُ حينَ وَنى المَطِيُّ",9,"ي",1,0],["حابلاً يرمي حِبالاً","فرماني في الجِبالِ",10,"ل",1,0],["حابِ الصّديقَ بِبَيعِهِ","فالغُبْنُ مِن فِعلِ اللّئيمْ",11,"م",1,1],["حَابسُ الْمَالِ عَنْهُمْ مُسْتَضَامٌ","باتِّسَاعِ الأَذَى وضِيقِ الْحُبُوسِ",12,"س",1,0],["حابِي القُصَيرَى جُرشُعٌ عَردُ النَّسَى","إِذا عَلاهُ مُستَميتٌ وَسَطَا",13,"ط",2,0],["حابى بِمالي الوَقفَ غَيرَ مُوَفَّقٍ","فَقَضى بِغُرمٍ فادِحٍ وَخَرابِ",14,"ب",1,0],["حابس ليس على صافية","لوطيس الحرب يغشى إن وقد",15,"د",1,0],["حابساً نفسي عليها حبذا","تلك أزراراً وهاتيك عرى",16,"ر",2,0],["حَابْ نَعْشِقْ كِيفِي كِي نْدَادِي","وْاجْفَتْنِي بْنَيّتْ لَعْرَاشْ",17,"ش",1,0]]}