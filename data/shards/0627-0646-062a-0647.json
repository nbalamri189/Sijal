{"poems":[[83,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[44,"نطقت مقلة الفتى الملهوف","https://www.aldiwan.net/poem29715.html","الخفيف"],[31,"أرسلت هند إلينا رسولا","https://www.aldiwan.net/poem42030.html","المديد"],[105,"مرحبا بالوفد وافى من هجر","https://www.aldiwan.net/poem44012.html","المتقارب"],[48,"قل للرقاشي إذا جئته","https://www.aldiwan.net/poem64479.html","البسيط"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[50,"اسقني يابن أسعدا","https://www.aldiwan.net/poem63949.html","مجزوء الخفيف"],[50,"قل لسعدى تحرجي","https://www.aldiwan.net/poem63989.html","مجزوء الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43878","الرمل"],[95,"سر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=12258",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[99,"رصاصة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=36624",""],[94,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""],[135,"بلغا عني سليمى","https://www.aldiwan.net/poem67947.html","مجزوء الرمل"],[221,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[326,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[351,"أنت هام العز للرتب","https://www.aldiwan.net/poem40773.html","المديد"],[374,"الله الله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[374,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[388,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[400,"يا رجائي وهل سواك رجائي","https://www.aldiwan.net/poem34178.html","الرمل"],[438,"الحمد لله القريب النائي","https://www.aldiwan.net/poem14286.html","الرجز"],[536,"دمت للفن ودام الفن لك","https://www.aldiwan.net/poem47968.html","عموديه"],[556,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[556,"أنت هو الملفوظ واللافظ","https://www.aldiwan.net/poem34401.html","السريع"],[584,"يا غصن نقا يميس في الأوراق","https://www.aldiwan.net/poem17631.html","الدوبيت"]],"verses":[["أنت هوّت روح الإسلام","ما الجسوم لا بروحه",0,"ه",1,0],["إِنتَهِز فُرصَةً تَسُرُّكَ مِنّي","بِاِصطِناعِ الخَيراتِ وَالمَعروفِ",1,"ف",1,0],["أَنتِ هَمّي وَأَحاديثُ نَفسي","ما تَغَيَّبتِ وَإِذ ما أَراكا",2,"ك",2,0],["انتهُوا عن كلِّ ما عَنْهُ نَهَى","وَافْعَلوا مِن كلِّ أمرٍ ما أمرْ",3,"ر",1,0],["إِن تَهجُني تَهجُ فَتىً ماجِداً","لا يَرفَعُ الطَرفَ إِلى مِثلِكا",4,"ك",2,0],["إن تهتَ بالحُسن عُجباً","أتيهُ فَتكاً وأشطر",5,"ر",1,0],["أَنتِ هَمّي مَعَ القَري","نِ وَإِن رُحتُ مُفرَدا",6,"د",2,0],["أَنتِ هَمّي في مَجلِسي","وَمَقيلي وَمَدرَجي",7,"ي",1,0],["أَنْتَ هارُوتُ ولكنْ","صحّفوا تاءَك نُونا",8,"ن",2,0],["إن تهتكي سر السرابِ وجدتِهِ","حلم الرمالِ الهاجعاتِ على الظما",9,"م",2,0],["أنت هيَّجتَ شُعوري طَرَباً","أنا لو لم تحلُ لي لم أشعرُ",10,"ر",1,0],["إن تهزئي منهم فعذركِ واضح","فهم الذين سَقوْكِ أوبأَ كاس",11,"س",1,0],["إنتهت أومتي ، وفكت قيودي","بعدما كنت قاصراً ويتيما ..",12,"م",2,0],["إن تهتف الشام : ميخائيل : أنجدها","كأنّه قدر يحمي به القدر",13,"ر",1,1],["أَنتِ هَمّي يا سُلَيمى","قَد قَضاهُ الرَبُّ حَتما",14,"م",2,0],["أَنتِ هزءٌ في ناظِري فَاِترُكيني","أَنتِ نورٌ في خاطِري وَظَلامٌ",15,"م",1,0],["أنتهى عنده وأدرج فيه","برداء الجلال والإيمان",16,"ن",1,0],["أَنتَ هام العزّ لِلرتب","وَالمَعالي يا اِبن خَير أَبِ",17,"ب",1,1],["إن تهجروني أجد في وصلكم طمعاً","كالشمس تُرجَى وجنحُ الليل معتكر",18,"ر",1,0],["أنت هي الرَوضة المأمونُ مَغرِسُها","ينساب فيها مَعينُ البُرءِ للداءِ",19,"ا",2,0],["أَنتِ هي الهيكلُ المختار من قِدَمٍ","لم ترقَهُ قَطُّ أقدامٌ بأسواءِ",19,"ا",2,0],["إنتهى قول سيدنا النصيح","الذي قوله كله مليح",20,"ح",1,0],["انتهى هذه الحياة وإلا","فالذي بعده من الأنباء",21,"ا",2,0],["أن تهدني بمنهج فيحاء","أقوز بالنجاة والنجاء",22,"ا",2,0],["أنتَ هل تَعلَمُ ما تَفعَلُه","بنُفُوس الناسِ أم لا عِلمَ لَك",23,"ك",1,0],["أنت هذا الجسم مني","أنت قلبي والضلوع",24,"ع",1,0],["أنت هو الملفوظ واللافظُ","واللفظ والملحوظ واللالحظُ",25,"ظ",1,1],["إِنْ تَهْجُر أَوْ تَصُدّ يا بَدْرٌ أفلْ","ذَا هَجْرُكَ مَحْمُولٌ على الأَحْداقِ",26,"ق",1,0]]}