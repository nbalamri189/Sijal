6,"ذَبُلَ الحب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=182133",""],[5957,"طالما أنت أنا","https://www.poetsgate.com/ViewPoem.aspx?id=186316",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""],[6001,"بلغت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=377",""],[6001,"روحي تحبك","https://www.poetsgate.com/ViewPoem.aspx?id=406",""],[6019,"موج قصيدة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53046",""],[6019,"إلى هَجر الحب والنقاﺀ..للأحساﺀ أنشود","https://www.poetsgate.com/ViewPoem.aspx?id=137673",""],[6019,"نص لم تكتمل ملامحه بعد","https://www.poetsgate.com/ViewPoem.aspx?id=145331",""],[6056,"المعاناة الشديدة","https://www.poetsgate.com/ViewPoem.aspx?id=130508",""],[6115,"سرع ما رحت ياشهر الصيامي","https://www.poetsgate.com/ViewPoem.aspx?id=180970",""],[6124,"طَلْعُ نيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109746",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[2220,"طلعتْ بينَ أذرعاتٍ وبصرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19297&r=&rc=839",""]],"verses":[["أنت هوّت روح الإسلام","ما الجسوم لا بروحه",0,"ه",1,0],["إِنتَهِز فُرصَةً تَسُرُّكَ مِنّي","بِاِصطِناعِ الخَيراتِ وَالمَعروفِ",1,"ف",1,0],["أَنتِ هَمّي وَأَحاديثُ نَفسي","ما تَغَيَّبتِ وَإِذ ما أَراكا",2,"ك",2,0],["انتهُوا عن كلِّ ما عَنْهُ نَهَى","وَافْعَلوا مِن كلِّ أمرٍ ما أمرْ",3,"ر",1,0],["إِن تَهجُني تَهجُ فَتىً ماجِداً","لا يَرفَعُ الطَرفَ إِلى مِثلِكا",4,"ك",2,0],["إن تهتَ بالحُسن عُجباً","أتيهُ فَتكاً وأشطر",5,"ر",1,0],["أَنتِ هَمّي مَعَ القَري","نِ وَإِن رُحتُ مُفرَدا",6,"د",2,0],["أَنتِ هَمّي في مَجلِسي","وَمَقيلي وَمَدرَجي",7,"ج",2,0],["أَنْتَ هارُوتُ ولكنْ","صحّفوا تاءَك نُونا",8,"ن",2,0],["إن تهتكي سر السرابِ وجدتِهِ","حلم الرمالِ الهاجعاتِ على الظما",9,"م",2,0],["أنت هيَّجتَ شُعوري طَرَباً","أنا لو لم تحلُ لي لم أشعرُ",10,"ر",1,0],["إن تهزئي منهم فعذركِ واضح","فهم الذين سَقوْكِ أوبأَ كاس",11,"س",1,0],["أنته؟ ليا بيّنت.,,,,,,؟ جددّت الدفين","وغيرك ليا بيّن... يسبب أنكسار",12,"ر",1,0],["إنتهت أومتي ، وفكت قيودي","بعدما كنت قاصراً ويتيما ..",13,"م",2,0],["إن تهتف الشام : ميخائيل : أنجدها","كأنّه قدر يحمي به القدر",14,"ر",1,1],["أَنتِ هَمّي يا سُلَيمى","قَد قَضاهُ الرَبُّ حَتما",15,"م",2,0],["أَنتِ هزءٌ في ناظِري فَاِترُكيني","أَنتِ نورٌ في خاطِري وَظَلامٌ",16,"م",1,0],["أنتهى عنده وأدرج فيه","برداء الجلال والإيمان",17,"ن",1,0],["أَنتَ هام العزّ لِلرتب","وَالمَعالي يا اِبن خَير أَبِ",18,"ب",1,1],["إن تهجروني أجد في وصلكم طمعاً","كالشمس تُرجَى وجنحُ الليل معتكر",19,"ر",1,0],["أنت هي الرَوضة المأمونُ مَغرِسُها","ينساب فيها مَعينُ البُرءِ للداءِ",20,"ا",2,0],["أَنتِ هي الهيكلُ المختار من قِدَمٍ","لم ترقَهُ قَطُّ أقدامٌ بأسواءِ",20,"ا",2,0],["إنتهى قول سيدنا النصيح","الذي قوله كله مليح",21,"ح",1,0],["انتهى هذه الحياة وإلا","فالذي بعده من الأنباء",22,"ا",2,0],["أن تهدني بمنهج فيحاء","أقوز بالنجاة والنجاء",23,"ا",2,0],["أنتَ هل تَعلَمُ ما تَفعَلُه","بنُفُوس الناسِ أم لا عِلمَ لَك",24,"ك",1,0],["أنت هذا الجسم مني","أنت قلبي والضلوع",25,"ع",1,0],["أنت هو الملفوظ واللافظُ","واللفظ والملحوظ واللالحظُ",26,"ظ",1,1],["إِنْ تَهْجُر أَوْ تَصُدّ يا بَدْرٌ أفلْ","ذَا هَجْرُكَ مَحْمُولٌ على الأَحْداقِ",27,"ق",1,0],["انتَهِزُ فُرصَةَ السُّرورِ فَلِلدَّهرِ","وَلِلحادِثاتِ شَأنٌ وَشانُ",28,"ن",1,0],["انتهزُ فُرصَةَ الشبابِ فما أس","رعَ ما يُستردُّ منكَ الشباب",29,"ب",1,0],["انتهت عندك الرواية بالعق","بى وأنت الأتم دوراً وفصلا",30,"ل",2,0],["إن تُهْدِ لي ما يقي رأسي ويُدْفِئهُ","تكنْ كأَنَّكَ قد أهديتَ لي راسا",31,"س",2,0],["أنته عندك الأدلاّ","وبحور شطْ النيل",32,"ل",1,0],["أن تهتبهم ترى ذاك حزما","فليك الحزم ان أكون المهيبا",33,"ب",2,0],["إِنْ تَهْجري فبما واصلتِ آوِنةً","أَو تُبْعِدي فبما أَدَنيْتِ أَطوارَا",34,"ر",2,0],["إنتَه ذِخيرَتنا ولا ذِخر غيرك","أغلى مِنْ الغالي ومِنْ كِل مِعلان",35,"ن",1,0],["انتهت كلُّ الرزايا عندها","فتعدَّى العذلُ والعذر معا",36,"ع",2,0],["اِنتَهى الأَمر إِلى قدرته","طائِعاً ممتثلاً ممتلك",37,"ك",1,0],["إن تهتدي فلقد هديتك ناصحاً","أولا فتلك النار والأدراك",38,"ك",1,0],["انتهى بالورى إلى غاية ما","كنت أرسلت للورى لولاها",39,"ا",3,0],["إنَّ تهذيبَ النُّهى","سرُّ إصلاحِ البِلاد",40,"د",1,0],["إن تهج شوقاً إلى بان الحمى","فلقد حَنَّت إلى أوطانها",41,"ه",2,0],["اِنتَهى الحُسنُ فيكِ أَقصى مَداهُ","ما لِوُسعِ الإِمكانِ مِثلُكَ أُخرى",42,"ر",2,0],["أنت هي الحيةُ لكنما","نفثت سُمّاً لم يكن كالسموم",43,"م",1,0],["انتهينا إلى قبابٍ حسانٍ","مشرقات يزينها التحديب",44,"ب",1,0],["أنت هل تذكرين حين تنامي","ن بأمن في وكرك المعمور",45,"ر",1,0],["انتهض فالركب قالوا انهض","عسى الله يشفيك من ذا المرض",46,"ض",1,1],["إنْتَهْ بْدَرْبكْ وانا بْدَرْبي","لومتك حِبْهُمْ يْخَرِّبْها",47,"ب",3,0],["إنته تضارب عِند لآكال","كنّه مَعَك بيكون بطنين",48,"ن",1,0],["إِنتَهَت عندَكَ البَلاغَةُ لمّا","شَدتَ لِلطّالِبينَ منها قُصورا",49,"ر",2,0],["أَنتَ هذبتَ حدَّهُ والى الصَّي","قل شَحْذ المهندِ المأَثُورِ",50,"ر",1,0],["انته لو تدري","فدوتك عمري",51,"ي",1,0],["أنت هيَّأتنا لأمر فهل هي","يأت للكون غير ذا الأمر أمرا",52,"ر",2,0],["إن تهجره فعزاءك في","دنفٍ يتهامس عوده",53,"د",2,0],["أنتَ هَادٍ لِكُلِّ بَادٍ وَلَولاَ","كَ لَمَا كانَ للأنامِ اهتِداءُ",54,"ا",2,0],["أَنتَ هَذَّبتَها وَقَوَّمت مِنها","ما تَداعى مِن شامخِ الأَطوادِ",55,"د",1,0],["إن تهتدوا فالهدى من أخلاقنا","أو تعتدوا فالله جلَّ معين",56,"ن",1,0],["أنت هنا لك أنة أبكت بها","الهادي وأبكت قبره والمنبرا",57,"ر",2,0],["أَنت هَمّي وَهِمَّتي وَحَديثي","وَأَنيسي فَكَيفَ أَبغي بَديلا",58,"ل",2,0],["أنت ِ هل تسكبين في السطر شمسا","أم هو السحر أن نهيمَ بعيدا",59,"د",2,0],["أنت ِ هلاّ ذكرت كنّا غديرا","نتساقى وظامئاً نغتابُ",60,"ب",1,0],["انته وفي ومن مثلك إعدام","وأنا أحبك حب ما له احدود",61,"د",1,0],["انتهينا من غرام ٍ مطمعه","شوفةٍ ميعادها راس الهلال",62,"ل",1,0],["إن تهادت.. موت حسره ياحمام","وين جنحانك.. ووين ردونها",63,"ن",3,0],["انته مقامك مرتجي عالي النيف","يا سيد الخثرات يا معدن الطيب",64,"ب",1,0],["انته ملكت الشعر خاتم سليمان","اطوعه من حيث تظهر جماله",65,"ل",2,0],["إن تهملوا هذي العقول فعيشكم","مر وفي الأخرى عظيم عذابِ",66,"ب",1,0],["انته من البنقآل بس تحبكه حبك","ولآ تخيّب اللي حط فيك اعتمآده",67,"د",2,0],["انته سحابي مع رمالي","والحب نبته من رمالك",68,"ك",1,0],["انته أناني مافيك احساس","نصاك / قلبي / وخلّيته !",69,"ت",2,0],["انتهى العامُ وعامٌ بعدَه","وغدٌ في حبِها لمَّا يفِدْ",70,"د",1,0],["انتهينا وصار اكبر خطاي الوفا","انتهينا وعند الله جزاي وجزاك",71,"ك",1,1],["انتهى المشوار كله ما تلامسنا الكتوف","لا تعذبني وإلا سرت وتركت المكلا لك إذا ما فيك معروف",72,"ف",1,0],["انته حبيبي لقلبي نوره وْضيّه","تحلا بعيني وقلبي صِرْت تحلا له",73,"ل",2,0],["انته تجر الصوت اذا ماتعشيت","والا وجع ضرسك ليامن تهيا",74,"ي",2,0],["أنتِ هَولي ، وحيرتي ، وجنوني","يومَ للحسن زهوة وتدلّلْ",75,"ل",1,0],["إنْ تهادتْ قطرةٌ من طلّها","جاءت االأحلامُ فوقي ماطره!",76,"ر",2,0],["انتهينا لا الهوى يحنو علينا","قد محوناه كِلانا بيدَيْنا",77,"ن",2,1],["انتهينا لا لقاءٌ ممكن","يكشف الأعذار عما قد جنَينا",77,"ن",2,0],["أنت هلال في سماء العلا","وغصن مجد بنداه رطيب",78,"ب",1,0],["انته النفس عايش بين الضلوع","لو متنه علحبك والله حكنه",79,"ن",2,0],["انته الكاع جانت منك تهاب","تلوح ابعد نجم جانت سيوفك",80,"ك",1,0],["انته بيا وكت ذوله يغلبوك","حته بحلم ما وصلو جروفك",80,"ك",1,0],["انته مو اول جرح واستغرب آني","آني صاير كلي جرح وينلجم",81,"م",1,0],["انته اسمك على صدر القصيدة وسام","مزهرية وباقة من ورود الربيع",82,"ع",1,0],["إنته لنا العيد فرحات وتراحيبي","وايّامنا بك أعياد طول الايّامي",83,"م",2,0],["إنته إنته لي تخيّرنا","ولا عليك ايروم عفّينا",84,"ن",2,0],["انتهت مسرحيّة الذلّ لكنْ","في بلادي لم ينته ِ الإذلالُ",85,"ل",1,0],["أنتَ هاروني الذي أحببتُهُ","وأنا الغيمةُ بالعشقِ تمرْ",86,"ر",1,0],["انته طبيب النفس وانا لك اتعنيت","تعلم بما في القلب وتعرف خصاته",87,"ت",2,0],["إنْ تهرب اليوم من أشباحه جزعا","نذلا جبانا تكن بالموت لا أحدا",88,"د",2,0],["انت همي ول يامحلاك همي","مع ياملح السنين وهمها",89,"م",3,0],["انته عمري وانت واغلى ذكرياتي","وانت في قلبي ولا غيرك خليل",90,"ل",1,0],["انتهت قصّة غرامي وانتهى اللي قد بديته","وانقضى عمر المحبّه وماتت بكونه الأماني",91,"ن",2,1],["أن تهجري فالبردُ ملءُ قصائدي","يغتالها جذعاً وفرعاً ناميا",92,"ي",2,0],["انته صديقي في زمن ما عاد به باقي صديق","الا الصديق اللي يدور منك غاية وانتفاع",93,"ع",1,0],["أنته رفيع الأمر والأمر عايد","لك يامغزّر سحبها من سماها",94,"ا",3,0],["انتهى وقت الحسايف ووقت الاعتذار","وانتهى وقت الوساطه ووقت الفرفره",95,"ر",2,0],["إن تهجرونا بلا جرم ولا سبب","فمن يطيق لكم هجرا وسلوانا",96,"ن",2,0],["إن تهادت ذكرتني في خفوق العامريه","وإن تمادت تركب ابليس الرجيم وماركبها",97,"ب",3,0],["إن تهت بالقد القضيب فإنه","ما لان إلا وهو يوما ذابل",98,"ل",1,0],["انتهى رز المدينه لسْتطاعوا الزارعين","في زراعة هالارز وصابهم نكست حصادي",99,"د",2,0],["انتهت مدة اجازته وبعدْهم نايمين","هو سمع صوت المؤذن اسلكوا درب الرشادي",99,"د",2,0],["انتهت يا شهرزاد(ن)ساعتي لا ترحمين","قالت ورب العبادي قد ذهب كل النكادي",99,"د",2,0],["أن تهجري قلبي يمت بصبابة","....................فصليه عشقا كي يطير محلقا",100,"ق",2,0],["انته اضنك عميلاً للجهات الاجنبية","الجهات الخاينات الحاقدات المغرضاتي",101,"ت",2,0],["انتهى عهد الطواعية","وبدا عهدك يا اسير",102,"ر",1,0],["إنْ تهادتْ وهْيَ تمشي زَلزلتْ","ليْ فؤاديْ (رِخترٌ) قد عدَّ ألفا",103,"ف",2,0],["إنْ تهجريني سوف أرثي حالتي","يا من حلمتُ أكون تحت ردائها",104,"ا",3,0],["أنت هدّامُ قصوري","وأنا أبني القصورْ",105,"ر",1,0],["إن تهب الريح من عين الدجى","فاسترحْ ليس بها صوت الغضب",106,"ب",1,0],["انته يصاحب هاتلي خبر وعلام","ولاّ تباني عن يوابهم اسكتْ",107,"ت",1,0],["انته المنى والأمل وانته سبب نوحي","يا ليتني بلسمك واداري جروحك",108,"ك",1,0],["إنته وانا والأصل منّك ومنّي","كل السعاده والأمل في محيّاك",109,"ك",1,0],["إِنْ تُهرِقِي قَدَحَ الغَرَامِ عَلَى يَدِيْ","أَنْبَتِّ بَينَ أَنَامِلِي أَعشَابَا",110,"ب",2,0],["أنتِ هنا في كيانِ الشوقِ عابقةٌ","لَمَّا تغنى على ألحانكِ الزَّهَرُ",111,"ر",1,0],["إن تهتُ في دهشة الألوان من عجبي","لأبيضٍ فَرَّ قبل التِّيهِ أسوَدُه",112,"د",2,0],["إنتهض في داخلي رغم المعاناة الشديدة","باقي إنسان ٍ تداعى من جروح ٍ مستسمّه",113,"م",2,0],["انتهى الشرك وعصور الظلامي : والله ارسل الى العالم حبيبه","ربنا اللى بعث طه حبيبه : وابتدأ النور وانزاح الظلامي",114,"م",2,0],["أنتَ همّي إذْ غابَ طيري مُراقاً","في دماءٍ من أُمنيَاتِ الضبابِ",115,"ب",1,0],["أن تهوي الريحُ إليكَ , تقو","لَ لأين رعى الحُبَّ الوَترُ",116,"ر",1,0],["انتهى الحسنُ فيكِ أقصى مداهُ","ما بوسعِ الإمكانِ مثلكِ أخرى",117,"ر",2,0]]}