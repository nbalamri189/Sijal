{"poems":[[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[88,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[92,"الحب شعلة نور ساحر هبطت","https://www.aldiwan.net/poem38929.html","البسيط"],[89,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[56,"ومزر بالقضيب إذا تثنى","https://www.aldiwan.net/poem58500.html","الوافر"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[45,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[61,"هل لك يا ابن غاليه","https://www.aldiwan.net/poem51315.html","مجزوء الرجز"],[61,"رويدك عن تفنيد ذي المقلة العبرى","https://www.aldiwan.net/poem51837.html","الطويل"],[49,"لعمرك ما الدنيا بدار بقاء","https://www.aldiwan.net/poem10314.html","الطويل"],[49,"ليبك رسول الله من كان باكيا","https://www.aldiwan.net/poem63203.html","الطويل"],[80,"إني امرؤ لا ترى لساني","https://www.aldiwan.net/poem31253.html","مخلع البسيط"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[44,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[44,"أتاني ورحلي بالعذيب عشية","https://www.aldiwan.net/poem30600.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"ومزنة جاد من أجفانها المطر","https://www.aldiwan.net/poem26946.html","البسيط"],[48,"لا تحزنن لفرقة الأقران","https://www.aldiwan.net/poem65305.html","الكامل"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54606","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[61,"رويدَكَ عن تفنيدِ ذي المُقلَة ِ العَبْرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59467&r=&rc=0",""]],"verses":[["وَمَزَجنا خَمرَ الرُضابَينِ في الرَش","فِ بِرُغمِ المُدامِ تَحتَ العِناقِ",0,"ق",1,0],["وَمُزَعزَعٍ مِثلِ الجَريرِ إِذا اِنحَنى","لِلطَعنِ شُيِّعَ بِالطِوالِ الميدِ",1,"د",1,0],["وَمَزلَقَةٍ تُرَشُّ بِها المَنايا","وَتَسمَعُ لِلقُلوبِ بِها رَجاجا",2,"ج",2,0],["وَمُزَمجِرٌ قَطَعَ العَجاجَ أَمامَهُ","لِلهامِ مِنهُ عَمائِمٌ وَذَوائِبُ",3,"ب",1,0],["ومُزيرِ الجِيادِ أرْضَ الأعادي","وهْيَ مُخْتالَةٌ لفَرْطِ المِراحِ",4,"ح",1,0],["وَمِزهَرُنا مُعمَلٌ دائِمٌ","فَأَيُّ الثَلاثَةِ أُزرى بِها",5,"ب",3,0],["وَمَزاراً كُلَّما يَمَّمَهُ","ناشِئٌ حَيّا ثَراهُ وَاِدَّكَر",6,"ر",1,0],["وَمُزبِدٍ مِثلِ عُرضِ الَليلِ لُجَّتُهُ","يُهِلُّ شُكراً عَلى شَطَّيهٍ مَن عَبَرا",7,"ر",2,0],["ومزّق الدهر ويل الدهر مئزرها","حتى بدا من شقوق الثوب جنباها",8,"ا",3,0],["ومزَّق الروض بها كلّ ما","حاكت خيوط الودق من برده",9,"د",2,0],["وَمزاجُ الشَّراب إن حاولوا المز","جَ رُضابٌ يا طيبَ ذاك الرُّضابِ",10,"ب",1,0],["ومَزَّقتْ عن جفونِ الدَّهْرِ أَغْشِيَةً","وعَنْ وُجوه اللَّيالي بُرْقُعَ الغَسَقِ",11,"ق",1,0],["ومزَّقني الباغون كل ممزَّق","ولا أحد عن فعل ذلك ناهيا",12,"ي",2,0],["وَمَزارِعٌ لِلناظِرينَ رَوائِعٌ","لَبِسَ الفَضاءُ بِها طِرازاً أَخضَرا",13,"ر",2,0],["وَمُزْرٍ بالقَضيبِ إذا تَثَنّى","وتَيّاهٍ على القَمَرِ التّمامِ",14,"م",1,1],["ومزجناهما بصبر ورفق","وقررنا بذلك الرفق علينا",15,"ن",2,0],["وَمِزاجُ الصَهباءِ بِالماءِ أَملى","بِصَبوحٍ مُستَحسَنٍ وَغُبوقِ",16,"ق",1,0],["وَمِزاجُهُ كَأسي بِريقَتِهِ الَّتي","ثَلَجَت فُؤادَ مُحِبِّهِ فَتَبَلَّلا",17,"ل",2,0],["ومزقنا له درعا","يواري أعظما حجنا",18,"ن",2,0],["ومزقوا ثلاثة","من قبله علانيه",19,"ي",2,0],["ومزمومَةِ الأطرافِ مُصفرَّةِ القرا","مؤلَّفةِ الأعضاء من فِرَقٍ شتَّى",20,"ا",1,0],["وَمَزَّقَ رَيبُ الدَهرِ كُلَّ جَماعَةٍ","وَكَدَّرَ رَيبُ الدَهرِ كُلَّ صَفاءِ",21,"ا",2,0],["وَمَزَّقتَنا يا مَوتُ كُلَّ مُمَزَّقٍ","وَعَرَّفتَنا يا مَوتُ مِنكَ الدَواهِيا",22,"ي",2,0],["ومَزّقَ القولُ منه عِرْضاً","لا يجدُ المدحُ فيه رَفْوا",23,"و",2,0],["ومزعفرٍ لونَ القميص بِشُقْرَةٍ","كالرّيح تعصفُ في التِهاب البارقِ",24,"ق",1,0],["وَمُزَحزَحاتي عَن ذَراكِ عَوائِقٌ","أَصحَرنَ بي لِلعَنقَفيرِ المُؤيِدِ",25,"د",1,0],["وَمَزلَقَةٍ لِلقَولِ ما شِئتَ دَحضَها","وَقَد زَلَّ عَنها مَن أَعادَ وَمَن أَبدى",26,"د",2,0],["وَمَزَّقتُ جَيبَ اللَيلِ عَنها وَإِنَّما","رَفَعتُ جَناحَ النَسرِ عَن بَيضَةِ الخِدرِ",27,"ر",1,0],["وَمَزاج جَهنَمي عَتي","يَصدع الجور يَصهر الأَغلالا",28,"ل",2,0],["وَمُزنَةٍ جادَ مِن أَجفانِها المَطَرُ","فَالرَوضُ مُنتَظِمٌ وَالقَطرُ مُنتَثِرُ",29,"ر",1,1],["وَمُزَنَّرٍ قَد صُبَّ في قارورَةٍ","ريقَ السَحابِ عَلى النَجيعِ القاني",30,"ن",2,0],["ومُزِيرِها الغَوْرَ الذي لو سَلّمَتْ","ريحٌ على أرجائِها لم تَسْلَم",31,"م",1,0],["وَمِزَاجاً مَا بَيْنَ مَعْنَى وَحِسٍّ","لَمنْ يَكُنْ إِنْ يُرَمْ مِنَ الهَيِّنَاتِ",32,"ت",1,0],["وَمُزْنَةَ البِرِّ وسْمُهَا","فِي تَلَعاتِ الْبَلَدِ الْمُجْذَبِ",33,"ب",1,0],["ومَزاميرَ أُطْلِقَتْ من فَمِ السحْرِ","فمادَتْ لها رَواسِي الجِبالِ",34,"ل",1,0],["ومزيَّتي وهي الوحيدة أنني","جاريتُ طبعي في الكثير كما اقتضى",35,"ض",2,0],["ومَزَجْتُ بين الذكريات خليطةً","فوجدتُني متلذِّذاً أسيانا",36,"ن",2,0],["ومزمومَة ِ الأطرافِ مُصفَرَّة ِ القَرى","مؤلَّفة ِ الأعضاءِ من فِرَقٍ شتَّى",37,"ا",1,0]]}