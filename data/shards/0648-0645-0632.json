{"poems":[[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[88,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[92,"الحب شعلة نور ساحر هبطت","https://www.aldiwan.net/poem38929.html","البسيط"],[89,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[56,"ومزر بالقضيب إذا تثنى","https://www.aldiwan.net/poem58500.html","الوافر"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[45,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[61,"هل لك يا ابن غاليه","https://www.aldiwan.net/poem51315.html","مجزوء الرجز"],[61,"رويدك عن تفنيد ذي المقلة العبرى","https://www.aldiwan.net/poem51837.html","الطويل"],[49,"لعمرك ما الدنيا بدار بقاء","https://www.aldiwan.net/poem10314.html","الطويل"],[49,"ليبك رسول الله من كان باكيا","https://www.aldiwan.net/poem63203.html","الطويل"],[80,"إني امرؤ لا ترى لساني","https://www.aldiwan.net/poem31253.html","مخلع البسيط"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[44,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[44,"أتاني ورحلي بالعذيب عشية","https://www.aldiwan.net/poem30600.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"ومزنة جاد من أجفانها المطر","https://www.aldiwan.net/poem26946.html","البسيط"],[48,"لا تحزنن لفرقة الأقران","https://www.aldiwan.net/poem65305.html","الكامل"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54606","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[61,"رويدَكَ عن تفنيدِ ذي المُقلَة ِ العَبْرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59467&r=&rc=0",""],[107,"يا وحيدا للأماني والمنا","https://www.aldiwan.net/poem16253.html","الرمل"],[113,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[113,"لجأت بأعتاب الحبيب ابن هاشم","https://www.aldiwan.net/poem42165.html","الطويل"],[118,"ماض على غلوائه يجري","https://www.aldiwan.net/poem49330.html","أحذ الكامل"],[122,"سكينة عندها دعد","https://www.aldiwan.net/poem23778.html","مجزوء الوافر"],[167,"اليوم سر العلا واستبشر الأدب","https://www.aldiwan.net/poem1607.html",""],[167,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[167,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[184,"لمن النوادب ينتدبن سراعا","https://www.aldiwan.net/poem43624.html","الكامل"],[184,"نكهات الشباب تغني عن المس","https://www.aldiwan.net/poem43789.html","الخفيف"],[197,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[204,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[223,"معشر القبط يا بني مصر في السر","https://www.aldiwan.net/poem55112.html","الخفيف"],[230,"ومهفهف عبث السقام بجفنه","https://www.aldiwan.net/poem14851.html","الكامل"],[233,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[233,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[248,"أقبل مثل البدر في تمامه","https://www.aldiwan.net/poem15039.html","الرجز"],[257,"رويدك حادي الركب فالجد مسعر","https://www.aldiwan.net/poem35933.html","الطويل"],[259,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[268,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[268,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[273,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[273,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[295,"ومزر بضوء الشمس لم تر وجهه","https://www.aldiwan.net/poem33185.html","الطويل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[326,"دع النائم اليقظان لا تستقه خمرا","https://www.aldiwan.net/poem54971.html","الطويل"],[326,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[359,"أيها السيد الشريف أتانا","https://www.aldiwan.net/poem68138.html","الخفيف"],[360,"حب جديد","https://www.aldiwan.net/poem11635.html","عموديه"],[362,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[374,"أرى الدهر لا يبقي قديما ومحدثا","https://www.aldiwan.net/poem59422.html","الكامل"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[400,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[400,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[413,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[413,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[429,"ومزنر أضحى يقول ثلاثة","https://www.aldiwan.net/poem12607.html","الكامل"],[447,"جهاد ولكن ليس بالسيف والقن","https://www.aldiwan.net/poem990.html",""],[456,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[456,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[456,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[459,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[475,"متى ينجلي بالقرب ذا الناظر القذي","https://www.aldiwan.net/poem15282.html","الطويل"],[480,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[498,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[498,"رأى برق العقيق الفجر لاحا","https://www.aldiwan.net/poem38046.html","الوافر"],[498,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[502,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[549,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[556,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[556,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[556,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[557,"إذا لم يكن معنى حديثك لي يدرى","https://www.aldiwan.net/poem69370.html","الطويل"],[573,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["وَمَزَجنا خَمرَ الرُضابَينِ في الرَش","فِ بِرُغمِ المُدامِ تَحتَ العِناقِ",0,"ق",1,0],["وَمُزَعزَعٍ مِثلِ الجَريرِ إِذا اِنحَنى","لِلطَعنِ شُيِّعَ بِالطِوالِ الميدِ",1,"د",1,0],["وَمَزلَقَةٍ تُرَشُّ بِها المَنايا","وَتَسمَعُ لِلقُلوبِ بِها رَجاجا",2,"ج",2,0],["وَمُزَمجِرٌ قَطَعَ العَجاجَ أَمامَهُ","لِلهامِ مِنهُ عَمائِمٌ وَذَوائِبُ",3,"ب",1,0],["ومُزيرِ الجِيادِ أرْضَ الأعادي","وهْيَ مُخْتالَةٌ لفَرْطِ المِراحِ",4,"ح",1,0],["وَمِزهَرُنا مُعمَلٌ دائِمٌ","فَأَيُّ الثَلاثَةِ أُزرى بِها",5,"ب",3,0],["وَمَزاراً كُلَّما يَمَّمَهُ","ناشِئٌ حَيّا ثَراهُ وَاِدَّكَر",6,"ر",1,0],["وَمُزبِدٍ مِثلِ عُرضِ الَليلِ لُجَّتُهُ","يُهِلُّ شُكراً عَلى شَطَّيهٍ مَن عَبَرا",7,"ر",2,0],["ومزّق الدهر ويل الدهر مئزرها","حتى بدا من شقوق الثوب جنباها",8,"ا",3,0],["ومزَّق الروض بها كلّ ما","حاكت خيوط الودق من برده",9,"د",2,0],["وَمزاجُ الشَّراب إن حاولوا المز","جَ رُضابٌ يا طيبَ ذاك الرُّضابِ",10,"ب",1,0],["ومَزَّقتْ عن جفونِ الدَّهْرِ أَغْشِيَةً","وعَنْ وُجوه اللَّيالي بُرْقُعَ الغَسَقِ",11,"ق",1,0],["ومزَّقني الباغون كل ممزَّق","ولا أحد عن فعل ذلك ناهيا",12,"ي",2,0],["وَمَزارِعٌ لِلناظِرينَ رَوائِعٌ","لَبِسَ الفَضاءُ بِها طِرازاً أَخضَرا",13,"ر",2,0],["وَمُزْرٍ بالقَضيبِ إذا تَثَنّى","وتَيّاهٍ على القَمَرِ التّمامِ",14,"م",1,1],["ومزجناهما بصبر ورفق","وقررنا بذلك الرفق علينا",15,"ن",2,0],["وَمِزاجُ الصَهباءِ بِالماءِ أَملى","بِصَبوحٍ مُستَحسَنٍ وَغُبوقِ",16,"ق",1,0],["وَمِزاجُهُ كَأسي بِريقَتِهِ الَّتي","ثَلَجَت فُؤادَ مُحِبِّهِ فَتَبَلَّلا",17,"ل",2,0],["ومزقنا له درعا","يواري أعظما حجنا",18,"ن",2,0],["ومزقوا ثلاثة","من قبله علانيه",19,"ي",2,0],["ومزمومَةِ الأطرافِ مُصفرَّةِ القرا","مؤلَّفةِ الأعضاء من فِرَقٍ شتَّى",20,"ا",1,0],["وَمَزَّقَ رَيبُ الدَهرِ كُلَّ جَماعَةٍ","وَكَدَّرَ رَيبُ الدَهرِ كُلَّ صَفاءِ",21,"ا",2,0],["وَمَزَّقتَنا يا مَوتُ كُلَّ مُمَزَّقٍ","وَعَرَّفتَنا يا مَوتُ مِنكَ الدَواهِيا",22,"ي",2,0],["ومَزّقَ القولُ منه عِرْضاً","لا يجدُ المدحُ فيه رَفْوا",23,"و",2,0],["ومزعفرٍ لونَ القميص بِشُقْرَةٍ","كالرّيح تعصفُ في التِهاب البارقِ",24,"ق",1,0],["وَمُزَحزَحاتي عَن ذَراكِ عَوائِقٌ","أَصحَرنَ بي لِلعَنقَفيرِ المُؤيِدِ",25,"د",1,0],["وَمَزلَقَةٍ لِلقَولِ ما شِئتَ دَحضَها","وَقَد زَلَّ عَنها مَن أَعادَ وَمَن أَبدى",26,"د",2,0],["وَمَزَّقتُ جَيبَ اللَيلِ عَنها وَإِنَّما","رَفَعتُ جَناحَ النَسرِ عَن بَيضَةِ الخِدرِ",27,"ر",1,0],["وَمَزاج جَهنَمي عَتي","يَصدع الجور يَصهر الأَغلالا",28,"ل",2,0],["وَمُزنَةٍ جادَ مِن أَجفانِها المَطَرُ","فَالرَوضُ مُنتَظِمٌ وَالقَطرُ مُنتَثِرُ",29,"ر",1,1],["وَمُزَنَّرٍ قَد صُبَّ في قارورَةٍ","ريقَ السَحابِ عَلى النَجيعِ القاني",30,"ن",2,0],["ومُزِيرِها الغَوْرَ الذي لو سَلّمَتْ","ريحٌ على أرجائِها لم تَسْلَم",31,"م",1,0],["وَمِزَاجاً مَا بَيْنَ مَعْنَى وَحِسٍّ","لَمنْ يَكُنْ إِنْ يُرَمْ مِنَ الهَيِّنَاتِ",32,"ت",1,0],["وَمُزْنَةَ البِرِّ وسْمُهَا","فِي تَلَعاتِ الْبَلَدِ الْمُجْذَبِ",33,"ب",1,0],["ومَزاميرَ أُطْلِقَتْ من فَمِ السحْرِ","فمادَتْ لها رَواسِي الجِبالِ",34,"ل",1,0],["ومزيَّتي وهي الوحيدة أنني","جاريتُ طبعي في الكثير كما اقتضى",35,"ض",2,0],["ومَزَجْتُ بين الذكريات خليطةً","فوجدتُني متلذِّذاً أسيانا",36,"ن",2,0],["ومزمومَة ِ الأطرافِ مُصفَرَّة ِ القَرى","مؤلَّفة ِ الأعضاءِ من فِرَقٍ شتَّى",37,"ا",1,0],["وَمَزاياك رِياض وَرباً","وَسَجاياك نَسيم وَغَمام",38,"م",1,0],["ومزقت غلغال الغياهب ثابتاً","ولي همة عن ذي المجرة تكبر",39,"ر",1,0],["ومزق شملي جيش ذنبي وذلتي","وضاعت بنفسي من همومي عزائمي",40,"م",2,0],["ومزمجر طوراً كأن له","رعد الجحيم تثور بالجمر",41,"ر",1,0],["ومزهرهم ودفهم","على قانونهم يعدو",42,"د",2,0],["وَمُزبِدٍ يَتراءى المَوتُ راكِبهُ","سَلامَةُ المُتَخَطِّيه لَهُ عَجَبُ",43,"ب",1,0],["وَمُزبِدٍ لا يَلَذُّ النَومُ راكِبَهُ","لَهُ إِذا اِضطَرَبَت أَمواجُهُ زَجَلُ",44,"ل",1,0],["وَمُزبِدٍ يَتَراءى المَوتُ راكِبَهُ","يَرمي بِمُقلَولبِ الأَمواجِ مُرتَطِمِ",45,"م",1,0],["ومزوذنين إذا تباكوا خلتهم","صوت البلابل تملأ الأسماعا",46,"ع",2,0],["ومزاح الشيوخ كالصخر يضني الرو","ح ثقلا عن مبسم مهجور",47,"ر",1,0],["ومزّقت للاسلام والشرق دولة","تملَّى بها ملكٌ وسرّ سريرُ",48,"ر",1,0],["ومزدلفة قصدناها وبتنا","وسبعاً من حصاها لاقطينا",49,"ن",2,0],["وَمَزَجنا دُموعَنا بِدُموعٍ","بَذَلَتها عُيونُكم عن سَخاءِ",50,"ا",2,0],["وَمُزَنَّرٍ يا لَيتَني زِنّارُهُ","كَيما أَفوزَ بِضَمَّةٍ مِن خَصرِه",51,"ر",2,0],["وَمَزارُ الأَحبابِ لَم","يَنأَ وَالدارُ لَم تَبِن",52,"ن",1,0],["وَمُزنَةٌ مَتى أَضا","ءَت لِلعُفاةِ تُغدِقِ",53,"ق",1,0],["وَمَزايا مَآثِرٍ كَالحَصا يَن","فَدُ مِن دونِ عَدِّها الإِحصاءُ",54,"ا",2,0],["ومَزَّقَت أنوارُهُ ثَوبَ الدُّجَى","مذ أطلَعَ الأنجُمَ بابتسامهِ",55,"م",2,0],["ومزّق جناح الليل رغماً على الكرى","فعند رقاع السير يرقى التصبّر",56,"ر",1,0],["ومزجوها كأمثا","ل براها في الخماص",57,"ص",1,0],["ومزِّقنَّ العدى في هَولِ معركةٍ","والخيلُ صهّالةٌ قطّاعةُ اللُّجُم",58,"م",1,0],["ومُزِّقَ ملكُ أندلسٍ بدعوى","طوائفِه وحكمٍ فوضوي",59,"ي",1,0],["وَمُزْناً يَسْتَهِلُّ نَدىً وجُوداً","أَتى بَحراً يُطُمُّ عَلَى البُحورِ",60,"ر",1,0],["ومَزَجْتُم بالقِلى ودكُم","وحَمَيْنَا ودّنا أنْ يُمْزَجا",61,"ج",2,0],["وَمزرٍ بضوءِ الشَمس لم تَرَ وَجهَهُ","ولا ماثَلتهُ في علوٍّ ولا نُبلِ",62,"ل",1,1],["ومزدوج التقييد ينجيك من خطا","ويعرف بالزنجير أيضا وطلياني",63,"ن",2,0],["ومزّق غيابات الكرى عن جفونه","فقد أقسم السفاح أن يخنق الفجرا",64,"ر",2,0],["ومزّقَ صوتي هدأةَ الليل ضارِعاً","ومزّقَ وجدى هدأة الروح طاغيا",65,"ي",2,0],["ومزّقتُ آمالي فباتت ذبيحةً","مشرّدةَ الأشلاءِ تطوى اللياليا",65,"ي",2,0],["وَمُزوَزر في سَمْعَيهِ تَلْقَى","فَراحَ يُقيمُ خَمْساً غَيْرَ سَاجِدْ",66,"د",1,0],["وَمزاياكُم الجَميلَة فاقَت","غايَة دونَ قَدرِها الاِطناب",67,"ب",1,0],["ومزَّقتُ الصُّوَرْ...","لم تُبقِ لي الأيامُ عَنها",68,"ه",2,0],["ومُزْدَوِجٌ كُلُّ دُرِّ النّظامِ","وواسِطةُ العِقْدِ فيه فَريد",69,"د",1,0],["ومزَّق أحزابَ النبيين كلهم","وشتت في الآفاق أبناء جعفر",70,"ر",1,0],["ومُزَلْزلُ السَّبعِ الطّبَاق إذا دهَا","ومُزعزعُ الشُّمِّ الشوامخِ إن قَرا",71,"ر",2,0],["ومزقتم الأعراض كل ممزَّق","وملتم إلى ما قاله كل مفتري",72,"ر",2,0],["ومزجته بالوعظ ح","تى لان قلبٌ كان صَلْداً",73,"د",2,0],["ومزيلٍ كلَّ خطبٍ فادحٍ","للرزايا غير مرجوّ الزَّوال",74,"ل",1,0],["ومزايا الفخار أورثتموها","شرف الجد يورث الأولادا",75,"د",2,0],["ومزنرٍ أضحى يقول ثلاثةً","وأقول من وجهين لا بل واحدُ",76,"د",1,1],["ومزقها حتى استهان عدوه","بها وعلى أنقاضها قوم البنا",77,"ن",2,0],["ومزلقٍ من الكلام موئِسٍ","بلاغةَ المفصح أن يُبينا",78,"ن",2,0],["ومزجتَ بالبِشر المهابةَ وال","إرهابَ بالإرفاقِ والمَهْلِ",79,"ل",1,0],["ومُزنَّد الكفّين غايةُ رأيه","عجزٌ وغاية وعده أن يمطُلا",80,"ل",2,0],["ومزلقةٌ بالفتى لا تكون","لذي حاجةٍ وابنِ فضلٍ مَقَرَّا",81,"ر",2,0],["ومُزلِقَةِ المتنين تَمنعُ سرجَها","وتُسأَلُ قُوسُ اللُّجمِ من أين تُصحَبُ",82,"ب",1,0],["ومُزمْجرٍ بالقاعِ يُظْلِمُ صبحه","مما يثير من العجاجِ الأكدر",83,"ر",1,0],["ومزمعةٍ مِن غيرِ جرمٍ ترحُّلاً","ودمعي عليها رُقْيَةُ المتعوِّذِ",84,"ذ",1,0],["ومزق ثياب العز في جنب وصلها","فإن فناء النفس شرط لوصلة",85,"ه",1,0],["ومزع صبيانا ببطن أراكة","تأخوا بكاهل الكهف في روح ريحان",86,"ن",1,0],["ومزِّقْ كلَّ دِرعٍ أَنْتَ فيه","وسَلِّمْ للكَريمِ المُسْتَعَانِ",87,"ن",1,0],["ومزَّقَ حَيْلهُ نَهْباً قُدودٌ","على العشَّاقِ قَدْ هزَّتْ رِماحا",88,"ح",2,0],["ومزَّقَتْ نفْسَ عبدٍ بالغرامِ عَفا","بأيِّ ذنبٍ إذاً مَوؤودَتي قُتلتْ",89,"ت",1,0],["ومزاين القى ان تركتك تايباً","ومالك في فلك الجمال نظاير",90,"ر",1,0],["ومزوّدٍ ماءَ الشّبابِ كأنّهُ","قَمَرُ الدُّجُنَّةِ حُسنُهُ ومُثولُهُ",91,"ل",2,0],["ومزاولٍ تعجيل أمرٍ لو أتى","عَجِلاً إِليه لساءَه تعجيلُهُ",91,"ل",2,0],["وَمزعزعٌ تشكو حشاهُ خِيفةً","ومروّعٌ تجري حِذاراً أدُمعِي",92,"ي",1,0],["ومزوّدٌ طولَ البقا","ءِ وما يرجِّي أن يبيتا",93,"ت",2,0],["وَمُزاحِمين لَهم على راياتِهمْ","رَجعوا وَقد نكصوا على الأعقابِ",94,"ب",1,0],["ومزيد إنعام بوافر حكمة","منعته رحمته بنا أن يبطشا",95,"ش",2,0],["ومزامير المعاني","أطربت بالنغمات",96,"ت",1,0],["ومزدلفات القرب مسجد خيفها","تجرد عن خوف به في الرغائب",97,"ب",1,0],["وَمزقتُ أثواب الوقارِ تَهتكا","عليكَ وطابت في محَبتكَ الْبلوَى",98,"و",2,0],["ومزنةٌ ضَحِكَتْ إِذَا","فجَّعْتَها بالإِبْرَاقْ",99,"ق",1,0]]}