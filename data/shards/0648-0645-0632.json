em/70048","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77121","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125897","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123503","المديد"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91016","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94460","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81941","المتقارب"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133124","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58066","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76749","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99109","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139606",""],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4755,"أيوب..","https://www.poetsgate.com/ViewPoem.aspx?id=183981",""],[4755,"مُكَاشَفَة","https://www.poetsgate.com/ViewPoem.aspx?id=207193",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4899,"الفروق العجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=177125",""],[4929,"على أبواب الشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=199264",""],[4935,"لئام الناس أيديها","https://www.poetsgate.com/ViewPoem.aspx?id=129368",""],[4984,"ما تخبئه النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=175560",""],[5010,"غرد في فضاء الشعر حرا","https://www.poetsgate.com/ViewPoem.aspx?id=189945",""],[3271,"من مرج عبقر","https://www.poetsgate.com/ViewPoem.aspx?id=104125",""],[5183,"إن تنصروا الله ينصركم","https://www.poetsgate.com/ViewPoem.aspx?id=185640",""],[5290,"رعي الحقوق كما علمت حقيق","https://www.poetsgate.com/ViewPoem.aspx?id=113130",""],[5313,"رماني أخ أصفي له الود جاهداً","https://www.poetsgate.com/ViewPoem.aspx?id=181092",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5493,"بحرُ العبور","https://www.poetsgate.com/ViewPoem.aspx?id=198115",""],[5542,"تألقي يا حروف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=10060",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[5616,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205217",""],[5628,"الشاعر والعاذلة","https://www.poetsgate.com/ViewPoem.aspx?id=178469",""],[5725,"الشبل المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=190296",""],[5770,"يا وَحشَةَ الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=178815",""],[402,"يا علم الشرق الرفيع الذرى","https://www.poetsgate.com/ViewPoem.aspx?id=35077",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""],[5885,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[6102,"وهم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185329",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[6152,"حبك عالمي الأروع","https://www.poetsgate.com/ViewPoem.aspx?id=204685",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[454,"جهاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82666&r=&rc=30",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""]],"verses":[["وَمَزَجنا خَمرَ الرُضابَينِ في الرَش","فِ بِرُغمِ المُدامِ تَحتَ العِناقِ",0,"ق",1,0],["وَمُزَعزَعٍ مِثلِ الجَريرِ إِذا اِنحَنى","لِلطَعنِ شُيِّعَ بِالطِوالِ الميدِ",1,"د",1,0],["وَمَزلَقَةٍ تُرَشُّ بِها المَنايا","وَتَسمَعُ لِلقُلوبِ بِها رَجاجا",2,"ج",2,0],["وَمُزَمجِرٌ قَطَعَ العَجاجَ أَمامَهُ","لِلهامِ مِنهُ عَمائِمٌ وَذَوائِبُ",3,"ب",1,0],["ومُزيرِ الجِيادِ أرْضَ الأعادي","وهْيَ مُخْتالَةٌ لفَرْطِ المِراحِ",4,"ح",1,0],["وَمِزهَرُنا مُعمَلٌ دائِمٌ","فَأَيُّ الثَلاثَةِ أُزرى بِها",5,"ب",3,0],["وَمَزاراً كُلَّما يَمَّمَهُ","ناشِئٌ حَيّا ثَراهُ وَاِدَّكَر",6,"ر",1,0],["وَمُزبِدٍ مِثلِ عُرضِ الَليلِ لُجَّتُهُ","يُهِلُّ شُكراً عَلى شَطَّيهٍ مَن عَبَرا",7,"ر",2,0],["ومزّق الدهر ويل الدهر مئزرها","حتى بدا من شقوق الثوب جنباها",8,"ا",3,0],["ومزَّق الروض بها كلّ ما","حاكت خيوط الودق من برده",9,"د",2,0],["وَمزاجُ الشَّراب إن حاولوا المز","جَ رُضابٌ يا طيبَ ذاك الرُّضابِ",10,"ب",1,0],["ومَزَّقتْ عن جفونِ الدَّهْرِ أَغْشِيَةً","وعَنْ وُجوه اللَّيالي بُرْقُعَ الغَسَقِ",11,"ق",1,0],["ومزَّقني الباغون كل ممزَّق","ولا أحد عن فعل ذلك ناهيا",12,"ي",2,0],["وَمَزارِعٌ لِلناظِرينَ رَوائِعٌ","لَبِسَ الفَضاءُ بِها طِرازاً أَخضَرا",13,"ر",2,0],["وَمُزْرٍ بالقَضيبِ إذا تَثَنّى","وتَيّاهٍ على القَمَرِ التّمامِ",14,"م",1,1],["ومزجناهما بصبر ورفق","وقررنا بذلك الرفق علينا",15,"ن",2,0],["وَمِزاجُ الصَهباءِ بِالماءِ أَملى","بِصَبوحٍ مُستَحسَنٍ وَغُبوقِ",16,"ق",1,0],["وَمِزاجُهُ كَأسي بِريقَتِهِ الَّتي","ثَلَجَت فُؤادَ مُحِبِّهِ فَتَبَلَّلا",17,"ل",2,0],["ومزقنا له درعا","يواري أعظما حجنا",18,"ن",2,0],["ومزقوا ثلاثة","من قبله علانيه",19,"ي",2,0],["ومزمومَةِ الأطرافِ مُصفرَّةِ القرا","مؤلَّفةِ الأعضاء من فِرَقٍ شتَّى",20,"ا",1,0],["وَمَزَّقَ رَيبُ الدَهرِ كُلَّ جَماعَةٍ","وَكَدَّرَ رَيبُ الدَهرِ كُلَّ صَفاءِ",21,"ا",2,0],["وَمَزَّقتَنا يا مَوتُ كُلَّ مُمَزَّقٍ","وَعَرَّفتَنا يا مَوتُ مِنكَ الدَواهِيا",22,"ي",2,0],["ومَزّقَ القولُ منه عِرْضاً","لا يجدُ المدحُ فيه رَفْوا",23,"و",2,0],["ومزعفرٍ لونَ القميص بِشُقْرَةٍ","كالرّيح تعصفُ في التِهاب البارقِ",24,"ق",1,0],["وَمُزَحزَحاتي عَن ذَراكِ عَوائِقٌ","أَصحَرنَ بي لِلعَنقَفيرِ المُؤيِدِ",25,"د",1,0],["وَمَزلَقَةٍ لِلقَولِ ما شِئتَ دَحضَها","وَقَد زَلَّ عَنها مَن أَعادَ وَمَن أَبدى",26,"د",2,0],["وَمَزَّقتُ جَيبَ اللَيلِ عَنها وَإِنَّما","رَفَعتُ جَناحَ النَسرِ عَن بَيضَةِ الخِدرِ",27,"ر",1,0],["وَمَزاج جَهنَمي عَتي","يَصدع الجور يَصهر الأَغلالا",28,"ل",2,0],["وَمُزنَةٍ جادَ مِن أَجفانِها المَطَرُ","فَالرَوضُ مُنتَظِمٌ وَالقَطرُ مُنتَثِرُ",29,"ر",1,1],["وَمُزَنَّرٍ قَد صُبَّ في قارورَةٍ","ريقَ السَحابِ عَلى النَجيعِ القاني",30,"ن",2,0],["ومُزِيرِها الغَوْرَ الذي لو سَلّمَتْ","ريحٌ على أرجائِها لم تَسْلَم",31,"م",1,0],["وَمِزَاجاً مَا بَيْنَ مَعْنَى وَحِسٍّ","لَمنْ يَكُنْ إِنْ يُرَمْ مِنَ الهَيِّنَاتِ",32,"ت",1,0],["وَمُزْنَةَ البِرِّ وسْمُهَا","فِي تَلَعاتِ الْبَلَدِ الْمُجْذَبِ",33,"ب",1,0],["ومَزاميرَ أُطْلِقَتْ من فَمِ السحْرِ","فمادَتْ لها رَواسِي الجِبالِ",34,"ل",1,0],["ومزايا قوم يصلّون في الظهر","وفي الليّل بسرقون المساجد",35,"د",1,0],["ومزيَّتي وهي الوحيدة أنني","جاريتُ طبعي في الكثير كما اقتضى",36,"ض",2,0],["ومَزَجْتُ بين الذكريات خليطةً","فوجدتُني متلذِّذاً أسيانا",37,"ن",2,0],["ومزّقه الحنين فكلّ جرح","هوى يشكو وغالية تضوع",38,"ع",1,0],["ومزارعٌ للنارظين روائعٌ","لَبِسَ الفضاءُ بها طرازاً أَخضرا",39,"ر",2,0],["ومزمومَة ِ الأطرافِ مُصفَرَّة ِ القَرى","مؤلَّفة ِ الأعضاءِ من فِرَقٍ شتَّى",40,"ا",1,0],["وَمَزاياك رِياض وَرباً","وَسَجاياك نَسيم وَغَمام",41,"م",1,0],["ومزقت غلغال الغياهب ثابتاً","ولي همة عن ذي المجرة تكبر",42,"ر",1,0],["ومزق شملي جيش ذنبي وذلتي","وضاعت بنفسي من همومي عزائمي",43,"م",2,0],["ومزمجر طوراً كأن له","رعد الجحيم تثور بالجمر",44,"ر",1,0],["ومزهرهم ودفهم","على قانونهم يعدو",45,"د",2,0],["وَمُزبِدٍ يَتراءى المَوتُ راكِبهُ","سَلامَةُ المُتَخَطِّيه لَهُ عَجَبُ",46,"ب",1,0],["وَمُزبِدٍ لا يَلَذُّ النَومُ راكِبَهُ","لَهُ إِذا اِضطَرَبَت أَمواجُهُ زَجَلُ",47,"ل",1,0],["وَمُزبِدٍ يَتَراءى المَوتُ راكِبَهُ","يَرمي بِمُقلَولبِ الأَمواجِ مُرتَطِمِ",48,"م",1,0],["ومزوذنين إذا تباكوا خلتهم","صوت البلابل تملأ الأسماعا",49,"ع",2,0],["ومزاح الشيوخ كالصخر يضني الرو","ح ثقلا عن مبسم مهجور",50,"ر",1,0],["ومزّقت للاسلام والشرق دولة","تملَّى بها ملكٌ وسرّ سريرُ",51,"ر",1,0],["ومزدلفة قصدناها وبتنا","وسبعاً من حصاها لاقطينا",52,"ن",2,0],["وَمَزَجنا دُموعَنا بِدُموعٍ","بَذَلَتها عُي