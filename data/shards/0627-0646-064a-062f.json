{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[24,"إن يدركك موت أو مشيب","https://www.aldiwan.net/poem21858.html","الوافر"],[86,"إني دعيت إلى احتفالك فجأة","https://www.aldiwan.net/poem68936.html","الكامل"],[86,"ماذا ادخرت لهذا العيد من أدب","https://www.aldiwan.net/poem68957.html","البسيط"],[54,"سقيا لبيعة أحمد ووصية","https://www.aldiwan.net/poem27435.html","الكامل"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[43,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem9442.html","الكامل"],[45,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[106,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[126,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[141,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[167,"بعثت تهدد بالنوى وتوعد","https://www.aldiwan.net/poem1617.html",""],[184,"إني دفعت إلى حالين بينهما","https://www.aldiwan.net/poem43668.html","البسيط"],[193,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[233,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[269,"وجاه وجهك يحميني ويمنعني","https://www.aldiwan.net/poem52123.html","البسيط"],[273,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[279,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[308,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[400,"يا أيها البدر الذي بعلومه","https://www.aldiwan.net/poem33472.html","الكامل"],[403,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[403,"لأبي العلاء فضائل مشهورة","https://www.aldiwan.net/poem50211.html","الكامل"],[434,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[434,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[434,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[498,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[536,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[538,"إني دعوتك إذ جفيت وشفني","https://www.aldiwan.net/poem56908.html","الكامل"],[560,"لمن المضارب في ظلال الوادي","https://www.aldiwan.net/poem52867.html","الكامل"],[571,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"]],"verses":[["إِن يَدنُ قَومٌ إِلى داري فَآلَفُهُم","وَتَنأَ عَنّي فَأَنتَ الروحُ في البَدَنِ",0,"ن",1,0],["إِن يُدرِكَكَ مَوتٌ أَو مَشيبٌ","فَقَبلَكَ ماتَ أَقوامٌ وَشابوا",1,"ب",3,1],["إِنّي دُعيتُ إِلى اِحتِفالِكَ فَجأَةً","فَأَجَبتُ رَغمَ شَواغِلي وَسَقامي",2,"ي",1,1],["إِنّي دَعَوتُ القَوافي حينَ أَشرَقَ لي","عيدُ الأَميرِ فَلَبَّت غُرَّةَ الطَلَبِ",3,"ب",1,0],["إِن يَدفَعوهُ عَنِ المَقامِ فَلَم يَكُن","شانيهِ إِلّا حاقِداً وَحَسودا",4,"د",2,0],["إِنّي دَعاني إِلى بِشرٍ فَواضِلُهُ","وَالخَيرُ قَد عَلِمَ الأَقوامُ مُتَّبَعُ",5,"ع",1,0],["اني دخلت جحيمي قبل آخرتي","وذقت في العيش زقوما وغسلينا",6,"ن",2,0],["إِنّي دَعَوتُكَ لِلنَوائِبِ دَعوَةً","لَم يُدعَ سامِعُها إِلى أَكفائِهِ",7,"ا",3,0],["إِن يَدنُ يَكفِ الغائِبينَ وَإِن يَغِب","لا يَكفِنا مِنهُ دُنوُّ الحُضَّرِ",8,"ر",1,0],["إِنّي دُفِعْتُ إلى هَواكِ وغُربةٍ","هَتَفَتْ بها العَزَمَاتُ والأَسفارُ",9,"ر",1,0],["إِن يَدجُ لَيلُكَ أَنَّهُم أَمّوا اللِوى","فَلَقَد أَضاءَ وَهُم عَلى ذاتِ الأَضا",10,"ض",2,0],["إنْ يَدْعُهُ الإِنْجِيلُ فارِقْلِيطَهُ","فلَقَدْ دَعاهُ قبلَ ذلكَ إيلا",11,"ل",2,0],["أنَّى دَعَا وأشارَ مُبْتَهِلاً بها","لِمِياهِ مُزْنٍ ما يَزالُ هَطُولا",12,"ل",2,0],["أَنّى دَعاهُ الشَوقُ فَاِرتاحا","مِن بَعدِ ما أَصبَحَ جَمّاحا",13,"ح",2,1],["إِنْ يَدْعُهُ الوَحْيُ لَمَّ تَعُقْهُ","ثَنِيَّةٌ صَعْبَةٌ كَؤُودُ",14,"د",1,0],["إن يدعُهُ داعي الهوى لبَّى، وإِن","نصح النصوح له فغيرُ مُطاع",15,"ع",1,0],["إنِّي دعوتك فاستجبْ لِي دعوتي","يا غايةَ الإجْلال والإعْظامِ",16,"م",1,0],["إِنّي دَعَوتُ نَدى الكِرامَ فَلَم يُجِب","فَلَأَشكُرَنَّ نَدىً أَجابَ وَما دُعي",17,"ع",2,0],["إِن يُدعَ غَيري سَيِّدُ لِحُطامِهِ","فَالتَيسُ في اللُغَةِ الصَحيحَةِ سَيِّدُ",18,"د",1,0],["إني دفعت إلى حالين بينهما","قلبي يذوب أسى والعمر ينقرض",19,"ض",1,1],["إِن يَدهَموا يَطِدوا بِالصَبرِ أَنفُسِهِم","وَلَن يَقومَ لَهُم في الحَربِ مَن دَهِموا",20,"م",3,0],["إِنَّ يَدَ المُستَضيءِ أَسمَحُ بِال","عَطاءِ يَومَ النَدى مِنَ الدِيَّمِ",21,"م",1,0],["اني دَعَوتك مِن نيابَتي برع","وَأَنتَ أَسمع من يَدعوه ذو شان",22,"ن",1,0],["إنْ يُدْمِنِ السّفَرَ البَعيد مَطارِحاً","فَلأوْجُهِ البُشَراءِ عَنْهُ سُفورُ",23,"ر",1,0],["إني دهيت بما حلمٍ الحليم له","كالطود إن خف من روعاته وهفا",24,"ف",2,0],["إني دعوتك واثقاً بإجابتي","يا خير مدعو وخير مجيب",25,"ب",1,0],["أنى دون داعٍ ولا موجبٍ","ولا سبب واضح ظاهر",26,"ر",1,0],["إني دعوتك سائلاً مسترشداً","فأصِخْ لما أملي عليك وأقبل",27,"ل",1,0],["إِنّي دَعوتك وَالخُطوب محيطة","بي مِثلَما ضَمَّ الذِراعُ سِوارُ",28,"ر",1,0],["إِنّي دَعَوتُكَ لِلنَّوائِبِ دَعوَةٍ","لَمّا رَأَيتُكَ للأنامِ لَجاءَ",29,"ا",2,0],["أن يديم السعد لي","بك والإسعاد لك",30,"ك",1,0],["أن يدّعي الفخر أقوام فحقكم ال","موروث متلدا منه ومطّرفا",31,"ف",2,0],["إن يدم بعدك عني والقلى","عن قليل صرت من أهل القبور",32,"ر",1,0],["إن يدمدم بذكركم في فناءِ ال","بيت ترتجُّ هيبةً أركانه",33,"ن",2,0],["إِني دَعَوتُكَ فَلتُجِب","فَلَقد تُجيبُ لِمَن دَعاك",34,"ك",1,0],["إِنّي دَعَوتُكَ إِذ جُفيتُ وَشَفّني","مَرَضٌ تَضاعَفَني شَديدُ المشتَكى",35,"ا",1,1],["إنّي دَعَوتُكَ فاستَمَعْتُ إجابةً","بالقَلبِ قبلَ الأُذْنِ عِندَ بِعادي",36,"د",2,0],["إِنّي دَعَوتُكَ لِلأَماني الغُرِّ في","ظُلَمِ الزَمانِ السَوءِ أَحكي يونُسا",37,"س",2,0]]}