{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[24,"إن يدركك موت أو مشيب","https://www.aldiwan.net/poem21858.html","الوافر"],[88,"إني دعيت إلى احتفالك فجأة","https://www.aldiwan.net/poem68936.html","الكامل"],[88,"ماذا ادخرت لهذا العيد من أدب","https://www.aldiwan.net/poem68957.html","البسيط"],[56,"سقيا لبيعة أحمد ووصية","https://www.aldiwan.net/poem27435.html","الكامل"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[45,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem9442.html","الكامل"],[47,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[46,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[69,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[52,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[108,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[102,"اعتراف بلا توبة","https://www.poetsgate.com/ViewPoem.aspx?id=50337",""],[132,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[147,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[173,"بعثت تهدد بالنوى وتوعد","https://www.aldiwan.net/poem1617.html",""],[190,"إني دفعت إلى حالين بينهما","https://www.aldiwan.net/poem43668.html","البسيط"],[199,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[276,"وجاه وجهك يحميني ويمنعني","https://www.aldiwan.net/poem52123.html","البسيط"],[280,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[315,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[409,"يا أيها البدر الذي بعلومه","https://www.aldiwan.net/poem33472.html","الكامل"],[412,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[412,"لأبي العلاء فضائل مشهورة","https://www.aldiwan.net/poem50211.html","الكامل"],[443,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[443,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[443,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[505,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[543,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[545,"إني دعوتك إذ جفيت وشفني","https://www.aldiwan.net/poem56908.html","الكامل"],[567,"لمن المضارب في ظلال الوادي","https://www.aldiwan.net/poem52867.html","الكامل"],[578,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122622","البسيط"],[824,"","https://poetry.dctabudhabi.ae/diwan/poem/29484","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48673","الكامل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138820",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59386","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126149","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126142","الرجز"],[1155,"","https://poetry.dctabudhabi.ae/diwan/poem/203324","الرمل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111176","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112855","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112804","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112768","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6755","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109138","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108953","البسيط"],[1661,"","https://poetry.dctabudhabi.ae/diwan/poem/67809","الكامل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45417","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71065","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109353","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109297","الكامل"],[2370,"","https://poetry.dctabudhabi.ae/diwan/poem/121518","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67202","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106873","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93561","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65960","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93835","الرجز"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103167","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112585","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132584","الخفيف"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130055","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68011","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48330","الخفيف"],[3523,"","https://poetry.dctabudhabi.ae/diwan/poem/131357","الكامل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27118","الكامل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32396","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118002","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131035",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135938","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135743","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135739","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136064","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135780","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35616","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83199","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66140","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66142","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66163","المتدارك"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58167","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33706","الرمل"],[4679,"حتى مَ نلهو والمنية تنذر","https://www.poetsgate.com/ViewPoem.aspx?id=142723",""],[557,"أذكر في الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=18224",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5200,"يا شاعرا يصف المهامه والسرى","https://www.poetsgate.com/ViewPoem.aspx?id=200806",""],[5277,"اطمئنان القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=197718",""],[307,"كورونا سيف الردى","https://www.poetsgate.com/ViewPoem.aspx?id=214922",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[5442,"لا تسأمي يا ناق طول السري","https://www.poetsgate.com/ViewPoem.aspx?id=114730",""],[1680,"يا من تحل بذكره","https://www.poetsgate.com/ViewPoem.aspx?id=108880",""],[5704,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=192535",""],[6189,"قسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83577&r=&rc=44",""],[6259,"لأبي العلاء فواضلٌ مشهورة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59353&r=&rc=1",""]],"verses":[["إِن يَدنُ قَومٌ إِلى داري فَآلَفُهُم","وَتَنأَ عَنّي فَأَنتَ الروحُ في البَدَنِ",0,"ن",1,0],["إِن يُدرِكَكَ مَوتٌ أَو مَشيبٌ","فَقَبلَكَ ماتَ أَقوامٌ وَشابوا",1,"ب",3,1],["إِنّي دُعيتُ إِلى اِحتِفالِكَ فَجأَةً","فَأَجَبتُ رَغمَ شَواغِلي وَسَقامي",2,"م",2,1],["إِنّي دَعَوتُ القَوافي حينَ أَشرَقَ لي","عيدُ الأَميرِ فَلَبَّت غُرَّةَ الطَلَبِ",3,"ب",1,0],["إِن يَدفَعوهُ عَنِ المَقامِ فَلَم يَكُن","شانيهِ إِلّا حاقِداً وَحَسودا",4,"د",2,0],["إِنّي دَعاني إِلى بِشرٍ فَواضِلُهُ","وَالخَيرُ قَد عَلِمَ الأَقوامُ مُتَّبَعُ",5,"ع",1,0],["اني دخلت جحيمي قبل آخرتي","وذقت في العيش زقوما وغسلينا",6,"ن",2,0],["إِنّي دَعَوتُكَ لِلنَوائِبِ دَعوَةً","لَم يُدعَ سامِعُها إِلى أَكفائِهِ",7,"ا",3,0],["إِن يَدنُ يَكفِ الغائِبينَ وَإِن يَغِب","لا يَكفِنا مِنهُ دُنوُّ الحُضَّرِ",8,"ر",1,0],["إِنّي دُفِعْتُ إلى هَواكِ وغُربةٍ","هَتَفَتْ بها العَزَمَاتُ والأَسفارُ",9,"ر",1,0],["إِن يَدجُ لَيلُكَ أَنَّهُم أَمّوا اللِوى","فَلَقَد أَضاءَ وَهُم عَلى ذاتِ الأَضا",10,"ض",2,0],["إنْ يَدْعُهُ الإِنْجِيلُ فارِقْلِيطَهُ","فلَقَدْ دَعاهُ قبلَ ذلكَ إيلا",11,"ل",2,0],["أنَّى دَعَا وأشارَ مُبْتَهِلاً بها","لِمِياهِ مُزْنٍ ما يَزالُ هَطُولا",12,"ل",2,0],["أَنّى دَعاهُ الشَوقُ فَاِرتاحا","مِن بَعدِ ما أَصبَحَ جَمّاحا",13,"ح",2,1],["إِنْ يَدْعُهُ الوَحْيُ لَمَّ تَعُقْهُ","ثَنِيَّةٌ صَعْبَةٌ كَؤُودُ",14,"د",1,0],["إن يدعُهُ داعي الهوى لبَّى، وإِن","نصح النصوح له فغيرُ مُطاع",15,"ع",1,0],["أن يدع العلم فلا فرية","فالصدق كل الصدق فيما ادعى",16,"ع",2,1],["إنِّي دعوتك فاستجبْ لِي دعوتي","يا غايةَ الإجْلال والإعْظامِ",17,"م",1,0],["إِنّي دَعَوتُ نَدى الكِرامَ فَلَم يُجِب","فَلَأَشكُرَنَّ نَدىً أَجابَ وَما دُعي",18,"ع",2,0],["إِن يُدعَ غَيري سَيِّدُ لِحُطامِهِ","فَالتَيسُ في اللُغَةِ الصَحيحَةِ سَيِّدُ",19,"د",1,0],["إني دفعت إلى حالين بينهما","قلبي يذوب أسى والعمر ينقرض",20,"ض",1,1],["إِن يَدهَموا يَطِدوا بِالصَبرِ أَنفُسِهِم","وَلَن يَقومَ لَهُم في الحَربِ مَن دَهِموا",21,"م",3,0],["إِنَّ يَدَ المُستَضيءِ أَسمَحُ بِال","عَطاءِ يَومَ النَدى مِنَ الدِيَّمِ",22,"م",1,0],["اني دَعَوتك مِن نيابَتي برع","وَأَنتَ أَسمع من يَدعوه ذو شان",23,"ن",1,0],["إنْ يُدْمِنِ السّفَرَ البَعيد مَطارِحاً","فَلأوْجُهِ البُشَراءِ عَنْهُ سُفورُ",24,"ر",1,0],["إني دهيت بما حلمٍ الحليم له","كالطود إن خف من روعاته وهفا",25,"ف",2,0],["إني دعوتك واثقاً بإجابتي","يا خير مدعو وخير مجيب",26,"ب",1,0],["أنى دون داعٍ ولا موجبٍ","ولا سبب واضح ظاهر",27,"ر",1,0],["إني دعوتك سائلاً مسترشداً","فأصِخْ لما أملي عليك وأقبل",28,"ل",1,0],["إِنّي دَعوتك وَالخُطوب محيطة","بي مِثلَما ضَمَّ الذِراعُ سِوارُ",29,"ر",1,0],["إِنّي دَعَوتُكَ لِلنَّوائِبِ دَعوَةٍ","لَمّا رَأَيتُكَ للأنامِ لَجاءَ",30,"ا",2,0],["أن يديم السعد لي","بك والإسعاد لك",31,"ك",1,0],["أن يدّعي الفخر أقوام فحقكم ال","موروث متلدا منه ومطّرفا",32,"ف",2,0],["إن يدم بعدك عني والقلى","عن قليل صرت من أهل القبور",33,"ر",1,0],["إن يدمدم بذكركم في فناءِ ال","بيت ترتجُّ هيبةً أركانه",34,"ن",2,0],["إِني دَعَوتُكَ فَلتُجِب","فَلَقد تُجيبُ لِمَن دَعاك",35,"ك",1,0],["إِنّي دَعَوتُكَ إِذ جُفيتُ وَشَفّني","مَرَضٌ تَضاعَفَني شَديدُ المشتَكى",36,"ا",1,1],["إنّي دَعَوتُكَ فاستَمَعْتُ إجابةً","بالقَلبِ قبلَ الأُذْنِ عِندَ بِعادي",37,"د",2,0],["إِنّي دَعَوتُكَ لِلأَماني الغُرِّ في","ظُلَمِ الزَمانِ السَوءِ أَحكي يونُسا",38,"س",2,0],["إنّي دَعوتُكَ والأيامُ قد نَحَتَت","عُودي وأثقَلَ ظَهري حَملُ أوزاري",39,"ر",2,0],["إِن يَدعُ زَيدٌ بَني ذُهلٍ لِمَغضَبَةٍ","نَغضَب لِزُرعَةَ إِنَّ القَبصَ مَحسوبُ",40,"ب",1,0],["إن يدّع المجد الرجال فإنما","في الشعر آية مجده ووسامه",41,"م",2,0],["إن يدفنوه فإنما دفنوا به","خير العلوم بأسرها في قبرهِ",42,"ر",2,0],["إنِّي دَعَوْتُكَ مُضْطَرّاً فَخُذْ بِيَدِي","مِنْ شَرّ مَا رَاشَه الأعْدَا وَمَا قَصَدوا",43,"د",3,0],["إني دعوتك باضطرا","ر فاستجب لي يا صمد",44,"د",1,0],["إن يدعها داعي الهدى","تبدي النفور وتهرب",45,"ب",1,0],["إن يد الله الكريم ملأى","فلاتنِ عن ذكره وتنأى",46,"ا",2,0],["أن يدوم الغيث شهراً هكذا","جاء بالطوفان والبحر والمحيطِ",47,"ط",1,1],["ان يدعه الباري فكم لباه في","كرم واعقبه بشخص أكرم",48,"م",1,0],["أني دخيلك فاقبلن وادخلن دخيلك","فادفع وبالكف المكرم فاردد",49,"د",1,0],["اني دخيلك والدخيل بجاهكم","يحمي ويحظى بالجواهر والدرر",50,"ر",1,0],["إني دخيلك يا رسو","ل اللَه أرجو أن أجار",51,"ر",1,0],["إِنّي دَعَوتُكَ مُلحِفاً لِتُجيرَني","مِمّا أَخافُ فَلا تَرُدَّ المُلحِفا",52,"ف",2,0],["إن يدعهُ الناس رَبًّا ثانياً صدقوا","أو وحدوه فإن الحق ما قالوا",53,"ل",3,0],["إن يدعُها خفَّت لدع","وَتِه وإن ثقلت سريعه",54,"ع",2,0],["إن يدع باسمهما المطرودُ ربَّهما","أثابه وتخلَّى عن مساويه",55,"ي",2,0],["إني دعوتك فاستجبت لدعوتي","والموت مني قيد شبر الشابر",56,"ر",1,0],["إِنّي دَعَوتُ اللَهُ حينَ ظَلَمتَني","رَبّي وَلَيسَ لِمَن دَعا بِبَعيدِ",57,"د",1,0],["أَنِّي دعتني دَعْوةً فأَجَبْتُها","عكُّ لأَفْكُكَهَا من الإيسار",58,"ر",1,0],["ان يدفن الجسم منه في الثرى لمدى","فان فضل علاه غير مدفون",59,"ن",1,0],["اني دريت الحب من بدء الصبا","ودرست من علم الغرام فنونا",60,"ن",2,0],["إن يدفن الماضي العتاة فإنهم","ان يدفنوا الآتى وإن هم أقدموا",61,"م",3,0],["أن يدعهم لمُلمةٍ","لبسوا القُلوب على الدروع",62,"ع",1,0],["إني دعوني محباً في هواكِ وهل","يُدعى محباً فؤادٌ في الهوى قتلا",63,"ل",2,0],["إن يدج في الإِسلام لَيل ملمة","فَلَنا بغرّة وَجهك استصباح",64,"ح",1,0],["إن يدر دورة طرف يلتمع","أو يجل جول لسان ينطق",65,"ق",1,0],["إني دعوت إلى الرحمن في زمن","فيه الهدى دارس مستطمس الأثر",66,"ر",1,0],["إن يدعه داع إلى مكارم","لبى ووافى بالمنى يجيب",67,"ب",1,0],["إني دعاني إليك الخير من بلدي","والخير عند ذوي الأحساب مطلوب",68,"ب",1,0],["إن يدن منها النسر عاجله الردى","لم ينجه أظفوره المتواقح",69,"ح",1,0],["ان يدم بيننا ولا دام بين","لم نجد في الزمان عيشاً رغيدا",70,"د",2,0],["إن يدّعوا الإنصاف أو ينسب لهم","فوفاءُ عرقوبٍ وبخلُ الطائي",71,"ي",1,0],["إني دعوتُ ودعوى الصَّب من لهفٍ","بأن تعود لنا أيامُنا الغُرر",72,"ر",1,0],["أن يُديمَ الإلَهُ منكَ إماماً","راقَ منهُ الجَمالُ والإجْمالُ",73,"ل",1,0],["إني دعوتك يا مجيب بجاههم","لحوائج جماء علمكما كفى",74,"ف",2,0],["إِنّي دَعَوتُكَ يا إِلَهَ مُحَمَّدٍ","دَعوى فَأَوَّلُها لِيَ اِستِغفارُ",75,"ر",1,1],["إِنّي دَعاني الحينُ فَاِقتادَني","حَتّى رَأَيتُ الظَبيَ بِالبابِ",76,"ب",1,1],["إن يدم للناس سلطان القدر","فعليهم بل على الكون العفاء",77,"ا",2,0],["أن يديم النصر والإقبال وال","عز والإجلال في خاقانها",78,"ن",3,0],["إن يدعها الواجب الزوجيّ قال لها","داعي الهوى إن في ترك الهوى خطرا",79,"ر",2,0],["إن يَدُلَّ ذَاكَ الكَلاَمُ عَلَى الذَّن","بِ أكَانَ لِذَا العِتَابِ بَقَاءُ",80,"ا",2,0],["إني دعوتُ ربّنا من قبل ذا","والضيقَ منه قد وجدتُ منفذا",81,"ذ",2,1],["إني دعوتُك كما أنا أجبْ","أنت كما أنتَ دعائي لأصِبْ",82,"ب",1,0],["إني دخلت وحمايَ في حمى","حماكَ فاحمِ كلَّنا وسلِّما",83,"م",2,0],["إنِّي دعوتك بليلٍ مدلهمْ","وإنّني أرجوك في كل المهمْ",84,"م",1,1],["إني دخلت في حماك ربي","نَجِّ حمايَ من جميع كربي",85,"ي",1,0],["إني دعوتُ بلسانِ الاضطرارْ","أمِدَّني بالفضل مسرعاً جهارْ",86,"ر",1,0],["إِنّي دَعوتكَ حينَ أَجحفَ بي الرَّدى","فَأَغِث فَإِنّي مِنهُ تَحتَ الكلكلِ",87,"ل",1,0],["إن يدَّع المُتَنّبي فوق رتبته","فإنَّ فضلك لا يأْتيه تأْثيم",88,"م",1,0],["إِنَّ يَدَ اللَهِ مَع الجَماعَه","وَخَيرُ ما تَعلو بِهِ القَناعَه",89,"ه",1,0],["ان يَدْعُنا داعي العُلا","لِنَهُبَّ لِلْجُلَّى نَهَبْ",90,"ب",1,0],["إِنْ يَدْعُهُ الأَمْرُ العَظيمُ","لِكَسْبِ مُحْمَدَةٍ هَرَبْ",90,"ب",1,0],["إِنْ يُدْعُنا المجدُ القدِيمُ رَأَيْتَنا","سِرْبَ الحَمائمِ رُوِّعَتْ بِعُقاب",91,"ب",1,0],["إِنْ يَدْنُ مَرامٌ أَنْشُدُهُ","قامَ الهِجْرانُ يُبَعِّدُهُ",92,"د",2,0],["إنِّي دعوتُ كريماً فازَ قاصِدُه","حاشاهُ أن يمنعَ الرَّاجِي ويحرِمَني",93,"ن",2,0],["إن يَدم ما بي أقل وانَدما","أنا في سلمكَ مِمَّن هَلَكا",94,"ك",2,0],["أن يدرك الجسد الفناء فأنه","عرض وأما النفس فهي الجوهر",95,"ر",1,0],["إني دعوت الله دعوة عاشق","ألا تفرقنا الحياة.. ولا البشر..",96,"ر",1,0],["إني داعٍ ياربُّ أجِبْ","سلِّطْ أعطابَك بالجُملَه",97,"ل",2,0],["إنى دعوتك إذ تعقب عيشنا","بعد النعيم تتابع اللأواء",98,"ا",2,0],["إنّي دعوت عظيم العرش في نسكٍ","قربى بحجٍّ لبيتِ الله آتيهِ",99,"ي",2,0],["انْ يدخلَ الجسمِ لا يبقي به نفساً","كأنّ أفعى على الأضلاع تكتملُ",100,"ل",1,0],["أَنْ يُدْرِكَ الأَمْنَ خَيْرُ هَادٍ","مِنْ بَطْشَةِ اللُّدِّ بِاغْتِيَال(١٦)",101,"ل",1,0],["أن يدنني وخدك من بابه","قبلت ما بين يديك الثرى",102,"ر",2,0],["إني دعوتك والهموم","م جيوشها قلبي تطارد",103,"د",1,0],["إنِّي دعوت الله في غسق الدجى","حفظا وإكرامًا لكل معلمِ",104,"م",1,0],["أن يدركوا أن الشراع الذي","يرسو سيلقى موجة عاتية",105,"ي",2,0],["إني دعوتك للنوائب دعوة ً","لما رأيتك للأنام نجاء",106,"ا",2,0]]}