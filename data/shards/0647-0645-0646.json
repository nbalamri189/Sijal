/diwan/poem/65134","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100828","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100196","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89384","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48435","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126980","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36798","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85272","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131075",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131020",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138042","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125801","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125827","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127220","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83661","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83193","الرجز"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116036","الكامل"],[4750,"البارحه يوم الاوادم خواشيع","https://www.poetsgate.com/ViewPoem.aspx?id=180432",""],[4994,"وجه واحد في مرايا القلب","https://www.poetsgate.com/ViewPoem.aspx?id=209098",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[1470,"نبع الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=12967",""],[5186,"رمى النهب عن قوس الهوى رآئش التهم","https://www.poetsgate.com/ViewPoem.aspx?id=156476",""],[5186,"كنا من الدنيا على باخرة","https://www.poetsgate.com/ViewPoem.aspx?id=156435",""],[5327,"وَصَماتُ الغَدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=144598",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"أين النشامى","https://www.poetsgate.com/ViewPoem.aspx?id=182996",""],[5431,"أيّتها النار","https://www.poetsgate.com/ViewPoem.aspx?id=207669",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"يا حلوة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=182329",""],[5956,"كم قلتُ: ساعدنا أيا جبار","https://www.poetsgate.com/ViewPoem.aspx?id=192698",""],[5956,"ما العدلُ يمكن أن يسري سواسية","https://www.poetsgate.com/ViewPoem.aspx?id=204193",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[313,"يا شادي البان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66516&r=&rc=38",""],[463,"لعلَّ الركبَ أن خلصوا نجيَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60283&r=&rc=339",""]],"verses":[["هُمُ نَقَضوا ما قَد بَنى أَوَّلوهُمُ","وَشِدنا وَهَيهاتَ البِناءُ مِنَ النَقضِ",0,"ض",1,0],["هُمُ نَشَطوني مَنشَطَ السِجلِ بَعدَما","تَطاوَحَهُ الجَولانُ وَالقَعرُ غايرُ",1,"ر",1,0],["هُمُ نَعَشوا المُلكَ حَتّى اِستَقَلَّ","وَهُم أَظلَموا الخَطبَ حَتّى اِظّلَم",2,"م",1,0],["هُمْ نَاصِرُوهَا كَمَا كَانُوا وَمَا بَرِحَتْ","ظِلاًّ وَنُوراً لِمَحْرُومٍ وَذِي يَتَمٍ",3,"م",1,0],["همنا فإن يسلُ عن أسداء أنعمه","كفّ الفلان فإنَّ الدهر يسلينا",4,"ن",2,0],["هُمُ نَزَعوا لِواءَ المُلكِ مِنّا","وَنازَعنا طَغامُهُمُ الضِراما",5,"م",2,0],["هُم نَظمُ حِليَتِهِ وَجَوهَرُ عِقدِهِ","وَالعِقدُ قيمَتُهُ يَتيمُ جُمانِهِ",6,"ن",2,0],["همُ نزعوا عن طاعةِ الصبرِ بعدَهُم","يديَّ وأغروا ناجذي ببناني",7,"ن",2,0],["همُ نبذوني منبذَ السلكِ قُطِّعتْ","قُواهُ وخان العِقدَ منه نظامُ",8,"م",1,0],["هُمُ نَصَروا ذاكَ اللِواءَ وَقَد غَدَت","ذَوائِبُهُ فَوقَ الذَوائِبِ تَخفِقُ",9,"ق",1,0],["هُمُ نَزَلوا دارَ الحِفاظَ حَفيظَةً","وَهُم يَمنَعونَ التَمرَ مِمَّن تَمَضَّرا",10,"ر",2,0],["هم نافسوا في حَليهِ وبُرودِه","وَهُمُ أُثيبُوا عنه خيرَ ثَوابِ",11,"ب",1,0],["هَمُّنا اللَهوُ وَالتَكاثُرُ في الما","لِ وَهَذا البِناءُ وَالخُدّامُ",12,"م",1,0],["همْ نورُ عيني والسوادُ لناظري","فإذا سلوتهمُ بمنْ أتعوَّضُ",13,"ض",1,0],["هم نَطَقوا والناسُ من مَرْمَرٍ","والدّهُر مكعومٌ عن النُّطْقِ",14,"ق",1,0],["هُمُ ناسٌ وَلَو رُجِموا اِستَحَقّوا","بِأَنَّهُمُ شَياطينُ الرُجومِ",15,"م",1,0],["هُمْ نُخْبَةٌ إِنْ يَقِلُّوا","فَأَوَّلُ السَّيْلِ شَعْفَهْ",16,"ف",2,0],["هُمُ نَقَضوا عَهدَ الكِتابِ وَفَرضَهُ","وَمُحكَمَهُ بِالزورِ وَالشُبُهاتِ",17,"ت",1,0],["هم نَخَرُوه عقب الصيامِ","في العيد نحرَ الشاءِ والأَغْنامِ",18,"م",1,0],["ة منازل مشبوبة ، وكأنّها","للجنّ في وادي اللّظى أوكار",19,"ر",1,0],["همُ نفخوا التمرُّدَ في خِرافٍ","وأغرَوهنَّ فانقلبت سِباعا",20,"ع",2,0],["هم نصبوا للصيد أشراكهم","فلم يجد بداً ، فطار الحمام",21,"م",1,0],["هم نزعوا لواء الملك منّا","ونازعنا طغامهم الطّعاما",22,"م",2,0],["هُمُ نَقَضُوا عَهْدَ الكِتابِ وفَرْضَهُ","وحُلْمٌ بِلاَ شُورَى ، بِغَيرِ هُدَاة ِ",23,"ه",1,0],["هم نشأة الروح في معراج ذاتي بل","قواد هيكلها لفرض والسنن",24,"ن",1,0],["هُمُ نَزَلُوا أَحياءَ مَكَّةَ فَاِبتَنَوا","بِبَطحائِها في حَيثُ شاؤُوا وَخَيَّمُوا",25,"م",3,0],["هُم نجومٌ في أفقِ شَرع أبي القا","سمِ بانوا للمُؤمنين أضاؤوا",26,"ا",1,0],["هم نخلوني فماذا رأوا","اَأَمسكَ نورَ الضُّحى المنخلُ",27,"ل",1,0],["هِمْنَا بِشِعْرِكَ بَلْ بِسِحْرِكَ فَانْثَنَتْ","أَلْبَابُنَا سَكْرَى بِخَمْرِ بَيَانِ",28,"ن",1,0],["هم نجوم أَشرق الكون بهم","بعد ما كانَت نواحيه ظلاما",29,"م",2,0],["هُمُ نَبَذوني نَبذَهُم كُلَّ سُؤدَدٍ","وَهُم رَفَضوني رَفضَهُم كُلَّ إِحسانِ",30,"ن",1,0],["هم نجوم الهدى أناروا لنا الكو","ن وخطّوا لنا سبيل المعالي",31,"ل",2,0],["هُمُ نجومُ الهدى لَيلاً لمدَّلجٍ","وهم بحارُ الندى نَيلاً لمغترفِ",32,"ف",1,0],["هُم نَقَضوا عَهدَ الوِدادِ وأَقبَلوا","يَرمونَ من قَلبي البَقاءَ على العَهدِ",33,"د",1,1],["هُمُ نُجحُ آمالي وَنَيلُ مآربي","وَصحَّةُ أَسقامي وَراحةُ روحي",34,"ح",2,0],["هُمُ نَقَضُوا عهودي يومَ بانوا","فأبدَوْا صفحةَ الطَّرْفِ المَلول",35,"ل",1,0],["هُمْ نازلونَ بقلبي أيّةً سَلكوا","لو أَنّهمْ رفَقُوا يوماً بمَنْ مَلَكوا",36,"ك",3,1],["همُ نقَضوا عهدي جهاراً وعَهْدهُمْ","لديّ على طولِ البعاد أكيدُ",37,"د",1,0],["ه منهم ويطعمون الطَّعاما","دَحَضوا الغيَّ بالرَّشاد فما",38,"ا",1,0],["هُمُ نقضوا العهود وهم أصَرّوا","بصدِّهم على الحنث العظيم",39,"م",1,0],["هُمْ نَوَّرُوا لَكَ ليلَ كلِّ مُضِلَّةٍ","سُمْراً وبيضاً مَا تَجفُّ غُمُودُها",40,"د",3,0],["هُمُ نسَلوا الخوافِيَ القُدامَى","فطرتُ بها أُزيرِقَ مَضرَحيَّا",41,"ي",2,0],["هم نصبوهُ دون أيامهم","فانحلَّ عنها كلُّ خطبٍ جسيمْ",42,"م",1,0],["همُ نمَوْا عضد الدين الجواد وقد","غاض النَّوال وذلَّت نجدةُ البشرِ",43,"ر",1,0],["همُ نصروا أحكام كلّ مسجّلٍ","وهم سفَّهوا أحلام كلّ مساجل",44,"ل",1,0],["هِمْنا وقد هبَّ معتلُّ النسيمِ بها","كأنَّه بأحاديثِ الحِمى نَسَما",45,"م",2,0],["هم نقضوا عهدي ومَنْ ذا الذي","ما خانَهُ عهدٌ وميثاقُ",46,"ق",1,0],["هُم نَكَّبوكَ عَنِ الطَري","قِ فَبِتَّ تَركَبُ كُلَّ لابَه",47,"ب",2,0],["هُم نظروا لواحظَها فهاموا","وتشرَبُ عقلَ شاربها المُدامُ",48,"م",1,1],["هم نورُ ضِئْضِئي الوُجودِ وحُبُّهُمْ","زادُ القُدومِ على العَظيمِ الباري",49,"ر",2,0],["هِمْنا فلم ندرِ من صفوِ الغرامِ به","طالَ المُقامُ بنا معنًى أَمِ اقْتَرَبَا",50,"ب",2,0],["هُمُ نَقَلُوا عَنِّي الذي لَمْ أَقُلْ بِهِ","هُمُ أَوْحَشُوا بَيْني وبَيْنَ أَحِبَّتي",51,"ي",1,0],["هُمُ نُصبُ عَينِي إِن لقيتُ حَبائباً","وَهُم حَسبُ نَفسي مِن كُهولٍ وفِتيَةِ",52,"ه",1,0],["هُمُ نَصَبوا الأَجسادَ لِلنُبلِ وَالقَنا","فَلَم يَبقَ مِنها اليَومَ إِلّا رَميمُها",53,"م",3,1],["هم نَكثوا إيْمانَهم بِنِفاقهمْ","كما أبرقوا من قبل ذاكَ وأرعَدوا",54,"د",3,0],["هَمُّنا أنتَ وَالزَّمنُ","مَلْمسُ الجلدِ نَاعمٌ",55,"م",1,0],["هم نصروا ديننا وذبوا","بالسمر عنه والمشرفيه",56,"ي",2,0],["هُمُ نَصَرُوا حِزْبَ النَّبِيَ وَهَاجَرُوا","وإنْ شِئْت أنْ تَسْتَعْلِمِ الكُتْبَ تَعْلَمِ",57,"م",1,0],["همُ نيرات الدين كل منهم","شمس بدت للناظرين بمضلع",58,"ع",1,0],["هُمْ نَهَاياتُ كل مَنْ بَرَأَ الله","وغاياتُ خَلْقِهِ والسَّلامُ",59,"م",1,0],["هُمْ نِظَام السُّعود للناس طُرَّا","ومَعدٌّ قِوامُهمْ والنِّظام",59,"م",1,0],["هم نقلوا آثاره ودونوا","هم وطدوا ومهدوا وهونوا",60,"ن",3,0],["هم نصروا التوحيد نصراً مؤزراً","به عز في الآفاق كل مُوحدِ",61,"د",1,0],["همّ نجل الطفيل أن يملأ الدا","ر عليه سلاهبا ورجالا",62,"ل",2,0],["هُمُ نَفَّروا أقرانَهم بمضرَّسٍ","وسَعرٍ وذادُوا الجيشَ حت تَزَحزحوا",63,"ح",3,0],["هم نظموا شمل النبي وكم غدت","رؤوس القبول الصيد في الحرب تنثر",64,"ر",1,0],["هَمٌّ نَفى عَنّي الرُقادَ وَهِمَّةٌ","تَرَكَت رِكابي طُلَّحاً وَجِيادي",65,"د",2,0],["هم نسلُ فاطمةَ البتولِ وحدر ال","كرّار باب العلم والسير الخفى",66,"ف",2,0],["هم نجوم الدين اعلام الزمن","والادلاء على فرض السنن",67,"ن",1,0],["همُّنا شربنا الطِّلا وهوانا","من قديمٍ هذا الشَّراب القديمُ",68,"م",1,0],["هم نزلوا في آل إسحق منزل","وقحطان لولاهم أقل وأخيب",69,"ب",1,0],["هم نصَحوا الى الملا وهيَّؤوا","مُستقبَلاً مُمهَّداً لِمن تلا",70,"ا",1,0],["هم نشَروا الدعوةَ بالدّينِ الحنيف","فاهتدى بِهديهِم منِ اهتدى",70,"ا",1,0],["هُم ناطِقون بِغَير أَلسِنة تُرى","هُم فاحِصون عَن السَرائر تُضمر",71,"ر",1,0],["هُم نَعشُ اثني عشر بالدلالِ","إفهم نَظماً يُشبهُ اللآلي",72,"ي",1,0],["هم نجوم الهدى ولا سيما من","لاح فيهم كالبدر بين الدراري",73,"ر",2,0],["هم نجومٌ أشرق الكون بهم","وغيوثٌ سحبها ظلت ركاما",74,"م",2,0],["هم نيتي في النطق أو صامتا","وإنما للمرء ما قد نوى",75,"و",2,0],["هم نشدون الخير فيك جميعه","ويضن ناعمهم بمحض ثناء",76,"ا",2,0],["هم نسبوا التّأثير لاسمي وما دروا","بنسبته للنّجم كفّر عالم",77,"م",1,0],["هم ناوأوك على جهل بغايتهم","فغودروا بين ضرب البيض والاسل",78,"ل",1,0],["همُ نكَدُ الاعداءِ حتىّ تلقَّبوا","به فاسمهم يَرمي الاعاديَ بالذعرِ",79,"ر",1,0],["هم نور حكمته وباب نجاته","أبداً وموضع سره المكنون",80,"ن",1,0],["هم نور عين محبهم","وهم المسرّة والمنى",81,"ن",2,0],["هم نَصلوا من لؤمكم بعد خُلْطَةٍ","كما نصل النبعُ الكريمُ من القِشرِ",82,"ر",1,0],["همُ نصْبُ عيْني كلّما بخِل الحَيا","تُحيِّيهمُ بالغيثِ أدْمُعُ عَيْنَيّا",83,"ي",2,0],["هم نعمة وغياث للانام وهم","على الطغاة عذاب غير مردود",84,"د",1,0],["هُمُ نَقَلوا عَنّي الَّذي لَم أَفُه بِهِ","وَما آفَة الأَخبار إِلّا رُواتُها",85,"ت",3,0],["هم نصروا دين الهدى بعد أن عفت","له بين سكان البلاد رسوم",86,"م",1,0],["هم نيام وقت الشدائد لكن","في زمان الرخاء غير نيام",87,"م",1,0],["هم نحلوا غيري قريضي وما دروا","بأنّ معاني الشعر مني تكسب",88,"ب",1,0],["هم نابذوا أهل التجارب بعدما","سقاهم خمار التيه من راحه دنا",89,"ن",2,0],["هُمْ نَصَرُوا سِبْطَ النَّبِيِّ وَرَهْطَهُ","وَدانُوا بِأَخْذِ الثَّأْرِ مِنْ كُلِّ مُلْحِدِ",90,"د",1,0],["هم نخبة العرب الكرام وفيهم","يسمو العلاء وستعز الدين",91,"ن",1,0],["هُمُ نقموا منك التعدي وأنكروا","وما احترموا للوادعين حيادا",92,"د",2,0],["همنا ببدر كامل","بضيائه للشمس أخجل",93,"ل",1,1],["هم نجوم بأيهم أبدا أن","نقتدى نهتدي بخير اهتداء",94,"ا",2,0],["هم نُجومُ الهدى بكلِّ سبيلٍ","ضَلَّ فيه الوَرى وَحار الأَنامِ",95,"م",1,0],["هُم نِعمَةٌ لا تُكفَرُ","وَمِنَّةٌ لا تُنكَرُ",96,"ر",1,0],["هُم نُصبُ عيني أنجَدُوا أوغاروا","ومُنى فؤادي أنصفوا أو جارُوا",97,"ر",3,1],["هم(ن)يمزع سترة القلب تمزيع","تقول ينهش ثومة القلب افاعي",98,"ع",2,0],["همنا معاً في سُهوبِ الله نذرَعُها","كالطير تَمرَحُ في نُعمى مَرابيها",99,"ي",3,0],["هم نزهوا سبحان ذات الله عن","حدث وأمكان بذلك فاشهد",100,"د",1,0],["هم نبتك الغالي.. شباب ناضرٌ","نذروا الحياة فِداكَ والعمرانا",101,"ن",2,0],["هم نسبوا ليني إلى نقص شدة","بعزمي وأعماهم هواهم عن الحزم",102,"م",1,0],["همنا ولا ظل ولا مؤنس","إلا وحوش حولنا كاسرة",103,"ر",2,0],["هُم نَبضُ الشَّعبِ فلو ذَهَبُوا","سيصيرُ الشَّعبُ معَ الأمواتْ",104,"ت",1,0],["همُ نصبوا الأئمة كي يقيموا","حدود الله إذ كانوا منارا",105,"ر",2,0],["همُ نقموا لأهل البغي جوراً","وقد أصلوا لأهل الجور نارا",105,"ر",2,0],["همنا همٌ كبيرٌ.",".تنحني منه الجبالْ",106,"ل",1,0],["هم نصّبوهم كي لا نحاسبهم","وأفهمونا : أنّ القضاء سعى",107,"ع",2,0],["هُمْ ناصَروا دينَ الإله بقَلْبِهمْ","إنَّ المَحبَّةَ في القُلوبِ بَقاؤُها",108,"ا",3,0],["همنا نرفع بلدنا مع صفوف الازدهار","و