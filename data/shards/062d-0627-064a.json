{"poems":[[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[93,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[87,"أخذت السماء يا دار ركنا","https://www.aldiwan.net/poem7106.html","الخفيف"],[87,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[47,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[102,"حوار جارين","https://www.poetsgate.com/ViewPoem.aspx?id=50201",""],[33,"قد أتانا الرسولُ بالأبياتِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18806&r=&rc=69",""],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[121,"الغدر","https://www.aldiwan.net/poem24021.html","الرمل"],[139,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[347,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[347,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[422,"حائز الفضل والكمال جميعه","https://www.aldiwan.net/poem53958.html","الخفيف"],[484,"حائرة تسائلت","https://www.aldiwan.net/poem37012.html","مجزوء الرجز"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[563,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87128","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37848","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87860","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110275","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109341","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87702","الرمل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93406","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205422","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202029","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101600","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85196","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85072","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76476","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45025","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136736",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83148","الرجز"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67486","الرمل"],[4772,"آذان الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=190807",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5652,"الخنا طال النفوس الجايعه","https://www.poetsgate.com/ViewPoem.aspx?id=208687",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6170,"لا تمسوهنّ بحُزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86035&r=&rc=6",""]],"verses":[["حائداً عن سبيلِ كلِّ لئيم","شكر الله عند ذاك محيدَكْ",0,"ك",1,0],["حائِراً كَالرَيحِ في أَطلالِها","باكِيا وَالسُحُبَ المُنهَمِرَه",1,"ر",2,0],["حائط الملك بالمدارس إن شئ","ت وإن شئت بالمعاقل يبني",2,"ن",2,0],["حائِطُ الفَنِّ وَباني رُكنِهِ","مَعبَدُ الأَلحانِ إِسحَقُ الغِناء",3,"ا",2,0],["حائِزٌ مُلكَ العِراقَينِ إِلى","ما حَوى الشِحرُ فَأَسيافُ عَدَن",4,"ن",1,0],["حائِراً في ما إليهِ أمرُهُ","حائِرٌ والمَرء في المِحْنَة عَي",5,"ي",1,0],["حَائِراً فِي مَذَاهِبِ الكَسْبِ لاَ يَفْ","رُقُ بَيْنَ الإِصْدَارِ وَالإِيرادِ",6,"د",1,0],["حائرا كالظنون في زحمة الشكّ","وكاللّيل في عيون الحيارى",7,"ر",2,0],["حائرُ الطّرْفِ، إنْ نظرتَ، وما","طرفكَ عندي بصادقِ النظراتِ",8,"ت",1,0],["حائز تقبيل يد الرسول","كما أتى بالسند المنقول",9,"ل",1,0],["حائرًا كيفَ انْطَفَتْ أشجانُهُ","وهوى الصَّرْحُ، وأَفْنَى الشَّغَفا",10,"ف",2,0],["حايزْ نشانْ رعرعْ أيوب","ومعاه لقب جاب اليسرا",11,"ر",2,0],["حائر النفس حيرة لست أدري","ما دواها ولست واللَه أعلم",12,"م",1,0],["حائر في الفكر إذ","دل عليّ الانقلاب",13,"ب",1,0],["حائزَ الفضلِ والكمال جميعه","أَنْتَ رأسُ العُلى وصدرُ الشَّريعه",14,"ه",1,1],["حائرة تسائلت","عن الطريق الأقوم",15,"م",1,1],["حائزٌ غُرَّ خِصالٍ زيّنَتْ","عطلَ الأيّامِ في حُسْنِ حُلاها",16,"ا",3,0],["حائراً بي أتيه في","ليل وهمي الذي سجا",17,"ج",2,0],["حائز المَجد عَن أَبيه أَبي العل","م سميّ الخَليل إِبراهيم",18,"م",1,0],["حايزاً في نَظمِهِ الحالي الرّشيقْ","كلَّ معنىً طارفٍ مُستظرَفِ",19,"ف",1,0],["حائِماتِ الظُنونِ وَالأَفكارِ","يَتَغامَزنَ خِلسَةً بَينَهُنّا",20,"ن",2,0],["حائراً يبحث عن اماله","فيرى النفس استحالت سأما",21,"م",2,0],["حائراً والدجن يغشى سبله","وكأن الزنج جرت عسكرا",22,"ر",2,0],["حائِراً مِن رَبّه ما","زالَ في رَيبٍ وَشكّ",23,"ك",1,0],["حائِكٌ لِلوَشي حَتَّى خِلتُهُ","كانَ في صَنعاءَ مَشهورَ العَمَل",24,"ل",1,0],["حائرات العيون رفّافة الأج","نُح مطرودة عن الأكنان",25,"ن",1,0],["حائرٌ فيم لا أَعيشُ كغيري","هل قضى الله لي بعيشةِ حائر",26,"ر",1,0],["حائر الطرف شارد الفكر يحكي","مدلجاً في الظلام ضلّ السبيلا",27,"ل",2,0],["حائز العلمين بالفهم وال","مشهد السامي على هام البدور",28,"ر",1,0],["حائر الأمر نازح الدار خال","عن كمال الرئيس والمرؤس",29,"س",1,0],["حائما فوق كلتي طول ليلي","بسكون ورأفة وحنان",30,"ن",1,0],["حائِرا كلما اراد اِنتفاضا","لَم يَكُن في قواه حَتّى يَقوما",31,"م",2,0],["حائزاً يوم السباق القصبا","بمجاري كل صعب أشوس",32,"س",1,0],["حاي حِمى الإِسلام مُنجِدُ أَهله","مَن مَجدُهُ باقٍ عَلى الأَعصار",33,"ر",1,0],["حائراً قد وقفتُ ينطقُ دمعي","ولساني من دَهشتي معقودُ",34,"د",1,0],["حائِرَةً وَهَديُها","في أَن تَظَلَّ حائِرَه",35,"ر",2,0],["حائز الأمر علينا","بتولّيه الاماره",36,"ر",2,0],["حائرٌ في ريبِ أوجاعِ الدّجى","ظلُّ أطيافِ الهوى كم أوجعك",37,"ك",1,0],["حائط فرد قتلتم بإسمه","عددا من أكرم الخلق عديدا",38,"د",2,0],["حايرآ وشلون يلقى له قبول","والكرامه وسط .. سوقه بايعه",39,"ع",2,0],["حائر الطرف في الغرام معنّى","مثقل القيد في هواكٓ ذليلُ",40,"ل",1,0],["حاير الوجهة ولا عندي دليل","فاقد أوطاني وخطواتي وجل",41,"ل",1,0],["حايلوا ما شئتموا كي تنتجوا","لذة من محنة أو من دواه",42,"ا",2,0],["حَاْئِرٌ فِيْ لَسْتُ أَدْرِيْ وَالْهَوَىْ","حَاْئِرٌ مِثْلِيْ بِتَاْبُوْتِ الْزَمَنْ",43,"ن",1,0],["حايل ثَلاث عوام ما شقها الضَنا","وَبيام ري العُشب ما عفتونها",44,"ن",3,0],["حائطُ الوردِ ما تلاهُنَّ حتى","صارَ من ضيقِ ما تَنَفَّسْنَّ نايا",45,"ا",3,0]]}