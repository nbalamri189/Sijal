"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67787","الهزج"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73258","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133123","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18809","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/143253","الهزج"],[4676,"ثورة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=206651",""],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[4767,"بستان العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180904",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[585,"ألا انظر وسل من شئت كيف الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=161914",""],[585,"يا ليل هل فرجٌ لي حان أو فلق","https://www.poetsgate.com/ViewPoem.aspx?id=161885",""],[585,"ذكرت له أيامنا فتنهدا","https://www.poetsgate.com/ViewPoem.aspx?id=161845",""],[4478,"كأني موفٍ للهلاكِ عشية ً","https://www.poetsgate.com/ViewPoem.aspx?id=15033",""],[5183,"جَارِيَهْ (الملغزة الإثنا عشرية)","https://www.poetsgate.com/ViewPoem.aspx?id=186409",""],[5277,"حارَ الطبيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=188891",""],[5277,"بغداد ..مفتاحُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=191008",""],[5431,"وأنت انبثاق الضوء أنت شعابه","https://www.poetsgate.com/ViewPoem.aspx?id=197637",""],[5561,"رحيلُ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192742",""],[5616,"الحمدُ لله","https://www.poetsgate.com/ViewPoem.aspx?id=205246",""],[5730,"كيف يحزن قلب أنت ساكنهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210334",""],[5803,"أنت الهيام وصبر العاشقين أنا","https://www.poetsgate.com/ViewPoem.aspx?id=104035",""],[5829,"الشاعر المغرور","https://www.poetsgate.com/ViewPoem.aspx?id=181537",""],[5956,"مفاتيح الدخول إلى بلادي العربية","https://www.poetsgate.com/ViewPoem.aspx?id=192786",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6093,"شيخ القوافل","https://www.poetsgate.com/ViewPoem.aspx?id=203692",""],[6093,"إذا شئت المجاز فأنت بعضي","https://www.poetsgate.com/ViewPoem.aspx?id=207102",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[6271,"زمان الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80699&r=&rc=5",""]],"verses":[["وإنْ تُنوزِعَتِ العَلْياءُ وادُّعِيَتْ","لمالِكٍ مِلْكُها منْ غيْرِ إلْباسِ",0,"س",1,0],["وَإِن تَنقُضي العَهدَ الَّذي كانَ بَينَنا","وَتُبدي بِباقي وُدِّكِ المُتَخَلَّسِ",1,"س",1,0],["وَإِنْ تُنْسَ أَعْمَالٌ رَهَائِنَ وَقْتِهَا","فَلَيْسَ لِمَا خَلَّدْتَ فِي مِصْرَ نِسْيَانُ",2,"ن",1,0],["وأن تنشر الأقوال لا عن طماعة","فتأتي بها مشحونةً بالفوائد",3,"د",1,0],["وَإِن تَندُب خُؤولَةَ آلِ سَعدٍ","تُلاقي الغُرَّ في السَلَفِ الجِعادا",4,"د",2,0],["وأنت نجل ذوي ملك لخدمته","قد قدَّموا منه في الأرواح ما ملكوا",5,"ك",3,0],["وأنتَنني حتى ظننتُ بأنني","وحقِّكما يا صاحبيَّ خَريتُ",6,"ت",1,0],["وَإِن تَناسَيتُها أَو قُلتُ قَد شَحَطَت","عادَت نَواشِطُ مِنها فَهوَ مَكبولُ",7,"ل",1,0],["وَأَنتُنَّ في الهاجِراتِ الظِلالُ","كَأَنَّ أَعالِيَكُنَّ العَبَب",8,"ب",1,0],["وَأَنتُنَّ في البيدِ شاةُ المُعيلِ","جَناها بِجانِب أُخرى حَلَب",8,"ب",1,0],["وَأَنتُنَّ في عَرَصاتِ القُصورِ","حِسانُ الدُمى الزائِناتُ الرَحَب",8,"ب",1,0],["وَإِن تَنقُصوهُ حَقَّ ما أَوجَبَت لَهُ","إِرادَتُهُ في اللَهِ فَاللَهِ رائِدُه",9,"د",2,0],["وَأَنتَ نَدىً نَحيا بِهِ حَيثُ لا نَداً","وَقَطرٌ نُرَجّي جودَهُ حَيثُ لا قَطرُ",10,"ر",1,0],["وإن تَنفَّس فاحذَرْ منه صاعقةً","تُردي الجليسَ وكُنْ منه على ميلِ",11,"ل",1,0],["وَإِن تَنأَ تَحدُث لِلفُؤادِ زَمانَةٌ","وَإِن تَقتَرِب تَعدُ العَوادي وَتَشغَلِ",12,"ل",1,0],["وَإنْ تَنْصُروني قُمْتُ فيهم مُجاهِداً","فإنَّهم للَّهِ أَعْصَى وأَكْفَرُ",13,"ر",1,0],["وأنتَ نِظامُ الدّينِ وابنُ نَبيّهِ","وذو الأمرِ مدعُوٌّ إليه فمَندوب",14,"ب",1,0],["وإن تنَفّس قال المِسْكُ مُعْترفاً","لعارفي طِيبِه مِن نَشْرِهِ أَرَجي",15,"ج",2,0],["وأنت ناعمة خضراء ناضرة","لا تأمني الدهر فالأيام قاهرة",16,"ه",1,0],["وان تنتقم منى فلست بآيس","ولو أدخلت نفسى بجرمى جهنما",17,"م",2,0],["وأنتَ نَدًى نَحيا بهِ، حيثُ لا ندَى،","وَقَطْرٌ نُرَجّي جُودَهُ حيثُ لا قَطْرُ",18,"ر",1,0],["وإن تنفخ الريح طي الشقوق","ففيها صدانا وأصواتُنا",19,"ن",2,0],["وَإِن تُنلُّ أَحَدَاً مِنّا مَنيَّتَهُ","فَما الَّذي بِقَضاءِ اللَهِ يَصنَعُهُ",20,"ع",2,0],["وأنت نعنهنّ مشغول بجارية","كأن أجراسها في الأذن قيثار",21,"ر",1,0],["وان تنآى معرضا وقاليا","زلزلت الارض بها زلزالها",22,"ل",3,0],["وأنت نور إلهي بطلعته","حرف الضلالة قدماً صار مطموسا",23,"س",2,0],["وأنت نشأة سر لطف حكمتها","أضحى به العالم الكوني مأنوسا",23,"س",2,0],["وإن تنجُ لا يُنجيك منسطواته","بنفسك إلا أن تُحلَّ الخرائطا",24,"ط",2,0],["وَأَنتُنَّ النَواعِمُ بَينَ بانٍ","وَخَيريٍّ يَرِفُّ وَجُلَّنارِ",25,"ر",1,0],["وأنت نبيي باتباعك أهتدي","وملتك الزهراء ديني وملتي",26,"ت",2,0],["وأنت نصيري في خطوب تابعت","علي وذخري عند فقري وعيلتي",26,"ت",2,0],["وَأَن تَنوي إِلى سَفَرٍ رَحيلاً","وَلَم تُرفَع لِنِيَّتِها الخِيامُ",27,"م",1,0],["وإن تنطق فقل حقّاً وصدقاً","تكن بالدين والإسلام ظافر",28,"ر",1,0],["وَإِن تَنظِراني اليَومَ أَقضِ لُبانَةً","وَتَستَوجِبا مَنّاً عَلَيَّ وَتُحمَدا",29,"د",2,0],["وان تنحر الأنعام بيضاً فطالما","نحرت بأنعام به الفقر اسودا",30,"د",2,0],["وَإِنْ تُنْتَهَكْ للدِّينِ فِي الأَرْضِ حُرْمَةٌ","يَطُلْ سَيْفُهُ المَاضِي بِمَنْ ضَامَهُ سَطْوَا",31,"و",2,0],["وإن تُنسِكَ الأَيامُ عَهدي فإنَّني","وحقِّك للعهد القَديم لذاكرُ",32,"ر",1,0],["وإن تنادوا إلى همٍّ يؤرّقهم","ألقيت في النار أنفاسي وأوصالي",33,"ل",2,0],["وَإِن تَنثُرِ الأَيّامُ عِقدَ تَأَلُّفٍ","فَرُبَّ اِنتِثارٍ كانَ أَنظَمَ لِلعِقدِ",34,"د",1,0],["وأنت نعمَ المجيرُ منها","تمنعُ إن سلَّم المجيرُ",35,"ر",1,0],["وإن تُنظمِ الأوصافُ من جوهر العلى","رأيت فتىً في كل صنفٍ له عِقدُ",36,"د",1,0],["وإن تنطح العرش العلي بطهارةٍ","مقدسةٍ لا ترق كيف ولا نطح",37,"ح",1,0],["وإنْ تنكرْ ضني جسَدي","ولم تعطِفْ عليّ ولا",38,"ل",2,0],["وأن تَنزِلُوا دَارَ القطيعةِ والقِلَى","وجِيرَانُكُم بَعدَ الكرامِ بها القبطُ",39,"ط",1,0],["وإن تنثّر درٌّ منه فاجْتَلِهِ","بمبسم الأقحوان الغضّ مَنصودا",40,"د",2,0],["وإن تنادوا بشكاة لهم","لم يصبح الشاكون شاكينا",41,"ن",2,0],["وإن تناءت به الأرحام وانتعشت","أوصاله ولذيذ الوصل مفترق",42,"ق",1,0],["وإن تنو تحريكاً وتهذيب جانب","فقد صك ذرعي وقد فتَّ في يدي",43,"د",2,0],["وأَنْتَ نقطَةُ جمعٍ في تَوَحُّدِها","أَجزاءُ أَصنافِ هذا الكَوْنِ تَنْسَبِكُ",44,"ك",1,0],["وإنْ تُناويكَ نفسٌ في توَهُّمِها","فقلْ أَخذْتُ من المَهْدِيِّ ميثاقَا",45,"ق",2,0],["وإِنْ تناهَى فادِحٌ بشدَّةٍ","قلْ حسبيَ اللهُ تعالى وكَفَى",46,"ا",1,0],["وإنْ تنحَني حَنيَ الأساوِر قُضبُه","لِما أثقلَتْها من دُخولِ القَبائِلِ",47,"ل",1,0],["وإنْ تنفّسَ صُبْحٌ عن لظى شفَقٍ","قاموا غِضاباً وظنّوا الصُبحَ يهواها",48,"ا",3,0],["وأن تنافسه الأيام منزلة","كل المواسم ترجوها وترتقب",49,"ب",1,0],["وإن تنظره في رهج المذاكي","نظرت إلى أبي شبلين عادي",50,"د",2,0],["وَأنتَنُ ما يبدُو لنَا مُتَطِّيباً","وليسَ بِمُجدٍ في الصِّنَانِ تَطَيُّبُ",51,"ب",1,0],["وإنْ تَنَشَّقْتُ من كينونتي عَبَقاً","على رُباكَ فعندي من (أنَ)اكَ (أنَا)",52,"ن",2,0],["وإنْ تنظرُ نظرتَ إلى خطوبٍ","ترقّصُ عن قلوب الشّامتينا",53,"ن",2,0],["وإن تنكُص الأقدامُ جُبناً فما لهمْ","إلى المجدِ إلّا شَدُّهُ وعنيقُهُ",54,"ق",2,0],["وَإِنْ تُنبئوا عنّي بأدنى مسرّةٍ","فَلَيسَ لَكُمْ إلّا الوجوه العوابسُ",55,"س",1,0],["وَإنْ تَنُطْ سِرّاً إِلى حفظِهِ","فَهوَ عَلى طولِ المَدى ما فشا",56,"ا",1,0],["وَإِن تناوَلتُمُ بالكاسِ لذَّتَها","فقد كَرَعنا فَيَهنِيكُم وَيَهنِينا",57,"ن",2,0],["وإن تنكبت بقوس حاجب","تواتر الألحاظ من نصولها",58,"ل",3,0],["وَأَنتَ نِعم النصير اِبنُ النَصير وَمن","بحزمه اِندَفَعَت عَن مَصر أَهوال",59,"ل",1,0],["وإن تنسني التقوى صبافي حديقة","أجدها ولا ريب أحر من الجمر",60,"ر",1,0],["وأنت نور حياتي","وأنت كنزي النفيس",61,"س",1,0],["وإن تَنَكَّرَ جسمي بالسقام فقد","غدا غرامي بهم ناراً على علم",62,"م",1,0],["وان تنظروا في وجهه شاهد الفلا","فخلوا اتباعي واستنخير واتباعه",63,"ع",2,0],["وَأنْ تَنْظُرُوا ذُلِّي وَحَالي وَتَرْحَموا","لَقَدْ مَلَّ سَمْعِي مَا يَقُولُ الْعَوَاذِلُ",64,"ل",1,0],["وإن تناءت عنّا دلالا","فحبّذا ذلك الدلال",65,"ل",1,0],["وإن تنحر الأعداء فيه ترحهم","فدعهم ترعهم من سطاك الروائعُ",66,"ع",1,0],["وأنت نأيت لا تشقى لحي","ونشقى للقريب وللبعيد",67,"د",1,0],["وَأَنتَ نؤوم العَين يَلهو بِكَ الكَرى","تَمُر بِكَ الساعات لا تَتذكر",68,"ر",1,0],["وَإِنْ تَنَمَّى يَرْكَب الأَواعِرا","وَقَدْ يُصِيبُ المِخْصَرُ المَخاصِرا",69,"ر",2,0],["وإن تناهت فوقها للألف","وزد عليها عاريا من خلف",70,"ف",1,0],["وإن تنأ منّي دارُها كنتُ جازِعاً","وإن تَدنُ منّي دارُها كنتُ جاذِلا",71,"ل",2,0],["وأنت نجم العلى بل أنت ناظره","وأنت ناصره إن حادثٌ نجما",72,"م",2,0],["وإن تنبح كلاب بني نزار","فإنا للنوابح مُجحرونا",73,"ن",2,0],["وأنت نسيم الصبح باللَه خبرا","بما كان في الليل البهيم وما نبا",74,"ب",2,0],["وأنتَ نعمَ أملُ المؤمّلِ","دونك مجد الدين بالمنتحل",75,"ل",1,0],["وأنت نصيبُنَا منْ كلِّ شيءٍ","فَدُمْتَ وَحَسْبُنَا أوْفَى نصيب",76,"ب",1,0],["وان تنجد رأيت بلا مثال","جماهير الكناوين الكبارا",77,"ر",2,0],["وَأَنتَ نَحيفُ الجِسمِ مالَكَ تابِعٌ","بَطِيٌّ وَلا خَصرٌ إِذا قُمتَ مُدمَجُ",78,"ج",1,0],["وإن تنل منها فحدّ المنطقِ","أو الحساب أو بطبّ فاعلُقِ",79,"ق",1,0],["وان تناهَت قصرا اعمارهم","فمجدهم جاوز عمر الابد",80,"د",1,0],["وأنت نعم الخلق المرتجى","والحمد لله على كل حال",81,"ل",1,1],["وأنت نورٌ ونارٌ أن صوفتِ وإن","كدرتِ حاشاكِ من صفو ومن كدر",82,"ر",1,0],["وإن تناسيتَ صدقَ قولٍ","فإن ذاك النسيانَ مينُ",83,"ن",1,0],["وَإِن تُنظِراني اليَومَ أَتبَعكُما غَداً","قِيادَ الجَنيبِ أَو أَذِلَّ وَأَطوَعا",84,"ع",2,0],["وَإِن تنزه عَن شعر يَفوه بِهِ","فَللنبوة سر لَيسَ تَدريه",85,"ي",2,0],["وَإِن تُنصفوه اليَوم تُلفوه في غَدٍ","سَليم دَواعي الصَدر لا يَحمل الإِصرا",86,"ر",2,0],["وان تنزل بساحته بيومٍ","فلست ترى بها وجها جهاما",87,"م",2,0],["وَإن تَنشُروا الأعلامَ جَاهَ ثلاثةٍ","فَقَيدُكُمُ حَقّاً على الطايرِ الدُرّي",88,"ر",2,0],["وإن تَنظروا اللزَّاقَ ثمَّ الموارزَ","وبلدُكُ تِسعُونَ بهنّورَ صايِر",89,"ر",1,0],["وان تنكري عرفاننا ان رأيتنا","مكاناً كانا لم نقف ساعة معا",90,"ع",2,0],["وإن تنظف دارها","أندس في ترابها",91,"ب",3,0],["وإن تنتسب يوماً تردك طفاوة","لتطفو على الدنيا وتأباك راسب",92,"ب",1,0],["وأنت نور على نور تخر له","في سجدة الحب أجساد وأرواح",93,"ح",1,0],["وإن تنَحْنَحَ الذي دَعَوْتَه","لِحاجَةٍ مُلِمَّةٍ فقد تَنَح",94,"ح",1,0],["وإِن تناستنِي الليالي عندَه","حاشا فقلبي قط عنه مَا خَلا",95,"ا",1,0],["وانت نقولا حزته عن جدارةٍ","وانحزت اسمى منه ما كان ذا كبرِ",96,"ر",1,0],["وَإِن تنضّر خدُّ الوَردِ قلت لَهُ","هَيهات مِنكَ دَوامُ الحُسنِ وَالتَرَف",97,"ف",1,0],["وإن تنزيله القرآن أجمعه","كلامه غير خلق أعجز البشرا",98,"ر",2,0],["وإن تنظروا شزراً إليَّ فإنني","أنا الأعور الشني قيد الأوابدِ",99,"د",1,1],["وإن تنل لمن سوايَ لا عَجَبْ","وأن تنيلني علاكَ فالعجبْ",100,"ب",1,0],["وأنت نعم المولى يا نعمَ النصيرْ","كن لي نصيراً لا تؤاخذْ بنقيرْ",101,"ر",1,0],["وأن تنفِّسَ لضيقِ كُربتي","وفرِّحنِّي بكلِّ نوبتي",102,"ي",1,0],["وَأَنتِ نافورَةَ الحُسنِ الَّتي خَفِيَت","أَيّانَ أَلقاكِ أَو أَلقى مَصادِرَهُ",103,"ه",1,0],["وان تنهد لدهرك في قضاءِ","فأيسرُ ما تروم المستحيل",104,"ل",1,0],["وإن تنَالوا شرفاً وَتَسْعَدُوا","وَوَازِرُوا المَهْدِي كَيْما تَهْتدُوا",105,"د",3,0],["وإن تناشدتُمُ عهداً بِكاظمةٍ","وحقكُم ما نَسينَا مَوقفَ العلَمِ",106,"م",1,0],["وإن تنكحوا فاعطوا النساء حقوقها","فقد قيل من لا يعطي المهر زانيا",107,"ي",2,0],["وَأِنتُنَّ تَلبِسنَ الجَديدَةَ بِعدَما","طُرِدتُ بِطَيِّ الوَطبِ في البُلقِ وَالقَفرِ",108,"ر",1,0],["وإن تنظر عيوبك","تغضضْ عن غيرك النظرا",109,"ر",2,0],["وأنت نقطة باء مع توحدها","بها جميع الذي في الذكر قد جمعا",110,"ع",2,0],["وأنْ تَنْفيَ عَنْ أجفا","ن عينَيْ قلبك الرَّقدَهْ",111,"د",2,0],["وإن تَنفعِ الأفعال من عَملوا بها","فأقواليَ الجَرحى وصوتيْ الخَناجرُ",112,"ر",1,0],["وأنت نور لقلبٍ طاب حاملُه","مُسهَّدِ الليلِ للرحمان يبتهل",113,"ل",1,0],["وأنتُنَّ ماءٌ قد جرى ترتوي بهِ","على كلِّ جزءٍ في الحقولِ كُرومُ",114,"م",1,0],["وإن تنج فالموفور يتلوه سالم","صحيح مُعَرًى لا تدع ذلك الهدى",115,"ا",1,0],["وإن تنسفوا منها القرى فوق أهلها","فما انطمست أمجادهم والمفاخر",116,"ر",1,0],["وإن تنكروهم فالعروبة حسبهم","وما بينهم في صفقة المجد خاسر",116,"ر",1,0],["وأنت نضو خطوبٍ قام شاهدها","في الأسود الجون دب الأبيض اليقق",117,"ق",1,0],["وإن تنقموا منها فلله نقمة","تغادركم صيداً لدى من تصيدا",118,"د",2,0],["وأنّتنّ تلبسَ الجديدة بعدما","طردتُ بطيّ الوطبِ في البلقُ والقفرِ",119,"ر",1,0],["وأنت نصيريَ ربي إذا","تثاقل عن نصرتي جاري7ه",120,"ر",3,0],["وأنتِ نجمةُ صبحٍ في بشارتِها","تغازلُ العودَ في الإصباحِ والوترا",121,"ر",2,0],["وأنت نجمةُ كرخٍ في تألقها","تسري الصباح بسير كله وجلُ",122,"ل",1,0],["وأنت نسيم الصبح أنت سكونه","وأنت صفاء الليل بوحك أنجمُ",123,"م",1,0],["وأنْتَنُ من نفسكَ القلبُ ما","أطاعَ الخطايا بكلِّ غرور",124,"ر",1,0],["وإن تناهَى إلى أسماعهِم خبرٌ","من الديارِ رأيتَ النخلَ مُبتهِجا",125,"ج",2,0],["وَأَنْتَ نِعْمَةُ رَبِّي كَيْفَ أَشْكُرُُهُ","أَغْلَى مِنَ الكَوْنِ يَا َأبْهَى عَطَايَاهُ",126,"ا",2,0],["وَأَنتِ نافورَةَ الحب الَّتي انبثقت","أَيّانَ أَلقاكِ , إن الملتقى عَبِقُ",127,"ق",1,0],["وأنتُّن الفراش تَحُمنَ حولي","فتأتينَ الغضنفرَ في حماه",128,"ه",1,0],["وإنّ تنافراً بين الرعايا","وبين الحاكمين لفي ازديادِ",129,"د",1,0],["وَإِنْ تُنْجِبَ الْعُشْرُوْنَ مِنْهَا ٱثْنَتَيْنِ لِيْ","وَ رَبُّ الْمَزِيْدِ زَاْدَ لِي الْعُمْرَ عَاْفِيَا",130,"ف",3,0],["وإنْ تنَسَّمَ عُلْويُّ الرِّيَاحِ لَها","ألفَيتُهُ لقَصِيّ الوَجْدِ يُدْنِيها",131,"ي",3,0],["وإن تنازل عن أخلاق مهنته","وعاقب السير أشوى القلب والكبدا",132,"د",2,0],["وأنت نجوم أشعاري وفني","وأنت زهور إحساسي وفلي",133,"ل",2,0],["..وإن تنفّس ريّاها ذوو خوَرٍ","إذا الوطيس غشى ،لم يثنهم فَرَقُ",134,"ق",1,0],["وأنت نسجته شجناً خفياً","على أرواحنا إذ نستطيب",135,"ب",1,0]]}