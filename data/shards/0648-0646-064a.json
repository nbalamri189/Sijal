/diwan/poem/111423","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123490","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45049","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94510","الطويل"],[4343,"","https://poetry.dctabudhabi.ae/diwan/poem/123794","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136384",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120210","الوافر"],[4764,"إعدام طفله","https://www.poetsgate.com/ViewPoem.aspx?id=27084",""],[463,"رعى اللهُ في الحاجاتِ كلَّ نجيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=14607",""],[4578,"حكم العيون من الظماء الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49401",""],[4852,"بغداد الدهور","https://www.poetsgate.com/ViewPoem.aspx?id=214428",""],[4119,"يا ليت أن الصد مصدود","https://www.poetsgate.com/ViewPoem.aspx?id=16113",""],[5055,"من بعد هذا الحول","https://www.poetsgate.com/ViewPoem.aspx?id=86531",""],[5189,"أمنياتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=196815",""],[5194,"وينك ؟","https://www.poetsgate.com/ViewPoem.aspx?id=30880",""],[5352,"ونيرب من موالي السوء ذي حسد","https://www.poetsgate.com/ViewPoem.aspx?id=200560",""],[5376,"دخلْتُك آمناً ولك ائتلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188462",""],[5431,"سينقذنا همامٌ عنتريٌ ولا يخشى لعولمةٍ شِراكا","https://www.poetsgate.com/ViewPoem.aspx?id=201631",""],[5459,"لزمنا الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190906",""],[5704,"رُدِّي السلام...","https://www.poetsgate.com/ViewPoem.aspx?id=198738",""],[5725,"عربسان","https://www.poetsgate.com/ViewPoem.aspx?id=207284",""],[5732,"ليحان صدري","https://www.poetsgate.com/ViewPoem.aspx?id=177912",""],[5732,"لا وا عشيري","https://www.poetsgate.com/ViewPoem.aspx?id=177921",""],[5732,"عزي لمن مثلي","https://www.poetsgate.com/ViewPoem.aspx?id=177918",""],[5732,"انبيك يامن هو عن الحال نشاد","https://www.poetsgate.com/ViewPoem.aspx?id=177870",""],[5732,"صفقت بالأصبع","https://www.poetsgate.com/ViewPoem.aspx?id=177955",""],[5809,"حديث","https://www.poetsgate.com/ViewPoem.aspx?id=205104",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[6056,"شيخة القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=130570",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[242,"أهاجك بينهم اذ نأوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563791",""],[1703,"سلامٌ على أرواح من فقدوا طوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83744&r=&rc=81",""],[6259,"هي البدرُ لكن تستسرّ مدى الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59382&r=&rc=30",""]],"verses":[["وَنيلوفَرٍ فَتَّحَتهُ الرِياحُ","وَعانَقَهُ الماءُ صَفواً وَرَنقا",0,"ق",2,0],["وَنى عَنِ السَعيِ فَاِستَرعى مَساعِيَهُ","مُدَرَّباً بِطَريقِ المَجدِ لا يَقِفُ",1,"ف",1,0],["وَنَيلُ الرِزقِ يُؤخَذُ مِن بَعيدٍ","كَنَيلِ الرِزقِ يُؤخَذُ مِن قَريبِ",2,"ب",1,0],["ونِيطَ بكَ الآمالُ لا زالَ يَنتَهي","إليكَ بآمالِ الوَرى كُلّ مَنهَجِ",3,"ج",1,0],["ونِيرانُهُ حَيثُ العِشارُ دِماؤها","تُراقُ ويُذْكيها الوَشيجُ المُكَسَّرُ",4,"ر",1,0],["وَنيطَت حَمائِلُهُ الوافِياتُ","مَكانَ تَمائِمِهِ فَاِحتَمَل",5,"ل",1,0],["وَنَيْلُ الأمَانِي كُلِّهَا دُونَ هَفْوَةٍ","يَسُوءُ بِهَا قَاضٍ مَسُوءاً بِلاَ جُرْمِ",6,"م",1,0],["ونيِّفُ العقد كالسَّنام له","إن جُبّ أبقى بظهره دَبَره",7,"ر",2,0],["وَنَيلَها العَذبُ ما أَحلى مَناظِرَهُ","وَالشَمسُ تَكسوهُ تِبراً في تَواريها",8,"ي",3,0],["ونَيلوفَرٍ أعناقُه أبداً صُفْرُ","كأنَّ بهِ سُكراً وليس به سُكْرُ",9,"ر",1,1],["وَنَيلُكَ هَذا يَشرَكُ النِيلَ مَسمَعاً","وَيَفضُلُهُ مِن بَعدُ في حُسنِ مَنظَرِ",10,"ر",1,0],["وَنَى في التَّصابي بعدَما كان شمَّرا","وقَصَّرَ في شأوِ الزَّمانِ فأقصرَا",11,"ر",2,1],["وَنِيّاتُ أَهلِ الصِدقِ بيضٌ نَقِيَّةٌ","وَأَلسُنُ أَهلِ الصِدقِ لا تَتَلَجلَجُ",12,"ج",1,0],["وَنَيْلُوفَرٍ أوْرَاقُهُ مُسْتَديرَةٌ","تَفَتّحَ فيما بينهنّ لَهُ زَهْرُ",13,"ر",1,1],["ونياحُ ذي كَمَدٍ يذوب بِهِ إِذا","رفع الرثاءُ عقيرةَ الإنشادِ",14,"د",1,0],["وَنيطَت بِحَقوَيهِ الأُمورُ فَأَصبَحَت","بِظِلِّ جَناحَيهِ الأُمورُ اِستَظَلَّتِ",15,"ت",1,0],["وَنَيِّرِ النَبتِ عَذبٍ بارِدٍ خَصرٍ","كَالأُقحُوانِ عِذابٍ طَعمُهُ رَتِلا",16,"ل",2,0],["وَنيطت أَماني أَهلِ دينِ مُحَمَّدٍ","بِذي سِيَرٍ تُرضي النَبيَّ مُحَمَّدا",17,"د",2,0],["وَنيطت بِعَبد اللَه آمالُ أُمَّةٍ","وَفي ظلّ غازي عَودُ أَيامِها الغرِّ",18,"ر",1,0],["ونيكُ ظبي من النصارى","يزورني كلّ يومِ عيدِ",19,"د",1,0],["وَنيَّةُ الخَيرِ مِثلُ الطَيرِ آبيَّةٌ","صَدرَ الفَتى فَلِيُحاذِر صائِدَ الحَسَدِ",20,"د",1,0],["وَنَيِّرُ اللَيلِ وَشَمسُ الضُحى","داما وَلَكِنَّهُما يَهلَكان",21,"ن",1,0],["ونيوتونُ الحبرُ ثم رِنانٌ","ثم روسّو ومثله فولتير",22,"ر",1,0],["وَنِيطَ بِالرُّعَاةِ كُلُّ مَطْلَبِ","لَيْسَ أَدَاؤُه مِنَ الْيَسِيرِ",23,"ر",1,0],["ونِيّاتُ أهلِ الصّدقِ بِيضٌ نَقِيّة ٌ،","وألسُنُّ أهْلِ الصِدْقِ لاَ تتجلَجُ",24,"ج",1,0],["ونيَّةُ ساسةٍ بَسُطَتْ فبانت","ووجْهُ سياسةٍ جلَّى وكادا",25,"د",2,0],["وَنَيِّر النَّبْتِ عَذْبٍ بَارِدٍ خَصِرٍ،","كَکلأُقْحُوَانِ عِذابٍ طَعْمُهُ رَتِلا",26,"ل",2,0],["ونياق العشاق من كل فج","كدموعي ببابه تترامى",27,"م",2,0],["ونِيطَتْ عُرا الملك من رائِهِ","بِبعض الدَّهاءِ مِعَنٍّ مِفَنْ",28,"ن",1,0],["وَنَيْلُهُمُ بَيْنَ مَهْفَى الشَّمَالْ","وَمَهْفَى الصَّبَا وَالصِّبَا مَا اشْتَهَوْا",29,"و",2,0],["ونيل السها عن غير ادراك حازم","منيع مقام لا يرام منيف",30,"ف",1,0],["وَنِيرانُ الصَّبابَةِ بالغِاتٌ","مُرادَكَ فِيَّ مِنْ قَبْلِ الْفِراقِ",31,"ق",1,0],["وَنيطَ لجيدِ مَن يبغي جزاءً","تَعلم عفّة منه المريدُ",32,"د",1,0],["وَنيطَ إِلى خصر الرّئاسةِ صارم","فللّه عضبٌ عانَق الكرم الأربا",33,"ب",2,0],["وَنِيسانُكَ لي ذِكرٌ","وَفي ذِكرِكَ نِسياني",34,"ن",2,0],["وَنيّراً يَهتدي الساري بِطلعَتِهِ","يَسمو على النيّرين الشَمس وَالقَمَرِ",35,"ر",1,0],["وَنيّة المَرء في الأَعمال غامِضَة","فَليحذر الطَعن فيها الجاهل الوَربُ",36,"ب",1,0],["ونيرانُ الغَضا تَزْدادُ وَقْداً","وتَحْيا بالّتي تُخْبي الذُّبالا",37,"ل",2,0],["وَنيطَت بِهِ الآمال وَالحَرب وَالعُلى","وَليداً وَما نَيطَت عليه مآزِرُهُ",38,"ر",2,0],["وَنيطَ بِهِ أَمر المَظالِمِ إِنَّما","يَنوطُ أَخو العزم الحَمائِل بِالصَدرِ",39,"ر",1,0],["ونَيْلُوفَرٍ قَمِنٍ بالذُّبُولِ","يَرُوقُ فيذبلُ عَمَّا قليلِ",40,"ل",1,1],["ونيطت بآذان الغصون بدَوْحها","شنوف سقيط للزهور تجانس",41,"س",1,0],["ونيطت قلاداتُ الأمور بغيره","وبين الرجال في التحدّث بُونُ",42,"ن",1,0],["ونيطتْ بأخرَى مثلِها فتظاهرا","على طهر طَودٍ في قميِص قضيبِ",43,"ب",1,0],["ونيطَ رقيمٌ فوق زُهْرٍ كأنها","نوارُ نَعامٍ أنكر الإنْسِ جافِلُ",44,"ل",1,0],["ونيروزنا هذا جديد نلاقه","بعفوٍ جديد عن ذنوب شكور",45,"ر",1,0],["وَنِيُّهُ حيثُ اِنتَوى مَنوِيُّ","وَبِالفَرِندادِ لَهُ أُمطِيُّ",46,"ي",1,0],["وَنِيران وَجدي دُونَها بَين أَضلُعي","وَفي كبدي الحرّى شَواظُ سَعير",47,"ر",1,0],["ونيل سلامة نفس وأهل","غدا لجميع الورى منية",48,"ه",1,0],["ونيابة تجري على الشهوات أم","نوب وشورى تلك أم طغيان",49,"ن",1,0],["ونّيت ولا فطن لي","دله القلب الغشيم",50,"م",1,0],["وَنِيَامٌ عَنْهُمْ كَنَوْمةَ أَهْلِ ال","كَهْفِ لَوْلاَ وَصِيدُهُمْ وَالرَّقِيمُ",51,"م",1,0],["ونيران الأسى في القلب شبّت","وهاجت بعدما كانت تهدَّتْ",52,"ت",1,0],["ونَيلُ بني سليمان المعالي","على ما أدركوا منها قديم",53,"م",1,0],["ونيَّفَ عَنْ إِحْدَى وستينَ حِجَّةً","وحاجاتُ نَفْسِي مُولَعَاتٌ بِأَشْياءِ",54,"ا",2,0],["ونيل كل مطلب سنعي","مع اتباع للنبي الامي",55,"ي",1,0],["ونيل جميع ما رمنا ورمتم","بصدق الوعد والظن الجميل",56,"ل",1,0],["ونيل كل القصود","واغفر لنا أجمعين",57,"ن",1,0],["ونيلوفر كالزهر شكلاً ومنظراً","محاسنُهُ فيها اللواحظُ ترتعُ",58,"ع",1,1],["ونيلوفرٍ يحكي النجومَ وماؤهُ","يُحاكي سماها لا يغادرُها وَصفا",59,"ف",2,1],["ونيلة الهندي وزن قفله","واجعل من الكافور ايضا مثله",60,"ه",1,0],["وَنّيت يوم الليل عَسْعَس","ونّات مِستَهوي ومَجبور",61,"ر",1,1],["وني لأرجو أن فيك بقيةً","من البيت تسعى في صلاح منابها",62,"ب",3,0],["ونيتك الأحسانُ في كل مقصد","وتأتي على ما قد نويتَ المقاصدُ",63,"د",1,0],["ونيِّرٌ في سماءِ مجدٍ","بنوه شهبٌ به تلوحُ",64,"ح",1,0],["وَنَيِّرٍ يَلْعَبُ بالنّار","كالصُّبْحِ يرعى القَمَرَ السّاري",65,"ر",2,1],["ونيتهم قد أجْمعُوا عنكِ سَلْوةً","لعشرينَ مَرّتْ من فراقك أو عشر",66,"ر",1,0],["ونيل بالسيف سيف النيل واتصلت","دعوى الجنود فكلّ بالجلاد صلي",67,"ل",2,0],["ونيت وعهدي أن عزمك لا يني","ولكنما قد يربض الليث للوثب",68,"ب",1,0],["ونيسابور في الأرض","كإنسان بإنسان",69,"ن",1,1],["ونيرك لا تترك بسد خروجه","ولا تك ذا جور إذا جئت بالنبر",70,"ر",1,0],["وني لأرعى النجم حتى كأنني","على كل نجم في السماء رقيب",71,"ب",1,0],["ونُيّابى اديب","يقل هذا الكريم",72,"م",1,0],["وَنَى عن نيل شَأُوِك كل ساع","وعاقَتْه الوِهاد عن اليَفَاع",73,"ع",1,1],["ونية صدق في رضى الله أخلصت","سناها بآفاق البَسِيطَةِ قد أضا",74,"ض",2,0],["وَنيتهم صدق وَرَأيهم حجى","وَقَولَهُم فعل وَوَعدَهم نَقد",75,"د",1,0],["ونيل مصر ليس بالمحبوب","فانه المميت للقلوب",76,"ب",1,0],["وَنىّ عَن الفحشا عجول الى الندا","جسور عَلى الاغدا فَصيح اذا روى",77,"و",2,0],["ونيسانُ مَع أيارَ يأتي ربيعُهُم","ويتبعُهُم من بَعدُ شَهرُ حزيرانِ",78,"ن",1,0],["وَنَيُّهُ صَعْبٌ عَلَى الأَضْرَاسِ","وَمَعْدَةٍ ضَعِيفَة فِي النَّاسِ",79,"س",1,0],["ونيسان يداعبها بريحٍ","معطرةٍ بآمال التجار",80,"ر",1,0],["ونية وعلم الانتقال","والاجتماع فاستمع مقالي",81,"ي",1,0],["ونيران توقد في ضميري","فلولا الدمع اتلفني الحريق",82,"ق",1,0],["وَنِيطَت مِن يَوَاقِيتِ المَزَايَا","بشأَجيَادِ الزَّمَانِ لَهُ عُقودُ",83,"د",1,0],["ونيلُ المجدِ في الدُّنيَا جَسِيمٌ","تَقاصَرَ دُونَهُ الهِمَمُ الجِسَامُ",84,"م",1,0],["وَنينَوى إِذ قامَ يَدعو رَبّهُ","مطَهِّراً مِن كُلِّ سوءٍ قَلبَهُ",85,"ه",1,0],["ونيسان ذو الثاية المرتجا","فنعم المرجا لما في الروابي",86,"ب",2,0],["وَنير المَجد لا يخفى عَلى أَحَد","إِلا إِذا نَظر العُميان وَالعور",87,"ر",1,0],["وَنير أفضال فَأَما عُلومه","فَغيث وَأَما ذهنه فَحسام",88,"م",1,0],["وَنيطت فُضول الساعِدَينِ فألحمت","برُسغَينِ لُزّا بالوصول فالحما",89,"م",2,0],["ونيلت بأبي أحمد","آمال اخي الود",90,"د",1,0],["وَنّيتْ مِنْ قَلْبٍ مْعَطَّلْ","تَعْطِيلْ مِنْ بُوْ مِضْمَرٍ طَيّ",91,"ط",2,1],["وَنيلكُم بِحرٌ يَضيقُ لَهُ الفَضا","وَلَو شِئتَ نَشرَ النورُ لَم يُمكِنِ النَشرُ",92,"ر",1,0],["ونيامٌ كما نام العروسُ وتارةً","قِيام كما قام البُزاة أَوْ النَّسْر",93,"ر",1,0],["وَنَيلُ ما تَرتَجيهِ مِن يَدِهِ","ما لَيسَ تَجري بِهِ المَقاديرُ",94,"ر",1,0],["ونيلها العذب فهو 