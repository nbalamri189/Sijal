{"poems":[[53,"وليل تمزق عنه النسي","https://www.aldiwan.net/poem29939.html","المتقارب"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[63,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[63,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[51,"يا أيها السيد الذي غمرت","https://www.aldiwan.net/poem62932.html","الكامل"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[62,"ونيلوفر أعناقه أبدا صفر","https://www.aldiwan.net/poem52402.html","الطويل"],[45,"فداؤك نفسي دون رهطي ومعشري","https://www.aldiwan.net/poem63567.html","الطويل"],[61,"ونى في التصابي بعدما كان شمرا","https://www.aldiwan.net/poem51648.html","الطويل"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem62024.html","الطويل"],[80,"ونيلوفر أوراقه مستديرة","https://www.aldiwan.net/poem31462.html","الطويل"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[81,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[102,"بني هاشم بين المنايا وبينكم","https://www.aldiwan.net/poem32956.html","الطويل"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[46,"خدر العروس وإن كانت محببة","https://www.aldiwan.net/poem22460.html","البسيط"],[46,"إن شئتما أن تنسكا فاسكنا","https://www.aldiwan.net/poem23553.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54834","الرجز"],[49,"خلِيليَّ إنَّ الهمَّ قَدْ يتفرَّجُ","https://www.poetsgate.com/ViewPoem.aspx?id=16977",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[31,"يا صاحبيّ، قفا نستخبرِ الطللا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19020&r=&rc=283",""],[116,"لا تنبه بلوعتي اللواما","https://www.aldiwan.net/poem40595.html","عموديه"],[167,"رعى الله عهد حبيب ظعن","https://www.aldiwan.net/poem46862.html","المتقارب"],[238,"أهاجك بينهم إذ نأوا","https://www.aldiwan.net/poem19741.html","المتقارب"],[262,"محل العلا لولا الدني شريف","https://www.aldiwan.net/poem38231.html","الطويل"],[281,"ألا يا محرقي بالنار مهلا","https://www.aldiwan.net/poem60747.html","الوافر"],[306,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[350,"وجدي بك فقداني","https://www.aldiwan.net/poem15966.html","الهزج"],[354,"خذ في هوى الغيد عني أحسن الخبر","https://www.aldiwan.net/poem40343.html","البسيط"],[354,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[365,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[407,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[407,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[440,"ونيلوفر قمن بالذبول","https://www.aldiwan.net/poem34898.html","المتقارب"],[453,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[459,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[459,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[462,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[514,"فداك اخوك اليوم يوم سرور","https://www.aldiwan.net/poem67678.html","عموديه"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["وَنيلوفَرٍ فَتَّحَتهُ الرِياحُ","وَعانَقَهُ الماءُ صَفواً وَرَنقا",0,"ق",2,0],["وَنى عَنِ السَعيِ فَاِستَرعى مَساعِيَهُ","مُدَرَّباً بِطَريقِ المَجدِ لا يَقِفُ",1,"ف",1,0],["وَنَيلُ الرِزقِ يُؤخَذُ مِن بَعيدٍ","كَنَيلِ الرِزقِ يُؤخَذُ مِن قَريبِ",2,"ب",1,0],["ونِيطَ بكَ الآمالُ لا زالَ يَنتَهي","إليكَ بآمالِ الوَرى كُلّ مَنهَجِ",3,"ج",1,0],["ونِيرانُهُ حَيثُ العِشارُ دِماؤها","تُراقُ ويُذْكيها الوَشيجُ المُكَسَّرُ",4,"ر",1,0],["وَنيطَت حَمائِلُهُ الوافِياتُ","مَكانَ تَمائِمِهِ فَاِحتَمَل",5,"ل",1,0],["وَنَيْلُ الأمَانِي كُلِّهَا دُونَ هَفْوَةٍ","يَسُوءُ بِهَا قَاضٍ مَسُوءاً بِلاَ جُرْمِ",6,"م",1,0],["ونيِّفُ العقد كالسَّنام له","إن جُبّ أبقى بظهره دَبَره",7,"ر",2,0],["وَنَيلَها العَذبُ ما أَحلى مَناظِرَهُ","وَالشَمسُ تَكسوهُ تِبراً في تَواريها",8,"ي",3,0],["ونَيلوفَرٍ أعناقُه أبداً صُفْرُ","كأنَّ بهِ سُكراً وليس به سُكْرُ",9,"ر",1,1],["وَنَيلُكَ هَذا يَشرَكُ النِيلَ مَسمَعاً","وَيَفضُلُهُ مِن بَعدُ في حُسنِ مَنظَرِ",10,"ر",1,0],["وَنَى في التَّصابي بعدَما كان شمَّرا","وقَصَّرَ في شأوِ الزَّمانِ فأقصرَا",11,"ر",2,1],["وَنِيّاتُ أَهلِ الصِدقِ بيضٌ نَقِيَّةٌ","وَأَلسُنُ أَهلِ الصِدقِ لا تَتَلَجلَجُ",12,"ج",1,0],["وَنَيْلُوفَرٍ أوْرَاقُهُ مُسْتَديرَةٌ","تَفَتّحَ فيما بينهنّ لَهُ زَهْرُ",13,"ر",1,1],["ونياحُ ذي كَمَدٍ يذوب بِهِ إِذا","رفع الرثاءُ عقيرةَ الإنشادِ",14,"د",1,0],["وَنيطَت بِحَقوَيهِ الأُمورُ فَأَصبَحَت","بِظِلِّ جَناحَيهِ الأُمورُ اِستَظَلَّتِ",15,"ت",1,0],["وَنَيِّرِ النَبتِ عَذبٍ بارِدٍ خَصرٍ","كَالأُقحُوانِ عِذابٍ طَعمُهُ رَتِلا",16,"ل",2,0],["وَنيطت أَماني أَهلِ دينِ مُحَمَّدٍ","بِذي سِيَرٍ تُرضي النَبيَّ مُحَمَّدا",17,"د",2,0],["وَنيطت بِعَبد اللَه آمالُ أُمَّةٍ","وَفي ظلّ غازي عَودُ أَيامِها الغرِّ",18,"ر",1,0],["ونيكُ ظبي من النصارى","يزورني كلّ يومِ عيدِ",19,"د",1,0],["وَنيَّةُ الخَيرِ مِثلُ الطَيرِ آبيَّةٌ","صَدرَ الفَتى فَلِيُحاذِر صائِدَ الحَسَدِ",20,"د",1,0],["وَنَيِّرُ اللَيلِ وَشَمسُ الضُحى","داما وَلَكِنَّهُما يَهلَكان",21,"ن",1,0],["ونيوتونُ الحبرُ ثم رِنانٌ","ثم روسّو ومثله فولتير",22,"ر",1,0],["وَنِيطَ بِالرُّعَاةِ كُلُّ مَطْلَبِ","لَيْسَ أَدَاؤُه مِنَ الْيَسِيرِ",23,"ر",1,0],["ونِيّاتُ أهلِ الصّدقِ بِيضٌ نَقِيّة ٌ،","وألسُنُّ أهْلِ الصِدْقِ لاَ تتجلَجُ",24,"ج",1,0],["ونيَّةُ ساسةٍ بَسُطَتْ فبانت","ووجْهُ سياسةٍ جلَّى وكادا",25,"د",2,0],["وَنَيِّر النَّبْتِ عَذْبٍ بَارِدٍ خَصِرٍ،","كَکلأُقْحُوَانِ عِذابٍ طَعْمُهُ رَتِلا",26,"ل",2,0],["ونياق العشاق من كل فج","كدموعي ببابه تترامى",27,"م",2,0],["ونِيطَتْ عُرا الملك من رائِهِ","بِبعض الدَّهاءِ مِعَنٍّ مِفَنْ",28,"ن",1,0],["وَنَيْلُهُمُ بَيْنَ مَهْفَى الشَّمَالْ","وَمَهْفَى الصَّبَا وَالصِّبَا مَا اشْتَهَوْا",29,"و",2,0],["ونيل السها عن غير ادراك حازم","منيع مقام لا يرام منيف",30,"ف",1,0],["وَنِيرانُ الصَّبابَةِ بالغِاتٌ","مُرادَكَ فِيَّ مِنْ قَبْلِ الْفِراقِ",31,"ق",1,0],["وَنيطَ لجيدِ مَن يبغي جزاءً","تَعلم عفّة منه المريدُ",32,"د",1,0],["وَنيطَ إِلى خصر الرّئاسةِ صارم","فللّه عضبٌ عانَق الكرم الأربا",33,"ب",2,0],["وَنِيسانُكَ لي ذِكرٌ","وَفي ذِكرِكَ نِسياني",34,"ن",2,0],["وَنيّراً يَهتدي الساري بِطلعَتِهِ","يَسمو على النيّرين الشَمس وَالقَمَرِ",35,"ر",1,0],["وَنيّة المَرء في الأَعمال غامِضَة","فَليحذر الطَعن فيها الجاهل الوَربُ",36,"ب",1,0],["ونيرانُ الغَضا تَزْدادُ وَقْداً","وتَحْيا بالّتي تُخْبي الذُّبالا",37,"ل",2,0],["وَنيطَت بِهِ الآمال وَالحَرب وَالعُلى","وَليداً وَما نَيطَت عليه مآزِرُهُ",38,"ر",2,0],["وَنيطَ بِهِ أَمر المَظالِمِ إِنَّما","يَنوطُ أَخو العزم الحَمائِل بِالصَدرِ",39,"ر",1,0],["ونَيْلُوفَرٍ قَمِنٍ بالذُّبُولِ","يَرُوقُ فيذبلُ عَمَّا قليلِ",40,"ل",1,1],["ونيطت بآذان الغصون بدَوْحها","شنوف سقيط للزهور تجانس",41,"س",1,0],["ونيطت قلاداتُ الأمور بغيره","وبين الرجال في التحدّث بُونُ",42,"ن",1,0],["ونيطتْ بأخرَى مثلِها فتظاهرا","على طهر طَودٍ في قميِص قضيبِ",43,"ب",1,0],["ونيطَ رقيمٌ فوق زُهْرٍ كأنها","نوارُ نَعامٍ أنكر الإنْسِ جافِلُ",44,"ل",1,0],["ونيروزنا هذا جديد نلاقه","بعفوٍ جديد عن ذنوب شكور",45,"ر",1,0],["وَنِيُّهُ حيثُ اِنتَوى مَنوِيُّ","وَبِالفَرِندادِ لَهُ أُمطِيُّ",46,"ي",1,0]]}