ctabudhabi.ae/diwan/poem/128687","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103908","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91715","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132143","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85163","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128881","المجتث"],[3785,"","https://poetry.dctabudhabi.ae/diwan/poem/107317","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29307","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136611",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83529","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83521","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83670","الكامل"],[4691,"القمران إهداء لشريفة العلوي","https://www.poetsgate.com/ViewPoem.aspx?id=98866",""],[4702,"فارس البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=155326",""],[4764,"شيخة الظبيان","https://www.poetsgate.com/ViewPoem.aspx?id=24834",""],[4767,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=91943",""],[4888,"عشرون عاما من العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=207743",""],[4908,"في ضيافة المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=207330",""],[4119,"أبرق في الثغور من الثغور","https://www.poetsgate.com/ViewPoem.aspx?id=16161",""],[5092,"تُسائلني إجاباتي","https://www.poetsgate.com/ViewPoem.aspx?id=139682",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5187,"بوم النصر","https://www.poetsgate.com/ViewPoem.aspx?id=29242",""],[5246,"أين الأثافي وأين النُؤْيُ والطلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187075",""],[5266,"جَوَى الْوَطَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=210298",""],[5277,"شعارُ الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=204180",""],[5431,"إلى أم الدنيا-الى مصر الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=191005",""],[5574,"على أرض الخلود - ذكرى ترفرف","https://www.poetsgate.com/ViewPoem.aspx?id=205995",""],[5848,"حلم با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=53185",""],[6125,"جُنَاةُ الأمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=210567",""],[6228,"فيض الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85976&r=&rc=13",""],[2220,"إذا طلعَ البدرُ المنيرُ عشاءً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11133&r=&rc=7",""]],"verses":[["عَلى إِرثِ مَجدِ الأَوَّلينَ تَعَلَّقوا","ذَوائِبَ أَعناقِ العُلى وَالمَناصِبِ",0,"ب",1,0],["على أرْحَبيّاتٍ مَرَقْنَ منَ الدُّجى","وقد لَغِبَ الحادي مُروقَ سِهامِ",1,"م",1,0],["على أريحيٍّ مذْ سمعتُ بذكرهِ","أُغالبُ فيهِ الشوقَ والشوقُ أَغلَبُ",2,"ب",1,0],["على أرْجائِها نُقَطُ المَنايا","مُلَمَّعَةً بها تَلْيمعَ شامِ",3,"م",1,0],["علّي أَرى لي فيها","لليل هميَ فجرا",4,"ر",2,0],["عَلى إِرَمٍ وَأَحجارٍ وَصيرٍ","وَأَغصانٍ مِنَ السَلَماتِ سُمرِ",5,"ر",1,0],["علي أرى في الروض من يفضي","إليّ بسرّه وأبثّه أسراري",6,"ي",1,0],["عليا رجال فارقوا خفض عيشهم","فما صدفتهم عنك زهرة زخرف",7,"ف",1,0],["عَلِّي أَرى أَهلَها مِن بَعدِ بُعدِهِمُ","كَما رَأى عَرشَ بَلقيسٍ سُلَيمانُ",8,"ن",1,0],["عَلى أَرجائِهِنَّ مِراطُ ريشٍ","تُشَبِّهُها مَشاقِصُ ناصِلاتِ",9,"ت",1,0],["على أرضِ العفافِ لَنا لقاءٌ","يُسَرُّ بما يَرى فيه الصَّديقُ",10,"ق",1,0],["عَلِّي أَروحُ وأَغدو في معاهِدِها","كما عَهِدْتُ سَقَاها الرَّائحُ الغادي",11,"د",2,0],["على أرَجِ الثرى لما ضَللنا","تضوَّعَ منه في الأنفاس هادي",12,"د",2,0],["على أَرْسَلانَ والجِيلِيِّ قد ضربَتْ","خِيامُهُ بعدَ عزَّازٍ ومَهْيوبِ",13,"ب",1,0],["على أرضِ نجدٍ والحجاز بمنْهجٍ","لعهدِ العُتاةِ من قريشٍ مُجَدِّدا",14,"د",2,0],["عَلى أَرجائِها الغُرُّ","تَهَديِّها بِمِصباحِ",15,"ح",1,0],["على أركانِهِ نصرٌ عَزِيزٌ","وفي أبوابهِ فتحٌ قَريبُ",16,"ب",1,0],["عَلّي أُراجِعُ مِنْ ذَماي حشاشَةً","أشكو بها بَعْضَ الذي أنا لاقِ",17,"ق",1,0],["عَلَى ارْسُمٍ قَدْ غَابَ عَنْهَا حَبيبُهَا","قِفَا نَبْكِ مِنْ ذِكْرِي حَبِيبٍ وَأرْسُمِ",18,"م",1,0],["على ارْتكابِ ذُنوبٍ","لم يُحْصِها وَصْفُ واصفْ",19,"ف",1,0],["على أرحييات طوى السير فانطوت","شمائلها مما تحَلّ فترحَلُ",20,"ل",1,0],["على أرض طه في سحائب كافها","بغيث مغيث من سماوات طاسين",21,"ن",1,0],["علي إرق على عرش العلاء وطل","فخراً بعرس حكى بالحسن بلقيسا",22,"س",2,1],["عَلَى أربَعٍ قَامَتْ وإن كَانَ شِبهَهَا","مِنَ الغِيدِ يَكفِي في مَلاحَتِهِ قَدُّ",23,"د",1,0],["علياً رفيعاً ذا عماد وقوّة","بلا عمد حتى يكون سَماء",24,"ا",2,0],["على أرى وصل من أهوى يجود به","دهري ويأنس ربع بعدهم خال",25,"ل",1,0],["على أرجائِه مني سلامُ","يدومُ لديهِ ما سَكَبَ الغَمامُ",26,"م",1,1],["على أربع قد كان دهراً بطوله","للهوك فيه مريع ومجالس",27,"س",1,0],["عَلّي أرى خلاً يودّ إِذا جفوا","وَيصح جسمي وَصله إِن أَمرضوا",28,"ض",3,0],["على أرباض قرطبة سلام","كأنفاس الزنابق في رباها",29,"ا",3,1],["عل يا ريح الصبا أن يعطفوا","كي بهم تنحل عن كل عقده",30,"د",2,0],["على أريكة حكم","مزملا بوقاره",31,"ه",1,0],["عَلى أروَع وافي الذِمَامِ مُحَبَّبٍ","مَنِيع جِوارٍ لَم يَخِب قَطُّ سَائِلُه",32,"ل",2,0],["عَلّي أَرى شَبَهاً يَحكيكِ في دَعَةٍ","أَو خِفَةٍ أَو جَمالٍ مِنكِ فَتّانِ",33,"ن",1,0],["على أرطميس انثنت بالخطاب","تعنفها بشديد السباب",34,"ب",1,0],["على أرض الغري سلامُ صبٍ","بثَغر الوَجد يمضغُه الرَحيل",35,"ل",1,0],["عَلّي أَرى قبلَ المَماتِ لواءَه ال","عالي يرفُّ لآخر الدورانِ",36,"ن",1,0],["عَلِّي أَرى منكَ وَجهاً يَستَضيءُ بهِ","وجهُ الزَمانِ فتَبدو لِلزَمانِ غُرَر",37,"ر",1,0],["عَلّي أَراهُ حَقيقَةً في هالَةٍ","من صحبه الأَخيارِ خيرِ أَكارِمِ",38,"م",1,0],["على أرجوحة الإبداع يلهو","وتخطبهُ اللآلئ في البحار ِ",39,"ر",1,0],["على ارضٍ ترتجي وبل السحايب قفر محتظره","بها الوديان بين جبالها والقيظ مخنوقه",40,"ق",2,0],["عَلى أرضِج .. كويت العِز .. نَثرت الورد بأنواعه","أبي أوصف مدى شَوقي لموجِ الودِ والشِطآن",41,"ن",1,1],["على أرض تناديكم لخير","به لم يبق بيت ما استنارا",42,"ر",2,0],["على أرائِكها البيضاءِ مُتّكئٌ","تفوحُ منه \"الضُّحى\" و\"النّاسُ\" و\"العَلَقُ\"",43,"ق",1,0],["على أرضنا الثكلى أقاموا شذوذَهم","وخانوا الهدى...كفرٌ بكلِّ المذاهب",44,"ب",1,0],["على أردافها قضبان بان","تميس بفاتنات اللحظ حور",45,"ر",1,0],["على أرض النوى باقٍ","وأحزاني سفيراتي",46,"ت",2,0],["على أرض باريس السّلام فأنني","أبلغها عمّا قريب وداعيا",47,"ي",2,0],["على أرضِ السّلامِ أتى الدّمارُ","وليلُ الذّلِّ طالَ به المَدارُ",48,"ر",1,1],["علّي أرى من أحباي الأولى سكنت","نفسي بجانبهم والصفو مكتمل",49,"ل",1,0],["عَلَى أَرْضِكَ الْعُظْمَى تَسَلَّتْ طَفُولَتِي","فَفِيكَ الصّبَا يَوْمًا شَدَا وَتًرَنَّمَا",50,"م",2,0],["على أرضِ العراقِ ورافديهِ","تبارى في محبتة الحيارى",51,"ر",2,0],["على أرضٍ تقدس قاطنوها","لأن الله قد أعطاه قدرا",52,"ر",2,0],["١- على أرضِ الخلود سمَتْ حمامهْ","بها ذكرى تُطوِّقُها السّلامهْ",53,"م",2,1],["على أريكتها تعيش الأماني","تحلم بها لو تجلس بكل تحنان",54,"ن",1,0],["عَلَى أَرضِ الشَّآمِ نَزَفتُ دَمِّي","وأَوصَالِي تُمَزِّقُها اليَهُودُ",55,"د",1,0],["على أرض “القرينة” فيضُ وجدٍ","جرى بقلوبنا شهداً عِذابا",56,"ب",2,0],["علياً رفيعاً ذا عماد وقوّة","بلا عمدٍ حتّى يكونَ صماءَ",57,"ا",2,0]]}