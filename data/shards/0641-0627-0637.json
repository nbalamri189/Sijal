oem63882.html","الطويل"],[50,"أرسلت خلتي من الدمع غربا","https://www.aldiwan.net/poem64795.html","الخفيف"],[46,"أرى كفرطاب أعجز الماء حفرها","https://www.aldiwan.net/poem22649.html","الطويل"],[46,"إذا ما شئتم دعة وخفضا","https://www.aldiwan.net/poem23487.html","الوافر"],[46,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[46,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85433","الطويل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6788","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116953","الرمل"],[77,"تلافيت نصر الدين إذ كاد يتلف","https://www.poetsgate.com/ViewPoem.aspx?id=34179",""],[98,"سلمى الكورانية","https://www.poetsgate.com/ViewPoem.aspx?id=53904",""],[91,"الضفادع والنجوم","https://www.poetsgate.com/ViewPoem.aspx?id=53280",""],[91,"حكمة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=53180",""],[105,"يقولون لي ماذا قرأت لعلهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54948&r=&rc=118",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["فَأَطِع حُكمَ السُرورِ وَإِن","زُخرِفَت فيهِ الأَضاليلُ",0,"ل",1,0],["فأطْنابُهُ أسيافُهُ وعِمادُهُ","رُدَيْنِيَّةٌ مُلْسُ الأنابيبِ مُرّانُ",1,"ن",1,0],["فأطفأت شهب (الميراج) أنجمنا","وشمسنا... وتحدى نارها الحطب",2,"ب",1,0],["فَأَطْلَعْتُهَا تَفْتَرُّ عَنْ شَنَبِ الْمُنَى","وَتُسْفِرُ عَنْ وَجْهٍ مِنْ السَّعْدِ حُسَّانِ",3,"ن",1,0],["فَأَطلَقَ عَن مَجنوبِها فَاِتَّبَعنَهُ","كَما هَيَّجَ السامي المُعَسِّلُ خَشرَما",4,"م",2,0],["فَاِطلُبوا العِلمَ وَلَو جَشَّمَكُم","فَوقَ ما تَحمِلُ أَطواقُ البَشَر",5,"ر",1,0],["فَأَطلَقتَهُ مِن قَيدِهِ وَأَقَلتَهُ","وَما كانَ في تِلكَ السَعادَةِ يَطمَعُ",6,"ع",1,0],["فَاِطمَئِنّي أُمَمَ الشَرقِ وَلا","تَقنَطي اليَومَ فَإِنَّ الجَدَّ قاما",7,"م",2,0],["فَأَطَفنا بِها وَقَد مَلَأَ الأَن","فُسَ مِنّا جَلالُ ذاكَ المَقامِ",8,"م",1,0],["فَاِطرَح مَعاذيرَ السُكوتِ وَقُل لَنا","هَلّا وَجَدتَ إِلى الكَلامِ سَبيلا",9,"ل",2,0],["فَأَطلَعتَها شَوقِيَّةً لَو تَنَسَّقَت","مَعَ النَيِّراتِ الزُهرِ خُصَّت بِمَطلَعِ",10,"ع",1,0],["فَأَطوَلُهُم بِالأَيادي يَداً","وَأَثبَتُهُم في المَعالي قَدَم",11,"م",1,0],["فَأَطعَنُهُ وَقُلتُ لَهُ خُذَنَّه","مُشَوَّهَةً تَبجِسُ بِالدِماءِ",12,"ا",2,0],["فَأَطِيرُ مِنْ شَغَفِي إِلَيْكَ تَشَوُّقاً","وَأَبُلُّ غُلَّةَ قَلْبِي الظَّمْآنِ",13,"ن",1,0],["فَأُطْلِقُ القَوْلَ فِي تَأْبِينِ مُرْتَحِلٍ","مُسْتَكْمِلِ الزَّادِ مِنْ فَضْلٍ وَإِحْسَانِ",14,"ن",1,0],["فَأَطْعِمُوهُ وَأَوْفُوا دَيْنَ صَاحِبِكُمْ","وَلا تُرِيحُوهُ فِي يَوْمٍ مِنَ التُّخَمِ",15,"م",1,0],["فأطرق رأسَه خجلاً وأغضى","وقال ودمع عينيه سَكوب",16,"ب",1,0],["فأطلق من مسدسه رصاصاً","به في الرمي تنخرق الجسوم",17,"م",1,0],["فأطربني والديك مشجٍ صياحه","ترنّم عصفور يزقزق في وكر",18,"ر",1,0],["فاطْلب رفده إذا كنت ممَّن","يرتقي كائناً على كيوان",19,"ن",1,0],["فأطلتُ المديحَ ما طال فيهم","مع أنِّي قصَّرتُ غيرَ معيبِ",20,"ب",1,0],["فاطرُدْ ليَ الحرفةَ وادعُ الغِنى","واذكر سُموطاً كنت ألَّفْتُها",21,"ت",3,0],["فاطْرَبْ على ذاك عندَ مُغْتَبَقٍ","واطربْ على ذاك عند مُصْطَبَح",22,"ح",1,0],["فأطفأ نيران الغليل مَواطرٌ","مُضرَّمةٌ نيرانها في وقودِها",23,"د",3,0],["فأطربني ما قلت حتى استخفّني","كأن سماعاً هز عِطفيَّ أو خمرا",24,"ر",2,0],["فاطلب لإرث الشقيّ عنك غداً","مستودِعاً إن أثرت أو فَذَر",25,"ر",1,0],["فاطلبْ لقاء أبي الحسين ولا","يَلفِتْكَ عنه القُلُّ والكُثرُ",26,"ر",1,0],["فاطو مَبْسوط كلّ أرضٍ إلى المبْ","سوطِ من فَضْلِهِ الطُوال العراض",27,"ض",1,0],["فاطلب رضاه وأيقن أن سخطته","لا حرز منها إذا طوفانها طافا",28,"ف",2,0],["فاطلب القلب والذين سبوه","عائقاً كل عائق أن يعوقا",29,"ق",2,0],["فأطلتُ إيفاءً لمجدك حقَّهُ","بل لستُ فيك وإن أطلتُ مُطيلا",30,"ل",2,0],["فاطوِ كشحاً عن الثوابِ لديه","والتمسْ نيل ماجدٍ منه نالِ",31,"ل",1,0],["فأطاع الإلهَ غيرَ مَهين","واتقاه تُقاةَ غير جبان",32,"ن",1,0],["فَأَطيِب بِراحِ الشَأمِ صِرفاً وَهذِهِ","مُعَتَّقَةً صَهباءَ وَهِيَ شِيابُها",33,"ب",3,0],["فَأَطرَقَ ذاكَ الإِلَهُ الفَتِيُّ","وَفي نَفسِهِ أَلَمٌ مُستَتِر",34,"ر",1,0],["فَأَطلِق يَراعَكَ يَنطَلِق خَبَباً","وَاِحلُل لِسانَكَ يَحلُلِ العُقَدا",35,"د",2,0],["فَأَطرَقتُ أَمشي في سُطورِ كِتابِهِ","بِطَرفي فَأَلفَيتُ السُطورَ تَقولُ",36,"ل",1,0],["فَاِطلُبِ اللَهوَ مِثلَما تَطلُبُ الأَط","يارُ عِندَ الهَجيرَ ظِلّاً ظَليلا",37,"ل",2,0],["فَاِطرُدوهُم وَاِطرُدوا اللَيلَ مَعاً","إِنَّهُ مِثلَهُمُ باغٍ أَثيم",38,"م",1,0],["فَأَطرَقَ غَيرُ مُكتَرِثٍ","وَتَمتَم خاشِعاً أُمّي",39,"ي",1,0],["فَأَطلَعَت فِرزَةَ الآجامِ جافِلَةً","لَم تَدرِ أَنّى أَتاها أَوَّلُ الذُعُرِ",40,"ر",1,0],["فأَطْبَقَتْ حَوْلَكَ الدَّياجِي","وغامَ مِنْ فوْقِكَ الغَمَامْ",41,"م",1,0],["فأطارَتْهُ إلى النَّهْرِ الرِّياحُ العاتِياتْ","فَهو في التيَّار أوراقٌ وأعوادٌ عُراةْ",42,"ه",1,0],["فأطرقت خجلا من عتبه وجرى","دمع الندامة لا ترقا بوادره",43,"ر",2,0],["فَاِطلُبِ البيدَ وَاِرضَ بِالعُشبِ قوتاً","فَهُناكَ العَيشُ الهَنِيُّ الحَلالُ",44,"ل",1,0],["فَأَطلَعَ لِلإِسلامِ وَالمُلكِ كَوكَباً","مِنَ النَصرِ في داجٍ مِنَ الشَكِّ مُظلِمِ",45,"م",1,0],["فاطِمُ مَن يولَدُ يَمُت","المَهدُ جِسرُ المَقبَرَه",46,"ر",2,0],["فَاِطلَع عَلى دارِ السَعادَةِ وَاِبتَهِل","في بابِها العالي وَأَدِّ أَلوكي",47,"ك",2,0],["فَاِطلُبِ العِزَّ في لَظى وَذَرِ الذُل","لَ وَلَو كانَ في جِنانِ الخُلودِ",48,"د",1,0],["فاطلبوا الملح باجتها","د ولو كان في سقر",49,"ر",1,0],["فاطن لما وضع الحكيم لنا","فيما حكاه فإنه الغنمُ",50,"م",1,0],["فأطمعُ في كلِّ صعبِ القِيادِ","وأطلبُ كلَّ منيعِ المَرامِ",51,"م",1,0],["فَاِطلُب بِعَينِكَ أَيَّةً لَحِقَت","ضَوءَ الغَزالَةِ أَينَ مُنقَطَعُه",52,"ع",2,0],["فَأَطَلَّ الفِراق فَإِجتَمَعا في","هِ فِراقٌ أَتاهُما بِاِتِّفاقِ",53,"ق",1,0],["فَاِطرَح بِعَينِكَ هَل تَرى أَحداجِهِم","كَالدَومِ حينَ تُحَمَّلُ الأَخدارُ",54,"ر",1,0],["فاطَّرَدَ الماءُ على أرجائِه","ونارُه من كلِّ أفقٍ تَضطَرِمُ",55,"م",1,0],["فأطَلَقتْ فيها وفي بَعْلِها","كلَّ لسانٍ كانَ مَحبوسا",56,"س",2,0],["فأَطيحُ في نَفسٍ أُصعِّدُه","وأعومُ في دَمْعٍ أُحدِّرُه",57,"ر",2,0],["فاطْلُبِ المكرُماتِ بالحمدِ منه","تَجِدِ الحمدَ عندَه مَطلوبا",58,"ب",2,0],["فاطِمُ ذاتَ المَجدِ وَاليَقينِ","يا بِنتَ خَيرِ الناسِ أَجمَعين",59,"ن",1,1],["فاطِمُ بِنت السَيِّدِ الكَريم","بِنت نَبيٍّ لَيسَ بِالذَميم",60,"م",1,1],["فاطِمُ يا بِنتَ النَبِيِّ أَحمَدِ","بِنتَ نَبِيٍّ سَيِّدٍ مُسَوَّدٍ",61,"د",1,1],["فَاِطلُب فَدَيتُكَ عِلماً وَاِكتَسِب أَدَباً","تَظفَر يَداكَ بِهِ وَاِستَعجِلِ الطَّلَبا",62,"ب",2,0],["فَاِطرُد لَنا وَهمَ الحَوا","دِثِ بِالكُمَيتِ الخَندَريسِ",63,"س",1,0],["فَأَطلَقَ البابَ إِذناً في الدُخولِ لَنا","وَقالَ هَذا عَلَينا بَعضُ ما وَجَبا",64,"ب",2,0],["فَأَطلَقنا فَمَ الإِبريقِ فيهِ","وَباتَ الزَقُّ مَغلولَ اليَدَينِ",65,"ن",1,0],["فَأَطلَعَ في اللَيلِ","شَمسَ الضُحَيّا",66,"ي",2,0],["فاطَّرحتُ الهمومَ والأعباءَ","ونسيتُ العذابَ والبرحاءَ",67,"ا",2,0],["فأطاع مسروراً كعا","دته ولم يسأَل لأَينا",68,"ن",2,0],["فاطوِ العجاجَ بكلّ يَعمُلَةٍ لها","عَوْمُ السفينةِ في سرابِ السَّبْسَبِ",69,"ب",1,0],["فاطوِ السرائرَ في الجنبَينِ تحجنها","عنِ اللِّسانِ الَّذي للسَّمْعِ يَنشرها",70,"ه",2,0],["فاطوِ رواقَ الظّلامِ عن أُفُقٍ","تُنْشَرُ فيه مُلاءَة الصبحِ",71,"ح",1,0],["فَأَطلِق مِن عِقالِيَ في الأَماني","وَمِن عُقُلِ القَوافي وَالمَطِيِّ",72,"ي",1,0],["فَاُطلُب هُدوءاً بِالتَقَلقُلِ وَاِستَثِر","بِالعيسِ مِن تَحتِ السُهادِ هُجودا",73,"د",2,0],["فَاطْلُبْ لِنَفْسِكَ غَيْرِي إِنَّنِي رَجُلٌ","يَأْبَى لِيَ الْغَدْرَ أَخْوَالٌ وَأَعْمَامُ",74,"م",1,0],["فَاطْمَحْ بِطَرْفِكَ هَلْ تَرَى مِنْ أُمَّةٍ","خَلَدَتْ وَهَلْ لاِبْنِ السَّبِيلِ مُقَامُ",75,"م",1,0],["فاطرُ القلبِ كم سبى زمراً مِنْ","شعراءَ بنورِ ذاكَ الجبينِ",76,"ن",1,0],["فَأَطلَعَ مِن داجي دُخانٍ بَنَفسَجاً","جَنِيّاً وَمِن قاني شُواظٍ لَهُ وَردا",77,"د",2,0],["فَاِطلَع لِرَوضَتِها صَباحاً نَيِّراً","يَستَضحِكُ النُوّارُ لِلأَنوارِ",78,"ر",1,0],["فَأَطَلتُ عَضَّ أَنامِلي أَسَفاً عَلى","زَمَنٍ خَلا مِنهُ قَصيرُ الباعِ",79,"ع",1,0],["فَأُطرِقُ حيناً ثُمَّ أَرفَعُ هامَتي","أَقُصُّ مِنَ الأَنباءِ ما لَستُ واعِيا",80,"ي",2,0],["فَاِطلَع بِأُفقِ الفَخرِ شَمسَ رِياسَةٍ","وَالشَرقُ يَحسِدُ في سَناكَ المَغرِبا",81,"ب",2,0],["فَاِطرَح بِطَرفِكَ هَل تَرى أَظعانَهُم","وَالكامِسِيَّةُ دونَهُنَّ فَثَرمَدُ",82,"د",1,0],["فَأَطعَنُهُ بِمَسنونٍ طَريرٍ","عَلَيهِ مِثلُ بارِقَةِ الهِلالِ",83,"ل",1,0],["فأطالوا فيه التردُّدَ وَالرَّي","بَ فقالوا سِحْرٌ وقالوا افتراءُ",84,"ا",2,0],["فأَطاعته الملوكُ اضطِراراً","وأَجابَتْهُ الحُصونُ اضطرابا",85,"ب",2,0],["فاطْرَبْ لتَسْبِيحِ الحَصَى في كَفِّهِ","فَمِنَ السَّماعِ لِذِكْرِهِ ما يُطرِبُ",86,"ب",1,0],["فَأُطْفِئَتِ النارُ التي وَقَفَ الوَرَى","حَيَارَى لَدَيْهَا لم يُعيدوا ولم يُبْدُوا",87,"د",3,0],["فاطرَب إِذَا غَنَّى الحَدِيدُ فخيرُ ما","سَمِعَ المَشُوقُ إلى النِّزالِ صَليلا",88,"ل",2,0],["فأطردَت خيلُ حبيبي وقد","أقلَّها الرَّكضُ وَخَفق البُنود",89,"د",1,0],["فَأَطيَبُ مِنهُ صافِيَةٌ شَمولٌ","يَطوفُ بِكَأسِها ساقٍ أَديبُ",90,"ب",1,0],["فَأَطلَقَ عَن نابَيهِ وَانكَبَّ ساجِداً","لَنا وَهوَ فيما قَد يَظُنُّ مُصيبُ",91,"ب",1,0],["فَاِطلُبوا لي اِسماً سِواهُ","وَأَجِدّوا في طِلابِه",92,"ب",2,0],["فَأَطَفنا بِنَواحي","هِ وَلَم نَعرِض لِدارِه",93,"ر",2,0],["فَاِطبُخِ الراحَ بِشَمسٍ","فَكَفى بِالشَمسِ نارا",94,"ر",2,0],["فَأَطلَقَ عَن أَبوابِهِ غَيرَ هائِبٍ","وَأَطلَعَ مِن أَزرارِهِ قَمَراً بَدرا",95,"ر",2,0],["فَأُطعِمُكُم بِهِ لَحماً","مِنَ الوَحشِ وَأَطيارِ",96,"ر",1,0],["فَأَطعِم وَكُل مِن عارَةٍ مُستَرَدَّةٍ","وَلا تُبقِها إِنَّ العَوارِيَّ لِلرَدِّ",97,"د",1,0],["