,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[4615,"يا عمروُ أينَ عُمَيْرٌ من كُدَى يَمَنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=17825",""],[5861,"هسيس الروح","https://www.poetsgate.com/ViewPoem.aspx?id=215789",""],[5952,"إنَّهمْ زَبَدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197203",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"تحيتك الجليلة نهرُ نيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=193349",""],[5956,"كمُنتَظِر النسائم أن تهبّا","https://www.poetsgate.com/ViewPoem.aspx?id=194389",""],[5956,"من الموت أنهض","https://www.poetsgate.com/ViewPoem.aspx?id=194662",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6035,"لادامت لكم نِعمُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175082",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["مِنَ المُزنِ حَمحامٌ إِذا اِلتَجَّ لُجَّةً","أَضاءَت تَواليهِ زِنادَ البَوارِقِ",0,"ق",1,0],["مِنَ المُزنِ رَجراجُ العُبابِ كَأَنَّهُ","مِنَ البُطءِ تَرجافُ الكَسيرِ المُقَوَّدِ",1,"د",1,0],["مِنَ المُطعَمينَ المَجدَ بِالبيضِ وَالقَنا","مِلاءَ المَقاري وَالعَريبُ غَوارِثُ",2,"ث",1,0],["منَ المَزْيَدِيّينَ الإِلى في جَنابِهمْ","لمُلتَمِسي المَعْروفِ أهلٌ وأوطانُ",3,"ن",1,0],["مِنَ المَزيَديّينَ الذينَ نَداهُمُ","لِمُسْتَمطِريهِ لا بَكِيٌّ ولا نَزْرُ",4,"ر",1,0],["مِنَ المُمسِكاتِ لا تُرى غَيرَ أَنَّهُ","مَتّى حانَ يَوماً زينَةُ الناسِ تَلبَسِ",5,"س",1,0],["مَنِ المُداوي إِذا ما عِلَّةٌ عَرَضَت","مَنِ المُدافِعُ عَن عِرضٍ وَعَن نَشَبِ",6,"ب",1,0],["مِنَ الماءِ لَوناً واحِداً فَتَشابَهَت","وَغَيرَ أَلوان الجِيادِ حَميمُها",7,"م",3,0],["مَن المَلِيكُ الَّذِي تَثْنِي جَلالَتُهُ","عَنْهُ وَيَمْضِي فَمَا يَثْنِيهِ مِنْ ثَانِ",8,"ن",1,0],["مِنْ آلِ مَلُّوكَ مَيْمُونٍ نَقِيبَتُهُ","عَدَاهُ ذَمٌّ وَلا يُلْفَى لَهُ شَانِي",9,"ن",2,0],["مِنَ المَعمَرِيّينَ الَّذينَ تُخُيِّروا","لِرَفدِ القُرى وَالريحِ صافٍ بَليلُها",10,"ل",3,0],["مِن المُؤَلِفاتِ الرَملِ أَدماءُ حُرَّةٌ","شُعاعُ الضُحى في مَتنِها يَتَوَضَّحُ",11,"ح",1,0],["مِن آلِ مَروانَ ما اِرتَدَّت بَصائِرُهُم","مِن خَوفِ قَومٍ وَلا هَمّوا بِإِلحادِ",12,"د",1,0],["مِنَ المُحمِياتِ الغيلِ غيلِ خَفِيَّةٍ","تَرى تَحتَ لَحيَيهِ الفَريسَ المُعَفَّرا",13,"ر",2,0],["مِنَ المَهاري الَّتي لَم يُفنِ كِدنَتَها","كَرُّ الرَوايا وَلَم يُحدَجنَ في العيرِ",14,"ر",1,0],["مَنِ المانِعونَ السَبيَ لا تَمنَعونَهُ","وَأَصحابُ أَعلالِ الرَئيسِ المُكَبَّلِ",15,"ل",1,0],["مِنَ المُسبِلينَ الرَيطَ لَذٍّ كَأَنَّما","تَشَرَّبَ ضاحي جِلدِهِ لَونَ مُذهَبِ",16,"ب",1,0],["من المعصفات الهوج في عرصاتها","زعازع يكسون البلى رسمها جَفَلْ",17,"ل",1,1],["مِن المُصمَئِلاتِ الدَّآلِيلِ قد بَدَا","لِذِي اللُّبِّ منها بَرقُها المُتَخَيِّلُ",18,"ل",1,0],["من المصمئلات الدلائل قد بدا","لدى اللب منها ترقها المتخيل",19,"ل",1,0],["مِنَ الموخِداتِ الضُمَّرِ اللاءِ وَخدُها","كَفيلٌ بِحاجاتِ الرِجالِ ضَمينُ",20,"ن",1,0],["مَنِ المُؤثِرونَ وَالخَصاصَةُ فيهِمُ","عَلى كُلِّ ذي قُربى عَظيمِ الأَواصِرِ",21,"ر",1,0],["من آل مروانَ ويمناه في","حبِّ العطايا من بني عذرَه",22,"ر",2,0],["من المعشر السامين كادَ وَليدهم","يقول لنظَّام المدائح ناغوا",23,"غ",3,0],["من المغلّ أشكو نحوهُ ألم الهوى","وطبّ الهوى عندِي كما قيل بالمغلي",24,"ل",2,0],["من المالكي رقّ المديح بنائلٍ","كأن بحار الأرض في الجودِ آله",25,"ل",2,0],["من المزيريب أسري","أريد وادي فحمه",26,"م",2,0],["من المُصْعَبيين الذين تفرَّعوا","شَمَاريخَ أطْوادٍ من المجد شُمَّخا",27,"خ",2,0],["من المبْشرين المؤْدمِين خلائقاً","له تحت أيدي اللامسين مَلامس",28,"س",1,0],["مِن آلِ مَروانَ فَيّاضُ العَطاءِ إِذا","أَمسى السَحابُ خَفيفَ القَطرِ كَالصَرِمِ",29,"م",1,0],["مِنَ المُصطَلينَ الحَربَ أَيّامَ قَلَّصَت","بِنا وَبِقَيسٍ عَن حِيالٍ وَعَن نَزرِ",30,"ر",1,0],["مِنَ المائِلاتِ الغيدِ وَهناً وَإِنَّها","عَلى صُرمِهِ أَو وَصلِهِ لَغَفولُ",31,"ل",1,0],["مِنَ المَرمَرِ المَسنونِ صاغوا مِثالَهُ","وَطافوا بِهِ مِن كُلِّ ناحِيَةٍ زُمَر",32,"ر",1,1],["مِنَ المُتبِعينَ الطَرفَ في كُلِّ شَتوَةٍ","سَنا البَرقِ يَدعوهُ الرَبيعُ المُطَرِّحُ",33,"ح",1,0],["مِنَ المُهيباتِ مُخضَرّاً مَغابِنُها","لَم تُثقِبِ الجَمرَ كَفّاها بِأَهضامِ",34,"م",1,0],["مِنَ المُفرَعاتِ المُجفَراتِ كَأَنَّها","غَمامٌ حَدَتهُ الريحُ فَاِنقَضَّ سارِيا",35,"ي",2,0],["من المرِشال أطلب ردّ روحي","وعودة فارسي وفكاك خلى",36,"ل",2,0],["مِنَ المائِدَةِ الخَضرا","ءَ خُذ حِذرَكَ يا غَندي",37,"د",2,0],["مَنِ المَوائِسُ باناً بِالرُبى وَقَناً","اللاعِباتُ بِروحي السافِحاتُ دَمي",38,"م",2,0],["مِنَ المَوجِ مُلتَمِعٌ مِثلَما","تَحَلَّت نُحورُ الدُمى بِالعُقود",39,"د",1,0],["مِنَ المُتَمَرِّداتِ تُذَبُّ عَنها","بِرُمحي كُلُّ طائِرَةِ الرَشاشِ",40,"ش",1,0],["من ألمِ الظهرِ أستغيثُ ولا","يألَمُ ظهرٌ إليك يَسْتَنِدُ",41,"د",1,0],["مِنَ المُستَأذَنينَ تَرى مَعَدّاً","خُشوعاً خاضِعينَ لَهُ الرِقابا",42,"ب",2,0],["مِنَ المُزلَهِمّينَ الَّذينَ كَأَنَّهُم","إِذا اِحتَضَرَ القَومُ الخِوانَ عَلى وِترِ",43,"ر",1,0],["مِنَ المُتَنَطِّقينَ عَلى لِحاهُم","دَليلَ اللَيلِ في اللُجَجِ الغِمارِ",44,"ر",1,0],["مِنَ المَجلِسِ المُستَأنِسينَ كَأَنَّهُم","لَدى حَومَلِ البَطحاءِ جِنّانُ عَبقَرا",45,"ر",2,0],["مِنَ المُصطَفى وَالمُصطَفى مِن ثِقاتِهِ","خَليلَيهِ إِذ بانا جَميعاً فَوَدَّعا",46,"ع",2,0],["مِنَ المُحرِزينَ السَبقِ يَومَ رِهانِهِ","سَبوقٍ إِلى الغاياتِ غَيرَ مُسَبَّقِ",47,"ق",1,0],["مِنَ الماءِ شَيئاً غَيرَ أَن قَد تَعَرَّضَت","لِنابَي شُجاعِ المُجهِزينَ مَقاتِلُه",48,"ل",2,0],["مِنَ المانِحينَ الجارَ كُلَّ مُمَنَّحٍ","فَوُوزٍ إِذا اِصتَكَّت مُقَرَّمَةً عُصلا",49,"ل",2,0],["مِن آلِ مُرَّةَ بَينَ المُستَضاءِ بِهِم","مِن رُؤَساءٍ مَصاليتٍ وَأَحكامِ",50,"م",1,0],["مِن آلِ مُرَّةَ بَينَ المُستَضاءِ بِهِم","مِن بَينِ صيدٍ مَصاليتٍ وَأَحكامِ",51,"م",1,0],["مِنَ المَليكِ المُؤَيَّدِ","اِبنِ عَلِيّ",52,"ي",1,0],["من المهدِ الذي هز البرايا","إلى مهدِ القداسة والنبوَّة",53,"ه",1,0],["مِنَ المُطِيعِينَ حُكَّامَاً لَهُمْ ظَلَمُوا","وَالطَّالِبِينَ مِنَ القَوْمِ اللئامِ جَدَا",54,"د",2,0],["مِنَ المُكرِمينَ الخَيلَ فيهِم وَلَم يَكُن","لِيُكرِمَها إِلّا كِرامُ المَحاتِدِ",55,"د",1,0],["مِنَ المَطَرِيّينَ الأُلى لَيسَ يَنجَلي","بِغَيرِهِمُ لِلدَهرِ صَرفٌ وَلا لَزبُ",56,"ب",1,0],["مِنَ المُعطَياتِ الحُسنَ وَالمُؤتَياتِهِ","مُجَلبَبَةً أَو فاضِلاً لَم تُجَلبَبِ",57,"ب",1,0],["من الملح الأجاج مشى ريخاً","يرقّص نخلة شبمٌ برود",58,"د",1,0],["مِنَ المُرعِداتِ الطَرفِ تَنفُذُ عَينُها","إِلى نَحوِ حَيزومِ المُجَرِّبِ ذي العَقلِ",59,"ل",1,0],["مِنَ المُسبِغينَ رِقاقَ البُرو","دِ أَكسو النِعالَ فُضولَ الأُزُر",60,"ر",1,0],["مِنَ المُسَوَّمَةِ اللاتي رَمَيتُ بِها","صَيدَ المُلوكِ فَلَم تُخطِئ وَلَم تَخِبِ",61,"ب",1,0],["مِنَ المُرزِماتِ المُلسِ لَم تُكسَ جُلبَةً","وَلَكِن لَها إِظنابَةٌ وَرَصيعُ",62,"ع",1,0],["مِنَ المَوماةِ غاداها","وَراوَحَ أَهلَها النَقَدُ",63,"د",1,0],["مِنَ المُشتَرينَ الحَمدَ تَندَى مِنَ النَدى","يَداهُ وَتَندى عارِضاهُ مِنَ العِطرِ",64,"ر",1,0],["مِنَ المَفتونِ بَشّارِ بنِ بُردٍ","إِلى شَيبانَ كَهلِهِمُ وَمُردِ",65,"د",1,1],["مِنَ المُدمِنينَ الطَعنَ قُبلاً وَمُدبَراً","مُسامَحَةً مِن غَيرِ مَنٍّ وَلا حَسَد",66,"د",1,0],["مِنَ المُتَنَزِّلينَ عَلى المَنايا","وَإِن جَلَبوا لَكَ المَعروفَ عادوا",67,"د",3,0],["مِنَ المُنعِمينَ الشُمِّ يَجري بِحِلمِهِ","وَإِن جَرَّدَتهُ الحَربُ يَوماً تَجَرَّدا",68,"د",2,0],["مِنَ المُستَفِزّاتِ القُلوبَ إِذا مَشَت","تَأَوَّدُ في أَعطافِها وَتَميدُ",69,"د",1,0],["مِنَ المُستَهِلّاتِ الهُمومَ عَلى الفَتى","خَفا بَرقُها مِن عُصفُرٍ وَعُقودِ",70,"د",1,0],["مِنَ المُتَحَرِّفينَ يَداً وَجوداً","عَلَيَّ مَديحُهُ وَعَلَيهِ نُجحُ",71,"ح",1,0],["مِنَ المُميتينَ هُمومَ الفَتى","يَعبَثُ في مَعروفِهِ عابِثُ",72,"ث",1,0],["مِنَ المُطعِمينَ المُنعِمينَ نُعِدُّهُ","لِيَومَ لِقاءٍ أَو لِفَكِّ عُناةِ",73,"ه",1,0],["مِنَ المُعَدّاتِ في اللُجَينِ وَفي ال","عَيصِ لِهَمٍّ أَلَحَّ أَو غَلَبا",74,"ب",2,0],["مِنَ المُتَصَيِّداتِ بِكُلِّ نَبلٍ","تَسيلُ إِذا مَش