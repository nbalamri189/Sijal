.html","الخفيف"],[315,"ضحكت وجوه الدهر بعد عبوس","https://www.aldiwan.net/poem59511.html","الكامل"],[369,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[438,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[463,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[469,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[543,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2445","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63971","الرجز"],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/123971","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120079","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64723","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64841","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69428","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89518","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120629","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132726","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126990","الكامل"],[3535,"","https://poetry.dctabudhabi.ae/diwan/poem/146447","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91193","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216740","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86540","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4830,"دمشق الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=195033",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[5145,"آه للمكرمات والآداب","https://www.poetsgate.com/ViewPoem.aspx?id=108242",""],[5145,"مرحباً بالطالع المشتهر","https://www.poetsgate.com/ViewPoem.aspx?id=108067",""],[5246,"بين الربى وعلى ضفاف الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=187024",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[4442,"ما بال جفنك لا يدر","https://www.poetsgate.com/ViewPoem.aspx?id=171226",""],[463,"بكرَ العارضُ تحدوه النُّعامى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60314&r=&rc=370",""]],"verses":[["حاطَ بِلادَ اللهِ منْ بعدِما","هبّتْ بِها ريحُ العِدَى زِعْزِعا",0,"ع",2,0],["حاطك اللَّهُ في المغيب وأدَّا","كَ وأدْنَى أحْوالِك المحبوبُ",1,"ب",1,0],["حاطكِ اللهُ بالكلاءة والصُّن","عِ وَوَقَّاكِ أعينَ العائداتِ",2,"ت",1,0],["حاطَ يَلديزا فَكانَ لَها","كَسِوارٍ غَيرِ مُنفَصِمِ",3,"م",1,0],["حاطَ نَزري إِذ خافَ تَأكيد ضَرّي","فاِستَحَقّ الجَفاءَ أَن حاطَ نَزرا",4,"ر",2,1],["حاطوا الحمى الغالي كما","حاطوا من الحق الدعامه",5,"م",2,0],["حاطَ الخِلافَةَ ناصِراً وَمُدَبِّرا","بِوَفاءِ مُجتَهِدٍ وَحَزمِ مُجَرِّبِ",6,"ب",1,0],["حاطَ الرَعِيَّةَ حينَ ناطَ أُمورُها","بِثَلاثَةٍ بَكَروا وُلاةَ عُهودِ",7,"د",1,0],["حاطَكَ اللَهُ يا أَبا أِسحاقِ","وَوَقاكَ المَكروهَ أَجمَعَ واقِ",8,"ق",1,1],["حاطَهُ اللَهُ حَيثُ أَضحى وَأَمسى","وَتَوَلّاهُ حَيثُ سارَ وَحَلّا",9,"ل",2,0],["حاطَ الخِلافَةَ ذائِداً عَن عِزِّها","وَكَفى الخَليفَةَ ما أَهَمَّ وَأَعضَلا",10,"ل",2,0],["حاطَني خالِقي فَعِشتُ وَلَولا","خَوفُهُ قُلتُ لَيتَهُ لَم يَحُطني",11,"ن",2,0],["حاطمَ الأصنامِ هل منكَ يدٌ","تذَرُ الظلمَ صديعاً من حُطامِ",12,"م",1,0],["حَاطَتْ بِهِ الْفُرْسانُ حُورَ الْمَها","يَا مَنْ رَأَى الرَّبْرَبَ فِي الفَيْلَقِ",13,"ق",1,0],["حَاطوا ممالكهم بعدْل ملوكهم","كحياطة البُستان بالأسوار",14,"ر",1,0],["حاط بلاد الله من بعدما","هبت بها ريح العدا زعزعا",15,"ع",2,0],["حاطت جلالَك عصبةٌ ما ضرّها","أن أبرقت ، أن يكثُر الارعاد",16,"د",1,0],["حَاطَ الخِلاَفةَ ذَئِداً عَنْ عِزِّها","وكَفَى الخَليفةَ مَا أَهَمَّ وأَعْضَلاَ",17,"ل",2,0],["حَاطَ الخِلاَفَةَ ناصراً وَمُدَبّراً،","بوَفاءِ مُجْتَهِدٍ، وَعَزْمِ مُجَرّبِ",18,"ب",1,0],["حاطني بالحنان صقر قريش","وسقى دوحتي ونضّر عودي",19,"د",2,0],["حاطَ الإلهُ لِنصرِ الدينِ مهجتهُ","وعُوفيت تلكمُ الأخلاقُ والشيمُ",20,"م",1,0],["حاطَ اِنتِقامَكَ بأساً قَبلَ باشِرِهِ","فَمذ مَلكتَ رَجا مَعمودَ احسان",21,"ن",1,0],["حاطَ الهُدى بجِلادِهِ وجِهادِهِ","فَكَبا لِمِعْطَسِهِ الضّلال وَطاحا",22,"ح",2,0],["حاطَكَ لكن بسورِ عزمٍ","لِعملِ الحاسدينَ حابِط",23,"ط",1,0],["حاطهُ عَن عثارِ جعدٍ برجفٍ","مُنتجٍ جحدَ عرفِ ربقِ العهودِ",24,"د",1,0],["حاط الرعية بالسياسة فانضوت","منه لإكرم مالك وسؤوس",25,"س",1,0],["حاطَهُ القلبُ وقد أسلَمني","فإلامَ الغدْرُ يا قلبُ إلاما",26,"م",2,0],["حاطهُ الله تعالى","للورى كهفاً وزَيْنا",27,"ن",2,0],["حاطها سيفاً ورأياً والساناً","إن تَداهَى وتَلاحَى وترَامى",28,"م",2,0],["حاطمةٍ تُنحي على مَعاشرٍ","وتُحفةٍ تُهدَى إلى مَعاشرِ",29,"ر",1,0],["حاط العلى ورماحه أقلامه","حيث المداد رؤوس نصال",30,"ل",1,0],["حاط فيها بِهِم منَ الأسرِ جَيشٌ","غَرَسوا في الذِّئابِ ناباً وظُفرا",31,"ر",2,0],["حاطَ أَخوالَهُ خُزاعَةَ لَمّا","كَثَرَتهُم بِمَكَّةَ الأَحياءُ",32,"ا",2,0],["حاطَ لهم ضبَّةُ مِن","إِرثِ العلى ما لم يُحَط",33,"ط",1,0],["حاطت عزائمه الإسلام جاهدةً","حتى تغاير فيها العلم والعلم",34,"م",1,0],["حاط الممالك منه طر","ف أخي ذكاء غير ساهي",35,"ي",1,0],["حَاطَكَ اللَّهُ مِنْ مُقِيمِ عِمَادٍ","هُوَ بِالدّينِ دَائِمُ التَّشْيِيدِ",36,"د",1,0],["حاطَ أَطرافَ الأَقالي","مِ بأَطرافِ الرِّماحِ",37,"ح",1,0],["حاطَكَ اللهُ أَيُّها الملِكُ المَنْ","صورُ حِفْظاً مِنْ سائِر الأَعْراضِ",38,"ض",1,1],["حاطَ البِلادَ وَباتَ تَسهَرُ عَينُهُ","وَعُيونُ سُكّانِ البِلادِ نِيامُ",39,"م",1,0],["حاطَ الرَعِيَّةَ مِن بُصرى إِلى عَدَنٍ","وَمِن تِهامَةَ حَتّى اِرتاحَ جَعلانُ",40,"ن",1,0],["حاطك الله أيّ ملك رحيم","ظاهرِ الجد طاهرِ الأجداد",41,"د",1,0],["حاطه الله حيث حلَّ فما أحس","ن وجه الزمان حين يؤوبُ",42,"ب",1,0],["حاطَ العِبادَ حُسَامُكَ المسلولُ","وحَمَى البِلادَ جِهَادُكَ المقبُول",43,"ل",1,1],["حاطت بك الأهوال فاطلب ساعة","تنجو بها من ساعة الدمدام",44,"م",1,0],["حاطها من عابث أن يأتمر","برداها بشبا الأقلام بردا",45,"د",2,0],["حاطت حمى الدين الحنيف عن العدى","وغدت لدين الله وهي عصام",46,"م",1,0],["حاطوا الهدى من عزمهم","بصوارم بيض بواتر",47,"ر",1,0],["حَاطَ الخِلافَةَ وَالدّنْيَا خَلِيَفُتَنا","بِصَارِمٍ من سُيُوفِ اللهِ صَمْصَامِ",48,"م",1,0],["حاطت بهِ الآباءُ كالهالاتِ ثُمَّ","الأَنبِياءُ وهُم لديهِ جُثَّمُ",49,"م",1,0],["حاطمو هامة المُلوك ملبّو","مَن دعا تاركو الطغاةَ أَسيفه",50,"ف",2,0],["حاطكِ الله بالسعادة والحب","ورواك ماؤه الرقراق",51,"ق",1,0],["حاط متن التنزيل من سالف الده","ر فزالت مخاوف التحريف",52,"ف",1,0],["حاطَ بِها سوران ثُمَّ الخَندَقُ","يُعجَبُ راءٍ عَرضُهُ وَالعُمقُ",53,"ق",1,0],["حاطتْ حجابته الدُّنيا بما ضَربتْ","دون الحوادث من حُجْبٍ وأَستار",54,"ر",1,0],["حاطوكِ ليلاً خِلسةً أذنابُهم","فاستنفرَ الأبناءُ والحُلفاءُ",55,"ا",2,0],["1-\"حَاْطُوْمُ\" يَحْطِمُ \"حَاْفِظَاً\" وَبِ \"حَاْفِظٍ\"","يَتَوَسَّلُ الضُّبَّاْطُ وَالرُّتَبَاْءُ",56,"ا",2,0],["حاطه الله حيث كان وإن كا","ن الذي قد أتاه غير الصواب",57,"ب",1,0],["حاطه الله ولقاء المنى","ووفاه من صروف الغير",58,"ر",1,0],["حاطت بها شم العوالي فاغتنت","بجبالها عن أحصن الجدران",59,"ن",1,0],["حاطبا بالظنون وجهك غيظا","ابكما ذابحا عيونك لحنا",60,"ن",2,0],["حاط الرعية حفظاً وهي غافلة","بالجد منه فلا يلوي على شغل",61,"ل",1,0],["حاطوا به مثل النطاق واضرموا","نيرانهم فيه بكل مكان",62,"ن",1,0],["حاطك الناس بالمحبة سوراً","مثلما حُطْتَهم فجَلّ كِفاء",63,"ا",2,0],["حاطتك أضلعها بأكمل رحمة","قبل السَّقام وبعد كل سقامِ",64,"م",1,0],["حاطوه أمثل الكواكب","في الدياجر وهو بدر",65,"ر",1,0],["حاطها سيفا ورأيا ولسانا","إن تداهى وتلاحى وترامى",66,"م",2,0]]}