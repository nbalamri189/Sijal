iwan/poem/39549","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10683","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54864","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141971","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[106,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"عهد الشباب سقى أيامك الأولا","https://www.poetsgate.com/ViewPoem.aspx?id=34202",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[46,"إذا آمَنَ الإنسانُ باللَّهِ، فليكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=20150",""],[105,"أمن عرش الشآم إلى أثينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54993&r=&rc=163",""],[96,"على الصّخرة البيضاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66335&r=&rc=14",""]],"verses":[["وَإِنَّ حَديثَ النَفسِ بِالشَيءِ دونَهُ","رِمالُ النَقا مِن عالِجٍ لَشَديدُ",0,"د",1,0],["وَإِن حُدِّثتُ عَنكِ رَأى جَليسي","كَأَنّي مُعرِضٌ لِهَواكِ سالِ",1,"ل",1,0],["وإِن حَلَّ بِيَ البُعدُ","سَيَنعاني لَكِ الناعي",2,"ي",1,0],["وَإِن حَلَفَت لا يَنقَدُ النَأيُ عَهدَها","فَلَيسَ لِمَخضوبِ البَنانِ يَمينُ",3,"ن",1,0],["وإنْ حَيا اللهُ حيّاها مُزَيْناتِهِ","يوْماً وأُسْعِفَ طَلاّبٌ بِما سألا",4,"ل",2,0],["وأنْحَتْ على مُلْكِ العِراقَيْنِ وانْتهَتْ","بثُبَّتَ حتى واجَهَتْ خيْلُها السّدّا",5,"د",2,0],["وإنْ حَلَفَ الغيْثُ السَّكوبُ بأنّهُ","أعَمُّ نَدىً منْ يوسُفٍ فهْوَ حانِثُ",6,"ث",1,0],["وَإِن حَربُهُم أوقِدَت بَينَهُم","فَحَرَّت لَهُم بَعدَ إِبرادِها",7,"د",3,0],["وَأَنحى عَلى شُؤمى يَدَيهِ فَذادَها","بِأَظمَأَ مِن فَرعِ الذُؤابَةِ أَسحَما",8,"م",2,0],["وَأَنحى لَها إِذ هَزَّ في الصَدرِ رَوقَهُ","كَما شَكَّ ذو العودِ الجَرادَ المُخَزَّما",8,"م",2,0],["وَإِن حَدَّثَت كانَت جَميعَ مَصائِبِ","مُوَفَّرَةٍ تَأتي بِقاصِمَةِ الظَهرِ",9,"ر",1,0],["وإن حقَّك عول في مساكنهم","وما همو بأداء الحق بخّالَ",10,"ل",1,0],["وانحطّ من غرف النباهة صاغراً","وأقام في غار الهوان خمولا",11,"ل",2,0],["وانحَبْ كما نحب الحزين مكفكفاً","غَرب الدموع بجانبَيْ مِنديله",12,"ل",2,0],["وأنحى عليها بالجَفاء مشِّتتاً","نجاحاً بركنَيْها الركينين ملتفا",13,"ف",2,0],["وَإِن حَلَّ بَيتي في رَقاشٍ وَجَدتَني","إِلى تُدرَءٍ مِن حَومِ عِزٍّ قُماقِمِ",14,"م",1,0],["وَإِن حَلَبَت سَوابِقُ كُلُّ حَيٍّ","سَبَقتَ وَأَنتَ ذو الخَصلِ المُعيدُ",15,"د",1,0],["وَإِنَّ حِمىً لَم يَحمِهِ غَيرُ فَرتَنى","وَغَيرُ اِبنِ ذي الكيرَينِ خَزيانُ ضائِعُ",16,"ع",1,0],["وإن حدثتك النفس إنك قادر","على ما حوت أيدي الرجال فجرِّبِ",17,"ب",1,0],["وَإِن حَجَبَت عَنّا النَوى أُمَّ مالِكٍ","لَقَد ساعَدَتها كِلَّةٌ وَبَراقِعُ",18,"ع",1,0],["وَإِن حارَبوا كُنتُ المِجَنَّ أَمامُهُم","وَإِن ضارَبوا كُنتُ المُهَنَّدَ وَاليَدا",19,"د",2,0],["وإن حدَّثَ العذالُ عني بسلوةٍ","فإني وعذَّالي من الضعفاء",20,"ا",2,0],["وإن حفَّ بي للنوى مهلكٌ","فكم صحَّ لي باللقا مطلب",21,"ب",1,0],["وإن حجَّك في عاف بمصر دعا","كمثل حجك بالبطحاء موفور",22,"ر",1,0],["وانحر بصحبته الضحايا والعدى","فالكلّ معدودٌ من الأنعام",23,"م",1,0],["وإن حمل السلاح ليوم حربٍ","فقل في الليث ماضي الماضغين",24,"ن",1,0],["وانْحر عداتك والضحا","يا وافْنهم قرنا فقرنا",25,"ن",2,0],["وإن حاول الأعداءُ يوماً بكيدِه","أحلَّ بمن عاداه راغيةَ السَّقبِ",26,"ب",1,0],["وانحدارَ الدموع كاللؤلؤ الرطْ","بِ هَوى من مدامعٍ قَرِحاتِ",27,"ت",1,0],["وإن حبس الكساء تَجهَّمتْهُ","إذا ما جاء أيامٌ حرار",28,"ر",1,0],["وإن حاربَ الرأيُ فيك الهوى","فلا شك في أنني مقصِر",29,"ر",1,0],["وانحاز عن بدد منهم وما ادكرت","خيل الأمير أواريَّاً وأعلافا",30,"ف",2,0],["وانحزتُ عن حزب الهدى","وكنت ممَّنْ تركهْ",31,"ك",2,0],["وإن حَفِيتْ لم تُحْذ نعلاً وذُكّرتْ","به فرأيتَ المرْو بالبيد تُرْثَمُ",32,"م",1,0],["وإن حلَّ أرضاً حلَّها وهْو قادرٌ","على البُؤسِ والنُّعمى فأهلكَ أو عصمْ",33,"م",1,0],["وإنَّ حاصلَ ما جادتْ يدا رجلٍ","ما حُمِّلتْ ألسنٌ منه وآذان",34,"ن",1,0],["وَإِنَّ حَديثاً مِنكِ لَو تَبذُلينَهُ","جَنى النَحلِ في أَلبانِ عوذٍ مَطافِلِ",35,"ل",1,0],["وَأَنَّ حَكيمَ القَومِ يَأنَفُ أَن يَرى","أَسيرَ طِلاءٍ بَعدَ حينٍ سَيَنصُلُ",36,"ل",1,0],["وَإِنَّ حَديثاً أَنتَ راويهِ إِنَّني","عَلى ثِقَةٍ مِنهُ وَحُسنِ يَقينِ",37,"ن",1,0],["وان حياتي في الهوى وهي كل ما","ملكت من الدنيا طريق الى حيني",38,"ي",1,0],["وإن حياتنا والموت فاعلم","أجيجٌ في العناصر وانطفاءُ",39,"ا",2,0],["وإن حلمي لتستكفي البلاد به","كالعين تمت معانيها بإنسان",40,"ن",1,0],["وَإِن حَمَلَتكَ أَيديهِم بُحوراً","بَلَغتَ عَلى أَكُفِّهِمُ السَحابا",41,"ب",2,0],["وإِنْ حَلَفَتْ لا يَنْقُصُ النّأْيُ عَهْدَها","فليس لمخْضُوبِ البَنَانِ يَمينُ",42,"ن",1,0],["وَإِن حَقَدَت لَم يَبقَ في قَلبِها رِضىً","وَإِن رَضِيَت لَم يَبقَ في قَلبِها حِقدُ",43,"د",1,0],["وإن حدثتكَ النفسُ أنّك مدركٌ","لشأوي فطالِبْهَا بمثلِ خصائصي",44,"ص",2,0],["وَإِن حَضَروا الأَيسارَ حازوا مَدى العُلا","وَفازوا بِقَدحِ مُنجِحٍ غَيرَ خائِبِ",45,"ب",1,0],["وَإِن حالَ مِن دونِ حَقّي فَلَم","يُسَلِّمهُ يَعقوبُها اِبنُ الفَرَج",46,"ج",1,0],["وَإِن حارَ ساري القَومِ في الخَطبِ أَنجَحَت","بَصيرَةُ هادٍ لِلمَحَجَّةِ مُبصِرِ",47,"ر",1,0],["وَاِنحَطَّ يَطلُبُ بابِلاً وَمَليكَها","فَأَحاطَ بِالمَلِكِ الخَليعِ الناسي",48,"س",2,0],["وَاِنحازَ مِثلَ اِنحِيازِ الطَودِ يَتبَعُهُ","رَأيٌ يُصَغَّرُ فيهِ الحادِثُ الجَلَلُ",49,"ل",1,0],["وَإِنَّ حَدراءَ ما كانَت مُصاهِرَةً","بَينَ الأَلائِمِ مِن ضَيفٍ وَمِن جارِ",50,"ر",1,0],["وَإِن حَلَّ بَيتي مِن سَماءِ مُجاشِعٍ","بِمَنزِلَةٍ فاتَت يَدَ المُتَناوِلِ",51,"ل",1,0],["وَإِن حانَ مِنهُ مَنزِلُ اللَيلِ خِلتَهُ","حِراجاً تَرى ما بَينَهُ مَتَدانِيا",52,"ي",2,0],["وإن حَلَّ الفِراقُ عُقودَ دَمعي","وبيَّنَتِ النَّوى ما في فُؤادي",53,"ي",1,0],["وإن حَمى البينُ عَذْبَاً من مواردِه","إلا خيالاً يَزيدُ القلبَ تَعذيبا",54,"ب",2,0],["وإن حَمَلَتْ سُمْرَ الرِّماحِ لمَشهَدٍ","رأيْتَ أُسُودَ الغابِ تَحمِلُ غابَها",55,"ب",3,0],["وإن حسرَ الضريبُ مُلاءتَيْه","عن الدَّربين فارتقبوا الضِّرابا",56,"ب",2,0],["وإن حادَ عن نفسٍ هَدَاه لها الرَّدى","ولم يُرَ سارٍ قبلَه بالرَّدى يُهْدى",57,"ا",1,0],["وَإِن حَلَفَت لا يَنقُضُ النَأي عَهدَها","فَلَيسَ لِمَخضوبِ البَنانِ يَمينُ",58,"ن",1,0],["وَإِنَّ حُلوَ الدُنيا غَداً غَيرَ ما","شَكٍ لِمُرٍّ وَمُرُّها حُلو",59,"و",1,0],["وَإِن حالَ داعي المَوتِ دونَ نَجازِهِ","فَلا رَحِمَ الرَحمَنُ مَن ضَمَّهُ القَبرُ",60,"ر",1,0],["وَإِن حَرَّكَتهُ الكَفُّ أَبدى تَمَلمُلاً","فَحَرَّكَ مِنّا يَذبُلاً وَيَلَملَما",61,"م",2,0],["وَاِنحَر عِداكَ بِهِ وَصَل","لِ وَصِل بِرِفدِكَ لِلوُفودِ",62,"د",1,0],["وَاِنحَرعِداكَ فَبِالإِنعامِ ما اِنصَلَحوا","إِن كانَ غَيرُكَ لِلأَنعامِ قَد نَحَرا",63,"ر",2,0],["وَإِنْ حَارَتِ الأَبْصَارُ فِي مُدْلَهِمَّةٍ","مِنَ الأَمْرِ جَاؤُوا بِالإِنَارَةِ وَالضَّحْوِ",64,"و",1,0],["وَإِن حارَبَت لَيلى نُحارِب وَإِن تَدِن","نَدِن دينَها لا عَيبَ لِلمُتَوَدِّدِ",65,"د",1,0],["وَإِنَّ حَقائِقَ الحِدثانِ تَأتي","فَتَدمَعُ تُرَّهاتِ الجاهِلينا",66,"ن",2,0],["وَإِنَّ حَياةَ الفَتى كَالثَراءِ","يُصَرِّفُهُ سَرَفاً وَاِقتِصادا",67,"د",2,0],["وَإِن حُلَّ عَنها الرَحلُ قارَبَ خَطوَها","أَمينُ القُوى كَالدُملُجِ المُتَعَضِّدِ",68,"د",1,0],["وَإِن حَضَرتُ النَدِيَّ وَكَّلَ بي","لَحظاً بِنَبلِ الشَحناءِ يَنتَضِلُ",69,"ل",1,0],["وَأَنَّ حالِي وَحالَ عائلَتي","لا يَحْمِلُونَ النُّوَى ولا الغُرْبَهْ",70,"ب",2,0],["وإن حَمَلوا قَلبي وساروا فمَنطِقِي","يُحَمَّلُ في آثارِهم وَيُسَيَّرُ",71,"ر",1,0],["وإن حَنَّ من شوْقٍ إليكَ فإنّهُ","لَيوجَدُ من رَيّاكَ في جوِّه نَشْر",72,"ر",1,0],["وإنّ حراماً أن يُؤمَّلَ غيرُه","كما حُرّمَتْ في العالَمين الخبائث",73,"ث",1,0],["وإنّ حَصاناً نَمَتْ جعفراً","ويحيَى لَعاديّةُ المنتمى",74,"ا",1,0],["وَاِنحُ الغَداةَ عَلى مُقابِلِهِم","لِخَليلَكَ المَشغوفِ إِن طَلَبا",75,"ب",2,0],["وَأَنحَلَ بَدرَ التَمِّ بَعدَ كَمالِهِ","كَأَنَّ بِهِ الظَلماءَ قاصِمَةٌ قُلبا",76,"ب",2,0],["وَإِنَّ حِبالَ العَيشِ ما عَلِقَت بِها","يَدُ الحَيِّ إِلّا وَهيَ تَخشى اِنقِضابَها",77,"ب",3,0],["وَإِن حَمَلَت راحَتي راحَها","بِأَقداحِها لَم تَفُز أَقدُحي",78,"ح",2,0],["وَإِنَّ حَياتي لِلمَنايا سَحابَةٌ","وَإِنَّ كَلامي لِلحِمامِ رَعودُ",79,"د",1,0],["وَإِن حَبَّبَ اللَهُ الحُسامَ إِلى اِمرِئٍ","حَباهُ بِهِ في كُلِّ مَفزَعَةٍ خَفرا",80,"ر",2,0],["وَإِن حَبانِيَ سَعداً مَن بِهِ ثِقَتي","فَلَيسَ يُنقَصُ حَظّي أَنَّني ضَرَعُ",81,"ع",1,0],["وَإِن حاوَلتَ رَكبَ الظَلامِ نِياقُهُم","فَتِلكَ لَعَّمرُ اللَهِ بِئسَ الأَيانِقُ",82,"ق",1,0],["وَإِنَّ حِجازَيّ النِمارِ وَلُبسَها","لِأَشرَفُ مِن ديباجِهِم وَالنَمارِقِ",83,"ق",1,0],["وَإِن حَلَّ أَبدى فاقَةً مِنكِ فَاِضمَني","قِراهُ وَلَو جَمَّعتِهِ مِن قِرى النَملِ",84,"ل",1,0],["وَإِنَّ حَسرَةَ نَفسٍ غَيرَ هَيِّنَةٍ","مَصيرُها بَعدَ إيجادٍ إِلى عَدَمِ",85,"م",1,0],["وَإِنَّ حَوادِثَ الأَيّامِ نُكدٌ","يُصَيِّرنَ الحَقائِقَ كَالأَماني",86,"ي",1,0],["وَأَنحَت كَما أَنحى المَحالَةَ ماتِحٌ","عَلى البِئرِ أَضحى حَوضُهُ وَهوَ ناشِفُ",87,"ف",1,0],["وإنْ حلَّ في هذي توحّشُ هذهِ","فتُهدي برسلٍ نحوَهُ ورسائلِ",88,"ل",1,0],["وإنْ حَكمتْ جارَتْ عليَّ بحُكمها","ولكنَّ ذاك الجورَ أشهى منَ العَدلِ",89,"ل",1,0],["وأنحى على الأقدار يكثر عتبه","ولكنما الأقدار لا تسمع العتبا",90,"ب",2,0],["وانحنت فوق الرأس مني وفا","ضت مقلتاها قبلتا مقلتيا",91,"ي",2,0],["وإن حدثت في مكان وغى","فَقَد لا أشاهد منها القتاما",92,"م",2,0],["وإن حججت إلى البيت","أو لزمت المصلى",93,"ل",2,0],["وإن حظيت بنعمى","فاطلب عليها مزيدا",94,"د",2,0],["وإن حصول الشيء رهن بفرصة","إذا هي فاتَت فهو لا يتحصل",95,"ل",1,0],["وإن حقدت لم يبق في قلبها رضاً","وإن رضيت لم يبق في قلبها حقد",96,"د",1,0],["وإن حد الصارم القرضابا","والذابلات السمر والعرابا",97,"ب",2,0],["وأنحى على قطَّانها غيرَ مُشفقٍ","بهم أو مجيلٍ فيهمو عينَ باصرِ",98,"ر",1,0],["وَإِن حالَ يَأسٌ دونَ لَيلى فَرُبَّما","أَتى اليَأسُ دونَ الشَيءِ وَهوَ حَبيبُ",99,"ب",1,0],["وَإِنَّ حُمَاة الضادِ تَشْهَدُ عِيدَهَا","يُعَيِّدُهُ بَادُونَ مِنْهُمْ وَحُضَّرُ",100,"ر",1,0],["وَأَنَّ حَبْراً حَمَى حِمَاكُمْ","أَضْحَى لَكُمْ عِنْدَهُ شَفِيعَا",101,"ع",2,0],["وانحنَت كلّ نخلَةٍ كجناحٍ","أخضرِ الريشِ ودّ لو كان زندا",102,"د",2,0],["وإن حَجَبَتْ بِيضَ الأيادي مَنِيَّةٌ","فليس على آثارهنّ حِجابُ",103,"ب",1,0],["وأنَ حِدادَ ليلِكِ طرَزتْه","دُموعٌ للثواكِل واليتامى",104,"م",2,0],["وانحازَ للرَّكْبِ الذي من آدمٍ","ما زَال يُزْعجنَا رَنِينُ حُدَاتِه",105,"ت",2,0],["وإن حاربتني صروفُ الزمان","شَهَرتُ عليها احتقاري سلاحًا",106,"ح",2,0],["وأنحت على ملك العراقين وانتهت","بتبت حتى واجهت خيلها السدا",107,"د",2,0],["وإن حبا الله حياها من يأت حيا","يوما وأسعف طالبا بما سألا",108,"ل",2,0],["وانحنَتْ فوقها الأمومةُ خرساءَ","تُزجّى يُسرى وتَرفع يُمنَى",109,"ن",2,0],["وإن حسيناً عثرةٌ في طريقه","فما اسطاعَ فليستغنِ ان يتعثَّرا",110,"ر",2,0],["وانحطَّ يَطلُبُ بَابِلاً ومَليكَها","فأَحاطَ بالملكِ الخْلِعِ النَّاسي",111,"س",2,0],["وإن حبّبَ اللَّهُ الحُسامَ إلى امرىءٍ،","حَباهُ بهِ، في كلّ مَفرَغةٍ، خَفرا",112,"ر",2,0],["وإن حقائق الحدثان تأتي","فتدمغ ترهات الجاهلينا",113,"ن",2,0],["وأنحى عن قطّانها غير مشفق","بهم أو مجيل فيهمو عين باصر",114,"ر",1,0]]}