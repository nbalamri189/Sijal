t/poem68106.html","الطويل"],[362,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[369,"دنت فرأتني عاتبا متطرفا","https://www.aldiwan.net/poem57300.html","الطويل"],[374,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[374,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[377,"أمير لج في هجري","https://www.aldiwan.net/poem48791.html","مجزوء الوافر"],[377,"غلام كما سال في خده","https://www.aldiwan.net/poem48794.html","المتقارب"],[399,"وكنت أرى أني الصبور على النوى","https://www.aldiwan.net/poem46518.html","الطويل"],[400,"أتت وخيول الهم في القلب ترتكض","https://www.aldiwan.net/poem33699.html","الطويل"],[400,"يا أيها المولى","https://www.aldiwan.net/poem33758.html","مجزوء الرجز"],[413,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[413,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[429,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[429,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[436,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[438,"أحمل نفسي فوق ما لا تطيقه","https://www.aldiwan.net/poem14396.html","الطويل"],[441,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[446,"تهادت أهيل الأبرقين المراحل","https://www.aldiwan.net/poem53690.html","الطويل"],[450,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[450,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[451,"عزاء بهذا الموت يا من فدى مصرا","https://www.aldiwan.net/poem61244.html","الطويل"],[451,"شربت فلسفتي من نبع آلامي","https://www.aldiwan.net/poem61251.html","البسيط"],[451,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[453,"لقد علمت وما الإسراف من خلقي","https://www.aldiwan.net/poem26637.html","البسيط"],[456,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[456,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[456,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[456,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[456,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[459,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16179.html","الطويل"],[475,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[477,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[480,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[493,"أحاجيكم وليس لكم","https://www.aldiwan.net/poem10267.html","مجزوء الوافر"],[498,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[512,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[512,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[513,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[513,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[527,"وإن حياة والممات ختامها","https://www.aldiwan.net/poem37414.html","الطويل"],[549,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[549,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[549,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[549,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[556,"إن غبت عن عياني","https://www.aldiwan.net/poem33831.html","المجتث"],[556,"لله في الكون تحريك وتسكين","https://www.aldiwan.net/poem33849.html","البسيط"],[556,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"],[565,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أعدت جفونك منك الجسم بالسقم","https://www.aldiwan.net/poem2867.html","البسيط"],[573,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[573,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[583,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["وَإِنَّ حَديثَ النَفسِ بِالشَيءِ دونَهُ","رِمالُ النَقا مِن عالِجٍ لَشَديدُ",0,"د",1,0],["وَإِن حُدِّثتُ عَنكِ رَأى جَليسي","كَأَنّي مُعرِضٌ لِهَواكِ سالِ",1,"ل",1,0],["وإِن حَلَّ بِيَ البُعدُ","سَيَنعاني لَكِ الناعي",2,"ي",1,0],["وَإِن حَلَفَت لا يَنقَدُ النَأيُ عَهدَها","فَلَيسَ لِمَخضوبِ البَنانِ يَمينُ",3,"ن",1,0],["وإنْ حَيا اللهُ حيّاها مُزَيْناتِهِ","يوْماً وأُسْعِفَ طَلاّبٌ بِما سألا",4,"ل",2,0],["وأنْحَتْ على مُلْكِ العِراقَيْنِ وانْتهَتْ","بثُبَّتَ حتى واجَهَتْ خيْلُها السّدّا",5,"د",2,0],["وإنْ حَلَفَ الغيْثُ السَّكوبُ بأنّهُ","أعَمُّ نَدىً منْ يوسُفٍ فهْوَ حانِثُ",6,"ث",1,0],["وَإِن حَربُهُم أوقِدَت بَينَهُم","فَحَرَّت لَهُم بَعدَ إِبرادِها",7,"د",3,0],["وَأَنحى عَلى شُؤمى يَدَيهِ فَذادَها","بِأَظمَأَ مِن فَرعِ الذُؤابَةِ أَسحَما",8,"م",2,0],["وَأَنحى لَها إِذ هَزَّ في الصَدرِ رَوقَهُ","كَما شَكَّ ذو العودِ الجَرادَ المُخَزَّما",8,"م",2,0],["وَإِن حَدَّثَت كانَت جَميعَ مَصائِبِ","مُوَفَّرَةٍ تَأتي بِقاصِمَةِ الظَهرِ",9,"ر",1,0],["وإن حقَّك عول في مساكنهم","وما همو بأداء الحق بخّالَ",10,"ل",1,0],["وانحطّ من غرف النباهة صاغراً","وأقام في غار الهوان خمولا",11,"ل",2,0],["وانحَبْ كما نحب الحزين مكفكفاً","غَرب الدموع بجانبَيْ مِنديله",12,"ل",2,0],["وأنحى عليها بالجَفاء مشِّتتاً","نجاحاً بركنَيْها الركينين ملتفا",13,"ف",2,0],["وَإِن حَلَّ بَيتي في رَقاشٍ وَجَدتَني","إِلى تُدرَءٍ مِن حَومِ عِزٍّ قُماقِمِ",14,"م",1,0],["وَإِن حَلَبَت سَوابِقُ كُلُّ حَيٍّ","سَبَقتَ وَأَنتَ ذو الخَصلِ المُعيدُ",15,"د",1,0],["وَإِنَّ حِمىً لَم يَحمِهِ غَيرُ فَرتَنى","وَغَيرُ اِبنِ ذي الكيرَينِ خَزيانُ ضائِعُ",16,"ع",1,0],["وإن حدثتك النفس إنك قادر","على ما حوت أيدي الرجال فجرِّبِ",17,"ب",1,0],["وَإِن حَجَبَت عَنّا النَوى أُمَّ مالِكٍ","لَقَد ساعَدَتها كِلَّةٌ وَبَراقِعُ",18,"ع",1,0],["وَإِن حارَبوا كُنتُ المِجَنَّ أَمامُهُم","وَإِن ضارَبوا كُنتُ المُهَنَّدَ وَاليَدا",19,"د",2,0],["وإن حدَّثَ العذالُ عني بسلوةٍ","فإني وعذَّالي من الضعفاء",20,"ا",2,0],["وإن حفَّ بي للنوى مهلكٌ","فكم صحَّ لي باللقا مطلب",21,"ب",1,0],["وإن حجَّك في عاف بمصر دعا","كمثل حجك بالبطحاء موفور",22,"ر",1,0],["وانحر بصحبته الضحايا والعدى","فالكلّ معدودٌ من الأنعام",23,"م",1,0],["وإن حمل السلاح ليوم حربٍ","فقل في الليث ماضي الماضغين",24,"ن",1,0],["وانْحر عداتك والضحا","يا وافْنهم قرنا فقرنا",25,"ن",2,0],["وإن حاول الأعداءُ يوماً بكيدِه","أحلَّ بمن عاداه راغيةَ السَّقبِ",26,"ب",1,0],["وانحدارَ الدموع كاللؤلؤ الرطْ","بِ هَوى من مدامعٍ قَرِحاتِ",27,"ت",1,0],["وإن حبس الكساء تَجهَّمتْهُ","إذا ما جاء أيامٌ حرار",28,"ر",1,0],["وإن حاربَ الرأيُ فيك الهوى","فلا شك في أنني مقصِر",29,"ر",1,0],["وانحاز عن بدد منهم وما ادكرت","خيل الأمير أواريَّاً وأعلافا",30,"ف",2,0],["وانحزتُ عن حزب الهدى","وكنت ممَّنْ تركهْ",31,"ك",2,0],["وإن حَفِيتْ لم تُحْذ نعلاً وذُكّرتْ","به فرأيتَ المرْو بالبيد تُرْثَمُ",32,"م",1,0],["وإن حلَّ أرضاً حلَّها وهْو قادرٌ","على البُؤسِ والنُّعمى فأهلكَ أو عصمْ",33,"م",1,0],["وإنَّ حاصلَ ما جادتْ يدا رجلٍ","ما حُمِّلتْ ألسنٌ منه وآذان",34,"ن",1,0],["وَإِنَّ حَديثاً مِنكِ لَو تَبذُلينَهُ","جَنى النَحلِ في أَلبانِ عوذٍ مَطافِلِ",35,"ل",1,0],["وَأَنَّ حَكيمَ القَومِ يَأنَفُ أَن يَرى","أَسيرَ طِلاءٍ بَعدَ حينٍ سَيَنصُلُ",36,"ل",1,0],["وَإِنَّ حَديثاً أَنتَ راويهِ إِنَّني","عَلى ثِقَةٍ مِنهُ وَحُسنِ يَقينِ",37,"ن",1,0],["وان حياتي في الهوى وهي كل ما","ملكت من الدنيا طريق الى حيني",38,"ي",1,0],["وإن حياتنا والموت فاعلم","أجيجٌ في العناصر وانطفاءُ",39,"ا",2,0],["وإن حلمي لتستكفي البلاد به","كالعين تمت معانيها بإنسان",40,"ن",1,0],["وَإِن حَمَلَتكَ أَيديهِم بُحوراً","بَلَغتَ عَلى أَكُفِّهِمُ السَحابا",41,"ب",2,0],["وإِنْ حَلَفَتْ لا يَنْقُصُ النّأْيُ عَهْدَها","فليس لمخْضُوبِ البَنَانِ يَمينُ",42,"ن",1,0],["وَإِن حَقَدَت لَم يَبقَ في قَلبِها رِضىً","وَإِن رَضِيَت لَم يَبقَ في قَلبِها حِقدُ",43,"د",1,0],["وإن حدثتكَ النفسُ أنّك مدركٌ","لشأوي فطالِبْهَا بمثلِ خصائصي",44,"ص",2,0],["وَإِن حَضَروا الأَيسارَ حازوا مَدى العُلا","وَفازوا بِقَدحِ مُنجِحٍ غَيرَ خائِبِ",45,"ب",1,0],["وَإِن حالَ مِن دونِ حَقّي فَلَم","يُسَلِّمهُ يَعقوبُها اِبنُ الفَرَج",46,"ج",1,0],["وَإِن حارَ ساري القَومِ في الخَطبِ أَنجَحَت","بَصيرَةُ هادٍ لِلمَحَجَّةِ مُبصِرِ",47,"ر",1,0],["وَاِنحَطَّ يَطلُبُ بابِلاً وَمَليكَها","فَأَحاطَ بِالمَلِكِ الخَليعِ الناسي",48,"س",2,0],["وَاِنحازَ مِثلَ اِنحِيازِ الطَودِ يَتبَعُهُ","رَأيٌ يُصَغَّرُ فيهِ الحادِثُ الجَلَلُ",49,"ل",1,0],["وَإِنَّ حَدراءَ ما كانَت مُصاهِرَةً","بَينَ الأَلائِمِ مِن ضَيفٍ وَمِن جارِ",50,"ر",1,0],["وَإِن حَلَّ بَيتي مِن سَماءِ مُجاشِعٍ","بِمَنزِلَةٍ فاتَت يَدَ المُتَناوِلِ",51,"ل",1,0],["وَإِن حانَ مِنهُ مَنزِلُ اللَيلِ خِلتَهُ","حِراجاً تَرى ما بَينَهُ مَتَدانِيا",52,"ي",2,0],["وإن حَلَّ الفِراقُ عُقودَ دَمعي","وبيَّنَتِ النَّوى ما في فُؤادي",53,"ي",1,0],["وإن حَمى البينُ عَذْبَاً من مواردِه","إلا خيالاً يَزيدُ القلبَ تَعذيبا",54,"ب",2,0],["وإن حَمَلَتْ سُمْرَ الرِّماحِ لمَشهَدٍ","رأيْتَ أُسُودَ الغابِ تَحمِلُ غابَها",55,"ب",3,0],["وإن حسرَ الضريبُ مُلاءتَيْه","عن الدَّربين فارتقبوا الضِّرابا",56,"ب",2,0],["وإن حادَ عن نفسٍ هَدَاه لها الرَّدى","ولم يُرَ سارٍ قبلَه بالرَّدى يُهْدى",57,"ا",1,0],["وَإِن حَلَفَت لا يَنقُضُ النَأي عَهدَها","فَلَيسَ لِمَخضوبِ البَنانِ يَمينُ",58,"ن",1,0],["وَإِنَّ حُلوَ الدُنيا غَداً غَيرَ ما","شَكٍ لِمُرٍّ وَمُرُّها حُلو",59,"و",1,0],["وَإِن حالَ داعي المَوتِ دونَ نَجازِهِ","فَلا رَحِمَ الرَحمَنُ مَن ضَمَّهُ القَبرُ",60,"ر",1,0],["وَإِن حَرَّكَتهُ الكَفُّ أَبدى تَمَلمُلاً","فَحَرَّكَ مِنّا يَذبُلاً وَيَلَملَما",61,"م",2,0],["وَاِنحَر عِداكَ بِهِ وَصَل","لِ وَصِل بِرِفدِكَ لِلوُفودِ",62,"د",1,0],["وَاِنحَرعِداكَ فَبِالإِنعامِ ما اِنصَلَحوا","إِن كانَ غَيرُكَ لِلأَنعامِ قَد نَحَرا",63,"ر",2,0],["وَإِنْ حَارَتِ الأَبْصَارُ فِي مُدْلَهِمَّةٍ","مِنَ الأَمْرِ جَاؤُوا بِالإِنَارَةِ وَالضَّحْوِ",64,"و",1,0],["وَإِن حارَبَت لَيلى نُحارِب وَإِن تَدِن","نَدِن دينَها لا عَيبَ لِلمُتَوَدِّدِ",65,"د",1,0],["وَإِنَّ حَقائِقَ الحِدثانِ تَأتي","فَتَدمَعُ تُرَّهاتِ الجاهِلينا",66,"ن",2,0],["وَإِنَّ حَياةَ الفَتى كَالثَراءِ","يُصَرِّفُهُ سَرَفاً وَاِقتِصادا",67,"د",2,0],["وَإِن حُلَّ عَنها الرَحلُ قارَبَ خَطوَها","أَمينُ القُوى كَالدُملُجِ المُتَعَضِّدِ",68,"د",1,0],["وَإِن حَضَرتُ النَدِيَّ وَكَّلَ بي","لَحظاً بِنَبلِ الشَحناءِ يَنتَضِلُ",69,"ل",1,0],["وَأَنَّ حالِي وَحالَ عائلَتي","لا يَحْمِلُونَ النُّوَى ولا الغُرْبَهْ",70,"ب",2,0],["وإن حَمَلوا قَلبي وساروا فمَنطِقِي","يُحَمَّلُ في آثارِهم وَيُسَيَّرُ",71,"ر",1,0],["وإن حَنَّ من شوْقٍ إليكَ فإنّهُ","لَيوجَدُ من رَيّاكَ في جوِّه نَشْر",72,"ر",1,0],["وإنّ حراماً أن يُؤمَّلَ غيرُه","كما حُرّمَتْ في العالَمين الخبائث",73,"ث",1,0],["وإنّ حَصاناً نَمَتْ جعفراً","ويحيَى لَعاديّةُ المنتمى",74,"ا",1,0],["وَاِنحُ الغَداةَ عَلى مُقابِلِهِم","لِخَليلَكَ المَشغوفِ إِن طَلَبا",75,"ب",2,0],["وَأَنحَلَ بَدرَ التَمِّ بَعدَ كَمالِهِ","كَأَنَّ بِهِ الظَلماءَ قاصِمَةٌ قُلبا",76,"ب",2,0],["وَإِنَّ حِبالَ العَيشِ ما عَلِقَت بِها","يَدُ الحَيِّ إِلّا وَهيَ تَخشى اِنقِضابَها",77,"ب",3,0],["وَإِن حَمَلَت راحَتي راحَها","بِأَقداحِها لَم تَفُز أَقدُحي",78,"ح",2,0],["وَإِنَّ حَياتي لِلمَنايا سَحابَةٌ","وَإِنَّ كَلامي لِلحِمامِ رَعودُ",79,"د",1,0],["وَإِن حَبَّبَ اللَهُ الحُسامَ إِلى اِمرِئٍ","حَباهُ بِهِ في كُلِّ مَفزَعَةٍ خَفرا",80,"ر",2,0],["وَإِن حَبانِيَ سَعداً مَن بِهِ ثِقَتي","فَلَيسَ يُنقَصُ حَظّي أَنَّني ضَرَعُ",81,"ع",1,0],["وَإِن حاوَلتَ رَكبَ الظَلامِ نِياقُهُم","فَتِلكَ لَعَّمرُ اللَهِ بِئسَ الأَيانِقُ",82,"ق",1,0],["وَإِنَّ حِجازَيّ النِمارِ وَلُبسَها","لِأَشرَفُ مِن ديباجِهِم وَالنَمارِقِ",83,"ق",1,0],["وَإِن حَلَّ أَبدى فاقَةً مِنكِ فَاِضمَني","قِراهُ وَلَو جَمَّعتِهِ مِن قِرى النَملِ",84,"ل",1,0],["وَإِنَّ حَسرَةَ نَفسٍ غَيرَ هَيِّنَةٍ","مَصيرُها بَعدَ إيجادٍ إِلى عَدَمِ",85,"م",1,0],["وَإِنَّ حَوادِثَ الأَيّامِ نُكدٌ","يُصَيِّرنَ الحَقائِقَ كَالأَماني",86,"ي",1,0],["وَأَنحَت كَما أَنحى المَحالَةَ ماتِحٌ","عَلى البِئرِ أَضحى حَوضُهُ وَهوَ ناشِفُ",87,"ف",1,0],["وإنْ حلَّ في هذي توحّشُ هذهِ","فتُهدي برسلٍ نحوَهُ ورسائلِ",88,"ل",1,0],["وإنْ حَكمتْ جارَتْ عليَّ بحُكمها","ولكنَّ ذاك الجورَ أشهى منَ العَدلِ",89,"ل",1,0],["وأنحى على الأقدار يكثر عتبه","ولكنما الأقدار لا تسمع العتبا",90,"ب",2,0],["وانحنت فوق الرأس مني وفا","ضت مقلتاها قبلتا مقلتيا",91,"ي",2,0],["وإن حدثت في مكان وغى","فَقَد لا أشاهد منها القتاما",92,"م",2,0],["وإن حججت إلى البيت","أو لزمت المصلى",93,"ل",2,0],["وإن حظيت بنعمى","فاطلب عليها مزيدا",94,"د",2,0],["وإن حصول الشيء رهن بفرصة","إذا هي فاتَت فهو لا يتحصل",95,"ل",1,0],["وإن حقدت لم يبق في قلبها رضاً","وإن رضيت لم يبق في قلبها حقد",96,"د",1,0],["وإن حد الصارم القرضابا","والذابلات السمر والعرابا",97,"ب",2,0],["وأنحى على قطَّانها غيرَ مُشفقٍ","بهم أو مجيلٍ فيهمو عينَ باصرِ",98,"ر",1,0],["وَإِن حالَ يَأسٌ دونَ لَيلى فَرُبَّما","أَتى اليَأسُ دونَ الشَيءِ وَهوَ حَبيبُ",99,"ب",1,0],["وَإِنَّ حُمَاة الضادِ تَشْهَدُ عِيدَهَا","يُعَيِّدُهُ بَادُونَ مِنْهُمْ وَحُضَّرُ",100,"ر",1,0],["وَأَنَّ حَبْراً حَمَى حِمَاكُمْ","أَضْحَى لَكُمْ عِنْدَهُ شَفِيعَا",101,"ع",2,0],["وانحنَت كلّ نخلَةٍ كجناحٍ","أخضرِ الريشِ ودّ لو كان زندا",102,"د",2,0],["وإن حَجَبَتْ بِيضَ الأيادي مَنِيَّةٌ","فليس على آثارهنّ حِجابُ",103,"ب",1,0],["وأنَ حِدادَ ليلِكِ طرَزتْه","دُموعٌ للثواكِل واليتامى",104,"م",2,0],["وانحازَ للرَّكْبِ الذي من آدمٍ","ما زَال يُزْعجنَا رَنِينُ حُدَاتِه",105,"ت",2,0],["وإن حاربتني صروفُ الزمان","شَهَرتُ عليها احتقاري سلاحًا",106,"ح",2,0],["وأنحت على ملك العراقين وانتهت","بتبت حتى واجهت خيلها السدا",107,"د",2,0],["وإن حبا الله حياها من يأت حيا","يوما وأسعف طالبا بما سألا",108,"ل",2,0],["وانحنَتْ فوقها الأمومةُ خرساءَ","تُزجّى يُسرى وتَرفع يُمنَى",109,"ن",2,0],["وإن حسيناً عثرةٌ في طريقه","فما اسطاعَ فليستغنِ ان يتعثَّرا",110,"ر",2,0],["وانحطَّ يَطلُبُ بَابِلاً ومَليكَها","فأَحاطَ بالملكِ الخْلِعِ النَّاسي",111,"س",2,0],["وإن حبّبَ اللَّهُ الحُسامَ إلى امرىءٍ،","حَباهُ بهِ، في كلّ مَفرَغةٍ، خَفرا",112,"ر",2,0],["وإن حقائق الحدثان تأتي","فتدمغ ترهات الجاهلينا",113,"ن",2,0],["وأنحى عن قطّانها غير مشفق","بهم أو مجيل فيهمو عين باصر",114,"ر",1,0],["وان حب ابي العباس معتقدي","عليه صافيت في الدنيا وصوفيت",115,"ت",1,0],["وانحطَّ عالى المرتقى","لكَ وارعوى صَعْبُ المرامِ",116,"م",1,0],["وإن حن رعدٌ في السحاب تصاعدتْ","لنا زفراتٌ واستهلتْ مدامعُ",117,"ع",1,0],["وإن حبيت فلا تُقْرط لذاكَ وإنْ","أبغضت فالحبُّ والبغضا على قَدَر",118,"ر",1,0],["وإنْ حَالَ البِعَادُ وطالَ هجرٌ","فإنى لستُ عنكم بالمُباعِدْ",119,"د",1,0],["وَإِن حَضَرَ الناسُ لَم يُخزِهِم","وَإِن وازَنوهُ بِقَرنٍ رَجَح",120,"ح",1,0],["وأنحَسَهَا إذَا رَهِبَت نُحوساً","وأسعَدَهَا إِذَا أمِنِت سُعُودُا",121,"د",2,0],["وانحياز إلى التُقي وارتياح","أتعبت منه كاتِبين كراما",122,"م",2,0],["وانحلال المركّباتِ قضاءٌ","فهو لا شكَ يلحقُ الأجساما",122,"م",2,0],["وَإِن حازَ مِقدارَ البَلاغَةِ ناشِئاً","فَما جارَ عَن مَسعى أَبيهِ وَلا صَدّا",123,"د",2,0],["وَإِنَّ حَديثَكَ السَيّارَ أَشهى","إِلى سَمعِ الطَروبِ مِنَ الأَغاني",124,"ي",1,0],["وإن حسنهم في أثرتي أثراً","أبو علي ولو أبعدت في الأثر",125,"ر",1,0],["وإن حملوا ظننت النَّا","ر تحت الرِّيح تستعر",126,"ر",1,0],["وَأَنْحَلَني فَلَو إِنْسانُ عَيني","تَضَمَّنَ جَفنُهُ جِسْمِي خَفِيتُ",127,"ت",1,0],["وإنّ حسامَ نور الدين دوني","إذا ما هزَّ يسبقهُ الفرارُ",128,"ر",1,0],["وإن حدثتني خلت أَن لسانها","يساقط دراً ينتقي ولأليا",129,"ي",2,0],["وَإِن حَجَّ قالوا لَيسَ لِلَّهِ حَجُّهُ","وَذاكَ رِياء أَنتَجَتهُ المَحافِلُ",130,"ل",1,0],["وَإِنَّ حُزني كَقَتيلِ كَربَلا","لَيسَ عَلى طُولِ البِلى بِمُقلِعِ",131,"ع",1,0],["وَإِن حُدِيَت بَعدَ الكَلالِ قَلائِصٌ","بِذكراهُ وَهناً زالَ عَنها كَلالُها",132,"ل",3,0],["وَإِن حارَبُوا قَوماً أَقامُوا وَأَقعَدُوا","وَإِن خُوطِبُوا يَوماً أَحَرّوا وَأَفحَمُوا",133,"م",3,0],["وَإِنَّ حَياةً هَكَذا لَذَمِيمَةٌ","يُسِرُّ المُعادي لِلمُعادي دَوامُها",134,"م",3,0],["وإن حَرْفي تواضَعَ قَيْد نَبْضٍ","فعذرًا مِنْكِ عَنْ فَقْرِ اقْتِرابي",135,"ب",2,0],["وَإِنَّ حنَّةَ بَعدَ الصَبرِ قَد ظَفِرَت","عِندَ الإِلَهِ بِفَردوسٍ بِهِ سَعِدَتْ",136,"ت",1,0],["وَاِنحَلََّ الحُزنُ اضلاعاً بِكَ اِضطَرَمَت","وَجداً فَلا لَقِيَت مِن سلوةٍ بَلَلا",137,"ل",2,0],["وإن حان وقت الإنصراف رأيتهم","يشقون أشداقا وساعا لينشدوا",138,"د",3,0],["وإن حلَّ الندامى فيها رأوا","لياليها مثل أسحارها",139,"ر",3,0],["وَأَنَّ حقوقَ الإِجتِماعِ خَليقَة","بِأَهلِيَّةٍ في الشَخصِ لا بِمَآرِبِ",140,"ب",1,0],["وَإِن حَفِظتَ فلا تَحفَظ سوى كلمٍ","غُرٍّ جوامع مِثلِ الآيِ وَالسُوَرِ",141,"ر",1,0],["وانحلّ عن مُلْكك عَقْدُ الأذى","قَسْراً وذلّت لك فيه الصِّعاب",142,"ب",1,0],["وإن حبك من إيماننا سبب","من دونه النفس والأموال والولد",143,"د",1,0],["وَاِنحَلَّ عِقدُ الجَوزاءِ وَاِنتَشَرَت","في الغَربِ مِنهُ لَآلِىءٌ بَدَدُ",144,"د",1,0],["وإِن حُجِبَت بِالسُمرِ وَالبيضِ غادَةٌ","فَليسَ لَها إِلّا غَلائِلِها حُجبُ",145,"ب",1,0],["وَإِنْ حَادَتْ بِنَا الأَهْوَاءُ يَوْماً","إِذَا شِمْنَا سَناً لَهُمُ اهْتَدَيْنَا",146,"ن",2,0],["وإن حرّكتني نحوكم نسمة الصبا","رأيت فؤاد الصبّ ينشد في الركب",147,"ب",1,0],["وانح بالمدح بابه","وله انعَت موكّدا",148,"د",2,0],["وان حملت أنامله يراعا","أراع به من اعتقل الصمادا",149,"د",2,0],["وإن حَفَروا بِئرِي حَفَرتُ بِئَارَهُم","لِيُعلَمَ يَوماً كَيفَ تِلكَ النَّبَائِثُ",150,"ث",1,0],["وإن حنبليا قلت قالوا بأنني","ثقيل حلولي بغيض مجسم",151,"م",1,0],["وإن حركت فيه الخلاعةُ نصلَها","تقطَّعتِ الأوتارُ من حدّةِ النّصل",152,"ل",1,0],["وإنَّ حميّةَ النُّعمانِ أزرَت","بكسرى أبرَوِيزَ وَرِيثِ دارا",153,"ر",2,0],["وان حضر الاخوان للذكر وَالبكا","حضرت كأني لاعب متفرج",154,"ج",1,0],["وإنْ حَجَبْتم عنِ الأبصارِ هَوْدجَها","فحاجب الشمس لا يخفى وإن حُجبا",155,"ب",2,0],["وَأَنْحَيْنَ حَتّى ما تَرَكْنَ بَوارِياً","عَلَى الْعَظْمِ منْ نَحْضٍ لِبارٍ وَلا جلْدِ",156,"د",1,0],["وَإِن حَمَلوا خِلتَ الأَعادي لَدَيهِم","بُغاثاً وَهُم فَوقَ الجِيادِ صُقورُ",157,"ر",1,0],["وإِن حَلَلتَ مَنزلَه","فاِجعل صَنيع الفضل لَه",158,"ه",1,0],["وإن حَرَّجَ الإنجيلُ وهو محرفُ","ففي صحة القرآن حلّ وضينها",159,"ن",3,0],["وَإنّ حبّكم زُلفى وودّكم","قُربى وَإِكباركم فرضٌ ومعتصمُ",160,"م",1,0],["وَاِنحلّ سلكُ القطرِ حتّى أنّه","في كلّ قطرٍ عقده منثورُ",161,"ر",1,0],["وانحلوه جبراً فليس يرجي","غير إحسانكم لهذي النحيله",162,"ل",2,0],["وَإنْ حَسُنَتْ قَصَائِدُ مِن حَبِيبٍ","فَدا حُسْنُ التَصائدِ والمَقَاصِدْ",163,"د",1,0],["وإنْ حَرَّمُوني علَى مَدْحِهِمْ","فَتِلكَ عُقُوبَةُ مَن يَفْتَرِي",164,"ر",2,0],["وإنْ حَمَلوا بالصَّالحيةِ قَبرَهُ","َفَدَمعي لهُ سَفْحٌ بِسَفْحِ المُقَطَّمِ",165,"م",1,0],["وَإِن حَمَلَتني ناقَتي نَحوَ دارِها","وَصَلتُ وَإَلّا مُتُّ في دارِ غُربَتي",166,"ي",1,0],["وَإِن حَرَّكتُ غَيري إِلى إِلى العَذلِ نِسمَةٌ","فَإِنّي لِأَهواءِ العَواذِلِ شامِخُ",167,"خ",1,0],["وَإِن حَياة لا تقضى بِحَمدهِ","وَتمداحه تِلكَ الحَياة غُرورُ",168,"ر",1,0],["وإن حاروا أو سالموا من نواهم","تكن حربهم حربا وسلمُهُم سلما",169,"م",2,0],["وَان حادَثته في العلم تَلقى","بُحورا موجها دَرّ النُخور",170,"ر",1,0],["وَاِن حدّثوني عَن فرات وَدَجلَة","وَجَدت النيل أَحلى اِذا مَرّا",171,"ر",2,0],["وإن حَدَّثَ الأقوامُ عن سَلَفٍ له","فأحْرِ بفَخْرٍ أن يَطولَ ويَعرُضا",172,"ض",2,0],["وإِن حَمَّلته المكرماتُ فأَثقَلَت","فأجدرُ أن لا يَستَطيعَ التوقُّفا",173,"ف",2,0],["وانحطَّ شأنُ ذكائها وسنائها","من ميم مركزها بدار الأجرَع",174,"ع",1,0],["وانحط منهبطاً لقعر جهنمٍ","متألماً ومُزمَّلاً بدمائه",175,"ا",3,0],["وَإِن حَياة نَفسي في","يَمينك دَعكَ مِن أَمري",176,"ي",1,0],["وَانحل جَسميَ أَعراضُهُ","فَجسميَ أَوهن مِن عَهدِهِ",177,"د",2,0],["وإن حالَتِ الأَيَّامُ بَيْني وبينكم","فباللهِ ألاَّ مَا مَرَرْتُم على قَبْري",178,"ي",1,0],["وأنحلتني بحراً من العلم زاخراً","وخوضتني ما لم أكن أتخوض",179,"ض",1,0],["وإن حذفت لامه","منه وحرف أُخرا",180,"ر",2,0],["وإنَّ حياتنا الدُّنيا غرورٌ","وسَعيٌ بالتكلُّف واعتناء",181,"ا",2,0],["وإنْ حاولوا مجداً فعزم محلّق","لهم أرج لم يكتَتَم فهو معبق",182,"ق",1,0],["وإن حلَّ نائله موطناً","ينادي الهنا بالعناء الرحيلا",183,"ل",2,0],["وإن حلبنا ما نروم دَرّه","كانت عزوزاً لا ترد بالروا",184,"ا",1,0],["وانْحُ الإمامَ أحمدا","أنْدى الورِ طُرّاً يَدا",185,"د",2,0],["وانْحُ بابَ الإمامِ سيّدِنا الحا","فظِ تظفَرْ بسائِرِ الأغراضِ",186,"ض",1,0],["وإِنْ حَمَتِ الآجالُ بَعْضَ حُماتِهِ","فإِنَّكَ فِي أَعجازِ ليلِهمُ صُبْحُ",187,"ح",1,0],["وأَنحى سيفُكَ الماضِي عليها","فَعذْنَ بسيفِ رحمتكَ الكهامِ",188,"م",1,0],["وأنحس من في الأرض من ضاق ذرعه","بأسباب من لا قط يعناه ضيقه",189,"ق",2,0],["وانحنى والفواد يخفق منه","وجنى وردة وسار هلوعا",190,"ع",2,0],["وان حياتى أن أموت بحبكم","وعيشي في أن الضنى لي منازل",191,"ل",1,0],["وإِن حَوْلتَه فعلاً","وصفق جدَّدَ الطربا",192,"ب",2,0],["وأن حجاباً عاقني عنك مؤذنٌ","بأني سأتلو منه غب النوى صُحفا",193,"ف",2,0],["وأنحى عليّ الصاغرون فزدتني","ولاء وقد كفرت من خص بي الكفرا",194,"ر",2,0],["وإن حسدت كأن البؤس لي شرف","وكل أهل الغنى في البؤس خدامي",195,"ي",1,0],["وإن حزنت لرهط لم يزل لهمو","شأن وخيرهمو أفعى وثعبان",196,"ن",1,0],["وَأَنَّ حَظَّ اِمرىءٍ غَيري سَيَبلُغُهُ","لا بُدَّ لا بُدَّ أَن يَحتازَهُ دوني",197,"ن",2,0],["وإن حدَّثوا عن شامهم وعراقهم","فعندك هندٌ لا ترام وصينُ",198,"ن",1,0],["وأنحتُ بالتقاضي منك صخرا","وداءُ المطل ينحَتُ من عظامي",199,"ي",1,0],["وأن حسودا ربّما كان غاظه","على حظّه بالعجزِ حظِّيَ منكُمُ",200,"م",1,0],["وإن حننتَ للحمى وروضِهِ","فبالغضا ماءٌ وروضاتٌ أُخَرْ",201,"ر",1,0],["وأن حِمَى هِبةِ اللّهِ لي","من الضيم لو رام ضيمي مجيرُ",202,"ر",1,0],["وإن حُجبتْ والريح تَسفِرُ بيننا","بنجوَى فؤادَيْنا فما ضَرَّت الحُجْبُ",203,"ب",1,0],["وإنْ حملوا خَلْطَ النُّحاس إلى الندى","حملتُ إليه خالص الذهب التِّبْرِ",204,"ر",1,0],["وَإِن حَجبوك عَن نَظري فَإِني","أَراكَ بِعَين فكري مِن مَكاني",205,"ي",1,0],["وانحاز للترك من فازت سياسته","وكان أجدر في الميدان باللعب",206,"ب",1,0],["وأنحلني حتى لقد كدت في الهوى","بمقلة وسنان أزج مثاليا",207,"ي",2,0],["وأنحو على منحى الفواتح فاغرا","مطلب آمالي ولا تبقى باقيه",208,"ي",2,0],["وإن حليت آخره","فهيج البحر كالقلل",209,"ل",1,0],["وانْحطَّ كلُّ ذوي العُلى","والمجدِ عن رُتَبِ ارْتِقائِكْ",210,"ك",1,0],["واِنحوا يَمينَ منىً فثمَّ منَ المُنى","سرٌّ بأحشاءِ المَنونِ محجَّبُ",211,"ب",1,0],["واِنْحُ الحِمى يا حَماكَ اللّهُ مُلتَمِساً","فكّ القلوبِ الأسارى عندَ أهليهِ",212,"ي",2,0],["وإن حقق التشبيه فيكم فإنما","طلعتم شموساً حين غابت بدورها",213,"ر",3,0],["وإن حسدتنا جنة الخلد قربه","فقربك منا جنة ونعيم",214,"م",1,0],["وإِنَّ حَياةً والْمَماتُ خِتامُها","لأَحْقَرُ عِنْدَ الْعَقْلِ مِنْ أَنْ تُؤَثَّرا",215,"ر",2,1],["وإنّ حَرُوني يومَ ينقاد مِقْوَدي","سريعٌ إلى الغايات غيرُ حَرونِ",216,"ن",1,0],["وإنْ حالتِ الهيئاتُ منك على البِلى","ففضلك ما بين الورى غيرُ حائلِ",217,"ل",1,0],["وَإِن حالَ قَومٌ عَن هُدىً وَتَغيّروا","فَإنّي بسمتِ القَصْدِ لم أتغيَّرِ",218,"ر",1,0],["وإنْ حجّبوك بنسْجِ الصّفيحِ","فغرُّ مساعيك لم تُحجَبِ",219,"ب",1,0],["وإن حجبت فكري","بكل ما أعاني",220,"ن",2,0],["وانحل شيئاً فشيئاً في الوجود وذب","حتى توافي مقاماً فيه تمكين",221,"ن",1,0],["وإن حجبتني عن سناها فإنني","بها حائر بل ثعلب الفكر رائغ",222,"غ",1,0],["وأَنْحُوهُنَّ بِالآلِ","فَمَرْعُوجٌ وَمَزْعُوجَهْ",223,"ج",2,0],["وانحنت السيوف في إيمانهم","وحطموا الرماح من طعانهم",224,"م",1,0],["وإِنَّ حُمّاك من نَارٍ توقُّدُهَا","في وَجنَةٍ لك لاَ تَخْبُو من الضَّرم",225,"م",1,0],["وإِنَّ حَالي لو أَنِّي أَقَمْتُ بِه","حالٍ كما أَنَّ عَيشي كان فِيه هَني",226,"ي",1,0],["وإِنَّ حُدَا حَادِي الحبيبِ غِنَاؤُه","وإِنَّ صَدى ربْع الحبيبِ انْتِحابُه",227,"ب",2,0],["وإِن حَرَّكتْه ذُكور الرّجال","تخيَّلْت ذاك كنيفاً فُتِح",228,"ح",1,0]]}