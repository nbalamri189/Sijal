ml","المديد"],[366,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[371,"كل من يستكفني يغريني","https://www.aldiwan.net/poem57066.html","الخفيف"],[403,"أي شيء يحتاج كل إليه","https://www.aldiwan.net/poem34129.html","الخفيف"],[416,"أيها السيد صبرا","https://www.aldiwan.net/poem53985.html","مجزوء الرمل"],[416,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[432,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[432,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[439,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[452,"وابق واسلم لوجنة الدهر خالا","https://www.aldiwan.net/poem13963.html","الخفيف"],[453,"صفية في حنانك لي عزاء","https://www.aldiwan.net/poem61585.html","الوافر"],[458,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[458,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[464,"قبح الله آب ما آب شهراً","https://www.aldiwan.net/poem3132.html","عموديه"],[464,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[464,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[538,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[551,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[551,"عج بوادي البشام علك أن تق","https://www.aldiwan.net/poem47214.html","الخفيف"],[551,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[551,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[551,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[551,"يا مليك الورى ومن عقد الله","https://www.aldiwan.net/poem48114.html","الطويل"],[562,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[567,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[575,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[579,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"]],"verses":[["أَيُّ شَيءٍ يا قَومُ أَطيَبُ مِن شَي","ءٍ سَقَتهُ مِن ريقِها فَسَقاني",0,"ي",1,0],["أَي شَبابَ النيلِ لا تَقعُد بِكُم","عَن خَطيرِ المَجدِ أَخطارُ السَفَر",1,"ر",1,0],["أَيَشتَكي الفَقرَ غادينا وَرائِحُنا","وَنَحنُ نَمشي عَلى أَرضٍ مِنَ الذَهَبِ",2,"ب",1,0],["أَيُّ شَيءٍ في الغَربِ قَد بَهَرَ النا","سَ جَمالاً وَلَم يَكُن مِنهُ عِندي",3,"ي",1,0],["أَيُّ شَعبٍ أَحَقُّ مِنّي بِعَيشٍ","وارِفِ الظِلِّ أَخضَرِ اللَونِ رَغدِ",3,"د",1,0],["أَيَشبَعُ مُصطَفى الخولي وَأُمسي","أُعالِجُ جَوعَتي في كِسرِ داري",4,"ي",1,0],["أَيُّ شَيءٍ تَراهُ حَقّاً يَقيناً","حالِما اعوَجَّ في الزَمانِ اِستَقاما",5,"م",2,1],["أي شجوٍ تثيره في حشا المش","تاق ذكرى سهولها والجبال",6,"ل",1,0],["أي شيء أنا الذي نال هذا ال","عطف منكم ما صحتي ما اعتلالي",7,"ي",1,0],["أي شأن كشأن من يخ","تم القول إذا ما تبارت الأحلام",8,"م",1,0],["أَيُّ شِعْرٍ أَيُّ نَثْرٍ مُجْزِيءٌ","مِنْ نَدًى يَجْرِي بِهِ الوَادِي الأَمِينْ",9,"ن",1,1],["أَيُّ شَمْسٍ لِعَيْنِهِ تَتَجَلَّى","فِي حَوَاشيكَ مِنْ وَرضاءِ الظَّلامِ",10,"م",1,0],["أَيُّ شَأْنٍ مَا نَحْنُ فِيهِ","شَأْنُ قَوْمٍ بِعَالِمٍ لَمْ يَقُومُوا",11,"م",3,0],["أَيُّ شَجْوٍ تُثِيرُهُ فِي حَشَى","المُشْتَاقِ ذِكْرَى سُهُولِهَا وَالجِبَالِ",12,"ل",1,0],["أيّ شيءٍ تريده بعد هذا","أخُنوع أم خَيْبة أم دَمار",13,"ر",1,0],["أَيَشهَدُ مَثغورٌ عَلَينا وَقَد رَأى","سُمَيرَةُ مِنّا في ثَناياهُ مَشهَدا",14,"د",2,0],["أَيَشغَلُكُم وَصفُ القَديمِ وَدونَهُ","مَفاخِرُ فيها شاغِلٌ وَمَآثِرُ",15,"ر",1,0],["أيّ شيء يا سيدي يبلغ النا","س ويصطادهم بكلّ مكان",16,"ن",1,1],["أي شيء أجلُّ قدراً من السي","فِ ليوم الكريهة العزَّاء",17,"ا",2,0],["أيُّ شيءٍ يكونُ أحسنَ منه","فارساً ماشياً على العَفْراءِ",17,"ا",2,0],["أيُّ شيءٍ يكابد الطفلُ في الدنْ","يا لأمرٍ ما يستهلُّ الوليدُ",18,"د",1,1],["أيَّ شيءٍ أقولُ أفحمْتَني عِيْ","ياً وبحري يفيضُ بالشّعر فيضا",19,"ض",2,0],["أي شيء أقول يا من عداه","في نداه التنكيد والتنكيظ",20,"ظ",1,0],["أي شيء أهدي إليك وفي وج","هك ما تشتهي النفوس جميعا",21,"ع",2,0],["أيشبع مولىً وعبدٌ له","يجوع مع الجائع النائع",22,"ع",1,0],["أَيَشتِمُني اِبنُ الكَلبِ أَن فاضَ دارِمٌ","عَلَيهِ وَرادى صَخرَةً ما يَرومُها",23,"م",3,0],["أَيُّ شَأنٍ يَقولُ في الكَونِ شَأني","لَستُ شَيئاً فيهِ وَلَستُ هَباءَ",24,"ا",2,0],["أَيُّ شَيءٍ في العيدِ أُهدي إِلَيكِ","يا مَلاكي وَكُلُّ شَيءٍ لَدَيكِ",25,"ك",1,1],["أَيُّ شَيءٍ وَجَدتَ في الأَرضِ بَعدي","قُلتُ إِنّي وَجَدتُ ماءً وَطينا",26,"ن",2,0],["أَيُشرِقُ الأُفقُ لَم يُطلِع كَواكِبَهُ","وَتَجمُلُ الأَرضُ لَم تُخرِج أَقاحيها",27,"ي",3,0],["أَيُّ شيءٍ تُراكِ هلْ أَنْتِ فينيسُ","تَهادتْ بَيْنَ الوَرَى مِنْ جديدِ",28,"د",1,0],["أي شيء يلقي بنفسك ريبا","من حديثي عن ذلك الاخلاد",29,"د",1,0],["أي شيء يضركم من حيادى","فاتركوني فيما أرى وحيادي",30,"ي",1,0],["أيشتمني سليمان بن فوزي","وبيبي في دي ومعي تَباق",31,"ق",1,0],["أيُّ شِعري نظَرتُ فيه لِضَبٍّ","أوحَدٍ ما لَهُ على الدهرِ عونُ",32,"ن",1,1],["أَيُّ شَيءٍ يَفي بِعَرفِكَ إِلّا","أَرَجُ المِسكِ في نَسيمِ الرِياحِ",33,"ح",1,0],["أَيَشفي مِنَ الهِجرانِ لا يَهتَدي الجَوى","لِقَلبِ بِهَجرِ الغانِياتِ عَميدِ",34,"د",1,0],["أَيَشُطُّ مَن أَهوى سَليماً وادِعاً","وَأَروحُ في ثَوبِ السَليبِ الفاقِدِ",35,"د",1,0],["أَيُّ شَيءٍ تُرى يَكونُ وَقَد كَثَّر","تَ فيهِ قَصرَ الكُمَيتِ وَقَصري",36,"ي",1,0],["أَيُّ شَيءٍ أَلهاكَ عَن سُرَّ مَن را","ءَ وَظِلٍ لِلعَيشِ فيها ظَليلِ",37,"ل",1,0],["أيشوقُني طَرَبُ الشَّبابِ وإنَّما","شَغَفُ الهِلالِ بحيثُ تمَّ وأشرَقا",38,"ق",2,0],["أَيُّ شَيءٍ أَبغي إِذا كانَ لي ظِل","لٌ وَقوتٌ حِلٌّ وَثَوبٌ سَتيرُ",39,"ر",1,0],["أَيُّ شَيءٍ يَكونُ أَعجَبُ مِمّا","يَلعَبُ الناسُ وَالفَناءُ سَريعُ",40,"ع",1,0],["أي شيء في الدهر كالألم الج","بار يجلو ضمائر الأحرارِ",41,"ر",1,0],["أيَشْكو بِحَرِّ الشوقِ مِنكَ الصّدى فَمٌ","وَماءُ المآقي فَوقَ خَدِّكَ هَطّالُ",42,"ل",1,0],["أَيُّ شَيءٍ أَنساكَ بَعدِيَ أَيما","نَكَ أَنّي أَبوكَ بَعدَ أَبيكا",43,"ك",2,0],["أَيُّ شَيءٍ يَكونُ أَحسَنَ مِن صَبٍّ","أَديبٍ مُتَيَّمٍ بِأَديبِ",44,"ب",1,0],["أَيُّ شَيءٍ إِلّا الأَمانِيُّ بَينَ ال","كُفرِ لَو فَكَّروا وَبَينَ الفُسوقِ",45,"ق",1,0],["أَيُّ شَيءٍ يَبْقَى عَلَى الْحَدَثَانِ","وَالْمَنَايَا خَصِيمَةُ الْحَيَوَانِ",46,"ن",1,1],["أَيُّ شَملٍ غَيرُ مُنصَدِعٍ","أَيُّ حَبلٍ غَيرُ مُنصَرِمِ",47,"م",1,0],["أيُّ شعبٍ بمثل ما نحن فيه","نال حُرّيةً أو استقلالا",48,"ل",2,0],["أَيَشغَلُ شاعِرَ الوَطَنِ المُفَدّى","سِواكَ وَأَنتَ شُغلُ بَني الزَمانِ",49,"ن",1,0],["أَيُّ شِبْرِيَّةٍ أَلَذُّ وِطاءً","مِنْ رُكُوبي وأَيُّما شَبَّارَهْ",50,"ر",2,0],["أَيُّ شَيءٍ بَعدَ أَنَّ ال","دَمعَ فيهِ لَيسَ يَرقا",51,"ق",2,0],["أَيَشتُمُ عِرضي الباهِليُّ بِعِرضِهِ","لَعَمرُكَ إِنّي بَعدَها لَمُشَتَّمُ",52,"م",1,1],["أَيُّ شَيءٍ أَجَلُّ مِن أَنَّ قَلبي","لَيسَ يَصحو وَلا أَراها تَجودُ",53,"د",1,0],["أيُّ شيء مُبْرِدٌ حَرّاً شَوى","للَشّوى حَشْوَ حَشَائي أيُّ شي",54,"ي",1,0],["أيّ شيءٍ حلوٍ إذا قَلَبُوهُ","بعدَ تصحيفِ بَعْضِهِ كان خِلوَا",55,"و",2,1],["أي شيء نخاف منهم وإنا","لو تحديناهم لجمٌّ غفير",56,"ر",1,0],["أي شيء في الدهر كالألم الجب","بار يجلو ضمائر الأحرارِ",57,"ر",1,0],["أيشكو الليلَ في كونٍ","من الأنوارِ مغمورِ",58,"ر",1,0],["أَيُّ شَيءٍ أَشْهَى إِلَى النَّفْسِ مِنْ كَأْ","سٍ مُدارٍ عَلَى بِساطِ نَباتِ",59,"ت",1,0],["أَيُّ شُكْرٍ مِنَ الَّذِينَ تَوَلَّوْا","أَنْ يَبَشُّوا إِلَى الَّذِينَ أَقَامُوا",60,"م",3,0],["أَيُّ شَأْنٍ رَعَاهُ لَمْ يَبْلُغِ","الشَّأْوَ الْمُعَلَّى وَلَمْ يَكُنْ بِعُجَابِ",61,"ب",1,0],["أَيُّ شَأْنٍ كَشَأْنِ مَنْ يَخْتِمُ","القَوْلَ إِذَا مَا تَبَارَتِ الأَعْلامُ",62,"م",1,0],["أَيَشْمَتُ فِينَا عَاذَلُونَ يَسُرُّهُمْ","تَفَرُّقُ هَذَا الشَّمْلِ بَعْدَ التَّأَلُّفِ",63,"ف",1,0],["أَيُّ شيءٍ كانَ نَيرون الَّذِي","عَبَدوهُ كان فَظَّ الطَّبْعِ غِرَّا",64,"ر",2,0],["أَيُّ شَيءٍ أَشْهَى إِلَى النَّفْسِ مِنْ","إِنصاتِ أَطْيَارِهَا وَفَيَّاضُ شَادِي",65,"د",2,0],["أَيشمتُكَ اليَومَ شَكوى اِمرئٍ","لَعَلَّكَ تَشكو غَداً ما شَكا",66,"ك",2,0],["أيشكو لئيمُ القومِ كَظّاً وبطْنَةً","ويَشْكو فتى الفتيانِ مسّ سُغُوبِ",67,"ب",1,0],["أيشرَبُ الراحَ أقوامٌ مشَعْشعَةً","وغيرُهُم يشربُ المِكروبَ إن شَرِبَا؟",68,"ب",2,0],["أيَشْهَدُ مصرعَها الغَرْبُ يومًا","كما شَهِد العُرْبُ ميلادها؟",69,"د",3,0],["أيشكو قلبُك الخفَّاقُ ضِيقًا","وقلبك لا يحيط به خَيَال؟",70,"ل",1,0],["أي شوق إليك أي اندفاعه","فلماذا جوعي قناعه",71,"ع",2,1],["أي شيء جرى ؟ وتصغي وتعدو","وتداري ، نشيجها فيعاند",72,"د",1,0],["أيّ شيء تسّر يا صمت ؟ تعلو","وجهه صخرتان ، شعثا وملسا",73,"س",2,0],["أيّ شيء أريد ؟ ما عدت أغفو","أقلق العصر مرقدي وشخيره",74,"ر",2,0],["أيّ شيء أنت ؟ يا جسر العدى","يا عميلا ، ليس يدري ما العمل",75,"ل",1,0],["أيشرق الأفق لم يطلق كواكبه","وتجمل الأرض لم تخرج أقاحيها",76,"ي",3,0],["أي شيءٍ ألهاك عن مركب الن","نيلِ وقد كنت لأتني عنه قبلا",77,"ل",2,0],["أيُّ شخصٍ لم يمس في أسْرِ جدواه","فكلٌّ ترَاه من أسَرَائِه",78,"ا",3,0],["أيّ شىءٍ ألذُّ من نظرِ العا","شقِ في وجهِ حِبّهِ المعشُوقِ",79,"ق",1,0],["أَيُّ شَيءٍ دَهاكَ أَوغالَ مَرآ","كَ وَهَل أَقدَمَت عَلَيهِ المَنونُ",80,"ن",1,0],["أي شخص فؤاده كفؤادي","لم يشدّ الردى عليه نطاقا",81,"ق",2,0],["أَيُّ شَيْءٍ أَمَرُّ مِنْ يَوْمِ بَيْنٍ","وفِراقٍ لِصَاحِبٍ وأَنيسِ",82,"س",1,1],["أَيُّ شيءٍ يَكون أَفجعَ عندي","من مُحِبٍّ قَد بانَ عَنه الحَبيبُ",83,"ب",1,0],["أيُّ شَوقٍ في فُؤادي اِضطَرما","جَفّفَ الدمعَ فلَم ينبجسِ",84,"س",1,0],["أيشقى الليث والهفى","عليه ويسعد القرد",85,"د",1,0],["أيّ شَيءٍ أشدّ من فَقد إلفٍ","بعد أُنس الهوى وطِيب العناقِ",86,"ق",1,0],["أيشقى الثرى بالماء حتى يعوده","أطباء علامون بالجزر والمد",87,"د",1,0],["أَيُّ شَيءٍ أَلَذُّ مِن صَوتِ شادٍ","حَسَنِ الوَجهِ لا أَمَل سَماعَه",88,"ع",2,0],["أَيُّ شَملٍ ما رَماهُ","بِشَتاتٍ وَاِفتِراقِ",89,"ق",1,0],["أيشمخ مغلوب ويهدأ غالب","ويصفح مظلوم ويترك مذنب",90,"ب",1,0],["أيْ شريكي في الهوى رفْ","قاً بحالي، بَعْدُ خذني",91,"ن",2,0],["أي شيءٍ تريد تعمل بي اليو","م فهذا أنا وأنت وشعري",92,"ي",1,0],["أي شيء عندنا أشهى لنا","من لقاكم حاشا لو كان عسل",93,"ل",1,0],["أيّ شيءٍ هو أغلى من لآلي الأدمع؟","هل رأَتْ عيناك دراً غيرها في الأعين",94,"ن",1,0],["أيّ شيءٍ تبعث الراحُ به","من أمانٍ وَنعيم وَسرور",95,"ر",1,0],["أَيُّ شيءٍ يُشابهُ الأفلاكَ","وَيباري سريعهنَّ حِراكا",96,"ك",2,1],["أَيُّ شُكرٍ بِهِ يَقومُ لِساني","أَفَأَعلوا عَن قُدرَةِ الإِنسانِ",97,"ن",1,1],["أي شيء جنيته من لياليك سوى"