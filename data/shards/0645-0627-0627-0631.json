.com/ViewPoem.aspx?id=46410",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[6177,"لله درّ الوصل بالإيميل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81090&r=&rc=37",""],[6225,"شكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80956&r=&rc=225",""],[6251,"صديقُ المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76479&r=&rc=19",""],[6290,"بِكُلِّ بَلِيَّةٍ يَزْداَدُ سِنِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85161&r=&rc=9",""],[6331,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82025&r=&rc=6",""],[4222,"كان عهدي بفلان شائبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52918&r=&rc=210",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""],[572,"ما أرتضي عَنْكَ بالرّياضِ غِنَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9480&r=&rc=337",""]],"verses":[["ما أُراني إِلّا سَأَهجُرُ مَن لَي","سَ يَراني أَقوى عَلى الهِجرانِ",0,"ن",1,1],["ما أُراني عَن حَبيبي","آخِرَ الدَهرِ نَزوعا",1,"ع",2,0],["ما أرْعَدَ ركْضُ سَنابِكِها","إلاّ والصّارِمُ قدْ فَرِقا",2,"ق",2,0],["ما ارْتَدى بالغيْثِ روْضٌ فرَوَتْ","نسْمَةُ الرّيحِ عنِ الزّهْرِ خبَرْ",3,"ر",1,0],["ما أَرانا نَقولُ إِلّا رَجيعاً","وَمُعاداً مِن قَولِنا مَكرورا",4,"ر",2,0],["ما أَرى ذائِداً يَزيدُ عَلَيهِ","غابَ عَنهُ أَنصارُهُ مَكثورا",4,"ر",2,0],["ما أَرسَلَت قَوسُ الحَواجِبِ أَسهُماً","مِن لَحظِهِ إِلّا أَصابَت مَقتَلا",5,"ل",2,0],["مَا أَرَى فِي الثَّنَاءِ أَبْلَغَ مِمَّا","نِلْتَهُ مِنْ رِضَا المَقَامِ العَالِي",6,"ل",2,0],["ما أرض مصر ولا أرض العراق لها","إلاّ جناحان من عطف ومن حدب",7,"ب",1,0],["ما أَرضى بِنُصحِ بَني كُلَيبٍ","وَما أَنا عَن عَريفِهِمُ بِراضي",8,"ض",2,1],["ما أرى الدهرُ غيرَنا زهدَ الأف","ضل والحال ممكن المطلوب",9,"ب",1,0],["ما أراه إلا أبا نصر وقت","مالك ناصر لقصدي الجليّ",10,"ل",2,0],["ما ارتوت منه مقلة طالما شقت","عليه ستائر الظلماء",11,"ا",2,0],["ما أُراني إذا خبطتُ بدَلْوي","جُمَّةَ الماءِ بالقليل النصيبِ",12,"ب",1,0],["ما أرى من مُشَرَّدٍ غير خصمي","كَ وإلا مُبِيدَهُ ومُبيدَكْ",13,"ك",1,0],["ما أراني غَلِطْتُ في العبد بل قل","ت بتقليد سيدٍ بِرْعيس",14,"س",1,0],["ما أرادَ الوشاة مني أراني ال","لَهُ بالسقم والضنى كلَّ واشي",15,"ش",2,0],["ما أرى مدحي لمجد","غير ذاك المجد لفقا",16,"ق",2,0],["ما أراهُمْ بذلك الفعلِ إلا","زهَّدوا الناسَ في البلاءِ الجميلِ",17,"ل",1,0],["ما أرى ذاك غيرَ نحلي لك الود","دَ وحوكي ثيابه وانتحالي",18,"ل",2,0],["ما أراني أُسيِّرُ الشعرَ فيها","سيرها في سُهولها والحُزوم",19,"م",1,0],["ما أرى لي في رَبْعِ حُبٍّ إذا لم","أحظَ فيه بنائل من مُقام",20,"م",1,0],["ما أَرى الناسَ سِوى ال","عُشّاقِ مِن كُلِّ الأَنامِ",21,"م",1,0],["ما أُراني الدَهرَ مِمّا","عَوَّدَت نُعماكَ أَخلو",22,"ل",2,0],["ما أَرى الشِدَّةَ إِلّا","كُلَّما مَرَّت تَزيدُ",23,"د",1,0],["مَا أَرقَّ الشَّبابَ في جسمِكِ الغَضِّ","وفي جيدكِ البديعِ الثَّمينِ",24,"ن",1,0],["ما ارى ان يطيب لي العيش الا","بين جن يبدون في زي انس",25,"س",1,0],["ما أَرى الحَبَّةَ إِلّا","سُرِقَت مِن بَيتِ نَملَه",26,"ل",2,0],["ما اِرتَضى الهُرمُزانُ شامِطَ باقي","أَن تُدعى لَهُ وَلا أُعَمِّرَ بَثّي",27,"ث",2,0],["ما أَرى الرَكبَ دونَ أَبَروجِردٍ","نازِلي حِلَّةَ العَطايا الجَزيلَه",28,"ل",2,0],["ما اِرتادَ مُرتادُ رَيبِ الدَهرِ مِن سَبَبٍ","إِلى النُفوسِ بِمِثلِ الأَعيُنِ النُجُلِ",29,"ل",1,0],["ما أَرى البَينَ مُخلِياً مِن وَداعٍ","أَنفُسَ العاشِقينَ حَتّى تَبينا",30,"ن",2,0],["ما أَرى بَدءَ طِلابي","لَكَ إِلّا بَدءَ حَيني",31,"ن",2,0],["ما أَرى الدُنيا عَلى كُلِّ حَيٍّ","نالَها إِلّا أَذىً وَعَذابا",32,"ب",2,0],["ما اِرتَدَّ طَرفُ اِمرِئٍ بِلَحظَتِهِ","إِلّا وَشَيءٌ يَموتُ مِن جَسَدِه",33,"ه",1,0],["ما أَربَحَ اللَهُ في الدُنيا تِجارَةَ إِن","سانٍ يَرى أَنَّها مِن نَفسِهِ عِوَضُ",34,"ض",1,0],["ما أَرى خالِداً عَلى قِلَّةِ الما","لِ وَلا باقِياً لِكَثرَةِ مالِ",35,"ل",1,0],["ما أَرى لي ظالِماً غَيرَ نَفسي","وَيحَ نَفسي ما لِنَفسي وَمالي",36,"ل",2,0],["ما أَرى حُبَّكَ إِلّا","بالِغاً بي فَوقَ حَدِّه",37,"د",2,0],["ما أَرسَلَتِ الرُقادَ إِلّا شَرَكاً","تَ