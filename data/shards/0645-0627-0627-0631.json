,"https://www.aldiwan.net/poem33353.html","الرمل"],[404,"قد رأينا ما دار في الريحان","https://www.aldiwan.net/poem33368.html","الخفيف"],[404,"هذي مناسك أحمد وصفاته","https://www.aldiwan.net/poem33477.html","الكامل"],[404,"يا قمرا في قباء أزرق","https://www.aldiwan.net/poem34121.html","السريع"],[410,"يا ناق شطت دارهم فحني","https://www.aldiwan.net/poem32367.html","الرجز"],[410,"يا ملولا قلما يرعي","https://www.aldiwan.net/poem32601.html","مجزوء الرمل"],[417,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[417,"قد ركبنا بمركب الدخان","https://www.aldiwan.net/poem53823.html","الخفيف"],[417,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[417,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[433,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[447,"طفلة ما ابنة المجلل بيضاء","https://www.aldiwan.net/poem23940.html","الخفيف"],[459,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[469,"يا غزالا رضابه سلسبيل","https://www.aldiwan.net/poem59760.html","الوافر"],[480,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[507,"يا وفود الله فزتم بالمنى","https://www.aldiwan.net/poem2397.html","الرمل"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[539,"كلما تهت دلالا","https://www.aldiwan.net/poem47979.html","عموديه"],[545,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[552,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[552,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"],[568,"ما أرتجي بالرياض فيك غنى","https://www.aldiwan.net/poem69493.html","المنسرح"],[576,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"]],"verses":[["ما أُراني إِلّا سَأَهجُرُ مَن لَي","سَ يَراني أَقوى عَلى الهِجرانِ",0,"ن",1,1],["ما أُراني عَن حَبيبي","آخِرَ الدَهرِ نَزوعا",1,"ع",2,0],["ما أرْعَدَ ركْضُ سَنابِكِها","إلاّ والصّارِمُ قدْ فَرِقا",2,"ق",2,0],["ما ارْتَدى بالغيْثِ روْضٌ فرَوَتْ","نسْمَةُ الرّيحِ عنِ الزّهْرِ خبَرْ",3,"ر",1,0],["ما أَرانا نَقولُ إِلّا رَجيعاً","وَمُعاداً مِن قَولِنا مَكرورا",4,"ر",2,0],["ما أَرى ذائِداً يَزيدُ عَلَيهِ","غابَ عَنهُ أَنصارُهُ مَكثورا",4,"ر",2,0],["ما أَرسَلَت قَوسُ الحَواجِبِ أَسهُماً","مِن لَحظِهِ إِلّا أَصابَت مَقتَلا",5,"ل",2,0],["مَا أَرَى فِي الثَّنَاءِ أَبْلَغَ مِمَّا","نِلْتَهُ مِنْ رِضَا المَقَامِ العَالِي",6,"ل",2,0],["ما أرض مصر ولا أرض العراق لها","إلاّ جناحان من عطف ومن حدب",7,"ب",1,0],["ما أَرضى بِنُصحِ بَني كُلَيبٍ","وَما أَنا عَن عَريفِهِمُ بِراضي",8,"ض",2,1],["ما أرى الدهرُ غيرَنا زهدَ الأف","ضل والحال ممكن المطلوب",9,"ب",1,0],["ما أراه إلا أبا نصر وقت","مالك ناصر لقصدي الجليّ",10,"ل",2,0],["ما ارتوت منه مقلة طالما شقت","عليه ستائر الظلماء",11,"ا",2,0],["ما أُراني إذا خبطتُ بدَلْوي","جُمَّةَ الماءِ بالقليل النصيبِ",12,"ب",1,0],["ما أرى من مُشَرَّدٍ غير خصمي","كَ وإلا مُبِيدَهُ ومُبيدَكْ",13,"ك",1,0],["ما أراني غَلِطْتُ في العبد بل قل","ت بتقليد سيدٍ بِرْعيس",14,"س",1,0],["ما أرادَ الوشاة مني أراني ال","لَهُ بالسقم والضنى كلَّ واشي",15,"ش",2,0],["ما أرى مدحي لمجد","غير ذاك المجد لفقا",16,"ق",2,0],["ما أراهُمْ بذلك الفعلِ إلا","زهَّدوا الناسَ في البلاءِ الجميلِ",17,"ل",1,0],["ما أرى ذاك غيرَ نحلي لك الود","دَ وحوكي ثيابه وانتحالي",18,"ل",2,0],["ما أراني أُسيِّرُ الشعرَ فيها","سيرها في سُهولها والحُزوم",19,"م",1,0],["ما أرى لي في رَبْعِ حُبٍّ إذا لم","أحظَ فيه بنائل من مُقام",20,"م",1,0],["ما أَرى الناسَ سِوى ال","عُشّاقِ مِن كُلِّ الأَنامِ",21,"م",1,0],["ما أُراني الدَهرَ مِمّا","عَوَّدَت نُعماكَ أَخلو",22,"ل",2,0],["ما أَرى الشِدَّةَ إِلّا","كُلَّما مَرَّت تَزيدُ",23,"د",1,0],["مَا أَرقَّ الشَّبابَ في جسمِكِ الغَضِّ","وفي جيدكِ البديعِ الثَّمينِ",24,"ن",1,0],["ما ارى ان يطيب لي العيش الا","بين جن يبدون في زي انس",25,"س",1,0],["ما أَرى الحَبَّةَ إِلّا","سُرِقَت مِن بَيتِ نَملَه",26,"ل",2,0],["ما اِرتَضى الهُرمُزانُ شامِطَ باقي","أَن تُدعى لَهُ وَلا أُعَمِّرَ بَثّي",27,"ث",2,0],["ما أَرى الرَكبَ دونَ أَبَروجِردٍ","نازِلي حِلَّةَ العَطايا الجَزيلَه",28,"ل",2,0],["ما اِرتادَ مُرتادُ رَيبِ الدَهرِ مِن سَبَبٍ","إِلى النُفوسِ بِمِثلِ الأَعيُنِ النُجُلِ",29,"ل",1,0],["ما أَرى البَينَ مُخلِياً مِن وَداعٍ","أَنفُسَ العاشِقينَ حَتّى تَبينا",30,"ن",2,0],["ما أَرى بَدءَ طِلابي","لَكَ إِلّا بَدءَ حَيني",31,"ن",2,0],["ما أَرى الدُنيا عَلى كُلِّ حَيٍّ","نالَها إِلّا أَذىً وَعَذابا",32,"ب",2,0],["ما اِرتَدَّ طَرفُ اِمرِئٍ بِلَحظَتِهِ","إِلّا وَشَيءٌ يَموتُ مِن جَسَدِه",33,"ه",1,0],["ما أَربَحَ اللَهُ في الدُنيا تِجارَةَ إِن","سانٍ يَرى أَنَّها مِن نَفسِهِ عِوَضُ",34,"ض",1,0],["ما أَرى خالِداً عَلى قِلَّةِ الما","لِ وَلا باقِياً لِكَثرَةِ مالِ",35,"ل",1,0],["ما أَرى لي ظالِماً غَيرَ نَفسي","وَيحَ نَفسي ما لِنَفسي وَمالي",36,"ل",2,0],["ما أَرى حُبَّكَ إِلّا","بالِغاً بي فَوقَ حَدِّه",37,"د",2,0],["ما أَرسَلَتِ الرُقادَ إِلّا شَرَكاً","تَصطادُ بِهِ شَوارِدَ الغِزلانِ",38,"ن",1,0],["ما أرَى دمعيَ إلّا دَمَها","ربَّما احمَرّ على خَدّي وَساح",39,"ح",1,0],["ما أَراني أَراكَ نَصبَ خَيالٍ","طارِقٍ أَو يَصيرَ جِسمي خَيالا",40,"ل",2,0],["ما أُراهُ إِلّا سَيَقضي عَلَيهِ","ناظِرُ الحُبِّ خَشيَةَ أَن تَبينا",41,"ن",2,0],["ما أَرى ما حَيِّيتُ أَن أَذكُرَ المَو","قِفَ مِنها بِالخَيفِ إِلّا شَجاني",42,"ن",2,0],["ما اِرتابَ أَنَّ سُرورَهُ لِكَآبَةٍ","يَوماً وَأَنَّ بَقاءَهُ لَفَناءِ",43,"ا",2,0],["ما أَرى الخالَ فَوقَ خَدَّ","يكَ لَيلاً عَلى فَلَق",44,"ق",1,0],["ما أَراني وَإِن تَحَلّى لِيَ الإِخ","وانُ مِن بَعدِهِ لَهُم مُستَلَذّا",45,"ذ",2,0],["ما أَرى في الهَوى لِإِبليسَ ذَنباً","إِنَّ عَيني قادَت وَأَنتَ اِتَّبَعتا",46,"ت",2,0],["ما اِرتَدَّ طَرفُ اِمرِئٍ بِلَذَّتِهِ","إِلّا وَشَيءٌ يَموتُ مِن جَسَدِه",47,"ه",1,0],["ما اِرتَدَّ طَرفُ مُحَمَّدٍ","إِلّا أَتى ضَرّاً وَنَفعا",48,"ع",2,1],["ما أَرى خالِيَينِ لِلسِرِّ إِلّا","قُلتُ ما يَخلُوانِ إِلّا لِشاني",49,"ن",2,0],["ما أَرى لِلأَنامِ وُدّاً صَحيحاً","عادَ كُلُّ الأَنامِ زوراً وَمَينا",50,"ن",2,0],["ما أَراكَ الدَهرَ إِلّا شاخِصاً","دائِبَ الرِحلَةِ في غَيرِ غَنا",51,"ا",1,0],["ما أرادا إلا عذاب ضميري","بعد أن إيفَ جسمي المقطور",52,"ر",1,0],["ما أَرادَ القرآن إِلّا هداهم","وَكذاكَ التَوراة والانجيل",53,"ل",1,0],["ما أَرى لهم رشداً","سالموا أو احتربوا",54,"ب",3,0],["ما أَرى في جواهر الجسم إلا","قوة قد تكاثَفَت في البناء",55,"ا",2,0],["ما أَرى الأَيام بالأش","ياء إلا دائراتِ",56,"ت",1,1],["ما أراها أخطأتْ في وهمِنا","عالَم الغابةِ أو مَهْد الجدودِ",57,"د",1,0],["ما أرى في سماتِ وجهك إلَّا","شبَحاً رائعاً وحُلماً وَجيعا",58,"ع",2,0],["مَا أَرْوَحَ الأَمَلَ الَّذِي قِيَّضْتَهُ","لِسَوَادِ أُمَّتِكَ الأَمِينِ الوَادِعِ",59,"ع",1,0],["ما ارتوى الطفل بالحليب ولا","الشيخ رواه طوافه بالمناهل",60,"ل",1,0],["ما أراني من غيرهِ غير ثوبٍ","ضمَّ أردانَه على عِلاّتهْ",61,"ت",2,0],["ما ارتاعَ مِن حبسٍ ولا أسرٍ ولا","زَجْرٍ ولا قتلٍ ولا إرجَافِ",62,"ف",1,0],["ما أرانا إلا أسَرْنَاك أسرًا","بقيودٍ مشدودةِ الحلَقات",63,"ت",1,0],["ما أُراهم يُلقون شعرًا، ولكن","يحصبون الأسماع بالجُلمود",64,"د",1,0],["ما أرجي في العيش بعد نداما","ي أرهم سقوا بكأس حلاق",65,"ق",1,0],["ما أرقَّ الأصيلَ سال بشفَّافِ","شعاعٍ منه الفضاءُ الرحيب",66,"ب",1,0],["ما أرى من مُشَرَّدٍ غير خصيمك","وإلا مُبِيدَهُ ومُبيدَكْ",67,"ك",1,0],["ما أراني أسيَّر الشعر فيها","سيرَها في سهوله والخروم",68,"م",1,0],["ما أراك الدَّهرَ إلاَّ شاخصاً","دائِب الرِّحْلَة ِ في غيْرِ عَنَا",69,"ا",1,0],["ما ارفع المعشوق في دسته","ما اهون العاشق ما اتعبا",70,"ب",2,0],["ما أروعَ الزَهرةَ السوداءَ قد سُقِيَت","بدمعةِ القلبِ تَحميها يَدُ الياسِ",71,"س",1,0],["ما أُراهُ يعود","بل سيغدو الوَقُود",72,"د",1,0],["ما ارتباَ مُبصِرُها في كَفِّ ذاكَ وذا","أن النجومَ استحالت للورى ذهبا",73,"ب",2,0],["مَا أَرْطَبَ العَيْشَ في ذَرَاكَ وَمَا","أَهْنَا النَّدى في جَنَابِكَ الْلَّيْنِ",74,"ن",1,0],["مَا أَرَدْنا الفِراقَ لا كانَ مِنَّا","أَشْمَتَ اللَهُ بِالفِراقِ التَّلاقي",75,"ي",1,0],["ما أرتنا من رؤاها عجبا ً","وارتنا الغصَّةَ المعتبرة",76,"ر",2,0],["ما أَرْغَب الناسَ في الحياةِ ولا","ترغب في راغبٍ ولا تُشْفِق",77,"ق",1,0],["ما أرى غير مضمر ضد ما يظ","هر من قوله على التأويل",78,"ل",1,0],["ما أراه أغراك بالهجر إلا","طول صبري وأنّني مستورُ",79,"ر",1,0],["ما أرى علما يعلم تلمي","ذا مليحا بطالع محسوب",80,"ب",1,0],["ما أرى هذهِ الشهامةَ إلّا","حمقاً من فظاظةِ الأكبادِ",81,"د",1,0],["ما أراني أحيا كذا","فاسمحوا لي أموتُ",82,"ت",1,0],["ما أَرى إِنَّ ما أَراهُ وَجيعُ","وَوَجيعٌ ما تَحتَويهِ الضُلوعُ",83,"ع",1,1],["ما اِرتاحَ ذو طَرَبٍ وَما","حَنَّ الأَليفُ إِلى الأَليفِ",84,"ف",1,0],["ما أرى البوم وجهه","قط إلا تطيرا",85,"ر",2,0],["ما أرى مثله فلا","نٌ قضيماً لدلدل",86,"ل",1,0],["ما أرحبَ القفر للأحرارِ إن طلبوا","ثأراً وقد شربوا في ذلهم صابا",87,"ب",2,0],["ما أَراني إِلّا سَأَترُك بَغدا","د وَأَهوى لَكورَةِ الأَهوازِ",88,"ز",1,1],["ما ارتدَّ مذْ سار في سهلٍ وَلا جبل","كذاك يبلغ إِن لمْ ينكصِ الناحي",89,"ح",2,0],["ما أَراكَ مُشَمِّراً وَاللَيالي","وَسَوفَ تَدنى إِلَيكَ ما هُوَ آتِ",90,"ت",1,0],["ما اِرتدّ طَرفي عن مخيلةِ ومضهِ","حتّى تدفّق صوبه مِدرارا",91,"ر",2,0],["ما أرى نفسي إلا أنتم","واعتقادي أنكم أنتم أنا",92,"ن",2,0],["ما أردت الوجود قبلَ وجودي","وبرغمي بعد الوجود الفناء",93,"ا",2,0],["ما أرى العدل بينكم غير بيتٍ","رافعوه في الناسِ هم هادموه",94,"ه",1,0],["ما اِرتَعد البازيُّ وَاللَه من","صَرير زَنبور وَلا جُندبِ",95,"ب",1,0],["ما أرسلَتْ يدُه عِنانَ مُطهّمٍ","إلاّ ويأتيهِ النّجاحُ إذا ثَنَى",96,"ن",2,0],["ما ارتدّ طرْفُكِ يوما نحوَ بَسْمَلتي","حتى تسامتْ إلى العلياءِ بسملتي",97,"ت",2,0],["ما أردفت حُزني كُلومُ طويتي","إلّا انذهلت فجاوبتني الحوقَلَهْ",98,"ل",2,0],["ما أرفع شكايتي الإله","سبحانه المفضل المنان",99,"ن",1,0],["ما ارتضى الدنيا ولا زهرتها","وأثاثاً حسناً فيها وريا",100,"ي",2,0],["ما أراكم عن غائب قد نصبتم","وهو شرط بواضح البرهان",101,"ن",1,0],["ما أرسل الرحمن غير محمد","فينا فيرضيه اتباع رسوله",102,"ل",2,0],["ما ارتكب المحظور في عمره","لكنه يعبث بالواجب",103,"ب",1,0],["ما أرزَمَتْ وَهْناً لفقد إلْفِها","إلاّ رَمتْ جَوارِحي بِوَهْنِ",104,"ن",1,0],["مَا أرى لي منك في حَا","لِ الرّضا والسُّخطِ بُدّا",105,"د",2,0],["ما أراحَتْ يوماً من النَّاس حيًّا","بلْ أساءتْ إليه مَوتاً ومحيا",106,"ي",2,0],[