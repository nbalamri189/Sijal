{"poems":[[287,"أما كفاني طرف منك نبال","https://www.aldiwan.net/poem32665.html","البسيط"],[287,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[287,"يا لائمي في المليح","https://www.aldiwan.net/poem32818.html","المجتث"],[308,"بي غادة لم ترض بدر الدجا","https://www.aldiwan.net/poem58088.html","السريع"],[308,"بي غزال لما أطعت هواه","https://www.aldiwan.net/poem58131.html","الخفيف"],[385,"تنسمي بالله ريح نجد","https://www.aldiwan.net/poem49209.html","الرجز"],[415,"ما أنت أول من تناءت داره","https://www.aldiwan.net/poem32482.html","الكامل"],[469,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[580,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62587","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120008","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203795","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133858","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108533","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123302","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106900","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100404","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100300","الخفيف"],[4120,"","https://poetry.dctabudhabi.ae/diwan/poem/142548","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72630","الخفيف"],[4755,"حَجْر الله\" الصحي","https://www.poetsgate.com/ViewPoem.aspx?id=211332",""],[5674,"أنيس ليل لا أطيق سهاده","https://www.poetsgate.com/ViewPoem.aspx?id=190390",""],[5741,"بي غزالٌ يغزو الورى بجفون","https://www.poetsgate.com/ViewPoem.aspx?id=187443",""],[308,"بي غادة لم ترض بدر الدجا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613718",""]],"verses":[["بي غُلَّةٌ وَشِفائي بَردُ ريقَتِهِ","مِن أُقحُوانِ الثَنايا فَهوَ سَلسالُ",0,"ل",1,0],["بي غادَةٌ سَمراءُ مِثلُ الأَسمَرِ","تَهتَزُّ في مَتنِ الكَثيبِ الأَعفَرِ",1,"ر",1,1],["بي غُصنُ بانة حِقفٍ","يَهتَزُّ مِن تَحتِ يوحِ",2,"ح",1,0],["بي غادةٌ لم ترض بدر الدجا","يبيت في خدمتها يسرى",3,"ر",2,1],["بي غزالٌ لما أطعت هواهُ","أخذ القلب والتصبر غصبا",4,"ب",2,1],["بي غَيرِهِ كُلُّ جُنون دونَها","وَهِيَ بَدين الحُب عَين الرُشد",5,"د",1,0],["بِي غُلّةٌ أقضِي بهَا من حُبِّه","وأرى الورُودَ يذودُ عنه عارُهُ",6,"ر",2,0],["بي غلّة للبعدِ والعدواء","تروى من روايك",7,"ك",1,0],["بي غُلةٌ فِي الحَشَا عَلَيهِ فَلَوْ","وَردت صدّاً لما نقَعَتْ ًصَدى",8,"د",2,0],["بي غريرات جفون","هي كالسيف غرارا",9,"ر",2,0],["بي غرام لمهجتي قاهريٌّ","منبئٌ عن دلائل الاعجازِ",10,"ز",1,0],["بي غلة ما تنطفي","بِسوى رضابك والتياحُ",11,"ح",1,0],["بي غصة أن نغني في مواكبها","وأنت بالبسمة الخرساء تلقانا",12,"ن",2,0],["بي غبطة بعض حكاياتها","مطالع الأنجم خلف الجواء",13,"ا",2,0],["بي غادةٌ في الشرق يشرق نورها","فيقول هذا نور نور المغرب",14,"ب",1,1],["بي غزال كم أصابت","مُقلتاه من نفر",15,"ر",1,1],["بي غلة لم أبت أشكو توقدها","لو جاد لي ريقه منها بتبريد",16,"د",1,0],["بي غيرة تشعرني أنها","موت فؤادي الكاظم المحنَقِ",17,"ق",1,0],["بي غزالا بمغانيه اغنَّا","راح ينحو البان والوادي الاغنا",18,"ن",2,0],["بي غزالا بالأجرعين أغنّاً","شادنا علَّم الغزال النفارا",19,"ر",2,0],["بي غربةٌ كغربةِ النخيل","يموجُ في ذا الشارعِ الطويل",20,"ل",1,1],["بي غرير شاماته وجعوده","آل فرعون لحظه وجنوده",21,"ه",1,1],["بي غَريبٌ يَقُولُ لِي: لا تُفَكِّر","باحتِمالٍ، أَو احتَمِل مِنهُ صَفعَة",22,"ع",2,0],["بي غصةٌ والروحُ روحُ مُوَدِّعٍ","والجُرحُ منْ نزفٍ يسوقُ عنادٓهْ",23,"د",2,0],["بي غزالٌ يغزو الورى بجفون","كل يومٍ سيوفها مشهوره",24,"ه",1,1],["بي غادةٌ لم ترض بدر الدجا","يبيت في خدمتها يشرى",25,"ر",2,1]]}