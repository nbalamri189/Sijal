{"poems":[[9,"خالط القلب هموم وحزن","https://www.aldiwan.net/poem21988.html","الرمل"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[30,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[63,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[422,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64738","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75687","الطويل"]],"verses":[["بِمَتاليفَ أَهانوا مالَهُم","لِغِناءٍ وَلِلِعبٍ وَأَذَن",0,"ن",1,0],["بِمُتلِفٍ وَمُفيدٍ لا يَمُنُّ وَلا","تُهلِكُهُ النَفسُ فيما فاتَهُ عَذَلا",1,"ل",2,0],["بِمَتَّخِذينَ اللَيلَ فَوقَ رِحالِهِم","بِها جَبَلاً قَد كانَ مَشياً خَبيبُها",2,"ب",3,0],["بمتَّسِقٍ كأَنَّ الشَّمْسَ تجلو","علينا منه حَلْياً في اتِّساقِ",3,"ق",1,0],["بمتحرك يكون الابتدا","كما على السكون وقفهم بدا",4,"د",2,0],["بمتّخذ زرق الأَسنَّة سلَّماً","على المجد والسّحر العوالي سلالم",5,"م",1,0],["بِمُتَوَّجٍ لا أتَّقي في مُلكِهِ","مِن نَقضِهِ خَلَلاً وَلا إبرامِهِ",6,"م",2,0],["بمُتَوَّجٍ وَهَبَ البُرودَ قَشيبةً","وكَفاهُ مِنْ أَدْراعِهِ أَبْرادُ",7,"د",1,0],["بم تلقى النبي من جعلت أي","يام قتل ابنه من الأعياد",8,"د",1,0],["بِم تَعتَلي حَتّى تَقول لي استعر","نَسَباً أُجبك فَلَستَ لي بِكفاء",9,"ا",2,0],["بمتن مَتين يشرح الصدر واضِحاً","فأحسن به متناً وَأَحسن به شرحا",10,"ح",2,0]]}