{"poems":[[55,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[79,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[79,"بشرى يقوم لها الزمان خطيبا","https://www.aldiwan.net/poem36781.html","الكامل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[79,"بُشرى يقومُ لها الزّمانُ خطيبا","https://www.poetsgate.com/ViewPoem.aspx?id=33311",""],[92,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[132,"ورمتني الأيام أو","https://www.aldiwan.net/poem50671.html","مجزوء الكامل"],[466,"ما أنصفت بغداد ناشئها الذي","https://www.aldiwan.net/poem16438.html","الكامل"],[520,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[556,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[558,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118363","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86511","الكامل"]],"verses":[["وَذَعَرنا الظَلامَ حَتّى لَقينا","خارِجاً مِن ثِيابِهِ الأَخلاقِ",0,"ق",1,0],["وَذَعَرْتَ أُسْدَ الْغَابِ فِي أَجَمَاتِهَا","لَمَّا هَزَزْتَ مِنَ الْقَنَا آجَامَا",1,"م",2,0],["وَذَعَرْتَ بِالْجَيْشِ اللُّهَامِ بِلاَدَهَا","مك الفضا ملأ القلوب وجيبا",2,"ب",2,0],["وَذَعذَعَتهُ رِياحُ الصَيفِ وَاِضطَرَبَت","فَوقَ الجَآجِئِ مِن آذِيِّهِ غُدُرُ",3,"ر",1,0],["وذَعرتَ ريبَ الدهرِ منتقِماً","من كيدِه فصِعابهُ ذُلُلُ",4,"ل",1,0],["وذعرْتَ بالجيش اللُّهام بلادَها","ملء الفضا ملأَ القلوبَ وجيبا",5,"ب",2,0],["وذَعْرتَ سِربي بالفراق","فليت سربَك لا أمِن",6,"ن",1,0],["وذُعافُ كل مُعاندٍ","ومُعَاذُ كل مُصاحِبِ",7,"ب",1,0],["وذعرْتُ ألْبابَ الخصوم بخاطرٍ","يقْظانَ في الإصْدارِ والإيرادِ",8,"د",1,0],["وذعرت ساهية القلوب بهيبة","سكنتها بسكينة ووقار",9,"ر",1,0],["وذَعذِعها جهالاتٍ تلاقتْ","وضَعْضِعها ضلالاتٍ بُنينا",10,"ن",2,0],["وَذَعَرتَ صَرفَ الدَهرِ حينَ ضَمِنتَهُ","فَالدَهرُ مِنكَ وَصَرفُهُ مَذعورُ",11,"ر",1,0],["وذعوا السوانح والبوارح واتركوا","ذكر الحمامة والغراب الابقع",12,"ع",1,0],["وذعرت شر الغيد في أكنانها","فغدا تناغيها لديك شهيقا",13,"ق",2,0]]}