,"المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111467","الطويل"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20975","الطويل"],[4701,"ركعة الشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=176663",""],[4759,"أصداء ما أشتهي","https://www.poetsgate.com/ViewPoem.aspx?id=204106",""],[5131,"هذا هو الإسلام في مفهومه","https://www.poetsgate.com/ViewPoem.aspx?id=58407",""],[5271,"نواقيس الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=123677",""],[5277,"لو أطاعَ الطيفَ..قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=199801",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5956,"هذي الدقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=194283",""],[5956,"أ آتي وأجلس قربك عمري؟","https://www.poetsgate.com/ViewPoem.aspx?id=206264",""],[6093,"أشكو إلى الله منْ هَمٍّ يُساورُني","https://www.poetsgate.com/ViewPoem.aspx?id=176150",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""]],"verses":[["أَأَترُكُ الغُرَّ مِن لِداتي","خَوالِيَ البيضِ وَالدُروعِ",0,"ع",1,1],["أَأَترُكُ أَملاكاً رِزاناً حُلومُهُم","حُلولاً عَلى الزَوراءِ أَيمانُهُم تَندى",1,"د",2,0],["أَأَترُكُ أَمطاءَ السَوابِقِ ضِلَّةً","وَأَستَحمِلُ الحاجاتِ أَحمِرَةً قُفدا",1,"د",2,0],["أَأَترُكُ ضَيغَماً في ظَهرِ طَودٍ","وَآخُذُ تَتفُلاً في بَطنِ وادِ",2,"د",1,0],["أَأَتَتْكَ أَنْبَاءُ المُنَابَذَةِ الَّتِي","رِيعَ الثِّقَاتُ لَهَا مِنِ اطْمِئْنَانِ",3,"ن",1,0],["أأترك ذاكَ الريق كالشهدِ مخبراً","وأطلب صبراً ما أشرّ وأحبطا",4,"ط",2,0],["أأتقي الدهر ذا الهنات بكم","وأعظمي طعمة لعارقها",5,"ق",3,0],["أأتركُ آخرتي ضَلّةً","وأخدُم دنيايَ بالباطل",6,"ل",1,0],["أأترك عَفْو الكأس حرّانَ صادياً","لعلّانَ من ريق الكواعب ثاملِ",7,"ل",1,0],["أَأَترك من بعدي صغيري أحمداً","وحيداً بلا حامٍ بهِ يتكفل",8,"ل",1,0],["أَأَتْرُكُ لَذَّةَ الصَّهْباءِ عَمْداً","لما وَعَدُوهُ مِنْ لَبَنٍ وخَمْرِ",9,"ر",1,1],["أَأَترُكُ السَهلَ مِن جَدواكَ أَتبَعُهُ","وَأَطلُبُ النائِلَ الأَقصى إِلى الجَبَلِ",10,"ل",1,0],["أَأَتَّخِذُ العِراقَ هَوىً وَداءً","وَمَن أَهواهُ في أَرضِ الشَآمِ",11,"م",1,0],["أَأَتبَعُ ضَنكَ الأَمرِ وَالأَمرُ مُدبِرٌ","وَأَدفَعُ في صَدرِ الغِنى وَهوَ مُقبِلُ",12,"ل",1,0],["أَأَترُكُ لَيلى لَيسَ بَيني وَبَينَها","سِوى لَيلَةٍ إِنّي إِذاً لَصَبورُ",13,"ر",1,0],["أَأَترُكُ في رِضاكَ مَديحَ قَومي","وَتَحبيرَ المُحَبَّرَةِ الفِصاحِ",14,"ح",1,0],["أأترك نفسي بعد ذا بيد الهوى","تسام كما جر الحمار جرير",15,"ر",1,0],["أأتّخِذُ العِرَاقَ هَوًى، وَداراً،","وَمَنْ أهْوَاهُ في أرْضِ الشّآمِ",16,"م",1,0],["أَأتتك أبناء الرصيفة تشتكي","قحط الأوانس بعد حور عين",17,"ن",1,0],["أَأَترُكُ ذا الغَيمَ الرُكامَ مُعَرَّضاً","لِمَن رامَ جَدواهُ وَأَنتَجِعُ الهِفّا",18,"ف",2,0],["أاتى الإسلام من حيث أمن","واشتكى القطر من السقف المكن",19,"ن",1,1],["أَأَترُكُ مَدَّ النِّيلِ فاضَ وَأَبتَغي","فَراشاً تُعَفّي ماءَهُنَّ البَوارِحُ",20,"ح",1,0],["أأترك كأسي والفؤاد ربيبها","وهيهات ينسى القلب فضل مربيه",21,"ي",2,0],["أَأَترُكُ البَحرَ دوني سائِغاً غَدَقاً","وَأَجتَدي وَشَلاً بِالجَوِّ مُنتَزِفا",22,"ف",2,0],["أَأَتى لينظرَ كيف أَقْ","ضي ليلتي همّاً وسهدا؟",23,"د",2,0],["أأتركُ محيي العدل والشوقُ قائدي","له اِنني منْ عاشِقٍ لَجَليدُ",24,"د",1,1],["أَأَتاها مُحَرِّشٌ بِنَمِيمٍ","كاذِبٌ ما أَرادَ إِلا رَداها",25,"ه",2,0],["أَأَتْرُكُ الْحَقَّ ونَهْجَ الْهُدَى","إنْ مَزّقُوا عِرْضِيَ أَوْ قَعْقَعُوا",26,"ع",3,0],["أَأَترُكُ في مصرَ السعادةَ والهَنا","وأذهبُ أشقَى حيثُ لا أحدٌ يَدري",27,"ر",2,0],["أَأَترُكُ مَن لا يَترُكُ الدَهر طاعَتي","مُلَبٍّ لَما أَدعو بِكُلِّ لِسانِ",28,"ن",1,0],["أأترك وجهاً بالمحاسن مشرقاً","وأنظر وجهاً حشوه القيحُ والدم",29,"م",1,0],["أَأَتيت مِن شَرع الهَوى بِرسالة","في العَذل تَعذل صَبوَتي وَتُماري",30,"ر",2,0],["أَأَتركها مِن غَير نَشر فَينطَوي","بِأَوطاننا فيها لِواء المحارب",31,"ب",1,0],["أَأَترُكُ إِتيانَ الحَبيبِ تَأَتُّماً","أَلا إِنَّ هِجرانَ الحَبيبِ هُوَ الإِثمُ",32,"م",1,0],["أأتبع المفضول مجتنباً لمن","له الفضل مالي في السفاه عدول",33,"ل",1,0],["أأتبع الميل من الشك وقد","عم الصباح ناظري يقينا",34,"ن",2,0],["أأترك الحظّ في ملقى الحضيض سدىً","وهمتي فوق هام السبعة الشُّهُبِ",35,"ب",1,0],["أأتبع نفساً لو استيقظت","درت أنَّ كلَّ غرام غررْ",36,"ر",1,0],["أأترك إن قلت دراهم خالد","زيارته إني إذاً للئيم",37,"م",1,1],["أأترك لذّاتي وآتي هواكم","ألا ليس مثلي يابن قيسٍ يخالب",38,"ب",1,0],["أَأَتَّبع انتقاماً منك يشقي","حياتكِ في الزمان بلا شفيع",39,"ع",1,0],["أأترك باباً أنتَ لى قد فتحتَه","وأقصدُ باباً غيرَ بابك موصَدا",40,"د",2,0],["أَأَتعبُ في تَحصيله وَأُضيعه","إِذن كُنتُ مُعتاضاً مِن البرءِ بالسقمِ",41,"م",1,0],["أأترك مدح البحر والبحرُ خالدٌ","لمدح فقاقيعٍ ستنحلٌّ في البحر",42,"ر",1,0],["أأتبع العادات وهي زخارفٌ","وما زلت بين الناس أسعى لرفعها",43,"ع",3,1],["أأتركها فوضى لكل مبعثر","ويا اسفا للدر حين يبعثر",44,"ر",1,0],["أأتقي لذعها وكم بكم","من ذي لسان بالقول لذاع",45,"ع",1,0],["أَأَترُكُ صِبياني وَأَهلي وَأَبتَغي","مَعاشاً سَواهِمُ أَم أَقِرُّ فَأُذبَحُ",46,"ح",1,0],["أَأَتبعُ الحبَّ إِن الحبَّ أَفضلُ لي","وإِن تحكَمَ في أَمر وأَضناني",47,"ن",2,0],["أأترك في العدى ترة لقوم","أنا في فضل نعمتهم رببت",48,"ت",1,0],["أَاترك حَقّي طائِعاً بَينَ مَعشَري","فَلا وَالَّذي وَلاني النهيَ وَالاِمرا",49,"ر",2,0],["أأتركُ البدرَ إذ أَنار على","حظي وأبغي الشعاعَ من زحلِ؟",50,"ل",1,0],["أَأَترِيذُ يا زُعَماءَ القَبيلِ","بأَقوَامِنا الشُّعرِ كَم مِن قَتِيلِ",51,"ل",1,0],["أََأَترِيذُ مَولى الصِّيدِ أَوَّلَ مَن جَرى","وآخِرَ مَن يَجرِي إِلَيهِ مَقالِيا",52,"ي",2,0],["أأتترُكُ اولادَ البَغايا وَغِيبَتِي","وَتَحبِسُنِي عَنهُم وَلا اتَكَلَّمُ",53,"م",1,0],["أأتوب عن هذا العذاب ولم تتب","عن حبها الباكى سماء شتائى",54,"ا",2,0],["أأتمه الصبح .ألقى في المساء له","طيفا يحدق بين الشمس والشفق",55,"ق",1,0],["أأتيت تكتب نسخةً أدبية","أم جئت عن شرف الحنيفة حامي",56,"م",2,0],["(أَأتيتَ حَقًا ؟!! أمْ تُراها لَهْفتي","دَقّتْ نواقيسَ الرّؤى لتكونا)",57,"ن",2,1],["إإتني بالحبِّ في طيفِ الكرى","لو أطاعَ الطيفُ...آهٍ لو أطاعا",58,"ع",2,0],["أاتركها وقد نزفت فأوهت","أؤقظها وقد طال الرقاد",59,"د",1,0],["أأترك جرحها يندى نجيعا","وبالنعمان تستسقى الوهاد؟",59,"د",1,0],["أ أتيت تأخذ جمرةً من بيتنا","وتطير تعطيها لمَوقد غيرنا؟",60,"ن",2,0],["أ آتي وأجلس قربك عمري","لأنك أجمل من أي زهرِ؟",61,"ر",1,1],["أ أتركُ المدحَ عنْ قولٍ لعاذلنا","كلا فلست نصير الجهل والدَّغَلِ",62,"ل",1,0],["أأتركه يصارعني","وهذا البرد يلقاني",63,"ن",2,0]]}