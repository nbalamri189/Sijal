://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5442,"كل يوم تنوي الرحيل مرارا","https://www.poetsgate.com/ViewPoem.aspx?id=114780",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[6324,"اللحن الشريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87935&r=&rc=0",""]],"verses":[["ليس شيء يُفيدُه المرء في الده","ر على حين فقره والثراءِ",0,"ا",2,0],["ليس شيء سوى الوفاءِ أو التص","ريح بالعذر فاعلمَنْ ينجيهِمْ",1,"م",1,0],["ليس شيء مثل الحياة عزيزا","مع ما في بقائها من رزايا",2,"ي",2,0],["ليس شيخوختي التي أنا منها","أشتكي اليوم غير داء عقام",3,"م",1,0],["ليس شعرا ما ليس فيه شعور","لا يهيج الشعور غير الشعور",4,"ر",1,0],["ليسَ شغلي إلاّ هواكِ ومدحي","فيهِ هذانِ روضتي وغديري",5,"ر",2,0],["لَيسَ شَيءٌ أَجَلَّ مِن فُرقَةِ النَف","سِ فَحَسبي فُجِعتُ بِالنَفسِ حَسبي",6,"ب",2,0],["لَيسَ شيء يضر بالناس كالطي","شِ إذا دام دافعاً في الحياة",7,"ه",1,1],["لَيسَ شَيءٌ عَلَى المنُونِ بِباقِ","غَيرُ وَجِه الُمسَبِّحِ الخَلاَّقِ",8,"ق",1,0],["ليسَ شيءٌ عَلَى المَنُونِ بِخَالِ","لا عَديمٌ ولا مُثمِّرُ مالِ",9,"ل",1,1],["لَيْسَ شَأْنُ القَديمِ بِالنَّزْرِ فِي الفُصْحَى","وَشَأْنُ الحَديثِ لَيْسَ بِنَزْرِ",10,"ر",1,0],["ليس شعرًا ما لم يكن عن شُعور","وله من قَرَارةِ النفس واح",11,"ح",1,0],["ليس شعرًا ما لم يقم قائلوه","بخطاب القلوب والأرواح",11,"ح",1,0],["ليس شعرًا ما احتاج قُرَّاؤه في","فهم أهدافه إلى شُرَّاح",11,"ح",1,0],["ليس شعرًا ما جاء عَنْ غير طَبْع","بعد طول اللَّجَاج والإلْحَاح",11,"ح",1,0],["ليس شيءٌ من التجانس في نفسٍ","نواسيَّةٍ وعيشٍ صَحابي",12,"ب",2,0],["ليس شعر يقوله شعراء","قلدوا من تقدموهم بمجدي",13,"ي",1,0],["لَيسَ شَأن المُوَتَّرينَ مِهادٌ","وَغِناءٌ وَمزهَرٌ وَشَمولُ",14,"ل",1,0],["ليس شعري وإن كسا المجدَ دُرّاً","بالغاً عُشْر ما حويتَ فغَفْرا",15,"ر",2,1],["ليس شهد الشهود أو راحة الرا","ح وحَسْنا البها سوى حسناتك",16,"ك",1,0],["لَيس شقّ الجيوبِ حقّاً علينا","أيّ شيء جنت علينا الجيوبُ",17,"ب",1,0],["ليس شيئا أن تشتهى كلّ شيءٍ","ضاع من يطلب المُحال وهانا",18,"ن",2,0],["لَيسَ شَيءٌ مِمّا يُدَبِّرُهُ العا","قِلُ إِلّا وَفيهِ شَيءٌ يُريبُه",19,"ب",2,1],["ليس شيءً عن ندىً","ونوالٍ شغلك",20,"ك",1,0],["ليس شأن النديم في الحق أن","يضربَ كشحاً عن ذاك مع إِغفاِله",21,"ل",2,0],["ليس شكوى الزمان طبعي ولكن","هو سخري من فعل دهر حقير",22,"ر",1,0],["ليس شيء سواهما ثالث في","خطرات العقول والأذهان",23,"ن",1,0],["ليس شيء معه من قبل أن يخلق لا","داخل أو خارج أو ذو اتصال أو نفود",24,"د",1,0],["لَيْسَ شَيءٌ أبْهى وأبْهَرَ مَرْأى","مِنْ بُدورٍ تُديرها أعْناقُ",25,"ق",1,0],["ليسَ شيءٌ أنْكى لِفَرْحَةِ قَلْبي","مِنْهُ يُصْمِي الفؤادَ ثُمَّ يسائِلْ",26,"ل",1,0],["ليس شيء عند الإله يحاكي","شأوه السابق البعيد المطارا",27,"ر",2,0],["ليس شيء كمثله جل مولى","كيف الكيف قدر المقدارا",27,"ر",2,0],["لَيسَ شَيء غَيرَ رَشفي شَنَبا","يَحسد الدر عَلَيهِ المَنطِقا",28,"ا",1,0],["لَيسَ شَيءٌ يَشاؤُهُ ذو المَعالي","بعَزيزٍ عَلَيهِ فَاِدعي المُجيبا",29,"ب",2,0],["ليس شيءٌ أعزَّ عندي من العل","م فَلِم أبتغي سواه أنيسا",30,"س",2,0],["ليس شيء مشبهاً محشيها","إن يكن في لبن البدو ربا",31,"ب",2,0],["ليسَ شيءٌ من الأُمُور وإن كا","نَ عظيماً عندي له بعَديِلِ",32,"ل",1,0],["ليس شعب محرر مثل شعب","خانه قبل ساعد مغلول",33,"ل",1,0],["ليس شعري جيداً لكن به","قد غدا بين ذرى العليا يجود",34,"د",1,0],["ليس شيء سوى الفرار علاجا","وبهذا الفرار نيل الأماني",35,"ن",2,0],["ليس شعري هذا سوى زفرات","أي نفع للمرء في الزفرات",36,"ت",1,0],["ليس شدو الهزار في الروض حرا","مثله في الأقفاص نوحا شجيا",37,"ي",2,0],["ليس شرب المدام للمستهام","مذهباً ما به من الأسقام",38,"م",1,1],["ليس شأني تحرجا غير أني","كنت ندمان زوجها فاستحيت",39,"ت",1,0],["ليس شيءٌ أحرَّ في مهجة العا","شقِ من هذه العيونِ المراضِ",40,"ض",1,1],["لَيسَ شافِعاً","عِلمُ من عَلم",41,"م",1,0],["ليسَ شيءٌ بثابتِ الحالِ الَّا","مَن لهُ العِزُّ دائماً والجَلالُ",42,"ل",1,0],["ليس شبلي غير ما تعهده","في مدى الإهمال خفاق اللواء",43,"ا",2,0],["ليس شرط المنى التواني ومن م","شمر زنداً لم يذمم التشميرا",44,"ر",2,0],["لَيسَ شَطُّ الأَعرافِ هذا وَلكِن","هُوَ رُكنٌ مِن شاطِىءِ الأَعرافِ",45,"ف",1,0],["لَيسَ شَيءٌ يُحيي المُنى فيهِ إِلّا","اِبيِضاضُ الثُلوجِ فَوقَ الصُخورِ",46,"ر",1,0],["لَيسَ شَأني وَشَأنُ أَهلِيَ قَبلِي","أَن نُوَلِّي يَومَ الوَغى الإِدبارا",47,"ر",2,0],["ليس شرب الكأس إلا في المطر","وغناء من جوار في السحر",48,"ر",1,1],["لَيسَ شَهاداتِ الفَتى الأَوراقُ","لَكنَّما الشهادَةُ الأَخلاقُ",49,"ق",1,0],["لَيسَ شَرطًا عَلَيكَ يا كُلَّ شَيءٍ","فِي يَدَينا, بأَن تُرَى فِي يَدَينا",50,"ن",2,0],["لَيْسَ شَيْءٌ عِنْدَ رَبِّي","مُسْتَحِيلَاً فِي اعْتِقَادِي",51,"د",2,0],["ليس شان ينسيه شانا وكم بَي","نَ صناع الكفين والخرقاء",52,"ا",2,0],["ليس شيء يدنيك مني بعد ال","بين إلا انتسابة وانتماء",53,"ا",2,0],["ليس شيء يكفي فإن تقنع النفس","تجد فل ما ترى اكثارا",54,"ر",2,0],["ليس شعري غيرَ من في (مأرِبٍ)","حينما انهارَ يُرى يستلُ سيفا",55,"ف",2,0],["ليس شعرا ما شيدته القوافي","إنما الشعر نبضة في الوريد",56,"د",1,0]]}