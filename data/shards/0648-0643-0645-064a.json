{"poems":[[53,"حلفت بها صيد الرؤوس سوام","https://www.aldiwan.net/poem29752.html","الطويل"],[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[63,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[63,"لك المجد لا ما تدعيه الأوائل","https://www.aldiwan.net/poem46184.html","الطويل"],[71,"سلوا صهوات الخيل يوم الوغى عنا","https://www.aldiwan.net/poem4023.html","الطويل"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[93,"كنا نود لك التكريم تلبسه","https://www.aldiwan.net/poem11344.html","البسيط"],[93,"عشيرة الأحرار في مأتم","https://www.aldiwan.net/poem11353.html","السريع"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[27,"ألمت وما رفقت بأن تلومي","https://www.aldiwan.net/poem5988.html","الوافر"],[47,"وقوفك في الديار عليك عار","https://www.aldiwan.net/poem25290.html","الوافر"],[72,"نفرت عن الظبي الذي كان ينفر","https://www.aldiwan.net/poem18710.html","الطويل"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"يا أيها السيد الذي غمرت","https://www.aldiwan.net/poem62932.html","الكامل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[70,"أراني كلما استخبر","https://www.aldiwan.net/poem42977.html","الهزج"],[28,"تزود فما نفس بعاملة لها","https://www.aldiwan.net/poem5012.html","الطويل"],[28,"عسى أسد أن يطلق الله لي به","https://www.aldiwan.net/poem5353.html","الطويل"],[61,"أحل بعقوة الشرف التليد","https://www.aldiwan.net/poem51689.html","الوافر"],[58,"وكم لله من لطف خفي","https://www.aldiwan.net/poem30793.html","الوافر"],[80,"كم تعجب الناس من صيد ولا شرك","https://www.aldiwan.net/poem31470.html","البسيط"],[69,"وكم يدعي صونا وهذي جفونه","https://www.aldiwan.net/poem28068.html","الطويل"],[46,"مضى الناس أفواجا ونحن وراءهم","https://www.aldiwan.net/poem23297.html","الطويل"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[113,"مهيجة ذات وجد","https://www.aldiwan.net/poem40625.html","عموديه"],[133,"لا للقدود ولا للأعين السود","https://www.aldiwan.net/poem49190.html","البسيط"],[167,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[167,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[183,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[184,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[197,"بي الهوى إن كنت لم تعرفي","https://www.aldiwan.net/poem45180.html","السريع"],[197,"كفى صدودا فما أبقى تجافينا","https://www.aldiwan.net/poem45565.html","البسيط"],[197,"سهرت والليل أمسى للورى سكنا","https://www.aldiwan.net/poem45626.html","البسيط"],[228,"وكم يتمنى المرء تخليص نفسه","https://www.aldiwan.net/poem4036.html","الطويل"],[233,"أرى الأيام صيغتها تحول","https://www.aldiwan.net/poem31790.html","الوافر"],[248,"قطعت شبيبتي وأضعت عمري","https://www.aldiwan.net/poem14971.html","الوافر"],[268,"أرى أبدا قلبي الجريء جريحا","https://www.aldiwan.net/poem35214.html","الطويل"],[268,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[269,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[303,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[336,"لا تشعرن قلبك حب الغنى","https://www.aldiwan.net/poem68665.html","السريع"],[359,"يا ابن الاماجد لا تخش الردى أبدا","https://www.aldiwan.net/poem68121.html","البسيط"],[362,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[364,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[369,"ببعض الدمى قام بعض الفتن","https://www.aldiwan.net/poem57084.html","البسيط"],[369,"تعلقته مسهرا مسكرا","https://www.aldiwan.net/poem57451.html","المتقارب"],[378,"هاج رسم دارس طرباً","https://www.aldiwan.net/poem400.html",""],[397,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[399,"نسيم الصبا كيف المنازل من نجد","https://www.aldiwan.net/poem46424.html","الطويل"],[400,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"],[402,"والعلم إن كلف الإنسان خدمته","https://www.aldiwan.net/poem49750.html","البسيط"],[413,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[413,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[413,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[413,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[413,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[426,"أمن خدها الوردي افتنك الخال","https://www.aldiwan.net/poem40062.html","الطويل"],[426,"رعى الله ربعا زاد فيه سروره","https://www.aldiwan.net/poem40855.html","الطويل"],[434,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[456,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[456,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[459,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[462,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[462,"إذا هز بانات العذيب جنوبها","https://www.aldiwan.net/poem3620.html","عموديه"],[475,"صباه الهوى ما أحوج الخلو أن يصبو","https://www.aldiwan.net/poem15336.html","الطويل"],[498,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[498,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[513,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[526,"لله ما هاج لمع البارق الساري","https://www.aldiwan.net/poem2483.html","البسيط"],[549,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[556,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[560,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"],[560,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[573,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[584,"وما فيه من حسن سوى أن طرفه","https://www.aldiwan.net/poem17481.html","الطويل"],[584,"رشيق القامة النضره","https://www.aldiwan.net/poem17529.html","مجزوء الوافر"]],"verses":[["وَكَم يَستَفِزُّ الذُلُّ قَلبَ اِبنِ هِمَّةٍ","لَهُ أَمَلٌ نائي المَدى مُتَرامِ",0,"م",1,0],["وَكَم يَبقى عَلى عَجمِ اللَيالي","وَقَرعِ الدَهرِ جائِرَةُ الكُعوبِ",1,"ب",1,0],["وكَمْ يَدٍ لكَ لا تَخْفى أمائِرُها","ما هَيَّجَتْ عَرَبيّاً حَنّةُ النِّيبِ",2,"ب",1,0],["وكم يوقِظُ الأحْقادَ من رَقَداتِها","وتَرْقُدُ في أغمادِهِنّ المَناصِلُ",3,"ل",1,0],["وَكَم يَوم حُرٍّ ما لَقينا هَجيرَهُ","بِسترٍ وَقُرٍّ ما طَلَبنا لَهُ كِنّا",4,"ن",2,0],["وَكَم يَوم هولٍ ضاقَ فيهِ مَجالُنا","صَبَرنا لَهُ وَالمَوتُ يُحرقُ نابُهُ",5,"ب",2,0],["وَكَمْ يَعِزُّ عَلَى طُلاَّبِهِ أَدَبٌ","زَانَتْ رَوَائِعَهُ الأَمْثَالُ وَالحِكَمُ",6,"م",1,0],["وَكَمْ يَدٍ عَالَ يَتِيماً بِهَا","وَذَادَ رَيْبَ البُؤْسِ عَنْ أَيمِ",7,"م",1,0],["وكمي استنشقت نفحا","فالنجوم ترعد وتخفق",8,"ق",1,0],["وَكَم يَرجو الخَليفَةَ مِن فَقيرٍ","وَمِن شَعثاءَ جائِلَةِ البَريمِ",9,"م",1,0],["وَكَم يَومٍ وَصَلتُ بِفَجرِ لَيلٍ","كَأَنَّ الرَكبَ تَحتَهُما صِدارُ",10,"ر",1,0],["وكم يشرح البطال سيرته التي","يكافحها من حادث الدَّهر عنتر",11,"ر",1,0],["وكم يومٍ أراني الموتَ فيه","جُنونُ الموجِ في هَوَجِ الجنوبِ",12,"ب",1,0],["وكمينُ الحريق في العُودِ مُخْفَىً","وحَقِينُ الرَّحيقِ في العُنْقُودِ",13,"د",1,0],["وكم يدٍ قبلها جَبرتَ بها","عظمي وكان الزمانُ قد كسرَهْ",14,"ر",2,0],["وَكَم يَدَّعي العَلياءَ قَومٌ وَإِنَّهُ","لَهُ سِرُّها مِن دونِهِم وَسَريرُها",15,"ر",3,0],["وَكَم يَنهاكَ مَخلوقٌ","وَإِن كانَ فَلا يُنجِح",16,"ح",1,0],["وَكَم يا اِبنَ عَبدِ اللَهِ مِن فَضلِ نِعمَةٍ","بِكَفَّيكَ عِندي لَم تُغَيَّب شُهودُها",17,"د",3,0],["وَكَم يا اِبنَ عَبدِ اللَهِ عَنّي مِنَ العُرى","حَلَلتَ وَمِن قَيدٍ بِساقَيَّ مُغلَقِ",18,"ق",1,0],["وكم يتدرَّجُ المنديلُ منه","على أدراجِ شِعرِكَ والحديدِ",19,"د",1,0],["وَكَم يُسرٍ أَتى مِن بَعدِ عُسرٍ","فَفَرَّجَ كَربَهُ القَلبُ الشَجيِّ",20,"ي",1,0],["وَكَم يَقولونَ مَجنونٌ وما عَلِموا","أَنَّ الجُنونَ الَّذي بي من هَوى بِشرِ",21,"ر",1,0],["وكمْ يدَّعي صوناً وهذي جفونُهُ","بفترتِها للعاشقينَ يواعدُ",22,"د",1,1],["وكمْ يتجافى خصرُهُ وهْوَ ناحلٌ","وكمْ يتحالى ريقُهُ وهْو باردُ",22,"د",1,0],["وَكَم يَتَجَنّى المَينَ أَحمَرُ ناطِقٌ","تُمازُ بِهِ عِندَ المَذاقِ طُعومُ",23,"م",1,0],["وكمِيُّهُمْ بين العِدَا","ومكايدِ العملاء حائر",24,"ر",1,0],["وكم يعود فقيراً","من راح يطغيه مال",25,"ل",1,0],["وكم يواعدني زوراً ليحدث بي","شوقاً له ويمنيّني بتعضيدِ",26,"د",1,0],["وَكَم يَعتَريني بِالأَذى كُلُّ مُقرِفٍ","إِذا سُئِلَ الحُسنى أَغَدَّ وَعَربَدا",27,"د",2,0],["وَكَم يَدٍ في الأَذى وَالظُلمِ قَد بَسَطَت","كَفّاً فَبَدَّلَها مِن بَعدُ بِالشَلَلِ",28,"ل",1,0],["وكم يومٍ لنا بالرملِ فيه","حديثٌ مثل ما نثُر السحاب",29,"ب",1,0],["وكم يمّم العافي ببابك يرتجي","فقوّمته فافترّ عن رأي حازم",30,"م",1,0],["وكم يداسُ الزهرُ لكنما","لعزهِ زهرُكِ لم يُقطفِ",31,"ف",1,0],["وكم ينم بأنفاسٍ تحملَها","فيها الحياةُ ولكن ليسَ يحيينا",32,"ن",2,0],["وكم يبيعكَ أهلُ العشقِ أفئدةً","وأنتَ لا عوضاً تعطي ولا ثمنا",33,"ن",2,0],["وكمْ يتَمنى المَرْءُ تخليصَ نَفِْسهِ","وما لامْرِئ منْ دَهْرِه ما تَمناهُ",34,"ه",1,1],["وَكَم يَتَحَيَّفُ النُقصانُ فَضلي","وَيَأخُذُ مِن نَباهَتيَ الخَمولُ",35,"ل",1,0],["وكم يومٍ بِبَيعِ اللَّحمِ عندي","يُعَدُّ من البَوَارِ بأَلفِ شَهرِ",36,"ر",1,0],["وكم يُذبلُ القنديلُ وَجهي وأرتمي","على ضوئهِ حتى يصيرَ شحيحا",37,"ح",2,0],["وكم يقولون إنّا ناصبونَ لكم","ميزانَ عدلٍ ولم توفوا الموازينا",38,"ن",2,0],["وَكَم يُصافحه مَن لا يدى يده","وَلا فَمي عند تَقبيل الثرى فمه",39,"م",2,0],["وَكَم يدٍ لي عليهم في العلومِ بَدَت","بَيضاءَ لا سوء فيها غير جحدهمُ",40,"م",1,0],["وَكَم يَدٍ لِلفَقرِ عِندَ اِمرِئٍ","طَأطَأَ مِنهُ الفَقرُ حَتّى اِقتَصَد",41,"د",1,0],["وَكَم يَد لك بِالمَعروف قَد عَرَفت","وَكَم فَخار كَضوء الفَرقَدَين بَدا",42,"د",2,0],["وَكَم يُشعِلُ لي قَلباً","لَظىً في جَنبِهِ سَقطُ",43,"ط",1,0],["وَكَم يَدٍ تَحمِلُ الأَقلامَ قاصِرَةٍ","عَن حَقِّها فَتُرى حَمّالَةَ الحَطَبِ",44,"ب",1,0],["وكم يَلبثُ الجُودُ مِن حاتِمٍ","إلَيهم تَغيَّرَ لمَّا أسَن",45,"ن",1,0],["وكم يَستذِمُّ به مالُه","فلا يَتَمالكُ أن يَغدرا",46,"ر",2,0],["وَكَميٍّ قَد أَدَوتُ له","لَم يكن لِقاؤُه لَعِبا",47,"ب",2,0],["وكم يحظى الفتى بالحب من","على بعد ويوصف بالحبيب",48,"ب",1,0],["وكم يَلْتَقِيني منْ بنيهِ محارباً","بأخبثِ مِن صلٍّ وألأم مِن قردِ",49,"د",1,0],["وكم يناصح أقواماً لموعظة","تكاد تنشق من ألفاظه الحجر",50,"ر",1,0],["وكَمْ يُقَبِّلُ ذو التَّحصيلِ خَدَّ فتىً","مِنَ مداراتُهُ أيامَّهُ خَدَمَهْ",51,"م",2,0],["وكم يدٍ لك في الصالحات","سَبَقْتَ من البرّ أمثالها",52,"ل",3,0],["وكم يومٍ تَركنا الزِّقَّ فيه","جريحاً من يد الندمان دامي",53,"م",2,0],["وكميٍّ حازمٍ أصْبَحَ في","قبضةِ الحبّ وما ثَمَّةَ حازم",54,"م",1,0],["وكم يوم ركبنا الفلك تطفو","بسيطَ الماء في البحر المديد",55,"د",1,0],["وكميتاً ما جرتْ في حلبةٍ","للوغى يوماً ولا شقَّت غبارا",56,"ر",2,0],["وكم يدعي بالحب من ليس أهله","وهيهات أين الحب والأحمق الخال",57,"ل",1,0],["وكم يدعي بالمجد قوم وإنما","له سره من دونهم وسريرهُ",58,"ه",1,0],["وكم يوم حرب فلّ بالسيف غربهُ","يبِرّ على بدر وناهيك من بدر",59,"ر",1,0],["وكم يطمع الأعداءُ فيك بهزِّهم","وقد جلَّ عن شَمِّ التراب شَمامُ",60,"م",1,0],["وكم يأوِي المشقَّرَ من غزالٍ","تحاذر من كَناسَتِه الأسودُ",61,"د",1,0],["وكم يوم روْعٍ زاخر ذي غوارب","له الموتُ لُجٌّ والمخافةُ ساحلُ",62,"ل",1,0],["وكم يومِ وصل كان أبيضَ ناصعاً","ولكنه خالٌ على وجنة الدهر",63,"ر",1,0],["وكم يوم بينٍ ساءَ عيني شبابهُ","وليلة وصلٍ شفَّ قلبي مشيبها",64,"ب",3,0],["وكم يشتكي جدَّ الفراقِ وعندها","بأنَّ النوى والهجرَ مِن مثلِها لِعبُ",65,"ب",1,0],["وكم ينهلُّ للتفريق دمعٌ","وكم حيٍّ منيعٍ يستباحُ",66,"ح",1,0],["وكم يدَّعي حُبَّ الأَحبَّةِ مِثْلَنا","أُناسٌ ولكنْ في الهَوَى أَخطَأُ والمَرْمى",67,"م",2,0],["وكم يد لك صانت وجه منقبض","عن السؤال وأهدت أنس محتشم",68,"م",1,0],["وَكَم يَدٍ لَكَ عِندي لَستُ أَكفُرُها","أَمطَيتُها مِن ثَنائِي ظَهرَ طَيّارِ",69,"ر",1,0],["وكم يَذودُكُمُ عن حقّكمْ حَنَقاً","مُمَلّأُ الصَّدْرِ بالأحقادِ مُضطغِنُ",70,"ن",1,0],["وكمْ يومٍ نصرتُهُمُ وفَرْشِي","قَرا الجُرْدِ المطهّمةِ العِرابِ",71,"ب",1,0],["وكم يهيم بكم في الحي أمثالي","بكاسنا كلما ذقنا رحيقَكمو",72,"و",1,0],["وكم يُمسي لبيبٌ لا يُصلِّي","لشِدَّةِ ضُعفِهِ لكنْ يصومُ",73,"م",1,0],["وكم يمضي الفِراقُ بلا لِقاءٍ","ولكنْ لا لِقاءَ بِلا فِراقِ",74,"ق",1,0],["وكم يلاقي مَهْلَكاً","إِذا أَراد مَطْلبَاً",75,"ب",2,0],["وَكَمْ يَدَّعِي صَوْناً وَهذِي جُفُونُه","بِفَتْرَتِهَا لِلعاشِقين تُواعِدُ",76,"د",1,0],["وَكَمْ يَشْكُو وَلا تُطْرَ","حُ في قُفَّتِهِ كِسْرهْ",77,"ر",2,0]]}