etsgate.com/ViewPoem.aspx?id=199624",""],[4722,"وأن نفخة اسرافيل ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=26474",""],[4796,"تجلَّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=35614",""],[4858,"ورقة من امتحان الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=29818",""],[4896,"في وجه العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=180880",""],[5002,"يا ليل...","https://www.poetsgate.com/ViewPoem.aspx?id=210265",""],[5251,"مع التعايش","https://www.poetsgate.com/ViewPoem.aspx?id=214845",""],[5257,"سمُو الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=185271",""],[5277,"للهِ درُّ غزالي","https://www.poetsgate.com/ViewPoem.aspx?id=193453",""],[5277,"لنا الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=194087",""],[308,"قل لي مَا شَيْء إِذا رمت إِن","https://www.poetsgate.com/ViewPoem.aspx?id=189406",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5398,"مصاب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=37122",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5573,"ضحايا العيد","https://www.poetsgate.com/ViewPoem.aspx?id=200331",""],[482,"خلا مِنَ القومِ مصطاف ومرتبعُ","https://www.poetsgate.com/ViewPoem.aspx?id=111303",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[5781,"تراخى على القدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=211099",""],[5785,"قيلوا بنا تحت الظلال الظليل","https://www.poetsgate.com/ViewPoem.aspx?id=131567",""],[5804,"الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=191227",""],[5804,"اغتنم الخير قبل أن ترحل","https://www.poetsgate.com/ViewPoem.aspx?id=214738",""],[5845,"خلِّ الغرامَ يصبٍّ دمعهُ دمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198429",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5956,"عجوزٌ يصف لي جانباً من حياته مع زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=214990",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6235,"نسرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77693&r=&rc=8",""],[402,"كنا نود لك التكريم تلبسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54006&r=&rc=858",""]],"verses":[["وَكَم يَستَفِزُّ الذُلُّ قَلبَ اِبنِ هِمَّةٍ","لَهُ أَمَلٌ نائي المَدى مُتَرامِ",0,"م",1,0],["وَكَم يَبقى عَلى عَجمِ اللَيالي","وَقَرعِ الدَهرِ جائِرَةُ الكُعوبِ",1,"ب",1,0],["وكَمْ يَدٍ لكَ لا تَخْفى أمائِرُها","ما هَيَّجَتْ عَرَبيّاً حَنّةُ النِّيبِ",2,"ب",1,0],["وكم يوقِظُ الأحْقادَ من رَقَداتِها","وتَرْقُدُ في أغمادِهِنّ المَناصِلُ",3,"ل",1,0],["وَكَم يَوم حُرٍّ ما لَقينا هَجيرَهُ","بِسترٍ وَقُرٍّ ما طَلَبنا لَهُ كِنّا",4,"ن",2,0],["وَكَم يَوم هولٍ ضاقَ فيهِ مَجالُنا","صَبَرنا لَهُ وَالمَوتُ يُحرقُ نابُهُ",5,"ب",2,0],["وَكَمْ يَعِزُّ عَلَى طُلاَّبِهِ أَدَبٌ","زَانَتْ رَوَائِعَهُ الأَمْثَالُ وَالحِكَمُ",6,"م",1,0],["وَكَمْ يَدٍ عَالَ يَتِيماً بِهَا","وَذَادَ رَيْبَ البُؤْسِ عَنْ أَيمِ",7,"م",1,0],["وكمي استنشقت نفحا","فالنجوم ترعد وتخفق",8,"ق",1,0],["وَكَم يَرجو الخَليفَةَ مِن فَقيرٍ","وَمِن شَعثاءَ جائِلَةِ البَريمِ",9,"م",1,0],["وَكَم يَومٍ وَصَلتُ بِفَجرِ لَيلٍ","كَأَنَّ الرَكبَ تَحتَهُما صِدارُ",10,"ر",1,0],["وكم يشرح البطال سيرته التي","يكافحها من حادث الدَّهر عنتر",11,"ر",1,0],["وكم يومٍ أراني الموتَ فيه","جُنونُ الموجِ في هَوَجِ الجنوبِ",12,"ب",1,0],["وكمينُ الحريق في العُودِ مُخْفَىً","وحَقِينُ الرَّحيقِ في العُنْقُودِ",13,"د",1,0],["وكم يدٍ قبلها جَبرتَ بها","عظمي وكان الزمانُ قد كسرَهْ",14,"ر",2,0],["وَكَم يَدَّعي العَلياءَ قَومٌ وَإِنَّهُ","لَهُ سِرُّها مِن دونِهِم وَسَريرُها",15,"ر",3,0],["وَكَم يَنهاكَ مَخلوقٌ","وَإِن كانَ فَلا يُنجِح",16,"ح",1,0],["وَكَم يا اِبنَ عَبدِ اللَهِ مِن فَضلِ نِعمَةٍ","بِكَفَّيكَ عِندي لَم تُغَيَّب شُهودُها",17,"د",3,0],["وَكَم يا اِبنَ عَبدِ اللَهِ عَنّي مِنَ العُرى","حَلَلتَ وَمِن قَيدٍ بِساقَيَّ مُغلَقِ",18,"ق",1,0],["وكم يتدرَّجُ المنديلُ منه","على أدراجِ شِعرِكَ والحديدِ",19,"د",1,0],["وَكَم يُسرٍ أَتى مِن بَعدِ عُسرٍ","فَفَرَّجَ كَربَهُ القَلبُ الشَجيِّ",20,"ي",1,0],["وَكَم يَقولونَ مَجنونٌ وما عَلِموا","أَنَّ الجُنونَ الَّذي بي من هَوى بِشرِ",21,"ر",1,0],["وكمْ يدَّعي صوناً وهذي جفونُهُ","بفترتِها للعاشقينَ يواعدُ",22,"د",1,1],["وكمْ يتجافى خصرُهُ وهْوَ ناحلٌ","وكمْ يتحالى ريقُهُ وهْو باردُ",22,"د",1,0],["وَكَم يَتَجَنّى المَينَ أَحمَرُ ناطِقٌ","تُمازُ بِهِ عِندَ المَذاقِ طُعومُ",23,"م",1,0],["وكمِيُّهُمْ بين العِدَا","ومكايدِ العملاء حائر",24,"ر",1,0],["وكم يعود فقيراً","من راح يطغيه مال",25,"ل",1,0],["وكم يواعدني زوراً ليحدث بي","شوقاً له ويمنيّني بتعضيدِ",26,"د",1,0],["وَكَم يَعتَريني بِالأَذى كُلُّ مُقرِفٍ","إِذا سُئِلَ الحُسنى أَغَدَّ وَعَربَدا",27,"د",2,0],["وَكَم يَدٍ في الأَذى وَالظُلمِ قَد بَسَطَت","كَفّاً فَبَدَّلَها مِن بَعدُ بِالشَلَلِ",28,"ل",1,0],["وكم يومٍ لنا بالرملِ فيه","حديثٌ مثل ما نثُر السحاب",29,"ب",1,0],["وكم يمّم العافي ببابك يرتجي","فقوّمته فافترّ عن رأي حازم",30,"م",1,0],["وكم يداسُ الزهرُ لكنما","لعزهِ زهرُكِ لم يُقطفِ",31,"ف",1,0],["وكم ينم بأنفاسٍ تحملَها","فيها الحياةُ ولكن ليسَ يحيينا",32,"ن",2,0],["وكم يبيعكَ أهلُ العشقِ أفئدةً","وأنتَ لا عوضاً تعطي ولا ثمنا",33,"ن",2,0],["وكمْ يتَمنى المَرْءُ تخليصَ نَفِْسهِ","وما لامْرِئ منْ دَهْرِه ما تَمناهُ",34,"ه",1,1],["وَكَم يَتَحَيَّفُ النُقصانُ فَضلي","وَيَأخُذُ مِن نَباهَتيَ الخَمولُ",35,"ل",1,0],["وكم يومٍ بِبَيعِ اللَّحمِ عندي","يُعَدُّ من البَوَارِ بأَلفِ شَهرِ",36,"ر",1,0],["وكم يُذبلُ القنديلُ وَجهي وأرتمي","على ضوئهِ حتى يصيرَ شحيحا",37,"ح",2,0],["وكم يقولون إنّا ناصبونَ لكم","ميزانَ عدلٍ ولم توفوا الموازينا",38,"ن",2,0],["وَكَم يُصافحه مَن لا يدى يده","وَلا فَمي عند تَقبيل الثرى فمه",39,"م",2,0],["وَكَم يدٍ لي عليهم في العلومِ بَدَت","بَيضاءَ لا سوء فيها غير جحدهمُ",40,"م",1,0],["وَكَم يَدٍ لِلفَقرِ عِندَ اِمرِئٍ","طَأطَأَ مِنهُ الفَقرُ حَتّى اِقتَصَد",41,"د",1,0],["وَكَم يَد لك بِالمَعروف قَد عَرَفت","وَكَم فَخار كَضوء الفَرقَدَين بَدا",42,"د",2,0],["وَكَم يُشعِلُ لي قَلباً","لَظىً في جَنبِهِ سَقطُ",43,"ط",1,0],["وَكَم يَدٍ تَحمِلُ الأَقلامَ قاصِرَةٍ","عَن حَقِّها فَتُرى حَمّالَةَ الحَطَبِ",44,"ب",1,0],["وكم يَلبثُ الجُودُ مِن حاتِمٍ","إلَيهم تَغيَّرَ لمَّا أسَن",45,"ن",1,0],["وكم يَستذِمُّ به مالُه","فلا يَتَمالكُ أن يَغدرا",46,"ر",2,0],["وَكَميٍّ قَد أَدَوتُ له","لَم يكن لِقاؤُه لَعِبا",47,"ب",2,0],["وكم يحظى الفتى بالحب من","على بعد ويوصف بالحبيب",48,"ب",1,0],["وكم يَلْتَقِيني منْ بنيهِ محارباً","بأخبثِ مِن صلٍّ وألأم مِن قردِ",49,"د",1,0],["وكم يناصح أقواماً لموعظة","تكاد تنشق من ألفاظه الحجر",50,"ر",1,0],["وكَمْ يُقَبِّلُ ذو التَّحصيلِ خَدَّ فتىً","مِنَ مداراتُهُ أيامَّهُ خَدَمَهْ",51,"م",2,0],["وكم يدٍ لك في الصالحات","سَبَقْتَ من البرّ أمثالها",52,"ل",3,0],["وكم يومٍ تَركنا الزِّقَّ فيه","جريحاً من يد الندمان دامي",53,"م",2,0],["وكميٍّ حازمٍ أصْبَحَ في","قبضةِ الحبّ وما ثَمَّةَ حازم",54,"م",1,0],["وكم يوم ركبنا الفلك تطفو","بسيطَ الماء في البحر المديد",55,"د",1,0],["وكميتاً ما جرتْ في حلبةٍ","للوغى يوماً ولا شقَّت غبارا",56,"ر",2,0],["وكم يدعي بالحب من ليس أهله","وهيهات أين الحب والأحمق الخال",57,"ل",1,0],["وكم يدعي بالمجد قوم وإنما","له سره من دونهم وسريرهُ",58,"ه",1,0],["وكم يوم حرب فلّ بالسيف غربهُ","يبِرّ على بدر وناهيك من بدر",59,"ر",1,0],["وكم يطمع الأعداءُ فيك بهزِّهم","وقد جلَّ عن شَمِّ التراب شَمامُ",60,"م",1,0],["وكم يأوِي المشقَّرَ من غزالٍ","تحاذر من كَناسَتِه الأسودُ",61,"د",1,0],["وكم يوم روْعٍ زاخر ذي غوارب","له الموتُ لُجٌّ والمخافةُ ساحلُ",62,"ل",1,0],["وكم يومِ وصل كان أبيضَ ناصعاً","ولكنه خالٌ على وجنة الدهر",63,"ر",1,0],["وكم يوم بينٍ ساءَ عيني شبابهُ","وليلة وصلٍ شفَّ قلبي مشيبها",64,"ب",3,0],["وكم يشتكي جدَّ الفراقِ وعندها","بأنَّ النوى والهجرَ مِن مثلِها لِعبُ",65,"ب",1,0],["وكم ينهلُّ للتفريق دمعٌ","وكم حيٍّ منيعٍ يستباحُ",66,"ح",1,0],["وكم يدَّعي حُبَّ الأَحبَّةِ مِثْلَنا","أُناسٌ ولكنْ في الهَوَى أَخطَأُ والمَرْمى",67,"م",2,0],["وكم يد لك صانت وجه منقبض","عن السؤال وأهدت أنس محتشم",68,"م",1,0],["وَكَم يَدٍ لَكَ عِندي لَستُ أَكفُرُها","أَمطَيتُها مِن ثَنائِي ظَهرَ طَيّارِ",69,"ر",1,0],["وكم يَذودُكُمُ عن حقّكمْ حَنَقاً","مُمَلّأُ الصَّدْرِ بالأحقادِ مُضطغِنُ",70,"ن",1,0],["وكمْ يومٍ نصرتُهُمُ وفَرْشِي","قَرا الجُرْدِ المطهّمةِ العِرابِ",71,"ب",1,0],["وكم يهيم بكم في الحي أمثالي","بكاسنا كلما ذقنا رحيقَكمو",72,"و",1,0],["وكم يُمسي لبيبٌ لا يُصلِّي","لشِدَّةِ ضُعفِهِ لكنْ يصومُ",73,"م",1,0],["وكم يمضي الفِراقُ بلا لِقاءٍ","ولكنْ لا لِقاءَ بِلا فِراقِ",74,"ق",1,0],["وكم يلاقي مَهْلَكاً","إِذا أَراد مَطْلبَاً",75,"ب",2,0],["وَكَمْ يَدَّعِي صَوْناً وَهذِي جُفُونُه","بِفَتْرَتِهَا لِلعاشِقين تُواعِدُ",76,"د",1,0],["وَكَمْ يَشْكُو وَلا تُطْرَ","حُ في قُفَّتِهِ كِسْرهْ",77,"ر",2,0],["وكم يُداري عُكَّةً","مملوءةً من الخَرا",78,"ر",2,0],["وَكَم يُبدي الأَقاحُ بِها اِبتِساماً","فَيَحكي في تَبَسُّمه ثُغورا",79,"ر",2,0],["وَكَمْ يُعَنِّفُنَا في الحبّ حَاسِدُنَا","كَمَا يُهَدِّدُنَا بِالْبَيْنِ واشِينَا",80,"ن",2,0],["وكم يزيّنها بالفخر منه إذا","ما جاء يوماً يهاديها مقدّمها",81,"م",3,0],["وكم يجمّلها بالعدل ثمّ وكم","من الهنا والصفا والأمن يفعمها",81,"م",3,0],["وكم يشفي الزكام عبير دهني","إذ ما ساح من فوق المصبَّعْ",82,"ع",1,0],["وكم يُفني البلا ارّخ محياًّ","ويبقى وجه ربك ذو الجلالِ",83,"ل",1,0],["وكم يرى القمّار خسرانه","حلواً ولا يعنيه ما ينفقُ",84,"ق",1,0],["وكم يكيد له الذكرى هوى نفيت","منه صبابة عهد غير معهود",85,"د",1,0],["وكم يمَّمْت نفسي رجاء اليهما","فما بخسا حظّي ولا حرماني",86,"ن",2,0],["وكم يراعٍ لهم أسنانُه لفظت","فوائداً أحكمَت للعلم أركانا",87,"ن",2,0],["وكميُّ مِزبرةٍ ترى لُسُنَ الضُبا","خُرساً إذا نطقت بآيِ زَبورها",88,"ر",3,0],["وكمينُ حقد الجاهليَّةِ فيهم","أنَّى طلعتم غالكم بكمين",89,"ن",1,0],["وكم يتظلّم دينُ الإِله","إليكَ من النّفر الجائرِ",90,"ر",1,0],["وكم يصابر نفسه المصابر","وكم يخرج للموانع أعذار",91,"ر",1,0],["وكم يزجرون وكم ينصحو","ن فما يقبلون من الناصح",92,"ح",1,0],["وكم يوم وترت به العذارى","كيوم مهلهل بالشعثمين",93,"ن",1,0],["وكم يقولُ إِذا الهيجاء قد سفرتْ","إِيهاً لعمركِ ما أحلى محيَّاكِ",94,"ك",1,0],["وكمْ يومٍ لهُ خضعتْ رؤوسٌ","إذا ما ماسَ في تلكَ الحلالي",95,"ل",2,0],["وكم يشقى بمعرفة عليم","إذا الأفهام كانت في سقام",96,"م",1,0],["وَكم يدٌ لكَ في العَلياءِ باسِقَةً","محمودَة بينَ مَوروثٍ وَمَكسوبِ",97,"ب",1,0],["وَكَم يَومٍ عَزَمتُ عَلى لِقاءٍ","أُعينُ بِهِ عَلى الشَجوِ الضَميرا",98,"ر",2,0],["وكم يعتريك الكسف آنا وربما اح","تجبت فلم تطلع وآنا تغيب",99,"ب",1,0],["وكم يد بيضاء منك نلتها","كان علي شكرها محتما",100,"م",2,0],["وكم يدٍ لكَ بالأنعامِ سابغةٍ","طوَّقت جيدَ الورى منها بأطواق",101,"ق",1,0],["وكم يد لك عندي مالها امد","وما على يدها بين الكرام يد",102,"د",1,0],["وَكُمَيتٍ بَينَ أَشطا","نِ جَوادٍ ذي مِراحِ",103,"ح",1,0],["وَكَم يَدٍ وَيَدٍ لي عِندَهُ وَيَدٍ","يَعُدُّهُنَّ تِراتٍ وَهيَ آلاءُ",104,"ا",2,0],["وكم يوم نسيت السجن فيه","فذكرني به ضيف أطلا",105,"ل",2,0],["وكم يوبخها إن أظهرت ضعة","فتضمر الضعف عنه أي اضمار",106,"ر",1,0],["وكم يقولون فى ذا المنع مصلحة","تالله ما صدقوا لكنهم قدروا",107,"ر",3,0],["وكم يد لك بالنعماء هاطلة","كأنها في سماء المجتدى سحب",108,"ب",1,0],["وكم يتعالى نجم نحسك طالعا","وكم يتهاوى نجم سعدك آفلا",109,"ل",2,0],["وَكَم يُواري العدى تَحتِ الثَرى رِمماً","وَيَحمِلُ الحَي وَالاسرى من زَند فِكرِهِم",110,"م",1,0],["وكم يَنهَى النُهَى عزماً","وطبعاً منهُ لم يُشجَب",111,"ب",1,0],["وَكَم يضيّع بين السهل والجبلِ","لا يشتكي وجلاً إلا إِلى أَملِ",112,"ل",1,0],["وكم يعانقني كيما أعانقَهُ","وكم تشفّع لي أن لا أُفارقَهُ",112,"ه",1,0],["وَكَم يجهد الإِنسان في جَمع صحبةِ","تمزقها الدُنيا بهول التشتت",113,"ت",1,0],["وَكَم يائس لَو يَدري ما طالَ يَأسه","وَلا باتَ صاد تحتَ رجليهِ حشرج",114,"ج",1,0],["وكم يا ليت شعري من عفافٍ","تضمن ذلك الجدث الجديدُ",115,"د",1,0],["وكم يروح الروح في راحة","وحاسدي يمسي بآه وآح",116,"ح",1,0],["وكم ينجي إلهي بالشفاعة من","خير البرية من غاص بها سجرا",117,"ر",2,0],["وكم ينحى وينفى كل مبتدع","عن ورده ورجال أحد ثوا الغيرا",117,"ر",2,0],["وَكَم يَقبَلونَ الصُبحَ في الفَضلِ ظُلمَةً","وَكَم يَنسِبونَ القُبحَ لِلحُسنِ الصُنعِ",118,"ع",1,0],["وَكَم يَرى بِالهَوى مَن كانَ ذا شَرَفِ","قَناً ذَليلاً مُطيعاً كُلَّ مُؤتَمَرِ",119,"ر",1,0],["وَكُمَيت أَرَّقها وَهَجُ الشَمْ","سِ وَصيفٌ يَغلي بِها وشِتاءُ",120,"ا",2,1],["وكميت كأنها البرق في اللمح","يهب منها نسيم شذاكا",121,"ك",2,0],["وَكَم يدعي بالفضل مرءٌ تحفُّهُ","سخافة فكر عن صراطٍ تواربُه",122,"ب",2,0],["وكم يتَّعظ نصحاً وَيَخشى غوائلا","وصرف زمانٍ دائراتٌ نوائبُه",122,"ب",2,0],["وكم يتلق العلم في جامعاته","أوانس لا تحصى وأفواج فتيان",123,"ن",1,0],["وَكَم يَذكُرونَ الأَيكَ وَالطَيرَ صُدَّحاً","عَلَيها فَلَم نَسمَع سِوى صَوتِ ناعِبِ",124,"ب",1,0],["وَكَم يُصابُ سَيرُها","بِعِلَّةٍ مُساوِرَه",125,"ر",2,0],["وَكَم يُحمِّلُهُ العُشاقُ لَوعتَهُم","صَوناً لِمَكنونِها عَن طائِشٍ نَزِق",126,"ق",1,0],["وكم يحيى بك العلم","فلم يقتلك العلم",127,"م",1,0],["وكميت الراح فيه","من لجين الماء عذر",128,"ر",1,0],["وكم يوم حزنٍ زلزل الأرض وقعهُ","فكان على أهل السماء عصيبا",129,"ب",2,0],["وكم يبكي على الدنيا بنوها","ويبكي (أحمداً) أمٌ ثكولُ",130,"ل",1,0],["وكم ينجي إلهي بالشفاعة من","خير البرية عاص بها سجرا",131,"ر",2,0],["وكمْ يُسْعَدِ الأعداءُ منكَ بِكَبْوَةٍ","فإنْ لُذتَ للصبر الحميدِ تَجادَبوا",132,"ب",3,0],["وكم يُغرَى بهم ذئبٌ شريسٌ","فتسمع منهمُ ذلّ النواح",133,"ح",1,0],["وكم يد لك في ماضي الكفاح بنت","لنا الحياة فما ننساك في كرب",134,"ب",1,0],["وكم يائسٕ قد عُلَّ بالوَهنِ لَيْلُهُ","وماذاقَ فجْراً من شفاهِ المَتاعِبِ",135,"ب",1,0],["وَكَمْ يَذوبُ علَى نارِ انْتظارِ مُنىً","قلْبي الشَّغوفُ وَتحْيا الرُّوحُ بِالأمَلِ",136,"ل",1,0],["وكَمْ يُردِي قَبِيحُ الفِعْلِ قَلبًا","ويَنضُو .. مِنْ مَعَالِيهِ الضِّيَاءُ",137,"ا",2,0],["وكم يشوقُ فؤادي ضعنُ من رحلوا","وقد تقلّدَ جيدي منهمُ مسدا",138,"د",2,0],["وكمْ يُجاوِبُهُ بيتُ الغرامِ: \"ألا","يا أيُّها الشعرُ هذانِ القريضُ هما\"",139,"م",2,0],["وَكم يُولى صاحباً ظَهره","وَمثل ذَا الْعَيْب رضى آلك",140,"ك",1,0],["وكم يروون عن حكمٍ عدولٍ","أتى فكأنه عدل السماءِ",141,"ا",2,0],["وكم يهوِّدُ صهيونٌ عروبتها","وينشر الإفك والتضليل والتهما",142,"م",2,0],["وكم يزيدك إجلالا مقامك ذا","يا خير من سجدوا يا خير من بَرّوا",143,"ر",3,0],["وكم يلعب بي الهاجوس عيا يدفعه تنهيد","يشب ضلوعي بروعي يهشمها يكسرها",144,"ر",3,0],["وكم يُقادُ إلى مَنْ يعنفونَ على","ما عندهُ من تجنَّهمْ فيتَّبِعُ",145,"ع",1,0],["وكم يكون اصطباري بعد رحلتهمْ","عنِ العقيقِ وكم بالطيفِ اقتنعُ",145,"ع",1,0],["وَ كَمْ يَا رَسُولَ اللهِ أَرْجُو شَفَاعَةً","رَمَتْنِي هُمُومُ الذَّنْبِ ثَكْلَى تُهَيِّجُ",146,"ج",1,0],["وَكَمْ يَوْمٍ يَمُرُّ وَقَدْ","هَوَى مِنْ هُونِكَ الْقَطْرُ!",147,"ر",1,0],["وكم يَعْسلُ الحرفُ الجَميلُ على فمي","يُريقُ سُلافًا في كؤوسٍ منَ الوَجْدِ",148,"د",1,0],["وكم يكون البعد طال الطويل","وكم يداري الصبر صابر",149,"ر",1,0],["وكم يحسدونَ الغريبَ الكريمَ","إذا طِبنَ أخلاقُهُ والثيابْ",150,"ب",1,0],["وكمْ يقولُ الفتى غدًا وغدًا","وهوَ بجهلٍ عن يومِهِ يغفلْ",151,"ل",1,0],["وكمْ يصافحُ منْ لا يدى يدهُ","ولا فمي عندَ تقبيلِ الثرى فمهُ",152,"م",2,0],["وكم يسايرني من لا يسير وكم","يروم فضلي غر بالكلام غبي",153,"ب",2,0],["وكم يَبِعْنَ خفاءً مِن مواشينا","يخُنّنا دون أن ندري، ويدرينا..",154,"ن",2,0],["وكم يَشِيع الأسى في قلبِ باسمةٍ","وكم تشُعُّ القوى من وجهِ مكدودِ",155,"د",1,0],["وكم يُغرّد في بغداد مُفْتَجِعٌ","من الحصار، وكم جفّت قوافينا",156,"ن",2,0],["وكم يعز على طلابه أدب","زانت روائعه المثال والحكم",157,"م",1,0]]}