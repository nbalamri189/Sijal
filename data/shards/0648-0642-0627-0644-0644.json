5900",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[4927,"قصيدة الثورة على الشبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=79601",""],[5032,"نوح الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=200672",""],[5050,"أرى الأيام لي حربا","https://www.poetsgate.com/ViewPoem.aspx?id=38212",""],[3271,"عارية ستانلي باي","https://www.poetsgate.com/ViewPoem.aspx?id=102703",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5167,"الشمس تشبهه والبدر يحكيه","https://www.poetsgate.com/ViewPoem.aspx?id=181117",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5213,"يقولون هذا الفنغراف الذي بدا","https://www.poetsgate.com/ViewPoem.aspx?id=170450",""],[5277,"حكايةُ وجع","https://www.poetsgate.com/ViewPoem.aspx?id=186594",""],[5277,"وقفةٌ على أطلالِ القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=200887",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5351,"دعوه يعد للعشرة","https://www.poetsgate.com/ViewPoem.aspx?id=203209",""],[5397,"تعجب الدهر من صبري ومن جلدي","https://www.poetsgate.com/ViewPoem.aspx?id=157958",""],[5535,"سأودعك السر الذي قد كتمته","https://www.poetsgate.com/ViewPoem.aspx?id=201513",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5691,"شدّوا الحزام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207057",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5741,"أرانا رقم صدغيه مثالاً","https://www.poetsgate.com/ViewPoem.aspx?id=187466",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[5912,"برج الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203933",""],[6003,"في حضرة النبي","https://www.poetsgate.com/ViewPoem.aspx?id=188899",""],[6069,"وأهيف القد سهل الخد أسمر","https://www.poetsgate.com/ViewPoem.aspx?id=105667",""],[6075,"( الحسن توجها )","https://www.poetsgate.com/ViewPoem.aspx?id=195130",""],[6093,"أسارةُ إنَّ الهّجْرَ للحبِّ قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=176430",""],[6270,"كأنما شمْعة الرقرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69083&r=&rc=7",""],[6336,"عشاق في الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73561&r=&rc=22",""]],"verses":[["وقال لِتِرْبَيْهِ ارْفَعا السِّجْفَ إنني","أحِسُّ بزَوْرٍ للْمَنايا تَعرّضا",0,"ض",2,0],["وَقالَ لي لا تَلُمني لَم أَزَل كَلِفاً","حَتّى أَتَيتُكَ في الظَلماءِ مُستَتِرا",1,"ر",2,0],["وَقالَ لا أَشتَري عاراً بِمَكرُمَةٍ","فَاِختارَ مَكرُمَةَ الدُنيا عَلى العارِ",2,"ر",1,0],["وَقالَ لِلقَومِ حاديهِم وَقَد جَعَلَت","وُرقُ الجَنادِبِ يَركُضنَ الحَصى قيلوا",3,"ل",3,0],["وَقالَ لِيَ البَلاغُ وَيحَكَ إِنَّها","بِغَيرِكَ حَقّاً يا كَثيرُ تَهيمُ",4,"م",1,0],["وَقالَ لِأَهلِ الدارِ لا تَقتُلوهُمُ","عَفا اللَهُ عَن ذَنبِ اِمرِئٍ لَم يُقاتِلِ",5,"ل",1,0],["وقال لي ذاك قولي","ما احتل قَسُّك دَيري",6,"ر",2,0],["وقال ليَ التأميلُ فيه ألا ادْعُهُ","لخطْبِكَ لا تَعظُمْ عليك عظائمه",7,"م",2,0],["وَقالَ لَيسَ التُرابُ داراً","لِلشِعرِ فَاِرجَع إِلى السَماء",8,"ا",2,0],["وَقالَ لِأَحلامِ البِحارِ تَجَسَّدي","مَواكِبَ أَلوانٍ وَجَيشَ عَجائِبِ",9,"ب",1,0],["وَقالَ لِأَغصانِهِ صَفِّقي","وَلِلطَيرِ في الأَرضِ أَن تَخطُبا",10,"ب",2,0],["وَقالَ لِلأَضيافِ سَمعاً فَلي","كِلمَةٌ العَدلُ يُمليها",11,"ي",3,0],["وَقالَ لِيَ الفَتى وَصلُ الصَبايا","وَقالَت لِيَ الهَوى البِنتُ الصَبِيَّه",12,"ي",2,0],["وقال ليَ الغابُ في رقَّةٍ","محبَّبَةٍ مثلَ خفْقِ الوترْ",13,"ر",1,0],["وقال لها قدْ مُنِحْتِ الحَيَاةَ","وخُلِّدْتِ في نَسْلِكِ المدَّخَرْ",13,"ر",1,0],["وَقالَ لي في دَمِكَ المَسفوكِ","تَسلِيَةٌ عَن خَيبَتي في الديكِ",14,"ك",1,0],["وَقالَ لا أَحكُمُ حَسبَ الظاهِرِ","فَمَزَّقَ الظَبيَينِ بِالأَظافِرِ",15,"ر",1,0],["وَقالَ لِلتَيسِ اِنطَلِق لِشَأنِكا","ما قَتَلَ الخَصمَينِ غَيرُ ذَقنكا",15,"ك",2,0],["وقال لقد سَبّحْتُ دهراً مُهَلِّلاً","وأَسْهَرْتُ بالتّأْذينِ أَعْيُنَ هُجّدِ",16,"د",1,0],["وَقالَ لَعاً لِلعاثِرينَ وَقَد رَأى","وُثوبَ رِجالٍ فَرَّطوا في العَواقِبِ",17,"ب",1,0],["وَقالَ لِيَ الأَعداءُ ما أَنتَ قائِلٌ","وَلَيسَ يَراني اللَهُ أَنحَتُ مِن جُرفي",18,"ف",2,0],["وَقالَ لَهُم حُلّوا الرَحالَ فَإِنَّكُم","هَرَبتُم فَأَلقَوها إِلى خَيرِ مَهرَبِ",19,"ب",1,0],["وَقالَ لَو شَنَّفتَ أَسماعَنا","بِبَعضِ ما نَظَمتَ في ذا الأَوانِ",20,"ن",1,0],["وَقالَ لِلسَوسَنِ ماذا الَّذي","يَقولُهُ الأَشيَبُ في حَضرَتي",21,"ت",2,0],["وَقالَ لا ذُقتُها فَقُلتُ لَهُ","مِن مِثلِ ذا اليُبسِ يَحدُثُ الجَرَبُ",22,"ب",1,0],["وقال لمن أدّى المُصابَ مُعَنِّفٌ","فظيعٌ من الأنباءِ جئتَ به إدّا",23,"د",2,0],["وَقَالَ لا تَكْتُمَنْ أَمْرَاً عَلَيَّ فَقَدْ","عَلِمْتُ مَا بِكَ مِنْ بَادٍ وَمُكْتَمِنِ",24,"ن",1,0],["وقال لهم ما بِي إلى المالِ حاجةٌ","وَحَسْبِي من الخيراتِ ما اللَّهُ مانحُ",25,"ح",1,0],["وقال له إنّي لأعلمُ بالذي","تَدِينُ بهِ فَاشْهَدْ تَكُنْ غيرَ آثِمِ",26,"م",1,0],["وقال لئن أَبيتَ فلا تلُمْنِي","إذا أخذتكَ داهيةٌ نَآدُ",27,"د",1,0],["وقال له لا يَعْلُ صوتُك إنّه","لَيسمعُه مَن جاءَ بالحقّ هاديا",28,"ي",2,0],["وَقَالَ لَهُ المَجدُ كُن نَاصِرِي","فَثَارَ إلَى دَعوَةِ القَائِل",29,"ل",1,0],["وَقالَ لَها مَن حَولَها جِئتِ مُنكَراً","فَحَقٌّ بأَن تُلحَي عَلَيهِ وتُرجَمي",30,"م",2,0],["وَقالَ لا تَشرَبُ بِالنَهارِ","وَفي ضِياءِ الفَجرِ وَالأَسحارِ",31,"ر",1,0],["وَقالَ لي ما قُلتَهُ","وَغَيرُهُ في رَحمَتِه",32,"ت",2,0],["وَقالَ لَعَمري لَو أَحَطتُم بِأَمرِنا","لَلُمناكُمُ لَكِن سَنوسِعُكُم عَذرا",33,"ر",2,0],["وَقالَ لِابنَيهِ ضِنّا عِندَ بَيعَكُما","بِها قَليلاً لِتَزدادا مِنَ الوَرِقِ",34,"ق",1,0],["وَقالَ لَهُ صَلِّ داعي الهُدى","وَقالَ لَهُ مُلحِدٌ لا تُصَل",35,"ل",1,0],["وَقالَ لَكُم نَبِيُّكُم إِذا ما","كَريمُ القَومِ جاءَ فَأَكرِموهُ",36,"م",3,0],["وقالَ لِعِرْسِهِ بِيني ثَلاثاً","فما لَكِ في العَرِينَةِ مِنْ مُقامِ",37,"م",1,0],["وقال لنا في عالمِ الغدِ جَنَّةٌ","غزيرةُ أنهارٍ وريفةُ أظلالِ",38,"ل",1,0],["وقال لها الحسنُ يا ربتي","فقالت له كلّ شيءٍ حسنْ",39,"ن",1,0],["وقال له يا صاحبي قد جهلتني","ويا رُبَّ شعرٍ ساقهُ غيرُ شاعرِ",40,"ر",1,0],["وقال لم يأذن ولم يسلّم","لا أشتري الرّوم بنفس مسلم",41,"م",1,0],["وَقالَ لَها البَدرُ المُنيرُ أَلا اِسفِري","فَإِنَّكِ مِثلي في الكَمالِ وَفي السَعدِ",42,"د",1,0],["وَقَالَ لِيَ الْخُلَّانُ صِفْ حُسْنَ يَوْمِنَا","فَأَنْتَ بِنَجْدِيِّ الْكَلامِ خَلِيقُ",43,"ق",1,0],["وَقَالَ لِمَنْ في دارهِ لا تُقاتِلُوا","عَفَا اللهُ عَنْ كُلِّ امرىءٍ لم يُقَاتِلِ",44,"ل",1,0],["وَقالَ لَكَ اللَهُ سِر","ترِث جَنَّتي لا تَرث",45,"ث",1,0],["وقال للشاءِ، خوضوا، وارتعوا مَعَهُ","من لاذ بالذئب منكم، لاذ بالحرم",46,"م",1,0],["وقال لتهن الوصل مني فإنما","يهون إلى المحبوب خوض الشدائد",47,"د",1,0],["وقال للمصطفى ماذا سنصنعه","والقوم بالباب والأسياف والعطب",48,"ب",1,0],["وقال للعاطفات ِ العاصفاتِ بهِ","ألآنََ فالتمسي مِن حُكْمهِ هربا",49,"ب",2,0],["وقال لها الصغرى : هداكِ لما رأى","هوى غيرُ معصيٍّ، ولبٌّ مشيع",50,"ع",1,0],["وقال لحاني عليه العذول","فقلت تأود هيامي لذا",51,"ذ",2,1],["وقال لي القلبُ استعدَّ فإنني","أراني معدّاً في أمورِك قيمِّا",52,"م",2,0],["وقَالَ لَهُم إِنِّي مُهَاجٍ لِشَاعِرٍ","وَدَأبِيَ أن أُهجَى دَوَاماً وأهجُوَا",53,"و",2,0],["وقَالَ لِكُلِّ مَحمَدَةٍ تَعَالَى","وقَرِّى في مَكَانِكِ واَستَقِيمِى",54,"م",2,0],["وَقالَ لَكَ اِحكُم في بِلادي وَأَهلِها","وَهَل حَكَّمَتكَ البيضُ إِلّا لِتَحكِما",55,"م",2,0],["وقال لا سلم حتى يُستقاد لها","من ظُلمِ مستلبٍ أو جور مغتصب",56,"ب",1,0],["وقال لها خد يورده الحيا","فيحمر إن تزهق لفرط التنغم",57,"م",1,0],["وقال لبعض بعضهن كذا بنا","نجرب أي اللحظ أمضى مقاطعا",58,"ع",2,0],["وقال لي اركب قلت كلا لا مشين","وألزمني حتى ركبت مطيتي",59,"ي",1,0],["وقال للائم في فرط السخا","دعني فحبي للثناء عذري",60,"ر",2,0],["وقال لأنه من شاء منا","يقيم بنفسه ربا أقامه",61,"م",2,0],["وقال لو جزت هذا قدر أنملة","هلكت فاذهب فأنت المفرد العلم",62,"م",1,0],["وقال لي يا ضعيف ويلك من","دسّك قل لي يا نكس إخوانه",63,"ن",2,0],["وقال لي بلسان العلم عن أنف","إن القناعة أولى بي من الطمع",64,"ع",1,0],["وقال لها غِيبي فإنيَ طالعٌ","على الناسِ بالنور الذي كان بالأمسِ",65,"س",1,0],["وَقالَ لي قَولَ ذي عِلمٍ وَتَجرِبَةٍ","بِسالِفاتِ أُمورِ الدَهرِ وَالحِقَبِ",66,"ب",1,0],["وقال لدى التمام أرّخ","ردوه فماءه عذب مصفى",67,"ف",2,0],["وَقالَ لِيَ الأَجدادُ مِن مَسقَطِ العُلى","كَبِرنا بِهِ وَالفَضلُ بِالفَضلِ يَكبُرُ",68,"ر",1,0],["وَقالَ ليَ الباروكُ مرَّ بِشَعرِهِ","عَبيري فَمِسكٌ ما نَشَقتُ وَعَنبَرُ",68,"ر",1,0],["وَقالَ لَهُ إِذا ما كُنتَ شَهماً","أَنِلني مِن خُزاعَةَ مِنكَ مَهرا",69,"ر",2,0],["وَقالَ لَقَد خَلَعَ الحَقلُ عَنهُ","رداءَ الشِتاء وَغطّى الحَجَر",70,"ر",1,0],["وَقال لِلوَردِ أَما تَستَحي","مِنّي إِذا فَتَّحتَ في خدّي",71,"د",2,0],["وقال لَحْظِي ضعيف حين أُرسله","ووَجْنتي وجنةٌ بالوَهْم تنفطر",72,"ر",1,0],["وقال لهم ذرّاً ألست بربكم","فقال بلى منهم عصىً وطيع",73,"ع",1,0],["وَقالَ لي جَدُّ أَبي إِنَّهُ","أَقرَحَ مُذ كانَ أَبي أَمرَدا",74,"د",2,0],["وقال لي ويحك يا","أحمق لم لم تتب",75,"ب",1,0],["وقال لأسد البيشة العير اقبلوا","إلي لألقي فوق كاهلكم ثقلي",76,"ل",2,0],["وَقالَ له سَلني رضاك فانني","عَلى كل شيء في رضاك قَدير",77,"ر",1,0],["وَقالَ لي لا جُزيتَ خَيراً","ضَيَّعتَني عِندَ شَرِّ قَومِ",78,"م",1,0],["وقال لسان الحال للقوم جددوا","شعار التهاني قد بدا لكم الفخر",79,"ر",1,0],["وَقال لَيتَ شعري","ما قدرُ هَذا القِدر",80,"ر",1,0],["وقال لا أخبر منها بما","جاءت بهقلت ولا أذكى",81,"ك",2,0],["وَقالَ لَها اليَمَنُ لَمّا اِستَهَلَّت","بِبِرٍّ وَصفوٍ تَعيشي مُفيدَه",82,"د",2,0],["وَقالَ لي كَيْفَ تَرَى","قُلْتُ أَرَى مِثلَ الخَرا",83,"ر",2,0],["وَقالَ لِمَن يَهواهُ صَرَّفَني الهَوى","فَفي يَدِ عِتْبِي اليَومَ ثِنيُ عِناني",84,"ن",2,0],["وَقالَ لَهُم نِمتُم فَلا تُنبِهوا القَطا","وَلَو لَم تُنَبَّه باتَتِ الطَيرُ لا تَسري",85,"ر",2,0],["وقال لي قد طلب الجمالي","على سعد الدين ذي الأفضال",86,"ل",1,0],["وقال لهم لا ما أقاموا الصلاة في","أناس أتوا كل القبائح عن قصد",87,"د",1,0],["وقَال لَيس له قلبٌ يُطيقُ بهِ","صَبراً ولو همَّ بالسُّلوانِ لافْتُضِحَا",88,"ح",2,0],["وقال لك التَّوفيق لو كنت سامعاً","وراءك ما تبغي من الفضل والنَّدى",89,"د",2,0],["وقالَ ليَ الهوى فيه اصطحبها","وطِبْ نفساً بها فالوقت طابا",90,"ب",2,0],["وقال لحِقتُ وارتفعتْ وِهادي","فمالك ترفع الأشعارَ عنّي",91,"ن",2,0],["وقال لي المجدُ وقد أحمدتُه","تلك الغصونَ أثمرتْ هذا الجنا",92,"ن",2,0],["وقال لي اختر فَتَخَي","يرتُ لنفسي الأفضلا",93,"ل",2,0],["وقال لمن أولاك هذا النزيه في","بلادك مذ أوصتني بمؤيد",94,"د",1,0],["وقالَ لسيِّدي الغَوْثُ الرِّفاعِيِّ","تولَّ الشَّأنَ منهُ بِلا تَوَانِ",95,"ن",1,0],["وقالَ لي ارْجِعْ عارِفاً","رأْساً لكلِّ بَطَلِ",96,"ل",1,0],["وقالَ لهُمْ جلَّ القَديمُ بغَيْظِهِمْ","غلى الغيظِ مُوتوا قَدْرُ قَوْمي لقدْ جَلاَّ",97,"ل",2,0],["وقالَ لأهْلهِ كونوا فَكانوا","وأيَّدَهُمْ وإن فَجَرَ المُنافِقْ",98,"ق",1,0],["وقالَ لي تكرُّماً","قمْ يا غَريبَ الغُرَبَا",99,"ب",2,0],["وقال ليَ النَدمانُ لما تركتُها","أألجِدُّ هذا مِنكَ أم أنتَ تَلعبُ",100,"ب",1,0],["وَقالَ ليَ اِصطَبِر عَنها وَدَعها","لِخَوفِ اللَهِ لا خَوفِ الأَنامِ",101,"م",1,0],["وَقالَ ليَ الناسُ إِنَّ الحَياء","أَتاكَ مَعَ المَلِكِ المُقبِلِ",102,"ل",1,0],["وقال لِيَ الدّهرُ لمّا بقي","تُ إمّا المشيبُ أو المَهْلَكُ",103,"ك",1,0],["وَقال لي أنتَ مسلولٌ فقلت له","ما كان ذاك ولكنْ ربّما وعسى",104,"س",2,0],["وَقالَ لي حَسبُك مِمّا أرى","فقلتُ أو ترضى فما حسبِي",105,"ب",2,0],["وقال لي كن وأنا أسمعه","وإنما بلطفه أسمعني",106,"ن",2,0],["وقال لي الناي إني من إشارته","ونفخ روحي منه تبعث الصور",107,"ر",1,0],["وقال لنا اشكروني","وبالشكر المزيد",108,"د",1,0],["وقال للقوم إن اختلفتم","فيمن يلي منكم إذا اجتمعتم",109,"م",1,0],["وقال لا بد من الشهود","مؤكدا في غير ما تأكيد",109,"د",1,0],["وقال لو أدركت فيكم سالما","وليته الأمر فكان الحاكما",109,"م",2,0],["وقال لو وليتكم عليا","لم أبق في النصح لنفسي شيئا",109,"ا",2,0],["وقال لست جاعلا لي أبدا","أهل الضلال والمعاصي عضدا",109,"د",2,0],["وقال للأعوان أدخلوه","فخرج القوم فاعلموه",109,"ه",1,0],["وقالَ لي مسكني السَّماءُ فإِن شئ","تَ أَو اسْطَعتَ فارْقَ أَو فَارِقْ",110,"ق",1,0],["وَقالَ له اللَهُ اعطِ وهَب","وَباعَ له المَجدُ بَيعاً صِفاقا",111,"ق",2,0],["وقال للناسِ من مَولاكُم قبلا","يومَ الغدير فقالوا أنت مولانا",112,"ن",2,0],["وقال لهم بصوتٍ جَهْوَرِيٍّ","وأسمع صوتُه من كان حيّا",113,"ي",2,0],["وقال لك النبيُّ يا حُمَيْراً","سيبُدي منكِ فِعلُ الحاسِدينا",114,"ن",2,0],["وقال لقد ذُكِرتُ لدى إلهي","فأبدى ذِلَّةَ المتواضِعينا",114,"ن",2,0],["وقال له يَشكو وقد جئتُ مرّةً","وأخرى وأخرى كلَّ ذلك أَدفعُ",115,"ع",1,0],["وقال له ما إن يُحبّك صادِق","من الناس إلاّ مؤمنٌ متورِّعُ",115,"ع",1,0],["وَقالَ لَهُ أَنتَ المُدير الَّذي لَهُ","بِتَدبيره صَعب الأُمور يَلين",116,"ن",1,0],["وَقالَ لَهُ مَجدي يَهنِّي مؤرخاً","أَتى صالح للشَمس وَالبَدر حاليا",117,"ل",3,0],["وقال لقد جاهرتني بملامَةٍ","ومن لي بدهرٍ كنت فيهِ أكاتمُه",118,"م",2,0],["وقال للعلم والآداب لا تردا","إلا علي فما فاها بلا ولم",119,"م",1,0],["وقال للقومِ قفوا ساعةً","فإنه لا بُدَّ مِنْ رجْعَه",120,"ع",2,0],["وقال لهم ثنتان لا بد منهما","صدور القنا والبيض أو أن تسلموا",121,"م",3,0],["وَقالَ لا يَفتَخِر في رَوضِهِ شَجَرٌ","عَليَّ يَوماً فَإِنّي دَوحَة الذّهبِ",122,"ب",1,0],["وَقالَ لي هَذِه المِرآةُ نادِرَةٌ","أَظنُّ ما هَذِهِ المِرآةُ مِرآةُ",123,"ه",1,0],["وَقالَ لي اِصطَبِر مَضى وَعدٌ وذا","فَقُلتُ مرَّ قَبلَهُ سَبعونا",124,"ن",2,0],["وَقالَ لَظى خَدَّيهِ لمّا تَسَعَّرت","فَلَم أَستَطِع أَنِّي أُقيمُ عَلى النّارِ",125,"ر",1,0],["وَقالَ لَهُ سَلْ تُعطَ وَاِشفع محمّدٌ","تُشفّع وَأولاه قَبول الرّجاءِ",126,"ا",2,0],["وقال لهم في الحرب كونوا رواسيا","فكانوا جبالاً لا تميد مع العصف",127,"ف",1,0],["وَقالَ لَهُم ذوقوا جَنى ما غَرَستُمُ","أَلا رُبَّ بانٍ لِلعِمارَةِ مُخرِبِ",128,"ب",1,0],["وَقالَ لِلبَناتِ أُمُّكُنا","نَصيبُها تَأخذه مِنكُنّا",129,"ن",2,0],["وَقالَ لي ما هَذِهِ الإِشاره","ما الكَف ما الخَيط وَما العِباره",130,"ه",1,0],["وَقالَ للجُلّاس يا أَحبابي","أَرى زَواجَها مِن الصَواب",131,"ب",1,0],["وَقالَ لَهُ تُومى الحَكيم أَلَم أَقُل","بِموتَتهِ مِن قَبل عزريلَ يَنزل",132,"ل",1,0],["وَقالَ لَهُم مَن مِنكُم ساءَ خلقه","فَلا يخشَ مني أَن أَرى كُنهَ أَمرِه",133,"ر",2,0],["وَقالَ للقرد تَأمل يا أَبي","ما سَرَقَ المتاع غَير الثَعلبِ",134,"ب",1,0],["وَقالَ لَهُ وَالهَمُّ فطَّر قَلبَه","كَأَنَّ لَدَيهِ مُنكر وَنَكير",135,"ر",1,0],["وَقالَ لِلمَوتِ اِنصَرف ما أَشنَعَك","وَفي الوَفا بِطَلَبي ما أَسرَعَك",136,"ك",1,0],["وَقالَ لَيتَ لَو رَعيت الناسا","إِنَّكَ عِندي خَير مَن قَد ساسا",137,"س",2,0],["وَقالَ لي حِكايَةً وَقعيَّه","مَرَّت عَلَيهِ وَهوَ في البَريَّه",138,"ه",1,0],["وَقالَ لِلبَواب إِحذَر الوَلَد","لا تخرجَنهُ قَطُّ يَمشي في البَلَد",139,"د",1,0],["وَقالَ للأُستاذ إِن المِشنَقه","مِن يَوم جئت عِندَنا مُعَلَّقه",140,"ه",1,0],["وَقالَ لا أَترك مِنهُم أَحَدا","يَرعى الحَشيش في جواري أَبَدا",141,"د",2,0],["وَقالَ لا بُدَّ أذيع المَكرا","وَأَن يَكون الكُلُّ مثلي زُعرا",142,"ر",2,0],["وَقالَ للرُسل لَكم ومَن حَضَر","إِلى عِبادَتي أَمانٌ من خَطر",143,"ر",1,0],["وَقالَ لي هَل تَشتَري الكِتابا","تَغنمه وَتَغنم الثَوابا",144,"ب",2,0],["وَقالَ لي غِشُّكَ للغشاشِ","أَلَذُّ مِن نَومك في الفِراشِ",145,"ش",1,0],["وَقالَ لا أَبغي لِشيء فعلا","أَو تَجعَلوا لِي فَوقَ ذاكَ جُعلا",146,"ل",2,0],["وَقالَ لا يَظهر المَريخ في سحرٍ","مثل السماكين إِلّا بعدَ أَيامِ",147,"م",1,0],["وَقالَ للخدّام أَينَ العلفُ","إِيتوا بِهِ في حَضرَتي لا تَقِفوا",148,"ف",3,0],["وَقال للنملةِ أَنت جارَتي","ما لي سِواك في قَضاء حاجَتي",149,"ي",1,0],["وقال لما قال من","يسمع في ظل الفنا",150,"ن",2,0],["وقال لى دار هو الدارى","حين رأى دمع عيونى جارى",151,"ر",2,0],["وقال للوشاة هذا جارى","ولم يقل هذا محب عذري",151,"ي",1,0],["وقال لي إن كنت تهوين التحف","والأكل والشرب وحلة الطرف",152,"ف",1,0],["وقال لي أجتنِ ورداً جنيّاً","لقلب الصّب ما أحلى اجتناهُ",153,"ا",2,0],["وَقالَ لِأَهلِ الدارِ مَه لا تُقاتِلوا","عَفا اللَهُ عَن كُلِّ اِمرئٍ لَم يُقاتِلِ",154,"ل",1,0],["وقال له سل تعط واشفع بعزة","تشفع وقل تسمع فأنت حبيب",155,"ب",1,0],["وقال لي كل من يممت ساحته","إليك إن المطايا جازت الهدفا",156,"ف",2,0],["وقال له لا تخش فالحق حاضر"