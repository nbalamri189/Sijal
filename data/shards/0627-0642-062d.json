{"poems":[[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[60,"أقحم فلا تنالك الأسنة","https://www.aldiwan.net/poem30833.html","الرجز"],[71,"هكذا كن محبة واحتفالا","https://www.aldiwan.net/poem29302.html","الخفيف"],[173,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[438,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[445,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64229","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25341","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109801","الخفيف"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105782","الخفيف"],[4830,"نجيع الطف","https://www.poetsgate.com/ViewPoem.aspx?id=199845",""],[5038,"خصومة الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=190124",""],[5150,"نشيد المقاومة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202934",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5411,"ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=187954",""],[5851,"سفيرة ورسالتها الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175291",""]],"verses":[["أَقحَمتُ مُهري تَحتَ ظِلِّ عَجاجَةٍ","بِسِنانِ رُمحٍ ذابِلٍ وَمُهَنَّدِ",0,"د",1,0],["أَقحِم فَلا تَنالَكَ الأَسِنَّة","وَإِنَّ لِلمَوتِ عَلَيكَ جُنَّة",1,"ه",1,1],["أقحموا النفسَ في مهالكِ زهدٍ","يفترسْنَ الأرْواحَ والأموالا",2,"ل",2,0],["أَقحَمتُها شَرجَ النَّجاءِ شِمِلَّةً","أَحَداً يُباريها كمَيتٌ مُذهِبُ",3,"ب",1,0],["أُقحوانٌ غضٌّ وورْدٌ نضيرٌ","وشقيقٌ قانٍ بها وبَهارُ",4,"ر",1,0],["أَقْحَمْتَ أَجيادَ الجِيادِ مكرَّماً","فَصَلِينَ جاحِمَها وكنتَ إِمامَها",5,"م",3,0],["أقحطتْ أوجهُ البلادِ ومِن حو","لك للخِصبِ روضةٌ وغديرُ",6,"ر",1,0],["أُقحوانٌ وسُوسَنٌ وشقيقٌ","وبهارٌ يُجْنَى وآذَريون",7,"ن",1,0],["أُقحُوانٌ وَبَهارٌ مونِقٌ","وَسِوى ذلِكَ مِن كُلِّ الطُرَف",8,"ف",1,0],["أَقْحَمْتَنِي فِي النَفْنَفِ النَفْنافِ","فِي مِثْلِ مَهْوَى هُوَّةِ الوَصَّافِ",9,"ف",1,0],["اقحوان يفاخر الثغر في الحس","ن وورد يفاخر الوجنات",10,"ت",1,0],["أقحُوان مُعانقٌ لشقيقٍ","كثغورٍ تَعضُّ وردَ الخدودِ",11,"د",1,0],["أقحمْ خطاكَ وَدَع منْ قال قد خسِرا","لاتبلغُ المجدَ حتى تركبَ الخطرا",12,"ر",2,1],["أُقْحُوانُ السِنِّ لكِنْ لاكَ بِالضِّرْسِ صَبايا","سافِرٌ في الصِّبْحِ لكِنْ خاطَ في اللَّيلِ عَبايا",13,"ا",3,0],["إقحمْ عُبابَ الهولِ لا تخشَ الفناءْ","قدرُ الشهيدِ الموتُ من أجل البقاءْ",14,"ا",2,1],["أقحمت منك نزوة تتحدى","قدر الله هل تُرى تَشآه",15,"ا",2,0],["أَقْحِمْ ظِلالكَ كَيْ تَطير فَراشَتي","فرُؤى الْهَزيمة إنْ أتتْ فتكتْ بِنا",16,"ن",2,0],["أقحَمتُ نفسي بدُنيا مِن ملامحِها","نسيمُ صبحٍ فريحٌ ثم إعصارُ",17,"ر",1,0]]}