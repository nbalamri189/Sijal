{"poems":[[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[58,"أقحم فلا تنالك الأسنة","https://www.aldiwan.net/poem30833.html","الرجز"],[69,"هكذا كن محبة واحتفالا","https://www.aldiwan.net/poem29302.html","الخفيف"],[167,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[429,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[436,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"]],"verses":[["أَقحَمتُ مُهري تَحتَ ظِلِّ عَجاجَةٍ","بِسِنانِ رُمحٍ ذابِلٍ وَمُهَنَّدِ",0,"د",1,0],["أَقحِم فَلا تَنالَكَ الأَسِنَّة","وَإِنَّ لِلمَوتِ عَلَيكَ جُنَّة",1,"ه",1,1],["أقحموا النفسَ في مهالكِ زهدٍ","يفترسْنَ الأرْواحَ والأموالا",2,"ل",2,0],["أَقحَمتُها شَرجَ النَّجاءِ شِمِلَّةً","أَحَداً يُباريها كمَيتٌ مُذهِبُ",3,"ب",1,0],["أُقحوانٌ غضٌّ وورْدٌ نضيرٌ","وشقيقٌ قانٍ بها وبَهارُ",4,"ر",1,0],["أَقْحَمْتَ أَجيادَ الجِيادِ مكرَّماً","فَصَلِينَ جاحِمَها وكنتَ إِمامَها",5,"م",3,0],["أقحطتْ أوجهُ البلادِ ومِن حو","لك للخِصبِ روضةٌ وغديرُ",6,"ر",1,0]]}