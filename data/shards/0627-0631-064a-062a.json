{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[44,"أريت امرء كنت لم أبله","https://www.aldiwan.net/poem50455.html","المتقارب"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[88,"في الجاهلية والإسلام هيبته","https://www.aldiwan.net/poem68909.html","البسيط"],[95,"قصصت علي من عبر الليالي","https://www.aldiwan.net/poem11215.html","الوافر"],[95,"ماذا تصباك من حال تجددها","https://www.aldiwan.net/poem11314.html","البسيط"],[49,"سلي فتيات هذا الحي عني","https://www.aldiwan.net/poem25127.html","الوافر"],[49,"أقلي فأيام المحب قلائل","https://www.aldiwan.net/poem25203.html","الطويل"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[47,"أما والذي أعطاك فضلا وبسطة","https://www.aldiwan.net/poem65204.html","الطويل"],[47,"لما حصلنا على العشر التي بقيت","https://www.aldiwan.net/poem65637.html","البسيط"],[63,"سواء علينا وعدها ووعيدها","https://www.aldiwan.net/poem51714.html","الطويل"],[33,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[76,"أريت أي بنية","https://www.aldiwan.net/poem12921.html","مجزوء الكامل"],[35,"شكوت إلى رفيقي الذي بي","https://www.aldiwan.net/poem25726.html","الوافر"],[35,"فواكبدا من حب من لا يحبني","https://www.aldiwan.net/poem26032.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[77,"تنبأ المتنبي فيكم عصرا","https://www.aldiwan.net/poem69075.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54776","السريع"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[95,"يَا فِطْنَة سَاهِرَةً لِلْعُلَى","https://www.poetsgate.com/ViewPoem.aspx?id=32574",""],[92,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[47,"أمَا والّذي أعْطاكَ فَضْلاً وبَسْطَةً","https://www.poetsgate.com/ViewPoem.aspx?id=32176",""],[136,"إن كان ربي أخفى الشيخ عن زمر","https://www.aldiwan.net/poem54644.html","البسيط"],[159,"أربع البلى إني إليك لشاك","https://www.aldiwan.net/poem55589.html","الطويل"],[173,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[190,"أريت في النوم دنيانا مزينة","https://www.aldiwan.net/poem43814.html","البسيط"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[216,"حشا في حشائي الهم والشوق ما حشا","https://www.aldiwan.net/poem37871.html","الطويل"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[240,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[240,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[310,"لا والذي بثناكم منطقي فتقا","https://www.aldiwan.net/poem56463.html","البسيط"],[415,"وابتزني رأي عز الدين مستلبا","https://www.aldiwan.net/poem32265.html","البسيط"],[415,"لم يبق لي في هواكم أرب","https://www.aldiwan.net/poem32337.html","المنسرح"],[438,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[445,"طير الفؤاد على لماك تحوم","https://www.aldiwan.net/poem34823.html","الكامل"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[466,"يذل الجحفل الجرار بأسا","https://www.aldiwan.net/poem15440.html","الوافر"],[466,"جلا سدف المفارق نور شيب","https://www.aldiwan.net/poem15444.html","الوافر"],[518,"أريتني النجم يجري بالنهار فلا","https://www.aldiwan.net/poem67796.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138271",""],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107252","الوافر"],[720,"","https://poetry.dctabudhabi.ae/diwan/poem/76781","الطويل"],[762,"","https://poetry.dctabudhabi.ae/diwan/poem/103682","الرجز"],[826,"","https://poetry.dctabudhabi.ae/diwan/poem/140228",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48895","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104592","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120006","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96727","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61119","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56594","السريع"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82556","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80009","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49582","الطويل"],[1727,"","https://poetry.dctabudhabi.ae/diwan/poem/118033","الوافر"],[1846,"","https://poetry.dctabudhabi.ae/diwan/poem/147708",""],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89520","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113870","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201699","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204789","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205057","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202409","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102396","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45759","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66395","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132157","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135173","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135208","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101381","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127110","المجتث"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4660,"","https://poetry.dctabudhabi.ae/diwan/poem/143985","البسيط"],[4767,"اعتقيني","https://www.poetsgate.com/ViewPoem.aspx?id=213742",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[402,"قصصت علي من عبر الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=36449",""],[402,"نسيم لبنان حياني ضحى فشفى","https://www.poetsgate.com/ViewPoem.aspx?id=36027",""],[5804,"العربيّ المحطّم","https://www.poetsgate.com/ViewPoem.aspx?id=190682",""],[469,"سرت زينب والبرق مبتسم الثغر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574816",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""]],"verses":[["أَرى تَركَ الصَلاةِ بِها حَلالاً","فَما أَمتاحُها ماءَ الطَهورِ",0,"ر",1,0],["أَرَيتَ امرَءً كُنتُ لَم أَبلُهُ","أَتاني فَقالَ اِتَّخِذني خَليلا",1,"ل",2,1],["أَرَيتُ القَومَ نارِكَ لَم أُغَمِّض","بِواقِصَةٍ وَمَشرَبُنا زَرودُ",2,"د",1,0],["أرَيتَ تلكَ التي لله قد نَذَرَتْ","أنشودَةً لرسولِ الله تُهديها",3,"ي",3,0],["أَرَيتَ تِلكَ الَّتي لِلَّهِ قَد نَدَرَت","أُنشودَةً لِرَسولِ اللَهِ تُهديها",4,"ي",3,0],["أَرَيْتَ القَوْمَ كَيْفَ الحَقُّ يَعْلُو","وَكَيْفَ نِهَتيَةُ البَاغِي تَكُونُ",5,"ن",1,0],["أَرَيْتَنَا مِنْ فَتَى عَبْسٍ حَقِيقَتَهُ","حَقِيقَةَ المَرْءِ لَمْ يُوصَمْ وَلَمْ يَصِمِ",6,"م",1,0],["أَرَيْتَ مَنْ كَانَ يَرْمِينَا بِمَنْقَصَةٍ","أَنَّا بَنُو بَجْدَةِ الأَفْلاحِ إِنْ نَرُمِ",6,"م",1,0],["أَرَيتَكَ ماتَقولُ بَناتُ عَمّي","إِذا وَصَفَ النِساءُ رِجالُهُنَّه",7,"ن",2,0],["أَرَيتَكِ هَل لي مِن جَوى الحُبِّ مَخلَصٌ","وَقَد نَشِبَت لِلحُبِّ فِيَّ حَبائِلُ",8,"ل",1,0],["أريتمونا عياناً كل مكرمةٍ","كانت قديماً لدينا رَجْم أخبار",9,"ر",1,0],["أريتُم بها المنصور فوزةَ قدْحِهِ","وقد ظنها إحدى الدواهي الصيالمِ",10,"م",1,0],["أَرَيتَكَ الآنَ أَلمَعُ البُروق","أَم شَعلٌ مُرفَضَةٌ عَن حَريق",11,"ق",1,1],["أَرَيتَهُمُ إِذ ذاكَ قُدرَةَ قادِرٍ","وَعَفوَ مُحِبٍّ لِلسَلامَةِ مُستَبقِ",12,"ق",1,0],["أُريتُ ذا رَبعَةٍ في العَينِ مِن قِصَرٍ","وَذاكَ أَطوَلُ مِن شاهِ بنِ ميكالِ",13,"ل",1,0],["أريتَهُمُ وَجْهاً طليقاً وراحةً","يُري بأسَها في النَّائباتِ وجودُها",14,"د",3,0],["أَرَيتَكَ إِذ هُنّا عَلَيكَ أَلَم تَخَف","وُقيتَ وَحَولي مِن عَدُوِّكَ حُضَّرُ",15,"ر",1,0],["أَرَيتَ أَيَّ بُنَيَّةٍ","تُعزى إِلى الرَوضِ النَضيرِ",16,"ر",1,1],["أَرَيتَكَ إِن مَنَعتَ كَلامَ لَيلى","أَتَمنَعَني عَلى لَيلى البُكاءَ",17,"ا",2,0],["أَرَيتِكِ إِن لَم أُعطِكَ الحُبَّ عَن يَدِ","وَلَم يَكُ عِندي إِذ أَبَيتِ إِباءُ",18,"ا",2,0],["أرَيْتَنا فضلَ شمسِ الدِّينِ مُنْتَقِلاً","إليك منه وصَحَّ الخُبرُ والخَبَرُ",19,"ر",1,0],["أريتموني مثالاً من روايتكم","كالأعجميِّ أتى لا يُفصِحُ الخَبرا",20,"ر",2,0],["أريتَني الغيب الذي لا يُرى","كشفتَ لي ما لا يراه البصر",21,"ر",1,0],["أَرَيْتَنَا كَيْفَ تُنَالُ العلَى","وَدونَهنَّ الْعَقَبَاتُ الشِّدَادْ",22,"د",1,0],["أَرَيْتِنَا كَيْفَ تُنَالُ المُنَى","وَدُنَهُنَّ العَقَبَاتُ الشِّدَادْ",23,"د",1,0],["أَرَيتَكَ يا اِبنَ عَمِّ بِأَيِّ عُذرٍ","عَدَوتَ عَنِ الصَوابِ وَأَنتَ لاحِ",24,"ح",1,0],["أَرَيْتِنَا كَيْفَ تُنَالُ المُنَى","وَدُونَهُنَّ العَقَبَاتُ الشِّدَادْ",25,"د",1,0],["أريتكُمُ أنَّ المنافعَ صُوِّرتْ","محامدَ والحرمانَ منها معايبا",26,"ب",2,0],["أريتكُمُ أنَّ ابنَ آدمَ ثعلبٌ","يماشيك منهوباً ويغزوك ناهبا",26,"ب",2,0],["أرَيْتَهُمُ إذْ ذاكَ قُدْرَةَ قادِرٍ،","وَعَفْوَ مُحِبٍّ للسّلامَةِ، مُسَبْقِ",27,"ق",1,0],["أريتكم أعلى أعلى الأصم عدا","أم قرن الأعصم نطح العصم للحجر",28,"ر",1,0],["أَرى تَلَفي ما كانَ يُرْضِيكِ في الهَوى","عَلَيَّ يَسِيراً في بُلوغِ رِضاكِ",29,"ك",1,0],["أَرَيتُكَ إِن أَخَّرتَني وَجَفَوتَني","وَذا الدَهرُ قَد أَربى وَبانَ تَحامُلُه",30,"ل",2,0],["أريت في النوم دنيانا مزيّنة","مثل العروس مشت بين المقاصير",31,"ر",1,1],["أريتني في هواك","ما يوحش الصابرين",32,"ن",1,0],["أرى ترب نعليه دواءً مجرَّبا","لِمَنْ حَلَّ في عينيه طلس من العشَا",33,"ش",2,0],["أَريتَهمُ وقَعاتٍ تزيدُ","على وَقعات الدُّهور الأُلَى",34,"ا",1,0],["أَرَيتَهُمُ حُمرَ المَنايا سَوافِراً","تُطالِعُهُم مِن بَينِ زُرقِ اللَهاذِمِ",35,"م",1,0],["أَريتَهُمُ مِن سُخطِكَ المَوتَ جَهرَةً","غَداةَ اِستَوى في عَزمِكَ السِرُّ وَالجَهرُ",36,"ر",1,0],["أريتك لو صبت ملايينك التي","منحتهم في الترب هل كان يجدب",37,"ب",1,0],["أَرى تتمّة فَخري بَل تَميمتهُ","حُسنَ اِنتسابٍ إِلى عليائِكم صَدَقا",38,"ق",2,0],["أريتَنِي بَعد بِشْرٍ هجرةً وقِلىً","وبَعد بِرٍّ ولُطفٍ قَسوةً وجَفَا",39,"ف",2,0],["أَرَيتُمونِي نَهجَ السُّلُوِّ وَقَدْ","كانَتْ بِيَ الطّرْقُ عَنهُ تَنْشَعِبُ",40,"ب",1,0],["أُريتَ سحابَ الجودِ في أفُقِ الدُجى","فبابُك من ماءِ السحابِ مطيرُ",41,"ر",1,0],["أَرْيٌ تَخَلَّلَ نَظْمَ سِلْكَيْ لُؤْلُوٍ","فِي جانِبَيْهِ جَنَّةٌ ونَعيمُ",42,"م",1,0],["أريتَ عِياناً مجدَهم وهُمُ لنا","أحاديثُ مظنونٌ بها ونُقُولُ",43,"ل",1,0],["أرى تاج الملوكِ وزير فضلٍ","واِحسانٍ يليقُ به البَقاءُ",44,"ا",2,0],["أرى تاجَ الملوكِ ظِلالَ ضاحٍ","وقد سَفَعَ الوديقةُ والقِفارُ",45,"ر",1,0],["أريتني النجم يجري بالنهار فلا","فرقاً أرى بين إصباحي وإمسائي",46,"ي",1,1],["أريت كفاية المصري لمّا","جلائلك العظيمة لحن غرا",47,"ر",2,0],["أَرى تِلكَ الدِّيارَ وساكِنيها","طُلُولاً وُطِّنَت فيها العَوافِي",48,"ف",2,0],["أَرَيتَكِ إِنَّ مَرَّت عَلَيكِ جَنازَتي","تُلِحُّ بِها أَيدٍ طِوالٌ وَتَرجِعُ",49,"ع",1,1],["اريت ان لم يحب حبو المعتبك","انت باذن اللَه ان لم يترك",50,"ك",1,0],["أُريتُ منامًا في لياليَ أربعٍ","فزادت هُمومي ضعفَ أضعاف مابيا",51,"ي",2,0],["أريتنيَ الأجيال في الأرض كلها","ضروباً وما فارقت في الريف داريا",52,"ي",2,0],["أريتُ كأنّي مالكٌ لقيادِها","أوسِّدها كفي وأفرشها صدري",53,"ر",2,0],["أريت بها أخا الإعدام بذلا","وجودا ليس يوجد في الوجودِ",54,"د",1,0],["أَريتهمُ الحمام فكم حمام","لخوفك قد رأوا قبل الحمامِ",55,"م",1,0],["أَريت بَياض الصبح في فاحِم الدُّجى","وَأَطلَعت بَدر التم في القضب الملد",56,"د",1,0],["أريتنا في الودّ معنى الجفا","وجئتنا بالحرب تحت السلام",57,"م",1,0],["أَريتُه الكَأس بَعد بَهجَتِها","مَسلوبَةً فَاِستَوى وَلَم يَكَد",58,"د",1,0],["أريتها يومَها من قبلُ حين سرت","بمشبع الطير في أعوامها الغبرِ",59,"ر",1,0],["أرَيْتَكَ من تحنو عليه وغنه","لكالغيثِ أو أنّي لَكالْبَلَدِ المحل",60,"ل",1,0],["أرى تحت الرماد وميض جمر","ويوشك أن يكون له ضرام",61,"م",1,1],["أريتني اليوم كيف أوري","وكنت أصلدت في اقتداحي",62,"ح",2,0],["أَرَيتُكُمُ لَو جَرَّ مَن قَد ذَكَرتُهُ","عَلَيكُمُ يَسوقُ الفَيلَقَ الجَمَّ فَيلَقُ",63,"ق",1,0],["أرى تشاطير نظم شعري","تزهو بأبياته الحصينة",64,"ن",2,1],["أريتهم قبل ألفٍ كلَّ بارقة","واليوم عدت إليهم تنظر الأثرا",65,"ر",2,0],["أرى تأميمه حلا ولكن","أبوا سكناهمو إلا فرادى",66,"د",2,0],["أرى تصحيحه أمراً جليا","وليس يحسه الا الفحول",67,"ل",1,0],["أريتم بدرنا صخراً وطوداً","وودياناً ولا عشباً وماء",68,"ا",2,0],["أريتك ان ردَّت قناعيس جلة","دعها أهلها من بطن كتمان مشرب",69,"ب",1,1],["أَريتَهُم نيلاً حَكى النيل مزبدا","وَبِالوَجه بَدراً أَخجَل البَدر مُذ بَدا",70,"د",2,0],["أرى تفضيل ذات القشر عمداً","على السوداء من عدم الصواب",71,"ب",1,1],["أريتنا المبدأ الشعبي نقصده","ونجرع الماء من ينبوعه شبما",72,"م",2,0],["أريتك إياها وأنت لها ترى","وأوليتك المهموم كي أكفَه هَمّا",73,"م",2,0],["أريتُ الناس شمساً لا هلالا","خصائص ذي جمال زد جلالا",74,"ل",2,1],["أرى ترف الصبا كالشيب عندي","إذا كان الجميع إلى نفاد",75,"د",1,0],["أريتهم من خيال السحر كاذبه","وعن حقيقة ما نسعى إليه عموا",76,"م",3,0],["أريتني الشهب ظهرا","فأتعس الله جدك",77,"ك",1,0],["أريتكها يا قلب لو كنت مسليا","لك الماء والخضراء عما تكتم",78,"م",1,0],["أريتنا النقص في رأي الأولى وضعوا","كرمان من خولٍ عنها ومن فشل",79,"ل",1,0],["أريتُكِ مِن هوايَ إليكِ قلباً","شَغُوفاً، مِن هواكِ ألا أريني",80,"ن",2,0],["اريتَه كلَّ ما بِي مِنْ مُعاندة ٍ","حتّى تيقّن إنّي الفارس النَّجَدُ",81,"د",1,0],["أريت القوم كيف الحق يلعو","وكيف نهاية الباغي تكون",82,"ن",1,0],["أريتنا أنجما في الروض طالعة","أبهى بأعيننا من أنجم الأفق",83,"ق",1,0],["أريتَ يومًا في البلادِ مصانعًا","والنفطُ يجري تحتَنا كالماءِ",84,"ا",2,0],["أريت أخاها النجمَ ليلةَ نظمها","أشفّ بيوتاً من كواكبها الزهرِ",85,"ر",1,0],["أريت لو ان الهول صُور منظراً","تجلله الأخطار جد غوامر ؟",86,"ر",1,0]]}