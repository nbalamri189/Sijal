{"poems":[[55,"يعلم الجد أنني لا أضام","https://www.aldiwan.net/poem29776.html","الخفيف"],[95,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[93,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[87,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[99,"يا حنانا كيد الآسي الرؤوم","https://www.aldiwan.net/poem24775.html","الرمل"],[89,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[89,"دع حبيب القلب يا سقم","https://www.aldiwan.net/poem8281.html","المديد"],[33,"ولقد قلت إذ تطاول هجري","https://www.aldiwan.net/poem42565.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85757","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85746","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[53,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[164,"اسكنوها بسلام آمنينا","https://www.aldiwan.net/poem58828.html","الطويل"],[193,"يا نسيماً سرى إلى قاسيونا","https://www.aldiwan.net/poem34874.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[371,"رفعت للسماح راية مجد","https://www.aldiwan.net/poem17157.html","الخفيف"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[449,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[500,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[505,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[534,"رب قد عودتني كشف كل المعضلات","https://www.aldiwan.net/poem37494.html","الرمل"],[543,"رب قد أعطيتناه","https://www.aldiwan.net/poem48309.html","عموديه"],[591,"رب قاض لنا مليح","https://www.aldiwan.net/poem17509.html","مخلع البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97039","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70655","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129536","الخفيف"],[977,"","https://poetry.dctabudhabi.ae/diwan/poem/124597","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64551","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128712","المديد"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95157","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123649","الرمل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99080","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93909","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93913","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100211","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201997","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100740","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88924","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74051","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138674",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138529",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109940","الخفيف"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199154","السريع"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32893","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135751","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135916","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103035","الخفيف"],[5111,"قُرْبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212513",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5376,"أشرقَ الصبحُ بوجهٍ مُنْعِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=193740",""],[5431,"ليس حبا من كان رهن انتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=196612",""],[5691,"فتنَةُ كربُلاء...!","https://www.poetsgate.com/ViewPoem.aspx?id=206635",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""]],"verses":[["رُبَّ قَولٍ نُمِي إِلَيَّ وَعَزمي","غافِلٌ وَالهُمومُ عَنّي نِيامُ",0,"م",1,0],["رُبَّ قَوْلٍ يُصَاغُ مِنْ ذَوْبِ قَلْبٍ","صَهَرَتْهُ حَرَارَةُ الإِيمانِ",1,"ن",1,0],["رُبَّ قَوْم رأوْكَ رِيعُوا فقالوا","هل تكونُ العيون في الأقفاءِ",2,"ا",2,0],["رُبَّ قصْرٍ هناك قدْ دخلوه","كان من قبلِ ذاك صَعْبَ المرام",3,"م",1,0],["رُبَّ قوم باتوا بأجمعِ شَمْلٍ","تركوا شملَهُمْ بغير نظام",3,"م",1,0],["رُبَّ قُبحٍ عِندَ زَيدٍ هُوَ حُسنٌ عِندَ بَكرِ","فَهُما ضِدّانِ فيه وَهو وَهمٌعِندَ عَمرِ",4,"ر",1,0],["رُبَّ قَبرٍ نَمشي عَلَيه وَفيهِ","شَهَواتٌ تُربي عَلى ذَراتِه",5,"ت",2,0],["رب قبر به صدى الحياة لي","يروى من وابل غيداق",6,"ق",1,0],["رب قبر عليه اطلقت دمعي","بعد ان طال للمدامع حبسي",7,"س",2,0],["رُبَّ قَلبٍ أَصارَهُ الخُلقُ ضِرغا","ماً وَصَدرٍ أَصارَهُ الحَقُّ غيلا",8,"ل",2,0],["رُبَّ قول كنتُ قد أعددتُه","لكَ إذ ألقاك يأبى أن يطيعَا",9,"ع",2,0],["رُبَّ قَوْلٍ يَرُدُّ لَهْفَةَ قَلْبٍ","وَكَلامٍ تَجِفُّ مِنْهُ الْكِلامُ",10,"م",1,0],["رَبِّ قَنِّعْهُمْ بِفِرْيَتِهِمْ","وَانْتَصِفْ مِنْهُمْ بِمَا زَعَمُوا",11,"م",3,0],["رَبِّ قَد شَفَّني وَأَوهَنَ عَظمي","وَبَراني وَزادَني فَوقَ جَهدي",12,"د",2,0],["رب قانون أَهلُه وضعوه","كدواء فازداد منه الداء",13,"ا",2,0],["رب قَلبين معاً","للقاء خفقا",14,"ق",2,1],["رب قوم من العدالة محرو","مين فازوا بها بحد الحسام",15,"م",1,0],["رب قومٍ عاشوا بأمن زَماناً","ثم دارَت عليهم الدائرات",16,"ت",1,0],["رب قديم كشعاع الشمس","ابن غدٍ واليوم وابن أمس",17,"س",1,0],["رُبَّ قَوْلٍ يُخَافَتُ الصَّوْتُ فيهِ","وَاقِعٌ فَوْقَ مَوْقِعِ الإِرْغَادِ",18,"د",1,0],["رُبَّ قَصْرٍ قَدْ كانَ مَلْعَبَ أُنْسٍ","صَيَّرَتْهُ الأَيَّامُ رَبْعاً مُحِيلاَ",19,"ل",2,0],["ربّ ! قلبي زيّنته لحميّاك","فمر تنسكب بقلبي الشمول",20,"ل",1,0],["ربّ قومٍ رأوك ريعوا فقالوا","نَّ وإلاَّ فأنت كالبُعَداء",21,"ا",2,0],["رب قولٍ لو كان في الصم بضت","لم يؤثر في أنفس اللؤماء",22,"ا",2,0],["رب قرب أضى إلى بضرا","ء وبعيدٍ أفضى إلى السراء",22,"ا",2,0],["ربِّ قد أتيتهُ الملك ولم","تجعل الغير له فيه معينا",23,"ن",2,0],["رُبّ قَومٍ لم يَعرفوهُ فَعاشوا","عَن سَنا فضلهِ المُنيرِ عمينا",24,"ن",2,0],["ربَّ قوتٍ لا يُشبعَ الرهطَ منه","كانَ للألفِ والألوف اِكتفاءُ",25,"ا",2,0],["ربقُ الموتِ ما تراخَت أواخ","قد أحاطت من الورى بالرقابِ",26,"ب",1,0],["رُبَّ قَومٍ إِذا دَعَو فَأُجيبوا","قَد عَلَتهُم فَاِستَسفَلَتهُم كَآبَه",27,"ب",2,0],["رُبَّ قومٍ تَغَيَّروا","وَأَمِنّا تَغَيُّره",28,"ر",2,0],["رب قصر قد كان مرتع ظلم","لأناس على هواها تسوس",29,"س",1,0],["رب قطع يتح الوص","ل ووصل هاج قطعا",30,"ع",2,0],["رُبَّ قلبٍ كالسَّيفِ يفعلُ فِعلاً","عجزَتْ عن أَفعالِهِ البُلَغاءُ",31,"ا",2,0],["رَبِّ قَدْ عَوَّدْتَني كَشْفَ كُلِّ الْمُعْضِلاتِ","فَأدِمْ لي ذاكَ يا رَبِّ إلى حِينِ وَفاتي",32,"ي",1,1],["رَبّ قد أعطَيتنَاهُ","وهوَ من شرِّ عَطاءِ",33,"ا",2,1],["رُبَّ قَاضٍ لَنَا مَلِيحٍ","يُعْرِبُ عَنْ مَنْطِقٍ لَذِيذِ",34,"ذ",1,1],["رب قومٍ تغبقوا بابنة الكر","م ما عدا مسكر لنا في الريق",35,"ق",1,0],["رَبٌّ قويٌّ قديرٌ لا شريك له","مُجْرِى الرياحِ ومجرى الفلْك في اللُّجَجِ",36,"ج",1,0],["رب قشر محضته عن لباب","ولحوم عرفتها عن عظام",37,"م",1,0],["ربّ قلب قد كان للشر مأوى","صار مأوى الخيرات والبركات",38,"ت",1,0],["رب قهر الرجال أشكو فيا قا","هر هب لي قهراً يذل مذلي",39,"ل",2,0],["رب قوم غرهم سفها","شرَهٌ أدى إلى تخم",40,"م",1,0],["ربّ قاصٍ تدنيه من بَعد بُعدٍ","عكس دانٍ تقصيه من بعد قرب",41,"ب",1,0],["ربَّ قفر حليف فقر سرى يطل","ب رفداً ففاته المطلوبُ",42,"ب",1,0],["رُبَّ قاضٍ لَهُ جَمالٌ بَديعٌ","راحَ حكماً عَلَيَّ للمُتَقَاضِ",43,"ض",1,1],["رُبَّ قَومٍ يُرَوِّجونَ لِمَحمو","دٍ لِيُسقَوا مِن حَوضِهِ المَورودِ",44,"د",1,0],["رب قربنا إلى أوطاننا","فلنار البعد في الاحشا وهج",45,"ج",1,0],["رب قد أبليتني من","ه بمعتوه مصاب",46,"ب",1,0],["رب قوم في غرور","ظهروا أعلى المظاهر",47,"ر",1,0],["رب قاض بالجور قد صار خصماً","شأنه العدل عن عدول الشهود",48,"د",1,0],["رب قلبٍ أمسى يقلبه الوجد","ودمع كما انتزحت قليبا",49,"ب",2,0],["رب قريضٍ جاءني سائغاً","لو تَرُخصُ الأنفس لا يرخصُ",50,"ص",1,1],["رب قول أحد من حد عضب","يضع الحرب عنده الاوزارا",51,"ر",2,0],["رب قول أصاب فيه ومنه","حجة الخصم تنتهي في الجواب",52,"ب",1,0],["ربّ قَومٍ جاروا عليك مَع الده","ر وَجَرّوا الخطوب وَالأَهوالا",53,"ل",2,0],["رب قرب مسافة الوصل حتى","لا ارى غربةً عقيب اقتراب",54,"ب",1,0],["رب قرب وقت الظهور فقد طا","ل علينا انتظار وقت الظهور",55,"ر",1,0],["رُبَّ قومٍ يستهزئُونَ بشُكرٍ","عندما شُكرُ ربِّهم يُتَجدَّد",56,"د",1,0],["رب قصير في الورى لحية","طوّلها الله بلا فائده",57,"ه",1,1],["رُبَّ قَومٍ دَرَوا وَلكِن دَعاهُم","مَطمَعُ النَّفسِ هِزَّةً لِلمَعالي",58,"ل",2,0],["رب قَدِّ إذا تمايل عُجباً","هجرت غصنَها به الورقاء",59,"ا",2,0],["رَبِّ قَد ضاقَتِ النُفو","سُ وَقَد قَلَّتِ الحِيَل",60,"ل",1,1],["رُبَّ قُربٍ أوجَبَ البُعدَ وَرُ","بَّ دَلالٍ شانَ بالذنبِ أناسَه",61,"س",2,0],["ربِّ قِنا بالفضل شرَّ المضجعِ","ووالِنا لقاءَ حسنِ المرجعِ",62,"ع",1,0],["ربِّ قِنا من ظلم ظالمينا","وشرِّ ناسين وعالمينا",62,"ن",2,0],["ربِّ قِني والمنتصر من البلاءْ","وكلِّ ظالمٍ وجدبٍ وغلاءْ",63,"ا",2,0],["ربِّ قِنا من الشرور في الدهورْ","وأهلها وباطلٍ ومن غرورْ",63,"ر",1,0],["ربِّ قنا من غارةٍ وسارقِ","وغاصبٍ وشرِّ كلِّ طارقِ",63,"ق",1,0],["رب قوم هم بالأيادي كرام","ولذا الطارق الملمّ شحاح",64,"ح",1,0],["رُبَّ قُرْبٍ قَدْ تَنَامَى","وَتَهَامَى بِالأغَانِيْ",65,"ن",2,0],["رُبَّ قَوْلِي فِي حُضُورٍ","يَزْدَهِي بِالْوَرْدِ نَثْرَا",66,"ر",2,0],["رُبَّ قَوْلٍ مِنْ فَتًى خَلَّدَهُ","صَارَ كَالنَّجْمِ ضِيَاءً فِي الْعَنَانِ",67,"ن",1,0],["رُبّ قلبٍ عندَ شفْعِ المصطفى","عاشَ خُلْداً في نعيمٍ ملهما",68,"م",2,0],["ربّ قلبٍ من طينة الخلصاء","عاليا كالقصيدة العصماء",69,"ا",2,1],["رُبَّ قوْلٍ قدْ طالَ عائِشَةَ الخَيْرِ","بسوءٍ لهُ الجَوانِحُ تدْمى",70,"م",2,0],["رُبَّ قوْلٍ يهْوي بصاحِبِهِ في","النّارِ سبْعينَ حِجَّةً لا يوْما",70,"م",2,0],["رب قوم غرهم آمالهم","إنما الآمال للأحرار ذبح",71,"ح",1,0]]}