{"poems":[[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[24,"بان الشباب وأمسى الشيب قد أزفا","https://www.aldiwan.net/poem21869.html","البسيط"],[24,"نفى أهل الحبلق يوم وج","https://www.aldiwan.net/poem21871.html","الوافر"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[29,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[40,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[18,"تنجد حلفا آمنا فأمنته","https://www.aldiwan.net/poem23961.html","الطويل"],[82,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[21,"لك الحمد والمن رب العباد","https://www.aldiwan.net/poem36163.html","المتقارب"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1613","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54852","الرمل"],[18,"تَنَجَّدَ حِلْفاً آمِناً فَأُمِنْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26434&r=&rc=0",""],[119,"ان يذكر الحسب الكريم مسلسلا","https://www.aldiwan.net/poem41209.html","عموديه"],[135,"هل مثل قلبك في الأهواء معذور","https://www.aldiwan.net/poem24018.html","البسيط"],[197,"جفون قد تملكها السهاد","https://www.aldiwan.net/poem13020.html","الوافر"],[251,"تنجو إذا قيل لها يعاط","https://www.aldiwan.net/poem56324.html","الرجز"],[264,"في دياجي الحروف من كلماتك","https://www.aldiwan.net/poem35950.html","الخفيف"],[266,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[280,"ما بسيط الحياة إلا وجيز","https://www.aldiwan.net/poem25401.html","الخفيف"],[347,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[350,"أمن الجميع بذي البقاع ربوع","https://www.aldiwan.net/poem4472.html","الكامل"],[376,"أنام وما لائمي","https://www.aldiwan.net/poem57105.html","مجزوء المتقارب"],[382,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[415,"قل للخطوب إليك عني إن لي","https://www.aldiwan.net/poem32165.html","الكامل"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[422,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[422,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[463,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[463,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[466,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[466,"حزت المكارم والعلى","https://www.aldiwan.net/poem16153.html","مجزوء الكامل"],[505,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[558,"قطعت قتول قرينة الحبل","https://www.aldiwan.net/poem68394.html","الكامل"],[580,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198600","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108712","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48234","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93896","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205853","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204589","الرجز"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128390","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110047","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110093","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85205","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102750","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133132","البسيط"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[592,"تبكي على رسم دارٍ دارس بال","https://www.poetsgate.com/ViewPoem.aspx?id=128863",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5573,"دربي طويل وسكتي مالها زي","https://www.poetsgate.com/ViewPoem.aspx?id=201932",""],[5956,"كُلّنا نحيا بأعجوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184156",""]],"verses":[["تَنجو بِها عُنُقٌ كِنازٌ لَحمُها","حَفَزَت فَقاراً لاحِقاً بِفَقارِ",0,"ر",1,0],["تَنجو وَتَقطُر ذِفراها عَلى عُنُقٍ","كَالجِذعِ شَذَّب عَنهُ عاذِقٌ سَعَفا",1,"ف",2,0],["تَنجو نَجاءَ قَطاةِ الجَوِّ أَفزَعَها","بِذي العِضاهِ أَحَسَّت بازِياً طَرَقا",2,"ق",2,0],["تَنجو إِذا جَعَلَت تَدمى أَخِشَّتُها","وَاِعتَمَّ بِالزَبدِ الجَعدِ الخَراطيمُ",3,"م",1,0],["تَنجو إِذا عَلَمُ الفَلاةِ رَأَيتَهُ","في الآلِ يَقصُرُ مَرَّةً وَيَطولُ",4,"ل",1,0],["تَنجو نَجاءَ ظَليمِ الجَوِّ أَفزَعَهُ","ريحُ الشَمالِ وَشَفّانٌ لَها دِرَرُ",5,"ر",1,0],["تَنْجَلِي أنْجُماً وتعْلو بدوراً","في نظامٍ مُتَابَعٍ مَسْرُودِ",6,"د",1,0],["تَنجابُ عنه الغمَراتُ أمْلسا","يَخاله القِرنُ إذا تَشَرَّسا",7,"س",2,0],["تَنجو نَجاءَ أَتانِ الوَحشِ إِذ ذَبَلَت","وَمَسَّ أَخفافَهُنَّ النَصُّ وَالوَقَعُ",8,"ع",1,0],["تَنجو بِهِنَّ مِنَ الكُدرِيِّ جانِيَةٌ","بِالرَوضِ رَوضِ عَماياتٍ لَها وَلَدُ",9,"د",1,0],["تَنجَلي وَلي خُلُقٌ","يَنجَلي وَيَنسَكِبُ",10,"ب",1,0],["تَنجو كَذَلِكَ أَو نَجاءَ فَريدَةٍ","ظَلَّت تَتَبَّعُ مَرتَعاً بِالفَرقَدِ",11,"د",1,0],["تَنَجَّدَ حِلفاً آمِناً فَأُمِنتُهُ","وَإِنَّ جَديدراً أَن يَكونَ وَيَكذِبا",12,"ب",2,1],["تنجو أمَامَ القدح وَخْدَ نجيبةَ","فكأنّه فحلٌ عليها جرجرا",13,"ر",2,0],["تَنجو المَمالِكُ ما نَجا اِستِقلالُها","فَإِذا اِضمَحَلَّ أَعارَها اِضمِحلالا",14,"ل",2,0],["تُنَجَّونَ مِن ظُلُماتِ العَذاب","وَمِن حَرِّ نارٍ عَلى مَن ظَلَم",15,"م",1,0],["تَنَجَّبَكَ الخَليفَةُ غَيرَ شَكٍّ","فَساسَ الأَمرَ مُنتَجَبٌ نَجيبُ",16,"ب",1,0],["تَنْجَلِي فِيهِمْ عَرُوسٌ مَلَكٌ","تَحْجُبُ العِفَّةُ عَنْهَا النَّظَرَا",17,"ر",2,0],["تَنَجَّدَ حِلْفاً آمِناً فَأُمِنْتُهُ","وإِنَّ جَدِيراً أَنْ يَكُونَ وَيَكْذِبا",18,"ب",2,1],["تنجر ترفل حين تنظم قومهم","وبها عقود الدر سلسلة الذهب",19,"ب",1,0],["تَنجو سَوابِقُها مِن ساطِعِ كَدِرٍ","كَما تَجَلَّلَتِ الوَعثَ اليَعافيرُ",20,"ر",1,0],["تنجزّنا مِنَ الأَحداثِ عَهداً","أَكيداً لا يُزاغُ وَلا يكادُ",21,"د",1,0],["تنجو إذا قيل لها يَعاطِ","تنجو بهم من خلل الأمشاط",22,"ط",1,1],["تنجلي ظلمة الطبيعة عمّا","في دياجي الحروف من كلماتك",23,"ك",1,0],["تنجلي اللأواء من ارائه","كتجلي الليل عن ضوء الصباح",24,"ح",1,0],["تنجز الوعد في السفاه ولكن","موعد الرشد ما له تنجيز",25,"ز",1,0],["تنجلي للعيون في ألف لون","فهي سر ملقى عليه وشاح",26,"ح",1,0],["تَنجو إِذا نَجِدَت وَعارَضَ أَوبَها","سِلَقٌ أَلحَنَ مِنَ النِياطِ خَضوعُ",27,"ع",1,0],["تنجَّزَ شِبلٌ بها","دُيوناً بِلا حاكِمِ",28,"م",1,0],["تنج من داء الجُناب","والأذى والغضب",29,"ب",1,0],["تنجابُ عنه الحادثاتُ إذا عَرتْ","عن قُلَّبٍ ثبْتِ العزائِمِ حُوَّلِ",30,"ل",1,0],["تَنجو إِذا رُفِعَ القَطيعُ كَما نَجَت","خَرجاءُ بادَرَتِ الظَلامَ رِئالَها",31,"ل",3,0],["تنجلي أكؤس من الرَّاح فيها","يضحك الرَّوض من بكاء الغمام",32,"م",1,0],["تنجلي فيهم الكروب إذا ما","لُحْنَ غُبراً أنّى يَلُحْنَ وَقُتْما",33,"م",2,0],["تنجزني فيك المنى وعدها","إذا اقتضى أبناؤها ماطلا",34,"ل",2,0],["تنجَّزتُ أقصَى جودهِ وهو كارهٌ","ولم يك للمولَى عليّ خِيارُ",35,"ر",1,0],["تنجاب أستار الحجاب إذا انْتدى","للحيَّ عن مُتواضعٍ مُتوفرٍ",36,"ر",1,0],["تُنْجي الفَقيرَ منْ الخَصاصَةِ","والطَّريدَ مِنَ المَهالِكْ",37,"ك",1,0],["تَنْجَلي الأنْوارُ في مَطْلَعِها","فَلِذاً طَمْسٌ وهذا شارقُ",38,"ق",1,0],["تَنجو بِجَنَّةِ أَولَقٍ وَخُطىً","عَجَلَ الصِبا وَدِلالَةَ الهِقلِ",39,"ل",1,0],["تُنْجِي سفينةُ جُودِه","مَعْ أَنَّه طوفانُ نُوح",40,"ح",1,0],["تنجزُ الأمرَ تقهرُ الصَّعبَ قهراً","ولقد كانَ قبلُ كالأحلامِ",41,"م",1,0],["تَنْجُو إِذَا الهادِي دَعَا بِالهَبْلِ","وَغارَ أَرْدافُ النُجُومِ العُزْلِ",42,"ل",1,0],["تَنْجُو إِذَا السَيْرُ اسْتَمَرَّ وَذَمُهْ","وَكُلُّ نَأَّاجٍ عُرَاضٍ جَعْشَمُهْ",43,"م",2,0],["تنجلي في الظلام فيها الزواني","وتنام اللصوص فيها نهارا",44,"ر",2,0],["تنجابُ عن قلبي الهمومُ ولم تَزَلْ","عنِّي تزودُ الفاقةَ الآلاءُ",45,"ا",2,0],["تنجلي محكمات آي سناها","حيث تتلى كأنها الإنجيل",46,"ل",1,0],["تنجلى منه مصر باسقة النخ","ل ويبدو المقطم الأرجوانى",47,"ن",2,0],["تنجو بها الى النهار تارة","وتارة تغرق في بحر الغسق",48,"ق",1,0],["تنجاب من آسيا الصغرى طلائعهم","فاضت كسيل على الأعداء منسرب",49,"ب",1,0],["تنجابُ في حُلَل الفَخارِ بكُم كما","جُرَّت لها بأُولي الوَقارِ ذُيولُ",50,"ل",1,0],["تنجابُ في يلمق التعريض من حَلَبٍ","زَهَت وباهت خلنج الهِند واليَمَنِ",51,"ن",1,0],["تنجلي فيها غواني غصون","تتحلى بلؤلؤ الأكمام",52,"م",1,0],["تَنَجَّسَتْ بِدَمِ القَتْلَى صَوارِمُهُ","وَطُهِّرَتْ بِيَدِ التَّقْوى مآزِرُهُ",53,"ر",2,0],["تنجج الماء يجري من أصابعه","حتى ارتوى الجيش في عل وفي نهل",54,"ل",1,0],["تنج سريعاً وتسل عن عنا فتن","وعن ونا تعب الدنيا وفتاش",55,"ش",1,0],["تنجلي من ضيائه ظلمُ الغمّ","وتهمي به الخطوبِ الشدادُ",56,"د",1,0],["تنجو من النيران من لاذت بها","حباً ومَن لَم..سوف تأتي هالعة",57,"ع",2,0],["تنجو براكبها في كل هاجرة","قد خب منها وقود لامع الآل",58,"ل",1,0],["تنجاب قسطلة الوغى عن ليلها","بسنا زهير أم بضوء هلال",59,"ل",1,0],["تنجد غريق امن الغرق مدت ايدي","وملجا الدخيل الي يخاف الضواري",60,"ر",2,0],["تنجو بآلاف العجائب دائما","سبحان من يحمي ويرعى أمنكا",61,"ك",2,0]]}