{"poems":[[49,"دع العبرات تنهمر انهمارا","https://www.aldiwan.net/poem25286.html","الوافر"],[53,"أخا ثقتي أعزز علي بنوبة","https://www.aldiwan.net/poem62852.html","الطويل"],[68,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[280,"آب بدرا وقد ألم هلالا","https://www.aldiwan.net/poem25533.html","الخفيف"],[463,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216441",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137698",""],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145040","الوافر"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130611","الطويل"],[4791,"عظيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=28424",""],[5122,"(( عبّر ودروس ))","https://www.poetsgate.com/ViewPoem.aspx?id=28151",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[6100,"هياكل أوادم","https://www.poetsgate.com/ViewPoem.aspx?id=52556",""]],"verses":[["أَبٌ بَرٌّ وَمَولىً وَاِبنُ عَمٍّ","وَمُستَنَدٌ إِذا ما الخَطبُ جارا",0,"ر",2,0],["أبٌ بعد أمٍ برَّة وأقاربٌ","مضوا سُرُجاً في ظلمة الليل تَزْهَر",1,"ر",1,0],["أَبٌ بِهِ تُرفَعُ عَن مَجدِكُم","قَواعِدُ البَيتِ وَأَركانُه",2,"ن",2,0],["آب بالشعر من مصابكَ يبكي","رزءَه فيك والرجاءَ المخيَّبْ",3,"ب",1,0],["آبَ بالخيبةِ من غايتهِ","وهو فوق الأرض ملعونُ المقامِ",4,"م",1,0],["آبَ بَدْراً وَقَدْ أَلَمَّ هِلالا","مَلِكٌ زيد للْكَمَالِ كَمَالا",5,"ل",2,1],["أبٌ بكُمُ بَرٌّ وأنتم مَعقَّةٌ","أخٌ لكُمُ دِنْياً وأنتم أباعِدُ",6,"د",1,0],["آببْكي يِلو انّ البُكا ينفَع الإنسان","بدمعٍ سفيحٍ يحْفِي الخدّ من جاريه",7,"ي",2,0],["أب ببنيه العزاز أصيب","فقام يرجي عزيز السما",8,"م",2,0],["أَببهرج زيفٍ تُناقِضُ عَسجداً","شَتان بَينَ غَياهِبٍ وَضِياء",9,"ا",2,0],["أب باسم (العراق) سما عريقا","وفي أفق (السواد) نما شهابا",10,"ب",2,0],["أببيٌ علي الندب والده الذي","له خضعت صيد الملوك الخضارم",11,"م",1,0],["أببتعد عنك قدر اليوم ما أمكني","ما هوب عيبٍ يعاف القلب مشهاته",12,"ت",2,0],["أببعد بعيداًُ لا يقولون لي بلوس","وأنا أهل البلاسه عادتي ماتقربها",13,"ب",3,0],["اببني حسب جهدي وعلمي وخبرتي","مكاتيب قول من مواري شاربه",14,"ب",2,0],["اببحر وخل اللي طواه الحنين وساح ...","يذّوب صدى صوته ترى الوقت ما آمداني",15,"ن",2,0]]}