{"poems":[[47,"دع العبرات تنهمر انهمارا","https://www.aldiwan.net/poem25286.html","الوافر"],[51,"أخا ثقتي أعزز علي بنوبة","https://www.aldiwan.net/poem62852.html","الطويل"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[275,"آب بدرا وقد ألم هلالا","https://www.aldiwan.net/poem25533.html","الخفيف"],[458,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"]],"verses":[["أَبٌ بَرٌّ وَمَولىً وَاِبنُ عَمٍّ","وَمُستَنَدٌ إِذا ما الخَطبُ جارا",0,"ر",2,0],["أبٌ بعد أمٍ برَّة وأقاربٌ","مضوا سُرُجاً في ظلمة الليل تَزْهَر",1,"ر",1,0],["أَبٌ بِهِ تُرفَعُ عَن مَجدِكُم","قَواعِدُ البَيتِ وَأَركانُه",2,"ن",2,0],["آب بالشعر من مصابكَ يبكي","رزءَه فيك والرجاءَ المخيَّبْ",3,"ب",1,0],["آبَ بالخيبةِ من غايتهِ","وهو فوق الأرض ملعونُ المقامِ",4,"م",1,0],["آبَ بَدْراً وَقَدْ أَلَمَّ هِلالا","مَلِكٌ زيد للْكَمَالِ كَمَالا",5,"ل",2,1],["أبٌ بكُمُ بَرٌّ وأنتم مَعقَّةٌ","أخٌ لكُمُ دِنْياً وأنتم أباعِدُ",6,"د",1,0]]}