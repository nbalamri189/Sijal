{"poems":[[95,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[60,"أجد الثياب إذا اكتسيت فإنها","https://www.aldiwan.net/poem30852.html","الكامل"],[99,"أحسد الشيب على رأسك","https://www.aldiwan.net/poem24404.html","مجزوء الرمل"],[82,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[227,"إن كنت حرمت الكلام","https://www.aldiwan.net/poem55449.html","مجزوء الكامل"],[385,"أسلموني لسهادي","https://www.aldiwan.net/poem48796.html","مجزوء الرمل"],[409,"قلب المتيم كل يذوده","https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[415,"ما يريد الشوق من قلب مغنى","https://www.aldiwan.net/poem32369.html","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108874","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128066","الكامل"],[2960,"","https://poetry.dctabudhabi.ae/diwan/poem/130355","الكامل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107279","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[4778,"عيناك بحرٌ بالحنان تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=188144",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5186,"مخرت تحمل خمرا، وجعه","https://www.poetsgate.com/ViewPoem.aspx?id=156525",""]],"verses":[["فرثى لذاك البيت طارف","عزه ورثى تلاده",0,"د",2,0],["فَرَثاثُ ثَوبِكَ لا يَزيدُكَ زُلفَةً","عِندَ الإِلَهِ وَأَنتَ عَبدٌ مُجرِمُ",1,"م",1,0],["فرثينا العمر بِش","راً وبكيناه ابتسامَا",2,"م",2,0],["فَرَثَتْ لِذِلَّتِهِ ورُبَّتَما","لانَ الصّفَا وَتَواضَعَ الكبرُ",3,"ر",1,0],["فرثيته من أَدمع أرخيتها","للحزن بالمَنظوم وَالمَنثور",4,"ر",1,0],["فرثى وأقسم أنه","سيعود موصول السقام",5,"م",1,0],["فَرَثى لي كُل مَن يَأ","لفني حَتّى سُهادي",6,"د",2,0],["فرثى وقال أرى الفتى","ما فيه من ألم يؤوده",7,"د",2,0],["فَرثَي من رَحْمَةٍ عاذلُهُ","ورأى الحاسِدُ فيه ما تَمنّى",8,"ن",2,0],["فَرَثى قَلبُه وَرَقَّ لِقَومٍ","أَمّلوا قُربه وَراموا اِجتباه",9,"ا",2,0],["فرثى وكفكف مدمعي ببنانه","من عادة الكافور إمساك الدم",10,"م",1,0],["فرثيته بقصدة فاقت علا","ولعل ذا من فيضه موفور",11,"ر",1,0],["فرثى له طرفي وقال أنا الذي","قد كنت في شراك الردى أوقعته",12,"ت",2,0],["فَرَثَت لِمُضناها وجادَت باللِّقا","مِن غيرِ مِيعادٍ ولم تَتَأَخَّرِ",13,"ر",1,0],["فرثى وانعم بالمزار تعطفا","لما رأى ذلي ودمعي القاني",14,"ن",2,0],["فرثيت حال العاشقين ووجدهم","والدمع يهمُل تارة ويغيضُ",15,"ض",1,0],["فَرَثَىْ لِحَاْلِيْ حِيْنَمَاْ أَبْلَغْتُهُ","شَوْقاً تَضَاْعَفَ، فَاسْتَرَاْحَº وَرَاْحَاْ",16,"ح",2,0],["فرثا الكل لما حل به","دون أن يذري عليه مدمعه",17,"ع",2,0]]}