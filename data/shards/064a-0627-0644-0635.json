{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[102,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[102,"لص في منزل شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50430",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56088","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109332","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202843","الخفيف"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138921",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66472","المديد"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44694","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83165","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66161","الخفيف"],[4869,"راس مال العلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=151627",""],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[5232,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=213660",""],[5353,"صدى صمتي","https://www.poetsgate.com/ViewPoem.aspx?id=212457",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[5950,"ياسيد الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=126263",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""]],"verses":[["يَا لَصَرِيعٍ بِيَدٍ خَالَهَا","مُقِيلَةً وَهْيَ يَدُ الصَّارِعِ",0,"ع",1,0],["يا لصوص العروش عيبوا \" جمالا \"","واخجلوا أنّكم قصرتم وطالا",1,"ل",2,0],["يا لصُّ عفواً , إن رجعتَ","بدون ربحٍ أو خسارة",2,"ر",2,0],["يا لصحبٍ في الحمى عاهدتهم","في البها والحسن أقمارٌ غررْ",3,"ر",1,0],["يا لصحبي ولم أقل يا لقومي","نام قومي فأستيقظوا يا لصحبي",4,"ب",2,0],["يا لصبٍّ نَالَ العَذُولُ مُنَاهُ","فيهِ سِلماً يا لَيتَهُ بِسِلاحِ",5,"ح",1,0],["يا لصبرٍ قد خُصَّ بالأنبياء","كيف راضوا الطباع ذاتَ الجفاء",6,"ا",2,1],["يا لصب لم يدر إلا حنينا","من شجاه تفطر الجلمود",7,"د",1,0],["يا لصبٍّ في محبّتكم","صبّ ماء العين كالمطرِ",8,"ر",1,0],["يا لصُّ إِن دُمت في أَمنٍ وَفي سعةٍ","فَاِرجع إَلَينا فَطول الهَجر يُفنينا",9,"ن",2,0],["يا لِصَدرٍ رَحبٍ تَجمَّع فيه","كُلُّ مَعنىً مِن السُموِّ اِستمدّا",10,"د",2,0],["يا لَصَبٍّ يَنْشَى وَلاَ خَمْرَ إِلاَّ","ما سَقاهُ ساقي الهَوى وسَقاها",11,"ا",3,0],["يالصاحب اللي بالمواقف سندناك","وراك تنّكر ماخذته الصداقه",12,"ق",2,1],["يَا لِصَيْفٍ حِيِنَ جِئْتَ اشْتَطَّ بَحْرٌ","عَسْجَدَ الشَّمْسَ انْعِكَاساً بِالقَبِيِلِ",13,"ل",1,0],["يا لِصوتٍ يا لفنٍّ آسر ٍ","تُنعشُ النفسَ أغانيك ِالعِذابْ",14,"ب",1,0],["يالصمتي كم أراني جازعاً","ويراني النَّاسُ بوحاً أجردا",15,"د",2,0],["يالصغار ... اللي يربيكم كبار","ما دريتوا انكم ليّه ... وليمه",16,"م",2,0],["يالصادق الكذّاب","يالكاره المحبوب",17,"ب",1,0],["يَا لَصَدْرَينَا عِنْدَمَا نَتَلاقَى","- فِي عِنَاقٍ - أَصْبَحَا بُركَانا",18,"ن",2,0]]}