{"poems":[[45,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[107,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[107,"أبا شادي وكنت لنا حليفا","https://www.aldiwan.net/poem43069.html","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21098","البسيط"],[45,"أوه بديل من قولتي واها","https://www.poetsgate.com/ViewPoem.aspx?id=173",""],[215,"أبا شادي وأنت فتى طروب","https://www.aldiwan.net/poem46335.html","الوافر"],[398,"أبا شجاع يا شجاع الورى","https://www.aldiwan.net/poem53455.html","السريع"],[466,"أبا شجاع كمال الدين دعوة ذي","https://www.aldiwan.net/poem15161.html","البسيط"],[520,"أبا شمس الخلافة وهو نعت","https://www.aldiwan.net/poem12006.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126781","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96027","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100309","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58311","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37503","الوافر"],[5595,"العظيم له احتراما","https://www.poetsgate.com/ViewPoem.aspx?id=144522",""],[5720,"بأرضِ الأحمريِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200096",""],[5956,"كل ما فيها مثيرُ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182656",""],[6093,"ذَارِيْ الرِّيْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=187943",""]],"verses":[["أَبا شُجاعٍ بِفارِسٍ عَضُدَ ال","دَولَةِ فَنّاخُسرو شَهَنشاها",0,"ا",3,0],["أبا شادي سكتَّ وكنتَ صوتاً","شديدَ القصفِ يخترقُ السَّحابا",1,"ب",2,0],["أَبا شادي وَكُنتَ لَنا حَليفاً","نُجَرِّدُ لِلجِهادِ شَديدَ بِأسِكْ",2,"ك",1,1],["أَبَا شُريحٍ فلا تَحزُنكَ عَشرَتُنا","فَالَمرءُ رَهنٌ لريبِ الدَّهرِ والُحمَمِ",3,"م",1,1],["أَبا شُجاعٍ بِفارِسٍ عَضُدَ الد","دَولَةِ فَنّاخُسرو شَهَنشاها",4,"ا",3,0],["أبا شادي وأنت فتىً طروبٌ","أسيرُ العينِ في قلبٍ طليق",5,"ق",1,1],["أَبا شجاعٍ يا شُجاعَ الوَرى","وَمَن غَدا في حُسنِهِ قِبلَه",6,"ه",1,1],["أبا شجاعٍ كمال الدين دعوةَ ذي","أُبيَّةٍ دونها الأرماحُ والقُضُبُ",7,"ب",1,1],["أبا شمس الخلافة وهو نعت","يصدقه جبينك بالضياء",8,"ا",2,1],["أبا شاكر زيّنت مَنصبكَ الّذي","تقلّدته إذ كُنت حقّا بهِ أحرى",9,"ر",2,1],["أبا شمر دعني والحبيب لعلني","أَبل غليلاً منه قبل التحمل",10,"ل",1,0],["أبا شبَّر واهاً شقيق شبيرها","أو حسن ثاوٍ بسبعة أشبار",11,"ر",1,0],["أبا شاكرٍ يا مَنْ عَلا كُلَّ رُتْبَةٍ","وفاتَ صعوداً رُتْبَةَ المدح والشكرِ",12,"ر",1,1],["أبا شبلينِ يَخلعُ وهو عارٍ","على الأقوامِ حُلّةَ أرجُوانِ",13,"ن",1,0],["أبا شَرفاً لدينِ اللّهِ أضحَى","له رِدْأً على صَرْفِ الدُّهور",14,"ر",1,0],["أبا شيماء دونك يا كريماً","ويا اسماً نطارحه السلاما",15,"م",2,0],["أبا شاميِّ . . ياشيخَ المعالي","ويا نسلَ الكرامِ السابقينا",16,"ن",2,0],["أباشرها عُلُوّاً ثم سُفلْاً","وحيث مشت فوجهي يستديرُ",17,"ر",1,0],["أَبَاشَرَفٍ لَكُمْ شَرَفٌ كَرِيْمٌ","أَرَاكَ بِجَالِهِ شَهْمَاً كَرِيْمَا *",18,"م",2,0]]}