7",""],[5409,"نعيك هز أرجاء البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=155455",""],[5725,"هنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206598",""],[5784,"جف الشعر في السطر الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=190846",""],[5861,"دع الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188293",""],[5910,"في الدفاع عن السُّنَّة النبوية الشريفة","https://www.poetsgate.com/ViewPoem.aspx?id=206238",""],[6142,"أبا حسنٍ عين الإله","https://www.poetsgate.com/ViewPoem.aspx?id=155736",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[5567,"بلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81757&r=&rc=19",""]],"verses":[["فمن بعد أشياخ تبايع نصه","تأول في الآي المبين ولائد",0,"د",1,0],["فمُنَّ بعُتْباكَ بعْدَ العِتابِ","فكُنْتُ أؤمِّلُ عنْكَ اصْطِبارا",1,"ر",2,0],["فمِنْ بَيانِ الحَقِّ زَهْرٌ نَدٍ","ومنْ لِسانِ الصّدْقِ طَيْرٌ صَدوحْ",2,"ح",1,0],["فَمَن بَنى مَدَراً مِن خَوفِ حادِثَةٍ","فَإِنَّ أَسيافَنا تُغني عَنِ المَدَرِ",3,"ر",1,0],["فمن بيت يمدّ به سماط","ومن وجه تضيء به ابتسامه",4,"ه",1,0],["فمن بؤساء الناس في يوم عيدهم","نحوسٌ بها وجه المسرّة أسفع",5,"ع",1,0],["فَمُنَّ بِالعَفوِ يا إِلَهي","فَلَيسَ أَرجو سِواكَ أَنتَ",6,"ت",1,0],["فمِنْ بَيْنِ عارٍ لم يَنَلْ من ثيابِها","ومُلتَحِفٍ منها بحُمْرِ المَلاحفِ",7,"ف",1,0],["فمن بَرَدٍ لم يَجلُ للشَّمسِ حاجباً","من الظلِّ إلا غازَلَتْه بحاجبِ",8,"ب",1,0],["فَمُنَّ بِأَرطالٍ عَلَيَّ حَبيبَةٍ","إِلَيَّ فَإِنّي أَعشَقُ المَنَّ بِالرَطلِ",9,"ل",1,0],["فَمُنَّ بِالإِذنِ عَلى نازِحٍ","عَن أَهلِهِ ساعَتُهُ دَهرُ",10,"ر",1,0],["فمن بَيْتَيْكُما حِرْزٌ وكَهْفُ","وعندكما ظِلالُ الأمن تضفو",11,"و",1,0],["فَمِن بَينِ مَسرورٍ وَباكٍ مِنَ الهَوى","وَقَد لاحَ مِن ثَوبِ الظَلامِ غُيوبُ",12,"ب",1,0],["فَمَن بَغى لَكَ سوءً","فَكانَ في مِثلِ حالِه",13,"ل",2,0],["فَمَن بِنَجوَتِهِ كَمَن بِمَحفِلِهِ","وَالمُستَكِنُّ كَمَن يَمشي بِقِرواحِ",14,"ح",1,0],["فمن بعتبك بعد العتاب","وكنت أؤمل عنك اصطبارا",15,"ر",2,0],["فمن بناها بخير طاب مسكنه","ومن بناها بشر خاب بانيها",16,"ي",3,0],["فمن به المولى وجاء مؤيدا","واصبح من خدامه الطبع والنشر",17,"ر",1,0],["فَمِن بَعدِ فَضلٍ في شَبابٍ وَقُوَّةٍ","وَرَأسٍ أَثيثٍ حالِكِ اللَونِ مُسوَدِّ",18,"د",1,0],["فمنَ بعدَهُ تبغين أن تزدهي بهِ","ويمسى به بين البلادِ لك الفخرُ",19,"ر",1,0],["فَمِن بَيانِكَ ماءُ الفَضلِ مُنهَمِرٌ","وَمِن بَنانِكَ ماءُ الجودِ مُنسَكِبُ",20,"ب",1,0],["فَمِن بَدَنٍ بلا روحٍ","ومن رُوحٍ بلا بَدَنِ",21,"ن",1,0],["فمن بحر من العلماء طام","ومن ليث من العظماء حامي",22,"م",2,0],["فَمن بَعده مَن لِلرِماحِ يُعِلُّها","وَيُنهِلُها مِن كُلِّ أَشوَسَ مِطعانِ",23,"ن",1,0],["فمَن بأحضانِ ذاكَ الروضِ شاهَدها","مُواسياً غيرُ أقراني وخلّاني",24,"ن",2,0],["فمن بأسه أضحتْ ديدرٌ بلا قعا","وتمسي ديارٌ بالمواهبِ تُحْرَثُ",25,"ث",1,0],["فمن بُسُطٍ مسكيَّة ونمارقٍ","خَلُوقيّةٍ حفّت بأَقْبِيةٍ خُضْر",26,"ر",1,0],["فمِن بُرعمٍ وسنانَ يُغمِضُ جَفنهُ","إِلى زَهرةٍ ريّا يُفتِّحُها النّدى",27,"د",2,0],["فَمِنْ بكراتٍ أدْبَرَتْ وأَصَائِلٍ","جَنَيْتُ بِها الإقْبَالَ في غُرَّةِ العُمْرِ",28,"ر",1,0],["فَمِنْ بدرٍ ضعْفِ النجوم اللوائِح","ومِنْ خِلَع مِلْء العُيونِ اللّوامِح",29,"ح",1,0],["فَمِن بَعدِهِ لا شُدَّ سَرجٌ لِسابِحٍ","وَلا ريعَ طرفٌ في الهِياجِ بِمِهمازِ",30,"ز",1,0],["فمن باذلٍ دمعَهُ مشفقٌ","ومن ذاهلٍ طرفُه يدمع",31,"ع",1,0],["فَمَن بائِعي عَيناً بِعَينٍ مَريضَةٍ","وَنَفساً بِنَفسٍ في وَثاقٍ طَليقُها",32,"ق",3,0],["فَمِن بَينِ باكٍ لَهُ موجعٍ","وَبَينَ مُعَزٍّ مُغِذٍّ إِلَيهِ",33,"ي",2,0],["فَمن بِالتَواني فاتَهُ لَذّة الهَنا","لعمري بِهِ بَين الوَرى لَيس يُعتدُّ",34,"د",1,0],["فَمِن بَحرك الطامي اِكتَسَبت جَواهِراً","وَها أَنا أهدي خَير ما أَنا كاسبُه",35,"ب",2,0],["فمن برّه برّ الخليفة بعده","فوفّوا بعهد اللّه غرا على اغرا",36,"ر",2,0],["فمَنْ بالأجارعِ من وَمْضِه","مَشوقٌ ومَن بالمَطالي مَجود",37,"د",1,0],["فمن بيت لحمٍ كان مطلع نوره","وناهيك من فَلْكٍ به اللَه جائل",38,"ل",1,0],["فَمِن بِهِ تَلهو إِذا قَتَلتَني","وَأكبدي مِمَن تَجافى بَعدي",39,"د",2,0],["فمن برِّهم نيلي مكارم برّهم","فأكرمْ به من نائلٍ ومنيل",40,"ل",1,0],["فمن بعده أنكرت عرفان عيشتي","ومن بعده غصني على جدّة يذوي",41,"و",2,0],["فمن بان منه فعل شر فعادِه","ومن بان منه الرشد والخير فاحبِبا",42,"ب",2,0],["فمن بدَّل الصوَّت الجميلَ وَمن ترَى","أَجازَ لصفوي أن يسيلِ بعبرتي",43,"ي",1,0],["فمن بها لو سمح الدهرُ بها","ودِينُه في مثلها أن يبخلا",44,"ل",2,0],["فمن بين خَرْكاءَ مضروبةٍ","على تَلعةٍ حَمَلتْها اغترارا",45,"ر",2,0],["فمن بات يدرك منك المنى","فأنّي أرومُ ولا أدرك",46,"ك",1,0],["فمن باللّه ينسب لاجترام","أجنبي إن بقت للحق قيمه",47,"م",2,0],["فمن بك مشتاقاً إلى نجح موعدٍ","فها أنا مشتاق إلى خلف الوعد",48,"د",1,0],["فَمَن بَقِي مِنكُمُ في هَذِهِ فَلَهُ","فَخرُ الحَياةِ وَإِن طالَت لَياليها",49,"ي",3,0],["فمنْ بغى عندِيَ البشاشة واللّه","وَ وبعض النّشاطِ ما وجدا",50,"د",2,0],["فمِن بيتِ إبراهيمَ أرَّختُ عاجِلاً","إلى حِضْنِ إبراهيمَ جَدَّ اُنتِقالُهُا",51,"ه",2,0],["فمن بالعفو عليهم وصفح","فيما حكي عنه وصح واتضح",52,"ح",1,0],["فَمنْ بِصَبِّ دَمْعِهِ","يَفيضُ وَجْداً صَبُّهُ",53,"ب",2,0],["فَمَن بَعدَهُ لِلعِلمِ تَنَشَّقَ حَجبَهُ","وَيُسلِسُ عاصيهِ وَيَسهُلُ واعِرُه",54,"ر",2,0],["فمن بدر علمي ليل جهلك مقمر","ومن شمس كشفي صبح ذوقك مسفر",55,"ر",1,0],["فمنْ بكاها فلا جفَّت مدامِعُه","لا أسخن اللهُ إلاّ عينَ باكيها",56,"ي",3,0],["فمن بين مسموم وبين مشرد","وبين قتيلٍ بالدماء مخلق",57,"ق",1,0],["فمن بات يشكو من فراقِك لوعةً","ورام اعتذاراً جاء والله بالعُذْر",58,"ر",1,0],["فمنبحث علم ينثر الدر مشرقاً","إلى بحث نقع ينثر الهام ادهما",59,"م",2,0],["فمن باب هذا إلى باب ذا","ترجى الأمير وتخشى الوزيرا",60,"ر",2,0],["فمن بين هاوٍ قد تكدَّر واختفى","وآخر خفّاقُ الفؤاد جريح",61,"ح",1,0],["فمِن باعٍ أناط به الثريا","ومِن قدم على الجوزا رماهُ",62,"ا",2,0],["فَمِن باسِقاتٍ راسِياتٍ ضَوَامِنٍ","لَنا الخِصبَ إِن ضَنَّ السَّحابُ بِمَا القَطرِ",63,"ر",1,0],["فَمِنْ بَانَةٍ سُقيَتْ بِأكْؤْسِ سَوْسَنٍ","وَمِنْ وَرْدَةٍ حَيَّتْ بِأكْمَامِ زَهْرَةِ",64,"ه",1,0],["فمن بعتقي كي أروي كبودهم","وأرجع للصياد رجعة طائع",65,"ع",1,0],["فَمِن بَينِ صُفرٍ وَحُمرٍ وَخُضرٍ","عَلى القُضبِ غيدٍ وَزورٍ وَصورِ",66,"ر",1,0],["فَمَنْ بعده يُبْغَى وَهلْ قط يشتفى","مكانَ زلال بالأجاجِ ظُمَاءُ",67,"ا",2,0],["فَمِن بيضِ يُمناهُ سال النُضار","عَلى أَبحُرٍ فَوقَ ظَهرانِيَه",68,"ي",2,0],["فَمِن بيضِ القِبابِ مُدَبَّجاتٌ","تَلوحُ بِها المَجَرَّةُ في سَماها",69,"ا",3,0],["فَمن بِكَ مثل والدها يَطنب","عَلَيها بِالصوارم وَالعَوالي",70,"ل",2,0],["فَمن بعد شدّاد يحمي الحريم","إِذا الحربُ قامَت وَسالَ العَرَق",71,"ق",1,0],["فمن بنا اطواره","على الهدى نال المدد",72,"د",1,0],["فمن بنبي اللَه يرجوا نجاته","من الله يولي في الفراديس مسكنا",73,"ن",2,0],["فمن بركةٍ فيحاءَ يدعج ماؤها","ومن جدولٍ ريانَ كالسهم يمرق",74,"ق",1,0],["فمن بين معقود يبين فرنده","علينا ومحلول عليهن ينثر",75,"ر",1,0],["فَمِن بَعد ما كُنَّا عَلى الوُّدِّ وَالوَفا","نبينُ الهوى للعاشِقينَ ونُلغِزُ",76,"ز",1,0],["فَمِن بَعدِ هَذَا القَولِ لَستُ بِجَانِحٍ","إِلَى مَكسَبٍ إِذ مَكسبِي هُوَ حَارِثُ",77,"ث",1,0],["فمن بين محزون ومن بين مغرم","ومن بين مشغوف به وكبيت",78,"ت",1,0],["فمن بعد روحينا زوت دوحة التقى","ومن بعد إبرهيم غُلَّت يدُ النسك",79,"ك",1,0],["فمن بعده يحمي الحمى غير جعفر","أخيه الذي من كأسه كان يشرب",80,"ب",1,0],["فمن به قرت لك العين مدى","أودى به الدهر لأمر قد قدر",81,"ر",1,0],["فَمِن باذل جهدِهِ كُله","وَيَغدو وَفي بُؤسِهِ قَد زَلَق",82,"ق",1,0],["فَمَن باتَ لَيلاً خالِعاً بَيعَةَ الَّذي","بِهِ لُمَّ شَعثُ المُسلِمينَ المُفَرَّقُ",83,"ق",1,0],["فمنّ بالعفو إني","منه على غير يأس",84,"س",1,0],["فَمن باقر العلم العُلوم لَك أَنتمت","مَواريث لَم يَسطع لَها أَحد جحدا",85,"د",2,0],["فمن بعدي ليطبي","ه في النظم وفي النثر",86,"ر",1,0],["فَمَن بِسِواكَ باعَكَ فَاِغنِ عَنهُ","كَما اِستَغنى عَلِيٌّ عَن عَقيلِ",87,"ل",1,0],["فمن بعد ما أثنى الإله بنفسه","عليه فما مدحي له وتعسفي",88,"ف",2,0],["فَمَن بِقَومٍ فاعلَمَن تَشَبّها","فَذاكَ مِنهُم فاعلَمن وانتَبِها",89,"ه",2,0],["فَمَنبِتُ المَجدِ وادي النيلِ قَد عَصَفَت","هوجُ النِضالِ بِهِ فَاِهتَزَّ في ضَجَرِ",90,"ر",1,0],["فمن بعدهُ يولي الطريف موفرا","ويتبعُ موفورَ الطريف بتالدِ",91,"د",1,0],["فمن بعده من ذا عليه ورودها","ويا طالما ساغت لديه الموارد",92,"د",1,0],["فمُنَّ به ضافي الجناح كأنه","