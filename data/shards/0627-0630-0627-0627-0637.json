{"poems":[[53,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[53,"وفى ذا السرور بتلك الكرب","https://www.aldiwan.net/poem30751.html","المتقارب"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[93,"وقفت على القبر الذي أنت نازله","https://www.aldiwan.net/poem11122.html","الطويل"],[88,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[27,"ألا حي أطلال الرسوم الدوارس","https://www.aldiwan.net/poem5792.html","الطويل"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[47,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[91,"إذا أطل البدر من خدره","https://www.aldiwan.net/poem62827.html","عموديه"],[45,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[28,"وليلة ليل قد رفعت سناءها","https://www.aldiwan.net/poem5000.html","الطويل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[80,"وآخذة في دورة فلكية","https://www.aldiwan.net/poem31555.html","الطويل"],[44,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[46,"تزوج إن أردت فتاة صدق","https://www.aldiwan.net/poem22690.html","الوافر"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39576","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16652","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[80,"وآخذة ٍ في دورة ٍ فلكيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=3003",""],[283,"ومفترة عن كالجمان المنظم","https://www.aldiwan.net/poem32422.html","الطويل"],[283,"ألي من جفون الغانيات مجير","https://www.aldiwan.net/poem32787.html","الطويل"],[299,"على الزعازع والأهوال والبأس","https://www.aldiwan.net/poem36834.html","البسيط"],[378,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[378,"إذا أطراك إنسان بمدحٍ","https://www.aldiwan.net/poem59212.html","الوافر"],[417,"بحكمك زال الظلم وابتسم العدل","https://www.aldiwan.net/poem53956.html","الطويل"],[453,"وبط من الوادي حللنا مقيلة","https://www.aldiwan.net/poem13630.html","الطويل"],[459,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[459,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[462,"وصاحب من بني الآمال خضت به","https://www.aldiwan.net/poem15303.html","البسيط"],[462,"اذا اطباها الناضر الحزني","https://www.aldiwan.net/poem15584.html","الرجز"],[465,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[552,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[554,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِذا اِطَّرَدَت أَكُفُّهُمُ بِجودٍ","أَسَرَّت ماءَها السُحُبُ الغِزارُ",0,"ر",1,0],["إِذا اِطَّرَدَت بِكَ خِلتَ القُصو","رَ تُرعَدُ بِالبُعدِ أَو تَحتَجِب",1,"ب",1,0],["إِذا أُطِرَ المَربوعُ مِنها تَرَنَّمَت","كَما أَرزَمَت بَكرٌ عَلى البَوِّ رائِمُ",2,"م",1,0],["إِذَا أَطْبَقَتْ سُحْبُ الحَوَادِثِ حَوْلَهُ","أَضَاءَتْ بِهَا أَخْلاقُهُ وَشَمَائِلُهْ",3,"ل",2,0],["إذا أطّردت حركات الحيا","ة ومرّت على نَسَق واحد",4,"د",1,0],["إِذا اِطَّرَدوا لَم يَخفَ داءُ ظُهورِهِم","عَلى ما بِنا مِن نَحضِها المُتَكاوِسِ",5,"س",1,0],["إِذا اِطمَأَنَّت قَليلاً بَعدَما حَفَرَت","لا تَطمَئِنُّ إِلى أَرطاتِها الحُفَرُ",6,"ر",1,0],["إِذا اِطمَأَنَّت وَأَينَ أَو هَدَأَت","عَنَّت لَها ذُكرَةٌ تُقَلقِلُها",7,"ل",3,0],["إذا أطال كريم وعده اختصرت","وإن طوى قلب باغ غلها شرحت",8,"ت",1,0],["إذا اطَّردت أنفاسُها في سَراته","تَسلسل عاري المتن جعد السلاسلِ",9,"ل",1,0],["إِذا أَطَلَّ البَدرُ مِن خِدرِهِ","فَإِنَّما يَطلَعُ كَي تَنظُريه",10,"ه",1,1],["إِذا أَطفَأَ الياقوتَ إِشراقُ حُسنِها","فَإِنَّ عَناءً ما تَوَخَّت عُقودُها",11,"د",3,0],["إِذا أُطعِمَت أُمَّ الهَشيمَةِ أَرزَمَت","كَما أَرزَمَت أُمُّ الحُوارِ المُجَلَّدِ",12,"د",1,0],["إذا أطفأ الدجنُ الكواكبَ أسرجوا","وجوهاً بها تُهْدَى المسالكَ ضُلّالُ",13,"ل",1,0],["إذا أُطْعِمَتْ حَبّاً من البُرّ أطْعمَتْ","وقامتْ بأمرِ البِرِّ فهي كما يجبْ",14,"ب",1,0],["إِذا أَطلَقوا عَنهُ جَوامِعَ غُلِّهِ","تَيَقَّنَ أَنَّ المَنَّ أَيضاً جَوامِعُ",15,"ع",1,0],["إِذا اِطَّلَعَ الأَوانِسُ لَم تَطَلَّع","إِلى عُرُسٍ تَمُرُّ وَلا أَميرِ",16,"ر",1,0],["إذا أطْلَقَتْ كفّاكَ عارِضَ عسْجدٍ","على سائِلٍ لم تَرْضَيا برِهامِهِ",17,"م",2,0],["إذا أطلت سكوتاً","فالروض ليس يطيب",18,"ب",1,0],["إذا أطلقَ الضوءُ أطيافَه","ولفَّ بها خصرَكِ الضامرا",19,"ر",2,0],["إذا أطَلّ على أبْياتِ بادِيَةٍ","قامَ الوَلائِدُ يَسْتَقْبِسْنَهُ الضّرَمَا",20,"م",2,0],["إذا أطّ نِسْعٌ قلتُ والدّوْمُ كارِبي","أجِدّكمُ لم تفْهَموا طَرَبَ النِّسْع",21,"ع",1,0],["إِذَا أَطْرَقُوا أَبْصَرْتَ بِالْقَوْمِ خِيفَةً","لإِطْرَاقِهِمْ أَوْ بَيَّنُوا رَكَدَ الْحَفْلُ",22,"ل",1,0],["إذا أطلقْته أصغى جَنُوبٌ","إليه، وأرهف الأُذنَ الشَّمَال",23,"ل",1,0],["إذا اطفأ الياقوت حسنها","فإن عناء ما توخت عقودها",24,"د",3,0],["إذا أطعمت حبّاً من الُبرّ أطعمت","وقامتْ بأمرِ البِرِّ فهو كما يجبْ",25,"ب",1,0],["إِذا أُطلِقَت غُرُّ المَدائِحِ في الوَرى","فَهُنَّ وَبَدرَ الدينِ كَاليَدِ لِلفَمِ",26,"م",1,0],["إِذا أَطلَقَت مِن كَفِّها الكَأسَ وَاِنثَنَت","فَكُلُّ طَليق لِلغَرامِ أَسيرُ",27,"ر",1,0],["إذا أطلَّتْ عليه الشمسُ أو غربتْ","بَدَتْ أساريرُ بسّامٍ وَعبّاس",28,"س",1,0],["إذا أطراك إنسانٌ بمدحٍ","فقل كم من خبايا في الزوايا",29,"ا",3,0],["إذا أطراك إنسانٌ بمدحٍ","فأطرق نحو قلبك وامتحنْهُ",30,"ه",1,1],["إذا أطعمتك النَّفس بالشَّيء نلته","وإنْ وعدتك النَّفس شيئاً فلا مطل",31,"ل",1,0],["إِذا اطردت أنهاره خلت جنة","بِمَدْرَجَةِ الأرواح قامت إلى اللعب",32,"ب",1,0],["إذا اطمأنَّتْ أضلُعي تذكَّرتْ","نواك فاهتزَّتْ جوىً ولا طرَبا",33,"ب",2,0],["إذا أطربَ الإبْلَ الحُداءُ فإنني","إليكم متى غنّيتُ فالجودُ مُطربي",34,"ب",2,0],["إذا اطَّباهُ مُناخٌ عند باديةٍ","أذْكرته دعَةً من ريف أمْصارِ",35,"ر",1,0],["اذا اطَّباها الناضِرُ الحَزْنيُّ","قد جادَهُ الوسْميُّ والوَليُّ",36,"ي",1,1],["إذا أطرب الأسماع نطقُ نطاقهِ","فيا خجلة اللاحي وعيَّ العواذل",37,"ل",1,0],["إذا أطلقت في مهمةٍ معجت به","كما أطلق العاني المسوق من الأسر",38,"ر",1,0],["إِذا أَطارَت يَميني عُنقَ مُرهَفِها","فَلا ذِمامَ على الأجسادِ للقممِ",39,"م",1,0],["إِذا أَطاعَت عَصاها ثِقلُ رادِفِها","كَالدِعصِ يَفرَعُهُ غُصنٌ مِنَ البانِ",40,"ن",1,0],["إذا أطعتم أمره ولم تجب","له عليكم طاعة فيما ندب",41,"ب",1,0]]}