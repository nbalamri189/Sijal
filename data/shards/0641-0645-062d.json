{"poems":[[55,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[74,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[74,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[87,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[30,"عزفت بأعشاش وما كدت تعزف","https://www.aldiwan.net/poem5335.html","البسيط"],[63,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[21,"وبفرعون إذا تشاق له","https://www.aldiwan.net/poem36209.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[69,"الصبح بدا من طلعته","https://www.aldiwan.net/poem18129.html","المتدارك"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[50,"كتبت على فص لخاتمها","https://www.aldiwan.net/poem62570.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147609",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[131,"يا سائلي عن حصن قريتنا لم","https://www.aldiwan.net/poem50674.html","الطويل"],[135,"هذه البئر قنة جار كما أن","https://www.aldiwan.net/poem54835.html","الخفيف"],[145,"قلقل ركابك في الفلا","https://www.aldiwan.net/poem58370.html","مجزوء الكامل"],[192,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[234,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[242,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[244,"أيها الفاتك الأثيم رويدا","https://www.aldiwan.net/poem45755.html","الخفيف"],[308,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[325,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[352,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[369,"أفيكم لهذا الحسن بالله منكر","https://www.aldiwan.net/poem17004.html","الطويل"],[380,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[380,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[383,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[419,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[435,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[440,"صبح الجبين وليل شعرك قد غدا","https://www.aldiwan.net/poem2499.html","الكامل"],[444,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[444,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[455,"بسط الضباب على الحقول كأنه","https://www.aldiwan.net/poem61320.html","الكامل"],[460,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[460,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[560,"فاز الذي شرب الشراب الصافي","https://www.aldiwan.net/poem33540.html","الكامل"],[560,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[569,"ومكابد حالا يسددها","https://www.aldiwan.net/poem69481.html","أحذ الكامل"]],"verses":[["فَمُحتَضَرٌ بَينَ الأَقارِبِ أَو فَتىً","تَشَحَّطَ ما بَينَ الرِماحِ قَتيلُ",0,"ل",1,0],["فَمَحيّاةٌ فَالصَفاحُ فَأَعلى","ذي فِتاقٍ فَغَاذِبٌ فَالوَفاءُ",1,"ا",2,0],["فَمَحا الصَبرُ آيَةَ العِلمِ في الحَر","بِ وَأَنحى عَلى القَوِيِّ الأَشَدِّ",2,"د",1,0],["فمحا بصبحِ العدلِ من ظلمٍ","وشفى بأيدي اللطف من كرب",3,"ب",1,0],["فمحوت إلاَّ من ثناك خواطري","ونفضت إلاَّ من نداك بناني",4,"ن",2,0],["فمحبوبه مع مكروهه","إذا ما اجتنى منه أرياً لُسِع",5,"ع",1,0],["فمحقت الأخلاف في كل مصر","مثلما يمحق الحنادس نور",6,"ر",1,0],["فَمُحَمَّدٌ لَكِ وَالمَسيحُ تَرَجَّلا","وَتَرَجَّلَت شَمسُ النَهارِ لِيوشَعِ",7,"ع",1,0],["فَمِحنَ بِهِ عَذباً رُضاباً غُروبُهُ","رِقاقٌ وَأَعلى حَيثُ رُكِّبنَ أَعجَفُ",8,"ف",1,0],["فَمحلُّه خَضِرُ الجَنابِ من النَّدى","عَذْبُ المَوارِدِ آمِنُ الأكنافِ",9,"ف",1,0],["فَمَحاهُ الاِلَهُ مِن دَرَجاتٍ","نامياتٍ وَلَم يَكُن مَقهورا",10,"ر",2,0],["فَمَحَتْ آيةُ الكَهَانَةِ آيا","تٌ مِنَ الوحْيِ ما لَهنَّ امِّحاءُ",11,"ا",2,0],["فَمُحَمَّدُنا هُوَ سَيِّدُنا","فالعِزُّ لَنا لإجَابَتِهِ",12,"ت",2,0],["فَمَحا مَعالمَ ذا نجيعٌ سافكٌ","ومحا مَعالِمَ ذا مُلِثٌّ وابل",13,"ل",1,0],["فَمَحَتهُ وَاِكتَتَبَت لِيَبلُغَني","لا نامَ مَن يَهوى وَلا هَجَدا",14,"د",2,0],["فَمَحَيتُهُ ثُمَّ اِكتَتَبتُ أَنا","وَاللَهِ أَوَّلُ مَيِّتٍ كَمَدا",14,"د",2,0],["فَمَحَتهُ وَاِكتَتَبَت تُعارِضُني","وَاللَهِ لا كَلَّمتُهُ أَبَدا",14,"د",2,0],["فمحاه دمعي من تحدره","شوقاً إليك فلم يدع سطرا",15,"ر",2,0],["فَمَحَبَّتِي لَهُمُ كَمَا عَرَفُوا","صِدْقٌ وَوَجْدِي فَوْقَ مَا أَصِفُ",16,"ف",1,0],["فمحسَّنٌ ومُزَيَّنٌ ومُرَتَّبٌ","وبناؤه ما مثلُه ترتيبُ",17,"ب",1,0],["فَمَحَطُّ الرِّحَالِ هُم","وأبَاةُ الضَيمِ قِدماً وهُم حُمَاةُ الذِّمارِ",18,"ر",1,0],["فمحالفو أوطانهم","أمثالُ سُكّان القبورِ",19,"ر",1,0],["فَمُحالٌ بُلوغُكَ الحَدَّ مَهما","قُلتَ أَو شِئتَ مِن غُلُوٍّ وَشاؤوا",20,"ا",1,0],["فمحا بنور الرشد ظلمة مكره ال","واهي فأدبر خاسيئاً يتلبط",21,"ط",1,0],["فمحصهم هذا سليم مسالم","عصاه وهذا في الغواية أجرب",22,"ب",1,0],["فمحالٌ أن يهدِمَ المرءُ صَرحاً","أعجزَ الدهرَ بأسه أن يهدا",23,"د",2,0],["فَمحمّدٌ ومحمّدٌ ومحمّدٌ","وَمحمّد والخامس المتوقّعُ",24,"ع",1,0],["فَمُحاقٌ هذا وَهذا كَبيرٌ","بَعدَما كانَ ناشِئاً كَالهِلالِ",25,"ل",1,0],["فَمُحَيّاهُ حَبا الضَوءَ الأَضى","وَحَيّاهُ أَلبَسَ الوَشيَ الأَشِي",26,"ي",1,0],["فَمَحبوبُ هَذا اليَومِ بِالأَمسِ مُجتَوىً","وَمَعروفُهُ قَد كانَ مِن قَبلُ يُنكَرُ",27,"ر",1,0],["فمحبة الذات استغشَّته متى","عنها تجرد عاد عنها يوكَس",28,"س",1,0],["فمحبتي لَقَويَّةٌ كالموت بل","كجحيم نارٍ جلَّ عن إطفاء",29,"ا",2,0],["فَمَحا اللَهُ آية اللَيل لَكن","بِشُعاع الحسام لا بِذَكاءِ",30,"ا",2,0],["فمحالٌ أن ترى عينٌ رأت","كحسام الدِّين للدِّين حساما",31,"م",2,0],["فمحمدٌ منه المحامِدُ تَعْتَلِي","وأَبو السعودِ به السعادَةُ تُشْمَلُ",32,"ل",1,0],["فمحلّتي تعلو السماك وهمتي","جازت علاء في المعالي الفرقدا",33,"د",2,0],["فمحتفظ بسلوى عنك ليلى","وحزني عنك توديعك نازي",34,"ز",2,0],["فمحض التوب من رعشا","ت ثلج الذنب تدفيني",35,"ن",2,0],["فمحا بضربته الجداول والربى","والغرس دون تمهّل وسؤال",36,"ل",1,0],["فمحبوكةٌ حبْكَ السماء وسيعةٌ","لها من أديم الباقيات أديمُ",37,"م",1,0],["فمحسنٌ يرجو النجاةَ عنده","إلى مسيءٍ يتّقي نَكالَه",38,"ل",2,0],["فمحا بنور ظهوره آثارها","وأمدها ببدائع الألطاف",39,"ف",1,0],["فمحتهم بها وقد أثبتتهم","عندها في حمى العيون الفواتك",40,"ك",1,0],["فَمَحَا غَضَاضَةَ سُوءِ مَخْبَرِهَا","حَمْدُ الحَسَادَةِ مِنْ مُعَايِنِهَا",41,"ن",3,0]]}