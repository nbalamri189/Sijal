{"poems":[[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[28,"عزفت بأعشاش وما كدت تعزف","https://www.aldiwan.net/poem5335.html","البسيط"],[61,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[21,"وبفرعون إذا تشاق له","https://www.aldiwan.net/poem36209.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"الصبح بدا من طلعته","https://www.aldiwan.net/poem18129.html","المتدارك"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[48,"كتبت على فص لخاتمها","https://www.aldiwan.net/poem62570.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147609",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"]],"verses":[["فَمُحتَضَرٌ بَينَ الأَقارِبِ أَو فَتىً","تَشَحَّطَ ما بَينَ الرِماحِ قَتيلُ",0,"ل",1,0],["فَمَحيّاةٌ فَالصَفاحُ فَأَعلى","ذي فِتاقٍ فَغَاذِبٌ فَالوَفاءُ",1,"ا",2,0],["فَمَحا الصَبرُ آيَةَ العِلمِ في الحَر","بِ وَأَنحى عَلى القَوِيِّ الأَشَدِّ",2,"د",1,0],["فمحا بصبحِ العدلِ من ظلمٍ","وشفى بأيدي اللطف من كرب",3,"ب",1,0],["فمحوت إلاَّ من ثناك خواطري","ونفضت إلاَّ من نداك بناني",4,"ي",1,0],["فمحبوبه مع مكروهه","إذا ما اجتنى منه أرياً لُسِع",5,"ع",1,0],["فمحقت الأخلاف في كل مصر","مثلما يمحق الحنادس نور",6,"ر",1,0],["فَمُحَمَّدٌ لَكِ وَالمَسيحُ تَرَجَّلا","وَتَرَجَّلَت شَمسُ النَهارِ لِيوشَعِ",7,"ع",1,0],["فَمِحنَ بِهِ عَذباً رُضاباً غُروبُهُ","رِقاقٌ وَأَعلى حَيثُ رُكِّبنَ أَعجَفُ",8,"ف",1,0],["فَمحلُّه خَضِرُ الجَنابِ من النَّدى","عَذْبُ المَوارِدِ آمِنُ الأكنافِ",9,"ف",1,0],["فَمَحاهُ الاِلَهُ مِن دَرَجاتٍ","نامياتٍ وَلَم يَكُن مَقهورا",10,"ر",2,0],["فَمَحَتْ آيةُ الكَهَانَةِ آيا","تٌ مِنَ الوحْيِ ما لَهنَّ امِّحاءُ",11,"ا",2,0],["فَمُحَمَّدُنا هُوَ سَيِّدُنا","فالعِزُّ لَنا لإجَابَتِهِ",12,"ت",2,0],["فَمَحا مَعالمَ ذا نجيعٌ سافكٌ","ومحا مَعالِمَ ذا مُلِثٌّ وابل",13,"ل",1,0],["فَمَحَتهُ وَاِكتَتَبَت لِيَبلُغَني","لا نامَ مَن يَهوى وَلا هَجَدا",14,"د",2,0],["فَمَحَيتُهُ ثُمَّ اِكتَتَبتُ أَنا","وَاللَهِ أَوَّلُ مَيِّتٍ كَمَدا",14,"د",2,0],["فَمَحَتهُ وَاِكتَتَبَت تُعارِضُني","وَاللَهِ لا كَلَّمتُهُ أَبَدا",14,"د",2,0],["فمحاه دمعي من تحدره","شوقاً إليك فلم يدع سطرا",15,"ر",2,0],["فَمَحَبَّتِي لَهُمُ كَمَا عَرَفُوا","صِدْقٌ وَوَجْدِي فَوْقَ مَا أَصِفُ",16,"ف",1,0]]}