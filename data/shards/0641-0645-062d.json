id=201078",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5518,"في ذكرى المولد النبوي الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=187775",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5667,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=214915",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[4623,"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5943,"إنْ كانَ فيكم نخوةٌ ومروءةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=11267",""],[5956,"الحب السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=181895",""],[5956,"يا من أخذت من اسمكم معناهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194377",""],[5956,"حارس الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=206676",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6052,"اخلاق المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=34793",""],[6093,"ضَحِك المَشِيْبُ بِعَارِضيَّ مُعَرِّضَا (الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=180625",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[1078,"سيغني الله عن فرج القريب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=611785",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["فَمُحتَضَرٌ بَينَ الأَقارِبِ أَو فَتىً","تَشَحَّطَ ما بَينَ الرِماحِ قَتيلُ",0,"ل",1,0],["فَمَحيّاةٌ فَالصَفاحُ فَأَعلى","ذي فِتاقٍ فَغَاذِبٌ فَالوَفاءُ",1,"ا",2,0],["فَمَحا الصَبرُ آيَةَ العِلمِ في الحَر","بِ وَأَنحى عَلى القَوِيِّ الأَشَدِّ",2,"د",1,0],["فمحا بصبحِ العدلِ من ظلمٍ","وشفى بأيدي اللطف من كرب",3,"ب",1,0],["فمحوت إلاَّ من ثناك خواطري","ونفضت إلاَّ من نداك بناني",4,"ن",2,0],["فمحبوبه مع مكروهه","إذا ما اجتنى منه أرياً لُسِع",5,"ع",1,0],["فمحقت الأخلاف في كل مصر","مثلما يمحق الحنادس نور",6,"ر",1,0],["فَمُحَمَّدٌ لَكِ وَالمَسيحُ تَرَجَّلا","وَتَرَجَّلَت شَمسُ النَهارِ لِيوشَعِ",7,"ع",1,0],["فَمِحنَ بِهِ عَذباً رُضاباً غُروبُهُ","رِقاقٌ وَأَعلى حَيثُ رُكِّبنَ أَعجَفُ",8,"ف",1,0],["فَمحلُّه خَضِرُ الجَنابِ من النَّدى","عَذْبُ المَوارِدِ آمِنُ الأكنافِ",9,"ف",1,0],["فَمَحاهُ الاِلَهُ مِن دَرَجاتٍ","نامياتٍ وَلَم يَكُن مَقهورا",10,"ر",2,0],["فَمَحَتْ آيةُ الكَهَانَةِ آيا","تٌ مِنَ الوحْيِ ما لَهنَّ امِّحاءُ",11,"ا",2,0],["فَمُحَمَّدُنا هُوَ سَيِّدُنا","فالعِزُّ لَنا لإجَابَتِهِ",12,"ت",2,0],["فَمَحا مَعالمَ ذا نجيعٌ سافكٌ","ومحا مَعالِمَ ذا مُلِثٌّ وابل",13,"ل",1,0],["فَمَحَتهُ وَاِكتَتَبَت لِيَبلُغَني","لا نامَ مَن يَهوى وَلا هَجَدا",14,"د",2,0],["فَمَحَيتُهُ ثُمَّ اِكتَتَبتُ أَنا","وَاللَهِ أَوَّلُ مَيِّتٍ كَمَدا",14,"د",2,0],["فَمَحَتهُ وَاِكتَتَبَت تُعارِضُني","وَاللَهِ لا كَلَّمتُهُ أَبَدا",14,"د",2,0],["فمحاه دمعي من تحدره","شوقاً إليك فلم يدع سطرا",15,"ر",2,0],["فَمَحَبَّتِي لَهُمُ كَمَا عَرَفُوا","صِدْقٌ وَوَجْدِي فَوْقَ مَا أَصِفُ",16,"ف",1,0],["فمحسَّنٌ ومُزَيَّنٌ ومُرَتَّبٌ","وبناؤه ما مثلُه ترتيبُ",17,"ب",1,0],["فَمَحَطُّ الرِّحَالِ هُم","وأبَاةُ الضَيمِ قِدماً وهُم حُمَاةُ الذِّمارِ",18,"ر",1,0],["فمحالفو أوطانهم","أمثالُ سُكّان القبورِ",19,"ر",1,0],["فَمُحالٌ بُلوغُكَ الحَدَّ مَهما","قُلتَ أَو شِئتَ مِن غُلُوٍّ وَشاؤوا",20,"ا",1,0],["فمحا بنور الرشد ظلمة مكره ال","واهي فأدبر خاسيئاً يتلبط",21,"ط",1,0],["فمحصهم هذا سليم مسالم","عصاه وهذا في الغواية أجرب",22,"ب",1,0],["فمحالٌ أن يهدِمَ المرءُ صَرحاً","أعجزَ الدهرَ بأسه أن يهدا",23,"د",2,0],["فَمحمّدٌ ومحمّدٌ ومحمّدٌ","وَمحمّد والخامس المتوقّعُ",24,"ع",1,0],["فَمُحاقٌ هذا وَهذا كَبيرٌ","بَعدَما كانَ ناشِئاً كَالهِلالِ",25,"ل",1,0],["فَمُحَيّاهُ حَبا الضَوءَ الأَضى","وَحَيّاهُ أَلبَسَ الوَشيَ الأَشِي",26,"ي",1,0],["فَمَحبوبُ هَذا اليَومِ بِالأَمسِ مُجتَوىً","وَمَعروفُهُ قَد كانَ مِن قَبلُ يُنكَرُ",27,"ر",1,0],["فمحبة الذات استغشَّته متى","عنها تجرد عاد عنها يوكَس",28,"س",1,0],["فمحبتي لَقَويَّةٌ كالموت بل","كجحيم نارٍ جلَّ عن إطفاء",29,"ا",2,0],["فَمَحا اللَهُ آية اللَيل لَكن","بِشُعاع الحسام لا بِذَكاءِ",30,"ا",2,0],["فمحالٌ أن ترى عينٌ رأت","كحسام الدِّين للدِّين حساما",31,"م",2,0],["فمحمدٌ منه المحامِدُ تَعْتَلِي","وأَبو السعودِ به السعادَةُ تُشْمَلُ",32,"ل",1,0],["فمحلّتي تعلو السماك وهمتي","جازت علاء في المعالي الفرقدا",33,"د",2,0],["فمحتفظ بسلوى عنك ليلى","وحزني عنك توديعك نازي",34,"ز",2,0],["فمحض التوب من رعشا","ت ثلج الذنب تدفيني",35,"ن",2,0],["فمحا بضربته الجداول والربى","والغرس دون تمهّل وسؤال",36,"ل",1,0],["فمحبوكةٌ حبْكَ السماء وسيعةٌ","لها من أديم الباقيات أديمُ",37,"م",1,0],["فمحسنٌ يرجو النجاةَ عنده","إلى مسيءٍ يتّقي نَكالَه",38,"ل",2,0],["فمحا بنور ظهوره آثارها","وأمدها ببدائع الألطاف",39,"ف",1,0],["فمحتهم بها وقد أثبتتهم","عندها في حمى العيون الفواتك",40,"ك",1,0],["فَمَحَا غَضَاضَةَ سُوءِ مَخْبَرِهَا","حَمْدُ الحَسَادَةِ مِنْ مُعَايِنِهَا",41,"ن",3,0],["فَمَحَلِّ أَعلاها إِلى","عَرَفاتِها فَحِرائِها",42,"ا",3,0],["فمحمدٌ وجِهادُه عَن حَوزَةِ الإ","سلامِ تَوءَم خالدٍ وجِهادِه",43,"د",2,0],["فمحرابه اليوم من بعده","ينوح عليه مع المسجد",44,"د",1,0],["فمحبتي لك لا تزال عظيمة","وتعلقي بك محكم الأسباب",45,"ب",1,0],["فَمحا رُسوم الجُور بِالعَدل الَّذي","أَحيا مِن الأَوطان كُل رَميم",46,"م",1,0],["فمحراثٌ يشق الأرض عندي","ويخرج من ثراها الخصب تبرا",47,"ر",2,0],["فمحمدُ أَزْكى الورى حسبا","وأعز وأَرْقَى الأنام عملْ",48,"ل",1,0],["فمحمد بن يعيش البطلُ الرّضي","وبنو أبيه غائبون وشُهد",49,"د",1,0],["فمُحيَّا الكون منكم","أرِّخوا يغشاه طيبْ",50,"ب",1,0],["فمحا شروقهما دياجر جهل من","جنحوا إلى التسليم والايمان",51,"ن",1,0],["فمَحْيا الروضِ بالصَّوْب الم