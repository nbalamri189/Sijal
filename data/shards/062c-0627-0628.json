{"poems":[[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[87,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[87,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[87,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[107,"عيد الفداء جرى باليمن طائره","https://www.aldiwan.net/poem42105.html","البسيط"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[108,"أغنية الإِسراء","https://www.poetsgate.com/ViewPoem.aspx?id=179622",""],[108,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[139,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[170,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[275,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[342,"صدع الظعائن قلبه المشتاقا","https://www.aldiwan.net/poem45423.html","الكامل"],[445,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[458,"خادم آمر كفيل بكتبي","https://www.aldiwan.net/poem61301.html","الخفيف"],[469,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[484,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[556,"في مثلها يستثار الصبر والجلد","https://www.aldiwan.net/poem47882.html","البسيط"],[558,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86771","الخفيف"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/203822","البسيط"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119254","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95513","الكامل"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206189",""],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11858","الكامل"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107351","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118301","البسيط"],[2465,"","https://poetry.dctabudhabi.ae/diwan/poem/124310","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100785","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89283","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62991","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132018","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91197","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91278","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125877","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127287","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99097","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52143","الكامل"],[4791,"الحسن الحذر","https://www.poetsgate.com/ViewPoem.aspx?id=36958",""],[4987,"مريت الاطراف؟","https://www.poetsgate.com/ViewPoem.aspx?id=49587",""],[4988,"جابتني الصدفة","https://www.poetsgate.com/ViewPoem.aspx?id=196637",""],[5028,"مرت على بالي اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=62108",""],[1470,"نبع الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=12967",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5198,"البساط احمدي","https://www.poetsgate.com/ViewPoem.aspx?id=136230",""],[5254,"اشارات الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=212757",""],[5433,"جابك الله","https://www.poetsgate.com/ViewPoem.aspx?id=36260",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5751,"خطوتانِ لقَمَرٍ هارب","https://www.poetsgate.com/ViewPoem.aspx?id=214718",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[402,"ألشرق طال سباته الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=36487",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[5848,"ثلاثة اهداف","https://www.poetsgate.com/ViewPoem.aspx?id=53375",""],[5861,"أكان بوذيا قاتلي يا ترى ..أم انه قد كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=191503",""],[5866,"لوكان فكري يحمر العين مشلول","https://www.poetsgate.com/ViewPoem.aspx?id=182811",""],[192,"يا كويت","https://www.poetsgate.com/ViewPoem.aspx?id=16377",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""]],"verses":[["جَابَتْ بِكَ الآفاقَ تَسْتَوْفِي بِهَا","مَا شِئْتَ مِنْ أَدَبٍ وَمِنْ عِرْفَانِ",0,"ن",1,0],["جابوا إِلَيكِ البُعدَ مِن بَعيدِ","يُخاطِرونَ اللَيلَ ذا الكُؤودِ",1,"د",1,0],["جابتْ سهولاً وأوعاراً ركائبهم","كيما يحلّوا سهولاً بعد أوعارِ",2,"ر",1,0],["جابَت قَضَيَّتُكَ البِلا","دَ كَأَنَّها مَثَلٌ يَسير",3,"ر",1,0],["جابَ المَمالِكَ حَزنَها وَسُهولَها","وَطَوى شِعابَ الصِربِ وَالبُلغارِ",4,"ر",1,0],["جابوا العُبابَ عَلى عودٍ وَسارِيَةٍ","وَأَوغَلوا في الفَلا كَالأُسدِ وُحدانا",5,"ن",2,0],["جاب الجِواءَ ونال النَّجمَ مُنصلِتٌ","أعيا العُقابَ ورَاعَ النَّسْرَ كاسِرُهُ",6,"ر",2,0],["جابَةُ المِدرى لَها ذو جُدَّةٍ","تَنفُضُ الضالَ وَأَفنانَ السَمُر",7,"ر",1,0],["جاب البحارَ إليكمو حتى إذا","نصلَ الدُّجى ألقى عصا تسيارِهِ",8,"ر",2,0],["جَابَ الصّحَارَى المُوحِشاتِ يَرُوعُهَا","مِنْ ذلِك الإِنسِيِّ أَوَّلُ طارِقِ",9,"ق",1,0],["جابَ السماءَ؛ فراح النجم يَرْصُدُهُ","ويقبِسُ النورَ من زاهي مُحَيّاهُ",10,"ا",2,0],["جابتْ مواخرُهم ظهر العباب، ولم","تترُكْ خيولُهُمُو شبرًا من اليَبَسِ",11,"س",1,0],["جاب الحجاز وأرض الروم مرتحلاً","شرقاً وغرباً يسير الوخد والخببا",12,"ب",2,0],["جابَ الفَيافي المُؤيِداتِ وَآلُهُ","آلٌ تَمَكَّنَ فيهِ قَلبٌ جابُ",13,"ب",1,0],["جابُوا الفلاةَ وأغرتْهم بها هِمَمٌ","خُلقْنَ كَلا على الأسفارِ والرِّحَلِ",14,"ل",1,0],["جابَ البلادَ وخاض البحرَ مُبتسماً","وظلّ يخفي جُروحاً من شقائهم",15,"م",1,0],["جَأبٌ خَلا بِحَلائِلٍ وَسَقَت لَهُ","فَحَمَلنَ لَم يُغرَم لَهُنَّ صَداقا",16,"ق",2,0],["جابَ عنه الأَرضَ حَتَّى جُمِعُوا","فِي أَقاصِيها عَلَى أَدْنَى العَدَدْ",17,"د",1,0],["جابَ الظَّلامَ فَلَمْ يَدَعْ من دَجْنِهِ","إِلّا غَدَائِرَ شَعْرِهِ المُنْجابِ",18,"ب",1,0],["جابوا الفلاة على عجا","ل قد جرت جري البواخر",19,"ر",1,0],["جاب كل الأقطار لا يشتكي","الأين وما زال بين سلم وحرب",20,"ب",1,0],["جابت إليك البيد موجفة وخير","المدح ما جاب المهامه موجفا",21,"ف",2,0],["جاب البلاد فجاء تاريخا يرى","ولديه من أخبارها أحمال",22,"ل",1,0],["جاب البلاد فجاء سفرا ناطقا","يحوي النفيس وما عساه يقال",22,"ل",1,0],["جاب البلاد فجاء كنزا مثمنا","وعليه تاج مجادة وجلال",22,"ل",1,0],["جاب البلادَ وعدّى عن مصارعِهِ","فَاِختطّ مَصرعَه مِنْ بينها بَلدُ",23,"د",1,0],["جابوا البِلادَ وَأَهلُها خَوَلٌ لَهُم","مُستَسلِمينَ فَمُطلَقٌ وَأَسيرُ",24,"ر",1,0],["جاب فيمه مسكو بعبق","ريحته عنبر وقرقف",25,"ف",1,0],["جابرٌ كسرَها بِتَوزيع ماء","هُوَ أسُّ الغنى بِها لِلعِباد",26,"د",1,0],["جأب الشراسيف رحب الجوف مفترس","عند التجاول للأقران مهتصر",27,"ر",1,0],["جابَ البِلاد كُلَّها وَجالا","وَعَرف الكتبَ وَالرِّجالا",28,"ل",2,0],["جابرات جنانهن جناني","جائرات جحيمهن جفائي",29,"ا",2,0],["جَابَ الفيافِى حازماً عجلاً","متنسِّكا حتى جنى الظفرَا",30,"ر",2,0],["جابن وسيعات الفيافي ولوهود","ثمّ انْشِرَن مثل الدِّمن يوم تِقْتاد",31,"د",1,0],["جابَت إِلَيكَ بَنو الرَجا جَوزَ الفَلا","مُذ شِدتَ مَجداً دونَهُ الجَوزاءُ",32,"ا",2,0],["جابوا الفيافي والعراء وما هووا","قيلولةً فيها ولا التعريسا",33,"س",2,0],["جاب من فوقهم دعاؤهم السق","ف فأبكى دعاؤهم ميكالا",34,"ل",2,0],["جابوا إليها العلا بيدا وعامرة","ورحلوا العيس وجناها وفتلاها",35,"ا",3,0],["جاب دوني بعد الهدُوّ اعتسافا","في الدياجي تنائفا أغفالا",36,"ل",2,0],["جابوا الفيافيَ حتى ملهم قتب","من كل جائلة تجتاب أنجادا",37,"د",2,0],["جاب الوعور بشق نفس عندها","الصعب في نيل المعالي ساهل",38,"ل",1,0],["جابوا البِلاد وَحَوَّلوا","جدبَ البِلاد إِلى خصب",39,"ب",1,0],["جاب المُطَّرب قد تَفَرْ","رَدَ بالفراهةِ واستَبَدَّا",40,"د",2,0],["جابوا البلاد لشرقها أو غربها","خاضوا البحار وفي الصحارى خيموا",41,"م",3,0],["جابوا البِلاد كَما خانوا العباد وَهم","يَستطلعون طَريقاً غَير مَطروق",42,"ق",1,0],["جابَت جَوائبُ فَخره كُلَّ الوَرى","فَعلا لَهُ ذكر هناك مصدّق",43,"ق",1,0],["جأبٍ رباعٍ أقب لابطن صهصلق","مكدم أخدري أحقبٍ عتيد",44,"د",1,0],["جابرٌ من مباركٍ من صباحٍ","وهناك الأجداد والأخوان",45,"ن",1,0],["جابراً صدعي فيه مذ دنا","يصدع الليل بوجه أبلج",46,"ج",1,0],["جاب الإله لنا بصب","ح لقاه ديجور الحزن",47,"ن",1,0],["جابَ الفَلا مِن وَجَلٍ مُختَفِياً","يَشكُو إذا تَقَرَعُهُ المَروُ الوَجَا",48,"ا",1,0],["جابتْ إلى الأعداءِ كلَّ تَنوفةٍ","وطوَتْ إلى أعدائها عُدَواءها",49,"ا",3,0],["جابر اسمي ولي قلب كسير","وزفراق دستانم شد أسير",50,"ر",1,0],["جاب المطرّف قد تفر","د بالفراهة واستبدّا",51,"د",2,0],["جابوا البحارَ قريبَها وبعيدَها","وبغوا السماءَ فسخّروا أجرامَها",52,"م",3,0],["جابلي نفح الهواء منك العبير","حبك .. أمرك .. يا حبيبي لذته",53,"ت",2,0],["جابتني الذكرى على الماضي كتاف","سجيت كني توني مكتشفها",54,"ف",3,1],["جابتني الصّدفه وقلت اتركوني","وايعزت للهاجوس صفّ الكتايب",55,"ب",1,0],["جابتلي الفرحة وانا كنت مهموم","الظاهر انها عن علومي تحرت",56,"ت",1,0],["جابوا ثراكَ بأكْبُد مشبوبةٍ","نادتْ، بشوق، تطلب الرضوانا",57,"ن",2,0],["جاب حزن اليهماء يمخر في الدأ","ماء ما بين غشه والداء",58,"ا",2,0],["جابك الحظ مدري كيف ومنين جيت","ياطبيب الخفوق وجرحه السرمدي",59,"د",2,1],["جاب الجمال مدارات الأنا أسِفا","من بوح شكٍ تمادى في المدى غولا",60,"ل",2,1],["جابك الله على غاية المطلوب","من مواطيك بالعشب لأهدابك",61,"ك",1,1],["جابَهَ البؤس والمصاعبَ من","قبلُ ولكنْ كأسْرِهِ لم يُجابِهْ",62,"ب",2,0],["جَابَ القفارَ ، وَراءَهُ أنفاسُهُ","تَجري ، وصارَ بِرِكْضِهِ مُتَعَدِّدَا",63,"د",2,1],["جابَ القفارَ ، وراءَهُ فُقَراؤهُ","وَبِهِمْ تَوَحَّدَ ، فاستوى مُتَعَدِّدا",63,"د",2,0],["جابك الله من غياب ٍ ضيّق صدور المباني","قبل لا الوحشه تزعزع بيتك الصلب وتبيده",64,"د",2,1],["جابت بك الافاق تستوقي بها","ما شئت من أدب ومن عرفان",65,"ن",1,0],["جابتها الاقدار ياسلطان","والنفس ماتكره الخيره",66,"ر",2,0],["جابت ف قلبك ثلاث اهداف","وفازت سواة السعوديّة",67,"ي",2,0],["جابوا الزمان بفرية","وهم البعيد المفترا",68,"ر",2,0],["جاب المُثل واستثمر ارواح وعقول","بالحلم والحكمة وبالاعتدالي",69,"ل",2,0],["جابر وله في المجد مجد مترامي هو صاحب الطولات غيث المظاليم","وسعد الكريم الشهم عالي المقامي اخوان مريم مجدهم ياصل الغيم",70,"م",1,0],["جابوا الذي حالوا عليهم مثالنا","بعيالهم وولادهم وطفال",71,"ل",1,0],["جَابَ الجمالُ ضِفافَ أوديةِ الدُنا","والناسُ تُبحِرُ في دُجىً ودِماءِ",72,"ا",2,0],["جابَتْ أناملُهُ... حرير قميصها","فأطلّ من جيب القميص نهار",73,"ر",1,0],["جابوا الحياة وقطّعوا أوصالها","صوت الذئاب على الزمان عواء",74,"ا",2,0]]}