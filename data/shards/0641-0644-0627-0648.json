,"الطويل"],[370,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[370,"يا ذا الذي مرج البحرين خاطره","https://www.aldiwan.net/poem17154.html","البسيط"],[381,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[384,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[384,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[384,"ملكت قلبي ولم أملكه يا سكني","https://www.aldiwan.net/poem48816.html","البسيط"],[384,"أطاعك قلبي جاهدا فعصيته","https://www.aldiwan.net/poem49246.html","الطويل"],[432,"أعاذلتي على رزءٍ أفيقي","https://www.aldiwan.net/poem764.html",""],[436,"أما إنه لولا الخيال المعاود","https://www.aldiwan.net/poem12609.html","الطويل"],[452,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[455,"ألا مرحبا باقتبال الربيع","https://www.aldiwan.net/poem13766.html","المتقارب"],[461,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[461,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[461,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[461,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[461,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[478,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[480,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[532,"فلا وحقك ما أنفك آونة","https://www.aldiwan.net/poem37262.html","البسيط"],[540,"رأيت الخمر صالحة وفيها","https://www.aldiwan.net/poem69373.html","الوافر"],[554,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[554,"نأينا فمن دون اللقاء تنائف","https://www.aldiwan.net/poem47401.html","الطويل"],[554,"أجيرتنا لا جمع الله شملنا","https://www.aldiwan.net/poem47753.html","الطويل"],[556,"بكاء وكأس كيف يتفقان","https://www.aldiwan.net/poem68248.html","الطويل"],[561,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[589,"خليلي هل من حلمل لي تحية","https://www.aldiwan.net/poem17581.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/31474","الوافر"],[755,"","https://poetry.dctabudhabi.ae/diwan/poem/121892","الوافر"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31493","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31486","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/22571","الوافر"],[813,"","https://poetry.dctabudhabi.ae/diwan/poem/202300","الوافر"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/18028","الوافر"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18055","الوافر"],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/204422","الوافر"],[931,"","https://poetry.dctabudhabi.ae/diwan/poem/133893","الوافر"],[935,"","https://poetry.dctabudhabi.ae/diwan/poem/79628","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[963,"","https://poetry.dctabudhabi.ae/diwan/poem/96128","الوافر"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2530","الوافر"],[1182,"","https://poetry.dctabudhabi.ae/diwan/poem/31392","الوافر"]],"verses":[["فلا وربك لا سارت بنا قدم","إذا عن الحق نكسنا نواصينا",0,"ن",2,0],["فَلا وَاللَهِ أَترُكُها خَليّاً","وَلَمّا أَجنُبِ الأُسدَ الغِضابا",1,"ب",2,0],["فلا وصْلَ حتّى يَذْرَعَ العِيسُ مَهْمَهاً","إذا الجِنُّ غَنّتْنا بهِ رَقَصَ الآلُ",2,"ل",1,0],["فَلا وَالَّذي مَسَّحتُ أَركانَ بَيتِهِ","أَطوفُ بِهِ فيمَن يَطوفُ وَيَحصِبُ",3,"ب",1,0],["فَلا وَأَبيكَ لا نُعطيكَ مِنها","طِوالَ حَياتِنا إِلّا سِنانا",4,"ن",2,0],["فَلا وَزَرٌ مَن بَأسِهِ لِعُداتِهِ","وَلَو وَقَلَت كَالعُصمِ في شامِخٍ وَعرِ",5,"ر",1,0],["فَلا وَاللَهِ لا أَنساكَ حَتّى","أُفارِقَ مُهجَتي وَيُشَقُّ رَمسي",6,"س",2,0],["فَلا وَأَبيكَ ما سَلَّيتُ صَدري","بِفاحِشَةٍ أَتَيتَ وَلا عُقوقِ",7,"ق",1,0],["فَلا وَصلَ إِلاّ أَن تُقارِبَ بَينَنا","قَلائِصُ تَجسُرنَ الفَلاةَ بِنا جَسرا",8,"ر",2,1],["فَلا وَأَبيكَ ما لاقَيتُ حَيّاً","كَيَربوعٍ إِذا رَفَعوا العُقابا",9,"ب",2,0],["فَلا وَأَبيكَ ما حَيٌّ كَحَيٍّ","لِجارٍ حَلَّ فيهِم أَو عَديمِ",10,"م",1,0],["فَلا وَأَبيكَ ما يَظَلُّ اِبنُ جارَتي","يَطوفُ حَوالَي قِدرِنا ما يَطورُها",11,"ر",3,0],["فَلا وَأَبي ما ساعِدانِ كَساعِدٍ","وَلا وَأَبي ما سَيِّدانِ كَسَيِّدِ",12,"د",1,0],["فَلا وَاللَهِ ما تَدري مَعيصٌ","أَسَهلٌ بَطنُ مَكَّةَ أَم يَفاعُ",13,"ع",1,1],["فَلا وَقرٌ بِسَمعِكَ حينَ تُدعى","ضُحىً إِذ لا تُجيبُ وَلا تُعينُ",14,"ن",1,0],["فَلا وَأَخيكَ الكَريمِ الَّذي","بِهِ لا تُرى أَبَداً تُعتَلُ",15,"ل",1,0],["فلا وقايةَ تحمِي وفدَ راحته","بلى على عرضهِ الأنقى وقايات",16,"ت",1,0],["فلا وَوَقتٍ كانَ للشعر لا","يجمعنا من بعد ذا سقفُ بيت",17,"ت",1,0],["فلا وزر","ولا مفر",18,"ر",1,0],["فلا والله ما أجدى","وراحَ الطول في العرض",19,"ض",1,0],["فلا وحماكَ الرَّحم لا بتّ مهدياً","حقائق أمداحِي لغير حماكا",20,"ك",2,0],["فلا واصلاً حبلاً لمن هو قاطعٌ","ولا قاطعاً حبلاً لمن هو واصل",21,"ل",1,0],["فلا وألتْ هنالكَ نَفْس سُوءٍ","عليها يا سُلَيْمُ تُحاذرينا",22,"ن",2,0],["فَلا وَأَبيكَ ما يَسطيعُ قَومٌ","إِذا لَم يَأخُذوا مِنّا حِبالا",23,"ل",2,0],["فَلا وَأَبي هَوازِنَ ما جَزِعنا","وَلا هَمَّ الظَعائِنُ بِاِنحِيازِ",24,"ز",1,0],["فَلا وَأَبيكَ لَو أَمكَنتَ قَومي","لَظَلَّ عَلى جَناجِنِكَ النِسارُ",25,"ر",1,0],["فَلا وَأَلَت تِلكَ النُفوسُ وَلا أَتَت","عَلى رَوضَةِ الأَجدادِ وَهِيَ جَميعُ",26,"ع",1,0],["فَلا وَاللَهِ مايَح","سُنُ بَينَ الناسِ ذِكراها",27,"ا",3,0],["فَلا وَاللَهِ ماحاوَلتَ عُذراً","فَكُلُّ الناسِ يُعذَرُ ما خَلاكا",28,"ك",2,0],["فَلا وَجهَ إِن أَقبَلَت","وَلا رِدفَ إِن وَلَّتِ",29,"ت",1,0],["فَلا وَصلَ إِلّا أَن يُطيفَ خَيالُها","بِنا تَحتَ جُؤشوشٍ مِنَ اللَيلِ أَسفَعِ",30,"ع",1,0],["فَلا وَصلَ حَتّى تَقضِيَ الحَربُ أَمرَها","بِمُفتَرَقٍ أَو فَضلِ عُمرٍ فَمُلتَق",31,"ق",1,0],["فَلا وَصلَ إِلّا أَن تُجَدِّدَ خُلَّةً","وَلا أُنسَ إِلّا أَن يَكونَ بَديلُ",32,"ل",1,0],["فَلا وَأَبيكِ ما ضَيَّعتُ حِلماً","وَلا قارَفتُ في حُبّيكِ ذاما",33,"م",2,0],["فَلا وَأَبي لَما أَخشى وَرائي","مِنَ الأَحداثِ وَالفَزَعِ الكَبيرِ",34,"ر",1,0],["فَلا وَالَّذي تَلقى خُزَيمَةُ مِنهُمُ","بَني أُمِّ بَذّاخينَ غَيرِ عَقيمِ",35,"م",1,0],["فَلا وَأَبيكَ الكَلبِ ما مِن مَخافَةٍ","إِلى الشَأمِ أَدّوا خالِداً لَم يُسالِمِ",36,"م",1,0],["فَلأُوضِحَنَّ صَبابتي","بالدَّمعِ في الدِّمَنِ الدَّواثِر",37,"ر",1,0],["فَلا وَاللَهِ لا أَصفو لِخِلٍّ","سَجِيَّتُهُ التَعَتُّبُ وَالنِفارُ",38,"ر",1,0],["فَلا وَأَبي أُمَيمَةَ ما أَبوها","مِنَ النَعَمِ المُؤَثَّلِ وَالجَزورِ",39,"ر",1,0],["فَلا وَصلَ إلّا بَينَ أسمائنا الّتي","تسافرُ منّا في مُعَنْوَنَةِ الكتبِ",40,"ب",1,0],["فَلا وَاللَهِ ما في العَيشِ خَيرٌ","وَلا الدُنيا إِذا ذَهَبَ الحَياءُ",41,"ا",2,0],["فَلا وَأَبيكَ ما صَوتَ الغَواني","وَلا شُربَ الَّتي هِيَ كَالفُصوصِ",42,"ص",1,1],["فَلا وَصلٌ يُبَرِّدُ نارَ قَلبي","وَلا صَبرٌ وَمَن يَجِدِ اِصطِبارِ",43,"ر",1,0],["فَلا وَصلَ إِلّا أَن يُقارِبَ بَينَنا","قَلائِصُ في أَذنابِهِنَّ صَفاءُ",44,"ا",2,0],["فَلا وَأَبيكَ نُقِرُّ الأَذى","وَنَرضى الهَوانَ وَنَلقى الضَرَرْ",45,"ر",1,0],["فَلا وَأَبيكَ ما نَزَلنا بِعامِرٍ","وَلا عامِرٍ وَلا الرَئيسِ اِبنِ قَوقَلِ",46,"ل",1,0],["فَلا وَأَبيكَ ما ظَلَمَت قُرَيعٌ","بِأَن يَبنوا المَكارِمَ حَيثُ شاؤوا",47,"ا",1,0],["فَلا وَأَبيكَ ما ظَلَمَت قُرَيعٌ","وَلا بَرِموا لِذاكَ وَلا أَساؤوا",47,"ا",1,0],["فَلا وَاللَهِ لا تَبرَ","حُ حَتّى يُبرَمَ الأَمرُ",48,"ر",1,0],["فَلا وَصلَ إِلّا عَبرَةً تَستَديمُها","أَحاديثُ نَفسٍ مالَها الدَهرَ ذاكِرُ",49,"ر",1,0],["فَلا وَأَبيكُمُ ما الفَضلُ دَأبي","إِذا ما لَم أَجِد مِنكُم صَديقا",50,"ق",2,0],["فَلا وَاللَهِ أَذخَرُكُم هِجاءً","وَشَتماً ما بَقيتُ وَلا عُقوقا",50,"ق",2,0],["فَلا وَأَبيكَ ما في العَيشِ خَيرٌ","وَلا الدُنيا إِذا ذَهَبَ الحَياءُ",51,"ا",2,0],["فلا واللَّهِ ما لل","ه خلقٌ يحتوي علمَهْ",52,"م",2,0],["فلا واللّه لا واللّه","ما أقلع أو أخصي",53,"ي",1,0],["فَلاَوَأَلَ النَّاعِي البَعِيدُ مِنَ الأَذَى","ولاَ أَفْلَتَ القَتْلَ القَرِيبُ المُؤَلِّبُ",54,"ب",1,0],["فَلاَ وأَبِي دَهْمَاءَ زَالَتْ عَزِيزَةً","عَلَى قَوْمِهَا مَا فَتَلَ الزَّنْدَ قَادِحُ",55,"ح",1,0],["فَلا وَأَبيها الخَير ما خُنتُ عَهدَها","وَلا لِيَ عِلمٌ بِالَّذي فَعَلَت بَعدي",56,"د",2,0],["فَلا وأبيكَ يا ابْن أبي عُقَيْلٍ","تبلُّكَ بَعْدَها عِنْدِي بلالِ",57,"ل",1,0],["فَلا وَضَعَت أُنثى إِلَيَّ قِناعَها","وَلا فازَ سَهمي حينَ تَجتَمِعُ السُهُم",58,"م",1,0],["فلا وأبيكَ ما أخْشَى انتِقاضاً","ولا وأبيكَ ما أرْجو ازْديادا",59,"د",2,0],["فَلا وُدُّهَا يَبْقَى وَلا صَفْوُ عَيْشِهَا","يَدُومُ وَلا مَوْعُودُها يَتَحَقَّقُ",60,"ق",1,0],["فَلا وَصْلَ إِلَّا ذُكْرَةٌ تَبْعَثُ الأَسَى","عَلَى النَّفْسِ حَتَّى لا تُطِيق لَهُ رَدَّا",61,"د",2,0],["فَلا وَرَبِّكَ مَا أُصْغِي إِلَى عَذَلٍ","وَلا أُبِيحُ حِمَى قَلْبِي لِخَدَّاعِ",62,"ع",1,0],["فَلاَ وَأَبيكَ ما بينَ وَاسِطٍ","إلى رُكْنِ سَلْعٍ من عَوانٍ ولا بِكرِ",63,"ر",1,1],["فَلا وَأَبي العُشّاقِ ما أَنا عاشِقٌ","إِذا هِيَ لَم تَلعَب بِصَبري المَلاعِبُ",64,"ب",1,0],["فلا وأبيك يا ابن ابي عقيل","يبلُّك بعدها عندي بلال",65,"ل",1,0],["فلا وابيك ما بالدار خل","وقد عصفت شعوب على القطين",66,"ن",1,0],["فلا وأبي بديلة ما أفأنا","من النعم المؤبل من بعير",67,"ر",1,0],["فَلا وَأبِيهِ مَا نَزِلْنَا بِعَامِرٍ","وَلاَ عَامِرٌ حَتَّى الرَّئِيسِ بنِ قَوْقَلِ",68,"ل",1,0],["فلا والهوى ما استَفزَّ الفؤادَ","الطفُ منكِ ولا أعنَف",69,"ف",1,0],["فلا وأبيكَ ما ونَتَ الليالي","تُديف لموطني سُمّاً وصابا",70,"ب",2,0],["فَلاَ وَصْلَ حتّى تَقضِيَ الحَرْ بُأمرَهَا","بمُفْتَرَقٍ، أوْ فَضْلِ عُمْرٍ، فَمُلتَقَى",71,"ق",2,0],["فَلا وَالَّذي يَخدي لَهُ كُلّ مُرتَمٍ","طَليحٍ بِجَنبَي نَخلَةٍ فَالمُحَصَّبِ",72,"ب",1,0],["فَلا وَأَبيكَ لا ظَفرَت قُرَيشٌ","وَلا لَقِيَت رَشاداً إِذ تُشيرُ",73,"ر",1,0],["فَلا وَالراقِصاتِ بِكُلِّ خَرقٍ","إِلى مَعمورِ مَكَّةَ لا نريمُ",74,"م",1,0],["فلا وشا بيَ واشٍ في الهوى أبداً","كلا ولا عذَلتني قط عذالُ",75,"ل",1,0],["فَلا وَاللَهِ رَبِّ النا","سِ مالَكِ عِندَنا ظُلمُ",76,"م",1,0],["فلا وكاء على عينٍ ولا ورقٍ","ولا رِعاء لأزرابٍ وأذوادِ",77,"د",1,0],["فَلا وَهمَ في حِسٍّ وَلا سَهوَ في فِكرِ","بِهِ اجتُثَّ أَصلُ الكافِرينَ وَفَرعُهُم",78,"م",1,0],["فلا وأخذ الله الأحبةَ إِنهم","يهون عليهم ما بنا يفعل الوجدُ",79,"د",1,0],["فلا والله لم تسمعُه أذنٌ","أقول بها جسوراً لا مريبا",80,"ب",2,0],["فلا والله ما صدقوا وإن الن","وى في القلب قد كتبت سيصلى",81,"ل",2,0],["فلا والله ما يثنى عليه","سوى رجلين اما ذو سلامه",82,"م",2,0],["فلا والله لا ادع انتصارا","لديني أو يرى يومي حمامه",82,"م",2,0],["فَلا وَزَرٌ إِلّا القَواضِبُ وَالقَنا","وَإِلّا فَكونوا مِن جُناةِ الطَرائِثِ",83,"ث",1,0],["فلا ودّوا لرأس العزِّ شَجّاً","ولا شَجّوا بدارِ الهُونِ وُدّا",84,"د",2,0],["فَلا وَاللَهِ ما وَجدٌ كَوَجدي","وَلا عُرِفَ اِصطِبارٌ كَاِصطِباري",85,"ر",2,0],["فلا وصل إلا أن يكون تباذُلٌ","ولا بذل إلا أن يكون تَعَانُقُ",86,"ق",1,0],["فَلا وَضَعَت عِندي حَصانٌ خِمارَها","وَلا ظَفِرَت كَفّي بِقَرنٍ أُنازِلُه",87,"ل",2,0],["فلا وجلالِ اللهِ ما بِتُّ وادِعاً","ولا ساغ لي مذ صحَّ شَكْوُك رِيقي",88,"ق",2,0],["فَلا وَجَدَت أَيدي الحَوادِثِ وَالعِدى","لِما عَقَدَت نَعماؤُهُ بَينَهُم حَلّا",89,"ل",2,0],["فَلا وَنَتِ البَشائِرُ وَالتَهاني","إِلى أَبوابِها تُزجي الرَكائِب",90,"ب",1,0],["فَلا وَصلُها يَبدو فَتَبلى بِلا بِلى","وَلا ليَ صَبرٌ مُنجِدٌ فأخونُها",91,"ن",3,1],["فَلا وَأَبِينا ما أَبَيْنا كَضيفِهِ","تَنَاوُلَهُ بَلْ سابَقَ الرّاحةَ الزَّندُ",92,"د",1,0],["فلا واللهِ لا أَنساه يوماً","بقربٍ منه أَسعدني اللقاءُ",93,"ا",2,0],["فَلا وُجودٌ سِوى وُجودي","وَكُلُّ باقٍ سِواهُ فانِ",94,"ن",1,0],["فَلا وَالحُبِّ لَيسَ هُناكَ مِنهُ","فَتىً لَم يَقضِ فيهِ ما قَضَينا",95,"ن",2,0],["فلا والّذي حَجَّ المُلَبّونَ بَيْتَه","على ناجِياتٍ سَيْرُهُنَّ ذَميل",96,"ل",1,0],["فلا وأَبيكَ أَخشَى الدَّهرَ قِرْناً","ولكنّي أُنازِلُه نِزالا",97,"ل",2,0],["فلا وصْلَ إلا أن تُقِصّرَ دونه","طِوالُ اللّيالي والقنا والسباسب",98,"ب",1,0],["فَلا وَطَرٌ غَيرُ الصِبا كَيفَ بِالصِبا","وَلا وَطَنٌ غَيرُ الحِمى سُقِيَ الحِمى",99,"م",2,0],["فَلا وَاللَهِ لا نَظَرَت سِواكُمُ","وَإِن فاضَت لِعَتبِكُمُ دِماءَ",100,"ا",2,0],["فَلا وَهَتها قَناةٌ لا وَلا قَلَمٌ","فيها فَتِلكَ يَدٌ حَمّالَةُ الحَطَبِ",101,"ب",1,0],["فلا وردُه يصفو بمصدره ولا","حقيقتُه تحلو فتؤذنَ بالرَشف",102,"ف",1,0],["فَلا وَصل إِلّا بِالأَماني يُرتَجى","وَلا طَيف إِلّا بِالتَوَهُم يَستَدني",103,"ن",2,0],["فَلا وَأَبي لَم أَدرِ وَرد بِخَدِهِ","بِهيٌّ جَنيٌّ أَم شَقائق نُعمان",104,"ن",1,0],["فَلا وَعَينيكَ مالي مِن هَواك سِوى ال","سقام وَالسهد وَالأَفكار وَالحُزن",105,"ن",1,0],["فَلا وَالدُجى وَالبيد وَالعيس وَالسَرى","وَما قَد أُقاسي لَيسَ ذَلِكَ مِن شَأني",106,"ن",2,0],["فلا وأبيك آسى بعد بشرٍ","على حيٍّ يموت ولا صديقِ",107,"ق",1,0],["فلا وجدَ إلا وهو عندي مخيّمٌ","ولا صبْرَ إلا وهْو عنيَ شاردُ",108,"د",1,0],["فلا وربك لا لن يؤمنوا أبد","حتى تراهم بحكم الله راضينا",109,"ن",2,0],["فلا وشي من بعد بزازه","ولا عطر من بعد عطّارهِ",110,"ر",2,0],["فلا وعينيها وأردافها","وشِقوةِ الدِّعصِ بها والغزالْ",111,"ل",1,0],["فلا وأبي المجد ما ضرني","حياً قاطعٌ وهُوَ الواصلُ",112,"ل",1,0],["فلا وَنتْ تطرقكم في النوى","فتائلٌ أبرمها الضافرُ",113,"ر",1,0],["فلا وشَقاوتِهِ ما يَشُقُّ","على البدر أن تَنبحَ الأكلُبُ",114,"ب",1,0],["فلا وضَحَ النهارُ ولستَ شمساً","ولا أَزرَى بمَطلعِكَ المغيبُ",115,"ب",1,0],["فَلا وَاللَهِ نادى الحَيُّ ضَيفي","هُدوءاً بِالمَساءَةِ وَالعِلاطِ",116,"ط",1,0],["فلأوسِعَنَّ زمانَه وأوانَه","مدحاً يكِلُّ له لسانُ المادحِ",117,"ح",1,0],["فَلاَ وَحَقِّكَ ما أَنْفَكُّ آوِنَةً","مِنْ مُشْكِلٍ قَطُّ إلاّ قَامَ إشْكالُ",118,"ل",1,1],["فلا واللهِ أشربُها حياتي","ولا أسقي بها أبداً نديما",119,"م",2,0],["فَلا وصلُك مَوصولٌ","ولا هجرُك هِجرانُ",120,"ن",1,0],["فلا وَصْلَ إلّا ما تقرِّبُ بيننا","أكاذيبُ من أحلامنا وتؤلّفُ",121,"ف",1,0],["فَلا وَرَدتْ ماءً زُلالاً مشافرٌ","وَلا حُبِيتْ مِنكمْ بخيرٍ معاطسُ",122,"س",1,0],["فَلا وَجدَ حَتّى تَنزُفَ العَينُ ماءَها","وَتَعتَرِفَ الأَحشاءُ بِالخَفَقانِ",123,"ن",1,0],["فلا وضع شرع لها ثابت","لينوي به قرب إيصالها",124,"ل",3,0],["فَلا ولَماهُ العَذْبُ لا كُنْتُ ناقِضاً","عُهُودَ هَواهُ لا ولا ناسِياً قَطُّ",125,"ط",1,0],["فَلا وَأَبيكِ لا يَنجو نَجائي","غَداةَ لَقيتُهُم بَعضُ الرِجالِ",126,"ل",1,0],["فلا وا ما باليت وجدي","ولا شفقي عليك ولا اشتياقي",127,"ق",2,0],["فَلا وَأَبي لا تَأكُلُ الطَيرُ مِثلَهُ","طَويلَ النِجادِ غَيرَ هارٍ وَلا هَشمِ",128,"م",1,0],["فَلا وَأَبيكِ الخَيرَ لا تَجِدينَهُ","جَميلَ الغِنى وَلا صَبوراً عَلى العُدمِ",129,"م",1,0],["فَلا وَأَبيكِ ما طَلَعوا لِشَرٍّ","وَهُم يُزجونَ في غُرقٍ بَعيرا",130,"ر",2,0],["فلا وأبيك لا تكفي سهيلا","بجمع إن جمعت ولا بحشر",131,"ر",1,0],["فَلا وَأَبي مَآبُ لَنَأتِيَنها","وَإِن كانَت بِها عَرَبٌ وَرومُ",132,"م",1,0],["فَلا وَأَبيكِ ما يَنفَكُّ مِنّا","مِنَ الساداتِ حَظٌّ ما بَقينا",133,"ن",2,0],["فلا وأبيك خيرٌ منك إنّي","ليؤذيني التّحمحم والصّهيل",134,"ل",1,0],["فلا والله أشربها حياتي","ولا أدعو لها أبداً نديما",135,"م",2,0],["فلا وأبيكَ ما باليْتَ وجْدي","ولا شوقي الشديد ولا اكتئابي",136,"ب",2,0],["فَلا وَجدَ إِلّا مِثلَ يَومِ تَلاحَقَت","بِنا العيسُ وَالحادي يِشُلُّ وَيَعنُفُ",137,"ف",1,0],["فلا وأبيك لا ننفك نبكي","على قتلى هنالك ما بقينا",138,"ن",2,0],["فَلا وَأَبيكَ لا أَنسى خَليلي","بِبَدوَةَ ما تَحَرَّكَتِ الرِياحُ",139,"ح",1,0],["فَلا وأَبيكُما سَيفِ بنُ عَمرٍو","كَريمِ الخَيمِ عَمرٍو ذي كُبارِ",140,"ر",1,1]]}