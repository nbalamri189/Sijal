ww.aldiwan.net/poem48756.html","الطويل"],[380,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[380,"ملكت قلبي ولم أملكه يا سكني","https://www.aldiwan.net/poem48816.html","البسيط"],[380,"أطاعك قلبي جاهدا فعصيته","https://www.aldiwan.net/poem49246.html","الطويل"],[428,"أعاذلتي على رزءٍ أفيقي","https://www.aldiwan.net/poem764.html",""],[432,"أما إنه لولا الخيال المعاود","https://www.aldiwan.net/poem12609.html","الطويل"],[449,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[452,"ألا مرحبا باقتبال الربيع","https://www.aldiwan.net/poem13766.html","المتقارب"],[458,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[458,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[458,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[458,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[458,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[475,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[477,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[529,"فلا وحقك ما أنفك آونة","https://www.aldiwan.net/poem37262.html","البسيط"],[537,"رأيت الخمر صالحة وفيها","https://www.aldiwan.net/poem69373.html","الوافر"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[551,"نأينا فمن دون اللقاء تنائف","https://www.aldiwan.net/poem47401.html","الطويل"],[551,"أجيرتنا لا جمع الله شملنا","https://www.aldiwan.net/poem47753.html","الطويل"],[553,"بكاء وكأس كيف يتفقان","https://www.aldiwan.net/poem68248.html","الطويل"],[558,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[586,"خليلي هل من حلمل لي تحية","https://www.aldiwan.net/poem17581.html","الطويل"]],"verses":[["فَلا وَاللَهِ أَترُكُها خَليّاً","وَلَمّا أَجنُبِ الأُسدَ الغِضابا",0,"ب",2,0],["فلا وصْلَ حتّى يَذْرَعَ العِيسُ مَهْمَهاً","إذا الجِنُّ غَنّتْنا بهِ رَقَصَ الآلُ",1,"ل",1,0],["فَلا وَالَّذي مَسَّحتُ أَركانَ بَيتِهِ","أَطوفُ بِهِ فيمَن يَطوفُ وَيَحصِبُ",2,"ب",1,0],["فَلا وَأَبيكَ لا نُعطيكَ مِنها","طِوالَ حَياتِنا إِلّا سِنانا",3,"ن",2,0],["فَلا وَزَرٌ مَن بَأسِهِ لِعُداتِهِ","وَلَو وَقَلَت كَالعُصمِ في شامِخٍ وَعرِ",4,"ر",1,0],["فَلا وَاللَهِ لا أَنساكَ حَتّى","أُفارِقَ مُهجَتي وَيُشَقُّ رَمسي",5,"ي",1,0],["فَلا وَأَبيكَ ما سَلَّيتُ صَدري","بِفاحِشَةٍ أَتَيتَ وَلا عُقوقِ",6,"ق",1,0],["فَلا وَصلَ إِلاّ أَن تُقارِبَ بَينَنا","قَلائِصُ تَجسُرنَ الفَلاةَ بِنا جَسرا",7,"ر",2,1],["فَلا وَأَبيكَ ما لاقَيتُ حَيّاً","كَيَربوعٍ إِذا رَفَعوا العُقابا",8,"ب",2,0],["فَلا وَأَبيكَ ما حَيٌّ كَحَيٍّ","لِجارٍ حَلَّ فيهِم أَو عَديمِ",9,"م",1,0],["فَلا وَأَبيكَ ما يَظَلُّ اِبنُ جارَتي","يَطوفُ حَوالَي قِدرِنا ما يَطورُها",10,"ر",3,0],["فَلا وَأَبي ما ساعِدانِ كَساعِدٍ","وَلا وَأَبي ما سَيِّدانِ كَسَيِّدِ",11,"د",1,0],["فَلا وَاللَهِ ما تَدري مَعيصٌ","أَسَهلٌ بَطنُ مَكَّةَ أَم يَفاعُ",12,"ع",1,1],["فَلا وَقرٌ بِسَمعِكَ حينَ تُدعى","ضُحىً إِذ لا تُجيبُ وَلا تُعينُ",13,"ن",1,0],["فَلا وَأَخيكَ الكَريمِ الَّذي","بِهِ لا تُرى أَبَداً تُعتَلُ",14,"ل",1,0],["فلا وقايةَ تحمِي وفدَ راحته","بلى على عرضهِ الأنقى وقايات",15,"ت",1,0],["فلا وَوَقتٍ كانَ للشعر لا","يجمعنا من بعد ذا سقفُ بيت",16,"ت",1,0],["فلا وزر","ولا مفر",17,"ر",1,0],["فلا والله ما أجدى","وراحَ الطول في العرض",18,"ض",1,0],["فلا وحماكَ الرَّحم لا بتّ مهدياً","حقائق أمداحِي لغير حماكا",19,"ك",2,0],["فلا واصلاً حبلاً لمن هو قاطعٌ","ولا قاطعاً حبلاً لمن هو واصل",20,"ل",1,0],["فلا وألتْ هنالكَ نَفْس سُوءٍ","عليها يا سُلَيْمُ تُحاذرينا",21,"ن",2,0],["فَلا وَأَبيكَ ما يَسطيعُ قَومٌ","إِذا لَم يَأخُذوا مِنّا حِبالا",22,"ل",2,0],["فَلا وَأَبي هَوازِنَ ما جَزِعنا","وَلا هَمَّ الظَعائِنُ بِاِنحِيازِ",23,"ز",1,0],["فَلا وَأَبيكَ لَو أَمكَنتَ قَومي","لَظَلَّ عَلى جَناجِنِكَ النِسارُ",24,"ر",1,0],["فَلا وَأَلَت تِلكَ النُفوسُ وَلا أَتَت","عَلى رَوضَةِ الأَجدادِ وَهِيَ جَميعُ",25,"ع",1,0],["فَلا وَاللَهِ مايَح","سُنُ بَينَ الناسِ ذِكراها",26,"ا",3,0],["فَلا وَاللَهِ ماحاوَلتَ عُذراً","فَكُلُّ الناسِ يُعذَرُ ما خَلاكا",27,"ك",2,0],["فَلا وَجهَ إِن أَقبَلَت","وَلا رِدفَ إِن وَلَّتِ",28,"ت",1,0],["فَلا وَصلَ إِلّا أَن يُطيفَ خَيالُها","بِنا تَحتَ جُؤشوشٍ مِنَ اللَيلِ أَسفَعِ",29,"ع",1,0],["فَلا وَصلَ حَتّى تَقضِيَ الحَربُ أَمرَها","بِمُفتَرَقٍ أَو فَضلِ عُمرٍ فَمُلتَق",30,"ق",1,0],["فَلا وَصلَ إِلّا أَن تُجَدِّدَ خُلَّةً","وَلا أُنسَ إِلّا أَن يَكونَ بَديلُ",31,"ل",1,0],["فَلا وَأَبيكِ ما ضَيَّعتُ حِلماً","وَلا قارَفتُ في حُبّيكِ ذاما",32,"م",2,0],["فَلا وَأَبي لَما أَخشى وَرائي","مِنَ الأَحداثِ وَالفَزَعِ الكَبيرِ",33,"ر",1,0],["فَلا وَالَّذي تَلقى خُزَيمَةُ مِنهُمُ","بَني أُمِّ بَذّاخينَ غَيرِ عَقيمِ",34,"م",1,0],["فَلا وَأَبيكَ الكَلبِ ما مِن مَخافَةٍ","إِلى الشَأمِ أَدّوا خالِداً لَم يُسالِمِ",35,"م",1,0],["فَلأُوضِحَنَّ صَبابتي","بالدَّمعِ في الدِّمَنِ الدَّواثِر",36,"ر",1,0],["فَلا وَاللَهِ لا أَصفو لِخِلٍّ","سَجِيَّتُهُ التَعَتُّبُ وَالنِفارُ",37,"ر",1,0],["فَلا وَصلَ إلّا بَينَ أسمائنا الّتي","تسافرُ منّا في مُعَنْوَنَةِ الكتبِ",38,"ب",1,0],["فَلا وَاللَهِ ما في العَيشِ خَيرٌ","وَلا الدُنيا إِذا ذَهَبَ الحَياءُ",39,"ا",2,0],["فَلا وَأَبيكَ ما صَوتَ الغَواني","وَلا شُربَ الَّتي هِيَ كَالفُصوصِ",40,"ص",1,1],["فَلا وَصلٌ يُبَرِّدُ نارَ قَلبي","وَلا صَبرٌ وَمَن يَجِدِ اِصطِبارِ",41,"ر",1,0],["فَلا وَصلَ إِلّا أَن يُقارِبَ بَينَنا","قَلائِصُ في أَذنابِهِنَّ صَفاءُ",42,"ا",2,0],["فَلا وَأَبيكَ نُقِرُّ الأَذى","وَنَرضى الهَوانَ وَنَلقى الضَرَرْ",43,"ر",1,0],["فَلا وَأَبيكَ ما نَزَلنا بِعامِرٍ","وَلا عامِرٍ وَلا الرَئيسِ اِبنِ قَوقَلِ",44,"ل",1,0],["فَلا وَأَبيكَ ما ظَلَمَت قُرَيعٌ","بِأَن يَبنوا المَكارِمَ حَيثُ شاؤوا",45,"ا",1,0],["فَلا وَأَبيكَ ما ظَلَمَت قُرَيعٌ","وَلا بَرِموا لِذاكَ وَلا أَساؤوا",45,"ا",1,0],["فَلا وَاللَهِ لا تَبرَ","حُ حَتّى يُبرَمَ الأَمرُ",46,"ر",1,0],["فَلا وَصلَ إِلّا عَبرَةً تَستَديمُها","أَحاديثُ نَفسٍ مالَها الدَهرَ ذاكِرُ",47,"ر",1,0],["فَلا وَأَبيكُمُ ما الفَضلُ دَأبي","إِذا ما لَم أَجِد مِنكُم صَديقا",48,"ق",2,0],["فَلا وَاللَهِ أَذخَرُكُم هِجاءً","وَشَتماً ما بَقيتُ وَلا عُقوقا",48,"ق",2,0],["فَلا وَأَبيكَ ما في العَيشِ خَيرٌ","وَلا الدُنيا إِذا ذَهَبَ الحَياءُ",49,"ا",2,0],["فلا واللَّهِ ما لل","ه خلقٌ يحتوي علمَهْ",50,"م",2,0],["فَلا وَأَبيها الخَير ما خُنتُ عَهدَها","وَلا لِيَ عِلمٌ بِالَّذي فَعَلَت بَعدي",51,"ي",1,0],["فَلا وأبيكَ يا ابْن أبي عُقَيْلٍ","تبلُّكَ بَعْدَها عِنْدِي بلالِ",52,"ل",1,0],["فَلا وَضَعَت أُنثى إِلَيَّ قِناعَها","وَلا فازَ سَهمي حينَ تَجتَمِعُ السُهُم",53,"م",1,0],["فلا وأبيكَ ما أخْشَى انتِقاضاً","ولا وأبيكَ ما أرْجو ازْديادا",54,"د",2,0],["فَلا وُدُّهَا يَبْقَى وَلا صَفْوُ عَيْشِهَا","يَدُومُ وَلا مَوْعُودُها يَتَحَقَّقُ",55,"ق",1,0],["فَلا وَصْلَ إِلَّا ذُكْرَةٌ تَبْعَثُ الأَسَى","عَلَى النَّفْسِ حَتَّى لا تُطِيق لَهُ رَدَّا",56,"د",2,0],["فَلا وَرَبِّكَ مَا أُصْغِي إِلَى عَذَلٍ","وَلا أُبِيحُ حِمَى قَلْبِي لِخَدَّاعِ",57,"ع",1,0],["فَلاَ وَأَبيكَ ما بينَ وَاسِطٍ","إلى رُكْنِ سَلْعٍ من عَوانٍ ولا بِكرِ",58,"ر",1,1],["فَلا وَأَبي العُشّاقِ ما أَنا عاشِقٌ","إِذا هِيَ لَم تَلعَب بِصَبري المَلاعِبُ",59,"ب",1,0],["فلا وأبيك يا ابن ابي عقيل","يبلُّك بعدها عندي بلال",60,"ل",1,0],["فلا وأبي بديلة ما أفأنا","من النعم المؤبل من بعير",61,"ر",1,0],["فَلا وَأبِيهِ مَا نَزِلْنَا بِعَامِرٍ","وَلاَ عَامِرٌ حَتَّى الرَّئِيسِ بنِ قَوْقَلِ",62,"ل",1,0],["فلا والهوى ما استَفزَّ الفؤادَ","الطفُ منكِ ولا أعنَف",63,"ف",1,0],["فلا وأبيكَ ما ونَتَ الليالي","تُديف لموطني سُمّاً وصابا",64,"ب",2,0],["فَلاَ وَصْلَ حتّى تَقضِيَ الحَرْ بُأمرَهَا","بمُفْتَرَقٍ، أوْ فَضْلِ عُمْرٍ، فَمُلتَقَى",65,"ق",2,0],["فلاَ وَ أبي أميمة َ ما أبوها","مَنَ النَّعَمِ المُؤَثَّلِ وَالْجَزُورِ",66,"ر",1,0],["فَلا وَالَّذي يَخدي لَهُ كُلّ مُرتَمٍ","طَليحٍ بِجَنبَي نَخلَةٍ فَالمُحَصَّبِ",67,"ب",1,0],["فَلا وَأَبيكَ لا ظَفرَت قُرَيشٌ","وَلا لَقِيَت رَشاداً إِذ تُشيرُ",68,"ر",1,0],["فَلا وَالراقِصاتِ بِكُلِّ خَرقٍ","إِلى مَعمورِ مَكَّةَ لا نريمُ",69,"م",1,0],["فلا وشا بيَ واشٍ في الهوى أبداً","كلا ولا عذَلتني قط عذالُ",70,"ل",1,0],["فَلا وَاللَهِ رَبِّ النا","سِ مالَكِ عِندَنا ظُلمُ",71,"م",1,0],["فلا وكاء على عينٍ ولا ورقٍ","ولا رِعاء لأزرابٍ وأذوادِ",72,"د",1,0],["فَلا وَهمَ في حِسٍّ وَلا سَهوَ في فِكرِ","بِهِ اجتُثَّ أَصلُ الكافِرينَ وَفَرعُهُم",73,"م",1,0],["فلا وأخذ الله الأحبةَ إِنهم","يهون عليهم ما بنا يفعل الوجدُ",74,"د",1,0],["فلا والله لم تسمعُه أذنٌ","أقول بها جسوراً لا مريبا",75,"ب",2,0],["فلا والله ما صدقوا وإن الن","وى في القلب قد كتبت سيصلى",76,"ل",2,0],["فلا والله ما يثنى عليه","سوى رجلين اما ذو سلامه",77,"م",2,0],["فلا والله لا ادع انتصارا","لديني أو يرى يومي حمامه",77,"م",2,0],["فَلا وَزَرٌ إِلّا القَواضِبُ وَالقَنا","وَإِلّا فَكونوا مِن جُناةِ الطَرائِثِ",78,"ث",1,0],["فلا ودّوا لرأس العزِّ شَجّاً","ولا شَجّوا بدارِ الهُونِ وُدّا",79,"د",2,0],["فَلا وَاللَهِ ما وَجدٌ كَوَجدي","وَلا عُرِفَ اِصطِبارٌ كَاِصطِباري",80,"ر",2,0],["فلا وصل إلا أن يكون تباذُلٌ","ولا بذل إلا أن يكون تَعَانُقُ",81,"ق",1,0],["فَلا وَضَعَت عِندي حَصانٌ خِمارَها","وَلا ظَفِرَت كَفّي بِقَرنٍ أُنازِلُه",82,"ل",2,0],["فلا وجلالِ اللهِ ما بِتُّ وادِعاً","ولا ساغ لي مذ صحَّ شَكْوُك رِيقي",83,"ي",1,0],["فَلا وَجَدَت أَيدي الحَوادِثِ وَالعِدى","لِما عَقَدَت نَعماؤُهُ بَينَهُم حَلّا",84,"ل",2,0],["فَلا وَنَتِ البَشائِرُ وَالتَهاني","إِلى أَبوابِها تُزجي الرَكائِب",85,"ب",1,0],["فَلا وَصلُها يَبدو فَتَبلى بِلا بِلى","وَلا ليَ صَبرٌ مُنجِدٌ فأخونُها",86,"ن",3,1],["فَلا وَأَبِينا ما أَبَيْنا كَضيفِهِ","تَنَاوُلَهُ بَلْ سابَقَ الرّاحةَ الزَّندُ",87,"د",1,0],["فلا واللهِ لا أَنساه يوماً","بقربٍ منه أَسعدني اللقاءُ",88,"ا",2,0],["فَلا وُجودٌ سِوى وُجودي","وَكُلُّ باقٍ سِواهُ فانِ",89,"ن",1,0],["فَلا وَالحُبِّ لَيسَ هُناكَ مِنهُ","فَتىً لَم يَقضِ فيهِ ما قَضَينا",90,"ن",2,0],["فلا والّذي حَجَّ المُلَبّونَ بَيْتَه","على ناجِياتٍ سَيْرُهُنَّ ذَميل",91,"ل",1,0],["فلا وأَبيكَ أَخشَى الدَّهرَ قِرْناً","ولكنّي أُنازِلُه نِزالا",92,"ل",2,0],["فلا وصْلَ إلا أن تُقِصّرَ دونه","طِوالُ اللّيالي والقنا والسباسب",93,"ب",1,0],["فَلا وَطَرٌ غَيرُ الصِبا كَيفَ بِالصِبا","وَلا وَطَنٌ غَيرُ الحِمى سُقِيَ الحِمى",94,"م",2,0],["فَلا وَاللَهِ لا نَظَرَت سِواكُمُ","وَإِن فاضَت لِعَتبِكُمُ دِماءَ",95,"ا",2,0],["فَلا وَهَتها قَناةٌ لا وَلا قَلَمٌ","فيها فَتِلكَ يَدٌ حَمّالَةُ الحَطَبِ",96,"ب",1,0],["فلا وردُه يصفو بمصدره ولا","حقيقتُه تحلو فتؤذنَ بالرَشف",97,"ف",1,0],["فَلا وَصل إِلّا بِالأَماني يُرتَجى","وَلا طَيف إِلّا بِالتَوَهُم يَستَدني",98,"ن",2,0],["فَلا وَأَبي لَم أَدرِ وَرد بِخَدِهِ","بِهيٌّ جَنيٌّ أَم شَقائق نُعمان",99,"ن",1,0],["فَلا وَعَينيكَ مالي مِن هَواك سِوى ال","سقام وَالسهد وَالأَفكار وَالحُزن",100,"ن",1,0],["فَلا وَالدُجى وَالبيد وَالعيس وَالسَرى","وَما قَد أُقاسي لَيسَ ذَلِكَ مِن شَأني",101,"ي",1,0],["فلا وأبيك آسى بعد بشرٍ","على حيٍّ يموت ولا صديقِ",102,"ق",1,0],["فلا وجدَ إلا وهو عندي مخيّمٌ","ولا صبْرَ إلا وهْو عنيَ شاردُ",103,"د",1,0],["فلا وربك لا لن يؤمنوا أبد","حتى تراهم بحكم الله راضينا",104,"ن",2,0],["فلا وشي من بعد بزازه","ولا عطر من بعد عطّارهِ",105,"ر",2,0],["فلا وعينيها وأردافها","وشِقوةِ الدِّعصِ بها والغزالْ",106,"ل",1,0],["فلا وأبي المجد ما ضرني","حياً قاطعٌ وهُوَ الواصلُ",107,"ل",1,0],["فلا وَنتْ تطرقكم في النوى","فتائلٌ أبرمها الضافرُ",108,"ر",1,0],["فلا وشَقاوتِهِ ما يَشُقُّ","على البدر أن تَنبحَ الأكلُبُ",109,"ب",1,0],["فلا وضَحَ النهارُ ولستَ شمساً","ولا أَزرَى بمَطلعِكَ المغيبُ",110,"ب",1,0],["فَلا وَاللَهِ نادى الحَيُّ ضَيفي","هُدوءاً بِالمَساءَةِ وَالعِلاطِ",111,"ط",1,0],["فلأوسِعَنَّ زمانَه وأوانَه","مدحاً يكِلُّ له لسانُ المادحِ",112,"ح",1,0],["فَلاَ وَحَقِّكَ ما أَنْفَكُّ آوِنَةً","مِنْ مُشْكِلٍ قَطُّ إلاّ قَامَ إشْكالُ",113,"ل",1,1],["فلا واللهِ أشربُها حياتي","ولا أسقي بها أبداً نديما",114,"م",2,0],["فَلا وصلُك مَوصولٌ","ولا هجرُك هِجرانُ",115,"ن",1,0],["فلا وَصْلَ إلّا ما تقرِّبُ بيننا","أكاذيبُ من أحلامنا وتؤلّفُ",116,"ف",1,0],["فَلا وَرَدتْ ماءً زُلالاً مشافرٌ","وَلا حُبِيتْ مِنكمْ بخيرٍ معاطسُ",117,"س",1,0],["فَلا وَجدَ حَتّى تَنزُفَ العَينُ ماءَها","وَتَعتَرِفَ الأَحشاءُ بِالخَفَقانِ",118,"ن",1,0],["فلا وضع شرع لها ثابت","لينوي به قرب إيصالها",119,"ل",3,0],["فَلا ولَماهُ العَذْبُ لا كُنْتُ ناقِضاً","عُهُودَ هَواهُ لا ولا ناسِياً قَطُّ",120,"ط",1,0]]}