{"poems":[[55,"قال لي عند ملتقى الركب عمرو","https://www.aldiwan.net/poem30670.html","الخفيف"],[79,"ما أوبق الأنفس إلا الأمل","https://www.aldiwan.net/poem36351.html","الرجز"],[88,"أين يوم القنال يا ربة التاج","https://www.aldiwan.net/poem10696.html","الخفيف"],[74,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[74,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[53,"لهف نفسي على رصاص مذاب","https://www.aldiwan.net/poem8508.html","الخفيف"],[45,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[47,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[99,"أيها الغائب العزيز النائي","https://www.aldiwan.net/poem24917.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55188","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[47,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[53,"لهفَ نفسي على رَصاصٍ مُذاب","https://www.poetsgate.com/ViewPoem.aspx?id=27019",""],[228,"كنت بالأمس ربة العاشقينا","https://www.aldiwan.net/poem41911.html","الخفيف"],[234,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[295,"لا تلم أن هجرت أيام أنسى","https://www.aldiwan.net/poem11670.html","الخفيف"],[422,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[422,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[438,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[453,"غيبوا في الترب عني شخصها","https://www.aldiwan.net/poem53734.html","الكامل"],[463,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[534,"اسم الذي تيمني","https://www.aldiwan.net/poem37506.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122699","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216939","الخفيف"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101991","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141287","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126640","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53177","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53061","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77301","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2350,"","https://poetry.dctabudhabi.ae/diwan/poem/147620","الخفيف"],[2629,"","https://poetry.dctabudhabi.ae/diwan/poem/121124","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100884","الخفيف"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121142","الرمل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109778","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108383",""],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132062","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40065","الرمل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105563","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101395","الخفيف"],[5121,"عُصْفُورُ الْجَنَّة","https://www.poetsgate.com/ViewPoem.aspx?id=49543",""],[5186,"يا هنائي ساعة اللقيا وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156511",""],[5302,"عهد الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=201740",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5409,"أين ذاك الوادي الذي كان بال","https://www.poetsgate.com/ViewPoem.aspx?id=155315",""],[5510,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=206114",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5621,"كيفَ تمضي","https://www.poetsgate.com/ViewPoem.aspx?id=24563",""],[5674,"زرقاء اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=186794",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""],[463,"سألتْ ظبية ُ ما هذا النحولُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60274&r=&rc=330",""]],"verses":[["أَينَ ذاكَ الصَبا وَأَينَ التَصابي","سَبَقا الطالِبَ المُجِدِّ وَفاتا",0,"ت",2,0],["أَيْنَ ذَوُوا الرَّاحَاتِ زَادَتْ حَسْرَةً","إِذْ جُنِّبُوا إِلَى الثَّرَى وَانْتَقَلُوا",1,"ل",3,0],["أَينَ ذا القَصرُ بِالجَزيرَةِ تَجري","فيهِ أَرزاقُنا وَتَحبو الأَماني",2,"ن",2,0],["أين ذاك الغمام يدنو إلى النا","سِ ندى كفّه ويعلو مناله",3,"ل",2,0],["أينَ ذاك الذهن الذي قد ورثنا","عنه ما في الحشا من الإشعال",4,"ل",1,0],["أينَ ذاك البحث الذي يحرس الحف","ل على غير أهبةٍ واحْتفال",4,"ل",1,0],["أين ذاك العتُوُّ منك وذاك ال","عَيْثُ قل لي يا أخيبَ الخُيّابِ",5,"ب",1,0],["أَينَ ذي الرِقَّةُ الَّتي لَكَ في الحَر","بِ إِذا اِستُكرِهَ الحَديدُ وَصَلّا",6,"ل",2,0],["أَينَ ذاكَ الظَريفُ أَعني اِبنَ هاني","حَسَناً وَيبَهُ نَديمَ المُلوكِ",7,"ك",1,0],["أين ذاك الوجهُ الذي يُرسلُ النو","رَ ويُوحِي إشراقُه بالصَّفاء",8,"ا",2,0],["أَينَ ذاكَ النضال عن حرم العل","مِ وَتلك النبال تلك النصول",9,"ل",1,0],["أَينَ ذاكَ الشعر الرقيق المنقى","أَين ذاكَ النثر النفيس الجَميل",9,"ل",1,0],["أَيْنَ ذَاكَ القَلْبُ الخَلِيُّ وَساعَا","تٌ مِنَ الأُنْسِ صِرنَ جِدَّ خَوَالِي",10,"ل",2,0],["أَيْنَ ذَاكَ الخَيَالُ كَانَ بِلاَ قَيْدٍ","فَأضْحى نَظْماً بِغَيرِ خَيالِ",10,"ل",1,0],["أَيْنَ ذَاكَ البَهَاءُ وَالطَّلْعَةُ الْغَرَّا","ءُ وَالرَّوْنَقُ الَّذِي لاَ يَحُولُ",11,"ل",1,0],["أَيْنَ ذَاكَ البَيَانُ يَأْخُذُ بِالأَلْبَ","ابِ فِيمَا تَجْلِينَ أَوْ تَصِفِينَا",12,"ن",2,0],["أَيْنَ ذَاكَ الصَّوْتُ الَّذِي يَمْلِكً الأَسْ","مَاعَ فِي كُلِّ مَوْقِفٍ تَقِفِينَا",12,"ن",2,0],["أَيْنَ ذَاكَ العَهْدُ الجَمِيلُ تَقَضَّى","غَيْرَ مُبْقٍ سِوَ شَجىً وَشُجُونِ",13,"ن",1,0],["أَيْنَ ذَاكَ الَّذي تَطَوَّعَ قِدْماً","غَيْرَ هَيَّابَةٍ وَلاَ رِعْدِيدِ",14,"د",1,0],["أَيْنَ ذَاكَ الْبَهَاءُ يُجْرِي عَلَى مَا","حَوْلَهُ بَهْجَةً وَيُلْقِي بَهَاءَ",15,"ا",2,0],["أَيْنَ ذَاكَ السَّخَاءُ يَكْفِي الْيَتَامَى","وَالأَيَامَى ويَنْصُرُ الضُّعَفَاءَ",15,"ا",2,0],["أَيْنَ ذَاكَ الْحَيَاءُ عَنْ عِزَّةٍ لاَ","عَنْ تَعَالٍ وَحَيِّ ذَاك حَيَاءَ",15,"ا",2,0],["أين ذاك الهيامُ في أول الحبْ","بِ، وتلك الموشّحاتُ النواعم؟...",16,"م",1,0],["أَينَ ذو النَعيمِ وَذو","بُؤسِها اِبنِ مُنذِرِها",17,"ر",3,0],["أين ذاكَ الْجَبِينُ ينضَحُ نُوراً","أين ذاكَ الْحَدِيثُ يَقْطُر شَهْدا",18,"د",2,0],["أين ذاكَ الخلق المسيحَ كأن لم","يكُ بالأمسِ يملأ الأرضَ حُسنَا",19,"ن",2,0],["أينَ ذاكَ الصدر الذي يحملُ الع","بءَ عظيماًن وليس يحملُ ضِغْنَا",19,"ن",2,0],["أَيْنَ ذَاكَ الشعْرُ الذي كُنْتَ تزْجِيهِ","فَيَسْرِي في الأرضِ عَرْضاً وطُولا",20,"ل",2,0],["أين ذوو الغيرة من لي بهم","قد حزب الأمر قد انقد السلا",21,"ا",1,0],["أَيْنَ ذَاكَ الظَّرِيفُ ،أَغْنِي ابْنَ هانِي","حَسناً ، وَبْيَهُ نَدِيمَ المُلُوكِ",22,"ك",1,0],["أين ذاك العتُوُّ منك وذاك ال","غَيْثُ قل لي يا أخيبَ الخُيّابِ",23,"ب",1,0],["أَينَ ذاكَ الجَمالُ أَين جَبينٌ","ما أَرانا من قَبلُ هذه الغُضونا",24,"ن",2,0],["أين ذاك السلطانُ والملكُ والمَنْ","عةُ والبطشُ والعلا والظهور",25,"ر",1,0],["أين ذاك الطبعُ السليمُ وذاك ال","خُلُقُ العذْبُ والسَّنَا والنور",25,"ر",1,0],["أين ذاك البِشرُ الذي كان يبدو","مِنْ سَناه للناظرين البشير",25,"ر",1,0],["اين ذاك الثراء والجاه والملك","وأين الأسطول في البحر يرسي",26,"س",2,0],["أينَ ذاك الهوى وكيف تقضّى","كانَ خمراً فما له صار خلاّ",27,"ل",2,0],["أين ذاك العهد في ذاك الحمى","والوجوه الغر في تلك الخيام",28,"م",1,0],["أينَ ذاكَ الكِناسُ يفتِكُ منهُ","عبثاً بالأُسودِ ذاك الريمُ",29,"م",1,0],["أين ذاك اللطف من هذا الجفا","لم ترد ذلك لو تعطى مناها",30,"ا",3,0],["أين ذاك الظاهرُ المالىء لل","عين والمختَرَطُ الرطبُ الصقيلُ",31,"ل",1,0],["أيْنَ ذَكِيٌّ ماهِرٌ","يُقِيمُ سُوقَ جَلْبِهِ",32,"ب",2,0],["أين ذاكَ الميثاقُ والعَهدُ يا غَي","رَ وَفيِّ بالعَهدِ والميثاقِ",33,"ق",1,0],["أين ذاك العقل منه والذكا","والدَها ولىَّ وأنى ذهبا",34,"ب",2,0],["أيْنَ ذُو التَّاجِ وَالسَّريرِ قُبَاذٌ","خَبَنَتْهُ فَبَادَ إحْدَى الخُبُونِ",35,"ن",1,0],["اين ذا الحب يا مزاج مدامي","قال لبيك قلت لبيك ألفا",36,"ف",2,0],["أين ذاكَ الوجهُ ما حيّيته","بطريف المدح إلاَّ التمعا",37,"ع",2,0],["أينَ ذاكَ الكفُّ تندى كرماً","كلَّما جفَّ الحيا أو منعا",37,"ع",2,0],["أين ذاك الوجه الجميل وأين ال","سحر توحية للورى مقلتاها",38,"ا",3,0],["أَينَ ذاكَ الجُندولُ يُرقِصُهُ المَو","جُ فَيَنسابُ مُمعِناً في اِختِيالِه",39,"ل",2,0],["أين ذاك العهد يا علم فهل","قد نسيت العهد أم خنت الذماما",40,"م",2,0],["أينَ ذُو النُّون إذ تَوَلاّهُ كَربٌ","فامتطى الفُلكَ حين طابَ الهواء",41,"ا",2,0],["أَينَ ذاكَ البَيان يَفعَل بِاللُّب","بِ بِما قَد يَفوق فعل الشّمولِ",42,"ل",1,0],["أَينَ ذاكَ الجنان يَخفق بالعل","مِ فَيبدي محاسن التأويلِ",42,"ل",1,0],["أين ذاك الإذن للوفد إذا","عذبت عندك أمواه السؤال",43,"ل",1,0],["أين ذاك الإيقاع بالدُّفِّ في الخل","وة بعد الجنوك والنايات",44,"ت",1,0],["أَينَ ذاكَ البَأسُ لَمّا نَفَروا","نَفرَةَ العيرِ رَأى لَيثَ العَرين",45,"ن",1,0],["أين ذو التحجيل مهما حمحما","من هجين أو بهيم معرف",46,"ف",1,0],["أين ذلك العرار من صبغة الور","د إذا جاده الغمام وطلا",47,"ل",2,0],["أين ذاك الحجاب والملك والهي","بة أين الزحام وقت الزحام",48,"م",1,0],["أين ذاكَ الدمُ الذى إِن تَشمه","شِمتَ منه القطبين فى شريان",49,"ن",1,0],["أين ذاك النفس الشا","هر للفضل فرندا",50,"د",2,0],["أين ذاك النظر الجا","عل للحكمة سدا",50,"د",2,0],["اين ذاك المقام تحسده الشم","سم بهاء واين ذاك العلاء",51,"ا",2,0],["أَينَ ذاكَ اليَوم الَّذي نَتَمَشّى","في رباه رغم العدى خَيلاءَ",52,"ا",2,0],["اِينَ ذو القَرنَينِ ذياك الَّذي","صيتُهُ عَمَّ البَرايا وَالمَلَل",53,"ل",1,0],["اين ذاك الهزار يصدح فوق ال","غصن منها سبحان من سواها",54,"ا",3,0],["أين ذاك الخورنق الفرد ولى","واضمحلت أركانه المعموره",55,"ه",1,0],["أين ذاك الرواج والمنطق المو","نق أين الحياء أين الإباء",56,"ا",2,0],["أين ذاك المجد الذي نطح الاف","ق وما حاز بعضه إنسان",57,"ن",1,0],["أين ذاك الجاه الذي وسع الأر","ض وسارت بذكره الركبان",57,"ن",1,0],["أين ذاك البِشْرُ يا مو","لايَ من هذا القُطوبِ",58,"ب",1,0],["أين ذا البحر يطفو مزبداً","كل نبعٍ من جداه مستمد",59,"د",1,0],["اين ذاك القوام يورق لطفاً","بعد ماكان وِرده من حياكا",60,"ك",2,0],["أَيْنَ ذَاكَ الرَّحِيِقُ لَمَّا يُنَدِّي ؟","عِطْرُهُ الْفَوَّاحُ اخْتِضَالَ السُّكَارَى ؟!",61,"ر",2,0],["أين ذاك الروض، أين الورد،","أين حبيبي؟ أين عدل المنصفين!!",62,"ن",1,0],["أين ذاك العريش فيه نصلي","بعد رفع الندا لبيت الفلاح",63,"ح",1,0],["أين ذاك النخيل يسكب في الروح","جمالا وللنخيل ائتلاق",64,"ق",1,0],["أين ذاك الوادي الذي كان بال","أمس كثغر الصباح يا مي باسم",65,"م",1,1],["أين ذاك الذي سمانا بهاءً","حين تزهو الحياةُ في أحداقي",66,"ق",2,0],["أينَ ذاكَ الزمانُ أينَ الوصالُ","أينَ أيامُنا المِلاحُ الثمالُ",67,"ل",1,1],["أينَ ذاكَ الحديثُ والأدبُ الجمُّ","وأينَ البشاشةُ الغَرّاءُ ؟",68,"ا",2,0],["أينَ ذاكَ الصفاءُ يُضفي جلالاً","وسناءً .. وأينَ منكَ الضياءُ ؟",68,"ا",2,0],["أينٓ ذاكٓ العهدِ.. قُلْ لي","هل طوى الصيفُ الغمامةْ",69,"م",2,0],["أين ذكري كانَ دربًا","باعثاً مجدَ الخيامِ!",70,"م",1,0],["أين ذاك الظاهرُ المالئ لل","عين والمخترطُ الرطبُ الصقيلُ",71,"ل",1,0]]}