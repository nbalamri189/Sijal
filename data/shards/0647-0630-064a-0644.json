{"poems":[[90,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[90,"همم الرجال مقيسة بزمانها","https://www.aldiwan.net/poem45023.html","الكامل"],[87,"شمس النهار وأختها","https://www.aldiwan.net/poem7777.html","مجزوء الكامل"],[99,"وشعرة خطفتها","https://www.aldiwan.net/poem24901.html","مجزوء الرجز"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[83,"لام العذار لتوكيد الهوى خلقت","https://www.aldiwan.net/poem61370.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[52,"يَا طُولَ هَذَا اللَّيْلِ لَمْ أرْقَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21668",""],[275,"يا وردة رتلاتها تتنثر","https://www.aldiwan.net/poem35658.html","الكامل"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[501,"قرأت مجدك في قلبي وفي الكتب","https://www.aldiwan.net/poem55808.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48681","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122304","الكامل"],[1277,"","https://poetry.dctabudhabi.ae/diwan/poem/200283","الكامل"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77442","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137931",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93698","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87697","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93799","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93808","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201743","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205073","المنسرح"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123917","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70028","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120503","الكامل"],[5038,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=189980",""],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5277,"تباريحٌ بغدادية..","https://www.poetsgate.com/ViewPoem.aspx?id=198463",""],[5648,"ليال البعد","https://www.poetsgate.com/ViewPoem.aspx?id=154828",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""]],"verses":[["هذي لخزانة أنشئت فبناؤها","للأمر فيه تدارك وتلافي",0,"ف",2,0],["هذي لدى العرب الكرام مبادئٌ","نزلت بها الآيات في قرآنها",1,"ن",3,0],["هذى لدى أفق وذى","من أفق عصمتها مطلة",2,"ل",2,0],["هذي لديَّ صورةٌ","من حالنا جلوتها",3,"ت",3,0],["هَذي لِمِصرَ تُؤَدّي الحَقَّ ناحِيَةً","وَتِلكَ لِلشامِ تَقضي مِنهُ ما يَجِبُ",4,"ب",1,0],["هَذِي لَعَمرِي مَعَانِي اللاَّمِ عِدَّتُهَا","أتَتكَ سِتَّةَ عَشرَ حَسبَمَا اتَّفَقَت",5,"ت",1,0],["هَذِي لِحَاظُ الْغِيدِ بَيْنَ شِعَابِكُمْ","فَتَكَتْ بِنَا خَلْساً بِغَيْرِ مُهَنَّدِ",6,"د",1,0],["هَذِي کلَّتِي دَلَّهَهُ حُبُّهَا","وكان حيناً من حصى المسجد",7,"د",1,0],["هذي لها قطراتُها ونسيمُها","وبتلكَ ما تهوى وما تتذكَّرُ",8,"ر",1,0],["هذِي لأَوَّلِ خاطِبٍ وَلِدَاتُها","يهتِفنَ فِي الآفاقِ هلْ منْ خاطِبِ",9,"ب",1,0],["هذي لها النصرُ لا أبهى، فلا هُزمت","وإن تهَدّدها دَهرٌ منَ النُوَبِ",10,"ب",1,0],["هذي لياليه الحسان تجمّلت","للمسلمين كأنما هي غيد",11,"د",1,0],["هذي ليالي العبد بصطع","الكرام بها الصنائع",12,"ع",1,0],["هذي لميسُ ، حكايَتِي، فدَعُونِي","أُفضِي لكم بمواجِعِي وشُجُونِي",13,"ن",2,1],["هَذي لَعمرُك راية مَرفوعةٌ","بيد السُعود يُقِلُّها التَوفيقُ",14,"ق",1,1],["هذي لتسوُّرها الايطا","ليون عزائمهم شدُّوا",15,"د",3,0],["هذي لَيالينا وَهذا حكمُها","فَليحمل المَحكوم جور الحاكم",16,"م",1,0],["هَذي لَياليك لَم تَحمد مَغبَّتها","نَفسٌ ذَممتُ لَها أَيامك الأَولا",17,"ل",2,0],["هذي ليالي الهنا قالت مؤرخة","لا زال عباسه بالبشر يبتسم",18,"م",1,0],["هذي ليالي المنى قالت مؤرخة","قدوم نجل التهاني جاء بالبشر",19,"ر",1,0],["هذي لقوم عُدول","وتلك للظّلام",20,"م",1,0],["هذي لشحذ الأقلام مرهفة","وذا لشحذ العقول والهمم",21,"م",1,0],["هذي لماك وهذي ثغرك الشنب","فما المحيا وما الاقداح والحبب",22,"ب",1,0],["هَذي لَكُم مَلجاءٌ يا مُؤمنين وَفي","تاريخها أَبَداً ذُو الرمح خافرها",23,"ر",3,0],["هذي لعمرك خطة زادت على","كربي ولم تك في حجا حداس",24,"س",1,0],["هذي لِحاظُكِ أبْرَقَتْ يَومَ اللِّقا","لَو أنْتِ سَيفٌ ذا أنا سَيّافُ",25,"ف",1,0],["هذِي لُيُوثُ الدَّيْرِ تَزْأًرُ نُصْرَةً","والضُّبْعُ شَتَّى تَسْتَجِرُّ ذُيُولا",26,"ل",2,0],["هذي لواعجُها وتلكَ ديارُها","صيّرنَ قافيةَ الهوى عنواني",27,"ن",2,0],["هذي ليال البعد بانت معابيس","دايم على العشاق مثل الاعادي",28,"د",2,0],["هذي لنا وتظلُّ .... لا ليْستْ لكمْ","تاريخ ُ أمَّتِنا العظيمةِ يحْكُمُ",29,"م",1,0],["هذي لياليكم ملاح .. كلها","طهر .. وما تخفي السرائر أنصع",30,"ع",1,0]]}