,[5216,"تحية للدكتور محمد البدري","https://www.poetsgate.com/ViewPoem.aspx?id=187620",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5284,"هَمْسَةٌ في أُذُنِ مَهْمُومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190600",""],[5293,"تحذير","https://www.poetsgate.com/ViewPoem.aspx?id=186130",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5314,"عودة الذات","https://www.poetsgate.com/ViewPoem.aspx?id=214821",""],[592,"يا طالب العلم الشريف الأقوم","https://www.poetsgate.com/ViewPoem.aspx?id=128811",""],[5376,"ليت الزمان يعيذنا من مقته","https://www.poetsgate.com/ViewPoem.aspx?id=189752",""],[5402,"لست بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=215502",""],[5409,"يا من جنت يده عليه شقاءه","https://www.poetsgate.com/ViewPoem.aspx?id=155259",""],[5431,"زندقة!..","https://www.poetsgate.com/ViewPoem.aspx?id=194763",""],[5447,"رمشاك","https://www.poetsgate.com/ViewPoem.aspx?id=208293",""],[5493,"ويحَ الصدود","https://www.poetsgate.com/ViewPoem.aspx?id=199747",""],[5493,"ما الحب؟","https://www.poetsgate.com/ViewPoem.aspx?id=205055",""],[5582,"غاداكَ مِنْ دِيَمِ الحَيا ضَحْوِيُّها","https://www.poetsgate.com/ViewPoem.aspx?id=187333",""],[5596,"فقيد الشباب خلفان البكري","https://www.poetsgate.com/ViewPoem.aspx?id=206774",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5691,"أساس","https://www.poetsgate.com/ViewPoem.aspx?id=206446",""],[5691,"أوهام...!","https://www.poetsgate.com/ViewPoem.aspx?id=206529",""],[5829,"الحب المضطرب","https://www.poetsgate.com/ViewPoem.aspx?id=150377",""],[5829,"رحلة في تضاريس الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=181380",""],[5861,"سر الداء","https://www.poetsgate.com/ViewPoem.aspx?id=188030",""],[5919,"هبّ نشرُ المعنبرِ المخزونِ","https://www.poetsgate.com/ViewPoem.aspx?id=128683",""],[5939,"صياد عجوز","https://www.poetsgate.com/ViewPoem.aspx?id=179281",""],[5970,"نظروا لما بعد الحياة وما دروا","https://www.poetsgate.com/ViewPoem.aspx?id=130582",""],[6096,"الحقُّ المسلوب","https://www.poetsgate.com/ViewPoem.aspx?id=177712",""],[5075,"سأظلُ أملأ بالهنَا أقدَاحِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82755&r=&rc=1",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["فَإِذا رامي المَقاديرِ رَمى","فَدُروعُ المَرءِ أَعوانُ النِصالِ",0,"ل",1,0],["فإذا رأى متألماً شاهدته","متوجعاً مما به متألما",1,"م",2,0],["فَإِذَا رَكَضْنَا لِلشَّبِيْبَةِ أَدْهَماً","جَالَ المَشِيبُ بِهِ فَأَصْبَحَ أَشْهَبَا",2,"ب",2,0],["فَإِذا رَآكَ مُسَلِّماً ذَكَرَ الَّذي","كَلَّمتَهُ فَكأَنَّهُ مَلزومُ",3,"م",1,0],["فَإِذا رَأَوهُ خاشِعاً","خَشَعوا لِذي تاجٍ حُلاحِل",4,"ل",1,0],["فَإِذا رَفَعتُ لَها اليَمينَ تَزاوَرَت","عَن فَرجِ عوجٍ بَينَهُنَّ خَليفُ",5,"ف",1,0],["فَإِذا رُزِقتَ خَليقَةً مَحمودَةً","فَقَدِ اِصطَفاكَ مُقَسِّمُ الأَرزاقِ",6,"ق",1,0],["فَإِذا رَضيتَ فَأَحرُفٌ مِن رَحمَةٍ","وَإِذا غَضِبتَ فَأَحرُفٌ مِن نارِ",7,"ر",1,0],["فَإِذا رَوضَتانِ في ذَلِكَ الرَو","ضِ تَميسانِ تَحتَ ريحِ الخُزامى",8,"م",2,0],["فإذا رفَضْتِ فما عليك برفضه","عارٌ وأن هاج الوليّ وأغضبا",9,"ب",2,0],["فَإِذا رُميتَ بِحَربِ قَيسٍ لَم يَزَل","أَبَداً لِخَيلِهِمُ عَلَيكَ دَليلُ",10,"ل",1,0],["فإذا رامه العداة بكيدٍ","أخذتها الأيام أخذاً وبيلا",11,"ل",2,0],["فإذا رقَّقَتْهُ بالجهدِ منها","خِلتَ أن في حلقها شعيراً يُجشُّ",12,"ش",1,0],["فإذا رهبت أقلني في ربعه","وإذا رغبت أحلني في ريفه",13,"ف",2,0],["فَإِذا رَأَيتَ مُجاشِعاً قَد أَقبَلَت","فَاِهرُب إِلَيكَ مَخافَةَ الظِرّانِ",14,"ن",1,0],["فَإِذا رَنا لِلأُفقِ ظَنَّ نُجومَهُ","عَقدُ الَّتي مَن رامَها رامَ السَما",15,"ا",1,0],["فَإِذا رَآني ذو الغَباوَةِ دونَهُ","فَكَما تَرى في المَاءِ ظِلَّ الكَوكَبِ",16,"ب",1,0],["فَإِذا رَجَعتَ مُسَلِّماً","فَاِبدَأ بِرَدِّ سَلامِيَه",17,"ي",2,0],["فَإِذا رَأَيتَ رَأَيتَ مِنهُ جَنَّةً","لَم تَرضَ إِلّا جودَ كَفِّكَ كَوثَرا",18,"ر",2,0],["فإذا رأَى طفلاً بكاكَ","وإن رأَى شبَحاً دَعاكْ",19,"ك",1,0],["فإذا رُدّ إلى موطنه","في جوار البحر يشفيه الجوار",20,"ر",1,0],["فَإِذا رَأَيتَ مَشايِخاً","أَو فِتيَةً لَكَ ساجِدين",21,"ن",1,0],["فَإِذا راعَها جَلالُكَ خَرَّت","هَيبَةً فَهيَ وَالبِساطُ سَواءُ",22,"ا",2,0],["فَإِذا رَأَيتُكَ حارَ دونَكَ ناظِري","وَإِذا مَدَحتُكَ حارَ فيكَ لِساني",23,"ن",2,0],["فإِذا رقعتَ بها إِهابَ مقنَّعٍ","غادرتَ خَرْقاً مالهُ من مرقَعِ",24,"ع",1,0],["فَإِذا رَأَوني مُقبِلاً أَبصَرتُهُم","سُفعَ الوُجوهِ بَليغُهُم كَالجامِدِ",25,"د",1,0],["فَإِذا رَحَلتَ رَحَلتُ عَن دارٍ إِذا","بُذِلَ السَماحُ فَجارُها مَمنوعُ",26,"ع",1,0],["فإذا رآكَ البِشْرُ بَرْقاً لامِعاً","منه أراكَ الجُودُ غَيْثاً هَامِعا",27,"ع",2,0],["فَإِذا رَأَيتَ الشَيبَ عَم","مَ الرَأَسَ فَالحَذَرَ الحَذَر",28,"ر",1,0],["فَإِذا رَمَتكَ بِنَبلَةٍ","كَرَّت عَلَيكَ بِمِثلِها",29,"ل",3,0],["فَإِذا رَأى رُجحانَ حَبَّةِ خَردَلٍ","مالَت مَوَدَّتُهُ مَعَ الرُجحانِ",30,"ن",1,0],["فَإِذا رَأَيتَ بِهِ شُعا","عَ البَدرِ يَضرِبُ كَالعَمودِ",31,"د",1,0],["فَإِذا رُميتَ بِحادِثٍ في بَلدَةٍ","جَرِّد حُسامَكَ صائِلاً أَو فَاِرحَلِ",32,"ل",1,0],["فإذا رضيتِ فإن نع","متَها ونقمتها سواء",33,"ا",2,0],["فإذا رأيتك كنت أنت الناس وال","أعمار والآباد والآمادا",34,"د",2,0],["فَإِذا ريمٌ عَلى مُهُدٍ","في حِجالِ الخَزِّ مُستَتِرُ",35,"ر",1,0],["فَإِذا رَمى بِكُما الصَباحُ دِيارَهُ","فَتَرَدَّدا في ساحَةِ العَلياءِ",36,"ا",2,0],["فَإِذا رَنا وَإِذا مَشى","وَإِذا شَدا وَإِذا سَفَر",37,"ر",1,0],["فَإِذا رَويتَ بِماءِ ذاكَ المُجتَلى","فَحَذارِ مِن أُلهوبِ ذاكَ الهاجِسِ",38,"س",1,0],["فَإِذا رُمتُ سَلوَةً","حيلَ ما بَينَنا بِذَين",39,"ن",1,0],["فَإِذا رَأَت وَجهَ الصَباحِ تَسَتَّرَت","خَوفاً وَصَيَّرَتِ الجُفونَ كَماما",40,"م",2,0],["فَإِذا رَأَتني عَينُ غانِيَةٍ","قالَت لِرائِدِ لَحظِها حَسبي",41,"ب",2,0],["فإذا رجَعتَ إلى الحَقيقِ فإنّما","إيّاكَ تَعْني ألسُنُ الأقْوام",42,"م",1,0],["فإذا رأى الأبطالَ نَصّ إليهمُ","جِيداً وأتْلَعَ خائِفاً مُتَرَقِّبا",43,"ب",2,0],["فَإِذا رَأَيتَ خُضوعَها لِمِزاجِها","فَمُرَن يَدَيكَ بِعِفَّةٍ وَحَياءِ",44,"ا",2,0],["فَإِذَا رَأَيْتَ رَأَيْتَ أَحْسَنَ جَنَّةٍ","خَضْرَاءَ تَجْرِي بَيْنَهَا الأَنْهَارُ",45,"ر",1,0],["فَإِذَا رَكِبْتُ فَكُلُّ قِرْنٍ أَمْيَلٌ","وَإِذَا نَطَقْتُ فَكُلُّ نُطْقٍ رَارُ",45,"ر",1,0],["فَإِذَا رَكِبْتُ فَإِنَّنِي","زَيْدُ الْفَوارِسِ فِي الْجِلادِ",46,"د",1,0],["فَإِذا روْضةٌ تَكَشَّفُ لِي","عَنْ مُحيّاً إِلَيَّ قَد هَشَّا",47,"ش",2,0],["فَإِذا رَخُصْنَ أَلاَ كرَا","مَةَ للصَّغيرَاتِ الطَّوَاهرْ",48,"ر",1,0],["فإذا رمتُ وصفها بلساني","أَلْجَمَتْنِي، فلا أحيرُ كلاما",49,"م",2,0],["فإذا رَأيْتُ الهَجرَ ضَرْبَةَ لازِبٍ","يَوْماً، رَأيتُ الصّبرَ ضَرْبةَ لازِبِ",50,"ب",1,0],["فإذا رأيتك كنت أنت الناس والأ","عمار الآباد والآمادا",51,"د",2,0],["فإذا رفَعتُ لها اليَمينَ تَزَوارَتْ","عن فرج عوجٍ بينهنَّ خليفُ",52,"ف",1,0],["فَإِذا رَنا وَإِذا اِنثَنى لا تَذكُروا","بيض الظِبا مَع صَعدة سَمراءِ",53,"ا",2,0],["فإذا رأنى في انخفاضٍ سرَّهُ","وإذا رأنى في ارتفاعِ غارَا",54,"ر",2,0],["فَإِذا رَمَيتَ بِهِ عِدىً في مَأزِقٍ","فَبِغَيرِ رَأسِ عَظيمِهِم لا يَرجِعُ",55,"ع",1,0],["فَإِذا رَمى المِقدارُ مِنهُ بِمَدحَةٍ","ضَرَّ الأَنامَ لِيَنفَعَ الوَزّانا",56,"ن",2,0],["فإذا رآك رآك قرة عينهِ","ويرى سواك من الملوكِ فيغضبا",57,"ب",2,0],["فإذا رآك فانها أُمنيّةٌ","ظفرت يداه بها عن الأقوامَ",58,"م",1,0],["فإذا رآك مشمرا في نصرتي","ترك التعامي واهتدت يده يدي",59,"د",2,0],["فإذا رأى اليمن السعيد كجنة","ألفى بها الفقهاء كالنيران",60,"ن",1,0],["فَإِذا رُمتُ نُهوضاً قَعَدَت","بي أُمورٌ أَنا مِنها في جِهادِ",61,"د",1,0],["فإذا رجعن ولم يكن","ما قلت فيما نالهنّه",62,"ن",2,0],["فإذا رابه من الدهر ريب","جاء مستعديا بوجه ذليل",63,"ل",1,0],["فَإِذا رامَ غايَتي فَهوَ كابَ","وَعَلى البُعدِ كَوكَبُ مَبهور",64,"ر",1,0],["فإذا رنا لم يبقَ قل","باً سالماً إلا رماهُ",65,"ه",1,0],["فاذا رأيتُ رأيت شخص محاسنٍ","واذا اختبرت رأيت شخص محامدِ",66,"د",1,0],["فَإِذا رَجَعتَ إِلى نِسائِكَ فَاِدَّهِن","إِنَّ المُسالِمَ رَأسُهُ مَدهونُ",67,"ن",1,0],["فإذا رماك بِشِدّةٍ فاصبر لها","فلسوف يأتي بعدها بِليانِ",68,"ن",1,0],["فإذا رمتُ أَن أَكافِيكَ بالمَدْ","حِ وبالشّكر كلَّ عنكَ لِساني",69,"ن",2,0],["فَإِذَا رَكَنْتُ لَهُ وَذَلِكَ غَايَتِي","سَالَتْ غُرُوبُ الدَّمْعِ مِنْ أَجْفَانِي",70,"ن",2,0],["فإذا رمت عاشقي نزهة الطَر","ف فطر فوق طِرف عينٍ وقلب",71,"ب",1,0],["فإذا رزقت الجهل أدركت المنى","وإذا حرمت الجد أعطيت النهى",72,"ه",2,0],["فإذا رأيتِ من المحبّ تذلُّلاً","باللهِ يا حسناءُ لا تتكبِّري",73,"ر",2,0],["فإذا رَنوتِ جَلوتِ عن","قَلبي الكآبةَ فاستراح",74,"ح",1,0],["فإِذا رَأَيْتَ مِن الأَكارِمِ مُحْسِناً","فَاحرزْ علَيهِ آفَةَ الإِحْسانِ",75,"ن",1,0],["فإذا رمى بحكيمة في محفل","حكمتْ له فيه برغم عداهُ",76,"ا",2,0],["فَإِذا راهَقَ أرهِقتُ سَلُوّاً","وَجَفاني كُلّ شَيطانٍ نزوغ",77,"غ",1,0],["فإذا رام محبٌّ عتبَهُ","خَفي الأَمرُ عليه واِشتبَه",78,"ب",2,0],["فإذا رنَّ مزهرٌ أو شدا شا","دِ أعاروهُ ميّتَ الأسماع",79,"ع",1,0],["فَإِذا رَأَتكَ الغانِيا","تُ رَأَينَ مِنكَ غُرابَ بَين",80,"ن",1,0],["فإذا رأته الشمس في آفاقها","بعثت إليه بنورها الموزون",81,"ن",1,0],["فَإِذَا رَأَينَ المَاءَ يَطفَحُ نَضنَضَت","مِن كُلِّ خُرتٍ حَيَّةٌ بِلِسَان",82,"ن",1,0],["فإذا رأيتَ رأيتَ منه كاملاً","مَرئيُّه يُوفى على المَسْموع",83,"ع",1,0],["فإِذا رَأيتَ الدُرَّ أب","صَرتَ العَقيقَ بِه مَنوطا",84,"ط",2,0],["فإذا رأيتَ عليه طَرفاً واقعاً","فاعلَم بأن هناكَ قلباً طائِرا",85,"ر",2,0],["فإذا رصدتَ بأوج عقلك صوتَها","يُشجيك لحنُ هديرها المتنعم",86,"م",1,0],["فإذا رأيت الإبن يدعو أمه","عجباً لجهلك كيف لا يتعلم",86,"م",1,0],["فإذا رووا صدَّقتُ ما جاؤوا به","وإذا رأوا حاولت أني أَمجُد",87,"د",1,0],["فَإِذا رَنا فَكَأَنَها","عَقَدَت ببند نِطاقِهِ",88,"ق",2,0],["فَإِذا رَأَيتِ بِهِ الرَضى","قُولي وَلا تَتَوقَفي",89,"ف",2,0],["فَإِذا رَأَيتَ مَناصِباً","فَاِعلَم بِأَنَّ أَباهُ كَبشُ",90,"ش",1,0],["فَإِذا رَأَيتَ مُحِبَّهُ","فَاِحكُم عَلى كرمٍ وجودِ",91,"د",1,0],["فَإِذا رَأَيتَ كِفايَتي وَأَمانَتي","وَصيانَتي عرضي وَحُسن قِيامي",92,"م",2,0],["فإذا رمت بلالاً لصدًى","ما تعدَّاكَ إلى الماء مرامي",93,"م",2,0],["فإذا ركنت إلى نجيب لم يكن","إلاَّ إلى ذاك الجناب ركوني",94,"ن",2,0],["فإذا ر