{"poems":[[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[88,"حولوا النيل واحجبوا الضوء عنا","https://www.aldiwan.net/poem10516.html","الخفيف"],[88,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[90,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[74,"شكر الله أياديك التي","https://www.aldiwan.net/poem18618.html","الرمل"],[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[17,"اسلم سلمت ولا سليم على البلى","https://www.aldiwan.net/poem1194.html",""],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[107,"سلامٌ أيها الملك الهمام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54851&r=&rc=21",""],[226,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[276,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[409,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[469,"أبدور تم أو وجوه كواعب","https://www.aldiwan.net/poem3409.html","عموديه"],[563,"كفة الغيب كفة الحسنات","https://www.aldiwan.net/poem34721.html","الخفيف"],[580,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[580,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[599,"","https://poetry.dctabudhabi.ae/diwan/poem/100444","الخفيف"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/34700","الخفيف"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128269","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112838","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48923","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125458","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2191,"","https://poetry.dctabudhabi.ae/diwan/poem/96088","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28501","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83042","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130747","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130774","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205877","الخفيف"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124679","الكامل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124681","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118820","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100829","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74055","الخفيف"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128397","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138610",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114421","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4767,"مهرجان صفوى","https://www.poetsgate.com/ViewPoem.aspx?id=92537",""],[5038,"بشائر النصر","https://www.poetsgate.com/ViewPoem.aspx?id=195223",""],[5197,"يا عظيم الأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=131027",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5431,"استنساخ!","https://www.poetsgate.com/ViewPoem.aspx?id=202923",""],[5431,"ليلى في العراق....","https://www.poetsgate.com/ViewPoem.aspx?id=207165",""],[5447,"رمشاك","https://www.poetsgate.com/ViewPoem.aspx?id=208293",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5910,"لغةُ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=206217",""],[5956,"يحترق العاشق من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=182588",""]],"verses":[["وَأُقيلُ عَثرَةَ كُلِّ مُبتَئِسٍ","وَأَفي الحُقوقَ وَأُنجِحُ المَسعى",0,"ع",2,0],["وَأَقيموا لِلعَسفِ في كُلِّ شِبرٍ","كُنسُتَبلاً بِالسَوطِ يَفري الأَديما",1,"م",2,0],["وَأَقيموا كُلَّ عامٍ مَوسِماً","يُشبِعُ الأَيتامَ مِنّا وَالأَيامى",2,"م",2,0],["وأقيموا عالياً تمثاله","فهو للأوطان عزّ وجلال",3,"ل",1,0],["وأقيمت عندها الحرمة بل","قام مني كل شيء عندها",4,"د",3,0],["واقيةُ اللَّهِ على عبدِهِ","مِنه ومِن صمصامةِ المِقْضَبِ",5,"ب",1,0],["وَأُقيمَت لَهُ القِيامَةَ في قُمٍّ","عَلى خالِعٍ وَعاتٍ عَتيدِ",6,"د",1,0],["وَأَقيمي ممالكاً وَعُروشاً","وَاِفزَعي للخداع وَالبُهتان",7,"ن",1,0],["وَأُقيلُ حَيثُ أَرى فَلا أَخفى لَهُ","وَيَرى فَلا يَعيا بِحَيثُ أَبيتُ",8,"ت",1,0],["وَأُقِيمَ مُنْتَقَضُ الجِدارِ وَتَحْتَهُ","كَنْزُ الوُصُولِ إِلى البقاءِ السَّرْمَدِي",9,"د",2,0],["وأقي أرجه من بلل","عند هذا الخشب اهتز وقد",10,"د",1,0],["وأقيها عاديات الخلل","أنا ملء الكون ما فيه سوى",10,"س",3,0],["وأقيم لو قدرت على جزاءٍ","إذن أودى بنا منك انتقام",11,"م",1,0],["وأقيموا فنحن أحوج منكم","ليد تعمر البلاد ورأس",12,"س",1,0],["وأقيم كرسي النبوّة غاية","لَولا سميكما سما لسبقتما",13,"م",2,0],["وَأُقِيمُ العُذْرَ لِعُذَّلِه","في خَوْنِ العَهْدِ فيُقْعِدُهُ",14,"د",2,0],["وأقيل الزمان عند لقاه","من ذنوب النوى ومثلي يقيل",15,"ل",1,0],["وأقيمُ عذرك في القطيعة عالماً","صدَّ الحسان عن العذار الشائبِ",16,"ب",1,0],["وأقيموا للوزن بالقسط هذا","قول ربي في محكم الآيات",17,"ت",1,0],["وأُقيمُ إِمَّا دولةً","للملك أَو للنَّفْسِ عُذْرَا",18,"ر",2,0],["وأُقِيمُ بَعْدك لاَهِياً","قسماً لقد خَانَ الأَمِينُ",19,"ن",1,0],["وأقيم خزّان لذخر الماء إن","مست إليه الحاج حين ظماء",20,"ا",2,0],["وأقيمت علي مني شهود","باجترامي جوارحي ولساني",21,"ن",2,0],["وَاِقِياني مِن بَيتِ ناحومِ راحاً","قَهوَةً لا تُماكِسا ناحوما",22,"م",2,0],["واُقيمت مآتم لك فيه","سوفَ تحيي ذكراك عاماً فعاما",23,"م",2,0],["وأقيلوا عثار ماله غير فضلكم","ومنوا بحفظ وابدلوا البعد بالقرب",24,"ب",1,0],["وأَقيموا للمعالي أَمرَكُم","بمبادي العلم أقوى سَنَدِ",25,"د",1,0],["وأقيمتْ لها الصلاة بذكرا","كَ فكانتْ صلاتها في الرحال",26,"ل",1,0],["وأقيموا الصلاةَ للهِ شُكراً","واذكُروه في السِّرِّ والإعلانِ",27,"ن",1,0],["وأقيما لها براهينَ حُبِّي","واشرَحا حالتي لها وابكياني",28,"ن",2,0],["وأقيموا الصلاةَ للهِ فَرضاً","فهي للقلبِ واليقينِ الضِّياء",29,"ا",2,0],["وأقيموا الميزانَ بالقسطِ حتى","لا يقولَ الكِرامُ ضاع الوفاء",29,"ا",2,0],["وأقيموا مناسِكَ الحجِّ سعياً","حول بَيتٍ عِمادُهُ العلياء",29,"ا",2,0],["وأقِيهِ عندَ تَشاجُرِ الأبطا","لِ بالأَسَلِ النِّهال",30,"ل",1,0],["وَأُقيمُ سوقَ المَجدِ في ناديهمُ","حَتّى أنَفِّقَ فيهِ فَضلاً كاسِدا",31,"د",2,0],["واقيةٌ من البلا","إِن كان منه واقِيَه",32,"ه",1,0],["وأقيل الطارق الملهوق مضطرباً","وإذ به صاحبٌ ضاقت به السبُل",33,"ل",1,0],["وأقيموا لنا بناءَ اتحادٍ","ان قوماً على اتحادٍ رجحوا",34,"ح",3,0],["وأقيموا له من الذكر تمثا","لاً رفيع الذرى علىّ الشان",35,"ن",1,0],["وأُقيمت على ضفافك للحبِّ","طقوسٌ وأُلهت أهواءُ",36,"ا",1,0],["واقيمنَّ في الهياكلِ تمثالاً","لربٍّ له عليَّ الوفاءُ",37,"ا",2,0],["وأقيم فرض العين في أهل الهوى","وإليك أدعو كلَّ صبٍّ معلنا",38,"ن",2,0],["وأقيم للدين الحنيف دعائم","فيها من الشم الطوال وقار",39,"ر",1,0],["واقيكَ مِن سهم البَلا","ءِ غَدا دَريئة أَسهمِ",40,"م",1,0],["وَأَقيمي لَدى الجَوانِح مِنّا","ما أَقام الأَماجد الأَكرَمونا",41,"ن",2,0],["وأقيم في الخضرا عزا بلغاريا","لما أقاموا عز غسلامبول",42,"ل",1,0],["واقيم طوراً في مقام الذل ما","بين الجفات وقد ترفع هامها",43,"م",3,0],["وأقيموا الوزنَ بالقسط ولا","تُحسرُوا الميزانَ",44,"ن",1,0],["وأقيم سيفٌ واستراحَ به الورى","وأتى السرورُ وولَّتِ الأكدار",45,"ر",1,0],["وأقيما حيثُما الحبُّ يُقيم","ناشراً راي الهنا والظَّفَرِ",46,"ر",1,0],["وأقيم حفل بعد ذلك رائع","حيت جهود العاماين قصائده",47,"د",2,0],["وَأُقيمُ عُرْساً لِلشَّهيدِ بِكَرْبَلا","وَأُشِيدُ نُصْبَ النَّصْرِ في بَغْدانِ",48,"ن",1,0],["وأقيموا الملك بالدين كما","كان في عصر نبيِّ الأنبياءْ",49,"ا",2,0],["وأقيموا في الجو حصناً منيعاً","لا يبالي بغارة المجتاح",50,"ح",1,0],["وأقيمُ بين شفاهه قمحيّة","عند التمنّع للتمتّع أرضخُ",51,"خ",1,0],["وأقيموا على العروبة حصنا","لاتمرّ العلوج إثر اختراقِ",52,"ق",1,0],["وأقيمُ في خيماتِ شِعري ريشةً","ملت معاقرة المدادِ عهودا",53,"د",2,0],["وأقيم ميزان العدالة بينهم","هذا به يعلو وذلك ينزل",54,"ل",1,0],["وأقيمت مدارس فأقامت","صُرُح النور فاهتُدي بهداها",55,"ا",3,0],["وأقِيموا لسانَكم لا تَضِلُّوا","وانهَلُوا منها ما يحوزُ رضاها",56,"ا",3,0],["‏وأقيم الحب خُطىً فخُطىً","‏ ‏ حتى بالكامل أستولي",57,"ل",2,0]]}