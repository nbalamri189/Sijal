{"poems":[[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[91,"اني افكر في الطبيعة فاحصا","https://www.aldiwan.net/poem44850.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141918","الكامل"],[190,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[215,"إني أفقت أفقت","https://www.aldiwan.net/poem46617.html","المجتث"],[341,"قالوا ليّ اركن لأبواب السلاطين","https://www.aldiwan.net/poem67801.html","عموديه"],[422,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62461","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27383","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27916","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27757","البسيط"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120163","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74034","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199077","البسيط"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147289","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52165","الكامل"],[4767,"بحر بلا ساحل","https://www.poetsgate.com/ViewPoem.aspx?id=210696",""],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4858,"قلبٌ بين نارَين","https://www.poetsgate.com/ViewPoem.aspx?id=138782",""],[5041,"إلى عزيزٍ لهُ في مُهْجَتي نُزُلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24396",""],[5189,"إنّي أفضِّلُ كظمَ ما بسَرائري","https://www.poetsgate.com/ViewPoem.aspx?id=194159",""],[5268,"سيمرُّ في دَمِنا الرَصاصُ","https://www.poetsgate.com/ViewPoem.aspx?id=207018",""],[5628,"الولادة الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=178478",""],[5763,"البحث عن لغة غير مسكونة","https://www.poetsgate.com/ViewPoem.aspx?id=27059",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[6093,"كنهه لا شيء","https://www.poetsgate.com/ViewPoem.aspx?id=197063",""],[6097,"أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=186068",""],[6152,"غربة روح","https://www.poetsgate.com/ViewPoem.aspx?id=202539",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""]],"verses":[["أنّي أفي ببكائه ورثائه","مهما نظمت قصائد الأشعار",0,"ر",1,0],["اني افكر في الطبيعة فاحصا","فيعد تفكيري من الالحاد",1,"د",1,1],["أَنى افْتَقَدْتَ وَجَدْتَ فِي آثَارِهِ","ذِكْرَى تَضَوَّعُ كَالأَرِيجِ العَابِقِ",2,"ق",1,0],["إني أفدي كل شمس أصيلة","حذر المغيب ، بألف شمس صباح",3,"ح",1,0],["إني أفوّض أمري في تصرّفه","إلى الذي في حجاب الحمل أحسن لي",4,"ل",2,0],["إني أفقتُ أفقتُ","من كربتين نجوتُ",5,"ت",1,1],["أنى أفوض أحوالي لمن عجزوا","عن حال أنفسهم عجزالمساكين",6,"ن",1,0],["أنَّى أفوزُ بطارق من طيفه","ما دام هذا الطيف في تسهيده",7,"د",2,0],["إني أفِرُّ من الزمان إلى أبي","تيمورٍ الشهم الهمام ونادرِ",8,"ر",1,0],["إني أفدت من استفدت علوماً","منه ولم أكُ بالأمور عليما",9,"م",2,1],["إني أفيق وفي أرضي لها فيق","تبكي السماءُ لها لينفقَ السوقُ",10,"ق",1,1],["إني أفاديك يا من عزَّ مطلبه","بالنفسِ والمالِ والأهلين والولد",11,"د",1,1],["إنى أفاطم مذ نعوك عليلة","قلبى وطرفى ذائب وسكوب",12,"ب",1,0],["إِن يأفل البَدرُ المُنيرُ عَلى الوَرى","فَبُدورُ فَضلِكَ ما لَهُنَّ أُفولُ",13,"ل",1,0],["إني أفكر والأيام تعبث بي","ما بين مرتفع منها ومنخفض",14,"ض",1,1],["إني افتتنت بحبها وبحسنها","علما بأن نعيمها سيزولُ",15,"ل",1,1],["إني أفقت مِن الصّبى فإذا الصبى","ذِكرى مُنىً زالت وعهدٍ زالا",16,"ل",2,0],["إنِّي أفكر ما أنا","في بحر حبِّكِ فاعلُ",17,"ل",1,1],["إنّي أفي وصفَ نابليونَ وهو فتىً","بكلِّ ضربٍ من الأوصافِ مرآةُ",18,"ه",1,0],["إنّي أفيءُ إلى روضٍ فينفحُني","بطيبِ نسرينَ ، أقضي العمرَ محتسبا",19,"ب",2,0],["إنِّي أُفَتِّشُ عَنِّي خَلْفَ رامِحَةٍ","فَلا أَرَى غَيْرَ تِيهٍ، صَاغَهُ الزَّلَلُ",20,"ل",1,0],["إنّي أفضِّلُ كظمَ ما بسرائري","كيما أحاذر زلَّة الأخطاءِ",21,"ا",2,1],["إنِّي افتديتُكِ في حروفِ قصائدي","ومَنِ افتَدَى وطني فديتُ رِقَابَهْ",22,"ب",2,0],["آن يا فاتنتي أن تعرفي","مِنْ فمي بعضَ الذي لا تعرفينَهْ",23,"ن",2,1],["إني أفتش عن حرفٍ يصاهرني","حقاً ، وأرفو به أمشاجَ مسبحتي",24,"ت",2,0],["إني أُفَضّل أن أعيش مُشَرَّداً","عن أن أكون إلى سواهم في اْنتِما",25,"م",2,0],["إني أفضل أن يكون غرامنا","كالطيف شيء كنهه لا شيء",26,"ي",2,1],["إنِّي أُفَتِّشُ عَمْدًا عَنْ عُيوبِهِمُ","عَلِّي يُوَدِّعُني شَوقٌ وأفكارُ",27,"ر",1,0],["إني افتقدتكِ قلتها متألما","فالروح ثكلى والحنايا مظلمة",28,"م",2,0],["إنى أفقت رجمت بلبلتى","ووأدت طيشى إنه فقد",29,"د",1,0]]}