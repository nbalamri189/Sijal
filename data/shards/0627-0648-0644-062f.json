{"poems":[[74,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27701","المنسرح"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100297","الرجز"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111042","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111048","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111064","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97064","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54480","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139650",""],[4899,"أجمل عناويني","https://www.poetsgate.com/ViewPoem.aspx?id=177011",""],[5122,"واليوم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=18846",""],[5183,"البدوي والوهم","https://www.poetsgate.com/ViewPoem.aspx?id=180279",""],[3856,"كَم زَفرةٍ أوشَكَتْ أن تُرمِدَ الحَطَبا","https://www.poetsgate.com/ViewPoem.aspx?id=215915",""],[391,"هلْ لهذا القلبِ سمعٌ أوْ بصرْ","https://www.poetsgate.com/ViewPoem.aspx?id=4652",""]],"verses":[["أولد مع فقدِ الصبا جوهر الثنا","يتيماً وأولاد الشيوخ يتامى",0,"م",2,0],["أَو لِدَمعٍ عَن سَفاهٍ نِهيَةٌ","تَمتَري مِنهُ أَسابِيَّ الدِرَر",1,"ر",1,0],["أولدوا أم الندى فالتقحت","ببنيها بعدَ أن حالت عقاما",2,"م",2,0],["أول دعم فاض بعد قطعيةِ","أول قلب هيجه المنازل",3,"ل",1,0],["أولدني العلم بالوجود فما","تنفك ذاتي عن ذاتِ فاتقها",4,"ق",3,0],["أوَّلُ درِّ جاءَ في النوروز","وآخرُ الدُرِّ لَهُ تمييز",5,"ز",1,0],["أولد مولوداً أتى","مقدّسا مطهرا",6,"ر",2,0],["أولدت من تجلى به","ظلم فشع بنوره",7,"ه",1,0],["أولدت ملتحف العفاف كريمة","بزغت فالبست الشموس حدادها",8,"د",3,0],["أولداه الفضل والجود معاً","أولداه البدر بل شمس ضحاها",9,"ا",3,0],["أولدت منه للمنية قرماً","قارعاً من عداة ناباً فنابا",10,"ب",2,0],["أولدَتْ أَنعمُهُ عُقْمَ المُنى","وشفى من يأسِنا الدّاءَ العُقاما",11,"م",2,0],["أولدت لي ولدين لا لك ثم ذا","لك ثالثاً لا لي فَعُلْهُ القوفا",12,"ف",2,0],["أولدوا كلَ سؤددٍ فالأيادي","من سواهم عقيمة الميلاد",13,"د",1,0],["أول دروب السفر بك هي تمشيني","في درب حبك وفيك الدرب مسرورة",14,"ر",2,0],["أول درقتيني لاشك أندرقتي","ماعاش راسي كانك أبتدرقينه",15,"ن",2,0],["أولدها فتنمو تح","ت تيس صادق الولد",16,"د",1,0],["أُوَلِّد الشِّعر من بغضٍ، ومن غضبٍ","ولست أعتب أن أستجلب العتبا",17,"ب",2,0],["أو لِدَمعٍ عن سَفاهٍ نُهْيَة","ٌ تمنرى منهُ أسابى ُّ الدِّررْ",18,"ر",1,0]]}