{"poems":[[53,"كان هزلا فعاد جدا غرامي","https://www.aldiwan.net/poem66364.html","الخفيف"],[45,"كتمت حبك حتى منك تكرمة","https://www.aldiwan.net/poem10583.html","البسيط"],[104,"كان هزارا طربا","https://www.aldiwan.net/poem33017.html","مجزوء الرجز"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140838",""],[342,"كأن هزيز الريح بين فروجه","https://www.aldiwan.net/poem45293.html","الطويل"],[395,"ألم تر أن جيرتنا استقلوا","https://www.aldiwan.net/poem1927.html","الرمل"],[466,"يقظان قلب وطرف لا يغالبه","https://www.aldiwan.net/poem16231.html","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44823","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[3298,"","https://poetry.dctabudhabi.ae/diwan/poem/105710","المجتث"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86515","الطويل"],[5004,"بساتيها للمسك فيها روائح","https://www.poetsgate.com/ViewPoem.aspx?id=181492",""]],"verses":[["كان هزلاً فعاد جِدّاً غرامي","وعذابُ الهوى غُلامُ غلامِ",0,"م",1,1],["كَأَنَّهُ زادَ حَتّى فاضَ مِن جَسَدي","فَصارَ سُقمي بِهِ في جِسمِ كِتماني",1,"ي",1,0],["كان هزاراً طَرِباً","بالحسن مفتنَّا",2,"ا",1,1],["كَأَنَّهُ زِرُّ فَتىً مَزرورُ","وَلا يُرجّى إِلفُهُ المَحظورُ",3,"ر",1,0],["كَأَنَّهُ زَهَرٌ جَاءَ الجُنَاةُ بِهِ","مُسْتَطْرَفٌ طَيِّبُ الأَرْواحِ مَطْلُولُ",4,"ل",1,0],["كأنه زاد حتى فاض عن جسدي","فصار سقمي به في جسم كتماني",5,"ي",1,0],["كَأَنَّ هَزيزَ الريحِ بَينَ فُروجِهِ","عَوازِفُ جِنٍّ زُرنَ جِنّاً بِجَيهَما",6,"م",2,1],["كَأَنَّ هَزيزَنا يَومَ التَقَينا","هَزيزُ أَباءَةٍ فيها حَريقُ",7,"ق",1,0],["كأنَّهُ زهْرةُ العام الخصيبِ إذا","زهَتْ مَنابتُها القُصْوى بنُوَّارِ",8,"ر",1,0],["كَأنَّ هزِيزَ الرِّيحِ يَمدَحُ رَوضَها","فَتَملأُ فَاهَا مِن أَزَاهِرِهِ دُرَّا",9,"ر",2,0],["كأَنَّ هَزيزَ الرِّيحَ بَينَ فُروجِهِ","عَوازِفُ جِنٍّ زُرنَ حيّاً بِعَيهَما",10,"م",2,0],["كأنه زهر روض","كل الورى تشتهيه",11,"ي",2,0],["كأن هزيز الريح يندب حظها","إذا هي لم ترو الشكاة ولم تحك",12,"ك",1,0],["كأن هزيز الريح بين غصونها","ضرائر أضحى بينهن تعاتب",13,"ب",1,0]]}