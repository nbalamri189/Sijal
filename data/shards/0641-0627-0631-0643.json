{"poems":[[29,"بكر الأمير لغربة وتنائي","https://www.aldiwan.net/poem5658.html","الكامل"],[53,"أقول إذ قابلني وجهه","https://www.aldiwan.net/poem63994.html","السريع"],[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[76,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21071","الرمل"],[124,"أوشك الأصباح أن يمحو الدجى","https://www.aldiwan.net/poem49304.html","الطويل"],[132,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[189,"عتبت الزمان عسى يعتب","https://www.aldiwan.net/poem14122.html","المتقارب"],[264,"نشرت في دولة العشّاق أطرافي","https://www.aldiwan.net/poem35321.html","المواليا"],[406,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[422,"إنما هذا لعمري مركب","https://www.aldiwan.net/poem53833.html","الرمل"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[438,"اقطع مؤاخاة أخ جاف","https://www.aldiwan.net/poem12673.html","السريع"],[463,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[473,"عندنا زهرة لها إشراق","https://www.aldiwan.net/poem59831.html","الخفيف"],[473,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[549,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86935","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86756","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137649",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78166","السريع"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52118","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93993","البسيط"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140068",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204916","الكامل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144909","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62943","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66471","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125936","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76500","الرمل"],[4767,"إلى نعجة الخليج","https://www.poetsgate.com/ViewPoem.aspx?id=124840",""],[4767,"يا ابنةَ العشرين","https://www.poetsgate.com/ViewPoem.aspx?id=213890",""],[4830,"قُطْبُ الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=206475",""],[4984,"لغزة الوجدان شد رحاله","https://www.poetsgate.com/ViewPoem.aspx?id=175532",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5408,"أنا لا إليك","https://www.poetsgate.com/ViewPoem.aspx?id=190581",""],[5431,"اذكر لربك وابقَ العمر متصلا","https://www.poetsgate.com/ViewPoem.aspx?id=192168",""],[5431,"لن ترتوي حتى أخونه!!","https://www.poetsgate.com/ViewPoem.aspx?id=196681",""],[5431,"حتى نعود إلى الدروب البوصلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=198783",""],[5431,"في آخر السطر...","https://www.poetsgate.com/ViewPoem.aspx?id=212228",""],[5512,"لذَّةُ القطاف","https://www.poetsgate.com/ViewPoem.aspx?id=206540",""],[6108,"مع سبق الإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=192751",""]],"verses":[["فَاِركُض قُفَيرَةَ يا فَرَزدَقُ جاهِداً","وَاِسأَل قُفَيرَةَ كَيفَ كانَ جِرائي",0,"ا",2,0],["فاركبْ سبيل الغي ثم اقترف","ما شئت من إثم ومن وزر",1,"ر",1,0],["فاركبْ طريقاً أراك راكبَهُ","يُفضى بركبانه إلى الغِيرِ",2,"ر",1,0],["فَاِركُضِ الدَهرَ سابِحاً وَاِنتَضِ المِق","دارَ سَيفاً وَاِستَصحِبِ السَعدَ لامَه",3,"م",2,0],["فأركانُهُ مِن يذْبُلِ وعَمَايَةٍ","وأعلامُهُ مِن أعفُرٍ ويَلَملَم",4,"م",1,0],["فَأُركِبَ بعد السجن في الصبح بغلةً","تُساقُ حثيثاً وَهْوَ يَبكي وَيجزع",5,"ع",1,0],["فاركَبُوا في الَحرامِ فُكُّوا أَخاكُم","إنَّ عِيراً قَد جُهِّزَت لاِنطلاقِ",6,"ق",1,0],["فاركبوا الريح اركبوها ما عسى","صبرنا علي النهار البين",7,"ن",1,0],["فاركض وجَرِّب سبق خيلك إنني","مُتَرَقِّبٌ ما يصبُغ الحِنَّاءُ",8,"ا",2,0],["فأركب للّهوِ خيلَ الشباب","وحَوْلىَ من جُنْده مَوكِب",9,"ب",1,0],["فاركب بميدان حرب الحبّ أطرافي","وصُل ولا تخش أهل العذل للعشّاق",10,"ق",1,0],["فأركضت الخيول إليه حتى","أضأت بشاشة الوجه الغضوب",11,"ب",1,0],["فاركبوا فيه على أمنٍ به","فهو ممّا فيه ترتاح الخواطر",12,"ر",1,0],["فاركب البحرَ وخض لُجَّتَهُ","يا شبيه البحر يوم الجود مدَّا",13,"د",2,0],["فاركَبْ من العزْمِ وجنّبْهُمُ","قَرى أمونِ الخَطْوِ مِهْيافِ",14,"ف",1,0],["فاركب جَناح العزّ لست بمخلِفٍ","عِرْضاً مضى ولكلّ مالٍ مخلفُ",15,"ف",1,0],["فَاِركَبِ الإِنخِلاعَ نَحوي فَعِندي","لِلخَلاعاتِ في السُرورِ سِباقُ",16,"ق",1,0],["فَاِركَب عَلى عَزمِكَ ذاكَ الَّذي","أَعرِفُهُ يَجري وَلا يَتعَبُ",17,"ب",1,0],["فاركضْ بجرحكَ للأنغامِ ناصعةً","بيضاءَ، واعقدْ عليهِ (الشَّاشَ) والقُطُنَا",18,"ن",2,0],["فَاركض بخيلك في مَيدان ساحَتها","وَارمح بِحاناتها في جنح أَغلاس",19,"س",1,0],["فَاركض بِخَيلك في مَيادين الهَنا","وصِلِ المَسرةَ فَالعدوّ طَريد",20,"د",1,0],["فأركب زوجته وبنيه","وأجلى بإنقاذهم كربه",21,"ب",2,0],["فَاِرَكعَنْ فيها وَسَبِّحْ وَاِذكُرِ","مُخلِصاً للَّهِ مَولى النّعمَةِ",22,"ه",1,0],["فَأَركَبوني صَدرها مُرفّعا","بِغَيرِ نَحلى لَم أَكُن مُشفّعا",23,"ع",2,0],["فاركب جواد الجد في الخيرات","وعمِّر الأوقات في الطاعات",24,"ت",1,0],["فَاِركَب مِن العَزم لِنَيل العُلا","سابق سَبق قط لا يَفترُ",25,"ر",1,0],["فاركض إلى ضحوة المركاض وانس بها","ما كان عندك من وحي الشياطين",26,"ن",1,0],["فاركب سفين نجاة وهي جارية","تقيك باس الهوى حيث المياه طغت",27,"ت",1,0],["فاركب على اسم الله في سرعة","وسر إلى الأقصى وما مله",28,"ل",2,0],["فاركن اليه ولا تخف مستقبلاً","وانعم بحصنٍ للإله حصين",29,"ن",1,0],["فاركبوها فوق أحلاسها","بلا غطا ولا وطا كالإما",30,"م",2,0],["فاركَب سَوَابِقَ اللَّيالِي وَلاَ","تحشَ عِتارَها لِفَرطِ المِرَاح",31,"ح",1,0],["فاركب ذلول الأمر أو صعبه","في فقد جد بك المازح",32,"ح",1,0],["فاركٌ يسامُ الوصالَ فلا كا","نتْ ولا كان وصلُها المَومُوقُ",33,"ق",1,0],["فاركب من التقوى مطيّة عارف","حتى تنال الصفو من أكداره",34,"ر",2,0],["فاركع وهلل للطبيعة خاشعاً","واذكر هناك الواحد القهارا",35,"ر",2,0],["فاِركَبوا اجنحة العلم وَلَو","فوقها صرتم كردف مرتدف",36,"ف",1,0],["فاركعي يا نعاج للذئب خوفاً","والبسي الذل من نسيج العَجاج",37,"ج",1,0],["فاركبي للحقلِ إنِّي الْ","يومَ هيَّأتُ المَطيا",38,"ي",2,0],["فأركزَ في خُضَمِّ البئسِ رُمْحاً","وما أرخَتْ له الطَعَناتُ هُدْبا",39,"ب",2,0],["فاركب لقطع موانع الأحداث لا","يعييك من صد الزمان ركوب",40,"ب",1,0],["فاركب سفينة طاعة تنجو بها","ترسو براكبها ببر أمانِ",41,"ن",1,0],["فارْكعْ لآياتي ورتِّلْ سِرَّها","فبماءِ روحِكَ سُحْنتي تتطبّبُ",42,"ب",1,0],["فاركض بخيرك وامحُ الذنب مغتسلا","واذكر لربك وابقَ العمر متصلا",43,"ل",2,0],["فاركض برجلك هاربا","ماعدتَ في أيدٍ أمينةْ!",44,"ن",2,0],["فاركن الى جبل الغرام تولها","رعشات قلبك للقصيد مزلزله",45,"ل",2,0],["فاركن لبيتٍ مستوقد الصدر","والعجز ثلجٌ في آخر السطر",46,"ر",1,0],["فاركبْ قطارَ اللهِ لا تخش البِلا","في اللَّوحِ قد كتبَ الإلهُ مصيرَهْ",47,"ر",2,0],["فاركنْ لحزنكّ إنَّ الحزنَ مضيعةٌ","واضربْ بشعركَ أخماسًا وأسداسا",48,"س",2,0]]}