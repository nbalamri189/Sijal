","https://www.aldiwan.net/poem54074.html","الطويل"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[416,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[416,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[434,"ولم أنسه إذ قبل الركن خاليا","https://www.aldiwan.net/poem26357.html","الطويل"],[437,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[441,"وداعا وحسبي الله يا عرفات","https://www.aldiwan.net/poem14298.html","الطويل"],[441,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[441,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[441,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[458,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[464,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[464,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[465,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[468,"ألم بي في ليلة بدرها","https://www.aldiwan.net/poem60173.html","السريع"],[477,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[477,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[479,"سلا تونسا عني وعنها سلانيا","https://www.aldiwan.net/poem37589.html","الطويل"],[479,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[551,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[551,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[551,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[551,"فلو انني أنصفت نفسي لصنتها","https://www.aldiwan.net/poem47704.html","الطويل"],[551,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[551,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[551,"على كل حال أنت قاسية القلب","https://www.aldiwan.net/poem48045.html","الطويل"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[587,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["وَلَم أَنسَ يَومَ الجِزعِ حُسناً خَلَستُهُ","بِعَيني عَلى أَنَّ الزِيالَ سَريعُ",0,"ع",1,0],["وَلَمانَعا عَنّي إِذا جَعَلَت","نُوَبُ الزَمانِ تَهيضُ مِن جَلَدي",1,"د",2,0],["وَلَم أَنسَهُ غادٍ وَقَد أَحدَقَت بِهِ","أَدانٍ تُرَوّي نَعشَهُ وَأَقارِبُ",2,"ب",1,0],["وَلَمْ أَنْظِمِ الشِّعْرَ عُجْباً بهِ","وَلَمْ أَمْتَدِحْ أَحَداً عَنْ أَرَبْ",3,"ب",1,0],["ولمْ أنْسَ إذ عانَقْتُها لوَداعِنا","فخالَطَ دُرَّ العِقْدِ جوْهَرُ أدْمُعي",4,"ي",1,0],["وَلَم أَنفَكُّ إِذ عَدَتِ العَوادي","إِلَيكَ رَهينَ شَوقٍ وَاِلتِياحِ",5,"ح",1,0],["وَلَم أَنسَ مِن سَعدٍ بِقُصوانَ مَشهَداً","وَبِالأُدَمى ما دامَتِ العَينُ تَطرِفُ",6,"ف",1,0],["وَلَم أَنسَ يَوماً بِالعَقيقِ تَخايَلَت","ضُحاهُ وَطابَت بِالعَشِيِّ أَصائِلُه",7,"ل",2,0],["ولم أنس يوم البين إيماءَ طرفها","وعيس المطايا للفلاة جوانح",8,"ح",1,0],["ولم أنس من دار السعادة صحبة","مباركةَ الاثنينِ تطلع أوحدا",9,"د",2,0],["ولم أنس مسرى نعشه يوم جمعة","تجمع هماً كالخميس إذا سرى",10,"ر",2,0],["ولم أنسَ ليلات الكنافة قطرها","هو الحلو إلاَّ أنه بالسحب الغزر",11,"ر",1,0],["ولم أنس في رسم الأحبة موقفاً","أضفت به للجسم سقماً إلى سقم",12,"م",1,1],["ولم أنس مسرى شمسها وهي طلعة","يحفُّ بها شهب الوغى وهو خرصان",13,"ن",1,0],["ولم أنسَ ما لاقيتُ أيامَ صحوِهِ","من الصّرِّ فيه والثلوج الأشاهبِ",14,"ب",1,0],["وَلَمّا نَأى الغاياتُ جَدّا كِلاهُما","فَلا وِردَ إِلّا دونَ ما يَرِدانِ",15,"ن",1,0],["وَلَم أَنسَ مَصرَعَ تيتانِكٍ","وَمَصرَعَنا يَومَ طارَ النَبا",16,"ب",2,0],["وَلَم أَنَل مِنكُمُ شَيئاً سِوى تُهَمٍ","تُقالُ مَشروحَةً فينا وَمُختَصَرَه",17,"ر",2,0],["ولمَّا ندبتُ ولم ينفعِ","ونَادَيْتُ أُمِّي فلمْ تسمعِ",18,"ع",1,0],["ولم أنسَ يوماً بالحِمى طابَ ظلُّه","ونلْنَا به عَذْباً من العيش صافيا",19,"ي",2,0],["ولم أنسَها والموتُ يقبِضُ كفَّها","ويبسُطُها والعينُ ترنُو وتُطْرِقُ",20,"ق",1,1],["وَلَم أَنسَ لَيلَتَنا في العِنا","قِ لَفَّ الصَبا بِقَضيبٍ قَضيبا",21,"ب",2,0],["وَلَم أَنسَهُ يَطفو وَيَرسُبُ تارَةً","وَيَظهَرُ لِلرائينَ ثُمَّ يَغيبُ",22,"ب",1,0],["وَلَم أَنسَهُ إِذ قامَ ثانِيَ جيدِهِ","إِلَيَّ وَإِذ مالَت عَلَيَّ ذَوائِبُه",23,"ب",2,0],["وَلَم أَنسَ أَيّاماً بِيَثرِبَ لَم تَجِد","لَها أُخَرُ الأَيّامِ حُسناً تَزيدُها",24,"د",3,0],["وَلَمّا نَزَلنا عُكبَراءَ وَلَم يَكُن","نَبيذٌ وَلا كانَت حَلالاً لَنا الخَمرُ",25,"ر",1,1],["وَلَم أَنسَ إِسعافَ الكَرى بِدُنُوِّها","وَزَورَتَها بَعدَ الهُدُوِّ وَما تَدري",26,"ر",2,0],["وَلَم أَنسَ وَحشَ القَصرِ إِذ ريعَ سِربُهُ","وَإِذ ذُعِرَت أَطلاؤُهُ وَجَآذِرُه",27,"ر",2,0],["وَلَم أَنسَنا عِندَ التَلاقي وَضَمَّنا","سَوالِفُ نَحرٍ مِن مَشوقٍ إِلى نَحرِ",28,"ر",1,0],["وَلَم أَنسَ إِذ راحوا مُطيعينَ لِلنَوى","وَقَد وَقَفَت ذاتُ الوِشاحَينِ وَالوَقفِ",29,"ف",1,0],["وَلَم أَنسَها عِندَ الوَداعِ وَنَثرُها","سَوابِقَ دَمعٍ أَعجَلَت أَن تَنَظَّما",30,"م",2,0],["وَلَمّا نَبَت بي الأَرضُ عُدتُ إِلَيكُمُ","أَمُتُّ بِحَبلِ الوُدِّ وَهوَ رِمامُ",31,"م",1,0],["وَلَم أَنتَهِ حَتّى أَحاطَت خَطِيئَتي","وَرائي وَدَقَّت لِلدُهورِ عِظامي",32,"م",2,0],["ولم أنسَ يومي بِقُطرُبُّلٍ","وليلي على القُفْصِ أو عُكْبَرا",33,"ر",2,0],["وَلَم أَنسَ إِذ زارَ الحَبيبُ بِرَوضَةٍ","وَقَد غَفَلَت عَنّا وُشاةٌ وَلُوّامُ",34,"م",1,1],["وَلَم أَنسَ لي في دَيرِ سَهلانِ لَيلَةً","بِها السُحبُ تَبكي وَالبَوارِقُ تَضحَكُ",35,"ك",1,0],["وَلَمّا نَظَمتُ الشِعرَ فيكَ قَلائِداً","تَمَنَّت نُجومُ اللَيلِ لَو أَنَّها شِعرُ",36,"ر",1,0],["وَلَمّا نَضا ثَوبَ الحَياةِ وَأَوقَعَت","بِهِ نائِباتُ الدَهرِ ما يُتَوَقَّعُ",37,"ع",1,0],["وَلَم أَنسَ سَعيَ الجودِ خَلفَ سَريرِهِ","بِأَكسَفِ بالٍ يَستَقيمُ وَيَظلَعُ",37,"ع",1,0],["وَلَم أَنسَ ما قالَت وَإِن شَطَّتِ النَوى","بِها وَأَميرٌ ما يَزالُ شَتومُ",38,"م",1,0],["وَلَم أَنتَظِرهُم يَدهَموني تَخالُهُم","وَرائِيَ نَحلاً في الخَلِيّاةِ واكِنا",39,"ن",2,0],["وَلَم أَنسَ قُمرِيَّ الحَمامِ عَشِيَّةً","عَلى فَرعِها تَدعو الحَمامَ البَواكِيا",40,"ي",2,0],["وَلَم أَنسَ وَقَد زُمَّت","لَوَشكِ البَينِ أَظعانُ",41,"ن",1,0],["وَلَمّا نَأَوا عَنّي بِوِدِّ نُفوسِهِم","غَلَبتُ حَنيني نَحوَهُم وَنِزاعي",42,"ع",2,0],["ولم أنْسَها تَثني يدَي بمُطَرَّفٍ","لطيفٍ على المِسْواك مُختضِبٍ بدَم",43,"م",1,0],["ولم أنسَ منها نَظرةً حينَ ودَّعَتْ","وقد مُلِئَتْ دَلوُ الصّباح إلى الوَذَم",43,"م",1,0],["ولم أَنْسَ بالنَّاوُوس أَيَّامَنا الأُلَى","بها أَيْنُنا مَحْبُوبُها وحَبَابُهَا",44,"ب",3,1],["وَلَم أَنسَ وَجدي إذا تَشَهَّدت مُخلِصاً","وَصَوتُكَ ممّا رقّ بِالسقمِ قَد خَفي",45,"ف",2,0],["ولمَّا نَمَتْ عندي من اللَّه أنعُمٌ","ولستُ عن الشكرانِ للّهِ باللّاهي",46,"ي",1,1],["وَلَمْ أَنْسَ نَلِّينُو وقَدْ جَاء فَيْصَلاً","بِحُجَّةِ بَحَّاثٍ وَرَأْيِ مُحَقِّقِ",47,"ق",1,0],["ولم أَنس، عهدًا، عهدُ «نيرون»دونه","إذا أحصيت يوم الحساب كبائره",48,"ر",2,0],["ولما نعى الناعي الدًُّسوقيَّ، أمسكت","سماءُ الحمى حزنًا، وسالت محاجره",48,"ر",2,0],["ولم أنْسَ أن العروبة كانت","سواعدَ مصر وأعْضَادها",49,"د",3,0],["ولم أنس جِلِّقَها حين مدَّت","يَدَيْهَا، ولم أنس بغدادها",49,"د",3,0],["ولم أنس إذ عانقتها لوداعنا","فخالط در العقد جوهر أدمع",50,"ع",1,0],["ولَمْ أَنْتَظِرْ أنْ يَدْهَمُونِي كَأنَّهُمْ","وَرَائِي نَحْلٌ فِي الخَلِيَّةِ وَاكِنَا",51,"ن",2,0],["ولم أنس يوم السفح اذ طلَّه الندى","ولا كأس الا طرفه فأداره",52,"ر",2,0],["ولم أنسى أياماً بيثرب لم تجد","لها آخر الأيام حسناً تزيدها",53,"د",3,0],["ولم أنس مصرع \" تيتانيك \"","ومصرعنا يوم طار النبا",54,"ب",2,0],["وَلَم أَنسَ ما قَد قالَ والِدي الَّذي","تَعوض عَن دُنياهُم بِجِنانِ",55,"ن",1,0],["ولما نأى قِسْ بالذي دنا وادنُهُ","فإذا فعلت لذاك نلت المحتما",56,"م",2,0],["ولم أنسَ أياماً لنَا وليالياً","حساناً نقضِّيها على رَغم حُسَّدِ",57,"د",1,0],["ولم أنسَ أيامَ العتاب وإذ أنا","أُكَتِّمُ سِرِّى في الهوى وهْي تُوَضِّحُ",58,"ح",1,0],["ولَم أُنطِق بِمُكتَتَمٍ لِسَاني","لأعدَائِى ولَو قَطَعُوا اللِّسَانَا",59,"ن",2,0],["وَلَم أَنسَ قَولَ اِبنَةِ المالِكِيِّ","لِسَلمى وَأَدمُعُها تَنسَكِب",60,"ب",1,0],["وَلَمّا نَفى بِالعِلمِ جَهلَ الأَوائِلِ","ضَمَمنا يَدَ التَحقيق عَن كُلِّ باطِلِ",61,"ل",1,0],["ولم أنه إلا عن فعال أتاكم","من الله عنه كل ناه وزاجر",62,"ر",1,0],["ولمّا نشرتُ أَفاويقَها","طَوى الناسُ دِيباجَةَ البُحتريّ",63,"ي",1,0],["وَلَم أَنزِل بِزِعنِفَةٍ لَئيمٍ","يَصُرُّ لِوَفدِهِ النُكدَ الجِلادا",64,"د",2,0],["وَلمَّا نَعى في أَرضِ لُبنانَ أَوشَكَت","جَنادِلُهُ مِن حَسرةٍ تَتَألَّمُ",65,"م",1,0],["ولم أَنْسَهُ والدهرُ طَلْقٌ جبينُهُ","وريحانُهُ",66,"ه",1,0],["ولم أَنْسَهُ والسُّقْمُ يَنْهَبُ جِسْمُهُ","وآلامُهُ في كلِّ يومٍ تَزَيَّد",66,"د",1,0],["ولم أَنْسَه والموتُ جاثٍ أمامَهُ","وعامِلُهُ ذَلْقُ الغِرارِ مسدّد",66,"د",1,0],["ولم أَنْسَه والنعشُ قد صار روضةً","تَبَسَّمُ عنْ ذِكرٍ يُغيرُ ويُنجد",66,"د",1,0],["ولم أنسَ يوماً جئتها ذاتَ صبحة","عليلاً كما هبَّ النسيمُ بلا وعدِ",67,"د",1,0],["ولم أنسَ ساعةَ أبصرتُها","وجسم النهارِ كجسمي نحيلْ",68,"ل",1,0],["ولم انضِ الكؤوسَ محجلاتٍ","تخفُّ بها إلى الهم الطلاءُ",69,"ا",2,0],["ولم انس اذ ودعتها ومدامعي","عقود غدت في جيدها تتنظم",70,"م",1,0],["ولما نسيتم ودّنا وغرامنا","ولم تحفظوا بعد الفراق لنا عهدا",71,"د",2,1],["ولم أنحرف عن سجايا المعِزّ","وقائمة يوم تقريرها",72,"ر",3,0],["وَلَم أَنسَ طَيرَ القُرن لَيلَةَ زارَني","وَقَد حَلَّ في دَوحِ الوِصالِ وَعَشَّشا",73,"ش",2,0],["وَلَم أَنسَ إِذ فاتَحتهُ في وِصالِهِ","لَعَلِّيَ أَن أَحظى بِهِ لَيلَةً ضَمّا",74,"م",2,0],["وَلَم أَنسَ يَومَ النَوى وَالرَحيل","وَلِلوَجدِ بَينَ الضُلوعِ اِضِطِرام",75,"م",1,0],["وَلَم اَنسَ يَومَ البَينِ إِذ قالَ صاحبي","وَقَد أُشعِلَت نارُ الغَضا وَتَضَرَّمَت",76,"ت",1,1],["وَلَم أَنسَها كالظَبي لَيلَةَ أَقبَلَت","تُهادي وَمِن أَترابِها حَولَها سِربُ",77,"ب",1,0],["وَلَم أُنكَح لَئيماً بنت فِكري","وانكاحُ اللِئام مِن السِفاحِ",78,"ح",1,0],["وَلَم أَنسها يَومَ النَوى إِذ تَحَجَّبَت","وَقَد غَفلَ الواشي وَغابَت عيونُها",79,"ن",3,0],["ولمّا نالنا معروف قومٍ","بهم عوجٌ خفيٌّ كالمنارَهْ",80,"ر",2,1],["ولم أنس لا أنسى وداعك والنوى","عسوف بقلبينا المشوقين سائقه",81,"ق",2,0],["ولم أنسه يوماً وجيشك مقبل","على حلب إقبال مشف على مضن",82,"ن",1,0],["ولم أنس ليلا ما تبلج صبحه","ولا لاح في يافوخه وخط شائب",83,"ب",1,0],["ولم أنس إذ غازلته قرب روضة","إلى جنب حوض فيه للماء منحدر",84,"ر",1,0],["ولم أنسَ يوماً فيه جئتُكِ زائراً","فقلتُ ألا هبِّي فقلتِ قفا نبك",85,"ك",1,0],["وَلَم أَنسَهُ إِذ ماسَ وَاِهتَزَّ رِدفُهُ","فَحارَت وَغارَت مِنهُ كُثبٌ وَأَغصانُ",86,"ن",1,0],["ولم أنس يوما فجعنا به","وفقد الشبيبة كم يفجع",87,"ع",1,0],["وَلَم أَنسَها وَالبينُ ينعقُ بيننا","وَنارُ الجوى بين الجوانح تُضرَمُ",88,"م",1,0],["وَلَمّا نَعى الناعي به ضاق بي الفضا","وَراحَت دموعي الجامداتُ تَسيلُ",89,"ل",1,0],["وَلَم أَنسَ أَيّاماً نعِمتُ بقُربِه","وَغيسانُ عُمري منه في نعم عيسِ",90,"س",1,0],["وَلَم أَنسَ أَيّامنا في مِنىً","وَموقفَنا حَيثُ نَرمي الجِمارا",91,"ر",2,0],["وَلما نزلنا حمص يمَّمتُ (خالداً)","أُحيي به عهد الفتوحات زاهيا",92,"ي",2,0],["ولم أنس إذ ودعوني ضحاً","وقد مطرتنا سحاب البكاء",93,"ا",2,1],["ولما نأيتم لم أزل مترقباً","مطالعكم في غدوةِ ومساءِ",94,"ا",2,1],["ولم انت قلبي تظل أسير الأ","ماني وعبد الهوى والوهم",95,"م",1,0],["وَلَمّا نَزَلنا وادِيَ القُدسِ أَشرَقَت","عَلَينا شُموسُ الإِنسِ مِن بَعدَ وَحشَةِ",96,"ه",1,0],["ولم أنسَ الرّكائبَ وهْي تُحْدَى","وقد عزَموا معَ الصُّبْحِ انطِلاقا",97,"ق",2,0],["ولم أنْسَها يومَ الرَّحيلِ وقد لَوتْ","بتَسليمةِ التّوديع حاشيةَ السِّتر",98,"ر",1,0],["ولم أنسَها يومَ النّوى ودموعُها","تَحدَّرُ والأنفاسُ منها تَصعَّد",99,"د",1,0],["ولم أنسَها لمّا تَغنّتْ حُداتُهم","وللعيسِ من تحتِ الرحالِ هِباب",100,"ب",1,0],["وَلَم أَنتَفِع مِن حُسنِهِ بِيَقينِهِ","لَدَيهِ وَأَخشى مَن عَفائي بِظَنِّهِ",101,"ن",2,0],["وَلَم أَنسَ ذاكَ اللُطفَ وَالبَحرُ مُخلِفٌ","وَلا نورَ ذاكَ البِشرِ وَالعَيشُ كالِحُ",102,"ح",1,0],["وَلَمّا نَضا الأَستارَ عَن نورِ وَجهِهِ","تَغَطَّيتُ مِن دَهري بِظِلِّ جَناحِهِ",103,"ح",2,0],["وَلَم أَنَل في حُبِهِ","إِلّا الأَسى وَالأَسَفا",104,"ف",2,0],["وَلَم أَنسَهُم وَالعيس تَحدج لِلنَوى","وَقَد نعبت عِندَ الفُراق نَواعيهِ",105,"ه",1,0],["وَلَم أَنسَ إِذ أَحيا قَتيل صُدوده","وَقَد زارَ مِن خَوف الوُشاةِ عَلى زَعر",106,"ر",1,0],["ولما نأت داري وشطت مسافتي","جعلت كتابي نائبا عن زيارتي",107,"ي",1,1],["ولمْ أنْتَهِج إلاَّ إليكِ طريقها","ولمْ أصْطَحِبْ إلاَّ الرِّضا عنكِ والبُشرى",108,"ر",2,0],["ولم أنسَ إذ زارتْ وسادي وقد غدا","عليها من اللّيل البهيم لَبوسُ",109,"س",1,1],["ولم أنسَ خمراً من لماه شربتُها","لها حببٌ من درّ ثغرٍ منضّدِ",110,"د",1,0],["ولم أنس يوماً زرتُه وهو نائمٌ","وشوقي إليهِ جاذبٌ بزمامي",111,"ي",1,0],["ولم أَنْس في نعمان يوماً جنيتَ مِنْ","أزاهرِ خدّيهِ شقائق نعمانِ",112,"ن",1,0],["وَلَم أَنسَها يَومَ التَقى درُّ دَمعها","وَدُرُّ الثَنايا فَذُّها وَتؤامُها",113,"م",3,0],["وَلَم أَنسَها وَالبَينُ يُجري دموعها","عَلى مشرق لِلعَين فيهِ مُرادُ",114,"د",1,0],["وَلَم أَنسَها يَومَ النَوى وَقَد التَقى","جمانان جاري دَمعها وَعُقودُها",115,"د",3,0],["وَلَم أَنسها تصفرُّ من غربة النَوى","كَما اصفرَّ وجه الشَمس ساعَة تغربُ",116,"ب",1,0],["ولم أَنْسَ إذ زارت بليلٍ تَبَوَّأَتْ","وشاةُ الهوى منه مقاعد للسمع",117,"ع",1,0],["ولم أنسَ إذ زارتْ على حين غفلةٍ","تميسُ كغصن البان بالحلي مورق",118,"ق",1,0],["ولم أَنْسَ إدلاج الرفاق بليلةٍ","يَضِلُّ بها النجم السبيلَ ضلالا",119,"ل",2,0],["ولم أنسَ لا أنسى الدِّيار الَّتي عَفَتْ","طلول لها تشجي المشوق وأَرسُمُ",120,"م",1,0],["ولم أنسَ لا أنسِيتُ في كلِّ ضامر","وقوفي على ربع الظمياء داثر",121,"ر",1,0],["ولمَّا نشدت العدل من بعد طيِّه","وأحسنتَ طيَّ الجور في ذلك النشر",122,"ر",1,0],["ولما نزلنا ليلة الخيف بالنقا","وفاضت على أطلال رامة أدمع",123,"ع",1,0],["وَلَمْ أنْسَهُ إِذْ قَبَّلَ الرُّكْنَ خالِياً","وَوَضْعُ فَمي مِنْهُ على مَوْضِعِ الْفَمِ",124,"م",1,1],["ولم أنس ليلتنا بالكثب","إذ شملنا معها في كثب",125,"ب",1,0],["ولم أنس من جمع غداة وداعه","وقد جمعت عندي به الكربات",126,"ت",1,0],["ولم أنس بالمعلاة منا نوادبها","وإصدارنا منها رواة ووردنا",127,"ن",2,0],["ولما نظرناها استطارت عقولنا","لها هيبة تبتز أحشاء من رنا",127,"ن",2,0],["ولما نزلنا واجتمعنا بجمعنا","لجمع الحصى السبعين عدّاً لرمينا",127,"ن",2,0],["ولما نحرنا في منى يوم نحرنا","قصدنا إلى ليلى لنوجب حلنا",127,"ن",2,0],["ولم أنظر لمن قد أه","لكته البيض والسود",128,"د",1,0],["ولما نعى الناعي بها فكأنني","لكعب بن سلمى وهي في الفقد أيرد",129,"د",1,0],["ولما نبت بالملك دارُ قرارِهِ","ومال عليه منهم الفاجرُ الغِرُّ",130,"ر",1,0],["ولما نحرت الدمعَ نح","رَ قرى على تلك المنازلْ",131,"ل",1,0],["ولم أنسهُ ملء الإزار منحتهُ","فلم آت وزراً بل شددت به أزري",132,"ر",2,0],["ولم أنتظرْهُم إلى أن تَد ور","عليكَ دوائرُهُم يا دمي",133,"م",2,0],["وَلَم أَنَل مِنهُ سِوى رُؤيَةٍ","حَلَت فَكانَت في فَمي شَهدا",134,"د",2,0],["ولمّا نأتْ تلكَ الحُدُوجُ وطوَّحتْ","بهنَّ نوًى تُنضي النياقَ شَعُوبُ",135,"ب",1,0],["ولمّا نأى ذاكَ الفريقُ عنِ الحِمى","وسارتْ تؤمُّ المازِمَيْنِ مطاياهُ",136,"ا",2,0],["ولم أنس تسئال الحبيبة لي وقد","تدانت لي الخضرا لتصغي جوابيا",137,"ي",2,0],["ولم أنس الذي ما زار حتى","أراني الأريحية من همام",138,"م",1,0],["ولم أنسَ في المَيْناتِ يومَ تجمّعتْ","قبائِلُ أحزابِ العِدا والعشائِرُ",139,"ر",1,0],["ولِمْ أنتَ لمن عاهد","تَ أوْ عاقدتَ خَوّانُ",140,"ن",1,0],["ولمّا نبا زيدٌ عن الطّيبِ عهدُه","نبوتُ وفي قلبي من الوَجْدِ جَمُّهُ",141,"م",2,0],["ولمّا نعاك النّاعيان تهاطَلَتْ","بوادرُ ما كانتْ لغيرك تهطِلُ",142,"ل",1,0],["ولم أنجُ من سوءٍ أصابَ معاشري","وعاج بخلٍّ أرتضيه وطافا",143,"ف",2,0],["ولِمْ أنا مرتاعٌ لما يجلبونَهُ","وما زلتُ في الأقوامِ غيرَ مُروَّعِ",144,"ع",1,0],["ولمّا نهضتَ بدفعِ الخطوبِ","رضيتَ بما لم يكن يُدفَعُ",145,"ع",1,0],["وَلَمّا نَبَتْ آراؤهمْ وأَظَلَّهم","مِنَ الأمرِ مسوَدُّ المخايِلِ رائعُ",146,"ع",1,0],["ولم أنْسها يومَ الفراقِ ووجهُها","يُضيءُ لَنا خلفَ البراقعِ والحُجْبِ",147,"ب",1,0],["ولِمْ أَنا راض أَن أُرَى وَاطِئَ الثَّرى","ولي هِمَّةٌ لا ترتضي الأُفْقَ مَقْعَدا",148,"د",2,0],["ولما نمى الركبان أخبار موته","وأصبح ناعي الدين فينا مناديا",149,"ي",2,0]]}