"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[106,"في مهرجان العلم","https://www.poetsgate.com/ViewPoem.aspx?id=179765",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[77,"أما وخيال في المنام يزور","https://www.poetsgate.com/ViewPoem.aspx?id=34134",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"إلى روح العلامة الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=179049",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[45,"وراءك عني يا عذول الأشايب","https://www.poetsgate.com/ViewPoem.aspx?id=33108",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[80,"جناحيَ محلولٌ وجيديْ مُطَوَّقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=3671",""],[80,"نحنُ في جَنَّة ٍ نُباكِرُ منها","https://www.poetsgate.com/ViewPoem.aspx?id=3077",""],[91,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""],[38,"إنِّي أتَانِي كَلاَمٌ مَا غَضِبْتُ لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=21243",""],[51,"إذا حَسُنتْ أخلافُ قومٍ فبِئْسما","https://www.poetsgate.com/ViewPoem.aspx?id=29054",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[31,"ذهبَتْ ولَمْ تُلْمِمْ بديباجَة ِ الحَرَمْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19054&r=&rc=317",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19021&r=&rc=284",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["جَناني شُجاعٌ إِن مَدَحتُ وَإِنَّما","لِسانِيَ إِن سيمَ النَشيدَ جَبانُ",0,"ن",1,1],["جُنونَ المُرشِقاتِ غَداةَ جَمعٍ","بِأَقتَلَ مِن نِبالِكَ ما رُمينا",1,"ن",2,0],["جُنونُ شَبيبَةٍ وَوَقارُ شَيبٍ","خُذا عَنّي النُهى وَدَعا الجُنونا",1,"ن",2,0],["جُنِنتُ بَأساً وَالشَجاعُ جِنّي","أَثارَ طَعنَ الدَهرِ في مِجَنّي",2,"ي",1,0],["جَنَيتُ مِن قَبلُ وَسَوفَ أَجني","أَثني يَدي وَالعَزمُ أَن أُثَنّي",2,"ي",1,0],["جَنى وَتَجَنّى وَالفُؤادُ يُطيعُه","فَيَأمَنُ أَن يُجنى عَليهِ كَما يَجني",3,"ي",1,1],["جِنايَةُ الدَهرِ لَهُ عادَةٌ","فَما لَنا نَعجَبُ لَمّا جَنى",4,"ن",2,0],["جِنٌّ إِذا تَعانَقَ ال","أَبطالُ بِالبيضِ الخُذُم",5,"م",1,0],["جِنَّيَّةٌ وَقَبيلُها بَشَرٌ","عَظُمَ البَلاءُ بِها عَلى الإِنسِ",6,"س",1,0],["جَنادِلُ مِن قَبرٍ كَأَنَّ صُدورَها","حَباهُ الحَيا دونَ القُبورِ مَحارِبا",7,"ب",2,0],["جَنَحنَ حَيارى لِلمَغيبِ كَأَنَّها","نَواظِرُ مَسَّتْها الكَلالَةُ حُولُ",8,"ل",1,0],["جُنونُكَ مَجنونٌ وَلَستَ بِواجِدٍ","طَبيباً يُداوي مِن جُنونِ جُنونَ",9,"ن",1,1],["جَنازَةُ جَعْسوسٍ أثارَتْ غَريبَةً","عَداها الرِّضَى منْ جِيفَةٍ وتخطّاها",10,"ا",3,1],["جُنِنْتُمْ بِما يَفْنَى وتبْقَى مَضاضةٌ","تُعَذِّبُ بعْدَ البَيْنِ مُهْجَةَ مُشْتاقِ",11,"ق",1,0],["جَنىً حَانَ وَالنَّصْرُ الْعَزِيزُ اهْتِصَارُهُ","إِذَا انْتَظَمَتْ بِالقَلْبِ مِنْهَا جَنَاحَانِ",12,"ن",1,0],["جَنى النّسيمُ عليّ","وما تبيّنتُ غدْرَهْ",13,"ه",1,1],["جَنَيْتُ النّوى لا عنْ مَلالٍ ولا قِلىً","فمِثْلي بمَوْصولِ المَلامِ جَديرُ",14,"ر",1,0],["جِنانٌ بَيْنَهُنّ الحورُ تَمْشي","أحَقّاً هَذِهِ دارُ الخُلودِ",15,"د",1,0],["جَنَيتَ عَلَيَّ الذَنبَ ثُمَّ خَذَلتَني","عَليهِ فَبِئسَ الخَلَّتانِ هُما مَعا",16,"ع",2,0],["جُندُكَ التالِدُ العَتيقُ مِنَ ال","ساداتِ أَهلِ القِبابِ وَالآكالِ",17,"ل",1,0],["جَنَيتُ عَلَيكِ يا نَفسي وَقَبلي","عَلَيكِ جَنى أَبي فَدَعي عِتابي",18,"ي",1,0],["جَنَّدَ الماءَ وَالثَرى لِهَلاكِ ال","خَلقِ ثُمَّ اِستَعانَ بِالنيرانِ",19,"ن",1,0],["جَنَى الجَمالُ على نَصرٍ فغَرَّبَه","عَنِ المَدينةِ تَبكِيه ويَبكيها",20,"ي",3,0],["جَنَّةٌ تَبعَثُ الحَياة وَتَجلو","صَدَأَ النَفسِ رَونَقاً وَنِظاما",21,"م",2,0],["جُنَّ فَمِن خَوفٍ عَلَيهِ غَدا","مُسلسلاً مِن كُلِّ أَبوابِهِ",22,"ب",2,0],["جَنَحوا إِلى قَولِ الوُشاةِ فَأَعرَضوا","وَاللَهُ يَعلَمُ أَنَّ ذلِكُ مُفتَرى",23,"ر",2,0],["جَنابٌ واسِعُ الأَكنافِ سَهلٌ","وَظِلٌّ في مَنادِحِهِ ظَليلُ",24,"ل",1,0],["جنوبٌ تُسامي أَوجُهَ الرَكبِ مسُّها","لَذيذٌ وَمَسراها مِنَ الأَرضِ طَيِّبُ",25,"ب",1,0],["جَنى لأَبي حَفصٍ ذُرَى المَجدِ والدٌ","بَنى دونَهُ لِلبانِيَينِ صُعوبُ",26,"ب",1,0],["جنه عند جنه عند أخرى","آهٍ لو ظل حبلها في اتصال",27,"ل",1,0],["جَنَّةٌ أُصْلِحَتْ فآتَتْ جَنَاهَا","وَزَكَا رِيْعُهَا بِغَيْرِ حِسَابِ",28,"ب",1,0],["جُن فِيهَا وَقَبْلَهُ","جُنَّ قَيسٌ مِنَ الهَوَى",29,"و",2,0],["جُنُودٌ لا عِدَادَ لَهَا","بِهَا غَضَّتْ نَوَاحِيهَا",30,"ي",3,0],["جَنَّاتِ مِصْرَ سَقَاكَ النِّيْلُ حَيْثُ جَرَى","خَصْباً وَأَغْنَاكِ عَنْ هَتَّانَةِ المُزَنِ",31,"ن",1,0],["جَنَّاتِهَا مُهَجٌ أَنْمَى نَدَاكَ بِهَا","أَزْهَى الأَفَانِينِ مِنْ وُدٍّ وَشُكْرَانِ",32,"ن",1,0],["جُنْدٌ مِنَ الْجِنِّ مَهْمَا أُجْهِدُوا نَشِطُوا","كَأَنَّمَا الْوَهْيُ بِالأَعْدَاءِ دُونَهُمُ",33,"م",1,0],["جَنَّةٌ بَانَتِ المَكَارِهُ عَنْهَا","وَهْيَ بِكْرٌ مِنَ الأَذَى وَالمَحَارِمْ",34,"م",1,0],["جَنوبٌ ذَوَت عَنها التَناهي وَأَنزَلَت","بِها يَومَ ذَبّاتِ السَبيبِ صِيامِ",35,"م",1,0],["جُنوحٌ عَلى باقٍ سَحيقٍ كَأَنَّهُ","إِهابُ اِبنِ آوى كاهِبُ اللَونِ أَطحَلُ",36,"ل",1,0],["جَنَحنَ عَلى أَجوازِهِنَّ وَهَوَّموا","سُحَيراً لَدى أَعضادِهِنَّ الأَياسِرِ",37,"ر",1,0],["جَنَحَ الأَصيلُ وَقَد قَضَينا لِتَغلِبٍ","نَحباً قَضَينَ قَضائُهُ وَنُذورا",38,"ر",2,0],["جُنوحَ الهالِكيِّ عَلى يَدَيهِ","مُكِبّاً يَجتَلي نُقَبَ النِصالِ",39,"ل",1,0],["جنادِعَ مِن قَوَارِصَ لَم تَجَاوَز","أَغَانيَّ الذُّبَابِ وَلاَ الطَّنِينَا",40,"ن",2,0],["جَنى جانٍ وَأَنتَ عَلَيهِ حانٍ","وَعادَ فَعُدتُ بِالكَرمِ الغَزيرِ",41,"ر",1,1],["جَنَبتُ إِلى مَهري المَنيعِيِّ مُهرَهُ","وَجَلَّلتُ مِنهُ بِالنَجيعِ نِجادِ",42,"د",1,0],["جَنانِيَ ما عَلِمتَ وَلي لِسانٌ","يَقُدُّ الدَرعَ وَالإِنسانَ عَضبُ",43,"ب",1,0],["جِنِّيَّةٌ أَرَّقَني طَيفُها","تَذهَبُ صُبحاً وَتُرى في المَنام",44,"م",1,0],["جَنبي يَقيكَ التُربَ لَهفي لَيتَني","غُيِّبتُ قَبلَكَ في بَقيعِ الغَرقَدِ",45,"د",1,0],["جنينة التين وجيرانها","قد طيَّبت لذَّاتها وقتي",46,"ي",1,1],["جنيت بالتقبيل من خدّه","ورداً وعاتبت على الصد",47,"د",1,1],["جنيتم كلّ ضامرةٍ لعيش","فرار الورق قدّام الصقور",48,"ر",1,0],["جنَّة عيشٍ أكلها","دائمٌ ظلّ وبكر",49,"ر",1,0],["جُنَّ الغمام الذي حاكى مكارمه","أما تراه على وجه الثرى يقع",50,"ع",1,0],["جننت يا غيثُ متى شئت أن","تحكِي أيادِيه فطِرْ أوقَع",51,"ع",1,0],["جنَّة في ظلّ سيف قادم","وكذا الجنَّات في ظلِّ السيوف",52,"ف",1,0],["جند العساكر في جند يجهزه","ونعم جند الدّعا حُنْدس الظلم",53,"م",1,0],["جنَّ الذي يبغي مقامك في العلى","ويروم شأوك والجنون فنون",54,"ن",1,0],["جنَّ الدُّجى واشتقتُ حسنك","وقرعت يا ذا العدل سنَّكْ",55,"ك",1,0],["جنَّة من دمشق نرتعُ فيها","ولنا الرزق بكرةً وعشيّا",56,"ي",2,0],["جنابه عن جاره لا ينكب","وباب نجح للمنى مجرَّب",57,"ب",1,0],["جنيتُ نارَ الأسى بجنَّتها","وصُحت من صبوتي بوجنتها",58,"ه",2,0],["جناب إذا راده رائد","رأى المسك عند ثراه مَلابا",59,"ب",2,0],["جُنّة حِرْزٍ إذا تدرَّعها","لقائلِ الهُجْر نَهْنَهَتْ ظُفُرَه",60,"ر",2,0],["جنةٌ تُذْكِرُ بالجنْ","نَة قلباً ذا اعتبار",61,"ر",1,0],["جَنَوا لكُم أن تُمدَحوا وجنيتُمُ","لموتاكُمُ أن يُشتَموا في المقابر",62,"ر",1,0],["جُنَنٌ يقينَ إذا سلبن وما وقى","عرضَ الكريم كملبسٍ مخلوع",63,"ع",1,0],["جناحانِ خفَّاقانِ خفقاً مُحَثْحثاً","ورِجلان لا تَسْتَحْسِران إذا اعتَزَمْ",64,"م",1,0],["جَنَّحتَني كَيما أَطيرَ فَلَم أَطِر","هَيهاتِ إِنَّكِ قَد طَوَيتِ سَمائي",65,"ي",1,0],["جَنِّبوني الفَناءَ في الديدانِ","إِنَّهُ المَصرَعُ الكَريه",66,"ه",1,0],["جَنَّةً لَفَّها الثَرى","بَِلظَلامِ المُؤَبَّدِ",67,"د",1,0],["جَنى عَلَيها الَّذي تَخشى وَقاطَعَها","كَأَنَّما قَد جَنَت ما لَيسَ مُغتَفَرا",68,"ر",2,0],["جُنَّت مِنَ الرُعب وَالأَحزانِ فَاِنتَحَرَت","ما حَبَّتِ المَوتَ لَكِن خافَتِ الوَضَرا",68,"ر",2,0],["جُنَّ القَضاءُ فَغالَ حُسنَكِ قُبحُهُ","وَأَذَلَّ أَبناءُ الطَغامِ بَنيكِ",69,"ك",1,0],["جَنَحَت ذُكاءُ الغُروبِ كَأَنَّما","تَبغي رُقاداً أَو تُريدُ مَقيلا",70,"ل",2,0],["جَنَّةُ أَحلامي وَأَحلامِها","وَدارُ حُبّي وَتَصابيها",71,"ي",3,0],["جَنَت عَلى نَفسي وَأَحلامِها","جِنايَةَ الشَوكِ عَلى الوَردَةِ",72,"ه",1,0],["جَنَّنتَهُ وِلايَةٌ","قَلَّ فيها مُسالِمُه",73,"م",2,0],["جَنَت لِيَ هَذا الشَيبَ ثُمَّ تَجَنَّبَت","فَواحَرَبا مِمَّن جَنى وَتَجَنَّبا",74,"ب",2,0],["جُنادِفٌ لاحِقٌ بِالرَأسِ مَنكِبُهُ","كَأَنَّهُ كَودَنٌ يوشى بِكُلّابِ",75,"ب",1,0],["جنحت للغروب شمس نهاري","ثم منها لم يبق غير شعاع",76,"ع",1,0],["جنتي ان دخلتها","معكم فهي لي سقر",77,"ر",1,0],["جنود السلم لاظفَر جزاهم","بما صبرواولا موت أراحا",78,"ح",2,0],["جنت علىّ هموم العيش قاطبة","وقبلها ما جنت أمّ على ولد",79,"د",1,0],["جند الخليفة تمت من نجابتهم","لملكه الآيتان السيف والقلم",80,"م",1,0],["جَناكُنَّ كَالكَرمِ شَتّى المَذاقِ","وَكَالشَهدِ في كُلِّ لَونٍ يُحَب",81,"ب",1,0],["جِنايَةُ الجَهلِ عَلى أَهلِهِ","قَديمَةٌ وَالجَهلُ بِئسَ الدَليل",82,"ل",1,0],["جَنى عَلَينا عُصبَةٌ جازَفوا","فَحَسبُنا اللَهُ وَنِعمَ الوَكيل",82,"ل",1,0],["جُنَّت فَضَعضَعَها وَراضَ جِماحَها","مِن نَشئِكِ الحُمسِ الجُنونُ المُطبِقُ",83,"ق",1,0],["جُندُ الخِلافَةِ عَسكَرُ السُل","طانِ حامِيَةُ الدِيار",84,"ر",1,0],["جِنٌّ عَلَى حَرَمِ السَماءِ أَغاروا","أَم فِتيَةٌ رَكِبوا الجَناحَ فَطاروا",85,"ر",3,1],["جُنونُ الحَداثَةِ مِن حَولِهِم","تَضيقُ بِهِ سَعَةُ المَذهَبِ",86,"ب",1,0],["جَنَيا عَلى كَبِدي وَما عَرَّضتُها","كَبِدي عَلَيكِ مِنَ البَريءِ سَلامُ",87,"م",1,0],["جَنَّةٌ تَخلِبُ العُقولَ وَرَوضٌ","تَجمَعُ العَينُ مِنهُ ما فَرَقوهُ",88,"ق",3,0],["جُنودٌ لِلجِراحِ الدَهرَ مِرهَم","يُدَبِّرُها البَعيدُ الصيتِ أَدهَم",89,"م",1,0],["جَنَيتَ عَلى قُلوبِ الجَمعِ يَأساً","كَأَنَّكَ بَينَهُم داعي الحِمامِ",90,"م",1,0],["جَنَيتُ بِرَوضِها وَرداً وَشَوكاً","وَذُقتُ بِكَأسِها شُهداً وَصابا",91,"ب",2,0],["جَناحَينِ في شِبهِ الشِباكَينِ مِن قَنا","وَقَلباً عَلى حُرِّ الوَغى يَتَقَلَّبُ",92,"ب",1,0],["جند من الأحزاب قد نزلوا على","مدن