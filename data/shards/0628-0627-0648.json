{"poems":[[63,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[63,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[34,"أيا كبدا طارت صدوعا نوافذا","https://www.aldiwan.net/poem4869.html","الطويل"],[77,"أدرها بين مزمار وعود","https://www.aldiwan.net/poem36609.html","الوافر"],[77,"بأوت على زمني همة","https://www.aldiwan.net/poem36743.html","المتقارب"],[86,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[10,"أمن حدث الأيام عينك تهمل","https://www.aldiwan.net/poem21119.html","الطويل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[72,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[32,"وما صائب من نابل قذفت به","https://www.aldiwan.net/poem27777.html","الطويل"],[61,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[2,"لسلمى بشرقي القنان منازل","https://www.aldiwan.net/poem25022.html","الطويل"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[44,"تجرع أسى قد أقفر الجرع الفرد","https://www.aldiwan.net/poem30542.html","الطويل"],[33,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[102,"بني هاشم بين المنايا وبينكم","https://www.aldiwan.net/poem32956.html","الطويل"],[50,"عبيدة أطلقي عني صفادي","https://www.aldiwan.net/poem63921.html","الوافر"],[77,"أدرها بين مزمار وعود","https://www.poetsgate.com/ViewPoem.aspx?id=33800",""],[77,"بأوْتُ على زمني هِمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=33284",""],[28,"لا قوم أكرم من تميم إذ غدت","https://www.poetsgate.com/ViewPoem.aspx?id=22081",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[113,"إلهي بطه شفيع الأنام","https://www.aldiwan.net/poem42186.html","المتقارب"],[148,"بأوجد مني مذ نأيت وإنما","https://www.aldiwan.net/poem68468.html","الطويل"],[148,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[158,"من قلد العلما واقدم أعذرا","https://www.aldiwan.net/poem59178.html","الكامل"],[167,"زهت هجر من بعدما رث حالها","https://www.aldiwan.net/poem1648.html",""],[167,"كمال الدين أنت لكل خير","https://www.aldiwan.net/poem1654.html",""],[184,"متى تراني أكسر المحبره","https://www.aldiwan.net/poem43730.html","السريع"],[227,"وما أم خشف ظل يوما وليلة","https://www.aldiwan.net/poem50724.html","الطويل"],[230,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[248,"يروحي نسيم هب من أرض طيبة","https://www.aldiwan.net/poem15055.html","الطويل"],[254,"سرى متعرضا طيف الخيال","https://www.aldiwan.net/poem48456.html","الوافر"],[257,"دعوت وجودي حيث ما ثم داعيا","https://www.aldiwan.net/poem35965.html","الطويل"],[259,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[259,"نفيس أماني القلب والعين والنفس","https://www.aldiwan.net/poem38254.html","الطويل"],[268,"بكيت لباك واشتكيت لشاك","https://www.aldiwan.net/poem35624.html","الطويل"],[280,"مرضت لطيف كان منه صدود","https://www.aldiwan.net/poem32807.html","الطويل"],[303,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[318,"خليل العلا خياط باشا الذي له","https://www.aldiwan.net/poem67201.html","الطويل"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[362,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[363,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[388,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[402,"أخ لي زكي النفس والأصل والطبع","https://www.aldiwan.net/poem49876.html","الطويل"],[434,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[436,"وفي غيابات أطباق الخطوب شج","https://www.aldiwan.net/poem34760.html","البسيط"],[438,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[456,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[456,"روحها مخمسة خمائصا","https://www.aldiwan.net/poem56149.html","الرجز"],[459,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[459,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[459,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[475,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[475,"أراها عن الجزع تبغي عدولا","https://www.aldiwan.net/poem15225.html","المتقارب"],[480,"بأوس بن خولي عدّتي وبأرقم","https://www.aldiwan.net/poem24545.html","عموديه"],[487,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[538,"أحمامة حلبت شؤونك أسجما","https://www.aldiwan.net/poem56754.html","البسيط"],[556,"بتجلى محاسن المحبوب","https://www.aldiwan.net/poem33558.html","الخفيف"],[559,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"]],"verses":[["بِأَوجَدَ مِنّي يَومَ وَدَّعتُ غادَةً","هِلاليَّةً والصُّبحُ يَلمَعُ حاجِبُهْ",0,"ب",2,0],["بأَوْجَدَ منّي يومَ عَجَّتْ رِكابُها","لِبَيْنٍ فلمْ تترُكْ لِذي صَبوَةٍ لُبّا",1,"ب",2,0],["بأوْجَدَ منّي يَومَ سِرْنا إِلى الحِمى","وقد نَزَلَتْ سَمْراءُ سَفْحَ أبانِ",2,"ن",1,0],["بِأَوجَدَ مِنّي يَومَ وَلَّت حُمولُها","وَقَد طَلَعَت أولى الرِكابِ مِنَ النَقبِ",3,"ب",1,0],["بأوْبَةِ يوسُفٍ رَبِّ الأيادي","ومُحْيي الدّينِ منْ بَعْدِ الخُمودِ",4,"د",1,0],["بَأَوْتُ عَلَى زَمَنِي هِمَّةً","فَأَعْتَبَنِي الزَّمَنُ الْعَاتِبُ",5,"ب",1,1],["بِأَوحى مِنَ اللَمحِ كانَ النِزالُ","فَيا وَيلَ مَن مِنهُما قَد سَها",6,"ا",1,0],["بِأَوسَعَ سَيباً مِن يَدَيكَ وَنِعمَةً","تَعُمُّ بِها بَل سَيبُ كَفَّيكَ أَجزَلُ",7,"ل",1,0],["بِأَوَّلَ ما هاجَت لَكَ الشَوقَ دِمنَةٌ","بِأَجرَعِ مِرباعٍ مَرَبٍّ مُحَلَّلِ",8,"ل",1,0],["با ويلة الحسّ إنه عن","حقيقة الأمر في غطاء",9,"ا",2,0],["بِأَودٍ وَالإِيادِ لَنا صَديقٌ","نَأى عَنكَ الإِيادُ وَأَينَ أودُ",10,"د",1,0],["باؤوا بِقَتلِ الرِضا مِن بَعدِ بَيعَتِهِ","وَأَبصَروا بَعضَ يَومٍ رُشدَهُم وَعَموا",11,"م",3,0],["بأوجهٍ من بني بدرٍ تُناضِلنا","من دونها لحظات من بني ثعل",12,"ل",1,0],["بأول الحال منكم أو بآخره","يراكم الله تأييداً لإسلام",13,"م",1,0],["بأوضح للأبصارِ من مجدِه الذي","توقَّد حتَّى لم تجد متوقّلا",14,"ل",2,0],["بِأَوشَكَ قَتلاً مِنكِ يَومَ رَمَيتِني","نَوافِذَ لَم تَظهَر لَهُنَّ خُروقُ",15,"ق",1,0],["بأوانسٍ تَدَعُ الدُّموعَ أوانِساً","ورَواتِعٍ تَدَعُ القلوبَ رواتعا",16,"ع",2,0],["بِأَوشَكَ مِنهُ أَن يُساوِرَ قِرنَهُ","إِذا شالَ عَن خَفضِ العَوالي الأَسافِلُ",17,"ل",1,0],["بِأَودِيَةٍ أَسافِلُهُنَّ رَوضٌ","وَأَعلاها إِذا خِفنا حُصونُ",18,"ن",1,0],["بِأَوفاهُمُ بَرقاً إِذا أَخلَفَ السَنا","وَأَصدَقِهِم رَعداً إِذا كَذَبَ الرَعدُ",19,"د",1,0],["بِأَوجَدَ مِن وَجدٍ بِلَيلى وَجَدتُهُ","غَداةَ اِرتَحَلنا غَدوَةً وَاِطمَأَنَتِ",20,"ت",1,0],["بِأَوجهكم تَنفضُّ حالِكَة الدُجى","وَأَيمانَكُم تَرفضُّ مجفلةُ القطرِ",21,"ر",1,0],["بِأَوَّلِ مُمسِكٍ بِذِنابِ غَيٍّي","عَداني الغَيُّ عَن سُبُلِ الرَشادِ",22,"د",1,0],["بأوبة يوسف رب الأيادي","ومحي الدين من بعد الخمود",23,"د",1,0],["بأوْتُ على زمني هِمَّة ً","فأعتبني الزَّمانُ العاتِب",24,"ب",1,1],["بِأُولاكَ تَمْنَعُ أنْ تُنَفِّقَ، بَعْدَمَا","قَصّعْتَ بَينَ حُزُونَةٍ وَرِمَالِ",25,"ل",1,0],["بِأَوْسِمَةٍ لِلقُبْحِ فِي الشَّيْبِ وَالعُطْلِ","أَعَدْلاً يُبَاهِي عَصْرُنَا زَمَناً خَلاَ",26,"ل",2,0],["بأولادها الغراهل العبا","وأولادهم روح جسم الأنام",27,"م",1,0],["بأوجد مني مذ نأيتَ وإنما","أعلل نفسي بالتجلد والصبرِ",28,"ر",1,1],["بأولِ دفعةٍ منها","تغيضُ وتغرق القُلُب",29,"ب",1,0],["باؤا بما باؤا وأنت مبرأ","مما تحمل من تحمل وافترى",30,"ر",2,0],["بِأَوبَةِ مَيمُونِ النَقيبَةِ لَو سَطا","عَلى الأرضِ خَوفاً مِنهُ زالَت جِبالُها",31,"ل",3,0],["بِأَوكَسِ قِيمَةٍ في شَرِّ وَقتٍ","وَعَضلُ البَيعِ في الحاجاتِ بسلُ",32,"ل",1,0],["بأورق ليس لها آخرُ","يوشك أن تورثني المقبره",33,"ه",1,0],["بأَوْجَعَ مِنَّي يومَ شدُّوا رِحالَهمْ","ونادَى منادي الحيِّ أن لا تَلاقِيا",34,"ي",2,0],["بِأَوجَعَ مِن قَلبي غَداةَ تَرَحَّلَت","رَكائِبُ مِن سَلمى وَشَطَّ نَواها",35,"ا",3,0],["بأوصافه فاق النبيين كلَّهم","إذا ظهرت شمسُ الضحى اخبتُ الشُّهبا",36,"ب",2,0],["بأول خاطرٍ من غير فكرٍ","تشرس من لقيت ولا تبالي",37,"ي",1,0],["بِأَوصافِكَ الحَسنا المُقَدَّسَةِ الصَفا","وَأَسمائِكَ الحُسنى العُلا في الأسامِيا",38,"ي",2,0],["بأوهن من قلب المحب على النوى","وأكثر في الأعداد من حسراته",39,"ت",2,0],["بأوضح من صبح وانجح من حيا","وارجح من هضب وافصح من قس",40,"س",1,0],["بأوَّلِ ميعادٍ وأولِ قبلةٍ","وأول ليلٍ فيه طارَ كراك",41,"ك",1,0],["بِأَوجَعَ مِنّي يَوم كاظِمَةٍ وَقَد","ظعنتُ فَقالَ الرَكبُ أَينَ تُريدُ",42,"د",1,0],["بِأوطانٍ وَأَوطارٍ توطّى","وَتقصرُ إثرَ أوتارٍ تقيدُ",43,"د",1,0],["بِأَوَّلِ نيشانِ مَجيدٌ أَتاحَهُ","لِتَزدانَ عَلياهُ بِكَوكَبِ سُلطانِ",44,"ن",1,0],["بِأَوَّلِ حَرفٍ مِن اِسمِ الوَزيرِ","لَهُ الفُلكَ اللَهُ قِدماً وَسَم",45,"م",1,0],["بأُولَىدَعْوَتيَّ يُجِيبُ طَوْعاً","إذا ما عَنَّ لي شَرَفٌ مَروم",46,"م",1,0],["بِأَوجَعَ لَوعَةً منّي وَوَجداً","غَداةَ تَحَمَّلَ الأَنَسُ الجميعُ",47,"ع",1,0],["بأولاد العفيف مع وجيه","واخوته بهم وفر نصيبي",48,"ي",1,0],["بأوعظَ مِن عَقلٍ وآنسَ مِن هَوىً","وأرفقَ مِن طَبعٍ وأنفعَ مِن شَرعِ",49,"ع",1,0],["بأوهم محبوك الذراعين والقرى","هضيم الحشى مستشرفات مناكبه",50,"ب",2,0],["بأَوْجُهِ الفاطِمِيِّينَ الَّتِي شَهِدَتْ","شمسُ الضُّحى أَنَّها فِي وجهِها غُرَرُ",51,"ر",1,0],["بأوجد مني يوم سارت جنازة","إِلى لحد قبر بالذروب يمهد",52,"د",1,0],["بأوصافهم سُمِّيتَ واحدَ دهرهِ","وما نلتَه من ضبطِها ونظامِها",53,"م",3,0],["بأوجهٍ لم تعرف الوَصاوصا","وأنملٍ يبسطنها رواخصا",54,"ص",2,0],["بأوجدَ منه بالعُلى غير أنه","إذا ما وَنَتْ لم يلْفِه السير وانيا",55,"ي",2,0],["بأوْجدَ منه بالعُلى غير أنهُ","إذا فارقت محبوبةٌ لم يُفارقِ",56,"ق",1,0],["بأوْفى أناةً منه والخطبُ عاصفٌ","إذا لم تُطق نفس الحليم التَحلُّما",57,"م",2,0],["بأوانسٍ في الخافقين شواردِ","الألفاظ تهزأُ بالبليغِ المصقع",58,"ع",1,0],["بأوجعَ مِن قلبٍ يُوَزَّعُ حسرةً","على جيرةٍ بانوا وفكرٍ يُقَسَّمُ",59,"م",1,0],["بأوجدَ منّي على أربُعٍ","عَهِدْتُ الأحبَّةَ فيها حُلُولا",60,"ل",2,0],["بأوس بن خولي عدّتي وبأرقم","أعد إياس بن البكير لغمنا",61,"ن",2,1],["بأوعَسَ مِن ذاتِ الحِجى ما عرفته","بُعَيدَ حصاةِ النَفسِ إِلّا تَوهُّما",62,"م",2,0],["بأوانِسٍ حورِ العُيونِ كَأَنَّها","آرامُ وَجرَةَ جادَهُنَّ رَبيعُ",63,"ع",1,0],["باؤها تحتها الحوادث منه","نقطة أسفرت عن المطلوب",64,"ب",1,0],["بَأَواً وَمَدَّتهُم جِبالٌ شُمَّخُ","أَجوازهُهنَّ وَالأُنوفُ الزُمَّخُ",65,"خ",1,0]]}