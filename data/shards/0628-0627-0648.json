 يومَ عَجَّتْ رِكابُها","لِبَيْنٍ فلمْ تترُكْ لِذي صَبوَةٍ لُبّا",1,"ب",2,0],["بأوْجَدَ منّي يَومَ سِرْنا إِلى الحِمى","وقد نَزَلَتْ سَمْراءُ سَفْحَ أبانِ",2,"ن",1,0],["بِأَوجَدَ مِنّي يَومَ وَلَّت حُمولُها","وَقَد طَلَعَت أولى الرِكابِ مِنَ النَقبِ",3,"ب",1,0],["بأوْبَةِ يوسُفٍ رَبِّ الأيادي","ومُحْيي الدّينِ منْ بَعْدِ الخُمودِ",4,"د",1,0],["بَأَوْتُ عَلَى زَمَنِي هِمَّةً","فَأَعْتَبَنِي الزَّمَنُ الْعَاتِبُ",5,"ب",1,1],["بِأَوحى مِنَ اللَمحِ كانَ النِزالُ","فَيا وَيلَ مَن مِنهُما قَد سَها",6,"ا",1,0],["بِأَوسَعَ سَيباً مِن يَدَيكَ وَنِعمَةً","تَعُمُّ بِها بَل سَيبُ كَفَّيكَ أَجزَلُ",7,"ل",1,0],["بِأَوَّلَ ما هاجَت لَكَ الشَوقَ دِمنَةٌ","بِأَجرَعِ مِرباعٍ مَرَبٍّ مُحَلَّلِ",8,"ل",1,0],["با ويلة الحسّ إنه عن","حقيقة الأمر في غطاء",9,"ا",2,0],["بِأَودٍ وَالإِيادِ لَنا صَديقٌ","نَأى عَنكَ الإِيادُ وَأَينَ أودُ",10,"د",1,0],["باؤوا بِقَتلِ الرِضا مِن بَعدِ بَيعَتِهِ","وَأَبصَروا بَعضَ يَومٍ رُشدَهُم وَعَموا",11,"م",3,0],["بأوجهٍ من بني بدرٍ تُناضِلنا","من دونها لحظات من بني ثعل",12,"ل",1,0],["بأول الحال منكم أو بآخره","يراكم الله تأييداً لإسلام",13,"م",1,0],["بأوضح للأبصارِ من مجدِه الذي","توقَّد حتَّى لم تجد متوقّلا",14,"ل",2,0],["بِأَوشَكَ قَتلاً مِنكِ يَومَ رَمَيتِني","نَوافِذَ لَم تَظهَر لَهُنَّ خُروقُ",15,"ق",1,0],["بأوانسٍ تَدَعُ الدُّموعَ أوانِساً","ورَواتِعٍ تَدَعُ القلوبَ رواتعا",16,"ع",2,0],["بِأَوشَكَ مِنهُ أَن يُساوِرَ قِرنَهُ","إِذا شالَ عَن خَفضِ العَوالي الأَسافِلُ",17,"ل",1,0],["بِأَودِيَةٍ أَسافِلُهُنَّ رَوضٌ","وَأَعلاها إِذا خِفنا حُصونُ",18,"ن",1,0],["بِأَوفاهُمُ بَرقاً إِذا أَخلَفَ السَنا","وَأَصدَقِهِم رَعداً إِذا كَذَبَ الرَعدُ",19,"د",1,0],["بِأَوجَدَ مِن وَجدٍ بِلَيلى وَجَدتُهُ","غَداةَ اِرتَحَلنا غَدوَةً وَاِطمَأَنَتِ",20,"ت",1,0],["بِأَوجهكم تَنفضُّ حالِكَة الدُجى","وَأَيمانَكُم تَرفضُّ مجفلةُ القطرِ",21,"ر",1,0],["بِأَوَّلِ مُمسِكٍ بِذِنابِ غَيٍّي","عَداني الغَيُّ عَن سُبُلِ الرَشادِ",22,"د",1,0],["بأولئك الأبرار كنت معززا","بأولئك الأبرار كنت أباري",23,"ر",2,0],["بأوسع حزنا من بقية مهجتي","وان قلت اني الصابر المتحازم",24,"م",1,0],["بأوبة يوسف رب الأيادي","ومحي الدين من بعد الخمود",25,"د",1,0],["بأوْتُ على زمني هِمَّة ً","فأعتبني الزَّمانُ العاتِب",26,"ب",1,1],["بِأُولاكَ تَمْنَعُ أنْ تُنَفِّقَ، بَعْدَمَا","قَصّعْتَ بَينَ حُزُونَةٍ وَرِمَالِ",27,"ل",1,0],["بِأَوْسِمَةٍ لِلقُبْحِ فِي الشَّيْبِ وَالعُطْلِ","أَعَدْلاً يُبَاهِي عَصْرُنَا زَمَناً خَلاَ",28,"ل",2,0],["بأولادها الغراهل العبا","وأولادهم روح جسم الأنام",29,"م",1,0],["بأوجد مني مذ نأيتَ وإنما","أعلل نفسي بالتجلد والصبرِ",30,"ر",1,1],["بأولِ دفعةٍ منها","تغيضُ وتغرق القُلُب",31,"ب",1,0],["باؤا بما باؤا وأنت مبرأ","مما تحمل من تحمل وافترى",32,"ر",2,0],["بِأَوبَةِ مَيمُونِ النَقيبَةِ لَو سَطا","عَلى الأرضِ خَوفاً مِنهُ زالَت جِبالُها",33,"ل",3,0],["بِأَوكَسِ قِيمَةٍ في شَرِّ وَقتٍ","وَعَضلُ البَيعِ في الحاجاتِ بسلُ",34,"ل",1,0],["بأورق ليس لها آخرُ","يوشك أن تورثني المقبره",35,"ه",1,0],["بأَوْجَعَ مِنَّي يومَ شدُّوا رِحالَهمْ","ونادَى منادي الحيِّ أن لا تَلاقِيا",36,"ي",2,0],["بِأَوجَعَ مِن قَلبي غَداةَ تَرَحَّلَت","رَكائِبُ مِن سَلمى وَشَطَّ نَواها",37,"ا",3,0],["بأوصافه فاق النبيين كلَّهم","إذا ظهرت شمسُ الضحى اخبتُ الشُّهبا",38,"ب",2,0],["بأول خاطرٍ من غير فكرٍ","تشرس من لقيت ولا تبالي",39,"ل",2,0],["بِأَوصافِكَ الحَسنا المُقَدَّسَةِ الصَفا","وَأَسمائِكَ الحُسنى العُلا في الأسامِيا",40,"ي",2,0],["بأوهن من قلب المحب على النوى","وأكثر في الأعداد من حسراته",41,"ت",2,0],["بأوضح من صبح وانجح من حيا","وارجح من هضب وافصح من قس",42,"س",1,0],["بأوَّلِ ميعادٍ وأولِ قبلةٍ","وأول ليلٍ فيه طارَ كراك",43,"ك",1,0],["بِأَوجَعَ مِنّي يَوم كاظِمَةٍ وَقَد","ظعنتُ فَقالَ الرَكبُ أَينَ تُريدُ",44,"د",1,0],["بِأوطانٍ وَأَوطارٍ توطّى","وَتقصرُ إثرَ أوتارٍ تقيدُ",45,"د",1,0],["بِأَوَّلِ نيشانِ مَجيدٌ أَتاحَهُ","لِتَزدانَ عَلياهُ بِكَوكَبِ سُلطانِ",46,"ن",1,0],["بِأَوَّلِ حَرفٍ مِن اِسمِ الوَزيرِ","لَهُ الفُلكَ اللَهُ قِدماً وَسَم",47,"م",1,0],["بأُولَىدَعْوَتيَّ يُجِيبُ طَوْعاً","إذا ما عَنَّ لي شَرَفٌ مَروم",48,"م",1,0],["بِأَوجَعَ لَوعَةً منّي وَوَجداً","غَداةَ تَحَمَّلَ الأَنَسُ الجميعُ",49,"ع",1,0],["بأولاد العفيف مع وجيه","واخوته بهم وفر نصيبي",50,"ب",2,0],["بأوعظَ مِن عَقلٍ وآنسَ مِن هَوىً","وأرفقَ مِن طَبعٍ وأنفعَ مِن شَرعِ",51,"ع",1,0],["بأوهم محبوك الذراعين والقرى","هضيم الحشى مستشرفات مناكبه",52,"ب",2,0],["بأَوْجُهِ الفاطِمِيِّينَ الَّتِي شَهِدَتْ","شمسُ الضُّحى أَنَّها فِي وجهِها غُرَرُ",53,"ر",1,0],["بأوجد مني يوم سارت جنازة","إِلى لحد قبر بالذروب يمهد",54,"د",1,0],["بأوصافهم سُمِّيتَ واحدَ دهرهِ","وما نلتَه من ضبطِها ونظامِها",55,"م",3,0],["بأوجهٍ لم تعرف الوَصاوصا","وأنملٍ يبسطنها رواخصا",56,"ص",2,0],["بأوجدَ منه بالعُلى غير أنه","إذا ما وَنَتْ لم يلْفِه السير وانيا",57,"ي",2,0],["بأوْجدَ منه بالعُلى غير أنهُ","إذا فارقت محبوبةٌ لم يُفارقِ",58,"ق",1,0],["بأوْفى أناةً منه والخطبُ عاصفٌ","إذا لم تُطق نفس الحليم التَحلُّما",59,"م",2,0],["بأوانسٍ في الخافقين شواردِ","الألفاظ تهزأُ بالبليغِ المصقع",60,"ع",1,0],["بأوجعَ مِن قلبٍ يُوَزَّعُ حسرةً","على جيرةٍ بانوا وفكرٍ يُقَسَّمُ",61,"م",1,0],["بأوجدَ منّي على أربُعٍ","عَهِدْتُ الأحبَّةَ فيها حُلُولا",62,"ل",2,0],["بأوس بن خولي عدّتي وبأرقم","أعد إياس بن البكير لغمنا",63,"ن",2,1],["بأوعَسَ مِن ذاتِ الحِجى ما عرفته","بُعَيدَ حصاةِ النَفسِ إِلّا تَوهُّما",64,"م",2,0],["بأوانِسٍ حورِ العُيونِ كَأَنَّها","آرامُ وَجرَةَ جادَهُنَّ رَبيعُ",65,"ع",1,0],["باؤها تحتها الحوادث منه","نقطة أسفرت عن المطلوب",66,"ب",1,0],["بَأَواً وَمَدَّتهُم جِبالٌ شُمَّخُ","أَجوازهُهنَّ وَالأُنوفُ الزُمَّخُ",67,"خ",1,0],["بأوجَدَ مِنّي يَومَ راحَ ونَعشُهُ","طُوالُ الهَوادي سالِماتِ السَّوالفِ",68,"ف",1,0],["بأوجدَ مِنّي يا عَليُّ وإن هَمَت","عَليكَ شُئونُ الشّامِتِ المُتواجِد",69,"د",1,0],["بأوجَعَ مِمّا ذُقتهُ فاعلَمَنَّه","جَليَّة أمرٍ بالحَقيقةِ واكد",69,"د",1,0],["بأوصافٍ إذا ذُكرَت وفاحتِ","بها ابتهجَ القريبُ مع البعيدِ",70,"د",1,0],["باؤا بخسران وباء الجيش بال","نصر المبين فيا لحسن مآب",71,"ب",1,0],["بأوجعَ منّي يومَ سارت حمولُها","يُخفّضنَ في بطنٍ ويرفعنَ في ظَهرِ",72,"ر",1,0],["بأول يوم يعز اللقاء","وأول يوم تهاب الدنو",73,"ن",2,0],["بأوجع منها حين سارت ورهطها","على الأرض صرعى قد أضرت من العنف",74,"ف",1,0],["بِأَولادِ عَبد الحَقّ قَد ظَهَر الهُدى","وَصارَ النَدى قَد يَمّم الغَرب يَقطُرُ",75,"ر",