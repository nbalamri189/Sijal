{"poems":[[55,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[73,"ألا خبروني عن حمى تل راهط","https://www.aldiwan.net/poem4001.html","الطويل"],[32,"مررنا على دار لمية مرة","https://www.aldiwan.net/poem29525.html","الطويل"],[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[32,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[90,"ألا خلياني في الكلام من السجع","https://www.aldiwan.net/poem44972.html","الطويل"],[39,"هلا سألت منازلا بالأبرق","https://www.aldiwan.net/poem7239.html","الكامل"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[53,"ألا خذها إليك عن الحرون","https://www.aldiwan.net/poem66529.html","الوافر"],[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[60,"سلام على أهل القبور الدوارس","https://www.aldiwan.net/poem31000.html","الطويل"],[99,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[107,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[50,"ألا خذها كمصباح الظلام","https://www.aldiwan.net/poem65116.html","الوافر"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[108,"إلى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179547",""],[53,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[32,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[118,"اخا الاشجان حي على الفلاح","https://www.aldiwan.net/poem41176.html","عموديه"],[127,"لا در درك جعفر يا جعفر","https://www.aldiwan.net/poem23739.html","الكامل"],[150,"أقول على صدق لأهل النهى طرا","https://www.aldiwan.net/poem47648.html","الطويل"],[161,"بذمام شجنة يا أبا العباس","https://www.aldiwan.net/poem4423.html","الكامل"],[172,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[185,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[189,"دب البلى فيه وهو حي","https://www.aldiwan.net/poem43187.html","مخلع البسيط"],[189,"سألتك بالحذاقة والمواسي","https://www.aldiwan.net/poem43699.html","الوافر"],[192,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[217,"أيا جبلي نعمان بالله خليا","https://www.aldiwan.net/poem517.html",""],[234,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[235,"ألا خاد أعللها بنجد","https://www.aldiwan.net/poem14778.html","الوافر"],[273,"تنامين في أثوابك العطرات","https://www.aldiwan.net/poem35223.html","الطويل"],[285,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[306,"ألا خبروني عن صلاة امرئ غدت","https://www.aldiwan.net/poem57569.html","الطويل"],[356,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[356,"ألا خل خلي من يرى الود كلفة","https://www.aldiwan.net/poem40034.html","الطويل"],[367,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[405,"ألا خبرا عن رامة أيها الركب","https://www.aldiwan.net/poem46427.html","الطويل"],[405,"ملكتموا فاعدلوا في الصب أو جوروا","https://www.aldiwan.net/poem46753.html","البسيط"],[406,"تجد البين فاستأنفت في العدد","https://www.aldiwan.net/poem33979.html","البسيط"],[454,"ألا خل يزاملني صباحا","https://www.aldiwan.net/poem13703.html","الوافر"],[455,"الأخطبوط أراه بدل شكله","https://www.aldiwan.net/poem61358.html","الكامل"],[479,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[484,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[577,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/20595","الكامل"],[1127,"","https://poetry.dctabudhabi.ae/diwan/poem/20852","الكامل"]],"verses":[["أَلا خَبَرٌ عَن جانِبِ الغَورِ وارِدٌ","تَرامى بِهِ أَيدي المَطيِّ الرَواسِمِ",0,"م",1,1],["أَلا خَبَّروني عَن حِمى تَلِ راهِطٍ","يَلَذُّ بِهِ سَمعي وَإِن فاتَني النَظَر",1,"ر",1,1],["أَلا خَيَّلَت مَيٌّ وَقَد نامَ صُحبَتي","فَما نَفَّرَ التَهويمَ إِلّا سَلامُها",2,"م",3,0],["أَلا خَيَّلَت خَرقاءُ بِالبينَ بَعدَما","مَضى اللَيلُ إِلّا خَطَّ أَبلَقَ جاشِرِ",3,"ر",1,0],["أَلا خَيَّلَت خَرقاءُ وَهناً لِفِتيَةٍ","هُجودٍ وَأَيسارُ المَطِيِّ وَسائِدُ",4,"د",1,0],["ألا خَليِّاني في الكلام من السجع","ولا تَجريا في القول إلاّ على الطبع",5,"ع",1,1],["إلا خوالد في المحلة بيتها","كالطيلسان من الرماد الأورق",6,"ق",1,0],["إِلّا خَصائِصَ أَقوامٍ هُمُ سَلَفٌ","لِلصالِحينَ مَعَ الأَنصارِ أَنصارُ",7,"ر",1,0],["الآخذينَ بأنفهِ","لا كالأُلى عِلِقوا ذِنابَهْ",8,"ب",2,0],["ألا خاب من أنساه منكم نصيبَهُ","متاعٌ من الدنيا قليلٌ وزِبرجُ",9,"ج",1,0],["الآخذ الخطة الرضيّة وال","تارك ما الحظ فيه أن يذره",10,"ر",2,0],["ألا خذها إليك عن الحَرونِ","تَناسخَها القرونُ عن القرونِ",11,"ن",1,1],["الآخِذاتُ قُلوبَنا","في زَيَّ طاقاتِ الزُهورِ",12,"ر",1,0],["الآخِذينَ الحُصنَ عَزَّ سَبيلُهُ","مِثلَ السُها أَو في اِمتِناعِ مَنالِهِ",13,"ل",2,0],["أَلا خَبِّروني أَينَ قَبر ذَليلِكُم","وَقَبرُ العَزيزِ الباذِخِ المُتنافِسِ",14,"س",1,0],["إلا خيالُ سعادةٍ قد أقلعت","ووداعُ أحباب ودمعُ مسافرِ",15,"ر",1,0],["الآخِذينَ عَلى المُغيرِ سَبيلَهُ","بِالسَيفِ يَحمي الغيلَ وَالأَشبالا",16,"ل",2,0],["ألا خَسِرَ اليهودُ ولا أصابوا","طِوالَ الدَّهرِ خَيراً أو نَماءَ",17,"ا",2,0],["أَلا خُذها كَمِصباحِ الظَلامِ","سَليلَةَ أَسوَدٍ جَعدٍ سُخامِ",18,"م",1,1],["الآخِذُ الشُهَداءَ أَخذَ مُناجِزٍ","وَالمُستَبيحُ دَمَ الشَهيدِ الأَعظَمِ",19,"م",1,0],["ألاَ خفَّفتَ عبء الأرض هَوْنًا","فأمُّك آدَها النسل الكثير؟",20,"ر",1,0],["الآخذينَ بأنفهِ","لا كالأُولى عِلِقوا ذِنابَهْ",21,"ب",2,0],["أَلاَ خَيَّلَتْ خَرْقَآءُ وَهْناً لِفِتْيَة ٍ","هجوعٍ وأيسارُ المطيِّ وسائدُ",22,"د",1,0],["الا خل العتاب اخل وارجع","لصفو في شؤنك وارتياح",23,"ح",1,0],["الآخذين من الحياة بصفوها","والتاركين لغيرهم ما يكدر",24,"ر",1,0],["ألا خبروني أين ضلّت عقولكم","وكلكم يستهجن الشر والضرا",25,"ر",2,0],["إِلا خَلَعتَ لَها ثِيابَكَ إِنَّها","بِئسَ اللِّباسُ وَشَرُّ كُلِّ لِباسِ",26,"س",1,0],["أَلا خِلٌّ عَلى الأَيّامِ نَدبٌ","يُشاطِرُني الصَبابَةَ وَالسُهادا",27,"د",2,0],["الآخِذينَ زَكاة الشِّعرِ لا حُمِدُوا","عَنها وَلا هِيَ عِندَ اللَهِ تَحتَسبُ",28,"ب",1,0],["إلا خيالا إذا تمشّى","أو شبحٌ في القميص حي",29,"ي",1,0],["ألا خذلي بكعبك بروان","يمكن وإلا حلق رأسي",30,"س",2,0],["الآخرُ الآخذُ بالحجزاتِ","لكلّ مُسلمٍ غدا مسلِّما",31,"م",2,0],["أَلا خَلَّيا مَجرى الجَنوبِ لَعَلَّهُ","يَداوي فُؤادي مِن جَواهُ نَسيمُها",32,"م",3,0],["الآخرونَ وَلَيسَ عَن نَقصٍ بِهِم","لَكِن تَفَضُّلَ مُحسِن مَنّانِ",33,"ن",1,0],["ألا خادٍ أُعَلِّلُها بِنَجدٍ","فَيَنقُصُ ما بِها مِن فَرطِ وَجدِ",34,"د",1,1],["ألا خفَّ تربٌ من ضريحكِ مثلما","لصوتِكِ خفَّت وطأةُ السأمات",35,"ت",1,0],["إِلّا خَميسٌ كامِلِيٌّ قادَهُ ال","أقسيسُ يَسري في اليَبابِ المَقفِرِ",36,"ر",1,0],["ألا خبروني عن صلاة امرئ غدت","بحارُ بسيطٍ عندها ووجيز",37,"ز",1,1],["أَلا خَلّياني يا خَليليَّ وَالجَفا","فَيا رُبَّ واشٍ ساءَ ما بَيننا ظَنّا",38,"ن",2,0],["أَلا خَلِّ خلّي من يَرى الودّ كلفة","كَثَوبِ رياً أَنّى تَردّى بِهِ شَفّا",39,"ف",2,1],["ألا خَلِّياني يا خَليليَّ واعْلَما","إذا لُمْتُما أنْ ليس عَذْلُكما عَدْلا",40,"ل",2,0],["ألاَ خَبَراً عَن رامةٍ أَيُّها الركبُ","فأنّي بمن قد حلَّها مُغْرمٌ صبُّ",41,"ب",1,1],["ألاَ خلاصٌ لِقَلْبِي مِن صَبابتِهِ","فإِنَّه في تعاطي الحُبِّ مَغْروراً",42,"ر",2,0],["الآخذين صفات المجد عن كمل","والفائزين بخلق كالرياض نَدِ",43,"د",1,0],["ألاَ خلٌّ يُزاملني صَباحا","وتحملني وإِيّاه الرياحُ",44,"ح",1,1],["الأخطبوط أراه بدل شكله","كمحيطه ولقد يظنّ صخورا",45,"ر",2,1],["ألا خبر عنهن من بعد ما برى","صدورَ المطايا الهوج شدُّ النسائعِ",46,"ع",1,0],["الأخدان وقت الوصل صحوا","على طول المدى زهر اللئال",47,"ل",1,0],["الآخذُ الأَقرانِ بعد الوغى","والواهبُ الآلافِ قبل السؤال",48,"ل",1,0],["الآخِذونَ العَهدَ من آفاقِها","وَالراحِلونَ بِرحلَةِ الإيلافِ",49,"ف",1,0],["إِلّا خَليلٌ صادِقٌ ما شَأَنَهُ","شَيءٌ يُكَدِّرُ صَفوَهُ وَيُحَوِّلُ",50,"ل",1,0]]}