{"poems":[[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[71,"ألا خبروني عن حمى تل راهط","https://www.aldiwan.net/poem4001.html","الطويل"],[30,"مررنا على دار لمية مرة","https://www.aldiwan.net/poem29525.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[88,"ألا خلياني في الكلام من السجع","https://www.aldiwan.net/poem44972.html","الطويل"],[37,"هلا سألت منازلا بالأبرق","https://www.aldiwan.net/poem7239.html","الكامل"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"ألا خذها إليك عن الحرون","https://www.aldiwan.net/poem66529.html","الوافر"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[85,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[58,"سلام على أهل القبور الدوارس","https://www.aldiwan.net/poem31000.html","الطويل"],[97,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[105,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[48,"ألا خذها كمصباح الظلام","https://www.aldiwan.net/poem65116.html","الوافر"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[106,"إلى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179547",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[30,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""]],"verses":[["أَلا خَبَرٌ عَن جانِبِ الغَورِ وارِدٌ","تَرامى بِهِ أَيدي المَطيِّ الرَواسِمِ",0,"م",1,1],["أَلا خَبَّروني عَن حِمى تَلِ راهِطٍ","يَلَذُّ بِهِ سَمعي وَإِن فاتَني النَظَر",1,"ر",1,1],["أَلا خَيَّلَت مَيٌّ وَقَد نامَ صُحبَتي","فَما نَفَّرَ التَهويمَ إِلّا سَلامُها",2,"م",3,0],["أَلا خَيَّلَت خَرقاءُ بِالبينَ بَعدَما","مَضى اللَيلُ إِلّا خَطَّ أَبلَقَ جاشِرِ",3,"ر",1,0],["أَلا خَيَّلَت خَرقاءُ وَهناً لِفِتيَةٍ","هُجودٍ وَأَيسارُ المَطِيِّ وَسائِدُ",4,"د",1,0],["ألا خَليِّاني في الكلام من السجع","ولا تَجريا في القول إلاّ على الطبع",5,"ع",1,1],["إلا خوالد في المحلة بيتها","كالطيلسان من الرماد الأورق",6,"ق",1,0],["إِلّا خَصائِصَ أَقوامٍ هُمُ سَلَفٌ","لِلصالِحينَ مَعَ الأَنصارِ أَنصارُ",7,"ر",1,0],["الآخذينَ بأنفهِ","لا كالأُلى عِلِقوا ذِنابَهْ",8,"ب",2,0],["ألا خاب من أنساه منكم نصيبَهُ","متاعٌ من الدنيا قليلٌ وزِبرجُ",9,"ج",1,0],["الآخذ الخطة الرضيّة وال","تارك ما الحظ فيه أن يذره",10,"ر",2,0],["ألا خذها إليك عن الحَرونِ","تَناسخَها القرونُ عن القرونِ",11,"ن",1,1],["الآخِذاتُ قُلوبَنا","في زَيَّ طاقاتِ الزُهورِ",12,"ر",1,0],["الآخِذينَ الحُصنَ عَزَّ سَبيلُهُ","مِثلَ السُها أَو في اِمتِناعِ مَنالِهِ",13,"ل",2,0],["أَلا خَبِّروني أَينَ قَبر ذَليلِكُم","وَقَبرُ العَزيزِ الباذِخِ المُتنافِسِ",14,"س",1,0],["إلا خيالُ سعادةٍ قد أقلعت","ووداعُ أحباب ودمعُ مسافرِ",15,"ر",1,0],["الآخِذينَ عَلى المُغيرِ سَبيلَهُ","بِالسَيفِ يَحمي الغيلَ وَالأَشبالا",16,"ل",2,0],["ألا خَسِرَ اليهودُ ولا أصابوا","طِوالَ الدَّهرِ خَيراً أو نَماءَ",17,"ا",2,0],["أَلا خُذها كَمِصباحِ الظَلامِ","سَليلَةَ أَسوَدٍ جَعدٍ سُخامِ",18,"م",1,1],["الآخِذُ الشُهَداءَ أَخذَ مُناجِزٍ","وَالمُستَبيحُ دَمَ الشَهيدِ الأَعظَمِ",19,"م",1,0],["ألاَ خفَّفتَ عبء الأرض هَوْنًا","فأمُّك آدَها النسل الكثير؟",20,"ر",1,0],["الآخذينَ بأنفهِ","لا كالأُولى عِلِقوا ذِنابَهْ",21,"ب",2,0],["أَلاَ خَيَّلَتْ خَرْقَآءُ وَهْناً لِفِتْيَة ٍ","هجوعٍ وأيسارُ المطيِّ وسائدُ",22,"د",1,0]]}