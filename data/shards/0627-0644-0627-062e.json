m/ViewPoem.aspx?id=86513",""],[5410,"حُبُّنا مَوئلٌ للسَلام","https://www.poetsgate.com/ViewPoem.aspx?id=151392",""],[5431,"ولكن طبعي بالغرام ملولُ","https://www.poetsgate.com/ViewPoem.aspx?id=189852",""],[5431,"الحمد لله ربّ الوحي والقلمِ...","https://www.poetsgate.com/ViewPoem.aspx?id=199846",""],[5444,"أمة الخيرية","https://www.poetsgate.com/ViewPoem.aspx?id=185388",""],[5444,"أمة الخيرية","https://www.poetsgate.com/ViewPoem.aspx?id=205442",""],[5650,"غوايةُ الموجِ الغَدور","https://www.poetsgate.com/ViewPoem.aspx?id=177956",""],[5770,"نحن سبعة","https://www.poetsgate.com/ViewPoem.aspx?id=178734",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[5956,"مغيبُ شقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=192470",""],[6003,"مركز التكوين","https://www.poetsgate.com/ViewPoem.aspx?id=201022",""],[2220,"سبحان من صار لنا مطلباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11192&r=&rc=66",""],[5190,"الرزق الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78291&r=&rc=5",""]],"verses":[["أَلا خَبَرٌ عَن جانِبِ الغَورِ وارِدٌ","تَرامى بِهِ أَيدي المَطيِّ الرَواسِمِ",0,"م",1,1],["أَلا خَبَّروني عَن حِمى تَلِ راهِطٍ","يَلَذُّ بِهِ سَمعي وَإِن فاتَني النَظَر",1,"ر",1,1],["أَلا خَيَّلَت مَيٌّ وَقَد نامَ صُحبَتي","فَما نَفَّرَ التَهويمَ إِلّا سَلامُها",2,"م",3,0],["أَلا خَيَّلَت خَرقاءُ بِالبينَ بَعدَما","مَضى اللَيلُ إِلّا خَطَّ أَبلَقَ جاشِرِ",3,"ر",1,0],["أَلا خَيَّلَت خَرقاءُ وَهناً لِفِتيَةٍ","هُجودٍ وَأَيسارُ المَطِيِّ وَسائِدُ",4,"د",1,0],["ألا خَليِّاني في الكلام من السجع","ولا تَجريا في القول إلاّ على الطبع",5,"ع",1,1],["إلا خوالد في المحلة بيتها","كالطيلسان من الرماد الأورق",6,"ق",1,0],["إِلّا خَصائِصَ أَقوامٍ هُمُ سَلَفٌ","لِلصالِحينَ مَعَ الأَنصارِ أَنصارُ",7,"ر",1,0],["الآخذينَ بأنفهِ","لا كالأُلى عِلِقوا ذِنابَهْ",8,"ب",2,0],["ألا خاب من أنساه منكم نصيبَهُ","متاعٌ من الدنيا قليلٌ وزِبرجُ",9,"ج",1,0],["الآخذ الخطة الرضيّة وال","تارك ما الحظ فيه أن يذره",10,"ر",2,0],["ألا خذها إليك عن الحَرونِ","تَناسخَها القرونُ عن القرونِ",11,"ن",1,1],["الآخِذاتُ قُلوبَنا","في زَيَّ طاقاتِ الزُهورِ",12,"ر",1,0],["الآخِذينَ الحُصنَ عَزَّ سَبيلُهُ","مِثلَ السُها أَو في اِمتِناعِ مَنالِهِ",13,"ل",2,0],["أَلا خَبِّروني أَينَ قَبر ذَليلِكُم","وَقَبرُ العَزيزِ الباذِخِ المُتنافِسِ",14,"س",1,0],["إلا خيالُ سعادةٍ قد أقلعت","ووداعُ أحباب ودمعُ مسافرِ",15,"ر",1,0],["الآخِذينَ عَلى المُغيرِ سَبيلَهُ","بِالسَيفِ يَحمي الغيلَ وَالأَشبالا",16,"ل",2,0],["ألا خَسِرَ اليهودُ ولا أصابوا","طِوالَ الدَّهرِ خَيراً أو نَماءَ",17,"ا",2,0],["أَلا خُذها كَمِصباحِ الظَلامِ","سَليلَةَ أَسوَدٍ جَعدٍ سُخامِ",18,"م",1,1],["الآخِذُ الشُهَداءَ أَخذَ مُناجِزٍ","وَالمُستَبيحُ دَمَ الشَهيدِ الأَعظَمِ",19,"م",1,0],["ألاَ خفَّفتَ عبء الأرض هَوْنًا","فأمُّك آدَها النسل الكثير؟",20,"ر",1,0],["الآخذينَ بأنفهِ","لا كالأُولى عِلِقوا ذِنابَهْ",21,"ب",2,0],["أَلاَ خَيَّلَتْ خَرْقَآءُ وَهْناً لِفِتْيَة ٍ","هجوعٍ وأيسارُ المطيِّ وسائدُ",22,"د",1,0],["الا خل العتاب اخل وارجع","لصفو في شؤنك وارتياح",23,"ح",1,0],["الآخذين من الحياة بصفوها","والتاركين لغيرهم ما يكدر",24,"ر",1,0],["ألا خبروني أين ضلّت عقولكم","وكلكم يستهجن الشر والضرا",25,"ر",2,0],["إِلا خَلَعتَ لَها ثِيابَكَ إِنَّها","بِئسَ اللِّباسُ وَشَرُّ كُلِّ لِباسِ",26,"س",1,0],["أَلا خِلٌّ عَلى الأَيّامِ نَدبٌ","يُشاطِرُني الصَبابَةَ وَالسُهادا",27,"د",2,0],["الآخِذينَ زَكاة الشِّعرِ لا حُمِدُوا","عَنها وَلا هِيَ عِندَ اللَهِ تَحتَسبُ",28,"ب",1,0],["إلا خيالا إذا تمشّى","أو شبحٌ في القميص حي",29,"ي",1,0],["ألا خذلي بكعبك بروان","يمكن وإلا حلق رأسي",30,"س",2,0],["الآخرُ الآخذُ بالحجزاتِ","لكلّ مُسلمٍ غدا مسلِّما",31,"م",2,0],["أَلا خَلَّيا مَجرى الجَنوبِ لَعَلَّهُ","يَداوي فُؤادي مِن جَواهُ نَسيمُها",32,"م",3,0],["الآخرونَ وَلَيسَ عَن نَقصٍ بِهِم","لَكِن تَفَضُّلَ مُحسِن مَنّانِ",33,"ن",1,0],["ألا خادٍ أُعَلِّلُها بِنَجدٍ","فَيَنقُصُ ما بِها مِن فَرطِ وَجدِ",34,"د",1,1],["ألا خفَّ تربٌ من ضريحكِ مثلما","لصوتِكِ خفَّت وطأةُ السأمات",35,"ت",1,0],["إِلّا خَميسٌ كامِلِيٌّ قادَهُ ال","أقسيسُ يَسري في اليَبابِ المَقفِرِ",36,"ر",1,0],["ألا خبروني عن صلاة امرئ غدت","بحارُ بسيطٍ عندها ووجيز",37,"ز",1,1],["أَلا خَلّياني يا خَليليَّ وَالجَفا","فَيا رُبَّ واشٍ ساءَ ما بَيننا ظَنّا",38,"ن",2,0],["أَلا خَلِّ خلّي من يَرى الودّ كلفة","كَثَوبِ رياً أَنّى تَردّى بِهِ شَفّا",39,"ف",2,1],["ألا خَلِّياني يا خَليليَّ واعْلَما","إذا لُمْتُما أنْ ليس عَذْلُكما عَدْلا",40,"ل",2,0],["ألاَ خَبَراً عَن رامةٍ أَيُّها الركبُ","فأنّي بمن قد حلَّها مُغْرمٌ صبُّ",41,"ب",1,1],["ألاَ خلاصٌ لِقَلْبِي مِن صَبابتِهِ","فإِنَّه في تعاطي الحُبِّ مَغْروراً",42,"ر",2,0],["الآخذين صفات المجد عن كمل","والفائزين بخلق كالرياض نَدِ",43,"د",1,0],["ألاَ خلٌّ يُزاملني صَباحا","وتحملني وإِيّاه الرياحُ",44,"ح",1,1],["الأخطبوط أراه بدل شكله","كمحيطه ولقد يظنّ صخورا",45,"ر",2,1],["ألا خبر عنهن من بعد ما برى","صدورَ المطايا الهوج شدُّ النسائعِ",46,"ع",1,0],["الأخدان وقت الوصل صحوا","على طول المدى زهر اللئال",47,"ل",1,0],["الآخذُ الأَقرانِ بعد الوغى","والواهبُ الآلافِ قبل السؤال",48,"ل",1,0],["الآخذين بأطراف الفخار علا","إن عاق غيرهم الأعياء والخور",49,"ر",1,0],["ألا خفف نواحك يا فؤادي","فإن النوح لا يجديك نفعا",50,"ع",2,0],["ألا خَيْرُ ما لِلْمَرءِ عَقْلٌ يَزيْنُهُ","فإنْ لم يَكُنْ عَقْلٌ فَجاهٌ ينفِّقُهْ",51,"ق",2,1],["ألا خَبِّراني بارك الله فِيكماِ","مَتى العَهْدُ بالخَطّار يا فَتَيان",52,"ن",1,1],["إلا خوارج ليس يخلو منهمُ","في أمة زمن من الأزمان",53,"ن",1,0],["ألا خبر يشفي غليليَ عنكمُ","فإنيَ لا ألقى سوى ذاك شافيا",54,"ي",2,0],["أَلا خَليلَيَّ اللَذَينِ تَواصَيا","بِلَومي إِلّا أَن أُطيع وَأَضرَعا",55,"ع",2,0],["ألا خَرْجةٌ في اللّه تورثنا العلى","فإما لِهلك أو لعز مُشيد",56,"د",1,0],["أَلا خبِّراني أَيُّها الرّجلانِ","عَنِ النّومِ إِنَّ الشوقَ عنه عَداني",57,"ن",2,0],["أَلا خشيتم عليَّ الآن من حسدٍ","لو تعقلون الّذي لي كان معقولا",58,"ل",2,0],["أَلا خَبروني ما اسم الَّتي","تُحاكي الغَزالة في مَشيها",59,"ه",2,1],["الأخ في الله عزيزٌ جدا","إن تلقه تلق عنا وجدا",60,"د",2,0],["أَلا خَبِرٌ بِمُنتَزِحِ النَواحي","أَطيرُ إِلَيهِ مَنشورَ الجَناحِ",61,"ح",1,1],["ألا خلِّ دمع العين يهمي فمقلتي","لفُرقة عين الدمع وقفٌ على الدم",62,"م",1,1],["الآخِذونَ العَهدَ من آفاقِها","وَالراحِلونَ بِرحلَةِ الإيلافِ",63,"ف",1,0],["الأخيَرَ الأظفَرَ المحمودَ مشهدُهُ","في كُلِّ مَجمَعِ يومٍ غيرِ جُمّاعِ",64,"ع",1,0],["ألا خوفا أراه ألا حياءً","ألا حزناً ألا عيناً تجود",65,"د",1,0],["أَلا خذ حية تسعى","وكفاً فيه أَنوار",66,"ر",1,0],["إلا خمول الذكر حتى يرى","كأنه المختار في المجتبى",67,"ب",2,0],["الأخوة أنعى أم ابني عمك ال","طيار أم أنعى علي الأكبرا",68,"ر",2,0],["الا خلني ممن يهاب ويتقي","فما هذه في الدهر الا مضايق",69,"ق",1,0],["الا خليل خليلي والدي وابا","اذا به الورد منها استقصرت حكمي",70,"م",2,0],["إِلا خَبر يَجيء إِلا رَسول","إِلا سَطر أَنزه فيهِ موقي",71,"ق",2,0],["الاختراع ولم اعرف له وطناً","غيرَ القوى والنفوس المشرئباتِ",72,"ت",1,0],["ألا خبروا عني الخيال الذي سرى","يزر موهنا من قبل مطلع فجره",73,"ر",2,0],["ألا خير ما تسعى لتحصيله الورى","كتابٌ منَ الرَّحمن بالنّور سطِّرا",74,"ر",2,1],["ألا خبرانا بعد ما رحتما معاً","فإنكما للعلم والدين مبتدا",75,"د",2,0],["الاخر الباقى الإله الأبدي","له البقاء والدّوام السرمدى",76,"د",2,0],["الأخضريّ عابد الرحمن","المرتجى من ربّه المنّان",77,"ن",1,0],["أَلا خالفوا أَسرى التَقاليد واِطلقوا","قَرائحكم واِستَلخَصوا ما يُوافِقُ",78,"ق",1,0],["أَلا خبرٌ من ثَنايا العِرا","ق يَطلع أَو زورة تطرقُ",79,"ق",1,0],["ألا خلِّياني والصّبابةَ إنّها","كِرامُ نفوسٍ في الهَوى لذّ صابُها",80,"ب",3,0],["إِلاّ خوالِدَ أَشْباها بَقِينَ على","رَيبِ الحَوادِث في مَرْكُوَّة جَدَدِ",81,"د",1,1],["الإختِصَاصُ كَنِدَاءٍ دُونَ يَا","كاَيُّها الفَتضى بإِثرِ ارجُونِيَا",82,"ي",2,0],["إِلّا خيالاً لو تأمَّلتَه","في الشمس لم تُبصر له فيّا",83,"ي",2,0],["الآخذُو خَير المَناقب وَالعُلا","وَالتاركو سَفساف كُل صِفات",84,"ت",1,0],["الآخذي علم الرسول شريعة","وحقيقة من فاضل عن فاضل",85,"ل",1,0],["ألا خِفْتَ قَيّمنا الشمَّريَّ","وشفرةَ صارمِه الِمخْذَمِ",86,"م",1,0],["الأخذُ للكُتبِ بِهِ النَّصُّ أتَى","وَالخُلفُ فِى العَاصِى لَديهِم ثَبَتَا",87,"ت",2,0],["ألا خفض بحظك للحضيض","فقد قرضتك السنة القريض",88,"ض",1,1],["الاخلاق على الأحداث ناشزة","كأنها جبل عزت مراقيه",89,"ي",2,0],["إِلّا خَليلٌ صادِقٌ ما شَأَنَهُ","شَيءٌ يُكَدِّرُ صَفوَهُ وَيُحَوِّلُ",90,"ل",1,0],["ألا خبّروا إن كان عندَكمُ خبَر","أنقفل أم نثوي على الهمِّ والضجَر",91,"ر",1,1],["ألاَ خَبِّرُوني أَيُّها الجُنْدُ واشْرَحُوا","لِمُعْتَقَلِ العَلْياءِ ذي الفَرحاتِ",92,"ت",1,0],["ألا خُذها وِداداً لا عِناداً","أجَدّ صفاءَها قلبٌ صفي",93,"ي",1,0],["أَلا خل عَيْنَيْك اللجوجين تدمعا","لمؤلم خطب قد ألم فاوجعا",94,"ع",2,1],["الاخره فيها ترا احساب مشتد","زهب زهابك بالرخى لوقت شده",95,"د",2,0],["الأخوق اخو نيرونن بانجيل وصحف وزبور","يخرج بين نهرينن بخله بن يهودية",96,"ي",2,0],["إلا خلاصة أحزانٍ ومعمعةٍ","وحيرةٍ وشتاتٍ في دجى التيهِ!",97,"ي",2,0],["الاخره كانت على طول امامه","فى هالزمن خطاب واشباهه اغراب",98,"ب",1,0],["الأُخْتُ يَا رُبَّاهُ الّتِي رَحَلَتْ","كَالْبَدْرِ كَانَتْ إِنْ أَظْلَمَتْ أُخْرَى",99,"ر",2,0],["الآخذين على المعالي شأوها","والقابضين على زمام الجود",100,"د",1,0],["الآخذات من القلوب قروطها","ومن الضلوع سوار كل يمين",101,"ن",1,0],["الأُخوَةُ الأَعدَاءُ نَحنُ ، فَقَاتِلٌ","مِنَّا ، ومَقتُولٌ دِمَاهُ حَرَامُ",102,"م",1,0],["الآخر اختار في الدنيا مصائره","ونحن أمتنا بالجهل مبطوحه",103,"ح",2,0],["إلا خيانتك ما املك عندها صِرفه","واحذر تحاتي ترى من خونتي سالم",104,"م",1,0],["الأخِلاّءُ يومَ القيامة خَصْمٌ","والعصيمُ مَنْ اتّقى الرحمانا",105,"ن",2,0],["ألا خبّروا الأحباب أنيْ مللتهم","وبدرٌ لهم يخبو ..وحانَ الرحيلُ",106,"ل",1,0],["الآخر الله باقٍ في قداسته","والأول الله قدوسٌ من القِدَمِ",107,"م",1,0],["الاختلافُ طبيعةٌ وحضارةٌ","لكن يُساس بحكمةٍ وذكاء",108,"ا",2,0],["الاختلافُ طبيعةٌ وحضارةٌ","وإطارُه في حكمةٍ وذكاء",109,"ا",2,0],["ألا خبرٌ يعيدُ لنا ابتِساماً","فصوتُ الحقِّ يأباهُ الثّبورُ",110,"ر",1,0],["الأخ الأكبر هل تعرفهُ؟ ركب البحرَ وأرضُ الله جال","والذي يصغرُهُ قبلني ومضى للنصر في ساح القتال",111,"ل",1,0],["الاخضر الحب والتحنان","والاصفر السعد والغيره",112,"ر",2,0],["ألَا ، خافقي لم يصبح اليوم خافقي","وما الجسم إلا محض طينٍ منافقِ",113,"ق",1,1],["الأخت غابت والحياة تعيسة","من فجرها حتى انطفاء سناها",114,"ا",3,0],["ألا خاب مَن للعلمِ قد كان سدَّدا","سِهامَ الرَّدى ، أو لا ومن كانَ قيَّدا",115,"د",2,1],["إلا خمول الذكر حتى يرى","كأنه المختار في المحتبى",116,"ب",2,0],["ألا خبَّرتَ يا مِرسالُ عنّي","بأني لستُ من أهل النذالَهْ",117,"ل",2,0]]}