{"poems":[[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[53,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[107,"عرش القياصر والقضاء إذا جرى","https://www.aldiwan.net/poem43116.html","الكامل"],[48,"والحكم جار على الأكتاد محتمل","https://www.aldiwan.net/poem22384.html","البسيط"],[48,"بك على الناس بالمزموم والرمل","https://www.aldiwan.net/poem23216.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[102,"كاهن الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=50426",""],[96,"ما شأن هذا الأشعث الجواب","https://www.poetsgate.com/ViewPoem.aspx?id=15610",""],[155,"نفسي الفداء لسائل وافاني","https://www.aldiwan.net/poem1413.html",""],[170,"ما بال هذا الفلك الجاني","https://www.aldiwan.net/poem46853.html","السريع"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[266,"هنئت بالإكرام والإعزاز","https://www.aldiwan.net/poem38261.html","الكامل"],[275,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[309,"لله أحبابنا بالأبرق العلم","https://www.aldiwan.net/poem16893.html","البسيط"],[325,"جاز التماس إعادة الأنظار في","https://www.aldiwan.net/poem61665.html","الكامل"],[354,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[369,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[556,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[563,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[563,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[563,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[563,"إن الزجاجة عبرة للرائي","https://www.aldiwan.net/poem35082.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83278","الكامل"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198608","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48771","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48738","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122350","المنسرح"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199569","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38913","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38198","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38167","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62668","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126154","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136304","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206238",""],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101904","الرجز"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101900","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27400","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27724","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27392","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198476",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202586","الرجز"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118913","الدوبيت"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112597","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132748","السريع"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87398","الكامل"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145141","الكامل"],[3556,"","https://poetry.dctabudhabi.ae/diwan/poem/138020","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138613",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109950","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91197","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70146","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4000,"","https://poetry.dctabudhabi.ae/diwan/poem/97829","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58145","البسيط"],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[4767,"بلاغ","https://www.poetsgate.com/ViewPoem.aspx?id=179843",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4791,"ارهابكم مايهز الدين","https://www.poetsgate.com/ViewPoem.aspx?id=36908",""],[5183,"قابيلان","https://www.poetsgate.com/ViewPoem.aspx?id=180190",""],[5277,"زوبعةٌ في فنجان","https://www.poetsgate.com/ViewPoem.aspx?id=187700",""],[5333,"ما رأينا من غايةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=8880",""],[5351,"نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=202600",""],[5431,"أغنية-مجزوء الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=197736",""],[5431,"ليلى والذئاب....","https://www.poetsgate.com/ViewPoem.aspx?id=207188",""],[5606,"ليت فلان نام","https://www.poetsgate.com/ViewPoem.aspx?id=207434",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[563,"إن الزجاج عبر للرائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56281&r=&rc=11",""]],"verses":[["والحكُم فيه مُبينٌ غيرُ ملتبسٍ","لو رِيمَ فيه خلافُ الحقِّ لم يُصَبِ",0,"ب",1,0],["والحكيمُ العليمُ بالله معصو","م وليس المعصوم كالمفتون",1,"ن",1,0],["وَالحُكمُ إِن وَزنَ الأُمورَ بِواحِدٍ","غَبَنَ الشُعوبَ وَخانَهُ الميزانُ",2,"ن",1,0],["وَالحُكمُ جارٍ عَلى الأَكتادِ مُحتَمَلٌ","وَلا يُطيقُ ثَباتاً تَحتَهُ الكَتَدُ",3,"د",1,1],["وَالحُكمُ مِن عالَمٍ عالٍ تَنَزُّلُهُ","فَما لِسُكّانِ هَذي الأَرضِ كَالهَمَلِ",4,"ل",1,0],["والحكيمُ الكندي ثم ابن سينا","وابنُ رشدٍ وهو الحفيُّ الجسور",5,"ر",1,0],["والحكم شرطي يسير وراءنا","سرا فنكهة خبزنا استجواب",6,"ب",1,0],["والحكايا رؤى سجين أقرّوا","شنقه بعد سجن عشرين عاما",7,"م",2,0],["والحكمة الغرّاء في كلماته",": نور البيان وحلية الآداب",8,"ب",1,0],["والحكمُ هذا في القفا أبداً وفي","رحمٍ وفي السّكّين والسُّلطانِ",9,"ن",1,0],["والحكمُ للجبّارِ فيما قَضى","وكلَّ يومٍ هو في شان",10,"ن",1,0],["والحكمة ظاهرةٌ أبداً","فيما قدّرت لكلّ صفي",11,"ف",2,0],["والحُكم والحِكم التي بمضائها","ومضائه جردت حد جراز",12,"ز",1,0],["والحكمُ للمملوكِ عندَ خليفةٍ","سَجَدت له الأمراء والعبّاد",13,"د",1,0],["والحكمةُ الزهراءُ تندبُ بيتَها","وتقولُ للمأمونِ طالَ تحسّري",14,"ر",2,0],["والحكم للَه ذي العرش العظيم وذي","الأمر المطاع تعالى بارئ النسم",15,"م",1,0],["وَالحُكمُ في المَعروضِ يُصدِرُ أَوَّلاً","بِقُبولِهِ أَو رَفضِهِ بِهَوانِ",16,"ن",1,0],["وَالحُكمُ بِالتَضمينِ بَعدَ بَراءَةٍ","بِمَبالِغَ في حَيِّزِ النُقصانِ",16,"ن",1,0],["وَالحُكَماءُ العارِفونَ صَبّوا","رَأَيي بِرَفعِ الوَصفِ عَنها وَالبَدا",17,"د",2,0],["والحُكْمُ حُكْمُ اللهِ لا","يُغْني إذا نَزل احْتيالي",18,"ل",2,0],["وَالحُكم كانَ لِأَجَل ذَلِكَ في ذَوي","هِمَم مَوكلة بِكَشف هُموم",19,"م",1,0],["وَالحَكَمانِ مَوضِعُ الآثامِ","إِذ يُجعَلانِ صَفوَةَ الأَنامِ",20,"م",1,0],["والحكم أيضا بجمهورية عجبت","منه الغلاة وقد عدوه تبديلا",21,"ل",2,0],["والحكمُ للسّمرِ الطّوالِ به","في القومِ أو للأبيضِ النَّصْلِ",22,"ل",1,0],["والحكم ليس سوى حكم الحروف وما","لها وجود فحقق رتبة النبلا",23,"ل",2,0],["والحكم فيها قد أتى منه على","ما كان منها في القديم الأول",24,"ل",1,0],["والحكم منها نازل في حقهم","شهدت به الآيات والأخبار",25,"ر",1,0],["والحكم منه على الذي هو ظاهر","حكم عليه بلبسة وخفاء",26,"ا",2,0],["والحكم بالحق وبالسداد","فرض من الله على العباد",27,"د",1,0],["وَالحَكُّ يَستَوري الزِنادَ وَإِنَّما","تُربي الصَوارِمَ بِالصِقالِ مَضاءَها",28,"ا",3,0],["والحكمُ شرعُ اللهِ فينا قد قضى","بِالعدلِ لا جَوْرٌ إيثارُ",29,"ر",1,0],["والحكم ما ملك القلوب سماحه","لا ما عنت لمراسه الأعناق",30,"ق",1,0],["والحكم في حق الشعوب فما نرى","للحكم إلا المصلح المقداما",31,"م",2,0],["والحكم السائرات من كلمي","اقلها ان تذكروا جمل",32,"ل",1,0],["والحكم للسلطان ما هوب تنكار","وحكمك عدى عن حكم هافى الخصالي",33,"ل",2,0],["وَالحُكمُ للَّهِ مَولانا وَخالِقنا","قَضى بِأَنّ سُليمان الزّمان قَضى",34,"ض",2,0],["وَالحُكمُ للَّهِ الكَبيرِ","بِما يَجيءُ وَما مَضى",35,"ض",2,0],["وَالحُكمُ للَّهِ العليِّ وَإِنّما","خَيرُ المصابِ مسلم وَصَبورُ",36,"ر",1,0],["والحكم في الآخرة الجَرُّ بعط","فه على الدنيَا لجر شاملِ",37,"ل",1,0],["والحكم في الأبكم","والمَجنون مثل من صبا",38,"ب",2,0],["والحكم للأرواح في حال الرضا","والسخط والأجسام آلة من عبر",39,"ر",1,0],["والحكم في هذي الصقور الصايدَهْ","عند الغواة الضابطي القاعدَهْ",40,"ه",1,0],["والحكم بالوهم على أهله","معرض في وصفه للزوال",41,"ل",1,0],["والحك بالراسخت والنشادر","والقلي والكبريت عند الماهرِ",42,"ر",1,0],["والحكم لله وله وهو صغير","وكل شي بْحِلْم قاده بِشْعره",43,"ر",2,0],["والحكم في الأفعال وضعا ما وضع","وإن يكن عنها العقاب قد رفع",44,"ع",1,0],["والحكم في هاتين بالمنع اختلف","بعد فساد العقد من كل طرف",45,"ف",1,0],["والحكمُ مني بهذا القولِ صورته","ما قلته وكذا المشهودُ بالبصر",46,"ر",1,0],["والحكم بي ما استقلَّ حتى","أوجد في عينها ذُكاء",47,"ا",2,0],["والحكم للأعيان ليس لذاته","إلا القبول له بحكم شهوده",48,"د",2,0],["وَالحُكمُ نِسبَتُهَا إلَى مُتَعَلِّقَا","تٍ تَقضِي آثَارَهَا بِبَيَانِ",49,"ن",1,0],["وَالحُكمُ شَرعِيٌّ وَكَونِيٌّ وَلاَ","يَتَلاَزَمَانِ وَمَا هُمَا سِيَّانِ",49,"ن",1,0],["والحِكمَةُ العُليَا عَلَى نَوعَينِ أي","ضاً حُصِّلا بِقَوَاطِعَ البُرهَانِ",49,"ن",1,0],["وَالحِكمَةُ الأخرَى فَحِكمَةُ شَرعِهِ","أيضاً وَفِيهضا ذَانِكَ الوَصفَانِ",49,"ن",1,0],["والحُكم شورى في عقيدته","متآخياً في غرّةِ الطّلبِ",50,"ب",1,0],["والحكمُ للغيد دليلٌ قاطعٍ","من يتزوجْ رُمن منه الهربا",51,"ب",2,0],["والحكمة من حديث قطعي سقمٌ","فيكم صَحت آياته والصحفُ",52,"ف",1,0],["والحكم إن يقصد به أخلاقه","فسناؤه فجر بمصر كذوب",53,"ب",1,0],["والحكم السيف الصقيل الذي","بحكمه الفاصل لا يستهان",54,"ن",1,0],["وَالحكمُ حكمك فاقترح تَجِدِ المُنى","مُتَسابِقاتٍ تلتقيك ضُروبا",55,"ب",2,0],["والحكم مختلف فيهم فأولهم","قتاله واجب لا شك حين غلا",56,"ل",2,0],["والحكمُ للبعض هو الجزئيّه","والجزء معرفته جليّه",57,"ه",1,0],["والحكم للجنس بحكم النوع","وجعل كالقطعيّ غير القظعي",57,"ي",1,0],["والحكم للأقوى وأن","صار الهدى ليسوا هناك",58,"ك",1,0],["والحكم في الثالث ما شئت اصنع","في الابتدا والوقف فالكل وعي",59,"ي",1,0],["والحكم في الإسلام للوزغ انتهى","من آل مروان الخبيث العنصر",60,"ر",1,0],["والحكيمُ النبيهُ يَثبُتُ كالشمسِ","أَبى ان يَخُولَ عنهُ الكَمالُ",61,"ل",1,0],["والحكمُ سيفٌ في يمينِ وُلاتِه","قد ينتضَى طَوراً وطَوراً يُغمَدُ",62,"د",1,0],["وَالحُكم للدور فيما قلته قِدَماً","وَرُبَّ توسعة مِن بَعد تَضييق",63,"ق",1,0],["والحكيم الذي يخلد ذكرى","حسنات تتلى الى الابديه",64,"ه",1,0],["والحكم في رفعيهما جلي","بينهما التباين الجزئي",65,"ي",1,0],["وَالحكمُ صونٌ للانامِ ومرتعٌ","لو مالَ مالوا للردى وتبددوا",66,"د",3,0],["والحِكمَةَ الرَّائِقةَ للعِيَانِ","وَالفَضلَ بِالمَنطِقِ وَالبَيانِ",67,"ن",1,0],["وَألحّ كِسرى بالجنود عليهمُ","وَطميح يردفُ بالسيوف ويدفعُ",68,"ع",1,0],["والحكمُ في علَّةٍ ثَبتاً وفي عَدمٍ","يَقضي انقلابَ الذي لِلقصد لم ينَل",69,"ل",1,0],["والحكمِ والعلمِ والإنصافِ والشيمِ","والعزمِ والحزمِ والأحكامِ والْحِكمِ",70,"م",1,0],