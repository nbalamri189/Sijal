{"poems":[[73,"لا غرو أن ضاعت الأعياد بينكم","https://www.aldiwan.net/poem3815.html","البسيط"],[91,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[64,"قد كذب الظن صادق الخبر","https://www.aldiwan.net/poem52383.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85793","الرجز"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126123","الرجز"],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143772","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4767,"شهر شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=178375",""],[5273,"صلصال القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=191783",""]],"verses":[["قَد كَذَّبوا ما رَأَوهُ وَهوَ مُتَّضحٌ","وَصَدَّقوا ما رَواهُ وَهوَ مُمتَنِعُ",0,"ع",1,0],["قد كذبوا فالشعر حيّ","بالنشاط مفعم",1,"م",1,0],["قد كذَّبَ الظنَّ صادقُ الخَبَرِ","وكنتُ من صِدْقِه على حَذَرِ",2,"ر",1,1],["قد كذبوا فالشعر حي","يٌ بالنشاط مفعمُ",3,"م",1,0],["قدك ذا أم غصن مائس","تثني الصبا عطفيه والشمأل",4,"ل",1,0],["قد كذبوا والله فيما زعموا","وعن سبيل الرشد ضلوا وعموا",5,"م",3,0],["قد كذبنا فالضد أنت أبا سع","دٍ فخذ ما يقال في الأضداد",6,"د",1,0],["قَد كَذَبتُم عَلى اِسمِكُم بَل أَرَدتُم","مِنهُ عَكسَ المُرادِ وَالمَقصودِ",7,"د",1,0],["قَد كَذَبَ الزُّنُوجُ فِيمَا قَالَوا","بِأَنَّهُ أزيَد وَذَا مُحَالُ",8,"ل",1,0],["قَد كذبنا ما وَفينا معه","إِذ وَأدنا الصدق فيهِ وَالوَفاءَ",9,"ا",2,0],["قد كَذَّبَ الزَرقاءَ قَومٌ حَسِبُوا","مَقالَها الصادِقَ زُوراً مُفتَرى",10,"ا",1,0],["قد كذَّب الكذبُ ما قالوه فافتُضحوا","واستسلمت منهمُ للعقل أقوال",11,"ل",1,0],["قَدْ كَذَّبوا الهُدْهُدَ الصِّدّيقَ في نَبَأٍ","وَنَكَّروا الفَجْرَ في زِيٍّ مِنَ الغَسَقِ",12,"ق",1,0]]}