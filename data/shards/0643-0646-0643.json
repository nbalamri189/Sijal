aspx?id=184102",""],[6024,"الإنبيق","https://www.poetsgate.com/ViewPoem.aspx?id=186350",""],[6045,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=138521",""],[6084,"كن كريما اذا بليت بأمر","https://www.poetsgate.com/ViewPoem.aspx?id=170879",""],[6093,"لا تسمى وثبة النسر انحطاط","https://www.poetsgate.com/ViewPoem.aspx?id=203968",""],[6100,"عاشر سنه مرت وانا مانسيتك","https://www.poetsgate.com/ViewPoem.aspx?id=52598",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6124,"أوتار الكمان","https://www.poetsgate.com/ViewPoem.aspx?id=201312",""],[6131,"على سلَّمِ المَوتِ نهْتديْ","https://www.poetsgate.com/ViewPoem.aspx?id=189334",""],[5309,"غدا سترشف اسماع وألباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573801",""],[6174,"لا أريدُ اعتذاراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86186&r=&rc=3",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة (ميسون)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74364&r=&rc=2",""],[6304,"يقظان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1616&r=&rc=6",""]],"verses":[["كُن كَعودِ الطَريقِ طالَ سُراهُ","يَشتَكي قَفرَةً وَيَألَمُ عَقرا",0,"ر",2,0],["كُن كَيفَ شِئتَ فَإِنَّ المَجدَ مُحتَمِلٌ","عَنكَ المَغافِرَ في بَدءٍ وَفي عَقِبِ",1,"ب",1,0],["كُن كَالسَمَوأَلِ إِذ سارَ الهُمامُ لَهُ","في جَحفَلٍ كَسَوادِ اللَيلِ جَرّارِ",2,"ر",1,0],["كُن كَيفَ شِئتَ وَلا تَكِل أَرواحَنا","لِلمُستَشارِ فَإِنَّ عَدلَكَ أَخصَبُ",3,"ب",1,0],["كُن كَيفَ شِئتَ فَإِنَّني","ذاكَ المُواسي وَالمُشارِك",4,"ك",1,0],["كُن كَما شِئتَ مِن وِصالٍ وَهَجرٍ","غَيرَ قَلبي عَلَيكَ غَيرُ كَئيبِ",5,"ب",1,0],["كن كيفَ شئتَ فلا براح","أنتَ المنى والإقتراح",6,"ح",1,1],["كنْ كيفما شئت من صدٍّ ومن عطف","فما ودادك في أحشايَ مصدود",7,"د",1,0],["كن كيفما شئت وعن مهجتي","فلا تسل عن حال أهل الجحيم",8,"م",1,0],["كن كأن لم تلاقني قطُّ في النا","س ولا تجعلنَّ ذكراي سوقا",9,"ق",2,0],["كُن كَيفَ شِئتَ فَلَستُ أَسكُنُ لِلمُنى","بَعدَ الحَبيبِ وَلَستُ أَحذُرُ موبِقا",10,"ق",2,0],["كُن كَما أَطلُبُهُ في نِعمَةٍ","وَالَّذي تَعهَدُ باقٍ بَينَنا",11,"ن",2,0],["كُن كَيفَ شِئتَ فَأَنتَ أَنتَ المُرتَضى","فَهَوايَ فيكَ هَوايَ لَيسَ يَحولُ",12,"ل",1,0],["كن كيف شئت وخذ للعلم حفلته","فما وجدت كعلم المرء ينفعه",13,"ع",2,0],["كُن كَريماً إِن رَأى جُرحاً أَسا","وَتَعَهَّد وَتَوَلَّ البُوَسا",14,"س",2,0],["كُن كَيفَ شِئتَ بِأَمنِ اللَهِ يامَلِكاً","أَضحَت عَزائِمُهُ أَقطابَ أَفلاكِ",15,"ك",1,0],["كُن كَيفَ شِئتَ فَإِنَّ فيكَ خَلائِقاً","أَمسى إِلَيهِنَّ الرَجاءُ مُفَوَّضا",16,"ض",2,0],["كُنْ كَمَا شِئْتَ مِنْ رَشَادٍ وَغَيٍّ","كُلُّ حَيٍّ بِمَا جَنَاهُ رَهِينُ",17,"ن",1,1],["كُنْ كَمَا شِئْتَ يَا فُلانُ وَمَا شَا","ءَتْ رِجَالٌ فَأَنْتَ لِلُّؤْمِ أَهْلُ",18,"ل",1,0],["كُنْ كيف شِئتَ ولا تَعبأْ بِمعترضٍ","الشَّعبُ مُستسلِمٌ والأمر مُنتظِمُ",19,"م",1,0],["كُن كَيفَ شِئتَ فَلَو هَمَمتَ بِتَوبَةٍ","لَثَناكَ عَمّا رُمتَ بابٌ مُقفَلُ",20,"ل",1,0],["كن كيف شِئتَ فلن ترى لك ناصراً","ما دمت للَّهِ العليِّ خصيما",21,"م",2,0],["كُن كَالمُجَشَّرِ إِذ قالَت رَعيَتُهُ","كانَ المُجَشَّرُ أَوفانا بِما حَمَلا",22,"ل",2,1],["كن كيفَ شئتَ بأرضِ المشرقينِ تكن","بها الشّهابَ الذي يعلو على الشُّهُب",23,"ب",1,0],["كُنْ كَما شاءتِ السَّماءُ كَئيباً","أيُّ شيءٍ يَسُرُّ نفسَ الأريبِ",24,"ب",1,0],["كن كما شئتَ أيها الشِّعْرُ فنَّا","ناً فلن تستطيع لمحَ صِفاتهْ",25,"ت",2,0],["كنّك تطيش وكني أدور في طوق","كل ماوصلت آخرك يطلع لي أولك",26,"ك",1,0],["كن كيف شئت فلست لأسكن للمنى","بعد الحبيب ، ولست أحذر موبقا",27,"ق",2,0],["كن كما رمت ففي الدارين في","ظلنا السامي كما رمت كما",28,"م",2,0],["كن كيف شئت وفيها أو أخا ملل","لا بد لي منك مثل الماء للهيم",29,"م",1,0],["كُن كَما شِئتَ وَدَعني","فيكَ مِن قَولٍ كَذُوب",30,"ب",1,0],["كن كيف شيت فما لي عنك من بدلٍ","أنت الزلال لقلب بات ظمآنا",31,"ن",2,0],["كنْ كسلطان بن سيف في الوَرَى","وامتنل أخلافه ثمَّ اشتَمِلْ",32,"ل",1,0],["كن كيف شئت فأنت أنت أمينها","ما بين بادي عربها والحاضر",33,"ر",1,0],["كن كيف شئت أخا الوفاء فإنني","أثنى عليك إقامة ورحيلا",34,"ل",2,0],["كُنْ كَيفَما شِئْتَ وجُرْ في القَضا","فَإِنَّني أَطوعُ منْ عَبْدِ",35,"د",1,0],["كُنْ كيفَ شِئتَ من البِعا","دِ فأَنتَ من قلبي قَريبُ",36,"ب",1,0],["كُن كَيفَ شِئتَ فَإِنَّني لَكَ وامِقٌ","أَنتَ المَليكُ وَقَلبِيَ المَملوكُ",37,"ك",1,1],["كُن كَاِبنِ مَسعُودٍ حُسَينٍ في النَدى","وَالبَأسِ أَو فَعَنِ المَكارِمِ فَاِعدِلِ",38,"ل",1,0],["كَن كَيفَما كَنتَ لا بِدعَ كُفيتَ بَلاً","لَدَيهِ كابدتُ لَوماً لِلعَذول كَفى",39,"ف",2,1],["كُن كَيفَ شئتَ تَجدْ مُحبّك مِثلَما","تَهوى عَلى الحالين غَير مغايرِ",40,"ر",1,0],["كن كيسا فطنا جزلا تجد وزر","فالكيّسُ النحد قد تصفو مشاربه",41,"ب",2,0],["كن كيف شئت وحيث شئ","تَ فلن يفارقني خيالُكْ",42,"ك",1,0],["كن كيف شئتَ وأنكر في الهوى شغفي","فسوق أدفع بهتاناً ببهتان",43,"ن",1,0],["كُن كَيفَ شِئتَ فَلَستَ أَوَّلَ مَن عَدا","في الناسِ قَوّالاً بِما لَم يَفعَلِ",44,"ل",1,0],["كُن كَيفَ شِئتَ فَما أَميلُ إِلى","عَذلٍ وَلا أُصغي إِلى عَتبِ",45,"ب",1,0],["كن كيفما شئت فما","للقلب عنك مُنقَلَب",46,"ب",1,0],["كُن كيفما شِئتَ فالموالي","لا تتَساوى بها العَبِيدُ",47,"د",1,0],["كُنْ كَيْفَ شِئْتَ إِذا ما لَمْ تَخِمْ فَرَقاً","لا عَيْبَ لِلسَّيْفِ إِلاّ أَنْ يُقالَ نَبا",48,"ب",2,0],["كُن كَما كانَ كَمالُ الدينِ في","صَبرِهِ عِندَ المُلِمّاتِ الثِقالِ",49,"ل",1,0],["كن كيف شئت فإن قد","رك قد غلا عندي وعزا",50,"ز",2,1],["كن كاتما للضر والبؤسى تنلْ","قصدا وتعلُ الجيل يامتعلمُ",51,"م",1,1],["كُن كَالزَنادِ يَقِدُّ ناراً قَحُهُ","لِلناسِ وَالمَلموسُ مِنهُ بارِدُ",52,"د",1,1],["كُن كاملاً كانَ بالتقوى لهُ كلف","كما له بالتُقى لا سائما كسلا",53,"ل",2,0],["كُن كَيفَ شِئت فَاِنّي فيك ذو كلف","قَد اِستَوى في هَواك كله شَجَن",54,"ن",1,0],["كن كَما شِئت اِنَّني لك عَبد اللَه","عبد فهل أَفوز بِبشرى",55,"ر",2,0],["كُن كَيفَ ما شِئتَ يا حَبيبي","لا كانَ مِن عَن هَواك رَدّك",56,"ك",1,0],["كُنْ كعَهْدي في الوُدِّ فاليومَ فوقَ ال","عَهْدِ في الجودِ لي بكَ المَظْنون",57,"ن",1,0],["كُنْ كيف شِئْت فبي وإن لم تُدنني","ما عشْتُ حُبٌّ لا يزال يَزيد",58,"د",1,0],["كن كالعمود لدى مولاك منتصباً","وقت الصلاة وكن للبر عطشانا",59,"ن",2,0],["كن كذا رحب الجَناب","راكباً طرف الجِناب",60,"ب",1,0],["كن كالسموأل في وفاء العهد إذ","كانَ البقاءُ على العهود وفاءَ",61,"ا",2,0],["كن كما شئتَ فإنَّا قد رفعن","راي