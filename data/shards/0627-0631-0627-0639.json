{"poems":[[55,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[65,"جوانح للغرام بها وشوم","https://www.aldiwan.net/poem45778.html","الوافر"],[65,"هل الوجد إلا لوعة أعقبت أسى","https://www.aldiwan.net/poem45797.html","الطويل"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[43,"أراعك طائر بعد الخفوق","https://www.aldiwan.net/poem42367.html","الوافر"],[91,"أراعك مني أنني رجل حر","https://www.aldiwan.net/poem45085.html","الطويل"],[87,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[45,"أراع كذا كل الملوك همام","https://www.aldiwan.net/poem10525.html","الطويل"],[63,"على الرغم بدلت من رغم لاحي","https://www.aldiwan.net/poem51742.html","المتقارب"],[51,"أراعك نقص منك لما وجدته","https://www.aldiwan.net/poem62052.html","البسيط"],[46,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[46,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[76,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[35,"أرقت وعادني هم جديد","https://www.aldiwan.net/poem25961.html","الوافر"],[35,"أيا ليل ما للصبح منك بعيد","https://www.aldiwan.net/poem25964.html","الطويل"],[107,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[48,"لقد وضعت حواء أمك بكرها","https://www.aldiwan.net/poem22644.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9903","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54895","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[113,"سقى الودق ما بين الرياض لنا صرحا","https://www.aldiwan.net/poem16242.html","الطويل"],[119,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[164,"أعن ملل خيالك لا يطيف","https://www.aldiwan.net/poem58766.html","الوافر"],[190,"وطال الليل حتى لست أدري","https://www.aldiwan.net/poem43653.html","الوافر"],[214,"رحلتم بالغداة فسرت شوقا","https://www.aldiwan.net/poem13545.html","الوافر"],[242,"أبا عمران قد جئنا إليكم","https://www.aldiwan.net/poem18155.html","الوافر"],[275,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[280,"أبى الحسن إلا أن تعز وتغلبا","https://www.aldiwan.net/poem25614.html","الطويل"],[302,"أما وابتسام الروض عن شنب الزهر","https://www.aldiwan.net/poem33260.html","الطويل"],[303,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[422,"أرى هذي النياق لها حنين","https://www.aldiwan.net/poem53913.html","الوافر"],[422,"يقول لي النصوح هلكت وجدا","https://www.aldiwan.net/poem53966.html","الطويل"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[422,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[447,"نودعكم أحبتنا وداعا","https://www.aldiwan.net/poem14311.html","الوافر"],[482,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[518,"أراعك برق في دجى الليل لامع","https://www.aldiwan.net/poem67731.html","الطويل"],[556,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[567,"وفاء العهد من شيم الكرام","https://www.aldiwan.net/poem52793.html","الوافر"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76567","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63991","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63962","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67818","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62524","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96736","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16917","الطويل"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131928","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136351","الطويل"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104412","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144763","الوافر"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146063","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66269","الرجز"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104813","الوافر"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46741","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65967","الطويل"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105601","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132534","الطويل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105628","الوافر"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203545","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62873","المتقارب"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17666","الطويل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104838","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91480","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91108","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216529","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36742","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146866","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86461","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102762","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143025","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58098","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99105","الوافر"],[4679,"هو البشرُ للفؤاد فيطربُ","https://www.poetsgate.com/ViewPoem.aspx?id=142759",""],[4727,"ذكرتك والأقوام رقد","https://www.poetsgate.com/ViewPoem.aspx?id=214426",""],[5122,"سمان القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=24712",""],[5277,"إنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=185231",""],[5277,"زبيدة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189842",""],[5277,"رابحة ..في حلّي ومرتحلي","https://www.poetsgate.com/ViewPoem.aspx?id=192911",""],[5277,"ظِلٌّ وحرور","https://www.poetsgate.com/ViewPoem.aspx?id=205140",""],[5376,"يلازمني في حبها الدمع والقطر","https://www.poetsgate.com/ViewPoem.aspx?id=190453",""],[5409,"نعيك هز أرجاء البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=155455",""],[243,"سراج","https://www.poetsgate.com/ViewPoem.aspx?id=50494",""],[5725,"اعيّوق ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=178280",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[6019,"وترفُضُ عينايَ فوضى احتمال !!","https://www.poetsgate.com/ViewPoem.aspx?id=61794",""]],"verses":[["أُراعي بُلوغَ الشَيبِ وَالشَيبُ دائِيا","وَأُفني اللَيالي وَاللَيالي فَنائِيا",0,"ي",2,1],["أُراعيها وَلي نَظَرٌ كَليلٌ","يُكَفكِفُ غَربَهُ الدَّمعُ السَّجومُ",1,"م",1,0],["أُراعِي نُجومَ اللَيلِ وَهْيَ طوالِعٌ","إِلى أَن يُضيءَ الفَجرُ وَهيَ أُفولُ",2,"ل",1,0],["أُراعُ ولمْ أُذْنِبْ وأُجْفى ولمْ أُخنْ","وقد صُدِّقَ الواشي فأخْنى وأقْذَعا",3,"ع",2,0],["أُراعي نُجومَ اللَيلِ وَهيَ كَأَنَّه","قَواريرُ فيها زِئبَقٌ يَتَرَجرَجُ",4,"ج",1,0],["أَرَاعَكَ سَيْفٌ فِي الشَّوَاطِيءِ مُلْتَوٍ","مَضَارِبُهُ سُمْرٌ وَسَاحِلُه دَمُ",5,"م",1,0],["أَرَاعكَ طَائِرٌ بَعَد الخُفوقِ","بفَاجِعَةٍ مُشنَّعةِ الطُّروقِ",6,"ق",1,1],["أراعك مني أنني رجل حرّ","وأَنِّيَ لا نهنئٌ عليَّ ولا أمرُ",7,"ر",1,1],["أَراعَكَ مَقتَلٌ مِن مِصرَ باقٍ","فَقُمتَ تَزيدُ سَهماً في السِهامِ",8,"م",1,0],["أَراعَ كَذا كُلَّ المُلوكِ هُمامُ","وَسَحَّ لَهُ رُسلَ المُلوكِ غَمامُ",9,"م",1,1],["أراعي المنيَّةَ عندَ الغُدُوِّ","وأنتظرُ الحَتْفَ عندَ الرَّواحِ",10,"ح",1,0],["أَراعَكَ نَقصٌ مِنكَ لَمّا وَجَدتَهُ","وَما زِلتَ في نَقصٍ وَأَنتَ وَليدُ",11,"د",1,1],["أَراعي ضَلالاتِ المُروءَةِ مُهمَلٌ","وَحافِظُ أَيّامِ المَكارِمِ ضائِعُ",12,"ع",1,0],["أُراعي مِن كَواكِبِهِ هِجاناً","سَواماً ما تَريعُ إِلى المُسيمِ",13,"م",1,0],["أُراعي نُجومَ اللَيلِ حُبّاً لِبَدرِهِ","وَلَستُ كَما ظَنَّ الخَلِيُّ مُنَجِّما",14,"م",2,0],["أُراعي الفَرقَدَينِ مَعَ الثُرَيّا","كَذاكَ الحُبُّ أَهوَنُهُ شَديدُ",15,"د",1,0],["أُراعي نُجومَ اللَيلِ سَهرانَ باكِياً","قَريحَ الحَشا مِنّي الفُؤادُ فَريدُ",16,"د",1,0],["أُراعُ لِخَطبِها وَالدَهرُ أَمنٌ","وَنُعمى العَيشِ وارِفَةُ الظِلالِ",17,"ل",1,0],["أُراعُ فَلا أَرعى وَمِثلي مَعاشِرٌ","تَنامُ فَلا تَنمي وَتَكرى فَلا تُكري",18,"ر",2,0],["أُراعي نُجومَ اللَيلِ وَهيَ كَأَنَّها","قَواريرُ فيها زِئبَقٌ يَتَرَجرَجُ",19,"ج",1,0],["أَراعَكَ لأْلاءُ المَنَارَة فِي الدجَى","إِذِ الْفلْكُ وَثْبٌ بِالْعُلى وَتَحَدّرُ",20,"ر",1,0],["أَرَاعَكَ إِصبَاحٌ يُطَارِدُ ظُلْمَةً","بِهَا كَانَ أُنْسٌ مَا تَشَاءُ وَطِيبُ",21,"ب",1,0],["أُراعُ وَلَم أُذنب وَأَجفا وَلَم أَخُن","وَأَطلُب مِن قَبل المُحاربة الصُلحا",22,"ح",2,0],["اراعي نجوم الليل في الروم والنوى","يصارع لي قلبا يغيب ويحضر",23,"ر",1,0],["أراع ولا أراع وكيف شأني","وقد حَذَرَتْ مصارعيَ الحتوفُ",24,"ف",1,0],["أراعي الصبح وهو يفرّ منّي","كما ولّى الشتاء عن الربيع",25,"ع",1,0],["اراعي النجم في سيري اليكم","ويرعاه من البيدا جوادي",26,"ي",1,0],["أَرَاعِي مَنْ أَتَاهُ ارْعَ الذِي قَدْ","أَتَاكَ بِوُلْدِهِ مِنْ كُلِّ عَادِ",27,"د",1,0],["أراعتكِ مني صفرةٌ هي زينتي","نعم أنا في غلٍّ ولن يشتفي غلّي",28,"ل",2,0],["أُراعُ لِذِكْراها فأُرْعَدُ خيفَةً","كَما زَعْزَعَتْ غُصْناً بهَبَّتِها الصّبا",29,"ب",2,0],["أراعي دُجىً لا يَستَحيلُ ظَلامُها","وأَنجمَ لَيلٍ لا تَسيرُ ولا تَسري",30,"ر",2,0],["أَراعكَ منظري وشجاكَ حالي","وسالَ بدمعِ ناظِرك العقيق",31,"ق",1,0],["أراعَ فؤادَها بَيْنٌ وإلاّ","فما هذا التَّلَهُّفُ والبكاء",32,"ا",2,0],["أراعَكَ ما ترى من رسم دارٍ","وطارَ بقلبك البرق اللّموح",33,"ح",1,0],["أراعهم ما أراهم من مكارمه","وجاء من بره المعروف بالعجب",34,"ب",1,0],["أراعها ما رأته من عزائمه","فأذعنت لمليك الأرض إذعانا",35,"ن",2,0],["أراع اللَه قلباً غير راع","حفاظكم ولا بكم أراعا",36,"ع",2,0],["أُراعُ بنارَيْ بارقِ وصبابةٍ","مقيلُهما مِن مزنةٍ وضلوعِ",37,"ع",1,0],["أراعك برقٌ في دجى الليل لامع","أجل كل ما يلقاه ذو الشوق رابع",38,"ع",1,1],["أَراعكَ ما راعَني مِن رَدى","وجدتُ له مثلَ حزّ المُدى",39,"ا",1,1],["أُراعي حقَّهُ ما دامَ حيّاً","وبعدَ وفاتِهِ حقَّ العِظامِ",40,"م",1,0],["أراع فأسأل عن صبحها","فيرجع لي جنحها نم هنيا",41,"ي",2,0],["أرَاعَكَ أنْ قيلَ الفراقُ يرُوعُها","فتعصي النَّوى مِنْ أجلها أو تُطِيعُها",42,"ع",3,1],["أُراعي قَبرَها حَدِباً عليه","مراعاةَ الممرِّض للمريض",43,"ض",1,0],["أُرَاعِي نُجُومَ اللَّيْلِ شَوْقاً إلَيْكُمُ","وَذَاكَ لِرُغْبي فِي الْهَوى وَشَقَائي",44,"ي",1,0],["أراعي النجم سهراناً بطرف","ومن يرعى العُلا يأبى المناما",45,"م",2,0],["أراعي أفقول النجم وهو مسامر","وأرعى بزوغ الفجر وهو رقيب",46,"ب",1,0],["أراعي انشقاق الفجر من أبرق اللوى","وأرعى طلوع الشمس من جانب الحمى",47,"م",2,0],["أَراعها حادثٌ جاء الزمانُ بهِ","أَم هاجها ذكر آلافٍ وخلّ‍انِ",48,"ن",1,0],["أُراعي نُجومَ اللَيلِ وَهيَ كَأَنَّها","كَواعِبُ تَرنو مِن بَراقِعِ سُندُسِ",49,"س",1,1],["أُراع لخطبٍ بدا في الوجودْ","وُقوعاً كوقع مواضي الحُدودْ",50,"د",1,1],["أراعيك في سري وأرعاك في العلن","وحسبك أني فيك أظهرت ما بطن",51,"ن",1,1],["أراع فؤاد الدهر بطشك فانطوت","على ومجل أحشاؤه والاضالع",52,"ع",1,0],["أراعي الزهر مكتئبا","كأني في السما شغفُ",53,"ف",1,0],["أراعي نجوماً من دموعي طوالعاً","ضللت بها صبري وبالنجم يهتدى",54,"د",2,1],["أراعها ولاة مَن تنتابه","لا مفزع فهو أصاب المفزعا",55,"ع",2,0],["أَراعَ المُشرِكينَ بِكُلِّ ثَغرٍ","وَفَلَّ جُيُوشَ كفرٍ بِالسَرَايا",56,"ا",3,0],["أُراعِي التالِياتِ مِن الثرَيّا","وَدَمعُ العَينِ مُنحَدِرٌ سِجاما",57,"م",2,0],["أراعك إِذ قال الجهول بأمرنا","أمامهم بحر كثير المتالف",58,"ف",1,0],["أراع في يقظتي كالنوم بينهما","بالطول والطول يا طوبى لو اعتدلا",59,"ل",2,0],["اراعك من شيبي سنا البرق في الدجى","فما لشبابي لم ترعك غياهبه",60,"ب",2,0],["أراع وقد عرفتم صدق ودي","ومثلي حين يبلى لا يراع",61,"ع",1,0],["أراعي النبت من أَبِّ وَحَبِّ","وَأشْهد فِي الْوُجُود جمال حِبٍّ",62,"ب",1,1],["أُراعُ بما لا يُراعُ الوليدُ","وَيَحسَبُني من يَرانى جَليدَا",63,"د",2,1],["أَراعَكَ بِالبَينِ الخَليطُ المُهَجِّرُ","وَلَم يَكُ عَن بَينِ الأَحِبَّةِ عُنصُرُ",64,"ر",1,1],["أراعي الساهرات بلا هجوع","مدام