{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[75,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[42,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[141,"أرسلي بالسلام يا سلم إني","https://www.aldiwan.net/poem67992.html","الخفيف"],[276,"من لنفس ثناها","https://www.aldiwan.net/poem52122.html","مجزوء الرمل"],[305,"بان الشباب وأفنى ضعفه العمر","https://www.aldiwan.net/poem45484.html","البسيط"],[385,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133784","الرمل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121052","الرمل"],[1758,"","https://poetry.dctabudhabi.ae/diwan/poem/98062","المتقارب"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109283","الرمل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104969","الرمل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102719","المواليا"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121142","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58320","الرجز"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144065","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123526","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81276","الخفيف"],[4767,"بحور القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179966",""],[4767,"استجارة","https://www.poetsgate.com/ViewPoem.aspx?id=184946",""],[4927,"غزلان العراق","https://www.poetsgate.com/ViewPoem.aspx?id=4574",""],[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""]],"verses":[["مَن لَنا عِندَهُ مِنَ الخَيرِ آيا","تٌ ثَلاثٌ في كُلِّهِنَّ القَضاءُ",0,"ا",2,0],["مَن لَنا فيكَ بِعَيبٍ واحِدٍ","تُحذَرُ العَينُ إِذا الفَضلُ كَمُل",1,"ل",1,0],["مَن لِنِضوٍ يَتَنَزّى أَلَما","بَرَّحَ الشَوقَ بِهِ في الغَلَسِ",2,"س",1,1],["مَن لِنَفسٍ عَنِ الهَوى لا تَناهى","لا تُبالي أَطاعَها أَم عَصاها",3,"ا",3,1],["مَنْ لَنَا أَن نرَى تَحَقُقَ حُلمٍ","لَيْسَ بابْن الْكَرَى بَل ابْنِ السُّهَادِ",4,"د",1,0],["مَن لِنَفسٍ تَتوقُ أَنتِ هَواها","وَفُؤادٍ يَكادُ فيكِ يَطيرُ",5,"ر",1,0],["من لنفس ثَناها","بعدَها عَن بَناها",6,"ا",3,1],["مَن لِنواعِجِ تَنزو في أَزِمَّتِها","أَم لِتَنائي حُمولُ الحَيِّ قَد بَكَروا",7,"ر",3,0],["مَن لِنَفسٍ طالَ في الحُب عَناها","لَم يَدَع مِنها الهَوى إِلّا دِماها",8,"ا",3,1],["من لنفسي من هوى نف","سي وراء المستحيل",9,"ل",1,0],["من لنفسٍ زاد في الحب عناها","لم يدع منها الهوى إلا ذماها",10,"ا",3,1],["مَن لنفسٍ عادها أحزانها","وَلعينٍ شفّها طول السهَد",11,"د",1,1],["من لنا بالقتال والضرب بالسي","ف وحرب العدى وسفك دماها",12,"ا",3,0],["من لنائي الدار قد جار على","صبره الدهر فولّى وانطوى",13,"ا",1,0],["من لنا بعدك يا خير كفيل","إن حدا الحادي ونادى بالرحيل",14,"ل",1,0],["من لنا في المغوبة من تحمل بالأثقال","نحن يا غيد وأرسلنه مدامعكنّ إرسال",15,"ل",1,0],["من لنشر الصحف الغ","رّا ومن يوضح قصا",16,"ص",2,0],["منلنا بعدك يحيى","باذلا للدين جهدا",16,"د",2,0],["مَنْ لنا بعدَ ذلكَ الشيخِ خِدْنٌ","وسميرٌ ومؤنسٌ وَجَليس",17,"س",1,0],["مَن لنَجِيّ الفِكَرِ","مَن لحليفِ السّهَرِ",18,"ر",1,1],["من لنا ان رددت أو من نرجى","أو لمن نلتجى اذ الكرب جالا",19,"ل",2,0],["مِن لِنواحة الدُجى بِأَخ يَم","لي عَلَيها الشجي مِن إِيحائه",20,"ا",3,1],["مَن لنا مثلُ قالعٍ بابَ حصنٍ","بعدما العزمُ كسَّر الأقفالا",21,"ل",2,0],["من لنا منقذٌ رحيمٌ كطه","يبسط العدل فوق نجدٍ وقاع",22,"ع",1,0],["مِنْ لَنْدُنَ الدَّهْيَاْءِº أَوْ وَاْشُنْطُنٍ","بِالسِّرِّ حَيْثُ تُدَجَّنُ الأَقْطَاْبُ",23,"ب",1,0],["من لنائي الدار عن سكنه","هائما يشتد في شطنه",24,"ن",2,1]]}