s://www.aldiwan.net/poem42731.html","الكامل"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[89,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[89,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[85,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[56,"احل وامرر معا ولن تارة واخشن","https://www.aldiwan.net/poem58528.html","البسيط"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[28,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[49,"قل لليل والنهار اكتراثي","https://www.aldiwan.net/poem62019.html","الخفيف"],[49,"نادت بوشك رحيلك الأيام","https://www.aldiwan.net/poem63112.html","الكامل"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[31,"يا صاح قل للربع هل يتكلم","https://www.aldiwan.net/poem41808.html","الكامل"],[48,"أله بالبيض الملاح","https://www.aldiwan.net/poem62510.html","مجزوء الرمل"],[48,"صاحب الحب صابرا لا يصدن","https://www.aldiwan.net/poem64321.html","الخفيف"],[48,"ذهب المح وأبقى الدهر","https://www.aldiwan.net/poem64365.html","مجزوء الرمل"],[48,"في حر أم الدهر أيضا","https://www.aldiwan.net/poem66224.html","مجزوء الرمل"],[50,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39564","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42711","الخفيف"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["فَلَعَلَّنا نَمتاحُ إِن لَم نَغتَرِف","ماءَ المُنى وَنُعَلُّ إِن لَم نُنهَلِ",0,"ل",1,0],["فَلَعَلَّنا وَلَعَلَّ مُطمِعَةً","يَوماً بِقُربِكَ مِنهُ نَنتَصِفُ",1,"ف",1,0],["فَلَعَلّي أَلقى المُنى أَو خِلاجاً","مِن حِمامٍ قَضى عَلِيَّ وَأَمضى",2,"ض",2,0],["فَلَعَمري إِنّي لَأَدفِنُ أَسرا","رَكِ عِندي في حُفرَةِ الكِتمانِ",3,"ن",1,0],["فَلَعَمري لَئِن وَصَلتِ أَبا الفَض","لِ لتَستَخلِصِنَّ صَبّاً وَصولا",4,"ل",2,0],["فَلَعَمري لَقَد عَلِمتُ الَّتي كا","نَت أَشارَت عَلَيكُمُ بِاِعتِزالي",5,"ي",1,0],["فَلَعَلَّ يَوماً حَضَرتَ بِمَجلِسٍ","كُنتَ الرَئيسَ وَفَخرَ ذاكَ المَجلِسِ",6,"س",1,0],["فَلَعَمرُ جَدِّكَ لَو رَأَيتَ مَقامَنا","لَرَأَيتَ مِنّا مَنظَراً وَمُؤَيَّدا",7,"د",2,0],["فَلَعَمرُ مَن جَعَلَ الشُهورَ عَلامَةً","قَدَراً فَبَيِّنَ نِصفَها وَهِلالَها",8,"ل",3,0],["فَلَعَلَّ مَن ضَنَّت يَدا","هُ عَلى الكِنانَةِ بِالسُرورِ",9,"ر",1,0],["فَلَعنَةُ اللَهِ عَلى حافِظٍ","إِن لَم يَكُن بِالشاعِرِ الماهِرِ",10,"ر",1,0],["فَلَعَلَّ نَفسي أَن يُنَفَّسَ ساعَةً","عَنها بِتَقبيلِ المُقَبِّلِ فاكِ",11,"ك",1,0],["فلعل خيراً من مقام طيةٌ","تنجي من الدهر الخئون الجائر",12,"ر",1,0],["فَلِعَيْنِهِ وَلِسَمْعِهِ وَلِقَلْبِهِ","وَلِجِسْمِهِ فِيهَا فُنُونُ وَلائِمِ",13,"م",1,0],["فلعين الحليم فيه بكاء","ولثغر السفيه فيه ابتسام",14,"م",1,0],["فلعلَّ الدهر منهم","بدم يغسل عاره",15,"ر",2,0],["فلعل السكرَ يكفي","ني أذى هذا العُواءِ",16,"ا",2,0],["فلعنة اللَّهِ على إخائِهِ","وأَدْخَلَ الأجردَ في وَجْعَائِهِ",17,"ا",3,0],["فلعمري ما حاتمٌ بمُدانٍ","لك لولا الشَّنارُ والتهتيكُ",18,"ك",1,0],["فلعمْرِي لما أُتيتَ من الما","ءِ ولكن من السِّقاءِ الهزيم",19,"م",1,0],["فلَعمرِي لما أظلَّكَ إلا","مُخبِتُ الجهرِ مخلصُ المكنون",20,"ن",1,0],["فلَعَمْرِي لأخفينَّك جهدي","عن عياني وعن عيان العيون",21,"ن",1,0],["فَلَعَلَّ غَيرَكَ إِن رَآكَ مُرَنَّماً","طَرَحَ الكَآبَةَ جانِباً وَتَرَنَّما",22,"م",2,0],["فَلَعَمري يُريبُني","فَرطُ هَذا التَسَنُّنِ",23,"ن",1,0],["فَلَعَلَّ طَيفاً مِنهُ زارَ فَرَدَّهُ","سَهَري فَعادَ بِغَيظِهِ فَتَقَوَّلا",24,"ل",2,0],["فلَعَلَّ قَلْبَ اللَّيل","أَرْحَمُ بالقُلُوبِ البَاكيهْ",25,"ه",1,0],["فلعمت ذوب القلب ثم سكبته","على جدث فيهِ حبيبي غائب",26,"ب",1,0],["فلعلّ الطفل الذي مات منهم","مات عقل بموته ودهاء",27,"ا",2,0],["فلعل بعض الهم يخلف بعضه","فأرى بذلك راحة لفؤادي",28,"ي",1,0],["فَلَعَلَّ مِصراً مِن شَبابِكَ تَرتَدي","مَجداً تَتيهُ بِهِ عَلى البُلدانِ",29,"ن",1,0],["فَلَعَلَّ سُلطانَ المُدامَةِ مُخرِجي","مِن عالَمٍ لَم يَحوِ غَيرَ نِفاقِ",30,"ق",1,0],["فَلَعَمْرِي لَلْمَوْتُ أَزْيَنُ للحُرِّ","مِنَ الذلِ ضارعاً للرِّجالِ",31,"ل",1,0],["فلعلَّ شملَ الوصلِ يُجمعُ بعدَما","أصبحتُ في بُرْدِ النَّوى متفتّلا",32,"ل",2,0],["فَلَعَلَّني أَلقى الرَدى فَيُريحُني","عَمّا قَليلٍ مِن جَوى البُرَحاءِ",33,"ا",2,0],["فَلَعَلَّ باهِلَةَ بنَ يَعصُرَ مِثلُنا","حَيثُ اِلتَقى بِمِنىً مُناخُ الأَركُبِ",34,"ب",1,0],["فَلَعَمري لَرُبَّ يَومِ قُنوطٍ","قَد أَتى اللَهُ بَعدَهُ بِالغِياثِ",35,"ث",1,0],["فَلِعِبرَةٍ أُخِّرتَ لِلزَمَنِ الَّذي","هَلَكَ الأَرامِلُ فيهِ وَالأَيتامُ",36,"م",1,0],["فَلَعَمري لَقَد عَهِدتُ إِلى الدَم","عِ لِيُغنيهِ عَن دُموعِ العِهادِ",37,"د",1,0],["فَلَعَلّي ببقايا عُمُري","منه أقضي البعضَ من حقٍّ وَجبْ",38,"ب",1,0],["فَلَعَلَّ عَبرَةَ ساعَةٍ أَذرَيتَها","تَشفيكَ مِن إِربابِ وَجدٍ مُحوِلِ",39,"ل",1,0],["فَلَعَلَّ عَينَكَ أَن تُعينَ بِمائِها","وَالدَمعُ مِنهُ خاذِلٌ وَمُواسِ",40,"س",1,0],["فَلَعَلَّ غِبَّ اللَيلِ يَستُرُ مَجلِساً","فيهِ يُوَدَّعُ عاشِقٌ وَيُسَلَّمُ",41,"م",1,0],["فَلَعَمري ما يُداوى ال","هَمُّ بِالماءِ القَراحِ",42,"ح",1,0],["فَلَعَلَّ الزَمانَ يُدنيكَ مِنهُ","إِنَّ خَطبَ الهَوى جَليلٌ نَفيسُ",43,"س",1,0],["فَلَعَلَّ اللَهَ أَن يَف","جُرَ لِلمَعروفِ حَوضا",44,"ض",2,0],["فلعلّ اللَه أن يج","عَلَ للمعروفِ حوضا",45,"ض",2,0],["فَلَعَلَّ القَلبَ يَصحو","وَيُواتيني لَعيبي",46,"ي",1,0],["فلَعَلّ نارَ جوانحي بهُبُوبِها","أن تنطَفي وأوَدّ أن لا تنطَفي",47,"ي",1,0],["فلعلَّ من لمحات ثغرك بارقٌ","ولعلَّه وضحُ الجبينِ الناضرِ",48,"ر",1,0],["فَلَعَلِّي أَفُوزُ يَوْماً بِوَصْلٍ","أَتَوَلَّى بِهِ إِمَارَةَ عِشْقِ",49,"ق",1,0],["فلعل أنفسهم بِهَدْبك تهتدي","فتروجَ سوقُ الروح بعد كساد",50,"د",1,0],["فلعلَّ ذا ، ولعَّلها لُغةٌ","من غيرِ ما جرْسٍ نعوَّده",51,"د",2,0],["فَلَعَمْرِي لأَقْتُلَنَ بِكُلَيْبٍ","كلَّ قيلٍ يسمى منَ الأقيالِ",52,"ل",1,0]]}