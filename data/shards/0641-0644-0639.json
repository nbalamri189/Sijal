نه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[444,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[454,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[460,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[463,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[479,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[517,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[540,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[560,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[569,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[645,"","https://poetry.dctabudhabi.ae/diwan/poem/145934","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/45552","الكامل"],[1098,"","https://poetry.dctabudhabi.ae/diwan/poem/20927",""]],"verses":[["فَلَعَلَّنا نَمتاحُ إِن لَم نَغتَرِف","ماءَ المُنى وَنُعَلُّ إِن لَم نُنهَلِ",0,"ل",1,0],["فَلَعَلَّنا وَلَعَلَّ مُطمِعَةً","يَوماً بِقُربِكَ مِنهُ نَنتَصِفُ",1,"ف",1,0],["فَلَعَلّي أَلقى المُنى أَو خِلاجاً","مِن حِمامٍ قَضى عَلِيَّ وَأَمضى",2,"ض",2,0],["فَلَعَمري إِنّي لَأَدفِنُ أَسرا","رَكِ عِندي في حُفرَةِ الكِتمانِ",3,"ن",1,0],["فَلَعَمري لَئِن وَصَلتِ أَبا الفَض","لِ لتَستَخلِصِنَّ صَبّاً وَصولا",4,"ل",2,0],["فَلَعَمري لَقَد عَلِمتُ الَّتي كا","نَت أَشارَت عَلَيكُمُ بِاِعتِزالي",5,"ي",1,0],["فَلَعَلَّ يَوماً حَضَرتَ بِمَجلِسٍ","كُنتَ الرَئيسَ وَفَخرَ ذاكَ المَجلِسِ",6,"س",1,0],["فَلَعَمرُ جَدِّكَ لَو رَأَيتَ مَقامَنا","لَرَأَيتَ مِنّا مَنظَراً وَمُؤَيَّدا",7,"د",2,0],["فَلَعَمرُ مَن جَعَلَ الشُهورَ عَلامَةً","قَدَراً فَبَيِّنَ نِصفَها وَهِلالَها",8,"ل",3,0],["فَلَعَلَّ مَن ضَنَّت يَدا","هُ عَلى الكِنانَةِ بِالسُرورِ",9,"ر",1,0],["فَلَعنَةُ اللَهِ عَلى حافِظٍ","إِن لَم يَكُن بِالشاعِرِ الماهِرِ",10,"ر",1,0],["فَلَعَلَّ نَفسي أَن يُنَفَّسَ ساعَةً","عَنها بِتَقبيلِ المُقَبِّلِ فاكِ",11,"ك",1,0],["فلعل خيراً من مقام طيةٌ","تنجي من الدهر الخئون الجائر",12,"ر",1,0],["فَلِعَيْنِهِ وَلِسَمْعِهِ وَلِقَلْبِهِ","وَلِجِسْمِهِ فِيهَا فُنُونُ وَلائِمِ",13,"م",1,0],["فلعين الحليم فيه بكاء","ولثغر السفيه فيه ابتسام",14,"م",1,0],["فلعلَّ الدهر منهم","بدم يغسل عاره",15,"ر",2,0],["فلعل السكرَ يكفي","ني أذى هذا العُواءِ",16,"ا",2,0],["فلعنة اللَّهِ على إخائِهِ","وأَدْخَلَ الأجردَ في وَجْعَائِهِ",17,"ا",3,0],["فلعمري ما حاتمٌ بمُدانٍ","لك لولا الشَّنارُ والتهتيكُ",18,"ك",1,0],["فلعمْرِي لما أُتيتَ من الما","ءِ ولكن من السِّقاءِ الهزيم",19,"م",1,0],["فلَعمرِي لما أظلَّكَ إلا","مُخبِتُ الجهرِ مخلصُ المكنون",20,"ن",1,0],["فلَعَمْرِي لأخفينَّك جهدي","عن عياني وعن عيان العيون",21,"ن",1,0],["فَلَعَلَّ غَيرَكَ إِن رَآكَ مُرَنَّماً","طَرَحَ الكَآبَةَ جانِباً وَتَرَنَّما",22,"م",2,0],["فَلَعَمري يُريبُني","فَرطُ هَذا التَسَنُّنِ",23,"ن",1,0],["فَلَعَلَّ طَيفاً مِنهُ زارَ فَرَدَّهُ","سَهَري فَعادَ بِغَيظِهِ فَتَقَوَّلا",24,"ل",2,0],["فلَعَلَّ قَلْبَ اللَّيل","أَرْحَمُ بالقُلُوبِ البَاكيهْ",25,"ه",1,0],["فلعمت ذوب القلب ثم سكبته","على جدث فيهِ حبيبي غائب",26,"ب",1,0],["فلعلّ الطفل الذي مات منهم","مات عقل بموته ودهاء",27,"ا",2,0],["فلعل بعض الهم يخلف بعضه","فأرى بذلك راحة لفؤادي",28,"د",2,0],["فَلَعَلَّ مِصراً مِن شَبابِكَ تَرتَدي","مَجداً تَتيهُ بِهِ عَلى البُلدانِ",29,"ن",1,0],["فَلَعَلَّ سُلطانَ المُدامَةِ مُخرِجي","مِن عالَمٍ لَم يَحوِ غَيرَ نِفاقِ",30,"ق",1,0],["فَلَعَمْرِي لَلْمَوْتُ أَزْيَنُ للحُرِّ","مِنَ الذلِ ضارعاً للرِّجالِ",31,"ل",1,0],["فلعلَّ شملَ الوصلِ يُجمعُ بعدَما","أصبحتُ في بُرْدِ النَّوى متفتّلا",32,"ل",2,0],["فَلَعَلَّني أَلقى الرَدى فَيُريحُني","عَمّا قَليلٍ مِن جَوى البُرَحاءِ",33,"ا",2,0],["فَلَعَلَّ باهِلَةَ بنَ يَعصُرَ مِثلُنا","حَيثُ اِلتَقى بِمِنىً مُناخُ الأَركُبِ",34,"ب",1,0],["فَلَعَمري لَرُبَّ يَومِ قُنوطٍ","قَد أَتى اللَهُ بَعدَهُ بِالغِياثِ",35,"ث",1,0],["فَلِعِبرَةٍ أُخِّرتَ لِلزَمَنِ الَّذي","هَلَكَ الأَرامِلُ فيهِ وَالأَيتامُ",36,"م",1,0],["فَلَعَمري لَقَد عَهِدتُ إِلى الدَم","عِ لِيُغنيهِ عَن دُموعِ العِهادِ",37,"د",1,0],["فَلَعَمري لَأَقتُلَنَّ بِكُلَيبٍ","كُلَّ قَيلٍ يُسَمّى مِنَ الأَقيالِ",38,"ل",1,0],["فَلَعَلّي ببقايا عُمُري","منه أقضي البعضَ من حقٍّ وَجبْ",39,"ب",1,0],["فَلَعَلَّ عَبرَةَ ساعَةٍ أَذرَيتَها","تَشفيكَ مِن إِربابِ وَجدٍ مُحوِلِ",40,"ل",1,0],["فَلَعَلَّ عَينَكَ أَن تُعينَ بِمائِها","وَالدَمعُ مِنهُ خاذِلٌ وَمُواسِ",41,"س",1,0],["فَلَعَلَّ غِبَّ اللَيلِ يَستُرُ مَجلِساً","فيهِ يُوَدَّعُ عاشِقٌ وَيُسَلَّمُ",42,"م",1,0],["فَلَعَمري ما يُداوى ال","هَمُّ بِالماءِ القَراحِ",43,"ح",1,0],["فَلَعَلَّ الزَمانَ يُدنيكَ مِنهُ","إِنَّ خَطبَ الهَوى جَليلٌ نَفيسُ",44,"س",1,0],["فَلَعَلَّ اللَهَ أَن يَف","جُرَ لِلمَعروفِ حَوضا",45,"ض",2,0],["فلعلّ اللَه أن يج","عَلَ للمعروفِ حوضا",46,"ض",2,0],["فَلَعَلَّ القَلبَ يَصحو","وَيُواتيني لَعيبي",47,"ب",2,0],["فلَعَلّ نارَ جوانحي بهُبُوبِها","أن تنطَفي وأوَدّ أن لا تنطَفي",48,"ف",2,0],["فلعلَّ من لمحات ثغرك بارقٌ","ولعلَّه وضحُ الجبينِ الناضرِ",49,"ر",1,0],["فَلَعَلِّي أَفُوزُ يَوْماً بِوَصْلٍ","أَتَوَلَّى بِهِ إِمَارَةَ عِشْقِ",50,"ق",1,0],["فلعل أنفسهم بِهَدْبك تهتدي","فتروجَ سوقُ الروح بعد كساد",51,"د",1,0],["فلعلَّ ذا ، ولعَّلها لُغةٌ","من غيرِ ما جرْسٍ نعوَّده",52,"د",2,0],["فَلَعَلي مِنها أَتيت بِنذر","وَقُصوري بِالعَفو مِنكَ اِستَجارا",53,"ر",2,0],["فَلعل لَحظي يَلتَقي","وَهناً وَلَحظك في السَما",54,"م",2,0],["فَلَعَلَ الرَحيم يَأذن يَوماً","بِانتِفاذي مِن لجة التَيار",55,"ر",1,0],["فلعي عن مغلقات المعاني","خبطت في اوهامها الاقوام",56,"م",1,0],["فلعيني البكا عليك وقلبي","قالب الحزن حيطة الخفقان",57,"ن",1,0],["فلعل الزمان ينجز وعداً","منه أن الزمان كان قمينا",58,"ن",2,0],["فلعل إلهامي القديم يعودني","ويحفني في وحشتي بحنانه",59,"ن",2,0],["فلعلّه يأتي مفا","جأةً فكن متزوِّدَا",60,"د",2,0],["فلعلِّي أشفى الغليلَ من الشوق","بلثمى أثافياً وصعيدَا",61,"د",2,0],["فلعلى أَفوزُ يوما بلقيا","هُ وتُحيى حَشاشتي نغماتُه",62,"ت",2,0],["فلعلَّ ربِّ العرش يق","بَلُ توبة العدلِ المواظبْ",63,"ب",1,0],["فلعلَّ تحت الحُسن قُبح طبائع","تَسقيك سُمَّا ناقِعاً بالماءِ",64,"ا",2,0],["فَلَعَلَّ دِجلَةَ أَن تَوَسَّطَ مُلكَ مَن","حَفَّ الفُراتَ بِمُلكِهِ وَالنيلُ",65,"ل",1,0],["فَلَعنَةُ الرَحمَنُ تَغشى عُصبَةً","غَزَتهُمُ وَعُصبَةً لَم تدفَعِ",66,"ع",1,0],["فلِعَبْدِ عبدِكَ فيهمُ","فَخْرُ الأسودِ على الثعالب",67,"ب",1,0],["فلعنةُ اللهِ على عالمٍ","أو جاهلٍ يدخُلها مَرَّتين",68,"ن",1,0],["فلعل يومك منه آخر ما","يوليك من حسن وما تدري",69,"ر",2,0],["فلعلّ ليلاهُ تريشُ جناحَهُ","ما كان أشوَقهُ لتلكَ الأربُعِ",70,"ع",1,0],["فلعمري كان الخوانُ ولكن","لم يكن ما يكون فوق الخوانِ",71,"ن",1,0],["فلعل صبح نداك تشرق شمسه","يوما عليّ فليل فقري قد دجا",72,"ج",2,0],["فلعل صبح نداح تشرق شمسه","وارى ظلام الفقر ولى وانجلى",73,"ل",2,0],["فلعبده هذا اذا صحنته","وتراه في تصحيف ذا يتحتم",74,"م",1,0],["فلعنةُ اللهِ غيرُ مقلِعةٍ","تَتْرى على أَغْدَرِ الفرِيقين",75,"ن",1,0],["فلعلّه يوماً يعود بعَطْفِهِ","يُحيي حُشاشات العطاشِ الجُوَّعِ",76,"ع",1,0],["فَلَعَلَّ اللَهَ أَن يَر","زُقَها بَختَ القِباحِ",77,"ح",1,0],["فلعلَّ نضراً منكِ يُنضرُ قلبهُ","فلطالما عَصفَت رياحُ شقائه",78,"ا",3,0],["فلعلَّ عدلاً في الهوى أو رحمةً","لمتيَّمٍ متظلِّمٍ مُتشفِّع",79,"ع",1,0],["فلعلَّ ترجيعَ النواحِ وراءَه","هُوجُ الرياحِ وبَعدها الإرعاد",80,"د",1,0],["فَلَعَل الدموع تطفىء نارا","من فؤاد صبا وَتشفي غَليلا",81,"ل",2,0],["فلعل عَلْيَاكمْ تُسامح راجياً","إصْغاءها ومُؤمّلاً إغضاءَها",82,"ا",3,0],["فَلَعَلَّ بُرجَ السورِ يَثني قَرنَهُ","عَن نَطحِ بُرجِ الثَورِ فَهوَ عَلى وَجَل",83,"ل",1,0],["فلعله يحنو على المضنى","ويسعفُ بالوصال",84,"ل",1,0],["فَلَعَلَّني خَيراً رَأضيتُ وَلَم يَكُن","هَذا المَنامُ كَما أُري في اليَقظَةِ",85,"ه",1,0],["فَلِعَينَيَّ كُلَّ يَومٍ دُموعٌ","إِنَّما تَستَدِرُّها عَيناها",86,"ا",3,0],["فَلَعَلَّ بُطْأَكُما يُفَرِّطُ سَيّئاً","أَوْ يَسْبِقُ الإِسْراعُ سَيْباً مُقْبِلا",87,"ل",2,0],["فلعلَّ القبورَ تَندى إذا كا","نَ الندى عندَ أهلِهِ في القُبورِ",88,"ر",1,0],["فلُعابُ الشموس للعين نورٌ","وهو في منظر العيون ضَباب",89,"ب",1,0],["فَلَعَلَني أَرتاح مِن","أَلَم البَلابل وَالغَرام",90,"م",1,0],["فَلَعَلي أَرتاح إِن غِبت عَني","رَيثَما يَنفضي النَوى المَقدورُ",91,"ر",1,0],["فَلَعَلَ مَن أَهواهُ يَس","محُ لي بِطَيف زائر",92,"ر",1,0],["فلعمري ما قد رأيت نجيباً","من نجيب من عصبته ملكيه",93,"ي",2,0],["فلعلَّ بعضَ العُمرِ وهو أَقَلُّهُ","ألاّ يُكدِّرَ بالهُمومِ ويُمذَقُ",94,"ق",1,0],["فلعلَّ الله أن يعْمُرَها","بك والله بما شاء قدير",95,"ر",1,0],["فلعلّ راحتَه السحا","بُ وأنت من بعضِ الرياحِ",96,"ح",1,0],["فلَعَلَّ غاياتِ الدُّجى أَن تَنْتَهِي","وعَسى غياباتُ الأَسى أَن تَنْجَلِي",97,"ل",2,0],["فلعل زادك للنوى أهبته","أو لم فأهب لا تكن بالناسي",98,"س",2,0],["فلعلني لم أعط يو","ماً بالشمال كتابيه",99,"ي",2,0],["فلعلني أتأهب ال","حسنى لوقع مماتيه",99,"ي",2,0],["فلعمري أشهى القريض إِلى النف","س ولوعٌ بذكر عيشِ مِثاِله",100,"ل",2,0],["فلعمري السرور أقصر من أن","يتمادى في وزنه واكتياله",100,"ل",2,0],["فلعلَّ يُمنَك أن يغادرني بها","بعد الأسى مستبشرا جذلانا",101,"ن",2,0],["فلِعِرْضه هو بالشَّراسة مانعٌ","ولمالهِ هو بالبشاشةِ باذلُ",102,"ل",1,0],["فلعلَّه يسري اليَّ بموعدٍ","اِنْ نمتُ اِمّا صادقاً أو كاذبا",103,"ب",2,0],["فلعل العيان يشفي نفوساً","نغلت من همومهن الصدور",104,"ر",1,0],["فَلِعيدِه في كُلِّ عامٍ جِدَّةٍ","بل جِدَّةٌ بوُجودِه لِلعامِ",105,"م",1,0],["فلعلّي منه ألقى قبساً","أو يرى قلبي على النار هدى",106,"د",2,0],["فَلَعَمْرِي لَئِنْ رَمَتْكَ اللَّيَالِي","بِنَؤًى أَزْعَجَتْكَ عَنْ أَوْطَانِكْ",107,"ك",1,0],["فلعن الله جميع من لبث","عن بعثه ممن إليه قد بعث",108,"ث",1,0],["فلعمرُ الحبيبِ إِنَّ حبيبَ النَّفْسِ","أَشْهى للنَّفْسِ مِنْ أُمِّ عَمْرِو",109,"ر",2,0],["فلعنَةُ الله على شاعرٍ","يقصد ربعاً ليس فيه كلا",110,"ل",2,0],["فَلَعَلَّ ما أُدعى لِما أَنا فاعِلٌ","وَلِمَ الحَياةُ إِذا اِمرُؤٌ لَم يَفعَلِ",111,"ل",1,0],["فلعلي أن يكثر المال عندي","ويخني من المغارم ظهري",112,"ر",2,0]]}