0],["فَلَعَلَّ نَفسي أَن يُنَفَّسَ ساعَةً","عَنها بِتَقبيلِ المُقَبِّلِ فاكِ",11,"ك",1,0],["فلعل خيراً من مقام طيةٌ","تنجي من الدهر الخئون الجائر",12,"ر",1,0],["فَلِعَيْنِهِ وَلِسَمْعِهِ وَلِقَلْبِهِ","وَلِجِسْمِهِ فِيهَا فُنُونُ وَلائِمِ",13,"م",1,0],["فلعين الحليم فيه بكاء","ولثغر السفيه فيه ابتسام",14,"م",1,0],["فلعلَّ الدهر منهم","بدم يغسل عاره",15,"ر",2,0],["فلعل السكرَ يكفي","ني أذى هذا العُواءِ",16,"ا",2,0],["فلعنة اللَّهِ على إخائِهِ","وأَدْخَلَ الأجردَ في وَجْعَائِهِ",17,"ا",3,0],["فلعمري ما حاتمٌ بمُدانٍ","لك لولا الشَّنارُ والتهتيكُ",18,"ك",1,0],["فلعمْرِي لما أُتيتَ من الما","ءِ ولكن من السِّقاءِ الهزيم",19,"م",1,0],["فلَعمرِي لما أظلَّكَ إلا","مُخبِتُ الجهرِ مخلصُ المكنون",20,"ن",1,0],["فلَعَمْرِي لأخفينَّك جهدي","عن عياني وعن عيان العيون",21,"ن",1,0],["فَلَعَلَّ غَيرَكَ إِن رَآكَ مُرَنَّماً","طَرَحَ الكَآبَةَ جانِباً وَتَرَنَّما",22,"م",2,0],["فَلَعَمري يُريبُني","فَرطُ هَذا التَسَنُّنِ",23,"ن",1,0],["فَلَعَلَّ طَيفاً مِنهُ زارَ فَرَدَّهُ","سَهَري فَعادَ بِغَيظِهِ فَتَقَوَّلا",24,"ل",2,0],["فلَعَلَّ قَلْبَ اللَّيل","أَرْحَمُ بالقُلُوبِ البَاكيهْ",25,"ه",1,0],["فلعمت ذوب القلب ثم سكبته","على جدث فيهِ حبيبي غائب",26,"ب",1,0],["فلعلّ الطفل الذي مات منهم","مات عقل بموته ودهاء",27,"ا",2,0],["فلعل بعض الهم يخلف بعضه","فأرى بذلك راحة لفؤادي",28,"د",2,0],["فَلَعَلَّ مِصراً مِن شَبابِكَ تَرتَدي","مَجداً تَتيهُ بِهِ عَلى البُلدانِ",29,"ن",1,0],["فَلَعَلَّ سُلطانَ المُدامَةِ مُخرِجي","مِن عالَمٍ لَم يَحوِ غَيرَ نِفاقِ",30,"ق",1,0],["فَلَعَمْرِي لَلْمَوْتُ أَزْيَنُ للحُرِّ","مِنَ الذلِ ضارعاً للرِّجالِ",31,"ل",1,0],["فلعلَّ شملَ الوصلِ يُجمعُ بعدَما","أصبحتُ في بُرْدِ النَّوى متفتّلا",32,"ل",2,0],["فَلَعَلَّني أَلقى الرَدى فَيُريحُني","عَمّا قَليلٍ مِن جَوى البُرَحاءِ",33,"ا",2,0],["فَلَعَلَّ باهِلَةَ بنَ يَعصُرَ مِثلُنا","حَيثُ اِلتَقى بِمِنىً مُناخُ الأَركُبِ",34,"ب",1,0],["فَلَعَمري لَرُبَّ يَومِ قُنوطٍ","قَد أَتى اللَهُ بَعدَهُ بِالغِياثِ",35,"ث",1,0],["فَلِعِبرَةٍ أُخِّرتَ لِلزَمَنِ الَّذي","هَلَكَ الأَرامِلُ فيهِ وَالأَيتامُ",36,"م",1,0],["فَلَعَمري لَقَد عَ