.ae/diwan/poem/52154","المقتضب"],[4755,"إِنَّهَا فِتنَةُ الفِتَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=195210",""],[4859,"كل أنثى حين تشدو شاعرة!","https://www.poetsgate.com/ViewPoem.aspx?id=191086",""],[5038,"شجو الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=188661",""],[5084,"قم يانديبي على حمراً","https://www.poetsgate.com/ViewPoem.aspx?id=177783",""],[5084,"يا راكب ٍ حمراء","https://www.poetsgate.com/ViewPoem.aspx?id=177781",""],[5183,"قسوة الأم غصه","https://www.poetsgate.com/ViewPoem.aspx?id=186495",""],[5183,"الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=186490",""],[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""],[5232,"كنار الشام","https://www.poetsgate.com/ViewPoem.aspx?id=212657",""],[5323,"اجفُ من يجفو","https://www.poetsgate.com/ViewPoem.aspx?id=207408",""],[5434,"لاتجربونه","https://www.poetsgate.com/ViewPoem.aspx?id=37614",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5452,"ستائر الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=112027",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[5564,"ياللْه يا كافي الأمور الشدايد","https://www.poetsgate.com/ViewPoem.aspx?id=186845",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5725,"قل لهند","https://www.poetsgate.com/ViewPoem.aspx?id=195182",""],[5732,"حي جرح قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177917",""],[5790,"إن هداني في ليل عنبر خاله","https://www.poetsgate.com/ViewPoem.aspx?id=112124",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[5956,"الحب الجسدي","https://www.poetsgate.com/ViewPoem.aspx?id=182495",""],[5970,"قل لسار في مضلات الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=130602",""],[6031,"حَسَّنَتْ غَيَّهُ لَهُ وفَسَادَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=46340",""],[6084,"خاب ظني وقل مني رجائي","https://www.poetsgate.com/ViewPoem.aspx?id=170812",""]],"verses":[["قُل لِهَذي الهَوامِلِ اِستَوثَقي لِل","سَيرِ وَاِستَنشَزي عَنِ الأَعطانِ",0,"ن",1,0],["قُل لَهُ هَل تُراكَ تَذكُرُ ما كا","نَ بِبابِ القُبَيبَةِ الحَمراءِ",1,"ا",2,0],["قُل لَها غابَ كَوكَبُ الأَرضِ في الأَر","ضِ فَغيبي عَنِ السَماءِ اِحتِجابا",2,"ب",2,0],["قُل لَهُ كَيفَ زالَ مُلكُكَ لَم يَع","صِمكَ إِعدادُ عُدَّةٍ أَو عَديدِ",3,"د",1,0],["قُل لَهُ كَيفَ كُنتَ كَيفَ اِمتَلَكتَ ال","أَرضَ كَيفَ اِنفَرَدتَ بِالتَمجيدِ",3,"د",1,0],["قُل لَهُ جَلَّ مَن لَهُ المُلكُ لا مُل","كَ لِغَيرِ المُهَيمِنِ المَعبودِ",3,"د",1,0],["قُلْ لَهُ حِينَ تَجْتَلِي وَجْهُهُ","البَسَّامَ وَالسَّعْدُ وَجْهُهُ البَسَّامُ",4,"م",1,0],["قل لهاجيكَ مُطنباً في الهجاءِ","لا تَبِعْ راحةً بطولِ عناءِ",5,"ا",2,1],["قل لهارون قولةً تَهَبُ الأم","نَ لقلبي فإنه مَرْعُوبُ",6,"ب",1,0],["قلْ لَه عني وإن أص","بحتُ أطْرَى وأُكَيَّس",7,"س",1,0],["قلْ له يا مقوّمي وسمِيّي","وكنِيِّي ومَن غدا ليَ شَكْلا",8,"ل",2,0],["قُلْ له عن مؤمّلٍ من بعيدٍ","ديمةً من نَدى يديه وَوَبْلا",9,"ل",2,0],["قُل لهم يُعتبونَنا أيها الحُرْ","رُ ويُولوننا كما نُوليهِمْ",10,"م",1,0],["قُلْ له عني لقد أصْ","بحتَ في جهلكَ أُمَّهْ",11,"م",2,0],["قُل لَهُم إِنّا غَدَونا بَعدَهُم","لا حَديثٌ طَيِّبٌ لا سَمَرُ",12,"ر",1,0],["قل لهم عهدىَ فيكم أمةً","عرفوا الحق وقوما صابرين",13,"ن",1,0],["قل لها يا ابنة المبارك إيه","قد جرت كاسمه أمورك يمنا",14,"ن",2,0],["قل له يا أبا الملوك هل العي","ش وإن طال غير بضع ثوان",15,"ن",1,0],["قُل لَهُم في نَدِيِّهِم","مِصرُ بِالبابِ تَنتَظِر",16,"ر",1,0],["قُل لِهَيكَلٍ كَلِماً","مِن وَرائِها رَشَدُ",17,"د",1,0],["قُل لَها في الدُعاءِ لَو كانَ يُجدي","يا سَماءَ الجِلالِ لا صِرتِ أَرضا",18,"ض",2,0],["قُلْ لهَضِيمِ الكَشْحِ مَيّاسِ","اِنْتَقَضَ العَهْدُ مِنَ النّاسِ",19,"س",1,1],["قلْ لهمْ لوْ يكونُ فيكمْ جوادٌ","كانَ في غُنْيةٍ عنِ المهمازي",20,"ي",1,0],["قُل لِهِندٍ وَتِربِها","قَبلَ شَحطِ النَوى غَدا",21,"د",2,1],["قُل لَهُ ذُق وَلَو عَلِمتَ بِأَمري","لَم تُبَدِّل قَطيعَةً بِتَصابِ",22,"ب",1,0],["قُل لَهُ إِن قالَ هَل تا","بَ نَعَم تابَ وَزادا",23,"د",2,0],["قُل لَها يا فَريرُ إِنّي مِنَ الشَو","قِ إِلَيها وَحِدَّتي في جِهادِ",24,"د",1,0],["قُلْ لها يا عامُ لا هُنتِ ولا","كنتِ إلَّا مهدَ أحرارٍ كرامِ",25,"م",1,0],["قُلْ لها إنَّ الرَّحى دائرةٌ","والليالي بينَ كرٍ وصدامِ",25,"م",1,0],["قل لها .. إنه تأمَّل في دنياه","حيناً فعاد يحضنُ دمعه",26,"ع",2,1],["قل لها .. انّه يفيق على جرح","وتغفو سنينه فوق لوعهْ",26,"ع",2,0],["قل لها .. انه يهيم .. وأخشى","ان تواريه رحلة دون رجعهْ",26,"ع",2,0],["قُلْ لَهُ غَيْرَ فاخِرٍ إنَّ صَبْرِي","بَعْدَ سَامِي هَدَى إِلَيْها السَبِيلاَ",27,"ل",2,0],["قل لهم: إنَّما الخلائقُ -مهما","نَزَحَتْ دورهُم- بنو أعمام",28,"م",1,0],["قلّ لها قبل أن تعضّ يديها","هل غرام الذئاب يحلو لديها ؟",29,"ي",3,1],["قلْ لهم : لَسْتُم رفاقي فانفِروا","إنَّ هذا الشعبَ لا يَبغِى مُحالا!",30,"ل",2,0],["قل لها : أيّها الغمامة جودي","شاطئ الرّافدين أو لا تجودي",31,"د",2,0],["قلْ له يا مقوّمي وسمّي وكنيِّي","ومَن غدا ليَ شَكْلا",32,"ل",2,0],["قُلْ له يقضى ما يشاءُ فإني","أنَا مولاهُ في ملاكِ ولائِه",33,"ا",3,0],["قُل لها عَنّي إذا لاقيتها","قَولَةً تترُكُ صدعاً في الحجر",34,"ر",1,0],["قل له جمع ذا وذا مستحيل","مثل جمع المياه والنيران",35,"ن",1,0],["قُل له دَع سَليمَهُ","وَانج عنه مُسَلَّما",36,"م",2,0],["قلْ لهارونَ قد علاكَ اصفرارٌ","شاهدٌ بالبغاءِ ما فيه بَهْتُ",37,"ت",1,1],["قُل لَهُم أَستَريحُ في قُصرِيَ المَم","لوكِ مِن بُؤسِ بَيتيَ المَأجورِ",38,"ر",1,0],["قُل لَهُم نِمتُ في الحَياةِ عَلى الشَو","كِ مِراراً وَمَرَّةً في سَريري",38,"ر",2,0],["قُل لَهُم تَحطِمونَ في الأَرضِ كَأسي","وَبِمَوتي تُقَدِّسونَ خُموري",38,"ر",2,0],["قُل لَهُ إِنَّ حُبَّهُ في عُروقي","شَبَّ مِنهُ لِعُرسِنا إِكليلُ",39,"ل",1,0],["قُل لَهُ سَوف يَستَحيلُ رَبيعاً","دائِماً ذلِك الهَوى المُستَحيلُ",39,"ل",1,0],["قلْ له مهما توارى","سِرُّ سِرِّي أنْ أراهُ",40,"ا",2,0],["قل لهم أَنتم من السعدا","واشمل الادنين وَالبعدا",41,"د",2,0],["قُل لَها أَهلاً وَسَهلاً بِالَّتي","كَم إِلَينا قَطَعَت سَهلاً وَحَزنا",42,"ن",2,0],["قل له والمقال يكرم من مث","لك في محفل العلا أن يقوله",43,"ل",2,0],["قل لها مات شاعر الحب والم","جد فكم قد أرقت من عبرات",44,"ت",1,0],["قل لها يا كاس","ما جدّ من الدهر علينا",45,"ن",2,0],["قل له إن قدرت ما أنت في الكو","ن سوى ذرّة من الذرّات",46,"ت",1,0],["قل له يا ليل إن نام حبيبي","غافلاً عن ناره في أضلعي",47,"ي",1,0],["قُل لِهارونَ إِن حَلَل","تَ بِهِ قَولَ ذي مِقَه",48,"ق",2,1],["قل لهم قد طفح الكيل وقد","ملّت الأنفس عيشاً وبقاء",49,"ا",2,0],["قلْ لها أبصرتُ في النَّا","سِ كئيباً مُستَهاما",50,"م",2,0],["قُل لَهُ اِنَّ لِلجَمالِ زَكاةً","فَتَصَدَّق بِها عَلى المَهجورِ",51,"ر",1,0],["قُلْ لَهُم باللهِ عنّي إنّني","حافظٌ ميثاقَهم إنْ سألوا",52,"ل",3,0],["قل لهم إن سكنتم في جِنانٍ","فهو في النار في عذاب الفراق",53,"ق",1,0],["قلْ لها وادعُ وأَرِّخ","أَنتِ في الجنَّات رحمه",54,"م",2,0],["قُلْ له أيها الخيالُ الذي يط","رقُ ليلاً والحاسدون هُجودُ",55,"د",1,0],["قل لها أيها الخيالُ الطروقُ","نفَّرَ العشقَ ما جَنَى المعشوقُ",56,"ق",1,1],["قل لهُمُ عن جسدي","إن سألوا وأسعفوا",57,"ف",3,0],["قل له عَنِّيَ حيَّتك العُلا","بوكيفٍ من حَيَا الشكرِ صَبيبِ",58,"ب",1,0],["قل له عني لا أظنك تنسى","ذلك اليوم إذ علاك الزفير",59,"ر",1,0],["قلْ لها يا حِبُّ صِيري","بِيَ برداً وسَلامَا",60,"م",2,0],["قلْ لهذا اللَّيْلِ مهما شئتَ طُلْ","إنَّ عَيني جُبِلَتْ بالأَرَقِ",61,"ق",1,1],["قُل له من قد تَخَلَّى","عَن طرِيقِ الخَير بَاد",62,"د",1,0],["قل لَهم للبيَّازِ عزٌّ وسِرٌّ","وانتِصار مِن مالِكٍ وهَّابِ",63,"ب",1,0],["قل لهم يا سعد مغرمكم","كم يقاسي الدمع والأرقا",64,"ق",2,0],["قل لهم يا سعد ما بي رمق","يا ظباءً للأسود اقتنصوا",65,"ص",3,0],["قل لهم يا أنا يجودوا علينا","باللقا إننا لبالمرصاد",66,"د",1,0],["قل لها إذ تبرجت من حجاب","كان طه المختار قد أرخاه",67,"ا",2,0],["قل له يحتمي الجفاء فما شك","واه إلاّ مما يطيل الجفاءا",68,"ا",2,0],["قُل لهذا الحمامِ إن جَهِلَ الحبِّ","أنا واقفٌ على عرفانِه",69,"ن",2,1],["قل له إِن شممت تربة أَرض","وَطأت نعله ثراها العطيرا",70,"ر",2,0],["قل له عايف معاشي","والما ما ينشرب",71,"ب",1,0],["قل ْله سعيد اللّي من الحب مضعوف","لا ينفعه شربٍ ولا طيب زادي",72,"د",2,0],["قل له لا عداه رأي ولا زال","لديه لكل خير طريق",73,"ق",1,0],["قل له دام ملكه وعليه","من لباس الإقبال برد قشيب",74,"ب",1,0],["قل له أنت نعم ذخراً لصديق","اليوم لكنك الصديق الملول",75,"ل",1,0],["قل له كم تماطل الدين في الكفار","فأحذر أن يغصب الممطول",75,"ل",1,0],["قل لهم إنما الحياة ربيع","قل لهم أنني ربيع الحياة",76,"ه",1,0],["قِلْ لَه مقيم بلَندَن عمان","الكاينَه ما بين بَرّين",77,"ن",1,0],["قل لهذا الرامي وأنت سفيري","إن مرماك صخرة صماء",78,"ا",2,0],["قل لهما يَرفُقا بقلبِ فتىً","طَوَيتَ أحشاءَه على وَهَجِ",79,"ج",1,0],["قل لهذا البخيل مالك مالك","صرت مثل الأجير تحرس مالك",80,"ك",1,1],["قل له نديمك يِشْتِكي لك ويرتجي","عِبا منك حيث انّك على الرد وَكّادِ",81,"د",1,0],["قلْ له إن متَّ قدماً وجعاً","فمت الآن بنعيٍ جزعا",82,"ع",2,0],["قل له يا محمدٌ صالحٌ أَنت","لإِحراز كلِّ فضل غريبِ",83,"ب",1,0],["قل لها لا برحتِ فردوس أُنسٍ","فيك تلقى الناسُ الهنا والحُبورا",84,"ر",2,0],["\"قلَّ له المثلُ\" والمضاهي","\"في الدهر\" في رفعة ودين",85,"ن",1,0],["قل لَها أَهلاً وَسَهلاً","مرحباً يا أَزرمخشي",86,"ي",1,0],["قل لهم كيف يبذلون غوالي","ها لكي يدفعوا أذى كلّ أرقم",87,"م",1,0],["قل لهم كيف عمّموا العلم حتّى","جعلوا من بينهم كلّ ضيغم",87,"م",1,0],["قل لهم والكلام من فيك درّ","كيف شادوا أهرامهم والمقطّم",87,"م",1,0],["قل له عن نازحٍ صَبٍّ تَرى","دَمعَه صَبّاً متَى ما البرقُ عَنَّا",88,"ن",2,0],["قل لها يا منية القلب ومن","إن تثنت تخجل الغصن قواما",89,"م",2,0],["قُل لِهَذا الإِمامُ عَضْدُكَ في الحَرْ","بِ عَلى النَّاسِ حاشِدٌ وَبَكِيلُ",90,"ل",1,0],["قل له جهرةً على ملأ الأشرا","ف من قومه الملوك القروم",91,"م",1,0],["قل لهم والدموع سفح عقيق","هل لذاك المضنى لديكم نعاما",92,"م",2,0],["قل له يا سعد ان جئت حماه","أيها الجافي دلالاً هل لكا",93,"ك",2,0],["قل لهم يا سيد ما نصبر عشر","كيف انا واليوم مرّت بي اعشور؟",94,"ر",1,0],["قل له عبدك المحب أبو القا","سم يشكو لبعدك الآلاما",95,"م",2,0],["قل له بالتواضع المتعالي","لا بنفس الدعاء والإنكار",96,"ر",1,0],["قل له جهلت صورته","فانظروا ما ضمن اللسنا",97,"ن",2,0],["قُلْ لها أيها الرسولُ عساها","إنْ تُردْ وصلنا نعيشُ بخيرِ",98,"ر",1,0],["قُل لِهَذَينِ كُلا زادَكُما","وَدَعاني واغِلاً حَيثُ أَغِل",99,"ل",1