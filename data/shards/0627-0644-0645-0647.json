,"https://www.poetsgate.com/ViewPoem.aspx?id=5240",""],[5461,"اجمل العشق","https://www.poetsgate.com/ViewPoem.aspx?id=5035",""],[5606,"زمان المصايب","https://www.poetsgate.com/ViewPoem.aspx?id=195062",""],[5606,"مانت ذيب","https://www.poetsgate.com/ViewPoem.aspx?id=202702",""],[5632,"يا سهل....","https://www.poetsgate.com/ViewPoem.aspx?id=177817",""],[5652,"المجامل بالمدايح لي رياء","https://www.poetsgate.com/ViewPoem.aspx?id=198329",""],[5716,"وي ........","https://www.poetsgate.com/ViewPoem.aspx?id=24333",""],[6167,"بحرُ الكِذَاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85575&r=&rc=58",""]],"verses":[["المُهيبونَ بِالضُيوفِ إِذا هَبَّ","ت شَمالاً وَالموقِدونَ النارا",0,"ر",2,0],["المُهينينَ مالَهُم لِزَمانِ ال","سَوءِ حَتّى إِذا أَفاقَ أَفاقوا",1,"ق",3,0],["المُهدِياتُ لِمَن هَوَينَ مَسَبَّةً","وَالمُحسِناتُ لِمَن قَلَينَ مَقالا",2,"ل",2,0],["المهيب اللواء في السيف والس","لم المفدى فما له اعداء",3,"ا",2,0],["المُهَنَّى بكلِّ نصرٍ وفَتْح","وظُهورٍ عل العِدا لا المُهَنِّي",4,"ن",2,0],["المهم .. أصبحت صبحن ماعرف تكوينه","صبح . من ندرة عصافيره ؟ تصيد أحراره",5,"ر",2,0],["المَها لا عَذَّبَ اللهُ المَها","كم أذاقَتْني عَذَابًا وشَجَنْ؟",6,"ن",1,0],["المهرجان الذي كانت تبجِّله","ملوك تبجيلاً وتعظيما",7,"م",2,0],["المُهينُ الكومَ الجِلادَ إِذا ما","هَبَّتِ الريحُ كُلَّ يَومِ شَمالِ",8,"ل",1,0],["المهيمن إله العالمين","كل ما قدر الرحمن كان",9,"ن",1,0],["المهتدي الهادي النبي المصطفى الزا","كي الرضي المدثر المزمل",10,"ل",1,0],["ألُمُّه وأين رت","قُ صدعه باللّم",11,"م",1,0],["المُهتدِي الهادي الأمينُ لشَعبِهِ","كالماءِ يجرِي طاهراً ومُطَهِّرَا",12,"ر",2,0],["المُهيبُونَ بالنفوسِ إلى المو","تِ إذا قابلَ اللواءَ اللواءُ",13,"ا",2,0],["المهملون بنقط السمر كل كم","من الغواة فمنقوط ومهمول",14,"ل",1,0],["المهدمون من الأموال عمروا","ألعامرون من الأعمال ما انهدما",15,"م",2,0],["المهتدى الهادي التهامي العربي","شفيعنا لنيل كل أرب",16,"ب",1,0],["المهدياتُ لَه بالحمدِ ألسُنُنا","حتَّى فَنَتْ بالثَنَا البيض القراطيسُ",17,"س",1,0],["المهيب الثبت الوقور إذا ما","خف حلم والأريحيُّ الوهوبُ",18,"ب",1,0],["المُهتدي الهادي الَّذي اِنتَظَمَت لَهُ","غُرر المَناقب وَالفَعال الأَمجَدُ",19,"د",1,0],["المهتدي بهدى شريعة شارع","أهدى الهداة المهتدي بهداه",20,"ا",2,0],["المهلهل جنب قلبي يعوي ويقنب قنيب","يقنب قنيب الضواري ويعوي من فرقا الهمام",21,"م",1,0],["المهلب ماحسب لابن الفجاءه او شبيب","ولوهم اشرف من عدوي لكن التشبيه قام",21,"م",1,0],["المهم تبعد عن دروب الحرآم","مآندم من خآف رب العآلمين",22,"ن",1,0],["المهم اني اببعد وانتي روحي واتركيني","ارجعيله ومثلي دور البريئه اللي تبالي",23,"ل",2,0],["المهره اللي يتل القلب طاريها","عريبة الجد غاياتي ومنشودي",24,"د",2,0],["المهر بعده مكتمل","وباقي المطالب لك تهال",25,"ل",1,0],["ألَمها جضّ به قلبي ودخّن بالصّدر حرّاق","تفجّر كنّه البركان في سمعي وفي عيني",26,"ن",2,0],["المهل ساعة عسى البسمة تدوم","ظامي(ن) للحب من يومك أصوم",27,"م",1,1],["المهم إناوقعنا في النشايب","ونتنقل من بليه في بليه",28,"ي",2,0],["المهم الفعل مانته من أفعاله قريب","الذيابه والطناخه تراها متعبه",29,"ب",2,0],["المهم يبقى عطاء الخير هاجوس","لجل عينه نشتري كل قلب حساس",30,"س",1,0],["المهمْ الهرج في ذاتي ضياء","يلزِم إلساني .. ب صدقه ينطقي",31,"ق",2,0],["المه فيا لسه حى","جرح قلبى لازمه كى",32,"ا",1,0],["أَلَمَّ هَوىً بقلبى فاكتوى بهْ","فليتَه حينَ طَوَّفَ ما أَصَابَهْ",33,"ب",2,0]]}