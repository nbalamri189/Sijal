{"poems":[[55,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[31,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[112,"كان يوم","https://www.poetsgate.com/ViewPoem.aspx?id=8396",""],[121,"المها","https://www.aldiwan.net/poem24062.html","الرمل"],[208,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[253,"هل لعيش إذا مضى لزوال","https://www.aldiwan.net/poem2098.html","الخفيف"],[395,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[445,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[461,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[565,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"]],"verses":[["المُهيبونَ بِالضُيوفِ إِذا هَبَّ","ت شَمالاً وَالموقِدونَ النارا",0,"ر",2,0],["المُهينينَ مالَهُم لِزَمانِ ال","سَوءِ حَتّى إِذا أَفاقَ أَفاقوا",1,"ق",3,0],["المُهدِياتُ لِمَن هَوَينَ مَسَبَّةً","وَالمُحسِناتُ لِمَن قَلَينَ مَقالا",2,"ل",2,0],["المهيب اللواء في السيف والس","لم المفدى فما له اعداء",3,"ا",2,0],["المُهَنَّى بكلِّ نصرٍ وفَتْح","وظُهورٍ عل العِدا لا المُهَنِّي",4,"ن",2,0],["المهم .. أصبحت صبحن ماعرف تكوينه","صبح . من ندرة عصافيره ؟ تصيد أحراره",5,"ر",2,0],["المَها لا عَذَّبَ اللهُ المَها","كم أذاقَتْني عَذَابًا وشَجَنْ؟",6,"ن",1,0],["المهرجان الذي كانت تبجِّله","ملوك تبجيلاً وتعظيما",7,"م",2,0],["المُهينُ الكومَ الجِلادَ إِذا ما","هَبَّتِ الريحُ كُلَّ يَومِ شَمالِ",8,"ل",1,0],["المهيمن إله العالمين","كل ما قدر الرحمن كان",9,"ن",1,0],["المهتدي الهادي النبي المصطفى الزا","كي الرضي المدثر المزمل",10,"ل",1,0],["ألُمُّه وأين رت","قُ صدعه باللّم",11,"م",1,0],["المُهتدِي الهادي الأمينُ لشَعبِهِ","كالماءِ يجرِي طاهراً ومُطَهِّرَا",12,"ر",2,0]]}