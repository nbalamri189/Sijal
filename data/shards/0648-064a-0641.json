{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[53,"صبرا على نوب الزما","https://www.aldiwan.net/poem30646.html","مجزوء الكامل"],[63,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[63,"سقى دارها من منحنى الأجرع الفرد","https://www.aldiwan.net/poem46164.html","الطويل"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[73,"ما على ظني باس","https://www.aldiwan.net/poem11908.html","مجزوء الرمل"],[93,"يا من لها القصر المنيف","https://www.aldiwan.net/poem11092.html","مجزوء الكامل"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[37,"ويفتر منك عن الواضحات","https://www.aldiwan.net/poem7400.html","المتقارب"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[70,"فدع الصبا لرجاله","https://www.aldiwan.net/poem42399.html","مجزوء الكامل"],[92,"أراك فتحلو لدي الحياة","https://www.aldiwan.net/poem38925.html","المتقارب"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[89,"ذكرى صباباتي فهزني الذكر","https://www.aldiwan.net/poem44845.html","الطويل"],[85,"يحكون أن رجلاً كرديا","https://www.aldiwan.net/poem8053.html","الرجز"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[45,"يأبى سموك واعتلاؤك","https://www.aldiwan.net/poem10206.html","مجزوء الكامل"],[45,"هذا كتابك فيه الجهل والعنف","https://www.aldiwan.net/poem65156.html","البسيط"],[61,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[66,"وأطيب أوقاتي من الدهر خلوة","https://www.aldiwan.net/poem38538.html","الطويل"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[31,"أأقام أمس خليطنا أم سارا","https://www.aldiwan.net/poem42537.html","الكامل"],[74,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[105,"إلى طيئ يا ابن عم النبي","https://www.aldiwan.net/poem43588.html","المتقارب"],[81,"انهض بأمرك فالهدى مقصود","https://www.aldiwan.net/poem61540.html","الكامل"],[21,"إله العالمين وكل أرض","https://www.aldiwan.net/poem36168.html","الوافر"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[50,"آب ليلي بعد السلو بعتب","https://www.aldiwan.net/poem64827.html","الخفيف"],[46,"إذا سلقت عرس الفتى في كلامها","https://www.aldiwan.net/poem23033.html","الطويل"],[68,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[36,"طربت وما هذا بساعة مطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16615&r=&rc=0",""]],"verses":[["وَيُفرِدُنا الزَمانُ بِلا قَريبٍ","يُذُمُّ مِنَ الزَمانِ وَلا حَميمِ",0,"م",1,0],["وَيُفرِغُ صائِباتِ الرَأيَ فيها","كَإِفراغِ النِبالِ مِنَ الجَفيرِ",1,"ر",1,0],["وَيُفَرِّجُ الغَمّاءَ يَح","رَجُ عِندَها العَطَنُ الفَسيحُ",2,"ح",1,0],["ويُفْلى لَبانُ الأعوَجيّ ويَرْتَدى","إذا اشْتَجرَتْ زُرْقُ الأسِنّةِ عِثْيَرُ",3,"ر",1,0],["ويُفْعِمُ غُدْراناً كأنّ يَدَ الصَّبا","تَجُرُّ علَيْها رَفْرَفَ النَّثْرَةِ السَّرْدِ",4,"د",1,0],["ويَفْري بُرْدَةَ الظّلْماءِ حتى","يُفيقَ الأعْوَجيُّ منَ الحِرانِ",5,"ن",1,0],["وَيُفَتُّ المِسكُ في التُربِ","فَيوطا وَيُداسُ",6,"س",1,0],["وَيفِيضُ مِنْكِ البِرُّ","فَالوَادِي الظَّمْيءُ بِهِ رَوِي",7,"ي",1,0],["وَيُفايِشونَكَ وَالعِظامُ ضَعيفَةٌ","وَالمُخُّ مُمتَخَرُ الهُنانَةِ رارُ",8,"ر",1,0],["ويفترُّ منك عن الواضحات","إذا غيرُك القلِح الأثعل",9,"ل",1,1],["ويفهم السرّ من حاجات أنفسنا","فما نطيق على أمرٍ نُساتره",10,"ر",2,0],["ويَفْكَهُ الحالَ بعد الحالِ مُقتَفِياً","آثار من قَرَنَ السُّلَّاء بالرُّطبِ",11,"ب",1,0],["ويُفزَعُ في الجُلَّى إلى عَزَماتِهِ","فيستلُّ منها كالسيوف البواتِك",12,"ك",1,0],["ويفوزوا بالحمدِ من حيث لا يصْ","لون غُرماً يصْلاه للحمد صالِ",13,"ل",1,0],["ويَفْتَنُّ فيهم مادح بعدَ مادحٍ","وليس لصدقٍ مستتبٍّ بعادمِ",14,"م",1,0],["وَيَفوحُ مِن عِطفَيَّ أَن","فاسُ الشَبابِ كَما هِيَه",15,"ي",2,0],["ويفْتِنُني فيكِ فيضُ الحَيَاةِ","وذاك الشَّبابُ الوديعُ الثَّمِلْ",16,"ل",1,0],["ويفْتِنُني سِحْرُ تِلْكَ الشِّفاهْ","ترفرفُ مِنْ حَوْلهنَّ القُبَلْ",16,"ل",1,0],["ويفنى الجميعُ كحلْمٍ بديعٍ","تأَلَّقَ في مهجةٍ واندَثَرْ",17,"ر",1,0],["ويفعل فعل المغنطيس حديثه","فيجذب أشتات القلوب الشوارد",18,"د",1,0],["ويفتنني منها حديث ومنطق","وتفتنها مني الفصاحة والشعر",19,"ر",1,0],["وَيُفزِعُ اليَهودَ وَالنَصارى","وَيُرعِبُ الكِبارَ وَالصِغارا",20,"ر",2,0],["وَيَفي كَدَيدَنِهِ بِحَقٍّ بِلادِهِ","وَيَفي بِعَهدِ المُسلِمينَ كَدابِه",21,"ب",2,0],["وَيُفَصِّلُ الأَخلاقَ لِل","أَجيالِ تَفصيلَ اليَتيمِ",22,"م",1,0],["وَيَفُلُّ مِن هوجِ الرِياحِ عَزائِماً","وَيَدُكُّ مِن مَوجِ البِحارِ جِبالا",23,"ل",2,0],["وَيَفهَمُ صَوتَ المَشرَفِيَّةِ فيهِمِ","عَلى أَنَّ أَصواتَ السُيوفِ أَعاجِمُ",24,"م",1,0],["وَيَفوتُني نَيلٌ مَسا","فَتُهُ كِتابُكَ أَو لِقاؤُك",25,"ك",1,0],["وَيَفتُقُ الوَردُ خُضراً عَن مُعَصفَرَةٍ","وَيَكتَسي نورَهُ القاطولُ وَالنَجَفُ",26,"ف",1,0],["ويَفضَحُ نابَه سَجَحاتُ نابي","إذا استُودِعْنَ سِرَّ فتىً أُذيعا",27,"ع",2,0],["وَيَفهَمُ ما قَد قالَ عَقلي تَصَوُّري","فَنَقلي إِذا عَنّي وَسَمعي بِها مِنّي",28,"ن",2,0],["ويفتكُ بالمالِ للمعتفينَ","عطاءُ يمينيَ فَتْكَ البطل",29,"ل",1,0],["ويَفتَنُ شَخْصَكَ المرمِيَّ منها","فتورٌ بالملاحةِ واحْوِرارُ",30,"ر",1,0],["وَيَفوزُ مَن هِيَ في الشِتاءِ شِعارُهُ","أَكرِم بِها دونَ اللَحافِ شِعارا",31,"ر",2,0],["وَيَفُكُّ مِن أَغلالِ أَسرى فاقَةٍ","وَفَصيحَ قَومٍ في مَقادَةِ أَعجَمِ",32,"م",1,0],["وَيَفحَصُ عَن ثَغرٍ مِنَ النورِ ضاحِكٍ","فَيُسفِرُ عَن وَجهٍ مِنَ الجَدبِ قاتِمِ",33,"م",1,0],["ويُفْشِي السَّلامَ ويرعى الذِّمامَ","ويَقْرِي الضُّيوفَ وَيَشْفِي القَرَمْ",34,"م",1,0],["وَيَفوقُ وَقتٌ أَنتَ فيهِ غَيرَهُ","حَتّى اللَيالي سَيدٌ وَمَسودُ",35,"د",1,0],["وَيَفنى بَعدَ جِدَّتِهِ وَيبلى","سِوى الباقي المُقَدَّسِ ذي الجَلالِ",36,"ل",1,0],["وَيَفونَ إِن عَقَدوا وَإِن أَتلَوا حَبَوا","دونَ التَلاءِ بِفَخمَةٍ مِذكارِ",37,"ر",1,0],["وَيَفتُقُ جانينا وَنَرُتُقُ فَتقَهُ","إِذا ما عَظيماتُ الأُمورِ اِستَجَلَّتِ",38,"ت",1,0],["وَيُفَنِّدُ العُلَماءَ تَوْبِيخاً لَهُم","وكَفَاهُمُ بِخَطِيئَةٍ تَخْجِيلا",39,"ل",2,0],["وَيُفَدّي سِواكِ في مَجلِسِ القَو","مِ وَيَعنيكِ بِالتَفَدّي وَرَبّي",40,"ي",1,0],["وَيَفعَلُ فِعلاً سَيِّئاً رَبُّ مَنظَرٍ","جَميلٍ وَيَأتي الخَيرَ مَن لَم يَرُق خَلقا",41,"ق",2,0],["وَيفْرَحَ محزونٌ ويَحْيَا مُتَيَّمٌ","ويأنَسَ مُشْتَاقٌ ويلتَذّ سامعُ",42,"ع",1,0],["ويفرُك راحتيهِ دماً وناراً","يُغَنِّي حُبَّهُ ويُديرُ جامهْ",43,"م",2,0],["ويفيض من نبع القلوب فآنة","ماء وآنا جاحما لفاحا",44,"ح",2,0],["ويُفْرِجُ بَوَّابٌ لَها عَنْ مُناخِها","بإقْلِيدِه بابَ الرِّتَاجِ المُضبّبِ",45,"ب",1,0],["وَيَفْتَرِقونَ تِجَاهَ الصفو","فِ وَيَجْتَمِعُونَ عَلَى المُفْرَدِ",46,"د",1,0],["وَيَفرَحُ بان بِحَسنائِهِ","وَلَو ذَكَرَ المَوتَ ما أَنمَظا",47,"ظ",2,0],["ويُفَتِّحُ الأَزْهارَ في أَكْمامِها","ويُنَبِّه القُمْرِيَّ مِنْ إِغْفَائه",48,"ا",3,0],["ويفترشُ الخَزَّ جنبٌ، وجنبٌ","إذا نام لم يلق إلا العراء؟",49,"ا",2,0],["ويفرض نفسه فَرْضًا","على التاريخ بالأمر",50,"ر",1,0],["ويَفِرُّ شيطانُ القوافي هارِبًا","منها هروبَ الكَبْش من قَصَّابِه",51,"ب",2,0],["ويَفْكَهُ الحالَ بعد الحالِ ُقتَفراً","آثار من قَرَنَ السُّلاء بالرُّطبِ",52,"ب",1,0],["ويفرج بوّابٌ لها عَنْ مُناخها","بقليدهِ بابَ الرتاج المُضبّبِ",53,"ب",1,0]]}