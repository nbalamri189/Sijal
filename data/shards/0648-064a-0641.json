m15194.html","الكامل"],[475,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[498,"أبعد توكلي وصحيح عهدي","https://www.aldiwan.net/poem37626.html","الوافر"],[498,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[498,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[549,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[549,"ألا ماذا يريبك من همومي","https://www.aldiwan.net/poem47740.html","الوافر"],[549,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[549,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[556,"أنا البرق والرب المناجي هو الرعد","https://www.aldiwan.net/poem34590.html","الطويل"],[560,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[560,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[573,"ما أخشن الدهر على لينه","https://www.aldiwan.net/poem2772.html","السريع"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[573,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"]],"verses":[["وَيُفرِدُنا الزَمانُ بِلا قَريبٍ","يُذُمُّ مِنَ الزَمانِ وَلا حَميمِ",0,"م",1,0],["وَيُفرِغُ صائِباتِ الرَأيَ فيها","كَإِفراغِ النِبالِ مِنَ الجَفيرِ",1,"ر",1,0],["وَيُفَرِّجُ الغَمّاءَ يَح","رَجُ عِندَها العَطَنُ الفَسيحُ",2,"ح",1,0],["ويُفْلى لَبانُ الأعوَجيّ ويَرْتَدى","إذا اشْتَجرَتْ زُرْقُ الأسِنّةِ عِثْيَرُ",3,"ر",1,0],["ويُفْعِمُ غُدْراناً كأنّ يَدَ الصَّبا","تَجُرُّ علَيْها رَفْرَفَ النَّثْرَةِ السَّرْدِ",4,"د",1,0],["ويَفْري بُرْدَةَ الظّلْماءِ حتى","يُفيقَ الأعْوَجيُّ منَ الحِرانِ",5,"ن",1,0],["وَيُفَتُّ المِسكُ في التُربِ","فَيوطا وَيُداسُ",6,"س",1,0],["وَيفِيضُ مِنْكِ البِرُّ","فَالوَادِي الظَّمْيءُ بِهِ رَوِي",7,"ي",1,0],["وَيُفايِشونَكَ وَالعِظامُ ضَعيفَةٌ","وَالمُخُّ مُمتَخَرُ الهُنانَةِ رارُ",8,"ر",1,0],["ويفترُّ منك عن الواضحات","إذا غيرُك القلِح الأثعل",9,"ل",1,1],["ويفهم السرّ من حاجات أنفسنا","فما نطيق على أمرٍ نُساتره",10,"ر",2,0],["ويَفْكَهُ الحالَ بعد الحالِ مُقتَفِياً","آثار من قَرَنَ السُّلَّاء بالرُّطبِ",11,"ب",1,0],["ويُفزَعُ في الجُلَّى إلى عَزَماتِهِ","فيستلُّ منها كالسيوف البواتِك",12,"ك",1,0],["ويفوزوا بالحمدِ من حيث لا يصْ","لون غُرماً يصْلاه للحمد صالِ",13,"ل",1,0],["ويَفْتَنُّ فيهم مادح بعدَ مادحٍ","وليس لصدقٍ مستتبٍّ بعادمِ",14,"م",1,0],["وَيَفوحُ مِن عِطفَيَّ أَن","فاسُ الشَبابِ كَما هِيَه",15,"ي",2,0],["ويفْتِنُني فيكِ فيضُ الحَيَاةِ","وذاك الشَّبابُ الوديعُ الثَّمِلْ",16,"ل",1,0],["ويفْتِنُني سِحْرُ تِلْكَ الشِّفاهْ","ترفرفُ مِنْ حَوْلهنَّ القُبَلْ",16,"ل",1,0],["ويفنى الجميعُ كحلْمٍ بديعٍ","تأَلَّقَ في مهجةٍ واندَثَرْ",17,"ر",1,0],["ويفعل فعل المغنطيس حديثه","فيجذب أشتات القلوب الشوارد",18,"د",1,0],["ويفتنني منها حديث ومنطق","وتفتنها مني الفصاحة والشعر",19,"ر",1,0],["وَيُفزِعُ اليَهودَ وَالنَصارى","وَيُرعِبُ الكِبارَ وَالصِغارا",20,"ر",2,0],["وَيَفي كَدَيدَنِهِ بِحَقٍّ بِلادِهِ","وَيَفي بِعَهدِ المُسلِمينَ كَدابِه",21,"ب",2,0],["وَيُفَصِّلُ الأَخلاقَ لِل","أَجيالِ تَفصيلَ اليَتيمِ",22,"م",1,0],["وَيَفُلُّ مِن هوجِ الرِياحِ عَزائِماً","وَيَدُكُّ مِن مَوجِ البِحارِ جِبالا",23,"ل",2,0],["وَيَفهَمُ صَوتَ المَشرَفِيَّةِ فيهِمِ","عَلى أَنَّ أَصواتَ السُيوفِ أَعاجِمُ",24,"م",1,0],["وَيَفوتُني نَيلٌ مَسا","فَتُهُ كِتابُكَ أَو لِقاؤُك",25,"ك",1,0],["وَيَفتُقُ الوَردُ خُضراً عَن مُعَصفَرَةٍ","وَيَكتَسي نورَهُ القاطولُ وَالنَجَفُ",26,"ف",1,0],["ويَفضَحُ نابَه سَجَحاتُ نابي","إذا استُودِعْنَ سِرَّ فتىً أُذيعا",27,"ع",2,0],["وَيَفهَمُ ما قَد قالَ عَقلي تَصَوُّري","فَنَقلي إِذا عَنّي وَسَمعي بِها مِنّي",28,"ن",2,0],["ويفتكُ بالمالِ للمعتفينَ","عطاءُ يمينيَ فَتْكَ البطل",29,"ل",1,0],["ويَفتَنُ شَخْصَكَ المرمِيَّ منها","فتورٌ بالملاحةِ واحْوِرارُ",30,"ر",1,0],["وَيَفوزُ مَن هِيَ في الشِتاءِ شِعارُهُ","أَكرِم بِها دونَ اللَحافِ شِعارا",31,"ر",2,0],["وَيَفُكُّ مِن أَغلالِ أَسرى فاقَةٍ","وَفَصيحَ قَومٍ في مَقادَةِ أَعجَمِ",32,"م",1,0],["وَيَفحَصُ عَن ثَغرٍ مِنَ النورِ ضاحِكٍ","فَيُسفِرُ عَن وَجهٍ مِنَ الجَدبِ قاتِمِ",33,"م",1,0],["ويُفْشِي السَّلامَ ويرعى الذِّمامَ","ويَقْرِي الضُّيوفَ وَيَشْفِي القَرَمْ",34,"م",1,0],["وَيَفوقُ وَقتٌ أَنتَ فيهِ غَيرَهُ","حَتّى اللَيالي سَيدٌ وَمَسودُ",35,"د",1,0],["وَيَفنى بَعدَ جِدَّتِهِ وَيبلى","سِوى الباقي المُقَدَّسِ ذي الجَلالِ",36,"ل",1,0],["وَيَفونَ إِن عَقَدوا وَإِن أَتلَوا حَبَوا","دونَ التَلاءِ بِفَخمَةٍ مِذكارِ",37,"ر",1,0],["وَيَفتُقُ جانينا وَنَرُتُقُ فَتقَهُ","إِذا ما عَظيماتُ الأُمورِ اِستَجَلَّتِ",38,"ت",1,0],["وَيُفَنِّدُ العُلَماءَ تَوْبِيخاً لَهُم","وكَفَاهُمُ بِخَطِيئَةٍ تَخْجِيلا",39,"ل",2,0],["وَيُفَدّي سِواكِ في مَجلِسِ القَو","مِ وَيَعنيكِ بِالتَفَدّي وَرَبّي",40,"ي",1,0],["وَيَفعَلُ فِعلاً سَيِّئاً رَبُّ مَنظَرٍ","جَميلٍ وَيَأتي الخَيرَ مَن لَم يَرُق خَلقا",41,"ق",2,0],["وَيفْرَحَ محزونٌ ويَحْيَا مُتَيَّمٌ","ويأنَسَ مُشْتَاقٌ ويلتَذّ سامعُ",42,"ع",1,0],["ويفرُك راحتيهِ دماً وناراً","يُغَنِّي حُبَّهُ ويُديرُ جامهْ",43,"م",2,0],["ويفيض من نبع القلوب فآنة","ماء وآنا جاحما لفاحا",44,"ح",2,0],["ويُفْرِجُ بَوَّابٌ لَها عَنْ مُناخِها","بإقْلِيدِه بابَ الرِّتَاجِ المُضبّبِ",45,"ب",1,0],["وَيَفْتَرِقونَ تِجَاهَ الصفو","فِ وَيَجْتَمِعُونَ عَلَى المُفْرَدِ",46,"د",1,0],["وَيَفرَحُ بان بِحَسنائِهِ","وَلَو ذَكَرَ المَوتَ ما أَنمَظا",47,"ظ",2,0],["ويُفَتِّحُ الأَزْهارَ في أَكْمامِها","ويُنَبِّه القُمْرِيَّ مِنْ إِغْفَائه",48,"ا",3,0],["ويفترشُ الخَزَّ جنبٌ، وجنبٌ","إذا نام لم يلق إلا العراء؟",49,"ا",2,0],["ويفرض نفسه فَرْضًا","على التاريخ بالأمر",50,"ر",1,0],["ويَفِرُّ شيطانُ القوافي هارِبًا","منها هروبَ الكَبْش من قَصَّابِه",51,"ب",2,0],["ويَفْكَهُ الحالَ بعد الحالِ ُقتَفراً","آثار من قَرَنَ السُّلاء بالرُّطبِ",52,"ب",1,0],["ويفرج بوّابٌ لها عَنْ مُناخها","بقليدهِ بابَ الرتاج المُضبّبِ",53,"ب",1,0],["وَيَفض الحَديث فيهنَّ شادٍ","يَستَفز النُهى إِذا ما تَغَنى",54,"ن",2,0],["ويفهم الرمز اقوم لقد جهلوا ال","حق اليقين وقد تقضى لبانات",55,"ت",1,0],["ويفيض بالله الاغاثة مسرعا","فكأنها الهبابة الهوجاء",56,"ا",2,0],["ويفتنني نوم الضياء عشيةً","على صفحة الغدران وهي تسبسب",57,"ب",1,0],["وَيَفعَلُ الرِّجَالُ في القُعُودِ ذَاك","صَومُ ثَلاثَةٍ تُصدِّقٌ كَفَاك",58,"ك",1,0],["ويفوق يلاقيه اترّبط","ولا ينوبُه إلاّ الكيده",59,"ه",1,0],["وَيَفرُقُ ما بَينَ المَفارِقِ وَاللَهى","إِذا ما عَرا خَطبٌ وَما فارَقَ الغِمدا",60,"د",2,0],["وَيَفوتُ أَهلَ الأَرضِ بِالشِيَمِ الَّتي","يَمتارُ مِنها سَيِّدٌ وَمَسودُ",61,"د",1,0],["وَيَفضُلُ تاليكُم عَلى مَن يَؤُمُّهُ","فَمَن جاءَ مِنكُم آخِراً عُدَّ أَوَّلا",62,"ل",2,0],["وَيَفشو إِذا ماشٍ يُؤمِّلُها مَشى","غَضا شَوقِها بَينَ الجَوانِحِ وَالحَشا",63,"ش",2,0],["ويفرح المرء باستهلال شهر كذا","وعمره ينقضي في ذلك الشهرِ",64,"ر",1,0],["ويفتى بما لم ينزل الله خفية","وينكرها إن عابها من يعيب",65,"ب",1,0],["وَيُفاخِرونَ بِمَعشَرٍ دَرَجوا وَلَم","تَدرُج جِبالُ الرَملِ بِالبَيضاءِ",66,"ا",2,0],["ويفيد صاحبه الهوى","ذُلّا يقارنهُ الفزَع",67,"ع",1,0],["ويفرح يوم العيد من فيه متعة","ومستمتع في ملكه المال والوفر",68,"ر",1,1],["ويفتح لي بالشيء أهوى وأشتهي","مواساة جاري والجوار وكيد",69,"د",1,1],["وَيَفعلُ أَفعالاً إِذا عُرِضَت على","أُولئكَ عدّوها بمذهبهم كفرا",70,"ر",2,0],["وَيُفتي بحلِّ المُسكِرات جَميعها","إِذا هيَ بالأسماءِ خالفتِ الخمرا",70,"ر",2,0],["وَيفعلُ ما يختارُ في الخلقِ مُطلقاً","وَلا حرَجٌ يأتي عليهِ ولا حجرا",71,"ر",2,0],["ويفوقُ محتدُهُ الكواكبَ مرتقىً","فكأنَّهُ فوقَ السماءِ سماءُ",72,"ا",2,0],["ويفرقُ الشمل الجميع فإن دها","لم يمهلِ الأحبابَ أن يتنادوا",73,"د",3,0],["ويفتر عن ثغر تنظم دره","فلم ادر عقدا مذ تبسم ام ثغرا",74,"ر",2,0],["ويَفْضَحُ قُسّاً في المَقالِ ولن ترى","شبيهاً له في النُطق إن هُوَ صَاغَهُ",75,"ه",1,0],["وَيُفاخِرونَ بِهِ لِأَنَّ نسيجَه","كَنَسيجِهِم وَمُرادُهُم كَمُرادِهِ",76,"د",2,0],["ويفوتُني حَظِّي وتَحتي سابحٌ","رَحْبُ اللَّبَان وفي يَدَيَّ حُسامُ",77,"م",1,0],["وَيُفتَحُ بابُ النَدى لِلعُفاةِ","وَيُغلَقُ دوني فَلا تُفتَحُ",78,"ح",1,0],["وَيَفرَحُ كُلٌّ بِما نالَهُ","وَما لِيَ قِسمٌ بِهِ أَفرَحُ",78,"ح",1,0],["وَيَفرِجَ لي عَن طَريقِ العُلى","زِحامَ الخُطوبِ وَحَشدَ النُوَب",79,"ب",1,0],["وَيُفَاخَرُ الدُّرُّ الذِي","فِي جِيدِ أَجْيَدَ قَدْ تَنَضَّدْ",80,"د",1,0],["وَيَفضُلُ عَفوَ الناعِجاتِ ضَريرُها","إِذا اِحتَدَمَت بَعدَ الكَلالِ المُغَلِّسِ",81,"س",1,0],["وَيَفْرجُ البَابَ الشَّديدِ رِتَاجَهُ","حَتَّى يَصِيرَ كأَنَّهُ بَابانِ",82,"ن",1,0],["ويفوز فيها نازعوها","من قشاعيم النسور",83,"ر",1,0],["وَيفضل الغمدُ يوَ الفخر صارمه","وَتَستَطيلُ على ساداتها الخدمُ",84,"م",1,0],["ويفضحني محياه إذا ما","بدا وكذا النجوم مع الشموس",85,"س",1,0],["ويفتح باب الرجا للورى","فيغدو على فتحه مرتجى",86,"ج",2,0],["وَيَفنى ما حَواهُ المُلكُ أَصلاً","وَفِعلُ الخَيرِ عِندَ اللَهِ باقِ",87,"ق",1,0],["ويفهم بعض الذر مقصود بعضه","بقوة إدراك لنفس زكية",88,"ه",1,0],["ويفرّ السجين من قبضة القي","د فتنسى عند الختام البدايه",89,"ه",1,0],["ويفتحُها فيرى عالماً","يعذّبه السلم قبل الحروب",90,"ب",1,0],["ويفتك بالضحايا الهي","م ما يمنعه عتب",91,"ب",1,0],["وَيَفنى وَلَم تفنَ آمالُهُ","وَإِعمالُ سَوفَ إِلى لَيتِه",92,"ت",2,0],["ويفنى السطموح وتذوب المنى","وندفن في حفرة نائية",93,"ي",2,0],["ويُفْرَشُ كافوراً ومَفرِقُ رأسِه","به المسْكُ من طولِ التَضَمُّخ صاكا",94,"ك",2,0],["ويَفْدَحُ كتِمانُ ما لا يُطيق","ويَفْضَحُ إعلانُ ما لا يُريد",95,"د",1,0],["ويفضلُ عنها مشبلٌ عند شدِّها","مع العقد فانظر كيف يختَصر الخصرُ",96,"ر",1,0],["وَيَفتر أَحياناً عَن النَوح وَالبُكا","وَلَكن دَمعي لا تَمل سَواكبه",97,"ب",2,0],["وَيَفخَر قَلبُهُ القاسي","بِسَلب حَشاشة النَفس",98,"س",1,0],["ويفوتُ طالبَه ويُدْركُ","حينَ يطلبُ كلَّ هاربْ",99,"ب",1,0],["ويُفِيضُها يوم الحساب على الخلا","ئق منَّةً في يوم كشف الساق",100,"ق",1,0],["ويفيضُ نائلُهُ بفَيضٍ زاعِبٍ","فيقولُ سائلُهُ قَدِي قَدِيِ",101,"ي",1,0],["وَيفري بيمناه الكَليل مِن الظُبى","وَيَزداد طولاً في يَدَيهِ قَصيرُها",102,"ر",3,0],["وَيَفضُّ ختم كِتابِهِ عن كُتبهِ","كالدُرِّ إِلّا أَنَّهُ لَم يثقَبِ",103,"ب",1,0],["ويفترُّ في وجه المطالب ضاحكاً","ولا الأُقحوان الغضّ عند افتراره",104,"ر",2,0],["ويفترسُ الأسودَ بمُرهَفاتِ","من العَزَماتِ تفترسُ الأسودا",105,"د",2,0],["ويفوزُ منه بالمكافأةِ التي","تُزْري بصوْبِ العارضِ الهطّالِ",106,"ل",1,0],["ويفيض الدموع حتى لقد أص","بح بين الأحباب منه عزاء",107,"ا",2,0],["ويَفْحَصْنَ فِي رَضمِ الحَصى بمناسِمٍ","تهيم إِلَى حصباءَ من لُؤْلُؤٍ رَطْبِ",108,"ب",1,0],["ويفسد حج ثم صوم وثابت","به نسب الآباء في الحكم فاعلموا",109,"م",3,0],["ويفيض ابن مُصْعَبٍ في نثير ال","قول من حيث ينتقي أبكاره",110,"ر",2,0],["ويفيض كالبركان في حمم له","ويلا على المتجبر المفزوع",111,"ع",1,0],["وَيَفنىَ مراراً حين يُبنىَ مكَّرراً","وقد خُلطت فيه الخرائبُ والصُّور",112,"ر",1,0],["ويفنَى الثوابُ وما تذخَرو","ن من كنزها محرَزٌ حاصلُ",113,"ل",1,0],["ويُفسدها عندي المِطالُ فربما","تُسابق لفظَ الوعد حزماً فتسبِقُ",114,"ق",1,0],["ويفضل جَوْدَ السحب جُودُ محمدٍ","فكلُّ ندى كفَّيْه سَحٌّ ووابلُ",115,"ل",1,0],["ويفضُلُ آمالَ العُفاةِ كهاطِلٍ","تضيقُ الفَلا عن صوبه وهو واسعُ",116,"ع",1,0],["ويفهم فيها عاملُ الرُّمح مقصد ال","طَّلوب وإنْ راح الكميُّ مجمجما",117,"م",2,0],["ويفضلُ الأورق العاديَّ مُحْتَبياً","إذا استخفت حلوم الرجَّحِ الصُّبُر",118,"ر",1,0],["ويُفْهقُ أسماع الضيوف بعُذره","إذا ما المَقاري نَشَّ عنها قَديرُها",119,"ر",3,0],["ويَفوقُ ما شادَتْ أوائلُهُ","فالمجدُ بين السَّعْي والنَّجْرِ",120,"ر",1,0],["ويفيضُ دمعٌ ما تحدَّرَ غَربُهُ","اِلاّ أنافَ على الغديرِ الطافحِ",121,"ح",1,0],["ويَفْعَلُ في العقلِ الصحيحِ سماعُه","مِن السُّكرِ فِعلاً لم ينلْهُ شرابُهُ",122,"ب",2,0],["ويفني الكلُّ والجابرُ باقٍ","له في دولة القدس الدوام",123,"م",1,0],["ويفْعَلُ اللهُ الَّذي يُريدُهُ","رغْمَ جَحودٍ للعِنادِ أَلِفَا",124,"ف",2,0],["ويفعَلُ ما لا يفعلُ الحاضِرُ الذي","رَمَنْهُ العُلى عن قُعْسِ تلك المَراتِبِ",125,"ب",1,0],["ويفديك كلُّ بخيل اليدين","يمنّ الكثيرَ ويُعطي القليلا",126,"ل",2,0],["وَيفدِي واهناً فيه بنَدْبٍ","ويُسبِق راكباً ممّا يماشي",127,"ي",1,0],["ويفديك مَن لا يُرتَجى لمُلِمَّةٍ","ولا هو فيما أنت تصبر صابرُ",128,"ر",1,0],["وَيَفديكَ منَ الأقوا","مِ سَيّارٌ بلا حادِ",129,"د",1,0],["ويفرحني أني مع الغير هكذا","متى ما خلا بي ليس لي عنده حمد",130,"د",1,0],["ويَفتخِرُ الحدِيدُ براحَتيهِ","على الحَجَرِ الكريمِ وإنْ تَغالَى",131,"ل",2,0],["ويَفصِلُ الأمرَ والألبابُ في دَهَشٍ","ويُفصِحُ القولَ والأفواهُ في حَصَرِ",132,"ر",1,0],["ويفجأُ المرَ بتحريكه","أَوْثَقَ ما كان بتسكِينهِ",133,"ن",2,0],["ويفترّ مدّاحه من لهاه","فهم في المدائح لن يفتروا",134,"ر",3,0],["ويَفْتَحُ ديوانَ السَّماءِ عُطارِد","لإِنشاءِ أَخبارِ البشائِر والكُتْبِ",135,"ب",1,0]]}