مولاي أمرك قد تقدم","https://www.aldiwan.net/poem12729.html","مجزوء الكامل"],[433,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[433,"لله بدر أشرقت","https://www.aldiwan.net/poem12751.html","مجزوء الكامل"],[438,"أمّا الخليط فبان غير مودع","https://www.aldiwan.net/poem2555.html","الكامل"],[438,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[440,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[440,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[442,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[442,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[442,"من لائمي إن سفحت الدمع من مقلي","https://www.aldiwan.net/poem14476.html","البسيط"],[459,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[462,"ويحل منه نديه","https://www.aldiwan.net/poem15377.html","مجزوء الكامل"],[465,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[465,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[465,"ومواقف بالنيربين شهدتها","https://www.aldiwan.net/poem3379.html","عموديه"],[465,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[465,"ديار هند أقفرت منذ أزمان","https://www.aldiwan.net/poem3492.html","عموديه"],[469,"أرض إله السماء عنك بما","https://www.aldiwan.net/poem59911.html","المنسرح"],[480,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[483,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[496,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[515,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[539,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[554,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[568,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[568,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"],[568,"برزت وأتراب لها عرب","https://www.aldiwan.net/poem69683.html","الكامل"],[576,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[576,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[586,"لا تلق دهرك بالعتاب","https://www.aldiwan.net/poem1570.html",""],[587,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[587,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["فالدَّهْرُ مُنتَظِرٌ أمْراً تُشيرُ بهِ","فمُرْ بما يَقْتَضيهِ الرَّأيُ يَمْتَثِلِ",0,"ل",1,0],["فَالدَّهْرُ قدْ شَبَّ بِهِ","وَكَانَ يَشْكُو الْهَرَمَا",1,"م",2,0],["فَالدَهرُ غَيَّرَ ذاكَ يا اِبنَةَ مالِكٍ","وَالدَهرُ يُعقِبُ صالِحاً بِفَسادِ",2,"د",1,0],["فَالدَهرُ مُعتَرِفٌ بِأَنّا لَم نَكُن","لِنُسَرَّ مِنهُ بِساعَةٍ لَولاكا",3,"ك",2,0],["فَالدَّارُ مِنْ لُطْفِ الضِّيَافَةِ دَارُهُ","وَوَلِيُّهَا المَخْدُومُ شِبْهُ الخَادِمِ",4,"م",1,0],["فالدمع من عيني إذا وكفا","جلل وإن أرسلته دفعا",5,"ع",2,0],["فَالدَهرُ أَقصَرُ مُدَّةً مِمّا تَرى","وَعَساكَ أَن تُكفى الَّذي تَخشاهُ",6,"ه",1,0],["فالدهر لونٌ واحدٌ عنده","طرًّا وعند الناس ألوانه",7,"ن",2,0],["فالدهرُ لا تنقضي عجائبُهُ","أو يتقضَّى من أهله أرَبُهْ",8,"ب",2,0],["فالدهر إن جرت يوماً","يديل منك وينصفْ",9,"ف",1,0],["فَالدَهرُ أَجمَعَهُ لَدَيها غِبطَةٌ","وَالدَهرُ أَجمَعَهُ لَدَيهِ حُبورُ",10,"ر",1,0],["فَالدَفينُ الَّذي هُناكَ يُقيمُ","بَطَلٌ مُصلِحٌ وَروحٌ كَريمُ",11,"م",1,0],["فالدَّهْرُ مُنْتَعِلٌ بالنَّارِ مُلْتَحِفٌ","بالهوْلِ والويلِ والأَيامُ تَشْتَعِلُ",12,"ل",1,0],["فالدهرُ شيء بارِدٌ","ما لَم تُسخنه بَراحِ",13,"ح",1,0],["فالدهرُ ليس ينامُ عن","كَ وأنتَ عنهُ في منَامِ",14,"م",1,0],["فالدُّرُ وهو أجلُّ شَيءٍ يُقْتَنَى","ما حَطَّ قيمتَهُ هوانُ الغائصِ",15,"ص",1,0],["فَالدَهرَ يَعقِرُ بِالقَوافي أَهلُها","في العَرضِ مِن آلائِهِ وَالطولِ",16,"ل",1,0],["فَالدَهرُ يَلقاني لِسَيبِكَ شاكِراً","إِذ كُنتُ لا أَلقاكَ إِلّا مُنعِما",17,"م",2,0],["فالدين قد شمخت ذرا أركانه","والكفر قد أودى ذرا وقواعدا",18,"د",2,0],["فالدهرُ يمسَحُ منه غُرَّةَ سابقٍ","لاقاه أَوَّلَ سَابقِينَ أوائلِ",19,"ل",1,0],["فالدَّهْرُ ليسَ يَفوتُ رك","ضُ خُطوبِه رَكضَ الفَوارِس",20,"س",1,0],["فَالدِّعْصُ والغُصنُ في غَلائِلِه","والليلُ والصبحُ فوقَ أزرارِ",21,"ر",1,0],["فالدَّهرُ يعجَبُ منه لَمَّا مسَّه","بِجَهنَّمَ الصُّغرى فلم يَتفطَّرِ",22,"ر",1,0],["فَالدائِراتُ بِرَيبِ الدَهرِ دائِرَةٌ","وَالمَرءُ عَن نَفسِهِ ما عاشَ مَختولُ",23,"ل",1,0],["فَالدَهرُ مِن زَلّاتِهِ قَد اِعتَذَر","وَجاءَنا مِنَ الذُنوبِ تائِبا",24,"ب",2,0],["فَالدَهرُ يُقسِمُ أَنَّهُ مِن رِقِّهِ","وَالمَوتُ يَحلِفُ أَنَّهُ مِن جُندِهِ",25,"د",2,0],["فالدِّينُ معتَمدٌ مِنهُ على مَلكٍ","يُمسي ويُضحي على الرّحمنِ مُعتَمِدا",26,"د",2,0],["فالدِّمْنُ فيه لنبتِ الأرض مَصْلَحَةٌ","ولو خلطتَ به الكافورَ أفْسَدَهُ",27,"ه",1,0],["فَالدَّهْرُ كَالدُّولابِ يَخْفِضُ عَالِياً","مِنْ غَيْرِ مَا قَصْدٍ وَيَرْفَعُ سَافِلا",28,"ل",2,0],["فالدارُ غيرُ الدارِ بعدَ رحيلِكم","والناسُ واحرباهُ غيرُ الناسِ",29,"س",1,0],["فَالدَمعُ فيكَ مَعَ النَهارِ خَصيمُهُ","وَالسُهدُ فيكَ مَعَ الكَلامِ رَقيبُهُ",30,"ب",2,0],["فَالدَمعُ مِنّي وَاكِفٌ سَرِبٌ","كَالغَربِ يُنزَعُ دائِمَ الوَكفِ",31,"ف",1,0],["فالدُّرُّ يَزدادُ حُسْناً وَهْوَ مَنْتَظِمٌ","وَليسَ يَنْقُصُ قَدْراً غيرَ مَنْتَظِمِ",32,"م",1,0],["فَالدينُ في كُلِّ أُفقٍ ضاحِكٌ بَهِجٌ","وَالكُفرُ في كُلِّ أَرضٍ خائِفٌ وَجِلُ",33,"ل",1,0],["فالدرِ في مضحكهِ","والمسكُ في نكهتهِ",34,"ت",2,0],["فَالدَمعُ مُنحَدِرُ النِظا","مِ إِذا تَرَقرَقَ فاضَ غَربُه",35,"ب",2,0],["فَالدينُ قَد خَسَّ حَتّى صارَ أَشرَفُهُ","بازاً لِبازَينِ أَو كَلباً لِكَلّابِ",36,"ب",1,0],["فَالدَهرُ لا يَسخو بِأَريٍ لِلفَتى","حَتّى يَكونَ بِما أَمَرَّ مَزيجا",37,"ج",2,0],["فالدارُ قد ذكَّرني رسمُها","ما كِدتُ عن تَذكارِهِ أَذْهَلُ",38,"ل",1,0],["فالدَّارُ بعدَهمُ كوشمِ يدٍ","يا دارُ فيكِ وفيهمُ العجبُ",39,"ب",1,0],["فالدّارُ داري وحُبّي حاضرٌ ومتى","بدا فمُنْعَرَجُ الجرعاء مُنْعَرَجي",40,"ج",2,0],["فالدّياجي لنا بكَ الآن غُرٌّ","حيثُ أهديتَ لي هُدىً من سَناكا",41,"ك",2,0],["فَالدُّجَى مَضَى","والسَّنَا لَمَحْ",42,"ح",1,0],["فَالدَّاءُ يُنْحِلُ جِسْمَهُ وَنَشَاطُهَا","بِسُطُوعِهِ يُخْفِي نَشَاطَ الدَّاءِ",43,"ا",2,0],["فَالدَّارُ جَذْلَى وَالسَّمَاءُ مُضِيئَةٌ","وَالحَشْدُ يَهْزَجُ وَالنِّظَامُ أَنِيقُ",44,"ق",1,0],["فالدرب في إشراقه جدول","مزغرد في جدول هاتف",45,"ف",1,0],["فالدهر أجمعه لديهما غبطة","والدهر أجمعه لديه حبور",46,"ر",1,0],["فالدهر أجمعه لديهما غبطة","فالدهر أجمعه لديها حبور",47,"ر",1,0],["فالدمع بانهمال","والنار باشتعال",48,"ل",1,0],["فَالدَهرُ مِن تِلكَ المَساوي عاطِلٌ","مُذ ذُدتَهُ وَبِذي المَحاسِنِ حالي",49,"ل",2,0],["فالدهرُ أفقٌ أحمد أصباحه","والخلق جَفنٌ أحمد انسانه",50,"ن",2,0],["فالدهر قد جلب السرور بأحمدٍ","فبدرهه أنا آمن وجليبه",51,"ب",2,0],["فالدهرُ يُسْرِع في عالي أوامرِه","والسعدُ يَتْبَعُه والعزُّ يَحْجُبه",52,"ب",2,0],["فالدهر يخترم الغنى","والموت طوّح بالعشائر",53,"ر",1,0],["فالدينُ موقوفٌ عليكَ رجاؤُهُ","أَنْ يُسْتباحَ الشركُ بالإيمانن",54,"ن",1,0],["فالدر يحسن من يديه نثاره","ويشوقني من لفظ فيه نظامه",55,"م",2,0],["فالدهرُ غَضٌّ نَؤُوم عن حوادِثهِ","كأنّما عاد معنىً مِن معانِيهِ",56,"ي",2,0],["فالدِّينُ غيرُ مهِيض إذ نهضتَ به","وَفَيْلَقُ الجودِ منصورٌ على البَخَلِ",57,"ل",1,0],["فَالدَهرُ لا شُكِرَت مَساعيهِ بِتَأ","خيرِ الفَضائِلِ مُستَهامٌ مُغرَمُ",58,"م",1,0],["فَالدينُ مُذ أَضحى الوَزيرُ مُحَمَّدٌ","عَضُداً لَهُ طَلقُ الأَسِرَّةِ مُؤنِقُ",59,"ق",1,0],["فَالدِّينُ أَصْبَحَ ضَاحِكاً","حُلْوَ الْحُلَى فِي زَيِّ فَوْهَدْ",60,"د",1,0],["فالدينُ مَنصورٌ بِهِ وَمؤَيَّدٌ","وَالشِركُ مَخذولٌ بِهِ مَغلولُ",61,"ل",1,0],["فالداء لا يحسمه نافع","ما لم يكن عالمه النافعا",62,"ع",2,0],["فالدنا مطعما نعيم وبؤس","ولقد ذفتها نعيما وبوسا",63,"س",2,0],["فَالدَّهْرُ يَغْنَمُ مِنْ عَلائِكَ مَفْخَراً","طَوْراً وَيَلْبَسُ مِنْ ثَنائِكَ مِعْرَضا",64,"ض",2,0],["فَالدُرُّ مِن صَدَفٍ وَالوَردُ يَطلُعُ بَي","نَ الشَوكِ وَالنَرجِسُ الرَيّانُ مِن بَصَلِ",65,"ل",1,0],["فَالدَهرُ عَوَّضَني بِال","بازي عَنِ الغِربيبِ",66,"ب",1,0],["فالدار من بعد هذا الدار آخرة","تبقى دواماً بها حشر وميعاد",67,"د",1,0],["فَالدينُ مُقتبلٌ والكفرُ منجفلٌ","والغيُّ منجدلٌ وَالجهلُ منهزمُ",68,"م",1,0],["فَالدَهرُ بِالخَيرِ موفِ","ماضٍ وَآتٍ وَلِأَحدِ",69,"د",1,0],["فالدينُ دين الهوى يسمو بصاحبه","إلى الملائكِ في قُدسِ السماوات",70,"ت",1,0],["فَالدهرُ مِخلافٌ فَخُذ ما أُنجِزا","فَرُبَّما طَلَبتَهُ فَأَعوَزا",71,"ز",2,0],["فالدِّينُ في ظلِّ عُلاهُ حِمىً","يَحوطُ أَدْناهُ وأَقْصاه",72,"ا",2,0],["فالدَّهرُ بعْدَكمُ لَيْلٌ أُلابِسُه","والعَيشُ دُونكمُ هَمٌّ أُقاسيه",73,"ي",2,0],["فالدّهرُ كالقلَمِ الّذي لكَ طاعةً","ما قُلتَ قامَ برأْسهِ لك وامتْثَل",74,"ل",1,0],["فالدّهرُ يَلحَقُ طالعاً بغُروبهِ","أبداً ويُعْقبُ غارباً بطُلوع",75,"ع",1,0],["فالدّهرُ لولا بنوهُ وهو أقبَلَ في","جَيشِ الحوادثِ لم أَشعُرْ به أَبَدا",76,"د",2,0],["فالدِّينُ فوق النَّسْرِ من إعْلائهِ","وعَدُوُّه في بَطْنِه مَلْحود",77,"د",1,0],["فالدَّهرُ يَمضِي ولم يَم","ضِ فيهِ للدَّهرِ حُكمُ",78,"م",1,0],["فالدالُ داري وباءُ البَّر ِيُشْعِلُني","والياءُ يُسْرٌ وَيُمْنٌ أنتِ مَدرستي",79,"ت",2,0],["فالدار بالأصداف يو","جَدُ في البحور الجاريه",80,"ي",2,0],["فالدر إن سُمتَه نظماً ومنتثراً","يزيد حسناً بجيد الحاسر العُطُل",81,"ل",1,0],["فالدهرُ ينثُرُنا فُرادى مثلما","مرُّ الحواصِب يَنثُرُ الحَصباءَ",82,"ا",2,0],["فَالدَمع لِلعُشاق مِن","أَلَم الصَبابة مُفزع",83,"ع",1,0],["فَالدَمع فَوقَ خُدودِهِ","يَجري وَنار الشَوق في",84,"ف",2,0],["فَالدَمع مني في إِنهِما","لٍ وَالجَوانح في اِشتِعالِ",85,"ل",1,0],["فَالدَمع وَردي دائِماً","وَالجَمر لِي أَبَداً مهاد",86,"د",1,0],["فالدفو يفتقه اللبيب بسرعة","ويعود بالخلل الذي رتقوه",87,"و",2,0],["فالدين ليس له راع ولست ترى","من الخلائق إلا من يخالفه",88,"ف",2,0],["فالدعا مُخُّ العبادات كما","جاءنا نصٌّ بهذا في الخبر",89,"ر",1,0],["فَالدَهر كَالطَيف يؤساهُ وَأنعمه","عَن غير قَصدٍ فَلا تَمدح وَلا تَلُمِ",90,"م",1,0],["فالدهر يَخدَع بِالمني وَيغُصُّ إِن","هَنّا وَيَهدِمُ ما بَنى بِبوارِ",91,"ر",1,0],["فالدهر كالميزان ما","ينفك من رفع ومن خفض",92,"ض",1,0],["فالدهرُ يُرهِقُ عُسراً","ويُتبِعُ العُسرَ يُسرا",93,"ر",2,0],["فالدهر خصم