امل"],[434,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[436,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[436,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[438,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[438,"من لائمي إن سفحت الدمع من مقلي","https://www.aldiwan.net/poem14476.html","البسيط"],[456,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[459,"ويحل منه نديه","https://www.aldiwan.net/poem15377.html","مجزوء الكامل"],[462,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[462,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[462,"ومواقف بالنيربين شهدتها","https://www.aldiwan.net/poem3379.html","عموديه"],[462,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[462,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[462,"ديار هند أقفرت منذ أزمان","https://www.aldiwan.net/poem3492.html","عموديه"],[466,"أرض إله السماء عنك بما","https://www.aldiwan.net/poem59911.html","المنسرح"],[477,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[480,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[493,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[512,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[536,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[565,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[565,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"],[565,"برزت وأتراب لها عرب","https://www.aldiwan.net/poem69683.html","الكامل"],[573,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[573,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[583,"لا تلق دهرك بالعتاب","https://www.aldiwan.net/poem1570.html",""],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[584,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["فالدَّهْرُ مُنتَظِرٌ أمْراً تُشيرُ بهِ","فمُرْ بما يَقْتَضيهِ الرَّأيُ يَمْتَثِلِ",0,"ل",1,0],["فَالدَّهْرُ قدْ شَبَّ بِهِ","وَكَانَ يَشْكُو الْهَرَمَا",1,"م",2,0],["فَالدَهرُ غَيَّرَ ذاكَ يا اِبنَةَ مالِكٍ","وَالدَهرُ يُعقِبُ صالِحاً بِفَسادِ",2,"د",1,0],["فَالدَهرُ مُعتَرِفٌ بِأَنّا لَم نَكُن","لِنُسَرَّ مِنهُ بِساعَةٍ لَولاكا",3,"ك",2,0],["فَالدَّارُ مِنْ لُطْفِ الضِّيَافَةِ دَارُهُ","وَوَلِيُّهَا المَخْدُومُ شِبْهُ الخَادِمِ",4,"م",1,0],["فالدمع من عيني إذا وكفا","جلل وإن أرسلته دفعا",5,"ع",2,0],["فَالدَهرُ أَقصَرُ مُدَّةً مِمّا تَرى","وَعَساكَ أَن تُكفى الَّذي تَخشاهُ",6,"ه",1,0],["فالدهر لونٌ واحدٌ عنده","طرًّا وعند الناس ألوانه",7,"ن",2,0],["فالدهرُ لا تنقضي عجائبُهُ","أو يتقضَّى من أهله أرَبُهْ",8,"ب",2,0],["فالدهر إن جرت يوماً","يديل منك وينصفْ",9,"ف",1,0],["فَالدَهرُ أَجمَعَهُ لَدَيها غِبطَةٌ","وَالدَهرُ أَجمَعَهُ لَدَيهِ حُبورُ",10,"ر",1,0],["فَالدَفينُ الَّذي هُناكَ يُقيمُ","بَطَلٌ مُصلِحٌ وَروحٌ كَريمُ",11,"م",1,0],["فالدَّهْرُ مُنْتَعِلٌ بالنَّارِ مُلْتَحِفٌ","بالهوْلِ والويلِ والأَيامُ تَشْتَعِلُ",12,"ل",1,0],["فالدهرُ شيء بارِدٌ","ما لَم تُسخنه بَراحِ",13,"ح",1,0],["فالدهرُ ليس ينامُ عن","كَ وأنتَ عنهُ في منَامِ",14,"م",1,0],["فالدُّرُ وهو أجلُّ شَيءٍ يُقْتَنَى","ما حَطَّ قيمتَهُ هوانُ الغائصِ",15,"ص",1,0],["فَالدَهرَ يَعقِرُ بِالقَوافي أَهلُها","في العَرضِ مِن آلائِهِ وَالطولِ",16,"ل",1,0],["فَالدَهرُ يَلقاني لِسَيبِكَ شاكِراً","إِذ كُنتُ لا أَلقاكَ إِلّا مُنعِما",17,"م",2,0],["فالدين قد شمخت ذرا أركانه","والكفر قد أودى ذرا وقواعدا",18,"د",2,0],["فالدهرُ يمسَحُ منه غُرَّةَ سابقٍ","لاقاه أَوَّلَ سَابقِينَ أوائلِ",19,"ل",1,0],["فالدَّهْرُ ليسَ يَفوتُ رك","ضُ خُطوبِه رَكضَ الفَوارِس",20,"س",1,0],["فَالدِّعْصُ والغُصنُ في غَلائِلِه","والليلُ والصبحُ فوقَ أزرارِ",21,"ر",1,0],["فالدَّهرُ يعجَبُ منه لَمَّا مسَّه","بِجَهنَّمَ الصُّغرى فلم يَتفطَّرِ",22,"ر",1,0],["فَالدائِراتُ بِرَيبِ الدَهرِ دائِرَةٌ","وَالمَرءُ عَن نَفسِهِ ما عاشَ مَختولُ",23,"ل",1,0],["فَالدَهرُ مِن زَلّاتِهِ قَد اِعتَذَر","وَجاءَنا مِنَ الذُنوبِ تائِبا",24,"ب",2,0],["فَالدَهرُ يُقسِمُ أَنَّهُ مِن رِقِّهِ","وَالمَوتُ يَحلِفُ أَنَّهُ مِن جُندِهِ",25,"د",2,0],["فالدِّينُ معتَمدٌ مِنهُ على مَلكٍ","يُمسي ويُضحي على الرّحمنِ مُعتَمِدا",26,"د",2,0],["فالدِّمْنُ فيه لنبتِ الأرض مَصْلَحَةٌ","ولو خلطتَ به الكافورَ أفْسَدَهُ",27,"ه",1,0],["فَالدَّهْرُ كَالدُّولابِ يَخْفِضُ عَالِياً","مِنْ غَيْرِ مَا قَصْدٍ وَيَرْفَعُ سَافِلا",28,"ل",2,0],["فالدارُ غيرُ الدارِ بعدَ رحيلِكم","والناسُ واحرباهُ غيرُ الناسِ",29,"س",1,0],["فَالدَمعُ فيكَ مَعَ النَهارِ خَصيمُهُ","وَالسُهدُ فيكَ مَعَ الكَلامِ رَقيبُهُ",30,"ب",2,0],["فَالدَمعُ مِنّي وَاكِفٌ سَرِبٌ","كَالغَربِ يُنزَعُ دائِمَ الوَكفِ",31,"ف",1,0],["فالدُّرُّ يَزدادُ حُسْناً وَهْوَ مَنْتَظِمٌ","وَليسَ يَنْقُصُ قَدْراً غيرَ مَنْتَظِمِ",32,"م",1,0],["فَالدينُ في كُلِّ أُفقٍ ضاحِكٌ بَهِجٌ","وَالكُفرُ في كُلِّ أَرضٍ خائِفٌ وَجِلُ",33,"ل",1,0],["فالدرِ في مضحكهِ","والمسكُ في نكهتهِ",34,"ت",2,0],["فَالدَمعُ مُنحَدِرُ النِظا","مِ إِذا تَرَقرَقَ فاضَ غَربُه",35,"ب",2,0],["فَالدينُ قَد خَسَّ حَتّى صارَ أَشرَفُهُ","بازاً لِبازَينِ أَو كَلباً لِكَلّابِ",36,"ب",1,0],["فَالدَهرُ لا يَسخو بِأَريٍ لِلفَتى","حَتّى يَكونَ بِما أَمَرَّ مَزيجا",37,"ج",2,0],["فالدارُ قد ذكَّرني رسمُها","ما كِدتُ عن تَذكارِهِ أَذْهَلُ",38,"ل",1,0],["فالدَّارُ بعدَهمُ كوشمِ يدٍ","يا دارُ فيكِ وفيهمُ العجبُ",39,"ب",1,0],["فالدّارُ داري وحُبّي حاضرٌ ومتى","بدا فمُنْعَرَجُ الجرعاء مُنْعَرَجي",40,"ج",2,0],["فالدّياجي لنا بكَ الآن غُرٌّ","حيثُ أهديتَ لي هُدىً من سَناكا",41,"ك",2,0],["فَالدُّجَى مَضَى","والسَّنَا لَمَحْ",42,"ح",1,0],["فَالدَّاءُ يُنْحِلُ جِسْمَهُ وَنَشَاطُهَا","بِسُطُوعِهِ يُخْفِي نَشَاطَ الدَّاءِ",43,"ا",2,0],["فَالدَّارُ جَذْلَى وَالسَّمَاءُ مُضِيئَةٌ","وَالحَشْدُ يَهْزَجُ وَالنِّظَامُ أَنِيقُ",44,"ق",1,0],["فالدمع بانهمال","والنار باشتعال",45,"ل",1,0],["فَالدَهرُ مِن تِلكَ المَساوي عاطِلٌ","مُذ ذُدتَهُ وَبِذي المَحاسِنِ حالي",46,"ل",2,0],["فالدهرُ أفقٌ أحمد أصباحه","والخلق جَفنٌ أحمد انسانه",47,"ن",2,0],["فالدهر قد جلب السرور بأحمدٍ","فبدرهه أنا آمن وجليبه",48,"ب",2,0],["فالدهرُ يُسْرِع في عالي أوامرِه","والسعدُ يَتْبَعُه والعزُّ يَحْجُبه",49,"ب",2,0],["فالدهر يخترم الغنى","والموت طوّح بالعشائر",50,"ر",1,0],["فالدينُ موقوفٌ عليكَ رجاؤُهُ","أَنْ يُسْتباحَ الشركُ بالإيمانن",51,"ن",1,0],["فالدر يحسن من يديه نثاره","ويشوقني من لفظ فيه نظامه",52,"م",2,0],["فالدهرُ غَضٌّ نَؤُوم عن حوادِثهِ","كأنّما عاد معنىً مِن معانِيهِ",53,"ي",2,0],["فالدِّينُ غيرُ مهِيض إذ نهضتَ به","وَفَيْلَقُ الجودِ منصورٌ على البَخَلِ",54,"ل",1,0],["فَالدَهرُ لا شُكِرَت مَساعيهِ بِتَأ","خيرِ الفَضائِلِ مُستَهامٌ مُغرَمُ",55,"م",1,0],["فَالدينُ مُذ أَضحى الوَزيرُ مُحَمَّدٌ","عَضُداً لَهُ طَلقُ الأَسِرَّةِ مُؤنِقُ",56,"ق",1,0],["فَالدِّينُ أَصْبَحَ ضَاحِكاً","حُلْوَ الْحُلَى فِي زَيِّ فَوْهَدْ",57,"د",1,0],["فالدينُ مَنصورٌ بِهِ وَمؤَيَّدٌ","وَالشِركُ مَخذولٌ بِهِ مَغلولُ",58,"ل",1,0],["فالداء لا يحسمه نافع","ما لم يكن عالمه النافعا",59,"ع",2,0],["فالدنا مطعما نعيم وبؤس","ولقد ذفتها نعيما وبوسا",60,"س",2,0],["فَالدَّهْرُ يَغْنَمُ مِنْ عَلائِكَ مَفْخَراً","طَوْراً وَيَلْبَسُ مِنْ ثَنائِكَ مِعْرَضا",61,"ض",2,0],["فَالدُرُّ مِن صَدَفٍ وَالوَردُ يَطلُعُ بَي","نَ الشَوكِ وَالنَرجِسُ الرَيّانُ مِن بَصَلِ",62,"ل",1,0],["فَالدَهرُ عَوَّضَني بِال","بازي عَنِ الغِربيبِ",63,"ب",1,0],["فالدار من بعد هذا الدار آخرة","تبقى دواماً بها حشر وميعاد",64,"د",1,0],["فَالدينُ مُقتبلٌ والكفرُ منجفلٌ","والغيُّ منجدلٌ وَالجهلُ منهزمُ",65,"م",1,0],["فَالدَهرُ بِالخَيرِ موفِ","ماضٍ وَآتٍ وَلِأَحدِ",66,"د",1,0],["فالدينُ دين الهوى يسمو بصاحبه","إلى الملائكِ في قُدسِ السماوات",67,"ت",1,0],["فَالدهرُ مِخلافٌ فَخُذ ما أُنجِزا","فَرُبَّما طَلَبتَهُ فَأَعوَزا",68,"ز",2,0],["فالدِّينُ في ظلِّ عُلاهُ حِمىً","يَحوطُ أَدْناهُ وأَقْصاه",69,"ا",2,0],["فالدَّهرُ بعْدَكمُ لَيْلٌ أُلابِسُه","والعَيشُ دُونكمُ هَمٌّ أُقاسيه",70,"ي",2,0],["فالدّهرُ كالقلَمِ الّذي لكَ طاعةً","ما قُلتَ قامَ برأْسهِ لك وامتْثَل",71,"ل",1,0],["فالدّهرُ يَلحَقُ طالعاً بغُروبهِ","أبداً ويُعْقبُ غارباً بطُلوع",72,"ع",1,0],["فالدّهرُ لولا بنوهُ وهو أقبَلَ في","جَيشِ الحوادثِ لم أَشعُرْ به أَبَدا",73,"د",2,0],["فالدِّينُ فوق النَّسْرِ من إعْلائهِ","وعَدُوُّه في بَطْنِه مَلْحود",74,"د",1,0],["فالدَّهرُ يَمضِي ولم يَم","ضِ فيهِ للدَّهرِ حُكمُ",75,"م",1,0],["فالدار بالأصداف يو","جَدُ في البحور الجاريه",76,"ي",2,0],["فالدر إن سُمتَه نظماً ومنتثراً","يزيد حسناً بجيد الحاسر العُطُل",77,"ل",1,0],["فالدهرُ ينثُرُنا فُرادى مثلما","مرُّ الحواصِب يَنثُرُ الحَصباءَ",78,"ا",2,0],["فَالدَمع لِلعُشاق مِن","أَلَم الصَبابة مُفزع",79,"ع",1,0],["فَالدَمع فَوقَ خُدودِهِ","يَجري وَنار الشَوق في",80,"ي",1,0],["فَالدَمع مني في إِنهِما","لٍ وَالجَوانح في اِشتِعالِ",81,"ل",1,0],["فَالدَمع وَردي دائِماً","وَالجَمر لِي أَبَداً مهاد",82,"د",1,0],["فالدفو يفتقه اللبيب بسرعة","ويعود بالخلل الذي رتقوه",83,"و",2,0],["فالدين ليس له راع ولست ترى","من الخلائق إلا من يخالفه",84,"ف",2,0],["فالدعا مُخُّ العبادات كما","جاءنا نصٌّ بهذا في الخبر",85,"ر",1,0],["فَالدَهر كَالطَيف يؤساهُ وَأنعمه","عَن غير قَصدٍ فَلا تَمدح وَلا تَلُمِ",86,"م",1,0],["فالدهر يَخدَع بِالمني وَيغُصُّ إِن","هَنّا وَيَهدِمُ ما بَنى بِبوارِ",87,"ر",1,0],["فالدهر كالميزان ما","ينفك من رفع ومن خفض",88,"ض",1,0],["فالدهرُ يُرهِقُ عُسراً","ويُتبِعُ العُسرَ يُسرا",89,"ر",2,0],["فالدهر خصم إن بدا أطراقه","وإذا الزمان تراجعت أخلاقه",90,"ه",1,0],["فالدلف يمنعنا طيب المنام إذا","من فوقنا حل بالأوجاه وانحدرا",91,"ر",2,0],["فالدّهرُ بين فِرندِه وفريدِه","متقلّدٌ بنِجادِه ووشاحِه",92,"ح",2,0],["فالدوحُ يسحَبُ حُلّةً من سُنْدسٍ","تُزْهى بلؤلؤِ طلِّها المنثور",93,"ر",1,0],["فالدالُ قبل الميمِ من","وجدانِ صافي الودِ أعدَمْ",94,"م",1,0],["فالدهرُ يعلمُ أنّك الكُحْلُ الذي","خلعَ الجمالَ به على إنسانِه",95,"ن",2,0],["فالدير يرقصُ بين جِدِّ","هوًى تبرقَع في مُجونِهْ",96,"ن",2,0],["فالدهر يهنأه بقاؤك والورى","ما عشت في سنن المعالي المهبع",97,"ع",1,0],["فالدمع طليق منذ نأي","ت وقلبي عن