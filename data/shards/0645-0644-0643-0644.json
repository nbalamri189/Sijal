],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94584","الكامل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67676","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81703","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73090","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120475","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139787",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4679,"في ظل عبد الحميد الكون قد ذهبت","https://www.poetsgate.com/ViewPoem.aspx?id=142761",""],[2052,"بالظاهر الملك الميمون طائره","https://www.poetsgate.com/ViewPoem.aspx?id=189619",""],[4119,"هذا الذي ولدت له الأفكار","https://www.poetsgate.com/ViewPoem.aspx?id=16139",""],[3591,"إشتقت الأيام أن تبتسّما","https://www.poetsgate.com/ViewPoem.aspx?id=149453",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5582,"( نَفْسُ ) المُتَيَّمِ فِي الصَّبابَةِ شانُها","https://www.poetsgate.com/ViewPoem.aspx?id=63591",""],[5720,"رحلَ المليكُ (*)","https://www.poetsgate.com/ViewPoem.aspx?id=203028",""]],"verses":[["مَلِكٌ لِلشَرقِ في أَيّامِهِ","هِمَّةُ الغَربِ نُهوضاً وَاِعتِزاما",0,"م",2,0],["مَلِكٌ لَهُ يَومَ الهياجِ مَواقِفٌ","مَشهورَةٌ لا يَدعيها مُدَّعي",1,"ع",2,0],["مَلِكٌ لَذَّ جَنى العَيشِ بِهِ","حَيثُ وِردُ الأَمنِ لِلصادي عَلَل",2,"ل",1,0],["ملكٌ ليمناه عوائدُ أنعُمٍ","ألفتْ نحاةُ الجود فيضَ صِلاتها",3,"ت",3,0],["ملك لهاهُ عن الآمال قد فصحت","وراحتاه عن الأيام قد صفحت",4,"ت",1,0],["ملكٌ له في ظلال العزِّ منزلةٌ","ترنو إليه نجوم الفلك من صعد",5,"د",1,0],["ملكٌ له في الوغى والسلم بسط يد","مأثورة الفضل إن صالت وإن وصلت",6,"ت",1,0],["ملك لولا حماه الرحب ما","جلب الشعر بأغلى ثمن",7,"ن",1,0],["ملك له قبل السؤال وبعده","بدء الجوادِ وعودة المِسماحِ",8,"ح",1,0],["ملك له هِممٌ تُنيف على العلا","ويدٌ تطول مواقع الأقدارِ",9,"ر",1,0],["ملك له فطن دقاقٌ في العلا","تركته والأخلاق غير دقاق",10,"ق",1,0],["مَلِكٌ لا يرى اللُّهى","تستحقُّ الوسائلا",11,"ل",2,0],["مَلِكٌ لَم يُغضِ عَن سَيِّئَةٍ","يا لَهُ مِن مَلَكٍ يَهوى السِبابا",12,"ب",2,0],["مَلِكٌ لَهُ في كُلِّ يَومِ كَريهَةٍ","إِقدامُ غِرٍّ وَاِعتِزامُ مُجَرِّبِ",13,"ب",1,0],["مَلِكٌ لِما مَلَكَت يَداهُ مُفَرِّقٌ","جُمِعَت أَداةُ المَجدِ فيهِ جَميعا",14,"ع",2,0],["مَلِكٌ لَهُ ظَهرُ الفَضاءِ وَبَطنُهُ","لَم تُبلِ جِدَّةَ مُلكِهِ الأَزمانُ",15,"ن",1,0],["مَلكٌ لَوَ اَنَّ يَدَ الأَقدارِ تُنصِفُهُ","لَما أَحَلَّتهُ إِلّا ذُروَةَ الفَلَكِ",16,"ك",1,0],["مَلكٌ لِرِزقِ الأَنامِ قَد كَفَلا","فَصارَ في الناسِ جودُهُ مَثَلا",17,"ل",2,0],["مَلكٌ لَوَ اَنَّ البِحارَ تُشبِهُهُ","لَأَصبَحَ البَحرُ باذِلاً سُفُنَه",18,"ن",2,0],["مَلِكٌ لَدَيهِ مَواهِبٌ وَمَكارِمٌ","هِيَ لِلعُداةِ مَواهِنٌ وَمَكايِدُ",19,"د",1,0],["مَلكٌ لِنصر اللَّه سَلَّ مجاهداً","عَضْباً تَوَقّدَ بالمتونِ وسالا",20,"ل",2,0],["مَلِكٌ له اللُّبُّ الصّقيلُ كأنّما","عكست شعاعَ الشمس فيه سجنجَل",21,"ل",1,0],["مَلِكٌ لِما تَبني يَداهُ شائِدٌ","وَلِما بَناهُ أَوَّلوهُ مُشيدُ",22,"د",1,0],["ملك له طعمان لل","فئة المحبة والعنيده",23,"د",2,0],["ملكٌ لديه الموتُ يخشي والبقا","يُرجى فأمن من سطاه وخوّفا",24,"ف",2,0],["مَلِكٌ لَيسَ في المُلوكِ لَهُ ثا","نٍ وَإِن قيلَ وائِلٌ في إِيادِ",25,"د",1,0],["مَلِكٌ لا يَعُدُّ مالاً سِوى ما","حازَ أَجراً بِهِ وَأَودى مُعادِ",25,"د",1,0],["مَلكٌ لوِ اقتدتِ البحارُ بجودِه","لم يَنْجُ من تيارِهنَّ سَفين",26,"ن",1,0],["مَلك لم يدع من العزّ والمج","د لمَلْك من الأنام نصيبا",27,"ب",2,0],["مَلِكٌ لَهُ عَدلٌ وَجودٌ يَعدَمُ ال","مَظلومُ في يَوميهِما وَالمُعدِمُ",28,"م",1,0],["ملكٌ لو لم يكن من ملكه","غير دارٍ وشحت بالنعمِ",29,"م",1,1],["مَلكٌ لَهُ جُنود","مِن طَرفِهِ الكَحيل",30,"ل",1,0],["مَلِكٌ لَمْ تَألُ إيَالَتُهُ","نَظَراً لِلْمُلكِ يُمَهّدُهُ",31,"د",2,0],["مَلكٌ لَدى الحَربِ تَستَخذي المُلوكُ لَهُ","ذُلاً وَفي السِلمِ تَستَجدي أَياديهِ",32,"ي",2,0],["مَلِكٌ لَم تَزَل أَياديهِ بيضاً","فاتكاتٍ بِالنائِباتِ السودِ",33,"د",1,0],["مَلكٌ لِصارِمِهِ وَالرُمحِ في ثَغرِ ال","أَعداءِ بِالثَغرِ ضَرباتٌ وَطَعناتُ",34,"ت",1,0],["ملكٍ لَهُ كرمٌ أبى إيثارهُ","لِنعيمِ ملكٍ عَن هنا الأوطانِ",35,"ن",1,0],["ملك لَهُ حسن السُلوك","أَضحى لجيد الدَهر عقدا",36,"د",2,0],["مَلكٌ للربيعِ ذو رايةٍ خَضْ","راءَ ما كَعَّ من دون لُقْياكَ كعّه",37,"ع",2,0],["ملك لذاك قريضه","ملك القريض بكل حكم",38,"م",1,0],["ملكٌ لَهُ في كُلِّ أَرضٍ نِعمَةً","وَبِكُلِّ مُعتَرِكٍ ثَناء يُؤثَرُ",39,"ر",1,0],["ملك له مِنَنٌ تَمَلَّكَني بِها","وَبِمِثلِها يُتَمَلَّكُ الأَحرارُ",40,"ر",1,0],["ملكٌ لو انّ اللهَ قدّم عصرَهُ","لأتى به القرآنُ في آياتِه",41,"ت",2,0],["ملك لو لم يكن","بلوري كان ملك",42,"ك",1,0],["ملك له العلياء يت شادهُ","ربّ السماء وما بني لا ينقل",43,"ل",1,0],["ملك لو أردت حصر معالي","ه لكلّت عن ذلك الأقلام",44,"م",1,0],["ملك لا ترى له في الورى شب","ها وتلقى لغيره نظراء",45,"ا",2,0],["ملك له بأسُ من لا يرتجى أبداً","وجود من كفّه توفي على السحُبِ",46,"ب",1,0],["ملك لأحكام القضاء مقدّر","في الحالتين النقض والإبرام",47,"م",1,0],["ملك له عزمة ذل الزمان لها","وجيش جاش يريك الناس في رجل",48,"ل",1,0],["مَلِكٌ لوِ استَوهَبْتَ حَبَّةَ قَلْبِهِ","كَرماً لجادَ بها ولَمْ يَتَعَذَّرِ",49,"ر",1,0],["ملك لديه كل ذي","حزم وزعزم بات صاغر",50,"ر",1,0],["ملكٌ ليس عرضهُ بحلالٍ","لا ولا بيت مالهِ بحرامِ",51,"م",1,0],["ملكٌ لو أن َّ الماءَ شيبَ ببأسهِ","حالتْ عذوبتهُ هناك فأبحرا",52,"ر",2,0],["مَلِكٌ له من وجهِ عيدِه طَلعَة","ولِعيدِه منه المَقامُ السَّامي",53,"م",2,0],["ملِكٌ لدولتهِ العظيمةِ هيبةٌ","تهتزُّ منها الأرضُ وهيَ تَميدُ",54,"د",1,0],["مَلكٌ له البَيْض تِيجَانٌ وما بَرحَت","له السوابغُ في يَومِ الْوَغَى حُلَلا",55,"ل",2,0],["ملكٌ لم يزَلْ يُجيرُ من الده","رِ وأَحداثِه الَّتي لاَ تُجارَى",56,"ر",2,0],["مَلِكٌ له الأَمْلاكُ تد","خُل سُجَّداً مِنْ كُلِّ بَاب",57,"ب",1,0],["مَلِكٌ لا يُجارُ مِنهُ ولا يَخ","شَى سِوى اللهِ وحدَه جارُجاره",58,"ر",2,0],["مَلكٌ لَهُ شَرَفٌ عَلى ال","عليا فَحَدِّث عَنهُ قِدما",59,"م",2,0],["مَلْكٌ له العِزُّ من ذاتٍ ومن سَلَفٍ","فَحَسْبُ كلِّ الملوكِ الهُوْنُ والجَزَأُ",60,"ا",1,0],["مَلِكٌ لولا عنايتُهُ","لم يَكُن جودٌ له أَثَرُ",61,"ر",1,0],["ملْك له فتيات المجد خاضعةٌ","خضوعُ مُكتئبٍ صبٍّ لمعشوق",62,"ق",1,0],["مَلكٌ لَهُ جفون","تسطو على اللبيب",63,"ب",1,0],["مَلِكٌ لَيسَ كالمُلوكِ وَلَكِن","مَلِكٌ عِندَهُ المُلُوكُ عَبيدُ",64,"د",1,0],["ملك له عزم يفل","ل بعزمه غرب الصفاحِ",65,"ح",1,0],["ملك لهف ي وصف كل وغى","إقدام حيدر يوم صفّينِ",66,"ن",1,0],["ملك له في ليل كل ملمة","ليلاء عزم كالشهاب الثاقبِ",67,"ب",1,0],["مَلِكٌ لآذَتِ الوَرَى مِنْ عُلاَهُ","بِوَحِيدٍ مِنَ المُلُوكِ فَرِيدِ",68,"د",1,0],["ملكٌ لَهُ هِمَمٌ تَرَفَّعَ قدرُهَا","عَنْ هِمَّةِ النعمانِ والإسكندرِ",69,"ر",1,0],["مَلِكٌ لِمَا مَلَكَتْ يَدَاهُ مُفَرّقٌ","يُرْضِيكَ مِنْهُ الأخْذُ وَالإعْطَاءُ",70,"ا",2,0],["ملكٌ ليس يسامي","هِ علا ذو الجنّتينِ",71,"ن",1,0],["ملكٌ له تَصبو الملوك مهابةً","وتخرُّ فوقَ بساطها أذقانُها",72,"ن",3,0],["ملكٌ لهُ شرفٌ علَت وتصعّدت","دَرَجاتهُ مِن فوقِ نجم الفرقدِ",73,"د",1,0],["ملكٌ لَيسَ لهُ في","رُتبةِ العَليا مُشارِك",74,"ك",1,0],["مَلِكٌ لا يَزالَ يَحفِرُ للما","لِ ذِماماً ويَغْفِرُ الإِجْراما",75,"م",2,0],["مَلْكٌ لهُ في البَرايا","مناقِبٌ ليسَ تُجْحَدْ",76,"د",1,0],["مَلْكٌ لَهُ في النَّدى خُلْقٌ يَفوقُ بِهِ","مَنْ بَعْدَهُ مِثْلَما قدْ فاقَ مَنْ قَبْلَهْ",77,"ل",2,0],["مَلِكُ لِما يَملِكُ مِنْ مالِهِ","مُعْطٍ وللعلياء أَخّاذُ",78,"ذ",1,0],["مَلِكٌ لَم يَجعَل اللَ","هُ لَهُ فيهِم عَديلا",79,"ل",2,0],["مَلِكٌ لَهُ خَضَعَتْ تَبَابِعُ حِمْيَرٍ","وَبنُو الأَعَاظِمِ مِنْ قَبَائِلِ مَذْحِجِ",80,"ج",1,0],["ملِكٌ للدِّين منه ناصرٌ","هوأوفى الناسِ عهداً وذِماما",81,"م",2,0],["ملِكٌ لم يبدُ إلاّ عاينت","عينُ مَن يبدُو له البدرَ التَِّماما",81,"م",2,0],["ملكٌ له الأملاكُ سعداً لم تزل","أبداً تدورُ على الورى بدوائرِ",82,"ر",1,0],["مَلِكٌ لَوَ اَنَّ الراسِياتِ بِحِلمِهِ","وُزِنَت شَوامِخُها إِذاً لا شالَها",83,"ل",3,0],["مَلِكٌ لا يَزالُ أَوَّل مَعدو","دٍ إِذا ما اِبتُدي بِعَدِّ الكِرامِ",84,"م",1,0],["ملكٌ له الشرف الرفيع مشيَّعُ","وعليه حتَّى المكرمات نوائح",85,"ح",1,0],["مَلكٌ لَهُ الرَأيَ وَالراياتِ عالِيَةٌ","يَومَ الطِرادِ عَلى العَسّالَةِ الذُبُلِ",86,"ل",1,0],["مَلِكٌ لَم تَزَل ثِيابُ عِداهُ","في حِدادٍ وَثَوبُهُ مِن حَديدِ",87,"د",1,0],["ملِك لقِيت به الزمان مسالِماً","والعيشَ عَذْباً نَيِّرَ الإِشراقِ",88,"ق",1,0],["مَلِكٌ لَه عَنَتِ الوُجوهُ تَخَشُّعاً","يَقضى وَلا يُقضى عَلَيهِ وَيُعبَدُ",89,"د",1,0],["ملك لا ترى العوالم شيئاً","غير أثاره التي أبداها",90,"ا",3,0],["مَلْكٌ لأيَّامِ الشَّبابِ مَحَاسِنٌ","وَإذا تُعَدُّ فَلَهوَ مِنْهَا الرَّيِّقُ",91,"ق",1,0],["مَلِكٌ لو أن الغيثَ جاد كجُوده","لم يُلْفَ في أَرضٍ لفقرٍ شاك",92,"ك",1,0],["ملِكٌ لو استسقى الزَّمانُ بجُودِه","أَغناه عن سُقيا، مُلِثِّ سَحابِه",93,"ب",2,0],["ملك لعز فخاره وجلاله","زهر الصفات النيرات شهود",94,"د",1,0],["ملكٌ لهيْبَتِهِ صوارمُه له","أبداً محاولةُ المعالي تحرثُ",95,"ث",1,0],["ملكٌ لهيبةِ عرشه سجدتْ له","تحتَ السيوفِ جماجمُ الأَمْلاكِ",96,"ك",1,0],["ملك لو ان اللَه لم يخلقه ما","آمنت بالإعجاز في إغرابه",97,"ب",2,0],["مَلِكٌ لَو كانَ في عَصرٍ مَضى","لَم يَكُن في غَيرِهِ لِلنّاسِ مَدحُ",98,"ح",1,0],["ملك لو برأيه طاعنت عبس","لما استعصمت بني ذبيان",99,"ن",1,0],["ملك لو يكون في عصر لقم","ان سما حكمه على لقمان",99,"ن",1,0],["ملك له المجد الذي أسسه","من سمك الأفق على كيوانه",100,"ه",1,0],["ملك له الغزوات ليس بِمُنْكَرٍ","ذلّ الصليب بها وعزّ المصحف",101,"ف",1,0],["ملك له طود مجد للملوك علا","إذا هم خيموا في سفح هضبته",102,"ت",2,0],["ملك لا يُغِبُّ سمرَ قناه","من طعان وخيلَه من طراد",103,"د",1,0],["ملك لا الندى عن الوفد في نادي","ه ولا الخطوب تنوبُ",104,"ب",1,0],["ملك له عنت الليالي خضعا","والنصر أصبح في حماه محدقا",105,"ق",2,0],["ملك لأبواب السعادة فاتح","ونواله لأولى المكارم خاتم",106,"م",1,0],["مُلكٌ لي العالم إن ضقت في","أهليه أخرجْهم من العالم",107,"م",1,0],["ملك لأَرباب الكَمال فَكلهم","لِنَتيجة القَوم الكِرام عَبيد",108,"د",1,0],["ملكٌ لهُ راحةٌ إذا انبسطت","فزاخرُ البحر عندها جزر",109,"ر",1,0],["ملكٌ لهُ ذهنٌ وصدقُ فراسة","تستخرجُ الأمر الخفيّ المبهما",110,"م",2,0],["ملكٌ لو درت عُلاهُ الدّراري","قبّلت كلّما بدت أقدامه",111,"م",2,