px?id=180417",""],[4755,"حَجْر الله\" الصحي","https://www.poetsgate.com/ViewPoem.aspx?id=211332",""],[4791,"دموع الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=35898",""],[4866,"بعض المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=215921",""],[4919,"انطرني يا قمر يوم العيد","https://www.poetsgate.com/ViewPoem.aspx?id=34725",""],[4978,"أنا فقير","https://www.poetsgate.com/ViewPoem.aspx?id=177455",""],[5072,"نسائم الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=53934",""],[5281,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199224",""],[5452,"قلب بدون عشيق","https://www.poetsgate.com/ViewPoem.aspx?id=119012",""],[5459,"حروف ثائرة","https://www.poetsgate.com/ViewPoem.aspx?id=197607",""],[5463,"بعد موت الأماني ...!","https://www.poetsgate.com/ViewPoem.aspx?id=35844",""],[5511,"خطاب لن يصل","https://www.poetsgate.com/ViewPoem.aspx?id=151403",""],[5525,"كثرة عذاريبي","https://www.poetsgate.com/ViewPoem.aspx?id=7208",""],[5525,"القاع والمسافة","https://www.poetsgate.com/ViewPoem.aspx?id=7214",""],[5525,"ما لي على الحب سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=7263",""],[5648,"انا احترم بالخلا ماطاك","https://www.poetsgate.com/ViewPoem.aspx?id=164274",""],[5674,"حكاية شوق","https://www.poetsgate.com/ViewPoem.aspx?id=195128",""],[5732,"جرت دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=177902",""],[5736,"أرواح","https://www.poetsgate.com/ViewPoem.aspx?id=208398",""],[5751,"عاشق الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=215010",""],[5784,"كنت أظن الحب تسلية.....","https://www.poetsgate.com/ViewPoem.aspx?id=190616",""],[5848,"ياموت","https://www.poetsgate.com/ViewPoem.aspx?id=53382",""],[5875,"صراخ المهابيل","https://www.poetsgate.com/ViewPoem.aspx?id=211769",""],[5912,"شام الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=205018",""],[5956,"نوع احتياجي","https://www.poetsgate.com/ViewPoem.aspx?id=181892",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[5956,"أنا الكهلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207213",""],[5956,"رحلتْ إلى الرحمن زوجة عبد الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=215612",""],[5957,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=37426",""],[5970,"كيف تشكو وفؤادي ما شكا","https://www.poetsgate.com/ViewPoem.aspx?id=130650",""],[6152,"احفظي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203115",""],[1583,"أتنسى؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73017&r=&rc=8",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""]],"verses":[["أنا أحبك فوق الغيم أكتبه","وللعصافير والأشجار أحكيها",0,"ي",3,0],["أنا أحبك فوق الماء أنقشه","وللعناقيد والأقداح أسقيها",0,"ي",3,0],["أنا أحبك يا سيفا أسال دمي","يا قصة لست أدري ما أسميها",0,"ي",3,0],["أنا أحبك حاول أن تساعدني","فإن من بدأ المأساة ينهيها",0,"ي",3,0],["أنا أحببتُ مرةً وبلوتُ","الموتَ ألفاً لو كنتما تعلمانِ",1,"ن",1,0],["أنا أحيا مع الحياة ولكن","عمري ميّت الأماني محطّم",2,"م",1,0],["أنا أحبك يا من تسكنين دمي","إنت كنت في الصين، أو إن كنت في القمر",3,"ر",1,0],["أنا أحبك يا من تسكنين دمي","إن كنت في الصين، أو كنت في القمر",4,"ر",1,0],["أنا أحبك فوق الغيم أكتبها","وللعصافير والأشجار أحكيها",5,"ي",3,0],["أنا أحبك فوق الماء أنقشها","وللعناقيد والأقداح أسقيها",5,"ي",3,0],["أنا أحيى كطائر حطّم القي","د ولمّا يزل أسير الفضاء",6,"ا",2,1],["أنا أحيا كالناس ما دمت فيهم","فإذا ما خلوت صرت نبيّا",7,"ي",2,0],["أنا أحُلُّكْ من خطاياك وقل","من بعد ذا بسملةً واقصد تَحُلْ",8,"ل",1,0],["أنا أحبابيَ شِعري لهمْ","مثلما سَيفي وسَيفُ أبي",9,"ب",2,0],["أنا أحاول لا زلفى ولا ملق","لكنه الحب. محض الحب في ذاتي",10,"ت",2,0],["أنا أحمي حَلَباً دَا","راً وأحمي من حماها",11,"ا",3,0],["أنا أحنى عليك من مهجة الليل","وأطرى من معطف الظلماء",12,"ا",2,0],["أنا أحب الكنافة","من شراب نوفر",13,"ر",1,1],["أنا أحنو على اليتامى وأرعى","أيِّماً عاشرتك بالطّهر دهرا",14,"ر",2,0],["أنا أحمد الصافي وأحمد شعره","بسيطان في لبس بسيط وتعبير",15,"ر",1,0],["أنا أحيا بها حقيقة عمري","فدعوني من عمري الموهوم",16,"م",1,0],["أنا أحسد المتقاعدين لأنني","متقاعدٌ لكن بدون معاش",17,"ش",1,0],["أنا أحكي بالزي شيخاً ولكن","ما ترى بي طباع شيخ وقس",18,"س",1,0],["أنا أحب الشعر لكنني","أبغض أهل الشعر بالفطره",19,"ر",2,1],["أنا أحرر شعري","وقد يجي بردنَّه",20,"ن",2,0],["أنا أحمدي، أنا أحمدي من أَوجَهٍ","في ذكر احمدَ كُلَّ معنى أجْتَلىِ",21,"ل",2,0],["أنا أحوي ذخائر الأعلاقِ","وأصونُ الحليَّ في أغلاقِ",22,"ق",1,1],["أنا أحرى كلَّ ملكِ بالثَّنا","وربيع الناس في العامِ المحقْ",23,"ق",1,0],["إنّا احتسبناه يوم صادمه","موتٌ تحمل وحده دركه",24,"ك",2,0],["أَنا أَحنفٌ في الحلمِ عن أَمثالهم","وشريعتي ما عشتُ فيه حنيفُها",25,"ف",3,0],["أنا أحتاج - تحديدًا - حَنانًا","ورومانسِيّةً.. أحتاجُ عَطْفا",26,"ف",2,0],["أنا أحتاج من فَمِها كلامًا","كما العسلِ المُصَفَّى، بل وأصفى",26,"ف",2,0],["أنا أحتاج - بالتأكيد - أيضًا","من الشفتينِ تقبيلاً ورَشْفا",26,"ف",2,0],["أنا أحتاج نَهدَيْها كثيرًا..","هُما وَطَنِيْ وباقي الكَونِ مَنْفَى!",26,"ف",2,0],["أنا أحتاج ضَمًّا أو عِنَاقًا","سأقطف من ثمارِ الحُبِّ قَطْفا!",26,"ف",2,0],["أنا أحتاج قلبَكِ قُربَ قَلبي","وقَفْتُ علَيكِ نَبضَ القلبِ وَقْفا",26,"ف",2,0],["أنا أحتاج حُبًّا يحتويني","يُقَرّبُنِي لربِّ الحُبّ زُلْفَى",26,"ف",2,0],["أنا احسب أن الشقا مايخلف الصوره","لين أضمحلت ملامحك الطبيعيه",27,"ي",2,0],["أَنا أَحرَى بِالأَمنِ، مِن كُلِّ طِفلٍ","يَتَبَاكَى لِضَمَّةٍ.. أَو لِرَضعَة",28,"ع",2,0],["أَنا أَحرَى بِالأَمنِ.. لكنَّ قلبي","دُونَ سُورٍ، ورايَتِي دُونَ قَلعة",28,"ع",2,0],["أنا احترق والأدمي روح عظام","وعند الملا ما كن لي رغةٍ فيك",29,"ك",1,0],["أنا أحبك، والله أني أحبك","بعض المشاعر ما تقال بسهولة",30,"ل",2,0],["أنا احبك احبك وأموت.. فيك","والشجر والجبل والوادي والله شهيد",31,"د",1,0],["\" أنا أحبكِ \" ليت الشعر شوربَةٌ","لتحتسيه فيدفيكِ ويرويكِ",32,"ك",1,0],["\" أنا أحبّك \" هذا البَوْح بوصلةٌ","إلى مآلات لقيانا ستهديكِ",32,"ك",1,0],["\" أنا أحبك \" أهديها مجردةً","فما سواها لديّ اليوم أهديكِ",32,"ك",1,0],["أنا أحاسيسُ أشجارٍ.. يُمَزِّقُها","سوطُ الخريفِ.. متى أحظى بسُقياكِ",33,"ك",1,0],["إنّا احتسبناكِ عندَ اللهِ في غُرفٍ","من الجِنَانِ، وفي الفِردَوس مَرقَاهُ",34,"ا",2,0],["أنا أحبّك يا شمسا تجدّدني","ويا مساء به أستمرئ التّعبا",35,"ب",2,0],["أنا أحْرُفُ الثُّوَّارِ حينَ تأجّجَتْ","تَرنُو إلى أُفُقِ الغَدِ المُتبسِّمِ..",36,"م",1,0],["أنا أحتاج لك وأحتاج لو لحظات تروينا","ضمت روحي بهجرانك تدور .. بالبكا ماها .. !",37,"ا",3,0],["أنا... أحرقتْ عيناي كل مراكبي","وعدت إليها.. والنوائب تنظر",38,"ر",1,0],["انا أحمد الله على سدة مواجيبي","لي راس مالٍ رصدته في مواجيبه",39,"ب",2,0],["انا احبك مابها زيف وخداع","رغم الذي نخفيه ..واللي نخافه",40,"ف",2,1],["أنا أحمد اللي بدّل الجهل بإيمان","اللي حفظ عمي وصانه وشافاه",41,"ا",2,0],["انا احترم بالخلا ماطاك","وشلون لو شافتك عيني!",42,"ن",2,1],["(أنا أحبكَ فوق الغيم أكتبها )","كالياسمين ومنه العطر ينتشرُ",43,"ر",1,0],["انا احس شوق للغرام يهزني","ان شفت من عربان اهل مي طارفه",44,"ف",2,0],["أنا أحبُّكُ أم أنتَ الذي بَلَغَتْ","منهُ الصبابةُ قدْرا راحَ يعترفُ",45,"ف",1,0],["انا احبُّكِ ليست لي مقاومةٌ","احتاجُ ضمّكِ ضميني لكي أصِلا",46,"ل",2,0],["أنا أحبك والأقدار شاهدة","والليل والوجد والأشجار والزهر",47,"ر",1,0],["انا احترق خلف السحاب الممطر النازل ل فوق","انا انتثر مثل الرماد بليلة الريح الشديد",48,"د",1,0],["أنا أحمد الله بن هيل ومعاميل","في صرح عزٍ مشرق\"ن\" نور ضيه",49,"ي",2,0],["أنا أحبكِ يا شامي بلا كلل","ونحنُ في الحبِّ أسيادٌ وأشرافُ",50,"ف",1,0],["أنا أحرى منك بالأنثى كثيراً","فهي إنعاشٌ لأشعاري وفنّي",51,"ن",2,0],["أنا أَحْرَى منك بالخوف لأني","مِلْكُ كفيك نجاتي وقيودي",52,"د",2,0],["إنّا احتقرنا بعض صحبٍ هم عدى","كم قد وضعنا الحلم فيمن شلّنا",53,"ن",2,0],["أنا أحتفي بإخائه البنَّاءِ","كأعزِّ كلِّ الصحْب والآباءِ",54,"ا",2,1],["أنا أحقر الناس بل حيوانٌ","براه المهيمن من دون ذيلْ",55,"ل",1,0],["أنا أحسد الموتى الألَى ارتاحوا ولم","أرتحْ أنا من قبضة الطغيانِ..",56,"ن",1,0],["أنا أحكي بوح قلبي","أتحدى المستحيلْ",57,"ل",1,0],["أنا أحببتك حباً لم يكن","لينال اليوم منه صدكا",58,"ك",2,0],["أنا أحتاج قربكِ في حياتي","تعالي وأملئي عُمري جِنانا",59,"ن",2,0],["أَنا أحببتها ومعي رجائي","وأَمضي الآن ينكرني الرجاءُ",60,"ا",2,0],["أنا أُحِبُّكَ يا روحي ويا أملي","أنا أُحِبٌّكَ يا وِردي وأذكاري",61,"ر",2,0],["أنا أحبك خُذْ ما شِئتَ من قَدري","واصنعْ به بلسماً من دمعيَ الجاري",61,"ر",2,0],["أنا أحبك في يأس يعذبني","وسوف أحميك من طيشي … بإيثاري",62,"ر",2,0],["أنا أحبك حبا عاش في خلدي","حتى سكنتك واستوطنت أفكاري",62,"ر",2,0]]}