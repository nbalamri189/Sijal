html","الطويل"],[278,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[302,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[307,"ودنياك التي غرتك منها","https://www.aldiwan.net/poem50312.html","الوافر"],[318,"محمد بك الشباشي النجيب","https://www.aldiwan.net/poem67126.html","المتقارب"],[362,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[362,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[364,"أجيراننا أما أحاديث ذكركم","https://www.aldiwan.net/poem16955.html","الطويل"],[374,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[377,"على ثقة باتلافي وعلم","https://www.aldiwan.net/poem49243.html","الوافر"],[397,"تنوعت الجراح","https://www.aldiwan.net/poem6787.html","عموديه"],[400,"ليهنك إذ زفت إليك عروس","https://www.aldiwan.net/poem33702.html","الطويل"],[413,"سقاني مرير الكأس حلو المباسم","https://www.aldiwan.net/poem53933.html","الطويل"],[413,"سعيت لهذا الملك بالهمة الكبرى","https://www.aldiwan.net/poem53949.html","الطويل"],[413,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[413,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[434,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[450,"هلال لاح أم شبل تبدي","https://www.aldiwan.net/poem13735.html","الوافر"],[456,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[459,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem15924.html","الوافر"],[462,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[464,"أما وإلى الواشي وإن طاوعتهم","https://www.aldiwan.net/poem50380.html","الطويل"],[468,"لقد منعت معروفها أم جعفر","https://www.aldiwan.net/poem4712.html","الطويل"],[468,"وما زال من قلبي لسودة ناصر","https://www.aldiwan.net/poem4847.html","الطويل"],[475,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[484,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[498,"قرأنا معاني السر فالحكم ظلهر","https://www.aldiwan.net/poem37685.html","الطويل"],[504,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[513,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[513,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[536,"إلى العالم الفرد الذي عز نده","https://www.aldiwan.net/poem47983.html","عموديه"],[560,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[565,"لقد مر عبد الله بالأمس راكبا","https://www.aldiwan.net/poem69581.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"أدام الله أيام الوصال","https://www.aldiwan.net/poem17685.html","الوافر"]],"verses":[["لَقَد مَلَكَ الفَخارَ وَبا","تَ يَنهاهُ وَيَأمُرُه",0,"ر",2,0],["لقَدَّمَتْهُ قُرَيشٌ ثمّ ما ولَغَتْ","للبَغْي في دَمِها صِفّينُ والجَمَلُ",1,"ل",1,0],["لَقَد مَنَّتكَ نَفسُكَ يَومَ قَوٍّ","أَحاديثَ الفُؤادِ المُستَهامِ",2,"م",1,0],["لَقَد مَنَنتَ عَلى قَلبي بِمَعرِفَةٍ","بِأَنَّكَ اللَهُ ذو الآلاءِ وَالقُدسِ",3,"س",1,0],["لقدْ مُزَجَتْ روحي بروحِكَ في الهَوى","كَما مُزِجَ الماءُ الزُّلالُ معَ الخَمْرِ",4,"ر",1,0],["لَقَد مَكَّنَ الرَحمَنُ في الأَرضِ دَولَةً","لِعُثمانَ لا تَعفو وَلا تَتَشَعَّبُ",5,"ب",1,0],["لَقَد مُنِعَ الرُقادُ فَبِتُّ لَيلي","تُجافيني الهُمومُ عَنِ الوِسادِ",6,"د",1,0],["لَقَد ماثَ مِن جَعسِهِ عِترَةً","فَعَطَّرتُهُ بِالَّتي ماثَها",7,"ث",3,0],["لَقَد مَنَحَ الوُدَّ الَّذي ما مَلَكتَهُ","عَلى النَأيِ مَيّاً مِن فُؤادِكَ مانِحُ",8,"ح",1,0],["لقد ملك الإفرنج أرض مراكش","وقد ملكوا من قبلها تونس الخضرا",9,"ر",2,0],["لقد مزّقُوا أحكام كل ديانة","وخاطُوا لهم منها ثياب رياء",10,"ا",2,0],["لَقَد مَنَعَت خَيلي حَويزَةَ بَعدَما","رَغَت كَرُغاءَ النابِ جُرَّ جَنينُها",11,"ن",3,0],["لَقَد مَدَّني عَمروٌ وَزَيدٌ مِنَ الثَرى","بِأَكثَرَ مِمّا عِندَ تَيمٍ وَأَطيَبا",12,"ب",2,0],["لَقَد مُدَّ لِلقَينِ الرِهانُ فَرَدَّهُ","عَنِ المَجدِ عِرقٌ مِن قُفَيرَةَ مُقرِفُ",13,"ف",1,0],["لقدما رأيت الناس أبناء علة","وأرحامهم أكراش دمن تجررُ",14,"ر",1,1],["لقد منحت كثيراً من قليلك إذ","قليله في كثير الوفر رَوَّاج",15,"ج",1,0],["لقد ماثَ من جَعْسِهِ عِترَةً","فأسعطتهُ بالتي ماثَها",16,"ث",3,0],["لَقَد مَدَحتُ قُرَيشاً وَاِستَغَثتُ بِهِم","إِذ ما أَنامُ إِذا ما صُحبَتي هَجَعوا",17,"ع",3,0],["لَقَد مَرَّ لَنا يَومٌ","مِنَ الغُرِّ المَشاهيرِ",18,"ر",1,0],["لقد مات سعد خالدا منه ذكره","وما خير ذكر لا يكون بخالد",19,"د",1,0],["لقد مات سعد بل لقد مات موثل","وآمال شعب ناهض ذى مقاصد",19,"د",1,0],["لقد مضى يتبع منه الخطي","ولا اراه عنه بالقافل",20,"ل",1,0],["لقد مرضت نفسي لفرط اشتياقها","إليها وحتى يومنا ما ابلت",21,"ت",1,0],["لقد ملكت فأسجح إننا فئة","لا شيء غير جمال العدل يرضينا",22,"ن",2,0],["لقد مات الكرام وأنت حىّ","حياة تنقضى عارا وذاما",23,"م",2,0],["لَقَد مَنَعَت وَالمَنعُ مِنها سَجِيَّةٌ","وَلَو وَصَلَت كانَت عَلى الوَصلِ أَقدَرا",24,"ر",2,0],["لَقُدِّمتُ عَلى الناسِ","وَلَكِنَّ الهَوى رِزقُ",25,"ق",1,0],["لَقَد ماتَ سِرّي وَاِستَقامَت مَوَدَّتي","وَلَم يَنشَرِح بِالقَولِ يا حَبَّتي فَمي",26,"م",2,0],["لَقَد ماطَلتِني يا حِبِّ عَصراً","فَلَيتَ اللَهُ بِالحُبِّ اِبتَلاكِ",27,"ك",1,0],["لَقَد مَحَّضَ اللَهُ الهَوى لَكِ خالِصاً","وَرَكَّبَهُ في القَلبِ مِنّي بِلا غِشِّ",28,"ش",1,0],["لقد مَضَتِ المقالةُ من لبيبٍ","يقولُ الحقَّ لا يألوكَ نُصْحا",29,"ح",2,0],["لَقَد مَات فِي بَحرٍ تَعَاظَم مَوجُهُ","فَمتُّ بِه فِي بَحرِ دمعِي وأشحَانِي",30,"ي",1,0],["لَقَد مَرَيتُكُمُ لَو أَنَّ دِرَّتَكُم","يَوماً يَجيءُ بِها مَسحي وَإِبساسي",31,"ي",1,0],["لقدْ مُلِئَتْ حُبَّاً وَرُعْباً قلوبُنا","بهِ فَهْوَ بالأَمْرَينِ فيها مُصَوَّرُ",32,"ر",1,0],["لَقَد ماتَ كِنديرٌ فَأَبكاكَ مَوتُهُ","فُجِعتَ بِأَيرٍ كَالشُواظِ صَليبِ",33,"ب",1,0],["لَقَد ماتَ جَنِيُّ الصِبا مُنذُ بُرهَةٍ","وَتَأبى عِفارِيَ القَلبِ غَيرَ مَرودِ",34,"د",1,1],["لَقَد مَرَّ حَرَسٌ بَعدَ حَرَسٍ جَميعُهُ","حَنادِسُ لَم يَذرُر مَعَ الصُبحِ شارِقُه",35,"ق",2,0],["لقد مَسَخَتْ قلبي وفاتُكَ طائراً","فأقْسَمَ أنْ لا يَسْتَقِرّ على وَكْنِ",36,"ن",1,0],["لَقَد مشيت بليلٍ","داج بغير دَليلِ",37,"ل",1,1],["لقد مات من قد كان للجود موئلا","لقد مات من قد كان يحيا بهِ البر",38,"ر",1,0],["لَقَد ماتَ مَن قَد ماتَ عزي لموته","وَماتَ عزائي وَالسَكينة وَالصبر",38,"ر",1,0],["لَقَد مددت أَصبعي","فَلَم أُشاهد أصبعي",39,"ي",1,0],["لَقَد مَرَّ من لَيلي الطَويل هَزيعُ","وَطَرفي بأعجاز النجوم وَلوعُ",40,"ع",1,1],["لَقَد مَشيت حَثيثاً","فلا يَجوز رجوعي",41,"ي",1,0],["لقد مرَّ كالطيرِ من قربنا","فتىً في رعاية ربٍّ خطيرْ",42,"ر",1,0],["لقد مَنعوا الأنوارَ عنكمُ وأنصفوا","متى احتاجَ للأنوارِ أهلُ المقابرِ",43,"ر",1,0],["لقد ملَّتِ الغاباتُ مما يجوسُها","وملَّ صِماخُ الليلِ ممّا يُرَجِّع",44,"ع",1,0],["لقد مكَّنَ الله للظالمي","ن حينًا من الدهر ثم انتَقَمْ",45,"م",1,0],["لقد منحتهُ الطبيعةُ مُلكًا","عريضًا من الشِّعر فيه احتكم",46,"م",1,0],["لقد مَنَّيْتِني دهرًا طويلاً","فعُدتُ؛ وما حصدتُ سوى هَشيم",47,"م",1,0],["لقد مضى عامٌ عرفتُ صروفه","وعييتُ بالغيب الذي لم يوجد",48,"د",1,0],["لقد مارس الأيامَ ذو خبرةٍ بها","ذكيٌّ لحالاتِ الزمان ِ مُلائم",49,"م",1,0],["لقد ملَّ هذا الشعبُ أوضاع ثُلَّةٍ","غدت بينه مثلَ الحروفِ النوافر",50,"ر",1,0],["لَقَدْ مَاتَ سِرّي وَکسْتَقَامَتْ مَوَدَّتي،","وَلَمْ يَنْشَرِحْ بِکلقَوْلِ يا حبَّتي فَمِي",51,"م",2,0],["لقَدْ مَدّني عَمروٌ وزيدٌ من الثّرى","بأكثرَ مما عندَ تيم وأضيبا",52,"ب",2,0],["لقد منَّ الإله به علينا","وصفوته أبي العربِ الأبىّ",53,"ا",1,0],["لقد مزَّقَته الناسُ قبلك إخوتي","وأبناءُ عمِّي والعدوُّ المُكَشَّرُ",54,"ر",1,0],["لَقَد مُدِحَ الأَجوادُ في كُلِّ مَوطِنٍ","وَما وَجَدوا بِالمَكرُماتِ كَذا الوَجدِ",55,"د",1,0],["لَقَد مَنَعوا بِالبيضِ ما أَخَذوا بِها","وَلَو أَمِنوا عَدواكَ ما بَذَلوا الوُدّا",56,"د",2,0],["لَقَد ماتَتِ الآمالُ في كُلِّ مَوطِنٍ","وَلَولا نَداكَ الغَمرُ لَم تَكُ تُنشَرُ",57,"ر",1,0],["لَقَد مَلَأَت أَخبارُهُ وَهِباتُهُ","أُنوفَ الوَرى عَرفاً وَأَيدِيَهُم عُرفا",58,"ف",2,0],["لَقَد مَلَأتَ القَوافي فَوقَ ما وَسِعَت","فَما لَها عَنكَ تَعريدِ وَلا مَيَلُ",59,"ل",1,0],["لقد مرضت أرواحنا وجسومنا","لشكواكم يا ليت لا كانت الشكوى",60,"و",2,0],["لَقَد مَسّنا طولُ الفِراقِ بِنَصبِهِ","فَصِرنا نُحِبُّ المَوتَ ضيقاً بِكَربِهِ",61,"ه",1,0],["لَقَد مَجَّدَت مِنهُ أَبَرَّ مُمَجَّدٍ","عَلى كُلِّ ما يُحظى لَدى الرَبِّ مُنجِدٍ",62,"د",1,0],["لقد مات معناه وان بقى اسمه","عسى باعث الموتى علينا يرده",63,"ه",1,0],["لقد مات قطب العارفين محمد","فما الناس إلا مثل لفظ بلا معنا",64,"ن",2,0],["لقد مشيت طريقاً ما بها عوجٌ","من سار فيها إلى رب السما وصلا",65,"ل",2,0],["لقد ملا الأرض عبدُ الله معدلةً","وذاكَ خير له من ملئها ذَهَبا",66,"ب",2,0],["لقد ملا الأرضَ عبدُ اللهِ معدلةً","تلقى معاديه في شرٍّ وتخذّلَهُ",67,"ل",2,0],["لقد ملا الأرض عدلا بعدهم ملك","لا شيء غير رضى الرحمن يرضيه",68,"ي",2,0],["لقد ملأ الدنيا سرورا وغبطة","قدوم نجيب كان خيرا قدومه",69,"م",2,0],["لَقَد مُنِعَ النُطقَ اللِسانُ وَعاقَهُ","عَنِ البَثِّ وَالشَكوى مِن البَينِ عائِقُ",70,"ق",1,0],["لَقَد مُنيَت مِنهُ الأَعادي بِثائِرٍ","هُمامٍ أَبى أَن يَحمِلَ الضَيمَ كاهِلُه",71,"ل",2,0],["لَقَدَّمتُ رِجلي نَحوَها فَوَطِئتُها","هُدَيَّاكِ لِي أَو هَفوَةً مِن ضَلالِكِ",72,"ك",1,0],["لَقَدَّمتُ رِجلى نَحوَهَا فَوَطئتُهَا","هُدًى مِنكِ لى أَوغَيَّةً مِن ضَلاَلِكِ",73,"ك",1,0],["لَقَد مَضَت أَنجلينا عَن بَني صَدقَهْ","فَغادَرَت أَكبُدَ الأَهلينَ محترِقَهْ",74,"ق",2,1],["لَقَد مَضى سَعدُ رَزوق الكَريمَ إِلى","مَولاهُ حَسْبَ قَضاءِ اللَّهِ وَالقَدَرِ",75,"ر",1,1],["لَقَد مَضى نِعمةُ اللَّهِ الكَريمِ إِلى","جِوارِ خالقِهِ الغَفّارِ مُنصَرِفاً",76,"ف",2,1],["لَقَد مَلَكَتْ مِنا العَواطفَ فَاِنثَنى","إَلَيها بِأَشجانِ الهَوى كُلّ مَعطَفِ",77,"ف",1,0],["لقد مَلَك الإسكندرُ الأرضُ وانقضى","وأَبَقى له الإسكندريةَ شاهدا",78,"د",2,0],["لقد ملأ الله البلاد سلامة","بسيفك لما قلّ فيها سليمها",79,"م",3,0],["لَقَد مَدَحتُ رِجالاً صالِحينَ فَأَمّا","أَن يَنالوا كَما نالَ الوَليدُ فَلا",80,"ل",2,0],["لقدَّ منه شَغَفَاً","قميصُه من دُبُرِ",81,"ر",1,0],["لقد مَضَّني شوق إليك مبرِّحٌ","وصرتُ حليفَ الحزنِ والوجد والأسَف",82,"ف",1,0],["لقد مت وجدا في الغرام بحبها","وخالفت عذالا عليها تنازع",83,"ع",1,0],["لقد ماتوا وماتوا ثم ماتوا","ونقضُ العهد والميثاق موتُ",84,"ت",1,0],["لقد مالت الدنيا وجافت وجانبَت","فكن منقذي من جورها المتلاحق",85,"ق",1,0]