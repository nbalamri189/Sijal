,[5616,"كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=203426",""],[5616,"غيره","https://www.poetsgate.com/ViewPoem.aspx?id=203457",""],[5672,"يا الله","https://www.poetsgate.com/ViewPoem.aspx?id=213930",""],[5691,"حكومة الوفاق...!","https://www.poetsgate.com/ViewPoem.aspx?id=206342",""],[5805,"متى تصحو بوجداني القصيدة ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=24723",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[5956,"أعوض عن هواكم بالبكاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=182004",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[5956,"هل تريد أن أريحك من القصيد؟","https://www.poetsgate.com/ViewPoem.aspx?id=192516",""],[5956,"لقد مر الغرام اليوم فينا","https://www.poetsgate.com/ViewPoem.aspx?id=193856",""],[5956,"حنينٌ لقرية \"بيت أجنادٍ\" ثم انطفاءُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=207910",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6084,"أبي حسبي أني أعيش بذلة","https://www.poetsgate.com/ViewPoem.aspx?id=170866",""],[6093,"غابُوا وإنْ حَضَرُوا","https://www.poetsgate.com/ViewPoem.aspx?id=190632",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6125,"مَتَىٰ يَا لَيلُ تَشرَعُ بالفِرَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207932",""],[6152,"كفاكِ مطلاً","https://www.poetsgate.com/ViewPoem.aspx?id=203592",""],[5309,"بلادي هوى الدنيا ومأوى الغرائب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573554",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""],[5567,"اعتذار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81824&r=&rc=74",""],[572,"لقد مرَّ عبدُ اللّه في السوقِ راكباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9408&r=&rc=265",""]],"verses":[["لَقَد مَلَكَ الفَخارَ وَبا","تَ يَنهاهُ وَيَأمُرُه",0,"ر",2,0],["لقَدَّمَتْهُ قُرَيشٌ ثمّ ما ولَغَتْ","للبَغْي في دَمِها صِفّينُ والجَمَلُ",1,"ل",1,0],["لَقَد مَنَّتكَ نَفسُكَ يَومَ قَوٍّ","أَحاديثَ الفُؤادِ المُستَهامِ",2,"م",1,0],["لَقَد مَنَنتَ عَلى قَلبي بِمَعرِفَةٍ","بِأَنَّكَ اللَهُ ذو الآلاءِ وَالقُدسِ",3,"س",1,0],["لقدْ مُزَجَتْ روحي بروحِكَ في الهَوى","كَما مُزِجَ الماءُ الزُّلالُ معَ الخَمْرِ",4,"ر",1,0],["لَقَد مَكَّنَ الرَحمَنُ في الأَرضِ دَولَةً","لِعُثمانَ لا تَعفو وَلا تَتَشَعَّبُ",5,"ب",1,0],["لَقَد مُنِعَ الرُقادُ فَبِتُّ لَيلي","تُجافيني الهُمومُ عَنِ الوِسادِ",6,"د",1,0],["لَقَد ماثَ مِن جَعسِهِ عِترَةً","فَعَطَّرتُهُ بِالَّتي ماثَها",7,"ث",3,0],["لَقَد مَنَحَ الوُدَّ الَّذي ما مَلَكتَهُ","عَلى النَأيِ مَيّاً مِن فُؤادِكَ مانِحُ",8,"ح",1,0],["لقد ملك الإفرنج أرض مراكش","وقد ملكوا من قبلها تونس الخضرا",9,"ر",2,0],["لقد مزّقُوا أحكام كل ديانة","وخاطُوا لهم منها ثياب رياء",10,"ا",2,0],["لَقَد مَنَعَت خَيلي حَويزَةَ بَعدَما","رَغَت كَرُغاءَ النابِ جُرَّ جَنينُها",11,"ن",3,0],["لَقَد مَدَّني عَمروٌ وَزَيدٌ مِنَ الثَرى","بِأَكثَرَ مِمّا عِندَ تَيمٍ وَأَطيَبا",12,"ب",2,0],["لَقَد مُدَّ لِلقَينِ الرِهانُ فَرَدَّهُ","عَنِ المَجدِ عِرقٌ مِن قُفَيرَةَ مُقرِفُ",13,"ف",1,0],["لقدما رأيت الناس أبناء علة","وأرحامهم أكراش دمن تجررُ",14,"ر",1,1],["لقد منحت كثيراً من قليلك إذ","قليله في كثير الوفر رَوَّاج",15,"ج",1,0],["لقد ماثَ من جَعْسِهِ عِترَةً","فأسعطتهُ بالتي ماثَها",16,"ث",3,0],["لَقَد مَدَحتُ قُرَيشاً وَاِستَغَثتُ بِهِم","إِذ ما أَنامُ إِذا ما صُحبَتي هَجَعوا",17,"ع",3,0],["لَقَد مَرَّ لَنا يَومٌ","مِنَ الغُرِّ المَشاهيرِ",18,"ر",1,0],["لقد مات سعد خالدا منه ذكره","وما خير ذكر لا يكون بخالد",19,"د",1,0],["لقد مات سعد بل لقد مات موثل","وآمال شعب ناهض ذى مقاصد",19,"د",1,0],["لقد مضى يتبع منه الخطي","ولا اراه عنه بالقافل",20,"ل",1,0],["لقد مرضت نفسي لفرط اشتياقها","إليها وحتى يومنا ما ابلت",21,"ت",1,0],["لقد ملكت فأسجح إننا فئة","لا شيء غير جمال العدل يرضينا",22,"ن",2,0],["لقد مات الكرام وأنت حىّ","حياة تنقضى عارا وذاما",23,"م",2,0],["لَقَد مَنَعَت وَالمَنعُ مِنها سَجِيَّةٌ","وَلَو وَصَلَت كانَت عَلى الوَصلِ أَقدَرا",24,"ر",2,0],["لَقُدِّمتُ عَلى الناسِ","وَلَكِنَّ الهَوى رِزقُ",25,"ق",1,0],["لَقَد ماتَ سِرّي وَاِستَقامَت مَوَدَّتي","وَلَم يَنشَرِح بِالقَولِ يا حَبَّتي فَمي",26,"م",2,0],["لَقَد ماطَلتِني يا حِبِّ عَصراً","فَلَيتَ اللَهُ بِالحُبِّ اِبتَلاكِ",27,"ك",1,0],["لَقَد مَحَّضَ اللَهُ الهَوى لَكِ خالِصاً","وَرَكَّبَهُ في القَلبِ مِنّي بِلا غِشِّ",28,"ش",1,0],["لقد مَضَتِ المقالةُ من لبيبٍ","يقولُ الحقَّ لا يألوكَ نُصْحا",29,"ح",2,0],["لَقَد مَات فِي بَحرٍ تَعَاظَم مَوجُهُ","فَمتُّ بِه فِي بَحرِ دمعِي وأشحَانِي",30,"ن",2,0],["لَقَد مَرَيتُكُمُ لَو أَنَّ دِرَّتَكُم","يَوماً يَجيءُ بِها مَسحي وَإِبساسي",31,"س",2,0],["لقدْ مُلِئَتْ حُبَّاً وَرُعْباً قلوبُنا","بهِ فَهْوَ بالأَمْرَينِ فيها مُصَوَّرُ",32,"ر",1,0],["لَقَد ماتَ كِنديرٌ فَأَبكاكَ مَوتُهُ","فُجِعتَ بِأَيرٍ كَالشُواظِ صَليبِ",33,"ب",1,0],["لَقَد ماتَ جَنِيُّ الصِبا مُنذُ بُرهَةٍ","وَتَأبى عِفارِيَ القَلبِ غَيرَ مَرودِ",34,"د",1,1],["لَقَد مَرَّ حَرَسٌ بَعدَ حَرَسٍ جَميعُهُ","حَنادِسُ لَم يَذرُر مَعَ الصُبحِ شارِقُه",35,"ق",2,0],["لقد مَسَخَتْ قلبي وفاتُكَ طائراً","فأقْسَمَ أنْ لا يَسْتَقِرّ على وَكْنِ",36,"ن",1,0],["لَقَد مشيت بليلٍ","داج بغير دَليلِ",37,"ل",1,1],["لقد مات من قد كان للجود موئلا","لقد مات من قد كان يحيا بهِ البر",38,"ر",1,0],["لَقَد ماتَ مَن قَد ماتَ عزي لموته","وَماتَ عزائي وَالسَكينة وَالصبر",38,"ر",1,0],["لَقَد مددت أَصبعي","فَلَم أُشاهد أصبعي",39,"ع",2,0],["لَقَد مَرَّ من لَيلي الطَويل هَزيعُ","وَطَرفي بأعجاز النجوم وَلوعُ",40,"ع",1,1],["لَقَد مَشيت حَثيثاً","فلا يَجوز رجوعي",41,"ع",2,0],["لقد مرَّ كالطيرِ من قربنا","فتىً في رعاية ربٍّ خطيرْ",42,"ر",1,0],["لقد مَنعوا الأنوارَ عنكمُ وأنصفوا","متى احتاجَ للأنوارِ أهلُ المقابرِ",43,"ر",1,0],["لقد ملَّتِ الغاباتُ مما يجوسُها","وملَّ صِماخُ الليلِ ممّا يُرَجِّع",44,"ع",1,0],["لقد مكَّنَ الله للظالمي","ن حينًا من الدهر ثم انتَقَمْ",45,"م",1,0],["لقد منحتهُ الطبيعةُ مُلكًا","عريضًا من الشِّعر فيه احتكم",46,"م",1,0],["لقد مَنَّيْتِني دهرًا طويلاً","فعُدتُ؛ وما حصدتُ سوى هَشيم",47,"م",1,0],["لقد مضى عامٌ عرفتُ صروفه","وعييتُ بالغيب الذي لم يوجد",48,"د",1,0],["لقد ما أعاروك الجماجم خشعا","عليهن من قرع الصفاح فطور",49,"ر",1,0],["لقد ملأوا الآفاق افكا وخزية","وبغيا ولا مقصود الا المطامع",50,"ع",1,0],["لقد مكن الأعداء منا انخداعنا","وقد لاح آل في المهامه لامع",50,"ع",1,0],["لقد مارس الأيامَ ذو خبرةٍ بها","ذكيٌّ لحالاتِ الزمان ِ مُلائم",51,"م",1,0],["لقد ملَّ هذا الشعبُ أوضاع ثُلَّةٍ","غدت بينه مثلَ الحروفِ النوافر",52,"ر",1,0],["لقد ما أعاروك الجاجم خشعا","عليهن من قرع الصفاح فطور",53,"ر",1,0],["لَقَدْ مَاتَ سِرّي وَکسْتَقَامَتْ مَوَدَّتي،","وَلَمْ يَنْشَرِحْ بِکلقَوْلِ يا حبَّتي فَمِي",54,"م",2,0],["لقَدْ مَدّني عَمروٌ وزيدٌ من الثّرى","بأكثرَ مما عندَ تيم وأضيبا",55,"ب",2,0],["لقد منَّ الإله به علينا","وصفوته أبي العربِ الأبىّ",56,"ا",1,0],["لقد مزَّقَته الناسُ قبلك إخوتي","وأبناءُ عمِّي والعدوُّ المُكَشَّرُ",57,"ر",1,0],["لَقَد مُدِحَ الأَجوادُ في كُلِّ مَوطِنٍ","وَما وَجَدوا بِالمَكرُماتِ كَذا الوَجدِ",58,"د",1,0],["لَقَد مَنَعوا بِالبيضِ ما أَخَذوا بِها","وَلَو أَمِنوا عَدواكَ ما بَذَلوا الوُدّا",59,"د",2,0],["لَقَد ماتَتِ الآمالُ في كُلِّ مَوطِنٍ","وَلَولا نَداكَ الغَمرُ لَم تَكُ تُنشَرُ",60,"ر",1,0],["لَقَد مَلَأَت أَخبارُهُ وَهِباتُهُ","أُنوفَ الوَرى عَرفاً وَأَيدِيَهُم عُرفا",61,"ف",2,0],["لَقَد مَلَأتَ القَوافي فَوقَ ما وَسِعَت","فَما لَها عَنكَ تَعريدِ وَلا مَيَلُ",62,"ل",1,0],["لقد مرضت أرواحنا وجسومنا","لشكواكم يا ليت لا كانت الشكوى",63,"و",2,0],["لَقَد مَسّنا طولُ الفِراقِ بِنَصبِهِ","فَصِرنا نُحِبُّ المَوتَ ضيقاً بِكَربِهِ",64,"ه",1,0],["لَقَد مَجَّدَت مِنهُ أَبَرَّ مُمَجَّدٍ","عَلى كُلِّ ما يُحظى لَدى الرَبِّ مُنجِدٍ",65,"د",1,0],["لقد مات معناه وان بقى اسمه","عسى باعث الموتى علينا يرده",66,"ه",1,0],["لقد مات قطب العارفين محمد","فما الناس إلا مثل لفظ بلا معنا",67,"ن",2,0],["لقد مشيت طريقاً ما بها عوجٌ","من سار فيها إلى رب السما وصلا",68,"ل",2,0],["لقد ملا الأرض عبدُ الله معدلةً","وذاكَ خير له من ملئها ذَهَبا",69,"ب",2,0],["لقد ملا الأرضَ عبدُ اللهِ معدلةً","تلقى معاديه في شرٍّ وتخذّلَهُ",70,"ل",2,0],["لقد ملا الأرض عدلا بعدهم ملك","لا شيء غير رضى الرحمن يرضيه",71,"ي",2,0],["لقد ملأ الدنيا سرورا وغبطة","قدوم نجيب كان خيرا قدومه",72,"م",2,0],["لَقَد مُنِعَ النُطقَ اللِسانُ وَعاقَهُ","عَنِ البَثِّ وَالشَكوى مِن البَينِ عائِقُ",73,"ق",1,0],["لَقَد مُنيَت مِنهُ الأَعادي بِثائِرٍ","هُمامٍ أَبى أَن يَحمِلَ الضَيمَ كاهِلُه",74,"ل",2,0],["لَقَدَّمتُ رِجلي نَحوَها فَوَطِئتُها","هُدَيَّاكِ لِي أَو هَفوَةً مِن ضَلالِكِ",75,"ك",1,0],["لَقَدَّمتُ رِجلى نَحوَهَا فَوَطئتُهَا","هُدًى مِنكِ لى أَوغَيَّةً مِن ضَلاَلِكِ",76,"ك",1,0],["لَقَد مَضَت أَنجلينا عَن بَني صَدقَهْ","فَغادَرَت أَكبُدَ الأَهلينَ محترِقَهْ",77,"ق",2,1],["لَقَد مَضى سَعدُ رَزوق الكَريمَ إِلى","مَولاهُ حَسْبَ قَضاءِ اللَّهِ وَالقَدَرِ",78,"ر",1,1],["لَقَد مَضى نِعمةُ اللَّهِ الكَريمِ إِلى","جِوارِ خالقِهِ الغَفّارِ مُنصَرِفاً",79,"ف",2,1],["لَقَد مَلَكَتْ مِنا العَواطفَ فَاِنثَنى","إَلَيها بِأَشجانِ الهَوى كُلّ مَعطَفِ",80,"ف",1,0],["لقد مَلَك الإسكندرُ الأرضُ وانقضى","وأَبَقى له الإسكندريةَ شاهدا",81,"د",2,0],["لقد ملأ الله البلاد سلامة","بسيفك لما قلّ فيها سليمها",82,"م",3,0],["لَقَد مَدَحتُ رِجالاً صالِحينَ فَأَمّا","أَن يَنالوا كَما نالَ الوَليدُ فَلا",83,"ل",2,0],["لقدَّ منه شَغَفَاً","قميصُه من دُبُرِ",84,"ر",1,0],["لقد مَضَّني شوق إليك مبرِّحٌ","وصرتُ حليفَ الحزنِ والوجد والأسَف",85,"ف",1,0],["لقد مت وجدا في الغرام بحبها","وخالفت عذالا عليها تنازع",86,"ع",1,0],["لقد ماتوا وماتوا ثم ماتوا","ونقضُ العهد والميثاق موتُ",87,"ت",1,0],["لقد مالت الدنيا وجافت وجانبَت","فكن منقذي من جورها المتلاحق",88,"ق",1,0],["لقد مضى العيد ما سألتم","ولا برد الخطاب جدتم",89,"م",1,0],["لقد مات الهلالُ هلال طه","وغاية هذه الدنيا زوال",90,"ل",1,0],["لقد مات من لو عاش كان خميلة","بأفيائها عند الهجيرة أهجع",91,"ع",1,0],["لقد مزق الشوق قلبي الوفي","وسح لأجلك دمعي العصي",92,"ي",1,1],["لَقَد مَرَّ بي أَمسِ بِالصُدفَةِ","فَتاةٌ لَها الحُسنُ في الوُجنَةِ",93,"ه",1,1],["لَقَد مَلَكَتني فيكُمُ اليَومَ حَيرَةٌ","وَمازلِتُ مِن قَبلِ النَوى مالِكاً أَمري",94,"ر",2,0],["لقد ماتوا سَكارى واستحبُّوا","مناياهم على كرهِ الوجود",95,"د",1,0],["لقد متّما في مثلِ عمري فعشتُ