{"poems":[[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[563,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54107","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49553","المتقارب"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125939","الرمل"],[5747,"براق العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61663",""]],"verses":[["كلُّ مغذٍ زمامه الشوقُ في","أكنافه بالسماح معقول",0,"ل",1,0],["كل مغرور بغير هدىً","ربُّه ناشٍ من الوَهَم",1,"م",1,0],["كل مغرور له صنم","بافتكار فهو مبتدع",2,"ع",1,0],["كُلُّ مُغرَى بهواكُمْ","مِنْ مُناهُ نالَ قِسطَهْ",3,"ط",2,0],["كلُّ مغلوبٍ على أَكثرِهِ","لا رأى حَزْماً ولا قال سَدَد",4,"د",1,0],["كل مغوار يرى الروح فدى","لبلاد في حماها يكرم",5,"م",1,0],["كل مغرورٍ تعالى للوطا","ياغرورك كيف مني مااستحيت",6,"ت",1,0]]}