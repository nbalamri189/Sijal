طويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125857","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125819","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45073","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83402","الطويل"],[703,"","https://poetry.dctabudhabi.ae/diwan/poem/122945","المتقارب"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131911","الوافر"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115305","الطويل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66912","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76740","الوافر"],[4679,"لعمرك ما السعادة للشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=142729",""],[4680,"سيبتسم النهارُ","https://www.poetsgate.com/ViewPoem.aspx?id=185031",""],[4690,"رحْلَةُ الحكايات / أدب الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=120389",""],[4755,"تَقُولُ الليالي الطِوَالْ:","https://www.poetsgate.com/ViewPoem.aspx?id=183545",""],[4578,"أبانت فوق حاجبها المصون","https://www.poetsgate.com/ViewPoem.aspx?id=49534",""],[4852,"رضاب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=214270",""],[4908,"حقوق العشق","https://www.poetsgate.com/ViewPoem.aspx?id=207333",""],[4929,"لصوص في منعطف التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=199532",""],[4984,"هَمُّ الْفرَاغِ","https://www.poetsgate.com/ViewPoem.aspx?id=191137",""],[5038,"قرن الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=195235",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5055,"شمس إيليا","https://www.poetsgate.com/ViewPoem.aspx?id=101654",""],[5229,"أراك تشير بأهل الصلاح","https://www.poetsgate.com/ViewPoem.aspx?id=99986",""],[5284,"الأخ الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=191796",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5355,"لماذا افترقنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=189433",""],[5365,"يقيّمُني السفيهُ","https://www.poetsgate.com/ViewPoem.aspx?id=191262",""],[5388,"أنت الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=206909",""],[5397,"تبلجت ليلة في سعدها طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=157936",""],[5431,"إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=191707",""],[5431,"ومازال للعشاق غيمٌ ومرتفعْ!!","https://www.poetsgate.com/ViewPoem.aspx?id=199292",""],[5431,"وقفة عزّ...","https://www.poetsgate.com/ViewPoem.aspx?id=207555",""],[5431,"سبحان الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=208038",""],[5431,"شعر معتّق...","https://www.poetsgate.com/ViewPoem.aspx?id=211179",""],[5431,"ابتلاء الشوق...","https://www.poetsgate.com/ViewPoem.aspx?id=215616",""],[5443,"العذراء والطبق","https://www.poetsgate.com/ViewPoem.aspx?id=185151",""],[5459,"وباء الفرنَجة","https://www.poetsgate.com/ViewPoem.aspx?id=203965",""],[5491,"فيض الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203217",""],[5497,"قد توقد لاهبه","https://www.poetsgate.com/ViewPoem.aspx?id=205951",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5573,"ياعين مالك بالسهر زود راحه","https://www.poetsgate.com/ViewPoem.aspx?id=200080",""],[5688,"إذا ما القلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208900",""],[5751,"من منكنّ أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=215030",""],[5956,"هل تريد أن أريحك من القصيد؟","https://www.poetsgate.com/ViewPoem.aspx?id=192516",""],[5956,"نفحاتٌ وحِكَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=192564",""],[5956,"يُقيم مبادرات باسلات","https://www.poetsgate.com/ViewPoem.aspx?id=193203",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[6152,"نصون العهود","https://www.poetsgate.com/ViewPoem.aspx?id=206160",""],[6152,"وجدتكِ ثم أدمنت ابتسامي","https://www.poetsgate.com/ViewPoem.aspx?id=215746",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""]],"verses":[["يَقي كُلَّ شَيءٍ فَلَو يَستَطي","عُ غَدا الخُدودِ الأَعادي لُثُم",0,"م",1,0],["يَقيني بِالجَبينِ وَمَنكِبَيهِ","وَأَنصُرُهُ بِمُطَّرَدِ الكُعوبِ",1,"ب",1,0],["يُقيمُ إِذا ما اللَيلُ مَدَّ ظَلامَهُ","عَلى نَفسِهِ مَن شِدَّةِ الخَوفِ مَأتَما",2,"م",2,0],["يُقَيِّلنَ بِالبَزواءِ وَالجَيشُ واقِفٌ","مَزادَ الرَوايا يَصطَبِبنَ فِضالَها",3,"ل",3,0],["يَقينَ وَتَحسَبُهُ قافِلاً","إِذا طابَقَت وَغَشينَ الحِرارا",4,"ر",2,0],["يُقَيِّدُهَا الحُبُّ بَعْضاً وَكُ","لٌّ إِلَى صِنْوِهَا صَائِرَهْ",5,"ر",2,0],["يقيناً ما نخاف وإن ظَنَّنا","به خيراً أراناه يَقينا",6,"ن",2,1],["يُقيمونَها بِالجَهدِ حالاً وَتَنتَحي","بِها نَشوَةُ الإِدلاجِ أُخرى فَتَركَعُ",7,"ع",1,0],["يقيني شرّ فريتكم يقيني","بأنّ الله مطّلع رقيب",8,"ب",1,0],["يَقِئنَ صُباباتٍ مِنَ الخَمرِ فَوقَها","صَهيرُ خَنازيرِ السَوادِ المُمَلَّحُ",9,"ح",1,0],["يقيم على العادين حدًّا بحدِّها","ويهدي إلى العافين عزًّا بعزمها",10,"م",3,0],["يقيه ويحميه بصفحة وجهه","ويجعل أيضاً عِرضَه من فدائِهِ",11,"ا",3,0],["يَقيكَ مِنَ الأَيّامِ كُلَّ مُلِمَّةٍ","وَيَكفيكَ مِن أَحداثِها ما تَطَرَّقا",12,"ق",2,0],["يَقيكِ جَميلٌ كُلَّ سوءٍ أَما لَهُ","لَدَيكِ حَديثٌ أَو إِلَيكِ رَسولُ",13,"ل",1,0],["يقيم بقربي ثم في العش واضعا","اذا ما غفا الغاده فوق الغادي",14,"د",2,0],["يقيم به كرهاً ويخضع للبلى","زماناً طويلاً لا يقاس على الحقب",15,"ب",1,0],["يَقِيانِ في أَحَدِ الهَوادِجِ مُقلَةً","رَحَلَت فَكانَ لَها فُؤادِيَ مَحجِرا",16,"ر",2,0],["يَقيكَ الرَدى مَن يَبتَغي عِندَكَ العُلا","وَمَن قالَ لا أَرضى مِنَ العَيشِ بِالأَدنى",17,"ن",2,0],["يقيم ولا يزول بلا ذُنَيب","ولا نفس تجنّ ولا دماءَ",18,"ا",2,0],["يُقَيَّضُ لِلحَريصِ الغَيظُ بَحتاً","وَتَتَّجِهُ الحُظوظُ لِمَن قُضينا",19,"ن",2,0],["يُقيمُ عَصا الإِسلامُ مِنّا اِبنُ أَحوَزٍ","إِذا ما عَصا الإِسلامِ لانَت كُعوبُها",20,"ب",3,1],["يُقيِّدُ ألحاظَ العيونِ حِجابُه","كأنَّ بَصيرَ القومِ من دونِه أعمى",21,"ا",1,0],["يَقينُ الفَتى بِالمَوتِ شَكٌّ وَشَكُّهُ","يَقينٌ وَلَكِن لا يَراهُ يَقينا",22,"ن",2,0],["يُقيمُ مَعَ الرِجالِ إِذا أَقَمنا","وَإِن سِرنا تَسيرُ بِهِ المَطايا",23,"ا",3,0],["يقيم على الحوادث لا يبالي","ويأبى في العوادي أن يميلا",24,"ل",2,0],["يُقيمُ عَلَيها الأنسُ والصبحُ مقبلٌ","ويرحلُ عنها الوحشُ والليل معرضُ",25,"ض",1,0],["يَقِيلُ بِهَا سِرْبُ الْمَهَا وَهْوَ آمِنٌ","فَمِنْ أَرْبَدَ سَاجٍ وَأَحْوَرَ بَاغِمِ",26,"م",1,0],["يُقيمون الممالكَ واهياتٍ","يَمِلْنَ مع الرّياحِ ويَنْثَنينا",27,"ن",2,0],["يُقيمونَ صَرحَ الظُلمِ في كُلِّ أُمَّةٍ","إِذا مَلَكوا وَالعَدلُ بِالمُلكِ أَخلَقُ",28,"ق",1,0],["يُقيمُ حتى يَعودوا ثم يَصحبُهُم","إلى الرسولِ على عهدٍ وميثاقِ",29,"ق",1,0],["يُقَيِّدُ اللَحظَ فيها عَن مَسالِكِها","كَأَنَّها لَبِسَت أَثوابَ رُهبانِ",30,"ن",1,0],["يَقيلُ الحَمامُ الوُرقُ في شَجَراتِهِ","فَمِن هادِرٍ يَدعو الإِناثَ وَصافِقِ",31,"ق",1,0],["يُقيمُ بِبِضِ المَشرَفِيّاتِ وَالقَنا","وِراثَةَ مَجدٍ قَد حَمَتها جُدودُها",32,"د",3,0],["يَقيهِ مِن بَردِ النَدى بِكُمِّهِ","تَوقِيَةَ الأُمِّ اِبنَها في ضَمِّهِ",33,"م",2,0],["يُقيمُ الدُّجى أَعناقَها ويُمليها","شُعاعُ الضُّحى المُستَنُّ في كُلِّ شارقِ",34,"ق",1,0],["يقيان في أحد الهوادج مقلةً","رحلت وكان لها فؤادي محجرا",35,"ر",2,0],["يُقِيلُهُ وَيَقِيهِ","إِنْ سَامَهُ الدَّهْرُ خَسْفَهْ",36,"ف",2,0],["يقينُ بنيها على حالِهِ","وإنْ غيَّر الدهرُ أحوالها",37,"ل",3,0],["يُقَيَّضُ للحَرِيضِ الغَيْظُ بَحْتاً،","وَتَتَجِهُ الحُظُوظُ لمَنْ قُضِينَا",38,"ن",2,0],["يقيدني ثقل الهموم إلى الثرى","فليس إلى السعي الجليل سبيل",39,"ل",1,0],["يُقيل ويمسى بالنوادِرِ معلماً","إذا عَرَّسوا بالسيئاتِ وقالُوا",40,"ل",3,0],["يقيسونه بالبحرِ والبحرُ مالحُ","وقد يصفون البحر بالمدِّ والجزرِ",41,"ر",1,0],["يَقينُكَ وَالتَقوى وَجودُكَ وَالغِنى","وَلَفظُكَ وَالمَعنى وَعَزمُكَ وَالنَصرُ",42,"ر",1,0],["يَقينٌ يُريهِ الأَمرَ قَبلَ كَيانِهِ","فَيُمضي عَلى تَحقيقِهِ الأَمرَ وَالنَهيا",43,"ي",2,0],["يُقَيِّدُ بِالإِحسانِ مِن حَيثُ يُطلِقُ","عَفا كُلُّ رَسمٍ لِلمُحالِ بِحَقِّهِ",44,"ه",1,0],["يَقينٌ صَفا عَن كُلِّ رَيبٍ وَمِريَةٍ","وَحَقٌّ فَشاما إِن يُقالَ بِخُفيَةٍ",45,"ه",1,0],["يقيس ما يخفي بما أظهرته","بفطنة تشرق سر الصدر",46,"ر",1,0],["يقيك بنفسه من كل سوء","كما وقت القذا العين الجفون",47,"ن",1,0],["يقينا بأن الأَعْوَجيات فوقَه","تسير بشاهِنْشاهَ ثم تعود",48,"د",1,0],["يقيم الورد أيّاما ويمضي","ويترك عندنا خلفا مقيما",49,"م",2,1],["يقيم أياما ولا","يبقى على مر النسق",50,"ق",1,0],["يقيمهم صفا على باب غرفتي","ويبرق من خوف عليهم ويرعد",51,"د",1,0],["يقيمهُ الموجُ حرداً ثمَّ يقعدهُ","ما بينَ منسحبٍ منهُ وجرَّارِ",52,"ر",1,0],["يَقيكَ الأَسى اللَهَ دونَ غَيرِهِ","وَحَسبي إِلَهٌ نَصرُهُ خَيرُ غانِمِ",53,"م",1,0],["يُقيِّد ألفاظَ الألدِّ بلفظِهِ","ويفضُل بالحقِّ المبين المُفاضِلا",54,"ل",2,0],["يقيم بها جيلٌ من الناس أمرهم","غريبٌ كأمري في الغرام وأخفق",55,"ق",1,0],["يُقيمُ اِثنانِ في دُنيا سُكوني","فَتىً يَفنى وَآخَرُ لا يَموتُ",56,"ت",1,0],["يُقيمُ مَواسِمَ اللَذاتِ فيهِ","وُجوهٌ مِن بَني حَسَنٍ وِسامُ",57,"م",1,0],["يُقيمُ حُدودَ اللَهِ غَيرَ مُراقِبٍ","بِقائِمٍ مَطرورِ الشِبا باتِرِ الحَدِّ",58,"د",1,0],["يُقِيمُهَا حَنَقاً وَغَيْظاً","كَأَنَّهُ اغْتَاظَ مِنْ كَفُورِ",59,"ر",1,0],["يقيسونه بالبحر جهلاً بفضله","وهل يستوي العذب الفرات بمالح",60,"ح",1,0],["يُقَيِّدُ في مَنَائِحِهِ جُفونِي","وأُطْلِقُ في مَدائحِهِ عِنَانِي",61,"ن",2,0],["يَقيني هُوَ الَمَأمُولُ فِيكَ مُحَقَّقٌ","وفِي سَائِرِ الأَمْلاكِ ظَنٌّ مُرَجَّمُ",62,"م",1,0],["يُقَيِّدُنِي بِنَجْدِ الشّامِ وَجْدٌ","وَيَدْعُونِي إِلى الْغَوْرِ اعْتِزامُ",63,"م",1,0],["يَقِيني يَقِيني حَادِثاتِ النَّوائِبِ","وَحَزْمِيَ حَزْمِي في ظُهُورِ النَّجائِبِ",64,"ب",1,1],["يُقيمُ السَدادَ بِآرائِهِ","فَيُدرِكُ آراءهُ بِالحزامَه",65,"م",2,0],["يُقيمُ مِنَ المزورّ مذرى اِزوراره","وَمِن ذي صغى للعجب صاغية العجبِ",66,"ب",1,0],["يَقيني إِذا أَمسَيتُ بِالشُكرِ ناطِقاً","وَصَيَّرَني يَأسي مِنَ الناسِ واثِقا",67,"ق",2,0],["يقينُ الحياة وأوهامُها","سواءٌ إذا جفَّ إلهامُها",68,"ه",2,0],["يُقَيِّدُ صُدْغُ ذاتِ الخالِ منّي","فؤاداً ما تَخافُ له إباقا",69,"ق",2,0],["يَقي ديِنَه ويَقِي عِرْضَهُ","منَ الذَّمِّ طارِفُهُ والتّليد",70,"د",1,0],["يُقيمُ عَلى الزَمانِ وَلَو تَقَضّى","مَدى عُمري أَقامَ بلا زَمانِ",71,"ن",1,0],["يقيّدُني حبّيْك فالدمع مطْلَقٌ","عَليك وقلبي في الهوى غير مطلق",72,"ق",1,0],["يقيك اتّقاء السابغات سهامها","متى تَرْمِكَ الأَرزاء سهماً مسدَّدا",73,"د",2,0],["يقينا صروف النَّائبات كأَنَّه","لنا جبلٌ والعالمين تلول",74,"ل",1,0],["يقي من سموم الحادثات بنفسه","إذا لَفَحتْها بالسموم الهواجر",75,"ر",1,0],["يقيها سهام النائبات فلم تبل","إذا طاش سهمٌ للخطوب مسدَّد",76,"د",1,0],["يُقيمُ سُلافَ الكرْمِ بالدنّ حقبةً","ويخلَعُ عن فيها الختامَ خليعُ",77,"ع",1,0],["يَقِيها هَجيرَ القَيْظِ ظِلُّ عَجاجِها","ومُجْمِدَةَ الأَنهارِ نارُ سُيُوفِها",78,"ف",3,0],["يقيكَ الردَى غَمْرٌ يُجاريك في النَّدَى","فيعقِلُ عِيٌّ رُسْغَهُ ولُغوبُ",79,"ب",1,0],["يَقِيل إن هَجَّر في ظلِّه","ويحسب الليلَ البهيمَ الضُّحى",80,"ا",1,0],["يقيناً بأنَّ الزَّيْنبيَّ هو الذي","يُشارُ اليه في العُلى والمآثِرِ",81,"ر",1,0],["يقيناً وبُرهاناً نفى كلَّ ريبةٍ","ودلَّتْ عليه ألسْنٌ ومَسامِعُ",82,"ع",1,0],["يقيض شيطانا له في حياته","ويحشر أعمى بعد أن كان مبصرا",83,"ر",2,0],["يقيني بأن الموت للخلق غايةٌ","وأن المنايا موردُ العجم والعُربِ",84,"ب",1,0],["يقيسُهُ الخَلقُ بالغمام فما","يحمرُّ برقٌ إلا من الخطَل",85,"ل",1,0],["يقيني بأن الرزق لاشكّ كائنٌ","وعلمي بأن الله يعطي ويمنع",86,"ع",1,0],["يَقيسُ أَشعاري بِأَشعارِهِ","وَمَن يَقيسُ الرَأسَ بِالنَصلِ",87,"ل",1,0],["يقيه غوائل الصدمات حق","اضاعه في المصارعة الغشوم",88,"م",1,0],["يقيم الليل يقظانا","يخوض البحر عواما",89,"م",2,0],["يقيم من أقدامنا ما دحضا","يسيغ من آمالنا ما اعترضا",90,"ض",2,0],["يقيده الخصم العنيد بوهمه","فيطوي الفيافي ملطقاً ويسير",91,"ر",1,0],["يُقيمونَ الصَّلاةَ وهم فُرادى","لقد شردوا كما شرد النّعامُ",92,"م",1,0],["يَقِيهِ نحرِيَ مِن رامٍ فريستَه","يوم الوغى هو عُمْرَ الدَّهرِ يرميني",93,"ن",2,0],["يقينه في المعاني","غيب الغيوب وحدسه",94,"س",2,0],["يقَيِّد بالأزمانِ للدَّهْرِ مثْل ما","يكيِّف للأجسام من ذاتِهِ الأبْنا",95,"ن",2,0],["يُقيّدُ كُلَّ آبدةٍ ويَرمي","بِسهْمِ الظَنِّ في كَبِدِ اليَقينِ",96,"ن",1,0],["يقيم فيهم واجب الصلاة","لوقتها المعلوم حين يأتي",97,"ي",1,0],["يقيه ما يخافه ويحذره","بنفسه محتسبا وينصره",97,"ه",1,0],["يَقي يَومَ ضربِ الهام رُوحي بِرُوحِهِ","وَيَفدي مِنَ الأسواءِ ما لي بِمالِهِ",98