ww.aldiwan.net/poem14456.html","البسيط"],[456,"أخي وجمال الشعر ما أنت ناثر","https://www.aldiwan.net/poem61748.html","الطويل"],[461,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[461,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[461,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[464,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[464,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[464,"طليق الوجه أغلب هاشمي","https://www.aldiwan.net/poem15629.html","الوافر"],[518,"أفي كل يوم أنت باعث همة","https://www.aldiwan.net/poem12139.html","الطويل"],[546,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[554,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[572,"ذريني أَم مسكين ذريني","https://www.aldiwan.net/poem52024.html","الوافر"],[578,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/31474","الوافر"],[722,"","https://poetry.dctabudhabi.ae/diwan/poem/29533","الطويل"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67418","الطويل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20471","البسيط"],[1051,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/97730","الطويل"],[1111,"","https://poetry.dctabudhabi.ae/diwan/poem/22630","الطويل"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/75840","الوافر"],[390,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","https://www.poetsgate.com/ViewPoem.aspx?id=4653",""]],"verses":[["كَأَنَّ جَناني يَومَ وافى نَعِيُّهُ","فَرِيُّ أَديمٍ بَينَ أَيدي الخَوالِقِ",0,"ق",1,0],["كَأَنَّ جَميعَ الناسِ أَثنَوا عَشيَّةً","عَلى بَعضِ أَمطارِ الرَبيعِ المُغادِقِ",0,"ق",1,0],["كَأَنَّ جَناحَيهِ إِذا هاجَ شَوقُهُ","يَدا قَينَةٍ هَوجاءَ تَضرِبُ بِالدُفِّ",1,"ف",1,0],["كَأَنَّ جَمرَ الغَضا مَمّا أُجِنُّ لَكُم","بَينَ الضُّلوعِ إِذا أَطفأتُهُ وَقَدا",2,"د",2,0],["كَأَنَّ جَمرَ الغَضا مِما وَطِئتُ بِهِ","بَينَ الضُلوعِ إِذا سَكَّنتُهُ وَقَدا",3,"د",2,0],["كَأَنَّ جُفونَ عَيني قَد تَواصَت","بِأَن لا تَلتَقي حَتّى التَنادِ",4,"د",1,0],["كَأَنَّ جَميعَ الأَرضَ حَتّى أَراكُمُ","تَصَوَّرُ في عَيني سودَ العَقارِبِ",5,"ب",1,0],["كَأَنَّ جَنِيّاً مِنَ الزَنجَبي","لِ خالَطَ فاها وَأَرياً مَشورا",6,"ر",2,0],["كَأَنَّ جَريري يَنتَحي فيهِ مِسحَلٌ","مِنَ القُمرِ بَينَ الأَنعَمَينِ فَعاقِلِ",7,"ل",1,0],["كَأَنَّ جَماجِمَ الأَبطالِ فيه","وُسوقٌ بِالأَماعِزِ يَرتَمينا",8,"ن",2,0],["كَأَنَّ جُماناً هَوى مُرسِلاً","دُموعَهُما أَو هُما أَسرَعُ",9,"ع",1,0],["كَأَنَّ جُلاَّسَهُ مَهْمَا عَلَوْا رُتَباً","رَاجُوا صِلاتٍ عَلَيْهِمْ تُنْشَرُ النعَمُ",10,"م",1,0],["كَأَنَّ جَريري يَنتَحي فيهِ مِسحَلٌ","رَباعٌ طَوَتهُ القودُ قُبٌّ حَلائِلُه",11,"ل",2,0],["كَأَنَّ جُلودَهُنَّ مُمَوَّهاتٌ","عَلى أَبشارِها ذَهَباً زُلالا",12,"ل",2,0],["كَأَنَّ جِلدَ الوَجهِ مِن حَريرِ","أَملَسَ إِلّا خَطرَةَ الجَريرِ",13,"ر",1,0],["كأن جبال المَتن حدبة عابد","هوى ساجداً شكراً وبيروت رأسه",14,"س",2,0],["كأنّ جيوش الموت رافقة بنا","فتزحف منا للحروب جيوش",15,"ش",1,0],["كَأَنَّ جُمامَها لَمّا اِستَجَمَّت","عَنايا مُجرِبٍ فيهِنَّ قيرُ",16,"ر",1,0],["كَأَنَّ جِمالَ الحَيِّ سُربِلنَ يانِعاً","مِنَ الوارِدِ البَطحاءَ مِن نَخلِ مَلهَما",17,"م",2,0],["كأن جُمانا واهي السلك فوقه","كما انهلَّ من بيضٍ يعاليلُ تسكُبُ",18,"ب",1,1],["كأنّ جماناً واهي السّلك فوقه","بما انهلّ من بيض يعاليل تسكب",19,"ب",1,0],["كَأَنَّ جِفَانَنا في كُلِّ يَوم","لِوَاصِفِهَا جَوَابِيَ مُترَعِينَا",20,"ن",2,0],["كأن جفوني إذ تكاثر دمعها","بنان ابن فضل الله متصل المنح",21,"ح",1,0],["كأن جفوني حين تسفح بالبكى","على حبِّها كفُّ المؤيد بالتبر",22,"ر",1,0],["كأن جنح الدجى يمدُّ يداً","من الثريَّا للمسِ أقدامه",23,"م",2,0],["كأنَّ جودك قد قالتْ سوابقه","الأرض ظلِّي وكلّ الناس ضيفانِ",24,"ن",1,0],["كأنَّ جود علاء الدِّين صارَ لهُ","رواية فهو يرويها وترويه",25,"ي",2,0],["كأن جيوب الدرع منه مجوبةٌ","على قمرٍ بدرٍ وليثٍ فُصافص",26,"ص",1,0],["كأن جفوني لم تبت ذات ليلة","كراها قذاها لا تلائم مضجعا",27,"ع",2,0],["كَأَنَّ جَوانِبَ الدارِ الخَلايا","وَهُم كَالنَحلِ في الدارِ اِحتِشادا",28,"د",2,0],["كأنَّ جَآجِئاً منها وَهَاماً","أَعارَتْها النُّفُوسَ يَدا عَرُوسِ",29,"س",1,0],["كَأَنَّ جَوارِيَ المُهَجاتِ ماءٌ","يُعاوِدُها المُهَنَّدُ مِن عُطاشِ",30,"ش",1,0],["كَأَنَّ جَميعَ الأَرضِ حَتّى أَراكُمُ","تُصَوَّرُ في عَيني بِسودِ العَقارِبِ",31,"ب",1,0],["كَأَنَّ جَنى الحَوذانِ في رَونَقِ الضُحى","دَنانيرُ تِبرٍ مِن تُؤامِن وَفارِدِ",32,"د",1,0],["كَأَنَّ جِنَّ سُلَيمانَ الَّذينَ وَلوا","إِبداعَها فَأَدَقّوا في مَعانيها",33,"ي",3,0],["كَأَنَّ جُذوعِ النَخلِ لَمّا غَشينَهُ","سَوابِقَها مِن بَينِ وَردٍ وَأَشقَرا",34,"ر",2,0],["كأنَّ جَبينَه صُبْحٌ","حَوى من طُرَّةٍ ظُلَما",35,"م",2,0],["كأنَّ جُلودَ الوَحْشِ بينَ كِلابِه","وقد دَمِيَت أجيادُها والمَعاطِسُ",36,"س",1,0],["كانَ جَليداً فخانَه جَلَدُهْ","وعادَه بعدَ هِمَّةٍ كَمدُهْ",37,"د",2,1],["كَأَنَّ جَسيماتِ القَعائِدِ حَولَهُ","مِنَ الخَيلِ كُمتٌ قُرِّبَت لِرِهانِ",38,"ن",1,0],["كأنّ جبالاً بالعواصف فوقها","مُسَيَّرَةٌ من موجها المتلاطمِ",39,"م",1,0],["كَأَنَّ جَهَنَّمَ اِنضَمَّت عَلَيهِم","كِلاها غَيرَ تَبديلِ الجُلودِ",40,"د",1,0],["كَأَنَّ جَميعَ أَهليها تِجارٌ","وَكُلَّ بِلادِها لِلمَوتِ سوقُ",41,"ق",1,0],["كَأَنَّ جِراحَهُ في كُلِّ قَلبٍ","شِفاهٌ لِلمَنِيَّةِ أَو شُدوقُ",41,"ق",1,0],["كَأَنَّ جَلالَ المُلكِ لَم يَبدُ حَولَهُ","مَهيباً وَلَم تضرب عَلَيهِ مَضارِبُه",42,"ب",2,0],["كَأَنَّ جَدوى يَدَيهِ مَأدُبَةٌ","دعا إِلَيها بِبِشرِهِ الجَفَلى",43,"ل",2,0],["كان جرزيم منزهاً والغواني","في ظلال منه وماءٍ زلالِ",44,"ل",1,0],["كَأَنَّ جُلودَهُنَّ إِذا اِزلَغَبَّت","أَفاني الصَيفِ في حُردِ المُتونِ",45,"ن",1,0],["كَأَنَّ جَبينَهُ قَمَرٌ تَلالا","عَداهُ الدَجنُ مِن خَلَلِ الفِحامِ",46,"م",1,0],["كَأَنَّ جُفوني كانَت العيسُ فَوقَها","فَسارَت وَسالَت بَعدَهُنَّ المَدامِعُ",47,"ع",1,1],["كَأَنَّ جَناباوَيهِ مِن خَمِسِ الوَغى","شَمامٌ وَسَلمى أَو أَجاً وَكَواكِبُه",48,"ب",2,0],["كأنّ جُفونَهُ عُقِدتْ برَضْوَى","فما يُرْفَعْنَ مِنْ سُكْرِ المَنامِ",49,"م",1,0],["كأنّ جَناحَها قلْبُ المُعادي","وَلِيَّكَ كلّما اعْتَكَرَ الجَنانُ",50,"ن",1,0],["كَأَنَّ جَناحَي مَضرَحيٍّ تَكَنَّفا","حِفافَيهِ شُكّا في العَسيبِ بِمَسرَدِ",51,"د",1,0],["كَأَنَّ جُلودَ النُمرِ جيبَت عَلَيهِمُ","إِذا جَعجَعوا بَينَ الإِناخَةِ وَالحَبسِ",52,"س",1,0],["كَأَنَّ جَديدَ الدارِ يُبليكَ عَنهُمُ","تَقِيُّ اليَمينِ بَعدَ عَهدِكَ حالِفُ",53,"ف",1,0],["كأن جذوة نارٍ أَحرقت كَبدي","أَو كَهربائية سارَت على عصبي",54,"ب",2,0],["كَأَنَّ جَماجِمَ الأَبطالِ فيها","وُسوقٌ بِالأَماعِزِ يَرتَمينا",55,"ن",2,0],["كأنّ جِيادَهُمْ أسرابُ وَحْشٍ","أُصَرّعُهُن مِن رُبْدٍ وأُتْنِ",56,"ن",1,0],["كأنّ جَرادَ الرّمْيِ طارَ يُريدُها","جَرادُ مَصِيفٍ وافق الرّوْضَ مُجْحِدا",57,"د",2,0],["كأنّ جَفْنَيَّ سِقْطا نافِرٍ فَزِعٍ","إذا أرادَ وُقُوعاً رِيعَ أوْ ذِيدا",58,"د",2,0],["كأن جيادنا في الدار أسرى","سكوتاً لا وجيف ولا صهيلا",59,"ل",2,0],["كَأَنَّ جُمُوعَ الخَلْقِ يَوْمَ تَرَحَّلَتْ","عِيَالٌ عَلَيْهَا نَادِبٌ وَثَكُولُ",60,"ل",1,0],["كَأَنَّ جُنُودَ الْبَرِّ سَارَتْ بِنَعْشِهَا","جِبَالُ رِمَالٍ تَعْتَلِي وَتَهِيلُ",60,"ل",1,0],["كَأَنْجُمِ المِيزَانِ فِي رَمْزِهَا","إِلى تَلاَقٍ فِي العُلَى وَاتِّحَادْ",61,"د",1,0],["كَأَنَّ جَنَى كَفَّيْهِ وَقْفٌ مُقَسَّمٌ","فَكُلُّ مُرَجٍ عَائِدٌ بِنِصَابِ",62,"ب",1,0],["كأنَّ جَناحَيْهِ شِراعُ سفينةٍ","دهتها من الأرواحِ نَكْباءُ زَعْزَع",63,"ع",1,0],["كأن جفونه سملت بشوكٍ","فَلَيْسَ لِوَسْنَة ٍ فيهَا قَرَارُ",64,"ر",1,0],["كانَ جُهدُ الفلاّحِ خفَّف عنه","جَهدهُ فهو مُستكِنٌّ أديب",65,"ب",1,0],["كأن جلالَ الهوى شَّفها","ففاضتْ دموعاً وسالتْ عيونا",66,"ن",2,0],["كأنّ جَنى الحَوْذانِ، في رَوْنَقِ الضّحَى،","دَنانيرُ تبرٍ مِنْ تُؤَامٍ وَفَارِدِ",67,"د",1,0],["كأن جناحي مضرجيٍ تكنفا","حفافيه شكا في العسيب بمسرد",68,"د",1,0],["كأن جيوش الموت رافقة بنا","نجيف بأدواء الحياة مَريش",69,"ش",1,0],["كأن جميع المبصرات بناظري","حبيبي وذا حكم الغرام لمن يدري",70,"ر",2,0],["كأنّ جَنَى القُوطِيّ في رَونَق الضّحَى","وَقَد حَمَلَتهُ رَاحَةُ الوَرَقَاتِ",71,"ت",1,1],["كأن جميعَ الحُسنِ خَطَّ بوجهِهِ","كتاباً له في صفحةِ البدرِ عُنوانُ",72,"ن",1,0],["كأَنَّ جُفوني يومَ مُنْعَرَجِ اللِّوى","ملاعِبهُمْ ما بَينَ تلكَ المَلاعبِ",73,"ب",1,0],["كأنّ جيوشَ الفحمِ من فوقِ جَمْرِه","وقد جُمعا فاسْتُحْسِن الضِّدُّ بالضِّدِّ",74,"د",1,1],["كانَ جيشُ الكفّار جيشاً متينا","بِعديدٍ وعدّةٍ مَشحونا",75,"ن",2,0],["كَأَنَّ جُزوءاً لَم يَعدُ ذَلِكَ حَتّى","بَدُنَ اللَحمُ وَالبُطونُ صِغارُ",76,"ر",1,0],["كأنَّ جبينَ الفجرِ كانَ صحيفةً","كأنَّ سطورَ الخطِّ فيهِ ضبابُ",77,"ب",1,0],["كأنّ جميعَ الخلِق جسمٌ مركَّبٌ","وأنت عليه الرأسُ والكَتِفانِ",78,"ن",1,0],["كأنّ جوهَره من لطفِهِ عَرَضٌ","فليس تَحوِيه إلا أعينُ الفَطِن",79,"ن",1,0],["كَأَنَّ جَفارَ السَفحِ رَوضُ شَقائِقٍ","مُرَوَّضَّةٍ مِن دَمعِها وَبُكاها",80,"ا",3,0],["كَأَنَّ جُفوني في السَماحِ بِمائِها","بَوارِعُ مِن جَدوى الوَزيرِ مُحَمَّدِ",81,"د",1,0],["كَأَنَّ جَوائِزَ الغاياتِ مِنها","عَلى أَكتافِها ذَهَبٌ مُذابُ",82,"ب",1,0],["كَأَنَّ جَنَاهَا مِنْ جَنَي العَيْشِ بَعْدَهَا","لِيَحْيَى بْنِ عَبْدِ الوَاحِدِ بنِ أبِي حَفْصِ",83,"ص",1,0],["كان جسّاسٌ وَقد أهدى له","في كليبٍ عمّه ضوءَ القَمَر",84,"ر",1,0],["كَأَنَّ جُلودَها إِذ بانَ عَنها","نَسيلُ الصَيفِ بِالصَيفِ المُلاءُ",85,"ا",2,0],["كأنَّ جبينَه سيفٌ صقيلٌ","أجادَ يدُ الجمالِ له الصِّقالا",86,"ل",2,0],["كأن جَفْنيَّ طُولَ اللّيلِ من أرَقٍ","على حَجاجَيَّ بالأهدابِ قد سُمِرا",87,"ر",2,0],["كأنّ جَفْنِيَ إكراماً لزائرِه","أمسَى على قَدمَيْه ناثرَ الدُّرر",88,"ر",1,0],["كَأَنَّ جُفوني السُحبُ وَالقَطرُ أَدمُعي","وَقَد أَمطَرَت فِكري فَقَد أَنبَتَ الشِعرا",89,"ر",2,0],["كَأَنَّ جودَ يَدَيهِ عَينُ مَكرُمَةٍ","كِلاهُما ما عَداهُ مُسبَلُ الحُجُبِ",90,"ب",1,0],["كَأَنَّ جَبين الصُبح سِرّاً أَسرَّه","ضَمير الدُجى ما إِن يُريد لَهُ نَشرا",91,"ر",2,0],["كَأَنَّ جَنيباً عِندَ مَعقِدِ غَرزِها","تُراوِدُهُ عَن نفسِهِ وَيُريدُها",92,"د",3,0],["كَأَنَّ جِسمي غَنيمَة وَيَدي","بِالحَكِّ فيهِ تَجوبُ في نَهبِ",93,"ب",1,0],["كأنَّ جفونَها بالسِّحرِ منها","سُكارى والنفوس بها سُكارى",94,"ر",2,0],["كَأَنْجُمِ يوسُفٍ عَدَداً ولكِنْ","بِرؤْيَا هَذِهِ بَرِحَ الخَفاءُ",95,"ا",2,0],["كَأَنَّ جَمْعَ ضلالٍ حانَ مَصرَعُهُ","وأنتَ بالسيفِ يَا مَنصورُ صارِعُهُ",96,"ع",2,0],["كأن جبال ذاك الما س