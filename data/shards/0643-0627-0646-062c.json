x?id=61738",""],[4884,"قمريّةَ الأيك","https://www.poetsgate.com/ViewPoem.aspx?id=202180",""],[4927,"لصوص المخابرات","https://www.poetsgate.com/ViewPoem.aspx?id=80802",""],[5064,"ما لم تَستطِعْهُ المحابِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=200052",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5298,"أَلاَ إِنَّ هِنْداً أَمْسِ رَثَّ جَدِيدُها","https://www.poetsgate.com/ViewPoem.aspx?id=183374",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5409,"شقاءٌ في شبابي والمشيب","https://www.poetsgate.com/ViewPoem.aspx?id=155252",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5411,"ناقوس روحي","https://www.poetsgate.com/ViewPoem.aspx?id=187568",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5444,"سجن وكراسي","https://www.poetsgate.com/ViewPoem.aspx?id=205076",""],[5582,"لِمَنْ تِلْكَ الهَوادِجُ وَالحُدُوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=186779",""],[5582,"أَلا كُلُّ عَيْشٍ صَفْوُهُ يَتَكَدَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187148",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5638,"أمي (أنشودة للأطفال)","https://www.poetsgate.com/ViewPoem.aspx?id=199069",""],[5690,"أسيرُ وقلبي في الغرام أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172162",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[6102,"أَحَقُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182816",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[520,"أفي كل يوم انت باعث همة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577543",""],[402,"قضى الذي كان ناديه ومحضره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54026&r=&rc=878",""]],"verses":[["كَأَنَّ جَناني يَومَ وافى نَعِيُّهُ","فَرِيُّ أَديمٍ بَينَ أَيدي الخَوالِقِ",0,"ق",1,0],["كَأَنَّ جَميعَ الناسِ أَثنَوا عَشيَّةً","عَلى بَعضِ أَمطارِ الرَبيعِ المُغادِقِ",0,"ق",1,0],["كَأَنَّ جَناحَيهِ إِذا هاجَ شَوقُهُ","يَدا قَينَةٍ هَوجاءَ تَضرِبُ بِالدُفِّ",1,"ف",1,0],["كَأَنَّ جَمرَ الغَضا مَمّا أُجِنُّ لَكُم","بَينَ الضُّلوعِ إِذا أَطفأتُهُ وَقَدا",2,"د",2,0],["كَأَنَّ جَمرَ الغَضا مِما وَطِئتُ بِهِ","بَينَ الضُلوعِ إِذا سَكَّنتُهُ وَقَدا",3,"د",2,0],["كَأَنَّ جُفونَ عَيني قَد تَواصَت","بِأَن لا تَلتَقي حَتّى التَنادِ",4,"د",1,0],["كَأَنَّ جَميعَ الأَرضَ حَتّى أَراكُمُ","تَصَوَّرُ في عَيني سودَ العَقارِبِ",5,"ب",1,0],["كَأَنَّ جَنِيّاً مِنَ الزَنجَبي","لِ خالَطَ فاها وَأَرياً مَشورا",6,"ر",2,0],["كَأَنَّ جَريري يَنتَحي فيهِ مِسحَلٌ","مِنَ القُمرِ بَينَ الأَنعَمَينِ فَعاقِلِ",7,"ل",1,0],["كَأَنَّ جَماجِمَ الأَبطالِ فيه","وُسوقٌ بِالأَماعِزِ يَرتَمينا",8,"ن",2,0],["كَأَنَّ جُماناً هَوى مُرسِلاً","دُموعَهُما أَو هُما أَسرَعُ",9,"ع",1,0],["كَأَنَّ جُلاَّسَهُ مَهْمَا عَلَوْا رُتَباً","رَاجُوا صِلاتٍ عَلَيْهِمْ تُنْشَرُ النعَمُ",10,"م",1,0],["كَأَنَّ جَريري يَنتَحي فيهِ مِسحَلٌ","رَباعٌ طَوَتهُ القودُ قُبٌّ حَلائِلُه",11,"ل",2,0],["كَأَنَّ جُلودَهُنَّ مُمَوَّهاتٌ","عَلى أَبشارِها ذَهَباً زُلالا",12,"ل",2,0],["كَأَنَّ جِلدَ الوَجهِ مِن حَريرِ","أَملَسَ إِلّا خَطرَةَ الجَريرِ",13,"ر",1,0],["كأن جبال المَتن حدبة عابد","هوى ساجداً شكراً وبيروت رأسه",14,"س",2,0],["كأنّ جيوش الموت رافقة بنا","فتزحف منا للحروب جيوش",15,"ش",1,0],["كَأَنَّ جُمامَها لَمّا اِستَجَمَّت","عَنايا مُجرِبٍ فيهِنَّ قيرُ",16,"ر",1,0],["كَأَنَّ جِمالَ الحَيِّ سُربِلنَ يانِعاً","مِنَ الوارِدِ البَطحاءَ مِن نَخلِ مَلهَما",17,"م",2,0],["كأن جُمانا واهي السلك فوقه","كما انهلَّ من بيضٍ يعاليلُ تسكُبُ",18,"ب",1,1],["كأنّ جماناً واهي السّلك فوقه","بما انهلّ من بيض يعاليل تسكب",19,"ب",1,0],["كَأَنَّ جِفَانَنا في كُلِّ يَوم","لِوَاصِفِهَا جَوَابِيَ مُترَعِينَا",20,"ن",2,0],["كأن جفوني إذ تكاثر دمعها","بنان ابن فضل الله متصل المنح",21,"ح",1,0],["كأن جفوني حين تسفح بالبكى","على حبِّها كفُّ المؤيد بالتبر",22,"ر",1,0],["كأن جنح الدجى يمدُّ يداً","من الثريَّا للمسِ أقدامه",23,"م",2,0],["كأنَّ جودك قد قالتْ سوابقه","الأرض ظلِّي وكلّ الناس ضيفانِ",24,"ن",1,0],["كأنَّ جود علاء الدِّين صارَ لهُ","رواية فهو يرويها وترويه",25,"ي",2,0],["كأن جيوب الدرع منه مجوبةٌ","على قمرٍ بدرٍ وليثٍ فُصافص",26,"ص",1,0],["كأن جفوني لم تبت ذات ليلة","كراها قذاها لا تلائم مضجعا",27,"ع",2,0],["كَأَنَّ جَوانِبَ الدارِ الخَلايا","وَهُم كَالنَحلِ في الدارِ اِحتِشادا",28,"د",2,0],["كأنَّ جَآجِئاً منها وَهَاماً","أَعارَتْها النُّفُوسَ يَدا عَرُوسِ",29,"س",1,0],["كَأَنَّ جَوارِيَ المُهَجاتِ ماءٌ","يُعاوِدُها المُهَنَّدُ مِن عُطاشِ",30,"ش",1,0],["كَأَنَّ جَميعَ الأَرضِ حَتّى أَراكُمُ","تُصَوَّرُ في عَيني بِسودِ العَقارِبِ",31,"ب",1,0],["كَأَنَّ جَنى الحَوذانِ في رَونَقِ الضُحى","دَنانيرُ تِبرٍ مِن تُؤامِن وَفارِدِ",32,"د",1,0],["كَأَنَّ جِنَّ سُلَيمانَ الَّذينَ وَلوا","إِبداعَها فَأَدَقّوا في مَعانيها",33,"ي",3,0],["كَأَنَّ جُذوعِ النَخلِ لَمّا غَشينَهُ","سَوابِقَها مِن بَينِ وَردٍ وَأَشقَرا",34,"ر",2,0],["كأنَّ جَبينَه صُبْحٌ","حَوى من طُرَّةٍ ظُلَما",35,"م",2,0],["كأنَّ جُلودَ الوَحْشِ بينَ كِلابِه","وقد دَمِيَت أجيادُها والمَعاطِسُ",36,"س",1,0],["كانَ جَليداً فخانَه جَلَدُهْ","وعادَه بعدَ هِمَّةٍ كَمدُهْ",37,"د",2,1],["كَأَنَّ جَسيماتِ القَعائِدِ حَولَهُ","مِنَ الخَيلِ كُمتٌ قُرِّبَت لِرِهانِ",38,"ن",1,0],["كأنّ جبالاً بالعواصف فوقها","مُسَيَّرَةٌ من موجها المتلاطمِ",39,"م",1,0],["كَأَنَّ جَهَنَّمَ اِنضَمَّت عَلَيهِم","كِلاها غَيرَ تَبديلِ الجُلودِ",40,"د",1,0],["كَأَنَّ جَميعَ أَهليها تِجارٌ","وَكُلَّ بِلادِها لِلمَوتِ سوقُ",41,"ق",1,0],["كَأَنَّ جِراحَهُ في كُلِّ قَلبٍ","شِفاهٌ لِلمَنِيَّةِ أَو شُدوقُ",41,"ق",1,0],["كَأَنَّ جَلالَ المُلكِ لَم يَبدُ حَولَهُ","مَهيباً وَلَم تضرب عَلَيهِ مَضارِبُه",42,"ب",2,0],["كَأَنَّ جَدوى يَدَيهِ مَأدُبَةٌ","دعا إِلَيها بِبِشرِهِ الجَفَلى",43,"ل",2,0],["كان جرزيم منزهاً والغواني","في ظلال منه وماءٍ زلالِ",44,"ل",1,0],["كَأَنَّ جُلودَهُنَّ إِذا اِزلَغَبَّت","أَفاني الصَيفِ في حُردِ المُتونِ",45,"ن",1,0],["كَأَنَّ جَبينَهُ قَمَرٌ تَلالا","عَداهُ الدَجنُ مِن خَلَلِ الفِحامِ",46,"م",