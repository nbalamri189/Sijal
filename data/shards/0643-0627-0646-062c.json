عيدنا الثاني","https://www.aldiwan.net/poem20159.html","البسيط"],[72,"لو أن شكوى الأسى يا عز يغنيه","https://www.aldiwan.net/poem20566.html","البسيط"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[56,"وأحمر مذبح وقرا وزور","https://www.aldiwan.net/poem58563.html","الطويل"],[43,"مبيتي من دمشق على فراش","https://www.aldiwan.net/poem9714.html","الوافر"],[45,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem11438.html","الطويل"],[45,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[28,"ونحن حدرنا طيئا عن جبالها","https://www.aldiwan.net/poem5062.html","الطويل"],[61,"غدت لذاتنا أمما","https://www.aldiwan.net/poem51435.html","مجزوء الوافر"],[61,"إذا ما دعونا لاحقا ومعانقا","https://www.aldiwan.net/poem51590.html","الطويل"],[61,"كان جليدا فخانه جلده","https://www.aldiwan.net/poem51718.html","المنسرح"],[2,"تبين خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem25003.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[81,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[48,"غنيت عن الكواعب بالغلام","https://www.aldiwan.net/poem65250.html","الوافر"],[50,"كأن جفوني كانت العيس فوقها","https://www.aldiwan.net/poem62339.html","الطويل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[19,"أجاعلة أم الحصين خزاية","https://www.aldiwan.net/poem346.html",""],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16678","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16696","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16658","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16634","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55139","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.poetsgate.com/ViewPoem.aspx?id=22673",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[45,"مِثَالُكَ مِنْ طَيْفِ الخَيَالِ المُعَاوِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31687",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[88,"أرى عيشنا تأبى المنون امتداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19566&r=&rc=69",""]],"verses":[["كَأَنَّ جَناني يَومَ وافى نَعِيُّهُ","فَرِيُّ أَديمٍ بَينَ أَيدي الخَوالِقِ",0,"ق",1,0],["كَأَنَّ جَميعَ الناسِ أَثنَوا عَشيَّةً","عَلى بَعضِ أَمطارِ الرَبيعِ المُغادِقِ",0,"ق",1,0],["كَأَنَّ جَناحَيهِ إِذا هاجَ شَوقُهُ","يَدا قَينَةٍ هَوجاءَ تَضرِبُ بِالدُفِّ",1,"ف",1,0],["كَأَنَّ جَمرَ الغَضا مَمّا أُجِنُّ لَكُم","بَينَ الضُّلوعِ إِذا أَطفأتُهُ وَقَدا",2,"د",2,0],["كَأَنَّ جَمرَ الغَضا مِما وَطِئتُ بِهِ","بَينَ الضُلوعِ إِذا سَكَّنتُهُ وَقَدا",3,"د",2,0],["كَأَنَّ جُفونَ عَيني قَد تَواصَت","بِأَن لا تَلتَقي حَتّى التَنادِ",4,"د",1,0],["كَأَنَّ جَميعَ الأَرضَ حَتّى أَراكُمُ","تَصَوَّرُ في عَيني سودَ العَقارِبِ",5,"ب",1,0],["كَأَنَّ جَنِيّاً مِنَ الزَنجَبي","لِ خالَطَ فاها وَأَرياً مَشورا",6,"ر",2,0],["كَأَنَّ جَريري يَنتَحي فيهِ مِسحَلٌ","مِنَ القُمرِ بَينَ الأَنعَمَينِ فَعاقِلِ",7,"ل",1,0],["كَأَنَّ جَماجِمَ الأَبطالِ فيه","وُسوقٌ بِالأَماعِزِ يَرتَمينا",8,"ن",2,0],["كَأَنَّ جُماناً هَوى مُرسِلاً","دُموعَهُما أَو هُما أَسرَعُ",9,"ع",1,0],["كَأَنَّ جُلاَّسَهُ مَهْمَا عَلَوْا رُتَباً","رَاجُوا صِلاتٍ عَلَيْهِمْ تُنْشَرُ النعَمُ",10,"م",1,0],["كَأَنَّ جَريري يَنتَحي فيهِ مِسحَلٌ","رَباعٌ طَوَتهُ القودُ قُبٌّ حَلائِلُه",11,"ل",2,0],["كَأَنَّ جُلودَهُنَّ مُمَوَّهاتٌ","عَلى أَبشارِها ذَهَباً زُلالا",12,"ل",2,0],["كَأَنَّ جِلدَ الوَجهِ مِن حَريرِ","أَملَسَ إِلّا خَطرَةَ الجَريرِ",13,"ر",1,0],["كأن جبال المَتن حدبة عابد","هوى ساجداً شكراً وبيروت رأسه",14,"س",2,0],["كأنّ جيوش الموت رافقة بنا","فتزحف منا للحروب جيوش",15,"ش",1,0],["كَأَنَّ جُمامَها لَمّا اِستَجَمَّت","عَنايا مُجرِبٍ فيهِنَّ قيرُ",16,"ر",1,0],["كَأَنَّ جِمالَ الحَيِّ سُربِلنَ يانِعاً","مِنَ الوارِدِ البَطحاءَ مِن نَخلِ مَلهَما",17,"م",2,0],["كأن جُمانا واهي السلك فوقه","كما انهلَّ من بيضٍ يعاليلُ تسكُبُ",18,"ب",1,1],["كأنّ جماناً واهي السّلك فوقه","بما انهلّ من بيض يعاليل تسكب",19,"ب",1,0],["كَأَنَّ جِفَانَنا في كُلِّ يَوم","لِوَاصِفِهَا جَوَابِيَ مُترَعِينَا",20,"ن",2,0],["كأن جفوني إذ تكاثر دمعها","بنان ابن فضل الله متصل المنح",21,"ح",1,0],["كأن جفوني حين تسفح بالبكى","على حبِّها كفُّ المؤيد بالتبر",22,"ر",1,0],["كأن جنح الدجى يمدُّ يداً","من الثريَّا للمسِ أقدامه",23,"م",2,0],["كأنَّ جودك قد قالتْ سوابقه","الأرض ظلِّي وكلّ الناس ضيفانِ",24,"ن",1,0],["كأنَّ جود علاء الدِّين صارَ لهُ","رواية فهو يرويها وترويه",25,"ي",2,0],["كأن جيوب الدرع منه مجوبةٌ","على قمرٍ بدرٍ وليثٍ فُصافص",26,"ص",1,0],["كأن جفوني لم تبت ذات ليلة","كراها قذاها لا تلائم مضجعا",27,"ع",2,0],["كَأَنَّ جَوانِبَ الدارِ الخَلايا","وَهُم كَالنَحلِ في الدارِ اِحتِشادا",28,"د",2,0],["كأنَّ جَآجِئاً منها وَهَاماً","أَعارَتْها النُّفُوسَ يَدا عَرُوسِ",29,"س",1,0],["كَأَنَّ جَوارِيَ المُهَجاتِ ماءٌ","يُعاوِدُها المُهَنَّدُ مِن عُطاشِ",30,"ش",1,0],["كَأَنَّ جَميعَ الأَرضِ حَتّى أَراكُمُ","تُصَوَّرُ في عَيني بِسودِ العَقارِبِ",31,"ب",1,0],["كَأَنَّ جَنى الحَوذانِ في رَونَقِ الضُحى","دَنانيرُ تِبرٍ مِن تُؤامِن وَفارِدِ",32,"د",1,0],["كَأَنَّ جِنَّ سُلَيمانَ الَّذينَ وَلوا","إِبداعَها فَأَدَقّوا في مَعانيها",33,"ي",3,0],["كَأَنَّ جُذوعِ النَخلِ لَمّا غَشينَهُ","سَوابِقَها مِن بَينِ وَردٍ وَأَشقَرا",34,"ر",2,0],["كأنَّ جَبينَه صُبْحٌ","حَوى من طُرَّةٍ ظُلَما",35,"م",2,0],["كأنَّ جُلودَ الوَحْشِ بينَ كِلابِه","وقد دَمِيَت أجيادُها والمَعاطِسُ",36,"س",1,0],["كانَ جَليداً فخانَه جَلَدُهْ","وعادَه بعدَ هِمَّةٍ كَمدُهْ",37,"د",2,1],["كَأَنَّ جَسيماتِ القَعائِدِ حَولَهُ","مِنَ الخَيلِ كُمتٌ قُرِّبَت لِرِهانِ",38,"ن",1,0],["كأنّ جبالاً بالعواصف فوقها","مُسَيَّرَةٌ من موجها المتلاطمِ",39,"م",1,0],["كَأَنَّ جَهَنَّمَ اِنضَمَّت عَلَيهِم","كِلاها غَيرَ تَبديلِ الجُلودِ",40,"د",1,0],["كَأَنَّ جَميعَ أَهليها تِجارٌ","وَكُلَّ بِلادِها لِلمَوتِ سوقُ",41,"ق",1,0],["كَأَنَّ جِراحَهُ في كُلِّ قَلبٍ","شِفاهٌ لِلمَنِيَّةِ أَو شُدوقُ",41,"ق",1,0],["كَأَنَّ جَلالَ المُلكِ لَم يَبدُ حَولَهُ","مَهيباً وَلَم تضرب عَلَيهِ مَضارِبُه",42,"ب",2,0],["كَأَنَّ جَدوى يَدَيهِ مَأدُبَةٌ","دعا إِلَيها بِبِشرِهِ الجَفَلى",43,"ل",2,0],["كان جرزيم منزهاً والغواني","في ظلال منه وماءٍ زلالِ",44,"ل",1,0],["كَأَنَّ جُلودَهُنَّ إِذا اِزلَغَبَّت","أَفاني الصَيفِ في حُردِ المُتونِ",45,"ن",1,0],["كَأَنَّ جَبينَهُ قَمَرٌ تَلالا","عَداهُ الدَجنُ مِن خَلَلِ الفِحامِ",46,"م",1,0],["كَأَنَّ جُفوني كانَت العيسُ فَوقَها","فَسارَت وَسالَت بَعدَهُنَّ المَدامِعُ",47,"ع",1,1],["كَأَنَّ جَناباوَيهِ مِن خَمِسِ الوَغى","شَمامٌ وَسَلمى أَو أَجاً وَكَواكِبُه",48,"ب",2,0],["كأنّ جُفونَهُ عُقِدتْ برَضْوَى","فما يُرْفَعْنَ مِنْ سُكْرِ المَنامِ",49,"م",1,0],["كأنّ جَناحَها قلْبُ المُعادي","وَلِيَّكَ كلّما اعْتَكَرَ الجَنانُ",50,"ن",1,0],