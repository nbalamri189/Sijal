{"poems":[[55,"يا ذاكر النعماء إن نسيت","https://www.aldiwan.net/poem30191.html","الكامل"],[53,"لا أزال اللَّه نعمته","https://www.aldiwan.net/poem61963.html","المديد"],[47,"لا أرى بالعقيق رسما يجيب","https://www.aldiwan.net/poem62639.html","الخفيف"],[63,"صبابة منك لجت في تماديها","https://www.aldiwan.net/poem51400.html","البسيط"],[48,"لو شاء ربي لصاغني ملكا","https://www.aldiwan.net/poem22596.html","المنسرح"],[47,"لا أرى بالعقيق رسما يجيب","https://www.poetsgate.com/ViewPoem.aspx?id=33099",""],[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104543","المديد"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64001","البسيط"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29575","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125462","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108304","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91854","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76708","الخفيف"],[2110,"لا تبك رسما عفا ولا طللا","https://www.poetsgate.com/ViewPoem.aspx?id=156290",""]],"verses":[["لا أَزلَقَ اليَومُ العَبوسُ لَكُم","قَدَماً وَلا أَطفى لَكُم قَبَسا",0,"س",2,0],["لا أزال اللَّه نعمَته","من جواد آخر الأبدِ",1,"د",1,1],["لا أَزورُ الشَآمَ إِلّا رَقيبٌ","لي عَلى الخِلِّ أَو عَلَيَّ رَقيبُ",2,"ب",1,0],["لا أزجُرُ الدَّمعَ إن هَمَّت سَواكبُه","والنفسُ قد بَعُدَت منها أمانِيها",3,"ي",3,0],["لا أَزعُمُ الصَفوَ مازِجاً كَدَراً","بَل مَزعَمي أَنَّ كُلَّهُ كَدَرُ",4,"ر",1,0],["لا أزور الشآم غلا رقيب","لي على الخل أو علي رقيب",5,"ب",1,0],["لا أَزْمَعَ الغَيْثُ عَنْكَ بَيْنَاً","وَلاَ دَرَى المُزْنُ ما الزِّمَاعُ",6,"ع",1,0],["لا أَزال الإِلَهُ دَولَتَهُ الغَر","را وَإِن كانَ قَد طَغى وَتَجَبَّر",7,"ر",1,0],["لا إزارٌ عنكَ يَحجبُها","في تعاليها ولا وَزَرُ",8,"ر",1,0],["لا أزْمَعَ الغيثُ عنكِ بَيْناً","ولا درى الغيثُ ما الزِّماع",9,"ع",1,0],["لا أَزالَ الإِلَهُ فِعلكَ ما غَر","رَدَ حادٍ وَما شَدَت وَرقاءُ",10,"ا",2,0],["لا أزالُ الوَفيَّ في عهدِ حُبِّي","فاذكري إذ ملأتِ كأسَ الدَّوَالي",11,"ل",2,0],["لا أزال يشقى عدوّ","له ولا زالَ يسعد",12,"د",1,0],["لا أَزهرت جَناتُها أَزماننا","إِلا وَغنتها لذاكَ بلابلي",13,"ل",2,0],["لا أزيد الجفاء فيه شقوقا","غدر الدهر بي لئن رمتُ غدرا",14,"ر",2,0],["لا أزجرن المطي نحو حمى","علياه تطوي بكدها السبلا",15,"ل",2,0]]}