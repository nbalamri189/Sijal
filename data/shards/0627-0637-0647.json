{"poems":[[44,"ألم تر اني والتكرم شيمتي","https://www.aldiwan.net/poem50413.html","الطويل"],[29,"أمست طهية كالبكار أفزها","https://www.aldiwan.net/poem5958.html","الكامل"],[99,"لمن الصمت والفؤاد المشرد","https://www.aldiwan.net/poem24604.html","مجزوء الوافر"],[107,"رب أحببني وأحبب أسرتي","https://www.aldiwan.net/poem43384.html","الكامل"],[48,"رويدك لو كشفت ما أنا مضمر","https://www.aldiwan.net/poem23361.html","الطويل"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70821","السريع"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202123","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118424","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201765","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4805,"من كوثر الحُسن ارتوت بالعذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=176497",""],[5431,"فلا تسأل سؤالك ليس يجدي!...","https://www.poetsgate.com/ViewPoem.aspx?id=191234",""],[5899,"داليا","https://www.poetsgate.com/ViewPoem.aspx?id=31373",""],[5190,"ثمن الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78316&r=&rc=29",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["أُطَهِّر أَثوابي مِنَ الغَدرِ والخَنا","وَأَنحو إِلى ما كانَ خَيراً وَأَمجَدا",0,"د",2,0],["أَطُهَيُّ قَد غَرِقَ الفَرَزدَقُ فَاِعلَموا","في اليَمِّ ثُمَّ رَمى بِهِ في الساحِلِ",1,"ل",1,0],["أطهراً تدعي اليوم","فماذا نلت من طهر",2,"ر",1,0],["أَطهَرُ الأَقلامِ مِن آثارِها","حينَ أُحصيها وَأَزكى الأَلسُنِ",3,"ن",1,0],["أُطَهِّرُ جِسمي شاتِياً وَمُقَيِّظاً","وَقَلبي أَولى بِالطَهارَةِ مِن جِسمي",4,"ي",1,0],["أ طه مات لا تبكوا عليه","ففي روض الخلود له مجالُ",5,"ل",1,0],["أ طه مات لا أدري فإني","أكذب كل يوم ما يقال",5,"ل",1,0],["أطَهّر قومي من الموبقات","وأدفع عنهم صروف القضاء",6,"ا",2,0],["أطهر من ماء الغمام باطناً","لا حقده يرجى ولا أسراره",7,"ر",2,0],["أطهرُ منها الكلبُ لو لم يكنْ","مكلِّبٌ في صُغْره كلَّبَه",8,"ب",2,0],["أطهر نفسي حين أفديكم بها","فتطهيرها أن تفتدي لبني الطهر",9,"ر",1,0],["أطهر الناسِ مئزراً ورداء","الغيب أنقى على العفاف جيوبا",10,"ب",2,0],["اطهرته للناس انت لكي ترى","عليك خفايا الحسن تبدو علانيه",11,"ي",2,0],["أطهّر النفس من عادات مجتمعي","بوحدةٍ تصهر الأخلاق والفِطنا",12,"ن",2,0],["أطهرهم شيمة وأظهرهم","حزبا له الحق دينه رصنا",13,"ن",2,0],["اطهر من الغيم وطبيعي تنوبه","ولا ذعذعت روح الهواء من مهبه",14,"ب",2,0],["أطهر من غسيل الحب روحي","ويشربني زلا لا صرت كُلا",15,"ل",2,0],["أطهارة أم فتنة","تمشي على أقدامها",16,"ا",1,0],["أُطهرُ الروحَ من ذنبِ اغترابي ، ومن","ليلٍ طوتني بِهِ الأمصارُ والدولُ",17,"ل",1,0],["أطهارَها، أطيابها، أنجابها","وله مآثر ليس تحصى لو غدت",18,"ت",1,0]]}