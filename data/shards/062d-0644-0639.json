{"poems":[[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[46,"أي ندى بين الثرى والجبوب","https://www.aldiwan.net/poem30321.html","الرجز"],[50,"إصدع نجي الهموم بالطرب","https://www.aldiwan.net/poem10775.html","المنسرح"],[287,"حل عقد التركي بند القباء","https://www.aldiwan.net/poem32901.html","الخفيف"],[473,"حل عقد اللثام عن بستان","https://www.aldiwan.net/poem59627.html","الخفيف"],[580,"حل عقداً كله قبل","https://www.aldiwan.net/poem2936.html","المديد"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63732","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119878","المديد"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111167","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126205","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106979","الرجز"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100439","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100254","السريع"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111057","الخفيف"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4984,"منَّة رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=180976",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""]],"verses":[["حلّ عليّ بجسمي خائف","فحلّ أمنٌ بعد تحريم",0,"م",1,0],["حَلَّ عُقالَيها كَما أَطلَقَت","مِن عُقَدِ المُزنَةِ ريحُ الجَنوبِ",1,"ب",1,0],["حَلَّ عَلى وَجهِهِ الجَمالُ كَما","حَلَّ يَزيدٌ مَعالِيَ الرُتَبِ",2,"ب",1,0],["حلَّ عَقدُ التركيّ بندَ القباءِ","عِقدَ صَبري لأعين الرقباءِ",3,"ا",2,1],["حَلَّ عِقدَ اللِثامِ عَن بُستانِ","وَاِنثَنى كَاِنثِناءَ خوطِ البانِ",4,"ن",1,1],["حَلَّ عِقْداً كلُّهُ قُبَلُ","عِقْدُ لَثْمٍ كُلُّهُ دُرَرُ",5,"ر",1,1],["حلَّ عنها كملحةِ البَصرِ اللاَّ","مِحِ في حيثُ زاغتِ الأبصار",6,"ر",1,0],["حل عزم الدهر منه فتى","عزمه بالنصر مقصودُ",7,"د",1,0],["حل عرى الصبر يوم شد","الزنار في كشحه المخصر",8,"ر",1,0],["حَلَّ عن وجهِهِا الخِمَارَ فهذا","لِضياءِ النَّهارِ وَجهٌ مَزِيحُ",9,"ح",1,0],["حلّ عرى صبري بعين نفثت","سحر الهوى وليس فيها عقد",10,"د",1,0],["حل عزى صبري في لواحظ","نفاثة السحر لقلبي بالعقد",11,"د",1,0],["حَلَّ عُرى الصبر بفتانة","نفاثةٍ أجفانها بالعقد",12,"د",1,0],["حل عنها فقد بلغت مراداً","قتبا حك متنها والسناما",13,"م",2,0],["حل عند اليونان فاستقبلوه","بمحياً طلقٍ ونفس رضيَّة",14,"ي",2,0],["حَلَّ علينا الخيرُ من فضله","مما ينال الصائم الساجد",15,"د",1,0],["حل عني يا شيخ ناشدتك الله،","كفاني ما حل بي من شرور",16,"ر",1,0],["حل عليهم بغيه فأحلهم","حضيض الردى لما تولى وأفسدا",17,"د",2,0]]}