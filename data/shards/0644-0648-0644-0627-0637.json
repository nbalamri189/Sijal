{"poems":[[55,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[189,"فكأنني ظمآن ضل بقفزة","https://www.aldiwan.net/poem14564.html","الكامل"],[285,"مولاي تصبر عن أديبك","https://www.aldiwan.net/poem60571.html","مجزوء الكامل"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[484,"لست الإله ولست بالشيطان","https://www.aldiwan.net/poem36946.html","الكامل"],[520,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96981","الكامل"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/144330","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130203","الكامل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145641","البسيط"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198977","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110333","الكامل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139838",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59496","الكامل"],[5763,"طعنٌ بلا موتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27067",""],[5956,"هجاء","https://www.poetsgate.com/ViewPoem.aspx?id=192939",""]],"verses":[["لَولا طِلابُ النَصلِ يورِقُ عودُهُ","باتَ النِساءُ سُدىً بِغَيرِ بُعولِ",0,"ل",1,0],["لَولا طِلابُ العُلا لَم يَبتَغوا بَدَلاً","مِن طيبِ رَيّاكَ لَكِنَّ العُلا تَعَبُ",1,"ب",1,0],["لولا طِرادُ الخيل لم تكُ لذةٌ","فتَطارَدِى لي بالوصال قليلاً",2,"ل",2,0],["لَوْلا طُلُوعُكَ لَمْ تُنِرْ","فَاللهُ يُؤْمِنُ مِنْ مَغِيبِكْ",3,"ك",1,0],["لولا طُروقُ خيالٍ منكَ مُنتظَرِ","يُلمُّ بي راقداً ما ساءني سَهَري",4,"ر",2,1],["لولا طلول من بقايا الود في","صدري لما خاطبتكم في شاني",5,"ن",2,0],["لولا طلوع طلائع ما أشرقت","نار الهدى في جنح ليل أليل",6,"ل",1,0],["لولا طلابهم بقا","ء سلالة الهادي البشير",7,"ر",1,0],["لولا طلائعُ لم نكنْ","نرجو لمَيْتِ الدينِ نَشْرا",8,"ر",2,0],["لولا طلاقة وجهه لو يلقه","السيف الصقيل لما استقر بغمده",9,"د",2,0],["لَوْلا طِباعُ التَّأَسِّي والمِرَاسُ وَمَا","حَفِظْتُ مِنْ قِيَمٍ جَلّتْ مآسِينا",10,"ن",2,0],["لولا طلابي غريب المدح فيك لما","وصفت قبل علاك السيف والقلما",11,"م",2,0],["لولا طوالعهم لما واجهت في","لبنان غير طلائع النكبات",12,"ت",1,0],["لولا طلاب العلى إذ نام طالبها","ما كنت ممن يبيع اليسر بالعسر",13,"ر",1,0],["لولا طلابي للعُلى","وسموُّ نفسي للفضائلْ",14,"ل",1,1],["لولا طعونُكِ ما كتبتُ قصيدتي","ولماجهرْتُ بثورةٍ لا تُحضنُ",15,"ن",1,0],["لولا طلبتَ الشعر منّي لم أكنْ","متنازلاً عن برجيَ المترفعِ",16,"ع",1,0]]}