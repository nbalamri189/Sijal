{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[73,"ألا يا عفيف الدين هل أنت مخبري","https://www.aldiwan.net/poem3844.html","الطويل"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[31,"أتعرف من أسماء بالجد روسما","https://www.aldiwan.net/poem6156.html","الطويل"],[30,"إني حلفت برب البدن مشعرة","https://www.aldiwan.net/poem5646.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[463,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[925,"","https://poetry.dctabudhabi.ae/diwan/poem/144555","الوافر"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132419","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53117","الهزج"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129843","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99258","الطويل"],[4734,"فجر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4802,"عيب العرب فيه","https://www.poetsgate.com/ViewPoem.aspx?id=34416",""],[1012,"الشعشعة","https://www.poetsgate.com/ViewPoem.aspx?id=186277",""],[1012,"فتوحات الإمام عزان بن قيس","https://www.poetsgate.com/ViewPoem.aspx?id=124503",""],[4883,"العُمر عود ثقاب","https://www.poetsgate.com/ViewPoem.aspx?id=48378",""],[5756,"التمثال","https://www.poetsgate.com/ViewPoem.aspx?id=1366",""],[5956,"النملة المُعَلِّمة","https://www.poetsgate.com/ViewPoem.aspx?id=183472",""],[463,"لكلِّ هوى منْ رائدِ الحزمِ رادعٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60127&r=&rc=183",""]],"verses":[["كَأَنَّ اليَمانِيَّ حاكَ في أُخرَياتِهِ","فَأَعرَضَ أَبرادَ الرَبابِ وَأَوسَعا",0,"ع",2,0],["كَأَنَّ اليَماني ذا العِيابِ بِأَرضِها","يُقَلِّبُ مِن دارَينِ ما في الحَقائِبِ",1,"ب",1,0],["كَأَنَّ أَليمَ الهَجرِ أَجرى دُموعَها","فَفاضَت وَأَذكى في حَشاها وَقودَها",2,"د",3,0],["كان إلى جنبي حسين يسير","بهمة القرم العنيد المغير",3,"ر",1,0],["كَأَنَّ اليَمامِيَّ الطَبيبَ اِنبَرى لَها","فَذَرَّ لَها في الحَوضِ شَرياً وَعَلقَما",4,"م",2,0],["كانَ اليَهودُ مَعَ الدَيّانِ دينَهُمُ","وَدينُهُم كانَ شَرَّ الدينِ في الزَمَنِ",5,"ن",1,0],["كان إلى الله سبيلي وما","كان إلى الإِيمان دَربٌ سواه",6,"ه",1,0],["كأن اليماني حلَّ منها عيابه","تفاوحُ من دارين فيها البضائعُ",7,"ع",1,0],["كانَ إِلى جدّة خَير مَقدم","مِنّا جَميعاً خامِسَ المحرّمِ",8,"م",1,0],["كانَ إِلَيها سَببٌ لَطيف","وَالشَّرح بِالشَّرح لَهُ تَعريفُ",8,"ف",1,0],["كانَ إلى بَيروت عَودي ثانِيا","لَنا غَدى الشَوقُ إِلَيها ثانِيا",8,"ي",2,0],["كأن اليك يوسعنا نثاراً","من الورق المكسر والصحاح",9,"ح",1,0],["كأن اليتامي والمساكين جيفة","للحماتها تلك النوابح تسفع",10,"ع",1,0],["كأن اليوم إذ يج","لو علينا رونق البشر",11,"ر",1,0],["كان الي يسلي الضفافَ إذا","دلّوا وقام الدهر ينتصر",12,"ر",1,0],["كأنّ أليفاً بان عنها فأصبحَت","بمربعه كالصبّ بعد الحبائب",13,"ب",1,0],["كأنَّ اليدَ استَلَّتْ لنا في عَجاجةٍ","لنا ولهم قرناً من الشمسِ ضاحيا",14,"ي",2,0],["كأن اليراعَ النَّضْرَ أوراقهُ قَناً","له العَذَبُ الخفَّاق يستأنفُ الرَّجْفا",15,"ف",2,0],["كأنَّ اليتمَ سربلها بحزنٍ","نما في ضوءِ مقلتها انتحابا",16,"ب",2,0],["كان ال..يحسه يكتبه،كنت اجاريه","أنسى السّنه لعيون خاطردقيقه",17,"ق",2,0],["كأن اليتامى والمساكين جيفة","للحمانها تلك النواتج تسفع",18,"ع",1,0],["كأن اليتامى والمساكين جيفة","للحمانها تلك النوابح تسفع",19,"ع",1,0],["كان اليسار يْمين","وكان اليمين : اعناب !",20,"ب",1,0],["كأن الي خلق حسنك خلقني مع جسدك ظلال","وصرت اقرب جسد يمشي معك باقفاك واقبالك",21,"ك",1,0],["كان اليؤوسَ وجاءتِ البُشْرَى له","من نملة تهوي وثم تقومُ",22,"م",1,0],["كأنَّ اليماني حلَّ منها عيابهُ","تفاوحُ منْ دارينِ إليها البضائعُ",23,"ع",1,0]]}