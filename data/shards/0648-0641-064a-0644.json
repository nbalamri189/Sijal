{"poems":[[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[77,"شفاء عياض للنفوس شفاء","https://www.aldiwan.net/poem36787.html","الطويل"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[51,"أراني وما أحدثت بعدك سيئا","https://www.aldiwan.net/poem64073.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"أبا العباسِ عمرت","https://www.aldiwan.net/poem66081.html","الهزج"],[29,"أتعرف من أسماء بالجد روسما","https://www.aldiwan.net/poem6156.html","الطويل"],[70,"وزائرة زارت وقد هجم الدجى","https://www.aldiwan.net/poem43005.html","الطويل"],[70,"وغانية لما رأتني أعولت","https://www.aldiwan.net/poem43018.html","الطويل"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[45,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[39,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[52,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16629","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.poetsgate.com/ViewPoem.aspx?id=34203",""],[94,"الكنز المقدّس","https://www.poetsgate.com/ViewPoem.aspx?id=15624",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[92,"إرادة الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14579&r=&rc=24",""],[115,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[132,"وليمة لوم لمت على لقاها","https://www.aldiwan.net/poem54738.html","الوافر"],[132,"أوفى بذمة ربع الريع أن تقفا","https://www.aldiwan.net/poem54802.html","البسيط"],[150,"خذها إليك أبا إسحاق عن عجل","https://www.aldiwan.net/poem68543.html","البسيط"],[169,"صداق المعالي مشرفي وذابل","https://www.aldiwan.net/poem1647.html",""],[189,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[210,"سفحت عقيق الدمع من سفح مقلتي","https://www.aldiwan.net/poem13304.html","الطويل"],[231,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[235,"حلفت بمسراها بحربة بزلا","https://www.aldiwan.net/poem31614.html","الطويل"],[237,"بك الدر يا درا به حلية الدهر","https://www.aldiwan.net/poem18815.html","الطويل"],[252,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[259,"كعوب تردت ببرد الجمال","https://www.aldiwan.net/poem35558.html","المتقارب"],[275,"يفندني في العامرية لومي","https://www.aldiwan.net/poem25519.html","الطويل"],[275,"أحقا طربت إلى الربرب","https://www.aldiwan.net/poem25612.html","المتقارب"],[328,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[353,"علام يلوم العاذلون على وجدي","https://www.aldiwan.net/poem40389.html","الطويل"],[353,"أيا صبح أفراح الملا عمك السعد","https://www.aldiwan.net/poem40397.html","الطويل"],[353,"وفى لنا الدهر إسعادا بما وعدا","https://www.aldiwan.net/poem40401.html","البسيط"],[384,"وعاطيته جنح الظلام سلافةً","https://www.aldiwan.net/poem1312.html",""],[391,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[402,"وفي لي ولم يسمع كلام مفند","https://www.aldiwan.net/poem46741.html","الطويل"],[429,"أيا ابن فؤادي والفؤاد له الحمد","https://www.aldiwan.net/poem39854.html","الطويل"],[432,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[458,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[458,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[458,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[458,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[510,"وفى لي دمعي يوم بانوا بوعده","https://www.aldiwan.net/poem1582.html",""],[515,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[558,"أنا الهيكل الذاتي لمظهر قدرة","https://www.aldiwan.net/poem34334.html","الطويل"],[559,"سلوي مكروه وحبك واجب","https://www.aldiwan.net/poem69369.html","الطويل"]],"verses":[["وَفِي لَيْلَةِ الْمِيلاَدِ مِنْهُ بَدَتْ لَهَا","شَوَاهِدُ لَمْ تَخْطُرْ لِنَفْسِ وَلاَ وَهْمِ",0,"م",1,0],["وفي ليلَةِ الميلادِ أكْبرُ آيةٍ","تخِرُّ الجِبالُ الراسياتُ لها هَدّا",1,"د",2,0],["وفي ليْلَةِ المِيلادِ لاحَتْ شَواهِدٌ","تَوالَتْ بِها للّهِ فِينا المَنائِحُ",2,"ح",1,0],["وَفَى لِنَبِيِّ اللهِ حَقَّ وَفَائِهِ","وَأَكْرَمُ أَوْصَافِ الكِرَامِ وَفَاءُ",3,"ف",3,0],["وفِيلٌ وأَذيابٌ وابنُ خُوَيدرٍ","وغَنسَلَةٌ فِيهَا الخُفَيعَانُ قَد نَزَل",4,"ل",1,0],["وفى لك الجود لما صحّ ذيْنكما","نعم وما الخلّ إلا من يوافيكا",5,"ك",2,0],["وفَى لي بَغيض والتوَى مَنْ أحبه","ولَلْشَيبُ أوفى والشبيبةُ أغدر",6,"ر",1,0],["وفى للأمير أناسٌ غدا","رهينتهم كل مرعىً مَرِع",7,"ع",1,0],["وفي للأمير أناس غدا","رهينتهم كل طود فرع",7,"ع",1,0],["وفي لطفك طلَّسْمٌ","بحالي أيُّ طِلَّسمِ",8,"م",1,0],["وَفي لَيلَةٍ ما يَنبَحُ الكَلبُ ضَيفَها","إِذا نُبِّهَ المَبلودُ فيها تَغَمغَما",9,"م",2,0],["وَفى لي بِوَعدٍ مِثلُهُ مَن وَفى بِهِ","وَمِثلِيَ فيهِ عاشِقٌ هامَ أَو صَبا",10,"ب",2,0],["وَفى لِيَ مَن أَهوى وَأَنعَمَ بِالرِضا","يَموتُ بِغَيظٍ عاذِلٌ وَرَقيبُ",11,"ب",1,0],["وفي ليلةٍ مِنْ ليالي الخريفِ","متقَّلةٍ بالأَسى والضَّجَرْ",12,"ر",1,0],["وَفى لِجَوادِهِ وَحَنا عَلَيهِ","وَقَد شَخَصَت بَنادِقُهُم إِلَيهِ",13,"ه",1,0],["وَفي لَيلَةٍ بِعنا لِطارِقِ شَوقِها","كَرى أَعيُنٍ مَطروفَةٍ بِسُهادِها",14,"د",3,0],["وَفى لِيَ فيكَ الدَمعُ إِذ خانَني الصَبرُ","وَأَنجَدَ فيكَ النَظمُ إِذ خُذِلَ النَصرُ",15,"ر",1,1],["وَفى لَهُم في قَولِهِ وَالوَفا","قَد بَلِيَت في اللَحدِ أَكفانُه",16,"ن",2,0],["وفيَّ لتحصيلِ العلومِ بقيةٌ","فلا كبرٌ عنها يصدُّ ولا كِبْرُ",17,"ر",1,0],["وفي لوزانَ إذ فَزعوا إليها","وجاءوا بالوُفودِ مُكاثرينا",18,"ن",2,0],["وَفِيَّ لِخَبطِ النَهشَلِيِّ مُنَوَّقٌ","إِذا مَذحِجٌ حَولي تَسامَت قُرومُها",19,"م",3,0],["وَفي لَيلَةِ الغارِ وَقّى النَبِيَّ","عِشاءً إِلى الفَلَقِ الأَشهَبِ",20,"ب",1,0],["وفي لمن رام المعالي بقية","وعندي إذا عي البليغ مقال",21,"ل",1,0],["وفيلقٌ على جوانب الهرم","تقلدوا الحقّ وسُرْبِلوا الكرمْ",22,"م",1,0],["وفىَ له من ليس بالوفيِّ","وهش من لم يك بالحفيِّ",23,"ي",1,0],["وفي ليلة الميلاد أكبر آية","تخر الجبال الراسيات له هدا",24,"د",2,0],["وفي ليلة الميلاد منه بدت لها","شواهد لم تخطر لنفس ولا على وهم",25,"م",1,0],["وفي لحظك الساجي من الشعر والهوى","تركت خيالاتي وسكري وأحلامي",26,"م",2,0],["وفِي لَيْلِهَا تَقْضِي الَّذِي يُبتَغَى غَدَا","كَمَا كَانَ عَبْدُ الرِّقِّ جِنْحاً وَمُغْتَدَى",27,"د",2,0],["وفي ليلة من ليالي الخريف","مثقَّلةٍ بالأسى, والضجرْ",28,"ر",1,0],["وفي لغات جميع الخلق قد ذكرت","أوصافه فعلت عن وصف نقصان",29,"ن",1,0],["وفي لُقيَايَ رَحمَةَ رُمتِ لَومِي","فَقَلبي مِن مَلاَمِكِ ذُو كُلُومِ",30,"م",1,0],["وفي لَدني عِرفَانٍ يَمِيطُ بِهِ","عَن قَلبِهِ الزَّيغ والأدرَانَ والسُّدُفَا",31,"ف",2,0],["وفي لقائك برٌّ عاجل ورؤى","إن كان في الغيب إنساء من العمر",32,"ر",1,0],["وَفي لِينَةٍ أَردى شَغاميمَ طَيِّئٍ","جِهاراً وَلَونُ الجَوِّ بِالنَقعِ حائِلُ",33,"ل",1,0],["وَفي ليلةِ الميلادِ شهبُ الكواكبِ","دَنَت وتدلّت كالسهام الثواقبِ",34,"ب",1,0],["وفي ليلة الاسرا من الله قد دنا","وخاطبه في الحضرة القدسيّة",35,"ه",1,0],["وفي ليلة الغار افتداه بنفسه","حذاراً عليه من أراقم تلسع",36,"ع",1,0],["وَفى لَهُمُ بِالخِصبِ قَبلَ لِقائِهِ","فَما وَطِئوا في وَطأَةٍ بَلَداً مَحلا",37,"ل",2,0],["وَفِي لَفْظِكَ الْمَنْظُومِ دُرٌّ مُنَظَّمٌ","يَذُوبُ لَهُ الْمَنْشُورُ مِنْ لُجَّةِ الْبَحِْر",38,"ر",1,0],["وَفَيلَقٍ يَملأُ الأَقطار ذي لَجَبٍ","يُضحي له ثابِتُ الأَطوادِ مَدكوكا",39,"ك",2,0],["وفي ليل شعر وإصباح وجه","تبدى لدينا الهدى والضلال",40,"ل",1,0],["وفي لَثْمِ مَا لاثَتْ عَلَيْهِ لِثَامَهَا","شِفَاءٌ لِتَبْريجِ الفُؤَادِ المُتَيَّمِ",41,"م",1,0],["وَفَى لِلْعُلَى بِحُقُوقِ العُلى","نُهوضاً على المَرْكبِ الأصْعَب",42,"ب",1,0],["وفي ليلةٍ خرساءَ مقرورةِ الدجى","تمرّدَ فيها الشوقُ هيمان عاتِيا",43,"ي",2,0],["وَفي لُؤَيٍّ لُويتُ أَنوارُهُ","مِن دارِ سابورَ فَقَرَّت في مُضَر",44,"ر",1,0],["وَفى للحجا عَهداً عَلى البرّ وَالتُقى","كَما عَهد الهادي إِلى السَيّد المَهدي",45,"د",2,0],["وَفي لَيلة الإثنين أُنبئتُ أَنَّهُ","لَهُ المُشتري نجم وَطالعه السَعدُ",46,"د",1,0],["وَفى لَنا الدَهر إِسعاداً بِما وَعدا","فَلا عدمنا لَهُ في المكرُمات يَدا",47,"د",2,1],["وَفي لَيلَةٍ يَرنو بِها الأُنسُ أَخيَفاً","فَمِن كَحَلِ الظَّلما وَمِن زَرَقِ النَّهرِ",48,"ر",1,0],["وفي لا خير نفي","وحصر بعد اثبات",49,"ت",1,0],["وَفي لي ولَم يسمَعْ كلامَ مفنّدٍ","وجادَ بطيبِ الوصْلِ عن غير مَوْعدِ",50,"د",1,1],["وفي لفظه درٌّ حكاه مقصراً","من الغانيات الثغر يفترّ والعقد",51,"د",1,0],["وفي لحظِ اليتيمِ سطورُ ضغْنٍ","تدرّبَ في قراءتها الوصيُّ",52,"ي",1,0],["وَفَى لِيَ هذا الشعرُ فيكم وإنه","خذولٌ لبعض القائلين خئونُ",53,"ن",1,0],["وفَى لَهُمُ أبو سعدٍ بسعيٍ","مَزيدِ الحُضْرِ طمَّ على الرسيمِ",54,"م",1,0],["وفَى لعميد الدولتين بها الحيا","فرفَّ لها ظلٌّ ورقَّ نسيمُ",55,"م",1,0],["وفى لي بك الحظُّ الذي كان يَغدِرُ","وصحَّ لِيَ الدهرُ الذي يتغيَّرُ",56,"ر",1,1],["وَفَى لك مجداً ما تَعُدِّين في أبي","قَوامٍ إذا خان الفروعَ النوابتُ",57,"ت",1,0],["وَفَى لي وهو مَحصُوصٌ وأضحى","غداةَ ارتاش وهو عليَّ ذِيبُ",58,"ب",1,0],["وفى ليَ دمعي يوم بانوا بوعده","فأجريتُه حتى غرقتُ بمدّه",59,"د",2,1],["وفى لك حد الجد والسيف غادر","وأنهضك التأييد والدهر عاثر",60,"ر",1,1],["وفي ليل غيبي صبح معرفتي يُضي","وكل الورى من بعد ذا لست أرتضي",61,"ي",1,0],["وفي لوح قلبي من وِدَادكِ أسطرٌ","وَدمعي مِدادٌ مثل ما الحسن كاتبُ",62,"ب",1,0]]}