26,"","https://poetry.dctabudhabi.ae/diwan/poem/94362","الطويل"],[4272,"","https://poetry.dctabudhabi.ae/diwan/poem/145989","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4899,"خانة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=177029",""],[5111,"خَيْمَةُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212612",""],[5135,"عَزِيْزُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=201966",""],[5152,"عندي ألف فن","https://www.poetsgate.com/ViewPoem.aspx?id=185862",""],[5184,"لأنك العراق","https://www.poetsgate.com/ViewPoem.aspx?id=186052",""],[5186,"نصم عفا الله عن عهد لكم سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=156477",""],[5277,"بنٌ وسُكّر..","https://www.poetsgate.com/ViewPoem.aspx?id=202576",""],[5285,"سأشكو إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=203540",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[5413,"سيبقى المعلى","https://www.poetsgate.com/ViewPoem.aspx?id=200569",""],[5431,"يكاد يُضيئ...","https://www.poetsgate.com/ViewPoem.aspx?id=214558",""],[5628,"ميادة الحناوي تألق دائم *","https://www.poetsgate.com/ViewPoem.aspx?id=182932",""],[5690,"تهنأ سيدي في عيد فصحِ","https://www.poetsgate.com/ViewPoem.aspx?id=172193",""],[5913,"جريمة حب","https://www.poetsgate.com/ViewPoem.aspx?id=177073",""],[5997,"أعوذُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214253",""],[6023,"ألؤلؤٌ نظمُ هذا الثُّغر أم حبب","https://www.poetsgate.com/ViewPoem.aspx?id=123853",""],[6093,"أيا إيران","https://www.poetsgate.com/ViewPoem.aspx?id=195089",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""],[463,"وفى لي الحظُّ الَّذي كانَ يغدرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60090&r=&rc=146",""]],"verses":[["وَفِي لَيْلَةِ الْمِيلاَدِ مِنْهُ بَدَتْ لَهَا","شَوَاهِدُ لَمْ تَخْطُرْ لِنَفْسِ وَلاَ وَهْمِ",0,"م",1,0],["وفي ليلَةِ الميلادِ أكْبرُ آيةٍ","تخِرُّ الجِبالُ الراسياتُ لها هَدّا",1,"د",2,0],["وفي ليْلَةِ المِيلادِ لاحَتْ شَواهِدٌ","تَوالَتْ بِها للّهِ فِينا المَنائِحُ",2,"ح",1,0],["وَفَى لِنَبِيِّ اللهِ حَقَّ وَفَائِهِ","وَأَكْرَمُ أَوْصَافِ الكِرَامِ وَفَاءُ",3,"ف",3,0],["وفِيلٌ وأَذيابٌ وابنُ خُوَيدرٍ","وغَنسَلَةٌ فِيهَا الخُفَيعَانُ قَد نَزَل",4,"ل",1,0],["وفى لك الجود لما صحّ ذيْنكما","نعم وما الخلّ إلا من يوافيكا",5,"ك",2,0],["وفَى لي بَغيض والتوَى مَنْ أحبه","ولَلْشَيبُ أوفى والشبيبةُ أغدر",6,"ر",1,0],["وفى للأمير أناسٌ غدا","رهينتهم كل مرعىً مَرِع",7,"ع",1,0],["وفي للأمير أناس غدا","رهينتهم كل طود فرع",7,"ع",1,0],["وفي لطفك طلَّسْمٌ","بحالي أيُّ طِلَّسمِ",8,"م",1,0],["وَفي لَيلَةٍ ما يَنبَحُ الكَلبُ ضَيفَها","إِذا نُبِّهَ المَبلودُ فيها تَغَمغَما",9,"م",2,0],["وَفى لي بِوَعدٍ مِثلُهُ مَن وَفى بِهِ","وَمِثلِيَ فيهِ عاشِقٌ هامَ أَو صَبا",10,"ب",2,0],["وَفى لِيَ مَن أَهوى وَأَنعَمَ بِالرِضا","يَموتُ بِغَيظٍ عاذِلٌ وَرَقيبُ",11,"ب",1,0],["وفي ليلةٍ مِنْ ليالي الخريفِ","متقَّلةٍ بالأَسى والضَّجَرْ",12,"ر",1,0],["وَفى لِجَوادِهِ وَحَنا عَلَيهِ","وَقَد شَخَصَت بَنادِقُهُم إِلَيهِ",13,"ه",1,0],["وَفي لَيلَةٍ بِعنا لِطارِقِ شَوقِها","كَرى أَعيُنٍ مَطروفَةٍ بِسُهادِها",14,"د",3,0],["وَفى لِيَ فيكَ الدَمعُ إِذ خانَني الصَبرُ","وَأَنجَدَ فيكَ النَظمُ إِذ خُذِلَ النَصرُ",15,"ر",1,1],["وَفى لَهُم في قَولِهِ وَالوَفا","قَد بَلِيَت في اللَحدِ أَكفانُه",16,"ن",2,0],["وفيَّ لتحصيلِ العلومِ بقيةٌ","فلا كبرٌ عنها يصدُّ ولا كِبْرُ",17,"ر",1,0],["وفي لوزانَ إذ فَزعوا إليها","وجاءوا بالوُفودِ مُكاثرينا",18,"ن",2,0],["وَفِيَّ لِخَبطِ النَهشَلِيِّ مُنَوَّقٌ","إِذا مَذحِجٌ حَولي تَسامَت قُرومُها",19,"م",3,0],["وَفي لَيلَةِ الغارِ وَقّى النَبِيَّ","عِشاءً إِلى الفَلَقِ الأَشهَبِ",20,"ب",1,0],["وفي لمن رام المعالي بقية","وعندي إذا عي البليغ مقال",21,"ل",1,0],["وفيلقٌ على جوانب الهرم","تقلدوا الحقّ وسُرْبِلوا الكرمْ",22,"م",1,0],["وفىَ له من ليس بالوفيِّ","وهش من لم يك بالحفيِّ",23,"ي",1,0],["وفي ليلة الميلاد أكبر آية","تخر الجبال الراسيات له هدا",24,"د",2,0],["وفي ليلة الميلاد منه بدت لها","شواهد لم تخطر لنفس ولا على وهم",25,"م",1,0],["وفي لحظك الساجي من الشعر والهوى","تركت خيالاتي وسكري وأحلامي",26,"م",2,0],["وفِي لَيْلِهَا تَقْضِي الَّذِي يُبتَغَى غَدَا","كَمَا كَانَ عَبْدُ الرِّقِّ جِنْحاً وَمُغْتَدَى",27,"د",2,0],["وفي ليلة من ليالي الخريف","مثقَّلةٍ بالأسى, والضجرْ",28,"ر",1,0],["وفي لغات جميع الخلق قد ذكرت","أوصافه فعلت عن وصف نقصان",29,"ن",1,0],["وفي لُقيَايَ رَحمَةَ رُمتِ لَومِي","فَقَلبي مِن مَلاَمِكِ ذُو كُلُومِ",30,"م",1,0],["وفي لَدني عِرفَانٍ يَمِيطُ بِهِ","عَن قَلبِهِ الزَّيغ والأدرَانَ والسُّدُفَا",31,"ف",2,0],["وفي لقائك برٌّ عاجل ورؤى","إن كان في الغيب إنساء من العمر",32,"ر",1,0],["وَفي لِينَةٍ أَردى شَغاميمَ طَيِّئٍ","جِهاراً وَلَونُ الجَوِّ بِالنَقعِ حائِلُ",33,"ل",1,0],["وَفي ليلةِ الميلادِ شهبُ الكواكبِ","دَنَت وتدلّت كالسهام الثواقبِ",34,"ب",1,0],["وفي ليلة الاسرا من الله قد دنا","وخاطبه في الحضرة القدسيّة",35,"ه",1,0],["وفي ليلة الغار افتداه بنفسه","حذاراً عليه من أراقم تلسع",36,"ع",1,0],["وَفى لَهُمُ بِالخِصبِ قَبلَ لِقائِهِ","فَما وَطِئوا في وَطأَةٍ بَلَداً مَحلا",37,"ل",2,0],["وَفِي لَفْظِكَ الْمَنْظُومِ دُرٌّ مُنَظَّمٌ","يَذُوبُ لَهُ الْمَنْشُورُ مِنْ لُجَّةِ الْبَحِْر",38,"ر",1,0],["وَفَيلَقٍ يَملأُ الأَقطار ذي لَجَبٍ","يُضحي له ثابِتُ الأَطوادِ مَدكوكا",39,"ك",2,0],["وفي ليل شعر وإصباح وجه","تبدى لدينا الهدى والضلال",40,"ل",1,0],["وفي لَثْمِ مَا لاثَتْ عَلَيْهِ لِثَامَهَا","شِفَاءٌ لِتَبْريجِ الفُؤَادِ المُتَيَّمِ",41,"م",1,0],["وَفَى لِلْعُلَى بِحُقُوقِ العُلى","نُهوضاً على المَرْكبِ الأصْعَب",42,"ب",1,0],["وفي ليلةٍ خرساءَ مقرورةِ الدجى","تمرّدَ فيها الشوقُ هيمان عاتِيا",43,"ي",2,0],["وَفي لُؤَيٍّ لُويتُ أَنوارُهُ","مِن دارِ سابورَ فَقَرَّت في مُضَر",44,"ر",1,0],["وَفى للحجا عَهداً عَلى البرّ وَالتُقى","كَما عَهد الهادي إِلى السَيّد المَهدي",45,"د",2,0],["وَفي لَيلة الإثنين أُنبئتُ أَنَّهُ","لَهُ المُشتري نجم وَطالعه السَعدُ",46,"د",1,0],["وَفى لَنا الدَهر إِسعاداً بِما وَعدا","فَلا عدمنا لَهُ في المكرُمات يَدا",47,"د",2,1],["وَفي لَيلَةٍ يَرنو بِها الأُنسُ أَخيَفاً","فَمِن كَحَلِ الظَّلما وَمِن زَرَقِ النَّهرِ",48,"ر",1,0],["وفي لا خير نفي","وحصر بعد اثبات",49,"ت",1,0],["وَفي لي ولَم يسمَعْ كلامَ مفنّدٍ","وجادَ بطيبِ الوصْلِ عن غير مَوْعدِ",50,"د",1,1],["وفي لفظه درٌّ حكاه مقصراً","من الغانيات الثغر يفترّ والعقد",51,"د",1,0],["وفي لحظِ اليتيمِ سطورُ ضغْنٍ","تدرّبَ في قراءتها الوصيُّ",52,"ي",1,0],["وَفَى لِيَ هذا الشعرُ فيكم وإنه","خذولٌ لبعض القائلين خئونُ",53,"ن",1,0],["وفَى لَهُمُ أبو سعدٍ بسعيٍ","مَزيدِ الحُضْرِ طمَّ على الرسيمِ",54,"م",1,0],["وفَى لعميد الدولتين بها الحيا","فرفَّ لها ظلٌّ ورقَّ نسيمُ",55,"م",1,0],["وفى لي بك الحظُّ الذي كان يَغدِرُ","وصحَّ لِيَ الدهرُ الذي يتغيَّرُ",56,"ر",1,1],["وَفَى لك مجداً ما تَعُدِّين في أبي","قَوامٍ إذا خان الفروعَ النوابتُ",57,"ت",1,0],["وَفَى لي وهو مَحصُوصٌ وأضحى","غداةَ ارتاش وهو عليَّ ذِيبُ",58,"ب",1,0],["وفى ليَ دمعي يوم بانوا بوعده","فأجريتُه حتى غرقتُ بمدّه",59,"د",2,1],["وفى لك حد الجد والسيف غادر","وأنهضك التأييد والدهر عاثر",60,"ر",1,1],["وفي ليل غيبي صبح معرفتي يُضي","وكل الورى من بعد ذا لست أرتضي",61,"ي",1,0],["وفي لوح قلبي من وِدَادكِ أسطرٌ","وَدمعي مِدادٌ مثل ما الحسن كاتبُ",62,"ب",1,0],["وفي لحظاتهِ فتحٌ وَرَفعٌ","وفي كاساتهِ أشهى المنالِ",63,"ل",1,0],["وَفَيلَقٍ فَضَّهُ وَقَد سَجَدَت","في الأرض مِنهُم جَماجِمٌ فَلَق",64,"ق",1,0],["وفي لوح روح الكون فعّال نطقه","سمواته والأرض في روح خلقه",65,"ه",1,0],["وفي لوحي المحفوظ من كل فاعل","يقوم بأمري في حروف عوامل",65,"ل",1,0],["وَفي لَيال تَشيم الدَهر ذا حزن","سُبحان من ذا لَهُ في خَلقه شان",66,"ن",1,0],["وفي لُغَةِ الأعْراب والطبّ صيتُه","بعيدٌ وفي التاريخ قد جاوز الحدّا",67,"د",2,0],["وفي لَمَى ثغْرِكَ الدَّوا لي","لَوْ عَلَّني بِابنَةِ الدَّوالي",68,"ل",2,0],["وفي لحظة من مدار الزمان","هوى واختفى من علا واشتهرْ",69,"ر",1,0],["وفيْلَقٍ إنْ غزوتَ المشركين به","أركبتهم طبقاً في الأرض عنْ طبق",70,"ق",1,0],["وَفي لَيْلَةِ الْمِعْرَاجِ أدْنى مَزَارَهُ","وَمَا زَالَ لِلْجَاني يُقِيلُ عِثَارَهُ",71,"ه",1,0],["وَفي لَيْلَةِ الْمِعْرَاجِ أُسْرِي بِهِ إلَى","حَظِيرَةِ قُدْسٍ وَاحْتَوَى الْغَايَةَ الْقُصْوى",72,"ص",3,0],["وفي لِماس العِرس في","فيها مقال مستطر",73,"ر",1,0],["وفي ليلة الميلاد لاحت شواهد","بها أخبر الكهان سيف التتبا",74,"ب",2,0],["وفي لبيد وفي المشط اعتبار فتى","ما زاغ عن منهج التقوى ولا حجما",75,"م",2,0],["وَفِي لُيَيّلاَهُ أوْ فِي رَبْعِ مَعْهَدِهِ","نَحْنُ المُحِبُّونَ أمْ نَحْنُ المَجَانينَا",76,"ن",2,0],["وَفيلٌ لَيسَ يَحدوهُ","يَدا شَلجٍ وَلا عَلجِ",77,"ج",1,0],["وفي ليلة الميلادِ كم من كرامةٍ","توالت لطه برقُها يتألَّب",78,"ب",1,0],["وفي لبنان يجزع كل قلب","إذا يستوحش الأدب العراب",79,"ب",1,0],["وفي لوني بياضٌ واحمرارٌ","كخد البكر بل أبهى والمعْ",80,"ع",1,0],["وفي لينِ المعاطِفِ والسَّجايا","وصالي دأْبُهُ ورِضاهُ دَابي",81,"ب",2,0],["وفى لنا ألفاً وكل","لم فانثنى أدباً كلام",82,"م",1,0],["وفي ليله قد جاء مكة راجعا","وأخبر بالأسرى صريحا بإعلان",83,"ن",1,0],["وفي لك السعي بالسعد الذي وفدا","وأنجز الدهر من علياك ما وعدا",84,"د",2,1],["وفى لي الدهر بموعود","وتابع النعمى بتجديد",85,"د",1,1],["وفي لبنانَ منتجعُ اصطياف","فحسّنه لرائده شِعابا",86,"ب",2,0],["وفيٌّ لا يفارقهُ الغرامُ","ويطربني اللقا فأذوب حزناً",87,"ن",2,0],["وفي لهيب لوعتي وعبرتي","أكاد أن أغرق أو أحترقا",88,"ق",2,0],["وَفي لَيلَةٍ أَنحى عَلى المالِ خِفيَةً","وَوَلّى بِما أَبقَيتُ لِلدَّهرِ من ذُخر",89,"ر",1,0],["وفيلقك الجرار غصت بخيله","رحابالفيافي الملس والأكم الحدب",90,"ب",1,0],["وَفى لَكُما يإِبنَيَ سُلَيمانَ قاسِمٌ","بِجَدِّ النُهى إِذ يَقسِمُ الخَيرَ قاسِمُه",91,"م",2,0],["وفي لك بالمراد وما تأنّى","ختان عمّ بالحسنى وثنّى",92,"ن",2,0],["وفي لطمة الخدين إن هي أثرت","بعيرٌ وإلا النصف من ذاك يجعل",93,"ل",1,0],["وَفي لي بوعد ولا تُخلِفيِ","هِ إِخلافَ دهر به لي وُعُودي",94,"د",2,0],["وَفي لَخمٍ وَفي أُدَدِ بنِ عَمرٍو","وَفي بَكرٍ وَحَيِّ بَني العدانِ",95,"ن",1,0],["وفي لجج من ابحر الدمع ناظري","يسبح جفني حيث دمعي تهللا",96,"ل",2,0],["وفي لَفْظِها سِحْرٌ وفي لحظاتِهَا","وفي خدها من حسنها جُذوةُ ومَاء",97,"م",3,0],["وَفَيلَقٍ كَشُعاعِ الشَّمسِ مُشعلةٍ","تُعشي البَصيرَ إِذا مالَت بِهِ البيدُ",98,"د",1,0],["وفي لبنان ابقى خير ذكرٍ","يضوع كما يضوع به الخزامى",99,"م",2,0],["وفي لك دهر انت من حسناته","بما انت تهواه وسالمك الدهر",100,"ر",1,0],["وفي ليلة الإسراء قد بات يرتقي","