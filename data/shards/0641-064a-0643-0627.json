gate.com/ViewPoem.aspx?id=101248",""],[6127,"أسد بابل","https://www.poetsgate.com/ViewPoem.aspx?id=188648",""],[6127,"آية الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=189497",""],[6152,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=203276",""],[6189,"بهو الفيروز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83569&r=&rc=36",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""]],"verses":[["في كاهِلٍ وَشَجَت إِلى أَطباقِهِ","دَأَياتُ مُنتَفِخٍ مِنَ الأَزوارِ",0,"ر",1,0],["فيكِ السَعيدانِ اللَذانِ تَبارَيا","يا مِصرُ في الخَيراتِ وَالبَرَكاتِ",1,"ت",1,1],["فيك التغزُّل والمدح المنظم في","محمدٍ فلشعرِي في الورى شان",2,"ن",1,0],["فيك أشياءُ من يواليك مسرو","رٌ بها والعدوُّ منها مغيظُ",3,"ظ",1,0],["فيك أشياءُ لو وُجدن قديماً","نظمتْها الملوكُ في التيجانِ",4,"ن",1,0],["فِيَّ كَاجَوِّ نُجوم وَغُيوم وَظِلال","هَل أَنا بَحر وَأَرض وَسَماءٌ لَستُ أَدري",5,"ي",1,0],["فيكَ أَودَعتُ مُنذُ سِتٍّ فُؤادي","وَبِرَغمي أَطَلتُ عَنكَ البِعادا",6,"ا",1,0],["فيكِ اِلتَقَت أَرواحُ أَهلِ الهَوى","نَجوى وَشَكوى وَبُكا وَاِبتِسام",7,"م",1,0],["فيكَ إن عانقَ الرَّبيعُ فؤادي","تتثنَّى سَنَابِلي وَوُرُودي",8,"د",2,0],["فيكَ انْطَوَتْ نَفْسي وفيكَ","نَفَخْتُ كلَّ مَشَاعِرِي",9,"ي",1,0],["فيك المدائح تحلو","إذ أنت للمدح أهلُ",10,"ل",1,1],["في كأسِه كسرى يقابِلُه","من خَلْفِ سِترِ الرَّاحِ قَيصَرُه",11,"ر",2,0],["فيك الحياةُ جمالُها وجَلالُها","ولكِ الزّمانُ قُواهُ والعزماتُ",12,"ت",1,0],["فَيكاد الشرق لغمَّته","مِمّا قد كابد ينتحر",13,"ر",1,0],["فيك اللَيالي أَخلفت ميثاقها","إن اللَيالي مالها ميثاق",14,"ق",1,0],["فيك انتهى بالفتنةِ التراقي","واصطدم الشآمُ بالعراق",15,"ق",1,0],["فِيكِ الْتَقَتْ وَالْحَمْدُ لِلْخَلاَّقِ","وَبَعْدَه لأَبَوَيْكِ الْحَمْدُ",16,"د",1,0],["فِيكَ الَّذِي فِيكَ وَلَسْنَا نَعْدو","إِنْ تَكنِ النَّابِغَةَ الْحَبِيبَا",16,"ب",2,0],["فيكِ الثقافةُ بالمجانةِ تلتقي","ماذا أقولُ وكلُّ شيءٍ فيك",17,"ك",1,0],["فيكَ الملائِكُ أجْنَأدٌ مُسوَّمَةٌ","أعْلامُها تتهادَى حَوْلَ جِبْرينَا",18,"ن",2,0],["فيك الشرائعُ والشموسُ 