/www.aldiwan.net/poem13719.html","مجزوء الخفيف"],[450,"حاءتك تعنو للجناب الرفيع","https://www.aldiwan.net/poem13830.html","السريع"],[450,"مذ رأت عيني وقد رمدت","https://www.aldiwan.net/poem13914.html","المديد"],[456,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[456,"وما ابن أرض غرض لابن سما","https://www.aldiwan.net/poem55882.html","الرجز"],[456,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[456,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[456,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[456,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[456,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[456,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[468,"رام قلبي السلو عن أسماء","https://www.aldiwan.net/poem4621.html","الخفيف"],[475,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[477,"نادتك يا أختها الخضرا فلسطين","https://www.aldiwan.net/poem36961.html","البسيط"],[498,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[498,"قد أجمعوا كيدهم قوم وقد جمعوا","https://www.aldiwan.net/poem37727.html","البسيط"],[498,"حسد الولي الجاهل","https://www.aldiwan.net/poem37807.html","مجزوء الكامل"],[498,"نحن الذين لنا المقام الأيد","https://www.aldiwan.net/poem38025.html","الكامل"],[512,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[513,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[513,"بهرت مناقب مجدك الأوهاما","https://www.aldiwan.net/poem12271.html","الكامل"],[527,"أنعمت بالنعم التي","https://www.aldiwan.net/poem37440.html","مجزوء الكامل"],[527,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[536,"رام الفخار يا لها من مسخره","https://www.aldiwan.net/poem48183.html","عموديه"],[536,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[536,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[536,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[549,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[549,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[556,"رؤية الحق رؤية الأغيار","https://www.aldiwan.net/poem33550.html","الخفيف"],[556,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[556,"عرف المحبوب فابتهجا","https://www.aldiwan.net/poem34694.html","المديد"],[560,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[560,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"]],"verses":[["راموا بِذُلِّهِمُ إيهانَ عِزَّكُمُ","كَمِبرَدِ القَينِ نَحّاتاً مِنَ الجَبَلِ",0,"ل",1,0],["رامَ مِنّي قَودَ القَريضِ وَلَولا","هُ لَقَد جاذَبَ الزِمامُ الأَكُفّا",1,"ف",2,0],["راموكَ بِالأَيدي وَكانَ السُهى","أَعلى مِن أَن يُدرَكَ بِالأَذرُعِ",2,"ع",1,0],["رامِياتٍ بِالعُيونُ ال","نُجلِ قَبلَ الحَصَياتِ",3,"ت",1,0],["رَإِمنَ فَما تَنحاشُ مِنهُنَّ شارِفٌ","وَحالَفنَ حَبساً في المُحولِ وَفي الجَدبِ",4,"ب",1,0],["رامَ نَفَعاً فَضَرَّ مِن غَيرِ قَصدِ","وَمِنَ البَرِّ ما يَكونُ عُقوقا",5,"ق",2,1],["رامِياً أَخشَنَ المَناكِبِ لا يُش","خِصُ قَد هرَّهُ الهَوادي هَريرا",6,"ر",2,0],["راموا لَهُ بَتّاً وَقَد حَمَلوا","ظُلماً فَكانَ لِوَصلِهِ أَدعى",7,"ع",2,0],["رامَ إِدراكَ كُنهِ ما أَعجَزَ النا","سَ قَديماً فَلَم يَفُز بِالطِلابِ",8,"ب",1,0],["رامَ قَومٌ إِحصاء غُرّ مَساعي","هِ وَهَل تَستَطيعُ لِلنَجمِ عَدّا",9,"د",2,0],["رَامَ كُلٌّ مِنَّا مَرَاماً مِنَ العَيْ","شِ إِذَا شَطَّ قَرَّبَتْهُ الظنُونُ",10,"ن",1,0],["رامَ مِيشَالُ غَايَةً","مَنْ تَصَدَّى لَهَا ارْتَطَمْ",11,"م",1,0],["رَأَمْتَ شَعْباً شَعْباً يَشْقَى فَكنْتَ لَهُ","أُمّاً وَقَتْهُ مَكَارِهَ اليَتَمِ",12,"م",1,0],["رام استراق السمع وهو ممنّع","فأصيب من قضب العصي بأسهمِ",13,"م",1,0],["راموا الصلاح وقد جاءوا بلائحة","خرقاء تترك شمل الشعب مشعوبا",14,"ب",2,0],["راموا انشقاق العصا بالشَغْبِ ملتهباً","والحقد مضطرماً والضِغن مشبوبا",14,"ب",2,0],["رامي النواظر والقلو","ب بهاجرٍ وبهاجره",15,"ر",2,0],["رام الأقاصيَ حتَّى حازها ومضى","تبارك الله ماذا تبلغ الهمَمُ",16,"م",1,0],["راموا سلوِّي حيث لاحت نقطة","في عين ظبي لا رميت بببنه",17,"ه",1,1],["رامَ إعجابَ كل بيضاءَ خود","بسواد الخضاب ذي التعجيبِ",18,"ب",1,0],["رامَ من ضَرْعِهَا شُخُوباً فكانت","من وتين الشَّقيِّ تلكَ الشُّخُوبُ",19,"ب",1,0],["رامُوا تلافِيَ أمْرٍ فات أوَّلُهُ","وكيف يرجع أمسٌ قد محاه غَدُ",20,"د",1,0],["رامُوا بكيدِهِمُ وليَّ مُظَفَّر","لو كاده جبلٌ إذاً لتدكدكا",21,"ك",2,0],["راموا باسلحة لهم افزازه","من حدث الدخلاء بالافزاز",22,"ز",1,0],["رام الجهول نزولها","والجهل يركب ألف زَلة",23,"ل",2,0],["رامَ بِالمَغرِبِ مُلكاً فَرَمى","أَبَعدَ الغَمرِ وَأَقصى اليَبَسِ",24,"س",1,0],["رامِياتٍ بِأَسهُمٍ ريشُها الهُد","بُ تَشُقُّ القُلوبُ قَبلَ الجُلودِ",25,"د",1,0],["رام اطلاعاً على سر الخليقة في","فعل الطبيعة أعمى القلب والبصَرِ",26,"ر",1,0],["رامَ الجُحودَ تَجَلُّداً فَأَمَدَّهُ","تَهمالُ أَسطُرِ دَمعِهِ بِشُهودِ",27,"د",1,0],["رامَ الَّذي رامَ وَسَدّى الَّذي","سَدّاهُ مِن موبِقِ أَفعالِهِ",28,"ل",2,0],["راموا النَجاةَ وَكَيفَ تَنجو عُصبَةٌ","مَطلوبَةٌ بِاللَهِ وَالسُلطانِ",29,"ن",1,0],["راموا الخِلافَةَ في غَدرٍ فَأَخطَأَهُم","مِنها صُدورٌ وَفازوا بِالعَراقيبِ",30,"ب",1,0],["رامٍ بسهمٍ كأنَّه خَصِرٌ","وطيبِ نشرٍ نسيمِ كافورِ",31,"ر",1,0],["رامَت بِذَلِكَ تَخويفي فَقُلتُ لَها","عِندي مِنَ الخُبرِ ما يُغني عَنِ الخَبَرِ",32,"ر",1,0],["رامَ الصَباحُ مِنَ الدُجى اِستِنقاذَهُ","حَسَداً فَلَم يَظفَر بِغَيرِ الأَرجُلِ",33,"ل",1,0],["رامَ التَخَلُّصَ مِن هَوا","كَ فَما أَطاقَ تَخَلُّصا",34,"ص",2,0],["راموا اللَتَيّا وَالَّتي فَاِعتاقَهُم","سَيفُ الإِمامِ وَدَعوَةُ المَظلومِ",35,"م",1,0],["رامَت بِجَهلَتِها أَمراً وَلَو عَلِمَت","ماذَا أُعِدَّ لَها في الغَيبِ لَم تَرُمِ",36,"م",1,0],["رامَ ظبيُ التركِ ورداً","قلتُ أقصرْ خابَ ضدَكْ",37,"ك",1,1],["رامتْ وصالي فقلتُ لي شغلٌ","عَنْ كلِّ خودٍ تريدُ تلقاني",38,"ي",1,1],["رامَ المَدينَةَ جَمَّ العَزمِ يَبعَثُهُ","قَضاءُ أَمرٍ لِرَبِّ الناسِ مَفعولِ",39,"ل",1,0],["رامَتهُ فَاِستَعلى فَجاشَ مَغيظُها","فدنا وَغالَ إِباءَهُ الإِذعانُ",40,"ن",1,0],["راموا التَبَرُّكَ بِالمَسيحِ وَرُبَّما","نَصَبوا مَسيحاً مِن دَمٍ فَتَبَرَّكوا",41,"ك",3,0],["رَامَ من زَيْنَبَ الجِوارَ فقالتْ","إنّ في ذَا الحِمَى يُجارُ الطَّرِيدُ",42,"د",1,0],["رَام النُبوَّةَ شَطْرٌ للذي اجتمعت","فيهِ وشطرٌ له يا سوءَ ما اخترعا",43,"ع",2,0],["رامَ الورود فما انثنى حتّى ارتوت","من حوضِ مُهجته المنايا القُمَّحُ",44,"ح",1,0],["رَامَ بالطائفِ المُقامَ فأعيا","فانثنى يَطلبُ الأمانَ حَسيرا",45,"ر",2,0],["رامقاً طَرْفه السَّماءَ ومَرْمَى","عينِ مَنْ شَأْنُهُ العُلُوُّ العَلاءُ",46,"ا",2,0],["رَامَ اسْتِرَاقَ السَّمْعِ منها مارِدٌ","لَمَّا أتَتْكَ فَلَمْ يَجِدْ مِنْ مَقْعَدِ",47,"د",1,0],["رامٍ بسَهمَينِ مَبرِيٍّ يُسَدّدُهُ","وصائبٍ عَلَوِيٍّ غيرِ مَبرِيّ",48,"ي",1,0],["رامَت بِهِ الأَحبارُ نَيلَ مَعيشَةٍ","في الدَهرِ وَالعَمَلُ القَبيحُ يُتَبِّرُ",49,"ر",1,0],["رامَ دُنياهُ ناسِكٌ","فَاِدَّعى النُسكَ وَاِنتَحَل",50,"ل",1,1],["راموا وصولاً إلى ما فيه منفعة","لهم وفي الوقت لم يسعوا فَلَم يصلوا",51,"ل",3,0],["رام هتكاً لما تصون فتاة","كسبت في أَمر العفاف اِشتهارا",52,"ر",2,0],["رام شيناً لبنت بغداد يزري","فَعَلى الشعب شعبها أَن يغارا",52,"ر",2,0],["رام بقوس للقضاء تعددت","منها السهام تعدد الأهداف",53,"ف",1,0],["راموا سرائر للرحمن حجّبها","ما نالهنّ نبىّ، لا ولا ملك",54,"ك",1,0],["رام بالريف والصعيد أمورا","لم تنل كنه غورها الاغبياء",55,"ا",2,0],["رام تاجيهما وعرش المعالي","ويروم العظائم العظماء",55,"ا",2,0],["راموا انْصِرافي عنِ المَعالي","والغَرْبُ مِن دُونِها فليلُ",56,"ل",1,0],["رَام أَنْ يَرْسِمُهُ","لِلنَّاسِ رَسْماً مُخْلِدَا",57,"د",2,0],["رام اللبابَ المَحْضَ من سَعْيِهِ","فلم يَنَلْ منه سِوَى قِشْرِه",58,"ر",2,0],["رَامَ أن يستنْقِذَ الكَوْ","نَ ويَسْتَأْصِلَ شَرَّهْ",59,"ر",2,0],["رَامَا الغَداءَ على حسابي","فتقاسما ثمن الكبابِ",60,"ب",1,1],["رَامَ الذي رَامَ، وَسَدّ الذي","سَدّاهُ مِنْ مُوبِقِ أفْعَالِهِ",61,"ل",2,0],["رام الجحود تجلداً فأمده","تهال أسطر دمعه بشهود",62,"د",1,0],["رامَ العِداة وَقَد زَوى غُصن الصِبا","إِن لا تَروج بِضاعَتي وَتَحَققوا",63,"ق",3,0],["رام التفرنج بعضهم فتمزقوا","في السير لا سهل ولا اجبال",64,"ل",1,0],["راموا الكرام بعيب كاذب ورموا","بالزور مجدهمو والنذل بهات",65,"ت",1,0],["رامُوا صدورَهُم فأضْحَ","ى حبلُ سُلْوَاني رَمِيما",66,"م",2,0],["رامُوا قتالك قبل فإنْ","قَادُوا إليك بِلاَ زِمامِ",67,"م",1,0],["رامَ العَواذِلُ أن أوراي لوعتي","بعد الوقوف على ديار نَوَارِ",68,"ر",1,0],["رامني بالخيانة ليس يدري","بأني والشهود عَلَيَّ قاموا",69,"م",3,0],["رَامَ مَارَامُه سَفَاهَا ومَا قَد","رُمتُه أنتَ لَم تَرُمهُ سَفَاهَا",70,"ا",3,0],["رَامني بالهِجَا ولَو عَلِمَ ال","غَيب أبَى حِينَ رُمتُهُ أن يَرُومَا",71,"م",2,0],["رامٍ وما القارةُ آباؤه","يَستغرق السهمَ وما أنبضا",72,"ض",2,0],["راموا المَوَدّاتِ مِن أَعدى عُداتِهِمُ","وَذاكَ رَأيٌ إِلى غَيرِ الصَوابِ صَبا",73,"ب",2,0],["راموا اللحاق به فجاءوا آخرا","شدُّوا وأقبل سابقاً متهللا",74,"ل",2,0],["راموا لقاك فلم تشجن غداة إذن","على ذياب أرادت نطحها غنم",75,"م",1,0],["رام اضطهاد الدين في إقباله","والشرك في الإِدبار والايهان",76,"ن",1,0],["رامَت ذَوُو أَمرِنا إِطفاءَ جَمرَتِنا","فَبَعدَها أَلحِقِ الأَحساءَ يَبرِينا",77,"ن",2,0],["رامَ المُبَشِّرُ تاريخاً فَصاحَ بِهِ","إِنَّ الأَعالي بِميخائيلَ تَبتَهِجُ",78,"ج",1,0],["رامَ غِناءً فَأَبى صَوتُهُ","فَرامَ ضَرباً فَأَبى زِيرُه",79,"ه",1,0],["راموا انقلابَ الودِّ فلْترْمِهِمْ","بردهم ينقلبوا صاغرين",80,"ن",1,0],["رامت صروفُ الحادثاتِ فأدركت","مَنْ كان لم يبعدْ عليه مرام",81,"م",1,0],["رامت تقاس بها الغصون جهالة","فاتى القوام على خلاف قياسها",82,"س",3,0],["رامَ مِنها فَتى مراماً شَريفاً","كلُّ ما شاءَه الفَتى كانَ طُهرا",83,"ر",2,0],["رامَتكَ شِبلا كي تُعِزّ عَرينَها","فَأَبَيتَ إِلّا أَن تَكون غَضَنفَرا",84,"ر",2,0],["راموا النِضالَ وَما لَهُم بِكِنان