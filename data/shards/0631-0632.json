{"poems":[[53,"لعمر الطير يوم ثوى ابن ليلى","https://www.aldiwan.net/poem29808.html","الوافر"],[53,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[63,"سرى البرق وهنا فاستحنت جماليا","https://www.aldiwan.net/poem45947.html","الطويل"],[63,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[57,"لو كنت بالعقل تعطى ما تريد إذن","https://www.aldiwan.net/poem24656.html","البسيط"],[93,"رزئت أباً لو طالب الدهر نفسه","https://www.aldiwan.net/poem9155.html","الطويل"],[93,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"متى ينجلي هذا السحاب المخيم","https://www.aldiwan.net/poem11322.html","الطويل"],[54,"ألا ما لعيني بالدموع استهلت","https://www.aldiwan.net/poem27437.html","الطويل"],[88,"على قاسم شيخ الطريقة قد بكت","https://www.aldiwan.net/poem45029.html","الطويل"],[88,"نعى البرق من باريس ساسون فاغتدت","https://www.aldiwan.net/poem45033.html","الطويل"],[88,"أبو غازي قضى فاقيم غازي","https://www.aldiwan.net/poem45037.html","الوافر"],[88,"بكى الفضل لما أن قضى نحبه جبر","https://www.aldiwan.net/poem45039.html","الطويل"],[88,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[88,"عبد المجيد قضى فوا حربا","https://www.aldiwan.net/poem45048.html","أحذ الكامل"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[23,"ولقد بكيت وعز مهلك جعفر","https://www.aldiwan.net/poem21429.html","الكامل"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"أبا جعفر لا زلت معطى وواهبا","https://www.aldiwan.net/poem8161.html","الطويل"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"فقدتك يا كنيزة كل فقد","https://www.aldiwan.net/poem8705.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا أيها السيد الذي غمرت","https://www.aldiwan.net/poem62932.html","الكامل"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[51,"الدمع في العين لا نوم ولا نظر","https://www.aldiwan.net/poem65718.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[85,"رزقت صاحب عهده","https://www.aldiwan.net/poem8069.html","المجتث"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[85,"رزق الله أهل باريس خيرا","https://www.aldiwan.net/poem63702.html","الخفيف"],[62,"قالوا صبرت على المكروه من نفر","https://www.aldiwan.net/poem52427.html","البسيط"],[62,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[45,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[45,"أجدك ما ينفك يسري لزينبا","https://www.aldiwan.net/poem10897.html","الطويل"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[45,"نسعى وأيسر هذا السعي يكفينا","https://www.aldiwan.net/poem66668.html","البسيط"],[28,"تمنى المستزيدة لي المنايا","https://www.aldiwan.net/poem5087.html","الوافر"],[61,"وجدول بين حديقتين","https://www.aldiwan.net/poem51419.html","الرجز"],[61,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[61,"وشاحب اللبسة والأعضاء","https://www.aldiwan.net/poem51835.html","الرجز"],[58,"لو كان في صخرة في البحر راسية","https://www.aldiwan.net/poem30801.html","البسيط"],[58,"أولئك إخواني الذاهبون","https://www.aldiwan.net/poem31130.html","المتقارب"],[58,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[49,"رزأتك يا هذا فهنت عليكا","https://www.aldiwan.net/poem62208.html","الطويل"],[49,"ألا يا عتب يا قمر الرصافه","https://www.aldiwan.net/poem64245.html","الوافر"],[80,"ثلاثة أفلاك عن العين مضمره","https://www.aldiwan.net/poem31435.html","الطويل"],[44,"دعني وشرب الهوى يا شارب الكاس","https://www.aldiwan.net/poem30238.html","البسيط"],[44,"اليوم أدرج زيد الخيل في كفن","https://www.aldiwan.net/poem30299.html","البسيط"],[44,"يا دهر قدك وقلما يغني قدي","https://www.aldiwan.net/poem30317.html","الكامل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[105,"هل في جفونكما دمع لممتاح","https://www.aldiwan.net/poem43147.html","البسيط"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[50,"أجارتنا لا تجزعي وأنيبي","https://www.aldiwan.net/poem64831.html","الطويل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[76,"ساق ترنح يشدو فوقه ساق","https://www.aldiwan.net/poem39256.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21001","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42693","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55159","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55067","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43807","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43841","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[50,"أجَارَتَنَا لاَ تَجْرَعِي وَأنِيبِي","https://www.poetsgate.com/ViewPoem.aspx?id=17154",""],[86,"لي وَلَدٌ سَمَّيْتُهُ حافِظاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13057&r=&rc=13",""],[105,"ركد الرجاء فما يهزك مأرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54954&r=&rc=124",""]],"verses":[["رُزِئتُكَ كَالوَذيلَةِ لَم تُمَتَّع","بِها بَعدَ الوُجودِ يَدُ العَديمِ",0,"م",1,0],["رَزيئَةٌ لَم تَدَع شَمساً وَلا قَمَراً","وَلا غَماماً وَلا نَجماً وَلا فَلَكا",1,"ك",2,0],["رُزءٌ تَخَضخَضَ سَهمُهُ في مَقتَلي","يَمضي الزَمانُ وَنَصلُهُ لَم يُنزَعِ",2,"ع",1,0],["رُزِئتُكَ حَيّاً بِالقَطيعَةِ وَالقِلى","وَبَعضُ الرَزايا قَبلَ يَومِ الفَتى المَقضي",3,"ي",1,0],["رُزآنِ يَزدادانِ طولَ تَجَدُّدٍ","أَبَدَ الزَمانِ فَناؤُها وَبَقائي",4,"ي",1,0],["رُزِقْتَ الهُدى وَاللهُ مَغْوٍ وَمُرْشِدٌ","فَدَعْني وَما أَخْتارُهُ مِنْ ضَلالِيا",5,"ل",3,0],["رَزينُ حَصاةِ الحِلْمِ لا يَسْتَزِلُّهُ","مُدامٌ ولا تُفْشي لهُ السِّرَّ ألحانُ",6,"ن",1,0],["رُزِقتَ مالاً عَلى جَهلٍ فَعِشتَ بِهِ","فَلَستَ أَوَّلَ مَجنونٍ وَمَرزوقِ",7,"ق",1,0],["رزئت أباً لو طالب الدهر نفسه","بمثل له ندب لما جاء بالمثل",8,"ل",1,1],["رُزِئْتَ أَيَّ وَلِيدٍ","نَضْرِ المُحَيَّا صَبِيحِهْ",9,"ح",2,0],["رُزِئْتَ أَمِيناً أُمَّةٌ مَفْؤُودَةٌ","لِفِرِاقِهِ سَكْرَى مِنَ الأَحْزَانِ",10,"ن",1,0],["رَزَايَا أَتَاهَا الْجَهْلُ فَالجَهْلَ قَاتِلُوا","فَإِنْ تَجْمُدُوا عُدْنَا عَلَى البَدْءِ فَاعْلَمُوا",11,"م",3,0],["رُزينا رَضِيَّ اللَهِ سِبطَ نَبِيِّنا","فَأَخلَفَتِ الدُنيا لَهُ وَتَوَلَّتِ",12,"ت",1,0],["رزئناه حبراً في الطريقة مرشداً","به اتضحت للساكين المعالم",13,"م",1,0],["رزئناك مِفضالاً ففقدك محزن","ومسعاك محمود وذكرك طيّب",14,"ب",1,0],["رزئنا ابن الحسين فنحن منه","برزءٍ للحسين أولو اجتياز",15,"ز",1,0],["رزئناه في كلّية العلم هادياً","يضيء به للعلم في أفقها بدر",16,"ر",1,0],["رزآن ملتهبان قد نضحتهما","عين العلا من دمعها بغزيره",17,"ر",2,0],["رزءٌ أثار الحزن ملتهبا","في كل قلبٍ أيّ ملتهب",18,"ب",1,0],["رُزِقنا بِهِ الصَيدَ الغَزيرَ وَلَم أَكُن","كَمَن نَبلُهُ مَحرومَةٌ وَحَبائِلُه",19,"ل",2,0],["رُزِقَت مَرابيعَ النُجومِ وَصابَها","وَدقُ الرَواعِدِ جَودُها فَرِهامُها",20,"م",3,0],["رُزءً وَأَكرَمِها جَميعاً مُحتِداً","وَأَعَزِّها مُتَظَلِّماً وَأَذَلَّها",21,"ل",3,0],["رزية من كانت له أصل بهجة","وكلّ بهيج ضمنها يتفرَّع",22,"ع",1,0],["رُزِقتُ مُلكاً فَلَم أَحسِن سِياسَتَهُ","وَكُلُّ مَن لا يُسُوسُ المُلكَ يَخلَعُهُ",23,"ع",2,0],["رُزئنا جسيماً من لِقائك شاهداً","فعوِّضْ جسيماً من حِبائك غائبا",24,"ب",2,0],["رُزق الإمامُ بِعَقْب هُلْكِ عدوِّهِ","ولداً أطاب به الإمام وأنجبا",25,"ب",2,0],["رُزئتَ التي ودَّت بقاءَك بعدها","وأحيت به في ليلها الدعواتِ",26,"ت",1,0],["رُزقتُك ليلةً فرُزقتُ رزقاً","بوُدِّي أنه أبداً يفوتُ",27,"ت",1,0],["رُزِئتٌ شبابي عَوْدةً بعد بَدْأةٍ","وَهُنَّ الرزايا بادئاتٌ وعُوَّدُ",28,"د",1,0],["رَزَحْتُ على مر الليالي وَكرِّهَا","وهل عن فَنَاءٍ من فناءَيْن عُنْدَدُ",28,"د",1,0],["رزقي لشهرين قد علمتَ به","أربعةٌ نيّفت على عشره",29,"ر",2,0],["رزقي لستَ الذي تُسبِّبهُ","مسبِّبُ الرزقِ مُنشئُ الصُّور",30,"ر",1,0],["رَزيّةُ خال كان للدهرِ جُنَّةً","إذا الدهر أنحَى مُرْهفات شِفاره",31,"ر",2,0],["رُزِئناه يومَ الأربِعاء ولم تزل","فَواقرُ هذا الدهر يوم دبَاره",31,"ر",2,0],["رزئي أجلُّ فلا تكذب ظنونكما","من أن يُصدَّق مجلودي ولو صدقا",32,"ق",2,0],["رُزِق الشعرُ منكَ والقائلُوه","كلَّ حظّ فما لشعري ومالي",33,"ل",2,0],["رزيئةِ أمٍّ كنتُ أحيا بِرُوحِها","وأستدفعُ البلوى وأستكشفُ الغُممْ",34,"م",1,0],["رُزِئَت بنيها الصالِحينَ وَغودِرَت","وَلهَى مُرَوَّعَةً تَرِنُّ وَتَندُبُ",35,"ب",1,0],["رُزِقتُ صاحِبَ عَهدِهِ","وَتَمَّ لِيَ النَسلُ بَعدي",36,"ي",1,1],["رُزِقتَ أَسمَحَ ما في الناسِ مِن خُلُقٍ","إِذا رُزِقتَ اِلتِماسَ العُذرِ في الشِيَمِ",37,"م",1,0],["رُزءُ البَرِيَّةِ في الوَزيرِ زِيادَةٌ","فيما أَلَمَّ بِها مِنَ الأَرزاءِ",38,"ا",2,0],["رَزَقَ اللَهُ أَهلَ باريسَ خَيراً","وَأَرى العَقلَ خَيرَ ما رُزِقوهُ",39,"ق",3,1],["رُزْنَا الأمورَ فلم نعرفْ حقائِقَها","من بعد فكرٍ فصار الخُبْرُ كالخَبَرِ",40,"ر",1,0],["رزينُ حَصاةِ النُّهَى ثابت","إِذا ظَنَّ أو قال يوماً أصابْ",41,"ب",1,0],["رَزِيَّةُ هالِكٍ جَلَبَت رَزايا","وَخَطبٌ باتَ يَكشِفُ عَن خُطوبِ",42,"ب",1,0],["رَزينٌ إِذا ما القَومُ خَفَّت حُلومُهُم","وَقورٌ إِذا ما حادِثُ الدَهرِ أَجلَبا",43,"ب",2,0],["رَزايا مِن شُيوخِ الأَزدِ أَلقَت","عَلَينا كُلَّ موهِنَةٍ هَدودِ",44,"د",1,0],["رُزِئنا النَدى الرِبعِيَّ حينَ تَهَلَّلَت","بَوارِقُهُ وَجادَنا مُتَراكِمُه",45,"م",2,0],["رَزِيَّةٌ مِن رَزايا الدَهرِ شاغِلَةٌ","لِناصِرِ الدينِ عَن أَن يَنصُرَ الدينا",46,"ن",2,0],["رُزِئنا غالِباً وَأَباهُ كانا","سِماكَي كُلِّ مُهتَلِكٍ فَقيرِ",47,"ر",1,0],["رِزقاً هنيئاً يملأُ اليَديْنِ","بغيرِ كَدٍّ وبغيرِ أينِ",48,"ن",1,0],["رَزَحَتْ مخائِلُ بأسِه في عارضٍ","مُتألِّقٍ يَغْشى العُيونَ بَريقا",49,"ق",2,0],["رِزقاً رُزِقْناه بلا عَناءٍ","نَعُدُّه من سابغِ النَّعماءِ",50,"ا",2,0],["رِزقٌ لِعَبدٍ يَراهُ اللَهُ لانغَلَقَت","حَتّى يَؤدّى إِلَيهِ كُلُّ ما فيها",51,"ي",3,0],["رُزِئتُ صَب