],[367,"أيا من أرجيه وآمل عفوه","https://www.aldiwan.net/poem4325.html","الطويل"],[377,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[399,"أو أنه كان يرضي الموت فيك فدى","https://www.aldiwan.net/poem46439.html","البسيط"],[403,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[406,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[406,"لما تخطتني السبعون معرضة","https://www.aldiwan.net/poem31948.html","البسيط"],[413,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[413,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[413,"ما لي أودع كل يوم صباحا","https://www.aldiwan.net/poem54093.html","الكامل"],[413,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[434,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[436,"ما أطبق الهم إلا ريثما انفرجا","https://www.aldiwan.net/poem34794.html","البسيط"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[438,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[438,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[438,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[451,"قالوا تصبر قد يتوب الغادر","https://www.aldiwan.net/poem61766.html","الكامل"],[456,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[456,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[456,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[456,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[459,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[459,"يا فارس الهولين عم رداهما","https://www.aldiwan.net/poem15443.html","الكامل"],[459,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[459,"يقر بعيني أن يعيش بغبطة","https://www.aldiwan.net/poem15667.html","الطويل"],[459,"يفضله على ماء الغوادي","https://www.aldiwan.net/poem15693.html","الوافر"],[459,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[459,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[462,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[462,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[504,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[512,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[513,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[513,"أقول والصدق فيما قلت يعضدني","https://www.aldiwan.net/poem12281.html","البسيط"],[513,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[527,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[549,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[549,"لأنتم آل خير الناس كلهم","https://www.aldiwan.net/poem47379.html","البسيط"],[549,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[549,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[549,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[565,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[571,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"]],"verses":[["رُزِئتُكَ كَالوَذيلَةِ لَم تُمَتَّع","بِها بَعدَ الوُجودِ يَدُ العَديمِ",0,"م",1,0],["رَزيئَةٌ لَم تَدَع شَمساً وَلا قَمَراً","وَلا غَماماً وَلا نَجماً وَلا فَلَكا",1,"ك",2,0],["رُزءٌ تَخَضخَضَ سَهمُهُ في مَقتَلي","يَمضي الزَمانُ وَنَصلُهُ لَم يُنزَعِ",2,"ع",1,0],["رُزِئتُكَ حَيّاً بِالقَطيعَةِ وَالقِلى","وَبَعضُ الرَزايا قَبلَ يَومِ الفَتى المَقضي",3,"ي",1,0],["رُزآنِ يَزدادانِ طولَ تَجَدُّدٍ","أَبَدَ الزَمانِ فَناؤُها وَبَقائي",4,"ي",1,0],["رُزِقْتَ الهُدى وَاللهُ مَغْوٍ وَمُرْشِدٌ","فَدَعْني وَما أَخْتارُهُ مِنْ ضَلالِيا",5,"ل",3,0],["رَزينُ حَصاةِ الحِلْمِ لا يَسْتَزِلُّهُ","مُدامٌ ولا تُفْشي لهُ السِّرَّ ألحانُ",6,"ن",1,0],["رُزِقتَ مالاً عَلى جَهلٍ فَعِشتَ بِهِ","فَلَستَ أَوَّلَ مَجنونٍ وَمَرزوقِ",7,"ق",1,0],["رزئت أباً لو طالب الدهر نفسه","بمثل له ندب لما جاء بالمثل",8,"ل",1,1],["رُزِئْتَ أَيَّ وَلِيدٍ","نَضْرِ المُحَيَّا صَبِيحِهْ",9,"ح",2,0],["رُزِئْتَ أَمِيناً أُمَّةٌ مَفْؤُودَةٌ","لِفِرِاقِهِ سَكْرَى مِنَ الأَحْزَانِ",10,"ن",1,0],["رَزَايَا أَتَاهَا الْجَهْلُ فَالجَهْلَ قَاتِلُوا","فَإِنْ تَجْمُدُوا عُدْنَا عَلَى البَدْءِ فَاعْلَمُوا",11,"م",3,0],["رُزينا رَضِيَّ اللَهِ سِبطَ نَبِيِّنا","فَأَخلَفَتِ الدُنيا لَهُ وَتَوَلَّتِ",12,"ت",1,0],["رزئناه حبراً في الطريقة مرشداً","به اتضحت للساكين المعالم",13,"م",1,0],["رزئناك مِفضالاً ففقدك محزن","ومسعاك محمود وذكرك طيّب",14,"ب",1,0],["رزئنا ابن الحسين فنحن منه","برزءٍ للحسين أولو اجتياز",15,"ز",1,0],["رزئناه في كلّية العلم هادياً","يضيء به للعلم في أفقها بدر",16,"ر",1,0],["رزآن ملتهبان قد نضحتهما","عين العلا من دمعها بغزيره",17,"ر",2,0],["رزءٌ أثار الحزن ملتهبا","في كل قلبٍ أيّ ملتهب",18,"ب",1,0],["رُزِقنا بِهِ الصَيدَ الغَزيرَ وَلَم أَكُن","كَمَن نَبلُهُ مَحرومَةٌ وَحَبائِلُه",19,"ل",2,0],["رُزِقَت مَرابيعَ النُجومِ وَصابَها","وَدقُ الرَواعِدِ جَودُها فَرِهامُها",20,"م",3,0],["رُزءً وَأَكرَمِها جَميعاً مُحتِداً","وَأَعَزِّها مُتَظَلِّماً وَأَذَلَّها",21,"ل",3,0],["رزية من كانت له أصل بهجة","وكلّ بهيج ضمنها يتفرَّع",22,"ع",1,0],["رُزِقتُ مُلكاً فَلَم أَحسِن سِياسَتَهُ","وَكُلُّ مَن لا يُسُوسُ المُلكَ يَخلَعُهُ",23,"ع",2,0],["رُزئنا جسيماً من لِقائك شاهداً","فعوِّضْ جسيماً من حِبائك غائبا",24,"ب",2,0],["رُزق الإمامُ بِعَقْب هُلْكِ عدوِّهِ","ولداً أطاب به الإمام وأنجبا",25,"ب",2,0],["رُزئتَ التي ودَّت بقاءَك بعدها","وأحيت به في ليلها الدعواتِ",26,"ت",1,0],["رُزقتُك ليلةً فرُزقتُ رزقاً","بوُدِّي أنه أبداً يفوتُ",27,"ت",1,0],["رُزِئتٌ شبابي عَوْدةً بعد بَدْأةٍ","وَهُنَّ الرزايا بادئاتٌ وعُوَّدُ",28,"د",1,0],["رَزَحْتُ على مر الليالي وَكرِّهَا","وهل عن فَنَاءٍ من فناءَيْن عُنْدَدُ",28,"د",1,0],["رزقي لشهرين قد علمتَ به","أربعةٌ نيّفت على عشره",29,"ر",2,0],["رزقي لستَ الذي تُسبِّبهُ","مسبِّبُ الرزقِ مُنشئُ الصُّور",30,"ر",1,0],["رَزيّةُ خال كان للدهرِ جُنَّةً","إذا الدهر أنحَى مُرْهفات شِفاره",31,"ر",2,0],["رُزِئناه يومَ الأربِعاء ولم تزل","فَواقرُ هذا الدهر يوم دبَاره",31,"ر",2,0],["رزئي أجلُّ فلا تكذب ظنونكما","من أن يُصدَّق مجلودي ولو صدقا",32,"ق",2,0],["رُزِق الشعرُ منكَ والقائلُوه","كلَّ حظّ فما لشعري ومالي",33,"ل",2,0],["رزيئةِ أمٍّ كنتُ أحيا بِرُوحِها","وأستدفعُ البلوى وأستكشفُ الغُممْ",34,"م",1,0],["رُزِئَت بنيها الصالِحينَ وَغودِرَت","وَلهَى مُرَوَّعَةً تَرِنُّ وَتَندُبُ",35,"ب",1,0],["رُزِقتُ صاحِبَ عَهدِهِ","وَتَمَّ لِيَ النَسلُ بَعدي",36,"ي",1,1],["رُزِقتَ أَسمَحَ ما في الناسِ مِن خُلُقٍ","إِذا رُزِقتَ اِلتِماسَ العُذرِ في الشِيَمِ",37,"م",1,0],["رُزءُ البَرِيَّةِ في الوَزيرِ زِيادَةٌ","فيما أَلَمَّ بِها مِنَ الأَرزاءِ",38,"ا",2,0],["رَزَقَ اللَهُ أَهلَ باريسَ خَيراً","وَأَرى العَقلَ خَيرَ ما رُزِقوهُ",39,"ق",3,1],["رُزْنَا الأمورَ فلم نعرفْ حقائِقَها","من بعد فكرٍ فصار الخُبْرُ كالخَبَرِ",40,"ر",1,0],["رزينُ حَصاةِ النُّهَى ثابت","إِذا ظَنَّ أو قال يوماً أصابْ",41,"ب",1,0],["رَزِيَّةُ هالِكٍ جَلَبَت رَزايا","وَخَطبٌ باتَ يَكشِفُ عَن خُطوبِ",42,"ب",1,0],["رَزينٌ إِذا ما القَومُ خَفَّت حُلومُهُم","وَقورٌ إِذا ما حادِثُ الدَهرِ أَجلَبا",43,"ب",2,0],["رَزايا مِن شُيوخِ الأَزدِ أَلقَت","عَلَينا كُلَّ موهِنَةٍ هَدودِ",44,"د",1,0],["رُزِئنا النَدى الرِبعِيَّ حينَ تَهَلَّلَت","بَوارِقُهُ وَجادَنا مُتَراكِمُه",45,"م",2,0],["رَزِيَّةٌ مِن رَزايا الدَهرِ شاغِلَةٌ","لِناصِرِ الدينِ عَن أَن يَنصُرَ الدينا",46,"ن",2,0],["رُزِئنا غالِباً وَأَباهُ كانا","سِماكَي كُلِّ مُهتَلِكٍ فَقيرِ",47,"ر",1,0],["رِزقاً هنيئاً يملأُ اليَديْنِ","بغيرِ كَدٍّ وبغيرِ أينِ",48,"ن",1,0],["رَزَحَتْ مخائِلُ بأسِه في عارضٍ","مُتألِّقٍ يَغْشى العُيونَ بَريقا",49,"ق",2,0],["رِزقاً رُزِقْناه بلا عَناءٍ","نَعُدُّه من سابغِ النَّعماءِ",50,"ا",2,0],["رِزقٌ لِعَبدٍ يَراهُ اللَهُ لانغَلَقَت","حَتّى يَؤدّى إِلَيهِ كُلُّ ما فيها",51,"ي",3,0],["رُزِئتُ صَبيباً عَلى فاقَةٍ","وَفارَقتُ بَعدَ حَبيبٍ حَبيبا",52,"ب",2,0],["رُزِئنا رَسولَ اللَهِ حَقّاً فَلَن نَرى","بِذاكَ عَديلاً ما حَيينا مِنَ الرَدى",53,"ا",1,0],["رَزَأتُكَ يا هَذا فَهُنتُ عَلَيكا","وَصَغَّرتَني مُذ نِلتُ فَضلَ يَدَيكا",54,"ك",2,1],["رُزِقتِ مَوَدَّتي وَرُزِقتِ عَطفي","وَلَم أُرزَق فَدَيتُكَ مِنكِ رافَه",55,"ف",2,0],["رَزينُ حَصاةِ الحِلمِ شَهمٌ مُهَذَّبٌ","تَرى مِنهُ بَدراً في السريرِ وَقَسوَرَه",56,"ر",2,0],["رُزِقتُ رِقَّةَ قَلبٍ مِنهُ نَغَّصَهُ","مُنَغِّصٌ مِن رَقيبٍ قَلبُهُ قاسي",57,"ي",1,0],["رُزءٌ عَلى طَيِّئٍ أَلقى كَلاكِلَهُ","لا بَل عَلى أُدَدٍ لا بَل عَلى اليَمَنِ",58,"ن",1,0],["رُزِئَت بَنو عَمرِو بنِ عامِرٍ الذُرى","بِهِما وَصَوَّحَ نَبتُ واديها النَدي",59,"د",2,0],["رُزِقُوا اليقينَ فلا ذليلٌ ضارعٌ","يَطوِي الجناحَ ولا جَبانٌ مُشفِقُ",60,"ق",1,0],["رُزْءان ما بلَغتْ بَعيدَ مَداهما","هِممُ الخُطوبِ ولا قُوى الأرزاءِ",61,"ا",2,0],["رزقُ الذّئابِ أبيحَ غير مُكدَّرٍ","ومن الشُّعوبِ ضراغمٌ ونِقادُ",62,"د",1,0],["رُزِئْنا في البقيَّةِ من بنيها","فصبراً للنّوائبِ واحتسابا",63,"ب",2,0],["رُزءُ الخِلافَةِ ذاقَت مِصرُ لَوعَتَهُ","فَما تُفيقُ وَلا تُصغي إِلى اللّاحي",64,"ح",2,0],["رُزِقْتَ ذُرِّيَّةً ضاهَتْكَ طَيِّبَةً","مِنْ طِينَةٍ غارَ منها العَنْبَرُ العَطِرُ",65,"ر",1,0],["رِزانٍ إِذا رَعَدَت مُزنَةٌ","عَلَيهِم فَإِن يَسمَعوا الراعِدا",66,"د",2,0],["رَزينُ حَصاةِ العِلمِ لا يَستَخِفُّهُ","أَحاديثُ يَستَوعي عَلَيها المُعَيِّبُ",67,"ب",1,0],["رُزِئتُ بُنَيِّي حينَ أَورَقَ عودُهُ","وَأَلقى عَلَيَّ الهَمَّ كُلُّ قَريبِ",68,"ب",1,0],["رُزِقا العَلاءَ فأهْلُ نَجدٍ كُلّما","نَطَقا الفَصاحَةَ مثلُ أهلِ دِيافِ",69,"ف",1,0],["رُزِقْنَ تَمَكنّاً مِن كلّ قلْبٍ","فليسَ لغيرِهِنّ به مَكانُ",70,"ن",1,0],["رِزُّهُ قَدِّم وَهَب وَهَلا","ذي زُهاءٍ جَمَّةٍ بُهَمُه",71,"م",2,0],["رِزْقٌ مِنَ اللَّهِ أَرضاهُمْ وَأَسخَطَني","واللَّهُ لِلأَنْوكِ المَعْتُوهِ رزَّاقُ",72,"ق",1,0],["رزء عبد الرَحمن واحرَّ قَلبا","لا يريني الص