{"poems":[[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[9,"كفى بالذي تولينه لو تجنبا","https://www.aldiwan.net/poem21907.html","الطويل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[39,"وإن أدع في حيى ربيعة تأتني","https://www.aldiwan.net/poem7226.html","الطويل"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[87,"أقدم فليس على الإقدام ممتنع","https://www.aldiwan.net/poem63762.html","البسيط"],[30,"أنت الذي عنا بلال دفعته","https://www.aldiwan.net/poem5331.html","الطويل"],[99,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[48,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39602","الرمل"],[108,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[102,"بين الرجل والطريق","https://www.poetsgate.com/ViewPoem.aspx?id=50371",""],[102,"يا نجوم","https://www.poetsgate.com/ViewPoem.aspx?id=50456",""],[102,"نحن والحاكمون","https://www.poetsgate.com/ViewPoem.aspx?id=50118",""],[9,"كَفَى بِالّذِي تُولِينَهُ لَوْ تَجَنّبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17253&r=&rc=0",""],[147,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[201,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[211,"وإن تك من سعد العشيرة تلقني","https://www.aldiwan.net/poem27968.html","الطويل"],[264,"أسعفي يا ذات ربي بالمنى","https://www.aldiwan.net/poem35956.html","الرمل"],[302,"قف بالعذيب وحي حي قطينه","https://www.aldiwan.net/poem33134.html","الكامل"],[333,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[409,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[415,"إن لم أبح بهواك قلن لوائمي","https://www.aldiwan.net/poem32382.html","الكامل"],[438,"أومض برق الخجل","https://www.aldiwan.net/poem12371.html","مجزوء الرجز"],[447,"إذا كان أولادي وأولاد أولادي","https://www.aldiwan.net/poem14362.html","الطويل"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[487,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[488,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[505,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122618","الوافر"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88596","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86921","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59765","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59685","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120104","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112846","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20012","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48940","المتقارب"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27108","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126233","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129832","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205840","عدة أبحر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109793","المتقارب"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113689","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201460","الخفيف"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11259","البسيط"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107052","الطويل"],[3178,"","https://poetry.dctabudhabi.ae/diwan/poem/144552","الكامل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99314","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3598,"","https://poetry.dctabudhabi.ae/diwan/poem/198749","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91282","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206162","الخفيف"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4081,"","https://poetry.dctabudhabi.ae/diwan/poem/67680","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83366","الطويل"],[4718,"ياهاجسي عطني جزيل القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=137250",""],[4802,"انا من وين ما سافر","https://www.poetsgate.com/ViewPoem.aspx?id=34303",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5183,"الحمول","https://www.poetsgate.com/ViewPoem.aspx?id=186488",""],[5183,"الشيء المعقد","https://www.poetsgate.com/ViewPoem.aspx?id=180177",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5457,"عيون الصب","https://www.poetsgate.com/ViewPoem.aspx?id=213312",""],[5563,"بلا حدود","https://www.poetsgate.com/ViewPoem.aspx?id=214454",""],[5727,"الشاطئ البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=205417",""],[5809,"يومان","https://www.poetsgate.com/ViewPoem.aspx?id=205556",""],[5858,"رسالة الى البردوني","https://www.poetsgate.com/ViewPoem.aspx?id=195176",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[5957,"بهجة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=27078",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""]],"verses":[["وَإِن أَدلَجوا لَم يَسأَلِ اللَيلُ عَنهُمُ","كَأَنَّهُمُ فيهِ النُجومُ الطَوالِعُ",0,"ع",1,0],["وَإِن أَدنُ مِنكُم لا أَكُن ذا تَميمَةٍ","يُرى بَينَكُم مِنها الأَجالِدُ مُثقَبا",1,"ب",2,0],["وَإِن أَدبَرَت قُلتَ أَثفِيَّةٌ","مُلَملَمَةٌ لَيسَ فيها أُثُر",2,"ر",1,0],["وإن أدعُ في حيى ربيعة تأتني","عرانين يسحبن الألد الملاقسا",3,"س",2,1],["وأُناديك عائذاً يا أبا القا","سم أفديك يا عزيزَ الفداءِ",4,"ا",2,0],["وَأَنَّ أَدراجَها في الجَوِّ يَسلُكُها","جِنٌّ جُنودُ سُلَيمانٍ لَها تَبَعُ",5,"ع",1,0],["وَإِنّا دَعَونا اللَهَ إِذ نَزَلَت بِنا","مُجَلِّلَةً إِحدى اللَيالي الخَوائِفِ",6,"ف",1,0],["وأناديك في التداني وما أطمع إلا أن يستجاب النداء","باسمك العذب أنه أجمل الأسماء مهما تعددت أسماء",7,"ا",2,0],["وَإِن أَدنَت لَنا أَمَلاً فَقُلنا","أَتانا أَبعَدَتهُ وَأَسحَقَتهُ",8,"ت",2,0],["وَإِن أُدعَ لِلجُلّى أَكُن مِن حُماتِها","وَإِن يَأتِكَ الأَعداءُ بِالجَهدِ أَجهَدِ",9,"د",1,0],["وأن أُديخَ أرضَ بَنْبلونَهْ","وساحةَ المدينةِ الملْعُونَهْ",10,"ه",1,0],["وأنادي يا ليلة الوصل قرّى","إن بعد السُّرى يطيب المقرُّ",11,"ر",1,0],["وأناديكِ وأستدني يداً","لمستْ روحي وهزَّت خاطري",12,"ر",2,0],["وإن آده عبءٌ، نهضتَ بحمَله","وإن نالهُ خصمٌ، فعزَمك قاهره",13,"ر",2,0],["وأنادي : يا ممرات ، إلى أين","تنجرّ طوابير السخافه؟",14,"ف",2,0],["وأنادي والريح تمضي وتأتي","كالمناشير ، جيئة وارتدادا",15,"د",2,0],["وإن أدمنوا دمنا فالوحوش","تعب النجيع ولا تسأمُ",16,"م",1,0],["وإنْ أدنُ منكمْ لا أكنْ ذا تميمة ٍ","فَما ظَنُّكُمْ باللّيثِ يَحمي عَرِينَهُ،",17,"ه",1,0],["وَإِنَّ أَديمَ الأَرضِ لا شَكَّ واحِدٌ","وَما يَستَوي فيها الشَواهِقُ وَالوَهدُ",18,"د",1,0],["وأنادي والقلب ذاب وجفّ ال","كاسُ أين الطلا وأين غلامي",19,"م",2,0],["وَإِن أَدعُ يَوماً في قُضاعَةَ تَأتِني","شَآبيبُ بَحرٍ ذي غَوارِبَ مُزبِدِ",20,"د",1,0],["وأنادي النفس طيبي واشطحي","وانزلي هذي أمانيك هنا",21,"ن",2,0],["وإِن اِدَّعيتَ خلوَّ قلبك في الهَوى","فمن اِبتَلاهُ بوجدِه وحنينِهِ",22,"ن",2,0],["وأناديه يا نديمَ الحضارا","ت سلاما كحُبّنا مشبوبا",23,"ب",2,0],["وإنِ ادَّعَى قِدَمَ الوَلاءِ فما","للوغْدِ لا قِدَمٌ ولا قَدَم",24,"م",1,0],["وإن أدير نظمه في موقف","قلت نجومٌ سُبِكَتْ في عِقْدِ",25,"د",1,0],["وإنِ ادَّعى خوفَ الوُشاةِ فَما الهَوَى","للخَوفِ مُذْ خُلِقَ الهَوى بمُلاَئمِ",26,"م",1,0],["وانآدَ دَوْحُ اللَّهْوِ من","حَمْلِ ثمارِ الجَذَلِ",27,"ل",1,0],["وانأدن أضراسي وسمعي ومنظري","تناقصن بالأضعاف عن عادها العاد",28,"د",1,0],["وأن أدرك العلياءَ شخصاً مصوَّراً","هناك وألقى العزَّ جسماً محدَّدا",29,"د",2,0],["وإن أدبتني الدهريات فأبطنت","معارفنا قالوا من الفتح عاريا",30,"ي",2,0],["وَإِن أَدبَرَت قُلتَ مَشحونَةٌ","أَطاعَ لَها الريحُ قِلعاً جَفولا",31,"ل",2,0],["وأناديه من فؤادٍ وجيعٍ","وجميعي بلوعتي مشمولُ",32,"ل",1,0],["وأن أُدلي إلى طَمِعٍ بِذل","ومَنقَصَةٍ تكونُ عليَّ عارا",33,"ر",2,0],["وإِن أَدركت بالطف وترك هاشم","فَلا المجد منحط ولا الأَنف اجدع",34,"ع",1,0],["وَأُنادي يا لَقَومي سارِعوا","لاقتباس النُور مِن شَمس النَهار",35,"ر",1,0],["وأنادي أيا جفوني وقلبي","لو أنالوا لم يَجر دمعيَ نيلا",36,"ل",2,0],["وإن أدبرتْ أكفالها تبتغي النجا","فلا حملتْ منها النفوس القوائم",37,"م",1,0],["وإن أديرت كؤوسُ الموت مُتْرَعَةً","يستعذبوها كأن الموت حاناتُ",38,"ت",1,0],["وَأَن أَدعُ عَبدَ القَيسِ أَدعُ قَبِيلَةً","مُلَبِّيَةً في الرَّوعِ بِالدَّعواتِ",39,"ت",1,0],["وَإِن أَدعُ عَمراً أَلقَ كُلَّ كَتِيبَةٍ","مُحَرَّمَةٍ مَمنُوعَةِ الجَنَباتِ",39,"ت",1,0],["وأنادي بالله لا تخرجوه","إن فعلتم الأعلى حمالِ",40,"ل",1,0],["وأنادي بأرفع الصوت حسبي","أن أراني لقبر عبدك جارا",41,"ر",2,0],["وأن أدل واحد بباسه","في شعره وعدة من ناسه",42,"ه",1,0],["وأنا دخيل جنابه ودخيل آ","ل جنابه من قد حبوا بهباته",43,"ت",2,0],["وَأُناديكَ عَزيزاً","وَتُناديني ذَليلا",44,"ل",2,0],["وإن أدع لا شيئاً هناك فاتني","بذاك لقد أصبحت في الناس مغرما",45,"م",2,0],["وإن ادعتي بأن هذا المنع في ال","دنيا وبالأخرى حقوق موقفه",46,"ف",2,0],["وأنادي يا بنت خير النبيي","ن ويا أم أكرم الفتيان",47,"ن",1,0],["وإن أدعُ قومي إلى الانقسام","أجابوا ندائي سيلاً رُكاما",48,"م",2,0],["وإن ادعى جهلاً وقال حسبته","حلا كحلِّ الحيض والسفر",49,"ر",1,0],["وَإِن أَدَعُهُ لِلنِّصفِ يابَ وَيَعصِني","وَيَدعو لِحُكمٍ جائِرٍ عَصرُهُ الحُكمُ",50,"م",1,0],["وأن ادع في عليا هوازن تاتني","قبائل أزكى حين تنمي واحسب",51,"ب",1,0],["وَإِن أُدعُ في القَيسِيَّةِ الشُمِّ يَأتِني","قَرومٌ تَسامى كُلُّهُم باذِخُ القَدرِ",52,"ر",1,0],["وأنادى مِن حُزنِىِ بعينٍ تَدمَعُ","يا مَن يرِى ما فى الضَميرِ ويَسمَعُ",53,"ع",1,0],["وأنادي مغربِيّا ليتني","لم أكن للغرب يوما أنسَبُ",54,"ب",1,0],["وأنا دمعي ينهل","ل على رجع أنيني",55,"ي",1,0],["وأُنادي وَقَدْ سَئِمتُ منَ الرَّك","ضِ تُرى أَينَ مُنْتَهى مِضْمارِي",56,"ر",2,0],["وانا دخلنا قصور الجنان","وقد ضمنا في بهاه الخلود",57,"د",1,0],["وإن أدبرتْ سلبتْ محاسن نفسه","وكُسى شروراً عن ملابس خيرهِ",58,"ه",1,0],["وأنادي يا أيها الناس قولوا","هل رأيتم شيئاً يُسمى الوفاء",59,"ا",2,0],["وَإِنَّ أَدنى الَّذي عِندي مُسامَحَةٌ","في حاجَتي بَعدَ أَن أَعذَرتَ في الطَلَبِ",60,"ب",1,0],["وان أدلج الساري المجد بجسرة","زفوف أمون تترك الجو ألهبا",61,"ب",2,0],["وأنادمُ الجبارَ لا أرضى بهِ","إلا إذا كانَ اللبابَ المُرتَضى",62,"ض",2,0],["وأنا دعي في البلاغة ملصق","في الشعر منسلخ عن الآداب",63,"ب",1,0],["وَأُناديك مرّةً بعد أُخرى","ثُمّ لَم أَسل أَو تُجيب النِداءَ",64,"ا",2,0],["وإن ادلهم الخطب كنت حكيمها","وضميرها، ولسانها، المتكلما",65,"م",2,0],["وَإنا دَوحتَا جَنات مجدٍ","لَنا مِن رُوحها ظلٌّ ظَليل",66,"ل",1,0],["وأناديك كلما روَّعتني","جَفَلاتٌ من ظلمه في القضاء",67,"ا",2,0],["وَإِن أَدعُ الأَجارِبَ يُنجِدوني","بِجَمعٍ لا يُهَدُّ مِن الصِياحِ",68,"ح",1,0],["وَإِن أَدع شَخصاً باِسمه لِضرورةٍ","فَإِن اِسمك المَحبوب للنطق سابقُ",69,"ق",1,0],["وَإِن أَدرَكوا في الحبّ نُقطة بائه","فَبِالحاءُ وَالباء اِرتَقَيتُ اِرتِقائِيا",70,"ا",3,0],["وانا دخلت ولاحسبت الفقايد","اما النصر ولا النعي بالجريده",71,"د",2,0],["واناديلك وانا بآخر ليالي بآخر الأوطان","أصارع غربتي بين الخفوق وعزة مكابر",72,"ر",1,0],["وأن ادع لا شيئا هناك فأنني","بذاك لقد أصبحت في الناس مغرما",73,"م",2,0],["وأنادي العزم في تأريخكم","( قاحم الأعدا تفز بالظفر )",74,"ر",1,0],["وأناديه وهو عني بعيد","وأناجيه وهو في أجفاني",75,"ن",2,0],["وأنادى الحبيب وهو أمامي","وورائي مخاوفي ولغوبي",76,"ب",2,0],["وأنادي سِرب السلام حماما","وهو خاو ٍيئنّ بين النيوب",76,"ب",1,0],["وأناديها فتدنو","تارة مني وتبعد",77,"د",1,0],["وَإنْ أُدرِجَتْ فِي مَدرَجِ الكَشفِ رُوحُهُ","رَأَى فِي مَرائي الكَشفِ نُورًا بِهِ يُسْبَى",78,"ب",2,0],["وإن ادعى زورا وإن طلبت","منه الحقوق أشاح واحتجبا",79,"ب",2,0],["وأنادي الأطفال في ساحةِ الهول","أيا أيها الصغارُ \"الكبارُ\"",80,"ر",1,0],["وأنادي طرفي تمتعلدي القرب","بدار قضيت عنها مليا",81,"ي",2,0],["وإنْ أديتُ طولَ العمرِ دَيني","سأبقى عندكمْ دومًا مدينا",82,"ن",2,0],["وإن أدْرَكْتُ آخرَها","تحرَّرَتِ البداياتُ",83,"ت",1,0],["وأناديك من قريب على البعْ","د كأني أبثُّ نجوى الكليمِ",84,"م",1,0],["وانا دعائيَ- مثل مَن","قد مسَّهُ شرٌّ- عريضُ",85,"ض",1,0],["وأنادي أيها الشعب لقد","قاوم الأبطالُ فلتمضوا قياما",86,"م",2,0],["وإنْ أدْمَتْ لَنَا لَيْلَى جَرُوْحَاً","وكَمْ نَلْقَى جَرُوْحَاً مُذْعَنِيْنَا",87,"ن",2,0],["وأنادي أنني أحيا بهِ","وفؤادي عازف لحن الوترْ",88,"ر",1,0],["وأنادي : يا \" مصرُ \" أدري لماذا","جئتُ وحدي وأرحلُ الآنَ وحدي",89,"د",2,0]]}