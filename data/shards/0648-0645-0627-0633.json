مرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[554,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[554,"أشيبا ولما تمض خمسون حجة","https://www.aldiwan.net/poem47216.html","الطويل"],[554,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[554,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[554,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[554,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[561,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[561,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[565,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"],[567,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[570,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[576,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[576,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[576,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[578,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[578,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[588,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67403","الطويل"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17779","الوافر"],[1107,"","https://poetry.dctabudhabi.ae/diwan/poem/28247","الطويل"]],"verses":[["وَما سَرَّني أَنّي أُقيمُ عَلى الأَذى","وَأَنّي بِدارِ الهونِ بَعضُ الخَلائِفِ",0,"ف",1,0],["وَما سَعى والِدٌ مِنّا لِمَكْرُمَةٍ","لَمْ تَحْتَضِنْ مِثْلَها المَسْعَاةُ مِنْ وَلَدِ",1,"د",1,0],["وما سَرى البَرْقُ والظّلْماءُ عاكِفَةٌ","إلا وفي القَلْبِ منْ نِيرانِهِ شَرَرُ",2,"ر",1,0],["وَما سُمتُ نَفسي الصَبرَ عَمَّن أُحِبُّهُ","وَلا خُنتُهُ فيمَن أَراه يُخانُ",3,"ن",1,0],["وَما ساءَني إِلا كِتابٌ كَتَبتُهُ","فَلَيتَ يَميني بَعدَ ذَلِكَ شَلَّتِ",4,"ت",1,0],["وَما سَجَعَت وَرقاءُ تَهتُفُ بِالضُحى","تُصَعِّدُ في أَفنانِها وَتُصَوِّبُ",5,"ب",1,1],["وَما ساسَ أَمرَ الناسِ إِلّا مُجَرِّبٌ","حَليمٌ وَلا صافَيتَ مِثلَ كَريمِ",6,"م",1,1],["وَما سابِقٌ إِلّا بِساقٍ سَليمَةٍ","وَما باطِشٌ إِن لَم تُعِنهُ الأَنامِلُ",7,"ل",1,0],["وَما سُعادُ غَداةَ البَينِ إِذ رَحَلوا","إِلّا أَغَنُّ غَضيضُ الطَرفِ مَكحولُ",8,"ل",1,0],["وَما ساءَت ظُنونُكَ يَومَ تولي","بِأَرماحٍ وَفَى لَكَ مُشرِعوها",9,"و",3,0],["وَما سُقتَ مِن عادِ البِلادِ وَأَهلِها","وَما قُلتَ في أَهرامِ خوفو وَخَفرَعِ",10,"ع",1,0],["وَما ساءَ ظَنِّيَ في أَن يُسيءَ","بِيَ الفِعلَ حُسنُكِ حَتّى فَعَل",11,"ل",1,0],["وَما سالَ وادٍ مِن تِهامَةَ طيبٌ","بِهِ قُلبٌ عادِيَّةٌ وَكِرارُ",12,"ر",1,0],["وَما سَجَعَت مِن بَطنِ وادٍ حَمامَةٌ","يُجاوِبُها صاتُ العَشِيِّ طَرُوبُ",13,"ب",1,0],["وَما سُؤالي ذاكَ إِلّا لِكَي","يُسقاهُ هامٍ بِالرَوي في القِفار",14,"ر",1,0],["وما سبيل إلى أدنى الوفاء بما","لكل مبتدرٍ وافى ليكرمني",15,"ن",2,0],["وَمَا سَبِيلِي إلى أدْنَى الوَفَاءِ بِمَا","لِكُلِّ مُبتَدِرٍ وَافَى لِيُكَرمُنِي",16,"ن",2,0],["وما سكت الأحرار عن مخزياتكم","فكم أبرقُوا غيظاً عليكم وأرعدوا",17,"د",3,0],["وما سادت شعوب الخلق إلاّ","بتهيئة البنين لذا الصراع",18,"ع",1,0],["وما سرّه من دولة العجم رتبة","ولا غره من دولة العُرب منصب",19,"ب",1,0],["وَما سَيرُ شَهرٍ كُلِّفَتهُ رِكابُنا","وَلَكِنَّهُ شَهرٌ وَصَلنَ بِهِ شَهرا",20,"ر",2,0],["وما سمَّوا بأبرهة اغتباطاً","بشر ختونة متزينينا",21,"ن",2,0],["وَمَا سَمَّوا بِاَبرَهةَ اغتِبَاطاً","بِشَينِ خُتُونَةٍ مُتَزيِنِينَا",22,"ن",2,0],["وما سَمَّي بِقَتلِ أَبِيهِ مِنَّا","قَتِيلاً في عضَايِهِ مُفتَرِينَا",22,"ن",2,0],["وَما ساءَني أَنّي مَكانَكَ عانِياً","وَأُسلِمُ نَفسي لِلإِسارِ وَتَسلَمُ",23,"م",1,0],["وَما سَفَرَت عَن رَيِّقِ الحُسنِ إِنَّما","نَمَمنَ عَلى ما تَحتَهُنَّ المَعاجِرُ",24,"ر",1,0],["وما سميَ الغيثُ الهتونُ سحابة","سوَى أنهُ من خجلةٍ يتسحّب",25,"ب",1,0],["وماست السمر بالإعجاب وابتسمت","بيض السيوف وقرّت أعين الزّرد",26,"د",1,0],["وما سرق القول فيه الثنا","فحاشاه من قطع تلكَ الأيادِي",27,"د",2,0],["وما سمّاك هذا الاسم إلا","وليٌّ عارفٌ سر الأسامي",28,"م",2,0],["وما سُرَّ قلبي مُذ شَطت بك النوى","أنيسٌ ولا كأسٌ ولا مُتَصَرَّفُ",29,"ف",1,1],["وما سيْبُ الأميرِ بسيلِ وادٍ","يقصِّر أن ينَال ذرا الروابي",30,"ب",2,0],["وما سكتُّ اعترافاً بالحديث لهُ","لكن كظمتُ وبي من حرّهٍ لَهثُ",31,"ث",1,0],["وما سرني أن بعْتُهُ بثَوابِه","ولو أنه التَّخْليدُ في جنَّةِ الخُلْدِ",32,"د",1,0],["وما سرَّ عيدانَ الأراك برِيقها","تَناوُحها في أيكها تتهصَّرُ",33,"ر",1,0],["وما سَيّر الهاجون في الشعر خزيةً","لعمرُك إلا كان في النثر أسْيرا",34,"ر",2,1],["وما ساءني فوت ما فاتني","وإن كان كالعضو مني نُزِع",35,"ع",1,0],["وما سدّ قولٌ في فعالك خَلَّةً","ولا وَجَدَ المدّاحُ نقصاً فتمَّمُوا",36,"م",3,0],["وما سدَّ قولٌ في فعالك خلةً","ولا وجد المدَّاحُ نقصاً يتمَّمُ",37,"م",1,1],["وما سَخَطِي على من جاءَ يَجرِي","إليَّ وغبطتي فَرَسَيْ رِهان",38,"ن",1,0],["وما سُنَّةُ الشيطانِ سَنَّت بِبَذْلها","فواضِلَها بل سُنَّةُ الله سنَّتِ",39,"ت",1,0],["وَما سَعى مِنهُمُ ساعٍ لِيُدرِكَنا","إِلّا تَقاصَرَ عَنّا وَهوَ مُنبَهِرُ",40,"ر",1,0],["وَما سَبَقَ الغاياتِ إِلّا جِيادُها","وَما تَستَطيعُ الجِلَّةَ البَكَراتُ",41,"ت",1,0],["وَما سَرَت نَسَماتٌ نَحوَها سَحَراً","إِلّا وَدِدتُ لَو أَنّي كُنتُ في النَسَمِ",42,"م",1,0],["وَما سَأَلتُ اِمرَأً فيما تُفَجِّعُهُ","إِلّا وَجاوَبَ إِنّي مِن مُحِبّيهِ",43,"ي",2,0],["وَما سَرَّني أَنَّ المَلاهِيَ كَثيرَةٌ","وَفي الشَرقِ قَومٌ يَجهَلونَ المَلاهِيا",44,"ي",2,0],["وَما سَرَّني غَيرُ الَّذي كانَ مِنهُمُ","وَمِنّي وَقَد جاؤوا إِلَيَّ وَأَوجَفوا",45,"ف",3,0],["وما سفري إن متُّ ينأَى وإنما","إلى بطنها من ظهرها اتنقل",46,"ل",1,0],["وما سلمت عليها قبل هذا","من الأرزاء حتى الأنبياء",47,"ا",2,0],["وما سألوا بنيك ولا بنينا","ولا ألتفتوا إلى القوم الغضاب",48,"ب",1,0],["وَما سَعدٌ بِمُتَّجِرٍ إِذاما","تَعَرَّضَتِ الحُقوقُ شَرى وَباعا",49,"ع",2,0],["وَما سَلِمَ الوَليدُ مِنِ اِشتِكاءٍ","فَهَل يَخلو المُعَمَّرُ مِن أَذاةِ",50,"ه",1,0],["وَما سارَت سِوى يَومَي زَمانٍ","فَأَهلاً بِالغُزاةِ الفاتِحينا",51,"ا",1,0],["وَما سَكَبَ الميزابُ ماءً وَإِنَّما","أَفاضَ عَلَيكَ الأَجرَ وَالرَحَماتِ",52,"ت",1,0],["وَما سَلَّمتُ فَوقَكَ لِلثُرَيّا","وَلا سَلَّمتُ فَوقَكَ لِلسَماءِ",53,"ا",2,0],["وَما سَكَني سِوى قَتلِ الأَعادي","فَهَل مِن زَورَةٍ تَشفي القُلوبا",54,"ب",2,0],["وَما سَمِعتُ وَلا غَيري بِمُقتَدِرٍ","أَذَبَّ مِنكَ لِزورِ القَولِ عَن رَجُلِ",55,"ل",1,0],["وما سوَّغَتْنَا ليلةَ الوَصْلِ قرضَها","إِلى أنْ بدَا الإِصباحُ يرتجِعُ القرضَا",56,"ض",2,0],["وما سبقتْ منِّي إليهم اساءَةٌ","ولكنّهمْ مالُوا عليَّ مع الدهرِ",57,"ر",1,0],["وما ساقَني فقرٌ إليكَ وإنَّما","أبَى لي عزوفُ النفسِ أن أعرِفَ الفقرا",58,"ر",2,0],["وَما سَوَّدَ الأَقوامُ مِثلَ عُمارَةٍ","إِذا نُسِيَ الأَقوامُ شاعَ لَهُ ذِكرُ",59,"ر",1,0],["وَما ساءَني أَنَّهُم أَصبَحوا","مِنَ الخِزيِ في دارِ شَرٍّ وَعَر",60,"ر",1,0],["وَما سَواءٌ إِذا التَقَينا","سَهلٌ عَلى خُلَّةٍ وَوَعرُ",61,"ر",1,0],["وَما سُمِعَت قَبلَها مِثلُها","وَقَد راعَهُم صَوتُها رائِعَه",62,"ع",2,0],["وَما سُعِدَت بِسُعدى النَفسِ حَتّى","شَجاها البَينُ فيها بِاِحتِراقِ",63,"ق",1,0],["وَما ساعَةٌ مِن جاهِهِ دونَ جودِهِ","بِمُبعِدَةٍ مِن أَن يُنالَ جَزيلُ",64,"ل",1,0],["وَما سَرَّني أَنَّ قَلبي أُعي","رَ عَزاءَ القُلوبِ وَسُلوانَها",65,"ن",3,0],["وَما سالَ في وادٍ كَأَودِيَةٍ لَهُ","دَفَعنَ مَعاً في بَحرِهِ حينَ أَزبَدا",66,"د",2,1],["وَما ساقَها مِن حاجَةٍ أَجحَفَت بِها","إِلَيكَ وَما مِن قِلَّةٍ في مُجاشِعِ",67,"ع",1,0],["وَما سَجَنوني غَيرَ أَنّي اِبنُ غالِبٍ","وَأَنّي مِنَ الأَثرَينِ غَيرِ الزَعانِفِ",68,"ف",1,0],["وَما سَكَنَت عَنّي نَوارٌ فَلَم تَقُل","عَلامَ اِبنُ لَيلى وَهيَ غُبرٌ عِيالُها",69,"ل",3,0],["وَما سَيَّرَت جاراً لَها مِن مَخافَةٍ","إِذا حَلَّ مِن بَكرٍ رُؤوسَ الغَلاصِمِ",70,"م",1,0],["وما سَتَرَ الكِتْمانُ عندي صَنيعَةً","ولا أفسدَ النَّعماءَ فيَّ جُحودُها",71,"د",3,0],["وَما سِيّانِ مَن هُوَ في جَحيمٍ","يَكونُ شَرابُهُ فيها صَديدا",72,"د",2,0],["وَما سِيّانِ ذو خُبرٍ بَصيرٌ","وَآخَرُ جاهِلٌ لَيسا سَواءَ",73,"ا",2,0],["وَما ساوَرَتكَ سِوى ساعَةٍ","فَما كُنتَ أَهلاً لِأَسبابِها",74,"ب",3,0],["وما سُلَّ لِلضَّرْبِ إلّا أسالَ","عَلى خَدِّهِ أَدمعَ المقتلِ",75,"ل",1,0],["وما سفاقسُ إلا بَلْدَةٌ بعثَتْ","إليك عنها لسانَ الصدق تعتذرُ",76,"ر",1,0],["وما سَدَدتَ سَبيلي عن لِقائِهِمُ","لَكِنْ جَعَلتَ صِفادي عنهُمُ الصّفَدا",77,"د",2,0],["وَما سافَرتُ في الآفاقِ إِلّا","وَمِن جَدواكَ راحِلَتي وَزادي",78,"د",2,0],["وما سمرُ القدودِ وإنْ سبتنا","أحبُّ إليهِ منْ سمرِ الرماحِ",79,"ح",1,0],["وما سواكم بكفءٍ في الأنامِ لكمْ","والليثُ أفتكُ أفعالاً منَ النمرِ",80,"ر",1,0],["وَما سَلَكَ الموماةَ مِن كُلِّ حَسرَةٍ","طَليحٍ كَجَفنِ السَيفِ تَهوي فَتُركَبُ",81,"ب",1,0],["وما سارَ في الأرض العريضَةِ ذكرُهُ","ولكنّهُ في مسلَكِ الشمسِ سالِك",82,"ك",1,0],["وما سَرّني تأمِيلُ غيرِ خليفَةٍ","وأنّيَ للأرضِ العَريضَةِ مالك",82,"ك",1,0],["وما سُدّدَ الأملاكُ من قبل جعفَرٍ","ولا أنكرُوا نُكراً ولا عرفوا عُرفا",83,"ف",2,0],["وما سرّهم ما ساءَ أبناءَ قَيصرٍ","وتلك تِراتٌ لم تزَلْ وحُقود",84,"د",1,0],["وَما سَرَّني أَنّي أَكونُ بِحالَةٍ","لِمِثلِكَ في الدُنيا عَلَيَّ سَبيلُ",85,"ل",1,0],["وَما سُمتُها هوناً فَتَأبى قَبولَهُ","وَلَكِنَّما طالَ الصَفاءُ فَمَلَّتِ",86,"ت",1,0],["وَما سَرَّني أَنّي أَصَبتُ مَعاشِراً","بِظُلمٍ وَأَنّي في النَعيمِ مُخَلَّدِ",87,"د",1,0],["وَما سُمُّ الحُبابِ لَدَيَّ إِلّا","كَنَظمٍ قيلَ في آلِ الحَبابِ",88,"ب",1,0],["وَما سَمَحَت لِيَعرُبِها اللَيالي","وَحَيِّ نِزارِها إِلّا بَنزَرِ",89,"ر",1,0],["وَما سَرَّني أَنَّني في الحَياةِ","وَإِن بانَ لي شَرَفٌ وَاِنتَشَر",90,"ر",1,0],["وَما سَرَّني أَنّي اِبنُ ساسانَ أَغتَدي","عَلى المَلِكِ في الإيوانِ أُصبِحُ أَو أُمسي",91,"س",2,0],["وَما سَلُّ المُهَنَّدِ لِلتَوَقّي","كَسَلِّ المَشرِفيَّةِ لِلتَشَفّي",92,"ف",2,0],["وَما سَرَّني رَبُّ الخَيالِ بِشَخصِهِ","فَيَطلُبُ مِنّي النَومُ طَيفَ خَيالِ",93,"ل",1,0],["وَما سَمَحَت لَنا الدُنيا بِشَيءٍ","سِوى تَعليلِ نَفسٍ بِالمُحالِ",94,"ل",1,0],["وَما سالَمَ الحَيَّ القَضاءُ وَإِنَّما","إِلى الحَتفِ يَرقى وَالسَلامَةُ سُلَّمُ",95,"م",1,0],["وَما سَفَتِ الريحُ الرَغامَ جَهالَةً","وَلا رَكَدَت قُدسٌ وَأَترابُها حِلما",96,"م",2,0],["وَما سَمَحَت لّزائِراتِ بِأَمنِها","وَلا لِلمَواكي 