ّيه \"",122,"ي",2,0],["وَما ساقَها من حاجَةٍ أجْحَفَتْ بهَا","إلَيْكَ، وَلا مِنْ قِلّةٍ في مُجاشِعِ",123,"ع",1,0],["وما سُنة ُ الشيطانِ سَنَّت بِبَذْلها","فواصِلَها بل سُنهُ الله سنَّتِ",124,"ت",1,0],["وما سألوا بينك ولا بنينا","ولا ألتفتوا إلى القوم الغضاب",125,"ب",1,0],["وَما سَمَعوا صَليل ظِباك إِلّا","تَصافَحَت النَواصي وَالصَعيد",126,"د",1,0],["وماس فقيل صار الرمح قدا","ولاح فقيل صار البدر جسما",127,"م",2,0],["وماس مع الدلال فهز رمحا","ورش بلطف رمشته نبالا",128,"ل",2,0],["وما سلوا ذكر من هاموا بهم ولها","ان المحب لعمري ليس بالسال",129,"ل",1,0],["وماس بالسعد من بعد الشقاء ربه","اخو انقطاع وقد ضاقت به هيت",130,"ت",1,0],["وما سِواهُ فُحُولُ الشِّعرِ تُنْكِرُهُ","ويَتَّقِي شَرَّهُ الإنسانُ والجانُ",131,"ن",1,0],["وما سار ركبٌ نحو مكةَ مسرعاً","وما انصبَّ هطَّالٌ وما هبَّ طارِقُ",132,"ق",1,0],["وَما سَمِعتُ بِصَقرٍ ظَلَّ يَرصُدُهُ","مِن قَبلِ هَذا بِجَنبِ المَرجِ مِن خَرَبِ",133,"ب",1,0],["وماس يختالُ عجبْاً في محاسنهِ","حتى كسانيَ ثوب التيهِ والخجلِ",134,"ل",1,0],["وما ستَرتْ عيوبَك عن عيونٍ","بَصيراتٍ يداك ببذلِ مالِ",135,"ل",1,0],["وما سلكتُ فجِاج الحبِّ معتزما","حتى ضمِنتُ ولو بالنفس إسعادي",136,"د",2,0],["وما سلبَ الشتاءُ الأرضَ إلا","تسربلنَ المحامدَ فاكتسَينا",137,"ن",2,0],["وَما سَبَقوا الحِمامَ هُناكَ إِلّا","كَما سَبَقَ الحَمامُ السَوذَنيقا",138,"ق",2,0],["وَما سَمعي إِلى العُذّالِ مُصغٍ","وَلا قَلبي عَنِ الأَحبابِ ذاهِل",139,"ل",1,0],["وَما سَلَّ الكَهامَ عَلى عِداهُ","غَداةَ الرَوعِ مَن وَجَدَ الحُساما",140,"م",2,0],["وَمَأْسُورَةِ الأَجفانِ عَنْ سِنَةِ الكَرى","وَلكِنَّها في حَلْبَةِ الدَّمْعِ تُطْلَقُ",141,"ق",1,0],["وَمَأْسورةِ الأَلْحاظِ عن سِنة الكرى","كَأَنَّ عَلَيها الصبرَ ضربةُ لازِبِ",142,"ب",1,0],["وما سرني نفيانها ليزيدني","يقينا فان الأمر أوضح ان يجلى",143,"ل",2,0],["وما سِوى التّربِ نَعلُ رِجلي","ولا سِوى الشّعرِ تاجُ راسي",144,"س",2,0],["وما سكنت إلى بغداد مفتتحا","باب المعيشة عن جهل ولا موق",145,"ق",1,0],["وما سرّهم من غيرهم سرّ غيرهم","بهم ولهم والدائرات دوائر",146,"ر",1,0],["وَما سيّدٌ حقّاً سوى اللَّه إنّه","لهُ الحكمُ في الدُنيا لهُ الحكم في الأخرى",147,"ر",2,0],["وَما ساءَني إِغواؤهم لمعاشرٍ","منَ الناسِ ضلّوا أبدلوا كفرَهم كفرا",148,"ر",2,0],["وما سجيريَ فيها غيرُ مُنْصَلِتٍ","عَضْبِ السِّطامِ وبحرُ الليل مسجور",149,"ر",1,0],["وما سميَّ الروضُ باسمِ الجنان","لو لم يكن بعضَ ولدانها",150,"ن",3,0],["وما سيانَ في طمعٍ وحرصٍ","إذا ما الكلبُ أشبههُ الذئابُ",151,"ب",1,0],["وما سلَّط اللَهُ نبتَ اللِّحى","على المُرد إلا زوال النِّعمْ",152,"م",1,0],["وماس يسحب اذيال الشباب وقد","تضوع الروض من انفاسه العطره",153,"ر",2,0],["وماس وكنت جريح الاسى","فمال وقلبي طعين الأسل",154,"ل",1,0],["وما سلّمت مذ حرّمت وصلي","فكيف تحرم النظر المباحا",155,"ح",2,0],["وَما سَرى في مَقاصيرِ اللَظى خبرُ","حارَ اللَهيبُ بِهِ وَاِستَسأَلَت سقرُ",156,"ر",1,1],["وماسَتْ على الكُثْبان قضبانُ فِضَّة","وأثقلْنَهَا من حملهنَّ نُهُود",157,"د",1,0],["وماس من كل غصن منك من طرب","عطف وتهت دلالاً في تهاديك",158,"ك",1,0],["وَما سَرى بَرقٌ وَما","مالَ بِغِرّيدٍ فَنَن",159,"ن",1,0],["وَما سَرى تَحتَ الدُجى","وَميضُ بَرقٍ يَخطِفُ",160,"ف",1,0],["وَما سَعى بِالفِراقِ ساعٍ","وَلا أَذاعَ الهَوى مُذيعُ",161,"ع",1,0],["وما سمعت أذاني قبلك فاتحاً","يفيض على الأعداء خيراً ويسكب",162,"ب",1,0],["وماسَ فاشتاقت غصونُ البان أن","تَنقُل ذاك اللِّينَ عن قَوَامهِ",163,"م",2,0],["وَما سَألوكَ عَقد الصُلح ودّاً","وَلَكِن تَحتَ غاباتِ الرِماحِ",164,"ح",1,0],["وما ساءَني إِلا هُيامي بقَينةٍ","تُحاوِلُ أن تحكي الذي أنا حاك",165,"ك",1,0],["وما سَهري لجملٍ أو لنعمٍ","ولا شَغفي بحسنٍ زينبي",166,"ي",1,0],["وَما سجعت ورق الحَمائم في الجمى","وغرد قَمَري لتغريد بلل",167,"ل",1,0],["وما سحّت يَداهُ نَداه إلا","تَبَيّن في الحَيا مِنْهُ الحَياء",168,"ا",2,0],["وَما سارَ سيرَتَهُ قَبلَهُ","سِوى العُمَرَينِ بِحُسنِ الشِّيَم",169,"م",1,0],["وَماسَ بِالرِدفِ ثَقيلاً وَبِال","خصرِ دَقيقاً تَحتَ بَطنٍ خَميص",170,"ص",1,0],["وَما سَمِعنا مِثلَ راياتِهِ","بِجُلَّنارٍ كانَ نَيلوفَرا",171,"ر",2,0],["وَماسَ فقال الرمحُ تلك مَعاطِفي","مَتى أَزهرت فوقَ الرِماح الشَقائقُ",172,"ق",1,0],["وما سرى البرق بنجد الحمى","ونمنم الرعد ودر الغمام",173,"م",1,0],["وما سرت من حيكم نسمة","تذكر الصب حديث الغرام",173,"م",1,0],["وَما سوسُ ملكٍ في التمدّن واغلٌ","كَملكٍ تخطّاه الرفاهُ وجمّهُ",174,"م",2,0],["وَما سَبَقَت مِن جاهِلٍ قَطُّ نِعمَةٌ","إِلى أَحَدٍ إِلّا أَضَرَّ بِها الجَهلُ",175,"ل",1,0],["وَمَا سَرْدُ داودَ مِنى يَقيِكَ","وَأَنتَ بِأَسهُمِ لَحظي رَشِيقُ",176,"ق",1,0],["وَما ساءَ قَلبي وَهوَ حَيٌّ بِقُربِكُم","تَرَحُّلُ جِسمي عَنكُم وَهوَ مَيِّتُ",177,"ت",1,0],["وَما ساءَني جَهلُ العَمِيِّ بِرُتبَتي","وَمَشهَدَ أَربابِ البَصائِرَ مَشهَدي",178,"ي",1,1],["وَماس في حللٍ خُضر فَذكّرني","خُضر الرُبوع زَهَت بِالسَيّد الخضري",179,"ر",2,0],["وَما سَبَب الإِعراض عَنّي أَهكَذا","يَكون جَزا هَذا المُحبّ عَلى الحُبِّ",180,"ب",1,0],["وما سَيّارةُ الأفْلاكِ إلاّ","حَواسِدُها المُسِرّاتُ الضَّغائن",181,"ن",1,0],["وما ساءني مِن أخْذِه وعطائهِ","وما بَيْنَ أن أفنَى حميداً وأن أَقْنى",182,"ن",2,0],["وما سِرْتُ إلاّ في الهَواجرِ وحْدَها","كراهةَ ظلّي أنْ يكونَ قَريني",183,"ن",2,0],["وما سمَتِ السّماءُ بحيثُ تَرضَى","لخَيْلِك من أَهِلَّتِها نِعالا",184,"ل",2,0],["وَما سَلَفَت لي قَطُّ في الحُبِّ غِبطَةٌ","فَتُعجِبَني فيها اللَيالي السَوالِفُ",185,"ف",1,0],["وَما سَمِعَت أُذنايَ قَبلَ لِقائِها","بِحَلْي عَلى حَلْيٍ وَدُرٍّ عَلى دُرِّ",186,"ر",1,0],["وَما سَلسَلَت مِن مُذابِ السُرورِ","وَما خَفَّضَت مِن جِماحِ التَقالي",187,"ل",2,0],["وَما سَكَنَت رِماحُكَ مِن طِعاني","وَلا جَفَّت سُيوفُكَ مِن جِراحي",188,"ي",1,0],["وما سرَّ قَلبي أن يُعافى مِن الهَوى","وأنِّي بِلا حبٍّ يَتمُّ سرورُ",189,"ر",1,0],["وما سَرحَت بالقول فيك قصيدةٌ","يسوق إليك السامعينَ نشيدُها",190,"د",3,0],["وماست السُّمرُ وافترَّتْ لذاك ثغور","البيض وارتعَدَتْ منه الفراعين",191,"ن",1,0],["وما سد عنك الباب كلا وإنما","آتاك اختياراً وهو أعظم حجة",192,"ه",1,0],["وَما سُقمُ جفنيها بِضائِرِ طرفها","إِذا صَحَّ غرب السَيف فالجفن يَعطُبُ",193,"ب",1,0],["وما سَخِطتُ بِعادي إذْ رضيتَ بِه","ولا لجُرحٍ إذا أرضاكُمُ أَلَمُ",194,"م",1,0],["وما سَاءَني أن أحالَ الزّمانُ","لَيلي نهاراً وجَهلي وقَارَا",195,"ر",2,0],["وما سَلِمْتَ فذنبُ الدَّهرِ مُغْتَفَرٌ","وصرْفُهُ ما جَنى جُرماً ولا اجْتَرَحَا",196,"ح",2,0],["وما سَخِطتُ بِعادِي إذ رضِيتَ به","وما لِجُرحٍ إذا أرضاكُمُ أَلَمُ",197,"م",1,0],["وما ساءَنِي أنّي لبعدِكَ جَازِعٌ","لأنّ جميلَ الصّبرِ عنكَ عُقوقُ",198,"ق",1,0],["وما سَكنتْ نَفْسِي إلى الصّبرِ عنكُم","ولا رَضِيَتْ بُعدَ الدِّيارِ من القُرْبِ",199,"ب",1,1],["وما سرَّني أنِّي مقيمٌ ببلدةٍ","وهمِّي عليكم في المهامِهِ جَوَّال",200,"ل",1,0],["وما ساءني فَقَرٌ ولا سرّني غنًى","بحيثُ استوى عندي ثراءٌ وإقلال",200,"ل",1,0],["وما سادَ في قومٍ حقودٍ عليهم","ولا حيزت النعماء يوماً لحاسد",201,"د",1,0],["وما سُمِعت منكم قديماً وحادثاً","رواية من يروي الحديث تَوَهُّما",202,"م",2,0],["وما سبق الوالي المنيب بمثلها","وفاقَ ولاة الأَمْر ممَّن تقدّما",202,"م",2,0],["وما سرَّني إلاَّ جميل محمَّد","وليسَ جميلٌ بعد آل جميل",203,"ل",1,0],["وماسَ فمالَ البان إذ ذاكَ غَيْرَةً","عليه وأزرى فيه عند ازوراره",204,"ر",2,0],["وما سالتْ دموعُ العين إلاَّ","لما في القلب من حرّ السُّموم",205,"م",1,0],["وما سرَّها شيءٌ كمقدمِكَ الَّذي","يبدل منها صورة اليسْرِ بالعُسْر",206,"ر",1,0],["وما سرّ نفسي بعده ما يسرّها","ولا راق ما قد راق شيء لمنظري",207,"ر",2,0],["وما سادَ في أرض العراقين ماجد","من النَّاس إلاَّ فَدْمُها ورذيلها",208,"ه",2,0],["وما سالَ مثل السَّيل إلاَّ رَدَدْتَهُ","وخَلَّيت منه سائل البحر في مهمهٍ قفرِ",209,"ر",1,0],["وما سرت عمَّن سرت إلاَّ لمطلبٍ","أسُرُّ به صحبي وأكبت حُسَّدي",210,"د",2,0],["وما ساءها بالبين ركبٌ مقوَّضٌ","ولا راعها يوماً خليطٌ مودع",211,"ع",1,0],["وماس ملتفتاً قالت معاطفه","كم تحت لفتة ظبي الروم من عجبِ",212,"ب",1,0],["وماس على كثبانهِ البان راقصاً","تميل على أيدي النسيم خصورهُ",213,"ه",1,0],["وماست فخلنا قضيبا تثنى","ولاحت فباحت جواري عدن",214,"ن",1,0],["وماسحُ أعطافِ الإمام إذا التوَتْ","أفاعيهِ حتى لا يُلائمُ راقيا",215,"ي",2,0],["ومأْسورٍ بِقدٍّ من سوارٍ","ومكبولٍ بقيدٍ من خدامِ",216,"م",1,0],["وَمَا سَكَنَتْ جُنوبٌ فِي مِهادٍ","ولا مُلِئَتْ عيونٌ من مَنَامِ",216,"م",1,0],["وَمَا ساقَتِ الشُّورى وأَوْجَبَتْ التُّقى","وأَوْرَثَ ذُو النُّورَيْنِ عَمُّكَ عُثْمانُ",217,"ن",1,0],["وما ساد من لا جاد أو كان صافحا","بحلم على الجاني برقة حاشم",218,"م",1,0],["وما سل المهند للتوفي","كسل المشرفية للتشفي",219,"ف",2,0],["وما ساءني أن يمنعَ الغيثُ جودَهُ","وكفُّك لي إمّا احتلبتُ لَبونُ",220,"ن",1,0],["وما سعَوا عارين أبدانا إلى ال","حجّ وأضحَوا عاقرين للبُدُنْ",221,"ن",1,0],["وما سرٌّ ملكتِ قيادَ قلبي","به فمضيتِ آخذةً زمامَهْ",222,"م",2,0],["وما سلمت لكم نفسٌ وعِرضٌ","فأهون هالك عينٌ ووَرْقُ",223,"ق",1,0],["وما سرى بين الغرار والكرى","طيفٌ لها ردَّ الظلامَ فَلَقا",224,"ق",2,0],["وما سار من ذكرها في السماح","فهم ريَّشوه وهم طيَّروا",225,"ر",3,0],["وما سال حتى أسلنا اللُّجيْنَ","ولا عَزَّ حتى أهنَّا النُّضارا",226,"ر",2,0],["وما سرَّني أني حًسامٌ وليس لي","بنانٌ لتجريدِ الضِّرابِ وساعِدُ",227,"د",1,0],["وما ساجَلَتْهُ من سَراةِ قبيلةٍ","ففاخر اِلا كان أعْلى وأكرَما",228,"م",2,0],["وما سرَّني إلا ابتداءٌ عَدِمْتهُ","من الناس لا المالُ الشَّهيُّ ولا الوفر",229,"ر",1,0],["وما سُنَّةٌ في الدين إِلا وأنْتُمُ","إليكُمْ نواهي حَدِّها والأوامِرُ",230,"ر",1,0],["وما سمّوهُ سيفَ الدين حتى","مضى وسميّهُ منهُ يحار",231,"ر",1,0],["وماست قناهم في الأسنّة عزّةً","تثنّي غصونِ الدوح في يانع الزهر",232,"ر",1,0],["وما سمرهُ إلاَّ الأراقم في الوغى","ولا زنفهُ إلاَّ جلود الأراقمِ",233,"م",1,0],["وَما سَمِعتَ بِعُلوٍ","قَبلي يُعاديهِ سُفلُ",234,"ل",1,0],["وما سوق برائجة سواها","وما سلع سوانا في كساد",235,"د",1,0],["وما سمحت بالطيف لو كان واقعا","وصال جسوم ما له وجه صحتي",236,"ت",2,0],["وما سنّة لم يجز في الليل فعلها","وما واجب لم يجز إلا في ليلتي",237,"ت",2,0],["وما ساعدتك النفس ترقى مراقيا","بأقصى رياض القدس تجني عواليه",238,"ي",2,0],["وَما سَمِعنا بِلَيثٍ قَبلَ رُؤيَتِهِ","إِذا سَرى صاحبته في السَرى الأَجَمُ",239,"م",1,0],["وما ساستْهمُ الخيلُ ولو أن","نها فعلتْ فحكمُ الخيلِ فخرُ",240,"ر",1,0],["وماسَ تيهاً فثنّى في غلالتِه","قدّاً بحُمرِ المَنايا سالَ أسمَرُهُ",241,"ر",2,0],["وَما سجعت فَوقَ الآراك حمامة","وَهاجَت تَباريح الهَوى وَنَما الوَجد",242,"د",1,0],["وَما سرت نَسمة مِن نَحوِ كاظِمَة","وَأَومَض البَرق مِن أَكناف ذي سلم",243,"م",1,0],["وما سُدَّ بابُ الْحَقِّ عَنْ طالِبِ الْهُدَى","ولكِنَّ عَيْنَ الأَرْمَدِ الْفَدْمِ سُدَّتِ",244,"ت",1,0],["وما سُدْتَها في يوم سِلْمٍ ولم تكنْ","بسيِّدها في الضَّربِ يوم وغاها",245,"ا",3,0],["وَما سرّني حِلمٌ يَفيءُ إِلى الرّدى","كَفانِيَ ما قَبلَ المَشيبِ من الحلمِ",246,"م",1,0],["وما سُررتُ بأيّامِ الكمال فما","يعرو الفتى النّقصُ إلّا عند إكمالِ",247,"ل",1,0],["وما سلّموا حتّى رأوك محلِّقاً","يشقُّ على الأيْدِين بُعْدُ مَنالكا",248,"ك",2,0],["وما سرّني أنّي نبذتُك طائحاً","بغبراءَ لا تدنو ولا تتجمّعُ",249,"ع",1,0],["وما سرّني أنْ سرتَ عنّي وأنّني","مُقيمٌ بأرضِي أو تغيبَ وأشهدا",250,"د",2,0],["وما سلكت بتعريض المديح لهم","سبل القشدق والاعجاب بالكلم",251,"م",1,0],["وما سواه حمار جهل","يقظته في الورى سنات",252,"ت",1,0],["وما سَلِمَ الكمالُ لذاتِ شخصٍ","فلا إنسانَ مِن عيبٍ سليمُ",253,"م",1,0],["وما سلم العليا سوى البيض والقنا","وجرد عراب لم يخن أصلها الدهر",254,"ر",1,0],["وَمَاسَتْ كَمَيْسِ الخَيْزَرَانَةِ وَاتَّقَتْ","بِأَحْسَنِ مُسْوَدٍّ بَدَا فِيْهِ مُبْيَضُّ",255,"ض",1,0],["وَما سَرني أَن أَملِكَ الأَرضَ كُلَّها","وَأَنَّ فُؤادي مِن مَحَبَّتِهِ خِلوُ",256,"و",1,0],["وَما سِحِ عِطفَيهِ مِنَ الدَرَنِ اِنبَرَت","لَهُ الدُودُ أَكلاً فَاِنثَنى دَرَنَ الدَرَن",257,"ن",1,0],["وَما سَكَني إِلّا ضَريحٌ كَأَنَّهُ","لِأُنسي بِهِ ظَبٌ أَحَم رَبيبُ",258,"ب",1,0],["وما سمعْنا قَطُّ فتحاً جرى","ما فيه لا بل مَا عليه غُبَار",259,"ر",1,0],["وما سَماءٌ لهم بلا عَمَد","انظر لأَقلامِه ترى العَمَدَا",260,"د",2,0],["وما سهِرتْ رماحُك فيه إِلاّ","لترقُد في التَّرائب والجُيوب",261,"ب",1,0],["وَمَا سُمِّي العَجْلاَنَ إلاَّ لِقَوْلِهِ","خُذِ القَعبَ واحْلُبْ أيُّهَا العَبْدُ واعْجَلِ",262,"ل",1,0],["وَما سَبَقَ الحَوادِثَ لَيثُ غابٍ","يَجُرُّ لِمَرسِهِ جَزَرَ الرِفاقِ",263,"ق",1,0],["وَما سَقَطَت يَوماً مِنَ الناسِ أُمَّةٌ","إِلى الذُلِّ إِلّا أَن يَسودَ ذِميمُها",264,"م",3,0]]}