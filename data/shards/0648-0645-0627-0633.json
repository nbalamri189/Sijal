كاها","https://www.aldiwan.net/poem47143.html","الطويل"],[552,"أشيبا ولما تمض خمسون حجة","https://www.aldiwan.net/poem47216.html","الطويل"],[552,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[552,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[552,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[552,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[559,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[563,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"],[565,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[568,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[574,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[574,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[574,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[576,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[576,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[586,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["وَما سَرَّني أَنّي أُقيمُ عَلى الأَذى","وَأَنّي بِدارِ الهونِ بَعضُ الخَلائِفِ",0,"ف",1,0],["وَما سَعى والِدٌ مِنّا لِمَكْرُمَةٍ","لَمْ تَحْتَضِنْ مِثْلَها المَسْعَاةُ مِنْ وَلَدِ",1,"د",1,0],["وما سَرى البَرْقُ والظّلْماءُ عاكِفَةٌ","إلا وفي القَلْبِ منْ نِيرانِهِ شَرَرُ",2,"ر",1,0],["وَما سُمتُ نَفسي الصَبرَ عَمَّن أُحِبُّهُ","وَلا خُنتُهُ فيمَن أَراه يُخانُ",3,"ن",1,0],["وَما ساءَني إِلا كِتابٌ كَتَبتُهُ","فَلَيتَ يَميني بَعدَ ذَلِكَ شَلَّتِ",4,"ت",1,0],["وَما سَجَعَت وَرقاءُ تَهتُفُ بِالضُحى","تُصَعِّدُ في أَفنانِها وَتُصَوِّبُ",5,"ب",1,1],["وَما ساسَ أَمرَ الناسِ إِلّا مُجَرِّبٌ","حَليمٌ وَلا صافَيتَ مِثلَ كَريمِ",6,"م",1,1],["وَما سابِقٌ إِلّا بِساقٍ سَليمَةٍ","وَما باطِشٌ إِن لَم تُعِنهُ الأَنامِلُ",7,"ل",1,0],["وَما سُعادُ غَداةَ البَينِ إِذ رَحَلوا","إِلّا أَغَنُّ غَضيضُ الطَرفِ مَكحولُ",8,"ل",1,0],["وَما ساءَت ظُنونُكَ يَومَ تولي","بِأَرماحٍ وَفَى لَكَ مُشرِعوها",9,"و",3,0],["وَما سُقتَ مِن عادِ البِلادِ وَأَهلِها","وَما قُلتَ في أَهرامِ خوفو وَخَفرَعِ",10,"ع",1,0],["وَما ساءَ ظَنِّيَ في أَن يُسيءَ","بِيَ الفِعلَ حُسنُكِ حَتّى فَعَل",11,"ل",1,0],["وَما سالَ وادٍ مِن تِهامَةَ طيبٌ","بِهِ قُلبٌ عادِيَّةٌ وَكِرارُ",12,"ر",1,0],["وَما سَجَعَت مِن بَطنِ وادٍ حَمامَةٌ","يُجاوِبُها صاتُ العَشِيِّ طَرُوبُ",13,"ب",1,0],["وَما سُؤالي ذاكَ إِلّا لِكَي","يُسقاهُ هامٍ بِالرَوي في القِفار",14,"ر",1,0],["وما سبيل إلى أدنى الوفاء بما","لكل مبتدرٍ وافى ليكرمني",15,"ن",2,0],["وَمَا سَبِيلِي إلى أدْنَى الوَفَاءِ بِمَا","لِكُلِّ مُبتَدِرٍ وَافَى لِيُكَرمُنِي",16,"ن",2,0],["وما سكت الأحرار عن مخزياتكم","فكم أبرقُوا غيظاً عليكم وأرعدوا",17,"د",3,0],["وما سادت شعوب الخلق إلاّ","بتهيئة البنين لذا الصراع",18,"ع",1,0],["وما سرّه من دولة العجم رتبة","ولا غره من دولة العُرب منصب",19,"ب",1,0],["وَما سَيرُ شَهرٍ كُلِّفَتهُ رِكابُنا","وَلَكِنَّهُ شَهرٌ وَصَلنَ بِهِ شَهرا",20,"ر",2,0],["وما سمَّوا بأبرهة اغتباطاً","بشر ختونة متزينينا",21,"ن",2,0],["وَمَا سَمَّوا بِاَبرَهةَ اغتِبَاطاً","بِشَينِ خُتُونَةٍ مُتَزيِنِينَا",22,"ن",2,0],["وما سَمَّي بِقَتلِ أَبِيهِ مِنَّا","قَتِيلاً في عضَايِهِ مُفتَرِينَا",22,"ن",2,0],["وَما ساءَني أَنّي مَكانَكَ عانِياً","وَأُسلِمُ نَفسي لِلإِسارِ وَتَسلَمُ",23,"م",1,0],["وَما سَفَرَت عَن رَيِّقِ الحُسنِ إِنَّما","نَمَمنَ عَلى ما تَحتَهُنَّ المَعاجِرُ",24,"ر",1,0],["وما سميَ الغيثُ الهتونُ سحابة","سوَى أنهُ من خجلةٍ يتسحّب",25,"ب",1,0],["وماست السمر بالإعجاب وابتسمت","بيض السيوف وقرّت أعين الزّرد",26,"د",1,0],["وما سرق القول فيه الثنا","فحاشاه من قطع تلكَ الأيادِي",27,"د",2,0],["وما سمّاك هذا الاسم إلا","وليٌّ عارفٌ سر الأسامي",28,"م",2,0],["وما سُرَّ قلبي مُذ شَطت بك النوى","أنيسٌ ولا كأسٌ ولا مُتَصَرَّفُ",29,"ف",1,1],["وما سيْبُ الأميرِ بسيلِ وادٍ","يقصِّر أن ينَال ذرا الروابي",30,"ب",2,0],["وما سكتُّ اعترافاً بالحديث لهُ","لكن كظمتُ وبي من حرّهٍ لَهثُ",31,"ث",1,0],["وما سرني أن بعْتُهُ بثَوابِه","ولو أنه التَّخْليدُ في جنَّةِ الخُلْدِ",32,"د",1,0],["وما سرَّ عيدانَ الأراك برِيقها","تَناوُحها في أيكها تتهصَّرُ",33,"ر",1,0],["وما سَيّر الهاجون في الشعر خزيةً","لعمرُك إلا كان في النثر أسْيرا",34,"ر",2,1],["وما ساءني فوت ما فاتني","وإن كان كالعضو مني نُزِع",35,"ع",1,0],["وما سدّ قولٌ في فعالك خَلَّةً","ولا وَجَدَ المدّاحُ نقصاً فتمَّمُوا",36,"م",3,0],["وما سدَّ قولٌ في فعالك خلةً","ولا وجد المدَّاحُ نقصاً يتمَّمُ",37,"م",1,1],["وما سَخَطِي على من جاءَ يَجرِي","إليَّ وغبطتي فَرَسَيْ رِهان",38,"ن",1,0],["وما سُنَّةُ الشيطانِ سَنَّت بِبَذْلها","فواضِلَها بل سُنَّةُ الله سنَّتِ",39,"ت",1,0],["وَما سَعى مِنهُمُ ساعٍ لِيُدرِكَنا","إِلّا تَقاصَرَ عَنّا وَهوَ مُنبَهِرُ",40,"ر",1,0],["وَما سَبَقَ الغاياتِ إِلّا جِيادُها","وَما تَستَطيعُ الجِلَّةَ البَكَراتُ",41,"ت",1,0],["وَما سَرَت نَسَماتٌ نَحوَها سَحَراً","إِلّا وَدِدتُ لَو أَنّي كُنتُ في النَسَمِ",42,"م",1,0],["وَما سَأَلتُ اِمرَأً فيما تُفَجِّعُهُ","إِلّا وَجاوَبَ إِنّي مِن مُحِبّيهِ",43,"ي",2,0],["وَما سَرَّني أَنَّ المَلاهِيَ كَثيرَةٌ","وَفي الشَرقِ قَومٌ يَجهَلونَ المَلاهِيا",44,"ي",2,0],["وَما سَرَّني غَيرُ الَّذي كانَ مِنهُمُ","وَمِنّي وَقَد جاؤوا إِلَيَّ وَأَوجَفوا",45,"ف",3,0],["وما سفري إن متُّ ينأَى وإنما","إلى بطنها من ظهرها اتنقل",46,"ل",1,0],["وما سلمت عليها قبل هذا","من الأرزاء حتى الأنبياء",47,"ا",2,0],["وما سألوا بنيك ولا بنينا","ولا ألتفتوا إلى القوم الغضاب",48,"ب",1,0],["وَما سَعدٌ بِمُتَّجِرٍ إِذاما","تَعَرَّضَتِ الحُقوقُ شَرى وَباعا",49,"ع",2,0],["وَما سَلِمَ الوَليدُ مِنِ اِشتِكاءٍ","فَهَل يَخلو المُعَمَّرُ مِن أَذاةِ",50,"ه",1,0],["وَما سارَت سِوى يَومَي زَمانٍ","فَأَهلاً بِالغُزاةِ الفاتِحينا",51,"ا",1,0],["وَما سَكَبَ الميزابُ ماءً وَإِنَّما","أَفاضَ عَلَيكَ الأَجرَ وَالرَحَماتِ",52,"ت",1,0],["وَما سَلَّمتُ فَوقَكَ لِلثُرَيّا","وَلا سَلَّمتُ فَوقَكَ لِلسَماءِ",53,"ا",2,0],["وَما سَكَني سِوى قَتلِ الأَعادي","فَهَل مِن زَورَةٍ تَشفي القُلوبا",54,"ب",2,0],["وَما سَمِعتُ وَلا غَيري بِمُقتَدِرٍ","أَذَبَّ مِنكَ لِزورِ القَولِ عَن رَجُلِ",55,"ل",1,0],["وما سوَّغَتْنَا ليلةَ الوَصْلِ قرضَها","إِلى أنْ بدَا الإِصباحُ يرتجِعُ القرضَا",56,"ض",2,0],["وما سبقتْ منِّي إليهم اساءَةٌ","ولكنّهمْ مالُوا عليَّ مع الدهرِ",57,"ر",1,0],["وما ساقَني فقرٌ إليكَ وإنَّما","أبَى لي عزوفُ النفسِ أن أعرِفَ الفقرا",58,"ر",2,0],["وَما سَوَّدَ الأَقوامُ مِثلَ عُمارَةٍ","إِذا نُسِيَ الأَقوامُ شاعَ لَهُ ذِكرُ",59,"ر",1,0],["وَما ساءَني أَنَّهُم أَصبَحوا","مِنَ الخِزيِ في دارِ شَرٍّ وَعَر",60,"ر",1,0],["وَما سَواءٌ إِذا التَقَينا","سَهلٌ عَلى خُلَّةٍ وَوَعرُ",61,"ر",1,0],["وَما سُمِعَت قَبلَها مِثلُها","وَقَد راعَهُم صَوتُها رائِعَه",62,"ع",2,0],["وَما سُعِدَت بِسُعدى النَفسِ حَتّى","شَجاها البَينُ فيها بِاِحتِراقِ",63,"ق",1,0],["وَما ساعَةٌ مِن جاهِهِ دونَ جودِهِ","بِمُبعِدَةٍ مِن أَن يُنالَ جَزيلُ",64,"ل",1,0],["وَما سَرَّني أَنَّ قَلبي أُعي","رَ عَزاءَ القُلوبِ وَسُلوانَها",65,"ن",3,0],["وَما سالَ في وادٍ كَأَودِيَةٍ لَهُ","دَفَعنَ مَعاً في بَحرِهِ حينَ أَزبَدا",66,"د",2,1],["وَما ساقَها مِن حاجَةٍ أَجحَفَت بِها","إِلَيكَ وَما مِن قِلَّةٍ في مُجاشِعِ",67,"ع",1,0],["وَما سَجَنوني غَيرَ أَنّي اِبنُ غالِبٍ","وَأَنّي مِنَ الأَثرَينِ غَيرِ الزَعانِفِ",68,"ف",1,0],["وَما سَكَنَت عَنّي نَوارٌ فَلَم تَقُل","عَلامَ اِبنُ لَيلى وَهيَ غُبرٌ عِيالُها",69,"ل",3,0],["وَما سَيَّرَت جاراً لَها مِن مَخافَةٍ","إِذا حَلَّ مِن بَكرٍ رُؤوسَ الغَلاصِمِ",70,"م",1,0],["وما سَتَرَ الكِتْمانُ عندي صَنيعَةً","ولا أفسدَ النَّعماءَ فيَّ جُحودُها",71,"د",3,0],["وَما سِيّانِ مَن هُوَ في جَحيمٍ","يَكونُ شَرابُهُ فيها صَديدا",72,"د",2,0],["وَما سِيّانِ ذو خُبرٍ بَصيرٌ","وَآخَرُ جاهِلٌ لَيسا سَواءَ",73,"ا",2,0],["وَما ساوَرَتكَ سِوى ساعَةٍ","فَما كُنتَ أَهلاً لِأَسبابِها",74,"ب",3,0],["وما سُلَّ لِلضَّرْبِ إلّا أسالَ","عَلى خَدِّهِ أَدمعَ المقتلِ",75,"ل",1,0],["وما سفاقسُ إلا بَلْدَةٌ بعثَتْ","إليك عنها لسانَ الصدق تعتذرُ",76,"ر",1,0],["وما سَدَدتَ سَبيلي عن لِقائِهِمُ","لَكِنْ جَعَلتَ صِفادي عنهُمُ الصّفَدا",77,"د",2,0],["وَما سافَرتُ في الآفاقِ إِلّا","وَمِن جَدواكَ راحِلَتي وَزادي",78,"د",2,0],["وما سمرُ القدودِ وإنْ سبتنا","أحبُّ إليهِ منْ سمرِ الرماحِ",79,"ح",1,0],["وما سواكم بكفءٍ في الأنامِ لكمْ","والليثُ أفتكُ أفعالاً منَ النمرِ",80,"ر",1,0],["وَما سَلَكَ الموماةَ مِن كُلِّ حَسرَةٍ","طَليحٍ كَجَفنِ السَيفِ تَهوي فَتُركَبُ",81,"ب",1,0],["وما سارَ في الأرض العريضَةِ ذكرُهُ","ولكنّهُ في مسلَكِ الشمسِ سالِك",82,"ك",1,0],["وما سَرّني تأمِيلُ غيرِ خليفَةٍ","وأنّيَ للأرضِ العَريضَةِ مالك",82,"ك",1,0],["وما سُدّدَ الأملاكُ من قبل جعفَرٍ","ولا أنكرُوا نُكراً ولا عرفوا عُرفا",83,"ف",2,0],["وما سرّهم ما ساءَ أبناءَ قَيصرٍ","وتلك تِراتٌ لم تزَلْ وحُقود",84,"د",1,0],["وَما سَرَّني أَنّي أَكونُ بِحالَةٍ","لِمِثلِكَ في الدُنيا عَلَيَّ سَبيلُ",85,"ل",1,0],["وَما سُمتُها هوناً فَتَأبى قَبولَهُ","وَلَكِنَّما طالَ الصَفاءُ فَمَلَّتِ",86,"ت",1,0],["وَما سَرَّني أَنّي أَصَبتُ مَعاشِراً","بِظُلمٍ وَأَنّي في النَعيمِ مُخَلَّدِ",87,"د",1,0],["وَما سُمُّ الحُبابِ لَدَيَّ إِلّا","كَنَظمٍ قيلَ في آلِ الحَبابِ",88,"ب",1,0],["وَما سَمَحَت لِيَعرُبِها اللَيالي","وَحَيِّ نِزارِها إِلّا بَنزَرِ",89,"ر",1,0],["وَما سَرَّني أَنَّني في الحَياةِ","وَإِن بانَ لي شَرَفٌ وَاِنتَشَر",90,"ر",1,0],["وَما سَرَّني أَنّي اِبنُ ساسانَ أَغتَدي","عَلى المَلِكِ في الإيوانِ أُصبِحُ أَو أُمسي",91,"س",2,0],["وَما سَلُّ المُهَنَّدِ لِلتَوَقّي","كَسَلِّ المَشرِفيَّةِ لِلتَشَفّي",92,"ف",2,0],["وَما سَرَّني رَبُّ الخَيالِ بِشَخصِهِ","فَيَطلُبُ مِنّي النَومُ طَيفَ خَيالِ",93,"ل",1,0],["وَما سَمَحَت لَنا الدُنيا بِشَيءٍ","سِوى تَعليلِ نَفسٍ بِالمُحالِ",94,"ل",1,0],["وَما سالَمَ الحَيَّ القَضاءُ وَإِنَّما","إِلى الحَتفِ يَرقى وَالسَلامَةُ سُلَّمُ",95,"م",1,0],["وَما سَفَتِ الريحُ الرَغامَ جَهالَةً","وَلا رَكَدَت قُدسٌ وَأَترابُها حِلما",96,"م",2,0],["وَما سَمَحَت لّزائِراتِ بِأَمنِها","وَلا لِلمَواكي في أَقاصي المَواكِنِ",97,"ن",1,0],["وَما سَيري إِلى أَحجارِ بَيتٍ","كُؤوسُ الخَمرِ تُشرَبُ في ذَراها",98,"ا",3,0],["وَما سكني في الدار بعدك إنها","بِعَيني إذا لم تسكن الدار بلقع",99,"ع",1,0],["وما سفائنُه في البحر منشَئَةً","رُعنَ الحديد وهجنَ النار إعصارا",100,"ر",2,0],["وما سمَّاهُ إذ نادا","هُ غير الأعينِ الحورِ",101,"ر",1,0],["وما سِحْرُها ألتكوينها","وما حسنُها ألتصويرها",102,"ه",2,0],["وما سَلَبَتْنا العِزَّ قَطّ قبيلةٌ","ولا باتَ مِنّا فيهِمُ أُسَراء",103,"ر",3,0],["وما سامحَتْ نفْسي بها عند حادِثٍ","فُلاناً فما بالي وبالُ فُلانَه",104,"ن",2,0],["وما سارَ بي إلاّ الذي غَرّ آدَماً","وحَوّاءَ حتى أدرَكَ الشّرَفَ الهَبْطُ",105,"ط",1,0],["وَمَا سَاءَنِي إِلَّا صَنِيعُ مَعَاشِرٍ","أَلَحُّوا عَلَيْهَا بِالْخِيَانَةِ وَالْغَدْرِ",106,"ر",1,0],["وَمَا سَاءَتْكَ ظَالِمَةٌ وَكَانَتْ","بَمَا سَاءَتْ تٌعِدُّ لَكَ الثّوَابَا",107,"ب",2,0],["وَمَا سَرَّ نَفْسِي كَإِجْمَاعِهِمْ","وَقَدْ لَقَّبُوكِ بِأُمِّ الْعَرَبْ",108,"ب",1,0],["وَمَا سَيَكُونُ مِنْهَا حَظُّ مِصْرٍ","وَقَبْلاً حَظُّهَا مِنْهَا هِبَاءُ",109,"ا",2,0],["وما سطرته دموع الضنى","كأن الحياة إذا غبتي عكس الحياة",110,"ه",1,0],["ومأساة الوجود تحز قلبي","وتلتهم البقية من كفاحي",111,"ح",2,0],["وَما سَرَّني العَيشُ بَعدَ العِدا","إِذ المَوت مَن فاتَهُ أَدرَكا",112,"ك",2,0],["وَما سَهَّلَت تِلكَ المَذاهِبَ فيهِمُ","عَلى الناسِ إِلّا بَيعَةُ الفَلَتاتِ",113,"ت",1,0],["وما سرَّني التفتيشُ حينَ وَلِيتُه","ولا أنا -إن ولَّى- عليه بآسف",114,"ف",1,1],["وما سالت دموعُ العين إلا","لتطفئ مهجةً فيها اشتعال",115,"ل",1,0],["وما سرني من أمس عند ادّكاره","أدَرَّ لدمع العين ممِا شجانيا!",116,"ي",2,0],["وما سَمَلَتْ عيناً ، وما قَطَعَتْ يداً","ولا حجزتْ رأيا ، ولا أحْرَقَتْ كتبا",117,"ب",2,0],["وما سرني في البُعد حال تحسَّنَتْ ،","بلاديَ أشهى لي وان ساءتِ الحال",118,"ل",1,0],["وما سِيانِ بالرفق امتلاكٌ","لمملكة وبالسيف امتشاق",119,"ق",1,0],["وما سهلٌ حياةُأخي شعورٍ","من الوجدان ينبضُ فيه عرقُ",120,"ق",1,0],["وما سألت امرءا فيما تفجّعه","إلاّ وجاوب - \" إنّي من محبّيه \"",121,"ي",2,0],["وَما ساقَها من حاجَةٍ أجْحَفَتْ بهَا","إلَيْكَ، وَلا مِنْ قِلّةٍ في مُجاشِعِ",122,"ع",1,0],["وما سُنة ُ الشيطانِ سَنَّت بِبَذْلها","فواصِلَها بل سُنهُ الله سنَّتِ",123,"ت",1,0],["وما سألوا بينك ولا بنينا","ولا ألتفتوا إلى القوم الغضاب",124,"ب",1,0],["وَما سَمَعوا صَليل ظِباك إِلّا","تَصافَحَت النَواصي وَالصَعيد",125,"د",1,0],["وماس فقيل صار الرمح قدا","ولاح فقيل صار البدر جسما",126,"م",2,0],["وماس مع الدلال فهز رمحا","ورش بلطف رمشته نبالا",127,"ل",2,0],["وما سلوا ذكر من هاموا بهم ولها","ان المحب لعمري ليس بالسال",128,"ل",1,0],["وماس بالسعد من بعد الشقاء ربه","اخو انقطاع وقد ضاقت به هيت",129,"ت",1,0],["وما سِواهُ فُحُولُ الشِّعرِ تُنْكِرُهُ","ويَتَّقِي شَرَّهُ الإنسانُ والجانُ",130,"ن",1,0],["وما سار ركبٌ نحو مكةَ مسرعاً","وما انصبَّ هطَّالٌ وما هبَّ طارِقُ",131,"ق",1,0],["وَما سَمِعتُ بِصَقرٍ ظَلَّ يَرصُدُهُ","مِن قَبلِ هَذا بِجَنبِ المَرجِ مِن خَرَبِ",132,"ب",1,0],["وماس يختالُ عجبْاً في محاسنهِ","حتى كسانيَ ثوب التيهِ والخجلِ",133,"ل",1,0],["وما ستَرتْ عيوبَك عن عيونٍ","بَصيراتٍ يداك ببذلِ مالِ",134,"ل",1,0],["وما سلكتُ فجِاج الحبِّ معتزما","حتى ضمِنتُ ولو بالنفس إسعادي",135,"د",2,0],["وما سلبَ الشتاءُ الأرضَ إلا","تسربلنَ المحامدَ فاكتسَينا",136,"ن",2,0],["وَما سَبَقوا الحِمامَ هُناكَ إِلّا","كَما سَبَقَ الحَمامُ السَوذَنيقا",137,"ق",2,0],["وَما سَمعي إِلى العُذّالِ مُصغٍ","وَلا قَلبي عَنِ الأَحبابِ ذاهِل",138,"ل",1,0],["وَما سَلَّ الكَهامَ عَلى عِداهُ","غَداةَ الرَوعِ مَن وَجَدَ الحُساما",139,"م",2,0],["وَمَأْسُورَةِ الأَجفانِ عَنْ سِنَةِ الكَرى","وَلكِنَّها في حَلْبَةِ الدَّمْعِ تُطْلَقُ",140,"ق",1,0],["وَمَأْسورةِ الأَلْحاظِ عن سِنة الكرى","كَأَنَّ عَلَيها الصبرَ ضربةُ لازِبِ",141,"ب",1,0],["وما سرني نفيانها ليزيدني","يقينا فان الأمر أوضح ان يجلى",142,"ل",2,0],["وما سِوى التّربِ نَعلُ رِجلي","ولا سِوى الشّعرِ تاجُ راسي",143,"س",2,0],["وما سكنت إلى بغداد مفتتحا","باب المعيشة عن جهل ولا موق",144,"ق",1,0],["وما سرّهم من غيرهم سرّ غيرهم","بهم ولهم والدائرات دوائر",145,"ر",1,0],["وَما سيّدٌ حقّاً سوى اللَّه إنّه","لهُ الحكمُ في الدُنيا لهُ الحكم في الأخرى",146,"ر",2,0],["وَما ساءَني إِغواؤهم لمعاشرٍ","منَ الناسِ ضلّوا أبدلوا كفرَهم كفرا",147,"ر",2,0],["وما سجيريَ فيها غيرُ مُنْصَلِتٍ","عَضْبِ السِّطامِ وبحرُ الليل مسجور",148,"ر",1,0],["وما سميَّ الروضُ باسمِ الجنان","لو لم يكن بعضَ ولدانها",149,"ن",3,0],["وما سيانَ في طمعٍ وحرصٍ","إذا ما الكلبُ أشبههُ الذئابُ",150,"ب",1,0],["وما سلَّط اللَهُ نبتَ اللِّحى","على المُرد إلا زوال النِّعمْ",151,"م",1,0],["وماس يسحب اذيال الشباب وقد","تضوع الروض من انفاسه العطره",152,"ر",2,0],["وماس وكنت جريح الاسى","فمال وقلبي طعين الأسل",153,"ل",1,0],["وما سلّمت مذ حرّمت وصلي","فكيف تحرم النظر المباحا",154,"ح",2,0],["وَما سَرى في مَقاصيرِ اللَظى خبرُ","حارَ اللَهيبُ بِهِ وَاِستَسأَلَت سقرُ",155,"ر",1,1],["وماسَتْ على الكُثْبان قضبانُ فِضَّة","وأثقلْنَهَا من حملهنَّ نُهُود",156,"د",1,0],["وماس من كل غصن منك من طرب","عطف وتهت دلالاً في تهاديك",157,"ك",1,0],["وَما سَرى بَرقٌ وَما","مالَ بِغِرّيدٍ فَنَن",158,"ن",1,0],["وَما سَرى تَحتَ الدُجى","وَميضُ بَرقٍ يَخطِفُ",159,"ف",1,0],["وَما سَعى بِالفِراقِ ساعٍ","وَلا أَذاعَ الهَوى مُذيعُ",160,"ع",1,0],["وما سمعت أذاني قبلك فاتحاً","يفيض على الأعداء خيراً ويسكب",161,"ب",1,0],["وماسَ فاشتاقت غصونُ البان أن","تَنقُل ذاك اللِّينَ عن قَوَامهِ",162,"م",2,0],["وَما سَألوكَ عَقد الصُلح ودّاً","وَلَكِن تَحتَ غاباتِ الرِماحِ",163,"ح",1,0],["وما ساءَني إِلا هُيامي بقَينةٍ","تُحاوِلُ أن تحكي الذي أنا حاك",164,"ك",1,0],["وما سَهري لجملٍ أو لنعمٍ","ولا شَغفي بحسنٍ زينبي",165,"ي",1,0],["وَما سجعت ورق الحَمائم في الجمى","وغرد قَمَري لتغريد بلل",166,"ل",1,0],["وما سحّت يَداهُ نَداه إلا","تَبَيّن في الحَيا مِنْهُ الحَياء",167,"ا",2,0],["وَما سارَ سيرَتَهُ قَبلَهُ","سِوى العُمَرَينِ بِحُسنِ الشِّيَم",168,"م",1,0],["وَماسَ بِالرِدفِ ثَقيلاً وَبِال","خصرِ دَقيقاً تَحتَ بَطنٍ خَميص",169,"ص",1,0],["وَما سَمِعنا مِثلَ راياتِهِ","بِجُلَّنارٍ كانَ نَيلوفَرا",170,"ر",2,0],["وَماسَ فقال الرمحُ تلك مَعاطِفي","مَتى أَزهرت فوقَ الرِماح الشَقائقُ",171,"ق",1,0],["وما سرى البرق بنجد الحمى","ونمنم الرعد ودر الغمام",172,"م",1,0],["وما سرت من حيكم نسمة","تذكر الصب حديث الغرام",172,"م",1,0],["وَما سوسُ ملكٍ في التمدّن واغلٌ","كَملكٍ تخطّاه الرفاهُ وجمّهُ",173,"م",2,0],["وَما سَبَقَت مِن جاهِلٍ قَطُّ نِعمَةٌ","إِلى أَحَدٍ إِلّا أَضَرَّ بِها الجَهلُ",174,"ل",1,0],["وَمَا سَرْدُ داودَ مِنى يَقيِكَ","وَأَنتَ بِأَسهُمِ لَحظي رَشِيقُ",175,"ق",1,0],["وَما ساءَ قَلبي وَهوَ حَيٌّ بِقُربِكُم","تَرَحُّلُ جِسمي عَنكُم وَهوَ مَيِّتُ",176,"ت",1,0],["وَما ساءَني جَهلُ العَمِيِّ بِرُتبَتي","وَمَشهَدَ أَربابِ البَصائِرَ مَشهَدي",177,"ي",1,1],["وَماس في حللٍ خُضر فَذكّرني","خُضر الرُبوع زَهَت بِالسَيّد الخضري",178,"ر",2,0],["وَما سَبَب الإِعراض عَنّي أَهكَذا","يَكون جَزا هَذا المُحبّ عَلى الحُبِّ",179,"ب",1,0],["وما سَيّارةُ الأفْلاكِ إلاّ","حَواسِدُها المُسِرّاتُ الضَّغائن",180,"ن",1,0],["وما ساءني مِن أخْذِه وعطائهِ","وما بَيْنَ أن أفنَى حميداً وأن أَقْنى",181,"ن",2,0],["وما سِرْتُ إلاّ في الهَواجرِ وحْدَها","كراهةَ ظلّي أنْ يكونَ قَريني",182,"ن",2,0],["وما سمَتِ السّماءُ بحيثُ تَرضَى","لخَيْلِك من أَهِلَّتِها نِعالا",183,"ل",2,0],["وَما سَلَفَت لي قَطُّ في الحُبِّ غِبطَةٌ","فَتُعجِبَني فيها اللَيالي السَوالِفُ",184,"ف",1,0],["وَما سَمِعَت أُذنايَ قَبلَ لِقائِها","بِحَلْي عَلى حَلْيٍ وَدُرٍّ عَلى دُرِّ",185,"ر",1,0],["وَما سَلسَلَت مِن مُذابِ السُرورِ","وَما خَفَّضَت مِن جِماحِ التَقالي",186,"ل",2,0],["وَما سَكَنَت رِماحُكَ مِن طِعاني","وَلا جَفَّت سُيوفُكَ مِن جِراحي",187,"ي",1,0],["وما سرَّ قَلبي أن يُعافى مِن الهَوى","وأنِّي بِلا حبٍّ يَتمُّ سرورُ",188,"ر",1,0],["وما سَرحَت بالقول فيك قصيدةٌ","يسوق إليك السامعينَ نشيدُها",189,"د",3,0],["وماست السُّمرُ وافترَّتْ لذاك ثغور","البيض وارتعَدَتْ منه الفراعين",190,"ن",1,0],["وما سد عنك الباب كلا وإنما","آتاك اختياراً وهو أعظم حجة",191,"ه",1,0],["وَما سُقمُ جفنيها بِضائِرِ طرفها","إِذا صَحَّ غرب السَيف فالجفن يَعطُبُ",192,"ب",1,0],["وما سَخِطتُ بِعادي إذْ رضيتَ بِه","ولا لجُرحٍ إذا أرضاكُمُ أَلَمُ",193,"م",1,0],["وما سَاءَني أن أحالَ الزّمانُ","لَيلي نهاراً وجَهلي وقَارَا",194,"ر",2,0],["وما سَلِمْتَ فذنبُ الدَّهرِ مُغْتَفَرٌ","وصرْفُهُ ما جَنى جُرماً ولا اجْتَرَحَا",195,"ح",2,0],["وما سَخِطتُ بِعادِي إذ رضِيتَ به","وما لِجُرحٍ إذا أرضاكُمُ أَلَمُ",196,"م",1,0],["وما ساءَنِي أنّي لبعدِكَ جَازِعٌ","لأنّ جميلَ الصّبرِ عنكَ عُقوقُ",197,"ق",1,0],["وما سَكنتْ نَفْسِي إلى الصّبرِ عنكُم","ولا رَضِيَتْ بُعدَ الدِّيارِ من القُرْبِ",198,"ب",1,1],["وما سرَّني أنِّي مقيمٌ ببلدةٍ","وهمِّي عليكم في المهامِهِ جَوَّال",199,"ل",1,0],["وما ساءني فَقَرٌ ولا سرّني غنًى","بحيثُ استوى عندي ثراءٌ وإقلال",199,"ل",1,0],["وما سادَ في قومٍ حقودٍ عليهم","ولا حيزت النعماء يوماً لحاسد",200,"د",1,0],["وما سُمِعت منكم قديماً وحادثاً","رواية من يروي الحديث تَوَهُّما",201,"م",2,0],["وما سبق الوالي المنيب بمثلها","وفاقَ ولاة الأَمْر ممَّن تقدّما",201,"م",2,0],["وما سرَّني إلاَّ جميل محمَّد","وليسَ جميلٌ بعد آل جميل",202,"ل",1,0],["وماسَ فمالَ البان إذ ذاكَ غَيْرَةً","عليه وأزرى فيه عند ازوراره",203,"ر",2,0],["وما سالتْ دموعُ العين إلاَّ","لما في القلب من حرّ السُّموم",204,"م",1,0],["وما سرَّها شيءٌ كمقدمِكَ الَّذي","يبدل منها صورة اليسْرِ بالعُسْر",205,"ر",1,0],["وما سرّ نفسي بعده ما يسرّها","ولا راق ما قد راق شيء لمنظري",206,"ر",2,0],["وما سادَ في أرض العراقين ماجد","من النَّاس إلاَّ فَدْمُها ورذيلها",207,"ه",2,0],["وما سالَ مثل السَّيل إلاَّ رَدَدْتَهُ","وخَلَّيت منه سائل البحر في مهمهٍ قفرِ",208,"ر",1,0],["وما سرت عمَّن سرت إلاَّ لمطلبٍ","أسُرُّ به صحبي وأكبت حُسَّدي",209,"د",2,0],["وما ساءها بالبين ركبٌ مقوَّضٌ","ولا راعها يوماً خليطٌ مودع",210,"ع",1,0],["وماس ملتفتاً قالت معاطفه","كم تحت لفتة ظبي الروم من عجبِ",211,"ب",1,0],["وماس على كثبانهِ البان راقصاً","تميل على أيدي النسيم خصورهُ",212,"ه",1,0],["وماست فخلنا قضيبا تثنى","ولاحت فباحت جواري عدن",213,"ن",1,0],["وماسحُ أعطافِ الإمام إذا التوَتْ","أفاعيهِ حتى لا يُلائمُ راقيا",214,"ي",2,0],["ومأْسورٍ بِقدٍّ من سوارٍ","ومكبولٍ بقيدٍ من خدامِ",215,"م",1,0],["وَمَا سَكَنَتْ جُنوبٌ فِي مِهادٍ","ولا مُلِئَتْ عيونٌ من مَنَامِ",215,"م",1,0],["وَمَا ساقَتِ الشُّورى وأَوْجَبَتْ التُّقى","وأَوْرَثَ ذُو النُّورَيْنِ عَمُّكَ عُثْمانُ",216,"ن",1,0],["وما ساد من لا جاد أو كان صافحا","بحلم على الجاني برقة حاشم",217,"م",1,0],["وما سل المهند للتوفي","كسل المشرفية للتشفي",218,"ف",2,0],["وما ساءني أن يمنعَ الغيثُ جودَهُ","وكفُّك لي إمّا احتلبتُ لَبونُ",219,"ن",1,0],["وما سعَوا عارين أبدانا إلى ال","حجّ وأضحَوا عاقرين للبُدُنْ",220,"ن",1,0],["وما سرٌّ ملكتِ قيادَ قلبي","به فمضيتِ آخذةً زمامَهْ",221,"م",2,0],["وما سلمت لكم نفسٌ وعِرضٌ","فأهون هالك عينٌ ووَرْقُ",222,"ق",1,0],["وما سرى بين الغرار والكرى","طيفٌ لها ردَّ الظلامَ فَلَقا",223,"ق",2,0],["وما سار من ذكرها في السماح","فهم ريَّشوه وهم طيَّروا",224,"ر",3,0],["وما سال حتى أسلنا اللُّجيْنَ","ولا عَزَّ حتى أهنَّا النُّضارا",225,"ر",2,0],["وما سرَّني أني حًسامٌ وليس لي","بنانٌ لتجريدِ الضِّرابِ وساعِدُ",226,"د",1,0],["وما ساجَلَتْهُ من سَراةِ قبيلةٍ","ففاخر اِلا كان أعْلى وأكرَما",227,"م",2,0],["وما سرَّني إلا ابتداءٌ عَدِمْتهُ","من الناس لا المالُ الشَّهيُّ ولا الوفر",228,"ر",1,0],["وما سُنَّةٌ في الدين إِلا وأنْتُمُ","إليكُمْ نواهي حَدِّها والأوامِرُ",229,"ر",1,0],["وما سمّوهُ سيفَ الدين حتى","مضى وسميّهُ منهُ يحار",230,"ر",1,0],["وماست قناهم في الأسنّة عزّةً","تثنّي غصونِ الدوح في يانع الزهر",231,"ر",1,0],["وما سمرهُ إلاَّ الأراقم في الوغى","ولا زنفهُ إلاَّ جلود الأراقمِ",232,"م",1,0],["وَما سَمِعتَ بِعُلوٍ","قَبلي يُعاديهِ سُفلُ",233,"ل",1,0],["وما سوق برائجة سواها","وما سلع سوانا في كساد",234,"د",1,0],["وما سمحت بالطيف لو كان واقعا","وصال جسوم ما له وجه صحتي",235,"ت",2,0],["وما سنّة لم يجز في الليل فعلها","وما واجب لم يجز إلا في ليلتي",236,"ت",2,0],["وما ساعدتك النفس ترقى مراقيا","بأقصى رياض القدس تجني عواليه",237,"ي",2,0],["وَما سَمِعنا بِلَيثٍ قَبلَ رُؤيَتِهِ","إِذا سَرى صاحبته في السَرى الأَجَمُ",238,"م",1,0],["وما ساستْهمُ الخيلُ ولو أن","نها فعلتْ فحكمُ الخيلِ فخرُ",239,"ر",1,0],["وماسَ تيهاً فثنّى في غلالتِه","قدّاً بحُمرِ المَنايا سالَ أسمَرُهُ",240,"ر",2,0],["وَما سجعت فَوقَ الآراك حمامة","وَهاجَت تَباريح الهَوى وَنَما الوَجد",241,"د",1,0],["وَما سرت نَسمة مِن نَحوِ كاظِمَة","وَأَومَض البَرق مِن أَكناف ذي سلم",242,"م",1,0],["وما سُدَّ بابُ الْحَقِّ عَنْ طالِبِ الْهُدَى","ولكِنَّ عَيْنَ الأَرْمَدِ الْفَدْمِ سُدَّتِ",243,"ت",1,0],["وما سُدْتَها في يوم سِلْمٍ ولم تكنْ","بسيِّدها في الضَّربِ يوم وغاها",244,"ا",3,0],["وَما سرّني حِلمٌ يَفيءُ إِلى الرّدى","كَفانِيَ ما قَبلَ المَشيبِ من الحلمِ",245,"م",1,0],["وما سُررتُ بأيّامِ الكمال فما","يعرو الفتى النّقصُ إلّا عند إكمالِ",246,"ل",1,0],["وما سلّموا حتّى رأوك محلِّقاً","يشقُّ على الأيْدِين بُعْدُ مَنالكا",247,"ك",2,0],["وما سرّني أنّي نبذتُك طائحاً","بغبراءَ لا تدنو ولا تتجمّعُ",248,"ع",1,0],["وما سرّني أنْ سرتَ عنّي وأنّني","مُقيمٌ بأرضِي أو تغيبَ وأشهدا",249,"د",2,0],["وما سلكت بتعريض المديح لهم","سبل القشدق والاعجاب بالكلم",250,"م",1,0],["وما سواه حمار جهل","يقظته في الورى سنات",251,"ت",1,0],["وما سَلِمَ الكمالُ لذاتِ شخصٍ","فلا إنسانَ مِن عيبٍ سليمُ",252,"م",1,0],["وما سلم العليا سوى البيض والقنا","وجرد عراب لم يخن أصلها الدهر",253,"ر",1,0],["وَمَاسَتْ كَمَيْسِ الخَيْزَرَانَةِ وَاتَّقَتْ","بِأَحْسَنِ مُسْوَدٍّ بَدَا فِيْهِ مُبْيَضُّ",254,"ض",1,0],["وَما سَرني أَن أَملِكَ الأَرضَ كُلَّها","وَأَنَّ فُؤادي مِن مَحَبَّتِهِ خِلوُ",255,"و",1,0],["وَما سِحِ عِطفَيهِ مِنَ الدَرَنِ اِنبَرَت","لَهُ الدُودُ أَكلاً فَاِنثَنى دَرَنَ الدَرَن",256,"ن",1,0],["وَما سَكَني إِلّا ضَريحٌ كَأَنَّهُ","لِأُنسي بِهِ ظَبٌ أَحَم رَبيبُ",257,"ب",1,0],["وما سمعْنا قَطُّ فتحاً جرى","ما فيه لا بل مَا عليه غُبَار",258,"ر",1,0],["وما سَماءٌ لهم بلا عَمَد","انظر لأَقلامِه ترى العَمَدَا",259,"د",2,0],["وما سهِرتْ رماحُك فيه إِلاّ","لترقُد في التَّرائب والجُيوب",260,"ب",1,0]]}