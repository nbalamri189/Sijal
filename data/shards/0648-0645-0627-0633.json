فلما عرفتها","https://www.aldiwan.net/poem23505.html","الطويل"],[46,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16640","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16689","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54642","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54566","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54526","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199474","المتقارب"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142182","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[106,"منصب زائف","https://www.poetsgate.com/ViewPoem.aspx?id=179553",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"بين قطرين","https://www.poetsgate.com/ViewPoem.aspx?id=179019",""],[90,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[28,"أهاج لك الشوق القديم خباله","https://www.poetsgate.com/ViewPoem.aspx?id=2515",""],[51,"عزمتُ على تطليقِ عرسي لعُسرتي","https://www.poetsgate.com/ViewPoem.aspx?id=30691",""],[85,"صغار في الذهاب وفي الإياب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=500984",""]],"verses":[["وَما سَرَّني أَنّي أُقيمُ عَلى الأَذى","وَأَنّي بِدارِ الهونِ بَعضُ الخَلائِفِ",0,"ف",1,0],["وَما سَعى والِدٌ مِنّا لِمَكْرُمَةٍ","لَمْ تَحْتَضِنْ مِثْلَها المَسْعَاةُ مِنْ وَلَدِ",1,"د",1,0],["وما سَرى البَرْقُ والظّلْماءُ عاكِفَةٌ","إلا وفي القَلْبِ منْ نِيرانِهِ شَرَرُ",2,"ر",1,0],["وَما سُمتُ نَفسي الصَبرَ عَمَّن أُحِبُّهُ","وَلا خُنتُهُ فيمَن أَراه يُخانُ",3,"ن",1,0],["وَما ساءَني إِلا كِتابٌ كَتَبتُهُ","فَلَيتَ يَميني بَعدَ ذَلِكَ شَلَّتِ",4,"ت",1,0],["وَما سَجَعَت وَرقاءُ تَهتُفُ بِالضُحى","تُصَعِّدُ في أَفنانِها وَتُصَوِّبُ",5,"ب",1,1],["وَما ساسَ أَمرَ الناسِ إِلّا مُجَرِّبٌ","حَليمٌ وَلا صافَيتَ مِثلَ كَريمِ",6,"م",1,1],["وَما سابِقٌ إِلّا بِساقٍ سَليمَةٍ","وَما باطِشٌ إِن لَم تُعِنهُ الأَنامِلُ",7,"ل",1,0],["وَما سُعادُ غَداةَ البَينِ إِذ رَحَلوا","إِلّا أَغَنُّ غَضيضُ الطَرفِ مَكحولُ",8,"ل",1,0],["وَما ساءَت ظُنونُكَ يَومَ تولي","بِأَرماحٍ وَفَى لَكَ مُشرِعوها",9,"و",3,0],["وَما سُقتَ مِن عادِ البِلادِ وَأَهلِها","وَما قُلتَ في أَهرامِ خوفو وَخَفرَعِ",10,"ع",1,0],["وَما ساءَ ظَنِّيَ في أَن يُسيءَ","بِيَ الفِعلَ حُسنُكِ حَتّى فَعَل",11,"ل",1,0],["وَما سالَ وادٍ مِن تِهامَةَ طيبٌ","بِهِ قُلبٌ عادِيَّةٌ وَكِرارُ",12,"ر",1,0],["وَما سَجَعَت مِن بَطنِ وادٍ حَمامَةٌ","يُجاوِبُها صاتُ العَشِيِّ طَرُوبُ",13,"ب",1,0],["وَما سُؤالي ذاكَ إِلّا لِكَي","يُسقاهُ هامٍ بِالرَوي في القِفار",14,"ر",1,0],["وما سبيل إلى أدنى الوفاء بما","لكل مبتدرٍ وافى ليكرمني",15,"ن",2,0],["وَمَا سَبِيلِي إلى أدْنَى الوَفَاءِ بِمَا","لِكُلِّ مُبتَدِرٍ وَافَى لِيُكَرمُنِي",16,"ن",2,0],["وما سكت الأحرار عن مخزياتكم","فكم أبرقُوا غيظاً عليكم وأرعدوا",17,"د",3,0],["وما سادت شعوب الخلق إلاّ","بتهيئة البنين لذا الصراع",18,"ع",1,0],["وما سرّه من دولة العجم رتبة","ولا غره من دولة العُرب منصب",19,"ب",1,0],["وَما سَيرُ شَهرٍ كُلِّفَتهُ رِكابُنا","وَلَكِنَّهُ شَهرٌ وَصَلنَ بِهِ شَهرا",20,"ر",2,0],["وما سمَّوا بأبرهة اغتباطاً","بشر ختونة متزينينا",21,"ن",2,0],["وَمَا سَمَّوا بِاَبرَهةَ اغتِبَاطاً","بِشَينِ خُتُونَةٍ مُتَزيِنِينَا",22,"ن",2,0],["وما سَمَّي بِقَتلِ أَبِيهِ مِنَّا","قَتِيلاً في عضَايِهِ مُفتَرِينَا",22,"ن",2,0],["وَما ساءَني أَنّي مَكانَكَ عانِياً","وَأُسلِمُ نَفسي لِلإِسارِ وَتَسلَمُ",23,"م",1,0],["وَما سَفَرَت عَن رَيِّقِ الحُسنِ إِنَّما","نَمَمنَ عَلى ما تَحتَهُنَّ المَعاجِرُ",24,"ر",1,0],["وما سميَ الغيثُ الهتونُ سحابة","سوَى أنهُ من خجلةٍ يتسحّب",25,"ب",1,0],["وماست السمر بالإعجاب وابتسمت","بيض السيوف وقرّت أعين الزّرد",26,"د",1,0],["وما سرق القول فيه الثنا","فحاشاه من قطع تلكَ الأيادِي",27,"ي",1,0],["وما سمّاك هذا الاسم إلا","وليٌّ عارفٌ سر الأسامي",28,"ي",1,0],["وما سُرَّ قلبي مُذ شَطت بك النوى","أنيسٌ ولا كأسٌ ولا مُتَصَرَّفُ",29,"ف",1,1],["وما سيْبُ الأميرِ بسيلِ وادٍ","يقصِّر أن ينَال ذرا الروابي",30,"ب",2,0],["وما سكتُّ اعترافاً بالحديث لهُ","لكن كظمتُ وبي من حرّهٍ لَهثُ",31,"ث",1,0],["وما سرني أن بعْتُهُ بثَوابِه","ولو أنه التَّخْليدُ في جنَّةِ الخُلْدِ",32,"د",1,0],["وما سرَّ عيدانَ الأراك برِيقها","تَناوُحها في أيكها تتهصَّرُ",33,"ر",1,0],["وما سَيّر الهاجون في الشعر خزيةً","لعمرُك إلا كان في النثر أسْيرا",34,"ر",2,1],["وما ساءني فوت ما فاتني","وإن كان كالعضو مني نُزِع",35,"ع",1,0],["وما سدّ قولٌ في فعالك خَلَّةً","ولا وَجَدَ المدّاحُ نقصاً فتمَّمُوا",36,"م",3,0],["وما سدَّ قولٌ في فعالك خلةً","ولا وجد المدَّاحُ نقصاً يتمَّمُ",37,"م",1,1],["وما سَخَطِي على من جاءَ يَجرِي","إليَّ وغبطتي فَرَسَيْ رِهان",38,"ن",1,0],["وما سُنَّةُ الشيطانِ سَنَّت بِبَذْلها","فواضِلَها بل سُنَّةُ الله سنَّتِ",39,"ت",1,0],["وَما سَعى مِنهُمُ ساعٍ لِيُدرِكَنا","إِلّا تَقاصَرَ عَنّا وَهوَ مُنبَهِرُ",40,"ر",1,0],["وَما سَبَقَ الغاياتِ إِلّا جِيادُها","وَما تَستَطيعُ الجِلَّةَ البَكَراتُ",41,"ت",1,0],["وَما سَرَت نَسَماتٌ نَحوَها سَحَراً","إِلّا وَدِدتُ لَو أَنّي كُنتُ في النَسَمِ",42,"م",1,0],["وَما سَأَلتُ اِمرَأً فيما تُفَجِّعُهُ","إِلّا وَجاوَبَ إِنّي مِن مُحِبّيهِ",43,"ي",2,0],["وَما سَرَّني أَنَّ المَلاهِيَ كَثيرَةٌ","وَفي الشَرقِ قَومٌ يَجهَلونَ المَلاهِيا",44,"ي",2,0],["وَما سَرَّني غَيرُ الَّذي كانَ مِنهُمُ","وَمِنّي وَقَد جاؤوا إِلَيَّ وَأَوجَفوا",45,"ف",3,0],["وما سفري إن متُّ ينأَى وإنما","إلى بطنها من ظهرها اتنقل",46,"ل",1,0],["وما سلمت عليها قبل هذا","من الأرزاء حتى الأنبياء",47,"ا",2,0],["وما سألوا بنيك ولا بنينا","ولا ألتفتوا إلى القوم الغضاب",48,"ب",1,0],["وَما سَعدٌ بِمُتَّجِرٍ إِذاما","تَعَرَّضَتِ الحُقوقُ شَرى وَباعا",49,"ع",2,0],["وَما سَلِمَ الوَليدُ مِنِ اِشتِكاءٍ","فَهَل يَخلو المُعَمَّرُ مِن أَذاةِ",50,"ه",1,0],["وَما سارَت سِوى يَومَي زَمانٍ","فَأَهلاً بِالغُزاةِ الفاتِحينا",51,"ا",1,0],["وَما سَكَبَ الميزابُ ماءً وَإِنَّما","أَفاضَ عَلَيكَ الأَجرَ وَالرَحَماتِ",52,"ت",1,0],["وَما سَلَّمتُ فَوقَكَ لِلثُرَيّا","وَلا سَلَّمتُ فَوقَكَ لِلسَماءِ",53,"ا",2,0],["وَما سَكَني سِوى قَتلِ الأَعادي","فَهَل مِن زَورَةٍ تَشفي القُلوبا",54,"ب",2,0],["وَما سَمِعتُ وَلا غَيري بِمُقتَدِرٍ","أَذَبَّ مِنكَ لِزورِ القَولِ عَن رَجُلِ",55,"ل",1,0],["وما سوَّغَتْنَا ليلةَ الوَصْلِ قرضَها","إِلى أنْ بدَا الإِصباحُ يرتجِعُ القرضَا",56,"ض",2,0],["وما سبقتْ منِّي إليهم اساءَةٌ","ولكنّهمْ مالُوا عليَّ مع الدهرِ",57,"ر",1,0],["وما ساقَني فقرٌ إليكَ وإنَّما","أبَى لي عزوفُ النفسِ أن أعرِفَ الفقرا",58,"ر",2,0],["وَما سَوَّدَ الأَقوامُ مِثلَ عُمارَةٍ","إِذا نُسِيَ الأَقوامُ شاعَ لَهُ ذِكرُ",59,"ر",1,0],["وَما ساءَني أَنَّهُم أَصبَحوا","مِنَ الخِزيِ في دارِ شَرٍّ وَعَر",60,"ر",1,0],["وَما سَواءٌ إِذا التَقَينا","سَهلٌ عَلى خُلَّةٍ وَوَعرُ",61,"ر",1,0],["وَما سُمِعَت قَبلَها مِثلُها","وَقَد راعَهُم صَوتُها رائِعَه",62,"ع",2,0],["وَما سُعِدَت بِسُعدى النَفسِ حَتّى","شَجاها البَينُ فيها بِاِحتِراقِ",63,"ق",1,0],["وَما ساعَةٌ مِن جاهِهِ دونَ جودِهِ","بِمُبعِدَةٍ مِن أَن يُنالَ جَزيلُ",64,"ل",1,0],["وَما سَرَّني أَنَّ قَلبي أُعي","رَ عَزاءَ القُلوبِ وَسُلوانَها",65,"ن",3,0],["وَما سالَ في وادٍ كَأَودِيَةٍ لَهُ","دَفَعنَ مَعاً في بَحرِهِ حينَ أَزبَدا",66,"د",2,1],["وَما ساقَها مِن حاجَةٍ أَجحَفَت بِها","إِلَيكَ وَما مِن قِلَّةٍ في مُجاشِعِ",67,"ع",1,0],["وَما سَجَنوني غَيرَ أَنّي اِبنُ غالِبٍ","وَأَنّي مِنَ الأَثرَينِ غَيرِ الزَعانِفِ",68,"ف",1,0],["وَما سَكَنَت عَنّي نَوارٌ فَلَم تَقُل","عَلامَ اِبنُ لَيلى وَهيَ غُبرٌ عِيالُها",69,"ل",3,0],["وَما سَيَّرَت جاراً لَها مِن مَخافَةٍ","إِذا حَلَّ مِن بَكرٍ رُؤوسَ الغَلاصِمِ",70,"م",1,0],["وما سَتَرَ الكِتْمانُ عندي صَنيعَةً","ولا أفسدَ النَّعماءَ فيَّ جُحودُها",71,"د",3,0],["وَما سِيّانِ مَن هُوَ في جَحيمٍ","يَكونُ شَرابُهُ فيها صَديدا",72,"د",2,0],["وَما سِيّانِ ذو خُبرٍ بَصيرٌ","وَآخَرُ جاهِلٌ لَيسا سَواءَ",73,"ا",2,0],["وَما ساوَرَتكَ سِوى ساعَةٍ","فَما كُنتَ أَهلاً لِأَسبابِها",74,"ب",3,0],["وما سُلَّ لِلضَّرْبِ إلّا أسالَ","عَلى خَدِّهِ أَدمعَ المقتلِ",75,"ل",1,0],["وما سفاقسُ إلا بَلْدَةٌ بعثَتْ","إليك عنها لسانَ الصدق تعتذرُ",76,"ر",1,0],["وما سَدَدتَ سَبيلي عن لِقائِهِمُ","لَكِنْ جَعَلتَ صِفادي عنهُمُ الصّفَدا",77,"د",2,0],["وَما سافَرتُ في الآفاقِ إِلّا","وَمِن جَدواكَ راحِلَتي وَزادي",78,"د",2,0],["وما سمرُ القدودِ وإنْ سبتنا","أحبُّ إليهِ منْ سمرِ الرماحِ",79,"ح",1,0],["وما سواكم بكفءٍ في الأنامِ لكمْ","والليثُ أفتكُ أفعالاً منَ النمرِ",80,"ر",1,0],["وَما سَلَكَ الموماةَ مِن كُلِّ حَسرَةٍ","طَليحٍ كَجَفنِ السَيفِ تَهوي فَتُركَبُ",81,"ب",1,0],["وما سارَ في الأرض العريضَةِ ذكرُهُ","ولكنّهُ في مسلَكِ الشمسِ سالِك",82,"ك",1,0],["وما سَرّني تأمِيلُ غيرِ خليفَةٍ","وأنّيَ للأرضِ العَريضَةِ مالك",82,"ك",1,0],["وما سُدّدَ الأملاكُ من قبل جعفَرٍ","ولا أنكرُوا نُكراً ولا عرفوا عُرفا",83,"ف",2,0],["وما سرّهم ما ساءَ أبناءَ قَيصرٍ","وتلك تِراتٌ لم تزَلْ وحُقود",84,"د",1,0],["وَما سَرَّني أَنّي أَكونُ بِحالَةٍ","لِمِثلِكَ في الدُنيا عَلَيَّ سَبيلُ",85,"ل",1,0],["وَما سُمتُها هوناً فَتَأبى قَبولَهُ","وَلَكِنَّما طالَ الصَفاءُ فَمَلَّتِ",86,"ت",1,0],["وَما سَرَّني أَنّي أَصَبتُ مَعاشِراً","بِظُلمٍ وَأَنّي في النَعيمِ مُخَلَّدِ",87,"د",1,0],["وَما سُمُّ الحُبابِ لَدَيَّ إِلّا","كَنَظمٍ قيلَ في آلِ الحَبابِ",88,"ب",1,0],["وَما سَمَحَت لِيَعرُبِها اللَيالي","وَحَيِّ نِزارِها إِلّا بَنزَرِ",89,"ر",1,0],["وَما سَرَّني أَنَّني في الحَياةِ","وَإِن بانَ لي شَرَفٌ وَاِنتَشَر",90,"ر",1,0],["وَما سَرَّني أَنّي اِبنُ ساسانَ أَغتَدي","عَلى المَلِكِ في الإيوانِ أُصبِحُ أَو أُمسي",91,"س",2,0],["وَما سَلُّ المُهَنَّدِ لِلتَوَقّي","كَسَلِّ المَشرِفيَّةِ لِلتَشَفّي",92,"ي",1,0],["وَما سَرَّني رَبُّ الخَيالِ بِشَخصِهِ","فَيَطلُبُ مِنّي النَومُ طَيفَ خَيالِ",93,"ل",1,0],["وَما سَمَحَت لَنا الدُنيا بِشَيءٍ","سِوى تَعليلِ نَفسٍ بِالمُحالِ",94,"ل",1,0],["وَما سالَمَ الحَيَّ القَضاءُ وَإِنَّما","إِلى الحَتفِ يَرقى وَالسَلامَةُ سُلَّمُ",95,"م",1,0],["وَما سَفَتِ الريحُ الرَغامَ جَهالَةً","وَلا رَكَدَت قُدسٌ وَأَترابُها حِلما",96,"م",2,0],["وَما سَمَحَت لّزائِراتِ بِأَمنِها","وَلا لِلمَواكي في أَقاصي المَواكِنِ",97,"ن",1,0],["وَما سَيري إِلى أَحجارِ بَيتٍ","كُؤوسُ الخَمرِ تُشرَبُ في ذَراها",98,"ا",3,0],["وَما سكني في الدار بعدك إنها","بِعَيني إذا لم تسكن الدار بلقع",99,"ع",1,0],["وما سفائنُه في البحر منشَئَةً","رُعنَ الحديد وهجنَ النار إعصارا",100,"ر",2,0],["وما سمَّاهُ إذ نادا","هُ غير الأعينِ الحورِ",101,"ر",1,0],["وما سِحْرُها ألتكوينها","وما حسنُها ألتصويرها",102,"ه",2,0],["وما سَلَبَتْنا العِزَّ قَطّ قبيلةٌ","ولا باتَ مِنّا فيهِمُ أُسَراء",103,"ر",3,0],["وما سامحَتْ نفْسي بها عند حادِثٍ","فُلاناً فما بالي وبالُ فُلانَه",104,"ن",2,0],["وما سارَ بي إلاّ الذي غَرّ آدَماً","وحَوّاءَ حتى أدرَكَ الشّرَفَ الهَبْطُ",105,"ط",1,0],["وَمَا سَاءَنِي إِلَّا صَنِيعُ مَعَاشِرٍ","أَلَحُّوا عَلَيْهَا بِالْخِيَانَةِ وَالْغَدْرِ",106,"ر",1,0],["وَمَا سَاءَتْكَ ظَالِمَةٌ وَكَانَتْ","بَمَا سَاءَتْ تٌعِدُّ لَكَ الثّوَابَا",107,"ب",2,0],["وَمَا سَرَّ نَفْسِي كَإِجْمَاعِهِمْ","وَقَدْ لَقَّبُوكِ بِأُمِّ الْعَرَبْ",108,"ب",1,0],["وَمَا سَيَكُونُ مِنْهَا حَظُّ مِصْرٍ","وَقَبْلاً حَظُّهَا مِنْهَا هِبَاءُ",109,"ا",2,0],["وما سطرته دموع الضنى","كأن الحياة إذا غبتي عكس الحياة",110,"ه",1,0],["ومأساة الوجود تحز قلبي","وتلتهم البقية من كفاحي",111,"ي",1,0],["وَما سَرَّني العَيشُ بَعدَ العِدا","إِذ المَوت مَن فاتَهُ أَدرَكا",112,"ك",2,0],["وَما سَهَّلَت تِلكَ المَذاهِبَ فيهِمُ","عَلى الناسِ إِلّا بَيعَةُ الفَلَتاتِ",113,"ت",1,0],["وما سرَّني التفتيشُ حينَ وَلِيتُه","ولا أنا -إن ولَّى- عليه بآسف",114,"ف",1,1],["وما سالت دموعُ العين إلا","لتطفئ مهجةً فيها اشتعال",115,"ل",1,0],["وما سرني من أمس عند ادّكاره","أدَرَّ لدمع العين ممِا شجانيا!",116,"ي",2,0],["وما سَمَلَتْ عيناً ، وما قَطَعَتْ يداً","ولا حجزتْ رأيا ، ولا أحْرَقَتْ كتبا",117,"ب",2,0],["وما سرني في البُعد حال تحسَّنَتْ ،","بلاديَ أشهى لي وان ساءتِ الحال",118,"ل",1,0],["وما سِيانِ بالرفق امتلاكٌ","لمملكة وبالسيف امتشاق",119,"ق",1,0],["وما سهلٌ حياةُأخي شعورٍ","من الوجدان ينبضُ فيه عرقُ",120,"ق",1,0],["وَما ساقَها من حاجَةٍ أجْحَفَتْ بهَا","إلَيْكَ، وَلا مِنْ قِلّةٍ في مُجاشِعِ",121,"ع",1,0],["وما سُنة ُ الشيطانِ سَنَّت بِبَذْلها","فواصِلَها بل سُنهُ الله سنَّتِ",122,"ت",1,0],["وما سألوا بينك ولا بنينا","ولا ألتفتوا إلى القوم الغضاب",123,"ب",1,0]]}