y.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[11,"هل الدهرُ إلا اليوم، أو أمسِ أو غدُ","https://www.poetsgate.com/ViewPoem.aspx?id=16837",""],[45,"مِنْ رِقْبَةٍ، أدَعُ الزّيارَةَ عَامِدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31346",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[51,"نفَّرتْ هِيفَك الليالي وغيدَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=28487",""],[51,"سَمْعا أبا إسحق إنك ماجدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30803",""],[51,"قد ذقتُ أنواعَ الطعوم فلم أجد","https://www.poetsgate.com/ViewPoem.aspx?id=30750",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""]],"verses":[["وَمَتى تُهُضِّمَ ضَيغَمٌ وَتَوَلَّعَت","بِحَيا الغُيوثِ أَنامِلُ النيرانِ",0,"ن",1,0],["وَمَتى يَكُن فيهِ سَقاكَ نَقيصَةً","أَبَدَ الزَمانِ تَمَمتَها بِالأَدمُعِ",1,"ع",1,0],["وَمَتى يُوَقِّع فَلَّ مِقنَبِها","لَم أُخلِها أَبَداً مِنَ المَدَدِ",2,"د",1,0],["وَمَتى تَدنُ الدِيارُ بِهِم","يَجِدوا قَلبي كَما عَهِدوا",3,"د",3,0],["وَمُتَّشِحٍ بِاللُّؤْمِ جَاذَبَني العُلا","فَقَدَّمَهُ يُسْرٌ وَأَخَّرَني عُسْرُ",4,"ر",1,1],["وَمَتى زَلَّ عَنْ لِساني مَديحٌ","هُوَ أَدْنَى مُروءَةِ الأَشْرافِ",5,"ف",1,0],["ومتَيَّمٍ شَرقَ اللِّحاظُ بدَمْعِهِ","فإذا اسْتَرابَ بهِ العواذِلُ غَيّضا",6,"ض",2,0],["ومُتَيَّمٍ زَهَرَتْ بواقِصَةٍ لهُ","مَشْبوبَةٌ تَقْتادُ طَرْفَ العاشي",7,"ش",2,1],["ومتى أصابَ ولا أصابَكَ حادِثٌ","مِما يُطامِنُ نَخوةَ الجبّارِ",8,"ر",1,0],["ومُتَيَّمٌ يُدمي مَقيلَ هُمومِهِ","وَجْدٌ يُضَرِّمُ نارَهُ الهِجْرانُ",9,"ن",1,0],["ومَتى أسَأْتَ إليهِمُ وخَبِرتَهُمْ","أُلْفِيتَ بعدَ إساءَةٍ لا تَندَمُ",10,"م",1,0],["ومَتى بَدا واللّيلُ ألْمَى رَدَّهُ","بِالبِشْرِ فهْوَ إذا تبلَّجَ أرْثَمُ",10,"م",1,0],["وَمَتَّعْتُ الْخَوَاطِرَ بِانْشِرَاحٍ","وَأَطْرَفْتُ النَّوَاظِرَ بِاكْتِحَالِ",11,"ل",1,0],["وَمَتَى سَرَتْ لِلْمُسْلِمِينَ سَرِيَّةٌ","أَبْدَى لَهَا التَّحْذِيرَ وَالتَّأْلِيبَا",12,"ب",2,0],["وَمِتُّ وَما ماتَت مَطامِعُ طامِعٍ","عَلَيها وَلا أَلقى القِيادَ ضَميرُ",13,"ر",1,0],["وَمَتى أَرى جَيشَ البِلا","دِ يَسُدُّ عَينَ الشَمسِ سَدّا",14,"د",2,0],["وَمَتى الخَلاصُ وَقَد وَرَدتَ مَوارِداً","هَيهاتَ عَن بُجرانِها أَن تَصدرا",15,"ر",2,0],["وَمَتى يَنالُ عُلاكَ مُجتَهِدٌ","هَيهاتَ أَينَ التُربُ مِن زُحَلِ",16,"ل",1,0],["وَمَتى يَبدَإِ الصَنيعَةَ يولِعكَ","تَمامُ الخِصالِ بِالتَتميمِ",17,"م",1,0],["وَمُتَّئِدٌ لَو زاحَمَ الطَودَ حِلمُهُ","لَحاجَزَهُ رُكنٌ مِنَ الطَودِ مُنهَدُّ",18,"د",1,0],["وَمَتنَي لَدنَةٍ سَمَقَت وَطالَت","رَوادِفُها تَنوءُ بِما وَلينا",19,"ن",2,0],["وَمُتَّ فَقيداً فَهيَ تَبكي بِعَولَةٍ","عَلَيكَ وَحُزنٍ ما تَجِفُّ عُيونُها",20,"ن",3,0],["وَمُتَّهَمٍ فِي غَفْلَةِ العَدْلِ وَاقِفٍ","مِنَ المَوْتِ بَيْنَ الأمْرِ والخُشَبِ البُكُم",21,"م",1,0],["ومتى نزلْتَ بمعقلٍ متأشِّبٍ","فالعُصْمُ من شعفاته تُسْتَنْزَلُ",22,"ل",1,0],["ومتى أزنك بمعشر وأزنهم","بك أُلْفِ وزنَك أرجح الأثقالِ",23,"ل",1,0],["ومتى يقصر عاذلي ورجاؤه","في مرِّ ذكرِكِ دائماً ورجائي",24,"ا",2,0],["ومتبع البرّ للعافي بتهنئةٍ","وسائق الهلك للعادي بإسجاح",25,"ح",1,0],["وَمَتى عَرَفتُ وِصالَها","حَتّى أَخافَ مَلالَها",26,"ل",3,0],["ومتى ما أردتَ قارض شعرٍ","كنتُ ممن يُساجلُ الشعراءَ",27,"ا",2,0],["ومتى ما خطبتَ مني خطيباً","جلَّ خطبي ففاق بي الخُطباءَ",27,"ا",2,0],["ومتى حاول الرسائلَ رُسْلي","بلَّغَتْني بلاغتي البُلغاءَ",27,"ا",2,0],["ومتى ما فزعتُ منك إلى الصَّبْ","رِ فناديتُه أجاب النداءَ",27,"ا",2,0],["ومتى ما دعوتُ ربي على الده","رِ وظلمِ الخُطُوب لبّى الدعاءَ",27,"ا",2,0],["ومتى امترى حلبَ الوصا","ل ملأتُ من هجر عِلابَهْ",28,"ب",2,0],["ومتى تَباعدَ مطلبٌ","فبِيُمْنهم نرجو اقترابهْ",28,"ب",2,0],["ومتى رام رائمٌ كخصوصي","قلتُ ما كلُّ دعوة تُستجابُ",29,"ب",1,0],["ومتى شئتَ أن تُعاودَ عاودْ","تَ وليس الغريبُ منك غريبا",30,"ب",2,0],["ومتى كان فتحُ بابٍ من اللَّ","ه توقعتُ منهُ إغلاق بابِ",31,"ب",1,0],["ومَتَّتْ إليك بذِمَّاتها","ومثلُكَ قدَّمَ إيجابَها",32,"ب",3,0],["ومتى أراد اللَّهُ قصَّرَ مدةً","وإذا قضى فأراد أمراً عَقَّبا",33,"ب",2,0],["ومتى تعذَّر مطلب في مالِهِ","فبجاهِهِ وبيُمنِهِ استنجاحُهُ",34,"ح",2,0],["ومتى رَدَدْتَ القيل في فَم قائلٍ","لَفَح الفؤادَ وحَقُّه أنْ يَلْفَحَا",35,"ح",2,0],["ومتى خِفْت من زمانيَ نحساً","أطلع الله لي بوجهك سعدا",36,"د",2,0],["ومتى ما رأيتَ وجهاً من الرأْ","ي رأى كلُّ سَيِّدٍ تقليدَكْ",37,"ك",1,0],["ومتى كان مأثَمٌ أو مَلامٌ","كان من خوف ذا وذاك عَديدَكْ",37,"ك",1,0],["ومتى نشاءُ بدت لنا","أم الفَرير أو الفريرُ",38,"ر",1,0],["ومتى شئت أن تألف نفسي","أُلِّفت وهي إن ظلمت نَوار",39,"ر",1,0],["ومتى وُعِظت بعلّةٍ فنضَوْتها","فاحذر فقد يُوفى البلاءَ الحاذر",40,"ر",1,0],["ومتى كسوتهمُ الهجا","ء فإنه بَهجٌ بلُبسِه",41,"س",2,0],["ومتى استُثير عُرامُه","لقي الأسود جهيزَ فَرسه",41,"س",2,0],["ومتى غرَّ عاملٌ ما تولّى","فهُمُ الهانئون بالخضْخاض",42,"ض",1,0],["ومتى هجَوْتَ مُعاتِباً لك مُنصِفاً","فلديهِ عزم في هجائك ماضي",43,"ض",2,0],["ومتى نَفَحْتَ من الهِجاء بنفحةٍ","عالت فريضتُها على الفُرَّاض",43,"ض",1,0],["ومتى رأوْا دِيكاً ولو من فرْسخٍ","أبصرتَهُم يعْدُونَ عدوَ مُبالط",44,"ط",1,0],["ومُتِّعتَ بالعمر الطويل محكَّماً","ولا زلتُ بالإنصاف منك ممتعا",45,"ع",2,0],["ومتى كذبت فتلك شرهما","والإفك يجمع مأثماً وضعه",46,"ع",2,0],["ومتى أنحى عليه جماع","عدَّ أن قد كان منه الجماع",47,"ع",1,0],["ومتى أصابك منه رقُّ صنيعةٍ","فكطوق زين لا كغُلِّ وثاق",48,"ق",1,0],["ومتى خانك صبرٌ","فاجتلب ماء المآقي",49,"ق",2,0],["ومتى أقالكَ فاخْشَ سَطْوَتَه","فهْوَ القديرُ إذا تطلَّبَكا",50,"ك",2,0],["ومتى شِئْتَ أنْ تزيدَ فماذا","يمنعُ الغيثَ أن يَسُحَّ السّجالا",51,"ل",2,0],["ومتى قلتُ باطلاً لم أُلقَّب","فيلسوفاً ولم أسوّم هِرَقْلا",52,"ل",2,0],["ومتى وردْتُ حياضهم معهم","لم يشْربوا صفواتها قبلي",53,"ل",2,0],["ومتى اعتصَمْتُ بهم فهم جبلي","ومتى رعيتهمُ فهُم سَهلي",53,"ل",2,0],["ومتى صفدْتُ ففضلهُم صفدي","ومتى أجرْتُ فحبلُهم حَبْلي",53,"ل",2,0],["ومتى دعوتُهمُ لنائبةٍ","حَدِبوا عليّ ولم يَرَوْا خَذْلي",53,"ل",2,0],["ومتى طاوعتْ فذاك طِباعٌ","ومتى مانَعَتْ فذاك تدلُّلْ",54,"ل",1,0],["ومُتّعَ بابنْيهِ وبالسُّؤْلِ فيهما","لتكرمَ أفعالٌ وتحسُنَ أقوالُ",55,"ل",1,0],["ومتى ما لقيتَه كان غيثاً","أمرَتْه الجنوبُ بالتهطالِ",56,"ل",1,0],["ومتى يقومُ بحق مدحك شاعرٌ","حتى يُرى في كلّ وادٍ هائما",57,"م",2,0],["ومتى استربت بخُلَّةٍ معْوَجَّةٍ","فتتبع العوجاءَ بالتقويمِ",58,"م",1,0],["ومتى لم تكن سجيتُك الغُر","م إذا خيف من زمانٍ غَرامُ",59,"م",1,0],["ومتى ما انقضتْ أجاريُّ طِرْفٍ","ماتَ إلا صيامَه في المصام",60,"م",1,0],["ومتى ما غدتْ وقد شتَمتْنِي","باحتقارٍ فإنها المشتومه",61,"م",2,0],["ومتى ما سمعتَ منها فَشَدْوٌ","يطرد الهمَّ عنك والأحزانا",62,"ن",2,0],["ومتى ما لثمتَ فاها فشيْءٌ","تجد الراحَ فيه والريحانا",62,"ن",2,0],["ومتى خلفتُ أخي هناك فإنما","أنا روحُه إن لم أكن جثمانَهُ",63,"ن",2,0],["ومتى راغ بشكرٍ رائغٌ","ذات يوم لم تجده شَجَنَه",64,"ن",2,0],["ومتى اختلَّ ابن روميِّكمُ","فأَياديكم حَرىً منه قَمَن",65,"ن",1,0],["ومتى شجاك مُهجَّنٌ فاغفِرْ له","حتى يروحَ مكذَّبَ التهجين",66,"ن",1,0],["ومتى غدوتَ لديكَ شَرُّ صنيعةٍ","فاعلم بأن الطَّول خير خَدين",66,"ن",1,0],["ومتى لم تعفُ عن ذي هفوةٍ","مَرَد القلبُ عليها ومَرَن",67,"ن",1,0],["ومتى لاحظْتَهُ في مجلس","ضربَ الزَّوْرُ ذليلاً بالذَّقن",67,"ن",1,0],["ومتى شَرِهْتَ فإن أيسرَ لذَّةٍ","لك إن نظرتَ مع السلامةِ كافيه",68,"ف",3,0],["ومتِّع العين بها مَليَّا","وأطبق الخبزَ وكلْ هنيّا",69,"ي",2,0],["وَمَتلَفٍ مِثلِ فَرقِ الرَأسِ تَخلِجُهُ","مَطارِبٌ زَقَبٌ أَميالُها فيحُ",70,"ح",1,0],["وَمُترَعَةٍ كَأَنَّ الوَردَ فيها","كَواكِبُ لَيلَةٍ فَقَدَت غَماما",71,"م",2,1],["وَمُتَّسِقٍ كَالنورِ مِن كُلِّ صِبغَةٍ","يُضيءُ الدُجى بَينَ التَرائِبِ وَالنَحرِ",72,"ر",1,0],["وَمَتى جَهِلتَ قَضِيَّةً","وَأَرَدتَ تَعلَمُها فَسَلني",73,"ن",2,0],["وَمَتى يَومُ وَفاتي","لَيتَني لَو كُنتُ أَدري",74,"ر",2,0],["وَمَتى أَخلُصُ مِمّا","أَنا فيهِ لَيتَ شِعري",74,"ر",2,0],["وَمَتى أَجِئهُ في الشَدائِدِ مُرمِلاً","أُلقي الَّذي في مُزوَدي لِوِعائِهِ",75,"ا",3,0],["وَمُت كَريماً أَو ذُقِ الهَوانا","وَعَبثَ الغِلمان مِن مَروانا",76,"ن",2,0],["وَمُتِّعتُ بِالدُنيا ثَمانينَ حِجَّةً","وَنَضَّرَ أَيّامي غِنىً وَحُبورُ",77,"ر",1,0],["وَمَتى تُساسُ بِهِ الرِيا","ضُ كَما تُساسُ بِهِ الوُكور",78,"ر",1,0],["وَمَتى وَنَت وَأَبو المُظَفَّرِ أَمُّها","فَأَتاحَ لي وَلَها الحِمامَ مُتيحُ",79,"ح",1,0],["وَمُتَّقٍ وَالسِهامُ مُرسَلَةٌ","يَحيدُ عَن حابِضٍ إِلى صارِد",80,"د",1,0],["وَمَتى يُؤَدّي شَرحَ حالِكَ ناطِقٌ","حَفِظَ القَليلَ النَزرَ مِمّا ضَيَّعا",81,"ع",2,0],["ومتاجرٍ بي في المودَّةِ كلَّما","حاسبتُه يغلو عليَّ وأرخُصُ",82,"ص",1,1],["وَمَتى تُغالِب في المَكارِمِ وَالنَدى","بِالتَغلِبِيّينَ الأَكارِمِ تَغلِبِ",83,"ب",1,0],["وَمَتى كُنتُ صاحِباً لِذَوي السُؤ","دُدِ يَوماً فَإِنَّهُم أَصحابي",84,"ب",2,0],["وَمَتى ما أَنشَدتَ شِعرَكَ لَم يُعدِم","كَ قَذفاً لِوالِدَيكَ النَشيدُ",85,"د",1,0],["وَمَتى يُساعِدُنا الوِصالُ وَدَهرُنا","يَومانِ يَومُ نَوىً وَيَومُ صُدودِ",86,"د",1,0],["وَمَتى سَأَلتَ عَنِ اِمرِئٍ أَخلاقَهُ","صَدَقَت عَلَيهِ أَدِلَّةً وَشَواهِدا",87,"د",2,0],["وَمَتى رَجَعتَ إِلَيهِ شاكِرَ نَيلِهِ","رَجَعَت مَصادِرُ ما أَنالُ مَوارِدا",87,"د",2,0],["وَمَتى يَهيجُ مَعاشِرٌ تَرعاهُمُ","عَلِقوا بِشَغبِ وَساوِسِ الخَنّاسِ",88,"س",1,0],["وَمَتى عُدتَني وَجَدتَ التَصابي","مِن شَكاتي وَالحُبَّ مِن أَوجاعي",89,"ي",1,0],["وَمَتى اِرتَدتَ أَينَ تَجعَلُ رِقّاً","فَليَنَل رِقَّكَ الأَشَفُّ الأَشَفُّ",90,"ف",1,0],["وَمَتى وَجَدتَ الناسَ إِلّا تارِكاً","لِحَميمِهِ في التُربِ أَو مَتروكا",91,"ك",2,0],["وَمَتى عَرَضتَ لِشُكرِهِ فَالبُرجُ مِن","تُبَلٍ عَلى ثَبَجِ الثَناءِ ثَقيلِ",92,"ل",1,0],["وَمَتى رُمتُ نُصرَةً مِن شَفيعي","فَشَفيعي عَن نُصرَتي مَشغولُ",93,"ل",1,0],["وَمَتى نَسيتُ فَلَستُ أَنسى قَولَها","صِلنا بِكُتبِكَ رَأسَ كُلِّ هِلالِ",94,"ل",1,0],["وَمَتى تَستَعِن بِيونُسَ تُرفَد","بِعَظيمٍ يَكفيكَ شَأنُ العَظيمِ",95,"م",1,0],["وَمَتى شِمتَ غَيمَهُ لَم تُهَجِّن","صَوبَ شُؤبوبِهِ الأَجَشِّ الهَزيمِ",96,"م",1,0],["وَمَتى ضَمِنتُ عَلَيكَ حاجَةَ طالِبٍ","كَفَلَت يَداكَ بِذِمَّتي وَضَماني",97,"ي",1,0],["وَمَتى رَآكَ الناسُ تَحرِمُهُ اِقتَدَوا","بِكَ غَيرَ مُرتابينَ في حِرمانِهِ",98,"ن",2,0],["وَمَتى مَدَّ كَفَّهُ نالَ أَقصى","ذَلِكَ السُؤدُدِ البَعيدِ الَشَسوعِ",99,"ع",1,0],["وَمُتَّخِذٌ مِنّا أَباً مِثلَ غالِبٍ","وَكانَ أَبي يَأتي السِماكَينِ مِن عَلِ",100,"ل",1,0],["ومتَى رأَى آثارَ حَيٍّ نازحٍ","حَيَّا وقالَ سُقِيتَ أَوبةَ راحلِ",101,"ل",1,0],["ومتَى أنلْتَ على القَريضِ فإننَّي","ربُّ القريضِ وأنتَ ربُّ النائِلِ",101,"ل",1,0],["ومتَى شَكَتْ أعضاءُ جِسْمِكَ عِلَّةً","فدواؤُهُنَّ قِراعُكَ الفَتَّاكا",102,"ك",2,0],["ومتَى أمالوها لِرَشْفِ رُضابِها","أداَّهُ فُوها وهي لا تَتَمنَّعُ",103,"ع",1,0],["ومُتعِبٌ في طِلابِ المجدِ همَّتَه","مُواصلٌ للسُّرى فيه بإدلاجِ",104,"ج",1,0],["وَمَتى شِئتَ أَن تُطَعَّمَ بِالذِل","لِ فَرُم ما حَوَتهُ أَيدي الرِجالِ",105,"ل",1,0],["وَمَتى ما تَتَرَجَّح في المُنى","تَتَعَرَّض لِمَضَلّاتِ الفِتَن",106,"ن",1,0],["ومتاعاً لعيوني","وشميمي وسماعي",107,"ي",1,0],["ومتى المآب إلى رحابك مرة","لأريك جرحي والدما والخنجرا",108,"ر",2,0],["ومتى هابَ موقداً نارَ حَرْبٍ","فارساً في المُضَاعَفِ الفارسيِّ",109,"ي",1,0],["ومُتّخِذي قُمْص الحديد ملابساً","إذا نَكَلَ الأبطال في الحرب أقدموا",110,"م",3,0],["وَمُتَّ حَيّاً بِلِحيَةٍ طَلَعَت","عَلَيكَ قَد كُنتَ قَبلَها مَلَكا",111,"ك",2,0],["وَمَتى يُخَيِّم في اللِقاءِ عَناؤُها","فَعَناؤُها يَطوي المَراحِلَ في اليَدِ",112,"د",1,0],["وَمَتى حَلَلتَ بِهِ أَنالَك جُهدَهُ","وَوَجَدتَ بَعدَ الجُهدِ فيهِ مَزيدا",113,"د",2,0],["وَمَتى اِمتَدَحتُ سِواكَ كُنتُ مَتى يَضِق","عَنّي لَهُ صِدقُ المَقالَةِ أَكذِبِ",114,"ب",1,0],["ومتقي اللهِ منَّا مهملٌ حرجٌ","مروَّعُ القلبِ محمولٌ على الكربِ",115,"ب",1,0],["وَمَتى أَرى أُمَمَ البَسيطَةِ أُخوَةً","كُرَماءَ لا إِحَنٌ وَلا أَحقادُ",116,"د",1,0],["وَمَتى يَرُدُّ الحائِرينَ إِلى الهُدى","نَهجٌ أَسَدُّ وَكَوكَبٌ لَمّاحُ",117,"ح",1,0],["وَمِتَّ مِن قَبلُ وَجداً","فهل مَحا الموتُ وَجْدَكْ",118,"ك",1,0],["ومتوَّجٍ حالتْ أشعَّةُ","تاجهِ دونَ العيانِ",119,"ن",1,0],["وَمُتَيَّمٍ جَرَحَ الفُراقُ فُؤادَهُ","فَالدَمعُ مِن أَجفانِهِ يَتَدَفَّقُ",120,"ق",1,1],["وَمَتى تَشَأ في الحَربِ تَلقَ مُؤَمَّلاً","مِنّا مُطاعاً في الوَرى مَتبوعا",121,"ع",2,0],["وَمَتى يَرُمها الرائِمونَ فَبادِروا","هاماتِهِم حَصداً بِكُلِّ مُهَنَّدِ",122,"د",1,0],["ومتى يَسْتَقيمُ قَلْبِي ولِلْجِسْ","مِ اعْوِجَاجٌ مِنْ كَبْرتي وانْحِناءُ",123,"ا",2,0],["ومُتّصِلٍ بينَ الإلهِ وبيْنَهُ","مُمَر من الأسْبابِ لم يَتَصَرَّم",124,"م",1,0],["ومُتّقِداتٍ تُذيبُ الشّلِي","لَ من فوقِ لابِسِه في الوغى",125,"ا",1,0],["وَمُتَرَّفٍ عَقَلَ الحَياءُ لِسانَهُ","فَكَلامُهُ بِالوَحيِ وَالإيماءِ",126,"ا",2,1],["وَمُتَّخِذٍ دينَ النَصارى عِبادَةً","يَرى أَنَّهُ فيهِ مُصيبُ رَشادِ",127,"د",1,0],["وَمُتَّصِلٍ بِأَسبابِ المَعالي","لَهُ في كُلِّ مَكرُمَةٍ قَديمُ",128,"م",1,0],["ومتّعِ النفسَ ممّا سوف تفقدهُ","عمّا قليلٍ وبادر وثبةَ الأجَلِ",129,"ل",1,0],["وَمُتَوَّجٌ عَصَفَت بِهِ أَيّامُهُ","وَبَناتُ أَيمٍ كُلُّهُنَّ عَقورُ",130,"ر",1,0],["وَمَتى تَذكُري الصُدو","دَ أُعَوِّل وَأَنشِجِ",131,"ج",1,0],["وَمَتى طَرَدتَ أُمورَها بِقِياسِها","فَأَحَقُّها بِمَذَلَّةٍ طَمِعاتُها",132,"ت",3,0],["وَمَتى ذَكَرتُ مُحَمَّداً وَكِتابَهُ","جاءَت يَهودُ بِجَحدِها وَكِتابِها",133,"ب",3,0],["وَمَتّى رُزِقتَ شَجاعَةً وَبَلاغَةً","أَوطَنتَ مِن رَبعِ العُلى بِمُشَيَّدِ",134,"د",1,0],["وَمَتَى سَرى عَن أَربَعينَ حَليفُها","فَالشَخصُ يَصغُرُ وَالحَوادِثُ تَكبَرُ",135,"ر",1,0],["وَمَتّى نَزَعتَ لِحِلفِ روحٍ هامَةً","فَهُوَ الرَدى عَمداً بِغَيرِ شِجارِ",136,"ر",1,0],["وَمَتّى شاءَ الَّذي صَوَّرَنا","أَشعَرَ المَيتَ نُشوراً فَنَشَر",137,"ر",1,0],["وَمَتّى رَكِبتَ إِلى الدِيانَةِ غالَها","فِكَرٌ عَلى حُسنِ الضَميرِ دَسائِسُ",138,"س",1,0],["وَمَتّى رَضيتَ بِصاحِبٍ مِن أَهلِها","فَلَقَد مُنيتَ بِكاذِبٍ مَلّاقِ",139,"ق",1,0],["وَمَتى حَظَيتَ بِنِعمَةٍ مِن مُنعِمٍ","فَتَوَقَّ وَاِحذَر صَولَةً مِن صائِلِ",140,"ل",1,0],["ومتَى ما يَعِ منكَ كلاماً","فتكَلَّم فيجِبْكَ بعَقلِ",141,"ل",1,0],["ومتى غِبْتَ ظاهِراً من عياني","أُلفِهِ نحوَ باطني ألقاكا",142,"ك",2,0],["ومتى لاحَ لي اغتَفَرْتُ سُهادي","ولعَيْنَيّ قُلْتُ هذا بِذاكا",142,"ك",2,0],["ومتى أشكُ جِراحاً بالحشا","زِيدَ بالشكوى إليها الجُرحُ كَي",143,"ي",1,0],["ومتَى ما سِرَّ نجْدٍ عَبَرَتْ","عَبّرَتْ عن سِرِّ مَيٍّ وأُمَيّ",143,"ي",1,0],["ومتّقٍ والسّهام مرسلةٌ","يحيص عن حابضٍ إلى صارد",144,"د",1,0],["ومتى خَلَوْتُ بها من أَجْلِكِ لم أُرَعْ","فيها بطَلعَةِ عاذِلٍ من مَرْقَب",145,"ب",1,0],["ومُتْرِكُنَا أُميّةَ مُجْلَعِبّاً","وَفِي حَيزُومِهِ لَدْنٌ نَبِيلُ",146,"ل",1,0],["وَمتى يُنَادِ إلى الشّدائدِ نَأْتِها","وَمَتَى نَرَ الحَوْمَتِ فيها نُعْنِقِ",147,"ق",1,0],["ومتى يجهل مليك فاجهل","نم على صهوته أو لا تنم",148,"م",1,0],["ومتى تؤيد بالرعاع حكومة","كانت أحطَّ من الرعاع نفوسها",149,"س",3,0],["ومتى يحاول حجب مكنوناته","يلبس محياه حجاب نفاق",150,"ق",1,0],["ومتى ينهض عزيز فارده","ومتى يجهل مليك فاجهل",151,"ل",1,0],["ومتعسف بالرمح، دونَ صحابهِ،","تَعَسّفْتُهُ بالسّيفِ، والقَوْمُ شُهّد",152,"د",1,0],["وَمتى سألْتَ عَنِ امرِىءٍ أخلاقَهُ،","صَدَقَتْ عَلَيْهِ أدِلّةً وَشَوَاهِدَا",153,"د",2,0],["ومتني كدنةٍ سمقت وطالت","روادفُهُا تنُوءُ بما ولينا",154,"ن",2,0],["ومتى كان مأثمٌ أو ملامٌ","كان من خوف ذا وذاك عيدك",155,"ك",1,0],["ومتى شجاك مُهجَّنٌ فاغفِرْ له","حتى روحَ مكذَّبَ التهجين",156,"ن",1,0],["ومتى شَرِهْتَ فإن أيسرَ لدة","لك إن نظرتَ مع السلامة ِ كافيهْ",157,"ف",3,0],["ومتى امترى خلفَ الوصا","ل ملأتُ من هجر عِلابَهْ",158,"ب",2,0]]}