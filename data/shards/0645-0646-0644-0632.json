{"poems":[[51,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[51,"من سالم الناس سلم","https://www.aldiwan.net/poem63111.html","مجزوء الرجز"],[567,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46560","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46551","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125377","الخفيف"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143091","السريع"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109855","الخفيف"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123529","الرجز"],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""]],"verses":[["مَن لَزِمَ الحِقدَ لَم يَزَل كَمِداً","تُغرِقُهُ في بُحورِها الكُرَبُ",0,"ب",1,0],["مَن لَزِمَ الصَمتَ نَجا","مَن قالَ بِالخَيرِ غَنِم",1,"م",1,0],["من لزَهرِ الرُّبى بحُسنِ مُحيّا","هُ وزُهرُ النُجومِ لا تَحْكيهِ",2,"ي",2,0],["من لَزم الطريقه","صارَت لَهُ خَليقه",3,"ه",1,0],["مَن لَزم القَناعه","كانَت لَهُ بِضاعه",4,"ه",1,0],["مَن لَزِمَ المياسره","صفت لَهُ المُعاشره",4,"ه",1,0],["من لِزُهرِ النُّجُومِ يُصبِحُ منها","لكِ قُرطٌ أو حليةٌ فوقَ هامِك",5,"ك",1,0],["من لزم الصمت اكتسى هيبة","تخفي عن الناس مساويه",6,"ه",1,1],["من لزين العباد إذا صفدوه","بقيود وأوثقوه أسيرا",7,"ر",2,0],["من لزهر النجوم يصبح منها","لك قرط او حلبة فوق هامك",8,"ك",1,0],["من لزِم السِّلْمَ من الحرب سَلِمْ","ومَن أبَى إلاَّ هوَى النفسِ نَدِمْ",9,"م",1,0],["من لزم الغرور في أموره","فما عليه إن هوى وإن خوى",10,"ا",1,0]]}