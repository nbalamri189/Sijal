{"poems":[[55,"يقر بعيني أن أرى لك منزلا","https://www.aldiwan.net/poem30723.html","الطويل"],[55,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[89,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[89,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[89,"مَحَا الْبَيْنُ مَا أَبْقَتْ عُيُونُ الْمَهَا مِنِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23864&r=&rc=126",""],[139,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[266,"لكل من الدنيا مرام يحده","https://www.aldiwan.net/poem38188.html","الطويل"],[275,"أصاحب لا تعذليه سلام","https://www.aldiwan.net/poem35591.html","المتقارب"],[310,"إلهي إن قصدي من قصيدي","https://www.aldiwan.net/poem56561.html","الوافر"],[333,"أصامت أنت أم نشوان يا قلمي","https://www.aldiwan.net/poem54960.html","البسيط"],[354,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[454,"أثر النكسة 1967","https://www.aldiwan.net/poem992.html",""],[556,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64344","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16938","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61041","الوافر"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122017","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76610","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28534","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133994","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107537","المتقارب"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77696","البسيط"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5650,"غوايةُ الموجِ الغَدور","https://www.poetsgate.com/ViewPoem.aspx?id=177956",""],[454,"أثر النكسة 1967","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82664&r=&rc=28",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""]],"verses":[["وَأَيُّ حَبيبٍ غَيَّبَ النَأيُ شَخصَهُ","وَحالَ زَمانٌ دونَهُ وَخُطوبُ",0,"ب",1,0],["وَأَيَّ حُسامٍ أَغمَدوا في ضَريحِهِ","كَهَمَّكَ لا يَعصى بِهِ اليَومَ ضارِبُ",1,"ب",1,0],["وَأَيُّ حُسَامٍ لَمْ تُصِبْهُ كَهَامَةٌ","وَلَهْذَمُ رُمْحٍ لا يُفَلُّ مِنَ الطَّعْنِ",2,"ن",1,0],["وَأَيُّ حَيَاةٍ لاِمْرِئٍ بَيْنَ بَلْدَةٍ","يَظَلُّ بِهَا بَيْنَ الْعَوَاثِنِ وَالدَّخْنِ",2,"ن",1,0],["وَأَيُّ حَيَاةٍ بَعْدَ أُمٍّ فَقَدْتُهَا","كَمَا يَفْقِدُ الْمَرْءُ الزُّلالَ عَلَى الظَّمَا",3,"م",2,0],["وأيُّ حياةٍ كحُلمٍ سرى","سُري البرق لألأ ثُمَّ انطوى",4,"ط",3,0],["وأيّ حبٍّ أليف منك أو وطنٍ","وأيّ جهل لما نلقاه من ألم",5,"م",1,0],["وَأَيُّ حَيٍّ وَإِنْ طَالَتْ سَلامَتُهُ","يَبْقَى وَأَيُّ عَزِيزٍ لَيْسَ يُمْتَهَنُ",6,"ن",1,0],["وَأَيُّ حَيَاةٍ لاِمْرِئٍ إِنْ تَنَكَّرَتْ","لَهُ الْحَالُ لَمْ يَعْقِدْ سُيُورَ الْمَنَاطِقِ",7,"ق",1,0],["وَأَيُّ حُسَامٍ لَمْ تُصِبْهُ كَلالَةٌ","وَأَيُّ جَوَادٍ لَمْ تَخُنْهُ الْحَوافِرُ",8,"ر",1,0],["وَأَيُّ حَيَاة ٍ لاِمْرِىء ٍ بَيْنَ بَلْدَة ٍ","وَتَسْمَعُ أُذْنِي مَا تَعَافُ مِنَ اللَّحْنِ",9,"ن",1,0],["وَ أيُّ حياة ٍ لامرئٍ بينَ بلدة ٍ","يَطَلُّ بِهَا بَيْنَ الْعَوَاثِنِ وَالدَّخْنِ؟",9,"ن",1,0],["وأيّ حُسن عداه نثره زمناً","وأيّ سحر دعاه شعره فأبى",10,"ب",2,0],["وَأَيُّ حِمىً أَباحوا يَومَ باحوا","بِما كَتَمَتهُ في السِلمِ العُمودُ",11,"د",1,0],["وأي حمى للمرء يستر عرضه","إذا عافه في الأمر خوف حمام",12,"م",1,0],["وأيُّ حشىً لا تذوبُ على","قوافيكَ وهي دَوامي السِّهام",13,"م",1,0],["وَأيّ حشاشةٍ لا يَزدهيها","مَديحُ نبيّها نور الوجودِ",14,"د",1,0],["وأيّ حال على الأيّام باقية","أم أيّ عهد شباب غير منصرم",15,"م",1,0],["وَأَيُّ حَياةٍ يُنعِمُ البالُ طولُها","وَدونَ المِنى لِلمَرءِ الَّذي مَدَّها قَصرُ",16,"ر",1,0],["وأَيُّ حياً فِي الشَّرْقِ والغربِ للوَرى","وأَيُّ حِمىً للملكِ والدِّينِ والدُّنيا",17,"ي",2,0],["وأي حياة عز نرتجيه","إذا ركعت عروبتنا لضيم",18,"م",1,0],["وأيُّ حلالٍ قبلما أنت فاعلٌ","رأيناهُ لم يمزِجْهُ بعضُ حرامِ",19,"م",1,0],["وأي حسن لغير صب","من يرقان يحل ماقه",20,"ق",2,0],["وَأَيُّ حُسامٍ لَيسَ يَنبو وَيَنثَني","وَأَيُّ جَوادٍ لَيسَ يَكبو وَيَظلَعُ",21,"ع",1,0],["وَأَي حَياة نَفس لَم يَخنها","عَلى مَر الليالي وَالدهور",22,"ر",1,0],["وَأَيُّ حُسَامٍ طَوْع يُمْنَاكَ مُصْلَت","بِهِ كُلُّ حُرٍّ فِي المَآزِقِ بَائِخُ",23,"خ",1,0],["واي حياء طيه أي سورة","كما كمنت في الروض دهم الاراقم",24,"م",1,0],["وَأَيُّ حُسامٍ فَلَّ رَأيُكَ حَدَّهُ","وَقَد كانَ يَفري وَالقَواضِبُ لا تَفري",25,"ر",2,0],["واي حوى علما لكل بلا خفا","وماذا الذي يأوى ومن جابر الكسر",26,"ر",1,0],["وأي حياة للكريم إذا رآى","دناة الورى أرباب أهل المساجد",27,"د",1,0],["وأي حسن من الإحسان احسن من","اسكان دار صفا العرفان منشيها",28,"ي",3,0],["وأي حبيبٍ إذا ما بدا","تقول مليكٌ رفيع اللوا",29,"ا",1,0],["وَأَيّ حالٍ عَلى الأَيّام باقية","فَبادر السَير وَاِعلم أَنَّها قُلَعُ",30,"ع",1,0],["وأي حليم ذئبكم ناش لحمه","وصان قميصا وهو ينتاشه خضما",31,"م",2,0],["وأَيُّ حضارةٍ نَرنو إليها","إذا ما الحلْمُ تَلفحُهُ السّعيرُ",32,"ر",1,0],["وأي حياة عز نرتجيها","إذا ركعت عروبتنا لضيم",33,"م",1,0],["وأَيُّ حَياةٍ دونَ ذلك تُرْتَجى","إذا انتزَعْتني مِنْ ضُلوعي المطَامِعُ",34,"ع",1,0]]}