/diwan/poem/110134","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117843","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36734","الخفيف"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102934","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90851","البسيط"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72587","الرمل"],[4691,"حُبّهَا شَادٍ بِقَلْبِي غَرّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=75080",""],[4764,"عروس الموت","https://www.poetsgate.com/ViewPoem.aspx?id=27726",""],[4875,"باقة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=133358",""],[4883,"الأطفال عصافير","https://www.poetsgate.com/ViewPoem.aspx?id=48370",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5677,"(بتزين باكر)","https://www.poetsgate.com/ViewPoem.aspx?id=139686",""],[402,"مجد تسلسل كابرا على كابر","https://www.poetsgate.com/ViewPoem.aspx?id=35718",""],[5848,"لا تشكي اليتم","https://www.poetsgate.com/ViewPoem.aspx?id=48975",""],[5956,"أبطال فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192326",""],[5956,"شكراً لقد أدَّيتِ ما يجبُ","https://www.poetsgate.com/ViewPoem.aspx?id=207557",""],[6008,"الحب بلوى","https://www.poetsgate.com/ViewPoem.aspx?id=60800",""],[6056,"الشمس والفيّ","https://www.poetsgate.com/ViewPoem.aspx?id=130382",""],[6115,"على شأن مايشره عليه خيار الناس","https://www.poetsgate.com/ViewPoem.aspx?id=181444",""],[5309,"يبدع العاملون شيئا مفيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573908",""],[2220,"ولتقوموا إذا وصلتمْ إليهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11820&r=&rc=689",""]],"verses":[["مَعهَداً لِلدينِ يُسقى غَرسُهُ","مِن نَميرٍ فاضَ مِن ذاكَ القَليبِ",0,"ب",1,0],["معهد العلم وهو حِرزٌ يفوق ال","أبلقَ الفرد مَنعةً وحرازه",1,"ز",2,0],["معهد طالما نعمت وعيشي","مستماح اليدين غير ضنين",2,"ن",1,0],["مَعهُ صبوةُ الفتى وعليه","صَرفة الشيخ فهْو في تعذيبِ",3,"ب",1,0],["مَعَهُ مُتابِعَةٌ إِذا هُوَ شَدَّها","بِالشِرعِ يَستَشزي لَهُ وَتَحَدَّبُ",4,"ب",1,0],["مَعْهَدٍ مِن عهْدِ أجفاني على","جيدِهِ مِن عِقْدِ أزهار حُلَي",5,"ي",1,0],["معهدي هذه المروجُ وأستَا","ذي ربيعُ الطبيعةِ الفينانَه",6,"ن",2,0],["مَعَهَا إِذَا عَبَسَ الزَّمَانُ بَشَاشَةٌ","وَبِهَا إِلى الأَحْدَاثِ لَفْتَةُ سَاخِرِ",7,"ر",1,0],["مَعْهَدٌ لاَ يُشَادَ فِي وَطَنٍ إِلاَّ","وَفِيه لِلْمَجْد أَسْمى مُرَادِ",8,"د",1,0],["مَعْهَدُ التْوفِيقِ يَسْتَنْ","فِدُ لِلْخَيْرِ الجهُودا",9,"د",2,0],["معه جنودٌ من ملا","ئكة السماءِ مسوَّمين",10,"ن",1,0],["معها \" بعتِ \" خفةً ومُجونا","ومعي \" بِعتِ \" عفّةً ورزَانه",11,"ن",2,0],["مَعَهُ الحَزْمُ، وَهوَ من شدّةِ الإقْ","دامِ يُخشَى تَغرِيرُهُ، وَخِطارُهْ",12,"ر",2,0],["معهُ كسَّرتُ قلباً ضمَّهُ","فأنا الكاسِرُ قلبي بيَدَي",13,"ي",1,0],["معها مال وقد هام بها","وله من زهرةِ الحدرِ نصيب",14,"ب",1,0],["مَع هيبةٍ وسكينةٍ وصرامةٍ","وَسياسةٍ يعطي بها يمنعُ",15,"ع",1,0],["معْه ملوكُ مجوسٍ معْهم حُللٌ","وتُحفةٌ سُجَّداً في أفخر الحلل",16,"ل",1,0],["معْهم هداياً ليأتوا ساجدين بها","ويشهدوا ملكَ الأحياء إن ساروا",17,"ر",3,0],["معهن سارت بعض روحي فاذكري","ما أن نظرت جمالهن أباك",18,"ك",1,1],["معهدُ لهوٍ شفَّني","بعدَ المها تأبُّدُهْ",19,"د",2,0],["مع هذا فهموا منه الخطا","ولهم قطع به من غير لَيّ",20,"ي",1,0],["معه ما لنا وجود لأنا","قد وجدنا به إذا الجهل عيفا",21,"ف",2,0],["معهن قد خلع العذار فويله","من ميسر مع مسكر ونساء",22,"ا",2,0],["معهدٌ قد لقيتُ في جانبيه","عَطفَ أُمٍ على الوليدِ وحيدا",23,"د",2,0],["مَعَهُم ضوارٍ مِن سَلوقَ كأنها","حُصنٌ تجول تُجرِّرُ الأَرسانا",24,"ن",2,0],["معهدي للشباب وَهُوَ مشيب","لَن يراع وَما وَعى تضلالا",25,"ل",2,0],["معهد أصبو إليه كلما","عنّ لي برق باكناف الحمى",26,"م",2,0],["معه سائق له وشهيدٌ","وعلى الحرص ويحه إكبابه",27,"ب",2,0],["معهد العلم نهنه الدمع حينا","فلقد صرت للبكاءِ عيونا",28,"ن",2,1],["معهم يولد النهى فترى اليا","فعَ كهلاً والكهلَ شيخاً كبيرا",29,"ر",2,0],["معهد لي فيها وإن شطت النوى","هوىً بين أحناء الضلوع يجول",30,"ل",1,0],["معه لله فما أشغله","عنه بالضيق عليه في الحجر",31,"ر",1,0],["مَعَهُ سِقاءٌ لا يُفَرِّطُ حَملَهُ","صُفنٌ وَأَخراصٌ يَلُحنَ وَمِسأَبُ",32,"ب",1,0],["مع هذا عزمهم لم ينثن","بل علوا بالعلم هام الزُهر",33,"ر",1,0],["معهد للرباب سقيا لعهدي","في رباه، سقته ذات الرباب",34,"ب",1,0],["معهد يعبق النسيم برياه فيس","ري والطيب في أردانه",35,"ن",2,0],["مع هذا فقلت عبد نقي","وسِعَ الحقُّ بالنصوصِ المتينا",36,"ن",2,0],["مَعَ هَذِهِ الأنوَاعِ وَانظُر أيُّهَا","أولَى لَدَى المِيزَانِ بِالرُّجحَانِ",37,"ن",1,0],["معها الكتاب الشكوالي الذي","هو بهجة الأسماع والأبصار",38,"ر",1,1],["معهدٌ كم بتُّ فيه أجتني","من خدودِ الخرّد العُرب ورودا",39,"د",2,0],["مَع هَؤلاَء المُكلِيينَ السُّفَالى","وَمَعدَنُ النُّوبَةِ لَهُم يُوالى",40,"ل",2,0],["مَعهَدٌ قد عاهَد القلبَ جوىً","في رُباهُ بالهوى عهداً وثيق",41,"ق",1,0],["مع هذه الأوصاف والمعاني","في أرخص الأسعار والأثمان",42,"ن",1,0],["مع هذه الفجيعة الوجيعة الشنيعة","الفضيعة تزلزل ركن الأحكام",43,"م",1,0],["معهد أنس للنفس فيه هوىً","المم عليه مكان المامي",44,"م",2,0],["معهدا هذب النفوس واضحى","مأملا يرتجى لفك القيود",45,"د",1,0],["معها كتاب مرسل لقريش من","بعض الجماعة مخبراً بالغزوة",46,"ه",1,0],["معهم سكنت ببيت شعر واحد","لكن نعيش كأننا غرباء",47,"ا",2,0],["معهد الانس في بلادي أضحى","مأتم الحزن فلأعُدْ لاغترابي",48,"ب",2,0],["معهد التعليم أجهدتَ الذي","كان يبغي السوءَ ظُلماً فَخَمَد",49,"د",1,0],["معهدها ذكرى لبث علومها","وديوانها ذكرى لصون الفضائل",50,"ل",1,0],["معهد أصبوا إلى أيامه","كلما هبت شمال وصبا",51,"ب",2,0],["معهم العرضي ابو المواهب","وهو الفتى الشهير بالمناقب",52,"ب",1,0],["معهم وانزل الى العرابي","فعنهد مجتمع الأقراب",52,"ب",1,0],["معهما جماعة في المرقد","اجدائهم في المشكلات تقصد",52,"د",1,0],["معه تيممنا صعيداً طيباً","فيه أقمنا بالحظوظ شهودا",53,"د",2,0],["معْهَدُ الأنْسِ للصّبا والتّصابي","باعِثُ الوجْدِ عندَهُ الفِكْرُ هاجِسْ",54,"س",1,0],["مع هُمامٍ جنيتُ مرتشفاً من","ثغرِ آدابهِ حُباباً وطَلعا",55,"ع",2,0],["معهم حول لواء الحمد ك","ل موالٍ وعداهم طردوا",56,"د",3,0],["مَعهَدٍ مِن شَبابِهِ كانَ قِدماً","مَعهَد الغانيات يَسلُكنَ رَيعَه",57,"ع",2,0],["معها سلامُ كترياق المدام إذا","شجّت سحيرا بماء الثلج والبرَد",58,"د",1,0],["معه يا خلي عن الشجي ولا تسل","عن موقع الأشياء غير مجرب",59,"ب",1,0],["معهن المصابح للباب رحن","وفراشين في المجاز طرحن",60,"ن",1,0],["معهما استطار إخرو ميس","وذو المحاسن الفتى إريتس",61,"س",1,0],["مَعُهُ رادعاً يَسيرُ إِذا ما","رامَ لا مُخرَجاً غَداً فَهوَ أَدرى",62,"ر",2,0],["مَعَها المُرضِعُ والطِّفلُ الرَّضِيع","ساطِعاً بالحُسنِ كالنَّجمِ البَدِيع",63,"ع",1,0],["معه يا ثرى ما الثريا أنت منزلة","واقصر فما أنت بالفولاذ يا خشب",64,"ب",1,0],["مَعَهُ ضَوارٍ مِن سَلوقَ لَهُ","طَوراً تُعانِدُهُ وَتَتبَعُهُ",65,"ع",2,0],["معها أهدى بذورا كشموس الآصال","أشرقت منها زهور ايما اشراق",66,"ق",1,0],["مَعَها يَفْنَى عَنَائِي ينْقَضِي","كُلَّ هّمِّ غالني أو أَسْهَدَا",67,"د",2,0],["معه أول احلامي والأشواق والرجفه","واول بشاير تسكب العشق ما بيني",68,"ن",2,0],["معه حنا ليا من ثوّر البارود فالميدان","نهار ينادي الميقاف قدم القوم شجعانه",69,"ن",2,0],["معهم كْوْر والعاب والعلك ابوريال!","وانا أنادي: يالصغار المغاوير :",70,"ر",1,0],["معه الروافض جمّعت كلّ هدّام","ناظر ترى سود العمايم غزنا",71,"ن",2,0],["معه معه لا قال قدام .. قدام","طيب وحظي طاح بيدين ماكر",72,"ر",1,0],["معها إذا عبس الزمان بشاشة","وبها إلى الأحادث لفتة ساخر",73,"ر",1,0],["معها الحنين يتوّرق لين ياخذني","والشوق شوكٍ كثر ما امشي به أدماني",74,"ن",2,0],["معهم طه وصحبٌ باسلٌ","قد أقاموا لِحِماهم عُصَبا",75,"ب",2,0],["معهم لا بد جندٌ لم يرَوها","ليس يأتي النصر هذا من هَبَا",75,"ب",2,0],["معها الحديثُ مفكِّكٌ عُقَداً","معَ كلِّ حرفٍ تهربُ الكُرَبُ",76,"ب",1,0],["معه خطاب ٍ من صديق ٍ مبره","عطه أبو وايل لايطيل أنتظاره",77,"ر",2,0],["معه صرت مثل الشمس تتبع نزوح الفي ّ","مسار ٍ به الأهداف ماهي بمشروكة",78,"ك",2,1],["معه بندقٍ يرمي بها مالها متراس","على كل وجهه بالذخاير يثورها",79,"ر",3,0],["مَعَهَدٌ لِلأَبحاثِ يُغنيكَ عَن مَجمَعِ","عِلمٍ لَم يَاتِ بِدعاً جَديدا",80,"د",2,0],["معَ هذا فقلتُ عبدٌ تقيٌّ","وسِعَ الحقُّ بالنصوصِ المتينا",81,"ن",2,0]]}