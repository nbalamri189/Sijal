{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[88,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[53,"إذا ما مدحت المرء تطلب رفده","https://www.aldiwan.net/poem65786.html","الطويل"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[30,"ترى جسدا عيناك تنظر ساكنا","https://www.aldiwan.net/poem5287.html","الطويل"],[30,"وجاء قريع الشول قبل إفالها","https://www.aldiwan.net/poem5338.html","البسيط"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[368,"غشيت بِقرا فرط حول مكمل","https://www.aldiwan.net/poem1723.html","الطويل"],[370,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[411,"أحب من الإخوان كل مهذب","https://www.aldiwan.net/poem49943.html","الطويل"],[412,"تعاتب سعدى أن تنقل دارها","https://www.aldiwan.net/poem50172.html","الطويل"],[422,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[435,"يا رب ليل طويناه على قلق","https://www.aldiwan.net/poem41007.html","البسيط"],[473,"سقى غصني وبل العطاء فأورقا","https://www.aldiwan.net/poem59818.html","الطويل"],[473,"ترى جيده بين الغلالة والعقد","https://www.aldiwan.net/poem60184.html","الطويل"],[556,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53744","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77450","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17591","المتقارب"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17641","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56310","البسيط"],[1461,"","https://poetry.dctabudhabi.ae/diwan/poem/98046","الطويل"],[1516,"","https://poetry.dctabudhabi.ae/diwan/poem/33003","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49652","البسيط"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103244","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77344","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21436","المتقارب"],[2571,"","https://poetry.dctabudhabi.ae/diwan/poem/45538","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102718","المواليا"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125978","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89350","البسيط"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131347","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77176","الطويل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69289","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54502","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94902","الوافر"],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5152,"ردٌ باهِت","https://www.poetsgate.com/ViewPoem.aspx?id=184956",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[5490,"نور على نور","https://www.poetsgate.com/ViewPoem.aspx?id=176475",""],[5582,"عُجْ بِالمَطِيِّ فَهذا السَّفْحُ وَالعَلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=63577",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""]],"verses":[["تُرى جَميمُ الشَيبِ لَمّا ذَوى","يُراجِعُ العِظلِمَ بَعدَ الثَغام",0,"م",1,0],["تَرى جَنَّةً مِن جِنانِ الرَبيعِ","تَبَدَّت مَعَ الخُلدِ في مُستَوى",1,"ا",1,0],["ترى جودَهْ يُغنيك عن كل وُصْلةٍ","وعن كُلِّ ما تُدْلي به من حِبالكا",2,"ك",2,0],["تَرى جِدّاً وَلَستَ تَرى عَلَيهِم","وُلوعاً بِالصَغائِرِ وَاِشتِغالا",3,"ل",2,0],["تَرى جَسَداً عَيناكَ تَنظُرُ ساكِناً","وَلَستَ وَلَو ناداكَ لُقمانُ تَسمَعُ",4,"ع",1,1],["تَرى جارَنا فينا يُجيرُ وَإِن جَنى","فَلا هُوَ مِمّا يُنطِفُ الجارَ يُنطَفُ",5,"ف",1,0],["تَرى جِيَفَ الحيتانِ فيهِ كَأَنَّها","حِيامٌ عَلى ماءٍ حَديثٍ مُنَهَّلِ",6,"ل",1,0],["تَرى جُثوَتَينِ مِن تُرابٍ عَلَيهِما","صَفائِحُ صُمٌّ مِن صَفيحٍ مُنَضَّدِ",7,"د",1,0],["تُرى جاورت أرضَ السوارى فَرائِدٌ","من القَطْر عادت في النبات فرائدا",8,"د",2,0],["تَرى جُلَّ ما أَبقى السَواري كَأَنَّهُ","بُعَيدَ السَوافي أَثرُ سَيفٍ مُفَلَّلِ",9,"ل",1,0],["ترى جِيَفَ المَطيِّ بحافَتَيهِ","كأَنَّ عِظامَها الرَّخَمُ الوُقوعُ",10,"ع",1,0],["ترى جودَهُ يُزجي الرَّجاء بجودِهِ","ويُبدلهُ في الوِرْدِ رِفْهاً من العِشْرِ",11,"ر",1,0],["تَرى جودها بُخلاً بدون حَياتِها","فَيأتيكَ مِنها نَيلُها واِعتِذارُها",12,"ر",3,0],["ترى جيّد النَّاس الرّديّ بجنبه","وفي النَّاس ما دامت رديٌّ وجيّد",13,"د",1,0],["ترى جفوني من الدخان هامية","تجري كدلف بدا من سقفنا وجرى",14,"ر",2,0],["تَرى جاهَهُ لِلمُستَغيثينَ ناصِراً","وَمَعروفُهُ لِلمُستَميحينَ مونِقا",15,"ق",2,0],["تَرى جيدَهُ بَينَ الغِلالَةِ وَالعِقدِ","لَهُ نَكهَةٌ أَذكى مِنَ المِسكِ وَالنَدِّ",16,"د",1,1],["ترى جيادَهُمُ في كلِّ مُعتَرَكٍ","تُلقِي من الأرضِ صُفّاحاً بصُفّاحِ",17,"ح",1,0],["تَرَى جَهْرَهُ جَهْرَ التقيّ وسِرُّهُ","إذا ما اختبرتَ السِّرَّ أتقى منَ الجهْرِ",18,"ر",1,0],["تَرى جُثَث الأَبطال تَسقط بَينَهُم","سُقوط مَبانٍ فارَقتها الدَعائمُ",19,"م",1,0],["تَرى جِنَّها بَينَ أَضعافِها","حُلولاً كَأَنَّهُمُ البَربَرُ",20,"ر",1,0],["تَرَى جَوهَر المَوتِ في سَيفِهِ","وَلِلنَّصر في سَيفِهِ جَوهَرُ",21,"ر",1,1],["ترى جفوني من الدخان هايمةً","تجري كدلفٍ بدا من سقفنا وجرى",22,"ر",2,0],["ترى جازرَيهِ يرعدانِ وناره","عَليها عداميل الهشيمِ وَصامِلُه",23,"ل",2,0],["تَرى جارَهُمُ فيهِم كَريماً وَضَيفَهُم","مَنيعاً حُماهُ آمِناً لِلغَوائِلِ",24,"ل",1,0],["ترى جفونك أرضاها الذي صنعت","بي أنها نفثت بالسحر في عقد",25,"د",1,0],["ترى جاذِرَيهِ يرعدانِ ونارُه","عليها عُداميلُ الهشيمِ وصامِلُه",26,"ل",2,0],["تَرى جِسمُهُ فَوقَ التُرابِ وَعَزمُهُ","عَلى سُلَّمٍ مِن ساطِعِ النورِ يَصعَدُ",27,"د",1,0],["تَرى جارَهُم آمناً وَسطَهُم","يَروحُ بعَقدٍ وَثيق السَّبَب",28,"ب",1,0],["تَرى جارَهُم فيهِم يَخافُ وَضَيفَهُم","يَجوعُ وَقَد باتوا مِلاءَ المَذاخِرِ",29,"ر",1,0],["ترى جمع العوالم من الفيض الإلهي","بمدّ الروح الأعلى بالأنوار البواهي",30,"ه",2,0],["تَرَى جَزيرَه حَسَنٍ في اليَسَار","بَندَرُ أزيَب أَيُّها البيطَار",31,"ر",1,0],["تُرى جهلوا قدر العلى أم تجاهلوا","وهل يجهل الشمس المنيرة عالم",32,"م",1,0],["ترى جدرانها والنقش فيها","فتحسبه طلاسم ساحرينا",33,"ن",2,0],["ترى جيوشاً من المسروق قمحُهُمُ","على الخيول التي ماتت بسوطهمِ",34,"م",1,0],["ترَى جُدْرَه كالعاشقين من الجوَى","غَداةَ النَّوَى تُبْدِي دُموعاً هَواطِلاَ",35,"ل",2,0],["تَرى جودَهُ بِالمُخلِصينَ مُواصِلا","وَرب غَمام جاد يَوماً وَيَحبِس",36,"س",1,0],["تَرى جَسَداً قَد غَيَّرَ المَوتُ لَونَهُ","وَنَضحَ دَمٍ قَد سالَ كُلَّ مسيلِ",37,"ل",1,0],["ترى جواسِقَهَا في الجوِّ شاهقةً","كأَنّهنَّ قُصورٌ للسَّلاطينِ",38,"ن",1,0],["ترى جدرانها ترصيع ماس","كأن حجارها قُطَعُ البُدورِ",39,"ر",1,0],["ترى جواد على متن الجواد إذا","أمتطى عليه من الفرشان خيال",40,"ل",1,0],["ترى جبلًا من الأيامِ أرست","تجاربَه الحياةُ بكلِّ بابِ",41,"ب",1,0],["ترى جثث الأبطال صرعى بغابه","تراوحها الأشبال من كل شاغب",42,"ب",1,0],["ترى جبيني به كالبدر مرتفعاً","وإن تجلت له آلاؤه ركعا",43,"ع",2,0],["تَرَى جَفاهُمْ وَفُرْقاهُمْ لَنا سَقَراً","وَقَدْ تَرَى جَنَّةَ الفِرْدَوْسِ وَصْلَهُمُ",44,"م",1,0],["ترى جازان أو نجران منها","كجنات مموهة تلوحُ",45,"ح",1,0]]}