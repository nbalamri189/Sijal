{"poems":[[55,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[79,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[90,"على قاسم شيخ الطريقة قد بكت","https://www.aldiwan.net/poem45029.html","الطويل"],[74,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[53,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[53,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[53,"قصدت إليك لا أدلي بشيء","https://www.aldiwan.net/poem66295.html","الوافر"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[30,"ولست بنائل قمر الثريا","https://www.aldiwan.net/poem4950.html","الوافر"],[30,"إن أمامي خير من وطئ الحصى","https://www.aldiwan.net/poem5590.html","الطويل"],[63,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[68,"الجيش الحيا في مأقظ الروض معرك","https://www.aldiwan.net/poem39076.html","الطويل"],[77,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[48,"أجاز الشافعي فعال شيء","https://www.aldiwan.net/poem22760.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[79,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[119,"يا رفقتي كأسي حلا","https://www.aldiwan.net/poem40422.html","عموديه"],[132,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[154,"أصفيتك الود مضطرا ومختارا","https://www.aldiwan.net/poem68542.html","البسيط"],[173,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[231,"حب الشكور","https://www.aldiwan.net/poem24232.html","عموديه"],[240,"عليل الشوق فيك متى يصح","https://www.aldiwan.net/poem32107.html","الوافر"],[285,"أبا الفضل كيف تناسيتني","https://www.aldiwan.net/poem60752.html","المتقارب"],[310,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[343,"لم أبك من خبث خل","https://www.aldiwan.net/poem68676.html","المجتث"],[369,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[371,"حمائم قد حنت زجاجات أدمعي","https://www.aldiwan.net/poem17116.html","الطويل"],[376,"أتاني عنك إخوانك","https://www.aldiwan.net/poem57037.html","الهزج"],[385,"أعند الحر للأيام ثار","https://www.aldiwan.net/poem48783.html","الوافر"],[412,"أتاني عن تاج الزمان تعتب","https://www.aldiwan.net/poem50159.html","الطويل"],[416,"لندبك أحزان وسابق عبرة","https://www.aldiwan.net/poem67460.html","الطويل"],[422,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[447,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[466,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[556,"على مثله تذرى العيون دماء","https://www.aldiwan.net/poem48115.html","الطويل"],[580,"ولما مررت بدار الحبيب","https://www.aldiwan.net/poem2852.html","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86956","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53980","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48801","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38054","المجتث"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38825","الوافر"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138818",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70657","المتقارب"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79490","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124586",""],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132857","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126646","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71078","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89527","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47148","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67284","الطويل"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144379","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205414","السريع"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74261","الطويل"],[3201,"","https://poetry.dctabudhabi.ae/diwan/poem/200117","الوافر"],[3201,"","https://poetry.dctabudhabi.ae/diwan/poem/200116","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112341","المتقارب"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52978","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62966","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117995","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202330","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99241","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83542","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104894","المتقارب"],[4676,"ثورة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=206651",""],[1372,"وليلٍ كلونِ الظَّبيِ غَيَّرتُ لونَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=15841",""],[5376,"وهل للهجر قرب ما أنابا","https://www.poetsgate.com/ViewPoem.aspx?id=189753",""],[5518,"حين تسجد الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=201119",""],[5547,"ولما مر للميداني أضحى","https://www.poetsgate.com/ViewPoem.aspx?id=187143",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["وَلَمّا ماطَلَت بِالحَربِ سَعدٌ","سَنَنّا المَوتَ فيها بِالمِطالِ",0,"ل",1,0],["ولمّا محَتْ آيَ الشرائِعِ فترةٌ","وأصْبَحَتِ الأهْواءُ لا تعرِفُ القصْدا",1,"د",2,0],["وَلَم أَمدَح لأُرضِيَهُ بِشِعري","لَئيماً أَن يَكونَ أَصابَ مالا",2,"ل",2,0],["ولما مضى للخلد قلت مؤرخاً","لقد بات على أعلى الفراديس قاسم",3,"م",1,0],["ولما مشى فوقَ البسيطة زانها","وفاخرت الشهبَ الحصا والجنادل",4,"ل",1,0],["ولم أمنُنْ بذاك وكيف مَنِّي","على من عُرفه عندي ضُروبُ",5,"ب",1,0],["وَلَما مُنْكرٌ لمثليَ من مثْ","لكَ رُؤدٌ من القيان عَرُوبُ",6,"ب",1,0],["ولم آمل غداً لكِ فيه عدل","وإلا قلتُ خير منه أمس",7,"س",1,0],["ولم أمنعك ورد البحر كلا","ولا إلطافَهُ اللطف الطريفا",8,"ف",2,0],["ولم أمدحكَ إتحافاً بمدحٍ","كفى مدحٌ غُذيتَ به فطيما",9,"م",2,0],["ولما مَدَحْتُك مائناً في مدحتي","ومتى تُلاقي مادحاً لا مائنا",10,"ن",2,0],["وَلَمّا مُدَّ بَينَ بَني كُلَيبٍ","وَبَيني غايَةٌ كَرِهوا النِصابا",11,"ب",2,0],["وَلَمّا مَضَوا عَن خَيرِ سُنَّةِ مَعشَرٍ","وَقامَ سُلَيمانٌ أَتَت خَيرَ قائِمِ",12,"م",1,0],["ولم أَملِكْ غَراماً في اتَّئادٍ","يؤَرِّقُني ودَمعاً في استباقِ",13,"ق",1,0],["وَلَمّا مَلَكتُ الكَأسَ ثُمَّ حَسَوتُها","تَقاضَت فَظَلَّت وَهيَ لِلعَقلِ تَملِكُ",14,"ك",1,0],["ولما مدحْتُكَ كي أزيدك سودداً","هل في كمالك موضعٌ لمزيد",15,"د",1,0],["وَلَم آمَن عَلى الفُقَهاءِ حَبساً","إِذا ما قيلَ لِلأُمَناءِ جوزُوا",16,"ز",3,0],["ولما مضَى روميلُ يلعَقُ جُرْحَه","ويجرُّ ذيلَ العاثرِ المفلوك",17,"ك",1,0],["ولما محت آي الشرائع فطرة","وأصبحت الأهواء لا تعرف القصدا",18,"د",2,0],["ولم امل لغيره","ولو دهاني البلا",19,"ل",2,0],["ولما مررْنا بالديار التي عفَتْ","سقَينا ثراهَا من شئون المحَاجرِ",20,"ر",1,0],["ولم أَمُرَّ بحرف منه أقرأهُ","إلا تأخرتُ إنصافاً وإقرارا",21,"ر",2,0],["وَلَم أَمتَدِح خَلقاً سِواكَ لِمالِهِ","فَأَحظى بِنَيلٍ أَو بِعَضِّ الأَباهِمِ",22,"م",1,0],["ولما منحت ، وما منحت من الهوى","للكون ، أو أحييت من مقبور",23,"ر",1,0],["وَلَم أَملِك إِلى الشَكوى سَبيلاً","كَتَبتُ إِلَيكَ وَالعَبَراتُ تَمحو",24,"ح",2,0],["وَلَمْ أَمْنَحِ الْحَمْدَ إِلاّ امْرَأً","أَحَقَّ بِهِ مِنْ جَمِيعِ الْعِبادِ",25,"د",1,0],["وَلَم أمشِ الضراءَ له لأنّي","شَققتُ بِه لدى الظلماءِ فَجرا",26,"ر",2,0],["وَلَم أَمِل عَن صَديقِ","لِلزُهدِ فيما لَدَيهِ",27,"ي",2,0],["ولمّا محا النّاسُ رَسْمَ الجميلِ","سطَرْتُ من العيسِ في البيدِ سَطرا",28,"ر",2,0],["وَلَمّا مَرَرنا بِالرُسومِ تَنَفَّذَت","بِها لِلهَوى في العاشِقينَ المَراسِمُ",29,"م",1,0],["ولِم أمكَنتَهُم أن يَض","حَكوا مِنَّا فيُبكُونا",30,"ن",2,0],["وَلَم أَمدَحكَ لاستجداءِ نَعمى","وَلا بِعُلاكَ لِلمَدح اِفتِقار",31,"ر",1,0],["وَلَم أَمتَدِحهُ آخِراً لِجَهالَةٍ","وَهَل لِلَّذي لا يَعرف الشَمس من عُذرِ",32,"ر",1,0],["وَلَمّا مَضى مَعنٌ مَضى الجودُ وَاِنقَضى","وَأَصبَحَ عِرنينُ المَكارِمِ أَجدَعا",33,"ع",2,0],["ولمَّا مضى عبد الغنيّ مضتْ به","صنايع برٍّ تستفاض أياديا",34,"ي",2,0],["ولما مسحنا الركن والحجر الذي","به قد دعونا اللَه ذا المجد ربنا",35,"ن",2,0],["ولمّا مننتم بالندى فعطفتمُ","عليّ وأعلقتم بمعروفكم حبلي",36,"ل",2,0],["ولم أمنحك هذا الرأس إلا","لترفعني على السبع الشِّدادِ",37,"د",1,0],["ولمّا مررنا بالظّباءِ عشيّةً","علَوْن النَّقا وَهْناً بأوفى من النَّقَا",38,"ق",2,0],["ولما مضى طوعَ الرّدى متكبّرٌ","سكن القلاعَ ولا مضى متجبّرُ",39,"ر",1,0],["ولمّا مررنا على رَبْعِهِ","خرابِ الأنيس ولم يَخرِبِ",40,"ب",1,0],["وَلَمّا مَضوا يَهوُون في سنَنِ الرّدى","أَحالوا صباحَ المَكرُمات مَساءا",41,"ا",3,0],["ولما مررتُ بدارِ الحبيب","وقد خابَ من ساكنيها ظُنوني",42,"ي",1,1],["وَلَما مثلت طَبعاً وَتَمَّت","بِمَصر قلت في حسن اِختِراع",43,"ع",1,0],["ولمّا مُنِعْتُ الحقّ جئتُكَ شَاكياً","لألْقى مُعيناً منكَ لي ونَصِيرَا",44,"ر",2,1],["ولما مضى ارتد أنصاره","وهم شر أعدائه مطعنا",45,"ن",2,0],["وَلَم أَمِنْ بِغَرامي","وَقَلَّ في النّاسِ مَنْ لا",46,"ل",2,0],["وَلَمّا مَيّلت ضَمّت شِفاهاً","وَقَد أَهوَت فَقَبّلَتِ النَّسيما",47,"م",2,0],["ولما مضى عنا تخلف بعده","علينا علي وهو أولى بنا منا",48,"ن",2,0],["ولم أمدحنْ رَبَّ فِسقٍ ولا","أخا نخوةٍ تائها ذا بذَخْ",49,"خ",1,0],["ولم أميز بين أمسى وغدي","وكبدى وضعت فوقه يدي",50,"ي",1,0],["ولم أمتدح علياك حتى انلتني","بنعماك يا مختار مغنى ومغنما",51,"م",2,0],["ولم امتدح علياك إلا لأنني","أنوّل في الدارين أغنى المنافع",52,"ع",1,0],["ولمَّا مَزَجْتُ الرُّوحَ منِّي براحِها","تَرَحَّلَ عنِّي الهمُّ والغَمُّ وأجْمَعُ",53,"ع",1,0],["ولم أمدح لأرضيه لئيما","بشعري أن أكون أصاب مالا",54,"ل",2,0],["ولما مَدَدنا نحوهُنَّ الهديَّة خِلتُه","يراها الضَّنى في حُبِّه فَتحيَّفَا",55,"ف",2,0],["ولما ملكت الأرض وانقاد أهلها","لبأسك خاطبت الغمام مذكرا",56,"ر",2,0],["ولم أَمْلَ ما بين العَقيِق وأَحْورَ","نوائبَ يبقى ذِكْرُها وخطوبا",57,"ب",2,0],["وَلَم أَمتَدِح عُمري سِواكَ بِدايَةً","وَلكِنَّما خَيرٌ مِنَ الخَيرِ صانِعُه",58,"ع",2,0],["ولمّا مضى أبكى القلوبَ توجُّعاً","وإنْ كان ذا وَجْهٍ من الْبِشْرِ ضاحِكِ",59,"ك",1,0],["ولم أُمِرَت أم الكليم بقذفه","إلى نيل مصر حين ضاقت به مصر",60,"ر",1,0],["ولمّا مررنا بالمحصَّبِ من منى","وأبصرتُ ربعاً دارسات معالمُه",61,"ه",1,1],["ولما ملكت القول قهرا وعنوة","أطاعك جيش النظم وائتمر النثر",62,"ر",1,0],["ولمَّامُ الخلاخِلِ أخرَستهُ","بليغَاتُ الخِدالِ عن المحالِ",63,"ل",1,0],["ولم أمتع من أبي مرة","بمجلس حلو نضير الجناب",64,"ب",1,0],["ولَما مَضَت أَقرانه ظَل مُفرداً","لِناديه أَقوام وَلَيسَ لَهُ ذَنب",65,"ب",1,0],["ولما مر للميدان أضحى","يعلم لحظه شق الصفوف",66,"ف",1,1],["ولما مر ليس لغير قتلى","وقد ملئت ملاءته مراحا",67,"ح",2,1],["ولمّا مَشَينَا لنجني الورود","بِظلّ فراشاتها الحُوَّمِ",68,"م",1,0],["ولما مستْ الحاجه","كسوْنا نيلها تاجه",69,"ه",1,0],["ولم أمدح الفهريَّ حتى بلوتُه","فطبقَ لفظي من ضريبتهِ المعنَى",70,"ن",2,0],["ولما مضى ازدادوا عتواً وأطفأوا","مصابيح بيت الدين مبدين أضغانا",71,"ن",2,0],["ولما مدحت الهبرزي ابن أحمد","أجاز وكافاني على المدح بالمدح",72,"ح",1,1],["ولما مَرَرْنا بالرسومِ التي بَدَتْ","كما سالَ ماءٌ في سِجِلٍ على سَطْرِ",73,"ر",1,0],["وَلَمَّا مِنَ اليَمِّ فَوقَ البِحارِ","بَدَت تَتَجَلَّى عَرُوسُ النَّهارِ",74,"ر",1,0],["ولما من الفتك كلت يداه","ونال مناه بكيد العداه",75,"ه",1,0],["وَلَم أُمتها بِذُلٍّ بعد عزَّتها","إِلّا لِعِلمي بِأَنَّ المَوتَ يُحييها",76,"ي",3,0],["ولما من الركب حان الرحيل","وشدت رحال بنات السفر",77,"ر",1,0],["ولمّا من الأوجاعِ تُشفى المَشاعرُ","يَموتُ عليلَ الآهِ في الروحِ شاعرُ",78,"ر",1,1],["ولمَّا مَزَجْتُ الرُّوحَ منِّي براحِها","تَرَحَّلَ عنِّي الهمُّ والغَمُّ أجمَعُ",79,"ع",1,0],["ولم أملك له رشدا وغيَّاً","وما أصبو به يوما عتابا",80,"ب",2,0],["وَ لَمْ أَمْدَحْ سِوَاكَ وَ طَابَ مَدْحِي","لِمَمْدُوحِي وَ إِنْ أَنْشَدْتُ بِدْعا",81,"ع",2,0],["ولما مر للميداني أضحى","يعلم لحظه شق الصفوف",82,"ف",1,1],["وَلما مزمهر مثل أَول ظُهورها","ضاع الضماد وَخاب رجلاً رقى لَها",83,"ل",3,0]]}