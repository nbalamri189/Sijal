{"poems":[[53,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[88,"على قاسم شيخ الطريقة قد بكت","https://www.aldiwan.net/poem45029.html","الطويل"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[51,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[51,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[51,"قصدت إليك لا أدلي بشيء","https://www.aldiwan.net/poem66295.html","الوافر"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[28,"ولست بنائل قمر الثريا","https://www.aldiwan.net/poem4950.html","الوافر"],[28,"إن أمامي خير من وطئ الحصى","https://www.aldiwan.net/poem5590.html","الطويل"],[61,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[66,"الجيش الحيا في مأقظ الروض معرك","https://www.aldiwan.net/poem39076.html","الطويل"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[46,"أجاز الشافعي فعال شيء","https://www.aldiwan.net/poem22760.html","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[115,"يا رفقتي كأسي حلا","https://www.aldiwan.net/poem40422.html","عموديه"],[128,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[150,"أصفيتك الود مضطرا ومختارا","https://www.aldiwan.net/poem68542.html","البسيط"],[169,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[226,"حب الشكور","https://www.aldiwan.net/poem24232.html","عموديه"],[235,"عليل الشوق فيك متى يصح","https://www.aldiwan.net/poem32107.html","الوافر"],[280,"أبا الفضل كيف تناسيتني","https://www.aldiwan.net/poem60752.html","المتقارب"],[305,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[338,"لم أبك من خبث خل","https://www.aldiwan.net/poem68676.html","المجتث"],[364,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[366,"حمائم قد حنت زجاجات أدمعي","https://www.aldiwan.net/poem17116.html","الطويل"],[371,"أتاني عنك إخوانك","https://www.aldiwan.net/poem57037.html","الهزج"],[380,"أعند الحر للأيام ثار","https://www.aldiwan.net/poem48783.html","الوافر"],[406,"أتاني عن تاج الزمان تعتب","https://www.aldiwan.net/poem50159.html","الطويل"],[410,"لندبك أحزان وسابق عبرة","https://www.aldiwan.net/poem67460.html","الطويل"],[416,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[441,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[458,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[461,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[551,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[551,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[551,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[551,"على مثله تذرى العيون دماء","https://www.aldiwan.net/poem48115.html","الطويل"],[575,"ولما مررت بدار الحبيب","https://www.aldiwan.net/poem2852.html","المتقارب"]],"verses":[["وَلَمّا ماطَلَت بِالحَربِ سَعدٌ","سَنَنّا المَوتَ فيها بِالمِطالِ",0,"ل",1,0],["ولمّا محَتْ آيَ الشرائِعِ فترةٌ","وأصْبَحَتِ الأهْواءُ لا تعرِفُ القصْدا",1,"د",2,0],["وَلَم أَمدَح لأُرضِيَهُ بِشِعري","لَئيماً أَن يَكونَ أَصابَ مالا",2,"ل",2,0],["ولما مضى للخلد قلت مؤرخاً","لقد بات على أعلى الفراديس قاسم",3,"م",1,0],["ولما مشى فوقَ البسيطة زانها","وفاخرت الشهبَ الحصا والجنادل",4,"ل",1,0],["ولم أمنُنْ بذاك وكيف مَنِّي","على من عُرفه عندي ضُروبُ",5,"ب",1,0],["وَلَما مُنْكرٌ لمثليَ من مثْ","لكَ رُؤدٌ من القيان عَرُوبُ",6,"ب",1,0],["ولم آمل غداً لكِ فيه عدل","وإلا قلتُ خير منه أمس",7,"س",1,0],["ولم أمنعك ورد البحر كلا","ولا إلطافَهُ اللطف الطريفا",8,"ف",2,0],["ولم أمدحكَ إتحافاً بمدحٍ","كفى مدحٌ غُذيتَ به فطيما",9,"م",2,0],["ولما مَدَحْتُك مائناً في مدحتي","ومتى تُلاقي مادحاً لا مائنا",10,"ن",2,0],["وَلَمّا مُدَّ بَينَ بَني كُلَيبٍ","وَبَيني غايَةٌ كَرِهوا النِصابا",11,"ب",2,0],["وَلَمّا مَضَوا عَن خَيرِ سُنَّةِ مَعشَرٍ","وَقامَ سُلَيمانٌ أَتَت خَيرَ قائِمِ",12,"م",1,0],["ولم أَملِكْ غَراماً في اتَّئادٍ","يؤَرِّقُني ودَمعاً في استباقِ",13,"ق",1,0],["وَلَمّا مَلَكتُ الكَأسَ ثُمَّ حَسَوتُها","تَقاضَت فَظَلَّت وَهيَ لِلعَقلِ تَملِكُ",14,"ك",1,0],["ولما مدحْتُكَ كي أزيدك سودداً","هل في كمالك موضعٌ لمزيد",15,"د",1,0],["وَلَم آمَن عَلى الفُقَهاءِ حَبساً","إِذا ما قيلَ لِلأُمَناءِ جوزُوا",16,"ز",3,0],["ولما مضَى روميلُ يلعَقُ جُرْحَه","ويجرُّ ذيلَ العاثرِ المفلوك",17,"ك",1,0],["ولما محت آي الشرائع فطرة","وأصبحت الأهواء لا تعرف القصدا",18,"د",2,0],["ولم امل لغيره","ولو دهاني البلا",19,"ل",2,0],["ولما مررْنا بالديار التي عفَتْ","سقَينا ثراهَا من شئون المحَاجرِ",20,"ر",1,0],["ولم أَمُرَّ بحرف منه أقرأهُ","إلا تأخرتُ إنصافاً وإقرارا",21,"ر",2,0],["وَلَم أَمتَدِح خَلقاً سِواكَ لِمالِهِ","فَأَحظى بِنَيلٍ أَو بِعَضِّ الأَباهِمِ",22,"م",1,0],["ولما منحت ، وما منحت من الهوى","للكون ، أو أحييت من مقبور",23,"ر",1,0],["وَلَم أَملِك إِلى الشَكوى سَبيلاً","كَتَبتُ إِلَيكَ وَالعَبَراتُ تَمحو",24,"ح",2,0],["وَلَمْ أَمْنَحِ الْحَمْدَ إِلاّ امْرَأً","أَحَقَّ بِهِ مِنْ جَمِيعِ الْعِبادِ",25,"د",1,0],["وَلَم أمشِ الضراءَ له لأنّي","شَققتُ بِه لدى الظلماءِ فَجرا",26,"ر",2,0],["وَلَم أَمِل عَن صَديقِ","لِلزُهدِ فيما لَدَيهِ",27,"ي",2,0],["ولمّا محا النّاسُ رَسْمَ الجميلِ","سطَرْتُ من العيسِ في البيدِ سَطرا",28,"ر",2,0],["وَلَمّا مَرَرنا بِالرُسومِ تَنَفَّذَت","بِها لِلهَوى في العاشِقينَ المَراسِمُ",29,"م",1,0],["ولِم أمكَنتَهُم أن يَض","حَكوا مِنَّا فيُبكُونا",30,"ن",2,0],["وَلَم أَمدَحكَ لاستجداءِ نَعمى","وَلا بِعُلاكَ لِلمَدح اِفتِقار",31,"ر",1,0],["وَلَم أَمتَدِحهُ آخِراً لِجَهالَةٍ","وَهَل لِلَّذي لا يَعرف الشَمس من عُذرِ",32,"ر",1,0],["وَلَمّا مَضى مَعنٌ مَضى الجودُ وَاِنقَضى","وَأَصبَحَ عِرنينُ المَكارِمِ أَجدَعا",33,"ع",2,0],["ولمَّا مضى عبد الغنيّ مضتْ به","صنايع برٍّ تستفاض أياديا",34,"ي",2,0],["ولما مسحنا الركن والحجر الذي","به قد دعونا اللَه ذا المجد ربنا",35,"ن",2,0],["ولمّا مننتم بالندى فعطفتمُ","عليّ وأعلقتم بمعروفكم حبلي",36,"ل",2,0],["ولم أمنحك هذا الرأس إلا","لترفعني على السبع الشِّدادِ",37,"د",1,0],["ولمّا مررنا بالظّباءِ عشيّةً","علَوْن النَّقا وَهْناً بأوفى من النَّقَا",38,"ق",2,0],["ولما مضى طوعَ الرّدى متكبّرٌ","سكن القلاعَ ولا مضى متجبّرُ",39,"ر",1,0],["ولمّا مررنا على رَبْعِهِ","خرابِ الأنيس ولم يَخرِبِ",40,"ب",1,0],["وَلَمّا مَضوا يَهوُون في سنَنِ الرّدى","أَحالوا صباحَ المَكرُمات مَساءا",41,"ا",3,0],["ولما مررتُ بدارِ الحبيب","وقد خابَ من ساكنيها ظُنوني",42,"ي",1,1]]}