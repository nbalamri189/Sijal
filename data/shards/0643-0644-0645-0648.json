{"poems":[[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[50,"أيها الناس ارحموني","https://www.aldiwan.net/poem66186.html","مجزوء الرمل"],[422,"قل مثلما قد قال عبد الباقي","https://www.aldiwan.net/poem53980.html","الكامل"],[457,"نفحات أنس أم شذا ألطاف","https://www.aldiwan.net/poem13850.html","الكامل"],[463,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[556,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[563,"عرجا بي على النقا فجياد","https://www.aldiwan.net/poem34617.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53954","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78176","الخفيف"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88665","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205489",""],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125871","الخفيف"],[5776,"ضريح الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199857",""]],"verses":[["كُلُّ مَوقوذٍ مِنَ التاجِ لَهُ","نَهَرٌ يَسقي يَلَنجوجاً وَغارا",0,"ر",2,0],["كَلِّموهُ في سُكونٍ","لا تَشُقُّنَّ عَلَيهِ",1,"ي",2,0],["كَلِّموهُ اليَومَ يَرضى","عَن أَسيرٍ في يَدَيهِ",1,"ي",2,0],["كَلِمٌ ولا وخزات أطراف القنا","يَلْمَعْنَ عن صَوْب الدم المهراق",2,"ق",1,0],["كَلِمٌ وأسجاعٌ تراصفَ دُرُّها","وبدائِعٌ أعيَتْ مَدى الأوصاف",3,"ف",1,0],["كلّ مُوشّىً حَوكُها موشَّع","تشرِي رخيصا بُرْدَها الثمينا",4,"ن",2,0],["كَلمٌ وأنت إساؤُه","لمّا مضى عنّا بقيتا",5,"ت",2,0],["كلموا نفسهم بنا فتكلم","نا بهم في الثلاث والآحاد",6,"د",1,0],["كَلِّمُوهُ إذا أتَاكُمْ فَإنِّي","خَائِفٌ أنْ يَرُدَّهُ عِشْرِينَا",7,"ن",2,0],["كُلُ مَولىً ميل القُلوب إِلَيهِ","مثل ميلة السراة لِلمِقباس",8,"س",1,0],["كل موتٍ فيه لقياك حياة","ليتما عجل بي ما هو آتٍ",9,"ت",1,0],["كل موصول له مفتقر","مستعيدا صلة في كل عام",10,"م",1,0],["كلٌّ مولٍّ ولا والٍ ولو ملكٌ","ويستوي الكل مقلوباً إلى الرُجَمِ",11,"م",1,0],["كل مولود تراه","داهم الحِصْنَ المنيعَا",12,"ع",2,0],["كلُّ موتٍ في عالم هُوَ ميلادُ","دواليْك من حياةٍ لأخرى",13,"ر",2,0],["كلُّ موت هوُ الحياةُ إذا ما","في ضريح الخلود طافَ العزاءُ",14,"ا",2,0]]}