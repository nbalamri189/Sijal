{"poems":[[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87087","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64547","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35896","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216777","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147301","الرمل"],[5956,"رقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185617",""],[5956,"أوَ ما نخجل من أنفسنا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194418",""],[5956,"ذكرى حبي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=196838",""]],"verses":[["أَوَلَن يُلاحَمَ في الزُجا","جَةِ صَدعُها بِعِصابِها",0,"ب",3,0],["أَوَلَن تَرى في الزُبرِ بَيِّ","نَةً بِحُسنِ كِتابِها",0,"ب",3,0],["أَولني يا خيرَ من أَولى يَداً","منك قُرباً يُبرئ الداء العَقاما",1,"م",2,0],["أَو لنهب المحصول وَاللَيل داجٍ","مِن غياض الجيران وَالغَيث هامي",2,"م",2,0],["أولني أولية السبق يا أ","ول والقرب منك لي والتولي",3,"ل",2,0],["أو لنارٍ لهبٌ لم يُخلَق","بأبي القاسم قد حلَّت لنا",4,"ن",2,0],["أَولِنا يا وَلِيَّ دَولَتِهِ خَي","راً لَدَيهِ فَالخَيِّرُ النَفّاعُ",5,"ع",1,0],["أولني منك صورةً مثلما صو","ورت نفسي لديك في أشعاري",6,"ر",2,1],["أو لن نمنح يوما حقنا","أم ترى يغتالنا ذات المصير",7,"ر",1,0],["أوْ لن يوزَّع أي سِفْرٍ لي ولن","ألقى إلى درب السعادة مَوْرِدا",8,"د",2,0],["أ وَ لن نشفى من الداء الذي","لم يزل فينا عُضالاً لم يغِبْ؟",9,"ب",1,0],["أ وَ لن أشاهد وجهك القِدِّيسا","إلا بعدْنٍ أو بعودةِ عيسى؟",10,"س",2,1]]}