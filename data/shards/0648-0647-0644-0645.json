e/diwan/poem/83657","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83555","المتقارب"],[4533,"","https://poetry.dctabudhabi.ae/diwan/poem/134283","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72653","الوافر"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144247","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120509","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120246","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141684","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120355","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52177","البسيط"],[4679,"هو البشرُ للفؤاد فيطربُ","https://www.poetsgate.com/ViewPoem.aspx?id=142759",""],[4717,"هبي كل عشقٍ في سواك قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=199573",""],[4884,"سَبْعٌ يَأْكُلُهُنَّ سَبْعْ","https://www.poetsgate.com/ViewPoem.aspx?id=201761",""],[4955,"ألا يا ساعة دقت","https://www.poetsgate.com/ViewPoem.aspx?id=187938",""],[5043,"وعد العرس الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=203387",""],[5135,"على مرفأ الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=203702",""],[5136,"نعم أنا لا أرجو إذا ألوت اللوى","https://www.poetsgate.com/ViewPoem.aspx?id=121784",""],[5147,"سبرت مقاييس العراق فلاح لي","https://www.poetsgate.com/ViewPoem.aspx?id=166736",""],[5183,"فخري","https://www.poetsgate.com/ViewPoem.aspx?id=186477",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5246,"إليك جواباً موضحا مسلكَ الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=187077",""],[5302,"والظبي راتع","https://www.poetsgate.com/ViewPoem.aspx?id=201661",""],[5324,"إنما الدنيا وفاقَ","https://www.poetsgate.com/ViewPoem.aspx?id=211651",""],[5376,"صلاةُ العرْبِ في قدْسنا الفجْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=188290",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5444,"كُرَةُ اللَّهَب","https://www.poetsgate.com/ViewPoem.aspx?id=205082",""],[5518,"توسلت بالمختار أرجى الوسائل","https://www.poetsgate.com/ViewPoem.aspx?id=190036",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5582,"سُطُورُ هَوَىً ما فِي حَقِيقَتِها لَغْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=187334",""],[5605,"بكاء الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161345",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[5956,"لماذا يحب الناس الفنَّ والعلم","https://www.poetsgate.com/ViewPoem.aspx?id=185757",""],[5956,"تصادُمُ السمُوِّ بالدنُوِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193936",""],[6002,"وصل التي عن هواها القلب مرتدع","https://www.poetsgate.com/ViewPoem.aspx?id=211914",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[520,"أأحبابنا كم تبخلون وكم نسخوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577467",""],[6167,"تحت العرش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85552&r=&rc=35",""],[6175,"يقولون لو يهوى لسالت دموعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72835&r=&rc=60",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[6237,"أنشودة العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77865&r=&rc=7",""],[6257,"رحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87183&r=&rc=8",""],[5190,"مضى سهم القضاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78299&r=&rc=12",""]],"verses":[["وَهَل مَسَّ زاكَ الشيحَ عِرنَينُ ناشِقِ","وَهَل ذاقَ ماءً بِاللَوى شَفَتانِ",0,"ن",1,0],["وَهَل مُطمِعي ذاكَ الغَزالُ بِلَفتَةٍ","وَإِن ثَوَّرَ الرَكبُ العِجالَ وَأَوجَفوا",1,"ف",3,0],["وَهَلْ مِنَّةٌ تُرْضِي إِذَا كَلَّتِ الْقُوَى","وَبَانَ اشْتِعَالُ الرَّأَسِ أَوْ وَهَنَ الْعَظْمُ",2,"م",1,0],["وَهَل مالِكٌ إِلاّ أُسودُ خَفيَّةٍ","إذا لَم تُعاطَ الحَقَّ بادٍ نُيُوبُها",3,"ب",3,0],["وهل من جناح على مرهَقٍ","يدافع بالله ما لا يطيقُ",4,"ق",1,0],["وهل مِن قائلٍ لك لا يراه","سراةُ الناس مغْبوناً هتيكا",5,"ك",2,0],["وهَلْ مأثَمٌ في مدحِ من كان مدحُه","يوازِنُ عندَ اللَّهِ تسبيحَ صائمِ",6,"م",1,0],["وهل مَشْتَمٌ في عرض من راح واغتدى","يرى زَوْره عِدلَ الشريك المُقاسمِ",6,"م",1,0],["وهل من حربةٍ أو من سنانٍ","كعين أو كثغرٍ أبو بنَان",7,"ن",1,0],["وَهَل مِن فَتىً مِن وائِلٍ قَد عَلِمتُمُ","كَعِكرِمَةَ الفَيّاضِ عِندَ عُرى الأَمرِ",8,"ر",1,0],["وَهَلُمَّ جَرّاً لَم أَزَل","قَلبي أَسيرَهُما وَعَيني",9,"ن",2,0],["وَهَل مَسجِدٌ تَتلونَ فيهِ رِثاءَهُ","فَكَم قَد تَلَوتُم مَدحَهُ بِالتَرَنُّمِ",10,"م",1,0],["وَهَل مَرَرتَ بِأَقوامٍ كَفِطرَتِهِم","مِن عَهدِ آدَمَ لا خُبثٌ وَلا طَبَعُ",11,"ع",1,0],["وَهَل مُغرَمٌ قَد ضَعَّفَ الحُزنَ وَجدَهُ","يُكَفكِفُ دَمعاً قَد تَحَدَّرَ هامِلُه",12,"ل",2,0],["وَهَل مِن أَبٍ في الناسِ يَدعونَ بِاِسمِهِ","لَهُ اِبنانِ كانا مِثلَ سَعدٍ وَدارِمِ",13,"م",1,0],["وَهَل مِثلُنا يا اِبنَ المَراغَةِ إِذ دَعا","إِلى البَأسِ داعٍ أَو عِظامِ المَلاحِمِ",14,"م",1,0],["وَهَل مَن جاءَ بَعدَ الفَتحِ يَسعى","كَصاحِبِ هِجرَتَينِ مَعَ النَبِيِّ",15,"ي",1,0],["وَهَل مِن حَكيمٍ ضَيَّعَ الصَبرَ بَعدَما","رَأى الحُكَماءُ الصَبرَ ضَربَةَ لازِمِ",16,"م",1,0],["وَهَل مُهجَةُ الإِنسانِ إِلّا طَريدَةٌ","تَحومُ عَلَيها لِلحِمامِ عُقابُ",17,"ب",1,0],["وَهَل مِن سُرورٍ أَو أَمانٍ لِعاقِلٍ","وَمَفضى عُبورِ العابِرينَ إِلى المَوتِ",18,"ت",1,0],["وهل منعتْ أَسلابَها إذ أصابَها","رَسولُ هُدىً يَزدادُ غُنماً على غُنْمِ",19,"م",1,0],["وَهَل مُطيقٌ عَلى النَوى جَلَداً","صَبٌّ لِغَيرِ الغَرامِ ما خُلِقا",20,"ق",2,0],["وَهَل مَزَجتُ صَفائي لِلصَديقِ وَهَل","أَودَعتُ يا هِندُ غَيرَ الحَمدِ خَزّاني",21,"ن",2,0],["وَهَل مِن وَقتِهِم أَبغى وَأَطغى","عَلى أَيِّ المَذاهِبِ قَلّبوهُ",22,"ب",3,0],["وَهَلْ مِنْ مَقِيلٍ تَحْتَ أَفْنَانِ سِدْرَةٍ","لَهَا مِنْ زَرَابِيِّ النَّبَاتِ فِراشُ",23,"ش",1,0],["وَهَلْ مَنْ أُمُورٍ فِي الحَيَاةِ عَظِيمَةٍ","بَغَيْرِ صِبا تَمَّتْ وغَيْرِ تَصَابِي",24,"ب",2,0],["وَهَلْ مِنْ فَلاحٍ لِلْبِلاَدِ وَأَهْلِهَا","إِذا الشَّأْنُ فِيهَا ساسَهُ أَلْفُ ريِّسِ",25,"س",1,0],["وهل مثل إسماعيلَ في الناسِ عاهلٌ","له فوق أحْداثِ الزمانِ وِثاب",26,"ب",1,0],["وهل مقلة لم يملأ الدمع غربها","وهل كبد لم تحترق بمصابها",27,"ب",3,0],["وهل من يرى لله حقا ومرجعا","اليه وأن الدين لا شك واقع",28,"ع",1,0],["وهل من يرى أن الحقوق التي دعا","اليها رسول الله غفل ضوائع",28,"ع",1,0],["وهل من يرى الشرع الشريف تدرأت","عليه حثالات مبير وخانع",28,"ع",1,0],["وهل من يرى أن الحنيفة سامها","بما شاء من ضيم لعين مخادع",28,"ع",1,0],["وهل مثلَما قالوا جدودٌ نواهضٌ","تقوم بأهليها وأخرى عواثر",29,"ر",1,0],["وهَلْ ما يرجِّي المُصلحونَ يَرونهُ","مواجَهَةً أمْ تلكَ أضغاثُ حالم",30,"م",1,0],["وهل من أنّة خفيت ودقّت","أسى إلاّ وفي نفسي صداها",31,"ا",3,0],["وهل من حربة ٍ أو من سنانٍ","كعين أو كثغرٍ أو بنَان",32,"ن",1,0],["وهل مثلها في عالم الفخر رتبة","يقال فلان حازها وفلان",33,"ن",1,0],["وهل ملأ الخزان حفرة قبره","اذا مات مالا بالأوهام مقرف",34,"ف",1,0],["وهل من يد بيضاً تقوم بحاله","وتتحفه من عسر بلواه باليسر",35,"ر",1,0],["وهلم عند الضاربين بطبلهم","للناس أمثلة الصراحة نسمر",36,"ر",1,0],["وهلم نشرب قهوة عربية","قد صين سر عبيرها لمصون",37,"ن",1,0],["وَهَل مَن قَلَّدَ الخَيلَ المَخالي","كَمَن جَعَلَ الشَكيمَ لَها عَليقا",38,"ق",2,0],["وهل ملك كالناصرِ الملك في الوغى","بذمته إن ذم والذب إن حمى",39,"م",2,0],["وهل من مفخر لم يبلغوه","فيعذر فيه من منهم تمنى",40,"ن",2,0],["وهل مات من لم يكظم الغيظ ظافرا","بغير انتهاك العرض والهتك للستر",41,"ر",1,0],["وهل من عزيز عندكم تؤثرونه","على الله والمختار عند التظافر",42,"ر",1,0],["وَهَل مَنَعَت مِنهُ غَزيَّةُ دارَها","بِأَسمَرَ عسّالٍ وَأَبيضَ قاضِبِ",43,"ب",1,0],["وَهَل ماتَ مِن خَوضِ الرَّدى قَبلَ يَومِهِ","فَتىً لِوَطيسِ الحَربِ ما زالَ مُفئَدا",44,"د",2,0],["وَهَل مِثلُهُ يَومَ المَعادِ وَسيلَةٌ","إِلى اللَهِ إِلّا رَهطُهُ المُتَقَدِّمُ",45,"م",1,0],["وَهَل مَنَعت يَوماً فَتاةً كَريمَةً","قلائِدُها أَو وُشحُها أَو خِدامُها",46,"م",3,0],["وَهَل مُنكِرٌ لِلضَيمِ ماتَ وَلَم يَمُت","رُوَيبِضَةٌ ما زالَ بِالدارِ ثاويا",47,"ي",2,0],["وَهل مِثلُ أََيّامٍ بِنَعَفِ سَوِيقَةٍ","رَوَاجِعُ أيّامٍ كما كُنَّ بالسَّعدِ",48,"د",1,0],["وَهَل مَرَّ لِلمُشتاقِ ذكرٌ بحيِّكُم","فَما زالَ ذكرُ الحَيِّ عِندي مردّدا",49,"د",2,0],["وهل مات بالحمى الغضنفر مرة","وفي كل يوم من لظاها له عهد",50,"د",1,0],["وهل من عزاء على فقده","سوى أن هذا مصير الورى",51,"ر",2,0],["وَهَل ماطِلٌ ديني مَعَ الوَجدِ عالِمٌ","بِما بِتُّ أَلقى في هَواهُ مِنَ الوَجدِ",52,"د",1,0],["وَهَل مِن سَبيلٍ وَالأَماني تَعِلَّةٌ","إِلى مَعهَدٍ بِالرَملِ طالَ بِهِ عَهدي",52,"د",2,0],["وَهَل مَن يُعاشِرُ ذاكَ المَهي","نَ في الأَرضِ أَخسَرُ مِن صَفقَتِه",53,"ت",2,0],["وَهَل مَقَلَت قَبلَهُ مُقلَتا","كَ أَدنى وَأَسقَطَ مِن هِمَّتِه",53,"ت",2,0],["وهل منح الدهر من منحة","امد بها المرء لم تدرج",54,"ج",1,0],["وَهَل مررتم بنعمان الاراك عَلى","نعم فأحلى الهوى نعم وَنعمان",55,"ن",1,0],["وهَلْ ملكتْ للأمرِ والنَّهْي مِقودَاً","أمَيّةُ يَوماً بعد مرْوانِها الجَعْدِ",56,"د",1,0],["وَهَلْ مَنْ ضَمَّرَ الْجُرْدَ المَذَاكي","كَمَنْ جَعَلَ الطِّرادَ لَها ضِمارا",57,"ر",2,0],["وَهَل من صفا من سالف العيش بالصَفا","يَعودُ لنا يوماً فَتَصفو المشارِعُ",58,"ع",1,0],["وهل من رحمة منكم لصب","صبا قدماً إلى الأوج الفسيح",59,"ح",1,0],["وَهَل مَضتِ الضرائبُ في صميمٍ","وَلَم يَك مِن يمينكم الحسامُ",60,"م",1,0],["وهل ممكن إسعاد من كل قد جرى","له قلم في اللوح يوماً بشقوة",61,"ه",1,0],["وهل ممكن إحصاء ذرات كلما","على الأرض من كثبان رمل مهيلة",61,"ه",1,0],["وَهَلُّمَ عَهدي بِالمِلاحِ جَميعُهُم","أَن لا يَصِحَّ لَدَيهِم ميثاقُ",62,"ق",1,0],["وَهَل مِن هَجيرِ الهَجرِ لي بِظِلالِها","مَقيلٌ وَمِن سوءِ العِثارِ مُقيلُ",63,"ل",1,0],["وهل منكُمُ إلاّ إليكمْ مَفَرُّه","فبالعُذْرِ فلْيَبْلُغْ منَ العَفْوِ مَبْلَغا",64,"غ",2,0],["وَهَل مِن فَتىً جَعدٍ سِواهُ مِنَ الوَرى","تَجودُ عَلى العِلّاتِ مِنهُ يَدٌ سَبطُ",65,"ط",1,0],["وهل مُنْكِرٌ إن كان بالنّاس قاسه","أخو نَظْرةٍ يرْمي بها فَيُصيب",66,"ب",1,0],["وَهَل مِن دُموعٍ أَو رُبوعٍ تَرَحَّلوا","فَكُلٌّ أَراها دارِساتِ المَعالِمِ",67,"م",1,0],["وَهلمَّ جَرّاً فَالجَزائِرُ جمَّةٌ","فَوضى وَكَم من زَفرَةٍ وَأَنين",68,"ن",1,0],["وَهَل منصف مِنها فَيَلزم قَومها","حمالة ما قَد أَتلَفَت أَو يَقيدُها",69,"د",3,0],["وهلْ مع الدهرِ يدومُ اصطحابْ","أُصبحُ في ظُفْرٍ له ثمّ نابْ",70,"ب",1,0],["وهل مَلِكٌ يُقاسُ إلى ابنِ يَحْيى","لَدى الهيجاءِ أو فِي كُلِّ نادِ",71,"د",1,0],["وهل مَلِكُ الإِنعامِ والجودِ عائدٌ","بإِحسانِ مَا يُولي عَلَى حُسْنِ مَا أُبْلي",72,"ل",2,0],["وهل مثل نفس المرء في القرب صاحب","تطاوعه طوراً وطوراً تفاقم",73,"م",1,0],["وهل من رجال من رخام به كما","عهدتهم لم ينفرط بينهم عقد",74,"د",1,0],["وهل من عطاء والندى الغمرُ فيكُمُ","لذي عُسرة لم يُعطَ ما تمنعينَهُ",75,"ن",2,0],["وهل مرَّ قلبيَ في التابعي","ن أم خارَ ضعفاً فلم يَتبَعِ",76,"ع",1,0],["وهل مَن أرانا الحجّ بالخَيف عائدٌ","إلى مثلها أو عدَّها حِجَّةَ العمرِ",77,"ر",1,0],["وَهَل مِثلُ أَيّامي بِنَعفِ سُوَيقَةٍ","رَواجِعُ أَيّامٍ كَما كُنَّ بِالسَعدِ",78,"د",1,0],["وهل من صلاح وهل من سماح","وهل من سياسي لنا منجد",79,"د",1,0],["وهل من همام سعى للامام","يهمة سام سما الفرقد",79,"د",1,0],["وهل ما رآه قد تطامن جأشه","به عن معمى الدائرات الشهوديه",80,"ي",2,0],["وَهَل مِثلُ أَيّامٍ تَسَلَّفنَ بِالحِمى","عَوايِدُ أَو عَيشُ السِتارَينِ راجِعُ",81,"ع",1,0],["وهل منكر فعل القطعية منكم","وما داركم إلا القطعية والكرخ",82,"خ",1,0],["وهل ما أرى في تاجه من جواهر","كواكب أم در عليه ثمين",83,"ن",1,0],["وَهل مِثل لَيلاتِ لَهُن رَواجِع","الَينا وَأَيّامُ تَحَوَّل طيبُها",84,"ب",3,0],["وَهَلْ مِنْكُمُ ذَبٌّ عَنِ الْمُلْكِ إنَّهُ","عَلَى جُرُفٍ هَارٍ غَدا يَتَهَدَّمُ",85,"م",1,0],["وهَلُمَّ نَحْوِي إنْ يَكُنْ لَكَ خِبْرَةٌ","وعَلَيّ في كُلِّ المعارِفِ أوْرِدِ",86,"د",1,0],["وهل مثلُ التِّهامي من عَظيمٍ","متى احتاجَ النهارُ إلى دَليلِ",87,"ل",1,0],["وهل مثلُ نشر العلمِ أسمَى مَزيَّةٍ","لشعبٍ ظَمِىءٍ ساغَ مَنهلَه وِردا",88,"د",2,0],["وَهَل مِزمَار داوُود بعيدٌ","ومَعزِفُ إبنه منَّا قِريبُ",89,"ب",1,1],["وَهَل مُبهِجي قدرٌ رَضي النَّاسُ مثلَه","إذا كان همَّي لا يحيط به قدرُ",90,"ر",1,0],["وهلْ مُحَّتْ رُباً كنتُ","بها أسحبُ أبرادِي",91,"د",2,0],["وهَلْ مِحْنَتِي صُغْرى لأَجل فِراقِهم","وقد أَبْصَرته يَبْطِشُ البَطْشَةَ الكُبْرَى",92,"ر",2,0],["وهل من سائل يدعو بقلب","فيعطى سؤله عند السؤال",93,"ل",1,0],["وهل مستغفر مما جناه","من الأعمال أو سوء المقال",93,"ل",1,0],["وهل من عاش لم ينهض بفعل","كمن ملأوا بخير الفعل عمرا",94,"ر",2,0],["وهل من جاهل بيتاً عريقا","بُنى قدماً على عز مقيم",95,"م",1,0],["وَهَل مِنَ الشّيحِ والحُوذانِ لي بَدَلٌ","بِالشّيح شيحٌ وَبِالحُوذانِ حُوذانُ",96,"ن",1,0],["وهَل مِن شَميم الشّيح والرَّند نَفحَةٌ","مُعنبَرةٌ في طيِّ نَشرٍ مُعنبَر",97,"ر",1,0],["وَهَل ملكٌ نالَت بِهِ مَصرُ قَبله","مَزايا بِها فَوق الكَواكب تَصعد",98,"د",1,0],["وَهَل مَواعيد عُرقوب لمرتقبٍ","إِلا مَواعيد كَذاب وَمُحتال",99,"ل",1,0],["وَهَل مِن لَحظة فيها عذولي","يَمَوتُ بِغَيظه وَقتَ التَهاني",100,"ن",2,0],["وَهَل ملك سِواك لَهُ لُغاتٌ","مُهذبة بِها يَسمو العَميد",101,"د",1,0],["وهل ما سَرَتْ من نَسَمةٍ ريحُ أرْضِها","وإلّا فَهذا الجَوُّ تَعْبَقُ رَيَّاهُ",102,"ا",2,0],["وهل من له هذي القلوب تحبه","كمثل الذي نار له وحديد",103,"د",1,0],["وهل من يرى الحقَ فوق الرجا","ل يفزع من صخب الحاقد",104,"د",1,0],["وهل من الشعب من يبني رياسته","على ثرىً بدماءِ الشعب مخضوب",105,"ب",1,0],["وَهَل مُسعِفٌ تُطفى بِهِ جَمرَةُ النّوى","وَهَيهات هَيهات أَينَ المُساعِدُ",106,"د",1,0],["وَهَل مَوتهُ أَمرٌ يُحالُ وُقوعهُ","وَآباؤُنا ماتوا وَفي اللّحدِ غُيِّبوا",107,"ب",3,0],["وهل مثلُه حر تقي وقمْقامُ","فلله ليْلاتٌ تقضُتْ وأيامُ",108,"م",1,0],["وهل ماست الأغصان تحكي معاطفاً","من الغيد لانت أن يضيع قتيلها",109,"ل",3,0],["وهلم الأمر جرا كلما","جاء وقت قلت فيما بعده",110,"د",2,0],["وهل مثل سلطان وسيف كلاهما","أخ في مقام البأس والجود ماجدُ",111,"د",1,0],["وهل مطفئٌ لي جذوةً من لظى الجوى","فقد طال ما يصلى بها مُستهامُها",112,"م",3,0],["وهل معمّر قوم خالد أبدا","ولو غدا العمر موصولا بأعمار",113,"ر",1,0],["وهل ممتع حال دائم أبدا","والدهر رهن باقبال وإدبار",113,"ر",1,0],["وَهَل مبلغي إِلّا كَريم جدوده","سَليل عتاق رَيُّه في الفَلا نشح",114,"ح",1,0],["وهَل مِن كَرِيمٍ ذي إخاءٍ أَبُثُّهُ","أَحادِيثَ أَشواقٍ لَهُنَّ ضُرُوبُ",115,"ب",1,0],["وَهَل مِن خَمسَةٍ يَوماً سِواهُم","أَتَمّوا سِتَّةً مَع جَبرَئيلا",116,"ل",2,0],["وهَل من الأثل والدكداك تعوّضه","بالأثلِ أثلاً وبالدكداك دكداكا",117,"ك",2,0],["وَهَل مدامعهُ يومَ النوى سُفحَت","وَهَل تَبرقعَ في التوديعِ أَم سَفَرا",118,"ر",2,0],["وهل مررت على احياء ذي سلم","وهل عبرت الحما والقوم سمار",119,"ر",1,0],["وهل منمخلص لله يدعو","بقلب عند ما جن الظلام",120,"م",1,0],["وهل مَعشَرٌ في النَّاسِ يَغدُو غُدِّوَّنَا","إِلى المَجدِ أو يَسرِي إلَيهِ كَمَا نَسرِي",121,"ر",2,0],["وهل مجاري ذلك الشِّعْب عَفَتْ","آثارُها أم روّضت تلك الطّرق",122,"ق",1,0],["وهل معارفنا إلا مواهبه","والكسب في ضغطة التكوين منحصر",123,"ر",1,0],["وَهَل ماتَ مَن أَلقى عَلَينا كَواكِباً","مِن الهَدي يَزهو في مَطالِعِها السَعد",124,"د",1,0],["وَهَل مُشفق القاه اِرحَم مِن لَظى","حَشائي وَمِن قاني دُموعي الهَوامل",125,"ل",1,0],["وهل من معالٍ يا مُحمّدُ لم تَنَل","إليهنَّ مَرقىً أو عليهنّ مظهرا",126,"ر",2,0],["وهل من سبيل للمصلى فكم بها","صلاة صلات للورى ونوافل",127,"ل",1,0],["وهل من طريق لاجتماع كوانس","بهم نجم أفراحي على الرمل طالع",128,"ع",1,0],["وهل مَدخلاً للرُشد أبقى وفيه مِن","مدينةِ عِلم الله قد سُدَّ بابها",129,"ب",3,0],["وهل من صقور في طيورك هذه","يصيد بها أسد القبائل صائد",130,"د",1,0],["وهل من دليل في سبيل تنوفة","أما ان طرق القوم هن سباسب",131,"ب",1,0],["وهلمّي نُبِحْ حِمَى كلِّ محظو","رٍ ونُزْرِي بِقَدْرِ كلِّ عظيم",132,"م",1,0],["وهل مصرُ إلا آية أزليةٌ","مقدًّسة والنيلُ في لوحها سطر",133,"ر",1,0],["وَهَل من الخطبَ تَنثَني نُوبٌ","لا نابَ يَعدُو لهَا ولا ظفرُ",134,"ر",1,0],["وَهَلُمَّ جَرَا لَمْ يَصُنْ مِنْ بَكْتِهَا","حِصْنُ السُّيُوفِ وَلاَ حِمَى الأتْرَاسِ",135,"س",1,0],["وهل من أذان فوق منبر ساحة","من النذر اللسن الهداة نذيرها",136,"ر",3,0],["وَهَل مِن بَشِيرٍ صادِقٍ مِنكَ يُولِنى","فإِنَّ حَشَائِى لبُّهُ يَتَسَرَّجُ",137,"ج",1,0],["وَهَل مُؤمِنٌ إِلّا يَرى فَرضَ نُصحِكُم","وَطاعَتِكُم حَقّاً كَما وَجَبَ الذِكرُ",138,"ر",1,0],["وَهَل مِصرُ إِلّا غادَةٌ عَرَبِيَّةٌ","لَها الحُسنُ عَبدٌ وَالدَلالُ غُلامُ",139,"م",1,0],["وَهَل مِصرُ إِلّا سِلعَةٌ لِمُساوِمٍ","يُراوِدُها عَن نَفسِها بَعد سودانِ",140,"ن",1,0],["وهل من أرانا الحجن بالخيف عائد","على مثلها أم عدها حجة العمر",141,"ر",1,0],["وهل مر معتقل النسيم بحاجر","فجاء بريا من بثينة عابق",142,"ق",1,0],["وهل ميقاته الغل","ة في العام أو القابل",143,"ل",1,0],["وهل ملجأ للورى يرتجى","وآمالهم في حماه جثيا",144,"ي",2,0],["وهل من ذات خلق مستقيم","لها في موقف النصح ارعواءُ",145,"ا",2,0],["وهل من ذات عقل مستنير","فيدفعها إلى الصون الدعاء",145,"ا",2,0],["وهل من شباب يشترى بعد كبرة","يدل عليه الحارث بن حبيب",146,"ب",1,0],["وهل من مشئم يذر المطايا","تشوم بلحظها برق الشآم",147,"م",1,0],["وَهَلْ من ندِيمٍ مثلهِ وَهْوَ إن جَفَا","تغاضى ولا يومي بسرِّيْ ولا يُفْشي",148,"ش",2,0],["وهل من نبات بالنمو مقّلدٌ","سواه فرَبُّ العقل في ترك ذا أحرى",149,"ر",2,0],["وهل من همّتي فضلٌ لقلبي","فتسكنَهُ سعادٌ أو نَوارُ؟",150,"ر",1,0],["وهل من سواه من إذا ذكرت له","صفات تزكى الكون منها نسائم",151,"م",1,0],["وهل من عقود الدر مثل قصيدة","بديعية وافت بحسن العواطف",152,"ف",1,0],["وهل من أولي الألباب من ليس شاكراً","لاحسان مولى منه للناس تعويد",153,"د",1,0],["وهل من خليل مُسعد الطّرف في","الدُّجى على أدمُع تهمي ومُرتقب النّجم",154,"م",1,0],["وهل ملة الإسلام ترضى بذلكم","وقد أكرمت أسلافكم بنهاها",155,"ا",3,0],["وهلمَّ الخطبَ في فاطمةٍ","مذ عَدَت خلفهم تبدى النِّياحا",156,"ح",2,0],["وهَل منَ العدلِ أو الإنصافِ","من عُصبةِ الضلال والخلاف",157,"ف",1,0],["وهل ملِكٌ يُرْجى سواك لنصْرِها","وهل غيرُ ما ترْضَى عُلاكَ طِلابُها",158,"ب",3,0],["وهلْ مِثلُهُ بحْرَ العظائِمِ عابِرٌ","لينجُو ومنْ سيْفِ المنيّةِ عابِثُ",159,"ث",1,0],["وهلْ مازَجَتْ أنفاسُ أحْبابِنا الصّبا","وإلا فلِمْ رقّتْ ولمْ عبَقَتْ نَشْرا",160,"ر",2,0],["وهل من حكى زهريّها وأمينها","بل الكل مشكور المساعي حميدها",161,"د",3,0],["وهل منك أدمى الطرف من نحو بارق","من البرق ومض راح يخفى ويلمع",162,"ع",1,0],["وهلموا لبيعة الله نادى","وعدت كل من تولى النجاة",163,"ه",1,0],["وهل من مسيحي فصيح نعدّه","اذا أينع الشعر الفصيح وأثمرا",164,"ر",2,0],["وَهَل مَن يَخاف الدَهر يحيي مخلداً","وَهَل كُل من لَم يَتق الدَهر ميت",165,"ت",1,0],["وهل مهجةٌ في التربِ تُضحي رَميمةً","يُهَنَّأ جسمٌ بعدَها أَو يُفرّح",166,"ح",1,0],["وَهَل ما مَضى يَوماً بِهِ العُمرُ راجعٌ","فَيَفسحَ لي بين المُنى وَالمنيّة",167,"ه",1,0],["وَهَل مَررتَ قَريباً مِن ديارهمُ","فَعندك اليَوم مِن أَخبارِ جيران",168,"ن",1,0],["وهل ماؤها إلا حميمٌ لحره","يذيب الذي في الكلتين من الشحم",169,"م",1,0],["وهل منكم داعٍ وهل سائل لنا","فاني أجيب السائلين وأجزل",170,"ل",1,0],["وهل من عزاء غير صون اتحادنا","وأمثال فينا للأصالة مضرب",171,"ب",1,0],["وهل مصر إلا منبت الامة التي","إذا جهدت للمجد لم يعيها الجهد",172,"د",1,0],["وهل مصر إلا موطن الفضل والحجى","وملجأ من يزري به الزمن النكد",172,"د",1,0],["وهل من مقلةٍ إلا تراها","تحاط بتوأمين من الجفون",173,"ن",1,0],["وهل من كرامةٍ ترى كاستقامةٍ","وعلمٍ لمن أعلاه ربكَ الاكرمُ",174,"م",1,0],["وهل من سبيلٍ دافعٍ غصص الردى","عن الخلق ما امتدت حياة الخلائق",175,"ق",1,0],["وهل مصائبُكُمْ لا تنقضي أبداً","وما سواهنَّ يصفو بعد تكدير",176,"ر",1,0],["وهل منك يا أسماء وصل لطامع","رماه الأسى لولا التأسي المجالد",177,"د",1,0],["وهل ما تقضّى من زمان اجتماعنا","بمردودةٍ أسحارهُ وأصائلُهْ",178,"ل",2,0],["وَهل منكرٌ أَن سادَ أهل زمانهِ","جموح إِلى العليا حرون عن الدَنَس",179,"س",1,0],["وهل مشتر روحي بشرط اجتماعنا","ولو ساعة منها فيها أنا بائع",180,"ع",1,0],["وهل مطفئاتٌ أَدمعي نارَ لوعةٍ","توقّدُ في أَرجاءِ قلبي مضيضُها",181,"ض",3,0],["وَهَلُمَّ جَرّاً مِن مَبان شُمَّخٍ","وَمَصانِعٍ بالفَضلِ جَهراً تَشهَدُ",182,"د",1,0],["وهل مقلتي قد بان عنها صبيُّها","أم البدر قد واراهُ دهراً مغاربُه",183,"ب",2,0],["وهل من خطيب يسمع القوم صيحة","ليصعق قدما بالمساوي يساجله",184,"ل",2,0],["وَهل من عودةٍ لِلرحب أنّي","بِروحي أفتَدي تِلكَ الرِحابا",185,"ب",2,0],["وَهَل مِن مُحِبٍّ كَهذا المحب","إِذا ما بَحثت جَميعَ الجِهات",186,"ت",1,0],["وهل من ناصر للحق يحمي","حقوق رسوله الهادي الشفيع",187,"ع",1,0],["وهل من قائل يوما سواهم","ليوم تفاخر في المجد لائق",188,"ق",1,0],["وهل مدد يضاف لها مناف","مرادا أو على مجراه يجري",189,"ر",2,0],["وهل مثله من جميل مهب","اصيل حسيب جليل بجال",190,"ل",1,0],["وهل محيي سواد الشام يعيي","باحياي بتسويد الجوائب",191,"ب",1,0],["وهل مبلغ عني النسيم تحية","إليهم وما بي من غرام لهم يبدي",192,"د",2,0],["وهل من معجب بابي فراس","وسهل وابن سهل وابن هاني",193,"ن",2,0],["وهل مقاصيرُهُ اللائي نشِطت لها","ملء النُّهى فرِحاتٌ حُفَّلٌ زُهُرُ",194,"ر",1,0],["وهل مثل هذا اليوم يوم لمهجتي","يروق به وِرْد القريض ويعذبُ",195,"ب",1,0],["وهل مِن بديلٍ إذ أتيتُكِ عاشقاً","وكيف وما أبدَى الزمانُ مثيلا",196,"ل",2,0],["وهل من عزيزٍ عندَ مصرٍ فأرتجي","بإدلاءِ دلوي كي تفيضَ بدائلُهْ",197,"ل",2,0],["وهل مال سينقذنا","وقد كنّا به نصخبْ",198,"ب",1,0],["وهل مِن رجاءٍ بمَن ضيّعوكِ؟","وهل مِن حياةٍ؟ أقِلّي النداءْ",199,"ا",2,0],["وهل مات مَنْ يحيا لدى الناس فعلهُ ؟","وهل عاش مجبولٌ على الذلِّ خانعُ؟",200,"ع",1,0],["وهل من إله لي سواك فإنه","إذا مسني ضر واستكشف البلوى",201,"و",2,0],["وهل مسعد والفكر يقوي بمثله","إذا جال في أشكالها النظر الفحل",202,"ل",1,0],["وهل من غنى لمعار الغنى","وهل من ثراً ليدٍ فانيه",203,"ي",2,0],["وهلم بالمسعي إلى غاياته","فلقد تجلى في مداك الخير",204,"ر",1,0],["وهل ما بقي يحويه بالرد أم لمن","سواه من الأرحام خُلْفٌ ترددا",205,"د",2,0],["وهل مثل أمسي عندما كنت قانعا","مثيل وهل يحيا كما رام قانع",206,"ع",1,0],["وهلموا للتحايا","إنما الدنيا وفاق.",207,"ق",1,0],["وهل من منادٍ للجهادِ وعزةٍ","يقولُ : صلاة ُالعرْبِ في قدسِنا الفجرُ",208,"ر",1,0],["وهل مذحج تسطو ببارقة الظبى","وتعرف هنديا لها أو يمانيا",209,"ي",2,0],["وهل مثلُ أسيافٍ تُسَلُّ لقدسِنا","سَتبقى كأوهامٍ سُيوفا من الخشب؟",210,"ب",1,0],["وهل مشفق ألقاه أرحم من لظى","حشاي ومن قاني دموعي الهواطل",211,"ل",1,0],["وَهَلْ مُبْلِغٌ عَنِّي المُتَوَّجَ حِمْيَراً","بِأَنِّي لَهُ قَدْ صِرْتُ بِالمَدْحِ كافِلا",212,"ل",2,0],["وَهَلْ مِثْلُ ذاكَ الحِصْنِ فِي مُلْكِ تُبَّعٍ","وَفِي مُلْكِ كِسْرَى مِنْ مَشِيدٍ لِشائِدِ",213,"د",1,0],["وَهَلْ مُعْصِراتُ المُزْنِ خَثَّتْ طُلُولَها","وَغَيَّرَها مِنْ ذارِياتِ الصَّبا ذَرْوُ",214,"و",1,0],["وهل من عاشر الأعداء دَهْرًا","أصابته البلاهة والخوار ؟",215,"ر",1,0],["وهل من أدار الراح يوما براحه","ورام ارتياحا في الهوى يجد الراحا",216,"ح",2,0],["وهل مِن مَْسرَحِيَّاتٍ أقيمت","سوى من أجل إسعاد الزَّبونِ؟",217,"ن",1,0],["وهل من فقيرٍ كان يوماً مُصادقي","سوى وغداً شبه الغنيِّ المُسَجَّلِ؟",218,"ل",1,0],["وهل من السهل ممنوع فيا عجبا","ما كنت أحسب أن السهل يمتنع",219,"ع",1,0],["وَ هَلُمِّي فَقَدْ عَرَانِي شَوقٌ","وَ غَزَانِي طَيفٌ وَ هَدَّ أَمَانا",220,"ن",2,0],["وهل منكرٌ فعل القطيعة منكم","وما دراكم إلا القطيعة والكرخ",221,"خ",1,0],["وَهلْ من يَقينٍ أنَّنى في ذُرى السماْ","مَشَيتُ .وَهَلْ فى الأَرضِ إنى مَعَ البَشَرْ",222,"ر",1,0],["وهل مِن بديلٍ أن أظلَّ معَذَّباً","وسُهدُ الليالي ليس منهُ بديلُ",223,"ل",1,0],["وهل ملكت كفي من الأمر ذرة","تعاتبني فيها وترجو تراخيا؟",224,"ي",2,0],["وهل مثلُ حِنّاكِ شاهدُ عرسٍ","وحلّى كمثل «يديكِ» سِوار؟",225,"ر",1,0],["وهل ما يزال العيد يصبو فؤاده","صبوّ فؤادي للأهازيج والغيدِ",226,"د",1,0],["وَهَلْ ما يزالُ الوَرْدُ مثلَ عُهُودِهِ","أمِ الوردُ في أَيْدِي الجميلاتِ يَذْبُلُ؟",227,"ل",1,0],["وهَلْ مَرَّت عليكِ غداةَ يومٍ","قلوبٌ بعدَ موْتٍ تستجيبُ ؟",228,"ب",1,0]]}