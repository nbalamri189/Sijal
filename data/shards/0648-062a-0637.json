{"poems":[[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[63,"نظرت بألحاظ الظباء العين","https://www.aldiwan.net/poem46160.html","الكامل"],[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[3,"صحا من سكره قلبي وفاق","https://www.aldiwan.net/poem180.html",""],[3,"فؤاد ليس يثنيه العذول","https://www.aldiwan.net/poem193.html",""],[77,"هلم فجفن الدهر قد لاذ بالغمض","https://www.aldiwan.net/poem36010.html","الطويل"],[86,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[93,"آنست بكم ولكن تم أنسي","https://www.aldiwan.net/poem11257.html","الوافر"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"أما آن أن تنسى من القوم أضغان","https://www.aldiwan.net/poem44992.html","الطويل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[72,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[51,"أخالد أخطأت وجه الصواب","https://www.aldiwan.net/poem8521.html","المتقارب"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[38,"تعاملني بغير وفاء وعد","https://www.aldiwan.net/poem7855.html","الوافر"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[92,"خلقت طليقا كطيف النسيم","https://www.aldiwan.net/poem38896.html","المتقارب"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"صبي الحياة الشقي العنيد","https://www.aldiwan.net/poem38958.html","المتقارب"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[78,"ألا حي أوطاني بشلب أبا بكر","https://www.aldiwan.net/poem14017.html","الطويل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"قلب يذوب ومدمع يجري","https://www.aldiwan.net/poem63661.html","أحذ الكامل"],[85,"لمن غرة تنجلي من بعيد","https://www.aldiwan.net/poem63718.html","الطويل"],[62,"عليك أقمت أرسال الكلام","https://www.aldiwan.net/poem52266.html","الوافر"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"أجد الوجد جمرة في ضميري","https://www.aldiwan.net/poem63593.html","الخفيف"],[99,"في المقهى","https://www.aldiwan.net/poem6248.html","عموديه"],[61,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[97,"حان حرماني وناداني النذير","https://www.aldiwan.net/poem24787.html","الرمل"],[80,"تظن مزار البدر عنها يعزني","https://www.aldiwan.net/poem31231.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[90,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[74,"أحس المدامة والنسيم عليل","https://www.aldiwan.net/poem13217.html","الكامل"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[46,"مكان ودهر أحرزا كل مدرك","https://www.aldiwan.net/poem23282.html","الطويل"],[46,"إن شئتما أن تنسكا فاسكنا","https://www.aldiwan.net/poem23553.html","السريع"],[76,"أزف الرحيل فودعتني مقلة","https://www.aldiwan.net/poem38981.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9959","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54848","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[77,"هلم فجفن الدهر قد لاذ بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=34170",""],[90,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[90,"عناد...","https://www.poetsgate.com/ViewPoem.aspx?id=179043",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[80,"تظنّ مزارَ البدرِ عنها يعزني","https://www.poetsgate.com/ViewPoem.aspx?id=3659",""],[91,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=53276",""]],"verses":[["وَتُطلِقُ رَحلَها وَالفَجرُ طِفلٌ","وَقَد أَكَلَ البَوانِيَ وَالمِلاطا",0,"ط",2,0],["وَتَطرُدُ ضَوءَها مِنهُ","عَلى ذُعرٍ كَواسِرُه",1,"ر",2,0],["وَتَطَرَّفي حَيثُ السَما","حُ الغَمرُ وَالحَسَبُ اللُبابُ",2,"ب",1,0],["وتطَرُّفُ القُرَناءِ يَقبُحُ بالفَتى","لكنْ دَواءُ الغادِرِ التّبْديلُ",3,"ل",1,0],["وتطوَّحَتْ بي هِمّةٌ درَأَتْ إِلى","وَجْناءَ جائِلَةِ النّسوعِ وَضِيني",4,"ن",2,0],["وتَطغَى بِنا يَومَ الوَغى جاهِليَّةٌ","تَرَدَّدُ في أعطافِنا نَخَواتُها",5,"ت",3,0],["وتُطرِبُني الذِّكرى فأشتاقُ فِتيَةً","تَدورُ على باغي القِرَى جَفَناتُها",5,"ت",3,0],["وَتُطرِبُني سُيوفُ الهِندِ حَتّى","أَهيمَ إِلى مَضارِبِها اِشتِياقا",6,"ق",2,0],["وَتَطلُبُ أَن تُلاقيني وَسَيفي","يُدَكُّ لِوَقعِهِ الجَبَلُ الثَقيلُ",7,"ل",1,0],["وَتَطْلُبُ أَحْيَاناً بِفَرْضِ رِضَاعِهِ","فَيبتَزُّ مِنْ تِلْكَ الدَّرَاهمِ بِالْفَرْضِ",8,"ض",1,0],["وَتَطمِسُ الظُلمَةُ آثارَها","فَأَنثَني أُنكِرُ ما أَلمَحُ",9,"ح",1,0],["وَتَطْرِيبُ بِإنْشَادٍ شَهَيٍّ","كَإسْعَادٍ يَجِيءُ بِغَيْرِ مَنٍّ",10,"ن",1,0],["وَتَطَوَّعُوا مُتَبَرِّعِينَ بِمَالِهِمْ","وَبِوَقْتِهِمْ نُبْلاً وَمَحْضَ تَكَرُّمِ",11,"م",1,0],["وتطفو تارةً وتغوص أخرى","وتُبدي من تماقُلها فنونا",12,"ن",2,0],["وتطرَب في البيت المقدَّس صخرة","وترتاح في البيت المحرَّم أركان",13,"ن",1,0],["وَتُطِيلُ المُرَزَّءاتُ المَقَالِي","تُ عَلَيهِ القُعُودض بَعدَ القِيَامِ",14,"م",1,0],["وتطابقت أفعاله لعفاته","فالكيس تهزل والحقائب تسمن",15,"ن",1,0],["وتطلبهُ غادةٌ كاعبٌ","فَتُحكم من أمْر أسبابِهِ",16,"ب",2,0],["وتُطلعني الأسرار في مستكنِّها","على حركاتِ الحبض منهنَّ والنَبض",17,"ض",1,0],["وتطوّلْ بركبةٍ أرتجيها","منك تُدعى فتّاحةَ الأقفالِ",18,"ل",1,0],["وَتَطاوَلَت أَعوامُهُ فَإِذا بِهِ","كَالطَودِ فيهِ صَلابَة وَوَقارُ",19,"ر",1,0],["وَتَطبَعُ في المُحَيّا بِشراً","وَتُغلِقُ في فَمِ الثَكلى اِبتِساما",20,"م",2,0],["وَتَطلُبُ بِالرِياءِ الفَوزَ جَهلاً","لَقَد أَوفَيتَ مِن بَلَدٍ سَحيقِ",21,"ق",1,0],["وتَطيرُ بالبَسَماتِ والأَنْغامِ","أَجنحَةُ الصَّدى",22,"د",2,0],["وتُطْبِقُ أَجْفانَكَ النَّيِّراتِ عن الفجرِ","والفجرُ عَذْبٌ ضيَاهْ",23,"ا",2,0],["وتَطَايرتْ زُمَرُ الملائِكِ","حولَ مضْجعِكَ الأَمينْ",24,"ن",1,0],["وتَطْلُبُ وَرْدَ الصَّبَاحِ المخ","ضَّبَ مِنْ كفِّ حَقْلٍ حَصِيدْ",25,"د",1,0],["وتطهر أرواحنا في الحياة","بنار الأسى",26,"س",2,0],["وَتُطربُني أَوتارُها وَكأَنَّني","سَمِعتُ بِأَوتار الطُلى نَغَمَ البُترِ",27,"ر",1,0],["وتطهر السودان من آفاته","وتقيمه في الأمن والإسعاد",28,"د",1,0],["وتطعن مطران في أنفه","وما أنف مطران شيئا قليلا",29,"ل",2,0],["وَتَطيبُ هامُ الحامِلينَ وَراحُهُم","مِن طيبِ مَحمَلِهِ وَطيبِ ثِيابِه",30,"ب",2,0],["وَتَطاوَلَت جُنحاً فَخُيِّلَ لي","أَنَّ الصَباحَ رَهينَةُ الحَشرِ",31,"ر",1,0],["وَتَطلُعُ بِالعَيشِ أَو بِالرَدى","عَلى الزَرعِ قائِمِهِ وَالحَصيد",32,"د",1,0],["وتُطلِعُ في جنابي منك شمساً","تُزَحزِحُ عنهُ أغباشَ الظلامِ",33,"م",1,0],["وتطفحُ أحناءُ الشِعابِ عليكمُ","بسَيْلٍ له هامُ الكُماةِ حميلُ",34,"ل",1,0],["وَتَطاوَحَتهُ كَتائِبٌ","عُجُلٌ تُسائِلُ أَينَ قَصدُه",35,"د",2,0],["وَتَطَلَّعتُ مِن نِزاعٍ إِلى الغَر","بِ وَفي الشَرقِ أُنسَتي وَسُروري",36,"ر",2,0],["وتطلعت فلم ألمح سوى","طبعة الحمرة في فنجانها",37,"ن",3,0],["وتطرُدُ الوحشَ بها أكلبٌ","داميةٌ منها المَخاليبُ",38,"ب",1,0],["وتطلعنا إلى أنجمه","فتهاوين وأصبحن لنا",39,"ن",2,0],["وتطرَحني بالعزْم من غيرِ فترَةٍ","سفائنُ بيدٍ في سفائن أبحُرِ",40,"ر",1,0],["وتطوي سراياهُ السّرَى وهباتُهُ","فأيّ انتباهٍ للعيونِ النّوائمِ",41,"م",1,0],["وَتُطَرِّقُ الغُلَواءُ مِنهُ إِذا عَدا","وَالكِبرِياءُ لَهُ بِغَيرِ مُطَرَّقِ",42,"ق",1,0],["وِتَطلّعوا يُنِرِ الطريقَ أمامَكم","قَبَسٌ يشعُّ منارهُ ، مَشبوب",43,"ب",1,0],["وَتَطَلَّعَت مِن بَرقِ كُلِّ غَمامَةٍ","في كُلِّ أُفقٍ رايَةٌ وَرَعيلُ",44,"ل",1,0],["وَتَطوي عَلى وَخزِ الأَشافي جَوانِحي","تَوالي رَزايا لا تَرى الدَمعَ شافِيا",45,"ي",2,0],["وتطعنهم لم تَعْدُ نحراً ولَبّةً","كأنّكَ في عِقْدٍ من الدُّرّ ناظم",46,"م",1,0],["وَتَطرُدُنا ساعاتُنا وَكَأَنَّنا","وَسائِقُ خَيلٍ ما تُكَفكِفُها اللُجمُ",47,"م",1,0],["وَتَطلُبانِ الأَمرَ يُعيِيكُما","وَتُفنِيانِ العُمرَ لا تُدرِكان",48,"ن",1,0],["وتَطلَّعتْ بينَ الحُدوجِ كأنَّها","شمسٌ تَطلَّعُ في خِلالِ غَمامِ",49,"م",1,0],["وتطلّعَتْ عَبرَ المدائن والقرى","مُهَجٌ يكادُ خفوقُها يتكلمُ",50,"م",1,0],["وَتُطلِقُ عاشِقاً مِن أَسرِ قَومٍ","لَهُ في حُبِّهِم أُسُرٌ وَغُلُّ",51,"ل",1,0],["وَتُطَالِعَانِ أُولِي النُّهَى بِطَرائِفٍ","تَلِجُ القُلُوبَ بِلُطْفِ الاِسْتِرْسَالِ",52,"ل",1,0],["وَتَطَّرِدُ الأَحْقَابُ مِنَّا بِمَشْهَدٍ","وَإِنْ هِيَ إِلاَّ السَّطْرُ يَتْبَعُهُ السَّطْرُ",53,"ر",1,0],["وَتُطِيعُ فِكْراً صَارِماً كَشَبَاتهَا","وَتُطِيعُ قَلْباً كَالنَّسِيمِ رَقِيقَا",54,"ق",2,0],["وتطلّ الوحشة الخر","سا كأجفان المنايا",55,"ي",2,0],["وتَطَامَنَتْ زُهْرُ الكَواكِبِ هَيْبة","لِلْمُشْرِقِ الوَضَّاحِ في عَلْيائه",56,"ا",3,0],["وتطلعَ المِحْرابُ في","جَذَلٍ وأشرقتِ المنابرْ",57,"ر",1,0],["وتَطَلَّعَ الإِسْلاَمُ في أَمْصَارِهِ","يَهْفُو لِظلِّ لِوَائِكَ المَعْقُودِ",58,"د",1,0],["وتطلب أحيانا بفرض رضاعه","فيبتز من تلك الدراهم في الفرض",59,"ض",1,0],["وتطوي على \" أُمِّ الدَّنايا \" مَباطناً","وتُلقي عليها من إباءٍ مظاهرا",60,"ر",2,0],["وتطلَّعي تَتَبَيَّني الفجرَ الذي","تتوقعينَ وتنجلي الآفاق",61,"ق",1,0],["وتطلبُ أن يُستَّل في غير طائلٍ","لسانٌ فراتيُّ المضاربِ مُرهف",62,"ف",1,0],["وتطلَّبي نُزْجِ النفوسَ عزيزةً","هَدياً وننتظمُ القُلوبَ قصائدا",63,"د",2,0],["وتطوي الضُّلوعَ على نافذٍ","من الصَّبرِ يُدمي كحزِّ المُدى",64,"ا",1,0],["وتطلَّعت لكَ دجلةٌ فتضاربت","فكأنما بعبُابها الهَيَمان",65,"ن",1,0],["وتطرحني بالعزم من عير فترة","ٍ سفائنُ بيدٍ في سفائن أبحُرِ",66,"ر",1,0],["وتطبع في المحيّا الجهم بشرا","وتغلق في فم الشّكلى ابتساما",67,"م",2,0]]}