","عموديه"]],"verses":[["وَتُطلِقُ رَحلَها وَالفَجرُ طِفلٌ","وَقَد أَكَلَ البَوانِيَ وَالمِلاطا",0,"ط",2,0],["وَتَطرُدُ ضَوءَها مِنهُ","عَلى ذُعرٍ كَواسِرُه",1,"ر",2,0],["وَتَطَرَّفي حَيثُ السَما","حُ الغَمرُ وَالحَسَبُ اللُبابُ",2,"ب",1,0],["وتطَرُّفُ القُرَناءِ يَقبُحُ بالفَتى","لكنْ دَواءُ الغادِرِ التّبْديلُ",3,"ل",1,0],["وتطوَّحَتْ بي هِمّةٌ درَأَتْ إِلى","وَجْناءَ جائِلَةِ النّسوعِ وَضِيني",4,"ن",2,0],["وتَطغَى بِنا يَومَ الوَغى جاهِليَّةٌ","تَرَدَّدُ في أعطافِنا نَخَواتُها",5,"ت",3,0],["وتُطرِبُني الذِّكرى فأشتاقُ فِتيَةً","تَدورُ على باغي القِرَى جَفَناتُها",5,"ت",3,0],["وَتُطرِبُني سُيوفُ الهِندِ حَتّى","أَهيمَ إِلى مَضارِبِها اِشتِياقا",6,"ق",2,0],["وَتَطلُبُ أَن تُلاقيني وَسَيفي","يُدَكُّ لِوَقعِهِ الجَبَلُ الثَقيلُ",7,"ل",1,0],["وَتَطْلُبُ أَحْيَاناً بِفَرْضِ رِضَاعِهِ","فَيبتَزُّ مِنْ تِلْكَ الدَّرَاهمِ بِالْفَرْضِ",8,"ض",1,0],["وَتَطمِسُ الظُلمَةُ آثارَها","فَأَنثَني أُنكِرُ ما أَلمَحُ",9,"ح",1,0],["وَتَطْرِيبُ بِإنْشَادٍ شَهَيٍّ","كَإسْعَادٍ يَجِيءُ بِغَيْرِ مَنٍّ",10,"ن",1,0],["وَتَطَوَّعُوا مُتَبَرِّعِينَ بِمَالِهِمْ","وَبِوَقْتِهِمْ نُبْلاً وَمَحْضَ تَكَرُّمِ",11,"م",1,0],["وتطفو تارةً وتغوص أخرى","وتُبدي من تماقُلها فنونا",12,"ن",2,0],["وتطرَب في البيت المقدَّس صخرة","وترتاح في البيت المحرَّم أركان",13,"ن",1,0],["وَتُطِيلُ المُرَزَّءاتُ المَقَالِي","تُ عَلَيهِ القُعُودض بَعدَ القِيَامِ",14,"م",1,0],["وتطابقت أفعاله لعفاته","فالكيس تهزل والحقائب تسمن",15,"ن",1,0],["وتطلبهُ غادةٌ كاعبٌ","فَتُحكم من أمْر أسبابِهِ",16,"ب",2,0],["وتُطلعني الأسرار في مستكنِّها","على حركاتِ الحبض منهنَّ والنَبض",17,"ض",1,0],["وتطوّلْ بركبةٍ أرتجيها","منك تُدعى فتّاحةَ الأقفالِ",18,"ل",1,0],["وَتَطاوَلَت أَعوامُهُ فَإِذا بِهِ","كَالطَودِ فيهِ صَلابَة وَوَقارُ",19,"ر",1,0],["وَتَطبَعُ في المُحَيّا بِشراً","وَتُغلِقُ في فَمِ الثَكلى اِبتِساما",20,"م",2,0],["وَتَطلُبُ بِالرِياءِ الفَوزَ جَهلاً","لَقَد أَوفَيتَ مِن بَلَدٍ سَحيقِ",21,"ق",1,0],["وتَطيرُ بالبَسَماتِ والأَنْغامِ","أَجنحَةُ الصَّدى",22,"د",2,0],["وتُطْبِقُ أَجْفانَكَ النَّيِّراتِ عن الفجرِ","والفجرُ عَذْبٌ ضيَاهْ",23,"ا",2,0],["وتَطَايرتْ زُمَرُ الملائِكِ","حولَ مضْجعِكَ الأَمينْ",24,"ن",1,0],["وتَطْلُبُ وَرْدَ الصَّبَاحِ المخ","ضَّبَ مِنْ كفِّ حَقْلٍ حَصِيدْ",25,"د",1,0],["وتطهر أرواحنا في الحياة","بنار الأسى",26,"س",2,0],["وَتُطربُني أَوتارُها وَكأَنَّني","سَمِعتُ بِأَوتار الطُلى نَغَمَ البُترِ",27,"ر",1,0],["وتطهر السودان من آفاته","وتقيمه في الأمن والإسعاد",28,"د",1,0],["وتطعن مطران في أنفه","وما أنف مطران شيئا قليلا",29,"ل",2,0],["وَتَطيبُ هامُ الحامِلينَ وَراحُهُم","مِن طيبِ مَحمَلِهِ وَطيبِ ثِيابِه",30,"ب",2,0],["وَتَطاوَلَت جُنحاً فَخُيِّلَ لي","أَنَّ الصَباحَ رَهينَةُ الحَشرِ",31,"ر",1,0],["وَتَطلُعُ بِالعَيشِ أَو بِالرَدى","عَلى الزَرعِ قائِمِهِ وَالحَصيد",32,"د",1,0],["وتُطلِعُ في جنابي منك شمساً","تُزَحزِحُ عنهُ أغباشَ الظلامِ",33,"م",1,0],["وتطفحُ أحناءُ الشِعابِ عليكمُ","بسَيْلٍ له هامُ الكُماةِ حميلُ",34,"ل",1,0],["وَتَطاوَحَتهُ كَتائِبٌ","عُجُلٌ تُسائِلُ أَينَ قَصدُه",35,"د",2,0],["وَتَطَلَّعتُ مِن نِزاعٍ إِلى الغَر","بِ وَفي الشَرقِ أُنسَتي وَسُروري",36,"ر",2,0],["وتطلعت فلم ألمح سوى","طبعة الحمرة في فنجانها",37,"ن",3,0],["وتطرُدُ الوحشَ بها أكلبٌ","داميةٌ منها المَخاليبُ",38,"ب",1,0],["وتطلعنا إلى أنجمه","فتهاوين وأصبحن لنا",39,"ن",2,0],["وتطرَحني بالعزْم من غيرِ فترَةٍ","سفائنُ بيدٍ في سفائن أبحُرِ",40,"ر",1,0],["وتطوي سراياهُ السّرَى وهباتُهُ","فأيّ انتباهٍ للعيونِ النّوائمِ",41,"م",1,0],["وَتُطَرِّقُ الغُلَواءُ مِنهُ إِذا عَدا","وَالكِبرِياءُ لَهُ بِغَيرِ مُطَرَّقِ",42,"ق",1,0],["وِتَطلّعوا يُنِرِ الطريقَ أمامَكم","قَبَسٌ يشعُّ منارهُ ، مَشبوب",43,"ب",1,0],["وَتَطَلَّعَت مِن بَرقِ كُلِّ غَمامَةٍ","في كُلِّ أُفقٍ رايَةٌ وَرَعيلُ",44,"ل",1,0],["وَتَطوي عَلى وَخزِ الأَشافي جَوانِحي","تَوالي رَزايا لا تَرى الدَمعَ شافِيا",45,"ي",2,0],["وتطعنهم لم تَعْدُ نحراً ولَبّةً","كأنّكَ في عِقْدٍ من الدُّرّ ناظم",46,"م",1,0],["وَتَطرُدُنا ساعاتُنا وَكَأَنَّنا","وَسائِقُ خَيلٍ ما تُكَفكِفُها اللُجمُ",47,"م",1,0],["وَتَطلُبانِ الأَمرَ يُعيِيكُما","وَتُفنِيانِ العُمرَ لا تُدرِكان",48,"ن",1,0],["وتَطلَّعتْ بينَ الحُدوجِ كأنَّها","شمسٌ تَطلَّعُ في خِلالِ غَمامِ",49,"م",1,0],["وتطلّعَتْ عَبرَ المدائن والقرى","مُهَجٌ يكادُ خفوقُها يتكلمُ",50,"م",1,0],["وَتُطلِقُ عاشِقاً مِن أَسرِ قَومٍ","لَهُ في حُبِّهِم أُسُرٌ وَغُلُّ",51,"ل",1,0],["وَتُطَالِعَانِ أُولِي النُّهَى بِطَرائِفٍ","تَلِجُ القُلُوبَ بِلُطْفِ الاِسْتِرْسَالِ",52,"ل",1,0],["وَتَطَّرِدُ الأَحْقَابُ مِنَّا بِمَشْهَدٍ","وَإِنْ هِيَ إِلاَّ السَّطْرُ يَتْبَعُهُ السَّطْرُ",53,"ر",1,0],["وَتُطِيعُ فِكْراً صَارِماً كَشَبَاتهَا","وَتُطِيعُ قَلْباً كَالنَّسِيمِ رَقِيقَا",54,"ق",2,0],["وتطلّ الوحشة الخر","سا كأجفان المنايا",55,"ي",2,0],["وتَطَامَنَتْ زُهْرُ الكَواكِبِ هَيْبة","لِلْمُشْرِقِ الوَضَّاحِ في عَلْيائه",56,"ا",3,0],["وتطلعَ المِحْرابُ في","جَذَلٍ وأشرقتِ المنابرْ",57,"ر",1,0],["وتَطَلَّعَ الإِسْلاَمُ في أَمْصَارِهِ","يَهْفُو لِظلِّ لِوَائِكَ المَعْقُودِ",58,"د",1,0],["وتطلب أحيانا بفرض رضاعه","فيبتز من تلك الدراهم في الفرض",59,"ض",1,0],["وتطبخ الشهب رماد الضحى","وتطحن الريح عشايا الصّقيع",60,"ع",1,0],["وتطوي على \" أُمِّ الدَّنايا \" مَباطناً","وتُلقي عليها من إباءٍ مظاهرا",61,"ر",2,0],["وتطلَّعي تَتَبَيَّني الفجرَ الذي","تتوقعينَ وتنجلي الآفاق",62,"ق",1,0],["وتطلبُ أن يُستَّل في غير طائلٍ","لسانٌ فراتيُّ المضاربِ مُرهف",63,"ف",1,0],["وتطلَّبي نُزْجِ النفوسَ عزيزةً","هَدياً وننتظمُ القُلوبَ قصائدا",64,"د",2,0],["وتطوي الضُّلوعَ على نافذٍ","من الصَّبرِ يُدمي كحزِّ المُدى",65,"ا",1,0],["وتطلَّعت لكَ دجلةٌ فتضاربت","فكأنما بعبُابها الهَيَمان",66,"ن",1,0],["وتطرحني بالعزم من عير فترة","ٍ سفائنُ بيدٍ في سفائن أبحُرِ",67,"ر",1,0],["وتطبع في المحيّا الجهم بشرا","وتغلق في فم الشّكلى ابتساما",68,"م",2,0],["وتطالع المجنون في أسماله","شلوا بأنياب السقام أكيلا",69,"ل",2,0],["وَتَطرُبُني المَثالث وَالمَثاني","وَمَع نَغم الغِنى نَعم الغِناءِ",70,"ا",2,0],["وتطمس من شأن الاعادي بوارز","ويظهر سر الله والله اكبر",71,"ر",1,0],["وتطلع في سماء القلب شمسا","لها في كونه شيء عجيب",72,"ب",1,0],["وتطلعه فجراً على الناس واضحا","يريم سبيل الحق بادي المعالم",73,"م",1,0],["وتطلُبُ مني بحقِّ الوِئام","بَقاءً لنبلُغَ أوجَ التَمام",74,"م",1,0],["وتطلبُ من حَمامِ الأيك لحنا","يَهيج بلابلَ القلب الذَّكورِ",75,"ر