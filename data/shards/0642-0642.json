{"poems":[[37,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[914,"","https://poetry.dctabudhabi.ae/diwan/poem/100536","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""],[2220,"يا أولى الألبابِ، يا أولى النُّهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19299&r=&rc=841",""]],"verses":[["قَقالَت وَيبَ غَيرِكَ كَيفَ أَقضي","غَريماً ما ذَهَبتُ لَهُ بِمالِ",0,"ل",1,0],["قَقَد قَضَّيتُ عُمري في أُناسٍ","يَرَونَ الغَدرَ دِيناً وَاِعتِقادا",1,"د",2,0],["ققسمت بينما فروحك في السما","والجسم في الأرضين للتحصين",2,"ن",1,0],["ق قضى لهذمُ القضا في القضايا","وقريعُ الردى بيوم القراع",3,"ع",1,0],["ق / قتيل قتلة القاتل قِتِل مقتول من قتلاه","يقاتل وانقتل في مقتله والقتل قتليني",4,"ن",2,0],["ققلتُ: ما بالُ سفورٍ راعني","موْعدُ الأقوَامِ إشراَقُ المَها",5,"ه",2,0]]}