{"poems":[[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[24,"رحلت إلى قومي لأدعو جلهم","https://www.aldiwan.net/poem21868.html","الطويل"],[93,"بوركت يا فاروق من فاتح","https://www.aldiwan.net/poem9825.html","عموديه"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[88,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[23,"لعمرو أبيك الخير يا شعث ما نبا","https://www.aldiwan.net/poem21234.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[51,"أيرضى الأمير أطال الإله","https://www.aldiwan.net/poem65407.html","المتقارب"],[51,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[58,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[44,"لنمنا وصرف الدهر ليس بنائم","https://www.aldiwan.net/poem30302.html","الطويل"],[105,"بمثلكما تعلو الديار وتسعد","https://www.aldiwan.net/poem43404.html","الطويل"],[40,"ليومنا بمنى إذ نحن نسكنها","https://www.aldiwan.net/poem42260.html","البسيط"],[22,"ألا كل أرماح قصار أذلة","https://www.aldiwan.net/poem21671.html","الطويل"],[52,"لم ينم همي ولم أنم","https://www.aldiwan.net/poem26680.html","المديد"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[22,"أَلاَ كُلُّ أَرْمَاحٍ قِصَارٍ أَذِلَّة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19753",""],[94,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[86,"لي وَلَدٌ سَمَّيْتُهُ حافِظاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13057&r=&rc=13",""],[110,"الديه نهب النفوس مباح","https://www.aldiwan.net/poem16449.html","الخفيف"],[116,"لي حبيب اضر بالبعد قلبي","https://www.aldiwan.net/poem41468.html","عموديه"],[129,"ثلاث تقود الصعب وهي حميدة","https://www.aldiwan.net/poem50657.html","الطويل"],[133,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[143,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[151,"بطيبة للعافين أكرم سيد","https://www.aldiwan.net/poem68590.html","الطويل"],[156,"بذمام عهدك في الهوى أتذمم","https://www.aldiwan.net/poem55560.html","الكامل"],[156,"رسم صبري في ربع شوقي محيل","https://www.aldiwan.net/poem55583.html","الخفيف"],[161,"ليوم منك والإقبال يجري","https://www.aldiwan.net/poem58985.html","الوافر"],[161,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[187,"كلح الزمان إلى الورى","https://www.aldiwan.net/poem43983.html","مجزوء الكامل"],[212,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[257,"استمع شرح قصة أنا منها","https://www.aldiwan.net/poem48471.html","الخفيف"],[276,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[276,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[276,"أحقا طربت إلى الربرب","https://www.aldiwan.net/poem25612.html","المتقارب"],[306,"إليك ومنك الحمد ربي مدى الدهر","https://www.aldiwan.net/poem56532.html","الطويل"],[372,"غنني يا أعز ذا الخلق عندي","https://www.aldiwan.net/poem56940.html","الخفيف"],[392,"حصحص الحق يا فلان بالمسير بالرحيل","https://www.aldiwan.net/poem54538.html","عموديه"],[417,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[438,"لهيب جوى قد أضمرته ضلوعه","https://www.aldiwan.net/poem2540.html","الطويل"],[438,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[438,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[459,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[459,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[459,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[462,"إذا ما عقيل باهلت يوم فخرها","https://www.aldiwan.net/poem15174.html","الطويل"],[462,"تقيل أخلاق أشياخه","https://www.aldiwan.net/poem15628.html","المتقارب"],[465,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[465,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[478,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[516,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[539,"دعاني من الهم الدفين دعانيا","https://www.aldiwan.net/poem47495.html","عموديه"],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[563,"ليوسف نصر قد وافى غلام","https://www.aldiwan.net/poem52584.html","الوافر"],[563,"ليوسف ابن الجدي اليوم قد عمرت","https://www.aldiwan.net/poem52595.html","البسيط"],[588,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["لُيوثُ الهُدى تحْمي حِمى كُلِّ خائِفٍ","غُيوثُ النّدى تهْمي على كلِّ مُضْطَرِّ",0,"ر",1,0],["لِيوفوا بِما كانوا عَلَيهِ تَعاقَدوا","بِخَيفِ مِنىً وَاللَهُ راءٍ وَسامِعُ",1,"ع",1,0],["لِيُوَلِّكَ الْرَّحْمَنُ مِنْ عِزَّةٍ","فِي المُلْكِ مَالاَ تَعْتَريهِ الخُطُوبْ",2,"ب",1,0],["لِيَوْمِكَ ذِكْرَى مَا تَقَادَمَ عَهْدُهَا","يَزِيدُ شَجَاهَا عَهْدُهَا المُتَقَادِمُ",3,"م",1,0],["لِيَومٍ مِنَ الأَيّامِ شَبَّهَ قَولَهُ","ذَوو الرَأيِ وَالأَحجاءِ مُنقَلِعَ الصَخرِ",4,"ر",1,0],["ليوث إذا ما عَبَّست في مُلِمَّة","تبسّمَت الدنيا تبّسُم ناصر",5,"ر",1,0],["لِيَومٍ أَتَت دونَ الظِلالِ سَمومُهُ","وَظَلَّ المَها صوراً جَماجِمُها تَغلي",6,"ل",2,0],["لُيوثٍ لَدى الأَشبالِ مُحمىً عَرينُها","مَداعيسُ بِالخَطِيِّ في كُلِّ مَشهَدِ",7,"د",1,0],["لُيوثٌ إِذا غَضِبوا في الحُروبِ","لا يَنكَلونَ وَلَكِن قُدُم",8,"م",1,0],["ليوم تقنَّع فيه الرجال","وتحسر فيه النساء القناعا",9,"ع",2,0],["ليوقن من يعارضني بأني","سأرهق ما بنى مبنى منيفا",10,"ف",2,1],["لَيُواصِلَنَّكَ رَكبُ شِعرٍ سائِرٍ","يَرويهِ فيكَ لِحُسنِهِ الأَعداءُ",11,"ا",2,0],["لِيَ وَقعاتٌ بِبَدرٍ","يَومَ حارَ الناسِ فيها",12,"ي",3,0],["لَيَومُكَ عِندَ الأَزدِ يَومٌ تَخَزَّعَت","خُزاعَةُ مِنها في بُطونِ التَهائِمِ",13,"م",1,0],["لِيوميكُما في الحَربِ وَالسلمِ مَشهَدٌ","يَقِرُّ بِعَينَي مَن تَطَلَّعَ يَشهَدُ",14,"د",1,0],["لِيَومُنا بِمِنى إِذ نَحنُ نَسكُنُها","أَسَرُّ مِن يَومِنا بِالعَرجِ أَو مَلَلِ",15,"ل",1,1],["لِيورِثَها بَكراً إِذا ماتَ بَعدَهُ","فَتِلكَ وَبَيتِ اللَهِ قاصِمَةُ الظَهرِ",16,"ر",1,0],["لي وَتَركي في المُدامِ فَيا","لائِمي أَقصِر وَلا تَلُمِ",17,"م",1,0],["لِيُوهِنَ عَظمَكُمُ لِلعِدى","وَعَمداً فَإن تُغلَبُوا يَغِلبِ",18,"ب",1,0],["لي وراءَ الأمواج يا بحرُ قلبٌ","نازحُ الدار ما له من مآبِ",19,"ب",1,0],["لَيَومِكَ يَوْمٌ فِيه لِلْفَتْحِ غُرَّةٌ","جَلَتْ وَجْه الاِسْتِقْلالِ مُبْتَسِمَ الثَّغْرِ",20,"ر",1,0],["لِيُورِثَنا بَكْراً إذا مات بَعْدَهُ","فتلْكَ وبَيْتِ اللّه قاصِمَة ُ الظَّهْرِ",21,"ر",1,0],["ليؤمن النّاس ما شاؤا بربّهم","فبالتحوّل بعد الله إيماني",22,"ن",2,0],["لي وَلَدٌ سَمَّيْتُهُ حافِظاً","تَيَمُّناً بحافِظِ الشَّاعِرِ",23,"ر",1,1],["ليَ وَرد مِن وَجنَتيهِ جَنيّ وَمُدام","مِن ثَغرِهِ وَأَقاح",24,"ح",1,0],["لي وفاء وللحبيب جفاء","فسلامي على قليل الوفاء",25,"ا",1,0],["ليونَةُ طبعٍ بالوثيقة بعده","كلامٌ لطيفٌ وابتذالُ الرغائبِ",26,"ب",1,0],["لُيُوثُ في لَظَى الهَيجَا غُيُوثٌ","لَدَى اللاوَى مَنَارَةٌ كُلِّ سَارِ",27,"ر",1,0],["لي وقفةٌ في الدار لا رجعت بما","أهوى ولا يأسِى عليها يُقدِمُ",28,"م",1,0],["لِيَومِ التَلاقي ذُخرَةً عِندَ رَبِّهِ","وَما أَحَدٌ بِهِ مِن مُحبِّهِ",29,"ه",1,0],["لِي وَالهَوى مَا بَيْنَ أَجْنِحَةِ الكَرى","لَيْلانِ نَوْمُهُما عَلَيَّ مُحَرَّمُ",30,"م",1,0],["لِيَ وَصْلٌ بِوَصْلِهِ أَبَداً مُغْ","رىً وَهَجْرٌ عَنْ هَجْرِهِ مَشْغُولُ",31,"ل",1,0],["ليوم منك والإقبال يجري","أحب إلى الورى من الف شهر",32,"ر",1,1],["ليوم واحد لك في الصيام","يفي بصيام غيرك ألف عام",33,"م",1,1],["ليودّني أهل الزما","ن وإن دها بفدوجه",34,"ه",1,0],["ليوثٌ غضاب البطش عند قتالهم","وهم عند ساعات اللطائف خلّان",35,"ن",1,0],["لي وعدٌ على غزالٍ غريرٍ","ينجز الوعد كل غرةِ شهر",36,"ر",1,0],["ليُوثٌ إِلَى حَرْبِ الأَعادِي دَوالِفٌ","نُجومٌ بِآفاقِ المَعالي طَوالِعُ",37,"ع",1,0],["لِيُوسِعَها التِزاماً والتثاما","كَما ازْدَحم الحَجيجُ عَلى السُتورِ",38,"ر",1,0],["لُيُوثٌ إِذا ذمَرَتْ صَمّمَت","وإن لَغَبَ الذّمْرُ لم تُغْلَب",39,"ب",1,0],["لِيوسُف مِن مجدوب فاسٍ ونشرها","إِليه من الصنهاجي يا له من نشرِ",40,"ر",1,0],["لي وما فَوقَ وَجنَتَيكَ من الوَر","دِ مُدامٌ كالمِسكِ في لَونِ وَردِ",41,"د",1,0],["لي وأهلي وكل من صار قلبي له يميل","والصلاة مع السلام",42,"م",1,0],["لي ولي منكم وأَنْتم أَهْلُها","نِعَمٌ تَرفَعُني فوق النعائم",43,"م",1,0],["لئو قر قلب المالكية إنني","غدوت بقلب ليس يهدا ولوعهُ",44,"ع",2,0],["لي ودّ إن أخلق الدهر في القل","ب جديد مؤكّد وذمام",45,"م",1,0],["لي ودّ مؤكّد ففؤادي","خافق نحوكم أشدّ خفوق",46,"ق",1,0],["لي وبلُهُ ولمن ينا","فسني الفضيلةَ مُصعِقُهْ",47,"ق",2,0],["لِيَ وِترٌ بين الركاب وأَوْلَى","من تولَّيتَ نصرَه الموتورُ",48,"ر",1,0],["لِيَ وحدي إعجازهُ والدعاوَى","طَبقُ الأرض فيه والتزويرُ",48,"ر",1,0],["ليوم المهرجان وكان عُطْلاً","وشاحٌ من فرائدها وعِقْدُ",49,"د",1,0],["ليوثٌ إذا الجأواءُ خامَتْ كماتُها","غيوثٌ إذا الشهباء أكدت غُيومُها",50,"م",3,0],["ليوثُ النِّزال غيوثُ النَّوالِ","اذا طَرقَ الحيِّ رَوْعٌ وضُرْ",51,"ر",1,0],["ليوث الوغى وغيوث اللهى تع","ل الصعاد وتروي الصعيدا",52,"د",2,0],["ليوثُ وغى همُ عطفوا ورّقوا","عشّيةَ لفّهمْ غابُ الرماح",53,"ح",1,0],["ليومِ القيامةِ يَبقى السؤال","هل الموتُ في شَكلِهِ المُبْهَمِ",54,"م",1,0],["ليوثُ وغًى يومَ الكفاحِ تراهمُ","أقلَّ عديداً في اللقاءِ وأكثرا",55,"ر",2,0],["ليوث وسمر السمهرية غابها","غيوث لها النقع المثار غيوم",56,"م",1,0],["لُيونَةُ خُلقٍ في مَضاءِ عَزيمَةٍ","كحَدٍّ وإفرِندٍ لِعَضبٍ يَمَانِيا",57,"ي",2,0],["ليوثٌ كالأجادل ضارياتٌ","على صَهَواتِ خيلٍ كالرِّئالِ",58,"ل",1,0],["ليوم بدر أتى والوجه مشتبه","بذلك اليوم يجلو لو حندس الظلمِ",59,"م",1,0],["لي وجود بمن يقول أنا","حاش لله أن أكون أنا",60,"ن",2,1],["ليُوسفُ نصرَ قد وافَى غُلامٌ","فقالَ النَّاسُ رَبِّي زِدْ وبارِكْ",61,"ك",1,1],["ليُوسُفَ ابنِ الجُدَيِّ اليومَ قد عَمَرت","دارٌ مُبارَكةٌ دارَ الهَنا فيها",62,"ي",3,1],["ليوث إذا الهيجاء شب ضرامها","بهم تقتري غدث السباع الضواير",63,"ر",1,0]]}