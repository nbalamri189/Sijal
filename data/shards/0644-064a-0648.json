["لِيُوَلِّكَ الْرَّحْمَنُ مِنْ عِزَّةٍ","فِي المُلْكِ مَالاَ تَعْتَريهِ الخُطُوبْ",2,"ب",1,0],["لِيَوْمِكَ ذِكْرَى مَا تَقَادَمَ عَهْدُهَا","يَزِيدُ شَجَاهَا عَهْدُهَا المُتَقَادِمُ",3,"م",1,0],["لِيَومٍ مِنَ الأَيّامِ شَبَّهَ قَولَهُ","ذَوو الرَأيِ وَالأَحجاءِ مُنقَلِعَ الصَخرِ",4,"ر",1,0],["ليوث إذا ما عَبَّست في مُلِمَّة","تبسّمَت الدنيا تبّسُم ناصر",5,"ر",1,0],["لِيَومٍ أَتَت دونَ الظِلالِ سَمومُهُ","وَظَلَّ المَها صوراً جَماجِمُها تَغلي",6,"ل",2,0],["لُيوثٍ لَدى الأَشبالِ مُحمىً عَرينُها","مَداعيسُ بِالخَطِيِّ في كُلِّ مَشهَدِ",7,"د",1,0],["لُيوثٌ إِذا غَضِبوا في الحُروبِ","لا يَنكَلونَ وَلَكِن قُدُم",8,"م",1,0],["ليوم تقنَّع فيه الرجال","وتحسر فيه النساء القناعا",9,"ع",2,0],["ليوقن من يعارضني بأني","سأرهق ما بنى مبنى منيفا",10,"ف",2,1],["لَيُواصِلَنَّكَ رَكبُ شِعرٍ سائِرٍ","يَرويهِ فيكَ لِحُسنِهِ الأَعداءُ",11,"ا",2,0],["لِيَ وَقعاتٌ بِبَدرٍ","يَومَ حارَ الناسِ فيها",12,"ي",3,0],["لَيَومُكَ عِندَ الأَزدِ يَومٌ تَخَزَّعَت","خُزاعَةُ مِنها في بُطونِ التَهائِمِ",13,"م",1,0],["لِيوميكُما في الحَربِ وَالسلمِ مَشهَدٌ","يَقِرُّ بِعَينَي مَن تَطَلَّعَ يَشهَدُ",14,"د",1,0],["لِيَومُنا بِمِنى إِذ نَحنُ نَسكُنُها","أَسَرُّ مِن يَومِنا بِالعَرجِ أَو مَلَلِ",15,"ل",1,1],["لِيورِثَها بَكراً إِذا ماتَ بَعدَهُ","فَتِلكَ وَبَيتِ اللَهِ قاصِمَةُ الظَهرِ",16,"ر",1,0],["لي وَتَركي في المُدامِ فَيا","لائِمي أَقصِر وَلا تَلُمِ",17,"م",1,0],["لِيُوهِنَ عَظمَكُمُ لِلعِدى","وَعَمداً فَإن تُغلَبُوا يَغِلبِ",18,"ب",1,0],["لي وراءَ الأمواج يا بحرُ قلبٌ","نازحُ الدار ما له من مآبِ",19,"ب",1,0],["لَيَومِكَ يَوْمٌ فِيه لِلْفَتْحِ غُرَّةٌ","جَلَتْ وَجْه الاِسْتِقْلالِ مُبْتَسِمَ الثَّغْرِ",20,"ر",1,0],["لِيُورِثَنا بَكْراً إذا مات بَعْدَهُ","فتلْكَ وبَيْتِ اللّه قاصِمَة ُ الظَّهْرِ",21,"ر",1,0],["ليؤمن النّاس ما شاؤا بربّهم","فبالتحوّل بعد الله إيماني",22,"ن",2,0],["لي وَلَدٌ سَمَّيْتُهُ حافِظاً","تَيَمُّناً بحافِظِ الشَّاعِرِ",23,"ر",1,1],["ليَ وَرد مِن وَجنَتيهِ جَنيّ وَمُدام","مِن ثَغرِهِ وَأَقاح",24,"ح",1,0],["لي وفاء وللحبيب جفاء","فسلامي على قليل الوفاء",25,"ا",1,0],["ليونَةُ طبعٍ بالوثيقة بعده","كلامٌ لطيفٌ وابتذالُ الرغائبِ",26,"ب",1,0],["لُيُوثُ في لَظَى الهَيجَا غُيُوثٌ","لَدَى اللاوَى مَنَارَةٌ كُلِّ سَارِ",27,"ر",1,0],["لي وقفةٌ في الدار لا رجعت بما","أهوى ولا يأسِى عليها يُقدِمُ",28,"م",1,0],["لِيَومِ التَلاقي ذُخرَةً عِندَ رَبِّهِ","وَما أَحَدٌ بِهِ مِن مُحبِّهِ",29,"ه",1,0],["لِي وَالهَوى مَا بَيْنَ أَجْنِحَةِ الكَرى","لَيْلانِ نَوْمُهُما عَلَيَّ مُحَرَّمُ",30,"م",1,0],["لِيَ وَصْلٌ بِوَصْلِهِ أَبَداً مُغْ","رىً وَهَجْرٌ عَنْ هَجْرِهِ مَشْغُولُ",31,"ل",1,0],["ليوم منك والإقبال يجري","أحب إلى الورى من الف شهر",32,"ر",1,1],["ليوم واحد لك في الصيام","يفي بصيام غيرك ألف عام",33,"م",1,1],["ليودّني أهل الزما","ن وإن دها بفدوجه",34,"ه",1,0],["ليوثٌ غضاب البطش عند قتالهم","وهم عند ساعات اللطائف خلّان",35,"ن",1,0],["لي وعدٌ على غزالٍ غريرٍ","ينجز الوعد كل غرةِ شهر",36,"ر",1,0],["ليُوثٌ إِلَى حَرْبِ الأَعادِي دَوالِفٌ","نُجومٌ بِآفاقِ المَعالي طَوالِعُ",37,"ع",1,0],["لِيُوسِعَها التِزاماً والتثاما","كَما ازْدَحم الحَجيجُ عَلى السُتورِ",38,"ر",1,0],["لُيُوثٌ إِذا ذمَرَتْ صَمّمَت","وإن لَغَبَ الذّمْرُ لم تُغْلَب",39,"ب",1,0],["لِيوسُف مِن مجدوب فاسٍ ونشرها","إِليه من الصنهاجي يا له من نشرِ",40,"ر",1,0],["لي وما فَوقَ وَجنَتَيكَ من الوَر","دِ مُدامٌ كالمِسكِ في لَونِ وَردِ",41,"د",1,0],["لي وأهلي وكل من صار قلبي له يميل","والصلاة مع السلام",42,"م",1,0],["لي ولي منكم وأَنْتم أَهْلُها","نِعَمٌ تَرفَعُني فوق النعائم",43,"م",1,0],["لئو قر قلب المالكية إنني","غدوت بقلب ليس يهدا ولوعهُ",44,"ع",2,0],["لي ودّ إن أخلق الدهر في القل","ب جديد مؤكّد وذمام",45,"م",1,0],["لي ودّ مؤكّد ففؤادي","خافق نحوكم أشدّ خفوق",46,"ق",1,0],["لي وبلُهُ ولمن ينا","فسني الفضيلةَ مُصعِقُهْ",47,"ق",2,0],["لِيَ وِترٌ بين الركاب وأَوْلَى","من تولَّيتَ نصرَه الموتورُ",48,"ر",1,0],["لِيَ وحدي إعجازهُ والدعاوَى","طَبقُ الأرض فيه والتزويرُ",48,"ر",1,0],["ليوم المهرجان وكان عُطْلاً","وشاحٌ من فرائدها وعِقْدُ",49,"د",1,0],["ليوثٌ إذا الجأواءُ خامَتْ كماتُها","غيوثٌ إذا الشهباء أكدت غُيومُها",50,"م",3,0],["ليوثُ النِّزال غيوثُ النَّوالِ","اذا طَرقَ الحيِّ رَوْعٌ وضُرْ",51,"ر",1,0],["ليوث الوغى وغيوث اللهى تع","ل الصعاد وتروي الصعيدا",52,"د",2,0],["ليوثُ وغى همُ عطفوا ورّقوا","عشّيةَ لفّهمْ غابُ الرماح",53,"ح",1,0],["ليومِ القيامةِ يَبقى السؤال","هل الموتُ في شَكلِهِ المُبْهَمِ",54,"م",1,0],["ليوثُ وغًى يومَ الكفاحِ تراهمُ","أقلَّ عديداً في اللقاءِ وأكثرا",55,"ر",2,0],["ليوث وسمر السمهرية غابها","غيوث لها النقع المثار غيوم",56,"م",1,0],["لُيونَةُ خُلقٍ في مَضاءِ عَزيمَةٍ","كحَدٍّ وإفرِندٍ لِعَضبٍ يَمَانِيا",57,"ي",2,0],["ليوثٌ كالأجادل ضارياتٌ","على صَهَواتِ خيلٍ كالرِّئالِ",58,"ل",1,0],["ليوم بدر أتى والوجه مشتبه","بذلك اليوم يجلو لو حندس الظلمِ",59,"م",1,0],["لي وجود بمن يقول أنا","حاش لله أن أكون أنا",60,"ن",2,1],["ليُوسفُ نصرَ قد وافَى غُلامٌ","فقالَ النَّاسُ رَبِّي زِدْ وبارِكْ",61,"ك",1,1],["ليُوسُفَ ابنِ الجُدَيِّ اليومَ قد عَمَرت","دارٌ مُبارَكةٌ دارَ الهَنا فيها",62,"ي",3,1],["ليوث إذا الهيجاء شب ضرامها","بهم تقتري غدث السباع الضواير",63,"ر",1,0],["لِيُوجِدَ لِي فؤاداً ضاعَ منّي","أُسائِلُ رائِحاً عنهُ وغادِ",64,"د",1,0],["ليوسف مفخرٌ يُروى ويتلى","كما يُتلى الحديث من العليِّ",65,"ي",1,0],["ليوم نال فيه الشعب قصداً","غدا في الناس إحدى الذكرياتِ",66,"ت",1,0],["لَيومٌ سعيد ذلك اليوم إنّه","لقد سرّ سادات الورى آل هاشمِ",67,"م",1,0],["ليوسف قد أَتى نجلٌ سعيدٌ","فسرَّت عندَ مولدهِ القلوبُ",68,"ب",1,1],["لِيوسف في خَير البِقاع مَناقبُ","بِها في ظِلال العَدل تَعلو مَراتبُ",69,"ب",1,1],["لِيؤدِّي تَحيَّةً مِنْ مُحِبٍّ","يَفْضَحُ الرَّنْدَ نَشْرُها والعَرارا",70,"ر",2,0],["لي وللشيخ ناصر يوم خلوه","ولنا بالخطيب أنس وسلوه",71,"ه",1,1],["ليوث اذا صالوا غيوث إذا هموا","بحور إذا جادوا سيوف افاسلوا",72,"ل",3,0],["لي وقفةُ المشتاقِ فيك فإن بدا","أثرُ العفاءِ فوقفةُ المُشْتَاط",73,"ط",1,0],["لي وَرَشانٌ تَبْهَى به الدارُ","ويسعدُ الزائرونُ والجارُ",74,"ر",1,1],["لِيوسُفَ قُل لا تَفخَرَنَّ بِحِجرةٍ","فَقَد فاقَها عِندي حِمارٌ لفايدِ",75,"د",1,1],["ليوث شرى في أجمة من يراعهم","ملوك علا من كتبهم في كتائب",76,"ب",1,0],["ليومي علي تذرف العين أدمعا","فإنها سيان رزءاً ومصرعا",77,"ع",2,0],["لِيَوْمٍ تُرى السَّبْعُ الطِّبَاقُ تَبَدَّلَتْ","دُجى ظُلَمِ الشَّرْكِ الْبَ