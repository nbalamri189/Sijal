بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[459,"إذا ما عقيل باهلت يوم فخرها","https://www.aldiwan.net/poem15174.html","الطويل"],[459,"تقيل أخلاق أشياخه","https://www.aldiwan.net/poem15628.html","المتقارب"],[462,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[462,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[475,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[513,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[536,"دعاني من الهم الدفين دعانيا","https://www.aldiwan.net/poem47495.html","عموديه"],[549,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[556,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[556,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[560,"ليوسف نصر قد وافى غلام","https://www.aldiwan.net/poem52584.html","الوافر"],[560,"ليوسف ابن الجدي اليوم قد عمرت","https://www.aldiwan.net/poem52595.html","البسيط"],[585,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["لُيوثُ الهُدى تحْمي حِمى كُلِّ خائِفٍ","غُيوثُ النّدى تهْمي على كلِّ مُضْطَرِّ",0,"ر",1,0],["لِيوفوا بِما كانوا عَلَيهِ تَعاقَدوا","بِخَيفِ مِنىً وَاللَهُ راءٍ وَسامِعُ",1,"ع",1,0],["لِيُوَلِّكَ الْرَّحْمَنُ مِنْ عِزَّةٍ","فِي المُلْكِ مَالاَ تَعْتَريهِ الخُطُوبْ",2,"ب",1,0],["لِيَوْمِكَ ذِكْرَى مَا تَقَادَمَ عَهْدُهَا","يَزِيدُ شَجَاهَا عَهْدُهَا المُتَقَادِمُ",3,"م",1,0],["لِيَومٍ مِنَ الأَيّامِ شَبَّهَ قَولَهُ","ذَوو الرَأيِ وَالأَحجاءِ مُنقَلِعَ الصَخرِ",4,"ر",1,0],["ليوث إذا ما عَبَّست في مُلِمَّة","تبسّمَت الدنيا تبّسُم ناصر",5,"ر",1,0],["لِيَومٍ أَتَت دونَ الظِلالِ سَمومُهُ","وَظَلَّ المَها صوراً جَماجِمُها تَغلي",6,"ي",1,0],["لُيوثٍ لَدى الأَشبالِ مُحمىً عَرينُها","مَداعيسُ بِالخَطِيِّ في كُلِّ مَشهَدِ",7,"د",1,0],["لُيوثٌ إِذا غَضِبوا في الحُروبِ","لا يَنكَلونَ وَلَكِن قُدُم",8,"م",1,0],["ليوم تقنَّع فيه الرجال","وتحسر فيه النساء القناعا",9,"ع",2,0],["ليوقن من يعارضني بأني","سأرهق ما بنى مبنى منيفا",10,"ف",2,1],["لَيُواصِلَنَّكَ رَكبُ شِعرٍ سائِرٍ","يَرويهِ فيكَ لِحُسنِهِ الأَعداءُ",11,"ا",2,0],["لِيَ وَقعاتٌ بِبَدرٍ","يَومَ حارَ الناسِ فيها",12,"ي",3,0],["لَيَومُكَ عِندَ الأَزدِ يَومٌ تَخَزَّعَت","خُزاعَةُ مِنها في بُطونِ التَهائِمِ",13,"م",1,0],["لِيوميكُما في الحَربِ وَالسلمِ مَشهَدٌ","يَقِرُّ بِعَينَي مَن تَطَلَّعَ يَشهَدُ",14,"د",1,0],["لِيَومُنا بِمِنى إِذ نَحنُ نَسكُنُها","أَسَرُّ مِن يَومِنا بِالعَرجِ أَو مَلَلِ",15,"ل",1,1],["لِيورِثَها بَكراً إِذا ماتَ بَعدَهُ","فَتِلكَ وَبَيتِ اللَهِ قاصِمَةُ الظَهرِ",16,"ر",1,0],["لي وَتَركي في المُدامِ فَيا","لائِمي أَقصِر وَلا تَلُمِ",17,"م",1,0],["لِيُوهِنَ عَظمَكُمُ لِلعِدى","وَعَمداً فَإن تُغلَبُوا يَغِلبِ",18,"ب",1,0],["لي وراءَ الأمواج يا بحرُ قلبٌ","نازحُ الدار ما له من مآبِ",19,"ب",1,0],["لَيَومِكَ يَوْمٌ فِيه لِلْفَتْحِ غُرَّةٌ","جَلَتْ وَجْه الاِسْتِقْلالِ مُبْتَسِمَ الثَّغْرِ",20,"ر",1,0],["لِيُورِثَنا بَكْراً إذا مات بَعْدَهُ","فتلْكَ وبَيْتِ اللّه قاصِمَة ُ الظَّهْرِ",21,"ر",1,0],["لي وَلَدٌ سَمَّيْتُهُ حافِظاً","تَيَمُّناً بحافِظِ الشَّاعِرِ",22,"ر",1,1],["ليَ وَرد مِن وَجنَتيهِ جَنيّ وَمُدام","مِن ثَغرِهِ وَأَقاح",23,"ح",1,0],["لي وفاء وللحبيب جفاء","فسلامي على قليل الوفاء",24,"ا",1,0],["ليونَةُ طبعٍ بالوثيقة بعده","كلامٌ لطيفٌ وابتذالُ الرغائبِ",25,"ب",1,0],["لُيُوثُ في لَظَى الهَيجَا غُيُوثٌ","لَدَى اللاوَى مَنَارَةٌ كُلِّ سَارِ",26,"ر",1,0],["لي وقفةٌ في الدار لا رجعت بما","أهوى ولا يأسِى عليها يُقدِمُ",27,"م",1,0],["لِيَومِ التَلاقي ذُخرَةً عِندَ رَبِّهِ","وَما أَحَدٌ بِهِ مِن مُحبِّهِ",28,"ه",1,0],["لِي وَالهَوى مَا بَيْنَ أَجْنِحَةِ الكَرى","لَيْلانِ نَوْمُهُما عَلَيَّ مُحَرَّمُ",29,"م",1,0],["لِيَ وَصْلٌ بِوَصْلِهِ أَبَداً مُغْ","رىً وَهَجْرٌ عَنْ هَجْرِهِ مَشْغُولُ",30,"ل",1,0],["ليوم منك والإقبال يجري","أحب إلى الورى من الف شهر",31,"ر",1,1],["ليوم واحد لك في الصيام","يفي بصيام غيرك ألف عام",32,"م",1,1],["ليودّني أهل الزما","ن وإن دها بفدوجه",33,"ه",1,0],["ليوثٌ غضاب البطش عند قتالهم","وهم عند ساعات اللطائف خلّان",34,"ن",1,0],["لي وعدٌ على غزالٍ غريرٍ","ينجز الوعد كل غرةِ شهر",35,"ر",1,0],["ليُوثٌ إِلَى حَرْبِ الأَعادِي دَوالِفٌ","نُجومٌ بِآفاقِ المَعالي طَوالِعُ",36,"ع",1,0],["لِيُوسِعَها التِزاماً والتثاما","كَما ازْدَحم الحَجيجُ عَلى السُتورِ",37,"ر",1,0],["لُيُوثٌ إِذا ذمَرَتْ صَمّمَت","وإن لَغَبَ الذّمْرُ لم تُغْلَب",38,"ب",1,0],["لِيوسُف مِن مجدوب فاسٍ ونشرها","إِليه من الصنهاجي يا له من نشرِ",39,"ر",1,0],["لي وما فَوقَ وَجنَتَيكَ من الوَر","دِ مُدامٌ كالمِسكِ في لَونِ وَردِ",40,"د",1,0],["لي وأهلي وكل من صار قلبي له يميل","والصلاة مع السلام",41,"م",1,0],["لي ولي منكم وأَنْتم أَهْلُها","نِعَمٌ تَرفَعُني فوق النعائم",42,"م",1,0],["لئو قر قلب المالكية إنني","غدوت بقلب ليس يهدا ولوعهُ",43,"ع",2,0],["لي ودّ إن أخلق الدهر في القل","ب جديد مؤكّد وذمام",44,"م",1,0],["لي ودّ مؤكّد ففؤادي","خافق نحوكم أشدّ خفوق",45,"ق",1,0],["لي وبلُهُ ولمن ينا","فسني الفضيلةَ مُصعِقُهْ",46,"ق",2,0],["لِيَ وِترٌ بين الركاب وأَوْلَى","من تولَّيتَ نصرَه الموتورُ",47,"ر",1,0],["لِيَ وحدي إعجازهُ والدعاوَى","طَبقُ الأرض فيه والتزويرُ",47,"ر",1,0],["ليوم المهرجان وكان عُطْلاً","وشاحٌ من فرائدها وعِقْدُ",48,"د",1,0],["ليوثٌ إذا الجأواءُ خامَتْ كماتُها","غيوثٌ إذا الشهباء أكدت غُيومُها",49,"م",3,0],["ليوثُ النِّزال غيوثُ النَّوالِ","اذا طَرقَ الحيِّ رَوْعٌ وضُرْ",50,"ر",1,0],["ليوث الوغى وغيوث اللهى تع","ل الصعاد وتروي الصعيدا",51,"د",2,0],["ليوثُ وغى همُ عطفوا ورّقوا","عشّيةَ لفّهمْ غابُ الرماح",52,"ح",1,0],["ليوثُ وغًى يومَ الكفاحِ تراهمُ","أقلَّ عديداً في اللقاءِ وأكثرا",53,"ر",2,0],["ليوث وسمر السمهرية غابها","غيوث لها النقع المثار غيوم",54,"م",1,0],["لُيونَةُ خُلقٍ في مَضاءِ عَزيمَةٍ","كحَدٍّ وإفرِندٍ لِعَضبٍ يَمَانِيا",55,"ي",2,0],["ليوثٌ كالأجادل ضارياتٌ","على صَهَواتِ خيلٍ كالرِّئالِ",56,"ل",1,0],["ليوم بدر أتى والوجه مشتبه","بذلك اليوم يجلو لو حندس الظلمِ",57,"م",1,0],["لي وجود بمن يقول أنا","حاش لله أن أكون أنا",58,"ن",2,1],["ليُوسفُ نصرَ قد وافَى غُلامٌ","فقالَ النَّاسُ رَبِّي زِدْ وبارِكْ",59,"ك",1,1],["ليُوسُفَ ابنِ الجُدَيِّ اليومَ قد عَمَرت","دارٌ مُبارَكةٌ دارَ الهَنا فيها",60,"ي",3,1],["ليوث إذا الهيجاء شب ضرامها","بهم تقتري غدث السباع الضواير",61,"ر",1,0]]}