{"poems":[[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[24,"رحلت إلى قومي لأدعو جلهم","https://www.aldiwan.net/poem21868.html","الطويل"],[93,"بوركت يا فاروق من فاتح","https://www.aldiwan.net/poem9825.html","عموديه"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[88,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[23,"لعمرو أبيك الخير يا شعث ما نبا","https://www.aldiwan.net/poem21234.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[51,"أيرضى الأمير أطال الإله","https://www.aldiwan.net/poem65407.html","المتقارب"],[51,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[58,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[44,"لنمنا وصرف الدهر ليس بنائم","https://www.aldiwan.net/poem30302.html","الطويل"],[105,"بمثلكما تعلو الديار وتسعد","https://www.aldiwan.net/poem43404.html","الطويل"],[40,"ليومنا بمنى إذ نحن نسكنها","https://www.aldiwan.net/poem42260.html","البسيط"],[22,"ألا كل أرماح قصار أذلة","https://www.aldiwan.net/poem21671.html","الطويل"],[52,"لم ينم همي ولم أنم","https://www.aldiwan.net/poem26680.html","المديد"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[22,"أَلاَ كُلُّ أَرْمَاحٍ قِصَارٍ أَذِلَّة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19753",""],[86,"لي وَلَدٌ سَمَّيْتُهُ حافِظاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13057&r=&rc=13",""]],"verses":[["لُيوثُ الهُدى تحْمي حِمى كُلِّ خائِفٍ","غُيوثُ النّدى تهْمي على كلِّ مُضْطَرِّ",0,"ر",1,0],["لِيوفوا بِما كانوا عَلَيهِ تَعاقَدوا","بِخَيفِ مِنىً وَاللَهُ راءٍ وَسامِعُ",1,"ع",1,0],["لِيُوَلِّكَ الْرَّحْمَنُ مِنْ عِزَّةٍ","فِي المُلْكِ مَالاَ تَعْتَريهِ الخُطُوبْ",2,"ب",1,0],["لِيَوْمِكَ ذِكْرَى مَا تَقَادَمَ عَهْدُهَا","يَزِيدُ شَجَاهَا عَهْدُهَا المُتَقَادِمُ",3,"م",1,0],["لِيَومٍ مِنَ الأَيّامِ شَبَّهَ قَولَهُ","ذَوو الرَأيِ وَالأَحجاءِ مُنقَلِعَ الصَخرِ",4,"ر",1,0],["ليوث إذا ما عَبَّست في مُلِمَّة","تبسّمَت الدنيا تبّسُم ناصر",5,"ر",1,0],["لِيَومٍ أَتَت دونَ الظِلالِ سَمومُهُ","وَظَلَّ المَها صوراً جَماجِمُها تَغلي",6,"ي",1,0],["لُيوثٍ لَدى الأَشبالِ مُحمىً عَرينُها","مَداعيسُ بِالخَطِيِّ في كُلِّ مَشهَدِ",7,"د",1,0],["لُيوثٌ إِذا غَضِبوا في الحُروبِ","لا يَنكَلونَ وَلَكِن قُدُم",8,"م",1,0],["ليوم تقنَّع فيه الرجال","وتحسر فيه النساء القناعا",9,"ع",2,0],["ليوقن من يعارضني بأني","سأرهق ما بنى مبنى منيفا",10,"ف",2,1],["لَيُواصِلَنَّكَ رَكبُ شِعرٍ سائِرٍ","يَرويهِ فيكَ لِحُسنِهِ الأَعداءُ",11,"ا",2,0],["لِيَ وَقعاتٌ بِبَدرٍ","يَومَ حارَ الناسِ فيها",12,"ي",3,0],["لَيَومُكَ عِندَ الأَزدِ يَومٌ تَخَزَّعَت","خُزاعَةُ مِنها في بُطونِ التَهائِمِ",13,"م",1,0],["لِيوميكُما في الحَربِ وَالسلمِ مَشهَدٌ","يَقِرُّ بِعَينَي مَن تَطَلَّعَ يَشهَدُ",14,"د",1,0],["لِيَومُنا بِمِنى إِذ نَحنُ نَسكُنُها","أَسَرُّ مِن يَومِنا بِالعَرجِ أَو مَلَلِ",15,"ل",1,1],["لِيورِثَها بَكراً إِذا ماتَ بَعدَهُ","فَتِلكَ وَبَيتِ اللَهِ قاصِمَةُ الظَهرِ",16,"ر",1,0],["لي وَتَركي في المُدامِ فَيا","لائِمي أَقصِر وَلا تَلُمِ",17,"م",1,0],["لِيُوهِنَ عَظمَكُمُ لِلعِدى","وَعَمداً فَإن تُغلَبُوا يَغِلبِ",18,"ب",1,0],["لي وراءَ الأمواج يا بحرُ قلبٌ","نازحُ الدار ما له من مآبِ",19,"ب",1,0],["لَيَومِكَ يَوْمٌ فِيه لِلْفَتْحِ غُرَّةٌ","جَلَتْ وَجْه الاِسْتِقْلالِ مُبْتَسِمَ الثَّغْرِ",20,"ر",1,0],["لِيُورِثَنا بَكْراً إذا مات بَعْدَهُ","فتلْكَ وبَيْتِ اللّه قاصِمَة ُ الظَّهْرِ",21,"ر",1,0],["لي وَلَدٌ سَمَّيْتُهُ حافِظاً","تَيَمُّناً بحافِظِ الشَّاعِرِ",22,"ر",1,1]]}