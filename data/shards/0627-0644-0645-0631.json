oetsgate.com/ViewPoem.aspx?id=214556",""],[6093,"(تغيير اسم) *","https://www.poetsgate.com/ViewPoem.aspx?id=205522",""],[6142,"المرتضى غيره رفقاً ومرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=155722",""],[6149,"شهدت ليس الشهد غير ريقه","https://www.poetsgate.com/ViewPoem.aspx?id=169627",""],[5309,"ألمرء مأخوذ بأوهامه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573830",""],[520,"قدك مثل الغصن في اعتداله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577613",""],[6290,"الْقَنْطَرَةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85654&r=&rc=43",""]],"verses":[["المَرءُ يَحظى ثُمَّ يَعلو ذِكرُهُ","حَتَّى يُزَيَّنَ بِالَّذي لَم يَفعَلِ",0,"ل",1,1],["المَرءُ إِن كانَ عاقِلاً وَرِعاً","أَشغَلَهُ عَن عُيوبِ غَيرِهِ وَرَعُه",1,"ه",1,1],["المَرءُ يَسعى ثُمَ يُدرِك مَجدَهُ","حَتّى يُزَيَّنَ بِالَّذي لَم يَفعَلِ",2,"ل",1,1],["أَلمَرْجِعُ الأَسْمَى بِحِكْمَتِهِ لِمَا","فِي الأَمْرِ مِنْ نَقْضٍ وَمِنْ إِبْرَامِ",3,"م",1,0],["المَرءُ يَدعو لِلسَلامِ","وَطولُ عَيشٍ قَد يَضُرُّه",4,"ر",2,1],["المَرءُ رَهنُ مَصائِبٍ لاتَنقَضي","حَتّى يُوارى جِسمُهُ في رَمسِهِ",5,"ه",1,1],["المرتقي درجات مجدٍ جلّ أن","يجذو سواه وجلّ عن أن يحتذى",6,"ذ",2,0],["المرتجى والأفق محجوب الحيا","والملتجا والدهر مرهوب الحنق",7,"ق",1,0],["المرغمين بما تعطي الخلافة من","درياق فاروقهم آناف أشكال",8,"ل",1,0],["المرءُ يعجزُ لا المحالة تعجزُ","والقول يُعْوِز لا فعالُك تُعْوِزُ",9,"ز",1,1],["المرثديون سادات تعدُّ لهم","من وائل مأثرات المجدِ والشرفُ",10,"ف",1,1],["المَرءُ في غَفَلاتِه وَسُباتِهِ","وَالدَهرُ كَالرِئبالِ في وَثَباتِهِ",11,"ت",2,1],["المَرءُ مُجتَهِد وَالمَوتُ مُجتَهِدٌ","أَن لَيسَ يَترُكُ فَوقَ الأَرضِ مُجتَهِدا",12,"د",2,0],["المَرءُ قيمَتُهُ المَعارِفُ وَالنُهى","ما نَفعُ باصِرَةٍ بِلا إِنسانِ",13,"ن",1,0],["المرء بالآثار تحمد بعده","يحيا ولا يحيا اذا لم تحمد",14,"د",1,0],["المرء اقدر من فوق التراب مشى","وان اكبر ما في المرء ايمان",15,"ن",1,0],["المُرضِعاتُ سَكَبنَ في وِجدانِهِ","حُبَّ الدِيارِ وَبِغضَةَ الأَعداءِ",16,"ا",2,0],["المُرَجّى نَوالُهُ وَالمُعَلّى","بَيتُهُ وَالكَريمُ عِتقاً نِجارُه",17,"ر",2,0],["المَرثَدِيّونَ أَقوامٌ تُعَدُّ لَهُم","مِن وائِلٍ مَأثُراتُ المَجدِ وَالشَرَفُ",18,"ف",1,1],["المَرءُ آفَتُهُ هَوى الدُنيا","وَالمَرءُ يَطغى كُلَّما اِستَغنى",19,"ا",1,1],["المَرءُ يوقِنُ بِالقَضاءِ وَما","يَنفَكُّ أَن يُعنى بِما يُكفى",19,"ا",1,0],["المَرءُ مُستَأنِسٌ بِمَنزِلَةٍ","تَقتُلُ سُكّانَها وَتَستَلِبُ",20,"ب",1,0],["المَرءُ يَطلُبُ وَالمَنِيَّةُ تَطلُبُه","وَيَدُ الزَمانِ تُديرُهُ وَتُقَلِّبُه",21,"ب",2,1],["المَرءُ في تَأخيرِ مُدَّتِهِ","كَالثَوبِ يَخلُقُ بَعدَ جِدَّتِهِ",22,"ت",2,1],["المَرءُ يَشقى بِكُلِّ أَمرٍ","لَم يُسعِدِ اللَهُ فيهِ جَدَّه",23,"د",2,1],["المَرءُ مُستَأثِرٌ بِما مَلَكا","وَمَن تَعامى عَن قَدرِهِ هَلَكا",24,"ك",2,1],["المَرءُ يُنقِذُهُ ما كانَ قَدَّمَ في ال","دُنيا مِنِ اِحسانِهِ فيها وَإِجمالِه",25,"ل",2,0],["المَرءُ نَحوٌ مِن خَدينِه","فيما تَكَشَّفَ مِن دَفينِه",26,"ن",2,1],["المَرءُ يَخدَعُهُ مُناهُ","وَالدَهرُ يُسرِعُ في بَلاه",27,"ا",2,1],["المَرءُ مَنظورٌ إِلَيهِ","ما دامَ يُرجى ما لَدَيهِ",28,"ي",2,1],["المَرءُ يَأمُلُ وَالآمالُ كاذِبَةٌ","وَالمَرءُ تَصحَبُهُ الآمالُ ما بَقِيا",29,"ي",2,0],["المَرءُ دُنيا نَفسِهِ","فَإِذا انقَضى فَقَدِ انقَضَت",30,"ت",1,1],["المُرتَقي فَلَكَ الفَخارِ إِذا اِغتَدى","وَإِذا بَدا فَالناسُ كَالحِرباءِ",31,"ا",2,0],["المُرضِياتُكَ ما أَرغَمتَ آنُفَها","وَالهادِياتُكَ وَهيَ الشُرَّدُ الضُلُلُ",32,"ل",1,0],["المرءُ في حُكم الحياةِ لقومهِ","وبلادِه والعصرُ عَصرُ جِهادِ",33,"د",1,0],["المَرءُ يَضعُفُ عَن إِسخاطِ صاحِبِهِ","وَالكَبشُ يَبلُغُ سُخطَ الخالِقِ الباري",34,"ي",1,0],["المَرءُ يُغبَطُ حَظُّهُ","وَاللَهوُ مِن ثَمَرِ الفُؤادِ",35,"د",1,0],["المَرءُ يَأمُلُ أَن يَعيشَ","وَطولُ عَيشٍ قَد يَضُرُّه",36,"ر",2,1],["المَرءُ حَتّى يُغَيَّبَ الشَبَحُ","مُغتَبِقٌ هَمَّهُ وَمُصطَبِحُ",37,"ح",1,1],["المَرءُ يَأبُرُ خِسَّةً في طَبعِهِ","وَلَرُبَّ صاحِبِ مُنصُلٍ أَبّارِ",38,"ر",1,1],["المَرءُ يَقدَمُ دُنياهُ عَلى خَطَرٍ","بِالكُرهِ مِنهُ وَيَنآها عَلى سَخطِ",39,"ط",1,1],["المَرءُ كَالبَدرِ بيِّناً لاحَ كامِلَةً","أَنوارُهُ عادَ لِلنُقصانِ فَاِمتَحَقا",40,"ق",2,1],["المَرءُ كَالنارِ تَبدو عِندَ مَسقَطِها","صَغيرَةً ثُمَّ تَخبو حِنَ تَحتَدِمُ",41,"م",1,1],["المَرءُ يَرغَبُ في الحَيا","ة وَطولُ عَيشٍ قَد يَضُرُّهُ",42,"ر",2,1],["المرحُ العابثُ الطروبُ","لما دعا باسمِهِ الشروقُ",43,"ق",1,0],["المرقص الزاهرت فوق غصونها","والمستخف عبيرها الفواحا",44,"ح",2,0],["المرء معتوب عَلَى فعله","كم سمع النهي فألا انتهى",45,"ه",2,1],["المرء في أردية لونت","ماس ولكن بعد هذا ردي",46,"د",2,1],["أَلمُرْتَدِي سُودَ المُسُو","حِ وَهُمْ مَنَائِرُ لِلسَّوَادْ",47,"د",1,0],["المُرُّ فِيهَا وَاللُّبَانُ نَثِيرُنَا","وَالتِّبْرُ بَعْضُ خَوَاطِرِ الشُّعَرَاءِ",48,"ا",2,0],["أَلمُرْتَجِي عَفْوَ الكَرِيم المُتَّقِي","غَضَبَ الْحَلِيمِ وَالمُحْسِنُ الْغَفَّارُ",49,"ر",1,0],["ألمُروؤات التي عاشت بنا","لم تزل تجري سعيرا في دمانا",50,"ن",2,0],["المرءُ حَرفٌ وَمَحياهُ تَحَرُّكُهُ","وَعُمرُهُ مِثلُ رومٍ أَو كَإِشمامِ",51,"م",1,0],["المرءُ مثلُ هلالٍ عند رؤيَتِه","يبدو ضئيلاً نراهُ ثمّ يتَّسِقُ",52,"ق",1,1],["المرائي ، باطنيات هنا","تحجب الرائي ، وفي عينيه تسفر",53,"ر",1,0],["المروءاتُ التي عاشت بنا","لم تزل تجري سعيراً في دِمانا",54,"ن",2,0],["المرء يبسطها والدهر يقبضُها","والنفس تنشرها والموت يطويها",55,"ي",3,0],["ألمرقص السماء في عرس الهوى","والحور ينقرن على الدفوف",56,"ف",1,0],["آل مروانَ جلالٌ وندى","وبنو العباسِ هَديٌ وضياء",57,"ا",2,0],["المرتضى اسد الله الغيور رحى","سر الغيوب امام السادة الاول",58,"ل",1,0],["المرشد الهادي إلى الطريق","والصدق والإخلاص والتحقيق",59,"ق",1,0],["المَرءُ يَسعى وَلَهُ راصِدٌ","تُنذِرُهُ العَينُ وَثَوبُ الضَرّاء",60,"ا",2,0],["المرء بالفكر لا باللحية الطولَي","والفخر بالفضل لا بالرتبة الأولى",61,"ل",2,1],["المرتقى في الملك مالا يرتقى","أبداً ولا يسمو إِليه ناظر",62,"ر",1,0],["المرسل النفحات يتبعها الغنى","والمردف الإِحسان بالإِحسان",63,"ن",1,0],["المُرتَجي وصاحبُ المعراجِ","وَهوَ زعيمُ الأنبيا ذو التاجِ",64,"ج",1,0],["المرسلُ السمرَ أشطاناً أسنتها","دِلاؤُنا وقلوبُ الفيلقِ القُلُب",65,"ب",1,0],["المرءُ يمنى بالرجا والياسِ","ويضيعُ بينهما ضعيفُ الباسِ",66,"س",1,1],["المرتضي روض الرضا من قد نضا","بعليِّ عزمٍ سيفَ حزمٍ شاهرا",67,"ر",2,0],["المرءُ كان ولم يزل متقلِّباً","والحظُّ بينَ رواحهِ وغدوِّه",68,"و",2,0],["المرأة البنتُ والأمُّ الّتي حملت","والأخت والزوج والدنيا ومعتصم",69,"م",1,0],["المَرءُ بَعدَ المَوتِ أُحدوثَةٌ","يَفنى وَتَبقى مِنهُ آثارُهُ",70,"ر",2,1],["المركز الثقب الَّذي الخَيط بِهِ","وَقَد يسمّى قطباً فاِنتبِه",71,"ه",1,1],["المُرتَقينَ من العلاء مَراقياً","منها السَّماكُ بحيثُ منه أَكُفُّنا",72,"ن",2,0],["الْمَرْكَزُ الأوّلُ الموعودُ في يَدِنَ","ورُؤيتي أصْبحَتْ نِبْرَاسَ مُعْجِزَتي",73,"ت",2,0],["المرء بينهما مصيبٌ مخطئٌ","إن كان دعواه له إغواء",74,"ا",2,0],["المرءُ بالهِمَّةِ والتَّجمُّلِ","لا بالعَديدِ الدَّثْرِ والتَّمَوُّلِ",75,"ل",1,1],["المرء لا زال في دنياه كالعرض","صميمه لسهام الموت كالغرض",76,"ض",1,1],["المرء يسعى والمنية أسرع","والدهر بينهما يسر ويفجع",77,"ع",1,1],["المرائي التي حيالي بعض من","سناها وبعضه ليس يفهم",78,"م",1,0],["المرء من ماءِ السماحة والنّدى","والناسُ منْ حماءٍ ومن صفوان",79,"ن",1,0],["المرمدي حلقِ الدّلاص وما نعي","جفنِ المهنّد من لذيذ هجوده",80,"د",2,0],["المَرءُ يَرفَعُ نَفسُهُ وَيُهينُها","وَيَزينُها بِفَعالِهِ وَيَشينُها",81,"ه",2,1],["المرشدي المنقذي المتنمي","في المجد بين آله وآله",82,"ل",2,0],["المُرتَضى المُجتَبى المَخصوص أَحمدَ مَن","اِختارَهُ اللَّهُ قَبلَ اللَّوحِ وَالقَلَمِ",83,"م",1,0],["ألمَرءُ فِي حَزَنٍ لا بُدَّ مِن فَرَحٍ","لَهُ وفِي فَرَحٍ لاَ بُدَّ من حَزَنِ",84,"ن",1,0],["آلَ مرَّاكشٍ بِذا اليوم قَرَّت","أعينٌ منكُمُ وقَرَّت عُيوني",85,"ن",2,0],["آلَ مُراكشٍ لقد غَشَّكُم مُح","تَسِبٌ أنتمُ على العِلمِ بِاسمِه",86,"ه",1,1],["المَرءُ يَجمع والدّنيا مفرّقةٌ","والعمرُ يذهب والأيّامُ تُختَلَسُ",87,"س",1,1],["المرءُ يُعطي النَّاس فَضلَة قلبهِ","وأراكَ قد أعطيتَ قلبَكَ أجمَعا",88,"ع",2,0],["المَرْءُ في الدُنيا خَيالٌ قد سَرَى","والعَيشُ مِثلُ الحُلم في سِنَةِ الكَرَى",89,"ر",2,1],["المرء يغدو بارض الله مغتبطا","ان كان ظل الصفا والا من منبسطا",90,"ط",2,1],["المرء يبغي من صميم فؤاده","في ذي المواطن ان تعادَ عكاظُ",91,"ظ",1,1],["المَرءُ يَفنَى وَيُبلَي الدَّهرُ جِدَّتَهُ","وَعُمرَهُ والجَديدانِ الجَديدانِ",92,"ن",1,0],["المرتدي برداء كل تقى","والمهتدي لطريق كل علا",93,"ل",2,0],["المرء يصعب جهده","ويلين بالمقدور صعبه",94,"ب",2,0],["المرءُ يسطو بسيفٍ واحدٍ فإذا","سطا بسيفين فالدنيا له تَبَع",95,"ع",1,0],["المرتدين من السخايا","خير أردية السخايا",96,"ا",3,0],["المَرء يَهوى نَفسهُ وَيَعشَقُ","وَإِن رَأى عَيباً فَلا يُصدِّقُ",97,"ق",1,0],["المَرجِعُ الذي لكمْ","هوَ العِراقُ الساطِعُ",98,"ع",1,0],["ألمرءُ لا قدْرَ ما يَحيا تُعَدّ ُلهُ","سِنينهُ إنما في قدْرِ ما يَثِبُ",99,"ب",1,0],["المرشد الجاري على سنن الهُدى","في الناس والإِرشاد حق لازمُ",100,"م",1,0],["المرجى نواله الغمر والمغ","شي مغناه والعلي مناره",101,"ر",2,0],["المرزبان والزمان عبده","كما الكرام الكاتبون جنده",102,"ه",1,0],["المرء صنو المرء في ظله","لا شهوة تطغى ولا من طغاة",103,"ه",1,0],["المريب الموثبّ الحقد والبغضاء","لم يفتأِ إلا ذل الأذلا",104,"ل",2,0],["المرء إن أصلح ما منه فسد","أرغم من له تصدى بالحسد",105,"د",1,0],["المرء في الدنيا يود ويقصد","لو أنه يعطى البقا ويخلد",106,"د",1,1],["المرتقين من النهى رتبا","في فخرهم من دونها زحل",107,"ل",1,0],["المرعب اعداه بسطا","في الحرب له شهد الضدُ",108,"د",1,0],["المرتقي من العلى منازلاً","من دونها مرتفع الكواكب",109,"ب",1,0],["المرتضى محمد بن العابد","لا زال في جهد الشقا يكابد",110,"د",1,0],["المَرءُ ذكر سائر","المَوت سَيف باتر",111,"ر",1,0],["المَرء دُنيا نَفسه","في يَومِهِ وَأَمسه",112,"ه",1,0],["المَرْءُ في فُسْحَةٍ كَما عَلِمُوا","حَتَّى يُرَى شِعْرُهُ وَتَأْلِيفُهْ",113,"ف",2,1],["المُرتَضى عَلامَة الدَهر الَّذي","من مَصدَر العِلم تَلقى المَدَدا",114,"د",2,0],["المرء يشرف بالآداب حيث يرى","لها وعاء لديه رحب كلكله",115,"ه",1,1],["المرأَة النصفُ من مرءٍ ببنيتها","فاصبحت كله قالت بهِ الصُحُفُ",116,"ف",1,0],["المَرءُ بِالعِلمِ وَالحُسنى رَعا وَسَما","يَسعى فَيوجِدُ نقداً حَتّى مِن عودِ",117,"د",1,0],["المرءُ للمرأَة استحلى أُسىً وجوى","يكرُّ حرباً وغزواً عابثاً بضني",118,"ي",1,1],["المَرءُ في كُلّ يَومٍ يَرتَجي غَده","وَدونَ ذَلِكَ مَخبوء لَهُ القَدرُ",119,"ر",1,0],["المَرءُ ذو صَوتٍ يَعيشُ بِهِ","في الناسِ ثُمَّ سَيَنفَدُ الصَوتُ",120,"ت",1,1],["المرء ذو صوت يعيش به","في الناس ثم سينفذ الصوت",121,"