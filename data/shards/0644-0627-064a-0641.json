,"قومي بنو عمرو ابن عو","https://www.aldiwan.net/poem21700.html","مجزوء الكامل"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"أوصي أخي إلى النديم","https://www.aldiwan.net/poem66608.html","مجزوء الكامل"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[46,"لا يفقدن خيركم مجالسكم","https://www.aldiwan.net/poem22307.html","المنسرح"],[46,"أروى دم قلبا وتلك سفاهة","https://www.aldiwan.net/poem22490.html","الكامل"],[46,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[46,"يغنيك ماحل في السجايا","https://www.aldiwan.net/poem23021.html","مجزوء البسيط"],[46,"ينسى الحوادث أفتانا وأكبرنا","https://www.aldiwan.net/poem23474.html","البسيط"],[46,"أعوذ بالله من قوم إذا سمعوا","https://www.aldiwan.net/poem23558.html","البسيط"],[76,"طعام من لست له ذاكرا","https://www.aldiwan.net/poem39320.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85761","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42502","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[49,"أمَا منَ المَوْتِ لِحَيٍّ لجَا؟","https://www.poetsgate.com/ViewPoem.aspx?id=16958",""],[45,"مَرحَباً بالخَيَالِ مِنْكِ المُطِيفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32540",""],[116,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[129,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[136,"المرء بالفكر لا باللحية الطولي","https://www.aldiwan.net/poem49189.html","البسيط"],[165,"لا يفوت الموت من حذر","https://www.aldiwan.net/poem67811.html","المديد"],[170,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[187,"لا يفرطن الود منك ولا القلى","https://www.aldiwan.net/poem43335.html","الكامل"],[187,"إنما أنت بحسك","https://www.aldiwan.net/poem43503.html","مجزوء الرمل"],[224,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[236,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[236,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[238,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[262,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[283,"لا يفرحن في ذا الزمان بخلعة","https://www.aldiwan.net/poem32696.html","الكامل"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[370,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[372,"لا يفجعنك غصن البان إن بانا","https://www.aldiwan.net/poem57003.html","الطويل"],[372,"فيما يقال مقيم قيل قد سارا","https://www.aldiwan.net/poem57428.html","البسيط"],[378,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[381,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[417,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[430,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[454,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[459,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[469,"لغير طريف من طريفي وتالدي","https://www.aldiwan.net/poem60204.html","الطويل"],[491,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[500,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[516,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[568,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[568,"يا معرضا عني بوجه مدبر","https://www.aldiwan.net/poem69540.html","الكامل"],[568,"تراه في الصدر من خساسته","https://www.aldiwan.net/poem69630.html","المنسرح"],[576,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["لا يَفضُلُ المَعنى عَلى لَفظِهِ","شَيئاً وَلا اللَفظُ عَلى المَعنى",0,"ن",2,0],["لا يَفرَحونَ إِذا نالَت رِماحُهُمُ","قَوماً وَلَيسوا مَجازيعاً إِذا نيلوا",1,"ل",3,0],["لا يُفهِموني قَولَهُم","وَيَدِقُّ عَنهُم ما أَقولُ",2,"ل",1,0],["لا يَفزَعَنَّ بَنو المُهَلَّبِ إِنَّهُ","لا يُدرِكُ التِرَةَ الذَليلُ الأَخضَعُ",3,"ع",1,0],["لايَفتَحُ الناسُ بابَ مَكرُمَةٍ","صاحِبُها المُستَغاثُ يُقفِلُها",4,"ل",3,0],["لا يفتأ الليل أن ترمى كواكبه","نبلاً ولا الصبح أن تنضى صوارمه",5,"م",2,0],["لا يفي وافٍ بمن أنت مُطْرٍ","أو يُسوَّى بالشَّراب السرابُ",6,"ب",1,0],["لا يَفُوتَنَّك في ده","رك كبرى مُسمِعاتِهْ",7,"ت",2,0],["لا يفخرنَّ ذوو العلا","إن المفاخرَ تاجُ رأسه",8,"س",2,0],["لا يفرحوا فوشيكاً","تبدو وطرفُك سامي",9,"م",2,0],["لا يُفْسدَنّ ثناكَ زورُ مُزَوِّرٍ","وثناكَ نَشْرُ الوردِ والنَّسرين",10,"ن",1,0],["لا يَفقَهونَ الحُزنَ غَيرَ تَأَوُّهٍ","ما الحُزنُ غَيرُ تَأُوُّهِ الأَطفالِ",11,"ل",1,0],["لا يَفقِدُ الناسُ خَيراً ما بَقيتَ لَنا","وَالجودُ وَالعَدلُ مَفقودانِ إِن فَقَدوا",12,"د",3,0],["لا يَفْتِنَنَّكَ شُكْرِي إِنْ ظَفِرْتَ بهِ","فإنّها فُرْصَةٌ وافَتْكَ مِنْ كَثَبِ",13,"ب",1,0],["لايُفيدُ الصَديقَ مَن لايُفيدُ ال","عيسَ حَظّاً مِنَ الوَجا وَالوَجيفِ",14,"ف",1,0],["لاَ يَفرَغُ الأعداءُ منك فإنَّهم","بإِزاءِ شُغلٍ في قِراعِك شاغِلِ",15,"ل",1,0],["لا يَفخَرِ الناسُ بِأَنسابِهِم","فَإِنَّما الناسُ تُرابٌ وَما",16,"ا",1,0],["لا يَفوتُ القُبولُ مَن رُزِقَ العَق","لَ وَحُسنَ الإِصدارِ وَالإيرادِ",17,"د",1,0],["لا يُفْلتُ الجريُ من أيدي عزائمه","أو يجعلَ الهامَ أجفانَ الظبا البُتُرِ",18,"ر",1,0],["لا يُفِيقُونَ مِنْ دُوَارٍ فَهَاوٍ","لِيَدَيْهِ وَرَاعِفُ الأَنْفِ دَامِي",19,"م",2,0],["لا يُفلِحُ القَومُ تَستَعصي عَمايَتُهُم","عَلى الهُداةِ وَلَو جاءوا بِفُرقانِ",20,"ن",1,0],["لا يُفلِحُ الأَقوامُ ما جَهِلوا وَلا","يُرجى لَهُم في الهالِكينَ نُشورُ",21,"ر",1,0],["لا يُفلِحُ المَرءُ يَنفي النُصحَ مَسمَعُهُ","إِذا دَعا جامِحَ الأَقوامِ داعيها",22,"ي",3,0],["لا يَفخَلونَ وَلا تَطيشُ رِماحُهُم","أَهلٌ لِغُرِّ قَصائِدي وَتَمَدُّحي",23,"ي",1,0],["لا يَفشَلونَ وَلا تَبي","تُ عَلى أُنوفِهِمُ الخَواطِم",24,"م",1,0],["لا يفزعون غداة الروع إن فزعوا","إلا إلى جلل في الحادث الجَلَلِ",25,"ل",1,0],["لا يَفْقِدَنّكَ ذو سمْعٍ وذو بصَرٍ","فأنْتَ أكرَمُ مسموعٍ ومَرْئيّ",26,"ي",1,0],["لا يفلتَنكَ ولو بقيتَ","على الصراطِ المستقيم",27,"م",1,0],["لا يَفشَلونَ وَلا تُرجى سُقاطَتُهُم","إِذا عَلا زَأرُ آسادٍ لِآسادِ",28,"د",1,0],["لا يَفتُرُ البُختُ وَالبِغالُ مَوا","قيراً خَراجاً يُجبى لَهُ دَأَبا",29,"ب",2,0],["لا يَفقِدَن خَيرَكُم مُجالِسُكُم","وَلا تَكونوا كَأَنَّكُم سَبَخُ",30,"خ",1,1],["لا يُفجِعَنَّكَ وَالخَطوبُ كَثيرَةٌ","أَنَّ الغَوادِرَ لِلفِراقِ غَوادِ",31,"د",1,0],["لا يَفخَرَنَّ الهاشَميُّ","عَلى اِمرِئٍ مِن آلِ بَربَر",32,"ر",1,0],["لا يَفرَحَن بِالحَياةِ غِرٌّ","فَإِنَّها مَهلَكاً تَسوقُ",33,"ق",1,0],["لا يَفرَحَنَّ بِهَذا المالِ جامِعُهُ","لِيُحزِنَنَّكَ صافي التِبرِ إِن خُزِنا",34,"ن",2,0],["لا يَفرَحَنَّ بِمَولودٍ ذَوُو شَرفٍ","فَإِنَّما بُشَراءُ الطِفلِ ناعوهُ",35,"ع",3,0],["لا يُفطرُ الصائمُ من أكلهِ","لكنَّه صومٌ لمن أفطرا",36,"ر",2,0],["لا يفيد الإيمان من بعد كفرٍ","وكذا جَد الطائشين عثور",37,"ر",1,0],["لا يَفوق الإنسان في كونه الحي","وانَ إلا في العقل والأخلاق",38,"ق",1,1],["لا يفيدهم لغط","بعد ما طما اللهب",39,"ب",1,0],["لا يَفْعَلُ السُّوءَ إِلَّا بَعْدَ مَقْدِرَةٍ","وَلا يُكَفْكِفُ إِلَّا بَعْدَ إِيذاءِ",40,"ا",2,0],["لاَ يُفْرَق المُقْتَنِي حُسَاماً","عَنِ الَّتِي تَقْتَنِي السِّوَارْ",41,"ر",1,0],["لا يفتننَّ بَياضُ ال","خُدودِ وَالإِحمِرارُ",42,"ر",1,0],["لا يَفْرَحَنَّ المُفْترون بجَولَة","كسبوا بدَايَتَها، وخابَ مَنِ افْتَرى!",43,"ر",2,0],["لا يَفْخَرِ النّاسُ بأحسابِهِمْ","فإنَّما النَّاسُ تُرابٌ ومَا",44,"ا",1,0],["لا يُفيدُ الصّديقَ مَنْ لا يُفيدُ ال","عِيسَ حَظّاً من الوَجَى والوَجِيفِ",45,"ف",1,0],["لا يفيض السراب قط شرابا","لا ولا يرسل المياه الجهام",46,"م",1,0],["لا يِفَظٍّ ولا غليظٍ على الأبعد","كلا ولا على أقرْبائه",47,"ا",3,0],["لا يفخر الحرّ بالوجه الجميل ولا ال","خاء الأسيل ولا الإعراض إن نيلا",48,"ل",2,0],["لا يَفوتُ المَوتَ مِن حَذَرٍ","إِن وَقاهُ الغابُ وَالغيلُ",49,"ل",1,1],["لا يَفزَعُونَ إِذا الصَريخُ دَهاهُمُ","إِلّا إِلى الإِسراجِ وَالإِلجامِ",50,"م",1,0],["لا يفرطنّ الود منك ولا القلى","وألزمهما بالقصد والإجمال",51,"ل",1,1],["لا يفوتنّك في يو","مك ما فات بأمسك",52,"ك",1,0],["لا يَفتَأونَ يردّدونَ بِجَهلِهِم","ما تنتنُ الآذانُ من تردادِهِ",53,"د",2,0],["لا يَفخَرَنَّ الشامِتونَ فَإِنَّما ال","دُنيا تُحيلُ صُروفَها الأَحوالا",54,"ل",2,0],["لا يَفخَرونَ بِمُلكٍ شامِخٍ وَبِهِم","تُمسي المَمالِكُ في الآفاقِ تَفتَخِرُ",55,"ر",1,0],["لاَ يَفْتَحَنْ بَابَ الْمُنَى","مَنْ لَمْ يَفُزْ مِنْهُ بِمِقْلَدْ",56,"د",1,0],["لا يفقهون وشر من صاحبته","أن تصحب الأعمى الأصم الأبكما",57,"م",2,0],["لا يَفرَحَن في ذا الزَمانِ بِخِلعَةٍ","والٍ هُوَ المَعزولُ وَالمَصروفُ",58,"ف",1,1],["لا يَفسَحُ التَقصيرُ فيها لِسِوى","مَن لَم يَنَل شَأوَ ذَوِيِّها لِلقَصَر",59,"ر",1,0],["لا يفقهُ النجوى إذا حدثته","وإذا أتى بحديثه لم يُفقهِ",60,"ه",1,0],["لا يَفجَعنَّكَ غُصنُ البانِ إن بانا","واخرُج أعوِّضكَ منه اليوم أغصانا",61,"ن",2,1],["لا يَفزعونَ عليه حينَ يُفزِعُهم","إلا ليستاقَ في الأموالِ أعمارا",62,"ر",2,0],["لا يفتأُ القلبُ الشَجي","يُ مُؤَمِّلاً لا يَفتأُ",63,"ا",1,0],["لايَفيق الدَهر مَن يَرشفُهُ","وَيَعيب المسك مَن يَعرِفُهُ",64,"ه",1,0],["لا يفقهون حديث مكرمة","فيهزّهم نظمي ولا نثري",65,"ر",2,0],["لا يفي كل مرءٍ حق شيمتهِ","تبت يداه أفي عينيه أغفالُ",66,"ل",1,0],["لا يفقدُ الحُّر مهما غابَ نخوته","وَحُبَّهُ أهله في كلِّ ما فَعلاَ",67,"ل",2,0],["لا يفرقون مكدَّراً صعِدت به","لهم الدلاءُ إذا استقَوا أم سلسلا",68,"ل",2,0],["لِأَيِّ فَتىً دَهري أَروحُ وَأَغتَدي","لِتَفريقِ أَموالٍ وَجَمعِ مَحامِدي",69,"د",2,0],["لا يُفزِعُ البَهمَةَ سِرحانُها","وَلا رَواياها حِياضُ الأَنيس",70,"س",1,0],["لا يَفْزَعُونَ إِلَى مَخَافَةِ جَارِهِمْ","أَمْ هَلْ لِحَتْفٍ رَاصِدٍ مِنْ مُنْتَأَى",71,"ا",1,0],["لا يفرحن بدر غدوت سمية","فالبدر دون علاك أعشى ناظر",72,"ر",1,0],["لا يفضُلُ الأقوامَ إلّا ماجدٌ","دبّتْ إلى أيدي الرّجال فُضولُهُ",73,"ل",2,0],["لا يَفقِدِ الدينُ خَيلاً أَنتَ قائِدُها","يُعهَدنَ في كُلِّ ثَغرٍ غَيرِ مَعهودِ",74,"د",1,0],["لاَ يَفْهَمُ النَّجْوَى إِذَا خَاطَبْتَهُ","وَحَدِيْثُهُ مُسْتَحْسَنٌ مَفْهُومُ",75,"م",1,0],["لاَ يَفْلِتَنَّكَ شُكْرُنَا وَثَنَاؤُنَا","فَتَعَضَّ مِنْ نَدَمٍ عَلَيْهِ الأُنْمُلَهْ",76,"ل",2,0],["لا يَفْهَمُ القَوْلَ فِي الخِطَابِ وَلاَ","يُفْهِمُهُ فَهْوَ أَبْكَمُ أَخْرَسْ",77,"س",1,0],["لا يَفْهَمْ الدَّهرُ قصدَ قلبي فَلا","ينفكُّ يأْتِي بِغَيرِ مَا قَصَدا",78,"د",2,0]]}