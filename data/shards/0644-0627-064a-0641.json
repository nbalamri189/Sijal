://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""],[5956,"جُزْتِ التصورَ عمّا كنتُ أحسبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=207235",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6208,"مصر الشعراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85678&r=&rc=0",""],[6318,"صِدْقُ الوَفَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66153&r=&rc=3",""],[572,"تَراهُ في الصّدرِ من خَساسَتِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9348&r=&rc=205",""]],"verses":[["لا يَفضُلُ المَعنى عَلى لَفظِهِ","شَيئاً وَلا اللَفظُ عَلى المَعنى",0,"ن",2,0],["لا يَفرَحونَ إِذا نالَت رِماحُهُمُ","قَوماً وَلَيسوا مَجازيعاً إِذا نيلوا",1,"ل",3,0],["لا يُفهِموني قَولَهُم","وَيَدِقُّ عَنهُم ما أَقولُ",2,"ل",1,0],["لا يَفزَعَنَّ بَنو المُهَلَّبِ إِنَّهُ","لا يُدرِكُ التِرَةَ الذَليلُ الأَخضَعُ",3,"ع",1,0],["لايَفتَحُ الناسُ بابَ مَكرُمَةٍ","صاحِبُها المُستَغاثُ يُقفِلُها",4,"ل",3,0],["لا يفتأ الليل أن ترمى كواكبه","نبلاً ولا الصبح أن تنضى صوارمه",5,"م",2,0],["لا يفي وافٍ بمن أنت مُطْرٍ","أو يُسوَّى بالشَّراب السرابُ",6,"ب",1,0],["لا يَفُوتَنَّك في ده","رك كبرى مُسمِعاتِهْ",7,"ت",2,0],["لا يفخرنَّ ذوو العلا","إن المفاخرَ تاجُ رأسه",8,"س",2,0],["لا يفرحوا فوشيكاً","تبدو وطرفُك سامي",9,"م",2,0],["لا يُفْسدَنّ ثناكَ زورُ مُزَوِّرٍ","وثناكَ نَشْرُ الوردِ والنَّسرين",10,"ن",1,0],["لا يَفقَهونَ الحُزنَ غَيرَ تَأَوُّهٍ","ما الحُزنُ غَيرُ تَأُوُّهِ الأَطفالِ",11,"ل",1,0],["لا يَفقِدُ الناسُ خَيراً ما بَقيتَ لَنا","وَالجودُ وَالعَدلُ مَفقودانِ إِن فَقَدوا",12,"د",3,0],["لا يَفْتِنَنَّكَ شُكْرِي إِنْ ظَفِرْتَ بهِ","فإنّها فُرْصَةٌ وافَتْكَ مِنْ كَثَبِ",13,"ب",1,0],["لايُفيدُ الصَديقَ مَن لايُفيدُ ال","عيسَ حَظّاً مِنَ الوَجا وَالوَجيفِ",14,"ف",1,0],["لاَ يَفرَغُ الأعداءُ منك فإنَّهم","بإِزاءِ شُغلٍ في قِراعِك شاغِلِ",15,"ل",1,0],["لا يَفخَرِ الناسُ بِأَنسابِهِم","فَإِنَّما الناسُ تُرابٌ وَما",16,"ا",1,0],["لا يَفوتُ القُبولُ مَن رُزِقَ العَق","لَ وَحُسنَ الإِصدارِ وَالإيرادِ",17,"د",1,0],["لا يُفْلتُ الجريُ من أيدي عزائمه","أو يجعلَ الهامَ أجفانَ الظبا البُتُرِ",18,"ر",1,0],["لا يُفِيقُونَ مِنْ دُوَارٍ فَهَاوٍ","لِيَدَيْهِ وَرَاعِفُ الأَنْفِ دَامِي",19,"م",2,0],["لا يُفلِحُ القَومُ تَستَعصي عَمايَتُهُم","عَلى الهُداةِ وَلَو جاءوا بِفُرقانِ",20,"ن",1,0],["لا يُفلِحُ الأَقوامُ ما جَهِلوا وَلا","يُرجى لَهُم في الهالِكينَ نُشورُ",21,"ر",1,0],["لا يُفلِحُ المَرءُ يَنفي النُصحَ مَسمَعُهُ","إِذا دَعا جامِحَ الأَقوامِ داعيها",22,"ي",3,0],["لا يَفخَلونَ وَلا تَطيشُ رِماحُهُم","أَهلٌ لِغُرِّ قَصائِدي وَتَمَدُّحي",23,"ي",1,0],["لا يَفشَلونَ وَلا تَبي","تُ عَلى أُنوفِهِمُ الخَواطِم",24,"م",1,0],["لا يفزعون غداة الروع إن فزعوا","إلا إلى جلل في الحادث الجَلَلِ",25,"ل",1,0],["لا يَفْقِدَنّكَ ذو سمْعٍ وذو بصَرٍ","فأنْتَ أكرَمُ مسموعٍ ومَرْئيّ",26,"ي",1,0],["لا يفلتَنكَ ولو بقيتَ","على الصراطِ المستقيم",27,"م",1,0],["لا يَفشَلونَ وَلا تُرجى سُقاطَتُهُم","إِذا عَلا زَأرُ آسادٍ لِآسادِ",28,"د",1,0],["لا يَفتُرُ البُختُ وَالبِغالُ مَوا","قيراً خَراجاً يُجبى لَهُ دَأَبا",29,"ب",2,0],["لا يَفقِدَن خَيرَكُم مُجالِسُكُم","وَلا تَكونوا كَأَنَّكُم سَبَخُ",30,"خ",1,1],["لا يُفجِعَنَّكَ وَالخَطوبُ كَثيرَةٌ","أَنَّ الغَوادِرَ لِلفِراقِ غَوادِ",31,"د",1,0],["لا يَفخَرَنَّ الهاشَميُّ","عَلى اِمرِئٍ مِن آلِ بَربَر",32,"ر",1,0],["لا يَفرَحَن بِالحَياةِ غِرٌّ","فَإِنَّها مَهلَكاً تَسوقُ",33,"ق",1,0],["لا يَفرَحَنَّ بِهَذا المالِ جامِعُهُ","لِيُحزِنَنَّكَ صافي التِبرِ إِن خُزِنا",34,"ن",2,0],["لا يَفرَحَنَّ بِمَولودٍ ذَوُو شَرفٍ","فَإِنَّما بُشَراءُ الطِفلِ ناعوهُ",35,"ع",3,0],["لا يُفطرُ الصائمُ من أكلهِ","لكنَّه صومٌ لمن أفطرا",36,"ر",2,0],["لا يفيد الإيمان من بعد كفرٍ","وكذا جَد الطائشين عثور",37,"ر",1,0],["لا يَفوق الإنسان في كونه الحي","وانَ إلا في العقل والأخلاق",38,"ق",1,1],["لا يفيدهم لغط","بعد ما طما اللهب",39,"ب",1,0],["لاَ يَفْرَحُونَ إِذَا مَا فَازَ فَائِزُهُمْ","ولاَ تُرَدُّ عَلَيْهِمُ أُرْبَةُ اليَسَرِ",40,"ر",1,0],["لا يَفْعَلُ السُّوءَ إِلَّا بَعْدَ مَقْدِرَةٍ","وَلا يُكَفْكِفُ إِلَّا بَعْدَ إِيذاءِ",41,"ا",2,0],["لاَ يُفْرَق المُقْتَنِي حُسَاماً","عَنِ الَّتِي تَقْتَنِي السِّوَارْ",42,"ر",1,0],["لا يفتننَّ بَياضُ ال","خُدودِ وَالإِحمِرارُ",43,"ر",1,0],["لا يَفْرَحَنَّ المُفْترون بجَولَة","كسبوا بدَايَتَها، وخابَ مَنِ افْتَرى!",44,"ر",2,0],["لا يَفْخَرِ النّاسُ بأحسابِهِمْ","فإنَّما النَّاسُ تُرابٌ ومَا",45,"ا",1,0],["لا يُفيدُ الصّديقَ مَنْ لا يُفيدُ ال","عِيسَ حَظّاً من الوَجَى والوَجِيفِ",46,"ف",1,0],["لا يفيض السراب قط شرابا","لا ولا يرسل المياه الجهام",47,"م",1,0],["لا يِفَظٍّ ولا غليظٍ على الأبعد","كلا ولا على أقرْبائه",48,"ا",3,0],["لا يفخر الحرّ بالوجه الجميل ولا ال","خاء الأسيل ولا الإعراض إن نيلا",49,"ل",2,0],["لا يَفوتُ المَوتَ مِن حَذَرٍ","إِن وَقاهُ الغابُ وَالغيلُ",50,"ل",1,1],["لا يَفزَعُونَ إِذا الصَريخُ دَهاهُمُ","إِلّا إِلى الإِسراجِ وَالإِلجامِ",51,"م",1,0],["لا يفرطنّ الود منك ولا القلى","وألزمهما بالقصد والإجمال",52,"ل",1,1],["لا يفوتنّك في يو","مك ما فات بأمسك",53,"ك",1,0],["لا يَفتَأونَ يردّدونَ بِجَهلِهِم","ما تنتنُ الآذانُ من تردادِهِ",54,"د",2,0],["لا يَفخَرَنَّ الشامِتونَ فَإِنَّما ال","دُنيا تُحيلُ صُروفَها الأَحوالا",55,"ل",2,0],["لا يَفخَرونَ بِمُلكٍ شامِخٍ وَبِهِم","تُمسي المَمالِكُ في الآفاقِ تَفتَخِرُ",56,"ر",1,0],["لاَ يَفْتَحَنْ بَابَ الْمُنَى","مَنْ لَمْ يَفُزْ مِنْهُ بِمِقْلَدْ",57,"د",1,0],["لا يفقهون وشر من صاحبته","أن تصحب الأعمى الأصم الأبكما",58,"م",2,0],["لا يَفرَحَن في ذا الزَمانِ بِخِلعَةٍ","والٍ هُوَ المَعزولُ وَالمَصروفُ",59,"ف",1,1],["لا يَفسَحُ التَقصيرُ فيها لِسِوى","مَن لَم يَنَل شَأوَ ذَوِيِّها لِلقَصَر",60,"ر",1,0],["لا يفقهُ النجوى إذا حدثته","وإذا أتى بحديثه لم يُفقهِ",61,"ه",1,0],["لا يَفجَعنَّكَ غُصنُ البانِ إن بانا","واخرُج أعوِّضكَ منه اليوم أغصانا",62,"ن",2,1],["لا يَفزعونَ عليه حينَ يُفزِعُهم","إلا ليستاقَ في الأموالِ أعمارا",63,"ر",2,0],["لا يفتأُ القلبُ الشَجي","يُ مُؤَمِّلاً لا يَفتأُ",64,"ا",1,0],["لايَفيق الدَهر مَن يَرشفُهُ","وَيَعيب المسك مَن يَعرِفُهُ",65,"ه",1,0],["لا يفقهون حديث مكرمة","فيهزّهم نظمي ولا نثري",66,"ر",2,0],["لا يفي كل مرءٍ حق شيمتهِ","تبت يداه أفي عينيه أغفالُ",67,"ل",1,0],["لا يفقدُ الحُّر مهما غابَ نخوته","وَحُبَّهُ أهله في كلِّ ما فَعلاَ",68,"ل",2,0],["لا يفرقون مكدَّراً صعِدت به","لهم الدلاءُ إذا استقَوا أم سلسلا",69,"ل",2,0],["لِأَيِّ فَتىً دَهري أَروحُ وَأَغتَدي","لِتَفريقِ أَموالٍ وَجَمعِ مَحامِدي",70,"د",2,0],["لا يُفزِعُ البَهمَةَ سِرحانُها","وَلا رَواياها حِياضُ الأَنيس",71,"س",1,0],["لا يَفْزَعُونَ إِلَى مَخَافَةِ جَارِهِمْ","أَمْ هَلْ لِحَتْفٍ رَاصِدٍ مِنْ مُنْتَأَى",72,"ا",1,0],["لا يفرحن بدر غدوت سمية","فالبدر دون علاك أعشى ناظر",73,"ر",1,0],["لا يفضُلُ الأقوامَ إلّا ماجدٌ","دبّتْ إلى أيدي الرّجال فُضولُهُ",74,"ل",2,0],["لا يَفقِدِ الدينُ خَيلاً أَنتَ قائِدُها","يُعهَدنَ في كُلِّ ثَغرٍ غَيرِ مَعهودِ",75,"د",1,0],["لاَ يَفْهَمُ النَّجْوَى إِذَا خَاطَبْتَهُ","وَحَدِيْثُهُ مُسْتَحْسَنٌ مَفْهُومُ",76,"م",1,0],["لاَ يَفْلِتَنَّكَ شُكْرُنَا وَثَنَاؤُنَا","فَتَعَضَّ مِنْ نَدَمٍ عَلَيْهِ الأُنْمُلَهْ",77,"ل",2,0],["لا يَفْهَمُ القَوْلَ فِي الخِطَابِ وَلاَ","يُفْهِمُهُ فَهْوَ أَبْكَمُ أَخْرَسْ",78,"س",1,0],["لا يَفْهَمْ الدَّهرُ قصدَ قلبي فَلا","ينفكُّ يأْتِي بِغَيرِ مَا قَصَدا",79,"د",2,0],["لا يُفصَل الخَطبُ إن هُم سَكَتُوا","ولا يَعِزُّ الصَّوابُ إن نَطَقوا",80,"ق",3,0],["لا يُفصَلُ الخَطبُ إن غابوا لغيرهمُ","ولا يُردُّ إلى الساداتِ إن شهدوا",81,"د",3,0],["لا يفخرِ الغرب بالغادات لابسةً","تاجَ البلاغةِ تجلو رايةَ الأدبِ",82,"ب",1,1],["لا يفعلون جميلاً قبل مسألةٍ","كالعير لولا أذى الباكور لم يسر",83,"ر",1,0],["لا يفوت الضعيف للدهر تحوي","لٌ ولا يضمن القويُّ الخلودا",84,"د",2,0],["لا يفزعون إلى الغريب وإن رأوا","سيف القريب عليهم مسلولا",85,"ل",2,0],["لا يَفعَل الخَير وَلَو في وَلَده","إِلّا إِذا كانَت عَصاهُ في يَدِه",86,"ه",1,0],["لا يفقَهونَ لها فوّقت من حكمٍ","في الشعر والناسُ أعداءٌ لما جهلوا",87,"ل",3,0],["لا يفعلون ما به الله حكم","وليس يرضون بكل ما حكم",88,