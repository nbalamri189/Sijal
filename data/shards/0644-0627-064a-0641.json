{"poems":[[55,"ومستهلات كصوب الحيا","https://www.aldiwan.net/poem29643.html","السريع"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[56,"إني أجالس معشرا","https://www.aldiwan.net/poem27383.html","مجزوء الكامل"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[49,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[74,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[53,"أيها المهدي ثناء جميلا شارك التنميق فيه الصواب","https://www.aldiwan.net/poem8504.html","الخفيف"],[53,"ما لمن حسنه الله وأعلى درجاته","https://www.aldiwan.net/poem8696.html","مجزوء الرمل"],[53,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[53,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[53,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[93,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[58,"إني ببابك لا ودي يقربني","https://www.aldiwan.net/poem58643.html","البسيط"],[47,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[63,"تأبى الصبابة أن تصيخ لعاذل","https://www.aldiwan.net/poem51494.html","الكامل"],[51,"أما من الموت لحي نجا","https://www.aldiwan.net/poem10321.html","السريع"],[68,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[82,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[107,"زلت بأفهام الثقات قضية","https://www.aldiwan.net/poem43110.html","الكامل"],[107,"هي الحماية هب اليوم داعيها","https://www.aldiwan.net/poem43142.html","البسيط"],[13,"فهم وعدوان قوم إن لقيتهم","https://www.aldiwan.net/poem2230.html","الكامل"],[22,"قومي بنو عمرو ابن عو","https://www.aldiwan.net/poem21700.html","مجزوء الكامل"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"أوصي أخي إلى النديم","https://www.aldiwan.net/poem66608.html","مجزوء الكامل"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[52,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[48,"لا يفقدن خيركم مجالسكم","https://www.aldiwan.net/poem22307.html","المنسرح"],[48,"أروى دم قلبا وتلك سفاهة","https://www.aldiwan.net/poem22490.html","الكامل"],[48,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[48,"يغنيك ماحل في السجايا","https://www.aldiwan.net/poem23021.html","مجزوء البسيط"],[48,"ينسى الحوادث أفتانا وأكبرنا","https://www.aldiwan.net/poem23474.html","البسيط"],[48,"أعوذ بالله من قوم إذا سمعوا","https://www.aldiwan.net/poem23558.html","البسيط"],[78,"طعام من لست له ذاكرا","https://www.aldiwan.net/poem39320.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85761","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42502","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[108,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[51,"أمَا منَ المَوْتِ لِحَيٍّ لجَا؟","https://www.poetsgate.com/ViewPoem.aspx?id=16958",""],[47,"مَرحَباً بالخَيَالِ مِنْكِ المُطِيفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32540",""],[119,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[139,"المرء بالفكر لا باللحية الطولي","https://www.aldiwan.net/poem49189.html","البسيط"],[168,"لا يفوت الموت من حذر","https://www.aldiwan.net/poem67811.html","المديد"],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[190,"لا يفرطن الود منك ولا القلى","https://www.aldiwan.net/poem43335.html","الكامل"],[190,"إنما أنت بحسك","https://www.aldiwan.net/poem43503.html","مجزوء الرمل"],[227,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[239,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[239,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[241,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[265,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[286,"لا يفرحن في ذا الزمان بخلعة","https://www.aldiwan.net/poem32696.html","الكامل"],[353,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[373,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[375,"لا يفجعنك غصن البان إن بانا","https://www.aldiwan.net/poem57003.html","الطويل"],[375,"فيما يقال مقيم قيل قد سارا","https://www.aldiwan.net/poem57428.html","البسيط"],[381,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[384,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[420,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[433,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[456,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[461,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[471,"لغير طريف من طريفي وتالدي","https://www.aldiwan.net/poem60204.html","الطويل"],[493,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[502,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[518,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[554,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[556,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[570,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[570,"يا معرضا عني بوجه مدبر","https://www.aldiwan.net/poem69540.html","الكامل"],[570,"تراه في الصدر من خساسته","https://www.aldiwan.net/poem69630.html","المنسرح"],[578,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"],[931,"","https://poetry.dctabudhabi.ae/diwan/poem/133894","الكامل"],[970,"","https://poetry.dctabudhabi.ae/diwan/poem/22612","البسيط"]],"verses":[["لا يَفضُلُ المَعنى عَلى لَفظِهِ","شَيئاً وَلا اللَفظُ عَلى المَعنى",0,"ن",2,0],["لا يَفرَحونَ إِذا نالَت رِماحُهُمُ","قَوماً وَلَيسوا مَجازيعاً إِذا نيلوا",1,"ل",3,0],["لا يُفهِموني قَولَهُم","وَيَدِقُّ عَنهُم ما أَقولُ",2,"ل",1,0],["لا يَفزَعَنَّ بَنو المُهَلَّبِ إِنَّهُ","لا يُدرِكُ التِرَةَ الذَليلُ الأَخضَعُ",3,"ع",1,0],["لايَفتَحُ الناسُ بابَ مَكرُمَةٍ","صاحِبُها المُستَغاثُ يُقفِلُها",4,"ل",3,0],["لا يفتأ الليل أن ترمى كواكبه","نبلاً ولا الصبح أن تنضى صوارمه",5,"م",2,0],["لا يفي وافٍ بمن أنت مُطْرٍ","أو يُسوَّى بالشَّراب السرابُ",6,"ب",1,0],["لا يَفُوتَنَّك في ده","رك كبرى مُسمِعاتِهْ",7,"ت",2,0],["لا يفخرنَّ ذوو العلا","إن المفاخرَ تاجُ رأسه",8,"س",2,0],["لا يفرحوا فوشيكاً","تبدو وطرفُك سامي",9,"م",2,0],["لا يُفْسدَنّ ثناكَ زورُ مُزَوِّرٍ","وثناكَ نَشْرُ الوردِ والنَّسرين",10,"ن",1,0],["لا يَفقَهونَ الحُزنَ غَيرَ تَأَوُّهٍ","ما الحُزنُ غَيرُ تَأُوُّهِ الأَطفالِ",11,"ل",1,0],["لا يَفقِدُ الناسُ خَيراً ما بَقيتَ لَنا","وَالجودُ وَالعَدلُ مَفقودانِ إِن فَقَدوا",12,"د",3,0],["لا يَفْتِنَنَّكَ شُكْرِي إِنْ ظَفِرْتَ بهِ","فإنّها فُرْصَةٌ وافَتْكَ مِنْ كَثَبِ",13,"ب",1,0],["لايُفيدُ الصَديقَ مَن لايُفيدُ ال","عيسَ حَظّاً مِنَ الوَجا وَالوَجيفِ",14,"ف",1,0],["لاَ يَفرَغُ الأعداءُ منك فإنَّهم","بإِزاءِ شُغلٍ في قِراعِك شاغِلِ",15,"ل",1,0],["لا يَفخَرِ الناسُ بِأَنسابِهِم","فَإِنَّما الناسُ تُرابٌ وَما",16,"ا",1,0],["لا يَفوتُ القُبولُ مَن رُزِقَ العَق","لَ وَحُسنَ الإِصدارِ وَالإيرادِ",17,"د",1,0],["لا يُفْلتُ الجريُ من أيدي عزائمه","أو يجعلَ الهامَ أجفانَ الظبا البُتُرِ",18,"ر",1,0],["لا يُفِيقُونَ مِنْ دُوَارٍ فَهَاوٍ","لِيَدَيْهِ وَرَاعِفُ الأَنْفِ دَامِي",19,"م",2,0],["لا يُفلِحُ القَومُ تَستَعصي عَمايَتُهُم","عَلى الهُداةِ وَلَو جاءوا بِفُرقانِ",20,"ن",1,0],["لا يُفلِحُ الأَقوامُ ما جَهِلوا وَلا","يُرجى لَهُم في الهالِكينَ نُشورُ",21,"ر",1,0],["لا يُفلِحُ المَرءُ يَنفي النُصحَ مَسمَعُهُ","إِذا دَعا جامِحَ الأَقوامِ داعيها",22,"ي",3,0],["لا يَفخَلونَ وَلا تَطيشُ رِماحُهُم","أَهلٌ لِغُرِّ قَصائِدي وَتَمَدُّحي",23,"ي",1,0],["لا يَفشَلونَ وَلا تَبي","تُ عَلى أُنوفِهِمُ الخَواطِم",24,"م",1,0],["لا يفزعون غداة الروع إن فزعوا","إلا إلى جلل في الحادث الجَلَلِ",25,"ل",1,0],["لا يَفْقِدَنّكَ ذو سمْعٍ وذو بصَرٍ","فأنْتَ أكرَمُ مسموعٍ ومَرْئيّ",26,"ي",1,0],["لا يفلتَنكَ ولو بقيتَ","على الصراطِ المستقيم",27,"م",1,0],["لا يَفشَلونَ وَلا تُرجى سُقاطَتُهُم","إِذا عَلا زَأرُ آسادٍ لِآسادِ",28,"د",1,0],["لا يَفتُرُ البُختُ وَالبِغالُ مَوا","قيراً خَراجاً يُجبى لَهُ دَأَبا",29,"ب",2,0],["لا يَفقِدَن خَيرَكُم مُجالِسُكُم","وَلا تَكونوا كَأَنَّكُم سَبَخُ",30,"خ",1,1],["لا يُفجِعَنَّكَ وَالخَطوبُ كَثيرَةٌ","أَنَّ الغَوادِرَ لِلفِراقِ غَوادِ",31,"د",1,0],["لا يَفخَرَنَّ الهاشَميُّ","عَلى اِمرِئٍ مِن آلِ بَربَر",32,"ر",1,0],["لا يَفرَحَن بِالحَياةِ غِرٌّ","فَإِنَّها مَهلَكاً تَسوقُ",33,"ق",1,0],["لا يَفرَحَنَّ بِهَذا المالِ جامِعُهُ","لِيُحزِنَنَّكَ صافي التِبرِ إِن خُزِنا",34,"ن",2,0],["لا يَفرَحَنَّ بِمَولودٍ ذَوُو شَرفٍ","فَإِنَّما بُشَراءُ الطِفلِ ناعوهُ",35,"ع",3,0],["لا يُفطرُ الصائمُ من أكلهِ","لكنَّه صومٌ لمن أفطرا",36,"ر",2,0],["لا يفيد الإيمان من بعد كفرٍ","وكذا جَد الطائشين عثور",37,"ر",1,0],["لا يَفوق الإنسان في كونه الحي","وانَ إلا في العقل والأخلاق",38,"ق",1,1],["لا يفيدهم لغط","بعد ما طما اللهب",39,"ب",1,0],["لاَ يَفْرَحُونَ إِذَا مَا فَازَ فَائِزُهُمْ","ولاَ تُرَدُّ عَلَيْهِمُ أُرْبَةُ اليَسَرِ",40,"ر",1,0],["لا يَفْعَلُ السُّوءَ إِلَّا بَعْدَ مَقْدِرَةٍ","وَلا يُكَفْكِفُ إِلَّا بَعْدَ إِيذاءِ",41,"ا",2,0],["لاَ يُفْرَق المُقْتَنِي حُسَاماً","عَنِ الَّتِي تَقْتَنِي السِّوَارْ",42,"ر",1,0],["لا يفتننَّ بَياضُ ال","خُدودِ وَالإِحمِرارُ",43,"ر",1,0],["لا يَفْرَحَنَّ المُفْترون بجَولَة","كسبوا بدَايَتَها، وخابَ مَنِ افْتَرى!",44,"ر",2,0],["لا يَفْخَرِ النّاسُ بأحسابِهِمْ","فإنَّما النَّاسُ تُرابٌ ومَا",45,"ا",1,0],["لا يُفيدُ الصّديقَ مَنْ لا يُفيدُ ال","عِيسَ حَظّاً من الوَجَى والوَجِيفِ",46,"ف",1,0],["لا يفيض السراب قط شرابا","لا ولا يرسل المياه الجهام",47,"م",1,0],["لا يِفَظٍّ ولا غليظٍ على الأبعد","كلا ولا على أقرْبائه",48,"ا",3,0],["لا يفخر الحرّ بالوجه الجميل ولا ال","خاء الأسيل ولا الإعراض إن نيلا",49,"ل",2,0],["لا يَفوتُ المَوتَ مِن حَذَرٍ","إِن وَقاهُ الغابُ وَالغيلُ",50,"ل",1,1],["لا يَفزَعُونَ إِذا الصَريخُ دَهاهُمُ","إِلّا إِلى الإِسراجِ وَالإِلجامِ",51,"م",1,0],["لا يفرطنّ الود منك ولا القلى","وألزمهما بالقصد والإجمال",52,"ل",1,1],["لا يفوتنّك في يو","مك ما فات بأمسك",53,"ك",1,0],["لا يَفتَأونَ يردّدونَ بِجَهلِهِم","ما تنتنُ الآذانُ من تردادِهِ",54,"د",2,0],["لا يَفخَرَنَّ الشامِتونَ فَإِنَّما ال","دُنيا تُحيلُ صُروفَها الأَحوالا",55,"ل",2,0],["لا يَفخَرونَ بِمُلكٍ شامِخٍ وَبِهِم","تُمسي المَمالِكُ في الآفاقِ تَفتَخِرُ",56,"ر",1,0],["لاَ يَفْتَحَنْ بَابَ الْمُنَى","مَنْ لَمْ يَفُزْ مِنْهُ بِمِقْلَدْ",57,"د",1,0],["لا يفقهون وشر من صاحبته","أن تصحب الأعمى الأصم الأبكما",58,"م",2,0],["لا يَفرَحَن في ذا الزَمانِ بِخِلعَةٍ","والٍ هُوَ المَعزولُ وَالمَصروفُ",59,"ف",1,1],["لا يَفسَحُ التَقصيرُ فيها لِسِوى","مَن لَم يَنَل شَأوَ ذَوِيِّها لِلقَصَر",60,"ر",1,0],["لا يفقهُ النجوى إذا حدثته","وإذا أتى بحديثه لم يُفقهِ",61,"ه",1,0],["لا يَفجَعنَّكَ غُصنُ البانِ إن بانا","واخرُج أعوِّضكَ منه اليوم أغصانا",62,"ن",2,1],["لا يَفزعونَ عليه حينَ يُفزِعُهم","إلا ليستاقَ في الأموالِ أعمارا",63,"ر",2,0],["لا يفتأُ القلبُ الشَجي","يُ مُؤَمِّلاً لا يَفتأُ",64,"ا",1,0],["لايَفيق الدَهر مَن يَرشفُهُ","وَيَعيب المسك مَن يَعرِفُهُ",65,"ه",1,0],["لا يفقهون حديث مكرمة","فيهزّهم نظمي ولا نثري",66,"ر",2,0],["لا يفي كل مرءٍ حق شيمتهِ","تبت يداه أفي عينيه أغفالُ",67,"ل",1,0],["لا يفقدُ الحُّر مهما غابَ نخوته","وَحُبَّهُ أهله في كلِّ ما فَعلاَ",68,"ل",2,0],["لا يفرقون مكدَّراً صعِدت به","لهم الدلاءُ إذا استقَوا أم سلسلا",69,"ل",2,0],["لِأَيِّ فَتىً دَهري أَروحُ وَأَغتَدي","لِتَفريقِ أَموالٍ وَجَمعِ مَحامِدي",70,"د",2,0],["لا يُفزِعُ البَهمَةَ سِرحانُها","وَلا رَواياها حِياضُ الأَنيس",71,"س",1,0],["لا يَفْزَعُونَ إِلَى مَخَافَةِ جَارِهِمْ","أَمْ هَلْ لِحَتْفٍ رَاصِدٍ مِنْ مُنْتَأَى",72,"ا",1,0],["لا يفرحن بدر غدوت سمية","فالبدر دون علاك أعشى ناظر",73,"ر",1,0],["لا يفضُلُ الأقوامَ إلّا ماجدٌ","دبّتْ إلى أيدي الرّجال فُضولُهُ",74,"ل",2,0],["لا يَفقِدِ الدينُ خَيلاً أَنتَ قائِدُها","يُعهَدنَ في كُلِّ ثَغرٍ غَيرِ مَعهودِ",75,"د",1,0],["لاَ يَفْهَمُ النَّجْوَى إِذَا خَاطَبْتَهُ","وَحَدِيْثُهُ مُسْتَحْسَنٌ مَفْهُومُ",76,"م",1,0],["لاَ يَفْلِتَنَّكَ شُكْرُنَا وَثَنَاؤُنَا","فَتَعَضَّ مِنْ نَدَمٍ عَلَيْهِ الأُنْمُلَهْ",77,"ل",2,0],["لا يَفْهَمُ القَوْلَ فِي الخِطَابِ وَلاَ","يُفْهِمُهُ فَهْوَ أَبْكَمُ أَخْرَسْ",78,"س",1,0],["لا يَفْهَمْ الدَّهرُ قصدَ قلبي فَلا","ينفكُّ يأْتِي بِغَيرِ مَا قَصَدا",79,"د",2,0],["لا يَفزَعونَ إِذا ما الأَمرُ أَفزَعَكُم","وَلَن تَرَوهُم إِذا ما اِستُمطِرَ الجودُ",80,"د",1,0],["لا يفطنون لعيب جارهم","وهم لحفظ جوارهم فُطنُ",81,"ن",1,0],["لا يَفتَح الناسُ باباً حينَ نَغلِقُهُ","وَلا يَكونُ لِبابٍ دونَنا غَلَقُ",82,"ق",1,0]]}