{"poems":[[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[50,"تعجَّبَتْ جارَتِي مِنِّي وَقدْ رَقدتْ","https://www.poetsgate.com/ViewPoem.aspx?id=21674",""],[140,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[158,"خطرت بقد أهيف مياس","https://www.aldiwan.net/poem58852.html","الكامل"],[167,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[191,"قد كان من زهرات العيش لي غصن","https://www.aldiwan.net/poem13160.html","البسيط"],[254,"يا سائلي عن خبري","https://www.aldiwan.net/poem48555.html","مجزوء الرجز"],[364,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[549,"أنتم علي وإن لم","https://www.aldiwan.net/poem47175.html","المجتث"],[551,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[573,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"]],"verses":[["حَتّى خَبا ضِياءُ ذاكَ المُنتَدى","وَعَطِلَ القَصران مِن ذاكَ السَنا",0,"ا",1,0],["حَتّى خَرَجتُ فَكانَ الدَهرُ مُنذَحِلاً","بَينَ القَرينَينِ حَلّالاً لِما عُقِدا",1,"د",2,0],["حَتّى خَطَرنَ بِهِ وَهُنَّ شَوارِعٌ","مِن بَينِ مُقتَصِدٍ وَآخَرَ دامِ",2,"م",1,0],["حَتّى خَرَجنَ بِنا مِن جوفِ كَوكَبِهِم","حُمراً مِنَ الطَعنِ أَعناقاً وأَكفالا",3,"ل",2,0],["حتّى خَلا مَلْحودُ كلِّ قبرِ","مِن كلِّ مُرتَدٍّ عظيمِ الكُفْرِ",4,"ر",1,0],["حَتَّى خَرَجْتُ فَكَانَ الدَّهْرُ مُنْدَحِلاً","بَيْنَ الْقَرِينَيْنِ حَلاَّلاً لِمَا عُقِدَا",5,"د",2,0],["حتى خبا ذاك الضرا","م وغاية النار الرَّمادُ",6,"د",1,0],["حتى خفيتُ من الضنى عمن يرى","شخصي وكم جهد المحب يقاسي",7,"س",2,0],["حَتّى خَرَجتُ عَلى حِسابِهما","مِمّا جَلَبتُ بِراحَةٍ صَفرِ",8,"ر",1,0],["حَتّى خَبا نُورُ وَجهٍ لا خَفاءَ بِهِ","وَأَلهَبَت نارُ وَجدٍ كُنتُ أُخفيهِ",9,"ي",2,0],["حتى خريت خريةً","مثل الخبيص الجزري",10,"ر",2,0],["حَتّى خَلَقتَ إِباءً في خَلائِقِهِم","فَلا عَدِمناكَ مِن مُجدي غِنىً وَعُلا",11,"ل",2,0],["حَتّى خبرتُ فكنتمْ","كاللّفظ ما فيه مَعْنى",12,"ن",2,0],["حَتّى خَرَجتُ مِنَ الحَوادِثِ لَم أَنَل","طَبعاً وَلَم أَقدَح بِزَندٍ مُصلَدِ",13,"د",1,0],["حَتّى خَضَعتُ لِحُبِّهِ فَاِقتادَني","وَأَذَلَّني بِصُدودِهِ إِذلالا",14,"ل",2,0],["حتى خيالك لا وَفَّى ولا وَافى","بل خافَ منكَ ومعذورٌ إِذا خَافَا",15,"ف",2,1]]}