{"poems":[[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[52,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[52,"تعجَّبَتْ جارَتِي مِنِّي وَقدْ رَقدتْ","https://www.poetsgate.com/ViewPoem.aspx?id=21674",""],[146,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[164,"خطرت بقد أهيف مياس","https://www.aldiwan.net/poem58852.html","الكامل"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[197,"قد كان من زهرات العيش لي غصن","https://www.aldiwan.net/poem13160.html","البسيط"],[261,"يا سائلي عن خبري","https://www.aldiwan.net/poem48555.html","مجزوء الرجز"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[556,"أنتم علي وإن لم","https://www.aldiwan.net/poem47175.html","المجتث"],[558,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[580,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48563","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48561","الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122351","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109043","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108507","الكامل"],[1673,"","https://poetry.dctabudhabi.ae/diwan/poem/119049","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114710","الكامل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126361","الكامل"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33010","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204589","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205007","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88999","الدوبيت"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138658",""],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106729","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141666","الكامل"],[5045,"النفس وأهوائها","https://www.poetsgate.com/ViewPoem.aspx?id=184900",""],[5370,"البنت ياحبها","https://www.poetsgate.com/ViewPoem.aspx?id=81635",""],[6152,"أنتِ طبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=203093",""],[4035,"ناعس الأجفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1526&r=&rc=9",""]],"verses":[["حَتّى خَبا ضِياءُ ذاكَ المُنتَدى","وَعَطِلَ القَصران مِن ذاكَ السَنا",0,"ا",1,0],["حَتّى خَرَجتُ فَكانَ الدَهرُ مُنذَحِلاً","بَينَ القَرينَينِ حَلّالاً لِما عُقِدا",1,"د",2,0],["حَتّى خَطَرنَ بِهِ وَهُنَّ شَوارِعٌ","مِن بَينِ مُقتَصِدٍ وَآخَرَ دامِ",2,"م",1,0],["حَتّى خَرَجنَ بِنا مِن جوفِ كَوكَبِهِم","حُمراً مِنَ الطَعنِ أَعناقاً وأَكفالا",3,"ل",2,0],["حتّى خَلا مَلْحودُ كلِّ قبرِ","مِن كلِّ مُرتَدٍّ عظيمِ الكُفْرِ",4,"ر",1,0],["حَتَّى خَرَجْتُ فَكَانَ الدَّهْرُ مُنْدَحِلاً","بَيْنَ الْقَرِينَيْنِ حَلاَّلاً لِمَا عُقِدَا",5,"د",2,0],["حتى خبا ذاك الضرا","م وغاية النار الرَّمادُ",6,"د",1,0],["حتى خفيتُ من الضنى عمن يرى","شخصي وكم جهد المحب يقاسي",7,"س",2,0],["حَتّى خَرَجتُ عَلى حِسابِهما","مِمّا جَلَبتُ بِراحَةٍ صَفرِ",8,"ر",1,0],["حَتّى خَبا نُورُ وَجهٍ لا خَفاءَ بِهِ","وَأَلهَبَت نارُ وَجدٍ كُنتُ أُخفيهِ",9,"ي",2,0],["حتى خريت خريةً","مثل الخبيص الجزري",10,"ر",2,0],["حَتّى خَلَقتَ إِباءً في خَلائِقِهِم","فَلا عَدِمناكَ مِن مُجدي غِنىً وَعُلا",11,"ل",2,0],["حَتّى خبرتُ فكنتمْ","كاللّفظ ما فيه مَعْنى",12,"ن",2,0],["حَتّى خَرَجتُ مِنَ الحَوادِثِ لَم أَنَل","طَبعاً وَلَم أَقدَح بِزَندٍ مُصلَدِ",13,"د",1,0],["حَتّى خَضَعتُ لِحُبِّهِ فَاِقتادَني","وَأَذَلَّني بِصُدودِهِ إِذلالا",14,"ل",2,0],["حتى خيالك لا وَفَّى ولا وَافى","بل خافَ منكَ ومعذورٌ إِذا خَافَا",15,"ف",2,1],["حتى ختمت بدور جد محزن","هذي الرواية في المساء الثاني",16,"ن",2,0],["حتى خسرت في الجوى شبابيا","لا هم لي غير امتلاء باليا",17,"ي",2,0],["حتى خلقت السقم في بنظرة","ولقد يلاقي ظلمه الظلام",18,"م",1,0],["حتى خشيت بأن أصيرَ نبيَّها","يوحى إِليَّ الشعرُ من شفتيها",19,"ي",3,0],["حتى خضعت لقول من قال الهوى","نارٌ يزيد أجيجها الصهباء",20,"ا",2,0],["حتى خشيت لأسهبن من الذي","ألقى ولست على المنون بقادر",21,"ر",1,0],["حَتّى خَلَصت مِنَ الذُّنوبِ كَمُرهَفٍ","أَبدى الفِرَند صقاله وَجَلاهُ",22,"ا",2,0],["حتى خشيت بأن تقول عواذلي","قد حن هذا الشيخ في ذاك الصبي",23,"ب",2,0],["حَتّى خَضَبتُ بِما تَحَدَّرَ مِن دَمي","أَكنافَ سِرجي أَو عَنانَ لِجامي",24,"م",2,0],["حتى خيالك اغتدى ذا قسوة","فما رققت لي ولا الخيال رق",25,"ق",1,0],["حتى خرائبها تلوح كأنها","لجلالها السامي البهيِّ قصور",26,"ر",1,0],["حتى خرب الوجه بعد ما لخبطه","فانظر نقراتٍ ملأى بماء الكرب",27,"ب",1,0],["حتى خلا وجه البسيطة من هدى","هادٍ يشار إليه بالتعيين",28,"ن",1,0],["حَتّى خَطَبتَ ارتِجالاً فَتحَ مَملَكَةٍ","كانَ السَفيرُ مُجَيفِلاً لَها فجَبا",29,"ب",2,0],["حتى خشيت الدمع يؤلم جسمه","لما عليه همي كودْق جار",30,"ر",1,0],["حتي خيالي تفرع معنوي حسي","وحين تُبدي صور مرت بذكراها",31,"ا",3,0],["حتى خيالك بتالَ الليل ياتي لي","جروح وعيون معقودة حواجبها",32,"ب",3,0],["حتى خيالكِ غاب عني طيفه","وهو الذي بالأمس كان يؤوب",33,"ب",1,0],["حتى خفى النجم وغاب الدجى","وقبلت عيني محيا الصباح",34,"ح",1,0]]}