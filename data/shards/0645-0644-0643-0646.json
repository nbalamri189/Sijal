{"poems":[[55,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[65,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[65,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[88,"أعيدوا مجدنا دنيا ودينا","https://www.aldiwan.net/poem10704.html","الوافر"],[90,"الشعر مفتقر مني لمبتكر","https://www.aldiwan.net/poem44991.html","البسيط"],[87,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[64,"أيا بانتي وادي الأراك وقيتما","https://www.aldiwan.net/poem52264.html","الطويل"],[47,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[63,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[107,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[54,"ملكنا الهوى حينا وكان وكانا","https://www.aldiwan.net/poem26662.html","الطويل"],[52,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[8,"تذكرت والذكرى تهيج للفتى","https://www.aldiwan.net/poem21786.html","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43653","الطويل"],[105,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[90,"الشعر مفتقر مني لمبتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19518&r=&rc=21",""],[164,"معط أخا كرم مرض أخا ندم","https://www.aldiwan.net/poem58707.html","البسيط"],[202,"أرض منمنمة وظل سجسج","https://www.aldiwan.net/poem51974.html","الكامل"],[208,"لقد توقفت لو أن الهوى وقفا","https://www.aldiwan.net/poem53240.html","البسيط"],[215,"سلام على البحر الخضم وموجه","https://www.aldiwan.net/poem46233.html","الطويل"],[215,"ما عبقر بقدير أن يصوغ هوى","https://www.aldiwan.net/poem46581.html","البسيط"],[227,"رق لما هواك عقلي فما يقدر","https://www.aldiwan.net/poem55469.html","الخفيف"],[280,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[287,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[411,"ونحن أناس لا نذل لجانف","https://www.aldiwan.net/poem49869.html","الطويل"],[412,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[435,"لك العلياء والشرف المفدى","https://www.aldiwan.net/poem41437.html","الوافر"],[443,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[445,"أهلا بمن قهر الملوك ومرحبا","https://www.aldiwan.net/poem34865.html","الكامل"],[445,"بلغت عبدك الخطوب مداها","https://www.aldiwan.net/poem34891.html","الخفيف"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[466,"ملكنا فكان العفو منا سجية","https://www.aldiwan.net/poem16435.html","الطويل"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[495,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[591,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70975","الخفيف"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100134","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96733","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69175","الطويل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90604","الرمل"],[415,"","https://poetry.dctabudhabi.ae/diwan/poem/144351","الطويل"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206187",""],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114919","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106709","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69393","الكامل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202205","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53205","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53146","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53203","الكامل"],[2197,"","https://poetry.dctabudhabi.ae/diwan/poem/205988","الطويل"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116834","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140298",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68007","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62870","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103908","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48332","الخفيف"],[3666,"","https://poetry.dctabudhabi.ae/diwan/poem/29383","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91165","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91858","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59449","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59498","المتقارب"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59466","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103015","الكامل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67618","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81698","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81696","الكامل"],[4830,"يا سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=194932",""],[4929,"آن الأوان للم الشمل","https://www.poetsgate.com/ViewPoem.aspx?id=199285",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5461,"نعم شاعرك","https://www.poetsgate.com/ViewPoem.aspx?id=5032",""],[5732,"انا من نجد يكفيني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=177852",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5829,"صدع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=177716",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""]],"verses":[["مَلَكنا مَقطَعَ الرِزقِ","فَأَفقَرنا وَأَغنَينا",0,"ن",2,0],["ملَكْنا أقاليمَ البِلادِ فأذْعَنَتْ","لَنا رَغْبَةً أو رَهْبَةً عُظَماؤها",1,"ا",3,0],["مَلِكٌ نَمَتْ في الأنبياءِ فروعُهُ","وزَكَتْ بهِ الأعْراقُ في الخُلَفاءِ",2,"ا",2,0],["مَلَكنا الأَمرَ فَوقَ الأَرضِ دَهراً","وَخَلَّدنا عَلى الأَيّامِ ذِكرى",3,"ر",2,0],["ملكْنَ من رقّة رقّ النفوس هوىً","من حيث أطرْ بن حتى قاسيَ الحَجَر",4,"ر",1,0],["ملكنا منهم قمم الروابي","وماء النهر والغاب الرهيبا",5,"ا",1,0],["مَلَكنا مارِنَ الدُنيا بِوَقتٍ","فَلَم نُحسِن عَلى الدُنيا القِياما",6,"م",2,0],["ملكنَ على قلبي طريقَ سُلوِّهِ","ومَلَّكْنَ برحَ الوجدِ ثنيَ عناني",7,"ن",2,0],["مَلِكٌ نَعُدُّ العَفوَ مِنهُ خَليقَةً","وَالعَفوُ خَيرُ خَلائِقَ الإِنسانِ",8,"ن",1,0],["مَلكْنَ بتقليبِ النَّواظرِ قلبَه","فقد أَمِنَتْ في الحبِّ أن يتقلَّبا",9,"ب",2,0],["مَلَكنَ الأَرضَ فَاِستَعلَينَ فيها","وَأَحدَثنَ الحَوادِثَ وَالشُؤونا",10,"ن",2,0],["مَلَكنا الهَوى حيناً وَكانَ وَكانا","فَأَرخَصَنا دَهرٌ فَكَيفَ تَرانا",11,"ن",2,1],["مَلَكناكُم فَغَطَّينا عَلَيكُم","وَلَم نَنصِبكُمُ غَرَضاً لِزارِ",12,"ر",1,0],["مَلَكنا فَلَم نَكشِف قِناعاً لِحرَّةٍ","ولَم نَستَلِب إِلاَّ القِنَاعَ المسمَّرا",13,"ر",2,0],["مَلِكٌ ناصَبَ مَن خالَفَكُمْ","عامِرِيُّ المُنْتَمَى والمَنْصِبِ",14,"ب",1,0],["مَلِكٌ نَمَتْهُ أَرُومَةٌ عَلَوِيَّةٌ","مَلَكَتْ بِسُؤْدُدِهَا عِنَانَ الْفَرْقَدِ",15,"د",1,0],["مَلَكنَ فَلَمّا جُرنَ كانَ اِنتِصافُنا","بِتِلكَ الثَنايا وَالخُدودِ النَواعِمِ",16,"م",1,0],["ملكنا هذه الدنيا قرونا","وأخضعها جدود خالدونا",17,"ن",2,1],["ملكن من رقة رقُّ النفوس هوَى","من حيث أظربنا حتى قاسى الحجر",18,"ر",1,0],["ملكن من دهم مغن أخا نعم","ما لن من ألم مرج أخا لمم",19,"م",1,0],["مَلِكٌ نمتْه من الملوك أكابرٌ","هُمْ أوضحوا سُبُلَ العَلاءِ وأَنهجوا",20,"ج",3,0],["مَلِّكنيَ الوصلَ يوماً إذ بذا رمقي","وملِّكنّي قدوداً تُشبه الألفا",21,"ف",2,0],["ملكناه بالإسلام فازدان جيده","وأصبح بحرا قد أضيف إلى مصر",22,"ر",1,0],["ملكنا بأسرار البيان وسحره","ممالك منها جبهة الأسد الورد",23,"د",1,0],["ملك نال في النفوس نفوذاً","يتمناه كل ذي سلطان",24,"ن",1,0],["مَلِكٌ نَمَتْهُ في المُلوكِ عِصَابَةٌ","هِيَ مَفْخَرُ الأسْيَافِ والأقْلامِ",25,"م",1,0],["مَلكٌ نَصَرَ الإِسلامَ بِبي","ضِ الهِندِ وَبِالسُّمرِ الذُّبُلِ",26,"ل",1,0],["ملكنا المعالي بالعَوالي فجارُنا","عَزيزٌ ومنْ نكفُلْ بهِ غيرُ خائفِ",27,"ف",1,0],["ملكنا جَميع الأَرض مِن بَعدِ جُرهم","وَكانَ لَنا مِن غار فيها وَهملجا",28,"ج",2,0],["ملكن الفخر في خلق كريم","فلم تترك لغيرك قطّ حمدا",29,"د",2,0],["ملك نمته إلى العلياء عن كرمٍ","أطواد عزّ عدت من فوق أطوادِ",30,"د",1,0],["مَلِكٌ نماهُ المُلْكُ يَتْبَعُ تُبَّعاً","فِيهِ ويُعرِبُ عَنْ مآثِرِ يَعْرُبا",31,"ب",2,0],["مَلِكٌ نافَسَتْ بأدنى رِضَاهُ","بشَّرَتْهُ رِبحاً بأقصى رِضاها",32,"ا",3,0],["ملَكن الهوى فأعرن القلو","بَ ماشئن منه سوى عارِهِ",33,"ر",2,0],["مَلكْنا فكان العَفْو منَّا سَجيَّةً","فلمَّا ملكْتُمْ سالَ بالدَّمِ أبْطَحُ",34,"ح",1,1],["ملكٌ نزفُّ إليه غيدُ عقائلي","زف الحبيب إلى الحبيب المجمل",35,"ل",1,0],["مُلكُنا مُلكٌ لَقاحٌ أَوَّلٌ","وَأَبونا مِن بَني أَودٍ خِيارُ",36,"ر",1,0],["مَلِكٌ نَدَاهُ فَكَّنِي وَانْتَاشَنِي","مِنْ مِخْلَبيْهِ وَمِنْ أَسَارِ قُيُودِهِ",37,"د",2,0],["مِلكُنا مالُنا فنحن مُبيدو","ه سخاءً وأَنتَ ملكٌ لمالك",38,"ك",1,0],["ملكن قياده ولطالما قد","تملك من أزمتها قيادا",39,"د",2,0],["ملكٌ نماهُ إِلى العلا عثمانُه","وَكساهُ سربال الثنا كهلانهُ",40,"ن",2,0],["ملكنا رِقاب الناس في الشِركِ كلَّهُم","لَنا تابع طوع القِياد جَنيب",41,"ب",1,0],["ملكٌ ندفعُ ما نخشى به","وبه يصلُحُ منا ما فسَد",42,"د",1,0],["ملكنا الذي لم تَحوِهِ كفُّ مالِكٍ","ولم يَعرُنَا تِيهُ الملوكِ ولا الكبرُ",43,"ر",1,0],["مَلَكني وله ذلّلت نفسي وصِرت له","عبدٍ مطيعٍ له على كيف ما رادِ",44,"د",1,0],["ملكنا قبل خلقكم البرايا","وكنا قبلهم متأمرينا",45,"ن",2,0],["مَلَكنا ولَم نملك وقُدنا ولم نُقَد","كأنَّ لنا حَقّاً على الناس تُرتبا",46,"ب",2,0],["ملكنا ملوكاً واستبحنا حماهُمُ","وكنَّا لهم في الجاهلية مَوكبا",46,"ب",2,0],["مَلِكٌ نمَتهُ دَوحةٌ نبويَّةٌ","وسَمَت بِهِ أقيالُهَا وقُرُومُهَا",47,"م",3,0],["مَلِكٌ نَفِيسٌ القَدرِ وَهيَ نَفِيسَةٌ","مِنهُم فَقَد مَلَكَ النَفيسُ نَفيسا",48,"س",2,0],["ملكنا فعززنا فأعظم بملكنا","فليس لحي غيرنا ثم فاخر",49,"ر",1,0],["ملك نضى كبر الملوك لعلمه","أن التواضع يكسب التعظيما",50,"م",2,0],["ملك نضا من غمده سيفاً به","أعيا صروف الدهر أن تتصرفا",51,"ف",2,0],["ملك نَمَتْه أغِرَّةٌ من هاشم","هم دكدكوا أطواد آل هشام",52,"م",1,0],["ملكناهم بدءاً بإسحاق عمنا","وكانوا لنا عوناً على الدهر أعبدا",53,"د",2,0],["ملكنَ بعقد الخاطبين وإنما","دعاهُنَّ مجدٌ ثاقبٌ ومهورُ",54,"ر",1,0],["ملكنا فكان العفو منا سجيةً","بيوم به بطحاء مكة تفتح",55,"ح",1,1],["ملك نفيُّ الجانبينِ متوَّجٌ","بمَحاسنِ الأخلاقِ طُراً والخَطر",56,"ر",1,0],["ملكنَ على المفاوزِ كلَّ تِيْهٍ","خَفِيّ السَّمْتِ مُنْخَرِقِ الفِجَاجِ",57,"ج",1,0],["ملكنا ملوك الأرض في كل جانب","فحد مناوينا الحدود الأواكس",58,"س",1,0],["مِلْكُ نعْماكَ يرتجي منكَ جُوداً","ظلّ يُدْني من المآمِلِ شُمْسا",59,"س",2,0],["ملكنا الناس قد علمت معدٌّ","فلم تغلب ولم تسبقُ بوِتر",60,"ر",1,0],["ملكنا فملَّكناكمُ عن سماحة","فلما ملكتم خلتم المَجد أعقما",61,"م",2,0],["ملكناكمُ حيناً سوائمَ جُهَّلاً","تتيهون في دوّ الهَوان نعائما",61,"م",2,0],["ملكنا الأَرض من شَرق وَغَرب","وَحكّمنا السُيوف بكلِّ هامه",62,"م",2,0],["ملكنا الورى بالسيف حتى تضاءلت","أعَاجُمهُ ذُلاً لنَا وأعَاربُهْ",63,"ب",2,0],["ملكنا البلادَ وسُدنا العبادَ","ودُسنا الأعاديَ بالصّيْلَمِ",64,"م",1,0],["ملكنا رقابَ الناسِ بالبأسِ والندى","فدانَ لنا مخضوضَعاً كلُّ مَعشرِ",65,"ر",1,0],["ملك نزلت جواره فأجارني","ورعى بروض المكرمات سوامي",66,"م",2,0],["مَلِكٌ نَدْفعُ ما نخشى به","وبه نُصلِحُ منَّا ما فَسَدْ",67,"د",1,0],["ملك نمته أرومةٌ حفصيَّةٌ","طابتْ فروعاً حين طابتْ عُنْصُرا",68,"ر",2,0],["مَلِكٌ ندله سائلٌ عن سَائِلٍ","صِفْرِ الحقائِبِ قاصدٌ للقاصد",69,"د",1,0],["ملكنَ الغانياتُ شعابَ قلبي","وأبرمنَ السِقامَ به فطالا",70,"ل",2,0],["ملكنا إمرةَ الدنيا قروناً","ودانت بالولاء والِاحْتِرامِ",71,"م",1,0],["ملك نماه إلى المهدي نما والى","الهادي فدع ذكر منصور وسفاح",72,"ح",1,0],["ملكنا غاليٍ والعهد غالي","وغالي الرّوح للغالي فداوه",73,"ا",3,0],["ملكني بالهوا عذب السجايا","ولااذكر ساعة قلبي نساها",74,"ا",3,0],["مَلكنَّا بنى الدنيا ونِلنَا مرامها","وسُدنا وسَوّدنا بعزم وهمةِ",75,"ه",1,0],["ملكنا سدة التاريخ ردحا","فلا دمنا ولا دامت صروح",76,"ح",1,0],["ملكّني المجد وأهداني","إرثاً من فضل وجدارةْ",77,"ر",2,0]]}