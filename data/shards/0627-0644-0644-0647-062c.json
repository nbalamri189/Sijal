{"poems":[[55,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[55,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[73,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[75,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[95,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[74,"أرأيت نهج الحق كيف يبين","https://www.aldiwan.net/poem20170.html","الكامل"],[87,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[87,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[47,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[47,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[47,"كم ليلة فيك بت أسهرها","https://www.aldiwan.net/poem63639.html","المنسرح"],[47,"حييتما من مربع ومصيف","https://www.aldiwan.net/poem65158.html","الطويل"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[47,"الله جارك في انطلاقك","https://www.aldiwan.net/poem65184.html","مجزوء الكامل"],[47,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[47,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[63,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem51442.html","الطويل"],[63,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[63,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[46,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[33,"قل للمليحة قد أبلتني الذكر","https://www.aldiwan.net/poem42546.html","البسيط"],[107,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[78,"الله جرد للندى والباس","https://www.aldiwan.net/poem39281.html","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30490","البسيط"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/6098","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54255","الكامل"],[47,"قَلْبُ مَشُوقٍ عَناهُ البَثُّ وَالكَمَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=32937",""],[47,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[113,"صبر الفؤاد على فعال الجافي","https://www.aldiwan.net/poem16208.html","الكامل"],[125,"أصبحت لا بد لي أن أنفث الصدرا","https://www.aldiwan.net/poem23810.html","البسيط"],[234,"أفحمتني بلطيف البر منك فما","https://www.aldiwan.net/poem50889.html","البسيط"],[309,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[309,"الله جل الله عن التكييف","https://www.aldiwan.net/poem16800.html","الكامل"],[371,"وبمهجتي خد حميت نعيمه","https://www.aldiwan.net/poem16931.html","الكامل"],[371,"الدار راحلة على آثارهم","https://www.aldiwan.net/poem16996.html","الكامل"],[371,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[371,"لا زلت يوم الندى خراج غايات","https://www.aldiwan.net/poem17167.html","البسيط"],[371,"نادى الرجال به ونادى سيفه","https://www.aldiwan.net/poem17257.html","الكامل"],[396,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[438,"لمن الشموس غربن في الأكوار","https://www.aldiwan.net/poem12433.html","الكامل"],[438,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[438,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[445,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[466,"الله جارك من أخي شرف","https://www.aldiwan.net/poem15448.html","أحذ الكامل"],[466,"الله جار الوزير الصدر ما طلعت","https://www.aldiwan.net/poem16429.html","البسيط"],[543,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[543,"من ذاك ينكر فضل إبراهيم","https://www.aldiwan.net/poem47956.html","عموديه"],[543,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[545,"الله جار عتي دعوة شفقا","https://www.aldiwan.net/poem56681.html","البسيط"],[591,"إن دام هذا التجني منك والغضب","https://www.aldiwan.net/poem17415.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138257",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122790","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122815","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122712","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120045","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79536","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79953","الكامل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102061","البسيط"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69384","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53095","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27898","البسيط"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124713","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146350","الكامل"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143494","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61260","الرجز"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61277","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114549","البسيط"],[4012,"","https://poetry.dctabudhabi.ae/diwan/poem/145252","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83345","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33743","البسيط"],[1901,"ترى على العهدِ أهلُ الودِّ أم خانوا","https://www.poetsgate.com/ViewPoem.aspx?id=160421",""],[4952,"ألله جار عصابة رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=182568",""],[5461,"يا طارد","https://www.poetsgate.com/ViewPoem.aspx?id=1600",""],[5756,"أول الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=5365",""],[5956,"إخلاصُك المعروفُ عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194138",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""]],"verses":[["اللَهُ جارَكَ وَالمَطيُّ جَوائِرٌ","وَالنَصرُ دِرعُكَ وَالحُسامُ ذَليقُ",0,"ق",1,0],["اللَهُ جارَكَ ما رَمَتكَ نَوىً","تُذري الرَكائِبَ أَو قَطا الجُردِ",1,"د",1,0],["اللَهُ جارُكَ يا ابنَ يوسُفَ ثاوِياً","وَسَقى ضَريحَكَ وابِلٌ مدرارُ",2,"ر",1,0],["اللَهُ جارُ الجَهوَرِيِّ فَطالَما","مُنِيَت صَفاةُ الدَهرِ مِنهُ بِقارِعِ",3,"ع",1,0],["أللهُ جَارُكَ يَمِّمْ","دَارَ الصَّفَاءِ المُقِيمِ",4,"م",1,0],["الله جارك من ريبِ الزمانِ لقد","تجمَّعت للمعالي فيك أشتات",5,"ت",1,0],["الله جارك إنَّ دمعيَ جاري","يا موحشَ الأوطان والأوطار",6,"ر",1,1],["ألله جارك ما أبرّ شمائلاً","تعنو الخطوب لأمرها فتهون",7,"ن",1,0],["اللَهُ جارُكَ في عَوانٍ لَم تَهَب","لِلَّهِ لا بِيَعاً وَلا صُلبانا",8,"ن",2,0],["اللَهُ جَلَّ ثَناؤُهُ بِلِسانِهِم","خَلَقَ البَيانَ وَعَلَّمَ الأَمثالا",9,"ل",2,0],["اللَهُ جارَكَ جارٌ لِلحَريبِ وَإِن","غَدا وَراحَ لَنا وَالجودُ حارِبُهُ",10,"ب",2,0],["اللَهُ جارُكَ مَكلوءً وَمُمتَنِعاً","مِنَ الحَوادِثِ حَتّى يَنفَدَ الأَبَدُ",11,"د",1,0],["اللَهُ جارٌ لَها فَما اِمتَلَأَت","عَينِيَ إِلّا مِن حَيثُ أُبصِرُها",12,"ر",3,0],["اللَهُ جارُك حَيثُ كُنتَ مُمَتَّعاً","بِمَواهِبِ الإِعزازِ وَالتَشريفِ",13,"ف",1,0],["اللَهُ جارُكَ تَبتَغي ما تَبتَغي","في المَكرُماتِ وَتَرتَقي ما تَرتَقي",14,"ق",2,0],["اللَهُ جارُكَ في اِنطِلاقِك","تِلقاءَ شامِكَ أَو عِراقِك",15,"ك",1,1],["اللَهُ جارُ بَني المُدَبِّرِ كُلَّما","ذُكِرَ الأَكارِمُ ما أَعَفَّ وَأَكرَما",16,"م",2,0],["اللَهُ جارُ بَني خاقانَ إِنَّهُمُ ال","أَثرَونَ مِن كَرَمِ الأَخلاقِ وَالشِيَمِ",17,"م",1,0],["اللهُ جارُكَ ظاعِناً ومُقيما","وضمينُ نَصرِكَ حادثاً وقَديما",18,"م",2,1],["اللهُ جارُكَ والارماحُ جائِرَةٌ","والبِيضُ تأخُذُ من ألوانِها اللَّممُ",19,"م",1,0],["اللهُ جرَّدَ من عليٍّ سَيفَه","فحمى وذَبَّ عن الهُدى بذُبابِه",20,"ب",2,0],["اللهُ جَارُ الوَرَى مِنْ شَرِّ أَنْفُسِهِمْ","فَاْمْدُدْ إِلَيْهِ يَدَاً يَمْدُدْ إِلَيْكَ يَدَا",21,"د",2,0],["اللَهُ جارُكَ أَن تَحولَ وَأَن يَهي","ما سَلَّفَ التَأميلُ فيكَ وَخَلَّفا",22,"ف",2,0],["اللَهُ جارٌ لَهُ إِمّا أَقامَ بِنا","وَفي الرَحيلِ إِذا ما ضَمَّهُ السَفَرُ",23,"ر",1,0],["اللَهُ جَدَّدَ لِلشُعوبِ حَياتَها","مِن فَضلِهِ الأَوفى وَمِن إِنعامِهِ",24,"م",2,0],["اللّهُ جَرَّدَ للنَّدى والباسِ","سَيفاً فَقلَّدَهُ أَبا العَبَّاسِ",25,"س",1,1],["اللَّهُ جارُكَ مِن ذِي مَنْعَةٍ ظَفِرَتْ","منه اللَّيالي بعِلْقٍ غَيْرِ مَذمومِ",26,"م",1,0],["اللَهُ جارٌ لَهُ إِذا نَزَحَت","دارٌ بِهِ أَو بَدا لَهُ سَفَرُ",27,"ر",1,0],["اللَه جَمَّعَ فيكِ شَمْلَ","النُّبْلِ من بَعْدِ الشَّتات",28,"ت",1,0],["الله جَارُكَ مَكْلُوءاً، وَمُمْتَنِعاً","من الحَوادثِ، حتّى يَنفَدَ الأبَدُ",29,"د",1,0],["ألله جَارُكَ جَاراً للحَرِيبِ، وَإنْ","غَدا وَرَاحَ لَنَا، وَالجُودُ حَارِبُهُ",30,"ب",2,0],["اللَهُ جَل جَلالَهُ عَن خُلقِهِ","لِجَنابِهِ بِاللَطف مِنهُ يُكافي",31,"ف",2,0],["الله جلَّ جلالاً في الجمال وفي","جلاله من عظيم الوصف ما غَمَرَا",32,"ر",2,0],["الله جازِيك عني يا خليفته","جزاء مُقْتَدِرٍ واللهُ راعيكا",33,"ك",2,0],["اللَه جاري من جفاء الحبايب","إنه مصيبة دونها المصايب",34,"ب",1,0],["اللَه جل اللَه عن التكييف","متفرد بالملك والتصريف",35,"ف",1,1],["اللَهُ جارُ قلوبِ أَهلِ العِشقِ مِن","وَثَباتِ حَيَّتِهِ وَمَشي المَقرَبِ",36,"ب",1,0],["اللَهُ جارُهُمُ عَلى الجَورِ الَّذي","قَسَموهُ وَاِبتَدَءوا بِحِصَّةِ جارِهِم",37,"م",1,0],["اللَهُ جارُهُم فَفيهِم مِثلُ ما","في أَدمُعي فيهِم مِنَ الأَلوانِ",38,"ن",1,0],["اللَهُ جارَكَ وَالآجالُ كاشِرَةٌ","عَنِ القَواضِبِ مِن عُصلِ الثَنِيّاتِ",39,"ت",1,0],["اللَهُ جارُكَ ضارِباً بِالنَصلِ كَم","فَلَّلتَهُ يا ضارِباً بِالمُنصُلِ",40,"ل",1,0],["الله جارى من جفا الحبايب","نعوذ بالله الكريم",41,"م",1,0],["الله جارُكَ قد بَنَيْتَ مراتباً","في المجدِ لا تَفْنَى مع الأَعْصارِ",42,"ر",1,0],["الله جارُك قد بنيتَ مراتباً","نظر الزمان سموّها فتعجّبا",43,"ب",2,0],["الله جمّع فيك أشتاتَ العُلا","ومن العجيبِ تجمّعُ الأضدادِ",44,"د",1,0],["اللهُ جارُكَ ظاعِناً ومُقِيما","ومُثِيبُك التبجيلَ والتعظِيما",45,"م",2,1],["اللّهُ جارٌ لفتىً أجارني","على زمانٍ لم أفُتْهُ هَرَبا",46,"ب",2,0],["اللهُ جارُكَ من أخي شَرَفٍ","في كل مسعاةٍ له شَرفُ",47,"ف",1,1],["اللّهُ جارُ الوزيرِ الصَّدْرِ ما طَلَعَتْ","شَمْسٌ وأحْيا دَريسَ الهامِدِ السَّبَلُ",48,"ل",1,1],["اللهُ جَرَّدَ قَلبَهُم مِن كُلِّ إش","فاقٍ على مَرضى بَني الإنسانِ",49,"ن",1,0],["أللهُ جلَّ جَلالُهُ","أهدَى له ذاك المَقام",50,"م",1,0],["أللّه جَلًّ جَلالُه أغنَاهُ عَن","كِ وأنتِ عنه اللهُ مَا أغنَاكِ",51,"ك",1,0],["اللَهُ جارُ عِتيٍّ دعوةً شَفَقاً","مِن الزَمانِ وَشَرُّ الأَقرَبِ الوالي",52,"ي",1,1],["اللَّه جَارُهُم في أَيَّةٍ سَلَكُوا","إِنْ أَعْتَبُوا عَاشِقاً في الحُبِّ أَو عَتَبُوا",53,"ب",3,0],["الله جمله بحلية فطنة","تمحو غياهبنا فلا تتلبد",54,"د",1,0],["اللهُ جارُكَ إنَّ نَفسي حُرَّةٌ","لَو أرثَ نَفعَكَ فارَقَت جيرانَها",55,"ن",3,0],["اللهُ جارُ أَبي عُمارَةَ ما أَمرَّ","الطَّعمَ آونَةً وَما أَحلاهُ",56,"ا",2,0],["اللهُ جارُكَ حَتَّى لا تُمَدَّ يَدٌ","إلاَّ وَفي كَفِّها عَن نَيلِكُم شَلَلُ",57,"ل",1,0],["الله جارك كم غادرت من أسد","بثعلب الرمح أضحى وهو موجورُ",58,"ر",1,0],["اللهُ جارُكَ يا مَنْ جارُ حضرتِهِ","يلقى السعودَ عليه الدهرَ تزدَحِمُ",59,"م",1,0],["اللهُ جلببه الرياسة فيكمُ","أفعنه ينزع غيرُه جلبابها",60,"ب",3,0],["اللَه جلله بهبة عظمَت","كساه كل وقار من فضائله",61,"ه",1,0],["اللهُ جارُ فؤادٍ لا مُجيرَ له","قد مالأتْهُ على الأحزانُ جيرانُ",62,"ن",1,0],["اللَهُ جارُكَ إِن ثَوَيتَ إِقامَةً","وَكَفيلُ عِزِّكَ إِن أَرَدتَ رَحيلا",63,"ل",2,0],["الله جارك والنبيّ محمد","يا من به الدنيا تقوم وتقعد",64,"د",1,1],["الله جلى لنا ما قد جلاه لنا","على صفاءٍ بلا شَوبٍ ولا كَدَرِ",65,"ر",1,0],["الله جارك هل رأيت منازلا","عَطِلَت فحلَّتها عقودُ الأدمع",66,"ع",1,0],["اللهُ جارُك والنبيُّ الهادي","يا من يُوالي فيهما ويُعادي",67,"د",2,1],["الله جار عصابة رحلوا","ساروا وقلب الصب عندهم",68,"م",1,1],["اللَ