{"poems":[[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[88,"فتية الصهباء خير الشاربين","https://www.aldiwan.net/poem10937.html","الرمل"],[88,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[95,"إن التي تجلت علياً أنجبت","https://www.aldiwan.net/poem11141.html","الكامل"],[90,"عندي حديث عن دمشق فأنصتوا","https://www.aldiwan.net/poem44802.html","الكامل"],[93,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[93,"صاحت الضفضع لما شاهدت","https://www.aldiwan.net/poem62742.html","عموديه"],[91,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[91,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[87,"برز الثعلب يوماً","https://www.aldiwan.net/poem8033.html","مجزوء الرمل"],[87,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[87,"بيت على أرض الهدى وسمائه","https://www.aldiwan.net/poem62935.html","الكامل"],[87,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[63,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[63,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[107,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141990","الكامل"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[100,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[128,"صرعته بعد تطاحن وعراك","https://www.aldiwan.net/poem23737.html","الكامل"],[147,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[197,"ألا ليت الركاب غدون وقفا","https://www.aldiwan.net/poem13131.html","الوافر"],[201,"يا مي ناب السمع عن بصري","https://www.aldiwan.net/poem39941.html","أحذ الكامل"],[203,"خل القلوب لما بها","https://www.aldiwan.net/poem45576.html","مجزوء الكامل"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[295,"يا بلبلا غردا غني فأشجانا","https://www.aldiwan.net/poem11689.html","البسيط"],[368,"فمشوا إلى الهيجاء في غلوائها","https://www.aldiwan.net/poem1696.html","الكامل"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[449,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[466,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[556,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122723","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48910","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141341","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67202","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106865","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93536","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93702","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87765","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137297",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94251","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68027","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89290","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89114","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48279","الكامل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27114","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61285","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61282","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92031","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133214","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133267","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102963","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107509","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78216","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136908",""],[4168,"","https://poetry.dctabudhabi.ae/diwan/poem/123829","الوافر"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4691,"خذ ما تريد لك الفدا","https://www.poetsgate.com/ViewPoem.aspx?id=125341",""],[4767,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=87662",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[585,"هي رحلةُ قد أرهقتك ذميلا","https://www.poetsgate.com/ViewPoem.aspx?id=161880",""],[5121,"دُوَّامَةُ الْوَقْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=40502",""],[5212,"وَقَفَ الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=212041",""],[5240,"لا تلمني فالنفس طال عناها","https://www.poetsgate.com/ViewPoem.aspx?id=171238",""],[5268,"في الليلِ يصمتُ كلُّ شيء","https://www.poetsgate.com/ViewPoem.aspx?id=207016",""],[5339,"ثورة الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=61756",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""],[5409,"مروا به وسط الدساكر","https://www.poetsgate.com/ViewPoem.aspx?id=155277",""],[5413,"ليلة الغرباء","https://www.poetsgate.com/ViewPoem.aspx?id=208657",""],[5693,"فمشكاتي ومصباحي .","https://www.poetsgate.com/ViewPoem.aspx?id=34850",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[5978,"تجليات من وحي الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=191711",""],[6093,"قاصرة على شفة طريق","https://www.poetsgate.com/ViewPoem.aspx?id=198539",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6102,"هي .. هي","https://www.poetsgate.com/ViewPoem.aspx?id=185304",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[201,"هاتي الدواء وكحلي بصري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65302&r=&rc=11",""]],"verses":[["فَمَشى وَلَم يَخشَ الأَني","سَ فَزارَها وَخَلا بِها",0,"ب",3,0],["فَمَشَت بِالكاسِ وَالطاسِ لَنا","مِشيَةَ الأَفراحِ لِلقَلبِ الحَزين",1,"ن",1,0],["فَمَشى النَثرُ خاضِعاً وَمَشى الشِع","رُ وَأَلقى إِلى الخَليلِ الزِماما",2,"م",2,0],["فَمَشَى وَرَاءَ النَّعْشِ فِي تَشْيِيعِهَا","كُبَرَاءُ قَادَتِهِ وَنُخْبَةُ جُنْدِهِ",3,"د",2,0],["فمشَوا ثلاْثتهم بها وسيوفهم","شُبِّكْنَ كالاكليل فوق قَذالها",4,"ل",3,0],["فَمَشى عَلَيهِ مِنَ الخَريفِ سُرادِقٌ","كَاللَيلِ خَيَّمَ في المَكانِ البَلقَعِ",5,"ع",1,0],["فَمَشَت في سِربِها مُختالَةً","كَمَليكٍ ظافِرٍ بَينَ قُروم",6,"م",1,0],["فمشت به نحو الحتوف جريئة","رجل اذا ما صممت لا تحجم",7,"م",1,0],["فمشت لباب الدار سعياً أمها","ريحانة وكذاك سلمى تهرع",8,"ع",1,0],["فَمَشى في الأَرضِ يَهذي","وَيَسُبُّ الماكِرينا",9,"ن",2,0],["فَمَشَت تُحَطِّمُ بِاليَمينِ ذَخيرَةً","وَتَلُصُّ أُخرى بِالشَمالِ وَتَسرِقُ",10,"ق",1,0],["فَمَشَت كَأَنَّ بَنانَها يَدُ مُدمِنٍ","وَكَأَنَّ السُمَّ فيها زِئبَقُ",10,"ق",1,0],["فَمَشى إِلَيكَ بِجَفنِهِ وَبِدَمعِهِ","وَإِلى أَخيكَ بِقَلبِهِ وَعَزائِهِ",11,"ا",3,0],["فَمَشى إِلَيَّ وَلَيسَ جُؤذَرٍ","وَقَعَت عَلَيهِ حَبائِلي فَقَنَصتُهُ",12,"ت",2,0],["فَمَشَت تُظهِرُ الإِباءَ وَتَحمي الدَم","عَ أَن تَستَرِقَّهُ الضَرّاءُ",13,"ا",2,0],["فمشِّ طرفَك فيما شئتَ من كفلٍ","رابٍ وخَصرٍ كخُوطِ البانِ مَجدولِ",14,"ل",1,0],["فمَشهَدُ عمروٍ حيثُ يُلعَنُ ظالِمٌ","وتَبكي على المظلومِ آلُ محمَّدِ",15,"د",1,0],["فَمَشْرِقَا الأرضِ على فضله","لمغربيها أبداً حاسدان",16,"ن",1,0],["فمشى إليه يَعُودُه في مَوكِبٍ","للّهِ فيهِ من الملائكِ مَوكبُ",17,"ب",1,0],["فمشى يطوِّحُ بالعروش كأنه","شمشونُ في حِلَقِ الحديد يحطمُ",18,"م",1,0],["فَمَشَى إِليَّ فثُرْتُ غَيْرَ مُعَفِّرٍ","كالليثِ مطَّرداً إِلى يَعفورِه",19,"ر",2,0],["فَمشَتْ نَحْوِي وقد مُلِّكْتُها","مِشْيةَ العُصْفورِ نَحْوَ الثَّعْلَبِ",20,"ب",1,0],["فمشى الى أرض الحبيب دليله","عينان إنساناهما غرقان",21,"ن",1,0],["فمشى إليه عاتباً أتكون في","بلدي ولست لخيمتي وخواني",21,"ن",2,0],["فمشى على سُنَنِ الهدى","مترَسِّما فيه خطاك",22,"ك",1,0],["فمشى يجرُّ إلى الوغى","أقدامَه مشْىَ القعيد",23,"د",1,0],["فمشى ثلاثتهم إليه وانثنوا","بالضّيف بين الدمع والآهات",24,"ت",1,0],["فمشى يقسم أن لا ينشي","عن لقا ألزاسه أو يقتل",25,"ل",1,0],["فمشى إلى الكوخ المقدس دالفاً","بخطى تئن وذكريات بواك",26,"ك",1,0],["فَمَشَوا عَلى الأَفواهِ مِن إِعظامِهِم","هَذا الثَرى أَن يوطِؤُهُ الأَرجُلا",27,"ل",2,0],["فَمَشروعُ إِنصافِهِ لا يَميلُ","وَمَسموعُ أَوصافِهِ لا يُمَلّ",28,"ل",1,0],["فَمشرعُ عَيشِهِ أَبَداً جِمامٌ","وَمَرعى أنسهُ أَبَداً جَميمُ",29,"م",1,0],["فمُشَبّهو ليلى بوالدِها","شتّانَ بين الفحم والدُرَرِ",30,"ر",1,0],["فمشتْ وأوقفني الهوى","أبكيهِ بعدَ ذهابها",31,"ب",3,0],["فَمشى في جَبينِها شبحُ الغَدرِ","وَفي عَينِها اِستَوى وَاِكفَهَرّا",32,"ر",2,0],["فَمَشَتْ حُمَيَّا حُبِّهِ","في لُبِّهِ فَصَبَا فَغَرَّدْ",33,"د",1,0],["فمشعلُ الحق يبقى ساطعاً أبداً","ما دام يسقيه فيضٌ من ضحايانا",34,"ن",2,0],["فَمَشَوا إِلى الهَيجاءِ في غُلَوائِها","مَشيَ اللُيوثِ بِكُلِّ أَبيَضَ مُذهَبِ",35,"ب",1,1],["فَمشى إِلَيْكَ بِهِ الزِّحَامُ كَأَنَّهُ","عَانٍ يُقَصِّرُ خَطْوَهُ تَكْبِيلُهُ",36,"ل",2,0],["فمشى نحوها وقد نال منها","كتلةً ظنّ أخذها ممنوعا",37,"ع",2,0],["فمشَّوا بأعراف الجيادِ أكُفَّكم","إلى غارةٍ تشفي نجيَّ البلابلِ",38,"ل",1,0],["فَمَشهدهُ في صَونِهِ كَمغيبهِ","وَذاكَ الّذي يُبديهِ مثلُ المكتَّمِ",39,"م",1,0],["فَمَشى مُقَيَّدُها إليهِ مُقَيَّداً","طَلقَ الخُطَى وَحَبالَها مَعقُولا",40,"ل",2,0],["فمشى بها قِبَلَ اليهودِ مصمِّما","يَرجو الشهادة لا كَمَشْيِ الأَنْكِبِ",41,"ب",1,0],["فمشى في الحياة جنديَّها الواهبَ","للمجد قلبَه والصَّدرا",42,"ر",2,0],["فمشت ومرّ على حديقتها","حيث الجمال يموج متّحدا",43,"د",2,0],["فمشى إلى الموت الزُؤا","مِ مشمّراً مشيَ السريع",44,"ع",1,0],["فمشوا فرادى في مسارحه","ومشوا ثنى ومشوا به نفرا",45,"ر",2,0],["فَمَشى بِبَهجتها وَغادر ثاكِلاً","صَبغت كَلابسة الحداد ثِيابَها",46,"ب",3,0],["فَمشت تؤمُّ بِهِ العِراقَ نَجائبٌ","مثل النَعام بِهِ تَخبُّ وَترسم",47,"م",1,0],["فَمَشى لمصرعه الحسين وَطَرفُه","بَينَ الخِيام وَبَينه متقسِّم",47,"م",1,0],["فَمشت عَن زرود لا عَن وَداع","وَهِيَ مُذ أَزمَعَت لِخَير بِقاع",48,"ع",1,0],["فَمَشى يَختال في أَترابه","بِبرودٍ هِيَ مِن صُنع الزَمان",49,"ن",1,0],["فمشيت مثل ابيك في طرق الهدى","وعرفت من سبل التقى ما يعرف",50,"ف",1,0],["فمشرق ومغرب منه ومن","هم سادة حلوا بهذى الدار",51,"ر",1,0],["فمشيتُ أعثر والخمولُ يَصدُّني","علماً بأنّ عَذِيريَ الإحجامُ",52,"م",1,0],["فمشيتُ فِي حُلل الحَيا متعثراً","ويدُ الرجاءِ تُلحُّنى إِلحاحا",53,"ح",2,0],["فمشترك الحس الذي يدرك التي","مضت أول التجويف في مبدأ نزل",54,"ل",1,0],["فمشرق أنوار القبول قد ازدهى","بشمس المعالي والصيانة والفخر",55,"ر",1,0],["فمشارِقُ الأنوارِ منهُ قدْ أتَتْ","بشِهابِ هَدْيٍ موضِحٍ إكْمالها",56,"ل",3,0],["فَمَشَيتُ أَرسُفُ في الحَديدِ مُكَبَّلاً","بِالمَوتِ نَفسي عِندَ ذاكَ أُناجي",57,"ج",2,0],["فَمَشى إلَيها مشيَ أَروعَ باسِلٍ","قَد مارس الغَمراتِ فَهوَ منجّدُ",58,"د",1,0],["