{"poems":[[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[86,"فتية الصهباء خير الشاربين","https://www.aldiwan.net/poem10937.html","الرمل"],[86,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[93,"إن التي تجلت علياً أنجبت","https://www.aldiwan.net/poem11141.html","الكامل"],[88,"عندي حديث عن دمشق فأنصتوا","https://www.aldiwan.net/poem44802.html","الكامل"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[91,"صاحت الضفضع لما شاهدت","https://www.aldiwan.net/poem62742.html","عموديه"],[89,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"برز الثعلب يوماً","https://www.aldiwan.net/poem8033.html","مجزوء الرمل"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[85,"بيت على أرض الهدى وسمائه","https://www.aldiwan.net/poem62935.html","الكامل"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[61,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[61,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141990","الكامل"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[122,"صرعته بعد تطاحن وعراك","https://www.aldiwan.net/poem23737.html","الكامل"],[141,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[141,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[191,"ألا ليت الركاب غدون وقفا","https://www.aldiwan.net/poem13131.html","الوافر"],[195,"يا مي ناب السمع عن بصري","https://www.aldiwan.net/poem39941.html","أحذ الكامل"],[197,"خل القلوب لما بها","https://www.aldiwan.net/poem45576.html","مجزوء الكامل"],[221,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[235,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[288,"يا بلبلا غردا غني فأشجانا","https://www.aldiwan.net/poem11689.html","البسيط"],[361,"فمشوا إلى الهيجاء في غلوائها","https://www.aldiwan.net/poem1696.html","الكامل"],[436,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[441,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[459,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[549,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"]],"verses":[["فَمَشى وَلَم يَخشَ الأَني","سَ فَزارَها وَخَلا بِها",0,"ب",3,0],["فَمَشَت بِالكاسِ وَالطاسِ لَنا","مِشيَةَ الأَفراحِ لِلقَلبِ الحَزين",1,"ن",1,0],["فَمَشى النَثرُ خاضِعاً وَمَشى الشِع","رُ وَأَلقى إِلى الخَليلِ الزِماما",2,"م",2,0],["فَمَشَى وَرَاءَ النَّعْشِ فِي تَشْيِيعِهَا","كُبَرَاءُ قَادَتِهِ وَنُخْبَةُ جُنْدِهِ",3,"د",2,0],["فمشَوا ثلاْثتهم بها وسيوفهم","شُبِّكْنَ كالاكليل فوق قَذالها",4,"ل",3,0],["فَمَشى عَلَيهِ مِنَ الخَريفِ سُرادِقٌ","كَاللَيلِ خَيَّمَ في المَكانِ البَلقَعِ",5,"ع",1,0],["فَمَشَت في سِربِها مُختالَةً","كَمَليكٍ ظافِرٍ بَينَ قُروم",6,"م",1,0],["فمشت به نحو الحتوف جريئة","رجل اذا ما صممت لا تحجم",7,"م",1,0],["فمشت لباب الدار سعياً أمها","ريحانة وكذاك سلمى تهرع",8,"ع",1,0],["فَمَشى في الأَرضِ يَهذي","وَيَسُبُّ الماكِرينا",9,"ن",2,0],["فَمَشَت تُحَطِّمُ بِاليَمينِ ذَخيرَةً","وَتَلُصُّ أُخرى بِالشَمالِ وَتَسرِقُ",10,"ق",1,0],["فَمَشَت كَأَنَّ بَنانَها يَدُ مُدمِنٍ","وَكَأَنَّ السُمَّ فيها زِئبَقُ",10,"ق",1,0],["فَمَشى إِلَيكَ بِجَفنِهِ وَبِدَمعِهِ","وَإِلى أَخيكَ بِقَلبِهِ وَعَزائِهِ",11,"ا",3,0],["فَمَشى إِلَيَّ وَلَيسَ جُؤذَرٍ","وَقَعَت عَلَيهِ حَبائِلي فَقَنَصتُهُ",12,"ت",2,0],["فَمَشَت تُظهِرُ الإِباءَ وَتَحمي الدَم","عَ أَن تَستَرِقَّهُ الضَرّاءُ",13,"ا",2,0],["فمشِّ طرفَك فيما شئتَ من كفلٍ","رابٍ وخَصرٍ كخُوطِ البانِ مَجدولِ",14,"ل",1,0],["فمَشهَدُ عمروٍ حيثُ يُلعَنُ ظالِمٌ","وتَبكي على المظلومِ آلُ محمَّدِ",15,"د",1,0],["فَمَشْرِقَا الأرضِ على فضله","لمغربيها أبداً حاسدان",16,"ن",1,0],["فمشى إليه يَعُودُه في مَوكِبٍ","للّهِ فيهِ من الملائكِ مَوكبُ",17,"ب",1,0],["فمشى يطوِّحُ بالعروش كأنه","شمشونُ في حِلَقِ الحديد يحطمُ",18,"م",1,0],["فَمَشَى إِليَّ فثُرْتُ غَيْرَ مُعَفِّرٍ","كالليثِ مطَّرداً إِلى يَعفورِه",19,"ر",2,0],["فَمشَتْ نَحْوِي وقد مُلِّكْتُها","مِشْيةَ العُصْفورِ نَحْوَ الثَّعْلَبِ",20,"ب",1,0],["فمشى الى أرض الحبيب دليله","عينان إنساناهما غرقان",21,"ن",1,0],["فمشى إليه عاتباً أتكون في","بلدي ولست لخيمتي وخواني",21,"ن",2,0],["فمشى على سُنَنِ الهدى","مترَسِّما فيه خطاك",22,"ك",1,0],["فمشى يجرُّ إلى الوغى","أقدامَه مشْىَ القعيد",23,"د",1,0],["فمشى يقسم أن لا ينشي","عن لقا ألزاسه أو يقتل",24,"ل",1,0],["فمشى إلى الكوخ المقدس دالفاً","بخطى تئن وذكريات بواك",25,"ك",1,0],["فَمَشَوا عَلى الأَفواهِ مِن إِعظامِهِم","هَذا الثَرى أَن يوطِؤُهُ الأَرجُلا",26,"ل",2,0],["فَمَشروعُ إِنصافِهِ لا يَميلُ","وَمَسموعُ أَوصافِهِ لا يُمَلّ",27,"ل",1,0],["فَمشرعُ عَيشِهِ أَبَداً جِمامٌ","وَمَرعى أنسهُ أَبَداً جَميمُ",28,"م",1,0],["فمُشَبّهو ليلى بوالدِها","شتّانَ بين الفحم والدُرَرِ",29,"ر",1,0],["فمشتْ وأوقفني الهوى","أبكيهِ بعدَ ذهابها",30,"ب",3,0],["فَمشى في جَبينِها شبحُ الغَدرِ","وَفي عَينِها اِستَوى وَاِكفَهَرّا",31,"ر",2,0],["فَمَشَتْ حُمَيَّا حُبِّهِ","في لُبِّهِ فَصَبَا فَغَرَّدْ",32,"د",1,0],["فمشعلُ الحق يبقى ساطعاً أبداً","ما دام يسقيه فيضٌ من ضحايانا",33,"ن",2,0],["فَمَشَوا إِلى الهَيجاءِ في غُلَوائِها","مَشيَ اللُيوثِ بِكُلِّ أَبيَضَ مُذهَبِ",34,"ب",1,1],["فَمشى إِلَيْكَ بِهِ الزِّحَامُ كَأَنَّهُ","عَانٍ يُقَصِّرُ خَطْوَهُ تَكْبِيلُهُ",35,"ل",2,0],["فمشى نحوها وقد نال منها","كتلةً ظنّ أخذها ممنوعا",36,"ع",2,0],["فمشَّوا بأعراف الجيادِ أكُفَّكم","إلى غارةٍ تشفي نجيَّ البلابلِ",37,"ل",1,0],["فَمَشهدهُ في صَونِهِ كَمغيبهِ","وَذاكَ الّذي يُبديهِ مثلُ المكتَّمِ",38,"م",1,0]]}