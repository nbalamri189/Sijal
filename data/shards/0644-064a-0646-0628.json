{"poems":[[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[65,"خليلي بئس الرأي ما تريان","https://www.aldiwan.net/poem45933.html","الطويل"],[79,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[88,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[75,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[95,"نأسى إذا ودعتنا الشمس في الطفل","https://www.aldiwan.net/poem11475.html","البسيط"],[85,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[49,"أما إنه ربع الصبا ومعالمه","https://www.aldiwan.net/poem25132.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[74,"تهن تشاريف السعود تواصلت","https://www.aldiwan.net/poem18785.html","الطويل"],[74,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[72,"لئن بحت بالشكوى إليك محبة","https://www.aldiwan.net/poem42972.html","الطويل"],[47,"أإبراهيم دعوة مستعيد","https://www.aldiwan.net/poem63459.html","الوافر"],[47,"لئن بخلت بما تحوي يداك لقد","https://www.aldiwan.net/poem65623.html","البسيط"],[47,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[30,"إن يظعن الشيب الشباب فقد ترى","https://www.aldiwan.net/poem1267.html",""],[30,"كانت منادمة الملوك وتاجهم","https://www.aldiwan.net/poem5480.html","الكامل"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[68,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[46,"محمد إني بعدها لمذمم","https://www.aldiwan.net/poem30518.html","الطويل"],[107,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[107,"هو الجد لا عذر للهازلين","https://www.aldiwan.net/poem42056.html","المتقارب"],[54,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/70287","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[30,"لا قوم أكرم من تميم إذ غدت","https://www.poetsgate.com/ViewPoem.aspx?id=22081",""],[119,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[124,"ما أفصح اللحظ يا حبيبي","https://www.aldiwan.net/poem49361.html","مخلع البسيط"],[154,"لكم من فؤادي خلص الود والحب","https://www.aldiwan.net/poem68479.html","الطويل"],[189,"ألا هل لدائي من فراقك إفراق","https://www.aldiwan.net/poem14607.html","الطويل"],[189,"كتابي كتاب أخي لوعة","https://www.aldiwan.net/poem14616.html","المتقارب"],[242,"أمولاي يا نير المطلع","https://www.aldiwan.net/poem19489.html","المتقارب"],[266,"لئن بعدت عن ناظر الصب داره","https://www.aldiwan.net/poem38144.html","الطويل"],[275,"أتطمع كالضليل بالوطر العالي","https://www.aldiwan.net/poem35625.html","الطويل"],[280,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[353,"أفي تنظم ألغازكم","https://www.aldiwan.net/poem19935.html","المتقارب"],[354,"مرابع سعدى للعيون مراتع","https://www.aldiwan.net/poem15780.html","الطويل"],[371,"وبدر بأفلاك الخواطر طالع","https://www.aldiwan.net/poem17042.html","الطويل"],[376,"لئن بان فالأشواق تعمل في الحشى","https://www.aldiwan.net/poem57020.html","الطويل"],[376,"على ما حل بي وهم حلول","https://www.aldiwan.net/poem57232.html","مجزوء الوافر"],[406,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[409,"سلام على تلك الديار وأهلها","https://www.aldiwan.net/poem33359.html","الطويل"],[412,"عفى طلل بالرامتين ومنهج","https://www.aldiwan.net/poem50196.html","الطويل"],[422,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[422,"ألا من مبلغ عني سلامي","https://www.aldiwan.net/poem54135.html","الوافر"],[447,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[447,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[463,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[505,"هل البرق نجدي أم البرج متكين","https://www.aldiwan.net/poem37764.html","الطويل"],[567,"أرى فتنة الدنيا هي الآية الكبرى","https://www.aldiwan.net/poem52811.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[595,"","https://poetry.dctabudhabi.ae/diwan/poem/100676","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83290","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48629","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63747","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37939","البسيط"],[918,"","https://poetry.dctabudhabi.ae/diwan/poem/107323","الطويل"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104412","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115853","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35710","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79840","المتقارب"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202162","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69373","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33884","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77367","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105011","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87676","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137324",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94314","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74203","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74284","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107052","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89077","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108091","الطويل"],[3617,"","https://poetry.dctabudhabi.ae/diwan/poem/107037","المجتث"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85254","الطويل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32644","البسيط"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142945","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35581","الطويل"],[4005,"","https://poetry.dctabudhabi.ae/diwan/poem/205341","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136619",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104530","الطويل"],[4525,"","https://poetry.dctabudhabi.ae/diwan/poem/124052","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72417","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139581",""],[4679,"أيدري الدهر ما فعلت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=142734",""],[4771,"أعبدَيَّ قَد أسأرتُما في جَوانحي","https://www.poetsgate.com/ViewPoem.aspx?id=106604",""],[4804,"لئن بعدت عن الاحباب دارُ","https://www.poetsgate.com/ViewPoem.aspx?id=92090",""],[4973,"محبوبتي","https://www.poetsgate.com/ViewPoem.aspx?id=188691",""],[5062,"رومية","https://www.poetsgate.com/ViewPoem.aspx?id=20956",""],[5121,"كأس الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=33579",""],[5184,"يا دجلة الخير .. يا أماهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210847",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5444,"براعمُ الصخر","https://www.poetsgate.com/ViewPoem.aspx?id=205070",""],[5484,"تباريح الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=206307",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[6003,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=188923",""],[6018,"لئن بخلت بإسعادى سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=181196",""],[6070,"أرى الأرواحَ تهتفُ للجمالِ","https://www.poetsgate.com/ViewPoem.aspx?id=193544",""],[520,"عنان اليالي في يديك مسلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577658",""]],"verses":[["لَئِن بَرَقَت مِنّي مَخايلُ عارِضٍ","لَعَينَيكَ يَقضي أَن يَجودَ وَيُغدِقا",0,"ق",2,0],["لَئِن بُزَّ هَذا الحَيُّ مِنكَ عِمادَهُ","فَغَيرُ عَجيبٍ أَن يَعِزَّ وَيَمنُعا",1,"ع",2,0],["لِئِنْ بَسَطَتْ باعِي مِنَ اللهِ نِعْمَةٌ","وَلَمْ أُحْيَ يَوْمَي نَائِلٍ وَطِعانِ",2,"ن",1,0],["لِئَنْ بَلِيَتْ تِلْكَ المَحَاسنُ في الثَّرَى","فَحُزْنِي جَدِيدٌ ما اسْتَمَرَّ الْجَدِيدَانِ",3,"ن",1,0],["لَئِن باتَ بِالمَجدِ المُؤَثَّلِ مُغرَماً","لَقَد كانَ إِبراهيمُ بِالمَجدِ مُغرَما",4,"م",2,0],["لِيَنُب عَنِ الجَوزاءَ قُرطُكِ كُلَّما","جَنَحَت تَحُثُّ جَناحَها تَغريبا",5,"ب",2,0],["لَئِنْ بَكَتْ لِنَوَاهُ مِصْرُ مِنْ ثَكَلٍ","مَا حَالُ لُبْنَانَ بيْنَ اليُتْمِ وَالثَّكَلِ",6,"ل",1,0],["لئن بلغوا دوني وخُلَّفْتُ إنه","قضاءٌ جرى من مالك الأرض ديَّانِ",7,"ن",1,0],["لَئِن بِتَّ تَبكيهِ خَلاءً فَطالَما","نَعِمتَ بِهِ دَهراً وَفيهِ نَواعِمُه",8,"م",2,0],["لَئِن باعَدَتكُم نِيَّةٌ طالَ شَحطُها","لَقَد قَرَّبَتكُم نِيَّةٌ وَضَمائِرُ",9,"ر",1,0],["لئن بيضت عين المحبين بالهنا","لقد بيضت عين المعادين بالقهر",10,"ر",1,0],["لئن بسطت أيدي الحوادث بعده","لعهدي بها مغلولة بنكاله",11,"ل",2,0],["لَئِن بُحتُ بِالشَكوى إِلَيكَ مَحَبَّةً","فَلَستُ لِمَخلوقٍ سِواكَ أَبوحُ",12,"ح",1,1],["لَئِن بَعُدَت عِراقُكَ عَن شَآمي","كَما بَعُدَت جُدودُكَ عَن جُدودي",13,"د",2,0],["لَئِن بَخِلتَ بِما تَحوي يَداكَ لَقَد","أَصبَحتَ سَمحاً بِما تَحتَ السَراويلِ",14,"ل",1,1],["لَئِن بانَ مِنّا جودُهُ وَسَماحُهُ","لَقَد بانَ مِنهُم مَجدُهُ وَمَكارِمُه",15,"م",2,0],["لَئِن بَلَّ لي أَرضي بِلالٌ بِدَفقَةٍ","مِنَ الغَيثِ في يُمنى يَدَيهِ اِنسِكابُها",16,"ب",3,0],["لِيُنَبِّأَنَّكَ رَهطُ مَعنٍ فَأتِهِم","بِالعِلمِ وَالأَنِفونَ مِن سَمّالِ",17,"ل",1,0],["لَئِن بِتَّ مَحسودَ الخِصالِ فَلا أَذىً","كَذا مَن غَدا في الناسِ وَهُوَ فَريدُ",18,"د",1,0],["لَئِن بَخِلَت إِنَّ الخَيالَ مُسامِحٌ","وَإِن غَضِبَت فَالطَيفُ مِنها مُصالِحُ",19,"ح",1,0],["لَئِن بَعُدَت مِنّا الجَوانِحُ عَنكُمُ","فَفي رَبعِكُم مِنّا القُلوبُ جَوانِحُ",19,"ح",1,0],["لَئِن بَقِيَت لي فيكَ آثارُ مَنطِقٍ","لَقَد بَقِيَت آثارُ كَفَّيكَ في دَهري",20,"ر",2,0],["لئن بات وادي النيل بعدك جازعا","لقد روعت أنباؤك الصين والهندا",21,"د",2,0],["لئن بات يبكي بُكاءَ النّساء","لقد هاجه عهدُه الزّائلُ",22,"ل",1,0],["لَئِن بانَ صَرفُ زَمانٍ بِنا","لَما زالَ يَفعَلُ ما قَد تَرى",23,"ا",1,0],["لَئِن باعَدتَ رحمٌ بَينَنا","لَقَد كانَ فينا الحَبيب القَريب",24,"ب",1,0],["لَئِنْ بِتَّ فِي الْغَيْبِ القَصِيِّ مُحَجَّباً","لَقَدْ عدْتَ فِي هَذَا الزمَانِ مُجَدَّدَا",25,"د",2,0],["لئِنْ بعُدْتُمْ وحالَ البَحْرُ دونَكُمُ","لبَيْنَ أرواحِنا في النَّومِ زَوْرَاتُ",26,"ت",1,0],["لَيُنَبّئَنّكَ رَهْطُ مَعْنٍ، فَأتهِمْ","بالعِلْمِ، وَالأنِفُونَ مِنْ سَمّالِ",27,"ل",1,0],["لئن بت محجوبا وفزت سفاسف","فحينا جمال الشمس بالعتم يستر",28,"ر",1,0],["لينبت الورد والأقاحي","وضاحة الثغر والجبين",29,"ن",1,0],["لئن بَعُدَت أرجاء أرضي عنكم","فما لي في الدنيا سوى شعبكم شعب",30,"ب",1,0],["لئن بَعَّدتْ ما بيننا شُقَّة النَّوى","ومُطَّرِدٌ طامي الغَوارِب خَفّاق",31,"ق",1,0],["لئن بَعُدتْ بك عنه النَّوَى","فشخصُك ما بين أحداقه",32,"ق",2,0],["لَئِنْ بَانَ شَخْصُكَ عَنْ نَاظِرِي","فَمَا بَانَ حُبُّكَ عَنْ أَضْلُعِي",33,"ع",2,0],["لئن بعدت عن ناظر الصب داره","فقد قر في قلبي المعنى قراره",34,"ر",2,1],["لئن بَقيت نَفسي تُنيرُ كنجعةٍ","فما همّني جسمي ولا همّني مالي",35,"ل",2,0],["لَئِن بَخِلْتُم بِنزْر ليسَ يَرْزَؤُكُمْ","لَتَفْضَحُنّ بِما تأتُونَه العَربَا",36,"ب",2,0],["لِيُنبيكَ أَنيّ أَبُو زَيدِها","وَمَا لِلسَّرُوجيّ مَا لِلسِّراجِ",37,"ج",1,0],["لَئِن بَعُدَت لَيلى وَصَدَّت تَعَزُّزاً","فَإِنِّيَ مِنها بِالتَعَطُّفِ طامِعُ",38,"ع",1,0],["لَئِن بِتُّ في بَحرٍ مِنَ الفِكرِ سابِحاً","فَإِنسانُ عَيني في الدُموعِ غَريقُ",39,"ق",1,0],["لئِن بانَ فالأشواقُ تَعملُ في الحَشَى","كما عَمِلَت أجفانُه قبلَ بَينِهِ",40,"ه",1,1],["لَئِن باتَت تُسابِقُني المَعاني","إِلَيكَ كَأنَّ مُختَرعاً مَقولُ",41,"ل",1,0],["لئن بعُدت بك الأحداث عن","ولم تمهلك أهوال الخطوب",42,"ب",1,0],["لئن بعدت عنا وشط بها النوى","فما شط عن قلب المحب هواها",43,"ا",3,0],["لَئِن بلغتنيه اللَيالي وَجادَ لي","نِداهُ الَّذي في جودِهِ لا يُهَجهِجُ",44,"ج",1,0],["لئنْ بلَّغَتْني ما أُحاوِلُ ناقتي","وَرَدْتُ بها ماءَ العُذَيب زلالا",45,"ل",2,0],["لئن بلَّغتني رمل يبرين ناقتي","عليَّ حرام ظهرها ومشيلها",46,"ه",2,0],["لئن باهَتْ به الزوراء أرْبَتْ","بهمته على حلب وشام",47,"م",1,0],["لئن بكت الورقا هديلاً فإنني","لأبكي أَبا الخرصين لا أتفند",48,"د",1,0],["لئن بقيت عندي المصيبة بعده","فإني بها لِلّه مولاي أصمد",48,"د",1,0],["لئن بكت الحمام على هديل","بكيت فتى منيباً أصمعيا",49,"ي",2,0],["لئن بايعتنا المزنُ رُوحاً برُوحه","لقد غَبَنَتْناهُ من الثمن الغالي",50,"ل",2,0],["لئِن بَعُدَتْ عنَّا نَواحي بِطاحِكُمْ","فقد قَرُبَتْ والحمد للهِ مِتْكينُ",51,"ن",1,0],["لئن باتَ في أكفانهِ البيضِ مُدرَجاً","ففي جَنَّةِ الخُلدِ ارتدَى سُندُساً خُضْرا",52,"ر",2,0],["لينبذ العهد معا إليهم","وليقر من براءة عليهم",53,"م",1,0],["لَئِن بَلِيتَ فلا يَبلى نَداك ولا","تُنسى وَكم هالكٍ يُنسى اذا قَدُما",54,"م",2,0],["لَئِن بَكَتِ الخَنساءُ صَخراً فَإِنَّهُ","لَقَد باتَ يَبكي الصَخرُ طولَ نَحيبي",55,"ب",2,0],["لئن بقيت على الهجران قاسية","أضحى الثرى بدمي يا ميُّ مختضبا",56,"ب",2,0],["لئن بكما حَلَتْ أيامُ عَيْشي","لقد عادَتْ حلاوَتُها مَرارا",57,"ر",2,0],["لَئِن بُليتَ بِذي إِفْكٍ وَذي كَذِبٍ","رَماكَ في قَولِ زُورٍ مِن جَهالَتِهِ",58,"ه",1,1],["لئِن بانَ صَدٌّ منهُمُ فقلُوبُنا","على العهدِ لا يُخشى عليها ازوِرَارُها",59,"ر",3,0],["لئن بعدت منا الجسوم عن الحمى","ففي ربعه منا القلوب ودايع",60,"ع",1,0],["لئن بَردَت أحشاكَ من حُرقة الهوى","فبين ضلوعى جَمرةٌ تتلهَّبُ",61,"ب",1,0],["لَئِن بَكَت الدُنيا عَلَيهِ وَأَعوَلَت","فَبِالمُصطَفى عَن كُلِّ ماضٍ تَسَلَّتِ",62,"ت",1,0],["لئن بانَ جسمي عنه فقد","تخلَّف قلبي فيه وثيقا",63,"ق",2,0],["لَئِنْ براني هوى أَهلِ الحِمى فَلَكَمْ","داوَيْتُ من حُبِّهمْ دائي فما بَرأَ",64,"ا",1,0],["لَئِن باتَ مَهجورَ المَحَلِّ عِراقُهُ","فَقَد باتَ مَأنوسَ المَحَلِّ شآمُهُ",65,"م",2,0],["لَئِن بَكَيتُ عَلى مِصرٍ وَساكِنِها","إِنّي لَأَفرَغُ مِن حَجّامِ ساباطِ",66,"ط",1,0],["لَئِن بِتُّ جَبّاراً عَلى الأَرضِ قاهِراً","فَلَستُ لِجَبّارِ السَماءِ أُحارِبُ",67,"ب",1,0],["لئن بلغت فيك الحوادث قصدها","فقد بلغت نفسي عليك التراقيا",68,"ي",2,0],["لَئن بُعدَت مَنازلكم فَقَلبي","لَكُم مِن دُونِها كَنَفٌ وَدار",69,"ر",1,0],["لئن باخيه كنت قليل حظ","فحظك فيه موفور عظيم",70,"م",1,0],["لئن باعدنني صدا","لما باعدت عن صدد",71,"د",1,0],["لَئن بَكَت الأَجفان ماء لِفَقده","فَتلكَ عُيون الأُفق أَدمعها حُمر",72,"ر",1,0],["لَئِن بدئ الأَمر الخَطير بجده","فَبالحبر عَبد اللَه قَد ختم الأَمر",73,"ر",1,0],["لئن بت بعد الدهر حبل ودادنا","وكنتم إلى السلوان أدنى وأقربا",74,"ب",2,0],["لئن بهمته دارت بلا تعبٍ","فطالما بكم دارت مع الجهد",75,"د",1,0],["لئن بذلت مصر عليك حفاوة","وإن أكبرت يوم اللقا لك مقدما",76,"م",2,0],["لئن بقيت على ما","أرى أخالك تهلك",77,"ك",1,0],["لئن بلغتنا عنك يا ابن طباطبا","نسيم الصاب شوقاً لحد يجاوز",78,"ز",1,0],["لَئِن بَليتَ فَكَم أَبلَيتَ مِن أُمَمٍ","تَترى أَبادَتهُمُ أَيّامُكَ الأَوَّلُ",79,"ل",1,0],["لئن بزني دهري ببغداد ثروتي","فما زلت من كسب المحامد كاسيا",80,"ي",2,0],["لَئِن بانَ عَنّي مَن كَلِفت بِحُبِّهِ","وَشَطّ فَما لِلعّينِ مِن شَخصِهِ حَظُّ",81,"ظ",1,0],["لئن بخلت علينا يا بن عمّتنا","لنأتين ابن أخت غير بخّال",82,"ل",1,0],["لئن بتُّ إلفاً للثرّيا يا بليلتي","فأنيَ أسيرُ الشَوق وهي سَلاسلي",83,"ل",2,0],["لئن بك للأشياء حد وغاية","فللعلم ما أبعدتموه هو الحد",84,"د",1,0],["لئن بلّغتنا العيس من بعد جوبنا","فيافى فيها للجبال تراكم",85,"م",1,0],["لئن بكت الخنساء صخرا فإنه","عليهمن كم استبكي غداة بكى صخرا",86,"ر",2,0],["لئن بدار سلامٍ شاد قصرَ علاً","سما على كل قصرٍ للسما عرجا",87,"ج",2,0],["لئن بكت البلاد دماً عليه","فكم أفنى بخدمتها دماهُ",88,"ا",2,0],["لَئنْ بزَّنِي دَهري ببغدادَ نابهاً","وأصبحْتُ في أكنافِ شِرْوانَ عاريا",89,"ي",2,0],["لئن بعدت عن الاحباب دارُ","فمالي بعد فرقتهم قرارُ",90,"ر",1,1],["لين ٌ به الف ٌ كمسك ختامهِ","ليصونه من كسرة ِ الإعرابِ",91,"ب",1,0],["لئن بعدت قوارب أرتجيها","ونهر كنت أسكنه كتابي",92,"ب",2,0],["لينبضَ عقلي بنبْضٍ طَهورٍ","ويخفقَ قلبي بشَدْوٍ صَدوحِ",93,"ح",1,0],["لينبضَ الوردُ في شبّاك حُجرتنا","لَوْ كَسّرَ الطينُ أضلاعَ السنادينِ",94,"ن",1,0],["لئن بكيت فلا إلفٌ ليسمعني","وليس لي قدم أرمي بها السبلا",95,"ل",2,0],["لئن بخل الحي الحلول بطيفهم","فعيني جادت بالحيا عبراتها",96,"ت",3,0],["ليَنبلجَ البوحُ المُغنِّي لساجدٍ","بمحرابِ تسبيحٍ تناثرَ من صَدري",97,"ر",2,0],["لئن بعدتْ عنك الجسوم فإنما","هنالك قلبٌ عند ذكراك واجف",98,"ف",1,0],["لينبش فرعون وهامان من","قبريهما والكي والكاذر",99,"ر",1,0],["لينبت الحب والتحنان في أفقي","ويرقص الكون من عزف المجانين",100,"ن",1,0],["لئن بخلت بإسعادى سعاد","فإني بالفؤاد لها جواد",101,"د",1,1],["لينبتَ في ربيعِكَ نبضُ حبٍ","سليمٌ صادقٌ في كلِّ حالِ",102,"ل",1,0],["لئن بلغت من كافر لك حجةٌ","لقد شيعت في شاكر لك أنعم",103,"م",1,0]]}