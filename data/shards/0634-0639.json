",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[33,"أنِيري مَكانَ البَدْرِ إنْ أفَلَ البَدْرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14108&r=&rc=43",""],[87,"ما لي بودك بعدَ اليومِ إلمامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23823&r=&rc=85",""],[96,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""],[96,"الملك البطل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66347&r=&rc=23",""]],"verses":[["شِعراً أُثيرُ بِهِ العَجاجَ بَسالَةً","كَالطَعنِ يُدمي وَالقَنا يَتَحَطَّمُ",0,"م",1,0],["شِعارِيَ مِن دونِ الشِعارِ وَتارَةً","قَريبِيَ مِن دونِ القَريبِ المُنافِثِ",1,"ث",1,0],["شُعباً مُفَرَّقَةً يَطيرُ فُضاضُها","كَالقَعبِ مُنصَدِعاً وَلَمّا يُرأَبِ",2,"ب",1,0],["شَعرٌ صَحِبتُ بِهِ الشَبابَ غُرانَقاً","وَالعَيشَ مُخضَرَّ الجَنابِ رَطيبا",3,"ب",2,0],["شِعبٌ غَدا وَهوَ لِل","لَهِ وَالمَلائِكِ شِعبُ",4,"ب",1,0],["شِعرُ المَراغيِّ وَحوشيتُمُ","كَعَقلِهِ أَسلَمُهُ أَسقَمُهْ",5,"ه",1,1],["شَعثِ المَفارِقِ مُنهَجٍ سِربالُهُ","لَم يَدَّهِن حَولاً وَلَم يَتَرَجَّلِ",6,"ل",1,0],["شِعارُهُمُ عِلْمٌ وحِلْمٌ ونائِلٌ","وحرْبٌ ومِحْرابٌ وسيْفٌ ومُصْحَفُ",7,"ف",1,0],["شُعثٍ يُبارينَ الأَسِن","تَه كَالنَعاماتِ الجَوافِل",8,"ل",1,0],["شَعَرنا بِحاجاتِ الحَياةِ فَإِن وَنَت","عَزائِمُنا عَن نَيلِها كَيفَ نُعذَرُ",9,"ر",1,0],["شَعَرنا وَأَحسَسنا وَباتَت نُفوسُنا","مِنَ العَيشِ إِلّا في ذُرا العِزِّ تَسخَرُ",9,"ر",1,0],["شِعارُ أَهليها وَأَبنائِها","أَن يَعلَمَ المَرءُ وَأَن يَعمَلا",10,"ل",2,0],["شُعَراءُ نَفحِ الطيبِ أَنشَرَ ذِكرُهُم","في أَرضِ أَندَلُسٍ أَديبُ زَمانِهِ",11,"ن",2,0],["شِعرُنا مِثلُ الحرا ذُقتَ الحرا","صَفعَ اللَهُ بِهِ أَصلَ لِحانا",12,"ن",2,0],["شِعرٌ يُقَطّعُ بِالنِعالِ أَخادِعَ ال","أَعشى وَيحرا في عَوارِضِ جَروَلِ",13,"ل",1,0],["شِعرٌ سَمَت بِاِسمِهِ الشِعرى لِشِركَتِها","فيهِ فَقامَت تُباهي الشَمسَ وَالقَمَرا",14,"ر",2,0],["شع مع الصبح بأنفاسه","كأنما الصبح عليه رقيب",15,"ب",1,0],["شَعِثَت شَواحِبَ لا يَنينَ","إِذا وَنى لَيلُ النَوائِح",16,"ح",1,0],["شَعْبٌ يُحِبُّ بِلادَهُ فَإِذَا","هَانَتْ فَمَا لِبَقَائِهِ ثَمَنُ",17,"ن",1,0],["شُعَاعُ الفَرِيدَةِ فِي المَالِكَاتِ","وَبِنْتُ المُرَحَّبِ فِي المَالِكِينْ",18,"ن",1,0],["شِعْرٌ كَأَنَّ مَفِيضَ الخَيْرِ سَالَ بِهِ","عَلَى النُّهَى سَيلَهُ فِي القَاعِ وَالأَكَمِ",19,"م",1,0],["شِعْرٌ كَأَنَّ شُعُورَ الْقَوْمِ قَدَّرَهُ","فَلاحَ مَظْنُونُهُ فِيهِ كَمُرْتَسَمِ",20,"م",1,0],["شِعارُكَ في الحَربِ يَومَ الوَغى","إِذا اِنهَزَموا عَجِّلوا عَجِّلوا",21,"ل",3,0],["شعره شفّ عن دها","ما له فيه منتهى",22,"ه",2,0],["شعره شعر متقن","فيه شك لموقن",22,"ن",1,0],["شُعِفتَ بِعَهدٍ ذَكَّرَتهُ المَنازِلُ","وَكِدتَ تَناسى الحِلمَ وَالشَيبُ شامِلُ",23,"ل",1,1],["شُعثٌ عِجالٌ وَأَنقاضٌ عَلى سَفَرٍ","قَد شاعَ فيهِنَّ أَنعالٌ وَتَخديمُ",24,"م",1,0],["شُعثٌ مَدَاليجُ قد تَغَوَّلت ال","ارضُ بهم فالقِفَافُ فالكُثُبُ",25,"ب",1,0],["شِعراً إِذا ماقِستُهُ","بِجَميعِ أَشعارِ السَلَف",26,"ف",1,0],["شُعَيبٌ وَإِلياسُ وَذو الكَفلِ كُلُّهُم","يَمانونَ قَد فازوا بِطيبِ السَرائِرِ",27,"ر",1,0],["شعر بشعر فائق معه ندًى","وافٍ فيا فوزي بكسب مُرابي",28,"ب",2,0],["شعري بحسنك لا يزالُ مشبباً","يصف الأسى وبنارِه مشبوبا",29,"ب",2,0],["شعرت بمدحِك حتى بهرت","وكنتُ من العيّ لا أشعر",30,"ر",1,0],["شعار نعم وزير قد دعوه إلى","نعم البيوت فوفَّاه شعائره",31,"ر",2,0],["شعري وقلبي بيتا مدحةٍ وولاً","حاشاكَ تهدم بيتاً أنت ساكنه",32,"ه",1,0],["شَعَرٌ ميتٌ لذي وَطَرٍ حي","يٍ كنارِ الحريق ذات اللهيبِ",33,"ب",1,0],["شِعْرٌ يُغير عليه باسلاً بطلاً","ويُنشدُ الناسَ إياهُ على رِقَبِ",34,"ب",1,0],["شعراتٌ في الرأس بيضٌ ودعْجُ","حلّ رأسي جِيلان روم وزنجُ",35,"ج",1,1],["شعريَ شعرٌ إذا تأمَّله ال","إنسان ذو الفهم والحجا عَبَدَهْ",36,"د",2,0],["شعارَين يهتز الكريمُ عليهما","كما اهتزَّ صَمْصَامٌ جلتْه مَداوِسه",37,"س",2,0],["شعارُ الفتى ذمُ الزمان الذي أتى","ومن شأنه حمدُ الزمانِ الذي مضى",38,"ض",2,0],["شِعرُكَ لا تثبتُ آثارُهُ","من غرَّةِ اليومِ إلى الليلِ",39,"ل",1,0],["شُعَلٌ تزيدك في النهار سنىً","وتُضيءُ في مُحْلَوْلك الظُّلمِ",40,"م",1,0],["شُعِفَتْ به فأذاقها طرفاً","مما تُذيقُ مُحالفَ الكتَمِ",40,"م",1,0],["شعفاً بالقدِّ يا من قدُّه","أضحت الأغصانُ تحكي غُصنه",41,"ن",2,0],["شَعَفَ الكِلابُ الضارِياتُ فُؤادَهُ","فَإِذا يَرى الصُبحَ المُصَدَّقَ يَفزَعُ",42,"ع",1,0],["شَعَبتُ شُؤونَ الرَأسِ بَعدَ اِنفِراجِهِ","بِصَهباءَ صِرفٍ مِن طُلَيَّةِ رُستَمِ",43,"م",1,1],["شُعثُ النَواصي عادَةٌ مِن فِعلِها","سَفكُ الدِماءِ وَقِسمَةُ الأَموالِ",44,"ل",1,0],["شَعبٌ كَما شاءَ التَخاذُلُ وَالهَوى","مُتَفَرِّقٌ وَيَكادُ أَن يَتَمَزَّقا",45,"ق",2,0],["شَعَّبَتْهُ الدُّهُورُ وانطمسَ النُّورُ","وقامتْ بنا بَنَاتُ الظَّلامِ",46,"م",1,0],["شَعْرُهُ مُرْسَلٌ تُداعِبُهُ الرِّيحُ","على منكبيْه مثلَ الدُّمُقْسِ",47,"س",1,0],["شِعْرِي نُفاثَةُ صَدْرِي","إنْ جاشَ فيهِ شُعوري",48,"ي",1,1],["شعْرَ السَّعادةِ والسَّلامِ ونفسهُ","سَكْرى بسِحْر العالَم الخلاّبِ",49,"ب",1,0],["شِعرٌ هوَ السِحرُ فَلا تُنكِروا","أَنّي بِهِ ما عِشتُ مَسحورُ",50,"ر",1,0],["شِعرُ مَن مَحضُ وُدّه","لَكَ في عِلمِ طَيرهِ",51,"ه",1,1],["شعُرتَ فَجِئتَ بِعَين المُحال","وَما زِلتَ ذا خَطلِ في المَقالْ",52,"ل",1,1],["شُعراءُ طَنجَةَ كلِّهم وَالمَغرِبِ","ذَهَبوا مِن الاغراب أَبعَدَ مَذهَبِ",53,"ب",1,1],["شعري كطفل قد مشى متعثراً","يهدي اليه الورد في اردانه",54,"ن",2,0],["شعر يفيض من القلب المشع له","على اللسان فما ان فيه تعقيد",55,"د",1,0],["شعر حكى العين معناه يفيض اسى","ولفظه دمع تلك العين ينهمر",56,"ر",1,0],["شعري بما في القلب مني ناطق","واذا سكت فان دمعي ينطق",57,"ق",1,0],["شعر له من شعوري","والصدق مستندات",58,"ت",1,0],["شعرنا بما لم يشعر القوم قبلنا","شعور السليل الناهض المتهذب",59,"ب",1,0],["شعر جرى من جنبات الصّبا","يا طيب واديه وطيب المسيل",60,"ل",1,0],["شعر جرى فيه الشباب كأنه","جنبات روض طَلَّهن غمام",61,"م",1,0],["شعب يجير النصارى في مآربه","وسيفه في يهود الأرض يفنيها",62,"ي",3,0]