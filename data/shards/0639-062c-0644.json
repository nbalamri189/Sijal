ط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83471","المجتث"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83532","السريع"],[4362,"","https://poetry.dctabudhabi.ae/diwan/poem/146031","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66152","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58153","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116076","الكامل"],[4755,"عِجْلُ البلادِ تَأَلَّهَا","https://www.poetsgate.com/ViewPoem.aspx?id=184679",""],[4755,"عَجِّلْ بخُطاكَ المَحسُوبةْ","https://www.poetsgate.com/ViewPoem.aspx?id=191251",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[4908,"عتاب الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=207417",""],[4984,"ويحك ..","https://www.poetsgate.com/ViewPoem.aspx?id=175801",""],[5061,"طفيت انوار المدينه","https://www.poetsgate.com/ViewPoem.aspx?id=157544",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5189,"باب الله","https://www.poetsgate.com/ViewPoem.aspx?id=212827",""],[5277,"لا تمسحِ الدمعَ","https://www.poetsgate.com/ViewPoem.aspx?id=195072",""],[5277,"بغدادُ..عاصمةُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=215233",""],[5431,"إليك سعى فؤادي َ بعْدَ ذبحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=185891",""],[5431,"تبارك الله فيه العشق أحيانا","https://www.poetsgate.com/ViewPoem.aspx?id=188254",""],[5431,"موسى والخضر وقلبي...","https://www.poetsgate.com/ViewPoem.aspx?id=189801",""],[5431,"عجلتُ إليك يا طفلا بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=191290",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5431,"عجلتُ إلى ربي..","https://www.poetsgate.com/ViewPoem.aspx?id=191729",""],[5431,"علّي أرى علّي","https://www.poetsgate.com/ViewPoem.aspx?id=195184",""],[5431,"مصر...والرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=197044",""],[5431,"حنظلة...مازال في العشق الكثير لنكمله!","https://www.poetsgate.com/ViewPoem.aspx?id=198015",""],[5431,"غيومٌ به سكرى...","https://www.poetsgate.com/ViewPoem.aspx?id=198423",""],[5577,"شطر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=177005",""],[5582,"يا صاحِبَيَّ قِفَا يا صاحِبَيَّ قِفَا","https://www.poetsgate.com/ViewPoem.aspx?id=63535",""],[5612,"عَوِّدْ فُؤادَك","https://www.poetsgate.com/ViewPoem.aspx?id=197396",""],[5688,"في القلب غرام هدهده","https://www.poetsgate.com/ViewPoem.aspx?id=200845",""],[5739,"عظم ومفاصل","https://www.poetsgate.com/ViewPoem.aspx?id=126711",""],[5739,"ياغايبه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131706",""],[5818,"وجد وأرق","https://www.poetsgate.com/ViewPoem.aspx?id=197072",""],[5879,"الوجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=215458",""],[5937,"ستٌ وعشرون احتراقاً","https://www.poetsgate.com/ViewPoem.aspx?id=211885",""],[1920,"عشاء فاخر","https://www.poetsgate.com/ViewPoem.aspx?id=191428",""],[5964,"أيها القرم الذي","https://www.poetsgate.com/ViewPoem.aspx?id=181309",""],[6001,"حالي الذوق","https://www.poetsgate.com/ViewPoem.aspx?id=409",""],[6093,"إليْكَ يا بَحْرُ طِفْلُ الشَّامِ قَدْ هَرَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=177749",""],[2575,"مرحى فقد وضح الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=1364",""],[6142,"لمن أذيل عقيق الأدمع السجم","https://www.poetsgate.com/ViewPoem.aspx?id=155760",""],[6182,"قَدْر ما يَتَنَهَّدُ الربّانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86105&r=&rc=2",""],[2914,"لِمَن طَلَلٌ ، مِثلُ الكِتابِ المُنمَّقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24236&r=&rc=2",""]],"verses":[["عجل فداك أبي فالدين قد هدمت","أركانه وأستبيحت دونك الحُرَم",0,"م",1,0],["عجل علينا فقد ضل الهداة كما","ضل العصاة وجار الذئب والغنم",0,"م",1,0],["عجل بصالحنا من قبل طالحنا","وأبدأ بمن عدلوا من قبل من ظلموا",0,"م",3,0],["عَجِلتَ يا شَيبُ عَلى مَفرِقي","وَأَيُّ عُذرٍ لَكَ أَن تَعجَلا",1,"ل",2,1],["عَجلى الرَواحِ كَأَنَّما لَمَحَت","فيكُم غَديرَ الجودِ مِن قَبلي",2,"ل",2,0],["عَجِلٌ بِيَ الشَدُّ الحَثيثُ إِلى ال","غاياتِ خَرّاجٌ بِيَ المَهَلُ",3,"ل",1,0],["عَجلانَ أُلبِسُ وَجهي كُلَّ داجِيَةٍ","وَالبَرُّ عُريانُ مِن ظَبيٍ وَيَعفورِ",4,"ر",1,0],["عَجلانَ يَحمِلُ مَغرَمَ ال","دُنيا عَلى ظَهرٍ حَسيرِ",5,"ر",1,0],["عَجِلَ الزَمانُ بِها إِلَيكَ وَحُطِّمَت","بَينَ الضُلوعِ ضَغائِنٌ وَحُقودُ",6,"د",1,0],["عَجِلَت بَنو شَيبانَ مُدَّتَهُم","وَالبُقعُ أَستاهاً بَنو لَأمِ",7,"م",1,0],["عَجِّل شِفاها وَاِمنُن عَلَيَّ بِها","وَاِجعَل فِداها نَفسي مِنَ السَقَمِ",8,"م",1,0],["عَجلاً إِلى المَعهَدِ الأَدنى فَفاجَأَها","أَقطاعُ مَسكٍ وَسافَت مِن دَمٍ دُفَعا",9,"ع",2,0],["عَجَّلتَ يا مَحمودُ في رِحلَةٍ","قَرَّت بِها أَعيُنُ حورِ الجِنانِ",10,"ن",1,0],["عَجِّل بِها قَبلَ الفَسا","دِ وَقَبلَ عادِيَةِ البَوارِ",11,"ر",1,0],["عَجَّلْتَ بَيْنَكَ فِي جِهَادِكَ فَاحْتَوَى","مَعْنَى الشَّهَادَة وَهْيَ ذَاتُ مَعانِ",12,"ن",1,0],["عَجْلاً إِلَى الغَايَاتِ تَطْلُبُهَا","بِمَضَاء لا وَانٍ وَلا بَرِمِ",13,"م",1,0],["عَجَّلَ رَبّي لَها خَراباً","بِرَغمِ أَنفِ الَّذي اِبتَناها",14,"ا",3,0],["عَجِلتِ إِلى مَلامَتِنا وَتَسري","مَطايانا وَلَيلُكِ غَيرُ ساري",15,"ر",2,0],["عَجِلَ المَليكُ لَهُ فَأَهلَكَ جَمعَهُ","بِشَنارِ مُخزِيَةٍ وَسوءِ عَذابِ",16,"ب",1,0],["عجّل بموسى قاطعٍ","واقذف بها من حالق",17,"ق",1,0],["عَجِّلْ لهم ذاك ولا تَهْجُهم","ولا يَثِبْ منك بهم واثبُ",18,"ب",1,0],["عجِّل رحيلَ السَّقام عنه وأَمْ","تعْهُ صحيحاً بالمُكث واللبَثِ",19,"ث",1,0],["عَجِلٍ إِلى غاياتِهِ مُستَوفِزٌ","أَبَداً يَشُدّدُ العَجزَ مِنهُ الكَلكَلُ",20,"ل",1,0],["عَجلانُ يَكتَسِحُ البِلادَ وَأَهلَها","إِنَّ الشَقِيَّ العاجِزُ المُتَواني",21,"ن",2,0],["عَجِلَ الفِراقُ وَلَيتَهُ لَم يَعجَلِ","وَجَرَت بَوادِرُ دَمعِكَ المُتَهَلِّلِ",22,"ل",1,1],["عجلت في الترحال يا شوقي وقد","بقيت هنالك لم تقل أشياء",23,"ا",2,0],["عجِّلي أن أموت فيك والَّا","فاسمحي لي بنظرة من بعيد",24,"د",1,0],["عِجلت إليك فغيَّبت","زين الشباب نُهى وخلقا",25,"ق",2,0],["عجِل الردى بهما ولا عجب إذا","ما أوديا بين الهوى والطيب",26,"ب",1,0],["عَجِلٌ بِالَّذي تُنيلُ يَداهُ","إِنَّ بُطءَ النَوالِ مِن تَنكيدِه",27,"د",2,0],["عَجِلٌ إِلى نُجحِ الفَعالِ كَأَنَّما","يُمسي عَلى وِترٍ مِنَ المَوعودِ",28,"د",1,0],["عَجِّل بِهِ سَيِّدي وَاِمنُن عَلَيَّ بِهِ","قَبلَ الصِيامِ وَقَبلَ الفِطرِ وَالعيدِ",29,"د",1,0],["عَجِلتُم إِلى نَصرِ الأَميرِ وَلَم يَزَل","يُوالي مَواليهِ وَيُنصَرُ ناصِرُه",30,"ر",2,0],["عَجِلَت إِلى فَضلِ الخِمارِ فَآثَرَت","عَذَباتِهِ بِمَواضِعِ التَقبيلِ",31,"ل",1,0],["عَجِلَت مَواهِبُهُ لَكُم فَتَسَرَّعَت","وَتَثَبَّتَت خُطُواتُهُ أَن تَعجَلا",32,"ل",2,0],["عَجِلنا عَنِ الغَليِ القِرى مِن سَنامِها","لِأَضيافِنا وَالنابُ وَردٌ عِقالُها",33,"ل",3,0],["عَجِلَتْ فلم تَخْتَطْ عليكَ من الرَّدى","ورَجَتْ حِياطَةَ مُسلمٍ مُحتاطِ",34,"ط",1,0],["عَجِلُ الرِّماحِ إلى الأعادي مِسْعَرٌ","يأبى سِوى طَعْنِ الشُّجاعِ المِسعَرِ",35,"ر",1,0],["عَجِّلوهُ لِرَحيلٍ","عَجِّلوا لا تَحبِسوهُ",36,"و",2,0],["عَجِلَت يَداهُ عَلى عِداهُ بِصارِمٍ","بَرقُ المَنِيَّةِ مِن سَناهُ يَلمَعُ",37,"ع",1,0],["عَجِلتَ إِلى قِراعِهِمُ بِعَزمٍ","بِهِ يَدنو لَكَ الأَمَلُ البَعيدُ",38,"د",1,0],["عَجِلَت حُمَّةُ الفِراقِ عَلَينا","بِرَحيلٍ وَلَم نَخَف أَن تَبينا",39,"ن",2,0],["عَجلانَ لَم يَقضِ بَعدُ حاجَتَهُ","أَلا تَأَنّى يَوماً فَيُنتَظَرُ",40,"ر",1,0],["عَجَّلَ اللَهُ قَطَّهُنَّ وَأَبقى","كُلَّ خَودٍ خَريدَةٍ قَبّاءِ",41,"ا",2,0],["عَجلَ المغارِ إذا يُؤامرُ نَفسَهُ","أَيُقيمُ أم يمضي الضّعيفُ الواني",42,"ن",2,0],["عَجِلَ الرِّفاقُ فمزّعَتْهم نِيَّةٌ","بَعُدَ المطارُ بها عن العَنْقاءِ",43,"ا",2,0],["عَجِلَ الرَقيبُ بِلَحظِ عاشِقِهِ","أَو دامَ في وَجَناتِهِ خَدَشا",44,"ش",2,0],["عَجِلتَ له بَطشاً وإنّ وراءه","لَخَرْقاً من البيد المرَوراتِ أفيحا",45,"ح",2,0],["عُج لِلوُقوفِ عَلى راحٍ وَرَيحانِ","فَما الوُقوفُ عَلى الأَطلالِ مِن شاني",46,"ن",2,1],["عَجِلٌ بِحُبِّكِ مَوتُهُ عَن يَومِهِ","إِن لَم يُجِرهُ مِن هَواكِ مُجيرُ",47,"ر",1,0],["عَجِلُ الرُكوبِ إِذا اِعتَرَتهُ نافِضٌ","فَإِذا أَفاقَ فَلَيسَ بِالرَكّابِ",48,"ب",1,1],["عَجِلُ العَلامَةِ حينَ أُغ