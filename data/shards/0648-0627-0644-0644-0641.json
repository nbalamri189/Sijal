{"poems":[[74,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[74,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[91,"الشعر كالفارس المغوار ذو جرة","https://www.aldiwan.net/poem44787.html","البسيط"],[47,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[47,"لا الدّهرُ مُستَنفَدٌ، وَلاَ عَجَبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31555",""],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59589","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128721",""],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77976","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131595",""],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27827","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58320","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132710","الكامل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89506","المجتث"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125882","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4767,"خوف وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=209076",""],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""]],"verses":[["واللفظُ نثرٌ من صفاتِ الحسنِ لا","بيضاء روضِ حمًى ولا صفراؤه",0,"ا",3,0],["واللفظ بين إناءةٍ وإفادةٍ","قسمَ الزمانُ فليسَ يعدَمُ طالِبا",1,"ب",2,0],["واللفظ غمد لمعناه ومن عجب","ان يقطع النصل منه وهو مغمود",2,"د",1,0],["وَاللَفظَ حُليُ المَعنى لَيسَ يُري","كَ الصُفرُ حُسناً يُريكَهُ ذَهَبُه",3,"ب",2,0],["واللفظ راق واحداً وراعا","حول معان دقّت اختراعا",4,"ع",2,0],["وَاللَّفْظُ تَكْسُوهُ مَبَا","هِجُ مِنْ حُلَى قَوْسِ الْغَمَامِ",5,"م",1,0],["واللّفْظُ حَليُ المَعنى وَلَيس يُرِيكَ ال","صُّفْرُ حُسْناً يُرِيكَهُ ذَهَبُهْ",6,"ب",2,0],["وَاللَّفْظُ يَجْلُو خُرَّداً","قَدْ زَفَّهَا الْفِكْرُ الْمُؤَيَّدْ",7,"د",1,0],["وَاللَفظُ في مَدحِهِ بِالوَزنِ مُؤتَلَفٍ","وَإِنَّما القَدرُ عالَ قَد ناعَتُهُ",8,"ت",2,0],["واللف والنشر في صبري وفي شغفي","والحمل والحفظ للهجران والذمم",9,"م",1,0],["واللفظ مشترك ولكنا نرى","لك وصفَ متّحد الفضائل مفرد",10,"د",1,0],["واللفظ بالقياس والسماع","من غير حرف وهو بالسماع",11,"ع",1,0],["واللفظ فدرّ مفصل بجمان","ما عقد لآل وما قلائد عقيان",12,"ن",1,0],["وَاللفظ دل عَلى المعنى فأوضحه","والاسم دل عَلى موسى وَهارون",13,"ن",1,0],["واللفت الرفراف بالأشناف","والأقراط إن خاف ما شافه",14,"ه",1,0],["واللفظُ إن لم يحو عيناً وهو ذو","جيمٍ وراء ٍضادُه تَتَحَتَّمُ",15,"م",1,0],["واللفظ ينكر ما قد قال في ألف","وما ابتغى جدلاً ولا رآه مرا",16,"ر",2,0],["واللَّفظُ كالمعنَى قَدِيمٌ قَائِمٌ","بالنَّفسِ لَيسَ بقَابِلِ الحِدثَانِ",17,"ن",1,0],["وَاللَّفظُ مِنهُ مُفرَدٌ ومَركَّبٌ","فِي الاعتِبَارِ فَمَا هُمَا سِيانِ",17,"ن",1,0],["واللَّفظُ فِي التَّركيبِ نَصٌّ فِي الذِي","قَصَدَ المُخَاطِبُ مِنهُ فِي التِّبيَانِ",17,"ن",1,0],["وَاللَّفظُ حِينَ يُسَاقُ بِالتركِيبِ مَح","فُوفٌ بِهِ للفَهمِ وَالتِّبيَانِ",17,"ن",1,0],["وَاللَّفظُ بِالتَّوحِيدِ نَجعَلُهُ مَكَا","نَ اللَّفظِ بِالتَّركِيبِ فِي التِّبيَانِ",17,"ن",1,0],["وَاللَّفظُ بِالتَّوحِيدِ أولَى بِالصِّفَا","تِ وَبالعُلُوِّ لِمَن لَهُ أذُنَانِ",17,"ن",1,0],["واللفاتي مكسّرات كما قَدْ","كُسّرَتْ في رَحَى البدورِ الكؤوسُ",18,"س",1,0],["واللفظ والمعنى إذا اتفقا به","تم الملاك وبالبديع كماله",19,"ل",2,0],["واللفظ إما طلب أو خبر","وأولٌ ثلاثة فالتماس وقعا",20,"ع",2,0],["واللفظ عذب المقال","هذا سبب بهجتي",21,"ي",1,0],["وَاللَفظ مُؤتلف بِاللَفظ مُنتَظم","مِن جَوهر النطق في سلك مِن الحكم",22,"م",1,0],["واللفظُ يَخدِم مَعنى المدحِ مؤتلفاً","ان المعاني لها الأَلفاظُ كالخَدَمِ",23,"م",1,0],["واللفظُ بالفظِ كالعِقيان مؤتلفٌ","ودُرُّ نظمي غلا في كاملي الشِيمِ",23,"م",1,0],["واللفظُ عُنوانُ الجَنانِ كأَنَّهُ","زَهرٌ تَبَيَّنُ منهُ صِحَّةُ غَرسِهِ",24,"س",2,0],["واللفظُ مهما بَدا في الوزنِ مؤتلفاً","تأتي المعاني له كالروح في البدن",25,"ن",1,0],["واللفظ نوعان مما أعربوا وبنوا","فاحكم على كلِّ لفظٍ بالذي حُكِما",26,"م",2,0],["واللفظ شهداً سال فيكِ ولم يزل","حتى بدا اللفظ الجميل مؤنقا",27,"ق",2,0],["واللفظ والإطلاق بدعي ولا","نرضى بما قال الجهول الماجن",28,"ن",1,0]]}