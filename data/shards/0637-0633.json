{"poems":[[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77845","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77830","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77847","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53006","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53005","الكامل"],[3919,"","https://poetry.dctabudhabi.ae/diwan/poem/203265","السريع"],[4858,"وادي حنيفة ، هل شهدت لظاها ؟","https://www.poetsgate.com/ViewPoem.aspx?id=139902",""]],"verses":[["طس طول طائل من طوله","طرسين سر التين وَالزَيتون",0,"ن",1,0],["طس طه نَفسي فداها","ما لي سواها جاهي وَشاني",1,"ي",1,0],["طستون في دستون أَرباب العلى","وَالمرسلون كأَنجم الأَسحار",2,"ر",1,0],["طسنٌ له في المجد فضلُ إمارهْ","وعليه من علم الوقارِ أمَاره",3,"ر",2,1],["طسن علا في المجد أسنى رتبةً","وعلى المدى سينالُ فضلَ مزيد",4,"د",1,0],["طسم تصحيف معكوسه","يخفى وليس الظن بالكاذب",5,"ب",1,0],["طسمٌ ، جديسٌ ، هالني ذكراهما","ونهاية الزّرقاءِ ما أقساها",6,"ا",3,0]]}