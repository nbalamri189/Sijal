{"poems":[[74,"عذار خديه راق مراها","https://www.aldiwan.net/poem20516.html","المنسرح"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[80,"تم له الحسن بالعذار","https://www.aldiwan.net/poem14036.html","مخلع البسيط"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[91,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[159,"يا من إذا رمت عنه الصبر يمنعني","https://www.aldiwan.net/poem55637.html","البسيط"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[445,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[463,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64231","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63791","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37796","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144036","المنسرح"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77743","الكامل"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76677","المنسرح"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109343","الرمل"],[2246,"","https://poetry.dctabudhabi.ae/diwan/poem/116754","الخفيف"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33023","الطويل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124668","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216562",""],[3551,"","https://poetry.dctabudhabi.ae/diwan/poem/46149","المواليا"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[5092,"عناد","https://www.poetsgate.com/ViewPoem.aspx?id=176738",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[5574,"يا جيشنا","https://www.poetsgate.com/ViewPoem.aspx?id=206037",""],[5725,"عراق شعلان وضاري","https://www.poetsgate.com/ViewPoem.aspx?id=177471",""],[5956,"اخضعي لي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182616",""],[5956,"رحلةُ أسرة لغابِ المَسَرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=210739",""],[5975,"إلى صاحبة الرداء الأخضر ...","https://www.poetsgate.com/ViewPoem.aspx?id=61930",""],[6102,"يَارَا","https://www.poetsgate.com/ViewPoem.aspx?id=185333",""],[6152,"خضوع قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203269",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""],[463,"إلى كمْ حبسها تشكو المضيقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60169&r=&rc=225",""],[4890,"إلى سيزيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72664&r=&rc=154",""]],"verses":[["أخضر نفس الفتى به ألفتْ","والنفس خضراء قد عرفناها",0,"ا",3,0],["أخضل الشكرُ بالندى فتضوّع","ريحَ ريحانِه على الإخضالِ",1,"ل",1,0],["أَخضَرُ في أَبيَضَ تَبَدّى","ذَلِكَ آسي وَذا بَهاري",2,"ر",2,0],["اخضعي يا نفس فما لك فيما","أبرمته الأقدار إلا الخضوع",3,"ع",1,0],["اخضع الامة العظيمة بالحسنى","فلله عطفه الابوي",4,"ي",1,0],["أَخضع الناس نفذ الحكم فيهم","وَطد الأمن أرخص الأسعارا",5,"ر",2,0],["أخضر السنبل تحت الشمأل","يأخذ الفيلق إذ يبكمه",6,"ه",1,0],["اخضعي يا نفسي فمالك فيما","ابرمته الاقدار الا الخضوع",7,"ع",1,0],["اخْضَعْ إِذا عَزَّ مَنْ تَهْوى وَذِلَّ لَهُ","فَودُّ أَهْلِ الهَوى أَبْقَى إِذا خَضَعُوا",8,"ع",3,0],["أخضَعتِهِ وسَلبتِ كلَّ كنوزهِ","فغدا أمامَكِ خاضِعاً حَيرانا",9,"ن",2,0],["أَخْضَعْتَنِي لِلنَّائِباتِ وَمَنْ يُصَبْ","يَوْماً بِمِثْلِكَ يَسْتَذِلَّ وَيَخْضَعِ",10,"ع",1,0],["أَخضرُ اللَّونِ مُكْتَسيهِ كَساهُ","كُسوةً لم يكنْ لها تَكوين",11,"ن",1,0],["أَخْضَلْتَ فِيهِ السَّيفَ من مُهَجاتِهِمُ","وتركتَهم لِلرَّامِساتِ هَشِيما",12,"م",2,0],["أخضْ أخفافَها الغمرات حتى","ترى في الآل سابحَها غريقا",13,"ق",2,0],["أخضرُ ما دونَ الجَنى ناضرٌ","وفاقعٌ أصفرُ ما يَطلُعُ",14,"ع",1,0],["أخضر اللون كالزمُردِ في أَح","مَرَ صافي الأديم كالأرجوان",15,"ن",1,0],["إخضرارٌ لم يخلُ منه اصفرارٌ","وابيضاضٌ لم يخلُ منه احمرار",16,"ر",1,0],["اِخضَرَّ شارِبُهُ وَريقَتُه غَدت","تُحيي لِشارِبها بقَرْقَفِها العَطِرْ",17,"ر",1,1],["أَخْضَرَ كَالبُرْدِ غَزِيرَ المُنْبَعَقْ","قَدْ كَفَّ عَنْ حَائِرِهِ بَعْدَ الدفَقْ",18,"ق",1,0],["أخضرُ هنديٌ لمَىً كلُّه","والصّارمُ الهنديّ ذو خُضرَهْ",19,"ر",2,0],["أَخضَرَ صَرّافٍ كَحَدِّ المِعوَلِ","أَفطَحَ قَد كادَ وَلَمّا يَنجَلِ",20,"ل",1,0],["اخضر لون الجو من أَبرادها","وَتضوع الكافور في القانون",21,"ن",1,0],["أَخضرُ ذو زِرَّينِ يُسقى سِما","ماً فإِذا أُرهِفَ لَم يَنحَلِ",22,"ل",1,0],["أخضر يفتر من جوانبه","كالبحر في جزره وفي مده",23,"د",2,0],["اخضر الأكناف رحب المنتدى","أبيض العرض نقيّ المنتقد",24,"د",1,0],["أخضرَ اللون ذي فرندٍ كأن النم","ل دبّت في متنه والذباب",25,"ب",1,0],["أَخَضتُهُمُ بَحرَ الحِمامِ وَخُضتُهُ","رَجاءَ الثَوابِ لا رَجاءَ المَغانِمِ",26,"م",1,0],["أخضَر اللونِ أخضَرَ الفيء","والخطوِ نديَّ الاوراق رطب العبيرِ",27,"ر",1,0],["أخضعته باحتلالي","فانصاع ذلاّ وأسرا",28,"ر",2,0],["اخضَعْ واحَازي بِهْ مْحَازاه","وأقُوم بالْمَايوبْ كِلّهْ",29,"ل",2,0],["أَخضَر لمه تَبخَل علي بِوَصلك","أَخضَر سَباني بهجتك وَخصرك",30,"ك",1,1],["أَخضَر تُماطِل كَم يَكون مطلك","أَخضَر سويدا مُهجَتي محلّك",30,"ك",1,0],["أَخضَر بِمَن صاغَك قمر مصور","أَخضَر بِمَن سَوّاك غصن أَخضَر",30,"ر",1,0],["أَخضَر بِمن زانَك بطرف أَحوَر","لا تهجر المُشتاق فيك يهلك",30,"ك",1,0],["أَخضَر قُليبي ذابَ عَلَيك واِمتاس","أَخضَر أَنا ما أَعشَق سواك في الناس",30,"س",1,0],["أَخضَر أَنا قَلبي شَجى بحبك","وَتَشتَهي نَفسي لقاك وَقُربك",30,"ك",1,0],["أَخضَر لمه خضرت لازوردك","بلازوردي قَد نقشت خدَّك",30,"ك",1,0],["أَخضَر بِقَلبي قَد سكنت وَحدَك","شاشُق لَك قَلبي تَرى محلك",30,"ك",1,0],["أَخضَر هَويت الحسن وَالمَحاسِن","بكل مَعنى ظاهِراً وَباطِن",30,"ن",1,0],["أخضر الربع والجناب خصيب","أفيح المستراد للمستريد",31,"د",1,0],["أُخضِّبُ من صباحيَ كلَّ ليلٍ","ألوِّنُ من مساءاتي الهُدابا",32,"ب",2,0],["إخضلّ من دمعةٍ حرّى بزفرتها","عُوّارها من غبار الحربِ مختضبُ",33,"ب",1,0],["أخضعت روحه فأوغل فيما","هز أركانه وأوهى اعتداله",34,"ل",2,0],["٣- أخْضَعْتَ رأْسَ المارقينَ بقبْضَةٍ","تبَّتْ يدا من شاءَ أنْ يتمرَّدَا",35,"د",2,0],["اخضّل من دمها راحتيْ","وألثم في وجهك المبسما",36,"م",2,0],["اخضعي لي لِتُسَرّي باحتوائي","‏ ‏ بي مزايا هي من فضل السماء",37,"ا",2,1],["اخضوضرَ الغابُ النضير بشاشة","بوجودهم وزهت زهورُ هِضابِ",38,"ب",1,0],["أخضر لوَّعَ قلبي الأخضر","وعيوني في مداهُ تبحرْ",39,"ر",1,1],["أخضرٌ صارَ قصيدي أخضراً","مذ لبستيهِ فكيفَ الأحمرْ ؟؟!",39,"ر",1,0],["أُخَضِّبُ مِنْ شِعرِي سُيُوفًا شَحَذتُها","فَأَبيَضُها - فِي الطَّعنِ - يَهتَزُّ أَحمَرا",40,"ر",2,0],["اخضعت قلبي لطيف منك آنسني","وقبل حبك لم يخضع لإنسان",41,"ن",1,0],["أخضرُ السفح أزهرُ السطح مصقولُ","الحواشي زاهي الربى والتلالِ",42,"ل",1,0],["أخضْ أخفاقها الغمراتْ حتّى","ترى في الآلِ سابحها غريقا",43,"ق",2,0],["أخضعُ لِلحُمّى وللشرارْ","أبحثُ في المحاجر الضريره",44,"ه",1,0]]}