{"poems":[[72,"عذار خديه راق مراها","https://www.aldiwan.net/poem20516.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[78,"تم له الحسن بالعذار","https://www.aldiwan.net/poem14036.html","مخلع البسيط"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[89,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[155,"يا من إذا رمت عنه الصبر يمنعني","https://www.aldiwan.net/poem55637.html","البسيط"],[270,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[280,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[364,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[439,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[458,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"]],"verses":[["أخضر نفس الفتى به ألفتْ","والنفس خضراء قد عرفناها",0,"ا",3,0],["أخضل الشكرُ بالندى فتضوّع","ريحَ ريحانِه على الإخضالِ",1,"ل",1,0],["أَخضَرُ في أَبيَضَ تَبَدّى","ذَلِكَ آسي وَذا بَهاري",2,"ي",1,0],["اخضعي يا نفس فما لك فيما","أبرمته الأقدار إلا الخضوع",3,"ع",1,0],["اخضع الامة العظيمة بالحسنى","فلله عطفه الابوي",4,"ي",1,0],["أَخضع الناس نفذ الحكم فيهم","وَطد الأمن أرخص الأسعارا",5,"ر",2,0],["أخضر السنبل تحت الشمأل","يأخذ الفيلق إذ يبكمه",6,"ه",1,0],["اخضعي يا نفسي فمالك فيما","ابرمته الاقدار الا الخضوع",7,"ع",1,0],["اخْضَعْ إِذا عَزَّ مَنْ تَهْوى وَذِلَّ لَهُ","فَودُّ أَهْلِ الهَوى أَبْقَى إِذا خَضَعُوا",8,"ع",3,0],["أخضَعتِهِ وسَلبتِ كلَّ كنوزهِ","فغدا أمامَكِ خاضِعاً حَيرانا",9,"ن",2,0],["أَخْضَعْتَنِي لِلنَّائِباتِ وَمَنْ يُصَبْ","يَوْماً بِمِثْلِكَ يَسْتَذِلَّ وَيَخْضَعِ",10,"ع",1,0],["أَخضرُ اللَّونِ مُكْتَسيهِ كَساهُ","كُسوةً لم يكنْ لها تَكوين",11,"ن",1,0],["أَخْضَلْتَ فِيهِ السَّيفَ من مُهَجاتِهِمُ","وتركتَهم لِلرَّامِساتِ هَشِيما",12,"م",2,0],["أخضْ أخفافَها الغمرات حتى","ترى في الآل سابحَها غريقا",13,"ق",2,0]]}