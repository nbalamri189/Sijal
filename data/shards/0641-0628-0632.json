{"poems":[[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118306","الرجز"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188165","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121815","المنسرح"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99402","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89415","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116880","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102750","البسيط"],[4942,"ولد الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=188837",""]],"verses":[["فبزغت شمس الهدى في الغيهب","فابيض كل اسود واكهب",0,"ب",1,0],["( فبزايد) يشدو الوجود ويزدهي","ويقول مثلك مارأيت مثيلا",1,"ل",2,0],["فبِزَّةُ المرءِ في تَجَمُّلِهِ","عليْه عُنْوانُ نِعمةِ اللّهِ",2,"ه",1,0],["فبزوه وما عروه درعاً","نبت عنه الصوارم والسهام",3,"م",1,0],["فبزري وكتاني وقمحي وسمسمي","على الأَرض من تحت السماء كما تنوي",4,"ي",1,0],["فبزّت يدي غضبا لها ثوب جسمها","وأعريتها باللطف من كلّ ملبسي",5,"س",2,0],["فبزني الشوق صبرا كان ينجدني","فرحت أبكي بدمع سائل هطل",6,"ل",1,0],["فبزغتَ كالمشكاة نورا ساطعا","وعلى الدجى تستبسلُ الأنوارُ",7,"ر",1,0]]}