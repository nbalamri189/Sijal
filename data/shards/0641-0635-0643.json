{"poems":[[50,"يا رب خرق نازح حديب","https://www.aldiwan.net/poem62452.html","الرجز"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[173,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[473,"ما أنس لا أنس غياثا وقد","https://www.aldiwan.net/poem60471.html","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66653","الوافر"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144829","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38619","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65941","الطويل"],[572,"وروضة ٌ مشبعة ُ الأَصباغِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9386&r=&rc=243",""]],"verses":[["فَصَكُّهُ بِزَورِهِ الرَحيبِ","صَكّاً هَوى مِنهُ إِلى شَعوبِ",0,"ب",1,0],["فصكهم سيف جبار بكلمة ج","بار السماء على الأجيال منتصر",1,"ر",1,0],["فَصَكَّ بِهِ الأَبطالَ صَكّاً بِهِ اِلتَقَت","لِقاءَ قِلىً أَقدامُها وَالعَنافِقُ",2,"ق",1,0],["فَصَكَّ هامَ العِدى صَكّاً بِهِ مُقَلٌ","قَرَّت لِأَن سَخِنَت مِن وَقعِهِ مُقَلُ",3,"ل",1,0],["فَصَكَّهُ مَن كانَ مِن خَلفِهِ","فَقالَ ما هَذا جَوابٌ يَجِب",4,"ب",1,0],["فصكّ بِخُفِّهِ وانسابَ منه","وولّى هارباً حَذَرَ الحِصابِ",5,"ب",1,0],["فصكّت المهد غضبي فهي لافظةٌ","بعضاً على بعضهم من شدّة النّزق",6,"ق",1,0],["فَصّ كَبيرٌ مِنَ الأَلماسِ دايِرة","لَقَد تَركّب في ياقوتَةِ الشّفقِ",7,"ق",1,0],["فصك بهم شرقاً ففي الشرق عدة","تقيم بها في الغرب كل معوج",8,"ج",1,0],["فَصَكّهَا كالحجرِ الدمّاغِ","وشكّ في كثيرِهِ التّراغي",9,"غ",2,0]]}