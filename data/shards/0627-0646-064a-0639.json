","مجزوء الكامل"],[416,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[429,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[432,"شعري كمجدك من يرمه مقصر","https://www.aldiwan.net/poem12631.html","الكامل"],[437,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[437,"عم الندى وتواتر الإنعام","https://www.aldiwan.net/poem2560.html","الكامل"],[441,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[453,"لو كنت كالمتنبي في جراءته","https://www.aldiwan.net/poem61584.html","البسيط"],[458,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[470,"ما من مصيبة نكبة أمنى بها","https://www.aldiwan.net/poem4838.html","الكامل"],[500,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[500,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[500,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[500,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[500,"ما الفخر إلا للذين تواضعوا","https://www.aldiwan.net/poem38013.html","الكامل"],[505,"النسيان","https://www.aldiwan.net/poem42457.html","السريع"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[515,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[515,"الله أعلى وأعلم","https://www.aldiwan.net/poem12267.html","المجتث"],[515,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[551,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[551,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[551,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[553,"واكبدا أحرق الهوى كبدي","https://www.aldiwan.net/poem68369.html","المنسرح"],[558,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[562,"دعوت جنح الدجى مولاي مبتهلا","https://www.aldiwan.net/poem52736.html","البسيط"],[562,"قف بالديار وحي القوم عن كثب","https://www.aldiwan.net/poem52914.html","البسيط"],[562,"القلب بين الصحب أعدل شاهد","https://www.aldiwan.net/poem52952.html","البسيط"],[562,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[575,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[575,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[584,"يا عين بكي عتبه","https://www.aldiwan.net/poem69381.html","مجزوء الرجز"]],"verses":[["إِنّي عَلِقتُ عَلى مِنىً","لَمياءَ يَقتُلُني لَماها",0,"ا",3,0],["إِنّي عَلَيكَ إِذا اِمتَلَأتَ حَمِيَّةً","بِنَدى أَميرِ المُؤمِنينَ مُحَرَّمُ",1,"م",1,0],["إِنّي عَلى طولِ الصُدودِ لَكُم","كَالنَفسِ مَأمونٌ تَحَيُّفُها",2,"ف",3,0],["إِنّي عَلِقتُ سَوادَ اللَونِ بَعدَكُمُ","عَلاقَةً تُشمِتُ الظَلماءَ بِالقَمَرِ",3,"ر",1,0],["إِنّي عَلى شَغَفي بِالحُبِّ مُعتَذِرٌ","مِن أَن يُقالَ شُجاعٌ فَلَّهُ الوَصَبُ",4,"ب",1,0],["أَنّى عَلى قَضَضِ الهَ","مَ يَطمَئِنُّ الجَنبُ",5,"ب",1,0],["إِنّي عَلى لينِ النَقي","بَةِ لا أُعابُ وَلا أُحابُ",6,"ب",1,0],["إِن يُعاقِب يَكُن غَراماً وَإِن يُع","طِ جَزيلاً فَإِنَّهُ لا يُبالي",7,"ل",2,0],["إِن يَعدُ عَن سَمُراتِ جِزعِكَ سامِرٌ","في كُلِّ مُطَلَّعٍ لَهُم إِرعادُ",8,"د",1,0],["أن يعلنوا إفلاسي","بين جميع الناس",9,"س",1,0],["إِنِّي عَجِبْتُ لِعَاقِلٍ مِنْ رَهْطِكُمْ","مُبْدٍ جَمِيلاً وَهْوَ مُضْمِرُ ضِدِّهِ",10,"د",2,0],["إن يعجز الأمر عن مشىٍ فهم سندٌ","لو كنت مُسنده منهم بُعكّاز",11,"ز",1,0],["إِنّي عَلى كُلِّ حالٍ لَستُ أَذكُرُهُم","إِلّا وَلِلشَوقِ دَمعي واكِفٌ سَجِمُ",12,"م",1,0],["إِنّي عَلى عِلّاتِهِ أُرافِقُه","أُصفي لَهُ الوِدَّ وَلا أُماذِقُه",13,"ق",2,0],["إِنّي عَلَيكَ أَبا حُصَينٍ عاتِبٌ","وَالحُرُّ يَحتَمِلُ الصَديقَ وَيَصبِرُ",14,"ر",1,0],["إني عليه لعظيم البركهْ","فلْيدْعُ لي ما صاحبته الحركهْ",15,"ه",1,0],["إني على ثقةٍ بأنك ماجدٌ","فكأنني فيما أقول خصيمُ",16,"م",1,0],["إِنّي عَرَفتُ مِنَ الإِنسانِ ما كانا","فَلَستُ أَحمَدُ بَعدَ اليَومِ إِنسانا",17,"ن",2,1],["إِنّي عَشِقتُكَ لا عَن رُؤيَةٍ عَرَضَت","وَالقَلبُ يُدرِكُ ما لا يُدرِكُ البَصَر",18,"ر",1,1],["إِن يَعرِفوني فَمَعروفٌ لِذي بَصَرٍ","أَو يَنسُبوني فَعالي الذِكرِ مَشهورُ",19,"ر",1,0],["إِنّي عَلَيها مُقيمٌ","لِرائِحٍ أَو لِغَادِ",20,"د",1,0],["إِنّي عَلى إِلفَتي لِلسُهدِ وَالكَمَدِ","أَدعوكَ يا مُضنيَ الأَجسامِ بالسُهُدِ",21,"د",1,1],["إِنّي عَشِيَّةَ رُحتُ وَهيَ حَزينَةٌ","تَشكو إِلَيَّ صَبابَةً لَصَبورُ",22,"ر",1,0],["اني على عهد الصبا في كبرتي","ابكي كما يبكي الفقيد الفاقد",23,"د",1,0],["اني على كبري اخف","الى اللقاء من النسيم",24,"م",1,0],["اني على الاوطان انفق مهجتي","اما الدخيل فاي شيء ينفق",25,"ق",1,0],["إنى على العهد ما حييت فإن","خلوت تبقى العهود لا تخلو",26,"ل",2,0],["إِن يَعرِضوهُ عَلى الجِبالِ تَهُن لَهُ","وَهِيَ الجِبالُ فَما أَشَدَّ قُواكا",27,"ك",2,0],["إِن يَعدُهُ مِنكِ الخُلودُ فَشَعرُهُ","باقٍ وَلَيسَ بَيانُهُ لِنَفادِ",28,"د",1,0],["إِنّي عَلى شَغَفي بِما في خُمرِها","لَأَعِفُّ عَمّا في سَراويلاتِها",29,"ت",3,0],["إِن يُعمِلوا الجَورَ يَقصِد في تَصَرُّفِهِ","أَو يُسرِفوا في فُنونِ الأَمرِ يَقتَصِدِ",30,"د",1,0],["إِنِّيَ عَبدٌ وَأَنتَ مَولىً","فَاِبغِ رِضا اللَهِ في العَبيدِ",31,"د",1,0],["إِن يَعِد يوشِكِ النَجاحَ وَإِن يَت","رُك فَمِثلانِ وَعدُهُ وَضَميرُه",32,"ر",2,0],["إِن يَعُد هَجرُها جَديداً فَقَد كا","نَ جَديداً مِنّا وَمِنها الوِصالُ",33,"ل",1,0],["إني عَشِقْتُ مِنَ السَّعادَةِ مُسْعِدا","واصَلتُهُ فغدا مشوقاً شائقا",34,"ق",2,1],["إنّي على سَلْبِكُما لَمُجتَري","وفي الذي أَطلقْتُ غيرُ مُقتِرِ",35,"ر",1,0],["إِنّي عَجِزتُ عَجزَةً لا أَعتَذِر","سَوفَ أَكيسُ بَعدَها وَاَستَمِر",36,"ر",1,1],["إِنّي عَلى ما كانَ مِن","كَ لَواثِقٌ بِجَميلِ رائِك",37,"ك",1,0],["إنّي عشقتك ما طلب","تُ على محبَّتيَ الجزاء",38,"ا",2,0],["إني على كاسي أُعيد السنين","وأبعث الماضي البعيدَ الدفين",39,"ن",1,1],["إني عن الفئتين قمت وإنه","شرفٌ بلغت به أجل مرادِ",40,"د",1,0],["إني على يأسي وكأسي كأبي","وعلى سرابي عاكف وشرابي",41,"ا",3,0],["إن يعلُهُ صدأ فكمْ من صَفحةٍ","مصقولةٍ للماء تحت الطُّحلبِ",42,"ب",1,0],["إِنّي عَلى ما نالَني لَصَبورُ","وَبِغَيرِ حُسنِ تَجَلُّدٍ لَجَديرُ",43,"ر",1,1],["إِن يَعدُ مِن حَرِّها عَدوَ الظَليمِ فَقَد","أَوسَعتَ جاحِمَها مِن كَثرَةِ الحَطَبِ",44,"ب",1,0],["إني عدمتُ صديقاً","قَدْ كانَ يعرفُ قدري",45,"ي",1,1],["إِن يَعتَكِر لَيلُ العَجاجَةِ تَستَتِر","أَو يَعتَرِض شَيطانُ حَربٍ تُرجَمِ",46,"م",1,0],["إِن يَعجَبوا لِلقاتِلينَ فَأَمرُهُم","إِذ يَعكِفونَ عَلى الغِوايَةِ أَعجَبُ",47,"ب",1,0],["إِنّي عَفَفتُ عَنِ المُلوكِ فَلَن أَرى","مُتَمَسِّحاً بِسُتورِهِم أَتَقَرَّبُ",48,"ب",1,0],["إِنّي عَجِبتُ وَفي الأَيّامِ مُعتَبَرٌ","وَالدَهرُ يَأتي بِأَلوانِ الأَعاجيبِ",49,"ب",1,1],["إِنّي عَلى ما اِرتَكَبتِ مِنّي","أَدعو لَكِ اللَهَ في صَلاتي",50,"ت",2,0],["إِنّي عَلى ما ذَكَرتُ مِن فَرَقٍ","لا آمُلُ أَن أَنالَهُ بِيَدي",51,"ي",1,0],["إِنّي عَشِقتُ وَهَل في العِشقِ مِن باسِ","ما مَرَّ مِثلُ الهَوى شَيءٌ عَلى راسي",52,"ي",1,1],["إِنّي عَلِقتُ الأَحمَدَينِ كِلَيهِما","كَيما يَكونُ هَوى الفُؤادِ هَواهُما",53,"م",2,1],["إنّي عنيتُ نحو ذا واحداً","من قولهِ في أذني أعلقُ",54,"ق",1,0],["إِنّي عَلى خُلفِ المَواعِدِ مِنكُمُ","صابٍ إِلَيكِ وَلَستُ بِالمُتَصابي",55,"ي",1,0],["إِن يُعطَها وَهُوَ رَضوى في زُجاجَتِه","يَعدُم رَشاداً فَلا يَحلُم وَلا يَقِرِ",56,"ر",1,0],["إني عييت كما ترى بحضورها","يا دمع إنك أفصح فتكلم",57,"م",1,0],["أن يعش يلق منكراً وإذا ما","ت تلقاه منكر ونكير",58,"ر",1,0],["إني عليك لأَسهَر","إلى الصباح فَنامي",59,"ي",1,0],["إِنّي على كل حال","كما تكون أَكون",60,"ن",1,0],["إني على الرغم مني ساكن بلداً","ما إن بها من أَنيسٍ لي سوى كتبي",61,"ب",2,0],["إِن يَعجَبِ الأَقوامُ أَنّي عِندَكُم","مِن دونِ ذي رَحِمٍ بِها مُتَوَصِّلِ",62,"ل",1,0],["إنِّي عبدتُك في جَنى شفةٍ","ويدٍ ووجه مشرق الوضحِ",63,"ح",1,0],["إِن يَعِش بائِساً وَلَم يَطوِهِ البُؤ","سُ يَعِش نَكبَةً عَلى الأَجيالِ",64,"ل",1,0],["إِنِّي عَلَى عَهْدي وَمَا كُنْتُ فِي","مُهِمَّةٍ مُخْلَفَ مِيعَادي",65,"د",2,0],["إِنْ يَعْتَرِ الشَّمْسَ الكُسُوفَ هُنَيْهَةً","أَيَكُون مَنْقَصَةً لَهَا أَنْ تُكْسَفا",66,"ف",2,0],["إِنْ يُعَظَّمْ شأْن الحَواضِرِ إِجْحَافاً","فمَا الشَّأْنُ فِي الضيَاعِ صَغِيرُ",67,"ر",1,0],["إِن يَعْتَزِمْ يَقْدَمْ كَمَا تَهْوَى الْعُلاَ","إِقْدَامَ لاَ حَذِرٍ وَلاَ مُتَرَدِّد",68,"د",1,0],["أَنَّى عَلى طِيبِ الزَّمَانِ وَخُبْثِهِ","مِمَّنْ يُعَمِّرُ وِدَّهُ مَا عمَّرَا",69,"ر",2,0],["إِنِّي عَلَى الْعَهْدِ بَاقٍ","إِنْ جِدْتِ أَوْ لاَ بِقُرْبِ",70,"ب",1,0],["إني عزمت عليك أنك نازل","عندي وإلا ساءني حرماني",71,"ن",2,0],["إنِّي عَلَى مَا كانَ مِ","نْكَ لَوَاثِقٌ بجبيلِ رأْيكْ",72,"ك",1,0],["أنْ يَعتري وقْعَها من رَبكةٍ زَللٌ","أو أن يثبِّط من إقدامها الحَذَر",73,"ر",1,0],["إني على الرّغْمِ مما قد نُكِبْتُ به","فقد يحزّ فؤادي لفظُ منكوب",74,"ب",1,0],["إنْ يعصِرِ المتحكِّمونَ دماءَهم","أو يغتدوا صُفْرَ الوجوه شواحبا",75,"ب",2,0],["إنّي عبدت الله ، لا نيرانه","سرّ التقى عندي ولا جنّاته",76,"ت",2,0],["إِنْ يَعْجُبِ الأَقْوامُ أَني عِندُكمْ","والمَاءُ دُونَ ذِي رَحِمٍ بها مُتَوَسلِ",77,"ل",1,0],["إِني عَرَفتُ بِهِ فَالشامُ تَحسِدُني","وَكُلُ ذي نِعمة في الناس مَحسودُ",78,"د",1,0],["أَني عَرَفتُ بِهِ كَما عرفت يَدا","قاضي قُضاة الشام بِالمَعروف",79,"ف",1,0],["ان يعادى فصدمة الدهر بأسا","او يوالي فصالحات الزمان",80,"ن",1,0],["اني على الحالين صب صابر","مهما دجا ليل المهمة ينجلي",81,"ل",2,0],["اني عبيدك صل حبلي بمرحمة","تجلى ومنها فوأد الخصم ينفطر",82,"ر",1,0],["إني على العهد القديم بحبها","باقٍ وإن لام العذول الخالي",83,"ي",1,0],["إني عبيد إله الخلق أجمعهِِ","وهو الوسيلة لي والحبل ذو الجدلِ",84,"ل",1,0],["إني على ضحك المشيب بمفرقي","وتضاحك السنوات مني أضحك",85,"ك",1,0],["إنِّي علقتُ بحبلٍ لا انفصامَ لهُ","مِنْ حُبِّكم وَودادِ غير مُنْصَرِمِ",86,"م",1,0],["إني عهدتُ بذى الدور خريدةً","بيضاءَ مِلءَ خلاخلٍ وسِوَارِ",87,"ر",1,0],["أني عَلَى هَيَمَى مَىٍِّ تَلُحَّاني","وقَد شَجَاني قُمرِىٌّ بألحان",88,"ن",1,1],["إن يعتري فيهَا لَمُرتَبَعاً","طَيِّباً مَلذوذَ آنَاءِ",89,"ا",2,0],["إن يعَهدوا العزَّ في الأطنابِ آونةً","فذا أوانُ حُلول الذلّ في الحُلَلِ",90,"ل",1,0],["إِنّي عَقَلتُ رَكائِبي وَوَسائِلي","في حَضرَةٍ مَسكونَةِ الأَفناءِ",91,"ا",2,0],["إِن يُعقِبِ الحَزنُ حُزناً بَعدَ جيرَتِهِ","فَقَد نَعِمنا بِهِم دَهراً بِنَعمانا",92,"ن",2,0],["إني عقدت أذمتي بولائكم","وجعلت ركن جلالكم لركوني",93,"ن",2,0],["إِنّي عَلى حادِثاتِ الدَهرِ ذُو جَلَدٍ","تَجلُو الحَوادِثُ مِنّي صارِماً خَذِما",94,"م",2,0],["إِني عَلى عَهديَ الماضي أَليفُ هَوىً","وَإِن مَضى عَهدُ أُنسي في لَياليها",95,"ي",3,0],["إن يعد فليسَ يفي","والهوى لهُ أدبُ",96,"ب",1,0],["إن يعجبوا من غرامي فيك قل لهمُ","إني عرفتك في يوم الثلاثاء",97,"ا",2,0],["إني على الكتمان","يا فاتني قادر",98,"ر",1,0],["إني على رغمي وُجد","ت ولست أنعم بالإقامه",99,"م",2,0],["إِن يُعَدَّ الشُيوخُ منكَ وَمِنّا","فَفتى مصرَ لِلجَميع لِواء",100,"ا",2,0],["إِنّي عَلى رَغمِ الوشاةِ لَقائِلٌ","سَقى الجارَتينِ العارِضُ المتهَلِّلُ",101,"ل",1,1],["إِن يعلُني غَيرُ ذي فَضل فَلا عَجَبٌ","يَسمو عَلى سابِقاتِ الخَيلِ هابيها",102,"ي",3,0],["أَن يُعطى مِن بِشارَه","ما يُعطى البَشير",103,"ر",1,0],["إني عَهدتُكَ بالعِدى مترفّقاً","أو لستَ ترفَقُ بي وأنتَ صديقُ",104,"ق",1,0],["إني عرفتُكِ فهو قولُ مجرِّبٍ","لا تُنكري ما يدفع النكرانا",105,"ن",2,0],["إني عَهدتُكِ ذات قَلبٍ شاعرٍ","خَفَقاتُهُ كقَصائدِ الشعراء",106,"ا",2,0],["إني على الصّدقِ مذمومٌ ومتَّهَمٌ","والشرُّ يُحمَدُ حَيثُ الخيرُ لم يُفِد",107,"د",1,0],["إِنّي عَلى نارِ الغَضى بِفِراقِهِ","لا النارُ عَنها صينَ إِبراهيمُ",108,"م",1,0],["إِنّي عَشَوتُ لِنارِ موسى قابِساً","وَلَتِلكَ نارٌ مِثلُها لَم يُقبَسِ",109,"س",1,0],["إن يَعُد عاذِلٌ إِلى العَذلِ فيهِ","لَم أَدَع عَركَ أُذنِهِ بِالمِلحِ",110,"ح",1,0],["إني على العهد باق","يا منية المتمني",111,"ي",1,0],["إِني عييتُ بأَمره","ولقيتُ مؤتلفاً وضدَّا",112,"د",2,0],["إني على رغم الأسى","الجبار صخر لا ألين",113,"ن",1,0],["إنّي على وُدٍّ يَزِيدُكَ صِحَّةً","من دُونِه أَلَمُ العِتابِ المُمْرِضِ",114,"ض",1,0],["اِني عَلى ما يَرتَضيه صابِر","ما لَم يَجرّعني مَرارَة فَقدِه",115,"د",2,0],["إني علقت بمحيي الدين معتضدا","فعاد يفتح دهري وهو إحسان",116,"ن",1,1],["إني على شرف القريض لهاجر","للنظم هجرة آنفٍ متنزِّهِ",117,"ه",1,0],["إني على الحال العَلي","لَةِ صاحبُ الودِّ الصحيحِ",118,"ح",1,0],["إني على الحالين معْهم موجعٌ","راشوا سهامَ كَلامهم لكِلامي",119,"ي",1,0],["إني عنِ استيفاءِ مدحِك قاصرٌ","لا تُلزميني في الثناء الواجبا",120,"ب",2,0],["إني على عهد الوفا","يطربني ما أطربك",121,"ك",1,0],["إنّي على ما بي من قُوَّةٍ","عِندَ الخُطوبِ الصَّعبةِ الوافِيَهْ",122,"ه",1,1],["إِن يُعظِمُ البين قَلبي من تَعذُّبهِ","فَلِلصَّبابَةِ ثدي راح يُرضعُهُ",123,"ع",2,0],["إنّي علِقتُ من اصطبا","ري عنكَ أسباباً رثَائِثْ",124,"ث",1,0],["إنِّي عَقَدْتُ بذيلِ فضلك همَّةً","إنْ حلَّتِ الأَيَّام عَقدَ ذمامي",125,"ي",1,0],["اني على عهد الوداد محافظ","وإن وخدت بالبين عيس طلايح",126,"ح",1,0],["إني على سفرٍ وإن أرحلْ فلي","قلبٌ مَشوقٌ عنك لا يتأخّرُ",127,"ر",1,0],["إن يعدّ وافخراً فيوماه في الأي","ام يوما جود ويوم جهاد",128,"د",1,0],["إني عجبت وجودكم عم الورى","كيف اغتدى في حالي الإعدام",129,"م",1,0],["إني عرفتهم تاللَه معرفةً","غيوبها حضرت عندي ولم تغب",130,"ب",1,0],["إني على الحب قد نشئت لا عوض","عنه لروحي أو سر لإحيائي",131,"ي",1,0],["إني عجمتُ بالحسين زمني","فلم يُثَلَّمْ وهو صُلْبٌ ضِرسي",132,"س",2,0],["إِنّي عَلى ما قَد تَرَونَ مُحَسَّدٌ","أنمي عَلى البَغضاءِ والشَنآنِ",133,"ن",1,0],["إني على العهد القديم في الهوى","وكم نفوس الغرام اغتالها",134,"ل",3,0],["إنِّي على العَهْدِ القَديمِ ولو عَلَتْ","نارُ المَنِيَّةِ تحتَ أَذْيالِ المُنى",135,"ن",2,0],["إنِّي عَليلٌ عارَكَتْني لوعَةٌ","لكِ يا ظُبَيَّةُ واكْتَوى القلبَ السَّقَمْ",136,"م",1,0],["إنِّي على عَهدي وَثيقُ هِمَّةٍ","أجلْ ومثلي في الرِجالِ الواثِقُ",137,"ق",1,0],["إنِّي على دينِ هَواكُمْ ثابِتٌ","شِبْتُ ووجدي في الهَوَى مُراهِقُ",137,"ق",1,0],["إنِّي على العَهْدِ القديمِ وحُبُّهُمْ","ديني وكَعْبَةُ مُهْجَتي ومَناري",138,"ي",1,0],["إنِّي عجبتُ من هوى مُهْجتي","مِنْ صبْرهِ في مِحْنتي الأثقلِ",139,"ل",1,0],["إن يَعبُقِ النّادي بحُسنِ حديثِه","فلِطيبِ ما تَرويهِ لُسْنُ رُواتِهِ",140,"ت",2,0],["إني على إسماعيل لا أعطى عزى","بل قد عدمت تجلدي وعزائي",141,"ي",1,0],["إني على الفحش ناء","متقشف متبرم",142,"م",1,0],["إني على حذر الوشاة وخيفتي","عين الرقيب وصولة الغيران",143,"ن",1,0],["إنَّيَ عَضْبٌ باتِرٌ","فاِستلّني في كلِّ هَمْ",144,"م",1,0],["إنّي عليك لما ذهبتَ لموجَعٌ","وإليك لمّا غبتَ بالأشواقِ",145,"ق",1,0],["إنّي علقتُ بفخر الملكِ في زمنٍ","ما كان لِي منه في الأقوامِ مُعتَلِقُ",146,"ق",1,0],["إِنّي عَلى هَجرِكُم لَمُنتَظِرٌ","رَجائِيَ الوَصلَ آخِرَ الأَبَدِ",147,"د",1,0],["إني على العهد مقيم لها","وإنني عنها كصوب العهاد",148,"د",1,0],["إنِّي على جودِكَ الطَّامي اتكَّلتُ وهل","يخيبُ عبدٌ على ألطافِكَ اتَّكَلا",149,"ل",2,0],["إنّي عَقَدتُ لهُ عَهداً أَقومُ بهِ","في القُربِ والبُعدِ بينَ الحَرْبِ والحَرَبِ",150,"ب",1,0],["إنّي على العَهدِ القديمِ فلم تَحُلْ","تلكَ العُهودُ على حُؤُولِ مَعَاهِد",151,"د",1,0],["إني على الحالَينِ لا أنساكَ في","عُمري ولو أوشكْتُ أنسى مَن أنا",152,"ن",2,0],["إِني على ما كنتُ شُغلي بالهوى","لم يَشْتَغِلْ وبَطالتي لم تَبْطُل",153,"ل",1,0],["إِن يَعد رأيُه الجميلُ يَعُدْ لي","كلُّ ما أَشتهي وما أَخْتَارُه",154,"ر",2,0],["إني عليه حربه","ملهوفة مستلبه",155,"ب",2,0]]}