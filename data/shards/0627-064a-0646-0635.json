{"poems":[[87,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[107,"أما ومضارب البيض الرقاق","https://www.aldiwan.net/poem43994.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[108,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[230,"أين صبري من يذكر اليوم صبري","https://www.aldiwan.net/poem55121.html","الخفيف"],[259,"رددي بعدي وجيبي","https://www.aldiwan.net/poem24956.html","مجزوء الرمل"],[333,"واقع أروع من نسج الخيال","https://www.aldiwan.net/poem55008.html","الرمل"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93124","الرمل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35759","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49584","المتقارب"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202152","المجتث"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108462","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53133","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53061","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87764","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100884","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100770","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97080","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81275","المتقارب"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135110","الخفيف"],[5090,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=184309",""],[5213,"هل تبلغ العيس بى الدارا","https://www.poetsgate.com/ViewPoem.aspx?id=170460",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5431,"الكولا وعنترة العبسي!","https://www.poetsgate.com/ViewPoem.aspx?id=215610",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[5687,"حريق الماء","https://www.poetsgate.com/ViewPoem.aspx?id=208075",""],[5720,"عُدْ","https://www.poetsgate.com/ViewPoem.aspx?id=204381",""]],"verses":[["أَينَ صَوتٌ كَأَنَّهُ رَنَّةُ البُلبُ","لِ في الناعِمِ الوَريفِ الظَليلِ",0,"ل",1,0],["أَيُنْصَرُ كلُّ لصٍ من جُذَامٍ","وَيُقْهَرُ رافعُ السَّبعِ الطِّباقِ",1,"ق",1,0],["أَيُنْصِتُ لي الضيفُ العظيمُ هنيهةً","ويسمع لي الفاروقُ صوتَ جناني",2,"ن",2,0],["أينَ صُنعُ الطِّبِّ من صنع الذي","بَرَأَ الأنفس: لحمًا، وعظاما؟",3,"م",2,0],["أينصب شيخ للفتاوي منكم","كما الشيخ منكم للتصوف ينصب",4,"ب",1,0],["أَينَ صَبري من يَذكُر اليومَ صَبري","بَعدَ أَعوامِ عُزلَةٍ وَشهورِ",5,"ر",1,1],["أيَّ نُصْحٍ، أو دواءٍ","أَفَلا يخشى حبيبي",6,"ب",2,0],["أين صرحُ المجد قد شيّدتَه","فوق أشلاءِ الضحايا والرمال",7,"ل",1,0],["أَيَنصُرُني عَدُوّي في هَواهُم","عَلى حَربي أَباهُ وَهوَ دَهري",8,"ر",2,0],["أين صهر المصطفى خير الورى","ينظر السبط عفيراً في الثري",9,"ي",1,0],["أَيَنصَرِمُ الزَمانُ وَلَم تَعودي","إِلى دُنياكِ أَيَّتُها البِقاعُ",10,"ع",1,0],["أيُنْصِفُ منكَ وأنت الحياةُ","وَيُعْدِي عليكَ وأنت الأَجَل",11,"ل",1,0],["أين صلاح الدين","يا قوم كي يحميني",12,"ي",1,0],["أين صبري على صروف الليالي","ومتى يا زمان ترثي لحالي",13,"ل",2,1],["أين صيد من آل جفنة كان الت","اج يُزْهَى بملكهم والسرير",14,"ر",1,0],["أين صِيدٌ من آل جفنةَ بادوا","بعد بث الجيوش والغارات",15,"ت",1,0],["أَينصب لِلهَوى شبك احتيال","وَمَن يَصطاد بِالشبك الهَواءا",16,"ا",3,0],["أَيّ نَصل أَغمدت فيهِ المَنون","عَن نزالٍ وصيال",17,"ل",1,0],["أينَ صوتى دوى وأين ييانى","سارَ فى ذلك الوجود الفانى",18,"ن",2,1],["أي نصف ترجون من حاكم يح","سب هذي الرقاب كالأنعام",19,"م",1,0],["أينصاعون منحازين","عن أبراج معقلهم",20,"م",1,0],["أينصب فينا شاهد غير حاضر","ويحكم بنيان جليل بلا أس",21,"س",1,0],["أَينَ صَوت سامهُ المَوت البَلى","وَيَراع بَينَ كَفيك عَثر",22,"ر",1,0],["أين صفو الزجاج وقت ابتهاج","عند صفو الشموع وقت المدامة",23,"م",2,0],["أين صنعاء من حوت","كلَ عشقٍ وكل فنْ",24,"ن",1,0],["اين صبا الأربع نفاحة","بالمندلي الرطب أسحارا",25,"ر",2,0],["أينصره من كان بالله مشرا","ومن كان زنديقاً تجاهل واستجرا",26,"ر",2,0],["أينصرك المولى إذا النفس سُعّرت","بكلّ اشتهاءات الجحيم تُفوّرُ!!؟",27,"ر",1,0],["أين صَوتي الذي يطاردُ صَوتي","وبَياني وعالمي المشهودُ؟",28,"د",1,0],["أين صار الحريق .. أين أجبني ؟","يا صديقي في الماء صار الحريق..!",29,"ق",1,0],["أَيْنَ صُبْحٌ لَاذَ عَنَّا هَارِبَاً ؟","وَانْزَوَىٰ خَلْفَ الدَّيَاجِيْ وَالْحَلَكْ",30,"ك",1,0]]}