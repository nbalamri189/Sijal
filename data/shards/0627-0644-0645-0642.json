{"poems":[[55,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[93,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[47,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[79,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[113,"فخرا دمشق على كل البلاد بمن","https://www.aldiwan.net/poem16232.html","البسيط"],[136,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[164,"من بات مثلي للنجوم نزيلا","https://www.aldiwan.net/poem59095.html","الكامل"],[186,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[308,"المقلة الكحلاء أجفانها","https://www.aldiwan.net/poem58007.html","البسيط"],[408,"أو أنه كان يرضي الموت فيك فدى","https://www.aldiwan.net/poem46439.html","البسيط"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[438,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[466,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122690","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122595","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122740","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48847","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48736","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63810","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119863","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119990","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112846","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50016","الكامل"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1900","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48960","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108814","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101913","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48196","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48242","الكامل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139919","البسيط"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106775","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85272","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90921","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91007","الكامل"],[4798,"وطن الجنى","https://www.poetsgate.com/ViewPoem.aspx?id=20227",""],[5064,"أيُّها الظّالم","https://www.poetsgate.com/ViewPoem.aspx?id=199101",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5739,"يشربه سمعي","https://www.poetsgate.com/ViewPoem.aspx?id=152740",""],[402,"أشرق وحولك ولدك الأبرار","https://www.poetsgate.com/ViewPoem.aspx?id=35553",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5993,"ليل العذاب","https://www.poetsgate.com/ViewPoem.aspx?id=186538",""],[6115,"الظفر في طاعة الله وبرّك والديك","https://www.poetsgate.com/ViewPoem.aspx?id=187918",""]],"verses":[["المُقدِمينَ فَلا ميلٌ وَلا عُزُلٌ","وَالحامِلونَ فَلا جَورٌ وَلا ضَعَفُ",0,"ف",1,0],["المُقبِلُ الصَدرِ وَالأَبطالُ ناكِصَةٌ","تَحتَ العَجاجَةِ لا يَبدو لَها قُبُلُ",1,"ل",1,0],["المُقتَني المملوكُ ملعبُه","وغيرُ المقتَنَى!",2,"ن",2,0],["المُقعِصونَ زُهَيراً عَن غَنِيِّهِمِ","وَقَد سَقاها كُؤوسَ المَوتِ في شاسِ",3,"س",1,0],["المقامات لعبةٌ... والحريري","حشيشٌ.. والغول والعنقاء",4,"ا",2,0],["أَلمُقْتفِي بِالسيْرِ أَعْدَلَ مَنْهَجٍ","نَهَجَتْهُ أَسْلاَف لَهُ أَخْبَارُ",5,"ر",1,0],["المقدار منك مراده","وشاقه منك القرب لا استوجب الردا",6,"د",2,0],["المَقريّ الَّذي في بَعض أَيسر ما","حَوى مِن الفَضل كُل راح حَيرانا",7,"ن",2,0],["المُقتفي نَهجَ طهَ في فِعَائِلِهِ","مَن لَم يَكُن عَامِلاً إِلاَّ بِمَا عَلِمَه",8,"م",2,0],["المقدمون أسنة وأعنة","والمرهبون مخايلا وخيولا",9,"ل",2,0],["المقدِّمُ الخَيل باسم اللَه يَجريها","إِلى العِدى بِالعَذابِ الهَون يُرديها",10,"ي",3,0],["المُقدِمَ الرَحبَ الذِرا","عِ في المَجالِ الضَيِّقِ",11,"ق",1,0],["المقلة الكحلاء أجفانها","ترشق في وسط فؤادي النبال",12,"ل",1,1],["المقْدمونَ وأسْدُ الغابِ خَاضعةٌ","والباذلو الجود والأنواء لم تَجُدِ",13,"د",1,0],["المقتني الحمد الطويل ذكره","والحمد للإنسان أسنى مقتنى",14,"ا",1,0],["المقتفون على عليم سبيلَ عُلاً","والى بها أوّلوهُم جمْع آلاءِ",15,"ا",2,0],["ألمُقْتفي أمر الإلهِ ومنْ لهُ","شَرفُ المساعي والمَقامُ الأعْظَمُ",16,"م",1,0],["المُقدِمُونَ وَخُرصانُ القَنا قُصُدٌ","في الدّارِعينَ وَهاماتُ العِدَى فَلَقُ",17,"ق",1,0],["المقدِمين إذا الأسنةُ أمطرت","ودَحَى الكَميُّ عَلَى مَقرِّ نِجاده",18,"د",2,0],["المُقدِمُونَ وللمَنيَّةٍ وابِلٌ","يَهمي فَيَفعَلُ فيهِ فِعلَ الوابِلِ",19,"ل",1,0],["المقبلون لحر رأيك أقبلوا","يتناوبون الحمد والتبجيلا",20,"ل",2,0],["المقبلين وقد جاءت بشائرهم","على مصير لوادي النيل منشود",21,"د",1,0],["آلمَ قلبي صاعدٌ وما شَعَرْ","دَبّتْ إليه عقربٌ وقتَ السَّحَر",22,"ر",1,1],["المقتني للحادثات قواضيا","في الروع مفطرة وخيلا صوما",23,"م",2,0],["المقمر الرأي في خطوب","مظلمة كالدجى عواتِم",24,"م",1,0],["ألمقبلون على الأخرى بتركهم","دار الفنا فمتروك ومقبول",25,"ل",1,0],["المقتفين جنابه بعزائم","قدسية موصولة بصلاته",26,"ت",2,0],["المقتدي النَّقبا وراءَ المعتدَى","والسّايل الجدوى أمام السّائلِ",27,"ل",1,0],["المُقبِلينَ نُحورَ خَيلِهِمُ","حَدَّ الرِماحِ وَغَبيَةَ النَبلِ",28,"ل",1,0],["المقتفي سبلَ الهُدى","يجتازها غوراً ونجدا",29,"د",2,0],["المقتني سمرَ القنا للقالي","والمجتني ثمَر الغنى لمُوال",30,"ل",1,0],["المقتني غرر الثنا","والمرتقي فوق الأثير",31,"ر",1,0],["المقدمين اذا ما خيلهم وردت","والعاطفين اذا ما ضُيِّع الدَّبر",32,"ر",1,0],["المقتدِى بعليِّ في يومِ الوغَى","والمهتدِى بهُدى أبىِ الزهراءِ",33,"ا",2,0],["المُقْتَدَى بهداه وهو بشِرْعَةِ ال","هادي وآثارِ الأفاضلِ يقتدي",34,"د",2,0],["المُقدِمونَ إِذا الكَتائِبُ أَحجَمَت","وَالعاطِفونَ إِذا اِستَضافَ المُجحَرُ",35,"ر",1,0],["المقت يوجبه اكل بواحدة","من الاصابع فاحذر موجب النقم",36,"م",1,0],["المقسط العادل في أحكامه","منتقم بالعدل في انتقامه",37,"ه",1,0],["المقرىءُ الفاضلُ القاضي بسبتة قد","ذكرته عند ذكر الإذن في سطرِ",38,"ر",1,0],["المقرِيُّ على مَقَامِكَ وَافِداً","وَمُؤَمِّلاً مَا عزَّ مِن أوطَارِ",39,"ر",1,0],["ألم قدر أن المقرنين شيعتي","ولي عهد ود بالإمام قديم",40,"م",1,0],["المقفلون لباب كلّ دنيّة","والفاتحون لكلّ مجدٍ مقفل",41,"ل",1,0],["المقتفي أثر الجدود رعاية","ودراية وتكرما وتوردا",42,"د",2,0],["المقتفي أثر الجدود وحبذا","فرع نمته أصوله الوزراء",43,"ا",2,0],["المقبلاتِ إذا الكريهةُ أقبلت","الرواياتِ الشعرَ أنك من هنا",44,"ن",2,0],["ألَمُ قَدْ كُنْتَ مِنْ أسبَابِه","سَوْفَ يأتِي ضِعْفُ ضِعْفَيْهِ إِلَيكْ",45,"ك",1,0],["الْمُقْتَفِي المُزَّمّلِ المُدَّثّرِ الطُّ-","-هْرِ الرَّسولِ الشَّاهِدِ الْمَشْهودِ(٨)",46,"د",1,0],["المقدسيّونَ هم أشرافُ رايتنا","ورايةُ الله إذ تعلو على العُصُرِ",47,"ر",1,0],["المقام اللي غلاته ...... لي وسام.","من ثلاث اسنين .... قلبي يحتريه.",48,"ي",2,1],["ألمقتفي باليسير أعدل منهج","نهجته أسلاف له أخيار",49,"ر",1,0],["المقطع المجنون..كم رددته","وشربته..ونطقته بروية",50,"ي",2,0],["المقفي والله انا مانحسب له حساب","دام ماحسب لدق الامور وجلها",51,"ل",3,0],["المقدّر حقّ وأن كان ماجيته يجيك","بأمر ربٍ الكون ذا يحيي العظم الرميم",52,"م",1,0]]}