{"poems":[[55,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[93,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[47,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[79,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[112,"فخرا دمشق على كل البلاد بمن","https://www.aldiwan.net/poem16232.html","البسيط"],[135,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[163,"من بات مثلي للنجوم نزيلا","https://www.aldiwan.net/poem59095.html","الكامل"],[185,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[238,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[306,"المقلة الكحلاء أجفانها","https://www.aldiwan.net/poem58007.html","البسيط"],[405,"أو أنه كان يرضي الموت فيك فدى","https://www.aldiwan.net/poem46439.html","البسيط"],[419,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[435,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[463,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[708,"","https://poetry.dctabudhabi.ae/diwan/poem/1900","الكامل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"]],"verses":[["المُقدِمينَ فَلا ميلٌ وَلا عُزُلٌ","وَالحامِلونَ فَلا جَورٌ وَلا ضَعَفُ",0,"ف",1,0],["المُقبِلُ الصَدرِ وَالأَبطالُ ناكِصَةٌ","تَحتَ العَجاجَةِ لا يَبدو لَها قُبُلُ",1,"ل",1,0],["المُقتَني المملوكُ ملعبُه","وغيرُ المقتَنَى!",2,"ن",2,0],["المُقعِصونَ زُهَيراً عَن غَنِيِّهِمِ","وَقَد سَقاها كُؤوسَ المَوتِ في شاسِ",3,"س",1,0],["المقامات لعبةٌ... والحريري","حشيشٌ.. والغول والعنقاء",4,"ا",2,0],["أَلمُقْتفِي بِالسيْرِ أَعْدَلَ مَنْهَجٍ","نَهَجَتْهُ أَسْلاَف لَهُ أَخْبَارُ",5,"ر",1,0],["المقدار منك مراده","وشاقه منك القرب لا استوجب الردا",6,"د",2,0],["المَقريّ الَّذي في بَعض أَيسر ما","حَوى مِن الفَضل كُل راح حَيرانا",7,"ن",2,0],["المُقتفي نَهجَ طهَ في فِعَائِلِهِ","مَن لَم يَكُن عَامِلاً إِلاَّ بِمَا عَلِمَه",8,"م",2,0],["المقدمون أسنة وأعنة","والمرهبون مخايلا وخيولا",9,"ل",2,0],["المقدِّمُ الخَيل باسم اللَه يَجريها","إِلى العِدى بِالعَذابِ الهَون يُرديها",10,"ي",3,0],["المُقدِمَ الرَحبَ الذِرا","عِ في المَجالِ الضَيِّقِ",11,"ق",1,0],["المقلة الكحلاء أجفانها","ترشق في وسط فؤادي النبال",12,"ل",1,1],["المقْدمونَ وأسْدُ الغابِ خَاضعةٌ","والباذلو الجود والأنواء لم تَجُدِ",13,"د",1,0],["المقتني الحمد الطويل ذكره","والحمد للإنسان أسنى مقتنى",14,"ا",1,0],["المقتفون على عليم سبيلَ عُلاً","والى بها أوّلوهُم جمْع آلاءِ",15,"ا",2,0],["ألمُقْتفي أمر الإلهِ ومنْ لهُ","شَرفُ المساعي والمَقامُ الأعْظَمُ",16,"م",1,0],["المُقبِلينَ نُحورَ خَيلِهِمُ","حَدَّ الرِماحِ وَغَبيَةَ النَبلِ",17,"ل",1,0],["المُقدِمونَ إِذا الكَتائِبُ أَحجَمَت","وَالعاطِفونَ إِذا اِستَضافَ المُجحَرُ",18,"ر",1,0]]}