{"poems":[[75,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[53,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[47,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[47,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[30,"أنا ابن ضبة فرع غير مؤتشب","https://www.aldiwan.net/poem1257.html",""],[48,"أيا جسدي لا تجزعن من البلى","https://www.aldiwan.net/poem22224.html","الطويل"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[47,"أَمَا كَانَ في تَلْكَ الدُّموعِ السَّوائلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32192",""],[47,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[53,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""],[189,"سيان ستر غرامي فيك والعدم","https://www.aldiwan.net/poem14662.html","البسيط"],[190,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[463,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[534,"من أكثر المزح دعا كل من","https://www.aldiwan.net/poem37354.html","السريع"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77610","الرجز"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99972","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16854","الرجز"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31582","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46555","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46551","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123046","البسيط"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98590","الرجز"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58437","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121617","الدوبيت"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129384","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216465","الكامل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141553","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131270",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35603","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101366","الرجز"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130549","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83192","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83186","الرجز"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4929,"عروبة الزمن الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=215675",""],[5277,"ضجر","https://www.poetsgate.com/ViewPoem.aspx?id=205828",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5616,"يمن","https://www.poetsgate.com/ViewPoem.aspx?id=203463",""],[5956,"مِن أكثر الناس الألى غشوا الملا","https://www.poetsgate.com/ViewPoem.aspx?id=193526",""],[5956,"نُواح الكون على محمد عبده يماني","https://www.poetsgate.com/ViewPoem.aspx?id=194549",""],[5956,"ذكرى حبي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=196838",""],[5956,"من أين تأتي الطيبة العصماءُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=206925",""]],"verses":[["مَناكيدُ فِعلِ الخَيرِ مِنهُم تَكَلُّفٌ","إِذِ الشَرُّ طَبعٌ ما لَهُم عَنهُ ناقِلُ",0,"ل",1,0],["من أكفٍّ بيضٍ غدتْ وهي مشفو","عٌ لدينا بجودها ممتوتُ",1,"ت",1,0],["مَنَاكَ لَهُ مِقْدَارُهُ فكأنَّمَا","تَقَوَّضَ ثَهْلاَنٌ عليه وَصِنْدَدُ",2,"د",1,0],["مناكِيدُ تأبَى أن تجودَ لِقاحُهم","بِدَرِّ بَكِيٍّ أو تُشَدّ عِصابَا",3,"ب",2,0],["مُناكِبٌ لِدَنيآتِ الأُمورِ تُقىً","يَزوَرُّ عَن جانِبِ الفَحشاءِ جانِبُهُ",4,"ب",2,0],["مُناكِدٌ قَد كانَ مِن لُؤمِهِ","يَحمي عَلى الناسِ بِلالَ الحُلوق",5,"ق",1,0],["مَناكِحُ في حَيٍّ فَحَيٍّ تَراهُم","يَسيرونَها بِاللُؤمِ سَيرَ المَراحِلِ",6,"ل",1,0],["مِنّا كَتائِبُ مِثلُ اللَيلِ نَجنِبُها","بِالجُردِ وَالبارِقاتِ البيضِ وَاليَلَبِ",7,"ب",1,0],["مَناكِبَ ساعاتي رُكِبَت فَأَبتَغي","لَباثاً وَسَيرُ الدَهرِ لا يَتَلَبَّثُ",8,"ث",1,0],["من اكتسى بِكَ عَارٍ؛ لاَ كِسَاء لهُ","يكسوهُ إلا الرِّياحُ الهُوجُ، والسحبُ",9,"ب",1,0],["مَنَاكِحُ فِي حَيٍّ فَخَيٍّ ، تَرَاهمُ","يَسِيرونَهَا باللُّؤْمِ سيْرَ المَرَاحِلِ",10,"ل",1,0],["مُناكِبٌ لِدَنِيئَاتِ الأمورِ تُقىً،","يَزْوَرُّ عَنْ جانِبِ الفحْشاءِ جانِبُهُ",11,"ب",2,0],["من أكلِ الناسِ لخبزٍ بَحْتِ","يلُتّهُ بالريق أيَّ لتِ",12,"ت",1,0],["من أكرمَ الناسَ إكراما مَنَتْ به","فشكرُه مثلُ شكرٍ نِلْتَه لَزِم",13,"م",1,0],["من أكل ما لاح بغير مكس","من جورنج قد قلي ومحشي",14,"ي",1,0],["من أكلةٍ قد تاه آدمُ جدُّه","لكنه قد تاب عما قد أكل",15,"ل",1,0],["مُناكَ من زينةِ الدّنيا لَقُلْتُ هُمُ","راعُوا فُؤادي بالهِجرانِ حينَ أمِنْ",16,"ن",1,0],["منَّاك ظنُّك بي غروراً أنني","أصحو وفي الظنّ المحالُ المطَّرَحْ",17,"ح",1,0],["مَنْ أكْثَرَ الْمَزْحَ دَعا كُلَّ مَنْ","يَعْرِفُهُ يَوْماً إلى نَقْصِهِ",18,"ه",1,1],["مَنِ اِكتَرى جَمَلاً أَيضاً إِلى بَلَدٍ","إِذا بِهِ اللِصُّ وَالمَتاعَ قَد ظَفَرا",19,"ر",2,0],["مَن اِكتَفى بِرزقه يَرتاح","وَرُبَما زادَت لَهُ الأَرباح",20,"ح",1,0],["مِنَ أكْلُبِ خُوِزَسَتانَ نَغْلٌ مُحَقَّرٌ","ضَئِيلٌ خَفِيٌ الشَّخْصِ فِي صُورَةِ الدَّرْص",21,"ص",1,0],["مَن أَكثَرَ الغِشيانَ خَسَّ قَدرُهُ","لَو كُثِرَ الياقوتُ هانَ أَمرُهُ",22,"ر",2,0],["مُناكِرٌ لِطِباعِيَ غَيْرَ أَنَّ لَهُ","عُقْبى تُمازِجُ مَحْموداتُها الجَسَدا",23,"د",2,0],["مَن أَكرَم الضيف كرم","مَن ضَيع الجار لؤم",24,"م",1,0],["مَن أَكثر المَدح سخف","مَن أكثَر الحلم ضعف",24,"ف",1,0],["مَن أَكثر الدعوى اِفتضح","مَن لزم الحمية صح",24,"ح",1,0],["من أَكثر المَزح حقر","مَن صافح الليث عقر",24,"ر",1,0],["مَن أَكرَم الإِخوانا","كانوا لَهُ أَعوانا",25,"ن",2,0],["مناكبَ من جسمِ النبوَّة حمِّلت","إمامة حقٍّ فضلها ليس يحسب",26,"ب",1,0],["مَن أكثر المدح في الناس استُخفّ به","وليس يسلم من آفات حقدهم",27,"م",1,0],["من أكل ما لاح بغير مكس","من جورنج قد قلي ومحسي",28,"س",2,0],["من أكبر الطغاة والعتاة","وأخبث الروافض الغلاةِ",29,"ه",1,0],["من أكسبته العلى أيدي مواهبه","وساد في الناس بالكسبي والوهبي",30,"ب",2,0],["مَن أكَلَ الفِجْلَ تجشّى بعدما","يأكُلُه بِساعة مثلَ",31,"ل",1,0],["مِن أكْرَم مُرْسَل عظيم جَلاَّ","لم تَدْنُ ذُبابةٌ إذا ما حَلاَّ",32,"ل",2,1],["مناكب لا تهتز إلا لسؤدد","وكم منكب بالؤم قد هزّه الغدر",33,"ر",1,0],["من أكسفورد، ولو نماه معشر","للأزهر المعمور لم تستبعد",34,"د",1,0],["من أكبر النعماء مع زوجة","يرضى بها وهي به راضيه",35,"ي",2,0],["مناكير في الخطب الملم شيوخها","أباةٌ صلابُ العود فتيانها المرد",36,"د",1,0],["منا كيد طماعون سودٌ قلوبهم","تحدث عنهم أنفسٌ نهمات",37,"ت",1,0],["من أكرمين هم رؤوس زمانهم","والناس قائمة مقام الأرجل",38,"ل",1,0],["مِن أَكحَل مِنها وَباسليق","يَفصِدُها بِمبضع رَقيقِ",39,"ق",1,0],["من أكره المحزون في الشدو له","ومن على عويل ثاكل رقص",40,"ص",1,0],["من اكرمها منصبا في اللبا","ب وأحمدها في لؤيّ زعيما",41,"م",2,0],["مَن أَكثَر المَجيءَ وَالذهابا","إِلى الصِحابِ ضَيَّعَ الصِحابا",42,"ب",2,0],["مَن أَكثَر الأَعذارَ فيما يَفعَلُ","فَعَن قَليلٍ عُذرُهُ لا يُقبَلُ",43,"ل",1,0],["من أَكثَر المَطلَ بِغَيرِ مانِعِ","فَصدقه في الوَعدِ غَيرُ نافِعِ",43,"ع",1,0],["من أكرم الذئب أو رباه مع غنم","يعدو عليهها بطبع الخائن الرذل",44,"ل",1,0],["من أكذبِ الصدقِ.حتى أصدقِ الكَذِبِ","صِدقُ النِّباحِ لكلبٍ في حمى العَرَبِ",45,"ب",1,1],["من اكْتئابِ انْتظاري أو سعيرِ دمي","أبعثرُ القبلةَ الحرّى بزمّ فمي",46,"ي",1,1],["من اكتب قصيده تزيد الغيوم","ومن عيني الدمع يملي الدفاتر",47,"ر",1,0],["من اكسبوا الدنيا نضارتها","وعليهم التاريخ يتكئُ",48,"ا",1,0],["مِن أكثر الناس الألى غشوا الملا","نصبوا علي أيا حبيبي الجائدُ",49,"د",1,0],["منآك يا مولاي ليس يدرُّ","دمعاً فحسْبُ وإنما هو جمرُ...",50,"ر",1,1],["منآكِ قنبلةُ الفراغ تقصُّنا","عن بعضنا تبني الوجود رموسا",51,"س",2,0],["من أكبر النعم التي حققتُها","يأوي إلى أشعاريَ العظماءُ",52,"ا",2,0]]}