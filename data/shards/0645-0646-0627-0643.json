{"poems":[[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[45,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[45,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[28,"أنا ابن ضبة فرع غير مؤتشب","https://www.aldiwan.net/poem1257.html",""],[46,"أيا جسدي لا تجزعن من البلى","https://www.aldiwan.net/poem22224.html","الطويل"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[45,"أَمَا كَانَ في تَلْكَ الدُّموعِ السَّوائلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32192",""],[45,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[51,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""],[186,"سيان ستر غرامي فيك والعدم","https://www.aldiwan.net/poem14662.html","البسيط"],[187,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[378,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[410,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[459,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[530,"من أكثر المزح دعا كل من","https://www.aldiwan.net/poem37354.html","السريع"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"]],"verses":[["مَناكيدُ فِعلِ الخَيرِ مِنهُم تَكَلُّفٌ","إِذِ الشَرُّ طَبعٌ ما لَهُم عَنهُ ناقِلُ",0,"ل",1,0],["من أكفٍّ بيضٍ غدتْ وهي مشفو","عٌ لدينا بجودها ممتوتُ",1,"ت",1,0],["مَنَاكَ لَهُ مِقْدَارُهُ فكأنَّمَا","تَقَوَّضَ ثَهْلاَنٌ عليه وَصِنْدَدُ",2,"د",1,0],["مناكِيدُ تأبَى أن تجودَ لِقاحُهم","بِدَرِّ بَكِيٍّ أو تُشَدّ عِصابَا",3,"ب",2,0],["مُناكِبٌ لِدَنيآتِ الأُمورِ تُقىً","يَزوَرُّ عَن جانِبِ الفَحشاءِ جانِبُهُ",4,"ب",2,0],["مُناكِدٌ قَد كانَ مِن لُؤمِهِ","يَحمي عَلى الناسِ بِلالَ الحُلوق",5,"ق",1,0],["مَناكِحُ في حَيٍّ فَحَيٍّ تَراهُم","يَسيرونَها بِاللُؤمِ سَيرَ المَراحِلِ",6,"ل",1,0],["مِنّا كَتائِبُ مِثلُ اللَيلِ نَجنِبُها","بِالجُردِ وَالبارِقاتِ البيضِ وَاليَلَبِ",7,"ب",1,0],["مَناكِبَ ساعاتي رُكِبَت فَأَبتَغي","لَباثاً وَسَيرُ الدَهرِ لا يَتَلَبَّثُ",8,"ث",1,0],["من اكتسى بِكَ عَارٍ؛ لاَ كِسَاء لهُ","يكسوهُ إلا الرِّياحُ الهُوجُ، والسحبُ",9,"ب",1,0],["مَنَاكِحُ فِي حَيٍّ فَخَيٍّ ، تَرَاهمُ","يَسِيرونَهَا باللُّؤْمِ سيْرَ المَرَاحِلِ",10,"ل",1,0],["مُناكِبٌ لِدَنِيئَاتِ الأمورِ تُقىً،","يَزْوَرُّ عَنْ جانِبِ الفحْشاءِ جانِبُهُ",11,"ب",2,0],["من أكلِ الناسِ لخبزٍ بَحْتِ","يلُتّهُ بالريق أيَّ لتِ",12,"ت",1,0],["من أكرمَ الناسَ إكراما مَنَتْ به","فشكرُه مثلُ شكرٍ نِلْتَه لَزِم",13,"م",1,0],["من أكل ما لاح بغير مكس","من جورنج قد قلي ومحشي",14,"ي",1,0],["من أكلةٍ قد تاه آدمُ جدُّه","لكنه قد تاب عما قد أكل",15,"ل",1,0],["مُناكَ من زينةِ الدّنيا لَقُلْتُ هُمُ","راعُوا فُؤادي بالهِجرانِ حينَ أمِنْ",16,"ن",1,0],["منَّاك ظنُّك بي غروراً أنني","أصحو وفي الظنّ المحالُ المطَّرَحْ",17,"ح",1,0],["مَنْ أكْثَرَ الْمَزْحَ دَعا كُلَّ مَنْ","يَعْرِفُهُ يَوْماً إلى نَقْصِهِ",18,"ه",1,1],["مَنِ اِكتَرى جَمَلاً أَيضاً إِلى بَلَدٍ","إِذا بِهِ اللِصُّ وَالمَتاعَ قَد ظَفَرا",19,"ر",2,0]]}