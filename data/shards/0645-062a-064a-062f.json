{"poems":[[47,"لعمرك ما أبو فهم لفهم","https://www.aldiwan.net/poem66641.html","الوافر"],[51,"ألا إنما الدنيا متاع غرور","https://www.aldiwan.net/poem62103.html","الطويل"],[71,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[168,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[190,"هذا زمان له طريق","https://www.aldiwan.net/poem43533.html","مخلع البسيط"],[463,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52072","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60877","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206143","السريع"]],"verses":[["مَتى دُعِيَ الكِرامُ إِلى المَساعي","تَقاعَسَ دونَها إِبنُ اِبرَهيما",0,"م",2,0],["مَتى دامَ في الدُنيا سُرورٌ لِأَهلِها","فَأَصبَحَ مِنها واثِقاً بِسُرورِ",1,"ر",1,0],["متى دخلَ الشهباءَ منهم جماعةٌ","لأشغالهمْ يخلو بخاطريَ الفكرُ",2,"ر",1,0],["مَتى دَفَعَ المَرءُ الأَريبُ بِحيلَةٍ","بَوادِرَ ما يُقضى عَلَيهِ فَيُبرمُ",3,"م",1,0],["متى دنا منك فيه خلق","يريد وصلا فخف عقوقه",4,"ق",2,0],["متى دبَّ ماءُ الضيم فيها فلم تعُدْ","مطىَّ قفار الأرض وهي قِفارُ",5,"ر",1,0],["مَتَى دَارَ حَولَ الكَافِ سورٌ عَلاَ بهِ","عَلَى كُلّ رُكنٍ بِالمَدَافِعِ غُولُ",6,"ل",1,0],["متى دخلت للسرِّ تبغي طهارةً","فتدخلُ باليُمنى وتَخرجُ باليُسرى",7,"ر",2,0],["متى دعوت ببعض الصوتِ انجدني","من يُرجعُ الخيلَ مدْمَاةً هواديها",8,"ي",3,0],["متئدَ اللفظ وقد أوشك ال","قلب إلى أفواهنا يسبق",9,"ق",1,0]]}