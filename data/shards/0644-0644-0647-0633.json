{"poems":[[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[88,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[90,"لله سر في الأنام مطلسم","https://www.aldiwan.net/poem45067.html","الكامل"],[53,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[80,"لله ساق مهفهف غنج","https://www.aldiwan.net/poem13987.html","المنسرح"],[80,"لا بد من فرج قريب","https://www.aldiwan.net/poem14180.html","مجزوء الكامل"],[87,"ما بات يثني على علياك إنسان","https://www.aldiwan.net/poem7923.html","البسيط"],[87,"جن على حرم السماء أغاروا","https://www.aldiwan.net/poem62964.html","الكامل"],[63,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[63,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[83,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[52,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[108,"مهبِط الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=179626",""],[164,"الحمد للّه رب العالمين على","https://www.aldiwan.net/poem58891.html","الكامل"],[164,"هز السرور معاقد التيجان","https://www.aldiwan.net/poem58980.html","الكامل"],[240,"يا نازحا ليس يدنو","https://www.aldiwan.net/poem31898.html","المجتث"],[240,"يا صاحبي لمن هذه","https://www.aldiwan.net/poem32116.html","المجتث"],[264,"ليل الخطوب له فجر من الفرج","https://www.aldiwan.net/poem35932.html","البسيط"],[280,"لله سوسان تراكب نوره","https://www.aldiwan.net/poem25509.html","الكامل"],[280,"لله سوسن روض","https://www.aldiwan.net/poem25590.html","المجتث"],[358,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[361,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[435,"لله سرب ظبا سارقنني نظرا","https://www.aldiwan.net/poem40089.html","البسيط"],[435,"كحلت بالسحر وبالدعج","https://www.aldiwan.net/poem41429.html","المتدارك"],[438,"سارت مطيهم بهم تمطو","https://www.aldiwan.net/poem12799.html","أحذ الكامل"],[447,"قسم الغنيمة عن موسى سليل علي","https://www.aldiwan.net/poem14414.html","البسيط"],[463,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[543,"فقد الأحبة موقف كالموقف","https://www.aldiwan.net/poem47555.html","عموديه"],[563,"لله في الكون تحريك وتسكين","https://www.aldiwan.net/poem33849.html","البسيط"],[567,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"],[567,"ماذا يؤمله الحسود بجهده","https://www.aldiwan.net/poem52870.html","الكامل"],[580,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39029","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63989","الكامل"],[914,"","https://poetry.dctabudhabi.ae/diwan/poem/100533","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62564","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62481","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62498","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62667","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120016","الكامل"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130715","الكامل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105222","البسيط"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102247","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35826","السريع"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101839","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89521","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53128","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27414","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27750","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77224","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137416",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2987,"","https://poetry.dctabudhabi.ae/diwan/poem/130744","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65319","الكامل"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140158",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48292","الكامل"],[3565,"","https://poetry.dctabudhabi.ae/diwan/poem/198942","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45779","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85209","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133298","الكامل"],[3871,"","https://poetry.dctabudhabi.ae/diwan/poem/145928","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102964","الكامل"],[4377,"","https://poetry.dctabudhabi.ae/diwan/poem/145428","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72941","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120200","الكامل"],[4831,"عاليه تنهض من كبوتها","https://www.poetsgate.com/ViewPoem.aspx?id=208037",""],[5953,"كم بالغري لمن تبين رشده","https://www.poetsgate.com/ViewPoem.aspx?id=93810",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""],[6134,"بشراك يا دهر ها فوز وها طر","https://www.poetsgate.com/ViewPoem.aspx?id=169519",""],[6142,"المرتضى غيره رفقاً ومرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=155722",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["لِلَّهِ سَيْفُكَ وَالْقُلُوبُ بَوَالِغٌ","ثُغَرَ الحَنَاجِرِ والنُّفُوسُ ظِمَاءُ",0,"ا",2,0],["لِلَّهِ سِرٌّ في بِنايَةِ ثَروَتٍ","سُبحانَ باني هَذِهِ الأَعصابِ",1,"ب",1,0],["لله سرّ في الأنام مطلسم","حار الفصيح بوصفه والأعجم",2,"م",1,1],["لله سؤدد آل سهل سؤدداً","لم يمس مغموراً ولا مفروعا",3,"ع",2,0],["لله سرٌّ فيكَ، يا","لِبنانُ،لم يُعلنْ لنا",4,"ن",2,0],["لِلَّهِ ساقٍ مُهَفهَف غَنج","قامَ لِيَسقي فَجاءَ بِالعَجَبِ",5,"ب",1,1],["لِلَّهِ سَيفُك إِنَّهُ","سُخطٌ عَلى دينِ الصَليبْ",6,"ب",1,0],["لِلَّهِ ساحَتُكَ المَسعودُ قاصِدُها","فَإِنَّما ظِلُّها أَمنٌ وَإيمانُ",7,"ن",1,0],["لِلَّهِ سَرجُكَ في السَماءِ فَإِنَّهُ","سَرجُ الأَهِلَّةِ ما عَلَيهِ غُبارُ",8,"ر",1,0],["للهِ سيفٌ تمنَّى السيفُ شِيمَته","ودولةٌ حَسَدَتها فَخْرَها الدُّوَلُ",9,"ل",1,0],["للهِ سُورٌ على الأيامِ يكلَؤُهُ","وأنتَ لا شكَّ فيه ذلك السُّورُ",10,"ر",1,0],["لِلَّهِ سِرُّ جَمالٍ أَنتَ مَوضِعُهُ","وَالسِرُّ حَيثُ يَشاءُ اللَهُ يودِعُهُ",11,"ع",2,1],["لِلَّهِ سَلمى إِذ لا تُطيعُ بِنا ال","واشي وَإِذ لا نُطيعُ مَن عَتَبا",12,"ب",2,0],["لِلَّهِ سَلمى حُبُّها ناصِبُ","وَأَنا لا زَوجٌ وَلا خاطِبُ",13,"ب",1,1],["لِلهِ سَانِحَةٌ وَعَبْدُ عَزِيزِهَا","سَنَحَتْ فَأَنْجحَهَا الذَّكِيُّ الأَرْوَعُ",14,"ع",1,0],["لله سرٌّ في اختيارك مِهبِطًا","للوحي، يا مستودَع الأسرار!",15,"ر",1,0],["لله سبحانه يمنٌ يعامله","لطفٌ خفيٌّ وغاراتٌ أتت عجلا",16,"ل",2,0],["لله سر في علاك وهذه","جاءت لهذا السر كالعنوان",17,"ن",1,0],["لِلَّهِ سالِفُ عَيشٍ","بِالأَبرَقَينِ تَقَضّى",18,"ض",2,0],["لِلَّهِ سالِفُ عَيشٍ","قَضَيتُهُ فيكَ صالِح",19,"ح",1,0],["لله سرّ التجلّي في الوجود بما","يختار من حرجٍ قد كان أو فرج",20,"ج",1,0],["للَّهِ سُوسانٌ تَرَاكَبَ نَوْرُهُ","فَأَتَى بِما أعْيَا علَى الحُسْبَانِ",21,"ن",1,1],["للّهِ سَوْسَنُ رَوْضٍ","مِن الغَضارَةِ أغْيَدُ",22,"د",1,1],["لِلّه سُمر العَوالي في يَدَي بَطل","إِنسان عَين المَعالي نَحوَهُ كَدحا",23,"ح",2,0],["للّه سودٌ وحمرٌ من حروفهما","والصفر والخضر في مخطوطة الصرط",24,"ط",1,0],["للَه سرب ظباً سارقنني نظراً","من الكناس على شيءٍ من الغزلِ",25,"ل",1,1],["للَه سجاياه اللاتي","فيها غزلي وبها لهجي",26,"ج",2,0],["للهِ سيفُ المُلْكِ من ملِكٍ","يُثْني عليه الخطُّ والخِطُّ",27,"ط",1,0],["للّه سهم وقربى المصطفى لهم","سهم وسهم حواه سيد الرسل",28,"ل",1,0],["لله ساعٍ بلَّغتْهُ قدَمُهُ","حيث تعدَّت عالياتٍ هممُهْ",29,"م",2,1],["لله سيرتك التي أطلقتها","وقيودها التأريخ والأشعار",30,"ر",1,0],["لِله سرٌّ في العبَاد فكم نَرا","هُ يصطِفي لِعبَادهِ ما يَصطَفِي",31,"ف",2,0],["لله سر خفي ليس يدركه","إلا اللبيب الذي فينا له دين",32,"ن",1,0],["لله سِرٌ في البريَّةِ غامضٌ","وَقَفتْ عقولُ النَّاسِ عند حُدُودهِ",33,"د",2,0],["للهِ سِرٌّ في العِبادِ وحِكْمةٌ","تَدَعُ الرَّشيدَ كغائبٍ عن رُشدِهِ",34,"د",2,0],["للهِ سِرٌّ فِيك يُسمَع بَلْ","وَيُبْصَر بِالبَصَائِرْ",35,"ر",1,0],["للهِ سِرُّ جَمالٍ أنْتِ مَعْناهُ","حَسبي بهِ وكَفَى أنّي مُعَنَّاهُ",36,"ا",2,1],["لله ساكنةٌ مساكنَ معشرٍ","لم يعلموا أشَتَوا بها أم قاظوا",37,"ظ",3,0],["للَّه سهم سددته يد القضا","فأصاب كل الخلق حتى من مضى",38,"ض",2,1],["لله سلطان إذا طال المدى","وتسابق الفرسان في الميدانِ",39,"ن",1,0],["لله سلطان الكميُّ إذا ارتقى","اسد الكريهة والتقى الجمعانِ",39,"ن",1,0],["لله سيدنا تيمور أيُّ فتى","وسابق الخيل في ميدانه ضَبحا",40,"ح",2,0],["للّه سيدنا المعظم نادر","لمَّا تجلىَّ فوق أجردَ سابحِ",41,"ح",1,0],["للّه سَبْقُ إرادةٍ","في وقتها يجري القدرْ",42,"ر",1,0],["لله سرب مها شجاني بعده","فبكيته بمدامع أسرابِ",43,"ب",1,0],["لله سر في علاك وإنه","يا كامل الأوصاف سر مظهر",44,"ر",1,0],["لِلّه سيف له ما فيه من كلل","قد صار مغمده هامات أعداه",45,"ا",2,0],["للَه ساقٍ في حلاوةِ كأسهِ","للمُدنَف الهيمان مرُّ مذاقِ",46,"ق",1,0],["لِلّهِ سَيفٌ في يَدي نَصرِ","في حَدِّهِ ماءُ الرَدى يَجري",47,"ي",1,1],["لله ساجي الطرف كم قبلي على","أسد سطا بصوارم الأجفان",48,"ن",1,0],["لله سهمٌ ونبي الهدى","سهمٌ وذي القربى له موضعُ",49,"ع",1,0],["لِلَّهِ سَعيُ إِمامِ المُسلِمينَ فَقَد","حَوى الخِصالَ الَّتي تَسمو بِها الرُتَب",50,"ب",1,0],["لله سيف ما هُزَّ إلا","كفى وكفَّ الخطوبَ قسرا",51,"ر",2,0],["لله سرٌّ لو بدا ما اهتدى","به رجال الأعينِ العُمشِ",52,"ش",1,0],["لله سرٌّ ومن أسمائه ظهرت","أحكامه ليس من شمسٍ ولا زُحل",53,"ل",1,0],["لله سوق قد أقامته الملا","ئكة الكرام بكل ما احسان",54,"ن",1,0],["لِلَهِ ساحِرَةُ الجَمالِ أَديبَةٌ","لَعبَت معَاني حُسنِها بِأَديبِ",55,"ب",1,1],["لله سيرتك التي اكتسبت","حسن الثنا فتضوعت نشرا",56,"ر",2,0],["لله سطوة عز فيه قد مزجت","بالصفح عن مذنب والعفو عن ذنب",57,"ب",1,0],["للّه سرّ في ولايتك التي","ما أبصر الراؤون قدما مثلها",58,"ل",3,0],["لله ساقُ مشرق","مُتحمّلٌ عظم الكفل",59,"ل",1,1],["لله ساعات قضيت بها كما","شاءت سعود الدهر طبق رجائي",60,"ا",2,0],["لِلّه سر اللَه وهو محجب","وضمير غيب اللَه وهو خفاء",61,"ا",2,0],["لله سابقةٌ لها أنِسَتْ بِها","مَوْلَى الخلائِفِ يوسُفٌ لمْ يَنْسَها",62,"س",3,0],["لله سفّاحٌ بدا لي مسحراً","فأفاد علم الكيميا بيمينه",63,"ه",1,1],["لِلّه سُؤددك المُحيط كَماله","بِالوَصف حَتّى نَستَمد الأَبحُرا",64,"ر",2,0],["للَه سحر عظيم في لواحظه","فاعجب لهم كيف سمو سحره كحلا",65,"ل",2,0],["لله ساحته التي من نورها","قد أشرقت كالشمس في برج الحمل",66,"ل",1,0],["لله سرحة ذلك الربع الذي","قلبي يهيم به وذاك الجوسق",67,"ق",1,0],["للَه سعدك قد أطال لك العلى","والسعي دون السعد ليس بمسعد",68,"د",1,0],["لله ساحر ناظريه إذا انتضى","من جفنه حد الحسام الباتر",69,"ر",1,1],["للَه سفرٌ راجحٌ مقداره","ملكاً غدا للكاملِ الرجحان",70,"ن",1,1],["لله ساعة بيعة ميمونة","شرت النفوس تيمنا وسرورا",71,"ر",2,0],["للّهِ سِحْرُكِ يا عاليَّه لا عَجَبُ","أن يسْكُنَ السِّحْرُ حيثُ الحبُّ والطَّربُ",72,"ب",1,1],["لله سرٌّ كامنٌ في خلقه","متبين للقاصدين عيانه",73,"ن",2,0],["لله ستة أشهر كابدتها","والجو من صبغ العجاجة حائل",74,"ل",1,0],["29. للهِ سوقٌ والنفوسُ جليبةٌ","سِلعٌ تقوَّمُ والملائكُ شُهَّدُ",75,"د",1,0],["لله سلطاننا خير الملوك ويا","لله همته يا أيها البشر",76,"ر",1,0],["لله سَورته لله غضبته","لله شدتها لله قاسيها",77,"ي",3,0],["للهِ سعيُكَ كيف أذللتَ الدُّنا","حتّى أتيتَ تُحقِّقُ المأمولا ؟!",78,"ل",2,0]]}