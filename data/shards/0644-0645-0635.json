{"poems":[[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[93,"دع الخمر نصح أخ إنها","https://www.aldiwan.net/poem11112.html","المتقارب"],[93,"لمصر الجديدة عيد سعيد","https://www.aldiwan.net/poem11327.html","المتقارب"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[72,"لمصر مفاخر تقديم تاج","https://www.aldiwan.net/poem19991.html","الوافر"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[45,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[66,"لو صرت من سقمي شبيه سواك","https://www.aldiwan.net/poem39929.html","الكامل"],[87,"لمصطفى صادق في الشعر منزلة","https://www.aldiwan.net/poem8198.html","البسيط"],[31,"يا خليلي عادني اليوم سقمي","https://www.aldiwan.net/poem41337.html","الخفيف"],[74,"قل للمقيم مع النفوس علاقة","https://www.aldiwan.net/poem13201.html","الكامل"],[105,"أما ينهى دعاة السوء عنا","https://www.aldiwan.net/poem43378.html","الوافر"],[105,"غشيت ديارها من بعد عشر","https://www.aldiwan.net/poem43399.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[136,"لمصر بئس المصير","https://www.aldiwan.net/poem48861.html","المجتث"],[144,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[187,"لو لم أعاقب بالبغ","https://www.aldiwan.net/poem43350.html","مجزوء الكامل"],[204,"أيجزع كعب لأشياعه","https://www.aldiwan.net/poem68169.html","المتقارب"],[350,"داء ثوى بفؤاد شفه سقم","https://www.aldiwan.net/poem15640.html","البسيط"],[378,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[434,"عظم المصاب وعمت الأكدار","https://www.aldiwan.net/poem811.html",""],[442,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"]],"verses":[["لِمِصرَ أَم لِرُبوعِ الشامِ تَنتَسِبُ","هُنا العُلا وَهُناكَ المَجدُ وَالحَسَبُ",0,"ب",1,1],["لِمِصْرَ بِكُمْ حُسْنُ ظَنٍّ إِذَا","عَفَفْتُمْ فَلا تُخْلِفُوا ظَنَّها",1,"ن",3,0],["لِمِصْرَ الجَدِيدَةِ عِيدٌ سَعِيدٌ","تَجَلَّى بِهَذَا النَّهَارِ الوَسِيمِ",2,"م",1,1],["لِمِصْرَ عَهْدٌ بِالاسْتِقلالِ مُفْتَتَحٌ","فَدَاهُ عُمْرٌ بِالاسْتِشْهَادِ مُخْتَتَمُ",3,"م",1,0],["لمصر مفاخر تقديم تاجٍ","على ميّ الإشارة في الكرام",4,"م",1,1],["لِمُصيبَةٍ بِأَبي عُبَيدٍ أَردَفَت","بِأَبي حُمَيدٍ بَعدَهُ وَمُبَشِّرِ",5,"ر",1,0],["لِمَصقَلَةَ البَكرِيِّ يَنمي وَمَن يَكُن","لِمَصقَلَةَ البَكرِيِّ تَشرُف فَوارِطُه",6,"ط",2,0],["لِم صَيَّروا تَشبيهَهُم لَكِ شُبهَةً","أَتُراكِ مَكَّنتِ العِداةَ تُراكِ",7,"ك",1,0],["لِمُصْطَفَى صَادِقٍ فِي الشِّعْرِ مَنْزِلَةٌ","أَمْسَى يُعَادِيهِ فِيهَا مَنْ يُصَافِيهِ",8,"ف",3,1],["لِمُصِرٍّ أَصَرَّ وَاِستَكبَرَ اليَو","مَ وَظَنَّ الصُدودَ لَيسَ بِظُلمِ",9,"م",1,0],["لِم صِرتَ تَرغَبُ عَن سَجايا حُرَّةٍ","قَد كُنتَ مُقتَنِياً لَها أَعلاقا",10,"ق",2,0],["لِمِصرَ قُلوبُنا وَلَها هَوانا","عَلى الحالَينِ مَحضاً غَيرَ مَذقِ",11,"ق",1,0],["لِمِصرَ شَبابُها في الدَهرِ إِنّي","خَلَعتُ شَبيبَتي وَطَوَيتُ عُمري",12,"ر",2,0],["لمصر بسعد كل يوم صبابة","كَما كانَ سعد كل يوم بها صبا",13,"ب",2,0],["لِمِصْرَ إِذَا اسْتَكْفَتْ كَفَاءٌ بِنفَسِهَا","ففِيمَ الرِّضَى مِنْ وَافِرِ الخَيْرِ بِالنَّزرِ",14,"ر",1,0],["لِمصْرَ سُيُوفٌ في حَديث جهَادهَا","حَمَتْ حَوْضَهَا منْ أَنْ يَظَلَّ مُهَدَّدَا",15,"د",2,0],["لمصْرَ بَنَى مَا عَزَّ قَبْلاً بنَاؤُهُ","عَلَى مُقْدمٍ جَلدٍ فَأَعْلَى وَمَدَّدَا",15,"د",2,0],["لِمِصْرَ مَا حَوَّلَ مِنْ حَالَةٍ","لِمِصْرَ مَا أَبْلَى وَمَا جَددَا",16,"د",2,0],["لِمِصْرَ طَيَّ الثَّرَى فَقِيدٌ","غَالٍ وَمَنْ ذلِكَ الفَقِيدُ",17,"د",1,0],["لِمِصْرَ وَالشَّرْقِ بَلْ لِلْخَافِقَيْنِ مَعاً","دَعْ زَعْمَ كُلِّ عَدُوِّ الحٌّقِّ مِرِّيدِ",18,"د",1,0],["لِمَصْدَرِ النورِ لِلْبَنِينَا","والْمَنْهَلِ الْعَذْبِ لِلْوُرُودِ",19,"د",1,0],["لمِصْرٍ وتَحْتَ الفارِسَيْنِ بَعِيرُ","تُبَشَّرُ مِصر دائماً بِقُدُومِهِمْ",20,"م",1,0],["لِمَصْقلَة الذي أسْدى وأَيدَى","أيادٍ في المعاشر لا تُعَدُّ",21,"د",1,0],["لمصرَ بئس المصيرُ","العيشُ فيها مريرُ",22,"ر",1,1],["لِمُصعَبٍ يَطَّبيهِ العِزُّ يُحرِزُهُ","وَالخَصمُ يُعجِزُهُ لا الماءَ وَالعُشبُ",23,"ب",1,0],["لم صرت يتّبعني الجما","عة في الرواح وفي المقيل",24,"ل",1,0],["لِمَصرَعِ إِخوانِهِ في مِكَر","مِنَ الخَيلِ ذي قَسطَلٍ مُرهِجِ",25,"ج",1,0],["لِمَصرَعي مُعتَدٍ تَحلو مَرارَتُهُ","يا قَومَنا فَخُذوا نَحوَ الضَنا بِيَدي",26,"د",2,0],["لمصائب الدهر الخؤون لأهله","فكأنه سهمٌ ونحن المصرع",27,"ع",1,0],["لمصيبةٍ وِجَلَت بها ألبابُنا","وعقولُنا من هَولِها تحتارُ",28,"ر",1,0],["لمصيبةٍ كادت تخرُّ لهولها","شُمُّ الجبالِ وتخسفُ الأقمارُ",28,"ر",1,0],["لمصيبة في الدين يعظم رزؤها","يبكي الحليم وتضحك الأشرارُ",28,"ر",1,0],["لمصيبة كل المصائب عندها","هانت ووقع منّية لا تدفع",29,"ع",1,0],["لِمُصعَبِ الأَمرِ إِذا الأَمرُ اِنقَشَر","أَمَرَّهُ يَسراً فَإِن أَعيا اليَسَر",30,"ر",1,0]]}