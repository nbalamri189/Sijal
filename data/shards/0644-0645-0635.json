{"poems":[[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[95,"دع الخمر نصح أخ إنها","https://www.aldiwan.net/poem11112.html","المتقارب"],[95,"لمصر الجديدة عيد سعيد","https://www.aldiwan.net/poem11327.html","المتقارب"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[74,"لمصر مفاخر تقديم تاج","https://www.aldiwan.net/poem19991.html","الوافر"],[47,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[47,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[68,"لو صرت من سقمي شبيه سواك","https://www.aldiwan.net/poem39929.html","الكامل"],[89,"لمصطفى صادق في الشعر منزلة","https://www.aldiwan.net/poem8198.html","البسيط"],[33,"يا خليلي عادني اليوم سقمي","https://www.aldiwan.net/poem41337.html","الخفيف"],[76,"قل للمقيم مع النفوس علاقة","https://www.aldiwan.net/poem13201.html","الكامل"],[107,"أما ينهى دعاة السوء عنا","https://www.aldiwan.net/poem43378.html","الوافر"],[107,"غشيت ديارها من بعد عشر","https://www.aldiwan.net/poem43399.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54715","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[69,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[139,"لمصر بئس المصير","https://www.aldiwan.net/poem48861.html","المجتث"],[147,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[190,"لو لم أعاقب بالبغ","https://www.aldiwan.net/poem43350.html","مجزوء الكامل"],[207,"أيجزع كعب لأشياعه","https://www.aldiwan.net/poem68169.html","المتقارب"],[354,"داء ثوى بفؤاد شفه سقم","https://www.aldiwan.net/poem15640.html","البسيط"],[382,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[439,"عظم المصاب وعمت الأكدار","https://www.aldiwan.net/poem811.html",""],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2454","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138292",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126729","الخفيف"],[684,"","https://poetry.dctabudhabi.ae/diwan/poem/101261","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88601","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87273","المجتث"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53949","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48744","البسيط"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145631","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72331","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79947","المنسرح"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100996","البسيط"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124297","الكامل"],[1833,"","https://poetry.dctabudhabi.ae/diwan/poem/111109","البسيط"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130220","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125488","المجتث"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76803","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136997",""],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52982","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52991","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86313","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138713",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66421","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123521","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97070","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52191","البسيط"],[4682,"خبز الشعير","https://www.poetsgate.com/ViewPoem.aspx?id=64804",""],[4767,"مأساة مضخة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=181851",""],[5026,"ثقب في كفن الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=210851",""],[5111,"لمِصْر أمْ لشَآمِ","https://www.poetsgate.com/ViewPoem.aspx?id=212127",""],[5431,"مصر...والرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=197044",""],[402,"هل الهلال فحيوا طالع العيد","https://www.poetsgate.com/ViewPoem.aspx?id=35360",""],[4990,"الراحلون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6579&r=&rc=123",""],[6243,"مُوَشَّح خليجيّ ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84443&r=&rc=17",""]],"verses":[["لِمِصرَ أَم لِرُبوعِ الشامِ تَنتَسِبُ","هُنا العُلا وَهُناكَ المَجدُ وَالحَسَبُ",0,"ب",1,1],["لِمِصْرَ بِكُمْ حُسْنُ ظَنٍّ إِذَا","عَفَفْتُمْ فَلا تُخْلِفُوا ظَنَّها",1,"ن",3,0],["لِمِصْرَ الجَدِيدَةِ عِيدٌ سَعِيدٌ","تَجَلَّى بِهَذَا النَّهَارِ الوَسِيمِ",2,"م",1,1],["لِمِصْرَ عَهْدٌ بِالاسْتِقلالِ مُفْتَتَحٌ","فَدَاهُ عُمْرٌ بِالاسْتِشْهَادِ مُخْتَتَمُ",3,"م",1,0],["لمصر مفاخر تقديم تاجٍ","على ميّ الإشارة في الكرام",4,"م",1,1],["لِمُصيبَةٍ بِأَبي عُبَيدٍ أَردَفَت","بِأَبي حُمَيدٍ بَعدَهُ وَمُبَشِّرِ",5,"ر",1,0],["لِمَصقَلَةَ البَكرِيِّ يَنمي وَمَن يَكُن","لِمَصقَلَةَ البَكرِيِّ تَشرُف فَوارِطُه",6,"ط",2,0],["لِم صَيَّروا تَشبيهَهُم لَكِ شُبهَةً","أَتُراكِ مَكَّنتِ العِداةَ تُراكِ",7,"ك",1,0],["لِمُصْطَفَى صَادِقٍ فِي الشِّعْرِ مَنْزِلَةٌ","أَمْسَى يُعَادِيهِ فِيهَا مَنْ يُصَافِيهِ",8,"ف",3,1],["لِمُصِرٍّ أَصَرَّ وَاِستَكبَرَ اليَو","مَ وَظَنَّ الصُدودَ لَيسَ بِظُلمِ",9,"م",1,0],["لِم صِرتَ تَرغَبُ عَن سَجايا حُرَّةٍ","قَد كُنتَ مُقتَنِياً لَها أَعلاقا",10,"ق",2,0],["لِمِصرَ قُلوبُنا وَلَها هَوانا","عَلى الحالَينِ مَحضاً غَيرَ مَذقِ",11,"ق",1,0],["لِمِصرَ شَبابُها في الدَهرِ إِنّي","خَلَعتُ شَبيبَتي وَطَوَيتُ عُمري",12,"ر",2,0],["لمصر بسعد كل يوم صبابة","كَما كانَ سعد كل يوم بها صبا",13,"ب",2,0],["لِمِصْرَ إِذَا اسْتَكْفَتْ كَفَاءٌ بِنفَسِهَا","ففِيمَ الرِّضَى مِنْ وَافِرِ الخَيْرِ بِالنَّزرِ",14,"ر",1,0],["لِمصْرَ سُيُوفٌ في حَديث جهَادهَا","حَمَتْ حَوْضَهَا منْ أَنْ يَظَلَّ مُهَدَّدَا",15,"د",2,0],["لمصْرَ بَنَى مَا عَزَّ قَبْلاً بنَاؤُهُ","عَلَى مُقْدمٍ جَلدٍ فَأَعْلَى وَمَدَّدَا",15,"د",2,0],["لِمِصْرَ مَا حَوَّلَ مِنْ حَالَةٍ","لِمِصْرَ مَا أَبْلَى وَمَا جَددَا",16,"د",2,0],["لِمِصْرَ طَيَّ الثَّرَى فَقِيدٌ","غَالٍ وَمَنْ ذلِكَ الفَقِيدُ",17,"د",1,0],["لِمِصْرَ وَالشَّرْقِ بَلْ لِلْخَافِقَيْنِ مَعاً","دَعْ زَعْمَ كُلِّ عَدُوِّ الحٌّقِّ مِرِّيدِ",18,"د",1,0],["لِمَصْدَرِ النورِ لِلْبَنِينَا","والْمَنْهَلِ الْعَذْبِ لِلْوُرُودِ",19,"د",1,0],["لمِصْرٍ وتَحْتَ الفارِسَيْنِ بَعِيرُ","تُبَشَّرُ مِصر دائماً بِقُدُومِهِمْ",20,"م",1,0],["لِمَصْقلَة الذي أسْدى وأَيدَى","أيادٍ في المعاشر لا تُعَدُّ",21,"د",1,0],["لمصرَ بئس المصيرُ","العيشُ فيها مريرُ",22,"ر",1,1],["لِمُصعَبٍ يَطَّبيهِ العِزُّ يُحرِزُهُ","وَالخَصمُ يُعجِزُهُ لا الماءَ وَالعُشبُ",23,"ب",1,0],["لم صرت يتّبعني الجما","عة في الرواح وفي المقيل",24,"ل",1,0],["لِمَصرَعِ إِخوانِهِ في مِكَر","مِنَ الخَيلِ ذي قَسطَلٍ مُرهِجِ",25,"ج",1,0],["لِمَصرَعي مُعتَدٍ تَحلو مَرارَتُهُ","يا قَومَنا فَخُذوا نَحوَ الضَنا بِيَدي",26,"د",2,0],["لمصائب الدهر الخؤون لأهله","فكأنه سهمٌ ونحن المصرع",27,"ع",1,0],["لمصيبةٍ وِجَلَت بها ألبابُنا","وعقولُنا من هَولِها تحتارُ",28,"ر",1,0],["لمصيبةٍ كادت تخرُّ لهولها","شُمُّ الجبالِ وتخسفُ الأقمارُ",28,"ر",1,0],["لمصيبة في الدين يعظم رزؤها","يبكي الحليم وتضحك الأشرارُ",28,"ر",1,0],["لمصيبة كل المصائب عندها","هانت ووقع منّية لا تدفع",29,"ع",1,0],["لِمُصعَبِ الأَمرِ إِذا الأَمرُ اِنقَشَر","أَمَرَّهُ يَسراً فَإِن أَعيا اليَسَر",30,"ر",1,0],["لَمُصعَبُ عِندَ جِدِّ القَو","لِ أَكثَرُها وَأَطيَبُها",31,"ب",3,0],["لمصلحة أقبلت باليمن يا فخري","فماست دلالا من حبور ومن بشر",32,"ر",1,1],["لمُصابِ الإمام باب المرادِ","سال دَمعي دماً كصوب الغوادي",33,"د",2,1],["لمصاب قد أورث الدين حزناً","وصغاراً وذلة وانكسارا",34,"ر",2,0],["لمصاب العلامة العلم المهدي","من بحر علمه لا يجاري",34,"ر",2,0],["لمصابه التهب الفؤاد","وأَنت أَخمدت التهابه",35,"ب",2,0],["لِمَصر مِن كُلِّ عادي","في يَوم كرٍّ وَفرِّ",36,"ر",1,0],["لِمُصابِ أندَلُسٍ تصوبُ الأدمُعُ","ولِمَا جرى فيها تذوبُ الأضلُعُ",37,"ع",1,1],["لمصر شرط على شتى شروطهمُ","وما لها بدل منه ولا ثمن",38,"ن",1,0],["لِمِصْرَ غَنَّيْتُ مِن أَشْجَى مَعانِيها","يَائِيَّةَ الحَرْفِ مَا أَحْلَى قَوَافِيها",39,"ي",3,1],["لِمِصْرَ قَلْبِي، وَلِلأحْبابِ مُهْجَتُهُ","وَلي مِنَ الحُبِّ والذّكْرَى مَآسِيهَا",39,"ي",3,0],["لمصاب آل محمد نار الجوى","اضطرمت وهل صبر على النيران",40,"ن",1,0],["لِمْ صاحب الأمر عن رعيَّته","أغضى فغصَّت بجور أكفرها",41,"ر",3,0],["لمصرَ أنفُسُنا بَذلٌ إذا رضيت","فذاك أعذبُ ما نرجو وننتظر",42,"ر",1,0],["لمصيبة صدمت فؤادي صدمة","كادت بنات الجوف منها تصعد",43,"د",1,0],["لم صرت ذات ظلام يا نسيم صبا","كأن نجم سماء العلم قد غربا",44,"ب",2,1],["لمُصِيبةٍ أبْدتْ قوارعُها","في الصَّدْر مثل تَلهُّب الجمْرِ",45,"ر",1,0],["لمصرَ في الدهر مجدُ","مخلدٌ لا يغيب",46,"ب",1,0],["لمصرعه تبكي الدموع بحقها","فلله من جُرم وعظم تمرّد",47,"د",1,0],["لِمصَابه فلك السَماء متشاغل","عَن جَريه وَالدَمع مِنهُ هاطل",48,"ل",1,0],["لمصابه جزع الزمان مؤرخا","وبكى على حر نبيه فاضل",49,"ل",1,0],["لمصرنا سالفُ المزيّهْ","قد مدّنتْ سائرَ البريهْ",50,"ه",1,0],["لمصرَ به شأنٌ طريف زهتْ به","وعزٌّ منيف قد أظلت ظِلاله",51,"ل",2,0],["لِمِصر امير ثابِت الجاش حازِم","بِرايٍ سَديد كَالحُسامِ اِذا اِفتَرّا",52,"ر",2,0],["لمصيبةٍ قبل الحلول","بكى لها من كان عالم",53,"م",1,0],["لمصاب مولانا الحسي","ن قد اكتسى حلل السوادِ",54,"د",1,0],["لمصرعه المعلوم دام مسارعا","لما معه الاسعاد والوصل والرمّ",55,"م",1,0],["لمصاب أشاب سود الليالي","بعد ما جلبب العلى بسواد",56,"د",1,0],["لمصرَ دَيْنٌ من الإلهام في عُنقي","يا ليت شعري أهذا الشعرُ وفّاهُ",57,"ا",2,0],["لم صدره من قليل ومن كثير","كل أشكال الهموم الموجعة",58,"ع",2,0],["لمصلحة المياه تمد كفًّا","فجاء الرد منها كالسراب",59,"ب",1,0],["لِمَ صُرْتَ أجنِحةً لِطيْرٍ عاقِر","وهناك إبراهيم يَنْحَتُ مَنْسِمَكْ",60,"ك",1,0],["\"لِمِْصِرَ امْ لرُبوعِ الشَّامِ تنتسبُ\"","عيناكَ تسبحُ فِيْ شِعْريْ وتلتهبُ",61,"ب",1,1],["لمصر شغاف القلب يرنو مؤملا","بروضتنا الكبرى سطوعٌ هي الدربُ",62,"ب",1,0],["لمصر والشرق بل للخافقين معا","دع زعم كل عدوا الحق مريد",63,"د",1,0],["لمصير شاهدةٍ على قبر.","القدمُ الهاذيةُ تنزلقُ في مساء أخير.",64,"ر",1,0],["لمَ صَمْت هذا الطُّهْر يَمْلأ ثغْرَهَا","ومُرُور هذا الغيْم ينْسُجُ حائلا؟",65,"ل",2,0]]}