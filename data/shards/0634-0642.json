em24361.html","عموديه"],[453,"مد الخريف رواقا من مباهجه","https://www.aldiwan.net/poem61222.html","البسيط"],[453,"إلى إيطاليا خفوا وطيروا","https://www.aldiwan.net/poem61576.html","الوافر"],[453,"سفارة كافور تعلممنا الهدى","https://www.aldiwan.net/poem61602.html","الطويل"],[453,"أهل الحمية والحمية أنتمو","https://www.aldiwan.net/poem61679.html","الكامل"],[453,"قالوا تصبر قد يتوب الغادر","https://www.aldiwan.net/poem61766.html","الكامل"],[458,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[458,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[458,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[458,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[461,"وما تلومت في مديح","https://www.aldiwan.net/poem15610.html","مخلع البسيط"],[464,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[464,"حي الديار برامتين ونادها","https://www.aldiwan.net/poem3435.html","عموديه"],[464,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[468,"الفجر بين الليل والصبح","https://www.aldiwan.net/poem60306.html","البسيط"],[479,"والبدر في أفق السماء كردهم","https://www.aldiwan.net/poem36903.html","الكامل"],[479,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[479,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[479,"لله يا ثغر زانك الشنب","https://www.aldiwan.net/poem37063.html","المنسرح"],[479,"وجه غادتي القمر","https://www.aldiwan.net/poem37069.html","المقتضب"],[479,"الله أكبر أيها ال","https://www.aldiwan.net/poem37198.html","مجزوء الكامل"],[479,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[493,"في عارض ضاقت الأرض الفسيحة عن","https://www.aldiwan.net/poem67325.html","البسيط"],[495,"ما رابني إلا الرقيب إذ نظر","https://www.aldiwan.net/poem9863.html","مشطور الرجز"],[495,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[495,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[500,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[538,"شقوا البحيرة سبحا من بسبحهم","https://www.aldiwan.net/poem48246.html","عموديه"],[540,"أألحمامة في نخل ابن هداج","https://www.aldiwan.net/poem56877.html","البسيط"],[545,"ويل أم قوم صبحناهم مسومة","https://www.aldiwan.net/poem2245.html","البسيط"],[551,"وللغصن يرمى كل يوم بشاذب","https://www.aldiwan.net/poem48066.html","الطويل"],[553,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[558,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[558,"قف على أيمن الحمى كوقوفي","https://www.aldiwan.net/poem34361.html","الخفيف"],[573,"وخبرني الناعون ما صنع الردى","https://www.aldiwan.net/poem3657.html","الطويل"],[575,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[575,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[575,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"]],"verses":[["شَقَقنا بِها قَلبَ الظَلامِ وَفَوقَها","رِجالٌ كَأَطرافِ الذَوابِلِ ميلُ",0,"ل",1,0],["شَقيقي إِذا اِلتاثَ الشَقيقُ وَأَعرَضَت","خَلائِقُ قَومي جانِباً عَن خَلائِقي",1,"ق",2,0],["شَقِيَت مِنكَ بِالعَلاءِ الأَعادي","وَالمَعالي ضَرائِرُ الحُسّادِ",2,"د",1,1],["شَقيقَتي إِنَّ خَطباً","عَدا عَلَيكِ لَخَطبُ",3,"ب",1,0],["شُقَّت إِلَيهِ سُيوفُهُ وَرِماحُهُ","وَأُميتَ عَنهُ عَبيدُهُ وَإِماؤُهُ",4,"ا",3,0],["شَقَّت عَلى العَليا وَفاةُ كَريمَةٍ","شَقَّت عَلَيها المَكرُماتُ بُرودَها",5,"د",3,0],["شَقَقتُ بِصَدرِهِ مَوجَ المَناي","وَخُضتُ النَقعَ لا أَخشى اللَحاقا",6,"ق",2,0],["شُقّتْ على مَنعاهُ حُمْرُ قِبابِهِ","وشَقيقُهُ ألِفَ الذُّرى وبَهارُهُ",7,"ر",2,0],["شَقيّ أتَتْهُ منْ لدُنْهُ سَعادَةٌ","ومُنْكرُ قومٍ جاءَ بالحادِثِ النّكْرِ",8,"ر",1,0],["شقَّهُ الرّوحُ ثمّ طهّرَ منْهُ ال","قَلْبَ منْ بَعْدُ بالبَرودِ القَراحِ",9,"ح",1,0],["شَقَقتُ أَسواقَ بَيروتٍ فَما أَخَذَت","عَينايَ في ساحِها حانوتَ يوناني",10,"ي",1,0],["شَقَّ الشَقيقُ بِها مَلابِسَهُ","حُزناً عَلى ديباجَةِ الأُصُلِ",11,"ل",1,0],["شَقَقتُ دُجاها لا أَرى غَيرَ هِمَّتي","أَنيساً وَلا لي غَيرُ عَزمِيَ صاحِبُ",12,"ب",1,0],["شقاء تمطَى في العراق تمطّياً","وألفى جراناً لا يزحزح واستلقى",13,"ق",2,0],["شقِيَت بكم لما شَقِيتم أرضكم","فلها بكم ولكم بها غَمَرات",14,"ت",1,0],["شَقَقتَ مِنَ الفُراتِ مُبارَكاتٍ","جَوارِيَ قَد بَلَغنَ كَما تُريدُ",15,"د",1,0],["شَقَّ لَهُ مِنِ إِسمِهِ كَي يُجِلَّهُ","فَذو العَرشِ مَحمودٌ وَهَذا مُحَمَّدُ",16,"د",1,1],["شقيَ العذولُ على محاسنهِ","ونعمتُ في تعذيبهِ العذب",17,"ب",1,0],["شقَّ الأسى قلبي الصريع فيا له","بيتاً أبت سكناه غير مصرّع",18,"ع",1,0],["شقيقها في الحبِّ يا سيدي","ما كانَ في النعمان للنابغه",19,"غ",2,0],["شَقّاقُ ساجٍ يبيت ليلَتَهُ","منشارُه في مَشَقِّ ساجتِهِ",20,"ت",2,0],["شق بحراً من البحار وأرسى","جبلاً شامخاً يفوق الأنوقا",21,"ق",2,0],["شَقِيَ القَريضُ بِهِم وَما سَعِدوا بِهِ","لَولاهُمُ أَضحى مِنَ السُعَداءِ",22,"ا",2,0],["شَقِيَ الجَميعُ بِها وَعَزَّ ثَلاثَةٌ","ذِئبُ الفَلاةِ وَنَسرُها وَالأَجدَلُ",23,"ل",1,0],["شُقّوا الطُروسَ وَحَطِّموا أَقلامَكُم","اليَومَ يَومُ شَواجِرِ المُرّانِ",24,"ن",1,0],["شُقرٌ سَماوِيَّةٌ ظَلَّت مُحَلَّأَةً","بِرِجلَةِ التَيسِ فَالرَوحاءِ فَالأَمَرِ",25,"ر",1,0],["شقيت بالشعر في ناس أعوذ بهم","من أن يقول الأعادي شاعر الهمل",26,"ل",1,0],["شَقَّت لِمَنظَرِكَ الجُيوبَ عَقائِلٌ","وَبَكَتكَ بِالدَمعِ الهَتونِ غَواني",27,"ي",1,0],["شَقيتُم بِها مِن حيلَةٍ مُستَحيلَةٍ","وَأَينَ مِنَ المُحتالِ عَنقاءُ مُغرِبُ",28,"ب",1,0],["شَقَقتُ بِهِ الظَلماءَ أُدني عِنانَهُ","فَيَطغى وَأُرخيهِ مِراراً فَيَلعَبُ",29,"ب",1,0],["شقَّ النباتَ عنِ البتسانِ ريِّقُهُ","مُحَيّياً جارَهُ الميدانَ بالشجر",30,"ر",1,0],["شقَّتْ عليك جيوبَها شهَّاقَةٌ","برعودِها وسقتْك فيضَ الأدمُعِ",31,"ع",1,0],["شَقيقي أَبي إِسحاقَ نَفسي فِداؤُهُ","وَرَأسُ بَقايا كُلِّ حُرٍّ وَكاتِبِ",32,"ب",1,0],["شَقائِقُ يَحمِلنَ النَدى فَكَأَنَّهُ","دُموعُ التَصابي في خُدودِ الخَرائِدِ",33,"د",1,0],["شَقَقتُ مِنكَ قَفاً لِلصَفعِ دامِيَةً","صَفعاً تَظَلُّ عَلَيهِ نادِرَ الحَدَقَه",34,"ق",2,0],["شَقائِقاً مِن جِيادٍ غَيرِ مُقرِفَةٍ","كَما شَقَقتُ مِنَ العُرضِيَّةِ الطُرَرا",35,"ر",2,0],["شَقَقنا عَنِ الأَولادِ بِالسَيفِ بَطنَها","وَلَمّا تُجَلَّد وَهيَ يَحبو بَقيرُها",36,"ر",3,0],["شَقا شَقَّتَيهِ جَعفَرٌ بي وَقَد أَتَت","عَلَيَّ لَهُم سَبعونَ تَمَّت شُهورُها",37,"ر",3,0],["شَقينا وَماتَت قُوَّةُ الجَيشِ وَالَّذي","بِهِ تُربَطُ الأَحشاءُ عِندَ المَخاوِفِ",38,"ف",1,0],["شَقَّ حشاه عن شَقيقَتَيْنِ","أُخْتَيْنِ في القَدِّ شَبيهَتَيْنِ",39,"ن",1,0],["شَقْقتُ قَذَالَ الخَالديِّ بِمَنْطِقٍ","يَشُقُّ من الأَعْداءِ كلَّ قَذالِ",40,"ل",1,0],["شَقيقٌ وَعبَدُ اللَهِ بِشرٌ وَمَعبَدٌ","وَسُفيانَ وَاِبنا هاشِمٍ ذي المَكارِمِ",41,"م",1,0],["شَقيقَةُ خَدٍّ بِالسُرورِ مُدَرَّجٍ","بِها وَلِوَقعِ الماءِ في خَدِّها خَدشُ",42,"ش",1,0],["شَقَقنَ قُلوبَ الحادِثاتِ بِوَقعِها","وَشارَكَتِ الأَقدارَ أَقلامُهُ الرُقشُ",42,"ش",1,0],["شَقَّ هَذا عَلى المُقِلِّ وَلَكِن","مِن صِفاتِ الكِرامِ جَبرُ القُلوبِ",43,"ب",1,0],["شَقُّ الجُيوبِ بِلا شَقِّ القُلوبِ بِها","خُلقٌ ذَميمٌ لِمَن يَرعى لَها الذِمَما",44,"م",2,0],["شَقّوا بها جُنْحَ ليلٍ أليلٍ رَحَلوا","عن غُرّةِ الصبح من ديجوره غُمَما",45,"م",2,0],["شُقَّت جُيوبُ المعالي بالأسى وبكَتْ","في الخافقَينِ عليه الأنجمُ الزُّهرُ",46,"ر",1,0],["شَقَّ جُيوباً مِن رِجالٍ لَوِ اِسطا","عوا لَشَقّوا ما وَراءَ الجُيوبِ",47,"ب",1,0],["شَقَقتَ إِلى جَبّارِهِ حَومَةَ الوَغى","وَقَنَّعتَهُ بِالسَيفِ وَهُوَ مُقَنَّعُ",48,"ع",1,0],["شَقِيَّانِ هَامَا فِي الضَّلالِ فَأَصْبَحَا","دَرِيئَةَ لَعْنٍ مِنْ فَصِيحٍ وَأَعْجَمِ",49,"م",1,0],["شَقيقُ النَدى وَاِبنُ النُهى وَأَبو العُلا","وَحَسبُكَ بَيتاً في المَكارِمِ عالِيا",50,"ي",2,0],["شَقيتَ كَم