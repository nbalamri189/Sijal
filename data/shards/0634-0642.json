{"poems":[[53,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[3,"جازت مُلمات الزمان حدوده","https://www.aldiwan.net/poem147.html",""],[3,"صحا من سكره قلبي وفاق","https://www.aldiwan.net/poem180.html",""],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"يحييك بالريحان والروح من قبر","https://www.aldiwan.net/poem36490.html","الطويل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[71,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[88,"ذهبت لحي في فروق تزاحمت","https://www.aldiwan.net/poem44452.html","الطويل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[23,"شق له من إسمه كي يجله","https://www.aldiwan.net/poem21418.html","الطويل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"هنئت يا أعلى الورى رتبة","https://www.aldiwan.net/poem19253.html","السريع"],[51,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[38,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[85,"بين الملامة فيكم والهوى الجلل","https://www.aldiwan.net/poem6819.html","البسيط"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[43,"ذي الأرض عما أتاها الأمس غانية","https://www.aldiwan.net/poem10638.html","البسيط"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[45,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[45,"قولوا لسرجس يا ابن القحبة الشبقه","https://www.aldiwan.net/poem65212.html","الخفيف"],[28,"خليفة الله منهم في رعيته","https://www.aldiwan.net/poem5100.html","البسيط"],[28,"فرب ربيع بالبلاليق قد رعت","https://www.aldiwan.net/poem5246.html","الطويل"],[28,"ولكن خربانا تنوس لحاهم","https://www.aldiwan.net/poem5249.html","الطويل"],[28,"ولم يك دون الحكم مال ولم تكن","https://www.aldiwan.net/poem5317.html","الطويل"],[61,"أنعته معصفر البردين","https://www.aldiwan.net/poem51418.html","الرجز"],[61,"إلام يروم الحاسدون نضالي","https://www.aldiwan.net/poem51479.html","الطويل"],[58,"جزى الله خيرا عصبة أسلمية","https://www.aldiwan.net/poem30877.html","الطويل"],[66,"شمول إلى نيرانها أبدا نعشو","https://www.aldiwan.net/poem38489.html","الطويل"],[66,"لو فرضنا أن الهدية لا تجمل","https://www.aldiwan.net/poem38702.html","الخفيف"],[66,"اليوم زعزع ركن المجد وانهدما","https://www.aldiwan.net/poem40121.html","البسيط"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"أي ندى بين الثرى والجبوب","https://www.aldiwan.net/poem30321.html","الرجز"],[44,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[87,"يدل على أن ليس في الدهر رحمة","https://www.aldiwan.net/poem8246.html","الطويل"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[33,"ألا أيها الشيخ الذي ما بنا يرضى","https://www.aldiwan.net/poem25891.html","الطويل"],[105,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[105,"مهلا بني الشرق لا تعطف بكم همم","https://www.aldiwan.net/poem43411.html","البسيط"],[81,"نفسي فدى موسى وإن لم تبق لي","https://www.aldiwan.net/poem61440.html","الكامل"],[102,"يقولون في بيروت أنتم بنعمة","https://www.aldiwan.net/poem32940.html","الطويل"],[102,"تحية لك يا مصر الفراعين","https://www.aldiwan.net/poem33034.html","السريع"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[39,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[52,"عذر الهوى عند العذول رشا","https://www.aldiwan.net/poem26895.html","الكامل"],[52,"تركت أخلاء كثيرا ذممتهم","https://www.aldiwan.net/poem27157.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[75,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[48,"أعاذل ما على وجهي قتوم","https://www.aldiwan.net/poem65091.html","الوافر"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[46,"إذا ما استهل الطفل قال ولاته","https://www.aldiwan.net/poem23036.html","الطويل"],[46,"ما أقبح المين قلتم لم يشب أحد","https://www.aldiwan.net/poem23380.html","البسيط"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39555","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9950","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55003","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54797","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43856","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43642","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43797","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29858","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142341","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9533","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[45,"مِثَالُكَ مِنْ طَيْفِ الخَيَالِ المُعَاوِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31687",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[53,"اترى السحاب اذا سرت عشراؤه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9808&r=&rc=5",""]],"verses":[["شَقَقنا بِها قَلبَ الظَلامِ وَفَوقَها","رِجالٌ كَأَطرافِ الذَوابِلِ ميلُ",0,"ل",1,0],["شَقيقي إِذا اِلتاثَ الشَقيقُ وَأَعرَضَت","خَلائِقُ قَومي جانِباً عَن خَلائِقي",1,"ق",2,0],["شَقِيَت مِنكَ بِالعَلاءِ الأَعادي","وَالمَعالي ضَرائِرُ الحُسّادِ",2,"د",1,1],["شَقيقَتي إِنَّ خَطباً","عَدا عَلَيكِ لَخَطبُ",3,"ب",1,0],["شُقَّت إِلَيهِ سُيوفُهُ وَرِماحُهُ","وَأُميتَ عَنهُ عَبيدُهُ وَإِماؤُهُ",4,"ا",3,0],["شَقَّت عَلى العَليا وَفاةُ كَريمَةٍ","شَقَّت عَلَيها المَكرُماتُ بُرودَها",5,"د",3,0],["شَقَقتُ بِصَدرِهِ مَوجَ المَناي","وَخُضتُ النَقعَ لا أَخشى اللَحاقا",6,"ق",2,0],["شُقّتْ على مَنعاهُ حُمْرُ قِبابِهِ","وشَقيقُهُ ألِفَ الذُّرى وبَهارُهُ",7,"ر",2,0],["شَقيّ أتَتْهُ منْ لدُنْهُ سَعادَةٌ","ومُنْكرُ قومٍ جاءَ بالحادِثِ النّكْرِ",8,"ر",1,0],["شقَّهُ الرّوحُ ثمّ طهّرَ منْهُ ال","قَلْبَ منْ بَعْدُ بالبَرودِ القَراحِ",9,"ح",1,0],["شَقَقتُ أَسواقَ بَيروتٍ فَما أَخَذَت","عَينايَ في ساحِها حانوتَ يوناني",10,"ي",1,0],["شَقَّ الشَقيقُ بِها مَلابِسَهُ","حُزناً عَلى ديباجَةِ الأُصُلِ",11,"ل",1,0],["شَقَقتُ دُجاها لا أَرى غَيرَ هِمَّتي","أَنيساً وَلا لي غَيرُ عَزمِيَ صاحِبُ",12,"ب",1,0],["شقاء تمطَى في العراق تمطّياً","وألفى جراناً لا يزحزح واستلقى",13,"ق",2,0],["شقِيَت بكم لما شَقِيتم أرضكم","فلها بكم ولكم بها غَمَرات",14,"ت",1,0],["شَقَقتَ مِنَ الفُراتِ مُبارَكاتٍ","جَوارِيَ قَد بَلَغنَ كَما تُريدُ",15,"د",1,0],["شَقَّ لَهُ مِنِ إِسمِهِ كَي يُجِلَّهُ","فَذو العَرشِ مَحمودٌ وَهَذا مُحَمَّدُ",16,"د",1,1],["شقيَ العذولُ على محاسنهِ","ونعمتُ في تعذيبهِ العذب",17,"ب",1,0],["شقَّ الأسى قلبي الصريع فيا له","بيتاً أبت سكناه غير مصرّع",18,"ع",1,0],["شقيقها في الحبِّ يا سيدي","ما كانَ في النعمان للنابغه",19,"غ",2,0],["شَقّاقُ ساجٍ يبيت ليلَتَهُ","منشارُه في مَشَقِّ ساجتِهِ",20,"ت",2,0],["شق بحراً من البحار وأرسى","جبلاً شامخاً يفوق الأنوقا",21,"ق",2,0],["شَقِيَ القَريضُ بِهِم وَما سَعِدوا بِهِ","لَولاهُمُ أَضحى مِنَ السُعَداءِ",22,"ا",2,0],["شَقِيَ الجَميعُ بِها وَعَزَّ ثَلاثَةٌ","ذِئبُ الفَلاةِ وَنَسرُها وَالأَجدَلُ",23,"ل",1,0],["شُقّوا الطُروسَ وَحَطِّموا أَقلامَكُم","اليَومَ يَومُ شَواجِرِ المُرّانِ",24,"ن",1,0],["شُقرٌ سَماوِيَّةٌ ظَلَّت مُحَلَّأَةً","بِرِجلَةِ التَيسِ فَالرَوحاءِ فَالأَمَرِ",25,"ر",1,0],["شقيت بالشعر في ناس أعوذ بهم","من أن يقول الأعادي شاعر الهمل",26,"ل",1,0],["شَقَّت لِمَنظَرِكَ الجُيوبَ عَقائِلٌ","وَبَكَتكَ بِالدَمعِ الهَتونِ غَواني",27,"ي",1,0],["شَقيتُم بِها مِن حيلَةٍ مُستَحيلَةٍ","وَأَينَ مِنَ المُحتالِ عَنقاءُ مُغرِبُ",28,"ب",1,0],["شَقَقتُ بِهِ الظَلماءَ أُدني عِنانَهُ","فَيَطغى وَأُرخيهِ مِراراً فَيَلعَبُ",29,"ب",1,0],["شقَّ النباتَ عنِ البتسانِ ريِّقُهُ","مُحَيّياً جارَهُ الميدانَ بالشجر",30,"ر",1,0],["شقَّتْ عليك جيوبَها شهَّاقَةٌ","برعودِها وسقتْك فيضَ الأدمُعِ",31,"ع",1,0],["شَقيقي أَبي إِسحاقَ نَفسي فِداؤُهُ","وَرَأسُ بَقايا كُلِّ حُرٍّ وَكاتِبِ",32,"ب",1,0],["شَقائِقُ يَحمِلنَ النَدى فَكَأَنَّهُ","دُموعُ التَصابي في خُدودِ الخَرائِدِ",33,"د",1,0],["شَقَقتُ مِنكَ قَفاً لِلصَفعِ دامِيَةً","صَفعاً تَظَلُّ عَلَيهِ نادِرَ الحَدَقَه",34,"ق",2,0],["شَقائِقاً مِن جِيادٍ غَيرِ مُقرِفَةٍ","كَما شَقَقتُ مِنَ العُرضِيَّةِ الطُرَرا",35,"ر",2,0],["شَقَقنا عَنِ الأَولادِ بِالسَيفِ بَطنَها","وَلَمّا تُجَلَّد وَهيَ يَحبو بَقيرُها",36,"ر",3,0],["شَقا شَقَّتَيهِ جَعفَرٌ بي وَقَد أَتَت","عَلَيَّ لَهُم سَبعونَ تَمَّت شُهورُها",37,"ر",3,0],["شَقينا وَماتَت قُوَّةُ الجَيشِ وَالَّذي","بِهِ تُربَطُ الأَحشاءُ عِندَ المَخاوِفِ",38,"ف",1,0],["شَقَّ حشاه عن شَقيقَتَيْنِ","أُخْتَيْنِ في القَدِّ شَبيهَتَيْنِ",39,"ن",1,0],["شَقْقتُ قَذَالَ الخَالديِّ بِمَنْطِقٍ","يَشُقُّ من الأَعْداءِ كلَّ قَذالِ",40,"ل",1,0],["شَقيقٌ وَعبَدُ اللَهِ بِشرٌ وَمَعبَدٌ","وَسُفيانَ وَاِبنا هاشِمٍ ذي المَكارِمِ",41,"م",1,0],["شَقيقَةُ خَدٍّ بِالسُرورِ مُدَرَّجٍ","بِها وَلِوَقعِ الماءِ في خَدِّها خَدشُ",42,"ش",1,0],["شَقَقنَ قُلوبَ الحادِثاتِ بِوَقعِها","وَشارَكَتِ الأَقدارَ أَقلامُهُ الرُقشُ",42,"ش",1,0],["شَقَّ هَذا عَلى المُقِلِّ وَلَكِن","مِن صِفاتِ الكِرامِ جَبرُ القُلوبِ",43,"ب",1,0],["شَقُّ الجُيوبِ بِلا شَقِّ القُلوبِ بِها","خُلقٌ ذَميمٌ لِمَن يَرعى لَها الذِمَما",44,"م",2,0],["شَقّوا بها جُنْحَ ليلٍ أليلٍ رَحَلوا","عن غُرّةِ الصبح من ديجوره غُمَما",45,"م",2,0],["شُقَّت جُيوبُ المعالي بالأسى وبكَتْ","في الخافقَينِ عليه الأنجمُ الزُّهرُ",46,"ر",1,0],["شَقَّ جُيوباً مِن رِجالٍ لَوِ اِسطا","عوا لَشَقّوا ما وَراءَ الجُيوبِ",47,"ب",1,0],["شَقَقتَ إِلى جَبّارِهِ حَومَةَ الوَغى","وَقَنَّعتَهُ بِالسَيفِ وَهُوَ مُقَنَّعُ",48,"ع",1,0],["شَقِيَّانِ هَامَا فِي الضَّلالِ فَأَصْبَحَا","دَرِيئَةَ لَعْنٍ مِنْ فَصِيحٍ وَأَعْجَمِ",49,"م",1,0],["شَقيقُ النَدى وَاِبنُ النُهى وَأَبو العُلا","وَحَسبُكَ بَيتاً في المَكارِمِ عالِيا",50,"ي",2,0],["شَقيتَ كَما أَشقَيتَني وَتَرَكتَني","أَهيمُ مَعَ الهُلّاكِ لا أَطعَمُ الغَمضا",51,"ض",2,0],["شَقينا بِالحَياةِ وَأَيُّ شَعبٍ","تَطيبُ لَهُ حَياةُ المُسلِمينا",52,"ن",2,0],["شَقَّ الصُفوفَ إِلى الحُتوفِ مُغامِراً","في الحَربِ يوقِدُها وَلَمّا تَخمَدِ",53,"د",1,0],["شَقّوا الجِواءَ فَلا بابُ السُّهى غُلُقٌ","وَلا السَبيلُ إِلى الجَوزاءِ مَسدودُ",54,"د",1,0],["شَقَّت ظُبى أَلحاظِهِ بَحرَ الهَوى","شَقَّ العَصا لِلصَبِّ كَي تُرديهِ",55,"ي",2,0],["شقيقتنا مهلاً متى كان نعمةً","هلاكُ أُلوف الناس في واحدٍ أثرى",56,"ر",2,0],["شَقوا القَناة عَساها عَنكَ تبعدني","أَني وَمِن لَهفتي جسر سَيُدنيني",57,"ي",1,0],["شَقوا الطَريق إِلى العُلا","وَخَطوا عَلى نَهج السَداد",58,"د",1,0],["شَقِيُّ بَعدَ عَبدِ بَني حَرامٍ","وَجَدِّكَ مَن تَكونُ بِهِ اليَدانِ",59,"ن",1,0],["شِقٌّ وَغَمغَمَةُ الأَغَرُّ وَعامِرٌ","عُمَداءُ أَهلُ لُهاً وَأَهلُ مَغارِ",60,"ر",1,0],["شَقَّ الظَلامَ البَدرُ حينَ بَدا","وَاِهتَزَّ غُصنُ البانِ حينَ مَشى",61,"ش",2,0],["شَقَقتُ لَهُ صَدري مِنَ السِرِّ إِنَّهُ","خِزانَةُ سِرٍّ أَعجَزَت كُلَّ فاتِحِ",62,"ح",1,0],["شُقَّ عَنْ قَلْبِهِ وأُخْرِجَ مِنْهُ","مُضْغَةٌ عِنْدَ غَسْلِهِ سوداءُ",63,"ا",2,0],["شُقَّ عَنْ صَدْرِهِ وشُقَّ لَهُ البَدْ","رُ وَمِنْ شَرْطِ كلِّ شَرْطٍ جَزاءُ",63,"ا",2,0],["شقيتَ بالبين من زور ألمّ بنا","وحاربتك بنو شيبانَ من رجل",64,"ل",1,0],["شَقّ الزمانُ لنا عن نورِ غُرّتِهِ","عن دولةٍ ما بها وَهْنٌ ولا سَقَط",65,"ط",1,0],["شُقِقتُ مِنَ الصِبا وَاِشتُقَّ مِنّي","كَما اِشتُقَّت مِنَ الكَرَمِ الكُرومُ",66,"م",1,0],["شَقَّ المُغيثَ لَنا نُعطى غَوارِبُهُ","مِنَ البَطائِحِ فيها الغارُ وَالعُشَرُ",67,"ر",1,0],["شَقيقُ مَن قامَت الصَلاةُ بِهِ","لَم يَأتِ بُخلاً وَلَم يَقُل كَذِبا",68,"ب",2,0],["شَقينا بِدُنيانا عَلى طولِ دُدِّها","فَدونَكَ مارِسها حَياتَكَ وَاِشقَها",69,"ق",3,0],["شَقَّت وَعَقَّت وَلَم أَحمُد وَلا حَمَدَت","ثُمَّ اِنصَرَفنا كِلانا سَيِّئُ الهِمَمِ",70,"م",1,0],["شقَقْتَ البحرَ مِن أدبٍ وفَهْمٍ","وغَرّقَ فكرُكَ الفِكْرَ الطّموحا",71,"ح",2,0],["شقيقان ما ائتلفا ساعة","وإِن لكل شقيق مراما",72,"م",2,0],["شقاءٌ عم هذا الناسَ حتى","تشكَّى الشيخ منه والوليد",73,"د",1,0],["شق الأثير بقوة","وَدَنا عَلى شحط المَزار",74,"ر",1,0],["شقيتَ بهم حيث ساد الغبيُّ","وخصَّوه بالسمعةِ النابهه",75,"ه",2,0],["شقيٌّ أجنَّته الدياجي السوادفُ","سليبَ رقادٍ أرَّقته المخاوفُ",76,"ف",1,1],["شَقَقتُ بِصَدرِهِ مَوجَ المَنايا","وَخُضتُ النَقعَ لا أَخشى اللَحاقا",77,"ق",2,0],["شَقِيَ ابنُ آدَمَ في الزّمانِ بِعَقلِهِ","إِنَّ الْفَضِيلَةَ آفَةُ الْعُقَلاءِ",78,"ا",2,0],["شُقَّتْ مَرَارتُهَا عَلَيْهِ وَأَوْشَكَتْ","مِنْ هَوْلِ ذَاكَ الخَطْبِ أَنْ تَتَصَدَّعَا",79,"ع",2,0],["شِقَّانِ مُؤْتَلِفَانِ تَسْبِكُ مِنْهُمَا","تَاجاً لِمِصْرَ أَنَامِلُ المِقْدَارِ",80,"ر",1,0],["شَقِيْقُ رُوْحِي مُنْذِرٌ","يَا لَيْتَنِي لَهُ فِدَى",81,"د",2,0],["شَقَائِقُ آيَاتِكَ النَّادِيَا","تِ رَحِيقاً مِنَ الأُُنسِ أَوْ كوْثَرا",82,"ر",2,0],["شقت مرائره أسى وتأوهاً","أن فاته الحسن الذى لم يخلق",83,"ق",1,0],["شقيت أمة إذا الجد ناداها","تلوت على الأسرة كسلى",84,"ل",2,0],["شَقَقتُ قَلبي كَمِثلِ ثكلى","فَفَنّدوني وَلَم يُحاشوا",85,"ش",3,0],["شَقَقتُ جُيوبَ الدَمعِ في الربعِ إِذ عفا","وَنادَيتُ ربعَ الأُنسِ ما لك موحِشا",86,"ش",2,0],["شَقوا بِالهَوى العذرِيِّ لَو سَعِدوا بِهِ","وَماتوا وَلَو داواهُم الوَصل عَيَّشا",86,"ش",2,0],["شُقتَ اللداتِ فَلَولا","تَزورُهُم أَو تُزارُ",87,"ر",1,0],["شَقّني فَقدُ أَبي حينَ أَودى","فَشَفى قَلبي وجودُ السَمِيِّ",88,"ي",1,0],["شُقِّقَت هذِهِ القُلوبُ لِمَنعا","كَ وَإِن لَم يُشَقَّ عَنهُنَّ مِسكُ",89,"ك",1,0],["شقَّ القُلوبَ وَشُقها","وَاِشرَق بِدَمعٍ وَريقِ",90,"ق",1,1],["شقَّتِ الشَمسُ عَلَيهِ جَيبَها","فَبَكى المزنُ مَعي وَالجيب شَق",91,"ق",1,0],["شَقيقَةَ نَفْسي بِالعَواذِلِ بَعْضُ ما","أُعانِي إِذا ناحَ الحَمامُ المُطَوَّقُ",92,"ق",1,0],["شق وشاح فجرها","خميلة وجدولا",93,"ل",2,0],["شقيتْ على أعتابكَ ال","غارات وانتحرت هوانْ",94,"ن",1,0],["شَقَّ الجَموعَ بِسَيفِهِ","وَشَفى حَزازاتِ الإِحَن",95,"ن",1,0],["شَقَقْتُ إِليكَ الطرْقَ والقَلْبُ خافِقٌ","تُراوِحُهُ آلامُه وتُباكِرُه",96,"ر",2,0],["شقَّتْ صفوف المعجبين بحسنها","وسَعَتْ إليك بخطوها المتهادي",97,"د",2,0],["شقَّ مجراه، وابتنى شاطئيه","بيديه مُهندس الأكوان",98,"ن",1,0],["شُقُّوا بمعتَرَك الحياة طَريَقكم","ليس النجاح لخامل بمتاحِ",99,"ح",1,0],["شُقَّ الفضاء بنورك المتجددِ","يا ليت شعري: ما تخبئُ في غدِ؟",100,"د",1,1],["شقّت على الأسماع أصداؤها","وهز فيها المشرقُ المغربا",101,"ب",2,0],["شقَقْتَ فِجاجَهُ لم تخْشَ تَيْهاً","ومَذْئَبةً ، وليلاً ، وانُفرادا",102,"د",2,0],["شَقَائِقُ يَحمِلْنَ النّدَى، فكأنّهُ","دُمُوعُ التّصَابي مِنْ خُدودِ الخَرَائِدِ",103,"د",1,0],["شقاء من تجبره مهينا","فكم اذكى بها نيران ظلم",104,"م",1,0],["شُقّتْ إلَيْهِ سُيُوفُهُ وَرِمَاحُهُ","واميط عنه عبيده وإماؤه",105,"ا",3,0]]}