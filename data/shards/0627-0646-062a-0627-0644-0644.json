{"poems":[[53,"مني الهجاء ومنك الصبر فاصطبر","https://www.aldiwan.net/poem64043.html","البسيط"],[87,"خطت يداك الروضة الغناء","https://www.aldiwan.net/poem8094.html","الكامل"],[50,"لا تفرغ النفس من شغل بدنياها","https://www.aldiwan.net/poem66198.html","البسيط"],[96,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=12695",""],[96,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""],[275,"هذا مليك القبة الزرقاء","https://www.aldiwan.net/poem35689.html","الكامل"],[318,"يا رب رأسي ضرني","https://www.aldiwan.net/poem59479.html","مجزوء الرجز"],[505,"إذا رأيت هلالا","https://www.aldiwan.net/poem37772.html","المجتث"],[567,"عليك كل اعتمادي أيها الصمد","https://www.aldiwan.net/poem52823.html","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80196","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27884","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114196","البسيط"],[5039,"كتمه","https://www.poetsgate.com/ViewPoem.aspx?id=48137",""],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5596,"رد على قصيدة حمزة بن عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=206717",""],[5977,"مهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=213120",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""],[6113,"انت اللي بالذات....!","https://www.poetsgate.com/ViewPoem.aspx?id=137097",""]],"verses":[["أنت اللئيم فإن تصبر فمن قحَةٍ","على الهوانِ وإن تجزع فمن خور",0,"ر",1,0],["أَنتَ اللِواءُ اِلتَفَّ قَومُكَ حَولَهُ","وَالتاجُ يَجعَلُهُ الشُعوبُ لِواءَ",1,"ا",2,0],["أَنتَ اللَئيمُ الَّذي لَم تَعدُ هِمَّتُهُ","إيثارَ دُنيا إِذا نادَتهُ لَبّاها",2,"ا",3,0],["أنت اللبانة في الجوانح لا النوار ولا الرباب","لك مهجتي وقبولها منك الهديّة والثواب",3,"ب",1,0],["أنت اللبانة في نجوى ضمائرها","وفيك عطّر جوّ السامر السّمر",4,"ر",1,0],["أنتَ اللَّطيفُ فَكُن به مُتَلَطِّفاً","كتَلَطُّفِ الأكفاء بالأكفاء",5,"ا",2,0],["أنتَ اللَّطِيفُ لِما تَشَاء","إنّكَ لَو شِئتَ سَكَن",6,"ن",1,0],["أَنتَ اللَّبيبُ إذا لمْ","ترَ الهِلالَ فَسَلِّمْ",7,"م",1,0],["أَنتَ اللَّطيفُ الخبيرُ المُستغاثُ بهِ","عندَ الخُطوبِ ومنك العَونُ والمَدَدُ",8,"د",1,0],["أَنتَ اللَطيف لَبِستَ أَلطَف حِلَّةٍ","أَنتَ الشَريف حَلَلتَ أَشرَف مَوضِعِ",9,"ع",1,0],["أنت اللسانُ وأنت الرِّجل أسعى بها","ولا أقول بأنَّ الناطقَ الساعي",10,"ع",2,0],["أنتَ اللَّطِيفُ الخَبِيرُ يَا لَطِيفُ أبِن","رُكناً مِنض اللُّطفِ فِينَا لَيسَ يَنهَارُ",11,"ر",1,0],["أنت اللقا دام المخاليق فرقا","وأنت النفس وألا أطيب الناس كتمه",12,"م",2,1],["أنت اللظى في رجفة","البرد الثقيل يُنعّمُ",13,"م",1,0],["أنت اللسان بغربة","وجعي بها متلعثمُ",13,"م",1,0],["أنت اللطيف الذي بادرت معتذراً","من هفوةٍ لم أقِلها ساعة العتب",14,"ب",1,0],["أنت اللطيف بأحبابٍ لنا سبقوا","فالطف بنا يا إله الكون ..آمينا",15,"ن",2,0],["أَنتِ الَّلظَى - \" لَيلَى \" - وَ لَكِنْ جَنَّتِي","مَهْمَا تَكَاثَرَتِ الذُّنُوبُ ظَلَلْتِ جَنَّهْ",16,"ن",2,0],["انت اللي بالذات من قلبي تمنيته","والنفس في حب غيرك عافت وعيّت",17,"ت",1,1],["انت اللي معطيه كل الروح واهديته","وحروف شعري غدت بظلالك تفيّت",17,"ت",1,0],["انت اللي والله من قلبي تمنيته","لاشفت حرفك تناشت روحي وحيّت",17,"ت",1,0]]}