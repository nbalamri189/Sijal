"https://www.poetsgate.com/ViewPoem.aspx?id=30190",""],[4959,"إِلَهِي أَقِلْ عَثْرَةَ الْعَاثِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=213980",""],[2177,"بنفسي من ناء عن الأهل مبعد","https://www.poetsgate.com/ViewPoem.aspx?id=127087",""],[585,"أتحسب سر الغيب طوعك بالذي","https://www.poetsgate.com/ViewPoem.aspx?id=161975",""],[5135,"\"تويترُ\"","https://www.poetsgate.com/ViewPoem.aspx?id=201950",""],[5213,"يقولون هذا الفنغراف الذي بدا","https://www.poetsgate.com/ViewPoem.aspx?id=170450",""],[2365,"رماك الدّهر بالخطب الجليل","https://www.poetsgate.com/ViewPoem.aspx?id=200653",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5331,"أنهد بن زيدٍ ليس في الخمر رفعة","https://www.poetsgate.com/ViewPoem.aspx?id=181486",""],[5358,"وقفتُ حزينَ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=187082",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5430,"تمهل","https://www.poetsgate.com/ViewPoem.aspx?id=1461",""],[5431,"العسل الشهي","https://www.poetsgate.com/ViewPoem.aspx?id=183001",""],[351,"نَالَتْ عَلَى يَدِهَا مَا لَمْ تَنَلْهُ يَدِي","https://www.poetsgate.com/ViewPoem.aspx?id=4528",""],[5459,"لزمنا الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190906",""],[5528,"مداعبة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=201113",""],[5704,"هديل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=191083",""],[5790,"سقاك يا دار هطال من الديم","https://www.poetsgate.com/ViewPoem.aspx?id=112138",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5858,"الشعر كذبه","https://www.poetsgate.com/ViewPoem.aspx?id=188075",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[6024,"الجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=186349",""],[4442,"يلوذ بركن بينك من يضام","https://www.poetsgate.com/ViewPoem.aspx?id=171202",""],[6093,"مِيْراثُ الجَمِيعِ","https://www.poetsgate.com/ViewPoem.aspx?id=185309",""],[6277,"فسل ميشال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64502&r=&rc=65",""]],"verses":[["فَكَم قائِفٍ قَد هَدَت لَحظَهُ","بُدورٌ مَناسِمُها في التُرابِ",0,"ب",1,0],["فَكَم قَد بَكَت عَيني عَلَيكِ وَعالَجَت","مُقاساةَ طولِ الليلِ بِالسُهدِ وَالذِكرِ",1,"ر",1,0],["فَكَم قَد رَأَينا ظالِماً مُتَمَرِّداً","يَرى النَجمَ تيهاً تَحتَ ظِلِّ رِكابِهِ",2,"ب",2,0],["فكمْ قدْ روَتْ عنّا بِها تِلكُمُ الرُّبَى","أحاديثَ شكْوَى سَلسَلَتْها المَدامِعُ",3,"ع",1,0],["فَكَم قيلَ عَن كَهفِ المَساكينِ باطِلٌ","وَكَم قيلَ عَن شَيخِ المَعَرَّةِ زورُ",4,"ر",1,0],["فَكَم قَتيلٍ باتَ فَوقَ الثَرى","يَنتابُهُ الأُظفورُ وَالمِنسَرُ",5,"ر",1,0],["فَكَم قَد قَصُرتُ اللَيلَ فيهِ بِزائِرٍ","تَجَشَّمَ أَهوالَ السُرى وَتَهَجَّما",6,"م",2,0],["فَكَمْ قَوَّمْتَ مِنْ أَوْدِ السَّجَايَا","بِرَأْيٍ مِنْكَ مُسْتَدٍّ قَوِيمِ",7,"م",1,0],["فكم قادحٍ في الدين يكفر ربَّه","قدحتَ له زند الحفيظة واريا",8,"ي",2,0],["فكم قلت بالتبر جُد مرّة","عليّ فقال ولا الدَّانق",9,"ق",1,0],["فَكَم قائِلٍ لَو كانَ ذا الشَخصُ نَفسَهُ","لَكانَ قَراهُ مَكمَنَ العَسكَرِ الدَهمِ",10,"م",1,0],["فكم قامحٍ عن لُجَّةِ الماء طامحٍ","إِلى الفجرِ ظنَّ الفجرَ بعضَ المشاربِ",11,"ب",1,0],["فَكَم قَد مَدَدنا مِن رَجاءٍ إِلى أَبي","عَلِيٍّ فَلَقَّتنا النَجاحَ مَخايِلُه",12,"ل",2,0],["فكم قد أراق به من دم","وكم قد أبان به من كلوم",13,"م",1,0],["فَكَم قَد رَأَينا الجامِعينَ قَدَ اِصبَحَت","لَهُم بَينَ أَطباقِ التُرابِ مَضاجِعُ",14,"ع",1,0],["فَكَم قَد عايَنَت عَينايَ سِتراً","مِنَ الديباجِ حُطَّ عَلى كَنيفِ",15,"ف",1,0],["فَكَم قَضَينا فيهِ شَملاً جامِعاً","وَكَم صَحِبنا فيهِ جَمعاً شامِلا",16,"ل",2,0],["فَكَم قَسَموا في الظنِّ أَميالَ أَرضِنا","أما كانَ فيهم منْ لبيبٍ له حِجْرُ",17,"ر",1,0],["فَكَمْ قُلوبٍ لها جاشَتْ مراجِلُها","لَمّا تَساقَطَ جَمْرُ الطَّعنِ في النُّقَرِ",18,"ر",1,0],["فَكَم قَد أَثَرنا مِن نَوالِكَ مَعدِناً","وَكَم قَد بَنَينا في ظِلالِكَ مَعقِلا",19,"ل",2,0],["فكمْ قائِلٍ لمّا رآها شوافِناً","أمَا تركوا ظَبياً بتَيماءَ أعفرا",20,"ر",2,0],["فَكَم قارَنَّ مِن رَأسٍ بِرِجلٍ","وَكَم أَلحَقنَ مِن قَدَمٍ بِراسِ",21,"س",1,0],["فَكَم قَطَعوا السَبيلَ عَلى ضَعيفٍ","وَلَم يُعفوا النِساءَ مِن الهُجومِ",22,"م",1,0],["فَكم قصَّرْتَ منْ عُمْرٍ طويلٍ","بهِ وأطلْتَ مِنْ عُمرٍ قَصيرِ",23,"ر",1,0],["فَكَم قَتيل عَلى الأر","ض مات بعد اِضطراب",24,"ب",1,0],["فَكَم قَد رَأَينا واجِداً بِحَبيبَةٍ","إِذا خافَ يُبدي بُغضَهُ حينَ يَظهَرُ",25,"ر",1,0],["فكم قبلةٍ يا ليلَ في ميعة الصبا","وقَبْلَ الهوى ليست بذاتِ معانِ",26,"ن",1,0],["فَكَمْ قُصُورٍ خَلَتْ وَكَمْ أُمَمٍ","بَادَتْ فَغَصَّتْ بِجَمْعِهَا التُّرَبُ",27,"ب",1,0],["فَكَم قَوم رَأَيتُ البُؤسَ فيهِم","وَكُنتُ أَرى لَهُم نعَماً عَراضا",28,"ض",2,0],["فكم قلدت يا صنعا البرايا","صنائع منه كالدر الكنين",29,"ن",1,0],["فكم قد روت عنابها تلكم الربى","أحديث شكوى سلسلتها المدامع",30,"ع",1,0],["فكم قد رأينا ظالماً متمرداً","يرى النجم رتيها تحت ظل ركابه",31,"ب",2,0],["فكم قلبوا الاعيان بالوهم خسة","وجهلا وصفوا في الحضيض الكواكبا",32,"ب",2,0],["فكم قيدت قلبي في هواهِ","وكم عيناي فيه تجريانِ",33,"ن",1,0],["فَكُم قَرمِ قَومٍ غادَرَتهُ مُجَدَّلاً","تَقُطُّ شَواهُ الخامِعاتُ العَواسِلُ",34,"ل",1,0],["فَكَم قَد رَأيتُم مِن عَقيلَةِ مَعشَرٍ","يَرُوقُ عُيُوناً فَرعُها وَقَوامُها",35,"م",3,0],["فكم قد رأينا مطاعا هنا","ك صار المذلل في المجلس",36,"س",1,0],["فَكَمْ قَدْ كُنْتُ صَيْدًا لِلْخطايا","وكَمْ قَدْ كُنْتُ في المُسْتَغْفِرينا",37,"ن",2,0],["فَكم قَهروا قوماً وكادَت نفوسهم","تُشاركَ ربَّ العرشِ في بطشهِ كِبرا",38,"ر",2,0],["فكم قد مَضَتْ من أُمَّةٍ إثْرَ أُمَّةٍ","وقَرْنٌ يليه بعد ذاك قرون",39,"ن",1,0],["فكَم قَرَّبنَ من أَمدٍ بَعيدٍ","تَعثَّرُ دونهُ الهمَمُ الكبارُ",40,"ر",1,0],["فكم قد روى إسنادَ ذلك مسلمٌ","حديثاً صحيحاً ينتهي لمحمّد",41,"د",1,0],["فكم قَطَفَت كفُّها زهرةً","وكانت لجارَتها ناثره",42,"ر",2,0],["فكم قيلَ لي أجِّل رَحيلَكَ يا فتى","لئن تَدُخلِ الدّنيا رَمَتك على عسر",43,"ر",1,0],["فَكَم قبلوا تربا وَكَم مسحوا ثرى","وَكَم وَضَعوا الصرا وَكَم فتحوا عقدا",44,"د",2,0],["فَكَمْ قَرَّبْتَ حَظِّي بَعْدَ نَأْيٍ","وَباعَدْتَ النَّوائِبَ بَعْد قُرْبٍ",45,"ب",1,0],["فَكم قَرع الأقوامُ من قبل مروتي","فشحّت ولم تطب بسقطٍ ولا شكبِ",46,"ب",1,0],["فَكَم قَد يَفوتُ المَرءِ خَيرَ واصِلِهِ","قَليلٌ مِنَ الإِهمالِ أَو مِن تَرَدُّدِ",47,"د",1,0],["فَكَم قَد كانَ ذا كَدٍّ وَجدٍّ","وَنَفع للكَبير وَلِلصَغيرِ",48,"ر",1,0],["فكم قد كَفى من وَقعةٍ بعدَ وَقْعةٍ","وغادَر من قَتْلَى يُخاض نَجيعها",49,"ع",3,0],["فكم قلتُ للعَيْن أَين النقابُ","وكم قلتُ للجيدِ أَين العقود",50,"د",1,0],["فكم قائلٍ لمّا تدَبّر والفتى","له خطَأٌ فيما يُرَى وصواب",51,"ب",1,0],["فكم قَطَّ سيفيَ من قَونَسٍ","غَداةَ التقينا ومن مَفرِقِ",52,"ق",1,0],["فكم قالَ رجالٌ لَي","تَ أنَّا لكَ صُلبانُ",53,"ن",1,0],["فَكَم قائل فيكَ اِنقِباض وَوَحشة","فَقُلت لَهُ لا بَل مِن الذَل أَهيب",54,"ب",1,0],["فَكَم قَد أَهانَت مِن عَزيز خُطوبِها","وَقَد كانَ بَدر التَم في أُفق المَجد",55,"د",1,0],["فَكَم قَتَلَ الهَوى صَباً","بِسَيف الصَد مِن قَبلي",56,"ل",2,0],["فكم قد أخربوا فيها وعاثوا","وكم قد أهلكوا دنيا ودينا",57,"ن",2,0],["فكم قد حبانا واجتبانا بفضله","وكم قد حمانا من شرور ذوى الظلم",58,"م",1,0],["فكم قد جادلي من غير قول","وكم خير حبا من غير تسآل",59,"ل",1,0],["فَكَم قَد دَعوني رافضيّاً لحبِّكُم","فَلَم يَثنني عَنكُم طَويلُ عدائِهم",60,"م",1,0],["فكم قلبٍ دعاه الحقُّ لكنْ","أبى أنْ يسمع القول الجميلا",61,"ل",2,0],["فكم قرصتني من عدًى بقوارص","هوابط من أرض المساوي شواخص",62,"ص",1,0],["فكم قد ابرزت شفتاه سبا","وناداك هلمي يا شقيّه",63,"ي",2,0],["فكم قلم هندي بدا في بنانه","يفاخر هنديا صقيلا إذا يسري",64,"ر",2,0],["فكَمْ قَدْ شَقَقْنَ سَلىً عن سَليلٍ","وأَجْهَضْنَ عن مُسْتَسرِّ الوِعاءِ",65,"ا",2,0],["فكَمْ قُدْتَ فِي أَكْنافِها من مُقَنَّعٍ","نُفُوسُ الأَعادِي شُرْبُهُ ومطاعِمُهْ",66,"م",2,0],["فكم قد آنست بربيب تخت","وغالته فآل بلا أنيس",67,"س",1,0],["فكم قد دعاكم للوئام وحثكم","عليه ولكن الخلاف عنيد",68,"د",1,0],["فكم قيل عنسي تجنى وزا","د وعنك ولا عجب قد فعل",69,"ل",1,0],["فكم قطعت قيود من حديد","لمحكوم عليه بط