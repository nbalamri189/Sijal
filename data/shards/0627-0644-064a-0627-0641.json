{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[369,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[866,"","https://poetry.dctabudhabi.ae/diwan/poem/198794","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124733","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201086","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[5198,"ملامح جنوني","https://www.poetsgate.com/ViewPoem.aspx?id=156355",""],[3216,"المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=28890",""]],"verses":[["إلى أُفُقٍ فيه من الروحِ هزَّةٌ","وفيه مِنَ الوحي القديمِ مَعاني",0,"ن",2,0],["إِلى أُفُقِيَّ الشَكلِ رَصَّعَ لَيلَهُ","كَواكِبُ فَذّ عاضَدَتهُ لَوائِم",1,"م",1,0],["إلى أفُقٍ تَربَّعَ فيه صَقر","قويّ الجُنح عَز عن اصطيادِ",2,"د",1,0],["إلى أفق السماء كذاك مالا","يحل ولا يطاق من المراقي",3,"ق",2,0],["الى آفل الحسن لي كل يوم","بتوديعه نظرة تسعر",4,"ر",1,1],["إلى أفقه السامي تنمى الفضائل","علا وفريد المدح في نعته غلا",5,"ل",2,0],["اليا فقدّتك يوم فزة ظنوني","كما يفز الجم من عد هداج",6,"ج",1,0],["إلى افق من الأشجان رحب","فاشفى ثم اشقى ثم اشقى",7,"ق",2,0]]}