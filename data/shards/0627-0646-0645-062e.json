{"poems":[[469,"إن مخدومنا الذي نرتجيه","https://www.aldiwan.net/poem3269.html","عموديه"],[804,"","https://poetry.dctabudhabi.ae/diwan/poem/73835","المديد"],[520,"يا ملكا صرف الزمان عبده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577483",""]],"verses":[["إن مخدومنا الذي نرتجيه","واسح الحال ضيق الأخلاق",0,"ق",1,1],["إِنَّ مَخزومِيَّكُم رَجُلٌ","أَلِفَ الأَعوادَ مِن صِغَرِه",1,"ه",1,1],["إن مخض الخطب فأنت زبده","أو حسن الذكر فأنت نده",2,"ه",1,0]]}