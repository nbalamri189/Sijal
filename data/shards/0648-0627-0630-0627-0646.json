081.html","الكامل"],[433,"قدر الأثير على الأثير علي","https://www.aldiwan.net/poem12765.html","الكامل"],[438,"صبح الجبين وليل شعرك قد غدا","https://www.aldiwan.net/poem2499.html","الكامل"],[438,"لي صديق من أبر الناس","https://www.aldiwan.net/poem2510.html","مجزوء الرمل"],[438,"لا تعجبي لمشيب نودي إنه","https://www.aldiwan.net/poem2593.html","الكامل"],[442,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[442,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[449,"يا من أدار بحسنه المعبود","https://www.aldiwan.net/poem53762.html","الكامل"],[450,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[459,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[460,"أشفارها أم صارم الحجاج","https://www.aldiwan.net/poem4032.html","الكامل"],[462,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[462,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[465,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[496,"قسما لقد عجم الزمان","https://www.aldiwan.net/poem9819.html","مجزوء الكامل"],[516,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[516,"يا دهر قد أكثرت في التلوين","https://www.aldiwan.net/poem12301.html","الكامل"],[530,"قد شققت الطبل والمزمار ما","https://www.aldiwan.net/poem37356.html","الرمل"],[530,"إن لي نفسا تسامىإن لي نفسا تسامى","https://www.aldiwan.net/poem37358.html","مجزوء الرمل"],[539,"أنا صب متيم ما حييت","https://www.aldiwan.net/poem48258.html","عموديه"],[552,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[552,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[552,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[552,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[552,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[552,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[552,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[552,"وما مرح الفتى تزور عنه","https://www.aldiwan.net/poem47893.html","الوافر"],[552,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[552,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[559,"لبس القميص أو القبا","https://www.aldiwan.net/poem34928.html","مجزوء الكامل"],[563,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[568,"وإذا نعنعت بنانك خطا","https://www.aldiwan.net/poem69724.html","الخفيف"],[570,"اتق الأحمق أَن تصحبه","https://www.aldiwan.net/poem51998.html","الرمل"],[576,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[576,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[587,"بتثني قوامك الممشوق","https://www.aldiwan.net/poem17628.html","الخفيف"]],"verses":[["وَإِذا نَبَت بِكَ في مُسالَمَةِ العِدى","أَرضٌ وَهَبتَ تُرابَها لِلقَسطَلِ",0,"ل",1,0],["وَإِذا نَظَرتُ إِلى الزَمانِ رَأَيتُهُ","تَعَبَ الشَريفِ وَراحَةَ المَشروفِ",1,"ف",1,0],["وَإِذا نَعِمتَ فَكُلُّ شَيءٍ مُمكِنٌ","وَإِذا شَقيتَ فَكُلُّ شَيءٍ عازِبُ",2,"ب",1,0],["وَإِذا نَظَرتَ إِلى المُحِبِّ عَرَفتَهُ","وَبَدَت عَلَيهِ مِنَ الهَوى آثارُ",3,"ر",1,0],["وَإذا نَزَلتَ لِيَمنَعوكَ إِلَيهُمُ","أَصبَحتَ عِندَ مَعاقِلِ الأَغفارِ",4,"ر",1,0],["وَإِذا نُقطَةٌ نَفَت أُختَها عَنهُ","فَكُلٌّ بِجُهدِهِ يَتَّقيهِ",5,"ي",2,0],["وَآذانِ خَيلٍ في بَراطيلَ خَشِّشَت","بُراهُنَّ مِنها في مُتونِ عِظامِ",6,"م",1,0],["وإذْ أنت مولاها وعامر ربعها","فكلُّ فخار تدعيه مُسَلَّمُ",7,"م",1,0],["وإذا نظرت إلى قلوب رجاله","فانظر حديد الطرف غير كليله",8,"ل",2,0],["وإذا نظرت الكائنا","ت بأسرها فهي السناية",9,"ا",3,0],["وإذا نظرنا في العجائب نظرةً","ظهر ابن آدم وهو منها الأغطم",10,"م",1,0],["وَإِذا نَزَلتِ مِنَ البِلادِ بِمَنزِلٍ","وُقِيَ النُحوسَ وَأُسقِيَ الأَمطارا",11,"ر",2,0],["وَإِذا نَظَرتُ يَريبُني مِن أُمِّهِم","عَينٌ مُهَجَّجَةٌ وَخَدٌّ أَسفَعُ",12,"ع",1,0],["وَإِذ أَنا لا مالٌ أُريدُ اِبتِياعَهُ","بِمالي وَلا أَهلٌ أَبيعُ بِهِم أَهلي",13,"ل",2,0],["وَإِذا نَبا بي مَنزِلٌ فارَقتُهُ","وَاللَهُ يَلطُفُ بي بِكُلِّ مَكانِ",14,"ن",1,0],["وَإِذا نَزَلنا بِالسَوا","جيرِ اِجتَنَينا العَيشَ سَهلا",15,"ل",2,0],["وَإِذا نَشا لَكَ ناشِئٌ ذو غِرَّةٍ","فَهُّ الفُؤادِ أَمَرتَهُ فَتَهَوَّدا",16,"د",2,0],["وإذا نظرت إلى البقاع وجدتها","تشقى كما تشقى الرِّجال وتسعد",17,"د",1,0],["وإذا ناظر خَصْماً","ذات يومٍ فألَدَّا",18,"د",2,0],["وإذا نظرتَ فإن أخلقَ منهما","لنِتاجِ مجدٍ جاحدٌ ومُنيلُ",19,"ل",1,0],["وَإِذا نَصَبنَ قُرونَهُنَّ لِغَدرَةٍ","فَكَأَنَّما حَلَّت لَهُنَّ نُذورُ",20,"ر",1,0],["وَإِذا نَسَبتَ اِبنَ الفُرَيعَةِ خِلتَهُ","كَالجَحشِ بَينَ حِمارَةٍ وَحِمارِ",21,"ر",1,0],["وَإِذا نِمنا تَراءَت في الكَرى","صُوَرُ الهَولِ وَأَشباحُ الفَناء",22,"ا",2,0],["وَإِذا نَبا العَيشُ الكَريمُ بِماجِدٍ","حُرٍّ رَأى المَوتَ الكَريمَ صَوابا",23,"ب",2,0],["وَإِذا نُمتُ كَي","يَطرُقَ الطَيفُ مَرقَدي",24,"د",2,0],["وَإِذا نَطَقتَ فَفي الجَوارِحِ نَشوَةٌ","هِيَ نَشوَةُ الروحِ اِرتَوَت بَعدَ الظَما",25,"م",2,0],["وَإِذا نَظَرتَ إِلى الجُسومِ عَلى الثَرى","أَبصَرتَ كُثباناً عَلى كُثبانِ",26,"ن",1,0],["وَإِذا نَظَرتُ وَجَدتُ بَعضَ هِباتِهِ","فيها المَفاخِرُ وَالمَآثِرُ وَالعُلى",27,"ل",2,0],["وَإِذ أَنا أَغيَدُ غَضُّ الشَبابِ","أَجُرُّ الرِداءَ مَعَ المِئزَرِ",28,"ر",1,0],["وإذا نظرت إلى القبور وجدتها","كفلول جيش في العراء مخيم",29,"م",1,0],["وإذا نحن عن علاك سكتنا","فستشدوا بذكرك الأيام",30,"م",1,0],["واذا نجوت فسوف اقطع كل ما","بيني وبين البحر من اوشاج",31,"ج",1,0],["واذا نحن نكصنا عنه لم","يك هذا النكص الا جبنا",32,"ن",2,0],["واذا نمت في قرارة رمسي","فمن الخير الجمّ ان لا افيقا",33,"ق",2,0],["وَإِذا نَظَرتَ إِلى الحَياةِ وَجَدتَها","عُرساً أُقيمَ عَلى جَوانِبِ مَأتَمِ",34,"م",1,0],["وإذا نَظَرْنَ رَمَقْنَ عَنْ مُقَلٍ","تَسْبِي الْعُيونَ فَحَشْوُهَا غُنْجُ",35,"ج",1,0],["وإذا نَزَعْنَ ثيابَهُنَّ تُرَى","فَوْقَ المُتُونِ ذَوائبٌ سُبْجُ",35,"ج",1,0],["وَإِذا نَظَرتَ إِلى الجِبالِ رَأَيتَها","فَوقَ السُهولِ عَواسِلاً وَقَواضِبا",36,"ب",2,0],["وَإِذا نَظَرتَ إِلى السُهولِ رَأَيتَها","تَحتَ الجِبالِ فَوارِساً وَجَنائِبا",36,"ب",2,0],["وإِذا نطقتَ بمحفِلٍ متحدّثاً","فهناك أَنْبَأُ من شَباةِ سِنانِ",37,"ن",1,0],["وإِذا نبا الوطنُ العسوفُ بأهلهِ","فظهورُهنَّ لمن حملنَ حُصونُ",38,"ن",1,0],["وَإِذا نَزَلتِ إِلى بِلادِكِ لَم تَزَل","تَجري كَواكِبُ أَهلِها بِالأَسعُدِ",39,"د",1,0],["وَإِذا نَظَرتَ رَأَيتَ فَوقَكَ دارِماً","في الجَوِّ حَيثُ تَقَطَّعُ الأَبصارُ",40,"ر",1,1],["وَإِذ أَنتُمُ مَن لَم يَقُل أَنا كافِرٌ","تَرَدّى نَهاراً عَثرَةً لا يُقالُها",41,"ل",3,0],["وإذ أنتَ في القُرِّ لا تَصطلي","نَشاطاً وفي الحَرِّ لا تَفْشَلُ",42,"ل",1,0],["وإذا نَبذْتُ إلى امرئٍ ميثاقَه","فليَستعِدَّ لسطوتي وعِقابي",43,"ب",2,0],["وَإِذا نادى رَسولُ ال","لهِ نَحوي قُلتُ إيها",44,"ي",3,0],["وَإِذا نَقِمتَ عَلى امرِئٍ","خُلُقاً فَجانِب ما نَقِمتا",45,"ت",2,0],["وَإِذا نَطَقتَ فَلا تَكُن هَذِراً","وَاِقصِد فَخَيرُ الناسِ مَن قَصَدا",46,"د",2,0],["وَإِذا نَظَرتَ إِلى أَسِرَّةِ وَجهِهِ","لَمَعَت كَلَمعِ العارِضِ المُتَهَلِّلِ",47,"ل",1,0],["وَإِذا نورُهُم ثَنى اللَيلَ صُبحاً","أَخَذوا ثارَ مَن ذُكي بِالمَذاكي",48,"ك",2,0],["وإذا نَظَرْتَ إلى غرائبِ سَقفهِ","أبصرتَ روضاً في السماء نضيرا",49,"ر",2,0],["وإذ أنْتَ محجوبُ السرادق لم يكن","له كلماتُ الدهر إلّا تهانيا",50,"ي",2,0],["وإذا نابكَ خَطْبٌ فَاقْرِهِ","بمهيبٍ فهوَ للإِسلامِ ناب",51,"ب",1,0],["وَإِذ أَنا مَمنونٌ عَلَيَّ وَمُنعَمٌ","فَأَصبَحتُ مِن خَضراءِ نُعماكَ مُنعِما",52,"م",2,0],["وإذا نعمةُ الظلومِ تداعتْ","لزوالٍ فاحذرْ منَ الذبِّ عنها",53,"ه",2,0],["وإذا نظرتَ إلى الخزامى يانعاً","قفْ وابْكِ منْ ذكرى الحبيبِ ومنزلِ",54,"ل",1,0],["وإذا نشأتُ خلالكم","فالوردُ بينَ الشوكِ ينبتْ",55,"ت",1,0],["وَإِذ أَنا غِرُّ أُجاري دَداً","أَخو لَذَّةٍ كَصَريعِ السَكَر",56,"ر",1,0],["وَإِذا نَظَرتَ إِلى مَناكِبِ حُسنِها","كَمُلَت وَزِدتَ بِحُسنِها اِستِهتارا",57,"ر",2,0],["وَإِذا نَظَرتَ إِلى المَمالِكِ لَم تَجِد","مِثلَ الثَباتِ عَلى الحَياةِ دَليلا",58,"ل",2,0],["وإذ أنزل الله النعاس فأمسكت","جوانح لولا الله ظلت نوازيا",59,"ي",2,0],["وَآذانٌ سَميعاتٌ","كَأَصنافِ الكَواريرِ",60,"ر",1,0],["وَإذا نَظَرْتَ إلى مواقِعِ نَقْشِها","في الطِّرْسِ قلتَ أَخِلَّةُ الرَّمَّامِ",61,"م",1,0],["وإذ أنا لم تنهض بجسميَ قوّة","وإذ لم يُبَلَّل من لساني ريق",62,"ق",1,0],["وإذا نَجا من فتنَةٍ الدّنيا امرُؤٌ","فكأنّما يَنجو من الطُّوفَانِ",63,"ن",1,0],["وإذا نظرتَ إلى الأسنّة نظرةً","ألقَتْ إليكَ الحرْبُ بالإقليد",64,"د",1,0],["وَإِذا نَظَرتَ وَجَدتَ مَطمَعَها","ماءَ السُؤالِ سِواهُ لَم تَجِدِ",65,"د",1,0],["وَإِذا نَسيبُكَ غُلَّ ساعِدُهُ","وَنَأى فَلَيسَ بِنافِعٍ نَسَبُه",66,"ب",2,0],["وَإِذا نَزَعتَ نَزَعتَ عَن مُستَحصِفٍ","نَزعَ الحَزَوَّرِ بِالرَشاءِ المُحصَدِ",67,"د",1,0],["وَإِذا نَحُن بِإٍجلٍ نافِرٍ","وَنَعامٍ خِيطُهُ مِثلُ الحَبَش",68,"ش",1,0],["وإذا نَبا بك منزلٌ","أو مسكنٌ فتحوَّلِ",69,"ل",1,0],["وإذا نَظرتَ إِلى محاسنِ وجههِ","أبصَرْتَ وجْهَكَ في سَناهُ غَريقا",70,"ق",2,0],["وإذا نحن لَذَّةَ العيش ذقنا","ها ومرَّت بنا فَدُرْ دورانكْ",71,"ك",1,0],["وإذا نَضَتْ عن مَتْنِها بُرْدَ الصِّبا","مَعْشُوقَةٌ فإلى الجَفاء تَؤولُ",72,"ل",1,0],["وإذا نَحنُ لَدَينا أَربَعٌ","يَهتَدي السَّائِلُ عَنَّا بِالدَّخَن",73,"ن",1,0],["وَإِذَا نَطَقْتُ فَإِنَّنِي","قُسُّ بْنُ سَاعِدَةَ الإِيَادِي",74,"د",2,0],["وَإذَا نَهَيْتَ عَنِ الْوُرُودِ عِطَاشَهُمْ","وَتَحَرَّقَتْ أَكْبَادُهُمْ لَمْ يَشْرَبُوا",75,"ب",3,0],["وَإِذَا نَظَرْتَ إلىَ الْحَقِيقَةِ صَادِقاً","فَالذِّكْرُ لَيْسَ يُعِيدُ عُمْراً يَذْهَبُ",75,"ب",1,0],["وَإِذا نلتهُ يَداً","قامَ بِالشُكرِ أَو جَزى",76,"ز",2,0],["وإذا نهضتَ كبا بوج","هك للجبين المَعطِس",77,"س",1,0],["وإِذَا نَجْمٌ بَدا مُؤْتَلِقٌ","شَخَصَتْ نحوَ سَنَاهُ مُقْلتَاها",78,"ا",3,0],["وإِذا نَهْضَةٌ تَدِبُّ بِمِصْرٍ","كَدَبيِبِ الْحَياةِ في الأبْدانِ",79,"ن",1,0],["وإِذا نزلتُمْ بالقُرى، فعليكم","دَينٌ ثقيلُ العبء للفلاَّح",80,"ح",1,0],["وإذ انتزَعْتَ زنادَهُ مُستَوريا","عن أيِ ثُكلٍ للمُواطِنِ تُنزَع",81,"ع",1,0],["وإذ أنتَ ترعاكَ عينُ الزمانِ","ويَهْفُو لجِرْسِكَ سَمْعُ الدُّنى",82,"ا",1,0],["وإذا نظرتَ رأيتَ ثَمَّةَ قارَباً","تَمتازُه بالضوء مِن قِنديله",83,"ل",2,0],["وإذا نَقُولُ الصّبْرُ يَحْجِزُهُ،","ألْوَى بصَبْرِ مُتَيَّمٍ جَزَعُهْ",84,"ع",2,0],["وإذا نزلت ببانياس فحيّها","عنّي وضمّ عبيرها الفوّاحا",85,"ح",2,0],["وَإذْ أنْتُمُ مَنْ لمْ يَقُلْ أنَا كَافِرٌ","، تَرَدّى، نَهَاراً، عَشْرَةً لا يُقالُها",86,"ل",3,0],["وإذا نظرتَ إلى مناكبِ حسنها،","كَمُلَتْ وَزِدْتَ بِحُسْنِها کسْتِهْتَارَا",87,"ر",2,0],["وإذا نظرت ففي جمي","ع البارزات اليك ناظر",88,"ر",1,0],["وإذا نبت بك في الزمان مواضعٌ","أو نابك الكمد ارحلنّ محذرما",89,"م",2,0],["وإذا نظمت الشعر قيل تكلف","وإذا أَدرت الكاس قيل حليع",90,"ع",1,0],["وإذا نثرتُ سمَت بلاغةُ خاطبٍ","وإذا نظمتُ علتْ فصاحةُ شاعرِ",91,"ر",1,0],["وَإِذا نَظَرتَ إِلى عَواقِبِ رَأيِهِ","أَيقَنتَ أَنَّ ظُنونَهُ تَتَنَجَّمُ",92,"م",1,0],["وإِذا نزلتَ بهم فساء صباحُهم","لا الوالدون بقوا ولا من أَولدوا",93,"د",3,0],["وَإِذا نَظَرتَ إِلى اِنهِلالِ يَمينِهِ","يَومَ النَوالِ رَأَيتَ فَيضَ غَمامِ",94,"م",1,0],["وَإِذا نَزَلتَ بِهِ أَنالَكَ ما حَوَت","كَفّاهُ مِن تِبرٍ وَمِن عِقيانِ",95,"ن",1,0],["وَإِذا نَظَرتَ إِلى فَصاحَةِ نُطقِهِ","أَلهاكَ عَن قُسٍّ وَعَن سَحبانِ",95,"ن",1,0],["وَإِذا نَظَرتُ إِلى أَميري زادَني","ضَنّاً بِهِ نَظَري إِلى الأَمُراءِ",96,"ا",2,0],["وَإِذا نَظَرتَ بِحَرِّ وَجهِكَ كُلِّهِ","نَحوَ اِمرِئٍ فَيَظَلُّ مِثلَ الغائِمِ",97,"م",1,0],["وَإِذا نَشَرتَ لَهُ الثَناءَ وَجَدتَهُ","جَمَعَ المَكارِمَ طُرفَها وَتِلادَها",98,"د",3,0],["وإذا نيسانُ عاطاكِ السلافا","وحنا شوقاً وتحناناً إليك",99,"ك",1,0],["وإذا ناجيتهِ لافُضَّ فوك","في سكون الليلِ يا ليلى لكَيلا",99,"ل",2,0],["واذا نحا نظم القريض اتى بما","عنه تكل خواطر الفصحاء",100,"ا",2,0],["وإذا نَوّمَني السُّكْ","رُ على تلك الهَيَات",101,"ت",1,0],["وَإِذ أَنا مِن وَصلِ الَّذي غَيرُ مُضمِرٍ","إِياساً وَعَن بابِ الهَوى غَيرُ مَطرودِ",102,"د",1,0],["وإذا نزلت بمصطفى الآمال","والرحب الرواق",103,"ق",1,0],["وَإذا نِمتُ عَن يَمينكِ سَهواً","أيقَظَتْني وَرقاءُ فوقَ أرَاكِ",104,"ك",1,0],["وإذا نظرت فلم تري شبحي","أو قبل غيّب في ثرى القبر",105,"ر",1,0],["وَأَذانٍ رُفِعَ الصوتُ به","حسنِ الترجيعِ موصولِ الصدى",106,"ا",1,0],["وَإِذا نحوتَ النحوَ كنت خليله","مُنسي به زجّاجه تزجيجه",107,"ج",2,0],["وإذانا نموت حيناً ونحيا","واذانا بموتنا احياء",108,"ا",2,0],["وَإِذا نَظَرت كِلَيهما بِتَأَمُّلٍ","أرّخته رَوضاً بَدا رَيحانهُ",109,"ن",2,0],["وإذا نظَرْتَ وأنت عارِفُ عِلّةٍ","لم تَعْيَ عن أن تَعرِفَ المَعلولا",110,"ل",2,0],["وإذا نَعَيْتَ على خليلٍ خَلّةً","في دينهِ فاهْجُرْه واحسِبْه نُعي",111,"ع",2,0],["وإذا نَظْرتَ إلى الحقائقِ لم تَجِدْ","ذا مَنْطقٍ لزمانه لم يَحْمَد",112,"د",1,0],["وإذا نظَرْتَ إلى القلوبِ فإنّما","أربابُها الأحبابُ لا الأرباب",113,"ب",1,0],["وَإِذا نَحنُ حَمَصنا بُدنَهُ","وَعَصَرناهُ فَعَقبٌ وَحُضُرْ",114,"ر",1,0],["وإذا نَظَرتَ لمُستَجِي","رٍ من صُروفِ الأَزمُنِ",115,"ن",1,0],["وإِذا نَظرتَ إِلى الصَّبابَةِ والأَسى","والصدِّ والشَّكوى رأيتَ فُروقا",116,"ق",2,0],["وإذ أنا آوي من عَزيزِ حِماكُم","إلى مَربعٍ رحبِ الفِناء مَريعِ",117,"ع",1,0],["وإذا نأى عَنِّي الرَّقيبُ تَمثَّلَتْ","ذِممٌ فأوهَمَتِ الرَّقيبَ قَريِبا",118,"ب",2,0],["وَإِذا ناقص أَرادَكَ بِالنَقصِ","ثَنى المجد رأيه مَنكوسا",119,"س",2,0],["وإذا نَهْنَهَ الدّموعَ استَجمَّتْ","وهَمَتْ وهي لُؤْلُؤٌ وعقيقُ",120,"ق",1,0],["وإذا نظرتَ إلى سناه ومجده","لنَظَرتَ من فلق الصَّباح عمودا",121,"د",2,0],["وإذا نهضتُ إلى الَّتي أنا طالب","في الدَّهر أقعدني الزَّمان خمولا",122,"ل",2,0],["وإذا نظرت إلى طويَّة ذاته","نظراً إلى المعروف والإِحسان",123,"ن",1,0],["وإذا نحا نحواً نحاهُ تخلُّفٌ","عنه وحاشى ذهنَهُ حوشيُّ",124,"ي",1,0],["وإذا نظمت قلائدي في وجهةٍ","راح الزمان لما أنظّم منشدا",125,"د",2,0],["وإذا نحن التقينا","ظاهرا في الجلوان",126,"ن",1,0],["وإذا نظرت إلى الزمان وجدتهُ","تعب الكريم وراحة للئيم",127,"م",1,0],["وإذا نزلتم منزلاً عوذوا به","وتباركوا بنشيده في المنزل",128,"ل",1,0],["وإِذا نصحت نصحت غير مخامر","وَإِذا ابتليت كسرت روق الناطح",129,"ح",1,0],["واذا نطقت فأنت مقصودى وان","أصمت فحين فناي في مقصودى",130,"د",2,0],["وإذا نهلت رحيق حبي صافي","فالكأس كأسي والعقار عقاري",131,"ر",2,0],["وإذا نزعتَ إلى أرومةِ مخصبٍ","زاكٍ فصنْ أغصانَها أن تُبذَلا",132,"ل",2,0],["وَإِذا نَظَرتَ لأَرضِها وَسَمائِها","لَم تُلفِ غَيرَ أَسِنَّةٍ وَزِجاجِ",133,"ج",1,0],["وإذا نهضت إلى العدى بعزائمٍ","فاحذر تمني الخفض أنْ لم تُنصر",134,"ر",1,0],["واذا نظرْتَ فكلُّ ما تحوي يَدٌ","فانِ وذِكْرٌ صالحٌ لبَقاءِ",135,"ا",2,0],["وإذا نزلت بهِ وقد شملت","شهباء حتف الحرث والنسل",136,"ل",1,0],["وإذا نقضت فلن أكو","ن لرشدتيّ ولا رشيدا",137,"د",2,0],["وإذا نظرت إلى الرزية كدرت","بقبيحها الماضي يد المستقبل",138,"ل",1,0],["وإذا نظرت إلى العطية منصفاً","قامت بعذر التائب المتنصل",138,"ل",1,0],["وإذا نظمت له النجوم فإنما","أجزي على المفروض بالمسنون",139,"ن",1,0],["وإذا نالَ الفَتَى مَكْرُمَةً","كانَ مِنْ ذاكَ لَدَيْهِمْ غُصَصُ",140,"ص",1,0],["وإذا نالَ غناءً","نالَهُ الغَيْرُ مَعاشا",141,"ش",2,0],["وإذا نكَّتَت أتَى الظَّرفُ واللُّط","فُ يوَدَّانِ أن تَزيدَ بتيت",142,"ت",1,0],["وإذا ناجاك مدحٌ","فاِطّرحْ عنّي كلامي",143,"م",2,0],["وإذا نظرتُ فليس لِي من بعد مَنْ","خُولستُهُ إلّا السوادُ المظلِمُ",144,"م",1,0],["وإذا نجوتَ السّوءَ في يومٍ به","كان الجزاءُ فإنّ كعبَك عالِ",145,"ل",1,0],["وإذا نطقتُ بغير مدح فضائلٍ","جُمعتْ لكمْ فكأنّني لم أنطِقِ",146,"ق",1,0],["وَإذا نكّبت وجوهُ أُناسٍ","عن سبيلَيْ رعايةٍ ودفاعِ",147,"ع",1,0],["وَإِذا نَجونا من خطوبِ مُلِمَّةٍ","عرضت لنا تأتي نيوبُ نواهسِ",148,"س",1,0],["وإذ أنا في حُبّ القلوب محكَّمٌ","وأفئدة البيض الكواعب في أسري",149,"ر",2,0],["وإذا نصحتُ لكمْ فما ألْوي على","ما شفّني أو فتّ في أعضادي",150,"د",2,0],["وَإِذْ أَنا من بَطالاتِ التَّصابِي","ونَشواتِ الغواني غيرُ صاحِ",151,"ح",1,0],["وإذا نُكبتَ فلا تشك","كّ فطالما دهراً وُقيتا",152,"ت",2,0],["وَإِذا نَظرت إلى الحِما","مِ فَما لِعَينك مِن غطاء",153,"ا",2,0],["وإذا نسبت لأمره","لا أم صرت ولا أبا",154,"ب",2,0],["وإذا نظرتَ فعن شِهابٍ ثاقبٍ","وإذا فَكَرْتَ فعن حُسامٍ قاضبِ",155,"ب",1,0],["وإذا نَعْنَعْتُ بنانُكَ خَطًّا","مُعْرباً عن بلاغَةٍ وسَدَادِ",156,"د",1,1],["وإِذا نهنهته كي يرعوي","زاد جهلا وَتَمادى في الحمق",157,"ق",1,0],["وَإِذَا نَظَرتَ إِليَّ أَكْمَدْ","تَ المناضِلَ وَالمُناظِر",158,"ر",1,0],["وإِذا نَظرتَ مِن العُفَاةِ لمصْفَدٍ","مِنه نظرتَ مِن الْعِدا لِمُصَفَّد",159,"د",1,0],["وَإِذَا نَقَّطَت دُموعِي غِنىً","مَا عَهِدْنا كَذَا بُكَاءَ المَشُوقِ",160,"ق",1,0]]}