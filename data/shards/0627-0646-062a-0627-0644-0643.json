{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[87,"أنت الكبير على المدى","https://www.aldiwan.net/poem7272.html","مجزوء الكامل"],[87,"ملك السماء بهرت في الأنوار","https://www.aldiwan.net/poem63717.html","الكامل"],[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[47,"طيف ألم فحيا عند مشهده","https://www.aldiwan.net/poem62737.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[53,"لا يُعدمُ اللهُ يديك الصَّولا","https://www.poetsgate.com/ViewPoem.aspx?id=30269",""],[113,"يابن الكرام الأولى شادت عزائمهم","https://www.aldiwan.net/poem16207.html","البسيط"],[113,"علياك في جسم المكارم روح","https://www.aldiwan.net/poem16213.html","الكامل"],[192,"اصعد بعزمك إن المجد متصل","https://www.aldiwan.net/poem35678.html","الكامل"],[255,"شرفت بنظم مديحك الأشعار","https://www.aldiwan.net/poem14954.html","الكامل"],[261,"يا بدر يا بدر التمام","https://www.aldiwan.net/poem48353.html","مجزوء الكامل"],[438,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[438,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[466,"آبي الهضيمة شهم من بني مضر","https://www.aldiwan.net/poem15132.html","البسيط"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[520,"يا رب هيئ لنا من أمرنا رشداً","https://www.aldiwan.net/poem12090.html","البسيط"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[567,"دعوت جنح الدجى مولاي مبتهلا","https://www.aldiwan.net/poem52736.html","البسيط"],[567,"عليك كل اعتمادي أيها الصمد","https://www.aldiwan.net/poem52823.html","البسيط"],[567,"لك الهناء بما أوتيت معتذرا","https://www.aldiwan.net/poem52962.html","البسيط"],[567,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198596","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110405","البسيط"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/113000","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122352","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80234","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64738","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112856","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108695","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96493","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132303","الرجز"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114754","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109287","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102552","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130070","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68022","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67976","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110021","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132107","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135231","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135159","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70148","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77076","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135113","البسيط"],[4691,"نهرية العينين","https://www.poetsgate.com/ViewPoem.aspx?id=137740",""],[4728,"ابتهالات لله","https://www.poetsgate.com/ViewPoem.aspx?id=176966",""],[4767,"أنت الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=178889",""],[4767,"ثامن الحُجَج","https://www.poetsgate.com/ViewPoem.aspx?id=214501",""],[5079,"لك المحامد","https://www.poetsgate.com/ViewPoem.aspx?id=178384",""],[5111,"فِي لُجِّ الْغِيَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=212357",""],[5136,"بما أكافيك يا ابن الشم يا ملك","https://www.poetsgate.com/ViewPoem.aspx?id=121642",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5174,"أُمَّ الْبَيَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188618",""],[5183,"المستميت على الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=180173",""],[5187,"يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=37394",""],[5277,"البوحُ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=191377",""],[5442,"ذاك الفراق وان أصم مسامعي","https://www.poetsgate.com/ViewPoem.aspx?id=114744",""],[5516,"من أجل من يارسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=212477",""],[5574,"الدرّتان","https://www.poetsgate.com/ViewPoem.aspx?id=206039",""],[5612,"موْلايَ في ذُلّي إليْكَ تَحَرُّري","https://www.poetsgate.com/ViewPoem.aspx?id=179434",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5720,"مناجاة ..","https://www.poetsgate.com/ViewPoem.aspx?id=198823",""],[5720,"صباح النور","https://www.poetsgate.com/ViewPoem.aspx?id=199306",""],[5720,"رحلَ المليكُ (*)","https://www.poetsgate.com/ViewPoem.aspx?id=203028",""],[5725,"الى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=203570",""],[5847,"في ظلال ميلاد النبي محمد صلى الله عليه وسلم 1431","https://www.poetsgate.com/ViewPoem.aspx?id=52777",""],[5956,"النِّدُّ للند","https://www.poetsgate.com/ViewPoem.aspx?id=193481",""],[520,"يا رب هيئ لنا من امرنا رشدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577495",""],[6191,"مواوِيل الخلاص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88102&r=&rc=0",""]],"verses":[["أَنتَ الكَرى مُؤنِساً طَرفي وَبَعضُهُمُ","مِثلُ القَذى مانِعٌ عَيني مِنَ الوَسَنِ",0,"ن",1,0],["أنت الكبير على المدى","فاربأ بنفسك يا رياض",1,"ض",1,1],["أَنتَ الكَريمُ عَلى الوُجودِ بِوَجهِهِ","وَهيَ الضَنينَةُ بِالخَيالِ الساري",2,"ر",2,0],["أَنتَ الكَبيرُ يُقَلِّدو","نَكَ سَيفَ عُثمانَ الكَبير",3,"ر",1,0],["أَنتَ الكَريمُ وَقَد قَدَّمتَ مُبتَدِئاً","وَعداً وَكُلُّ كَريمٍ عِندَ مَوعِدِهِ",4,"د",2,0],["أَنْتَ الكَرِيمُ ابنُ الكِرَا","مِ المُزْدَهِي بِكَ عُنْصُرَاكْ",5,"ك",1,0],["أنْتَ الكتابُ كتابُ الدهر أسطرُهُ","وَعَتْ حوادثَ هذا الكون تدوينا",6,"ن",2,0],["أنت الكريم ليس فيه لوْلا","قد أصبح الخيرُ عليه استولى",7,"ل",2,0],["أَنتَ الكَبير الَّذي لا العَزل يُنقِصُهُ","قَدراً وَلا المَنصب العالي يُشرِفُهُ",8,"ف",2,0],["أَنتَ الكَريم اِبن الكَريم وَمَن لَهُ","عَفو عَن الذَنب العَظيم صَفوحُ",9,"ح",1,0],["أنتَ الكريمُ بِلا منّ ٍ ولا هدَفٍ","والجُودُ فيكَ أصيلٌ ليس يُفْتَعَلُ",10,"ل",1,0],["أنتَ الكريمُ وخلِّ ما قد أنبأَت","عمن مضى في كُتبِها الأَخبَارُ",11,"ر",1,0],["أنت الكريم فهب لنا","هذا الكريم من الكرام",12,"م",1,0],["أَنتَ الكريمُ وقد قالَ الأُلى مَثَلاً","إِنَّ الكِرَامَ إذا ما استُعْطِفُوا عَطَفوا",13,"ف",3,0],["أنت الكليمُ وقد أوتيتَ آيتَه","كم من يدٍ لك في الأقوامِ بيضاء",14,"ا",2,0],["أنت الكميُّ فلا جُبْنٌ ولا جَزعٌ","وذو السّماحِ فلا مَنٌّ ولا سرفُ",15,"ف",1,0],["أنت الكمال الذي اعتز الهلال به","قل زادك الله إعزازا وتكميلا",16,"ل",2,0],["أنت الكريم وقد جهزت يا أملي","إلى أياديك وجهاً سائلاً ويدا",17,"د",2,0],["أَنتَ الكَليم وَهَذا طَور حَضرتهم","أَقبل وَلا تَخف الواشين بِالكَلمِ",18,"م",1,0],["أنت الكريمُ الذي من فضلِ نِعمتِهِ","يُرجَى العطاءُ وأمَّا مِن سِواكَ فلا",19,"ل",2,0],["أَنتَ الكريمُ الذي من لُطفِهِ سَنَدٌ","لكلِّ عبدٍ ضعيفٍ ما لهُ سَنَدُ",20,"د",1,0],["أنتَ الكريمُ الذي طالتْ مواهبُهُ","على العُفاةِ ولكن وَعدُهُ قَصُرا",21,"ر",2,0],["أَنتَ الكَرامَةُ وَاِبنُها وَأَبٌ لَها","نَسَبٌ كَريمٌ في الكِرامِ عَريقُ",22,"ق",1,0],["أنت الكريم فما أبقت لنا عوضا","كفُّ المنية بين النَّاس كُلهم",23,"م",1,0],["أنتَ الكريمُ الذي طابت شمائلهُ","عن طيب أصلٍ كريمٍ في الكرام سما",24,"م",2,0],["أنت الكريم ومن وافاك مفتقراً","فهو السعيد بنيل السؤل والأمل",25,"ل",1,0],["أنت الكريم وجد مثلي عاثر","فاقل عثاري فالكريم مقيل",26,"ل",1,0],["أَنتَ الكِرامُ وَبِاِسمِهم تُدعى وكَمْ","بِاِسمِ الجُموعِ تَسمَّتِ الأَفرادُ",27,"د",1,0],["أَنتَ الكَريمُ الَّذي فاضَت مَواهِبُهُ","فَاطمع الدَهر حَتّى ثارَ لِلسَلبِ",28,"ب",1,0],["أنتَ الكريمُ له الأَكارمُ سُؤَّلٌ","أَنتَ المليكُ لهُ الملوكُ عِبادُ",29,"د",1,0],["أنت الكريم الماحي مصباح الدجى","نور الحجا المختار غوث المقتدى",30,"د",2,0],["أنت الكريم فجد به لمقصرٍ","لو ذاق راحَ لَماكَ سابق قيصرا",31,"ر",2,0],["أنت الكريم الفتى لا شيء يشبهه","لا عيب منك سوى أن قيل من بشر",32,"ر",1,0],["أنت الكريم والكريم يعطي","ولا يبالي يا كريم معطي",33,"ي",1,0],["أنتَ الكرى مُؤنساً عيني وبعضُهُم","مثلُ القَذى مانعاً عيني من الوَسَنِ",34,"ن",1,1],["انت الكريم وما عداك فكل ذي","كرم بفضلك في الورى متباهي",35,"ي",1,0],["أنت الكريم إذا ذكرن مكارم","طبعاً إذا بات الكرام نياما",36,"م",2,0],["أنت الكريم تعفُّ عن إيذائهم","نُبلاً وإِحساناً وعفواً وافيا",37,"ي",2,0],["أنت الكريم فلا تخيب سائلا","حاشاك ياملجا الورى حاشاكا",38,"ك",2,0],["أنت الكفيلُ فَدُمْ كذاك مؤمِّلاً","مَا زلتَ تفتق بالزمان وَتَرْتُق",39,"ق",1,0],["أنت الكفيلُ لَهَا مَا إِن لَهَا وَزَرٌ","فمن يكنْ بحِماك الدهرَ لَمْ يَخَفِ",40,"ف",1,0],["أنت الكفيلُ لذا الزمانِ وأهلِهِ","وزعيمُه ولواءه المَعْقُود",41,"د",1,0],["انت الكبيرُ وذا الصغيرُ وانما","فضلُ الكبيرِ على الصغيرِ تَرَفُّقُ",42,"ق",1,0],["أنت الكريم وقل مثلك في الورى","صدق السموأل فالكرام قليلُ",43,"ل",1,0],["أنت الكريم ولا للكون أجمعه","ربٌّ سواك ولو عصوا وقد جحدوا",44,"د",3,0],["أنت الكراء على المعال توصلن","أنت الأنيس لكل شبح واحش",45,"ش",1,0],["انتَ الكريمُ وَشأني فيكَ رفعتُهُ","انتَ الامين على من خيرهم اربي",46,"ي",1,0],["أَنتَ الكَريمُ الَّذي تَكسو بَشاشَتَهُ","عَطف النَزيل بِما يُغَنّي عَنِ الحَلل",47,"ل",1,0],["أنت الكريم ونجل المكرمات ومن","قد شاع في فضله والفضل منه لنا",48,"ن",2,0],["أنت الكلام مسافر بسمائي","أنت الحنين وبيته أضلاعي",49,"ي",1,0],["أنت الكبير المُتكبّر من أعاد ومن أباد","أنت المزيد لمن شكر وأنت السميع لمن حمد",50,"د",1,0],["أنت الكريم على عبادك ما أتوا","من بعد ما ردتْهم البخلاء",51,"ا",2,0],["أنت الكريم على اللئيم ونحن في","جنب الذي أعطيتنا لؤماء",51,"ا",2,0],["أنتَ الكريم لِمَن أتاك وسيدٌ","يرقى به التهليلُ والتحميد",52,"د",1,0],["أنت الكريم إذا ماجئت أسألهُ","وأنت أرحم بي من كل إخواني",53,"ي",1,0],["أنتِ الكواثِرُ سَائغٌ تسْنِيمَهَا","شلاَّلُ شَهْدٍ فِي فمِيْ يَتقطَّرُ",54,"ر",1,0],["أنت الكريم الذي من لج زاخره","التيار يسبح فلك الفخر والملك",55,"ك",1,0],["أنت الكريم بن الكريم أرومة","من رام شأو علاك عاد حسيرا",56,"ر",2,0],["أَنْتِ الْكَرِيْمَةُ مَالَهَا مَثَلٌ","فَكِتابُ رَبِّيَ مِنْكِ مُسْتَطَرُ",57,"ر",1,0],["أنت الكمي الذي ما هان صاحبه","عند النزال ولو لم يدخر قضبا",58,"ب",2,0],["أنتِ الكِتابُ ونَحنُ فَوقَ سُطورِهِ","مِن وَحيه تَتَعلّمُ الأحفادُ",59,"د",1,0],["أنت الكؤوس وروضي العمر يرشفها","وأنت نشوتها.... بل أنت ساقيها",60,"ي",3,0],["أنت الكريم وليس سعي مقصر","في سعيد عند الكريم بضائع",61,"ع",1,0],["أنت الكريمُ عظيمُ الخُلق ِ في يدِه","كلّ الكراماتِ من ربِّ الكراماتِ",62,"ت",1,0],["٥- أنتَ الكريمُ أَسَرْتَ النّبْضَ قاطِبةً","أنتِ المُنى قدْ منحْتِ الحُبَّ إِكبارا",63,"ر",2,0],["أنتَ الكريمُ المسْتعانُ وذو الغِنى","كم ذا تجودُ بِأنْعُمٍ وأيادي",64,"د",2,0],["أنت الكريمُ.. فدعْ نوازعَ مَكرهمْ","تابعْ.. وكفكفْ بالتّوٓكُّلِ مدْمٓعٓكْ",65,"ك",1,0],["أنتَ الكريمُ الذي تزدادُ مِنَّته","حتىٰ لمن يفتري جُرماً وإشراكا",66,"ك",2,0],["أنتَ الكريمُ لمَنْ دعا","كَ وفي نَداكَ تَعَلَّقَا",67,"ق",2,0],["أنت الكريمُ لكلِّ شعبك باذلٌ","فلأنتَ للغيثِ العميمِ نسيبُ",68,"ب",1,0],["انت الكبير كبيرات منورة","امجاده وعليّات كواكبهُ",69,"ب",2,0],["أنت الكتاب وحق ربك ناطق","بالحق كيف نطقت كنت صراحا",70,"ح",2,0],["أنت الكريم أنا اللئيم نفختني","مثل الجبال فلا تلُم منفوخكا",71,"ك",2,0],["أنت الكريم وقد جهزت من أملي","إلى أياديك وجهاً سائلاً ويدا",72,"د",2,0],["أنتَ الكَلامَاتُ ، والمَنذُورُ أسئِلةً","تئزِ جوفكَ شكَّاً لاسِعاً، صهَدَا",73,"د",2,0]]}