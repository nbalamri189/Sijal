حتى استقلَّت بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=206284",""],[5956,"الله يحاسبُ لا تكنْ حشرِيّا","https://www.poetsgate.com/ViewPoem.aspx?id=184329",""],[6019,"رثاءٌ لا يكفي لوعةَ الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=175386",""],[6070,"كَتبتُ قافيتي والسَّعدُ في حَدقي","https://www.poetsgate.com/ViewPoem.aspx?id=189053",""],[6070,"كُنْ واثقا بالله دوماً صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=194509",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[6142,"أمريضا بالسير بنت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=155735",""],[6142,"حاملٌ بين جمرتي شفتيه","https://www.poetsgate.com/ViewPoem.aspx?id=155685",""],[6152,"العشق داء يصرع","https://www.poetsgate.com/ViewPoem.aspx?id=203174",""],[3477,"صار التصرف صرفا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612716",""],[6189,"السابحون في منطقة انعدام الوزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83549&r=&rc=16",""],[6189,"قصيدة عن حب قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67119&r=&rc=4",""]],"verses":[["دَعها فَقَد أَعذَرتَ في حُبِّها","وَاِذكُر خَنا عَلقَمَةَ الفاجِرِ",0,"ر",1,0],["دَعها وَسَلِّ طِلابَها بُجَلالَةٍ","إِذ حانَ مِنكَ تَرَحُّلٌ وخُفوفُ",1,"ف",1,0],["دَعهُ وَهَذا البازُ فَاِطَّرِد بِهِ","تَفادِياً مِن غَمِّهِ وَعَتبِهِ",2,"ه",1,0],["دعها ومدمعها الجاري فقد لقيت","ما قدمت من أذى قلبي وما عملت",3,"ت",1,0],["دع هلالاً لاحَ أو غصناً تثنى","وامْتدح مفرد وقت ما تثنى",4,"ن",2,1],["دَعَة الواثقين أوجبُ حقاً","من هُويِّ الحُراص فوقَ الرمالِ",5,"ل",1,0],["دَعهُ وَحَولِيّاتِهِ ثُمَّ اِستَمِع","لِزُهَيرِ عَصرِكَ حُسنَ لَيلِيّاتِهِ",6,"ت",2,0],["دَعها وَسَلِّ الهَمَّ عَنكَ بِجَسرَةٍ","تَنجو نَجاءَ الأَخدَرِيِّ المُفرَدِ",7,"د",1,0],["دَعهُم وَما اِختاروا لِأَنفُسِهِم","فَاللَهُ بَينَ عِبادِهِ يَقضي",8,"ض",2,0],["دَعهُم فَما كُلُّ الأَشِد","دَةِ لِلشَدائِدِ تُخبَأُ",9,"ا",1,0],["دعها تعبُّ سناكَ فه","يَ شقيةٌ لم تنهلِ",10,"ل",1,0],["دَعهُ يَحظى لَدى الأَنامِ بِشِعري","وَقَصيدي فَذاكَ أَهوَنُ بابِ",11,"ب",1,0],["دَعْهُ ونتفَ العذارِ إذْ ما","يسَّرَ وصلي حتى تَعذَّرْ",12,"ر",1,1],["دَعْها أُسيْرُ لكَ الويلاتُ من رجلٍ","ضَلَّ السَّبيلَ فأمسى يَركبُ الغَررَا",13,"ر",2,0],["دعه فإنّ له بمكةَ مشهداً","يُرضيكَ والشهداءُ حولكَ تُطرَحُ",14,"ح",1,0],["دَعهُ وَما قالَ فَما","يَزرَعُ يَوماً يَحصُدُه",15,"ه",1,1],["دَعهُنَّ لِلمُسهَبِ الضَلّيلِ مورِدُهُ","ياقَلبُ كُلُّ اِمرِئٍ رَهنٌ بِما اِكتَسَبا",16,"ب",2,0],["دَعَةٌ لِمِثلِكَ تَركُ دَعدٍ لِلنَوى","وَسَعادَةٌ لَكَ هِجرَةٌ لِسُعادِ",17,"د",1,0],["دَعهُم فَكَم قُطِّعَت رِقابُهُمُ","جَدَعاً وَلَم يَشعُروا وَلا أَبَهوا",18,"ه",3,0],["دعه يناج القلب منه إنه","متأَلم يشكو إلى متألم",19,"م",1,0],["دعْهُم فأنتَ سَخِرْتَ من أحلامهم","وأطرتُهُنَّ مع الرياحِ بدادا",20,"د",2,0],["دَعْهُمَا وَاذكُرِ البَنِينَ لَقَد عا","شَ فَقِيدٌ بِوُلْدِهِ مَذْكُورُ",21,"ر",1,0],["دَعهُ يُكَفّيكَ شاهِداً لي","في مَوقِفِ الوَعدِ وَالوَعيدِ",22,"د",1,0],["دعْها تُكاثر بالذي","أسدَوْا نَعَمْ دَعْها تُكاثرْ",23,"ر",1,0],["دعهم في المخازي والتكذيب اني","متنبي الدنيا بلا تكليف",24,"ف",1,0],["دعهم اخي ورح بالله مشتغلا","فهو المعين وما في الناس اعوان",25,"ن",1,0],["دعه اخيّ خائضا","يجزى غدا بما فعل",26,"ل",1,0],["دعهم ومل أنت عنهم ميل ذي مقة","واحرص وإن غيروا الأسماء من ندم",27,"م",1,0],["دَعهُ لِأَحداثِ الزَمانِ دَرِيَّةً","أَتُراهُ يُكرِمُ مَن هَواكَ هَوانُهُ",28,"ن",2,0],["دَعها وَسَلِّ طِلابَها بِجُلالَةٍ","عَيرانَةٍ كَالفَحلِ حَرفٍ عِرمَسِ",29,"س",1,0],["دعها وخفها وبادر ولتكن حذراً","أدنى خطاك إذا فارقتها حلبُ",30,"ب",1,0],["دَعهُ لا تحفَل بهِ مَهما جفا","وَغدا في القولِ أذكى فطنِ",31,"ن",1,0],["دعها لتَخرُجَ بي إلى دنيا المنى","من عالمِ الأطماعِ والتنكيد",32,"د",1,0],["دعهُ يبكي فذو الهمومِ جديرٌ","أن ما في فؤادهِ يبكيهِ",33,"ه",1,0],["دَعهُ فَأَمُّ الطِفل تم","لكهُ كَما مَلَكَت سِواه",34,"ا",2,0],["دعَها تُنادي بما تُنادي","وَكُن عَلى خُطَّتي وَرَسمي",35,"م",2,0],["دَعهُم فلا بَرح التَّغَابُن من","حَسَد يُوَاصلهم إلى الحشرِ",36,"ر",1,0],["دَعهُم نياماً بعد طُولِ جهادِهم","فُضُلوعُهم ودُروعُهُم أرمام",37,"م",1,0],["دَعها تنخ في ديار الغانمية في","روض أريض لدى جود وافضال",38,"ل",1,0],["دَعها من النيابَتين تحثها","نغمات حادى العيس بالاطراب",39,"ب",1,0],["دَعْهُ يُكَاثِرْ بِالثّراء الثّرى","قَنَاعَتي أكْثَرُ مِنْ ثَرْوَتِهِ",40,"ه",1,0],["دَعهُ فَقَد جَذَبَ الهَوى بِعِنانِهِ","وَشُؤونُهُ هَتَكَت سَريرَةَ شانِهِ",41,"ن",2,1],["دَعهُم أَخا الوَجد لا تَعبَأ بِعَذلِهِم","أَنا الوَفيّ وَاِن خانوا وَاِن نَكَثوا",42,"ث",3,0],["دعها ولا تحفل بها يا طالما","عزَّ اللئيمُ بها وذلَّ كريمها",43,"م",3,0],["دعه ولذ بحمى البتولة مريمٍ","مستعصماً فملاذها المأمول",44,"ل",1,0],["دعها وراظهرك وفك القيود","من قبل ما تجعلك مصيود",45,"د",1,0],["دَعْهُمْ يقولوا فَبي فوقَ الذي قالوا","سقمٌ وسهدٌ ودمعٌ فيكَ همّالُ",46,"ل",1,1],["دعهم فلو نظروك أوَّل نظرةٍ","كُنا اشتركنا في هواك جميعا",47,"ع",2,0],["دعهم ففضول يعاني أمرهم","وهلمّ كي تحظى بنيل الأرب",48,"ب",1,0],["دَعْهُ وأَصْدَافَهُ بمُلْتَطِمٍ","أَصْبح بالشَّيْب قاذِفاً زَبَدَه",49,"د",2,0],["دعه يحاول أن تندى أراكته","بِصَيِّبِ المكرِ ما في ذاك من باسِ",50,"س",1,0],["دعهم وقلبي ما وفَوا بضمانه","ودع البكاء لهم يفي بضمانِ",51,"ن",1,0],["دعه وبِتْ منه على نجوةٍ","خائفةِ الرقبةِ حذَّارَهْ",52,"ر",2,0],["دعْها تكنْ كالسَّلفِ من أخَواتِها","تَجرِي بها الدنيا على عاداتِها",53,"ت",3,1],["دعهم ومَنْ حَمَلَتْه حُمْرُ جِمالهم","للبين مِن حمراءَ في بيضاءِ",54,"ا",2,0],["دعُ هذاءً ولِعَ القومُ به","جَلَّ هذا المجدُ عن قيلٍ وقال",55,"ل",1,0],["دعهم وسر مُعرضا عنهم فإنهمُ","للعرض مقذرةٌ بل للعيون قَذَى",56,"ذ",2,0],["دعهم يريقوا يزهقوا يستنزفوا","ينفوا يبيدوا يفعلوا ما شاءوا",57,"ا",1,0],["دَعها فَطُلّابُها رعاعٌ","طاشَت بِأَلبابهم فَطاشُوا",58,"ش",3,0],["دعهم على ماهم عليه فإنهم","رهن المصائب في قيود شتات",59,"ت",1,0],["دعَهُمْ وما انتَحَلوهُ واقْصِهِمْ أَبداً","ما أَنْتَ في قربِهِمْ يا خِلُّ مغْدُورُ",60,"ر",1,0],["دعهم مع الدهر واحداثِه","حتى ترى ما يصنع الدَّهر",61,"ر",1,0],["دَعهُ بِرَبِّكَ وَحدَهُ وَإليكَهَأ","أجسَامُنَا فاصنَع بهَا مَا تَصنَعُ",62,"ع",1,0],["دعهُم يَذوقوا الآنَ شَرَّ فِعالهِم","فَجزاءُ أفعالِ الشُّرورِ شُرورُ",63,"ر",1,0],["دعه يقاسي الأسى في حب ذي ملل","لعله إن شكى الهجران يسمعه