{"poems":[[95,"مضى عصر الرجال الأعاظم","https://www.aldiwan.net/poem11326.html","الطويل"],[53,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[31,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[47,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[48,"خلافك بعض الناس يرجى به المنى","https://www.aldiwan.net/poem23285.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[47,"لهَا مَنْزِلٌ بَينَ الدَّخولِ فَتُوضَحِ","https://www.poetsgate.com/ViewPoem.aspx?id=33040",""],[136,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[193,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[276,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[398,"أبو الفضل من أجرى الى الفضل يافعا","https://www.aldiwan.net/poem53406.html","الطويل"],[422,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[447,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[463,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[463,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[469,"تثنت من الأعطاف مخطفة سمر","https://www.aldiwan.net/poem3483.html","عموديه"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[556,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83285","الطويل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110372","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38936","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38323","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38966","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123362","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130710","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111829","الطويل"],[2237,"","https://poetry.dctabudhabi.ae/diwan/poem/200367","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111250","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137455",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100370","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204735","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74195","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3771,"","https://poetry.dctabudhabi.ae/diwan/poem/67762","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66139","الوافر"],[4679,"رأى الدهر ما قد سامنا البين والهجر","https://www.poetsgate.com/ViewPoem.aspx?id=142725",""],[4984,"أَيُعْقَلُ أَنْ أَنْسَى","https://www.poetsgate.com/ViewPoem.aspx?id=201808",""],[5145,"نعم حلب العين اعتراف الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=108071",""],[5156,"يقول أنا الكبير فعظموني","https://www.poetsgate.com/ViewPoem.aspx?id=99145",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5704,"ألا إن الحبيب مضى وغابا٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204191",""],[5817,"حماة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=199671",""],[6070,"ينوحُ الى عظيمِ الكونِ أمْرَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=189819",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""]],"verses":[["وَلَمْ يَأْلُ جُهْداً فِي رِعَايَةِ ذِمَّةٍ","وَلَمْ يَنْسَ حَقاً لِلعُلَى وَالمَكَارِمِ",0,"م",1,0],["ولم يأتِ ذنباً ترى شخصه","عِياناً ولا مثلهُ من يزلُّ",1,"ل",1,0],["وَلَم يَأتِني في الصُحفِ إِلّا نَذيرُكُم","وَلَو شِئتُمُ أَرسَلتُمُ بِأَماني",2,"ن",2,0],["وَلَم يَأتِ موسى في المَوالي عَلَيهِمِ","سَرابيلُ مِن نَسجِ الحَديدِ المُوَشَّحِ",3,"ح",1,0],["وَلَم يَأتِ في الدُنيا القَديمَةِ مُنصِفٌ","وَلا هُوَ آتٍ بل تَظالُمِنا جَزمُ",4,"م",1,0],["وَلَمْ يَأْتِ مِنْ أَوْطَانِهِ النِّيلُ سَائِحاً","إِلَى مِصْرَ إِلا وَهْوَ حَرَّانُ سَائِلُ",5,"ل",1,0],["ولم يأت موسى في الموال عليهم","سرابيل من نسج الحديد الموشح",6,"ح",1,0],["ولَمًى إِثمُداً وشَوكَ سَيَالٍ","وبُرُوقاً وَرِقَّةً ونَعِيمَا",7,"م",2,0],["وَلَم يَأخذوهُ هكذا نطق ناطقِ","لَقَد أَوضحوا منه دقيقَ الحقائقِ",8,"ق",1,0],["وَلَم يأخذ العبد المسىء بذنبه","وَلكنه يرجى لامر وَيمهل",9,"ل",1,0],["ولم يأت ذنباً عامداً غير أنه","بأول حكم اللَه طالب رخصة",10,"ه",1,0],["وَلَم يَأتِهِ عَنّي مِنَ الشَتمِ عاذِرٌ","خَلا أَنَّ أَمثالي تُصيبُ وَتَعرُقُ",11,"ق",1,0],["وَلم يَأتِهِ وِردُ السقام لِغَير ما","عَرَفنا فَخُذ مَعنى تَأَلُّمِهِ مِنّا",12,"ن",2,0],["ولمياء لم تنجز بوعدٍ لمغرم","وهل أَنْجَزَتْ ذات الوشاحين موعدا",13,"د",2,0],["ولم يأخذ بكم بدلا","على بعد وفي كتب",14,"ب",1,0],["ولمياءُ حذِرناها","فساق القدَرُ الحيْنا",15,"ن",2,0],["ولم يأسف على العليا","ء مثل معوّد النِّعمِ",16,"م",1,0],["ولمياءُ إن ضنَّت فقد جاد طيفها","وإن تكُ عنَّا في غنى فبنا فقرُ",17,"ر",1,0],["ولمياءَ حوراء المدامع طفلة","تشكى إلى الجارات ثقل الغلائل",18,"ل",1,0],["ولم يأتني التّقصيرُ من عجز منطقي","ولكنْ دهاني من معاليك طولُها",19,"ل",3,0],["ولم يألفن منذ العرس إلا","ملاقاة الحليل بقول هات",20,"ت",1,0],["وَلَم يَأتِ فيهِ المَوتُ مَصرَعَ واحِدٍ","وَلَكِنَّهُ كانَ المَصارِعُ أَجمَعا",21,"ع",2,0],["وَلم يَألها حَتّى كَساها غَلائِلا","مِن النار حَمرا في السَموات مصعدا",22,"د",2,0],["ولم يأتيهِ عن عَبَثٍ ولكن","رآه في الأنامِ جللَ شانِ",23,"ن",1,0],["وَلَمياء لَو قيسَ الرّحيقُ بِريقِها","لَأَخطا بِلا ريبِ قِياسٌ وقائسُ",24,"س",1,0],["وَلَمياءُ أَحلى الخمرِ كانَ رضابُها","وَماء حَياةِ النّفسِ لَو ذاقَتِ الحتفا",25,"ف",2,0],["وَلَمياء مِن ماءِ الحَياةِ بِثَغرِها","إِذا ذقتَ ذقتَ الشّهدَ أَو ذقتَ اِسفنطا",26,"ط",2,0],["ولم يأْلُ جهداً مُرْشِدٌ في اقتفائهم","وأَبناءُ ذاك البدر زُهْرُ الكواكب",27,"ب",1,0],["ولم يأل جهدا في عبادة ربه","إلى أن علافي عدن أعلى مرافع",28,"ع",1,0],["ولم يأت قول فيه عن سيد الورى","بنصّ جلي جانز يثلج الصدرا",29,"ر",2,0],["ولم يألهم نصحاً ولكن اضلَّهم","ادلاء في ليل الغرورِ عواثرُ",30,"ر",1,0],["ولم يأت للأمر الذي حال دونه","رجال هم أعداؤك الدهر من شمم",31,"م",1,1],["ولم يألوا بها الآباء جهداً","ولكن دونها ارب الأريب",32,"ب",1,1],["ولم يأل في نشر المعارف جهده","ولا كان في بث العلوم مقصرا",33,"ر",2,0],["ولم يأل ابن هادي الخلق فرداً","لدى جمع ابن ملحدة الضلال",34,"ل",1,0],["ولم يأت في سفري للوداع","ولم يبد حزنا له أو كدر",35,"ر",1,0],["وَلَم يَأل جُهداً غَيرَ أَن رامَ سُؤدداً","كَقَطر النَدى عداً وَهَل يحسب القطر",36,"ر",1,0],["ولم يأسوا من الدنيا","على غَبْن وحرمانِ",37,"ن",1,0],["ولم يأخذ الضربُ إلاّ الرؤوس","ولم يأخذ الطعن إلاّ الثغر",38,"ر",1,0],["ولم يأسفْ على فاني","بثغرٍ ضاحكِ السِّنِّ",39,"ن",1,0],["ولم يَأْتُوا منَ الأَمْجادِ بَيْتاً","رفيعاً شامِخاً إلاَّ أَتَيْتُ",40,"ت",1,0],["ولم يأل جهد أقط في رأب صدعها","وفي خيرا أصلاح يشد به الأزر",41,"ر",1,0],["ولم يأتني غيب من الظن قبلها","وقد رافقتني في هواجس وحدتي",42,"ت",2,0],["ولم يأتمن ربّ السموات غيره","عليها وعند الله علم الضمائر",43,"ر",1,0],["ولم يأت الكبير بيوم خير","فما فضل الكبير على الصغير",44,"ر",1,0],["ولم يأتنا منها سوى الخامس الذي","تهور فيه الفدم بالكفر واستبحرا",45,"ر",2,0],["ولم يأبهْ لعشقي أوهامي","ولم يفتح لأمر العوْدِ بابا",46,"ب",2,0],["ولم يأتِ المذمَّة يرتجيها","يناطح ذا الجبالِ الشامخات",47,"ت",1,0],["ولمْ يأبهْ لِحالكَ أيُّ إنسٍ","كأنَّ الخيرَ مغموسٌ بِخمرَةْ",48,"ر",2,0],["ولمى الشفاه الظامئات... أحبّه","من لا يذوب بحسنه المشبوب!!",49,"ب",1,0],["ولمْ يأخذْ العبدَ المسيىء َ بذنبهِ","ولكنهُ يرجى لأمرٍ ويمهلُ",50,"ل",1,0]]}