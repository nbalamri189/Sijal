{"poems":[[55,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[95,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[85,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[53,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[46,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[46,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[90,"قسَماً بالإله عزَّ وجلاَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19555&r=&rc=58",""],[186,"في الركب بين هوادج الآرام","https://www.aldiwan.net/poem67034.html","الكامل"],[201,"لي طرف لم يدر ما الإغفاء","https://www.aldiwan.net/poem39813.html","الخفيف"],[202,"وركب تساقوا كؤوس الكرى","https://www.aldiwan.net/poem51864.html","الطويل"],[236,"أوجهك أم ضوء الصباح تبلجا","https://www.aldiwan.net/poem44571.html","الطويل"],[236,"إليك رسول الله أشكو تخلفي","https://www.aldiwan.net/poem44580.html","الطويل"],[240,"حلفت بمسراها بحربة بزلا","https://www.aldiwan.net/poem31614.html","الطويل"],[240,"حرام على الأجفان أن ترد الغمضا","https://www.aldiwan.net/poem31900.html","الطويل"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[443,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[449,"عفوت حتى لا أريد العتاب","https://www.aldiwan.net/poem56002.html","عموديه"],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[567,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[580,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83276","الطويل"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54163","الطويل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110735","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216297",""],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113918","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45403","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102074","المتقارب"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96491","الطويل"],[1828,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137954",""],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47186","الخفيف"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216449",""],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216396",""],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126228","الخفيف"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101722","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93571","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132523","الخفيف"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92046","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111048","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86395","الطويل"],[5246,"في ربوع العراص المقدسة","https://www.poetsgate.com/ViewPoem.aspx?id=187039",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[402,"لحق اليوم بالرفقا أمين","https://www.poetsgate.com/ViewPoem.aspx?id=36483",""],[5818,"يا قابض الوهم","https://www.poetsgate.com/ViewPoem.aspx?id=181687",""],[3456,"متى كان غزال له يا ابن حوشب","https://www.poetsgate.com/ViewPoem.aspx?id=151439",""],[5854,"رثاء الشيخ الوالد أبو زيد محمد حمزة","https://www.poetsgate.com/ViewPoem.aspx?id=191884",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[5956,"حفاوة أحفادي","https://www.poetsgate.com/ViewPoem.aspx?id=199852",""],[5970,"روح فؤادك بابنة الأعناب","https://www.poetsgate.com/ViewPoem.aspx?id=130664",""]],"verses":[["يَومَ وَلّى قَومَهُ في هُوَّةٍ","مُستَغِرٍّ دَمَّرَ الجيلَ الطَغاما",0,"م",2,0],["يَوْمَ وَافَيْتَنِي وَتُوشِكُ أَنْ تَبْ","دُوَ فِي وَجْهِكَ النَّضِيرِ غُصُونُ",1,"ن",1,0],["يؤمون من قبر الشفيع مثابةً","تطلَّعُ منها جنّةٌ ذاتُ أفنانِ",2,"ن",1,0],["يوم وجَدِّك لم تشهده أسعُدُهُ","ولا اجتليْنَه ميمونَ التباشير",3,"ر",1,0],["يَؤُمّونَ أرضاً بالبِطَاحِ أريضَةً","وزُرقَ حمامٍ بالعُذَيبِ عِذَابَا",4,"ب",2,0],["يَومٌ وَسَمتَ بِهِ الزَمانَ وَوَقعَةٌ","بَرَدَت عَلى الإِسلامِ وَهيَ سَمومُ",5,"م",1,0],["يَومَ وَلَّت مَريضَةَ اللَحظِ وَالجَف","نِ وَلَيسَت دُموعُها بِمِراضِ",6,"ض",1,0],["يَؤُمُّون المثابةَ لو أقاموا","شعائرَها لساروا مُحرِمينا",7,"ن",2,0],["يوم وافى الى ّ منك كتاب","فيه آياتُ فضلك الجمْ تُتلى",8,"ل",2,0],["يَومٌ وَقَفتُ بِهِ كَئيباً حائِراً","لِلبينِ أَسألُ رَحمةَ الأَنعامِ",9,"م",1,0],["يوم ولّت يقودها الرقباء","خدعوها بقولهم حسناء",10,"ا",2,0],["يؤمُّون نجداً فيا نجدُ بشرى","سيغبطُ منكَ الثريَّا الثرى",11,"ر",2,0],["يؤمون ربعا أفيح الجو زاهراً","أضاء بوجه منك أزهر أبلجا",12,"ج",2,0],["يؤمون ربعاً منك بالنور آهلاً","يرومون منك الفضل يا خير مُسعف",13,"ف",1,0],["يَؤُمّونَ في أَعلامِ مَكَّةَ مَوقِفاً","يَحُطّونَ مِن وَقرِ الذُنوبِ بِها ثِقَلا",14,"ل",2,0],["يَؤُمّونَ مِن أَعلامِ طَيبَةَ مَنزِلاً","بِهِ تَنفُضُ الأَوزارَ زُوّارُها نَفضا",15,"ض",2,0],["يَومَ وافى الخَليجَ حَرّانَ لا يَم","لِكُ نَقعَ الغَليلِ مِنهُ الماءُ",16,"ا",2,0],["يؤمّون ملكاً تحسدُ الشمسُ تاجَه","وَتغضي عيون النجم عن لحظه رهبا",17,"ب",2,0],["يومَ وافَى يَجُرُّ للحسنِ جَيشاً","قال لي قائل سَلِ اللهَ صَبرا",18,"ر",2,0],["يؤمون بحراً من المكرماتِ","فقلتُ طلابكمُ في حلب",19,"ب",1,0],["يوم وليل قد طرحنا الحيا","عنا بعيدا مذ تخذنا نقاب",20,"ب",1,0],["يومٌ وليُّكَ مسروراً بعودتِه","وفي عدوّكَ منه الهمُّ والنّصَبُ",21,"ب",1,0],["يومٌ وليلٌ يذهبانِ كلاهُما","والنَّاسُ بينهُما تمرُّ كما تَرَى",22,"ا",1,0],["يَؤُمُّون أَرْفَع مولىً عَلا","ويأْتُون أَكْرَم مولىً وَهَب",23,"ب",1,0],["يَؤُمّونَ مَثوى لِلخَليلِ وَمَرقَداً","تَلَألَأَ نوراً بِالنَبِيِّ مُحَمَّدِ",24,"د",1,0],["يوم وهو جاني سكيرين","بقوام يميل من الراح",25,"ح",1,0],["يوم وهو جاني بضجة","وجبين معقود وعابس",25,"س",1,0],["يؤمون بيت الله يبغون فضله","وليس لباغي الفضل بالبيت ذائدُ",26,"د",1,0],["يوم وافت شمس الغريين بدراً","مستنيراً لعاكف ولباد",27,"د",1,0],["يؤمّون بالشكوى أبا الناس آدم","فمن دونه شافع بعد شافع",28,"ع",1,0],["يوم وصله عندنا شان","والبقايا تذرف المونه",29,"ن",2,0],["يومَ وافاهُ يَنشُدُ الحلفَ أن قَد","أُفنِيَت من خُزاعةَ الأفناءُ",30,"ا",2,0],["يومَ وَلَّت كأنها حينَ جدَّت","باسِقاتُ النخيلِ من كانوالِ",31,"ل",1,0],["يُؤمّونَ بيضاً في الأَكِنَّةِ لَم تَزَل","قُلوبُهُم حُبّاً عَلَيها أَداحِيا",32,"ي",2,0],["يؤمونه من مكان بعيد","لدرك مناه ونيل المراد",33,"د",1,0],["يؤمون من نال الغنى بعد شيبه","وقاس وليداً ما يقاسي ذوو الفقر",34,"ر",1,0],["يؤُمُّون الذُرى وَالخَيلُ تَترى","بفرسانِ اللقاءِ كجنِّ عانِ",35,"ن",1,0],["يوم وافا فظنت الشرق والغر","ب بجيش للحزم قد وافاها",36,"ا",3,0],["يومَ وافى جبريلُ مريمَ ليلاً","مُرسلاً من مدبر الاكوانِ",37,"ن",1,0],["يومَ وادي الزّرقاء إذْ رام ظلماً","وطغى جندُه وأفنى رصاصَه",38,"ص",2,0],["يوم وقت صْبايْ لي به مستعد","ما سمعت اللي عذلني والحسود",39,"د",1,0],["يوم وقت القيظ قد زَلّي","ما بقي شيٍ يسادونه",40,"ن",2,0],["يومُ وصلى بالواحدِ السَرمَدِي","ليلُ فَصلِى إلى المقامِ العَلِي",41,"ي",1,1],["يؤمون حيث الصبح يتلع جيده","ويلوى سواد الليل عطف هزيم",42,"م",1,0],["يَوم وافى الحسين يرشد قَوما","مِن بَني حَرب لَيسَ فيهُم رَشيد",43,"د",1,0],["يوم وافى بالعرش طرفة عين","وإذا الشام عنده صنعاء",44,"ا",2,0],["يوم وما أدراك مايوم عظ","يم ثم ما أدراك ما أدراكا",45,"ك",2,0],["يَومٌ وما أَدراك ما هُو إنه","يَومٌ طَويلُ البَسط وَالتفصيل",46,"ل",1,0],["يوم ولدت فيه أيمن ساعة","نسيت به أهل الغري أعيادها",47,"د",3,0],["يؤمون أجراع العقيق من الحمى","يحلون أوعاساً له أو مطاليا",48,"ي",2,0],["يؤمُّون بيتَ الله لبيك ربنا","شعارهم يدعو بها العبد والحر",49,"ر",1,0],["يَوْمَ وَلَّى الْجَيْشُ مُنْهَزِمَاً","فِيهِمُ تَيْمٌ غَدَا وَعَدِي",50,"د",2,0],["يوم ولى الدعي وهو زياد","منه ظلماً قد انملت كوفان",51,"ن",1,0],["يوم وافيتني وتوشك أن تبدو","في وجهك النضير غضون",52,"ن",1,0],["يومٌ وعامانِ طالَ القهرُ مُذ رحلَتْ","انظرْ ب عينيكَ .. ماذا كنتَ تعتقدُ",53,"د",1,0],["يؤمون ملك الشام حتى تمكنوا","ملوكاً بأرض الشام فوق المنابر",54,"ر",1,0],["يومٌ -وربّي- ما شهدتُّ مثيلَه","ومَدَامِعِي كالمُزْنِةِ الوَطفاءِ",55,"ا",2,0],["يوم وافت، تفتَّح الزهر لما","لاح من ثغرها الحييِّ ابتسامُ",56,"م",1,0],["يومٌ وحيدٌ لي يعادل عيشتي","من قبلِ هذا اليوم كنتُ الأعمى",57,"م",2,0],["يوم وليل والحياة قد انقضت","ودعاك داع بعدها لإياب",58,"ب",1,0]]}