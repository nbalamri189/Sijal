{"poems":[[55,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[90,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[90,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[53,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[87,"أداري العيون الفاترات السواجيا","https://www.aldiwan.net/poem62988.html","الطويل"],[45,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[51,"أيها المبصر الصحيح السميع","https://www.aldiwan.net/poem62156.html","الخفيف"],[68,"حي الرفاق وطف بكأس الراح","https://www.aldiwan.net/poem38496.html","الكامل"],[99,"دع النفس تمرح في خيال وأوهام","https://www.aldiwan.net/poem24779.html","الطويل"],[99,"أمير الفضل فضلك بيت شعرٍ","https://www.aldiwan.net/poem24968.html","الوافر"],[99,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55031","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55154","المجتث"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[108,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[98,"مَأْسَاةُ رَجُلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188156",""],[112,"سابع المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=36761",""],[201,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[215,"منظر رائع الجمال رهيب","https://www.aldiwan.net/poem46588.html","الخفيف"],[303,"خفق القلب له لما خفق","https://www.aldiwan.net/poem36855.html","عموديه"],[333,"عزيز الحمى ما دون نبعك من ورد","https://www.aldiwan.net/poem54946.html","الطويل"],[409,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[463,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[463,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[463,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[463,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[466,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[466,"إذا كنت مضعوفا بأدنى فراقكم","https://www.aldiwan.net/poem16126.html","الطويل"],[469,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[469,"أحن إلى ظل العقيق من الحمى","https://www.aldiwan.net/poem3270.html","عموديه"],[475,"إنما الذلفاء همي","https://www.aldiwan.net/poem4820.html","مجزوء الرمل"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122559","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101520","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101545","الكامل"],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/107038","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133837","الوافر"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133838","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61052","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109152","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109126","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100960","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198861","الطويل"],[2057,"","https://poetry.dctabudhabi.ae/diwan/poem/130454","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102128","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124053","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106898","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126205","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87692","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100926","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93982","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100228","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132789","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100847","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100727","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100796","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100786","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206133","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128917","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75684","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107513","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35046","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81730","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83202","الرجز"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[1901,"حببَّتْني فيكَ أيامُ الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=160374",""],[4858,"فأنتَ \"أبا عزيزٍ \" خيرُ صَحبي","https://www.poetsgate.com/ViewPoem.aspx?id=158978",""],[4915,"سِتُّ الجِهات","https://www.poetsgate.com/ViewPoem.aspx?id=211521",""],[5002,"القصيدة الباكية","https://www.poetsgate.com/ViewPoem.aspx?id=204939",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5155,"الربيع العائد","https://www.poetsgate.com/ViewPoem.aspx?id=176168",""],[5163,"نخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34864",""],[5277,"لِّتَسْكُنُوا إِلَيْهَا","https://www.poetsgate.com/ViewPoem.aspx?id=187572",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[475,"إِنَّمَا الذَّلْفَاءُ هَمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=20666",""],[5463,"هام قلبي هام هام","https://www.poetsgate.com/ViewPoem.aspx?id=33697",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6127,"اقرأ","https://www.poetsgate.com/ViewPoem.aspx?id=197852",""],[6177,"مديح الفصيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79433&r=&rc=22",""],[6177,"الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79065&r=&rc=12",""],[6251,"الأرقم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76494&r=&rc=34",""]],"verses":[["حَبَبتُ لِقَلبي ظِلَّهُ في هَجيرِهِ","إِذا ما دَجا أَو شَمسَهُ في ضَريبِهِ",0,"ب",2,0],["حَّببت للوطنيّ الحرّ","أن يهجُر داره",1,"ر",2,0],["حَبَبْت العلا منذ الصبا حبّ شاعر","وقمت إليها ساعياً سعيَ قادر",2,"ر",1,1],["حَبّبَتْ كفُّه السؤالَ إلى النا","س جميعاً وكان غير حبيبِ",3,"ب",1,0],["حَبَّبَتْ دُرَّةُ القِيانَ إلينا","مثل ما بَغَّضَتْ إلينا القيانا",4,"ن",2,1],["حَبَّبتْهنَّ أن غدتْ وهي منهنْ","نَ وإنْ كُنَّ دونَها أوزانا",4,"ن",2,0],["حَبَبتُكِ ذاتَ الخالِ وَالحُبُّ حالَةٌ","إِذا عَرَضَت لِلمَرءِ لَم يَدرِ ماهِيا",5,"ي",2,0],["حَبَبتُكَ قَلبي قَبلَ حُبِّكَ مَن نَأى","وَقَد كانَ غَدّاراً فَكُن أَنتَ وافِيا",6,"ي",2,0],["حَبَّ بِالزَورِ رائِحاً لِعُيونٍ","مَلَأَتها مَلاحَةً أَشخاصُه",7,"ص",2,0],["حُبِّبَ الأَكلُ وَالشَرابُ إِلَينا","وَبِناءُ القُصورِ وَالتَجميعُ",8,"ع",1,0],["حَبَبٌ تَظَلُّ بِهِ الكُؤوسُ كَأَنَّها","خَصرُ الفَتاةِ مُمَنطَقاً بِوِشاحِ",9,"ح",1,0],["حببتك لا أدري الهوى ما وراءه","وما بعد سقمي فيك عاماً على عامِ",10,"م",1,0],["حببت سناك أتبعه بشعري","وفخراً أن أكون له تبيعا",11,"ع",2,0],["حببتكِ ما شدوت لديك شعرا","ولكني اعتصرت لكِ الدماءِ",12,"ا",2,0],["حبٌّ بلوتَ به العذابَ ومثلهُ","مِقَتُ السياسةِ وهي شرُّ بَلاءِ",13,"ا",2,0],["حَبَّبَ الْفقُرَ إِلَيْنَا","مِنْكِ إِحْسَانٌ شَرِيفُ",14,"ف",1,1],["حَبَّبَ السَّعَي فِي الحَيَاةِ إِلَيهِم","فَإِذَا هُمْ وَلَيْسَ فِيهِم فَقِيرُ",15,"ر",1,0],["حَبَبْتُ نِسَاءً وَلَكِنْ","كَمَا حَببْتُكَ لاَ لاَ",16,"ل",2,1],["حَبَبتُ مِن اِجلِهِ الدُنيا","فَفارَقَني لِأَضغَنَها",17,"ن",3,0],["حبَّبْتُ فيه فتى نحيلاً جسمُهُ","يبدو؛ فتحسبه مُعَنىًّ مغرمًا",18,"م",2,0],["حبٌّ بلوتَ به العذابَ، ومثلُهُ","مِقَةُ السياسةِ وهي شرُّ بلاءِ",19,"ا",2,0],["حببتني قربك وذاب أتعبيله","في جمر عقبه بعد عقبه وعقابات",20,"ت",1,0],["حُبٌّ برىءٌ نما في خافِقي وَسَما","وهَل يُعَمَّرُ حُبٌّ غيرُ روحاني",21,"ن",2,0],["حبّ بحبّ وآمالٌ وأوديةٌ","يثور فيها طروب الروح جذلان",22,"ن",1,0],["حبَّبَ الظلماءَ لي لما أَضا","هكذا نسحر بالنور الحدق",23,"ق",1,0],["حببتك فاعلم أن حبّك باعثي","إلى المجد والحب العظيم أخو المجد",24,"د",1,0],["حُبِّب إليَّ من الصبا","فأنا به كلَفٌ عميد",25,"د",1,0],["حببت لي هذي القبور وأهلها","فيهن أسراري عليك تذيع",26,"ع",1,0],["حبَّبَ الفقرَ إليه أنه","سؤددٌ وهو بذاك الفقر يَغنَى",27,"ن",2,0],["حبَّبَتْني لك الأيادي الفسيحا","ت فأسمحتُ والعطايا الضخمَهْ",28,"م",2,0],["حبَّبه إلى النفوس خُلُقٌ","لو ذاقه عدوُّه حلا لَه",29,"ل",2,0],["حببتُكَ من سَلمِي وأغدو بشفرةٍ","على عُنْقِ مَن أبغضتُ مِن مَنطقي أُنحي",30,"ح",2,0],["حببتُك حُبي شَهيَّ الحياةِ","صَفَتْ وتباعدَ أدْرانُها",31,"ن",3,0],["حببتُكمُ قبل الأيادي وقبلَ ما","همى ليَ رجّافٌ من الجود هامرُ",32,"ر",1,0],["حَبَبت هُماماً من ذؤابة خِنْدفٍ","به افتخرتْ أحياؤها والعَشائرُ",33,"ر",1,0],["حببتكمُ حُبَّ الشبيبة والغنى","وعصرُ الصّبى قدماً فهيهاتَ أن أسلو",34,"ل",2,0],["حببتكم حب الحياة مع الصبا","وأي حياة لا تنغص بالفقد",35,"د",1,0],["حَبَّبَ الذَلفاءَ عِندي","مَنطِقٌ مِنها رَخيمُ",36,"م",1,0],["حُبَّ بها إِلْمَامةً مأمونةً","وزَوْرَةً يُزيحُ فيها التُّهما",37,"م",2,0],["حَبَبٌ كالجُمانِ يطفو من الإِف","رادِ تحتَ الفِدامِ والإرواج",38,"ج",1,0],["حببت لي الوجد حتى لو دنا أجلي","صافحته وفمي للوجد يبتسم",39,"م",1,0],["حبَّبتَ لي التمداحَ كنتُ اعافُهُ","حتى عشقتُ بمدح ذاتَك ذاتَهُ",40,"ت",2,0],["حب بهم يزهو كغر فعالهم","يعزى إلى الهادي الحبيب المرسل",41,"ل",1,0],["حببتك قبل أن","ألقاك محمولا على طربي",42,"ب",2,0],["حببتك نغمة عذبت","على ثغر الهوى الرطب",42,"ب",1,0],["حببتك شاعراً غَرِداً","أتى الدنيا بلا أرب",42,"ب",1,0],["حببناك لما راجع الشعر أهله","وناء بألفاظ وهزل زمان",43,"ن",1,0],["حَببي الثغر مَعسول اللمى","مائس القَد رَطيباً أَهيفا",44,"ا",1,0],["حببتك يا ثوبي فاصفيتك الهوى","وكنت وفيًّا في هواك فكن مثلي",45,"ل",2,1],["حببتك حتى لم أجد لك مشبهاً","والفيت أهلَ الدهر دونك والدهرا",46,"ر",2,0],["حبَّب الفاقةَ لي أني فتىً","يجمع الحمد ويُفني النَشبا",47,"ب",2,0],["حببَ الفسقَ والفجورَ إليها","ورماها في كاذباتِ الأماني",48,"ن",2,0],["حبَّبَ اللهوَ والفسادَ إليكُم","وحدتكُم جنودُهُ الأشقياء",49,"ا",2,0],["حببناه وهو الذخر يوم معاذنا","إذا ما لظى بالضالمين تصيح",50,"ح",1,0],["حب بتلطيف البهاء مكرم","وبرؤية الحسن البديع ينعم",51,"م",1,0],["حبَبتُ من خصّاني","بالسر والنوراني",52,"ن",2,0],["حبب الصحو إلى غيري وَصِلْ","بِعُرَى اللهو غُدُوِّي ورواحي",53,"ح",2,0],["حبّبَت كل شقرويّ إلينا","من حميم لها وغير حميم",54,"م",1,0],["حببتكِ ملءَ أحلامي المواضي","وملءَ شبابي الفاني السريع",55,"ع",1,0],["حُبِّبَت للقلوبِ سَلمَى ومالَت","إذا تَجَلَّى منها المُحَيَّا المَليحُ",56,"ح",1,0],["حَبَّبَ المَوتَ بِها","ما بِها مِن نَكَبات",57,"ت",1,0],["حبَّبَ الناسَ فى الروايات لمَّا","أهملَ الناسُ أمرها بالأغانى",58,"ن",2,0],["حبب الإيمان ربي","وإلينا الكفر كره",59,"ر",2,0],["حببذا أنت لي حبيبة قلب","وحبيباً مولعاً بحبيب",60,"ب",1,0],["حب بني الطاهرين الغر","زادي وهل مثله من زاد",61,"د",1,0],["حبب الطل به قد نضدا","في كؤوس من سلاف ورحيق",62,"ق",1,0],["حببتك حب النفس أماً كريمة","ترد عن الأبناء غائلة الفقر",63,"ر",1,0],["حببتك يا رب الخلافة مثلما","حببت فروقاً أن تسود وتعظما",64,"م",2,0],["حببتك دنيا القلب والحب جذوة","اذا لمست جلمود صخر تسعرا",65,"ر",2,0],["حببتك غداراً وشيمتك الجفا","فكيف يكون الحب ان كنت وافيا",66,"ي",2,0],["حببت لي الأحزان لما صغتها","حليًا على هذا الجبين الن