َوضِ قَد صَقَلا","لَوحَ الخَيالِ فَأَغراكُم وَأَغراني",1,"ي",1,0],["طَيْفٌ بِلا ظِلٍّ كَتُومُ الخُطَى","مَنْ يَعْتَرِضْ مَسْلَكَهُ يُرْدِهِ",2,"د",2,0],["طِيبٌ يُحَلِّبُ سُمّاً","فِي أنْفُسِ الْنَّاشِقِينَا",3,"ن",2,0],["طِيبُوا قَرَاراً أَيُّهَا الأَعْلامُ","وَعَلَى ثَرَاكُمْ رَحْمَةٌ وَسَلامُ",4,"م",1,1],["طَيَّبتَ مَن سَكَنَ الثَرى وَعَلا الرُبا","لَتَزَوَّدوهُ عُدَّةً لِنُشورِ",5,"ر",1,0],["طَيَّ بُرودِ اليَمَنِ الأَسمالِ","يَطرَحنَ بِالمَهارِقِ الأَغفالِ",6,"ل",1,0],["طَيِّبب الأصلِ طَيِّب العُودِ في البِن","يَة والفَرعِ يَثرِبِيُّ تَهَامِي",7,"م",2,0],["طيرُ الثناءِ محلقٌ في أفقه","أبدَ الزمان وأنني لمقصر",8,"ر",1,0],["طيفاً ألمَّ وما يظن بشاعر","قاضي القضاة سميعه إلا التقا",9,"ق",2,0],["طيفٌ تصيدته والليل محتبك","من حلية الشهب أو من شعره الحبك",10,"ك",1,1],["طيف كرى ما زال إلا غدت","ما الشرط للأحزان ما النافيه",11,"ف",3,0],["طيلسانٌ إذا تنفستُ فيه","صاحَ يشكو الصَّبا ويشكو الجنوبا",12,"ب",2,0],["طير تغني إذا تغنَّت","مهما أرادا بلا اقتراحِ",13,"ح",1,0],["طيلسان إذا تداعت خُرُوقٌ","بين أثنائه لهنَّ صُرَاخُ",14,"خ",1,0],["طَيٌّ ونشر لشوق لا كِفاء لهُ","وطلعةٌ منك فيها طيُّ إعسار",15,"ر",1,0],["طيُّ اللقاء له نشورُ","فليطوه الجلْد الصبورُ",16,"ر",1,1],["طيلسانٌ سامريٌّ","يتداعَىَ لا مِساسا",17,"س",2,1],["طيِّبٌ ريقُهُ إذا ذُقتَ فاه","والثريا بالجانب الغورِ قُرْط",18,"ط",1,0],["طيف عراني فحياني وأتحفني","بالنرجس الغض والتفاح إتحافا",19,"ف",2,0],["طِيُبها عند شمَّها يتقاضى","عضّها المُخْلصين من خُلّانِك",20,"ك",1,0],["طيزٌ رحيبٌ وفمٌ مثلُه","مُسْتَرقٌ من وجهِ جَريهْ",21,"ي",2,0],["طيَّر النومَ عن جُفوني خيالٌ","من حبيب فبتُّ أرعى الثُّريّا",22,"ي",2,1],["طيف ليلي بل ليس يبرح عيني","طيف ليلى في يقظتي ومنامي",23,"م",2,0],["طيب النفس لطيف ال","غرس غرس الأبوين",24,"ن",1,0],["طيبات تقدمتك إلى الأخ","رى وخير أقام في أعقابك",25,"ك",1,0],["طَيفُ الحَبيبِ أَلَمَّ مِن عُدَوائِهِ","وَبَعيدِ مَوقِعِ أَرضِهِ وَسَمائِهِ",26,"ا",3,1],["طَيفٌ أَلَمَّ فَحَيّا عِندَ مَشهَدِهِ","قَد كانَ يَشفي المُعَنّى مِن تَلَدُّدِهِ",27,"د",2,1],["طَيفٌ أَلَمَّ بِنا وَنَحنُ بِمَهمَهِ","قَفرٍ يَشُقُّ عَلى المُلِمِّ الخاطِرِ",28,"ر",1,0],["طَيفُ البَخيلَةِ وافانا فَنَبَّهَنا","بِعَرفِهِ أَم خِتامِ المِسكُ مَفضوضُ",29,"ض",1,0],["طَيفٌ تَأَوَّبَ مِن سُعدى فَحَيّاني","أَهواهُ وَهوَ بُعَيدَ النَومِ يَهواني",30,"ي",1,1],["طَيفٌ لِعَلوَةَ ما يَنفَكُّ يَأتيني","يَصبو إِلَيَّ عَلى بُعدٍ وَيُصبيني",31,"ي",1,1],["طَيرٌ تُبادِرُ رائِحاً ذا غَبيَةٍ","بَرداً وَتَسحَقَهُ خَريقَ شَمالِ",32,"ل",1,0],["طَيّارَةٌ كانَ لِلحَجّاجِ مَركَبُها","تَرى لَها مِن أَذاةِ المَوجِ أَعوانا",33,"ن",2,0],["طيبُ الحَياةِ لِمَن خَفَّت مَؤونَتُهُ","وَلَم تَطِب لِذَوي الأَثقالِ وَالمُؤَنِ",34,"ن",1,0],["طَيِّبُ النَشرِ يَجرَحُ اللَحظُ خَدَّي","هِ وَيُدمي أَعضاهُ مَسُّ القُباطي",35,"ط",2,0],["طَيِّبُ اللَفظِ لَو حَوَتهُ اللَآلي","جَعَلَتهُ الحِسانُ كَالأَقراطِ",35,"ط",1,0],["طيف من الماضي الكريم وصفحة","أخذت لها عهداً على الآباد",36,"د",1,0],["طَيّارَةٌ وَلها فَرْخانِ وَاعَجَبا","إذ لا تَزُفّهُما حتى تَرقّاها",37,"ه",2,1],["طينٌ أنا وهو ماءٌ","والطينُ في الماء ذائب",38,"ب",1,0],["طيبُهُ من نجيعه وهو مسكٌ","في عِذارَيْ مُهَذَّبٍ لَوْذَعِيِّ",39,"ي",1,0],["طِيبُ الخمول يصدُّني","عَنْ مدحِهِ بسوى الرموزِ",40,"ز",1,1],["طيرُها معرِبةٌ في لحنها","تطربُ الحيَّ كما تحيي الطربْ",41,"ب",1,0],["طَيِّبِ الريقِ إِذا ما ذُقتُهُ","قُلتُ ثَلجٌ شيبَ بِالمِسكِ الذَكي",42,"ي",1,0],["طَيفِ ريمٍ شَطَّهُ أَوطانُهُ","فَهيَ لَم تَدنُ وَلَيسَت بِأَمَم",43,"م",1,0],["طَيِّبُ النَشرِ واضِحٌ","أَحوَرُ العَينِ أَكحَلُ",44,"ل",1,0],["طَيفٌ لِهِندٍ سَرى فَأَرَّقَني","وَنَحنُ بَينَ الكُراعِ وَالخَرَبِ",45,"ب",1,0],["طَيِّبِ الريقَةِ وَالنَك","هَةِ كَالراحِ القَطيبِ",46,"ب",1,0],["طَيِّباتِ الأَردانِ وَالنَشرِ عيناً","كَمَها الرَملِ بُدَّناً أَترابا",47,"ب",2,0],["طيرُ الصَّبا ولى","وكان لي جارْ",48,"ر",1,1],["طَيِّبي أَنفُسٍ إِذا رَهِبوا الغا","رَةَ نَمشي إِلى الحُتوفِ القَواضي",49,"ض",2,0],["طَيفِ اِبنَةِ الحُرِّ إِذ كُنّا نُواصِلُها","ثُمَّ اِجتُنِنتَ بُها بَعدَ التِفِرّاقِ",50,"ق",1,0],["طَيَّ القَرارِيَّ الحِبَر","لَم تَتَقَعَّدها الطِيَر",51,"ر",1,0],["طَيفُ خيالٍ يَعتَريني زائِرا","لَمّا رَأَيتُ الدينَ حَظّاً وافِرا",52,"ر",2,1],["طَيفُ خيالٍ يَعتَريني زائِرا","وَالطَيفُ مِمّا أَن يَرِقَّ الذاكِرا",52,"ر",2,0],["طيبي ضَميراً بِأَمرٍ لا مَحيدَ لَهُ","يَلقاهُ بِالرَغمِ أَهلُ البَدوِ وَالحَضَرِ",53,"ر",1,0],["طَيفُ حِمامٍ زارَني في الكَرى","فَمَرحَباً بِالطَيفِ لَمّا أَلَم",54,"م",1,0],["طَيِّبو الباءَةِ سَهلٌ وَلَهُم","سُبُلٌ إِن شِئتَ في وَحشٍ وَعِر",55,"ر",1,0],["طَيِّبَةُ النَشرِ وَالبُداهَةِ","وَالعِلاّتِ عِندَ الرُقادِ وَالنَسَمِ",56,"م",1,0],["طينها من فالوذج لا يمل ال","مرء منه فهو اللذيذ الغزير",57,"ر",1,0],["طيران الحمام مهما تعالى","ليس ينجيه من دنوّ الحِمام",58,"م",1,0],["طيف الحَبيبة قد أَتى","في اللَيل يسمح بالوصال",59,"ل",1,0],["طيورَ السماء حَذَارِ الوقوعَ","على حَطبٍ في الثَّرى أو هشيمْ",60,"م",1,0],["طِيبي بِمَا حَلَّلْتِهِ","مِن المَحَلِّ الأَكْرَمِ",61,"م",1,0],["طَيْفُ غَادٍ مِنَ السَّحَابِ موَلٍّ","شَابَ فِي سَيْرِهِ صَفَاءَ غَدِيرِ",62,"ر",1,0],["طَيْفٍ يَشِفُّ بِهِ الْبِلَى","عَنْ رِفْعَةٍ وَتَمَنُّعِ",63,"ع",1,0],["طَيِّبَاتٌ قَدْ أَحْمَدُوهَا وَمَا فيِ","هَا مُرَاءٍ لِمَأْرَبٍ أَوْ مُرَادِي",64,"د",2,0],["طَيْرٌ أَبَابِيلٌ حِجَارَتُهَا اللَّظَى","تَدَعُ القُرَى فِي وَحْشَةٍ وَتَبَابَ",65,"ب",1,0],["طيف على أهدابها","كسرها تنقلا",66,"ل",2,0],["طيرُ المنيةِ صحْتَ أشأم صيحةٍ","وهززتَ شرَّ قوادِم وخوافِي",67,"ف",2,0],["طيف لشقراء كاس من متارفه","لو لم أصنه طغى وجدي فعرّاه",68,"ا",2,0],["طير تغني إذا تغنَّت","مهما أراد بلا اقتراحِ",69,"ح",1,0],["طَير أَعار الغُصن جنكا ركبت","أَوتارُهُ مِن فضة الأَمطار",70,"ر",1,0],["طيب الأَرومة أَوهَمتهُ بِأَنَّني","كَالعود يَظهَر عرفهُ إِذ يُحرَق",71,"ق",1,0],["طينتها عَنبَر وَخامرها الم","سك وَالياسَمين وَالوَرد",72,"د",1,0],["طيشا يصان حمى اللئيم برأيه","وحمى الكريم الشهم غير مصان",73,"ن",1,0],["طيف طرف غفا ووارد فكر","في ضمير المسكين لج وجلا",74,"ل",2,0],["طيب طابت البرية فيه","طاب ذاتاً وطاب فيه ثنائي",75,"ا",2,0],["طِيبُهُ طَيَّبَ الثَّرَى","والرّياحينَ والزَّهَرْ",76,"ر",1,0],["طيبٌ عناصره طيبٌ معاصره","ظفرٌ مَظاهرهُ عِداهُ تُحتَقَرُ",77,"ر",1,0],["طَيفٌ أَلَمَّ فَهاجَني","لِلبَينِ أُمَّ مُساحِقِ",78,"ق",1,0],["طَيفٌ ألمَّ