{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[54,"حنطته يا نصر بالكافور","https://www.aldiwan.net/poem27398.html","الكامل"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[72,"ثغر عليه من الملاحة سكر","https://www.aldiwan.net/poem18771.html","الكامل"],[72,"قال العذول فزاد قلبا شيقا","https://www.aldiwan.net/poem19352.html","الكامل"],[72,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[72,"أعربت يا مقلتي الغافيه","https://www.aldiwan.net/poem20568.html","السريع"],[51,"يا ابن حرب كسوتني طيلسانا","https://www.aldiwan.net/poem8317.html","الخفيف"],[51,"غصن من البان في وشاح","https://www.aldiwan.net/poem9396.html","مخلع البسيط"],[51,"يا ابن حرب كسوتني طيلسانا","https://www.aldiwan.net/poem9434.html","الخفيف"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"طي اللقاء له نشور","https://www.aldiwan.net/poem63006.html","مجزوء الكامل"],[51,"طيلسان سامري","https://www.aldiwan.net/poem64676.html","مجزوء الرمل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"قد لعمري اقتصصت من كل ضرس","https://www.aldiwan.net/poem65806.html","الخفيف"],[51,"يا ثلج ماء مالح آسن","https://www.aldiwan.net/poem66752.html","السريع"],[51,"طير النوم عن جفوني خيال","https://www.aldiwan.net/poem66766.html","الخفيف"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[89,"ما رأت في الناس عيني","https://www.aldiwan.net/poem44968.html","مجزوء الرمل"],[85,"يا أبا عاصم","https://www.aldiwan.net/poem7123.html","الخفيف"],[45,"طيف الحبيب ألم من عدوائه","https://www.aldiwan.net/poem10198.html","الكامل"],[45,"طيف ألم فحيا عند مشهده","https://www.aldiwan.net/poem62737.html","البسيط"],[45,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[45,"أما لعيني طليح الشوق تغميض","https://www.aldiwan.net/poem64638.html","البسيط"],[45,"طيف تأوب من سعدى فحياني","https://www.aldiwan.net/poem66664.html","البسيط"],[45,"طيف لعلوة ما ينفك يأتيني","https://www.aldiwan.net/poem66689.html","البسيط"],[28,"شعثا شوازب قد طوى أقرابها","https://www.aldiwan.net/poem5483.html","الكامل"],[28,"قد بلغنا على مخشاة أنفسنا","https://www.aldiwan.net/poem5633.html","البسيط"],[49,"إني أرقت وذكر الموت أرقني","https://www.aldiwan.net/poem63163.html","البسيط"],[66,"طاف يسعى بسرعة ونشاط","https://www.aldiwan.net/poem38486.html","الخفيف"],[97,"خذ من طبيب الحي رأي النادي","https://www.aldiwan.net/poem24982.html","الكامل"],[80,"طيارة ولها فرخان واعجبا","https://www.aldiwan.net/poem31212.html","البسيط"],[80,"لا أركب البحر خوفا","https://www.aldiwan.net/poem31245.html","المجتث"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[69,"طيب الخمول يصدني","https://www.aldiwan.net/poem28701.html","مجزوء الرمل"],[69,"إن وادي الباب قد أذكرني","https://www.aldiwan.net/poem28833.html","الرمل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[31,"طال ليلي لسرى طيف ألم","https://www.aldiwan.net/poem41333.html","الرمل"],[31,"هاج ذا القلب منزل","https://www.aldiwan.net/poem41864.html","مجزوء الخفيف"],[31,"ألم طيف فهاج لي طربي","https://www.aldiwan.net/poem42616.html","المنسرح"],[31,"لَيتَ شِعري هَل أَذوقن","https://www.aldiwan.net/poem42624.html","مجزوء الرمل"],[31,"ما على الرسم بالبليين لو","https://www.aldiwan.net/poem42636.html","الخفيف"],[102,"طير الصبا ولى","https://www.aldiwan.net/poem33019.html","منهوك الرجز"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[50,"طيف خيال يعتريني زائرا","https://www.aldiwan.net/poem63813.html","الرجز"],[46,"يا ربة الخدر عدي ميتة وسنا","https://www.aldiwan.net/poem22662.html","البسيط"],[46,"رب درفس خلفه ذائب","https://www.aldiwan.net/poem23432.html","السريع"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85298","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142341","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[51,"غصنٌ من البان في وشاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=27401",""]],"verses":[["طَيِّبوا الأَردانِ إِن جالَستَهُم","قُلتَ دارِيّونَ قَد فَضّوا العِطارا",0,"ر",2,0],["طيبُ الهَواءِ وَطيبُ الرَوضِ قَد صَقَلا","لَوحَ الخَيالِ فَأَغراكُم وَأَغراني",1,"ي",1,0],["طَيْفٌ بِلا ظِلٍّ كَتُومُ الخُطَى","مَنْ يَعْتَرِضْ مَسْلَكَهُ يُرْدِهِ",2,"د",2,0],["طِيبٌ يُحَلِّبُ سُمّاً","فِي أنْفُسِ الْنَّاشِقِينَا",3,"ن",2,0],["طِيبُوا قَرَاراً أَيُّهَا الأَعْلامُ","وَعَلَى ثَرَاكُمْ رَحْمَةٌ وَسَلامُ",4,"م",1,1],["طَيَّبتَ مَن سَكَنَ الثَرى وَعَلا الرُبا","لَتَزَوَّدوهُ عُدَّةً لِنُشورِ",5,"ر",1,0],["طَيَّ بُرودِ اليَمَنِ الأَسمالِ","يَطرَحنَ بِالمَهارِقِ الأَغفالِ",6,"ل",1,0],["طَيِّبب الأصلِ طَيِّب العُودِ في البِن","يَة والفَرعِ يَثرِبِيُّ تَهَامِي",7,"م",2,0],["طيرُ الثناءِ محلقٌ في أفقه","أبدَ الزمان وأنني لمقصر",8,"ر",1,0],["طيفاً ألمَّ وما يظن بشاعر","قاضي القضاة سميعه إلا التقا",9,"ق",2,0],["طيفٌ تصيدته والليل محتبك","من حلية الشهب أو من شعره الحبك",10,"ك",1,1],["طيف كرى ما زال إلا غدت","ما الشرط للأحزان ما النافيه",11,"ف",3,0],["طيلسانٌ إذا تنفستُ فيه","صاحَ يشكو الصَّبا ويشكو الجنوبا",12,"ب",2,0],["طير تغني إذا تغنَّت","مهما أرادا بلا اقتراحِ",13,"ح",1,0],["طيلسان إذا تداعت خُرُوقٌ","بين أثنائه لهنَّ صُرَاخُ",14,"خ",1,0],["طَيٌّ ونشر لشوق لا كِفاء لهُ","وطلعةٌ منك فيها طيُّ إعسار",15,"ر",1,0],["طيُّ اللقاء له نشورُ","فليطوه الجلْد الصبورُ",16,"ر",1,1],["طيلسانٌ سامريٌّ","يتداعَىَ لا مِساسا",17,"س",2,1],["طيِّبٌ ريقُهُ إذا ذُقتَ فاه","والثريا بالجانب الغورِ قُرْط",18,"ط",1,0],["طيف عراني فحياني وأتحفني","بالنرجس الغض والتفاح إتحافا",19,"ف",2,0],["طِيُبها عند شمَّها يتقاضى","عضّها المُخْلصين من خُلّانِك",20,"ك",1,0],["طيزٌ رحيبٌ وفمٌ مثلُه","مُسْتَرقٌ من وجهِ جَريهْ",21,"ي",2,0],["طيَّر النومَ عن جُفوني خيالٌ","من حبيب فبتُّ أرعى الثُّريّا",22,"ي",2,1],["طيف ليلي بل ليس يبرح عيني","طيف ليلى في يقظتي ومنامي",23,"م",2,0],["طيب النفس لطيف ال","غرس غرس الأبوين",24,"ن",1,0],["طيبات تقدمتك إلى الأخ","رى وخير أقام في أعقابك",25,"ك",1,0],["طَيفُ الحَبيبِ أَلَمَّ مِن عُدَوائِهِ","وَبَعيدِ مَوقِعِ أَرضِهِ وَسَمائِهِ",26,"ا",3,1],["طَيفٌ أَلَمَّ فَحَيّا عِندَ مَشهَدِهِ","قَد كانَ يَشفي المُعَنّى مِن تَلَدُّدِهِ",27,"د",2,1],["طَيفٌ أَلَمَّ بِنا وَنَحنُ بِمَهمَهِ","قَفرٍ يَشُقُّ عَلى المُلِمِّ الخاطِرِ",28,"ر",1,0],["طَيفُ البَخيلَةِ وافانا فَنَبَّهَنا","بِعَرفِهِ أَم خِتامِ المِسكُ مَفضوضُ",29,"ض",1,0],["طَيفٌ تَأَوَّبَ مِن سُعدى فَحَيّاني","أَهواهُ وَهوَ بُعَيدَ النَومِ يَهواني",30,"ي",1,1],["طَيفٌ لِعَلوَةَ ما يَنفَكُّ يَأتيني","يَصبو إِلَيَّ عَلى بُعدٍ وَيُصبيني",31,"ي",1,1],["طَيرٌ تُبادِرُ رائِحاً ذا غَبيَةٍ","بَرداً وَتَسحَقَهُ خَريقَ شَمالِ",32,"ل",1,0],["طَيّارَةٌ كانَ لِلحَجّاجِ مَركَبُها","تَرى لَها مِن أَذاةِ المَوجِ أَعوانا",33,"ن",2,0],["طيبُ الحَياةِ لِمَن خَفَّت مَؤونَتُهُ","وَلَم تَطِب لِذَوي الأَثقالِ وَالمُؤَنِ",34,"ن",1,0],["طَيِّبُ النَشرِ يَجرَحُ اللَحظُ خَدَّي","هِ وَيُدمي أَعضاهُ مَسُّ القُباطي",35,"ط",2,0],["طَيِّبُ اللَفظِ لَو حَوَتهُ اللَآلي","جَعَلَتهُ الحِسانُ كَالأَقراطِ",35,"ط",1,0],["طيف من الماضي الكريم وصفحة","أخذت لها عهداً على الآباد",36,"د",1,0],["طَيّارَةٌ وَلها فَرْخانِ وَاعَجَبا","إذ لا تَزُفّهُما حتى تَرقّاها",37,"ه",2,1],["طينٌ أنا وهو ماءٌ","والطينُ في الماء ذائب",38,"ب",1,0],["طيبُهُ من نجيعه وهو مسكٌ","في عِذارَيْ مُهَذَّبٍ لَوْذَعِيِّ",39,"ي",1,0],["طِيبُ الخمول يصدُّني","عَنْ مدحِهِ بسوى الرموزِ",40,"ز",1,1],["طيرُها معرِبةٌ في لحنها","تطربُ الحيَّ كما تحيي الطربْ",41,"ب",1,0],["طَيِّبِ الريقِ إِذا ما ذُقتُهُ","قُلتُ ثَلجٌ شيبَ بِالمِسكِ الذَكي",42,"ي",1,0],["طَيفِ ريمٍ شَطَّهُ أَوطانُهُ","فَهيَ لَم تَدنُ وَلَيسَت بِأَمَم",43,"م",1,0],["طَيِّبُ النَشرِ واضِحٌ","أَحوَرُ العَينِ أَكحَلُ",44,"ل",1,0],["طَيفٌ لِهِندٍ سَرى فَأَرَّقَني","وَنَحنُ بَينَ الكُراعِ وَالخَرَبِ",45,"ب",1,0],["طَيِّبِ الريقَةِ وَالنَك","هَةِ كَالراحِ القَطيبِ",46,"ب",1,0],["طَيِّباتِ الأَردانِ وَالنَشرِ عيناً","كَمَها الرَملِ بُدَّناً أَترابا",47,"ب",2,0],["طيرُ الصَّبا ولى","وكان لي جارْ",48,"ر",1,1],["طَيِّبي أَنفُسٍ إِذا رَهِبوا الغا","رَةَ نَمشي إِلى الحُتوفِ القَواضي",49,"ض",2,0],["طَيفِ اِبنَةِ الحُرِّ إِذ كُنّا نُواصِلُها","ثُمَّ اِجتُنِنتَ بُها بَعدَ التِفِرّاقِ",50,"ق",1,0],["طَيَّ القَرارِيَّ الحِبَر","لَم تَتَقَعَّدها الطِيَر",51,"ر",1,0],["طَيفُ خيالٍ يَعتَريني زائِرا","لَمّا رَأَيتُ الدينَ حَظّاً وافِرا",52,"ر",2,1],["طَيفُ خيالٍ يَعتَريني زائِرا","وَالطَيفُ مِمّا أَن يَرِقَّ الذاكِرا",52,"ر",2,0],["طيبي ضَميراً بِأَمرٍ لا مَحيدَ لَهُ","يَلقاهُ بِالرَغمِ أَهلُ البَدوِ وَالحَضَرِ",53,"ر",1,0],["طَيفُ حِمامٍ زارَني في الكَرى","فَمَرحَباً بِالطَيفِ لَمّا أَلَم",54,"م",1,0],["طَيِّبو الباءَةِ سَهلٌ وَلَهُم","سُبُلٌ إِن شِئتَ في وَحشٍ وَعِر",55,"ر",1,0],["طَيِّبَةُ النَشرِ وَالبُداهَةِ","وَالعِلاّتِ عِندَ الرُقادِ وَالنَسَمِ",56,"م",1,0],["طينها من فالوذج لا يمل ال","مرء منه فهو اللذيذ الغزير",57,"ر",1,0],["طيران الحمام مهما تعالى","ليس ينجيه من دنوّ الحِمام",58,"م",1,0],["طيف الحَبيبة قد أَتى","في اللَيل يسمح بالوصال",59,"ل",1,0],["طيورَ السماء حَذَارِ الوقوعَ","على حَطبٍ في الثَّرى أو هشيمْ",60,"م",1,0],["طِيبي بِمَا حَلَّلْتِهِ","مِن المَحَلِّ الأَكْرَمِ",61,"م",1,0],["طَيْفُ غَادٍ مِنَ السَّحَابِ موَلٍّ","شَابَ فِي سَيْرِهِ صَفَاءَ غَدِيرِ",62,"ر",1,0],["طَيْفٍ يَشِفُّ بِهِ الْبِلَى","عَنْ رِفْعَةٍ وَتَمَنُّعِ",63,"ع",1,0],["طَيِّبَاتٌ قَدْ أَحْمَدُوهَا وَمَا فيِ","هَا مُرَاءٍ لِمَأْرَبٍ أَوْ مُرَادِي",64,"د",2,0],["طَيْرٌ أَبَابِيلٌ حِجَارَتُهَا اللَّظَى","تَدَعُ القُرَى فِي وَحْشَةٍ وَتَبَابَ",65,"ب",1,0],["طيف على أهدابها","كسرها تنقلا",66,"ل",2,0],["طيرُ المنيةِ صحْتَ أشأم صيحةٍ","وهززتَ شرَّ قوادِم وخوافِي",67,"ف",2,0],["طيف لشقراء كاس من متارفه","لو لم أصنه طغى وجدي فعرّاه",68,"ا",2,0],["طير تغني إذا تغنَّت","مهما أراد بلا اقتراحِ",69,"ح",1,0]]}