{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[9,"ألا حي ميا إذ أجد بكورها","https://www.aldiwan.net/poem21932.html","الطويل"],[90,"رويدك غورو أيهذا الجنيرال","https://www.aldiwan.net/poem44823.html","الطويل"],[29,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[49,"فلا تصفن الحرب عندي فإنها","https://www.aldiwan.net/poem25371.html","الطويل"],[53,"يا مددي حين خانني مددي","https://www.aldiwan.net/poem61907.html","المنسرح"],[40,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[87,"ما تيمس اففك إلا عقرب ذهبت","https://www.aldiwan.net/poem7293.html","البسيط"],[58,"أقصيتموني من بعد فرقتكم","https://www.aldiwan.net/poem58657.html","المنسرح"],[60,"فلا تصحب أخا الجهل","https://www.aldiwan.net/poem30813.html","الهزج"],[71,"والله لو صدقت ما قاله","https://www.aldiwan.net/poem28912.html","السريع"],[33,"يلومونني في غير ذنب جنيته","https://www.aldiwan.net/poem41816.html","الطويل"],[92,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[53,"عليَّ دينٌ ثقيلٌ أنتَ قاضيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30758",""],[119,"اذا المرء كان البطن والفرج همه","https://www.aldiwan.net/poem38733.html","عموديه"],[136,"واسكب مدمع العينين وأذر","https://www.aldiwan.net/poem54820.html","الوافر"],[227,"يسوم منا العداة ودا","https://www.aldiwan.net/poem55421.html","مخلع البسيط"],[265,"فلا تصفين الود من ليس أهله","https://www.aldiwan.net/poem1104.html",""],[305,"ألا ليت المنازل قد بلينا","https://www.aldiwan.net/poem45452.html","الوافر"],[358,"أشاقك صوت غنا الأورق","https://www.aldiwan.net/poem40020.html","المتقارب"],[371,"في خدها من مسكها حية","https://www.aldiwan.net/poem17026.html","السريع"],[371,"بداني بعتب مضجر لأقله","https://www.aldiwan.net/poem17064.html","الطويل"],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[463,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[463,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[463,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[463,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[466,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[466,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[482,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[498,"أفادت بك الأيام فرط تجارب","https://www.aldiwan.net/poem67422.html","الطويل"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[521,"ألا إن ليلى العامرية أصبحت","https://www.aldiwan.net/poem48615.html","الطويل"],[553,"ألا عتبت علي فصارمتني","https://www.aldiwan.net/poem1184.html",""],[592,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59610","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48927","الطويل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121221","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102512","البسيط"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82990","المجتث"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100218","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202730","البسيط"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28840","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89318","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62811","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91961","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131252",""],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119527","الطويل"],[4831,"الشيطان الأكبر","https://www.poetsgate.com/ViewPoem.aspx?id=208041",""],[4578,"بحبك برهان الغرام مسلم","https://www.poetsgate.com/ViewPoem.aspx?id=49522",""],[4978,"ما أشبه الجدّ في التحليق بالهزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=177194",""],[3208,"لقد جربت هذا الخلق حتى","https://www.poetsgate.com/ViewPoem.aspx?id=121090",""],[5431,"أنوحُ وقد نجا بالركبِ نوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=189541",""],[5616,"حوت","https://www.poetsgate.com/ViewPoem.aspx?id=203472",""],[5616,"قومي","https://www.poetsgate.com/ViewPoem.aspx?id=203485",""],[5703,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=216044",""],[6093,"تجربة ماء","https://www.poetsgate.com/ViewPoem.aspx?id=205456",""],[6102,"حَماقَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=183657",""],[5781,"أغرقتني بالحبِّ فذَبُلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87233&r=&rc=0",""],[463,"هلْ لقتيلٍ على اللِّوى ثائرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60089&r=&rc=145",""],[6320,"وَخْزُ الرِّمَاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84350&r=&rc=47",""]],"verses":[["فلا تَصْحَبْ مِنَ اللُّؤَماءِ وغْداً","يكونُ على عَشيرتِهِ عِيالا",0,"ل",2,0],["فَلا تَصرِميني وَاِسأَلي ما خَليقَتي","إِذا رَدَّ عافي القِدرِ مَن يَستَعيرُها",1,"ر",3,0],["فلا تصمن الحرب بعد انقضائها","بما هو للدنيا وللدين اخجال",2,"ل",1,0],["فَلا تَصرِميني أَن تَرَي رَبَّ هَجمَةٍ","يُريحُ بِذَمٍّ ما أَراحَ وَيَسرَحُ",3,"ح",1,0],["فَلا تَصِفَنَّ الحَربَ عِندي فَإِنَّها","طَعامِيَ مُذ بِعتُ الصِبا وَشَرابي",4,"ب",2,1],["فلا تصدَّنَّكَ الوِشاية عن","شدِّكَ أزْري ومُنَّتي ويَدي",5,"د",2,0],["فَلا تَصرِمي حَبلَ الدُهَيمِ جَريرَةً","بِتَركِ مَواليها الأَدانينَ ضُيَّعا",6,"ع",2,0],["فلا تصدّق عميد الاحتلال فما","من هؤلاء ولا من هؤلاء أنا",7,"ن",2,0],["فلا تَصُدُّوا فليسَ ذَا حَسَناً","أَنْ تُشْمِتُوا بالصُّدودِ أَعْدائي",8,"ا",3,0],["فَلا تَصحَب أَخا الجَهلِ","وَإياكَ وَاِيّاهُ",9,"ه",1,1],["فلا تصدِّقْ أنتَ ما قالهُ","أيضاً وخلِّ النارَ في قلبهِ",10,"ه",1,0],["فَلا تَصرِميني إِن تَرَيني أُحِبُّكُم","أَبوءُ بِذَنبي إِنَّني أَنا أَظلَمُ",11,"م",1,0],["فلا تصدّقْ فما في العيشِ منقصةٌ","لولا أضاليلُ غوغاءٍ ... ودهماء",12,"ا",2,0],["فلا تُصْعِني وتَجْني لي إضاعتَهُمْ","إيايَ لاضاع أمرٌ أنت راعيه",13,"ي",2,0],["فلا تصحبنه بل ولا تخش فقده","فما هو الا من عداد البهائم",14,"م",1,0],["فلا تَصُنِ الدُّمُوعَ بِها بَل أذرِ","بمَدمَعٍ مُستَهِلٍّ غَيرِ نَزرِ",15,"ر",1,0],["فلا تصدق لهم بودّ","كُلٌ عدوّ لنا مبين",16,"ن",1,0],["فَلا تُصفِيَنَّ الوُدَّ مَن لَيسَ أَهلَهُ","وَلا تُبعِدَنَّ الوُدَّ مِمَّن تَوَدَّدا",17,"د",2,1],["فَلا تَصلَي بِمَطروقٍ إِذا ما","سَرى في القَومِ أَصبَحَ مُستَكينا",18,"ن",2,0],["فَلا تُصفِ ودّكَ مِن أَحمَق","فَفَتق الحَماقة لَم يُرتقِ",19,"ق",1,0],["فلا تُصَدِّق عَنهُ إِغضاءَهُ","فَأَينَ لينُ الناظِرِ المُغضي",20,"ض",2,0],["فَلا تَصقُلِ السَيفَ الصَقيلَ فَإِنَّما","تُحَيِّفُ حَدَّيهِ بِتَكثيرِ صَقلِهِ",21,"ل",2,0],["فَلا تُصبْك من يدٍ ولا فمٍ","كائنةٌ أَفرَقُ أن تكونا",22,"ن",2,0],["فلا تُصبْني فيك عينُ حاسدٍ","له القذَى محدِّقاً ومطرِقا",23,"ق",2,0],["فلا تصبني فيك يدُ حادثٍ","أومضَ أو بارقُ خطبٍ أربَسا",24,"س",2,0],["فلا تُصبْني فيك المقادير بال","قاصد من سهمها ولا العائرْ",25,"ر",1,0],["فلا تصدَع الأيّامُ شملَ مَحاسنٍ","تُسافر مصحوباً بها وتؤوبُ",26,"ب",1,0],["فلا تصطلوها أنها دارميَّةٌ","مواقدها هامُ الملوكِ الأغالبِ",27,"ب",1,0],["فلا تُصْغِيَنْ إلا لقوليَ وحدَه","فأمُّ القَوافي بعد شِعْريَ عاقِرُ",28,"ر",1,0],["فلا تَصْرِفوا وجهَ المودَّةِ بعدما رأينا","زماناً في أساريرِه البشرا",29,"ر",2,0],["فَلا تَصطَفِ الإِخوانَ قَبلَ اِختِبارِهم","فَما كُلُّ خِلٍّ تَصطَفيهِ نَجيبُ",30,"ب",1,0],["فلا تصدي واعلمي بأنه","ما كل شاب بدا عواره",31,"ر",2,0],["فَلا تَصرِميني حينَ لا لي مَرجِع","وَرائي وَلا لي عَنكُم مُتَقَدَّم",32,"م",1,0],["فَلا تَصِلي بِصُعلوكٍ نَؤومٍ","إِذا أَمسى يُعَدُّ مِنَ العيَالِ",33,"ل",1,0],["فلا تصغ للنمام سمعك واحذرن","من الله إن الله عن ذاك حذرا",34,"ر",2,0],["فلا تُصرَعْ فما قَدَّر","تَهُ شرٌّ من الصَّرْع",35,"ع",1,0],["فلا تُصدّقْ عُروشاً","سُرعَانَ ما سوفَ تُجْرَفْ",36,"ف",1,0],["فلا تصدرُ الغاراتُ إلا ووردُها","نجيع وفجر اليوم نهر مفجر",37,"ر",1,0],["فلا تَصرفيني عن هواك فإنني","خُلقت له والودُّ غيرُ التودُّد",38,"د",1,0],["فلا تصحب سوى السّنّيّ ديناً","لتحمد ما نصحتك في المآل",39,"ل",1,0],["فلا تصدق اذا قالوا تناظره","لا يستوى سارق منا ومخترع",40,"ع",1,0],["فلا تصرفني العوامل","فلست مني ولست معرب",41,"ب",1,0],["فَلا تصدِّق بشيءٍ","مما يقولُ المنجِّم",42,"م",1,0],["فلا تصحبن الدهر إن كنت كيسا","فحسبك أن الدهر يخذل صاحبه",43,"ب",2,0],["فلا تصدّقْ سوى القرآن إن ذكروا","قولاً فآخره كذبٌ وأوّله",44,"ل",2,0],["فَلا تَصرِمَنَّ الدَّهرَ مَن قَد حَبَوتهُ","بِودِّكَ وَاِعلمْ أَهلَهُ حينَ تمنَحُ",45,"ح",1,0],["فلا تصدق مبدٍ تشوَّقه","ولم يَزُرْكَ وعذره الشاغل",46,"ل",1,0],["فلا تصحبِ الصّمْصامَ إنْ كنتَ صاحبي","نهيتُكَ عن خُلْقي وأنتَ مُخيَّرُ",47,"ر",1,0],["فلا تصاحب سوى حزمٍ وَتبصرةٍ","وَلا ترافق عَلى قَول سِوى العَمل",48,"ل",1,0],["فلا تصحب أخا ملقٍ خبيثاً","فصاحب كل ذي ملق يلام",49,"م",1,0],["فلا تصرفنّ الطرف في كل منظر","فإنّ معاريض البلاء كثير",50,"ر",1,0],["فلا تصدِّقوا ما قالَتْ وما وَعَدَتْ","فالوعْدُ عِنْدَ ذِئابِ الغَدْرِ منعدمُ",51,"م",1,0],["فلا تصرفه عن ودادك بالجفا","بلا سبب وأرحم لعلك ترحم",52,"م",1,0],["فلا تصدٌق يمينا من مسيلمةٍ","فليس ثمّ أبو بكرٍ وليس علي",53,"ل",2,0],["فلا تصحب لغير الله واهجر","سواه تفز بحق من يقينه",54,"ن",2,0],["فلا تصغوا لثعبانٍ قبيحٍ","سنهزمه وإنْ طال الفحيحُ",55,"ح",1,0],["فلا تصرخ بوجهي يا صديقي","فإن صراخ من بطروا مقيت!",56,"ت",1,0],["فلا تصدي رياح الفجر عن جسدي","دعي الرياح بهذا العطر تنسكب",57,"ب",1,0],["فلاتَصْحبَنَّ من الأصدقاءِ","إليك سوى أنقياء الضمائرْ",58,"ر",1,0],["فلا تصغي لمكرهم","فكم من ناصح مأفون",59,"ن",1,0],["فَلا تَصُدِّي فَهَذا الصَّدُّ مِحرَقَةٌ","وَالزَّجرُ فِيها وَقُودٌ, وَالخِصامُ مَسَدْ",60,"د",1,0],["فلا تُصْدِقوهُ القَوْلَ إنِّي أحبُّهُ","وإنِّي إلَيْهِ كَالصَّلاةِ لِخالِقِ",61,"ق",1,0],["فلا تصبني فيكَ المقاديرُ بال","مقاصدِ منْ سهمها ولا العاثرْ",62,"ر",1,0],["فَلاَ تُصْغِي لَنَجْوَانَا الرَّوَابِي","وَوَشْوَشَةُ السَّنَابِلِ وَالأَقَاحِي",63,"ح",2,0]]}