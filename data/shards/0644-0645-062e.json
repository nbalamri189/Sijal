{"poems":[[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[75,"في جواركم الذليل","https://www.aldiwan.net/poem11933.html","الوافر"],[99,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[370,"يا ذا الذي مرج البحرين خاطره","https://www.aldiwan.net/poem17154.html","البسيط"],[507,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18047","الطويل"]],"verses":[["لَمَخائِلُ مُلْكِكَ تُخْبِرُني","أنّ التّأبيدَ لَها خُلِقا",0,"ق",2,0],["لَمُختَلِفانِ مِن حالَيَّ مَهما","أَجالَ الفِكرَ بَينَهُما مُجيلُ",1,"ل",1,0],["لم خليتني وباعدت مسرا","ك ومالي إلى ذراك ارتقاء",2,"ا",2,0],["لِم خَمرَةُ الرومِ تَنهى اليَومَ سائِلَها","وَقَد سَنَنتَ إِلَينا خَمرَةَ العَرَبِ",3,"ب",1,0],["لمخلصه حقا وان قل ذكره","بنسبه امر المنى متساهل",4,"ل",1,0],["لِمُختَبِطٍ مِنكُم كَأَنَّ ثِيابَهُ","نُبِشنَ لِحَولٍ أَو ثِيابِ مُقَدِّسِ",5,"س",1,0]]}