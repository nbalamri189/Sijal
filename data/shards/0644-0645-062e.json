{"poems":[[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[75,"في جواركم الذليل","https://www.aldiwan.net/poem11933.html","الوافر"],[99,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[371,"يا ذا الذي مرج البحرين خاطره","https://www.aldiwan.net/poem17154.html","البسيط"],[509,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122376","الخفيف"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96354","الطويل"],[1423,"","https://poetry.dctabudhabi.ae/diwan/poem/126304","الوافر"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18047","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26232","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["لَمَخائِلُ مُلْكِكَ تُخْبِرُني","أنّ التّأبيدَ لَها خُلِقا",0,"ق",2,0],["لَمُختَلِفانِ مِن حالَيَّ مَهما","أَجالَ الفِكرَ بَينَهُما مُجيلُ",1,"ل",1,0],["لم خليتني وباعدت مسرا","ك ومالي إلى ذراك ارتقاء",2,"ا",2,0],["لِم خَمرَةُ الرومِ تَنهى اليَومَ سائِلَها","وَقَد سَنَنتَ إِلَينا خَمرَةَ العَرَبِ",3,"ب",1,0],["لمخلصه حقا وان قل ذكره","بنسبه امر المنى متساهل",4,"ل",1,0],["لم خدعت العقول رقا ورفقا","واخذت القلوب اخذا وبيلا",5,"ل",2,0],["لمُخبرُكَ الانباءَ عن أمٍّ منزلٍ","تَضيّفتها بين العُذيبِ فراسِبِ",6,"ب",1,0],["لمختار الصحاح على الألبا","عوارف حق أن ترعى وتشكر",7,"ر",1,1],["لِمُختَبِطٍ مِنكُم كَأَنَّ ثِيابَهُ","نُبِشنَ لِحَولٍ أَو ثِيابِ مُقَدِّسِ",8,"س",1,0],["لِمُختَلِفِ الحاجاتِ جَمعٌ بِبابِهِ","فَهَذا لَهُ فَنٌّ وَهَذا لَهُ فَنُّ",9,"ن",1,1],["لِمَخاوُونَ أَسقَلِيبَ النِّطاسي","سِرو أَحضِرهُ مُسرِعاً خَيرَآسِ",10,"س",1,0],["لِمُخْتَلَفِ الْأَحْيَاءِ رِزْقٌ مُقَسَّمٌ","وَ رِزْقُكَ كَاللَّيْثِ الشَّجَاعَةُ وَ الْجِسْمُ",11,"م",1,0]]}