{"poems":[[57,"إني لأطوي الهوى كي لا يطيف به","https://www.aldiwan.net/poem26317.html","البسيط"],[74,"أذكى سنا البرق في أحشائه لهبا","https://www.aldiwan.net/poem18234.html","البسيط"],[47,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[68,"جن الظلام فمذ بدا مبتسما","https://www.aldiwan.net/poem40643.html","الكامل"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[52,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[214,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[416,"هاجت هواك بواكر الأظعان","https://www.aldiwan.net/poem67466.html","الكامل"],[443,"أمّا الخليط فبان غير مودع","https://www.aldiwan.net/poem2555.html","الكامل"],[457,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[463,"ما أنتِ بعد البين من أوطاني","https://www.aldiwan.net/poem55853.html","الكامل"],[470,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[520,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[1394,"","https://poetry.dctabudhabi.ae/diwan/poem/199966","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48248","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65952","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138542",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138445",""],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102733","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4755,"رَحَلَت يَدَاكِ.. فَأَينَ أَختَبئُ","https://www.poetsgate.com/ViewPoem.aspx?id=184119",""],[4767,"غارة الذئاب","https://www.poetsgate.com/ViewPoem.aspx?id=178790",""],[5072,"لن أشتري الأحلامَ من أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=53684",""],[5107,"في لحظة يأ س","https://www.poetsgate.com/ViewPoem.aspx?id=34342",""],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""],[5594,"أتاك قول مهيب غير مهتضم","https://www.poetsgate.com/ViewPoem.aspx?id=201053",""],[520,"لو اطلعت على سري وإضماري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577530",""]],"verses":[["حَتّى أَغُمَّ بِمَن لا أَشتَهي بَصَري","عَمداً وَأَصرِفَ عَمَّن أَشتَهي البَصَرا",0,"ر",2,0],["حتَّى اغْتدى الدُّرُّ في أسلاكه صدفاً","والمندل الرطب في أوطانِهِ حطبا",1,"ب",2,0],["حَتّى أُغادِرُهُ لَحماً عَلى وَضَمٍ","أَنحى عَلى حَلقِهِ ساطورُ جَزّارِ",2,"ر",1,0],["حَتّى اِغتَدى مِن ساعِدَيَّ مُوَشَّحاً","وَمُقَلَّدا وَقَدِ اِعتَراهُ حَياءُ",3,"ا",2,0],["حَتّى أُغادِرَ كُلَّ يَومٍ بِالفَلا","لِلطَيرِ عيداً مِن بَناتِ العيدِ",4,"د",1,0],["حَتّى اِغتَمَسنَ ضُحىً في آلِ قَرقَرَةٍ","سَقياً لَهُنَّ وَلِلصَمدِ الَّذي صَمَدوا",5,"د",3,0],["حتَّى اغْتَدتْ زهَراتُها","كالغِيدِ باللُّججِ العوائِمْ",6,"م",1,0],["حَتَّى اغْتَدَى ذاك الْعِرَا","كُ كَأَنَّهُ بَعْضُ المَجَازِرْ",7,"ر",1,0],["حتى اغتدى الدر في سلاكه صدفا","والمندل الرطب في اوطانه حطبا",8,"ب",2,0],["حتى اغتررْتُ بآمالٍ مزَخْرَفَةِ","وما ظننتُكَ تنسى حقَّ معرفتي",9,"ي",1,0],["حَتّى أَغَرنَ بِحَضرَموتَ شَوازِباً","مُقوَرَّةً كَكَواسِرِ العِقبانِ",10,"ن",1,0],["حتى اغتدت منه البطارق عنوة","في الحرب بين تكبّلٍ ومكنّع",11,"ع",1,0],["حتى اغتدت زمنُ الهُمام محمدٍ","روضَ القريض وموسم المدّاح",12,"ح",1,0],["حتى اغتررتُ فزرتُكم وكأنني","كَلٌّ طَرقتُ بمنكِبَيْ ثهلانِ",13,"ن",1,0],["حتى أغص بصوتي، ثم تطلقه","هذي الأبوة في عينيك والنبل!",14,"ل",1,0],["حتى أغار على وفري فصيره","ممزقاً بين أيدي الغز والنار",15,"ر",1,0],["حتى اغتدت بالحب فيه صدورها","ملأى وأخلص في الولاء ضميرها",16,"ر",3,0],["حتَّى اغتدى الطَّرْفُ من أسْنَى طرائفِها","يروِّض الحمدَ معروشاً ومغروسا",17,"س",2,0],["حَتَّى اغتَدَت أرجَاؤهُ بِدُعَائِهِ","فِي عِزَّةٍ وَحِمَايَةٍ وَصِيَانِ",18,"ن",1,0],["حتى أغاظ وأقمى كل مرتدد","مهلاً يا أولي الحسد",19,"د",1,0],["حتى اغتدى عرض السها","م لكل ضليل وناكب",20,"ب",1,0],["حتى اغتدت تعرف آباؤه","أباً وأماً بالسنا في الملا",21,"ل",2,0],["حتى اغتدت في زينة العروس","وغاب عنها كوكب النحوس",22,"س",1,0],["حتى اغتدوا وهما كأن عقولهم","سلبت بسحر للعقول متاح",23,"ح",1,0],["حتى اغتدت كهلال الشك ناحلة","من الوجا وتشكت شدة الحقب",24,"ب",1,0],["حَتَّى أغانِيكِ التي انتَظَرَت","مِثلِي, غَدَت بالصَّمتِ تَمتلِئُ",25,"ا",1,0],["حتى أغاروا بليلٍ","هز البلادَ ارتجاجا",26,"ج",2,0],["حتى اغترابي مل َّ خربشتي ولم","يجد الهناء َ لكي يطيب َ ويشكمَهْ",27,"م",2,0],["حتى أغانيكَ لم يُسمعْ لهن صدى","في عالم ساده التهريج والدجَل",28,"ل",1,0],["حتى اغتدى نهج لهدى كالشمس لا","يخفيه قول من مريب شائن",29,"ن",1,0],["حتّى أغادرها صرعى ومن لمن","بين المنازل والأموال والحرم «3»",30,"م",1,0],["حتى أغار على وفري فصيره","مقسماً بين أيدي الغز والنار",31,"ر",1,0]]}