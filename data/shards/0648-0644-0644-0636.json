{"poems":[[65,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[215,"تعرضن للشمس المضيئة جهرة","https://www.aldiwan.net/poem46275.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38922","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38974","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93135","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79819","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71084","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62890","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86301","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[5365,"تراتيل في محراب الألم","https://www.poetsgate.com/ViewPoem.aspx?id=191272",""]],"verses":[["وللضّيْفِ حَقٌّ وعَمْرو العُلا","يَعُدُّ الحقوقَ عليهِ دُيونا",0,"ن",2,0],["وللضعف أحيانا على الفتك قدرة","كما تفتك الصهباء بالأصيد الحر",1,"ر",1,0],["وَلِلضدِّ فيهِ مِثلما قيلَ مَدخَل","وَإِنّي لأَرجو اللَّه أَن يُهلِكَ الضِّدّا",2,"د",2,0],["وَلِلضّلالِ قَد صَغَوْا","وَحارَبونا مُعتَدينْ",3,"ن",1,0],["وللضمير قد يكون ثم بين","فعليّة واسميّة في الجملتين",4,"ن",1,0],["وللضيف حقٌ أن يعز ويكرما","وعرضت للشكوى لهم متظلما",5,"م",2,0],["وللضاريات الساغبات برزقها","قناهم بمستن النزال كوافِلُ",6,"ل",1,0],["ولِلضُّمَّر القُبِّ التي حَمَلَتْكُمُ","بوادِرُ في كلّ الصُّؤُول قِيامُ",7,"م",1,0],["وللضَّرْبِ هَزْهَازٌ وللطعن عاسِلٌ","وللرحْلِ شَوْشاةٌ وللرَكضِ خَيفَقُ",8,"ق",1,0],["وَلِلضرورات حالٌ لا تَشفَعُهُ","مِن بَعد ما كُنت اِمشي في الهَوى مَرِحاً",9,"ح",2,0],["وللضرورات حالٌ لا تُشفِّعُهُ","لم أنسَ والعينُ سَكرَى والفؤادُ صحا",10,"ح",2,0],["وللضرورية كان الممكنة","رفعا كذا مطلقة للدائمة",11,"ه",1,0],["وللضيف أكرمْ لا تخف قط فاقَةً","فلله فضلٌ في الورى وصنائعُ",12,"ع",1,0],["وللضّريرِ الذي عاد الضّياءُ لهُ","عيناهُ جمرُُ وقد رقّتْ نداءاتي",13,"ت",2,0]]}