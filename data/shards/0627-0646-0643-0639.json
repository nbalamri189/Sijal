{"poems":[[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67349","المتقارب"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126193","الرجز"],[491,"","https://poetry.dctabudhabi.ae/diwan/poem/17476","المنسرح"],[5705,"إنَّكِ عَيْنٌ حَذِلَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=4537",""]],"verses":[["إِنَّكِ عَمْرُ أَبيكِ الكَرِي","مِ إنْ تَسْأَلِي عَنْكِ مَنْ يَجْتدِينا",0,"ن",2,1],["إنَّك عالمٌ إلهى إنَّنى","إن لم تَدُم لى طاعةٌ لكنَّنى",1,"ن",2,0],["إِنَّ كُعَيباً عَبدٌ لِغَيرِكُم","وَالحَقُّ فيهِ لِأَمرِكُم نَصَفُ",2,"ف",1,0],["إنَّكِ عَيْنٌ حَذِلَتْ مُضَاعَهْ","حيٌ تَرَوْهُ كاشِفَاً قِنَاعَهْ",3,"ه",1,1]]}