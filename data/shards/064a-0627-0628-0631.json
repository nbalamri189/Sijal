px?id=121943",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5183,"روضة الشجو","https://www.poetsgate.com/ViewPoem.aspx?id=185676",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5186,"يا بروحي لاعبات التنس","https://www.poetsgate.com/ViewPoem.aspx?id=156500",""],[5198,"بارق الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=135382",""],[5232,"عصفورة الينبوع","https://www.poetsgate.com/ViewPoem.aspx?id=213769",""],[5277,"البصرة..البلحُ المالحُ","https://www.poetsgate.com/ViewPoem.aspx?id=199865",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5401,"السندان والطارق","https://www.poetsgate.com/ViewPoem.aspx?id=78140",""],[5409,"وطني لأجلك قد عدمت قراري","https://www.poetsgate.com/ViewPoem.aspx?id=155272",""],[5431,"بكتاب عشقي اودعتْ كي أفتحه !!","https://www.poetsgate.com/ViewPoem.aspx?id=197671",""],[5431,"لامنتهى بدمي الاك مبتدأ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197789",""],[5431,"الراحمون غمائم الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=200691",""],[5582,"يا بَرْقُ حَيِّ الأَبْرَقَيْنِ فَثَهْمَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63492",""],[482,"خلا مِنَ القومِ مصطاف ومرتبعُ","https://www.poetsgate.com/ViewPoem.aspx?id=111303",""],[5595,"حكامُنا نوّابُنا نيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=144526",""],[5652,"ماملّ منهو يرقب الصبح عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=177965",""],[5781,"وارفةُ العشقِ...أنا","https://www.poetsgate.com/ViewPoem.aspx?id=190949",""],[5781,"نَصْرٌ ووعد","https://www.poetsgate.com/ViewPoem.aspx?id=190950",""],[5781,"نَصرٌ وَوعْد","https://www.poetsgate.com/ViewPoem.aspx?id=202828",""],[5790,"حدث فقد حدثتنا دوحة السلم","https://www.poetsgate.com/ViewPoem.aspx?id=112141",""],[5790,"شم برق رامةَ قد أتاك رسولا","https://www.poetsgate.com/ViewPoem.aspx?id=112109",""],[5848,"يادلعها","https://www.poetsgate.com/ViewPoem.aspx?id=48987",""],[5969,"سر الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=199208",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6099,"قانأ","https://www.poetsgate.com/ViewPoem.aspx?id=35798",""],[6218,"الخزيُ للشعراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65910&r=&rc=63",""],[463,"ما المجدُ إلا بالعزيمة فاعزمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60294&r=&rc=350",""]],"verses":[["يا بَرقُ إِن صُبتَ الحِمى","فَلا تَصُب إِلّا بِدَم",0,"م",1,0],["يا بَرَّةً بِالوالِدَي","نِ أَبوكِ بَعدَكِ لا يَقِرّ",1,"ر",1,0],["يا بَردُ فَاِحمِل قَد ظَفِرتَ بِأَعزَلٍ","يا حَرُّ تِلكَ فَريسَةِ المُغتالِ",2,"ل",1,0],["يا بَرقُ حَيّ إِذا مَرَرتَ بِعزَّتا","أَهلي وَإِن زادوا جَفاً وَتَعَنُّتا",3,"ت",2,1],["يا بُرقُع الخلقة واهاً لما","فيك وآهاً منك يا برقع",4,"ع",1,0],["يا بروقاً على ربى يبرين","أيّ بيض أغمدتَ بين جفوني",5,"ن",2,1],["يا بَربَروسُ عَلى ثَراكَ تَحِيَّةٌ","وَعَلى سَمِيِّكَ في البِحارِ سَلامُ",6,"م",1,0],["يا بَرقُ أَفرِط في اِعتِلائِك","أَو صُب بِجودِكِ وَاِنهِمائِك",7,"ك",1,1],["يا بَرقُ أَسفِر عَن قُوَيقِ فَطُرَّتى","حَلَبٍ فَأَعلى القَصرِ مِن بِطياسِ",8,"س",1,0],["يا بَرزَخَ المَوتى الَّذي نَزَلوا بِهِ","فَهُمُ رُقودٌ في ثَراهُ خُفوتُ",9,"ت",1,0],["يا بَرقُ طالِع مَنزِلاً بِالأَبرَقِ","وَاِحدُ السَحابَ لَهُ حُداءَ الأَنيُقِ",10,"ق",1,1],["يَأبِرُ غَرسَ الكَلامِ فيكَ فَخُذ","وَاِجتَنِ مِن زَهوِهِ وَمِن رُطَبِه",11,"ب",2,0],["يا برقُ قلْ لي ويا سطرَ السحابِ ترى","السيف أصدقُ أنباءً أمِ الكتبُ",12,"ب",1,0],["يا بَرقُ أَبرِقَ مِن قُرَي","بَةَ مُستَكِفّاً لي نَشاصُه",13,"ص",2,1],["يا بريدَ النّيل إن جئتَ الشآما","فاقضِ للأهلين عن مصرَ الذِّماما",14,"م",2,1],["يا بَريدَ الدَهرِ يَمشي خِفيَةً","في ضَميرِ الغَيبِ ماذا تَحمِلُ",15,"ل",1,1],["يا بَرقُ حَيِّ عَلى السَحابِ مَنازِلاً","تَسقي حَيا البَينِ الرِفاقَ الغُيَّبا",16,"ب",2,0],["يا بَرَّةً لَمّا اِنطَوى إِحسانُها","تاقَت إِلَيهِ الصُحفُ وَالأَقلامُ",17,"م",1,0],["يا بَرْدَ أَكْبادٍ أصابَ عِطاشَها","ماءٌ بِريق مُحَمَّدٍ مَجْدُوحُ",18,"ح",1,0],["يا بَردَهُ مِنْ حَيا مُزنٍ على كَبِدٍ","نِيرانُها بِغليلِ الشَّوْقِ تَسْتَعِرُ",19,"ر",1,0],["يا برق إنك يا بر","ق عارف بنزوعي",20,"ي",1,0],["يا برق حرك همومي ان تكن سكنت","فكل حظي تحريك واسكان",21,"ن",1,0],["يا برق هل والحنايا من ضعاضع قاد","التام فالطف حياهن هتان",21,"ن",1,0],["يا براميل القمامات ، إلى","أين تمضين ..؟ إلى درو الثقافه",22,"ف",2,0],["يا بريطانيا وقد هيّىء المي","دان هيّا إلى العراك العنيد",23,"د",1,0],["يا بُرجَ مفْخَرةِ الأجداث لا تهِني","أنْ لم تكُوني لأبراج السَّما قُطُبا",24,"ب",2,0],["يا بَرْقُ! أسفِرْ عَنْ قُوَيْقَ، فطُرّتَيْ","حَلَبٍ، فأعلى القَضرِ منْ بَطْيَاسِ",25,"س",1,0],["يا بروحي في رحبه شطحات","عابقات قرنفلا وخزاما",26,"م",2,0],["يا برقُ طارحني أحادينهم","فهات تطويلاً وهاك اختصار",27,"ر",1,0],["يا بِرُوحي كلّما هبّت صبا","نفحةٌ أَنشقُها مِن عطرها",28,"ه",2,0],["يا برقُ واِسر إلى سلعٍ بجاريةٍ","مِنها على الرأسِ حلوُ القطرِ محمولُ",29,"ل",1,0],["يا برقُ أشبهتَ ثغرَ الحبّ مُبتسماً","هَل منكَ يا برقُ للأعتاب تقبيلُ",29,"ل",1,0],["يا برقُ واِشرح لِسادتي وإِن علموا","مَعنى المُعنّى وما بالشرحِ تطويلُ",29,"ل",1,0],["يا برقَ نجدٍ هل شعرت بِمُتْهِمِ","وهبَ الكرى لوميضكَ المتبسمِ",30,"م",1,1],["يا برء كلِّ سقامٍ","يا عزَّ كلِّ هوانِ",31,"ن",1,0],["يا بريقاً بالحمى قد لمعا","حي عني البان والاثل معا",32,"ع",2,1],["يا بَرقُ أَنتَ قَريبُ العَهدِ مِن سَلَمٍ","قِف بُثَّ لي خَبَراً حُيّيتَ مِن آتِ",33,"ت",1,0],["يا بَرقُ هَل رَبَّةُ الخالَينِ ذاكِرَةٌ","بَعد البِعادِ لَنا عَهداً وَميثاقا",34,"ق",2,0],["يا بَرق نُعمانِ الأَراكِ سَقى الحَيا","زَمَناً نَعِمتَ بِهِ عَلى نَعمانِ",35,"ن",1,0],["يا بَرقُ إِن جُزتَ الدِيارَ بِإربلٍ","وَعلا عَلَيكَ مِنَ التَداني رَونَقُ",36,"ق",1,0],["يا بَريءَ العَطاءِ مِن كَدَرِ المَط","لِ إِذا كَدَّرَ العَطاءَ المِطالُ",37,"ل",1,0],["يا بَردَها تَسليمَةً قَلَّبَت","قَلبَ أَخي الشَوقِ عَلى الجَمرِ",38,"ر",1,0],["يا بروحي افتدي ذاك البها","حيث أضحى منه بالصبّ اعتِنا",39,"ن",2,0],["يا برقُ طالع قصوراً أهلُها رحلوا","وحيّ أجداثَ أبطالٍ مُنيخينا",40,"ن",2,0],["يَا بَرْحَ شَوْقِي لِلذينَ تَحَمَّلُوا","وأَقامَ حُبُّهُم بِقَلْبِي يَرْبَعُ",41,"ع",1,0],["يا بَريقَ الحَيا وَيا عَذبَ البا","نِ لَقَد هجتُما لِقَلبيَ وَجدا",42,"د",2,1],["يا بَريقاً لاحَ من حيِّهمُ","يَصدعُ الجوَّ ضياءً واِبتلاجا",43,"ج",2,0],["يا برق بلغ رسالتي فمها","إن أنكرتني فصف لها عللي",44,"ي",1,1],["يا برق لا تتشبه لي بمبسمهم","فإن تلك الثنايا دونها اللولو",45,"و",1,1],["يا برق لا تبتسم من ثغره عجبا","قد فات معناك منه الظلم والشنب",46,"ب",1,0],["يا برق حمة ما فعلت على البلى","لا زلت يصحبك الغمامُ سديدا",47,"د",2,0],["يا بَرْقُ لم يَقدَحْ زِنادُك مَوْهِناً","إلا ليُوقِعَ في حشايَ لهيبا",48,"ب",2,0],["يا بَركاتِ الدينِ يا عِزَّهُ","صِدقاً إن الألقاب لم تَصدقِ",49,"ق",1,0],["يا برجَ داود لا تنفكُّ مُحدِقةً","به الحمائمُ في الأسحار تَتْرنَّمْ",50,"م",1,1],["يا بُرَيقا بِتُّ أَرقُبُه","كانِساً في المُزنِ محتَجِبا",51,"ب",2,0],["يا بَرْقَ نعمانٍ أفِقْ حتّى مَتى","وإلى مَتَى الأرعادُ والإِبراقُ",52,"ق",1,0],["يا بروحي تلكم العيس التي","كم يدا سرت إلى الركب يداها",53,"ا",3,0],["يا بروحي ذلك السفح الذي","سفحت فيه من البدن دماها",53,"ا",3,0],["يا بروحي عيشاً مضى في رباكم","كل ساعاته لديكم أصيل",54,"ل",1,0],["يا برهمي الشرع رَبِّيَ الذي","لصيد بر ولبحر أباح",55,"ح",1,1],["يا برق زُرْسُوحَ الحمى","واسقه يا سحب",56,"ب",1,0],["يا برقُ سلِّم على حيٍّ بذي سَلَمٍ","وجُز بأحياء ميثاء وحيِّيها",57,"ي",3,0],["يا برقُ سُقْ حَيا السّحابِ الأبرَقا","فلقَدْ حكَيْتَ فؤادَ صبٍّ شيّقا",58,"ق",2,1],["يا برق أذكرتني ما لا نسيت أعد","فمؤمن الحبّ بالذكرى قد انتفعا",59,"ع",2,0],["يا بِرُوحي فارساً علقته","خَنِث التهييفِ مَعْسول الدلالِ",60,"ل",1,1],["يا برقَةَ الفَودينِ إني لم أزل","للبرق من خللِ الخطوب أشيمُ",61,"م",1,0],["يا بردَ أحشائي صبيحةَ قيل لي","هذا الوزير فطب صباحاً وانعَمِ",62,"م",1,0],["يا بروحي أظمى براحته","الراح فمالي أذاد عنها وأظما",63,"م",2,0],["يا برقُ كم هجتَ لهم من جوًى","باتتْ عليه تنطوي الأضلعُ",64,"ع",1,0],["يا برقُ قد باتَ قلبي كلَّما لمعتْ","منكَ الشرارةُ يحكيها تلهبُّهُ",65,"ب",2,0],["يا بروحي وروح كلِّ لبيبٍ","عدلهم والعلوم والإلهام",66,"م",1,0],["يا بَرْقُ أحْبابُ قَلبي","بالهَجْرِ قلبي أضاعوا",67,"ع