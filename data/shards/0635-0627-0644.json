https://www.poetsgate.com/ViewPoem.aspx?id=72394",""],[5493,"هذي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=197567",""],[5900,"باسمكِ اللهمَّ يا ربَّ العبادْ","https://www.poetsgate.com/ViewPoem.aspx?id=150189",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[6068,"صال الفؤاد محطّة محزانا","https://www.poetsgate.com/ViewPoem.aspx?id=180371",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6184,"رقصة في ازمير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78622&r=&rc=14",""],[6213,"الناس أسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76273&r=&rc=30",""],[6255,"الحُزْنُ جَادَ أَبًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80883&r=&rc=11",""]],"verses":[["صَالِحَةٌ لِلْبَقَاءِ سَالِمَةٌ","جُسُومُهَا وَالعُقُولُ مِنْ سَقَمِ",0,"م",1,0],["صالحٌ للفتى إذا اشتاق في الصي","ف إلى لبس فاخراتِ الخُزوز",1,"ز",1,0],["صالَ بالمشرفيِّ صولاتِ صِدْقٍ","لم تدعْ فيهم لذي الذَّحل ذحلا",2,"ل",2,0],["صالِحَةٌ لِلحُبِّ مِن","كُلٍّ وَلِلتَبَرُّكِ",3,"ك",1,0],["صالِحُ الإِخوانِ يَبغيكَ التُقى","وَرَشيدُ الكُتبِ يَبغيكَ الصَوابا",4,"ب",2,0],["صَالوا على ضَعْفِي بقوَّتِهمْ","ما هكذا يتعاشَرُ الصحبُ",5,"ب",1,0],["صالوا فَنالوا الأَماني مِن عُداتِهِمِ","بِبارِقٍ في سِوى الهَيجاءِ لَم يُشَمِ",6,"م",1,0],["صالَحَتني الأَيّامُ بِالقُربِ مِنهُ","بَعدَما كُنتُ مِنهُ صِفرَ اليَدَينِ",7,"ن",1,0],["صالَ فينا الرَدى جَهاراً نَهاراً","فَكَأَنَّ المَنونَ تَطلُبُ ثارا",8,"ر",2,1],["صالَ المُغيرُ عَلَيها صَولَةً عَجَباً","ما صالَها قَبلَهُ جِنٌّ وَلا بشرُ",9,"ر",1,0],["صالوا عَلى الدَهرِ بِاللَهوِ الَّذي وَصَلوا","فَلَيسَ حَبلُهُمُ مِنهُ بِمَبتوتِ",10,"ت",1,0],["صالِياتٍ وَما لَها مِن صَلاةٍ","صائِماتٍ لِغَيرِ نُسكٍ تُواصِل",11,"ل",1,0],["صالحيني يا نفس فالصلح لو فك","رت في الأمر سيّد الأحكام",12,"م",1,0],["صَالحاً قَد لَفَّهَا فاستَوسَقَت","لَفَّ بَازِيٍّ حَمَاماً في سَلَم",13,"م",1,0],["صَالَ الشَّقَاءُ عَلَى فَرِيدٍ صَوْلةً","بَيْنَ الْجَوَانِحِ أَنْذَرَتْ بِدَمَارِ",14,"ر",1,0],["صَالَتْ عَلَى الدُّنْيَا بِهِ فِينِيقِيَا","قِدْماً وَنِعْمَ الفَخْرُ لِلأَجْدَادِ",15,"د",1,0],["صَالَ مَا صَالَ ظَافِراً بِعِدَاهُ","وَعَدَاهُ الشرُورُ وَالآثَامُ",16,"م",1,0],["صَالَ بِالرَّأْيِ قَاسِمٌ لاَ يُبَالِي","ومَضَى فِي طَريقِهِ غَيْرَ آبِهْ",17,"ب",2,0],["صالوا برمح ذابل ومهندٍ","عضْبٍ، ونعجز أن نصول بمبرد",18,"د",1,0],["صال العدى فقست صلود صفاته","وسرى الندى فاهتز منه وريقه",19,"ق",2,0],["صالَ المشرفيُّ صولاتِ صِدْقٍ","لم تدعْ فيهم لذي الذَّحل ذحلا",20,"ل",2,0],["صالِحاً قَد لَفَّها فَاِستَوثَقَت","لَفَّ بَأزِيٍّ حَماماً في سَلَم",21,"م",1,0],["صالح لِلخَير لَما أَن بَنى","مُخلِصاً خانا بِفعل مُتقَنِ",22,"ن",1,1],["صَالَ الزَّمانُ بِهِ عَلى أَحْدَاثِهِ","حَتَّى كَأَنَّ لَهُ عَلَيْهِ دُيُونا",23,"ن",2,0],["صال قلبي صال","وأنت لا تسمع",24,"ع",1,0],["صالَحتَ ما بَينَ السُهادِ وَناظِري","مُذ قيلَ أَنَّكَ مُعرِضٌ غَضبانِ",25,"ن",1,0],["صالَحتُ ما بَينَ السُهّادِ وَناظِري","لَمّا رَأَيتُكَ مُعرِضاً غَضبانا",26,"ن",2,0],["صالَحَني مِن بَعدِ ما","عَذَّبَ قَلباً ما صَلَح",27,"ح",1,0],["صالحيني منيتي في ال","عمر يوما من زماني",28,"ن",2,0],["صالَتْ تُحَاوِلُ صَيْدُهُ لَحظَاتُهُ","وَرَمَاهُ مِنْ جَفْنَيِهِ ما أَصْمَاهُ",29,"ا",2,0],["صالُوا صُقوراً بِخِزَّازٍ جَثَتْ فرقاً","وَطَالَما صَرْصَرَتْ في الحَرْبِ عِقْبانا",30,"ن",2,0],["صالَ عَلى قَولي مُغيراً كَما","صالَ أَبو جَعدَةَ في سَرحِ ضان",31,"ن",1,0],["صالَ جَيش الفُراق فينا فَما اِن","قَد وَجَدنا عَلى الفُراق اِنتِصارا",32,"ر",2,0],["صالت عليه يد البلا","يا فراح منهوبَ النفائس",33,"س",1,0],["صالوا وجالوا بطنَ كلِّ تنوفةٍ","يضحي بها الخِرِّيتُ غِمْراً نادبا",34,"ب",2,0],["صال باللحظ على عشاقه","ولَكَم من كرّةٍ في الحب كرّا",35,"ر",2,0],["صالح الاسم صالح الفعل يفنى","وله الباقيات في الصَّالحات",36,"ت",1,0],["صالَتْ عليه صروفُ دَهْرٍ لَمْ يَكُنْ","لولا أَبُو الأَيتامِ منها ناصِرُ",37,"ر",1,0],["صالت عليَّ يدُ الزما","نِ بحَدِّ أَسيافٍ قواطعْ",38,"ع",1,0],["صالَتْ عليه يدُ الزمانِ ولم يزَلْ","بنَوالِه يحنو على أولادِه",39,"د",2,0],["صالِحُ ما سيّرت في","ك مُحزناً أو مُسهلا",40,"ل",2,0],["صالَ على آلِ النبيّ جائراً","لَم يَرعَ فيهم ذمّة أو إلّه",41,"ل",2,0],["صالح مُرتَجى الصلاح لديهِ","عارف عامل عليهم بصيرُ",42,"ر",1,0],["صالحٌ في ثمودَ ما سَمعتَ به","أو نوحُ في قومه أو هودُ في عاد",43,"د",1,0],["صال في العشاق منه ناظر","هو والسيف على حد سوا",44,"س",3,0],["صالح يا مشبه بدر الدجى","بالحسن والإشراق والرفعة",45,"ه",1,1],["صالا وجالا كالأُسودِ ضوارياً","وأزيزِ تيّارِ الفُراتِ المُزبِدِ",46,"د",1,0],["صالحوا فارتفعوا منزلة","وهَمَوْا جوداً فبارَوا سُحُبا",47,"ب",2,0],["صالحَ السلطانَ فاعْتَزّ وما","كاد يختلّ ومن كاد يُكَدْ",48,"د",1,0],["صَالَ لَيْثاً وَقَدْ رَنَا خَشْفَا","وَتَبَدَّى هِلاَلْ",49,"ل",1,0],["صال لَيْثاً وتَجَلَّى قَمَرا","وانْثَنَى خَيْزُورْ",50,"ر",1,0],["صالِحٌ تَلقاهُ في أُفقِ العُلى","أَسعَدَ الناسِ وَأَسماها هِمَم",51,"م",1,0],["صالَتْ على الحُمْسِ في بَدْرٍ مَصاعِبُهُ","وفي لفيفِهِمُ العُوذُ المطافيلُ",52,"ل",1,0],["صالت علي يد الزمان فشتت","شملي بخطب مظلم الأرجاء",53,"ا",2,1],["صالح الفعل راجحُ الفضل غوث ال","مستغيثين غيثُ أهل الأماني",54,"ن",2,0],["صالحاً للسماحِ جئت بعصرٍ","فيه حتَّى الحيا المُرجّى شحيح",55,"ح",1,0],["صالح الخلق بالمساواة فالفر","ق عديم الوجود بين الطوائف",56,"ف",1,0],["صالح بها بين السرور وخاطري","واجعل رضابك أول الكلمات",57,"ت",1,0],["صالت علينا العيون السود واحربا","واستودعت من هواها في الحشى لهبا",58,"ب",2,1],["صالت مهاجمة وصال مدافعا","حتى تفانت أنصل وسهام",59,"م",1,0],["صال بالمرهفين من ناظريه","فهو ريم في معرك الحسن يرهب",60,"ب",1,0],["صالح هذا الدهر من كان في","راحته الراحة يوم النوال",61,"ل",1,0],["صالَ في مُهجتي فمزَّقَ قلبي","وانبرى في الحَشَا ظُلُوماً أغارا",62,"ر",2,0],["صالحاتٍ لحفظِ ما ادَّخرَتهُ","جاهداتٍ بحاثةَ الوديانِ",63,"ن",1,0],["صالَ جالوتُ حين آنَسَ ضَعفاً","وتمَشَّت في جيشِهِ الكبرياء",64,"ا",2,0],["صال البغاة ونار الحرب قد وقدوا","وغيرهم بلظى الهيجاء قد صالوا",65,"ل",3,0],["صالت على دول البغاة فقوضت","أركانها ومشت على الهامات",66,"ت",1,0],["صالوا ولو لا قضاء الله يمسكهم","لم يتركوا من بني سفيان من أثر",67,"ر",1,0],["صَالُوا عليكُم بالذي صُلتُم بِهِ","أنتُم علينا صَولَةَ الفُرسَانِ",68,"ن",1,0],["صال النصوص عليه فهو بدفعها","متوكل بالدأب والديان",68,"ن",1,0],["صالَ فينا بِدارِعاتِ الرَزايا","فَاِتَّقَينا بِعارِياتِ الصُدورِ",69,"ر",1,0],["صالوا وجالوا وأدَّوا حق سيدهم","في موقف فيه عَقَّ الوالدَ الولدُ",70,"د",1,0],["صالح الفعل ابو الفضل الحبيب","من علي نسبا غير عجيب",71,"ب",1,0],["صال كالليث عن علاه يحامي","وكذاك الاسود تحمي حماها",72,"ا",3,0],["صالَت افاعي شعره لما رأت","دبت عقاربه سالفين عقاص",73,"ص",1,0],["صال ابن حيدرة وهو الجواد على","طرفٍ أغر من الهامات ينتعل",74,"ل",1,0],["صالح المؤمنين لا ريب فيه","حسبما نص أصدق الأخبار",75,"ر",1,0],["صال في حومة البلاغة يسطو","بحُسامين مقول ويراع",76,"ع",1,0],["صالح لا يزال يطلب عَبْدَهْ","من كريم يُصْفي الأخلاء ودَّهْ",77,"د",2,1],["صالحُ الفعل صادقُ القول واف","بوفا العهد مُنجزٌ للوُعُود",78,"د",1,0],["صالت عليك مطامع الغرب الذي","ارضعته لبن الترفي والاكمل",79,"ل",1,0],["صالت بسيف الغنج بضة ترمق","رعناء للصب المتيم ترشق",80,"ق",1,1],["صالَ عليهِم صولَةَ الآسادِ","وهوَ بأعلى صوتِه يُنادي",81,"ي",1,0],["صالَ عليهِم صولَةَ الضرغامِ","والصقرُ إذ شدّ على الحمامِ",82,"م",1,0],["صالحَ النوم جفنه من عيوني","فهو فيه ومنه حربٌ وصلحُ",83,"ح",1,1],["صالح الفعل موؤل الكل في ال","كل عديم الأمثال والأقران",84,"ن",1,0],["صالَتْ بإحْدى الحسْنَيَيْنِ فواصَلَتْ","تأويبَها في اللهِ أو إسْآدَها",85,"د",3,0],["صالت على الأَصلال في وَكَناتها","نِقَمٌ بها صلَّت صليلَ المَشرَفي",86,"ف",2,0],["صالت جُفونك فاستبحتَ قَتيلا","وسطا قَوامُك فاحتقرت جَديلا",87,"ل",2,1],["صالح الاسم والمسمّى أبي الأشبا","لِ من روح جعفر الفيض منتم",88,"م",1,0],["صالت على الصالح والطالح ال","آفات والمكتوب في اللوح آت",89,"ت",1,0],["صالوا وصلت ولكن أين منك هم","النقش في الرمل غير النقش في الحجر",90,"ر",1,0],["صال حَتَّى على أَفُلُّونَ لَمَّا","رامَ مَرفِيسَ مُنفِذاً فِيهِ سَهما",91,"ا",1,0],["صال يحكي طوله عن جيدها","وعن القرطين مصحوب النعال",92,"ل",1,0],["صالوا علينا بسيف البغي وانتهكوا","بجورهم حرمات الله في الفُقَرَا",93,"ر",2,0],["صالت على الظلم والظلام عصبتهم","بقاصف من مقال الحق ذي كبب",94,"ب",1,0],["صالت على قطرهم فتن بها خربت","ديارهم وبها الأثمار قد أكلت",95,"ت",1,0],["صالِحو أَكفائُهُم خُلاّنُهُم","وَسَراةُ الأَصلِ وَالنَاسُ شِيَع",96,"ع",1,0],["صالوا حُفاةً عُراةً لاحُماةَ لهم","حتى اقشعرَّتْ مناياهم من اللَّجَبِ",97,"ب",1,0],["صاليت نار الخليل فيه","لكن على ريقه المبرد",98,"د",1,0],["صالوا وجالوا والخرابُ يقودهم","نحو التحررِّ بالدماء وبالقنا",99,"ن",2,0],["صالَ الفسادُ على البلادِ وجالا","وتقطّعَت بنصالِهِ أوصالا .",100,"ل",2,1],["صالحات على يديك أتيحت","ومقام به حبيب زليف",101,"ف",1,0],["صالوا وجالوا في حماك كأنه","حل لهم .. وعلى بنيك حرامُ",102,"م",1,0],["صالوا فرادى في صحاح جموعهم","فتكسرت مذ فرت الافراد",103,"د",1,0],["صالحتُ نفسي ولمّا أكتفي عتباً","ولم أصالحْ هوىً مستصحباً فَرَقا",104,"ق",2,0],["صالوا فرادى على جمع العدى فغدت","صحاحه ذات كسر غير منأرب",105,"ب",1,0],["صال الفؤاد إذا بدت لي صدفة","خفقاً بدا بين الضلوع وجالا",106,"ل",2,1],["صالت مضللةً تسطو على لغتي","أفعى مواربة للسم تسقيه",107,"ي",2,0],["صالوا وجالوا عربدوا بوقاحة","لم لا وقد حصلوا على استثناء",108,"ا",2,0],["صالتْ وجالتْ في الفضاءِ ويمَّمتْ","ببريقِهَا نحو السَّماءِ لتُعْتَنَقْ",109,"ق",1,0],["صالحِ الاسم مع الفعل الذي","نال علمًا وكمالاً ورشاد",110,"د",1,0],["صالوا به وذويه بين حصونهم","في خندق غرت به الأذواء",111,"ا",2,0],["صال الفؤاد محطّة محزانا","من مطل آسرة القلوب عيانا",112,"ن",2,1],["صال فيهم فلم بهن منه عزم","كحام يوحي به إلا جالا",113,"ل",2,0],["صالتْ وجالتْ على أعتابِ نائرةٍ","قد أرحضتْ هندُها بالعار منتسِبا",114,"ب",2,0],["صالوا عَلى حُوران من ساير الجبل","وَحُمر البَيارق عَالسكن نشرونها",115,"ن",3,0],["صالَت عَلَينا بِها حَتّى إِذا فَتَكَت","بِمُجَةِ الصَّبِّ أَولَتهُ الرَّياحِينا",116,"ن",2,0],["صالوا وجالوا وباعوا واشتروا وطغوا","وسخروا بالملايين الملايينا",117,"ن",2,0],["صالة الرقص في دجى ازمير ِ","ارجعتني الى صباي الغرير ِ",118,"ر",1,1],["صالوا وجالوا بأفكار مرقعة","فيها المجون وفيها الفسق والعار",119,"ر",1,0],["صَالَ الحَنِينُ كَسَيْفٍ نَاضَهُ أَعْمَى","أَشْرَى ؛ فَمَا سَفَكَ البَلْوَى ، وَ لاَ اِخْتَضَبَا",120,"ب",2,0]]}