=581",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[31,"إنَّ الخَلِيطَ الَّذِينَ كُنْتُ بِهِمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18979&r=&rc=242",""],[87,"كلُّ صعبٍ سوى المذلة ِ سهلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23768&r=&rc=30",""],[4,"أُنْبئْتُ أنَّ أبَا حَنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10958&r=&rc=53",""],[92,"في اللّيل نَادَيتُ الكَوَاكِبَ ساخطاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14558&r=&rc=4",""]],"verses":[["الفَقرُ يُنئِي وَالثَراءُ يُدني","وَالحِرصُ يُشقي وَالقُنوعُ يُغني",0,"ي",1,0],["الفاعِلُ الفِعلَ الَّذي","يَعجِزُ عَنهُ القائِلُ",1,"ل",1,0],["أَلَفَّ بِلَألاءِ السَماحِ فُروجَها","تُبَيِّضُ أَعجاسَ القِسِيِّ العَواتِكِ",2,"ك",1,0],["أَلِفَت ضَميري النائِباتُ كَأَنَّها","لِعِتاقِ أَفراسِ الجَوى مِضمارُ",3,"ر",1,0],["الفِعلُ مَهزَأةٌ لِكُلِّ فَمٍ","وَالعِرضُ مِنديلٌ لِكُلِّ يَدِ",4,"د",1,0],["الفَضلُ ناسَبَ بَينَنا إِن لَم يَكُن","شَرَفي مِناسِبَهُ وَلا ميلادي",5,"د",2,0],["أَلِفَتْ جِوارَ الرَّكبِ غانيَةٌ","يأبى جِوارَ عُقودِها القُرطُ",6,"ط",1,0],["أَلِفْتُ الهُوَيْنى في زَمانٍ لِأَهْلِهِ","على غَيْرِ ما يَرْضَى بِهِ المَجْدُ تَحْريضُ",7,"ض",1,1],["أَلِفُوا الجِدَّ وَلَمْ يَنْ","تَهِجُوا طُرْقَ المِزاحِ",8,"ح",1,0],["ألِفْتُ مَدْحَكَ والآمالُ تَهتِفُ بي","وراضَ جودُكَ أفكاراً تُطاوعُهُ",9,"ع",2,0],["ألِفْتُ الندىً والعامريّةُ تَعْذِلُ","وممّا أفادَتْهُ الصّوارِمُ أبْذُلُ",10,"ل",1,1],["ألِفَ الكَرى لمّا اطْمأنَّ فِراشُهُ","وهَجرْتُهُ قَلِقاً عليَّ فِراشي",11,"ش",2,0],["ألِفَ السُّهادَ فلو أهابَ خَيالُهُ","بالعَيْنِ ما شَعَرَتْ بهِ الأجْفانُ",12,"ن",1,0],["ألِفَتْ ظِباءَ الوادِيَيْنِ فعِنْدها","حَذَرُ الغَزالَةِ والْتِفاتُ الجُؤذَرِ",13,"ر",1,0],["ألِفوا ظُهورَ المُقْرَباتِ وما دَرَوْا","أنّ المَصيرَ إِلى بُطونِ الأنْسُرِ",13,"ر",1,0],["أَلفَيتَنا لِلضَيفِ خَيرَ عِمارَةٍ","إِن لَم يَكُن لَبَنٌ فَعَطفُ المُدمَجِ",14,"ج",1,0],["أَلِفتُ السُقمَ حَتّى صارَ جِسمي","إِذا فَقَدَ الضَنى أَمسى عَليلا",15,"ل",2,0],["أَلفَيتُ بَيني وَبَينَ الهَمِّ مَعرِفَةً","لا تَنقَضي أَبَداً أَو يَنقَضي الأَبَدُ",16,"د",1,0],["ألّفَ بالعدِل قُلوبَ الوَرى","وفرّقَتْ يُمْناهُ ما جمّعا",17,"ع",2,0],["أَلِفَ التَّرَحُّلَ لاَ يُقِيمُ بِبلْدَةٍ","إِلا مُقَامَ الْعَذْلِ فِي الآذَانِ",18,"ن",1,0],["أَلَّفتَ بَينَ العُنصُرَينِ فَأَصبَحا","رَتقاً وَكُنتَ مُوَفِّقَ الأَسبابِ",19,"ب",1,0],["الفَصلُ لِلشورى وَتِلكَ هِيَ الَّتي","تَزَعُ الهَوى وَتَرُدُّ كُلَّ جِماحِ",20,"ح",1,0],["أَلِفنا الخُمولَ وَيا لَيتَنا","أَلِفنا الخُمولَ وَلَم نَكذِبِ",21,"ب",1,0],["أَلَّفتُ بَينَ اِبنِ السَحابِ وَبَينَها","فَرَأَيتُ صِحَّةَ ما حَكاهُ الطائي",22,"ا",2,0],["أَلِفَ الناسُ حَيثُ كُنتُ مَكاني","أُلفَةَ المُعدِمينَ شَمسَ الشِتاءِ",23,"ا",2,0],["الفَتحُ وَالعُمرانُ آيَةُ عَهدِهِ","وَكَتائِبُ الأَقدارِ مِن أَعوانِهِ",24,"ن",2,0],["الفارِجُ الهَبَواتِ السودَ يوردُ في","مَواقِعِ الراشِقاتِ الأَبيَضَ الذَكَرا",25,"ر",2,0],["إِلفٌ أَلَذُّ غَرورَ الوَعدِ يَصفَحُ لي","عَنهُ وَيُقنِعُني التَعليلُ بِالخُدَعِ",26,"ع",1,0],["الفَخرُ ثَغرٌ عَن حِفاظِكَ باسِمٌ","وَالمَجدُ بُردٌ مِن وَفائِكَ مُعلَمُ",27,"م",1,0],["الفاضِلُ الخُبرِ في المُلوكِ إِذا","قَصَّرَ خُبرٌ عَن غايَةِ الخَبَرِ",28,"ر",1,0],["ألفاتٌ يحكين هيف قدود","وعيونٌ لسحرها أسرار",29,"ر",1,0],["ألفرقدا تواري","والأفق عاوده أربداده",30,"د",2,0],["أَلفَرِيقُ المِقْدَامُ وَالعَامِلُ العَا","ملُ وَالكَاتِبُ الأَدِيبُ المُبِينُ",31,"ن",1,0],["أَلفِكْرُ فِي جَنَّةٍ مِنْ عَبْقَرِيتَّهَا","يَطِيرُ مِنْ فَنَنٍ زَاكٍ إِلَى فَنَنِ",32,"ن",1,0],["ألفَضْلُ أَرْفَعُ غَايَةٍ إِنْ يَسْتَتِرْ","وَالفَضْلُ أَرْوَعَ قُدْوَةٍ إِنْ يُعْلَمِ",33,"م",1,0],["أَلْفَاظُهُ ُقَطْرُ نَدًى خَالِصٍ","مِنَ الْقَذَى يَشْفِي أُوَارَ الظَّمِي",34,"م",2,0],["أَلفَيْصَلُ الفَارُوقُ فِي حَلِّ مَا","أَعْضَلَ إِنْ يَفْصِلْ وَإِنْ يَحْكَمِ",34,"م",1,0],["الفَوْزُ بَعْدَ الفَوْزِ يَشْحَذُ عَزْمَهُ","أتَرَاهُ يَسْتَصفِي الفَخَارَ عَزُومُ",35,"م",1,0],["أَلْفَاظُهَا تَشْفِي الصَّدَّى","وَتُسَاغُ كَالْمَاءِ الزَّلاَلِ",36,"ل",1,0],["أَلِفنَ اللِوى حَتّى إِذا البَروَقُ اِرتَمى","بِهِ بارِحُ راحُ مِن الصَيفِ شامِسُ",37,"س",1,0],["الفلك ل مساع عادا","إش يزول بسعد دائر",38,"ر",1,0],["الفحص مولاي ما ملح","الخضر والطل والزهر",39,"ر",1,0],["الفاتحون لكل صعب مقفلٍ","والفارجون لكل خطب مبهم",40,"م",1,0],["ألفتُ الهوى حتى أنستُ بجوره","فكل عذاب نالني في الهوى عذبُ",41,"ب",1,0],["أَلفَيتُهُ لَمّا جَرى بِكَ شَأوُنا","حَطِمَ اليَدَينِ مُكَسَّرَ الأَصلابِ",42,"ب",1,0],["أَلفَيتَ بَيتَكَ في العَلياءِ مَكَّنَهُ","أُسُّ البِناءِ وَما في سورِهِ هَدَمُ",43,"م",1,0],["أَلِفتُكَ حَتّى أَخمَرَ القَومُ ظِنَّةً","عَلَيَّ بَنو أُمِّ البَنينَ الأَكابِرُ",44,"ر",1,0],["أَلفَيتَ أَربَدَ يُستَضاءُ بِوَجهِهِ","كَالبَدرِ غَيرَ مُقَتِّرٍ مُستَأثِرِ",45,"ر",1,0],["الفِتيَةُ البيضُ المَصا","لِتُ أَشبَعوا حَزماً وَلينا",46,"ن",2,0],["أَلُفُّ بِحِلسي الزادَ مِن دونِ صُحبَتي","وَقَد آبَ نَجمٌ وَاِستَقَلَّ نُجومُ",47,"م",1,0],["الفاتقون الراتقو","ن الأفقون على المعاشرْ",48,"ر",1,1],["أَلُفُّهُمُ وَأَنشُرُهُم كَأَنّي","أُطَرِّدُ مِنهُمُ الإِبلَ السَواما",49,"م",2,0],["أَلفَيتَ حَولَ بُيوتِنا","عَدَدَ الشَجاعَةِ وَالكَرَم",50,"م",1,0],["الفِكرُ فيكَ مُقَصِّرُ الآمالِ","وَالحِرصُ بَعدَكَ غايَةُ الجُهّالِ",51,"ل",1,1],["أَلفى أَباهُ وَأَلفى جَدَّهُ حُبِسا","بِمَعزِلٍ عَن مَعالي المَجدِ وَالخيرِ",52,"ر",1,0],["ألِفت بأنبوبِ اليراعةِ والقنا","يمناهُ يومَ ندًى ويومَ حروب",53,"ب",1,0],["ألف السقوط فلو أردت كتابة","للظاء منه كتبته بالساقط",54,"ط",1,0],["ألف الندى حتى بدا في كفه","نبع الزّلال فيا له من منبع",55,"ع",1,0],["الفضل إرثكَ والمهابة والنهى","فافْخر وأوقع بالعداة ووقع",56,"ع",1,0],["ألف الصدود تجنُّباً وتحجُّباً","فلو أنه رام التواصل ما عرف",57,"ف",1,0],["ألفاظه الريح لكن في الحشا لهب","وربَّما كانَ مرّ الريح يُذكيه",58,"ي",2,0],["الفضل جنس بيته المهنى","ونوعه الذي عليه يبنى",59,"ن",2,0],["أَلِفٌ تَأَلَّفُ الخَلائِقَ بِالصَف","حِ وَلامٌ عَلى المَلامَةِ تَجري",60,"ر",2,0],["إلفٌ لنا بارعُ الصفات","غرابُ بَيْنِ المُغنِّياتِ",61,"ت",1,1],["إلفيْن خِدْنين لم يرم اجتماعَهما","ريْبُ الزمان بتشتيت وتبديدِ",62,"د",1,0],["ألَّفَ بين الفؤاد والكمدِ","وحال دون العناء والجلَدِ",63,"د",1,1],["ألِّف بالتوفيق شملاهما","في نعمةٍ تمت وفي حبرهْ",64,"ر",2,0],["ألفيتُها في الأرض أبعد مذهباً","وأعَمَّ من ضوء النهار الأزهرِ",65,"ر",1,0],["الفطر والأضحى قد انسلخا ولي","أمل ببابك صائمٌ لم يفطر",66,"ر",1,0],["ألفيتُهُم من شرِّ قنيةِ مقتنٍ","للمقتنين وشرِّ لقطةِ لاقط",67,"ط",1,0],["ألفيت من خالص الياقوت جوهره","لما وجدت صنوف الناس أخزافا",68,"ف",2,0],["ألفيتُ عاذله يروض سماحه","ليعوق منه وليس بالمُنعاق",69,"ق",1,0],["الفصحُ والفِطرُ والنيروزُ يقدمُه","عيدُ الفطيرِ ازدحامَ الوردِ بالنهلِ",70,"ل",1,0],["ألفيتُ حاصلَ وعدِ غيرِك خِلفةً","ورأيتُ رفدك قبل وعدك يحصُلُ",71,"ل",1,0],["أَلفَ عام كل ما أد","بر عامٌ كرّ عامُ",72,"م",1,0],["الفيلسوفِ العظيمِ شأنا","العائفِ القائف المُعزِّمْ",73,"م",1,0],["ألفُ ألفٍ في ساعةٍ قتلوهُمْ","ثم ساقوا السِّباءَ كالأغنام",74,"م",1,0],["أُلِّفنَ من كلِّ شيءٍ طيِّبٍ حسنٍ","فهُنَّ فاكهةٌ شتَّى وريْحان",75,"ن",1,0],["ألَّف شكلَيْهما إمامٌ","أفعالُهُ فيهما حِسان",76,"ن",1,0],["ألْفَتْهُ مُجتبياً كريماً راجحاً","إذ لا نكادُ نرى كريماً وازِنا",77,"ن",2,0],["أَلفَيتَهُ لا يَذُمُّ الضَيفُ جَفنَتَهُ","وَالجارُ ذو البَثِّ مَحبُوٌّ وَمَمنوحُ",78,"ح",1,0],["أَلفَيتَهُ لا يَفُلُّ القِرنُ شَوكَتَهُ","وَلا يُخالِطُهُ في البَأسِ تَسميحُ",78,"ح",1,0],["أَلفَيتَ أَغلَبَ مِن أُسدِ المَسَدِّ حَدي","دَ النابِ إِخذَتُهُ عَفرٌ فَتَطريحُ",78,"ح",1,0],["الفاخِرونَ بِكُلِّ يَومٍ صالِحٍ","وَأَخو المَكارِمِ بِالفَعالِ فَخورُ",79,"ر",1,0],["أَلِفوا الرِياءَ فَصارَ مِن عاداتِهِم","لَعَنَ المُهَيمِنُ شَخصَ كُلِّ مُرائي",80,"ا",2,0],["أَلفتُ الهُمومَ فَلَو أَنَّني","قَدَرتُ تَمَنَّعتُ أَن أَطرَبا",81,"ب",2,0],["الفَجرُ أَهدى لِيَ السَنا","وَالرَوضُ لِيَ المَلاب",82,"ب",1,0],["الفَنُّ فيكَ سَجِيَّةٌ لا صَنعَةٌ","وَالحُبُّ عِندَكَ كَالطَبيعَةِ سَرمَدي",83,"د",2,0],["أَلِفَت أَنفُسُنا الضَيمَ المُقيم","مِثلَما يَستَعذِبُ الظَبيُ الهَبيد",84,"د",1,0],["الفَنُّ هَشَّ إِلَيكَ في أُمَرائِهِ","وَتَفَتَّحَت لَكَ دورُه وَقُصورُهُ",85,"ر",2,0],["أَلِفَت ما عَوَّدوها مِثلَما","تَألَفُ الظَبيَةُ طَعمَ الحَنظَلِ",86,"ل",1,0],["الفاعِلينَ الخَيرَ لا لِطَماعَةٍ","في مَغنَمٍ إِنَّ الجَميلَ المَغنَمُ",87,"م",1,0],["أَلِفَت مُجاوَرَةَ الأَنا