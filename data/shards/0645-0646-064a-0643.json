/poetry.dctabudhabi.ae/diwan/poem/139178","السريع"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139131","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120502","الكامل"],[4881,"تذمر","https://www.poetsgate.com/ViewPoem.aspx?id=181795",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5136,"يا لها قبة تلألأ نورا","https://www.poetsgate.com/ViewPoem.aspx?id=121549",""],[5277,"أنا لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=208524",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""],[5829,"كل ود","https://www.poetsgate.com/ViewPoem.aspx?id=211081",""],[5906,"زَيف","https://www.poetsgate.com/ViewPoem.aspx?id=188807",""],[6115,"الذي يرخصك سيبه وبيعه بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=196460",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""]],"verses":[["مَن يَكُن فاضِلاً يَعِش بَينَ ذا النا","سِ بِقَلبٍ جَوٍ وَبالٍ كَسيفِ",0,"ف",1,0],["مَن يَكُن زائِري يَجِدني مُقيماً","أُتبِعُ الغانِياتِ بِالزَفَراتِ",1,"ت",1,1],["مَن يَكُن صائِفاً بِنَهرِ أَبي الجُن","دِ يَكُن صَيفُهُ أَذىً وَعَذابا",2,"ب",2,0],["مَنْ يَكُنْ مُهْدياً فَمِثْلُكَ يُهْدِي","لَمْ أَجِدْ لِلثَّنَا عَلَيْكَ لِسَانَا",3,"ن",2,0],["مُنىً كَأَن لَم يَكُن إِلّا تَذَكُّرُها","إِنَّ الغَرامَ لِمُعتادٌ مَعَ الذِكَرِ",4,"ر",1,0],["مُنىً كَالشَجى دونَ اللَهاةِ تَعَرَّضَت","فَلَم يَكُ لِلمَصدورِ مِن نَفثِها بُدُّ",5,"د",1,0],["مَن يَكُ عَنّا مَعشَرَ الأَسدِ سائِلاً","فَنَحنُ بَنو الغَوثِ بنِ زَيدِ بنِ مالِكِ",6,"ك",1,1],["من يكن ذا صناعة عرفت أو","زمن خيفٍ لم يضع بين ذين",7,"ن",1,0],["من يكن قرنه كقرنك هذا","فليكن بابُه كإيوانِ كسرى",8,"ر",2,0],["من يَكُنْ من زُيوفه ونفايا","ه فما زلتُمُ جِيادَ جِيادِهْ",9,"د",2,0],["من يكن لم يُندرِ الدهرُ بهِ","فعبيدُ الله فيه نادره",10,"ر",2,0],["من يكنِ تاجه كتاجك هذا","فليكن بابه كإيوان كسرى",11,"ر",2,0],["من يكن من أُمَّةِ الحس","نِ فمن أهوى إمامُ",12,"م",1,0],["من يكن عانياً بحُبِّ حبيبٍ","ففؤادي ببغضك الدهر عاني",13,"ن",2,0],["من يكن أصبح من حُجاجه","فلقد أصبحتُ ممَّن سَدَنَه",14,"ن",2,0],["من يكن يكرم اللئام فقد أض","حوا وأمْسَوْا عندي بدار هَوان",15,"ن",1,1],["مَن يَكتَسِب صاحِباً تَبقَ مَوَدَّتُهُ","فَهوَ الغَنِيُّ بِهِ لا ذو المَلايِّينِ",16,"ن",1,0],["من يكن يطلب الخراب حثيثا","فالخراب الحثيث تلك السبيل",17,"ل",1,0],["منىً كبار وآمال محببة","خابت ولم يلق غير اللوم راجيا",18,"ي",2,0],["مَن يَكذِبِ التاريخَ يَكذِبُ رَبَّهُ","وَيُسيءُ لِلأَمواتِ وَالأَحياءِ",19,"ا",2,0],["مَن يَكُن حامِلاً إِلَيكَ كِتاباً","فَكِتابي إِلَيكَ أَيرٌ طَويلُ",20,"ل",1,0],["مَن يَكُ عَن قَيسِ بنِ عَيلانَ سائِلاً","فَفي غَطَفانَ مَجدُ قَيسٍ وَخَيرُها",21,"ر",3,1],["مَن يَكٌ يَجهَلُ ما أَل","قى فَإِنَّ الحُبَّ سُقمي",22,"م",2,0],["مَن يَكُن قَصدُهُ سِوا","كَ فَقَد خابَ وَاِفتَضَح",23,"ح",1,0],["مَن يَكُ بِالعالَمِ مُستَأنِساً","فَإِنَّني مِنِّيَ في عالَمِ",24,"م",1,0],["مَن يَكُ إِسماعيلُ أَصلاً لَهُ","لا بِدعَ أَن يُقبَلَ قُربانُه",25,"ن",2,0],["من يكنْ صائماً فذا رمضانٌ","خَطّ بالنّور للوَرى أوّلَ اسمِه",26,"ه",1,0],["مَن يَكُن أَمسى خَلِيّاً مِن هَوىً","فَفُؤادي لَيسَ مِنها بِخَلي",27,"ي",1,0],["مَن يَكُن ناسِياً فَلَم أَنسَ مِنها","وَهيَ تُذري لِذاكَ دَمعاً سِجاما",28,"م",2,0],["مَن يَكُن مِن هَوى حَبيبٍ قَريباً","فَأَنا النازِحُ البَعيدُ السَحيقُ",29,"ق",1,0],["مَن يَكُن قَلبُهُ سَليماً صَحيحاً","فَفُؤادي بِالخَيفِ أَمسى مُعارا",30,"ر",2,0],["مَن يَكُن يَعشَقُ النِساءَ فَإِنّي","مولَعُ القَلبِ بِالغُلامِ الظَريفِ",31,"ف",1,1],["مَن يَكُ مِن حُبَّيكِ خِلواً فَما","أَصبَحتُ مِن حُبَّيكِ بِالخِلوِ",32,"ل",2,1],["مَن يَكُن عَضَّ بناناً نادماً","فأنا قَطَّعتُ إِبهامَ النّدَم",33,"م",1,0],["منىً كنّ لي أنّ البياض خضاب","فيخفي بتبييض القرون شباب",34,"ب",1,1],["من يكن مثلَكَ في إِيمانه","كيف أدعوه لصبرٍ أو عزاءْ",35,"ا",2,0],["مَن يَكُن ذا لِقَحٍ راِخياتِ","فَلِقاحي ما تَذُوقُ الشَّعيرا",36,"ر",2,1],["مَنْ يَكُونُ الجَلِيسَ يُصْغِي إِلَيْهِ","سَامِعُوهُ وَلِلوُجُوهِ ابْتِسَامُ",37,"م",1,0],["مَنْ يَكُونُ الأدِيبُ بَعْدَكَ لا إِغْ","رابَ فِي قَولِهِ وَلا إِعْجَامُ",37,"م",1,0],["مَنْ يَكُونُ الرَّئِيسَ وَالْقَوْمُ أَنْتمْ","حَسْبُهُ أَنْ يَكونَ صَدْرَ الصُّدُورِ",38,"ر",1,0],["مَنْ يَكُنْ ذَاكَ عَزْمُهُ لَيْسَ غَرواً","أَنْ يَقُودَ الطَّليعَةَ الأَنْجَابَا",39,"ب",2,0],["من يكن كهفُه سواك فحسبي","بك في النائبات من كلِّ كهفِ",40,"ف",1,0],["من يكن أصبح من حُجاجه","فلقد أصبحتُ ممتن سَدَنَهْ",41,"ن",2,0],["من يكن عمره كذاك فماذا ال","ألم المحض والليالي حبالى",42,"ل",2,0],["من يكن مطلبُهُ نَصرَ الهُدى","نال عند اللَه نجحَ المَطلَبِ",43,"ب",1,0],["من يكن الدهر له ماتحا","لا بدّ أ يشرَب ما خَوّضا",44,"ض",2,0],["مُنى كُلِّ نَفسٍ لَثمُ آثارِ نَعلِهِ","وَفي الناسِ مَن يُعطى مُناهُ وَيُحرَمُ",45,"م",1,0],["من يكن الله ولي عونه","فمن يحاربه إلى مضمار",46,"ر",1,0],["منَ يكتبِ الخطَّ المليحَ لغيرِهِ","فلنفسه لا شكَّ يكتُب أَملَحا",47,"ح",2,0],["من يكن البحرُ له راحةً","يَضيق عن خنصره الخاتم",48,"م",1,0],["من يكرم الناس يكرم أو يهن أحدا","يهن ومن لم يهب أكفاه لم يهب",49,"ب",1,0],["من يكسب المال يصحبه البعيد كما","من يعدم المال يصرمه ذوو القرب",49,"ب",1,0],["من يكسب المال في الدنيا ليكنزه","فذاك في تعب يفضي إلى تعب",49,"ب",1,0],["مَن يَكُن زاعِماً بدينٍ ودنيا","غُنيةً عنه إنّني لفقيرُ",50,"ر",1,0],["مَن يكُن شاهداً بفضلٍ فإنّي","لكِ بالفضلِ والكمالِ شهيدُ",51,"د",1,0],["مَن يَكُن بَعدَهُ العَزاءُ جَميلاً","فَاِجتِنابُ العَزاءِ مِنهُ جَميلُ",52,"ل",1,0],["مَن يكن يهواه للخَل","قِ فإني عَبدُ خُلقِهْ",53,"ه",1,1],["مَن يَكشِفُ الغَمّاءَ إِن نَزَلَت وَمَن","يُمسي لِكُّلِ عَظيمَةٍ حَمّالا",54,"ل",2,0],["من يكن يكره الفراق فإني","أشتهيه لوقفةِ التسليم",55,"م",1,0],["مَن يَكُن فيكَ نَصرُهُ وَتَراهُ ال","أُسدُ تَخشى لِقاهُ في كُلِّ أَجمَه",56,"م",2,0],["مَنْ يَكُنِ مِثْلَكَ فِي الْجُودِ يَكُنْ","غايَةَ الضّارِبِ عِنْدَ الْمَثَلِ",57,"ل",1,0],["مَنْ يَكُنْ هامَ مِنَ الْوَجْدِ بِهِ","فَلَقَدْ ذُبْتُ مِنَ الشَّوْقِ إِلَيْهِ",58,"ي",2,0],["مَن يَكُن شامِتاً فَلِلمَوتِ بِأَسٌ","لَيسَ يُثنَى بِالعِزَّةِ القَعساءِ",59,"ا",2,0],["من يكن أيتمَ الذرارِى إذا ما","ت فهذا قد أيتمَ الفقراءَ",60,"ا",2,0],["مَن يَكنِزُ الأَموالَ في الرِقابِ","وَيَذخَرُ الثَناءَ لِلأَعقابِ",61,"ب",1,0],["مُنىً كُنَّ لي أنْ أَسلُبَ الغُمْضَ غَيْرةً","على طَيْفها من كُلِّ جَفْنٍ مُهَوَّم",62,"م",1,0],["مَن يَكونُ الَّذي أذا","عَ الهَوى أنتَ أم أنا",63,"ن",2,0],["من يُكرمِ الآبَ يكرمْ إبنَه وكذا","من يحقر الإبن يستحقر أباه معا",64,"ع",2,1],["من يكره التوبيخ يكره نفسه","والنفس لا ترضاه من عاداتها",65,"ت",3,0],["من يكفر النعماء يُحرَمْها ومن","يمنُن بها يذرِ الصواب خَطاء",66,"ا",2,0],["من يكن في الورى فقيراً فإنّي","في غِنىً من ذخائر الأحلامِ",67,"م",1,0],["مَن يكنْ ضَلَّ في الغرامِ فأنِّي","ليسَ إلاّ لَهُمْ جعلتُ غرامي",68,"م",2,0],["من يكن جاهلاً عطاءَ اللهِ","فليطالِعْهُ في عَطاءِ اللهِ",69,"ه",1,1],["من يكن حاز في المكارم جزءا","فهيَ قد سلّمت إليه كلالَه",70,"ل",2,0],["مُنىً كَانَ فِيهَا لابْنِ شَنْجٍ مَنِيَّةٌ","يُغَرْغِرُ منها راهِقُ الروحِ كاظِمُ",71,"م",1,0],["مَن يَكُن سائِلاً فَإِنَّ يَزيداً","مَلِكٌ مِن عَطائِهِ الإِكثارُ",72,"ر",1,0],["من يكن عنده مزية فهم","فليكن سامعاً فعندي لسان",73,"ن",1,0],["مَنْ يَكُنِ الله مُعِيناً له","يَغْلِبْ كما قَدْ جاءَ في النّقْلِ",74,"ل",1,0],["من يكن مثله كريم خلال","حصل الفخر في الحياة وبعد",75,"د",1,0],["مَنْ يكنْ شوقُه زُروداً فَشَوقِي","زَرَدٌ فِي عِذارِه لا زُرُودُ",76,"د",1,0],["مَن يَكشِفِ الأَمرَ خافيهِ كَظاهِرِهِ","وَيَبلُغُ القَصدَ قاصيهِ كَدانيهِ",77,"ي",2,0],["من يكن قام بالعقائد تقلي","داً فإني استقمت بالبرهان",78,"ن",1,0],["من يكنْ في القِباحِ مُخْتَصَر القب","حِ فذا في القباحِ للقبحِ جامع",79,"ع",1,0],["من يكن يطلب البراز فذا أح","مد في سرج طرفه القماص",80,"ص",1,1],["مَن يَكُنْ مِن ذي بَعيداً","نالَ من هاتيكَ قُربا",81,"ب",2,0],["منْ يكنْ ذا حجًي وجيِّد رأْىٍ","يتخذْ خالق العبادِ وكيلا",82,"ل",2,0],["من يُكرِمِ الأحرار يحمد غِبَّة ال","عقبى بطَول لا يزول وطائلِ",83,"ل",1,0],["مَن يَكسِبِ المالَ يَحفِز حَولَ زُبيَتِهِ","وَإِن يَكُن عائِلاً مَولاهُمُ يَخِبِ",84,"ب",1,0],["من يكفيه صلدم وطعام","سبحا ا