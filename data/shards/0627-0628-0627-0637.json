{"poems":[[47,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[60,"أبا طالب عصمة المستجير","https://www.aldiwan.net/poem30874.html","المتقارب"],[60,"أرقت لنوح آخر الليل غردا","https://www.aldiwan.net/poem31090.html","الطويل"],[82,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[107,"لأم سليم يا أبا طلحة العذر","https://www.aldiwan.net/poem44037.html","الطويل"],[107,"يقول أبو سفيان أودى محمد","https://www.aldiwan.net/poem44208.html","الطويل"],[54,"أبا طيب خبرت أنك بعدنا","https://www.aldiwan.net/poem26893.html","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72191","الطويل"],[47,"عَسَتْ دِمَنٌ بِالأَبْرَقَيْنِ خَوَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=32081",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[128,"ليلاي ليلاي إن الدهر أشقانا","https://www.aldiwan.net/poem23775.html","البسيط"],[147,"أبا طاهر أنت عيب الزمان","https://www.aldiwan.net/poem11740.html","المتقارب"],[190,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[215,"سلام على من لا أسميه إنني","https://www.aldiwan.net/poem46610.html","الطويل"],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[358,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[369,"أبا طاهر يا نجم أفق مكارم","https://www.aldiwan.net/poem60679.html","الطويل"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[412,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[438,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[443,"ترى زائري طيف الخيال الذي سرى","https://www.aldiwan.net/poem2571.html","الطويل"],[443,"أيقطعنا في حبه من نواصله","https://www.aldiwan.net/poem2572.html","الطويل"],[463,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[463,"رضيت وما من طاعة كل من رضي","https://www.aldiwan.net/poem56148.html","الطويل"],[463,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[466,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126814","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126907","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64344","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203789","البسيط"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18249","الوافر"],[1775,"","https://poetry.dctabudhabi.ae/diwan/poem/124605","الطويل"],[2072,"","https://poetry.dctabudhabi.ae/diwan/poem/145243","المتقارب"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143186","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28548","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100916","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126062","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62859","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138670",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131268",""],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143529","المتقارب"],[5219,"عزف على أوتار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=194114",""],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""]],"verses":[["أَبا طَلحَةَ اِستَعلَت يَداكَ وَلَم تَزَل","تُعانُ بِحَدٍّ في حُروبِكَ عالِ",0,"ل",1,0],["أَبا طالِبٍ عِصمَةُ المُستَجيرِ","وَغَيثُ المَحولُ وَنورُ الظُلَم",1,"م",1,1],["أَبا طالِبٍ مَأوى الصَعاليكَ ذا النَدى","وَذا الحُلُمِ لا خَلقاً وَلم يَكُ قَعدَدا",2,"د",2,0],["أباطيلُ تجري بالحقائقِ بينهم","من الكِذْبِ منهم لا عنِ السبعةِ الزُّهرِ",3,"ر",1,0],["أبا طَلحَةَ اسْمَعْ ما يقولُ ابنُ حُرَّةٍ","إليهِ سَرَى من صَفْحَتَيْ جَارِهِ البِشْرُ",4,"ر",1,0],["أبا طلحةَ انْظُر كيف يرمِي وجارِهِ","قضاءً على القومِ المناكيدِ جاريا",5,"ي",2,0],["أَبا طَيِّبٍ خُبِّرتُ أَنَّكَ بَعدَنا","وَقَفتَ عَلى القَشّاشِ فيما يُقَشِّشُ",6,"ش",1,1],["أَباطِح وانتصَّتْ على حيث تستقى","بها شَرَكٌ للوارداتِ مُقِيمُ",7,"م",1,0],["أَبا طَاَحةَ اسْتَعْلتْ يَداكَ ولَمْ تَزَلْ","تُعانُ بِحَدٍّ في حُروبِك عَالِ",8,"ل",1,0],["أبا طارق هذي سراياك أقبلت","يرفّ على أعلامها العزّ والنصر",9,"ر",1,0],["أبا طارق أبقيت للحقّ سنّة","هي العزّة القعساء والفتكة البكر",9,"ر",1,0],["أبا طلال وأنت اليوم رائدنا","نغدو إليك إذا ما الدهر عادانا",10,"ن",2,0],["أَبا طاهِرٍ أَنتَ عَيبُ الزَمانِ","وَعَيبٌ لِحَمدانَ في حُفرَتِه",11,"ت",2,1],["أبا طالب لله درّ مناقب","تحليتها بل سدت أهل المكارم",12,"م",1,1],["أباطيل يزجيها خيالي دعابةٌ","لروحي كما يلقى الهشيم على الجمر",13,"ر",1,0],["أَباطيلٌ تُصَوِّرُها الأَماني","وَأَحلامٌ يُمَثِّلُها المَنامُ",14,"م",1,0],["أَبا طاهر قَلبي الحسينيّ قَد شَدا","بَياتاً فَهَل بِالرَصد نجمك يَظهَرُ",15,"ر",1,0],["أبا طاهرٍ يا نجمَ أُفْقِ مكارمٍ","بدا وهْوَ سامٍ للنّواظرِ عالِ",16,"ل",1,1],["أبا طاهرٍ يا أطهرَ النّاسِ شيمةً","وأطهرَهُمْ نَفْساً وأطهرَهمْ أَصْلا",17,"ل",2,0],["أَبا طاهِرٍ مُحيي النَدى بَعدَ مَوتِهِ","نداه وَباني المَجد بعد اِنهِدامِهِ",18,"م",2,0],["أبا طاهرٍ فخراً بما قد حوَيْتَه","فما لك في أهلِ الزمانِ نظيرُ",19,"ر",1,0],["أبا طالبٍ لو كل منت شعرة","تبثّ مديحاً فيك كنت به حرى",20,"ر",2,0],["أبا طالب لو لم يكن لمحمد","سواك من الآيات تمّت فضائله",21,"ل",2,0],["أبا طالب صبرا وإن كان مُعوِزا","فلا فضلَ في صبرٍ إذا كان ممكنا",22,"ن",2,0],["أبا طالبٍ والظنُّ أنك شافعٌ","لها في غنىً عن باعثٍ ومحضِّضِ",23,"ض",1,0],["أبا طالبٍ لا يُخلف الفخرُ دوحةً","وأنتَ لها فرعٌ وبيتُك عُودُ",24,"د",1,0],["أبا طالبٍ أعطى أخوكَ فلم يكُن","بما جاد منَّاناً ولا باخلَ اليد",25,"د",1,0],["أبا طارقٍ يا مَن تغرّد بالعلا","وأصبَحَ مأموناً منَ الريب والشكِّ",26,"ك",1,1],["أَبا طلال حيث طابَ الهوى","يرجو بأن تبقى شديدَ القوى",27,"ق",3,1],["أباطيل واصفيه","بالحسن في دفتر الحماقه",28,"ق",2,0],["(ابا طلال) هنيئاً ما ظفرتَ به","يا صارما في يد العلياء ما هانا",29,"ن",2,0],["أباطح من أباهر غير قطع","وشائظ ما يفارقن الذبابا",30,"ب",2,0],["أبا طالب الخيرات يمم فناءه","وسارع إلى النجح العتيد وبادر",31,"ر",1,0],["أبا طيب لا تكن ظالماً","ولا تلق نفسك في المهلك",32,"ك",1,1],["أبا طالب نفسي تنازع ليلة","طلعت بها بدراً منيراً فأشرقت",33,"ت",1,1],["أَبا طاهِرٍ ما كانَ أَلأَم لَيلَةٍ","أَرِقتُ بِها وَالسّاهِرونَ هُجوعُ",34,"ع",1,0],["أبَا طالبٍ أنضرتَ قفراءَ بالحِمَى","وأجريتَ من ماءِ الحياة بها نُعَمى",35,"م",2,1],["أبا طالبٍ أدرك أخاكَ فانما","تحمله الحلميتان هوىً جما",35,"م",2,0],["أباطِحُها منها وآن سُفورُها","حططنا رحالا عَن ظهور تجلَّلت",36,"ت",1,0],["اباطن داء ام جوى بك قاتل","فقلت الذي بي مايقوم له صبر",37,"ر",1,0],["أَبا طالبٍ كاثِرْ بها القومَ واعتقدْ","مَضَنّةَ مشفوقٍ بها لا يُبَادِلُ",38,"ل",1,0],["أبا طالب ماذا أقول وأنت قد","أخذت بأطراف العلى والمفاخر",39,"ر",1,0],["ابا طالب هب لي جوارك في غدٍ","فجاهك عند الله ليس بقاصر",39,"ر",1,0],["أباطيل فيها زخرف القول ظاهر","فأنفسهم بالمال مفتتنات",40,"ت",1,0],["أبا طاهر أنت لي جنةٌ","أجل وأعظم من شأنها",41,"ن",3,1],["أباطيل وأسمار تبدت","نقدمها لجبار غشوم",42,"م",1,0],["أباطيلٌ أكاذيبٌ تبهرجها","أقاويلٌ منمقةٌ من الرجسِ",43,"س",1,0],["أبا طالب يا طالبا حوزة الهدى","سبقت بأشواط العلى كل طالب",44,"ب",1,0]]}