etsgate.com/ViewPoem.aspx?id=198360",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[5324,"إلى عينيك.","https://www.poetsgate.com/ViewPoem.aspx?id=211406",""],[5369,"قومي يا نؤوم","https://www.poetsgate.com/ViewPoem.aspx?id=177446",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5628,"الولادة الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=178478",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5704,"هديل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=191083",""],[5704,"على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=194468",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[402,"إلى أي امتداد في البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=35045",""],[5956,"ذِكْرَى رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=184841",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""]],"verses":[["فَحَتّى مَتى تُغضي مِراراً عَلى القَذى","وَتَلحَظُكَ الأَضغانُ مِن مُقَلٍ رُمدِ",0,"د",1,0],["فَحَتّى مَتى أُخفي التِراتِ وَأَنتُم","تُثيرونَ عَن مَدفونِها بِالمَباحِثِ",1,"ث",1,0],["فحَتّامَ أُغْضي ناظِريَّ على القَذى","وأُلْقي بِمُسْتَنِّ الخُطوبِ جِراني",2,"ن",2,0],["فَحَتّى مَتى رَوحُ الرِضا لا يُصيبُني","وَحَتّى مَتى أَيَامُ سُخطِكِ لا تَمضي",3,"ض",2,0],["فَحَتّامَ لا أَنفَكُّ في ظَهرِ سَبسَبٍ","أُهَجّرُ أَو في بَطنِ دَوّيَةٍ قَفرِ",4,"ر",1,0],["فَحَتَّامَ جوبُ البيدِ بِالعيسِ تَرتَمي","تَنائِفَ ما بَينَ البُحَيرِ فَصَرخَدِ",5,"د",1,0],["فَحَتَّامَ تَخْطَفُ تلك البرو","قُ طرفي ويسقين غيري الذِّهابا",6,"ب",2,0],["فَحَتّامَ تُؤخَذُ بِالقُوَّةِ","وَيُقتَصُّ مِنها وَلَم تُذنِبِ",7,"ب",1,0],["فَحَتّى مَتى حَتّى مَتى وَإِلى مَتى","يَدومُ طُلوعُ الشَمسِ ثُمَّ غُروبُها",8,"ب",3,0],["فَحَتّى مَتى أَنتَ ذو صَبوَةٍ","كَأَن لَيسَ تَزدادُ فيها قِصَر",9,"ر",1,0],["فَحَتّى مَتى تَعصي وَيَعفو إِلى مَتى","تَبارَكَ رَبّي إِنَّهُ لَرَحيمُ",10,"م",1,0],["فَحَتَّامَ يَلْحَانِي الْعَذُولُ عَلَى الْهَوَى","أَلَيْسَ يَرَى مَا بِي فَيَجْتَنِبَ الشَّكْوَى",11,"و",2,0],["فَحَتَّامَ أَلْقَى فِي الْهَوَى مَا يَسُوؤُنِي","وَأَحْمِل عِبْءَ الصَّبْرِ وَهْوَ عَظِيمُ",12,"م",1,0],["فَحَتّى مَتى أَبقى وَيَظعَنُ صاحِبٌ","أُوَدِّعُ مِنهُ راحِلاً غَيرَ آيِبِ",13,"ب",1,0],["فَحَتّى مَتى تَبري اللَيالي سِهامَها","وَحَتّى مَتى أُرمى بِها فَأُصابُ",14,"ب",1,0],["فَحَتّامَ يا لَيلى فُؤادي مُعَذَّبٌ","بِروحِيَ تَقضي ما تُحِبُّ وَتَحكُمُ",15,"م",1,0],["فَحَتّى مَتى رَوحُ الرِضا لا يَنالُني","وَحَتّى مَتى أَيّامُ سَخطِكِ لا تَمضي",16,"ض",2,0],["فَحَتّى مَتى هَذا الصُدودُ إِلى مَتى","لَقَد شَفَّ نَفسي هَجرُها وَصُدودُها",17,"د",3,0],["فَحَتَّامَ تَجْزِينِي بِوُدِّيَ جَفْوَةً","أَمَا تَرْهَبِينَ اللهَ فِي حُرْمَةِ الْمَجْدِ",18,"د",1,0],["فَحَتَّى مَتَى يَا دَهْرُ أَكْتُمُ لَوْعَةً","تُكَلِّفُ قَلْبِي كُلْفَةَ الرِّيحِ بِالشَّذَا",19,"ذ",2,0],["فَحَتَّامَ نَسْرِي فِي دَيَاجِير مِحْنَةٍ","يَضِيقُ بِهَا عَنْ صُحْبَةِ السَّيْفِ غِمْدُهُ",20,"د",2,0],["فَحَتَّامَ تُصِيْبُكَ الْغَوَانِي بِدَلِّهَا","وتَهْفُو بِلِيتَيْكَ الْحَمامُ السَّوَاجِعُ",21,"ع",1,0],["فَحَتَّامَ الجِراحُ تَظَلُّ تُدْمَي","وَتُنْكِؤُهَا رَزِيئَةُ كُلِّ نَاءِ",22,"ا",2,0],["فحتّى متى تعصى الإلهَ إلى متى","تبارزُ ربّي إنّهُ لرحيمُ",23,"م",1,0],["فحتى أراك بصرفِهِ زِيَناً","فهْي الزخارفُ منه لاالزِّين",24,"ن",1,0],["فَحَتَّامَ لاَ نَجْنِي جنَاهَا المُؤَمَّلاَ","نَمَتْ ونُمُوُّ الفَقرِ يَأْتِي مُعَجَّلاَ",25,"ل",2,0],["فحتامُ تصبيكَ الغوانى بِدلِّها","وتَهْفُ وبِلِيتَيْكَ الْحَمَامُ السَّوَاجِعُ؟",26,"ع",1,0],["فحتامَ ألقى في الهوى ما يسوءني","وَ أحملُ عبءَ الصبرِ وَ هوَ عظيمُ",27,"م",1,0],["فَحَتّى مَ أُبدي لِلموالي تَجَنُّباً","وَصَدّاً وَأُبدي لِلأعادي تَوَدُّدا",28,"د",2,0],["فحتى عليك اخترت تقضي سيوفه","اهل كان قد ضاقت عليك المذاهب",29,"ب",1,0],["فحتى متى أحنو عليك ولم أكن","بحفظك للميثاق يوما بواثق",30,"ق",1,0],["فحتام حتام الوفاءُ لصبوةٍ","رددتم إلها سؤلها اقبح الردّ",31,"د",1,0],["فحتى يا رب هذا الزمان","يشوب افتراري بالعبرة",32,"ه",1,0],["فحتام اطوى البيد والليل قسطل","اسنته من بارق ونجوم",33,"م",1,0],["فحتى متى الشكو الهوي وهوائه","لغير مجيب أو على غير واجب",34,"ب",1,0],["فحتام أرضى أن أقيم ببلدة","صديقي فيها كالعدو المجانب",35,"ب",1,0],["فحتَّامَ تَشقى بالسعادةِ طامعاً","ونفسُك في ليلِ الجحودِ سِراج",36,"ج",1,0],["فحتَّامَ التجمُّلُ في التَّجنِّي","وهذا الطَّرفُ مطروفٌ غَضيض",37,"ض",1,0],["فحتَّامَ التكتُّمُ والتخفّي","مذاعٌ حبُّنا والسرُّ فاش",38,"ش",1,0],["فحتّامَ تَلقى اللّصَّ يسطو بخنجرٍ","ويأكُلُ زادَ البَرّ والبَرُّ صائِم",39,"م",1,0],["فحتّامَ التعلُّلُ والتّمنّي","ومن شمسِ الشبابِ أرى ازوِرارا",40,"ر",2,0],["فحتامَ الفرنجةُ في هِراشٍ","عليهِ كأنَّهُ مالُ الصّبيِّ",41,"ي",1,0],["فحتّامَ الغضاضةُ والتغاضي","عن الأرزاء بالطّرفِ القذي",41,"ي",1,0],["فَحَتّامَ أستَمري جَنا العَجزِ وادِعاً","وَأَكرَعُ في ماءِ الخُمولِ عَلى عَمدِ",42,"د",1,0],["فَحَتّى مَتى يَحدو بِنا البين آخِذاً","زِمام التَنائي إنَّهُ لَذَميمُ",43,"م",1,0],["فَحَتّى مَتى يا منية القَلب تَمنعي","عُيونيَ عمّا هامَ في حُبّهِ قَلبي",44,"ب",2,0],["فحتّامَ كالطّرْفِ الجَنيبِ يُسارُ بي","فلا عِزَّ إجراء ولا رُوحَ إجْمام",45,"م",1,0],["فحتّامَ يا قَلْبي تَمَلُّ تَقاضياً","غريمَ غرامٍ لو يَشاءُ قَضاكا",46,"ك",2,0],["فحَتّامَ أَكسو الباخلينَ قلائداً","وفوقَ أَكُفِّ اللُّؤْمِ منهمْ جَوامع",47,"ع",1,0],["فحتّى متى أُمسِي وأُصبِحُ سادِراً","بدَهْري وأهلِيه وحاشاك مُغْتَرّا",48,"ر",2,0],["فحتّى متَى يَصْلَى ببأسِك خائن","منَ الجهلِ في آيات مُلكِكَ ألحَدا",49,"د",2,0],["فحتامَ أستشِفْي ضلالاً بقاتلٍ","وحتّام أستَجْدي نوالاً لناهب",50,"ب",1,0],["فحتّى متَى دَلْوِى يُقَعْقَعُ شَنُّه","وقد مُلِئتْ للآخرينَ ذِناب",51,"ب",1,0],["فحتّى مَتَى طرفهُ ما غَفا","وحتّى متى صرفُه ما غَفَلْ",52,"ل",1,0],["فحتى متى نبني بيوتاً مشيدة","وأعمارنا منا تهد وما تبنى",53,"ن",2,0],["فحتام المقام بعقرِ دارٍ","بِساطٍ فسحتي فيها كسجني",54,"ن",2,0],["فحتَّام ألقى من طباعك في الضحى","عقاربَ تسري من خداعك في جنحِ",55,"ح",1,0],["فَحَتّى مَتى يَسري إِلَيهِ تَفَضُّلي","وَهِجرانُهُ ما تَستَقِلُّ رَكائِبُه",56,"ب",2,0],["فحتَّى مَ قلبي لا يَقَرُّ خفوقُه","ونارُ غرامي لا يُرَجَّى خمودُها",57,"د",3,0],["فحتامَ بالبرقِ الحِجازيَّ مَوْهِناً","وبالصبحِ لا أنفكُّ غيرَ مروعِ",58,"ع",1,0],["فحتام لا أنفك شوقاً إلى الرضا","أصدق من صدقي لديه مكذب",59,"ب",1,0],["فحتّام تستَجْدي النّوى يمَّ مُقلَتي","فيرفِدُها دُرُّ الدُموعِ الهَوامِلِ",60,"ل",1,0],["فحتّامَ لا نارُ الصّبابةِ تنطفي","ولا للدموعِ الجارياتِ جُمودُ",61,"د",1,0],["فحتّى متى أَنَا لا أرعوِي","ولِمْ لا أقولُ ولا أفعلُ",62,"ل",1,0],["فَحَتَّامَ لاَ تَشْفِي العَلِيْلَ بِزَوْرَةٍ","هِيَ الرُّوحُ لِلْجِسْمِ الذِي مَالَهُ نَخْضُ",63,"ض",1,0],["فحتام ارتكابك متن وزر","يدوم الممتطون له سبايا",64,"ا",3,0],["فَحتام تؤذيني بِأَمثالك الَّتي","تُشير بِها نَحوي وَما كُنت ظالِما",65,"م",2,0],["فَحتّام في دين الصَبابة وَالهَوى","يُعاندني فيمَن أُحبُّ زَماني",66,"ن",2,0],["فحتى متى أنت في غفلة","أفق ودع الطيش حتى متى",67,"ت",2,0],["فحتى متى للطالبين صارم","تفل الليالي غربه إثر صارم",68,"م",1,0],["فحتام لم نتزود تقى","ونعلم إنا لنقفو الأثر",69,"ر",1,0],["فحتى متى يا قلب تعشق غادرا","وتعلق خدّاعا وتصحب قاليا",70,"ي",2,0],["فَحَتى مَتى سهد وَبعد كَأَنَّما","حَرام عَلَينا أن نقر وَنَهجَعا",71,"ع",2,0],["فَحَتّى مَتى نمسي وَيُصبح شَملنا","شَتيتاً وَشَمل الناس فيكَ جَميع",72,"ع",1,0],["فَحَتى مَتى تَبرى الرزايا سهامها","وَتقصدني عَمداً بِها فَتُصيب",73,"ب",1,0],["فحتى م هذا البعد والهجر منكمو","فقلبي من ابعادكم ضله الرشد",74,"د",1,0],["فَحَتّى مَتى هذا الفِرارُ حَذارَهُ","وَأَنتَ وَلِيٌّ وَالمُهَلَّبُ كافِرِ",75,"ر",1,0],["فحَتّامَ أَدنو من هَوى كلِّ نازحٍ","وأرعى بظهر الغيب كلَّ مُضيع",76,"ع",1,0],["فحتام لا أنفك أشكو لياليا","ودهراً بتفريق الأحبة مولعا",77,"ع",2,0],["فحتّى متى أنا مَسبِىءٌ ومُهتَضَمٌ","وليس مثلِىَ مَن يُسبَى ويُهتَضَمُ",78,"م",1,0],["فحتّامَ التخاذلُ والتجافي","وليس لروح جامعةٍ قِوام",79,"م",1,0],["فحتى متى أحيا وكيف تصبري","وقد غاب من صفو المودة ما أصفى",80,"ف",2,0],["فحتام هذا الصب باللَه سَيدي","فهل تمنحن قبل الممات وتقبل",81,"ل",1,0],["فحتى متى روحي الفدا لك غائباً","أحباه قد سيمت على خطة الخسف",82,"ف",1,0],["فحتَّى إذا ما الدهرُ كسَّرَ أكؤساً","وكنَّا نراها كالنجومِ مِنَ البُعدِ",83,"د",1,0],["فحتى متى يا دهر نصبر أنن