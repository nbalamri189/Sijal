{"poems":[[55,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[463,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[556,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136884","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128928","البسيط"],[4755,"قالت: تَوَضَّأْ مِن دُمُوعِي.. وصَلّْ","https://www.poetsgate.com/ViewPoem.aspx?id=200782",""],[4927,"عشق ورغد","https://www.poetsgate.com/ViewPoem.aspx?id=29945",""],[4927,"دَاْرُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=30192",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[5183,"من وحي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=180196",""],[5419,"لي الله","https://www.poetsgate.com/ViewPoem.aspx?id=32269",""],[6355,"صوني عفافك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66649&r=&rc=109",""]],"verses":[["وَقاؤُكَ مِن ذَمِّ العِدى خُلفُ نائِلٍ","يَدُرُّ وَلَم تُربَط عَلَيهِ عِصابُ",0,"ب",1,0],["وقاومي فتحَ أسطولٍ بمدرسةٍ","فطالما غلبَ القرطاسُ قرضابا",1,"ب",2,0],["وقاوم بالسياسة كلَّ داءٍ","طبيبٌ من لداغِ الدهرِ راقي",2,"ق",2,0],["وِقاؤك مهجةٌ قُسمتْ ثلاثاً","فريقاها إليك ولي فريقُ",3,"ق",1,0],["وقاوم ما أقامتك الدواعي","من العقبات أحجار العثار",4,"ر",1,0],["وقاؤُك من صَرْفِ الرّدى كلُّ ناكلٍ","إذا صَدمَتْهُ النّائباتُ تبلّدا",5,"د",2,0],["وقاومت شخص العزمِ والحزمِ والمجدِ","وخالفت شرع الملك والوطن الذي",6,"ي",1,0],["وقاوموا عصبا حفظا لدينهم","تبا لها كفرت بالله من عصب",7,"ب",1,0],["وقاومت عنوة تيارها وغدت","سداً منيعاً لها يحكي رواسيها",8,"ي",3,0],["وقَاوِمِي الإذلالَ، قُولِي لهُ:","سِواكَ مِن قَبلِ الشُّرُوعِ اعتَزَل",9,"ل",1,0],["وَقَاْوَمَ الْعِشْقَ وَالْعُشَّاْقَ مُدَّعِياًّ","أَنَّ الْحَسُوْدَ عَلَىْ عُدْوَاْنِهِ حُمِدَاْ",10,"د",2,0],["وَقَاْوَمَ الْحُبَّ مَأْفُوْنٌº وَعَاْذِلَةٌ","وَكُلُّهُمْ مُسْرَجَ الأَحْقَاْدِ قَدْ رَكِبُواْ",11,"ب",3,0],["وَقَاْوَمَتِ الشَّاْمُ جَيْشَ الطُّغَاْةِ","وَجَيْشَ الْحَقَاْرَةِº وَالْمُحْتَقَرْ",12,"ر",1,0],["وقاومها الصديق والناس ردة","فعاد جلال الحق بين شعوبه",13,"ب",2,0],["وقاومتُ لكنْ سهامك عفواً","أصابت فؤادي في مقتلي",14,"ل",2,0],["وقاومي قَسْوةَ الإعصار في دَعةٍ","فالصَّبْرُ حين أرومُ النَّصْرِ من عُددي",15,"د",2,0]]}