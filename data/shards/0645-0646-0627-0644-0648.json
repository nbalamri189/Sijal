{"poems":[[75,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[95,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[93,"ألا نبي لو طبعنا الشمس يوما","https://www.aldiwan.net/poem8791.html","عموديه"],[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[30,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[99,"أهب ببيانك الصافي تدفق","https://www.aldiwan.net/poem24394.html","الوافر"],[42,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[52,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[7,"لقد قلت للنعمان يوم لقيته","https://www.aldiwan.net/poem1993.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55210","السريع"],[119,"لله في طي هذا الكون آيات","https://www.aldiwan.net/poem41202.html","عموديه"],[146,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[185,"ولما لحقنا بالحمول ودونها","https://www.aldiwan.net/poem59048.html","الطويل"],[214,"من الود أني لا أحول عن الوفا","https://www.aldiwan.net/poem13465.html","الطويل"],[376,"سل الظعن هل من نظرة تستزيدها","https://www.aldiwan.net/poem57501.html","الطويل"],[396,"يا تار كالصلاة الفرض كم ذا حرام","https://www.aldiwan.net/poem54497.html","عموديه"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[412,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[463,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[463,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[521,"لعلك باك ان تغنت حمامة","https://www.aldiwan.net/poem48635.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126888","السريع"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86669","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39025","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62559","المجتث"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96306","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96573","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111833","الطويل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45378","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67418","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28549","المتقارب"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87738","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204645","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87663","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108101","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114105","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[4261,"","https://poetry.dctabudhabi.ae/diwan/poem/124290","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81710","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136561",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133160","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58090","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72437","المتقارب"],[4806,"عطر الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=180933",""],[4903,"وَأضخمَ هنديّ النَجارِ تُعدّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=96540",""],[4948,"من الواضحات الغر يخرج وحده","https://www.poetsgate.com/ViewPoem.aspx?id=81268",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5183,"حلبة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180215",""],[5199,"الموادع","https://www.poetsgate.com/ViewPoem.aspx?id=146781",""],[5341,"أخافُ","https://www.poetsgate.com/ViewPoem.aspx?id=185802",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5853,"لارا","https://www.poetsgate.com/ViewPoem.aspx?id=188354",""],[5956,"لماذا لستِ نائمة","https://www.poetsgate.com/ViewPoem.aspx?id=194124",""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""]],"verses":[["مِنَ الوَرى إِن يَفوقوهُم فَلا عَجَبٌ","كَذَلِكَ الشَهرُ مِن أَيّامِهِ الجُمَعُ",0,"ع",1,0],["مِنَ الوُرَيْقَاتِ تَجْرِي","بِهَا الصَّبَا الوَثَّابَهْ",1,"ب",2,0],["مِنَ الواضِحاتِ البيضِ تَجري عُقودُها","عَلى ظَبيَةٍ بِالرَملِ فارِدَةٍ بِكرِ",2,"ر",1,0],["من آل وهب شاد بنيانه","كلُّ أشمّ المجد والمعْطِس",3,"س",1,0],["من الوُضَّح اللُّعْس الشّفاه كأنما","يَفُهْنَ بأفواه الظباءِ الأوارك",4,"ك",1,0],["مِنَ الوادي إِلى صَحراءِ سينا","إِلى أَن زُرتَ ذَيّاكَ الضَريحا",5,"ح",2,0],["مِنَ الوَطَنِيَّةِ اِستَبقَوا رَحيقاً","فَضَضنا عَن مُعَتِّقِها الخِتاما",6,"م",2,0],["مِنَ الوَسمِيِّ مُبتَرِكٌ بُعاقٌ","يَسوقُ عِشارَ مُرتَجِزٍ رُكامِ",7,"م",1,0],["من الوطنِ الكريمِ على الليالي","إلى الوطنِ الكريمِ على الجوارِ",8,"ر",1,0],["من الوادي الخصيبِ بلا نظير","إلى الوادي المكلّلِ بالوقارِ",8,"ر",1,0],["مِنَ الوُقرِ في وَطَنٍ ما بِهِ","قِفافُ سِباخٍ وَلا أَبطَحُ",9,"ح",1,0],["مِنَ الوارِدينَ الرَوعَ كُلَّ عَشِيَّةٍ","إِذا هِيَ قامَت حاسِراً لا تَنَقَّبُ",10,"ب",1,0],["مِنَ الوارِداتِ الماءِ بِالقاعِ تَستَقي","بِأَعجازِها قَبلَ اِستِقاءِ الخَناجِرِ",11,"ر",1,0],["مِنَ آلِ وِيصَا وَكَفَى بِاسْمِهِمْ","مَدْحاً لَهُمْ مَهْمَا يُعَدُّ يُجْمَلِ",12,"ل",1,0],["من الوقاحة قامت فيه شعبذة","اضحت نتيجة معناها الخرافات",13,"ت",1,0],["من الورى هو لكن فاقهم كرما","كذلك الدرُّ والحصباءُ أحجارُ",14,"ر",1,0],["مِنَ الوَجدِ إِلاّ أَنَّ مَن فَاضَ دَمعُهُ","أراحَ وَظِلُّ المَوتِ تَغشَى بَوارِقُه",15,"ق",2,0],["من الودّ أني لا أحول عن الوفا","ولو رق جسمي في هواه ولو جفا",16,"ف",2,1],["من الوحشِ أعيت أن تَرى من يَصدُّها","عن الفتكِ فضلاً أن ترى من يَصيدُها",17,"د",3,0],["من الوعيد الشديد اللي يهد العظام","من حين موته يلاقي للأمور العظام",18,"م",1,0],["من الوعيد العظيم","أخباره ثابتات",19,"ت",1,0],["مِنَ الوَردِ خَداها مِنَ الدُرِّ ثَغرُها","عَلى أَنَّ رَيّاها مِنَ العَنبَرِ الوَردِ",20,"د",1,0],["من الوجد ما بي والدموع أُذيلها","منازل أشواقي ومنشا علاقتي",21,"ي",1,0],["من الوافين أحلاماً وعهداً","إذا هفَت الحُبَا ووهى الذمارُ",22,"ر",1,0],["من الوافين أحلاماً وصبرا","إذا الجُلَّى هفت بحلومِ عادِ",23,"د",1,0],["من الوَرق يَدعوها إِلى شُجوها الضحى","فَتَبكي وَتَبكي حينَ تَدنو الاِصائِل",24,"ل",1,0],["مِن آل وهّابٍ مضى سيّدٌ","بِمَجدهِ سَما على الفرقدينِ",25,"ن",1,1],["من الوهم تحصيل من الحق عاطل","جهام علوم بالستراب هواطل",26,"ل",1,0],["مِن الواجب المَكتوب وَهوَ صَلاتي","مَديحي لإِسماعيل بَعدَ صلاتي",27,"ي",1,1],["مِنَ الواضِحاتِ الغُرِّ لو أنَّها سَرَتْ","بأكْمَهَ لَيْلاً مازَها عَنْ تَنَقُّبِ",28,"ب",1,0],["من الوفاء حبيب","يولي محبيه ودّا",29,"د",2,0],["من الوُرقِ بالأصيافِ نَوّاحَةُ الضُّحى","إذا الغرقَدُ التَفَّت عَليه غياطِلُه",30,"ل",2,0],["من الوجدِ إِلاَّ مَن أَفاضَ دموعَه","أراحَ وظلُّ الموتِ تغشى بوارِقُه",31,"ق",2,0],["مَنِ الواقع المطعون في باحة البلى","يشلُّ باسيافٍ محدَّبةٍ شلاَّ",32,"ل",2,0],["مِنَ الوارِفِ الفينانِ وَشَّت برودهُ","ذِراعٌ مِنَ اللَيثِ الثُرَيّا لَهُ شِبرُ",33,"ر",1,0],["مِنَ الوُرْدِ أوْ أحْوَى كَأنَ سَرَاتَهُ","بُعَيْدَ جَلاءِ ضُرّجَتْ بِدِهَانِ",34,"ن",1,0],["من الورق البيضاء عن كل واحدٍ","بأربقعةٍ يخبلهم حين يخبل",35,"ل",1,0],["مِنَ الواخِزاتِ الَّتي لا تَصُد","دُ عَنهُنَّ سابِغَةُ الأَذرُعِ",36,"ع",1,0],["مِنَ الوُرقِ حَمّاءُ العِلاطَين باكَرَت","عَسيبَ أَشاءٍ مَطلعَ الشَّمسِ أَسحَما",37,"م",2,0],["من الوزير الذي ينجي بنائله","من مسه الضر او اردى به الكمد",38,"د",1,0],["مِن الوَفا أَن تُريقي الدَمع مُنسجماً","وَأَن تَذودي الكَرى عَن طَرفكِ الساجي",39,"ج",2,0],["مِنَ الوَسَخ هُنَاك وُصُولٌ خَافِيَه","فَمِل على اليَمينِ تَلقَ العَافِيَه",40,"ه",1,0],["من الوجدان جف العقل قدما","وفاض القلب بالعطف الغزير",41,"ر",1,0],["من الوجهاء ارباب المعالي","واهل الفضل فيهم والمبرَّه",42,"ر",2,0],["من الواشي من الناس اللئامِ","وأهل عدواتي بين الأنامِ",43,"م",1,1],["من الوصلِ ما يُستعذَبُ الهجرُ دُونَهُ","ويَعذُبُ أما غاضَ وِردُ الوَفا الصَدُّ",44,"د",1,0],["مِنَ الوُدِّ فِي أبنَاءِ فَاطِمَةٍ هُدُوا","إِلَى الخَيرِ فَافطِم عَن رَضاعٍ لِزَلَّةِ",45,"ل",2,0],["مِنَ الوُرقِ نَوّاحَةٍ باكَرَت","عَسيبَ أَشاءٍ بِذاتِ الغَصا",46,"ا",1,0],["من الوجد ما بي لو قد ايصر عاذلي","وعاذلتي ما بي لما عذلاني",47,"ن",2,0],["من الوسيلةِ أن لا يبتغي أحدٌ","وسيلةً لنداءٍ كلَّما سَمعا",48,"ع",2,0],["من الوَجد أنيّ لم أجد لي ناصراً","على حُب من أهوى ولم أر عاذرا",49,"ر",2,1],["من الوابل الهتان كل مسيحةٍ","تعم على كل السهول مع الوعر",50,"ر",1,0],["من الولد الصافي سليل مُحمَّدٍ","سعيدِ الموالِي وَصْلَكُم بالتَّشَوُّفِ",51,"ف",1,0],["من الوبل لا زلن يرشقنها","نبال يراهنَّ قوس السحاب",52,"ب",1,0],["من الولادة المعتصم ماخذ قرار","من الأساءه ال سر من رآأى تجين",53,"ن",1,0],["من الوِرق لا من ضربة الوَرْق يرتعي","أضاح ولا من ورده الخمس والعشرُ",54,"ر",1,0],["من الواضحات الغر يخرج وحده","ويلوي عليه رأسه كل شاعر",55,"ر",1,1],["مِنَ الوَقْتِ فَاغْنَمْ يَا بَنِي آدَمَ اتَّعِظْ","سَيَفْنَى مَطَافٌ فِي الْحَيَاةِ مُجَذَّعَا",56,"ع",2,0],["من الوفاء أن أوافيك بما","أردته لو كان مما يصعب",57,"ب",1,0],["من الوله والن وسيله وغائه","لجيت ابسلاواتنساك ماورعك",58,"ك",1,0],["من الوردِ والذنبِ والماءِ والقبر","أخافُ من الغيم والوعدِ والعطر",59,"ر",1,0],["من الوساوس في ليلي يقلبني","أنام في ليلتي في قلب رعديدِ",60,"د",1,0],["من ألوف من السنين تقضّت","وقف (العلعلان) يحصي خُطاها",61,"ا",3,0],["من الوجد الذي يحتل روحي","تبعثر خافقي ثلجا ونارا",62,"ر",2,0],["من الوسواس والخن","اس إنتاجاً وتصديرا",63,"ر",2,0],["من الوكيلة نلنا كل غايتنا","تبقى بداخلنا تحيا أياديها",64,"ي",3,0],["من الوجل المذعور في وحشة الدجى","تقلبهُ الأوهام في كل خاطر ؟",65,"ر",1,0]]}