{"poems":[[74,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[87,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[8,"وكأن فاها بات مغتبقا","https://www.aldiwan.net/poem21792.html","أحذ الكامل"],[108,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[101,"سمفونية على الرصيف","https://www.poetsgate.com/ViewPoem.aspx?id=17739",""],[147,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[228,"تذكرني وحقك ما نسيت","https://www.aldiwan.net/poem39692.html","الوافر"],[358,"بدر تبارك باري الخلق مبدعه","https://www.aldiwan.net/poem40014.html","البسيط"],[366,"يا غاية في الحسن هل","https://www.aldiwan.net/poem68066.html","مجزوء الكامل"],[409,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[438,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[438,"شق الصباح غلالة الظلماء","https://www.aldiwan.net/poem12771.html","الكامل"],[445,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[445,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[463,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[519,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[543,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[556,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[563,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[563,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87065","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59232","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96606","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133823","الخفيف"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178072","الرمل"],[1464,"","https://poetry.dctabudhabi.ae/diwan/poem/146699","الكامل"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136791",""],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100476","البسيط"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123676","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110260","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137388",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83216","المديد"],[2903,"","https://poetry.dctabudhabi.ae/diwan/poem/204534",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85156","الرمل"],[3812,"","https://poetry.dctabudhabi.ae/diwan/poem/142188","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113003","الكامل"],[4680,"متاهات الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=185037",""],[4755,"حَنين","https://www.poetsgate.com/ViewPoem.aspx?id=184513",""],[4755,"بَرْهِنْ بأنكَ ما تَزالُ ضَريرا","https://www.poetsgate.com/ViewPoem.aspx?id=198964",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4869,"ترنيمة جروحي","https://www.poetsgate.com/ViewPoem.aspx?id=151510",""],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""],[4984,"ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=178841",""],[4988,"ضياع انسان","https://www.poetsgate.com/ViewPoem.aspx?id=205153",""],[5064,"كينونة الكسر","https://www.poetsgate.com/ViewPoem.aspx?id=199122",""],[5092,"مَسَاوات","https://www.poetsgate.com/ViewPoem.aspx?id=152405",""],[5273,"كبرياء عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=28546",""],[592,"أكتب ككتبي كما قد كنت أكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=128829",""],[5376,"أهيم وداريا بدمعٍ أرومها","https://www.poetsgate.com/ViewPoem.aspx?id=188409",""],[5419,"تباريح الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=32266",""],[5431,"ثورة الشعب العربي..كانت وماتزال..","https://www.poetsgate.com/ViewPoem.aspx?id=195277",""],[5431,"أنا وأنا والإنعتاق الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=200430",""],[5470,"خضاب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=10979",""],[5493,"من وحي الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202279",""],[5512,"قضيت العمر أعجنه بصبري","https://www.poetsgate.com/ViewPoem.aspx?id=204500",""],[5561,"نعيم الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=196767",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5674,"أبحث عن خطاك بكل ضلع","https://www.poetsgate.com/ViewPoem.aspx?id=185910",""],[5674,"أبحث عن خطاك","https://www.poetsgate.com/ViewPoem.aspx?id=187322",""],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5703,"إلى عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=210393",""],[5736,"ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=203875",""],[5736,"يا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=208182",""],[5781,"أُنْثاكَ في العشق!","https://www.poetsgate.com/ViewPoem.aspx?id=208932",""],[5790,"قسما بقدك وهو لدن ذابلُ","https://www.poetsgate.com/ViewPoem.aspx?id=112103",""],[5956,"ألفة إنسانية مع الحيوان ( أقسى نحيب ) *","https://www.poetsgate.com/ViewPoem.aspx?id=183434",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5957,"أرى الآتي كما الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=14224",""],[6029,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=189441",""],[6056,"الحر تكفيه الإشارة","https://www.poetsgate.com/ViewPoem.aspx?id=130510",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6102,"أَفكارٌ هارِبَةٌ!!","https://www.poetsgate.com/ViewPoem.aspx?id=185364",""],[6152,"ضجيج قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203169",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""],[6275,"مهرجان من حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83609&r=&rc=1",""],[6357,"حبيبتي أين ...؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76446&r=&rc=6",""]],"verses":[["وأبحتني بحر الندى","حتى نظمتُ جواهرَه",0,"ر",2,0],["وَأَبَحنَ راحَتَكَ البِلى وَلَطالَما","أَمسى عَلَيها المالُ وَهوَ مُباحُ",1,"ح",1,0],["وَأَبَحَّ جُندِيٍّ وَثَاقِبَةٍ","سُبِكَتِ كَثَاقِبَةٍ مِنَ الجَمرِ",2,"ر",1,0],["وابحث هنالك عن خطيب طالما","رفع النداء، فأسمع الجلمودا",3,"د",2,0],["وأبْحِرِي في جُرْح جُرْحي أنا","لشهوتي صوتٌ لجوعي يدانِ",4,"ن",1,0],["وَأَبَحتَني مِنَناً تَتابَعَ سَيبُها","حَتّى لَقَد أَحبَبتُ أَن تَتَمَهَّلا",5,"ل",2,0],["وَأَبِحنا مِن حِماكُم كَنَفا","واقِياً مِن شرِّ كلِّ الفتنِ",6,"ن",1,0],["وَأَبحَثُ عَن شُعاعِكَ في سِراجي","وَلي مِن زَيتِكَ العُلوِيِّ قوتُ",7,"ت",1,0],["وَأبحر الوَجد وَالأَشجان طاميَة","يا غائِباً عَن عُيوني وَهي باكيةٌ",8,"ه",1,0],["وَأَبَحتَ قَتلي يا مَلي","كَ الحُسنِ وَهو مُحَرّم",9,"م",1,0],["وابحث بلطف عبارة","عنهم فهم قصدي وأمي",10,"م",2,0],["وأبحتَهُ لما علمتَ بأنه","بِدْعُ على شرعِ الندى لن يُمنَعا",11,"ع",2,0],["وأبَحْتُ يا أسماءُ معسولَ اللّمى","لهم وورْدَ الوجنةِ الحَمراءِ",12,"ا",2,0],["وأَبَحْتَ منها كُلَّ مُخْطَفَةِ الحَشا","شَرِقٍ عَلَى اللَّبَّات نَظْمُ وِشاحِها",13,"ح",3,0],["وأَبحُرُهُمْ زاخراتٌ إِلَيْهِ","ويَرْشُفُ فِي الثَّمَدِ المُسْتحيلِ",14,"ل",1,0],["وأبٌ حَطَّ في السماء ولو شا","ء تخَطّى مكانَها وتعدَّى",15,"د",2,0],["وأبحُرُكَ اللُجُّ الّتي قد جعلْتَها","بيومِ النّدى والضّرْبِ للمَدِّ والجزْرِ",16,"ر",1,0],["وأبَحتَ لي مِن حُسنِ روضكَ نُزهةً","بِحيَاض عِرفانٍ وحُسنِ نَوَاد",17,"د",1,0],["وأَبَحْتُمُ حَرَماً لكمْ","لو كان يُحمى بِي حميتُ",18,"ت",1,0],["وأبح مضناك بعض لقا","يا شفا قلبي من العلل",19,"ل",1,0],["وابحثوا عنكم وخلوا ال","بحث عن أوصاف ذاتي",20,"ت",2,0],["وَأَبَحتُ إِلّا في العَواطِفِ حَجبَهُ","إِلّا الحَنينَ لِبَدرِ ذاكَ المَطلَعِ",21,"ع",1,0],["وَأَبَحتُ إِلّا في الغَرامِ هَوادَةً","وَمَنَعتُ إِلّا أَنَّهُ المُتَوَجِّعُ",21,"ع",1,0],["وَأبحتَ الوشاةَ تنقل عَني","ما أَرادوا في كُل أَمر ملم",22,"م",1,0],["وأبحتها لسوى المحارب جامعاً","فيها بلاد اللّه والأقطارا",23,"ر",2,0],["وأَبَحْتُهَا رُوحي بِلاَ شَطَطٍ وَهَلْ","يَا رَوْضُ تَشْرِينِي بِفَصْلِ رَبيِع",24,"ع",1,0],["وَأبحت ما بي مِن جوىً","وَأَذَعتُ سرّاً مُحتَجب",25,"ب",1,0],["وابحثي بعثري التراب جدي لي","بارقاً فيه ضلّ عنه الفناء",26,"ا",2,0],["وأبحني ساعةً من عُمُري","أملأ الدّار شَكاةً وسلاما",27,"م",2,0],["وأبحن للدين القويم سعادةً","وقطعن عنه دوابر الإدبار",28,"ر",1,0],["وأبحتُ بسري بعدئذٍ","وطويتُ غراماً متهما",29,"م",2,0],["وأبحر من علوم الدين سافحةً","جرت فقل فيه بسم اللَه مجريه",30,"ي",2,0],["وأبحني نظرة أشفي بها","كبد أذاق العنا والنكدا",31,"د",2,0],["وابحث عن قلبٍ كقلبي مروعٍ","وعين كعيني تأنف الدمع والسهدا",32,"د",2,0],["وابحت حصنهم الشهيد فلم يكن","حصن لهم من بعد ذاكَ مشيدا",33,"د",2,0],["وأبحَرَ مُستقبلينَ بالحَرَم","غَربي الزمامِيَه عَلَم كالعَلَم",34,"م",1,0],["وأبحت سر الحب منك بمدمع","أخشى عليك بيمه أن تغرقا",35,"ق",2,0],["وَأَبحتُ الخِلَّ حُرَّ دَمي","مُذكِياً في مُهجَتي النارا",36,"ر",2,0],["وأبحتني يا سيدي","سقماً يجل عن السقم",37,"م",1,1],["وأبحث فيه عن حدس مصيب","فأعثر منه بالسهم المصيب",38,"ب",1,0],["وأبح لي شهد ثغر","يا رشا للوصل حرم",39,"م",1,0],["وأبحث عن ركن قصي لعلني","ألملم جسماً ذابل العود ذاويا",40,"ي",2,0],["وأًبحت من بَعدِهِم فَريسَةً","لِمَن بَغى وَفُرصَةً لِمَن بَعَا",41,"ا",1,0],["وأبحتَ خِلاَّنَ السُّرو","رِ من العُلا الصَّدرَ الرحيبا",42,"ب",2,0],["وأبحرُ لا مرسى تميل مراكبي","إليه وما لي في الظلام دليلُ",43,"ل",1,0],["وأبحَثُ عَنكَ فِي جُمَلٍ عَشَايا","وأَخْيِلَةٍ بِهَمسِكَ تَستَدِلُّ",44,"ل",1,0],["وأَبِح لَهُم ما كان يَصعُبُ نَيلُهُ","لِيُضاعِفُوا التطبيلَ والتزميرا",45,"ر",2,0],["وأبحر طي جز مكانفة لها","بكملها فافعل بها أيها تشا",46,"ا",1,0],["وابحرت تايه ,, وانثر دمعي بْروحي","وإن هبّت الريح انشّدها عن شراعه",47,"ع",2,0],["وَأَبْحَثُ كَيْ أُعَاْنِقَهَاْ عِنَاْقاً","يُحَقِّقُ مَاْ تُرِيْدُº وَمَاْ أُرِيْدُ",48,"د",1,0],["وأبحر في الأشعار والقلب مركب","يهيم وشوق النفس يرقي بمن ساروا",49,"ر",3,0],["وابحبش بي من الجاني من السّجان","هذاك اللي يساومني / بكتماني",50,"ن",2,0],["وأبحَثُ فِي ثنايَا المَوتِ عنِّي","لأنَّ الموتَ بالعُشَّاقِ أدْرَى",51,"ر",2,0],["وأبحثُ عن بقايايَ كأني","أفتِّشُ في كِيانيَ عن غريبِ",52,"ب",1,0],["وأبحتُ هجرَ الحُبِّ حينَ بكَتْ","في مَعبدِ النّسيانِ ذِكْراهُ",53,"ا",2,0],["وابحث وباحث وحشحت في مباحثة","وحيث حدثت عن بحث فعن سبب",54,"ب",1,0],["وأبحث عن روحي وذاتي فما معي","وجدتهما حينا وخارّ شكيمُها",55,"م",3,0],["وأبحر من عيونك نحو سعْدي","وتحسدني المراكبُ والشراعُ",56,"ع",1,0],["وأبحت قلبيَ للجراح غنيمة","واراه يرضخ ضاحكا يتفهمُ",57,"م",1,0],["وأبحث عن معانٍ راسخاتٍ","تُظللني بوهج الشكِ أمنا",58,"ن",2,0],["وَأُبحِرُ في صَمتِي لِكَي أسْتَلِذَّهَا","فُتُونٌ تُحِيلُ الصَّمتَ طَلاًّ وَأَموَاهَا",59,"ا",3,0],["وأبحرُ فِي المدَى قدرَ امْتِلائِي","بأطيافِ الصِّبَا عهدِ الحنايَا",60,"ا",3,0],["وأُبحرُ بينَ أمواجٍ تعالتْ","وبينَ الموجِ مارَ ظلامُ قهري",61,"ر",2,0],["وأبحروا وشراعُ الخوفِ يُجبرُهمْ","أن يهجروا وطناً من فقرِه وُهِبوا",62,"ب",3,0],["وَأَبْحُرٌ قُلِّدَتْ مِنْها غَوارِبُها","تَجِلُّ مِنْ أَنْ تُساوِيها ضَحاضِحُها",63,"ح",3,0],["وأُبحر ما استطعتُ فلا ألاقي","سوى لُجَجٍ به تنداح سُحبا",64,"ب",2,0],["وأبحرتْ في مسارِ الوهْم فهْيَ كَمَنْ","يجري وراء سَرابٍ وَهْوَ يبتعدُ",65,"د",1,0],["وأبحثُ عنْ وريدكَ في دمائي","وعنْ لونِ الزنابقِ في مسائي",66,"ا",3,1],["وأبحثُ عنْ خطاكَ بكلِّ ضِلعٍ","وعنْ حّرفي وعنْ سرِّ انتمائي",66,"ا",3,0],["وأبحثُ عنْ وريدكَ في دمائي","ونبضي فيك يهتفُ يا هنائي",67,"ا",3,1],["وأبحث من وجدي عليك ولوعتي","سوى صور الخيب