{"poems":[[90,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19720",""],[93,"روعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=53024",""],[101,"طفلتها","https://www.poetsgate.com/ViewPoem.aspx?id=36726",""],[60,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103067","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105623","الوافر"],[5720,"الأَرض (*)","https://www.poetsgate.com/ViewPoem.aspx?id=200226",""],[5908,"تعرفت منهم بالغربين أربعا","https://www.poetsgate.com/ViewPoem.aspx?id=170975",""]],"verses":[["وكيف هزمناهم فَولَّوْا كأننا","وإياهم أسد الشَرى تَطرد الحُمرا",0,"ر",2,0],["وكيف هل يَقبلها","كلمته فما أبى",1,"ا",1,0],["وكيف هشّت دمشق بعد محنتها","واسترجعت كلّ مسلوب ومفقود",2,"د",1,0],["وكيف هذا كان ؟ قد أُورثتْ","حتى رنينَ اللثْغة الصادحَهْ",3,"ح",2,0],["وكيف هناك العيش من بعد فقدهم","لعمرك شئ ما إليه سبيل",4,"ل",1,0],["وكيف هداك اللَه يرشد ذو هوى","وقواده للغي فيه هداته",5,"ت",2,0],["وكيف هذا وهو واجب القدم","كذا الوجود والدليل ثم تم",6,"م",1,0],["وكيف هناء ذي ود صحيح","ومن أحبابه شط المزار",7,"ر",1,0],["وكيف هو التظافر حين يرعى","محاصيلاً .. لغرسٍ من لبِيبِ",8,"ب",1,0],["وكيف هدوا الجفن من بعد ما نأى","لعمري أمين الدولة اليوم مسرعا",9,"ع",2,0]]}