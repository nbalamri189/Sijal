{"poems":[[276,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[371,"أي شأن لا يباح به","https://www.aldiwan.net/poem17294.html","المديد"],[498,"للظلم بين الأقربين مضاضة","https://www.aldiwan.net/poem67402.html","الكامل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21663","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53041","الكامل"],[2934,"","https://poetry.dctabudhabi.ae/diwan/poem/205206","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89320","البسيط"],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[4767,"دوحة الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179942",""],[4768,"الظل","https://www.poetsgate.com/ViewPoem.aspx?id=213021",""],[5136,"وابأبي مبسم رقيق","https://www.poetsgate.com/ViewPoem.aspx?id=121635",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5848,"مشكلة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=53446",""]],"verses":[["للظاعنين عَليّ عهد أَنَّني","أجرى المَدامع حين اذكرهم دما",0,"م",2,0],["لِلظُبا الأَجفانُ نَعرِفُها","وَلِهَذا السَيفِ آذانُ",1,"ن",1,0],["لِلظُّلمِ بَينَ الأَقرَبينَ مَضاضَةٌ","وَالدَلُّ ما بَينَ الأَباعِدِ أَروَحُ",2,"ح",1,1],["لِلظَّبيَةِ البِكرُ عَيناها وَتَلعَتُها","في حُسنِ مُبتَسَمٍ مِنها وَعِرنينِ",3,"ن",1,0],["للظاهر الغازي الذي شرفت","بزمانه الأزمان والحقب",4,"ب",1,0],["للظَّبْيِ منه أَيْطَلاهُ كمَا حَكَى","رَأْسُ القَرِيض وللنَّعامةِ سَاقُهُ",5,"ق",2,0],["للظرف واللطف حكم في تبسُّطه","والسيف والضيف عند الجد أحكام",6,"م",1,0],["للظلم قامت به في الكون دولته","إذ باركتها على رغم النوى دولُ",7,"ل",1,0],["للظلم والجور والعدوان ما اجتمعتْ","أحلافه تحت سقف الليل تأتمِر",8,"ر",1,0],["للظلِّ أنحو حينَ يجتاحُ الأسى","مُدُنيْ فما منْ ساكنٍ إلاّيا",9,"ا",3,0],["للظبي منه العين والتحديق","وللشقيق خده شقيق",10,"ق",1,0],["للظلم حد في الزما","نِ إذا تجاوزه اضمحلا",11,"ل",2,0],["للظلم ميدان وللعدل ميدان","وللحق ناس وللعروبة قوانين",12,"ن",1,0],["للظما قلبٍ تضج به المحاني","ما تبلله السواليف القديمة",13,"م",2,1]]}