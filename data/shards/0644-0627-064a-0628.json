منهم مثل مبلغه","في عامهم ذلك الماضي ولم يثر",147,"ر",1,0],["لا يَبعَدَن قَومي الَّذينَ هُمُ","سُمُّ العُداةِ وَآفَةُ الجُزرِ",148,"ر",1,1],["لا يُبْعِدِ الله الجمالَ مَحَبَّةً","عَذْبَ العذابِ مُهَوِّنَ الأَخطارِ",149,"ر",1,0],["لا يبغيان ولكن من قرارهما","يستخرج البر من درّ ومرجان",150,"ن",1,0],["لا يبلغ اللفظ وصفكم لفتىً","بجهد في شعره وفي خطبه",151,"ب",2,0],["لا يُبعِدُ الجُودَ من يومِ الجِلادِ ولا","يُغِبُّ يومَ نداهُ يومُ مُجتلَدِهْ",152,"د",2,0],["لا يُبْعِدِ الرحمنُ إِلّا مُهْجَةً","ضلَّتْ وَفِي يدها سِرَاجُ هُدَاكا",153,"ك",2,0],["لا يبذلن الذي أغليت من أدبي","نارا تصب على رجس الشياطين",154,"ن",1,0],["لا يبالي إن أتاه","الشكر أم لم يأت شكر",155,"ر",1,0],["لا يُبعِدُ اللَهُ حُسّادي وَزادَهُمُ","حَتّى يَموتوا بِداءٍ فِيَّ مَكنونِ",156,"ن",1,1],["لا يُبعد اللهُ الوفاءَ صاحباً","كان ولا أطمعُ أن يكونا",157,"ن",2,0],["لا يبالون والمكارمُ فيهم","باقياتٌ ما ابتزَّ خطبٌ فأفنَى",158,"ن",2,0],["لا يبالي إذا بقيتم مَن الحا","بسُ عنه النوالَ أو مَن أنالَهْ",159,"ل",2,0],["لايبتغين بحلا","واتِ الهوى التبعُّلا",160,"ل",2,0],["لايبالين افتقاراً من غنىً","وافتراقاً بين معزولٍ ووالي",161,"ي",1,0],["لا يبلغُ المِسبار قعرَ جراحها","وبه وفي كفّ المعالج طولُ",162,"ل",1,0],["لا يبالي عاقرُ البدن لها","أيّها الواجبةُ الجنبِ الشريقَهْ",163,"ق",2,0],["لا يُبعدنّ اللّه دارَ معاشرٍ","مذ جمَّعوا شملَ العلا لم يُصدَعِ",164,"ع",1,0],["لا يبالي الحيرانُ ما أَطلقوا الأي","مانَ أَن تُمسكَ السماءُ القَطرا",165,"ر",2,0],["لا يُبعِد اللّهُ الألى حفِظ العلا","بيتٌ لهم حولَ النجوم مَشِيدُ",166,"د",1,0],["لا يبالي أيَّ زندٍ أَصلدتْ","مَن أتى راحتَه مقتدِحا",167,"ح",2,0],["لا يُبعدِ اللّهُ قلباً ظلَّ عندكُمُ","لم يُغنِني عنه نِشدانٌ ولا طلبُ",168,"ب",1,0],["لا يَبلُغُ السَّبرُ ما يُفَرَّى","مُعمِّقاً جُرحُها الرغيبُ",169,"ب",1,0],["لا يبْتغي للقِرى عُذْراً ليمْنَعَه","ولا يحلُ اذا ما حَلَّ بالخَمَرِ",170,"ر",1,0],["لا يَبلُغُ الناسُ ما فيهِم إِذا ذُكِروا","مِل مَجدِ إِن أَجحَفوا في المَجدِ أَو قَصَدوا",171,"د",3,0],["لا يبتغي منه سوى أحرُف","يعتدها أَشرف ذخرٍ يفاد",172,"د",1,0],["لا يَبعَثُ العيرَ إِلّا غِبَّ صادِقَةٍ","مِنَ المَعالي وَقومٌ بِالمَفاريقِ",173,"ق",1,0],["لا يَبلُغَنّ إليه سهمُ مُعانِدٍ","لو كان في قَوسِ الكَواكِبِ ينزِعُ",174,"ع",1,0],["لا يبلغ الطرف مدى جيشه","والطرف يطوي الأرض بالإلتماح",175,"ح",1,0],["لا يبلغ البلغاء وصف مناقب","أثنى على إحسانها التنزيل",176,"ل",1,0],["لا يبرح المقصوص موضعه","ولقد قصصت فطرت عن وكري",177,"ي",1,0],["لا يَبتَغي ذِمّةً مِن غَيرِ نَجدتهِ","إنّ الشّجاعَةَ فيها أَوثقُ الذممِ",178,"م",1,0],["لا يبعد اللَّه اِنصِلاتك للعِدا","عَجِلاً تُدَهْدِه جَحْفَلاً في جحفلِ",179,"ل",1,0],["لا يبعدِ اللَّهُ أقواماً مضوا سَلَفاً","كانوا على نَبَواتِ الدّهرِ أنصاري",180,"ي",1,0],["لا يَبرَحُ الزُوّارُ مِن بابِها","كَأَنَّما ضَمَّهُمُ عُرسُ",181,"س",1,0],["لا يَبعَدَن مالٌ رَبَيتَ بِهِ العُلى","فَحَصِدتَ فيهِ وَقُل لِعاذِلِكَ اِبعَدِ",182,"د",1,0],["لا يَبلُغُ الدُنيا كَثيرَ عَطائِهِ","وَقَليلُهُ عِندَ الكَثيرِ كَثيرُ",183,"ر",1,0],["لا يبلغُ الشَّيخُ منَّا في مدراسِهِ","ما كانَ يبلغُ راعي المَعْزِ والضَّانِ",184,"ن",1,0],["لا يَبرَحُ المَرْءُ حيثُ اللهُ يَجعَلُهُ","ومَنْ رأى النَّجْمَ تحتَ الماءِ قد رَسَبا",185,"ب",2,0],["لا يُبالي بأُرجُوانٍ وخَزٍّ","من كَسَاهُ عقلٌ وعِرضٌ ودِينُ",186,"ن",1,0],["لاَ يَبْلُغُ الدَّهْرُ أَنْ يُشْكَى مُحَاوِرُهُ","وَلاَ يَهِي غَيْرُ حَبْلٍ لَمْ يَصِلْ حَبْلَهْ",187,"ل",2,0]]}