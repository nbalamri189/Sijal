/www.aldiwan.net/poem15942.html","البسيط"],[472,"الأكرمون طوال الدهر إن نسبوا","https://www.aldiwan.net/poem4668.html","البسيط"],[508,"يا من حواه الدين في عصره","https://www.aldiwan.net/poem2447.html","السريع"],[509,"قل لابن كلثوم الساعي بذمته","https://www.aldiwan.net/poem2134.html","البسيط"],[516,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[517,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[517,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[529,"ولقد بلوت الأصدقاء فلم","https://www.aldiwan.net/poem45955.html","أحذ الكامل"],[553,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[553,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[553,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[555,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[555,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[555,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[564,"جاءت رسالة إبراهيم سافرة","https://www.aldiwan.net/poem52791.html","البسيط"],[564,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[564,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[569,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/31375","البسيط"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/20574","المتقارب"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/204087","البسيط"],[1082,"","https://poetry.dctabudhabi.ae/diwan/poem/97677","الكامل"],[1092,"","https://poetry.dctabudhabi.ae/diwan/poem/130527","الكامل"],[1103,"","https://poetry.dctabudhabi.ae/diwan/poem/20875","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18987","البسيط"],[1191,"","https://poetry.dctabudhabi.ae/diwan/poem/200349","الكامل"],[389,"لا تَقُولن إذا ما لم تُرِدْ","https://www.poetsgate.com/ViewPoem.aspx?id=22522",""]],"verses":[["لا يُبالونَ في القِيا","دِ الرِقابَ العَواصِيا",0,"ي",2,0],["لا يَبرَحُ المَجدُ مَرفوعاً دَعائِمُهُ","ما دامَ مُعتَمِداً مِنّا عَلى رُكُنِ",1,"ن",1,0],["لا يُبعِدِ اللَهُ مَن غالَت رَكائِبُهُ","صَبري وَقَلقَلَ مِن دَمعي تَقَلقُلُهُ",2,"ل",2,0],["لا يُبعِدِ اللَهُ أَقواماً رُزِئتُهُمُ","لَو ثَلَّموا مِن جُنوبِ الطَودِ لَاِنتُهِكا",3,"ك",2,0],["لا يُبعِدِ اللَهُ فِتياناً رُزِئتُهُمُ","رُزءَ الغُصونِ وَفيها الماءُ وَالوَرَقُ",4,"ق",1,1],["لا يَبُذُّ الهُمومَ إِلّا غُلامٌ","يَركَبُ الهَولَ وَالحُسامُ رَديفُ",5,"ف",1,0],["لا يُبعِدِ اللَهُ الَّذينَ نَأَوا","وَقَفوا الغَرامَ بِنا وَما وَقَفوا",6,"ف",3,0],["لا يُبعِدِ اللَهُ مَن غارَت رَكَائِبُهُم","وَأَنجَدَ الشَوقُ بَينَ القَلبِ وَالبَصَرِ",7,"ر",1,0],["لا يَبِت ذاكَ الحَبيبُ كَما","باتَ هَذا القَلبُ وَالكَبِدُ",8,"د",1,0],["لا يُبعِدُ اللَهُ غِلمَةً رَكِبوا","أَغراضَهُمُ وَاِستَفَوا مِنَ البُعُدِ",9,"د",1,0],["لا يُبعِدَنَّ اللَهُ بُردَ شَبيبَةٍ","أَلقَيتُهُ بِمِنىً وَرُحتُ سليباً",10,"ب",2,1],["لا يُبعِدِ اللَهُ غَيري حينَ قُدتُ لَكُم","نَفسي وَبِعتُكُمُ صَفوي بِتَكديري",11,"ر",2,0],["لا يُبالي السُرى إِذا اِعتَكَرَ اللَي","لُ وَخانَت مَواقِعُ الأَقدامِ",12,"م",1,0],["لا يُبَالِي شُحَّ السَّحَابِ عَلَيْهِ","وَعَلَى غَيرِهِ السَّحَابُ هَتُونُ",13,"ن",1,0],["لا يَبْخَلُونَ إِذَا أَهْلُ النَّدَى بَخِلُوا","وَلَيْسَ يُؤْذَى النَّدَى مِنْهُمْ بِمَنَّانِ",14,"ن",1,0],["لا يُبارِيهِ فِي إسَامَةِ مَنْ يَرْ","عَاهُمُ خَيْرُ مَنْ رَعَى وَأَسَامَا",15,"م",2,0],["لا يبعدُ النصرُ العزيزُ فإنه","آوى إليك وأنت نعم الموئلُ",16,"ل",1,0],["لا يبلُغ المرء منتهى أرَبه","إلا بعلم يَجدّ في طلبه",17,"ب",2,1],["لا يَبعُدَن أَنَسٌ تَغَيَّرَ بَعدَهُم","طَلَلٌ بِبُرقَةِ رامَتَينِ مُحيلُ",18,"ل",1,0],["لا يُبعِدِ اللَهُ شَخصاً لا أَرى أَنَساً","وَلا تَطيبُ لِيَ الدُنيا إِذا بَعُدا",19,"د",2,0],["لا يَبعُدَنَّ رَبيعَةُ بنُ مُكَدَّمٍ","وَسَقى الغَوادي قَبرَهُ بِذُنوبِ",20,"ب",1,0],["لا يبرح الناس في محل وفي شظف","حتَّى يجدد لي في وجهه سفر",21,"ر",1,1],["لا يبعد الله أيام العلاء فما","يقضي حقوق ثناها في الأنام فمُ",22,"م",1,0],["لا يَبْعُدا من حالبَيْن كلاهما","يمْرِي الشفاء فَتَسْتَدِرُّ لِقاحُه",23,"ح",2,0],["لا يبذلُ الرّفد حين يبذُله","كمشتري الجودِ أو كمقتاضه",24,"ض",2,0],["لا يبعدنَّ شبابُك الغرنيقُ","أيام منظره عليك أنيقُ",25,"ق",1,1],["لا يبذُلُ الرفدَ مُعْفِياً وإذا","كُلِّمَ فيه حَسبتَهُ كُلِما",26,"م",2,0],["لا يبعد اللَّهُ أياماً له جمعتْ","إلى سكونِ ليالٍ أُنسَ أيامِ",27,"م",1,0],["لا يُبالي الشتمَ عِرضٌ","كلُّهُ شَتْمٌ وكَلْمُ",28,"م",1,0],["لا يُبْعِدُ اللَّه أسلافاً لنا سَبقوا","ولو بقُوْا للَقوا ما لا يحبونا",29,"ن",2,1],["لا يُبعِدَنَّ اللَهُ لُبَّكَ إِذ غَزا","فَسافَرَ وَالأَحلامُ جَمٌّ عُثورُها",30,"ر",3,0],["لا يَبلُغُ الناسُ أَقصى وادِيَيهِ وَلا","يُعطي جَوادٌ كَما يُعطي وَلا يَهَبُ",31,"ب",1,0],["لا يُبالي مُغَرِّبٌ في ذَويهِ","أَن يَراهُ ذَووهُ في الغُرَباءِ",32,"ا",2,0],["لا يَبتَسِمنَ لِشَيءٍ","أَما لَهُنَّ ثُغورُ",33,"ر",1,0],["لا يُبالي أَحَبَّهُ مَن أَدلَج","أَم أَحَبَّ اللَيلَ البَهيمَ الدَجِيّا",34,"ي",2,0],["لا يُبالي أَأَودَعوهُ الثُرَيّا","أَم رَموهُ في حَمأَةٍ مَسنونَه",35,"ن",2,0],["لا يَبتَغي الراجي إِلَيكَ وَسيلَةً","إِلّا الرَجاءَ وَأَنَّكَ المَأمولُ",36,"ل",1,0],["لا يَبلُغُ المَدحَ أَقصى وَصفِ مَدحِكُمُ","وَلَم يَنَل مِثلَ ما أَدرَكتُمُ أَحَدُ",37,"د",1,0],["لا يبالي بمنطق رث شعب","قد درى ان يومه غير امسه",38,"ه",1,0],["لا يبلغ المرء من لذاته وطرا","حتى يمتع منه السمع والبصرا",39,"ر",2,0],["لا يبالي من بعد ادراكه المثا","ر ألاقي سلامة ام زهوقها",40,"ق",3,0],["لا يبالون بالحوادث ربحا","حملت في بطونها أم خَسارا",41,"ر",2,0],["لا يُبطِرَنَّكَ مِن حَريرٍ مَوطِئٌ","فَلَرُبَّ ماشٍ في الحَريرِ تَعَثَّرا",42,"ر",2,0],["لا يَبلُغُ الناسُ جَهداً عَفوَ سُؤدُدِهِ","وَلا تُعيرُ أَكُفَّ الناسَ ما يَهَبُ",43,"ب",1,0],["لا يَبعَدِ اللَهوُ في أَيّامِنا المودي","وَلا غُلُوُّ الهَوى في الغارَةِ الرودِ",44,"د",1,1],["لا يَبعَدوا أَبَداً وَهَل تُدنيهُمُ","ياوَهبُ قَولَةُ عاشِقٍ لايَبعَدوا",45,"د",3,0],["لا يَبرَحُ المَضّاضُ كُحلَ صَحيحَتي","رِجسَينِ مَرذولَينِ في الأَرجاسِ",46,"س",1,0],["لا يَبرَحُ الحَزمُ يَستَوفي عَزيمَتَهُ","أَقامَ مُبتَدِئً أَم سارَ مُعتَزِما",47,"م",2,0],["لا يَبلُغُ السَمَكُ المَحصورُ غايَتَها","لِبُعدِ ما بَينَ قاصيها وَدانيها",48,"ي",3,0],["لا يَبلُغُ العَلياءَ غَيرُ مُتَيَّمٍ","بِبُلوغِها يَعصي لَها وَيُطيعُ",49,"ع",1,0],["لا يُبرِئُ القَطِرانُ المَحضُ ناشِرَها","إِذا تَصَعَّدَ في الأَعناقِ وَاِستَعَرا",50,"ر",2,0],["لا يُبعِدُ اللَهُ اليَمينَ الَّتي سَقَت","أَبا اللَيلِ تَحتَ اللَيلِ سَجلاً مِنَ الدَمِ",51,"م",1,1],["لا يُبْعِدُ الله مِنكم عُصبةً فَضُلَتْ","فَزادهَا الفضلُ إقصاءً وإبعادا",52,"د",2,0],["لا يُبعدِ اللهُ دُرّاً حلَّياكَ به","فكَمْ فتىً عُطِّلَتْ منه تَرائِبُه",53,"ب",2,0],["لا يَبرَحُ الريشُ عَلى نُوّارِها","وَالدَمُ مَسفوكاً عَلى أَقطارِها",54,"ه",2,0],["لا يُبلَغُ السُؤلُ إِلّا بَعدَ مُؤلَمَةٍ","وَلا يَتِمُّ المُنى إِلّا لِمَن صَبَرا",55,"ر",2,0],["لا يبالي الطول ولا يحفل الأقدا","ر جاءت بكل أمرٍ ضاري",56,"ر",2,0],["لا يبالي غداة يصغي إلى الشي","خ وللشيخ هالة من وقارِ",56,"ر",1,0],["لا يُبعِدِ اللَهُ مَلحوداً أَقامَ بِهِ","شَخصُ الحِجى وَسَقاهُ الواحِدُ الصَمَدُ",57,"د",1,0],["لا يَبرَحونَ وَمَن رَآهُم خالَهُم","أَبَداً عَلى سَفَرٍ مِنَ الأَسفارِ",58,"ر",1,0],["لا يُبصِرُ الحَقَّ مَن جَهلٌ أَحاطَ بِهِ","وَكَيفَ يُبصِرُ نُورَ الحَقِّ وَهوَ عَمِ",59,"م",1,0],["لا يُبعِدُ النَقدَ مِن حَقّي فَيُنكِرَهُ","وَلا يُحَدِّثُني أَن سَوفَ يَقضيني",60,"ن",2,0],["لا يُبالي حين يقضِي أمرَهُ","نام عنه حتفُه أم لم يَنَمْ",61,"م",1,0],["لا يُبصِرُ الرُشدَ في أَمرٍ يُدَبِّرُهُ","وَلا يَفيءُ إِلى رَأيٍ وَمَعقولِ",62,"ل",1,0],["لا يُبعِدِ اللهُ منه والداً حَدِباً","سمحَ الخلائِقِ أرعاهُ ويرعاني",63,"ن",2,0],["لا يبلُغُ الباني ذُراه ولا يُرى","في الدّاعِمِينَ بِناؤُه كدِعامِهِ",64,"م",2,0],["لا يَبلغُ العِرضَ منها حين تمنعُه","من خيفةِ العارِ حتى تبلغَ الأجلا",65,"ل",2,0],["لا يُبالي غَيْظَ القلوبِ ولا يَحْ","فِلُ في اللهِ لائماً أو نذيرا",66,"ر",2,0],["لا يُبصِرُ الزَلّاتِ وَهيَ ظَواهِرٌ","تَبدو وَيُبصِرُ مَوضِعَ الفَضلِ الخَفي",67,"ف",2,0],["لا يُبكِهِ الدَهرُ الخَؤونُ بِحادِثٍ","فَالدَهرُ عَنهُ ضاحِكٌ بَسّامُ",68,"م",1,0],["لا يبالي مكبَّلا","نالَهُ أمْ مُجَدَّلا",69,"ل",2,0],["لا يَبتَغي الواجِدُ مِثلي أَخاً","إِذا أَخُو الواجِدِ لَم يُسعِدِ",70,"د",1,0],["لا يُبعِدِ اللَهُ إِذ وَدَّعتُ أَرضَهُمُ","أَخي بَغيضاً وَلَكِن غَيرُهُ بَعُدا",71,"د",2,1],["لا يُبعِدِ اللَهُ مَن يُعطي الجَزيلَ وَمَن","يَحبو الجَليلَ وَما أَكدى وَلا نَكِدا",71,"د",2,0],["لا يَبْعَدَنْ بادي الصّبابةِ مُغْرَمٌ","حَنّتْ كواكبُ ليلهِ لحَنينه",72,"ن",2,0],["لا يَبْعَدنّ إذِ العَبيرُ له ثَرى","والبانُ أيْكٌ والشُّموسُ قَطين",73,"ن",1,0],["لا يُبْعِدَنَّ اللّهُ إلاّ مَعْشَراً","أضْحَوْا على الأصنامِ منكُم عُكَّفا",74,"ف",2,0],["لا يَبطَرونَ وَلا يَخزونَ نادِيَهُم","كَأَنَّهُم جُثَثٌ مِن غَيرِ أَنفاسِ",75,"س",1,0],["لا يَبذَخونَ عَلى النَديمِ إِذا اِنتَشَوا","وَلَهُم إِذا العَرَبُ اِعتَدَت تَسليمُ",76,"م",1,0],["لا يبعجُ الصدعَ ولكنّهُ","لفُقحةِ الأمردِ بعّاجُ",77,"ج",1,0],["لا يُبالي غَيرَ مَن يَعرِفُهُ","وَأَرى الناسَ لَهُم فيكَ أَثَر",78,"ر",1,0],["لا يُبعِدُ الناسُ ما يَدنو القَضاءُ بِهِ","وَلا يُقَرِّبُهُ شَيءٌ إِذا بَعُدا",79,"د",2,0],["لا يَبخَلونَ عَلى القَصِي","يِ وَيُنعِمونَ عَلى المُسانِد",80,"د",1,0],["لا يُبعِدَ اللَهُ جِيراناً تَرَكتُهُمُ","مِثلَ المَصابيحِ تَجلو لَيلَةَ الظُلَمِ",81,"م",1,1],["لا يَبرَمونَ إِذا ما الأُفقُ جَلَّلَهُ","بَردُ الشِتاءِ مِنَ الإِمحالِ كَالأَدَمِ",81,"م",1,0],["لا يُبصِرُ القَومُ في مَغناكَ غِسلَ يَدٍ","عَلى الطَعامِ إِلى أَن يُرفَعَ السورُ",82,"ر",1,1],["لا يَبلُغُ الباني وَلَو","رَفَعَ الدَعائِمَ ما بَنَينا",83,"ن",2,0],["لا يبعث الشعر أَفراحاً ولا أَلَما","ما لَم يكن عن شعور المرء قد نظما",84,"م",2,1],["لا يُبْعِدِ اللهُ أَصْحَاباً تَرَكْتُهُمُ","لَمْ أَدْرِ بَعْدَ غَدَاةِ البَيْنِ مَا صَنَعُوا",85,"ع",3,0],["لا يُبالونَ بِالطَبيعَةِ حَنَّت","أَم تَجَنَّت أَمِ اِحتَواها النَعورُ",86,"ر",1,0],["لا يبلغان في الكتاب غايه","ولا الكتاب بالغ النهايه",87,"ه",1,0],["لا يبغض الله ولا رسوله","ولا العباد كالمرابين فئة",88,"ه",1,0],["لا يَبْلُغُ الْمَرْءُ مَا يَهْوَاهُ مِنْ أَرَبٍ","إِلَّا بِتَرْكِ الَّذِي يَخْشَاهُ مِنْ ضَرَرِ",89,"ر",1,0],["لا يَبْلُغُ الرِّبْحَ أَوْ يُفارِقُهُ","كَمَاتحٍ خَانَ كَفَّهُ الْكَرَبُ",90,"ب",1,0],["لا يُبَالِي القُشُورَ فِي القَوْلِ وَالفِعْ","لِ وَيَمْضِي إِلَى اللُّبَابِ الصَّمِيمِ",91,"م",1,0],["لاَ يَبْعُدُ الْقُطْبُ عَلَى عَزْمِهَا","إِذَا توَخَّتْ عِنْدَه مَقْصِدَا",92,"د",2,0],["لاَ يُبَرِّح بِكَ الأَسَى فإِذا الْعَزْ","مُ الذِي كَانَ قَاهِراً مَقْهورُ",93,"ر",1,0],["لاَ يُبَارِي ذَاكَ الذَّكَاءَ ذَكَاءٌ","لاَ وَلاَ ذِلكَ الشُّعُورَ شُعُورُ",93,"ر",1,0],["لا يُبَالِي نَصِيحَ سُوءٍ وَلا يَلْ","وِي بِزِينَاتِ رَأْيهِ المَأْفُونِ",94,"ن",1,0],["لا يَبعَدَن قَلبي الَّذي خَلَّفتُهُ","وَقفاً عَلى الإِتِهامِ وَالإِنجادِ",95,"د",1,0],["لاَ يُبَالِي الأَنْوَاءَ مِنْ بَعْدِما عَا","شَ حَيَاةً كَثِيرَةَ الأَنْوَاءِ",96,"ا",2,0],["لا يُبالي إذا سَعَى للمعَالي","خَبَط الشوْكَ أم تَوطَّأَ وَرْدَا",97,"د",2,0],["لا يُبالي فقد تَمَلَّكَهُ الْحُبُّ","وأوحَى إِليهِ ألاَّ يُبالي",98,"ل",2,0],["لا يبالي حين يحمي حقَّهُ","لو عد الدهرُ عليه لرماهْ",99,"ا",2,0],["لا يبغضون عدوهم","أو يعرفون علام عُودي؟",100,"د",2,0],["لا يبن أبوي شلون . محتر وأطغي وأحتمي","والوقت لامنّه زما راس حضّي يقمعه",101,"ع",2,0],["لا يَبْعُدُ اللّهوُ، في أيّامِنَا، المُودي،","ولا غُلُوُّ الهَوَى في الغَادَةِ الرُّودِ",102,"د",1,1],["لا يَبرَحُ الحَزْمُ يِستَوْفي عَزِيمَتَهُ،","أقَامَ مُبْتَدِئاً، أَمْ سَارَ مُعتَزِمَا",103,"م",2,0],["لا يبعد أبداً وهل تدنيهم","ياوهب قولك عاشق لا يبعد",104,"د",1,0],["لا يبلغ لناس جهداً عفو سؤدده،","ولا تعير أكف الناس ما يهب",105,"ب",1,0],["لا يبالي مغرب في ذوبة","أن يراه ذووه في الغرباء",106,"ا",2,0],["لا يبالي أأدعوه الثريا","أم رموه في حمأة مسنونه",107,"ن",2,0],["لاَ يُبْرىءُ القَطِرَانُ المَحْضُ ناشِرَها","إذا تصَعَّدَ في الأعْتَاقِ واسْتَعَرَا",108,"ر",2,0],["لا يُبْطِرنَّكَ من حرير مَوْطِىء ٌ","فلرُبَّ ماشٍ في الحريرِ تَعثَّرَا",109,"ر",2,0],["لا يبيت الليل الا حولها","اسد غاب غيرة ترعى فناها",110,"ا",3,0],["لا يبالِي بمالِه لو سألنا","هُ جميعاً أعْطَى وثنّى وزادَا",111,"د",2,0],["لا يُبتَغَي التزويج للغُرَباء","في دار غُرْبتهم من البُعَداءِ",112,"ا",2,0],["لا يبلغ المنثور بعض مآثرٍ","صانت لك العليا ولا الموزون",113,"ن",1,0],["لا يبلغُ البلغاءُ غايةَ وصفِهِ","إلا إذا بلغوا السماكَ الأعزلا",114,"ل",2,0],["لا يَبلُغُ الغَيثُ غِبَّ المَحلِ غايَتَها","وَلا يَنالُ مَداها وَهوَ مُنهَمِرُ",115,"ر",1,0],["لا يَبلَغونَ إِذا أَفكارُهُم تَعِبَت","مِعشارَ قَولِكَ فينا حينَ تَرتَجِلُ",116,"ل",1,0],["لا يبرح الحسن عنه حتى","يبقى بديلاً من الخبال",117,"ل",1,0],["لا يَبتَغون لِكَسبِ الحَمدِ مِن سَببٍ","وَلا إَلَيهُم لِمَن رامَ الثَّنا سَببُ",118,"ب",1,0],["لا يبعد الله قوما كنت بينهم","من سالف الدهر سنّوا الفضل والشرفا",119,"ف",2,0],["لا يَبرَحُ الدَهرَ صَيداً قَد تَقَنَّصَهُ","مِنَ الرِجالِ عَلى أَشداقِهِ القَمَعُ",120,"ع",1,0],["لا يُبْطِرَنَّكُمُ أَنْ كان جَدُّكمُ","وَجَدُّهُ خَيْرَ من تَسْمُو به الرُّسُلُ",121,"ل",1,0],["لا يَبِت ذَلِكَ الحَبيبُ بِما بِت","تُ أُعاني في حُبِّهِ وَأُقاسي",122,"س",2,0],["لا يَبتَغي مِنكَ عَليها سِوى","رَدعِ غَريمِ السوءِ مِن أَجرِ",123,"ر",1,0],["لا يَبِت قَلبُكَ الخَلِيُّ بِما بِ","تُ أُعاني مِن لَوعَةٍ وَزَفيرِ",124,"ر",1,0],["لا يَبتَغي مِنكَ شَعيراً وَلا","جُلّاً وَلا تِبناً وَلا مِقوَدا",125,"د",2,0],["لا يَبعَدَن زَمَنُ الشَبيبَةِ وَالهَوى","مِن ذاهِبٍ بَقِيَت لَنا تَبِعاتُهُ",126,"ت",2,0],["لا يبالي بالموت من عرفَ المو","تَ ومَن لا يرى من الموتِ بدا",127,"د",2,0],["لا يُبصرُ الخطبَ جليلاً ولا","تلوى به الأهوالُ عن قصدِه",128,"د",2,0],["لا يَبعُدن كَرَمٌ في التُربِ غَيَبه","ريبُ المَنون وَلا جودٌ وان بَعَدا",129,"د",2,0],["لا يَبخِلونَ بِزادِهم عَن سائِلٍ","عَدَل الزَمانُ عَليهمُ أَو جارا",130,"ر",2,1],["لا يُبَالي كَيفَما بَاشَرَها","غَيْرُهُ من يَتَوَقّى الغِيَرا",131,"ر",2,0],["لا يَبلغ الواصفُ المُطري مناقبهُ","وَكَيفَ يَبلغُ أَقصى البحر سابحُهُ",132,"ح",2,0],["لا يبالي عاشقانِ اعتنقا","أَسريراً نزلاه أَمْ ضريحا",133,"ح",2,0],["لا يبعدُ النأيَ مَن لم يقلُ صحبتهُ","طول التعاشرِ في يسرٍ ومعسورِ",134,"ر",1,0],["لا يَبلُغَنَّ وَلَو تَضاعَفَ قَدرُهُ","الحَظُّ عَشرَ العَشرِ وَالباقي عَناءِ",135,"ا",2,0],["لا يُبالي مَن نالَ هَذي المَزايا","بِحَسودٍ مِن مَجدِهِ يَتَذَمَّرُ",136,"ر",1,0],["لا يُبصِرونَ وَفي آذانِهِم صَمَمٌ","إِذا نَعَشتَهُمُ مِن فِتنَةٍ رَكَسوا",137,"س",3,0],["لا يبلغ القاع وإيمانه","بالسطح لا يدفع عنه الخطر",138,"ر",1,0],["لا يَبقَ لِلعُشّاقِ بَع","دَ تَبَصُّري فيهِ اِغتِراري",139,"ر",2,0],["لا يُبعِدِ اللّهُ التَلبُّبَ وال","غاراتِ إِذْ قال الخَمِيسُ نَعَمْ",140,"م",1,0],["لا يُبعد اللَهُ صَبراً كان ينجدُه","ما كانَ أسرعَ ما ولَّى وما انتَصرا",141,"ر",2,0],["لا يُبالي طَيِّبُ النَفسِ بِهِ","عَطَبَ المالِ إِذا العِرضُ سَلِم",142,"م",1,0],["لا يبالي بأمة تتساقى","بكؤوس من الخضوع المَشين",143,"ن",1,0],["لا يَبْعدَنْ عَيْشَ بِرَبْعِكَ نِلتُه","والدَّهرُ من حِزْبي ومن أنْصاري",144,"ر",2,0],["لاَ يُبعدِ الرَّحمن إلاّ عصبةً","ضلّتْ وأخطأتِ السَّبيل الأنورا",145,"ر",2,0],["لا يُبْعد اللهُ غيرَ زِعْنفةٍ","مِن كلِّ رِجسٍ عن الرَّشادِ عَمِي",146,"م",2,0],["لا يبذُلَنْ ذو فاقَةٍ وجهَهُ","لِذي ثراءٍ باخلٍ باخِعِ",147,"ع",1,0],["لا يبلغ الشر منهم مثل مبلغه","في عامهم ذلك الماضي ولم يثر",148,"ر",1,0],["لا يَبعَدَن قَومي الَّذينَ هُمُ","سُمُّ العُداةِ وَآفَةُ الجُزرِ",149,"ر",1,1],["لا يُبْعِدِ الله الجمالَ مَحَبَّةً","عَذْبَ العذابِ مُهَوِّنَ الأَخطارِ",150,"ر",1,0],["لا يبغيان ولكن من قرارهما","يستخرج البر من درّ ومرجان",151,"ن",1,0],["لا يبلغ اللفظ وصفكم لفتىً","بجهد في شعره وفي خطبه",152,"ب",2,0],["لا يُبعِدُ الجُودَ من يومِ الجِلادِ ولا","يُغِبُّ يومَ نداهُ يومُ مُجتلَدِهْ",153,"د",2,0],["لا يُبْعِدِ الرحمنُ إِلّا مُهْجَةً","ضلَّتْ وَفِي يدها سِرَاجُ هُدَاكا",154,"ك",2,0],["لا يبذلن الذي أغليت من أدبي","نارا تصب على رجس الشياطين",155,"ن",1,0],["لا يبالي إن أتاه","الشكر أم لم يأت شكر",156,"ر",1,0],["لا يُبعِدُ اللَهُ حُسّادي وَزادَهُمُ","حَتّى يَموتوا بِداءٍ فِيَّ مَكنونِ",157,"ن",1,1],["لا يُبعد اللهُ الوفاءَ صاحباً","كان ولا أطمعُ أن يكونا",158,"ن",2,0],["لا يبالون والمكارمُ فيهم","باقياتٌ ما ابتزَّ خطبٌ فأفنَى",159,"ن",2,0],["لا يبالي إذا بقيتم مَن الحا","بسُ عنه النوالَ أو مَن أنالَهْ",160,"ل",2,0],["لايبتغين بحلا","واتِ الهوى التبعُّلا",161,"ل",2,0],["لايبالين افتقاراً من غنىً","وافتراقاً بين معزولٍ ووالي",162,"ل",2,0],["لا يبلغُ المِسبار قعرَ جراحها","وبه وفي كفّ المعالج طولُ",163,"ل",1,0],["لا يبالي عاقرُ البدن لها","أيّها الواجبةُ الجنبِ الشريقَهْ",164,"ق",2,0],["لا يُبعدنّ اللّه دارَ معاشرٍ","مذ جمَّعوا شملَ العلا لم يُصدَعِ",165,"ع",1,0],["لا يبالي الحيرانُ ما أَطلقوا الأي","مانَ أَن تُمسكَ السماءُ القَطرا",166,"ر",2,0],["لا يُبعِد اللّهُ الألى حفِظ العلا","بيتٌ لهم حولَ النجوم مَشِيدُ",167,"د",1,0],["لا يبالي أيَّ زندٍ أَصلدتْ","مَن أتى راحتَه مقتدِحا",168,"ح",2,0],["لا يُبعدِ اللّهُ قلباً ظلَّ عندكُمُ","لم يُغنِني عنه نِشدانٌ ولا طلبُ",169,"ب",1,0],["لا يَبلُغُ السَّبرُ ما يُفَرَّى","مُعمِّقاً جُرحُها الرغيبُ",170,"ب",1,0],["لا يبْتغي للقِرى عُذْراً ليمْنَعَه","ولا يحلُ اذا ما حَلَّ بالخَمَرِ",171,"ر",1,0],["لا يَبلُغُ الناسُ ما فيهِم إِذا ذُكِروا","مِل مَجدِ إِن أَجحَفوا في المَجدِ أَو قَصَدوا",172,"د",3,0],["لا يبتغي منه سوى أحرُف","يعتدها أَشرف ذخرٍ يفاد",173,"د",1,0],["لا يَبعَثُ العيرَ إِلّا غِبَّ صادِقَةٍ","مِنَ المَعالي وَقومٌ بِالمَفاريقِ",174,"ق",1,0],["لا يَبلُغَنّ إليه سهمُ مُعانِدٍ","لو كان في قَوسِ الكَواكِبِ ينزِعُ",175,"ع",1,0],["لا يبلغ الطرف مدى جيشه","والطرف يطوي الأرض بالإلتماح",176,"ح",1,0],["لا يبلغ البلغاء وصف مناقب","أثنى على إحسانها التنزيل",177,"ل",1,0],["لا يبرح المقصوص موضعه","ولقد قصصت فطرت عن وكري",178,"ر",2,0],["لا يَبتَغي ذِمّةً مِن غَيرِ نَجدتهِ","إنّ الشّجاعَةَ فيها أَوثقُ الذممِ",179,"م",1,0],["لا يبعد اللَّه اِنصِلاتك للعِدا","عَجِلاً تُدَهْدِه جَحْفَلاً في جحفلِ",180,"ل",1,0],["لا يبعدِ اللَّهُ أقواماً مضوا سَلَفاً","كانوا على نَبَواتِ الدّهرِ أنصاري",181,"ر",2,0],["لا يَبرَحُ الزُوّارُ مِن بابِها","كَأَنَّما ضَمَّهُمُ عُرسُ",182,"س",1,0],["لا يَبعَدَن مالٌ رَبَيتَ بِهِ العُلى","فَحَصِدتَ فيهِ وَقُل لِعاذِلِكَ اِبعَدِ",183,"د",1,0],["لا يَبلُغُ الدُنيا كَثيرَ عَطائِهِ","وَقَليلُهُ عِندَ الكَثيرِ كَثيرُ",184,"ر",1,0],["لا يبلغُ الشَّيخُ منَّا في مدراسِهِ","ما كانَ يبلغُ راعي المَعْزِ والضَّانِ",185,"ن",1,0],["لا يَبرَحُ المَرْءُ حيثُ اللهُ يَجعَلُهُ","ومَنْ رأى النَّجْمَ تحتَ الماءِ قد رَسَبا",186,"ب",2,0],["لا يُبالي بأُرجُوانٍ وخَزٍّ","من كَسَاهُ عقلٌ وعِرضٌ ودِينُ",187,"ن",1,0],["لاَ يَبْلُغُ الدَّهْرُ أَنْ يُشْكَى مُحَاوِرُهُ","وَلاَ يَهِي غَيْرُ حَبْلٍ لَمْ يَصِلْ حَبْلَهْ",188,"ل",2,0],["لا يُبرِئُ القَطِرانُ البَحتَ نُقبَتَهُ","وَما تُبينُ بِضاحي جِلدِهِ جَرَبا",189,"ب",2,0],["لا يُبعِدُ اللَهُ رَبُّ العِبادِ","وَالمِلحِ ما وَلَدت خالِدَه",190,"د",2,1],["لا يبرح الناس ما حجوا معرسهم","حتى يقال: أجيزوا آل صفوانا",191,"ن",2,0],["لا يبعدنّك اللَّه يا عمري","أَما مضيتَ فَنحنُ بالإثرِ",192,"ر",1,0],["لا يبعدن ربّ الفناء نعوده","عود السقيم يجود بين العوّد",193,"د",1,0],["لا يبعدن عصر الشباب ولا","لذاته ونباته النضر",194,"ر",1,1],["لا يُبعِدُ اللَهُ فِتياناً أَقولُ لَهُم","بِالأَبرَقِ الفَردِ لَما فاتَهُم نَظَري",195,"ر",2,0],["لا يبرحوا الدهر الجديد أذلة","شنج الأعنة يوم كل رهان",196,"ن",1,0],["لا يبالي طيبُ النفسِ بهِ","تَلَفَ المالِ إذ العِرضُ سَلِمْ",197,"م",1,0]]}