{"poems":[[53,"أيا ابن رجاء وابنه الخير لا يزل","https://www.aldiwan.net/poem66382.html","الطويل"],[234,"لا تقتل الأحزان إلا بما","https://www.aldiwan.net/poem50755.html","السريع"],[369,"تصرف أحوالي على حكم أيامي","https://www.aldiwan.net/poem60644.html","الطويل"],[567,"أرى فتنة الدنيا هي الآية الكبرى","https://www.aldiwan.net/poem52811.html","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145823","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65011","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46873","المتقارب"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59451","الطويل"],[5881,"فلتخلع الثوب","https://www.poetsgate.com/ViewPoem.aspx?id=183818",""],[5950,"سوق المترفين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128335",""],[5956,"التفرد","https://www.poetsgate.com/ViewPoem.aspx?id=185591",""],[6069,"وكم ليلةٍ عاطاني الراح بدرها","https://www.poetsgate.com/ViewPoem.aspx?id=105687",""]],"verses":[["أُدِقَّتْ معانيهِ وفُخِّمَ لفظُه","فغادر أشتاتَ القلوبِ قرائنا",0,"ن",2,0],["أدقّ محسوساً إذا صُرِّفتْ","مِن دِقّةِ الفهمِ ولطفِ البيان",1,"ن",1,0],["أدَقُّ همومي يَملأُ القلبَ كُلَّه","وأقصَرُ أيّامي من العامِ كالعام",2,"م",1,0],["أدَقُّ الوَرَى فِكراً وأكرمُهُم يداً","وأفصَحُهم نظماً وأبلغُهم نَثرا",3,"ر",2,0],["أدقُ مساميرَ الدموعِ على يدي","فإني مسيحٌ في المتاهاتِ يصلبُ",4,"ب",1,0],["أَدَقُّ أَمْرٍ أَمْرُه وَأَلأَمُهْ","صَفِيرُ مِقْياس الأَدِيمِ حَلِمُهْ",5,"م",2,0],["أَدَقُّ مَعانيها جَليلُ مَآثرٍ","إِذا عارضتْهُ ظُلْمَةُ الشَّكِ جلاَّها",6,"ا",3,0],["أدق من فكر اللبيب بزره","أرق من قلب الغريب قشره",7,"ه",1,0],["أدَقُّ أخيذَاتِهِ دَارُ مُلكٍ","وَأدنَى عَطِيّتهِ بَيْتُ مَالِ",8,"ل",1,0],["أدْقَّ إِلهي خَلقَها وأجَلّهُ","فدقَّت كما شاء الإِلهُ وجلَّتِ",9,"ت",1,0],["أدق باباً فيأتي الصوت مرتجفاً","فلتخلع الثوب وادخل إنه الوثن",10,"ن",1,0],["أدق النجر في ظلما السنين ومابقى للكيف","سوى النزر القليل وتغرق الدنيا بالإستفهام",11,"م",1,0],["أدقُّ البابَ لا أُصغي جوابا","أ حقاً غاب ، أم ذا الوعيُ غابا ؟",12,"ب",2,1],["أدق من المعنى الغريب وفوقه","أرق من الماء المعين وألطف",13,"ف",1,0]]}