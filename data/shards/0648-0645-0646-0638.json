{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[53,"مديحك من تعفوه تحسب رفده","https://www.aldiwan.net/poem9416.html","الطويل"],[53,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[53,"طلبت لديكم بالعتاب زيادة","https://www.aldiwan.net/poem65730.html","الطويل"],[87,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[87,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[68,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[68,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[82,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/14202","الطويل"],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[92,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[119,"اقامك الحسن سكراناً بخمرته","https://www.aldiwan.net/poem40623.html","عموديه"],[119,"جفاءٌ جرى جهرا لدى الناس وانبسط","https://www.aldiwan.net/poem40914.html","عموديه"],[146,"لقاؤك يا لبنى خيال","https://www.aldiwan.net/poem58405.html","الطويل"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[396,"جاء الفرج زال الحرج","https://www.aldiwan.net/poem54489.html","عموديه"],[412,"وكم من أخ لو حرم الماء لم أكن","https://www.aldiwan.net/poem50200.html","الطويل"],[422,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[438,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[447,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[500,"أنعت ليلا ذا سواد كالسبج","https://www.aldiwan.net/poem9804.html","مشطور الرجز"],[509,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[543,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[556,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[569,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86613","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137639",""],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/123975","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37987","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77673","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59722","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59610","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96683","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96625","الطويل"],[1092,"","https://poetry.dctabudhabi.ae/diwan/poem/131385","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121069","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64771","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125368","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114707","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100461","المتقارب"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141735","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27267","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47117","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77358","المتقارب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120992","السريع"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18071","الطويل"],[2442,"","https://poetry.dctabudhabi.ae/diwan/poem/198632","الطويل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128116","الوافر"],[2672,"","https://poetry.dctabudhabi.ae/diwan/poem/104417","الطويل"],[2943,"","https://poetry.dctabudhabi.ae/diwan/poem/111342","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87567","الكامل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105762","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117970","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114232","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105261","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73638","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58063","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35129","الطويل"],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[4929,"مكانك في ساحة المعركة","https://www.poetsgate.com/ViewPoem.aspx?id=202426",""],[4929,"رنين الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=210844",""],[5064,"عُمرِي رداء","https://www.poetsgate.com/ViewPoem.aspx?id=199103",""],[3749,"وليلة الربوة الشماء معلمة","https://www.poetsgate.com/ViewPoem.aspx?id=134972",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5461,"أنا والصحاري","https://www.poetsgate.com/ViewPoem.aspx?id=8534",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5582,"أَأَسْطُرُ إِعْجامٍ تَراءَتْ وَأَحْرُفُ","https://www.poetsgate.com/ViewPoem.aspx?id=63536",""],[5688,"وهكذا تآخينا","https://www.poetsgate.com/ViewPoem.aspx?id=200931",""],[5784,"ألا يا زمان التيه","https://www.poetsgate.com/ViewPoem.aspx?id=196957",""],[6078,"بل أَكثر","https://www.poetsgate.com/ViewPoem.aspx?id=203412",""],[6259,"وكم من أخٍ لو حرّم الماءَ لم أكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59409&r=&rc=57",""]],"verses":[["وَمَنظَرٍ كانَ بِالسَرّاءِ يُضحِكُني","ياقُربَ ما عادَ بِالضَرّاءِ يُبكيني",0,"ن",2,0],["وَمَن ظَنَّ مِمَّن يُلاقي الحُروبَ","بِأَن لا يُصابَ فَقَد ظَنَّ عَجزا",1,"ز",2,0],["وَمِن ظَهرِ قُفٍّ لَم تَطَأهُ رِكابُهُ","عَلى سَفَرٍ في صَرَّةِ القَيظِ يُنعِلِ",2,"ل",1,0],["ومَنْ ظنَّ بالممدوح ذاك فإنه","بِنيَّته هاجٍ له غيرُ مادحِ",3,"ح",1,0],["ومن ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",4,"د",1,1],["ومن ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشق",5,"ق",1,0],["وَمِن ظِباءٍ في كِناساتِها","تَهيجُ لِلعاشِقِ لَوعاتِهِ",6,"ت",2,0],["وَمَنظَرِ كُلِّ خَوّانٍ يَراني","بِوَجهٍ كَالبَغِيِّ رَمى النِقابا",7,"ب",2,0],["وَمَنظَرَةٍ بِها شُبّاكُ جامِ","رَقيقِ الجِرمِ مُعتَدِلِ الصَفاءِ",8,"ا",2,0],["وَمَنظَرُ حُسنٍ في سَنا البَدرِ رَسمُهُ","إِلى القَلبِ أَحلى وَهوَ في العَينِ أَملَحُ",9,"ح",1,0],["ومَنْ ظَنّ أمْواه الخضارم عَذْبَةً","قضى بخلاف الظنّ عندَ المشارِبِ",10,"ب",1,0],["وَمَن ظَعَنَت رَوحي وَقَد سارَ ظَعنُهُم","فَلَم أَدرِ أَيُّ الظاعِنينَ أُشَيّعُ",11,"ع",1,0],["ومن ظن بالأيام ما ليس خلقها","اضاف لها مالم يكن من حسابها",12,"ب",3,0],["ومن ظن المجالسَ عامراتٍ","بمدح أنها شُحِنَتْ سِبابا",13,"ب",2,0],["ومنظر يسلب الالباب طالعه","على صنوف معاني الحسن مشتمل",14,"ل",1,0],["ومن ظن ان يمحو جلي جفائه","ومنهاجه المقضبي الى اقج الخطط",15,"ط",1,0],["ومن ظنّ أن العذلَ يقتنص الجوى","فقد قاده صعبا بغير عِقالِ",16,"ل",1,0],["وَمَن ظافَرَ الساعي عَلى ما يَقولُهُ","فَمِن قَولِهِ اِستَملى وَعَن قَوسِهِ رَما",17,"م",2,0],["ومن ظلم قد ظلم نفسه وعاده قسيم","في كل ظلم يقع في الناس مثل الرجيم",18,"م",1,0],["وَمَن ظَنَّ ألّا بُدَّ مِنهُ أَرَيتَهُ","بِصَبري عَنهُ ذَلِكَ الظَنُّ كاذِبا",19,"ب",2,0],["ومن ظنَّ أنَّ العزَّ في غير بأسكم","وهي عِزُّه في زعمه وتندّما",20,"م",2,0],["ومنظرٌ عزّ نظيرٌ له","والناسُ أشكال وأنظارُ",21,"ر",1,0],["ومن ظلم فإن النفس أصل","ولذتها تكون بمنتشاها",22,"ا",3,0],["ومَن ظلّ تستأسِي الملوكُ برأيه","ويحسِم داءَ الملك وهو عُضُالُ",23,"ل",1,0],["ومن ظبيٍ مددتُ له حبالي","لأقنِصَه فعدنَ على خُناقي",24,"ق",2,0],["ومنظراً من يره منك ابتهج","ونائلاً لو كاثر البحر فلج",25,"ج",1,0],["ومن ظن أن الروح يشبه جسمه","تبين في الرأي الصواب له الخطا",26,"ا",1,0],["ومَنظَرٌ خَلَعَ الحُسنَ عليه حُلًى","يَدُ الطَّبيعةِ وَشَّتها بِإتقانِ",27,"ن",1,0],["ومِنْ ظبيٍ غنيٍّ في","ك بالحسنِ عن القُلْبِ",28,"ب",1,0],["ومن ظن بالتفريط أن يحفظ العلى","فقد ضاع منه الحزم وتاه الفكر",29,"ر",1,0],["وَمَنظره الشَنيع عَلَيهِ يمسى","مَدى الأَيام يَنهلُّ المصاب",30,"ب",1,0],["ومنظار كل فتى كبر الص","صغير وصغر ضخم الذرى",31,"ر",2,0],["ومن ظهرت في كل أرض على الورى","فضائله في نجدها والتهايم",32,"م",1,0],["وَمَن ظنَّ في الدُّنيا دَوامَ حَياتِهِ","فَذلِكَ مَغرورٌ يُعامَلُ بِالعكسِ",33,"س",1,0],["وَمَنظَري يَسرُّه بِالخُضرة","فَيتلالا وَجهُهُ بِالنضرَه",34,"ه",1,0],["ومِنْ ظلٍّ وأمن مِنْ","أذى ضُر وإضرارِ",35,"ر",1,0],["ومن ظِلّ خفاق الظلال مهدل","هجيراً يظلُّ السرب فيه مَروعا",36,"ع",2,0],["ومن ظبية البان اللواحظ يُنتضى","على كبدي منها الحسام المشهر",37,"ر",1,0],["وَمِن ظبيةٍ للأنسِ تأنسُ والملا","وَتَرعى رياضَ القلبِ منّي وتعطفُ",38,"ف",1,0],["وَمِن ظبيةٍ لَم ترع روضاً وإنّما","لَها في رياضِ القلبِ ملهىً ومسرحُ",39,"ح",1,0],["ومن ظن أني قد تقلدت سبة","وكان بها جذلان في باطن السر",40,"ر",1,0],["ومن ظَن سلواني من البر والتقى","فاني إلى الرحمن من ظنه أبرا",41,"ر",2,0],["ومَنْ ظَنَّ سُلْواني مِنَ الْبِرِّ والتُّقى","فَإِنّي ِإلى الرَّحْمنِ مِنْ ذَمِّهِ أَبْرا",42,"ر",2,0],["ومنظِّمٍ روضَ العُلومِ وباحثٍ","عن كُنهِ لفظٍ حَيَّرَ الأذهانا",43,"ن",2,0],["ومنظورِ أَوباتِ السِّفار كأنَّما","هلالٌ على فِطرٍ أهَلَّ به السَّعدُ",44,"د",1,0],["ومن ظن في الدهر أن يرعوي","فذاك لعمري داء عضال",45,"ل",1,0],["ومن ظل منهم والغمام تظله","وفاء إليه الفيء يعمده عمدا",46,"د",2,0],["ومن ظاهرٍ وسط المكانِ مبرِّز","له حكمة تسمو على كلِّ مستمى",47,"ا",1,0],["ومن ظِلالي إلى نعيمي","ومن نعيمي إلى مِحالي",48,"ل",2,0],["ومَنْ ظنّ الخُسوفَ بَدَا لِشرٍّ","فَخَيْرُ الخلق قد ردَّ اعتقادَه",49,"د",2,0],["وَمَن ظَنَّ غَيرَ العَفافِ الهَوى","فَذَلِكَ ثَوبَ الغَرامِ اِستَعارا",50,"ر",2,0],["ومنظر الحسن وقد ناظرت","بيض الوجوه فيه سود المُقَل",51,"ل",1,0],["وَمِن ظُعُنٍ كَالدَومِ أَشرَفَ فَوقَها","ظِباءُ السُلَيِّ واكِناتٍ عَلى الخَملِ",52,"ل",1,1],["ومنظوم عقيان من اللفظ لم يكن","جماناً، ولم تظفر به يد جالب",53,"ب",1,0],["ومنظر بهجة فيه تثنت","غصونُ البان من نغم المثاني",54,"ن",2,0],["ومنظومة ما مثلها من قصيدة","تناظرها فهي الفريدة في العقد",55,"د",1,1],["ومنظماً صيد الورى","إن هز أسمر لهذما",56,"م",2,0],["وَمنظمُ الأَكوان في اسلاكها","مثلَ العُقود تُرى لعين الرآئي",57,"ا",2,0],["ومن ظهر سكرانٍ إلى بطن قينةٍ","على شُبَهٍ في مِلكِها وشوائبِ",58,"ب",1,0],["ومن ظنّ أن لا سمّ في ناب حيّة","فذلك مصفوع القفا سفلة السفل",59,"ل",1,0],["وَمَنظُومُهضا البَاهِي كَمَنظُومِكَ الَّذِي","تَقَدَّسَ عَن المُرَصَّعِ مِن دُرِّ",60,"ر",1,0],["ومن ظن ان الدهر يصبح غالباً","أحال وان الدهر لا شك غالبه",61,"ب",2,0],["ومن ظلمات الليل بحر يخيفني","فلا الجزر ينجيني ولا يعير المد",62,"د",1,0],["وَمَنظَرٍ رائِقٍ أَنيقٍ","أَهدَى إِلى قَلبِيَ اِشتِياقا",63,"ق",2,1],["وَمَنْظَرٍ حَسَنٍ ذِي مَخْبَرٍ شَنِعٍ","فَساوِ حَالَيْكَ مِن يَأْسٍ وَمِن طَمَع",64,"ع",1,0],["ومن ظلَّ بين الوالدين مقرطقا","صبياً تراه كالهلال مسوَّرا",65,"ر",2,0],["وَمَنظومَةٍ سَبعاً وَعِشرينَ دُرَّةً","تُدارُ عَلى الدُنيا كُؤوسُ رَحيقِها",66,"ق",3,1],["ومن ظهرت أياته وتواترت","وسنَّته الغراء خير محجَّة",67,"ه",1,0],["ومن ظهرهُ في غمار الوغى","لغير صياصيه ما أهتكهْ",68,"ك",2,0],["ومن ظنَّ النجاحَ وحيدَ دربٍ","فقد جهل المداخل والشِّعَابا",69,"ب",2,0],["ومِنْ ظُلْمِ الهوَى تقرِيعُ قَلبٍ","وقَدْ أحسَنتُ فِيهِ لِمَنْ أسَاءَ",70,"ا",2,0],["ومنظراً يستبي الألباب رائعه","ويشتغل النفس عن أشهى أمانيها",71,"ي",3,0],["ومنظري وجهها إذ ذاك أحسبهُ","لي مغنماً عزَّ عند الموت لو طلبا",72,"ب",2,0],["ومن ظن أن الهجر هجر وباطل","فذلك ظن السوء من كل من جهل",73,"ل",1,0],["ومن ظن ظن السوء لم ير منكراً","ولا الأمر بالمعروف أفضل منتحل",73,"ل",1,0],["ومن ظاهر الكفار من كل مارقٍ","على المسلمين المهتدين ذوي المجد",74,"د",1,0],["ومن ظنّ انكماشيَ بعد فيضٍ","فإني من بهاء الله أُسقى",75,"ق",2,0],["ومنظر غدير ترتعش فيه شمس عصير","وطعس حمر عقب المطر ما مشاه انسان",76,"ن",1,0],["وَمِنْ ظَبْيَةٍ لَمْ تَرْعَ رَوْضاً وَإِنَّما","لَها فِي رِياضِ القَلْبِ مَرْعَى وَمَسْرَحُ",77,"ح",1,0],["وَمِنْ ظَبْيَةٍ لِلإِنْسِ تأْنَسُ وَالمَلا","وَتَرْعَى رِياضَ القَلْبِ مِنَّا وَتَقْطِفُ",78,"ف",1,0],["ومن ظنّ أنّ القول يجدي بعسرة","أوَ انّ فعال العبد خير العوامل",79,"ل",1,0],["ومن ظن أن المجد مجد مراتب","فسوف تخون المجد تلك المراتب",80,"ب",1,0],["ومنْ ظلٍّ يُرافِقهُ هوينى","وَأُذنٍ أُطْرِبَتْ لمّا يُغنِّي",81,"ن",2,0],["ومن ظنّ أن لا بدّ منهُ أريتهُ","بصبريَ عنه ذلك الظنَّ كاذبا",82,"ب",2,0]]}