{"poems":[[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[51,"مديحك من تعفوه تحسب رفده","https://www.aldiwan.net/poem9416.html","الطويل"],[51,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[51,"طلبت لديكم بالعتاب زيادة","https://www.aldiwan.net/poem65730.html","الطويل"],[85,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[66,"","https://poetry.dctabudhabi.ae/diwan/poem/14202","الطويل"],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""]],"verses":[["وَمَنظَرٍ كانَ بِالسَرّاءِ يُضحِكُني","ياقُربَ ما عادَ بِالضَرّاءِ يُبكيني",0,"ي",1,0],["وَمَن ظَنَّ مِمَّن يُلاقي الحُروبَ","بِأَن لا يُصابَ فَقَد ظَنَّ عَجزا",1,"ز",2,0],["وَمِن ظَهرِ قُفٍّ لَم تَطَأهُ رِكابُهُ","عَلى سَفَرٍ في صَرَّةِ القَيظِ يُنعِلِ",2,"ل",1,0],["ومَنْ ظنَّ بالممدوح ذاك فإنه","بِنيَّته هاجٍ له غيرُ مادحِ",3,"ح",1,0],["ومن ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",4,"د",1,1],["ومن ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشق",5,"ق",1,0],["وَمِن ظِباءٍ في كِناساتِها","تَهيجُ لِلعاشِقِ لَوعاتِهِ",6,"ت",2,0],["وَمَنظَرِ كُلِّ خَوّانٍ يَراني","بِوَجهٍ كَالبَغِيِّ رَمى النِقابا",7,"ب",2,0],["وَمَنظَرَةٍ بِها شُبّاكُ جامِ","رَقيقِ الجِرمِ مُعتَدِلِ الصَفاءِ",8,"ا",2,0],["وَمَنظَرُ حُسنٍ في سَنا البَدرِ رَسمُهُ","إِلى القَلبِ أَحلى وَهوَ في العَينِ أَملَحُ",9,"ح",1,0],["ومَنْ ظَنّ أمْواه الخضارم عَذْبَةً","قضى بخلاف الظنّ عندَ المشارِبِ",10,"ب",1,0],["وَمَن ظَعَنَت رَوحي وَقَد سارَ ظَعنُهُم","فَلَم أَدرِ أَيُّ الظاعِنينَ أُشَيّعُ",11,"ع",1,0],["ومن ظن المجالسَ عامراتٍ","بمدح أنها شُحِنَتْ سِبابا",12,"ب",2,0]]}