{"poems":[[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[51,"مديحك من تعفوه تحسب رفده","https://www.aldiwan.net/poem9416.html","الطويل"],[51,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[51,"طلبت لديكم بالعتاب زيادة","https://www.aldiwan.net/poem65730.html","الطويل"],[85,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[66,"","https://poetry.dctabudhabi.ae/diwan/poem/14202","الطويل"],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[113,"اقامك الحسن سكراناً بخمرته","https://www.aldiwan.net/poem40623.html","عموديه"],[113,"جفاءٌ جرى جهرا لدى الناس وانبسط","https://www.aldiwan.net/poem40914.html","عموديه"],[140,"لقاؤك يا لبنى خيال","https://www.aldiwan.net/poem58405.html","الطويل"],[141,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[388,"جاء الفرج زال الحرج","https://www.aldiwan.net/poem54489.html","عموديه"],[403,"وكم من أخ لو حرم الماء لم أكن","https://www.aldiwan.net/poem50200.html","الطويل"],[413,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[429,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[438,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[456,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[493,"أنعت ليلا ذا سواد كالسبج","https://www.aldiwan.net/poem9804.html","مشطور الرجز"],[502,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[536,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[549,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[562,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""]],"verses":[["وَمَنظَرٍ كانَ بِالسَرّاءِ يُضحِكُني","ياقُربَ ما عادَ بِالضَرّاءِ يُبكيني",0,"ي",1,0],["وَمَن ظَنَّ مِمَّن يُلاقي الحُروبَ","بِأَن لا يُصابَ فَقَد ظَنَّ عَجزا",1,"ز",2,0],["وَمِن ظَهرِ قُفٍّ لَم تَطَأهُ رِكابُهُ","عَلى سَفَرٍ في صَرَّةِ القَيظِ يُنعِلِ",2,"ل",1,0],["ومَنْ ظنَّ بالممدوح ذاك فإنه","بِنيَّته هاجٍ له غيرُ مادحِ",3,"ح",1,0],["ومن ظن أن الاستزادة في الهوى","تُؤدِّي إلى طول العداوة والحقدِ",4,"د",1,1],["ومن ظن أن الاستزادة في الهوى","تؤول بمعشوق إلى هجر عاشق",5,"ق",1,0],["وَمِن ظِباءٍ في كِناساتِها","تَهيجُ لِلعاشِقِ لَوعاتِهِ",6,"ت",2,0],["وَمَنظَرِ كُلِّ خَوّانٍ يَراني","بِوَجهٍ كَالبَغِيِّ رَمى النِقابا",7,"ب",2,0],["وَمَنظَرَةٍ بِها شُبّاكُ جامِ","رَقيقِ الجِرمِ مُعتَدِلِ الصَفاءِ",8,"ا",2,0],["وَمَنظَرُ حُسنٍ في سَنا البَدرِ رَسمُهُ","إِلى القَلبِ أَحلى وَهوَ في العَينِ أَملَحُ",9,"ح",1,0],["ومَنْ ظَنّ أمْواه الخضارم عَذْبَةً","قضى بخلاف الظنّ عندَ المشارِبِ",10,"ب",1,0],["وَمَن ظَعَنَت رَوحي وَقَد سارَ ظَعنُهُم","فَلَم أَدرِ أَيُّ الظاعِنينَ أُشَيّعُ",11,"ع",1,0],["ومن ظن المجالسَ عامراتٍ","بمدح أنها شُحِنَتْ سِبابا",12,"ب",2,0],["ومنظر يسلب الالباب طالعه","على صنوف معاني الحسن مشتمل",13,"ل",1,0],["ومن ظن ان يمحو جلي جفائه","ومنهاجه المقضبي الى اقج الخطط",14,"ط",1,0],["ومن ظنّ أن العذلَ يقتنص الجوى","فقد قاده صعبا بغير عِقالِ",15,"ل",1,0],["وَمَن ظافَرَ الساعي عَلى ما يَقولُهُ","فَمِن قَولِهِ اِستَملى وَعَن قَوسِهِ رَما",16,"م",2,0],["ومن ظلم قد ظلم نفسه وعاده قسيم","في كل ظلم يقع في الناس مثل الرجيم",17,"م",1,0],["وَمَن ظَنَّ ألّا بُدَّ مِنهُ أَرَيتَهُ","بِصَبري عَنهُ ذَلِكَ الظَنُّ كاذِبا",18,"ب",2,0],["ومن ظنَّ أنَّ العزَّ في غير بأسكم","وهي عِزُّه في زعمه وتندّما",19,"م",2,0],["ومنظرٌ عزّ نظيرٌ له","والناسُ أشكال وأنظارُ",20,"ر",1,0],["ومن ظلم فإن النفس أصل","ولذتها تكون بمنتشاها",21,"ا",3,0],["ومَن ظلّ تستأسِي الملوكُ برأيه","ويحسِم داءَ الملك وهو عُضُالُ",22,"ل",1,0],["ومن ظبيٍ مددتُ له حبالي","لأقنِصَه فعدنَ على خُناقي",23,"ي",1,0],["ومنظراً من يره منك ابتهج","ونائلاً لو كاثر البحر فلج",24,"ج",1,0],["ومن ظن أن الروح يشبه جسمه","تبين في الرأي الصواب له الخطا",25,"ا",1,0],["ومَنظَرٌ خَلَعَ الحُسنَ عليه حُلًى","يَدُ الطَّبيعةِ وَشَّتها بِإتقانِ",26,"ن",1,0],["ومِنْ ظبيٍ غنيٍّ في","ك بالحسنِ عن القُلْبِ",27,"ب",1,0],["ومن ظن بالتفريط أن يحفظ العلى","فقد ضاع منه الحزم وتاه الفكر",28,"ر",1,0]]}