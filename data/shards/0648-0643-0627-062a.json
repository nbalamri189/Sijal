{"poems":[[72,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[72,"وكاتبة في خدها بدموعها","https://www.aldiwan.net/poem18871.html","الطويل"],[72,"قاضي القضاة بيمنى حكمه القلم","https://www.aldiwan.net/poem19672.html","البسيط"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[43,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[43,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[61,"فقدت أبا عمران عرسا شفيفة","https://www.aldiwan.net/poem51596.html","الطويل"],[50,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[141,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[158,"قدمت قدوما كان أشهى إلى الناس","https://www.aldiwan.net/poem58935.html","الطويل"],[158,"إلى أى باب غير بابك أقرع","https://www.aldiwan.net/poem59097.html","الطويل"],[184,"ما أحسن البر بلا شيلم","https://www.aldiwan.net/poem43266.html","السريع"],[233,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[254,"وكاتب بارع بلاغته","https://www.aldiwan.net/poem48539.html","المنسرح"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[355,"وكاتب ألفاظه وكتبه","https://www.aldiwan.net/poem4149.html","الرجز"],[390,"وكاتب جاءنا بأعمى","https://www.aldiwan.net/poem53560.html","مخلع البسيط"],[438,"يا راقد الليل إن الليل قد صدرا","https://www.aldiwan.net/poem14367.html","البسيط"],[456,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[466,"وكاتب ما عنده أنه","https://www.aldiwan.net/poem59902.html","السريع"],[565,"جنبك الله عارض العلل","https://www.aldiwan.net/poem69535.html","المنسرح"]],"verses":[["وكاتب سرٍّ للملوكِ محجب","وما للندى عن زائِريهِ حجاب",0,"ب",1,0],["وكاتبة في خدها بدموعها","لبعديَ من شرح الأسى أسطراً حمرا",1,"ر",2,1],["وكاتم الصدقات الغرّ تكرمةً","للمرء لو كانَ عرف المسك يكتتم",2,"م",1,0],["وَكاتِبٍ تُشرِقُ أَلفاظُهُ","كَالدُرَرِ المُختارَةِ المُنتَقاة",3,"ه",1,0],["وَكاتِمُ الحُبِّ يَومَ البَينِ مُنهَتِكٌ","وَصاحِبُ الدَمعِ لا تَخفى سَرائِرُهُ",4,"ر",2,0],["وَكاتَبَ مِن أَرضٍ بَعيدٍ مَرامُها","قَريبٍ عَلى خَيلٍ حَوالَيكَ سُبَّقِ",5,"ق",1,0],["وكاتبةً أقلامُها حين تُنْتَضى","حديدٌ وأعناقُ النِّساءِ طُروسُها",6,"س",3,0],["وَكاتَمَتا أُخرى هَوايَ وَغَرَّتا","أَميرَهُما مِنّي بِنُسكٍ وَمَسجِدِ",7,"د",1,0],["وَكاتَبَتكَ مُلوكُ الأَرضِ راغِبَةً","فيما لَدَيكَ وَأَقصى سُؤلِها السَلَمُ",8,"م",1,0],["وكات رجالً أن تطير قلوبها","فدع كل بيضاء الترائب منعاس",9,"س",1,0],["وكاتبته كرها فكان جوابه","من الشهد أحلى أو من السم انقع",10,"ع",1,0],["وكاتباه ماقتان له","إن نام قالا نم فلا تسلم",11,"م",1,0],["وَكاتِبٌ ما فَتِئَت كُتبُهُ","طَلائِعاً لِلفَتحِ وَالنَصرِ",12,"ر",1,0],["وكاتبٍ بارعٍ بلاغتُهُ","تجلو علينا كلام سحبان",13,"ن",1,1],["وكاتِبُها الخالقُ السرمديّ","وتلك المقاديرُ أقلامُها",14,"ه",2,0],["وَكَاتِبٍ ألفاظُهُ وَكُتبُهُ","بَغِيضَةٌ إن خَطَّ أو تَكَلَّمَا",15,"م",2,1],["وَكاتِبٍ جاءَنا بِأَعمى","لَم يَحوِ عِلماً وَلا نَفاذا",16,"ذ",2,1],["وكاتنز ذهباً ذخراً لشدته","أمسى ببطن الثرى لم يدر ما ذخرا",17,"ر",2,0],["وكاتمٍ يُغري بأسراره","في هُدُب الأجفانِ دمعٌ نمومْ",18,"م",1,0],["وَكاتِبٍ ما عِندَهُ أَنَّهُ","يَنفَعُهُ الشُكرُ عَلى النَقعِ",19,"ع",1,1],["وَكَاتِبَاً تَشْهَدُ البَلاَغَةُ","بِالْفَضْلِ لَهُ فِي التَّفْصِيْلِ وَالجُمَلِ",20,"ل",1,0]]}