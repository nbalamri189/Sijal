{"poems":[[74,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[74,"وكاتبة في خدها بدموعها","https://www.aldiwan.net/poem18871.html","الطويل"],[74,"قاضي القضاة بيمنى حكمه القلم","https://www.aldiwan.net/poem19672.html","البسيط"],[93,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[45,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[63,"فقدت أبا عمران عرسا شفيفة","https://www.aldiwan.net/poem51596.html","الطويل"],[52,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[164,"قدمت قدوما كان أشهى إلى الناس","https://www.aldiwan.net/poem58935.html","الطويل"],[164,"إلى أى باب غير بابك أقرع","https://www.aldiwan.net/poem59097.html","الطويل"],[190,"ما أحسن البر بلا شيلم","https://www.aldiwan.net/poem43266.html","السريع"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[261,"وكاتب بارع بلاغته","https://www.aldiwan.net/poem48539.html","المنسرح"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[362,"وكاتب ألفاظه وكتبه","https://www.aldiwan.net/poem4149.html","الرجز"],[398,"وكاتب جاءنا بأعمى","https://www.aldiwan.net/poem53560.html","مخلع البسيط"],[447,"يا راقد الليل إن الليل قد صدرا","https://www.aldiwan.net/poem14367.html","البسيط"],[463,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[473,"وكاتب ما عنده أنه","https://www.aldiwan.net/poem59902.html","السريع"],[572,"جنبك الله عارض العلل","https://www.aldiwan.net/poem69535.html","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86717","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79584","المنسرح"],[1410,"","https://poetry.dctabudhabi.ae/diwan/poem/98150","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128699","البسيط"],[1735,"","https://poetry.dctabudhabi.ae/diwan/poem/203078","السريع"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101809","المتقارب"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45723","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76045","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75913","الطويل"],[2903,"","https://poetry.dctabudhabi.ae/diwan/poem/204541","الطويل"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31666","المنسرح"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61275","السريع"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122226","البسيط"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142998","السريع"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144063","المتقارب"],[5183,"المصاب المؤلم","https://www.poetsgate.com/ViewPoem.aspx?id=180255",""],[308,"أروضة تَبَسم عَن زهر","https://www.poetsgate.com/ViewPoem.aspx?id=189193",""],[5325,"أتاني نعي فاستطار فؤاديا","https://www.poetsgate.com/ViewPoem.aspx?id=171982",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5503,"أجزت لَهُم مَا يسْأَلُون بِشَرْطِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194722",""],[5717,"يا صانعا شيئا بديعا محكما","https://www.poetsgate.com/ViewPoem.aspx?id=170601",""],[572,"جَنّبكَ الهُ عارضَ العِلَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9438&r=&rc=295",""]],"verses":[["وكاتب سرٍّ للملوكِ محجب","وما للندى عن زائِريهِ حجاب",0,"ب",1,0],["وكاتبة في خدها بدموعها","لبعديَ من شرح الأسى أسطراً حمرا",1,"ر",2,1],["وكاتم الصدقات الغرّ تكرمةً","للمرء لو كانَ عرف المسك يكتتم",2,"م",1,0],["وَكاتِبٍ تُشرِقُ أَلفاظُهُ","كَالدُرَرِ المُختارَةِ المُنتَقاة",3,"ه",1,0],["وَكاتِمُ الحُبِّ يَومَ البَينِ مُنهَتِكٌ","وَصاحِبُ الدَمعِ لا تَخفى سَرائِرُهُ",4,"ر",2,0],["وَكاتَبَ مِن أَرضٍ بَعيدٍ مَرامُها","قَريبٍ عَلى خَيلٍ حَوالَيكَ سُبَّقِ",5,"ق",1,0],["وكاتبةً أقلامُها حين تُنْتَضى","حديدٌ وأعناقُ النِّساءِ طُروسُها",6,"س",3,0],["وَكاتَمَتا أُخرى هَوايَ وَغَرَّتا","أَميرَهُما مِنّي بِنُسكٍ وَمَسجِدِ",7,"د",1,0],["وَكاتَبَتكَ مُلوكُ الأَرضِ راغِبَةً","فيما لَدَيكَ وَأَقصى سُؤلِها السَلَمُ",8,"م",1,0],["وكات رجالً أن تطير قلوبها","فدع كل بيضاء الترائب منعاس",9,"س",1,0],["وكاتبته كرها فكان جوابه","من الشهد أحلى أو من السم انقع",10,"ع",1,0],["وكاتباه ماقتان له","إن نام قالا نم فلا تسلم",11,"م",1,0],["وَكاتِبٌ ما فَتِئَت كُتبُهُ","طَلائِعاً لِلفَتحِ وَالنَصرِ",12,"ر",1,0],["وكاتبٍ بارعٍ بلاغتُهُ","تجلو علينا كلام سحبان",13,"ن",1,1],["وكاتِبُها الخالقُ السرمديّ","وتلك المقاديرُ أقلامُها",14,"ه",2,0],["وَكَاتِبٍ ألفاظُهُ وَكُتبُهُ","بَغِيضَةٌ إن خَطَّ أو تَكَلَّمَا",15,"م",2,1],["وَكاتِبٍ جاءَنا بِأَعمى","لَم يَحوِ عِلماً وَلا نَفاذا",16,"ذ",2,1],["وكاتنز ذهباً ذخراً لشدته","أمسى ببطن الثرى لم يدر ما ذخرا",17,"ر",2,0],["وكاتمٍ يُغري بأسراره","في هُدُب الأجفانِ دمعٌ نمومْ",18,"م",1,0],["وَكاتِبٍ ما عِندَهُ أَنَّهُ","يَنفَعُهُ الشُكرُ عَلى النَقعِ",19,"ع",1,1],["وَكَاتِبَاً تَشْهَدُ البَلاَغَةُ","بِالْفَضْلِ لَهُ فِي التَّفْصِيْلِ وَالجُمَلِ",20,"ل",1,0],["وَكاتب الشَطب في أَمري تَمدّ لَه","عَمّا قَليل إِلى قَطع المَعاش يَد",21,"د",1,0],["وكاتب الدرجِ او الدستِ الرفيع","اشد حاجةً لها من الجميع",22,"ع",1,0],["وكاتب كتبه تذكرني ال","قران حتى أظلَّ في عجب",23,"ب",1,1],["وَكاتبةٍ بِالمسكِ في الخدّ جَعفرا","بِنفسي مخطّ المسكِ مِن حيثُ أثّرا",24,"ر",2,1],["وكاتب الدمع ينشي فوق وجنته","رسائل الوجد والأشجان تمليه",25,"ي",2,0],["وكاتب من قومنا شاعرٌ","ليس بذاك الكاتب الماهر",26,"ر",1,1],["وكاتبه رؤسا العراق","هلم نبايعك لن نخذلك",27,"ك",1,0],["وَكاتب حاسب إِن رُمتُ مُلتَمِساً","ما في يَديه إِذا ما رُحت مُجتَديَه",28,"ه",1,1],["وَكاتبٍ شاعرٍ أَبدى بِمُهرَقهِ","نَظماً وَشعراً بِهِ بانَت فَضائِلُهُ",29,"ل",2,1],["وَكاتِبَةٌ خَطّاً يَزينُ يَراعَها","بَراعَتُهُ فيهِ اِبتِهاجٌ لِمَن نَظَر",30,"ر",1,0],["وكاتبة بالمسك في الخد جعفراً","بنفسي سواد المسك من حيث أثرا",31,"ر",2,1],["وكَاتِبٌ تُوجَدُ البَلاغَةُ في","أَلْفَاظِهِ والصَّوابُ والرَّشَدُ",32,"د",1,0],["وَكاتبُ المَوتِ بِالرِماحِ","ماحي للأَنفُسِ",33,"س",1,0],["وكاتب اسمه مع اسمه وعلى","قوائم العرش ثم اللوح والقلم",34,"م",1,0],["وكاتبٍ أهديت نفسي له","فهي من السوء فدا نفسه",35,"س",2,1],["وكاتبٌ خطّ العِذا","ر في خدّه يمشُقُ",36,"ق",1,0],["وكاتب يملي فلا يفوته","شيء ولا يعزى إليه قدح",37,"ح",1,0],["وكاتباً أصبح من خطه","يُغني عَن الخطية السمر",38,"ر",1,0],["وكاتمته صحبي فنم بسره","سواكب آماق حكيين الغواديا",39,"ي",2,0],["وكاتب الاقدار هو ربي وربه","كلنا في كل يومن ننحني له",40,"ل",2,0],["وكاتبها العَبْد الْفَقِير مُحَمَّد","هُوَ ابْن أبي بكر بن قَاسم الْعَجم",41,"م",1,0],["وكاتبا في العلم سفرا راقيا","في علمه ورقمه المنظم",42,"م",1,0],["وكاتباً تشهَدُ الكتابة ُ بالفَ","ضْلِ لهُ وهو بالفضلِ يَشْهَدُ لي",43,"ل",2,0]]}