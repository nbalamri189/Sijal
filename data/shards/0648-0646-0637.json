{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[83,"أرفعوا للأنس ريا","https://www.aldiwan.net/poem54203.html","مجزوء الرمل"],[27,"لعل فراق الحي للبين عامدي","https://www.aldiwan.net/poem5733.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[72,"لا أترك الحب والعذال وعاظ","https://www.aldiwan.net/poem19156.html","البسيط"],[72,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[64,"وطائر حل أرض الشام أقلقه","https://www.aldiwan.net/poem67561.html","البسيط"],[92,"غناه الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[132,"ألا هل أتى بحرينا صنع ربنا","https://www.aldiwan.net/poem20995.html","الطويل"],[148,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[210,"فلي كبد ما انفك عنها غليلها","https://www.aldiwan.net/poem37837.html","الطويل"],[224,"الخطر","https://www.aldiwan.net/poem24237.html","عموديه"],[227,"وسرب من الآنسات الحسان","https://www.aldiwan.net/poem51144.html","المتقارب"],[227,"تركنا النعيم لأهل النعيم","https://www.aldiwan.net/poem51190.html","المتقارب"],[268,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[269,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[280,"أدر يا نديمي علينا عقارا","https://www.aldiwan.net/poem32782.html","المتقارب"],[326,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[340,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[374,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[388,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[400,"بدأ الدين غريبا مثلما","https://www.aldiwan.net/poem33448.html","الرمل"],[413,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[413,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[413,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[429,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[429,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[438,"نودعكم أحبتنا وداعا","https://www.aldiwan.net/poem14311.html","الوافر"],[451,"أخي عبد المسيح فدتك نفسي","https://www.aldiwan.net/poem61583.html","الوافر"],[456,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[456,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[456,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[462,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[498,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[498,"علامة حبكم قلب لهيف","https://www.aldiwan.net/poem38104.html","الوافر"],[513,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[536,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[560,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَنَطمَعُ أَن يَمَلَّ مِنَ التَقاضي","غَريمٌ لَيسَ يَضجَرُ بِالمَطالِ",0,"ل",1,0],["وَنُطنا الأَداوى في السَوادِ فَيَمَّمَت","بِنا مَصدَرًا وَالقَرنُ لَم يَبدُ حاجِبُه",1,"ب",2,0],["ونطول كنت زجلي","ونمي نخشي نثقل",2,"ل",1,0],["وَنَطلُبُ وُدّاً مِنكِ لَو نَستَفيدُهُ","لَكانَ إِلَينا مِن أَحَبِّ الفَوائِدِ",3,"د",1,0],["ونطَّقتني الأيادي بالعيونِ ثنىً","فللكواكبِ كالآذانِ إنصات",4,"ت",1,0],["ونطَّقني نداك وكنت حجلاً","فصرت اليوم أنطق من وشاح",5,"ح",1,0],["ونطَّقتني ببكرٍ هامَ سامعها","حتَّى كأنَّ انتصاب السمع إنعاظ",6,"ظ",1,0],["ونطق به للمنطقيّ تأدبٌ","ونحوٌ به للفارسيّ ترجّل",7,"ل",1,0],["وَنُطقِهِ زُفَرٌ تُنبيكَ عَن حُرَقٍ","فَيَنثَني نَوحُهُ نُطقاً بِإِضمارِ",8,"ر",1,0],["ونِطاقُ الطِّفلِ تُنَمِّقُها","فَيَجُلُّ الحُبَّ ويَحْمدُهُ",9,"د",2,0],["ونطري السمك البن","ي والجردق والبنا",10,"ن",2,0],["ونطلع في مطالعنا نجوماً","تعدّ لكلّ شيطان شهابا",11,"ب",2,0],["وَنُطِيعُ أمرَ نبيّنَا ونُجيبُهُ","وإذا دَعَا لِكَرِيَةٍ لم نُسْبَقِ",12,"ق",1,0],["ونُطاقْ من الاسر رُوحاً","تجيشُ في قفصٍ من دمٍ ترسِف",13,"ف",1,0],["ونطَّ ذيّاك مرتجّاً تقولُ : بهِ","رِيِشُ النعامِ على الوِرْكَيْنِ منضود",14,"د",1,0],["وَنُطعِمُ حَتّى يَترُكَ الناسُ فَضلَهُم","إِذا جُعِلَت أَيدي المُفيضِينَ تُرعَدُ",15,"د",1,0],["ونطت أمانة الدنيا","بجيد أغرَّ مؤتمن",16,"ن",1,0],["ونُطْقِي عَلا الجوزاءَ شأناً وَرُتْبةً","ويُظْهِرُ عِتْقَ الصافناتِ صَهِيْلُها",17,"ل",3,0],["ونطير في نشواتنا","نهفو إليه وننتظر",18,"ر",1,0],["ونِطْن شقائقها بالخدود","فدبَّجْنَ طرْزَ بياض الخدودِ",19,"د",1,0],["ونطردُ بالعزّ ذلَّ الخمولِ","ونشرب ماءَ المعالي صَبُوحا",20,"ح",2,0],["ونَطلُبُ حقَّ اللهِ والملكِ والعُلى","ليشفي نفوسَ التائهينَ لِقاء",21,"ا",2,0],["وَنطق ضب وَنسج العَنكَبوت كَما","باض الحمام الثَاني اثنين في الغار",22,"ر",1,0],["وَنَطمَعُ بِالعَفوِ مِن رَبِّنا","وَمن يَستَجِر بِكَريمٍ يجارا",23,"ر",2,0],["ونطمع أن يكون لنا ظهيرا","ونحن نعيش في حسدٍ وحقد",24,"د",1,0],["ونطلب الموت فإن يقترب","نلاقيه بالادمع القانية",25,"ي",2,0],["ونُط نفثاتِ الدرّ في جيد حازمٍ","وناهيك من درٍّ يزين حِلاؤه",26,"ا",3,0],["ونطلب كلنا ربنا","حسن الختام",27,"م",1,0],["ونطوف البيت سبعاً لا نرى","بدعة فيه ونأتي زمزما",28,"م",2,0],["ونطمع منها بالمحال ولم تكن","أمانيُّنا إلاَّ أحاديث مفتري",29,"ر",2,0],["ونطمع بالبقاء وما برحنا","نُرَوَّعُ بالتفرّق والبعاد",30,"د",1,0],["ونطمع أن تبقى ويبقى نعيمُها","فلم يبق منها غير حسرة خائب",31,"ب",1,0],["ونُطْفَةٌ مِنْ صَمِيمِ الْفَخْرِ ما بَرَحَتْ","تَجُولُ مِنْ مَشَجٍ زَاكٍ إلَى مَشَجِ",32,"ج",1,0],["ونطقْتَ بالليثِ البديعِ فلم يدعْ","فضلاً يبينُ به خطيبُ إيادِ",33,"د",1,0],["ونطلب ربنا لكمو رضاه","ونطلب أحمداً لكم الشفاعا",34,"ع",2,0],["ونطلب منكم الدعوات يكما","بها في القصد ننتفع انتفاعا",34,"ع",2,0],["ونطمع في غد وغد تولى","كحاضرنا ومات بحضن أمس",35,"س",1,0],["ون طُرِقوا بابن ليلٍ أذَمَّ","له جودُهُ وابنِ صبحٍ ألمّْ",36,"م",1,0],["ونطقتْ بالحسين منهم","شهادةٌ في أبي المعالي",37,"ي",1,0],["ونطقَتْ خُرسُ العلا فأبصرتْ","عمياؤها وسمعت وهي وَقَرْ",38,"ر",1,0],["ونطمعُ فيها بالمقام وأننا","إلى أمدٍ منها نخبُّ ونوضع",39,"ع",1,0],["ونطوي بذيل جناب الرسو","لِ ونطوي الزمان وما قد جنا",40,"ن",2,0],["ونُطقٌ عن سِواكُمْ ذو انْعِقادٍ","وفيكُمْ كلُّ حاصِلِهِ الثَّناءُ",41,"ا",2,0],["ونطقت من فصل الخطاب بخطبة","عون الإله لها من الأمداد",42,"د",1,0],["ونَطقتَ مِن صَمتٍ بِه قَد كَان صُد","غِي يَشتَكِي مِن ظُفرِيَ الحَكَّاك",43,"ك",1,0],["وَنُطوى كَما تُطوى البُرود بحفرةٍ","مُطمّمةٍ أعيتْ على كلّ هاربِ",44,"ب",1,0],["ونطلب منه جميع الذي","نريد فيتحفنا بالنعم",45,"م",1,0],["ونَطمَعُ في السَّلامةِ من أذاهُ","فقد وافَى على قَدَمِ المُحِبِّ",46,"ب",1,0],["ونطلق القول الذي قد ستره","من قبلنا لخوف بطش الفجرة",47,"ه",1,0]]}