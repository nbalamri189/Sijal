{"poems":[[55,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[32,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[85,"أرفعوا للأنس ريا","https://www.aldiwan.net/poem54203.html","مجزوء الرمل"],[29,"لعل فراق الحي للبين عامدي","https://www.aldiwan.net/poem5733.html","الطويل"],[74,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[74,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[74,"لا أترك الحب والعذال وعاظ","https://www.aldiwan.net/poem19156.html","البسيط"],[74,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[66,"وطائر حل أرض الشام أقلقه","https://www.aldiwan.net/poem67561.html","البسيط"],[94,"غناه الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[63,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[82,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[92,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[92,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[137,"ألا هل أتى بحرينا صنع ربنا","https://www.aldiwan.net/poem20995.html","الطويل"],[153,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[215,"فلي كبد ما انفك عنها غليلها","https://www.aldiwan.net/poem37837.html","الطويل"],[229,"الخطر","https://www.aldiwan.net/poem24237.html","عموديه"],[232,"وسرب من الآنسات الحسان","https://www.aldiwan.net/poem51144.html","المتقارب"],[232,"تركنا النعيم لأهل النعيم","https://www.aldiwan.net/poem51190.html","المتقارب"],[273,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[274,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[285,"أدر يا نديمي علينا عقارا","https://www.aldiwan.net/poem32782.html","المتقارب"],[331,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[345,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[380,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[394,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[406,"بدأ الدين غريبا مثلما","https://www.aldiwan.net/poem33448.html","الرمل"],[419,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[419,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[419,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[435,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[435,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[444,"نودعكم أحبتنا وداعا","https://www.aldiwan.net/poem14311.html","الوافر"],[455,"أخي عبد المسيح فدتك نفسي","https://www.aldiwan.net/poem61583.html","الوافر"],[460,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[460,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[460,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[466,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[502,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[502,"علامة حبكم قلب لهيف","https://www.aldiwan.net/poem38104.html","الوافر"],[517,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[540,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[553,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[560,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[564,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[819,"","https://poetry.dctabudhabi.ae/diwan/poem/20919","الكامل"],[1050,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"]],"verses":[["وَنَطمَعُ أَن يَمَلَّ مِنَ التَقاضي","غَريمٌ لَيسَ يَضجَرُ بِالمَطالِ",0,"ل",1,0],["وَنُطنا الأَداوى في السَوادِ فَيَمَّمَت","بِنا مَصدَرًا وَالقَرنُ لَم يَبدُ حاجِبُه",1,"ب",2,0],["ونطول كنت زجلي","ونمي نخشي نثقل",2,"ل",1,0],["وَنَطلُبُ وُدّاً مِنكِ لَو نَستَفيدُهُ","لَكانَ إِلَينا مِن أَحَبِّ الفَوائِدِ",3,"د",1,0],["ونطَّقتني الأيادي بالعيونِ ثنىً","فللكواكبِ كالآذانِ إنصات",4,"ت",1,0],["ونطَّقني نداك وكنت حجلاً","فصرت اليوم أنطق من وشاح",5,"ح",1,0],["ونطَّقتني ببكرٍ هامَ سامعها","حتَّى كأنَّ انتصاب السمع إنعاظ",6,"ظ",1,0],["ونطق به للمنطقيّ تأدبٌ","ونحوٌ به للفارسيّ ترجّل",7,"ل",1,0],["وَنُطقِهِ زُفَرٌ تُنبيكَ عَن حُرَقٍ","فَيَنثَني نَوحُهُ نُطقاً بِإِضمارِ",8,"ر",1,0],["ونِطاقُ الطِّفلِ تُنَمِّقُها","فَيَجُلُّ الحُبَّ ويَحْمدُهُ",9,"د",2,0],["ونطري السمك البن","ي والجردق والبنا",10,"ن",2,0],["ونطلع في مطالعنا نجوماً","تعدّ لكلّ شيطان شهابا",11,"ب",2,0],["ونُطْعِمُ الضَّيْفَ مَعْبُوَط السَّنَامِ إِذَا","أَلْوَتْ رِيَاحُ الشِّتَاءِ الهُوْجُ بالحُظُرِ",12,"ر",1,0],["وَنُطِيعُ أمرَ نبيّنَا ونُجيبُهُ","وإذا دَعَا لِكَرِيَةٍ لم نُسْبَقِ",13,"ق",1,0],["ونُطاقْ من الاسر رُوحاً","تجيشُ في قفصٍ من دمٍ ترسِف",14,"ف",1,0],["ونطَّ ذيّاك مرتجّاً تقولُ : بهِ","رِيِشُ النعامِ على الوِرْكَيْنِ منضود",15,"د",1,0],["وَنُطعِمُ حَتّى يَترُكَ الناسُ فَضلَهُم","إِذا جُعِلَت أَيدي المُفيضِينَ تُرعَدُ",16,"د",1,0],["ونطت أمانة الدنيا","بجيد أغرَّ مؤتمن",17,"ن",1,0],["ونُطْقِي عَلا الجوزاءَ شأناً وَرُتْبةً","ويُظْهِرُ عِتْقَ الصافناتِ صَهِيْلُها",18,"ل",3,0],["ونطير في نشواتنا","نهفو إليه وننتظر",19,"ر",1,0],["ونِطْن شقائقها بالخدود","فدبَّجْنَ طرْزَ بياض الخدودِ",20,"د",1,0],["ونطردُ بالعزّ ذلَّ الخمولِ","ونشرب ماءَ المعالي صَبُوحا",21,"ح",2,0],["ونَطلُبُ حقَّ اللهِ والملكِ والعُلى","ليشفي نفوسَ التائهينَ لِقاء",22,"ا",2,0],["وَنطق ضب وَنسج العَنكَبوت كَما","باض الحمام الثَاني اثنين في الغار",23,"ر",1,0],["وَنَطمَعُ بِالعَفوِ مِن رَبِّنا","وَمن يَستَجِر بِكَريمٍ يجارا",24,"ر",2,0],["ونطمع أن يكون لنا ظهيرا","ونحن نعيش في حسدٍ وحقد",25,"د",1,0],["ونطلب الموت فإن يقترب","نلاقيه بالادمع القانية",26,"ي",2,0],["ونُط نفثاتِ الدرّ في جيد حازمٍ","وناهيك من درٍّ يزين حِلاؤه",27,"ا",3,0],["ونطلب كلنا ربنا","حسن الختام",28,"م",1,0],["ونطوف البيت سبعاً لا نرى","بدعة فيه ونأتي زمزما",29,"م",2,0],["ونطمع منها بالمحال ولم تكن","أمانيُّنا إلاَّ أحاديث مفتري",30,"ر",2,0],["ونطمع بالبقاء وما برحنا","نُرَوَّعُ بالتفرّق والبعاد",31,"د",1,0],["ونطمع أن تبقى ويبقى نعيمُها","فلم يبق منها غير حسرة خائب",32,"ب",1,0],["ونُطْفَةٌ مِنْ صَمِيمِ الْفَخْرِ ما بَرَحَتْ","تَجُولُ مِنْ مَشَجٍ زَاكٍ إلَى مَشَجِ",33,"ج",1,0],["ونطقْتَ بالليثِ البديعِ فلم يدعْ","فضلاً يبينُ به خطيبُ إيادِ",34,"د",1,0],["ونطلب ربنا لكمو رضاه","ونطلب أحمداً لكم الشفاعا",35,"ع",2,0],["ونطلب منكم الدعوات يكما","بها في القصد ننتفع انتفاعا",35,"ع",2,0],["ونطمع في غد وغد تولى","كحاضرنا ومات بحضن أمس",36,"س",1,0],["ون طُرِقوا بابن ليلٍ أذَمَّ","له جودُهُ وابنِ صبحٍ ألمّْ",37,"م",1,0],["ونطقتْ بالحسين منهم","شهادةٌ في أبي المعالي",38,"ل",2,0],["ونطقَتْ خُرسُ العلا فأبصرتْ","عمياؤها وسمعت وهي وَقَرْ",39,"ر",1,0],["ونطمعُ فيها بالمقام وأننا","إلى أمدٍ منها نخبُّ ونوضع",40,"ع",1,0],["ونطوي بذيل جناب الرسو","لِ ونطوي الزمان وما قد جنا",41,"ن",2,0],["ونُطقٌ عن سِواكُمْ ذو انْعِقادٍ","وفيكُمْ كلُّ حاصِلِهِ الثَّناءُ",42,"ا",2,0],["ونطقت من فصل الخطاب بخطبة","عون الإله لها من الأمداد",43,"د",1,0],["ونَطقتَ مِن صَمتٍ بِه قَد كَان صُد","غِي يَشتَكِي مِن ظُفرِيَ الحَكَّاك",44,"ك",1,0],["وَنُطوى كَما تُطوى البُرود بحفرةٍ","مُطمّمةٍ أعيتْ على كلّ هاربِ",45,"ب",1,0],["ونطلب منه جميع الذي","نريد فيتحفنا بالنعم",46,"م",1,0],["ونَطمَعُ في السَّلامةِ من أذاهُ","فقد وافَى على قَدَمِ المُحِبِّ",47,"ب",1,0],["ونطلق القول الذي قد ستره","من قبلنا لخوف بطش الفجرة",48,"ه",1,0],["وَنَطَقتُ خَطبَةَ ماجِدٍ","غَيرِ الضَعيفِ وَلا العَيِيَّه",49,"ي",2,0],["ونطعنهم إذا جاؤوا إلينا","ولو صبري وإخواني تجود",50,"د",1,0]]}