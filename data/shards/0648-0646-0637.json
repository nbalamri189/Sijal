مة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4927,"دموع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29947",""],[5000,"حنين الحنايا","https://www.poetsgate.com/ViewPoem.aspx?id=5072",""],[5010,"حديث بين قلبين","https://www.poetsgate.com/ViewPoem.aspx?id=193239",""],[585,"أنرسف بالسلاسل والقيود","https://www.poetsgate.com/ViewPoem.aspx?id=161852",""],[5237,"بإحسان ذي الطول أهل الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=113118",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5324,"رثاء والدي (رحمه الله)","https://www.poetsgate.com/ViewPoem.aspx?id=211105",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5351,"حسناً سأحدث","https://www.poetsgate.com/ViewPoem.aspx?id=202715",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5587,"هذي الرسائل","https://www.poetsgate.com/ViewPoem.aspx?id=196819",""],[5606,"يدوم لك البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=197840",""],[5650,"ليسَ غيرُ التّيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=181696",""],[5720,"إِلَهِيْ رجوناك","https://www.poetsgate.com/ViewPoem.aspx?id=200534",""],[5720,"هُنا القوزُ","https://www.poetsgate.com/ViewPoem.aspx?id=214031",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[5725,"دموع السماء","https://www.poetsgate.com/ViewPoem.aspx?id=209074",""],[5736,"وحدي","https://www.poetsgate.com/ViewPoem.aspx?id=204466",""],[5804,"مساجلة ( الطغاة )","https://www.poetsgate.com/ViewPoem.aspx?id=189659",""],[5922,"أفضل امرءة في التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=183795",""],[5956,"أرنو إليك","https://www.poetsgate.com/ViewPoem.aspx?id=182039",""],[5956,"تعالي ننظف ما بنفسينا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182190",""],[5956,"أنا معجب بك‎ ‎","https://www.poetsgate.com/ViewPoem.aspx?id=182448",""],[5997,"الْأثَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214281",""],[6300,"نرجسيّة قلمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82865&r=&rc=36",""],[5567,"شغف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81761&r=&rc=29",""]],"verses":[["وَنَطمَعُ أَن يَمَلَّ مِنَ التَقاضي","غَريمٌ لَيسَ يَضجَرُ بِالمَطالِ",0,"ل",1,0],["وَنُطنا الأَداوى في السَوادِ فَيَمَّمَت","بِنا مَصدَرًا وَالقَرنُ لَم يَبدُ حاجِبُه",1,"ب",2,0],["ونطول كنت زجلي","ونمي نخشي نثقل",2,"ل",1,0],["وَنَطلُبُ وُدّاً مِنكِ لَو نَستَفيدُهُ","لَكانَ إِلَينا مِن أَحَبِّ الفَوائِدِ",3,"د",1,0],["ونطَّقتني الأيادي بالعيونِ ثنىً","فللكواكبِ كالآذانِ إنصات",4,"ت",1,0],["ونطَّقني نداك وكنت حجلاً","فصرت اليوم أنطق من وشاح",5,"ح",1,0],["ونطَّقتني ببكرٍ هامَ سامعها","حتَّى كأنَّ انتصاب السمع إنعاظ",6,"ظ",1,0],["ونطق به للمنطقيّ تأدبٌ","ونحوٌ به للفارسيّ ترجّل",7,"ل",1,0],["وَنُطقِهِ زُفَرٌ تُنبيكَ عَن حُرَقٍ","فَيَنثَني نَوحُهُ نُطقاً بِإِضمارِ",8,"ر",1,0],["ونِطاقُ الطِّفلِ تُنَمِّقُها","فَيَجُلُّ الحُبَّ ويَحْمدُهُ",9,"د",2,0],["ونطري السمك البن","ي والجردق والبنا",10,"ن",2,0],["ونطلع في مطالعنا نجوماً","تعدّ لكلّ شيطان شهابا",11,"ب",2,0],["ونُطْعِمُ الضَّيْفَ مَعْبُوَط السَّنَامِ إِذَا","أَلْوَتْ رِيَاحُ الشِّتَاءِ الهُوْجُ بالحُظُرِ",12,"ر",1,0],["وَنُطِيعُ أمرَ نبيّنَا ونُجيبُهُ","وإذا دَعَا لِكَرِيَةٍ لم نُسْبَقِ",13,"ق",1,0],["ونُطاقْ من الاسر رُوحاً","تجيشُ في قفصٍ من دمٍ ترسِف",14,"ف",1,0],["ونطَّ ذيّاك مرتجّاً تقولُ : بهِ","رِيِشُ النعامِ على الوِرْكَيْنِ منضود",15,"د",1,0],["وَنُطعِمُ حَتّى يَترُكَ الناسُ فَضلَهُم","إِذا جُعِلَت أَيدي المُفيضِينَ تُرعَدُ",16,"د",1,0],["ونطت أمانة الدنيا","بجيد أغرَّ مؤتمن",17,"ن",1,0],["ونُطْقِي عَلا الجوزاءَ شأناً وَرُتْبةً","ويُظْهِرُ عِتْقَ الصافناتِ صَهِيْلُها",18,"ل",3,0],["ونطير في نشواتنا","نهفو إليه وننتظر",19,"ر",1,0],["ونِطْن شقائقها بالخدود","فدبَّجْنَ طرْزَ بياض الخدودِ",20,"د",1,0],["ونطردُ بالعزّ ذلَّ الخمولِ","ونشرب ماءَ المعالي صَبُوحا",21,"ح",2,0],["ونَطلُبُ حقَّ اللهِ والملكِ والعُلى","ليشفي نفوسَ التائهينَ لِقاء",22,"ا",2,0],["وَنطق ضب وَنسج العَنكَبوت كَما","باض الحمام الثَاني اثنين في الغار",23,"ر",1,0],["وَنَطمَعُ بِالعَفوِ مِن رَبِّنا","وَمن يَستَجِر بِكَريمٍ يجارا",24,"ر",2,0],["ونطمع أن يكون لنا ظهيرا","ونحن نعيش في حسدٍ وحقد",25,"د",1,0],["ونطلب الموت فإن يقترب","نلاقيه بالادمع القانية",26,"ي",2,0],["ونُط نفثاتِ الدرّ في جيد حازمٍ","وناهيك من درٍّ يزين حِلاؤه",27,"ا",3,0],["ونطلب كلنا ربنا","حسن الختام",28,"م",1,0],["ونطوف البيت سبعاً لا نرى","بدعة فيه ونأتي زمزما",29,"م",2,0],["ونطمع منها بالمحال ولم تكن","أمانيُّنا إلاَّ أحاديث مفتري",30,"ر",2,0],["ونطمع بالبقاء وما برحنا","نُرَوَّعُ بالتفرّق والبعاد",31,"د",1,0],["ونطمع أن تبقى ويبقى نعيمُها","فلم يبق منها غير حسرة خائب",32,"ب",1,0],["ونُطْفَةٌ مِنْ صَمِيمِ الْفَخْرِ ما بَرَحَتْ","تَجُولُ مِنْ مَشَجٍ زَاكٍ إلَى مَشَجِ",33,"ج",1,0],["ونطقْتَ بالليثِ البديعِ فلم يدعْ","فضلاً يبينُ به خطيبُ إيادِ",34,"د",1,0],["ونطلب ربنا لكمو رضاه","ونطلب أحمداً لكم الشفاعا",35,"ع",2,0],["ونطلب منكم الدعوات يكما","بها في القصد ننتفع انتفاعا",35,"ع",2,0],["ونطمع في غد وغد تولى","كحاضرنا ومات بحضن أمس",36,"س",1,0],["ون طُرِقوا بابن ليلٍ أذَمَّ","له جودُهُ وابنِ صبحٍ ألمّْ",37,"م",1,0],["ونطقتْ بالحسين منهم","شهادةٌ في أبي المعالي",38,"ل",2,0],["ونطقَتْ خُرسُ العلا فأبصرتْ","عمياؤها وسمعت وهي وَقَرْ",39,"ر",1,0],["ونطمعُ فيها بالمقام وأننا","إلى أمدٍ منها نخبُّ ونوضع",40,"ع",1,0],["ونطوي بذيل جناب الرسو","لِ ونطوي الزمان وما قد جنا",41,"ن",2,0],["ونُطقٌ عن سِواكُمْ ذو انْعِقادٍ","وفيكُمْ كلُّ حاصِلِهِ الثَّناءُ",42,"ا",2,0],["ونطقت من فصل الخطاب بخطبة","عون الإله لها من الأمداد",43,"د",1,0],["ونَطقتَ مِن صَمتٍ بِه قَد كَان صُد","غِي يَشتَكِي مِن ظُفرِيَ الحَكَّاك",44,"ك",1,0],["وَنُطوى كَما تُطوى البُرود بحفرةٍ","مُطمّمةٍ أعيتْ على كلّ هاربِ",45,"ب",1,0],["ونطلب منه جميع الذي","نريد فيتحفنا بالنعم",46,"م",1,0],["ونَطمَعُ في السَّلامةِ من أذاهُ","فقد وافَى على قَدَمِ المُحِبِّ",47,"ب",1,0],["ونطلق القول الذي قد ستره","من قبلنا لخوف بطش الفجرة",48,"ه",1,0],["وَنطوي بِساط النسك لا عَن ضلالة","وَلا عَن جحود طارئٍ وَقصور",49,"ر",1,0],["وَنَطوي سجلَّ الجور في ظل منصف","لَهُ حظ مَشغوف بِإِسعاف قادم",50,"م",1,0],["ونطقت بالشعر الصراح مودعاً","فتركته وهو الأجل الأمجد",51,"د",1,0],["وَنطَّ كَالقِطَة فَوقَ الشَجَرَه","وَكانَ نَطُّهُ بِغَير ثَمَرَه",52,"ه",1,0],["وَنَطَّ بِالقُوة وَسط البير","وَلَم يَكُن بِالأسد الخَبير",53,"ر",1,0],["وَنَطَّ في النَهر بِهِ فَوَقَعا","وَنَزَلا في قاعِهِ ما طلَعا",54,"ع",2,0],["ونطق الطفلِ والأملا","كِ حقا زَانَ أو شانا",55,"ن",2,0],["ونُطِلّ مِن دمِنا على دمِنا الذي","أرخصتموهُ فسَال َسَيلَ الماءِ",56,"ا",2,0],["ونُطيع آمِرَنا ونجعلُ أمرَنا","لذوي جَلادتِنا وحَزمِ قِوانا",57,"ن",2,0],["ونطقك بين الكسرِ والضم في","التقا الشِفاه هو الاشمام والخلف يرفعُ",58,"ع",1,0],["ونطقنا بلا إله سوى عن","كون الكون واصطفاه رسولا",59,"ل",2,0],["ونطقنا بالإله سوا من","كرر الليل واستنار النهارا",60,"ر",2,0],["ونطقته بعض ما في الضمير","وشاورت كلاً على الانفراد",61,"د",1,0],["ونَطْحَنَهُمْ طَحْنَ الرّحَى بِثفالها","وذاكَ بما أَسْدَوا إليكَ قليلُ",62,"ل",1,0],["ونطقت بشعر منتونٍ","من شعرة مشعور أشعر",63,"ر",1,0],["ونطمع في البقاء وليسَ خَلقٌ","على حالٍ تسالمهُ يدوم",64,"م",1,0],["ونطلبه حسن الختام وموتة","على غاية الاحسان لا تتقلب",65,"ب",1,0],["ونطلبه التوفيق للخير والهدى","كذا كلما لا يرتضيه نجنب",65,"ب",1,0],["ونطلِعُ من زُرق الأسِنَّةِ أنجُماً","لها فى صدور الدارعين أُفولُ",66,"ل",1,0],["ونطلع في الغد الآتي","نجوما حرة زهرا",67,"ر",2,0],["ونطقي صموت وحالي سكوت","وذهني بهوت ودمعي يسيل",68,"ل",1,0],["ونطرب من شراب القو","م مدا الاوقات اخوانا",69,"ن",2,0],["ونطلب منه يا خلى","سرائرنا ونجوانا",69,"ن",2,0],["ونطلب من زيادات","لنا عمراً وأزمانا",69,"ن",2,0],["ونطوي الفلا من شدة الشوق للقا","فتمسي الفلا تحكي سجلاً قطعناه",70,"ن",3,0],["ونُطْرِقُ إِجْلالا لقَدْرِك إِنَّه","ليَعْظُمُ منَّا في النفوس ويَكْبُرُ",71,"ر",1,0],["ونُطْ بي صعْبَ الأَمر وَارْمِ بمهْجَتي","عسيرَ أُمورٍ تَلْقَها تَتَيَسَّرُ",71,"ر",1,0],["ونطرَب منه بإخلاّن","ونسقى كل من جانا",72,"ن",2,0],["ونَطلُب من زياداتٍ","بسرٍّ ثم اعلانا",72,"ن",2,0],["ونطاقها يمتدُّ في الدنيا على","سكانها بدجى الشقاءِ مخيما",73,"م",2,0],["وَنَطَقتُ خَطبَةَ ماجِدٍ","غَيرِ الضَعيفِ وَلا العَيِيَّه",74,"ي",2,0],["ونطق بحقٍ فهو بالصدقِ ناطقٌ","تقسم قرآناً بتقسيم فُرقان",75,"ن",1,0],["ونطحنهم طحن الرحا بكتائب","تسابق أقدار السماء بأقدار",76,"ر",1,0],["وَنطلبها كَذي ظَمأ يُباري","خلوب البَرق وَالآل اللموعا",77,"ع",2,0],["وَنطاقها مُتَراصف في نَظمِهِ","فَكَأَنَّما اِنتَطَقَت بِقطعة جوشن",78,"ن",1,0],["ونطعم الشهد من ريق الثنايا الزلال","مهفهف القدّ باهي الخدّ ساجي النجال",79,"ل",1,0],["ونطق ذي القدرة شرط جىء به","على الإصح للكمال فانتبه",80,"ه",1,0],["ونطاق دايرة البروج مقسم","بمنازل معروفة معلومة",81,"ه",1,0],["ونطقت بالألحان صادقة","فغدوت أبلغ كل من نطقا",82,"ق",2,0],["ونُطقٍ فصيحٍ من ذراع مبينةٍ","لكيد عدوٍّ للعداوة ناصب",83,"ب",1,0],["ونطلب الصلاة والسلاما","على نبيّ بيَّن الإسلاما",84,"م",2,0],["ونُطَوّق الأوى إلى أبوابنا","طوق الفخار وكان غير مطوّق",85,"ق",1,0],["وَنَطمَع فَوقَ الزاد حرصاً عَلى البَقا","وَنورثهُ تَأساء ما نَتَوَقَع",86,"ع",1,0],["ونطعنهم إذا جاؤوا إلينا","ولو صبري وإخواني تجود",87,"د",1,0],["وَنطقُك نفّاقٌ وَقَلبُك كانزٌ","وَقَد تَكثر النفاخ إِن سهل الكنز",88,"ز",1,0],["ونطاول الجوزاء وهي سحيقةٌ","ونقابل الأرزاء مبتسمينا",89,"ن",2,0],["ونطلب منه تأييداً ونصراً","وتمكيناً برغم ذوي النفاق",90,"ق",1,0],["ونطتُ بكم ودي فمهما","أسأتم إليه فما أقطعه",91,"ع",2,0],["ونطق الضب والسرحان أضحت","له الأسماع تنفصم افصاما",92,"م",2,0],["وَنَطرَحُ فيما بَينَنا حِشمَةَ الآلي","تَعاطوا وِداداً لا يَنُمُّ بِحالِ",93,"ل",1,0],["وَنطقُ ذِى القُدرةِ شَرطٌ فِيهِ","عَلَى اختِلاَفِ كُتبُهُم تَحوِيهِ",94,"ه",1,0],["وَنَطَت عَلى القَفَصِ الَّذي","قَد كانَ يُدعى قَصرَها",95,"ه",2,0],["ونطق ذراع الشاة والصخر والحصى","وجاءت له الأشجار تسعى لها سبح",96,"ح",1,0],["ونطق بلابل زاد الأشواق","قد أطرق الغيد بينهن الأسماع",97,"ع",1,0],["ونُطْقُهُ كاتبهُ النبيلُ","وقلبُهُ وعقلُهُ الرسولُ",98,"ل",1,0],["ونطقُك زِنْه في ميزان عقْلٍ","فما الإنسانُ إلا الأصغرَان",99,"ن",1,0],["ونطق السبع الاقاليم في","نطاق عدل يا له من نطاق",100,"ق",1,0],["ونطوف بآفاق غرامٍ","تبغيه الروح وتقصدهُ",101,"د",2,0],["ونطعنُ قلبَ الهمومِ لنلقى","الربيعَ على فرحةٍ شاردة",102,"د",2,0],["ونطقت حروفا عارية","وحروفي كانت معترفة",103,"ف",2,0],["ونطلب حفظَ وِحدتنا","و