[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[477,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[513,"نظرت إليه نظرة مستهام","https://www.aldiwan.net/poem67771.html","الوافر"],[527,"غريب على الأيام وجدان مثله","https://www.aldiwan.net/poem45983.html","الطويل"],[529,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"جرى الدمع في مقلتي إذ جرت","https://www.aldiwan.net/poem48278.html","عموديه"],[551,"كم ذا تطيش سهام الموت مخطئة","https://www.aldiwan.net/poem47169.html","البسيط"],[551,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[551,"أتاني والركبان يأتي نجيهم","https://www.aldiwan.net/poem47332.html","الطويل"],[551,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[558,"يخاطب كلا في المناجاة صاحبه","https://www.aldiwan.net/poem33525.html","الطويل"],[558,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"],[558,"وجودي وجود الكائنات وإنما","https://www.aldiwan.net/poem34615.html","الطويل"],[563,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"]],"verses":[["فَلا حَطَّ إِلّا بِهِم رَحلَهُ","وَلا جادَ إِلّا عَليهِم حَياهُ",0,"ا",2,0],["فَلا حَمَلَت أُمُّ المَكارِمِ بَعدَهُ","وَلا شَبَّ لِلمَجدِ التَليدِ رَضيعُ",1,"ع",1,0],["فُلُّ أَحداثٍ رَمى الدَهرُ بِهِم","فَهُمُ في رُقَعِ الدَهرِ نُقَط",2,"ط",1,0],["فَلا حَبَّذا بَلَدٌ بَعدَهُم","وَإِن أَوطَنوهُ فَيا حَبَّذا",3,"ذ",2,0],["فَلا حَظَّ في اِستِنزالِ رِزقٍ مُحَلَّقٍ","وَلا نَفعَ في حَثِّ الحُظوظِ الرَوائِثِ",4,"ث",1,0],["فَلاحَ لَها مِنْ جانِبِ الرّمْلِ مَرْتَعٌ","كأنّ الرّبيعَ الطَّلْقَ ألْبَسَهُ عَصْبا",5,"ب",2,0],["فلا حُمِلَتْ إلا إليْكَ مَدائِحٌ","ولا استُمْطِرَتْ إلاّ بِواديكَ أنْعُمُ",6,"م",1,0],["فَلا حُمِلَت رِجلاكَ عُشّاً لِبَيضَةٍ","وَلا زالَ عَظمٌ مِن جَناحِكَ واهِيا",7,"ي",2,0],["فِلاحَةُ مثْلي مَمْقوتَةٌ","وإنْ أعْجَبَ البَدْءُ مِنْها وَراقْ",8,"ق",1,1],["فِلاحَتُنا لَها القِدْحُ المُعَلّى","وسَرْحَتُها الضّمينَةُ للنّجاحِ",9,"ح",1,1],["فَلَأَحسِمَنَّ الحاسِدينَ بِمَدحَةٍ","لمُمَدَّحٍ نَحوَ الحِبا مُرتاحِ",10,"ح",1,0],["فَلا حَبراتُ العصبِ مِن نَسجِ حِميَرٍ","حَكَتها وَلا ما وَشَّعَ القبطُ في مِصرِ",11,"ر",1,0],["فلا حشد إلا ما تلاقى أحبةٌ","ولا شجو إلا ما شجا طائر يشدو",12,"د",2,0],["فَلاحَ كَالطَّيْفِ لَوْلا","هَزُّ النَّسِيمِ ثِيَابَهْ",13,"ب",2,0],["فَلاحَ بُرْقٌ خَاطِفٌ بَغْتَةً","وَانْشَقُّ سِتْرٌ عَنْ مِثَال مُقَامْ",14,"م",1,0],["فَلا حَسَبي يُقَصِّرُ في تَميمٍ","وَلا سَيفي يَكِلُّ وَلا لِساني",15,"ي",1,0],["فَلا حَمَلَت بَعدَ الفَرَزدَقِ حُرَّةٌ","وَلا ذاتُ حَملٍ مِن نَفاسٍ تَعَلَّتِ",16,"ت",1,1],["فَلا حَمَلَت بَعدَ اِبنِ لَيلى مَهيرَةٌ","وَلا شُدَّ أَنساعُ المَطِيِّ الرَواسِمِ",17,"م",1,0],["فلا حسود لشان قد بلغت فقد","عظمتَ عن حاسدٍ فيه وعن شاني",18,"ي",1,0],["فَلا حَمَلَت أُنثى وَلا آبَ غائِبٌ","وَلا وَلَدَت أُنثى إِذا ماتَ خالِدُ",19,"د",1,0],["فَلاحَ لي بَيتٌ فُؤادي لَهُ","دأباً عَلى وُدّك مَقصورُ",20,"ر",1,0],["فَلاحَ يُناغي النَجمَ صَرحٌ مُثَقَّبٌ","عَلى الماءِ قَد حاذاهُ صَرحٌ مُثقَبُ",21,"ب",1,0],["فَلا حَطَّت لَكَ الهَيجاءُ سَرجاً","وَلا ذاقَت لَكَ الدُنيا فِراقا",22,"ق",2,0],["فلا حيّا الإلهُ ديارَ بكرٍ","ولا روَّت مزارِعَها القِطارُ",23,"ر",1,0],["فلا حلّ لديه ولا مزاج","يرجّى والمصير إلى الفسادِ",24,"د",1,0],["فلاحَ رَوْضُ النَّسيمِ مُبتَسِماً","وفاضَ بَحْرُ السَّماحِ مُطِّرِدا",25,"د",2,0],["فلاحَ سَناهُ في زَمنٍ بَهيمٍ","وذابَ نَداه في سَنَةٍ جَمادِ",26,"د",1,0],["فلا حبَّ عندي أستلذُّ به الجوى","بما فيه من سقمٍ وما فيه من ضنك",27,"ك",1,0],["فَلا حَسَبٌ صَحيحٌ أَنتَ فيهِ","فَتُكثِرَهُم وَلا عَقلٌ صَحيحُ",28,"ح",1,0],["فَلا حَمَلَت أَزدِيَّةٌ بَعدَ مَوتِهِ","جَنيناً وَلا أَمَّلنَ سَيبَ الغَوادِقِ",29,"ق",1,0],["فَلاحَ وَمِيضُ البَرقِ في مُكفَهَّرةٍ","مِنَ المُزنِ لَمّا لاحَ فيها تَهَلَّلا",30,"ل",2,0],["فلا حيةٌ إلا لها منك قاتل","ولا أسدٌ إلا له منك آكل",31,"ل",1,0],["فلا حَمَلَتْ فُرسانَ حرْبٍ جِيادُهَا","إذا لم تَزُرْهُمْ من كُمَيتٍ وأدهَم",32,"م",1,0],["فلاحَ لها من وجهِهِ البدرُ طالعاً","وفي خَدّهِ الشِّعْرَى العَبورُ تَطَلَّع",33,"ع",1,0],["فلاحَظَ عَضْباً عن يمينكَ مُرْهَفاً","وطِرْفاً جَواداً عن يسارك مُسْرَجا",34,"ج",2,0],["فلا حَمَلتْ بِيضَ السيوفِ قوائِمٌ","ولا صَحِبَتْ سُمْرَ الرماحِ أنابيب",35,"ب",1,0],["فَلاحَت لَهُم مِنّا عَلى النَأيِ قَهوَةٌ","كَأَنَّ سَناها ضَوءُ نارٍ تُضَرَّمُ",36,"م",1,0],["فَلا حَيٌّ وَلا مَيتٌ","وَلَكِن مَوقِفُ الأَشعَر",37,"ر",1,0],["فلاحَ للنّاظِرِ في سَرْدِها","آثارُ داودَ ولم تَظْلِم",38,"م",1,0],["فلا حرم الشهيد بروض عدن","على بردى غبوقا واصطباحا",39,"ح",2,0],["فَلاَّحَةً جَثَمَتْ بِأَدْنَى مَوْقِعٍ","لِلظِّلِّ مِنْ الطَّرِيقِ اللاَّحِبِ",40,"ب",1,0],["فلاحت لعينيها خيالات عابر","يحثّ الخطى حينا وحينا يباطيء",41,"ي",2,0],["فَلاحَ بارق وادي الشَعب وَاِنتَبَهت","نوّام وَجدي وَفاحَ النِد وَالشيح",42,"ح",1,0],["فَلاحَت في الزُجاج كَبَرق ثَغر","تَبَسم إِذ بَكيتُ مِن الصُدود",43,"د",1,0],["فلاحظني بغوثك من زمان","به قد سامت الخف السنام",44,"م",1,0],["فلا حقائق ما أكننت خافية","عن الوشاة ولا دائي بمنحسم",45,"م",1,0],["فلا حاللٌ في الأمر ما هو عاقِدٌ","ولا فاتق في الأمر ما هو واقعُ",46,"ع",1,0],["فلا حاجةٌ إلا إليك مردُّها","ولا أمر نَبْغي منك إلا وينجحُ",47,"ح",1,0],["فلا حَطَّتِ الأقدار قدراً لكم ولا","ذكرناكم إلا بخير يُهَذَّبُ",48,"ب",1,0],["فلا حَطَّتِ الدنيا بناءً لكم ولا","فُقِدْتُم وإن طال المدى والتَّجنُّبُ",49,"ب",1,0],["فَلا حِبُهُ يُهدِي الحَيَارَى مَنَارُهُ","وَكَم لاحِبٍ لاَ يُهتَدَى بِمَنَارِهِ",50,"ر",2,0],["فلا حظَّ فيه سوى لمحةٍ","تُنافس فيها العيونَ القلوبُ",51,"ب",1,0],["فَلا حَلَّهُ مِن وَحشَةٍ ما اِستَفَزَّهُ","عَنِ الأَمنِ وَاِرتابَ النَزيلُ المُصاقِبُ",52,"ب",1,0],["فَلا حَظَّ فيها لامرىءٍ لا يُحِبُّهُ","وَمَن صَحَّ فيهِ حُبُّهُ فَهوَ حَسبُهُ",53,"ه",1,0],["فَلا حِسَّ مِن قَسٍّ وَلا خُبرَ عَن حَبرِ","هُوَ المُنتَقى وَالكُلُّ مِنهُم حُثالَةٌ",54,"ه",1,0],["فَلا حَمدَ إِلّا بِالَّذي يَفعَلُ الفَتى","وَلَو كَثُرَت في أَوَّليهِ المَحامِدُ",55,"د",1,0],["فلاحَ بها منها علىَّ تَغيُّرٌ","إذا ضبطتْهُ جَلَّ قَدْرا عن الضبط",56,"ط",1,0],["فلاحتْ لعيني من زواياهُ غادةٌ","هي البدرُ لكنْ أطلعتْهُ مغاربهْ",57,"ب",2,0],["فلا حمدت مسعاي آل مبارك","إذا لم أبت أعداء مصر على جمر",58,"ر",1,0],["فَلا حُزننا غَطّى عليه تَجلُّدٌ","وَلا حُسنُها غَطَّت عَلَيهِ البَراقِعُ",59,"ع",1,0],["فلاح لنا من غرة عربية","ضياء إلى الصبح المنير دليل",60,"ل",1,0],["فَلأَحلِفَنَّ يَمينَ حَقٍّ بَرَّةً","باللهِ ما أُعطيتُ بَعدَكَ سُولا",61,"ل",2,0],["فلاحونَ محترفونَ","مالَ النهرُ في بيت الحريق",62,"ق",1,0],["فلا حملت بطونُ الشرِّ نسلاً","ولا درَّ الحليبُ من الرغوث",63,"ث",1,0],["فلاحَ القَفرُ لي فيها وقيسٌ","يلاعبُ فيه أُمَّكِ أو أباك",64,"ك",1,0],["فلا حقَّ إِلا للقويِّ بمالهِ","فمن للضَّعيف الدائم الحَسرات",65,"ت",1,0],["فلا حمَلت حكمَ الأجانبِ أُمتي","ومنهم عليها سادةٌ رُقباء",66,"ا",2,0],["فلاحت خيرُ من لبست نطاقاً","وعلّت من زلالٍ كوثري",67,"ي",1,0],["فَلاح له من رفرف النور لائح","من النور للهادي البَشير بَشير",68,"ر",1,0],["فَلاحَظتك عيونٌ من رعايتهِ","يَغدو بها الماءُ ماساً قبل ترديدِ",69,"د",1,0],["فلاح بحكمتي نور الهدى في","ليالٍ للضلالة مدلهمه",70,"م",2,0],["فَلاحَظَ ما أَريدُ وَقالَ عِندي","جَميلَتَكُم بِهَذا الرَوضِ وَردُهُ",71,"د",2,0],["فَلاحٌ لي صُبحُ فَلاحي في دُجى الس","سَترِ بِنورِ وَجهِهِ قَبلَ السَحَر",72,"ر",1,0],["فلا حُيّيتِ من أيّامِ هَزْلٍ","يَرومُ بها بنو جِدٍّ مَراما",73,"م",2,0],["فلا حُرِمَ السَّناءَ بكَ المعالي","ولا خلَتِ المَمالكُ من سَناك",74,"ك",1,0],["فلا حَسائكَ في صَدري على أَحدٍ","منهم ولا لَهمُ في مَضْجَعي حَسَك",75,"ك",1,0],["فلا حَلّتِ الأحداتُ منك بساحَةٍ","ولا رَمتِ الأعداءَ إلا بساحِت",76,"ت",1,0],["فلاحظْ غداةَ الافتخارِ نصابَنا","أمن مثلِه للأعجَمين نَصيب",77,"ب",1,0],["فلا حَلَّتِ الأَيّامُ عَقدَ زِمامِهِ","وَلا سَلَبَتهُ الشَمسُ ظِلَّ رِواقِهِ",78,"ه",1,1],["فَلا حَديثي بِنوناتٍ تُعَظِّمُني","وَلا كِتابي إِلى قَومٍ بِمِن وَإِلى",79,"ل",2,0],["فلا حمداً ولا شكراً","ولا سَقياً ولا رَعيا",80,"ي",2,0],["فلا حرجٌ تشقى به النفس بينهم","وحاشاك إن أضحيت معهم تحرج",81,"ج",1,0],["فلا حزم إلّا في طروق تجارب","ولا حول إلّا في حلول مصائبِ",82,"ب",1,1],["فَلا حاسد إِلّا مَقَرٌّ بِسَبقِهِ","وَلا خُنصرٌ إِلا عَلى مَجدِهِ تَثَنى",83,"ن",2,0],["فلا حُبّ مَهْما لَمْ يبتْ وهْوَ في الْهوى","قَريحُ المآقي ذاهلُ القَلْب ذاهبُهْ",84,"ب",2,0],["فَلا حَبَّذا بَلَدٌ بَعدَهُم","وَإِن واصَلوهُ فَيا حَبَّذا",85,"ذ",2,0],["فلاحت عليه سطور الهنا","قرأنا السرور بعنوانها",86,"ن",3,0],["فلاح لنا قبل تقبيلها","سنا برقع من خدود لطيفه",87,"ف",2,0],["فلا حر من المستحل لك الجفا","عن سر توبته مع القداس",88,"س",1,0],["فلاحظْه بالإنعامِ لا توكلَنَّه","سفيرا يريك النصحَ وهو خئونُ",89,"ن",1,0],["فلا حافظٌ عهد من بان عنك","فيبكي ولا ناطقٌ يسألُ",90,"ل",1,0],["فلا حصَّن الناسُ من بعدها","مآلاً ولا ادخروا قطُّ مالا",91,"ل",2,0],["فلاحظوني على بعد المزار بما","يكون سِتراً على عوراته وغِطا",92,"ط",2,0],["فلا حُبَّ بل لاحظَّ نالك حظُّه","قد اشترك الأحبابُ والحظ في الصدِّ",93,"د",1,0],["فلا حَوَّلتْ عني ظِلالك خُطّةٌ","تَحُلُّ ولا محذورةٌ تُتَرقَّبُ",94,"ب",1,0],["فلا حمامٌ وبأسٌ منك مُصْطلمٌ","ولا غَمامٌ وكفَّاكَ الشآبيبُ",95,"ب",1,0],["فلا حباها الحسام طوقاً ولا","صيغ لها من دمٍ خلاخيل",96,"ل",1,0],["فَلا حُرِمنا هَديرا ًمِنكَ يُزْبِدُنا","ولا عَدِمنا نَميرا ًمنكَ يَسقينا",97,"ن",2,0],["فلا حملتنيَ الجُرْدُ المذاكي","يُثيرُ طِرادُها النقعَ المثارا",98,"ر",2,0],["فلاحت لهم شمس الوجود فأصبحوا","أسارى حيارى ما سرى غير حيران",99,"ن",1,0],["فلا حظني وقد أثبت وجداً","فأثر في الفؤاد بمقلتيه",100,"ه",1,0],["فلا حرُّ إلا وهو عبدٌ لجوده","ولا عبدُ إلا وهو في عدله حرُّ",101,"ر",1,0],["فَلاَ حَيّى الإلَهُ ذَواتَ قَوْمٍ","يُعادُونَ الصَّحِيحَ منَ الْبَيانِ",102,"ن",1,0],["فَلا حَمَلَتْ هوادِجَها الهوادي","ولا سَمِعَت تراجِيعَ الحدَاءِ",103,"ا",2,0],["فلا حفظ الله عهد الجفا","ولا حرس الله ذكر الرقيب",104,"ب",1,0],["فَلا حميمٌ لنا يُبقي الحِمامُ به","ولا جَديدٌ لنا يُبقي الجديدانِ",105,"ن",1,0],["فلا حان يومٌ منك فيه قطيعتي","ولا آن وقتٌ فيه منك صِرامي",106,"ي",1,0],["فلا حملتنا للجلادِ ضوامرٌ","ولا فرّقتنا من بلادٍ رواحلُ",107,"ل",1,0],["فلا حُدِيَت بكمْ أبداً ركابٌ","ولا رُفعتْ لكمْ أبداً سياطا",108,"ط",2,0],["فلا حرف إلا وهو فيه محقق","تضيء بشمس الذات منه غياهبه",109,"ب",2,0],["فلا حمد في ذا ولا ذاك لي","ولكن لك الحمد في ذا وذاكا",110,"ك",2,0],["فلاح بما في نفسه هو لم يزل","يصوّر من بيض هناك وسود",111,"د",1,0],["فَلا حَيَّ إِلّا وَهوَ أَصبَحَ مَأتَماً","تُداوَلُهُ أَشياخُهُ وَكَواعِبُه",112,"ب",2,0]]}