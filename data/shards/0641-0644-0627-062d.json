بَعدَهُ","وَلا شَبَّ لِلمَجدِ التَليدِ رَضيعُ",1,"ع",1,0],["فُلُّ أَحداثٍ رَمى الدَهرُ بِهِم","فَهُمُ في رُقَعِ الدَهرِ نُقَط",2,"ط",1,0],["فَلا حَبَّذا بَلَدٌ بَعدَهُم","وَإِن أَوطَنوهُ فَيا حَبَّذا",3,"ذ",2,0],["فَلا حَظَّ في اِستِنزالِ رِزقٍ مُحَلَّقٍ","وَلا نَفعَ في حَثِّ الحُظوظِ الرَوائِثِ",4,"ث",1,0],["فَلاحَ لَها مِنْ جانِبِ الرّمْلِ مَرْتَعٌ","كأنّ الرّبيعَ الطَّلْقَ ألْبَسَهُ عَصْبا",5,"ب",2,0],["فلا حُمِلَتْ إلا إليْكَ مَدائِحٌ","ولا استُمْطِرَتْ إلاّ بِواديكَ أنْعُمُ",6,"م",1,0],["فَلا حُمِلَت رِجلاكَ عُشّاً لِبَيضَةٍ","وَلا زالَ عَظمٌ مِن جَناحِكَ واهِيا",7,"ي",2,0],["فِلاحَةُ مثْلي مَمْقوتَةٌ","وإنْ أعْجَبَ البَدْءُ مِنْها وَراقْ",8,"ق",1,1],["فِلاحَتُنا لَها القِدْحُ المُعَلّى","وسَرْحَتُها الضّمينَةُ للنّجاحِ",9,"ح",1,1],["فَلَأَحسِمَنَّ الحاسِدينَ بِمَدحَةٍ","لمُمَدَّحٍ نَحوَ الحِبا مُرتاحِ",10,"ح",1,0],["فَلا حَبراتُ العصبِ مِن نَسجِ حِميَرٍ","حَكَتها وَلا ما وَشَّعَ القبطُ في مِصرِ",11,"ر",1,0],["فلا حشد إلا ما تلاقى أحبةٌ","ولا شجو إلا ما شجا طائر يشدو",12,"د",2,0],["فَلاحَ كَالطَّيْفِ لَوْلا","هَزُّ النَّسِيمِ ثِيَابَهْ",13,"ب",2,0],["فَلاحَ بُرْقٌ خَاطِفٌ بَغْتَةً","وَانْشَقُّ سِتْرٌ عَنْ مِثَال مُقَامْ",14,"م",1,0],["فَلا حَسَبي يُقَصِّرُ في تَميمٍ","وَلا سَيفي يَكِلُّ وَلا لِساني",15,"ن",2,0],["فَلا حَمَلَت بَعدَ الفَرَزدَقِ حُرَّةٌ","وَلا ذاتُ حَملٍ مِن نَفاسٍ تَعَلَّتِ",16,"ت",1,1],["فَلا حَمَلَت بَعدَ اِبنِ لَيلى مَهيرَةٌ","وَلا شُدَّ أَنساعُ المَطِيِّ الرَواسِمِ",17,"م",1,0],["فلا حسود لشان قد بلغت فقد","عظمتَ عن حاسدٍ فيه وعن شاني",18,"ن",2,0],["فَلا حَمَلَت أُنثى وَلا آبَ غائِبٌ","وَلا وَلَدَت أُنثى إِذا ماتَ خالِدُ",19,"د",1,0],["فَلاحَ لي بَيتٌ فُؤادي لَهُ","دأباً عَلى وُدّك مَقصورُ",20,"ر",1,0],["فَلاحَ يُناغي النَجمَ صَرحٌ مُثَقَّبٌ","عَلى الماءِ قَد حاذاهُ صَرحٌ مُثقَبُ",21,"ب",1,0],["فَلا حَطَّت لَكَ الهَيجاءُ سَرجاً","وَلا ذاقَت لَكَ الدُنيا فِراقا",22,"ق",2,0],["فلا حيّا الإلهُ ديارَ بكرٍ","ولا روَّت مزارِعَها القِطارُ",23,"ر",1,0],["فلا حلّ لديه ولا مزاج","يرجّى والمصير إلى الفسادِ",24,"د",1,0],["فلاحَ رَوْضُ النَّسيمِ مُبتَسِماً","وفاضَ بَحْرُ السَّماحِ مُطِّرِدا",25,"د",2,0],["فلاحَ سَناهُ في زَمنٍ بَهيمٍ","وذابَ نَداه في سَنَةٍ جَمادِ",26,"د",1,0],["فلا حبَّ عندي أستلذُّ به الجوى","بما فيه من سقمٍ وما فيه من ضنك",27,"ك",1,0],["فَلا حَسَبٌ صَحيحٌ أَنتَ فيهِ","فَتُكثِرَهُم وَلا عَقلٌ صَحيحُ",28,"ح",1,0],["فَلا حَمَلَت أَزدِيَّةٌ بَعدَ مَوتِهِ","جَنيناً وَلا أَمَّلنَ سَيبَ الغَوادِقِ",29,"ق",1,0],["فَلاحَ وَمِيضُ البَرقِ في مُكفَهَّرةٍ","مِنَ المُزنِ لَمّا لاحَ فيها تَهَلَّلا",30,"ل",2,0],["فلا حيةٌ إلا لها منك قاتل","ولا أسدٌ إلا له منك آكل",31,"ل",1,0],["فلا حَمَلَتْ فُرسانَ حرْبٍ جِيادُهَا","إذا لم تَزُرْهُمْ من كُمَيتٍ وأدهَم",32,"م",1,0],["فلاحَ لها من وجهِهِ البدرُ طالعاً","وفي خَدّهِ الشِّعْرَى العَبورُ تَطَلَّع",33,"ع",1,0],["فلاحَظَ عَضْباً عن يمينكَ مُرْهَفاً","وطِرْفاً جَواداً عن يسارك مُسْرَجا",34,"ج",2,0],["فلا حَمَلتْ بِيضَ السيوفِ قوائِمٌ","ولا صَحِبَتْ سُمْرَ الرماحِ أنابيب",35,"ب",1,0],["فَلاحَت لَهُم مِنّا عَلى النَأيِ قَهوَةٌ","كَأَنَّ سَناها ضَوءُ نارٍ تُضَرَّمُ",36,"م",1,0],["فَلا حَيٌّ وَلا مَيتٌ","وَلَكِن مَوقِفُ الأَشعَر",37,"ر",1,0],["فلاحَ للنّاظِرِ في سَرْدِها","آثارُ داودَ ولم تَظْلِم",38,"م",1,0],["فلا حرم الشهيد بروض عدن","على بردى غبوقا واصطباحا",39,"ح",2,0],["فَلاَّحَةً جَثَمَتْ بِأَدْنَى مَوْقِعٍ","لِلظِّلِّ مِنْ الطَّرِيقِ اللاَّحِبِ",40,"ب",1,0],["فلاحت لعينيها خيالات عابر","يحثّ الخطى حينا وحينا يباطيء",41,"ي",2,0],["فَلاحَ بارق وادي الشَعب وَاِنتَبَهت","نوّام وَجدي وَفاحَ النِد وَالشيح",42,"ح",1,0],["فَلاحَت في الزُجاج كَبَرق ثَغر","تَبَسم إِذ بَكيتُ مِن الصُدود",43,"د",1,0],["فلاحظني بغوثك من زمان","به قد سامت الخف السنام",44,"م",1,0],["فلا حقائق ما أكننت خافية","عن الوشاة ولا دائي بمنحسم",45,"م",1,0],["فلا حاللٌ في الأمر ما هو عاقِدٌ","ولا فاتق في الأمر ما هو واقعُ",46,"ع",1,0],["فلا حاجةٌ إلا إليك مردُّها","ولا أمر نَبْغي منك إلا وينجحُ",47,"ح",1,0],["فلا حَطَّتِ الأقدار قدراً لكم ولا","ذكرناكم إلا بخير يُهَذَّبُ",48,"ب",1,0],["فلا حَطَّتِ الدنيا بناءً لكم ولا","فُقِدْتُم وإن طال المدى والتَّجنُّبُ",49,"ب",1,0],["فَلا حِبُهُ يُهدِي الحَيَارَى مَنَارُهُ","وَكَم لاحِبٍ لاَ يُهتَدَى بِمَنَارِهِ",50,"ر",2,0],["فلا حظَّ فيه سوى لمحةٍ","تُنافس فيها العيونَ القلوبُ",51,"ب",1,0],["فَلا حَلَّهُ مِن وَحشَةٍ ما اِستَفَزَّهُ","عَنِ الأَمنِ وَاِرتابَ النَزيلُ المُصاقِبُ",52,"ب",1,0],["فَلا حَظَّ فيها لامرىءٍ لا يُحِبُّهُ","وَمَن صَحَّ فيهِ حُبُّهُ فَهوَ حَسبُهُ",53,"ه",1,0],["فَلا حِسَّ مِن قَسٍّ وَلا خُبرَ عَن حَبرِ","هُوَ المُنتَقى وَالكُلُّ مِنهُم حُثالَةٌ",54,"ه",1,0],["فَلا حَمدَ إِلّا بِالَّذي يَفعَلُ الفَتى","وَلَو كَثُرَت في أَوَّليهِ المَحامِدُ",55,"د",1,0],["فلاحَ بها منها علىَّ تَغيُّرٌ","إذا ضبطتْهُ جَلَّ قَدْرا عن الضبط",56,"ط",1,0],["فلاحتْ لعيني من زواياهُ غادةٌ","هي البدرُ لكنْ أطلعتْهُ مغاربهْ",57,"ب",2,0],["فلا حمدت مسعاي آل مبارك","إذا لم أبت أعداء مصر على جمر",58,"ر",1,0],["فَلا حُزننا غَطّى عليه تَجلُّدٌ","وَلا حُسنُها غَطَّت عَلَيهِ البَراقِعُ",59,"ع",1,0],["فلاح لنا من غرة عربية","ضياء إلى الصبح المنير دليل",60,"ل",1,0],["فَلأَحلِفَنَّ يَمينَ حَقٍّ بَرَّةً","باللهِ ما أُعطيتُ بَعدَكَ سُولا",61,"ل",2,0],["فلاحونَ محترفونَ","مالَ النهرُ في بيت الحريق",62,"ق",1,0],["فلا حملت بطونُ الشرِّ نسلاً","ولا درَّ الحليبُ من الرغوث",63,"ث",1,0],["فلاحَ القَفرُ لي فيها وقيسٌ","يلاعبُ فيه أُمَّكِ أو أباك",64,"ك",1,0],["فلا حقَّ إِلا للقويِّ بمالهِ","فمن للضَّعيف الدائم الحَسرات",65,"ت",1,0],["فلا حمَلت حكمَ الأجانبِ أُمتي","ومنهم عليها سادةٌ رُقباء",66,"ا",2,0],["فلاحت خيرُ من لبست نطاقاً","وعلّت من زلالٍ كوثري",67,"ي",1,0],["فَلاح له من رفرف النور لائح","من النور للهادي البَشير بَشير",68,"ر",1,0],["فَلاحَظتك عيونٌ من رعايتهِ","يَغدو بها الماءُ ماساً قبل ترديدِ",69,"د",1,0],["فلاح بحكمتي نور الهدى في","ليالٍ للضلالة مدلهمه",70,"م",2,0],["فَلاحَظَ ما أَريدُ وَقالَ عِندي","جَميلَتَكُم بِهَذا الرَوضِ وَردُهُ",71,"د",2,0],["فَلاحٌ لي صُبحُ فَلاحي في دُجى الس","سَترِ بِنورِ وَجهِهِ قَبلَ السَحَر",72,"ر",1,0],["فلا حُيّيتِ من أيّامِ هَزْلٍ","يَرومُ بها بنو جِدٍّ مَراما",73,"م",2,0],["فلا حُرِمَ السَّناءَ بكَ المعالي","ولا خلَتِ المَمالكُ من سَناك",74,"ك",1,0],["فلا حَسائكَ في صَدري على أَحدٍ","منهم ولا لَهمُ في مَضْجَعي 