html","الوافر"],[362,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[362,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[362,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[364,"فلا حلت الأيام عقد زمامه","https://www.aldiwan.net/poem17053.html","الطويل"],[364,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[374,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[374,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[374,"فلا حزم إلا في طروق تجارب","https://www.aldiwan.net/poem66922.html","الطويل"],[377,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[399,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[403,"ترى النازلين بأرض العراق","https://www.aldiwan.net/poem50179.html","المتقارب"],[413,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[438,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"],[441,"ما كان ذنبي يا أعز الناس","https://www.aldiwan.net/poem56049.html","عموديه"],[456,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[456,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[456,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[456,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[456,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[456,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[459,"أبا عمارة أن شطت منازلنا","https://www.aldiwan.net/poem15114.html","البسيط"],[462,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[463,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[475,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[511,"نظرت إليه نظرة مستهام","https://www.aldiwan.net/poem67771.html","الوافر"],[525,"غريب على الأيام وجدان مثله","https://www.aldiwan.net/poem45983.html","الطويل"],[527,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[527,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[536,"جرى الدمع في مقلتي إذ جرت","https://www.aldiwan.net/poem48278.html","عموديه"],[549,"كم ذا تطيش سهام الموت مخطئة","https://www.aldiwan.net/poem47169.html","البسيط"],[549,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[549,"أتاني والركبان يأتي نجيهم","https://www.aldiwan.net/poem47332.html","الطويل"],[549,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[556,"يخاطب كلا في المناجاة صاحبه","https://www.aldiwan.net/poem33525.html","الطويل"],[556,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"],[556,"وجودي وجود الكائنات وإنما","https://www.aldiwan.net/poem34615.html","الطويل"],[561,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"]],"verses":[["فَلا حَطَّ إِلّا بِهِم رَحلَهُ","وَلا جادَ إِلّا عَليهِم حَياهُ",0,"ا",2,0],["فَلا حَمَلَت أُمُّ المَكارِمِ بَعدَهُ","وَلا شَبَّ لِلمَجدِ التَليدِ رَضيعُ",1,"ع",1,0],["فُلُّ أَحداثٍ رَمى الدَهرُ بِهِم","فَهُمُ في رُقَعِ الدَهرِ نُقَط",2,"ط",1,0],["فَلا حَبَّذا بَلَدٌ بَعدَهُم","وَإِن أَوطَنوهُ فَيا حَبَّذا",3,"ذ",2,0],["فَلا حَظَّ في اِستِنزالِ رِزقٍ مُحَلَّقٍ","وَلا نَفعَ في حَثِّ الحُظوظِ الرَوائِثِ",4,"ث",1,0],["فَلاحَ لَها مِنْ جانِبِ الرّمْلِ مَرْتَعٌ","كأنّ الرّبيعَ الطَّلْقَ ألْبَسَهُ عَصْبا",5,"ب",2,0],["فلا حُمِلَتْ إلا إليْكَ مَدائِحٌ","ولا استُمْطِرَتْ إلاّ بِواديكَ أنْعُمُ",6,"م",1,0],["فَلا حُمِلَت رِجلاكَ عُشّاً لِبَيضَةٍ","وَلا زالَ عَظمٌ مِن جَناحِكَ واهِيا",7,"ي",2,0],["فِلاحَةُ مثْلي مَمْقوتَةٌ","وإنْ أعْجَبَ البَدْءُ مِنْها وَراقْ",8,"ق",1,1],["فِلاحَتُنا لَها القِدْحُ المُعَلّى","وسَرْحَتُها الضّمينَةُ للنّجاحِ",9,"ح",1,1],["فَلَأَحسِمَنَّ الحاسِدينَ بِمَدحَةٍ","لمُمَدَّحٍ نَحوَ الحِبا مُرتاحِ",10,"ح",1,0],["فَلا حَبراتُ العصبِ مِن نَسجِ حِميَرٍ","حَكَتها وَلا ما وَشَّعَ القبطُ في مِصرِ",11,"ر",1,0],["فلا حشد إلا ما تلاقى أحبةٌ","ولا شجو إلا ما شجا طائر يشدو",12,"د",2,0],["فَلاحَ كَالطَّيْفِ لَوْلا","هَزُّ النَّسِيمِ ثِيَابَهْ",13,"ب",2,0],["فَلاحَ بُرْقٌ خَاطِفٌ بَغْتَةً","وَانْشَقُّ سِتْرٌ عَنْ مِثَال مُقَامْ",14,"م",1,0],["فَلا حَسَبي يُقَصِّرُ في تَميمٍ","وَلا سَيفي يَكِلُّ وَلا لِساني",15,"ي",1,0],["فَلا حَمَلَت بَعدَ الفَرَزدَقِ حُرَّةٌ","وَلا ذاتُ حَملٍ مِن نَفاسٍ تَعَلَّتِ",16,"ت",1,1],["فَلا حَمَلَت بَعدَ اِبنِ لَيلى مَهيرَةٌ","وَلا شُدَّ أَنساعُ المَطِيِّ الرَواسِمِ",17,"م",1,0],["فلا حسود لشان قد بلغت فقد","عظمتَ عن حاسدٍ فيه وعن شاني",18,"ي",1,0],["فَلا حَمَلَت أُنثى وَلا آبَ غائِبٌ","وَلا وَلَدَت أُنثى إِذا ماتَ خالِدُ",19,"د",1,0],["فَلاحَ لي بَيتٌ فُؤادي لَهُ","دأباً عَلى وُدّك مَقصورُ",20,"ر",1,0],["فَلاحَ يُناغي النَجمَ صَرحٌ مُثَقَّبٌ","عَلى الماءِ قَد حاذاهُ صَرحٌ مُثقَبُ",21,"ب",1,0],["فَلا حَطَّت لَكَ الهَيجاءُ سَرجاً","وَلا ذاقَت لَكَ الدُنيا فِراقا",22,"ق",2,0],["فلا حيّا الإلهُ ديارَ بكرٍ","ولا روَّت مزارِعَها القِطارُ",23,"ر",1,0],["فلا حلّ لديه ولا مزاج","يرجّى والمصير إلى الفسادِ",24,"د",1,0],["فلاحَ رَوْضُ النَّسيمِ مُبتَسِماً","وفاضَ بَحْرُ السَّماحِ مُطِّرِدا",25,"د",2,0],["فلاحَ سَناهُ في زَمنٍ بَهيمٍ","وذابَ نَداه في سَنَةٍ جَمادِ",26,"د",1,0],["فلا حبَّ عندي أستلذُّ به الجوى","بما فيه من سقمٍ وما فيه من ضنك",27,"ك",1,0],["فَلا حَسَبٌ صَحيحٌ أَنتَ فيهِ","فَتُكثِرَهُم وَلا عَقلٌ صَحيحُ",28,"ح",1,0],["فَلا حَمَلَت أَزدِيَّةٌ بَعدَ مَوتِهِ","جَنيناً وَلا أَمَّلنَ سَيبَ الغَوادِقِ",29,"ق",1,0],["فَلاحَ وَمِيضُ البَرقِ في مُكفَهَّرةٍ","مِنَ المُزنِ لَمّا لاحَ فيها تَهَلَّلا",30,"ل",2,0],["فلا حيةٌ إلا لها منك قاتل","ولا أسدٌ إلا له منك آكل",31,"ل",1,0],["فلا حَمَلَتْ فُرسانَ حرْبٍ جِيادُهَا","إذا لم تَزُرْهُمْ من كُمَيتٍ وأدهَم",32,"م",1,0],["فلاحَ لها من وجهِهِ البدرُ طالعاً","وفي خَدّهِ الشِّعْرَى العَبورُ تَطَلَّع",33,"ع",1,0],["فلاحَظَ عَضْباً عن يمينكَ مُرْهَفاً","وطِرْفاً جَواداً عن يسارك مُسْرَجا",34,"ج",2,0],["فلا حَمَلتْ بِيضَ السيوفِ قوائِمٌ","ولا صَحِبَتْ سُمْرَ الرماحِ أنابيب",35,"ب",1,0],["فَلاحَت لَهُم مِنّا عَلى النَأيِ قَهوَةٌ","كَأَنَّ سَناها ضَوءُ نارٍ تُضَرَّمُ",36,"م",1,0],["فَلا حَيٌّ وَلا مَيتٌ","وَلَكِن مَوقِفُ الأَشعَر",37,"ر",1,0],["فلاحَ للنّاظِرِ في سَرْدِها","آثارُ داودَ ولم تَظْلِم",38,"م",1,0],["فَلاَّحَةً جَثَمَتْ بِأَدْنَى مَوْقِعٍ","لِلظِّلِّ مِنْ الطَّرِيقِ اللاَّحِبِ",39,"ب",1,0],["فَلاحَ بارق وادي الشَعب وَاِنتَبَهت","نوّام وَجدي وَفاحَ النِد وَالشيح",40,"ح",1,0],["فَلاحَت في الزُجاج كَبَرق ثَغر","تَبَسم إِذ بَكيتُ مِن الصُدود",41,"د",1,0],["فلاحظني بغوثك من زمان","به قد سامت الخف السنام",42,"م",1,0],["فلا حقائق ما أكننت خافية","عن الوشاة ولا دائي بمنحسم",43,"م",1,0],["فلا حاللٌ في الأمر ما هو عاقِدٌ","ولا فاتق في الأمر ما هو واقعُ",44,"ع",1,0],["فلا حاجةٌ إلا إليك مردُّها","ولا أمر نَبْغي منك إلا وينجحُ",45,"ح",1,0],["فلا حَطَّتِ الأقدار قدراً لكم ولا","ذكرناكم إلا بخير يُهَذَّبُ",46,"ب",1,0],["فلا حَطَّتِ الدنيا بناءً لكم ولا","فُقِدْتُم وإن طال المدى والتَّجنُّبُ",47,"ب",1,0],["فَلا حِبُهُ يُهدِي الحَيَارَى مَنَارُهُ","وَكَم لاحِبٍ لاَ يُهتَدَى بِمَنَارِهِ",48,"ر",2,0],["فلا حظَّ فيه سوى لمحةٍ","تُنافس فيها العيونَ القلوبُ",49,"ب",1,0],["فَلا حَلَّهُ مِن وَحشَةٍ ما اِستَفَزَّهُ","عَنِ الأَمنِ وَاِرتابَ النَزيلُ المُصاقِبُ",50,"ب",1,0],["فَلا حَظَّ فيها لامرىءٍ لا يُحِبُّهُ","وَمَن صَحَّ فيهِ حُبُّهُ فَهوَ حَسبُهُ",51,"ه",1,0],["فَلا حِسَّ مِن قَسٍّ وَلا خُبرَ عَن حَبرِ","هُوَ المُنتَقى وَالكُلُّ مِنهُم حُثالَةٌ",52,"ه",1,0],["فَلا حَمدَ إِلّا بِالَّذي يَفعَلُ الفَتى","وَلَو كَثُرَت في أَوَّليهِ المَحامِدُ",53,"د",1,0],["فلاحَ بها منها علىَّ تَغيُّرٌ","إذا ضبطتْهُ جَلَّ قَدْرا عن الضبط",54,"ط",1,0],["فلاحتْ لعيني من زواياهُ غادةٌ","هي البدرُ لكنْ أطلعتْهُ مغاربهْ",55,"ب",2,0],["فلا حمدت مسعاي آل مبارك","إذا لم أبت أعداء مصر على جمر",56,"ر",1,0],["فَلا حُزننا غَطّى عليه تَجلُّدٌ","وَلا حُسنُها غَطَّت عَلَيهِ البَراقِعُ",57,"ع",1,0],["فلاح لنا من غرة عربية","ضياء إلى الصبح المنير دليل",58,"ل",1,0],["فَلأَحلِفَنَّ يَمينَ حَقٍّ بَرَّةً","باللهِ ما أُعطيتُ بَعدَكَ سُولا",59,"ل",2,0],["فلاحونَ محترفونَ","مالَ النهرُ في بيت الحريق",60,"ق",1,0],["فلا حملت بطونُ الشرِّ نسلاً","ولا درَّ الحليبُ من الرغوث",61,"ث",1,0],["فلاحَ القَفرُ لي فيها وقيسٌ","يلاعبُ فيه أُمَّكِ أو أباك",62,"ك",1,0],["فلا حقَّ إِلا للقويِّ بمالهِ","فمن للضَّعيف الدائم الحَسرات",63,"ت",1,0],["فلا حمَلت حكمَ الأجانبِ أُمتي","ومنهم عليها سادةٌ رُقباء",64,"ا",2,0],["فلاحت خيرُ من لبست نطاقاً","وعلّت من زلالٍ كوثري",65,"ي",1,0],["فَلاح له من رفرف النور لائح","من النور للهادي البَشير بَشير",66,"ر",1,0],["فَلاحَظتك عيونٌ من رعايتهِ","يَغدو بها الماءُ ماساً قبل ترديدِ",67,"د",1,0],["فلاح بحكمتي نور الهدى في","ليالٍ للضلالة مدلهمه",68,"م",2,0],["فَلاحَظَ ما أَريدُ وَقالَ عِندي","جَميلَتَكُم بِهَذا الرَوضِ وَردُهُ",69,"د",2,0],["فَلاحٌ لي صُبحُ فَلاحي في دُجى الس","سَترِ بِنورِ وَجهِهِ قَبلَ السَحَر",70,"ر",1,0],["فلا حُيّيتِ من أيّامِ هَزْلٍ","يَرومُ بها بنو جِدٍّ مَراما",71,"م",2,0],["فلا حُرِمَ السَّناءَ بكَ المعالي","ولا خلَتِ المَمالكُ من سَناك",72,"ك",1,0],["فلا حَسائكَ في صَدري على أَحدٍ","منهم ولا لَهمُ في مَضْجَعي حَسَك",73,"ك",1,0],["فلا حَلّتِ الأحداتُ منك بساحَةٍ","ولا رَمتِ الأعداءَ إلا بساحِت",74,"ت",1,0],["فلاحظْ غداةَ الافتخارِ نصابَنا","أمن مثلِه للأعجَمين نَصيب",75,"ب",1,0],["فلا حَلَّتِ الأَيّامُ عَقدَ زِمامِهِ","وَلا سَلَبَتهُ الشَمسُ ظِلَّ رِواقِهِ",76,"ه",1,1],["فَلا حَديثي بِنوناتٍ تُعَظِّمُني","وَلا كِتابي إِلى قَومٍ بِمِن وَإِلى",77,"ل",2,0],["فلا حمداً ولا شكراً","ولا سَقياً ولا رَعيا",78,"ي",2,0],["فلا حرجٌ تشقى به النفس بينهم","وحاشاك إن أضحيت معهم تحرج",79,"ج",1,0],["فلا حزم إلّا في طروق تجارب","ولا حول إلّا في حلول مصائبِ",80,"ب",1,1],["فَلا حاسد إِلّا مَقَرٌّ بِسَبقِهِ","وَلا خُنصرٌ إِلا عَلى مَجدِهِ تَثَنى",81,"ن",2,0],["فلا حُبّ مَهْما لَمْ يبتْ وهْوَ في الْهوى","قَريحُ المآقي ذاهلُ القَلْب ذاهبُهْ",82,"ب",2,0],["فَلا حَبَّذا بَلَدٌ بَعدَهُم","وَإِن واصَلوهُ فَيا حَبَّذا",83,"ذ",2,0],["فلاحت عليه سطور الهنا","قرأنا السرور بعنوانها",84,"ن",3,0],["فلاح لنا قبل تقبيلها","سنا برقع من خدود لطيفه",85,"ف",2,0],["فلا حر من المستحل لك الجفا","عن سر توبته مع القداس",86,"س",1,0],["فلاحظْه بالإنعامِ لا توكلَنَّه","سفيرا يريك النصحَ وهو خئونُ",87,"ن",1,0],["فلا حافظٌ عهد من بان عنك","فيبكي ولا ناطقٌ يسألُ",88,"ل",1,0],["فلا حصَّن الناسُ من بعدها","مآلاً ولا ادخروا قطُّ مالا",89,"ل",2,0],["فلاحظوني على بعد المزار بما","يكون سِتراً على عوراته وغِطا",90,"ط",2,0],["فلا حُبَّ بل لاحظَّ نالك حظُّه","قد اشترك الأحبابُ والحظ في الصدِّ",91,"د",1,0],["فلا حَوَّلتْ عني ظِلالك خُطّةٌ","تَحُلُّ ولا محذورةٌ تُتَرقَّبُ",92,"ب",1,0],["فلا حمامٌ وبأسٌ منك مُصْطلمٌ","ولا غَمامٌ وكفَّاكَ الشآبيبُ",93,"ب",1,0],["فلا حباها الحسام طوقاً ولا","صيغ لها من دمٍ خلاخيل",94,"ل",1,0],["فَلا حُرِمنا هَديرا ًمِنكَ يُزْبِدُنا","ولا عَدِمنا نَميرا ًمنكَ يَسقينا",95,"ن",2,0],["فلا حملتنيَ الجُرْدُ المذاكي","يُثيرُ طِرادُها النقعَ المثارا",96,"ر",2,0],["فلاحت لهم شمس الوجود فأصبحوا","أسارى حيارى ما سرى غير حيران",97,"ن",1,0],["فلا حظني وقد أثبت وجداً","فأثر في الفؤاد بمقلتيه",98,"ه",1,0],["فلا حرُّ إلا وهو عبدٌ لجوده","ولا عبدُ إلا وهو في عدله حرُّ",99,"ر",1,0],["فَلاَ حَيّى الإلَهُ ذَواتَ قَوْمٍ","يُعادُونَ الصَّحِيحَ منَ الْبَيانِ",100,"ن",1,0],["فَلا حَمَلَتْ هوادِجَها الهوادي","ولا سَمِعَت تراجِيعَ الحدَاءِ",101,"ا",2,0],["فلا حفظ الله عهد الجفا","ولا حرس الله ذكر الرقيب",102,"ب",1,0],["فَلا حميمٌ لنا يُبقي الحِمامُ به","ولا جَديدٌ لنا يُبقي الجديدانِ",103,"ن",1,0],["فلا حان يومٌ منك فيه قطيعتي","ولا آن وقتٌ فيه منك صِرامي",104,"ي",1,0],["فلا حملتنا للجلادِ ضوامرٌ","ولا فرّقتنا من بلادٍ رواحلُ",105,"ل",1,0],["فلا حُدِيَت بكمْ أبداً ركابٌ","ولا رُفعتْ لكمْ أبداً سياطا",106,"ط",2,0],["فلا حرف إلا وهو فيه محقق","تضيء بشمس الذات منه غياهبه",107,"ب",2,0],["فلا حمد في ذا ولا ذاك لي","ولكن لك الحمد في ذا وذاكا",108,"ك",2,0],["فلاح بما في نفسه هو لم يزل","يصوّر من بيض هناك وسود",109,"د",1,0],["فَلا حَيَّ إِلّا وَهوَ أَصبَحَ مَأتَماً","تُداوَلُهُ أَشياخُهُ وَكَواعِبُه",110,"ب",2,0]]}