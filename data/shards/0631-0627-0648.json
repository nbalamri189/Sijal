يت رجالا ناكسين رؤوسهم","https://www.aldiwan.net/poem44379.html","الطويل"],[364,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[369,"صددت ولي في الناس أهل وجيران","https://www.aldiwan.net/poem57015.html","البسيط"],[369,"والناس لم يعرفوا لي ما خصصت به","https://www.aldiwan.net/poem57095.html","البسيط"],[402,"رأوا بزتي فقضوا أنني","https://www.aldiwan.net/poem49437.html","المتقارب"],[403,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[407,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[413,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[426,"راو لمية بالقمراء دانية","https://www.aldiwan.net/poem40285.html","البسيط"],[429,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[429,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[434,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[436,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[438,"أيا قاطع الحبل الذي إن قطعته","https://www.aldiwan.net/poem14468.html","الطويل"],[456,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[456,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[456,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[456,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[456,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[456,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[462,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[477,"انظر على جبل المنار غزالا","https://www.aldiwan.net/poem37065.html","الكامل"],[477,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[498,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[498,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[502,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[512,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[535,"ألم تسل الفوارس من سليم","https://www.aldiwan.net/poem69398.html","الوافر"],[549,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[556,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[556,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[561,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[562,"عن العادات لا تنبو الطباع","https://www.aldiwan.net/poem863.html",""],[584,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem17639.html","الطويل"]],"verses":[["رَأوا فَترَةً مِنّا فَظَنّوا ضَراعَةً","وَتِلكَ بُروقٌ غَرَّهُم شَوَلانُها",0,"ن",3,0],["رَأَوا مَقامَكَ فَاِزوَرَّت عُيونُهُمُ","ما كُلُّ لَحظٍ إِلى الآماقِ مِن قَبَلِ",1,"ل",1,0],["رَأوا نَقعَها يَدنو فَظَنّوا غَمامَةً","فَما شَعَروا حَتّى بَدَت جَبَهاتُها",2,"ت",3,0],["رَأَوا طَرابُلسَ تَبدو","لَهُم بِكُلِّ مَكانِ",3,"ن",1,0],["رَأَوا في قُبورِ المَيِّتينَ حَياتَهُم","فَقاموا إِلى تِلكَ القُبورِ وَطَوَّفوا",4,"ف",3,0],["رَأَوْا بِهِ المَثَلَ الأَعْلَى بِأَبْعَدِ مَا","سَمَتْ إِلَى شَأْوِهِ الأَبْطَالُ وَالبُهَمُ",5,"م",1,0],["رَأَوا عَورَةً فَاِستَقبَلوها بِأَلبِهِم","فَلَم يَنهَهُم حِلمٌ وَلَم يَتَحَرَّجوا",6,"ج",3,0],["رَأوا عَبدَ العَزيزِ وَلِيَّ عَهدٍ","وَما ظَلَموا بِذاكَ وَلا أَساؤوا",7,"ا",1,0],["رَأَوا أَنَّ صِهرَ القَومِ عارٌ عَلَيهِمُ","وَأَنَّ لِبِسطامٍ عَلى غالِبٍ فَضلا",8,"ل",2,0],["رَأوا قُعسَ الظُهورِ بَناتِ تَيمٍ","تَكَشَّفُ عَن عَلاهِبَةٍ رُعولِ",9,"ل",1,0],["رَأوا أَثبِيَةَ الفَهَداتِ وِرداً","فَما عَرَفوا الأَغَرَّ مِنَ البَهيمِ",10,"م",1,0],["رأوا أني إلى الأجداثِ ماض","فقالوا كلّ ماضٍ لا يعاد",11,"د",1,0],["رَأَوا ثَغراً تُحيطُ بِهِ المَنايا","وَأَكبَدَ ما تُغَيِّرُهُ الغِيارُ",12,"ر",1,0],["راوَدَني النَومُ وَما بَرِحا","حَتّى طَأطَأتُ لَهُ راسي",13,"ي",1,1],["رَأَوكِ فَقالوا البَدرُ وَالغُصنُ وَالنَقا","وَلا شَكَّ أَنَّ القَومَ ما عَرَفوكِ",14,"ك",1,0],["رأونا قبل ما رأوا النهارا","فهبوا من مراقدهم حيارى",15,"ا",1,0],["رَأَوا بِالأَمسِ أَنفَكَ في الثُرَيّا","فَكَيفَ اليَومَ أَصبَحَ في الرِغامِ",16,"م",1,0],["رَأَوا إِرثاً سَيَذهَبُ بَعدَ حينٍ","فَكانوا عُصبَةً في الاِقتِسامِ",16,"م",1,0],["رَأَوكَ لَمّا بَلَوكَ نابِتَةً","يَأكُلُها قَبلَ أَهلِهِ الرائِد",17,"د",1,0],["رأوا عندَهُ حُسْنَ القَبولِ فأقدَموا","ولو لم يرَوْا حسنَ القبولِ لخاموا",18,"م",3,0],["رأوكَ ولا في ساعدِ البأس سطوةٌ","عليهم ولا في صفحةِ العفوِ تقطيبُ",19,"ب",1,0],["رَأَو فيلاً يُعادِلَهُ ذُبابٌ","وَكَيفَ يُعادِلُ الفيلُ الذُبابا",20,"ب",2,0],["رَأَوكَ أَندى الوَرى كَفّاً وَأَمنَعَهُم","كَهفاً وَأَوطَأَهُم لِلمُعتَفي كَنَفا",21,"ف",2,0],["رَأَوا شَمسَهُم في يَومِهِم وَهيَ ظُلمَةٌ","وَبَدرُهُمُ في لَيلِهِم وَهوَ آفِلُ",22,"ل",1,0],["رَأَوا رِفعَةَ الآباءِ أَعيا مَرامُها","فَكَرّوا مُريغي رِفعَةٍ بِالحَلائِلِ",23,"ل",1,0],["رَأَوكَ حِرزاً لَهُم مِن كُلِّ بائِقَةٍ","وَعِصمَةً فيهِمِ مِن أَوثَقِ العِصَمِ",24,"م",1,0],["راوَحتُهُم راحاً كَأَنَّ شُعاعَها","وَوُجوهَهُم بَرقانِ يَأتَلِقانِ",25,"ن",1,0],["رَأَوا أَنّا أَحَقُّ بِآلِ سَعدٍ","وَأَنَّ لَنا الحَناظِلَ وَالرِبابا",26,"ب",2,0],["رَأوا لَكَ غُرَّةً فَضَلَت عَلَيهِم","مِنَ الأَحسابِ وَالعَدَدِ الكُثارا",27,"ر",2,0],["رَأَوا جِبرِئيلَ فيهِمُ إِذ لَقوهُمُ","وَأَمثالَهُ مِن ذي جَناحَينِ أَظهَرا",28,"ر",2,0],["رَأَوا أَنَّهُ مَن فَرَّ مِن زَحفِ مِثلِهِم","يَكُن حَطَباً لِلنارِ فيمَن تَكَبَّرا",29,"ر",2,0],["رَأَوني فَنادَوني أَسوقُ مَطِيَّتي","بِأَصواتِ هُلّاكٍ سِغابٍ حَرائِرُه",30,"ر",2,0],["رَأَونا فَوقَهُم وَلنا عَلَيهِم","صَلاةُ الرافِعينَ مَعَ المُغيرِ",31,"ر",1,0],["رَأَوا حاجِباً أَغلى فِداءً وَقَومَهُ","أَحَقَّ بِأَيّامِ العُلى وَالمَكارِمِ",32,"م",1,0],["رَأَونا أَحَقَّ اِبنَي نِزارٍ وَغَيرِهِم","بِإِصلاحِ صَدعٍ بَينَهُم مُتَفاقِمِ",33,"م",1,0],["رَأَوا جَبَلاً دَقَّ الجِبالَ إِذا اِلتَقَت","رُؤوسُ كَبيرَيهِنَّ يَنتَطِحانِ",34,"ن",1,0],["رَأوا رياضَ النَّدى مُدَّبَجةً","فدبَّجُوا في فَنائِها الكَلِما",35,"م",2,0],["رَأَوا لَبَثاً مِنّا عَلَيهِ اِستَقاؤُنا","وَرِيُّ مَطايانا بِهِ أَن تُغَمَّرا",36,"ر",2,0],["رَأوكَ لِلسَعيِ بِهِ سامِعاً","فَلُفِّقَت عَنهُ الأَكاذيبُ",37,"ب",1,0],["رَأَوا تَحَيُّرَ فِكري في صِفاتِكُمُ","فَأَوسَعوا القَولَ إِذ ضاقَت بِيَ الحِيَلُ",38,"ل",1,0],["رَأوني أُراعي مِنكُمُ العَهدَ لي بِكُم","وَأَحسَنَ ظَنّاً مِنكُمُ بي بِكُم ظَنّي",39,"ي",1,0],["رأوا بأبي إسحقَ سَحْقاً لجمعهم","فإبْرَامُهُمْ نَقْضٌ ونظمهم نَثرُ",40,"ر",1,0],["رَأَوا حَربِيَةً تَرمي بِنِفطٍ","لإخمادِ النفوسِ له استعارُ",41,"ر",1,0],["رَأَوني حَيثُ كُنتُ لَهُم عَدُوّاً","وَأَنتَ لَهُم شَريكٌ في الصِناعَه",42,"ع",2,0],["رَأَوا طُرُقاتِ العَجزِ عوجاً قَطيعَةً","وَأَقطَعُ عَجزٍ عِندَهُم عَجزُ حازِمِ",43,"م",1,0],["رَأَوا مِنهُ لَيثاً فَاِبذَعَرَّت حُماتُهُم","وَقَد حَكَمَت فيهِ حُماةُ العَوامِلِ",44,"ل",1,0],["رَأَوا لَيثَ الغَريفَةِ وَهوَ مُلقٍ","ذِراعَيهِ جَميعاً بِالوَصيدِ",45,"د",1,0],["رأَوْني مأخوذاً غريباً فأقبلوا","يقولون لا تهلِكُ أسىً وتجلَّدِ",46,"د",1,0],["رأوا شاعراً ما عز كسرى كعزه","ولا مجد ذي القرنين إذ يرفع السدا",47,"د",2,0],["رَأَوْا بُرهانَ شاعرِهم فزاغوا","وللأحداثِ شاعِرُها المُجيدُ",48,"د",1,0],["رَأَوْا أن يُطفِئوا ناراً بنارٍ","فَهلْ بِرَدَتْ قلوبُ الحاقدينا",49,"ن",2,0],["رأوا عزماً يَطُمُّ على العوادي","ويَغمرُ حِدَّةَ المُتمرِّدينا",49,"ن",2,0],["رأوها نكبةً هَوْجاءَ تأتِي","زَلازِلُها على المُستسلِمينا",49,"ن",2,0],["رأوا ناراً يَطيرُ لها شُواظٌ","تطيرُ له نُفوسُ المُوقِدينا",49,"ن",2,0],["رَأَوا حُمَمَ الأَفواهِ يَرمي بِها الأَسى","فَصاغوا لَها سَدّاً مِنَ النارِ مُحكَما",50,"م",2,0],["رَأونا دُونَهُم عَدداً فَنادوا","عَلَينا بِالنزالِ وَبِالصِدامِ",51,"م",1,0],["رأوا سوءَ عُقباهم فأقبلَ وفدُهم","وضَجَّ الأسارى إنّنا مسَّنا الضُرُّ",52,"ر",1,0],["رَأوها بعد ما هجعوا بلَيْلٍ","لها فِيهم وللقدرِ انْصلاتُ",53,"ت",1,0],["رأَوْا مَورداً عذباً فألقوا بأنفسٍ","ظِماءٍ بها من وَقدَةِ اللُّوحِ لافحُ",54,"ح",1,0],["رأوكَ تَؤُمُّهُمْ فرداً فقالوا","أخٌ في اللَّهِ يخشى اللَّهَ جُهْدَهْ",55,"د",2,0],["رَأَوْا عَجباً من عَتادِ الحروب","تَذوق الحصونُ به ما تَذُوقْ",56,"ق",1,0],["رأوْها مُطَهَّمَةً في السّلاح","فطاروا يقولونَ أمرٌ قُدِرْ",57,"ر",1,0],["رَأونا آخِذينَ بِكُلِّ فَجٍّ","بِمُشعَلَةٍ تُوَقَّدُ بِالرِماحِ",58,"ح",1,0],["رأوا سُرجاً ثم لم يعلموا","أهِنْديّةٌ قُضُبٌ أمْ لظَى",59,"ا",1,0],["راوَدتُهُ عَن نَفسِهِ خالِياً","فَقالَ يَلقانِيَ بِالرَدِّ",60,"د",1,0],["رَأَوا آيةً خَلفَها سائِقٌ","يَحُثُّ وَإِن هَروَلَت هَروَلا",61,"ل",2,0],["رَأونا وَالحِمامَ مَعاً فَأجلَوا","كَما أَجلَت عَنِ الأُسدِ الوِبارُ",62,"ر",1,0],["رَأوا مُتَسَتِّراً عَنهُم بِسُدٍّ","لِيَأجوجَ كَمُستَتِرٍ بِشَفِّ",63,"ف",1,0],["رَاوِياً للحَديثِ لم يُحْوِجِ المَعْ","رُوفَ مِنْ صِدْقِهِ إلى الأسْنادِ",64,"د",1,0],["رأوْك بالعَينِ فاسْتَغْوَتْهُمُ ظِنَنٌ","ولم يَرَوْكَ بفِكْرٍ صادِقِ الخَبَرِ",65,"ر",1,0],["رَأَوْا أَنْ يَسُوسُوا النَّاسَ قَهْرَاً فَأَسْرَعُوا","إِلَى نَقْضِ مَا شَادَتْهُ أَيْدِي الْوَثَائِقِ",66,"ق",1,0],["رَأَوُا الذئَابَ فَحَاوَلُوا","أَنْ يَدْرَأُوهَا بِالحِكَمْ",67,"م",1,0],["رَاوٍ رَطِيبِ الظَّلِّ مَوْفُورِ الجَنى","ذَاكِي النَّوَاحِي بِالأَرِيجِ العَابِقِ",68,"ق",1,0],["رَأَوكَ ضَئيلَ الشَخصِ وَاِستَعظَموا السنى","وَلا عَجَبٌ إِنَّ الهِلالَ ضَئيلُ",69,"ل",1,0],["رَأوْكَ فعَالَوْا بالهُتَافِ كأنّمَا","يُنَافِسُ نِدُّ نِدَّهُ ويُسَاجِلُهْ",70,"ل",2,0],["رأوْا بعيون يعكس الضوء لحظها","كأنَّ على تلك العيونِ غواشيا",71,"ي",2,0],["رأوا في الرافدين ثرىً خصيباً","يروقُ العين فانتشروا جرادا",72,"د",2,0],["رأوا حسنَ العراق فأعجبتهمْ","اباطحُ من ، ربيع فيه ، خُضْر",73,"ر",1,0],["رَأوا شرَ لو أطاقوا تحملاً","ولكنه لم يَبْقَ حتى التحّمل",74,"ل",1,0],["رأوا فيك مخضر الأماني فعرسّوا","بجنحك ا شاء الغرام وناحوا",75,"ح",3,0],["رأَوْا رفْعَةَ الآباءِ أَعْيَ مَرَامُها","فَكَرُّوا مُرِيغِي رِفْعَةٍ بالحلاَئَلِ",76,"ل",1,0],["رأوا فيلا يعادله ذباب","وكيف يعادل الفيل الذبابا",77,"ب",2,0],["رأوا عبد العزيز وليَّ عهدٍ","ومَاَ 