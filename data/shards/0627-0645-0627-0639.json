46,"","https://poetry.dctabudhabi.ae/diwan/poem/100671","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83652","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28755","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33395","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72491","الهزج"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76711","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139700",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52213","الكامل"],[4755,"هذا السَّرَابُ القائِمُ القاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183630",""],[4761,"هي الشمس أم نار على علم تبدو","https://www.poetsgate.com/ViewPoem.aspx?id=127120",""],[4767,"السعادة والسرور","https://www.poetsgate.com/ViewPoem.aspx?id=180907",""],[4852,"حيرانة","https://www.poetsgate.com/ViewPoem.aspx?id=214392",""],[4858,"بأيّة حالٍ عُدْتَ يا عيدُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=33673",""],[4858,"عرسُ الشّهادة في مدينة جنين","https://www.poetsgate.com/ViewPoem.aspx?id=159593",""],[4859,"يخاتلني الصبر!","https://www.poetsgate.com/ViewPoem.aspx?id=193843",""],[4984,"النصر غاية","https://www.poetsgate.com/ViewPoem.aspx?id=176009",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[5038,"دع عنك","https://www.poetsgate.com/ViewPoem.aspx?id=189467",""],[5065,"سبحة الإنطواء","https://www.poetsgate.com/ViewPoem.aspx?id=205183",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5191,"إنّي أنا العربيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=211967",""],[5219,"حديث الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195009",""],[5285,"هو وطني","https://www.poetsgate.com/ViewPoem.aspx?id=203189",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5320,"إلى البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=41634",""],[5334,"علِّقْتُها كَعبِيةً حَلَّ أَهلُها","https://www.poetsgate.com/ViewPoem.aspx?id=96982",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5376,"مررْتُ الدارَ اسألُ عنْ صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188387",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5376,".مَررْتَ حيّاً لنا والقلبُ لم تَزُرِ","https://www.poetsgate.com/ViewPoem.aspx?id=198987",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5452,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=112743",""],[5518,"إلى متى أنتَ باللذاتِ مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=187371",""],[5545,"رفيق الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=184833",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[3278,"تمنَّع أن رأى زغبا","https://www.poetsgate.com/ViewPoem.aspx?id=96573",""],[5616,"عواصم","https://www.poetsgate.com/ViewPoem.aspx?id=203338",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[5691,"شعارير","https://www.poetsgate.com/ViewPoem.aspx?id=205894",""],[5720,"خيرُ البريّةﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200025",""],[5720,"سِهام","https://www.poetsgate.com/ViewPoem.aspx?id=215500",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""],[5956,"قرُبَ الوداعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193570",""],[5978,"رسالة إلى المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=191364",""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[6068,"خسرا كلامي بجنب العشق والسقم -08-","https://www.poetsgate.com/ViewPoem.aspx?id=177359",""],[6070,"العهد","https://www.poetsgate.com/ViewPoem.aspx?id=187776",""],[6070,"رحى الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=188815",""],[6142,"يا فاتحا مغلق الأمصار أجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=155743",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[6335,"إنهزام إلى حدود آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65404&r=&rc=1",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""],[5190,"ثمن الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78316&r=&rc=29",""]],"verses":[["أَما عَلِمَ الغادونَ وَالقَلبُ خَلفَهُم","يَضُمُّ زَفيراً يَصدَعُ الصَلدَ ضَمُّهُ",0,"م",2,0],["أَما عانَقَتني صُدورُ السُيوفِ","أَما قَبَّلَتني نُصولُ السِهامِ",1,"م",1,0],["أَما عَلِمتَ أَنَّهُ","مَن كانَ حُرّاً لَم يُضَم",2,"م",1,0],["إِمّا عَقَرنَ ظِباهُ أَع","جَلنَ العَقايِرَ أَن تَكوسا",3,"س",2,0],["أَما عَلِمَ الحاسِدُ المُستَغِر","رُ أَنَّ الزَمانَ عَلَيهِ رَقيبُ",4,"ب",1,0],["أَما عَلِموا أَنَّ الهَوى يَجلِبُ الأَسى","فَيَمرَحُ دَمعُ العَينِ لِلهَمَلانِ",5,"ن",1,0],["أَما عَلِمتَ وَخَيرُ القَولِ أَصدَقُهُ","أَنَّ المَطامِعَ لا أُرخِي لَها لَبَبي",6,"ب",2,0],["أَمَا عَلِمُوا أَنِّي وَإِنْ كُنْتُ مُقْتِراً","أُرَوِّي مِنْ القِرْنِ الحُسامَ المُصَمِّما",7,"م",2,0],["أمَا عَلِمَتْ أن الهَوى يَستَفِزُّني","إذا الرَّكْبُ منْ نَحوِ الجُنَيْنَةِ أقْبلا",8,"ل",2,0],["أَما عَلِمَت يَقيناً أَنَّ أَهلي","عَلَيَّ لَهُم عُيونٌ وَاِرتِقابُ",9,"ب",1,0],["أَما عَلِموا أَنَّ الذبابَةَ لا تَرى","طَعامي وَأَنَّ الفارَ عِندي لَها لُجمُ",10,"م",1,0],["أَما عَلِمَت أَنَّ الشَفيعَ شَبابُ","فَيَقصُرَ عَن لَومِ المُحِبِّ عِتابُ",11,"ب",1,1],["أما على فهو زين الصغار","وعنده بعض دهاء الكبار",12,"ر",1,0],["أَمَا عَلَّمَتْنَا الرَّزَايَا الَّتِي","تَصُبُّ المَنَايَا عَلَى الوَادِعِينْ",13,"ن",1,0],["أما عاهدتني باللّه أن لا","يفرّق بيننا إلاّ شَعوب",14,"ب",1,0],["أما علموا أن الحياة بعصرنا","مدارس في كل البلاد تُشيَّد",15,"د",1,0],["أَمّا عَلَيٍّ فَقَد أَدنى قَرابَتَكُم","عِندَ الوِلايَةِ إِن لَم تُكفَرِ النِعَمُ",16,"م",1,0],["أَمّا عَلَيَّ الجَعفَرِي","يَ فَإِنَّهُ الحُرُّ العَفيف",17,"ف",1,0],["أَما عالِمٌ عارِفٌ بِالزَمانِ","يَروحُ وَيَغدو قَصيرَ الخُطا",18,"ا",1,0],["أما عليّ المستماحُ فكلنا","متشيعٌ يسري إليه ولاؤه",19,"ا",3,0],["أما عليّ فقد ضاءت مناسبه","ونفسهُ في سراة الصحف والآل",20,"ل",1,0],["أمَّا عليٌّ فهو عين سيادةٍ","لم يفتقر أصلاً إلى تعيين",21,"ن",1,0],["أمَّا علاهُ وبشرهُ فكلاهما","بلغ الهلال وتله لجبين",21,"ن",1,0],["أمَّا عِداه فما أصابوا مَهْرَبا","ومؤمِّلوه فقد أصابوا مطلبا",22,"ب",2,0],["أما عجائبُ دنيانا فقد خَلُقتْ","والظلمُ منك جديدٌ من عجائبِها",23,"ه",2,0],["أما علمتَ بأني عنك في سِعَةٍ","وفي غنى من عطايا الواحد الصمدِ",24,"د",1,0],["أمَّا عهودي فلم تزل حبساً","عليك فاجعل إزاءها حُبُسا",25,"س",2,0],["أما عجبٌ إجماعُ مختلفاتِها","على قتلِ من لاقَتْهُ لا تتأثَّمُ",26,"م",1,0],["أما علمتِ وخيرُ العلم أنفعُه","أن الغِنى غيرُ محسوبٍ من الكرمِ",27,"م",1,0],["أما عُبيدُ اللّهِ أسلمَهُ الأُلى","ضَمِنوا الدفاعَ لكلِّ خَطْبٍ مضلعِ",28,"ع",1,0],["أمَّا عَدِيٌّ فقد عدَّتْه سَيِّدَها","نجابةً وهي تُدْعى السادةَ النُّجُبا",29,"ب",2,0],["أَما عَلِمتَ جَزاكَ اللَهُ صالِحَةً","وَزادَكَ اللَهُ خَيراً يا اِبنَ يَقطينِ",30,"ن",1,0],["أَما عَلِمتَ جَزاكَ اللَهُ صالِحَةً","وَزادَكَ اللَهُ فَضلاً يا اِبنَ يَقطينِ",31,"ن",1,0],["أمّا عُلا حسنٍ فبين مَصَامِها","شَرَفاً وبين الفرقَدَينِ جِوارُ",32,"ر",1,0],["أَما عَدَاكِ حِمامٌ عَن زيارتِهِ","فكيفَ أطْمَعَ فيك النفسَ وانتظَرَك",33,"ك",1,0],["أَما عِندَ ابْنِ عَفَّانٍ شِفَاءٌ","فَيكشِفُ كُرْبَةَ العانِي الكَئِيبِ",34,"ب",1,0],["أَما عجبٌ والأرضُ مَلأى بمثلها","هُيامي بها دونَ الحسانِ على رغمي",35,"م",2,0],["أَما عَلِمتُم بِأَنَّ اللَهَ أَطلَقَهُ","لا تَذكُروا بَعدَهُ مُلكاً وَلا مِلكا",36,"ك",2,0],["أَما عَلِمَت عَيناكَ إِنّي أُحِبُّها","كَما كُلُّ مَعشوقٍ عَليمٌ بِعاشِقِ",37,"ق",1,1],["أما عَصَى أَمْرَ عِنْدَ سَفْكِ دَمٍ","ما في شَرِيعَةِ موسى أنَّه هَدَرُ",38,"ر",1,0],["أما عَرَفْتُمْ نَبيَّ اللهِ مَعرِفَةَ","الأَبْناء لكنكم قَوْمٌ مناكِيلُ",39,"ل",1,0],["أَما عَلِمتَ جَزاكَ اللَهُ صالِحَةً","عَنّي وَزادَكَ خَيراً يا اِبنَ يَقطين",40,"ن",1,0],["أَما عِندَكَ لي رِزقٌ","أُرجّيهِ وَلا قُطرَه",41,"ر",2,0],["إِمّا عُصيتُ فَإِنّي غَيرُ مُنفَلِتٍ","مِني اللِصابُ فَجَنبا حَرَّةِ النارِ",42,"ر",1,0],["أَما عَرَفَ المُقيمُ بِأَرضِ مِصرٍ","وَميضَ بَوارِقٍ وَدَوِيَّ رَعدِ",43,"د",1,1],["أَمّا عُقَيلٌ فَما عَن ظُلمِها عُقُلٌ","تِلكَ الصَريراتُ فيهِمِ ضاعَت الصُرَرُ",44,"ر",1,0],["أَما عَلِمُوا أَنِّي إِلى العِلْم طامِحٌ","وأَنِّي الِّذِي سَبْقاً على عرْقِهِ يَجْرِي",45,"ر",2,0],["أمّا عليٌّ فقد كانت له قدَمٌ","في السابقينَ لها في الناس قد بانا",46,"ن",2,0],["أم أعطي الدهرُ نوراً غير نورِهما","فإنَّ للّهِ في المعهودِ أسرارا",47,"ر",2,0],["أما عطفَ الفقيهُ وأنت تشكو","له شكوى العليلِ إلى الطبيب",48,"ب",1,0],["أم اعتَادَكَ التَّهيَامُ والحُزنُ والبُكَا","ولَستَ إِلَى غَيرِ الهَوَى تَتَعَلَّقُ",49,"ق",1,0],["أما عَلِمتَ بَأنَّ هَذَا ذُو الهُوَى","أوَ لَيسَ عِندَك موجِبُ التَّذكَارِ",50,"ر",1,0],["أَمّا عَلِيٌّ فَاِرتَبَتهُ أُمُّهُ","وَنَشا عَلى مِقَةٍ لَهُ وَتَزَيَّدا",51,"د",2,0],["أما علمت بأن الوجد أتلفني","والجسم مني بإفراط الصدودِ بلي",52,"ل",2,0],["إما عتاقا للنجا","ء أو هجانا بزلا",53,"ل",2,0],["إِما علىَ رَمضائه ماشيا","أو راكبا شامسةً ريِّضا",54,"ض",2,0],["أَمّا عُفاتُكَ لا أَكدَوا فَما لَهُمُ","إِذا المَطامِعُ طاحَت عَنكَ مُرتَحَلُ",55,"ل",1,0],["أما علمت بأنَّ الله مطَّلعٌ","يُحصِي فعالك من جهر وأسرار",56,"ر",1,0],["أَما عَلِمتَ بِأَنَّ العَجزَ مَجلَبَةٌ","لِلذُّلِّ وَالقُلِّ ما لَم يَغلِب القَدَرُ",57,"ر",1,0],["أَما عَلِمتَ أَنَّ إِفراطَ الأَسى","عَلَيهِمُ عَلامَةُ التَشَيُّعِ",58,"ع",1,0],["أمَا عجيبٌ أنّ ذا كلَّه","موفر في شره الكاسب",59,"ب",1,0],["أَما عجَبٌ منكُم جحودُ محمّدٍ","وَقَد بَهَرت آياتهُ الشمسَ والبدرا",60,"ر",2,0],["أَما عَلِموا أتباعهُ وأصاحبه","فَعنهم جميعُ الكائناتِ تترجمُ",61,"م",1,0],["أَما عَلِمتَ بِعَذلِ ال","عُشّاقِ لَيسَ يَحلُ",62,"ل",1,0],["أَما عَلِمتَ أَنَّ أَحداقَ الظِبا","ءِ النُجلِ لا يوجَدنَ بِالحَرائِرِ",63,"ر",1,0],["أَمّا عُقَيلٌ فَنَجّاها وَقَد شَرَعَت","فيها الأَسِنَّةُ رَكضٌ غَيرُ تَكذيبِ",64,"ب",1,0],["أما علمت والآسرات لحاظها","أسيرة حجليها بأني أسيرها",65,"ر",3,0],["أمَا عَلِمَتْ أَنَّ القِصَاصَ أَمَامَهَا","فَكَيْفَ أَرَاقَتْهُ عَلَى النَّحْرِ والقَصِّ",66,"ص",1,0],["إمّا عُلُومٌ تُسْتَفَادُ لَديهِ أوْ","أَعْمالُ بِرّ قَصْدُها مَبْرُورُ",67,"ر",1,0],["إِمّا عَزَمتَ عَلى الرَحيلِ فَلَم يَزَل","لِلمَكرُماتِ مُقَوِّضاً وَمُطَنِّبا",68,"ب",2,0],["إِمّا عَلى نَفسي وَإِمّا لَها","فَعايِشِ النَفسَ وَفيما وَتَر",69,"ر",1,0],["أَما عَجَبٌ أَن يكفَلَ الناسُ بَعضهُم","بِبَعضٍ فَيَرضى بِالكَفيلِ المُطالِبُ",70,"ب",1,1],["أَمَا علَى أَلحاظِ مِن قَتْلِنا","مِن قَوَدٍ أَوْ حَرَجٍ أَوْ جُناحْ",71,"ح",1,0],["إِمّا عَصَينا فيكُمُ النُصَحاءَ","فبما أَطَعنا فيكُمُ البُرَحاءَ",72,"ا",2,0],["أمَّا عَلَى كرَمِ ابنَةِ الكرامِ","فَلتَنزِلَنَّ بِه عَلى حُكمِي",73,"م",2,1],["أمَّا عَزائي فلَستُ آملُه","فيكَ وصَبري ما لَستُ أدرِكُهُ",74,"ك",2,0],["أَما عَرَفتُم سُمُوَّ مَنزِلِهِ","أَما لَحَظتُم عُلُوَّ مَثواهُ",75,"ا",2,0],["أما علمت بأني يامعذبتي","حملت قلبا\" بحبل الرقة اتصلا؟",76,"ل",2,0],["أمَّا عليك أبا الْحُسَينِ فلَمْ يزلْ","حُزني جديدَ الثّوبِ حتّى أُقبرا",77,"ر",2,0],["أما علم الجهول الفدم أني","من الآل الجحاجحة الكرام",78,"م",1,0],["إما علومٍ لآل أحفظ من روى","يضيق عن الأسفار ما وسع الصدر",79,"ر",1,0],["أما علمت أن المنايا تواثبت","على رفقة كل بعلياه مفرد",80,"د",1,0],["أما عرفت أنني في الحجة","في قلب لا جئتني بحجة",81,"ج",2,0],["إمّا عجَزتَ فلم تُسْعَدْ بثَروَتِهِم","فانظُرْ تجِدْهُم عنِ العَلياءِ قد عجَزوا",82,"ز",3,0],["أَما عَمَّ أَهل الحَزنِ وَالسَهل جودكم","أَما مالُكُم يَغدو عَلى الجودِ يَستَعدي",83,"د",2,0],["أما علمتِ أنّني","أصبحتُ شيخَ الحُمُقِ",84,"ق",1,0],["أَما عطفة كالفجر بالليل شامتاً","فتطرد سود الغيض بالمنن البلق",85,"ق",1,0],["أما عهودي لكُمُ مَشيدةٌ","لا يطمع الهادمُ في بنيانِها",86,"ن",3,0],["إما عموما أو فعج من بينهم","لأبي العلا وأخي الندى وقرينهِ",87,"ن",2,0],["أما علمتِ لا عدم","تِ نَدماً وخبَلا",88,"ل",2,0],["إمّا عَدتْ عنكم بَسيطةُ عامرٍ","فطَرَاهُ شَيبةَ بالمَناسم يُرضَحُ",89,"ح",1,0],["أمَّا على كذبِ الظنون فإنها","صدَقتْ أمانٍ في الحسين وبرَّتِ",90,"ت",1,0],["أما علّموك أنّ برجاً على رما","لِنا لا يدومُ أم غدوتَ نسيّا",91,"ي",2,0],["أما عندكَ محتلٌ ؟","فقمْ واشترِ محتلّا",92,"ل",2,1],["أما عزّ به الزعرا","ن والأستاذ قد ذُلّا؟",92,"ل",2,0],["أمَا علِموا بأ