{"poems":[[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[63,"لحاني هذيم صاحبي ليلة النقا","https://www.aldiwan.net/poem45812.html","الطويل"],[63,"من أرتجي وإلى ما ينتهي أربي","https://www.aldiwan.net/poem45848.html","البسيط"],[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[55,"كتبت إلى ظلوم فلم تجبني","https://www.aldiwan.net/poem26528.html","الوافر"],[71,"تجوع لي الشيخ الزكي وجاءني","https://www.aldiwan.net/poem3927.html","الطويل"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[88,"لعمرك أن الحر لا يتقيد","https://www.aldiwan.net/poem45017.html","الطويل"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[47,"إني أقول بما علمت","https://www.aldiwan.net/poem25221.html","مجزوء الكامل"],[47,"أما يردع الموت أهل النهى","https://www.aldiwan.net/poem25384.html","المتقارب"],[72,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"أصبحت في محن للدهر أعظمها","https://www.aldiwan.net/poem8666.html","البسيط"],[51,"يا مظهرا نخوة عند اللقاء لنا","https://www.aldiwan.net/poem61944.html","البسيط"],[51,"قل لأبي سهل الذي ورث","https://www.aldiwan.net/poem64575.html","المنسرح"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[62,"قالت حرمت الغنى من حيث أوتيه","https://www.aldiwan.net/poem52289.html","البسيط"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[49,"هذا زمان ألح الناس فيه على","https://www.aldiwan.net/poem63137.html","البسيط"],[49,"حتى متى ليت شعري يا ابن يقطين","https://www.aldiwan.net/poem65337.html","البسيط"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[80,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[105,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[102,"تعلقها قلبي ولم أدر ما اسمها","https://www.aldiwan.net/poem33028.html","الطويل"],[52,"يا قرمطيون هلا قام قبلكم","https://www.aldiwan.net/poem26772.html","البسيط"],[52,"أما علمت عيناك إني أحبها","https://www.aldiwan.net/poem26812.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"حتى متى ليت شعري يا ابن يقطين","https://www.aldiwan.net/poem24558.html","البسيط"],[50,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[7,"لقد نهيت بني ذبيان عن أقر","https://www.aldiwan.net/poem1997.html","البسيط"],[46,"أما عرف المقيم بأرض مصر","https://www.aldiwan.net/poem22477.html","الوافر"],[46,"أسيت إذا غابت الأحجال والغرر","https://www.aldiwan.net/poem22533.html","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30462","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116988","البسيط"],[120,"هل زيدت الشمس للأنوار أنوارا","https://www.aldiwan.net/poem4350.html","البسيط"],[120,"وقائلة تقول وقد رأتني","https://www.aldiwan.net/poem4365.html","الوافر"],[133,"أعادك من أسماء عيد مشوق","https://www.aldiwan.net/poem54790.html","الطويل"],[133,"هلا وقفت برسم تلك الدار","https://www.aldiwan.net/poem54832.html","الطويل"],[135,"إعلم أبا أروى بأنك ماجد","https://www.aldiwan.net/poem20994.html","الكامل"],[136,"لقد تبدى كغصن البان في الميل","https://www.aldiwan.net/poem47410.html","البسيط"],[143,"قلت لعمرو جذلا","https://www.aldiwan.net/poem58372.html","مجزوء الرجز"],[143,"قد طال للماطل أن يقتضى","https://www.aldiwan.net/poem58443.html","السريع"],[144,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[151,"يا شارب الراح في أوقات غفلته","https://www.aldiwan.net/poem68529.html","البسيط"],[170,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[170,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[186,"يا نفس ما عيشك بالدائب","https://www.aldiwan.net/poem14101.html","السريع"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[190,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[233,"لمني فلومك جهل","https://www.aldiwan.net/poem14805.html","المجتث"],[236,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[250,"سائل هوازن عنا كيف شدتنا","https://www.aldiwan.net/poem2126.html","البسيط"],[262,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[276,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[276,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[283,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[301,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[339,"أما عجب أن يكفل الناس بعضهم","https://www.aldiwan.net/poem68824.html","الطويل"],[349,"يا لحظه أثخنت قلبي جراح","https://www.aldiwan.net/poem20028.html","السريع"],[367,"لا تقبلوا قول الوشاة فإنهم","https://www.aldiwan.net/poem16909.html","الكامل"],[372,"أما على كرم ابنة الكرام","https://www.aldiwan.net/poem57158.html","أحذ الكامل"],[372,"احفظ فؤادي فأنت تملكه","https://www.aldiwan.net/poem57246.html","المنسرح"],[394,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[401,"عندما يرتحل القلب","https://www.aldiwan.net/poem6749.html","عموديه"],[403,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[404,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[404,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[404,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[404,"أراك كالدهر ترى المعوجة","https://www.aldiwan.net/poem33992.html","الرجز"],[406,"خل الأنام وما قالوا ومالمزوا","https://www.aldiwan.net/poem49917.html","البسيط"],[407,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[433,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[442,"عتاب أحال الشهد كالصاب في الحلق","https://www.aldiwan.net/poem14428.html","الطويل"],[459,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[459,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[459,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[459,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[459,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[506,"المُقنَّع","https://www.aldiwan.net/poem27796.html","الطويل"],[506,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[530,"قل لإمام الزمن","https://www.aldiwan.net/poem37130.html","الرجز"],[539,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[552,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[552,"تقول لي وأماقيها مطفحة","https://www.aldiwan.net/poem47751.html","البسيط"],[552,"بني الحفيظة هل للمجد من طلب","https://www.aldiwan.net/poem48043.html","البسيط"],[576,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["أَما عَلِمَ الغادونَ وَالقَلبُ خَلفَهُم","يَضُمُّ زَفيراً يَصدَعُ الصَلدَ ضَمُّهُ",0,"م",2,0],["أَما عانَقَتني صُدورُ السُيوفِ","أَما قَبَّلَتني نُصولُ السِهامِ",1,"م",1,0],["أَما عَلِمتَ أَنَّهُ","مَن كانَ حُرّاً لَم يُضَم",2,"م",1,0],["إِمّا عَقَرنَ ظِباهُ أَع","جَلنَ العَقايِرَ أَن تَكوسا",3,"س",2,0],["أَما عَلِمَ الحاسِدُ المُستَغِر","رُ أَنَّ الزَمانَ عَلَيهِ رَقيبُ",4,"ب",1,0],["أَما عَلِموا أَنَّ الهَوى يَجلِبُ الأَسى","فَيَمرَحُ دَمعُ العَينِ لِلهَمَلانِ",5,"ن",1,0],["أَما عَلِمتَ وَخَيرُ القَولِ أَصدَقُهُ","أَنَّ المَطامِعَ لا أُرخِي لَها لَبَبي",6,"ب",2,0],["أَمَا عَلِمُوا أَنِّي وَإِنْ كُنْتُ مُقْتِراً","أُرَوِّي مِنْ القِرْنِ الحُسامَ المُصَمِّما",7,"م",2,0],["أمَا عَلِمَتْ أن الهَوى يَستَفِزُّني","إذا الرَّكْبُ منْ نَحوِ الجُنَيْنَةِ أقْبلا",8,"ل",2,0],["أَما عَلِمَت يَقيناً أَنَّ أَهلي","عَلَيَّ لَهُم عُيونٌ وَاِرتِقابُ",9,"ب",1,0],["أَما عَلِموا أَنَّ الذبابَةَ لا تَرى","طَعامي وَأَنَّ الفارَ عِندي لَها لُجمُ",10,"م",1,0],["أَما عَلِمَت أَنَّ الشَفيعَ شَبابُ","فَيَقصُرَ عَن لَومِ المُحِبِّ عِتابُ",11,"ب",1,1],["أما على فهو زين الصغار","وعنده بعض دهاء الكبار",12,"ر",1,0],["أَمَا عَلَّمَتْنَا الرَّزَايَا الَّتِي","تَصُبُّ المَنَايَا عَلَى الوَادِعِينْ",13,"ن",1,0],["أما عاهدتني باللّه أن لا","يفرّق بيننا إلاّ شَعوب",14,"ب",1,0],["أما علموا أن الحياة بعصرنا","مدارس في كل البلاد تُشيَّد",15,"د",1,0],["أَمّا عَلَيٍّ فَقَد أَدنى قَرابَتَكُم","عِندَ الوِلايَةِ إِن لَم تُكفَرِ النِعَمُ",16,"م",1,0],["أَمّا عَلَيَّ الجَعفَرِي","يَ فَإِنَّهُ الحُرُّ العَفيف",17,"ف",1,0],["أَما عالِمٌ عارِفٌ بِالزَمانِ","يَروحُ وَيَغدو قَصيرَ الخُطا",18,"ا",1,0],["أما عليّ المستماحُ فكلنا","متشيعٌ يسري إليه ولاؤه",19,"ا",3,0],["أما عليّ فقد ضاءت مناسبه","ونفسهُ في سراة الصحف والآل",20,"ل",1,0],["أمَّا عليٌّ فهو عين سيادةٍ","لم يفتقر أصلاً إلى تعيين",21,"ن",1,0],["أمَّا علاهُ وبشرهُ فكلاهما","بلغ الهلال وتله لجبين",21,"ن",1,0],["أمَّا عِداه فما أصابوا مَهْرَبا","ومؤمِّلوه فقد أصابوا مطلبا",22,"ب",2,0],["أما عجائبُ دنيانا فقد خَلُقتْ","والظلمُ منك جديدٌ من عجائبِها",23,"ه",2,0],["أما علمتَ بأني عنك في سِعَةٍ","وفي غنى من عطايا الواحد الصمدِ",24,"د",1,0],["أمَّا عهودي فلم تزل حبساً","عليك فاجعل إزاءها حُبُسا",25,"س",2,0],["أما عجبٌ إجماعُ مختلفاتِها","على قتلِ من لاقَتْهُ لا تتأثَّمُ",26,"م",1,0],["أما علمتِ وخيرُ العلم أنفعُه","أن الغِنى غيرُ محسوبٍ من الكرمِ",27,"م",1,0],["أما عُبيدُ اللّهِ أسلمَهُ الأُلى","ضَمِنوا الدفاعَ لكلِّ خَطْبٍ مضلعِ",28,"ع",1,0],["أمَّا عَدِيٌّ فقد عدَّتْه سَيِّدَها","نجابةً وهي تُدْعى السادةَ النُّجُبا",29,"ب",2,0],["أَما عَلِمتَ جَزاكَ اللَهُ صالِحَةً","وَزادَكَ اللَهُ خَيراً يا اِبنَ يَقطينِ",30,"ن",1,0],["أَما عَلِمتَ جَزاكَ اللَهُ صالِحَةً","وَزادَكَ اللَهُ فَضلاً يا اِبنَ يَقطينِ",31,"ن",1,0],["أمّا عُلا حسنٍ فبين مَصَامِها","شَرَفاً وبين الفرقَدَينِ جِوارُ",32,"ر",1,0],["أَما عَدَاكِ حِمامٌ عَن زيارتِهِ","فكيفَ أطْمَعَ فيك النفسَ وانتظَرَك",33,"ك",1,0],["أَما عِندَ ابْنِ عَفَّانٍ شِفَاءٌ","فَيكشِفُ كُرْبَةَ العانِي الكَئِيبِ",34,"ب",1,0],["أَما عجبٌ والأرضُ مَلأى بمثلها","هُيامي بها دونَ الحسانِ على رغمي",35,"م",2,0],["أَما عَلِمتُم بِأَنَّ اللَهَ أَطلَقَهُ","لا تَذكُروا بَعدَهُ مُلكاً وَلا مِلكا",36,"ك",2,0],["أَما عَلِمَت عَيناكَ إِنّي أُحِبُّها","كَما كُلُّ مَعشوقٍ عَليمٌ بِعاشِقِ",37,"ق",1,1],["أما عَصَى أَمْرَ عِنْدَ سَفْكِ دَمٍ","ما في شَرِيعَةِ موسى أنَّه هَدَرُ",38,"ر",1,0],["أما عَرَفْتُمْ نَبيَّ اللهِ مَعرِفَةَ","الأَبْناء لكنكم قَوْمٌ مناكِيلُ",39,"ل",1,0],["أَما عَلِمتَ جَزاكَ اللَهُ صالِحَةً","عَنّي وَزادَكَ خَيراً يا اِبنَ يَقطين",40,"ن",1,0],["أَما عِندَكَ لي رِزقٌ","أُرجّيهِ وَلا قُطرَه",41,"ر",2,0],["إِمّا عُصيتُ فَإِنّي غَيرُ مُنفَلِتٍ","مِني اللِصابُ فَجَنبا حَرَّةِ النارِ",42,"ر",1,0],["أَما عَرَفَ المُقيمُ بِأَرضِ مِصرٍ","وَميضَ بَوارِقٍ وَدَوِيَّ رَعدِ",43,"د",1,1],["أَمّا عُقَيلٌ فَما عَن ظُلمِها عُقُلٌ","تِلكَ الصَريراتُ فيهِمِ ضاعَت الصُرَرُ",44,"ر",1,0],["أَما عَلِمُوا أَنِّي إِلى العِلْم طامِحٌ","وأَنِّي الِّذِي سَبْقاً على عرْقِهِ يَجْرِي",45,"ر",2,0],["أمّا عليٌّ فقد كانت له قدَمٌ","في السابقينَ لها في الناس قد بانا",46,"ن",2,0],["أم أعطي الدهرُ نوراً غير نورِهما","فإنَّ للّهِ في المعهودِ أسرارا",47,"ر",2,0],["أما عطفَ الفقيهُ وأنت تشكو","له شكوى العليلِ إلى الطبيب",48,"ب",1,0],["أم اعتَادَكَ التَّهيَامُ والحُزنُ والبُكَا","ولَستَ إِلَى غَيرِ الهَوَى تَتَعَلَّقُ",49,"ق",1,0],["أما عَلِمتَ بَأنَّ هَذَا ذُو الهُوَى","أوَ لَيسَ عِندَك موجِبُ التَّذكَارِ",50,"ر",1,0],["أَمّا عَلِيٌّ فَاِرتَبَتهُ أُمُّهُ","وَنَشا عَلى مِقَةٍ لَهُ وَتَزَيَّدا",51,"د",2,0],["أما علمت بأن الوجد أتلفني","والجسم مني بإفراط الصدودِ بلي",52,"ل",2,0],["إما عتاقا للنجا","ء أو هجانا بزلا",53,"ل",2,0],["إِما علىَ رَمضائه ماشيا","أو راكبا شامسةً ريِّضا",54,"ض",2,0],["أَمّا عُفاتُكَ لا أَكدَوا فَما لَهُمُ","إِذا المَطامِعُ طاحَت عَنكَ مُرتَحَلُ",55,"ل",1,0],["أما علمت بأنَّ الله مطَّلعٌ","يُحصِي فعالك من جهر وأسرار",56,"ر",1,0],["أَما عَلِمتَ بِأَنَّ العَجزَ مَجلَبَةٌ","لِلذُّلِّ وَالقُلِّ ما لَم يَغلِب القَدَرُ",57,"ر",1,0],["أَما عَلِمتَ أَنَّ إِفراطَ الأَسى","عَلَيهِمُ عَلامَةُ التَشَيُّعِ",58,"ع",1,0],["أمَا عجيبٌ أنّ ذا كلَّه","موفر في شره الكاسب",59,"ب",1,0],["أَما عجَبٌ منكُم جحودُ محمّدٍ","وَقَد بَهَرت آياتهُ الشمسَ والبدرا",60,"ر",2,0],["أَما عَلِموا أتباعهُ وأصاحبه","فَعنهم جميعُ الكائناتِ تترجمُ",61,"م",1,0],["أَما عَلِمتَ بِعَذلِ ال","عُشّاقِ لَيسَ يَحلُ",62,"ل",1,0],["أَما عَلِمتَ أَنَّ أَحداقَ الظِبا","ءِ النُجلِ لا يوجَدنَ بِالحَرائِرِ",63,"ر",1,0],["أَمّا عُقَيلٌ فَنَجّاها وَقَد شَرَعَت","فيها الأَسِنَّةُ رَكضٌ غَيرُ تَكذيبِ",64,"ب",1,0],["أما علمت والآسرات لحاظها","أسيرة حجليها بأني أسيرها",65,"ر",3,0],["أمَا عَلِمَتْ أَنَّ القِصَاصَ أَمَامَهَا","فَكَيْفَ أَرَاقَتْهُ عَلَى النَّحْرِ والقَصِّ",66,"ص",1,0],["إمّا عُلُومٌ تُسْتَفَادُ لَديهِ أوْ","أَعْمالُ بِرّ قَصْدُها مَبْرُورُ",67,"ر",1,0],["إِمّا عَزَمتَ عَلى الرَحيلِ فَلَم يَزَل","لِلمَكرُماتِ مُقَوِّضاً وَمُطَنِّبا",68,"ب",2,0],["إِمّا عَلى نَفسي وَإِمّا لَها","فَعايِشِ النَفسَ وَفيما وَتَر",69,"ر",1,0],["أَما عَجَبٌ أَن يكفَلَ الناسُ بَعضهُم","بِبَعضٍ فَيَرضى بِالكَفيلِ المُطالِبُ",70,"ب",1,1],["أَمَا علَى أَلحاظِ مِن قَتْلِنا","مِن قَوَدٍ أَوْ حَرَجٍ أَوْ جُناحْ",71,"ح",1,0],["إِمّا عَصَينا فيكُمُ النُصَحاءَ","فبما أَطَعنا فيكُمُ البُرَحاءَ",72,"ا",2,0],["أمَّا عَلَى كرَمِ ابنَةِ الكرامِ","فَلتَنزِلَنَّ بِه عَلى حُكمِي",73,"م",2,1],["أمَّا عَزائي فلَستُ آملُه","فيكَ وصَبري ما لَستُ أدرِكُهُ",74,"ك",2,0],["أَما عَرَفتُم سُمُوَّ مَنزِلِهِ","أَما لَحَظتُم عُلُوَّ مَثواهُ",75,"ا",2,0],["أما علمت بأني يامعذبتي","حملت قلبا\" بحبل الرقة اتصلا؟",76,"ل",2,0],["أمَّا عليك أبا الْحُسَينِ فلَمْ يزلْ","حُزني جديدَ الثّوبِ حتّى أُقبرا",77,"ر",2,0],["أما علم الجهول الفدم أني","من الآل الجحاجحة الكرام",78,"م",1,0],["إما علومٍ لآل أحفظ من روى","يضيق عن الأسفار ما وسع الصدر",79,"ر",1,0],["أما علمت أن المنايا تواثبت","على رفقة كل بعلياه مفرد",80,"د",1,0],["أما عرفت أنني في الحجة","في قلب لا جئتني بحجة",81,"ج",2,0],["إمّا عجَزتَ فلم تُسْعَدْ بثَروَتِهِم","فانظُرْ تجِدْهُم عنِ العَلياءِ قد عجَزوا",82,"ز",3,0],["أَما عَمَّ أَهل الحَزنِ وَالسَهل جودكم","أَما مالُكُم يَغدو عَلى الجودِ يَستَعدي",83,"د",2,0],["أما علمتِ أنّني","أصبحتُ شيخَ الحُمُقِ",84,"ق",1,0],["أَما عطفة كالفجر بالليل شامتاً","فتطرد سود الغيض بالمنن البلق",85,"ق",1,0],["أما عهودي لكُمُ مَشيدةٌ","لا يطمع الهادمُ في بنيانِها",86,"ن",3,0],["إما عموما أو فعج من بينهم","لأبي العلا وأخي الندى وقرينهِ",87,"ن",2,0],["أما علمتِ لا عدم","تِ نَدماً وخبَلا",88,"ل",2,0],["إمّا عَدتْ عنكم بَسيطةُ عامرٍ","فطَرَاهُ شَيبةَ بالمَناسم يُرضَحُ",89,"ح",1,0],["أمَّا على كذبِ الظنون فإنها","صدَقتْ أمانٍ في الحسين وبرَّتِ",90,"ت",1,0],["أما علّموك أنّ برجاً على رما","لِنا لا يدومُ أم غدوتَ نسيّا",91,"ي",2,0],["أما عندكَ محتلٌ ؟","فقمْ واشترِ محتلّا",92,"ل",2,1],["أما عزّ به الزعرا","ن والأستاذ قد ذُلّا؟",92,"ل",2,0],["أمَا علِموا بأنّك يا عليٌّ","لَباري قوسها يومَ النِّزالِ",93,"ل",1,0],["أما علمتَ أَنَّ آ","باءَكَ أهل الفطن",94,"ن",1,0],["أمَا عَجَبٌ للدِّين أعجزَ أُمةً","ومنهَا إلَى ضِعفيه فردٌ يُسدِّدُ",95,"د",1,0],["أما علمتُمْ بأنّا معشرٌ صُدُقٌ","وأنّنا في التّلاقي غيرُ أنكاسِ",96,"س",1,0],["أَما عَلمتَ بأنّا معشرٌ جُزُعٌ","نقلِي الصَّباحَ وَنَهوى دونه الغَلَسا",97,"س",2,0],["إِمّا على صَهَواتِ الخيل موطِنُهُ","أو دارُهُ في ظهور الأينُقِ النُّجُبِ",98,"ب",1,0],["إِمَّا على البَرِّ أَتَى راكضاً","أَو بجَنَاحِ الْقَلعِ في البحر طارْ",99,"ر",1,0]]}