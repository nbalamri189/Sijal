s://www.poetsgate.com/ViewPoem.aspx?id=192587",""],[5688,"الجيش الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=213689",""],[5720,"يَوْمُ البِلاد","https://www.poetsgate.com/ViewPoem.aspx?id=206834",""],[5784,"أنت السجين","https://www.poetsgate.com/ViewPoem.aspx?id=196951",""],[5818,"مُت مثل مَن ماتوا","https://www.poetsgate.com/ViewPoem.aspx?id=180562",""],[5823,"ليل الشباب سيورق","https://www.poetsgate.com/ViewPoem.aspx?id=61786",""],[5943,"معتوه","https://www.poetsgate.com/ViewPoem.aspx?id=20465",""],[5943,"هذا أنا بالآه أطلقُ صرختي","https://www.poetsgate.com/ViewPoem.aspx?id=34676",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""],[5956,"متقطعٌ قلبي على أحزانكِ","https://www.poetsgate.com/ViewPoem.aspx?id=194494",""],[5956,"متقدم بالحبِ والإجلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=194830",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""]],"verses":[["مُتَقَلِّداً بِنِجادِ مَملَكَةٍ","في غِمدِها الأَقدارُ وَالدُوَلُ",0,"ل",1,0],["مُتَقَدِّمٌ في لُؤمِهِ ميلادُهُ","وَمِنَ الخُمولِ كَأَنَّهُ لَم يولَدِ",1,"د",1,0],["مُتَقَلِّبُ الْحَالاَتِ فَاخْبُرْ تَقْلِهِ","مَهْمَا أَعَدْتَ يَداً إِلَى تَقْلِيبِ",2,"ب",1,0],["مُتَقَدِّمٌ حَتّى إِذا النَقعُ اِنجَلى","بِالبيضِ عَن سَبيِ الحَريمِ تَأَخَّرا",3,"ر",2,0],["مُتَقادِمٌ إِلّا تَكُن شَمسُ الضُحى","لِدَةٌ لَهُ فَنُجومُها أَرآدُ",4,"د",1,0],["مُتَقاذِفٍ تَلِعٍ كَأَنَّ عِنانَهُ","عَلِقٌ بِأَجرَدَ مِن جُذوعِ أَوالِ",5,"ل",1,0],["متقارض الحسنُ الجمي","ل من التآلف والتزاورْ",6,"ر",1,1],["متقلداً في الروع ذا شطُبٍ","كالرجع أبدع فيه مبدعه",7,"ع",2,0],["متقدماً متأخراً متصعِّداً","متحدراً مُتياسراً متيامنا",8,"ن",2,0],["مُتَقَرِّبٌ مِن صاحِبي فَإِذا مَشَت","في عَطفِهِ الغَلواءُ لَم أَتَقَرَّبِ",9,"ب",1,0],["مُتَقَيِّدٌ بِعُهودِهِ وَوُعودِهِ","يَجري عَلى سَنَنِ الوَفاءِ وَيَصدُقُ",10,"ق",1,0],["مُتَقَلِّبُ الجَنبَينِ في نَعمائِهِ","يَعرى وَيُصبَغُ في نَداكَ فَيورِقُ",10,"ق",1,0],["مُتَقَدِّمٌ في النورِ مَحجوبٌ بِهِ","موفٍ على الآفاقِ بِالأَسفارِ",11,"ر",1,0],["مُتَقَسَّمُ الأَحشاءِ يَنفُضُ رَوعُهُ","قَلباً كَأُنبوبِ اليَراعِ نَخيبا",12,"ب",2,0],["مُتَقارِبُ الأَقطارِ يَملَأُ حُسنُهُ","لَحَظاتِ عَينُ الناظِرِ المُتَعَجِّبِ",13,"ب",1,0],["مُتَقَحِّمٍ هَولَ الظَلامِ بِشاعِرٍ","كَالسَيفِ مُدَّرِعٍ لِهَولِ البيدِ",14,"د",1,0],["مُتَقَلقِلاتٌ بِالسَماحَةِ وَالنَدى","يَطلُبنَ خَيفَ مِنىً وَحِنوَ المَشعَرِ",15,"ر",1,0],["مُتَقَبَّلٌ مِن حَيثُ جاءَ حَسِبتَهُ","لِقَبولِهِ في النَفسِ جاءَ مُبَشِّرا",16,"ر",2,0],["مُتَقَيِّلٌ شَرَفَ الحُسَينِ وَمُصعَبِ","وَفَعالَ عَبدِ اللَهِ بَعدُ وَطاهِرِ",17,"ر",1,0],["مُتَقَسِّمُ الأَحشاءِ يَنشُدُ أَرنُعاً","مُتَقَسِّماتٍ بِالصِبا وَالشَمأَلِ",18,"ل",1,0],["مُتَقَلقِلُ العَزَماتِ في طَلَبِ العُلا","حَتّى يَكونَ عَلى المَكارِمِ قَيِّما",19,"م",2,0],["مُتَقَحِّمٌ بِهِمِ الغُمارَ وَعَزمُهُ","أَن يَخلِطَ الأَعلامَ بِالأَعلامِ",20,"م",1,0],["مُتَقَلِّدي قَلعِيَّةٍ وَصَوارِمٍ","هِندِيَّةٍ وَقَديمَةِ الآثارِ",21,"ر",1,0],["مُتَقَبِّضاتٌ عِندَ شَرِّ بُعولَةٍ","شَمِطَت رُؤوسُهُمُ وَهُم أَغمارُ",22,"ر",1,0],["مُتَقاعِسينَ عَلى النَواهِقِ بِالضُحى","يَمرونَهُنَّ بِيابِسِ الأَجذالِ",23,"ل",1,0],["مُتَقَلِّداً لِأَبيهِ كانَت عِندَهُ","أَرباقُ صاحِبَ ثَلَّةٍ وَبِهامِ",24,"م",1,0],["متقلِّباً في نَعمَةٍ فَضفاضَةٍ","جُعلَتْ له عِوَضاً من الأطمارِ",25,"ر",1,0],["متقَيِّلاً شرَفَ الأرا","قِمِ كابراً منهم فكابر",26,"ر",1,0],["مُتَقَدِّمٌ مِن صَبرِهِ ولِثامُهُ","يَومَ القراعِ أضاتُهُ والمِغفَرُ",27,"ر",1,0],["مُتَقَمّصٌ لوناً كأنّ سَوادَهُ","غُمِسَ الغرابُ الجَوْن في غِرْبيبهِ",28,"ب",2,0],["مُتَقَيِّلاً وَهباً وَتِلكَ خَلائِقٌ","فَضفاضَةٌ شَطَطٌ عَلى المُتَقَيِّلِ",29,"ل",1,0],["مُتَقَلِّبٌ في اللَهِ بَينَ بَشاشَةٍ","يَندى الهَشيمُ بِها وَبَيَن مَضاءِ",30,"ا",2,0],["مُتَقَلِّدٌ بِالدَمعِ حَلياً كُلَّما","عَطِلَت بِهِ مِن حَليها الأَجيادُ",31,"د",1,0],["مُتَقَسِّمُ الأَلحاظِ بَينَ مَحاسِنٍ","مِن رِدفِ رابِيَةٍ وَخَصرِ قَرارِ",32,"ر",1,0],["مُتَقَسِّمٌ مابَينَ بَدرِ دُجُنَّةٍ","أَسرى وَبَينَ غَمامَةٍ مِدرارِ",33,"ر",1,0],["مُتَقَلِّبٌ ما بَينَ عَزمٍ غارِسٍ","لِلمَكرُماتِ وَبَينَ حَزمٍ حارِسِ",34,"س",1,0],["مُتَقَدِّمٍ في صَدرِ كُلِّ كَتيبَةٍ","شَهباءَ يَندى جانِباها بِالدَمِ",35,"م",1,0],["مِتُّ قَبلَ اللِقاءِ شَوقاً فَلَمّا","جادَ لي بِاللِقاءِ مِتُّ سُرورا",36,"ر",2,0],["مُتَقاذِفٍ سَبطِ المَحالِ إِذا غَدا","تَبرِيَ لَهُ أُجُدُ الفَقارَةِ جَلعَدُ",37,"د",1,0],["مُتَقَطِّعُ الأسبابِ مِنْ أعمالِهِ","لكنه بِرَجَائِه مُتَسَبِّبُ",38,"ب",1,0],["مُتَقابِلاتٍ في مَراتِبِها جَنَتْ","حرْباً على البِيضِ الحِسانِ حسانها",39,"ن",3,0],["متقلّداً سيفَ الخِلافَةِ للّتي","يُلقَى إليه إذا استمرّ عِنانُها",39,"ن",3,0],["مٌتَقَلِّدٌ بِيضَ الشفارِ صوارماً","منها نُهاهُ ورأيُه والمُنصل",40,"ل",1,0],["متقلِّداً سيفَينِ سيفَ اللّهِ مِنْ","نصرٍ وسيفَكَ ذا الفقَارِ المُرهَفا",41,"ف",2,0],["مُتَقَلِّدٌ قَوسَ الصِبا","يَرمي وَلَيسَ لَهُ رَسيلُ",42,"ل",1,0],["متقاذفُ العِبْرَينِ تخفُقُ بالصَّبا","راياتُه مُتدافعُ الأمواجِ",43,"ج",1,0],["مُتَّقِدُ الجانِبَيْنِ ماضٍ","كأَنَّهُ الصّارِمُ الصّقِيلُ",44,"ل",1,0],["مُتَقَدِّمٌ بمَضائِهِ مُتَلَفِّعٌ","برِدائِهِ مُتَكَلِّمٌ في عيرِه",45,"ر",2,0],["مُتَقَسَّمٌ مَا بَيْنَ حُنْكَةِ أَشْيبٍ","صَدَقَتْ مَخِيلَتُهُ وَحِلْيَةِ أَمْرَدِ",46,"د",1,0],["مُتَقَلِّدٌ سَيْفَاً تَرِفُّ مُتُونُهُ","رَفَّ الْمَصَابِحِ شَفَّهُنَّ لِيَاقُ",47,"ق",1,0],["مُتَقَهْقِراً وَهْوَ الَّذِي","فِي بَأْسِهِ لا يُتَّهَمْ",48,"م",1,0],["مُتَقَاصِرٍ مَلأَ العُيُونَ تَجِلَّةً","وَرَمَى بِظِلٍ فِي الْقُلُوبِ طُوَالِ",49,"ل",1,0],["مُتقَدِّماً بَيْنَ الرِّجَا","لِ مُحَاكِياً فِيهِمْ أَبَاكْ",50,"ك",1,0],["مُتَقَدِّمِينَ تَسُوقُهُمْ لُمَعُ المُنَى","مُتَراجِعِينَ مَخَافَةَ الإِعْوَال",51,"ل",1,0],["مُتقَسِّمُ الأحْشاءِ، يُنْشِدُ أرْبُعاً","مُتَقَسِّماتٍ بالصَّبَا وَالشّمألِ",52,"ل",1,0],["متقفيا نهج المريد وحزبه","متوليا عن منهج المختار",53,"ر",1,0],["متقاربٌ حالي لديه فتارةً","أشكو جفاهُ وتاره أنا شاكرُ",54,"ر",1,0],["مُتَقَلِّد الصّمصامِ فَوقَ عَزيمةٍ","هِيَ في الوَغى أَمضى مِن الصّمصامِ",55,"م",1,0],["متقلدا بالسيف ليس مباليا","بمن التقى عزت به أنصاره",56,"ر",2,0],["مُتَقَلِّداً بِال