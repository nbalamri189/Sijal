,[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[45,"أكْثَرْتَ في لَوْمِ المُحِبّ، فأقْلِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32120",""],[133,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[161,"غدرت فيا باني الغزال الغادر","https://www.aldiwan.net/poem58938.html","الكامل"],[183,"في الركب بين هوادج الآرام","https://www.aldiwan.net/poem67034.html","الكامل"],[232,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[236,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[236,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[236,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[236,"قم بين أكسار البيوت وناد","https://www.aldiwan.net/poem32097.html","الكامل"],[262,"حوشيت در مدامع لا تجمد","https://www.aldiwan.net/poem38336.html","الكامل"],[283,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[311,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[365,"يرمي فؤادي وهو في سودائه","https://www.aldiwan.net/poem58720.html","الكامل"],[378,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[407,"حييتما من دمنتي طلين","https://www.aldiwan.net/poem50099.html","الكامل"],[407,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[410,"يا دهر كم هذا التفرق","https://www.aldiwan.net/poem31863.html","مجزوء الكامل"],[417,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[433,"لمن الشموس غربن في الأكوار","https://www.aldiwan.net/poem12433.html","الكامل"],[433,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[433,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[433,"أتروم خلا في الوداد صدوقا","https://www.aldiwan.net/poem12679.html","الكامل"],[440,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[440,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[440,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[442,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[442,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[459,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[459,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[459,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[465,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[496,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[501,"لله أن يختار من أحبابه","https://www.aldiwan.net/poem38096.html","الكامل"],[516,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[516,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[530,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[552,"ماذا يضيرك هند من حبي","https://www.aldiwan.net/poem48051.html","أحذ الكامل"],[554,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[568,"لبس القباء فلم يعبه وأيقنوا","https://www.aldiwan.net/poem69464.html","الكامل"],[576,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["مُتَقَلِّداً بِنِجادِ مَملَكَةٍ","في غِمدِها الأَقدارُ وَالدُوَلُ",0,"ل",1,0],["مُتَقَدِّمٌ في لُؤمِهِ ميلادُهُ","وَمِنَ الخُمولِ كَأَنَّهُ لَم يولَدِ",1,"د",1,0],["مُتَقَلِّبُ الْحَالاَتِ فَاخْبُرْ تَقْلِهِ","مَهْمَا أَعَدْتَ يَداً إِلَى تَقْلِيبِ",2,"ب",1,0],["مُتَقَدِّمٌ حَتّى إِذا النَقعُ اِنجَلى","بِالبيضِ عَن سَبيِ الحَريمِ تَأَخَّرا",3,"ر",2,0],["مُتَقادِمٌ إِلّا تَكُن شَمسُ الضُحى","لِدَةٌ لَهُ فَنُجومُها أَرآدُ",4,"د",1,0],["مُتَقاذِفٍ تَلِعٍ كَأَنَّ عِنانَهُ","عَلِقٌ بِأَجرَدَ مِن جُذوعِ أَوالِ",5,"ل",1,0],["متقارض الحسنُ الجمي","ل من التآلف والتزاورْ",6,"ر",1,1],["متقلداً في الروع ذا شطُبٍ","كالرجع أبدع فيه مبدعه",7,"ع",2,0],["متقدماً متأخراً متصعِّداً","متحدراً مُتياسراً متيامنا",8,"ن",2,0],["مُتَقَرِّبٌ مِن صاحِبي فَإِذا مَشَت","في عَطفِهِ الغَلواءُ لَم أَتَقَرَّبِ",9,"ب",1,0],["مُتَقَيِّدٌ بِعُهودِهِ وَوُعودِهِ","يَجري عَلى سَنَنِ الوَفاءِ وَيَصدُقُ",10,"ق",1,0],["مُتَقَلِّبُ الجَنبَينِ في نَعمائِهِ","يَعرى وَيُصبَغُ في نَداكَ فَيورِقُ",10,"ق",1,0],["مُتَقَدِّمٌ في النورِ مَحجوبٌ بِهِ","موفٍ على الآفاقِ بِالأَسفارِ",11,"ر",1,0],["مُتَقَسَّمُ الأَحشاءِ يَنفُضُ رَوعُهُ","قَلباً كَأُنبوبِ اليَراعِ نَخيبا",12,"ب",2,0],["مُتَقارِبُ الأَقطارِ يَملَأُ حُسنُهُ","لَحَظاتِ عَينُ الناظِرِ المُتَعَجِّبِ",13,"ب",1,0],["مُتَقَحِّمٍ هَولَ الظَلامِ بِشاعِرٍ","كَالسَيفِ مُدَّرِعٍ لِهَولِ البيدِ",14,"د",1,0],["مُتَقَلقِلاتٌ بِالسَماحَةِ وَالنَدى","يَطلُبنَ خَيفَ مِنىً وَحِنوَ المَشعَرِ",15,"ر",1,0],["مُتَقَبَّلٌ مِن حَيثُ جاءَ حَسِبتَهُ","لِقَبولِهِ في النَفسِ جاءَ مُبَشِّرا",16,"ر",2,0],["مُتَقَيِّلٌ شَرَفَ الحُسَينِ وَمُصعَبِ","وَفَعالَ عَبدِ اللَهِ بَعدُ وَطاهِرِ",17,"ر",1,0],["مُتَقَسِّمُ الأَحشاءِ يَنشُدُ أَرنُعاً","مُتَقَسِّماتٍ بِالصِبا وَالشَمأَلِ",18,"ل",1,0],["مُتَقَلقِلُ العَزَماتِ في طَلَبِ العُلا","حَتّى يَكونَ عَلى المَكارِمِ قَيِّما",19,"م",2,0],["مُتَقَحِّمٌ بِهِمِ الغُمارَ وَعَزمُهُ","أَن يَخلِطَ الأَعلامَ بِالأَعلامِ",20,"م",1,0],["مُتَقَلِّدي قَلعِيَّةٍ وَصَوارِمٍ","هِندِيَّةٍ وَقَديمَةِ الآثارِ",21,"ر",1,0],["مُتَقَبِّضاتٌ عِندَ شَرِّ بُعولَةٍ","شَمِطَت رُؤوسُهُمُ وَهُم أَغمارُ",22,"ر",1,0],["مُتَقاعِسينَ عَلى النَواهِقِ بِالضُحى","يَمرونَهُنَّ بِيابِسِ الأَجذالِ",23,"ل",1,0],["مُتَقَلِّداً لِأَبيهِ كانَت عِندَهُ","أَرباقُ صاحِبَ ثَلَّةٍ وَبِهامِ",24,"م",1,0],["متقلِّباً في نَعمَةٍ فَضفاضَةٍ","جُعلَتْ له عِوَضاً من الأطمارِ",25,"ر",1,0],["متقَيِّلاً شرَفَ الأرا","قِمِ كابراً منهم فكابر",26,"ر",1,0],["مُتَقَدِّمٌ مِن صَبرِهِ ولِثامُهُ","يَومَ القراعِ أضاتُهُ والمِغفَرُ",27,"ر",1,0],["مُتَقَمّصٌ لوناً كأنّ سَوادَهُ","غُمِسَ الغرابُ الجَوْن في غِرْبيبهِ",28,"ب",2,0],["مُتَقَيِّلاً وَهباً وَتِلكَ خَلائِقٌ","فَضفاضَةٌ شَطَطٌ عَلى المُتَقَيِّلِ",29,"ل",1,0],["مُتَقَلِّبٌ في اللَهِ بَينَ بَشاشَةٍ","يَندى الهَشيمُ بِها وَبَيَن مَضاءِ",30,"ا",2,0],["مُتَقَلِّدٌ بِالدَمعِ حَلياً كُلَّما","عَطِلَت بِهِ مِن حَليها الأَجيادُ",31,"د",1,0],["مُتَقَسِّمُ الأَلحاظِ بَينَ مَحاسِنٍ","مِن رِدفِ رابِيَةٍ وَخَصرِ قَرارِ",32,"ر",1,0],["مُتَقَسِّمٌ مابَينَ بَدرِ دُجُنَّةٍ","أَسرى وَبَينَ غَمامَةٍ مِدرارِ",33,"ر",1,0],["مُتَقَلِّبٌ ما بَينَ عَزمٍ غارِسٍ","لِلمَكرُماتِ وَبَينَ حَزمٍ حارِسِ",34,"س",1,0],["مُتَقَدِّمٍ في صَدرِ كُلِّ كَتيبَةٍ","شَهباءَ يَندى جانِباها بِالدَمِ",35,"م",1,0],["مِتُّ قَبلَ اللِقاءِ شَوقاً فَلَمّا","جادَ لي بِاللِقاءِ مِتُّ سُرورا",36,"ر",2,0],["مُتَقاذِفٍ سَبطِ المَحالِ إِذا غَدا","تَبرِيَ لَهُ أُجُدُ الفَقارَةِ جَلعَدُ",37,"د",1,0],["مُتَقَطِّعُ الأسبابِ مِنْ أعمالِهِ","لكنه بِرَجَائِه مُتَسَبِّبُ",38,"ب",1,0],["مُتَقابِلاتٍ في مَراتِبِها جَنَتْ","حرْباً على البِيضِ الحِسانِ حسانها",39,"ن",3,0],["متقلّداً سيفَ الخِلافَةِ للّتي","يُلقَى إليه إذا استمرّ عِنانُها",39,"ن",3,0],["مٌتَقَلِّدٌ بِيضَ الشفارِ صوارماً","منها نُهاهُ ورأيُه والمُنصل",40,"ل",1,0],["متقلِّداً سيفَينِ سيفَ اللّهِ مِنْ","نصرٍ وسيفَكَ ذا الفقَارِ المُرهَفا",41,"ف",2,0],["مُتَقَلِّدٌ قَوسَ الصِبا","يَرمي وَلَيسَ لَهُ رَسيلُ",42,"ل",1,0],["متقاذفُ العِبْرَينِ تخفُقُ بالصَّبا","راياتُه مُتدافعُ الأمواجِ",43,"ج",1,0],["مُتَّقِدُ الجانِبَيْنِ ماضٍ","كأَنَّهُ الصّارِمُ الصّقِيلُ",44,"ل",1,0],["مُتَقَدِّمٌ بمَضائِهِ مُتَلَفِّعٌ","برِدائِهِ مُتَكَلِّمٌ في عيرِه",45,"ر",2,0],["مُتَقَسَّمٌ مَا بَيْنَ حُنْكَةِ أَشْيبٍ","صَدَقَتْ مَخِيلَتُهُ وَحِلْيَةِ أَمْرَدِ",46,"د",1,0],["مُتَقَلِّدٌ سَيْفَاً تَرِفُّ مُتُونُهُ","رَفَّ الْمَصَا