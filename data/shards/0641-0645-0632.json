{"poems":[[42,"لعمري لقد أفشيت يوما فخانني","https://www.aldiwan.net/poem50463.html","الطويل"],[87,"لعمرك ما يدعى الفتى بين قومه","https://www.aldiwan.net/poem8279.html","الطويل"],[74,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[8,"الحمد لله لا شريك له","https://www.aldiwan.net/poem21831.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141952","الكامل"]],"verses":[["فَمَزَّقَهُ مَزقَ العَما وَهوَ غافِلٌ","وَنادى بِما أَخفَيتُ مِنهُ فَأَسمَعا",0,"ع",2,0],["فَمِزْ بَيْنَ مَا تَخْتَارُ فِي الْفِعْلِ وَالْتَمِسْ","لِنَفْسِكَ حَظّاً كَيْ تَكُونَ عَظِيمَا",1,"م",2,0],["فَمَزَّقتُ جَيبَ اللَيلِ عَن شَخصِ أَطلَسٍ","تَطَلَّعَ وَضّاحَ المَضاحِكِ قاطِبِ",2,"ب",1,0],["فمزاجُ كأسِ البابِلِيّةِ أوْلَقٌ","ومِزاجُ تلك دمُ الأفاعي القاتل",3,"ل",1,0],["فَمُزِّقُوا فِي البِلادِ واعتَرَفُوا","الهونَ وَذاقُوا البَأساءَ والعَدَما",4,"م",2,0],["فَمَزَجْتُ دَمْعَتَهُ الحَنُونَ بِدَمْعتي","ونَقَشْتُ مِثلَ جِراحِهِ بِفُؤَادي",5,"د",2,0]]}