{"poems":[[42,"لعمري لقد أفشيت يوما فخانني","https://www.aldiwan.net/poem50463.html","الطويل"],[87,"لعمرك ما يدعى الفتى بين قومه","https://www.aldiwan.net/poem8279.html","الطويل"],[74,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[8,"الحمد لله لا شريك له","https://www.aldiwan.net/poem21831.html","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141952","الكامل"],[116,"إذا بت في هم من الدهر مزعج","https://www.aldiwan.net/poem41950.html","الطويل"],[130,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[144,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[271,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[404,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[422,"ركبت بحرا من الدموع","https://www.aldiwan.net/poem46373.html","مخلع البسيط"],[501,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[528,"ولقد ذكرتك والنجوم كأنها","https://www.aldiwan.net/poem46010.html","الكامل"],[588,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["فَمَزَّقَهُ مَزقَ العَما وَهوَ غافِلٌ","وَنادى بِما أَخفَيتُ مِنهُ فَأَسمَعا",0,"ع",2,0],["فَمِزْ بَيْنَ مَا تَخْتَارُ فِي الْفِعْلِ وَالْتَمِسْ","لِنَفْسِكَ حَظّاً كَيْ تَكُونَ عَظِيمَا",1,"م",2,0],["فَمَزَّقتُ جَيبَ اللَيلِ عَن شَخصِ أَطلَسٍ","تَطَلَّعَ وَضّاحَ المَضاحِكِ قاطِبِ",2,"ب",1,0],["فمزاجُ كأسِ البابِلِيّةِ أوْلَقٌ","ومِزاجُ تلك دمُ الأفاعي القاتل",3,"ل",1,0],["فَمُزِّقُوا فِي البِلادِ واعتَرَفُوا","الهونَ وَذاقُوا البَأساءَ والعَدَما",4,"م",2,0],["فَمَزَجْتُ دَمْعَتَهُ الحَنُونَ بِدَمْعتي","ونَقَشْتُ مِثلَ جِراحِهِ بِفُؤَادي",5,"د",2,0],["فمزق جيوش الهم والغم والعنا","بأعتاب آل الهاشمي محمد",6,"د",1,0],["فمزَّق ولا ترحَم فما أنتَ واترٌ","لتَثأرَ مني حينَ حَلَّ المُقدَّرُ",7,"ر",1,0],["فَمَزِّقهُمُ قَتلاً وَنَفياً فَإِنَّهُ","نَهى الدينُ أَن يَستَصحِبَ الفاجِرُ البَرُّ",8,"ر",1,0],["فمزِّق بنورِ العَقلِ ظلمةَ خِدعةِ","وقطِّع حبالاً وُصلُها للمآرب",9,"ب",1,0],["فمزقته من بعد تحقيق ما حوى","وأوقدته ناراً لطبخ طعامي",10,"م",2,0],["فمزَّقَت ريحهُ قلوعي","مُذ عصفَت ساعةُ الرحيل",11,"ل",1,0],["فمَزَجْنا الخمرَ لهْفاً","بأَفانينِ الدُّموعْ",12,"ع",1,0],["فمزجت دمعي بالدماء ولم أكن","صِرفَ الهوى والعهد إن لم أمزِجِ",13,"ج",1,0],["فمزقهموا أيدي سبا وأذقهمو","كؤوس الردى بالمرهفات الصورام",14,"م",1,0]]}