{"poems":[[44,"لعمري لقد أفشيت يوما فخانني","https://www.aldiwan.net/poem50463.html","الطويل"],[89,"لعمرك ما يدعى الفتى بين قومه","https://www.aldiwan.net/poem8279.html","الطويل"],[76,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[8,"الحمد لله لا شريك له","https://www.aldiwan.net/poem21831.html","المنسرح"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141952","الكامل"],[119,"إذا بت في هم من الدهر مزعج","https://www.aldiwan.net/poem41950.html","الطويل"],[133,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[275,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[409,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[427,"ركبت بحرا من الدموع","https://www.aldiwan.net/poem46373.html","مخلع البسيط"],[505,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[532,"ولقد ذكرتك والنجوم كأنها","https://www.aldiwan.net/poem46010.html","الكامل"],[592,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77450","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70836","الوافر"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77679","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77337","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87814","الرجز"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102350","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206253","الطويل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34711","المنسرح"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85257","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66548","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32832","المنسرح"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142945","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111460","الطويل"],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[4767,"اليانصيب","https://www.poetsgate.com/ViewPoem.aspx?id=180035",""],[4767,"سهم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=180942",""],[4856,"وحدي أعاني","https://www.poetsgate.com/ViewPoem.aspx?id=36272",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5136,"يا ليلة جاءت على قدر","https://www.poetsgate.com/ViewPoem.aspx?id=121600",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5431,"رقص سوريالي!!","https://www.poetsgate.com/ViewPoem.aspx?id=200445",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5616,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203486",""],[5621,"السحر المطلق","https://www.poetsgate.com/ViewPoem.aspx?id=24568",""],[5626,"يا غُربتي","https://www.poetsgate.com/ViewPoem.aspx?id=189560",""],[5790,"رعى الله ليلا زارني في ظلامه","https://www.poetsgate.com/ViewPoem.aspx?id=112125",""],[6055,"إلى الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=29789",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["فَمَزَّقَهُ مَزقَ العَما وَهوَ غافِلٌ","وَنادى بِما أَخفَيتُ مِنهُ فَأَسمَعا",0,"ع",2,0],["فَمِزْ بَيْنَ مَا تَخْتَارُ فِي الْفِعْلِ وَالْتَمِسْ","لِنَفْسِكَ حَظّاً كَيْ تَكُونَ عَظِيمَا",1,"م",2,0],["فَمَزَّقتُ جَيبَ اللَيلِ عَن شَخصِ أَطلَسٍ","تَطَلَّعَ وَضّاحَ المَضاحِكِ قاطِبِ",2,"ب",1,0],["فمزاجُ كأسِ البابِلِيّةِ أوْلَقٌ","ومِزاجُ تلك دمُ الأفاعي القاتل",3,"ل",1,0],["فَمُزِّقُوا فِي البِلادِ واعتَرَفُوا","الهونَ وَذاقُوا البَأساءَ والعَدَما",4,"م",2,0],["فَمَزَجْتُ دَمْعَتَهُ الحَنُونَ بِدَمْعتي","ونَقَشْتُ مِثلَ جِراحِهِ بِفُؤَادي",5,"د",2,0],["فمزق جيوش الهم والغم والعنا","بأعتاب آل الهاشمي محمد",6,"د",1,0],["فمزَّق ولا ترحَم فما أنتَ واترٌ","لتَثأرَ مني حينَ حَلَّ المُقدَّرُ",7,"ر",1,0],["فَمَزِّقهُمُ قَتلاً وَنَفياً فَإِنَّهُ","نَهى الدينُ أَن يَستَصحِبَ الفاجِرُ البَرُّ",8,"ر",1,0],["فمزِّق بنورِ العَقلِ ظلمةَ خِدعةِ","وقطِّع حبالاً وُصلُها للمآرب",9,"ب",1,0],["فمزقته من بعد تحقيق ما حوى","وأوقدته ناراً لطبخ طعامي",10,"م",2,0],["فمزَّقَت ريحهُ قلوعي","مُذ عصفَت ساعةُ الرحيل",11,"ل",1,0],["فمَزَجْنا الخمرَ لهْفاً","بأَفانينِ الدُّموعْ",12,"ع",1,0],["فمزجت دمعي بالدماء ولم أكن","صِرفَ الهوى والعهد إن لم أمزِجِ",13,"ج",1,0],["فمزقهموا أيدي سبا وأذقهمو","كؤوس الردى بالمرهفات الصورام",14,"م",1,0],["فَمُزّقَ ذاكَ الجَيشُ كُلّ مُمزّقٍ","كَما مَزّقت مَيتاً بِقَبرٍ قَشاعمُ",15,"م",1,0],["فمزّق حُلّة الظلما","ء سِرْبالاً فسربالا",16,"ل",2,0],["فَمَزَّق ساجي اللَيل مِنهُ شَرارَةٌ","وَخَرَّقَ سِترَ الغَيم مِنهُ نُصولُ",17,"ل",1,0],["فَمَزَّقَ الجَيشَ تَمزيقاً بِحيلَتِهِ","كَأَنَّما كانَ جَيشاً زارَ في حُلُمِ",18,"م",1,0],["فَمَزَّقت أَحشاءَه","وَقَطَّعت حَبل الوَنين",19,"ن",1,0],["فمزرعةٌ طابت فأضعف نبتها","ومزرعة أكدت على كل زارع",20,"ع",1,0],["فمزقت أيدي سبا ملكنا","فالملك يبكي بالدموع الغزار",21,"ر",1,0],["فمزّق جموع المارقين فإنها","بقايا زروع آذنت بحصاد",22,"د",1,0],["فَمَزَّقَت لَحمَهُ بَراثِنُها","وَبَذَّرَتهُ أَشَدَّ تَبذيرِ",23,"ر",1,0],["فمزق اللَه أجناد التتار به","حتى أبيدوا وعاد الدين منتصفا",24,"ف",2,0],["فَمَزْجتُ ذاكَ بِهذِهِ وَشَرِبْتُها","وَلَثَمْتُهُ وَضمَمْتُهُ بِتَعَطُّفِ",25,"ف",1,0],["فَمَزَّقَ الجَيبَ ثُمَّ لاكَمَني","وَقالَ هذا المُصيبَةُ الكُبرى",26,"ر",2,0],["فمزقت أثواب الفلا بسوابق","تظل بها الأنضاء تفلي الفيافيا",27,"ي",2,0],["فَمَزَقَها الزُجُّ مُذ رُشِقا","وَفي الصَدرِ مِن دونِها مَرَقا",28,"ق",2,0],["فَمُزِّقَ أَفطُوليمُ بالنَّصلِ عُنقُهُ","فَعَضَّ الثَّرى تَنغَضُّ النَّواطِرُ",29,"ر",1,0],["فمزفاً للبراقع يا ظباء","رتاعاً في الحشا لا في الهضابِ",30,"ب",1,0],["فمزقت البطاقة مثل غيري","وكل الحاضرين لنا شهود",31,"د",1,0],["فمزجنا السرور بالحزن لما","طرق السمعَ من نعاه ينادي",32,"د",2,0],["فَمَزَّقتَ كُلَّ مواثيقِ حُبِّي","وأَتلفتَ قلبي سريعا ًلِيُجذَبْ",33,"ب",1,0],["فمزَّقتم الكفّار كلَّ ممزَّقٍ","بقتلٍ وأسرٍ والفتوح الكثيرة",34,"ه",1,0],["فمزجت كأسي من لماه ومن","عينيه بالسلسال والشجر",35,"ر",1,0],["فمزجت منها بسمة وسفرت عن","سحر تجلى للحبيب سفورا",36,"ر",2,0],["فمزقهم أيدي سبا فتفرقوا","فما بين مقتول وما بين هارب",37,"ب",1,0],["فمزيد الغيظ عن صدر الهدى","خص باللعن يزيدا وزيادا",38,"د",2,0],["فمزقني إذا ماشئتَ حقدا","على رقصي أمامك لستَ تقوى",39,"و",2,0],["فمزيدا من الفخار مزيدا","يا بلادي, بقيت للدين حصنا",40,"ن",2,0],["فمزق ما استطعت رداء حزن","فإن لك الرداء المخمليا",41,"ي",2,0],["فمزَّقَتْ لي ثوبَها.. فالشَّذا","يموجُ في إزارِها المونِقِ",42,"ق",1,0],["فَمَزِّقي يا رياحَ البُعْدِ أشْرِعَتي","وَلَمْلِمي حَوْليَ الأحزانَ أطْواقا",43,"ق",2,0],["فمزق جلباب الدجى صبح وجهه","وضوع جمر الخد عنبر خاله",44,"ل",2,0],["فمزقت شريانَه والوريدَ","ودلَّهتِهِ بعد هذا الخَوَر",45,"ر",1,0],["فَمَزَّقَتهُ بِسِكِّينِ القِلِى شَغَفًا","وَ أَرهَقَتهُ , فَلَمْ يَذَّمَّرِ الشَّغَفُ",46,"ف",1,0],["فَمَزجُ رُوحِكَ بالرّوحِ التي ازدَهَرَت","يُغنيكَ عَن مَزجِ دَمعٍ ساجمٍ بِدَمِ",47,"م",1,0]]}