{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[77,"لم يبق لي جود الولاية حاجة","https://www.aldiwan.net/poem36355.html","الكامل"],[93,"للبأس كانت دولة فتصرمت","https://www.aldiwan.net/poem9158.html","الكامل"],[83,"إن الإمام محمدا","https://www.aldiwan.net/poem54326.html","مجزوء الكامل"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[72,"للبغلة الشهباء عذر بين","https://www.aldiwan.net/poem19182.html","الكامل"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[89,"تلغى معاهدة واخرى تعقد","https://www.aldiwan.net/poem44875.html","الكامل"],[85,"يا راغب الخيرات أنت بقية","https://www.aldiwan.net/poem7141.html","الكامل"],[61,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[49,"آمنت بالله وأيقنت","https://www.aldiwan.net/poem10851.html","السريع"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[87,"عم الحيا واستنت الجداول","https://www.aldiwan.net/poem8367.html","الرجز"],[105,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[81,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85550","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[51,"فِطرٌ توسّط يومُه الأسبوعا","https://www.poetsgate.com/ViewPoem.aspx?id=29512",""],[30,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[115,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[185,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[189,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[210,"ماس من التيه في غلائل","https://www.aldiwan.net/poem13335.html","مخلع البسيط"],[210,"جارت على مهجتي ظلما وما عدلت","https://www.aldiwan.net/poem13337.html","البسيط"],[223,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[256,"للبرد في ريقه كزاز","https://www.aldiwan.net/poem48386.html","مخلع البسيط"],[270,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[275,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[280,"ببهاء وجهك تشرق الأنوار","https://www.aldiwan.net/poem60769.html","الكامل"],[377,"نار تثير على الضلوع وطيسا","https://www.aldiwan.net/poem59384.html","الكامل"],[391,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[432,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[432,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[432,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[432,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[439,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[458,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[464,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[477,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[551,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[562,"للبكر مريم بيعة معمورة","https://www.aldiwan.net/poem52568.html","الكامل"],[575,"ألوم نفسي على هذا العتاب وما","https://www.aldiwan.net/poem2760.html","البسيط"]],"verses":[["لِلبِشرِ في ديباجِهِ لامِعٌ","طِرازُ عَصبِ اليَمَنِ المُعلَمِ",0,"م",1,0],["للَبِسْتَ يَا ابْنَ أَبِي الْعَلاَ قُشُبَ الْمُلاَ","وَتَرَكْتَ أَهْل الأَرْضِ فِي أَسْمَالِ",1,"ل",1,0],["للبأس كانت دولةٌ فتصرمت","واليوم جدت دولةٌ للباس",2,"س",1,1],["للباسِهِ ثوباً وقد","لَبِس المحامد وارتدى",3,"د",2,0],["لَلبَدرُ وَاِبنُ غَمامَةٍ رِبعِيَّةٍ","أَصبَحتَ أَكرَمَ ظاعِنٍ وَمُقيمِ",4,"م",1,0],["للبغلة الشهباء عذر بين","إذ قيل قد وقعت ووصف جامع",5,"ع",1,1],["للبسته لبساً أطاب نسيمه","يا ابن الأطايب محتِداً وفروعا",6,"ع",2,0],["للبداءات يا ابنَ يحيى عُوادا","تٌ فعاوِد وللهوادِي توالي",7,"ل",2,0],["لِلبَينِ مِنّا وَاِختِيارِ سَوائِنا","وَلَقَد عَلِمتِ لَغَيرَ ذاكِ أَرومُ",8,"م",1,0],["للبحرِ يَنشرُهُ بُنوكَ","حضارةٍ وتمدّنا",9,"ن",2,0],["للبدرِ في نَيسانَ كحّلَ","بالضّياءِ الأعينا",9,"ن",2,0],["لِلبَحرِ يَنشُرُ بَنوكَ","حَضارَةً وَتَمَدُّنا",10,"ن",2,0],["لِلبَدرِ في نَيسانَ يَكحُلُ","بِالضِاءِ الأَعيُنا",10,"ن",2,0],["للبعض كوخ واطئ ولبعضهم","صرح كما شاء النعيم ممرجد",11,"د",1,0],["للبر أبواب تلوح لأهله","شتى وعندك كل باب يفتح",12,"ح",1,0],["لِلبيضِ من أثوابِه للزُّهرِ من","آرائِهِ للغُرِّ من آدابِه",13,"ب",2,0],["لِلبَينِ يَومٌ أَنا رَهنٌ بِهِ","لَو قَد دَنا يَومي لَقَد بِنتُ",14,"ت",1,0],["للبحر بالرّيح عُبَابٌ كذا","جدواهُ إن أُسْمِعَ فيها الملام",15,"م",1,0],["لِلْبُسْرِ فِيهَا قَانِئٌ وَنَاصِلُ","مُخَضَّبٌ كَأَنَّهُ الأَنَامِلُ",16,"ل",1,0],["للبرايا من شقِيٍّ وَسَعَيدِ","امْلأَي الدُّنيا وَزِيدي ثُمَّ زِيدي",17,"ي",1,0],["للبغيِ حِينٌ ثم يُقصَمُ صُلبُهُ","والعَدْلُ صُلْبٌ قائمٌ ما يُقْصَم",18,"م",1,0],["لِلبَحرِ عَن جُنحِهِ جُمودُ","سالت لَهُ أَدمُعي السِفاح",19,"ح",1,0],["للبطل ألسنةٌ تقول طليقة","والحق ليس لسانه بطليق",20,"ق",1,0],["لِلْبَطْرِيرَكِ أَبِي الأَحْبَارِ طَلْعَتُهُ","فِي كُلِّ يَوْمٍ بِهَذِي الدّارِ مَشْهُودِ",21,"د",1,0],["لِلبُكا فَوا عَجَباً","مِن سُفورِ مسفرِها",22,"ر",3,0],["للَبِستَه لبساً أطابَ نسيمه","يا بن الأطايب محتِداً وفروعا",23,"ع",2,0],["للبدرِ بعدَ السَّرى مالتْ عمائمهمْ","شَارَفْتُمُ نَفَحَاتِ الْجُودِ مِنْ عُمَرَا",24,"ر",2,0],["للبارق اللماع من طيبة","مقلة قلبي دائما ترصد",25,"د",1,0],["للبيضِ دونَ البيضِ ضربٌ مثلما","للسُمْرِ دونَ السمر عنك طِعان",26,"ن",1,0],["لِلبذلِ أكلُها عليه حرُما","محمّدُ هو المقيلُ العثَرات",27,"ت",1,0],["للبدر لو لاح مذ تبدى","يوما لولى وعاد آفل",28,"ل",1,0],["للبدر لو ظهرت لم يبد من خجل","والشمس ان ابصرتها في الضحى افلت",29,"ت",1,0],["لِلبُذيينَ لِليَهود","لِلنَّصارى لِلمُسلمين",30,"ن",1,0],["للبرد في ريقه كزازٌ","وللحمى في استه حريقُ",31,"ق",1,1],["للبحرِ لجّتُه وساحلُهُ","لكنَّ حبي ما له حدُّ",32,"د",1,0],["لِلْبَأسِ والجُودِ في يُمْناه حُكْمُهُما","ضَرْبٌ وَطَعْنٌ وإِحْسَانٌ وَإِجْمَالُ",33,"ل",1,0],["لَلَبِسْتَ مِنْ شَرَفِ الَمَناسِبِ حُلَّةً","بِالْفَخْرِ يُسْدِي نَسْجُها وَيُنارُ",34,"ر",1,0],["للبدر نورٌ مبهجٌ لكنه","بخسوفه يبدو لديك عبوسا",35,"س",2,0],["للبيت ذي عظم","بخير أرض الله",36,"ه",1,0],["للبرايا انْبجسَتْ من","ه اثنَتا عشرةَ عَينا",37,"ن",2,0],["للبِشْرِ برقٌ بين أرجائه","وللندى الفائضِ أمطارُ",38,"ر",1,0],["للبابِ منصبِه الزكيّ ونجلِه","وشبيهِه في الفضلِ والأفعالِ",39,"ل",1,0],["للبُدْنِ أن تقطعَ الفلاةَ بنا","وللهوى أن يقطِعَ البُدُنا",40,"ن",2,0],["للبِرِّ أَوَّلُ مَا قامَتْ بِهِ قَدَمٌ","سعياً وللحَقِّ أُولى نَطْقَةٍ نَطَقَا",41,"ق",2,0],["للبارقاتِ مطَرٌ وهذه","مُزنتُها دموعِيَ السواجمُ",42,"م",1,0],["للبرق فيك إشاراتٌ لها طربي","وللنسيم حديثٌ عنك منقول",43,"ل",1,0],["للبرقِ فيها ابتسامٌ لا يُزايلُها","ولي عقيبَ النوى في الدارِ تقطيبُ",44,"ب",1,0],["لِلبَذلِ مُغتَنم بِالبشرِ مُتسِم","يَسمو بِمبتسم كَالدُرِّ مُنتَظِمِ",45,"م",1,0],["للبِرِّ ما كسبتْ يداهُ وللنّدى","منه الغَداةَ حُزونُهُ وسهولُهُ",46,"ل",2,0],["للبِكرِ مريمَ بِيعةٌ معمورةٌ","قامت بتوفيقِ اليمينِ القادِرَهْ",47,"ه",1,1],["للْبُلْه منه مبرَّاتٌ وتكرمةٌ","وللحَمِير مسرَّاتٌ وتَنْعِيمُ",48,"م",1,0]]}