"السلام","https://www.poetsgate.com/ViewPoem.aspx?id=73493",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5318,"حقُ الشام*","https://www.poetsgate.com/ViewPoem.aspx?id=210551",""],[5324,"إشتقت إليك.","https://www.poetsgate.com/ViewPoem.aspx?id=211107",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5419,"إهداء","https://www.poetsgate.com/ViewPoem.aspx?id=32284",""],[5510,"زكاة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=205682",""],[5526,"أعداد الحضور","https://www.poetsgate.com/ViewPoem.aspx?id=192802",""],[5561,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=192900",""],[5582,"أَيْصْدُقُ هَذا الطَّيْفُ أَمْ هوَ يَكْذِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186668",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5781,"فاكهةُ الشّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202854",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5848,"30","https://www.poetsgate.com/ViewPoem.aspx?id=53372",""],[5956,"الكِذْبُ في قلبي وقلبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192187",""],[5956,"من مزايا البنك الإسلامي للتنمية","https://www.poetsgate.com/ViewPoem.aspx?id=193485",""],[5994,"بوغاز","https://www.poetsgate.com/ViewPoem.aspx?id=184585",""],[6134,"للبيت أنية وفرش منهما","https://www.poetsgate.com/ViewPoem.aspx?id=169585",""],[6225,"إزاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80933&r=&rc=202",""],[6341,"مداي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87282&r=&rc=11",""]],"verses":[["لِلبِشرِ في ديباجِهِ لامِعٌ","طِرازُ عَصبِ اليَمَنِ المُعلَمِ",0,"م",1,0],["للَبِسْتَ يَا ابْنَ أَبِي الْعَلاَ قُشُبَ الْمُلاَ","وَتَرَكْتَ أَهْل الأَرْضِ فِي أَسْمَالِ",1,"ل",1,0],["للبأس كانت دولةٌ فتصرمت","واليوم جدت دولةٌ للباس",2,"س",1,1],["للباسِهِ ثوباً وقد","لَبِس المحامد وارتدى",3,"د",2,0],["لَلبَدرُ وَاِبنُ غَمامَةٍ رِبعِيَّةٍ","أَصبَحتَ أَكرَمَ ظاعِنٍ وَمُقيمِ",4,"م",1,0],["للبغلة الشهباء عذر بين","إذ قيل قد وقعت ووصف جامع",5,"ع",1,1],["للبسته لبساً أطاب نسيمه","يا ابن الأطايب محتِداً وفروعا",6,"ع",2,0],["للبداءات يا ابنَ يحيى عُوادا","تٌ فعاوِد وللهوادِي توالي",7,"ل",2,0],["لِلبَينِ مِنّا وَاِختِيارِ سَوائِنا","وَلَقَد عَلِمتِ لَغَيرَ ذاكِ أَرومُ",8,"م",1,0],["للبحرِ يَنشرُهُ بُنوكَ","حضارةٍ وتمدّنا",9,"ن",2,0],["للبدرِ في نَيسانَ كحّلَ","بالضّياءِ الأعينا",9,"ن",2,0],["لِلبَحرِ يَنشُرُ بَنوكَ","حَضارَةً وَتَمَدُّنا",10,"ن",2,0],["لِلبَدرِ في نَيسانَ يَكحُلُ","بِالضِاءِ الأَعيُنا",10,"ن",2,0],["للبعض كوخ واطئ ولبعضهم","صرح كما شاء النعيم ممرجد",11,"د",1,0],["للبر أبواب تلوح لأهله","شتى وعندك كل باب يفتح",12,"ح",1,0],["لِلبيضِ من أثوابِه للزُّهرِ من","آرائِهِ للغُرِّ من آدابِه",13,"ب",2,0],["لِلبَينِ يَومٌ أَنا رَهنٌ بِهِ","لَو قَد دَنا يَومي لَقَد بِنتُ",14,"ت",1,0],["للبحر بالرّيح عُبَابٌ كذا","جدواهُ إن أُسْمِعَ فيها الملام",15,"م",1,0],["لِلْبُسْرِ فِيهَا قَانِئٌ وَنَاصِلُ","مُخَضَّبٌ كَأَنَّهُ الأَنَامِلُ",16,"ل",1,0],["للبرايا من شقِيٍّ وَسَعَيدِ","امْلأَي الدُّنيا وَزِيدي ثُمَّ زِيدي",17,"ي",1,0],["للبغيِ حِينٌ ثم يُقصَمُ صُلبُهُ","والعَدْلُ صُلْبٌ قائمٌ ما يُقْصَم",18,"م",1,0],["لِلبَحرِ عَن جُنحِهِ جُمودُ","سالت لَهُ أَدمُعي السِفاح",19,"ح",1,0],["للبطل ألسنةٌ تقول طليقة","والحق ليس لسانه بطليق",20,"ق",1,0],["لِلْبَطْرِيرَكِ أَبِي الأَحْبَارِ طَلْعَتُهُ","فِي كُلِّ يَوْمٍ بِهَذِي الدّارِ مَشْهُودِ",21,"د",1,0],["لِلبُكا فَوا عَجَباً","مِن سُفورِ مسفرِها",22,"ر",3,0],["للَبِستَه لبساً أطابَ نسيمه","يا بن الأطايب محتِداً وفروعا",23,"ع",2,0],["للبدرِ بعدَ السَّرى مالتْ عمائمهمْ","شَارَفْتُمُ نَفَحَاتِ الْجُودِ مِنْ عُمَرَا",24,"ر",2,0],["للبارق اللماع من طيبة","مقلة قلبي دائما ترصد",25,"د",1,0],["للبيضِ دونَ البيضِ ضربٌ مثلما","للسُمْرِ دونَ السمر عنك طِعان",26,"ن",1,0],["لِلبذلِ أكلُها عليه حرُما","محمّدُ هو المقيلُ العثَرات",27,"ت",1,0],["للبدر لو لاح مذ تبدى","يوما لولى وعاد آفل",28,"ل",1,0],["للبدر لو ظهرت لم يبد من خجل","والشمس ان ابصرتها في الضحى افلت",29,"ت",1,0],["لِلبُذيينَ لِليَهود","لِلنَّصارى لِلمُسلمين",30,"ن",1,0],["للبرد في ريقه كزازٌ","وللحمى في استه حريقُ",31,"ق",1,1],["للبحرِ لجّتُه وساحلُهُ","لكنَّ حبي ما له حدُّ",32,"د",1,0],["لِلْبَأسِ والجُودِ في يُمْناه حُكْمُهُما","ضَرْبٌ وَطَعْنٌ وإِحْسَانٌ وَإِجْمَالُ",33,"ل",1,0],["لَلَبِسْتَ مِنْ شَرَفِ الَمَناسِبِ حُلَّةً","بِالْفَخْرِ يُسْدِي نَسْجُها وَيُنارُ",34,"ر",1,0],["للبدر نورٌ مبهجٌ لكنه","بخسوفه يبدو لديك عبوسا",35,"س",2,0],["للبيت ذي عظم","بخير أرض الله",36,"ه",1,0],["للبرايا انْبجسَتْ من","ه اثنَتا عشرةَ عَينا",37,"ن",2,0],["للبِشْرِ برقٌ بين أرجائه","وللندى الفائضِ أمطارُ",38,"ر",1,0],["للبابِ منصبِه الزكيّ ونجلِه","وشبيهِه في الفضلِ والأفعالِ",39,"ل",1,0],["للبُدْنِ أن تقطعَ الفلاةَ بنا","وللهوى أن يقطِعَ البُدُنا",40,"ن",2,0],["للبِرِّ أَوَّلُ مَا قامَتْ بِهِ قَدَمٌ","سعياً وللحَقِّ أُولى نَطْقَةٍ نَطَقَا",41,"ق",2,0],["للبارقاتِ مطَرٌ وهذه","مُزنتُها دموعِيَ السواجمُ",42,"م",1,0],["للبرق فيك إشاراتٌ لها طربي","وللنسيم حديثٌ عنك منقول",43,"ل",1,0],["للبرقِ فيها ابتسامٌ لا يُزايلُها","ولي عقيبَ النوى في الدارِ تقطيبُ",44,"ب",1,0],["لِلبَذلِ مُغتَنم بِالبشرِ مُتسِم","يَسمو بِمبتسم كَالدُرِّ مُنتَظِمِ",45,"م",1,0],["للبِرِّ ما كسبتْ يداهُ وللنّدى","منه الغَداةَ حُزونُهُ وسهولُهُ",46,"ل",2,0],["للبِكرِ مريمَ بِيعةٌ معمورةٌ","قامت بتوفيقِ اليمينِ القادِرَهْ",47,"ه",1,1],["للْبُلْه منه مبرَّاتٌ وتكرمةٌ","وللحَمِير مسرَّاتٌ وتَنْعِيمُ",48,"م",1,0],["للبدر نور ليس قدّ مثلها","يختال من تيه ومن خيلاء",49,"ا",2,0],["للبيتِ حجّ لكي يقضي فريضتهُ","بالنسكِ مؤتزراً بالزهد مدَّرِعا",50,"ع",2,0],["لِلبَرقِ مَكرُمَةٌ إن شقَّ في إضَمٍ","جَيبَ الغَمامَةِ أو تُروى بِهِ إضَمُ",51,"م",1,0],["للبارع ابن العاهرة","زوجة سوء فاجره",52,"ه",1,1],["لِلبغي سَيف قاطِعٌ وَمُعتَدل","مَن سَلَّه عَلى امرئ بِهِ قُتِل",53,"ل",1,0],["للباز الأشهب عبد القادر انتجعت","آمالنا واسترادت خير مرتاد",54,"د",1,0],["للبركةِ الغراءِ في نقصانها","عذرٌ فجد بقبوله متصدقا",55,"ق",2,1],["للبدر في أفق السماء تنقص","وضياء فضل الصدر لا ينتقص",56,"ص",1,0],["للبر والإحسان منه راحةٌ","عنها السحاب تعلمت إسبالها",57,"ل",3,0],["للبدر آي تآلف ووفلق","بالشمس عند تقابل وتلاقي",58,"ق",2,1],["لَلُبسُ ثَوبَينِ بِاليَينِ","وَطَيُّ يَومٍ وَلَيلَتَينِ",59,"ن",1,1],["لِلبَرِّ مُقتَحِمٍ لِلبرِّ مُلتَزِمٍ","لِلقُربِ مُغتَنِمٍ لِلتُّربِ مُلتَثِمِ",60,"م",1,0],["للبيض تقرع بالمواضي","تحت قسطلة الجلاد",61,"د",1,0],["للبدور التم من اسرته","والبحور الفعم من غر كرام",62,"م",1,0],["للبدر لمحته كبشر ضيائه","للمسك نفحته كنشر فتيقه",63,"ق",2,0],["للبدر في رملك التبري عربدة","وللصباح إذا حياك أشواق",64,"ق",1,0],["للبيض والأجفان كالأجفانِ","منْ جازئات ظِباءِ وجْرَةَ من لها",65,"ه",2,0],["للبعْثِ أركبُها إذا قيلَ اظْعنوا","مُسْتَوْسِقينَ معا لحشْرِ الحاشرِ",66,"ر",1,0],["للبندرية قاصدا وبقربه","جبل الابال على ذرى جنوية",67,"ه",1,0],["للبحر ألجأ أو لزاويتي","بهما الهنا والأمن والشعر",68,"ر",1,0],["للبحر أذهب باكرا","أرنو له وأتمتمُ",69,"م",1,1],["للبدو تنسبه زما","ناً ثم تمالكه الحضر",70,"ر",1,0],["للبداوهْ بَدْر تَمّ حِسْنا","وللحَضارَهْ شَمْس وضَّاحَه",71,"ح",2,0],["للبيك بهجة مصطفى نؤرخ","صفات بنت سعده الحميده",72,"د",2,0],["للبيك كم من منة ومزية","دارت مدرا البدر بعد هلوله",73,"ل",2,0],["للبرْقِ في سرْعةٍ للنّارِ في لهَبٍ","للرّيحِ في قوّةٍ يُعْزى مُجسَّمُهُ",74,"م",2,0],["للباذلين يُولّي الناسُ وجهَهُمُ","فَطيَّبُ الوِردِ لا يَخلو من الطلَبِ",75,"ب",1,0],["للبحر كل نهار","يغدون يرقب جسرُ",76,"ر",1,0],["للبستها فرحًا بها","كالطِّفل في الزِّيِّ الجديد",77,"د",1,0],["للباترات جنينُ الأم تحمله","وللنسور شباب في الديار نما",78,"م",2,0],["للبؤس قد ألقياني","تمت بهذي الرواية",79,"ه",1,0],["لَلْبِيدِ وَالْكُومِ الرَّواسِمِ مَعْشَرٌ","عَدَلَ الزَّمانُ بِشَأْنِهِمْ عَنْ شَانِي",80,"ن",2,0],["لِلبشْرِ فِي مَرآهُ لَمْعٌ بَرّاقْ","يُوْلِي مَنِ اسْتَسْقَى وَلِيّاً غيْدَاقْ",81,"ق",1,0],["لِلباب كَرّوا وَمِصراعاهُ ما زُلِجا","بَل فيهِ قَومٌ يُباري مَن عَدا وَنَجا",82,"ج",2,0],["للبدر أم لك في الدجى البلج","والمسك يأرج أم لك الأرجُ",83,"ج",1,1],["للباء سِرٌّ عظيم لو أبوح به","لكنت أوّ