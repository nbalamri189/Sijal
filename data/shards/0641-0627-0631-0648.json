oem.aspx?id=129582",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["فَأَروى الزُروعَ وَأَعنابَها","عَلى سَعَةٍ ماؤهُم إِذ قُسِم",0,"م",1,0],["فَأَروى جَنوبَ الدَونَكَينِ فَضاجِعاً","فَدَرَّ فَأَبلى صادِقَ الوَبلِ أَسحَما",1,"م",2,0],["فَارُوقُ أَوْلاكِ الوِسَا","مَ وَفِي تَفَضُّلِهِ مَعَانِ",2,"ن",1,0],["فَارُوقُ يَا مَنْ كَفَاهُ فِي حَصَافَته","وَعَدْله أَنَّهْ فَارٌوقٌ الثَّانِي",3,"ن",2,0],["فَأَرُوهُ مِنْكُمْ مَكَانَ الصَّلاحِ","وَأَرُوهُ بَوَارِقَ الإِصْلاحِ",4,"ح",1,0],["فَارُوقُ أَهْدَى لَكُمُ","فَلا تَظَلُّوا عَاشِينَ فِي الظُّلْمِ",5,"م",1,0],["فَارُوقُ يُسْعِدُ شَعْبَهُ فَيُطِيعُهُ","عَنْ رَغْبَةٍ فِي حُكْمِهِ المَحْكُومُ",6,"م",1,0],["فَارُوقُنَا المَلِكُ المُفَدَّى","هَلْ يُقَاسُ إِلَى مَثِيلِ",7,"ل",1,0],["فأروحُ أُظْهرُ شاهداً مُسْتَحْسَناً","مِنِّي وأُبطنُ غائباً مُسْتَقْبَحا",8,"ح",2,0],["فَأَرَوهُ الصَديقَ في ثَوبِ فَقرٍ","يَسأَلُ الجَمعَ وَالسُؤالُ بَلاءُ",9,"ا",2,0],["فأروَحُ لي منها اعتزالٌ يصونُني","صِيانةَ مطرورِ الغِرارين مُغْمَدِ",10,"د",1,0],["فَأَروحُ في بُردَينِ لَم يَسحَبهُما","قَبلي فَتىً وَهُما الغِنى وَاللومُ",11,"م",1,0],["فَاروِ يا تاريخ وَاشهد يا زَمَن","قَد رَأَينا النار يَعلوها الرَماد",12,"د",1,0],["فَاروِ يا تاريخ وَاشهد يا زَمَن","حرم طَهره فادي الوَرى",12,"ر",2,0],["فَاروِ يا تاريخ وَاشهد يا زَمَن","يا فَلسطين دَمي وَقفٌ عَلى",12,"ل",2,0],["فاروِ يا شاعرُ عن إشراقِها","إنَّما كأسُك نورٌ وصفاءْ",13,"ا",2,0],["فاروي أغانيَّ القُدامى وانفثي","في الليل من نفثات قلبي الدامي",14,"م",2,0],["فاروق جملها وزان ضفافها","عرش يلوذ الشعب تحت ظلاله",15,"ل",2,0],["فَارُوقُ إِنَّكَ ذُخْرُ الأُمَّةِ الغَالِي","عِشْ مَا تَشَاءُ المُنَى وَاسْلَمْ لأَجْيَالِ",16,"ل",1,1],["فَارُوقُ إِنَّ الدَّهْرَ صَا","لَحَهَا وعاهَدَهَا بِعَهْدِكْ",17,"ك",1,0],["فَارُوقُ عِشْ وَابْلُغْ نِهَايَاتِ العُلَى","وبِمَا تَشَاءُ مِنَ الأَمَانِيِّ اظْفَرِ",18,"ر",1,0],["فَارُوقُ يَا فَخْراً لأُمتِهِ إِذَا","عُدَّ المُلُوكُ مِنَ الطِّرَازِ الفَائِقِ",19,"ق",1,0],["فارُوقُ يَقْدُرُ أَخْطارَ الرِّجَالِ بِمَا","تَسْوَى وَيَعْدِلُ دُنْياهُمْ إِذَا عَطَفَا",20,"ف",2,0],["فَارُوقُ أَوْلاَكَ إِنْعَاماً جَدُرْتَ بِهِ","فَكُنْتَ أَوْفَى وَأَكْفَى مَنْ بِهِ اعْتَرَفَا",20,"ف",2,0],["فَارُوقُ مِصْرَ هُوَ الذَّخِيرَةُ أَبْرَزَتْ","مِنْ غَيْبِهَا الأَسْمَى لأَسْمَى مَقْصِدِ",21,"د",1,0],["فَارْوقُنَا بُورِكَ فِي عُمْرِهِ","دَبَّرَ مُلْكاً وَالصِّبَا فِي إِقْتِبَالْ",22,"ل",1,0],["فَارُوقُنَا المَحْبُوبُ يَقْرنُ عَزْمَه","بِالحَزْمِ وَالإِنْصَافِ بِالإِجْمَالِ",23,"ل",1,0],["فَارُوقُ يَا صَائِنُ المُلْكَ العَظِيمَ وَيَا","مُجَدِّداً عَهْدَ فَارُوقَ كَمَا سَلَفَا",24,"ف",2,0],["فاروقُ مِصْرَ المفدَّى هَلْ رَأَى سَبَباً","لِلخَيْرِ إِلاَّ عَلَى أَصْحَابِهِ عَطَفَا",24,"ف",2,0],["فَارُوقُ يَا زَيْنَ المُلُوكِ","الصِّيدِ فِي شَرْقٍ وَغَرْبِ",25,"ب",1,0],["فارُوقُ أنْتَ مَناطُ آمَالِ الْحِمَى","وَسُلالَةُ الأَمْجَادِ مِنْ نُصرَائه",26,"ا",3,0],["فارُوقُ مُنْبَثَقُ الرَجَا","ءِ ومُلْتَقَى الرُكْنِ الشَديدِ",27,"د",1,0],["فاروقُ فَرْدٌ في الجلا","لِ فلا شبيهَ ولا مناظرْ",28,"ر",1,0],["فاروقُ أشرِقْ بالمنى","يسمو لِضوئك كُلُّ حائرْ",28,"ر",1,0],["فاروقُ زَيْنُ الناشئين المرتجَى","كَرُمت أوائِلُهُ وطَاب العُنصُر",29,"ر",1,0],["فاروقُ زينُ الناشئِينَ","وأنتِ زيْنُ الناشئات",30,"ت",1,0],["فَارُوقُ يَا زِينَةَ الدُّنْيَا وَبَهْجَتَها","وَأَسْعَدَ النَّاسِ في وِرْدٍ وَإِصْدَارِ",31,"ر",1,0],["فاروقُ عيدُك هَزّ أَدْوَاحَ المُنَى","وتَعطَّرتْ بعَبِيرِه الأَزهارُ",32,"ر",1,0],["فاروقُ تاجُك رَحْمةٌ وسَعادةٌ","للوادِيَيْن وعِزَّةٌ وفَخار",32,"ر",1,0],["فارُوق الْمُرْتَجَى الْمُفَدَّى","مُوَفَّقَ الرَّأْيِ والْجُهُودِ",33,"د",1,0],["فَارُوقُ يَا أُسَّ الرجا","ءِ وَمُلْتَقَى الركْنِ الأشَدِّ",34,"د",1,0],["فَارُوقُ فَرْدٌ في الْجَلاَ","لِ يَجِلُّ عَنْ وَصْفٍ وَحَدِّ",34,"د",1,0],["فَارُوقُ عِشْ نَجْماً يُضِيءُ","بِيُمْنِ إِقْبالٍ وَسَعْدِ",34,"د",1,0],["فاروقُ كم لكَ عندَ النيلِ من مِنَنٍ","كصفحةِ الشمسِ بيضٍ ليس ينساها",35,"ا",3,0],["فاروقُ أنت فتى العُروبةِ وابنُها","وبشيرُ وحْدتِها 