dctabudhabi.ae/diwan/poem/140950",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66042","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116992","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[77,"أنتم من مناسب الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=33807",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[33,"لَقد هَمَّ قيسٌ أنْ يَزجَّ بِنفْسِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2577",""],[32,"اشاقتك المعارف والطلول","https://www.poetsgate.com/ViewPoem.aspx?id=120",""],[100,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""]],"verses":[["في سيرَةٍ غَرّاءَ تُستَضوى بِها ال","دُنيا وَيَلبَسُها الزَمانُ الأَطوَلُ",0,"ل",1,0],["في ساعَةٍ لَمّا التَفَتُّ إِلى الصِبا","بَعُدَت مَسافَتُهُ عَلى الطُلّابِ",1,"ب",1,0],["فَيُسِّرَ نُجحُها وَلِكُلِّ نَفسٍ","مِنَ الطَلَبِ المَنيَّةُ أَو مُناها",2,"ا",3,0],["في ساعَةٍ تَذَرُ الأرْماحَ راعِفةً","والمَشْرَفيَّ على الأرواحِ مُحْتَكِما",3,"م",2,0],["فيَسْقي صَوارِمَهُ مِنْهُمُ","عَبيطَ دَمٍ ويُرَوّي قَناهْ",4,"ا",2,0],["فَيَسُرُّني وَيَهيجُ لي","حُزناً إِذا قَلَّت سُطورُه",5,"ر",2,0],["فيَسّرَ لليُسْرَى وأحْيَى بكَ الوَرى","وللرّوعِ إرْعادٌ علَيْكَ وإبْراقُ",6,"ق",1,0],["في سَبيلِ الإلاهِ مَجْدٌ توارَثْ","تَ كَريمَ الإصْدارِ والإيرادِ",7,"د",1,0],["في سبيلِ الإلاهِ أخْلاقُكَ اللا","تِي هيَ العَذْبُ في احْتِدامِ الجوادِ",7,"د",1,0],["في سبيل الإلاهِ علْم تروّي","هِ ونَقْلٌ مُصَحَّحُ الإسْنادِ",7,"د",1,0],["في سبيل الإلاهِ منْكَ خِلالٌ","تَذَرُ الشّهْبَ في حَضيضِ الوِهادِ",7,"د",1,0],["في سَبيلِ النيلِ وَالعِلمِ وَفي","ذِمَّةِ اللَهِ قَضى الإِثنا عَشَر",8,"ر",1,0],["في سَهلِها وَأَعاليها وَسَلسَلِها","بُرءُ العَليلِ وَسَلوى العاشِقِ العاني",9,"ي",1,0],["في سَبيلِ الجِهادِ وَالوَطَنِ المَح","بوبِ ما سالَ أَحمَراً مِن دِماكا",10,"ك",2,0],["في ساحَةِ البَدَوِيِّ حَلَّت ساحَةٌ","عِزُّ البِلادِ بِعِزِّها مَوصولُ",11,"ل",1,1],["فِي سَبِيلِ اللهِ مُرْتَحِلٌ","شَقَّ عَنْهُ مُظْلِمَ الحُجْبِ",12,"ب",1,0],["فَيُسْتَدَر الخَيْر ُ أَوْ تُتَّقَى","آفَاتُ بُؤْسٍ مُثْكِلٍ مُؤْتِمِ",13,"م",1,0],["فِي سَبِيلِ البِلادِ نَنْصُرُ مَنْ نَا","صَرَهَا أَوْ نَرُدُّ كَيْدَ الْخُصُومِ",14,"م",1,0],["في ساحة بثّ الأعادي حولها","زُمَراً تموج بخيلها ورجالها",15,"ل",3,0],["فيستريحَ فقير القوم منه ولا","يُبْلى به غير مُثرٍ ذي سفاهات",16,"ت",1,0],["في سبيل الأوطان متّم ففزتم","بأجلّ التحميد والتقديس",17,"س",1,0],["في سَيرِ شَهرَينِ ما يَطوي ثَمائِلَها","حَتّى تُشَدُّ إِلى أَغراضِها السُنُفُ",18,"ف",1,0],["فَيسَ البَراجِمِ شَرُّ الخَلقِ كُلِّهِمُ","أَخزاهُمُ رَبُّ جِبريلٍ وَميكالِ",19,"ل",1,0],["في سبيل العلى غمامٌ تولى","بعد ما أخصب الورَى إقباله",20,"ل",2,0],["في سبيل الله دمع فتىً","مسرع الأجفان من همل",21,"ل",1,0],["فَيسْبيكَ بالسحر الذي في جُفونِهِ","ويُصيبك بالسِّحر الذي هو نافثُهْ",22,"ث",2,0],["في سرورٍ يُريك شهرك يوماً","وحبورٍ يريك عامك شهرا",23,"ر",2,0],["في سرورٍ من شيمةِ الشاكر الصا","برِ لا شيمة الفروحِ الجزوع",24,"ع",1,0],["فيسقي منازلنَا صوبهُ","وليس له مجدُ شيبانِكا",25,"ك",2,0],["فيسير القصيدُ فيك بذمٍّ","مُرْمِضٍ جَرَّهُ لك استحقاقُك",26,"ك",1,0],["في سكرةِ الموتِ لنا مُذهلٌ","عنها وما أسرفتُ تمثيلا",27,"ل",2,0],["في سُنَّةِ القمرِ التمامِ وسِنِّه","واحسبْ لياليَه لها أعواما",28,"م",2,0],["في سبيلِ الشيطان منك نصيبي","وعليكَ العفاء لؤمَ ابن لوم",29,"م",1,0],["في سوء رأيك لي عن غيره شُغُلٌ","ينفي الكرى عن جفون العين والوسنا",30,"ن",2,0],["في سُفوحِ الهِضابِ وَالظِلُّ فيها","وَمَعَ النورِ وَهوَ فَوقَ الهِضابِ",31,"ب",1,0],["في سَبيلِ المالِ أَو عُشّاقِهِ","تَكدَحُ المَرأَةُ كَدحَ الإِبِلِ",32,"ل",1,0],["فَيَسيلُ ذاكَ المَدْمَعُ","الدَّامي لقَلْبِ الجدولِ",33,"ل",1,0],["في سِحْرِ أَزهارِ الرَّبيعِ","وفي تهاويل الغُيومْ",34,"م",1,0],["فيسكن فيهِ المرء غير مخير","بعيداً عن الخلان والأهل والصحب",35,"ب",1,0],["في سَوادَيها وَفي أَحشائِها","وَوَراءَ النَحرِ مِن حَبلِ الوَتين",36,"ن",1,0],["في سَماءِ اللَيلِ مَخلوعَ العِنان","ضاقَتِ الأَرضُ عَلَيهِ شَبَكا",37,"ك",2,0],["في سَبيلِ المَجدِ أَودى نَفَرٌ","شُهَداءُ العِلمِ أَعلاهُم مَقاما",38,"م",2,0],["في سِلاحٍ كَحُلِيِّ الغيدِ ما","لَمَسَت طَعناً وَلا مَسَّت ضِرابا",39,"ب",2,0],["في سَعَةِ الخافِقَينِ مُضطَرَبٌ","وَفي بِلادٍ مِن أُختِها بَدَلُ",40,"ل",1,0],["في سَرجِ ظامِئَةِ الفُصوصِ طِمِرَّةٍ","يَأبى تَفَرُّدُها لَها التَمثيلا",41,"ل",2,0],["في سَبيلِ العُلى قِتالُكَ وَالسِل","مُ وَهَذا المَقامُ وَالإِجذامُ",42,"م",1,0],["فيسرُّنِي ليلاً بحسنِ وفائِه","ويسوؤُني صُبْحاً بقبحِ جفائِهِ",43,"ا",3,0],["في ساعَةِ الخَوفِ أَتَتني المُنى","كَذاكَ تَأتي عُقَبُ الدَهرِ",44,"ر",1,0],["في سَماءٍ مِن خُضرَةِ الرَوضِ فيها","أَنجُمٌ مِن شَقائِقِ النُعمانِ",45,"ن",1,0],["في ساطِعٍ مِن غَياياتٍ وَمِن رَهَجٍ","وَعِثيَرٍ مِن دُقاقِ التُربِ مَنخولِ",46,"ل",1,0],["في سِر وائِرِ همّاتِ الوَرى هِمَمٌ","عَن دَركِها عَجزَت جِنٌّ وَأَملاكُ",47,"ك",1,0],["في سَبيلِ اللَهِ ما أَغفَلَنا","نَأمَنُ الدُنيا وَما أَغدَرَها",48,"ر",