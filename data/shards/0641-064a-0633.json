et/poem54131.html","الرمل"],[416,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[429,"لكل متيم في الحب حال","https://www.aldiwan.net/poem39865.html","الوافر"],[429,"في سفح بيت الدين قد دفق الصفا","https://www.aldiwan.net/poem40735.html","الكامل"],[432,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[432,"شق الصباح غلالة الظلماء","https://www.aldiwan.net/poem12771.html","الكامل"],[437,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[439,"طاعت لك الأحرار باستعبادها","https://www.aldiwan.net/poem34804.html","الكامل"],[439,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[441,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[458,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[458,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[458,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[458,"سقى زمنا ببابل عقربي","https://www.aldiwan.net/poem56146.html","الوافر"],[458,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[461,"ونبئت أن الليث قد شد أزره","https://www.aldiwan.net/poem15427.html","الطويل"],[461,"اذا سل سيف الرأي من غمد حزمه","https://www.aldiwan.net/poem15436.html","الطويل"],[461,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[461,"نيطت حمائل سيفه","https://www.aldiwan.net/poem16105.html","مجزوء الكامل"],[461,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[461,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[461,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[464,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[464,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[464,"ذاك سلع فاندب معي أطلاله","https://www.aldiwan.net/poem3614.html","عموديه"],[479,"قالوا هي الخضراء أرض فلاحة","https://www.aldiwan.net/poem37186.html","الكامل"],[479,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[482,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[493,"في سالب للشمس ثوب ضيائها","https://www.aldiwan.net/poem67319.html","الكامل"],[500,"محمد أجرت نوالا","https://www.aldiwan.net/poem37657.html","الوافر"],[505,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[513,"علام وقد أذبت القلب شوقا","https://www.aldiwan.net/poem67709.html","الوافر"],[514,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[529,"أقول من بعد حمد والصلاة على","https://www.aldiwan.net/poem37209.html","البسيط"],[536,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[538,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[538,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[551,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[551,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[551,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[551,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[551,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[558,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[558,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[562,"بني منسى فقدتم فاضلا علما","https://www.aldiwan.net/poem52618.html","البسيط"],[562,"في ساحة الحي من تيماء غزلان","https://www.aldiwan.net/poem52848.html","البسيط"],[567,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[575,"يا عاطل الجيد إلا من محاسنه","https://www.aldiwan.net/poem2854.html","البسيط"],[575,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"]],"verses":[["في سيرَةٍ غَرّاءَ تُستَضوى بِها ال","دُنيا وَيَلبَسُها الزَمانُ الأَطوَلُ",0,"ل",1,0],["في ساعَةٍ لَمّا التَفَتُّ إِلى الصِبا","بَعُدَت مَسافَتُهُ عَلى الطُلّابِ",1,"ب",1,0],["فَيُسِّرَ نُجحُها وَلِكُلِّ نَفسٍ","مِنَ الطَلَبِ المَنيَّةُ أَو مُناها",2,"ا",3,0],["في ساعَةٍ تَذَرُ الأرْماحَ راعِفةً","والمَشْرَفيَّ على الأرواحِ مُحْتَكِما",3,"م",2,0],["فيَسْقي صَوارِمَهُ مِنْهُمُ","عَبيطَ دَمٍ ويُرَوّي قَناهْ",4,"ا",2,0],["فَيَسُرُّني وَيَهيجُ لي","حُزناً إِذا قَلَّت سُطورُه",5,"ر",2,0],["فيَسّرَ لليُسْرَى وأحْيَى بكَ الوَرى","وللرّوعِ إرْعادٌ علَيْكَ وإبْراقُ",6,"ق",1,0],["في سَبيلِ الإلاهِ مَجْدٌ توارَثْ","تَ كَريمَ الإصْدارِ والإيرادِ",7,"د",1,0],["في سبيلِ الإلاهِ أخْلاقُكَ اللا","تِي هيَ العَذْبُ في احْتِدامِ الجوادِ",7,"د",1,0],["في سبيل الإلاهِ علْم تروّي","هِ ونَقْلٌ مُصَحَّحُ الإسْنادِ",7,"د",1,0],["في سبيل الإلاهِ منْكَ خِلالٌ","تَذَرُ الشّهْبَ في حَضيضِ الوِهادِ",7,"د",1,0],["في سَبيلِ النيلِ وَالعِلمِ وَفي","ذِمَّةِ اللَهِ قَضى الإِثنا عَشَر",8,"ر",1,0],["في سَهلِها وَأَعاليها وَسَلسَلِها","بُرءُ العَليلِ وَسَلوى العاشِقِ العاني",9,"ي",1,0],["في سَبيلِ الجِهادِ وَالوَطَنِ المَح","بوبِ ما سالَ أَحمَراً مِن دِماكا",10,"ك",2,0],["في ساحَةِ البَدَوِيِّ حَلَّت ساحَةٌ","عِزُّ البِلادِ بِعِزِّها مَوصولُ",11,"ل",1,1],["فِي سَبِيلِ اللهِ مُرْتَحِلٌ","شَقَّ عَنْهُ مُظْلِمَ الحُجْبِ",12,"ب",1,0],["فَيُسْتَدَر الخَيْر ُ أَوْ تُتَّقَى","آفَاتُ بُؤْسٍ مُثْكِلٍ مُؤْتِمِ",13,"م",1,0],["فِي سَبِيلِ البِلادِ نَنْصُرُ مَنْ نَا","صَرَهَا أَوْ نَرُدُّ كَيْدَ الْخُصُومِ",14,"م",1,0],["في ساحة بثّ الأعادي حولها","زُمَراً تموج بخيلها ورجالها",15,"ل",3,0],["فيستريحَ فقير القوم منه ولا","يُبْلى به غير مُثرٍ ذي سفاهات",16,"ت",1,0],["في سبيل الأوطان متّم ففزتم","بأجلّ التحميد والتقديس",17,"س",1,0],["في سَيرِ شَهرَينِ ما يَطوي ثَمائِلَها","حَتّى تُشَدُّ إِلى أَغراضِها السُنُفُ",18,"ف",1,0],["فَيسَ البَراجِمِ شَرُّ الخَلقِ كُلِّهِمُ","أَخزاهُمُ رَبُّ جِبريلٍ وَميكالِ",19,"ل",1,0],["في سبيل العلى غمامٌ تولى","بعد ما أخصب الورَى إقباله",20,"ل",2,0],["في سبيل الله دمع فتىً","مسرع الأجفان من همل",21,"ل",1,0],["فَيسْبيكَ بالسحر الذي في جُفونِهِ","ويُصيبك بالسِّحر الذي هو نافثُهْ",22,"ث",2,0],["في سرورٍ يُريك شهرك يوماً","وحبورٍ يريك عامك شهرا",23,"ر",2,0],["في سرورٍ من شيمةِ الشاكر الصا","برِ لا شيمة الفروحِ الجزوع",24,"ع",1,0],["فيسقي منازلنَا صوبهُ","وليس له مجدُ شيبانِكا",25,"ك",2,0],["فيسير القصيدُ فيك بذمٍّ","مُرْمِضٍ جَرَّهُ لك استحقاقُك",26,"ك",1,0],["في سكرةِ الموتِ لنا مُذهلٌ","عنها وما أسرفتُ تمثيلا",27,"ل",2,0],["في سُنَّةِ القمرِ التمامِ وسِنِّه","واحسبْ لياليَه لها أعواما",28,"م",2,0],["في سبيلِ الشيطان منك نصيبي","وعليكَ العفاء لؤمَ ابن لوم",29,"م",1,0],["في سوء رأيك لي عن غيره شُغُلٌ","ينفي الكرى عن جفون العين والوسنا",30,"ن",2,0],["في سُفوحِ الهِضابِ وَالظِلُّ فيها","وَمَعَ النورِ وَهوَ فَوقَ الهِضابِ",31,"ب",1,0],["في سَبيلِ المالِ أَو عُشّاقِهِ","تَكدَحُ المَرأَةُ كَدحَ الإِبِلِ",32,"ل",1,0],["فَيَسيلُ ذاكَ المَدْمَعُ","الدَّامي لقَلْبِ الجدولِ",33,"ل",1,0],["في سِحْرِ أَزهارِ الرَّبيعِ","وفي تهاويل الغُيومْ",34,"م",1,0],["فيسكن فيهِ المرء غير مخير","بعيداً عن الخلان والأهل والصحب",35,"ب",1,0],["في سَوادَيها وَفي أَحشائِها","وَوَراءَ النَحرِ مِن حَبلِ الوَتين",36,"ن",1,0],["في سَماءِ اللَيلِ مَخلوعَ العِنان","ضاقَتِ الأَرضُ عَلَيهِ شَبَكا",37,"ك",2,0],["في سَبيلِ المَجدِ أَودى نَفَرٌ","شُهَداءُ العِلمِ أَعلاهُم مَقاما",38,"م",2,0],["في سِلاحٍ كَحُلِيِّ الغيدِ ما","لَمَسَت طَعناً وَلا مَسَّت ضِرابا",39,"ب",2,0],["في سَعَةِ الخافِقَينِ مُضطَرَبٌ","وَفي بِلادٍ مِن أُختِها بَدَلُ",40,"ل",1,0],["في سَرجِ ظامِئَةِ الفُصوصِ طِمِرَّةٍ","يَأبى تَفَرُّدُها لَها التَمثيلا",41,"ل",2,0],["في سَبيلِ العُلى قِتالُكَ وَالسِل","مُ وَهَذا المَقامُ وَالإِجذامُ",42,"م",1,0],["فيسرُّنِي ليلاً بحسنِ وفائِه","ويسوؤُني صُبْحاً بقبحِ جفائِهِ",43,"ا",3,0],["