 أبدا","https://www.aldiwan.net/poem69694.html","البسيط"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["الخَطبُ هَينٌ مَع صَفائِكَ لي","وَإِذا كَدَرتَ عَلَيَّ لَم يَهُنِ",0,"ن",1,0],["الخَمرَ ما أَكرَمَ أَكفاءَها","فَأَبعِدِ الهَمَّ بإِدنائِها",1,"ا",3,1],["الْخَيْلُ جُرْداً وَالرِّمَاحُ ذَوَابلاً","وَالْبِيضُ ذُلْقاً وَالْخَمِيسُ لُهَامَا",2,"م",2,0],["الخطُّ واللّفْظُ والمعْنى وما انتخَبَتْ","للكتْبِ منْ آلةٍ نورٌ على نورِ",3,"ر",1,0],["الخلْقُ يوْمَ العرْضِ جاهَكَ تعْتَفي","تأتي على قدَمِ الصَّغارِ وُفودا",4,"د",2,0],["الخَتْمُ يَحفَظُ مَضْنونَ الكِتابِ بهِ","وهْوَ الدّليلُ علَى مَضمونِ عِزّتِهِ",5,"ه",1,1],["الخائِضُ الغَمَراتِ في رَهَجِ الوَغى","وَالحَربُ حاسِرَةٌ بِغَيرِ قِناعِ",6,"ع",1,0],["الخلف أبعد ما نظرت مسافةً","في الشرق بين أسرةٍ وسرائر",7,"ر",1,0],["الخط للعلم إناء صفا","به لآيات النهى مجتلى",8,"ل",2,0],["أَلخَطِيبُ الَّذِي لِمِنْبَرِهِ العَا","لِي جَلالٌ كَمَهْبِطِ الإِلْهَامِ",9,"م",1,0],["أَلْخَلْقُ لَوْ يَثوبُ إِلَى الهُدَى","بِإِخَاءِ كُل مُقَلْنَسٍ وَمَعَمَّمِ",10,"م",1,0],["الخلق كالخطّ لا تقرأ لئامهمُ","واشطبعليهم بنعل إنهم غَلَط",11,"ط",1,0],["الخائِضو غَمَراتِ كُلِّ مَنِيَّةٍ","وَالضامِنونَ حَوادِثَ الأَيّامِ",12,"م",1,0],["الخيرُ في مَرْضاتِهِ كُلُّهُ","وإنَّمَا سَخْطَتُهُ بَرْحُ",13,"ح",1,0],["الخيرُ مَصْنوعٌ بصانِعِهِ","فمَتَى صنعْتَ الخيرَ أعقبكا",14,"ك",2,1],["الخائِضِ الغَمرَ وَالمَيمونِ طائِرُهُ","خَليفَةِ اللَهِ يُستَسقى بِهِ المَطَرُ",15,"ر",1,0],["الخَمرُ مِلءُ الجامِ لَكِن قَد مَضى","شَوقي إِلى الخَمرِ الَّتي في الجامِ",16,"م",1,0],["الخير كل في قصد الفتى","والشر كل الشر في الإسراف",17,"ف",1,0],["الخمر والسحر المبين وراءه","والشجو والزفرات والتَّذكار",18,"ر",1,0],["الختل من خلق الذئاب وشهوة","في الرأس يركبها الجبان فيشجع",19,"ع",1,0],["الخير عند للسلام مؤمل","والعون منك يرومه الضعفاء",20,"ا",2,0],["الخير في بحر حوي","ت وليس في بحر حواك",21,"ك",1,0],["الخُلفاءُ وَلدُ المَنصورِ","وَعَصرُهُ الزاهي أَبو العُصورِ",22,"ر",1,0],["الخَدُّ مِن دَمعي وَمِن فَيضِهِ","يَشرَبُ مِن عَينٍ وَمِن جَدوَلِ",23,"ل",1,0],["الخَيلُ حَولَكَ في الجِلا","لِ العَسجَدِيَّةِ يَنثَنين",24,"ن",1,0],["الخَوانُ دائِرَةٌ","المَلا لَها قُطُبُ",25,"ب",1,0],["الخاطِبُ العَلياءِ بِال","أَرواحِ غالِيَةِ المُهور",26,"ر",1,0],["الخَلْقُ ماضونَ والأيّامُ تَتْبَعُهُمْ","نَفْنَى جَميعاً ويبقى الواحِدُ الصَّمَدُ",27,"د",1,0],["الخائِضَ الغَمَراتِ غَيرَ مُدافِعٍ","وَالشَمَّرِيَّ المِطعَنَ الدِعّيسا",28,"س",2,0],["الخاطِرينَ عَلى أَعدائِهِم أَبَداً","مِنَ المَحامِدِ في أَوقى مِنَ الجُنَنِ",29,"ن",1,0],["ألخَيْلُ وَاللّيْلُ وَالبَيْداءُ تَعرِفُني","وَالسّيفُ وَالرّمحُ والقرْطاسُ وَالقَلَمُ",30,"م",1,0],["الخائِضونَ غِمارَ كُلَ كَريهَةٍ","وَالضامِنونَ حَوادِثَ الأَيامِ",31,"م",1,0],["الخَيرُ وَالشَرُّ عاداتٌ وَأَهواءُ","وَقَد يَكونُ مِنَ الأَحبابِ أَعداءُ",32,"ا",2,1],["الخُرقُ شُؤمٌ وَالتُقى جُنَّةٌ","وَالرِفقُ يُمنٌ وَالقُنوعُ الغِنى",33,"ا",1,0],["الخَيرُ أَفضَلُ ما لَزِمتا","وَالشَرُّ أَخبَثُ ما طَمِعتا",34,"ت",2,1],["الخَلقُ مُختَلِفٌ جَواهِرُهُ","وَلَقَلَّ ما تَزكو سَرائِرُهُ",35,"ر",2,1],["الخَلقُ يَمضي يَأُمُّ بَعضُهُمُ","بَعضاً فَهُم تابِعٌ وَمُتَّبَعُ",36,"ع",1,0],["الخَلقُ كُلُهُمُ عِيا","لُ اللَهِ تَحتَ ظِلالِهِ",37,"ل",2,0],["الخَيرُ خَيرٌ كَاسمِهِ","وَالشَرُّ شَرٌّ كَاسمِهِ",38,"م",2,1],["الخَيرُ وَالشَرُّ مُزدادٌ وَمُنتَقَصٌ","فَالخَيرُ مُنتَقَصٌ وَالشَرُّ مُزدادُ",39,"د",1,1],["الخصر وهم تكاد العين تخطئه","وجوده باب شك بعدما حسما",40,"م",2,0],["الخدُّ والقوامُ منهُ فاعلُ","نحو جرى الماءُ وجارَ العاملُ",41,"ل",1,0],["الخيلُ والرَّهَجُ المُثارُ حُروفُها","والنّارُ والدّمُ والبلاءُ المُطبِقُ",42,"ق",1,0],["الخير في الوادِي وفي أبنائِه","ما بَانَ عنه ولا عَراهُ زَوالُ",43,"ل",1,0],["الخَصمُ مُسْتوفزُ العُدوانِ مُرتقِبٌ","والشَّرُّ مُتَّقِدُ البُركانِ مُضطرِمُ",44,"م",1,0],["الخَيلُ تَجمَحُ وَالأَبطالُ مُدبِرَةٌ","فَوضى يَحيدُ عَنِ الداعينَ ناجيها",45,"ي",3,0],["الخيرُ فيه وفي أبيهِ فآمِنوا","يا قومُ وَانْطلِقوا لما أنا عازِمُ",46,"م",1,0],["الخَندقُ الهيجا حملتم عِبْئَها","والأمرُ جِدٌّ والخطوبُ صِعابُ",47,"ب",1,0],["الخزرجُ انطلقوا لنصرِ حليفهِم","ومضى لنصرتك الكُماةُ الدُّلَّفُ",48,"ف",1,0],["الخائِضينَ من الخُطوبِ غِمَارها","المُصْطَلِينَ مِنَ الحُروبِ لَظاها",49,"ا",3,0],["الخطوب اللائي نَزَلنَ جسام","قَد أَحلن الهَنا إِلى أَحزان",50,"ن",1,0],["الخَيطُ الأَبيضُ ضوءُ الصُبحِ مُنفَلِقٌ","والخَيطُ الأَسوَدُ لَونُ اللَيلِ مَكمومُ",51,"م",1,1],["الخَمرُ تُفّاحٌ جَرى ذائِباً","كَذالِكَ التُفّاحُ خَمرٌ جَمَد",52,"د",1,1],["الخاطِبينَ عَلى أَخيكَ كَأَنَّهُم","مِن هاشِمٍ وَكَأنَّني مَقبورُ",53,"ر",1,0],["الخَوفُ يُلجِئُها إِلى تَصديقِها","وَالعَقلُ وَيحمِلُها عَلى تَكذيبِها",54,"ب",3,0],["الخَيرُ كَالعَرفَجِ المَمطورِ ضَرَّمَهُ","راعٍ يَإِطُّ وَلَمّا أَن ذَكا خَمَدا",55,"د",2,1],["الخَلقُ مِن أَربَعٍ مُجَمَّعَةٍ","نارٍ وَماءٍ وَتُربَةٍ وَهَوا",56,"ه",3,1],["الخَيرُ خَيرٌ وَإِن طالَ الزَمانُ بِهِ","وَالشَرُّ أَخبَثُ ما أَوعَيتَ مِن زادِ",57,"د",1,1],["الخافِضِ الرافِعِ السَماءَ عَلى ال","أَرضِ وَلَم يَبنِ تَحتَها دِعَما",58,"م",2,0],["الخالِقِ البارِئِ المُصَوِّرِ في ال","أَرحامِ ماءً حَتّى يَصِيرَ دَما",58,"م",2,0],["الخَيرُ والشَّرُّ مَقْرُونانِ في قَرَنٍ","فَالخيْرُ مُتَّبَعٌ والشَّرُّ مَحْذُورُ",59,"ر",1,0],["الخير أن تَهوى الفتا","ة فَتى له حب شَريف",60,"ف",1,0],["الخبيثون للخبيثات في الشر","عة والطَيبون للطيبات",61,"ت",1,0],["الخمس من صلواتي","عبء على ثقيل",62,"ل",1,0],["الخير أن يستمر الناس إخوانا","والشر أن يهضم الإنسان إنسانا",63,"ن",2,1],["الخد موضوع بجانب زهرة","وَالشعر منبسط عَلى الريحان",64,"ن",1,0],["الخير في أن يعز المرء صنوته","وَالشر أن يهضم الإنسان إنسان",65,"ن",1,0],["الخائض الغمرات غير مدافعٍ","والشمري المجعن الدعيسا",66,"س",2,0],["الخيرُ والشرُّ بها توأمانْ","والحبُّ والشهوة في طبعِها",67,"ه",2,0],["الخائضونَ الفَجر بحر مصارع","السابحون على السَّعير اللافحِ",68,"ح",1,0],["الخَيلُ تَأبى غَيرَ أَحمَدَ حامِياً","وَبِها إِذا ذُكِرَ اِسمُهُ خُيَلاءُ",69,"ا",2,0],["الخلفاء الراشدون أربعه","مرضيةٌ سنتهم متَّبعه",70,"ه",1,1],["أَلْخَيْرُ كُلُّ مُنَاهُ فِي","حَرْبِ الزَّمَانِ وَفِي السَّلاَمِ",71,"م",1,0],["الخَلْقُ أَوْ جُلَّهُ يُجْزُوْنَ مِنْ قدَمٍ","عُرْفاً بِنُكْرٍ وَأَزْهَاراً بِأَشْوَاكِ",72,"ك",1,0],["أَلخُلُقُ اللَّيِّنُ يُلْف