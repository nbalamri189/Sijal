{"poems":[[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[85,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[53,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[93,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[91,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[47,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[47,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[168,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[438,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[463,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[487,"من هو أصل وجود","https://www.aldiwan.net/poem24334.html","عموديه"],[578,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[580,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138240",""],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104439","السريع"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117479","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53161","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93519","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129945","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94073","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93817","الخفيف"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122484","الكامل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110781","البسيط"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106695","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100186","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3741,"","https://poetry.dctabudhabi.ae/diwan/poem/121169","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86498","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127060","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90917","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90847","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136497",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136586",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83138","الرمل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130604","الكامل"],[416,"زَارَ ابْنُ زَائِدَة ِ الْمَقَابِرَ بَعْدَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=22371",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[3591,"ما أطعمتنا حسانٌ في مغانينا","https://www.poetsgate.com/ViewPoem.aspx?id=149377",""],[5173,"أقبل الأنس يجتلي بسرور","https://www.poetsgate.com/ViewPoem.aspx?id=169630",""],[5325,"خطب أناخ على الإسلام كلكله","https://www.poetsgate.com/ViewPoem.aspx?id=171970",""],[5397,"ما للزمان قديما طرده انعكسا","https://www.poetsgate.com/ViewPoem.aspx?id=157929",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[463,"لمنَ الطلولُ تراقصتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60065&r=&rc=121",""]],"verses":[["وُدٌّ تَقادَمَ عَهدُهُ فَصَفا","وَجَديدُ وُدِّ المَرءِ أَخلَقُهُ",0,"ق",2,0],["ودّتْ نجوم الأفق لو مثلت به","لتفوز فيه برتبة المستخدمِ",1,"م",1,0],["ودَّت حديثَهُمُ الولاةُ فربَّما","نفذتْ به في اليوم عشرُ خرائِطِ",2,"ط",1,0],["وَدَّت وَقَد نالَ الذُبولُ خُدودَها","لَو أَنَّ في الشَوقِ المُقيمِ ذُبولا",3,"ل",2,0],["ودّت ملائكة السماء لو انها","دفنته في العيوق او في الفرقد",4,"د",1,0],["وَدَّت رَعِيَّتُهُ لَوَ اَنَّ لَيالِياً","قَدُمَت بِهِ في المُلكِ وَالميلادِ",5,"د",1,0],["وَدِتُّ بَياضَ السَيفِ يَومَ لَقينَني","مَكانَ بَياضِ الشَيبِ كانَ بِمَفرَقي",6,"ق",2,0],["وَدَّت خَديجَةُ أَن يَرعى تِجارَتَها","وِدادَ مُنتَهِزٍ لِلخَيرِ مُغتَنِمِ",7,"م",1,0],["ودّتْ على استعلائها لو أنّها","زالت فأمستْ من حَصىً ورمالِ",8,"ل",1,0],["وَدَّتْ لَو اَنَّ اللَّهَ قالَ لها اضرِبي","فَمضتْ تُظلِّلها النسورُ الحُوَّمُ",9,"م",1,0],["ودّت أسنّتهم من طول ما فُصِلت","لو ركّبت منهمُ في الأدرعِ الفُتُلِ",10,"ل",1,0],["وَدت المرأة المسلسلة الإب","حار فوق السَفينة القوراء",11,"ا",2,0],["ودّت الورق لو خلعن من الحزن","عليك البياض والتطويقا",12,"ق",2,0],["وَدَّتِ النَّيِّراتُ لو هَبَطَتْ فِيهِ","فزَاد ازْدِهاءَهُنَّ ازْدهاؤُه",13,"ا",3,0],["وَدَّت لَوِ اشْتَملتْ بِفضْل رِدَائه","هَيْهاتَ ثَوْبُ المَجْدِ لَيْس يُعَار",14,"ر",1,0],["وَدَّت بِقاعُ بِلادِ اللَهِ لَو جُعِلَت","قَبراً لَهُ فَحَباها جِسمُهُ طيبا",15,"ب",2,0],["ودّتْ خدودُ الغيدِ لو ظفِرَتْ بما","نالته من ذاك الصِّباغِ العَندَمي",16,"م",2,0],["ودَّتْ لها لو أنها أسديةٌ","عليا تميمٍ أو بني شيبانِ",17,"ن",1,0],["ودّت تميم وفحولُ وائلٍ","من قبلها لو أنّها أشعارُها",18,"ر",3,0],["ودَّتْ فحولُ الجاهلي","يةِ أنّها أشعارُها",19,"ر",3,0],["ودت ملائكة","محمد عبد صالح",20,"ح",1,0],["وَدَّت أُمَيَّةُ لَو يُصابُ بِسَيفِها","يَكفيكَ جَمرَةً يا أَمَيَّةُ لَو كَفى",21,"ف",2,0],["ودَّت لو انْغَمَدَتْ ولكن تَفْتَدِي","هَامَ الورَى بَدَلاً من الأَجْفَان",22,"ن",1,0],["ودت بلاد الله لو تاحت لها","أمثاله لكنّ أحمد أوحد",23,"د",1,0],["ودت نجوم الافق لو أنها","تقلدت غر لئاليها",24,"ي",3,0],["ودت سياستهم اناس الحدوا","بعدا وسحقا سائسا ومسوسا",25,"س",2,0],["ودَّت ثغورُ الأقحوانِ لو أنها","كانت تعضُّ أصابعَ المنثورِ",26,"ر",1,0],["ودَّت على كُثرِ بناتٍ لها","أن لم تلد منهُنَّ إلاّها",27,"ا",3,0],["ودَّت المكرمات لو أنَّ منها","غسلته بدمعها العينان",28,"ن",1,0],["ودَّت المكرماتُ أن تفتديه","ببنيها الأماجد الكرماء",29,"ا",2,0],["ودّت به زهر النجوم مواقفي","وبذورها في السعد وهي كوامل",30,"ل",1,0],["ودت نجوم الأفق موقفه بها","تتلو مديحك والملوك دعاته",31,"ت",2,0],["وَدّت مَلائكة السَماء لَو أَنَّها","قَد غَسَّلته فَأَسبلت أَنواءها",32,"ا",3,0],["ودّت ثغور العذارى أن تكون على","أسوارِهه أبداً لو شَرُفت شرَفا",33,"ف",2,0],["ودت النظار في تاريخه","لو ترى الولدان في دار النعيم",34,"م",1,0],["ودت الآن لو بمرآك تحظى","وتمنى إيجابها أن تقبل",35,"ل",1,0],["ودَّت عرائِسُ مِن صَمِيمِ كِنانَةٍ","لَو أنَّهُ بنُحورِها مجعُولُ",36,"ل",1,0],["ودت محاسن مصر أن يكون لها","إلى محاسنه سمع وإبصار",37,"ر",1,0],["وَدَّت عِداهُ أن تكون رعِيّةً","أخذاً مِنَ الآرا بما هُوَ أحزَمُ",38,"م",1,0],["ودَت بأن تكونَ ذاتَ مَقدَره","حتى تًخاصِمَ اللئامَ الفَجَره",39,"ه",1,0],["ودت دراري الكواكب أبها","بالدر من حصبائه تترصع",40,"ع",1,0],["ودّتْ وقد كلِفتْ بوُدّكَ لو ثنَتْ","ركْبَ السُّرى واستأنفَتْ إبْقاءَها",41,"ا",3,0],["ودت لمغرمها سكب الدموع ولم","تشفق عليه فما أقسى تجنيها",42,"ي",3,0],["ودت عيوني لو تكون فما","تحسو سلافته وترشفه",43,"ف",2,0],["ودت دراري الشهب لو أنها","على ثراها كالحصا تنثر",44,"ر",1,0],["ودت دراري الزهر لو كانت له","عوض التمايم أو عقود جمان",45,"ن",1,0],["ودت لمولده تكون من القوا","بل أحسن الحور الحسان العين",46,"ن",1,0],["وَدَّت مِياهُ الأَرضِ أن تحظى بما","قَد حَظى الماءُ الذي فيها جرى",47,"ا",1,0],["ودتّ ملائكةُ السماء بأنها","خَلعت عليك جُناحها أكفانا",48,"ن",2,0],["ودَّت لتقضي في يوم النَوى أسفاً","لو كان ينفعُ أو يُجدي تأسفُها",49,"ف",3,0],["وَدَّت النَسمةُ لَو ضَنَّت بِهِ","وَضَنينٌ كُلُّ مَن يَحوِي ثَمينا",50,"ن",2,0],["ودت قلوب العالمين لو انها","ابدا لاعظمه الشريفة مرقد",51,"د",1,0],["ودتْ ربيعة ُ أنها قسمتْ لهُ","منها فعاشَ بشطرها الأعمارُ",52,"ر",1,0],["ودّت الغيد لو تكلّلن منهُ","ورشفن الغرام من سجعاته",53,"ت",2,0],["ودت ضرائرها لولا المعابة أن","نقول هذا جميل في تراقينا",54,"ن",2,0],["ودت الشمس أن يكون لها مث","ل ضيا حسنها فما نرتضيه",55,"ي",2,0],["ودت قريش على عز القبيل بأن","تفدى فتمنحك الارواح والمهجا",56,"ج",2,0],["ودت تغسله العلياء راغبة","بفيض دمع بمجرى عينها انبجسا",57,"س",2,0],["وَدّتْ سماءُ الورى لو أنها نزلتْ","للأرض كي ترتوي من نوره التمِم",58,"م",1,0],["ودتْ فحولُ الجاهل","ية ِ أنها أشعارها",59,"ر",3,0]]}