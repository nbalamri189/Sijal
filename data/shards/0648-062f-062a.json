{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[51,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[45,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[45,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[164,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[432,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[458,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[482,"من هو أصل وجود","https://www.aldiwan.net/poem24334.html","عموديه"],[573,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[575,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"]],"verses":[["وُدٌّ تَقادَمَ عَهدُهُ فَصَفا","وَجَديدُ وُدِّ المَرءِ أَخلَقُهُ",0,"ق",2,0],["ودّتْ نجوم الأفق لو مثلت به","لتفوز فيه برتبة المستخدمِ",1,"م",1,0],["ودَّت حديثَهُمُ الولاةُ فربَّما","نفذتْ به في اليوم عشرُ خرائِطِ",2,"ط",1,0],["وَدَّت وَقَد نالَ الذُبولُ خُدودَها","لَو أَنَّ في الشَوقِ المُقيمِ ذُبولا",3,"ل",2,0],["ودّت ملائكة السماء لو انها","دفنته في العيوق او في الفرقد",4,"د",1,0],["وَدَّت رَعِيَّتُهُ لَوَ اَنَّ لَيالِياً","قَدُمَت بِهِ في المُلكِ وَالميلادِ",5,"د",1,0],["وَدِتُّ بَياضَ السَيفِ يَومَ لَقينَني","مَكانَ بَياضِ الشَيبِ كانَ بِمَفرَقي",6,"ق",2,0],["وَدَّت خَديجَةُ أَن يَرعى تِجارَتَها","وِدادَ مُنتَهِزٍ لِلخَيرِ مُغتَنِمِ",7,"م",1,0],["ودّتْ على استعلائها لو أنّها","زالت فأمستْ من حَصىً ورمالِ",8,"ل",1,0],["وَدَّتْ لَو اَنَّ اللَّهَ قالَ لها اضرِبي","فَمضتْ تُظلِّلها النسورُ الحُوَّمُ",9,"م",1,0],["ودّت أسنّتهم من طول ما فُصِلت","لو ركّبت منهمُ في الأدرعِ الفُتُلِ",10,"ل",1,0],["وَدت المرأة المسلسلة الإب","حار فوق السَفينة القوراء",11,"ا",2,0],["ودّت الورق لو خلعن من الحزن","عليك البياض والتطويقا",12,"ق",2,0],["وَدَّتِ النَّيِّراتُ لو هَبَطَتْ فِيهِ","فزَاد ازْدِهاءَهُنَّ ازْدهاؤُه",13,"ا",3,0],["وَدَّت لَوِ اشْتَملتْ بِفضْل رِدَائه","هَيْهاتَ ثَوْبُ المَجْدِ لَيْس يُعَار",14,"ر",1,0],["وَدَّت بِقاعُ بِلادِ اللَهِ لَو جُعِلَت","قَبراً لَهُ فَحَباها جِسمُهُ طيبا",15,"ب",2,0],["ودّتْ خدودُ الغيدِ لو ظفِرَتْ بما","نالته من ذاك الصِّباغِ العَندَمي",16,"م",2,0],["ودَّتْ لها لو أنها أسديةٌ","عليا تميمٍ أو بني شيبانِ",17,"ن",1,0],["ودّت تميم وفحولُ وائلٍ","من قبلها لو أنّها أشعارُها",18,"ر",3,0],["ودَّتْ فحولُ الجاهلي","يةِ أنّها أشعارُها",19,"ر",3,0],["ودت ملائكة","محمد عبد صالح",20,"ح",1,0],["وَدَّت أُمَيَّةُ لَو يُصابُ بِسَيفِها","يَكفيكَ جَمرَةً يا أَمَيَّةُ لَو كَفى",21,"ف",2,0],["ودَّت لو انْغَمَدَتْ ولكن تَفْتَدِي","هَامَ الورَى بَدَلاً من الأَجْفَان",22,"ن",1,0]]}