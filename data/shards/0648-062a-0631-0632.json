{"poems":[[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88616","المتقارب"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118361","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83210","الوافر"],[3275,"","https://poetry.dctabudhabi.ae/diwan/poem/145181","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131975","الوافر"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141231","الطويل"],[5061,"النصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=156538",""]],"verses":[["وَترزم مثقلة بالقطار","كَما ارزمت موقرات الابل",0,"ل",1,0],["وترزن من قدامه وتسوقه","رعود على سقى البلاد تحرض",1,"ض",1,0],["وَتُرزِمُ بِالجَحافِلِ صَوتَ رَعدٍ","وَآخَرَ في المَعابِدِ لِلصَلاةِ",2,"ه",1,0],["وترزقنا الإخلاص في الأمر كله","ومُنَّ بتوفيق لجارٍ وصاحب",3,"ب",1,0],["وترزا في مغنيها النوادي","وغصن شبابه غض رطيب",4,"ب",1,0],["وَتَرزُمُ حِيناً فِيهِ حَتَّى كَأَنَّهًا","تَجُوزُ عَلَى العِلاَّت حَزناً وَقَردَدَا",5,"د",2,0],["وترزق إلي عاش بالدنياا عقيم","بَ البنوون وبالنعيم ومبتغاهہ",6,"ا",2,0]]}