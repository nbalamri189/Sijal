{"poems":[[55,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem30623.html","الطويل"],[65,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[64,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[47,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[47,"فؤاد بذكر الظاعنين موكل","https://www.aldiwan.net/poem65589.html","الطويل"],[33,"قد هاج حزني وعادني ذكري","https://www.aldiwan.net/poem42523.html","المنسرح"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[77,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[47,"فُؤادٌ، بذِكْرِ الظّاعنينَ، مُوَكَّلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32198",""],[33,"قد هاجَ حزني، وعادني ذكري،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18878&r=&rc=141",""],[139,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[189,"يا باسط العدل في بدو وفي حضر","https://www.aldiwan.net/poem14537.html","البسيط"],[203,"طال علي ليلي","https://www.aldiwan.net/poem45578.html","مجزوء الرجز"],[214,"ماس من التيه في غلائل","https://www.aldiwan.net/poem13335.html","مخلع البسيط"],[240,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[310,"رنت بفواتر الأجفان سكرى","https://www.aldiwan.net/poem56517.html","الوافر"],[361,"أمن سلمى بجنب أنخ مغان","https://www.aldiwan.net/poem24536.html","الوافر"],[382,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[385,"فؤاد كما يهوى هواك معذب","https://www.aldiwan.net/poem48814.html","الطويل"],[422,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[438,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[443,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[443,"بين العذيب فبانه المتناوح","https://www.aldiwan.net/poem2620.html","الكامل"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[463,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[463,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[466,"يا آل جعفر الفياض جودكم","https://www.aldiwan.net/poem16418.html","البسيط"],[475,"فلما قضاه الله لم يدع مسلما","https://www.aldiwan.net/poem4808.html","الطويل"],[556,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[556,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem47855.html","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122353","السلسلة"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70893","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62545","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120035","المتقارب"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21370","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108812","الطويل"],[1711,"","https://poetry.dctabudhabi.ae/diwan/poem/145760","المنسرح"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100968","الطويل"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114921","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110341","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42402","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53162","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137008",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137177",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140044",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74304","الخفيف"],[3171,"","https://poetry.dctabudhabi.ae/diwan/poem/198931","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130092","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87370","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87403","الطويل"],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206010","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126915","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92038","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91122","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216823","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85283","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199085","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94580","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95062","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[4680,"بلى إنها بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=185019",""],[1703,"الأربعون وقد قطعت مداها","https://www.poetsgate.com/ViewPoem.aspx?id=49870",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4831,"عاليه تنهض من كبوتها","https://www.poetsgate.com/ViewPoem.aspx?id=208037",""],[4875,"السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=133357",""],[4875,"صفحة الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=133835",""],[5295,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=177454",""],[5480,"تتزاحم شجوني","https://www.poetsgate.com/ViewPoem.aspx?id=9888",""],[5582,"أَهاجَ لَكَ التَّذْكارَ وَالوَجْدَ بارِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187213",""],[5660,"فَإِنّي لَفي عِشقِ الجِيادِ زَعيمُ","https://www.poetsgate.com/ViewPoem.aspx?id=23710",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5847,"مرحبا بالغيث","https://www.poetsgate.com/ViewPoem.aspx?id=210921",""],[5894,"ته بالجمال وطف على أوقاتي","https://www.poetsgate.com/ViewPoem.aspx?id=131412",""],[5309,"بلادي هوى الدنيا ومأوى الغرائب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573554",""],[463,"هل عند ريح الصبا من رامة ٍ خبرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60060&r=&rc=116",""]],"verses":[["تَلينُ عَلى مَسِّ الإِخاءِ مَضارِبي","وَإِن كُنتُ في الأَقوامِ مُستَحسَنَ الجِدِّ",0,"د",1,0],["تُليحُ بِهِمْ جُرْدُ المَذاكي عَوابِساً","وقد طاوَلَتْ أرماحَهُمْ صَهَواتُها",1,"ت",3,0],["تلينُ له نَبْعَتا دهْرِه","بصدمةِ رأيٍ يروضُ الصِّعابْ",2,"ب",1,0],["تُليمُ إِساءَةً وَأُلامُ حُبّاً","وَبَعضُ اللَومِ يُغري بِالخَليلِ",3,"ل",1,0],["تَلينُ وَتَقسو شِدَّةً وَتَأَلُّفاً","وَتُملي فَتَستَأني وَتَقضي فَتَعدِلُ",4,"ل",1,0],["تَلينُ حَتّى يَقولَ قَد خَدَعَت","مَن لَم يَكُن بِالنِساءِ ذا خَبَرِ",5,"ر",1,0],["تَلَيَّنَ وَاِستَرخَت خُطورُ الحَيا بِهِ","وَلَولا عَوالينا نَشا غَيرَ لائِنِ",6,"ن",1,0],["تَلِيّةُ عامٍ فُضَّ فيه خِتامُهَا","خلا قبلهُ التسعون في الدَّنِّ والتسع",7,"ع",1,0],["تَلِينُ إِلَيهِ النَّفْسُ وَهْيَ أَبِيَّةٌ","وَيَجْزَعُ مِنْهُ الْقَلْبُ وَهْوَ صَبُورُ",8,"ر",1,0],["تَلِينُ، وَتَقْسُو شِدّةً وَتَألّقاً،","وَتُمْلي، فتَستأني، وتَقضِي، فتَعدِلُ",9,"ل",1,0],["تلينُ، حتى يقول: قد خدعتْ!","مَنْ لَمْ يَكُنْ بِکلنِّساءِ ذَا خَبَرِ",10,"ر",1,0],["تَلَى على كلِّ نفسٍ من مهابته","في السرّ والجهر شْرطيّاً وقانونا",11,"ن",2,0],["تليدُ هوىً في الرسمِ حَتَّى كأَنَّما","هو الرسْمُ إِلاَّ أَنَّهُ غيرُ ذاهبِ",12,"ب",1,0],["تَلى مَساعيَك العظمى فما خرجتْ","به السعادةُ في قَصدٍ عن الأَثَر",13,"ر",1,0],["تلينُ في حديثها","وقلبها كالحجرِ",14,"ر",1,0],["تليد مجد سديد رأي","شديد بأس اغر باسل",15,"ل",1,0],["تَلينُ قِياداً لِلكَريمِ وَإِنَّها","لِكُلِ لَئيمِ الصِهرِ ذاتُ حُرانِ",16,"ن",1,0],["تَلينُ لِمَن يُسالِمُني قَناتي","وَتصلبُ إِن يرم ذو الغمزِ هصرا",17,"ر",2,0],["تليلُ الوحش قد أضحى يبابا","فمغنى دومَةِ القيعان فان",18,"ن",1,0],["تلين له في الود والأنس جانباً","ولكنه يقسو ويغلظ جانبه",19,"ب",2,0],["تَلين خداعاً لِلمُقَلب كَشحَها","كَما لانَ بَطن الأَفعوان فَتَلسب",20,"ب",1,0],["تلين الرزايا في حماك وإن قست","وكم لان منها في حماك صلاب",21,"ب",1,0],["تَلينُ لعزْمي بالعَراءِ العوائك","ولا أرى فيما تحنُّ الأرائكُ",22,"ك",1,1],["تليت في البلا في كل ماد","بين أهل النهى وبن العوام",23,"م",1,0],["تليث مناقبه وسيرّ ذكرهُ","بين الرواة وكلّ غارٍ رائح",24,"ح",1,0],["تلين تحت الدلِّ أعطافُه","وهو إذا استُعطِف لم يرحمِ",25,"م",1,0],["تلين لكم أعطافُها وهي شُمَّسٌ","وتُطلَق من أرساغها وهي تُشكَلُ",26,"ل",1,0],["تُلين الضروراتُ شُمْسَ النفوس","ويأبون في الضرّ إلا امتناعا",27,"ع",2,0],["تَلينُ خَلْقاً ويجفو خُلْقُها فكأنْ","في جسمِها الماءِ أُلْقِي قلبُها الحَجرُ",28,"ر",1,0],["تَلينُ للّهِ والإِخْوانِ فيهِ ولِلْ","عافي ويَخْشى سُطاكَ السَّيْفُ والأسَدُ",29,"د",1,0],["تَليدُ النَّدَى أَرسَى بِمُكَّةَ مَجده","عَلَى عَهدِ ذِي القَرنَينِ أَو كَانَ أَقدما",30,"م",2,0],["تَلينُ القلوبُ وفي صدرهِ","أصمُّ الجوانبِ كالجَلْمدِ",31,"د",1,0],["تَلينُ على مسِّ الإخاء مَضاربي","وإنْ كنتُ في الأقوام مُستخشنَ الحدِّ",32,"د",1,0],["تليت غليل الحسود في وظني","ما كان ليشفى من التغص لولاك",33,"ك",1,0],["تُلين لي نطقَها كي","أميلَ ميلاً علاها",34,"ا",3,0],["تليت آي حُسْنها الفتّانِ","فسجدنا لها على الأذقان",35,"ن",1,1],["تلين لعافيك مستعطفا","وتلقى الحروب بقلب حديدِ",36,"د",1,0],["تلي الانجيل بالذكر مدحا","لهما من بعد توراة موسى",37,"س",2,0],["تلينُ لِأَهلِ الغِلِّ وَالغمر مِنهُمُ","وَأَنتَ عَلى أَهل الصَّفاءِ فَظيظُ",38,"ظ",1,0],["تليه حروفٌ عكسها مثل طردها","وليس لها معنى يعد ويجمل",39,"ل",1,0],["تلينُ هزّاً واللّينُ شدَّتُها","كالحيَّةِ الصِّلِّ في تواثُبها",40,"ب",3,0],["تلين لأيدي الغامزين قناتها","لقلة أنصار وضعف حماة",41,"ه",1,0],["تُليجُ بريانِ العَسيب كأنَّه","عثاكيلُ قِنوٍ من سُمَيحَةَ أَيسرا",42,"ر",2,0],["تليت على أبنائه فرأوا بها","سفر النبوغ محبراً بيد الصبا",43,"ب",2,0],["تلينُ لمن تهواهُ في الحيِّ جانباً","فيركبها جَهلاً ويُحببها نضوى",44,"و",2,0],["تُليَتْ على الغازي الغياث ويمّمت","مغناك من ذاك المقام الهائل",45,"ل",1,0],["تليد المعالي يألف البذل والندى","وانمله من بعض اعداء ماله",46,"ل",2,0],["تلين تواضعاً وبها اعتلاء","وان تفخر ففي شرف الخلال",47,"ل",1,0],["تلين من تحته صخور","إذا مشى وهو في انكفاء",48,"ا",2,0],["تليت بَيننا عَلى كُل نَحو","إِذا رَوَتها دَلائل الخَيرات",49,"ت",1,0],["تلين صفاته في السلم حلماً","وعند الحرب ممتنع الصفات",50,"ت",1,0],["تلينُ الليالي القاسيات لوجههِ","وهل تثبت الظلماء والبدر ينظرُ",51,"ر",1,0],["تَليدُ شأوٍ عنا لكن نَراهُ الى","طَريفِ ما أَمعنت في العزّ لم يَصِلِ",52,"ل",1,0],["تَليدُ الهوى في مهجتي وطريفُهُ","ارى منهما جيشاً تلاهُ رديفُهُ",53,"ف",2,1],["تُليصُ العِشَاءَ بأذنابها","وفي مَدَر الأرضِ عنها فُضُولُ",54,"ل",1,1],["تلين لا عن هَوى لتنهشنا","كحيّة في الرِمال رَقطاءِ",55,"ا",2,0],["تليخ بربعك الوفاد عيسا","حكت زجل الرواعد بالرغاء",56,"ا",2,0],["تلينُ لهُ في وعظهِ وخِطابهِ","قلوبُ الورى لو أَنَّها الحَجَرُ الصَلدُ",57,"د",1,0],["تلينُ هَشاشةً وتَبِشُّ قُرباً","وتَلذَعُ بعدها لَذعَ الهَوامِ",58,"م",1,0],["تَليق لك الجَناتُ يا غُصنُ فازدهر","وَدُم في أَمان من مهيمن واسع",59,"ع",1,0],["تَلين الليالي بالرِجال وَتشتدُّ","وَغاية ما فيها يَروح كما يَغدو",60,"د",2,1],["تليكم غواشيها الغضاب وفوقها","شموس تميط الليل عن طلعة الفجر",61,"ر",1,0],["تلى فصلت لما أتا مجادل","فابلس حتى لا يكون جواب",62,"ب",1,0],["تلين عريكتهم للحسان","فيصفو الغرام لهم مشربا",63,"ب",2,0],["تليد من المجد الأثيل تراثكم","وفعل جميل من صنيع المقاول",64,"ل",1,0],["تليدُ قنسٍ زكيٍّ فرع شجرتهِ","سادَ البريَّة قد قلَّت نظائرهُ",65,"ر",2,0],["تلى تاريخها سادت سروراً","لميخائيلَ هنّوا بالسعادَه",66,"د",2,0],["تليق لآل صخر فارتضوها","نأوا عنها أولئك إذ أتوها",67,"ه",2,0],["تلين عظاته الجلمود حتى","تفجر منه سارية الدلوح",68,"ح",1,0],["تلين متون القول منه بخاطري","فاغرب عند النزع منها وأغرق",69,"ق",1,0],["تليقُ لكَ الأمجاد يا خير مَن سما","لترسمَ في آفاقك النصرَ موعدا",70,"د",2,0],["تليه عن أهليه منصرفاً إلى","الأوهام في حزبي