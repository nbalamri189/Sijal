{"poems":[[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[124,"يا أم لا تجزعي مما يداهمنا","https://www.aldiwan.net/poem49261.html","البسيط"],[147,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[203,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[396,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64227","المنسرح"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204434","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103489","السريع"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112500","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62847","الوافر"],[5605,"للمسيلة كل الحب !!","https://www.poetsgate.com/ViewPoem.aspx?id=159575",""],[6225,"سبيل البقاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81742&r=&rc=453",""]],"verses":[["وَكُلُّ ضَيعَةِ غالٍ حادِثٌ جَلَلٌ","وَلا كَضَيعَةِ أَقوامٍ وَأَوطانِ",0,"ن",1,0],["وكل ضائقة تعرو إلى فرج","وإن لليسر مثل العسر ميقاتا",1,"ت",2,0],["وَكُلٌّ ضارِبٌ فيها بِسَهمٍ","وَلَكِن فازَ مَن جَمَعَ السِهاما",2,"م",2,0],["وكل ضعيفَ الرأي منفتلُ الهوى","عن الحزمِ يمنى بالهوانِ فيخضعُ",3,"ع",1,0],["وكل ضيق سوف يتلوه فرج","ويأتي اليسر وينزاح الحرج",4,"ج",1,0],["وكلّ ضرب ن العياره لا","يلحقني فيه من يجاريني",5,"ن",2,0],["وكلّ ضَرَبَ الأشرفي منهُ","فَلا تَسَل بَعدَ ذاكَ عَنهُ",6,"ه",1,0],["وكلّ ضلال كاشف لك فكرة","وكم من رشاد للتجدد فاقد",7,"د",1,0],["وكلّ ضلال للتأمّل باعث","وكل رشاد للقناعة قائد",7,"د",1,0],["وكلُّ ضِدّين رأيناهما","جَوراً وما بينهما عَدلُ",8,"ل",1,0],["وكل ضياء في الغيابة خادع","ففجر الأماني للسجين كذوب",9,"ب",1,0],["وكلُّ ضريبةٍ الاكَ تُغْشَى","ومن ذا يَضْرِبُ السيفَ الحُسَامَا",10,"م",2,0],["وَكُلُ ضِيْقٍ بِهَا قَدْ بَاتَ مُنْفَرِجًا","اقْرَأ (أَبَا الفضلِ )إنْ ضَاقتْ بك الُسُبُل",11,"ل",1,0],["وكل ضوءٍ حبا فالشرقُ مَشرِقهُ","والغربُ مَغِربُه مُذ عمَّرَ البشرُ",12,"ر",1,0]]}