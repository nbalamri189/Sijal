{"poems":[[30,"تضاحكت أن رأت شيباً تفرعني","https://www.aldiwan.net/poem1241.html",""],[63,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[192,"اصعد بعزمك إن المجد متصل","https://www.aldiwan.net/poem35678.html","الكامل"],[201,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[369,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[371,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[454,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138364",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138332",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138196",""],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67013","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119923","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120085","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96684","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80209","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80182","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80207","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80232","البسيط"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75733","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79897","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48962","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125436","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126229","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93799","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108410",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216575","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136029","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135779","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94441","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83347","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33642","الكامل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22796","البسيط"],[4680,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=185914",""],[4767,"مرايا الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215048",""],[4900,"جبينك الشمس في الأضواء والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=181365",""],[4968,"حسبي وحسبك","https://www.poetsgate.com/ViewPoem.aspx?id=206759",""],[5064,"أين المشرق ؟","https://www.poetsgate.com/ViewPoem.aspx?id=199104",""],[5064,"رقصة هدب على إيقاع رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199160",""],[5145,"أنت إلهي وأنت معتمدي","https://www.poetsgate.com/ViewPoem.aspx?id=108165",""],[5271,"على ضفافكِ أَستطيبُ عَذابي","https://www.poetsgate.com/ViewPoem.aspx?id=60537",""],[5277,"مُرِّي ندىً","https://www.poetsgate.com/ViewPoem.aspx?id=191015",""],[5277,"صبا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=193677",""],[5277,"دعني أراك","https://www.poetsgate.com/ViewPoem.aspx?id=194543",""],[5278,"قِف... لا تَبِعْ ما ليسَ لَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=202801",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5411,"أسْعِفْ بنورك","https://www.poetsgate.com/ViewPoem.aspx?id=185785",""],[5431,"بكتاب عشقي اودعتْ كي أفتحه !!","https://www.poetsgate.com/ViewPoem.aspx?id=197671",""],[5582,"أَسْيانُ فِي الحُبِّ صَبٌّ قَلْبُهُ لَهِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187182",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[5582,"أَعَلَى المُحِبِّ المُسْتَهامِ مَلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187304",""],[5628,"في ذكرى شهيد الإنسانية الإمام الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178499",""],[5674,"أعمى الزمان قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=186707",""],[5674,"أمواجي لجرفك هادرة","https://www.poetsgate.com/ViewPoem.aspx?id=189089",""],[5686,"لو ماتت الأشجار ما مات الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=203365",""],[5803,"أنت الهيام وصبر العاشقين أنا","https://www.poetsgate.com/ViewPoem.aspx?id=104035",""],[5853,"روحان في فلك المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=175614",""],[5853,"((أنتِ الخلود ))","https://www.poetsgate.com/ViewPoem.aspx?id=175663",""],[5906,"أنتِ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=188016",""],[5956,"شكراً غفرتِ تطاولي الهمجِيَّا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181976",""],[5956,"أعانك الله في ترتيب أنفسكم","https://www.poetsgate.com/ViewPoem.aspx?id=193864",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[5975,"غاليتي..","https://www.poetsgate.com/ViewPoem.aspx?id=53267",""],[5567,"كن بي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81765&r=&rc=33",""]],"verses":[["أَنتِ الهَوى لَو تُواتينا زِيارَتُكُم","أَو كانَ وَليُكِ عَنّا غَيرَ مَحجوبِ",0,"ب",1,0],["أنتَ الهُمامُ الذي مَنْ هَمُّهُ أبداً","جَرُّ الحديدِ وذيلُ النَّقعِ مَجرورُ",1,"ر",1,0],["أنْتَ الهلاكُ لِباغٍ لا يكّفُ أذًى","أنتَ الملاذُ لِمَنْ ضاقَتْ بِهِ السُّبُلُ",2,"ل",1,0],["أنت ألهمتني القريض فأنصت","لنشيدي يا مصدر الإلهام",3,"م",1,0],["أنت ألهمتني الصفاء على الكرب","فأصبحت كالشعاع النقي",4,"ي",1,0],["أنت الهُمامُ الّذي دانَتْ له هِمَمٌ","إذا سواهُ ارتقَى عَلْياءها دَحَضا",5,"ض",2,0],["أَنتَ الهُمامُ القاهِرُ اِستِعبادُهُ","مَعَ الفَتى وَصادِقُ التَعَبُّدِ",6,"د",1,0],["أَنتَ الهِلالُ وَلَم يَكُن","طَيفُ البُدورِ سِوى الهِلالِ",7,"ل",1,0],["أنت الهمام الذي لولاك ما نهضت","عروبتي ومضت في عنف إعصار",8,"ر",1,0],["انت الهمام الفذ من شهدت له","بين الانام اواخر واوائل",9,"ل",1,0],["أنت الهمام المنتضى من عزمه","سيفا ولكن ليس مثل سيوف",10,"ف",1,0],["أنت الهمام غمام فضلك ممطر","يمناً وإسعاداً على البؤساء",11,"ا",2,0],["أنتِ الهَوَى لكنَّ سُلْوَانَ الهَوَى","قَصْرُ ابنِ مَعْنٍ والحديثُ شُجُوْنُ",12,"ن",1,0],["أنت الهمام الذي يضل حمى ال","مالِ لديه ويحفظ الجارِ",13,"ر",1,0],["أنت الهمام اليقظ المجتدي","والمستماح الحوّل القلّب",14,"ب",1,0],["أَنتَ الهمامُ الّذي أضحَت بِدَولتهِ","من المظالمِ أم للعدلِ تنتصفُ",15,"ف",1,0],["أَنتَ الهِمامُ الَّذي نَلقاهُ شَخصَ هُدىً","مِن جَوهَرِ العَقلِ مَجبولاً مِن الأَمَلِ",16,"ل",1,0],["أَنتَ الهِمامُ الَّذي جَلَّت مَهابَتُهُ","حَتّى تَجَلل مِنها السَهلُ وَالجَبَلُ",17,"ل",1,0],["أَنتَ الهمام الَّذي جَلَت مَهابَتُهُ","فامَّنَ القَطر يَنفي عارض الخَطَرِ",18,"ر",1,0],["أَنتَ الهمام الَّذي أَحيى الأَنامَ بِما","أَبانَهُ مِن رُموزِ العلمِ وَالعَمَلِ",19,"ل",1,0],["أَنتَ الهدى فلك النَدى فلك النَدا","لا مستغاث حاتم وَمهلب",20,"ب",1,0],["أنتَ الهزبرُ وإنَّما","لك حوزةُ الإسلامِ غابَه",21,"ب",2,0],["أَنت الهلالُ ومن له","قَدَمٌ بها يَرقى سُهاك",22,"ك",1,0],["أنتِ الهناءُ لقلبي والشَّقَاءُ له","فما أمَّرك في قلبي وأحلاكِ",23,"ك",1,0],["أنت إلهِى ولنوريّك فى","لطفكَ حَظٌ وخِتَامُ السَعَدَا",24,"د",2,0],["أنت الهمام الذي أيديه طائلة","بهمة قصرت عن وصفها الهمم",25,"م",1,0],["أَنتَ الهُدى أَعلى منائره","وَبنى سناه المفرد العلمُ",26,"م",1,0],["انت الهمامُ الباذخ الشان الذي ال","أقمار في الزرقاء من حساه",27,"ه",1,0],["أنت ألهمتني وكنتُ عيياً","منطقاً بذ منطق الفصحاء",28,"ا",2,0],["أنت إلهي حِلَّتي وحُلَّتي","وأنت جيشي وأنت منعتي",29,"ي",1,1],["أنت إلهنا بك احترسنا","عن العِدا وللمُنى التمسنا",30,"ن",2,0],["أنت الهمام الفاضل الحبرُ الَّذي","قد فاقَ خبراً في الأنام ومخبَرا",31,"ر",2,0],["أَنتَ أَلهَمتَني فَقُلتُ صَوابا","ربّ زِدني من صادِق الإلهامِ",32,"م",1,0],["أَنتَ أَلهَمتَني القِيامَ بخيرٍ","ربّ فَاِجعَل لكلِّ خَيرٍ قِيامي",32,"م",2,0],["أنتَ الهَوى وأنا الذي أقصيتَهُ","فازدَد فإني لا أفيقُ يقينا",33,"ن",2,0],["أَنتِ الهَوى وَمُنى نَفسي وَمُتعَتُها","أَقولُ ذاكَ وَلا أُخفيهِ عَن أَحَدِ",34,"د",1,0],["أنتِ الهوى والقلب أنتِ وجيبهُ","رغم الجراح ورغم من يتكبّرُ",35,"ر",1,0],["أنتِ الهواء الطَّلق لل","صدر المُعذَّبِ سكَّنا",36,"ن",2,0],["أنت الهمام بل البدر التمام بل الس","يف الحسام بل الصارم الذكر",37,"ر",1,0],["أَنْتَ الهَوَى حَيْثُ الرُّقِيُّ مَكاَنَةٌ","يُحْيِي رَمِيمِي وَاهِبًا فِيَّ القُوَى",38,"و",2,0],["أنتِ الهوَى، وأنَا الظّلالُ لروحهِ","فأنَا توحَّدُهُ وأَنْتِ المُطلَقُ",39,"ق",1,0],["أنتِ الهوَى يَا نِساءَ الكَونِ مُفرَدَةٌ","أُولَى وتختصِرُ الأكوَانَ فِي سَطْرِ",40,"ر",1,0],["أنت إلهي وأنت معتمدي","وأنت دون الأنام مستندي",41,"ي",1,1],["أنتِ الهدوء وكيف لا يجتاحني","شوقٌ إليكِ ينامُ في أَهدابي",42,"ب",2,0],["أنت الهوى العذري يدمي مهجتي","بعض الهوى يدمي كطعن بالأسلْ",43,"ل",1,0],["أنت الهوى..أنت النعيمُ ..ومنتهى","وجدي..وحبي إن غضبتِ سيشفعُ",44,"ع",1,0],["أنتِ الهوى العذريُّ من غيْماتِهِ","نبتَ اشتياقٌ فوقَ سطحِ الماءِ",45,"ا",2,0],["أنتَ الهَلوعُ بِطَبعِهِ","أنتَ المُكدِّرُ مَنهَلَكْ",46,"ك",1,0],["انتا لها يا رمز المماليك العظام","لا تنقد الملهوف في ما تمنا",47,"ن",2,0],["أنْتَ الهَوى وَ القَلْبُ فيكَ تَبَحَّرا","حُبُّ يَطوفُ بِهِ الشُّعورُ مُكَبِّرا",48,"ر",2,1],["أنت الهوى أيقونة قمرية","بكتاب عشقي اودعتْ كي أفتحه !!",49,"ح",2,0],["أَنْتَ الهُمامُ الَّذِي أَضْحَتْ بِدَوْلَتِهِ","مِنَ المَظالِمِ أُمُّ العَدْلِ تَنْتَصِفُ",50,"ف",1,0],["أَنْتَ الهُمامُ القَرْمُ هَلْ لَكَ مُشْبِهٌ","فِي المَكْرُماتِ وَفِي المَحامِدِ لا لا",51,"ل",2,0],["أَنْتَ الهُمامُ فَكَمْ نَماكَ إِلَى العُلا","شَرَفاً هُمامٌ أَكْبَرٌ وَهُمامُ",52,"م",1,0],["أنتَ الهدى غمرَ السرا","ئرَ منْ بعيدٍ أو قريبِ",53,"ب",1,0],["أنت الهوى في خافقي أخفيته","وأحيك شالاً من نجومٍ طائفه",54,"ف",2,0],["أنت الهوى يجري بروحي ساحرا","ودموع عيني في رحيلك ماطره",55,"ر",2,0],["أنت الهوى والحبُ في أكبادنا","سَكنُ القلوب على الروابي شيدا",56,"د",2,0],["أنت الهيام وصبر العاشقين أنا","بمرفأ فاض من أحداقه الألقُ",57,"ق",1,0],["أنتِ الهواء ..فهل أعيش بدونهِ؟","أنتِ الربيعُ. بدون زهرك من أنا؟!",58,"ن",2,0],["أنت الهوى..أنت الغرام وما أنا","إلاك في قلبي الحنين الساري",59,"ر",2,0],["أنت الهوى لو تعلمين مواجعي","وعلى شفاهك بسمة تشفيني",60,"ن",2,0],["أنتِ الهناء لخافقي أنتِ الشفا","لكنْ لماذا تسكنين قَصِيا؟",61,"ي",2,0],["أنت الهواء الذي يَجْري بأفئدتي","ولا أطيق مكاناً عنك في بُعُدِ",62,"د",1,0],["أنتَ الهباتُ من الرحيم لشعبنا","وبفكركم تتطوّر الدولاتُ",63,"ت",1,0],["أنتِ الهناءُ وطيبُ العيشِ آسرتي","بمنطقِ الحسنِ إنّي فيهِ مأسورُ",64,"ر",1,0],["أنت الهوى أسراره وصلاته","وحروفه وغرامه المدفونُ",65,"ن",1,0]]}