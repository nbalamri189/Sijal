{"poems":[[88,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[87,"قد سمع الثعلب أهل القرى","https://www.aldiwan.net/poem8006.html","السريع"],[50,"يا بشر ما لي والسيف والحرب","https://www.aldiwan.net/poem10776.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[89,"أربَّة ُ العودِ ، أم قمريَّة ُ السَّحرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23928&r=&rc=190",""],[215,"لم تنسني فتنة الدنيا وزينتها","https://www.aldiwan.net/poem46640.html","البسيط"],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[371,"صمت عن الشكوى وأيقنت أنني","https://www.aldiwan.net/poem17750.html","الطويل"],[382,"كفاك يا راهبا إن كنت تتوانى","https://www.aldiwan.net/poem59231.html","البسيط"],[409,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[484,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"],[484,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59630","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6784","المنسرح"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132838","البسيط"],[333,"","https://poetry.dctabudhabi.ae/diwan/poem/110986","المجتث"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103165","الوافر"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4675,"المرجان في وصف الخلان","https://www.poetsgate.com/ViewPoem.aspx?id=201394",""],[5387,"مطاردة","https://www.poetsgate.com/ViewPoem.aspx?id=53768",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[6186,"الأساطير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82886&r=&rc=6",""]],"verses":[["فَلا تَثِقوا بِوَعدِ القَومِ يَوماً","فَإِنَّ سَحابَ ساسَتِهِم جَهامُ",0,"م",1,0],["فَلا تَثِق يَوماً بِذي حيلَةٍ","إِذ رُبَّما يَنخَدِعُ الثَعلَبُ",1,"ب",1,0],["فَلا تَثِق بي فَإِنَّني رَجُلٌ","أَكُعُّ عِندَ اللِقاءِ وَالطَلَبِ",2,"ب",1,0],["فَلا تَثِقْ بِوَفَاءِ الدَّهْرِ إِنَّ لَهُ","غَدْراً يُفَرِّقُ بَيْنَ الْعُودِ والثَّمَرِ",3,"ر",1,0],["فَلا تَثِقْ بِوَدَادٍ قَبْلَ مَعْرِفَةٍ","فَالْكُحْلُ أَشْبَهُ فِي الْعَيْنَيْنِ بِالْكَحَلِ",4,"ل",1,0],["فَلاَ تَثِقْ بِوَفَاءِ الدَّهْرِ، إِنَّ لَهُ","غَدراً يفوِّقُ بينَ العودِ والثمرِ",5,"ر",1,0],["فلا تثير مغانيه ونضرتهُ","في ظل ذكراك غير الهم والحزن",6,"ن",1,0],["فَلا تَثِقوا بِأَن أَبقى فَإِنَّ ال","بَقاءَ عَلَيَّ بَعدَكُمُ حَرامُ",7,"م",1,0],["فَلا تُثبِتَن في الصَدرِ ما لَيسَ يَنمَحي","فَرَبُّكَ يمحوما يَشاءُ وَيُثبِتُ",8,"ت",1,0],["فلا تثق بكلامٍ غيرَ مختبرٍ","إن الشياطين لا يؤذون رُهبانا",9,"ن",2,0],["فلا تثٍقَنْ يوماً بشيء تناله","فعما قريبٍ قد رأيت لها سلبا",10,"ب",2,0],["فلا تثريب إن خطرت بتيه","وجرت ذيل طهر فوق طرس",11,"س",1,0],["فلا تثني عزيمته العوادي","ولا تودي بهمته الحطوم",12,"م",1,0],["فلا تثق بجفون بانَ ناظرها","ولا بملك فقيد السمع والبصر",13,"ر",1,0],["فلا تثقل بلوم في الحبيب فلي","باللوم والحب تخفيف وتثقيل",14,"ل",1,0],["فَلا تَثِق بِالغِنى فَآفَتُهُ ال","فَقرُ وَصَرفُ الزَمانِ ذو دُوَلِ",15,"ل",1,0],["فلا تَثِق بأخٍ تُرضيك صحبتُه","وَكُن من الصَّاحِبِ الأدنى على حَذَرِ",16,"ر",1,0],["فلا تثيروا ظُنونا","ولا تديروا اتهاما",17,"م",2,0],["فلا تثقن من النوكي بشيءٍ","ولو كانوا بني ماء السماء",18,"ا",2,0],["فلا تثق من قينة بعهد","من ذا الذي أهواه في الدراري",19,"ي",1,0],["فلا تثقنْ بهم إن كنت حرا","ولا تُضجر فؤادك بالولاء",20,"ا",2,0],["فلا تثر الغبار على طريقي","وتحكي عنك شائعة وعني",21,"ن",2,0],["فلا تثقنْ منها بعهدٍ فإنها","لأغدرُ أنثى لا تدوم على إلِ",22,"ل",1,0],["فلا تثوري فهذا لحنُ أغنيتي","وليس فيها سوى بعض المحاذير",23,"ر",1,0]]}