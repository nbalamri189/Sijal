{"poems":[[95,"أشفت غليل فؤادك الظمآن","https://www.aldiwan.net/poem11277.html","الكامل"],[53,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[53,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[93,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[136,"تجاوز قدر الذم ذا الفاسق الغوي","https://www.aldiwan.net/poem54649.html","الطويل"],[275,"نظرت إلى ماوية أطلعت لبنى","https://www.aldiwan.net/poem35230.html","الطويل"],[443,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[505,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[505,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[505,"دار الولي إذا ما مات عامرة","https://www.aldiwan.net/poem37758.html","البسيط"],[505,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[567,"كريم قد تولاه الكريم","https://www.aldiwan.net/poem52763.html","الوافر"],[580,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101724","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130832",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204788","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132541","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139973","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48275","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205895",""],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76717","المتقارب"],[4710,"شطّ المزار","https://www.poetsgate.com/ViewPoem.aspx?id=203119",""],[4755,"ثِبي يا هُمُومِي.. وضِقْ يا فضاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=187670",""],[4767,"فرزنو","https://www.poetsgate.com/ViewPoem.aspx?id=178386",""],[5409,"أتراهم من وحشةِ الأرض طاروا","https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5464,"قانا","https://www.poetsgate.com/ViewPoem.aspx?id=8311",""],[5612,"مُتَّكَأُ المَوْت","https://www.poetsgate.com/ViewPoem.aspx?id=179836",""],[5694,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=132098",""],[5956,"الكون في عينيَّ صِهري مصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=200542",""],[5956,"قد رحبتْ قَطَنا بخيرِ مُفكِّر","https://www.poetsgate.com/ViewPoem.aspx?id=207490",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6233,"موكب ... لحرية الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78453&r=&rc=16",""]],"verses":[["سَيَطُولُ لَيْلُ السَّاهِرِينَ وَلَيْلُهُ","شَوْقاً إِلَى إِنْشَادِكَ الرَّنَّانِ",0,"ن",1,0],["سيطول عمرُ إمامنا في غبطة","حتى يواكبَ من بنيه موكباً",1,"ب",2,0],["سيطلبني فضلُهُ عائداً","كما يتتبَّعُ سيلٌ مسيلا",2,"ل",2,0],["سَيَطرَحُكِ الإِنسانُ خارِجَ دارِهِ","إِذا لَم يَكُن فيكِ العَشِيَّةَ طيبُ",3,"ب",1,0],["سيَطْلُبُني رِزْقي الذي لو طَلَبْتُهُ","لمَا زادَ والدنْيا حُظوظٌ وإقْبال",4,"ل",1,0],["سيطريك مدحا إن غدا متضلعاً","من الخبز واللحم القديد أو الشوي",5,"و",2,0],["سيطلعُ يوماً وجهُها فيكِ فاشهدي","على وَقفةِ الولهانِ في الخدرِ والمغنى",6,"ن",2,0],["سيط الأنامل بسام إذا انقبضت","أيدي الليالي عن معرفه الجاري",7,"ر",2,0],["سيطويك منا سهمُ فتكٍ مجلجلٌ","تذوبصُ لمعناهُ الجبال الجلامدُ",8,"د",1,0],["سيطمس من أعدائنا كلَّ بارزٍ","ويظهر في برج التجلي جلالنا",9,"ن",2,0],["سيُطْلِعُ اللهُ منهُمْ بدرَ معرِفَتي","يُجْلى ومن دونِهِ في النَّسْجِ كِيوَانُ",10,"ن",1,0],["سَيُطْلِعُ الله بِسَمْكِ عِزِّهِ","لنا صَباحاً بالسَّنا مُرَفْرَفا",11,"ف",2,0],["سَيطرقُ كلَّ جسمٍ فيهِ روحٌ","فلا تَبقَى الحياةُ ولا الجُسومُ",12,"م",1,0],["سَيُطَاعُ أَمْرُكَ فيهم","إِنَّ الأُمور لَها أَمَائِر",13,"ر",1,0],["سيطفئ نار الأفك سيل عرمرم","من الصدق مشفوع بسيل عرمرم",14,"م",1,0],["سيطرته مواهب العقل في الا","رض فامسى مطود السلطان",15,"ن",1,0],["سيطغى عليكم سحرنا في بياننا","ألا انما سحر البيان هو السحر",16,"ر",1,0],["سيطيل الاله منكم بُكاء","ويطيل الاله منه ابتسامه",17,"م",2,0],["سيطهرون ثراك","من دنس العدو المغتصب",18,"ب",1,0],["سيطفأ يومَ الحشر عند لقائه","على الحوضِ بالكاس الروِّية إذ أعطو",19,"ط",2,0],["سيُطلِعُ في ليلِ العجاجِ نُصولَهُ","نُجوماً ويُبْدي منْ عزيمتِه فجْرا",20,"ر",2,0],["سيطول أيام الصدود وسؤلنا","لك عن مواقع هذه الألطاف",21,"ف",1,0],["سيطول بحثي عنه في","وادي الخمول ولا لقاء",22,"ا",2,0],["سيطلبني الملك مهما أراد","لباس نسيج من المفخر",23,"ر",1,0],["سيطلعُ الفجرُ من أنقاضِ مئذنةٍ","وسوف يرجعُ رغم البغي من رحلوا",24,"ل",3,0],["سَيُطوَى بهِ اللَّيلُ حَتَّى","يَقُولَ المَسَاكِينُ: لا عُدْتِ يا كَهرباءُ",25,"ا",2,0],["سيطلب العلم فيها","فلي بها اليوم شأن",26,"ن",1,0],["سيطر الاقوياء فيها على الأر","ض فما للضعيف منها قرار",27,"ر",1,0],["سِيْطَ الخنوعُ مع الشهامةِ فاستوى","نورٌ بأحْداقِ الضحى وسَوادُ",28,"د",1,0],["سيطْلُبُكَ اليَوْمَ كأْسُ المَنونِ","وغايةُ أمْرِكَ أن تنْهَلهْ",29,"ل",2,0],["سيطر على القلب وإصنع من ضلوعي جسور","ووفاك وإخلاصك وصدقك جواز المرور",30,"ر",1,0],["سيطوِّرون الطيبة العظمى التي","بنفوسهم حتى الخباثة في الكوائن تنسفا",31,"ف",2,0],["سيطوِّر الدنيا بحُسْن تدبُّرِ","وخيالُهُ فاق السُّها والمشتري",32,"ر",2,0],["سَيُطارِدُونَكَ في البِحا","رِ, وَفي الفَضاءِ, وَفي البَلاقِعْ",33,"ع",1,0],["سيُطاع بحقّ ولايته","والوالد يعرف أولاده",34,"د",2,0]]}