{"poems":[[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[74,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[45,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[47,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[63,"لله حسان فتى معرقا","https://www.aldiwan.net/poem51514.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54834","الرجز"],[173,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[189,"لله حمام كروض أنيق","https://www.aldiwan.net/poem14603.html","السريع"],[214,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[280,"حفت بحضرتك الفتوح جيوشا","https://www.aldiwan.net/poem25465.html","الكامل"],[369,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[398,"بدت عذارى مدت سرادقها","https://www.aldiwan.net/poem53489.html","المنسرح"],[435,"رفقا بأسيرك يا أسما","https://www.aldiwan.net/poem41412.html","المتدارك"],[463,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[505,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[519,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[519,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[556,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[563,"لله حمدي دائما في الورى","https://www.aldiwan.net/poem33821.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138238",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138380",""],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53756","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39149","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62561","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56081","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11858","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78010","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108572","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108885","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101889","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100998","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66316","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100468","السريع"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69494","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138802",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53041","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27735","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109468","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113055","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110621","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106836","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26196","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137377",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94266","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101629","السريع"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87524","المنسرح"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112294","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138707",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108369",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66358","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85049","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85195","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85204","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70162","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90799","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117297","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72749","البسيط"],[4691,"لله حب راح لا يتكرر","https://www.poetsgate.com/ViewPoem.aspx?id=123986",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[5376,"يا ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5533,"في ذكرى المولد النَّبَوي","https://www.poetsgate.com/ViewPoem.aspx?id=176283",""],[5720,"عاصِفةُ الحَزْم","https://www.poetsgate.com/ViewPoem.aspx?id=199941",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"من أجل نقوده تقتله","https://www.poetsgate.com/ViewPoem.aspx?id=182526",""],[5956,"وردتان بجُنَيْنتي","https://www.poetsgate.com/ViewPoem.aspx?id=207469",""],[6225,"إلى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78030&r=&rc=115",""]],"verses":[["للهِ حضرتك العليّة لم تزلْ","يُلقي الغريبُ بها عصا التسيارِ",0,"ر",1,0],["لله حجر بذاك البيت أو حجر","ما للهنا فيهِ حجر عنك محجور",1,"ر",1,0],["لِلَّهِ حالٌ أُرَجّيها وَتُخلِفُني","وَأَقتَضي كَونَها دَهري وَيَمطُلُني",2,"ن",2,0],["لِلَّهِ حِلمٌ يَومَ بُرقَةِ ثَهمَدٍ","يَهفو بِهِ بَينُ الغَزالِ الأَهيَفِ",3,"ف",1,0],["للهِ حَسَّانٌ فتىً مٌعْرِقاً","في حِذْقِه وابنُ فتىً مُعْرِقِ",4,"ق",1,1],["للهِ حَيْدَرُ مِنْ فَتَىً","أَخْلاقُهُ فَوقَ المَلامِ",5,"م",1,0],["لِلهِ حُسْنُ بِلائِهِمْ لَمَّا أَبَوْا","مُتَضَافِرِينَ دَوَامَ تِلْكَ الحالِ",6,"ل",1,0],["للهِ حَفْلٌ ضم أَسْمَى نُخْبَةٍ","مِنْ وُزَرَاءِ اللهِ وَالجُّمْهُورِ",7,"ر",1,0],["لِلّهِ حَدسُ أَبِيهِ إِذ تَأَمَّلَهُ","في المَهدِ لَمّا يُبن عَن لا وَلا نَعَمِ",8,"م",1,0],["للهِ حمام كروضٍ أنيقْ","رافقني فيه رقيقٌ رفيقْ",9,"ق",1,1],["لله حين رقى عليه ساجعا","في حلة يزهو وحسن مطلق",10,"ق",1,0],["لِلّهِ حالٌ أدانِيها وتُبعدُني","وأشتِهي قُربَها مِنّي وَتنجذِمُ",11,"م",1,0],["للَّهِ حِمْصُ وَفَوْزُها بِسَعادَةٍ","هَدَتِ الجَزِيرَةَ نَحْوَها وَشَرِيشا",12,"ش",2,0],["لِلّهِ حَيٌّ قد عَهِدْتُ قِبابَهمْ","ضُربَتْ على العَلَمَيْنِ من أَوطاس",13,"س",1,0],["لِلَّهِ حَلف العلى أَبو حسنٍ","وَقَد جَرت لِلعلى سَوابِقُها",14,"ق",3,0],["للَه حواجبك اللاءي","من جفن اللحظ رمت سهما",15,"م",2,0],["لله حاجةُ نفسٍ مذ وهبتُ لها","ثوبَ السلِّو خلعتُ السقمَ عن بدني",16,"ن",2,0],["للهِ حَيَّى على الفَلاحِ فإنَّني","أَعلنْتُ من طيِّ الخَفا بأَذاني",17,"ن",2,0],["للَّه حيٌّ إذا أقمارُهُ غربَتْ","أغنَتْكَ عنها وُجوهٌ من غَوانِيهِ",18,"ي",2,0],["للّهِ حيٌّ أشبهَتْ بصفاحِها","فِتيانُه اللفتاتِ من فتياتِهِ",19,"ت",2,0],["للّهِ حيٌّ إذا أوتادُه ضُرِبَتْ","يودُّها الصّبُّ لو كانت بمُهجتِهِ",20,"ت",2,0],["للَّهِ حِلْمُك والرِّواقُ يُرى بهِ","للسائلين من الوفود وفودُ",21,"د",1,0],["لله حمدي دائماً في الورى","حمد مقيم النعمة القاطنِ",22,"ن",1,1],["لله حسن نشائد","فاقت على الدر النضيد",23,"د",1,0],["لله حفلةُ أنس قد زهت فرحا","بمن حوتهم من الاشراف والكرما",24,"م",2,0],["للّه حزمٌ وجودٌ ضمّه جدثٌ","ومكرماتٌ طواها التّربُ والمدرُ",25,"ر",1,0],["للهِ حَمَّامٌ حَكَتْنِيْ حالُهُ","ماءٌ يَصُوبُ وحَرُّ نارٍ تُضْرَمُ",26,"م",1,1],["لِلَّهِ حمدي ثُمَّ كُلّ الشُكر لَه","إِذ بَلَّغ العَبد الضَعيف أَمله",27,"ه",1,0],["لله حمدان إن ضاق الزمان على","بنيه عاشوا بفضل منه هتّان",28,"ن",1,0],["لله حسرة بطرس كم أورثت","ني حرقة فيهبا اذوب تهيمّا",29,"م",2,0],["لِلَّهِ حادِثَةٌ رَمَت بِيَ جانِبَيَّ","هَذا الحِمى وَطِمِرَّةٌ جَرداءُ",30,"ا",2,0],["لله حسن مقاله","مهما تحدث أو قرا",31,"ر",2,0],["للَه حسنُ وحسنها يوم النوى","يوري الجوى ويزيل لوم اللاحي",32,"ح",2,1],["للَه حُسن وحسنها الغضُّ الذي","هامت به عربُ الرها والرومُ",33,"م",1,1],["لله حمدي وعلى الهداة","محمد وآله صلاتي",34,"ي",1,1],["للَه حبك من تحب وبغضه","للَه تُنجد من دعا وتجير",35,"ر",1,0],["لله حين توسلوا بالمرتضى","أفلا تراهم أدركوا ما أمَّلوا",36,"ل",3,0],["للَه حزن ناب في فقده","ومدمع مذ شط عنا سجوم",37,"م",1,0],["لِلَّهِ حِبّي وَتِربُ حِبّي","لَيلَةَ أَعياهُما مَرامي",38,"م",2,0],["لله حملته لو صادفت فلكا","لخر هيكله الاعلى على الذقن",39,"ن",1,0],["لله حلمك أيما جبل","ما قيل يوماً هزه الغضب",40,"ب",1,0],["لله حكم اقتدارٍ لا يزايله","كما القبولُ لنا فاسلك على أثري",41,"ر",2,0],["لله حبلٌ فِصله تصعد","فإنْ تكن حبلَه قطعتا",42,"ت",2,0],["لِلّه حسن ذلك المنقارِ","من ذهبٍ قد صيغ لا من قارِ",43,"ر",1,0],["لِلّهِ حَقٌّ لاَ يَكُونُ لِغَيرِهِ","وَلِعَبدِهِ حَقٌّ هُمَا حَقَّانِ",44,"ن",1,0],["لله حسن مقامنا","إذ نحن في البسط السراح",45,"ح",1,0],["للَه حبر له بحر العلوم أب","لقد زكا والداً فينا ومولودا",46,"د",2,0],["للَه حسنك والعفافُ حجابه","ما كان أوضَحَه لمن يستوضح",47,"ح",1,0],["لِلَّهِ حالٌ قَد تَنَقَّلَ عَهدُها","كَخِلافِ نَقلِ الدَهرِ حالِ صَريعِ",48,"ع",1,0],["لله حسن وفاء في مودته","فكم باخلاصه أضحى يحليها",49,"ي",3,0],["للّهِ حبر حبانا من خزائنِه","عجيب سرتبدي غير مخزون",50,"ن",1,0],["للَه حمراؤك تحسو الأسى","وحيدةً في الروضة الخاليه",51,"ه",1,0],["لِلَّهِ حصنٌ بَبعلَبَكَّ وَلا","بدعَ اذا سَمّيناهُ بالجبلِ",52,"ل",1,1],["للهِ حَرَبٌ بها الأبطالُ عاكِفَةٌ","مِن كلّ مُقتَحِمٍ للمَوتِ مُبتسِمِ",53,"م",1,0],["لله حكمتك التي ببديعها","قد زال عن نور الهدى الستر",54,"ر",1,0],["لله حسن مباسمٍ محمرَّة","فكانما صبغن من مرجانه",55,"ن",2,0],["للَّه حسن به باريه حاصره","فكم له دان باديه وحاضره",56,"ر",2,0],["لِلَهِ حسن وإحسان بها اجتمعا","كلاهما ببديع الشوق أو حى لي",57,"ل",2,0],["للَه حمدي أنه خلاقي","ربي إلهي موجدي رزاقي",58,"ي",1,0],["للَه حب سقاني من محبته","سلافة لو حساها الصخر لم يفق",59,"ق",1,0],["للَه حزمك والقلوب خوافق","من حيث زلزلت الوغى زلزالا",60,"ل",2,0],["لله حيك حي الفضل أجمعه","من شم عطر ندى واديه لم يشب",61,"ب",1,0],["لِلّه حبرٌ لَم يَقم نِدٌّ لَهُ","مِن عَهدِ بُطرس هامة الأَحبارِ",62,"ر",1,0],["لِلّهِ حَمدٌ وَشكري للأُلى عضدوا","وَهني فالفيتُ سَهلاً ما بِهِ خطرُ",63,"ر",1,0],["للَه حملك كم تغض على القذى","جفناً وتجرع أكؤساً لم تجرع",64,"ع",1,0],["للَه حمزاوي مجد بيته","لذرى المجرة دونه جريان",65,"ن",1,0],["للَه حادي الظعن ما أشجاه","لما دعا مضنى النوى لبساه",66,"ا",2,1],["لله حمدي على ما قد أفاء به","علي من نعم لم أحصها عددا",67,"د",2,1],["لله حبٍّ راح لا يتكررُ","وخيال صاحبة فؤاديَ تسكرُ",68,"ر",1,1],["لله حجته على كل الورَى","منه استنار بعلمِه من مانَعه",69,"ع",2,0],["للهِ حمدٌ قد عدنا","بنبوءة أحمدَ من رسلي",70,"ل",2,0],["للَّهِ حَبِيبٌ وخَليلٌ","للنَّاسِ بَشيرٌ ونَذيرُ",71,"ر",1,0],["للهِ .. حتى لا تُدنَّسَ كعبةٌ","أو مسجدٌ فيه النبيُ أشادا",72,"د",2,0],["لله حزب الاستقامة لم تزل","تقفوا سبيل المجتبى إيجابا",73,"ب",2,0],["لله حياته مأساة","بالهجر دواما تشغلُهُ",74,"ل",2,0],["لله حُسْنُ الوردتين بدارتي","آنٍ رفاهٍ يرفلان بجنتي",75,"ي",1,1],["للهِ حُسنُ الحُسنِ , ينفلِقُ الدُّجى","لبهائهِ ويشفُّ فهو ستائرُ",76,"ر",1,0]]}