{"poems":[[79,"ألا أذن تصغي إلي سميعة","https://www.aldiwan.net/poem36677.html","الطويل"],[94,"وأود أن أحيا بفكرة شاعر","https://www.aldiwan.net/poem38906.html","الكامل"],[94,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[91,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[45,"ألا أذن فما أذكرت ناسي","https://www.aldiwan.net/poem9610.html","الوافر"],[64,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85394","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85347","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140970",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54872","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[119,"يقول يعقوب لسر خفي","https://www.aldiwan.net/poem40891.html","عموديه"],[132,"إني لأعلم لا أزال معلما","https://www.aldiwan.net/poem50679.html","الكامل"],[228,"سجدت في هيكل الأماني","https://www.aldiwan.net/poem41922.html","مخلع البسيط"],[290,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[325,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[382,"يا أيها الأب المكرم التقي","https://www.aldiwan.net/poem59158.html","الرجز"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[479,"ألا آذنتنا من تدللها ملس","https://www.aldiwan.net/poem2164.html","الطويل"],[487,"أطلعن في قمر الأفوق شموسنا","https://www.aldiwan.net/poem24426.html","عموديه"],[543,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[563,"إن العوام كلها موجودة","https://www.aldiwan.net/poem34484.html","الكامل"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147208","المجتث"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53966","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137720",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77655","الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90548","البسيط"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138061","الرجز"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203741",""],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126146","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126147","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111849","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101891","الرجز"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101904","الرجز"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131527",""],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131338","الرجز"],[358,"","https://poetry.dctabudhabi.ae/diwan/poem/84072","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137946",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27964","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27866","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27344","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115240","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102559","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107183","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133962","الرجز"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121614","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87506","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97899","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97905","الكامل"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205600",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114242","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135991","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94787","الطويل"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138847",""],[4954,"ليْتَهُ صافى","https://www.poetsgate.com/ViewPoem.aspx?id=208828",""],[5009,"بنت قنا","https://www.poetsgate.com/ViewPoem.aspx?id=24371",""],[5050,"قل للذي ترك العلى","https://www.poetsgate.com/ViewPoem.aspx?id=38201",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[3591,"ألم تزالوا على الحسن الذي سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=149466",""],[5191,"تَدَلُّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215453",""],[5324,"بغداد مشفقة على أعدائها .","https://www.poetsgate.com/ViewPoem.aspx?id=207568",""],[5324,"خطاب ماكرة .","https://www.poetsgate.com/ViewPoem.aspx?id=207638",""],[5324,"بغداد مشفقة على اعدائها.","https://www.poetsgate.com/ViewPoem.aspx?id=211433",""],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""],[5717,"صب تسامره بدور","https://www.poetsgate.com/ViewPoem.aspx?id=170584",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[6115,"خلك هبل واحيان يازين الهبال","https://www.poetsgate.com/ViewPoem.aspx?id=180491",""],[6256,"مداعبة صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65926&r=&rc=14",""],[2220,"علمي بالرحمنِ لا يثبتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11793&r=&rc=663",""]],"verses":[["ألا أُذُنٌ تُصْغي إليّ سَميعَةٌ","أُحَدِّثُها بالصِّدْقِ ما صَنَعَ المَوْتُ",0,"ت",1,1],["إلاَّ إِذا قَطَّعْتُ أَسبابي مع الدُّ","نيا وعِشْتُ لوَحْدتي وظَلامي",1,"م",2,0],["إلاَّ إِذا ضَفَرَتْ لهُ","الأَقدارُ إكليلَ الجنونْ",2,"ن",1,0],["الا اذا استوفى فكا","ن من الطراز الاول",3,"ل",1,0],["الاّ اذا عبر الصرا","ط على اغرّ محجل",3,"ل",1,0],["الا اذا شاء بي فهو مقتدر","على اعادة آلاف من الرمم",4,"م",1,0],["أَلا أَذِّن فَما أَذكَرتَ ناسي","وَلا لَيَّنتَ قَلباً وَهوَ قاسِ",5,"س",1,1],["إلا إذا عقدتها بالرفقِ","وفزت من تدبيرها بالحقِ",6,"ق",1,0],["إلا إذا متنا وعم الردى","فدجلة حينئذ تَمضي",7,"ض",2,0],["إلا إذا سكنت أَعصاب بنيته","مَع الزَمان الَّذي يستأصل الغَضبا",8,"ب",2,0],["إلا إذا أتت القيا","مة وَهيَ يوماً سوف تاتي",9,"ي",1,0],["ألا أذّن فما أذكرت ناسي","ولا ليّنت قلباً وهو قاسي",10,"ي",1,1],["إِلاَّ إِذا مَا جَاءَ رَسْمِي نَاطِقاً","فَلَقَدْ أَكُونُ ومَنْطِقِي هُوَ سَاتِرِي",11,"ر",2,0],["إِلاَّ إِذَا مَرَّ الْغَزَا","لُ بِهِ فَيَأْنَسُ وَهْوَ نَافِرْ",12,"ر",1,0],["الا اذا عصمتني منك عاصمة","تحلني منك في أمن وفي وزر",13,"ر",1,0],["الا اذا جاء قميص اللقا","مع بشير القرب من يوسف",14,"ف",1,0],["إلا إذا شاءَ انتقالا دائماً","وأصابة شَرٌّ من القُرَباءِ",15,"ا",2,0],["إِلّا إِذا ما اِفتَرَستُ قَلباً","يَكون أَقوى من النُسورِ",16,"ر",1,0],["الا اذا جاد الزمان بكونه","فرعا لأصلك فالجواز الاقرب",17,"ب",1,0],["إِلّا إِذا ما اِلتَمَسا","بِنفسِهِ أَن تَجلِسا",18,"س",2,0],["إِلّا إِذا كانَ غُلاماً أَهيَفا","ساجي اللَواحِظِ ناعِسُ الأَجفانِ",19,"ن",1,0],["إلا إذا النسيان عم الملتزِمْ","من بعد فحص ذهنه لا يلتزمْ",20,"م",1,0],["إلا إذا عفو هنالك اتفق","لأنني ملاحظ حسن النسق",21,"ق",1,0],["ألا آذَنَتنا من تَدلُّلِها مَلس","وقالت أما بيني وبينك من بَلسِ",22,"س",1,1],["إلا إذا نودي الأديب الأريج","المرتقى لمعالم تنفيسا",23,"س",2,0],["إلا إذا ما المرءُ يُمسِي مُجرِما","في ذَبِّه عَن مَوطنِ الأجدَاد",24,"د",1,0],["إلا إذا آمنت بالغيب الذي","لم تدنه وقنعت بالتقصير",25,"ر",1,0],["إلا إذا ما اقتنصنا","عذب الخلائق حلوا",26,"و",2,0],["إلاّ إذا تَرَكَ الوَرَى","طُرّاً وآنسَ بانْفِرادِهْ",27,"ه",1,0],["ألا اذكرن أن مثيلاتكن","هنالك بتن طعام السعير",28,"ر",1,0],["إِلّا إِذا مَدَّ لَهُم شراكا","مِن حَزمِهِ وَنَصب الشِباكا",29,"ك",2,0],["إلا إذا أنتَ أسَّستَ الكلاَمَ على","أسِّ البلاغة واستوفيتَ تبيينا",30,"ن",2,0],["إلاّ إذا كانَ هُنا قَرِيْنَهْ","تُوْجِبُ لِلتَّعْمِيْمِ أَوْ تَعْيِيْنَهْ",31,"ه",1,0],["إلا إذا تَلِفَتْ أو انفلقتْ","أو انقلبتْ ربابهْ!",32,"ب",2,0],["إلا إذا سبقَت للعبد سابقَةٌ","يعودُ من بعد هذا من مواليهِ",33,"ي",2,0],["إلا إذا بدا له الحبيب","وغاب عن حضرته الرقيب",34,"ب",1,0],["إلا إذا ما كان تمر طيبة","يا ليت منه كل يوم ويبة",35,"ه",1,0],["الا اذا فصلتَ طاءً فنعم","اختارهُ وفصله في الكون عم",36,"م",1,0],["إِلا إذا اعتَمَّت لَه منيتُه","وسيفٌ استعلَت بهِ هِمَّتُه",37,"ه",1,0],["إِلا إذَا مَا هَالَهُ تَفَجُّعُ","إنَّ الشَّقَاءَ بِالشَّقِيِّ مُولَعُ",37,"ع",1,0],["إلا إذا لطفك بي كفاه","بحقّ لا إله إلا اللّه",38,"ه",1,0],["إلا إذا رحمتني ويلاه","بحقّ لا إله إلا اللّه",38,"ه",1,0],["إلا إذا أصلحتها رباه","بحق لا إله إلا اللّه",38,"ه",1,0],["الاّ أذاكَ فلا يجري الى امدِ","يا من أُصيبت بسهم الهمّ مهجتهُ",39,"ه",1,0],["الاّ اذا كان الحبيب يديرها","وانا مطيعٌ كلما اوصى بهِ",40,"ب",2,0],["إلا إذا ما كان عزم الفاعل","من أول الأمر على التناول",41,"ل",1,0],["إلا إذا كان ارتضاع الصغرى","بسعيها من دون علم الكبرى",42,"ر",2,0],["إلا إذا عاد معك فيني ونش","وكل كبه على ماضيه",43,"ي",2,0],["إلاّ إذا أَعَدْتَها يا زيني","فإنّها في قَبْضَةِ اليَدَيْنِ",44,"ن",1,0],["إِلّا إِذا أَمَر اللبَي","ب بِما يُؤمّلهُ نَجح",45,"ح",1,0],["إِلاَّ إِذا الظلماتُ عنك تقشعت","ووردتَ من بعد الاوام نقيعا",46,"ع",2,0],["إلا إذ أبصر معلومه","أزال عنه حيرة الهائم",47,"م",1,0],["إلا إذا تضربها أربعا","في سبعة هناك يستلزم",48,"م",1,0],["إلا إذا اتَّقوا الإله فإنهم","أهلُ المكارمِ والندى والباس",49,"س",1,0],["ألا إذا تحقق الفسادا","فليولها التسريح والأبعادا",50,"د",2,0],["إلاَّ إذَا مَا كَانَ ثُمَّ مَوَانِعَ","مِن آفَةٍ أو قَاسِرِ الحَيَوَانِ",51,"ن",1,0],["إلاَّ إِذ قَتَلَ الخَلِيفَةَ وَالقَضَا","ةَ وَسَائِرَ الفُقَهَاءِ فِي البُلدَانِ",51,"ن",1,0],["إلاَّ إِذَا مَا أوِّلَت فَمَجَازُهَا","بِزِيَادَةٍ فِيهَا أوِ النُّقصَانِ",51,"ن",1,0],["إلاَّ إذَا عَانَدتُمُ وَرَددتُمُ","قَولَ الرَّسُولِ لأجلِ قَولِ فُلاَنِ",51,"ن",1,0],["إلاَّ إذَا اختَلَفَ اعتِبَارُهُمَا فَذَا","فِي الذِّهنِ وَالثَّانِي فَفِي الأعيَانِ",51,"ن",1,0],["الا اذا ما قلدا لسواهما","فتراهم جيلا من العميان",51,"ن",1,0],["ألا آذِناً شمّاء بالبين إنه","أبي أودُ الشماءِ أن يتقَوّما",52,"م",2,1],["إلا إذا ما كان في الصحراء","فابقه فالفضل في الابقام",53,"م",1,0],["إلا اذا شاء به الباري قضوا","لسدادهم فهو الكريم المبدع",54,"ع",1,0],["إلاّ إذا مَا كُنتَ ما بَينَهُمَا","خُذ مِنِّي العِلمَ وَلاَ تَوَهَّمَا",55,"م",2,0],["إِلا إِذا أَتَى الرَدى أَو قالَ بِه","فَرُدَّهُ بِاللطفِ حتّى يَنتَبِه",56,"ه",1,0],["إلا إذا عوملت بالاحسان","وما لدى رضوان من رضوان",57,"ن",1,0],["إلا إذا أشبه حرفاً والسكون","أصل البناء فلا تسل حيث يكون",58,"ن",1,0],["إلا إذا قد ولد الإمامُ","إمامُ كل الأنبياءِ الغُرِّ",59,"ر",1,0],["الا اذا عادة او نحوها وجدت","فصم لذين وان تفقد فلا تصم",60,"م",1,0],["الا اذا انتظر واشخصا تغيب عن","وليمة فهناك اصبر وراعهم",60,"م",1,0],["الا اذا كان قلب طيب فاذا","فاحمل ولقم وخذ ما شئت من لقم",60,"م",1,0],["الا اذا فثنة لم تخشها فأجب مع","الحجاب وزوج او ذوي رحم",60,"م",1,0],["الا اذا كنت مشهوراً بذاك فقل","انا الفقيه وشمس الدين ذو الحكم",60,"م",1,0],["الا اذا مادعا ضر اليه كما","بفجاة الحرب او حر وبردهم",60,"م",1,0],["الا اذا منكراً قد خلت من احد","فاغضب وقطب لحق اللّه ثم قم