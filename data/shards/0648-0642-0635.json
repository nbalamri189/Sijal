96.html","مجزوء الكامل"],[458,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[458,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[461,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[464,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[464,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[464,"صحة الوجد بالجفون المراض","https://www.aldiwan.net/poem3588.html","عموديه"],[479,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[515,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[551,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[551,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[551,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[551,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[553,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[558,"ما لابن مريم في تلك الأساطين","https://www.aldiwan.net/poem33794.html","البسيط"],[558,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[558,"ألا فتحقق أن كل استقامة","https://www.aldiwan.net/poem34206.html","الطويل"],[558,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[563,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[567,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[575,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[575,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["وَقَصائِدٍ سَدَّدتُهُنَّ أَسِنَّةً","وَشَهَرتُهُنَّ قَواضِباً وَنُصولا",0,"ل",2,0],["وَقَصيدَةٍ عَذراءَ مِثلِ","لِ تَأَلُّقِ الرَوضِ النَضيرِ",1,"ر",1,0],["وَقَصَرنَ خَطوي عَن مُراهَنَةِ الصِبا","فَخَطَوتُ لِلَّذاتِ خَطوَ مُقَيَّدِ",2,"د",1,0],["وَقَصيرُ الغِنى طَويلُ يَدِ الجو","دِ ثَقيلُ الحِجى خَفيفُ العَتادِ",3,"د",1,0],["وَقَصيبِ إِسحِلَةٍ لَوِ اِنعَطَفَ الصِبا","يَوماً لَنا بِقَوامِهِ الأُملودِ",4,"د",1,0],["وَقَصائِدٍ مِثلِ الرِّياضِ أَضَعتُها","في باخِلٍ ضاعَت بِهِ الأَحسابُ",5,"ب",1,1],["وَقَصَدتُ قائِدَهُم قَطَعتُ وَريدَهُ","وَقَتَلتُ مِنهُم كُلَّ قَرمٍ أَكبَرِ",6,"ر",1,0],["وَقَصَّرَتِ الأَلْفَاظُ عَنْ نَيْلِ غَايَةٍ","بِبَعْضِ الَذِي أَبْدَتْهُ ذَاتُكَ مِنْ مَعْنَى",7,"ن",2,0],["وَقُصورِ قَومٍ زاهِراتٍ في الدُجى","طَلَعَت عَلَيها الشَمسُ وَهيَ طُلولُ",8,"ل",1,0],["وَقُصّا أَحاديثَ المُصَلّى وَأَهلِهِ","عَلَيَّ فَما لي في سِوى ذاكَ مِن وَطَن",9,"ن",1,0],["وَقَصَائِدٌ مِثلُ الرُّقَى","أَرسَلتُهُنَ فَكُنَّ شَغفَا",10,"ف",2,0],["وقصرَ عن هيجائه شعرُ مادحٍ","فأصغى إلى مدح الوشيج المقصد",11,"د",1,0],["وقصّر عن نظمي الأنامُ وشُيّدت","عليك مباني بيته فهو كالقصر",12,"ر",1,0],["وقصة كان فيها غوثُ مرتقبٍ","على يديك ويسر بعد إعسار",13,"ر",1,0],["وقصداً سعيداً لم تضع فيه ثروةً","وما ضاع إلاَّ نشرها المتضوّع",14,"ع",1,0],["وقصيد منه أتى ببديع","هو حرُّ المقال وهو رقيق",15,"ق",1,0],["وقصدت عذبَ البحر ثمَّ قصدته","فوجدته أدنى إلى المتناول",16,"ل",1,0],["وقصيدة غرّاء تعلم أنه","قد غادر الشعراء ما يُتردم",17,"م",1,0],["وقصيدة لو لم يعد عهد الصبا","عادت بأرفع من سناه وأرفه",18,"ه",1,0],["وَقَصَرتُ عَقلي بِالهُوِيَّةَ طالِباً","فَعادَ ضَعيفاً في المَطالِبِ هاوِيا",19,"ي",2,1],["وقصير تراه فوق يَفاعٍ","فتراهُ كأنهُ في غَيَابَهْ",20,"ب",2,1],["وَقَصَبْتُ صَاحبَهُ إليه كأنَّما","قَاوَمْتُهُ فيه مَقَامَ فِضَاحِ",21,"ح",1,0],["وقصَّتي معَكُمْ نارٌ على عَلَمٍ","لا فطنةٌ بطَنَتْ في قلْب جُلْمُودِ",22,"د",1,0],["وقصَّر شكواه فكانت كأنها","طريقٌ أراهُ كيفَ وجْهُ اختصاره",23,"ر",2,0],["وَقَصَّ شَكواكَ قَلبي قِصَّةً عَجَباً","مِن قَبلُ أَن سَمِعَت أُذنايَ شَكواكِ",24,"ك",1,0],["وَقُصورٌ ما لِعَيشٍ","نِلتُهُ فيها قُصورُ",25,"ر",1,0],["وَقَصدُهُ أَنّي إِذا ذُقتُها","تَشتَدُّ أَشواقي إِلى رُؤيَتِه",26,"ت",2,0],["وقصورٌ كأنَّها الشَّفَقُ المخضُوبُ","أَو طلعَةُ الصَّباحِ الوليدِ",27,"د",1,0],["وقصّ رؤياك مكذوبا بمضحكها","على النبيين مكذوبا بمبكيها",28,"ي",3,0],["وقصارى الكرى وإن طال نعمى","لزوال أو شقوة لنفاد",29,"د",1,0],["وَقَصَدَ القَومَ وَحَيّاهُمُ","وَقامَ فيما بَينَهُم يَخطُبُ",30,"ب",1,0],["وَقُصارى أولي النُهى","يَتَلاقونَ في الفِكَر",31,"ر",1,0],["وَقُصّي مِن مَصارِعِهِم عَلَينا","وَمِن دولاتِهِم ما تَعلَمينا",32,"ن",2,0],["وَقِصارَ أَيّامٍ بِهِ سُرِقَت لَنا","حَسَناتُها مِن كاشِحٍ وَرَقيبِ",33,"ب",1,0],["وَقَصَّرَت هِمَمُ الأَملاكِ عَن مَلِكٍ","تَطَأطَأوا وَسَمَت أَخلاقُهُ صُعُدا",34,"د",2,0],["وَقُصارى المَشوقِ يَصرِمُهُ الشا","ئِقُ إِقصارُ شَوقِهِ أَو قُصورُه",35,"ر",2,0],["وَقَصرُكِ مِن نَداهُ فَبَلِّغيني","كَفَيضِ البَحرِ حينَ عَلا وَسالا",36,"ل",2,0],["وقَصَّرَ شَأْوَ مَنْ يَرْجُو مَداه","عِقالُ العَجْزِ أو قَيْدُ الحِرانِ",37,"ن",1,0],["وقَصائدٍ يُهدْي إليكَ بِقَصْدِها","فَرَحاً يَكونُ إلى السَّلامَةِ سُلَّما",38,"م",2,0],["وَقَصَّرَ طَرفُ العَينِ عَنهُ كَلالَةً","وَأَسرَعَ فيما لا يُحِبُّ شَقيقُهُ",39,"ق",2,0],["وَقِصارٌ في الأَكُفِّ وَلَكِن","قَصَّرَت فِعلَ الرِماحِ الطَوالِ",40,"ل",1,0],["وقصيداً مجلجلاً كل بيت","خلفه ألف عاصف ليس يهدا",41,"د",2,0],["وَقَصَّرَ السَّعدُ لَيلاً فالتَقى عَجلاً","مِنهُ العِشاءُ على كَفَّيكَ والسَّحَرُ",42,"ر",1,0],["وَقَصائِداً تَسري إِلَيكَ كَأَنَّها","أَحلامُ رُعبٍ أَو خُطوبٌ طُرَّقُ",43,"ق",1,0],["وَقَصَّرَ قَولي مِن بَعدِ ما أَرى","أَقولُ فَأُشجي أُمَّةً وَأَنا وَحدي",44,"د",2,0],["وقصَّرَ طولي عندكم حسنُ صبرِكمْ","وعندَ التناهي يقصُرُ المتطاولُ",45,"ل",1,0],["وَقَصيرَةِ الأَيامِ وَدَّ جَليسُها","لَو باعَ مَجلِسَها بِفَقدِ حَميمِ",46,"م",1,1],["وَقَصَّرَتْ كلماتي عَنْ مَدَائِحهِ","وقد أتيتُ مِنَ الحالَيْنِ أعتَذِرُ",47,"ر",1,0],["وقصيدة كخريدة محزونة","تشكو بصوت راجف متقطع",48,"ع",1,0],["وقصارى أنغامه الوجد أما","نغماتي فما لهن قُصارى",49,"ر",2,0],["وقصيرٌ ومجدهُ","باذخٌ كالضحى أشمْ",50,"م",1,0],["وقصيدة كالروض باكره الحيا","فاهتز ريحانا ورف أقاحا",51,"ح",2,0],["وقصّ أنباء القرون في السور","مواثل الحسن كأمثال الصور",52,"ر",1,0],["وقُصورٌ كانت ملاعبَ أُنْسٍ","أصبحتْ بعد زَهوهِنَّ لُحودا",53,"د",2,0],["وَقُصُوراً لاَمِعاتٍ كَالضُّحَا","رَدَّدَ العِرْفانَ في مِصْرَ صَداها",54,"ا",3,0],["وقصِيدٍ قد خَفَّ حتَّى عَجِبْنا","كَيفَ نالَتْهُ كِفَّةُ الأوْزانِ",55,"ن",1,0],["وقصورا من الحنا مثقلات","بالخطايا كالعاهرات الحبالى",56,"ل",2,0],["وقصة لملم التأريخ أحرفها","فاستضحك الحبر في كفيه والصحف",57,"ف",1,0],["وقصّت امرأة عنها ، لجدّتها","فصلا ، كما ذاب فوق الخضرة الصّدف",57,"ف",1,0],["وقصائدٍ رَّقتْ فكان مدبُّها","كالخمر من ثَمِل القَوام نزيفه",58,"ف",2,0],["وقصائدك الحلوات اضحى","وغروب صيفي الأجفان",59,"ن",1,0],["وَقَصِيدَة ً شَعْوَاءَ بَاقٍ نُورُهَا","تَبْلَى الْجِبَالُ وَأَثْرُهَا لَمْ يُطْمَسِ",60,"س",1,0],["وَقَصر وَاسع الأَكناف رَحباً","يُجرر فيهِ أَذيال الغَرام",61,"م",1,0],["وَقَصَدت باب اللَهِ أَرجو فَضلَهُ","إِذ كُل فَضل دونَ ذَلِكَ دون",62,"ن",1,0],["وقصدته وسوى فسيح رحابه","في النازلات وحقه لا يقصد",63,"د",1,0],["وقصيدة عصماء من أبياتها","عاينت سر الحق في غفرانه",64,"ن",2,0],["وَقَصَرتَ وَعدَكَ فَليَدُم مَقصورُهُ","لِمُؤَمِّليكَ وَعُمرُكَ المَمدودُ",65,"د",1,0],["وَقَصَّرَ عَن أَمانَتِهِ كَأَنّي","طَلَبتُ الوَخدَ مِن جَمَلٍ ثَقالِ",66,"ل",1,0],["وَقَصَّرَ القَومَ عَمّا نِلتَهُ هِمَماً","فَأَقلَعَت بَعدَ تَبريحٍ هُمومُهُمُ",67,"م",1,0],["وقصيدتي تبقى وإني أكسّي","ثوبَ الفناء وكلُّ شيءٍ فانِ",68,"ن",1,0],["وقصدت منصبه لخطبة وده","ونقدته مدحي السوائر ممهرا",69,"ر",2,0],["وقصدت ساحته الكريمةَ سائلاً","إِحسانَه فاعادني مسئولا",70,"ل",2,0],["وقصصت رؤياها عليك ولم أرا","بوعودها مترقباً مستنظرا",71,"ر",2,0],["وقصر ليلا طول البعد عمره","علي لأني ما وضعت له جنبا",72,"ب",2,0],["وقصدت صاحبتي التي","نظرت إليّ بعين باخل",73,"ل",1,0],["وقصدت حرّا فاضلا","ملك الفصاحة والبراعه",74,"ع",2,0],["وقصّاصُ الأضِِرّا فأر سجن","تواصوا في المكارم بالإضاعه",75,"ع",2,0],["وقصّ في الشغاثات","بتضريب له أفدي",76,"د",2,0],["وَقصدُهم واحدٌ تنزيهُ خالقنا","تَفويضُ ما جاءَ أو تأويل مشتبهِ",77,"ب",2,0],["وَقصّرَ شِعري عَن مَحاسنكِ العلا","وَإن عَبر البحرَ الطويلَ إلى الشِعرى",78,"ر",2,0],["وَقَصيدَةٍ قَد بِتُّ أَجمَعُ بَينَها","حَتّى أُقَوِّمَ مَيلَها وَسِنادَها",79,"د",3,0],["وقصيدي بقيّةٌ من فُؤادٍ","عَصَرَتهُ الآلامُ فهوَ عُصارَه",80,"ر",2,0],["وقُصارُ أعيننا دموعٌ وكّفٌ","وقُصارُه طُوبى وحسن مآب",81,"ب",1,0],["وقصر عن علياك كل مماثل","وطول رب العالمين لك العمرا",82,"ر",2,0],["وَقُصارى لَذّاتِهِ الحَمراءِ","وَعَرفتُم حَتّى الغُيوبَ وَلكِن",83,"ن",1,0],["وَقَصيدَة شَبلي مُصغيةٌ","لِنَشيدِ فُؤادي تسمَعُهُ",84,"ع",2,0],["وَقَصدِ كُلِّ باخِلٍ","مِنَ السُؤالِ مُشفِقِ",85,"ق",1,0],["وَقَصيرِ عُمرِ الوَصلِ يَرجِفُ بِالقَنا","مِن دونِ زَورَتِهِ أَسِنَّةُ عامِرٍ",86,"ر",1,0],["وَقَصِيدَةً قَصَدَتْ حُلَى ال","إِبْدَاعِ مِنْ مَثْنىً وَمَوْحَدْ",87,"د",1,0],["وَقَصَدْتُ رُكْنَ السِّيَادَةِ مَوْلاَ","نَا ابْنَ مَنْ أَسَّسُوا الْهُدَى تَأْسِيسَا",88,"س",2,0],["وقصر به جمع المعالي ممنع ال","جناب عن الأعداء عالي الجوانب",89,"ب",1,1],["وقصورُ سامرّا وبغدادَ التي","دَثَرت وفي الألبابِ لمّا تدثر",90,"ر",1,0],["وقصيدي عني ينوب حضورها","والله يعلم خافيات جناتي",91,"ي",1,0],["وقصورٌ مسحورةٌ تهتف النعمى","بقاعاتها بشدو القيان",92,"ن",1,0],["وَقصدُ إِحضاره في الذِهن لاح لنا","لَمّا سَرى فيؤمُّ الرسلَ من أمَمِ",93,"م",1,0],["وَقِصَّة النائب في كيده","عَلى عُلاه من أَدَلِّ الشُهود",94,"د",1,0],["وقصدنا لروضة من جنا","ن دار الخلد المقام",95,"م",1,0],["وقصتها مع شيبة الحمد والندى","وآلا قريش فاروها إن تكن أهلا",96,"ل",2,0],["وَقَصدُ بابِهِمُ حَجّي وَقُربُهُم","مَنّي أَراهُ إِلى الرَحمَنِ قُرباني",97,"ي",1,0],["وَقَصر مُشَيَّد كل مجد لَهُ اِلى","مَعاليهِ شَوق زائِد وَحَنين",98,"ن",1,0],["وقُصدْتُ في نَفْسي وفي ابْني بالّتي","فَرِحَتْ لها نَفْسُ العَدُوِّ الأرذَل",99,"ل",1,0],["وقصائدٍ غُرٍّ مُحبَّرةٍ","هيَ من فؤادي لو دَرَوْا شِقَق",100,"ق",1,0],["وقَصَّرَ الضَّرْبُ قَصَر","بخَطْفِها المُلْكُ اسَتقَر",101,"ر",1,0],["وقصائدي الغُرُّ المُحَجّلةُ التي","أبداً تَخُبّ