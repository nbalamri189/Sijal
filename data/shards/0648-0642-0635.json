{"poems":[[53,"وجد القريض إلى العتاب سبيلا","https://www.aldiwan.net/poem29862.html","الكامل"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"مرضت بعدكم صدور الصعاد","https://www.aldiwan.net/poem30618.html","الخفيف"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[63,"وقصائد مثل الرياض أضعتها","https://www.aldiwan.net/poem45827.html","الكامل"],[3,"أرض الشربة تربها كالعنبر","https://www.aldiwan.net/poem163.html",""],[77,"تعددت الألفاظ واتحد المعنى","https://www.aldiwan.net/poem36024.html","الطويل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[71,"ألا خبروني عن حمى تل راهط","https://www.aldiwan.net/poem4001.html","الطويل"],[41,"يا مرحبا ألفا وألفا","https://www.aldiwan.net/poem42252.html","مجزوء الكامل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"لو لم تفه برثاء فيك أشعاري","https://www.aldiwan.net/poem18718.html","البسيط"],[72,"أمين العلى والعلم هنئت حجة","https://www.aldiwan.net/poem19205.html","الطويل"],[72,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[72,"قسما بغصن قوامه المتمايل","https://www.aldiwan.net/poem19481.html","الكامل"],[72,"ربع لعزة صامت لا يفهم","https://www.aldiwan.net/poem19680.html","الكامل"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[64,"وقصرت عقلي بالهوية طالبا","https://www.aldiwan.net/poem67537.html","الطويل"],[51,"وقصير تراه فوق يفاع","https://www.aldiwan.net/poem8647.html","الخفيف"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[91,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[70,"حبذا دور على الني","https://www.aldiwan.net/poem42900.html","مجزوء الرمل"],[70,"فديت من أرسل تفاحة","https://www.aldiwan.net/poem42988.html","السريع"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[85,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[85,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[85,"قد سمع الثعلب أهل القرى","https://www.aldiwan.net/poem8006.html","السريع"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[85,"قفي يا أخت يوشع خبرينا","https://www.aldiwan.net/poem63733.html","الوافر"],[45,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[28,"أحب من النساء وهن شتى","https://www.aldiwan.net/poem5414.html","الوافر"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[61,"ما تم وشك البين حتى تيما","https://www.aldiwan.net/poem51433.html","الكامل"],[49,"إذا قل مال المرء قل صديقه","https://www.aldiwan.net/poem62193.html","الطويل"],[66,"ألآل أشرقت في نحور","https://www.aldiwan.net/poem40642.html","المديد"],[97,"وانتحينا معا مكانا قصيا","https://www.aldiwan.net/poem25087.html","الخفيف"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[44,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[69,"جهادك مقبول وعامك قابل","https://www.aldiwan.net/poem28976.html","الطويل"],[33,"وقصيرة الأيام ود جليسها","https://www.aldiwan.net/poem25803.html","الكامل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85508","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39609","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[18,"منْ مبلغٌ بكراً وَ آلَ أبيهمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26449&r=&rc=15",""]],"verses":[["وَقَصائِدٍ سَدَّدتُهُنَّ أَسِنَّةً","وَشَهَرتُهُنَّ قَواضِباً وَنُصولا",0,"ل",2,0],["وَقَصيدَةٍ عَذراءَ مِثلِ","لِ تَأَلُّقِ الرَوضِ النَضيرِ",1,"ر",1,0],["وَقَصَرنَ خَطوي عَن مُراهَنَةِ الصِبا","فَخَطَوتُ لِلَّذاتِ خَطوَ مُقَيَّدِ",2,"د",1,0],["وَقَصيرُ الغِنى طَويلُ يَدِ الجو","دِ ثَقيلُ الحِجى خَفيفُ العَتادِ",3,"د",1,0],["وَقَصيبِ إِسحِلَةٍ لَوِ اِنعَطَفَ الصِبا","يَوماً لَنا بِقَوامِهِ الأُملودِ",4,"د",1,0],["وَقَصائِدٍ مِثلِ الرِّياضِ أَضَعتُها","في باخِلٍ ضاعَت بِهِ الأَحسابُ",5,"ب",1,1],["وَقَصَدتُ قائِدَهُم قَطَعتُ وَريدَهُ","وَقَتَلتُ مِنهُم كُلَّ قَرمٍ أَكبَرِ",6,"ر",1,0],["وَقَصَّرَتِ الأَلْفَاظُ عَنْ نَيْلِ غَايَةٍ","بِبَعْضِ الَذِي أَبْدَتْهُ ذَاتُكَ مِنْ مَعْنَى",7,"ن",2,0],["وَقُصورِ قَومٍ زاهِراتٍ في الدُجى","طَلَعَت عَلَيها الشَمسُ وَهيَ طُلولُ",8,"ل",1,0],["وَقُصّا أَحاديثَ المُصَلّى وَأَهلِهِ","عَلَيَّ فَما لي في سِوى ذاكَ مِن وَطَن",9,"ن",1,0],["وَقَصَائِدٌ مِثلُ الرُّقَى","أَرسَلتُهُنَ فَكُنَّ شَغفَا",10,"ف",2,0],["وقصرَ عن هيجائه شعرُ مادحٍ","فأصغى إلى مدح الوشيج المقصد",11,"د",1,0],["وقصّر عن نظمي الأنامُ وشُيّدت","عليك مباني بيته فهو كالقصر",12,"ر",1,0],["وقصة كان فيها غوثُ مرتقبٍ","على يديك ويسر بعد إعسار",13,"ر",1,0],["وقصداً سعيداً لم تضع فيه ثروةً","وما ضاع إلاَّ نشرها المتضوّع",14,"ع",1,0],["وقصيد منه أتى ببديع","هو حرُّ المقال وهو رقيق",15,"ق",1,0],["وقصدت عذبَ البحر ثمَّ قصدته","فوجدته أدنى إلى المتناول",16,"ل",1,0],["وقصيدة غرّاء تعلم أنه","قد غادر الشعراء ما يُتردم",17,"م",1,0],["وقصيدة لو لم يعد عهد الصبا","عادت بأرفع من سناه وأرفه",18,"ه",1,0],["وَقَصَرتُ عَقلي بِالهُوِيَّةَ طالِباً","فَعادَ ضَعيفاً في المَطالِبِ هاوِيا",19,"ي",2,1],["وقصير تراه فوق يَفاعٍ","فتراهُ كأنهُ في غَيَابَهْ",20,"ب",2,1],["وَقَصَبْتُ صَاحبَهُ إليه كأنَّما","قَاوَمْتُهُ فيه مَقَامَ فِضَاحِ",21,"ح",1,0],["وقصَّتي معَكُمْ نارٌ على عَلَمٍ","لا فطنةٌ بطَنَتْ في قلْب جُلْمُودِ",22,"د",1,0],["وقصَّر شكواه فكانت كأنها","طريقٌ أراهُ كيفَ وجْهُ اختصاره",23,"ر",2,0],["وَقَصَّ شَكواكَ قَلبي قِصَّةً عَجَباً","مِن قَبلُ أَن سَمِعَت أُذنايَ شَكواكِ",24,"ك",1,0],["وَقُصورٌ ما لِعَيشٍ","نِلتُهُ فيها قُصورُ",25,"ر",1,0],["وَقَصدُهُ أَنّي إِذا ذُقتُها","تَشتَدُّ أَشواقي إِلى رُؤيَتِه",26,"ت",2,0],["وقصورٌ كأنَّها الشَّفَقُ المخضُوبُ","أَو طلعَةُ الصَّباحِ الوليدِ",27,"د",1,0],["وقصّ رؤياك مكذوبا بمضحكها","على النبيين مكذوبا بمبكيها",28,"ي",3,0],["وقصارى الكرى وإن طال نعمى","لزوال أو شقوة لنفاد",29,"د",1,0],["وَقَصَدَ القَومَ وَحَيّاهُمُ","وَقامَ فيما بَينَهُم يَخطُبُ",30,"ب",1,0],["وَقُصارى أولي النُهى","يَتَلاقونَ في الفِكَر",31,"ر",1,0],["وَقُصّي مِن مَصارِعِهِم عَلَينا","وَمِن دولاتِهِم ما تَعلَمينا",32,"ن",2,0],["وَقِصارَ أَيّامٍ بِهِ سُرِقَت لَنا","حَسَناتُها مِن كاشِحٍ وَرَقيبِ",33,"ب",1,0],["وَقَصَّرَت هِمَمُ الأَملاكِ عَن مَلِكٍ","تَطَأطَأوا وَسَمَت أَخلاقُهُ صُعُدا",34,"د",2,0],["وَقُصارى المَشوقِ يَصرِمُهُ الشا","ئِقُ إِقصارُ شَوقِهِ أَو قُصورُه",35,"ر",2,0],["وَقَصرُكِ مِن نَداهُ فَبَلِّغيني","كَفَيضِ البَحرِ حينَ عَلا وَسالا",36,"ل",2,0],["وقَصَّرَ شَأْوَ مَنْ يَرْجُو مَداه","عِقالُ العَجْزِ أو قَيْدُ الحِرانِ",37,"ن",1,0],["وقَصائدٍ يُهدْي إليكَ بِقَصْدِها","فَرَحاً يَكونُ إلى السَّلامَةِ سُلَّما",38,"م",2,0],["وَقَصَّرَ طَرفُ العَينِ عَنهُ كَلالَةً","وَأَسرَعَ فيما لا يُحِبُّ شَقيقُهُ",39,"ق",2,0],["وَقِصارٌ في الأَكُفِّ وَلَكِن","قَصَّرَت فِعلَ الرِماحِ الطَوالِ",40,"ل",1,0],["وقصيداً مجلجلاً كل بيت","خلفه ألف عاصف ليس يهدا",41,"د",2,0],["وَقَصَّرَ السَّعدُ لَيلاً فالتَقى عَجلاً","مِنهُ العِشاءُ على كَفَّيكَ والسَّحَرُ",42,"ر",1,0],["وَقَصائِداً تَسري إِلَيكَ كَأَنَّها","أَحلامُ رُعبٍ أَو خُطوبٌ طُرَّقُ",43,"ق",1,0],["وَقَصَّرَ قَولي مِن بَعدِ ما أَرى","أَقولُ فَأُشجي أُمَّةً وَأَنا وَحدي",44,"د",2,0],["وقصَّرَ طولي عندكم حسنُ صبرِكمْ","وعندَ التناهي يقصُرُ المتطاولُ",45,"ل",1,0],["وَقَصيرَةِ الأَيامِ وَدَّ جَليسُها","لَو باعَ مَجلِسَها بِفَقدِ حَميمِ",46,"م",1,1],["وَقَصَّرَتْ كلماتي عَنْ مَدَائِحهِ","وقد أتيتُ مِنَ الحالَيْنِ أعتَذِرُ",47,"ر",1,0],["وقصيدة كخريدة محزونة","تشكو بصوت راجف متقطع",48,"ع",1,0],["وقصارى أنغامه الوجد أما","نغماتي فما لهن قُصارى",49,"ر",2,0],["وقصيرٌ ومجدهُ","باذخٌ كالضحى أشمْ",50,"م",1,0],["وقصيدة كالروض باكره الحيا","فاهتز ريحانا ورف أقاحا",51,"ح",2,0],["وقصّ أنباء القرون في السور","مواثل الحسن كأمثال الصور",52,"ر",1,0],["وقُصورٌ كانت ملاعبَ أُنْسٍ","أصبحتْ بعد زَهوهِنَّ لُحودا",53,"د",2,0],["وَقُصُوراً لاَمِعاتٍ كَالضُّحَا","رَدَّدَ العِرْفانَ في مِصْرَ صَداها",54,"ا",3,0],["وقصِيدٍ قد خَفَّ حتَّى عَجِبْنا","كَيفَ نالَتْهُ كِفَّةُ الأوْزانِ",55,"ن",1,0],["وقصة لملم التأريخ أحرفها","فاستضحك الحبر في كفيه والصحف",56,"ف",1,0],["وقصّت امرأة عنها ، لجدّتها","فصلا ، كما ذاب فوق الخضرة الصّدف",56,"ف",1,0],["وقصائدٍ رَّقتْ فكان مدبُّها","كالخمر من ثَمِل القَوام نزيفه",57,"ف",2,0],["وَقَصِيدَة ً شَعْوَاءَ بَاقٍ نُورُهَا","تَبْلَى الْجِبَالُ وَأَثْرُهَا لَمْ يُطْمَسِ",58,"س",1,0]]}