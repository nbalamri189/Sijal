{"poems":[[53,"ودجى هتكت قناعه","https://www.aldiwan.net/poem29618.html","مجزوء الكامل"],[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[55,"ظلوم قد رأيناها","https://www.aldiwan.net/poem26331.html","مجزوء الوافر"],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[91,"أبو غازي السلام عليك منا","https://www.aldiwan.net/poem62706.html","عموديه"],[28,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[61,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[61,"أحذركم أمواج دجلة إذ غدت","https://www.aldiwan.net/poem51826.html","الطويل"],[80,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/147230","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[77,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[90,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[90,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[90,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[80,"ودجنة ٍ كالنِّفس صُبّ على الثرى","https://www.poetsgate.com/ViewPoem.aspx?id=2985",""],[107,"ودجنة لنجومها","https://www.aldiwan.net/poem16484.html","مجزوء الكامل"],[133,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[184,"صحبت الدهر في بوبي فقير","https://www.aldiwan.net/poem44076.html","الوافر"],[229,"يوم أراك به فلست أصومه","https://www.aldiwan.net/poem44567.html","الكامل"],[260,"هاتيك والدتي عجوز همة","https://www.aldiwan.net/poem68226.html","الكامل"],[326,"مولاي والأيام ينضب جامها","https://www.aldiwan.net/poem54983.html","الكامل"],[326,"قبل أن نهبط من","https://www.aldiwan.net/poem55019.html","مجزوء الرمل"],[362,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[369,"صدق الصد للملوك علامه","https://www.aldiwan.net/poem57138.html","البسيط"],[429,"ضاء ليل الخطوب منك بفجره","https://www.aldiwan.net/poem12324.html","الخفيف"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[456,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[459,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[462,"حي الديار برامتين ونادها","https://www.aldiwan.net/poem3435.html","عموديه"],[462,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[466,"ودجن مسبل الأطناب جون","https://www.aldiwan.net/poem60118.html","الوافر"],[551,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[573,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["وَدُجىً هَتَكتُ قِناعَهُ","عَن وَجهِ طامِسَةٍ خَفِيَّه",0,"ي",2,1],["ودَجا النّهارُ منَ العَجاجِ وأشْرَقَتْ","فيهِ الصّوارِمُ وهْوَ ليلٌ مُقْمِرُ",1,"ر",1,0],["وَدَجَّ فَلَم يَكُن قَمَرٌ","فَأَبرِزها تَكُن قَمَرا",2,"ر",2,0],["ودُجُنّةٍ كادَتْ تُضِلُّ بيَ السَّرَى","لوْلا وَميضَا بارِقٍ وصَفيحِ",3,"ح",1,0],["وَدَجَا ظَلاَمُ الْكُفْرِ فِي آفَاقِهِمْ","أَوَ لَيْسَ صُبْحُكَ مِنْهُمُ بِقَرِيبِ",4,"ب",1,0],["وَدَجَا فِي القُلُوبِ صُبْحُ الْ","أَمَانِي وَادْلَهَمّْ",5,"م",1,0],["ودجى طرَّة تسلَّمت القل","ب فأمسى منها بليلِ السليم",6,"م",1,0],["وَدِجلَةُ كَالطَعينِ لَهُ أَنينٌ","وَفي بَرَدى اِلتِاعٌ وَاِضطِرامُ",7,"م",1,0],["وَدَّ جَريرُ اللُؤمِ لَو كانَ عانِياً","وَلَم يَدنُ مِن زَأرِ الأُسودِ الضَراغِمِ",8,"م",1,1],["ودُجىً بذاتِ الطَّلْحِ يَبيَضُّ الهَوى","لأخي الصَّبابَةِ في ارتكامِ سَوادِه",9,"د",2,0],["ودجلةُ كَدْراءُ الأديمِ سفيهةٌ","تعافُ سجايا حَملِها وصفائِها",10,"ا",3,0],["وَدُجُنّةٍ كالنِّقْس صُبّ على الثرى","مَزّقْتُ منها بالسّرَى جلبابا",11,"ب",2,1],["ودجالين يصتنعون سحراً","وترياقاً بما صنع الجدود",12,"د",1,0],["ودجالين يصطنعون سحراً","وترياقاً بما صنع الجدود",13,"د",1,0],["ودُجىً كالسُّخط من بعد الرضى","قد دعونا نجمَه أن يُغمضا",14,"ض",2,0],["ودجت ليالي الجائعين وتحتها","مهج الجياع قتيلة الأهواء",15,"ا",2,0],["ودجنة كادت تضل بني السرى","لولا وميضا بارق وصفيح",16,"ح",1,0],["ودجلةُ خمراً وشُهداً تسيلُ","وزهوُ الفُراتِ وطُغيانه",17,"ن",2,0],["ودجلةُ كالسجينِ بغَى فراراً","وأزْبَدَ حيثُ أعوزَه المَفَرُّ",18,"ر",1,0],["ودجلةُ حُرَّةٌ ضيمَت فجاشَت","ويأبى الضيمَ والاذلالَ حرّ",18,"ر",1,0],["ودجلةَ حين تَصقُلها النُعامى","كما مَسَحتْ يدٌ خداً صقيلا",19,"ل",2,0],["ودجلةَ إذْ فارَ آذيُّها","كما حُمَّ ذُو حَرَدٍ فاغتلى",20,"ا",1,0],["ودجلةَ زهوِ الصَّبايا الملاحِ","تَخَوَّضُ منها بماءٍ صَرى",20,"ا",1,0],["ودجنة ٍ كالنِّفس صُبّ على الثرى","مزّقتُ منها بالسرى جلبابا",21,"ب",2,1],["وَدَجنة لِنُجومِها","نار الوَغى تَتَوقَدُ",22,"د",1,1],["ودجا الزّمان فكل نور حلْكةٌ","ونبا المكان فكلّ رحب ضاقا",23,"ق",2,0],["ودجلة والفرات ونيل مصر","وحزر بعد مدّ مستباح",24,"ح",1,0],["ودجى أماط لنا ثياب ظلامه","بصباح وصل منك كيف أقومه",25,"م",2,0],["ودَجَائجاً خَمساً يَرُحن إلَيهِمُ","لمَا يَبِضنَ وغَيرَ عَيرٍ مُغرِبِ",26,"ب",1,0],["ودجىً كئيب الصمت مرتاع الرؤى","شابت كواكبه وطاب مقامها",27,"م",3,0],["ودجا عمري وهانت","بهجةُ الدنيا عليّه",28,"ي",2,0],["ودجَا الظّلامُ فكاثَروا عَدَداً","بشَبا الرّماحِ نُجومَه الزُّهرا",29,"ر",2,0],["ودَجا اللَّيلُ فاستَزارَته عَيني","رُبَّما يَكشفُ الظَّلامُ ظَلامَه",30,"م",2,0],["ودّ جسمِي لو كانَ حُمِّلَ منهُ","ثِقْلَ آلامِهِ وفُزْتُ بأَجْرهْ",31,"ر",2,0],["ودجاجات يرى في كنها","كل يوم طارف البيض شتيت",32,"ت",1,0],["ودجا القولُ فعطُّوا ليله","بحديداتٍ من الألسن لُحنِ",33,"ن",1,0],["ودٌّ جديدٌ كلّما","كان الودادُ سَمَلا",34,"ل",2,0],["ودجا ظلامُ الرأي بينهُمُ","فوَضَحتَ فيه بطلعةِ الفجرِ",35,"ر",1,0],["ودجا فكادت أن تضِلَّ رماحُه","في الطَّعْنِ لولا ربطُها بالأنجمِ",36,"م",1,0],["ودجَّةٍ سوداءَ قصَّر طولها","بيضاءُ صبغىُ فودها كفؤادها",37,"د",3,0],["ودجنّةٍ أنضيتها من بعد ما","أضنى الكلالُ جيادنا والأينقا",38,"ق",2,0],["وَدَجنٍ مُسبِلِ الأَطنابِ جَونٍ","رَبيعِيٍّ لِرَفرَفِهِ اِنتِشارُ",39,"ر",1,1],["وَدُجُنَّةٌ ضَمَّنتُ هَتكَ سُتورِها","وَجناءَ صامِتَةَ البُغامِ ذَلولا",40,"ل",2,0],["ودَجَا زَمَاني بَعْد أَنْ","أَطلعتُ في نادِيه شُهْبي",41,"ي",1,0]]}