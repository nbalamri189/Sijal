{"poems":[[55,"ودجى هتكت قناعه","https://www.aldiwan.net/poem29618.html","مجزوء الكامل"],[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[57,"ظلوم قد رأيناها","https://www.aldiwan.net/poem26331.html","مجزوء الوافر"],[79,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[95,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[74,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[93,"أبو غازي السلام عليك منا","https://www.aldiwan.net/poem62706.html","عموديه"],[30,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[63,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[63,"أحذركم أمواج دجلة إذ غدت","https://www.aldiwan.net/poem51826.html","الطويل"],[82,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[92,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/147230","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[79,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[92,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[92,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[92,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[82,"ودجنة ٍ كالنِّفس صُبّ على الثرى","https://www.poetsgate.com/ViewPoem.aspx?id=2985",""],[93,"أبو غازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67923&r=&rc=203",""],[113,"ودجنة لنجومها","https://www.aldiwan.net/poem16484.html","مجزوء الكامل"],[139,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[190,"صحبت الدهر في بوبي فقير","https://www.aldiwan.net/poem44076.html","الوافر"],[236,"يوم أراك به فلست أصومه","https://www.aldiwan.net/poem44567.html","الكامل"],[267,"هاتيك والدتي عجوز همة","https://www.aldiwan.net/poem68226.html","الكامل"],[333,"مولاي والأيام ينضب جامها","https://www.aldiwan.net/poem54983.html","الكامل"],[333,"قبل أن نهبط من","https://www.aldiwan.net/poem55019.html","مجزوء الرمل"],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[376,"صدق الصد للملوك علامه","https://www.aldiwan.net/poem57138.html","البسيط"],[438,"ضاء ليل الخطوب منك بفجره","https://www.aldiwan.net/poem12324.html","الخفيف"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[463,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[469,"حي الديار برامتين ونادها","https://www.aldiwan.net/poem3435.html","عموديه"],[469,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[473,"ودجن مسبل الأطناب جون","https://www.aldiwan.net/poem60118.html","الوافر"],[558,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[580,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145826","الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145798","المتقارب"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25312","الرجز"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100618","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80008","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48943","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101046","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123035","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110326","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53107","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121176","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102571","الرمل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116500","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87395","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100178","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99313","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126956","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138653",""],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143827","الطويل"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132186","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139677",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52132","الكامل"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104488","الكامل"],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5212,"سلاماً يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=212058",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[333,"ذرية الحب","https://www.poetsgate.com/ViewPoem.aspx?id=105867",""],[5425,"في كُلِّ يَومٍ لنا من كَربَلاءَ دَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207513",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5464,"رأيت النخل يبكي","https://www.poetsgate.com/ViewPoem.aspx?id=6667",""],[5561,"أُمُّ الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=192738",""],[5725,"شدوا الركائب","https://www.poetsgate.com/ViewPoem.aspx?id=201720",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""]],"verses":[["وَدُجىً هَتَكتُ قِناعَهُ","عَن وَجهِ طامِسَةٍ خَفِيَّه",0,"ي",2,1],["ودَجا النّهارُ منَ العَجاجِ وأشْرَقَتْ","فيهِ الصّوارِمُ وهْوَ ليلٌ مُقْمِرُ",1,"ر",1,0],["وَدَجَّ فَلَم يَكُن قَمَرٌ","فَأَبرِزها تَكُن قَمَرا",2,"ر",2,0],["ودُجُنّةٍ كادَتْ تُضِلُّ بيَ السَّرَى","لوْلا وَميضَا بارِقٍ وصَفيحِ",3,"ح",1,0],["وَدَجَا ظَلاَمُ الْكُفْرِ فِي آفَاقِهِمْ","أَوَ لَيْسَ صُبْحُكَ مِنْهُمُ بِقَرِيبِ",4,"ب",1,0],["وَدَجَا فِي القُلُوبِ صُبْحُ الْ","أَمَانِي وَادْلَهَمّْ",5,"م",1,0],["ودجى طرَّة تسلَّمت القل","ب فأمسى منها بليلِ السليم",6,"م",1,0],["وَدِجلَةُ كَالطَعينِ لَهُ أَنينٌ","وَفي بَرَدى اِلتِاعٌ وَاِضطِرامُ",7,"م",1,0],["وَدَّ جَريرُ اللُؤمِ لَو كانَ عانِياً","وَلَم يَدنُ مِن زَأرِ الأُسودِ الضَراغِمِ",8,"م",1,1],["ودُجىً بذاتِ الطَّلْحِ يَبيَضُّ الهَوى","لأخي الصَّبابَةِ في ارتكامِ سَوادِه",9,"د",2,0],["ودجلةُ كَدْراءُ الأديمِ سفيهةٌ","تعافُ سجايا حَملِها وصفائِها",10,"ا",3,0],["وَدُجُنّةٍ كالنِّقْس صُبّ على الثرى","مَزّقْتُ منها بالسّرَى جلبابا",11,"ب",2,1],["ودجالين يصتنعون سحراً","وترياقاً بما صنع الجدود",12,"د",1,0],["ودجالين يصطنعون سحراً","وترياقاً بما صنع الجدود",13,"د",1,0],["ودُجىً كالسُّخط من بعد الرضى","قد دعونا نجمَه أن يُغمضا",14,"ض",2,0],["ودجت ليالي الجائعين وتحتها","مهج الجياع قتيلة الأهواء",15,"ا",2,0],["ودجنة كادت تضل بني السرى","لولا وميضا بارق وصفيح",16,"ح",1,0],["ودجلةُ خمراً وشُهداً تسيلُ","وزهوُ الفُراتِ وطُغيانه",17,"ن",2,0],["ودجلةُ كالسجينِ بغَى فراراً","وأزْبَدَ حيثُ أعوزَه المَفَرُّ",18,"ر",1,0],["ودجلةُ حُرَّةٌ ضيمَت فجاشَت","ويأبى الضيمَ والاذلالَ حرّ",18,"ر",1,0],["ودجلةَ حين تَصقُلها النُعامى","كما مَسَحتْ يدٌ خداً صقيلا",19,"ل",2,0],["ودجلةَ إذْ فارَ آذيُّها","كما حُمَّ ذُو حَرَدٍ فاغتلى",20,"ا",1,0],["ودجلةَ زهوِ الصَّبايا الملاحِ","تَخَوَّضُ منها بماءٍ صَرى",20,"ا",1,0],["ودجنة ٍ كالنِّفس صُبّ على الثرى","مزّقتُ منها بالسرى جلبابا",21,"ب",2,1],["و\" دجلة \" كالطّين له أنين","وفي \" بردى \" التياع واضطرام",22,"م",1,0],["وَدَجنة لِنُجومِها","نار الوَغى تَتَوقَدُ",23,"د",1,1],["ودجا الزّمان فكل نور حلْكةٌ","ونبا المكان فكلّ رحب ضاقا",24,"ق",2,0],["ودجلة والفرات ونيل مصر","وحزر بعد مدّ مستباح",25,"ح",1,0],["ودجى أماط لنا ثياب ظلامه","بصباح وصل منك كيف أقومه",26,"م",2,0],["ودَجَائجاً خَمساً يَرُحن إلَيهِمُ","لمَا يَبِضنَ وغَيرَ عَيرٍ مُغرِبِ",27,"ب",1,0],["ودجىً كئيب الصمت مرتاع الرؤى","شابت كواكبه وطاب مقامها",28,"م",3,0],["ودجا عمري وهانت","بهجةُ الدنيا عليّه",29,"ي",2,0],["ودجَا الظّلامُ فكاثَروا عَدَداً","بشَبا الرّماحِ نُجومَه الزُّهرا",30,"ر",2,0],["ودَجا اللَّيلُ فاستَزارَته عَيني","رُبَّما يَكشفُ الظَّلامُ ظَلامَه",31,"م",2,0],["ودّ جسمِي لو كانَ حُمِّلَ منهُ","ثِقْلَ آلامِهِ وفُزْتُ بأَجْرهْ",32,"ر",2,0],["ودجاجات يرى في كنها","كل يوم طارف البيض شتيت",33,"ت",1,0],["ودجا القولُ فعطُّوا ليله","بحديداتٍ من الألسن لُحنِ",34,"ن",1,0],["ودٌّ جديدٌ كلّما","كان الودادُ سَمَلا",35,"ل",2,0],["ودجا ظلامُ الرأي بينهُمُ","فوَضَحتَ فيه بطلعةِ الفجرِ",36,"ر",1,0],["ودجا فكادت أن تضِلَّ رماحُه","في الطَّعْنِ لولا ربطُها بالأنجمِ",37,"م",1,0],["ودجَّةٍ سوداءَ قصَّر طولها","بيضاءُ صبغىُ فودها كفؤادها",38,"د",3,0],["ودجنّةٍ أنضيتها من بعد ما","أضنى الكلالُ جيادنا والأينقا",39,"ق",2,0],["وَدَجنٍ مُسبِلِ الأَطنابِ جَونٍ","رَبيعِيٍّ لِرَفرَفِهِ اِنتِشارُ",40,"ر",1,1],["وَدُجُنَّةٌ ضَمَّنتُ هَتكَ سُتورِها","وَجناءَ صامِتَةَ البُغامِ ذَلولا",41,"ل",2,0],["ودَجَا زَمَاني بَعْد أَنْ","أَطلعتُ في نادِيه شُهْبي",42,"ب",2,0],["ودَجْلَة ُوَالشموعُ بها شموسٌ","مُضِيئاتٌ وَدَمعٌ من جُمانِ",43,"ن",1,0],["وَ( دَجلةُ) أثداؤها الحانيات","بَعُدنَ كثيراً عن الرُضَّعِ",44,"ع",1,0],["ودُجى مِن ذَوائِبٍ وارِداتٍ","لأَسارَى الغَرامِ هُنَّ القُيُودُ",45,"د",1,0],["وَدَجْنُ غَيْنٍ حَرِجٍ ذِهَابُها","يَنْهَضُ مِنْ عَوْرَتِهِ سَحَابُها",46,"ب",3,0],["ودجت حمصٌ وكانت فلكا","لمحيَّاهُ فعادت غسقا",47,"ق",2,0],["ودجا الأُفق في دجى غيهب الحز","نِ وهبَّت ريحُ الصبا إعصارا",48,"ر",2,0],["ودجتْ أمانيه فشقّ عمودَها","بالصبر حتى شاب منها المَفرِق",49,"ق",1,0],["ودُجى الاتراحِ راح","فسكرنا بالهناءِ",50,"ا",2,0],["ودجا على الخرطوم من ظلماتها","سدف تناوح تحت سود غمام",51,"م",1,0],["وَدِجلَةُ كَالدِرعِ المُضاعَفِ نَسجُها","لَها حَلَقٌ يَبدو وَيَخفى حَديدُها",52,"د",3,0],["ودجا الشعر فلولا","بارق الثغر تلالا",53,"ل",2,0],["ودجاه عندما يحسرها","نجمه اللامع والبدر المنير",54,"ر",1,0],["ودجنة طالت إلى أن أنكرت","في الأفق زهر نجومها طرق السرى",55,"ر",2,0],["ودجا الخطب والمصائب القت","رحلها فوق ضيق هذا العناق",56,"ق",1,0],["ودجى الديجور عسعس","وغفت عين الشياطين",57,"ن",1,0],["ودجن ويوم الدجن للمرء معجب","ولكن هذا فاتها بمراتب",58,"ب",1,0],["وَدَجا بِهِ لَيلُ الكروب وَهَكَذا","بِتنا نَراهُ نظيرَ حُلم النائِمِ",59,"م",1,0],["ودجية ليلات الشتاء فطالما","تقوم مقام الراهب المتعبد",60,"د",1,0],["ودجلة تجلو في المصندل شاطئاً","يرف وطياراً يخف وزبزبا",61,"ب",2,0],["ودجا للنقع ليل حالك","كان فيه برق ما ضيه صباحا",62,"ح",2,0],["ودجت أيامها من بعدهم","ودجاها بهم كان نهارا",63,"ر",2,0],["ودجلتها الغناء والزوّ نافضاً","جناحيه يحكي الطائر المتحدّرا",64,"ر",2,0],["ودجلة تجري في مذاب مفضض","يمازجه ضوء المقاصير بالتبر",65,"ر",1,0],["ودجى الجهل زال فيه فأضحى","كلُّ جهل حجىً به وهو نور",66,"ر",1,0],["ودجى الحياة عليَّ أرخى ستره","وزمانُ جدي للسعادة هانا",67,"ن",2,0],["ودجنة سدل الظلام على","كل الأنام وعم بالظلماء",68,"ا",2,0],["ودجتْ بنا ظُلَمُ الفناء تحسُّنا","لا نجمَ فيها راحمٌ متعطِّفُ",69,"ف",1,0],["ودجْلَةُ مَسْكَناً أَضْحَتْ لِمَنْ قُتِلوا","لَهُ واللهِ هذا النَّهْرُ قد صُنِعا",70,"ع",2,0],["ودجلتُها يساقيني كؤوساً","يروِّينَ الذي رامَ الوُرودا",71,"د",2,0],["ودجا عمري وهانت بهجة الدنيا عليّه","وغدًا يا توأمَ الروح تعودين إليّه",72,"ي",2,0],["ودجلةٌ بِربيعِ الموتِ مُنتَشِيٌ","كَجَحفَلِ الغَدرِ للأَعداءِ يَزدَلِفُ",73,"ف",1,0],["وَدِجْلَةَ - غَادَةَ الأَنْهَارِ- تُسْبَى","يعِيْثُ بِهَا الطغاةُ وَلا مُجِيْرُ",74,"ر",1,0],["وَدِجْلَةَ  غَادَةَ الأَنْهَارِ- تُسْبَى","يَعِيْثُ بِهَا الغُزَاةُ وَلا مُجِيْرُ",75,"ر",1,0],["ودجلةُ يسقي في حنانٍ حقولَهُ","فتعزفُ كالنجماتِ صمتاٌ يواسينا",76,"ن",2,0],["ودجَتْ نواظرها كليل مبهم","دعجاء ناكرة لفضل الاثمدِ",77,"د",1,0],["ودجلةُ والفراتُ تولّتاها","بعشق سرمديٍ لا يهابُ",78,"ب",1,0]]}