45",""],[5149,"يَا أَيُّهَا المُزْجِي حَنينَ غَرَامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=211188",""],[5187,"حواء وتجربتي","https://www.poetsgate.com/ViewPoem.aspx?id=29256",""],[5212,"حِبالُ الموت","https://www.poetsgate.com/ViewPoem.aspx?id=212025",""],[5271,"الى/ لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=67533",""],[5277,"رسالة إلى ورقة التوت","https://www.poetsgate.com/ViewPoem.aspx?id=185574",""],[5279,"آهٍ يَا شَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=183879",""],[5324,"وللحمير حظوظ.","https://www.poetsgate.com/ViewPoem.aspx?id=212811",""],[5413,"الشِّعْرُ يَرْقُصُ","https://www.poetsgate.com/ViewPoem.aspx?id=200601",""],[5431,"هانيبعل...","https://www.poetsgate.com/ViewPoem.aspx?id=201063",""],[5461,"المعاناة","https://www.poetsgate.com/ViewPoem.aspx?id=30029",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[5595,"شِيباً شَباباً نعتليها عَنْوَةً","https://www.poetsgate.com/ViewPoem.aspx?id=177053",""],[5618,"القدس في عين شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=208919",""],[5638,"رثاء الشيخ أحمد ياسين","https://www.poetsgate.com/ViewPoem.aspx?id=198130",""],[5648,"شموخ ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=154830",""],[5648,"فصلة الفيش","https://www.poetsgate.com/ViewPoem.aspx?id=156247",""],[5652,"ديسمبر الجوع !!","https://www.poetsgate.com/ViewPoem.aspx?id=177371",""],[5672,"حكاية","https://www.poetsgate.com/ViewPoem.aspx?id=206557",""],[5674,"امي ... افتقدتك بشدة","https://www.poetsgate.com/ViewPoem.aspx?id=186941",""],[5674,"تيممي بالشعر كوني ساحرة","https://www.poetsgate.com/ViewPoem.aspx?id=191190",""],[5674,"أقدارنا اختلفت","https://www.poetsgate.com/ViewPoem.aspx?id=191894",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5747,"بعض الخطا","https://www.poetsgate.com/ViewPoem.aspx?id=61611",""],[5747,"إن تباطيت ماابطيت","https://www.poetsgate.com/ViewPoem.aspx?id=61684",""],[5758,"عزفٌ أخْضر","https://www.poetsgate.com/ViewPoem.aspx?id=200586",""],[5792,"ماقال احبك","https://www.poetsgate.com/ViewPoem.aspx?id=180338",""],[5853,"ذوبي على صدري","https://www.poetsgate.com/ViewPoem.aspx?id=178336",""],[5873,"عطر الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=215310",""],[5906,"نصفي حطام","https://www.poetsgate.com/ViewPoem.aspx?id=188019",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5975,"هذي حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=58788",""],[6019,"فراشة في الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=53049",""],[6070,"الشَّمسُ تَغربُ والضِّياءُ ينادي","https://www.poetsgate.com/ViewPoem.aspx?id=189948",""],[6089,"خذ غيومك وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=214046",""],[6145,"على خطا شيخ الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=7796",""],[520,"قلب الزمان في الخلافة قاس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577564",""],[406,"مليون توقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63261&r=&rc=71",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""],[5126,"الطائف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87785&r=&rc=0",""]],"verses":[["هذي حياة إن تطل أو لم تطل","مقضية كتنفس الصعداء",0,"ا",2,0],["هَذي حَديَّةُ عَبدٍ أَنتَ مُلبِسُهُ","ثَوبَ الغِنى فَاِقبَلِ المَيسورَ مِن خَدَمِك",1,"ك",1,1],["هذي حكاية حال جئت أذكرها","وليس يخفي على الأحرار مغزاها",2,"ا",3,0],["هذي حكومتنا وكل شُموخها","كَذِب وكل صنيعها متكلَّف",3,"ف",1,0],["هذي حماة أغصَّ الهمُّ وادِيها","وطاوعَ الحزن فيه دمع عاصيه",4,"ي",2,0],["هَذي حِكايَتُها وَفيها عَبرَةٌ","لِلطائِشينَ كَهَذِهِ الحَمقاءِ",5,"ا",2,0],["هَذي حِكايَتُهُم أُسَطِّرُها لَكُم","لا دِرهَماً أَبغي وَلا دينارا",6,"ر",2,0],["هَذي حُدودُ اللَهِ مَن يَخلُل بِها","فَجَزاؤُهُ يَومَ المَعادِ جَهَنَّمُ",7,"م",1,0],["هَذي حُروفُ اللَفظِ سَطرٌ واحِدٌ","مِنها يُؤَلَّفُ لِلكَلامِ بِحارُ",8,"ر",1,0],["هَذي حِبالُ الشَمسِ وَهِيَ ضَعيفَةٌ","دامَت وَكَم أَبلَت حِبالَةَ خاتِلِ",9,"ل",1,0],["هَذِي حقِيقَةُ حَالِنا فَتَبَيَّنُوا","مِنْ ذِكْرِ أَدْنَاهَا بَعِيدَ مُرَادِي",10,"د",2,0],["هذي حياضُ المنى، يا مصرُ، مترعةً","لا طَاب موردُها إن أنتِ لم تردي",11,"د",2,0],["هذي حقائقُ كدْتُ ألمِسُها","لَيسَتْ بوحْيَ خَيالي الشِّعرى",12,"ر",2,0],["هذي حماسة ثائر","عَزْمُ الاله يَمُدُّه",13,"د",2,0],["هذي حياتي فقل لي كيف أندبها","قد جل ما بي عن سلوى وتأساء",14,"ا",2,0],["هذى حَبابٌ فوق صفحتها","طافٍ وهذا جدولٌ يجرى",15,"ر",2,0],["هذي حياتي وعندي من سرائرها","ما يملأ الكونَ أفراحاً وأحزانا",16,"ن",2,0],["هذي حياتي وهذا الشوقُ يُجْبِرُني","على التّغُزّلِ في آلاءِ فاتنتي",17,"ت",2,0],["هذي حياة الأديب","في عالم منهار",18,"ر",1,0],["هذي حصون الروم عطل غزوها","وغرت دياركم بنو العباس",19,"س",1,0],["هذي حديقة وردٍ قد بعثتُ بها","إلى حديقة فضلٍ في الوَرَى عَظُمَا",20,"م",2,0],["هذي حياة الجد في القوم الأُلَى","هزلوا وجد سواهمُ يتصيد",21,"د",1,0],["هذي حرام لست أشربها","شربي حليب النوق يا رجل",22,"ل",1,0],["هذي حقيقة حالتي فتأملوا","في صورتي تتحققوا أخباري",23,"ي",1,0],["هَذِي حَرَائِرُ خَاطِري وَجَّهْتُهَا","خَدَماً لعِزِ مَقَامِكُمْ لاَ تُعتَقُ",24,"ق",1,0],["هذي حياتك للجميع كفضلكم","والجود منك قد استمدَّ الجودا",25,"د",2,0],["هذي حياتي اهوالٌ اغالبها","لكي افي ام اولادي وأولادي",26,"ي",1,0],["هذي حقيقته فلزم طريقته","ولا تخالفه في سرٍّ ولا علن",27,"ن",1,0],["هَذِي حِسَانُ عَرَائِسٍ زُفَّت لَكُم","وَلَدَى المُعطِّلِ هُنَّ غَيرُ حِسَانِ",28,"ن",1,0],["هذي حياتك في استقامة سيرها","ونشاطها في الخلق خير مثال",29,"ل",1,0],["هَذي حَمامات الهَنا قَد غردت","وَلاحظت عين العُلى أَطواقَها",30,"ق",3,0],["هذي حبوبك لم تكمّل لَقْطها","والماء ضِمْنَ إنائك المهجور",31,"ر",1,0],["هذي حماة مدينة سحرية","وأنا امرؤ بجمالها مسحورُ",32,"ر",1,1],["هذي حَقائِقُ لا يَرى تَصديقَها","قَلبٌ تَساوى بِالعُداةِ خِصالا",33,"ل",2,0],["هذي حياة أديب","للفن كان رسولا",34,"ل",2,0],["هذي حياتي وهو أول مصرعٍ","خرق العظام وكنت فيه حزينا",35,"ن",2,0],["هذي حقائق فوق الطرس أوضحها","فلا يخامرك مما قلته الغضب",36,"ب",1,0],["هذي حواشٍ طرزت ببيانِ","قامت دلائلها مقام عيانِ",37,"ن",1,1],["هَذِي حَوَاشٍ تَجَلَّت","بَينض التَّصَانِيفِ خَودَه",38,"د",2,1],["هذي حقائقُ كلُّها","ليست من القولِ المقول",39,"ل",1,0],["هذي حمياك أم هذا محياكا","وذا الحباب طفا أم ذي ثناياكا",40,"ك",2,1],["هذي حياتي وهذا الشوقُ يُجْبِرُني على التّغُزّلِ في آلاءِ فاتنتي","ما كلّ حُسْن بهذا الكون يَذبَحُني أوْ كُلّ رامِيَةٍ بالعين راميتي",41,"ت",2,0],["هذي حياتي فإن يعجَب لَها أَحدٌ","فَفي حَياتي أَرى كُلّ العجيباتِ",42,"ت",1,0],["هذي حلات الحب صافين الاثنين","كلن يبيع الود للي يسومه",43,"م",2,0],["هذي حروفي حرفها حرٍّ خطوف","حرٍّ على صيد السمين مسيطري",44,"ر",2,0],["هذي حدودك .. وانت ياليت تلزم","لا اسمع ندا قلبك ولا اسمع جوابه",45,"ب",2,0],["هذي حقيقه / فرضها وقتي القاسي","كم لي اقاوم / طعونه واتحسسها",46,"س",3,0],["هذي حروفي حداها الشوق تنظُمُنِي","إليكَ حبًّا بأعماقِي رسا ونَمَا",47,"م",2,0],["هذي حروفي للهوى، خبَّأتُها","في خافقي فمتى الأنين يتوبُ",48,"ب",1,0],["هذي حقيقتُكِ النوراءُ أفهمُها","كشفَ المرايا الذي لمْ يستبحْ كذبا",49,"ب",2,0],["هَذِي حَدَائِقُنَا مُعَلَّقَةٌ هُنَا","فِإذَا الْحَدَائِقُ وَرْدُهَا عَنَّاقُ",50,"ق",1,0],["هَذِي (حَنِيِنُ) إِلَيْكَ تُهْدِي جَذْرَهَا","وَالأُمِّ تُهْدِي بِالْحَنَانِ جُذُورَا",51,"ر",2,0],["هذي حياة الكون كل ضروبها","نكد وكل صروفها آلام",52,"م",1,0],["هذِي حَيَاةُ المَرْءِ أَسْرَعُ رَاكِضٍ","حَيْثُ المَغِيبُ، أَلَيسَ مِثْلُكَ ذَاهِبَا؟",53,"ب",2,0],["هذي حقائقُ سوفَ تَعرِفُها","إنْ كُنتَ ذا جلدٍ على السَفَرِ",54,"ر",1,0],["هذي حِبالُ المَوتِ تَسْمَعُ قولها","قَدْ جاءَك المَوتُ القَريبُ الأوعَدُ",55,"د",1,0],["هَذي حُروفي تشتكيها لوعتي","مُذْ غَادرَ النوَّارُ بحريَ أَزْبَدَا",56,"د",2,0],["هذي حروفٌ حبرهنَّ مدامعٌ","أزمّنَّ داءاً قد عدمنَ شفاءا",57,"ا",3,0],["هَذِي حُرُوفُ مَحَبَّتِي يَا شَامُ","قَدْ سَطَّرَتْهَا مِنْ دَمِي الأَقْلاَمُ",58,"م",1,1],["هذي حظوظ للبهائم قدرت","ولغيرهم.. فالداء منها ارفق.",59,"ق",1,0],["هَذِي حُرُوفٌ مِنْ جَنَانٍ مُغْرَمٍ","لَكِ يَا جِنَانِي مَهْرُهُن