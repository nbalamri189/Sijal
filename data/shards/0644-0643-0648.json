{"poems":[[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[47,"مستجير الهوى بغير مجير","https://www.aldiwan.net/poem25293.html","الخفيف"],[72,"كن كيف شئت فلا براح","https://www.aldiwan.net/poem18503.html","مجزوء الكامل"],[72,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[51,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[51,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[51,"لم تكن مثل نعمة الله في العب","https://www.aldiwan.net/poem62993.html","الطويل"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[85,"تنازع الغزال والخروف","https://www.aldiwan.net/poem8002.html","الرجز"],[85,"أبو الحصين جال في السفينه","https://www.aldiwan.net/poem8021.html","الرجز"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[102,"أنت كالاحتلال زهوا وكبرا","https://www.aldiwan.net/poem32959.html","الخفيف"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[48,"مرحبا يا سمي من كلم الله","https://www.aldiwan.net/poem10813.html","الخفيف"],[46,"لكون خلك في رمس أعز له","https://www.aldiwan.net/poem22258.html","البسيط"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[106,"الطبيب إمام","https://www.poetsgate.com/ViewPoem.aspx?id=179382",""],[129,"دعوه يبكى دما ودمعا","https://www.aldiwan.net/poem50582.html","مخلع البسيط"],[190,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[205,"أنا أفديك من ملول أَلوف","https://www.aldiwan.net/poem53242.html","الخفيف"],[205,"سيدي دعني أداري","https://www.aldiwan.net/poem53305.html","مجزوء الرمل"],[251,"يا وزير العلا ومن حاز مجدا","https://www.aldiwan.net/poem15040.html","الخفيف"],[260,"هزنا الشوق للمقام السني","https://www.aldiwan.net/poem35969.html","الخفيف"],[262,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[372,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[378,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[417,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[430,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[433,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[438,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[552,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[552,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[559,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[559,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[576,"لك وجه وفيه قطعة أنف","https://www.aldiwan.net/poem2807.html","الخفيف"]],"verses":[["لَكَ وَقفَةٌ في الشَرقِ تَعرِفُها العُلا","وَيَحُفُّها التَكبيرُ وَالتَهليلُ",0,"ل",1,0],["لَكَ وَصفي وَفيكَ شِعري وَلا أَع","رِفُ وَصفَ المَوّارَةِ العَيسَجورِ",1,"ر",1,0],["لكَ وجنةٌ خسرانُ قل","بي في محبتها رباح",2,"ح",1,0],["لك وجهٌ يعزى له كلّ حسنٍ","كاعْتزاءِ العلى إلى محمود",3,"د",1,0],["لك وجهٌ محكمٌ صنعتُهُ","ما تَرى عُقِّب إلا بعَقبْ",4,"ب",1,0],["لَك وجْهٌ تذوبُ مَقْ","تاً وبغْضَاً له المهَجْ",5,"ج",1,0],["لك وجه كأنه حين يبدو","مستعارٌ من منكر ونكير",6,"ر",1,0],["لك وجهٌ مشفَّعٌ مَنْ رآه","زاحَ عنه هناك كلُّ اعتلالِ",7,"ل",1,0],["لِكَونِهِ لا يَعرِفُ الغَزالا","وَلَيسَ يُلقي لِلخَروفِ بالا",8,"ل",2,0],["لِكَونِ ما حَلَّ مِنَ المَصائِبِ","مِن غَضَبِ اللَهِ عَلى الثَعالِبِ",9,"ب",1,0],["لكِ وجهٌ أغرُّ باهٍ فريدٌ","مثلُ دهرِ الوزير بينَ الدهورِ",10,"ر",1,0],["لَكَ وَجه كَأَنَّهُ سَمسا","ر عَلى شَرط أَن يَكون وَجيها",11,"ي",3,0],["لَكَ وَجه مَلائِكي وَسيم","نوره يَفعم القُلوب جَلالا",12,"ل",2,0],["لَكَ وَجهٌ مَحاسِنُ الخَلقِ فيهِ","ماثِلاتٌ تَدعو إِلَيهِ القُلوبا",13,"ب",2,0],["لَكَونُ خِلِّكَ في رَمسٍ أَعَزُّ لَهُ","مِن أَن يَكونَ مَليكاً عاقِدَ التاجِ",14,"ج",1,1],["لِكَوكَبٍ نازِحٍ مِن كَفِّ لامِسِهِ","وَصَخرَةٍ وَسمُها في قَرنِ ناطِحِها",15,"ح",3,0],["لك وجهٌ يكاد يقطر بِشْرًا","وابتسام تُشْفَى به الآلامُ",16,"م",1,0],["لك وقْعٌ إذا المنايا","في الحرب تغلى أشد وقْعَا",17,"ع",2,0],["لِكَونِها وَصفاً له لا علما","مِنها منَ الحُسنى حباهُ اللَّه",18,"ه",1,0],["لك وجه كالبدر لكن بريءٌ","من محاقٍ أو غَيبَةٍ أو كسوفِ",19,"ف",1,0],["لك وجه راق طرفي","ببياضٍ واحمرارِ",20,"ر",1,0],["لك وَجهٌ كالشمس في ظُلمَة","الخَطب وكفٌّ كالعارض الهَتَّان",21,"ن",1,0],["لَكَ وَجهي وَجَّهتُ يا أَبيَضَ الوج","هِ فَوَجِّه إِلَيهِ وَجهَ الوَلِيِّ",22,"ي",1,0],["لكونك صيرفي أولي المعاني","وأمهرها انتقاءً وانتقادا",23,"د",2,0],["لكَ واللَّهِ في صَميم فُؤادي","لذَّةُ الماءِ في فَم العَطشانِ",24,"ن",1,0],["لكون علاها لم يشبه تنزلٌ","ولا عثرةٌ في الفترة الوثنية",25,"ه",1,0],["لك وجه لمعت من وجه","شمس رشد نورها لن ينكرا",26,"ر",2,0],["لك وافت من مخلص عيسويّ","وتبدّت ترجوك حسن المآل",27,"ل",1,0],["لك وجْه الحمارِ لكنْ عليه","لحيةٌ عُلِّقَتْ كبعض المَخالي",28,"ل",2,0],["لك ودّي ما أقام حرى","والبرايا أحمداً حمدوا",29,"د",3,0],["لكواكِبِ الفِتيانِ فيه تحجّبٌ","ولأنجُمِ الفَتَياتِ فيه تبرُّجُ",30,"ج",1,0],["لك وجهٌ في الوغى يُش","رق ما بين القَتامِ",31,"م",1,0],["لك وِرْدٌ من حوضهمْ غيرُ مطرو","قٍ وبابٌ إليهمُ مفتوحُ",32,"ح",1,0],["لكونه رائياً فلو لم","يرى رآه إليه داني",33,"ن",2,0],["لك وجنة هي في النواظر جنة","وجهنم في قلب كل طريح",34,"ح",1,0],["لك وجهٌ وفيه قطعةُ أَنفٍ","مثلُ حَيطٍ قد أَدعموه بنعلهْ",35,"ه",1,1]]}