{"poems":[[88,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[49,"مستجير الهوى بغير مجير","https://www.aldiwan.net/poem25293.html","الخفيف"],[74,"كن كيف شئت فلا براح","https://www.aldiwan.net/poem18503.html","مجزوء الكامل"],[74,"لا ورشف اللمى ولثم الخدود","https://www.aldiwan.net/poem18561.html","الخفيف"],[53,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[53,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[53,"لم تكن مثل نعمة الله في العب","https://www.aldiwan.net/poem62993.html","الطويل"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[87,"تنازع الغزال والخروف","https://www.aldiwan.net/poem8002.html","الرجز"],[87,"أبو الحصين جال في السفينه","https://www.aldiwan.net/poem8021.html","الرجز"],[71,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[104,"أنت كالاحتلال زهوا وكبرا","https://www.aldiwan.net/poem32959.html","الخفيف"],[104,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[50,"مرحبا يا سمي من كلم الله","https://www.aldiwan.net/poem10813.html","الخفيف"],[48,"لكون خلك في رمس أعز له","https://www.aldiwan.net/poem22258.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[108,"الطبيب إمام","https://www.poetsgate.com/ViewPoem.aspx?id=179382",""],[132,"دعوه يبكى دما ودمعا","https://www.aldiwan.net/poem50582.html","مخلع البسيط"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[208,"أنا أفديك من ملول أَلوف","https://www.aldiwan.net/poem53242.html","الخفيف"],[208,"سيدي دعني أداري","https://www.aldiwan.net/poem53305.html","مجزوء الرمل"],[255,"يا وزير العلا ومن حاز مجدا","https://www.aldiwan.net/poem15040.html","الخفيف"],[264,"هزنا الشوق للمقام السني","https://www.aldiwan.net/poem35969.html","الخفيف"],[266,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[376,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[422,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[435,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[438,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[443,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[519,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[556,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[556,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[563,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[580,"لك وجه وفيه قطعة أنف","https://www.aldiwan.net/poem2807.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48643","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199583","المسحوب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120100","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119892","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120093","المديد"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120070","الرمل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216686",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136138","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79973","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11959","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108923","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108755","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26575","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125417","الرمل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71033","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27750","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102574","الوافر"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98167","الرمل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100427","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58280","الخفيف"],[3128,"","https://poetry.dctabudhabi.ae/diwan/poem/198465","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87387","الكامل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205572","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40093","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135123","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73177","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136632",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204201","الخفيف"],[4784,"حياك مياس المعاطف","https://www.poetsgate.com/ViewPoem.aspx?id=170932",""],[4791,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=35555",""],[4816,"كوكب سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=8456",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[5121,"شَاعِرُ الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=212038",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5213,"خليفة اللّه فينا","https://www.poetsgate.com/ViewPoem.aspx?id=170399",""],[5563,"مدعوجة العينين ( نبطية )","https://www.poetsgate.com/ViewPoem.aspx?id=212820",""],[5593,"لك وجه كأن يمناي خط","https://www.poetsgate.com/ViewPoem.aspx?id=181035",""],[5739,"من يسرق البلبل اجناحه","https://www.poetsgate.com/ViewPoem.aspx?id=126712",""],[5775,"مض الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=35141",""],[5848,"كيف اكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=53095",""],[6069,"من لصبٍ مسه فرط الكمد","https://www.poetsgate.com/ViewPoem.aspx?id=105660",""],[406,"إلى ياسر عرفات ( بعها )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=840&r=&rc=31",""],[4222,"أجيران جيرون مالي مجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52786&r=&rc=78",""]],"verses":[["لَكَ وَقفَةٌ في الشَرقِ تَعرِفُها العُلا","وَيَحُفُّها التَكبيرُ وَالتَهليلُ",0,"ل",1,0],["لَكَ وَصفي وَفيكَ شِعري وَلا أَع","رِفُ وَصفَ المَوّارَةِ العَيسَجورِ",1,"ر",1,0],["لكَ وجنةٌ خسرانُ قل","بي في محبتها رباح",2,"ح",1,0],["لك وجهٌ يعزى له كلّ حسنٍ","كاعْتزاءِ العلى إلى محمود",3,"د",1,0],["لك وجهٌ محكمٌ صنعتُهُ","ما تَرى عُقِّب إلا بعَقبْ",4,"ب",1,0],["لَك وجْهٌ تذوبُ مَقْ","تاً وبغْضَاً له المهَجْ",5,"ج",1,0],["لك وجه كأنه حين يبدو","مستعارٌ من منكر ونكير",6,"ر",1,0],["لك وجهٌ مشفَّعٌ مَنْ رآه","زاحَ عنه هناك كلُّ اعتلالِ",7,"ل",1,0],["لِكَونِهِ لا يَعرِفُ الغَزالا","وَلَيسَ يُلقي لِلخَروفِ بالا",8,"ل",2,0],["لِكَونِ ما حَلَّ مِنَ المَصائِبِ","مِن غَضَبِ اللَهِ عَلى الثَعالِبِ",9,"ب",1,0],["لكِ وجهٌ أغرُّ باهٍ فريدٌ","مثلُ دهرِ الوزير بينَ الدهورِ",10,"ر",1,0],["لَكَ وَجه كَأَنَّهُ سَمسا","ر عَلى شَرط أَن يَكون وَجيها",11,"ي",3,0],["لَكَ وَجه مَلائِكي وَسيم","نوره يَفعم القُلوب جَلالا",12,"ل",2,0],["لَكَ وَجهٌ مَحاسِنُ الخَلقِ فيهِ","ماثِلاتٌ تَدعو إِلَيهِ القُلوبا",13,"ب",2,0],["لَكَونُ خِلِّكَ في رَمسٍ أَعَزُّ لَهُ","مِن أَن يَكونَ مَليكاً عاقِدَ التاجِ",14,"ج",1,1],["لِكَوكَبٍ نازِحٍ مِن كَفِّ لامِسِهِ","وَصَخرَةٍ وَسمُها في قَرنِ ناطِحِها",15,"ح",3,0],["لك وجهٌ يكاد يقطر بِشْرًا","وابتسام تُشْفَى به الآلامُ",16,"م",1,0],["لك وقْعٌ إذا المنايا","في الحرب تغلى أشد وقْعَا",17,"ع",2,0],["لِكَونِها وَصفاً له لا علما","مِنها منَ الحُسنى حباهُ اللَّه",18,"ه",1,0],["لك وجه كالبدر لكن بريءٌ","من محاقٍ أو غَيبَةٍ أو كسوفِ",19,"ف",1,0],["لك وجه راق طرفي","ببياضٍ واحمرارِ",20,"ر",1,0],["لك وَجهٌ كالشمس في ظُلمَة","الخَطب وكفٌّ كالعارض الهَتَّان",21,"ن",1,0],["لَكَ وَجهي وَجَّهتُ يا أَبيَضَ الوج","هِ فَوَجِّه إِلَيهِ وَجهَ الوَلِيِّ",22,"ي",1,0],["لكونك صيرفي أولي المعاني","وأمهرها انتقاءً وانتقادا",23,"د",2,0],["لكَ واللَّهِ في صَميم فُؤادي","لذَّةُ الماءِ في فَم العَطشانِ",24,"ن",1,0],["لكون علاها لم يشبه تنزلٌ","ولا عثرةٌ في الفترة الوثنية",25,"ه",1,0],["لك وجه لمعت من وجه","شمس رشد نورها لن ينكرا",26,"ر",2,0],["لك وافت من مخلص عيسويّ","وتبدّت ترجوك حسن المآل",27,"ل",1,0],["لك وجْه الحمارِ لكنْ عليه","لحيةٌ عُلِّقَتْ كبعض المَخالي",28,"ل",2,0],["لك ودّي ما أقام حرى","والبرايا أحمداً حمدوا",29,"د",3,0],["لكواكِبِ الفِتيانِ فيه تحجّبٌ","ولأنجُمِ الفَتَياتِ فيه تبرُّجُ",30,"ج",1,0],["لك وجهٌ في الوغى يُش","رق ما بين القَتامِ",31,"م",1,0],["لك وِرْدٌ من حوضهمْ غيرُ مطرو","قٍ وبابٌ إليهمُ مفتوحُ",32,"ح",1,0],["لكونه رائياً فلو لم","يرى رآه إليه داني",33,"ن",2,0],["لك وجنة هي في النواظر جنة","وجهنم في قلب كل طريح",34,"ح",1,0],["لك وجهٌ وفيه قطعةُ أَنفٍ","مثلُ حَيطٍ قد أَدعموه بنعلهْ",35,"ه",1,1],["لك وحدك الوادي الخصيب ونيله","ولربك التقديس والتسبيح",36,"ح",1,0],["لك ودٍّ في حشايا","يعجز عنْه الصّخر",37,"ر",1,0],["لك وجه مشرق الأن","وار ميمون صبيحُ",38,"ح",1,0],["لك ورد صاف وربع خصيب","وجناب رحب وظل ضافِ",39,"ف",1,0],["لك وجه من تأمله","زال عنه البؤس والتَّرحُ",40,"ح",1,0],["لك وجه مستنير","كضياء الصبح نقبه",41,"ب",2,0],["لك ود ما ناله من الناس من فات","ولا من بقَى فوق الثرى في ذراها",42,"ا",3,0],["لك وجهت وجهتي حيثما كنت","فعجل بالكشف للمعضلات",43,"ت",1,0],["لكَ وجهٌ لو باهلَ الشمس يوماً","لعرا وجهها المنيرَ انكسافُ",44,"ف",1,0],["لَكَ وَجهٌ كَأَنَّهُ ال","بَدرٌ لَكِن إِذا كُسِف",45,"ف",1,0],["لكوكب الشرق عباس الذي بهر ال","باري به الغرب إذ سوّاه إنسانا",46,"ن",2,0],["لك واغتدت لحشاشتي جمراته","زفت عليك مع الصبا نفحاته",47,"ه",1,0],["لَكَ وَجهٌ كَآخِرِ الصَكِّ فيهِ","لَمَحاتٌ كَثيرَةٌ مِن رِجالِ",48,"ل",1,1],["لَكَ وَجهٌ غَداً سَيَأكُلُهُ الدو","دُ وَيَمشي الفَسادُ في أَوصالِك",49,"ك",1,0],["لك وجهٌ جلَّ من صوَّرَهُ","فُتِنَ الحسنُ به لما اكتمل",50,"ل",1,0],["لِكَوْنِها قد تغشَّى وَجْهَها صَدَأ","غَدابه وَهْوَ أَعمى اللُّبِّ مَنْبُورُ",51,"ر",1,0],["لكونه باسمه الله يزينه","علامه بالذي فيه من الحلل",52,"ل",1,0],["لكونك يا شهاب الدين صدقا","إماماً فاضلاً في العلم حبرا",53,"ر",2,0],["لكونِنا من أمة النبيِّ","الهاشميِّ المصطفى الأمِّيِّ",54,"ي",1,0],["لك ود قد جبرنا","ه فأعيانا صدوعه",55,"ه",1,1],["لِكَونِهِم قَد رحموا بِالمَطر","وَزادوا أَفراحاً بِنَيل الوَطَر",56,"ر",1,0],["لِكَونِهِ جاءَ إِلى كركوك","أَحاطَ بِالمالِكِ وَالمَملوكِ",56,"ك",1,0],["لك والحسني حضيرة علوية","مثلت إلى جنب الضراح ضراحا",57,"ح",2,0],["لك وجهٌ هدى وشعر ضلالٌ","فيهما للمشوق رشد وغيُّ",58,"ي",1,0],["لكَ وجهٌ فاقَ الهلالَ وكف","يخجلُ الغَيْثَ بالنّدى مستهلّه",59,"ل",2,0],["لك والله في الفؤاد محلٌّ","ما إليه مدى الزمان وصول",60,"ل",1,0],["لك وَحشَةٌ طيَّ القُلوبِ كأَنَّما","لكَ في قلوبِ العالمين منازِلُ",61,"ل",1,0],["لكوكبين في خلال الصوره","حولهما كواكب صغيره",62,"ه",1,0],["لك وجه كأنه طابع الصدْ","قِ على صفحة الزمان المأُوفِ",63,"ف",1,1],["لك وجه ينجاب كل ظلام","ان تبدي بنوره المتلالي",64,"ي",1,0],["لَكَ وَجهٌ مَيَاسِمُ الحُسْن فيه","سِكَّةٌ تُطبَع البُدُور عليها",65,"ي",3,0],["لَكَ وُدِّي مِن ثَمَّ تَدرِي تَنَاهى","وبِجُهدِي بَلَغتَ ما أَنتَ قَدرا",66,"ا",1,0],["لِكَونِهِ يُوصَفُ ذُو المَحَالِ","بِهِ وَعَكسُهُ ادعُ بِالمُحَالِ",67,"ل",1,0],["لكونه حاز علا نبيلا","مستوجب ثنائي الجميلا",68,"ل",2,0],["لكَ وعدق مُستقبَلٌ حالَ قَسراً","دونه سيفُ مُقلتيكَ الماضي",69,"ض",2,0],["لك ودٌ بين الضُلوع مقيمٌ","عَلم الله صدقة والغَرام",70,"م",1,0],["لِكَواكِبٍ هِيَ في تَراكُبِها","حَلَقُ الدُروعِ يَضُمُّها السَردُ",71,"د",1,0],["لك وجه كأن يمناك خطته","بلفظ تمله آمالي",72,"ل",2,