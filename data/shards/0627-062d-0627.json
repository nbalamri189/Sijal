ي","https://www.aldiwan.net/poem52844.html","البسيط"],[564,"قد طلع البدر من المغرب","https://www.aldiwan.net/poem52981.html","السريع"],[566,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[578,"يعيرني أمي رجال لا أرى","https://www.aldiwan.net/poem1777.html","الطويل"],[587,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[588,"وصالك أنهى مطلبي ومرادي","https://www.aldiwan.net/poem17494.html","الطويل"],[800,"","https://poetry.dctabudhabi.ae/diwan/poem/31547","الوافر"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20481","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28076","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21474","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/117837","الطويل"],[988,"","https://poetry.dctabudhabi.ae/diwan/poem/20939","الطويل"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/20542","المتقارب"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/114905","الطويل"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/114901","المتقارب"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/114914","الطويل"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/114906","الطويل"]],"verses":[["أحاديث غادرن المؤرخ أشفقت","عليه من التأويل فيها متاعبه",0,"ب",2,0],["أحابي ما بوسعي منه دلاً","وهل خلقٌ بذي دلٍ يُحابى",1,"ب",2,0],["أَحالوا عَلَيها عاكِسينَ رِقابَها","وَطَوا بِهَواديها مَكانَ الفَراسِنِ",2,"ن",1,0],["أَحاسِدَ ذا الضَرغامِ دونَكَ فَاِجتَنِب","بَوادِرَ مِقدامِ الجَنانِ مُحامي",3,"م",2,0],["أَحاديثُ تَستَدعي الوَقورَ إِلى الصِبا","وَتَكسو حَليمَ القَومِ ثَوبَ عُرامِ",4,"م",1,0],["أُحاجي رِجالاً ما مَلابِسُ سودُ","جَدائِدُ لا يَبقى لَهُنَّ جَديدُ",5,"د",1,1],["أُحاذِرُ الفُقْرَ يَوماً أَنْ يُلِمَّ بها","فَيهْتِكَ السِّتْرَ عن لَحْمٍ على وَضَمِ",6,"م",1,0],["أُحاوِلُ ما يُرضيكِ غَيرَ مُجادِلٍ","عَلى كُلِّ حالٍ مِن مَغيبٍ وَمَشهَدِ",7,"د",1,0],["أَحالَ عَليَّ الدَهرُ مِن كُلِّ جانِبٍ","وَدامَت وَلَم تُقلِع عَلَيَّ الفَجائِعُ",8,"ع",1,0],["أُحامِقُهُ حَتّى تُقالَ سَجِيَّةٌ","وَلَو كانَ ذا عَقلٍ لَكُنتُ أُعاقِلُه",9,"ه",1,0],["أحاطَ بِنا الأعْداءُ منْ كلِّ جانِبٍ","فلا وَزَراً عنْهُمْ وجَدْنا ولا كَهْفا",10,"ف",2,0],["أَحارِ بِنَ بَدرٍ قَد وَليتَ ولايَةً","فَكُن جُرَذاً مِمَّن يَخونُ وَيَسرِقُ",11,"ق",1,1],["أَحامِدُ كَيفَ تَنساني وَبَيني","وَبَينَكَ يا أَخي صِلَةُ الجِوارِ",12,"ر",1,1],["أُحاجي وَقَد أَصبَحتُ عَنها بِمَعزِلٍ","وَلَم تُبقِ لِيَ الأَيّامُ عَقلاً وَلا حِسا",13,"س",2,1],["أُحاوِلُ أَن أَمشي إِلى الغَربِ راجِلاً","وَأَحداثُها بي في فَمِ الشَرقِ تَقذِفُ",14,"ف",1,0],["أُحاذِرُ أَن تَتَظَنّى الوُشاةُ","وَقَد يُستَدامُ الهَوى بِالحَذَر",15,"ر",1,0],["أَحارِ تَرى بَرقاً أُريكَ وَميضَهُ","كَلَمعِ اليَدَينِ في حَبِيٍّ مُكَلَّلِ",16,"ل",1,0],["أَحارِ بنُ عَمروٍ كَأَنّي خَمِر","وَيَعدو عَلى المَرءِ ما يَأتَمِر",17,"ر",1,1],["أَحاطَت يَداهُ بِالخِلافَةِ بَعدَما","أَراد رِجالٌ آخَرونَ اِغتِيالَها",18,"ل",3,0],["أُحاذِرُ أَن تَلقوا رَدىً وَمَطِيَّكُم","خَواضِعُ تَبغيني حِمامَ المَصارِعِ",19,"ع",1,0],["أَحَاطَتْ بِهِ زِينَاتُ دُنْيَاهُ فَانْثَنَى","وَلَمْ تُغْرِهِ زِيناتُها بالمحَارِمِ",20,"م",1,0],["أُحاوِلُ نَقلَ الشَمسِ مِن مُستَقَرِّها","وَإِسماعَ أَحجارٍ مِنَ الصَلِداتِ",21,"ت",1,0],["أَحارِ بنَ عَمرٍو لِاِمرِءِ القَيسِ تَبتَغي","بِشَتمِيَ إِدراكَ العُلى وَالمَكارِمِ",22,"م",1,0],["أَحادِرَةٌ دُموعَكِ دارُ مَيٍّ","وَهائِجَةٌ صَبابَتَكَ الرُسومُ",23,"م",1,1],["أَحالَ عَلَيها وَهوَ عارِضُ رَأسِهِ","يَدُقُّ السِلامَ سَحَّهُ وَاِنسِحالُها",24,"ل",3,0],["أحاديثُ عنه في السماح غريبةٌ","يُروّي عواليها عطاءٌ وواصلُ",25,"ل",1,0],["أحافد عبد التين يملأُ بطنَه","من التين والمسوا لهم في غيرِ",26,"ر",1,1],["أحاط به فكان له رقيباً","ومغناه الأنيق له حبيب",27,"ب",1,0],["أحاطت به من كل صَوب حدائق","كوجهك حسناً في العيون الروامق",28,"ق",1,0],["أحاطت بها الأرزاء من كل جانب","إلى أن محتها معهداً بعد معهد",29,"د",1,0],["أَحاديثُ رُكبانِ المَحَجَّةِ كُلَّما","تَأَوَّهنَ خوصاً دامِياتِ المَناسِمِ",30,"م",1,0],["أَحارِثُ خُذ مَن شِئتَ مِنّا وَمِنهُمُ","وَدَعنا نَقِس مَجداً تُعَدُّ فَواضِلُه",31,"ل",2,0],["أُحاوِلُ كِتمانَ الَّذي بي مِنَ الأَسى","وَتَأبى غُروبٌ ثَرَّةٌ وَشُؤونُ",32,"ن",1,0],["أُحارِثُ مَن صافِحٌ غافِرٌ","لَهُنَّ إِذا أَنتَ لَم تَغفِرِ",33,"ر",1,0],["أَحارِثُ إِن لَم تُصدِرِ الرَمحَ قانِياً","وَلَم تَدفَعِ الجُلى فَلَستَ بِحارِثِ",34,"ث",1,0],["أُحاوِلُ الصَبرَ عَلى هَجرِهِ","وَالصَبرُ مَحظورٌ عَلى الصَبِّ",35,"ب",1,0],["أَحاطَ بِحِصنِهِم مِنّا صُفوفٌ","لَهُ مِن حَرِّ وَقعَتِها صَليلُ",36,"ل",1,0],["أَحاديثُ لِحيانٌ صَلوا بِقَبيحِها","وَلِحيانُ جَرّامونَ شَرَّ الجَرائِمِ",37,"م",1,0],["أحاولُ صبراً عن هوًى قد ألفته","ولا أجدُ الصبرَ المحاولَ يعذُب",38,"ب",1,1],["أحاشيك أن تقضى حشاشة مدنفٍ","ولم تقضَ من عود التواصل حاجِها",39,"ج",3,0],["أحاشيكَ يا نجلَ الوزارة من أذًى","تمكَّن من أسرارنا والجوانح",40,"ح",1,1],["أحاشيكَ عن تعريض سقم وأرتجي","عوائد عيش للهناء منيح",41,"ح",1,0],["أحاشيكَ أن يدجو زمانيَ بعدما","أضاءت بشعرى في المدائحِ من شعري",42,"ر",2,0],["أحاكي حبابَ البابليّ وتغرَه","بدمعيَ واللفظ الجماليّ والدرا",43,"ر",2,0],["أحاشيك من ضرٍّ ألمَّ وإنما","بطلعتك الغرَّاء يستدفع الضرّ",44,"ر",1,0],["أحاطَ به جيشُ السطور وإنما","أدارَ به الأمر الذي كانَ أحوطا",45,"ط",2,0],["أحاجيك ما حلو اللسان وأنه","لأخرسُ لا تعزَى إليه المعارف",46,"ف",1,1],["أحاشيكَ تَنْسى وصول المحال","فيغدو محلاًّ على الصيغتين",47,"ن",1,0],["أحالَ المُنجِبون عليك أمري","فلم يَقْبل حَوَالتهم نجيبُ",48,"ب",1,0],["أحاله اللَّهُ على نحرهِ","وحدِّ سيفٍ صارمِ المَضْربِ",49,"ب",1,0],["أحاط علماً بكل خافيةٍ","كأنما الأرض في يديه كُرَهْ",50,"ر",2,0],["أُحاشي التي تنمي إليها وأنتحي","بها أمَّك الأخرى التي سوف تظهر",51,"ر",1,0],["أحاط به شرّان والفقرُ ثالثٌ","وفي واحدٍ ما شفَّ قلباً وأرمضا",52,"ض",2,0],["أَحاطَ بحرمتي ما كان منِّي","وعفوك واسعٌ بهما مُحيطُ",53,"ط",1,1],["أحاديث هن كمثل الضري","ع آكله أبداً جائع",54,"ع",1,0],["أحاذر أن يرمينيَ الدهر دونها","بحتف وحاشاك الحتوف الصوارع",55,"ع",1,0],["أحاذر موتاً فاجعاً أو شُيَيبَةً","أُفاتُ بها أو ألفة تتفرق",56,"ق",1,0],["أحاذِرُ أن تكون سليلَ شتَّى","وأحذَرُ مثلَ ذاك على بنيكا",57,"ك",2,0],["أحاملتي أصبحتِ حِملاً لحُفْرة","إذا حَمَلَتْ يوماً فليس لها قَتَمْ",58,"م",1,0],["أحاملتي أسْتَحْمِلُ الله رَوْحةً","إلى تلكمُ الروح الزكية والنَّسمْ",58,"م",1,0],["أحاطت بكُمْ حُجَّتِي دُرَّراً","ومن ذا يُبِينُ إذا لم أُبِن",59,"ن",1,0],["أُحاذِرُ يَوماً أَن تَبينَ قَرينَتي","وَيُسلِمَها جيرانُها وَنَصيرُها",60,"ر",3,0],["أَحاديثُ سَدّاها اِبنُ حَدراءَ فَرقَدٌ","وَرَمّازَةٌ مالَت لِمَن يَستَميلُها",61,"ل",3,0],["أَحاديثَ تَبقى وَالفَتى غَيرُ خالِدٍ","إِذا هُوَ أَمسى هامَةً فَوقَ صُيَّرِ",62,"ر",1,0],["أَحاديثُ أَحلى في النُفوسِ مِنَ المُنى","وَأَلطَفُ مِن مَرِّ النَسيمِ إِذا سَرى",63,"ر",2,0],["أَحارِ بنَ عَبدٍ لِلدُموعِ البَوادِرِ","وَلِلجَدِّ أَمسى عَظمُهُ في الجَبائِرِ",64,"ر",1,1],["أَحارِثُ إِن شوركتُ فيكَ فَطالَما","نِعمنا وَما بَيني وَبَينَك ثالِثُ",65,"ث",1,0],["أحاطت بليل اليأس مني غياهب","تضيء من الآمال فيها كواكبُ",66,"ب",1,1],["أحاديثكم ملء سمع الزمان","إذا ما حديث الكرام أنتقل",67,"ل",1,0],["أَحاطَ بِالمَغرب مِن أَطرافِهِ","وَدانَ مِنهُ ما دَنا وَما قَصا",68,"ا",1,0],["أُحادٌ أَم سُداسٌ في أُحادِ","لُيَيلَتُنا المَنوطَةُ بِالتَنادِ",69,"د",1,1],["أُحاذِرُ أَن يَشُقَّ عَلى المَطايا","فَلا تَمشي بِنا إِلّا سِواكا",70,"ك",2,0],["إِحاطَةً بِالصَوابِ تُؤمِنُ مِن","لَجاجِهِ في المِحالِ أَو شَغَبِه",71,"ب",2,0],["أَحاديثُ شَكوى مِن مُحِبّينَ لا تَني","تُعِلُّ فُؤاداً بِالصَبابَةِ أَو تُبري",72,"ر",2,0],["أُحاجيكَ هَل لِلحُبِّ كَالدارِ تَجمَعُ","وَلِلحائِمِ الظَمآنِ كَالماءِ يَنقَعُ",73,"ع",1,1],["أَحاطَت بِآفاقِ المَعالي وَأَشرَفَت","بِها نَخوَةٌ مِن أَن يُحيطَ بِها وَصفُ",74,"ف",1,0],["أُحاذِرُ البَينَ مِنَ أَجلِ النَوى","طَوراً وَأَهواهُ مِنَ أَجلِ العِناق",75,"ق",1,0],["أُحارِبُ قَوماً لا أُسَرُّ بِسوئِهِم","وَلَكِنَّني أَرمي مِنَ الناسِ مَن تَرمي",76,"م",2,0],["أُحاذِرُ بَوّابَينِ قَد وُكِّلا بِها","وَأَسمَرَ مِن ساجٍ تَإِطُّ مَسامِرُه",77,"ر",2,0],["أَحارِ أَبَت كَفّاكَ إِلّا تَدَفُّقاً","إِذا ما سَماءُ الرِزقِ خَفَّ سِجالُها",78,"ل",3,1],["أَحارِثُ داري مَرَّتَينِ هَدَمتَها","وَكُنتَ اِبنُ أُختٍ لا تُخافُ غَوائِلُه",79,"ل",2,0],["أُحاذِرُ أَن أُدعى وَحَوضي مُحَلِّقٌ","إِذا 