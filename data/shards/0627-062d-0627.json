ل مفحم","https://www.aldiwan.net/poem3532.html","عموديه"],[464,"درت أنها شمس الضحى فتجلت","https://www.aldiwan.net/poem3592.html","عموديه"],[464,"غصون الحمى شف المعنى قدودها","https://www.aldiwan.net/poem3618.html","عموديه"],[477,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[482,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[493,"من منصفي من محكم الكتاب","https://www.aldiwan.net/poem67302.html","الرجز"],[495,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[495,"أحاجيك أناجيك","https://www.aldiwan.net/poem9862.html","الهزج"],[495,"أحاجيكم وليس لكم","https://www.aldiwan.net/poem10267.html","مجزوء الوافر"],[504,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"],[514,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[515,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[529,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[540,"أحار بن فهر كيف تطرحونني","https://www.aldiwan.net/poem56813.html","الطويل"],[553,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[558,"بنى الكل ثم لهم قد هدم","https://www.aldiwan.net/poem33866.html","المتقارب"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"هما إحاطتان بالأشياء","https://www.aldiwan.net/poem35075.html","الرجز"],[558,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[562,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"],[562,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[562,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[562,"قد طلع البدر من المغرب","https://www.aldiwan.net/poem52981.html","السريع"],[564,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[576,"يعيرني أمي رجال لا أرى","https://www.aldiwan.net/poem1777.html","الطويل"],[585,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[586,"وصالك أنهى مطلبي ومرادي","https://www.aldiwan.net/poem17494.html","الطويل"]],"verses":[["أَحالوا عَلَيها عاكِسينَ رِقابَها","وَطَوا بِهَواديها مَكانَ الفَراسِنِ",0,"ن",1,0],["أَحاسِدَ ذا الضَرغامِ دونَكَ فَاِجتَنِب","بَوادِرَ مِقدامِ الجَنانِ مُحامي",1,"ي",1,0],["أَحاديثُ تَستَدعي الوَقورَ إِلى الصِبا","وَتَكسو حَليمَ القَومِ ثَوبَ عُرامِ",2,"م",1,0],["أُحاجي رِجالاً ما مَلابِسُ سودُ","جَدائِدُ لا يَبقى لَهُنَّ جَديدُ",3,"د",1,1],["أُحاذِرُ الفُقْرَ يَوماً أَنْ يُلِمَّ بها","فَيهْتِكَ السِّتْرَ عن لَحْمٍ على وَضَمِ",4,"م",1,0],["أُحاوِلُ ما يُرضيكِ غَيرَ مُجادِلٍ","عَلى كُلِّ حالٍ مِن مَغيبٍ وَمَشهَدِ",5,"د",1,0],["أَحالَ عَليَّ الدَهرُ مِن كُلِّ جانِبٍ","وَدامَت وَلَم تُقلِع عَلَيَّ الفَجائِعُ",6,"ع",1,0],["أُحامِقُهُ حَتّى تُقالَ سَجِيَّةٌ","وَلَو كانَ ذا عَقلٍ لَكُنتُ أُعاقِلُه",7,"ه",1,0],["أحاطَ بِنا الأعْداءُ منْ كلِّ جانِبٍ","فلا وَزَراً عنْهُمْ وجَدْنا ولا كَهْفا",8,"ف",2,0],["أَحارِ بِنَ بَدرٍ قَد وَليتَ ولايَةً","فَكُن جُرَذاً مِمَّن يَخونُ وَيَسرِقُ",9,"ق",1,1],["أَحامِدُ كَيفَ تَنساني وَبَيني","وَبَينَكَ يا أَخي صِلَةُ الجِوارِ",10,"ر",1,1],["أُحاجي وَقَد أَصبَحتُ عَنها بِمَعزِلٍ","وَلَم تُبقِ لِيَ الأَيّامُ عَقلاً وَلا حِسا",11,"س",2,1],["أُحاوِلُ أَن أَمشي إِلى الغَربِ راجِلاً","وَأَحداثُها بي في فَمِ الشَرقِ تَقذِفُ",12,"ف",1,0],["أُحاذِرُ أَن تَتَظَنّى الوُشاةُ","وَقَد يُستَدامُ الهَوى بِالحَذَر",13,"ر",1,0],["أَحارِ تَرى بَرقاً أُريكَ وَميضَهُ","كَلَمعِ اليَدَينِ في حَبِيٍّ مُكَلَّلِ",14,"ل",1,0],["أَحارِ بنُ عَمروٍ كَأَنّي خَمِر","وَيَعدو عَلى المَرءِ ما يَأتَمِر",15,"ر",1,1],["أَحاطَت يَداهُ بِالخِلافَةِ بَعدَما","أَراد رِجالٌ آخَرونَ اِغتِيالَها",16,"ل",3,0],["أُحاذِرُ أَن تَلقوا رَدىً وَمَطِيَّكُم","خَواضِعُ تَبغيني حِمامَ المَصارِعِ",17,"ع",1,0],["أَحَاطَتْ بِهِ زِينَاتُ دُنْيَاهُ فَانْثَنَى","وَلَمْ تُغْرِهِ زِيناتُها بالمحَارِمِ",18,"م",1,0],["أُحاوِلُ نَقلَ الشَمسِ مِن مُستَقَرِّها","وَإِسماعَ أَحجارٍ مِنَ الصَلِداتِ",19,"ت",1,0],["أَحارِ بنَ عَمرٍو لِاِمرِءِ القَيسِ تَبتَغي","بِشَتمِيَ إِدراكَ العُلى وَالمَكارِمِ",20,"م",1,0],["أَحادِرَةٌ دُموعَكِ دارُ مَيٍّ","وَهائِجَةٌ صَبابَتَكَ الرُسومُ",21,"م",1,1],["أَحالَ عَلَيها وَهوَ عارِضُ رَأسِهِ","يَدُقُّ السِلامَ سَحَّهُ وَاِنسِحالُها",22,"ل",3,0],["أحاديثُ عنه في السماح غريبةٌ","يُروّي عواليها عطاءٌ وواصلُ",23,"ل",1,0],["أحافد عبد التين يملأُ بطنَه","من التين والمسوا لهم في غيرِ",24,"ر",1,1],["أحاط به فكان له رقيباً","ومغناه الأنيق له حبيب",25,"ب",1,0],["أحاطت به من كل صَوب حدائق","كوجهك حسناً في العيون الروامق",26,"ق",1,0],["أحاطت بها الأرزاء من كل جانب","إلى أن محتها معهداً بعد معهد",27,"د",1,0],["أَحاديثُ رُكبانِ المَحَجَّةِ كُلَّما","تَأَوَّهنَ خوصاً دامِياتِ المَناسِمِ",28,"م",1,0],["أَحارِثُ خُذ مَن شِئتَ مِنّا وَمِنهُمُ","وَدَعنا نَقِس مَجداً تُعَدُّ فَواضِلُه",29,"ل",2,0],["أُحاوِلُ كِتمانَ الَّذي بي مِنَ الأَسى","وَتَأبى غُروبٌ ثَرَّةٌ وَشُؤونُ",30,"ن",1,0],["أُحارِثُ مَن صافِحٌ غافِرٌ","لَهُنَّ إِذا أَنتَ لَم تَغفِرِ",31,"ر",1,0],["أَحارِثُ إِن لَم تُصدِرِ الرَمحَ قانِياً","وَلَم تَدفَعِ الجُلى فَلَستَ بِحارِثِ",32,"ث",1,0],["أُحاوِلُ الصَبرَ عَلى هَجرِهِ","وَالصَبرُ مَحظورٌ عَلى الصَبِّ",33,"ب",1,0],["أَحاطَ بِحِصنِهِم مِنّا صُفوفٌ","لَهُ مِن حَرِّ وَقعَتِها صَليلُ",34,"ل",1,0],["أَحاديثُ لِحيانٌ صَلوا بِقَبيحِها","وَلِحيانُ جَرّامونَ شَرَّ الجَرائِمِ",35,"م",1,0],["أحاولُ صبراً عن هوًى قد ألفته","ولا أجدُ الصبرَ المحاولَ يعذُب",36,"ب",1,1],["أحاشيك أن تقضى حشاشة مدنفٍ","ولم تقضَ من عود التواصل حاجِها",37,"ج",3,0],["أحاشيكَ يا نجلَ الوزارة من أذًى","تمكَّن من أسرارنا والجوانح",38,"ح",1,1],["أحاشيكَ عن تعريض سقم وأرتجي","عوائد عيش للهناء منيح",39,"ح",1,0],["أحاشيكَ أن يدجو زمانيَ بعدما","أضاءت بشعرى في المدائحِ من شعري",40,"ر",2,0],["أحاكي حبابَ البابليّ وتغرَه","بدمعيَ واللفظ الجماليّ والدرا",41,"ر",2,0],["أحاشيك من ضرٍّ ألمَّ وإنما","بطلعتك الغرَّاء يستدفع الضرّ",42,"ر",1,0],["أحاطَ به جيشُ السطور وإنما","أدارَ به الأمر الذي كانَ أحوطا",43,"ط",2,0],["أحاجيك ما حلو اللسان وأنه","لأخرسُ لا تعزَى إليه المعارف",44,"ف",1,1],["أحاشيكَ تَنْسى وصول المحال","فيغدو محلاًّ على الصيغتين",45,"ن",1,0],["أحالَ المُنجِبون عليك أمري","فلم يَقْبل حَوَالتهم نجيبُ",46,"ب",1,0],["أحاله اللَّهُ على نحرهِ","وحدِّ سيفٍ صارمِ المَضْربِ",47,"ب",1,0],["أحاط علماً بكل خافيةٍ","كأنما الأرض في يديه كُرَهْ",48,"ر",2,0],["أُحاشي التي تنمي إليها وأنتحي","بها أمَّك الأخرى التي سوف تظهر",49,"ر",1,0],["أحاط به شرّان والفقرُ ثالثٌ","وفي واحدٍ ما شفَّ قلباً وأرمضا",50,"ض",2,0],["أَحاطَ بحرمتي ما كان منِّي","وعفوك واسعٌ بهما مُحيطُ",51,"ط",1,1],["أحاديث هن كمثل الضري","ع آكله أبداً جائع",52,"ع",1,0],["أحاذر أن يرمينيَ الدهر دونها","بحتف وحاشاك الحتوف الصوارع",53,"ع",1,0],["أحاذر موتاً فاجعاً أو شُيَيبَةً","أُفاتُ بها أو ألفة تتفرق",54,"ق",1,0],["أحاذِرُ أن تكون سليلَ شتَّى","وأحذَرُ مثلَ ذاك على بنيكا",55,"ك",2,0],["أحاملتي أصبحتِ حِملاً لحُفْرة","إذا حَمَلَتْ يوماً فليس لها قَتَمْ",56,"م",1,0],["أحاملتي أسْتَحْمِلُ الله رَوْحةً","إلى تلكمُ الروح الزكية والنَّسمْ",56,"م",1,0],["أحاطت بكُمْ حُجَّتِي دُرَّراً","ومن ذا يُبِينُ إذا لم أُبِن",57,"ن",1,0],["أُحاذِرُ يَوماً أَن تَبينَ قَرينَتي","وَيُسلِمَها جيرانُها وَنَصيرُها",58,"ر",3,0],["أَحاديثُ سَدّاها اِبنُ حَدراءَ فَرقَدٌ","وَرَمّازَةٌ مالَت لِمَن يَستَميلُها",59,"ل",3,0],["أَحاديثَ تَبقى وَالفَتى غَيرُ خالِدٍ","إِذا هُوَ أَمسى هامَةً فَوقَ صُيَّرِ",60,"ر",1,0],["أَحاديثُ أَحلى في النُفوسِ مِنَ المُنى","وَأَلطَفُ مِن مَرِّ النَسيمِ إِذا سَرى",61,"ر",2,0],["أَحارِ بنَ عَبدٍ لِلدُموعِ البَوادِرِ","وَلِلجَدِّ أَمسى عَظمُهُ في الجَبائِرِ",62,"ر",1,1],["أَحارِثُ إِن شوركتُ فيكَ فَطالَما","نِعمنا وَما بَيني وَبَينَك ثالِثُ",63,"ث",1,0],["أحاطت بليل اليأس مني غياهب","تضيء من الآمال فيها كواكبُ",64,"ب",1,1],["أحاديثكم ملء سمع الزمان","إذا ما حديث الكرام أنتقل",65,"ل",1,0],["أَحاطَ بِالمَغرب مِن أَطرافِهِ","وَدانَ مِنهُ ما دَنا وَما قَصا",66,"ا",1,0],["أُحادٌ أَم سُداسٌ في أُحادِ","لُيَيلَتُنا المَنوطَةُ بِالتَنادِ",67,"د",1,1],["أُحاذِرُ أَن يَشُقَّ عَلى المَطايا","فَلا تَمشي بِنا إِلّا سِواكا",68,"ك",2,0],["إِحاطَةً بِالصَوابِ تُؤمِنُ مِن","لَجاجِهِ في المِحالِ أَو شَغَبِه",69,"ب",2,0],["أَحاديثُ شَكوى مِن مُحِبّينَ لا تَني","تُعِلُّ فُؤاداً بِالصَبابَةِ أَو تُبري",70,"ي",1,0],["أُحاجيكَ هَل لِلحُبِّ كَالدارِ تَجمَعُ","وَلِلحائِمِ الظَمآنِ كَالماءِ يَنقَعُ",71,"ع",1,1],["أَحاطَت بِآفاقِ المَعالي وَأَشرَفَت","بِها نَخوَةٌ مِن أَن يُحيطَ بِها وَصفُ",72,"ف",1,0],["أُحاذِرُ البَينَ مِنَ أَجلِ النَوى","طَوراً وَأَهواهُ مِنَ أَجلِ العِناق",73,"ق",1,0],["أُحارِبُ قَوماً لا أُسَرُّ بِسوئِهِم","وَلَكِنَّني أَرمي مِنَ الناسِ مَن تَرمي",74,"ي",1,0],["أُحاذِرُ بَوّابَينِ قَد وُكِّلا بِها","وَأَسمَرَ مِن ساجٍ تَإِطُّ مَسامِرُه",75,"ر",2,0],["أَحارِ أَبَت كَفّاكَ إِلّا تَدَفُّقاً","إِذا ما سَماءُ الرِزقِ خَفَّ سِجالُها",76,"ل",3,1],["أَحارِثُ داري مَرَّتَينِ هَدَمتَها","وَكُنتَ اِبنُ أُختٍ لا تُخافُ غَوائِلُه",77,"ل",2,0],["أُحاذِرُ أَن أُدعى وَحَوضي مُحَلِّقٌ","إِذا كانَ يَومُ الوِردِ يَومَ خِصامِ",78,"م",1,0],["أَحاديثَ مِنّا نَشتَكيها إِلَيهِمُ","وَمُظلِمَةً يَغشى الوُجوهَ ظَلامُها",79,"م",3,0],["أحاطَتْ عيونُ العاشقينَ بِخَصْرِه","فهُنَّ له دُونَ النِّطاقِ نِطاقُ",80,"ق",1,0],["أُحاكِمُكُمْ إلى السَّبعِ المَثاني","وتلكَ الشَّمسُ أَغشَتكُمْ طُلوعا",81,"ع",2,0],["أحاديثُ لو يجتازُها نَفَسُ الصَّبا","تأَرَّجَ من أنفاسِها وتعطَّرا",82,"ر",2,0],["أُحابي بِهِ مَيتاً بِنَخلٍ وَأَبتَغي","إِخاءَكَ بِالقَولِ الَّذي أَنا قائِلُ",83,"ل",1,0],["أُحابي بِهِ مَن لَو سُئِلتُ مَكانَهُ","يَميني وَلَو عَزَّت عَلَيَّ أَنامِلُ",83,"ل",1,0],["أَحاطَ الجَديدانِ جَمعاً بِنا","فَلَيسَ لَنا عَنهُما مَهرَبُ",84,"ب",1,0],["أَحاطَ بِهِ الآسونَ يَبغونَ طِبَّهُ","وَقَد حارَتِ الأَفهامُ وَاِشتَغَلَ السِرُّ",85,"ر",1,0],["أحاول أن أنسى وهيهاتَ إنه","لَحُبّ يظَل العمر يزدادُ توثيقَا",86,"ق",2,0],["أحاول سلوةً وأرى الليالي","بغير هواك لي هيهات تُسلي",87,"ل",2,0],["أَحاديثُها دُرٌّ وَدُرٌّ كَلامُها","وَلَم أَرَ دُرّاً قَبلَهُ يَنظِمُ الدُرا",88,"ر",2,0],["أَحاوَلتِ إِرشادي فَعَقلِيَ مُرشِدي","أَمِ اِستَمتِ تَأديبي فَدَهري مُؤَدِّبي",89,"ي",1,0],["أُحَاوِلُ وَصْلاً مِنْ حَبِيبٍ مُمَنَّعٍ","وَبَعْضُ أَمَانِي النَّفْسِ غَيْبٌ مُرَجَّمُ",90,"م",1,0],["أَحَاطَتْ بِهِ لِلنِّيلِ مِنْ كُلِّ جَانِبٍ","جَدَاوِلُ تُسْقِيهِ سُلافَ الْغَمَائِمِ",91,"م",1,0],["أحالها النور شيئاً غيرَ عالمها","حتى كأنَّا بوادٍ غيرِ وادينا",92,"ن",2,0],["أَحاطَ بِهِ البَلاءُ فَكُلَّ يَومٍ","تُقارِعُهُ الصَبابَةُ وَالنَحيبُ",93,"ب",1,0],["أحافظ إن تبعد فشاعر أمة","رمتها خطوب الدهر مغبرة نكدا",94,"د",2,0],["أَحاطَت بِنا الأُسدُ المُغِيرَةُ جَهرَةً","وَدبَّت إِلَينا في الظَلامِ الأَراقمُ",95,"م",1,0],["أحاطَ بِدحيةٍ مِنهم أُناسٌ","تَعُدُّهُم الذّئابُ مِن الرِّفاقِ",96,"ق",1,0],["أُحاذِرُ يا صَمصامَ إِن مِتُّ أَن يَلي","تُراثي وَإِيّاكَ اِمرُؤٌ غَيرُ مُصلِحِ",97,"ح",1,0],["أُحاذِرُ إِن قَدَرتَ عَلَيَّ يَوماً","عِقابَكَ وَالأَليمَ مِنَ العَذابِ",98,"ب",1,0],["أَحاديثُ يَعجَبُ مِنها الفَتى","خَلا أَن يَكونَ لَها رائِدا",99,"د",2,0],["أَحاوَلتِ الرَشادَ بِقَتلِ نَفسٍ","وَأَينَ القَتلُ مِن عَمَلِ الرَشادِ",100,"د",1,0],["أُحاذِرُ بُعدَ الدارِ وَالقُربُ شاعِفٌ","فَلا أَنا مَغبوطٌ بِبُعدٍ وَلا قُربِ",101,"ب",1,0],["أَحاديثَ نَفسٍ تَشتَكي ما يَريبُها","وَوِردَ هُمومٍ لَم يَجِدنَ مَصادِرا",102,"ر",2,0],["أَحاديثَ الضَبابِ وَآلِ كَعبٍ","نَبَذتُ سَوالِكاً دَرَجَ الضَبابِ",103,"ب",1,0],["أُحاذِرُ السَيلَ وَمَن لي بِمُن","جاةٍ إِذا أَسمَعَني رَعدَه",104,"د",2,0],["أَحاديثُ عَن قَيلِ بنِ عِترٍ وَرَهطِهِ","رُوَيدَكَ ما قَيلٌ وَوالِدُهُ عِترُ",105,"ر",1,0],["أُحاوِلُ مِن بَني الدُنِّيا صَلاحاً","وَتَأبى أَن تُجيبَ نُفوسُ غُثرِ",106,"ر",1,0],["أُحاذِرُ في الزَمانِ الرَغدِ جَدباً","وَآمُلُ في الجُدوبِ زَمانَ طَثرِ",106,"ر",1,0],["أَحاضِنَةَ الغُلامِ ذَمَمتِ مِنهُ","أَذاكِ فَأَرضِعي حَنَشاً وَضُمّي",107,"ي",1,0],["أُحاذِرُ أَن تَجعَلوا مَضجَعي","إِلى كافِرٍ خانَ أَو مُسلِمِ",108,"م",1,0],["أُحاذِرُ عالَمي وَأَخافُ مِنّي","وَأَلحى الناسَ بَلَهَ بَني لُحَيِّ",109,"ح",2,0],["أحاطت جنودُ الأرض بابن سَوادةً","وعاجلَهُ الحتْفُ المُتاحُ أشائِمُه",110,"ه",1,1],["أحالَت عَلى كأس هناك معدة","من السم واِهتشَّت لها تتجرع",111,"ع",1,0],["أحادٌ أم سداسٌ في أحاج؟","لييلتنا المنوطة بالتناد",112,"د",1,1],["أحال ضياءَ الصبح حوليَ ظُلمةً","بها الحزنُ 