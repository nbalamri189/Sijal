{"poems":[[79,"كأني قرص الشمس عند طلوعها","https://www.aldiwan.net/poem36502.html","الطويل"],[9,"ألا من مبلغ عني حريثا","https://www.aldiwan.net/poem21987.html","الوافر"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[47,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[47,"ترون بلوغ المجد أن ثيابكم","https://www.aldiwan.net/poem64620.html","الطويل"],[30,"أما قريش أبا حفص فقد رزئت","https://www.aldiwan.net/poem5101.html","البسيط"],[30,"وإذا نظرت رأيت فوقك دارما","https://www.aldiwan.net/poem5253.html","الكامل"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[107,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[79,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[79,"كأني قرص الشمس عند طلوعها","https://www.poetsgate.com/ViewPoem.aspx?id=34121",""],[139,"لي في الصبابة أخبار وأحوال","https://www.aldiwan.net/poem49113.html","البسيط"],[146,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[159,"وليل كفكري في صدود معذبي","https://www.aldiwan.net/poem55717.html","الطويل"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[228,"نحن عدن وهم مكان مريب","https://www.aldiwan.net/poem39718.html","الخفيف"],[266,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[280,"إلى وعدها أصبو وهل ينجز الوعد","https://www.aldiwan.net/poem25588.html","الطويل"],[308,"وقفت على ما سطرته الأنامل","https://www.aldiwan.net/poem57655.html","الطويل"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[463,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[473,"رأيتك بصاص الثياب مزوقا","https://www.aldiwan.net/poem60030.html","الطويل"],[534,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64120","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77548","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96633","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80204","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61090","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21664","البسيط"],[1564,"","https://poetry.dctabudhabi.ae/diwan/poem/84968","الطويل"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130696","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52083","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46465","المتقارب"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33885","الوافر"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2581,"","https://poetry.dctabudhabi.ae/diwan/poem/141564","الوافر"],[561,"","https://poetry.dctabudhabi.ae/diwan/poem/145196","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205850","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204985","الوافر"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46920","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62937","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92426","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85274","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135566","الرجز"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22082","الخفيف"],[4755,"أَين القيامة؟!","https://www.poetsgate.com/ViewPoem.aspx?id=199960",""],[4767,"بحور القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179966",""],[4771,"وَليْلٍ تَجلَّى الصُّبح في جَنباتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=106542",""],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[5213,"أيروي الهازم الفتك","https://www.poetsgate.com/ViewPoem.aspx?id=170510",""],[5401,"يااااا تركي","https://www.poetsgate.com/ViewPoem.aspx?id=85474",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5582,"تَهْنا أَبَيْتَ اللَّعْنَ بِالمَوْلُودِ","https://www.poetsgate.com/ViewPoem.aspx?id=63486",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[5956,"تَوَحُّش","https://www.poetsgate.com/ViewPoem.aspx?id=184983",""],[6056,"السلامه من الله","https://www.poetsgate.com/ViewPoem.aspx?id=156702",""]],"verses":[["وإلا كَما هبّتْ بمُحْتَدِمِ الوَغى","صَبا النّصْرِ لكِنْ منْ بُنودِ بَني نصْرِ",0,"ر",1,0],["وَإِلّا كُلَّ أَسمَرَ وَهوَ صَدقٌ","كَأَنَّ الليطَ أَنبَتَ خَيزُرانا",1,"ن",2,0],["وَإِلّا كُلَّ ذي شُطَبٍ صَقيلٍ","يَقُدُّ إِذا عَلا العُنُقُ الجِرانا",1,"ن",2,0],["وَالأَكرَمينَ مُرَكَّباً إِذ رُكِّبوا","وَالأَطيَبينَ مِنَ التُرابِ صَعيدا",2,"د",2,0],["وَإِلّا كَمِيٌّ ذو حِفاظٍ كَأَنَّهُ","بِما اِبتَلَّ مِن حَدِّ الظُباتِ خَصيبُ",3,"ب",1,0],["وَالأَكرَمونَ وَإِن نَأَت أَسبابُهُم","فَهُمُ ذَوُو وُدّي وَأَهلُ مَناسِبي",4,"ب",2,0],["وَإِلّا كَما اِستَنَّ الثَوابيُّ إِذ جَرَت","عَلى عادَةٍ أَثوابُهُ وَخُروصُها",5,"ص",3,0],["وَالأَكرَمَينِ إِذا عُدَّت فُروعُهُما","وَالأَنعَشَينِ إِذا مَولاهُما عَثَرا",6,"ر",2,0],["وَالأَكرَمونَ إِذا يُعَدُّ قَديمُهُم","وَالأَكثَرونَ إِذا يُعَدُّ كِثارُ",7,"ر",1,0],["والاكَ في مصرَ التي لم يَنْتَصِرْ","لِسوَى قضِيَّتِها ولم يتشيّعِ",8,"ع",1,0],["والأكرمُ الأتقى تبارك ربُّنا","إنّا نطيعُ كتابه المرقوما",9,"م",2,0],["وإلا كما لذ الأمان لخائف","وواصل من بعد القطيعة هاجر",10,"ر",1,0],["وإلا كما هبت بمحتدم الوغى","صبا النصر لكن من جنود بني نصر",11,"ر",1,0],["والأكثرون من العشاقِ مذهبهم","أن الطوالعُ للسلوانِ آجالِ",12,"ل",1,0],["والأكرمون حَكَوه في أفعاله","فعُزُوا إلى كرمٍ مزوَّرِ",13,"ر",1,0],["وإِلا كَعُمْرِ الهَجْرِ مِنْهُ فَإِنَّهُ","إِذا قِسْتَهُ بِالوَصْفِ كانَ بِلا حَدِّ",14,"د",1,0],["وإلا كروحِ جبانٍ أصاب","حِجابا من الموتِ عندَ انهزام",15,"م",1,0],["وَالأَكاليلُ سَوفَ تَذوي وَتَبلى","وَيَشيبُ الغارُ الَّذي لا يَشيبُ",16,"ب",1,0],["والأكرم ابن الأكرمين أرومة","بسقت أفانينا وطابت مغرسا",17,"س",2,0],["وَإِلا كَما أبدَتْ بناناً مطرَّفاً","مِن السُندسِ المَوْشيِّ خَمصانَة رُؤْدُ",18,"د",1,0],["وإلا كأن الصبح ضاع من الدجا","وقد قيدته للظلام سلاسلُ",19,"ل",1,0],["والأكفُّ الأفواقُ والجدُلُ أو","تارُ منها والسّيرُ مثْلُ الرِماء",20,"ا",2,0],["وإلا كما كنت ابنَ عمٍّ ووالياً","وصهراً وصِنواً كان من لم يقارفِ",21,"ف",1,0],["والأكمُ ترفلُ منهُ في خلع الحيا","الأفوافِ بين معصفر ومصندل",22,"ل",1,0],["وَإِلّا كَظامٍ طافَ رائِدُ لَحظِهِ","إِلى أَن رَأى آلاً فَقَدَّرَهُ بَحرا",23,"ر",2,0],["وإلا كان من يَعصي بذنبٍ","كفوراً إنَّ ذا قول شرودُ",24,"د",1,0],["وإِلا كحمَّرةٍ رفرفتْ","فلا هيَ تنأى ولا تقرب",25,"ب",1,0],["وَإِلّا كَعُنقودٍ مِنَ الدّرِّ حَبُّهُ","لَها الشّجر الدُّرِّيُّ يَحمِلُها قِطفا",26,"ف",2,0],["وَالأَكل قَبل الناس ذي شَراهه","يوجب فيك البُغض وَالكَراهَه",27,"ه",1,0],["وإلا كأحبار بسفح كنيسة","تعبر عن توراتها وتفهم",28,"م",1,0],["وإلا كوعاظ ترقوا منابرا","وباحوا بأسرار المعاني وفهّموا",28,"م",3,0],["وإلا كسمار على سور قلعة","ترجع ألحانا بها تترنم",28,"م",1,0],["وإلا كرشح وهو بحر معجج","وإلا كظل وهو غيث مدوم",28,"م",1,0],["وَالأكمُ ينطقُ جهرةً بدعائها","للّه بِالتهليل والتحميدِ",29,"د",1,0],["والاكَ وَاليكَ بِالإِصلاح مُجتَهِداً","فَوالِهِ بِمَزيدِ الحُبِّ وَالشَغَفِ",30,"ف",1,0],["وَإِلا كَما اِنشَقَّ الصَباح عَن الدُّجى","أَو اِبتَسَمَت لَمياءُ عَن وَضح الفَجر",31,"ر",1,0],["وَالأَكْرَمِينَ أَوَّلاً وَآخِرا","إِذْ حَسَبُوا الآباءَ وَالضَرائِرا",32,"ر",2,0],["وَالأَكرَمونَ نِصاباً في أَرومَتِهِم","وَالأَثقَلونَ عَلى الأَعداءِ أَركانا",33,"ن",2,0],["وإلا كأغنام مضين بقفرة","وأصبح مولاها عن السعي نائما",34,"م",2,0],["وإلاَّ كما جاءَ المُرادُ لِغالبِ","وإلا كَسيفِ الجِدّ في مَنهَجِ الهَزلِ",35,"ل",1,0],["وإلاَّ كما باتَت وُجُوه بَشَائِرٍ","تُخَلِّصُ غَرقَى في بِحارٍ مِنَ الوصلِ",35,"ل",1,0],["وإلاَّ كَصُبحِ الوَصلِ أشرقَ نُورُهُ","فأذهبَ ليلاً قد تَبَدَّى مِنَ العَذلِ",35,"ل",1,0],["وَإلا كما وَافَيتَ من بعدِ سارِح","على بارِحٍ في مطلبٍ يَتَيمَّمُ",36,"م",1,0],["وَإلاَّ كَمَا هَبَّ النَّسِيمُ عَشِيةً","على ناعِمٍ غضّ النَّبات من الوَردِ",37,"د",1,0],["وَالا كآسٍ بِهِ مَحَلةٌ","قَد أَعياهُ مُؤلم أَعضالها",38,"ل",3,0],["وَإِلّا كُلُّ أَشقَرَ أَكثَمِيّ","قَليلِ نَباتِ شَعرِ العارِضَينِ",39,"ن",1,0],["والأكل والشراب باليسار","يكره إلا عند الاضطرار",40,"ر",1,0],["والأكل مشياً ومعارض نقل","على البيان للجواز قد حمل",40,"ل",1,0],["والأكل مما لا يليك اجتنب","فيما عدا الثمار مثل الرطب",40,"ب",1,0],["والأكل للكرفس ممدوح بنص","ينفي الجذام والجنون والبرص",40,"ص",1,0],["والأكل للخس مصف للدم","ويذهب الجذام أكل الشلجم",40,"م",1,0],["والأكل من سواقط الخوان","يغدو مهور الخرد الخسان",40,"ن",1,0],["وإلا كان حسن الصبر أحرى","بحسن مثوبةٍ وبناء مجد",41,"د",1,0],["وإلا كقلب بين جنبي محمد","سليل ابن عيسى حين فر ولم يلو",42,"و",1,0],["والأكاليل ناديات على قب","رك في كل ضحوة ومساء",43,"ا",2,0],["والا كنت دوما في احتفال","يهيء لي صنوف المرهقات",44,"ت",1,0],["والاكتحال ثلاثاً جاء في ادب","بأثمد فاكتحل باليمنى ان تنم",45,"م",1,0],["وَإلا كَيْفَ كَفَّ عَنِ اهْتِضَامِي","وَإلا كَيْفَ عَفَّ عَنِ امْتِهانِي",46,"ن",2,0],["والا كيمٌ لا أُصارفُ ذكرَه","وان كانَ فيه دِقَّةٌ وخُمُولُ",47,"ل",1,0],["وَالأكثَرُ اللهُمَّ بِالتَّعوِيضِ","وَشَذَّ يَا اللهُمَّ فِى قَرِيضِ",48,"ض",1,0],["وإلا كالدراهم من لُجينٍ","على فيروزجٍ نَثرَ الحَبيبُ",49,"ب",1,0],["وإلا كان قتلهم يسيراً","بحول القادر الرب العظيم",50,"م",1,0],["والأكثر التسكين بعد الواوِ","والفاء والتحريك جا يا راوي",51,"ي",1,0],["والأَكُفِّ المُضَمَّراتِ عَلى الرُك","نِ بِشُعثٍ سَعَوا إِلى البَيتِ رَجلى",52,"ل",2,0],["والآكلونَ الصَّمتَ والأَشجارَ، ذُلًّا، واستِقامَة","ودُخولُ جُمهوريةِ التحريرِ في جُحرِ الإمامة",53,"م",2,0],["والأكف التي لَها الأمر فيما","يُخمدُ النارَ أبدتِ الانشغالا",54,"ل",2,0],["وإلاّ كغِزلان النَّصارىَ تَدرَّعوا","بسُود مُسُوحٍ للصَّلاةِ ترهُّبا",55,"ب",2,0],["والأكلُ، على جوعٍ، شوْكٌ!","والعذبُ، على ظمأ، مُرُّ!",56,"ر",1,0],["وإلا كيف يتركها","كوحش لفه الشرك",57,"ك",1,0],["والاّ كهانة سحر وشويّة دجل","حتى تساوى رقم واحد وإْعشره",58,"ر",2,0],["والآكليها إن هم غرثوا ولم","يجدوا سواها قصعةً وثريدا",59,"ا",1,0],["وَالأُكْمُ تَنْطِقُ جَهْرَةً بِدُعائِها","للهِ بِالتَّهْلِيلِ وَالتَّحْمِيدِ",60,"د",1,0],["وإلا كمن يبغي حماةً ودونها","حماةُ وغى تسطو ببيض شفار",61,"ر",1,0],["والأكثرُ من ذا كان الماءْ","والوردة كانت خيرَ غذاءْ",62,"ا",2,0],["وإلا كل الخلايق موتهم في النحور","والسلامه من الله ، والشفاء في يده",63,"د",2,0]]}