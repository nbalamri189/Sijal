5419,"بركاتك يا سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=52032",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5790,"ولما جفاني من أحب وخانني","https://www.poetsgate.com/ViewPoem.aspx?id=112072",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[6102,"أَحَقُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182816",""],[6152,"حبك عالمي الأروع","https://www.poetsgate.com/ViewPoem.aspx?id=204685",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""]],"verses":[["وَلَم أَجهَدِ السَيفَ الطَويلَ نِجادُهُ","أَمامَ الظُبى وَالنَقعُ بِالنَقعِ يَرتَمي",0,"م",2,0],["وَلَمّا جَدَّ جَدُّ البَينِ فينا","وَهَبتُ لَهُ الظَعائِنَ وَالقِبابا",1,"ب",2,0],["وَلَمّا جَرَّبَ البيضَ المَواضي","رَآكَ مِنَ الظُبى أَمضى ذُبابا",1,"ب",2,0],["وَلَمّا جَذَبتَ زِمامَ الزَمانِ","أَطاعَ وَلَكِن عَصاكَ الحَبيبُ",2,"ب",1,0],["وَلَمّا جَزَعنا الرَّملَ قال لَنا السُّرى","أَلا رَفِّهوا عَن ساهِماتٍ طَلائِحِ",3,"ح",1,0],["وَلمَّا جَرَّتِ الظَّلْماءُ ذَيْلاً","يُوارِي مَسْلَكَ الأَسَلِ النِّهالِ",4,"ل",1,0],["ولمْ أجْنِ ذَنْباً سِوى أنّني","صدَعْتُ بأمْداحِها في المَلا",5,"ل",2,0],["وَلَم أَجحَد عَوارِفَهُ وَلَكِن","رَأَيتُ المَنَّ داعِيَةَ الجُحودِ",6,"د",1,0],["وَلَم أَجنِ الذُنوبَ فَتَحقِديها","وَلَكِن عادَةٌ مِنكِ التَجَنّي",7,"ن",2,0],["ولم أجد العيدان أقذاء أعين","ولكنما اقذاؤها ما ينوبها",8,"ب",3,0],["ولم أجهل الغيث الذي نشأت به","ولم أتضرع أن يجيء غُضُوبُها",8,"ب",3,0],["ولما جلا الملك المؤيد رأيه","جلا ظله الممدود وهج الممالك",9,"ك",1,0],["ولما جنى طرفي رياض جمالكم","جعلتم سهادي في عقوبة من جنى",10,"ن",2,0],["وَلَم أُجلَد يا رَبِّ","إِذا قيلَ هُوَ الزاني",11,"ن",2,0],["ولما جاء بغداد","رأيتَ الناس أنباذا",12,"ذ",2,0],["ولم أجد ذلك المعنى وعيشكما","إلا البكاء إذا ما فاجع طرقا",13,"ق",2,0],["ولم أجهلْ هنالكَ جور حُكمي","ولكنّي عرفتُ هناكَ نُبلك",14,"ك",1,0],["ولمَا جعلْتُك إذ أطلتُ كموردٍ","قَذَفٍ أُمِرَّ رشاؤُه فأطيلا",15,"ل",2,0],["ولما جلوتُ صفاح قلبِك واعظاً","أنِّي رأيتُ عليه ريناً رائنا",16,"ن",2,0],["وَلَم أَجِد بَينَ مَوتي","وَبَينَ هَجرِكَ فَرقا",17,"ق",2,0],["وَلَم أَجِد عُدَّةَ الخَلائِقِ إِل","لا الدينَ لَمّا اِعتَبَرتُ وَالحَسَبا",18,"ب",2,0],["وَلَم أَجِد قَبلَهُ قَصيرَ يَدٍ","فازَ بِمالِ الأَهوازِ يَحتَجِنُه",19,"ن",2,0],["وَلَمّا جَرى لِلمَجدِ وَالقَومُ خَلفَهُ","تَغَوَّلَ أَقصى جُهدِهِم وَهوَ وادِعُ",20,"ع",1,0],["وَلَمّا جَرى بي غالِبٌ وَجَرى بِهِ","عَطِيَّةُ لَم يَسطَع وُثوبَ الجَراثِمِ",21,"م",1,0],["وَلَمّا جَرَينا لَم نَجِد جالِياً لَهُ","وَلا جالِسَن عِندَ المَدى مِثلَ دارِمِ",21,"م",1,0],["ولم أجهَلْ نصيحتَه ولكنْ","جنونُ الحُبِّ أحلى في جِناني",22,"ن",2,0],["ولم أَجحَدْ صنائعَ مِنْكَ جلَّتْ","ولم أسلُبْكَ مدحاً فيك سارا",23,"ر",2,0],["ولمّا جرى الحُذَّاقُ في ضوءِ صُبْحِه","تَعَّثْرتَ منه في ضَبابِةِ غَيهَبِ",24,"ب",1,0],["وَلَمّا جَلَوتُ المَدحَ وَاِرتَحتُ لِلنَدى","وَرُحنا وَكُلٌّ في الطِلابِ مُجيدُ",25,"د",1,0],["ولما جرى الدرّ الرطيب بِخَدّها","وسال إلى الدر النظيم توقّفا",26,"ف",2,0],["ولم أجدْ في الرَّسمِ أخلاَقها","جرَّبتُها حيناً وجرّبتُه",27,"ت",2,0],["وَلَمّا جَرى في القَومِ بَيَّنتُ أَنَّها","أَجارِيُّ طِرفٍ في رِباطِ نَزيعِ",28,"ع",1,0],["وَلَم أَجِد إِذا ماتوا","لي في الحَياةِ عُذرا",29,"ر",2,0],["وَلَمّا جَنَيناها قِطافاً رَويَّةً","تَذوبُ إِذا مَسَّت عَناقيدَها اليَدُ",30,"د",1,0],["ولم أجدِ الإنسانَ إلاّ ابنَ سعيهِ","فمن كان أسعى كان بالمجد أجدرا",31,"ر",2,0],["وَلَمّا جَلاها الشَمعُ سَبَّحَ ناظِرٌ","وَكَبَّرَ رَفّافٌ وَساروا فَأَرهَجوا",32,"ج",3,0],["ولم أَجِد ركناً غني","ياً بالحنان طيِّبا",33,"ب",2,0],["ولَم أَجِدِ الفَتَى يَلهُو بَشيءٍ","ولَو أَثرَى ولَو وَلَدَ البَنيا",34,"ن",3,0],["ولما جرت في البحرِ تخطِرُ سُفْنُهم","من آخرِ الهادي إلى البلطيك",35,"ك",1,0],["ولم أجد عندي جزاء له","سواي فأملكني بلا فلس",36,"س",1,0],["ولمَّا جرى في لقوم بيَّنت أنّها","أجَارِيُّ طِرْفٍ في رِبَاطِ نَزِيْعِ",37,"ع",1,0],["ولما جشمني أثقاله","ولما فارق ظهر الجمل",38,"ل",1,0],["ولم اجدْ كمَجالِ الصَبرِ من وَطَنٍ","يَرتادُه الجُبْنُ مصطافاً ومُرتْبَعَا",39,"ع",2,0],["ولم أجدْ ما يُنَسَّيني مَضاضتَها","إلا عواطفَ خُلاّنٍ وخُلْصان",40,"ن",1,0],["وَلمّا جَرَيْنَا لمْ نَجِدْ جالِياً لَهُ،","ولا جالِساً عَندَ المَدَى مثلَ دارِمِ",41,"م",1,0],["ولما جد جدهم استقلوا","على ظهر القطار مسافرينا",42,"ا",1,0],["ولما جَفانِي واستطَالَ بِهَجْرِه","رجعتُ إلى م في الزمانِ خليلُ",43,"ل",1,0],["ولم أجد لي مشتكى في الإنس","غير أبي بشر الطبيب القس",44,"س",1,0],["وَلَم أَجتَمِع واللَّه منهم بواحدٍ","وَذاكرتهُ إلّا وَددتُ لهُ القَبرا",45,"ر",2,0],["ولم أجنِ ذنباً غيرَ أني ذو هوىً","وأنكَ لي دونَ الأنامِ محببُ",46,"ب",1,0],["ولم أجد لي سبيلا في مدافعة","وبي تقطعت الاسباب والسبل",47,"ل",1,0],["ولم اجد لي في الورى مخلصا","منه سوى رب السجايا الحسان",48,"ن",1,0],["ولم اجد منتقطا لي وان","لقطت لم اسلم من الحائل",49,"ل",1,0],["وَلَمْ أَجِدْ مِنْ أَحَدٍ بِي يَعْتَنِي","سِوَاكَ يَا رَبِّ فَكُنْ لِي أَغْتَنِي",50,"ي",1,0],["ولما جَرَرتِ الذَّيلَ أخضرَ ضافياً","سمعتُ حفيفَ المورقِ المتميِّل",51,"ل",1,0],["ولم أجنِ إلا الندامةَ مما","غَرَستُ وهذا نصيبُ الكرام",52,"م",1,0],["ولم أجِدْ لِلْحَياةِ عُدْماً","وفي وجودِ الرّضى وجودِي",53,"د",2,0],["وَلَمْ أَجِدِ الْكَبِيرَ الرُّزْءِ إِلاّ","سَلِيلَ عُلاً فُجِعْتَ بِهِ صَغِيراً",54,"ر",2,0],["وَلَمْ أَجْعَلْكَ دُونَ الْخَلْقِ قَصْدِي","لِتَجْعَلَ لِي إِلى الْخَلْقِ احتِياجا",55,"ج",2,0],["ولم أجده مشترى فأشري","فجد حباك الله طول عمر",56,"ر",1,0],["وَلَمّا جَلَسنا لِلشَرابِ وَمُنيَتي","يَمُرُّ عَلَينا بِالطِلا وَيدورُ",57,"ر",1,1],["وَلَم أَجِد مِن هَواهُ بَدا","وَالوَجدُ مازالَ في اِزدِيادِ",58,"د",1,0],["وَلَمْ أَجِدْ خَشَباً يَدْنُو السِّراجُ لهُ","قَبلي وَكَمْ أَتَتِ الأَشْياءُ بالعَجَب",59,"ب",1,0],["وَلَم أَجِد بِالرُقادِ فَقدي","مِنّي وَذو يَقظَةِ يَراني",60,"ن",2,0],["وَلَمّا جَلا البِشرُ مِن وَجهِهِ","لَنا القَمَرَ المُصبِحَ الزاهِرا",61,"ر",2,0],["ولَم أجنِ ذَنباً غير أنِّي بحُبِّكُمْ","خَضَعْتُ لكُمْ صُغْراً كَما خضَعَ الجاني",62,"ي",1,0],["ولما جاء من غيري قصيد","وما وافى لكم مني قصيد",63,"د",1,0],["ولم أجد سبباً يخني الزمان به","على ذوي الفضل إلا حرفة الأدب",64,"ب",1,0],["ولَمَا جَزَرْتَ لَهَا وليمةَ مُعْرِسٍ","إِلّا الضَّراغِمَ عادِياً وهَصُورا",65,"ر",2,0],["ولم أجد نابغا أولى بتكرمتي","ولا مثالية أولى بإيماني",66,"ن",2,0],["ولمّا جلا التوديع عما عهدتُه","ولم يَبقَ إلا نظرةٌ تُتَغنَّمُ",67,"م",1,0],["ولما جلاك الملكُ في ثوب جسمه","تراءت على قدر العروس المَجاسدُ",68,"د",1,0],["ولما جلا لي حُسنَ وجهك بِشرُهُ","تبيَّنَ في وجه السَّقام قُطوبُ",69,"ب",1,0],["ولم أجلُ منهُ كل هيفاءَ سفَّهت","قدود القنا أو أرمدت أعين السّرب",70,"ب",1,0],["ولم أجدْ لمّا ترحّلتُمُ","على النوى والبينِ مَن يُنجِدُ",71,"د",1,0],["ولمّا جَزَعنا الجِزعَ قلتُ لناقتي","الى دارِ ليلى بالأجارعِ ميلي",72,"ل",2,0],["ولما جعلنا للمهيمن ذلنا","اعزَّ تعالى بالتعالي دلالنا",73,"ن",2,0],["ولِما جرى منكم جرَى من مقلَتي","بحرٌ على الخدِّ القَريحِ مُطَمْطَمُ",74,"م",1,0],["ولمّا جلعتك لِي مَوْئِلاً","دعاني الورى خيرَ ما وائلِ",75,"ل",1,0],["ولمّا جرينا للفخارِ عثرتُمُ","وأعوزكمْ أن تسمعوا بعثاري",76,"ر",2,0],["ولمّا جَحدتُ الحبَّ قال خبيرُه","إذا كنت لا تهوى فلِمْ أنتَ زافرُ",77,"ر",1,0],["وَلَمّا جرَوْا يَرجونَ سَبْقي إِلى العُلا","مَضيتُ وَلَمّا يَلحَقوا بترابي",78,"ب",2,0],["ولم أجد مسعفاً أشكو الزمان له","بل وجدتك يا سؤلي ومعتصمي",79,"م",2,0],["ولم أَجعلِ الكفَّ الشِّمالَ وِسَادَةً","فباتَ على كفِّ اليمينِ مُوَسَّدَا",80,"د",2,0],["ولم أَجِدْ لحْماً ولكن وجد","تُ الفول والكُرَّات والثُّومَا",81,"م",2,0],["وَلمَّا جَلاكَ الفِكْرُ يا غَايةَ المُنَى","فَظلَّ بِقَلْبِي مُقْعِدٌ ومُقيمُ",82,"م",1,0],["وَلَمّا جاءَني مَنَعاهُ أَذكى","ضُلوعي وَاِستَهَلَّ المَدمَعانِ",83,"ن",1,0],["وَلَم أَجِد في القَومِ مِن مُعينِ","يُنصِفُني مِنكَ وَلا يُعديني",84,"ي",1,0],["ولم أجد من وضيع الذِكر خاملُهُ","ما ساءني من رفيع الذكرِ مختالِ",85,"ل",1,0],["وَلَم أَجهَلْهُ إِذ قَد بانَ لَكِنْ","لَهاني عَن تَحقّقهِ الهِيامُ",86,"م",1,0],["وَلَم أَجِد لخارج مِنهُم أَثَر","وَكُلُّ عاقل يَراه بِالنَظَر",87,"ر",1,0],["وَلَم أَجِد مَنفَعَةً للأُولى","ضيَّعت ظَني فيك وَالمَأمولا",88,"ل",2,0],["وَلَم أَجد لَها سِواك أَهلا","وَلا جَناباً في الأَنام سَهلا",89,"ل",2,0],["ولما جلا فصل الربيع محاسناً","وصفق ماء النهر إذ غرد القمري",90,"ي",1,1],["وَلَمْ أجْنَحْ لِزَادٍ فِي طَرِيقِي","وَمَنْ يَقْصْدُه لم يَجْنَحْ لِزَادِ",91,"د",1,0],["ولم أجد من خليل استعين به","يوم البلاء اذا ما لم يكن بلل",92,"ل",1,0],["ولما جاء من كانت عيوني","لضاحي وجهه ابداً تراقبْ",93,"ب",1,1],["ولمَّا جَدَّ بي وَجْدي بِسَلْمَى","تَركْتُ العَذْلَ يَلْعَبُ بالعَذولِ",94,"ل",1,0],["وَلَم أَجد إِلى المُنى سَبيلاً","وَلا رزقت ظله الظليلا",95,"ل",2,0],["وَلَم أَجد في الحَزم غَير المَكث","في مَوضِعي خَوف التوى وَاللبث",96,"ث",1,0],["وَلَم أَجزَع لِفَقدِ أَخٍ لِأَني","رَأَيتُ المَرءَ يُؤتى مِن أَخيهِ",97,"ي",2,0],["وَلَم أَجِد لَذَّةَ طَعمٍ إِذا","فَكَّرتُ في الزَقّومِ في النارِ",98,"ر",1,0],["ولما جزمت استثن للوجود","نعم أجب أعلم وللوعود",99,"د",1,0],["ولم اجد فيه كتاباً نافعا","لطالبٍ ولا لأصلٍ جامعا",100,"ع",2,0],["وَلَمْ أَجِدْ في كِتابي غَيْرَ سَيِّئَةٍ","تَسُوءُني وَعَسى الإِسْلام يَسْلمُ لي",101,"ل",2,0],["ولم أجِدْ حيلةً تُبْقي على رَمَقي","قبَّلتُ عينَ رسولي إذ رآك بها",102,"ه",2,0],["وَلَم أَجعَل قرابي غَيرَ بَيتي","فَحَسبي ما تَقَدَّمَ مِن قراعِ",103,"ع",1,0],["ولما جلا غمدُهُ رَوضَةً","طَواه بها حَيّةً أُفْعُوانا",104,"ن",2,0],["ولم أجد سبة فيما أسطره","بالغت في الوصف أو أسرفت في الكلم",105,"م",1,0],["ولمّا جَرَتْ هاتا نَطَقْتَ تَذُمُّنا","مُعِيناً علينا اليومَ غيرَ مُعانِ",106,"ن",1,0],["ولم أَجْلِبِ الخَيْلَ العِتاقَ حَوامِلا","شباباً يُرَوّونَ الرِّماحَ وشِيبا",107,"ب",2,0],["ولم أجىء بالذي قل","ت فيه شياً فرِيّا",108,"ي",2,0],["ولم أجد غيره يشفي فأطلبه","هو العليلُ المعلُ السامعُ الرائي",109,"ي",1,0],["ولما جَلَّ عتبي حلَّ غيبي","على عيني فصيَّره عديما",110,"م",2,1],["وَلَم أَجِد قَطُّ خَلقاً","كَخِلقَتي مُستَخَفّا",111,"ف",2,0],["ولم أجد بعد هذا ما يكافئه","إلا الدعاء له بالسر والجهر",112,"ر",1,0],["ولما جئت \"وجدة\" همت وجدا","بمنخنث المعاطف معنوي",113,"ي",1,0],["ولما جرى أمر القضاء بما جرى","وقد كان أمر اللَه قدراً محتما",114,"م",2,0],["ولما جنيت الورد من وجناته","تغنمتها لثماً وأجللتها قطفا",115,"ف",2,0],["ولم أجد عزة الخلائق إلا الدي","ن لما اعتبرت والحسبا",116,"ب",2,0],["ولم أجدْ عروةَ الخلائق غلاّ الد","دينَ لمّا اعْتَبرتُ والحَسَبا",117,"ب",2,0],["وَلَم أَجد كَالفَتى عَبد العَزيز أَخاً","وَلَو أَطَلت بِتشريقي وَتَغريبي",118,"ب",2,0],["ولما جلا لي وجهه بعد بعده","وطور اصطباري عن محاسنه دكا",119,"ك",2,0],["ولما جرَى بى الحبُّ شوطاً وقال لى","إذا لم تخالفنى بلغتَ رجاءكا",120,"ك",2,1],["ولم اجتنى شيئا سوى الزور والشقا","وما لي سوى نقض الامانات والجور",121,"ر",1,0],["ولم أجد ثم داراً","بها لسكنى المقيم",122,"م",1,0],["ولما جاد مولانا بنجل","لشمس العز والعلياء جاور",123,"ر",1,0],["ولما جفاني مالكي ومعذبي","ومزق مخلاب النوى جسدي البالي",124,"ل",2,0],["ولم أجد لي عزاءً","دعوت ربي انتصارا",125,"ر",2,0],["ولم أجد للفضل في أرض النجف","سوقا ولاحقاً لأرباب الشرف",126,"ف",1,0],["ولما جلاه البشر غيّبه السنا","كذلك قرص الشمس باد مغيب",127,"ب",1,1],["وَلَمْ أجد ف الورى إِلاَّ مخادَعةً","من الخَدينِ فما للحقِّ أَخْذان",128,"ن",1,0],["وَلَم أَجْلِفُ وَلَم يُقصِرنَ عَنّي","وَلَكِنْ قَدْ أَنى لي أَنْ أريعا",129,"ع",2,0],["ولما جفانا من الفنا وصاله","واخلف عام كان يرجى واجدبا",130,"ب",2,0],["ولما جاءت البشرى","بهذا المنصب الفاخر",131,"ر",1,0],["ولما جَلا أفراحَ مصر عزيزُها","رشَفْنا على حبِّ العزيز لمى الراحِ",132,"ح",1,1],["ولم أجن ما يقضي بحسبي وإنما","دعوت إلى الإسلام بين بني جنسي",133,"س",2,0],["ولما جرى العتب المبرح بيننا","بدت حسرات من مشوق وشائق",134,"ق",1,0],["ولما جَفَوتُم وازوَرَرتُم وبِنتُم","وَقد قَطَعَت باليَأسِ تِلك المطَامعُ",135,"ع",1,1],["ولم أجب باعتذارٍ","محاولاً للدفاعِ",136,"ع",1,0],["وَلم أَجزِ إِحسانَ الوَرى بِإِساءةٍ","وَلم أَجز بالإِحسان عِن سُوء سَيِّئِ",137,"ي",2,0],["وَلم أُجبها بِلا أَهلٍ وَلا وَلَدِ","مروَّعَ الرُوحِ صبَّ القَلبِ ذا كَمَد",138,"د",1,0],["ولم أجد من الرجال زاجرا","بل كان بعضهم لهن ناصرا",139,"ر",2,0],["ولم أجد النصير لكشف كرب","ولم ألق المعين لشد أزري",140,"ر",2,0],["ولما جرى في معاني علاك","فما انفك يقذف في الطرس نورا",141,"ر",2,0],["ولما جلاها واستفزت يدُ الهوى","الى ذُلها أبناء عزٍ مُطَّنب",142,"ب",1,0],["ولمّا جرى طرفي وفي الدمع حمرة","تيَّقنت أن القلبَ سالَ بأدمعي",143,"ع",2,0],["ولم أجد منكَ أوقات الوصال ولم","أفُز بدرَ حديث منك منتظمِ",144,"م",1,0],["وَلم أَجد أذناً في الحقّ واعِيَةً","كَأَنَّني في بِلادٍ أَجنَبِيّاتِ",145,"ت",1,0],["ولِمَا جنيتَ من الخنَا وتبائِعٍ ومظالم","لا تعجلنَّ على الظلومِ فبِئسَهُ من ظالمِ",146,"م",1,0],["ولم أجِد عندَ قلبٍ لا يُساعِدني","صَبراً على القتلِ بالهجرانِ مَشكوا",147,"ك",3,0],["ولما جددت منها العطايا","دوارس ذي الرغائب والغرائب",148,"ب",1,0],["ولم أجد من دونها موئلاً","والعزمُ واهٍ والعوادي شِداد",149,"د",1,0],["ولما جييت باعذاري توقعت السماح اول","تمننت بعذر واهي..حملته بنفسي وجييتك",150,"ك",1,0],["ولما جلا فصل الخريف محاسنا","وصفق ماء النهر إذ غرد القمري",151,"ي",1,1],["ولَمْ أجِئْ أثرًا مِنْ بعَدِ بَينٍ إِلى","عينَيكِ مُتَّكِئًا إلاَّ علَى حُلُمِ",152,"م",1,0],["ولم أجد كلماً فيه أبلغ في","مدح النقولا وضاعت دون ذا حيلي",153,"ل",2,0],["وَلَمْ أَجِدْ وَلَمْ تَجِدْ طِفْلَتِي","بِرَوْضَتِي أُرْجُوحَةَ الْأَوْطَفِ*",154,"ف",1,0],["ولما جه حسنى إليها","راح مسلمها المدام",155,"م",1,0],["ولما جه مرسى نحرها","وادى للعسكر تمام",155,"م",1,0],["ولما جلى عنه العجاجة في الوغى","هوى فوقه شوقا لخديه لاثما",156,"م",2,0],["ولما جاء دوري ..في لقائي","إذا بالشيخ سيدنا .. رغيفُ !!",157,"ف",1,0],["ولم أجزع لحكم الله ربي","ولكنْا بما يقضي رضينا",158,"ن",2,0],["وَلَمْ أَجِدْ أَهْلَهُ إِلاَّ أُهَيْلَ خَنا","يَغَصُّ مِنْ بَيْنِهِمْ بِالرِّيقِ مَنْ حَلُمَا",159,"م",2,0],["ولما جئته قالوا تولى","إلى الغبرا وقد أمسى ترابا",160,"ب",2,0],["ولما جئتها فرت سراعا","وقد أرخت من الخفر النفايا",160,"ي",2,0],["ولما جفاني من أحب وخانني","حفظت له الود الذي كان ضيعا",161,"ع",2,1],["ولما جرى ذكر الإنابة سابقا","وما قد بدا من سير أهل الطريقة",162,"ه",1,0],["ولم أجتلب إلا إليك محببا","إلى خلقك الدار الأجل خفيرها",163,"ر",3,0],["وَلَم أَجِدِ الذِي مِثلِي تَأَذَّى","وَلا مِثلِي فَتَىً أَرداهُ صَعقُ",164,"ق",1,0],["ولم أجزع لأناتي","ومن بالضر لا يجزع",165,"ع",1,0],["ولم أَجِدِ الحُسْنى به غَيْرَ فَتْرةٍ","تَولَّتْ. فما أوْهى جَداهُ. وما أغْوى!",166,"و",2,0]]}