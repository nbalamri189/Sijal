{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[63,"أغض جماح الوجد بين الجوانح","https://www.aldiwan.net/poem45724.html","الطويل"],[63,"وبارقة تمخض بالمنايا","https://www.aldiwan.net/poem45914.html","الوافر"],[77,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[73,"ثقي بي يا معذبتي فإني","https://www.aldiwan.net/poem11877.html","الوافر"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[72,"تصرمت الأيام دون وصالك","https://www.aldiwan.net/poem19437.html","الطويل"],[72,"إذا ظفرت يوما بقربكم المنا","https://www.aldiwan.net/poem20155.html","الطويل"],[64,"أنا أنت بلا شك","https://www.aldiwan.net/poem67605.html","الهزج"],[51,"إذا حاولت تطفيلا","https://www.aldiwan.net/poem61986.html","الهزج"],[51,"الدمع في العين لا نوم ولا نظر","https://www.aldiwan.net/poem65718.html","البسيط"],[51,"أسومك ما يسوم العبد مثلي","https://www.aldiwan.net/poem65810.html","الوافر"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[70,"تعيش أنت وتبقى","https://www.aldiwan.net/poem42788.html","المجتث"],[38,"إني امرؤ لم أزل وذاك من الله","https://www.aldiwan.net/poem7834.html","المنسرح"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[45,"ألمت وهل إلمامها لك نافيع","https://www.aldiwan.net/poem64706.html","الطويل"],[28,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[61,"أجزار باب الشام كيف وجدتني","https://www.aldiwan.net/poem51791.html","الطويل"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[102,"برح بي الشوق فلما طغى","https://www.aldiwan.net/poem33000.html","السريع"],[22,"تبينت ما فيه بخفان إنني","https://www.aldiwan.net/poem21695.html","الطويل"],[52,"يا نفس صبرا صبرا","https://www.aldiwan.net/poem26977.html","المجتث"],[52,"خليلي قد طاب الشراب المبرد","https://www.aldiwan.net/poem27079.html","الطويل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[77,"يا سيدي أفديك بالنفس","https://www.poetsgate.com/ViewPoem.aspx?id=34187",""],[22,"تبيَّنتُ ما فيه بخفّانَ إنّني","https://www.poetsgate.com/ViewPoem.aspx?id=19778",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[28,"ستبلغ عني غدوة الريح أنها","https://www.poetsgate.com/ViewPoem.aspx?id=20997",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[129,"حبيب ملول بالوصال بخيل","https://www.aldiwan.net/poem50561.html","الطويل"],[187,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[200,"سعوا بيننا حتى لقد كنت راضيا","https://www.aldiwan.net/poem45575.html","الطويل"],[211,"يا رب عفواً فإني خائف وجل","https://www.aldiwan.net/poem13305.html","البسيط"],[211,"مولاي حاشاك لقد مال بي","https://www.aldiwan.net/poem13318.html","السريع"],[211,"يا أيها المولى الذي جوده","https://www.aldiwan.net/poem13320.html","السريع"],[238,"قد افتقرت يا إلهنا الغني","https://www.aldiwan.net/poem19287.html","الرجز"],[271,"تمرين يا ذات الملاء المزيل","https://www.aldiwan.net/poem35579.html","الطويل"],[271,"أصاحب لا تعذليه سلام","https://www.aldiwan.net/poem35591.html","المتقارب"],[276,"قابلت نعماك بالسجود","https://www.aldiwan.net/poem25581.html","مخلع البسيط"],[281,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[281,"ألم تك للملوك الغر تاجا","https://www.aldiwan.net/poem60700.html","الوافر"],[317,"يا أيها القاضي السني الذكر","https://www.aldiwan.net/poem69439.html","الرجز"],[321,"ولما جلسنا للشراب ومنيتي","https://www.aldiwan.net/poem61687.html","الطويل"],[321,"لما تمادى على بعادي","https://www.aldiwan.net/poem61749.html","مخلع البسيط"],[349,"السيف خلفي فعذرا إن جرحت إذا","https://www.aldiwan.net/poem19843.html","البسيط"],[350,"لو كنت مني ما غبت عني","https://www.aldiwan.net/poem15970.html","مخلع البسيط"],[367,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[406,"صددتم بلا جرم فجور صدودكم","https://www.aldiwan.net/poem49710.html","الطويل"],[438,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[438,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[440,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[454,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[459,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[465,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[478,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[478,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[501,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[501,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[552,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[552,"إذا لم تكوني دار فضل ونفحة","https://www.aldiwan.net/poem47762.html","الطويل"],[552,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[576,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[576,"تظنني قد بت محموما","https://www.aldiwan.net/poem2803.html","السريع"],[587,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"]],"verses":[["وَلَم أَجهَدِ السَيفَ الطَويلَ نِجادُهُ","أَمامَ الظُبى وَالنَقعُ بِالنَقعِ يَرتَمي",0,"م",2,0],["وَلَمّا جَدَّ جَدُّ البَينِ فينا","وَهَبتُ لَهُ الظَعائِنَ وَالقِبابا",1,"ب",2,0],["وَلَمّا جَرَّبَ البيضَ المَواضي","رَآكَ مِنَ الظُبى أَمضى ذُبابا",1,"ب",2,0],["وَلَمّا جَذَبتَ زِمامَ الزَمانِ","أَطاعَ وَلَكِن عَصاكَ الحَبيبُ",2,"ب",1,0],["وَلَمّا جَزَعنا الرَّملَ قال لَنا السُّرى","أَلا رَفِّهوا عَن ساهِماتٍ طَلائِحِ",3,"ح",1,0],["وَلمَّا جَرَّتِ الظَّلْماءُ ذَيْلاً","يُوارِي مَسْلَكَ الأَسَلِ النِّهالِ",4,"ل",1,0],["ولمْ أجْنِ ذَنْباً سِوى أنّني","صدَعْتُ بأمْداحِها في المَلا",5,"ل",2,0],["وَلَم أَجحَد عَوارِفَهُ وَلَكِن","رَأَيتُ المَنَّ داعِيَةَ الجُحودِ",6,"د",1,0],["وَلَم أَجنِ الذُنوبَ فَتَحقِديها","وَلَكِن عادَةٌ مِنكِ التَجَنّي",7,"ن",2,0],["ولم أجد العيدان أقذاء أعين","ولكنما اقذاؤها ما ينوبها",8,"ب",3,0],["ولم أجهل الغيث الذي نشأت به","ولم أتضرع أن يجيء غُضُوبُها",8,"ب",3,0],["ولما جلا الملك المؤيد رأيه","جلا ظله الممدود وهج الممالك",9,"ك",1,0],["ولما جنى طرفي رياض جمالكم","جعلتم سهادي في عقوبة من جنى",10,"ن",2,0],["وَلَم أُجلَد يا رَبِّ","إِذا قيلَ هُوَ الزاني",11,"ن",2,0],["ولما جاء بغداد","رأيتَ الناس أنباذا",12,"ذ",2,0],["ولم أجد ذلك المعنى وعيشكما","إلا البكاء إذا ما فاجع طرقا",13,"ق",2,0],["ولم أجهلْ هنالكَ جور حُكمي","ولكنّي عرفتُ هناكَ نُبلك",14,"ك",1,0],["ولمَا جعلْتُك إذ أطلتُ كموردٍ","قَذَفٍ أُمِرَّ رشاؤُه فأطيلا",15,"ل",2,0],["ولما جلوتُ صفاح قلبِك واعظاً","أنِّي رأيتُ عليه ريناً رائنا",16,"ن",2,0],["وَلَم أَجِد بَينَ مَوتي","وَبَينَ هَجرِكَ فَرقا",17,"ق",2,0],["وَلَم أَجِد عُدَّةَ الخَلائِقِ إِل","لا الدينَ لَمّا اِعتَبَرتُ وَالحَسَبا",18,"ب",2,0],["وَلَم أَجِد قَبلَهُ قَصيرَ يَدٍ","فازَ بِمالِ الأَهوازِ يَحتَجِنُه",19,"ن",2,0],["وَلَمّا جَرى لِلمَجدِ وَالقَومُ خَلفَهُ","تَغَوَّلَ أَقصى جُهدِهِم وَهوَ وادِعُ",20,"ع",1,0],["وَلَمّا جَرى بي غالِبٌ وَجَرى بِهِ","عَطِيَّةُ لَم يَسطَع وُثوبَ الجَراثِمِ",21,"م",1,0],["وَلَمّا جَرَينا لَم نَجِد جالِياً لَهُ","وَلا جالِسَن عِندَ المَدى مِثلَ دارِمِ",21,"م",1,0],["ولم أجهَلْ نصيحتَه ولكنْ","جنونُ الحُبِّ أحلى في جِناني",22,"ن",2,0],["ولم أَجحَدْ صنائعَ مِنْكَ جلَّتْ","ولم أسلُبْكَ مدحاً فيك سارا",23,"ر",2,0],["ولمّا جرى الحُذَّاقُ في ضوءِ صُبْحِه","تَعَّثْرتَ منه في ضَبابِةِ غَيهَبِ",24,"ب",1,0],["وَلَمّا جَلَوتُ المَدحَ وَاِرتَحتُ لِلنَدى","وَرُحنا وَكُلٌّ في الطِلابِ مُجيدُ",25,"د",1,0],["ولما جرى الدرّ الرطيب بِخَدّها","وسال إلى الدر النظيم توقّفا",26,"ف",2,0],["ولم أجدْ في الرَّسمِ أخلاَقها","جرَّبتُها حيناً وجرّبتُه",27,"ت",2,0],["وَلَمّا جَرى في القَومِ بَيَّنتُ أَنَّها","أَجارِيُّ طِرفٍ في رِباطِ نَزيعِ",28,"ع",1,0],["وَلَم أَجِد إِذا ماتوا","لي في الحَياةِ عُذرا",29,"ر",2,0],["وَلَمّا جَنَيناها قِطافاً رَويَّةً","تَذوبُ إِذا مَسَّت عَناقيدَها اليَدُ",30,"د",1,0],["ولم أجدِ الإنسانَ إلاّ ابنَ سعيهِ","فمن كان أسعى كان بالمجد أجدرا",31,"ر",2,0],["وَلَمّا جَلاها الشَمعُ سَبَّحَ ناظِرٌ","وَكَبَّرَ رَفّافٌ وَساروا فَأَرهَجوا",32,"ج",3,0],["ولم أَجِد ركناً غني","ياً بالحنان طيِّبا",33,"ب",2,0],["ولَم أَجِدِ الفَتَى يَلهُو بَشيءٍ","ولَو أَثرَى ولَو وَلَدَ البَنيا",34,"ن",3,0],["ولما جرت في البحرِ تخطِرُ سُفْنُهم","من آخرِ الهادي إلى البلطيك",35,"ك",1,0],["ولم أجد عندي جزاء له","سواي فأملكني بلا فلس",36,"س",1,0],["ولمَّا جرى في لقوم بيَّنت أنّها","أجَارِيُّ طِرْفٍ في رِبَاطِ نَزِيْعِ",37,"ع",1,0],["ولما جشمني أثقاله","ولما فارق ظهر الجمل",38,"ل",1,0],["ولم اجدْ كمَجالِ الصَبرِ من وَطَنٍ","يَرتادُه الجُبْنُ مصطافاً ومُرتْبَعَا",39,"ع",2,0],["ولم أجدْ ما يُنَسَّيني مَضاضتَها","إلا عواطفَ خُلاّنٍ وخُلْصان",40,"ن",1,0],["وَلمّا جَرَيْنَا لمْ نَجِدْ جالِياً لَهُ،","ولا جالِساً عَندَ المَدَى مثلَ دارِمِ",41,"م",1,0],["ولما جد جدهم استقلوا","على ظهر القطار مسافرينا",42,"ا",1,0],["ولما جَفانِي واستطَالَ بِهَجْرِه","رجعتُ إلى م في الزمانِ خليلُ",43,"ل",1,0],["ولم أجد لي مشتكى في الإنس","غير أبي بشر الطبيب القس",44,"س",1,0],["وَلَم أَجتَمِع واللَّه منهم بواحدٍ","وَذاكرتهُ إلّا وَددتُ لهُ القَبرا",45,"ر",2,0],["ولم أجنِ ذنباً غيرَ أني ذو هوىً","وأنكَ لي دونَ الأنامِ محببُ",46,"ب",1,0],["ولم أجد لي سبيلا في مدافعة","وبي تقطعت الاسباب والسبل",47,"ل",1,0],["ولم اجد لي في الورى مخلصا","منه سوى رب السجايا الحسان",48,"ن",1,0],["ولم اجد منتقطا لي وان","لقطت لم اسلم من الحائل",49,"ل",1,0],["وَلَمْ أَجِدْ مِنْ أَحَدٍ بِي يَعْتَنِي","سِوَاكَ يَا رَبِّ فَكُنْ لِي أَغْتَنِي",50,"ي",1,0],["ولما جَرَرتِ الذَّيلَ أخضرَ ضافياً","سمعتُ حفيفَ المورقِ المتميِّل",51,"ل",1,0],["ولم أجنِ إلا الندامةَ مما","غَرَستُ وهذا نصيبُ الكرام",52,"م",1,0],["ولم أجِدْ لِلْحَياةِ عُدْماً","وفي وجودِ الرّضى وجودِي",53,"د",2,0],["وَلَمْ أَجِدِ الْكَبِيرَ الرُّزْءِ إِلاّ","سَلِيلَ عُلاً فُجِعْتَ بِهِ صَغِيراً",54,"ر",2,0],["وَلَمْ أَجْعَلْكَ دُونَ الْخَلْقِ قَصْدِي","لِتَجْعَلَ لِي إِلى الْخَلْقِ احتِياجا",55,"ج",2,0],["ولم أجده مشترى فأشري","فجد حباك الله طول عمر",56,"ر",1,0],["وَلَمّا جَلَسنا لِلشَرابِ وَمُنيَتي","يَمُرُّ عَلَينا بِالطِلا وَيدورُ",57,"ر",1,1],["وَلَم أَجِد مِن هَواهُ بَدا","وَالوَجدُ مازالَ في اِزدِيادِ",58,"د",1,0],["وَلَمْ أَجِدْ خَشَباً يَدْنُو السِّراجُ لهُ","قَبلي وَكَمْ أَتَتِ الأَشْياءُ بالعَجَب",59,"ب",1,0],["وَلَم أَجِد بِالرُقادِ فَقدي","مِنّي وَذو يَقظَةِ يَراني",60,"ن",2,0],["وَلَمّا جَلا البِشرُ مِن وَجهِهِ","لَنا القَمَرَ المُصبِحَ الزاهِرا",61,"ر",2,0],["ولَم أجنِ ذَنباً غير أنِّي بحُبِّكُمْ","خَضَعْتُ لكُمْ صُغْراً كَما خضَعَ الجاني",62,"ي",1,0],["ولما جاء من غيري قصيد","وما وافى لكم مني قصيد",63,"د",1,0],["ولم أجد سبباً يخني الزمان به","على ذوي الفضل إلا حرفة الأدب",64,"ب",1,0],["ولَمَا جَزَرْتَ لَهَا وليمةَ مُعْرِسٍ","إِلّا الضَّراغِمَ عادِياً وهَصُورا",65,"ر",2,0],["ولم أجد نابغا أولى بتكرمتي","ولا مثالية أولى بإيماني",66,"ن",2,0],["ولمّا جلا التوديع عما عهدتُه","ولم يَبقَ إلا نظرةٌ تُتَغنَّمُ",67,"م",1,0],["ولما جلاك الملكُ في ثوب جسمه","تراءت على قدر العروس المَجاسدُ",68,"د",1,0],["ولما جلا لي حُسنَ وجهك بِشرُهُ","تبيَّنَ في وجه السَّقام قُطوبُ",69,"ب",1,0],["ولم أجلُ منهُ كل هيفاءَ سفَّهت","قدود القنا أو أرمدت أعين السّرب",70,"ب",1,0],["ولم أجدْ لمّا ترحّلتُمُ","على النوى والبينِ مَن يُنجِدُ",71,"د",1,0],["ولمّا جَزَعنا الجِزعَ قلتُ لناقتي","الى دارِ ليلى بالأجارعِ ميلي",72,"ل",2,0],["ولما جعلنا للمهيمن ذلنا","اعزَّ تعالى بالتعالي دلالنا",73,"ن",2,0],["ولِما جرى منكم جرَى من مقلَتي","بحرٌ على الخدِّ القَريحِ مُطَمْطَمُ",74,"م",1,0],["ولمّا جلعتك لِي مَوْئِلاً","دعاني الورى خيرَ ما وائلِ",75,"ل",1,0],["ولمّا جرينا للفخارِ عثرتُمُ","وأعوزكمْ أن تسمعوا بعثاري",76,"ر",2,0],["ولمّا جَحدتُ الحبَّ قال خبيرُه","إذا كنت لا تهوى فلِمْ أنتَ زافرُ",77,"ر",1,0],["وَلَمّا جرَوْا يَرجونَ سَبْقي إِلى العُلا","مَضيتُ وَلَمّا يَلحَقوا بترابي",78,"ب",2,0],["ولم أجد مسعفاً أشكو الزمان له","بل وجدتك يا سؤلي ومعتصمي",79,"م",2,0],["ولم أَجعلِ الكفَّ الشِّمالَ وِسَادَةً","فباتَ على كفِّ اليمينِ مُوَسَّدَا",80,"د",2,0],["ولم أَجِدْ لحْماً ولكن وجد","تُ الفول والكُرَّات والثُّومَا",81,"م",2,0],["وَلمَّا جَلاكَ الفِكْرُ يا غَايةَ المُنَى","فَظلَّ بِقَلْبِي مُقْعِدٌ ومُقيمُ",82,"م",1,0]]}