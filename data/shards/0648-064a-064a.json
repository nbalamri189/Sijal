{"poems":[[55,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[6,"لمن الديار عفون بالحبس","https://www.aldiwan.net/poem378.html",""],[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[63,"متى يقال قد دنا","https://www.aldiwan.net/poem51360.html","مجزوء الرجز"],[51,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[79,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[102,"شمسان","https://www.poetsgate.com/ViewPoem.aspx?id=50171",""],[6,"لِمنِ الدِّيارُ عفونَ بالحَبسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14194&r=&rc=9",""],[119,"ليس التصوف بالخرق","https://www.aldiwan.net/poem41767.html","مجزوء الكامل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[411,"لما توليت الأمور وأظلمت","https://www.aldiwan.net/poem49933.html","الكامل"],[415,"بعدت مسافة بيننا وتوحشت","https://www.aldiwan.net/poem32260.html","الكامل"],[463,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[572,"أفدي التي أهوت لنا","https://www.aldiwan.net/poem69556.html","مجزوء الكامل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34785","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77537","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46485","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109331","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130837",""],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112565","الوافر"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20615","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125943","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73241","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141666","الكامل"],[4858,"ويلُ الشّجِيّ من الخَلِيّ","https://www.poetsgate.com/ViewPoem.aspx?id=140780",""],[4859,"بهي المحيا!","https://www.poetsgate.com/ViewPoem.aspx?id=198167",""],[4984,"أثر الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=191621",""],[5061,"انا اذنب ياربي","https://www.poetsgate.com/ViewPoem.aspx?id=153002",""],[5431,"وعجبت من روح به تتورطُ!","https://www.poetsgate.com/ViewPoem.aspx?id=187513",""],[5716,"وي ........","https://www.poetsgate.com/ViewPoem.aspx?id=24333",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[463,"حملتْ ركابُ الغربِ شمسَ شروقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60157&r=&rc=213",""],[572,"أفدي التي أهدَتْ لَنَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9415&r=&rc=272",""]],"verses":[["وَئينَ الجِفانُ الغُرُّ مِن قَمَعِ الذُرى","هِجانُ الأَعالي بِالسَديفِ المُسَرهَدِ",0,"د",1,0],["وَيَئِستُ مِمّا كانَ يُطمِعُني","فيها وَلا يُسليكَ كَاليَأسِ",1,"س",1,0],["وَيَئِسْتُ إِذْ عَاقَتْكِ أَحْرَاسُ العِدَى","عَنْ زَوْرَتِي وَتَألَّفُوا وَتَأَلَّبُوا",2,"ب",3,0],["ويئست حليلتي","معذورة من خيري",3,"ر",2,0],["وَيَئِستُ أَن أَبقى لِشَيءٍ نِلتُ مِم","ما فيكِ يا دُنيا وَأَن يَبقى لي",4,"ل",2,0],["وَيَئِنُّ الشَّآمُ تَحتَ كُرُوبٍ","شَامِلاَتِ الأَغوارِ وَالأنْجَادِ",5,"د",1,0],["ويئسْتُ إذ عاقَتْكَ أحراسُ العِدا","عن زَوْرتي وتألَّفوا وتألَّبوا",6,"ب",3,0],["ويئنّ من جلّاده وهو الذي","صنع الطّغاه وسلّح الجلّادا",7,"د",2,0],["وَيَئِسْتُ مِمَّا كَانَ يَشْعَفُني","فيها ولا يُسليكَ كاليأسِ",8,"س",1,0],["ويئج من مكنونه","حرق يمازجها قلق",9,"ق",1,0],["وَيَيأسُ داعي السوء منهُ مهابة","وَيأنس راجي العرفِ مِن بشرهِ قُربا",10,"ب",2,0],["ويَئستُ مِمَّن كنتُ أرجو فضلَهُ","وأُعِدُّهُ عنوانَ صُحفِ ذخائري",11,"ر",2,0],["ويئستُ من أن نَلتقِي لكنّنِي","ألقَى تذكُّركُم بقلبٍ خَافِقِ",12,"ق",1,0],["ويئستُ حتى لو بصُرت بنارِهم","لِقرىً شككتُ وقلتُ نارُ حريقِ",13,"ق",1,0],["وَيَئِسْتُ مِنْ إِدْرَاكِهَا","فَجَعَلْتُ صَوْتِي عِنْدَ ذَلِكْ",14,"ك",1,0],["ويئوب ناجيهن بين مضرجٍ","بدمٍ ومخلوبٍ إلى منسور",15,"ر",1,0],["وَيئس الصَياد من","رُؤيتهِ بالحيَلِ",16,"ل",1,0],["وىية الكرسي إذا تقراها","فإنها حرز لمن قراها",17,"ه",2,0],["وَيَئست مِن فَرَحٍ وَخَير عاجل","كَالممتري في قُدرة الجَبار",18,"ر",1,0],["ويئن كالولهان فا","رق شادنا يهوى جماله",19,"ل",2,0],["ويئست لما أعلنت","نكث الولاء على غرورِ",20,"ر",1,0],["وَيَيدِ الْمُعنِدِ الْمُتَعدِي","قَدْ جَفَا الْمُصْطَفَى بِسَيْفِ عِنادِ",21,"د",1,0],["وئيد الخطو وثبته","إذا ما اهتيج غلابه",22,"ب",2,0],["وَيَئِستُ مِنكَ فَكُلُّ عُسرٍ باسِطٌ","كَفّا إِلَيَّ وَكُلُّ يُسرٍ أَقطَعُ",23,"ع",1,0],["ويئن فيك الحب أنة عاشق","قد كنت في عينيه أطيب منزل",24,"ل",1,0],["وَيَيبتُ من طَربٍ بِقَلبي صادِعاً","تَغريدُ طائرِ دوحهنَّ الصَّادحِ",25,"ح",1,0],["ويئنّ أنة مستجير واجفاً","كالطير قُرّ فبات دون قرار",26,"ر",1,0],["ويُيَسّرَ الأسبابَ كي ترسو بنا","سفنُ الهمومِ على صعيدٍ أخضرا",27,"ر",2,0],["ويئن الفؤاد من أجل أرضٍ","حكّم الجهلُ في رباها شقيّا",28,"ي",2,0],["ويُيَسِّر الله الأمور وإنما","كل يعود إلى الحساب بفعله",29,"ل",2,0],["وييبسها الغدر ويدودل البرعم مع الأغصان","ويهدمها من أسفلها الى آخر رأس عاليها",30,"ي",3,0],["ويئنُ بي وجعي فبُعْديَ مِشْرطُ","وبلمسةٍ منه الجراح تُخيّطُ",31,"ط",1,0],["وي ياجرح القلب وي","جرح قلبى مالو زى",32,"ا",1,1],["ويئست منك مدى الحياة، ولن أرى","منكَ الرعايةَ، واليَؤُوسُ سعيدُ",33,"د",1,0],["ويئستُ حتّى بصرتُ بنارهمْ","لقرى ً شككتُ وقلتُ نارُ حريقِ",34,"ق",1,0],["ويئسْتُ مِنْ إدراكهَا","فخفضت صَوتي عند ذلِكْ",35,"ك",1,0]]}