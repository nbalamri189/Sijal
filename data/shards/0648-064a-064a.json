{"poems":[[53,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[6,"لمن الديار عفون بالحبس","https://www.aldiwan.net/poem378.html",""],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[61,"متى يقال قد دنا","https://www.aldiwan.net/poem51360.html","مجزوء الرجز"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[77,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[6,"لِمنِ الدِّيارُ عفونَ بالحَبسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14194&r=&rc=9",""],[113,"ليس التصوف بالخرق","https://www.aldiwan.net/poem41767.html","مجزوء الكامل"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[402,"لما توليت الأمور وأظلمت","https://www.aldiwan.net/poem49933.html","الكامل"],[406,"بعدت مسافة بيننا وتوحشت","https://www.aldiwan.net/poem32260.html","الكامل"],[456,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[565,"أفدي التي أهوت لنا","https://www.aldiwan.net/poem69556.html","مجزوء الكامل"]],"verses":[["وَئينَ الجِفانُ الغُرُّ مِن قَمَعِ الذُرى","هِجانُ الأَعالي بِالسَديفِ المُسَرهَدِ",0,"د",1,0],["وَيَئِستُ مِمّا كانَ يُطمِعُني","فيها وَلا يُسليكَ كَاليَأسِ",1,"س",1,0],["وَيَئِسْتُ إِذْ عَاقَتْكِ أَحْرَاسُ العِدَى","عَنْ زَوْرَتِي وَتَألَّفُوا وَتَأَلَّبُوا",2,"ب",3,0],["ويئست حليلتي","معذورة من خيري",3,"ي",1,0],["وَيَئِستُ أَن أَبقى لِشَيءٍ نِلتُ مِم","ما فيكِ يا دُنيا وَأَن يَبقى لي",4,"ل",2,0],["وَيَئِنُّ الشَّآمُ تَحتَ كُرُوبٍ","شَامِلاَتِ الأَغوارِ وَالأنْجَادِ",5,"د",1,0],["ويئسْتُ إذ عاقَتْكَ أحراسُ العِدا","عن زَوْرتي وتألَّفوا وتألَّبوا",6,"ب",3,0],["وَيَئِسْتُ مِمَّا كَانَ يَشْعَفُني","فيها ولا يُسليكَ كاليأسِ",7,"س",1,0],["ويئج من مكنونه","حرق يمازجها قلق",8,"ق",1,0],["وَيَيأسُ داعي السوء منهُ مهابة","وَيأنس راجي العرفِ مِن بشرهِ قُربا",9,"ب",2,0],["ويَئستُ مِمَّن كنتُ أرجو فضلَهُ","وأُعِدُّهُ عنوانَ صُحفِ ذخائري",10,"ي",1,0],["ويئستُ من أن نَلتقِي لكنّنِي","ألقَى تذكُّركُم بقلبٍ خَافِقِ",11,"ق",1,0],["ويئستُ حتى لو بصُرت بنارِهم","لِقرىً شككتُ وقلتُ نارُ حريقِ",12,"ق",1,0],["وَيَئِسْتُ مِنْ إِدْرَاكِهَا","فَجَعَلْتُ صَوْتِي عِنْدَ ذَلِكْ",13,"ك",1,0]]}