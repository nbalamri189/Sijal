{"poems":[[53,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[6,"لمن الديار عفون بالحبس","https://www.aldiwan.net/poem378.html",""],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[61,"متى يقال قد دنا","https://www.aldiwan.net/poem51360.html","مجزوء الرجز"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[77,"زارَتْ وقَدْ صَرَفَ العِنانَ الغَيْهَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33317",""],[6,"لِمنِ الدِّيارُ عفونَ بالحَبسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14194&r=&rc=9",""]],"verses":[["وَئينَ الجِفانُ الغُرُّ مِن قَمَعِ الذُرى","هِجانُ الأَعالي بِالسَديفِ المُسَرهَدِ",0,"د",1,0],["وَيَئِستُ مِمّا كانَ يُطمِعُني","فيها وَلا يُسليكَ كَاليَأسِ",1,"س",1,0],["وَيَئِسْتُ إِذْ عَاقَتْكِ أَحْرَاسُ العِدَى","عَنْ زَوْرَتِي وَتَألَّفُوا وَتَأَلَّبُوا",2,"ب",3,0],["ويئست حليلتي","معذورة من خيري",3,"ي",1,0],["وَيَئِستُ أَن أَبقى لِشَيءٍ نِلتُ مِم","ما فيكِ يا دُنيا وَأَن يَبقى لي",4,"ل",2,0],["وَيَئِنُّ الشَّآمُ تَحتَ كُرُوبٍ","شَامِلاَتِ الأَغوارِ وَالأنْجَادِ",5,"د",1,0],["ويئسْتُ إذ عاقَتْكَ أحراسُ العِدا","عن زَوْرتي وتألَّفوا وتألَّبوا",6,"ب",3,0],["وَيَئِسْتُ مِمَّا كَانَ يَشْعَفُني","فيها ولا يُسليكَ كاليأسِ",7,"س",1,0]]}