{"poems":[[65,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[3,"وفوارس لي قد علمتهم","https://www.aldiwan.net/poem109.html",""],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[95,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[49,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[23,"تبلت فؤادك في المنام خريدة","https://www.aldiwan.net/poem21235.html","الكامل"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[93,"ما عز من لم يصحب الخذما","https://www.aldiwan.net/poem62738.html","عموديه"],[87,"لي سؤال يا أهل مصر فردوا","https://www.aldiwan.net/poem7543.html","الخفيف"],[64,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[60,"ألله حي قديم قادر صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[68,"يا للحماسة ضاقت بينكم حيلي","https://www.aldiwan.net/poem41550.html","البسيط"],[18,"أنكحها فقدها الأرقم في","https://www.aldiwan.net/poem23926.html","المنسرح"],[46,"عياش يا ذا البخل والتصريد","https://www.aldiwan.net/poem30051.html","الكامل"],[33,"عاود القلب يا لقومي سقما","https://www.aldiwan.net/poem41338.html","الخفيف"],[107,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[107,"يا أيها الداعي وليس بمسمع","https://www.aldiwan.net/poem43140.html","الكامل"],[107,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[107,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[50,"قالوا تنسك بعد الحج قلت لهم","https://www.aldiwan.net/poem63255.html","البسيط"],[50,"أمنك للمكتوم اظهار","https://www.aldiwan.net/poem63369.html","السريع"],[52,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[93,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""],[3,"وفوارسٍ لي قد علمتُهُم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10746&r=&rc=100",""],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[254,"هل للحليم على ما فات من أسف","https://www.aldiwan.net/poem2102.html","البسيط"],[266,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[311,"صرمت ظليمة خلتي ومراسلي","https://www.aldiwan.net/poem25.html","الكامل"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[333,"هذا الطريق الطويل","https://www.aldiwan.net/poem54924.html","المجتث"],[338,"إن دعى غالب هماما","https://www.aldiwan.net/poem1119.html",""],[354,"ليس وصف الفضل فضلا","https://www.aldiwan.net/poem15897.html","مجزوء الرمل"],[401,"لا أبتغي عنهم ولا أُشريهم","https://www.aldiwan.net/poem562.html",""],[484,"وقفوا هناك وحسبهم","https://www.aldiwan.net/poem36960.html","مجزوء الكامل"],[556,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[556,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[563,"خلوة القبر أشرف الخلوات","https://www.aldiwan.net/poem34708.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2408","المنسرح"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2409","المنسرح"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2407","المنسرح"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66813","البسيط"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96311","البسيط"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21302","البسيط"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100685","البسيط"],[1727,"","https://poetry.dctabudhabi.ae/diwan/poem/118022","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69416","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2462,"","https://poetry.dctabudhabi.ae/diwan/poem/144713","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87766","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93970","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100369","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65122","البسيط"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3350,"","https://poetry.dctabudhabi.ae/diwan/poem/98178","الكامل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117161","المنسرح"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35885","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131908","الرمل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45957","الخفيف"],[4858,"ويحَ الكبير يعيش بين صغار","https://www.poetsgate.com/ViewPoem.aspx?id=148455",""],[4929,"قُلْ للذي أبْكَتْ يداهُ زماني","https://www.poetsgate.com/ViewPoem.aspx?id=199282",""],[5136,"ثقتي أنت يا كريم الذات","https://www.poetsgate.com/ViewPoem.aspx?id=121530",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5187,"ذكريات وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=29255",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[592,"يا عين فابكي على الإخوان لو بدم","https://www.poetsgate.com/ViewPoem.aspx?id=128812",""],[5493,"يا طائرًا بالنور","https://www.poetsgate.com/ViewPoem.aspx?id=197223",""],[402,"بقي الذكر والرغام فني","https://www.poetsgate.com/ViewPoem.aspx?id=36474",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[6093,"تكافؤُ نَسَبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=198803",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[5393,"إن الذيول صناعة غربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85459&r=&rc=26",""]],"verses":[["ليسوا منَ النَّفَرِ الذينَ أصولُهُمْ","خَبُثَتْ وليسَ لهُنَّ فرْعٌ نامِ",0,"م",1,0],["لَيسوا كَأَقوامٍ عَلِمتُهُمُ","سودِ الوُجوهِ كَمَعدَنِ البُرمِ",1,"م",1,0],["لَيسوا بِعَدلٍ حينَ تَن","سُبُهُم إِلى أَخَوَي فَزارَه",2,"ر",2,0],["لَيْسَ وَقْعُ النَّدَى عَلَى زَعَرٍ","مِثْلَ وَقْعِ النَّدَى عَلَى دِمَنِ",3,"ن",1,0],["لَيسوا يَنونَ فَلا تَنوا في أَمرِكُم","لا يَنهَضُ الواني لِغَيرِ الواني",4,"ن",2,0],["لَيسوا كَيَعمُرَ حينَ يَشتَجِرُ القَنا","وَالخَيلُ تَضبِرُ تَحتَ كُلِّ قَتامِ",5,"م",1,0],["ليسوا سواء المجد إلا إذا","تساوت الخزفةُ والدّرّه",6,"ر",2,0],["لَيسوا إِذا طَرَدوا يَنمي طَريدُهُمُ","وَلا تَنالُ أَكُفُّ القومِ ما مَنَعوا",7,"ع",3,0],["لَيسوا ذَوي خَطَرٍ وَقَد زَعَموا","وَالغَربُ ذو خَطَرٍ وَما زَعَما",8,"م",2,0],["لي سؤال يا أهل مصر فردّوا","بجواب عن السؤال مفيد",9,"د",1,1],["ليس والله ماؤنا","من دم لا ولا شعر",10,"ر",1,0],["لَيسوا كَقَتلى مِنَ الكُفّارِ أَدخَلَهُم","نارَ الجَحيمِ عَلى أَبوابِها الرُصُدُ",11,"د",1,0],["لَيسوا مِنَ الشَرِّ في شَيءٍ وَإِن هانا","يولونَ جاني الأَسى عَفواً وَمَعذِرَةً",12,"ه",1,0],["لَيسوا بِأَكفائِنا الكِرامِ وَلا","يُغنونَ مِن عَيلَةٍ وَلا عَدَمِ",13,"م",1,0],["لَيُسَوِّدَنَّ يَفاعَ وَجهِكَ مَنطِقي","أَضعافَ ما سَوَّدتَ وَجهَ قَصيدي",14,"د",2,0],["لِيَسوءَ الصَديقَ بِالصَرمِ مِنّا","زَيدَ أَنفُ العُداةِ بِالوَصلِ رَغما",15,"م",2,0],["ليسوا بقوميَ إن طَالتْ جهالتُهم","وظَلَّ يخدعُهم ظنٌّ وتَخييلُ",16,"ل",1,0],["لَيسوا لَنا أَهلاً وَلَسنا نَبتَغي","بَدَلاً بِأَهلينا الَّذينَ تَمَزَّعوا",17,"ع",3,0],["لَيسوا كَمَن مَلَكَ النُفوسَ فَسامَها","سوءَ العَذابِ وَغالَها اِستِرقاقا",18,"ق",2,0],["ليسوا وإن وَرَدُوا المنيَّةَ لِلأُلى","غَمَر البِلَى وُرّادَهَم أشباها",19,"ا",3,0],["لَيسوا كَقَومٍ إِذا حاذَيتَ مَجلِسَهُم","أُنفِذتَ بِالتَركِ وَالإِزكانِ إِنفاذا",20,"ذ",2,0],["لَيسوا بِجانينَ عَلى ناظِرٍ","شَوبانِ إِحلاءٌ وَإِمرارُ",21,"ر",1,0],["لَيسَ وادٍ مِن سُلَيمى","لِمُحِبٍ بِعَشيبِ",22,"ب",1,0],["ليسوا رجالا لا نطيق فعلهم","لكنهم جدوا وقصرنا الخطى",23,"ا",1,0],["ليسوا ذوي خطر وقد زعموا","والغرب ذو خطلر وما زعما",24,"م",2,0],["ليْسُوا كأَقوامٍ عِلِمْتُهُمْ","سودِ الوجوه كمغذنِ البرم",25,"م",1,0],["لَيسوا إِذا شُبَّت وَغىً كَجَمائِعٍ","بِخِلافِهِم عُصِيَ البُطَينُ الأَنزَعُ",26,"ع",1,0],["لَيسُوا كَقَومٍ كُلُّ ما عُرِفُوا بِهِ","ثِقلُ النُفوسِ وَخِفَّةُ الأَحلامِ",27,"م",1,0],["لَيسوا إِذا الحَربُ أَبدَت عَن نَواجِذِها","يَومَ اللِقاءِ بِأَنكاسٍ وَلا كُشُفِ",28,"ف",1,0],["ليسوا من الشعراء بعد فليتهم","شعروا حقيقة شاعر موزون",29,"ن",1,0],["ليسوا بأنكاسٍ ولا ميلٍ اذ","ما الحربُ شُبّت اشعلوا بالشاعلِ",30,"ل",1,0],["لَيسوا سَواءً جَسورٌ ذو مُزايَنَةٍ","عِندَ الأُمورِ وَلا الهَيّابَةُ القَصِفُ",31,"ف",1,0],["ليس وراء السؤال","إلا سؤال سواه",32,"ه",1,0],["ليسوا إذا ما نسبوا كراما","سود الوجوه عذلاً ابراما",33,"م",2,0],["لَيسَ وَصفُ الفَضلِ فَضلاً","لِلَّذي لَم يَبدُ مِنهُ",34,"ن",2,1],["ليسوا بأنذالٍ ولا بأشابةٍ","فيما ينوبُ القومَ لا باللاتِ",35,"ت",1,0],["ليسوا الجناة وإنما","شأن القوي مع الضئيل",36,"ل",1,0],["ليس وعدٌ منهمْ وإن غلِطُوا بال","وعدِ يوماً كانوا له ماطِلينا",37,"ن",2,0],["لَيسوا منَ الفخرِ ولا عنده","ولا لهمْ في رَبْعِه مَطْرَقُ",38,"ق",1,0],["ليس والله من يمت فهو ميت","إنما الموت موت هذي الحياة",39,"ه",1,0],["لَيسوا يَمُنّونَ فَضلَهُم وَلَهُم","فَضلٌ عَلَينا بِأَحسَنِ النِعَمِ",40,"م",1,0],["لَيسوا مِنَ الخِروَعِ الضَعيفِ وَلا","أَشباهِ عيدانِهِ وَلا غَرَبِه",41,"ب",2,0],["لَيسوا مَفاريحَ عِندَ نَوبَتِهِم","وَلا مَجازيعَ إِن هُمُ نُكِبوا",42,"ب",3,0],["ليسوا يُريدون غيرَ الله ربِّهمُ","نعمَ المرادُ تَوخّاه المُريدونا",43,"ن",2,0],["ليسوا كثعلبةَ المغبوطِ جارُهُم","كأنه في ذَرى تَهلانَ أو خِيمِ",44,"م",1,0],["لَيسوا إِلَيهِ وَلَكِن يَعلقونَ بِهِ","كَما تَعَلَّق راقي النَّخل بِالكَرَبِ",45,"ب",1,0],["ليسوا وإن نعموا عيشاً سوى نعم","وربّما نعمت في عيشها النعم",46,"م",1,0],["ليسوا إلى عربٍ منا فنعرفهم","ولا صميمِ الموالي إن همُ نُسبوا",47,"ب",3,0],["لَيسُوا كَأَبناءِ مِرداسٍ إِذا وَعَدُوا","فَقَد وَفَوا وَإِذا قالُوا فَقَد صَدَقُوا",48,"ق",3,0],["لَيسُوا بِأَنظارِ الأَمِيرِ وَلا الأُلى","نَطَقُوا بِحُسنِ صِفاتِهِم نُظَرائِي",49,"ا",2,0],["ليسوا هم منه ولا هو","منهم قدر القلامه",50,"م",2,0],["لَيسُوا كَمَن نَبَذَ الكِتَابَ حَقِيقَةً","وَتِلاَوَةً قَصداً بِتَركِ فُلاَنِ",51,"ن",1,0],["لَيسُوا مَخَانِيثَ الوُجُودِ فَلا إلَى ال","كُفرَانِ يَنحَازُوا وَلاَ الإِيمَانِ",51,"ن",1,0],["ليس والله بالشآم يمان","فيه روح ولا بغير الشآم",52,"م",1,0],["لَيسوا بطرّاء عَلَيهِ وَلا","شذاذِ آفاق وَعُبدان",53,"ن",1,0],["ليس وعد الكريم يا صاح يخلف","بل بأضعاف ما تكرم يخلف",54,"ف",1,1],["لي سؤال على الديار وفحصٌ","يوم كم سائل ولا مسؤول",55,"ل",1,0],["ليسوا بكفء لتجهيز الجيوش لهم","لكن جلاصٌ لهم كفءٌ وإن قصرا",56,"ر",2,0],["ليسوا له بالصدق يعشقونا","ومثل الذين ينفقونا",57,"ن",2,0],["ليسوا بسكان بهاتيك البلد","ولا لهم بذلك النادي أحد",58,"د",1,0],["ليسوا بأنكاسٍ ولا ميلٍ اذا","ما الحربُ شُبّت اشعلوا بالشاعلِ",59,"ل",1,0],["ليسوا كمعزى مطيرَةٍ بقِيَت","فما بها من سحابَةٍ لثَقُ",60,"ق",1,0],["لَيسَ وادٍ لا أَرى في","هِ حَبيبي لي بَوادِ",61,"د",1,0],["لي سؤال قد حار فكري فيه","فتلطف وجد برد سؤالي",62,"ي",1,0],["ليس وعد الحر برقا خلّبا","يولع النفس ولا ينفى الصدا",63,"د",2,0],["لَيسَ وَقعُ اللِسانِ كَالسَيفِ كَلّا","ضَربَةُ السَيفِ تَنبو في الأَحيانِ",64,"ن",1,0],["ليسوا صغاراً في سنيّ طفولةٍ","إنّ الطّفولةَ زينةُ الأعمارِ",65,"ر",1,0],["لِيَسُوقَها زَهْوُ الغُرُورِ بِرِيشِها","فتُنَافِسَ العصفورَ في الطيرانِ",66,"ن",1,0],["لي سؤال علمته يا رسول الله","قبل التلقين بالكلمات",67,"ت",1,0],["ليس وصف العناء يجدي فتيلا","ليس ندب الظماء يروي غليلا",68,"ل",2,0],["ليسَ وجهُ الحَقِّ أن نلقى نَجَاحاً","أينما سِرنا وساقتنا خُطانا",69,"ن",2,0],["ليسوا على ثقة من نقل مؤتمن","يدري الحقائق خافيها وباديها",70,"ي",3,0],["ليسوا يرون أخا التعليم وفي","رسائل الشيخ ذا علم ولا حكم",71,"م",1,0],["ليسوا سوى سوطٍ يحرِّكهُ العدَى","أو في المقاصلِ آلةِ الإعدامِ",72,"م",1,0],["ليس وقع الندى على زهر","مثل وقع الندى على دمن",73,"ن",1,0],["35. ليسوا من الانسان فيما أجرموا","في المسجد الأقصى وليسوا من