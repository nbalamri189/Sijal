ق باسما","https://www.poetsgate.com/ViewPoem.aspx?id=121672",""],[5145,"سلام على من لم أفز بلقائه","https://www.poetsgate.com/ViewPoem.aspx?id=108231",""],[5145,"نعم حلب العين اعتراف الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=108071",""],[5190,"الجوزاء والبحر","https://www.poetsgate.com/ViewPoem.aspx?id=68758",""],[5237,"هو السعد كم من وضيع رفع","https://www.poetsgate.com/ViewPoem.aspx?id=113113",""],[5237,"مرادي من المولى وغاية آمال","https://www.poetsgate.com/ViewPoem.aspx?id=113106",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[5320,"غزال","https://www.poetsgate.com/ViewPoem.aspx?id=41641",""],[5419,"وهل في الشعر يا أم ارحميني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=32254",""],[5431,"السوريّ","https://www.poetsgate.com/ViewPoem.aspx?id=183192",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5431,"العراق -انتفاضة الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=207055",""],[5736,"أضغاث عاطفة","https://www.poetsgate.com/ViewPoem.aspx?id=208867",""],[5781,"بعضٌ من حب","https://www.poetsgate.com/ViewPoem.aspx?id=202852",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5851,"ضوء قراح","https://www.poetsgate.com/ViewPoem.aspx?id=175304",""],[5969,"سلام لمن رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=199203",""],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6259,"علا بك نجمُ الدين فاشتدَّ ناصره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59378&r=&rc=26",""]],"verses":[["هُوَ السَيفُ إِن أَغمَدتَهُ كانَ حازِماً","وَقوراً وَإِن جَرَّدتَهُ كانَ عادِيا",0,"ي",2,0],["هُوَ السابِقُ الهادي إِلى عَقدِ بَيعَةٍ","رَأى الناسَ فيها بَينَ حَسرى وَظُلَّعِ",1,"ع",1,0],["هوَ السُّحْبُ جوداً والكَواكِبُ همّةً","وبدْرُ الدُّجى وجهاً وشمْسُ الضُحى رأيا",2,"ي",2,0],["هو السجن ما أدراك ما السجن أنه","جلاد البلايا في مضيق التَجَلُّد",3,"د",1,0],["هو السيف إن أنت أنحيته","لرأسك أو رأس قرن فلق",4,"ق",1,0],["هو السيفُ يجني كلَّ رأسٍ دنا له","وقدماً إذا ما استصرم الدومُ يُصرَمُ",5,"م",1,0],["هو السل ماذا يفعل الطبُّ نحوه","إذا كان يعي داؤُه حيلة الطب",6,"ب",1,0],["هُوَ السَيفُ الَّذي نَصَرَ اِبنَ أَروى","بِهِ مَروانُ عُثمانَ المُصابا",7,"ب",2,0],["هُوَ السَحابُ الَّذي بَشاشَتُهُ","بارِقُهُ وَالحَيا عَطاياهُ",8,"ا",2,0],["هُوَ السَيفُ عَضباً قَد أَرَثَّت جُفونُهُ","وَضُيِّعَ حَتّى كُلُّ شَيءٍ يَفُلُّهُ",9,"ل",2,0],["هُوَ السَيلُ إِن واجَهتَهُ اِنقَدتَ طَوعَهُ","وَتَقتادُهُ مِن جانِبَيهِ فَيَتبَعُ",10,"ع",1,0],["هُوَ السَّيْفُ فِي حَدّيْهِ لِينٌ وَشِدَّةٌ","فَتَلْقَاهُ حُلْوَ الْبِشْرِ مُرَّ الْمَطَاعِمِ",11,"م",1,0],["هو السَّهمُ الذي عَرَفَتهُ قِدماً","وجَرَّبَ وَقعَهُ الشَّعبُ الوئيدُ",12,"د",1,0],["هُوَ السَبيلُ الَّذي تُرجى النَجاةُ بِهِ","فَليَهدَإِ القَومُ إِنَّ اللَهَ مُنجينا",13,"ن",2,0],["هُو السّيفُ لولا الجبنُ لم يَمْضِ حدُّه","ولم يَرْضَ في جِدّ الكريهةِ بالهزلِ",14,"ل",1,0],["هُوَ السَّيْفُ فاحذرْ صَفْحَةً لِغِرَارِهِ","فَبَيْنَهُما لِلَّامِسِينَ غُرورُ",15,"ر",1,0],["هو السيفُ سيف الصِّدق أمّا غِرارُهُ","فَعَضْبٌ وأمّا مَتْنُهُ فَصَقِيل",16,"ل",1,1],["هو السيفُ الأصمُّ إذا تغنَّى","صغا متجبّرٌ ووعَى كلامهْ",17,"م",2,0],["هو السيف أطغَى ما خضعتم لحكمه","إذا ما انتضاه الحقدُ في كفِّ جاهل",18,"ل",1,0],["هو السيفُ يَمضي في اللِّقاءِ سَمِيُّهُ","ولكنَّهُ أمضَى غِراراً وأصرَمُ",19,"م",1,0],["هو السجاد من يطوي الخفايا","تقلب في الكرام الساجدين",20,"ن",1,0],["هو السيد الندب المؤمل فيضه","لكل مجد في السلوك وواصل",21,"ل",1,0],["هو السيف سيف اللَه قاطع من بغى","عليَّ وغوثي إن دهاني زمانيا",22,"ي",2,0],["هو السماح الذي بالجود ينكفحُ","هو السحاب الذي بالغيث ينهمرُ",23,"ر",1,0],["هُو السلطانُ سلطانُ بن سيفِ","سلالةُ مالكِ الفطن الكَيّ",24,"ي",1,0],["هُوَ السَعيُ أَرضى ذا الجَلالِ وَخَلقَهُ","فَدُم أَبَداً سِتراً عَلى الخَلقِ مُسبَلا",25,"ل",2,0],["هُوَ السِترُ يأوي كُلُّ ضاحٍ لِظِلِّهِ","مُقيمُ عِمادِ الدينِ حافِظُ أَصلِهِ",26,"ه",1,0],["هو السيفُ إِلاَّ أَنَّه ليس نابياً","إِذا عاقَه المقدورُ عن كلِّ ضاربِ",27,"ب",1,0],["هو السخي فما يحويه فرقه","ما لم يهبه بملك فيه لم يلق",28,"ق",1,0],["هُوَ السُقمُ إِلّا أَنَّهُ غَيرُ مُؤلِمٍ","وَلَم أَرَ مِثلَ الشَيبِ سُقماً بِلا أَلَم",29,"م",1,0],["هُوَ السَّيّدُ الضِّرغامُ وَالأَسَدُ الَّذي","بَنى مَجدَهُ فَوقَ النُّجومِ الثَوَاقِبِ",30,"ب",1,0],["هُوَ السَيفُ بَل لَو أَنَّ لِلسَيفِ عَزمَهُ","لَشَقَّ الطُلا وَالهامَ قَبلَ التَصادُمِ",31,"م",1,0],["هو السببُ الذي لولاه فينا","لَمَا عُرِف الحلالُ من الحرام",32,"م",1,0],["هُوَ السُؤلُ لا يُعطيكَ وافِرَ مِنَّةٍ","يَدُ الدَهرِ إِلّا حينَ أَبصرته جلدا",33,"د",2,1],["هو السماءُ وهي بدرٌ حولها","من كلّ فلبٍ يتلظى كوكبُ",34,"ب",1,0],["هو السيف الا ان ليس به صدا","هو البحر الا ما لجوهره فدف",35,"ف",1,0],["هو السيدُ الزاكي المليكُ الذي نَمَى","على الأرض من أكفافِه الجودُ والعَدْلُ",36,"ل",1,0],["هو السيدُ المعروفُ في كلِّ بُقْعَةٍ","له في علوِّ الخافقينِ مَجَالُ",37,"ل",1,0],["هو السيدُ السامي تَحِيضُ بكفِّهِ","حرابُ العوالي مَعْ حدودِ البواترِ",38,"ر",1,0],["هو السيد المشهور في كلِّ غارةٍ","تصيحُ العُلا من بأسه وتغوث",39,"ث",1,0],["هو السور الهادي إلى الحق نورها","وآيات صدق للمنيبين تنفع",40,"ع",1,0],["هُوَ السَفجُ وَضّاحُ الثَنِيّاتِ زَهرُهُ","وَرامَة فَيّاحُ النَسيمِ شَذاها",41,"ا",3,0],["هُوَ السَيفُ إِن لا يَنَتهُ لانَ مَسُّهُ","وَغَرباهُ إِن خاشَنتَهُ خَشِنانِ",42,"ن",1,0],["هو السيّد السامي الأنام طريقةً","بها لشهود الحقّ يمشي على استحيا",43,"ح",3,0],["هو السيّد العالي الصحيح روايةً","عن الكامل البكريّ أسنى الورى محيا",43,"ح",3,0],["هُوَ السَّيْفُ يُغْشِي ناظِراً عِنْدَ سَلِّهِ","بِهاءً وَيُرْضِي فاتِكاً يَوْمَ ضَرْبِهِ",44,"ب",2,0],["هُوَ السَّيْفُ لا تَلْقاهُ إِلاّ مُؤَهَّلاً","لإيجابِ عِزٍّ قاهِرٍ أَوْ لِسَلْبِهِ",44,"ب",2,0],["هُوَ السالِبُ الجَبّارِ بَيضَةَ مُلكِهِ","يَرى أَنَّ حِرمانَ العُفاةِ غُلولُ",45,"ل",1,0],["هُوَ السَيفُ لا تُخشى لَهُ الدَهرَ نَبوَةٌ","وَلا مِثلُهُ يَوماً يُقَلَّبُ ذابِلُ",46,"ل",1,0],["هو الساس والرأس للأمر كل","بأولهم يدعى لذلك وآخر",47,"ر",1,0],["هو السراجُ الّذي مِن نوره خلقَ ال","كَونانِ وَاِمتازَتِ الأنوارُ والظلمُ",48,"م",1,0],["هو السدُّ مَوصولاً إِلى صدَفَي حمى","وَما بينَ بحرَي فتنةٍ هو برزخُ",49,"خ",1,0],["هو السيّد البشير نجل عزيزةٍ","وفرع أصولٍ طيّبات رفيعةِ",50,"ه",1,0],["هو السابقُ المُذكي عدا أنّ سبقهُ","لِمُجريهِ يُعزى ما له فيه من شعبِ",51,"ب",1,0],["هُوَ السَيّد المُختار وَالسَند الَّذي","إِلى اللَهِ في حُبّي لَهُ أَتَقَرَّبُ",52,"ب",1,0],["هُوَ السَيفُ الَّذي مِنهُ اِستَفادَت","سُيوفُ بَني الوَغىذاكَ المَضاءَ",53,"ا",2,0],["هُوَ السَحابُ وَعَتبُ السُحبِ إِن غَضِبَت","تَجري فَتُعتِبُ عَنها أَلسُنُ الدِيَمِ",54,"م",1,0],["هُو السُّقمُ إمَّا في قُلوبٍ يُذيبُها","كقَلبي وإمَّا في جُفُونٍ يَزينُها",55,"ن",3,0],["هو السحاب الذي تهمي بوادره","غيثاً من الحق الإيمان مدرارا",56,"ر",2,0],["هو السلام المؤمن البر من","إليه لا غير يكون المصير",57,"ر",1,0],["هوَ السالِبُ الأَعداء في ساعضة الوَغى","وَيَسلبُهُ في ساعَة السِلمِ زائِرُهُ",58,"ر",2,0],["هو السعيد الَّذي يشقى العدو به","من ذا يعاديه في الدنيا ولم يخب",59,"ب",1,0],["هو السيد المفضال والكرم الذي","إذا شحت الأنواء فاضت بحورهُ",60,"ه",1,0],["هو السيف لكن فيه من كل وجهةٍ","لأهل الردى حدّ مدى الدهر باترُ",61,"ر",1,0],["هو السَّيفُ لا يَرْتَابُ أَنَّكَ سَيفُهُ","إذَا نازَلَ الأَقرَانَ فِي الحَرْبِ أَقرَانُ",62,"ن",1,0],["هو السيف واليافوخ والقلب جفنه","متى يكسر القرضاب لم ينفع الجفن",63,"ن",1,0],["هو السحرُ لا بَلْ فتنةٌ بابلية","بَلِ الغِنْجُ بلْ شيءٌ فؤادي به أدرى",64,"ر",2,0],["هو السابق البذَّاذ في حلبةِ العُلى","إلى غايةٍ طَلابُها غير لاحقِ",65,"ق",1,0],["هو السيفُ الصَّقيلُ بكفِّ ذمْرٍ","فلا نابي الغِرارِ ولا كَهامُ",66,"م",1,0],["هو السيد القرم الجميل ثناؤه","فيا مقلتي سجي على السيد القرم",67,"م",1,0],["هو السهم أصمى كل مرمى سداده","وياكم رأينا رامياً مخطئ السهم",67,"م",1,0],["هو السهم أصمى من فؤادي صميمه","ه