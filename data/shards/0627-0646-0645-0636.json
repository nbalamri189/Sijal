{"poems":[[133,"رويدك شمس الحياة","https://www.aldiwan.net/poem67443.html","مجزوء المتقارب"],[280,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[479,"أبلغ الحارث عني أنني","https://www.aldiwan.net/poem2165.html","الرمل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126754","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49594","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49565","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52117","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58341","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205668","الخفيف"],[5187,"ذكريات وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=29255",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5409,"أتراهم من وحشةِ الأرض طاروا","https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5720,"النَّهار","https://www.poetsgate.com/ViewPoem.aspx?id=207397",""]],"verses":[["أنَمضِي ولمّا نَنَل","رَغائبَ نفسٍ طَموح",0,"ح",1,0],["أَنَمضي كذا جاهِلين","حيارى مَطايا الأسَف",0,"ف",1,0],["إنَّ مِضْرابَ القُيونِ المُحَلّى","غَيْرُ مِضْراب القِيانِ المِلاح",1,"ح",1,0],["إن مضى الحول ولم أغزكم","في عناجِ تهتدي أحوى طِمِرّ",2,"ر",1,0],["إن مضى عنكمُ الزعيم المرجّى","فاِستعينوا على المصائبِ صَبرا",3,"ر",2,0],["إن مضى أكد نعم أمر خصر","أن مضى أكد وعلّ اسم حصر",4,"ر",1,0],["إن مضى عنها أبو موسى فها","بأبي الهادي إليها رجعا",5,"ع",2,0],["أَنمْضي الليالي لا تُقضّي مآري","ولو شفّني همّي بها وَتَهمُّمي",6,"م",2,0],["أنمضِي الليالي لا أراكِ وربّما","عَدَتْنِي العَوَادي عنْ طِلابِكِ في الحَشْر",7,"ر",1,0],["ان مضت قدمها تقل يا طريفي","أو لوت خلفها تقل يا نلادي",8,"د",2,0],["إنْ مَضَتْ أيّامُ لَهوي والتّصابي","وَبَدا صُبْحُ مَشيبي في شَبابي",9,"ب",2,1],["إِن مَضى مَضى ال","أَبيَضُ الخَذِم",10,"م",1,0],["إن مُضمَرُ اسمٍ سَابِقٍ فِعلاَ شَغَل","عَنهُ بِنَصبِ لفظِهِ أوِ المَحَل",11,"ل",1,0],["إن مضى الناس يعجبون قديمًا","كيف تعلو عجبتُ كيف تُسِفُّ",12,"ف",1,0],["إنْ مَضَتْ أعوامُنا عرضاً وطولاً","لمْ يزدْنا سَبرها إلا اتّزانا",13,"ن",2,0],["أنمضي في ثنايا الأرضِ نشكو؟","وفينا باقتسامِ الجدبِ خصبُ",14,"ب",1,0],["إن مضى مسرعاً تقلصت ال","أرض ولاذت ببعضها الأقطار",15,"ر",1,0],["إن مضى قِردٌ، فقردٌ قادمٌ","وخَبَال الرأي للمنتظر",16,"ر",1,0],["إنْ مضينا علىٰ طريقِ رؤانا","عزمُنا الجدُّ .. والنصيرُ الودودُ",17,"د",1,0]]}