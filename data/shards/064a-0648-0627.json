ttps://www.poetsgate.com/ViewPoem.aspx?id=120672",""],[6124,"ألحان الموج","https://www.poetsgate.com/ViewPoem.aspx?id=125195",""],[6124,"نسجت النور","https://www.poetsgate.com/ViewPoem.aspx?id=193247",""],[6152,"أدب المواساة","https://www.poetsgate.com/ViewPoem.aspx?id=206617",""],[454,"إلى هيئة الأمم المتحدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82667&r=&rc=31",""],[5567,"ذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69072&r=&rc=10",""]],"verses":[["يُواصِلُ الحُزنُ قَلبي كُلَّما فُجِعَت","يَدي بِحَبلٍ مِنَ الأَقرانِ مُنقَطِعِ",0,"ع",1,0],["يواصِلُنا والليْلُ غَضٌّ شَبابُهُ","ويَهْجُرُ إن شابَتْ ذَوائِبُ غَيْهَبِ",1,"ب",1,0],["يُؤازِرُهُ قَلبي عَلَيَّ وَلَيسَ لي","يَدانِ بِمَن قَلبي عَلَيَّ يُؤازِرُه",2,"ه",1,0],["يُوافِقُني في كُلِّ أَمرٍ أُريدُهُ","وَيَحفَظُني حَيّاً وَبَعدَ مَماتي",3,"ت",2,0],["يُوازي كُبَيداءَ السَماءِ وَدونَهُ","بَلاطٌ وَداراتٌ وَكِلسٌ وَخَندَقُ",4,"ق",1,0],["يُوارينَ المِلاحَ فَلا نَراها","وَيُخفينَ القِباحَ فَيَزدَهينا",5,"ن",2,0],["يُوالي إِذا اِصطَكَ الخُصومُ أَمامَهُ","وُجوهَ القَضايا مِن وُجوهِ المَظالِمِ",6,"م",1,0],["يُواسونَ مَولاهُمُ في الغِنى","وَيَحمونَ جارُهُمُ إِن ظَلُم",7,"م",1,0],["يؤَازِرُ ربّ الملك ربّ كتابةٍ","كأنَّ طروس الخط منها جنوده",8,"د",2,0],["يؤَازِرُ أملاك الزَّمان كما ترى","فيشتدُّ بنيان الزَّمان وأزره",9,"ر",2,0],["يُواحِكُ عند العذل في بَذْلِ مالهِ","وعندَ ارتيادِ الحقّ غيرُ مُواحك",10,"ك",1,0],["يُواجِهُني أَينَ اتَّجَهتَ خَيالُهُ","كَما كُنتُ أَلقاهُ قَديماً وَيَلقاني",11,"ن",2,0],["يُوافيكَ فيها أَينَما كُنتَ رَوضَةٌ","وَيَلقاكَ أَنّى كُنتَ رَوحٌ وَرَيحانُ",12,"ن",1,0],["يُواصِلُني سِرّا وَيُصرِمُ ظاهِراً","وَذَلِكَ مِن أَفعالِهِنَّ عَجيبُ",13,"ب",1,0],["يوارون في لحد اذا مت رمتى","كأن بمن قد مات فقراً الى اللحد",14,"د",1,0],["يوالينَ جدّاً في السعودِ مخيَّرا","ويصحبنَ رأياً في الغُيوبِ مُحَكَّما",15,"م",2,0],["يُواري كُلَيباً إِذا اِستَجمَعَت","وَيَعجِزُ عَن مَجلِسِ المُقعَدِ",16,"د",1,0],["يُواصلُهم وما اشتاقَت إليه","نفوسُهُمُ ولا سألوا الوِصالا",17,"ل",2,0],["يؤانِسُ منهم كلَّ ليثِ حَفيظَةٍ","على الطِّرفِ وحشيَّ الشَّمائلِ أغيَدا",18,"د",2,0],["يُواصلُ في اسمه فِعلَ ال","مُقرَّبِ ثم يُجتَنَبُ",19,"ب",1,0],["يُوافِقُني في كُلِّ خَيرٍ أُريدُهُ","وَيَحفَظُني حَيّاً وَبَعدَ وَفاتي",20,"ت",2,0],["يواصلُ فيهمُ فتكُ ابن آوى","وهم في غَفْلَةِ البَهَمِ الرّبيضِ",21,"ض",1,0],["يُواتِرونَ تِباعَ الكَرِّ إِن رَكِبوا","وَيَصدُقونَ دِراكَ الطَعنِ إِن نَزِلوا",22,"ل",3,0],["يُواتيني النَديمُ عَلى التَصابي","أَلَذُّ إِلَيَّ مِن يَومِ الطِعانِ",23,"ن",1,0],["يُوافِقُهُ اِرتِكاضُ القِردِ فيهِ","وَإِن مَسَحَ الضُراطَ فَذاكَ رِبحُ",24,"ح",1,0],["يُوافونَ البَنِيَّةَ كُلَّ عامٍ","لِيُلقوا المُخزِياتِ عَلى قُراها",25,"ا",3,0],["يوافيكَ من ربّ العُلى الصّدقُ بالرّضَى","بَشيراً وتلقاكَ الأمانَةُ بالأمْنِ",26,"ن",1,0],["يُواصلُني على الهِجْرَانِ مِنْهُ","وَيُدْنِيني على طُولِ البعادِ",27,"د",1,0],["يُوَافُونَهُمْ بَغَتَاتِ اللُّصُو","صِ وَيَرْمُونَ بِالنَّارِ وَالْجَلْمَدِ",28,"د",1,0],["يوالي ، فيرفض نصف الولاء","ويبدي العداوات، جلوى صريحه",29,"ح",2,0],["يُوَاصِلُ مَسْعَاهُ لِيَخْدُم سيِّدَا","وَيُوسِعُهُ رِزْقاً وَيُغذى مِنَ الثِّفْلِ",30,"ل",1,0],["يُواصل ساعَةً وَيَصُدُّ دَهراً","فَما نَعماؤُهُ إِلّا اِنتِقام",31,"م",1,0],["يؤالفهم من كان في الرأي محسبا","وياباهم من كان خِبّاً ملعثما",32,"م",2,0],["يوافين سراًّ والسحابُ برعدها","تبوح بما توليه إن أرسلتْ قَطرا",33,"ر",2,0],["يواعدني المنى منكم وعوداً","فاقطع أنها الحق اليقين",34,"ن",1,0],["يواصله الفتى حينا وحينا","يرى منه الصدود بلا احتشام",35,"م",1,0],["يَواجِهُنا شَفّانُها فَكَأَنَّما","تَمسُّ الوُجوه بِالأَكُفِّ الشَرائِثِ",36,"ث",1,0],["يؤانسني ذكراه في كلِّ خلوةٍ","بلى منه إن غاب الجليس جليسُ",37,"س",1,0],["يُؤانِسُني في غُربتي عند كُرْبَتي","وتُعْجِبُني أبوابُه والمَسائِلُ",38,"ل",1,0],["يواصلني والليل ينشر وفره","وليس يرى الواشون للسعي منهجا",39,"ج",2,0],["يواصلني ساجي اللواحظِ أهيفٌ","بساخف مع تلك الأثيلات والرِّمث",40,"ث",1,1],["يُوَاصِلُنِي حَتَّى أَفِيقَ مِنَ الْجَوَى","وَيَهْجُرُنِي حَتَّى أَغَصَّ بِرِيقِ",41,"ق",1,0],["يُؤامِرُ نفسيهِ أَعينَ غُمازَةٍ","يُغَلِّسُ أَم حَيثُ النِباجُ وَثَيتَلُ",42,"ل",1,0],["يوافقني في كل ما اقتضى به","من الدهر والموت الزؤام يوافقه",43,"ق",2,0],["يواعدني العدوّ بغير جرم","أَتَعجَز أَن يحل به الوَعيد",44,"د",1,0],["يواصلُني بدرٌ إذا تمَّ ضوؤه","يواريه من ليل الذَوائب فاحمُه",45,"م",2,0],["يُوازِرُهُ في كُلِّ أَمرٍ يَرومُهُ","وَيَحفَظُهُ في المالِ وَالنَفسِ وَالأَهلِ",46,"ل",1,0],["يُوافيكُم لم يرجُ إلّا زيارةً","فَتُرخي النوى مِن دونِ مقصدِه سترا",47,"ر",2,0],["يُواصِلُ قلبي وهْو للعين هاجِرٌ","لَصيقُ فؤادٍ شَطَّ منه مَزار",48,"ر",1,0],["يُواجِهُ زُوّارَهُ","بِمبتَسمٍ باسِمِ",49,"م",1,0],["يواصِلُني إحسانُه حينَ نلتَقي","ويُتبِعُني طيَّ القراطيسِ مُرسَلا",50,"ل",2,0],["يوافيها ولا يَخ","رُجُ منها ترب الصدرِ",51,"ر",1,0],["يوارب الواصف بالتفويف","معبراً به عن التأفيف",52,"ف",1,0],["يواصله أهل القراءة والقرى","فيقرى على كل المعالي من يقري",53,"ر",2,0],["يُوارِي إساءَاتي ويُبدِي محاسِنِي","ويحفَظُ غَيبي في مغيبي ومَحضَرِي",54,"ر",2,0],["يواعدُني بالوَصْلِ منهُ ويُخْلِفُ","ويُقْسِمُ بالله العظيم ويَحْلِفُ",55,"ف",1,1],["يواصلُ شُرْبَ كأسِ البأسِ صِرْفاً","ويجتنبُ المُدامةَ والرّضابا",56,"ب",2,0],["يواصلون السرى بالسير لا فرق","يعروهم بنوا حيها ولا هلَعُ",57,"ع",1,0],["يوازنون إذا قالوا... وإن حكمو","فبالعدالة لا بالزور والتهم",58,"م",1,0],["يوافيك عن قلب أكيد وداده","وثيق عُرَى الإِخلاص لم يُلْفَ قُلَّبا",59,"ب",2,0],["يوافيك من أرجاء دارَين مهدياً","إِليك على متن الصبا طيّبَ النَشْرِ",60,"ر",1,0],["يواقيت بحمرتها أضاءت","فمن مثلي بميراثي الغنيّ",61,"ي",1,0],["يواصلني سماحُ يديك منها","بأوسعِ ما تجود به يدانِ",62,"ن",1,0],["يواثب من ظَهْر الوزارة رَيِّضاً","زلوقاً وقد أعيَا الرجالَ ركُوبُها",63,"ب",3,0],["يُؤانس من وحشيِّهمويُبيحهُمْ","نَداه ويُصغي للعَييِّ المُجمْجِم",64,"م",1,0],["يواصلني طيفاً ولا علمَ عنده","ويهجرني في يقظةٍ وعلى علم",65,"م",1,0],["يوافيه ضوء الصبح من فيه ناصراً","على أن ليل الشعر لليل خاذل",66,"ل",1,0],["يُؤانِسُ مَن ظَلَّ مُستَوحِشاً","إِذا اِختَلَسَ الصَحوُ مِنهُ الكَرى",67,"ر",2,0],["يواصل فيها ليله بنهاره","بفكر مصيب في دروسه راشق",68,"ق",1,0],["يواقيت أوقات لهم ما تماطلت","عن السير بل تفتض سر مثان",69,"ن",1,