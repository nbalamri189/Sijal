ttps://www.aldiwan.net/poem37565.html","الكامل"],[501,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[501,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[501,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[507,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[530,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[530,"يجب حذف متعلقات الظروف","https://www.aldiwan.net/poem37306.html","المتقارب"],[539,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[552,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[552,"رب كن لي منها لباسا حصينا","https://www.aldiwan.net/poem47226.html","الخفيف"],[552,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[552,"ظننتم محل الأمر فيكم وعندكم","https://www.aldiwan.net/poem47807.html","الطويل"],[567,"هل للفتى من بنات الدهر من واق","https://www.aldiwan.net/poem1928.html","البسيط"],[568,"كأنما النارنج لما بدت","https://www.aldiwan.net/poem69661.html","السريع"],[576,"أصبحت للدنيا الدنية","https://www.aldiwan.net/poem2753.html","مجزوء الكامل"],[576,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"]],"verses":[["وَرَفَّعنَ أَطرافَ السُجوفِ فَصَرَّحَت","عَنِ الوَجدِ أَدواءُ القُلوبِ الكَواتِمِ",0,"م",1,0],["وَرَفَعتَ ناظِرَهُ إِلَيكَ مُسَلِّماً","في أَيِّ أُبَّهَةٍ وَأَيِّ مَقامِ",1,"م",1,0],["وَرَفضَةٍ مِن سَوادِ اللَيلِ مُطمِعَةٍ","كانَ المَشيبُ إِلَيها رائِدَ الأَجَلِ",2,"ل",1,0],["وَرَفَعْتَ مِنْ شَأنِي فَزَادَكَ مَنْ قَضَى","لَكَ بِالْعُلَى وَالْعِزِّ رِفْعَةَ شَأنِي",3,"ن",2,0],["وَرَفَّتْ عَلَيْهَا نِسْبَةٌ طَالِبِيَّةٌ","فَلَيْسَ ظَلاَمٌ فِي الْوُجُودِ وَلاَ ظُلْمُ",4,"م",1,0],["وَرِفْدُكَ مَوْهُوبٌ وَعَزْمُكَ نَافِذٌ","وَبَأْسُكَ مَرْهُوبٌ وَسَهْمُكَ صَائِبُ",5,"ب",1,0],["وَرَفَعتِ رَأسَكِ عِندَ مُفتَخَرِ النُهى","بَينَ المَمالِكِ حَيثُ تُحنى الهامُ",6,"م",1,0],["وَرَفَعتَ في ثَغرِ الثُغو","رِ لِمُنشَآتِ البَحرِ بَندا",7,"د",2,0],["وَرَفَعتَ لِلدينِ الحَنيفِ مَنارَهُ","فَعَلا وَكُنتَ بِنَصرِهِ مُتَكَفِّلا",8,"ل",2,0],["وَرِفقَةٌ حارَ حاديهِم بِمُهلِكَةٍ","كَأَنَّ ظُلمَتَها في الطِخيَةِ القارُ",9,"ر",1,0],["ورفاقه الصيابة النجب الأولى","لم يذخروا غرماً ولا مجهودا",10,"د",2,0],["وَرَفَعْتِ شَأْنَ الغَانِيا","تِ الحَانِيَاتِ عَلَى العِيَالْ",11,"ل",1,0],["وَرَفرَفَت لَلزُبانى مِن بَوارِحِها","هَيفٌ أَنَشَّت بِها الأَصناعَ وَالخَبِرا",12,"ر",2,0],["وَرَفَّعنَ رَقماً فَوقَ صُهبٍ كَسَونَهُ","قَنا الساجِ فيه الآنِساتُ الخَرائِدُ",13,"د",1,0],["ورفعت فيها القلبَ بنداً خافقاً","وأريت للعشاق فضلَ تهمّمي",14,"م",2,0],["ورفقة أحزانِي بينهم","إخماِد ذهني أيّ إخماد",15,"د",1,0],["ورفعت للوفد الدّخان من القرى","ولقيت ذنبَ المخطئين بغافر",16,"ر",1,0],["ورفعت في أفق العلى أزماننا","يا تاجه رأساً على الأزمان",17,"ن",1,0],["ورَفَضْتَ التجارةَ الجمَّة الرِّب","حِ وما في مِراسها من جَداءِ",18,"ا",2,0],["ورفيفُ السواد كالرّشق بالنَّبْ","ل ولوحُ البياض كالإنباض",19,"ض",1,0],["ورفدت فيه كل أشعثَ بائسٍ","ما زال عن طلباته مدفوعا",20,"ع",2,0],["ورفأتم فيه للمل","كة والدولة خرقا",21,"ق",2,0],["ورفضي النوم إلا أن تراني","أعانق واسط الكور اعتناقا",22,"ق",2,0],["ورفّلْني ونفّلْني فعندي","ثناءٌ فيك مِرقالٌ ذَمُولُ",23,"ل",1,0],["ورفَّعتُ رأساً به خشعةٌ","وأثقبتُ للدهرِ طرْفاً كليلا",24,"ل",2,0],["ورفْعُ نفسي عن استماحته","ببذلِ وجهي له وإعظامي",25,"م",2,0],["وَرَفَعتُ راحِلَةً كَأَنَّ ضُلوعَها","مِن نَصِّ راكِبِها سَقائِفُ عَرعرِ",26,"ر",1,0],["وَرَفَعتُ صَوتي قائِلاً يا يوسُفٌ","فَأَجابَني مَلِكٌ أَطالَ وَأَجزَلا",27,"ل",2,0],["ورَفْرَفَ الأَلمُ الدَّامي بأجنحةٍ","مِنَ اللَّهيبِ وأَنَّ الحُزْنُ والنَّدَمُ",28,"م",1,0],["ورَفْرَفَ روحٌ غريبُ الجمال","بأَجنحةٍ من ضياءِ القَمَرْ",29,"ر",1,0],["وَرَفَعت كَفّاً وَشا","لَت ذَنَباً كَالمِذرَةِ",30,"ه",1,0],["وَرَفّافُ رَيحانٍ يَروحُ وَيَغتَدي","عَلى طَيِّباتٍ في الخِلالِ رِطابِ",31,"ب",1,0],["وَرَفيعٍ لَم يُسَوِّدهُ أَبٌ","مَن أَبو الشَمسِ وَمَن جَدُّ القَمَر",32,"ر",1,0],["وَرَفَلتَ في حُلَلِ الثَناءِ وَإِنَّما","عَدَمُ الثَناءِ نِهايَةُ الإِعدامِ",33,"م",1,0],["ورفيفُ أجنحةِ السرور تحُثُّها","برفيفِ أسرابٍ من العقبانِ",34,"ن",1,0],["ورفعتَ ذكري بعد طُولِ خمولهِ","فكأنني عَلَمٌ عليهِ نارُ",35,"ر",1,0],["وَرَفَعتُ مِن نَظَري إِلى أَهلِ الحِجى","وَلَوَيتُ عَن أَهلِ الغَوايَةِ راسي",36,"س",2,0],["وَرَفيقٍ رافَقتُهُ في طَريقٍ","صارَ بَعدَ الطَريقِ خَيرَ رَفيقِ",37,"ق",1,0],["وَرَفَضتُ لَذّاتَ الحَياةِ وَطيبَها","مِن مَلبَسٍ أَو مَطعَمٍ أَو مالِ",38,"ل",1,0],["ورَفَعَتْ ظلماؤه السُّجوفا","والكأسُ قد سارَتْ بنا الوَجيفا",39,"ف",2,0],["ورفَّعْتَ القِبابَ ضُحىً فقُلنا","أَزُهْرٌ ما تضمَّنَتِ القِبابُ",40,"ب",1,0],["وَرَفَعتَ قَدري في الأَنامِ وَقَد رَأَوا","مِثلي لِمِثلِكَ خاطِباً وَمُخَطِبا",41,"ب",2,0],["وَرَفع إِلَيهِ كلُّ عِيسٍ تَيَمّمَتْ","مَعالمَهُ بِعدَ اعتِسافِ المَجاهِلِ",42,"ل",1,0],["ورفعَ عقيراتِ المدائحِ والعُلى","تَصيخُ إلى شعرٍ تَكلَّمَ بالسِّحرِ",43,"ر",1,0],["وَرَفيقَةِ اللَحَظاتِ يُعقِبُ رِفقُها","بَطشاً بِمُغتَرِّ القُلوبِ عَنيفا",44,"ف",2,0],["وَرَفَّعتَ طَرفاً كانَ لَولاكَ خاشِعاً","وَأَورَدتَ ذَودَ العِزِّ في أَوَّلِ الوِردِ",45,"د",1,0],["وَرَفَعتُ كَفّي بَينَ طَرفٍ خاشِعٍ","تَندى مَآقيهِ وَبَينَ دُعاءِ",46,"ا",2,0],["وَرَفَلتُ في خُلَعٍ عَلَيَّ مِن الدُجى","عُقِدَت لَها مِن أَنجُمٍ أَزرارُ",47,"ر",1,0],["وَرَفَلتُ بَينَ قَميصِ غَيمٍ هَلهَلٍ","وَرِداءِ شَمسٍ قَد تَمَزَّقَ أَصفَرا",48,"ر",2,0],["ورفعتَ للأصنامِ فيه لواءها","وهيَ التي تركتْ لِواءكَ هاويا",49,"ي",2,0],["وَرَفَعتُ ساقاً لايُخافُ عِثارُها","وَطَرَحتُ عَنّي بِالعَراءِ ثِيابي",50,"ب",2,0],["وَرَفَعَ الريحانَ وَالنَبيذا","وَزالَ عَنّا عَيشَنا الَّذيذا",51,"ذ",2,0],["وَرَفَلتُ في قُمصِ الحَدي","دِ وَما أَرى في اللَيلِ ضَوّا",52,"و",2,0],["وَرِفاقي وَغَفلَةٌ","لَيسَ يَدرَونَ مَن يَلي",53,"ل",2,0],["ورِفاقِي فِي خِدْمَةٍ طُولَ عُمْرِي","رِفْقَتي في الحِرانِ مثْلُ الحَميرِ",54,"ر",1,0],["وَرَفَعتَ عَامَ الفِيلِ عَنهُم فِتنَةً","أَلْفَيْتَ فيها التابِعينَ الفِيلا",55,"ل",2,0],["ورفعوا الأيدي والسواعدا","مبتهلين راكعاً وساجدا",56,"د",2,0]