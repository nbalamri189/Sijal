{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[77,"لما رأيت الأرض دونك قدرها","https://www.aldiwan.net/poem36068.html","الكامل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[86,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[86,"أرأيت رب التاج في","https://www.aldiwan.net/poem68886.html","مجزوء الكامل"],[71,"جعل العتاب إلى الصدود توصلا","https://www.aldiwan.net/poem4030.html","الكامل"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[93,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[93,"هذي الرزيئة فيك","https://www.aldiwan.net/poem11471.html","مجزوء الكامل"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[30,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"خدمتك من فلك الثناء الدائر","https://www.aldiwan.net/poem18714.html","الكامل"],[72,"يثني عليك لسان حالي في الورى","https://www.aldiwan.net/poem20308.html","الكامل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[51,"أبعد لقاي دونك كل قفر","https://www.aldiwan.net/poem65501.html","الوافر"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[51,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[51,"إني إذا ما الصديق أكرمني","https://www.aldiwan.net/poem66027.html","المنسرح"],[16,"وأخي محافظة طليق وجهه","https://www.aldiwan.net/poem27689.html","الكامل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[92,"يا قلب كم فيك من دنا محجبة","https://www.aldiwan.net/poem38914.html","البسيط"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[43,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[45,"ناهيك من حرق أبيت أقاسي","https://www.aldiwan.net/poem64589.html","الطويل"],[45,"كم صديق عرفته بصديق","https://www.aldiwan.net/poem65207.html","الخفيف"],[45,"ريح الشمال أتت بريح شمال","https://www.aldiwan.net/poem65636.html","الكامل"],[61,"عندي ضيف لم يزل مضيفا","https://www.aldiwan.net/poem51556.html","الرجز"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[74,"ومفازة لانجم في ظلمائها","https://www.aldiwan.net/poem12914.html","الكامل"],[74,"ندى النسيم فما أرق وأعطرا","https://www.aldiwan.net/poem12919.html","الكامل"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[13,"لما رأيت بني نفاثة أقبلوا","https://www.aldiwan.net/poem2191.html","الكامل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[52,"أف من وصف منزل","https://www.aldiwan.net/poem26729.html","مجزوء الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[48,"أيري لا يعدمني عرابدا","https://www.aldiwan.net/poem66258.html","الرجز"],[50,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[50,"ومريضة مرض الهوى","https://www.aldiwan.net/poem64862.html","مجزوء الكامل"],[46,"إذا ما شئتم دعة وخفضا","https://www.aldiwan.net/poem23487.html","الوافر"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55047","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54729","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54890","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67347","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141975","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9487","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54225","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[77,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""]],"verses":[["وَرَفَّعنَ أَطرافَ السُجوفِ فَصَرَّحَت","عَنِ الوَجدِ أَدواءُ القُلوبِ الكَواتِمِ",0,"م",1,0],["وَرَفَعتَ ناظِرَهُ إِلَيكَ مُسَلِّماً","في أَيِّ أُبَّهَةٍ وَأَيِّ مَقامِ",1,"م",1,0],["وَرَفضَةٍ مِن سَوادِ اللَيلِ مُطمِعَةٍ","كانَ المَشيبُ إِلَيها رائِدَ الأَجَلِ",2,"ل",1,0],["وَرَفَعْتَ مِنْ شَأنِي فَزَادَكَ مَنْ قَضَى","لَكَ بِالْعُلَى وَالْعِزِّ رِفْعَةَ شَأنِي",3,"ي",1,0],["وَرَفَّتْ عَلَيْهَا نِسْبَةٌ طَالِبِيَّةٌ","فَلَيْسَ ظَلاَمٌ فِي الْوُجُودِ وَلاَ ظُلْمُ",4,"م",1,0],["وَرِفْدُكَ مَوْهُوبٌ وَعَزْمُكَ نَافِذٌ","وَبَأْسُكَ مَرْهُوبٌ وَسَهْمُكَ صَائِبُ",5,"ب",1,0],["وَرَفَعتِ رَأسَكِ عِندَ مُفتَخَرِ النُهى","بَينَ المَمالِكِ حَيثُ تُحنى الهامُ",6,"م",1,0],["وَرَفَعتَ في ثَغرِ الثُغو","رِ لِمُنشَآتِ البَحرِ بَندا",7,"د",2,0],["وَرَفَعتَ لِلدينِ الحَنيفِ مَنارَهُ","فَعَلا وَكُنتَ بِنَصرِهِ مُتَكَفِّلا",8,"ل",2,0],["وَرِفقَةٌ حارَ حاديهِم بِمُهلِكَةٍ","كَأَنَّ ظُلمَتَها في الطِخيَةِ القارُ",9,"ر",1,0],["ورفاقه الصيابة النجب الأولى","لم يذخروا غرماً ولا مجهودا",10,"د",2,0],["وَرَفَعْتِ شَأْنَ الغَانِيا","تِ الحَانِيَاتِ عَلَى العِيَالْ",11,"ل",1,0],["وَرَفرَفَت لَلزُبانى مِن بَوارِحِها","هَيفٌ أَنَشَّت بِها الأَصناعَ وَالخَبِرا",12,"ر",2,0],["وَرَفَّعنَ رَقماً فَوقَ صُهبٍ كَسَونَهُ","قَنا الساجِ فيه الآنِساتُ الخَرائِدُ",13,"د",1,0],["ورفعت فيها القلبَ بنداً خافقاً","وأريت للعشاق فضلَ تهمّمي",14,"م",2,0],["ورفقة أحزانِي بينهم","إخماِد ذهني أيّ إخماد",15,"د",1,0],["ورفعت للوفد الدّخان من القرى","ولقيت ذنبَ المخطئين بغافر",16,"ر",1,0],["ورفعت في أفق العلى أزماننا","يا تاجه رأساً على الأزمان",17,"ن",1,0],["ورَفَضْتَ التجارةَ الجمَّة الرِّب","حِ وما في مِراسها من جَداءِ",18,"ا",2,0],["ورفيفُ السواد كالرّشق بالنَّبْ","ل ولوحُ البياض كالإنباض",19,"ض",1,0],["ورفدت فيه كل أشعثَ بائسٍ","ما زال عن طلباته مدفوعا",20,"ع",2,0],["ورفأتم فيه للمل","كة والدولة خرقا",21,"ق",2,0],["ورفضي النوم إلا أن تراني","أعانق واسط الكور اعتناقا",22,"ق",2,0],["ورفّلْني ونفّلْني فعندي","ثناءٌ فيك مِرقالٌ ذَمُولُ",23,"ل",1,0],["ورفَّعتُ رأساً به خشعةٌ","وأثقبتُ للدهرِ طرْفاً كليلا",24,"ل",2,0],["ورفْعُ نفسي عن استماحته","ببذلِ وجهي له وإعظامي",25,"م",2,0],["وَرَفَعتُ راحِلَةً كَأَنَّ ضُلوعَها","مِن نَصِّ راكِبِها سَقائِفُ عَرعرِ",26,"ر",1,0],["وَرَفَعتُ صَوتي قائِلاً يا يوسُفٌ","فَأَجابَني مَلِكٌ أَطالَ وَأَجزَلا",27,"ل",2,0],["ورَفْرَفَ الأَلمُ الدَّامي بأجنحةٍ","مِنَ اللَّهيبِ وأَنَّ الحُزْنُ والنَّدَمُ",28,"م",1,0],["ورَفْرَفَ روحٌ غريبُ الجمال","بأَجنحةٍ من ضياءِ القَمَرْ",29,"ر",1,0],["وَرَفَعت كَفّاً وَشا","لَت ذَنَباً كَالمِذرَةِ",30,"ه",1,0],["وَرَفّافُ رَيحانٍ يَروحُ وَيَغتَدي","عَلى طَيِّباتٍ في الخِلالِ رِطابِ",31,"ب",1,0],["وَرَفيعٍ لَم يُسَوِّدهُ أَبٌ","مَن أَبو الشَمسِ وَمَن جَدُّ القَمَر",32,"ر",1,0],["وَرَفَلتَ في حُلَلِ الثَناءِ وَإِنَّما","عَدَمُ الثَناءِ نِهايَةُ الإِعدامِ",33,"م",1,0],["ورفيفُ أجنحةِ السرور تحُثُّها","برفيفِ أسرابٍ من العقبانِ",34,"ن",1,0],["ورفعتَ ذكري بعد طُولِ خمولهِ","فكأنني عَلَمٌ عليهِ نارُ",35,"ر",1,0],["وَرَفَعتُ مِن نَظَري إِلى أَهلِ الحِجى","وَلَوَيتُ عَن أَهلِ الغَوايَةِ راسي",36,"س",2,0],["وَرَفيقٍ رافَقتُهُ في طَريقٍ","صارَ بَعدَ الطَريقِ خَيرَ رَفيقِ",37,"ق",1,0],["وَرَفَضتُ لَذّاتَ الحَياةِ وَطيبَها","مِن مَلبَسٍ أَو مَطعَمٍ أَو مالِ",38,"ل",1,0],["ورَفَعَتْ ظلماؤه السُّجوفا","والكأسُ قد سارَتْ بنا الوَجيفا",39,"ف",2,0],["ورفَّعْتَ القِبابَ ضُحىً فقُلنا","أَزُهْرٌ ما تضمَّنَتِ القِبابُ",40,"ب",1,0],["وَرَفَعتَ قَدري في الأَنامِ وَقَد رَأَوا","مِثلي لِمِثلِكَ خاطِباً وَمُخَطِبا",41,"ب",2,0],["وَرَفع إِلَيهِ كلُّ عِيسٍ تَيَمّمَتْ","مَعالمَهُ بِعدَ اعتِسافِ المَجاهِلِ",42,"ل",1,0],["ورفعَ عقيراتِ المدائحِ والعُلى","تَصيخُ إلى شعرٍ تَكلَّمَ بالسِّحرِ",43,"ر",1,0],["وَرَفيقَةِ اللَحَظاتِ يُعقِبُ رِفقُها","بَطشاً بِمُغتَرِّ القُلوبِ عَنيفا",44,"ف",2,0],["وَرَفَّعتَ طَرفاً كانَ لَولاكَ خاشِعاً","وَأَورَدتَ ذَودَ العِزِّ في أَوَّلِ الوِردِ",45,"د",1,0],["وَرَفَعتُ كَفّي بَينَ طَرفٍ خاشِعٍ","تَندى مَآقيهِ وَبَينَ دُعاءِ",46,"ا",2,0],["وَرَفَلتُ في خُلَعٍ عَلَيَّ مِن الدُجى","عُقِدَت لَها مِن أَنجُمٍ أَزرارُ",47,"ر",1,0],["وَرَفَلتُ بَينَ قَميصِ غَيمٍ هَلهَلٍ","وَرِداءِ شَمسٍ قَد تَمَزَّقَ أَصفَرا",48,"ر",2,0],["ورفعتَ للأصنامِ فيه لواءها","وهيَ التي تركتْ لِواءكَ هاويا",49,"ي",2,0],["وَرَفَعتُ ساقاً لايُخافُ عِثارُها","وَطَرَحتُ عَنّي بِالعَراءِ ثِيابي",50,"ي",1,0],["وَرَفَعَ الريحانَ وَالنَبيذا","وَزالَ عَنّا عَيشَنا الَّذيذا",51,"ذ",2,0],["وَرَفَلتُ في قُمصِ الحَدي","دِ وَما أَرى في اللَيلِ ضَوّا",52,"و",2,0],["وَرِفاقي وَغَفلَةٌ","لَيسَ يَدرَونَ مَن يَلي",53,"ل",2,0],["ورِفاقِي فِي خِدْمَةٍ طُولَ عُمْرِي","رِفْقَتي في الحِرانِ مثْلُ الحَميرِ",54,"ر",1,0],["وَرَفَعتَ عَامَ الفِيلِ عَنهُم فِتنَةً","أَلْفَيْتَ فيها التابِعينَ الفِيلا",55,"ل",2,0],["ورفعوا الأيدي والسواعدا","مبتهلين راكعاً وساجدا",56,"د",2,0],["وَرَفَّ الهَمُّ يَبريني","وَيَدعوني الهَوى بُكرَه",57,"ر",2,0],["وَرَفَعتُ عِندَ جَوابِها","صَوتي وَقَد سَكَتَ المُريب",58,"ب",1,0],["وَرِفقاً بِالأَصاغِرِ كَي يَقولوا","غَدَونا بِالجَميلِ مُعامِلينا",59,"ن",2,0],["وَرَفّتْنَ مَجْدولَ الشّكيمِ كأنّما","أشَرْنا إلى ذاوٍ من النّبْتِ بالأَزْمِ",60,"م",1,0],["ورفَّتْ على الأرض حُريَّةٌ","تألَّقُ نوراً وتَنْدى ظلالا",61,"ل",2,0],["ورفَّ عليكِ مثل الحلْ","مِ أو إشراقةِ المعنى",62,"ن",2,0],["ورفعتُ رأسي للسماءِ وخِلتُني","أتناولُ النجمَ البعيدَ وأنظمُ",63,"م",1,0],["ورُفاتٌ مُطَهَّرٌ","وكريمٌ من السِّيَرْ",64,"ر",1,0],["ورفع التاريخ أعلى منزله","بنصه في كتْبه المنزلة",65,"ه",1,0],["ورفق الغالبُ بالمغلوب","فكان أيضا فاتحَ القلوبِ",66,"ب",1,0],["وَرَفَعْتَ فِي لُبْنَانَ رَايَةَ فِتْيَةٍ","مِنْ قوْمِهِ فِي كُلِّ شوْطٍ أَسْبَقِ",67,"ق",1,0],["وَرفَعْتَها لِلعَالَمِينَ منَارَةً","تعْتَادُهُمْ بِشَعَاعِهَا السَّيَّارِ",68,"ر",1,0],