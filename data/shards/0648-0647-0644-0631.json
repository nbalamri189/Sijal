{"poems":[[95,"حجك أرضى ربك العليا","https://www.aldiwan.net/poem11101.html","الرجز"],[49,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[87,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[45,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[82,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[35,"بربك هل ضممت إليك ليلى","https://www.aldiwan.net/poem25760.html","الوافر"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[48,"إذا لم يكن للميت أهل فقلما","https://www.aldiwan.net/poem23364.html","الطويل"],[15,"وهل رام عن عهدي وديك مكانه","https://www.aldiwan.net/poem45270.html","الطويل"],[70,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85384","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10683","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[136,"بالسب من يدعى ما ليس فيه حر","https://www.aldiwan.net/poem54822.html","البسيط"],[186,"قف بي نحي رباها أيها الحادي","https://www.aldiwan.net/poem61045.html","البسيط"],[266,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[303,"ذر العين تقض اليوم بعضض ديونها","https://www.aldiwan.net/poem36325.html","عموديه"],[309,"يا آخذا مني بأذيالي","https://www.aldiwan.net/poem16757.html","السريع"],[358,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[361,"ألمت بنا أهلا وسهلا","https://www.aldiwan.net/poem24532.html","الطويل"],[366,"هي الليالي فلا تغتر بالامل","https://www.aldiwan.net/poem68072.html","البسيط"],[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[409,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[447,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[463,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[463,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[463,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[463,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[463,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[466,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[482,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[505,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[519,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62561","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107192","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78168","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78028","الوافر"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122079","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128701","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127967","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49595","الطويل"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110317","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53217","المتقارب"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77290","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106991","الطويل"],[2517,"","https://poetry.dctabudhabi.ae/diwan/poem/99900","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105673","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137356",""],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115532","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74172","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104394","السريع"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103907","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138561",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91085","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91299","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85064","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123528","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131017",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131266",""],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103577","الطويل"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113703","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77177","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4266,"","https://poetry.dctabudhabi.ae/diwan/poem/102032","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105512","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136612",""],[185,"أميم منك الدار غيرها البلى","https://www.poetsgate.com/ViewPoem.aspx?id=186042",""],[5038,"تسائلني","https://www.poetsgate.com/ViewPoem.aspx?id=189580",""],[5041,"إلى عزيزٍ لهُ في مُهْجَتي نُزُلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24396",""],[585,"رويداً فحرب المرجفين سجال","https://www.poetsgate.com/ViewPoem.aspx?id=161916",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5300,"ذكرت فراقا والتفرّق يصدع","https://www.poetsgate.com/ViewPoem.aspx?id=200452",""],[5401,"شمعة الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=78670",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""]],"verses":[["وَهَل رَأَيْتِ مُسْتَضاماً معُوزا","وَلَمْ تَكونِي المُنْصِفَ الكَفِيَّا",0,"ي",2,0],["وَهَل رَأَيتِ أَمامَ الحَيِّ جارِيَةً","كَالجُؤذَرِ الفَردِ تَقفوهُ جَآذِرُهُ",1,"ر",2,0],["وهل راقم في صفحةِ الماء عائد","ليقرأ ما قد خطَّ إلا وقد طسمْ",2,"م",1,0],["وَهَل رَفَعَ الداءَ العُضالَ وَزيرُهُ","وَهَل حَجَبَ البابَ المُمَنَّعَ حاجِبُه",3,"ب",2,0],["وَهَل رَدَّ عَنهُ بِاللُقانِ وُقوفُهُ","صُدورَ العَوالي وَالمُطَهَّمَةَ القُبّا",4,"ب",2,0],["وهل رحتُ إلا طالباً بالنوى عُلاً","كأنّي منها للنّجوم مُسامِ",5,"م",1,0],["وَهَل رَفَّت عَلَيكَ قُرونُ لَيلى","رَفيفَ الأُقحُوانَةِ في نَداها",6,"ا",3,0],["وَهَل رِضا إِلّا أَبو العَبّاسِ","الواسِعُ الحِلمِ الشَديدُ الباسِ",7,"س",1,0],["وَهَل رَدَّ حَيّاً مالِكَ اِبنَ نُوَيرَةٍ","نَكيرُ عَلِيٍّ أَو بُكاءُ مُتَمَّمِ",8,"م",1,0],["وَهَل رامَ عَن عَهدي وَدَيكٌ مَكانَهُ","إِلى حَيثُ يُفضي سَيلُ ذاتِ المَساجِدِ",9,"د",1,1],["وهل رَقَصَت بالمأزِمَين قلائصٌ","وهل للقِباب البيضِ فيها تَدَافُع",10,"ع",1,0],["وهل رَضَعَت من ثَدي زمزَم رَضْعَةً","فلا حُرّمت يوماً عليها المراضع",10,"ع",1,0],["وَهَل راحة في بلدة نصف أَهلها","عَلى نصفه الثاني عيون تطلَّع",11,"ع",1,0],["وَهَل ريبَةٌ في أَن تَحِنَّ نَجيبَةٌ","إِلى إِلفِها أَو أَن يَحِنَّ نَجيبُ",12,"ب",1,0],["وَهَلْ رَجَعَتْ شَمْسُ الحَضَارَةِ بَعْدَمَا","طوَتْهَا دُهُورٌ فِي غَيَاهِبِ حِنْدِسِ",13,"س",1,0],["وهَل رياضُ الهوى ولَّت بشاشتُها","وغادرْت ضاحك النُوَّارِ غُدرانُ",14,"ن",1,0],["وهل رَأيتُم بِمَاضِى الدَّهرِ ذَا بَصَرٍ","يَقتَادُهُ في الدَّيَاجِى فَاقِدُ البَصَرِ",15,"ر",1,0],["وهل رأوا ركبنا النوريّ منطلقا","في ليلهم بين تصويب وإصعاد",16,"د",1,0],["وهل رادع للنفس عن سوء فعلها","إذا أمنت جهلاً عقاب جحيم",17,"م",1,0],["وَهل روّع البرق الرياض بضاحك","يفضض أَزهار الرياض وَيَذهَب",18,"ب",1,0],["وَهَل رنَّحت فيها الغَواني قدودها","وأَغصانُها من غيرَةٍ تتبرَّمُ",19,"م",1,0],["وَهَل رتعت أَترابُها ولِداتُها","بمرتِعها حيث المسرّةُ والغبطُ",20,"ط",1,0],["وَهلْ ريبةٌ والسر كالجهر طاهر","إذا ما صبتْ نفسٌ زكت لقرينها",21,"ن",3,0],["وهل رأت عيناك سراً به","قد خصني من بين أشكالي",22,"ل",2,0],["وَهَل ريع بِالعَضب اليَمانيّ ناظِري","وَأَنتَ خَبيرٌ أَنَّهُ اِستلَّ مِن طَرفي",23,"ف",2,0],["وهل رعت الحسناء عهدي وإن تخن","فكم من قديم خانهُ نسوةٌ قدما",24,"م",2,0],["وَهل رَأَيت أُناسا قَد علوا وَغلوا","في الفَضلِ زادوا بِما نالوا من الاجل",25,"ل",1,0],["وَهل رَعى الموت ذاعز لعزته","أَو هل خَلا أَحد دَهرا بِلا خلل",25,"ل",1,0],["وهل رأتِ الملوكُ خلالَ حُلْمٍ","نظائرَ ما تُرِينا في العِيان",26,"ن",1,0],["وهل رعوا حرمة ما بيننا","كما رعينا العهد أم أهملوا",27,"ل",3,0],["وهل رأيتم إذا ما الأصل مات وما","ت الفرع يبقى الذي فيه يكون بنا",28,"ن",2,0],["وهل ردّ مَيْتاً مسرفٌ في غرامهِ","فأُنفِقَ نفسي عنك هيِّنةَ الغُرْمِ",29,"م",1,0],["وهلْ رأيتَ والغريبُ ما ترى","واجدَ جسمٍ قلبُه منه يضِلّْ",30,"ل",1,0],["وهل رشأ بالبانتين عهدته","على ما افترقنا لِيتُه وأياطلُهْ",31,"ل",2,0],["وهل رأيت الذي نَجَّاه مجثَمُه","بعقوة الدار أو أرداه إن شحطا",32,"ط",2,0],["وهل رمتَ أسبابَ السماء لِبغيةٍ","فحلَّقتَ إلا طائراً بجَناحي",33,"ح",2,0],["وهل ربعُ غُرَّبَ في الباليا","تِ أم هل على عهدنا غُرَّبُ",34,"ب",1,0],["وهل رمت موفور المنى من ضراعةٍ","فيجْبُنَ عزمي أو يَكلَّ مَضائي",35,"ا",2,0],["وهل ريقه المعسول قهوة بابل","لذائقها أم بين جفنه بابل",36,"ل",1,0],["وهل رجَّعَتْ فوقَ الفروعِ حمائمٌ","لهنَّ على أعلى الغصونِ ترنُّمُ",37,"م",1,0],["وهل رأَيتَ التَّجلِّي","مِنْ خلفِ رَفْرَفِ حُجْبِ",38,"ب",1,0],["وهل رأَيتَ بِحانِي","مِنْ خمرَةِ الحُبِّ شُرْبي",38,"ب",2,0],["وهلْ رشفَتْ ثناياها فأمسَتْ","تحدِّثُ عن رحيقٍ مُستطابِ",39,"ب",1,0],["وهل رياضُ الرُّبا تدري شقائِقُها","في خدِّها أيُّ خال في سُويْداها",40,"ا",3,0],["وهل رأت مصر قبل اليوم دعوتها","تثير للنجدات الخرَّدَ العينا",41,"ن",2,0],["وهل رأيت أسود الغاب تقنصها","ظباء وحش بساجي الطرف وسنان",42,"ن",1,0],["وَهَل رَاعَهُ البَينُ المُشِتُّ فَدَمعُهُ","مِنَ الجَفنِ مُنهَلٌّ عَلى الخَدِّ سافِحُ",43,"ح",1,0],["وهَلْ رَاسَلَتْكِ السُّحْبُ بِالدرّ عِنْدَمَا","رَأتْ أنْعُمَ المَوْلَى أبِي عَمْرَو هلَّتِ",44,"ت",1,0],["وَهَل رَأَيت القُصور شارِعَةً","تَكُنّ مثل الدُمى مقاصرها",45,"ر",3,0],["وَهَل رأَيت القُرى الَّتي غرس ال","أَملاكُ مخضرّةً دساكرها",45,"ر",3,0],["وَهَل ريقُكَ المَعسول خَمرٌ مُعَتَق","فَمَن ذاقَهُ في الحال طابَ وَعَربَدا",46,"د",2,0],["وَهَل رفَّت عليك ذؤابتاها","رَفيف الاقحوانة في نَداها",47,"ا",1,0],["وَهَلْ رَجَعَتْ أَيْدِي الكُمَاةِ سُيُوفَهَا","وَقَرَّ الأَصَمُّ الصِّرْفُ فِي كَفِّ شَيْحَانِ",48,"ن",1,0],["وهل رام قتلي بالحمى ريم رامية","فكم بات يرعى مهجتي وهو راتع",49,"ع",1,0],["وهل روِّضت خصباً بكفٍّ عهدتُها","تنوبُ منابَ الغيث والعامُ مجدبُ",50,"ب",1,0],["وهل رقوا لصب مستهام","أطال الشوق فيهم والهياما",51,"م",2,0],["وهل راجِعٌ عيشٌ لبسناه آنفاً","كيوم يزيدٍ في بيوت بني جَرْم",52,"م",1,0],["وَهل راجِعٌ ذاكَ الشَبابُ الَّذي مَضى","فَأَرجعَ فيهِ لِلعَفافِ وَلِلطُّهر",53,"ر",1,0],["وهل رأى كسماء الشرق ناصعةً","من الرقيع أظلت مثله بلدا",54,"د",2,0],["وهل راجعته سليمى الس","لام فأدَّى تحيتها موهنا",55,"ن",2,0],["وَهَل رَكبُ مِصر لِلحَياةِ طَريقه","فَأَشدُوَ أَم حَظِّي أَنوحُ وَأَندِبُ",56,"ب",1,0],["وهل رقرقت بنت العهاد قطارها","وحاك الربيع الطلق وشي النمارق",57,"ق",1,0],["وهل رضيتْ عنيِّ قلوبٌ تركتها","علي من الشحناءِ غيرَ صِحاح",58,"ح",1,0],["وهل رق قلب سامه الخسف فانبرى","يقاد له قود الذليل المطاوع",59,"ع",1,0],["وهل رحمة يا أميرى لمن","ينادى علاك نداً خفيا",60,"ي",2,0],["وهل رأفة بفتى يومه","لديه ثلاث ليال سويا",60,"ي",2,0],["وهل رأيت في الورى من عاقل","يستبدل الأرياف بالسواحل",61,"ل",1,0],["وهل راحةٌ في ذي الحياةِ لعاقلٍ","إذا لم يكن للمرءِ من جينه مفَر",62,"ر",1,0],["وَهَل روضها يَخضر بَعد ذُبوله","وَيَهوي عَلى أَوراقه الغَيث وَالطل",63,"ل",1,0],["وهل رأيت الماء والنار في","غير محاني خدّه الناعم",64,"م",1,0],["وهل رابح إلا امرؤ متوكل","قنوع غنى النفس بادٍ وقارها",65,"ر",3,0],["وهل رات من ارؤسٍ في القنا","أو من جسوم جعلوها مغار",66,"ر",1,0],["وَهَل رَعوا ودّنا الصافي وَسالفَه","أَم ضاعَ فَاتخذوا مِن بَعدنا عِوَضا",67,"ض",2,0],["وَهَل رَضوا ما جَرى مِن جور هَجرِهمُ","وَنَحنُ لَم نَلقَ أَيام النَوى بَرَضا",67,"ض",2,0],["وَهَل رَأَيتَ فُؤادي في ربوعهمُ","يَبكي عَلَيهم وَيُبكيني كولهان",68,"ن",1,0],["وهل رقصت تلك الغصونن وباكرت","تغني عليها ساجعات الحمائم",69,"م",1,0],["وهل رأيتُم في الورَى أذَلَّ من","مُعذَّبٍ تلْهو به أيْدِي الهَوى",70,"ا",1,0],["وهل رسموا بالشمس للجسم صورة","وهل عرفوا ما تحتوي الشمس والبدر",71,"ر",1,0],["وهل رجلٌ إلا الذي قيل إنه","على الخفرات المحصنات غيورُ",72,"ر",1,0],["وهل ريء من قبلي غريق مدامعٍ","يفيض بعينيه الحيا وهو حرّان",73,"ن",1,0],["وهل ربوة الأنس التي شاع ذكرها","تجول بها الأنهارُ وهي جِمامُ",74,"م",1,0],["وَهَل رُعتَ ظَبياتِ الحَي مِن طَرَب","خَميلَة الطَلح ذاتِ البانِ وَالغارِ",75,"ر",1,0],["وهل رغبت عن ودّ ودّان أو لوت","لغير اللوى عند المسير لواها",76,"ا",3,0],["وهل ريقها يا صاح كالخمر مسكر","فعهدي به قدما وما ذقته اسفنط",77,"ط",1,0],["وهل ردنها والذيل مهما تفاوحا","يضوعان عطرا دونه المسك والقسط",77,"ط",1,0],["وهل رضيت عن سفك آل أمية","دماها بإجراء الدموع السواجم",78,"م",1,0],["وهل راجع لي عصر الشباب","وليس لعصر تولى رجوع",79,"ع",1,0],["وهل رَمقت عين الرقيب عذاره","وهل نصبت للعاشقين حَبائلا",80,"ل",2,0],["وهل ريبةٌ في أن تحن نجيبةٌ","إلى إلفها أو يحن نجيب",81,"ب",1,0],["وَهَلْ رَنّتْ كُؤوسي في اللّيالي","لِبَدْرٍ في سَما رَوعي غَزاها",82,"ا",3,0],["وهلْ رَأَيْتَ هَوى الزَّوْراءِ مُنْكَسِرًا","والماجِداتِ بدمع العين تَغْتَسِلُ؟",83,"ل",1,0],["وهل رجلٌ إلا وفي ثني برده","تخبأ طفلٌ منه فيه خصال",84,"ل",1,0],["وهلَّ ربيعُها أُنساً وطيباً","وفي أَرْجائها انْتَشَرَ الوِئامُ",85,"م",1,0],["وهل رجل أبصرته متوجّعا","على امرأة أوعينه الدهر تدمع",86,"ع",1,0],["(وهل رأى الحب سكارى مثلنا )","أم طال صومينا كما قال لبيد",87,"د",1,0],["وهل روت لك ورقاء حديث هوى","تسلسلت منه أشجان وأحزان",88,"ن",1,0]]}