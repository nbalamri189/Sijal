{"poems":[[72,"خلني بالطلا أمد حياتي","https://www.aldiwan.net/poem19394.html","الخفيف"],[91,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[70,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[92,"قد سكرنا بحبنا واكتفينا","https://www.aldiwan.net/poem38928.html","الخفيف"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[97,"يا حنانا كيد الآسي الرؤوم","https://www.aldiwan.net/poem24775.html","الرمل"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[105,"من ينم عن لهذم أو مخذم","https://www.aldiwan.net/poem44193.html","الرمل"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[48,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[46,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43769","الرمل"],[106,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[106,"ديك غير وديك","https://www.poetsgate.com/ViewPoem.aspx?id=179736",""],[67,"حَيَّ بُلْبَيْسَ مَنْزِلاً في العِمارهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14533",""],[113,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[118,"نعد أنفاسه ونحسبها","https://www.aldiwan.net/poem49369.html","المنسرح"],[140,"وليلة قد نسجت ريحها","https://www.aldiwan.net/poem58329.html","السريع"],[208,"خلني يا خلي وفرط بلائي","https://www.aldiwan.net/poem13509.html","الخفيف"],[248,"خلني من ملامة اللوام","https://www.aldiwan.net/poem15034.html","الخفيف"],[252,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[259,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[259,"أيظن بي أني رنا أو مالا","https://www.aldiwan.net/poem38210.html","الكامل"],[295,"كوكب الصبح قد بدا يحكيك","https://www.aldiwan.net/poem33199.html","الخفيف"],[303,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[374,"قم بنا يا أخا المودة صبحا","https://www.aldiwan.net/poem66889.html","الخفيف"],[413,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[413,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[434,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[498,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[498,"قل لهذا الليل مهما شئت طل","https://www.aldiwan.net/poem37941.html","الرمل"],[513,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[549,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[556,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"]],"verses":[["خلّني بالطَّلا أمدُّ حياتي","يا عذولي وكن عليها صديق",0,"ق",1,1],["خِلنا الهَوى تَرجِعُ أَيّامُهُ","لَم يَرجِعِ الحُبُّ وَلا المالُ دام",1,"م",1,0],["خَلِّني مِن تَصَنُّعٍ","لِلوَرى أَو تَزَيُّنِ",2,"ن",1,0],["خَلِّنا منكَ فالرَّبيعُ لنا ساقٍ","وهذا الفضاءُ كأسٌ وخمرُ",3,"ر",1,0],["خِلنا الجِبالَ تَسيرُ فيهِ وَقَد غَدَت","عُدَداً يَسيرُ بِها العَديدُ الأَكثَرُ",4,"ر",1,0],["خلِّني بالشوقِ أستدني غداً","فغداً عندي كآبادٍ طوالِ",5,"ل",1,0],["خلّني أُفْنِ شَبابي مَرَحاً","لا يُرَدّ المهرُ عن طَبْع المراح",6,"ح",1,0],["خَلِّني واذهَبْ إلى القومِ الأُلى","قذفونا بالرّعيلِ المُقْدِمِ",7,"م",1,0],["خَلِّنِي مِنْ هَوَى البَداوةِ إني","لَسْتُ أَهْوَى إِلَّا جَمالَ الحَضارَهْ",8,"ر",2,0],["خِلنا الظَليمَ بَعيراً عِندَ نَهضَتِنا","وَالتَلَّ مُنبَطِحاً في قَدِّ ثَهلانِ",9,"ن",1,0],["خَلِّني يا أَخيَّ أَستَغفِرُ اللَ","هَ فَلَم يَبقَ فِيَّ إِلّا الذَماءُ",10,"م",3,0],["خِلْنَا مَكَانَتَكَ السَّنِيَّةَ مَأْمَناً","مَنْ بَلَّغَ الأَدْوَاءَ هَتِيك الذُّرَى",11,"ر",2,0],["خلّني في رأسِ رَأسٍ","إِنَّني لَم أَرضَ أَرضا",12,"ض",2,0],["خلْنا جنادَله الصَّمَّاءَ أَلْسنَةً","تَشْدُو بذكرك في سِرٍّ وإعلانِ",13,"ن",1,0],["خِلناه في الأطباق رس","مًا بالمداد، وبالقلم",14,"م",1,0],["خَلِّني مِنْ هَوَى البَداوة ِ إني","لست أهوى إلا جالَ الحضاره",15,"ر",2,0],["خلني خل من صدودك وارحم","لي عينا اضرعا عيناكا",16,"ك",2,0],["خلناه قد مات وهو في سنة","ونائم الجفن وهو مخترم",17,"م",1,0],["خلنا بها الأرضَ سماءً وقد","أُطلعَ فيها أنجمُ النرجسِ",18,"س",1,0],["خلني يا خلي وفرط بلائي","أمزج الدمع بعدهم بالدماء",19,"ا",2,1],["خَلِّني من ملامةِ اللُّوَّامِ","وأَدر في الدُّجَى كئوسَ المُدَامِ",20,"م",1,1],["خلّني دَهراً أسيراً","عن سَراحٍ، لا تَسَلْني",21,"ن",2,0],["خلني من قبول عذلك عنها","أنت خلي من المحبة خلو",22,"و",1,0],["خلنا به الظلماء خاضب لحية","حان النصول لصبغها أو حالا",23,"ل",2,0],["خلِّني وَالمُدام في شُغُلٍ","واِشتغِل أَنتَ بالَّذي يَعنيك",24,"ك",1,0],["خِلنا الزمانَ لَنا اِستدارَ فَنَحن في","خَيرِ القرونِ بحكمِ خير قرانِ",25,"ن",1,0],["خلني من حديث هندٍ ولبنى","وسليمى وزينب وتنحّا",26,"ح",2,0],["خَلِّني والهوى بآرامِ سَلْعٍ","يا خَليلي ولا عدمتُك خلاّ",27,"ل",2,0],["خَلِّنا والمطيّ نستفرغ الدم","ع لأطلالها ونذكر عهدا",28,"د",2,0],["خلّني والحبّ أو","كفّ عنّي عذلك",29,"ك",1,0],["خلن لها فَلْجاً فخلنا وقعَها","في آلِهِ وهي طوافٍ عَرَقا",30,"ق",2,0],["خلّني والزمانَ وأعلم يقيناً","أنَّ صرفَ الزمان يبلي ويبلى",31,"ل",2,0],["خَلِّنا يا صُوَيْحِبي من أُناسٍ","زَعَموا المسكَ عينَ جِسمِ الحُقوق",32,"ق",1,0],["خَلِّني منكَ ودَعْني إنَّني","سَهَري حتَّى اللِّقا من خُلُقي",33,"ي",1,0],["خلنا شعيباً والكليم تجسدت","فهما حقيقة غائب في شاهد",34,"د",1,0],["خِلنا منازِلَنا مِنها وقد نَزَعَتْ","كلَّ النُّزوع عن الأوطان أوطانا",35,"ن",2,0],["خلني في محبة المحبوب","فهي عندي نهاية المطلوب",36,"ب",1,1]]}