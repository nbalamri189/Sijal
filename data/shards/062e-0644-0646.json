,[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121278","الرمل"],[4680,"ذكرَ القلبُ سناها فوثبْ","https://www.poetsgate.com/ViewPoem.aspx?id=185093",""],[4748,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=4437",""],[4791,"الرموش الا وقوف","https://www.poetsgate.com/ViewPoem.aspx?id=36966",""],[4791,"بارق","https://www.poetsgate.com/ViewPoem.aspx?id=28410",""],[4816,"ترك الزعل","https://www.poetsgate.com/ViewPoem.aspx?id=8466",""],[4860,"إرفع الهاتف","https://www.poetsgate.com/ViewPoem.aspx?id=32392",""],[4869,"لاجل خاطرك","https://www.poetsgate.com/ViewPoem.aspx?id=151679",""],[4916,"مجروحه","https://www.poetsgate.com/ViewPoem.aspx?id=135385",""],[4984,"عاد رفاق الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=190247",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[5122,"أصبر وأصابر","https://www.poetsgate.com/ViewPoem.aspx?id=31511",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5183,"كأس الكمي","https://www.poetsgate.com/ViewPoem.aspx?id=180187",""],[5194,"سهير الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=31733",""],[5213,"أملت انشي التهاني فيك والغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=170521",""],[5370,"خلينا نتفاهم","https://www.poetsgate.com/ViewPoem.aspx?id=81641",""],[5409,"قال شيخ لو أن عصر شبابي","https://www.poetsgate.com/ViewPoem.aspx?id=155275",""],[5463,"طاري الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=33841",""],[5469,"خل نارا تشب بين ضلوعي","https://www.poetsgate.com/ViewPoem.aspx?id=169366",""],[5525,"لا تعلمني","https://www.poetsgate.com/ViewPoem.aspx?id=7190",""],[5573,"ضجيج الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=200173",""],[5573,"يا أنين السراب الهم فيني بليه","https://www.poetsgate.com/ViewPoem.aspx?id=202277",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5582,"طَرَقَ الطَّيْفُ وَقَدْ زارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186881",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[5848,"بديت اختنق","https://www.poetsgate.com/ViewPoem.aspx?id=53326",""],[5848,"الله لا يهينك","https://www.poetsgate.com/ViewPoem.aspx?id=53368",""],[5848,"محاولة قتل","https://www.poetsgate.com/ViewPoem.aspx?id=53462",""],[5950,"أصدق الكاذبين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128122",""],[5957,"بهجة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=27078",""],[6031,"قُلْ لِمَنْ يُرْجِعُ الحَوَائجَ","https://www.poetsgate.com/ViewPoem.aspx?id=46404",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""]],"verses":[["خلّني بالطَّلا أمدُّ حياتي","يا عذولي وكن عليها صديق",0,"ق",1,1],["خِلنا الهَوى تَرجِعُ أَيّامُهُ","لَم يَرجِعِ الحُبُّ وَلا المالُ دام",1,"م",1,0],["خَلِّني مِن تَصَنُّعٍ","لِلوَرى أَو تَزَيُّنِ",2,"ن",1,0],["خَلِّنا منكَ فالرَّبيعُ لنا ساقٍ","وهذا الفضاءُ كأسٌ وخمرُ",3,"ر",1,0],["خِلنا الجِبالَ تَسيرُ فيهِ وَقَد غَدَت","عُدَداً يَسيرُ بِها العَديدُ الأَكثَرُ",4,"ر",1,0],["خلِّني بالشوقِ أستدني غداً","فغداً عندي كآبادٍ طوالِ",5,"ل",1,0],["خلّني أُفْنِ شَبابي مَرَحاً","لا يُرَدّ المهرُ عن طَبْع المراح",6,"ح",1,0],["خَلِّني واذهَبْ إلى القومِ الأُلى","قذفونا بالرّعيلِ المُقْدِمِ",7,"م",1,0],["خَلِّنِي مِنْ هَوَى البَداوةِ إني","لَسْتُ أَهْوَى إِلَّا جَمالَ الحَضارَهْ",8,"ر",2,0],["خِلنا الظَليمَ بَعيراً عِندَ نَهضَتِنا","وَالتَلَّ مُنبَطِحاً في قَدِّ ثَهلانِ",9,"ن",1,0],["خَلِّني يا أَخيَّ أَستَغفِرُ اللَ","هَ فَلَم يَبقَ فِيَّ إِلّا الذَماءُ",10,"م",3,0],["خِلْنَا مَكَانَتَكَ السَّنِيَّةَ مَأْمَناً","مَنْ بَلَّغَ الأَدْوَاءَ هَتِيك الذُّرَى",11,"ر",2,0],["خلّني في رأسِ رَأسٍ","إِنَّني لَم أَرضَ أَرضا",12,"ض",2,0],["خلْنا جنادَله الصَّمَّاءَ أَلْسنَةً","تَشْدُو بذكرك في سِرٍّ وإعلانِ",13,"ن",1,0],["خِلناه في الأطباق رس","مًا بالمداد، وبالقلم",14,"م",1,0],["خل نعاماك تداجي مهجتي","فانها محروقة من الجوى",15,"ا",1,0],["خَلِّني مِنْ هَوَى البَداوة ِ إني","لست أهوى إلا جالَ الحضاره",16,"ر",2,0],["خلني خل من صدودك وارحم","لي عينا اضرعا عيناكا",17,"ك",2,0],["خلناه قد مات وهو في سنة","ونائم الجفن وهو مخترم",18,"م",1,0],["خلنا بها الأرضَ سماءً وقد","أُطلعَ فيها أنجمُ النرجسِ",19,"س",1,0],["خلني يا خلي وفرط بلائي","أمزج الدمع بعدهم بالدماء",20,"ا",2,1],["خَلِّني من ملامةِ اللُّوَّامِ","وأَدر في الدُّجَى كئوسَ المُدَامِ",21,"م",1,1],["خلّني دَهراً أسيراً","عن سَراحٍ، لا تَسَلْني",22,"ن",2,0],["خلني من قبول عذلك عنها","أنت خلي من المحبة خلو",23,"و",1,0],["خلنا به الظلماء خاضب لحية","حان النصول لصبغها أو حالا",24,"ل",2,0],["خلِّني وَالمُدام في شُغُلٍ","واِشتغِل أَنتَ بالَّذي يَعنيك",25,"ك",1,0],["خِلنا الزمانَ لَنا اِستدارَ فَنَحن في","خَيرِ القرونِ بحكمِ خير قرانِ",26,"ن",1,0],["خلني من حديث هندٍ ولبنى","وسليمى وزينب وتنحّا",27,"ح",2,0],["خَلِّني والهوى بآرامِ سَلْعٍ","يا خَليلي ولا عدمتُك خلاّ",28,"ل",2,0],["خَلِّنا والمطيّ نستفرغ الدم","ع لأطلالها ونذكر عهدا",29,"د",2,0],["خلّني والحبّ أو","كفّ عنّي عذلك",30,"ك",1,0],["خلن لها فَلْجاً فخلنا وقعَها","في آلِهِ وهي طوافٍ عَرَقا",31,"ق",2,0],["خلّني والزمانَ وأعلم يقيناً","أنَّ صرفَ الزمان يبلي ويبلى",32,"ل",2,0],["خَلِّنا يا صُوَيْحِبي من أُناسٍ","زَعَموا المسكَ عينَ جِسمِ الحُقوق",33,"ق",1,0],["خَلِّني منكَ ودَعْني إنَّني","سَهَري حتَّى اللِّقا من خُلُقي",34,"ق",2,0],["خلنا شعيباً والكليم تجسدت","فهما حقيقة غائب في شاهد",35,"د",1,0],["خِلنا منازِلَنا مِنها وقد نَزَعَتْ","كلَّ النُّزوع عن الأوطان أوطانا",36,"ن",2,0],["خلني في محبة المحبوب","فهي عندي نهاية المطلوب",37,"ب",1,1],["خَلِّني أَندُبُ بِالي الطَّلَلِ","وَأرِحني واستَرِح مِن عَذَلي",38,"ل",2,1],["خَلّني وَالهَوى وَحَرَّ فُؤادي","وَمَديح البليغِ ذي التّرصيفِ",39,"ف",1,0],["خلِّنا لا نَنْفكُّ شَرْبا سُكارى","نشرب الراحَ روحةً وابْتكارا",40,"ر",2,1],["خلني والوجد يغدو","بفؤادي ويروحُ",41,"ح",1,0],["خلِّني أندبُ الرسمَ والطللا","ودع اللومَ منّي والعذَلا",42,"ل",2,1],["خلّني في ضلّتي ليس على","غير نفسي في صلاحٍ وفسادِ",43,"د",1,0],["خلّني والسقم منه إنّني","قَد أرى اللذّات في ذاكَ السقَم",44,"م",1,0],["خلني اطوي الفيافي واعدو","في الصحاري واكتفي التكبيلا",45,"ل",2,0],["خَلِّني أُفْسِدُ مالي","في الَّتي تُصْلِحُ خَلْطِي",46,"ط",2,0],["خلني أبطش بهم قد بطروا","وأنا خيرُ دواءٍ للبطر",47,"ر",1,0],["خلّني أبلغ بهم أمنيتي","من فناهم فجزاءُ الشرِّ شر",47,"ر",1,0],["خَلَّ نزْوى واستَجرْ في سَمَدٍ","بسماحِ الأزْدِ من بُخْلِ مُضَرْ",48,"ر",1,0],["خَلِّني يا صاحِ عَن عَذلِكَ لي","قَد عَصى قَلبي عَلى مَن عَذَلَه",49,"ل",2,0],["خلنا فالسكوت أسلم عقبى","لا يطيب الكلام والماء في الفمّ",50,"م",1,0],["خلني والهوى وأهون بنفس","إن تناهى مؤنبٌ عن هواها",51,"ا",3,0],["خلنجيون ما حاضوا","ولا باتوا على طهر",52,"ر",1,0],["خلني أبكي بعين الو","اله الصب الكئيب",53,"ب",1,0],["خلني بالله من رجم الظنون","ومن الحمقى ومما يعرفون",54,"ن",1,1],["خلناك في الرأي قيساً والندى هرماً","والبأس عمراً وفصل الحكم لقمانا",55,"ن",2,0],["خلّني لك في لامر سايس","واقفٍ في شفّ ماموره",56,"ر",2,0],["خِلنا بِطَوق الثَنا يَنسى طَبيعته","وَالكَلب كَلب وَلَو طَوقته ذَهَبا",57,"ب",2,0],["خلني يا لائمي سفها","لست ممن يبتغي حولا",58,"ل",2,0],["خل ناي زند وري قاض قضى","ساع سعى وقد مشى حتى مضى",59,"ض",2,0],["خلنا الصناعة للإنسان مسعدةً","إذ الصناعة من أدهى البليّات",60,"ت",1,0],["خلنا السحائب فوقه جزرا","حتى اعتلت فتحوّلت نسرا",61,"ر",2,0],["خلّني فلست أرى","غير شارب ثمل",62,"ل",1,0],["خَلِّ نفسَ اللِّقا تبلُّ صَداها","كم لَهَا بالنوى تُقاسي ظَماها",63,"ا",3,1],["خلنا على الكرسي ليثاً غابه","سمر القنا نبتت بفيض بحاره",64,"ر",2,0],["خلّني عَلى","يَقظتي وَنم",65,"م",1,0],["خِلْنا البياضَ سُيوفاً أُودِعَتْ خِللاً","من السّوادِ فأبدتْ جِدَّة الخِلَلِ",66,"ل",1,0],["خِلْنا التّزعزعَ من سَجيّاتِ القَنا","فإذا القَنا من خوفِه يتزعزعُ",67,"ع",1,0],["خلني اعشقن جمال مثالك","يا جميلاً شوقتني لجمالك",68,"ك",1,1],["خلني معكَ في القريض ودعني","من بني الأرض لا أريد الأناما",69,"م",2,0],["خلناه في الغيب منسيًّا فذكَّرنا","بنفسه اليومُ في إلهام نجواه",70,"ا",2,0],["خَلنِّي أغتنم سعادة عمري","في اغتباق مُردَّدٍ واصطباحِ",71,"ح",1,0],["خلنا الجماد تفري لوعةً فغدا","ما بين منحطمٍ منه ومنشعب",72,"ب",1,0],["خلني واحفل بأوراق الرَبيع","منشدا فَوقَ الغصون المورقة",73,"ه",1,0],["خَلِّني يا قَلب في أَحلامِ حُبّي","وَادفنِ الماضيَ دفناً في الثَرى",74,"ر",2,0],["خلنا جيك لك من معاني بآصال لآصال","جيك بالجوهر الغالي والإبريسم العال",75,"ل",1,0],["خلناه تحت الجلّ إذ جلّلته","قرون ضأنٍ جعلت ملء العبا",76,"ب",2,0],["خلناهمُ مصدراً للصادرينَ ولا","يلقون بالصَدِّ أيّاً جاءَ مشغوفا",77,"ف",2,0],["خلناك توضح في الألغاز ما استترا","وفي بيان المعاني تمنح الخبرا",78,"ر",2,1],["خلِّني إذ لم تساعد","ني عليهم يا عَذولُ",79,"ل",1,0],["خَلّني من حَديثٍ زيدٍ وعمرو","واسعَ بي يا نديمُ نحوَ الغُمرِ",80,"ر",1,1],["خلّني أسهَرُ نيلى","ودعِ الناس نياما",81,"م",2,0],["خلّني مسترسلاً في نشوتي","كلما لاح سناها واقتربْ",82,"ب",1,0],["خلّني انظر خياله واحتفل","واحلم انّي به هزمت المستحيل",83,"ل",1,0],["خلني بين الرموش اللَّي وقوف","تحت منثور الشعر عند الجبين",84,"ن",1,1],["خلني في نشوة الأحلام غارق","وما بدت به نظرة الشوق انتهت به",85,"ب",2,0],["خلنا نتعاهد بالوفاء والوفاء لي","وانا على عهد الوفاء لك جنوعي",86,"ع",2,0],["خَلّنا ننسى نفسنا..ولايهمك هالرصيد","مايعادل شوق روحي أي كنوز وأي ذهب",87,"ب",1,0],["خلْني كما واقع ربا داخل الحلم","وخلْني سحابه بس لااا اشوف ماطرك",88,"ك",1,0],["خلّني عن [ شرهة ] .. العالم / بعيده","والجروح ان ما تفارقني تشاوى",89,"ا",3,0],["خِلْنَا صوابا عندهم إنما","كان تبَنِّى رأينا أصوبا",90,"ب",2,0],["خلِّني للدموع وحدي أناجي","ها وحيدا في العزلة السوداءِ",91,"ا",2,0],["خلنا أنتغانم ونقطف وردنا الزاهر","مادام نبت الليالي قدامنا كامل",92,"ل",1,0],["خلني أنشط البيان رثاءً","إن وفى بعض حقه تبياني",93,"ن",2,0],["خلني من ظريفة وظريف","وأرحني من أنّة المشغوف",94,"ف",1,1],["خلني أعيش بطيف سيد الغزالي","يمر لي لا قلت هاتو لي دواي",95,"ا",2,0],["خلنا نراك بأثواب القران وقد","اصبحت تلبس من اكفانها حللا",96,"ل",2,0],["خلنا نتفاهم تعال نوضح الصوره","إما انت تمشي معي أو لا توقفني",97,"ن",2,0],["خلني أنتفع بخبرك هذا","طالما فات منك نفع الخبير",98,"ر",1,0],["خلني أطفوا على بحر الآمال","ويتلاعب موجك بقلبي القتيل",99,"ل",1,0],["خل نارا تشب بين ضلوعي","تطفها مقلتي بفيض دموعي",100,"ي",1,1],["خلني ما بين شكي واليقين","السكوت رضاي عنك وزعلي",101,"ل",2,0],["خلنا للدرب والنيه مطيه","لين يدني ياطويل العمر موتي",102,"ت",2,0],["خلني يوم مال الضو للمغربيه","وإنثنا الضل الاكحل يحتضن كل وادي",103,"د",2,0],["خَلِّنِي أَشْرَعُ فِي مَدْرَسَةِ ال","وَجْدِ شَرْعاً حُكْمُهُ لا يَنْجَحِدْ",104,"د",1,0],["خَلِّنِي فِي ضِلَّتِي لَيْسَ عَلَى","غَيْرِ نَفْسِي مِنْ صَلاحِي وَفَسادِي",105,"د",2,0],["خلني داخل (حدودك) وأجبر بخاطر زماني","أكذب بباقي (وعودك) وأصدق بلحظه سعيده",106,"د",2,0],["خلني في زمان الياس معك انطلق","لاخر حدود حلمي دام وقتي ضرير",107,"ر",1,0],["خلني بس والله لا يهينك","اتوّحد بكيفي فالوجود",108,"د",1,0],["خلنا نقتل الأحلام بيدينا","قبل الاحلام تقتلنا براءتها",109,"ت",3,0],["خلنا نحلم احلامٍ تكفينا","نظرةٍ تدفي الواقع حرارتها",109,"ت",3,0],["خلّنا من حديث السادة المنهكين","ما عبرنا حدود الغيّ نشرب سكات",110,"ت",1,0],["خلني الدهر وسالت أدمعي","وسفيني تاه عن خط القدرْ",111,"ر",1,0],["خَلِّنَا من خَلاَئِقٍ سَبَقَتْ مِنْ","كَ دَعَتْنَا للَّومِ والتَعْنِيفِ",112,"ف",1,0],["خلنَ لها فرجاً فخلنَ وقعها","في آلٍ وهي طوافٍ عرقا",113,"ق",2,0]]}