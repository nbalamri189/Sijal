{"poems":[[47,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[107,"أهذا هو العدل الذي فيه أطنبوا","https://www.aldiwan.net/poem43392.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[203,"طريدة بؤس مل من بؤسها الصبر","https://www.aldiwan.net/poem45157.html","الطويل"],[484,"سمعا لصوتك سمعا أيها الشادي","https://www.aldiwan.net/poem36952.html","البسيط"],[484,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[556,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[563,"رعى الله بستانا بفيجة جلق","https://www.aldiwan.net/poem34299.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[3356,"","https://poetry.dctabudhabi.ae/diwan/poem/206300","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117948","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103025","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35623","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136907",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""]],"verses":[["وَلِلظُلمِ ما أَمسَت وَعَبدُ يَغوثِها","يُخَزّيهِ غاوي مَذحِجٍ وَرَشيدُها",0,"د",3,0],["وَلِلظُلمِ آياتٌ إِذا هِيَ صافَحَت","يَدَي قادِرٍ ظَلَّت عَلى العَدلِ تَضرِبُ",1,"ب",1,0],["وَلِلْظُّلْمَةِ الْخَابِي بِهَا النَّجْمُ أَطْلِعِي","لَهَا أَنْجُماً إِنْ تَغْرُبِ الزُّهْرُ تَسْطَعِ",2,"ع",1,0],["وللظبي منها مقلتاها وجيدها","وفيها من الظبي التلفُّت والذعرُ",3,"ر",1,0],["وللظروف سياسات تلائمها","وللسياسي فيها حكم منطاد",4,"د",1,0],["وللظرفاء أطلعها رياضا","يلطف عبقريتها النسيم",5,"م",1,0],["وللظّلماء في الخضراءِ بُرْدٌ","وُشومٌ بالكواكب أَو رُقومُ",6,"م",1,0],["وللظل منها الميل يرسم شكلها","على الأرض مثل الكاتب المتأنق",7,"ق",1,0],["وللظُّبَى والطُّلَى لَثْمٌ ومُعْتَنَقٌ","وللقَنَا والكُلَى ضَمٌّ ومُرْتَشَأُ",8,"ا",1,0],["وللظفر إن لم يبقل الأرشُ كله","بعيرٌ وغلا نصفه حين يبقل",9,"ل",1,0],["وللظاعنين تحن الديار","كأن الأحبة أوطانها",10,"ن",3,0],["وللظباء بهاتيك السفوحخ له","تأله برقيق الشعر ينطقه",11,"ق",2,0],["وللظبى نغمات في رؤوسهم","كأنها الطير قد غنت على فنن",12,"ن",1,0],["وَلِلظِّباء وَأسدِ الغيلِ ما ضَمِنت","تِلكَ البَراقعُ يَومَ البينِ وَاللّثمُ",13,"م",1,0],["وللظباء كناس عند شاطئه","وللاسود مقيل في اعاليه",14,"ي",2,0],["وللظبى ظفر حلو مذاقته كأنما","الضرب فيما بينهم ضرب",15,"ب",1,0]]}