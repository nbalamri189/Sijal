"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5703,"قمرٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=211788",""],[5729,"لمَ تشتكي؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=203995",""],[4623,"ماذا يضرك لو تركت ملامي ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146686",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[5861,"رفقا حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=188296",""],[5897,"غداً القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=160569",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"أ تظل صامتةَ سمرْ؟","https://www.poetsgate.com/ViewPoem.aspx?id=185468",""],[5956,"حالُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=192358",""],[5956,"أ تطيق بُعداً عن محبِّك خالدٍ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193347",""],[5956,"أ تظن أني لست آلَفُ فضلكا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193356",""],[5956,"النِّدُّ للند","https://www.poetsgate.com/ViewPoem.aspx?id=193481",""],[5956,"تعريف بإسرائيل المعتدية","https://www.poetsgate.com/ViewPoem.aspx?id=194415",""],[5957,"أبدعتَ في دور المحب","https://www.poetsgate.com/ViewPoem.aspx?id=53702",""],[5977,"الحب العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=213129",""],[5988,"أتظعن والذي تهوى مقيم","https://www.poetsgate.com/ViewPoem.aspx?id=99721",""],[6096,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=177138",""],[469,"أمجادلي في من رويت صفاته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574786",""],[3155,"في حرم الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72292&r=&rc=4",""]],"verses":[["أَتَظُنُّ أَنّي بِالقَطيعَةِ راغِبٌ","هَيهاتَ وَجهُكَ بِالوَفاءِ كَفيلُ",0,"ل",1,0],["أتظن أنك لو مُسخ","تَ بلغتَ قُبحك أو قُرابهْ",1,"ب",2,0],["أتظعَنُ يا قلبُ مع من ظعَنْ","حَبيبَينِ أندُبُ نفسي إذَنْ",2,"ن",1,1],["أَتَظُنُّ الغِنى ثَواءً لِذي الهِمَّ","ةِ مِن وَقفَةٍ بِبابِ لَئيمِ",3,"م",1,0],["أَتظُنُّ أنَّ الدَّهرَ يُسعِفُ طالباً","أو تُعتِبُ الأيّامُ منا عاتِبا",4,"ب",2,1],["أَتَظُنّها رَحِمَتْهُ من أَلمِ الجَوَى","بِمُخَلخَلٍ يَستَرحِمُ الخِلخَالا",5,"ل",2,0],["أَتَظُنُّني أَجِدُ السَبيلَ إِلى العَزا","وَجَدَ الحِمامُ إِذاً إِلَيَّ سَبيلا",6,"ل",2,0],["أتظنني أنسى لذاذاتِ الصِّبا","لا أمَّ لي إنْ كانَ ذاكَ ولا أبُ",7,"ب",1,1],["أتظعن تستفيدْ أخاً لئيماً","وقدْ ضيَّعْتَ إخوتَكَ الكراما",8,"م",2,0],["أَتَظُنُّ لي في وُدِّ مِثلِكَ مَطلَباً","نَفسي أُريدُ وَمَجدَ قَومي أَطلُبُ",9,"ب",1,0],["أتَظُنُّ راحاً في الشَّمالِ شَمُولا","أتَظُنُّهَا سَكْرَى تَجُرُّ ذُيولا",10,"ل",2,1],["أَتُظهِرُ رَهبَةً وَتُسِرُّ رَغباً","لَقَد عَذَّبتَني رَغباً وَرَهبا",11,"ب",2,0],["أَتَظُنُّ أَنَّكَ لِلمَحاسِنِ كاسِبٌ","وَخَبِيُّ أَمرِكَ شِرَّةٌ وَشَنارُ",12,"ر",1,0],["أَتَظُنُّ أَنَّ الْفَخْرَ ثَوْبٌ مُعْلَمٌ","تَزْهُو بِلِبْسَتِهِ وَقِدْرٌ باخِرَهْ",13,"ر",2,0],["أَتَظَلُّ كَالأُمِّ الثَّكُولِ مَرُوعَةً","بِبَوَائِقٍ تَنْقَضُّ إِثْرَ بَوَائِقِ",14,"ق",1,0],["أَتَظُنُّني أَلقى إِلَيكَ يَداً وَما","بَيني وَبَينَكَ غَيرُ ضَربِ الهادي",15,"د",2,0],["أتُظلِم منك ناحيةٌ عليه","وفيها سُنّة القمر المنير",16,"ر",1,0],["أتظن فاتنةَّ القياصر أقبلت","وتظن هذا اليومَ يوم نشور؟",17,"ر",1,0],["أتَظُنُّ أن الجسم جسمٌ: نصفُه","عارٍ، وأثوابٌ عليه قِصار",18,"ر",1,0],["أتظهرُ رهبة ً وتُسرُّ رغباً","لقد عدَّبتني رغبا ورهبا",19,"ب",2,0],["اتظن ان الحسن يب","قى هذه احلام جاهل",20,"ل",1,0],["اتظن مهما حرت يا حلو اللمى","تلوي لغيرك في الهوى آمالي",21,"ل",2,0],["اتظن يا ريم الغضا ما قد جنو","ت كما زعمت مضى ويهملك القضا",22,"ض",2,0],["أتظنُّ أنى قد أتيتُك","باحتيالٍ نادرِ",23,"ر",1,0],["أتظُنُّ هذا الظَّنَّ فِيْ","ىَ ونورُ وجهك لي جِلاءُ",24,"ا",2,0],["أتُظهِرُ في عرفانِ ما بي جهالةً","وما أَحدٌ في الناس منك سليمُ",25,"م",1,0],["أَتَظُنُّ أَرمانوسَ يَنسى يَومَهُ ال","مَشهودَ مَع مَن شَرَّدَتهُ ظُباكا",26,"ك",2,0],["أَتَظمى لَدَيكَ المشرفِيَّةُ وَالقَنا","وَفي قُلَلِ الباغينَ وِردٌ لِشارِبِ",27,"ب",1,0],["أَتَظُنُّني أَرضى بِحَسيِكَ مَنهَلاً","تَبّاً لِحَسيكَ أَحمَقاً ما أَبرَدا",28,"د",2,0],["أتظن إن أعرضت أن","هواك يعرض عن فؤادي",29,"د",2,0],["أَتَظُنُّني ما عِشتُ أَنعَمُ بالا","هَيهاتَ ذِلُّ العَيشِ بَعدَكَ زالا",30,"ل",2,1],["أَتَظُنَّني أَضمَرتُ بَعدَكَ سَلوَةً","هَيهاتَ عَطفُكَ مِن سُلوّي أَقرَبُ",31,"ب",1,0],["أتظنُ أني لا أتيه كما تتي","هُ أو انني مُستَسِلمٌ للياسِ",32,"س",1,0],["أتظما وَذا يحيى بن أَحمد في الذرى","شَريف منيف طال مجدا وَمفخرا",33,"ر",2,0],["أَتَظُنُّ أَنَّكَ ضائِرِي بِأَشَدَّ مِنْ","عُدْمِ الشَّبابِ وَفُرْقَةِ الأَحْبابِ",34,"ب",1,0],["أَتَظُنُّنِي لا أَسْتَطِي","عُ أُحِيلُ عَنْكَ الدَّهْرَ وُدِّي",35,"د",2,0],["أَتظلُّ تُسقى في الغَرام سُلافة","وأَظلُّ أسقى في الغَرام ذُعافا",36,"ف",2,0],["أتظن أنَّك نافعي من بعد ما","أنهجتمُ ومن رقعتي ديباجها",37,"ج",3,0],["أتظنون بأني ميتكم","ليس ذاك الميت واللَه أنا",38,"ن",2,0],["أَتَظُنّ اني من تباريح الضَنا","اِنجو وَقَد لاح العذار الاِخضر",39,"ر",1,0],["أَتَظُنُّ أنّي صابِرٌ وجوانحي","مَمْلوءةٌ للبُعْدِ منك جِراحا",40,"ح",2,0],["أَتَظُنُّ أَثوابَ الشَبابِ بِلَمَّتي","دَورَ الخضابِ فَما عَرَفتُ خضابي",41,"ب",2,0],["أتظنُّ هامان الذي استنجدتَه","مازال يُوقد للولاءِ شموعا؟!",42,"ع",2,0],["أتظنّه مازال يبني صرحَه","حتى تُطيق إلى السماءِ طلوعا؟!",42,"ع",2,0],["أتظنون بأني بعدكم","أطعم النوم إذا ما الليل جن",43,"ن",1,0],["أتظن من منكم يلي أمر الورى","يلقى قرابته بلا استخفاف",44,"ف",1,0],["أتظّنِني أرجُو عَواطِفَ وُدِّهِمْ","إنّي إذاً عبدُ المطامعِ أخْرقُ",45,"ق",1,0],["أَتَظُنُّ صَبرَكَ مُنجِداً إِن أَنْجدُوا","هيهاتَ ليس لِمُستهامٍ مُسعِدُ",46,"د",1,1],["أَتَظُنُّ يا إِدريسُ أَنَّكَ مُفلِتٌ","كَيدَ الخَليفَةِ أَو يَقيكَ فِرارُ",47,"ر",1,1],["أتظُنُّه يسلو هواك على النَّوى","تالله ما خطر السُّلُوُّ بباله",48,"ل",2,0],["أتظن أني صابر عن أرضهم","وأرى بريقاً نحوها يتلألأ",49,"ا",1,0],["أتظن أن الجبن يرفع أمة","أو أنه سيزيد في الأعمار",50,"ر",1,0],["أتظنّ عهد أبيك عهدا غادرا","وتخاف ما يأتي به الحدثان",51,"ن",1,0],["أتظُنُّ الدمعَ دَيْناً","تتقاضاه بعَتبي",52,"ب",2,0],["أتظنُّ تأخيرَ الإمام نقيصةً","والنقض للأطراف لا الأشراف",53,"ف",1,0],["أتظنني أرضى بما ملأ الثرى","نوء الثريا دون ما يرضيني",54,"ن",2,0],["أتظن الكلاب إذ نبحتني","أن تغبيرهم يدنس شاشي",55,"ش",2,0],["أتظن المشوق مثلك أعمى","عن بروق الحمى وتلك النواحي",56,"ح",2,0],["أَتظن في مَلكِ الملوكِ طماعةً","خابت ظنونُك فاختبي أَو فَاخْتَفي",57,"ف",2,0],["أَتَظُنُّ أَن تَمضي وَأَبقى وافِراً","هَيهاتَ قَد صارَ البَقاءُ قَليلا",58,"ل",2,0],["أَتظن أَنك بَعدَ هَذا مُسلمٌ","وَلأَنتَ مِن فَرعون موسى أَكفر",59,"ر",1,0],["أتظهر النفس في بطش الظلوم فلا","نبكي شبابك إذ ضيعت نضرتَهُ",60,"ت",2,0],["أَتظنّ البقا بِدارِ الهَوانِ","فَاِتَّئدْ كلُّ مَن عَلَيها فاني",61,"ن",2,1],["أَتَظُنُّ النِّدَامَ تَرْضَى بِهذَا","لاَ ومُحْيِي العِظَامَ وَهِيَ رَمِيمُ",62,"م",1,0],["أتظن أنا في النضا","ر قد اجتلت منا الزواهر",63,"ر",1,0],["أتظن للشكوى تبدل حالة","والوجد لا حدٌ ولا ميقات",64,"ت",1,0],["أتظني في الدار شجوي لا ومن","هو بالذي تخفي الصدور عليم",65,"م",1,0],["أتَظُنَّ أنَّ العَذْلَ يَنْفَعُ مَنْ يَرَى","أنْ لاَ يَرَى لِفَسَادِهِ إصْلاَحَا",66,"ح",2,0],["أَتظنُّ يُخفي الحبَّ مَن هو مدنفٌ","كَلفٌ وذائبُ دمعهِ لا يجمدُ",67,"د",1,0],["أتُظْلِمُ مِنْ رأينا شيعة","وفينا سِرَاجُ الإله المنيرُ",68,"ر",1,0],["اَتَظُنُني مِمَن يَحول عَن الوَفا","أَتَظُن في غَير الخَليل خَليلا",69,"ل",2,0],["اتُظناهُما وقد كُثرا عداً","يَزيدان للشقا الوِلدانا",70,"ن",2,0],["أتظن يا خلي مفارقتي مليكي","عن رضى مني معاذ الله ما",71,"م",2,0],["أَتظُنُّني أَصْحو وحُبُّكَ مُسْكري","وأَنامُ عن وَجْدي وأَنْتَ مُنَبِّهي",72,"ه",2,0],["أتظل دور المجد آهلة","فينا ودورك بينها دثر",73,"ر",1,0],["أتظن أنكَ عاشقٌ","وتبيتُ في المحبوب حالم",74,"م",1,1],["أتظنّان صلاحي مُمكناً","إنَّما يَصْلُح مَن فيه رمَقْ",75,"ق",1,0],["أَتَظُنُّونَ أَنَّ طُولَ انْتِزَاحِي","قَدْ بَرَى الجِسْمَ إِي وَرَبِّ البَرَايَا",76,"ا",3,0],["أتَظلمّونَ وتظلمون بجهدكم","ومن العجائب ظالم متظلم",77,"م",1,0],["أَتُظهِرُ ما في الصَدرِ أَم أَنتَ كاتِمُه","وَكِتمانُهُ داءٌ لِمَن هُوَ كاتِمُه",78,"م",2,1],["أتظن غصن البان يع","جبني وقد عاينت قدك؟",79,"ك",1,0],["أتظنني جلد الهوى","أو أن لي عزمات جلدك",79,"ك",1,0],["اتظن أني قد سلوتك ساعة","لا والذي سواك لست بسالي",80,"ل",2,0],["أتظن أني رابحٌ وأنا الذي","أنسيتُ فيك حديثَ سلم الخاسر",81,"ر",1,0],["أتظُنُّهُم لَفظِيَّةً جَهلِيَّةً","مِثلَ الحَمِيرِ تُقَادُ بالأرسَانِ",82,"ن",1,0],["أتَظُّنُّهَا تَعنِي بِهِ صَرفاً عَنِ ال","مَعنَى القَوِيِّ ذِي الرُّجحَانِ",82,"ن",1,0],["أتَظُنُّهَا تَحتَاجُ نَقلاً مُسنَداً","مُتَوَاتِراً أو نَقلُ ذِي وِحدَانِ",82,"ن",1,0],["أَتَظُنَّ الوُرقَ في الأَيكِ تُغَنّي","إِنَّما تُضمِرُ حُزناً مِثلَ حُزني",83,"ن",2,1],["أتظنون فؤادي ضل في","سبل الحب عن الرشد فهاما",84,"م",2,0],["أتظنّ أهوالاً كأهوال الهوى","أهواله هول يتابع هولا",85,"ل",2,0],["أَتظنُّ أَن البعد حلَّ مودتي","إِن بَانَ شَخْصك فالخيال قريبُ",86,"ب",1,0],["أَتَظُنُّ الكَلامَ يُبري كِلاماً","ما بِكلمِ الحَبيبِ تَبرا الكلامُ",87,"م",1,0],["أتظن أنى بعد بعدك باقي","أجزى عن الأشواق بالأشواق",88,"ق",1,1],["أَتظنّ أَفئدةَ العذارى سلعةً","تُشرى بمالٍ أو بسيفٍ تُغنَمُ",89,"م",1,0],["أتَظُنُّ المَنامَ يدخُل جَفْنِي","كيف هذا وحُسْنُه مِلءُ عَيْنِي",90,"ي",1,0],["أتظن بغدادي طبع خالص","يلفى هزيم من اغتدى متبغددا",91,"د",2,0],["أتظهرونَ النوحَ والعَويلا","فابكوا كثيراً واضحَكوا قليلا",92,"ل",2,0],["أتُظهِر ليناً ثُمَّ تُخفى مداوةً","فما العذرُ يَا مُخفِي العداوةِ مَا العذر",93,"ر",1,0],["أتظن في ذات الحجال أواري","لا بل أداري عاذلي وأواري",94,"ر",2,1],["أَتظنُّ أَنَّ بقاءَه من بعدهِ","الا كما يثنى المسارقُ طرفَهْ",95,"ف",2,0],["أتظنُّ ظبيَكَ في الحقائقِ مانعي","دَيني وقد أوليتُه في الباطِلِ",96,"ل",1,0],["أتظنُ أنّ الغيثَ من حُسّادِهِ","هيهاتَ أصغَرُ حاسديهِ زمانُهُ",97,"ن",2,0],["أتظن إني بالطلول مولع","وتخالني بظبا النقي متغزلا",98,"ل",2,0],["أتظن الوهاد مثل الروابي؟","أم تخال الهجين مثل الهجان",99,"ن",1,0],["أَتظنني أَرضى التغرّب وَالقِلا","وَفديتها ما كان ذلك شاني",100,"ن",2,0],["أتظن من بعد القلبى يا ليت شع","ري هل ترى يوماً يعود له السعود",101,"د",1,0],["أَتظنُّ أَني بالإساءة مُقلع","كيفَ الدّواء وقد أصيبَ المقتلُ",102,"ل",1,0],["أتظلِمني ودّ وما زال فيكم","قريعُ عَليَّ يُرجى لردِّ المظالمِ",103,"م",1,0],["أتظنّ اللَه يَرضَى حَكَماً","للوَرَى إلا الإمام الحكَمَا",104,"م",2,0],["أتظلمني الأيام وهي خبيرة","بأنّ إليه-إن ظلمت