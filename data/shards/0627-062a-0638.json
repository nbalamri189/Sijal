{"poems":[[53,"غيري عن الود الصريح يحول","https://www.aldiwan.net/poem29879.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[43,"أتظعن يا قلب مع من ظعن","https://www.aldiwan.net/poem10615.html","المتقارب"],[45,"قد فقدنا الوفاء فقد الحميم","https://www.aldiwan.net/poem65689.html","الخفيف"],[61,"أتظن أن الدهر يسعف طالبا","https://www.aldiwan.net/poem51807.html","الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[69,"أتظنني أنسى لذاذات الصبا","https://www.aldiwan.net/poem28834.html","الكامل"],[69,"علام أردت تهجرني علاما","https://www.aldiwan.net/poem28897.html","الوافر"],[105,"أدنو ويجمح بي الإباء فأعزب","https://www.aldiwan.net/poem43398.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"عدمتك عاجلا يا قلب قلبا","https://www.aldiwan.net/poem64866.html","الوافر"],[46,"يا ظالما عقد اليدين مصليا","https://www.aldiwan.net/poem22585.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42640","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23663","الوافر"],[106,"غادة البسفور","https://www.poetsgate.com/ViewPoem.aspx?id=179474",""],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[50,"عَدِمْتُكَ عَاجِلاً يَا قَلْبُ قَلْبَا","https://www.poetsgate.com/ViewPoem.aspx?id=16884",""],[116,"أرأيت يا حلول الشمائل","https://www.aldiwan.net/poem40609.html","عموديه"],[116,"قسما برقة خصرك الميال","https://www.aldiwan.net/poem40624.html","عموديه"],[116,"منذ الذي يغريك يا ريم الغضا","https://www.aldiwan.net/poem40917.html","عموديه"],[129,"يا ذا النوال الغادر","https://www.aldiwan.net/poem50618.html","مجزوء الكامل"],[129,"أطلق لسانك ما تشا","https://www.aldiwan.net/poem50681.html","مجزوء الكامل"],[143,"يسأئلني ما حاجتي في دياره","https://www.aldiwan.net/poem58392.html","الطويل"],[144,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[170,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[170,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[223,"يا معرضا عمن تعرض","https://www.aldiwan.net/poem55448.html","مجزوء الكامل"],[236,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[236,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[242,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[272,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[281,"يا دهر قد عديت عنك طلابي","https://www.aldiwan.net/poem60597.html","الكامل"],[281,"كم ذا التجنب والتجني","https://www.aldiwan.net/poem60735.html","مجزوء الكامل"],[298,"أتركتني دنفا ورحت معافى","https://www.aldiwan.net/poem33217.html","الكامل"],[299,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[314,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[362,"حتام يا ساجي اللواحظ تهجر","https://www.aldiwan.net/poem68111.html","الكامل"],[365,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[394,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[401,"رسالة إلى فرعون مصر","https://www.aldiwan.net/poem10305.html","عموديه"],[404,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[404,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[410,"يا ابن الألى جمع الفخار لبيتهم","https://www.aldiwan.net/poem32263.html","الكامل"],[410,"أتظن صبرك منجدا إن أنجدوا","https://www.aldiwan.net/poem32499.html","الكامل"],[411,"أتظن يا إدريس أنك مفلت","https://www.aldiwan.net/poem67503.html","الكامل"],[417,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[446,"لهوى الحجاز بأفق قلبي مبدأ","https://www.aldiwan.net/poem23812.html","الكامل"],[450,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[454,"أيار كاد يذوب عطرا سابغا","https://www.aldiwan.net/poem61325.html","الكامل"],[459,"أيها العاتب ما ذا","https://www.aldiwan.net/poem56308.html","مجزوء الرمل"],[465,"أمجادلي فيمن رويت صفاته","https://www.aldiwan.net/poem3161.html","عموديه"],[516,"يا دهر قد أكثرت في التلوين","https://www.aldiwan.net/poem12301.html","الكامل"],[559,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[559,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[576,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"]],"verses":[["أَتَظُنُّ أَنّي بِالقَطيعَةِ راغِبٌ","هَيهاتَ وَجهُكَ بِالوَفاءِ كَفيلُ",0,"ل",1,0],["أتظن أنك لو مُسخ","تَ بلغتَ قُبحك أو قُرابهْ",1,"ب",2,0],["أتظعَنُ يا قلبُ مع من ظعَنْ","حَبيبَينِ أندُبُ نفسي إذَنْ",2,"ن",1,1],["أَتَظُنُّ الغِنى ثَواءً لِذي الهِمَّ","ةِ مِن وَقفَةٍ بِبابِ لَئيمِ",3,"م",1,0],["أَتظُنُّ أنَّ الدَّهرَ يُسعِفُ طالباً","أو تُعتِبُ الأيّامُ منا عاتِبا",4,"ب",2,1],["أَتَظُنّها رَحِمَتْهُ من أَلمِ الجَوَى","بِمُخَلخَلٍ يَستَرحِمُ الخِلخَالا",5,"ل",2,0],["أَتَظُنُّني أَجِدُ السَبيلَ إِلى العَزا","وَجَدَ الحِمامُ إِذاً إِلَيَّ سَبيلا",6,"ل",2,0],["أتظنني أنسى لذاذاتِ الصِّبا","لا أمَّ لي إنْ كانَ ذاكَ ولا أبُ",7,"ب",1,1],["أتظعن تستفيدْ أخاً لئيماً","وقدْ ضيَّعْتَ إخوتَكَ الكراما",8,"م",2,0],["أَتَظُنُّ لي في وُدِّ مِثلِكَ مَطلَباً","نَفسي أُريدُ وَمَجدَ قَومي أَطلُبُ",9,"ب",1,0],["أتَظُنُّ راحاً في الشَّمالِ شَمُولا","أتَظُنُّهَا سَكْرَى تَجُرُّ ذُيولا",10,"ل",2,1],["أَتُظهِرُ رَهبَةً وَتُسِرُّ رَغباً","لَقَد عَذَّبتَني رَغباً وَرَهبا",11,"ب",2,0],["أَتَظُنُّ أَنَّكَ لِلمَحاسِنِ كاسِبٌ","وَخَبِيُّ أَمرِكَ شِرَّةٌ وَشَنارُ",12,"ر",1,0],["أَتَظُنُّ أَنَّ الْفَخْرَ ثَوْبٌ مُعْلَمٌ","تَزْهُو بِلِبْسَتِهِ وَقِدْرٌ باخِرَهْ",13,"ر",2,0],["أَتَظَلُّ كَالأُمِّ الثَّكُولِ مَرُوعَةً","بِبَوَائِقٍ تَنْقَضُّ إِثْرَ بَوَائِقِ",14,"ق",1,0],["أَتَظُنُّني أَلقى إِلَيكَ يَداً وَما","بَيني وَبَينَكَ غَيرُ ضَربِ الهادي",15,"د",2,0],["أتُظلِم منك ناحيةٌ عليه","وفيها سُنّة القمر المنير",16,"ر",1,0],["أتظن فاتنةَّ القياصر أقبلت","وتظن هذا اليومَ يوم نشور؟",17,"ر",1,0],["أتَظُنُّ أن الجسم جسمٌ: نصفُه","عارٍ، وأثوابٌ عليه قِصار",18,"ر",1,0],["أتظهرُ رهبة ً وتُسرُّ رغباً","لقد عدَّبتني رغبا ورهبا",19,"ب",2,0],["اتظن ان الحسن يب","قى هذه احلام جاهل",20,"ل",1,0],["اتظن مهما حرت يا حلو اللمى","تلوي لغيرك في الهوى آمالي",21,"ل",2,0],["اتظن يا ريم الغضا ما قد جنو","ت كما زعمت مضى ويهملك القضا",22,"ض",2,0],["أتظنُّ أنى قد أتيتُك","باحتيالٍ نادرِ",23,"ر",1,0],["أتظُنُّ هذا الظَّنَّ فِيْ","ىَ ونورُ وجهك لي جِلاءُ",24,"ا",2,0],["أتُظهِرُ في عرفانِ ما بي جهالةً","وما أَحدٌ في الناس منك سليمُ",25,"م",1,0],["أَتَظُنُّ أَرمانوسَ يَنسى يَومَهُ ال","مَشهودَ مَع مَن شَرَّدَتهُ ظُباكا",26,"ك",2,0],["أَتَظمى لَدَيكَ المشرفِيَّةُ وَالقَنا","وَفي قُلَلِ الباغينَ وِردٌ لِشارِبِ",27,"ب",1,0],["أَتَظُنُّني أَرضى بِحَسيِكَ مَنهَلاً","تَبّاً لِحَسيكَ أَحمَقاً ما أَبرَدا",28,"د",2,0],["أتظن إن أعرضت أن","هواك يعرض عن فؤادي",29,"د",2,0],["أَتَظُنُّني ما عِشتُ أَنعَمُ بالا","هَيهاتَ ذِلُّ العَيشِ بَعدَكَ زالا",30,"ل",2,1],["أَتَظُنَّني أَضمَرتُ بَعدَكَ سَلوَةً","هَيهاتَ عَطفُكَ مِن سُلوّي أَقرَبُ",31,"ب",1,0],["أتظنُ أني لا أتيه كما تتي","هُ أو انني مُستَسِلمٌ للياسِ",32,"س",1,0],["أتظما وَذا يحيى بن أَحمد في الذرى","شَريف منيف طال مجدا وَمفخرا",33,"ر",2,0],["أَتَظُنُّ أَنَّكَ ضائِرِي بِأَشَدَّ مِنْ","عُدْمِ الشَّبابِ وَفُرْقَةِ الأَحْبابِ",34,"ب",1,0],["أَتَظُنُّنِي لا أَسْتَطِي","عُ أُحِيلُ عَنْكَ الدَّهْرَ وُدِّي",35,"د",2,0],["أَتظلُّ تُسقى في الغَرام سُلافة","وأَظلُّ أسقى في الغَرام ذُعافا",36,"ف",2,0],["أتظن أنَّك نافعي من بعد ما","أنهجتمُ ومن رقعتي ديباجها",37,"ج",3,0],["أتظنون بأني ميتكم","ليس ذاك الميت واللَه أنا",38,"ن",2,0],["أَتَظُنّ اني من تباريح الضَنا","اِنجو وَقَد لاح العذار الاِخضر",39,"ر",1,0],["أَتَظُنُّ أنّي صابِرٌ وجوانحي","مَمْلوءةٌ للبُعْدِ منك جِراحا",40,"ح",2,0],["أَتَظُنُّ أَثوابَ الشَبابِ بِلَمَّتي","دَورَ الخضابِ فَما عَرَفتُ خضابي",41,"ب",2,0],["أتظنُّ هامان الذي استنجدتَه","مازال يُوقد للولاءِ شموعا؟!",42,"ع",2,0],["أتظنّه مازال يبني صرحَه","حتى تُطيق إلى السماءِ طلوعا؟!",42,"ع",2,0],["أتظنون بأني بعدكم","أطعم النوم إذا ما الليل جن",43,"ن",1,0],["أتظن من منكم يلي أمر الورى","يلقى قرابته بلا استخفاف",44,"ف",1,0],["أتظّنِني أرجُو عَواطِفَ وُدِّهِمْ","إنّي إذاً عبدُ المطامعِ أخْرقُ",45,"ق",1,0],["أَتَظُنُّ صَبرَكَ مُنجِداً إِن أَنْجدُوا","هيهاتَ ليس لِمُستهامٍ مُسعِدُ",46,"د",1,1],["أَتَظُنُّ يا إِدريسُ أَنَّكَ مُفلِتٌ","كَيدَ الخَليفَةِ أَو يَقيكَ فِرارُ",47,"ر",1,1],["أتظُنُّه يسلو هواك على النَّوى","تالله ما خطر السُّلُوُّ بباله",48,"ل",2,0],["أتظن أني صابر عن أرضهم","وأرى بريقاً نحوها يتلألأ",49,"ا",1,0],["أتظن أن الجبن يرفع أمة","أو أنه سيزيد في الأعمار",50,"ر",1,0],["أتظنّ عهد أبيك عهدا غادرا","وتخاف ما يأتي به الحدثان",51,"ن",1,0],["أتظُنُّ الدمعَ دَيْناً","تتقاضاه بعَتبي",52,"ب",2,0],["أتظنُّ تأخيرَ الإمام نقيصةً","والنقض للأطراف لا الأشراف",53,"ف",1,0],["أتظنني أرضى بما ملأ الثرى","نوء الثريا دون ما يرضيني",54,"ن",2,0],["أتظن الكلاب إذ نبحتني","أن تغبيرهم يدنس شاشي",55,"ش",2,0],["أتظن المشوق مثلك أعمى","عن بروق الحمى وتلك النواحي",56,"ح",2,0],["أَتظن في مَلكِ الملوكِ طماعةً","خابت ظنونُك فاختبي أَو فَاخْتَفي",57,"ف",2,0]]}