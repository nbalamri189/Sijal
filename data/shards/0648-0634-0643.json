ول لخصره","فأتى الشفاء لمدنف من مدنف",239,"ف",1,0],["وشكراً وحمداً ثم شكرا له على","يدا سدت النعما ولا برحت تسدي",240,"د",2,0],["وشكاية للوجد يبدي","ها لدى برج الخفاء",241,"ا",2,0],["وشكروا رب البرايا والعلا","وأدلجوا حتى دنوا من العلا",242,"ل",2,0],["وشكَت حمائمُ دَوحِهِ","ما قَد شَكَا للِدَّمعِ خَدِّي",243,"د",2,0],["وشَكت نُجومُ اللَّيلِ من سهَري وقَد","نَاحتَ لمَا أَلقَى الحَمامُ الهُتفُ",244,"ف",1,0],["وَشَكَرتُ الَّذينَ كانوا فَأهدي","تُ سَلامي إليهِمُ وَاِحتِرامي",245,"م",2,0],["وَشَكَرتُ ما أَولَيتَني","وَالحَقُّ مِثلي يَشكُرُه",246,"ر",2,0],["وَشكوتُ الأمرَ ممَّا","حلَّ بالقلبِ الحَمولِ",247,"ل",1,0],["وشكت حرَّ ما يُقا","سيهِ منهُ همومُهُ",248,"م",2,0],["وشكوى من حوادث موبقات","لقد جددن لي الحزن القديما",249,"م",2,0],["وشكرت للهادي به نعما","والحر إن ير نعمة شكرا",250,"ر",2,0],["وشكوايَ طالت غيومَ السماءِ","وآهاتُ حزني تئنُ وأكثرْ",251,"ر",1,0],["وشَكَرْتُهَا ويَدَايَ فَارِغَتَانِ مِن","يَدِهَا, وقَلبي كَأسُهُ مَلْآنُ",252,"ن",1,0],["وشُكرًا لِمَن سَلَّمُوا شَعبَهُم","وباتُوا حُمَاةً لِبَوَّابَتِكْ",253,"ك",1,0],["وشكبر عذري فرحتي بس انا احول","بقيت الأول وانت ساذج يا جفني",254,"ن",2,0],["وشكوى الود والنجوى على غيري وكابرها","وانا فيني التجلد طبع ولا مد التطبع ساق",255,"ق",1,0],["وشكيت .. لين النآس من عآم شآكين","وكلٍ يبي ديره .. ويبغا اميره",256,"ر",2,0],["وش كنت أقول إن قلت: ماقلت معذور","لاعذر لك ياراعي العذر غلطان!",257,"ن",1,0],["وَشَكَاْ صَلاْحُ الدِّيْنِ( ) لَمَّاْ عَرْبَدَتْ","مِحَنٌ أَثَاْرَ غُبَاْرَهَاْ أَحْفَاْدُهُ",258,"د",2,0],["وشكرا لها مصر الأحبة خالصا","على جهدها فالمنجزات غدت كبرى",259,"ر",2,0],["وشكوتُ أشجاني إليه وإنّما","هل يَفْقهُ اللّيمونُ كيف شجوني؟",260,"ن",2,0],["وشكتْ نفسُك مِن نفسِك أو","بالتّخلّي عنك أصبحتَ اتهامَك",261,"ك",1,0],["وشكت له الأوراق عند حفيفها","شجناً تردد في الغدير هديرا",262,"ر",2,0],["وَ شَكَا جَمِيْلُ بُثَيْنَةٍ آلامَهُ","غُصَصَاً يُكابِدُهَا بِشَوْقِ الحَائِرِ",263,"ر",1,0],["وشكلته ونقطته فأمنت من","تصحيفه ونجوت من تحريفه",264,"ف",2,0],["وشكرًا تزدهي وردًا","إلى كفّيكَ عبّاقا",265,"ق",2,0],["وشكرك أوزع يا شك