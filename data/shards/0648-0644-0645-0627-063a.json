{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[55,"عجبت من الأيام إنجازها وعدي","https://www.aldiwan.net/poem30624.html","الطويل"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[53,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[53,"صبرا أمير المؤمنينا","https://www.aldiwan.net/poem66412.html","مجزوء الكامل"],[47,"تحمل آل سعدى للفراق","https://www.aldiwan.net/poem65210.html","الوافر"],[47,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29360","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10884","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[53,"أبلغْ أباكَ إذا هلكتَ وقلْ لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=30745",""],[53,"سليمُ الزمان كمنكوبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=27033",""],[147,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[154,"ألا فاخش سهم الموت عن كل مرصد","https://www.aldiwan.net/poem68588.html","الطويل"],[159,"ولما غدا ورد الخدود بنفسجا","https://www.aldiwan.net/poem55552.html","الطويل"],[170,"ولما غادر الحدثان شلوي","https://www.aldiwan.net/poem47101.html","الوافر"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[227,"أجيبيه أني ما أزال مقربا","https://www.aldiwan.net/poem41600.html","الطويل"],[239,"أيا السيد ما ساع","https://www.aldiwan.net/poem32026.html","الهزج"],[352,"نأى بي عن موارده زماني","https://www.aldiwan.net/poem19870.html","الوافر"],[352,"وكان سداد الباب عن مسلك الهوى","https://www.aldiwan.net/poem20080.html","الطويل"],[368,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[368,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[441,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[445,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[461,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[461,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[461,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[480,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[518,"وسمت بنعماك الرقاب تبرعاً","https://www.aldiwan.net/poem12272.html","الكامل"],[578,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[589,"تحرش الطرف بين الجد واللعب","https://www.aldiwan.net/poem17437.html","البسيط"]],"verses":[["وَلَمّا غَوى الغاوُونَ فيكَ وَفُرِّجَت","ضُلوعٌ عَلى الغِلِّ القَديمِ حَواني",0,"ن",2,0],["وَلَمّا غَدَونا لِلوَداعِ وَنَقَّرَت","صُروفُ النَوى دونَ الخَليطِ المُجاوِرِ",1,"ر",1,0],["وَلَم أَغدُ مَحلولَ اللِحاظِ طَلاقَةً","وَقَلبي مَعقودُ الجَنانِ عَلى الحِقدِ",2,"د",1,0],["وَلمَا غَدَوْتُ عَلَى الفِرَاقِ كَمَا أُرَى","رُوحاً تَهُمُّ بِفُرْقَةِ الجُثْمَانِ",3,"ن",1,0],["وَلَمّا غَرَرتُم مِن أُناسٍ كَريمَةً","لَؤُمتُم وَضِقتُم بِالكَرائِمِ أَذرُعا",4,"ع",2,0],["ولمَّا غدا كلُّ هذه الورى","وممدوحُهُ مثلُ مندوبِهِ",5,"ب",2,0],["وَلَمَا غولِط الأميرُ ومن أي","ن وما غَوْر دَهْيِه بمقيس",6,"س",1,0],["ولم أغشها إلا عليماً بأنّها","هي المجدُ أو مطرورةُ الحدّ صَيْلَمُ",7,"م",1,0],["ولمَا غُبِنْتَ متاعَها","بل بعتها بيعاً ثمينا",8,"ن",2,0],["وَلَمّا غَرَّدَ الحادونَ حادَت","ظِباءُ الرَقمَتَينِ عَنِ التَلاقي",9,"ق",2,0],["وَلَمّا غَرَبَت أَعرافُ سَلمى","لَهُنَّ وَشَرَّقَت قُنَنُ القَنانِ",10,"ن",1,0],["ولما غدت أمي تمير بناتها","أغرت على العكم الذي كان يمنع",11,"ع",1,1],["ولما غسلناه وتمَّ جهازه","وأُودع تابوتاً يجلله ستر",12,"ر",1,0],["وَلَمّا غَفَت عَيني وَما عادَةً لَها","بِنَومٍ وَقَلبي بِالفُراقِ عَليلُ",13,"ل",1,0],["وَلَمّا غَدَوا نَحوَ المُصَلّى بِنَعشِهِ","تَقاصَرَ باعُ المَجدِ وَهوَ طَويلُ",14,"ل",1,0],["ولما غَنَوْا مكروهَ نفسِكَ عندها","لكنهم محبوبَ أنفسِهم عنوا",15,"ن",3,0],["ولمَّا غدا كلُّ هذا الورى","وممدوحُهُ مثلُ مندوبِهِ",16,"ب",2,0],["وَلَمّا غابَ عَنّا نُبتَ عَنهُ","كَما نابَ الحُسامُ عَنِ السِنانِ",17,"ن",1,0],["وَلَمّا غَدا رَكبُ الهَوى مُتَحَمِّلا","يَؤُمُّونَ مَن قَلبي إِلَيهِ تَبَتَّلا",18,"ل",2,0],["وَلَمَّا غَدا وَرْدُ الخُدُودِ بَنَفْسَجاً","وَرَاحَ عَقِيقُ الخَدِّ في الدَّمْعِ يَنْهَمِي",19,"م",2,1],["ولما غادرَ الحدثانِ شلوي","بمُستنِّ الخُطوبِ لقىً طَريحا",20,"ح",2,1],["ولمّا غَدا في القربِ وَالحبِّ مُفرداً","رَأى ربَّه لا كيفَ لا كمَّ لا حصرا",21,"ر",2,0],["وَلم أَغشَ أَخدارَ النِساءِ مِن الكوى","فَأَجعَل سَيّين المَغارَة وَالخدرا",22,"ر",2,0],["وَلَمّا غَلَبَ اليُبسُ","عَلى رَأسِكَ وَالبَردُ",23,"د",1,0],["وَلَمَّا غَابَ شَمْسُ الدِّينِ عَنّي","دَعَاني الظَّنُّ فِيهِ لارْتيابي",24,"ب",2,0],["وَلَمَّا غَدا إنسانَ عَيْنِ زَمَانِه","بَدا النُّور شَفَّافاً لَنا في سَوادهِ",25,"د",2,0],["ولمّا غدا عِزُّ دِينِ الهُدَى","لك اسْماً سواكَ به لم يُسَمّ",26,"م",1,0],["ولم أغتربْ إلاّ لأكتسبَ الغِنَى","فأسِقيَ منهمْ كُلَّ ذي ظَمأٍ سَجْلا",27,"ل",2,0],["ولما غدا مرسى فكلّم ربّه","جهراً ولم يشف المسيح عليلا",28,"ل",2,0],["ولما غاب قانصها","بها سكنت فرائصها",29,"ه",2,0],["ولم أَغبُن كمن يُعطى سروري","ويأخذُ طائعا همّي وحزني",30,"ن",2,0],["ولم أُغنِ عنهم غير من طال نبته","وطاب ولم أذهب إلى نابت البقلِ",31,"ل",1,0],["ولما غلِقتُ برهن الوفاء","لهم تركوني بنجدٍ وغاروا",32,"ر",3,0],["ولمّا غدا النّوارُ في الروضِ باسماً","وعاينتُ مِن ومضِ المباسمِ أنوارا",33,"ر",2,0],["ولم أغش هذا الباب أيام لم يكن","تضايقني فيه الرجال وتزحم",34,"م",1,0],["ولِمْ أَغَرْتِ على الأَرواحِ ناهِبَةً","إِن كان ذلك عن جُرْمٍ فلا جَرَما",35,"م",2,0],["ولم أغازِلْ فتاةَ الحيِّ مائِسةً","في رَوْضِها بين ذَاكَ الحَلْيِ والذَّهَبِ",36,"ب",1,0]]}