{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[55,"عجبت من الأيام إنجازها وعدي","https://www.aldiwan.net/poem30624.html","الطويل"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[53,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[53,"صبرا أمير المؤمنينا","https://www.aldiwan.net/poem66412.html","مجزوء الكامل"],[47,"تحمل آل سعدى للفراق","https://www.aldiwan.net/poem65210.html","الوافر"],[47,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29360","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10884","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[53,"أبلغْ أباكَ إذا هلكتَ وقلْ لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=30745",""],[53,"سليمُ الزمان كمنكوبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=27033",""],[147,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[154,"ألا فاخش سهم الموت عن كل مرصد","https://www.aldiwan.net/poem68588.html","الطويل"],[159,"ولما غدا ورد الخدود بنفسجا","https://www.aldiwan.net/poem55552.html","الطويل"],[170,"ولما غادر الحدثان شلوي","https://www.aldiwan.net/poem47101.html","الوافر"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[228,"أجيبيه أني ما أزال مقربا","https://www.aldiwan.net/poem41600.html","الطويل"],[240,"أيا السيد ما ساع","https://www.aldiwan.net/poem32026.html","الهزج"],[353,"نأى بي عن موارده زماني","https://www.aldiwan.net/poem19870.html","الوافر"],[353,"وكان سداد الباب عن مسلك الهوى","https://www.aldiwan.net/poem20080.html","الطويل"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[443,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[447,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[463,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[482,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[520,"وسمت بنعماك الرقاب تبرعاً","https://www.aldiwan.net/poem12272.html","الكامل"],[580,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[591,"تحرش الطرف بين الجد واللعب","https://www.aldiwan.net/poem17437.html","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110388","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53873","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70768","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72291","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72261","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56013","الوافر"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56583","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31638","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49938","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27455","الطويل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32585","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107004","الكامل"],[2667,"","https://poetry.dctabudhabi.ae/diwan/poem/146671","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75975","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100418","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113894","الطويل"],[3214,"","https://poetry.dctabudhabi.ae/diwan/poem/147648","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45816","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109894","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216765",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95325","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73299","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136614",""],[4755,"بِاسمِ البِلادِ أَصالةً، ونِيابةً","https://www.poetsgate.com/ViewPoem.aspx?id=202668",""],[4785,"عند الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129739",""],[4927,"دموع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29947",""],[5002,"حورية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=202370",""],[3591,"سعيدة حسن قد تصبت حشاشتي","https://www.poetsgate.com/ViewPoem.aspx?id=149382",""],[5145,"خليليّ إن لم تسعدا فدعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108058",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5691,"شدّوا الحزام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207057",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["وَلَمّا غَوى الغاوُونَ فيكَ وَفُرِّجَت","ضُلوعٌ عَلى الغِلِّ القَديمِ حَواني",0,"ن",2,0],["وَلَمّا غَدَونا لِلوَداعِ وَنَقَّرَت","صُروفُ النَوى دونَ الخَليطِ المُجاوِرِ",1,"ر",1,0],["وَلَم أَغدُ مَحلولَ اللِحاظِ طَلاقَةً","وَقَلبي مَعقودُ الجَنانِ عَلى الحِقدِ",2,"د",1,0],["وَلمَا غَدَوْتُ عَلَى الفِرَاقِ كَمَا أُرَى","رُوحاً تَهُمُّ بِفُرْقَةِ الجُثْمَانِ",3,"ن",1,0],["وَلَمّا غَرَرتُم مِن أُناسٍ كَريمَةً","لَؤُمتُم وَضِقتُم بِالكَرائِمِ أَذرُعا",4,"ع",2,0],["ولمَّا غدا كلُّ هذه الورى","وممدوحُهُ مثلُ مندوبِهِ",5,"ب",2,0],["وَلَمَا غولِط الأميرُ ومن أي","ن وما غَوْر دَهْيِه بمقيس",6,"س",1,0],["ولم أغشها إلا عليماً بأنّها","هي المجدُ أو مطرورةُ الحدّ صَيْلَمُ",7,"م",1,0],["ولمَا غُبِنْتَ متاعَها","بل بعتها بيعاً ثمينا",8,"ن",2,0],["وَلَمّا غَرَّدَ الحادونَ حادَت","ظِباءُ الرَقمَتَينِ عَنِ التَلاقي",9,"ق",2,0],["وَلَمّا غَرَبَت أَعرافُ سَلمى","لَهُنَّ وَشَرَّقَت قُنَنُ القَنانِ",10,"ن",1,0],["ولما غدت أمي تمير بناتها","أغرت على العكم الذي كان يمنع",11,"ع",1,1],["ولما غسلناه وتمَّ جهازه","وأُودع تابوتاً يجلله ستر",12,"ر",1,0],["وَلَمّا غَفَت عَيني وَما عادَةً لَها","بِنَومٍ وَقَلبي بِالفُراقِ عَليلُ",13,"ل",1,0],["وَلَمّا غَدَوا نَحوَ المُصَلّى بِنَعشِهِ","تَقاصَرَ باعُ المَجدِ وَهوَ طَويلُ",14,"ل",1,0],["ولما غَنَوْا مكروهَ نفسِكَ عندها","لكنهم محبوبَ أنفسِهم عنوا",15,"ن",3,0],["ولمَّا غدا كلُّ هذا الورى","وممدوحُهُ مثلُ مندوبِهِ",16,"ب",2,0],["وَلَمّا غابَ عَنّا نُبتَ عَنهُ","كَما نابَ الحُسامُ عَنِ السِنانِ",17,"ن",1,0],["وَلَمّا غَدا رَكبُ الهَوى مُتَحَمِّلا","يَؤُمُّونَ مَن قَلبي إِلَيهِ تَبَتَّلا",18,"ل",2,0],["وَلَمَّا غَدا وَرْدُ الخُدُودِ بَنَفْسَجاً","وَرَاحَ عَقِيقُ الخَدِّ في الدَّمْعِ يَنْهَمِي",19,"م",2,1],["ولما غادرَ الحدثانِ شلوي","بمُستنِّ الخُطوبِ لقىً طَريحا",20,"ح",2,1],["ولمّا غَدا في القربِ وَالحبِّ مُفرداً","رَأى ربَّه لا كيفَ لا كمَّ لا حصرا",21,"ر",2,0],["وَلم أَغشَ أَخدارَ النِساءِ مِن الكوى","فَأَجعَل سَيّين المَغارَة وَالخدرا",22,"ر",2,0],["وَلَمّا غَلَبَ اليُبسُ","عَلى رَأسِكَ وَالبَردُ",23,"د",1,0],["وَلَمَّا غَابَ شَمْسُ الدِّينِ عَنّي","دَعَاني الظَّنُّ فِيهِ لارْتيابي",24,"ب",2,0],["وَلَمَّا غَدا إنسانَ عَيْنِ زَمَانِه","بَدا النُّور شَفَّافاً لَنا في سَوادهِ",25,"د",2,0],["ولمّا غدا عِزُّ دِينِ الهُدَى","لك اسْماً سواكَ به لم يُسَمّ",26,"م",1,0],["ولم أغتربْ إلاّ لأكتسبَ الغِنَى","فأسِقيَ منهمْ كُلَّ ذي ظَمأٍ سَجْلا",27,"ل",2,0],["ولما غدا مرسى فكلّم ربّه","جهراً ولم يشف المسيح عليلا",28,"ل",2,0],["ولما غاب قانصها","بها سكنت فرائصها",29,"ه",2,0],["ولم أَغبُن كمن يُعطى سروري","ويأخذُ طائعا همّي وحزني",30,"ن",2,0],["ولم أُغنِ عنهم غير من طال نبته","وطاب ولم أذهب إلى نابت البقلِ",31,"ل",1,0],["ولما غلِقتُ برهن الوفاء","لهم تركوني بنجدٍ وغاروا",32,"ر",3,0],["ولمّا غدا النّوارُ في الروضِ باسماً","وعاينتُ مِن ومضِ المباسمِ أنوارا",33,"ر",2,0],["ولم أغش هذا الباب أيام لم يكن","تضايقني فيه الرجال وتزحم",34,"م",1,0],["ولِمْ أَغَرْتِ على الأَرواحِ ناهِبَةً","إِن كان ذلك عن جُرْمٍ فلا جَرَما",35,"م",2,0],["ولم أغازِلْ فتاةَ الحيِّ مائِسةً","في رَوْضِها بين ذَاكَ الحَلْيِ والذَّهَبِ",36,"ب",1,0],["ولمَّا غبتَ عن لبنانَ كادت","رباهُ لفرطِ لوعتها تميدُ",37,"د",1,0],["ولَمّا غَدَا في جودِه كابنِ طاهِرٍ","غَدَوْتُ له في المدح كابن مُحَلَّمِ",38,"م",1,0],["ولما غرابُ البين قد صاح بيننا","وقد نكصَ الواشونَ في قولهم نكْصا",39,"ص",2,0],["ولما غدت كالعاج زين صدرها","بحقين منه قد أجادهما الخرط",40,"ط",1,0],["ولما غدت لا ماء في جنباتها","صببنا عليها وابلاً من دم سكب",41,"ب",1,0],["ولما غاب يوماً عنها غيباً","لعمودٍ يرتجى لا للهجورِ",42,"ر",1,0],["ولما غدا قول الصواب مذمماً","عزمتُ على أن لا أقول صوابا",43,"ب",2,0],["ولَمّا غازَلَتْها الرّيحُ خِلْنا","بِها جَيْشَيْ وَغىً يَتَقاتَلانِ",44,"ن",1,0],["ولم اغْتَرِرْ بالْخَائنينَ وإنَّما","صَحبتُ المُداجي حينَ عزَّ المُناصحُ",45,"ح",1,0],["ولم أغل بل قلت الذي قال ربنا","وجئت به فضلاً مبيناً لأرشدا",46,"د",2,0],["وَلَم أَغدُ في أَمرٍ أُريدُ نَجاحَهُ","فَقابَلَني إِلّا غُرابٌ وَأَرنَبُ",47,"ب",1,0],["ولما غمدت السيف دون كناسه","لو كان مخترطاً من الأجفان",48,"ن",1,0],["ولما غاب عني غاض صبري","وفاض الدمع عن عيني فيضا",49,"ض",2,1],["وَلَما غَنُوا عَن سيبويهِ تَعوَّضوا","بكُنّاشَةٍ جَدّاءَ مِن شَرِّ أَعواضِ",50,"ض",1,0],["ولم اغد حتى تنظر العين غدوة","على رامة ريماً تذبذب قرطاه",51,"ا",2,0],["ولما غدت بيت اللئام غريبة","أهينت بعبث الخائنين فواها",52,"ا",3,0],["ولما غدوا بالغيد فوق جمالهم","طفقت أنادي لا أطيق بهم همسا",53,"س",2,1],["وَلما غَدا كَالعيد يَوم جُلوسه","تَحَلَت بِأَيام العَزيز المَواسم",54,"م",1,0],["وَلمَّا غابَ ذاك النَدبُ عنا","تَبدَّى النَدبُ وانتُدِبَ البُكَاءُ",55,"ا",2,0],["ولما غدت كفؤ الحوا","دث وهي تقبل في اطراد",56,"د",1,0],["ولما غدا البلقان ملتمع الظبى","غدت مصر للعافين منتجع البر",57,"ر",1,0],["ولم أُغادر منه حرفاً واحدا","إلا إذا كان غريباً زائدا",58,"د",2,0],["وَلَمَّا غَدا في القَلبِ مَوضعَ سِرِّهِ","وَعايَنَ ما أَصلَى الفُؤادَ وَما أَبلى",59,"ل",2,0],["ولمّا غرقتُ بيم الدمُوع","ولم يلُقني اليمُّ بالساحِل",60,"ل",1,0],["ولَمَا غَدَا الوَطَنُ المُطَهَّرُ دَاجِيًا","في كُلِّ رُكنٍ مُشرِفٌ وإِمَامُ",61,"م",1,0],["ولمَّا غدونا بنِصْفِ الطريقِ","رجعتِ، وليتَكِ لم ترجعي",62,"ع",2,0],["وَلَمَّا غَزَتْ عَفراءُ قَلبِيَ سَطَّرَتْ","كِتَاْباً بِهِ شِعْرٌ، وَنَثْرٌ، وَمَسْرَحُ",63,"ح",1,0],["ولم أغترفْ غير النَّوى بات يرقدُ","به نعسَ الوجدان والعمر شاهدي",64,"د",2,0],["ولما غدوتُ اليوم من أرب الدمى","تذكرتها والقلب كان لها أصبى",65,"ب",2,0],["ولما غدا دست الوزارة عاطلا","تخونها الشنفان والبرنان",66,"ن",1,0],["ولما غزا عبد العزيز بجنده","وسار بهم نحو الكويت لما يجر",67,"ر",1,0],["ولما غدا من هوله ووقوعه","في كل قلب موجد ايلام",68,"م",1,0],["ولمّا غدا في حيْصِ بيْصِ دليلُنا","وحارَ بنا عنْدَ الوَزيرِ المُحاسِبُ...",69,"ب",1,0],["ولمّا غابَ نورُ الدِّي","نِ عنّا أظلمَ الحَفْلُ",70,"ل",1,0],["ولم أغادر ذرة من الزلل","آتي معاصيك على غير وجل",71,"ل",1,0]]}