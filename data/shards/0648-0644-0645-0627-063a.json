{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"عجبت من الأيام إنجازها وعدي","https://www.aldiwan.net/poem30624.html","الطويل"],[93,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[51,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"صبرا أمير المؤمنينا","https://www.aldiwan.net/poem66412.html","مجزوء الكامل"],[45,"تحمل آل سعدى للفراق","https://www.aldiwan.net/poem65210.html","الوافر"],[45,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10884","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[51,"أبلغْ أباكَ إذا هلكتَ وقلْ لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=30745",""],[51,"سليمُ الزمان كمنكوبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=27033",""],[144,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[151,"ألا فاخش سهم الموت عن كل مرصد","https://www.aldiwan.net/poem68588.html","الطويل"],[156,"ولما غدا ورد الخدود بنفسجا","https://www.aldiwan.net/poem55552.html","الطويل"],[167,"ولما غادر الحدثان شلوي","https://www.aldiwan.net/poem47101.html","الوافر"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[224,"أجيبيه أني ما أزال مقربا","https://www.aldiwan.net/poem41600.html","الطويل"],[236,"أيا السيد ما ساع","https://www.aldiwan.net/poem32026.html","الهزج"],[349,"نأى بي عن موارده زماني","https://www.aldiwan.net/poem19870.html","الوافر"],[349,"وكان سداد الباب عن مسلك الهوى","https://www.aldiwan.net/poem20080.html","الطويل"],[365,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[365,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[438,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[442,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[459,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[459,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[459,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[478,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[516,"وسمت بنعماك الرقاب تبرعاً","https://www.aldiwan.net/poem12272.html","الكامل"],[576,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[587,"تحرش الطرف بين الجد واللعب","https://www.aldiwan.net/poem17437.html","البسيط"]],"verses":[["وَلَمّا غَوى الغاوُونَ فيكَ وَفُرِّجَت","ضُلوعٌ عَلى الغِلِّ القَديمِ حَواني",0,"ن",2,0],["وَلَمّا غَدَونا لِلوَداعِ وَنَقَّرَت","صُروفُ النَوى دونَ الخَليطِ المُجاوِرِ",1,"ر",1,0],["وَلَم أَغدُ مَحلولَ اللِحاظِ طَلاقَةً","وَقَلبي مَعقودُ الجَنانِ عَلى الحِقدِ",2,"د",1,0],["وَلمَا غَدَوْتُ عَلَى الفِرَاقِ كَمَا أُرَى","رُوحاً تَهُمُّ بِفُرْقَةِ الجُثْمَانِ",3,"ن",1,0],["وَلَمّا غَرَرتُم مِن أُناسٍ كَريمَةً","لَؤُمتُم وَضِقتُم بِالكَرائِمِ أَذرُعا",4,"ع",2,0],["ولمَّا غدا كلُّ هذه الورى","وممدوحُهُ مثلُ مندوبِهِ",5,"ب",2,0],["وَلَمَا غولِط الأميرُ ومن أي","ن وما غَوْر دَهْيِه بمقيس",6,"س",1,0],["ولم أغشها إلا عليماً بأنّها","هي المجدُ أو مطرورةُ الحدّ صَيْلَمُ",7,"م",1,0],["ولمَا غُبِنْتَ متاعَها","بل بعتها بيعاً ثمينا",8,"ن",2,0],["وَلَمّا غَرَّدَ الحادونَ حادَت","ظِباءُ الرَقمَتَينِ عَنِ التَلاقي",9,"ق",2,0],["وَلَمّا غَرَبَت أَعرافُ سَلمى","لَهُنَّ وَشَرَّقَت قُنَنُ القَنانِ",10,"ن",1,0],["ولما غسلناه وتمَّ جهازه","وأُودع تابوتاً يجلله ستر",11,"ر",1,0],["وَلَمّا غَفَت عَيني وَما عادَةً لَها","بِنَومٍ وَقَلبي بِالفُراقِ عَليلُ",12,"ل",1,0],["وَلَمّا غَدَوا نَحوَ المُصَلّى بِنَعشِهِ","تَقاصَرَ باعُ المَجدِ وَهوَ طَويلُ",13,"ل",1,0],["ولما غَنَوْا مكروهَ نفسِكَ عندها","لكنهم محبوبَ أنفسِهم عنوا",14,"ن",3,0],["ولمَّا غدا كلُّ هذا الورى","وممدوحُهُ مثلُ مندوبِهِ",15,"ب",2,0],["وَلَمّا غابَ عَنّا نُبتَ عَنهُ","كَما نابَ الحُسامُ عَنِ السِنانِ",16,"ن",1,0],["وَلَمّا غَدا رَكبُ الهَوى مُتَحَمِّلا","يَؤُمُّونَ مَن قَلبي إِلَيهِ تَبَتَّلا",17,"ل",2,0],["وَلَمَّا غَدا وَرْدُ الخُدُودِ بَنَفْسَجاً","وَرَاحَ عَقِيقُ الخَدِّ في الدَّمْعِ يَنْهَمِي",18,"م",2,1],["ولما غادرَ الحدثانِ شلوي","بمُستنِّ الخُطوبِ لقىً طَريحا",19,"ح",2,1],["ولمّا غَدا في القربِ وَالحبِّ مُفرداً","رَأى ربَّه لا كيفَ لا كمَّ لا حصرا",20,"ر",2,0],["وَلم أَغشَ أَخدارَ النِساءِ مِن الكوى","فَأَجعَل سَيّين المَغارَة وَالخدرا",21,"ر",2,0],["وَلَمّا غَلَبَ اليُبسُ","عَلى رَأسِكَ وَالبَردُ",22,"د",1,0],["وَلَمَّا غَابَ شَمْسُ الدِّينِ عَنّي","دَعَاني الظَّنُّ فِيهِ لارْتيابي",23,"ب",2,0],["وَلَمَّا غَدا إنسانَ عَيْنِ زَمَانِه","بَدا النُّور شَفَّافاً لَنا في سَوادهِ",24,"د",2,0],["ولمّا غدا عِزُّ دِينِ الهُدَى","لك اسْماً سواكَ به لم يُسَمّ",25,"م",1,0],["ولم أغتربْ إلاّ لأكتسبَ الغِنَى","فأسِقيَ منهمْ كُلَّ ذي ظَمأٍ سَجْلا",26,"ل",2,0],["ولما غدا مرسى فكلّم ربّه","جهراً ولم يشف المسيح عليلا",27,"ل",2,0],["ولما غاب قانصها","بها سكنت فرائصها",28,"ه",2,0],["ولم أَغبُن كمن يُعطى سروري","ويأخذُ طائعا همّي وحزني",29,"ن",2,0],["ولم أُغنِ عنهم غير من طال نبته","وطاب ولم أذهب إلى نابت البقلِ",30,"ل",1,0],["ولما غلِقتُ برهن الوفاء","لهم تركوني بنجدٍ وغاروا",31,"ر",3,0],["ولمّا غدا النّوارُ في الروضِ باسماً","وعاينتُ مِن ومضِ المباسمِ أنوارا",32,"ر",2,0],["ولم أغش هذا الباب أيام لم يكن","تضايقني فيه الرجال وتزحم",33,"م",1,0],["ولِمْ أَغَرْتِ على الأَرواحِ ناهِبَةً","إِن كان ذلك عن جُرْمٍ فلا جَرَما",34,"م",2,0],["ولم أغازِلْ فتاةَ الحيِّ مائِسةً","في رَوْضِها بين ذَاكَ الحَلْيِ والذَّهَبِ",35,"ب",1,0]]}