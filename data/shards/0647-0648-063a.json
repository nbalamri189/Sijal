{"poems":[[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[87,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[64,"اسعد بيوم قد أتاك مبكرا","https://www.aldiwan.net/poem52391.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[132,"قيل لي أنت في مديحك تغلو","https://www.aldiwan.net/poem50545.html","الخفيف"],[132,"رحم الله من نأى ورمانى","https://www.aldiwan.net/poem50619.html","الخفيف"],[276,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[309,"خذ يمينا خذ يمينا","https://www.aldiwan.net/poem16907.html","مجزوء الرمل"],[374,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[398,"سيد الناس حيدره","https://www.aldiwan.net/poem53556.html","مجزوء الخفيف"],[409,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[435,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[458,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[563,"يا للبرية إن قلبي ما ارتوى","https://www.aldiwan.net/poem34221.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138279",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126822","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105517","الخفيف"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98210","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78053","المتدارك"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79928","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79842","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48988","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123097","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27221","الخفيف"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216396",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137251",""],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102716","المواليا"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127369","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118831","الخفيف"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70362","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89105","الكامل"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100578","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205741","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44900","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123526","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83646","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83356","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4718,"بنيتله بيتٍ وعليت مبناه","https://www.poetsgate.com/ViewPoem.aspx?id=137301",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5191,"العِطر","https://www.poetsgate.com/ViewPoem.aspx?id=212016",""],[1696,"اللَه اللَه اللَه","https://www.poetsgate.com/ViewPoem.aspx?id=173328",""],[5277,"أجبرني يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=194608",""],[5470,"نقوش البلادة","https://www.poetsgate.com/ViewPoem.aspx?id=10993",""],[5691,"أزمان مستنسَخة","https://www.poetsgate.com/ViewPoem.aspx?id=206154",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""],[5956,"أوحى له جبريل","https://www.poetsgate.com/ViewPoem.aspx?id=192632",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""],[6001,"الغلا كله","https://www.poetsgate.com/ViewPoem.aspx?id=473",""]],"verses":[["هوَ غُرَّةُ الزّمنِ الكَثيرِ شِياتُهُ","زُهِيَ السّريرُ بهِ وتاهَ المِنْبَرُ",0,"ر",1,0],["هُوَ غُرَّةُ الأَيّامِ فيهِ وَكُلُّكُم","آحادُهُ في فَضلِها وَسُبوتُهُ",1,"ت",2,0],["هو غرسُ أنْعُمِكَ الجزيلةِ فاسقِهِ","بسِجالِ أنعُمِك الجِسامِ لِيُثْمِرا",2,"ر",2,0],["هُوَ غَرْسٌ آوَتْ فَكَانَ أَفَانِ","نَ تَسُرُّ النُّهَى مِنَ الثَّمَرَاتِ",3,"ت",1,0],["هو غيثٌ ونحنُ نشكرُه كا","لرَّوْضِ يُنْمِى الأزهار لا نحن نَعْلُو",4,"ل",2,0],["هو غيثٌ وليس يُحصى قطارُهُ","بل خِضَمٌّ لا ينتهى مِقدارُه",5,"ر",2,0],["هُوَ غيم مرحمة عيد ظلاله","وَيَفيض نائله لكل موحد",6,"د",1,0],["هو غفار الخطايا","هو خير الراحمينا",7,"ن",2,0],["هو غَّرةُ الزمن البهيم وعصمةُ","الملك العقيم وغوث كل مؤيِّه",8,"ه",1,0],["هُو غَيظٌ لنا صبي","نَ وَحَتفٌ لِمُجبَرَه",9,"ر",2,0],["هو غيث للسائلين مغيث","وعلى المارقين ليث يصول",10,"ل",1,0],["هو غوثٌ راحتاه","بالندى كالغيث تمنح",11,"ح",1,0],["هو غايةُ الإجرامِ للوطنِ الذي","عانى وعانى من أذاهُ خسائرا",12,"ر",2,0],["هو غير قرب والجهول له العمى","فاعجب لنور فيه كوني أظلما",13,"ا",1,0],["هو غرة يجبينها بل تاج ها","متها الذي تزهو به الأعصار",14,"ر",1,0],["هو غوث أبناء العلوم وكهفهم","وله عليهم منّةٌ وتفضّلُ",15,"ل",1,0],["هو غوثي وحبذا هو غوث","هو سؤلي وحبذا هو سولا",16,"ل",2,0],["هو غيث إن أقلعت سحب الغيث","وغوث إن عز كهف ومقصد",17,"د",1,0],["هو غصنٌ والحسن في الغصن النا","عم ما كان مائلاً يتأود",18,"د",1,0],["هُوَ غُصن يَحمل يَحمل شَمس ضُحى","وَالفرع كَليل أَرسَلَهُ",19,"ل",2,0],["هو غيثُ مكرمةٍ وبدرُ مفاخرٍ","ومحطُّ آمالٍ وأمنُ مَخوفِ",20,"ف",1,0],["هو غصنُ مجدٍ ذو مخايل بَشّرت","أن سوف يُثمر سؤدداً وعلاءا",21,"ا",3,0],["هو غُصنٌ أَهوتْ إليهِ المعَالي","يَدَها فاْنحنتْ به الأَعْباء",22,"ا",2,0],["هو غيث لا ينقضي سحّه لو","رصعته البيضاء والصفراء",23,"ا",2,0],["هو غصن هو بد كلما","ماس تيهاً ودلالاً قد بدا",24,"د",2,0],["هو غيري إذا بعثت رسولاً","وهو داري بقدس دار نظامي",25,"م",2,0],["هو غير إذا افترقت أمامي","وإذا ما اجتمعت كنت أمامي",25,"م",2,0],["هو غناة النفس بالحِلّي","ما تِشوف الناس من دونه",26,"ن",2,0],["هو غايتي القصوى وبدء سعادتي","ومحط آمالي ومسك ختامي",27,"م",2,0],["هو غوى في طريق أو هو معا شخص موجود","أو سحر يا علي أو صيب أو صار مكيود",28,"د",1,0],["هو غيث والغيث قد عم قدماً","بخصوص العباس بعد احتباس",29,"س",1,0],["هو غريد إذا غنى رقص","كل غصن طربا والكأس دار",30,"ر",1,0],["هو غوثي إذا طلبت غياثاً","ومعيني على المراد الخطير",31,"ر",1,0],["هو غَض عَلَى الزَّمانِ لَذيذٌ","دَرْسُهُ لا يَمَله تَرْدَادُهْ",32,"د",2,0],["هو غاية في حلمه ووفائه","ونهايةٌ في سره والجهر",33,"ر",1,0],["هو غيث إن ضن دهر وغوث","إن ألمت بنا يد الحدثان",34,"ن",1,0],["هو غيبٌ فكيف لا يعلم الغي","بَ ودهر فكيف يجهل دهرا",35,"ر",2,0],["هُوَ غامضٌ عَن علمِهم مُتَنَكرٌ","لَكِنَّهُ في وَجهكَ الضاحي عَلَمْ",36,"م",1,0],["هو غيث غوث معين مغيث","محسن ما بلا أجاب سؤالا",37,"ل",2,0],["هو غاي المُنى وَحَقِّ حَبيبي","عندَ أَهلِ النُهى ذوي الأَذواقِ",38,"ق",1,0],["هُوَ غَوثي وَمَفزَعي وَمَلاذي","إِن جَفا الدَهرُ أَو سَطت بلواهُ",39,"ا",2,0],["هو غوث الهدى وحتفُ يغوثٍ","ويعوقٍ وودِّهم وسواع",40,"ع",1,0],["هو غايتي هو مطلبي واتمناه","كللي لها ملكٍ وقلبي لها عرش",41,"ش",1,0],["هو غضبة ٌ فَجَرت ْ هنا وتَفَجّرت ْ","خابت ْ وخاب َ دَعِيُّها والمُرْسِل ُ",42,"ل",1,0],["هو غصّةٌ، حرقُ الحنينِ ولمْ","أسْطِعْ لحرقِ حنينِهِ.. صبرا",43,"ر",2,0],["هو غيث مرحمة يعمم جميعنا","هتانه كل الورى ريان",44,"ن",1,0],["هوَ غافرُ الذنبِ الَّذي من عفوِهِ","يهبُ السماحَ منَ العطايا الوافرهْ",45,"ر",2,0],["هُوَ غَبنٌ هَاهُنَا فِي دَاخِلِي","يَحتَسِي الجَمرَ وَيَقْتَاتُ اتِّقَادَهْ",46,"د",2,0],["هوَ غافِلٌ تَعْمى بَصيرَتُهُ","وفُؤادُهُ قدْ غاصَ في الرّانِ !",47,"ن",1,0],["هو غرس آوت فكان أفانين","تسر النهى من الثمرات",48,"ت",1,0],["هو غير ممتنٍّ على أحدٍ بما","يعطيه من هدْي ولا يستاءُ",49,"ا",2,0],["هو غرقانٌ بتختٍ","ليس غرقانَ المراكبْ",50,"ب",1,0],["هو غير محتاج لأي تشكرٍ","وتعبّدٍ أو أن أكون كفورا",51,"ر",2,0],["هو غايتي ومنيتي ما ينوجد مثله","هو راحتي وهو بداياتي ونهاياتي",52,"ت",2,0]]}