{"poems":[[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[62,"اسعد بيوم قد أتاك مبكرا","https://www.aldiwan.net/poem52391.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[128,"قيل لي أنت في مديحك تغلو","https://www.aldiwan.net/poem50545.html","الخفيف"],[128,"رحم الله من نأى ورمانى","https://www.aldiwan.net/poem50619.html","الخفيف"],[271,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[304,"خذ يمينا خذ يمينا","https://www.aldiwan.net/poem16907.html","مجزوء الرمل"],[369,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[393,"سيد الناس حيدره","https://www.aldiwan.net/poem53556.html","مجزوء الخفيف"],[403,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[429,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[453,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[558,"يا للبرية إن قلبي ما ارتوى","https://www.aldiwan.net/poem34221.html","الكامل"]],"verses":[["هوَ غُرَّةُ الزّمنِ الكَثيرِ شِياتُهُ","زُهِيَ السّريرُ بهِ وتاهَ المِنْبَرُ",0,"ر",1,0],["هُوَ غُرَّةُ الأَيّامِ فيهِ وَكُلُّكُم","آحادُهُ في فَضلِها وَسُبوتُهُ",1,"ت",2,0],["هو غرسُ أنْعُمِكَ الجزيلةِ فاسقِهِ","بسِجالِ أنعُمِك الجِسامِ لِيُثْمِرا",2,"ر",2,0],["هُوَ غَرْسٌ آوَتْ فَكَانَ أَفَانِ","نَ تَسُرُّ النُّهَى مِنَ الثَّمَرَاتِ",3,"ت",1,0],["هو غيثٌ ونحنُ نشكرُه كا","لرَّوْضِ يُنْمِى الأزهار لا نحن نَعْلُو",4,"و",1,0],["هو غيثٌ وليس يُحصى قطارُهُ","بل خِضَمٌّ لا ينتهى مِقدارُه",5,"ر",2,0],["هُوَ غيم مرحمة عيد ظلاله","وَيَفيض نائله لكل موحد",6,"د",1,0],["هو غفار الخطايا","هو خير الراحمينا",7,"ن",2,0],["هو غَّرةُ الزمن البهيم وعصمةُ","الملك العقيم وغوث كل مؤيِّه",8,"ه",1,0],["هُو غَيظٌ لنا صبي","نَ وَحَتفٌ لِمُجبَرَه",9,"ر",2,0],["هو غيث للسائلين مغيث","وعلى المارقين ليث يصول",10,"ل",1,0],["هو غوثٌ راحتاه","بالندى كالغيث تمنح",11,"ح",1,0],["هو غايةُ الإجرامِ للوطنِ الذي","عانى وعانى من أذاهُ خسائرا",12,"ر",2,0],["هو غير قرب والجهول له العمى","فاعجب لنور فيه كوني أظلما",13,"ا",1,0]]}