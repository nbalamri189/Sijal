{"poems":[[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[23,"ألم ترنا أولاد عمرو بن عامر","https://www.aldiwan.net/poem21343.html","الطويل"],[74,"بروحي مقلة لك في فؤادي","https://www.aldiwan.net/poem20097.html","الوافر"],[91,"هل الرزايا يا ترى عالمه","https://www.aldiwan.net/poem44956.html","السريع"],[47,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[71,"عثا في عرضه قوم سلاط","https://www.aldiwan.net/poem28860.html","الوافر"],[83,"عميد أصيب عن عمد","https://www.aldiwan.net/poem61406.html","الطويل"],[50,"مجون صب في صنم","https://www.aldiwan.net/poem66283.html","مجزوء الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54640","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55094","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43744","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[108,"تقدير أديب","https://www.poetsgate.com/ViewPoem.aspx?id=179698",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[132,"توفى راشد والى الإمام","https://www.aldiwan.net/poem50498.html","الوافر"],[132,"توفى بحر الجود والزهد والتقى","https://www.aldiwan.net/poem50512.html","الطويل"],[132,"توفى محمود الفضال ولينا","https://www.aldiwan.net/poem50622.html","الطويل"],[132,"توفى ركن الدين والعلم والهدى","https://www.aldiwan.net/poem50627.html","الطويل"],[170,"ألا سقيت أطلال ليلى وإن عفت","https://www.aldiwan.net/poem46849.html","الطويل"],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[189,"دخلت حماما على غرة","https://www.aldiwan.net/poem14671.html","السريع"],[230,"توفيق مصر العام وافى سعده","https://www.aldiwan.net/poem55238.html","الكامل"],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[308,"له مقلة قد غادرتني بمهجة","https://www.aldiwan.net/poem57982.html","الطويل"],[358,"ألا لله عاقبة الأمور","https://www.aldiwan.net/poem40214.html","الوافر"],[396,"يارب يارب جيناطا معين","https://www.aldiwan.net/poem54479.html","عموديه"],[401,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[447,"عزاء وصبرا كل حي فميت","https://www.aldiwan.net/poem14441.html","الطويل"],[447,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[556,"وللغصن يرمى كل يوم بشاذب","https://www.aldiwan.net/poem48066.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138345",""],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139019",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66695","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87062","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86958","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86936","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63872","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77487","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56103","الوافر"],[1290,"","https://poetry.dctabudhabi.ae/diwan/poem/116812","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47472","البسيط"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104409","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95562","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66233","الكامل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101737","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87788","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137023",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137395",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65959","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87370","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112315","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89152","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88934","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86278","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108173","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92067","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131203",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133309","الكامل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141838","الكامل"],[4169,"","https://poetry.dctabudhabi.ae/diwan/poem/116598","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54481","المنسرح"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83515","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72859","البسيط"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139856",""],[4992,"الدم الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=6316",""],[5055,"الروح للروح","https://www.poetsgate.com/ViewPoem.aspx?id=108496",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[5652,"معالي / توفيق الربيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177752",""],[5779,"توفي الجمال الفائزي وإنه","https://www.poetsgate.com/ViewPoem.aspx?id=189114",""],[5956,"توفي أحمدٌ صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=192504",""],[5956,"تُوُفِّيتَ يا عبدَ هادي ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=192984",""],[5956,"مضى عبدُ هادي لخلدِ النعيم","https://www.poetsgate.com/ViewPoem.aspx?id=192987",""],[6056,"الجادل المختال","https://www.poetsgate.com/ViewPoem.aspx?id=130360",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[4222,"توفي العاضد الدعي فما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52887&r=&rc=179",""]],"verses":[["تُوَفّي لِيَومٍ وَفي لَيلَةٍ","ثَمانينَ نَحسُبُ إِستارَها",0,"ر",3,0],["تُوَفَّقُ في أَحكامِنا حُكَماؤُنا","إِذا غَيرُهُم في مِثلِها لَم يُوَفَّقِ",1,"ق",1,0],["توفّر لوعتي وتصيب قلبي","فلي منها على الحالين سهم",2,"م",1,0],["توفيت كريمة أصبح ال","مجد عليها نفسُهُ آلمه",3,"م",2,0],["تُوَفّى دُيونُ المُنعِمينَ وَيُقتَنى","لَهُم مِن بَواقي ما أَعاضَتهُمُ فَخرُ",4,"ر",1,0],["تُوُفِّيَتِ الآمالُ بَعدَ مُحَمَّدٍ","وَأَصبَحَ في شُغلٍ عَنِ السَفَرِ السَفرُ",5,"ر",1,0],["توفي وهْوَ محبوسٌ فريدٌ","وليسَ لهُ إلى الدنيا انبساطُ",6,"ط",1,0],["تَوَفّي ما عَلَيكِ بِجيدِ اِن جيد","تَراهُ الشُموس بِعَين حَسرَه",7,"ه",1,0],["توفّت عقلَهُ الصهبا","ءُ في داجٍ من الظلم",8,"م",1,0],["تَوْفِيقُ أَخْطَأَكَ الَّذِي تُدْعَى بِهِ","وَالمَوْتُ لاَ يَرْعَى لِحَيٍّ جَانِبَا",9,"ب",2,0],["تَوْفِيقُ نَمْ وَزُرِ الحَسُودَ مُؤَرِّقاً","مَا عَاشَ مَوْكُولاً لَهَمٍّ نَاحِبِ",10,"ب",1,0],["تَوْفِيقُ يَا طَالِبَ المَعَالِي","مَنْ حَسَبَ المَوْتَ فِي طَلابِكْ",11,"ك",1,1],["تَوْفِيقُ إِنْ تَذْهَبْ فَكمُلُّ","مُزْمِعٌ هَذَا الذَِهَابْ",12,"ب",1,0],["تُوُفّي مَن كُنتُ أرقي وَهَل","تَقي المَوت عيسي أَناجيلُهُ",13,"ه",1,1],["تَوُفّي الخَلَفُ الزاكي وَعِشتُ كَما","تَرضى العِدا عَيشَ مَكروبٍ وَمَكروثِ",14,"ث",1,0],["تُوُفّوا عِطاشاً بِالعَراءِ فَلَيتَني","تُوُفّيتُ فيهِم قَبلَ حينِ وَفاتي",15,"ت",2,0],["«توفيقُ»، يهنيك تقديرُ الرئيس، وإن","تكن قضيت حقوق الفنِّ محتسبًا",16,"ب",2,0],["توفتهم آجالهم وبأثرهم","نسير الى حيث استقروا سنقدم",17,"م",1,0],["توفنا طراً على الإيمان","عند انتها الآجال بالإحسان",18,"ن",1,0],["توفى راشدُ والِى الإمامِ","فتى خلف الفقيد ابن الكرامِ",19,"م",1,1],["تُوُفِّىَ بحرُ الجودِ والزهدِ والتقى","ونورُ دياجينا علىُّ بن سالم",20,"م",1,1],["تُوفّىَ محمودُ الفِضال وليُّنَا","هو الندبُ عبدُ الله نسلُ الفتى حمدْ",21,"د",1,1],["تُوفّىَ ركنُ الدين والعلم والهدَى","عليُّ بن مسعود سليلُ محمدِ",22,"د",1,1],["تُوفيتِ اللذاتُ في عَرَصاتِها","لذاك بكتْ نوَّاحةً ورشانُها",23,"ن",3,0],["تُوفي ثَلاثَةَ آلافٍ مُضَمَّنَةً","وَلا تجاوِزُ في عَدٍّ ثَلاثينا",24,"ن",2,0],["تَوفُّراً مني على راحةٍ","أَحظَى بها إثْرَ كَلالٍ وأَيْنْ",25,"ن",1,0],["توفيقَ مصرَ العامُ وافى سعدُه","وَسعى إِلَيكَ بِفَيضِه المُتكاثِرِ",26,"ر",1,1],["توفي ديونا لي عليها قديمة","واكثر ما تلوى المها بديونها",27,"ن",3,0],["توفر سقمي أو تصيب مقاتلي","فلا بد لي في ذا وذلك من سهم",28,"م",1,0],["تَوفّى وَهوَ في ضنك يُنادي","أَلَيسَ لِمُستَجير مِن مُجيرِ",29,"ر",1,0],["توفنا يا إلهي مؤمنين","نبعث ونحشر من الخوف آمنين",30,"ن",1,0],["تُوفي الحمامُ عليه كلَّ ضاحيةٍ","وللضفادِع في حافاته جَرَسُ",31,"س",1,0],["توفي أَبوسيت لأول ضحوة","لفي رجب وهو الأَصت المسمت",32,"ت",1,0],["توفته الخطوب وما وقته","مهابته عن الموت الزؤام",33,"م",1,0],["تُوُفّيتَ دونِي غَيرَ أَنَّكَ هالكاً","توفّيتَ آمالِي وعُلْتَ مطالبِي",34,"ب",2,0],["توفيق قلبك للجميع رقيق","وإلى الندى والصالحات يتوق",35,"ق",1,1],["توفرت سهماً في الأصول لأجله","غدا السيف نائى الحد واهي الحمائل",36,"ل",1,0],["توفّي النبيُّ عليه السلامُ","فلمّا تغيَّبَ في المَلْحَدِ",37,"د",1,1],["تَوفيق مَصر وَروحها وَنصيرها","أَبدا عَلى مَن لَم يَكُن بِمسالم",38,"م",1,0],["تَوفيق دَولته الَّذي في حكمه","بَينَ الوَرى أَضحى مَليكاً منصفا",39,"ف",2,0],["تَوفيقٍ الشَهم الَّذي بِعلومه","يَسمو عَلى مَأمونها العَباسي",40,"س",2,0],["تُوفي بمسمومِ الشُّواظِ مُكَرَّمٍ","عن أن يُشابَ شواظُهُ بِنُحاس",41,"س",1,0],["توفى بَعلها فَمَضَت قواها","وَغَيَّر لَون بَهجتها الفُتور",42,"ر",1,0],["توفاها الاله إليه بكراً","واسكنها النعيم بدار خلدِ",43,"د",1,0],["توفّيت في الإحسان جهدي وطاقتي","إلى ابن أبي ليلى فأعقبني ذمّا",44,"م",2,1],["توفيةٌ إتمامُ أو اكمال","اشباعُهُ والخامس الارسالُ",45,"ل",1,0],["تُوَفِّيَ الطَّاهِرُ القاضي فَوَا أَسَفا","إنْ لَمْ يُوَفِّ تباريجي وَأَوج