{"poems":[[71,"ألا يا نفس لا تعصي","https://www.aldiwan.net/poem28715.html","مجزوء الوافر"],[287,"كم لي على كاظمة من أنه","https://www.aldiwan.net/poem32356.html","الرجز"],[287,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[308,"قد ركبنا على البريد لمصر","https://www.aldiwan.net/poem57780.html","الخفيف"],[475,"خمس دسسن إلي في لطف","https://www.aldiwan.net/poem4694.html","أحذ الكامل"],[519,"كنت أرتجيك إذا جار الزمان علي","https://www.aldiwan.net/poem20891.html","المواليا"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32598","الطويل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[475,"خَمْسٌ دَسَسْنَ إِلَيَّ فِي لَطَفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20555",""],[5997,"ثَغْرُ الحَنَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=214535",""]],"verses":[["فعكسي فيه إصلاحي","كعكسِ النقشِ في الفصِّ",0,"ص",1,0],["فَعَكسُ عَذلٍ مِنكَ لَذعٌ في الحَشا","أَحَرُّ مِن لَوعاتِ صَدِّهِنَّه",1,"ن",2,0],["فَعَكسُ اِسمِهِ لا نيطَ عَكسٌ بِجِسمِهِ","جَوابٌ لِمَن يَستَنجِزُ الوَعدَ بِالنَقدِ",2,"د",1,0],["فعكسنا التشبيه لما جرينا","في جبالٍ كأنها أمواج",3,"ج",1,0],["فَعَكَفنَ لَيلَتَهُنَّ ناعِمَةً","ثُمَّ استَفَقنَ وَقَد بَدا الفَجرُ",4,"ر",1,0],["فعكست ظني وبعض الظن غيّ وليّ","حاشاك حاشاك يا سهمي ترد إليّ",5,"ي",1,0],["فَعَكّار عَينٌ لِلبِلادِ وَبرجِها","فَإِنسانُها المَكحول بِالحُسنِ وَالمَجدِ",6,"د",1,0],["فَعَكّارُ بِالعافينِ أَضحَت دُروبها","تَغُصُّ بِهِم ملأى لِمُزدَحم الوفدِ",6,"د",1,0],["فعكازه تهدي إلى السبل أكمها","وأخرى مقام الرجل قامت مع اليد",7,"د",1,0],["فعكس الدهرُ عليهِ قصدهُ","وعجَّل اللَه تعالى حصدهُ",8,"ه",1,0],["فَعَكَفْنَ لَيْلَتَهُنَّ نَاعِمَة ً","ثمَّ استفقنَ وقدْ بذا الفجرُ",9,"ر",1,0],["فَعَكَفْتُ فِيْ مَنْحَى الْتَوَسّلِ بَاْسِراً","وَبَنيْتُ أَرْكَاْنَ الْأَمَاْنِي وَالْطَنَبْ",10,"ب",1,0]]}