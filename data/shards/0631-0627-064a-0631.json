{"poems":[[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[251,"إلا يذذ عنها أساق بسيفه","https://www.aldiwan.net/poem56327.html","الطويل"],[422,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[463,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[543,"بكم شعري على غيري فخور","https://www.aldiwan.net/poem48179.html","عموديه"],[591,"رأى رضابا عن تسل","https://www.aldiwan.net/poem17852.html","مجزوء الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60977","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62843","الطويل"],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5725,"عشق صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=186860",""]],"verses":[["رأيٌ رآه البَيْن ما إنْ له","عنه إلى الآراءِ من مَرْغبِ",0,"ب",1,0],["رأى رُطّباً غَضّاً فأنساهُ دينَهُ","وشجراءَ فيها يانعٌ مُتراكبُ",1,"ب",1,0],["رأي رأى فيه الإِصابة سالمٌ","بالله أُقسِمُ إنَّه لسديد",2,"د",1,0],["رأى رُوَيدَ السير عجزاً به","فسيرُهُ حُضْرٌ وتقريبُ",3,"ب",1,0],["رأى روحاً تَسير بدونِ جِسمٍ","لِشِدَّةِ ما بها لعِبَ السُّرورُ",4,"ر",1,0],["رَأَى رُضَاباً عَنْ تَسل","ليه أُولو العِشْقِ سَلوْ",5,"و",1,1],["رأي رمى الآراء بالإبطال","وعزمة كالنار في اشتعال",6,"ل",1,0],["رأى ربّه حقا بعينيه هكذا","أتانا صحيحا في كتاب وسنة",7,"ه",1,0],["رأى ربعَ ليلَى بالحِمَى فشجَاه","وألْصق فوقَ التُّرب منه حشاه",8,"ا",2,1],["رأى رأيَهُ ثم استبدَّ فلم يُطِعْ","نصيحاً ولم يَسْمَعْ مَقَالَةَ زاجِرِ",9,"ر",1,0],["رأى رأي جهم ذي الضلال ومن على","طريقة النكرى توغل واستقرا",10,"ر",2,0],["راى ركن المحبة في جمال","اضاء القلب من حلك الظلالِ",11,"ل",1,0]]}