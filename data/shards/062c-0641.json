{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[63,"زارت سليمى والخطا يقتفي","https://www.aldiwan.net/poem45801.html","السريع"],[3,"جفون العذارى من خلال البراقع","https://www.aldiwan.net/poem171.html",""],[55,"ألا يا ليت شعري ما أقول","https://www.aldiwan.net/poem26181.html","الوافر"],[55,"أيا من وجهه قمر","https://www.aldiwan.net/poem26292.html","مجزوء الوافر"],[77,"أبا الفضل عاتب أباك الرضى","https://www.aldiwan.net/poem36007.html","المتقارب"],[77,"جفا ابن أبي رمانة وجه مقدمي","https://www.aldiwan.net/poem36042.html","الطويل"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[77,"جفاك الحيا من رقعة ظلت عندها","https://www.aldiwan.net/poem36521.html","الطويل"],[77,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[73,"أجد ومن أهواه في الحب عابث","https://www.aldiwan.net/poem11900.html","الطويل"],[73,"بنيت فلا تهدم ورشت فلا تبر","https://www.aldiwan.net/poem11910.html","الطويل"],[35,"أهاجك مغنى دمنة ومساكن","https://www.aldiwan.net/poem38822.html","الطويل"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[30,"أللربع ظلت عينك الماء تهمل","https://www.aldiwan.net/poem29546.html","الطويل"],[88,"لم أر بين الناس ذا مظلمه","https://www.aldiwan.net/poem44840.html","السريع"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[72,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[72,"جفاني الفلان لأن ظنني","https://www.aldiwan.net/poem19969.html","المتقارب"],[72,"جفاني الدرهم من بعدكم","https://www.aldiwan.net/poem20340.html","السريع"],[51,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"ألا أيها الموسوم باسم وكنية","https://www.aldiwan.net/poem66404.html","الطويل"],[51,"مغنية حقا بإسقاط نقطة","https://www.aldiwan.net/poem66709.html","الطويل"],[91,"جعت والخبز وفير في وطابي","https://www.aldiwan.net/poem8748.html","عموديه"],[91,"والسنا حولي وروحي في ضباب","https://www.aldiwan.net/poem8749.html","عموديه"],[70,"أيا من راح عن حالي","https://www.aldiwan.net/poem43007.html","مجزوء الوافر"],[92,"نحن نمشي وحولنا هاته الأك","https://www.aldiwan.net/poem38888.html","الخفيف"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[45,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[45,"جفانا الكميتي الكبير ولم يكن","https://www.aldiwan.net/poem65132.html","الطويل"],[45,"خطته فلم تحفل به الأعين الوطف","https://www.aldiwan.net/poem65143.html","الطويل"],[45,"هو الظلام فلا صبح ولا شفق","https://www.aldiwan.net/poem65179.html","البسيط"],[28,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[61,"أبا بكر أسأت الظن فيمن","https://www.aldiwan.net/poem51537.html","الوافر"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[49,"قد سمعنا الوعظ لوينفعنا","https://www.aldiwan.net/poem10334.html","الرمل"],[66,"جاءت لتنظر ما أبقت من المهج","https://www.aldiwan.net/poem38497.html","الكامل"],[66,"مثلك من يعتب في صده","https://www.aldiwan.net/poem38654.html","السريع"],[66,"شكوت إليك الجوى","https://www.aldiwan.net/poem39645.html","مجزوء المتقارب"],[97,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[97,"يا ساعة الحسرات والعبرات","https://www.aldiwan.net/poem24911.html","الكامل"],[44,"معتدل كالغصن الناضر","https://www.aldiwan.net/poem30246.html","السريع"],[44,"جفوف البلى أسرعت في الغصن الرطب","https://www.aldiwan.net/poem30319.html","الطويل"],[44,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[44,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[69,"فلان والينا على رغمنا","https://www.aldiwan.net/poem28694.html","السريع"],[69,"قد عم خالك حسنا","https://www.aldiwan.net/poem28703.html","المجتث"],[74,"جفن تجافى للخلي عن الكرى","https://www.aldiwan.net/poem12960.html","الكامل"],[33,"لو سيل أهل الهوى من بعد موتهم","https://www.aldiwan.net/poem26021.html","البسيط"],[105,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[105,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[52,"جفاني النميري فيمن جفا","https://www.aldiwan.net/poem27311.html","المتقارب"],[48,"دع الربع ما للربع فيك نصيب","https://www.aldiwan.net/poem10774.html","الطويل"],[48,"لقد أصبحت ذا كرب","https://www.aldiwan.net/poem10810.html","الهزج"],[48,"جفن عيني قد كاد يسقط","https://www.aldiwan.net/poem62485.html","مجزوء الخفيف"],[48,"سقى الله ظبيا مبدي الغنج في الخطر","https://www.aldiwan.net/poem63298.html","الطويل"],[48,"أتحسبني باكرت بعدك لذة","https://www.aldiwan.net/poem63372.html","الطويل"],[48,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[50,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42572","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142046","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43836","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43634","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[77,"أبا الفضل عاتب أباك الرضى","https://www.poetsgate.com/ViewPoem.aspx?id=34173",""],[90,"بين النجف وأمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=178944",""],[90,"سلام على أرض الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=178976",""],[45,"خَطَتْهُ فَلَمْ تَحفِلْ به الأَعيُنُ الْوُطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=32541",""]],"verses":[["جَفلَةُ السِربِ في الظَلامِ وَقَد زُع","زِعَ رَوعاً مِن عَدوَةِ الذُؤبانِ",0,"ن",1,0],["جَفَتهُ العُلى فَاِنسَلَّ مِن عُقُداتِها","وَما عَلِقَت أَعطافُهُ بِالمَآثِرِ",1,"ر",1,0],["جِفانُهُ تَلمَعُ لِلمُعتَري","في العُسرِ وَاليُسرِ كَأَنضاحِ",2,"ح",1,0],["جُفونُ العَذارى مِن خِلالِ البَراقِعِ","أَحَدُّ مِنَ البيضِ الرِقاقِ القَواطِعِ",3,"ع",1,1],["جَفاني ثُمَّ وَلّى ظالِماً لي","وَفي صَدري لَهُ حُبٌّ دَخيلُ",4,"ل",1,0],["جُفوني ماؤُها دِرَرٌ","وَقَلبي حَشوُهُ فِكَرُ",5,"ر",1,0],["جَفَا النَّوْمُ جَفْنِيَ لَمَّا جَفَا","وَأَعْرَضَ أُنْسِيَ إِذْ أَعْرَضَا",6,"ض",2,0],["جَفَا ابْنُ أَبِي رُمَّانَةٍ وَجْهَ مَقدَمِي","وَنَكَّبَ عَنِّي مُعْرِضاً وَتَحَامَانِي",7,"ي",1,1],["جَفَانِيَ دَهْرِي وَاسْتَهَانَ بِحُرْمَتِي","فَدَهْرِيَ مَمْقُوتُ الذِّمَامِ ذَمِيمُهُ",8,"م",2,0],["جَفاكَ الحَيا مِنْ رُقْعَةٍ ظَلْتُ عنْدَها","بِلا جلَدٍ ممّا لقيتُ ولا جِلْدِ",9,"د",1,1],["جفاؤُكَ الفَظُّ الذي نالَني","صيّرَني للفِكْرِ في هَرْجِ",10,"ج",1,0],["جَفاني بِإِلطافِ العِدا وَأَزالَهُ","عَنِ الوَصلِ رَأيٌ في القَطيعَةِ حادِثُ",11,"ث",1,0],["جَفاءٌ هُوَ اللَيلُ ادلَهَمَّ ظَلامُهُ","فَلا كَوكَبٌ لِلعُذرِ في أُفقِهِ يَسري",12,"ي",1,0],["جَفَوتَ فَما تَهوى حَديثَكَ أَيَّمٌ","وَلا تَجتَديكَ الآنِساتُ الحَواضِنُ",13,"ن",1,0],["جَفَّ النَّدَى فِيهَا وَأَقُوَى مَوْئِلٌ","رُعِيَتْ بِهِ حُرَمٌ وَصِينَ كِرَامُ",14,"م",1,0],["جَفولٌ كَساها لَونَ أَرضٍ غَريبَةٍ","سِوى أَرضِها مِنها الهَباءُ المُغَربَلُ",15,"ل",1,0],["جَفَّ على مُرضَعها ثَديُها","فأضطرّها ذلك أن تَفطِمه",16,"م",2,0],["جفّت بها سرحة استقلالنا عطشاً","حتى إذا ما مسنا عودها انكسرا",17,"ر",2,0],["جَفولٍ تَرى المِسمارَ فيها كَأَنَّهُ","إِذا اِهتَزَّ جِذعٌ مِن سُمَيحَةَ ذابِلُ",18,"ل",1,0],["جفن عينيه فاترٌ مستحيٌّ","إنَّما خدّه المشعشع جمري",19,"ي",1,0],["جفاني الفلان لأنْ ظنني","بتلك الهدية أبغي مراما",20,"م",2,1],["جفاني الدّرهم من بعدكم","فبينكم يفضي إلى بينه",21,"ه",1,1],["جفتني أنْ صددتُ ولي لديها","أسيرا ذِلّةٍ بدنٌ ونفسُ",22,"س",1,1],["جَفَوْني وعَقُّوني ومَلُّوا ثِوايتي","فكلٌّ مُلِيمٌ ظالمٌ وهو لائمُ",23,"م",1,0],["جفوتَ فجافيتَ الجفون عن الكرى","وعَرَّضْتَ رأيي للزِّرايةِ والطَّعْن",24,"ن",1,0],["جَفَتْ هامةٌ منها ودُقِّق ساقُها","فما صلحت إلا لِبَنْجَقِها مَلْوى",25,"و",2,0],["جَفَّ ضَرعُ الشِعرِ عِندي وَذَوى","وَلَكَم عاشَ لِمَريٍ وَاِحتِلابِ",26,"ب",1,0],["جَفَّ ضَرعُ الشِعرِ عِندي وَاِنطَوى","وَلَكَم عاشَ لِمَرعى وَاِحتِلابِ",27,"ب",1,0],["جُفونٌ تَشتَكي غَرَقاً","وَقَلبٌ يَشتَكي لَهَبا",28,"ب",2,0],["جَفَّ سِحْرُ الحَيَاةِ يا قلبيَ البا","كي فهيَّا نُجَرِّبُ الموتَ هيَّا",29,"ي",2,0],["جَفَّتْ بهِ أَمواجُ","ذيَّاكَ الغرامِ الآفلِ",30,"ل",1,0],["جف روض المنى وشح الربيع","وسقت مصرع الهزار الدموع",31,"ع",1,1],["جفت الأرض وجافاها السما","وديور الكفر أوقفن السما",32,"م",2,0],["جَفناكِ أَيَّهُما الجَريءُ عَلى دَمي","بِأَبي هُما مِن قاتِلٍ وَشَريكِ",33,"ك",1,0],["جَفنٌ تَلَقّى مَلَكا بابِلٍ","غَرائِبَ السِحرِ عَلى غَربِهِ",34,"ب",2,0],["جَفَخَت وَهُم لا يَجفَخونَ بِهابِهِم","شِيَمُ عَلى الحَسَبِ الأَغَرِّ دَلائِلُ",35,"ل",1,0],["جَفَتني كَأَنّي لَستُ أَنطَقَ قَومِها","وَأَطعَنَهُم وَالشُهبُ في صورَةِ الدُهمِ",36,"م",1,0],["جَفَوتُ الشامَ مَرتَبَعي وَأُنسي","وَعَلوَةَ خُلَّتي وَهَوى فُؤادي",37,"ي",1,0],["جَفانا الكُمَيتِيُّ الكَبيرُ وَلَم يَكُن","لَنا في الكُمَيتِيِّ الصَغيرِ شَفيعُ",38,"ع",1,1],["جَفا مَضجَعي وَأَيُّ مَضجَعِ مُغرَمٍ","يُقَضُّ بِلَوعاتِ الفِراقِ فَلا يَجفو",39,"ف",2,0],["جَفّوا مِنَ البُخلِ حَتّى لَو بَدا لَهُمُ","ضَوءُ السُها في سَوادِ اللَيلِ لَاِحتَرَقوا",40,"ق",3,0],["جُفافٌ أَجَفَّ اللَهُ عَنهُ سَحابَهُ","وَأَوسَعَهُ مِن كُلِّ سافٍ وَحاصِبِ",41,"ب",1,0],["جَفَوْتُ من الصِّبا ما ليسَ يُجفى","وعِفْتُ من الهَوى ما لا يُعافُ",42,"ف",1,0],["جَفَتِ الخَلوقَ فليسَ يَعرِفُ جسمُها","إلا خَلوقَ مواقعِ الأَسواطِ",43,"ط",1,0],["جُفَرٌ تَفيضُ وَلا تَغيضُ طَوامِياً","يَزخَرنَ فَوقَ جِمامِهِنَّ الطُحلُبُ",44,"ب",1,0],["جَفَّتِ الأَقلامُ مِن قَبلُ بِما","خَتَمَ اللَهُ عَلَينا وَكَتَب",45,"ب",1,0],["جَفَوتِني فَرَأَيتُ الصَبرَ أَجمَلَ بي","وَالصَمتُ بِالحُبِّ أَولى بي مِنَ اللَهَجِ",46,"ج",1,0],["جَفَوتَ عَبداً لَو كَوَت قَلبَهُ","نارُ الجَفا ما حالَ عَن عَهدِهِ",47,"د",2,0],["جَفَوتِ وَأَقصَيتِني","فَهَلّا وَقَلبي مَعي",48,"ي",1,0],["جفا الربيع ليالينَا وغادرها","وأقفرَ الروضُ لا ظلٌّ ولا ماءُ",49,"ا",2,0],["جفَّت حلوقٌ بعدهم","لم تلق دونهمُ رواء",50,"ا",2,0],["جفَّت على شفتي الحياةُ وحُلمُها","وخيالُها من ذلك الينبوع",51,"ع",1,0],["جُفونُهُ تَرشِقُ أَهلَ الهَوى","بِأَسهُمٍ مِن طَرفِهِ الفاتِرِ",52,"ر",1,0],["جُفوفَ البَلى أَسرَعتِ في الغُصُنِ الرَطبِ","وَخَطبَ الرَدى وَالمَوتِ أَبرَحتَ مِن خَطبِ",53,"ب",1,1],["جَفَّ دَرُّ الدُنيا فَقَد أَصبَحَت تَك","تالُ أَرواحَنا بِغَيرِ حِسابِ",54,"ب",1,0],["جَفَّت بِهِ النِعَمُ النَواعِمُ وَاِنثَنَت","سُرُجُ الهُدى فيهِ بِغَيرِ ذُبالِ",55,"ل",1,0],["جَفنٌ يَعافُ لَذيذَ النَومِ ناظِرُهُ","شُحّاً عَلَيها وَقَلبٌ حَولَها يَجِبُ",56,"ب",1,0],["جَفا الشَرقَ حَتّى ظَنَّ مَن كانَ جاهِلاً","بِدينِ النَصارى أَنَّ قِبلَتَهُ الغَربُ",57,"ب",1,0],["جَفْنتُهُ أضيقُ مِنْ جفنِهِ","وقَدْرُهُ أصغرُ مِنْ قدْرِه