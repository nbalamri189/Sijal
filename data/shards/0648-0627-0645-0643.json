{"poems":[[29,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[23,"إذا نسبت يوما قريش نفتكم","https://www.aldiwan.net/poem21310.html","الطويل"],[23,"أبوك أبوك وأنت ابنه","https://www.aldiwan.net/poem21458.html","المتقارب"],[93,"كان على خوان رب المال","https://www.aldiwan.net/poem62626.html","عموديه"],[81,"أنا واللَه أصلح للمعالي","https://www.aldiwan.net/poem29566.html","الوافر"],[60,"ألم تر أن الله أبلى رسوله","https://www.aldiwan.net/poem30918.html","الطويل"],[76,"تجردت عن غسق","https://www.aldiwan.net/poem13187.html","مجزوء الرجز"],[22,"أتاني وأهلي بذات الدماخ","https://www.aldiwan.net/poem21688.html","المتقارب"],[50,"شريت الفتك بالثمن الربيح","https://www.aldiwan.net/poem62512.html","الوافر"],[50,"يا ليلة بت في دياجيها","https://www.aldiwan.net/poem66173.html","المنسرح"],[52,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[48,"راعتك دنياك من ريع الفؤاد وما","https://www.aldiwan.net/poem22209.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[136,"ألا يا جبرائيل نماك دود","https://www.aldiwan.net/poem54855.html","الوافر"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[242,"سهام الردى تخطي الذي قصد الهبطي","https://www.aldiwan.net/poem18843.html","الطويل"],[302,"أفي كل ربع للمطي بنا وقف","https://www.aldiwan.net/poem33218.html","الطويل"],[391,"ألا إن هنداً أمس رث جديدها","https://www.aldiwan.net/poem1846.html","الطويل"],[409,"جرى هذا الزمان على ضلاله","https://www.aldiwan.net/poem33453.html","الوافر"],[445,"هو النصر والتمكين أدرك طالبه","https://www.aldiwan.net/poem34818.html","الطويل"],[463,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[572,"نعم المعين على الآداب والحكم","https://www.aldiwan.net/poem69506.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63854","السريع"],[869,"","https://poetry.dctabudhabi.ae/diwan/poem/145903","المتقارب"],[908,"","https://poetry.dctabudhabi.ae/diwan/poem/199305","السريع"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67692","الطويل"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116681","الوافر"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47188","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2397,"","https://poetry.dctabudhabi.ae/diwan/poem/96145","المتقارب"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70312","الوافر"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112626","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71314","البسيط"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45245","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131065",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133306","الوافر"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2551","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125908","الوافر"],[4697,"ياللي زعلت","https://www.poetsgate.com/ViewPoem.aspx?id=36100",""],[4804,"اذا ظلم الشيب رأس الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=92079",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4883,"سجده في المسجد الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=48369",""],[4897,"أظن الدهر قد آلى فبرا","https://www.poetsgate.com/ViewPoem.aspx?id=98898",""],[5061,"النصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=155783",""],[5092,"عناد","https://www.poetsgate.com/ViewPoem.aspx?id=176738",""],[5334,"رأيتُكما يا بنَي أخي قد سَمِنتُما","https://www.poetsgate.com/ViewPoem.aspx?id=96975",""],[5956,"حول أحمد وسعاد","https://www.poetsgate.com/ViewPoem.aspx?id=193720",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[5957,"عراقي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=207854",""],[391,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","https://www.poetsgate.com/ViewPoem.aspx?id=4653",""]],"verses":[["وَأُمُّكُمُ قُفَيرَةُ رَبَّبَتكُم","بِدارِ اللُؤمِ في دِمَنِ النَباتِ",0,"ت",1,0],["وَأَمكَنَها مِنَ الصُلبَينِ حَتّى","تَبَيَّنَتِ المِخاضُ مِنَ الحِيالِ",1,"ل",1,0],["وَأُمُّكَ مِن قِسرٍ حُباشَةُ أُمِّها","لِسَمراءِ فَهمِ آسِنُ البَولِ طيبُها",2,"ب",3,0],["وَأُمُّكَ سَوداءُ مَودونَةٌ","كَأَنَّ أَنامِلَها الحُنظُبُ",3,"ب",1,0],["وَأُمُّكِ الكَرمَةُ يا صَهباءُ","ما وُجِدَت في الأَرضِ لَولا الماءُ",4,"ا",2,0],["وَأمكنُ عاشقي من صحن خدّي","وأعطي قُبلتي مَن يشتهيها",5,"ه",2,0],["وَأَمكَنَ مِنهُم يَومَ بَدرٍ رَسولَهُ","وَقَوماً غِضاباً فِعلَهُم أَحسَنُ الفِعلِ",6,"ل",1,0],["وَأَمكَنَت مِن خُلُقٍ","مُلتَهِبٍ مُحتَرِقِ",7,"ق",1,0],["وَأُمُّكَ حَمراءُ زَوفِيَّةٌ","لِنَقلِ الحَشيشِ جُرازُ الحَطَب",8,"ب",1,0],["وَأَمكَنتُ المَجانَةَ مِن قِيادي","وَلَستُ مِنَ المُجونِ بِمُستَريحِ",9,"ح",1,0],["وَأَمكَنَتني مِنها مُخاتَلَةً","مَدَدتُ رِفقاً كَفّي إِلى فيها",10,"ي",3,0],["وَأُمُّكَ مِن نِسوَةٍ هَمُّهُنَّ","أَشيَبٌ وَمَفرِقُها يَجمُدُ",11,"د",1,0],["وَأُمُّكَ السوءُ لَم تَحفَظكَ في سَبَبٍ","لا بَل أَضاعَتكَ أَصنافَ الإِضاعاتِ",12,"ت",1,0],["وَأُمُّكِ لاَ يَكْفي التَّفَجُّعُ قَلْبُهَا","إِذَا لَمْ يَكُنْ فِي صُوَرَةِ السَّعْدِ وَالبِشْرِ",13,"ر",1,0],["وأُمُّكَ هِرَّةٌ تَلْقَى بنيها","بفيها حين يدركها السُّعَار!!",14,"ر",1,0],["وأُمُّكَ في الورَى عَصمَاءُ عِقدٍ","يَتِيَمتُهُ إذَا نُظِمَ العُقُود",15,"د",1,0],["وَأَمَّكَ حُجّاجُ العِراقِ وَخَلَّفوا","مَواطِنَ قَد أَلقى بِها الخَوفُ كَلكَلا",16,"ل",2,0],["وَأَمَّكَ وَالأَوْجَالُ تُضْرِمُ نَارَهَا","وَقَدْ لَجَّ سُوءُ الظَّنِّ فِي الْحَلِّ وَالرَّبْطِ",17,"ط",1,0],["وأمَّكَ عيدُ النحر بالسعد مُقبلاً","وأَمَّ عِداك النَحرُ والذُلُّ والخَسفُ",18,"ف",1,0],["وَأَمكَنَ أَطرافَ الأَسِنَّةِ وَالقَنا","يَعاسيبُ قودٌ ما تُثَنّى قُتودُها",19,"د",3,0],["وأمكنني بمطلوبي احتيالاً","ليخدعني ويظفر باحتياله",20,"ل",2,0],["وأَمْكَنَ حَبْلَ الرِّقِّ من حُرِّ جِيدِهِ","مُتابِعَ عَزْمٍ حَيْثُ أَمْرُكَ جاذِبُهْ",21,"ب",2,0],["وأمكنك الحرَّاسُ من بَسط قولةٍ","تبوحُ بها جَهراً وتفتحُ فاكا",22,"ك",2,0],["وأمكنت من الخِشاشِ آنُفاً","ما طمعتْ من قبلُ فيها مطمَعا",23,"ع",2,0],["وأمكنتني من ظَهر حظِّي وعُرفِهِ","فأسمحَ لي بعد الشِّماسِ رَكوبُهُ",24,"ب",2,0],["وَأَمْكَنَ الْمَحْوُ فِيْهَا الكَفَّ فَاتَّسَعَتْ","لِمَا تَضَمَّنُ مِنْ نَثْرٍ وَمُنْتَظِمِ",25,"م",1,0],["وأمكن الشيطان ما أراده","منهم فبث فيهم أجناده",26,"ه",1,0],["وَامكُر وخن وَاغدر وبارز إن تَكن","يَوم الكَريهة فارس الهَيجاء",27,"ا",2,0],["وأمُّ كلثومٍ ونسوانُها","بمنظرٍ يُكْبِرُهُ الناظر",28,"ر",1,0],["وأمكنت نفسي من الحادثات","وأيقنت أني صريع الشره",29,"ر",2,0],["وأمك الزهراء مضمونة","أرض بقيع الغرقد الأزهر",30,"ر",1,0],["وأُمّكُمُ تُزْجِي تُؤَاماً لِبَعْلِها","وأُمُّ أَخِيْكُمْ نَزْرَةُ الوَلْدِ عَاقِرُ",31,"ر",1,0],["وأمُّكَ علجةٌ وأبوك وغدٌ","وَمَا الأَذنَابُ عَدلٌ للصُّدُورِ",32,"ر",1,0],["وأَمَّكَ بالإِقبال في الحُسْنِ مَنْ له","إمَامَتُهُمْ في الدّين إذْ أنت جامع",33,"ع",1,0],["وإمكان أن يقوي وإن كان غائباً","على رفع ضرِّ الناس إن نالها الضرّ",34,"ر",1,0],["وأمك بيضاء تيمية","إذا نسب الناس كانت نضارا",35,"ر",2,0],["وأَمكنتُ المحبَّة مِن قِيادي","وصنتُ مع النَّأَي وُدًّا صحيحَا",36,"ح",2,0],["وامكث ان لم الق في جانب الحما","رفيف بروق عند ذاك الحما دهرا",37,"ر",2,0],["وأم كلثومٍ غدَت تُنادي","تَندُبُ بالآباء والأجدادِ",38,"د",1,0],["وَأَمْكَنَنِي مِنْ لَمَاكَ بَرْقٌ","مِنَ الحَيَا لاَ يَكَادُ يَخْبُو",39,"ب",2,0],["وَأُمُّكَ حينَ تُنَسبُ أُمُّ صِدقٍ","وَلكِنَّ اِبنَها طَبعٌ سَخيفُ",40,"ف",1,0],["وأمك العشاق حتى التقى","في دارك الحابل والنابل",41,"ل",1,0],["وأمك وهي مصر في احتياج","حقوق الأم ترعاها سويه",42,"ي",2,0],["وَأَمكَنَ مِنّي القَومَ يَومَ لَقِيتُهُم","نَوافِذُ قَد خالَطنَ جِسمِيَ أَربَعُ",43,"ع",1,0],["وأمكنني الفعالَ بفعل قومي","وأيامٍ تجلُ عن المقال",44,"ل",1,0],["وأَمكم الكويت تئن عطشى","أَلا فلتنع عقلكم النواعي",45,"ع",2,0],["وأمك تشق الجيب من عظم بلواك","وعساك ما تفرح وتكثر بلاويك",46,"ك",1,0],["وأمكنه من بلاد العدو","ليحكم فيها بحكم الكتاب",47,"ب",1,0],["وأمكن منهم وقضى لك الله","بالتمكين والفتح المجيد",48,"د",1,0],["وأمكث هْناك العمْر كله بذكراه المليحة","ودي آصليّ بقدس الحق ..واخرج للفِلاحة!",49,"ح",2,0],["وأمكن من رقاب المال قوماً","وملكهم به نفعاً وضرا",50,"ر",2,0],["وامك تطاوعها ... .ولا تعصي ابيك","اللي تعب لجلك. . . وعانا ورباك",51,"ك",1,0],["وأمكثُ في عنادٍ لي كأني","سأحفرُ في بساتيني اليبابا",52,"ب",2,0],["وأمُّكما قد أصبحتْ وهيَ أيِّم","تخيَّر في خطّابها أين تَنكِح",53,"ح",1,0],["وأمكم مع زوجي كانتا قمماً:","أمُّ الفراس وأمُّ الخالد العَلَمِ",54,"م",1,0],["وأمُّك أمُّ الإدارة تدري","وتفعل ما هو يجْدي عليكِ",55,"ك",1,0],["وأمكث مثلما يبغي انبثاقُكْ","بحجم ِ البعد يجمعني عناقُكْ",56,"ك",1,1],["وأَمْكَنَ أَطْرَافَ الأَسِنَّةِ والقَنَا","يَعَاسِيبُ قُودٌ كالشِّنَانِ خُدُودُها",57,"د",3,0]]}