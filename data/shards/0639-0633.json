oetsgate.com/ViewPoem.aspx?id=34157",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"رابطة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=179137",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[90,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[45,"يَزْدادُ في غَيّ الصّبا وَلَعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31128",""],[31,"خَانَكَ مَنْ تَهْوَى فَلاَ تَخُنْهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19137&r=&rc=399",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""]],"verses":[["عَسى مَن رَمى بِالمُحِبِّ الغَري","بِ مَرمىً بَعيداً يُقَضّي نَواهُ",0,"ا",2,0],["عَسكَرَت فيها السَحابُ كَما","حَطَّ بِالبَيداءِ رُكبانُ",1,"ن",1,0],["عَسى الأَرحامُ تَثنينا","إِذا نَحنُ تَباغَينا",2,"ن",2,0],["عَسَفنا بِإِرقالِ المَطِيِّ وَطالَما","صَبَرنا عَلى ضَيمِ العِدى وَالمَخاسِفِ",3,"ف",1,0],["عَسى مَلِكُ الأَملاكِ يَنتاشُ أَعظُماً","بَرَتهُنَّ ذُؤبانُ اللَيالي النَواهِسُ",4,"س",1,0],["عَسى فُؤادٌ يَرعَوي","رُبَّ مُضِلٍّ وَجَدا",5,"د",2,0],["عَسى اللَهُ أَن يَرتاحَ يَوماً بِفَرحَةٍ","فَتَنطِقَ أَنضاءٌ أُطيلَ صُماتُها",6,"ت",3,0],["عَسى اللَهُ أَن يَأوي لِشُعثٍ تَناهَبوا","هِبابَ المَطايا نَصَّها وَاِنجِذابَها",7,"ب",3,0],["عَسكَرُ الحُبِّ في فُؤادي مُقيمُ","فَدُموعي لِذاكَ سَحٌّ سُجومُ",8,"م",1,1],["عَسى اللَهُ أَن يَرتاحَ يَوماً بِرَحمَةٍ","فيُنصِفَني مِن فاضِحي وَمُرَوِّعي",9,"ي",1,0],["عَسى مَن لَهُ الإِحسانُ يَغفِرُ زَلَّتي","وَيَستُرُ أَوزاري وَما قَد تَقَدَّما",10,"م",2,0],["عَسَى جَبَلُ الْفَتْحِ الِّذِي بِجَوارِهِ","حَلَلْتُ بِقُرْبِ الْفَتْحِ يَصْدُقُ فَالُهُ",11,"ل",2,0],["عَسَى اللهُ يُدْنِي سَاعَةَ الْفَرَجِ الَّتِي","بِهَا يَتَسَرَّى عَنْ فُؤَادِي خَبَالُهُ",11,"ل",2,0],["عَسى اللهُ يُدْني ساعَةَ القُرْبِ واللِّقا","ويَجْعَلُ جُهْدي في سَبيلِ جِهادِهِ",12,"د",2,0],["عَسى مَنْ أضاقَ الصّدْرَ منْ حُبِّه لها","يُتيحُ ببُغْضٍ منْه فيها لَنا الفَرَجْ",13,"ج",1,0],["عَسَى خَطْرةٌ بالرّكْبِ يا حادِيَ العِيسِ","علَى الهضْبَةِ الشّمّا منْ قصْرِ بادِيسِ",14,"س",1,1],["عَسفاً وَإِرقالَ الهَجيرِ تَرى لَها","خَدَماً تُساقِطُ بِالطَريقِ نِعالَها",15,"ل",3,0],["عَسيبُ القِيامِ كَثيبُ القُعو","دِ وَهنانَةٌ ناعِمٌ بالُها",16,"ل",3,0],["عَسى ذَلِكَ العامُ الجَديدُ يَسُرُّني","بِبُشرى وَهَل لِلبائِسينَ بَشيرُ",17,"ر",1,0],["عَساكَ تَقبَلُ شَيئاً قَد بَعَثتُ بِهِ","نَزراً فَإِنّي إِلى عَلياكَ أَعتَذِرُ",18,"ر",1,0],["عَسى حَرفُ جَرٍّ مِن نَداكَ يَجُرُّني","إِلَيكَ فَأضحي مِن زَماني مُسَلَّما",19,"م",2,0],["عَسى عطفَةٌ بَدرِيَّةٌ تَعكِسُ النَوى","فَأَلفى قَريرَ العَينِ بِالأَهلِ وَالوَطَن",20,"ن",1,0],["عَسى البارِقُ الشامِيُّ يَهمِيَ سَحابُهُ","فَتَخضَلَّ أَثباجُ الحِمى وَرِحابُهُ",21,"ب",2,1],["عسى مسلم يدنو فيدعو برحمة","فإني محتاج لدعوة مسلم",22,"م",1,0],["عَسوفٌ بِأَجوازِ الفَلا حِميَرِيَّةٌ","مَريشٌ بِذِئبانِ السَبيبِ تَليلُها",23,"ل",3,0],["عَسى اللَهُ أَن يَأوي لِذا الخَلقِ إِنَّهُ","إِلى كُلِّ قَومٍ دائِمُ اللَحَظاتِ",24,"ت",1,0],["عَسَفتُ اللَواتي تَهلِكُ الريحُ دونَها","كَلالاً وَجِنّانُ الهِبِلِّ الُمسالِفِ",25,"ف",1,0],["عَسَفتُ اِعتِسافَ الصَدعِ كُلَّ مَهيبَةٍ","تَظَلُّ بِها الآجالُ عَنّي تَصَوَّعُ",26,"ع",1,0],["عساك يا خيرَ من تُرجى وسائله","تُنجي غريقاً ببحر الذَّنب قد سبحا",27,"ح",2,0],["عسى البشير غداة الروع يُسْمِعُني","بُشرى تعود ليَ البؤسى بها فرحا",27,"ح",2,0],["عسى الشهباء تثأره فتبدي","إلى الزوراء ما يبدي الخصيم",28,"م",1,0],["عسانا بذا نقضي له بعض حقّه","وإن جلّ أن يقضى بدمع محقر",29,"ر",1,0],["عَسَفنَ عَلى الأَماعِزِ مِن حُبَيٍّ","وَفي الأَظعانِ عَن طَلَحَ اِزوِرارُ",30,"ر",1,0],["عَسى يَرى نارَكَ مَن يَمُرُّ","إِن جَلَبَت ضَيفاً فَأَنتَ حُرُّ",31,"ر",1,0],["عَسى اللَهُ أَن يَأتي بِخَيرٍ فَإِنَّ لي","عَوائِدَ مِن نُعماهُ غَيرُ بَوائِدِ",32,"د",1,0],["عَسَجنَ بِأَعناقِ الظِباءِ وَأَبرَزَت","حَواشي بُرودِ القِطرِ وَشياً مُنَمنَما",33,"م",2,0],["عسى خبرٌ من كتاب الشهاب","يخبرُ عنها بما أرقب",34,"ب",1,0],["عسى الهمّ الذي أمسيتُ فيه","يكون وراءه فرجٌ قريب",35,"ب",1,0],["عسى لعليل الجسم طيفك عائد","كريم اللّقا والمكرمات عوائد",36,"د",1,1],["عسى تقلده برًّا ومكرمةً","فيغتدي ذلكَ التوقيعُ تقليدا",37,"د",2,0],["عسى بجبر الصب آس العذار","فبالآسِ كسرُ الورى يجبر",38,"ر",1,0],["عسى كلّ عام زورة لمفارق","فيا حبَّذا من أجل لمياء كلّ عا",39,"ع",2,0],["عسى ظلمة الحيّ التي قد تعرضت","سحابة صيفٍ عن قريب تقشع",40,"ع",1,0],["عسلاً بارداً بماء سحاب","إنَّني لا أحبُّ شرب المدام",41,"م",1,0],["عسى كرم الأفضل المرتجى","يوقع في قصَّتي الشاكيه",42,"ي",2,0],["عسى تهديه لي ضمًّا ومنْ لي","بأن يصل الدَّقيق إلى الهدايا",43,"ي",2,0],["عَسى اللَيالي الَّتي أَضنَت بِفُرقَتَنا","جِسمي سَتَجمَعُنِي يَوماً وَتَجمَعُهُ",44,"ع",2,0],["عساهم أن يُجيلوا الطرف فيه","فإن سألوا أجابهمُ مجيبُ",45,"ب",1,0],["عَسَفْتُ ودَوٍّ كالسَّماءِ قَطَعْتُهُ","إذا انْجَابَ منْهُ فَدْفَدٌ عَنَّ فدْفَدُ",46,"د",1,0],["عسيرة البذل غير خاليةٍ","من خُلق يخدع الرِّضا يَسَرِ",47,"ر",1,0],["عساك أفادتك الدعاوةُ نخوةً","فغرّتك مني والجهول مغرَّر",48,"ر",1,0],["عَسُرتْ عليه لظلمه أنفاسُهُ","فكأنَّهُ في لحدِ قبرٍ ضاغِطِ",49,"ط",1,0],["عسى ولعل طيِّبتا حياتي","وصاحبتاهما حتى وسوفا",50,"ف",2,1],["عسُرتْ علينا دعوةُ السَّمكِ","أنَّى وَجودُك ضامنُ الدركِ",51,"ك",1,1],["عساك أمنتَ بادرتي وصدِّي","لما أغلقْتَ بيتك من رُهُونِ",52,"ن",1,0],["عسى ابن حُريثٍ تستريحُ ظنونُه","إلى أنني عانيتُ فيه القوافيا",53,"ي",2,0],["عَسى اللَيالِيَ تَدري جِنايَتَها","عَلى قَتيلِ الهَوى فَتَعتَذِرُ",54,"ر",1,0],["عَسى اللَهُ يَطوي شُقَّةَ البُعدِ بَينَنا","فَتَهدَأَ أَحشاءٌ وَتَرقَأَ أَجفانُ",55,"ن",1,0],["عَساها إِذا ما مَرَّ ذِكري بِسَمعِها","تَقولُ فُلانٌ عِندَكُم كَيفَ حالُهُ",56,"ل",2,0],["عَسى نَظرَةٌ مِن حُسنِ رَأيِكَ صُدفَةً","تَسوقُ إِلى جَدبي بِها الماءَ وَالكَلا",57,"ل",2,0],["عَسى عَطفَةً لِلوَصلِ يا واوَ صُدغِهِ","عَلَيَّ فَإِنّي أَعرِفُ الواوَ تَعطِفُ",58,"ف",1,0],["عَسى أَن تَنجَلي البَأساءُ عَنّا","وَيُسعِدَ قَومَنا العَيشُ الرَغيدُ",59,"د",1,0],["عَسى قُزَحا قَبَّلتِهِ فَأخالُهُ","عَلى الشِفَة اللَمياء قَد جاء مُخَطّا",60,"ط",2,0],["عسى اللَه أن يستبدل الغي بالهدى","ولِلّه محوٌ في الأمور وإثبات",61,"ت",1,0],["عسى إن قيل مات هوى","تقول الله يرحمه",62,"م",2,0],["عسى تكف دموع فيك هامية","لا تطلع الشمس والنداء في آن",63,"ن",1,0],["عَسى اللَهُ الَّذي ساقَ","إِلى يوسُفَ سَيّارَه",64,"ر",2,0],["عَسى نَفسُكَ أَن تُد","مَجَ في أَحلامِها نَفسي",65,"ي",1,0],["عَسى تَأتينَنا بِمُعَلَّقاتٍ","نَروحُ عَلى القَديمِ بِها نُدِلُّ",66,"ل",1,0],["عَسى الشِعرُ أَن يَجزي جَريئاً لِفَقدِهِ","بَكى التُركُ وَاليونانُ بِالدَمعِ وَالدَمِ",67,"م",1,0],["عَسى تَكُفُّ دُموعٌ فيكِ هامِيَةٌ","لا تَطلُعُ الشَمسُ وَالأَنداءُ في آنِ",68,"ن",1,0],["عَسى الأَيّامُ تَجمَعُني فَإِنّي","أَرى العَيشَ اِفتِراقاً وَاِجتِماعا",69,"ع",2,0],["عسى اللّهُ في دارِ القَرارِ يضُمُّنَا","ويجمعُ شملاً إنَّه مالكُ الأَمْرِ",70,"ر",1,0],["عسى الأيامُ تُطْلِعُه علينا","طلوعَ الشمسِ من خَللِ السَّحَابِ",71,"ب",1,0],["عسى اللّه يقضي أوبةً بعد غيبةٍ","ويختِمُ بالحُسنَى ويفتحُ بابَا",72,"ب",2,0],["عَسى بِكَ أَن تَدنو مِنَ الوَصلِ بَعدَما","تَباعَدتَ مِن أَسبابِهِ وَعَسى بِها",73,"ب",3,0],["عَسى الدَهرَ أَن يُرضيكَ بَعدَ إِساءَةٍ","بِقُربِ حَبيبٍ وَاِغتِرابِ رَقيبِ",74,"ب",1,0],["عَساكِرُ شَتّى مِن أَعادٍ هَزَمتَها","وَما نازَعَت في هَزمِهِنَّ يَداً يَدُ",75,"د",1,0],["عَسَتِ الإِضافَةُ أَن يُنالَ بِها","جِدَةٌ وَنَكَّلَ ضارِياًّ شِبَعُه",76,"ع",2,0],["عَسَت دِمَنٌ بِالأَبرَقَينِ خَوالِ","تَرُدُّ سَلامي أَو تُجيبُ سُؤالي",77,"ل",2,1],["عَسى آيِسٌ مِن رَجعَةِ البَينِ يوصَلُ","وَدَهرٌ تَوَلّى بِالأَحِبَّةِ يُقبِلُ",78,"ل",1,1],["عَسى بِيَدي خَيرِ البَرِيَّةِ تَنجَلي","مِنَ اللَزَباتِ الغُبرِ عَنّا خُطوبُها",79,"ب",3,0],["عَسَت هَذِهِ اللَأواءُ تَطرُدُ كَربَها","عَلَينا سَماءٌ مِن هِشامٍ تُصيبُها",79,"ب",3,0],["عَسى أَن يُعيدَ الموقِدُ النارَ فَاِلتَمِس","بِعَينَيكَ نارَ المُصطَلي حَيثُ أَوقَدا",80,"د",2,0],["عَسى أَسَدٌ أَن يُطلِقَ اللَهُ لي بِهِ","شَبا حَلَقٍ مُستَحكَمٍ فَوقَ أَسوُقي",81,"ق",2,1],["عَسى أَن يَذُدنَ الناسُ عَنكُم إِذا اِلتَقَت","أَسابِيُّ مِجرٍ لِلقِتالِ وَنازِلِ",82,"ل",1,0],["عَسَت فُروغُ دِلائي أَن يُصادِفَها","بَعضُ الفَوائِضِ مِن أَنهارِكَ العُظُمِ",83,"م",1,0],["عَسى اللَهُ أَن يَرتاحَ لي فَيَكُفَّني","بِرَحمَةِ مَن هُو مِن أَبي هُوَ أَرحَمُ",84,"م",1,0],["عساكر تقدم أو تغيب","أيامه