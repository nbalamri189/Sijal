iewPoem.aspx?id=191622",""],[5111,"غَسَقُ الليْلِ","https://www.poetsgate.com/ViewPoem.aspx?id=212394",""],[5111,"عَشْتَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=212606",""],[5136,"ثقتي أنت يا كريم الذات","https://www.poetsgate.com/ViewPoem.aspx?id=121530",""],[5174,"تحيةُ مؤتمر المجلس الدولي للغة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=186006",""],[5205,"خطرت وقد خطرت هواتف خاطري","https://www.poetsgate.com/ViewPoem.aspx?id=120991",""],[5376,"في الليلة الظلماء ساد نواح","https://www.poetsgate.com/ViewPoem.aspx?id=194862",""],[5444,"يمن المحن","https://www.poetsgate.com/ViewPoem.aspx?id=185390",""],[5491,"صلى عليك","https://www.poetsgate.com/ViewPoem.aspx?id=215281",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5558,"ليست الغيرةُ في حبٍّ فقطْ","https://www.poetsgate.com/ViewPoem.aspx?id=211851",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5696,"بين الرياء والحياء","https://www.poetsgate.com/ViewPoem.aspx?id=151407",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5919,"هبّ نشرُ المعنبرِ المخزونِ","https://www.poetsgate.com/ViewPoem.aspx?id=128683",""],[5956,"في قاع نفسي حبكم مرصودُ","https://www.poetsgate.com/ViewPoem.aspx?id=194626",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""],[313,"أمل المحروم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66512&r=&rc=34",""]],"verses":[["وَعَلى صِراطِ الحَقِّ آلُكَ كُلَّما","هَبَّ النَسيمُ وَمالَتِ الأَغصانُ",0,"ن",1,0],["وَعَلى صَحابِتَكَ الَّذينَ تَتَبَّعوا","طُرُقَ الهُدى فَهَداهُمُ الرَحمانُ",0,"ن",1,0],["وَعَلِيٍّ صِنْوِ النبيّ وَمَنْ دِي","نُ فُؤادِي وِدادُهُ وَالوَلاءُ",1,"ا",2,0],["وعلى صدره الخفوق طوينا ال","ليلَ في زورقٍ رخيّ المسيرِ",2,"ر",1,0],["وعلى صدرها متى تتنهّد","موجة هزّت الصغيرين في المهد",3,"د",1,0],["وعلى صمتهم تهيأ شيخ","مثلما تخفق الطيوف الشوارد",4,"د",1,0],["وَعلى صَحابتهِ الكرامِ وَزِد عَلى","أَتباعهِ حتّى المعادِ عُموما",5,"م",2,0],["وَعَلى صحبهِ الأذى ضاقَ عنه ال","وسعُ مِنهم واِستحكم الإعتداءُ",6,"ا",2,0],["وعلى صاحبيك ثمة صهري","ك وعميك السادة النبلاء",7,"ا",2,0],["وَعَلى صَحابَتِهِ الكِرامِ وَأَهلِهِ ال","أَطهارِ وَالأَزواجِ وَالوِلدانِ",8,"ن",1,0],["وَعَلى صحابتك الجَميع وكل من","والاك يشهد حسن ذاك المشهد",9,"د",1,0],["وَعلى صحابتك الكرام الزهر ما","نادىّ بحي عَلى الصَلاةمنادى",10,"د",2,0],["وَعَلى صَحابتك الَّذين تشرفوا","وَسموا عَلى شهب السما احسابا",11,"ب",2,0],["وَعَلى صحابتك الكِرام وآلكال","أعلام ما وجدت حداة نياق",12,"ق",1,0],["وَعَلى صَحابتك الكِرام وآلك ال","أَعلام أَهل الفضل كل مهذب",13,"ب",1,0],["وعلى صحابته الأجلة ما غدا","علم الهدى متصديا للمستفيد",14,"د",1,0],["وَعَلى صَحبِهِ الكِرام وَقوم","تَبَعوهُم وَتابِعي تابِعيهِم",15,"م",1,0],["وعَلى صَفيحَةِ وَجههِ","لسَريع نَجدَتِهِ عَلامَه",16,"م",2,0],["وعلى صحبه الذي بذلوا الروح في السبيل","وعلى آله الذي",17,"ي",1,0],["وعلى صحابته الكرام وآله","وعلى الذي في أثرهم يتأثر",18,"ر",1,0],["وعلى صنو الرسول ومن","هو ليث اللّه في بلده",19,"د",2,0],["وعلى صحابته الكرا","م وآله والمسلمين",20,"ن",1,0],["وعلَى صَرحِ نُبوغٍ قد سَطا","فَهَوى ما بَينَ صُبحٍ وعَشِي",21,"ي",1,0],["وعلى صَهْوةِ السوابقِ تُبنى","من عَجَاجٍ للمجد شُمُّ القصورِ",22,"ر",1,0],["وَعَلى صَحابتك الكِرام جميعهم","والتابعين وكلّ من والاكا",23,"ك",2,0],["وَعلى صنيعك علّقت آمالها","وَإلى مساعيك الجليلة ترغبُ",24,"ب",1,0],["وَعليّ صهر النَبي الَّذي شا","م عَلى الشُرك سَيفه وَانتضاه",25,"ا",2,0],["وَعَلى صَهوة العُلا جئت تَسعى","بِتهانٍ فيها سُرور العُموم",26,"م",1,0],["وَعلى صَحابَتِكَ الَّذينَ سموا عُلىً","وَهُدىً وَآباءً رقوا وَجدودا",27,"د",2,0],["وعلى صخرة المضيق تجلى","فارس من سفوحنا للطّراد",28,"د",1,0],["وعلى صراطك يستقيم بشاهد","من علمه ثبتت به الاقدام",29,"م",1,0],["وعلى صحبه الكرام وال","خير صحب في العالمين وآل",30,"ل",1,0],["وعلى صحبه المهاجر منهم","وكذاك الايمة الانصار",31,"ر",1,0],["وَعلى صحابته وأنصار له","وَمهاجرين وَحور حور العين",32,"ن",1,0],["وعلى صحابتِه مصابيح الهدى","ما أعقبَ الإصباحَ ليلٌ مظلمُ",33,"م",1,0],["وعليٌّ صنو خيرِ الخلق مَن","قلعَ البابَ واردى مرحبا",34,"ب",2,0],["وعلى صحابته جميعا والألى","تبعوهم من بعد بالاحسان",35,"ن",1,0],["وعلى صحابَتِهِ الكرامِ وأهلِهِ","فعلى محبَّتِهم طَوَيتُ ضُلوعي",36,"ي",1,0],["وَعَلى صاحِبِهِ في الغارِ في","أَضحَلٍ لَمّا بِهِ قَد كَمَنا",37,"ن",2,0],["وَعَلى صِهرِ النَبِيِّ المُرتَضى","ذي المَعلي المُعجِزاتِ الأَلسُنا",37,"ن",2,0],["وَعَلى صَحابَتِكَ الَّذينَ تَشَرَّفوا","بِكَ إِذ غَدَوا لَكَ في العُلا أَصحابا",38,"ب",2,0],["وعلى صيتها على الغير طراً","كالثريا في نسبة للأديم",39,"م",1,0],["وعلى صحابته الكرام وآله","عين الورى ورؤسه وصدوره",40,"ر",2,0],["وعلى صدق ما ادعاه من الار","سال ابدى معاجزاً لا تناهى",41,"ا",3,0],["وعلى صحابتك الكرام ومن يلى","من آلك الطهر الميامين الغرر",42,"ر",1,0],["وعلى صدركَ الرحيبِ نياشينُ","فخارٍ دانَتْ لها الأقران",43,"ن",1,0],["وعلى صحابته الاشاوس في اللقا","في كل حرب للعداوة زكون",44,"ن",1,0],["وعلى صحابتك الذين ببأسهم","نشرت لقيم دينك الإعلام",45,"م",1,0],["وعلى صحابتة نجوم الاهتدا","لمن اقتدى بائمة أعلام",46,"م",1,0],["وعلى صحابته الكرام وآله","من حبهم راحي وروح فؤادي",47,"د",2,0],["وعلى صروح المجد ضاءَ زواهرٌ","ولقد زهت بعد الدروس خوالدُ",48,"د",1,0],["وعلي صاحب ذي الفقار فمن نجا","منه بترك الشرك فهو سعيد",49,"د",1,0],["وَعَلى صَحبِكَ الكِرامِ جَميعاً","خَير صَحبٍ موفّق باِتِّفاقِ",50,"ق",1,0],["وعلى صَدَاهُ أَفاقَ مُنتَحِبًا","وحَبيبُهُ وطبيبُهُ آهُهْ",51,"ا",3,0],["وعلى صراطِ القلبِ ينتحبُ الأسى","وشموسنا يلهو بها الإشراقُ",52,"ق",1,0],["وعلى صحابته الكرام وآله","ما مجَّد الذكرُ الجميل شمائله",53,"ل",2,0],["وَعَلَى'صَدْرِي شُمُوسٌ قَدْ تَمَارَتْ","لألأتْ ْ مِنْ صُوُرِ الوهْج قِلاعَا",54,"ع",2,0],["وَعَلى صَدْرِيْ جنوبٌ يَتَجَافَى","يَحْضُنُ الْحَمْرَاا، وَأطْيَافَ الشَّمَالِ",55,"ل",1,0],["وعلى صحبه الأكارم أرباب","التقى واليقين والصالحات",56,"ت",1,0],["وعلى صدري عقودُ الفلِّ من","(عدنٍ) أشذى عطورا، وابتساما",57,"م",2,0],["وعلى صحابتك الكرام وآلك ال","سامين في شرف بطيب عناصر",58,"ر",1,0],["وعلى صريخ بناتها آلامنا","وكأنُّه بهواننا لمَّاحُ",59,"ح",1,0],["وعلى صعيدِ الحبِّ يروي نبتةً","فلربما عاشتْ هناك بقُطرة",60,"ه",1,0],["وعلى صحابتهِ الكرام جميعهم","واقبل بفضلك سائر الطاعاتِ",61,"ت",1,0],["وعلى صحابته ومن والاهم","دينا وإتباعا لنص بيان",62,"ن",1,0],["وعَلى صاحِبِه أوْ أَهلِهِ","وعلى المالِ وما كانَ رَبَطْ",63,"ط",1,0],["وعلى صحبه الذين قفوْه","خطوةً خطوةً كما قد خطاها",64,"ا",3,0],["وعلى صدرها ثنايا من الخزْ","زِ مُلِحّ من تحتهن خُفوق",65,"ق",1,0],["وعلى صحبك الذين أقاموا","الدين والدين بينهم منصور",66,"ر",1,0],["وعلى صحبه وكلِّ محبٍّ","رقَّ طبعًا للذوق أشهى الفنون",67,"ن",1,0],["وعلى صعيد الود والتقدير أن","ت بنيت مجدي والوفا موجودُ",68,"د",1,0],["وعليٌ صاحب السيف الذي","صال بالسيف وفي الكفر قهر",69,"ر",1,0],["وعلى صدرك لحنا غرد","كلف الترجيع ما كلفه",70,"ف",2,0]]}