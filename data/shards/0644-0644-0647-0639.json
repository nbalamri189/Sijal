tps://www.poetsgate.com/ViewPoem.aspx?id=16156",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""],[5064,"ما زِلتُ آدمَ يا تُفّاح حوَائِي","https://www.poetsgate.com/ViewPoem.aspx?id=199159",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[5304,"اقف على درب المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=155912",""],[307,"جاهدتُ دهري للحروف وصولا","https://www.poetsgate.com/ViewPoem.aspx?id=213776",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[5582,"نَهَكَ الغَرامُ فُؤادَهُ وَحَشاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187332",""],[4623,"محبتي لك نجتني من العطب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146603",""],[5845,"دمي طللٌ بينَ الطلولِ بحاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=16706",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[6141,"لله عهد","https://www.poetsgate.com/ViewPoem.aspx?id=212764",""],[520,"إذا قدرت على العلياء بالغلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577434",""],[463,"حملتْ ركابُ الغربِ شمسَ شروقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60157&r=&rc=213",""]],"verses":[["لِلَّهِ عيدٌ كَبيرٌ","يَزهو بِنورِ جَبينِك",0,"ك",1,1],["للَه عرس في بهاء سعوده","زفت لدارك نجمة لا تجتلى",1,"ل",2,0],["للهِ عَهْدُكَ يَا رياضُ فَإِنَّهُ","عَهْدُ ائْتِنَافِ المَجْدِ فِي لُبْنَانِ",2,"ن",1,0],["لله عينا من رأى ملك العُلا","حَفَّ الوقارُ جمالَه بجَلالِ",3,"ل",1,0],["لِلَّهِ عَهدٌ مَرَّ لي في ظِلِّها","أَبكي عَلَيهِ وَتارَةً أَبكيها",4,"ي",3,0],["لِلَّهِ عَيشٌ لي وَعَيشٌ لَها","كُنتَ بِهِ سَمحاً رَخِيَّ الزِمام",5,"م",1,0],["لِلَّهِ عَهدُ سُوَيقَةٍ ما أَنضَرا","إِذ جاوَرَ البادونَ فيهِ الحُضَّرا",6,"ر",2,1],["لِلَّهِ عَبدونُ أَيُّ فَذٍّ","تَخِفُّ عَن وَزنِهِ الأُلوفُ",7,"ف",1,0],["لِلَّهِ عَقلُ الحَريصِ كَيفَ لَهُ","في كُلِّ ما لا يَنالَهُ أَرَبُ",8,"ب",1,0],["لِلَّهِ عَقلي ما يَزالُ يَخونَني","وَلَقَد أَراهُ وَإِنَّهُ لَصَليبُ",9,"ب",1,0],["لِلَّهِ عَيناكَ تَكذِبانِكَ في","ما رَأَتا مِن تَصَرُّفِ الغَيرِ",10,"ر",1,0],["لِلَّهِ عاقِبَةُ الأُمورِ","طوبى لِمُعتَبِرٍ ذَكورِ",11,"ر",1,1],["لِلَّهِ عاقِبَةُ الأُمورِ جَميعاً","أَخشى التَفَرُّقَ أَن يَكونَ سَريعا",12,"ع",2,1],["لِلَّه عَينٌ مِنكِ مُخبِرَةٌ","عَنِّي بِكُلِّ سَريرَةٍ عَنكِ",13,"ك",1,0],["للّهِ عَينَا مَن رَأى إخبْاتَهُ","لمّا أتاهُ بَريدُها الإجْفِيل",14,"ل",1,0],["لِلَّهِ عَجزاءُ كُلَّما اِنصَرَفَت","خَلَّت عَلَيهِ أَجَلَّ مِن أُحُدِ",15,"د",1,0],["لِلَّهِ عَبدَةُ إِذ غَدَت","مِنّا تُزَفُّ إِلى اِبنِ قائِد",16,"د",1,0],["للَّهِ عبدُ الرَّحمنِ من مَلكٍ","لابسِ ثوبِ السَّماحِ مُعتقدِهْ",17,"د",2,0],["للَّهِ عبدُ الرَّحيم من مَلكٍ","ما بعدَهُ للعيونِ مُطَّرحُ",18,"ح",1,1],["لِلَّه عيشٌ قد تقلص ظله","من بعد مسعدتي به وتنعمي",19,"م",2,0],["لِلَّه على الأحقاف دم","أَهريق فراعك مشهده",20,"د",2,0],["لِلهِ عُزْلَتُهُ وَمِنْ شُرُفَاتِهَا","يَرْمِي الجِهَاتِ بِلَحْظِهِ الجوَّالِ",21,"ل",1,0],["للّهِ عُرْسُكُمَا وَالدَّهْرُ مُبْتِسمٌ","وَاللَّيْلُ أَوْهى نَسِيلٍ شَفَّ عَن سَحَرِ",22,"ر",1,0],["لله عَيْنَانِ تَكْذِبانِكَ في","ما رَأتَا مِنْ تَصرّفِ العِبَرِ",23,"ر",1,0],["للّهِ عَقلُ الحَريصِ كَيفَ لَهُ","، فِي جمعِ مالٍ مَا لَهُ أدَبُ",24,"ب",1,0],["لله عيناً من رأى إخباته ... لما أتاه بريدها الإجفيل","وسجوده حتى التقى عفر الثرى ... وجبينه ، والنظم ، والتبجيل",25,"ل",1,0],["لله عَبْدُونُ أيُّ فَذٍّ،","َخِفُّ عَن وَزْنِهِ الألوفُ",26,"ف",1,0],["لله عهد مرّ لي ظلّها","أبكى عليه وتارة أبكيها",27,"ي",3,0],["لِلَّهِ عَصرٌ بِذِي الإِثلِ انقَضَى ومَضَى","سَقِيتُ بِه العُدُوَّ المُستَشِيطُ َدَمَه",28,"م",2,0],["لِلَّهِ عَصرُكَ ما أَوفى مَحاسِنَهُ","كَم يَقظَةٍ فيهِ خِلنا أَنَّها حُلُمُ",29,"م",1,0],["لِلّهِ عودٌ إِذا أَوتارُهُ اِصطَفَّت","مِن أَجلِها كُل عرقٍ راحَ مصطَفِقا",30,"ق",2,1],["للّه عصر شبيبة قضيّته","وزمان لهو كله افراح",31,"ح",1,0],["لله عزا ومجدا قد حويتهما","فكيف لا تشرق الدنيا وتفتخر",32,"ر",1,0],["لِلَّهِ عَهدُ هَوىً وَعَصرُ شَبيبَةٍ","فارَقتُهُ فَتَجَمَّعَت أَطرافي",33,"ف",2,0],["لِلَّهِ عَهدُ الوَصلِ لَو أَنَّهُ","دامَ وَأَيّامُ الهَوى العيدُ",34,"د",1,0],["للَّهِ عَهْدٌ لِلرُّصافَةِ سالِفٌ","يَصِفُ الشَّبيبَةَ وَهيَ فِي رَيْعانِها",35,"ن",3,1],["لله عاقبةُ الأمورِ فمالنا","علمٌ بأمرٍ راجعٍ لله",36,"ل",2,0],["لله عفوٌ واسعٌ وتجاوزٌ","يرجوه مثلي عاصياً لله",36,"ل",2,0],["لِلَّه عقوتُها الَّتي نالَت بِها","نَفسي من اللَذّات كُلَّ نصيبها",37,"ب",3,0],["لله عهد الظاعنين وغادروا","قلبي رهين صبابة ووجيب",38,"ب",1,0],["للهِ علْيا قِوامِ الدّينِ من مَلِكٍ","راجيهِ ذو سببٍ باللهِ مُتَّصِل",39,"ل",1,0],["للهِ عَهْدٌ بالحِمَى لم أنْسَه","أيّامَ أعصي في الصَّبابةِ عُذَّلي",40,"ل",2,0],["للهِ عَينٌ رأتْ بمَصرَعِه","كيف غمامُ المكارمِ انقَشعا",41,"ع",2,0],["لِلّهِ عَيش نَهبناهُ بِهِ رَغداً","كانَت كَأَيامِهِ بيضاً لَياليهِ",42,"ي",2,0],["لِلّهِ عَيش مَضى وَالوَصل مُتَصِلٌ","عَلى الكَثيب سَقاهُ العارض الهَطل",43,"ل",1,0],["لِلَهِ عَزمٌ مِن وَراءِ تِهامَةٍ","نادى فَثرتُ مُلَبِياً لِندائِهِ",44,"ا",3,0],["للهِ عَيْنٌ رأَتْهُ وَهْوَ بدرُ دُجىً","يوماً أَهَلَّ فجلَّى نورُهُ الأُفُقا",45,"ق",2,0],["للّه عيشٌ بالحمى تعلَّقتْ","حبالُهُ بيد قطَّاع العُلَقْ",46,"ق",1,0],["للّه عينا مالىءٍ من لؤلؤٍ","عينيه يومَ وداعنا وعقيقِ",47,"ق",1,0],["للهِ عزَّ شأنُهُ","بسِرِّهِ المُرَفْرَفِ",48,"ف",1,0],["لله عَزْمُهُمُ الفَعَّالُ كم فَعَلا","لله كفُّهمُ الفَيَّاضُ كم وهَبَا",49,"ب",2,0],["لله عزمة محي الدين كم تركت","بتربة الحي من خد امرئ ترب",50,"ب",1,0],["لله عزمك من قوص ومورده","فسطاط مصر ودون الورد أهوال",51,"ل",1,0],["للهِ عصْرٌ كالرّبيعِ مَضَى","والرَّبْعُ رَوْضٌ والمِلاَحُ زَهَرْ",52,"ر",1,0],["لِله عَزْمَتُه الَّتِي لاَ تَرْتَوِي","حَتَّى تكُونَ لها المَجَرَّةُ مَوْرِدَا",53,"د",2,0],["لله عينا من رأى","هلكاً كهلك رجاليه",54,"ي",2,1],["لله عيشٌ سالفٌ","واللّهو مَوْفورُ النِّصاب",55,"ب",1,0],["للَّه عِيسُكَ يَوْمَ حَنَّتْ لِلنَّوى","لَمْ يُبْقِ مُطْلَقُها لَنَا مَعْقُولا",56,"ل",2,0],["للّه عزمُك في القفار وأنت في","جنح الدجى طلق الحيا بسّامه",57,"م",2,0],["للّه عيش ذهبت نضرته","كأنه رقدة ظل زائل",58,"ل",1,0],["لله عَيشُكِ يا لياليَ تُوضَحٍ","ما كان أنضر عَيشَكنَّ وأرفَغا",59,"غ",2,0],["لله عزان بن قيس مَنْ سخا","بالعدل في ذاك الزمان الباخلِ",60,"ل",1,0],["لله عيش مضى في سفح كاظمة","قد مر حلواً مرور الطيف في الحلم",61,"م",1,0],["لِلَّهِ عَفْوِي عَنْكِ وَاظِّلَامِي","قَبْلَكِ ما أَغْبَا ذَوِي الخِصامِ",62,"م",1,0],["لِلَّه عَيني الَّتي فُجعت بِها","لَو أَنَّ دَهرا بِها يواتيني",63,"ن",2,0],["لله عامٌ أتى الريبال يرفل مع","أشباله بخلاعٍ جلّ منعمها",64,"م",3,0],["لله عصرٌ قد زها","فلك السعادة فيه دارْ",65,"ر",1,1],["لله عيش قد تقضى في الحما","بين المقيم على الوفا والظاعن",66,"ن",1,0],["لله عام اتى","عرف الهنا فيه فاح",67,"ح",1,1],["لِلّه عهد هوى لأيام اللوى","أرخت عليه المعصرات عهادها",68,"د",3,0],["لله عزمك يا أبا عمرٍ إلى","طاعات ربِّك إذ نهضتَ مُشمِّرا",69,"ا",1,0],["للَه عين غزال من عيونك ما","والت محبّاً ولا عنَّت على عاني",70,"ن",2,0],["للَه عائدةٌ جادت بريق فمٍ","ما كان أطيبه يا سادتي بفمي",71,"ي",1,1],["للَه عيسٌ يممت بأبي الوفا","أرضاً يعود برفدها زوارها",72,"ر",3,0],["لله عِمرانُ المُكَرَّمُ إِنَّهُ","أَغضى وقد أَصْلى العِدى جَمْرَ الغَضا",73,"ض",2,0],["لِلّهِ عاقِبَةُ الشِهابِ فَإِنَّها","ما بَلَّغَت فينا العِدا آمالَها",74,"ل",3,0],["لِلّهِ عرساً يا خَليفَةُ إِنَّها","لَمسيرة بِمآتم الأَعداء",75,"ا",2,0],["لِلَّهِ عَهدُ سُرورٍ كُنتُ أَحسَبُهُ","يَدومُ لي وَسِوى ذي العَرشِ لَم يَدُمِ",76,"م",1,0],["لله عالي منار الحمد نظرته","تملك الحمد بالغالي من الثمن",77,"ن",1,0],["للَه عينكم فيها فكم سفحت","دمعاً تحدر من آماقها وجرى",78,"ر",2,0],["لله عبد مشى المختص في طلبه","وقد أقام له البرهانُ في طلبه",79,"ب",2,1],["لِلّه عَين رَأَت نَعش الحُسين وَقَد","سارَت مَلائِكة الباري بِهِ زُمَرا",80,"ر",2,0],["لِلَّهِ عَينَيَ مِن عَينٍ لَقَد طَلَبَت","ما لَم يَكُن دانِياً مِنها وَلا سَقَبا",81,"ب",2,0],["لله عَتّابُ بن ميّةَ اذ رأى","الى ثأرنا في كفّهِ يَتلدَّدُ",82,"د",1,1],["لِلّه عِندي عادة مَشكورة","في مَن يُعاديني فَلا تَتَحير",83,"ر",1,0],["لله عيد قد جلا","بضياء طلعته العنا",84,"ن",2,