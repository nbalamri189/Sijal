{"poems":[[46,"عجب لعمرك أن وجهك معرض","https://www.aldiwan.net/poem29710.html","الكامل"],[46,"عجب لعمري أن وجهك معرض","https://www.aldiwan.net/poem30381.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54738","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[208,"غصص الفراق مزجن بالحسرات","https://www.aldiwan.net/poem53353.html","الكامل"],[1083,"","https://poetry.dctabudhabi.ae/diwan/poem/29488","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116493","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65953","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65115","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65182","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132141","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114072","الكامل"],[4788,"متن السحابه","https://www.poetsgate.com/ViewPoem.aspx?id=132250",""],[5911,"عجب لذا الكحال كَيفَ أضلني","https://www.poetsgate.com/ViewPoem.aspx?id=188964",""],[6056,"الشمس والفيّ","https://www.poetsgate.com/ViewPoem.aspx?id=130382",""]],"verses":[["عَجَبٌ لَعَمرُكَ أَنَّ وَجهَكَ مُعرِضٌ","عَنّي وَأَنتَ بِوَجهِ فِعلِكَ مُقبِلُ",0,"ل",1,1],["عَجَبٌ لَعَمري أَنَّ وَجهَكَ مُعرِضٌ","عَنّي وَأَنتَ بِوَجهِ نَفعِكَ مُقبِلُ",1,"ل",1,1],["عَجبٌ لعَمرُكَ أَنْ تُصادفَ رَاجِلاً","يَمْشِي فَيَتْعَبُ وَهْوَ رَبُّ جَوَاد",2,"د",1,0],["عَجَبٌ لِقَوْمٍ لاَتَنِي آثَارُهُمْ","هِيَ أَعْظَمُ الآثَارِ في الْغَبْرَاءِ",3,"ا",2,0],["عجبٌ لمَن يبقى لبُعد حبيبه","أن لا يموتَ بكثرة الزفراتِ",4,"ت",1,0],["عجب لتلك قضيةٌ وإقامتي","فيكم على تلك القضية أعجبُ",5,"ب",1,0],["عجب لأمة أحمد من بعده","يتقصفون بنية كالاهداف",6,"ف",1,0],["عجب لهم إذ دبروا كيف دبروا","وما وردتهم بالسيوف جنود",7,"د",1,0],["عجبٌ للزّمان عنّي جموحٌ","ولكلّ الأنام سهلُ القياد",8,"د",1,0],["عجب لعقرب صدغه في بُعدها","لدغٌ وعند مساسهنّ شفائي",9,"ي",1,1],["عج بلبنان بعد طوال اغتراب","ليرى أنك الحسام الصقيل",10,"ل",1,0],["عَجَبُ لأختٍ مَع أخِيهَا تُقرَبُ","وَمَعَ ابنِهِ وَهوَ المُبَعَّدُ تُحجَبُ",11,"ب",1,1],["عجب للشعر لا منه لفاني","يعلمني الرسم قبل الكتابه",12,"ب",2,0],["عجب لذا الكحال كَيفَ أضلني","وَلكم أضلّ بميله وبمينه",13,"ن",2,1],["عجب ! للمسافة بيننا في طريق الغي ّ","متاهات حسيّة وخطوات مربوكة",14,"ك",2,0]]}