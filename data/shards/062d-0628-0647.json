584",""],[6001,"أبو أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=315",""],[6001,"الصوت مايغني عن الشوف","https://www.poetsgate.com/ViewPoem.aspx?id=372",""],[6056,"لوحة الإحتضار","https://www.poetsgate.com/ViewPoem.aspx?id=130351",""],[6056,"مجاريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=130501",""],[6056,"أبدع المنظوم","https://www.poetsgate.com/ViewPoem.aspx?id=156714",""],[6113,"ذكريات....بحرجده","https://www.poetsgate.com/ViewPoem.aspx?id=36932",""],[6142,"بالغريين وبين الذكوات","https://www.poetsgate.com/ViewPoem.aspx?id=155734",""],[6249,"صدفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85659&r=&rc=2",""]],"verses":[["حبها تحتي وفوقي ويميني","وشمالي وأمامي وورائي",0,"ي",1,0],["حُبَّها أَو أَو فَرقاً مِن هَجرِها","وَصَريحُ الذُلِّ حُبٌّ أَو فَرَق",1,"ق",1,0],["حبُّها فاعلٌ بقلبيَ أفعا","لَ يديهِ في مالِهِ المذخورِ",2,"ر",1,0],["حُبَّهُ حَتّى تَبَلّى جِسمُهُ","وَبَراهُ طولُ أَحزانٍ وَهَم",3,"م",1,0],["حَبَّة أَنْبَتَتْ سَنَابِلَ والعَص","فُ لَدَيْهِ يَسْتَشْرِفُ الضُّعَفَاءُ",4,"ا",2,0],["حُبُّ هَذا لا سِوى ذا","مَحَقَ الأَعمارَ مَحقا",5,"ق",2,0],["حُبُّهُ مِصْرَ قَلْبُهُ وَبِه يَحْ","يَا لَهَا وَالوَفَاءُ حَبْلُ الوَرِيدِ",6,"د",1,0],["حُبُّه دَيْنٌ وَدِينٌ للورَى","يَا لهُ في الحبِّ من دِينٍ ودَيْنْ",7,"ن",1,0],["حُبُّهُ جَمَّعَ الْقُلُوبَ كَمَا","تَجْمَعُ بَلُّورَةٌ شَتِيتَ الضِّيَاءِ",8,"ا",2,0],["حَبَّةٌ أَنْبَتتْ سنابلَ سَبْعاً","ثُمَّ مِلءَ الفَضَاءِ من سُنْبُلاتِ",9,"ت",1,0],["حُبُّهَا، أوْ فَرَقاً مِنْ هَجْرِهَا،","وَصَرِيحُ الذّلّ حُبٌّ، أوْ فَرَقْ",10,"ق",1,0],["حُبُهُ في القُلوب سِرٌّ خَفيّ","كَحُلول الأَرواح في الأَجسام",11,"م",1,0],["حبه راحي وروحي ابدا","راس مالي حين يبدو عملي",12,"ل",2,0],["حبة الاصطلام فيهم اقامت","في فؤادي بالوجد سبعين حبه",13,"ب",2,0],["حبُّهم وَالشقاءُ ضدّان لن يج","تَمِعا وَالنجاة والبغضاءُ",14,"ا",2,0],["حبُّهم جنّةُ المحبّ وبغض ال","بَعضِ نارٌ والمبغض الحلفاءُ",14,"ا",2,0],["حبُّهم جنّةُ المحبِّ إذا لم","تَصحَبَنهُ لصحبك البغضاءُ",14,"ا",2,0],["حُبُّها كانَ مطهراً لِعَذابي","قُمتُ مِنهُ إِلى نَعيمٍ قائِم",15,"م",1,0],["حُبُّهُ زينَةُ قَلبي","لَيسَ مالاً وَبَنون",16,"ن",1,0],["حُبُّهُ قَد نيطَ مِن","حَبَّةِ قَلبي بِالنِياطِ",17,"ط",1,0],["حبّهم لي سعادةٌ وعليهم","ليس يخفى ما كان بالحبّ فاشي",18,"ش",2,0],["حبُّها نعمةٌ لنا وَلدَيها","تتَساوى السرَّاءُ والضرّاء",19,"ا",2,0],["حبهم حل سويدا مهجتي","وَفؤادي بعد ما فت العظاما",20,"م",2,0],["حُبُّهُ لُؤلُؤٌ مِنَ الثَغرِ يُبديهِ","لِمَن رامَ صَيدُهُ بِاِبتِسامَه",21,"م",2,0],["حُبُّهُ ساكِنُ القُلو","بِ فَكُلٌّ رَبوعُهُ",22,"ع",2,0],["حُبُهُ عَلَمَني إِن اِنظَما","كُل عَقد في الغَراميّ عَجَب",23,"ب",1,0],["حُبّهُمُ شِيمتي ومُعْتقَدي","ومَذْهَبي في الورَى ومُلْتزمي",24,"م",2,0],["حُبُّها في القَلبِ داءٌ","مُستَكِنٌّ لا يَريمُ",25,"م",1,0],["حبها العذري لازم القلب حتى","تعبت في مراسه الأهواء",26,"ا",2,0],["حُبُّهُم ثابتٌ ثُبوتَ الرَوَاسِي","وجَفَاهُم يمُرُّ مرَّ السَّحَاب",27,"ب",1,0],["حبها حبنا لها أبداً","وهو فينا بالحب والبغض",28,"ض",1,0],["حُبُّهم رُوحي وَراحي","وهُوَ دُنْيايَ وَدِيني",29,"ن",2,0],["حبُّهُ لم يبقِ مني","غير سهدي وعذابي",30,"ب",2,0],["حبه الشمس لها في","شروق وغروب",31,"ب",1,0],["حُبُّه قَد حَلَّ قَلبي وَالحَشا","فَحَشاهُ مِن تجَنّيهِ بِنارْ",32,"ر",1,0],["حُبُّهُ تَيَّمَني","زادَ فيهِ كَلَفي",33,"ف",2,0],["حُبُّه عَن خَلَدي","لَيسَ بِالمُنصَرِفِ",33,"ف",1,0],["حَبُّه رَبُّه غَيرها لَهُ","جارية تَسوى أَلفين قرشي",34,"ش",2,0],["حَبَّةُ بُرٍّ لي مِنها أَنفَع","فَاِدفَع إِليَّ ما تُريدُ تَدفَعُ",35,"ع",1,0],["حبهم فرضي ونفلي","وحديثي ثم شغلي",36,"ي",1,1],["حبّه حبّه إذ يوادعني","حينَ أبصرني عنه مُرتحلا",37,"ل",2,0],["حبّهُ العذبُ بِلَحمي ودمي اِخ","تَلطَ الآنَ اِمتزاجاً واِرتَبَك",38,"ك",1,0],["حُبهُ دأب ولَكن","لَيسَ في كُل أَوان",39,"ن",1,0],["حبه سكن في الضمير","باحلف على ذا يمين",40,"ن",1,0],["حبة أنبتت سنابل والسن","ابل منها تلقى به مية حبه",41,"ب",2,0],["حبها في الفواد مني مقيم","قد نمى في الفواد مذ كنت طفلا",42,"ل",2,0],["حبه كالمحك يمتاز فيه","معدن الخلق من نحاس وعسجد",43,"د",1,0],["حُبه بَينَ البَرايا مَذهَبي","لَم أَجد عَنهُ إِلى الغَير التِفات",44,"ت",1,0],["حُبُّهُ أورَثَ قَلبي","لوعةً ثمَّ كِلاما",45,"م",2,0],["حبها ظلة بعمروٍ زعيماً","ويح قوم يكون من زعماها",46,"ا",3,0],["حبّه روحي وراحي","وسروري وانشراحي",47,"ي",1,0],["حبَّهُ شفَّعَهُ قدَّمَهُ","وبيوم الحشر منهُ قرَّبا",48,"ب",2,0],["حبهم مذهبي بغير غلو","وإليهم إما دعيت انتدابي",49,"ب",2,0],["حبه وهو بقلبي فاتكٌ","ما أنا في رآه سالك",50,"ك",1,0],["حبة الخال الذي في خده","هي قد كانت لاسرى سببا",51,"ب",2,0],["حبه قد أار نومي وأجرى","دمع عيني ولم يدع لي اصطبارا",52,"ر",2,0],["حبه جنة لكل محب","بغضه بغض خاتم الأنبياء",53,"ا",2,0],["حبهم فرض طاعة وهو دين","فاتل قل لا ودن بما بعد الا",54,"ل",2,0],["حُبُّهُ وَاجِبٌ عَلى كُلِّ مَن آ","مَنَ بِاللَهِ وَالرَسولِ مُحَمَّد",55,"د",1,0],["حبه مالكي واحمد شيء","شافع لي وهو الإمام الأعظم",56,"م",1,0],["حبهم حل سويدا مهجتي","فجواه في الحشا يذكو ضراما",57,"م",2,0],["حُبّه بالفؤاد واللّحظ داع","وبنجم من خدّه مرصُود",58,"د",1,0],["حبّهُ في قلب أمّتهِ","راعَ منها السمع والبصَرا",59,"ر",2,0],["حِبّه طبيعي هُوبْ زَعّال","كَمْ كَمْ وصَلْني حَافي الريل",60,"ل",1,0],["حِبّه بْقَلبي بَحر طامي","وْليت معه بقعه لو غِزر قيد",61,"د",1,0],["حبه الأكسير لو ذر على","ما حوى الامكان من ماض وآت",62,"ت",1,0],["حبه الأكسير لو ذر على","كل نبت لحلا كل نبات",63,"ت",1,0],["حبّهم طبعي وهل أحد","خارج عن طبعه البشري",64,"ر",2,0],["حبة يزرعها في كونه","تلكم النعمى فأين الجود فيها",65,"ه",2,0],["حُبَّهُ ثابِتٌ بِقَلبي وَأَبى","لِسِواهُ عَن لَوحِ قَلبي مَحَيتُ",66,"ت",1,0],["حُبُّهُ الخَمرُ لا بَلِ الخَمرُ يَصحُو","بَعدَ سُكرِهِ شارِبٌ وافَاهُ",67,"ا",2,0],["حبها عني كذؤبان الغضا","تملأ الدنيا طرادا وغوارا",68,"ر",2,0],["حبّهُ فائقٌ جَرى في فُؤادي","مِثل جَريِ المياه في الأَغصانِ",69,"ن",1,0],["حبه ديني وفي دين الهوى","ما على أهل التصابي من جناح",70,"ح",1,0],["حبهم حبة الوالد لمن كان مولود","حبهم صدق صافي نصح ما فيه منقود",71,"د",1,0],["حبهم ديني في دنياي إذ","يحشر المرء غدا مع من أحب",72,"ب",1,0],["حُبّها جارَ عَلَيّا","دُلَّني كَيفَ السَبيل",73,"ل",1,0],["حبها سكر ولكن","وصلها ما إن ينال",74,"ل",1,0],["حبه بارز بدا من ضميري","وعلينا فرض ولاء الامير",75,"ر",1,0],["حبها فرض من الحسن أتى","فيه نص بجميع الكتب",76,"ب",1,0],["حبهم للجنان قد عاد نهجاً","وولاهم أضحى له أعرافا",77,"ف",2,0],["حبة الإكسير لو ذّر على","رمم رف بها روح الحياة",78,"ه",1,0],["حبه فرض على كل الورى","وهو في الحشر أمان ونجات",78,"ت",1,0],["حبه الاول مازالت....له كل السياده","وهو محكوم بقلبه ...عرف الحب عباده",79,"د",2,0],["حبهم ألطف من ريح الصبا","والحب في سواهم لن يلطفا",80,"ف",2,0],["حُبّهَا شادٍ بِقَلْبِي غَرّدَا","حُبّهَا عِطْرٌ لِرُوحِي أَسْعَدَا",81,"د",2,1],["حبّها ينحتُ دربَ القدر ِ","بخطى الحبّ ليمشي عُمُري",82,"ر",2,1],["حبّها ماءٌ غزا أوردتي","لستُ أهديهِ عوام البشرِ",82,"ر",1,0],["حبه تمكّن فيه والحب ضامه","باخر عشر يمشنّ بعد الثلاثين",83,"ن",1,0],["حبه غرس في داخلي وامتحني","ياليت عامي مافرق جنب عامه",84,"م",2,0],["حبه في القلب مثل ال","برعم الوردي لاصق",85,"ق",1,0],["حبه اللي كتبته بالغلا ما محي","أرخص الروح لكن فيه ما ارخص هواي",86,"ا",2,0],["حبه قعدت ابنيه عدة سنوات","وفرقاه في كسرة عصا دون تعليل",87,"ل",1,0],["حبه بصدري سالفة سر في بير ..",".. وكن الفواد يقول هذا زبيني",88,"ن",2,0],["حبه بناه وفاق كل الموازين","بوصل وجفا وبمنام وتسهد",89,"د",1,0],["حبه سكن مني معاليق الارواح","ويشدني جدواه طبعه النصوحي",90,"ح",2,0],["حبها حافظينه في مكانن رفيع","في ظميري مخبا جاعلن دونه ستار",91,"ر",1,0],["حبه بالروح ممتزج","ومع الأنفاس معتلج",92,"ج",1,1],["حبهم مازج روحي مثل ما","مازجت روحي عروقي والعظما",93,"م",2,0],["حبُّها في القلبِ نارٌ","في حنايا القلبِ تلفحْ",94,"ح",1,0],["حبها ما زال في خَلَدي","ما خبا وجدٌ ولا ضؤلا",95,"ل",2,0],["حبه في قلبي عايش سنين","ما يختلف لو صار ما صار",96,"ر",1,0],["حبَّه سرَى بي سرية الغيم بالليل",". . . نسيم ليله قال للشوق هيّا",97,"ي",2,0],["‏حُبُّه من ذلك النوع الذي","‏يأنفُ الذلةَ للطرفِ الكحيلْ",98,"ل",1,0],["حبه بمكنون الضماير تمكن","غصب علي القلب مني نهجله",99,"ل",2,0],["حبه بمكنون الحشا جاحني جوح","حبن شكاه عقاب ولد العواجي",100,"ج",2,0],["حبه صبغ بالقلب يا عمير ماشوم","ما ينمحي طول الليالي والايام",101,"م",1,0],["حبه بمكنون الضماير تبنا","الله على لاماه يا ليت يا ليت",102,"ت",1,0],["حبها بالدم ..... ماهو بالكلام.","من هيامي عاشقٍ حتى القصيم.",103,"م",1,0],["حبه تحي به الأنفس من","طيب الأنفاس من كل الأنام",104,"م",1,0],["حبهم ليس فيه نكثٌ ولا غد","رٌ ولا ريبة ولا تزويق",105,"ق",1,0],["حبُّها قادَ إليها","فأجابوا ما اشترطْ",106,"ط",1,0],["حُبُّهُ للجحشِ مقرونٌ بما","كانَ حَمَّالَ غرامٍ مُشْتَرَكْ",107,"ك",1,0],["حُبُّهُ للجحش مقرونٌ بما","كان في أحلى غرامٍ منهمِكْ",107,"ك",1,0],["حبه دعالي القلب متعوب","ساهر اناجي الطيف واهيم",108,"م",1,0],["حبه بقلبي شيّد رفوف","والحب بلوى هوب يخفاك",109,"ك",1,0],["حبها وسط جسمي ساري ٍ بإنتظام","يحتضنها خفوقي ، كلما الدم دار",110,"ر",1,0],["حبها يجري بدمي في الحشا يغلي غلي","في عروقي نار تحرق تلهب بقلبي لهيب",111,"ب",1,0],["حبها في القلب مدري عن مداه","من سببها شبت من قبل المشيب",112,"ب",1,0],["حبهااللي بالحشى ماعاش نده","والغلى لومت والله اني ازيده",113,"د",2,0],["حبه الإكسير لو ذر على","علقم المهل اغتدى عذب الفرات",114,"ت",1,0],["حُبُّها مُنعَطَفٌ في عُمُري","أَمَلي أَبقى بِهذا الْمُنعَطَفْ !",115,"ف",1,0]]}