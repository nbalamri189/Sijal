{"poems":[[23,"نب المساكين أن الخير فارقهم","https://www.aldiwan.net/poem21506.html","البسيط"],[91,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[63,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[48,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[131,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[458,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[469,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96024","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87752","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48287","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48444","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86510","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101374","البسيط"],[585,"حياك منهمرُ الغوادي الجون","https://www.poetsgate.com/ViewPoem.aspx?id=161937",""],[5105,"وإني لأستشفي بطيفٍ مُسَلِّمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=135340",""],[5725,"هنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206598",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[6171,"ثورة الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84674&r=&rc=4",""]],"verses":[["كانَ الضِياءَ وَكانَ النورَ نَتبَعُهُ","وَكانَ بَعدَ الإِلَهِ السَمعَ وَالبَصَرا",0,"ر",2,0],["كان الضمير مسيرا","لي في الزمان الاول",1,"ل",1,0],["كأنَّ الضَّرْبَ عَوَّضَ شَفْرَتَيْهِ","بماءِ الطَّبعِ ماءَ الأُرجُوانِ",2,"ن",1,0],["كأنّ الضّبّ كان له سُجَيْراً","فحالَفَهُ على فَقْدِ الأُوَامِ",3,"م",1,0],["كَأَنَّ الضَبابَ بِالصَحارى عَشِيَّةً","رِجالٌ دَعاها مُستَضيفٌ لِمَوسِقِ",4,"ق",1,0],["كانَ الضليع بكلِّ عبءٍ مُثقلٍ","هَيهاتَ يَحمل عبأه من يظلعُ",5,"ع",1,0],["كأن الضاد لما غزالته","حمته مع الصبي الحلو المصون",6,"ن",1,0],["كأنَّ الضُّحى سرٌّ غداة لقائهِ","من الهبوات السُّود في صدر كاتمِ",7,"م",1,0],["كان الضبا فيه نجوم مضيئة","ويومهم من ثآير النقع غيهب",8,"ب",1,0],["كَأَنَّ الضياع المقفرات جَزائر","أَحاطَ بِها بَحر مِن الثَلج قالس",9,"س",1,0],["كأنّ الضحى وجْهُ الخليفةِ يوسُفٍ","وما احْمرَّ فيه من سنَا الفجْرِ بَنْدُهُ",10,"د",2,0],["كأنّ الضُحى إذ طالَ ليْلي مُغْرَمٌ","كمثلي يُرَجّي القُرْبَ والقرْبُ مُعْوِصُ",11,"ص",1,0],["كأن الضحى قد شق جلبابه أسى","فلم يدر أني بعده يتجلبب",12,"ب",1,0],["كان الضعيف إذا مد القوي يداً","لظلمه ردها مدفوعة بيد",13,"د",1,0],["كان الضحية للعراق وليتهم","جعلوا الضحية فيه كل خئون",14,"ن",1,0],["كأن الضحى يعتلُّ منه فيكتسي","شحوباً وعينُ الشمس تقذَى وتَرْمَدُ",15,"د",1,0],["كأن الضلوع نصالٌ نضتْ","يقدّ بها الزرد المتقنا",16,"ن",2,0],["كَأنَّ الضَّنى وَقفٌ عَلَيها لإَنَّها","تُهَيِّيءُ ماءَ الوَردِ لِلأعيُنِ الرُّمدِ",17,"د",1,0],["كان الضياع رفيق العمر ، كان به","شقي روح ! له في دهره رقعُ",18,"ع",1,0]]}