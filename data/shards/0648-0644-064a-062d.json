,1],["ولي حاجة أرجو لديك نجاحها","ومثلك من ترجى لديه الصنايع",98,"ع",1,0],["ولي حاجة من بنات الفؤاد","سقتها الأماني ولم تثمر",99,"ر",1,0],["وليحْصّيَنْ عمَلُ الفتَى أو قولُهُ","وَليُعْرِضَنَّ صَحيحُهُ وَمُحالُهُ",100,"ل",2,0],["وَلي حبيبٌ وإنْ شَطَّ المَزَارُ به","بَيْني وبَيْنَ الرَّدى في حُبّهِ سَبَب",101,"ب",1,0],["ولي حَبِيبٌ وإن شطَّ المَزَارُ به","وقدْ أقُولُ نأَى لولا تَذكُّرُه",102,"ر",2,0],["وَلي حُقوقٌ غَيرُ مَجهولَةٍ","يَعرِفُها العاقِلُ وَالجاهِلُ",103,"ل",1,0],["وَلي حَبيبٌ أَبَداً مولَعٌ","بِزَورَتي في وَقتِ إِعدامي",104,"ي",1,1],["ولي حبيب الوذ فيه باو","صاف وفحواه فوق ما أصف",105,"ف",1,1],["وليحشه ثم يصلي به","من بعد إسباغ من الطهر",106,"ر",1,0],["ولي حسنات لو أمت ببعضها","الى الدهر لم يرتع بنائبة سربي",107,"ب",2,0],["ولّى حُمَيْدٌ ولم ينظرْ فوارسه","قبل التَقرَّة والمغْرورُ مغرورُ",108,"ر",1,0],["ولي حاجةٌ لا أَبتغي منك غيرها","فَجُدْلي بها وهْيَ الخَلاص من السِّجنْ",109,"ن",1,0],["وَلِى حُسنُ ظَنٍّ بِكُم مُستَطِيب","إِذا الصُّحفُ سِيقَت إِلَينا تَطِير",110,"ر",1,0],["ولي حب عليه القلب وقف","ليسكنه ويبتهج المزار",111,"ر",1,1],["وليحفظنه بارقٌ يرقى بِهِ","في أشرفِ المعراجِ ثم يعيدُهُ",112,"د",2,0],["وليحسن الإنسان في حال السفر","أخلاقه زيادة على الحضر",113,"ر",1,0],["ولي حبيب اراني من محاسنه","مالوا تأملها الأعمى لأبصرها",114,"ر",3,0],["ولي حال يذبّ عني","ان قلت سيف فقد حماني",115,"ن",2,0],["وليحمها ذود البنين أولي النهى","من غيلة الاطماع والاشرار",116,"ر",1,0],["ولي حزنان حزن لي عليه","وحزن قد قصدت به قصيدي",117,"د",2,0],["وَلّى حَثيثاً وَهَذا الشَيبُ يَطلُبُهُ","لَو كانَ يُدرِكُهُ رَكضُ اليَعاقيبِ",118,"ب",1,0],["ولي حبيب قوله فائق","شعري ويسمو وجده وجدي",119,"د",2,1],["ولي حبيب لطبع الورد منتسب","حتى النسيم إذا ما مرَّ يقلقه",120,"ق",2,1],["ولي حبيبٌ حال به عجبُ","قف واستمع شرح قصى وانظر",121,"ر",1,1],["ولي حبيب وجهه كسامه","وفعله يشبه هذين",122,"ن",1,1],["وَلي حُب قَديم غَير طار","وَقَلب في نَواحي الشَوق طائر",123,"ر",1,0],["ولي حاجة عنده للجوى","وليس له غير ذلي شفيع",124,"ع",1,0],["ولى حكيم العرب وارتحل الحجا","فالحكمة استعصى علينا بابها",125,"ب