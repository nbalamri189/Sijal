{"poems":[[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[63,"ومتشح باللؤم جاذبني العلا","https://www.aldiwan.net/poem45935.html","الطويل"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[3,"لقد وجدنا زبيداَ غير صابرة","https://www.aldiwan.net/poem177.html",""],[71,"ولي حاجة في جنب جودك سهلة","https://www.aldiwan.net/poem3972.html","الطويل"],[93,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[93,"طوقتموني بأطواق من المنن","https://www.aldiwan.net/poem9166.html","البسيط"],[93,"هل في علاقة مصر بالسودان","https://www.aldiwan.net/poem11185.html","الكامل"],[93,"طوقتموني بأطواق من المنن","https://www.aldiwan.net/poem11234.html","البسيط"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[93,"مريم يا غرس خير كرم","https://www.aldiwan.net/poem11311.html","مخلع البسيط"],[88,"أما وقد طلع الرجاء","https://www.aldiwan.net/poem44794.html","مجزوء الكامل"],[72,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"أقاسم يا من لم يزل ذا نقيبة","https://www.aldiwan.net/poem65863.html","الطويل"],[51,"قصيدة كرها مثقفها","https://www.aldiwan.net/poem65913.html","المنسرح"],[70,"ويحك يا قلب أما قلت لك","https://www.aldiwan.net/poem42777.html","السريع"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[45,"جعلت فداءك من كل سوء","https://www.aldiwan.net/poem63552.html","المتقارب"],[45,"تريك الذي حدثت عنه من السحر","https://www.aldiwan.net/poem63612.html","الطويل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[49,"بليت بنفسي شر نفس رأيتها","https://www.aldiwan.net/poem62015.html","الطويل"],[69,"بأيمن جرعاء الكثيب خيام","https://www.aldiwan.net/poem28765.html","الطويل"],[48,"أبا العباس ما ظني بشكري","https://www.aldiwan.net/poem65256.html","الوافر"],[50,"أعاتك بعض الود مر ممزج","https://www.aldiwan.net/poem63986.html","الطويل"],[46,"الدهر يزبق من حواه كأنهم","https://www.aldiwan.net/poem23024.html","الكامل"],[46,"خلو فؤادي بالمودة إخلال","https://www.aldiwan.net/poem23632.html","الطويل"],[76,"قصد المنون له فمات فقيدا","https://www.aldiwan.net/poem39456.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30509","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30505","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54899","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[45,"تُرِيكَ الذي حُدّثتَ عَنهُ منَ السِّحْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31341",""],[51,"يا أبا أحمدٍ ومثلُك لا يَغْ فَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=27822",""],[116,"بلهفة الغرام","https://www.aldiwan.net/poem40481.html","عموديه"],[116,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[116,"يا نازلين بوادي الأرقين لكم","https://www.aldiwan.net/poem41495.html","البسيط"],[125,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[129,"لك الفضل يا مولاى والحمد والشكر","https://www.aldiwan.net/poem50607.html","الطويل"],[144,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[151,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[167,"أقول له ولم أنفس بنفسي","https://www.aldiwan.net/poem47022.html","الوافر"],[186,"عليك ثناء العالمين فصيح","https://www.aldiwan.net/poem14142.html","الطويل"],[187,"بدأت بالفضل في شعر ضرائبه","https://www.aldiwan.net/poem43298.html","البسيط"],[187,"الحمد لله وشكرا له","https://www.aldiwan.net/poem43783.html","السريع"],[200,"أبيت وجنبي ليس يحويه مضجع","https://www.aldiwan.net/poem45232.html","الطويل"],[205,"وعذب المقبل والمبتسم","https://www.aldiwan.net/poem53184.html","المتقارب"],[213,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[224,"ألدمع من عيني لم يذرف","https://www.aldiwan.net/poem41626.html","السريع"],[236,"خليفة الله أنت في الدين وال","https://www.aldiwan.net/poem31824.html","المنسرح"],[258,"مغنى خصيب وباب مرتج أبداً","https://www.aldiwan.net/poem2683.html","البسيط"],[281,"أترى الهلال أنار ضوء جبينه","https://www.aldiwan.net/poem60770.html","الكامل"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[305,"سلام سلام كمسك الختام","https://www.aldiwan.net/poem16782.html","المتقارب"],[349,"ولي حمار قطعتي في الدرى","https://www.aldiwan.net/poem20261.html","السريع"],[350,"بي للورى فليطل العجب","https://www.aldiwan.net/poem15535.html","السريع"],[365,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[365,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[367,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[367,"وتأخيرها مني على عزم جوده","https://www.aldiwan.net/poem17322.html","الطويل"],[378,"ولي حظ من الدنيا شقي","https://www.aldiwan.net/poem59443.html","الوافر"],[392,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[392,"وليس للمرء بعد الموت من شجر","https://www.aldiwan.net/poem54444.html","عموديه"],[392,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[404,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[404,"له الحمد حمدا لا يلم به الحصر","https://www.aldiwan.net/poem33919.html","الطويل"],[417,"تلفت في منازل آل مي","https://www.aldiwan.net/poem53835.html","الوافر"],[417,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[433,"أكوكب بشر من جبينك لائح","https://www.aldiwan.net/poem12578.html","الطويل"],[433,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[438,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[516,"ولي حرمة الضيف الغريب وحرمة","https://www.aldiwan.net/poem12270.html","الطويل"],[539,"ولي حكم عدل سميع ومبصر","https://www.aldiwan.net/poem47501.html","عموديه"],[552,"عصيتك والأنفاس مني هواجر","https://www.aldiwan.net/poem47876.html","الطويل"],[564,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"],[576,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"]],"verses":[["وَلي حَثُّ الرُكابِ وَشَدُّ رَحلي","وَما لي عِلمُ غامِضَةِ الغُيوبِ",0,"ب",1,0],["وَلي حَقٌّ عَلَيكَ فَذاكَ جِدّي","قَديمٌ في رِضاكَ وَذا ثَنائي",1,"ا",2,0],["وَلي حَسَبٌ يَسْتَوْعِبُ الأَرْضَ ذِكْرُهُ","على العُدْمُ وَالأَحْسابُ يَدْفِنُها الفَقْرُ",2,"ر",1,0],["ولي حَنينٌ لمْ تَسَعْهُ أضْلُعي","إِلى اللّوى يُذكي تَباريحَ الجَوى",3,"ا",1,0],["وَلي حُسامٌ إِذا ما سُلَّ في رَهَجٍ","يَشُقُّ هامَ الأَعادي حينَ يُمتَشَقُ",4,"ق",1,0],["وَلي حاجَةٌ في جَنبِ جودِكَ سَهلَةٌ","وَلكِنَّها عِندي تجلُّ وَتَعظُمُ",5,"م",1,1],["وليحقق بصادق العون من أم","مته رأيه الشريف العالي",6,"ل",2,0],["وليحفظ اللَه أبناء الكنانة في","يمن وأمن من الأحداث والمحن",7,"ن",1,0],["وليحيى من صان مجد الضاد من ملك","ومن رئيس عليه اليوم مؤتمن",7,"ن",1,0],["وَليَحْيَا فَارُوقُ المَلِيكُ المُفْتَدَى","وَيَعِزُّ تَحْتَ لِوائِهِ القُطْراَنِ",8,"ن",1,0],["وَلْيَحْيَ مَنْ صَانَ الضَّادَ مِنْ مَلِكٍ","وَمِنْ رَئِيسٍ عَلَيْهِ مُؤْتَمِنِ",9,"ن",1,0],["وَلْيَحْيَ أَهْلُوكَ الْكِرَامُ وَيَغْنَمُوا","مِنْ طَيِّبَاتِ الْعَيْشِ أَوْفَى مَغْنَمِ",10,"م",1,0],["وَلْيَحْيَ فِي غِبْطَةٍ وَجَاهٍ","عَرُوسُكِ المَاجِدُ الهُمَامُ",11,"م",1,0],["وليحى مولانا النقيب","حياة مولانا الأمير",12,"ر",1,0],["ولي حالتا دنيا وأخرى أراهما","يمرَّان بي في عيشةٍ تتمرَّر",13,"ر",1,0],["وليحاذر أُحْدُوثَةَ السُّوء لا من","نِيَ لكن من أهل حَضْرٍ ومَبْدى",14,"د",2,0],["وليحذر الشاعر العرِّيض بادرتي","فربما صادف العريض حذّافا",15,"ف",2,0],["ولي حاجةٌ في أن تُنيل وأن ترى","مكاني بلا منٍّ مكان مَنيلِ",16,"ل",1,0],["وليحتمل عبدَه الأميرُ وإن","ثقَّلَ تثقيلَ غيرِ محتملِ",17,"ل",1,0],["وَلي حَبيبٌ لَم يَدَع مَسلَكاً","يُشمِتُ بي الأَعداءَ إِلّا سَلَك",18,"ك",1,0],["وَلي حاجَةٌ مِن وَصلِهِ غَيرَ أَنَّها","مُرَدَّدَةٌ بَينَ الصَبابَةِ وَالتُقى",19,"ق",2,0],["وَلي حُرمَةٌ حَقُّها واجِبٌ","بِعَمّي حُمَيدِ بنُ عَبدِ الحَميدِ",20,"د",1,0],["وَلي حَجَةٌ لَم آلَ فيها وَسيلَةً","إِلى القَمَرِ الوَضّاحِ وَالصَيِّدِ الغَمرِ",21,"ر",1,0],["وَلْيَحْذَرِ الكّذابُ تِربُكُما يداً","باتتْ تَحِنُّ إلى طَلَى الكذَّابِ",22,"ب",1,0],["وَلي حِيَلٌ عِندَ المَطامِعِ رُبَّما","تَلَطَّفتُ لِلدُنيا بِها فَرَقَيتُها",23,"ت",3,0],["ولي حالةٌ في العاشقينَ عجيبةٌ","فؤادي ضرامٌ والدموعُ سجامُ",24,"م",1,0],["وَلي حُرَمٌ فَلا تَنتَطَّ عَنها","فَتَدفَعَ حَقَّها دَفعَ الغَريمِ",25,"م",1,0],["وَلي حاجَةٌ لا تَدَّريها بِحُجَّةٍ","إِلى مَلِكٍ يَجلو الدُجى حينَ يَخرُجُ",26,"ج",1,0],["وَلِيَحذَر الدَعوى اللَبيبُ فَإِنَّها","لِلفَضلِ مَهلَكَةٌ وَخَطبٌ موبَقُ",27,"ق",1,0],["ولي حاجةٌ عنْد المنيّةِ فَتْكُها","برُوحيَ والأهواءُ مُذْ كُنّ أهْوالُ",28,"ل",1,0],["وَلّى حَفيظاً في الأَذمَّةِ حَافِظاً","وَمضى وَدوداً في الوَرَى مَوْدودا",29,"د",2,0],["ولي حاجَةٌ عندَ العِراقِ وأهْلِهِ","فإنْ تَقْضِياها فالجزاءُ هوَ الشّرْط",30,"ط",1,0],["ولي حرمةٌ حاشا لِمِثلك أن يُرى","مضيعاً لها وهو الغداة شهيدُ",31,"د",1,0],["ولِي حُقُوقٌ في الحُبِّ ظاهِرةٌ","لَكِنَّ إِلْفِي يَعُدُّها دَعْوَى",32,"و",2,0],["وَلْيَحْيَا هَذَا الاتِّحَ","ادُ زَاهِراً وَلْيَدُمِ",33,"م",1,0],["وَلْيَحْمِيَ رَهْطٌ فِي فريدِ العُلى","يَحْكِيكَ مِنْ إِخْوَتِكَ الزَّهْرِ",34,"ر",1,0],["وَلْيَحْيَا سَامِي نَاعِماً","بِحَظِّهِ المُكْتَمِلِ",35,"ل",1,0],["وَلْيَحْيَا فَارُوقُ وَادِي النِّيلِ مُرْتَقِياً","إِلى ذُرَى الْمَجْدِ فِي عِزٍّ وتَأْيِيدِ",36,"د",1,0],["وَلي حاجَةٌ لمْ آلُ فيهَا وَسِيلَةً","إلى القَمَرِ الوَضّاحِ، وَالسّيّدِ الغَمْرِ",37,"ر",1,0],["وليحاذر أُحْدُوثَة َ السُّوء لا","مِنِّي لكل من أهل حَضْرٍ ومَبْدى",38,"د",2,0],["ولي حبيب قلب","اكثر لي سقامي",39,"م",2,0],["وليحزن الركبان صوت تاوهي","ولتطربن مما ابث النوق",40,"ق",1,0],["ولي حديث قديم في محبتكم","بجامع الملأ الأعلى الرفيع روى",41,"ر",3,0],["وليحي لدجر والكوتا وطغمتها","في ظل دوح من اللذات فينان",42,"ن",1,0],["ولى حاجةٌ أخرى لديكِ قضاؤها","فلا ينبغى زيدٌ يليها ولا عمرُو",43,"ر",2,0],["وَليَحذَروا الهِمَمَ الَّتي مَنَعَتهُمُ","مِن أَن يُقيموا بِالشَآمِ عَمودا",44,"د",2,0],["وَلي حيبَةٌ في يَثرِبٍ أَيُّ حيبَةٍ","أَأُمنحُها مِن بَعدِ مَنعٍ وَخَيبَةٍ",45,"ه",1,0],["ولي حَشَفٌ وبي تَطْفيفُ كيلٍ","وها حَشَفي مَعَ الكَيلِ الطّفيفِ",46,"ف",1,0],["ولي حاجةٌ يَرْضَى بها اللهُ أولا","وفيها ثناءٌ شائعٌ ومديح",47,"ح",1,0],["ولي حديث سأبديه وإن فصرت","يراعتي عن مطاماتي من الألم",48,"م",1,0],["ولي حديث شاب رأسي له","هجوم كر الليل والفحر",49,"ر",1,0],["ولي حاجةٌ في السهدِ والسهدُ قاتلي","بدمعي وبعضُ الموتِ في الماءِ ينقعُ",50,"ع",1,0],["ولي حاجة لم أُطِق بَثَّها","حياءً وقد أخذت بالكَظَم",51,"م",1,0],["ولي حاسدٌ أضحى يلوكُ لُعابَه","عليّ ويهوى الفعلَ ما أنا فَاعِلُ",52,"ل",1,0],["وَلي حَياةٌ حَظُّها أَسوَدٌ","نَظير لَيلى المُظلمِ المسدفِ",53,"ف",1,0],["وَلي حَديثٌ يُلهي وَيُعجِبُ مَن","يوسِعُ لي خُلقَهُ فَيَتَّسِعُ",54,"ع",1,0],["وَلي حَبيبٌ مَليحُ الدلِّ ذو غَنَجٍ","حُلو الشَمائِلِ ما في لَثمِهِ باسِ",55,"س",1,0],["وَلْيَحْظَ رَبْعُ الْمَكْرُماتِ بِأَنْ غَدا","شَرِقَ الْمَنازِلَ آهِلاً بِقَطِينِهِ",56,"ن",2,0],["وَليحمَد اللَه على","بلائِه بما اِبتَلى",57,"ل",2,0],["ولي حسن ظن به قربي","بربي وحسبي به يا غلام",58,"م",1,0],["ولي حِمارٌ قِطْعتي في الدّرَى","قَدْ أَشْبَهتْ قِطعتُهُ في الحَمِيرْ",59,"ر",1,1],["وَلي حَديثٌ عَن قَديمِ الهَوى","قُشورُهُ عِندَ النَهدى لَبُّ",60,"ب",1,0],["ولي حَجَّةٌ مرَّتْ وتَمَّ خِتامُها","بذي حَجّةٍ والدَّهْرُ بالنّاسِ يَوْمان",61,"ن",1,0],["ولي حاجةٌ عنْد الزَّمانِ لِذكْرِه","لها الدَّهْرَ أَشْعاري عليهِ رَتائم",62,"م",1,0],["وَلي حاسِدٌ أَنتَ أَربَحتَهُ","وَأَنتَ تُصَيِّرُهُ خاسِرا",63,"ر",2,0],["وَلي حاجَةٌ في راتِبٍ قَد سَبَقتُهُم","إِلَيهِ وَما بِالسَبقِ يُلتَمَسُ الرِزق",64,"ق",1,0],["ولي حظٌّ من الدنيا شقيٌّ","ولكن حظها مني سعيدُ",65,"د",1,1],["وليحسن الظن بذي الإحسان","ذي الفضل والجود عظيم الشان",66,"ن",1,0],["ولي حوائج أجناسا منوعة","أسألك ياقاضي الحاجات تقضيها",67,"ي",3,0],["وليحمدالله ربه من بفضله حباه","هذا مقالي وماقولي كقول النحاه",68,"ا",2,0],["وليحترس من نار ذهن له","فإنني أخشى بأن يحرقا",69,"ق",2,0],["ولي حسن ظن لا يخيب فكم وكم","حَبانيَ فضلاً عنه قد عجز الحصر",70,"ر",1,0],["ولي حتَّى أرى الأحبابَ فيها","على الأيام طول الدهر عتب",71,"ب",1,0],["ولي حسرة ما تنقضي وتلهُّفُ","ومن مرسِلاتِ الدَّمع فذٌّ وتوْأَمُ",72,"م",1,0],["ولي حاجةٌ حلّتْ وضامنُ نُجْحِها","لقلبي برقٌ من مُحيّاكَ لامِحُ",73,"ح",1,0],["ولي حاجةٌ في ضميرِ العُلا","وأنت أبو سرّها المُضْمَرِ",74,"ر",1,0],["ولي حميدا فالمدامع بعدهُ","والشقو في التصبيب والتصعيد",75,"د",1,0],["ولي حرمة الضيف الغريب وحرمة","جنيت بها من وجودكم ثمر العلم",76,"م",1,1],["وَلي حَكَمٌ عَدلٌ سميعٌ ومُبصرُ","عليمٌ بما في النفسِ مِن سِرٍّ أو نَجوَى",77,"ج",3,1],["ولي حاجةٌ عند الأسنّةِ والظُّبا","تَهُمُّ بها نفسِي فأين المساعدُ",78,"د",1,0],["وَلِيٌّ حَفِيٌّ بِالمُريدِ فِعِذقُهُ","بِجَنَّتِهِ وَالداءُ أَدوَأُ نابِضُ",79,"ض",1,0],["ولي حَاجَةٌ قَدْ كَادَ يَحضُر وَقْتُها","وأَسْأَلُ في إِنجازِها مِنْك لي وَعْدا",80,"د",2,0]]}