ate.com/ViewPoem.aspx?id=46292",""],[5781,"أغرقتني بالحبِّ فذَبُلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87233&r=&rc=0",""],[6351,"جواب يفتش عن سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86046&r=&rc=6",""]],"verses":[["وَلي حَثُّ الرُكابِ وَشَدُّ رَحلي","وَما لي عِلمُ غامِضَةِ الغُيوبِ",0,"ب",1,0],["وَلي حَقٌّ عَلَيكَ فَذاكَ جِدّي","قَديمٌ في رِضاكَ وَذا ثَنائي",1,"ا",2,0],["وَلي حَسَبٌ يَسْتَوْعِبُ الأَرْضَ ذِكْرُهُ","على العُدْمُ وَالأَحْسابُ يَدْفِنُها الفَقْرُ",2,"ر",1,0],["ولي حَنينٌ لمْ تَسَعْهُ أضْلُعي","إِلى اللّوى يُذكي تَباريحَ الجَوى",3,"ا",1,0],["وَلي حُسامٌ إِذا ما سُلَّ في رَهَجٍ","يَشُقُّ هامَ الأَعادي حينَ يُمتَشَقُ",4,"ق",1,0],["وَلي حاجَةٌ في جَنبِ جودِكَ سَهلَةٌ","وَلكِنَّها عِندي تجلُّ وَتَعظُمُ",5,"م",1,1],["وليحقق بصادق العون من أم","مته رأيه الشريف العالي",6,"ل",2,0],["وليحفظ اللَه أبناء الكنانة في","يمن وأمن من الأحداث والمحن",7,"ن",1,0],["وليحيى من صان مجد الضاد من ملك","ومن رئيس عليه اليوم مؤتمن",7,"ن",1,0],["وَليَحْيَا فَارُوقُ المَلِيكُ المُفْتَدَى","وَيَعِزُّ تَحْتَ لِوائِهِ القُطْراَنِ",8,"ن",1,0],["وَلْيَحْيَ مَنْ صَانَ الضَّادَ مِنْ مَلِكٍ","وَمِنْ رَئِيسٍ عَلَيْهِ مُؤْتَمِنِ",9,"ن",1,0],["وَلْيَحْيَ أَهْلُوكَ الْكِرَامُ وَيَغْنَمُوا","مِنْ طَيِّبَاتِ الْعَيْشِ أَوْفَى مَغْنَمِ",10,"م",1,0],["وَلْيَحْيَ فِي غِبْطَةٍ وَجَاهٍ","عَرُوسُكِ المَاجِدُ الهُمَامُ",11,"م",1,0],["وليحى مولانا النقيب","حياة مولانا الأمير",12,"ر",1,0],["ولي حالتا دنيا وأخرى أراهما","يمرَّان بي في عيشةٍ تتمرَّر",13,"ر",1,0],["وليحاذر أُحْدُوثَةَ السُّوء لا من","نِيَ لكن من أهل حَضْرٍ ومَبْدى",14,"د",2,0],["وليحذر الشاعر العرِّيض بادرتي","فربما صادف العريض حذّافا",15,"ف",2,0],["ولي حاجةٌ في أن تُنيل وأن ترى","مكاني بلا منٍّ مكان مَنيلِ",16,"ل",1,0],["وليحتمل عبدَه الأميرُ وإن","ثقَّلَ تثقيلَ غيرِ محتملِ",17,"ل",1,0],["وَلي حَبيبٌ لَم يَدَع مَسلَكاً","يُشمِتُ بي الأَعداءَ إِلّا سَلَك",18,"ك",1,0],["وَلي حاجَةٌ مِن وَصلِهِ غَيرَ أَنَّها","مُرَدَّدَةٌ بَينَ الصَبابَةِ وَالتُقى",19,"ق",2,0],["وَلي حُرمَةٌ حَقُّها واجِبٌ","بِعَمّي حُمَيدِ بنُ عَبدِ الحَميدِ",20,"د",1,0],["وَلي حَجَةٌ لَم آلَ فيها وَسيلَةً","إِلى القَمَرِ الوَضّاحِ وَالصَيِّدِ الغَمرِ",21,"ر",1,0],["وَلْيَحْذَرِ الكّذابُ تِربُكُما يداً","باتتْ تَحِنُّ إلى طَلَى الكذَّابِ",22,"ب",1,0],["وَلي حِيَلٌ عِندَ المَطامِعِ رُبَّما","تَلَطَّفتُ لِلدُنيا بِها فَرَقَيتُها",23,"ت",3,0],["ولي حالةٌ في العاشقينَ عجيبةٌ","فؤادي ضرامٌ والدموعُ سجامُ",24,"م",1,0],["وَلي حُرَمٌ فَلا تَنتَطَّ عَنها","فَتَدفَعَ حَقَّها دَفعَ الغَريمِ",25,"م",1,0],["وَلي حاجَةٌ لا تَدَّريها بِحُجَّةٍ","إِلى مَلِكٍ يَجلو الدُجى حينَ يَخرُجُ",26,"ج",1,0],["وَلِيَحذَر الدَعوى اللَبيبُ فَإِنَّها","لِلفَضلِ مَهلَكَةٌ وَخَطبٌ موبَقُ",27,"ق",1,0],["ولي حاجةٌ عنْد المنيّةِ فَتْكُها","برُوحيَ والأهواءُ مُذْ كُنّ أهْوالُ",28,"ل",1,0],["وَلّى حَفيظاً في الأَذمَّةِ حَافِظاً","وَمضى وَدوداً في الوَرَى مَوْدودا",29,"د",2,0],["ولي حاجَةٌ عندَ العِراقِ وأهْلِهِ","فإنْ تَقْضِياها فالجزاءُ هوَ الشّرْط",30,"ط",1,0],["ولي حرمةٌ حاشا لِمِثلك أن يُرى","مضيعاً لها وهو الغداة شهيدُ",31,"د",1,0],["ولِي حُقُوقٌ في الحُبِّ ظاهِرةٌ","لَكِنَّ إِلْفِي يَعُدُّها دَعْوَى",32,"و",2,0],["وَلْيَحْيَا هَذَا الاتِّحَ","ادُ زَاهِراً وَلْيَدُمِ",33,"م",1,0],["وَلْيَحْمِيَ رَهْطٌ فِي فريدِ العُلى","يَحْكِيكَ مِنْ إِخْوَتِكَ الزَّهْرِ",34,"ر",1,0],["وَلْيَحْيَا سَامِي نَاعِماً","بِحَظِّهِ المُكْتَمِلِ",35,"ل",1,0],["وَلْيَحْيَا فَارُوقُ وَادِي النِّيلِ مُرْتَقِياً","إِلى ذُرَى الْمَجْدِ فِي عِزٍّ وتَأْيِيدِ",36,"د",1,0],["وَلي حاجَةٌ لمْ آلُ فيهَا وَسِيلَةً","إلى القَمَرِ الوَضّاحِ، وَالسّيّدِ الغَمْرِ",37,"ر",1,0],["وليحاذر أُحْدُوثَة َ السُّوء لا","مِنِّي لكل من أهل حَضْرٍ ومَبْدى",38,"د",2,0],["ولي حبيب قلب","اكثر لي سقامي",39,"م",2,0],["وليحزن الركبان صوت تاوهي","ولتطربن مما ابث النوق",40,"ق",1,0],["ولي حديث قديم في محبتكم","بجامع الملأ الأعلى الرفيع روى",41,"ر",3,0],["وليحي لدجر والكوتا وطغمتها","في ظل دوح من اللذات فينان",42,"ن",1,0],["ولى حاجةٌ أخرى لديكِ قضاؤها","فلا ينبغى زيدٌ يليها ولا عمرُو",43,"ر",2,0],["وَليَحذَروا الهِمَمَ الَّتي مَنَعَتهُمُ","مِن أَن يُقيموا بِالشَآمِ عَمودا",44,"د",2,0],["وَلي حيبَةٌ في يَثرِبٍ أَيُّ حيبَةٍ","أَأُمنحُها مِن بَعدِ مَنعٍ وَخَيبَةٍ",45,"ه",1,0],["ولي حَشَفٌ وبي تَطْفيفُ كيلٍ","وها حَشَفي مَعَ الكَيلِ الطّفيفِ",46,"ف",1,0],["ولي حاجةٌ يَرْضَى بها اللهُ أولا","وفيها ثناءٌ شائعٌ ومديح",47,"ح",1,0],["ولي حديث سأبديه وإن فصرت","يراعتي عن مطاماتي من الألم",48,"م",1,0],["ولي حديث شاب رأسي له","هجوم كر الليل والفحر",49,"ر",1,0],["ولي حاجةٌ في السهدِ والسهدُ قاتلي","بدمعي وبعضُ الموتِ في الماءِ ينقعُ",50,"ع",1,0],["ولي حاجة لم أُطِق بَثَّها","حياءً وقد أخذت بالكَظَم",51,"م",1,0],["ولي حاسدٌ أضحى يلوكُ لُعابَه","عليّ ويهوى الفعلَ ما أنا فَاعِلُ",52,"ل",1,0],["وَلي حَياةٌ حَظُّها أَسوَدٌ","نَظير لَيلى المُظلمِ المسدفِ",53,"ف",1,0],["وَلي حَديثٌ يُلهي وَيُعجِبُ مَن","يوسِعُ لي خُلقَهُ فَيَتَّسِعُ",54,"ع",1,0],["وَلي حَبيبٌ مَليحُ الدلِّ ذو غَنَجٍ","حُلو الشَمائِلِ ما في لَثمِهِ باسِ",55,"س",1,0],["وَلْيَحْظَ رَبْعُ الْمَكْرُماتِ بِأَنْ غَدا","شَرِقَ الْمَنازِلَ آهِلاً بِقَطِينِهِ",56,"ن",2,0],["وَليحمَد اللَه على","بلائِه بما اِبتَلى",57,"ل",2,0],["ولي حسن ظن به قربي","بربي وحسبي به يا غلام",58,"م",1,0],["ولي حِمارٌ قِطْعتي في الدّرَى","قَدْ أَشْبَهتْ قِطعتُهُ في الحَمِيرْ",59,"ر",1,1],["وَلي حَديثٌ عَن قَديمِ الهَوى","قُشورُهُ عِندَ النَهدى لَبُّ",60,"ب",1,0],["ولي حَجَّةٌ مرَّتْ وتَمَّ خِتامُها","بذي حَجّةٍ والدَّهْرُ بالنّاسِ يَوْمان",61,"ن",1,0],["ولي حاجةٌ عنْد الزَّمانِ لِذكْرِه","لها الدَّهْرَ أَشْعاري عليهِ رَتائم",62,"م",1,0],["وَلي حاسِدٌ أَنتَ أَربَحتَهُ","وَأَنتَ تُصَيِّرُهُ خاسِرا",63,"ر",2,0],["وَلي حاجَةٌ في راتِبٍ قَد سَبَقتُهُم","إِلَيهِ وَما بِالسَبقِ يُلتَمَسُ الرِزق",64,"ق",1,0],["ولي حظٌّ من الدنيا شقيٌّ","ولكن حظها مني سعيدُ",65,"د",1,1],["وليحسن الظن بذي الإحسان","ذي الفضل والجود عظيم الشان",66,"ن",1,0],["ولي حوائج أجناسا منوعة","أسألك ياقاضي الحاجات تقضيها",67,"ي",3,0],["وليحمدالله ربه من بفضله حباه","هذا مقالي وماقولي كقول النحاه",68,"ا",2,0],["وليحترس من نار ذهن له","فإنني أخشى بأن يحرقا",69,"ق",2,0],["ولي حسن ظن لا يخيب فكم وكم","حَبانيَ فضلاً عنه قد عجز الحصر",70,"ر",1,0],["ولي حتَّى أرى الأحبابَ فيها","على الأيا