 أحذر ال","بطالة عندي أن ترسخا",151,"خ",2,0],["ولي حرفُ شعرٍ لا يضاهى وشاهدٌ","عدوي بإلهامي ورفعة موضعي",152,"ع",2,0],["ولي حنين سما في كل آونة","لخير من جاء بالتبيان والحكم",153,"م",1,0],["ولِي حاجةٌ في النَّفسِ أَنَّى أَمَرتُها","نَهَتْنِي.. وأَنهاها صِراعٌ ومَصرَعٌ",154,"ع",1,0],["ولِي حِينَ يَأبَى جَنُوبيْ شِمَالِي","جهاتٌ جِيَاعٌ, ورِيحٌ تَصِرُّ",155,"ر",1,0],["ولِي حِينَ يَأبَى جَنُوبيْ شِمَالِي","دِلَاءٌ عِطاشٌ, ورِيحٌ تَصِرُّ",156,"ر",1,0],["وَلَّى \"حِزَامُ الجُوع\"ِ عَن جَسَدِي","ولَبِسْتُ \"بارُودًا وفُولاذا\"",157,"ذ",2,0],["وليحرقنَّ لهيبُه أجسادَهم","بئس الجزاء لخائنٍ متوغد",158,"د",1,0],["وليحملنْك إلى الذي حملتْ","منه البواسلَ في الوغى زندُ",159,"د",1,0],["وليحي كلّ فتى حرٍّ يؤّيد من","يعلو به الخلق السّامي ليعليك",160,"ك",1,0],["ولي حق على العليا مبين","وإن لم توف بالحق المبينِ",161,"ن",1,0],["ولي حنة في كل وقت إليكم","ولا حنة الصادي إلى البارد العذب",162,"ب",1,0],["وليحيَ من حيَّ في عزٍّ وفي شرفٍ","ومن يَمُت كان عندَ اللهِ مُحتَسَبَا",163,"ب",2,0],["ولي حكْمُ بغْدادٍ وروعَةُ موصلٍ","وآبارُ كركوكٍ وصوتُ المساجدِ",164,"د",1,0],["ولي حسْنُ أرْبيلٍ وثرْوةُ بصْرةٍ","وباديةُ الْأنْبارِ فخْرُ الموائدِ",164,"د",1,0],["وليْ حاءُ حبٍّ وباءُ ابتعادٍ","فيكوي فؤاديَ حرفايَ كيّا",165,"ي",2,0],["ولي حرمٌ أعددته لعبادتي","فصلوا ورا محراب حسني واركعوا",166,"ع",3,0],["وليحيى قيسك قيس الرأي تحفظه","عين الكريم وحبل الوصل موصول",167,"ل",1,0],["وليحذر الشعراء مدحا أو هجا","فبذلكم ذموا على قرآنه",168,"ن",2,0],["وليحي العرب وهم أبداً","أقطاب العز ومحتده",169,"د",2,0],["ولي حكمة ضاعت وما ضعت إنما","تعثرت في ضعفي وخار المحارب",170,"ب",1,0],["ولي حيث ما ألقى الكرام مجالسٌ","وماعشتُ كي أرضى الهوان وألبسا",171,"س",2,0],["وَلِي حُزْنُ يَعْقوبٍ وَوَحْشَةُ يُونُسٍ","وآلاَمِ أَيُّوبٍ ، وحَسْرةُ آدَمِ",172,"م",1,0],["ولّي حياةٍ جابت الذل ولّي","لابو حياةٍ صرت فيها تسلى",173,"ل",2,0],["وَلِي حِمْيَرٌ مِنْ جَمِيعِ المُلُو","كِ فِي ظُلُماتِ الخُطُوبِ اقْتِباسُ",174,"س",1,0],["وليحفظ الله منكم كل جارحة","وكل فضل له فيكم نما ونما",175,"م",2,0],["ولي حماماتُ آيات معطرة","تذيب عني إذا رتّلتُها الحزنا",176,"ن",2,0],["وليحذر الناس معاداتهم","له وقد أعذر من أنذرا",177,"ر",2,0],["ولي حبيب بمناى الكرخ اعشقه","يذكي الفؤاد وذكرى الحب ماافلت",178,"ت",1,0],["ولي حبيبةُ قلبي كلما ابتسمتْ","أضاءت الكونَ عنها العينُ ما غفلتْ",179,"ت",1,0],["وليحي من صان مجد الضاد من ملك","ومن رئيس عليه اليوم مؤتمن",180,"ن",1,0],["وليحشه ثم ليصلى به","من بعد إسباغ من الطهر",181,"ر",1,0],["وليَحْسُ مُرَّ الضَّيْمِ ثاكِلُ نَاصِرٍ","فالمرءُ ما فَقَدَ النصيرَ مَضِيمُ",182,"م",1,0],["وَلي حُزْنُهُ المَرْمِيُّ عِنْدَ مَخادِعٍ","على شُرُفاتِ الرُّوحِ يَلفَحُ خافِقي",183,"ق",2,0],["ولي حلمٌ فظّ الملامح موحشٌ","فما لي إذا استيقظتُ لُمتُ مؤوِّلَه؟!",184,"ل",2,0]]}