,[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73632","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28620","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76738","الكامل"],[5046,"أردنّ فافخر..","https://www.poetsgate.com/ViewPoem.aspx?id=198202",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5582,"زُرْ مَنْزِلاً قاضَكَ البُرْحا وَأَوْلاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=63548",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5628,"البحث عن بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=191332",""],[6084,"حيت تزف سلافة الصهباء","https://www.poetsgate.com/ViewPoem.aspx?id=170811",""]],"verses":[["مَلِكٌ بَكاكِ فَطالَ بَعدَكِ حُزنُهُ","لَو يَستَطيعُ بِمُلكِهِ لَفَداكِ",0,"ك",1,0],["ملكٌ بأدنى سطوِه ونوَاله","أنسى ندى هرمٍ وبأسَ شبيب",1,"ب",1,0],["ملكٌ باهر المكارم يروي","وجهُ لقياهُ عن عطاءٍ وبشر",2,"ر",1,0],["ملك بادِرَةٌ بَدْرَتُهُ","حين لا تبدرُ منه بادره",3,"ر",2,0],["ملك بالسياستين خبير","وله فيهما الطريق السوى",4,"س",3,0],["مَلَك بأفق الرمل هلّ كريما","يدعو الجماد جماله ليهيما",5,"م",2,1],["مَلِكٌ بِمَفرَقِهِ إِذا اِستَقبَلتَهُ","تاجانِ تاجُ هُدىً وَتاجُ فَخارِ",6,"ر",1,0],["مُلكٌ بَناهُ أَهلُهُ","بِهِمَّةٍ وَمَجدَرَه",7,"ر",2,0],["مِلكٌ بِعالِيَةِ العِراقِ قِبابُهُ","يَقري البُدورَ بِها وَنَحنُ ضُيوفُهُ",8,"ف",2,0],["مَلِكٌ بَدا وَجَبينُهُ","شَمسُ الضُحى بَدرُ الظُلَم",9,"م",1,0],["مَلِكٌ بَنى لِلأَزدِ مَجداً عالِياً","بِالأَبيَضَينِ حُسامِهِ وَالدَرهَمِ",10,"م",1,0],["مَلِكٌ بِهِ قُصِمَ المُلوكُ وَعِندَهُ","عِلمُ الغُيوبِ وَوَقتُ كُلِّ حِمامِ",11,"م",1,0],["مَلكٌ بِهِ اِفتَخَرَت أَيّامُهُ شَرَفاً","وَاِستَبشَرَت بِمَعالي مَجدِهِ الرُتَبُ",12,"ب",1,0],["مَلِكٌ بِسيرَةِ عَدلِهِ وَسَماحِهِ","خَفِيَت مَآثِرُ دَولَةِ الخُلَفاءِ",13,"ا",2,0],["مَلِكٌ بِهِ اِكتَسَتِ الأَيّامُ ثَوبَ بَهاً","مِثلَ اِكتِساءِ غُصونِ البانِ بِالوَرَقِ",14,"ق",1,0],["مَلْكٌ به تُخْتَمُ أهْلُ العُلَى","إِذا بدا فَبِأَبيهِ افتِتاح",15,"ح",1,0],["مَلِكٌ بِهِ رَحِمُ النُّبُوءَةِ وَاشِجٌ","وَلَهُ جَلاَلُ الصِّيدِ فِي الخُلَفَاءِ",16,"ا",2,0],["مَلِكٌ بِهِ قِسْتُ المُلُوكَ فَلاَحَ لي","شَأْوُ الظَّلِيعِ بِهِمْ وَشَأْوُ الطَّالِعِ",17,"ع",1,0],["مُلكٌ بناه الترك في جبروتهم","وبنِيتهِ في رقة وفتور",18,"ر",1,0],["مُلْكٌ بناه أواليكم، ودعَّمَهُ","بالوحي أبناءُ مَرْوانٍ، ومرْوان",19,"ن",1,0],["مُلْكٌ بنَتْهُ بحدِّ السيفِ مُنْصلتًا","أيدي الأوائلِ من أَبناءِ مَرْوَانا",20,"ن",2,0],["ملك به الدنيا زهت وتهللت","بجمال طلعة ملكه أيامها",21,"م",3,0],["مُلْكٌ بدا ما به زيغٌ ولا خطلُ","رحب الفِنا خدنه المعروفُ والعملُ",22,"ل",1,1],["ملك بناه لك الإِله وشاده","وبنا المهيمن ثابت الأركان",23,"ن",1,0],["مَلِكٌ باهَت بِهِ الدُن","يا جَمالاً وَبَهاءا",24,"ا",3,0],["مَلِكٌ بَعيدٌ مِن الأَدناس ذو كَلَفٍ","بِالصِدق في القَول والاخلاص في العمل",25,"ل",1,0],["مَلِكٌ بِيُمْناه الخَلاصُ عَلى الوَرَى","أنْ يُخْلِصُوا الإسْرارَ والإعْلانا",26,"ن",2,0],["مَلْكٌ بأَقْصَى الكَمَالِ يُعْنَى","فَعَالَمُ القُدْسِ مِنهُ أَدْنَى",27,"ن",2,0],["مَلِكٌ بالقُرْبِ مِن سُدّتِه","يُحرزُ المَرْءُ العُلى والسؤْدَدا",28,"د",2,0],["مَلِكٌ بَل مَلَكٌ صيغَ مِنَ النو","رِ نُورِ العَرشِ لا الماءِ المَهين",29,"ن",1,0],["مَلْكٌ بَنَى غُرفَ العَلْيا وشيّدها","على دعائم عزٍّ ليسَ تَنْهَدِمُ",30,"م",1,0],["مُلْكٌ بهِ عِزُّ الشَّريعةِ مُظهَرُ","يُزْهَى به الدينُ الحنيفُ ويَفْخَرُ",31,"ر",1,1],["ملكِ بِشرُه يبشِّر راجيهِ","وَلِلغَيث قَبلَ يمطر بُشرى",32,"ر",2,0],["ملكٌ ببيْضِ ظُباته وهِباتِه","إنْ صالَ أو إن سالَ عفّى أو عَفا",33,"ف",2,0],["مَلِكٌ بَلَّ بِالدِّمَاءِ ثَرَى الأرضِ","فَمَا لِلجُيُوشِ فِيهَا غُبَارُ",34,"ر",1,1],["ملك به اكتست الليال بهجة","وبجوده راح الزمان مشنّفا",35,"ف",2,0],["مَلكِ بَرٌّ بمنْ يَسألُه","وهو بالمُذنب ذي الجُرم أبَرْ",36,"ر",1,0],["ملك بدايته نهاية معشر","يرقون تدريجاً إلى العلياء",37,"ا",2,0],["مَلِكٌ بِسَاحَتِهِ المَعالي خَيَّمَت","وَالمَجدُ فيها مُرسِلٌ لِعِنانِ",38,"ن",1,0],["مَلِكٌ بساحَتِهِ المَعالي خَيَّمَت","والمَجدُ فيها ذَيلُه مَجرورُ",39,"ر",1,0],["مَلِكٌ بالتُقَى تزوَّد مُذ شَب","ب وتَقوَى الإلهِ أعظمُ زادِ",40,"د",1,0],["مُلكُ بَني حمزةٍ ودولتُهم","ظِلُّ على المسلمين ممدود",41,"د",1,0],["ملك بحضرته صيد الملوك سمت","بغاية الفخر مذ عدت من الخدم",42,"م",1,0],["ملك بخلقك والندى المتوالي","وأبيك والجد الكبير العالي",43,"ل",2,1],["ملك بِهِ تُزهى الخَلافة وَالعلا","وَبِهِ تَجدّد في الرِياسة ما عَفا",44,"ف",2,0],["ملك باسط كفٍّ","شأنهُ جمعُ المفاخرْ",45,"ر",1,0],["مَلْكٌ به شيمُ الإِحسَان مجملةٌ","لكن يشنُّ على الدنيا مُفصَّلَها",46,"ل",3,0],["ملك بالعرض لا بال","عرض الفاني شحيحُ",47,"ح",1,0],["ملك بحسن الخلق مو","سوم وبالخلق الوسيمِ",48,"م",1,0],["ملك بما ملكت يداه من اللهى","ما زال يسعد آمليه ويسعف",49,"ف",1,0],["ملكٌ بِهِ روضُ الخِلاَفَة قَدْ زَهَا","إذْ هَزَّ مِنْ أقْلاَمِهِ الأفْنَانَا",50,"ن",2,0],["ملكٌ بالفضلِ قَد أَضحى لهُ","كلُّ ذي فهمٍ ونطقٍ معترف",51,"ف",1,0],["ملكٌ بهِ اِفتخرت بكر العلا وعلت","مِن حيث حازها عقداً وأملاكا",52,"ك",2,0],["مَلكٌ بشاشةُ وجههِ لوفودهِ","تهدي السرورَ إلى القلوب وتجلبُ",53,"ب",1,0],["ملكٌ باجماع المآثر والمفا","خر والعلا ما قط حاكاه بشرْ",54,"ر",1,0],["مَلْكٌ بَراهُ اللهُ ما بَيْنَ الوَرى","فَرْداً لِتَهْزَأَ أَرْضُهُ بِسَمائهِ",55,"ا",3,0],["مَلِكٌ بل مَلَكٌ أَوْطَأَهُ","همُّهُ هامةَ سَعْدِ الأسعْدِ",56,"د",1,0],["ملكُ بن ملكٍ أغر شب نأملُهُ","أخا ملوكِ يقيم العجمَ والعَرَبا",57,"ب",2,0],["مُلكٌ بَدا في صورة بَشَرية","تَعنو لَهِيبَتِهِ ذوو التِيجان",58,"ن",1,0],["مَلِكٌ بِنورِ جَبينِهِ","نَسري وَبَحرُ اللَيلِ طامِ",59,"م",1,1],["مَلِكٌ ببغدادٍ شدا تاريخهُ","وسناؤهُ فليحي غازي الأوّل",60,"ل",1,0],["ملكٌ بدعوته وجود يمينه","يحيا الرميم ويورق الصوّان",61,"ن",1,0],["ملك بِمَرْكَعِهِ الملائك تحدقُ","وبغيره مقل الملوك تحدِّق",62,"ق",1,0],["مُلك بنيتَ على المجرَّة صرحَه","فسما به عرش وعزَّ جناب",63,"ب",1,0],["مَلِكٌ باسِطُ اليَدَينِ إِلى الخَي","رِ صَفوحٌ عَنِ الذُنوبِ غَفورُ",64,"ر",1,0],["ملك بعرش الجمال باهى","بلقيس في عرشها المصرد",65,"د",1,0],["مَلِكٌ بَنى عِزّي وَأَسبَغَ نِعمَتي","وَأَجَلَّ مَنزِلَتي وَأَزهَفَ أَسهُمي",66,"م",2,0],["مَلِكٌ برَحبَةٍ مالِكٍ ذُو هِمَّةٍ","رَحُبَت فَضاقَ لِوُسعِها رَحبُ الفَضا",67,"ض",2,0],["مَلِكٌ بِرَحبَةِ مالِكٍ وَحَديثُهُ","في مُشرِقِ وَصِفاتُهُ في مَغرِبِ",68,"ب",1,0],["ملكٌ بهيبته أنافَ وعدلِهِ","كسرى المعظمَّ في الملوكِ وقيصرا",69,"ر",2,0],["ملكٌ بجوهرِ عدلِهِ وفخارِهِ","لبسَ النجومَ قلائداً جِيدَ الزمَنْ",70,"ن",1,0],["مَلْكٌ بكفيه وأَسْيَافِهِ","تُقْسَمُ آجالٌ وأرْزَاقُ",71,"ق",1,1],["ملك بروحي قد سرى ولو انه","حفظ الأمانة خلته جبريلا",72,"ل",2,0],["ملك به الدنيا غدت","تبدي سروراً وجذل",73,"ل",1,0],["ملك بشد الملك قام وما","حلت تمائمه ولا السخب",74,"ب",1,0],["ملك به أمنت قلوب معاشر","ريعت لوعكته بخطب نازل",75,"ل",1,0],["ملك ببيض هباته وظباته","إن جاد أحيا أو تنكر أصعقا",76,"ق",2,0],["ملك بني أيوب حلَّى العلا","بالمجد وهو التاج لِلمُعْرِق",77,"ق",1,0],["ملك به تفرح الرزايا","كما تجلى به الغمار",78,"ر",1,0],["ملك ببعض سعيه","حاز الفخار كلَّه",79,"ل",2,0],["ملك ببيض ظُباته وهباته","يجدي ويردي منعماً أو مصعقا",80,"ق",2,0],["ملك به قد غفرنا","للدهر سالف ذنبه",81,"ب",2,0],["مَلكٌ به حالَ دهري","بينَ الخُطوبِ وبَيني",82,"ن",2,0],["ملك بعدل الله يرعى شعبه","ابداً وفي عين الرضى يرعاك",83,"ك",1,0],["ملك باخلاص له في طاعتي","وافى زماني تائبا متنصلا",84,"ل",2,0],["ملك به شرف الزمان وأهله","وبه حوت مصر المقام الاسبقا",85,"ق",2,0],["ملك به اعتضد الإسلام وانتصرت","احرار ايران فالأسلام شاكره",86,"ر",2,0],["مُلْكُ بَني مُنقذٍ توَلَّى","وكان فوق السِّماكِ سَمْكُهْ",87,"ه",1,1],["ملكٌ بصيرٌ بأدواءِ الأمور له","رأيٌ نجيحٌ وطبُّ يُذهب الألما",88,"م",2,0],["ملكٌ بِهِ تزهو الحياةُ فأَنعِموا","أَهلَ الزمان وقَدِّموا الأَرواحا",89,"ح",2,0],["ملكٌ بِهِ طاب الزمانُ وأهله","وتَبسَّمت بسروره الأَعْصار",90,"ر",1,0],["ملك بكته أرائك وترائك","وملائك وممالك لا تحصر",91,"ر",1,0],["ملك بِالهَيبة مَظهَرَه","أَبَداً نَرجوه وَنحذره",92,"ه",1,0],["ملك به دار السلام تبخترت","لما رأته بالسعود تبخترا",93,"ر",2,0],["مَلِكٌ بملك جماله يتعزَّزُ","فلذاك يقتلُنا وَلا يتحرَّزُ",94,"ز",1,1],["ملك بنصب لواه يخفض كل ذي","رفع ويمنع جمعه أن يجمعا",95,"ع",2,0],["ملك بمشتجر القنا دحر العدو","القهقري عن حوض منصبه يذود",96,"د",1,0],["ملك بمقلته وقامته","متمنع بالبيض والسمر",97,"ر",1,0],["مَلِكٌ بِهِ اخْضَرَّ الزَّمانُ كأنَّما","أيَّامُ دَوْلَتِهِ رَبيعٌ ثانِ",98,"ن",1,0],["مَلِكٌ بَياضُ يَمينِهِ لِسَمِيِّهِ","مُوسى وَمَنْظَرُهُ البَديعُ لِيوسُفِ",99,"ف",1,0],["مَلِكٌ بِأَسْرارِ الْغُيوبِ مُكاشَفٌ","فَظُنونُهُ تُغْنيهِ عَنْ جِبْرِينِهِ",100,"ن",2,0],["ملك بطالعه السعود مدارة","ألقى الزمان إليه كل زمام",101,"م",1,0],["ملك بريك مع السماح شجاعة","ومن السماح شجاعة المستبسل",102,"ل",1,0],["ملكٌ بِمَولدهِ المسعود قَد سعدت","كُل الرَعايا وعمتها مَنافعهُ",103,"ع",2,0],["ملك بالحسن أضحى معجباً","وهو لا يحكم إلا في القلوب",104,"ب",1,0],["ملكٌ به عَرشُ الإِمامَةِ قد سَمَا","ورَسا وكانَ عَرَاهُ قبلُ تداعِ",105,"ع",1,0],["ملك بأشرف صورة بشرية","للجن والإنس استبان فافتنا",106,"ن",2,0],["مَلِكٌ بذكْرى مُنْجِبيهِ وذِكْرِهِ","يُسْتَفْتَحُ الذكرُ الجميلُ ويُبْتدا",107,"د",2,0],["مَلِك بَاهرُ الَمنَاقبِ للإِسِ","لام والمُسلمينَ كانَ مألا",108,"ل",2,0],["مَلكٌ بحُسنِ صنيعهِ أَنا واثِقٌ","وعلَى مواهبِ كفِّهش مُتوكِّلُ",109,"ل",1,0],["مَلِكٌ بَنَى بِالمُرهَفاتِ عَلاءهُ","أَفَتهدِمُ الأَيّامُ ما هُوَ بانِ",110,"ن",1,0],["ملكٌ بأَرضِ الرومِ أَنزَلَ نِقمَةً","وَأَبادَ مالاً أَهلُها يُحصُونَهُ",111,"ن",2,0],["ملك بفتح اللام جوهر هديه","من جوهر الشمس المنيرة أشرق",112,"ق",1,0],["ملِكٌ بهِ فخرَ الزَّمانُ على المدى","يهتزُّ عرشُ عَدُوِّهِ لوْ قَالَا",113,"ل",2,0],["ملك بدا ملء العيون مهابة","وسنا بنوريه الظلام المغسق",114,"ق",1,0],["مَلْكٌ بِهِ افْتَخَرَتْ بِكْرُ العُلا وَعَلَتْ","مِنْ حَيْثُ حازَ بِها عَقْداً وَأَمْلاكَا",115,"ك",2,0],["مَلْكٌ بَنَى كَعْبَةً لِلزَّائِرِينَ فَكَمْ","مِنْ زائِرٍ طافَ بِالأَرْكانِ وَاسْتَلَما",116,"م",2,0],["مَلَك ٌ بثينة ُفي السماءِ ثوى","لا لمْ تمُتْ ما ضمّها قبْرُ",117,"ر",1,0],["ملك بفيض أكفه ملك الورى","وببأسه حلقت لحى الأعداء",118,"ا",2,0]]}