لَةِ الزَمانِ وَشادا",3,"د",2,0],["إيهِ يا دُنيا اِعبِسي أَو فَاِبسِمي","لا أَرى بَرقَكِ إِلّا خُلَّبا",4,"ب",2,0],["إيهِ يا طَيرُ أَلا مِن مُسعِدٍ","إِنَّني قَد شَفَّني طولُ السَهَر",5,"ر",1,0],["إِيهِ يَا شَيْخَنَا العَمِيدَ وَمَهْلاً","فِي سَبِيلِ الإِحْسَانِ وَالإِجْمَال",6,"ل",1,0],["أيهيجُ مثلي بأسَ مثلكَ بالخنا","كمُقارعِ الصَّمصام بالسكين",7,"ن",1,0],["إيهِ يا خدنَ مصطفى كاملٍ","والعَهدُ عهدُ الخطوبِ والإيذاءِ",8,"ا",2,0],["إيه يا ابن العاصِ أشبهتَ الأُلىَ","زَلزلوا الدُّنيا وهَزّوا الأمَما",9,"م",2,0],["إيهِ يا مِصرُ أَلَمّا تَعلَمي","حادِثاتِ الدَهرِ في ماضي السِنينْ",10,"ن",1,0],["إيهِ يا مِصرُ اِذكُريها وَاِنظُري","أَيَّ شَعبٍ شَعبَكِ العاني الحَزينْ",10,"ن",1,0],["إيهِ يا ابنَ الربيعِ تِلكَ جُنودٌ","تَتَهاوَى عن جَانِبَيْها الجُنُودُ",11,"د",1,0],["إيه يا فَتنة الشُعوب وَيا أن","شودة الكَون شَقتنا أَجيالا",12,"ل",2,0],["إيهِ يا مصرُ خُذي ما شئتِهِ","ولداعي المجد منا ما يشاءْ",13,"ا",2,0],["إِيهِ يَا مَي أَسْرَفَ اليُتْمُ تَبْرِي","حاً بِرُوحٍ كَانَ الوَفِيَّ الحَنُونَا",14,"ن",2,0],["إِيهِ يَا قُرَّةَ النَوَاظِرِ كَمْ وَدَّتْ","جُفُونٌ لَوْ بِتِّ طِيِّ الجُفُونِ",15,"ن",1,0],["إِيهِ يا رَوْضَةَ المَعارِف لا زِلْتِ","مَثَابَ الْخيْراتِ والْبَركَاتِ",16,"ت",1,0],["إِيهِ يا شعرُ أنتَ سَلْوايَ في الدنيا","إِذا ضاق بي فسيحُ البَراح",17,"ح",1,0],["إيه، يا سعدُ، أحرفُ اسمِكَ فيهنَّ","لدار العلوم أطيَب فال",18,"ل",1,0],["آية يا ربة البسالة والعز","م، ويا رمز نهضة الأوطان",19,"ن",1,0],["إيه يا شاعر الحياة وماذا","نلت منها إلاّ الرجاء المعشّم",20,"م",1,0],["إيه يا دنيا اعبسى أو فابسمى","ما أرى برقك إلا خلبا",21,"ب",2,0],["إِيهِ يَا صَاحِبِي، لَقَدْ طَارَ جَدِّي","أَيُّ نُعْمَى هَذِي؟! وَأَيُّ مُقَامِ؟!",22,"م",1,0],["إيه يا مذبح الهوى ها هي الرو","ح فخذها من بائس أهداها",23,"ا",3,0],["إيه يا ابن الحريّة البكر","أبليت فإن يهدموا فأنت الباني",24,"ن",2,0],["أيهِ يا هندُ عن مسيحكِ ما زل","تُ وزالتْ ببيتكِ الأصنامُ",25,"م",1,0],["إيهِ يا فتنة الوجود سلامٌ","من مشوقٍ متيم القلب عاني",26,"ن",2,1],["إيه يا فتنة الوجود سلامٌ","من مشوق متيم القلب عان",27,"ن",1,1],["إيهِ يا صائِدَةَ الأَسماكِ","لَستُ السَمَكَه",28,"ه",1,0],["إيه يَاِبنَ الأَمجادِ قُمتَ بِأَعبا","ءِ كبارٍ وَالمجدُ ذو أَعباء",29,"ا",2,0],["إيهِ يا بَشيرُ أَفِض","ما تَقولُ مُقتَضَبُ",30,"ب",1,0],["إيه يا مصر عزاء إنما","أنت أولى بالتحيات الوضاء",31,"ا",2,0],["أيه يا عيد كم حزين كئيب","بات ينتابه الشقاء المرير",32,"ر",1,0],["أيه يا عبد رحمة بالمساكين","إذا أسرف الفتى الميسور",32,"ر",1,0],["إيه يا هند ما لقلب كقلبي","يشهد الحب خافيا كالعيان",33,"ن",1,0],["إيه يا قلب والذنوب كبار","والنايا كثيرة الأسباب",34,"ب",1,0],["إيه يا ربُّ ما عصيتُك جهلا","بل صغالاً من شقوتي واندفاعي",35,"ي",1,0],["إيه يا مخرجي الرواية هل كا","ذن عليكم في نقص دوري جناح",36,"ح",1,0],["إيه يا ساقي المجانة والله","وتظن الغرثان كالمقتات",37,"ت",1,0],["إيه يا ليل هل تنازلت عن عر","شك حتى ترقاه شمس الوجود",38,"د",1,0],["إيه يا فتنة النواظر مالي","كلما هاجني الحنين أساء",39,"ا",2,0],["ايه يا نفس أما من قبس","يذهب الشك ويجلو الحزنا",40,"ن",2,0],["إيهِ يا غزةَ ، صبرٌ واحتسابٌ","يا مِثالَ المُدُنِ الكُبرى العتيدهْ",41,"د",2,0],["إيِهِ يا غزَّةُ ، في عينِ القوافي","أملٌ رحبٌ وأسوارٌ مشيدَهْ",41,"د",2,0],["إيه ياوردتي أطلِّي ليمحو","كل هم جبينك المبلول",42,"ل",1,0],["إيه يا عيد الأماني","وأماني الناس ذخر",43,"ر",1,0],["إيه يا أمتي الكريمة ذودي","عابدين المنافع الشخصية",44,"ي",2,0],["إيهِ يا بلبل الرياض ترنم","إِنَّ من حولك السميعَ المجيبا",45,"ب",2,0],["إيهِ يا دَهْرُ مِنْ دُمُوعِ الثَّكالَى","وَاليَتامَى خُلِقْنَ بُؤْسًا وَفِتْنَةْ",46,"ن",2,0],["إيه يا أخت ننهل الناعم الدافئ","من غمرة الليالي العماق",47,"ق",1,0],["إيه يا صبح هل أتيت بخير","طال رعبي من سيء الأخبار",48,"ر",1,0],["إيه يا نفس إذا ما اضطرما","شوقه بين الحشا لا تيأسي",49,"ي",1,0],["إيه يا آية الجمال","ويا ربة الخبا",50,"ب",2,0],["ايه يا نيل قد صدقت فللتض","ليل في مصر أيما تمثيل",51,"ل",1,0],["إيه يا سعد يا مسيح الأطبّا","ءِ سلامٌ ومِدحةٌ وثناءُ",52,"ا",2,0],["إيه يا ليلة النّبىّ أقيمى","بيننا لا تعجّلى بازوِرارِ",53,"ر",1,0],["إيه يا غِرِّيدُ يا رب الغناء","مُرسَل النَّغمة تصبى وتصيب",54,"ب",1,0],["إيه يا أُمةً أقامت على الضيم","تراعي عهد الأَذى والوِداد",55,"د",1,0],["إيه يا شوكتَ الفيالقِ كن في","أَعينِ الظالمينَ شوكاً قَتادا",55,"د",2,0],["إيه يا أَنورَ العُلى وَنَيازي","المجدِ بُلِّغتُما العُلى والمُرادا",55,"د",2,0],["إيه يا شرقُ لا تنم واْعت","لِ السيَّارَ فالغربُ يعتلي المِنطادا",55,"د",2,0],["إيه يا ابنَ التقى فربُّك اعطا","كَ هِلالاً دانت لديهِ النجومُ",56,"م",1,1],["إيه يا وُرْقُ أَسعفيني فطَرفي","في سهادٍ وعَبرتي في نَفادِ",57,"د",1,0],["إيه يا رمسُ قد جمعتَ رُفا","تينِ لخيرِ الآباءِ والأَولادِ",57,"د",1,0],["ايه يا طائري السجينَ لماذا","تشتكي هل مللت صدريَ دارا",58,"ر",2,0],["إيه يا زنبقاً تبسَمَ في","الفجرِ وعِند الضُّحى بدا الإذواء",59,"ا",2,0],["إيه يا أُمَّ مصرَ صبراً وفخراً","ليس يُجدي على الرئيسِ العويلُ",60,"ل",1,0],["إيه يا مصرُ إنما الخطب قد عمَّ","فمنهُ للخافقينِ شُمولُ",60,"ل",1,0],["إيه يا مصرُ جدّدي عهدَ سعدٍ","إن عهدَ الرئيس نعمَ الدليلُ",60,"ل",1,0],["ايه يا ناصر النساء غَبطناك","بشوط أحرزتَ فيه النَّصرا",61,"ر",2,0],["إيه يا أمّتي ومجدك يهوي","بعد ذاك العلاء في الدّركات",62,"ت",1,0],["إيه يا حمص أعيدي ذكر من","غالبوا الأحداث في الشّام غلابا",63,"ب",2,0],["إيه يا ابن الملوك أعليت مصراً","في ملوك الزمان فوق السحاب",64,"ب",1,0],["إيهٍ يا نَسمةَ نَجد عنهُمُ","جدّدي عهدَ التصابي والصِّبا",65,"ب",2,0],["إيهِ يا شَمسَ خاطِري وَرَجائي","أَشرِقي في سَماءِ نَفسي الغَوِيَّه",66,"ي",2,0],["إيه يا ذِكرياتُ سامَحَكِ اللَ","هُ عَلى ما أَثَرتِهِ مِن حَنيني",67,"ن",2,0],["إيه يا نفسُ قد تغافلت جتى","سكنَ اللهو منك غدرَ الزمانِ",68,"ن",1,0],["إيهِ يا مصرُ قَد فَقَدتِ عظيماً","كادَ يُعليكِ فَوقَ هامِ الزَّمانِ",69,"ن",1,0],["إيهِ يا شَعبُ قد نبا بكَ دَهرٌ","مِنهُ مُدَّت إلى حشاكَ يَدانِ",69,"ن",1,0],["ايه يا بحر كم عهود تقضت","في صراع الامواج والشطآن",70,"ن",1,0],["إيه يا بحر لا أرى فيك يأساً","فرج الله ينجلي بثوان",70,"ن",1,0],["إيهِ يا طَيرُ أَسعِدي بِثَناءٍ","أَرتَضيهِ لِذي الجَلالِ الخَبيرِ",71,"ر",1,0],["إيهِ يا سَعدُ كَم تُعيدُ وَتُبدي","في جِهادٍ وَفي عَناءٍ كَثيرِ",71,"ر",1,0],["إيهِ يا ثَروَتُ وَالمَج","دُ مَضاءٌ وَاِعتِزام",72,"م",1,0],["إيه يا أَرضُ أَجدِبي أَو فَكوني","رَوضَةً عاكف عَلَيها