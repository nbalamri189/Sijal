{"poems":[[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[50,"يا عارم الطرف حيثما نظرا","https://www.aldiwan.net/poem63292.html","المنسرح"],[50,"وملحة بالعذل تحسب أنني","https://www.aldiwan.net/poem66630.html","الكامل"],[147,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[275,"أبكي على الصيف كالباكي على الطلل","https://www.aldiwan.net/poem35661.html","البسيط"],[305,"ثكلى عوان بدوار مؤلفة","https://www.aldiwan.net/poem45499.html","البسيط"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124018","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125374","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17737","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130382","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111420","البسيط"],[4709,"قلمٌ وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=214835",""],[5410,"رقيب","https://www.poetsgate.com/ViewPoem.aspx?id=109732",""],[5493,"نشيدُ الشجر","https://www.poetsgate.com/ViewPoem.aspx?id=197037",""],[5977,"وجعي","https://www.poetsgate.com/ViewPoem.aspx?id=212756",""]],"verses":[["حَتّى إِذا ذَرَّ قَرنُ الشَمسِ أَو كَرَبَت","أَحَسَّ مِن ثُعَلٍ بِالفَجرِ كَلّابا",0,"ب",2,0],["حَتّى إِذا ذَرَّ قَرنُ الشَمسِ صَبَّحَها","ذُؤالُ نَبهانَ يَبغي صَحبَهُ المُتَعا",1,"ع",2,0],["حَتّى إِذا ذُقتَها خَرَرتَ لَها","بَعدَ مَجالِ الظُنونِ مُنعَفِرا",2,"ر",2,0],["حتى إذا ذهب الزمانُ بذاتها","وتخلّصت روحاً من العطّار",3,"ر",1,0],["حَتّى إِذا ذَهَبوا بِحُرِّ نَباتِهِ","تَرَكوهُ لِلمُتَعَقِّبينَ هَشيما",4,"م",2,0],["حتى إذا ذبُلَت أصبَحتُ أنشدُها","يا رحمة اللهِ ما أولاكِ بالطّلَل",5,"ل",1,0],["حَتّى إِذا ذَرَّ قَرنُ الشَمسِ صَبَّحَهُ","أَضري اِبنَ قُرّانَ باتَ الوَحشَ وَالعَزَبا",6,"ب",2,0],["حتّى إذا ذرّ قرن الشمس فزّعهُ","غضفُ لديهنّ طرد الوحش مطّرد",7,"د",1,0],["حتى إذا ذهب الظلامُ وأشرَقَت","شمسُ الضُّحَى تزهو على تلك الرُّبا",8,"ا",1,0],["حتى إذا ذهب الظلامُ وأشرقت","شمسُ الضُّحى تزهو على الأفنانِ",9,"ن",1,0],["حَتّى إِذا ذادَها عَنهُ وَقَطَّعَها","طَعنٌ يُصيبُ بِهِ الحَيّاتِ وَالقَصَبا",10,"ب",2,0],["حتى اذا ذكر الذين ترحلوا","قعد الهوى بين الضلوع وقاما",11,"م",2,0],["حتى إذا ذهب البقايا كلهم","حلت البقاع بحلية الأبلاس",12,"س",1,0],["حتى إذا ذاقا بما نالهما","ذرعاً وأمر الله جل اقتربا",13,"ب",2,0],["حتَّى إِذا ذَابَتِ الأَفخاذُ واجتعَلُوا","باقي الحَشا اقتسَمُوا اللَّحمَ الذي فَضَلا",14,"ل",2,0],["حتى إذا ذُكِرَ العراقُ رأيتَني","حزنا على خدي ترآى المدمعُ",15,"ع",1,0],["حتى إذا ذُكِرَ الثرى خفرت على","أشلائها يجتاحها التعذيب",16,"ب",1,0],["حتى إذا ذهب الشتاء ببرده","صارت جذوعي كالزجاجِ ممرَّدَا",17,"د",2,0],["حتى إذا ذكروك في خبرٍ","ما اهتزّ قلبي ..لم تعد شيئا",18,"ي",3,0]]}