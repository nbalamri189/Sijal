{"poems":[[55,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[95,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[32,"أمنكر أنت ربع الدار عن عفر","https://www.aldiwan.net/poem29614.html","البسيط"],[29,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[74,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[74,"من كلن من هفواته متنصلا","https://www.aldiwan.net/poem19595.html","الكامل"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"تجري المحاسن من قرون رؤوسها","https://www.aldiwan.net/poem66022.html","الكامل"],[87,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem2257.html","عموديه"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[87,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[63,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[82,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[42,"يا ليت ليلى رأتنا غير جازعة","https://www.aldiwan.net/poem42291.html","البسيط"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[186,"عيد به زهرة الآداب قد نفحت","https://www.aldiwan.net/poem67067.html","البسيط"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[438,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[445,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[519,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[520,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[520,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[543,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[556,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[558,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[567,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38014","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38961","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119947","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120086","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119978","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119934","المنسرح"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80019","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79933","الكامل"],[1550,"","https://poetry.dctabudhabi.ae/diwan/poem/131378","البسيط"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26679","الكامل"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205527","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49556","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101030","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69393","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109297","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53225","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53228","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27400","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27238","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120874","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120980","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101816","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93618","البسيط"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48060","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93845","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100173","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103599","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133311","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69972","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77125","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81923","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117211","الكامل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127924","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133201",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[4858,"العيد أقبل والأحباب قد بانوا","https://www.poetsgate.com/ViewPoem.aspx?id=143449",""],[4984,"معركة \" الشوابير\"","https://www.poetsgate.com/ViewPoem.aspx?id=191622",""],[585,"يا صاحب التاج عن حقٍّ وإرث أب","https://www.poetsgate.com/ViewPoem.aspx?id=161895",""],[5085,"سقتني الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=188440",""],[5150,"شهادة الدم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204039",""],[5185,"من مشاهد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=71714",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5581,"أنذار","https://www.poetsgate.com/ViewPoem.aspx?id=22501",""],[5829,"كان الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=162006",""],[186,"عيد به زهرة الآداب قد نفحت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55766&r=&rc=29",""],[5126,"زفرةُ أسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87804&r=&rc=19",""]],"verses":[["مِن كُلِّ نافِذَةِ المَغارِ كَأَنَّها","في قَلبِ حامِلِها فَمٌ مُتَثاوِبُ",0,"ب",1,0],["مِنْ كُلِّ نِضْوِ الآلِ يَسْتَفُّ الفَلاَ","سَيْراً تَقَلَّصُ دُونَهُ الأَرْجَاءُ",1,"ا",2,0],["مِن كُلِّ نَضّاخَةِ الذِفرى إِذا عَرِقَت","عُرضَتُها طامِسُ الأَعلامِ مَجهولُ",2,"ل",1,0],["مِنْ كُلِّ نَدْبٍ بِهِ تَعْتَزُّ لَجْنَتُهُمْ","لا يَظْلِمُ الحَقُّ دَاعِيهِ بِإِنْسَانِ",3,"ن",1,0],["مِن كُلِّ نَضّاخَةِ الذِفرى يَمانِيَةٍ","كَأَنَّها أَسفَعُ الخَدَّينِ مَذؤوبُ",4,"ب",1,0],["مِن كُلِّ نَضّاخَةِ الذِفرى عَذَوَّرَةٍ","في مِرفَقَيها عَنِ الدَفَّينِ تَحنيبُ",5,"ب",1,0],["من كل ناشرَةِ الوفا طائيَّةٍ","قد ناسبت بنوَالها الأنسابا",6,"ب",2,0],["من كلن من هفواته متنصِّلاً","في بابِ عزّكمُ فما أتنصَّل",7,"ل",1,1],["من كلّ ناعمةِ الشبا","ب كأنها الخُوطُ الهصيرُ",8,"ر",1,0],["من كل ناعمةِ الشباب غريرةٍ","تَسبي العقولَ وتزدهي الأحلاما",9,"م",2,0],["من كلّ ناطقة ِ الجلال، كأَنه","أُمُّ الكتاب على لسان القاري",10,"ر",2,0],["مِن كُلِّ نَعشٍ كَالثُرَيّا مَجدُهُ","في الأَرضِ عالٍ وَالسَماءِ أَصيلُ",11,"ل",1,0],["مِن كُلِّ ناطِقَةِ الجَلالِ كَأَنَّها","أُمُّ الكِتابِ عَلى لِسانِ القاري",12,"ر",2,0],["من كلِّ نائي الحُجرَتَيْنِ مُقنَّعٍ","بالبَرقِ داني الطُّرَّتَيْنِ مُشَهَّرِ",13,"ر",1,0],["من كلّ ناظمِ بيْتٍ لا شبيهَ له","فليس يُنْثَرُ منه الدهرَ ما نظما",14,"م",2,0],["مِن كُلِّ ناشِئةٍ إذا اتّصَلَت","مِنْ عُمْرها بالأرْبَعِ العَشْرُ",15,"ر",1,0],["مِن كُلِّ ناجِيَةٍ كَأَنَّ أَديمَها","حيصَت ظِهارَتُهُ بِجِلدِ أَطومِ",16,"م",1,0],["مِن كُلِّ ناشِرَةٍ فَرعاً لِرُؤيَتِنا","وَمَفرَقاً ذا نَباتٍ غَيرِ مَفرُوقِ",17,"ق",1,0],["مِنْ كلِّ ناحِيَةٍ سَنَاهُ يَلوحُ مِن","مِصْبَاحِ نورِ نُبُوَّةٍ مُتَوَقِّدِ",18,"د",1,0],["مِنْ كُلِّ نِضْوٍ نُحولٍ ما يزالُ به","إلى المَكارِمِ جِدُّ وَهْوَ مَهْزولُ",19,"ل",1,0],["مِنْ كُلِّ نَاعِمَةِ الصِّبَا بَدَوِيَّةٍ","رَيَّا الشَّبابِ سَلِيمَةِ الْمُتَجَرّدِ",20,"د",1,0],["مِن كُلِّ نَصلٍ أَضمَرَت أَحشاؤُهُ ال","أَرواحَ وَهوَ حَشىً بِغَيرِ فُؤادِ",21,"د",1,0],["مِنْ كُلِّ نَدْبٍ بَعِيدِ الرَّأْيِ مُسْتَبِقٍ","إِلى الْجِهَادِ مُغَارِ الْفَتْلِ صَبَّارِ",22,"ر",1,0],["من كلّ نافرة فإن جمّشتها","ألفيت عقد نطاقها محلولا",23,"ل",2,0],["مِن كُلِّ نَدبٍ لَهُ في الفَضلِ عارِضةٌ","تُجري مِنَ السِّحرِ في الأَلباب إِسكارا",24,"ر",2,0],["مِنْ كلِّ نَجْمٍ طَالِعٍ","فيِ بُرْجٍ سَامِي الجِيدِ أَجْرَدْ",25,"د",1,0],["من كل نجلاءَ مذ أيقظتَ ناظرَها","ملأت أعينَ مَنْ عاداك تسهيدا",26,"د",2,0],["من كلِّ نافِرةٍ ذَلَّتْ لِقَودِ يَدِي","في ثِنْي ما يَدُكَ العلياءُ تَحْبُوني",27,"ن",2,0],["من كلّ ناسٍ في غدٍ بعثَهُ","لم يرهب اللّه ولم يتّقِ",28,"ق",1,0],["من كلِّ نيّرةٍ بتاجِ شَقيقِها","قمرٌ تحفُّ به نجومُ لِدانهِ",29,"ن",2,0],["من كل نادرة تهز رواتها","منها قناة بل فتاة رودا",30,"د",2,0],["من كل ناطقة المحاسن حرة","أجرى عليها الرزق حر المنطق",31,"ق",1,0],["مِن كُلِّ نُعمانٍ بَعُدتُ فما أنا","حتى بِفِقهِ صاحِبِ النُّعمانِ",32,"ن",1,0],["من كلّ نهّاضٍ بثِقْلِ الأذى","موكَّلِ الكاهلِ بالمُعظَمِ",33,"م",1,0],["مِن كُلِّ نَهدٍ لا يَزالُ كَأَنَّهُ","يَومَ الهِياجِ عَمَلَّسٌ مَمطورُ",34,"ر",1,0],["من كل نابغةٍ يُفيضُ كأنَّما","نُشِرَ الفَرَزْدَقُ في تميمَ لغالبِ",35,"ب",1,0],["من كل نقص جُردت أوصافه","لكنه برداء فضل كاس",36,"س",1,0],["من كل ندب ما دعاه قَبِيْلُهُ","إلا ومنه لمن دعاه قبيل",37,"ل",1,0],["مَن كلِّ نادِرَةٍ لَديهِ يَتيمَةٍ","تزري بِعَقد في العقودِ مُنضَّدِ",38,"د",1,0],["مِن كلِّ نَرجِسَةٍ غَدَت شَمساً على","بَدرٍ يُضيءُ متمَّماً تتميما",39,"م",2,0],["مِن كلِّ نادِرَةٍ أَضحَت كَواسِطةٍ","في العِقدِ مُنتَظِماً مِن أَفخَرِ الدُّررِ",40,"ر",1,0],["من كل نظم ناثر","بالمدح في ناديك درا",41,"ر",2,0],["من كل نهد في الفلاة يرى","سيدا وفي الأمواه كالنونِ",42,"ن",1,0],["من كل ناضرة القوام غريرةٍ","هيفاء ناظرة بطرف فاترِ",43,"ر",1,0],["من كل نزر العطاء نذر","عليه أن لا يفي بنذر",44,"ر",1,0],["من كل نجمٍ في الدياجي قد لوى","في كفه مثل الهلال فدارا",45,"ر",2,0],["من كلِّ نهاض العزائم حائزٍ","قصبَ الرهان بيوم كلِّ سباقِ",46,"ق",1,0],["من كلِّ ناعمة الصِبا","تثني معاطفَها دَلالا",47,"ل",2,0],["من كل ندب بثغر منه مبتسم","يلقى العفاة بوجه منه منطلق",48,"ق",1,0],["من كلِّ ناشرةٍ قوادمَ أفتخٍ","وعلى معاطفها فراهةُ شَوذَقِ",49,"ق",1,0],["من كل نضاخة الدفرى إذا عرفت","يميل عجباً ولا عي وتنكيل",50,"ل",1,0],["من كلِّ ناجيةِ الآمال قد فَصَلَتْ","من الرّدَى فحسبناها من البُكُر",51,"ر",1,0],["من كل ندب لا يرى غير ما","يرضى العلا شغلاً له شاغلا",52,"ل",2,0],["من كل ناعمة الحياة ومترفٍ","ورد الحياة معينها وزلالها",53,"ل",3,0],["مِن كُلِّ ناعِمَةِ التَرائِبِ صَيَّرَت","طِيبَ الحَياةِ شَقاً عَلَيَّ وَبُوسا",54,"س",2,0],["مِن كل ناهدة إذا حسرت لنا","عن صدرها انقلب الغرام جنونا",55,"ن",2,0],["من كل نصلٍ كساه النصر غرته","لما تلقى شفيعاً منه عريانا",56,"ن",2,0],["من كل نافثة عن سحر فاترة","يخاف من جفنها سيف بن ذي يزن",57,"ن",1,0],["من كلِّ نجمٍ وأفلاكٍ يدور بها","وما يولده من هذه الأكرْ",58,"ر",1,0],["من كلِّ نجم واقع بحقيقة","وأهلَّة طلعتْ بأفقِِ سمائها",59,"ا",3,0],["من كلّ نهدٍ ضامرٍ عبل الشوى","منه إلى نحر العدوّ نهودُ",60,"د",1,0],["من كلِّ نهدٍ ضامر عبل الشوى","منه إلى نحوِ العدوِّ نهودُ",61,"د",1,1],["من كل ندب سري سيد سند","ولوذعي ومفضال وكل كمي",62,"م",2,0],["مِن كُل نَظم يرى كَالعقد مُنتَظِما","فيها وَنثر يَرى كَالدر مُنتَثِرا",63,"ر",2,0],["من كُلِّ نِضوِ الآلِ مَحبوكِ المُنى","يُزْجِيهِ نَحوَكَ كُلُّ مَحبوكِ القَرَا",64,"ر",2,0],["من كل نجل أبت أباؤه الكرم