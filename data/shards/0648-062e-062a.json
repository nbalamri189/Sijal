{"poems":[[77,"العمر نوم والمنى أحلام","https://www.aldiwan.net/poem36107.html","الكامل"],[93,"يفسح الراحلون للقادمينا","https://www.aldiwan.net/poem11170.html","الخفيف"],[48,"إذا ما افترقنا فادر أن لست من ذكري","https://www.aldiwan.net/poem63400.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[161,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[165,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[238,"قصدت أبا يعزى وبالبال بلبال","https://www.aldiwan.net/poem18852.html","الطويل"],[299,"أعطى قليلا واستردا","https://www.aldiwan.net/poem36857.html","عموديه"],[305,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[378,"ورد الله الرحيم","https://www.aldiwan.net/poem59269.html","مجزوء الرمل"],[392,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[392,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[404,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[430,"خطرت تفتر عن الجوهر","https://www.aldiwan.net/poem41404.html","المتدارك"],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[530,"قالوا أتيت مؤخرا","https://www.aldiwan.net/poem37423.html","مجزوء الكامل"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"]],"verses":[["وَخَتَمْتَ عُمْرَكَ بِالصَّلاَةِ فَحَبَّذَا","عَمَلٌ كَرِيمٌ سَعْيُهُ وَخِتَامُ",0,"م",1,0],["وَخِتَامٌ تَضَوَّعَ المِسْكُ مِنْهُ","بِعَبِيرٍ أَضَاعَهُ الدَّهْرُ حِينَا",1,"ن",2,0],["وَخُتَّ عَلى عَمدٍ بِعِلمِكَ وَانسَني","وَلا تَرَ لي الإِحسانَ يَوماً مِنَ الدَهرِ",2,"ر",1,0],["وَخَتَمْتَ بِالمَوْتِ الْجَمِيلِ","أَجَلَّ خَاتِمَةٍ جَهَادَكْ",3,"ك",1,0],["وَخِتَامُ الْعَجَائِبُ المُدْهِشَاتِ","رَبَّنَا ما سِوَاكَ مِنْ مَعْبُودِ",4,"د",1,0],["وختمت بالتكبير تكبيراته","عند الشروعِ تحرماً بصلاتهِ",5,"ت",2,0],["وَخَتٍّ فَإِن تَستَعصِموا بِجِبالِها","فَأَوعارُها مِثل السُهولِ البَوارِثِ",6,"ث",1,0],["وَخَتْمٌ بِخَيْرٍ تَسْتَتِمُّ بِهِ الْمُنَى","فَسِيَّانِ إِكْثَارٌ بِذَاكَ وَإِقْلاَلُ",7,"ل",1,0],["وختلتُهُ بحبائلي","وأَرغتُهُ عكساً وطردا",8,"د",2,0],["وختمنا بما بدأنا أدكارا","قل لأحبابنا بسوح المقام",9,"م",1,0],["وخِتانَتْهُ تُرينا","جسداً فيه كلوم",10,"م",1,0],["وختمه الفناء بالكليه","في الله ربي خالق البريه",11,"ه",1,0],["وختم القول خذ نصحا عجيبا","إذا شئت السلامة فالزم الدار",12,"ر",1,0],["وختام الرسل كم من دعوة","قد أجيبت مثل لمح بالبصر",13,"ر",1,0],["وختام الثغر عقيقته","ضمّت بلجين لا يحسر",14,"ر",1,0],["وختَّموا ملساء لم يخدِشْ بها","سنٌّ على إثر العطايا نادمُ",15,"م",1,0],["وخُتِّمَ بالعقيقِ فزان عندي","بمعصَمِ وعدِه حَليَ المِطالِ",16,"ل",1,0],["وخِتامُ كُلِّ الرُّسْل صَا","رَ ِمنَ الجَمِيع أَجَلَّ قَدْرا",17,"ر",2,0],["وَخَتَّمَ أَحمَدَ المُختا","رَ أَكرَمَ خَلقِهِ الرُسُلا",18,"ل",2,0]]}