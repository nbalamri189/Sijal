{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[65,"هي العيس مبتذرات الخطا","https://www.aldiwan.net/poem46132.html","المتقارب"],[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[88,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[32,"عفا الزرق من أطلال مية فالدحل","https://www.aldiwan.net/poem29547.html","الطويل"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[39,"ولم يتجهم لك النائبات","https://www.aldiwan.net/poem7070.html","المتقارب"],[53,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[53,"جرى الأضحى رسيل المهرجان","https://www.aldiwan.net/poem66393.html","الوافر"],[91,"يراع صنانيد الكتابة كالعضب","https://www.aldiwan.net/poem44643.html","الطويل"],[91,"ولا تحسب الإنسان إلا سلالة","https://www.aldiwan.net/poem44728.html","الطويل"],[87,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[47,"عذيري من صرف الليالي الغوادر","https://www.aldiwan.net/poem63598.html","الطويل"],[47,"أثيل العقيق إلى بانه","https://www.aldiwan.net/poem66677.html","المتقارب"],[30,"إليك حملت الأمر ثم جمعته","https://www.aldiwan.net/poem4992.html","الطويل"],[30,"لله يربوع ألما تكن لها","https://www.aldiwan.net/poem5536.html","الطويل"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[107,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[69,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[77,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"لقد وضعت حواء أمك بكرها","https://www.aldiwan.net/poem22644.html","الطويل"],[48,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85384","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[105,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[92,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[136,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[189,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[190,"دموع العين أربعة تباع","https://www.aldiwan.net/poem43629.html","الوافر"],[242,"إذا أنت لفقت الذي قاله الشقي","https://www.aldiwan.net/poem19699.html","الطويل"],[280,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[287,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[309,"هدى الله معشوق الجمال إلى الهدى","https://www.aldiwan.net/poem16883.html","الطويل"],[353,"إذا ضن عني باخل بعطائه","https://www.aldiwan.net/poem20263.html","الطويل"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[382,"دع راهبا لا يخدم الله ربه","https://www.aldiwan.net/poem59165.html","الطويل"],[408,"أيا وجد أبقيت حتى على صبري","https://www.aldiwan.net/poem46745.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[438,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[463,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[466,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[475,"قضيت قضاء في الخلافة لم تدع","https://www.aldiwan.net/poem4809.html","الطويل"],[520,"أبا حسن كدرت ماء صفائي","https://www.aldiwan.net/poem11997.html","الطويل"],[520,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[534,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[563,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[592,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122682","الطويل"],[724,"","https://poetry.dctabudhabi.ae/diwan/poem/107161","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87085","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122316","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71006","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59742","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59697","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16935","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16761","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128719","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80015","الطويل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146092","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109002","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128074","الطويل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202205","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89527","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201058","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202514","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65396","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113894","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130067","الوافر"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46831","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62851","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48299","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106790","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91287","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132093","الطويل"],[3800,"","https://poetry.dctabudhabi.ae/diwan/poem/146649","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103014","الوافر"],[4086,"","https://poetry.dctabudhabi.ae/diwan/poem/198808",""],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141109","الوافر"],[4691,"مشيتِ على قلبي أيحسدني الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=185442",""],[4712,"رويتك في صحيحي","https://www.poetsgate.com/ViewPoem.aspx?id=202613",""],[4727,"أرابك من زمانك ما يريب","https://www.poetsgate.com/ViewPoem.aspx?id=213230",""],[4749,"أقوال شعري بها أتعثر","https://www.poetsgate.com/ViewPoem.aspx?id=155993",""],[1703,"مضى طاهر البردين جذلان هانياً","https://www.poetsgate.com/ViewPoem.aspx?id=49924",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5476,"وَاسْتَقَالَ الْمَلَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=194683",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[5107,"صورة مناضل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83046&r=&rc=38",""]],"verses":[["وَلَم يَترُكوا في نَصلِ شَنعاءَ مَضرِباً","وَلَم يَدَعوا في قَوسِ عَلياءَ مَنزَعا",0,"ع",2,0],["ولمْ يَتْرُكِ البَيْنُ لي عَبْرَةً","ولكنها عَلَقٌ يُمْتَرى",1,"ا",1,0],["ولم يَتْرُكِ الضِّرْغامَ في حَوْمَةِ الوَغى","جَباناً ولا صَوْبَ الغَمامِ مُبَخَّلا",2,"ل",2,0],["ولم يُتلِعوا أعْناقَهمْ نَحوَهُ هَوًى","ولا عَفّروا تلكَ الجِباهَ لهُ حُبّا",3,"ب",2,0],["وَلَم يَتَحَدَّ الناسَ لَكِنَّهُ اِمرُؤٌ","بِما كانَ في مَقدورِهِ يَتَكَلَّمُ",4,"م",1,0],["وَلَم يَتَشَذَّر لِلأُمورِ مُجَلِّياً","إِلَيها كَما جَلّى مِنَ المَرقَبِ الصَقرُ",5,"ر",1,0],["وَلَمْ يَتِمَّ لَهَا فِي غَيْرِ مُدَّتِهِ","مَا تَمَّ مِنْ فَضْلِ إِثْرَاءٍ وَعُمْرَانِ",6,"ن",1,0],["وَلَم يَتَرَبَّع أَهلُ مَيٍّ وَأَهلُنا","صَرائِمَ لَم يُغرَس بِحافاتِها النَخلُ",7,"ل",1,0],["وَلَم يَتَذَكَّر مِن بَقِيَّةِ عَهدِهِ","مِنَ الحَوضِ وَالسُؤبانِ إِلّا صَلاصِلا",8,"ل",2,0],["ولم يتجهم لك النائبات","ولم تك منها اللياس الدثورا",9,"ر",2,1],["ولم يتغالوْه لكي يرْقعُوا به","رثاثاً من الأحساب ذات خصاص",10,"ص",1,0],["ولم يتغنَّ المحسناتُ لمحسنٍ","بمثلِ مديحٍ ذامِلٍ فيه راتكِ",11,"ك",1,0],["ولم يتتابعِ العيدانِ إلا","تنافُسَ رؤيةِ الملكِ الهجان",12,"ن",1,0],["ولم يتولد بعد في العرب مصلح","ولكنه بين الترائب والصلب",13,"ب",1,0],["ولم يتحسن طوره لتنازع","ولكن حياة القرد رامت تطورا",14,"ر",2,0],["وَلَم يَتَقَلَّدوا شُكرَ اليَتامى","وَلا اِدَّرَعوا الدُعاءَ المُستَجابا",15,"ب",2,0],["وَلم يَتَكَلَّف قَومُكَ الأُسدُ أُهبَةً","وَلَكِنَّ خُلقاً في السِباعِ التَأَهُّبُ",16,"ب",1,0],["وَلَم يَتَبَسَّم لِلعَطايا فَتَنبَري","مَواهِبُ أَمثالُ الغُيوثِ البَواكِرِ",17,"ر",1,0],["وَلَم يَتَوَقَّف عَلى شَكِّهِ","فَيَمنَعهُ تَنفيذَ إيقانِهِ",18,"ن",2,0],["وَلَم يَتَوَسَّد غَيرَ أَلواحِ ساعِدٍ","وَحَيثُ اِنثَنَت مِن بانَتي رُكبَةُ اليَدِ",19,"د",1,0],["وَلَم يَتَأَرَّ العاقِباتِ وَلَم يَنَم","وَلَيسَ أَخو الوِترِ الغَشومِ بِنائِمِ",20,"م",1,0],["وَلَم يَترُكِ الأَبطالَ صَرعى وَغِسلُها","دَماها وَأَحشاءُ النُسورِ لَها قَبرُ",21,"ر",1,0],["وَلم يَتركوا شَيئاً لَنا مِن بلادنا","نَلذُّ بِهِ بين الأَنامِ وَننعمُ",22,"م",1,0],["ولَمْ يَتَقاسَمُوا الأسفالَ إلاَّ","لأَنَّ الشَّيْخَ مَا احْتَمَلَ الْغُبونا",23,"ن",2,0],["ولم يتَجَمّعْ لامرىءٍ كان قبلَهُ","خِضابُ العَوالي واجتنابُ المآثم",24,"م",1,0],["ولم يتَأخَّرْ مَن يريد تقدُّماً","ولم يتَقَدَّمْ من يريد تأخُّرا",25,"ر",2,0],["وَلَم يَتَناوَل دُرَّةَ الحَقِّ غائِصٌ","مِنَ الناسِ إِلّا بِالرَوِيَّةِ وَالفِكرِ",26,"ر",1,0],["وَلَم يَتَوازَن في القِياسِ نَعيمُها","وَسَيِّئَةٌ أَودَت بِمُقتَرِفيها",27,"ي",3,0],["وَلم يتقدم فيه إلا من اِرتَدى","رداءً به أَهل الشنار تلفعوا",28,"ع",3,0],["وَلَمْ يَتَجَلَّ الصُّبْحُ عَنْهُ وَبَطْنُهُ","لَطِيفٌ كطَيِّ السِّبِّ لَيْسَ بِحادِرِ",29,"ر",1,0],["ولم يَتْرُكْ أبُوكُ سِوى قَناةٍ","وسَيْفٍ آزِرٍ فَرَساً وَجُنّه",30,"ن",2,0],["وَلَم يَتبَعوا مَن جاءَ في الناسِ بَعدَهُم","لَقَد بَيَّنوا لِلسالِكينَ وَأَوضَحوا",31,"ح",3,0],["ولم يتبجحوا في كل أمر","خطير، كي يقال مثقفونا",32,"ن",2,0],["ولم يتخبَّثْ بهُجْر الكلام","ولم يتصيَّدْ بماءٍ عكر",33,"ر",1,0],["ولم يتغيرْ عَروضُ الخليل","ولا العُربُ قد بُدلّوا بالتَتر",33,"ر",1,0],["وَلَم يَتَشَكَّ الضَّربَ ضَارِبُ نَفسِهِ","ولَم يَشكُ حَرَّ النَّارِ مُكتَوٍ اكتَوَى",34,"و",2,0],["ولَم يَتَّبِعِ الحَقَّ تألِيفُهُ","فَقِيلَ ويُحكَى الذي أَلَّفَا",35,"ف",2,0],["وَلَم يَتَّرِك تِلكَ البِلادَ لِأَنَّها","بَغَت بَدَلاً مِنهُ وَلا أَن نَبا دَهرُ",36,"ر",1,0],["ولم يَتَملَّ قلبٌ من أمانٍ","ولم تَتَرَوَّ عينٌ من منام",37,"م",1,0],["ولم يترك لنا خلفا نجيبا","يكون لقوله منّا استماعُ",38,"ع",1,0],["وَلَمْ يَتَعَشَّقْ مَنْ سَيُمْسِي مُمَزَّقاً","بِأَيْدِي الْبِلَى فِي التُّرْبِ كُلَّ مُمَزَّقِ",39,"ق",1,0],["وَلَمْ يَتْرُكَن في العِلْمِ والحِلْم والنَّدَى","لِمَاضٍ وآتٍ بَعْدُ حَظّاً ولا شِقْصَا",40,"ص",2,0],["وَلَم يَتَمَطَّ قَطُّ قرا جَوادٍ","بِمِثلِكِ يا قَراجا إِذ تُهاجا",41,"ج",2,0],["ولم يتأهب للرجوع لربه","ولم يتزود للطريق البعيدة",42,"ه",1,0],["ولم يتبع خير الأنام محمدا","نبي الهدى بحر الندى مجلى الصدى",43,"د",2,0],["وَلَمْ يَتكلَّفْ كاهِلي حَمْلَ مَنّهِ","لهُ لا وَلا نُطقي بِحَمْدٍ ولا شُكْرِ",44,"ر",1,0],["ولم يُتِمَّ اسْمَهُ للإكتفاء بما","أَهدَى من النُّورِ للقاصي وللدّاني",45,"ن",2,0],["ولم يتَعلّمْ سوىالهجرِ قط","فلو شاء وَ صْلَ فتىً مادَرى",46,"ا",1,0],["ولم يَتلُ في معنى الخلاص اجتهادَه","على الخير بل يتلو علينا التوانيا",47,"ي",2,0],["ولم يتلقّ العذل قلبي وإنّما","تلقّاه منّي ما بأذنيَ من وقْرِ",48,"ر",1,0],["ولم يتبدَّل شهمها بأخسّها","فكيفَ بها إنْ سادها غيرُ جنسها",49,"ه",2,0],["ولم يترك لأهل الفخر فخراً","ولم يترك لذي قولٍ مقالا",50,"ل",2,0],["ولم يترُكْ أبو الفتحِ المُعلّى","لبابٍ يتقيه به انقِفالا",51,"ل",2,0],["ولم يتغوّر كوكبٌ من سمائهم","ولم يتخّمر بالسَّرار هلالُ",52,"ل",1,0],["ولم يتدرعوا سقفاً ولكن","جسومٌ تستجنُّ بها الدروعُ",53,"ع",1,0],["ولم يتلافَ الأمر في أُخرياته","عميد مطاع القول في النهي والأمر",54,"ر",1,0],["وَلَم يَترُكُوا ذا لِبسَةٍ رأيه عَمىً","وَلَم يَترُكُوا ذا الدَرءِ حَتَّى تَقَوَّما",55,"م",2,0],["ولم يتحدث بيننا كل خامل","أشرف من مقداره بهجاتي",56,"ي",1,0],["ولم يتنازع عمه وابن عمه","عليها إلى أن يجمع الخلق حشره",57,"ر",2,0],["ولَمْ يَتَلاعَبِ الأَقْوامُ يَوْماً","بآراءٍ إِلى بِدَعٍ تَقُودُ",58,"د",1,0],["ولم يتابعهم على","عقولهم ولا اعتنى",59,"ن",2,0],["ولم يتب إلى علي منها","ولا رأى له الخروج عنها",60,"ه",2,0],["ولم يتغير ليس ينجس عنده","وقد كان أحظى منهمو بالدلائل",61,"ل",1,0],["وَلَم يَتقَدَّم صَدرَ كُلِّ كَتيبَةٍ","تَقَدَّم بِسمِ اللهِ آيُ المَصاحِف",62,"ف",1,0],["وَلَم يتَبَدَّل مُذ سَباهُ بِحُسنِهِ","وَلا شاقَهُ ظَبيٌ سِواهُ فَيَنساهُ",63,"ا",2,0],["وَلَم يَتّبع في سنة","عَلى جَهله أَحيا رُسوم المَعالم",64,"م",1,0],["ولم يتنبه ان للناس السناً","إذا نشبت في عرضه فهي اسهم",65,"م",1,0],["وَلَم يَترُك بِها أَحَداً سِوى مَن","بِها يَنكبّ في الأَرض اِنكِبابا",66,"ب",2,0],["وَلَم يَترُك بِأَرضهم طَعاماً","وَلا عَيشاً هَنيّاً مُستَطابا",66,"ب",2,0],["ولم يتركْ لها عُشُبا","ولا خوصاً ولا ورقا",67,"ق",2,0],["ولم يتركوا أوطانهم بمرادهم","ولكن لإحوال أشابت مفارقي",68,"ق",2,1],["ولمْ يتخذْ للصلح منها وسيلةً","يُرّضي مسيحاً قصدُها وكليماً",69,"م",2,0],["وَلَم يَتَواضَع في مُصاداةِ مِنَّةٍ","وَكُلُّ مُصادي مِنَّةٍ مُتَواضِعُ",70,"ع",1,0],["وَلَم يَتَسَهَّل لِلفَتى دَرَكُ العُلا","إِذا هُوَ لَم يَصبِر عَلى المُتَصَعِّبِ",71,"ب",1,1],["ولم يتخلقع بالوفا نيل مصرنا","ولا ذيل ستر بالهنا راح مسبلا",72,"ل",2,0],["ولم يتبعْ الإقتداء به الهُدى","بلى أوجب اللهُ العظيم اتِّباعه",73,"ع",2,0],["ولم يتحدَّرْ طلّ نرجسِ مقلةٍ","على صفحتي تفّاح خدٍّ مضرَّج",74,"ج",1,0],["ولم يترك لآلهما عزاءً","يخفف بعض آلام الكبود",75,"د",1,0],["ولم يتخذ خلا سوى السيف والقنا","وحصنا سوى ظهر المطهمة الجرد",76,"د",1,0],["ولم يتربع واسطا وجنوبه","إلى السر من وادي الأراكة حاضر",77,"ر",1,0],["وَلَم يَتركِ الدُنيا ضَياعاً لِغاشِمٍ","مُخيفُ سَبيلٍ أَو عَلى الناسِ قاطِعُه",78,"ع",2,0],["ولم يترك جديد الهم وقتاً","لاقضي واجب الهم القديم",79,"م",1,0],["ولم يتغير منّي الخلق مرةً","ولكن عقلي ارتادَ مختلف السبل",80,"ل",1,0],["ولم يتطيّر في الورى أحدٌ به","ولكنّهُ من غيره يتطيّرُ",81,"ر",1,0],["ولم يتبع الإنجيل في الأمر بالرضو","خ للذل فاستدل الحسام لقاها",82,"ا",3,0],["ولم يتردّدوا أن يخبروهُ","بأنَّ النارَ يسبقها الدخانُ",83,"ن",1,0],["ولمْ يُتَقَلَّد الصَّمْصا","مُ أو يُتَقَمَّصُ الزَّرَدُ",84,"د",1,0],["ولم يَتَعَسَّفِ التَّدْبيرَ خَبْطاً","كمن ركبَ الفلاةَ بغيرِ هَادِ",85,"د",1,0],["ولم يتخِذْ إلا الفِرارَ وقايَةً","ولمْ يدّخِرْ إلا المذلَّةَ زادَهُ",86,"د",2,0],["ولم يتهمه بالجفا حين عتبه","ولا انه ما اسطاع رداً فاعذرا",87,"ر",2,0],["ولَم يَتنِنِي عَن بَابِكُم لِزِيَارِةٍ","قُصُورٌ وَلاَ عَجزٌ وَلاَ نَيلُ نائِلِ",88,"ل",1,0],["وَلم يتلُ وَصلٌ بَعد أَيّ تفاصلٍ","لحكمة إِلا أَن يميز فهيم",89,"م",1,0],["ولم يتمالك قيصر الروس حينما","أتاه بنعي الفيلسوف وزير",90,"ر",1,0],["ولم يتأت التيه والحب لامرئ","ومن يبتغي كل المنى حرم البعضا",91,"ض",2,0],["ولم يترك من العشاق ألا","بقايا من جسوم كالرسوم",92,"م",1,0],["ولم يتبقَ في هذا الوجود فضيلةٌ","ولم تحتضنها بالسَّماحات حُسناه",93,"ا",2,0],["ولم يترك رسول الله فينا","أضر على الرجال من النساء",94,"ا",2,0],["ولم يتهملْ إذْ يسيرُ فؤادُهُ","لمنْ ماؤها دَلٌ فما في الهوى مهلُ",95,"ل",1,0],["ولم يتَبَقَّ فوقَ الأرضِ أصلاً","سِوَى العرَبيّ يفرَحُ بالمديحِ!",96,"ح",1,0],["ولم يتركُ بها الأملاكُ حُرًّا","فأكثرُ أهلها هَمَجٌ ونُوبُ",97,"ب",1,0],["ولم يتناول خِصالك شِعري","وأهمل فيها وروداً ومرمرْ",98,"ر",1,0],["ولم يتحمّل هائج البحر فارتمى","وقد ناشه الموت المحتّم ضاريا",99,"ي",2,0],["ولم يتعبّدنى اللئام بمنة","ولا أنا للشيء الذى فات تابع",100,"ع",1,0],["ولم يتصل أو يبين ولم","يقدم جوابا لمستنشد",101,"د",1,0],["ولم يتأولها برأي مفند","كما قاله من قد بغى أو تجهما",102,"م",2,0],["ولم يتوقف فضلهم وتقاهمو","على ذكر أوباش طغام ذوي عمى",103,"م",2,0],["وَلَمْ يِتَبَقَّ لِغَزْوِ الْمَدَى","سِوَى إِنْ أَرَدْنَا فَكَانَ الْحِصَارُ",104,"ر",1,0],["ولم يتم لها في غير مداته","ما تم من فضل غثراء وعمران",105,"ن",1,0],["ولم يتبع القوم الذين تهافتوا","وقالوا بتبعيضٍ وأخرُ جسّدا",106,"د",2,0],["ولم يتبقَّ مِنَ الأصلِ إلا","الفروعُ سوى يوسُفٍ ونديمْ",107,"م",1,0],["ولم يتذكروا يوماً عصيباًَ","تميل على الحبال به الرقابُ",108,"ب",1,0]]}