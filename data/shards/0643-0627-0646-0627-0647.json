{"poems":[[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[93,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[72,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[51,"لا والد خالد ولا ولد","https://www.aldiwan.net/poem62056.html","البسيط"],[42,"يا لقومي لطول هذا العتاب","https://www.aldiwan.net/poem42286.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[285,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[287,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[374,"يا جمال الدنيا ولولاك كانت","https://www.aldiwan.net/poem4313.html","الخفيف"],[466,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[469,"من لي بأسمر كالخطي معتدلاً","https://www.aldiwan.net/poem3248.html","عموديه"],[520,"هي البدر من سنة البدر أملح","https://www.aldiwan.net/poem12055.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48532","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59128","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132828","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69317","الوافر"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20389","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203477","السريع"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199454","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68021","الطويل"],[5183,"أبا دواؤد","https://www.poetsgate.com/ViewPoem.aspx?id=180195",""]],"verses":[["كانَ أهلَ العَفَافِ والمَجدِ والخَي","رِ ونَقضِ الأُمُورِ والإِبرَامِ",0,"م",1,0],["كأنَّ أهل العلى جسمٌ ذووك له","هامٌ وأنت يمين العين في الهام",1,"م",1,0],["كَأَنّ أَهرامُها الأَطوادُ باذِخَةً","هَذي إِلى جَنبِها الأُخرى تُساميها",2,"ي",3,0],["كانَ أَهلُ الغَرامِ قَبلي أُمِّيِ","يِنَ حَتّى تَلَقَّنوا كَلِماتي",3,"ت",2,0],["كَأَنَّ أَهرامَ مِصرٍ حائِطٌ نَهَضَت","بِهِ يَدُ الدَهرِ لا بُنيانُ فانينا",4,"ن",2,0],["كَأَنَّ أَهلَ القُبورِ لَم يَسكُنوا ال","دورَ وَلَم يَحيَ مِنهُمُ أَحَدُ",5,"د",1,0],["كانَ أَهوى إِلى الفُؤادِ وَأَشهى","مِن جَني النَحلِ شِيبَ صَوبَ السَحابِ",6,"ب",1,0],["كأنّ أهلَ قُرى نَمْلٍ عَلَوْنَ قَرا","رَمْلٍ فغادَرْنَ آثاراً مَخافِيتا",7,"ت",2,0],["كَأَنَّ اهْتِزازَ الْقُرْطِ فِي صَفْحِ جِيدِها","سَنَا كَوْكَبٍ فِي مَطْلَعِ الْفَجْرِ لائِحُ",8,"ح",1,0],["كانا هُما حَرَميَّ الآمِنَينِ فَيا","وَيلاهُ أَبدَلتُ إِحلالي بإِحرامي",9,"م",2,0],["كَأَنَّ أَهِلَّةً قَذَفَتْ نُجُوماً","إِذا قَدَحَتْ سَنابِكُها شَرارا",10,"ر",2,0],["كَأَنَّ أَهلَ الشامِ فيهِ مُقلٌ","ناظِرَةٌ وَأَنتَ نورٌ في المُقَل",11,"ل",1,0],["كان أهدى إِلى الصواب لو استف","داك من نفسه ببعض الموالي",12,"ل",2,0],["كأن اهابي مُشْعَرٌ خيبريةً","غداة سرى ظعن الخليط المفارق",13,"ق",1,0],["كأنا هي في كاساتها ذهب","سكب ترصع في حافاته درر",14,"ر",1,0],["كأن اهتزاز الغصن من فوق ردفها","قضيب بأعلى رملة يترنح",15,"ح",1,0],["كان أهل السودان في حكم مصر","مع رعايا العزيز تحت لواء",16,"ا",2,0],["كَأنَّ أهْلَ العُلاَ جِسْمٌ وَأنْتَ لَهُمْ","هَامٌ يُتَوَّجُ فِي العَلْيَا بِإجْلاَلِ",17,"ل",1,0],["كَأن أهْل العُلَى لفظ وَأنْتَ لَهُم","مَعْنىً يَدُل عَلَى إيضَاحِ تَبْيِينِ",18,"ن",1,0],["كأنَّ اهتزازَ الرُّمح في كبدي إذا","تكشَّفَ بَرق أو بدا منك مَعهدُ",19,"د",1,0],["كَأَنَّ أَهِلَّةَ الظَلماءِ صيغَت","لِأَيديها وَأَرجُلِها نِعالا",20,"ل",2,0],["كَأَنَّ اِهتِزامَ الرَعدِ خالَطَ جَوفَهُ","إِذا حَنَّ فيهِ الخَيزَرانُ المُثَجَّرُ",21,"ر",1,0],["كأن أهل الخلد زوارها","عليهمُ حرِّمتِ النار",22,"ر",1,0],["كأن أهازيج الذباب أساقف","لها من أزاهير الرياض محاريب",23,"ب",1,0],["كَأَنَّا هَباءٌ قَدْ تَقَلَّص ظِلُّهُ","يهبّ عَلَيْهِ السافَياتُ عواصفا",24,"ف",2,0],["كأن أهازيج البلابل فوقها","ترنم أعواد على كف مطرب",25,"ب",1,0]]}