{"poems":[[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[104,"يا سراة البلاد يكفي البلادا","https://www.aldiwan.net/poem33129.html","الخفيف"],[4691,"يئست نفسي بعد طول الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=61768",""],[3591,"حلفتُ بأن أدوم على هواكا","https://www.poetsgate.com/ViewPoem.aspx?id=149396",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""]],"verses":[["أَحَبُّ طِباقٍ فِي البَدِيعِ طِبَاقُهَا","يَرُوعُ النُّهَى مُنْآدُهَا وَالمُقَوَّمُ",0,"م",1,0],["أَحبط اللَه سَعيكُم أَلِحبِّ الذ","ذا قُمتم تَهيّئونَ العِتادا",1,"د",2,0],["أحبط َ العزم َ قولهم إنني","مثل حفّار ٍ باصْبع ٍ للجبل ْ",2,"ل",1,0],["أحبُّ طباعك الغر اللواتي","مكارمها استبانت من حياكها",3,"ك",3,0],["أحب طباق في البديع طباقها","يروغ النهى مآدها والمقوم",4,"م",1,0],["أحبّ طفولاتٍ لديك بريئة","أهيم بمرأى الكهل طفلاً أماميا",5,"ي",2,0]]}