َ الذاهِبِ الخَلَفُ",1,"ف",1,0],["لي فيهِمُ أَشرَفُ الحُظوظِ إِذا ال","رَوعُ أَعانَ الحُسامَ بِالعَضَدِ",2,"د",1,0],["لي فِيكَ ودٌّ لمْ أكُنْ منْ بعْدِ ما","أعطَيْتُ صفْقَةَ عهْدِهِ لأخيسا",3,"س",2,0],["لي في حِمَى ذاكَ الضّريحِ لُبابةٌ","إنْ أصبَحَتْ لُبْنى أنا ابْنُ ذَريحِ",4,"ح",1,0],["لي فيكَ حينَ بَدا سَناكَ وَأَشرَقا","أَمَلٌ سَأَلتُ اللَهَ أَن يَتَحَقَّقا",5,"ق",2,1],["لي فُؤادٌ فيكَ تُنكِرُهُ","أَضلُعي مِن شِدَّةِ الوَهَنِ",6,"ن",1,0],["لي في اِعتِمادِكَ بِالتَأميلِ سابِقَةٌ","وَهِجرَةٌ في الهَوى أَولى مِنَ الهِجَرِ",7,"ر",1,0],["لي في المُوالاةِ أَتباعٌ يَسُرُّهُمُ","أَنّي لَهُم في الَّذي نُجزى بِهِ تَبَعُ",8,"ع",1,0],["لي فيهِ المَثَلُ السائِرُ عَن","جالِبِ التَمرِ إِلى أَرضِ هَجَر",9,"ر",1,0],["لِي فِيهِمُ الأَصْفَى مِنَ الأَحْبَابِ لا","أَعْدَمْهُ وَالأَوْفَى مِنَ الخُلاَّنِ",10,"ن",1,0],["ليَفزَع ممن يدّعي الحبَّ قلبُه","كما فزِعت قُمريّة الروض من صقر",11,"ر",1,0],["لي في الأماني في لماهُ وخدِّهِ","في كلِّ يومٍ منزهٌ أو مشرب",12,"ب",1,0],["لي في ندى ومحاسن","خبرٌ يلذُّ ويستطاب",13,"ب",1,1],["لي في الأصادق خائن","في المال مني والوداد",14,"د",1,1],["لي في القصائد تشبيبٌ بها ولها","على جريح الحشا باللحظ تذفيف",15,"ف",1,0],["لي في جنابك برجٌ غير منقلبٍ","إذا التجأت ونجمٌ غير منكسف",16,"ف",1,0],["لي في ذوي النظم روض يستطاب شذا","ريحانه الغضّ أو نوَّاره الخضل",17,"ل",1,0],["ليَ في درهمين في كل شهرٍ","من فئامٍ ما يطرُدُ الحَوْجاءَ",18,"ا",2,0],["ليَ في جاههِ مآربُ كانت","لابنِ عمرانَ في عصاهُ الشعيبِ",19,"ب",1,0],["ليَ في مَدْحيَ فيه أمَلٌ","وبلاغٌ وله فيه خلودُ",20,"د",1,0],["ليفسِرنَّ لهم فعالكَ أنه","أبداً بصدقِ المادحيك كفيلُ",21,"ل",1,0],["ليفخرْ عبيدُ اللَّه فهْو الذي له","بفضلِ الحجى والبأسِ والجود يُحكَمُ",22,"م",1,0],["لِيَفُزْ من الأمراء شاهنشاههمُ","بِفَتىً من الوزراء شاهنشاه",23,"ه",1,0],["لِيَ في قُربِكَ أَوفى راحَةٍ","فَتَجَشَّم لِيَ في ذاكَ العَنا",24,"ن",2,0],["لِيَ فيهِ مَذهَبٌ يَت","بَعُني فيهِ الأَنامُ",25,"م",1,0],["لِيَ فيكَ وَقَد عَلِمتَ عِشقٌ","لا يَفهَمُ سِرَّهُ العَواذِل",26,"ل",1,0],["لي في الغَرامِ سَريرَةٌ","وَاللَهُ أَعلَمُ بِالسَرائِر",27,"ر",1,0],["لِيَ فيكَ أَجرُ مُجاهِدٍ","إِن صَحَّ أَنَّ اللَيلَ كافِر",27,"ر",1,0],["لي فيكَ قَصدٌ جَميلٌ","لاخَيَّبَ اللَهُ قَصدَك",28,"ك",1,0],["لِيَ في ذَلِكَ سِرٌّ","بَرقُهُ لِلناسِ خُلَّب",29,"ب",1,0],["لي في الحياة احترام للنواميس","فلا ابدل موهوما بمحسوس",30,"س",1,0],["لي فيك يا وطني الذي قد ملني","حب يواري في الرماد ضراما",31,"م",2,0],["لي في فراقك لو سمحت بنظرة","خزنٌ تأَجَّجُ ناره في أضلعي",32,"ع",2,0],["لي فيكَ مَدحٌ لَيسَ فيهِ تَكَلُّفٌ","أَملاهُ حُبٌّ لَيسَ فيهِ تَمَلُّقُ",33,"ق",1,0],["لي في ثَنائِكَ وَهوَ باقٍ خالِدٌ","شَعرٌ عَلى الشِعرى المَنيعَةِ زاري",34,"ر",2,0],["لي في الهَوى سِرٌّ أَبيتُ أَصونُهُ","وَاللَهُ مُطَّلِعٌ عَلى الأَسرارِ",35,"ر",1,0],["لِيَفِر وَفرُكَ المُلَقّى وَإِن أَع","وَزَ أَن يُجمَعَ النَدى وَوُفورُه",36,"ر",2,0],["لِيَ في تَركيبِهِ بِدَعٌ","شَغَلَت قَلبي عَنِ السُنَنِ",37,"ن",1,0],["لي فيكَ دمعٌ ما رقا","يوماً وطرفٌ ما رقدْ",38,"د",1,0],["لي في مسايلهِ عُصارةُ مُهجةٍ","حَملَتْ تكاليفَ الهُمومِ ثِقالا",39,"ل",2,0],["لي في الأُلى حفظوا لمصر عهودها","حرم على الايام غير مُذال",40,"ل",1,0],["لي في الهَوى عُذرُ الأَمينِ وَلَيسَ لي","غَدرُ الخؤونِ وَلا أَثيمُ غَرامِهِ",41,"م",2,0],["لي في ذمامِكِ حاجةٌ مَنْشُودَةٌ","لولا الهُدَى وَسَبيلُهُ لم تُنْشَدِ",42,"د",1,0],["ليُفدَى كلُّ مأسورٍ بإربِ","فيا عجباً لقولٍ منكِ قيلا",43,"ل",2,0],["لِي فِي اللَّمَا نَشوَةُ الثَّغرِ عَلَى دُرَرِ","يَحكِي إلَى الرَّاحِ وَالسَّلسَالِ وَالقَندِ",44,"د",1,0],["لي في التَصابي وَاللَهوِ حاجاتُ","لَيسَ لِقَلبي مِنهُنَّ إِفلاتُ",45,"ت",1,1],["لِيَ في قَلبِيَ مِنهُ لَوعَةٌ","مَلَكَت قَلبي وَسَمعي وَالبَصَر",46,"ر",1,0],["لِيَفتَنَّ في صَمتِهِ ناسِكٌ","إِذا اِفتَنَّ فيما يَقولُ الوَرى",47,"ر",2,0],["لِيَفعَلِ الدَهرُ ما يَهُمُّ بِهِ","إِنَّ ظُنوني بِخالِقي حَسَنَه",48,"ن",2,0],["لي فيك ياليل آهات أرددها","أواه لو أجدت المحزون أواه",49,"ا",2,0],["لي في بغداد ونهضتها","حق قد ضاع وأنشده",50,"د",2,0],["لي فيك يا بلداً حراً نزلت به","بالخل خل وَبالندمان ندمان",51,"ن",1,0],["لي في أَمر الأحكام كلا","مٌ من حذري لا أُورده",52,"د",2,0],["لي في مَديحِكَ يا رَسولُ عَرائِسٌ","تُيِّمنَ فيكَ وَشاقَهُنَّ جَلاءُ",53,"ا",2,0],["لِي فِيكِ مِنْ جِهَةِ المَنَارَةِ مَعْهَدٌ","ذَهَبَ الصِّبَا وسنَاه مِلْءُ سَوَادِي",54,"د",2,0],["لِيَ فِي مِصْرَ مَا أَشَاءُ مِنَ الْطَّيِّبِ","وَفِي بَعَلْبَكَ مَا هُوَ أَطْيَبْ",55,"ب",1,0],["لي فِيكَ مِنْ غُرَرِ المَدِيحِ شَوَاردٌ","أَدَّتْ حُقُوقَ عُلاَكَ كُلَّ أَدَاءِ",56,"ا",2,0],["لِي فِي ثَرَاهُ دَفِينَةٌ","كَالكَنْزِ في الْمُستَوْدَعِ",57,"ع",1,0],["لِيَفْخَرْ بِغَالِي دُرِّهِ كُلُّ كَاتِبٍ","وَيَجْأَرْ بِعَالِي صَوْتِهِ كُلُّ مُنْشِدِ",58,"د",1,0],["لِي فِي الْحَيَاةِ مُرَادٌ","وَأَنْ أَرَاكُمْ مُرَادِي",59,"د",2,0],["لى فيك عند المنحنى وعقيقه","ذكرى تطوف بالجنون وتستقى",60,"ق",2,0],["لي في قرار الكاس بعد بقيةٌ","سمحت بها الآلمُ للعوّادِ",61,"د",1,0],["لي في رُبُوعك وَقْفَةٌ","أشْهَى إلي من الوِصَال",62,"ل",1,0],["لي في كل ذرة من وجودي","حكمة قد طويتها عن عبادي",63,"د",2,0],["لي في حمى ذاك الضريح لبانة","إن أصبحت لبنى أنا ابن ذريح",64,"ح",1,0],["لي في العراق عصابةٌ لولاهمُ","ما كان محبوباً الىّ عراقُ",65,"ق",1,0],["لي فيكُمُ قَمرٌ يُهيُّجني له","ان البِعادَ يَروعُنى بخُسوفه",66,"ف",2,0],["لي فيك صوغٌ للبلاغة لو خلا","جيدُ الفتاة لزانها منسوقه",67,"ق",2,0],["لي في الحياة أمانٍ لو جَهَرتُ بها","قُوبلتُ من سَفْسطيَّاتٍ بضوضاء",68,"ا",2,0],["لي فيك آمال وصدق عزائم","لا بد تنشر طيَّها الأزمان",69,"ن",1,0],["لِيفينّ، في صَمتهِ، ناسكٌ،","إذا افتنّ، فيمايقول، الورى",70,"ر",2,0],["ليَ فيها أَيام أُنس تَقضت","غرراً في أسرَّة الأَزمان",71,"ن",1,0],["لي في بوادي الرقمتين غزال","هجمت عليّ لاجله العذال",72,"ل",1,1],["لي في زوايا الربع من حيهم","قلب على جمر الغضا قلبا",73,"ب",2,0],["لي فيك ظن جميلٌ لا يحول ولي","يد سوى بابك المقصود ما قرعت",74,"ت",1,0],["لي في الصبابةَ أخبارً وأحوالُ","وفي المحبةِ أقوالَ وأفعالُ",75,"ل",1,1],["لي في بطون اليعمَلات مَزادةٌ","تُروِى إذا غدَر رياضَ الطامى",76,"م",2,0],["لي في المطايا الفضلِ كلُّ شِمِلةٍ","أبدا أرحِّلها لزادِ مسافرِ",77,"ر",1,0],["لِيَ فيه مذاهبٌ مُذْهباتٌ","مقبلاتُ الإِقْبالِ عِندَ الذّهابِ",78,"ب",1,0],["لي فيك ظن جميل لا يخيب إذا","خابت ظنون رجال أخطئوا النظرا"