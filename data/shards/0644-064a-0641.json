 فؤاد يحن شوقاً إليكم","كل حين في سائر الحالات",161,"ت",1,0],["لي في الإله عقيدة غراءُ","هي والذي هو في الوجود سواء",162,"ا",2,1],["لي فيكَ وحدَكَ دِيوانٌ نَظَمتُ بهِ","مدحاً وفي مَدحِ باقي الناسِ ديوانُ",163,"ن",1,0],["لي فيكِ فتَّانةٌ لام العَذُولُ بها","جَهلاً فقُلتُ هو الأعمى فلا حَرَجا",164,"ج",2,0],["لي في ذمامك حرمةٌ قد أكدت","سبباً يراه المجدُ من أسبابِهِ",165,"ب",2,0],["ليَ في كلِّ سَاعةٍ أَلفُ قُبْلَهْ","لِهلاَلٍ فيه الشموسُ أَهِلَّهْ",166,"ل",2,1],["لي في غرامي فيكَ لاحٍ واحدٌ","وإِذا أَرَدْتَ ففيك أَلفٌ عاذِرُ",167,"ر",1,0],["لِي فَوْدٌ وَفُؤادٌ يَرْتَجِي","طِيبَ وَصْلٍ مِنْكُمْ بالهَجْرِ لَاذَا",168,"ذ",2,1]]}