ُ",104,"ص",1,1],["لي في الهوى كبد مقطعة","تكوى بنار الصد والهجر",105,"ر",1,0],["لي في مواكبِه فؤا","دٌ ضعتُ منه وَضاع منّي",106,"ن",2,0],["لي في الرياضيّ باعٌ غير مستترٍ","وفي الفَصاحةِ ما منّي لَكم عُهدا",107,"د",2,0],["لي فَقِيرٌ وَهُوَ أَغْنَى الوَرَى","بِالحُسْنِ جَلَّتْ قُدْرَةُ الوَاحِدِ",108,"د",1,1],["لي في دَواةِ الفَتحِ أَحسنُ مِدْحَةٍ","بِفُنونِها لِذَوِي العُقُولِ فُنُونُ",109,"ن",1,1],["لي في خَلوَتي بِجَلوَةِ مَحبوبي","مَغيبٌ عَن مَشهَدِ الرُقباءِ",110,"ا",2,1],["لي في الحِمى خِلٌّ خَلا عَن نيّةٍ","لَم تَخل مِن كَرَم وَحُسن طَويّةِ",111,"ه",1,1],["لي فيكَ دَمع كلما","أَخفى هَواك يترجم",112,"م",1,0],["لي فَرَسٌ صائمٌ حكَى فَرَسَ الش","شَطْرَنْجِ والصّدْقُ غيرُ مُلْتَبِسِ",113,"س",1,1],["لِيَفْرُقَ ما بينَ السَّوائحِ ناظري","وقد طَلَعتْ شَمْسي وبينَ البوارح",114,"ح",1,0],["لي في عُلاكَ مَقالُ كلّ بديعةٍ","يَرْويهِ كلُّ مُشَرِّقٍ ومُغَرِّب",115,"ب",1,0],["لي في وَلائِكَ أَيُّ عَقدٍ صادِقٍ","ما حَلَّ شَكٌّ حَلَّ يَوماً عَقدَهُ",116,"د",2,0],["لي فيكَ غَرسٌ لَيتَهُ","مِن قَبلِ قَطفِيَ كانَ أَثمَر",117,"ر",1,0],["لي فيكَ مَسأَلَتانِ وَه","مي ظَلَّ دونَهُما قَصيرا",118,"ر",2,0],["لي في عُلاكَ دَواوينٌ مُخَلَّدَةٌ","تَبقى وَتُبقيكَ مَمدوحاً وَتُبقيني",119,"ن",2,1],["لِيَفخَرِ الناسُ وَما باعَدوا","بِأَن بَراهُ اللَهُ إِنسانا",120,"ن",2,0],["لي في الحسود علامةٌ","في وجههِ إذ يَحمأُ",121,"ا",1,0],["لي فيكمُ دمعٌ يَنِمُّ بسِرِّكُم","أبداً تكفكفهُ يد البُرَحاء",122,"ا",2,0],["لي في النَسيب رَقيقهُ وَرَشيقُهُ","وَمَنيعُهُ وَلَطيفُهُ وَعَجيبُهُ",123,"ب",2,0],["ليَ فيكُم مَدائِحٌ وَمراثٍ","حُفِظَت حِفظَ محكَم التَنزيلِ",124,"ل",1,0],["لِي فيكَ قلبٌ ما انتَهى","عَن غيّهِ ولا ارْعَوى",125,"ع",3,1],["لي فاصِرف اللَومَ قَلبٌ شاعَ منكَشِفاً","في مَذهَبِ الحُبِّ يا هَذا تَشَيُّعُهُ",126,"ع",2,0],["لي فيك مولاي عن بدر الدجى عِوَضٌ","إن لاح بدر الدجى عني وإن غربا",127,"ب",2,0],["لي فيك مُنْيَة عاشق ذي صبوة","معلومة وتهتّكٍ وهيام",128,"م",1,0],["لي في المنازل حيثُ رامة وقفةٌ","فيها لمن عانى الصبابة مصرعُ",129,"ع",1,0],["لِيَ في القُرْبِ منكَ والبُعْدِ عَنْهُمْ","خَبرٌ مُعْجِب