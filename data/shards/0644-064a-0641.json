{"poems":[[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[53,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[86,"حال بين الجفن والوسن","https://www.aldiwan.net/poem68962.html","المديد"],[73,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[73,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[93,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[88,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[72,"تجني لواحظه علي وتعتب","https://www.aldiwan.net/poem18229.html","الكامل"],[72,"لي في ندى ومحاسن","https://www.aldiwan.net/poem18269.html","مجزوء الكامل"],[72,"لي في الأصادق خائن","https://www.aldiwan.net/poem18622.html","مجزوء الكامل"],[72,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[70,"أيها المعرض عن أحبابه","https://www.aldiwan.net/poem42669.html","الرمل"],[70,"سلم الله على من","https://www.aldiwan.net/poem42705.html","مجزوء الرمل"],[70,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[70,"غيري على السلوان قادر","https://www.aldiwan.net/poem42882.html","مجزوء الكامل"],[70,"مولاي كن لي وحدي","https://www.aldiwan.net/poem42934.html","المجتث"],[70,"قال لي العاذل تسلو","https://www.aldiwan.net/poem43031.html","مجزوء الرمل"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[89,"طلعت كقرن الشمس بعد تبرقع","https://www.aldiwan.net/poem44950.html","الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[85,"ملك السماء بهرت في الأنوار","https://www.aldiwan.net/poem63717.html","الكامل"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[44,"لو تراه يا أبا الحسن","https://www.aldiwan.net/poem30098.html","المديد"],[69,"يا جامع الحسن أما","https://www.aldiwan.net/poem28853.html","مجزوء الرجز"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[105,"بشراك أم حبيبة بمحمد","https://www.aldiwan.net/poem44057.html","الكامل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[81,"سل عن سهادي وعن سقمي وعن جلدي","https://www.aldiwan.net/poem61364.html","البسيط"],[52,"لي في التصابي واللهو حاجات","https://www.aldiwan.net/poem27187.html","المنسرح"],[50,"طال هذا الليل بل طال السهر","https://www.aldiwan.net/poem63795.html","الرمل"],[46,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[46,"صنوف هذي الحياة يجمعها","https://www.aldiwan.net/poem23493.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85515","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85560","المتدارك"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54647","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54713","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[77,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[90,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[46,"سرَيْنا، وطالبنا هاجعٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=16598",""]],"verses":[["لي في حَواشي البَرقِ أُنسٌ فَلا","أَدري أَأُغضي دونَهُ أَم أَشيم",0,"م",1,0],["لي فيهِمُ خَلَفٌ مِن كُلِّ مُفتَقَدٍ","وَرُبَّما جازَ قَدرَ الذاهِبِ الخَلَفُ",1,"ف",1,0],["لي فيهِمُ أَشرَفُ الحُظوظِ إِذا ال","رَوعُ أَعانَ الحُسامَ بِالعَضَدِ",2,"د",1,0],["لي فِيكَ ودٌّ لمْ أكُنْ منْ بعْدِ ما","أعطَيْتُ صفْقَةَ عهْدِهِ لأخيسا",3,"س",2,0],["لي في حِمَى ذاكَ الضّريحِ لُبابةٌ","إنْ أصبَحَتْ لُبْنى أنا ابْنُ ذَريحِ",4,"ح",1,0],["لي فيكَ حينَ بَدا سَناكَ وَأَشرَقا","أَمَلٌ سَأَلتُ اللَهَ أَن يَتَحَقَّقا",5,"ق",2,1],["لي فُؤادٌ فيكَ تُنكِرُهُ","أَضلُعي مِن شِدَّةِ الوَهَنِ",6,"ن",1,0],["لي في اِعتِمادِكَ بِالتَأميلِ سابِقَةٌ","وَهِجرَةٌ في الهَوى أَولى مِنَ الهِجَرِ",7,"ر",1,0],["لي في المُوالاةِ أَتباعٌ يَسُرُّهُمُ","أَنّي لَهُم في الَّذي نُجزى بِهِ تَبَعُ",8,"ع",1,0],["لي فيهِ المَثَلُ السائِرُ عَن","جالِبِ التَمرِ إِلى أَرضِ هَجَر",9,"ر",1,0],["لِي فِيهِمُ الأَصْفَى مِنَ الأَحْبَابِ لا","أَعْدَمْهُ وَالأَوْفَى مِنَ الخُلاَّنِ",10,"ن",1,0],["ليَفزَع ممن يدّعي الحبَّ قلبُه","كما فزِعت قُمريّة الروض من صقر",11,"ر",1,0],["لي في الأماني في لماهُ وخدِّهِ","في كلِّ يومٍ منزهٌ أو مشرب",12,"ب",1,0],["لي في ندى ومحاسن","خبرٌ يلذُّ ويستطاب",13,"ب",1,1],["لي في الأصادق خائن","في المال مني والوداد",14,"د",1,1],["لي في القصائد تشبيبٌ بها ولها","على جريح الحشا باللحظ تذفيف",15,"ف",1,0],["لي في جنابك برجٌ غير منقلبٍ","إذا التجأت ونجمٌ غير منكسف",16,"ف",1,0],["لي في ذوي النظم روض يستطاب شذا","ريحانه الغضّ أو نوَّاره الخضل",17,"ل",1,0],["ليَ في درهمين في كل شهرٍ","من فئامٍ ما يطرُدُ الحَوْجاءَ",18,"ا",2,0],["ليَ في جاههِ مآربُ كانت","لابنِ عمرانَ في عصاهُ الشعيبِ",19,"ب",1,0],["ليَ في مَدْحيَ فيه أمَلٌ","وبلاغٌ وله فيه خلودُ",20,"د",1,0],["ليفسِرنَّ لهم فعالكَ أنه","أبداً بصدقِ المادحيك كفيلُ",21,"ل",1,0],["ليفخرْ عبيدُ اللَّه فهْو الذي له","بفضلِ الحجى والبأسِ والجود يُحكَمُ",22,"م",1,0],["لِيَفُزْ من الأمراء شاهنشاههمُ","بِفَتىً من الوزراء شاهنشاه",23,"ه",1,0],["لِيَ في قُربِكَ أَوفى راحَةٍ","فَتَجَشَّم لِيَ في ذاكَ العَنا",24,"ن",2,0],["لِيَ فيهِ مَذهَبٌ يَت","بَعُني فيهِ الأَنامُ",25,"م",1,0],["لِيَ فيكَ وَقَد عَلِمتَ عِشقٌ","لا يَفهَمُ سِرَّهُ العَواذِل",26,"ل",1,0],["لي في الغَرامِ سَريرَةٌ","وَاللَهُ أَعلَمُ بِالسَرائِر",27,"ر",1,0],["لِيَ فيكَ أَجرُ مُجاهِدٍ","إِن صَحَّ أَنَّ اللَيلَ كافِر",27,"ر",1,0],["لي فيكَ قَصدٌ جَميلٌ","لاخَيَّبَ اللَهُ قَصدَك",28,"ك",1,0],["لِيَ في ذَلِكَ سِرٌّ","بَرقُهُ لِلناسِ خُلَّب",29,"ب",1,0],["لي في الحياة احترام للنواميس","فلا ابدل موهوما بمحسوس",30,"س",1,0],["لي فيك يا وطني الذي قد ملني","حب يواري في الرماد ضراما",31,"م",2,0],["لي في فراقك لو سمحت بنظرة","خزنٌ تأَجَّجُ ناره في أضلعي",32,"ي",1,0],["لي فيكَ مَدحٌ لَيسَ فيهِ تَكَلُّفٌ","أَملاهُ حُبٌّ لَيسَ فيهِ تَمَلُّقُ",33,"ق",1,0],["لي في ثَنائِكَ وَهوَ باقٍ خالِدٌ","شَعرٌ عَلى الشِعرى المَنيعَةِ زاري",34,"ر",2,0],["لي في الهَوى سِرٌّ أَبيتُ أَصونُهُ","وَاللَهُ مُطَّلِعٌ عَلى الأَسرارِ",35,"ر",1,0],["لِيَفِر وَفرُكَ المُلَقّى وَإِن أَع","وَزَ أَن يُجمَعَ النَدى وَوُفورُه",36,"ر",2,0],["لِيَ في تَركيبِهِ بِدَعٌ","شَغَلَت قَلبي عَنِ السُنَنِ",37,"ن",1,0],["لي فيكَ دمعٌ ما رقا","يوماً وطرفٌ ما رقدْ",38,"د",1,0],["لي في مسايلهِ عُصارةُ مُهجةٍ","حَملَتْ تكاليفَ الهُمومِ ثِقالا",39,"ل",2,0],["لي في الأُلى حفظوا لمصر عهودها","حرم على الايام غير مُذال",40,"ل",1,0],["لي في الهَوى عُذرُ الأَمينِ وَلَيسَ لي","غَدرُ الخؤونِ وَلا أَثيمُ غَرامِهِ",41,"م",2,0],["لي في ذمامِكِ حاجةٌ مَنْشُودَةٌ","لولا الهُدَى وَسَبيلُهُ لم تُنْشَدِ",42,"د",1,0],["ليُفدَى كلُّ مأسورٍ بإربِ","فيا عجباً لقولٍ منكِ قيلا",43,"ل",2,0],["لِي فِي اللَّمَا نَشوَةُ الثَّغرِ عَلَى دُرَرِ","يَحكِي إلَى الرَّاحِ وَالسَّلسَالِ وَالقَندِ",44,"د",1,0],["لي في التَصابي وَاللَهوِ حاجاتُ","لَيسَ لِقَلبي مِنهُنَّ إِفلاتُ",45,"ت",1,1],["لِيَ في قَلبِيَ مِنهُ لَوعَةٌ","مَلَكَت قَلبي وَسَمعي وَالبَصَر",46,"ر",1,0],["لِيَفتَنَّ في صَمتِهِ ناسِكٌ","إِذا اِفتَنَّ فيما يَقولُ الوَرى",47,"ر",2,0],["لِيَفعَلِ الدَهرُ ما يَهُمُّ بِهِ","إِنَّ ظُنوني بِخالِقي حَسَنَه",48,"ن",2,0],["لي في بغداد ونهضتها","حق قد ضاع وأنشده",49,"د",2,0],["لي فيك يا بلداً حراً نزلت به","بالخل خل وَبالندمان ندمان",50,"ن",1,0],["لي في أَمر الأحكام كلا","مٌ من حذري لا أُورده",51,"د",2,0],["لي في مَديحِكَ يا رَسولُ عَرائِسٌ","تُيِّمنَ فيكَ وَشاقَهُنَّ جَلاءُ",52,"ا",2,0],["لِي فِيكِ مِنْ جِهَةِ المَنَارَةِ مَعْهَدٌ","ذَهَبَ الصِّبَا وسنَاه مِلْءُ سَوَادِي",53,"د",2,0],["لِيَ فِي مِصْرَ مَا أَشَاءُ مِنَ الْطَّيِّبِ","وَفِي بَعَلْبَكَ مَا هُوَ أَطْيَبْ",54,"ب",1,0],["لي فِيكَ مِنْ غُرَرِ المَدِيحِ شَوَاردٌ","أَدَّتْ حُقُوقَ عُلاَكَ كُلَّ أَدَاءِ",55,"ا",2,0],["لِي فِي ثَرَاهُ دَفِينَةٌ","كَالكَنْزِ في الْمُستَوْدَعِ",56,"ع",1,0],["لِيَفْخَرْ بِغَالِي دُرِّهِ كُلُّ كَاتِبٍ","وَيَجْأَرْ بِعَالِي صَوْتِهِ كُلُّ مُنْشِدِ",57,"د",1,0],["لِي فِي الْحَيَاةِ مُرَادٌ","وَأَنْ أَرَاكُمْ مُرَادِي",58,"ي",1,0],["لى فيك عند المنحنى وعقيقه","ذكرى تطوف بالجنون وتستقى",59,"ق",2,0],["لي في قرار الكاس بعد بقيةٌ","سمحت بها الآلمُ للعوّادِ",60,"د",1,0],["لي في رُبُوعك وَقْفَةٌ","أشْهَى إلي من الوِصَال",61,"ل",1,0],["لي فيك يا ليل آهاتٌ أرددها","أُواه لو أجدت المحزون أُواه",62,"ا",2,0],["لي في حمى ذاك الضريح لبانة","إن أصبحت لبنى أنا ابن ذريح",63,"ح",1,0],["لي في العراق عصابةٌ لولاهمُ","ما كان محبوباً الىّ عراقُ",64,"ق",1,0],["لي فيكُمُ قَمرٌ يُهيُّجني له","ان البِعادَ يَروعُنى بخُسوفه",65,"ف",2,0],["لي فيك صوغٌ للبلاغة لو خلا","جيدُ الفتاة لزانها منسوقه",66,"ق",2,0],["لي في الحياة أمانٍ لو جَهَرتُ بها","قُوبلتُ من سَفْسطيَّاتٍ بضوضاء",67,"ا",2,0],["لي فيك آمال وصدق عزائم","لا بد تنشر طيَّها الأزمان",68,"ن",1,0],["لِيفينّ، في صَمتهِ، ناسكٌ،","إذا افتنّ، فيمايقول، الورى",69,"ر",2,0]]}