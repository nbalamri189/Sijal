{"poems":[[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[87,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[87,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem63723.html","الكامل"],[51,"إلى كم إذا ما غبت ترجى سلامتي","https://www.aldiwan.net/poem10830.html","الطويل"],[107,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[113,"ويوم طوينا أبرديه بروضة","https://www.aldiwan.net/poem16502.html","الطويل"],[154,"بحمد الله يفتتح الكلام","https://www.aldiwan.net/poem68494.html","الوافر"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[190,"سألت عن العمى قوما ظرافا","https://www.aldiwan.net/poem43644.html","الوافر"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[422,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[572,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[580,"ألا أيها الملك المشتري","https://www.aldiwan.net/poem3025.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83279","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86859","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48834","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70927","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59722","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100955","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124737","الطويل"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123683","الوافر"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137923",""],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120696","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132723","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74035","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62761","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48278","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127022","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103577","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113825","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120210","الوافر"],[5598,"فوانيس السماء","https://www.poetsgate.com/ViewPoem.aspx?id=213905",""],[6093,"تَزيدُ قناعتيْ حِيْناً فحيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177693",""]],"verses":[["وَمَن أَولى بِكُم مِنّي وَليّاً","وَفي أَيديكُمُ طَرَفُ اِنتِسابي",0,"ب",2,0],["وَمَنْ أَوْجَد الْكَوْنَ اخْتِرَاعاً وَلَمْ يَكُنْ","مِثَالٌ لَهُ يُحْذَى عَلَيْهِ وَلاَ رَسْمُ",1,"م",1,0],["ومنا وقمبيز إلى إسكندر","فالقيصرين فذى الحلال صلاح",2,"ح",1,0],["وَمِنا وَقِمبيزٌ إِلى إِسكَندَرٍ","فَالقَيصَرَينِ فِذى الجَلالِ صَلاحِ",3,"ح",1,0],["وَمَن أَوطَأَتهُ نَفسُهُ حاجَةً فَقَد","أَساءَت إِلَيهِ نَفسُهُ وَأَلامَتِ",4,"ت",1,0],["ومَن أولَى من الهادِي بِحُبِّ","وأجدرُ من عشيرتِهِ بِقُربِ",5,"ب",1,0],["وَمِنْ أُولِي حَزْمٍ أَدَارُوا بِهِ","مَرَافِقَ الدُّنْيَا عَلى مِحْوَرِ",6,"ر",1,0],["وَمِنْ أُولِي عِلْمٍ أَفَاضُوا هُدى","عَلى النُّهى مِنْ نُورِهِ الأَزْهَرِ",6,"ر",1,0],["وَمِن أَوجه الغُر الخَرائد قَد بَدَت","بُدور وَمِن تِلكَ الغَدائر أَحلاك",7,"ك",1,0],["ومن أولى بذاك الحمد منه","وأنعمه مضاعفةٌ جسامُ",8,"م",1,0],["وَمن أُولَئِكَ إِذ يُعزى أُبُوَّتُهُ","فَلَيسَ يُدرَكُ في فَضلٍ وَلا حَسَبِ",9,"ب",1,0],["ومن أوما إلى التعليم منهم","فقد جمع الوضاعة والرقاعه",10,"ع",2,0],["وَمِن أوجه كيوان يهوي مسلّماً","لِمَنصبه الأسنى ومنسبه الأربى",11,"ب",2,0],["ومَن آوى إليه وحلَّ منه","بأكرم ما تحلُّ به الوفود",12,"د",1,0],["ومن أَوْلَى بِتقرِيظ","يَ ممن كُنْتُ خرِّيجَهْ",13,"ج",2,0],["ومن أَوْسَعَ الخَلْقَ من فضْلِه","وجادَ عليهم بِأَفضاله",14,"ل",2,0],["وَمَن أَوضَحوا لِلحائِرينَ مَحَجَّةً","فَساروا بِهِم في العَيشِ نَهجاً مُقَوِّما",15,"م",2,0],["وَمِن أوروبا رَوى عَنهُ النَسيم لَنا","قَبل اللقا أَحسن المَسموع مِن خَبره",16,"ر",2,0],["ومن أوقد النيران في الحيِّ عامداً","فقد بات للنيران وهو وقود",17,"د",1,0],["ومنْ أَوْلَى المروءةَ ضعفَ رأىٍ","رآه آذَنْته بالسلاخ",18,"خ",1,0],["ومنا وجوهٌ في الوغى ناصرية","إذا طلعت فالفجر راق طُلوعا",19,"ع",2,0],["ومن أوجد اللّه الوجود لأجله","وشرفّه منه بأكرم بعثه",20,"ه",1,0],["ومن أوفى بعهدك من فؤاد","أذاب القلبُ منه ما أذابا",21,"ب",2,0],["ومن أوفى بعهدك من محب","أجبتِ العاذلات وما أجابا",21,"ب",2,0],["ومن أولج الجرذان في الدبر عامداً","فقد باءَ مذموماً بوزر ومأثمِ",22,"م",1,0],["ومن أولاك مكرمة ومنا","وصير جنتي بنعيم قربك",23,"ك",1,0],["ومن أولى بهِ منها وفيها ال","فخار أقام والشرف أستقرا",24,"ر",2,0],["ومن أولي العلم من رأى","أن ليس لسفّاكها مثابُ",25,"ب",1,0],["ومن اول الاشياء ومن ذو نبوة","وآدم بين الطين والماء ذى القطر",26,"ر",1,0],["ومن أوروبا استلبوا معظم ما","قد فنح الإسلام في أيامه",27,"م",2,0],["وَمناوئين تقصَّدوكَ وأدركوا","أَنَّ التَعرُّضَ للأُسود غُرورُ",28,"ر",1,0],["ومن أوالِهم فكّ الأسارَى","وعن أزواجِهم أعطى البُعولا",29,"ل",2,0],["ومَنْ أوْفَى بعهْدٍ منك يا مَنْ","تَعاهِدُنا مَكارمُهُ عِهادا",30,"د",2,0],["ومن أوجد اللّه الوجود باسره","بهم وهم للعالمين ثمال",31,"ل",1,0],["ومن أوهمته غير ذاك ظنونُه","فثمَّ مجالٌ للمقال وميدان",32,"ن",1,0],["ومن أوقافها الغلات تأتي","من المتصدقين لها وصولا",33,"ل",2,0],["ومن اولى بضبط الامر منه","واوفى في سياسته جداره",34,"ر",2,0],["ومن أودع النفس ذل البقاء","وسا ق الرّياح بأمر السحا ب",35,"ب",1,0],["18. وَ مِنْ أوصَافِهم سَفَهٌ رَعَاعٌ","يُعَادُونَ الخِيَارَ النَّاصِحِينَا",36,"ن",2,0]]}