{"poems":[[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"سيشكر رب الناس ما قد فعلته","https://www.aldiwan.net/poem62975.html","الطويل"],[87,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[71,"كرهت وضوءا من قناة تساق من","https://www.aldiwan.net/poem28933.html","الطويل"],[107,"إليها بالأماني الكبار","https://www.aldiwan.net/poem43405.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85501","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85515","المتدارك"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[234,"إذا حان من شمس النهار غروب","https://www.aldiwan.net/poem51242.html","الطويل"],[285,"صروف المنايا ليس يودي قتيلها","https://www.aldiwan.net/poem60761.html","الطويل"],[287,"إلى الملك المهيمن نستغيث","https://www.aldiwan.net/poem32839.html","الوافر"],[310,"قمر محيا المجد عنه مسفر","https://www.aldiwan.net/poem56511.html","الكامل"],[310,"هناء به الأيام تمحى وتنسخ","https://www.aldiwan.net/poem56580.html","الطويل"],[398,"سيشهد أبناء المفاخر كلهم","https://www.aldiwan.net/poem53507.html","البسيط"],[287,"","https://poetry.dctabudhabi.ae/diwan/poem/69875","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89538","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100888","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85264","الوافر"],[4775,"الوشاية","https://www.poetsgate.com/ViewPoem.aspx?id=175226",""],[4831,"ولادة حلم","https://www.poetsgate.com/ViewPoem.aspx?id=208009",""],[3591,"أهلاًٍ بطلعة وجهك المتهلّل","https://www.poetsgate.com/ViewPoem.aspx?id=149437",""],[5131,"أَيضحكُ مأسورٌ نعمْ ويكبّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=55360",""],[5273,"سِفْرُ الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=180938",""],[5273,"صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=183084",""],[5720,"لأجلكَ أُستاذي","https://www.poetsgate.com/ViewPoem.aspx?id=199596",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5952,"سيرٌ إلى اللا أمام","https://www.poetsgate.com/ViewPoem.aspx?id=212589",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""]],"verses":[["سيشفع الحور فيك أنك من","هنَّ بذاك الدلال والحورِ",0,"ر",1,0],["سيشكر ربُّ الناس ما قد فعلتَهُ","بنا بادئاً والربُّ للبرّ أشكرُ",1,"ر",1,1],["سَيَشُدُّ أَزرَكَ وَالشَدائِدُ جُمَّةٌ","وَيُعِزُّ نَصرَكَ وَالخُطوبُ جِسامُ",2,"م",1,0],["سيشرقُ في يومِ الحسابِ ندامةٌ","كما شرقَتْ صدرُ القناةِ منَ الدمِ",3,"م",1,0],["سَيَشكُرُهُ الخَليفَةُ حُسنَ رَأيٍ","تَبَلَّجَ منك عَن حُسنِ اِختِيارِ",4,"ر",1,0],["سيشكر الصنع أَرواحُ الجدود لكم","وَتشكر الصنع في أَجداثها الرمم",5,"م",1,0],["سيشكر ما للمجمع القوم من يد","كَما شكرت أَرض على الوابل المُزنا",6,"ن",2,0],["سيشق الشعر عصا قوم","وَيقيم الشعب ويقعده",7,"د",2,0],["سَيُشْوِي الفَتَى بَعْضُ أَوْجَالِهِ","ويَفْجَعُهُ بَعْضُ مَا قَدْ أَمِنْ",8,"ن",1,0],["سِيشيلُ منه رَأتْ هَصوراً يَزْدَرِي","ألمَ الإِسَارِ وقَسْوَةَ الأصْفَأد",9,"د",1,0],["سيَشْفِين داءَ العبد بالقرب عاجلاً","ويَعْلَمْنَ أنّا بالنجاح نئوب",10,"ب",1,0],["سَيشْرُفُ فِي دارِ الْحِسابِ مَقامُها","وَيَبْرُدُ فِي ظلِّ الْجِنانِ مَقِيلُها",11,"ل",3,0],["سَيَشهَدُ في المَعادِ لَهُ الكِتابُ ال","عَزيزُ بِأَن تَلاهُ وَالحَديثُ",12,"ث",1,0],["سَيشيدُ بُنيانَ المعارفِ مثل ما","قَد شادهُ الجدّ الجليل الأشهرُ",13,"ر",1,0],["سَيشكرُ مرعى سعيهِ كلّ رائدٍ","إِذا أَصبحت منه الأباطيُّ تنضحُ",14,"ح",1,0],["سَيَشهَدُ أَبناءُ المَفاخِر كُلُّهُم","بِأَنَّ مَضيعَ الأَكرَمين مُضَيَّعُ",15,"ع",1,1],["سَيَشقى الظالِمونَ بِهِ وَيُسقى ال","وُلاةُ المُؤمِنونَ السَلسَبيلا",16,"ل",2,0],["سيشكرُ سيفَكَ الإسلامُ عنها","وإن أبتِ الغلاصمُ والشئون",17,"ن",1,0],["سَيَشكُرُ البَيتُ ما أَحيَيتَ من سُنَنٍ","وَيَشكُرُ العَدلَ حُجّاجٌ وَعُمّارُ",18,"ر",1,0],["سيشرق نور الله منها فلا تقل","له الفضل عن أم القرى ولها الفخر",19,"ر",1,0],["سيشفيك اخلاص الطبيب لتنبرى","اليه فإن تسقم شفتك ذوابله",20,"ل",2,0],["سيشد أزرك خاطباً أو ضارباً","ويكون ردأك مصعداً ومصوبا",21,"ب",2,0],["سيشكر فضله من كان حرّاً","ولكن أين أحرار الرجالي",22,"ل",2,0],["سيشي لي التاريخ أن قصائدي","حور وأن ملامحي لا تُجهلُ",23,"ل",1,1],["سيشي لي التاريخ أنك قاتل","كم ذا قتلت وذا فؤادك أعزل",23,"ل",1,0],["سيشرقُ الشَّوقُ الذي تغرّب َ","ويُولَدُ الحُلْمُ الذي نَنْتَِظرُ",24,"ر",1,0],["سيشيع ذكري بعد طيب لقائكم","ويشمّ منه الناس طيب المندل",25,"ل",1,0],["سيشرقُ نورُ الحق في جنباتكم","ويبزغُ في الأوطان عهدٌ مظفَّر",26,"ر",1,0],["سَيُشَيِّعُ النّهرُ الضّفافَ بِصَمْتِهِ","وتَلوكُ أشلاءَ الشَّجاعةِ مَقبَرَهْ",27,"ر",2,0],["سيشتاقُ القصيدةَ نبضُ قلبٍ","ويبحثُ عنْ هوىً في الصّدرِ غافِ",28,"ف",1,0],["سيشهدُ هذا الصرحُ أنَّكَ قُدْتَه","إلى جودةٍ طالتْ به منزلَ السما",29,"م",2,0],["سيشهدُ الصبحُ لا ليلٌ ليعقبَهُ","أنَّ المساءاتِ فيها جُلُّها كَذبُ",30,"ب",1,0],["سيشرب شعبُ (الإماراتِ) مُرَّاً","ويخرج شعب (الكويتِ) مُضاما",31,"م",2,0],["سيشدّ الكرّةَ البِكْرَ غَدٌ","سيروّي السّلّةَ النَّشْوى حُسامْ",32,"م",1,0]]}