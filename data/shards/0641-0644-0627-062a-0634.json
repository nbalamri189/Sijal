{"poems":[[55,"عقيد العلى لا زلت تستعبد العلى","https://www.aldiwan.net/poem30455.html","الطويل"],[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[55,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[65,"بني مطر إن الخطوب تهون","https://www.aldiwan.net/poem45948.html","الطويل"],[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[73,"صلاح الدين يا خير البرايا","https://www.aldiwan.net/poem3926.html","الوافر"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[53,"أخالقي رب ورب رازقي","https://www.aldiwan.net/poem65696.html","الرجز"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[93,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[45,"أحسن ما يخضب الحديد به","https://www.aldiwan.net/poem9457.html","المنسرح"],[64,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[47,"حثثنا سيرنا لما مررنا","https://www.aldiwan.net/poem65619.html","الوافر"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[52,"أباهل إني للحروب عواد","https://www.aldiwan.net/poem63892.html","الطويل"],[48,"لقد جاءنا هذا الشتاء وتحته","https://www.aldiwan.net/poem22239.html","الطويل"],[48,"كأنما الأجساد إن فارقت","https://www.aldiwan.net/poem22370.html","السريع"],[48,"خصاؤك خير من زواجك حرة","https://www.aldiwan.net/poem22821.html","الطويل"],[48,"أزول وليس في الخلاق شك","https://www.aldiwan.net/poem23073.html","الوافر"],[48,"نصحتك لا تقدم على فعل سوءة","https://www.aldiwan.net/poem23370.html","الطويل"],[48,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[47,"حَثَثْنَا سَيرَنَا لَمّا مَرَرْنا","https://www.poetsgate.com/ViewPoem.aspx?id=32105",""],[141,"ألا أبلغ أبا عثمان","https://www.aldiwan.net/poem67973.html","مجزوء الوافر"],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[168,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[185,"أمصعب قد نجوت من الأعادى","https://www.aldiwan.net/poem59094.html","الوافر"],[287,"ونحوي تكلم في أقاح","https://www.aldiwan.net/poem32799.html","الوافر"],[308,"قلبي مشغوف بمن قد نأى","https://www.aldiwan.net/poem58188.html","السريع"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[371,"وإني إذا استغربت يوما من الأسى","https://www.aldiwan.net/poem17756.html","الطويل"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[382,"عد الدهر حتى انقض كوكبه الدري","https://www.aldiwan.net/poem59424.html","الطويل"],[422,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[454,"صباحك عيد مشرف","https://www.aldiwan.net/poem974.html",""],[592,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96993","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122326","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96628","الطويل"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74134","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109087","المنسرح"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137864",""],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132834","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67915","الطويل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140235",""],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124784","الطويل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131703",""],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82953","المنسرح"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65967","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100341","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58410","المجتث"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100813","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89235","المتقارب"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108373",""],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21512","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125820","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94473","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58164","الوافر"],[4690,"أمْنيات أسيرة","https://www.poetsgate.com/ViewPoem.aspx?id=120284",""],[4884,"طفلة الحي","https://www.poetsgate.com/ViewPoem.aspx?id=210420",""],[4955,"سيدنو الموت منا ذات يوم","https://www.poetsgate.com/ViewPoem.aspx?id=188782",""],[4955,"لنا الله عند اشتداد الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=202205",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"أمريم في الأقصى وأنت الممانعُ","https://www.poetsgate.com/ViewPoem.aspx?id=190318",""],[5459,"هَذِي الجِنان ..","https://www.poetsgate.com/ViewPoem.aspx?id=200767",""],[5582,"تَوَلَّى الشَّبابُ وَقَدْ أَدْبَرا","https://www.poetsgate.com/ViewPoem.aspx?id=187104",""],[5595,"نعلّمُ جيلنا الكتبا","https://www.poetsgate.com/ViewPoem.aspx?id=158559",""],[5674,"أنت وإن تباعدنا الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=189084",""],[5725,"اتصبوا في غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=178278",""],[5776,"لوحةٌ رسَمَها دمُ الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199919",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[5309,"إذا طال حب المرء طال اكتئابه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573864",""]],"verses":[["فَلا تُشمِتَنَّ الحاسِدينَ فَسِرُّهُم","يَشِفُّ لِظَنّي مِن وَراءِ أُمورِ",0,"ر",1,0],["فَلا تَشمَخَن يا اِبنَ أُمِّ الضَلالِ","بِجَدّي وَجَدتَ مِنَ النارِ بَردا",1,"د",2,0],["فَلا تَشمَتوا إِن يَثلِمِ الدَهرُ جانِبي","فَأَكثَرُ مِمّا مَرَّ مِنّي بَقَيَّتي",2,"ت",2,0],["فَلا تُشْرِبُوا حُبَّ الثَّراءِ قُلوبَكُمْ","فَكُلٌّ عَلَيْهِ لِلْزَّمانِ عُيونُ",3,"ن",1,0],["فَلا تَشتَكِنَّ إِلَيَّ الوَجى","وَطولَ السُرى وَاِجعَليهِ اِصطِبارا",4,"ر",2,0],["فَلا تَشهَد بِصَفعانٍ قِتالاً","فَقَوسُ الندفِ لا تُصمي الرَمايا",5,"ا",3,0],["فلا تشمتوا وليخسإ المرءُ منكُمُ","بوجهٍ كأَنَّ اللون منه اليَرَنْدَجُ",6,"ج",1,0],["فلا تشوِّه خلَّتي خلائقي","ولا يُعوِّج طمعي طرائقي",7,"ي",1,0],["فَلا تُشتَرى إِلّا بِرِنجٍ سِباؤُها","بَناتُ المَخاضِ شومُها وَحِضارُها",8,"ر",3,0],["فَلا تَشمَتي مِنّي فَلَستُ بِمَأمَنٍ","وَلا تَزهَدي فيهِ فَلَيسَ بِهِ زُهدُ",9,"د",1,0],["فَلا تَشينَنهُ بِالنُضارِ فَما","يَجتَمِعُ الماءُ فيهِ وَالذَهَبُ",10,"ب",1,0],["فلا تُشعرنّي عزةَ اليأسِ إِنَّما","أمامي وراءٌ والوراءُ أمامُ",11,"م",1,0],["فلا تَشْمتِ الأعداءُ بالطَوْدِ مائِداً","وقد رسختْ أركانُه والقواعِدُ",12,"د",1,0],["فَلا تُشلَل فَنِعمَ أَخو النَدامى","وَساقي فَضلَةِ الزِقِّ المُذالِ",13,"ل",1,0],["فلا تَشْمَخِ الدّنْيا عليّ بقَدْرِها","فإنّي بأيام المُعزّ لأَشمَخ",14,"خ",1,0],["فَلا تَشتَرِ الزِنجِيَّ إِنَّكَ مُفلِحٌ","بِأَحمَرَ فَالزِنجِيُّ عَنكَ عَتادُ",15,"د",1,0],["فَلا تَشهِرنَ سَيفاً لِتَطلُبَ دَولَةً","فَأَفضَلُ ما نِلتَ اليَسيرُ المُرَوَّجُ",16,"ج",1,0],["فَلا تَشُبُّ الحَربَ وَقّادَةً","فَخامِدٌ في نَفسِهِ مَن يَشُبّ",17,"ب",1,0],["فَلا تُشهِدَنَّ فيهِ الشُهودَ وَأَلقِهِ","إِلَيهِم وَعُد كَالعائِرِ المُتَشَمِّسِ",18,"س",1,0],["فَلا تَشقوا بِنَصرِكُمُ أَميراً","كَما شَقِيَت بِهِ كَلبٌ وَعَكُّ",19,"ك",1,0],["فَلا تَشرَبنَها ما حَيِيتَ وَإِن تَمِل","إِلى الغَيِّ فَاِشرَبها بِغَيرِ نَديمِ",20,"م",1,0],["فَلا تُشبِهِ الوَحشيَّ خَلَّفَ طِفلَهُ","لِخَنساءَ تَرعى بِالمَغيبِ طَلاهُ",21,"ل",3,0],["فلا تُشلَلْ، فنِعمَ أخُو النّدامَى،","وَسَاقي فَضْلَةِ الزّقّ المُذَلِ",22,"ل",1,0],["فَلا تُشمِت بِيَ الأَعدا","ءَ وَالجيرانَ مُلتَهِفا",23,"ف",2,0],["فلا تُشغَلا عنه بلثمِ حَبابهِ","تظنَّنهِ ثغرا عليه تبدَّدا",24,"د",2,0],["فَلا تُشعِري لَذعَ المَلامِ فُؤادَهُ","فَإِنَّكِ مِمَّن رُعتِ بِاللَومِ أَلوَمُ",25,"م",1,0],["فلا تَشلَل يداهُ ولا تَزالا","تُفيَدانِ الغَنائمَ والجَزيلا",26,"ل",2,0],["فَلا تَشلَل يَدٌ فَتَكَت بِهِ إِذ","رَأَينا كَفَّ لَيثٍ صَكَّ قِردا",27,"د",2,0],["فلا تشبب لي في حاضرٍ","فليس يغنيني عن النائي",28,"ي",1,0],["فلا تَشْكُرْ نَداهُمْ بعدَ هذا","كَفاهُ ما أَصابَ من النَّوال",29,"ل",1,0],["فَلا تُشمِتَنَّ الدَهرَ بِالدَمعِ إِن جَرى","فَيَعلَمَ أَنَّ الهَمَّ في القَلبِ قَد جَرَح",30,"ح",1,0],["فلا تشك ربعاً رسمُه فيه مُشرِفٌ","ولا تبك إلفاً وسمُه فيه أشرف",31,"ف",1,0],["فلا تشك من بلوى الزمان عدواةً","فإنك فخرٌ والعداوة في الفخر",32,"ر",1,0],["فلا تُشْمِتَنَّ بي الحاسدين","فتطمع فيَّ العدوَّ المشوما",33,"م",2,0],["فلا تشمت الخصم اللدود بأمة","لوجهك منها ركع وسجود",34,"د",1,0],["فلا تشرك بربك قط شيئاً","فإن الله جل عن المثال",35,"ل",1,0],["فلا تشمت الحساد في فقد ذاهب","فللَه فينا حجة غير ذاهب",36,"ب",1,0],["فلا تشمت اليوم العدا بمصابنا","لعل غدا يأتي لهم فيه مثله",37,"ل",2,0],["فَلا تشبهن يوماً به بشراً وهل","يُقاس خضمٌّ زاخرٌ بالضحاضحِ",38,"ح",1,0],["فَلا تُشمِت الحسّادَ شدَّةُ حالَتي","فَإِنّي جَوادٌ لا يشدُّ عنانُهُ",39,"ه",1,1],["فلا تشارك من قبل إن تزنا","طبعك تأمن وتمنع الغُبُنا",40,"ا",1,0],["فلا تشهدوني ساعة المدح انني","رأيت بي الاولى مقالي لا ادري",41,"ر",2,0],["فلا تشكُ أحداثَ الزمانِ فإنَّني","أراه بَمن يشَكو حَوَادثَه مُغرّى",42,"ر",2,0],["فلا تَشمَتوا فالقومُ من يبقَ منهمُ","على سَننٍ منهم مقامَ المخلِّفِ",43,"ف",1,0],["فلا تشغلنكم زهرة في حياتكم","بني الدين فالدنيا جمال مقبح",44,"ح",1,0],["فلا تشتغل إلا بما يكسب العلا","ولا ترضى للنفس النفيسة بالردي",45,"د",2,0],["فلا تشكي الظلامه","في الحب واستلزم الصوم",46,"م",1,0],["فَلا تُشاوِرهُمُ فليسَ لهُم","على شَحيحٍ بدينِه شفَقَه",47,"ق",2,0],["فلا تشمتوا الأعداء بالحق بعدما","أذعنا له نصراً على كل خائف",48,"ف",1,0],["فلا تشم زهو روضٍ للمنى أنفٍ","او أن تشمَّ فتجني الروضة الأنفا",49,"ف",2,0],["فلا تَشِقْ عند نَصبٍ","في الجَرِّ قَطُّ بِغَيري",50,"ر",2,0],["فلا تشرئب الى نيلها","وتنسى من الغي أخطارها",51,"ر",3,0],["فلا تشمئزي له بالحياة","ولا تفرحين به إن نُعي",52,"ع",2,0],["فلا تشمتوا بي يالئام تنبهوا","فلا بد يوماً ان يقوم دفين",53,"ن",1,0],["فَلا تَشتُمَنّا يابنَ حَربٍ فَإِنَّما","تُرَقّى إِلى تِلكَ الأُمورِ الأَشائِمُ",54,"م",1,0],["فَلا تَشكُ أَمركَ بَعدُ إِليّا","فَإِنَّكَ أَبَغَضُ رَبٍّ لَدَيَّا",55,"ي",2,0],["فلا تَشكُ مما قد دهاك فإنهُ","ضميرُك قد القاكَ في القيد ماسورا",56,"ر",2,0],["فلا تشمتي العذّال في من تجاهرت","تناديك بالإعلان أنتِ خدينتي",57,"ي",1,0],["فلا تُشمتْ بنا الأعداءَ يوماً","فنحن المحسنون الصابرونا",58,"ن",2,0],["فلا تَشْكُ منِّيَ يا لائِمي","فُؤادُكَ للصّفْحِ قدْ مَهّدا",59,"د",2,0],["فلا تشكو الهوى أَلماً","بموتِ الحبِّ ما انفعلتْ",60,"ت",1,0],["فلا تشغل فؤادكَ كيفَ تحيا","بها فالعمرُ يزهقهُ الفناءُ",61,"ا",2,0],["فلاتشتكِ الحالَ إلا إليهِ","ولاترجُ عبدًا طوالَ الزَّمنْ",62,"ن",1,0],["فلا تشمت الأعداء لا بدّ أنها","تعود كما فارقتها لي مغانيا",63,"ي",2,0],["فلا تشرك بربك قط شيئاً","وسر في أثر أزكى العالمينا",64,"ن",2,0],["فلا تشرك بربك قط شيئاً","وأخلص في العبادة والفعال",65,"ل",1,0],["فلا تشتكي من ظلم من يحكمونهم","وحبك محفوظ وفجرك ناصع",66,"ع",1,0],["فلا تشِحْ ناظِريكَ عنها إلى","مَنابتِ الشوكِ والخَلاَ السَّمِجِ",67,"ج",1,0],["فَلا تُشْبِهَنَّ بِهِ حاتِماً","سَماحاً وَلا فِي الوَغَى عَنْتَرا",68,"ر",2,0],["فلا تَشمتْ بنا يوماً","لأنّا ثورةٌ وإبا",69,"ب",2,0],["فلا تَشْفى الجِراحُ ولا وِصالٌ","ولا أملٌ مِنَ المَنفى يَؤوبُ",70,"ب",1,0],["فلاتشكو الغرام وانت صبٌّ","به قرح ومانفع الطبيبُ",71,"ب",1,0],["فلا تُشعلُ النيران إلا قلوب من","بها حَطَبُ الأحقادِ نالَ ذبالا",72,"ل",2,0],["فلا تشكو الظلام وقد تبدى","بقلب سواده فجر أطلا",73,"ل",2,0],["فَلا تَشكُ أَوهاماً أَطالَت زِيارَةً","فَما لَطَّفَ الضَّيفَ الثَّقيلَ ذَهابُهُ",74,"ب",2,0]]}