{"poems":[[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[70,"كان البياض يروقني","https://www.aldiwan.net/poem42445.html","مجزوء الكامل"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[89,"حبذا تمثال أمامي تعالى","https://www.aldiwan.net/poem44741.html","الخفيف"],[85,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[105,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[48,"أيها القادم من بص","https://www.aldiwan.net/poem62415.html","مجزوء الرمل"],[46,"الله أكبر ما اشتريت بضاعة","https://www.aldiwan.net/poem22414.html","الكامل"],[15,"يا ذا المخوفنا بقت","https://www.aldiwan.net/poem45242.html","مجزوء الكامل"],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85348","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[138,"ولقد صدنا غزالا سانحا","https://www.aldiwan.net/poem68024.html","الرمل"],[182,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[262,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[262,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[299,"أيسرها أني أموت بدائي","https://www.aldiwan.net/poem36314.html","عموديه"],[366,"لو كان عباس هنالك حاضرا","https://www.aldiwan.net/poem44507.html","الكامل"],[372,"أنكروها غواية من رشيد","https://www.aldiwan.net/poem57504.html","الخفيف"],[378,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[406,"أقرب الناس بالكرام بعيد","https://www.aldiwan.net/poem49978.html","الخفيف"],[417,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[433,"يا حافظا علقت بذي","https://www.aldiwan.net/poem12413.html","مجزوء الكامل"],[433,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[494,"ولقد صحبت الدهر صحبة عارف","https://www.aldiwan.net/poem67381.html","الطويل"],[552,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[552,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[559,"كنت بالأمس عند نفسي كثيفا","https://www.aldiwan.net/poem34352.html","الخفيف"],[563,"العلم فوق المال في إرشاده","https://www.aldiwan.net/poem52802.html","الكامل"],[576,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["وَلَقَد صَدَقتُكِ في الهَوى وَكَذَبتِني","وَخَلَبتِني بِمَواعِدٍ لا تَنفَعُ",0,"ع",1,0],["وَلَقَد صَكَكتُ بَني الفَدَوكَسِ صَكَّةً","فَلَقوا كَما لَقِيَ القُرَيدُ الأَصلَعُ",0,"ع",1,0],["ولقد صدقتَ وما كذبتَ فإنهُ","لا يُدفَع المعروف بالإنكارِ",1,"ر",1,0],["وَلَقَد صَحَوتُ وَتُبتُ عَن","خَمرِ الهَوى وَكَسَرتُ دَنّي",2,"ن",2,0],["ولقد صارعت الخطوب الى ان","اطفأت منك كوكبا ذا ائتلاق",3,"ق",1,0],["ولقد صاغوا الشعر قبلك من لفظ","ووزن وصغته من حديد",3,"د",1,0],["ولقد صح ما تمناه قبلا","بعد ان كان في الرؤوس خيالا",4,"ل",2,0],["وَلَقَد صَدَقتُم هَذِهِ الأَرضَ الهَوى","وَالحُرُّ يَصدُقُ في هَوى أَوطانِهِ",5,"ن",2,0],["وَلَقَد صَبَرتُ عَلى صَديقٍ فاسِدٍ","ناهيكَ مِن نَكسٍ وَمِن إِتعاسِ",6,"س",1,0],["ولقد صَحِبْتُ العَيشَ مَرْضِيَّ الهَوى","في ظِلِّها الأَوفَى خليعَ الصَّاحبِ",7,"ب",1,0],["ولقد صبرتَ تخوضُ من أهوالهِ","ما لا يخوضُ الفارسُ المُتلبِّبُ",8,"ب",1,0],["وَلَقَد صَبَرتَ عَن المُسي","ءِ وَعَن مُكايَلَةِ المُكايِل",9,"ل",1,0],["وَلَقَد صِرتُ ما تَرينَ فَإِن كا","نَ حِماماً يا شَرُّ هَذا الَّذي بي",10,"ب",2,0],["وَلَقَد صُبَّ عَلى أَع","لاهُ ماءُ الحُسنِ صَبّا",11,"ب",2,0],["وَلَقَد صَفِرتَ مِنَ الثَلاثِ كَأَنَّما","أَدَمٌ حَواكَ مِنَ الخُلوِّ مَسادُ",12,"د",1,0],["وَلَقَد صَلَقنا هَوازِناً","بِنَواهِلٍ حَتّى اِرتَوَينا",13,"ن",2,0],["ولقد صَرَفْتُ لحُبّه كُلّي على","يَدِ حُسْنِهِ فحمِدْتُ حُسْنَ تصرّفي",14,"ف",2,0],["ولقد صحتُ للمضاضة أبغي","لي مجيراً وأين مني المجير",15,"ر",1,0],["ولقد صاح الخاطئون يريدو","ن نصيراً لهم وعزَّ النصير",15,"ر",1,0],["وَلَقَد صبرت عَلى الأمور تعسرت","فإذا العَسير هناك غير عَسيرِ",16,"ر",1,1],["وَلَقَد صُنتُهُ وَأَمسَكتُ عَن كُت","تابِهِ خَوفَ أَن يُعانَ دَؤوبا",17,"ب",2,0],["ولقد صدرتُ وليس بي ظَمَأٌ","للهِ ذاكَ الوِردُ والصَّدَر",18,"ر",1,0],["وَلَقَد صِدنا غَزالاً سانِحاً","فَأَرَدنا ذَبحَهُ لَمّا سَنَح",19,"ح",1,1],["ولقد صَحِبتُكِ لو جَزَيتش مَوَدَّةً","وخَلائقاً لَيسَت بذَاتِ غوَائلِ",20,"ل",1,0],["ولقد صح انما يرحم الرحمن","منا عباده الراحمينا",21,"ن",2,0],["ولقد صدني واصداء فكري","عن قوافي القريض هذا الزمان",22,"ن",1,0],["ولقد صبرتُ وما صبرتُ لسلوةٍ","بل صبر صادٍ عن قراحِ الماءِ",23,"ا",2,0],["ولقد صَبَحتُ بها عُمارةَ غُدوةً","والبِيضُ تعلو فوقه بالمنشرِ",24,"ر",1,0],["ولقد صيِّر الوفاء من الغد","رِ فكان الوفاءُ غدرَ الجودِ",25,"د",1,0],["ولقد صدعت عليك قلباً شيَّقاً","ناهيك من قلبٍ عليك يُصدَّع",26,"ع",1,0],["ولقد صُمتُ عن لقائكَ أُسبو","عاً وبعدَ الصِّيامِ فِطْرٌ وَعِيدُ",27,"د",1,0],["ولقد صَحَوْتُ من الشباب وسكره","ونظرت للدنيا بعَيْنَيْ زاهد",28,"د",1,0],["ولقد صبرتُ لصرفِه","ظنًّا بأَنَّ الصَّبْرَ نافِعْ",29,"ع",1,0],["ولقد صحبْتُ الليلَ قلّصَ بُردَه","لعُبابِ بحرِ صباحه المتموّجِ",30,"ج",1,0],["وَلَقَد صَحِبتُ الدَهرَ صُحبَةَ عارِفٍ","مَتَعَوِّدٍ لِصَلاحِهِ وَفَسادِهِ",31,"د",2,1],["ولقد صحبتُ العيشَ مصطبراً","سلوَان لا يسطيعني الغَزَلُ",32,"ل",1,0],["ولقد صحوتُ من الهوى وسلوته","أيّامَ ريعان الشّباب مُفارقي",33,"ق",2,0],["ولقد صرت واحداً وكثيراً","ولقد جئت بالجميع لفيفا",34,"ف",2,0],["ولقد صبرتُ على البَلادِ ومَطامعي","ترجو بَياضَ الحظِّ بعد سَوَادِهِ",35,"د",2,0],["ولقد صُمتُ نَائِباً عنكَ ذَا الشَّه","رَ وقَصْدِي في أَنْ أَصُومَ وتُؤْجَر",36,"ر",1,0]]}