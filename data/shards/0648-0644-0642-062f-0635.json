{"poems":[[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[53,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[72,"كان البياض يروقني","https://www.aldiwan.net/poem42445.html","مجزوء الكامل"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[91,"حبذا تمثال أمامي تعالى","https://www.aldiwan.net/poem44741.html","الخفيف"],[87,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[63,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[107,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[54,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[50,"أيها القادم من بص","https://www.aldiwan.net/poem62415.html","مجزوء الرمل"],[48,"الله أكبر ما اشتريت بضاعة","https://www.aldiwan.net/poem22414.html","الكامل"],[15,"يا ذا المخوفنا بقت","https://www.aldiwan.net/poem45242.html","مجزوء الكامل"],[70,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85348","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[92,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[141,"ولقد صدنا غزالا سانحا","https://www.aldiwan.net/poem68024.html","الرمل"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[266,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[266,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[303,"أيسرها أني أموت بدائي","https://www.aldiwan.net/poem36314.html","عموديه"],[370,"لو كان عباس هنالك حاضرا","https://www.aldiwan.net/poem44507.html","الكامل"],[376,"أنكروها غواية من رشيد","https://www.aldiwan.net/poem57504.html","الخفيف"],[382,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[411,"أقرب الناس بالكرام بعيد","https://www.aldiwan.net/poem49978.html","الخفيف"],[422,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[438,"يا حافظا علقت بذي","https://www.aldiwan.net/poem12413.html","مجزوء الكامل"],[438,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[498,"ولقد صحبت الدهر صحبة عارف","https://www.aldiwan.net/poem67381.html","الطويل"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[556,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[563,"كنت بالأمس عند نفسي كثيفا","https://www.aldiwan.net/poem34352.html","الخفيف"],[567,"العلم فوق المال في إرشاده","https://www.aldiwan.net/poem52802.html","الكامل"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87138","الكامل"],[772,"","https://poetry.dctabudhabi.ae/diwan/poem/26613","الكامل"],[438,"","https://poetry.dctabudhabi.ae/diwan/poem/58919","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48770","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216947","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216878","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64792","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118139","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49977","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141357","الكامل"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130221","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114796","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69387","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69384","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109331","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28518","الكامل"],[2488,"","https://poetry.dctabudhabi.ae/diwan/poem/31476","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137369",""],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68665","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205425","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146356","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100288","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113700","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100728","الكامل"],[3306,"","https://poetry.dctabudhabi.ae/diwan/poem/147795",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91487","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91275","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131059",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111399","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125899","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94595","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28675","الكامل"],[4954,"دعْني أنوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=208896",""],[585,"هل في العراق من الرفاق مواس","https://www.poetsgate.com/ViewPoem.aspx?id=161918",""],[5213,"هذا العذيب فأين سرب رئامه","https://www.poetsgate.com/ViewPoem.aspx?id=170537",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5358,"النهار الممطر","https://www.poetsgate.com/ViewPoem.aspx?id=32852",""],[5358,"زينب","https://www.poetsgate.com/ViewPoem.aspx?id=211959",""],[5587,"قَلْبِي عَلِيلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190229",""],[5970,"غالبتني في لذة العيش نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=130587",""],[6018,"أياذا الفضائل واللام حاء","https://www.poetsgate.com/ViewPoem.aspx?id=181192",""],[6089,"عجبي للعقولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212942",""],[6093,"سكون مسكون","https://www.poetsgate.com/ViewPoem.aspx?id=193402",""]],"verses":[["وَلَقَد صَدَقتُكِ في الهَوى وَكَذَبتِني","وَخَلَبتِني بِمَواعِدٍ لا تَنفَعُ",0,"ع",1,0],["وَلَقَد صَكَكتُ بَني الفَدَوكَسِ صَكَّةً","فَلَقوا كَما لَقِيَ القُرَيدُ الأَصلَعُ",0,"ع",1,0],["ولقد صدقتَ وما كذبتَ فإنهُ","لا يُدفَع المعروف بالإنكارِ",1,"ر",1,0],["وَلَقَد صَحَوتُ وَتُبتُ عَن","خَمرِ الهَوى وَكَسَرتُ دَنّي",2,"ن",2,0],["ولقد صارعت الخطوب الى ان","اطفأت منك كوكبا ذا ائتلاق",3,"ق",1,0],["ولقد صاغوا الشعر قبلك من لفظ","ووزن وصغته من حديد",3,"د",1,0],["ولقد صح ما تمناه قبلا","بعد ان كان في الرؤوس خيالا",4,"ل",2,0],["وَلَقَد صَدَقتُم هَذِهِ الأَرضَ الهَوى","وَالحُرُّ يَصدُقُ في هَوى أَوطانِهِ",5,"ن",2,0],["وَلَقَد صَبَرتُ عَلى صَديقٍ فاسِدٍ","ناهيكَ مِن نَكسٍ وَمِن إِتعاسِ",6,"س",1,0],["ولقد صَحِبْتُ العَيشَ مَرْضِيَّ الهَوى","في ظِلِّها الأَوفَى خليعَ الصَّاحبِ",7,"ب",1,0],["ولقد صبرتَ تخوضُ من أهوالهِ","ما لا يخوضُ الفارسُ المُتلبِّبُ",8,"ب",1,0],["وَلَقَد صَبَرتَ عَن المُسي","ءِ وَعَن مُكايَلَةِ المُكايِل",9,"ل",1,0],["وَلَقَد صِرتُ ما تَرينَ فَإِن كا","نَ حِماماً يا شَرُّ هَذا الَّذي بي",10,"ب",2,0],["وَلَقَد صُبَّ عَلى أَع","لاهُ ماءُ الحُسنِ صَبّا",11,"ب",2,0],["وَلَقَد صَفِرتَ مِنَ الثَلاثِ كَأَنَّما","أَدَمٌ حَواكَ مِنَ الخُلوِّ مَسادُ",12,"د",1,0],["وَلَقَد صَلَقنا هَوازِناً","بِنَواهِلٍ حَتّى اِرتَوَينا",13,"ن",2,0],["ولقد صَرَفْتُ لحُبّه كُلّي على","يَدِ حُسْنِهِ فحمِدْتُ حُسْنَ تصرّفي",14,"ف",2,0],["ولقد صحتُ للمضاضة أبغي","لي مجيراً وأين مني المجير",15,"ر",1,0],["ولقد صاح الخاطئون يريدو","ن نصيراً لهم وعزَّ النصير",15,"ر",1,0],["وَلَقَد صبرت عَلى الأمور تعسرت","فإذا العَسير هناك غير عَسيرِ",16,"ر",1,1],["وَلَقَد صُنتُهُ وَأَمسَكتُ عَن كُت","تابِهِ خَوفَ أَن يُعانَ دَؤوبا",17,"ب",2,0],["ولقد صدرتُ وليس بي ظَمَأٌ","للهِ ذاكَ الوِردُ والصَّدَر",18,"ر",1,0],["وَلَقَد صِدنا غَزالاً سانِحاً","فَأَرَدنا ذَبحَهُ لَمّا سَنَح",19,"ح",1,1],["ولقد صَحِبتُكِ لو جَزَيتش مَوَدَّةً","وخَلائقاً لَيسَت بذَاتِ غوَائلِ",20,"ل",1,0],["ولقد صح انما يرحم الرحمن","منا عباده الراحمينا",21,"ن",2,0],["ولقد صدني واصداء فكري","عن قوافي القريض هذا الزمان",22,"ن",1,0],["ولقد صبرتُ وما صبرتُ لسلوةٍ","بل صبر صادٍ عن قراحِ الماءِ",23,"ا",2,0],["ولقد صَبَحتُ بها عُمارةَ غُدوةً","والبِيضُ تعلو فوقه بالمنشرِ",24,"ر",1,0],["ولقد صيِّر الوفاء من الغد","رِ فكان الوفاءُ غدرَ الجودِ",25,"د",1,0],["ولقد صدعت عليك قلباً شيَّقاً","ناهيك من قلبٍ عليك يُصدَّع",26,"ع",1,0],["ولقد صُمتُ عن لقائكَ أُسبو","عاً وبعدَ الصِّيامِ فِطْرٌ وَعِيدُ",27,"د",1,0],["ولقد صَحَوْتُ من الشباب وسكره","ونظرت للدنيا بعَيْنَيْ زاهد",28,"د",1,0],["ولقد صبرتُ لصرفِه","ظنًّا بأَنَّ الصَّبْرَ نافِعْ",29,"ع",1,0],["ولقد صحبْتُ الليلَ قلّصَ بُردَه","لعُبابِ بحرِ صباحه المتموّجِ",30,"ج",1,0],["وَلَقَد صَحِبتُ الدَهرَ صُحبَةَ عارِفٍ","مَتَعَوِّدٍ لِصَلاحِهِ وَفَسادِهِ",31,"د",2,1],["ولقد صحبتُ العيشَ مصطبراً","سلوَان لا يسطيعني الغَزَلُ",32,"ل",1,0],["ولقد صحوتُ من الهوى وسلوته","أيّامَ ريعان الشّباب مُفارقي",33,"ق",2,0],["ولقد صرت واحداً وكثيراً","ولقد جئت بالجميع لفيفا",34,"ف",2,0],["ولقد صبرتُ على البَلادِ ومَطامعي","ترجو بَياضَ الحظِّ بعد سَوَادِهِ",35,"د",2,0],["ولقد صُمتُ نَائِباً عنكَ ذَا الشَّه","رَ وقَصْدِي في أَنْ أَصُومَ وتُؤْجَر",36,"ر",1,0],["وَلَقَد صَفحنا عَن ذُنوب أَثقَلَت","ظَهر الحَوادث وَالزَمان الجاني",37,"ن",2,0],["وَلَقَد صَدَدتُ عَنَ الغَنيمَةِ حَرمَلاً","وَبَغيتُهُ لَدَداً وَخَيلي تُطرَدُ",38,"د",1,1],["ولقد صحبتَ الصِيْدَ يسمعُ فيهُمُ الت","فضيلَ مما قلت والتفصيلُ",39,"ل",1,0],["ولقد صدقت سريرة وعزيمة","وتأهباً للملك واستعدادا",40,"د",2,0],["ولقدْ صمَمْنَ فما يجْبن مُؤيّها","ولقد نَحِلْنَ من القيادِ على الوجَى",41,"ا",1,0],["ولقد صببْنَ على تَنُوخٍ صَبّةً","فَجزيْنَهُمْ يوماً بيومِ قُحادِ",42,"د",1,0],["وَلقد صحبت الدهر أغيد مُقبلاً","وَصَحبتهُ من بعد أشمط أشيبا",43,"ب",2,0],["ولقد صبرت لعلني","ألقى جزاء الصابرينا",44,"ن",2,0],["ولقد صَبَرْتُ وكانَ قُرْبُكَ مُنْتَهى","أَمَلي وخَيْرُ الأَجْرِ أَجْرُ الصَّابِرِ",45,"ر",1,0],["ولقد صفحت عن الزمان بليلةٍ","عل الحبيب بها وجاد الساقي",46,"ق",2,0],["ولقد صبحت الدَّهرَ في حالاته","وطعمت منها شهدَها ومرارَها",47,"ا",1,0],["ولقد صغته ليعليه نورا","وضياء هيبة وأصاله",48,"ل",2,0],["ولقد صرخت وما الصراخ بنافعٍ","ما دام ذو الإخلاص صنو الغادر",49,"ر",1,0],["ولقد صَبْرتُ لنَبْوَةٍ صَادَيْتُها","مِمَّنْ يُلاَقِينِي بخَدٍ أصْعَرِ",50,"ر",1,0],["ولقد صَددت الكأسَ فانقَبضَت بِها","من بَعدِ ما انبسَطت يمينُ السّاقي",51,"ق",2,0],["وَلَقَد صَحِبتُ العَيشَ قَبلَكَ أَسوَداً","وَصَحِبتُهُ لَمّا صَحِبتُكَ أَبيَضا",52,"ض",2,0],["وَلَقَد صَحِبتُ فَما صَحِبتُ مُذَمَّما","وَلَقَد سَأَلتُ فَما سَأَلتُ بَخيلا",53,"ل",2,0],["ولقد صدقت فما البكا","عند المصاب من النباله",54,"ل",2,0],["وَلَقَد صَبَرتُ وَكُلُّ صَبرٍ نِعمَةٌ","إِلّا إِذا سَرَّ العِدى أَن أَصبرا",55,"ر",2,0],["وَلَقَد صَبَرتُ عَلى السَمومِ يَكُنُّني","قَرِدٌ عَلى الليتَينِ غَيرُ مُرَجَّلِ",56,"ل",1,0],["ولقد صبرت على الغرام وحكمه","حتى أرى ليل الصدود قد انجلى",57,"ل",2,0],["ولقد صار آية لأناسٍ","بعده في شريعة وحقيقه",58,"ق",2,0],["ولقد صحبت الدهر في أطواره","وشرعت في بحر الحياة الطامي",59,"م",2,0],["ولقد صَحِبت الليل يسحبُ مِسْحَه","والجوّ خَصْرٌ والنّجوم نِطاق",60,"ق",1,0],["ولقد صبرت وعدت فيك إلى الهوى","لولا الهوى ما اعتاد لي استحواذ",61,"ذ",1,0],["ولقد صحبتُ العزَّ مذ أنا يافعٌ","فهو الشَّباب على الشبابِ أتاني",62,"ي",1,1],["ولقد صدقتك في المديح وللورى","شعراء أكثر شعرهم مكذوب",63,"ب",1,0],["ولقد صرفت، عن الديار، وما","طبي بمقليةٍ، ولا صرمِ",64,"م",1,0],["وَلَقَد صَحا كُلُّ الصحابِ عن الهَوى","إِلا فُؤادي والِهٌ سهّار",65,"ر",1,0],["وَلَقد صَحَوتُ عَن الهَوى لَكنني","لبقيةٍ في النَفس لَم أَتحنَّف",66,"ف",1,0],["ولقد صبا قلبي إلي","ك وفيه حبك قد تسطر",67,"ر",1,0],["ولَقَد صَحِبتُ بما مضى صِيداً أَشَ","دَّ وقد رَعَوا لي حُرمَةً وشُؤُونا",68,"ن",2,0],["ولقد صافحته باسمة","فوجدت الكف منه توعد",69,"د",1,0],["ولقد صفا وقتي بصافي قهوةٍ","فاقت بأنوار الحباب الجوهرا",70,"ر",2,0],["وَلقَد صَنَعتَ إِلَيَّ في","ما فاتَ ما لا أَكفُرُه",71,"ر",2,0],["ولقدْ صبتْ نفْسي لها وعِناقها","لكنْ عِناقي بِا