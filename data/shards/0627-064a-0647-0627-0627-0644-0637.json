9","الرمل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82891","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205840","عدة أبحر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205775","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205774","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203480","الخفيف"],[2950,"","https://poetry.dctabudhabi.ae/diwan/poem/141819","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112501","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74057","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138646",""],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202340","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131074",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33315","الخفيف"],[5057,"زارني في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=198052",""],[2365,"أيها الطالب أجمل واقتصد","https://www.poetsgate.com/ViewPoem.aspx?id=200664",""],[5459,"غرور الجهل","https://www.poetsgate.com/ViewPoem.aspx?id=201107",""],[3856,"كَسَرَابٍ فِي أعيُنِ الظَّامِئينَا","https://www.poetsgate.com/ViewPoem.aspx?id=215914",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""]],"verses":[["أَيُّها الطالِبُ الَّذي قَلقَلَ العي","سَ وَأَبلى غُروضَها وَالوِراكا",0,"ك",2,0],["أَيُّها الطالبُ شَمساً","لِلوَرى تَطلُعُ لَيلا",1,"ل",2,1],["أيها الطاهر السريرة والسي","رة والقائل البديع المقال",2,"ل",1,0],["أيها الطائر المُرَجّع فوق الغص","ن هل أنت نائح أم شاد",3,"د",1,0],["أيُّها الطائر المغرِّد في الأيْ","ك قصيدي يبذُّ حسناً قصيدَكْ",4,"ك",1,0],["أيها الطالب الندى غير آلٍ","بيِّن الَحمل مُفصح الإركاض",5,"ض",1,0],["أيها الطالبون خيراً وشرّاً","إن شوكاً فيها وإن عذوقا",6,"ق",2,0],["أَيُّها الطينُ لَستَ أَنقى وَأَسمى","مِن تُرابٍ تَدوسُ أَو تَتَوَسَّد",7,"د",1,0],["أَيُّها الطَّائرُ الكئيبُ تَغَرَّدْ","إنَّ شَدْوَ الطُّيورِ حلوٌ رَخِيمُهْ",8,"م",2,0],["ايها الطيف الذي","زارني من ارسلك",9,"ك",1,0],["أيها الطائر المريد فما تق","در نفس عما يريد فكاكا",10,"ك",2,0],["أَيُّها الطالِبُ لِلعِلمِ اِستَمِع","خَيرَ ما في طَلَبِ العِلمِ جُمِع",11,"ع",1,0],["أَيُّها الطالِبُ الطَويلُ عَناؤُه","تَرتَجي شَأوَ مَن يَفوتُكَ شاؤُه",12,"ا",3,1],["أَيُّها الطالِبُ الكَثيرَ لِيَغنى","كُلُّ مَن يَطلُبُ الكَثيرَ فَقيرُ",13,"ر",1,0],["أيها الطائرُ عنّي","طرتَ عمَّن لن يخونك",14,"ك",1,0],["أيّها الطاعمُ الكَرى ملءَ جَفنَي","ك وجفني من الكرى غيرُ طاعم",15,"م",1,0],["أيها الطالبُ صدقاً","قدْ طلبْتَ المستحيلا",16,"ل",2,0],["أَيُّها الطارِقُ الَّذي قَد عَناني","بَعدَما نامَ سامِرُ الرُكبانِ",17,"ن",1,1],["أيها الطالب إنصافا لقد رمت محالا","أنت مثلي عاطش غرك إذ أبصرت آلا",18,"ل",2,1],["أَيُّها الطِفلُ لَكَ البُشرى فَقَد","قَدَّرَ اللَهُ لَنا أَن نُنشَرا",19,"ر",2,1],["أَيُّها الطِفلُ لا تَخَف عَنَتَ الدَه","ر وَلا تَخشَ عادِياتِ اللَيالي",20,"ل",2,1],["أيها الطائرُ الذي ألِفَ الروضَ","مقاماً وجاورَ الأنهارا",21,"ر",2,1],["أيّها الطالبُ علماً","إيت حماد بن زيد",22,"د",1,1],["أَيُّهَا الطَّيْرُ ضَنَّ مَاءُ الْقَوافِي","فَبذَلْنَا دُمُوعَنَا الهَتَّانَهْ",23,"ن",2,0],["أيها الطارقُ الجديدُ، سلامًا","أَسْأَلُ الصفح إن أسأتُ لقاءك",24,"ك",1,0],["أيها الطائرُ المحلق نحسًا","أنت أحدثْتَ في الوجود انقلابا",25,"ب",2,0],["أيها الطير المحلق غادياً","تحمل سلامي لا تذرني مناديا",26,"د",3,1],["أيها الطالبُ مرمى سهمه","ليس في الإمكان يا هذا لحاقْ",27,"ق",1,0],["أيها الطفلُ لا تضيعْ زماناً","لستَ تلقى كمثلهِ أمثالا",28,"ل",2,0],["أيها الطرف لاعدمتك لا","تجفل فكم ها هنا أغارت خيول",29,"ل",1,0],["أَيُّها الطَيرُ في لِحاظِكَ وَهجٌ","مِن حَبيبي وَحَيرَةٌ وَذُبولُ",30,"ل",1,0],["أَيُّها الطائرُ الغَبِيُّ تَعلَّم","ذا جزاءُ الأَغرارِ وَالجُهلاءِ",31,"ا",2,0],["أيّها الطارق الغريب تمهّل","إنّ عهدَ الأيّام غير وثيق",32,"ق",1,0],["أَيُّها الطالِب البَديع اغتَنِمها","واجن مِنه أَزهار فَصلِ الرَبيع",33,"ع",1,0],["أيُّها الطاهر الزكيّ أغِثْنا","وأنِلْنا الإسعاف والإسعادا",34,"د",2,0],["أيها الطالب النجاة أتاكا","قول حق فخل عنك الهلاكا",35,"ك",2,1],["أيها الطلعة التي أخذتنا","بسناها عنا وقد أعدمتنا",36,"ن",2,1],["أَيُّها الطالِبون لن تَلْحقُوه","إِنَّ مَا تطلبُونَ لا يَستَتِبُّ",37,"ب",1,0],["أيُّها الطّالبُِ مَرمَى أحمَدٍ","أينَ جَريُ الخَيلِ مِن جَري البِغالِ",38,"ل",1,0],["أيها الطفلُ كُن فتىً عبقريًّا","واحيَ في قُطرك العزيزِ حسيبا",39,"ب",2,0],["أيها الطائر الحبي","س ترنم كما تشاء",40,"ا",2,1],["أيّها الطودُ الأشمُّ الر","ركن والبحر الخضمُّ",41,"م",1,0],["أيُّها الطَّائِرُ المُغَرِّدُ في الدَّا","رِ صَباحاً كعادَةِ الأطْيارِ",42,"ر",1,0],["أيها الطفلُ المدلُّ بنفسهِ","ليس البداية كالنهاية فينا",43,"ن",2,1],["أيُّها الطيّبون معقدَ أزرٍ","لكم اللهُ شدَّ بالنصر أزرا",44,"ر",2,0],["أيها الطائر الخفيّ تمثلْ","لفؤادي وخلِّ عنك النِّفارا",45,"ر",2,0],["أَيها الطيرُ بلِّغي سَحَراً","لأَخيه الأستاذ ما وجبا",46,"ب",2,0],["أيّها الطّامعون في الأرض إن ال","أرض ليست لكم ولا للغزاة",47,"ه",1,0],["ايها الطالب المجد رويدا","عن قريب تنال بالجد قبرا",48,"ر",2,0],["أيُّها الطالِبُونَ للعلمِ جُودُوا","كيفَ لم يَرعَكُم قريضٌ رَعاني",49,"ن",2,0],["أيها الطود كيف ضمك لحد","ومحال تعلو الرواسي رباها",50,"ا",3,0],["أَيُّها الطالب الحسين أَلا اَرْبَع","أَنتَ لَم تبلغ النَعيم المُقيما",51,"م",2,0],["أَيُّها الطالب حُلو العَيش قَد","خِلتَ حُلواً سائِغاً ما هُوَ مُرُّ",52,"ر",1,0],["أَيُّها الطَّالِبُ الحَريصُ تَعلَّم","إِن لِلحَقِّ مَذهَباً قد ضللته",53,"ت",2,1],["أيها الطائر في مسري المنى","عد إلى مغناك في الظلّ الظليل",54,"ل",1,0],["أيها الطائر المحلق في الجو","وسلام عليك فوق المطار",55,"ر",1,0],["أيها الطالب الطموح إلى المج","د تقدم دنياك دار الجهاد",56,"د",1,0],["أيها الطفل أنت من قبل أن تن","زل للأرض قد خلقت سعيدا",57,"د",2,1],["أيها الطارقون في الأسحار","أصبحونا، فالعيش في الابتكار",58,"ر",1,1],["أيها الطير إلي الموت فقد","صمّت الآذان عن كل شج",59,"ج",1,0],["أَيُّها الطائِر المحلّق في الجو","وِ تَخَطّى الرؤوس وَالأعناقا",60,"ق",2,0],["أيها الطالب للرشد الا","أزمع الهادي عن الدنيا ارتحالا",61,"ل",2,0],["أيها الطالب الغنى زره تظفر","بعطاء يخجل الأنواء",62,"ا",2,0],["أيها الطامعون في الربح مهلا","إن للطامعين صفقة خاسر",63,"ر",1,0],["أيها الطرفُ كم حذِر","تَ فلم ينفعِ الحَذَر",64,"ر",1,1],["أيها الطيفُ والصباحُ قريبٌ","ليت ذا الليلَ كان قربكَ شهرَا",65,"ر",2,0],["أيها الطالب أجمل واقتصد","وأرح نفسك من جهد وكد",66,"د",1,1],["أيّها الطفلُ خُطَّ في السّبّورَهْ","أحْرُفًا .. أو قصيدةً..أو صُورَه ..",67,"ر",2,1],["أيُّها الطَّامِحُ المُبَلَّل بالشَّكِّ:","متى أمطَرَت سماكَ ظُنونا؟",68,"ن",2,0],["أيها الطير لاتحاول فُتاتاً","إنّ من يطلب الفتات سيُغلبْ",69,"ب",1,0],["أيها الطير مازمانكَ ريشٌ","فاخلع الريش وانتعلْ حدَّ مخلبْ",69,"ب",1,0]]}