{"poems":[[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[29,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[47,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[54,"شجاك الحي إذ بانوا","https://www.aldiwan.net/poem26661.html","الهزج"],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[47,"شَطَّ مِنْ ساكِنِ الغُوَيْرِ مَزَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31263",""],[203,"ألا أيها القلب لا تيأس","https://www.aldiwan.net/poem45602.html","المتقارب"],[224,"كما ضرب اليعسوب أن عاف باقر","https://www.aldiwan.net/poem2028.html","عموديه"],[275,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[302,"لو أبانت حجابها أسماء","https://www.aldiwan.net/poem33339.html","الخفيف"],[303,"خلف الأسى كبدي","https://www.aldiwan.net/poem36805.html","عموديه"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[469,"خان الشباب ومال الدهر وانحرفا","https://www.aldiwan.net/poem3423.html","عموديه"],[469,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[591,"إن تبدوا أو تثنوا","https://www.aldiwan.net/poem17813.html","مجزوء الرمل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26682","الطويل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74991","الخفيف"],[2019,"","https://poetry.dctabudhabi.ae/diwan/poem/177966","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18024","الرجز"],[2370,"","https://poetry.dctabudhabi.ae/diwan/poem/121520","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65113","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108033","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36359","الدوبيت"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94329","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4830,"بقايا الصَّبْر","https://www.poetsgate.com/ViewPoem.aspx?id=201200",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5431,"العراق -انتفاضة الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=207055",""],[5701,"عجبت لصورة فيها سعود","https://www.poetsgate.com/ViewPoem.aspx?id=164677",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""]],"verses":[["كَم أَضاءَ البَرقُ لي مِن مَعهَدٍ","ذابَ دَمعُ العَينِ فيهِ وَجَمَد",0,"د",1,0],["كَما ضَرَبَت في مِعصَمٍ حارِثِيَّةٌ","يَمانِيَّةٌ بِالوَشمِ باقٍ نُؤورُها",1,"ر",3,0],["كما ضحِكَ البغلُ لوَّى الزيا","رُ جحْفَلةً منْه لم تهشش",2,"ش",1,0],["كما ضحك البغل المزيَّر إذ لوى","جحافلَهُ بيْطارُهُ غيرَ مُغتبط",3,"ط",1,0],["كَم أَضافوا خَليفَةً فيهِ فَخماً","وَأَميراً ضَخماً يُخافُ حِوارُه",4,"ر",2,0],["كَما ضَمَّ غَريقٌ سا","بِحاً وَالماءُ طَوفانُ",5,"ن",1,0],["كما ضاحكٍ في يومه","يبكي غدًا ملءَ المحاجر",6,"ر",1,0],["كَمْ أضَافُوا خَليفَةً فيهِ فَخماً،","وَأميراً ضَخماً، يخابُ حِوَارُهْ",7,"ر",2,0],["كما ضيعَ العقلُ أهلَ العقولِ","بينَ المدامةِ والأكؤسِ",8,"س",1,0],["كما ضُرِبَ الْيَعْسُوب أَنْ عافَ باقِرٌ","وما ذَنْبُهُ أن عافَتِ الماءَ باقرُ",9,"ر",1,1],["كما ضاعتِ القبلاتُ في نحرِ غادةٍ","غرورٍ كأمواجِ البحارِ كذوب",10,"ب",1,0],["كَم أَضَلَّت وكَم هَدت من أُناسٍ","وَلِكُلٍّ فيما أرته اِرتياءُ",11,"ا",2,0],["كَمْ أَضمُّها كأَبٍ","مشفقٍ عَلَى وَلَدِ",12,"د",1,0],["كما ضل أقوام بها وتخبطوا","ومالوا عن الدين القويم وشرعة",13,"ه",1,0],["كم أضمرُ الوجدَ والأجفانُ تظهره","وأسترُ البرح منه حلَّ فانكشفا",14,"ف",2,0],["كم أضرمتْ نار الحمام وغادرتْ","عمراً خراباً دون ملكٍ عامر",15,"ر",1,0],["كَمْ أَضلُّوني بِشَعْرٍ","وَهَدُوني بِجَبينِ",16,"ن",1,0],["كم أضلت منا عقولاً وكم أو","جب نقصاً لفاضلٍ إعجابُه",17,"ب",2,0],["كَم أَضرَمَت نار التَنَمرد قَبلَها","لايك إِبراهيم بِالإِيقاد",18,"د",1,0],["كما ضاعَ من أهدابِ ثَوبك نَشرُهُ","وكلٍّ صعيد مسَّ وطؤكَ طيب",19,"ب",1,0],["كَم أَضل الإله قوما وَلا يظلم","في الحكم من أَضل فَتيلا",20,"ل",2,0],["كما ضرم النيران ادمان مشعل","طفته بغير الماء قدماً ثواقبه",21,"ب",2,0],["كَما ضَرَبناكُم عَلى تَنزيلِهِ","ضَرباً يُزيلُ الهامَ عَن مَقيلِهِ",22,"ل",2,0],["كما ضاع قمبين لا بد أن","يضيعوا ولا بد أن يرغموا",23,"م",3,0],["كم أضمرُ الوجد عن واشيه مُستترا","والدّمعُ يُبرزُهُ في حال مُفتضح",24,"ح",1,0],["كم اضاءت لي على ذات الأضا","ليلة كان منيراً بدرها",25,"ه",2,0],["كما ضربَتْ وشماً يدا بارقِيّةٍ","بنَجرانَ أقْرَتْهُ ظهورَ المعاصمِ",26,"م",1,0],["كم أضاعوا بالكذب وقتاً وأغلى","ما أضاعت يداك وقت ضاعا",27,"ع",2,0],["كَما ضاءَت فِعالُ ذَوي المَعالي","هُم القاداتُ غُر أَتقِياء",28,"ا",2,0],["كَم أُضرِعُ دونَها غَراماً خَدّي","كَم يجبهُني حاجِبُها بِالرَدِّ",29,"د",1,1],["كم أضرموا حولي سعير فسادهم","وأنا السمندل لن يضرّ سَعيرُ",30,"ر",1,0],["كَم آَضتِ الأَنضاءُ في مَسرَحِهِ","بُدناً وَكَم آلت بهِ إلى أَلى",31,"ا",1,0],["كم أضرمتْ حُرُقُ النّوائبِ خافقي","والثاكلاتُ بجانبَيَّ رماحُ",32,"ح",1,0],["كم أضمرت لبني الهادي ضغائنها","وأظهرت بدع الأحكام في السنن",33,"ن",1,0],["كما ضربة السيّاف إمّا تصادمت","صلاخدَ هاماتٍ تئنُ وتجفلُ",34,"ل",1,0],["كما ضم العروبة فهي تأوي","إلى كنفي مناها والأمان",35,"ن",1,0],["كم اضعنا عمرنا في","ربّما كيف وليس",36,"س",1,0]]}