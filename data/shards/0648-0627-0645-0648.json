{"poems":[[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[45,"مغاني الشعب طيبا في المغاني","https://www.aldiwan.net/poem10596.html","الوافر"],[47,"لك في المجد أول وأخير","https://www.aldiwan.net/poem63574.html","الخفيف"],[47,"فؤادي منك ملآن","https://www.aldiwan.net/poem66687.html","الهزج"],[63,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[17,"اسلم سلمت ولا سليم على البلى","https://www.aldiwan.net/poem1194.html",""],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141034",""],[47,"فُؤَادِي منكَ مَلآنُ","https://www.poetsgate.com/ViewPoem.aspx?id=31865",""],[193,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[309,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[356,"الجهل ليل ليس فيه نور","https://www.aldiwan.net/poem68984.html","الكامل"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[382,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[382,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[385,"ظبي على ملك الجمال استحوذا","https://www.aldiwan.net/poem48768.html","الكامل"],[396,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[409,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[438,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[443,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[445,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[563,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[563,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101529","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101467","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54172","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48684","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70922","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59680","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59119","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96642","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102302","الرمل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87745","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76081","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100715","الطويل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106035","الكامل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125990","الطويل"],[3293,"","https://poetry.dctabudhabi.ae/diwan/poem/146473","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216563",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118777","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91111","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138049","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136941",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28631","الخفيف"],[5013,"نعى الدين والدنيا فعم ظلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170966",""],[5030,"لا تبعدي","https://www.poetsgate.com/ViewPoem.aspx?id=215657",""],[5038,"سل الحدباء","https://www.poetsgate.com/ViewPoem.aspx?id=190191",""],[5039,"نوايا العطر","https://www.poetsgate.com/ViewPoem.aspx?id=48140",""],[5145,"أعينا فؤادي على ما يعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108214",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[5387,"الدوامة","https://www.poetsgate.com/ViewPoem.aspx?id=53793",""],[5442,"نوى ولو أن الفعل وافق ما نوى","https://www.poetsgate.com/ViewPoem.aspx?id=114765",""],[5453,"تصوري","https://www.poetsgate.com/ViewPoem.aspx?id=28013",""],[5453,"أم(بك)وت","https://www.poetsgate.com/ViewPoem.aspx?id=28016",""],[5573,"شمس عمري","https://www.poetsgate.com/ViewPoem.aspx?id=200341",""],[5582,"شَرَعَ الحُبُّ لَهُ ما شَرَعا","https://www.poetsgate.com/ViewPoem.aspx?id=63529",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[243,"رثاء القطيع","https://www.poetsgate.com/ViewPoem.aspx?id=50482",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[5841,"اموت انا بالقاف لا منك نطقتي به","https://www.poetsgate.com/ViewPoem.aspx?id=37038",""],[6070,"دوامُ البقاءِ بربي محالْ","https://www.poetsgate.com/ViewPoem.aspx?id=188867",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""],[6300,"أنا يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81626&r=&rc=3",""]],"verses":[["وأموالٌ تَخوَّنَها هُزالٌ","تُبَدَّدُ دونَ أعْراضٍ سِمانِ",0,"ن",1,0],["وأمُّوهُ من أقصى البلاد تقرُّباً","وما زال منك السعد يدني الأقاصيا",1,"ي",2,0],["وأُمورٍ تيسّرت وأُمورٍ","بالمفاتيح منك والأسبابِ",2,"ب",1,0],["وَأَمواهٌ تَصِلُّ بِها حَصاها","صَليلَ الحَليِ في أَيدي الغَواني",3,"ن",2,0],["وَأُمورُ الدُنيا تُنَفِّذُها بِالدي","نِ مُذ صُيِّرَت إِلَيكَ الأُمورُ",4,"ر",1,0],["وَأَموالُكَ لَلحَمدِ ال","لَذي يُؤثَرُ أَثمانُ",5,"ن",1,0],["وأَمواهٌ لو أنَّ التُّربَ يَشكو","مجَاورةَ الأَذى يوماً شَكاها",6,"ا",3,0],["وأُمورُ دُنيا ما لَوَتْ يدَ طالبٍ","لَبقٍ ولا ضَاقتْ على مُتوسِّعِ",7,"ع",1,0],["وَأَموتُ أُخرى بَعدَها وَلَأَعلَمَن","إِن كانَ يَنفَعُ أَنَّني سَأَموتُ",8,"ت",1,0],["وأمواهٌ يصلّ بها حصاها","صليل الحلي في أيدي الغواني",9,"ن",2,0],["وأمْوَالُكَ، للحَمْدِ ال","ذي يُؤثَرُ، أثْمَانُ",10,"ن",1,0],["وَأُموري عَلى خلافِ مُرادي","لستَ تَرضى لِلعبدِ حالاً ذميما",11,"م",2,0],["وَأَموتُ وَأَنقَضي","وَعلى النَعشِ أَرفَعُ",12,"ع",1,0],["وأمور مُلككَ كلها موزونةٌ","قد حاطها الإحكام والتجبيرُ",13,"ر",1,0],["وأموري كأنّها أَلفِاتٌ","خَطّهُنّ الوَلىُّ في الاستواء",14,"ا",2,0],["وأموتُ موتاً مُسعَداً","من عن يمينك في الحنان",15,"ن",1,0],["وأمُّوا بنا تلك الديار عشيةً","وقرّوا عيوناً باحتشاد الرغائب",16,"ب",1,0],["وَأَموت مِن عَطَشي إِلَيهِ وَقَد دَرى","ماء الحَياة بِثَغرِهِ العَطر الشَذا",17,"ذ",2,0],["وأموالك الكل يحوون","فاطلب خلاصك من الله",18,"ه",1,0],["وأمواله كانت عليه عزيزة","معظمة مدخورة للعظائم",19,"م",1,0],["وأمونٍ لا تشكّى كِلالاً","كلّما سارتْ تفوتُ الرياحا",20,"ح",2,0],["وأموا النقيب فإن الحيا","إذا راؤه بالحباء انتقب",21,"ب",1,0],["وأمواهُ وَرْدٍ فِي وُرُودِ حِياضِها","شفاءُ الظِّماءِ الهِيمِ من غُلَّةِ الخِمسِ",22,"س",1,0],["وأمواتُهم فيهم كأحياءِ غيرهم","إذا ظلَعَ المركوبُ جاء جَنيبُهُ",23,"ب",2,0],["وَأُموراً يعيينَ لِلخَلقِ لَولا","أنّني كنت في الأذى صبّارا",24,"ر",2,0],["وأموالٌ يُسَوَّقْنَ","إلى حاجةِ مُرْتادِ",25,"د",1,0],["وأمواتاً وأحياءً","ومن ربِّي بهم أعلمْ",26,"م",1,0],["وأمورنا انتظمت به","عنه فنحن قصائد",27,"د",1,0],["واموت وخزاً بالحرا","بِ ولا اميلُ الى سماك",28,"ك",1,0],["وآمونُ القريض يراك أهلاً","وأنت الكاهنُ الحبرُ العليمُ",29,"م",1,0],["وأموا جميعاً بالإذاية جانبي","على غير ذنبٍ للأذى بمحللِ",30,"ل",1,0],["وأمور مصر له يدبرها كما","يرجو لمصر ويشتهي أبناؤها",31,"ا",3,0],["وأمورٍ يظنها المرء سهلا","وهيْ مقصيَّةٌ بضرب الخياشى",32,"ش",2,0],["وأمُّوا سراعاً قبل هاجرة النوى","وحطوا بها حيث الأراك مُنعم",33,"م",1,0],["وأمور نخل لا تزال كثيرة","ما بين والدة وأخرى حاملِ",34,"ل",1,0],["وَأمَّ وَبَرْقُ الفَتْحِ يَقْتَادُ جَيْشَهُ","سَحَائِبُ نَصْرٍ تِلْوَهُنَّ سَحَائِبُ",35,"ب",1,0],["وَأمونُ السيرِ أَضحى مَركبي","في المسيرِ المتن منها والكَبِد",36,"د",1,0],["وأُمور رحمةٍ لو شَرحُها","خُطَّ في وجهِ السما ما وَسِعا",37,"ع",2,0],["وأمور الحب من أعجبها","أن ترى القاتل يهواه القتيل",38,"ل",1,0],["وأمون تبيت تسرى فتطوى","غبّ ذاك السرى إذا العيرُ قالا",39,"ل",2,0],["وأمواج البحار على اختلاف","بجنب نداه إلا كالرضاب",40,"ب",1,0],["وأموالنا مبذولة ونفوسنا","ولم نبق شيئاً منهما ما بذلناه",41,"ن",3,0],["وأمور جنت عليها خمولا","وأمور جرت إليها النآدا",42,"د",2,0],["وَأموا مِنكَ في الإِسلام لَيثاً","وَخلُّوا خَلفَهُم بقرا وَشاءا",43,"ا",3,0],["وَأَمواج يَثور بِها خِضمٌ","تَفُلُّ غُروب شاطئه الرِمال",44,"ل",1,0],["وَأُمٌ وَلودٌ هَذه الأَرضُ لا يُرى","بِها مُدَّعٍ إِلا وَيُفضَحُ خُذلانا",45,"ن",2,0],["وأموجهم لدى النعمى نوالا","اذا انتسبوا الى سمح وهوب",46,"ب",1,0],["وأموا حمى العباس يعطف عليكم","بقلب غيورٍ للتخاذل آب",47,"ب",1,0],["وأموت حزناً كلما خطرت على","قلبي حكايات الشهيد بكربلا",48,"ل",2,0],["وأمّوا بلادا رادها قبل طارق","بهم ليلة ذلّت وعزّت ثمانيا",49,"ن",3,0],["وأموت من ظمإٍ ول","كن عادة البحر العجائب",50,"ب",1,0],["وامُوْت لَي قَالَوْا وَد النَّاسْ","واحْيَا إذَا قَالَوا عَبِدْنا",51,"ن",2,0],["وام وبل ولا ولكن ولها","ايضا معانٍ بعضهم فصّلها",52,"ه",2,0],["وأموالكم للنهب صارت مباحة","وسالبها من أخذها صار في حلّ",53,"ل",1,0],["وَأَمّوا بنا داراً تناءَت وَمَعهدا","تَعالى فدون الشَمس في الأُفق أَبرُج",54,"ج",1,0],["وأمون تطوي من الشفّ","والوجد رباها طيّ الأكفّ السجلّا",55,"ل",2,0],["وَأمْوالُكُمْ فَيْءٌ لاَِلِ أُمَيّة","وَبَدْرُكُمْ قَدْ حانَ مِنْهُ أُفُولُ",56,"ل",1,0],["وأمور صرفتها عن مراميها","الجسام من غير قصدٍ ومطمع",57,"ع",1,0],["وَأمورٍ خَضَعتُ في","ها وَضَيم رَمَمتُه",58,"ت",2,0],["وأموا به من جنة الخلد روضة","فحل بها طود البلاد همامها",59,"م",3,0],["وأموتُ من عطشٍ ويبصر ناظري","نهَرًا، ولكن لا يدينِ فتغرفُ",60,"ف",1,0],["وأمْوالُ النفوطِ ثرى دِمانا","كمِ اصْطبغتْ بها الدّنْيا خِضابا",61,"ب",2,0],["وأموت إلى من شفت مشي الحياوي","رجل ٍ تهجّا الدرب وعيون ٍ تموق",62,"ق",1,0],["وأموا أجارع بطن الغضا","بحيث التقى الحزن والحرتان",63,"ن",1,0],["وأموتُ لا أرضى النجاسةَ عندها","كلا ولا يرضى العبادُ ذئابَها",64,"ب",3,0],["وأموت مثلكَ يا غريب وأنتهي","يوماً إلى تلك العظامِ أؤول",65,"ل",1,0],["وأموا حمى من أنزل الله وحيه","عليه وفي العراج عن ربه روى",66,"و",2,0],["وأموت.؟ في ليل ٍ تثني على كتوف","كن الليالي في شعرها مضيفه",67,"ف",2,0],["وأموت بك واحيا بصفوة ظلالك","يابو عيون ( ن ) تحتضن طفل الانعاس",68,"س",1,0],["وأموت مابدل خفوقي بدالك","اللي ملكت بداخله كل الأحساس",69,"س",1,0],["وَأُمُورٍ جَمَّةٍ لَو شَرْحُها","خُطَّ فِي وَجْهِ السَّما ما وَسِعَا",70,"ع",2,0],["وَأَمُونِ السَّيْرِ أَضْحَى مَرْكَبِي","فِي المَسِيرِ المَتْنُ مِنْها وَالكَتَدْ",71,"د",1,0],["وأمواجه أخلدت للسكون","فمات على ضفتيه النغم",72,"م",1,0],["واموري اللي ماهي بمستتبه","طاحت معاها للأسف كامل اقواي",73,"ا",2,0],["واموت انا لا لبستي الكعب تمشي به","دمّر حياتي وكيف كيفك تدمرني",74,"ن",2,0],["وأمواجُ بحرٍ على صخرةٍ","تلاشتْ وغابتْ كطيفِ الخيالْ",75,"ل",1,0],["وأموركم في زعمكم","تجري على قدمٍ وساق",76,"ق",1,0],["وأمواجُ الهوى رَكِبتْ جنُونِي","فذابَتْ فِي مآسيهِ وذابا",77,"ب",2,0]]}