وكفى مأربا",227,"ب",2,0],["عَفتْ مدنيَّةٌ لدمارِ شعبٍ","وديعٍ تخدُمُ الهمجَ الرَّعاعا",228,"ع",2,0],["عفيفُ يدٍ لا يَحْسَبُ الحُكمَ مَغْنّما","ولو شاء لم تَعْسُر عليه المغانم",229,"م",1,0],["عَفْواً وإنْ شطَّ المَدى عن غايتي","ونبَتْ جيادُ الشعر عن مِضماري",230,"ر",2,0],["عفواً إذا خانني شعري وتبِاني","فلُطفُكُم لا أوفِّيهِ بشُكْرانِ",231,"ن",1,1],["عفواً فلولا اضطرارُ الحالِ يُلجئني","لكنتُ أنفَسَ مذخورٍ ومكسوب",232,"ب",1,0],["عفا غيَر مرتادٍ ومرّ كسُرْ حوبٍ","ومَنُخَفِض طامٍ تنَكَّر واضْمحَلّْ",233,"ل",1,0],["عفا الله عن ليلى وإن سفكت دمي","فإني وإن لم تجزني غير عائب",234,"ب",1,1],["عَفّى عَلِيُّ بنُ إسحاقٍ، بِفَتكَتِهِ،","على غَرَائِبِ تيهٍ كُنّ للحَسَنِ",235,"ن",1,1],["عَفافٌ يَعُودُ عَلى بَدْئِهِ،","وَهَدْيٌ يَسِيرُ عَلى قَصْدِهِ",236,"د",2,0],["عِفْتُ الحَرامَ ، ولَمْ يَكُنْ مِنْ عَادَتي","فِعْلُ الحَرَامِ لَكُمْ وَكُلّ حَلاَلِ",237,"ل",1,0],["عفن الوثير إلى وسائد فضّة","ونزحن عن أهل وعن أوطان",238,"ن",1,0],["عفواً فإننا عبيدٌ إن صمدْتَ لنا","بالجدّ قاتلتَ منا غيرَ أقرانك",239,"ك",1,0],["عفَّى بإسماعيلَ في شيبانه","ما كان من حَجَّاجه وتثقيفه",240,"ف",2,0],["عفوتُ فلا أقابِلُهُ بِلَوْم","وإنْ أوسِعْتُ من لوم وعدْم",241,"م",1,0],["عفَتْ إلاَّ أياصرَ أوْ نئيَّاً","محافرهُا كأسرية ِ الإيضينِ",242,"ن",1,0],["عفتهُ رياحُ الصيفِ بعدي بمورها","واندية ُ الجوزاءِ بالوبلِ والِّيمْ",243,"م",1,0],["عفا واسطٌ من أهْله فمذانُبْهْ","فرَوْضُ القَطا: صَحْراؤهُ فَنصائِبُهْ",244,"ب",2,1],["عَفِّ المَكاسِبِ ما تُكدى حُسافَتُهُ","كَالبَحرِ يَقذِفُ بِالتَيّارِ تَيّارا",245,"ر",2,0],["عففت عن قدرة عصماء باذخة","وربّما عفّ أقوام وما قدروا",246,"ر",3,0]]}