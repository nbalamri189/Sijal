aspx?id=19805",""],[50,"عفَا بَعْدَ «سَلْمَى » حَاجرٌ فَذُنَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=17123",""],[30,"عفا الدَّحلُ منْ ميِّ فمحَّتْ منازلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=3087",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[33,"عفا الله عن ليلى وإن سفكت","https://www.poetsgate.com/ViewPoem.aspx?id=2573",""],[45,"عَفّى عَلِيُّ بنُ إسحاقٍ، بِفَتكَتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31810",""],[45,"وَجَدْنا خِلاَلَ أبي صَالِحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31616",""],[45,"رِيحُ الشَّمَالِ أَتَتْ بِرِيحِ شَمَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=32100",""],[91,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[51,"إنَّ ائتمانَكَ آفاتِ الزمانِ على","https://www.poetsgate.com/ViewPoem.aspx?id=30017",""],[51,"وقفَ الهوى بك بعد طولِ وجيفه","https://www.poetsgate.com/ViewPoem.aspx?id=29921",""],[51,"أبا العباس ما هذا التَّواني","https://www.poetsgate.com/ViewPoem.aspx?id=30511",""],[39,"أَمِنْ دِمَنٍ بِشاجِنَة ٍ الحَجُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=4310",""],[24,"أتَعرِفُ رَسْماً بين رَهْمَانَ فالرَّقَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10882&r=&rc=23",""],[29,"عفا واسطٌ من أهْله فمذانُبْهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17431&r=&rc=4",""],[20,"ماذا ترجون إِن أَودى ربيعكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69775&r=&rc=16",""],[94,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""]],"verses":[["عَفافٌ كَما شاءَ الإِلَهُ يَسُرُّني","وَإِن سيءَ مِنهُ بِكرُها وَعَرانُها",0,"ن",3,0],["عِفتُ بِها الخَمرَ وَهيَ تُجلى","وَالكَأسُ مَحطوطَةُ اللِثامِ",1,"م",1,0],["عَفٌّ فَإِن لَم يَحمِهِ ال","ضَيمَ الظُلمِ ظَلَم",2,"م",1,0],["عَفوٌ وَحِلمٌ وَنَعماءٌ وَمَقدِرَةٌ","وَمُستَجيبٌ وَمِعطاءٌ وَمُحتَمِلُ",3,"ل",1,0],["عَفُّ السَريرَةِ لَم تُلَطَّ لِريبَةٍ","يَوماً عَلَيَّ مَغالِقي وَسُجوفي",4,"ي",1,0],["عَفافِيَ مِن دونِ التَقِيَّةِ زاجِرٌ","وَصَونُكِ مِن دونِ الرَقيبِ رَقيبُ",5,"ب",1,0],["عَفَفتُ عَنِ الحِسانِ فَلَم يَرُعني","المَشيبُ وَلَم يُنَزِّقُني الشَبابُ",6,"ب",1,0],["عَفا اللَهُ عنها فهيَ روحي وإِن جَنَتْ","عليها وَمَرْجوٌّ لِذي الهَفوَةِ العَفوُ",7,"و",1,0],["عَفَتِ الدِيارَ وَباقِيَ الأَطلالِ","ريحُ الصَبا وَتَقَلُّبُ الأَحوالِ",8,"ل",1,1],["عَفا اللَهُ عَمَّن لَم يَزُرني مُوَدِّعاً","فَقَد قَرِحَت مِنهُ لِذاكَ مَدامِعُه",9,"ع",2,1],["عَفا اللَهُ عَن أُمِّ الوَليدِ أَما تَرى","مَساقِطَ حُبّي كَيفَ بي تَتَلَعَّبُ",10,"ب",1,0],["عَفا سَرِفٌ مِن أَهلِهِ فَسُراوِعُ","فَجَنبا أَريكٍ فَالتِلاعُ الدَوافِعُ",11,"ع",1,1],["عُفّوا تَعُفُّ نِساؤُكُم في المَحرَمِ","وَتَجَنَّبوا ما لا يَليقُ بِمُسلِمِ",12,"م",1,1],["عَفَتْ غيرَ سُفْعٍ كالحَمامِ جَواثِمٍ","وغيْرَ جِدارٍ مثْلِ حاشيَةِ البُرْدِ",13,"د",1,0],["عَفا غَيْرَ نُؤْيٍ كالسِّوارِ ومَوْقِدٍ","كَما جَثَمَتْ بيضُ الحَمامِ وسُودُهُ",14,"د",2,0],["عَفَتهُ رِياحُ الصَيفِ بَعدي بِمورِها","وَأَندِيَةُ الجَوزاءِ بِالوَبلِ وَالدِيَم",15,"م",1,0],["عَفا عَنهُمُ قَدري الرَفيعُ فَأَهجَروا","وَبايَنَهُم خُلقي الجَميلُ فَعابوا",16,"ب",3,0],["عَفَتِ الدِيارُ فَما بِها أَهلي","وَلَوَت شُموسُ بَشاشَةَ البَذلِ",17,"ل",1,0],["عَفَا غَيرَ مُرتَادٍ ومَرَّ كَسَرحَب","ومُنخَفَضٍ طام تَنَكَّرَ واضمَحَل",18,"ل",1,0],["عَفا اللَهُ عن أُمَّ الحُوَيرِثِ ذَنبَها","عَلامَ تُعَنّيني وَتَكمي دَوائِيا",19,"ي",2,1],["عَفَت غَيقَةٌ مِن أَهلِها فَحَريمُها","فَبُرقَةُ حِسمى قاعُها فَصَريمُها",20,"م",3,1],["عَفا مَيثُ كُلفى بَعدَنا فَالأَجاوِلُ","فَأَثمادُ حَسنى فَالبِراقُ القَوابِلُ",21,"ل",1,1],["عَفا رابِغٌ مِن أَهلِهِ فالظَواهِرُ","فَأَكنافُ هَرشى قَد عَفَت فَالأَصافِرُ",22,"ر",1,1],["عَفَت غَيقَةٌ مِن أَهلِها فَجُنُوبُها","فَرَوضَةُ حَسنا قاعُها فَكَثَيبُها",23,"ب",3,1],["عَفا السَفحُ مِن أُم الوَليدِ فكَبكَبُ","فَنُعمانُ وَحشٌ فَالرَكيُّ المثقَّبُ",24,"ب",1,1],["عفوكم ما تقدمي إقدام","حق مثلي عن مثله الإحجام",25,"م",1,1],["عَفِيفَةُ النَّفْسِ إِلاَّ عَنْ تَزَيُّدِهَا","مِنَ الفَضَائِلِ مَا كَرَّ الجَدِيدَانِ",26,"ن",1,0],["عَفَا الله عَنْ صَبٍّ شَهِيدِ غَرَامِهِ","أَصَابَ جِرَاحاً حَيْثُمَا ظَنَّ مَرْهَمَا",27,"م",2,0],["عَفَتْ خَلاَئِقُهُ الغَرَّاءُ وَانْطَفَأَتْ","بِهَا مصَابِيحُ كَانَتْ قُرَّةَ المُقَلِ",28,"ل",1,0],["عَفَت بُرهَة أَطلالُ مِيٍّ وَأَدَرَجَت","بِها الريحُ تَحتَ الغَيمِ قَطراً وَسافيا",29,"ي",2,0],["عَفَت وَعُهودُها مُتَقادِماتٌ","وَقَد يَبقى لَكَ العَهدُ القَديمُ",30,"م",1,0],["عَفَت غَيرَ آرِيٍّ وَأَعضادِ مَسجِدٍ","وَسُفعٍ مُناخاتٍ رَواحِلَ مِرجَلِ",31,"ل",1,0],["عَفا الزُرقُ مِن مَيٍّ فَمَحَّت مَنازِلُه","فَما حَولَهُ صَمّانُهُ فَخَمائِلُه",32,"ل",2,1],["عَفا الزُرقُ مِن أَطلالِ مَيَّةَ فَالدَحلُ","فَأَجمادُ حَوضى حَيثُ زاحَمَها الحَبلُ",33,"ل",1,1],["عَفَت غَيرَ آرِيِّ وَأَجذامِ مَسجِدٍ","سَحيقِ الأَعالي جَدرُهُ مُتَنَسَّفُ",34,"ف",1,0],["عَفَت غَيرَ أَنصابٍ وَسُفعٍ مَواثِلٍ","طَويلٍ بِأَطرافِ الرَمادِ عَضيضُها",35,"ض",3,0],["عَفَت عَرَصاتٌ حَولَها وَهيَ سُفعَةٌ","لِتَهييجِ أَشواقٍ بِواقٍ سُطورُها",36,"ر",3,0],["عفواً فذاك النجم أصبح آفلاً","والقوم محتربون بعد أفوله",37,"ل",2,0],["عفا رسم مَغنَى العز منها كما عفت","لخولة أطلال ببرقة ثهمد",38,"د",1,0],["عفت أربع الإرشاد بعد ارتحاله","وكانت به منها تقوم الدعائم",39,"م",1,0],["عَفا قَوٍّ وَكانَ لَنا مَحَلّاً","إِلى جَوَّي صَلاصِلَ مِن لُبَينى",40,"ن",2,1],["عَفَت قَرقَرى وَالوَشمُ حَتّى تَنَكَّرَت","أَوارِيُّها وَالخَيلُ ميلُ الدَعائِمِ",41,"م",1,0],["عَفا نَهيا حَمامَةَ فَالجَواءُ","لِطولِ تَبايُنٍ جَرَتِ الظِباءُ",42,"ا",2,1],["عَفاريتُ العِراقِ شَفيتَ مِنهُم","فَأَمسَوا خاضِعينَ لَكَ الرِقابا",43,"ب",2,0],["عَفا النَسرانِ بَعدَكَ وَالوَحيدُ","وَلا يَبقى لِجِدَّتِهِ جَديدُ",44,"د",1,1],["عَفا ذو حُمامٍ بَعدَنا وَحَفيرُ","وَبِالسِرِّ مَبدىً مِنهُمُ وَحُضورُ",45,"ر",1,1],["عَفّى المَنازِلَ بَعدَ مَنزِلِنا بِها","مَطَرٌ وَعاصِفُ نَيرَجٍ مِجفالِ",46,"ل",1,0],["عَفّى المَنازِلَ كُلُّ جَونٍ ماطِرٍ","أَو كُلُّ مُعصِفَةٍ حَصاها يَرتَمي",47,"م",2,0],["عَفا الرَسمَ المُحَيلَ بِذي العَلَندى","مَساحِجُ كُلِّ مُرتَزِجٍ هَزيمِ",48,"م",1,0],["عَفَتِ الدِيارُ مَحَلُّها فَمُقامُها","بِمَنىً تَأَبَّدَ غَولُها فَرِجامُها",49,"م",3,1],["عَفا الرَسمُ أَم لا بَعدَ حَولٍ تَجَرَّما","لِأَسماءَ رَسمٌ كَالصَحيفَةِ أَعجَما",50,"م",2,1],["عَفاهُ كُلُّ هَتّانٍ","عَسوفِ الوَبلِ هَطّالِ",51,"ل",1,0],["عَفافُكَ غَيٌّ إِنَّما عِفَّةُ الفَتى","إِذا عَفَّ عَن لَذّاتِهِ وَهوَ قادِرُ",52,"ر",1,0],["عَفَت ذاتُ الأَصابِعِ فَالجِواءُ","إِلى عَذراءَ مَنزِلُها خَلاءُ",53,"ا",2,1],["عَفاهُنَّ صَيفِيُّ الرِياحِ وَواكِفٌ","مِنَ الدَلوِ رَجّافُ السَحابِ هُموعُ",54,"ع",1,0],["عَفٍّ مَكاسِبُهُ جَزلٍ مَواهِبُهُ","خَيرِ البَرِيَّةِ سَمحٍ غَيرِ نَكّالِ",55,"ل",1,0],["عَفُوٌّ عَنِ الزَلّاتِ يَقبَلُ عُذرَهُم","وَإِن يُحسِنوا فَاللَهُ بِالخَيرِ أَجوَدُ",56,"د",1,0],["عفتُ الإقامةَ في الدنيا لو انْشرَحت","حالي فكيف وما حظِّي سوى النكد",57,"د",1,0],["عفيف السجايا باسط اليد بالندى","وإن كان إلا من غنى النفس مقترا",58,"ر",2,0],["عففتُ عن كأسِهِ فأرشفني ال","غبّ منها بقلبه القاسي",59,"ي",1,0],["عَفاءٌ على الدنيا إذا ساء رأيكم","فما هي بالدار الدَّميثة للسُّكنى",60,"ن",2,0],["عِفْ حمدَ سُؤَّالِهِ ولا يَثْنِكَ ال","أخطَبُ عن قَصْده ولا خَطَبُهْ",61,"ب",2,0],["عفاءٌ على دارٍ ظعنتَ لغيرها","فليس بها للصالحين مُعَرَّجُ",62,"ج",1,0],["عَفَّى كلومَ زماني ثم قلَّمه","عني فأحفاه ثم اقتصّ ما جرحا",63,"ح",2,0],["عِفِ الثَّناء الذي تُثني عليه به","ولا تَعِف باكراتِ الطير والرَّوَحَا",63,"ح",2,0],["عَفْوُ الملوك عن الهُجاةِ مدائح","مدحوا نفوسَهُمُ بها فأجادوا",64,"د",3,0],["عفَّت على كلّ جرمٍ أجرمتْ وجَنتْ","أوائلَ الدهر أحداثٌ له أُخرُ",65,"ر",1,0],["عفا اللَّهُ ما أسلفتَهُ من كبيرةٍ","سواها فقد غطّت على الشمس والبدر",66,"ر",1,0],["عفت ذكرَه آباء سوء أدقَّةٌ","فمات خمولاً غير أن ليس يُقبَرُ",67,"ر",1,0],["عفاءٌ على الدنيا تفاحَشَ عَكسُها","فخاب بها مثلي وفاز بها عمرو",68,"ر",2,0],["عفا جُلبُها آي الهدى من سمائها","وغطَّى على أضوائها فهْي طُمَّسُ",69,"س",1,0],["عفاء على الدنيا إذا مستحقها","بغاها ومن تبغى لديه منوعها",70,"ع",3,0],["عفَّى بإسماعيل في شيبانه","ما كان من حَجَّاجه وثقيفه",71,"ف",2,0],["عفَّت مدائحه وعف فما ترى","منكوحةً إلا بخير صداق",72,"ق",1,0],["عفواً فإنّا عبيدٌ إن صمدْتَ لنا","بالجدّ قاتلتَ منا غيرَ أقرانك",73,"ك",1,0],["عفاءٌ على ذكرِ الحياةِ إذا حمتْ","على المرءِ إلا رنْقها وسِمالَها",74,"ل",3,0],["عفا فما يسطيعُ يقتافُهُ","ناظر لُقمانَ ولا قيلِ",75,"ل",1,0],["عفا جِلْبُهُ آيَ الهدى من سمائه","وأعلامَهُ من أرضهِ فَهْيَ طَسْيَمُ",76,"م",1,0],["عَفُوٌّ إذا ما الذنبُ لم يعْدُ حدَّه","إلى الوِتْرِ تَبَّاعٌ قفا الوتر أرقمُ",76,"م",1,0],["عفا الله عن ذَنْبَيْكَ عندي وعندها","فإنهما ذنبا بذيءٍ ومُغتلِمْ",77,"م",1,0],["عفوتُ فلا أقابِلُهُ بِلَوْم","وإنْ أوسِعْتُ من لوم وعذْم",78,"م",1,0],["عَفا بَعدَ عَهدِ الحَيِّ مِنهُم وَقَد يُرى","بِهِ دَعسُ آثارٍ وَمَبرَكُ جامِلِ",79,"ل",1,0],["عَفا غَيرَ نُؤيِ الدارِ ما إِن أُبينُهُ","وَأَقطاعِ طُفيٍ قَد عَفَت في المَعاقِلِ",79,"ل",1,0],["عَفا واسِطٌ مِن آلِ رَضوى فَنَبتَلُ","فَمُجتَمَعُ الحُرَّينِ فَالصَبرُ أَجمَلُ",80,"ل",1,1],["عَفا مِن آلِ فاطِمَةَ الثُرَيّا","فَمَجرى السَهبِ فَالرِجَلِ البِراقِ",81,"ق",1,1],["عَفا دَيرُ لِبّى مِن أُمَيمَةَ فَالحَضرُ","وَأَقفَرَ إِلّا أَن يُلِمَّ بِهِ سَفرُ",82,"ر",1,1],["عَفا مِمَّن عَهِدتَ بِهِ حَفيرُ","فَأَجبالُ السَيالِيَ فَالعَويرُ",83,"ر",1,1],["عَفا واسِطٌ مِن أَهلِهِ فَمَذانِبُه","فَرَوضُ القَطا صَحراؤُهُ وَنَصائِبُه",84,"ب",2,1],["عَفا ذو الصَفا مِنهُم فَأَمسى أَنيسُهُ","قَليلاً تَعاوى بِالضُباحِ ثَعالِبُه",84,"ب",2,0],["عَفا الجَوُّ مِن سَلمى فَبادَت رُسومُها","فَذاتُ الصَفا صَحراؤُها فَقَصيمُها",85,"م",3,1],["عَفا واسِطٌ مِنها فَإِلجامُ حامِزٍ","فَرَوضُ القَطا صَحراؤُهُ فَخَمائِلُه",86,"ل",2,0],["عَفا مِن آلِ فاطِمَةَ الدُخولُ","فَحِزّانُ الصَريمَةِ فَالهُجولُ",87,"ل",1,1],["عَفا مِن سَوامِ الناسِ وَاِعتَمَّ نَبتُه