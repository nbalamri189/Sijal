{"poems":[[53,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[49,"أصبح هذا الناس قالا وقيل","https://www.aldiwan.net/poem63055.html","السريع"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[124,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[160,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[282,"إني إذا لاح البريق يماني","https://www.aldiwan.net/poem32383.html","الكامل"],[371,"يا حار إن الركب قد حاروا","https://www.aldiwan.net/poem57442.html","السريع"]],"verses":[["ما أَثقَلَ اليَأسَ عَلى الحِراصِ","هَل لِجُروحِ الدَهرِ مِن قِصاصِ",0,"ص",1,0],["مَا أَثَرُ المَرْأَةِ الجَدِيدَةِ فِي","شَتَّى نَوَاحِي الرُّقْيِ لِلأُمَمِ",1,"م",1,0],["ما أَثقَلَ الحَقَّ عَلى مَن نَرى","لَم يَزَلِ الحَقُّ كَريهاً ثَقيل",2,"ل",1,0],["ما آثروا في الأرضِ إلا دِينَهُ","دِيناً ولا عَبدوا سِواهُ إلها",3,"ا",1,0],["ما أثِمتْ روحي ولا أجرمتْ","ولا طغى جسمي ولا استهترا",4,"ر",2,0],["ما أثارت حرارةَ الجسَدِ المُشْ","تاقِ إلَّا مرارةُ الحرمانِ",5,"ن",1,0],["مَا آثَرُوكَ لَها بِغَيرِ رَوِيَّةٍ","بَلْ لاِعْتِصامِهِمُ بِخَيْرِ لَبِيبِ",6,"ب",1,0],["مَا أَثِمَتْ بِالَّذِي أَعَدَّتْ","مِنْ عُدَدِ الْقَتْلِ وَالدَّمَارْ",7,"ر",1,0],["مَا أَثْمَرَتْ هِجْرَةُ الْهَادِي لأُمَّتِهِ","مِنْ صَالِحَاتٍ أَعَدَّتْهَا لِتَخْلِيدِ",8,"د",1,0],["ما آثروا نقض الع","هود وإن يظلوا منعمين",9,"ن",1,0],["ما آثر ابن العربي عاقل","على النبي والذي أتى به",10,"ب",2,0],["ما أَثمَرَت يَومَ الهِياجِ رِماحُهُ","إِلا عَمائِمَ لابِسي التيجانِ",11,"ن",1,0],["ما أثقلَ الغَيرةَ من معشرٍ","إذا أَغاروا كلَّما غاروا",12,"ر",3,0]]}