{"poems":[[55,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[95,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[51,"أصبح هذا الناس قالا وقيل","https://www.aldiwan.net/poem63055.html","السريع"],[107,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[164,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[287,"إني إذا لاح البريق يماني","https://www.aldiwan.net/poem32383.html","الكامل"],[376,"يا حار إن الركب قد حاروا","https://www.aldiwan.net/poem57442.html","السريع"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54022","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59148","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100996","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27906","الكامل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34718","المجتث"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106875","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201466","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204904","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131030",""],[557,"مرثية حلم","https://www.poetsgate.com/ViewPoem.aspx?id=13825",""],[5302,"قرب الخليل","https://www.poetsgate.com/ViewPoem.aspx?id=200554",""],[592,"يا عين فابكي على الإخوان لو بدم","https://www.poetsgate.com/ViewPoem.aspx?id=128812",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5447,"خطوة","https://www.poetsgate.com/ViewPoem.aspx?id=208305",""],[5574,"دندنة","https://www.poetsgate.com/ViewPoem.aspx?id=206003",""],[5725,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=211771",""],[6225,"اليقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81036&r=&rc=273",""]],"verses":[["ما أَثقَلَ اليَأسَ عَلى الحِراصِ","هَل لِجُروحِ الدَهرِ مِن قِصاصِ",0,"ص",1,0],["مَا أَثَرُ المَرْأَةِ الجَدِيدَةِ فِي","شَتَّى نَوَاحِي الرُّقْيِ لِلأُمَمِ",1,"م",1,0],["ما أَثقَلَ الحَقَّ عَلى مَن نَرى","لَم يَزَلِ الحَقُّ كَريهاً ثَقيل",2,"ل",1,0],["ما آثروا في الأرضِ إلا دِينَهُ","دِيناً ولا عَبدوا سِواهُ إلها",3,"ا",1,0],["ما أثِمتْ روحي ولا أجرمتْ","ولا طغى جسمي ولا استهترا",4,"ر",2,0],["ما أثارت حرارةَ الجسَدِ المُشْ","تاقِ إلَّا مرارةُ الحرمانِ",5,"ن",1,0],["مَا آثَرُوكَ لَها بِغَيرِ رَوِيَّةٍ","بَلْ لاِعْتِصامِهِمُ بِخَيْرِ لَبِيبِ",6,"ب",1,0],["مَا أَثِمَتْ بِالَّذِي أَعَدَّتْ","مِنْ عُدَدِ الْقَتْلِ وَالدَّمَارْ",7,"ر",1,0],["مَا أَثْمَرَتْ هِجْرَةُ الْهَادِي لأُمَّتِهِ","مِنْ صَالِحَاتٍ أَعَدَّتْهَا لِتَخْلِيدِ",8,"د",1,0],["ما أثر النصح على ألبابهم","الا كآثار الحيا على الحصى",9,"ا",1,0],["ما آثروا نقض الع","هود وإن يظلوا منعمين",10,"ن",1,0],["ما آثر ابن العربي عاقل","على النبي والذي أتى به",11,"ب",2,0],["ما أَثمَرَت يَومَ الهِياجِ رِماحُهُ","إِلا عَمائِمَ لابِسي التيجانِ",12,"ن",1,0],["ما أثقلَ الغَيرةَ من معشرٍ","إذا أَغاروا كلَّما غاروا",13,"ر",3,0],["ما آثرُوكَ بها إذْ قدّضموكَ لها","لكن لأنفسِهمْ كانت بها الأُثَرُ",14,"ر",1,1],["مَا أثْمَرَتْ بالهامِ سُمْرُ رمَاحه","إلاّ لأنَّ الغصنَ يُعْشَقُ بِالثمَرْ",15,"ر",1,0],["ما أثخن النفس وما أكدرها","ما أكذب النفس وما أغدرها",16,"ه",2,0],["ما آثروك بها غذ قدموك لها","لكن لأنفسهم كانت بك الأثر",17,"ر",1,0],["ما أثبتَ التشريكَ في اسمائه","إلا جَهولٌ بالأمورِ مقيت",18,"ت",1,0],["ما اِثَنانِ يَجتَمِعانِ","إِلّا سَيَفتَرِقانِ",19,"ن",1,0],["ما آثَرَت نفسي الجديدَ ولا","خَلَّيتُ فيه من دمي اثرا",20,"ر",2,0],["ما أثقل الجسم إذا الشيب أتى","يؤذيه بَردٌ واللباس يُثقلهْ",21,"ه",1,1],["ما أثقل الترب يبقى في أماكنه","أهوى من الترب ذرات تطير هبا",22,"ب",2,0],["ما أثمرت دوحةُ الخلاف لهم","وهل خلافٌ يُرى لهُ ثمرُ",23,"ر",1,0],["ما أُثرِيَت اهلُ الثَراءِ","الجَمِّ الا من ثَرائِك",24,"ك",1,0],["ما أثرت في صياصيه قنابلكم","إلا كما هزّ متن الشامخ النسم",25,"م",1,0],["ما أثقل العمر.. لا حلم ولا وطن..","ولا أمان ولا سيف... ليحمينا",26,"ن",2,0],["ما أثقل الوجد على عاشق","وإن في روضك ظلا ظليل",27,"ل",1,0],["ما أثروه من الأصل الأصيل وما","قاموا به من معادات لذي التهم",28,"م",1,0],["ماأثقل القبر في أحشائه وجع","يبكي عظام الذي في عيشه انسحقا",29,"ق",2,0],["ما أثقلَ العمرَ الذي أمشي بهِ","ما أندرَ الأحبابَ فوقَ الأسبِلة",30,"ل",2,0],["٤- ما أثقلَ الليل بالذكرى يؤرِّقُني","أوّاهُ كمْ ذرفتْ عينايَ أوّاهُ",31,"ا",2,0],["ما أثقل ذنبك يا رشأ","وأراك برأسي تعصبهُ",32,"ب",2,0],["ما أثقلَ الرُوحَ لو طارتْ بما حملتْ","وما أشقَّ الثرَى في نَسْجِها لِينا",33,"ن",2,0]]}