{"poems":[[39,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[23,"تأوبني ليل بيثرب أعسر","https://www.aldiwan.net/poem21253.html","الطويل"],[23,"تفاقد معشر نصروا قريشا","https://www.aldiwan.net/poem21360.html","الوافر"],[80,"هم أوقدوا بين جنبيك نارا","https://www.aldiwan.net/poem14207.html","المتقارب"],[47,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[47,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54794","البسيط"],[23,"تأوبني ليلٌ بيثربَ أعسرُ","https://www.poetsgate.com/ViewPoem.aspx?id=11421",""],[119,"عتبت على الدنيا عتاب لبيب","https://www.aldiwan.net/poem41243.html","عموديه"],[132,"لله في الأرض أقوام قد اشتملوا","https://www.aldiwan.net/poem50553.html","البسيط"],[164,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[287,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[401,"أحقاً بني أبناء سلمى بن جندلٍ","https://www.aldiwan.net/poem588.html",""],[408,"هم أودعوه الذي أودعوا","https://www.aldiwan.net/poem46728.html","المتقارب"],[412,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[556,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[563,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[563,"نحن أهل الشام سوط الله في","https://www.aldiwan.net/poem34357.html","الرمل"],[568,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107260","المتقارب"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112441","المجتث"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44793","السريع"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107217","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72307","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56661","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128710","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49550","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49546","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100990","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89535","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109391","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105066","الكامل"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67203","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60955","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93564","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130790",""],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68944","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74206","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112482","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107052","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132542","البسيط"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105625","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48274","الطويل"],[3679,"","https://poetry.dctabudhabi.ae/diwan/poem/146388","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91743","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91344","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117843","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117880","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66610","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105127","الكامل"],[4717,"ميمون","https://www.poetsgate.com/ViewPoem.aspx?id=204118",""],[5005,"هما ندّان..","https://www.poetsgate.com/ViewPoem.aspx?id=190156",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5498,"توبة","https://www.poetsgate.com/ViewPoem.aspx?id=216043",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""]],"verses":[["هم أولاد عمران بن عمرو","مضيعي نسبة أو حافظينا",0,"ن",2,0],["هُما وَأَميرُ المُؤمِنينَ مُشَرَّدٌ","أَجاراهُ لَمّا لَم يَجِد مَن يُجاوِرُ",1,"ر",1,0],["هُمُ أَولِياءُ اللَهِ أَنزَلَ حُكمَهُ","عَلَيهِم وَفيهِم وَالكِتابُ المُطَهَّرُ",2,"ر",1,0],["هُمُ أوتوا الكِتابَ فَضَيَّعوهُ","فَهُم عُميٌ مِنَ التَوراةِ بورُ",3,"ر",1,0],["هُم أَوقَدوا بَينَ جَنبيكَ نارا","أَطالوا بِها في حشاكَ اِستِعارا",4,"ر",2,1],["هُم أُولو المَجدِ إِن سَأَلتَ فَإِن كا","ثَرتَ كانوا هُمُ أُولي الأَلبابِ",5,"ب",1,0],["هُما وَرَّثاكَ ذا الفَقارِ وَصَيَّرا","إِلَيكَ القَضيبَ وَالرِداءَ المُحَبَّرا",6,"ر",2,0],["هُمُ أورَثوهُ المجدَ لا مجدَ غيرُهُ","وهم خيرُ حافٍ في البلاد وناعل",7,"ل",1,0],["هُمَا وِسَامَانِ مِنْ مَجْدٍ أَعَزَّهُمَا","مَا قَلَّدَ الرَّوحَ لاَ مَا قُلِّدَ الجِّيدُ",8,"د",1,0],["همُ أولياءُ اللهِ أنزلَ حكمهُ","عليهم، وفيهمْ ذا الكتابُ المطهرُ",9,"ر",1,0],["هم اوقدوا بالبغي والبغي نارهم","فأجت لهم تصلى بغير تقوب",10,"ب",1,0],["هُمْ أَوْضحُوا حجةَ الإحرام بَيِّنَةً","مضيئةً مِنْ علومِ الشرعِ واعْتَدلُوا",11,"ل",3,0],["هم أوقدوها وقاموا يعبدون لها","الرب يُحيي وهم يحيون ربهم",12,"م",1,0],["هما وَديعة من يَرعى وَدائعه","وَمَن يَرى وَهو داني القرب لَيسَ يَرى",13,"ر",2,0],["هُم أَوقَدوا نارَ حَربٍ خابَ موقِدُها","فَكَم عَلى حَدِّها مِنهُم أُريقَ دَمُ",14,"م",1,0],["هُم أَوضَعوا يا وَيحَهُم في غَيِّهِم","فَتَعَثَّرَت أَقدامُهُم في الأَرؤُسِ",15,"س",1,0],["هما ورِثاها عن الوالدين","وذابا على جمرها الساعر",16,"ر",1,0],["هُمُ أودعوني الدُّرَّ يومَ رحيلِهم","وقد ثارَ في بحرٍ من الوَجْدِ طافح",17,"ح",1,0],["هُمُ أوردوكم ضَفّةِ البحرِ طامياً","وهُم تركوكم بين خازٍ وناكسِ",18,"س",1,0],["هُمُ أوْدعُوهُ الَّذي أودعوا","فَلوموهُ إن شِئتُم أو دَعُوا",19,"ع",3,1],["هُم أَورَثوا الفضل أَبناءهم","وَغابوا وَفضلُهُم لَم يَغِب",20,"ب",1,0],["هُمُ أَوْرَثُوهُ نَصْرَ دينِ مُحَمَّدٍ","وحازُوا لَهُ فَخْرَ النَّدى والقِرى وحْيا",21,"ي",2,0],["همْ أوقدوا نارَ الهوى في أضلُعِي","بفراقهمْ يومَ الرّحيل وهاجوا",22,"ج",3,0],["هُمُ أوسعوا في النّاسِ ضمنَ أكفّهمْ","وَهمْ أَوسعوا في الأزْمِ جوعَ المغارثِ",23,"ث",1,0],["هُمُ أَودعوكَ التّرب عمداً وَوَدَّعوا","عَلى رَغمهم خَير اللّحى والحواجِبِ",24,"ب",1,0],["هم أولوا العلم لا سواهم وفيه","لم يزالوا لما عليه تفانوا",25,"ن",3,0],["هم أولوا الجدب رجال سقطوا","في يد الله على السر الخفي",26,"ف",2,0],["هُما والِدٌ ما تُؤِّجَ المُلكَ مِثلُهُ","وَمَولودُ صِدقٍ بِالمَكارِمِ مُرتَدِ",27,"د",1,0],["هما ومن قد قام من نفوسهم","إن كان أصل الفعل من تأسيسهم",28,"م",1,0],["هُمُ أَورَثُونا مَقاماتِهم","وَما أَورَثُونا النُّهى والفِعالا",29,"ل",2,0],["هماّ وسقماً وسمَا","لما بعدت وردنا",30,"ن",2,0],["هُم أَوجَدوا السارِقَ مِن حاجَةٍ","وَقيلَ هذي قِسمَةُ الخالِقِ",31,"ق",1,0],["هُمُ أَولَعُوا بِالصَّدِّ وَالهَجرِ قلبَهُ","وَجَرَّاهُمُ إِصغاؤُهُ والتِفاتُهُ",32,"ت",2,0],["هم أوضحوا الآيات حتى بينوا","الغايات في التحريم والتحليل",33,"ل",1,0],["هم أودعوا القلب الكريم محبة","كرمت فليس يضيع ما هم أودعوا",34,"ع",3,0],["هم أودعوا في الحشى نار الخدود ولم","يرثوا لصبّ على الأحباب محترق",35,"ق",1,0],["هما ورثا عبدَ المليك سَمَاحَهُ","وَنجْدَتَهُ وهذا يُعيدُ وذا يُبدي",36,"د",2,0],["همْ أورثوك العلا واستخلفوك على","آياتها وحذا الأعقابُ والعقِبُ",37,"ب",1,0],["هم أولياء النهى تحيا العقول بهم","كالغيث يخضل من وشميه الشجر",38,"ر",1,0],["هُمُ أَوضَحوا لِلنّاسِ نَهجَ نَبِيِّهِم","بِمُحكَمِ آياتٍ وَشَفرَةِ مِخذَمِ",39,"م",1,0],["هما وان قارباه في عطائهما","فالكحلُ مهما حلالا يبلغ الكحلا",40,"ل",2,0],["هماً وذابت مهجتي","غما وها قد جئت انبي",41,"ب",2,0],["هم أوطئوا غزلي مصر حيادهم","وهم ما هم والدهر بالناس قلب",42,"ب",1,0],["هم أوجَبوا حقَّ الأخوَةِ فلا","فرقٌ لَديهم بين صِنوٍ وفتى",43,"ا",1,0],["هم أوضَحوا محكم الذكر الذي نَسَختْ","أحكامُه سائرَ الأديانِ والمِلل",44,"ل",1,0],["هُمْ أوحشوني بعد أنسٍ وهم","خانوا ومَا خِلْتُ مليحاً يخون",45,"ن",1,0],["هم أَوقدوا في فارس شعلة الهُدى","وَلا زند إِلا المشرفية تَقدح",46,"ح",1,0],["هُم أوَّلَ الكوسِ أخيرَ الليلِ","وآخِرَ الكوسِ فَأولَ الليلِ",47,"ل",1,0],["هم أولاء الأنصار والصحب اضحى","بهم الدين في الذرى محمولا",48,"ل",2,0],["هم أولوا العصمة التي هي فيهم","كلهم مع تحقق وبيان",49,"ن",1,0],["هُما وَرِثا عِلم الرِياسة سابِقاً","إِذا طابَت الآباء طابَ وَلِيدها",50,"د",3,0],["هما والداي الصالحان كلاهما","على شدة البأساء موئل سائل",51,"ل",1,0],["هم أورثوا قلبي جوى وصبابة","وهم خلفوني بالعراق معذبا",52,"ب",2,0],["هم أولياء إذا ما كنت في دعة","من الزمان واعداء مع النوب",53,"ب",1,0],["هم أوردوني كل بيداء قفرة","وهم تركوني أشعث الراس اغبرا",54,"ر",2,0],["هُمُ أوْضحوا نَهْجَ الهِدايةِ للوَرى","وهمْ نصرُوا دينَ الإلهِ ومُرسَلَهْ",55,"ل",2,0],["هم أوضحوا لي نهج كل فضيلة","ملكت بها عقد الثناء وحله",56,"ل",2,0],["هم أَوثقوا الصبَّ بالميثاق حين رَأوا","داعي النَوى قَد قَضى فيهِ وَأَقصاهم",57,"م",1,0],["هُمُ أَوقدوا نارَ الحُروب فَبُدّلَت","بِنار القرى وَاليسر أَنتجه العسر",58,"ر",1,0],["هم أولو أرحامه لا رحموا","مكرهم أرداهم والحسد",59,"د",1,0],["هم أولو الهجرة والأن","صار والغر القرابه",60,"ب",2,0],["هُمْ أَوْرَثوا الجِسْمَ السَّقامَ وَعَذَّبُوا","أَجْفانَنا بِالدَّمْعِ وَالتَّسْهِيدِ",61,"د",1,0],["هما والقياسُ والقياسُ جناهما","أصولٌ لإجماعٍ وقد تتلثمُ",62,"م",1,0],["هم أودعوا جسمي الضنا من بعدما","صدعوا الحشا من للحشا المصدوع",63,"ع",1,0],["هُمْ أوْهَمُوا القِرْدَ الغَبِيَّ بِأَنَّه","-لِذَكَائِهِ- مَلَكَ الجِهَاتِ الأرْبَعَةْ",64,"ع",2,0],["هما وطنٌ تقلّبَ فوق جمرٍ","فأحرق كل نبتٍ في الفؤادِ",65,"د",1,0],["هم أولوا الثورة هم أقطابها","وهم للدهر عين البصر",66,"ر",1,0],["هُمْ أَوْصِياءُ اللهِ دونَ عِبَادِهِ","وَسِوَاهُمُ الضُّلاّلُ عُبَّادُ الوَثَنْ",67,"ن",1,0],["هم أول الناس في جعل القباب على","تلك القبور وكم من ناقضٍ كانا",68,"ن",2,0],["هم أوقفوكَ على مزاج مدادِهم","كي يكتبوكَ خطيئةً وثوابا",69,"ب",2,0],["هم أوصلوك إلى مُنَاكَ بغدرهم","فأذقتهم فوق الهوانِ هَوانا",70,"ن",2,0],["هم أوقٓعوكٓ بِجُبِّ قلبٍ ظالمٍ","فازجُرْ فُؤادكٓ عنٍ حبيبٍ أوقٓعٓكْ",71,"ك",1,0],["هُمْ أولياء لحقِّ الدَّهْرِ مِنْ زَمَنٍ","مِنْ عَهْدِ آدَم َحتَّى بعثِ موتانَا",72,"ن",2,0],["هُمُ أوطأونا غَارِبَ اليُسْرِ بعدَما","أَزَلَّتْ خُطَا أقدامِنا عَثْرَةُ العُسْر",73,"ر",1,0]]}