{"poems":[[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[53,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[53,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[48,"عمى العين يتلوه عمى الدين والهدى","https://www.aldiwan.net/poem23211.html","الطويل"],[48,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[119,"اذا قلت قولا كان فعلي قبله","https://www.aldiwan.net/poem41221.html","عموديه"],[124,"تلاقيت والدنيا لقاء لفرقة","https://www.aldiwan.net/poem49280.html","الطويل"],[168,"حجابك صعب يجبه الحر دونه","https://www.aldiwan.net/poem67827.html","الطويل"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[447,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[466,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86990","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87112","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63990","البسيط"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99988","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101416","الطويل"],[2150,"","https://poetry.dctabudhabi.ae/diwan/poem/116918","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121190","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75923","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129436","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133249","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75689","الطويل"],[4755,"لَقد دَخَلْتُ مِرارًا بعدما خَرَجُوا","https://www.poetsgate.com/ViewPoem.aspx?id=201117",""],[5038,"دعي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189377",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5411,"شَعائِر الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=185729",""],[5996,"وما ذاك إلا عارض من طماعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181339",""]],"verses":[["وما ازدادَ فضلٌ فيك بالمدح شهرةً","بل كان مثل المسك صادفَ مِخْوَضا",0,"ض",2,0],["وما أزال سماء","من فوقها وهْي أرضي",1,"ض",2,0],["وما أزيدك إقبالاً على كرم","وإن غدا وهو عند الناس مشنوف",2,"ف",1,0],["وَما أَزَمَت نَفسي البَنانَ عَلى الَّتي","إِذا أَزَمَت عَضَّت بِشَوكِ سَيالِ",3,"ل",1,0],["وما ازْدُهِيتُ وأثوابُ الصِّبا جُدُدٌ","فكيفَ أُزهَى بثوْبٍ من صِباً خَلَقِ",4,"ق",1,0],["وَمَا أَزْهَى النِّقَابَ حِلىً إِذَا مَا","تُنُخِّلَتِ الأَشِعَّةُ فِي النِّقَابِ",5,"ب",1,0],["وما ازور طرفي منك يا ريم حاجر","لجمر بقلبي منك اج لهيبه",6,"ب",2,0],["وما أزدري أبناء آدم إن بي","حقارتهم والند بالند ألحق",7,"ق",1,0],["وَما أَزعَجَتني نَحوَ بابِكَ حاجَةٌ","فَأُجشِمُ نَفسي رَجعَةً حينَ أُحجَبُ",8,"ب",1,0],["وَما اِزدَهاني سَرابُ المَكرِ وَالحِيَلِ","وَلا دَهاني شَرابُ الكَرمِ بِالخَبَلِ",9,"ل",1,0],["وَما أَزالُ عَلى إِحسانِ دَولَتِكُم","مُثني الحَقائِبِ لا بَل مُثني الحِقَبِ",10,"ب",1,0],["وما أزكى زكت عندي ولكن","مقامي في قضا حاج مقيد",11,"د",1,0],["وما ازدحموا أن القذى بعدك انجلى","عن الماء لكن يشربون وتَقمَحُ",12,"ح",1,0],["وما أزيدُكَ مما قلتُ منْزلةً","في لُجَّة اليمِّ ما يُغْني عن السمل",13,"ل",1,0],["وَما اِزدَهى يَوم أنسٍ بِالزَفاف بِهِ","لِلبَدر وَالشَمس لذّاتٌ بِتَعشيق",14,"ق",1,0],["وَما اِزداد تَشريفاً بِهِ مَدحُ مخلصٍ","لِعلياه في بدءٍ وَحسن ختام",15,"م",1,0],["وما أَزيدُكَ علماً من شَيبتي مَرضٌ","وذو المشيب مريضٌ ما به وَجَعُ",16,"ع",1,0],["وما ازدادَ إلاَّ صحَّةً بَعْدِكِ الهَوى","وَلكنَّ قَلْبِي ما نَأَيْتِ عَلِيلُ",17,"ل",1,0],["وما أزكى وما أندى أكفا","جرى النيل الفرات بنيلهنه",18,"ن",2,0],["وما ازددْتَ عِندِي جَفْوَةً بَعدَ جَفوَةٍ","وَحَقِّكَ إلا ازددْت حبّاً على حُبّي",19,"ب",2,0],["وما أزالُ على أرجاءِ مُهلِكَةٍ","يُسائلُ المعشرُ الأعداءُ ما صنعا",20,"ع",2,0],["وما ازداد مجدا بالوزارة حادثا","واكسبها فخرا اعز المواليا",21,"ي",2,0],["وَما اِزدراكَ سِوى غَمرٍ أَخي حَسَدٍ","يَرى بِكَ الشَمسَ إِحراقاً وَإنوارا",22,"ر",2,0],["وما ازال قذى عينيه غير يد","أحق من كل ذي كف بتقبيل",23,"ل",1,0],["وما ازدلفت إلى الأخرى بصالحة","ولا عرفت ليوم الحشر مقداره",24,"ر",2,0],["وَما اِزداد حدى من حَوادثها سوى","صقال وارهاف وان أوهنت عظمي",25,"م",2,0],["وما أَزالُ حَبيسًا بين ذاكَ وذا","متى سَتَطرقُ بابي أَيُّها الفَرَجُ؟!",26,"ج",1,0],["وما أزْرى بقومٍ مِنْ صغارٍ","إذا الْإيمانُ صارَ لهمْ خطابا",27,"ب",2,0],["وما ازدجرت لزجر الله متقياً","وما استقمت فما قولي لك استفم",28,"م",1,0],["وَما أزال وَخَيْطُ الشَّمْسِ يُوْعِز لي","إنّا سَنبْقى وتُحْيي الرّوحُ أرْواحُ",29,"ح",1,0],["وما أزمع الحي اليمانون نيةً","ولا ريع بالبين المشت مروع",30,"ع",1,0]]}