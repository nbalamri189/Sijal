{"poems":[[51,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[51,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[51,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[46,"عمى العين يتلوه عمى الدين والهدى","https://www.aldiwan.net/poem23211.html","الطويل"],[46,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[115,"اذا قلت قولا كان فعلي قبله","https://www.aldiwan.net/poem41221.html","عموديه"],[120,"تلاقيت والدنيا لقاء لفرقة","https://www.aldiwan.net/poem49280.html","الطويل"],[164,"حجابك صعب يجبه الحر دونه","https://www.aldiwan.net/poem67827.html","الطويل"],[282,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[366,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[441,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[458,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[461,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"]],"verses":[["وما ازدادَ فضلٌ فيك بالمدح شهرةً","بل كان مثل المسك صادفَ مِخْوَضا",0,"ض",2,0],["وما أزال سماء","من فوقها وهْي أرضي",1,"ض",2,0],["وما أزيدك إقبالاً على كرم","وإن غدا وهو عند الناس مشنوف",2,"ف",1,0],["وَما أَزَمَت نَفسي البَنانَ عَلى الَّتي","إِذا أَزَمَت عَضَّت بِشَوكِ سَيالِ",3,"ل",1,0],["وما ازْدُهِيتُ وأثوابُ الصِّبا جُدُدٌ","فكيفَ أُزهَى بثوْبٍ من صِباً خَلَقِ",4,"ق",1,0],["وَمَا أَزْهَى النِّقَابَ حِلىً إِذَا مَا","تُنُخِّلَتِ الأَشِعَّةُ فِي النِّقَابِ",5,"ب",1,0],["وما ازور طرفي منك يا ريم حاجر","لجمر بقلبي منك اج لهيبه",6,"ب",2,0],["وما أزدري أبناء آدم إن بي","حقارتهم والند بالند ألحق",7,"ق",1,0],["وَما أَزعَجَتني نَحوَ بابِكَ حاجَةٌ","فَأُجشِمُ نَفسي رَجعَةً حينَ أُحجَبُ",8,"ب",1,0],["وَما اِزدَهاني سَرابُ المَكرِ وَالحِيَلِ","وَلا دَهاني شَرابُ الكَرمِ بِالخَبَلِ",9,"ل",1,0],["وَما أَزالُ عَلى إِحسانِ دَولَتِكُم","مُثني الحَقائِبِ لا بَل مُثني الحِقَبِ",10,"ب",1,0],["وما أزكى زكت عندي ولكن","مقامي في قضا حاج مقيد",11,"د",1,0],["وما ازدحموا أن القذى بعدك انجلى","عن الماء لكن يشربون وتَقمَحُ",12,"ح",1,0],["وما أزيدُكَ مما قلتُ منْزلةً","في لُجَّة اليمِّ ما يُغْني عن السمل",13,"ل",1,0]]}