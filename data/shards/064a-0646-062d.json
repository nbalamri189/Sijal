{"poems":[[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[65,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[90,"وتروق من بعد بها فوارة","https://www.aldiwan.net/poem44441.html","الكامل"],[53,"قذفك بالفحشاء من لم يكن","https://www.aldiwan.net/poem65969.html","السريع"],[80,"يقولون صبرا لا سبيل إلى الصبر","https://www.aldiwan.net/poem14209.html","الطويل"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[82,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[82,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[13,"ألا عجب الفتيان من أم مالك","https://www.aldiwan.net/poem2223.html","الطويل"],[22,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem21640.html","الكامل"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85481","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42545","الطويل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2231","الكامل"],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[102,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[102,"إبن السبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67632&r=&rc=120",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[154,"حمل الفؤاد على الهوى وتحملا","https://www.aldiwan.net/poem68463.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[266,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[287,"أفدي غلاما قط ما قطبا","https://www.aldiwan.net/poem32868.html","السريع"],[358,"يا ناعس الطرف لب الصب من سحرا","https://www.aldiwan.net/poem40188.html","البسيط"],[412,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[494,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[510,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[519,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[556,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138418",""],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88617","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122352","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63820","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38324","الخفيف"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100150","الكامل"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124614","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96756","الكامل"],[1058,"","https://poetry.dctabudhabi.ae/diwan/poem/198786","الخفيف"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18483","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52071","الكامل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45455","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53091","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53144","الرجز"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200268","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/141693","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137445",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76089","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100393","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100254","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200245","الكامل"],[3232,"","https://poetry.dctabudhabi.ae/diwan/poem/100430","الكامل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[3595,"","https://poetry.dctabudhabi.ae/diwan/poem/105684","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129446","الطويل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123836","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[5582,"غاداكَ مِنْ دِيَمِ الحَيا ضَحْوِيُّها","https://www.poetsgate.com/ViewPoem.aspx?id=187333",""],[482,"شكايةُ الصبَّ إلى الأربُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=111423",""],[5751,"بينَ موتٍ وموت","https://www.poetsgate.com/ViewPoem.aspx?id=214771",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""],[6218,"كلاّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65905&r=&rc=58",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["يَنحو المَضيقَ وَقَد أَع","رَضَ الطَريقُ اللَحبُ",0,"ب",1,0],["ينحو الأُجَيْرِعَ من حُزْوى أُغَيْلِمَةٌ","سالَتْ بهِمْ بُرَقُ الصّمّانِ غِرّانُ",1,"ن",1,0],["يُنحي لَها حَدَّ مَدرِىٍّ يَجوفُ بِهِ","حالاً وَيَصرُدُ حالاً لَهذَمٌ سَلِبُ",2,"ب",1,0],["ينحلّ فيها النور حتى قد ترى","قوس السحاب لها بها تصوير",3,"ر",1,0],["ينحلُ ما فيه ليخفَى له","وقلَّ ما تُغني التعاليلُ",4,"ل",1,0],["يَنُحنَ عَلى نَجمَين أَثكَلنَ ذا وَذا","وَيا صَبرُ ما لِلقَلبِ في الصَبر مِن عُذرِ",5,"ر",1,0],["ينحل في الدفن ماء ثم تعقده","فهو الغنى لقليل المال مفتقرِ",6,"ر",1,0],["ينحو الآراءَ بفكرته","فيصيبُ لها نُقَباً بِهِنَا",7,"ن",2,0],["يَنُحْنَ مَعَ الأَشجارِ نَوْحَ حَمائِمٍ","تَهُزُّ بِها الأَحزانُ أَغصانَها المُلْدا",8,"د",2,0],["يَنُحنَ عَلَيهِ وَهوَ يَنزِعُ نَفسَهُ","لَقَد كُنتَ أَبّاءَ الظُلامَةِ قَسوَرا",9,"ر",2,0],["يَنحو بِها مِن بُرقِ عَيهَمَ طامِياً","زُرقَ الجِمامِ رِشاؤُهُنَّ قَصيرُ",10,"ر",1,0],["يُنحي الدِماءَ عَلى تَرائِبِه","وَالقِدَّ مَعقوداً وَمُنقَضِبا",11,"ب",2,0],["ينحى عَلى ما كانَ مس","طورا لأصحاب الرَقيم",12,"م",1,0],["يَنُحْنَ عَلى مَيْتٍ سَيَتْبَعْنَ إِثْرَهُ","وَمِنْ عَجَبٍ مَيْتٌ يَنُوحُ عَلَى مَيْتِ",13,"ت",1,0],["يُنحي الدِماءَ عَلى تَرائِبِها","وَالقِدَّ مَعقوداً وَمُنقَضِبا",14,"ب",2,0],["يَنْحُو بِها مِنْ بُرْقِ عَيْهَمَ طامِياً","زرقَ الحمام رشاؤهن قصيرُ",15,"ر",1,0],["ينحني، يستفسر الأطراق عن","وجهه الذاوي، وعن بابٍ مضاءِ",16,"ا",2,0],["ينحني، يستفسر الاطراق من","وجهه الذاوي ، وعن باب مضاء",17,"ا",2,0],["يَنُحنَ عَلى مَيتٍ وَأَعلَنَّ رَنَّةً","تُؤَرِّقُ عَيني كُلِّ باكٍ وَمُسعَدِ",18,"د",1,0],["ينحى على صدأ الهباء كأنه","فيما انتحى للأرض أصبح صيقل",19,"ل",1,0],["يَنحَني المُنحَنى هُناكَ عَلى الصَب","بِ حُنُوّاً وَتَعطِفُ الزَوراءُ",20,"ا",2,0],["يُنحِلونَ البُدورَ حُسناً وَإِن خا","ضوا وَغى ناحَلوا القَنا بِالخُصورِ",21,"ر",1,0],["ينحني تحية ويحنو عليه","كل عود كأنه عوَّاده",22,"د",2,0],["يَنحَلُّ عِقدُ الصَبرِ مِنّي إِذا","ما شَدَّ فَوقَ الخَصرِ بَندَ القَبا",23,"ب",2,0],["يَنحو بَديع المَعاني درّ مَنطقه","فَنجتلي مِنهُ في مرآته صورا",24,"ر",2,0],["يَنحون حيث تَرى المَوارِدَ طُفَّحاً","وَالرَوض غَضٌّ وَالنَسيم عَليلا",25,"ل",2,0],["ينحطُّ عنه الناسُ من فضلهم","منحدَرَ الرِّدفِ عن المنكِبِ",26,"ب",1,0],["يَنحنَ عَلى قتلاكُم عند مَعرَكٍ","تَرَكنا به هاماً يصيحُ مهشَّما",27,"م",2,0],["ينحلُّ كدٌّ كدَدْتَ العمرَ كيْ يبقى","وعنكَ تستنكفُ الأوصافُ والنّعْتُ",28,"ت",1,0],["ينحطُّ مَدحي عن حقيقةِ مدحِكُم","ولوَ اِنّني فيكُم نظَمْتُ الجَوهَرا",29,"ر",2,0],["ينُحْنَ ولم يُضمِرْنَ شجواً وإنّما","شَجىً وَاِشتِياقاً ما تنوحُ النّوائحُ",30,"ح",1,0],["ينحو الرى ساحاته من بعد ما","بحثوا فلم يجدوا المخفف للعنا",31,"ن",2,0],["ينحرون البزل المصاعيب للو","فد وَيكفون عيلة الايتام",32,"م",1,0],["ينحك في طمريه مثل الدر في","الأصداف لكن في الثرى مبذول",33,"ل",1,0],["يَنُحْنَ وما يَنُحْنَ شبيهَ ليلى","وينحرنَ الدموعَ على النحور",34,"ر",1,0],["ينحِلُ الجسمَ يَسلبُ القلبَ وَجْداً","يُذهِبُ العَقلَ فَهوَ أَصلُ الجُنونِ",35,"ن",1,0],["ينحو العدى فتفر عنه كأنهم","حمر تنافر من زئير الضيغم",36,"م",1,0],["ينحط كلكله على مثوى أبي","تلميت ثمّ على الميامن راح",37,"ح",1,0],["ينحو بها جهة الحجا نحويُّها","وتفيد سامعَ لفظِها لغويُّها",38,"ي",3,0],["ينحني خنجر المصيبة فينا","يخجل الشعر.. يعجز البلغاء",39,"ا",2,0],["ينحي بروقين ما ضلا فرائصها","حتى تجولن بالجبانِ واختضبا",40,"ب",2,0],["يَنحَطُّ مِن ذِفراه مِثلُ الفُلفُلِ","يَذُبُّ عَنهُ بِأَثيثٍ مُسبَلِ",41,"ل",1,0],["يَنْحَطُ مِنْ بَطنِ الجَزَائِرِ فَيْضُهُ","وَيَسِيحُ لِلخَضْرَاءِ وَهوَ المُغرِقُ",42,"ق",1,0],["ينحتون الشعر كزا جافيا","ويظنون المنى ما ينحتون",43,"ن",1,0],["يَنحازُ منهنَّ فيهِ أُمَّةٌ خُلِقَت","حُذّاً مُذَبَّحةٌ مِنها بِأَوداجِ",44,"ج",1,0],["ينحلُّ صبري إذ يريني خصره","فيه مجال بنده المعقود",45,"د",1,0],["ينحت من صخر القوافي تارة","وتارة من بحرها يقطف",46,"ف",1,0],["ينحن على أغصان دوح منضد","بشجو شجيٍّ والفنونُ تميدُ",47,"د",1,0],["ينحر للضيفان كل ليلة","مثنى ويزداد عطاء اربعا",48,"ع",2,0],["ينحو القناة ولم يبرح ينازلها","حتى تخر العدى جثياً عَلَى الركب",49,"ب",1,0],["ينحز السعى في الخير العميم فلا","يقول إما غدا أولا فبعد غد",50,"د",1,0],["يَنحَطُّ أَعلاهُ إِذ يَسمو بِأَسفَلِهِ","فعلُ الزَمانِ بِنا أَقبِح بِهِ زَمَنا",51,"ن",2,0],["ينحِّيه عن شم الدنية معطسٌ","يعدُّ أباء الضيم فرضا محتما",52,"م",2,0],["ينحو ربي ذي سلمِ شاردا","ينفض قرطيه على ذي غيد",53,"د",1,0],["ينحط ّ قدري كلما خاطبتكم","ويعيد قدراً منكم قد فاتا",54,"ت",2,0],["ينحو العدى فتفر عنه كأنهم","حمر تنافر عن زئير الضيغم",55,"م",1,0],["يُنَحّي تُراباً عَن مَبيتٍ ومَكنِسٍ","رُكاما كَبَيتِ الصَيدَنانيّ دانِيا",56,"ي",2,0],["ينحط مدحي عن حقيقة شانها","ويقل في نظمي صحاح الجوهري",57,"ر",2,0],["ينحن كما ناح الحمام وبالبكا","لا غزر شجوا من نواح الحمائم",58,"م",1,0],["ينحو بها مبدا النجوم طوالعاً","ملك مطيعٌ للاله مطاع",59,"ع",1,0],["ينحن عليك اليوم والليل كله","ويلطمن بض الصدر والنحر والخدا",60,"د",2,0],["يَنحو لَها الرَوقَينِ عَن سَرَبٍ","صَدقٌ بِجَلحِ الطَعنِ مُسرِعُهُ",61,"ع",2,0],["ينحر اللي يأخذ الطيب بذراعه","الصديق الصافي الصامل الواعي",62,"ع",2,0],["يَنْحُو بِها جِهَةَ الحِجا نَحْوِيُّها","وَيُفِيدُ سامِعَ لَفْظِها لُغَوِيُّها",63,"ي",3,0],["يَنُحْنَ في الأيكِ فيُبدي أسًى","مِن نوحِها سرُّ الهوى المودَعِ",64,"ع",1,0],["يَنحرُ الصُّبْحَ في الأساريرِ لَيتاً","ثمَّ يُمسي وبينَ عَينَيهِ عَلاّ",65,"ل",2,0],["ينحرون الحلم بعيون الطفوله","وانت .. فلسفت المعاني بالكلام",66,"م",1,0],["ينحني واحدٌ ليصبح قوساً","ولقد فاز من سيصبح نبلا",67,"ل",2,0],["ينحون حيث ترى الموارد طفّحاً","والروضَ غضَّاً والنسيم عليلا",68,"ل",2,0],["يَنْحَنِي عِنْدَها الزّمَانُ فَيَلْقَى","شُعَلاً مِنْ عَزائِمِ الإِيمانِ",69,"ن",1,0]]}