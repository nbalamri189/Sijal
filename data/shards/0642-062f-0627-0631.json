آم ِتَوَجُّعَا","https://www.poetsgate.com/ViewPoem.aspx?id=197597",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5533,"الفَجْرُ قادِم","https://www.poetsgate.com/ViewPoem.aspx?id=176644",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5638,"رسالةٌ إلى أسير","https://www.poetsgate.com/ViewPoem.aspx?id=198246",""],[5674,"الأماني التائهات","https://www.poetsgate.com/ViewPoem.aspx?id=185308",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5829,"في دائرة الخطر","https://www.poetsgate.com/ViewPoem.aspx?id=211095",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5969,"لمن عاش الذي فينا","https://www.poetsgate.com/ViewPoem.aspx?id=199241",""],[6102,"حَماقَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=183657",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6213,"بعد المدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76304&r=&rc=52",""],[463,"أصبْ برأيي أصابًَ الحظُّ أو غلطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60116&r=&rc=172",""],[572,"أَكْفِنَا يا عَذُولُ شرَّ لسانِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9418&r=&rc=275",""]],"verses":[["قَد أَرخَصَ الدَمعَ يَنبوعُ الغَناءِ بِهِ","وا لَهفَتي وَنُضوبُ الشَيبِ أَغلاهُ",0,"ا",2,0],["قَد أَروعُ الخَليلَ بِالصَرمِ مِنّي","لَم يَخَفهُ وَقِلَّةِ التَكليمِ",1,"م",1,0],["قد أرضعته الساريات لبانها","وحَلَلْنَ فيه أَزِرْةَ النُّوّارِ",2,"ر",1,0],["قَد أَرقَصَت أُمُّ البَعيثِ حِجَجا","عَلى السَوايا ما تُحِفُّ الهَودَجا",3,"ج",2,1],["قَدِ اِرتَدَوا بِرِداءَ اللُؤمِ وَاِتَّزَروا","وَقُطِّعَت لَهُمُ مِنهُ سَرابيلُ",4,"ل",1,0],["قَد أَراني هُناكَ حَقُّ مَكينٍ","عِندَ ذي التاجِ مَجلِسي وَمَكاني",5,"ن",2,0],["قَد أَراني هُناكَ حَقَّ مَكينٍ","عِندَ ذي التاجِ مَقعَدي وَمَكاني",6,"ن",2,0],["قد ارتهنتُ الفؤادَ عندك فاح","فظْهُ وأحسِنْ جوار مُرتَهنك",7,"ك",1,0],["قد أردْتُ الإعراضَ عنك احتقاراً","لك لا أنَّني جَنَحْتُ لسِلْمِك",8,"ك",1,0],["قد أردْتُ الإطنابَ فيك فقالتْ","ليَ غاياتُك البعيدة مهلا",9,"ل",2,0],["قد أردتُ التَّشْبيبَ فيها ولكنْ","لم تكنْ لي مندوحةٌ في الميم",10,"م",1,0],["قد أَرَتنا وأسمعتْنا ولكنْ","تركتْ كلَّ عاشقٍ ظمآنا",11,"ن",2,0],["قَد أَرَدنا حَملَ البَشائِرِ لِلعِلمِ","فَكُنّا لِأَهلِهِ مِن نُعاتِه",12,"ت",2,0],["قد أراد الحساد للحر هضما","فابى الحر ان يكون هضيما",13,"م",2,0],["قد اراد الهزار ان","ينفث السحر فاقتدر",14,"ر",1,0],["قَد أَراهُ مَغنىً لِأَرآمِ سِربٍ","مائِلاتٍ إِلى التَصابي خُدودُه",15,"د",2,0],["قَد أَرَتكَ الدُموعُ يَومَ تَوَلَّت","ظُعُنُ الحَيِّ ماوَراءَ الدُموعِ",16,"ع",1,0],["قَد أَرى أَن لَستُ في الدُنيا وَلَو","بَقِيَت لَي دائِماً طولَ الأَبَد",17,"د",1,0],["قَد أَرَدنا فَأبى اللَهُ لَنا","وَأَرادَ اللَهُ شَيئاً فَمَضى",18,"ض",2,0],["قَدِ اِرتَدى ذَيلَ الظَلامِ الأَشيَبِ","وَالصُبحُ مِثلُ الماءِ تَحتَ الطُحلُبِ",19,"ب",1,1],["قد أرانا مكافحُ الأُسْدِ سيفاً","حَدُّهُ في طَلا عِداهُ وَلُوجُ",20,"ج",1,1],["قَد أَرانا بِغَبطَةٍ","فيهِ نَلهو وَنَجذَلُ",21,"ل",1,0],["قَد أَرانا وَلا أُسَرُّ بِأَن تَج","مَعَ دارٌ وَلا نُبالي الفِراقَ",22,"ق",1,0],["قَد أَرسَلوا كَي يُحَيّوني فَقُلتُ لَهُم","كَيفَ السَلامُ وَقَد عَدّى بِهِ القَدَرُ",23,"ر",1,0],["قَد أَرى أَنَّكُنَّ قُلتُنَّ نُصحاً","وَاِجتَهَدتُنَّ لَو أُريدُ صَلاحا",24,"ح",2,0],["قَد أَراني في سالِفِ الدَهرِ لَو دا","مَ وَغُصنُ الشَبابِ إِذ ذاكَ رَطبُ",25,"ب",1,0],["قَدِ اِرتَجَزَ الرَعدُ المُرِنُّ بِأُفقِهِ","فَأَملى وَجالَت راحَةُ البَرقِ تَكتُبُ",26,"ب",1,0],["قَد أُرعِشَت يَدُ سائِلٍ مِن كَبرَةٍ","وَلِنائِلٍ بُسِطَت عَلى الإِرعاشِ",27,"ش",1,0],["قَد أَرذَياكَ بِسَيرٍ إِن رَكِبتَهُما","وَلَم يُصَيَّر بِحالٍ مِن رَزاياكا",28,"ك",2,0],["قَد أَراكُم تَلَطُّفاً وَهوَ في الغِل","ظَةِ مِن جُرهُمٍ وَآلِ عَبيلِ",29,"ل",1,0],["قَد أَراني القِياسُ أَنَّ لُيوثَ ال","غابِ فيما يَنوبُ مِثلُ الإِرانِ",30,"ن",1,0],["قَد أَرى في النجوم دبينِ مازا","لا يدوران بينها في الفضاء",31,"ا",2,0],["قد أرقدنا دمائنا فسلوه","أيّ دمع من مقلتيه أريقا",32,"ق",2,0],["قَد أَرانا وأَهلَنا بحَفيرٍ","نَحسَبُ الدَّهرَ والسِّنينَ شُهُورا",33,"ر",2,0],["قد أرحنا واسترحنا","من غدُوٍّ ورواح",34,"ح",1,1],["قد أرهَفَ التاريخُ من أسماعِهِ","وتقَلَّدَتْ يمناه غَرْبَ يراعِهِ",35,"ع",2,1],["قد ارتكبت أبا السبطين في جلل","وفاتك الحزم واستأسرت للحذر",36,"ر",1,0],["قد أرقلت بك في الخضمّ مطيّة","هوجاء ما نكث الخضمّ مغارها",37,"ر",3,0],["قَدْ أَرَانا وَلاَ أُسَرُّ بِأَنْ تَجْ","معَ دارٌ، ولا نبالي الفراقا",38,"ق",2,0],["قَد أَرضَعتُهُ لبانها ال","عَلياءَ في حَجر الدَلال",39,"ل",1,0],["قد أرغم البارى بنصرك دينه","فينا شياطين الملا والجان",40,"ن",1,0],["قَدْ أُرْعدَتْ لِمزْجِهَا","وَالْتَهَبَتْ كَالسُّرُجِ",41,"ج",1,0],["قد أرْعَدَتْ مِنْ كِذْبِنا سًحُبٌ","فأمْطَرَتْ خِزْيًا وخُسْرانا",42,"ن",2,0],["قد أرغموك على الزوا","ج بذلك الشيخ الوضيع",43,"ع",1,0],["قد أراني الغرام أن نقيضاً","ونقيضاً في النفس يجتمعان",44,"ن",1,0],["قد أَرانا العباسُ بعد أبيه","كيفَ تَلقى العظائمَ العُظماءُ",45,"ا",2,0],["قد أرادا ، وأراد الله ما","كان ؛ سبحانك تمضي ما تشاء",46,"ا",2,0],["قد أراشت جوانح الطير منّي","حيث كانت للصبّ خير رياش",47,"ش",1,0],["قد أرخَتِ الشَّالَ على الخدِّ","فاخضرَّ منهُ فَننُ القدِّ",48,"د",1,1],["قَد أَرانا سَريرُهُ كَيفَ كانَت","قَبلُ تُجلى أَسِرَّةُ الأَنبِياءِ",49,"ا",2,0],["قَد أَراني أَنفُضُ الرَأسَ جوعا","ثَمَّ أَمشي في البَيتِ مَشيَ خَيالَه",50,"ل",2,0],["قَد أَرهَبوهُم فَزادَ الوَهمُ فَاِنقَلَبوا","عَلى البِطاحِ فَخانَ العَزمُ عَزمَتُهُ",51,"ت",2,0],["قَد أَراني السَماءَ قِبلَةَ أَرضي","وَثَنى الأَرضَ قِبلَةً لِلسَماءِ",52,"ا",2,0],["قَد اِرتَبَطتُم فُؤاداً فيكُمُ جَذِلاً","أَطلَقتُموهُ لِساناً عَنكُمُ جَدِلا",53,"ل",2,0],["قد أرضعتكم ثَديَها","أي عِلْمَها ذاك المصان",54,"ن",1,0],["قد ارتفعتِ أيا أُمَّ الإله ضحىً","فوق الملائك في أعلى السماواتِ",55,"ت",1,1],["قد ارتفعت بمجدٍ لا يبباح به","يفوق بالقدر أنواع السعادات",55,"ت",1,0],["قَد أَرى الشامِتين صَبراً وَلا صَبر","وَزور تَجلد المَحزون",56,"ن",1,0],["قد أردنا السماع لكن فقدنا","من يفيد الأسماع بالأسماع",57,"ع",1,1],["قد أرهن الوصل قلباً","متى يرد إليهِ",58,"ه",1,0],["قد ارسلت لام صدغيها تجرُّ به","قلوب أهل الهوى وللام توكيد",59,"د",1,0],["قد ارتفعت مختارة العز خيرة","كما رفعت للجود فيها المنابر",60,"ر",1,0],["قد أراني نقصَ القبائلِ منهنّ","تمامٌ توارثَتْهُ تَميمُ",61,"م",1,0],["قد أرحت الركبان من دأب السي","روصنت السيوف في الأغماد",62,"د",1,0],["قد اركبتني كل صعب في الهوى","وتحللت من ادمعي مطلولا",63,"ل",2,0],["قد أرغم الدهرَ تهويني نوائبَه","من عزَّ بالصبر في الأحداثِ لم يَهُنِ",64,"ن",1,0],["قد أرهقوه فلا جبناً ولا جزعاً","واستخبطوه فلا عِيّاً ولا لَغطا",65,"ط",2,0],["قد أريقت إلّا لديك المروءا","ت وضاقت إلّا عليك الأمورُ",66,"ر",1,0],["قد أربَعَ الوادي ببغداد واب","تلّ الثرى واتّسع الجانبُ",67,"ب",1,0],["قد ارتبطنا بسلك الكهرباء معا","وسار بالشوق في القلبين ربان",68,"ن",1,0],["قد ارتسمت فيه الحقائق وانجلت","بواطن أسرار له متجليّه",69,"ي",2,0],["قَدِ ارْتَضاهُ الأَكْرَمُ","بَحْرُ الْعُلُومِ الْعَلَمُ",70,"م",1,0],["قد أرقَدَ الأجفانَ تحتَ أمانِهِ","جَفْنٌ له طَرَدَ الحِفاظُ رُقادَهُ",71,"د",2,0],["قَدْ أَرَاهُ يُطِيْعُ أَمْرَكَ فِي اللَّهْ","وِ وَيَعْصِ العَذُولَ فِي عِصْيَانِكْ",72,"ك",1,0],["قد أَرضَعَتْهُ المكرما","تُ فما أَحبَّ فِطامَها",73,"م",3,0],["قَد أَراهُم وَفي المَواسِمِ إِذ يَغ","دونَ حِلمٌ وَنائِلٌ وَبَهاءُ",74,"ا",2,0],["قد ارتدى ثوبه الموشي مقتطف","من كل زهر نضير شكله اقتطفا",75,"ف",2,0],["قد ارتحلت وكل الناس في كمد","عليك والقلب لهفاً بعدك انفطرا",76,"ر",2,0],["قد ارتفعت معابدها ارتفاعا","يسامى كل آثار عليه",77,"ي",2,0],