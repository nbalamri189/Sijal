لجون..","https://www.poetsgate.com/ViewPoem.aspx?id=191597",""],[5461,"يامدور الهين","https://www.poetsgate.com/ViewPoem.aspx?id=26284",""],[5526,"الشعر والكتابه","https://www.poetsgate.com/ViewPoem.aspx?id=192619",""],[5672,"هوىً مد العمر","https://www.poetsgate.com/ViewPoem.aspx?id=206511",""],[5672,"يا مدير العطر","https://www.poetsgate.com/ViewPoem.aspx?id=206512",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5725,"يا مسرج الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=205582",""],[5725,"فراشة الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=211738",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5991,"ته على المستهام فيك جمالاً","https://www.poetsgate.com/ViewPoem.aspx?id=116381",""],[6100,"قضية تيسير علوني","https://www.poetsgate.com/ViewPoem.aspx?id=52599",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""],[6277,"العبودية الكبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64441&r=&rc=0",""]],"verses":[["يَا مَدْفَنَ التَّقْوَى وَيَا مَثْوَى الْهُدَى","مِنِّي عَلَيْكَ تَحِيَّةٌ وَسَلاَمُ",0,"م",1,0],["يا مُدمِنَ الذِكرِ وَالتَسبيحِ مُحتَسِباً","ها أَنتَ في الخُلدِ قَد جاوَرتَ مَولاكا",1,"ك",2,0],["يا مدْملَ الجرح بألفاظه","وناهياً للدّهر عما اجترح",2,"ح",1,0],["يا مديدَ النوال دعوة راجٍ","حثّه جودك البسيطُ السريع",3,"ع",1,1],["يا مَددي حين خانني مددي","وعُدَّتي إذ تعذَّرت عُددي",4,"د",2,1],["يا مُديمَ الصَومِ في الشَهرِ الكَريم","صُم عَنِ الغيبَةِ يَوماً وَالنَميم",5,"م",1,0],["يا مُدنفاً يحييهِ ثم يَميتهَ","قربٌ وبعدٌ في الضنين بوصلهِ",6,"ل",2,0],["يا مُدَّعي الشِّعْرِ كُنْ منه على وَجَلٍ","فقد مُنِيتَ بشيطانٍ له عاتي",7,"ت",2,0],["يا مُدخِلَ الصُلعِ حَمّاماً يَزيدُهُمُ","بِطولِ مُكثِهِمُ في جَوفِهِ وَسَخا",8,"خ",2,1],["يا مُديرَ الصُّدغ في الخَدِّ الأَسيلْ","ومُجيلَ السِّحر بالطَّرفِ الكحيلْ",9,"ل",1,1],["يَا مُدْمِجاً تَاجَيْ مِنَا","فِي تَاجِ فَارُوقِ الزَّمَانِ",10,"ن",1,0],["يَا مُدْنِيَ الأَرَبِ البَعِيدِ مَنَالُهُ","وَلَقَدْ أَقُولُ مُنِيلُ كُلِّ رَجَاءِ",11,"ا",2,0],["يا مُدرِكاً أَكبَرَتهُ مُدرِكَةٌ","فَلَم يَزَل مِن كِبارِها البُلَغا",12,"غ",2,0],["يا مُدانينَ اضاعُوا وطناً","هو للحشرِ بمن فيه مدين",13,"ن",1,0],["يا مدفن الثلج .. هل غيري يزاحمُني؟","وهل سريرُ الهوى ما عادَ مُنفرِدا",14,"د",2,0],["يا مدلج العيس اتئد بوركت من","رجل يثير عزائم الركبان",15,"ن",1,0],["يا مدعي عام اللواء بلاؤنا","سيظل مهما خصصوه عمومي",16,"م",2,0],["يا مدعي عام اللواء","وخير من فهم القضية",17,"ي",2,1],["يا مدعي عام اللواء","وأنت من فهم القضية",17,"ي",2,0],["يا مدمن العصيان طول حياته","يا عيبةً للعيب والأوزار",18,"ر",1,0],["يا مُدمِنَ الخمر غَيرَ آلِ","في تركه أمر ذي الجلالِ",19,"ل",1,1],["يا مُدْنيَ الجمرةَ من خدّهِ","صيّرتَ قلبي بينَ نارينِ",20,"ن",1,1],["يا مدَّعي جمع ما قد حاز من شرف","أفنيت عمرك فيما لا تطاوله",21,"ل",2,0],["يا مُديرَ الكُؤسِ مِن مُقلَتِهِ","أَنتَ جَرَّعتَني الصَبابَةَ صَرفا",22,"ف",2,0],["يا مُديرَ الكُؤوسِ مِن طَرفِهِ ال","فَتّان رِفقاً بِالشارِبِ المَخمورِ",23,"ر",1,0],["يا مُدنَف الخَصرِ قد غادَرتني دَنِفاً","وناعسَ الطرف قد أودى بي السَّهَرُ",24,"ر",1,0],["يا مدع في الفخر نيل مناله","أَعلمت أَنك مدع أَم معتدى",25,"د",2,0],["يا مُدرِكَ الأَوتارِ مِن خَصمِهِ","إِن خَطَفَ القَوسَ وَإِن أَوتَرا",26,"ر",2,0],["يا مدعي حب رب العرش مستترا","بحبك المرأة الحسناء في البشر",27,"ر",1,1],["يا مدعي الشعر زوراً","وانت شر سفيهِ",28,"ي",2,1],["يا مُدرِكاً رُتَباً ما بعدَ ذِرْوتِها","إلاّ الدّوامُ فَدُمْ للمَجْدِ تَدَّرك",29,"ك",1,0],["يا مِدرَهَ الدينِ يا فَردَ اليَقينِ أَصِخ","لِمَدحِ مَولى يَرى تَفضيلَكُم دينا",30,"ن",2,0],["يا مدعي الصبر عن أحبابه وله","دمع إذا حن ذكراهم تكذبه",31,"ب",2,1],["يا مُدَّعِي السُّلوانِ عن أحبابِهِ","أينَ السُّلُوُّ وأينَ منكَ أوانُهُ",32,"ن",2,0],["يا مدحتي فذي أمانا لك من","يا طيف يا اكرم ضيف قد طرق",33,"ق",1,0],["يا مُدْنِيَ الأملِ البعيدِ وإِنْ نَأَى","ومُبَعِّدَ الخطبِ الجليلِ وإِن دَنا",34,"ن",2,0],["يا مدعي الحب للباري أراك على","لين الفراش نزيفاً من كؤوس كرى",35,"ر",2,0],["يا مُدْرَجاً فرداً تُسَدَّى فوقه","بالقاع أرديةُ الثرى وتُنارُ",36,"ر",1,0],["يا مُدَّعِي حُبَّ النَّبيّ وآلِهِ","لَمْ تَدْرِ ما حُبُّ الْكِرامِ الصُّيَّدِ",37,"د",1,0],["يا مدعي للوجود أخطأت عين عينْ","من أين لكْ هذه الدعوى تُرى من أينْ",38,"ن",1,1],["يا مداد الجميع نحن حروف","بك نبدو وأنت بالمرصاد",39,"د",1,0],["يا مدعي العرفان فجرك كاذبُ","لم يدخل الوقت الذي هو واجبُ",40,"ب",1,1],["يا مُدَّعٍ أَنَّ الغَرامَ بِقَلْبهِ","أَفنْى تَجلُّدَه وطَارَ بِلبِّهِ",41,"ب",2,1],["يا مَدمَعَيَّ اِكفِياني نارَ أَحزاني","إِنّي عَهِدتُكُما مِن خَيرِ أَعواني",42,"ن",2,1],["يا مدرك المرضى بما تبغيه من","دور العلاج ومغنيَ الفقراء",43,"ا",2,0],["يا مدعين اشتياق المصطفى لكم الد","عوى ولا كنّكم لستم بأكفاء",44,"ا",2,0],["يا مدحض المحل وغيث الندى","يا منشيء الخصب وبرء السقام",45,"م",1,0],["يَا مُدّعي كِتْمَانَ واضِحِ خَدّهَا","أمَعَ المَدَامِعِ تَدَّعِي الكِتْمَانَا",46,"ن",2,0],["يا مدخل الجنات والنيران","من صلح أو فسد",47,"د",1,0],["يا مدعي الحب قف واسمع حديث شيح","له على طرف الأهوا اشتمالات",48,"ت",1,0],["يا مدّعي في ضد ما فيه ارتجع","فالعلم في كل الأمور مذاقُ",49,"ق",1,1],["يا مدلج الانضاء وخدا عج الى","حيّ الكرام وناد فيه من ظعن",50,"ن",1,0],["يا مُدير الراح صَرفاً","قُم وَشنف لي الكُؤوس",51,"س",1,0],["يا مدرك الثار كم يَطوي الزمان على","إمكان إدراكه الأعوامَ والحججا",52,"ج",2,0],["يا مدّعين الحق غشاً للملا","هل عندكم للحق من آثارِ",53,"ر",1,0],["يا مدمع السحب ابكه","ان لم يصب وبل فطل",54,"ل",1,0],["يا مدمعاً بالحزن يج","ري أثره دمع السرور",55,"ر",1,0],["يا مدخل الذلّ على قومه","بعداً وسحقا لك من هالك",56,"ك",1,1],["يا مدير الكؤوس من مقلتيه","أنت جرعتني الصبابة صرفا",57,"ف",2,0],["يا مُدبراً فيما مضى","كُن مُقبلاً في ذا الأوان",58,"ن",1,0],["يا مدرك الأوتار قد طال المدى","طال المدى يا مدرك الأوتار",59,"ر",1,0],["يا مدعي دين المسيح وإنه","ليطول منه لما ادعوه خصام",60,"م",1,0],["يا مدعي آيات موسى عَدِّ عَنْ","منى غدوت تابعاً ظلالها",61,"ل",3,0],["يا مدعي شأو موسى إن عزمتَ على","تبيين فضلك في مضمار حَلْبته",62,"ت",2,0],["يا مدعي الوجد المبرح والجوى","خدن ولو نودي لما سمع الندا",63,"د",2,0],["يامدعي للنايبات بحوطها","ويهين اعناق الحوادث والعدا",63,"د",2,0],["يا مدّعي من ربه المواهب","مالك تكلف قلبك المكاسب",64,"ب",1,0],["يا مدير الكؤوس قم واجل بكراً","عنست في الدنان دون افتراش",65,"ش",1,0],["يا مديد الهجر واصلني يا من","أنت عندي مثل عقلي وديني",66,"ي",1,0],["يا مدلجاً في حندس ال","ظلماء بكراً مقحما",67,"م",2,1],["يا مدره المرأة مهتوكة","ويا محامى النذل والأرعن",68,"ن",1,0],["يا مُديراً من سحر عينيه خمراً","أنا ممّا أدرت جدّ نزيف",69,"ف",1,1],["يا مدركاً شأو علا وسؤدد","يفوت سبق الطالبين أمده",70,"د",2,0],["يا مدلج السير في مشبوبة قطعت","بيد القفار طوت سهلا على حدب",71,"ب",1,1],["يا مدار الأمور في النشر والطي","وعنان البرهان في دولة الحي",72,"ي",1,0],["يا مديراً ما لم تشب بالثنايا","أحميما وردتها أم حماما",73,"م",2,0],["يا مدع أن له ثانيا","بناه ذو أمر ونهي وشاد",74,"د",1,0],["يا مدَّعي مني الصدود تظلماً","مهلاً فقد قاربت حد المأثم",75,"م",1,0],["يا مدخلي نار الهوى","نارُ الهوى للظالمينا",76,"ن",2,0],["يا مدلجاً بأمون رسلة اجد","ما سام أخفافها أين ولا ضجر",77,"ر",1,0],["يا مدير الكؤس يا مازج الرا","ح بظلم من ثغرك البسام",78,"م",1,0],["يا مدير الكاس حييتَ","على الكاسِ مُديا",79,"ي",2,1],["يا مدلجي ليلهم أقيموا","فقد تراءَت لنا الرسومُ",80,"م",1,1],["يا مدهش الألباب والفطن","ومحير التقوالة اللسن",81,"ن",1,1],["يا مديراً ما لم تشب بالثنايا","أحميماً أدرتها أم حماما",82,"م",2,0],["يا مدلجون أقيموا خلفكم كبد","أتعبتموها وجفن ماؤه هملا",83,"ل",2,0],["يا مدّعي في هوى الحُس","نِ وَالغرامِ الإِمامَه",84,"م",2,1],["يا مدعي الفضل دُون الفضل مخترق","وَما أَخالك تَطوي كُل مخترق",85,"ق",1,0],["يا مدركا خلف الإمام ركوعه","هي ركعة ما أدركت فدع اللهج",86,"ج",1,0],["يا مدعي له الشريك في الأدب","ما كان في تثنية له وجب",87,"ب",1,0],["يا مُدلجاً يَنشر طيبَ الكرى","على الروابي حينَ يطوى البِطاح",88,"ح",1,0],["يا مُدلجاً في السُرى وَالحَزمُ يَصحَبُهُ","ليَحمدنَّ سُراكَ الحاذِقُ الفهمُ",89,"م",1,0],["يا مدنفَ الأجفانِ صِل مُدنفاً","ضلَّ له المُسعد والعاذلُ",90,"ل",1,0],["يامدعين العدل وش صار؟ بالشام ؟","شنت عليه أعداء الأمه هجومي",91,"م",2,1],["يا مداد اكتُبَنَّ إن شئت عمَّن","ساد في الخافقين فضلاً عظيما",92,"م",2,1],["يا مدَّعي العدل رفقا في إمرىءٍ دنفٍ","قد ملَّ منكم،وما أبرمتمُ نقضا",93,"ض",2,0],["يامدور الزله ترى عندي ادواك","اسمع كلامٍ عارف انه يداويك",94,"ك",1,1],["يامدلله توّك صغيره على الحب","وقلبك رهيّف مايتحمّل عذابه",95,"ب",2,1],["يا مدلله تعبت من سيرة الحب","وماعاد فيني حمل اجاري عذابه",95,"ب",2,0],["يا مدرك الأبصار والأبصار لا","تدري له ولكنهه إدراكا",96,"ك",2,0],["يامدعين الشعر خلوه خلوه","صرنا نشوف الغث جنب السمينا",97,"ن",2,1],["يا مدعي للصمت هذا علاجه","تأخذ خيوط الشمس والليل مذخور",98,"ر",1,0],["يا مدهمات الوقت الزين لو غالي","فيه الجفا والصد عيبٍ تعدابه",99,"ب",2,0],["يَا مِدَادِي لَمْ تَخُنِّي","حِيِنَ لَفَّ الْحُبُّ حِبْرَا",100,"ر",2,0],["يا مدعي الحب قد أخطأت معناه","هلا رأفت بقلب بات مضناه",101,"ا",2,1],["يَا مُدْخِلي بِالْهَجْرِ ذَاتَ وَقودِ","مَنْ صَارَ مِنْ قَتْلاَكَ خَيْرُ شَهِيدِ(١)",102,"د",1,1],["يَا مُدَّعِي سَفَهًا مَوَدَّةَ أَحْمَدٍ","أَ بِقَتْلِِهِ تَبْغِي إِلَيْهِ تَوَسُّلَا؟",103,"ل",2,0],["يامدمن الهم كافي دمع بالليلي","بكره بتشبع من الدنيا ومصايبها",104,"ب",3,0],["يامدعي الشعرَ ملتاعا بأبحره","مهلهل النظم مهزوما ومرتعدا",105,"د",2,0],["يَا مُدْلِجِينَ أَلَمْ يُتْعِبْكُمُ الأَلَمُ..?!","أَتْعَبْتُمُ اللَّيْلَ مَلَّتْ مِنْكُمُ الظُّلَمُ..!",106,"م",1,1],["يَا مُدْلِجِينَ ..ذِئَابُ اللَّيْلِ عَاوِيَةٌ","مِنْ حَوْلِكُمْ وَ لَهِيبُ الشَّرِّ يَحْتَدِمُ..",106,"م",1,0],["يا مدور الهين ترى الكايد احلى","واسأل مغني كايدات الطروقي",107,"ق",2,1],["يامدعي نظم الشعر والكتابه","اكتب على اسوار كم بأول الحي",108,"ي",1,1],["يامدير الكأس...والقلب ارتوى","بحميا الوجد ...خفت المحتوى",109,"و",2,0],["يا مدير العطر فينا ما تشا","اسكبت العطر من مسك الرشا",110,"ش",2,1],["يامدور للأماره على النور القصير","الأماره مركبٍ صعب ماكلٍ قواه",111,"ا",2,0],["يا مدلج التين بين العود والكُثبِ","يا احلى ما افصح الرمان عن كَثبِ",112,"ب",1,0],["يا مدية تسامر القتيل","تغلغل الوريد هكذا",113,"ذ",2,0],["يامُدنفاً بالأزرقيةِ قلبُهُ","والدارُ قفرٌ بالبُرَيقةِ بلقعُ",114,"ع",1,0],["يا مدلاً لمن تعزز تيها","عزلي أن ينال منك منالا",115,"ل",2,0],["يامدلعن مدحت/ بحضرة طوني","انا لساني لا بغيت حصاني",116,"ن",2,0],["يامدمزيل ياللي ف قصرك يازينه عصرك","المبسط يحبك على خصرك يتهز قوام",117,"م",1,1],["يا مدعي عام اللواء وخير من فهم القضية","ومناط آمال القضاة وحرز إنصاف الرعية",118,"ي",2,1]]}