{"poems":[[77,"العمر نوم والمنى أحلام","https://www.aldiwan.net/poem36107.html","الكامل"],[86,"عجبت أن جعلوا يوماً لذكراكا","https://www.aldiwan.net/poem10468.html","البسيط"],[72,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[72,"يا مديد النوال دعوة راج","https://www.aldiwan.net/poem19227.html","الخفيف"],[51,"يا مددي حين خانني مددي","https://www.aldiwan.net/poem61907.html","المنسرح"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[56,"عين بكت وادي العقيق بمثله","https://www.aldiwan.net/poem58922.html","الكامل"],[61,"أمقدم يا أبا المقدام أنت على","https://www.aldiwan.net/poem51756.html","البسيط"],[52,"يا مدخل الصلع حماما يزيدهم","https://www.aldiwan.net/poem27137.html","البسيط"],[76,"يا مدير الصدغ في الخد الأسيل","https://www.aldiwan.net/poem39241.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55384","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[99,"الرجل الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=190720",""],[115,"يا نعم حسبك ان عين زماني","https://www.aldiwan.net/poem40475.html","عموديه"],[124,"هب الهوا وشجاك أن نسيمه","https://www.aldiwan.net/poem23707.html","الكامل"],[124,"يا مدعي عام اللواء","https://www.aldiwan.net/poem23712.html","مجزوء الكامل"],[132,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[150,"يا مدمن الخمر غير آل","https://www.aldiwan.net/poem68527.html","مخلع البسيط"],[199,"يا مدني الجمرة من خده","https://www.aldiwan.net/poem45170.html","السريع"],[222,"يهيم قلبي بمن رقت شمائله","https://www.aldiwan.net/poem55412.html","البسيط"],[232,"قلت إن القضيب يحكيك عطفا","https://www.aldiwan.net/poem14754.html","الخفيف"],[235,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[250,"عودته أنه يجني وأعتذر","https://www.aldiwan.net/poem14956.html","البسيط"],[271,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[282,"لا والمطايا ذللا في البرى","https://www.aldiwan.net/poem32765.html","السريع"],[342,"يا مدعي حب رب العرش مستترا","https://www.aldiwan.net/poem55369.html","البسيط"],[342,"يا مدعي الشعر زوراً","https://www.aldiwan.net/poem55372.html","المجتث"],[364,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[393,"إذا تراخى مديحي آل يسينا","https://www.aldiwan.net/poem53670.html","البسيط"],[409,"يا مدعي الصبر عن أحبابه وله","https://www.aldiwan.net/poem31831.html","عموديه"],[409,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[437,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[441,"يا راقد الليل إن الليل قد صدرا","https://www.aldiwan.net/poem14367.html","البسيط"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[529,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[558,"يا مدعي للوجود أخطأت عين عين","https://www.aldiwan.net/poem33703.html","المواليا"],[558,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[558,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[586,"يا مدع أن الغرام بقلبه","https://www.aldiwan.net/poem17974.html","الكامل"]],"verses":[["يَا مَدْفَنَ التَّقْوَى وَيَا مَثْوَى الْهُدَى","مِنِّي عَلَيْكَ تَحِيَّةٌ وَسَلاَمُ",0,"م",1,0],["يا مُدمِنَ الذِكرِ وَالتَسبيحِ مُحتَسِباً","ها أَنتَ في الخُلدِ قَد جاوَرتَ مَولاكا",1,"ك",2,0],["يا مدْملَ الجرح بألفاظه","وناهياً للدّهر عما اجترح",2,"ح",1,0],["يا مديدَ النوال دعوة راجٍ","حثّه جودك البسيطُ السريع",3,"ع",1,1],["يا مَددي حين خانني مددي","وعُدَّتي إذ تعذَّرت عُددي",4,"د",2,1],["يا مُديمَ الصَومِ في الشَهرِ الكَريم","صُم عَنِ الغيبَةِ يَوماً وَالنَميم",5,"م",1,0],["يا مُدنفاً يحييهِ ثم يَميتهَ","قربٌ وبعدٌ في الضنين بوصلهِ",6,"ل",2,0],["يا مُدَّعي الشِّعْرِ كُنْ منه على وَجَلٍ","فقد مُنِيتَ بشيطانٍ له عاتي",7,"ي",1,0],["يا مُدخِلَ الصُلعِ حَمّاماً يَزيدُهُمُ","بِطولِ مُكثِهِمُ في جَوفِهِ وَسَخا",8,"خ",2,1],["يا مُديرَ الصُّدغ في الخَدِّ الأَسيلْ","ومُجيلَ السِّحر بالطَّرفِ الكحيلْ",9,"ل",1,1],["يَا مُدْمِجاً تَاجَيْ مِنَا","فِي تَاجِ فَارُوقِ الزَّمَانِ",10,"ن",1,0],["يَا مُدْنِيَ الأَرَبِ البَعِيدِ مَنَالُهُ","وَلَقَدْ أَقُولُ مُنِيلُ كُلِّ رَجَاءِ",11,"ا",2,0],["يا مُدرِكاً أَكبَرَتهُ مُدرِكَةٌ","فَلَم يَزَل مِن كِبارِها البُلَغا",12,"غ",2,0],["يا مُدانينَ اضاعُوا وطناً","هو للحشرِ بمن فيه مدين",13,"ن",1,0],["يا مدفن الثلج .. هل غيري يزاحمُني؟","وهل سريرُ الهوى ما عادَ مُنفرِدا",14,"د",2,0],["يا مدلج العيس اتئد بوركت من","رجل يثير عزائم الركبان",15,"ن",1,0],["يا مدعي عام اللواء بلاؤنا","سيظل مهما خصصوه عمومي",16,"م",2,0],["يا مدعي عام اللواء","وخير من فهم القضية",17,"ي",2,1],["يا مدعي عام اللواء","وأنت من فهم القضية",17,"ي",2,0],["يا مدمن العصيان طول حياته","يا عيبةً للعيب والأوزار",18,"ر",1,0],["يا مُدمِنَ الخمر غَيرَ آلِ","في تركه أمر ذي الجلالِ",19,"ل",1,1],["يا مُدْنيَ الجمرةَ من خدّهِ","صيّرتَ قلبي بينَ نارينِ",20,"ن",1,1],["يا مدَّعي جمع ما قد حاز من شرف","أفنيت عمرك فيما لا تطاوله",21,"ل",2,0],["يا مُديرَ الكُؤسِ مِن مُقلَتِهِ","أَنتَ جَرَّعتَني الصَبابَةَ صَرفا",22,"ف",2,0],["يا مُديرَ الكُؤوسِ مِن طَرفِهِ ال","فَتّان رِفقاً بِالشارِبِ المَخمورِ",23,"ر",1,0],["يا مُدنَف الخَصرِ قد غادَرتني دَنِفاً","وناعسَ الطرف قد أودى بي السَّهَرُ",24,"ر",1,0],["يا مدع في الفخر نيل مناله","أَعلمت أَنك مدع أَم معتدى",25,"د",2,0],["يا مُدرِكَ الأَوتارِ مِن خَصمِهِ","إِن خَطَفَ القَوسَ وَإِن أَوتَرا",26,"ر",2,0],["يا مدعي حب رب العرش مستترا","بحبك المرأة الحسناء في البشر",27,"ر",1,1],["يا مدعي الشعر زوراً","وانت شر سفيهِ",28,"ي",2,1],["يا مُدرِكاً رُتَباً ما بعدَ ذِرْوتِها","إلاّ الدّوامُ فَدُمْ للمَجْدِ تَدَّرك",29,"ك",1,0],["يا مِدرَهَ الدينِ يا فَردَ اليَقينِ أَصِخ","لِمَدحِ مَولى يَرى تَفضيلَكُم دينا",30,"ن",2,0],["يا مدعي الصبر عن أحبابه وله","دمع إذا حن ذكراهم تكذبه",31,"ب",2,1],["يا مُدَّعِي السُّلوانِ عن أحبابِهِ","أينَ السُّلُوُّ وأينَ منكَ أوانُهُ",32,"ن",2,0],["يا مدحتي فذي أمانا لك من","يا طيف يا اكرم ضيف قد طرق",33,"ق",1,0],["يا مُدْنِيَ الأملِ البعيدِ وإِنْ نَأَى","ومُبَعِّدَ الخطبِ الجليلِ وإِن دَنا",34,"ن",2,0],["يا مدعي الحب للباري أراك على","لين الفراش نزيفاً من كؤوس كرى",35,"ر",2,0],["يا مُدْرَجاً فرداً تُسَدَّى فوقه","بالقاع أرديةُ الثرى وتُنارُ",36,"ر",1,0],["يا مُدَّعِي حُبَّ النَّبيّ وآلِهِ","لَمْ تَدْرِ ما حُبُّ الْكِرامِ الصُّيَّدِ",37,"د",1,0],["يا مدعي للوجود أخطأت عين عينْ","من أين لكْ هذه الدعوى تُرى من أينْ",38,"ن",1,1],["يا مداد الجميع نحن حروف","بك نبدو وأنت بالمرصاد",39,"د",1,0],["يا مدعي العرفان فجرك كاذبُ","لم يدخل الوقت الذي هو واجبُ",40,"ب",1,1],["يا مُدَّعٍ أَنَّ الغَرامَ بِقَلْبهِ","أَفنْى تَجلُّدَه وطَارَ بِلبِّهِ",41,"ب",2,1]]}