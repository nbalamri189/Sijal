{"poems":[[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[88,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[27,"ألا حي ليلى إذ أجد اجتنابها","https://www.aldiwan.net/poem5681.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[72,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"للمادحون اليوم أهل زماننا","https://www.aldiwan.net/poem66502.html","الكامل"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[43,"بنا منك فوق الرمل ما بك في الرمل","https://www.aldiwan.net/poem9926.html","الطويل"],[45,"يا مغاني الأحباب صرت رسوما","https://www.aldiwan.net/poem65684.html","الخفيف"],[49,"أما بيوتك في الدنيا فواسعة","https://www.aldiwan.net/poem62161.html","البسيط"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[44,"شعري أنى هربت في الطلب","https://www.aldiwan.net/poem30070.html","المنسرح"],[87,"أي فتى للعظيم نندبه","https://www.aldiwan.net/poem8283.html","المنسرح"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[48,"يا عمرو من لم يختنق","https://www.aldiwan.net/poem64444.html","مجزوء الرجز"],[46,"يا قلب لا أدعوك في أكرومة","https://www.aldiwan.net/poem22912.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42708","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54737","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/199536","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141991","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[80,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""]],"verses":[["أيُفتَح بابه فيكون حرّاً","لمن يُزجي بلجّته السفينا",0,"ن",2,0],["أيّ فضل لعالم غير بدع","ليس في العلمُ يرتجي للمهمّ",1,"م",1,0],["أيّ فخر للناعمين بعيش","لم تجلّله عزّة قعساء",2,"ا",2,0],["أَيَفخَرُ عَبدٌ أُمُّهُ تَغلِبِيَّةٌ","قَدِ اِخضَرَّ مِن أَكلِ الخَنانيصِ نابُها",3,"ب",3,0],["أَيَفخَرُ بِالمُحَمَّمِ قَينُ لَيلى","وَبِالكيرِ المُرَقَّعِ وَالعَلاةِ",4,"ه",1,0],["أَيُفايِشونَ وَقَد رَأَوا حُفّاثَهُم","قَد عَضَّهُ فَقَضى عَلَيهِ الأَشجَعُ",5,"ع",1,0],["أَيُفايِشونَ وَلَم تَزِن أَيّامُهُم","أَيّامَنا وَلَنا اليَفاعُ الأَرفَعُ",5,"ع",1,0],["أيُّ فرع جونٍ على عنتِ الأيا","مِ يبقى وأيُّ غصنٍ رطيب",6,"ب",1,0],["أيّ فرع نما فمدّ ظلاله","سابغاً ذيلها على الطلاّب",7,"ب",1,0],["أي فخرٍ أم أيُّ مجد رفيع","لم تكن من سمائِه بعَنان",8,"ن",1,0],["أيفيدهم أسفاً ويطلب رِفدَهُم","لقد اعتدى وألظَّ في العدوان",9,"ن",1,0],["أَيُّ فَتىً ذَلِكُن","نَ العَرَبِيَّ العَلَم",10,"م",1,0],["أَيَفطِمُهُ التَورابُ قَبلَ فِطامِهِ","وَيَأكُلُهُ قَبلَ البُلوغِ إِلى الأَكلِ",11,"ل",1,0],["أَيُّ فَضلٍ وَأَيُّ بَذلٍ وَجودٍ","لَم يُحالِف ذا الجودِ إِبراهيما",12,"م",2,0],["أَيَفرَحُ الناسُ بِالدُنيا وَقَد عَلِموا","أَنَّ المَنازِلَ في لَذّاتِنا قَلَعُ",13,"ع",1,0],["أيُّ فَيءٍ لمن يصيرُ تراباً","مُحِيَتْ مِنهُ صورَةُ البَشَريِّ",14,"ي",1,0],["أيّ فضلٍ نبكيه منكَ بدمعٍ","ساكبٍ فيه كلّ نفسٍ تسيلُ",15,"ل",1,0],["أَيُّ فَتىً مِنهُمُ أَشاحَ فَلَم","يُصَب غَداةَ الوَغى وَلَم يُصِبِ",16,"ب",1,0],["أَيُّ فَتَىً لِلْعَظِيمِ نَنْدُبُهُ","شَاطَ عَلَى أَنْصُلِ الرِّمَاحِ دَمُهْ",17,"م",2,1],["أيفزع من صليل السيف قوم","بغير نفوسهم فتك الضراب",18,"ب",1,0],["أَيُّ فَتىً في أُفُقٍ","وَروحُهُ في أُفُقِ",19,"ق",1,0],["أَيَفُكُّني هَذا الحِمامُ تَفَضُّلاً","فَالعَيشُ أَوثَقَني وَشَدَّ رِباطا",20,"ط",2,0],["أَيُّ فُؤَادٍ بِكِ لَمْ يَعْلَقِ","وَأَنْتِ صِنْوُ الْقَمَرِ الْمُشْرِقِ",21,"ق",1,0],["أَيَفوتُنَا ضَمُّ الْقُوَى وَبِضَمِّهَا","نَعْتَدُّ لِلدُّنْيَا أَشَدَّ عَتادِ",22,"د",1,0],["أَيْ فَاقِديهِ لَقَدْ تَكَاثَرَ مَا","جَمَعَتْ رَزَايَا الدَّهْرِ فِي فَقْدِ",23,"د",1,0],["أَيْ فَتَى الأَرْزِ هَلْ أَرَدْتَ مِنَ الدُّنْ","يَا سِوَى مَا يَعُزُّ كُلَّ مُرِيدِ",24,"د",1,0],["أَيُّ فَيْضٍ يَصُبُّ صَبَّ الْجِرَاحا","تِ دَماً فِي نَثِيرِهِ وَالْقَصِيدِ",24,"د",1,0],["أيُّ فَتْحٍ كَفَتْحِ هَذَا النَّادِي","لِرُقِيِّ الْحِمَى وَأَمْنِ الْعِبَادِ",25,"د",1,1],["أَيَفِي بِمَا افْتَرَضَتْ عَلَى أُدَبَائِهَا","أَنْ يُحْسِنُوا المَكْتُوبَ وَالمَنْطُوقَا",26,"ق",2,0],["أي فتى انت؟ فقلت: امرؤ","ليس بذي خب ولا مكر",27,"ر",1,0],["أيفرضونَ على مثلي ملابِسَهم","ويسالون ثيابي عن نياشينِ",28,"ن",1,1],["أي فتى الأرز هب نستبق الفجر","بفجر من ناظريك أطلا",29,"ل",2,0],["أي فرق ما بين ذاك وهذا؟","ذا هزيل وذاك يبدو سمينا",30,"ن",2,0],["أيّ فنّ أشدو وماذا أغنّي","ك وفنّ الجمال أسمى وأقوى",31,"و",2,0],["ايفى النجمَ فيبقى ساهراً","مُحيياً سودَ الليالي ونخون",32,"ن",1,0],["أيُّ فْيء لم يصيرُ تراباً","مُحِيَتْ مِنْهُ صورَة ُ البَشَريّ",33,"ي",1,0],["أي فخر أم أي فخر أم أيُّ مجد رفيع","لم تكن من سمائِه بعَنان",34,"ن",1,0]]}