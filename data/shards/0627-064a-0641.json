{"poems":[[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[88,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[27,"ألا حي ليلى إذ أجد اجتنابها","https://www.aldiwan.net/poem5681.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[72,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"للمادحون اليوم أهل زماننا","https://www.aldiwan.net/poem66502.html","الكامل"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[43,"بنا منك فوق الرمل ما بك في الرمل","https://www.aldiwan.net/poem9926.html","الطويل"],[45,"يا مغاني الأحباب صرت رسوما","https://www.aldiwan.net/poem65684.html","الخفيف"],[49,"أما بيوتك في الدنيا فواسعة","https://www.aldiwan.net/poem62161.html","البسيط"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[44,"شعري أنى هربت في الطلب","https://www.aldiwan.net/poem30070.html","المنسرح"],[87,"أي فتى للعظيم نندبه","https://www.aldiwan.net/poem8283.html","المنسرح"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[48,"يا عمرو من لم يختنق","https://www.aldiwan.net/poem64444.html","مجزوء الرجز"],[46,"يا قلب لا أدعوك في أكرومة","https://www.aldiwan.net/poem22912.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42708","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54737","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/199536","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141991","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[80,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[133,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[136,"أحسن الأيام أيام التلاق","https://www.aldiwan.net/poem49117.html","الرمل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[230,"إنما تكرم الطباع إذا ما","https://www.aldiwan.net/poem50853.html","الخفيف"],[236,"أي فقير بعطاياك يا","https://www.aldiwan.net/poem31908.html","السريع"],[238,"يا بدورا لست عنها بصاح","https://www.aldiwan.net/poem18118.html","المديد"],[271,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[283,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[283,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[299,"أتروي قصيدا أذهب النفس حسرة","https://www.aldiwan.net/poem36274.html","عموديه"],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[321,"أي وقت وأي هائل طقس","https://www.aldiwan.net/poem61667.html","الخفيف"],[321,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[329,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[365,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[381,"أيها المعرض الذي قد جفاني","https://www.aldiwan.net/poem48750.html","الخفيف"],[401,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[404,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[433,"يا علي الذي دعوه عليا","https://www.aldiwan.net/poem12320.html","الخفيف"],[433,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[433,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[433,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[454,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[454,"إرفيني إلى سمائك حتى","https://www.aldiwan.net/poem61563.html","الخفيف"],[465,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[480,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"],[552,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[552,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[552,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[576,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[576,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["أيُفتَح بابه فيكون حرّاً","لمن يُزجي بلجّته السفينا",0,"ن",2,0],["أيّ فضل لعالم غير بدع","ليس في العلمُ يرتجي للمهمّ",1,"م",1,0],["أيّ فخر للناعمين بعيش","لم تجلّله عزّة قعساء",2,"ا",2,0],["أَيَفخَرُ عَبدٌ أُمُّهُ تَغلِبِيَّةٌ","قَدِ اِخضَرَّ مِن أَكلِ الخَنانيصِ نابُها",3,"ب",3,0],["أَيَفخَرُ بِالمُحَمَّمِ قَينُ لَيلى","وَبِالكيرِ المُرَقَّعِ وَالعَلاةِ",4,"ه",1,0],["أَيُفايِشونَ وَقَد رَأَوا حُفّاثَهُم","قَد عَضَّهُ فَقَضى عَلَيهِ الأَشجَعُ",5,"ع",1,0],["أَيُفايِشونَ وَلَم تَزِن أَيّامُهُم","أَيّامَنا وَلَنا اليَفاعُ الأَرفَعُ",5,"ع",1,0],["أيُّ فرع جونٍ على عنتِ الأيا","مِ يبقى وأيُّ غصنٍ رطيب",6,"ب",1,0],["أيّ فرع نما فمدّ ظلاله","سابغاً ذيلها على الطلاّب",7,"ب",1,0],["أي فخرٍ أم أيُّ مجد رفيع","لم تكن من سمائِه بعَنان",8,"ن",1,0],["أيفيدهم أسفاً ويطلب رِفدَهُم","لقد اعتدى وألظَّ في العدوان",9,"ن",1,0],["أَيُّ فَتىً ذَلِكُن","نَ العَرَبِيَّ العَلَم",10,"م",1,0],["أَيَفطِمُهُ التَورابُ قَبلَ فِطامِهِ","وَيَأكُلُهُ قَبلَ البُلوغِ إِلى الأَكلِ",11,"ل",1,0],["أَيُّ فَضلٍ وَأَيُّ بَذلٍ وَجودٍ","لَم يُحالِف ذا الجودِ إِبراهيما",12,"م",2,0],["أَيَفرَحُ الناسُ بِالدُنيا وَقَد عَلِموا","أَنَّ المَنازِلَ في لَذّاتِنا قَلَعُ",13,"ع",1,0],["أيُّ فَيءٍ لمن يصيرُ تراباً","مُحِيَتْ مِنهُ صورَةُ البَشَريِّ",14,"ي",1,0],["أيّ فضلٍ نبكيه منكَ بدمعٍ","ساكبٍ فيه كلّ نفسٍ تسيلُ",15,"ل",1,0],["أَيُّ فَتىً مِنهُمُ أَشاحَ فَلَم","يُصَب غَداةَ الوَغى وَلَم يُصِبِ",16,"ب",1,0],["أَيُّ فَتَىً لِلْعَظِيمِ نَنْدُبُهُ","شَاطَ عَلَى أَنْصُلِ الرِّمَاحِ دَمُهْ",17,"م",2,1],["أيفزع من صليل السيف قوم","بغير نفوسهم فتك الضراب",18,"ب",1,0],["أَيُّ فَتىً في أُفُقٍ","وَروحُهُ في أُفُقِ",19,"ق",1,0],["أَيَفُكُّني هَذا الحِمامُ تَفَضُّلاً","فَالعَيشُ أَوثَقَني وَشَدَّ رِباطا",20,"ط",2,0],["أَيُّ فُؤَادٍ بِكِ لَمْ يَعْلَقِ","وَأَنْتِ صِنْوُ الْقَمَرِ الْمُشْرِقِ",21,"ق",1,0],["أَيَفوتُنَا ضَمُّ الْقُوَى وَبِضَمِّهَا","نَعْتَدُّ لِلدُّنْيَا أَشَدَّ عَتادِ",22,"د",1,0],["أَيْ فَاقِديهِ لَقَدْ تَكَاثَرَ مَا","جَمَعَتْ رَزَايَا الدَّهْرِ فِي فَقْدِ",23,"د",1,0],["أَيْ فَتَى الأَرْزِ هَلْ أَرَدْتَ مِنَ الدُّنْ","يَا سِوَى مَا يَعُزُّ كُلَّ مُرِيدِ",24,"د",1,0],["أَيُّ فَيْضٍ يَصُبُّ صَبَّ الْجِرَاحا","تِ دَماً فِي نَثِيرِهِ وَالْقَصِيدِ",24,"د",1,0],["أيُّ فَتْحٍ كَفَتْحِ هَذَا النَّادِي","لِرُقِيِّ الْحِمَى وَأَمْنِ الْعِبَادِ",25,"د",1,1],["أَيَفِي بِمَا افْتَرَضَتْ عَلَى أُدَبَائِهَا","أَنْ يُحْسِنُوا المَكْتُوبَ وَالمَنْطُوقَا",26,"ق",2,0],["أي فتى انت؟ فقلت: امرؤ","ليس بذي خب ولا مكر",27,"ر",1,0],["أيفرضونَ على مثلي ملابِسَهم","ويسالون ثيابي عن نياشينِ",28,"ن",1,1],["أي فتى الأرز هب نستبق الفجر","بفجر من ناظريك أطلا",29,"ل",2,0],["أي فرق ما بين ذاك وهذا؟","ذا هزيل وذاك يبدو سمينا",30,"ن",2,0],["أيّ فنّ أشدو وماذا أغنّي","ك وفنّ الجمال أسمى وأقوى",31,"و",2,0],["ايفى النجمَ فيبقى ساهراً","مُحيياً سودَ الليالي ونخون",32,"ن",1,0],["أيُّ فْيء لم يصيرُ تراباً","مُحِيَتْ مِنْهُ صورَة ُ البَشَريّ",33,"ي",1,0],["أي فخر أم أي فخر أم أيُّ مجد رفيع","لم تكن من سمائِه بعَنان",34,"ن",1,0],["أيفتخر الفويسق بعد هذا","ويهجونا ببطل إذ فلانا",35,"ن",2,0],["أي فنّ ليس فيهِ مفرداً","أو سياق لم يحز فيه السباقْ",36,"ق",1,0],["أيُّ فَتحٍ للمُصطفى كان فيه","فوقَ عرشِ البيتِ الحرامِ اِستواءُ",37,"ا",2,0],["أيّ فتحٍ للمصطفى كان عرساً","ولأمّ القرى عليه جلاءُ",37,"ا",2,0],["أيّ فتحٍ للمصطفى كان ديناً","فَوفتهُ الغرامة الغرماءُ",37,"ا",2,0],["أيّ فَتحٍ لوقعهِ اِهتزّت الأر","ضُ سروراً وشاركتها السماءُ",37,"ا",2,0],["أيّ فَتحٍ منه أتى كلّ فتحٍ","مُنِحَته الغزاةُ والأولياءُ",37,"ا",2,0],["أيُّ فَتحٍ بهِ على كلّ خلق ال","لَهِ للمُصطفى اليد البيضاءُ",37,"ا",2,0],["أيُّ فَتحٍ قد كانَ في الشرقِ والغر","بِ وَما فيه من قريشٍ لواءُ",37,"ا",2,0],["أيُّ فَضْل لم يُعْطِكَ اللهُ منهُ","رتبةً لم يَجُدْ بها لِفَضيل",38,"ل",1,0],["أَيُّ فَقيرٍ بِعَطاياكِ يا","خَيرَ نِساءِ الخَلقِ لَم يُنعَشِ",39,"ش",1,1],["أيَفَيِ شِعْرٌ بِمَدْحِ امْرِئٍ","حَازَ عِلْماً ضَاقَ عَنْهُ الْبَرَاحْ",40,"ح",1,0],["أَيُفرّقُ الغرباءُ إخواناً لهم","دارُ الخلافة رحبةَ المستجمِر",41,"ر",1,0],["أَيُفيقُ مِن سُكرِ الصبابَةِ بَعدَهُم","مَن كانَ لا يَصحو وَهُم جيرانُهُ",42,"ن",2,0],["أَيفيقُ مِن سُكرِ الصَبابَةِ عاشِقٌ","دارَت عَلَيهِ مِنَ الهَوى أَقداحُ",43,"ح",1,0],["أَيفرخ روعي أَم تقرُّ مضاجعي","وَقد نزلتْ بي كلُّ داهيةٍ دهما",44,"م",2,0],["أيّ فضلٍ بهِ أَحاطَت يداهُ","وَعلى ما تناولته يدانِ",45,"ن",1,0],["أَيُّ فَخرٍ فَإِنَّ غَضَبي الناري","قَد يُضاهي غَضَبُ الإِلَهِ الباري",46,"ي",1,0],["أَيُّ فَوزٍ وَصَلاحِ","نالَنا أَم أَيُّ خَيرُهُ",47,"ر",2,0],["أيُّ فنٍّ سامٍ وأيُّ ابتداعٍ","جملّ من صاغ حسنه وتعالى",48,"ل",2,0],["أَيُفْطَمُ عن لِبانِ العِزِّ مثْلي","وأَعجَبُ حادثٍ شَيْخٌ فَطيم",49,"م",1,0],["أَيَفيقُ الزَمان يَوماً مِن السُكر","وَإِن كانَ مُستَحيل الأَمان",50,"ن",1,0],["أيَّ فجر تعنيه؟ كان سؤالاً","جارحاً من مواجعي وشجوني",51,"ن",2,0],["أي فجرٍ تعنيه، كان سؤالاً","من عجوز تعيش عِيشَةَ هُونِ",51,"ن",1,0],["أيَّ فجر تعنيه، والليلُ أعمى","مزَّق القَصْفُ فيه ثوبَ السُّكونِ؟",51,"ن",1,0],["أيَّ فجرٍ تعنيه، هل هو فجرٌ","من ترانيم شعرك الموزونِ؟؟",51,"ن",1,0],["أي فجر رأيته؟ هل تناءَى","بك وعيٌ عن صرخة من سجينِ؟!",51,"ن",1,0],["أيَّ فجر تعنيه، هل هو فجرٌ","لانتصارات ألْفِنا المليون؟!",51,"ن",1,0],["أيَّ فجر تعنيه ؟ يا لسؤال","مرَّ كالسهم نحو قلبي الحزين؟!",51,"ن",1,0],["أي فضل لذي حياة إذا لم","يسع في دفعه لكل ملمه",52,"م",2,0],["أّيُّ فَضْلٍ للأَصدقاءِ إِذا كُنْ","تَ تراهم بحالةِ الأَعْداءِ",53,"ا",2,0],["أيُّ فَخارٍ قد عَلا متنَهُ","فجاوزَ النجمُ عليه وكادْ",54,"د",1,0],["أيُّ فؤادٍ فيكَ لم يكلَفِ","وأيُّ طرفٍ فيكَ لم يَذْرِفِ",55,"ف",1,1],["أيفْتِكُ في أعدائِه","بمِنْسَرٍ ومِخْلَبِ",56,"ب",1,0],["أي فخر ترجو فرنسا التي","ثارت على الظلم إن تعد هدفه",57,"ف",2,0],["أي فن سأخلق الآن من بع","د بلوغي بقربك الإجلالا",58,"ل",2,0],["أي فرحٍ أبقاهُ في كبد المل","كِ وسقمٍ في مهجة الإسلامِ",59,"م",1,0],["أيفكر في السلو أخو وداد","وتنسيه الليلي صفو أمر",60,"ر",1,0],["أيُّ فتىً من قبل أنْ أرشدتَه","قعقع أبوابَ المعالي فدخَلْ",61,"ل",1,0],["أيُّ فتىً فارقنا عَنْوَةً","رُحِّلَ عنّا قبلَ أن نرحلا",62,"ل",2,0],["أيفخرُ قومٌ ما لهمْ مثلُ مفخري","وأين من النَّهْجِ القويمِ التَعَسُّفُ",63,"ف",1,0],["أيُّ فضلٍ في العقل غيرُ مطاعٍ","واِنتِفاعٌ بالقلب ليس بواعِ",64,"ع",1,0],["أَيُّ فَتىً وورِي في التُّربِ","قضى ولم أقضِ به نَحْبي",65,"ب",2,1],["أَيُّ فنٍّ لحياتي","بعدَ بُعدي عن فِنَائك",66,"ك",1,0],["أيفُلُّ غَرْبي وهْو رَأْ","يُك في يميني وهْوَ عَضْبيِ",67,"ب",2,0]]}