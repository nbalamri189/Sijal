/ViewPoem.aspx?id=155364",""],[5431,"معرة الحزن....","https://www.poetsgate.com/ViewPoem.aspx?id=205574",""],[5431,"أحجية...","https://www.poetsgate.com/ViewPoem.aspx?id=213354",""],[5459,"سلعة بائرة","https://www.poetsgate.com/ViewPoem.aspx?id=211767",""],[5596,"الخسارة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=206771",""],[5736,"لن أعود","https://www.poetsgate.com/ViewPoem.aspx?id=203912",""],[5753,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=210688",""],[5797,"فقيد الدين والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=187796",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[5309,"أيهذا الشادي على الأوتار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573783",""],[6167,"تحت العرش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85552&r=&rc=35",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["أيُفتَح بابه فيكون حرّاً","لمن يُزجي بلجّته السفينا",0,"ن",2,0],["أيّ فضل لعالم غير بدع","ليس في العلمُ يرتجي للمهمّ",1,"م",1,0],["أيّ فخر للناعمين بعيش","لم تجلّله عزّة قعساء",2,"ا",2,0],["أَيَفخَرُ عَبدٌ أُمُّهُ تَغلِبِيَّةٌ","قَدِ اِخضَرَّ مِن أَكلِ الخَنانيصِ نابُها",3,"ب",3,0],["أَيَفخَرُ بِالمُحَمَّمِ قَينُ لَيلى","وَبِالكيرِ المُرَقَّعِ وَالعَلاةِ",4,"ه",1,0],["أَيُفايِشونَ وَقَد رَأَوا حُفّاثَهُم","قَد عَضَّهُ فَقَضى عَلَيهِ الأَشجَعُ",5,"ع",1,0],["أَيُفايِشونَ وَلَم تَزِن أَيّامُهُم","أَيّامَنا وَلَنا اليَفاعُ الأَرفَعُ",5,"ع",1,0],["أيُّ فرع جونٍ على عنتِ الأيا","مِ يبقى وأيُّ غصنٍ رطيب",6,"ب",1,0],["أيّ فرع نما فمدّ ظلاله","سابغاً ذيلها على الطلاّب",7,"ب",1,0],["أي فخرٍ أم أيُّ مجد رفيع","لم تكن من سمائِه بعَنان",8,"ن",1,0],["أيفيدهم أسفاً ويطلب رِفدَهُم","لقد اعتدى وألظَّ في العدوان",9,"ن",1,0],["أَيُّ فَتىً ذَلِكُن","نَ العَرَبِيَّ العَلَم",10,"م",1,0],["أَيَفطِمُهُ التَورابُ قَبلَ فِطامِهِ","وَيَأكُلُهُ قَبلَ البُلوغِ إِلى الأَكلِ",11,"ل",1,0],["أَيُّ فَضلٍ وَأَيُّ بَذلٍ وَجودٍ","لَم يُحالِف ذا الجودِ إِبراهيما",12,"م",2,0],["أَيَفرَحُ الناسُ بِالدُنيا وَقَد عَلِموا","أَنَّ المَنازِلَ في لَذّاتِنا قَلَعُ",13,"ع",1,0],["أيُّ فَيءٍ لمن يصيرُ تراباً","مُحِيَتْ مِنهُ صورَةُ البَشَريِّ",14,"ي",1,0],["أيّ فضلٍ نبكيه منكَ بدمعٍ","ساكبٍ فيه كلّ نفسٍ تسيلُ",15,"ل",1,0],["أَيُّ فَتىً مِنهُمُ أَشاحَ فَلَم","يُصَب غَداةَ الوَغى وَلَم يُصِبِ",16,"ب",1,0],["أَيُّ فَتَىً لِلْعَظِيمِ نَنْدُبُهُ","شَاطَ عَلَى أَنْصُلِ الرِّمَاحِ دَمُهْ",17,"م",2,1],["أيفزع من صليل السيف قوم","بغير نفوسهم فتك الضراب",18,"ب",1,0],["أَيُّ فَتىً في أُفُقٍ","وَروحُهُ في أُفُقِ",19,"ق",1,0],["أَيَفُكُّني هَذا الحِمامُ تَفَضُّلاً","فَالعَيشُ أَوثَقَني وَشَدَّ رِباطا",20,"ط",2,0],["أَيُّ فُؤَادٍ بِكِ لَمْ يَعْلَقِ","وَأَنْتِ صِنْوُ الْقَمَرِ الْمُشْرِقِ",21,"ق",1,0],["أَيَفوتُنَا ضَمُّ الْقُوَى وَبِضَمِّهَا","نَعْتَدُّ لِلدُّنْيَا أَشَدَّ عَتادِ",22,"د",1,0],["أَيْ فَاقِديهِ لَقَدْ تَكَاثَرَ مَا","جَمَعَتْ رَزَايَا الدَّهْرِ فِي فَقْدِ",23,"د",1,0],["أَيْ فَتَى الأَرْزِ هَلْ أَرَدْتَ مِنَ الدُّنْ","يَا سِوَى مَا يَعُزُّ كُلَّ مُرِيدِ",24,"د",1,0],["أَيُّ فَيْضٍ يَصُبُّ صَبَّ الْجِرَاحا","تِ دَماً فِي نَثِيرِهِ وَالْقَصِيدِ",24,"د",1,0],["أيُّ فَتْحٍ كَفَتْحِ هَذَا النَّادِي","لِرُقِيِّ الْحِمَى وَأَمْنِ الْعِبَادِ",25,"د",1,1],["أَيَفِي بِمَا افْتَرَضَتْ عَلَى أُدَبَائِهَا","أَنْ يُحْسِنُوا المَكْتُوبَ وَالمَنْطُوقَا",26,"ق",2,0],["أي فتى انت؟ فقلت: امرؤ","ليس بذي خب ولا مكر",27,"ر",1,0],["أيفرضونَ على مثلي ملابِسَهم","ويسالون ثيابي عن نياشينِ",28,"ن",1,1],["أي فتى الأرز هب نستبق الفجر","بفجر من ناظريك أطلا",29,"ل",2,0],["أي فرق ما بين ذاك وهذا؟","ذا هزيل وذاك يبدو سمينا",30,"ن",2,0],["أيّ فنّ أشدو وماذا أغنّي","ك وفنّ الجمال أسمى وأقوى",31,"و",2,0],["ايفى النجمَ فيبقى ساهراً","مُحيياً سودَ الليالي ونخون",32,"ن",1,0],["أيُّ فْيء لم يصيرُ تراباً","مُحِيَتْ مِنْهُ صورَة ُ البَشَريّ",33,"ي",1,0],["أي فخر أم أي فخر أم أيُّ مجد رفيع","لم تكن من سمائِه بعَنان",34,"ن",1,0],["أيفتخر الفويسق بعد هذا","ويهجونا ببطل إذ فلانا",35,"ن",2,0],["أي فنّ ليس فيهِ مفرداً","أو سياق لم يحز فيه السباقْ",36,"ق",1,0],["أيُّ فَتحٍ للمُصطفى كان فيه","فوقَ عرشِ البيتِ الحرامِ اِستواءُ",37,"ا",2,0],["أيّ فتحٍ للمصطفى كان عرساً","ولأمّ القرى عليه جلاءُ",37,"ا",2,0],["أيّ فتحٍ للمصطفى كان ديناً","فَوفتهُ الغرامة الغرماءُ",37,"ا",2,0],["أيّ فَتحٍ لوقعهِ اِهتزّت الأر","ضُ سروراً وشاركتها السماءُ",37,"ا",2,0],["أيّ فَتحٍ منه أتى كلّ فتحٍ","مُنِحَته الغزاةُ والأولياءُ",37,"ا",2,0],["أيُّ فَتحٍ بهِ على كلّ خلق ال","لَهِ للمُصطفى اليد البيضاءُ",37,"ا",2,0],["أيُّ فَتحٍ قد كانَ في الشرقِ والغر","بِ وَما فيه من قريشٍ لواءُ",37,"ا",2,0],["أيُّ فَضْل لم يُعْطِكَ اللهُ منهُ","رتبةً لم يَجُدْ بها لِفَضيل",38,"ل",1,0],["أَيُّ فَقيرٍ بِعَطاياكِ يا","خَيرَ نِساءِ الخَلقِ لَم يُنعَشِ",39,"ش",1,1],["أيَفَيِ شِعْرٌ بِمَدْحِ امْرِئٍ","حَازَ عِلْماً ضَاقَ عَنْهُ الْبَرَاحْ",40,"ح",1,0],["أَيُفرّقُ الغرباءُ إخواناً لهم","دارُ الخلافة رحبةَ المستجمِر",41,"ر",1,0],["أَيُفيقُ مِن سُكرِ الصبابَةِ بَعدَهُم","مَن كانَ لا يَصحو وَهُم جيرانُهُ",42,"ن",2,0],["أَيفيقُ مِن سُكرِ الصَبابَةِ عاشِقٌ","دارَت عَلَيهِ مِنَ الهَوى أَقداحُ",43,"ح",1,0],["أَيفرخ روعي أَم تقرُّ مضاجعي","وَقد نزلتْ بي كلُّ داهيةٍ دهما",44,"م",2,0],["أيّ فضلٍ بهِ أَحاطَت يداهُ","وَعلى ما تناولته يدانِ",45,"ن",1,0],["أَيُّ فَخرٍ فَإِنَّ غَضَبي الناري","قَد يُضاهي غَضَبُ الإِلَهِ الباري",46,"ي",1,0],["أَيُّ فَوزٍ وَصَلاحِ","نالَنا أَم أَيُّ خَيرُهُ",47,"ر",2,0],["أيُّ فنٍّ سامٍ وأيُّ ابتداعٍ","جملّ من صاغ حسنه وتعالى",48,"ل",2,0],["أَيُفْطَمُ عن لِبانِ العِزِّ مثْلي","وأَعجَبُ حادثٍ شَيْخٌ فَطيم",49,"م",1,0],["أَيَفيقُ الزَمان يَوماً مِن السُكر","وَإِن كانَ مُستَحيل الأَمان",50,"ن",1,0],["أيَّ فجر تعنيه؟ كان سؤالاً","جارحاً من مواجعي وشجوني",51,"ن",2,0],["أي فجرٍ تعنيه، كان سؤالاً","من عجوز تعيش عِيشَةَ هُونِ",51,"ن",1,0],["أيَّ فجر تعنيه، والليلُ أعمى","مزَّق القَصْفُ فيه ثوبَ السُّكونِ؟",51,"ن",1,0],["أيَّ فجرٍ تعنيه، هل هو فجرٌ","من ترانيم شعرك الموزونِ؟؟",51,"ن",1,0],["أي فجر رأيته؟ هل تناءَى","بك وعيٌ عن صرخة من سجينِ؟!",51,"ن",1,0],["أيَّ فجر تعنيه، هل هو فجرٌ","لانتصارات ألْفِنا المليون؟!",51,"ن",1,0],["أيَّ فجر تعنيه ؟ يا لسؤال","مرَّ كالسهم نحو قلبي الحزين؟!",51,"ن",1,0],["أي فضل لذي حياة إذا لم","يسع في دفعه لكل ملمه",52,"م",2,0],["أّيُّ فَضْلٍ للأَصدقاءِ إِذا كُنْ","تَ تراهم بحالةِ الأَعْداءِ",53,"ا",2,0],["أيُّ فَخارٍ قد عَلا متنَهُ","فجاوزَ النجمُ عليه وكادْ",54,"د",1,0],["أيُّ فؤادٍ فيكَ لم يكلَفِ","وأيُّ طرفٍ فيكَ لم يَذْرِفِ",55,"ف",1,1],["أيفْتِكُ في أعدائِه","بمِنْسَرٍ ومِخْلَبِ",56,"ب",1,0],["أي فخر ترجو فرنسا التي","ثارت على الظلم إن تعد هدفه",57,"ف",2,0],["أي فن سأخلق الآن من بع","د بلوغي بقربك الإجلالا",58,"ل",2,0],["أي فرحٍ أبقاهُ في كبد المل","كِ وسقمٍ في مهجة الإسلامِ",59,"م",1,0],["أيفكر في السلو أخو وداد","وتنسيه الليلي صفو أمر",60,"ر",1,0],["أيُّ فتىً من قبل أنْ أرشدتَه","قعقع أبوابَ المعالي فدخَلْ",61,"ل",1,0],["أيُّ فتىً فارقنا عَنْوَةً","رُحِّلَ عنّا قبلَ أن نرحلا",62,"ل",2,0],["أيفخرُ قومٌ ما لهمْ مثلُ مفخري","وأين من النَّهْجِ القويمِ التَعَسُّفُ",63,"ف",1,0],["أيُّ فضلٍ في العقل غيرُ مطاعٍ","واِنتِفاعٌ بالقلب ليس بواعِ",64,"ع",1,0],["أَيُّ فَتىً وورِي في التُّربِ","قضى ولم أقضِ به نَحْبي",65,"ب",2,1],["أَيُّ فنٍّ لحياتي","بعدَ بُعدي عن فِنَائك",66,"ك",1,0],["أيفُلُّ غَرْبي وهْو رَأْ","يُك في يميني وهْوَ عَضْبيِ",67,"ب",2,0],["أيفنى امرؤ في جده واجتهاده","ليحيى معافى آخر متكاسل",68,"ل",1,0],["أَيُّ فَرعٍ لِأَيِّ أَصلٍ لَعَمري","قَد تَحاكى الآباءُ وَالأَبناءُ",69,"ا",2,0],["أي فخر يا أيها الهرمانِ","لكما بعد ذلك الخزانِ",70,"ن",1,1],["أَيُّ فَقير شاعِرٍ أَو عالم","رَأَيتَهُ يُذكر بَينَ العالم",71,"م",1,0],["أي فيهمَا والقول مَفْع","ولانِ لا يعدو السَنَنْ",72,"ن",1,0],["أيفوتني منك السماح بقول من","بيني وبينهم تفاوقت القيم",73,"م",1,0],["أَيُفْشِي إِلى زيدٍ وعمْرٍو حديثَنا","ولولا الضَّنَى لمْ يَدْرِ زَيْدٌ ولا عَمْرُو",74,"ر",2,0],["أي فضلٍ يزويه عنك معاد","أو تزوي شمس الضحى لو تفكر",75,"ر",1,0],["أي فؤاد ظالم أغمدك","من بعد ذاك الجفن في ذا الفؤاد",76,"د",1,0],["أَي فَتى لَم يعب","أَيُّ فَتى لَم يعتب",77,"ب",1,0],["أيّ فجر على جبينك بكر","خنق الليل يا هواي هواه",78,"ا",2,0],["أي فرق بين عين الحالمين