{"poems":[[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[83,"لك الخير يا مولاي أبشر بعصمة","https://www.aldiwan.net/poem54332.html","الطويل"],[88,"خليلي قوما بي لنشهد للربا","https://www.aldiwan.net/poem44422.html","الطويل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[44,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[46,"تشاد المغاني والقبور دوارس","https://www.aldiwan.net/poem22784.html","الطويل"],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[45,"ألم تعلمي يا علو أني معذب","https://www.poetsgate.com/ViewPoem.aspx?id=31414",""]],"verses":[["وَقَد ظَهَرَت أَشياءُ مِنكُم كَثيرَةٌ","وَما كُنتُ مِنكُم مِثلَها أَتَرَقَّبُ",0,"ب",1,0],["وقد ظهرت للبرء منك علامة","علامتك العليا تقول لنا صحا",1,"ح",2,0],["وقد ظلّ من بين الغصون شعاعها","يوقّع دينارً لنا جنب دينار",2,"ر",1,0],["وقد ظننتُ وحولُ الله يعصمني","من ذاك أن نصيبي منك حرمان",3,"ن",1,0],["وَقَد ظَفِرتَ بِهِم وَالرَأسُ مُشتَعِلٌ","كَما ظَفِرتَ بِهِم وَالعُمرُ مُقتَبِلُ",4,"ل",1,0],["وَقَد ظُلِّلَت عِقبانُ أَعلامِهِ ضُحىً","بِعِقبانِ طَيرٍ في الدِماءِ نَواهِلِ",5,"ل",1,0],["وَقَد ظَهَرَت أَملاكُ مِصرَ عَلَيهُمُ","فَهَل مارَسَت مِن ظُلمِها ما تُمارِسُ",6,"س",1,0],["وقد ظنَّ قومٌ أنَّ في الشِعر حاجةً","إلى فاقةٍ تهتزُّ منها المشاعر",7,"ر",1,0],["وقد ظهرت فيه المخازي جليةً","يضيق بها حتى مجالُ التكلُّم",8,"م",1,0],["وقد ظهرت أشياء منكم كثيرة","وما كنت منكم مثلها أرترقب",9,"ب",1,0]]}