{"poems":[[57,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[85,"لك الخير يا مولاي أبشر بعصمة","https://www.aldiwan.net/poem54332.html","الطويل"],[90,"خليلي قوما بي لنشهد للربا","https://www.aldiwan.net/poem44422.html","الطويل"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[93,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[46,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[48,"تشاد المغاني والقبور دوارس","https://www.aldiwan.net/poem22784.html","الطويل"],[92,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[92,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[47,"ألم تعلمي يا علو أني معذب","https://www.poetsgate.com/ViewPoem.aspx?id=31414",""],[136,"تأوبه الخيال وليس يألو","https://www.aldiwan.net/poem54769.html","الوافر"],[154,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[164,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[234,"أتنسى أيها العات","https://www.aldiwan.net/poem51076.html","الهزج"],[242,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[264,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[265,"خليلي لا تستعجلا أن تزودا","https://www.aldiwan.net/poem1103.html",""],[369,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[422,"عشت الزمان بخفض العيش منتصبا","https://www.aldiwan.net/poem53964.html","البسيط"],[435,"أراك سخي الدمع طال بك الأمر","https://www.aldiwan.net/poem41064.html","الطويل"],[443,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[447,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[456,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[473,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[487,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[520,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122592","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87083","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54053","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38065","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38123","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67833","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120025","الوافر"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96573","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96728","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16862","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35388","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44812","الوافر"],[1560,"","https://poetry.dctabudhabi.ae/diwan/poem/130734","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120678","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120677","البسيط"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17734","الطويل"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20685","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93885","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65288","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3168,"","https://poetry.dctabudhabi.ae/diwan/poem/35042","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100184","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62823","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48444","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86284","الطويل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32880","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125908","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119618","الطويل"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204315","الطويل"],[4822,"بحبك أيها الظبي الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=171235",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5485,"افخر أبا جعفر ان كنت مفتخرا","https://www.poetsgate.com/ViewPoem.aspx?id=200787",""],[5690,"إلا أيها المولى الذي نال فضلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=172195",""],[6102,"سِفرُ التَّكوين","https://www.poetsgate.com/ViewPoem.aspx?id=186260",""],[242,"حي على الأنس ان طيف الهموم سرى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563699",""]],"verses":[["وَقَد ظَهَرَت أَشياءُ مِنكُم كَثيرَةٌ","وَما كُنتُ مِنكُم مِثلَها أَتَرَقَّبُ",0,"ب",1,0],["وقد ظهرت للبرء منك علامة","علامتك العليا تقول لنا صحا",1,"ح",2,0],["وقد ظلّ من بين الغصون شعاعها","يوقّع دينارً لنا جنب دينار",2,"ر",1,0],["وقد ظننتُ وحولُ الله يعصمني","من ذاك أن نصيبي منك حرمان",3,"ن",1,0],["وَقَد ظَفِرتَ بِهِم وَالرَأسُ مُشتَعِلٌ","كَما ظَفِرتَ بِهِم وَالعُمرُ مُقتَبِلُ",4,"ل",1,0],["وَقَد ظُلِّلَت عِقبانُ أَعلامِهِ ضُحىً","بِعِقبانِ طَيرٍ في الدِماءِ نَواهِلِ",5,"ل",1,0],["وَقَد ظَهَرَت أَملاكُ مِصرَ عَلَيهُمُ","فَهَل مارَسَت مِن ظُلمِها ما تُمارِسُ",6,"س",1,0],["وقد ظنَّ قومٌ أنَّ في الشِعر حاجةً","إلى فاقةٍ تهتزُّ منها المشاعر",7,"ر",1,0],["وقد ظهرت فيه المخازي جليةً","يضيق بها حتى مجالُ التكلُّم",8,"م",1,0],["وقد ظهرت أشياء منكم كثيرة","وما كنت منكم مثلها أرترقب",9,"ب",1,0],["وقَد ظَعَنَ الأَحِبَّةُ فَاستَمَالُوا","فُؤَادَكَ حِينَ تُعتَسَفُ الرِّمَالُ",10,"ل",1,0],["وقد ظفرت جفونهم","بلذَّتها من الوسن",11,"ن",1,0],["وقد ظهرت سعودك للبرايا","ظهورا دونه الصبح المبين",12,"ن",1,0],["وقد ظلَّلنَا الغيمُ","بمِثْل السَوْسَن النَضْر",13,"ر",1,0],["وَقَدْ ظَفِرْتُ بِمَا كُنْتُ آمُلُهُ","لَمَّا قَضَتْ مُنْيَتِي مِنْ نُورِهِ وَطَرَا",14,"ر",2,0],["وقد ظهرت لكن بعيد بشارتي","زمان اللقا مذ كان مورده وردي",15,"د",2,0],["وَقَد ظَهَرَت مِنهُم بَوائِقُ جَمَّةٌ","وَأَفرَعَ مَولاهُم بِنا ثُمَّ أَصعَدا",16,"د",2,0],["وقد ظَلّ بينَ المُوبذان مكانَه","وشِيرينَ للأبصارِ وهْو قريب",17,"ب",1,0],["وقَد ظلَّلتها للغُبارِ غَمامَةٌ","يَزيدُ عَلى حرِّ الشموسِ ظِلالُها",18,"ل",3,0],["وقد ظهرتَ ظهورَ الصُّبح منبلجاً","فطالما كنتَ قبل اليوم محتجبا",19,"ب",2,0],["وقد ظهر المريخ في سيف لحظها","وقابلت الأقمار فانبهم الأمر",20,"ر",1,0],["وقد ظهرت آياته في جماله","فيا حسنها من معجزات ويا عجبا",21,"ب",2,0],["وقد ظللته بالهجير غمامة","وللشمس في الريد الغاب بمهدنا",22,"ن",2,0],["وقد ظللته في القفار غمامةً","ورأد الضحى بالقوم يهبو الحصى هبوا",23,"و",2,0],["وقد ظن ان القوم سهل قناتهم","ولم يكترث أهل الطعان المميزِ",24,"ز",1,0],["وَقَد ظَهَرَ الآسُ يا زَهرَهُ","فَما أَطيَبَ العَيشَ لَمّا ظَهَر",25,"ر",1,0],["وقد ظفرت روحي بمغنى جمالها","جزافا لقد أمهدت وصل وصاليا",26,"ي",2,0],["وقد ظهرت لما استقرت مذاهب","على مقتضى التربيع تترى اجتهادي",27,"ي",1,0],["وقد ظمئت آمالنا نحو مزنة","ذهاب القوافي أن يظن ذهابها",28,"ب",3,0],["وقد ظَنَّتِ الأتراكُ أن لَيس مَخرجٌ","إليهم وأن لا غزو مِن بَعدش خالد",29,"د",1,0],["وَقَد ظَن أَني بِالكِتابة جاهلٌ","وَنجمي في الإنشا كَبَدرِ تَمام",30,"م",1,0],["وقد ظهرت بالفود منك أدلةٌ","تدل بأن الموت إثرك ذو قص",31,"ص",1,0],["وَقَد ظَنّ حبَّ البيضِ والسّمرِ مُنْجِياً","يُنجِّيهِ مِن قَتلٍ وَقَد مَدَّ آمالَه",32,"ل",2,0],["وَقَد ظَلّتِ العلياءُ تَخدُمُ بَيتَهُ","وَما خَدمَت إِلّا لِخَيرِ المَساكِنِ",33,"ن",1,0],["وَقَد ظَهَرَت لِأُسطول الأَعادي","عَلاماتٌ تَزيدهم اِرتيابا",34,"ب",2,0],["وَقَدْ ظَهَرَتْ آيَاتُهُ وَالْعَجَائِبُ","وَقَدْ نُصِرَتْ أحْزَابُهُ وَالْكَتَائِبُ",35,"ب",1,0],["وقد ظل النسيم الرطب وهنا","يهز فروع بانات وضالِ",36,"ل",1,0],["وقد ظنَّ أنا صادقوه وقد دنا","لنا بَرَدٌ منه تخاف صواعِقُه",37,"ق",2,0],["وَقد ظلمت منها الروادفُ خصرها","كَما كانَ لي من هجرها الحكم ظالما",38,"م",2,0],["وَقَد ظَلَّ يَبغي رائِدُ البَرءِ مورِداً","لَدَيكَ وَيَبغي فارِطُ السَقمِ مَصدَرا",39,"ر",2,0],["وَقَد ظَمِئتُ لِسُقياها الغَزيرِ فَجُد","رَبعِيَ مِنها بِسُقيا جودِكَ الهَطِلِ",40,"ل",1,0],["وَقَد ظَفِرَت يَدي بِالغُنمِ مِنهُ","فَلَيتَ الدَّهرَ سَنَّى لِي إِيَابا",41,"ب",2,0],["وقد ظهرت آثاره بحديثها","حداة الورى تحدو به كلّ موسم",42,"م",1,0],["وقد ظهرت عليه في صباه","أدلّة ما تبدى في الشباب",43,"ب",1,0],["وَقَد ظَهَرَت آياتُ سَيفِكَ لِلعِدى","وَقامَ بِأَمرِ اللَّهِ فيهِم نَذيرُها",44,"ر",3,0],["وقد ظَفِرتُ بِحِفظٍ منه أحكمه","حفظي لأسرع وقت فعل مقتدرِ",45,"ر",1,0],["وقد ظَفِرتُ بحفظٍ منه أحكمه","حفظي وقرَّبَ لِي مِنهُ مَدَى بَعُدا",46,"د",2,0],["وَقَد ظَلَّ حِرباءُ السُمومِ كَأَنَّهُ","رَبيئَةُ قَومٍ ماثِلٌ فَوقَ مَرقَبِ",47,"ب",1,0],["وَقَد ظَهَرَت لِلتَغلِبِيينَ حَيَّةٌ","كَحَيَّةِ مُوسى يَومَ أُيِّدَ بِالنَصرِ",48,"ر",1,0],["وقد ظن خيراً بمن ليس أهلاً","وباع الثمين بأثمان بخس",49,"س",1,0],["وقد ظنّ ليلي بدره في ذراعه","ومال البدرُ إلا في ذراعي وأطواقي",50,"ق",2,0],["وقد ظننت السحاب الجود منهمرا","حتى التفت فكان المدمع الجاري",51,"ر",2,0],["وَقَد ظَلِلنا سَراةَ اليَومِ حابِسُنا","شَبكُ الدُيونِ وَأَمرٌ بَينَهُم غَرِقُ",52,"ق",1,0],["وقد ظهرت دلئلها","لنا بالعين والأثر",53,"ر",1,0],["وقد ظنّ أنّ بلادَ الشّا","مِ لا يتخطّى إليها العَطَبْ",54,"ب",1,0],["وقد ظنّ لمّا استَعْجَلَ الفَرَّ أنّهُ","على نفسهِ عندَ الفرارِ شَفيقُ",55,"ق",1,0],["وقد ظنّتِ البيداءَ روضاً مُفوَّفاً","يُغنّي الصّدَى من جانبَيْها فترقُصُ",56,"ص",1,0],["وَقَد ظَلَّ يَسعى لِلمَعالي فَنالَها","عَلى رُغمِ حساد فَسُبحان رازِق",57,"ق",1,0],["وَقَد ظَفِرَ النِساءُ بِما تَرَكتُم","فَصارَ لِماهِرٍ بِالنَيكِ حاذِق",58,"ق",1,0],["وقد ظمئَ الضعيفُ وكاد يقضي","وصار الماءُ للبطل الشجاع",59,"ع",1,0],["وقد ظنَّ ينجيه من الحتف معقلٌ","حصين ويحميه من الفَتكِ عسكر",60,"ر",1,0],["وَقَد ظَهَرَ السَوابِغُ في","هِمُ وَالبَيضُ وَاليَلَبُ",61,"ب",1,0],["وقد ظمئت عيني التي أنت نورها","إلى نظرة من وجهك المتألق",62,"ق",1,0],["وقد ظهرت مناقبه وبانت","كما ظهرت شموس أو بدور",63,"ر",1,0],["وقد ظهروا الأحسا من كل باطل","وماطوا أشعار الرفض عنها وأبعدا",64,"د",2,0],["وقد ظن قوم أنها دولة مضت","وليس لما قد فات عود ولا رد",65,"د",1,0],["وقد ظن بعض الناس أني عنيتهم","جميعاً وكان الظن ظناً مفنداً",66,"د",2,0],["وقد ظنوا المخاض قريب طلْقٍ","فلم يأتِ المُبشّرُ بالمعاد",67,"د",1,0],["وقد ظللت وما ان كنت آمله","بالبرستان وفيمن حلها علما",68,"م",2,0],["وقد ظل عن رشد العُلا العيد قاصراً","برتبتهِ الصغرى ومولاهُ راشدُ",69,"د",1,0],["وَقَد ظَمِئتُ, وَكانَ الوَحشُ يَسكُنُني","وَتَأكُلُ الحَيرَةُ الجَوعَى بَساتِيني",70,"ن",2,0],["وَقَد ظَفِرتُ بِما قَد كُنتُ آمُلُهُ","لَمّا قَضضت مُنيَتي مِن نورِهِ وَطَرا",71,"ر",2,0]]}