{"poems":[[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[83,"لك الخير يا مولاي أبشر بعصمة","https://www.aldiwan.net/poem54332.html","الطويل"],[88,"خليلي قوما بي لنشهد للربا","https://www.aldiwan.net/poem44422.html","الطويل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[44,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[46,"تشاد المغاني والقبور دوارس","https://www.aldiwan.net/poem22784.html","الطويل"],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[45,"ألم تعلمي يا علو أني معذب","https://www.poetsgate.com/ViewPoem.aspx?id=31414",""],[132,"تأوبه الخيال وليس يألو","https://www.aldiwan.net/poem54769.html","الوافر"],[150,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[160,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[229,"أتنسى أيها العات","https://www.aldiwan.net/poem51076.html","الهزج"],[237,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[259,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[260,"خليلي لا تستعجلا أن تزودا","https://www.aldiwan.net/poem1103.html",""],[364,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[371,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[416,"عشت الزمان بخفض العيش منتصبا","https://www.aldiwan.net/poem53964.html","البسيط"],[429,"أراك سخي الدمع طال بك الأمر","https://www.aldiwan.net/poem41064.html","الطويل"],[437,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[441,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[441,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[451,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[468,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[482,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[515,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"]],"verses":[["وَقَد ظَهَرَت أَشياءُ مِنكُم كَثيرَةٌ","وَما كُنتُ مِنكُم مِثلَها أَتَرَقَّبُ",0,"ب",1,0],["وقد ظهرت للبرء منك علامة","علامتك العليا تقول لنا صحا",1,"ح",2,0],["وقد ظلّ من بين الغصون شعاعها","يوقّع دينارً لنا جنب دينار",2,"ر",1,0],["وقد ظننتُ وحولُ الله يعصمني","من ذاك أن نصيبي منك حرمان",3,"ن",1,0],["وَقَد ظَفِرتَ بِهِم وَالرَأسُ مُشتَعِلٌ","كَما ظَفِرتَ بِهِم وَالعُمرُ مُقتَبِلُ",4,"ل",1,0],["وَقَد ظُلِّلَت عِقبانُ أَعلامِهِ ضُحىً","بِعِقبانِ طَيرٍ في الدِماءِ نَواهِلِ",5,"ل",1,0],["وَقَد ظَهَرَت أَملاكُ مِصرَ عَلَيهُمُ","فَهَل مارَسَت مِن ظُلمِها ما تُمارِسُ",6,"س",1,0],["وقد ظنَّ قومٌ أنَّ في الشِعر حاجةً","إلى فاقةٍ تهتزُّ منها المشاعر",7,"ر",1,0],["وقد ظهرت فيه المخازي جليةً","يضيق بها حتى مجالُ التكلُّم",8,"م",1,0],["وقد ظهرت أشياء منكم كثيرة","وما كنت منكم مثلها أرترقب",9,"ب",1,0],["وقَد ظَعَنَ الأَحِبَّةُ فَاستَمَالُوا","فُؤَادَكَ حِينَ تُعتَسَفُ الرِّمَالُ",10,"ل",1,0],["وقد ظفرت جفونهم","بلذَّتها من الوسن",11,"ن",1,0],["وقد ظهرت سعودك للبرايا","ظهورا دونه الصبح المبين",12,"ن",1,0],["وقد ظلَّلنَا الغيمُ","بمِثْل السَوْسَن النَضْر",13,"ر",1,0],["وَقَدْ ظَفِرْتُ بِمَا كُنْتُ آمُلُهُ","لَمَّا قَضَتْ مُنْيَتِي مِنْ نُورِهِ وَطَرَا",14,"ر",2,0],["وقد ظهرت لكن بعيد بشارتي","زمان اللقا مذ كان مورده وردي",15,"د",2,0],["وَقَد ظَهَرَت مِنهُم بَوائِقُ جَمَّةٌ","وَأَفرَعَ مَولاهُم بِنا ثُمَّ أَصعَدا",16,"د",2,0],["وقد ظَلّ بينَ المُوبذان مكانَه","وشِيرينَ للأبصارِ وهْو قريب",17,"ب",1,0],["وقَد ظلَّلتها للغُبارِ غَمامَةٌ","يَزيدُ عَلى حرِّ الشموسِ ظِلالُها",18,"ل",3,0],["وقد ظهرتَ ظهورَ الصُّبح منبلجاً","فطالما كنتَ قبل اليوم محتجبا",19,"ب",2,0],["وقد ظهر المريخ في سيف لحظها","وقابلت الأقمار فانبهم الأمر",20,"ر",1,0],["وقد ظهرت آياته في جماله","فيا حسنها من معجزات ويا عجبا",21,"ب",2,0],["وقد ظللته بالهجير غمامة","وللشمس في الريد الغاب بمهدنا",22,"ن",2,0],["وقد ظللته في القفار غمامةً","ورأد الضحى بالقوم يهبو الحصى هبوا",23,"و",2,0],["وقد ظن ان القوم سهل قناتهم","ولم يكترث أهل الطعان المميزِ",24,"ز",1,0],["وَقَد ظَهَرَ الآسُ يا زَهرَهُ","فَما أَطيَبَ العَيشَ لَمّا ظَهَر",25,"ر",1,0],["وقد ظفرت روحي بمغنى جمالها","جزافا لقد أمهدت وصل وصاليا",26,"ي",2,0],["وقد ظهرت لما استقرت مذاهب","على مقتضى التربيع تترى اجتهادي",27,"ي",1,0],["وقد ظمئت آمالنا نحو مزنة","ذهاب القوافي أن يظن ذهابها",28,"ب",3,0]]}