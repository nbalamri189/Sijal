ا يَصرفَنَّك ،عن قَصْفٍ وإصْباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24834&r=&rc=4",""],[20,"ألا أيها المثري المرجى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69778&r=&rc=19",""],[88,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[57,"خبتْ نارُ نفسي بِاشْتِعالِ مَفَارِقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14210&r=&rc=6",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[87,"قَلِيلٌ مَنْ يَدُومُ عَلَى الْوِدَادِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23885&r=&rc=147",""],[87,"تَلاهَيْتُ إِلاَّ ما يُجِنُّ ضَمِيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23912&r=&rc=174",""],[87,"أَبَى الشَّوقِ إلاَّ أَن يَحِنَّ ضَميرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23910&r=&rc=172",""],[3,"هلْ غادرَ الشُّعراءُ منْ متردَّم ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10745&r=&rc=99",""]],"verses":[["فَطَوى الحَيا بُردَ النُحولِ وَنَشَّرَت","رِمَمُ الصَعيدِ غَدائِرَ الأَغصانِ",0,"ن",1,0],["فَطارَ ذَميماً قَد تَقَلَّدَ عارَها","بِشَرِّ جَناحٍ يَومَ دَيرِ الجَماجِمِ",1,"م",1,0],["فَطارَ تَرقيهِ الظُبى","وَالأَسَلُ الذَوابِلُ",2,"ل",1,0],["فَطَوراً تُعرَضينَ عَلى زُلالٍ","وَطَوراً تُعرَضينَ عَلى ذُعافِ",3,"ف",1,0],["فَطِب عَن بُلوغِ العِزِّ نَفساً لَئيمَةً","فَما لِلعُلى إِلّا النُفوسُ النَفائِسُ",4,"س",1,0],["فَطَرَّدَها حَتّى اِستَباحَ شُبولَها","وَما ضَعضَعَتهُ أُسدُها بِالزَماجِرِ",5,"ر",1,0],["فَطىً يَصلى بِأَطرافِ المَواضي","وَنارُ الحَربِ طائِشَةُ السَعيرِ",6,"ر",1,0],["فَطاعَنَ حَتّى اِستَباحَ الرَما","حَ إِنَّ الغَنيمَةَ لِلظافِرِ",7,"ر",1,0],["فَطُلتُ الأَطوَلينَ عُلىً","وَفُتَّ الأَبعَدينَ مَدى",8,"د",2,0],["فَطَوَّحَ لي مِن حالِقٍ وَأَزَلَّني","زَليلَ المَطايا عَن مُتونِ الأَواعِثِ",9,"ث",1,0],["فَطَوْراً أَجوبُ الأَرضَ فَوقَ مَطيَّةٍ","وَطَوْراً عَلى ضافي السَّبيبَةِ سابِحِ",10,"ح",1,0],["فَطَوى بُردَ شَبابي زَمَنٌ","بَزَّ عودي ماءَهُ حَتىّ ذَبَلْ",11,"ل",1,0],["فَطارَت وَالفؤادُ لَهُ التِفاتٌ","إِلَيهِ وَقَد عَناهُ ما عَناها",12,"ا",3,0],["فَطَأْطأَ بِيضُ الهِنْدِ مِنْ نَخَواتِهِ","وَبي يُخْطَم الأَنْفُ الأَشَمُّ إِذا انْتَخى",13,"خ",2,0],["فَطرْفُكِ لا صَهْباءُ يَنْزو حَبابُها","قَويتِ على قَتْلي بِهِ وَهْوَ يَضْعُفُ",14,"ف",1,0],["فطرّفوا عنِ العُلا بأذْرُعٍ","شابَتْ أسابيَّ دَمٍ بِنائِلِ",15,"ل",1,0],["فَطَرَقْنَني والليْلُ رقَّ أديمُهُ","والنّجْمُ كادَ يهُمُّ بالتَّعْريدِ",16,"د",1,0],["فطَرَقْتِ مَطْويَّ الضلوعِ على جوًى","أغضَى الجُفونَ بهِ على الأقذاءِ",17,"ا",2,0],["فَطَعَنتُهُ بِالرُمحِ ثُمَّ عَلَوتُهُ","بِمُهَنَّدٍ صافي الحَديدَةِ مِخذَمِ",18,"م",1,0],["فَطوبى لِمَن أَغفى مِنَ اللَيلِ ساعَةً","وَذاقَ اِغتِماضاً إِنَّ ذاكَ لَناعِمُ",19,"م",1,0],["فَطوبى لِمَن يُغفي مِنَ اللَيلِ غَفوَةً","وَطوبى لِمَن يَهنيهِ سَوغُ شَرابِ",20,"ب",1,0],["فَطاوَعتُ أَعدائي وَعاصَيتُ ناصِحي","وَأَقرَرتُ عَينَ الشامِتِ المُتَخَلِّقِ",21,"ق",1,0],["فَطوبى لِنَفسٍ أُولِعَت قَعرَ دارِها","مُغَلِّقَةَ الأَبوابِ مُرخَىً حِجابُها",22,"ب",3,0],["فطَرِبْتُ والمَلْويُّ يَلْوي فارْتمَتْ","منّي الدّموعُ كمِثْلِ وادِي مَلْوِيَهْ",23,"و",3,0],["فَطِبْ نَفْساً وَنَمْ فِي ظِلِّ رُحْمَى","تَلِذُّ بِبَرْدِهَا بَيْنَ النِّيَامِ",24,"م",1,0],["فَطِنٌ لِكُلِ مُصيبَةٍ في مالِهِ","وَإِذا أُصيبَ بِعِرضِهِ لَم يَشعُرِ",25,"ر",1,0],["فَطَوراً تَكونُ مِهاداً لَنا","وَطَوراً أَكونُ فَيُعلى بِها",26,"ب",3,0],["فَطَوراً تَميلُ بِنا مُرَّةً","وَطَوراً نُعالِجُ إِمرارَها",27,"ر",3,0],["فَطارَ القُيولُ وَقَيلاتُها","بِيَهماءَ فيها سَرابٌ يَطِم",28,"م",1,0],["فَطاروا سِراعاً وَما يَقدِرو","نَ مِنهُ لِشُربِ صَبِيٍّ فَطِم",28,"م",1,0],["فَطِرتُ بِرَحلي وَاِستَبَدَّ بِمِثلِهِ","عَلى ذاتِ لَوثٍ كَالبَلِيَّةِ ضامِرِ",29,"ر",1,0],["فَطَلَعنَ مِثلَ كَواكِبٍ","يَسطَعنَ في وَسَطِ الدُجُنَّه",30,"ن",2,0],["فَطاحَ كَما طاحَت مُصَوَّعُ بَعدَهُ","وَضاعَت مَساعينا بِأَطماعِكُم سُدى",31,"د",2,0],["فَطَرَحتُها وَسَأَلتُ عَن","هُ فَقيلَ لي لَم يَألُ جُهدا",32,"د",2,0],["فِطنَةٌ عِندَ رِقَّةٍ عِندَ ظَرفٍ","عِندَ رَأيٍ تَخالُهُ إِلهاما",33,"م",2,0],["فُطوبى لِوَجهِ اِمريءٍ صَبَّحَت","هُ أَوجُهُ فِتيانِها المُشرِقَه",34,"ق",2,0],["فَطالَ لَيلُكَ بَعدي","كَطولِ لَيلِيَ بَعدَك",35,"ك",1,0],["فَطَوَّقَ بِاستِئصالِها المِصرَ مِنَّةً","يَكادُ يُؤَدّي شُكرَها الحَجَرُ الصَلدُ",36,"د",1,0],["فَطوراً يَسيلُ عَلى قَصدِهِ","وَطَوراً يُراجِعُ كَي لا يَسيلا",37,"ل",2,0],["فُطورًا أَكُرُّ الطَرفَ نَحوَ تِهامَةٍ","وَطورًا أَكُرُّ الطَّرفَ كرًّا إِلى نَجدِ",38,"د",1,0],["فَطِرتَ بِها حَتّى إِذا اِشتَدَّ ظِمؤُها","وَحُبَّ إِلى القَومِ الإِناخَةُ وَالشُربُ",39,"ب",1,0],["فَطَمَّ كَالسَّيْلِ عَلَى صَبْرِهِ","وَعَالَجَ العَزْمَ إِلَى هَدِّهِ",40,"د",2,0],["فَطُنَ الحَكِيمُ لِمَا الحَوَادِثُ خَبَّأَتْ","فَنَضَا حِجَابَ الغَيْبِ قَبْلَ أَوَانِ",41,"ن",1,0],["فِطَنٌ بَدَتْ تَخْتَالُ فِي","فُصْحٍ مَحَاسِنُهَا عُيُونُ",42,"ن",1,0],["فِطَامُ الْبَنِينَ عَلَى التُّرَّهَاتِ","وَنَاهِيكَ بِالجَهْلِ مِنْ فَاطِمِ",43,"م",1,0],["فَطَابُوا فِي الغَبُوْقِ بِهِ نُفُوساً","ورَاقَ لَهُمْ مَعَ الظَّفَرِ المُدَامُ",44,"م",1,0],["فَطَافَ بِهِمْ وَبِالجَرْحَى افْتِقَاداً","وَكَانَ مَبَرَّةً مِنْهُ اللِّمَامُ",44,"م",1,0],["فَطُلَّ دَمُ المَخلوعِ وَاِنتُهِكَت لَهُ","ذَخائِرُ مِن مَنقوشِهِ وَسَبايِكِ",45,"ك",1,0],["فَطَوراً تُصادِفُهُ جَعبَةً","وَطَوراً تُصادِفُهُ حَربَه",46,"ه",1,0],["فَطاوَعتُ هَمّي فَاِنجَلى وَجهُ بازِلٍ","مِنَ الأَمرِ لَم يَترُك خِلاجاً بُزولُها",47,"ل",3,0],["فَطارَت بُرودُ العَصبِ عَنّا وَبُدِّلَت","شُحوباً وُجوهُ الواضِحينَ السَمادِعِ",48,"ع",1,0],["فطُعنتُ من قدِّ القوامِ بأَسمرٍ","ورُميتُ من غنج اللحاظِ بأَسْهُم",49,"م",1,0],["فطرحتَه طرح النواة فلم يَفُزْ","من عزِّ مغربِهِ بغير فرارِ",50,"ر",1,0],["فطار من غير تحليق براكبه","بل مرّ يمطر مطراً فوق ملحوب",51,"ب",1,0],["فطالع أراجيف الجرائد أنني","أرى الويل كل الويل بين الجرائد",52,"د",1,0],["فطوراً كعصف الريح تجري شديدةً","وطوراً رخاءً كالنسيم إذا هبّا",53,"ب",2,0],["فطاف بي طائف لرَوْعته","يرتجف القلب وهو مُرتعِب",54,"ب",1,0],["فطِرت غير مُبالٍ عند ذاك بما","تركت من نرجس فيها ونسرين",55,"ن",1,0],["فطالعوهنّ بالأيدي مطالعةً","تسطو عليهن تمزيقاً وتأريبا",56,"ب",2,0],["فطاب لنا منه العِناق وضمَّنا","إليه فقّبلناه من عينه ألفا",57,"ف",2,0],["فطِرْ في سموات القريض مرفرفا","وأطلع لنا فيها النجوم الدراريا",58,"ي",2,0],["فطأطأنّ للتسليم منهنَ أرؤساً","عليها أكاليل ضفرن من الشعر",59,"ر",1,0],["فطوراً خطيباً يحزن القلب وعظه","وطوراً يسرّ السمع بالعزف والزمر",59,"ر",1,0],["فَطاشَت يَدُ القَينِ الدَعِيِّ وَغَمَّهُ","ذُرى واسِقاتٍ يَرتَمينَ مِنَ البَحرِ",60,"ر",1,0],["فَطَائِفَةٌ قد أكفََرَتنِي بِحُبِّكُم","وَطَائِفَةٌ قَالُوا مُسِيءٌ وَمُذنِبُ",61,"ب",1,0],["فَطارَدتُ حَتّى أَبهَرَ الجَريُ أَشقَري","وَضارَبتُ حَتّى أَوهَنَ الضَربُ ساعِدي",62,"د",2,0],["فَطاروا شِلالاً وَقَد أُفزِعوا","وَطِرنا إِلَيهِم كَأُسدِ الأَجَم",63,"م",1,0],["فَطارَ الغُواةُ بِأَشياعِهِم","إِلَيهِ يَظُنّونَ أَن يُختَرَم",63,"م",1,0],["فَطاعَنَ حَتّى ماتَ غَيرَ مُوَسَّدٍ","بِمُعتَرَكٍ فيهِ القَنا يَتَكَسَّرُ",64,"ر",1,0],["فَطافَت طَوفَتَينِ فَقالَ زِدني","وَدَبَّت في الأَخادِعِ وَالبَنانِ",65,"ن",1,0],["فطوراً فائض العذب المهنى","وطوراً فائض السم الذُّباح",66,"ح",1,0],["فطَّرْت فيه الورى واللفظ منفق","للوَفدِ فطرٌ وللحساد تفطير",67,"ر",1,0],["فطَّرت أفواه الصيام تقرباً","ورميت أكباد العداة بفاطر",68,"ر",1,0],["فطاف على يمنى يديه رجاؤنا","وأقسم أن لا بد أن يبلغ اليسرى",69,"ر",2,0],["فطمت ولائِيَ ثم أقبلت عاتباً","أفاطم مهلاً بعد هذا التذلّل",70,"ل",1,1],["فطراً لمن والاك نحراً لمن","عاداك ذا عدنٌ وهذا جحيم",71,"م",1,0],["فطوراً يُغاديني بلصٍّ مُصَلِّتٍ","وطوراً يُمَسّيني بورْدِ الشَّواربِ",72,"ب",1,0],["فطوْراً بأَقْلاَمٍ تُجَرَّدُ لِلْحِبَا","وطوراً بأسْيافٍ حِدَادٍ تُجَرَّدُ",73,"د",1,0],["فطلعْتَ كالسيف الحسام مجرداً","للحق أو مثل الهلال مجددا",74,"د",2,0],["فطفقتَ تسلك فجَّهُ","وتسير فيه كما يسيرُ",75,"ر",1,0],["فطوراً تُولِّيه المجوسَ صلاتُة","وطوراً توليه النصارى بَرانسه",76,"س",2,0],