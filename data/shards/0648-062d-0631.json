روب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[439,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[441,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[441,"سرور المرء مقرون ببوس","https://www.aldiwan.net/poem14375.html","الوافر"],[441,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[453,"الله في الحب ألحان واضواء","https://www.aldiwan.net/poem61241.html","البسيط"],[453,"بني معروف جاحدكم جحود","https://www.aldiwan.net/poem61351.html","الوافر"],[458,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[458,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[458,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[458,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[458,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[458,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[458,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[458,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[458,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[458,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[461,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[464,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[464,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[479,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[495,"أحاجيك أناجيك","https://www.aldiwan.net/poem9862.html","الهزج"],[500,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[500,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[500,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[515,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[529,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[529,"سلوا الناس من قد قام مثل مقامي","https://www.aldiwan.net/poem37141.html","الطويل"],[529,"لعمرك ما جانبت في الحق لي رهطا","https://www.aldiwan.net/poem37346.html","الطويل"],[551,"أمللتني وزعمت أن","https://www.aldiwan.net/poem47306.html","مجزوء الكامل"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[551,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[551,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[564,"عن العادات لا تنبو الطباع","https://www.aldiwan.net/poem863.html",""],[567,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[567,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[567,"بدت في نسوة مثل المها","https://www.aldiwan.net/poem69764.html","الهزج"],[570,"لحا الله قوما أرشوا الحرب بيننا","https://www.aldiwan.net/poem59473.html","الخفيف"],[575,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[586,"وحرمة الذاهب من عيشنا","https://www.aldiwan.net/poem17460.html","السريع"],[586,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"]],"verses":[["وحَرْبٍ عَوانٍ لمْ يَخُضْ غَمَراتِها","سِوى أسَدِيٍّ هَمُّهُ الفَتْكَةُ البِكْرُ",0,"ر",1,0],["وَحَرُّ أَنفاسي إِذا ما قابَلَت","يَومَ الفِراقِ صَخرَةً أَماعَها",1,"ع",3,0],["وَحُرمَةُ هَذَا اللَّحْدِ يَأَبَى كَمَالُهَا","هَضيمَةَ رَدٍّ أَوْ حَطِيطَةَ نُقْصَانِ",2,"ن",1,0],["وحرَّكَ عزْمي أنْ أزورَكَ قاعِداً","على فُرُشِ العِزِّ الأصيلِ المُجَدَّدِ",3,"د",1,0],["وَحَريمُهُ أَيضاً حَريمُكَ فاحمِهِ","كي لا يُباعُ لَدَيكَ مِنهُ حَريمُ",4,"م",1,0],["وَحَرَصتُم عَلى العُقولِ فَحَزَّم","تُم عَصيراً يَراهُ قَومٌ حَلالا",5,"ل",2,0],["وَحُروبٌ طاحِناتٌ كُلَّما","أُطفِئَت شَبَّ لَظاها وَاِستَعَر",6,"ر",1,0],["وَحَرفُ ثانيهِ مَعجومٌ بِواحِدَةٍ","وَعجم آخِرِهِ ثنتانِ في الكُتُبِ",7,"ب",1,0],["وَحَربٍ إِذا الأَعداءُ أَنشَت حِياضَها","وَقَلَّبَ أَمراسُ السَواني مَحالَها",8,"ل",3,0],["وَحَرفٍ نِيافٍ السَمكُ مُقَورَّةِ القَرا","دَواءُ الفَيافي مَلعُها وَخَبيبَها",9,"ب",3,0],["وحرّك فيه ساكنَ الوجد فاغتدى","مهيجاً كما يستنّ في المرح المُهر",10,"ر",1,0],["وَحَربٍ تَضجَرُ النُخَباتُ مِنها","قَرَيناها الأَسِنَّةَ وَاِصطَلَينا",11,"ن",2,0],["وحروبٍ تجري السوابحُ منها","في بحارٍ مسفوحةٍ من دماء",12,"ا",2,0],["وحركت ميزاني فأثنى لسانه","فما زلت مشكوراً بكلّ لسان",13,"ن",1,0],["وحرام أن يطرق العسر والجو","ر فتىً كانَ في مغانيه حلاَّ",14,"ل",2,0],["وَحُرمَةِ الوِدِّ الَّذي لَم يَكُن","يَطمَعُ في إِفسادِهِ الدَهرُ",15,"ر",1,1],["وحُرٍّ من الفتيان ليس بقُعْدُدٍ","ولا قائلٍ من فعلِ مكرمةٍ حَسْبي",16,"ب",2,0],["وحُرمتي بك إن اللَّه عظَّمها","وما أديميَ مما تَقرضُ العُثُثُ",17,"ث",1,0],["وحَريمُ المال مُذْ كا","نَ لَدَيْهِ مستباحُ",18,"ح",1,0],["وحروفَ المعجم الخِلْ","فة أحصاهنَّ عدَّا",19,"د",2,0],["وحُرمتُ منكم والإلَ","هُ على مَرَدِّكُمُ قديرُ",20,"ر",1,0],["وحرٍ إذا ورد الزُّناة قليبه","لعنوا الدليل عليه عند المصدر",21,"ر",1,0],["وحرمةُ الجارِ والمطيفِ بكم","ممنوعةٌ والثراءُ منتهَكُ",22,"ك",1,0],["وحريمُ مالكَ جِدُّ منتَهكٍ","لكنَّ عِرضك غيرُ مُنتهكِ",23,"ك",1,0],["وحرامٌ عليّ عِرضُك بَسْلٌ","أبداً ما رأيتَ عِرضيَ بَسْلا",24,"ل",2,0],["وَحَراكُكُم لِعَلائِهِ وَسُكونِكُم","وَإِلى ثَراهُ حَنينُكُم وَحَنيني",25,"ي",1,0],["وحَرَقْتُ البُخُورْ","وأَضَأْتُ الشُّمُوعْ",26,"ع",1,0],["وحرامٌ عليكِ أَنْ تهدمي مَا","شادهُ الحُسْنُ في الفؤادِ العميدِ",27,"د",1,0],["وحرامٌ عليكِ أَنْ تسْحَقي آم","الَ نفسٍ تصبو لعيشٍ رغيدِ",27,"د",1,0],["وحربٌ ضروسٌ كما قَدْ عهدنُ","ونَصْرٌ وكسرٌ وهمٌّ مديدْ",28,"د",1,0],["وحرقت أزكى العود حو","لَيه وأغلى الصندل",29,"ل",1,0],["وَحُرِّرَتِ الشُعوبُ عَلى قَناها","فَكَيفَ عَلى قَناها تُستَرَقُّ",30,"ق",1,0],["وَحِرصٌ عَلى الدُنيا وَمَيلٌ مَعَ الهَوى","وَغِشٌّ وَإِفكٌ في الحَياةِ وَزورُ",31,"ر",1,0],["وَحَربٌ مَضَت نَحنُ أَوزارُها","وَخَيلٌ خَلَت نَحنُ فُرسانُها",32,"ن",3,0],["وَحَرَقتُ أَزكى العودِ حَو","لَيهِ وَأَغلى الصَدنَلِ",33,"ل",1,0],["وحر بعده قد صار نارا","بها حسنَ ائتلاف وازدواجُ",34,"ج",1,0],["وحرّمتَ أشلاءَ الكِرامِ وإنَّها","شروبٌ لأشلاءِ الكرامِ أكولُ",35,"ل",1,0],["وَحَرَّت عَلى الأَيدي مَجَسَّةُ كَفِّهِ","كَذَلِكَ مَوجُ البَحرِ مُلتَهِبُ الوَقدِ",36,"د",1,0],["وَحُرقَةٍ وَالدُموعُ تُطفِؤُها","ثُمَّ يَعودُ الجَوى فَيُسعِرُها",37,"ر",3,0],["وَحَرَّضَ شَوقي خاطِرُ الريحِ إِذ سَرى","وَبَرقٌ بَدا مِن جانِبِ الغَربِ لامِعُ",38,"ع",1,0],["وَحَرفٍ كَجَفنِ السَيفِ أَدرَكَ نِقيَها","وَراءَ الَّذي يُخشى وَجيفُ التَنائِفِ",39,"ف",1,1],["وَحَرَمْتَهُ الراحَ التي رَوَّقْتَها","وسقيتَه بالكُرهِ سُماً قاتِلا",40,"ل",2,0],["وحَرُّ حريقٍ ألبسَ الأَرْضَ ثَوبَه","يُخافُ على الأَقدامِ منه حَريقُ",41,"ق",1,0],["وحرَّمَ مِسْمَعَيْهِ على المَلاهي","وهُدَّابَ الإزارِ على التُّرابِ",42,"ب",1,0],["وَحَرَستَ مُلكَكَ مِن رَجيمٍ مارِدٍ","بِعَزائِمٍ إِن صُلتَ كُنَّ قَواضِبا",43,"ب",2,0],["وحرقت قلبي من سنا","كِ على جمالٍ يضطرم",44,"م",1,0],["وحربٍ أذيقتْ في بنيها ببأسِه","مرارةَ كأسِ الثكل لا عَدِمتْ ثكلا",45,"ل",2,0],["وحربيّةٍ ترمي بِمُحْرِقِ نِفْطِها","فيَغْشى سَعُوطُ الموتِ فيها المَعاطِسا",46,"س",2,0],["وحربٍ كأنَّ البأسَ يَنْقُدُ جَمْعَهَا","لِيَعلَمَ فيهِم من يُزَيَّفُ بالنَقدِ",47,"د",1,0],["وحربِيّةٍ في طالِعِ السعدِ أُنْشِيَتْ","فَنيرانُها لِلحربِ دائِمَةُ الوَقْدِ",47,"د",1,0],["وَحَرَّشَتهُ الدَبورُ وَاِجتَنَبَت","ريحُ القَبولِ الهُبوبَ مِن رَهَبِه",48,"ب",2,0],["وَحَرَّكَتْ حَلَقَاتِ الْبَابِ فَانْفَتَحَتْ","عَنْ سَاحَةٍ سَكَنَتْ فِيهَا تَرَاقِيهَا",49,"ي",3,0],["وَحَرَمتِني رَدَّ السَلامِ وَما أَرى","رَدَّ السَلامِ ع