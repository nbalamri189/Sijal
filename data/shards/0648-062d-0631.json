w.aldiwan.net/poem34781.html","الكامل"],[440,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[440,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[442,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[442,"سرور المرء مقرون ببوس","https://www.aldiwan.net/poem14375.html","الوافر"],[442,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[454,"الله في الحب ألحان واضواء","https://www.aldiwan.net/poem61241.html","البسيط"],[454,"بني معروف جاحدكم جحود","https://www.aldiwan.net/poem61351.html","الوافر"],[459,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[459,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[459,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[459,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[459,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[459,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[459,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[459,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[459,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[459,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[459,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[462,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[465,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[465,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[466,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[480,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[496,"أحاجيك أناجيك","https://www.aldiwan.net/poem9862.html","الهزج"],[501,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[501,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[501,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[516,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[530,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[530,"سلوا الناس من قد قام مثل مقامي","https://www.aldiwan.net/poem37141.html","الطويل"],[530,"لعمرك ما جانبت في الحق لي رهطا","https://www.aldiwan.net/poem37346.html","الطويل"],[552,"أمللتني وزعمت أن","https://www.aldiwan.net/poem47306.html","مجزوء الكامل"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[552,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[559,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[565,"عن العادات لا تنبو الطباع","https://www.aldiwan.net/poem863.html",""],[568,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[568,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[568,"بدت في نسوة مثل المها","https://www.aldiwan.net/poem69764.html","الهزج"],[571,"لحا الله قوما أرشوا الحرب بيننا","https://www.aldiwan.net/poem59473.html","الخفيف"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[587,"وحرمة الذاهب من عيشنا","https://www.aldiwan.net/poem17460.html","السريع"],[587,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"]],"verses":[["وحرت أعي كنهاً لجوهرك الذي","تبدى وما يبدو لعين تشاهد",0,"د",1,0],["وحَرْبٍ عَوانٍ لمْ يَخُضْ غَمَراتِها","سِوى أسَدِيٍّ هَمُّهُ الفَتْكَةُ البِكْرُ",1,"ر",1,0],["وَحَرُّ أَنفاسي إِذا ما قابَلَت","يَومَ الفِراقِ صَخرَةً أَماعَها",2,"ع",3,0],["وَحُرمَةُ هَذَا اللَّحْدِ يَأَبَى كَمَالُهَا","هَضيمَةَ رَدٍّ أَوْ حَطِيطَةَ نُقْصَانِ",3,"ن",1,0],["وحرَّكَ عزْمي أنْ أزورَكَ قاعِداً","على فُرُشِ العِزِّ الأصيلِ المُجَدَّدِ",4,"د",1,0],["وَحَريمُهُ أَيضاً حَريمُكَ فاحمِهِ","كي لا يُباعُ لَدَيكَ مِنهُ حَريمُ",5,"م",1,0],["وَحَرَصتُم عَلى العُقولِ فَحَزَّم","تُم عَصيراً يَراهُ قَومٌ حَلالا",6,"ل",2,0],["وَحُروبٌ طاحِناتٌ كُلَّما","أُطفِئَت شَبَّ لَظاها وَاِستَعَر",7,"ر",1,0],["وَحَرفُ ثانيهِ مَعجومٌ بِواحِدَةٍ","وَعجم آخِرِهِ ثنتانِ في الكُتُبِ",8,"ب",1,0],["وَحَربٍ إِذا الأَعداءُ أَنشَت حِياضَها","وَقَلَّبَ أَمراسُ السَواني مَحالَها",9,"ل",3,0],["وَحَرفٍ نِيافٍ السَمكُ مُقَورَّةِ القَرا","دَواءُ الفَيافي مَلعُها وَخَبيبَها",10,"ب",3,0],["وحرّك فيه ساكنَ الوجد فاغتدى","مهيجاً كما يستنّ في المرح المُهر",11,"ر",1,0],["وَحَربٍ تَضجَرُ النُخَباتُ مِنها","قَرَيناها الأَسِنَّةَ وَاِصطَلَينا",12,"ن",2,0],["وحروبٍ تجري السوابحُ منها","في بحارٍ مسفوحةٍ من دماء",13,"ا",2,0],["وحركت ميزاني فأثنى لسانه","فما زلت مشكوراً بكلّ لسان",14,"ن",1,0],["وحرام أن يطرق العسر والجو","ر فتىً كانَ في مغانيه حلاَّ",15,"ل",2,0],["وَحُرمَةِ الوِدِّ الَّذي لَم يَكُن","يَطمَعُ في إِفسادِهِ الدَهرُ",16,"ر",1,1],["وحُرٍّ من الفتيان ليس بقُعْدُدٍ","ولا قائلٍ من فعلِ مكرمةٍ حَسْبي",17,"ب",2,0],["وحُرمتي بك إن اللَّه عظَّمها","وما أديميَ مما تَقرضُ العُثُثُ",18,"ث",1,0],["وحَريمُ المال مُذْ كا","نَ لَدَيْهِ مستباحُ",19,"ح",1,0],["وحروفَ المعجم الخِلْ","فة أحصاهنَّ عدَّا",20,"د",2,0],["وحُرمتُ منكم والإلَ","هُ على مَرَدِّكُمُ قديرُ",21,"ر",1,0],["وحرٍ إذا ورد الزُّناة قليبه","لعنوا الدليل عليه عند المصدر",22,"ر",1,0],["وحرمةُ الجارِ والمطيفِ بكم","ممنوعةٌ والثراءُ منتهَكُ",23,"ك",1,0],["وحريمُ مالكَ جِدُّ منتَهكٍ","لكنَّ عِرضك غيرُ مُنتهكِ",24,"ك",1,0],["وحرامٌ عليّ عِرضُك بَسْلٌ","أبداً ما رأيتَ عِرضيَ بَسْلا",25,"ل",2,0],["وَحَراكُكُم لِعَلائِهِ وَسُكونِكُم","وَإِلى ثَراهُ حَنينُكُم وَحَنيني",26,"ن",2,0],["وحَرَقْتُ البُخُورْ","وأَضَأْتُ الشُّمُوعْ",27,"ع",1,0],["وحرامٌ عليكِ أَنْ تهدمي مَا","شادهُ الحُسْنُ في الفؤادِ العميدِ",28,"د",1,0],["وحرامٌ عليكِ أَنْ تسْحَقي آم","الَ نفسٍ تصبو لعيشٍ رغيدِ",28,"د",1,0],["وحربٌ ضروسٌ كما قَدْ عهدنُ","ونَصْرٌ وكسرٌ وهمٌّ مديدْ",29,"د",1,0],["وحرقت أزكى العود حو","لَيه وأغلى الصندل",30,"ل",1,0],["وَحُرِّرَتِ الشُعوبُ عَلى قَناها","فَكَيفَ عَلى قَناها تُستَرَقُّ",31,"ق",1,0],["وَحِرصٌ عَلى الدُنيا وَمَيلٌ مَعَ الهَوى","وَغِشٌّ وَإِفكٌ في الحَياةِ وَزورُ",32,"ر",1,0],["وَحَربٌ مَضَت نَحنُ أَوزارُها","وَخَيلٌ خَلَت نَحنُ فُرسانُها",33,"ن",3,0],["وَحَرَقتُ أَزكى العودِ حَو","لَيهِ وَأَغلى الصَدنَلِ",34,"ل",1,0],["وحر بعده قد صار نارا","بها حسنَ ائتلاف وازدواجُ",35,"ج",1,0],["وحرّمتَ أشلاءَ الكِرامِ وإنَّها","شروبٌ لأشلاءِ الكرامِ أكولُ",36,"ل",1,0],["وَحَرَّت عَلى الأَيدي مَجَسَّةُ كَفِّهِ","كَذَلِكَ مَوجُ البَحرِ مُلتَهِبُ الوَقدِ",37,"د",1,0],["وَحُرقَةٍ وَالدُموعُ تُطفِؤُها","ثُمَّ يَعودُ الجَوى فَيُسعِرُها",38,"ر",3,0],["وَحَرَّضَ شَوقي خاطِرُ الريحِ إِذ سَرى","وَبَرقٌ بَدا مِن جانِبِ الغَربِ لامِعُ",39,"ع",1,0],["وَحَرفٍ كَجَفنِ السَيفِ أَدرَكَ نِقيَها","وَراءَ الَّذي يُخشى وَجيفُ التَنائِفِ",40,"ف",1,1],["وَحَرَمْتَهُ الراحَ التي رَوَّقْتَها","وسقيتَه بالكُرهِ سُماً قاتِلا",41,"ل",2,0],["وحَرُّ حريقٍ ألبسَ الأَرْضَ ثَوبَه","يُخافُ على الأَقدامِ منه حَريقُ",42,"ق",1,0],["وحرَّمَ مِسْمَعَيْهِ على المَلاهي","وهُدَّابَ الإزارِ على التُّرابِ",43,"ب",1,0],["وَحَرَستَ مُلكَكَ مِن رَجيمٍ مارِدٍ","بِعَزائِمٍ إِن صُلتَ كُنَّ قَواضِبا",44,"ب",2,0],["وحرقت قلبي من سنا","كِ على جمالٍ يضطرم",45,"م",1,0],["وحربٍ أذيقتْ في بنيها ببأسِه","مرارةَ كأسِ الثكل لا عَدِمتْ ثكلا",46,"ل",2,0],["وحربيّةٍ ترمي بِمُحْرِقِ نِفْطِها","فيَغْشى سَعُوطُ الموتِ فيها المَعاطِسا",47,"س",2,0],["وحربٍ كأنَّ البأسَ يَنْقُدُ جَمْعَهَا","لِيَعلَمَ فيهِم من يُزَيَّفُ بالنَقدِ",48,"د",1,0],["وحربِيّةٍ في طالِعِ السعدِ أُنْشِيَتْ","فَنيرانُها لِلحربِ دائِمَةُ الوَقْدِ",48,"د",1,0],["وَحَرَّشَتهُ الدَبورُ وَاِجتَنَبَت","ريحُ القَبولِ الهُبوبَ مِن رَهَبِه",49,"ب",2,0],["وَحَرَّكَتْ حَلَقَاتِ الْبَابِ فَ