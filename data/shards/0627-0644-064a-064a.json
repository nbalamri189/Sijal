{"poems":[[76,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85424","المجتث"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[234,"آلى يمينا على قتلي مرددة","https://www.aldiwan.net/poem51025.html","البسيط"],[445,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66653","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67834","الطويل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117074","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124329",""],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44768","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102146","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27933","المجتث"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137301",""],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37503","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70165","الوافر"],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4919,"جرح","https://www.poetsgate.com/ViewPoem.aspx?id=34792",""],[5061,"دنيا الفنا","https://www.poetsgate.com/ViewPoem.aspx?id=152995",""],[5431,"وقدس العرب تختزلُ المآسي...","https://www.poetsgate.com/ViewPoem.aspx?id=190187",""],[5486,"الدهشة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=210725",""],[5573,"انشد عن الي مر به","https://www.poetsgate.com/ViewPoem.aspx?id=202260",""],[5573,"ياقربنا من بعضنا بالكلام الفصيح","https://www.poetsgate.com/ViewPoem.aspx?id=204537",""],[5573,"البارحه خايلت وصلك سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=213729",""],[5652,"ليه الفساد بموطني له رياده","https://www.poetsgate.com/ViewPoem.aspx?id=176979",""],[5652,"لا ترتجي للي قضى ف ابن عمه !!","https://www.poetsgate.com/ViewPoem.aspx?id=177736",""],[5652,"مكاسر العنبر","https://www.poetsgate.com/ViewPoem.aspx?id=181102",""],[5691,"تدور بنا الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206080",""],[2220,"جمعتُ همي عليا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11907&r=&rc=776",""]],"verses":[["إِلى يَقظانَ وَقّادَ العَوالي","مُريشِ السَعيِ بِالرَأيِ المُصيبِ",0,"ب",1,0],["إليَّ يا نرجس انظر","بأعين منك نُجل",1,"ل",1,0],["آلى يمينًا ماله","غيرَ ابن آدمَ من وَقود",2,"د",1,0],["إلى يوم تُطيح بما أقاموا","وما اختَطُّوا فتَنسِفُهُ اقتِلاعا",3,"ع",2,0],["آلَى يميناً على قتلِي مردَّدةً","وجاء بالزُور فيما قال يعتذرُ",4,"ر",1,1],["إلى يومِ فَلْجٍ ساطِعٍ لَكَ نُورُهُ","وميقَاتِ فتحٍ صادقٍ لكَ وعْدُهُ",5,"د",2,0],["إلى يوم يؤوبُ الناسُ فيه","إلى دنياهُم قبلَ الحسابِ",6,"ب",1,0],["إلىَ يَثْرِبٍ وَالْقَلْبُ يُكْوى بِجَمْرَةٍ","نَوَيْتُ بِعَزْمِي أنْ يُشَادَ بِزَوْرَةٍ",7,"ه",1,0],["آلى يَذُوق الدَّهرَ آبِ سَردِ","مَن يَلقَه مِن بَطَلٍ مُسرَندِ",8,"د",1,0],["إِلى يحيى أهش ولن أهشا","لطلعة شادن هوناً تمشى",9,"ش",2,1],["آلى يَميناً أَبو الهنديِّ كاذِبَةً","ليعطين زواني لست ما شينا",10,"ن",2,1],["إلى يمينك إلا بعد موتهما","حنثت فاعلم وكن من ذا على وجل",11,"ل",1,0],["إلى يا سيننا الأحلى","إلى المختار نعمَ أبي",12,"ب",2,0],["إليَّ يا من تعالى","عن الكيان النيّا",13,"ي",2,0],["الى يوسف نهدي الهنا والثنا الحرا","فتى يزبك من بالهنا والثنا احرى",14,"ر",2,1],["إلى يُمناكَ أشكو فَيْضَ سُحْبٍ","كما تَشكو الجنودُ إلى الأمير",15,"ر",1,0],["إِلى يَومٍ تَرى فيهِ","مَحيّا بطرس الصخرِ",16,"ر",1,0],["إلى يثربٍ حيثُ اللجوءُ لأحمدٍ","كميَّاً تراني والهمامَ الْمُجنّدا",17,"د",2,0],["ألي ينجرح يروح على الطبيب","يخيطه بكم عقدة طرية",18,"ي",2,1],["الي يمد الطيب...والصدق ...والجود","لا ينتظر عند الخلايق .....جزاها",19,"ا",3,0],["إلى يمن سعيد بات يبكي","عذابات الأهالي فيه ذرفُ",20,"ف",1,0],["إلى يومنا هذا عجيب ومدهش","حقائقه العظمى التي لا تني تترى",21,"ر",2,0],["الي يسل مهنّده","ما يكرهه لاجربه",22,"ب",2,0],["الي يخون الامانه بالخيانه يطيح","ماله على مايقولون الخلايق ضمان",23,"ن",1,0],["الي يراضيني بوصله جنابه","كني بوصله حي والعالم اموات",24,"ت",1,0],["الي ينام ومحتظن له وساده","بالعون ماحسب ضياعه وفرقاه !",25,"ا",2,0],["الي يطيح وهامته تعتلي روس","مطيحةٍ ترقى ،،، على راس قمه",26,"م",2,0],["الي يقول القول ماله لو حكى ذرة قوات","منهو جحد حق النشاما كذب الله قايله",27,"ل",2,0],["إلى يوْمِ أنْ تلْقى الخَليقَةُ ربَّها","بأعْمالِها والكلُّ في العُنْقِ دفْتَرُهْ",28,"ر",2,0],["إليّ يا منْ تعالى","عنِ الكيانِ إليا",29,"ي",2,0]]}