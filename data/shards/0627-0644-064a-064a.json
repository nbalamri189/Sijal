{"poems":[[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85424","المجتث"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[229,"آلى يمينا على قتلي مرددة","https://www.aldiwan.net/poem51025.html","البسيط"],[439,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"]],"verses":[["إِلى يَقظانَ وَقّادَ العَوالي","مُريشِ السَعيِ بِالرَأيِ المُصيبِ",0,"ب",1,0],["إليَّ يا نرجس انظر","بأعين منك نُجل",1,"ل",1,0],["آلى يمينًا ماله","غيرَ ابن آدمَ من وَقود",2,"د",1,0],["إلى يوم تُطيح بما أقاموا","وما اختَطُّوا فتَنسِفُهُ اقتِلاعا",3,"ع",2,0],["آلَى يميناً على قتلِي مردَّدةً","وجاء بالزُور فيما قال يعتذرُ",4,"ر",1,1],["إلى يومِ فَلْجٍ ساطِعٍ لَكَ نُورُهُ","وميقَاتِ فتحٍ صادقٍ لكَ وعْدُهُ",5,"د",2,0]]}