{"poems":[[53,"أبا العباسِ عمرت","https://www.aldiwan.net/poem66081.html","الهزج"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[591,"سلوي عن هواكم لا يجوز","https://www.aldiwan.net/poem17552.html","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136346","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136255","الوافر"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128318","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94474","الطويل"]],"verses":[["ولي ظرفٌ ولي رأيٌ","وثيقٌ كعُرا العِكمِ",0,"م",1,0],["ولَّى ظلامُ الظُّلمِ فيهِ فما لهُ","أثَرٌ وشاعَ بعدلِه الأنوارُ",1,"ر",1,0],["وَلي ظَبْيٌ غَريرٌ في حِمَاكُمْ","لَهُ حُسْنٌ على قَلْبي عَزيزُ",2,"ز",1,0],["ولي ظن بربي مستمر","من الضراء والبلوى يقيني",3,"ن",2,0],["ولي ظن جميل فيه ارجو","يقابلني من الرحمن عطف",4,"ف",1,0],["وَلي ظاهِرٌ في الحُبِّ يَحلو مذافُه","عَلى أَنَّه يُطوى عَلى باطِنٍ مُرِّ",5,"ر",1,0],["وليظلّ في هجر الأحبّة طالباً","لرضاك مما جار إن لم تسعف",6,"ف",1,0],["وَلي ظبية حسناء لا تنجز الوعدا","وتأَبى تدانينا كما اختارت البعدا",7,"د",2,1]]}