","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102143","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27734","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132206","الطويل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84512","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65995","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93822","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132746","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68034","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88935","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88936","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88937","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88910","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105815","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59509","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135878","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90846","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94397","البسيط"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114012","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4858,"شباب الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=34448",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[4884,"جمعيَّةُ البرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=201733",""],[4884,"هي الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=202365",""],[4927,"دموع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29947",""],[5056,"<< نُحاةُ الأدب..>>","https://www.poetsgate.com/ViewPoem.aspx?id=34139",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5174,"حوار مع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187134",""],[5271,"لأني أحبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=59740",""],[5768,"لِسانُ الضَّادِ فَخْرُ البلادِ !","https://www.poetsgate.com/ViewPoem.aspx?id=215276",""],[5797,"فقيد الدين والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=187796",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[6070,"الشام ( عروسُ المدى )","https://www.poetsgate.com/ViewPoem.aspx?id=193903",""],[6082,"لا تثقي","https://www.poetsgate.com/ViewPoem.aspx?id=180043",""],[6084,"عز الهدى والندى والعلم والعلما","https://www.poetsgate.com/ViewPoem.aspx?id=170871",""],[6093,"تَعالوا أيُّها الشُّعُّارْ ( مجزوء الوافر المذيل)","https://www.poetsgate.com/ViewPoem.aspx?id=181727",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""],[6152,"عافني واعف عني يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=215643",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِحَوادِرٍ يُعنِقنَ مِن تَحتِ القَنا","عَنَقاً يُعَرِّدُ بِالذِئابِ العُسَّلِ",0,"ل",1,0],["بُحورٌ تَقوتُ الناسَ في كُلِّ لَزبَةٍ","أَبوكَ وَأَعمامٌ هُمُ هَؤُلائِكَا",1,"ك",2,0],["بُحورٌ وَحُكّامٌ قُضاةٌ وَسادَةٌ","إِذا صارَ أَقوامٌ سِواكُم مَوالِيا",2,"ي",2,0],["بحوراً تَغْرَق السُّبَحاء فيها","ترى الجُرْدَ العِتاقَ لها سفينا",3,"ن",2,0],["بحور اللّهى والعلم فيهم بسيطها","وكاملها منهم وعنهم سريعها",4,"ع",3,0],["بحوله نرفع أقداركم","ذلك تقدير العزيز العليم",5,"م",1,0],["بُحورُ بَني أُمَيَّةَ أَورَثوهُ","حَمالاتٍ وَأَخلافاً رِغابا",6,"ب",2,0],["بُحورٌ بُدورٌ في النَوالِ وَفي الدُجى","غُيوثٌ لُيوثٌ في المُحولِ وَفي الفَلا",7,"ل",2,0],["بُحورُ الشِعرِ وافِرُها جَميلُ","مُفاعَلَتُن مُفاعَلَتُن فُعولُ",8,"ل",1,0],["بِحَوافِرٍ حُفرٍ وَصُلبٍ صُلَّبِ","وَأَ