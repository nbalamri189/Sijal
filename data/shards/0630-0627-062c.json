{"poems":[[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[45,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[63,"أبدين وصلا إذ رحمن متيما","https://www.aldiwan.net/poem51384.html","الكامل"],[115,"أيها الفاسي أتى ريحك","https://www.aldiwan.net/poem2369.html","مجزوء الرمل"],[202,"أيها الراكب المخب لتبلغ","https://www.aldiwan.net/poem51918.html","الخفيف"],[815,"","https://poetry.dctabudhabi.ae/diwan/poem/144635","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38917","الرجز"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144779","الخفيف"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93691","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204998","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75713","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101362","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45052","الرمل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89574","الرمل"],[4984,"الجرْس ( وحي العيد )","https://www.poetsgate.com/ViewPoem.aspx?id=180973",""],[5082,"قَبسٌ من ثنيّاتِ الضّياء","https://www.poetsgate.com/ViewPoem.aspx?id=213052",""],[5121,"الجناح الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=36279",""],[5186,"يا تراما، كيفما سار ترامى","https://www.poetsgate.com/ViewPoem.aspx?id=156528",""],[5593,"ذا جمعت بين امرأين صناعة","https://www.poetsgate.com/ViewPoem.aspx?id=181054",""],[5939,"زار كالسحر ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=195323",""],[6115,"اذا جتني الذمّه من اللاش","https://www.poetsgate.com/ViewPoem.aspx?id=180455",""]],"verses":[["ذا جُبارٍ مُنضِجاً ميسَمُهُ","يُذكِرُ الجارِمَ ما كانَ اِجتَرَح",0,"ح",1,0],["ذا جودُ مَن لَيسَ مِن دَهرٍ عَلى ثِقَةٍ","وَزُهدُ مَن لَيسَ مِن دُنياهُ في وَطَنِ",1,"ن",1,0],["ذا جود من نسي العواقب عزة","وسداد من قبل الأمور تجاربا",2,"ب",2,0],["ذا جَوابي وَهوَ ظُلمٌ","لَكَ وَالبادئ أَظلَم",3,"م",1,0],["ذا جوىً ناصبٍ ودمعٍ خضيبٍ","وحشاً ذائبٍ وقلبٍ خفوق",4,"ق",1,0],["ذا جواب لابن القشيري فاسمع","إن أردت السداد سراً وجهرا",5,"ر",2,0],["ذا جامِعٌ على التّقى بُنيانُه","أَسَّسهُ الباني وَكانَ يرفعُ",6,"ع",1,1],["ذا جواب فيه المرام وضوحاً","بالذي رمته كطلعة فجر",7,"ر",1,0],["ذا جُرأَةٍ تُسقِطُ الأَحبالَ رَهبَتُهُ","مَهما يَكُن مِن مَسامٍ مَكرَهٍ يَسُمِ",8,"م",1,0],["ذَا جَاحِدُ الرَّحمَنِ رَأساً لَم يُقِرَّ","بِخَالِقٍ أبَداً وَلاَ رَحمَنِ",9,"ن",1,0],["ذا جَعفر المفضال في أَعواده","وَيح الأَنام إِذا قَضى مفضالها",10,"ل",3,0],["ذا جاهل غرٌّ يقلد جاهلا","ولعلني في الجهل أعظم منهما",11,"م",2,0],["ذا جفون نافِرات نعس","منعت عينيّ من طيب الكرى",12,"ر",2,0],["ذا جيده عطلاً حلاه صانعه","وبالهلال برغم الريم حلاكا",13,"ك",2,0],["ذا جَمالٍ وَجَلالٍ زانَهُ","حُسنُ بِشرٍ كَنَسيمٍ إِذ سَرى",14,"ر",2,0],["ذا جَوىً عَمرَيكَ يَغدو","ذا جَوىً أَيضاً يَروحُ",15,"ح",1,0],["ذا جديد من المحبة عيد","إذْ أقام الهلال في الأفق عرسا",16,"س",2,0],["ذا جبيني به الحياءُ نِداءٌ","وعَفافٌ طيُّ الحجى وانسجامُ",17,"م",1,0],["ذَا جَنَاحٌ أَخْضَرٌ ضَمَّ ارْتِحَالِي","رِيشُهُ الْمَبْلُولُ مَهْدٌ لاصْطِفَائِي",18,"ا",2,0],["ذا جزا من رام بالظلم مراما،","وبذا نجني مراما، فمراما",19,"م",2,0],["ذا جمعت بين امرأين صناعة","فأحببت أن تدري الذي هو أحذق",20,"ق",1,1],["ذا جزائي لأنّني","رُمتُ زهرًا مُعَطَّرا؟",21,"ر",2,0],["ذا جتني الذمّه من اللّاش وابن اللاّش","وقام يتكلم بالقفا كل هراّجي",22,"ج",2,1]]}