","https://www.poetsgate.com/ViewPoem.aspx?id=188440",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5121,"يَا طُيُورُ اذْكُرِيِنِي","https://www.poetsgate.com/ViewPoem.aspx?id=49541",""],[5136,"لن تسع الناس بالنوال ولا","https://www.poetsgate.com/ViewPoem.aspx?id=121753",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5137,"دمعة في ليلة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=101525",""],[5183,"ملغزه رق156م","https://www.poetsgate.com/ViewPoem.aspx?id=186397",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[5183,"إلى الباكستان","https://www.poetsgate.com/ViewPoem.aspx?id=185671",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5190,"العكاز","https://www.poetsgate.com/ViewPoem.aspx?id=153354",""],[5277,"لا تعجبوا","https://www.poetsgate.com/ViewPoem.aspx?id=191253",""],[5312,"الحكمُ للهِ كلٌّ غيرُه فاني","https://www.poetsgate.com/ViewPoem.aspx?id=128473",""],[5409,"خلطاء من كل فج حضور","https://www.poetsgate.com/ViewPoem.aspx?id=155271",""],[5409,"عدتها والفكر منها","https://www.poetsgate.com/ViewPoem.aspx?id=155256",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5470,"كتبتُ عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=10983",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5596,"ابوسرور فقيد الفقه والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206773",""],[5651,"سفرَتْ فقال أدلّةُ السّفْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=107008",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5785,"لا رعى الله من بالجفا والهجر شار","https://www.poetsgate.com/ViewPoem.aspx?id=131574",""],[5956,"منطق العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=192221",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6079,"يا تعسَ قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=207048",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""],[6131,"يَا صَاعدًا للنورِ متَّكئَ النَّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=189339",""],[5309,"واها لشعبك من اذى عظمائه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573575",""],[5781,"أغرقتني بالحبِّ فذَبُلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87233&r=&rc=0",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[6256,"الجلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65927&r=&rc=15",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["وَاِستَمِلّا حَديثَ مَن سَكَنَ الخَي","فَ وَلا تَكتُباهُ إِلّا بِدَمعي",0,"ع",2,0],["وأسْتَمِلُّ إذا ريحُ الصَّبا نَسَمَتْ","حَديثَ نَعْمانَ والأنْباءَ عن حَضَنِ",1,"ن",1,0],["وَاِستَمطِري جَدوى يَدَيهِ فَطالَما","خَلَفَ الحَيا في كُلِّ عامٍ مُمحِلِ",2,"ل",1,0],["وَاسْتَمِدُّوا هُدَى سَجِيَّتِكُمْ وَاتَّ","خِذُوهَا لَكُمْ نَصِيحاً أَمِينَا",3,"ن",2,0],["واستمرّت رمياً بها عن بنان","لطفه ضامن له أن يصيبا",4,"ب",2,0],["واستمرّت أقواتنا في انتقاص","وتفشّى في سوقها الاحتكار",5,"ر",1,0],["وَاِستَمطِروا نَفَحاتٍ غَيرَ مُخلِفَةٍ","مِن سَيبِ مُستَبشِرٍ بِالمُلكِ مَسرورِ",6,"ر",1,0],["واسْتمعها يا أعرب الخلق نطقاً","ذات رفع وإن أتت في انْخفاض",7,"ض",1,0],["واستمعْ في اللهو منّي","إنني رأسُ دعاتِهْ",8,"ت",2,0],["وَاِستَمِع لِلشِعرِ مِن بُلبُلِها","فَهُوَ الشِعرُ الَّذي لَيسَ يُضاهى",9,"ا",3,0],["وَاِستَمَعَ الفيلُ إِلى الخِنزيرِ","مُوتَنِساً بِصَوتِهِ النَكيرِ",10,"ر",1,0],["وَاِستَمطَروا في المَحلِ مِنكَ خَلائِقاً","أَصفى وَأَعذَبَ مِن زُلالِ الماءِ",11,"ا",2,0],["وَاِستُمطِرَت نُجلُ العُيونِ فَأَخضَلَت","وَردَ الخُدودِ بِواكِفٍ هَطّالِ",12,"ل",1,0],["وَاِستَميحا الجُفونَ دِرَّةُ دَمعٍ","في دُموعِ الفِراقِ غَيرِ لَصيقِ",13,"ق",1,0],["واستمدّوا الحنانَ من أعظمِ النّا","سِ حَناناً وأقربِ الرُّسْلِ رُحْما",14,"م",2,0],["وَاِستَمِعِ الآنَ حَديثَ الكوفَه","مَدينَةً بِعَينِها مَعروفَه",15,"ه",1,0],["وَاسْتَمْطِرِ البركاتِ مِنْ دَعَوَاتِهِ","حيث استقَلَّ سحَابُ راحَتِهِ النَّدِي",16,"د",2,0],["وَاِستِماعي الغِناءَ مِن كُلِّ خَودٍ","ذاتِ دَلٍّ بِطَرفِها السَحّارِ",17,"ر",1,0],["وَاِستَمكَنَ الوَصلُ وَأَشياعُهُ","مِن قَوَدِ الإِبعادِ وَالهَجرِ",18,"ر",1,0],["واستمسكت واعتصمت به الفطن","كعروة الملة أو حبل الوطن",19,"ن",1,0],["وَاسْتَمْتَعَ الطُّلاَّبُ حَولَ سِمَاطِهِ","بِالعِزِّ فِي ذَاكَ الجَنابِ الأَخْضَرِ",20,"ر",1,0],["وَاسْتَمَعَتْ فِي الغَدَاةِ قِيلاً","إِنَّ أَبَاهَا لِلحَرْبِ سَارْ",21,"ر",1,0],["وَاسْتَمْتِعَا بِالرفاءِ وَاغْتَدِيَا","رَأْساً لِسِبْطٍ أَعِزَّةٍ كُثْرِ",22,"ر",1,0],["واستمتعوا فيك تغريداً ورفرفةً","أما رأيت ولوع الطيرِ بالشجَرِ",23,"ر",1,0],["واستمسكوا بالدين؛ فهْو دريئَةٌ","للنشء، كَّباحٌ لكلِّ جِماح",24,"ح",1,0],["واستمدي الأنوار من كلمات","الله إن الهدى بحق هداها",25,"ا",3,0],["واستمدت من إله الحقل . والبيت","والمصنع . عزما ومَضَاء",26,"ا",2,0],["واستمع لا تجدْ سوى نَبضاتِ القلب","دقَّت خزفَ الحساب ارتياعا",27,"ع",2,0],["واستمع : هذه البلابل غنّت","فأثار الشجون ذاك الغناء",28,"ا",2,0],["وَاِستَميلي مَديح مِن تَخذ المَج","دُ لِأَسماعِهِ ثَناهُ رَعوثا",29,"ث",2,0],["واستمر الندمان يسقون صرفاً","من رحيق كرومه جلعاد",30,"د",1,0],["واستمرتْ على الجفاءِ وإنِّي","لم أحُلْ عن مودتي وودَادِي",31,"د",2,0],["واستمطر الشوق لما فضّ خاتمه","مدامعاً صرن للأسطار أسطارا",32,"ر",2,0],["واستَمَرَّتْ بِنَا الحيَاةُ رَحيلاً","واسْتَقَرَّتْ بِذِكْرَيَاتٍ تُرَسَّمْ",33,"م",1,0],["واستمالوا الناس بالدين","على الدين ضرارا",34,"ر",2,0],["واستمرّ الغيث حتّى","شقّ وجه الأرض شقا",35,"ق",2,0],["وَاِستَمرّوا على الخلافِ إلى أن","فرّ ذاكَ الجفا وقرّ الوفاءُ",36,"ا",2,0],["وَاِستمرّت ولايةُ اللَّه إذ تم","مَ بهِ للنبوّة الإرتقاءُ",36,"ا",2,0],["واستَمسِكوا بالعروَةِ الوُثقى وكونوا","صادقينَ عقيدةٌ ولِسانا",37,"ن",2,0],["وَاِستَمَرَّ اللَئيمُ في حوبَةِ اللُؤ","مِ فَأَمسَت كلُّ الشُعوب لئاما",38,"م",2,0],["واستمل من خير الصبالاخ الهوى","ما صحّ من إسناده عن هضبه",39,"ب",2,0],["وَاِستَمالَ النَسيمُ مُح","تَضِناً قامَةَ الغُصُن",40,"ن",1,0],["وَاِستَمِع مِن شاعِرٍ يَدُهُ","بِكَ بَعدَ اللَهِ تَمتَسِكُ",41,"ك",1,0],["وَاِستَمِعها عَذراءَ شَرطَ التَهاني","وَاِقتِراحِ النَدمانِ وَالجُلّاسِ",42,"س",1,0],["وَاِستَمِع مَدحَ وَليٍّ","مُخلِصٍ فيكَ الوَلاءا",43,"ا",3,0],["وَاِستَمِعها عَذراءَ ما مُدِحَت قَب","لَكَ يَوماً بِمِثلِها الخُلَفاءُ",44,"ا",2,0],["وَأَستَمِرُّ أُموراً كُنتُ أَعهَدُها","وَأَنتُمُ جيرَةٌ وَالعَيشُ قِنديدُ",45,"د",1,0],["واِستمطر واغيم برى","ان الجواد يَجود",46,"د",1,0],["واستميتوا في ساحة المجد حتى","يظهر الحقُ في غلائل بُرس",47,"س",1,0],["واِستَملها غَرّاءَ منظومَةً","كالعِقد في لَبَّة جيداءَ رود",48,"د",1,0],["وَاِستَمع شرحَ حاله في كلامٍ","مونقٍ موجز بطيّ المعاني",49,"ن",2,0],["وَاِستمع شدوَ عَندليب","طالَما لِلنهى سَحر",50,"ر",1,0],["واستَمطَروا سُحُبَ المواهبِ من يَدِ","بَيضاءَ صِيغَتْ للنَدى والجُود",51,"د",1,0],["واستمع التَّعريفَ فيها بالعَرض","وتارةً بالذاتِ والوصفِ الغرض",52,"ض",1,0],["وَاِستَمر أَخلاب الكفاف فَإِنَّهُ","بِالحَرّ إِن عُنف الزَمان شَفيق",53,"ق",1,0],["واستمدّوا من نغمة المطر السا","قط أحلى الإلهام والإيحاء",54,"ا",2,0],["واستمع نظم جواب خلته","بالمنيرات من الشهب حُبِكْ",55,"ك",1,0],["واستَمالَتْنا بِوعدٍ كاذبٍ","فتَمَسَّكنَا بِواهٍ مِن عُراها",56,"ا",3,0],["وأستَميتُ لما تأتي الخطوبُ به","ليعلَم الخطبُ أنّي لستُ أرهَبُهُ",57,"ب",2,0],["واستَمَرَّ الصّدودُ واِن","قَطعَ الوصلُ وانْقَضَى",58,"ض",2,0],["واستَمدَّتْ من رأيه فَلَقَ الصُّبحِ","بَياناً منه وعلماً رصينا",59,"ن",2,0],["واستملك الملك عن رأي يسدّده","بحدٍّ سيفٍ وفضل غير محدود",60,"د",1,0],["واستمطرت لؤلوءا من لؤلوء وروى","عن النسيم غصن البان عطفاها",61,"ا",3,0],["واستمالوهُ بالخضوع ومن شر","طِ الشُّجاعِ الكريمِ أَن يُسْتَمالا",62,"ل",2,0],["واستماحوا منه النّوى وعجيبٌ","أَنْ يُعَدَّ النَّوى لقوم نوالا",62,"ل",2,0],["واستمِعْ إنْ أردتَ تسمعُ نُصحي","واستمع إن أردت في أقوالِ