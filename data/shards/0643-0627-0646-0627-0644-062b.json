n/poem/86510","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59445","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44668","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28748","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66131","الطويل"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45298","الطويل"],[4621,"","https://poetry.dctabudhabi.ae/diwan/poem/97654","الطويل"],[1012,"الشعشعة","https://www.poetsgate.com/ViewPoem.aspx?id=186277",""],[585,"سل الفلك الدوار ما للكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=161870",""],[5145,"أعينا فؤادي على ما يعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108214",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5992,"كأنَّ بروقَ الجوّ في حجراتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=41847",""],[572,"ألا رُبَّ ليلٍ أرعى نجومَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9364&r=&rc=221",""]],"verses":[["كَأَنَّ الثُرَيّا حَينَ لاحَت عَشِيَّةً","عَلى نَحرِها مَنظومَةٌ في القَلائِدِ",0,"د",1,0],["كَأَنَّ الثُرَيّا غُرَّةٌ وَهوَ أَدهَمٌ","لَهُ مِن وَميضِ الشِعريينِ حَجولُ",1,"ل",1,0],["كَأَنَّ الثُرَيّا رايَةٌ مُشرِعٌ لَها","جَبانٌ يُريدُ الطَعنَ ثُمَّ يَهابُ",2,"ب",1,0],["كَأَنَّ الثُرَيّا عُلِّقَت في مَصامِه","بِأَمراسِ كِتّانٍ إِلى صُمِّ جَندَلِ",3,"ل",1,0],["كَأَنَّ الثَآليلَ في وَجهِها","إِذا سَفَرَت بِدَدُ الكِشمِشِ",4,"ش",1,0],["كان الثريا اطلعت من عِشائها","بوجه فتاةِ الحي ذاتِ المجاسد",5,"د",1,1],["كأنَّ الثرى خدّ من الدمّ مشرق","إذا ما التقى الصفان والخيل خيلان",6,"ن",1,0],["كأن الثريّا عُلِّقَتْ في جبينه","وبدر الدُّجى في النحر صيغ له عِقْدا",7,"د",2,0],["كأن الثريا إذ تجمَّع شملها","رياض ربيع فصِّلت بشقيقِ",8,"ق",1,1],["كان الثمانون التي قد جازها","ترنو اليه بأعين المتهدد",9,"د",1,0],["كأن الثريا كف خود تزينت","خواتيمها بالدر ما أحسن الدرا",10,"ر",2,0],["كَأَنَّ الثُرَيّا سابِحٌ مُتَكَبِّدٌ","لِجَريَةِ ماءٍ يَستَقِلُّ وَيَرجِعُ",11,"ع",1,0],["كأنَّ الثُرَيَّا راحَةٌ تَشْبُرُ الدُّجى","لتعلمَ طالَ اللَّيلُ لي أَم تعرَّضا",12,"ض",2,0],["كأنّ الثريّا فيه سَبْعُ جواهرٍ","فواصلُها جَزْعٌ به فُصّلَ النظمُ",13,"م",1,0],["كَأَنَّ الثرَيَّا في انقضاضِ أُفولِها","وِشاحٌ منَ الظَّلماءِ حلّ عنِ الخصرِ",14,"ر",1,0],["كَأَنّ الثُريّا فيه باقَةُ نَرجِسٍ","مِنَ الشرقِ يُهديها إِلى مَغْربٍ مُهْدِ",15,"د",1,0],["كَأَنَّ الثُّرَيَّا كَفُّ عَذْرَاءَ طفْلَةٍ","بِهِ رَعْشَةٌ لِلْبَيْنِ بَادِي الْخَوَاتِمِ",16,"م",1,0],["كَأَنَّ الثُرَيّا هَودَجٌ فَوقَ ناقَةٍ","يَحُثُّ بِها حادٍ إِلى الغَربِ مُزعَجُ",17,"ج",1,1],["كَأَنَّ الثُرَيّا وَالظَلامُ يَحُفُّها","فُصوصُ لُجَينٍ قَد أَحاطَ بِهِ سَبَج",18,"ج",1,0],["كَأَنَّ الثُرَيّا يَومَ راحَت عَشِيَّةً","عَلى نَحرِها مَنظومَةً في القَلائِدِ",19,"د",1,0],["كأنّ الثرَيّا والصّباحُ يرُوعُها","أخُو سَقْطَةٍ أو ظالعٌ مُتحامل",20,"ل",1,0],["كَأَنَّ الثُرَيّا عُلِّقَت في مَصامِها","بِأَمراسِ كِتّانٍ إِلى صُمِّ جَندَلِ",21,"ل",1,0],["كأن الثلوجَ النازلاتِ على الرّبى","عمائمُ بيضٌ كُوِّرتْ فوق مَفْرِق",22,"ق",1,0],["كأنّ الثُّرَيا تقدم الفجرَ والدُّجى","يضم حَواشِى سَجْفِه للمَغاربِ",23,"ب",1,1],["كَأنَّ الثَرى رام تَقبيلَها","فمدَّ إلَيها رُءوسَ الزُبى",24,"ا",1,0],["كأنّ الثريّا والظلامُ يَحُثُّها","فصوصُ لُجَيْنٍ قد أحاط به سَبَجْ",25,"ج",1,0],["كأنّ الثريّا تحت حُلْكة ليلِها","مَدَاهِنُ بِلَّوْر على الأفْق يَضْطرِب",26,"ب",1,0],["كأنّ الثريّا في مُلاءِة فجرِها","مَصابِيحُ إلاّ أنّها قد بدتْ تَخْبو",27,"ب",2,0],["كأنَّ الثريا في الدُجنةِ طرةٌ","مرصعةُ الأطرافِ باللؤلؤِ النَثرِ",28,"ر",1,0],["كَأَنَّ الثُّرَيّا تَلْثِمُ الْبَدْرَ كُلَّما","تَمَطَّقْتَها فِي الْكَأْسِ عانِسَةً بِكْرا",29,"ر",2,0],["كأَنَّ الثريّا إذ تَجَلَّت خواتِمٌ","تحلَّت بها من كفِّ خودٍ أَنامِلُ",30,"ل",1,0],["كأنّ الثُّريّا لبادي الظّلا","مِ كَفٌّ إلى نَهْجِ عَلْياكَ تُومي",31,"م",2,0],["كأنّ الثُريّا استأمَنتْ لجنُودِها","فقد بسَطَتْ للعهدِ كفَّ مُصالح",32,"ح",1,0],["كأن الثريا طوق عقد بجيدها","توارت حياء من ضيا المبسم الدري",33,"ر",2,0],["كأنّ الثريّا والهلالَ تقاسما","جمالَهُما من قُرطِهِ وسِوارِه",34,"ر",2,0],["كأن الثريا فيه قوم تجمعوا","لرأي فلا خلف لديهم ولا نكر",35,"ر",1,0],["كأنّ الثرى أفقٌ كأنَّ مطيتي","هلال كأنَّ السير موئله الحَشْرُ",36,"ر",1,0],["كأنّ الثُرّيا في اختلاف نجومها","بوادرُ آمال يحاولها الجر",36,"ر",1,0],["كأنَّ الثرّيا سُبحْةٌ من لآليء","وهت في رماد إِثر عجلان خائف",37,"ف",1,0],["كأنَّ الثريّا وقد جمّعت","كواكبَها والضيا مُقْبِلُ",38,"ل",1,1],["كأن الثريّا لسانٌ علي","ه يُثني معي أو يدٌ تسألُ",39,"ل",1,0],["كأنّ الثريّا على جنحه","يدِي من مَقام الهوى تستجيرُ",40,"ر",1,0],["كأنّ الثرى من طيبها فَتَّ فوقه","مجيزون من دارِينَ فأرا فوائحا",41,"ح",2,0],["كان الثرى أذنٌ لبثي سميعةٌ","لها صيغ ذاك اللؤلؤ الرطب والشذر",42,"ر",1,0],["كَأَنَّ الثُرَيّا فَورَها وَسُكونَها","نُجومٌ جَلاها الفَجرُ فَاِحتازَها أَفلُ",43,"ل",1,0],["كأَنَّ الثَرى في المَحلِ مُستَشفعٌ بِهِ","لِيَرويَهُ مِن سُحبِ جفنيَّ وابِلُ",44,"ل",1,0],["كأنَّ الثُّرَيَّا فيه كأسُ مُدَامةٍ","وقد مَالَتِ الجَوْزَاءُ مِيْلَةَ نَشْوَانِ",45,"ن",1,0],["كَأَنَّ الثّريّا بَينَ أَيديهِ إِذ بَدَت","جَواهِرُ مِن دُرٍّ لَقَد نظمت شِنفا",46,"ف",2,0],["كَأَنَّ الثريّا عِقدُ درٍّ وَجَوهَرٍ","إِذا حَلَّ فيها البدرُ يَجعَلُها شَنفا",47,"ف",2,0],["كأن الثريا كف نقاد استوى","على نطع سبج فوقه نثر النقد",48,"د",1,0],["كأن الثريا والغروب يحثها","لجام على رأس الدجى وهو يركض",49,"ض",1,0],["كأنَّ الثريا نسوة قد تجمعت","فكلُّ على بثّ الهوى متواجدُ",50,"د",1,0],["كأن الثريا ناهد جال كأسها","فَلَم تألُ حطاً للندامى وَلا رفعا",51,"ع",2,0],["كأن الثكالي منهم في نياحة","وأوصافهم من خيفة تتخلع",52,"ع",1,0],["كَأنَّ الثريَّا في الدُّجَى وَعُطَارِدٌ","بأفْقِ سَمًا داجي الذوائب ألْيَلِ",53,"ل",1,1],["كَأنَّ الثُرَيَّا إذْ تَلاَهَا عُطَارِدٌ","ثُرَيَّا مَصَابِيحٍ زَهَتْ فَوْقَ شَمْعَةِ",54,"ه",1,1],["كَأنَّ الثريا فِيهِ عقدٌ مُنَظَّمٌ","عَلَى جِيدِ خَوْدٍ في حُلَى الشَّعْرِ تَنْجَلِي",55,"ي",1,0],["كَأن