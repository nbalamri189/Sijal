{"poems":[[55,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[90,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[29,"إذا أولى النجوم بدت فغارت","https://www.aldiwan.net/poem5923.html","الوافر"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[74,"ألا من لمسلوب الفؤاد رهينه","https://www.aldiwan.net/poem20148.html","الطويل"],[74,"لها من جبين البدر أو قامة الغصن","https://www.aldiwan.net/poem20204.html","الطويل"],[46,"أقلق جفن العينين عن غمضه","https://www.aldiwan.net/poem30467.html","المنسرح"],[69,"قل لولي الدولة المرتجى","https://www.aldiwan.net/poem18074.html","السريع"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54830","الطويل"],[169,"رعى الله عهد حبيب ظعن","https://www.aldiwan.net/poem46862.html","المتقارب"],[288,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[308,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[367,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[394,"أشكو إلى الواحد الرحمن","https://www.aldiwan.net/poem54486.html","عموديه"],[440,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[460,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[466,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[531,"لله في خلقه ما شاء من نظر","https://www.aldiwan.net/poem37425.html","البسيط"],[568,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28077","الطويل"],[1119,"","https://poetry.dctabudhabi.ae/diwan/poem/79645","الطويل"]],"verses":[["وَإِنّي جَعَلتُ الأَنفَ مِن كُلِّ حاسِدٍ","قِبالي وَخَدَّي كُلِّ مُضطَغِنٍ أَرضي",0,"ض",2,0],["وإنّي جبان في فراق أحِبّتي","وإن كنت في غير الفراق شجاعا",1,"ع",2,0],["وَأَن يَجِدوكَ إِذ هَزّوكَ صَلتاً","عَفيفاً مِن سَجِيَّتِكَ العَفافُ",2,"ف",1,0],["وَإِن يَجفُ في بَعضِ الأُمورِ فَإِنَّني","لَأَشكُرُهُ النُعمى الَّتي كانَ أَودَعا",3,"ع",2,0],["وإني جلدٌ في ممارسة الهوى","مدلٌّ بمهديِّ الولاء أمينه",4,"ن",2,0],["وإن يجر شعر الأقدمين بمدحةٍ","لغيرك سلطاناً فأنت الذي تغني",5,"ن",2,0],["وَإِن يَجِد عِلَّةً نُعَمُّ بِها","حَتّى تَرانا نُعادُ مِن مَرَضِه",6,"ض",2,0],["وإن يَجِد في لُغَتي رِيبَةً","أَكتم نبا نازَعْتُ إِفْلاسِي",7,"س",2,0],["وَإِنّي جَديرٌ إِذ بَلَغتُكَ بِالمُنى","وَأَنتَ بِما أَمَّلتُ مِنكَ جَديرُ",8,"ر",1,0],["وإني جَوادٌ لم يُحَلّ لِجامُهُ","ونِضْوٌ يَمانٍ أغْفَلتْهُ الصّياقل",9,"ل",1,0],["وَإِنْ يَجْهَلِ الأَحَادُ مَا قَدْرُ جُهْدِهِ","وَمَا فَضْلُهُ فَالْعَارِفُونَ كَثِيرُ",10,"ر",1,0],["وإنِّي جُهينةُ أخبارِهِ","وعِنْدي اليَقينُ بِها فاسألَنْ",11,"ن",1,0],["واني جنة فتحت","وجل الناس لا يدري",12,"ر",2,0],["وَأَن يجلّل هذا القطر عافية","يُمسي بها الشعبُ منه وهو ملتئمُ",13,"م",1,0],["وإن يجْزعوا أن قيلَ لازِم بيتهِ","وإن كان نَجْماً حلَّ في خَير أبْرج",14,"ج",1,0],["وإن يجيني فرج عاجل","كثير وافر كبير الشان",15,"ن",1,0],["وأنّى جفتها المزن لا زال صائبا","من الجفن صوب بالمدامع ساجم",16,"م",1,0],["وأني جديد العهد مع كلّ غدرةٍ","وكلّ هوىً لا يحمل الغدرَ مخلِقُ",17,"ق",1,0],["وإني جدير بالكرامة منكم","ولولا محاج النحل ما كرم النحل",18,"ل",1,0],["وأنّي جبتُ مع منْ جم","معَ التاجين بُلدانا",19,"ن",2,0],["وإن يَجلَّ مُصَابٌ قَدْ أُصِيبَ بِهِ","سَاداتُ سادَاتِ أَهْلِ البَدْوِ والحَضَرِ",20,"ر",1,0],["وَإِن يَجبُنُوا تَشجُعْ وَإِن يَبخَلوا تَجُدْ","وَإِن يَخرُقوا بِالأَمرِ تَفصِل وَتَفرُقِ",21,"ق",1,0],["وإِن يَجنِ قَومي الحَربَ يَوماً كَفَيتُها","وَما أَنا بِالجاني وَلا هِيَ مِن أَجلي",22,"ل",2,0],["وأنِّي جعلتُ المالَ فيها خسارة","فليسَ على مال لديَّ معوَّلُ",23,"ل",1,0]]}