{"poems":[[55,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[90,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[29,"إذا أولى النجوم بدت فغارت","https://www.aldiwan.net/poem5923.html","الوافر"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[74,"ألا من لمسلوب الفؤاد رهينه","https://www.aldiwan.net/poem20148.html","الطويل"],[74,"لها من جبين البدر أو قامة الغصن","https://www.aldiwan.net/poem20204.html","الطويل"],[46,"أقلق جفن العينين عن غمضه","https://www.aldiwan.net/poem30467.html","المنسرح"],[69,"قل لولي الدولة المرتجى","https://www.aldiwan.net/poem18074.html","السريع"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54830","الطويل"],[170,"رعى الله عهد حبيب ظعن","https://www.aldiwan.net/poem46862.html","المتقارب"],[290,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[396,"أشكو إلى الواحد الرحمن","https://www.aldiwan.net/poem54486.html","عموديه"],[443,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[469,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[534,"لله في خلقه ما شاء من نظر","https://www.aldiwan.net/poem37425.html","البسيط"],[571,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48818","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136266","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117606","الوافر"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101895","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118343","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28077","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124757","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137209",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204909",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133962","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87514","الوافر"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117856","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131257",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[4159,"","https://poetry.dctabudhabi.ae/diwan/poem/79645","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54474","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120529","الوافر"],[4693,"وللكل من نيل المعز نصيب","https://www.poetsgate.com/ViewPoem.aspx?id=29941",""],[4767,"قوافي الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=181926",""],[585,"هنا المحفل المشهود بالشعب يزخر","https://www.poetsgate.com/ViewPoem.aspx?id=161897",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5376,"سأبقى بداري أعيش الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=188483",""],[5660,"فَإِنّي لَفي عِشقِ الجِيادِ زَعيمُ","https://www.poetsgate.com/ViewPoem.aspx?id=23710",""],[5818,"دموع وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193070",""],[5956,"النِّيلُ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184947",""],[6023,"فالمرء مفتونٌ بتأليفه","https://www.poetsgate.com/ViewPoem.aspx?id=123931",""],[5309,"أولعت بالعدل لا الأحداث تلهيني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573551",""]],"verses":[["وَإِنّي جَعَلتُ الأَنفَ مِن كُلِّ حاسِدٍ","قِبالي وَخَدَّي كُلِّ مُضطَغِنٍ أَرضي",0,"ض",2,0],["وإنّي جبان في فراق أحِبّتي","وإن كنت في غير الفراق شجاعا",1,"ع",2,0],["وَأَن يَجِدوكَ إِذ هَزّوكَ صَلتاً","عَفيفاً مِن سَجِيَّتِكَ العَفافُ",2,"ف",1,0],["وَإِن يَجفُ في بَعضِ الأُمورِ فَإِنَّني","لَأَشكُرُهُ النُعمى الَّتي كانَ أَودَعا",3,"ع",2,0],["وإني جلدٌ في ممارسة الهوى","مدلٌّ بمهديِّ الولاء أمينه",4,"ن",2,0],["وإن يجر شعر الأقدمين بمدحةٍ","لغيرك سلطاناً فأنت الذي تغني",5,"ن",2,0],["وَإِن يَجِد عِلَّةً نُعَمُّ بِها","حَتّى تَرانا نُعادُ مِن مَرَضِه",6,"ض",2,0],["وإن يَجِد في لُغَتي رِيبَةً","أَكتم نبا نازَعْتُ إِفْلاسِي",7,"س",2,0],["وَإِنّي جَديرٌ إِذ بَلَغتُكَ بِالمُنى","وَأَنتَ بِما أَمَّلتُ مِنكَ جَديرُ",8,"ر",1,0],["وإني جَوادٌ لم يُحَلّ لِجامُهُ","ونِضْوٌ يَمانٍ أغْفَلتْهُ الصّياقل",9,"ل",1,0],["وَإِنْ يَجْهَلِ الأَحَادُ مَا قَدْرُ جُهْدِهِ","وَمَا فَضْلُهُ فَالْعَارِفُونَ كَثِيرُ",10,"ر",1,0],["وإنِّي جُهينةُ أخبارِهِ","وعِنْدي اليَقينُ بِها فاسألَنْ",11,"ن",1,0],["واني جنة فتحت","وجل الناس لا يدري",12,"ر",2,0],["وَأَن يجلّل هذا القطر عافية","يُمسي بها الشعبُ منه وهو ملتئمُ",13,"م",1,0],["وإن يجْزعوا أن قيلَ لازِم بيتهِ","وإن كان نَجْماً حلَّ في خَير أبْرج",14,"ج",1,0],["وإن يجيني فرج عاجل","كثير وافر كبير الشان",15,"ن",1,0],["وأنّى جفتها المزن لا زال صائبا","من الجفن صوب بالمدامع ساجم",16,"م",1,0],["وأني جديد العهد مع كلّ غدرةٍ","وكلّ هوىً لا يحمل الغدرَ مخلِقُ",17,"ق",1,0],["وإني جدير بالكرامة منكم","ولولا محاج النحل ما كرم النحل",18,"ل",1,0],["وأنّي جبتُ مع منْ جم","معَ التاجين بُلدانا",19,"ن",2,0],["وإن يَجلَّ مُصَابٌ قَدْ أُصِيبَ بِهِ","سَاداتُ سادَاتِ أَهْلِ البَدْوِ والحَضَرِ",20,"ر",1,0],["وَإِن يَجبُنُوا تَشجُعْ وَإِن يَبخَلوا تَجُدْ","وَإِن يَخرُقوا بِالأَمرِ تَفصِل وَتَفرُقِ",21,"ق",1,0],["وأن يجدوا تجنِّيه عليهم","إباءً وهو صاحبك الودود",22,"د",1,0],["وإن يَجِئْ بقليلٍ نافعٍ زمنٌ","فقد يجيءُ سواه بالذي يجب",23,"ب",1,0],["وان يجمعن شملي بعيد تفرق","بمن سار بعد الفحر يعدو ويسبق",24,"ق",1,0],["وإني جلتُ في جيش الأعادي","برمحي وهو في فكري يجولُ",25,"ل",1,0],["وإن يجيء العدد المقدر","على التوالي إذ هو المؤثر",26,"ر",1,0],["وان يجيء المرجى منك في صفر","وفق المراد اذا يجلى بك الكبر",27,"ر",1,0],["وإِن يَجنِ قَومي الحَربَ يَوماً كَفَيتُها","وَما أَنا بِالجاني وَلا هِيَ مِن أَجلي",28,"ل",2,0],["وأن يجلس الإنسان عند محدث","بسر وقيل احضر وإن يأذن اقعد",29,"د",1,0],["وان يجرد بيمناه يراعته","كانت بيمناه امضى من شبا القضب",30,"ب",1,0],["وان يجئْ منه بعض رفس","فليس في رفسه اعتبار",31,"ر",1,0],["وأن يجي اللفظ على حرف فقط","أو عرضة للبدء فاحذر الغلط",32,"ط",1,0],["وان يَجري لبُعدكَ دمع عيني","وَعنها نورُ وجهكَ غير خافِ",33,"ف",1,0],["وإن يجزئيّ على كلى استدل","فذا بالاستقراء عندهم عقل",34,"ل",1,0],["وَان يَجُد لي بِوَصلٍ بَعدَ جفوَتِهِ","فَلا أُبالي احبّاً كنتُ اِو فانِ",35,"ن",1,0],["وَإن يَجُرَّا فِى مُضِىٍّ فكمِن","هُمَاوَ فِى الحُضُورِ مَعنىً فِى استَبِن",36,"ن",1,0],["وان يجتمع مال ومجد فحبذا","فذانك للحسناء عقد وخلخال",37,"ل",1,0],["وان يجعل الدين ذنب القتي","ل وعذراً به يبرأ القاتل",38,"ل",1,0],["وإن يجادلهم ضعيف فلن","يقنعهم حق ولا منطق",39,"ق",1,0],["وأنِّي جعلتُ المالَ فيها خسارة","فليسَ على مال لديَّ معوَّلُ",40,"ل",1,0],["وإنْ يجل شعري في مديحك رونقاً","وحسناً فإنَّ الشَّهدَ من نَحلِ النَّحلِ",41,"ل",1,0],["وإن يجنح الباغي لقولٍ تستراً","ويعزى لمقدور بدور يُناوِبُه",42,"ب",2,0],["واني جالب خيلا ورجلا","عليك من الاباعد والاداني",43,"ن",2,0],["واني جنوب الأرض يختال بائسا","واني شمال والشمال خصيب",44,"ب",1,0],["وإني جُرحتُ ولكنني","كجرح صدودك لم أجرح",45,"ح",1,0],["وإني جندي الجهاد وسيفه","هو القلم العضب الذي جئت أشهر",46,"ر",1,0],["وَإِنِّي جَؤُورٌ للإلهِ تَضَرُّعِي","فَمَا جَئِشَتْ نَفْسِي بِحُزْنِي لأَخْضَعَا",47,"ع",2,0],["وأن يجيرهم من كل معضلة","ويكشف السوء واللأواؤ والقشفا",48,"ف",2,0],["واني جلست وعيني لترنو","لرقص الطيور وفي السموات",49,"ت",1,0],["وَإِن يَجحَدِ الإِنعامَ لا عَاشَ بَعدَهُ","وَمَن يَجحَدِ الإِنعامَ فَهوَ لَئيمُ",50,"م",1,0],["وأنّي جعتُ والأحلامُ تنأى","وأنّي لَمْ أجدْ إلّا عنائي",51,"ا",2,0],["وإني جعلتُ العش أكبر خيمة","من البيت وامتدَّت عليه الفوارعُ",52,"ع",1,0],["وإن يجد عيباً يكن ساتراً","عَواره بالمِنَّة الوافية",53,"ي",2,0],["وَإِن يَجُد بِفُضولِ المالِ واحِدُهُم","فَإِنَّ غايَتَهُ تضسجيلُ تَمنينِ",54,"ن",1,0]]}