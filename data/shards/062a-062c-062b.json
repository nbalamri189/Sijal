{"poems":[[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92052","الوافر"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104902","الكامل"],[5121,"عاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=33598",""],[307,"لبّت نداءك","https://www.poetsgate.com/ViewPoem.aspx?id=214164",""],[5621,"قِبلةُ الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=24566",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5781,"قلبٌ وذرَّاتُ رماد ...","https://www.poetsgate.com/ViewPoem.aspx?id=176650",""],[5956,"أنا معجب بك‎ ‎","https://www.poetsgate.com/ViewPoem.aspx?id=182448",""],[5956,"يا دعْماً لعزتنا","https://www.poetsgate.com/ViewPoem.aspx?id=194271",""],[5956,"أعضاؤها لخدامتي تتسابقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205481",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6078,"ياأيُّها المتعبون","https://www.poetsgate.com/ViewPoem.aspx?id=202779",""],[6355,"بين اللذائذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66644&r=&rc=104",""]],"verses":[["تجثُّ نُفوسَ أَبناءِ الأَعادي","بما الآباء تلقى من أَليم",0,"م",1,0],["تجثو أمام مقامه زمراً","وتطوف حول مقيله زمرا",1,"ر",2,0],["تجثو على روحي جبالُ المعاني","منْ هوْلها جفَّ الهوا بالهبوب ِ",2,"ب",1,0],["تجثو الضيوفُ ببابِ عزّك سُجّداً","وشفاههم في ذكركِ التمْجيدُ",3,"د",1,0],["تجثو الكواكبُ تحت عَرشِكِ ترتوي","من فَيْضِ نورِكِº فالشموسُ وِضّاءُ",4,"ا",2,0],["تجثو لسطوتهِ الصفوف مهابةً","وإذا هموا وقفوا فوقفة صاغرِ",5,"ر",1,0],["تجثو على ركبتيها الريحُ هاجعةً","إنَّ المخاض كثغر الجرح يبتَردُ",6,"د",1,0],["تجثو الطبيعة والجوارح ترتوي","من بسمة لك قد تَشَهّاها القَمَرْ",7,"ر",1,0],["تجثو جميع أحاسيسي لطيبتكم","يا ذا المقدس يا نبراس أمتنا",8,"ن",2,0],["تجثو لدى جسمي تضمخ نفسها","بكسوره ترجو بها يتناسقُ",9,"ق",1,0],["تجثو لدى قدمي تقبّل كسْرَها","فأرى الكسور أمامها تتلاصقُ",9,"ق",1,0],["تَجثُو لكَ الأجْبَالُ طائِعَةً","حتَّى تَهَدَّلتْ إلى القَدَمِ",10,"م",1,0],["تجثو على تعبِ الشطآنِ في جسدٍ","ملَّ الصراعَ مع الأمواجِ في الظمأِ",11,"ا",1,0],["تجْثو تُقّبِّل أخْمصَيْه لَعلَّها","تنجو من العيشِ الذي لا تشتهي",12,"ت",3,0]]}