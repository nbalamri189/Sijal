بسيط"],[433,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[433,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[433,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[433,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[438,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[440,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[440,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[440,"شكرا لمن أعطاك ما أعطاكا","https://www.aldiwan.net/poem34906.html","الكامل"],[442,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[453,"قامت من الصب على لفظ من","https://www.aldiwan.net/poem13757.html","السريع"],[459,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[459,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[459,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[462,"لفخر الدين أخلاق كرام","https://www.aldiwan.net/poem15920.html","الوافر"],[462,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[462,"تبرع نصر بالزيارة والندى","https://www.aldiwan.net/poem16048.html","الطويل"],[462,"تأرج عرض الدهر من نشر منطقي","https://www.aldiwan.net/poem16146.html","الطويل"],[462,"أسدي البأس عذري الوفا","https://www.aldiwan.net/poem16229.html","الرمل"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[465,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[465,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[465,"عز الجفون وذلة الصبر","https://www.aldiwan.net/poem3484.html","عموديه"],[476,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[480,"قالو أجابت سؤلك الأيام","https://www.aldiwan.net/poem36944.html","الكامل"],[480,"وافى لصنوه شاعر يوما فما","https://www.aldiwan.net/poem37005.html","الكامل"],[480,"تهيأ يا شويعر للعقاب","https://www.aldiwan.net/poem37032.html","الوافر"],[501,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[505,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[515,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[515,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[516,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[537,"أجدك ما لعينك لا تنام","https://www.aldiwan.net/poem23869.html","الوافر"],[539,"لفي ضناك ضنى العلياء والحسب","https://www.aldiwan.net/poem48273.html","عموديه"],[552,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[552,"قالوا الحبيبة تيمتك","https://www.aldiwan.net/poem47322.html","مجزوء الكامل"],[552,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[563,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[568,"مخطف الخصر أجوف","https://www.aldiwan.net/poem69655.html","مجزوء الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[576,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[587,"يا دهر قد سمح الحبيب بقربه","https://www.aldiwan.net/poem17449.html","الكامل"],[588,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"]],"verses":[["لَفَّ عِرقي بِعِرقِهِ سَيِّدا النا","سِ جَميعاً مُحَمَّدٌ وَعَلِيُّ",0,"ي",1,0],["لَفَظَ المُلكُ شَجاهُ","وَأَساغَ اليَومَ ريقَه",1,"ق",2,0],["لِفِيهِ وَميضُ البَرقِ عِندَ اِبتِسامَتِهِ","وَعَيني إِذا جَدَّ البُكاءُ سَحابُ",2,"ب",1,0],["لَفَظَتْ دِيارُهُمُ الكِرامَ فما لَوى","طَمَعٌ إِلى عَرَصاتِهِنَّ صَليفي",3,"ف",2,0],["لفَظَتْ أحِبَّتَنا البلادُ فَمُعْرِقٌ","تُدمي جَوانحَهُ الهُمومُ ومُشْئِمُ",4,"م",1,0],["لِفَتاةٍ قَد جُوِّعَ الخَصرُ مِنها","أَكَلَ اللَحمَ وَالعِظامَ هَواها",5,"ا",3,0],["لَفَحَ الْهَجِيرُ وَجُوهَهَمْ بِسَعِيرِهِ","فَتَهَافَتُوا بِبُلاَلَةٍ وَتَعَلَّلُوا",6,"ل",3,0],["لُفَّ على المَعْنى الضّعيفِ القُوَى","كخِرْوِ قِطٍّ لُفَّ في خَمْجِ",7,"ج",1,0],["لَفظٌ طَويلٌ تَحتَ مَعنىً قاصِرٍ","كَالعَقلِ في عَبدِ اللَطيفِ الناظِرِ",8,"ر",1,0],["لِفاتِنٍ بِالحُسنِ في خَدِّهِ","وَردٌ وَأَثناءَ ثَناياهُ راح",9,"ح",1,0],["لِفَرِيقِ خَيْرٍ مِنْ غَوانٍ هُنَّ عَنْ","أَغْلَى الحِلَى بِصِفَاتِهُنَّ غَوَانِي",10,"ن",2,0],["لَفْظٌ إِلَى حُسْنِ الْبَدَاوَةِ جَامِعٌ","مَا لِلْحَضَارَةِ مِنْ جَدِيدِ مَعَانِي",11,"ن",2,0],["لفواق عوداً وبدأ يبادر","ن رواياه أن يجف الغديرا",12,"ر",2,0],["لِفُقدَانِ الخَضَاوِمِ مِن قُرَيشٍ","وَخَيرِ الشَّافِعِينَ مَعَاً شَفِيعَا",13,"ع",2,0],["لفكرته سرىً في كل وادٍ","كأنَّ حنينهُ فيها حداء",14,"ا",2,0],["لفلان في الديوان صورة حاضر","وكأنَّه من جملةِ الغياب",15,"ب",1,1],["لفظٌ تشفّ عن المعنى لطافته","كما تشفّ عن الرَّاحِ الزجاجات",16,"ت",1,0],["لفضَّةٍ كم رجاكَ القومُ أو ذهب","وحبَّبت للمثاقيل القناطير",17,"ر",1,0],["لفقدك إبراهيم أمست قلوبنا","مؤجَّجةً لا برد في نارها الحرى",18,"ر",2,0],["لفهمك الغفلة يا عاذلي","عمَّا أعاني ولفهمي الشعور",19,"ر",1,0],["لفظت أذنيَ الملامَ عليكم","فهو فيها من أكره الملفوظ",20,"ظ",1,0],["لفظٌ وفضلٌ كلاهما ذهبٌ","فكل أوقاته لنا كرم",21,"م",1,0],["لفظك فينا مطرب كله","لم يبق للسامع معقولا",22,"ل",2,0],["لفضيحةٍ أبداً يُحَلُّ إزارُهُ","وعلى الحُلاق مع البِغاء يُلاثُ",23,"ث",1,0],["لَفَوْتُ ما أمَّلته النفسُ أرفقُ بي","من حَيْرَةٍ بين تقريب وتبعيدِ",24,"د",1,0],["لفتحِ أستاهٍ كأمثالِ البركْ","لولا المداراةُ لما فيها انسفكْ",25,"ك",1,0],["لِفُراقِ الفَتى الأَديبِ الأَلمَع","وَذَرَفنا دَمعاً سَخيناً سَخِيّا",26,"ي",2,0],["لَفظٌ أَرَقُّ مِنَ النَسيمِ إِذا سَرى","سَحَراً وَحُلوٌ كَالكَرى إِن هَوَّما",27,"م",2,0],["لِفراشَةٍ تَحي لَهُ وَلِنَحلَةٍ","تَحيا بِهِ وَلِشاعِرٍ مِثلي",28,"ي",1,0],["لفظ جميل فيه معنى رائع","هو في المعاني وحده العذراء",29,"ا",2,0],["لفظوا ما منحتهم من حقوق","نشدتها الاجيال لفظ النواة",30,"ه",1,0],["لفت الزمانَ جلاله","بين التخطر والسفور",31,"ر",1,0],["لفظ الحياة نُفاثة فنفاثة","مثل الزجاجة قد قلبتَ فدامها",32,"م",3,0],["لفظ ومعنى هو فاعمد إلى","لفظٍ شريف أو لمعنى نبيل",33,"ل",1,0],["لَفّوكَ في عَلَمِ البِلادِ مُنَكَّساً","جَزِعَ الهِلالُ عَلى فَتى الفِتيانِ",34,"ن",1,0],["لُفَّ في طَيلَسانِهِ طُرَرَ الأَر","ضِ فَطابَ الأَديمُ مِن طَيلَسانِه",35,"ن",2,0],["لِفِتيَةٍ لا تَنالُ الأَرضُ أَدمُعَهُم","وَلا مَفارِقَهُم إِلّا مُصَلّينا",36,"ن",2,0],["لفقدِ أخٍ كفقدِ البدرِ لمَّا","تكاملَ واستوى بين النُّجومِ",37,"م",1,0],["لفظٌ كما كبَّ النسيمُ رياضَهُ","سَحَراً لمضطرمِ الصرائرِ قاصعُ",38,"ع",1,0],["لُفَّتْ على حيِّهم عجاجَتُنا","والشمسُ غَضٌّ شعاعِها رَطْبُ",39,"ب",1,0],["لَفتَى سُؤدُدٍ لَهُ نَفَحاتٌ","يَعتَفيها المَحروبُ وَالمَكروبُ",40,"ب",1,0],["لَفا عَتادٍ مِمّا يَراهُ لَنا","نُنفِقُهُ تارَةً وَنَدَّخِرُه",41,"ر",2,0],["لِفُرقَةِ مَن خَلَّفتُ دُنيايَ غَضَّةً","لَدَيهِ وَعِزّي مُعصَماً في يَفاعِهِ",42,"ع",2,0],["لَفَضَّ الَّذي أَعطى النُبُوَّةَ كَيدَهُم","بِأَكيَدَ مِمّا كايَدوهُ وَأَقدَروا",43,"ر",3,0],["لَفَلجٌ وَصَحراواهُ لَو سِرتُ فيهِما","أَحَبُّ إِلَينا مِن دُجَيلٍ وَأَفضَلُ",44,"ل",1,1],["لَفازَ لَكُم سَهماً لَئيمٍ عَلَيهِمُ","وَلَو كانَتِ العَجلانُ فيهِم وَجُرهُمُ",45,"م",1,0],["لفظٌ يُريك بديعُه حَلْيَ الدُّمَى","طَلقاً ونُوَّارَ الرُّبَا مُتبسِّما",46,"م",2,0],["لَفْظٌ تَراه عَقارِباً مبثوثةً","ويَراهُ غيرُكَ جَوهَرَ الأَسفاطِ",47,"ط",1,0],["لَفَقْدُ النَّدى الرِّبعيِّ أوجَدَني الأَسى","وأفقَدَني عَيشي ولينَ مِهادي",48,"د",2,0],["لَفْظٌ صقَلْتُ متونَه فكأنَّه","في مُشرقاتِ النَّظْمِ دُرُّ سِخابِ",49,"ب",1,0],["لَفظٌ يروحُ له الرَّيحانُ مُطَّرِحاً","إذا جعلناه رَيحاناً على النُّخَبِ",50,"ب",1,0],["لِفَوزِ العُقولِ","بِحَلِّ العُقودِ",51,"د",1,0],["لِفَرطِ البُكا قَد صارَ جِلداً وَأَعظُما","فَلا عَجَبٌ إِن يَمزُجَ الدَمعَ بِالدِما",52,"م",2,0],["لفتةَ الحسرةِ للشط القريب","قبل أن تسقط خلف النهر",53,"ر",1,0],["لفظة لا تبين تنطلق الأقدار عن قوسها ويرمي الفضاء","وهي بين الشفاه ناي وتغريد وطير وروضة غناء",54,"ا",2,0],["لَفْظَتُهُ زَلّةٌ تُلاقي","مِنْ لفظَتي في الخطابِ عَفوا",55,"و",2,0],["لَفَحَت سَمومُ المَشرَفِيَّةِ وَسطَهُ","وَهَجاً وَكُنَّ سَوابِغَ الأَظلالِ",56,"ل",1,0],["لُفُظٌ لِأَخلاقِ التِجارِ وَإِنَّهُم","لَغَداً بِما اِدَّخَروا لَهُ لَتِجارُ",57,"ر",1,0],["لفاتنتي خيل عتاقٌ سوابقٌ","إناثٌ أطابَتْ حملَها وفحولُ",58,"ل",1,1],["لفُّ الحريرِ ونشرُه لكِ حرفةٌ","فلفَفْتُ ثمَّ نشرتُ فيكِ نظامي",59,"ي",1,1],["لفلانِ الدين بَغْلٌ","فاضَ منهُ الريحُ فيضاً",60,"ض",2,1],["لَفّاءُ حاكَ لَها الغَمامُ مُلاءَةً","لَبِسَت بِها حُسناً قَميصَ صَباحِ",61,"ح",1,0],["لَفنزيلوسُ إن صدقوا فتاها","ومولى حقِّها في الطَّالبينا",62,"ن",2,0],["لَفظَةٌ لا تَرى لَها","في الأَنامِ مُسَمَّيَين",63,"ن",1,0],["لِفَرَنسا أَن تستبد وَتَطغى","لِفَرَنسا التَنكيل بِالبُلدان",64,"ن",1,0],["لِفَرَنسا أَن تحشد الجَيش كَالسَي","ل وَتُبدي عَجائب الطَيران",64,"ن",1,0],["لِفَرَنسا ما تَشتَهي لِفَرَنسا","ما تَمنَى فَمَوعد الثَأر دان",64,"ن",1,0],["لَفّ الجِداءَ بأيديها وأرجُلِهَا","كأنّما افتَرَسَتْهُنّ السّراحين",65,"ن",1,0],["لِفِتيَةٍ قَد بَكَّروا بِأَكلُبِ","قَد أَدَّبوها أَحسَنَ التَأَدُّبِ",66,"ب",1,0],["لِفُرقةِ البدرِ يوم ولى","فوق جُماليّةٍ عتاق",67,"ق",1,0],["لِفارِغٍ مِمّا بِهِ شِغلُهُ","لَم يَشجَ بِالحُبِّ وَلَم يَشهَدِ",68,"د",1,0],["لِفِزرٍ صَنيعُ القَلطَبانِ بِأُختِهِ","فَلَيسَ بِمَأمونٍ بِظَهرِ مَغيبِ",69,"ب",1,0],["لَفَداها مِنَ الرَدى","هارِبي بَعدَ قارِبي",70,"ب",2,0],["لِفَقدِيَ ناظِري وَلُزومِ بَيتي","وَكَونِ النَفسِ في الجَسَدِ الخَبيثِ",71,"ث",1,0],["لَفظٌ يُبَدَّدُ مِن شَرخٍ وَمُكتَهِلٍ","وَالمالُ يُجَمَعُ لَم يَدرُكُهُ تَبديدُ",72,"د",1,0],["لَفظَةٌ قُلتُها وَإِن هِيَ هانَت","جاوَزَت في الأَنامِ حُسوَةَ خَمرِ",73,"ر",1,0],["لَفَكُّ الريحِ عَن أَمرٍ عَجيبٍ","يُخَبَّرُ أَنَّ أَهلَ الأَرضِ لُفكُ",74,"ك",1,0],["لِفِتنَةٍ لا تَزالُ باعِثَةً","رامِحَها في الوَغى وَنابِلَها",75,"ل",3,0],["لِفَعالِكَ المَذمومُ ريحُ حَوابِسٍ","وَلِفِعلِكَ المَحمودِ رَيّا تَفَغَمُ",76,"م",1,1],["لَفْظٌ كأنّ مَعاني السكْرِ يَسْكُنُه","فمَن تحفَّظَ بَيْتاً منْه لم يُفِقِ",77,"ق",1,0],["لِفَقدِ فَضالَةَ لا تَستَوي ال","فُقودُ وَلا خَلَّةُ الذاهِبِ",78,"ب",1,0],["لِفَقْدِ من قتَّلَ مِن رِجالِها","وذُّلِّ من أَيْتَمَ من أطفالها",79,"ه",2,0],["لَفَّ الْغَمَامُ أَقَاصِيها بِبُرْدَتِهِ","وَانْهَلَّ فِي حجْرَتَيْهَا وَابِلٌ سَبِطُ",80,"ط",1,0],["لِفِيلِيب الَّذِي آثَرْتِ نَجْمٌ","كَنَجْمِكِ فِي سَمَاءِ السَّعْدِ عَالِ",81,"ل",1,0],["لَفْظٌ نَفَسْتَ بلَحْنِهِ","لحْنَ الشَّوَادِي فِي الأَرَاكْ",82,"ك",1,0],["لِفَخَارِهَ تَأْسى كَ","أنَّ فَخَارُهُ مِنْهَا سَلِيبُ",83,"ب",1,0],["لِفُؤَادِ سُلْطَانٍ بِطَارِفِ مَجْدِهِ","إِنْ لَمْ يَكُنْ بِالعَمِّ أَوْ بِالخَالِ",84,"ل",1,0],["لِفَقْدِ النّبيِّ إِمَامِ الهُدَى","وَفَقْدِ المَلاَئِكَةِ المُنزَلِينا",85,"ن",2,0],["لَفَحَتْ رِيحُهُ أزاهيرَ آما","لٍ ملأْنَ الوُجودَ مِسْكاً ونَدّا",86,"د",2,0],["لفظُه في يديه يختار منه","صَحْفةُ الدرِّ في يَدَيْ دِهْقَان",87,"ن",1,0],["لفظ ابْن ظافر قد ظَفرت بِهِ","وفؤاد حبي مِنْهُ غير خلي",88,"ي",1,1],["لفوه في العلم المصريِّ تكرِمةً","أفديه من علم قد لفَّ في علم!",89,"م",1,0],["لفظًا من الفصحى، وآخرَ نابيًا","كالقار ممزوجًا بكأس مُدام",90,"م",1,0],["لفَّفَتْه عصبةٌ ما وردت","بحرَه؛ بل وردت مُسْتنْقَعه",91,"ع",2,0],["لفظ الروح فاطمأنّت ضلوعه","وانطفى شوقه ونام ولوعه",92,"ع",2,1],["لفتة ! يا نجوم إني أنادي:","من رآني ، أو من تجلّى المنادى؟",93,"د",2,1],["لفقد صيامك يبكي النهار","ويبكي لفقد القيام السحر",94,"ر",1,0],["لفُّوْهُ في شَطَن الردى ومضى فلم","يحللْ لغير الله عقد قَبائه",95,"ا",3,0],["لفقدك أبكي باطن الأرض ظهرها","فعادت سواءً دوره ومقابره",96,"ر",2,0],["لفقدك ح