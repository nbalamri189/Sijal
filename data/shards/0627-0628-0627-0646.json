d=93516",""],[4578,"لعارضي الشيب من هول النوى وخطا","https://www.poetsgate.com/ViewPoem.aspx?id=49461",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[4578,"بغرةٍ تنقضى في حبها حججي","https://www.poetsgate.com/ViewPoem.aspx?id=49370",""],[4857,"جيش محمد","https://www.poetsgate.com/ViewPoem.aspx?id=37073",""],[3859,"أبَانَ وَجهاً لاَحَ كَالقَمَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=124006",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6142,"القسط والعدل هزا يوم بيعته","https://www.poetsgate.com/ViewPoem.aspx?id=155720",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""]],"verses":[["أَبا نِزارٍ تُفسِدُ القَومَ النِعَم","غَفَّلَكَ الوَجدُ وَزَكّاني العَدَم",0,"م",1,1],["أَبانا فَلا رِمتَ مِن عِندِنا","فَإِنّا بِخَيرٍ إِذا لَم تَرِم",1,"م",1,0],["أَبا نُصَيرٍ تَحَلحَل عَن مَجالِسِنا","فَاِنَّ فيكَ لِمَن جاراكَ مُنتَقَصا",2,"ص",2,1],["أَبانَ السَبقَ إِن لَم يَرفَعوها","عَلى المَرفوعِ ميلاً ثُمَّ ميلا",3,"ل",2,0],["أَبانَ الحَيُّ يَومَ لِوى حُيَيٍّ","نَعَم بانوا وَلَم يُشفَ الغَليلُ",4,"ل",1,0],["أَبانَ لِراكِبِها المَخصِرُ","لِعاشِرَةٍ وَهوَ قَد خافَها",5,"ه",2,0],["أَبانَ وَلَم يَنبِس وَأَدّى وَلَم يَفُه","وَأَدمى وَما داوى وَأَوهى وَما رَمّا",6,"م",2,0],["أبانَتْ مِنْهُ ما طَابَا","ومِنِّيْ ما بَرَى الحُبُّ",7,"ب",1,0],["أَبا نَهشَلٍ لِأَبي غانِمٍ","خَلائِقُ يوحِشنَ مِن جانِبِه",8,"ب",2,1],["أَبا نَهشَلٍ لِلحادِثِ النُكرِ إِن عَرا","وَلِلدَهرِ ذي الخَطبِ المُبَرِّحِ وَالصَرفِ",9,"ف",1,0],["أَبا نَهشَلٍ رَأيُكَ المُقنِعُ","إِذا طَرَقَ الحادِثُ الأَشنَعُ",10,"ع",1,1],["أَبَأنا بِهِم قَتلى وَما في دِمائِهِم","وَفاءٌ وَهُنَّ الشافِياتُ الحَوائِمِ",11,"م",1,0],["أَبانَ لَنا عَن بَيْنِنا فَلِسانُهُ","علينا له قَطْعٌ أُتيحَ له القطعُ",12,"ع",1,0],["أَبٌ أَنتَ أَعلى مِنهُ في الفَضلِ وَالعُلى","وَأَمضى يَداً وَالنارُ والِدُها زَندُ",13,"د",1,0],["أَبانَ لِملنرَ مَعنى الشَبابِ","لِشَعبٍ يَراهُ صَريعَ الكِبَرْ",14,"ر",1,0],["أبانَ مَوْلِدُهُ عَنْ طِيبِ عُنْصُرِِ","يا طِيبَ مُبْتَدَإٍ منه ومُخْتَتَمِ",15,"م",1,0],["أَبانَ ثَلاثاً يَومَ أَوفى بِرَأسِهِ","فَقولا لَهُ أَسوَيتَ يا سَوأَةَ الَبَلَد",16,"د",1,0],["أَبانوا عَن قَبائِحَ مُنكَراتٍ","فَدَع ما لا يُبينُ مِنَ الأُمورِ",17,"ر",1,0],["أَبَانُوا أَخاهُمْ إذْ أَرَادُوا زِيَالهُ","بِأَسْوَاطِ قِدٍّ عَاقِدِينَ النَّوَاصِيَا",18,"ي",2,0],["أَبَانُوهُ عَنِّي فَابْتَلُوهُ بِقَاتِلٍ","مِنَ الدَّاءِ وَالدَّاءُ الَّذِي بِيَ أَقْتَلُ",19,"ل",1,0],["أَبَانَ لِجُهَّالِهَا فَضْلَهَا","وَأَبْدَى فَرَائِدَهَا الخُرَّدَا",20,"د",2,0],["أَبَانَ المُحِبِّينَ وَالآلَ عَنْكَ","وَأَقْصَى المَوَالِي وَالعَسْكَرَا",21,"ر",2,0],["أبانَ لكَ الطرْقَ اللَّواجب للعُلا","فجلّيت فعلَ الفارسِ البطلِ القرمِ",22,"م",1,0],["أبان ثلاثاً يوم أوفى برأسه","فقُلْتُ لهُ أَسْويْتَ يا سوْءة البَلَد",23,"د",1,0],["أبانَ مولِدُهُ عن طِيبِ عنصُرِهِ","يا طِيبَ مُبتَدَاٍ منه ومُختَتَمِ",24,"م",1,0],["أبان لنا وجهَ الحقيقةِ بعد ما","أقام الورى ستراً وحاجبا",25,"ب",2,0],["أبا نصيرٍ تحللْ عنْ مجالسنا","فإنَّ فيكَ لمنْ جاراكَ منتقصَا",26,"ص",2,1],["أبانتْ منه ما طابَ","ومنّي ما يرى الحبّ",27,"ب",1,0],["أبانت يداً في جانبيه الصناعا","وما أنْسَ لا أنْسَ المياهَ بدَجلة",28,"ه",1,0],["أبَانَ اصطِبَارِي بَينُ أُمِّ أبَانِ","وأحمَشَ إيقَادَ الجَوَى بِلَبَاني",29,"ن",2,1],["أبان عن كل ما يعنو الطبيب له","وحار في فهمهِ أهل الدرايات",30,"ت",1,0],["أَبانِيَ بِالسَيفِ أَعلَيتَها","وَلَولاكَ ما قامَ مِنها حَجَر",31,"ر",1,0],["أَبانَ لَنا عَن هِمَّةٍ عَضُدِيَّةٍ","كَفى حَدُّها بيضَ الظُبى أَن تُسَلَّلا",32,"ل",2,0],["أَبانَ الهُدى فالحَقُّ أَبلَجُ واضِحٌ","وَصانَ الوَرى فالعَيشُ حُلوٌ مُهَنّأُ",33,"ن",2,0],["إِبّانَ أَيُّ عَزيمَةٍ لَم تَنتَقِض","فيهِ وَأَيُّ فَريصَةٍ لَم تُرعَدِ",34,"د",1,0],["أَبا ناصِرٍ لا يستفزنَّكَ الأَسى","عَلى حادِثٍ يُشكى إليه فَلا يُشكي",35,"ك",2,0],["أَبان بها عما يجمجمُ شاعرٌ","ترفَّعَ عن مدحٍ ولم يك هاجيا",36,"ي",2,0],["أبان كتاب الله فيما ابان عن","مسالك فقه واعتبار وعبرة",37,"ه",1,0],["أَبانَ هلالهُ طلقَ المحيّا","مُديلاً سعده من كلّ نحسِ",38,"س",1,0],["أَبان فضلكَ فينا فقدهُ وكذا","كَ النفسُ زاهدةٌ في كلّ ميسورِ",39,"ر",1,0],["أَبانَ لَنا تَخصيصه عَن مُهذّبٍ","تَباهَت بهِ الأيّام واِنشَرحَت صدرا",40,"ر",2,0],["أَبانَت حَصِيداً عَن يَمينٍ وَياسَرَت","وَسارَت وَفيها عَنِ رُماحٍ تَزاوُرُ",41,"ر",1,0],["أبانا ذهب العمر","وأشقتنا المواعيد",42,"د",1,0],["أَبَأنا بِقَتلانا مِنَ القَومِ مِثلَهُم","وَما لا يُعَدُّ مِن أَسيرٍ مُكَلَّبِ",43,"ب",1,0],["أبا نَصرٍ فَتى المَجدِ الَّذي لا","يحلُّ مكانَه إلا فَتاهُ",44,"ا",2,0],["أبا نَصرٍ ادرِك بنصرٍ فقَد","أتَت بالحَوادثِ أزمانُها",45,"ن",3,0],["إبان بوم الطامه","ياالله بحسن الخاتمه",46,"ه",1,0],["أبان به تصويب جدي لقتلهم","وتخريبه في أرضهم كل مسجد",47,"د",1,0],["أبانوا لكم وجه الحقائق كلها","فأعرضتم أعراض من ليس يهتدي",47,"د",2,0],["أبا نصرٍ نُصِرْتَ على الأعادي","وصِرْتَ لكُلِّ ذي فَضلٍ إماما",48,"م",2,1],["أَبانَ لَنا من درِّهِ يَومَ وَدَّعا","عُقوداً وَأَلفاظاً وَثغراً وَأَدمُعا",49,"ع",2,1],["أبانَ سبيلَ النُّجْحِ ساطِعُ نورِهِ","ولاحَتْ لعلياء النواظر نارُهُ",50,"ر",2,0],["أبانت له مصر عن موردٍ","بها طائر الصيت معطارهِ",51,"ر",2,0],["أبانَ لي عن حسن زهر ناضر","يهدي لنا في الصبح عَرْفاً ضائعاً",52,"ع",2,0],["أبانَ في ملعبِ الأطواقِ عن جَيَدٍ","لم يُحْصَ فيهنَّ بالتهييفِ غَرثانُ",53,"ن",1,0],["أبانَ بها ما عنده لك إنما","تُحلَّى لإكرام السيوف المَغامدُ",54,"د",1,0],["أبان لنا اللّهُ نَهْجَ السبيلِ","ببعثته وأرانا الغيوبا",55,"ب",2,0],["أبانُهمُ تلفيقُ جهلٍ يَرُبُّهم","وأخملني تحقيقُ فضلٍ أرُبُّهُ",56,"ب",2,0],["إبان مُثْري الحي مثلُ فقيرهِ","لِترادُفِ اللَّزَباتِ والَّلأواءِ",57,"ا",2,0],["أبانَ بهاءُ دين اللّهِ عنهُ","فأوصلَهُ إِلى فَهْمِ البَليدِ",58,"د",1,0],["أبانَ نِفاقَ الحيِّ بعد انْتصارهِ","فلم تُلْفِ منهم صادقاً بمكانِ",59,"ن",1,0],["أبانت لعيني في الصباح فأعدمت","دياجي السوى عند الفناء بها صرفا",60,"ف",2,0],["أبا نصر نقصتك صاع قولي","بصاعِ الفعل من نعماك واف",61,"ف",1,0],["أبانت عن مساوىء منشئها","وأغنت بالسماع عن العيانِ",62,"ن",1,0],["أَبانُوا يَوْمَ بانُوا عَنْ فُؤادي","عُرَى صَبْري فَبَاتُوا بالعَرَاءِ",63,"ا",2,0],["أبانت عن الغيب المقدس للذي","تعلقه باللام فيها وبالباء",64,"ا",2,0],["أبانَ تأريخَها عامٌ تقولُ بهِ","مُباركاً لم تزَلْ يا بيتَ داوُدِ",65,"د",1,0],["أبانت صفاءَ السِّرِّ منهُ وأكدَّت","صحيحَ وِدادٍ باطنٍ فيهِ ظاهرِ",66,"ر",1,0],["أبانَتْ عن مَوَدَّتهِ صريحاً","وعمَّا فيهِ من كَرَم السَّجايا",67,"ا",3,0],["أَبانَ رُشْدِيَ سِحْرُ أَلحاظه","يا صِدْقَ من سمَّاه سِحْراً مُبين",68,"ن",1,0],["أَبانوا برفْع الفاضلِ النَّدب فَضْلَهُم","وأَعْلَوا لَهُ قَدْراً فَصارَ لهم قدْرُ",69,"ر",1,0],["أبانَ لهم نهجاً من الدين واضحاً","وأَعرب فيه عن وجوبٍ وعن ندبِ",70,"ب",1,0],["أبان الخفايا شارحاً ببيانه","منزهة في الوصف عن سحر بابل",71,"ل",1,0],["أبان بالرأي والتدبير سؤدده","بأن كل وزير غيره زور",72,"ر",1,0],["أبا نصر القرم الذي عقمت بمن","يشاكله في مجده كلّ والده",73,"د",2,0],["أبان للعصاة ببدر مصارعا","فما لبثوا أن جاوزوها ودمدموا",74,"م",3,0],["أبان عما يأت أو ما مضى","وبين الحل لنا والحرام",75,"م",1,0],["أبَانَ بَيَاضًا عَلَى حُمْرَةٍ","بِخَدّيْهِ سَعْدُهُمَا طَالِعُ",76,"ع",1,0],["أبان ببدر للعصاة مصارعا","فما لبثوا أن جاوزوها ودمدموا",77,"م",3,0],["أبَانَ عَنْ وَصْفش مَعْنَاهَا البَدِيعُ إذَا","قَدْ طَابَقَتْ بَيْنَ إعْرَابٍ وَتَلْحِينِ",78,"ن",1,0],["أبانَ لنَا فِي يَسير المَدَى","مِنَ الصُّنع في كلِّ خَطْب عُجاب",79,"ب",1,0],["أَبانَ لافقِ السَعدِ كَوكَبُ وَجهِهِ","مَعاً وَهُوَ يَجلي لَيلَهُ وَنَهارَهُ",80,"ر",2,0],["أَبَانُ يا ابْنَ الأَطْوَلِينَ قِيسا","فِي المَجْدِ حَتَّى تَبْلُغَ النَفِيسا",81,"س",2,0],["أَبانَ غدرَكُمُ هَجْري وما عُرِفَتْ","عصابةُ البغيِ لولا قَتْلُ عمَّارِ",82,"ر",1,0],["أَبانَ نَقْصَ الجميعِ عَنْهُ","لمَّا غَدَا في الكَمالِ مُفْرَدْ",83,"د",1,0],["أبانت عن المعنى بضرب من المثل","فما كاد منها القلب يفهم ما عقل",84,"ل",1,1],["أَبِأَنفاس جِلِّقٍ مَزَجُوهُ","فأتى بالعبير يزخر زخرا",85