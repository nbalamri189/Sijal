{"poems":[[95,"حييت يا ذات المقام السامي","https://www.aldiwan.net/poem11379.html","الكامل"],[91,"ورد يطيح وبلبل اسوان","https://www.aldiwan.net/poem44907.html","الكامل"],[87,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[78,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[102,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[102,"صياد البروق","https://www.poetsgate.com/ViewPoem.aspx?id=50408",""],[102,"لص في منزل شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50430",""],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[244,"في ليلة صبغ الظلام أديمها","https://www.aldiwan.net/poem23837.html","الكامل"],[325,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[373,"ماذا وقوفي على ربع عفا","https://www.aldiwan.net/poem1878.html","مجزوء البسيط"],[415,"قل للذي فقد الأحبة وانثنى","https://www.aldiwan.net/poem31649.html","عموديه"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96979","الكامل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132473","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77535","الرجز"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138071",""],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47153","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112592","الكامل"],[4908,"في حَضْرَةِ النيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=207378",""],[5032,"ماذا وراءالشمس","https://www.poetsgate.com/ViewPoem.aspx?id=191237",""],[5033,"ما لا يُقال","https://www.poetsgate.com/ViewPoem.aspx?id=183225",""],[5152,"لِمَ تَضيق؟","https://www.poetsgate.com/ViewPoem.aspx?id=208827",""],[5277,"الحافية","https://www.poetsgate.com/ViewPoem.aspx?id=206888",""],[5431,"شهوة الموت...","https://www.poetsgate.com/ViewPoem.aspx?id=204950",""],[5436,"ياساهر الليل / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=178429",""],[5444,"رُّمانُ.. وأيلولُ أسود","https://www.poetsgate.com/ViewPoem.aspx?id=205085",""],[5500,"سكون ظل","https://www.poetsgate.com/ViewPoem.aspx?id=188515",""],[5736,"لن أعود","https://www.poetsgate.com/ViewPoem.aspx?id=203912",""],[5736,"السم في العسل","https://www.poetsgate.com/ViewPoem.aspx?id=211832",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[6120,"الْمَاءُ وَالنِّيرَانُ تَتَّفِقُ!","https://www.poetsgate.com/ViewPoem.aspx?id=215805",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""]],"verses":[["مَاذَا وَجَدْتُ مِنَ الثَّنَاءِ عَلَيْكِ فِي","أَثْنَاءِ كُلِّ تَرَحُّلٍ وَمُقَامِ",0,"م",1,0],["ماذا وقوفك بالدوارس بعدما","سارت بمن تهواهم الاضعان",1,"ن",1,0],["ماذا وَراءَ المَوتِ مِن سَلوى وَمِن","دَعَةٍ وَمِن كَرَمٍ وَمِن إِغضاءِ",2,"ا",2,0],["ماذا وُقوفي على رسمٍ عَفا","مُخلَوْلقٍ دارِسٍ مُسْتعجمِ",3,"م",1,0],["ماذا وراءَ الدمعِ من أمنيةٍ","أوْ ما وراءَ النّوحِ من نشدانِ",4,"ن",1,0],["ماذا وراء الثوب ؟ فجر راسب","يهوى ويستحي وفجر طاف",5,"ف",1,0],["ماذا ؟ وأين أنا ؟ وأصعد","من قرارات التردّي",6,"د",2,0],["ماذا وجدت سوى الفراغ","وهرّة تَشْتَمُّ فارة",7,"ر",2,0],["ماذا وراءَ الضغطِ إذ","يشتَدُّ غيرُ الإنفجارِ",8,"ر",1,0],["ماذا وراءك قال باسم الله قم","لله فيما قد قضاه مراد",9,"د",1,0],["ماذا وَإِلّا لِلكَلامِ بَقِيَّةٌ","وَسَيقَلِبُ المَوضوعَ قَلباً ثاني",10,"ن",2,0],["مَاذا وقُوفِي عَلَى رَبْعٍ عَفَا","مُخْلَوْلَقٍ دارِسٍ مُسْتَعجَمِ",11,"م",1,1],["ماذا وقوفك في الديار مسائلا","عن أهلها ومتى يجيب الأبكم",12,"م",1,0],["ماذا وإن طيَّبَ ري","ياكِ قديما عَصرَنا",13,"ن",2,0],["ماذا وقوفك في ملاعب خرد","جد العفاء بربعها المسكون",14,"ن",1,0],["ماذا وقوفي على رسم خلا","مخلولق دارسٍ مستعجم",15,"م",1,1],["ماذا وَإِلا اِقتَصَروا في الدور","وَاخشوا قِتالَ الضَيغم المَشهور",16,"ر",1,0],["ماذا وراء السهد ماذا أرتجى","هلا قنعت بنومة المبطان",17,"ن",1,0],["ماذا وكم أوليتَني يا مُخبِري","بقدومه من منّةٍ ونَوَالِ",18,"ل",1,0],["ماذا وراء العمر إذ أحيا به","هملا بغير قضيّة وقياس",19,"س",1,0],["ماذا وكيف يقولُ الشِّعر عن بلد؟","يستوطنُ الصدقُ والأخلاقُ والأثرُ",20,"ر",1,0],["ماذا وَراءَ الشّمُسِ هل تَدْرينا؟","فِئةٌ مِنْ الشّعراءِ يَحْتَرِقُونا!",21,"ن",2,1],["ماذا وقد نسيَتْ بدايةُ قصّتي","من أيِّ جرحٍ أشْتكي وأُعاني",22,"ن",2,0],["ماذا ؟ وهلْ تجري الجداولُ عندما","فجري يُهَلِلُ ، والفضاءُ طليقُ ؟",23,"ق",1,0],["ماذا؟ وهل ماذا لديكِ وسيلةٌ","أم أنّها أعذارُ شكّ ضافيهْ",24,"ف",3,0],["ماذا (...)وكيف(...)؟ ومالربحُ الذي انتفعت ؟","منه الزهور : إذا قطرُ الندى ملحُ !!!",25,"ح",1,0],["ماذا وقد كشّف الاغراب عورتهم","مثل القرود اتوا لم يغضضوا البصرا",26,"ر",2,0],["ماذا- وناصرُ في متاهةِ عودةٍ-","كتبَت يداك، فسطر الأشجانا",27,"ن",2,0],["ماذا وقوفك في قفل المدى حرضا","وقد بليت وما كفت أساياه؟",28,"ا",2,0],["ماذا وكيف وهل أتتك رسائلي؟","خيبات سؤلي حلّقت أسرابا",29,"ب",2,0],["ماذا وقد كُويَتْ بالنار حافيةٌ","على جسورِ الهوى تمضي بلا كللِ",30,"ل",1,0],["ماذا وماذا إذا هذا الأذى وإذا","آذى إذن أنتَ غِرٌّ ثُم ذو غِرَرِ",31,"ر",1,0],["ماَذا؟ وأينَ الذي أدري سَيخْلُفني؟","قالوا :بِتَمّوزّ قَدْ هدَّتهُ قَشّاتُ",32,"ت",1,0],["ماذا ، وأشناب الرجال تهزها","ريح بشبه جزيرة الرعيان",33,"ن",1,1],["مَا ذَا؟ وَقَالَتْ: هَذِهِ حُرَقٌ!","فِي صَدرِهَا كَالعِقدِ مُتَّسِقُ",34,"ق",1,1],["ماذا وقد هُدِرَت كرامةُ أُمَّةٌ","بالأمسِ كانت دُرَّةَ التِّيجانِ",35,"ن",1,0]]}