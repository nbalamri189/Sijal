ل صوتكَ","https://www.poetsgate.com/ViewPoem.aspx?id=211773",""],[5720,"الْرَوْنَةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199382",""],[5720,"ودَّعتُ طيبةَ","https://www.poetsgate.com/ViewPoem.aspx?id=208938",""],[5736,"شتاء","https://www.poetsgate.com/ViewPoem.aspx?id=203870",""],[5790,"بين القلوب وبين الأعين النجل","https://www.poetsgate.com/ViewPoem.aspx?id=112117",""],[5952,"وجْهُ فَلا","https://www.poetsgate.com/ViewPoem.aspx?id=214017",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6084,"عز الهدى والندى والعلم والعلما","https://www.poetsgate.com/ViewPoem.aspx?id=170871",""],[6108,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=192389",""],[6152,"سيعود الأنس والفرح","https://www.poetsgate.com/ViewPoem.aspx?id=213187",""],[5567,"كشف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81764&r=&rc=32",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""],[5567,"حلول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69071&r=&rc=9",""]],"verses":[["في الرَوابي مِن مَعَدٍّ وَالذُرى","نُهِزَ المَجدُ بِعاديِّ السِجالِ",0,"ل",1,0],["فِي الرِّزْقِ مَاءٌ لإِرْوَاءٍ وَتَغْدِيَةٍ","وَفِيهِ مَاءٌ لأَنْوَارٍ وَنَيدَانِ",1,"ن",1,0],["في الرافدين على أيار مَوجدة","تذكو بعَبريهما من حرّها النار",2,"ر",1,0],["في الرِّيق سكرٌ وفي الأصداغِ تجعيد","هذي المدام وهاتيكَ العناقيد",3,"د",1,1],["فيا لرقيبٍ ليس يرزق نظرة","وآخر يأتي رزقه وهو نائم",4,"م",1,0],["في الرأس واللحيةِ منه شُهْبةٌ","زَرقاءُ والوجه لطرموس النَّبط",5,"ط",1,0],["في الرُبى تَخلَعُ الجَما","لَ بُرودا وَتَرتَدي",6,"د",2,0],["في الرُبى فَوقَ الرُبى تَحتَ الرُبى","في الفَضاءِ الرُحبِ في الرَوضِ الأَنيق",7,"ق",1,0],["في الروض للأحزان أصبح مشهدا","ما كان قبلا منه للأفراح",8,"ح",1,0],["في الروض ازهار الربيع بناته","اما البنات فانهن حسان",9,"ن",1,0],["في الرَأيِ ثُمَّ أَهابَ بي","وَبِكَ المُنادِمُ وَالسَمير",10,"ر",1,0],["في الرَأيِ تَضطَغِنُ العُقو","لُ وَلَيسَ تَضطَغِنُ الصُدور",10,"ر",1,0],["في الرَهَجِ الساطِعِ مِن تَنويرِها","حَطّى إِذا أَصغَت إِلى مُديرِها",11,"ر",3,0],["في الريح أنّ أنينه وهفا","في الغصن نفّس حر أحشاء",12,"ا",2,0],["في الرَوضِ قُرّاصٌ وَفي سَيلِ الرُبا","كَدَرٌ وَفي بَعضِ الغُيوثِ صَواعِقُ",13,"ق",1,0],["في الرَوضِ مِنهُ مَحاسِنٌ وَمَشابِهٌ","في آسِهِ وَبَهارِهِ وَعَرارِهِ",14,"ر",2,0],["في الروض تحكي الأقاحي","ثغور غيد ملاحِ",15,"ح",1,1],["في الروض نَور كَثير لا عداد له","لكنما الزهرة الحَسناء تقتطف",16,"ف",1,0],["في الروض من بعد الخَريف وَبرده","ذبلت عَلى أفنانها الأزهار",17,"ر",1,0],["في الروض من بعد غارات الخريف به","لا الورد ورد ولا الريحان ريحان",18,"ن",1,0],["في الرَّوضِ تَرعَى وتَجري في طَوائفِه","يَنسِلنَ في نَقَلِ الشِّعريِّ إدبارا",19,"ر",2,0],["فِي الرَّفِيقِ الأَعْلَى وَنِعْمَ الرَّفِيقُ","فُزْتَ بِالخُلْدِ أَيهَا الصِّدِّيقُ",20,"ق",1,1],["فِي الرَّوْضَةِ الحُلْوَةِ المَجَانِي","قدْ غَرَسَ الحُبُّ خيْرَ غَرْسِ",21,"س",1,0],["فِي الرِّيَاضَاتِ لَهُمْ تَبْرِيزُهُمْ","فَإذَا اعْتَزُّوا فَلَيْسُوا أَدْعِيَاءْ",22,"ا",2,0],["في الرَّملِ أصفرَ ناعمًا","متموِّجًا في قفره",23,"ر",2,0],["في الريف فتيان تسيل جباهم","عرقًا فيصبح لُؤْلُؤًا مثقوبا",24,"ب",2,0],["في الروابي حتى يعي كل تل","ضجر الكهف واصطبار المغاره",25,"ر",2,0],["في الرّهَجِ السّاطِعِ مِنْ تَنْوِيرِها،","حَتّى إذا أصْغَتْ إلى مُدِيرِها",26,"ر",3,0],["فيا لرجال الله حقا نصرتم","وعزرتم هذا الامام المفضلا",27,"ل",2,0],["في الرمل من بيروت في","عكاء في مضض السجون",28,"ن",1,0],["في الروض أبصرت ظبياً","قد شابه الغصنُ قدَّهْ",29,"ه",1,1],["في الرَكبِ بَينَ هَوادجِ الآرامِ","قَمرٌ يسايِرُهُنَّ تَحتَ لِثامِ",30,"م",1,1],["فيا لرجالِ قومي من شموسٍ","إذا قُرِنوا بها انقشعَ الضبابُ",31,"ب",1,0],["فيالرجال الحب في ذمة الوفا","قتيل غرام في الهوى قد تذمموا",32,"م",3,0],["في الرَوعِ يَقتَحِمُ الغُبارَ بِسَيفِهِ","وَبِسَيفِهِ نارُ الفِرِندِ دِماءُ",33,"ا",2,0],["في الرُّومِ والخُرَّميّينَ الّذينَ طغَوْا","وسْطَ الممالكِ دَهْراً أيَّ طُغْيان",34,"ن",1,0],["فيا لرجالٍ من علاه تفرسوا","أغرّ عليه من نسيج العلى خال",35,"ل",1,0],["في الروعِ لا ينسى الورى إيذاءهم","لكنَّهم ينسون عند المقصف",36,"ف",1,0],["في الرائحين هوىً شُعِفتُ بهِ","شعَف العواذل فيه باللومِ",37,"م",1,0],["فيا لريّانَ غضِّ ال","معاش معْ طول ضُرِّهْ",38,"ر",2,0],["في الرقمتين غدت لبنى مشعشعة","عن ثغر بدر",39,"ر",1,0],["في الرّوحِ حتّى تُفيضَ شوقاً","والدّمْعُ من عينِها سكُوبُ",40,"ب",1,0],["في الرَّاحِ والزَّهْرِ قَدْ رَأَيْنا","مَعنىً لَدَيْهِ العُقُولُ تُدهَشُ",41,"ش",1,1],["في الرَّاحِ سرٌّ بالسُّرور يُحَصِّصُ","فَلِذا الحَبابُ إِذَا تَبدَّتْ يَرْقُصُ",42,"ص",1,1],["في الراح والريحان شغلٌ شاغل","لي عن عيافةِ بارح وسنيح",43,"ح",1,0],["في الرونق الضاحي تجلى بعد ما","لجت عواصف دونه وسيول",44,"ل",1,0],["في الرَّوضِ قَد أَزهَرت قُرنفلةٌ","حَمراءُ للقلب تجلبُ الفرَحا",45,"ح",2,1],["في الرّيحِ مِسكٌ في المَذاقِ حَلاوَة","في الفِعلِ خَمرٌ شُربُها مَن حَرّما",46,"م",2,0],["في الرَأسِ مِنهُ وَعَلى أَنفِهِ","مِن نَقَماتي ميسَمٌ لائِحُ",47,"ح",1,0],["في الرَّوْعِ ما عَادَ من ذِكْرَى لِعَنْتَرةٍ","وَاسْتَسْلَمَ اليَومَ عَالِي الرَّأْسِ لِلذَّنَبِ",48,"ب",1,0],["فيا لرزاياً أذبن الفؤاد","فكم غارةٍ في البرايا تشن",49,"ن",1,0],["في الراحِ لي راحَةٌ مِن بَعضِ ما أَجِد","فَسَقنيها سَقاكَ البارِقُ الرَعد",50,"د",1,1],["في الرَوضَةِ الغَناءِ كَم غَنّى","لَنا طَيرُ الهِزار عَلى غُصون البانِ",51,"ن",1,0],["في الرَأْسِ أَوْ مَجْمَعِ أَحْناءٍ دِقَقْ","شَاحِيَ لَحْيَي قَعْقَعَانِيِّ الصَلَقْ",52,"ق",1,0],["في الرفع والجر ومنصوب دخل","عليه أل ومنه قد نلت الأمل",53,"ل",1,0],["في الرأس والعين يرى دائماً","وهو بلا رأس ولا عين",54,"ن",1,0],["فيا لرجال الحب والكأس مفعم","هلم اشربوا هذا المغنى ترنما",55,"م",2,0],["في الرزق والحرمان عدله انحتم","بشأن لا إله إلا اللّه",56,"ه",1,0],["في الرياحين يطيبُ المجلسُ","لبني اللهوِ وتحلو الأكؤُسُ",57,"س",1,0],["في الروح والريحان فاجعل روحهُ","مأوى المقرّب والذي يستشهد",58,"د",1,0],["فيا لرزاياكم فرين مرارتي","بجوفي وصيرن البكا والجوى دأبي",59,"ب",2,0],["في الرَأسِ مِنها نَبتُ جَثلٍ فاحِمٍ","وَأَنامِلٌ في اللينِ مِنها تُعقَدُ",60,"د",1,0],["في الرومِ قد شاعَ قدماً أمرهُ وبهِ","لُقمانُ وفقَ للدرِّ الذي نثرَه",61,"ر",2,0],["في الرزايا علمتنا الصبر فاصبر","في بلاء أذاب منا الكبودا",62,"د",2,0],["في الرَكبِ بِنتُ رَسولِ اللَهِ يَصحَبُها","عُثمانُ في ثَبجِ الأَمواجِ وَالأَجَمِ",63,"م",1,0],["في الرجز الصحة والقطع ابح","للضرب منه وعروضه تصح",64,"ح",1,0],["في الروض منك مشابة من أجلها","يهفو لها طوفي وقلبي المغرم",65,"م",1,1],["في الرَمل مِن البَيداء مَهاةٌ","تَرتع في ظلّ النَخلَه",66,"ه",1,0],["في الروابي الخضرىء يبتسم الزهرُ","وينمو ومن جفوني النور",67,"ر",1,0],["في الربيع وهذا ربيعٌ","فتفضل برده يا ربيعي",68,"ع",2,0],["في الروض زنبقة يحيط بها","ورق الربيع وباسم الزهر",69,"ر",1,0],["في الرّوضَةِ الغَنّاء حَي","ثُ تضُوعُ انفاس الزّهورِ",70,"ر",1,0],["في الريف كم من عبرة","للسائرين وكم عبر",71,"ر",1,0],["فيا لرزاياكم على بعد عهدها","تقرب لي من لوعتي كل نازح",72,"ح",1,0],["في الرزايا خلق الرجال أساها","والأسى والبكاء خلق النسل",73,"ل",1,0],["في الرَدف وَالعَطف لي إِن شئت بَعدَكُم","أَلنعت وَالعَطف وَالتَوكيد وَالبَدَل",74,"ل",1,0],["فَيا لرجال يَفخرون بِأَنَّهُم","لَهُ أَخلَصوا وَاستنصروا فازدهوا نَصرا",75,"ر",2,0],["فَيا لرجال الشَرق أَيّ فَضيحة","تركتم لِمَن يَبقى وَخزي لِمَن يَحكي",76,"ك",2,0],["في الروض رمان وكُم","مثرى تغازل منك ثغرا",77,"ر",2,1],["في الروضة الغنا حياتي بما","أحيا فؤاداً مات من أوصابه",78,"ب",2,0],["في الرَوضِ في كُلِّ الجَمالِ وَإِنَّني","بِكَفّي وَعَيني مِنهُ أَجنى وَأَقطِفِ",79,"ف",1,0],["في الرَّوضِ جَرَى زُلالُ ماءٍ","عن أحْسَنِ مَنْظَرٍ يَشِفُّ",80,"ف",1,1],["فيا لرسول إن تحركه أنمل","بلندن تسمع صوته الهند أو مصر",81,"ر",1,0],["في الروح والريحان","في أبهى من الورد الندي",82,"د",2,0],["في الروضَةُ الغناءُ تَزهُو بِحَوضِها","وأقمارُها يَعلُو بها كُلُّ خِندفِي",83,"ف",2,0],["في الرأسِ ضَبابَةُ الخُمار اِمتَدَّت","لا يَكشِفُها غَيرُ شُموسِ الراحِ",84,"ح",1,0],["في الرِقَّةِ وَالسُقم وَضَعفِ الحالِ","أَربيتُ عَلى نَسائِم الآصالِ",85,"ل",1,1],["في الرَوضِ ذَكا الوَردُ وَلا كالجَمرِ","وافاكَ بِلَونَينِ نَمومَ النَشرِ",86,"ر",1,1],["فيا لرزايا لقد طبقت","غياهبها أرضها والصفيحا",87,"ح",2,0],["فيا لرحيق في ثناياه مضرماً","بقلبي حريقاً دونه حرق الجمر",88,"ر",1,0],["في الرفيع الرفيع والذروة الذروة","منه والعالي المنيف ذراكا",89,"ك",2,0],["في الرُبى أَنبَت أَيار صباها","وَمَضى يودعها سر الرَبيع",90,"ع",1,0],["في الرزايا والمزايا والعطا","وصفات لهم جازت عن الحد",91,"د",1,0],["في الرُّوحِ عِشْتِ مَلِيكَةً","وَ أّنَا المُتَيَّمُ فِي هَوَاكِ",92,"ك",1,0],["في الرمل أغنية عفتْ آثارها","وتنكرت لغريدِها الانغامُ",93,"م",1,0],["في الرحاب الشريف نيل العطايا","من نحاه له المنى والعطاء",94,"ا",2,0],["في الرافدين وفي دمشقَ وغيرها","واليوم بين الأهل في الأحساء",95,"ا",2,0],["في الروح ذاكرة لرائحة الهوى","حفظت بقايا مسكه الفوَّاحِ",96,"ح",1,0],["في الرّوح ينثر قبل يوم رحيله","عطرا تضوّع في فؤاد موحّد",97,"د",1,0],["فِي الرَّوْضِ تَزْدَانُ القُدُو","دُ اللاَّبِسَاتِ الطُّهْرَ حُسْنَا",98,"ن",2,0],["في الروح رافلة بصدق محبة","تمحو عن الأوطان وصمة عارها",99,"ر",3,0],["في الروضة الغناء نحسو خمرها","من شهدها الداني ثمارا نقطف",100,"ف",1,0],["في الرق بالرفق عن حذق بلا قلق","ولا شقاق ولا ضيق ولا نصب",101,"ب",1,0],["في الروح أنت جنون العشق مزدهرٌ","كأنه الورد ملء الكون فاض ندى",102,"د",2,0],["في الروح ظلّ مهفهفا ومقطّرا","كالمسك في أحشاء ظبيٍ دلله",103,"ل",2,0],["في الروح مني في الأوصال ملء دمي","لو أنَّت النفس في أعماقها سمعا",104,"ع",2,0],["في الرُّوحِ والخفَّاقِ ملحمةٌ","لم يُرْخِ سُدْلاً فيهما خُسْرُ",105,"ر",1,0],["فيا لرصاص المجرمين ولو رأوا","رصاصا لجاءوا حين ذلك ركعا",106,"ع",2,0],["في الروحِ آهٌ.. بها الأحشاءُ تشتعلُ","وفي رثائكَ دمعُ القلبِ ينهملُ",107,"ل",1,1],["فِي الرَّوْنَةِ الحَسْنَاءِ فِي دَارِ النَّدَىٰ","فِي دَارِ شيخٍ .. أجْزَلَ الإِغْدَاقَا",108,"ق",2,0],["في الروضةِ الغراءِ والبيت الذي","أهدىٰ لنا ديناً قويماً صافيا",109,"ي",2,0],["في الروح يعبثُ نايُ الحزنِ مبتسمًا","والريحُ حُبلى بحرفٍ للهوى تاقا",110,"ق",2,0],["في الراح ما راح من جفنيه مفتضحا","والورد ما ظل من خديه في خجل",111,"ل",1,0],["في الريح ذِكْريْ ك جُلِّ مَنْ عَبَروا","دنيايَ تسْلوهُ والزمانُ سَلا",112,"ل",2,0],["في الرجعة الكرة الزهراء نعرفه","وفي الجنان بما ذو العرش بصرنا",113,"ن",2,0],["في الرُّبَى «مُعْتَصِمٌ» رَايَاتُهُ","تَسْأَلُ الأُمَّةَ: هَلْ شِبْلٌ جَدِيدْ؟",114,"د",1,0],["فيا لرزء دهى الاسلام موقعه","ومال قسرا بركن الدين فانهدما",115,"م",2,0],["في الرشفة الأخرى خطيئةُ آدمٍ","وخروجُ يونسَ غاضبا ،و الحوتُ",116,"ت",1,0],["في الروح شوق, وفي الوجدان أمنية","أن نلتقي ويعود الأنس والفرح",117,"ح",1,1],["في الروح ذاكرة من شوقها تكِفُ","والقلب من سرِّها كالموج يرتجفُ",118,"ف",1,1],["في الريح أقرأ ما ينازعني","وأراود الأسرار إذ تعدو",119,"د",2,0],["في الرؤى صمت وفي الصمت حجابُ","والمدى لوح إذا ضاق الكتابُ",120,"ب",1,1]]}