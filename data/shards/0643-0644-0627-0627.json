{"poems":[[44,"كلا أيما الحيين ألقى فإنني","https://www.aldiwan.net/poem50291.html","الطويل"],[9,"لعمري لئن أمسى من الحي شاخصا","https://www.aldiwan.net/poem21947.html","الطويل"],[95,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[95,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[4,"عفا الرسم أم لا بعد حول تجرما","https://www.aldiwan.net/poem21202.html","الطويل"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[53,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[31,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[91,"في الغرب حيث كلا الجنسين يشتغل","https://www.aldiwan.net/poem44869.html","الطويل"],[87,"ألا بديارهم جن الكرام","https://www.aldiwan.net/poem7045.html","الوافر"],[45,"لقد أصبح الجرذ المستغير","https://www.aldiwan.net/poem9510.html","المتقارب"],[30,"أبيت أمني النفس أن سوف نلتقي","https://www.aldiwan.net/poem1234.html",""],[30,"أعض حمي ساقه السيف بعدما","https://www.aldiwan.net/poem1284.html",""],[30,"أعبد الله أنت أحق ماش","https://www.aldiwan.net/poem5162.html","الوافر"],[30,"وجدنا نهشلا فضلت فقيما","https://www.aldiwan.net/poem5409.html","الوافر"],[46,"كأني لم أبثكما دخيلي","https://www.aldiwan.net/poem30009.html","الوافر"],[107,"أبا سفيان أي دم تريد","https://www.aldiwan.net/poem43580.html","الوافر"],[107,"لأم سليم يا أبا طلحة العذر","https://www.aldiwan.net/poem44037.html","الطويل"],[107,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[54,"هل من معين على أحداث أزماني","https://www.aldiwan.net/poem26625.html","البسيط"],[50,"أعاذل ما على وجهي قتوم","https://www.aldiwan.net/poem65091.html","الوافر"],[52,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[118,"أرقت فبت لم أذق المناما","https://www.aldiwan.net/poem20956.html","الوافر"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[366,"بني الزهرا لكم مجد أثيل","https://www.aldiwan.net/poem68089.html","الوافر"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[458,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[463,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[534,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[556,"لقاؤك يا سلمى وإن كان دائما","https://www.aldiwan.net/poem47228.html","الطويل"],[558,"عاود عزاءك لا يعنف بك الذكر","https://www.aldiwan.net/poem68392.html","البسيط"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[567,"بكى حتى بكيت على بكاه","https://www.aldiwan.net/poem52917.html","الوافر"],[568,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39028","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48903","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48815","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64491","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124352",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79795","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1870,"","https://poetry.dctabudhabi.ae/diwan/poem/20045","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198877","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69406","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69435","الوافر"],[2353,"","https://poetry.dctabudhabi.ae/diwan/poem/32979","الوافر"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123450","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137213",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93813","البسيط"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9608","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201578","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200185","الوافر"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112533","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97953","الوافر"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31687","الوافر"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104296","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62870","الوافر"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61263","الكامل"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144735","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132163","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132153","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117998","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36723","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[3854,"","https://poetry.dctabudhabi.ae/diwan/poem/47370","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75681","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44915","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34761","الهزج"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139315","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120498","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[3591,"ظن الحبيب بأن الصب قد عدلا","https://www.poetsgate.com/ViewPoem.aspx?id=149380",""],[5215,"كلا السوادين من قلبِي وَمن بَصرِي","https://www.poetsgate.com/ViewPoem.aspx?id=187590",""],[5351,"المتناقض","https://www.poetsgate.com/ViewPoem.aspx?id=202233",""],[5956,"أنوي الوصول إليك","https://www.poetsgate.com/ViewPoem.aspx?id=181995",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[6164,"فتاتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""],[6164,"أيها الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66015&r=&rc=25",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["كِلا أَيّما الحَيَّين أَلقى فَإِنَّني","بِشَوقٍ إِلى الحَيِّ الَّذي أَنا ذاكِرُه",0,"ه",1,1],["كِلا أَبَوَيكُم كانَ فَرعاً دِعامَةً","وَلَكِنَّهُم زادوا وَأَصبَحتَ ناقِصا",1,"ص",2,0],["كلا اللَه وادي النيل هل","أوتي وادٍ كحسنه والجلال",2,"ل",1,0],["كلا أحيي باحتشام طائل","وأخاف تقصيراً مع الأقصار",3,"ر",1,0],["كِلا أَخَوَينا قَد تَخَيَّرَ مَحضَراً","مِنَ المُنحَنى مِن عاقِلٍ ثُمَّ خَيَّما",4,"م",2,0],["كلا الحسبين يوجب أن يُضاهَى","فساجِلني فإنك ذو سِجال",5,"ل",1,0],["كلا الأمرينِ من كرمٍ وحزمٍ","فإنك فيه ذو عمٍّ وخالِ",5,"ل",1,0],["كلا الفريقين منه ثمَّ مُعْتصم","بعُروة الأمنِ من خوفٍ وإعدامِ",6,"م",1,0],["كِلا أَبَوَيكَ مِن كَعبٍ وَعَبسٍ","بُحورٌ ما تُوازِنُها بُحورُ",7,"ر",1,0],["كلا القرينين معتز بصاحبه","عليه ان نال منه العجز يتكل",8,"ل",1,0],["كلا الجبلين حر عبقري","لدى محرابه ملك همام",9,"م",1,0],["كِلا الرَجُلَينِ اِتَّلا قَتلَهُ","فَأَيُّكُما غَلَّ حُرَّ السَلَب",10,"ب",1,0],["كِلا أَبَوَيكَ اِستَلَّ سَيفَ جَماعَةٍ","عَلى فِتيَةٍ تَلقى البَنينَ نِساؤُها",11,"ا",3,0],["كِلا السَيفِ وَالعَظمِ الَّذي ضَرَبا بِهِ","إِذا اِلتَقَيا في الساقِ أَوهاهُ صاحِبُه",12,"ب",2,0],["كِلا أَبَوَيكَ عَبدَ اللَهِ عالٍ","رَفيعٌ في المَنازِلِ بِالخِيارِ",13,"ر",1,0],["كِلا البَكرَينِ أَردَؤُها سِواءً","وَلَكِن ريمُ بَينَهُما قَليلُ",14,"ل",1,0],["كِلا أبَوَيكَ مِن يَمَنٍ وَلَكِن","كِلا أَبَوَي نَوالِكَ مِن سَلولِ",15,"ل",1,0],["كِلا الرَّجُلَيْن يا عَمروٌ عَدُوٌّ","فَدُونَكَ إنّه صَيْدٌ جَديدُ",16,"د",1,0],["كِلا أَبَوَيْكَ اسْتَنَّ سُنَّةَ مَاجِدٍ","فَطِبْتَ وطَابَا لا خَفَاءٌ ولا نُكْرُ",17,"ر",1,0],["كِلاَ أَبَوَيْهِمَا قُتِلاَ بِبَدرٍ","فَتِلكَ حفائظُ الرِّمَمِ البَوالي",18,"ل",2,0],["كَلّا أَلَيسَت تَقيني لِلزَمانِ يَدٌ","لِقاسِمٍ ذاتُ تَمكينٍ وَسُلطانِ",19,"ن",1,0],["كِلا الشَخصَينِ مُنتَصِفٌ وَلَكِن","قَضَت وَطَراً وَذا مِنها سَقيمُ",20,"م",1,0],["كِلا المَيتِ وَإِيّانا","كَما لاقى وَلاقَيتُ",21,"ت",1,0],["كلا الشقيقين معتز بصاحبه","وَفيهما القوم أَصحاب وأخدان",22,"ن",1,0],["كلا العظيمين فتى قريش","صدرُ نديٍّ ولواء جيش",23,"ش",1,0],["كِلا المفْخَرَيْنِ يَرَاعاً وَسَيْفاً","دَعَا تاجَهُ لَكَ مُسْتَأْثِرَا",24,"ر",2,0],["كِلا العِلجَينِ أَصعَرُ صَيعَرِيٌّ","تَخالُ نَسيلَ مَتنَيهِ الثَغاما",25,"م",2,0],["كِلا الفريقينِ أبطالٌ ضراغمةٌ","لا يعصِمُ الأسدَ من غاراتهم غيلُ",26,"ل",1,0],["كلا الاسمَين عَبد اللّه لكِن","تزيد بِأَنَّكَ المَولى الشَريف",27,"ف",1,0],["كِلا القَمَرَيْنِ بَيْنَ عينيهِ غُرَّةٌ","أَنارَتْ كُسُوفَيكِ وَجَلَّتْ سِرَارَكِ",28,"ك",1,0],["كلا الأمرين منقصة وأسمى","نقاء العيش من معنى الخصيم",29,"م",1,0],["كِلا أخويك ذو رَحِمٍ ولكن","أخوك أخوك في النُّوبِ الشِّدادِ",30,"د",1,0],["كِلاَ الْقِسْمَيْنِ قَدْ سَلَكوا طَرِيقاً","وَمَا دَانُوا بِتَقْلِيدِ الرّجالِ",31,"ل",1,0],["كلا الهَجر منكِ الطّرف أن لا تعرّجي","على الحيّ أيقاظاً وزرتِ نياما",32,"م",2,0],["كِلا الجَديدَينِ قَد أُطعِمتُ حَبرَتَهُ","بادٍ وَماضٍ وَمَغفورٌ وَمُغتَفَرُ",33,"ر",1,0],["كِلا الجَديدَينِ قَد أُطعِمَتُ حَبرَتَهُ","لَو آلَ حَيٌّ إِلى عُمرٍ وَتَخليدِ",34,"د",1,0],["كِلا الرَجُلَينِ من أَفرادِ عَصرِ","يُقصِّرُ كُلُّ عصرٍ عن مَداهُ",35,"ا",2,0],["كِلا الدّينِ وَالدُّنيا بِهِ اِزدانَ وَاِزدَهى","وَآمَنَ شَرَّ المُبطِلِ المُتَمَرِّدِ",36,"د",1,0],["كَلاّ انْطِباعي في هَواكِ طَبيعةٌ","أضْحى بِها كَلَفي بِغَيرِ تَكَلُّفِ",37,"ف",1,0],["كلا الكابرين الفتى الشيخ في","قبيلته والزعيم الأبرْ",38,"ر",1,0],["كلا الفريقين معوانٌ لصاحبه","فما هنالِكَ متبوعٌ ولا تبع",39,"ع",1,0],["كلا الفريقين معتزٌّ بعدَّته","وللفريق الذي ناصرته الغلب",40,"ب",1,0],["كَلأ الراموسةَ الحسناءَ","ربّي وكلاها",41,"ا",3,0],["كلا النظرتين الأمر والحكم فيهما","يساوق حكم النظرة الأزلية",42,"ه",1,0],["كلا المذاقَين لي قَد لَذَّ مَطعَمُهُ","لكنَّ في الخمر مَعنىً ليس في العنب",43,"ب",1,0],["كلا اسميكِ للناسِ بادٍ له","بأوجهِهم أثرٌ ظاهر",44,"ر",1,0],["كلا الفعلين صاحبه كريم","وإن قضت الخطيئة أن يلاما",45,"م",2,0],["كِلا الفَرقَينِ أَعيا قَتلَ صاحِبِهِ","هَذا القَتيلُ بِمَيتٍ غَيرِ مَطلولِ",46,"ل",1,0],["كلا اخوي يظهر لي ودادا","فاعرف ما يسر كلا الاخين",47,"ن",1,0],["كلا الله قبرا قد حواه وضمه","لقد ضم مولى العرب والعجم والترك",48,"ك",1,0],["كِلا المَلِكَينِ أَولانِي جَميلاً","وَلَكِنَّ الجَميلَ لمِن بَداني",49,"ن",2,0],["كَلا الرَحمنُ مَن يَكلا","أَخا الغَيبِ وَلا يَدري",50,"ر",2,0],["كِلا السِربَينِ لَيسَ لَهُ وَفاءٌ","وَلا حَبلٌ يُمَدُّ بِهِ مَتِينُ",51,"ن",1,0],["كِلا الحَيَّينِ يَنصُرُ مُدَّعيهِ","لِيَلحَقَهُ بِذي الحَسَبِ الصَميمِ",52,"م",1,0],["كلا العنصرين اليوم غازٍ مجاهدٌ","يقود إلى إعدائه عسكراً مجرا",53,"ر",2,0],["كلا الاخوين يبني المعالي","والدنيا وللدين الصروحا",54,"ح",2,0],["كلا أنا المخطء الجاني جنيت على","نفسي بترك ذكي وامتداح غبي",55,"ب",2,0],["كِلا الفَريقَينِ أَعلاهُم وَأَسفَلُهُم","شَجٍ بِأَرماحِنا غَيرَ التَكاذيبِ",56,"ب",1,0],["كلا الجهولين حَمّالٌ وَقود لظى","من حامل الشعر أو حمّالة الحطب",57,"ب",1,0],["كلا الوجهين تعلوه حياةٌ","فيبهج خاطري ويروق عيني",58,"ن",2,0],["كلا الصدرين للدنيا حبيب","وفارس حلبة بين النضال",59,"ل",1,0],["كلا البطلين يأكل من لحوم","ويشرب من دم عند اللغوب",60,"ب",1,0],["كلا القولين تنكره","من العقل البديهات",61,"ت",1,0],["كِلا الأَخَوَيْنِ مَعْشوقٌ وإِنّي","أَرى التَفْضيلَ بَيْنَهُما حَماقَهْ",62,"ق",2,0],["كلا الجانبين عدو له","وشيعته النمط الأوسط",63,"ط",1,0],["كلا الحالينِ رامَ أَبو شُجَاعٍ","فلم يظْفَر بحزني وابتهاجي",64,"ج",2,0],["كُلاً أَصابَ مِن الغَواية وَالتُقى","فَأَفادَ ظَرفَ هَوىً وَعفّةَ دينِ",65,"ن",1,0],["كلا الحيين من هذا وهذا","لعمر أبيك ف