صَنَائعُ",124,"ع",1,0],["هديتي رعشتا شوق وقافية","حملتها كل ما عانيت في سفري",125,"ي",1,0],["هدرت حولك الجموعُ وماجتْ","مثل بحرٍ... والتفّتِ الأعناقُ",126,"ق",1,0],["هَدَّدَني الدَهرُ قُم وَإِلّا","قَضى عَلى اللَيثِ لِلشِياهِ",127,"ه",1,0],["هَدَمتُ ما كُنتُ أَبتَنيهِ","مِن شَرَفٍ باذِخٍ وَجاهِ",127,"ه",1,0],["هَدَدتُ طود الحلوم مِنّي","تَرَكتُ عَيشي بِلا مهاهِ",127,"ه",1,0],["هُدىً وَنوراً بِكُلِّ قَلبٍ","باتَ عَنِ اللَهِ غَيرَ لاهِ",127,"ه",1,0],["هَدَيتَ العَسكَرَ الجرَّارَ ليْلاً","فأَهْدَيت الظُّباةَ إلى الهوادي",128,"د",2,0],["هَدى الزهّادَ في الدُنيا","لَهُم عَن عَيبِها فَحصا",129,"ص",2,1],["هَدَمتُم بِناءَ الحُبِّ مِنّا بِهَجرِكُم","وَفي مِثلِكُم يرضي الحَليمُ صباهُ",130,"ا",2,0],["هَدى اللَهُ قَلبي لِلهَوى وَأَضَلَّهُ","وَلَو شاءَ مِن بَعدِ الضَلالِ هَداهُ",130,"ا",2,0],["هديُ الوقار وعزّ سلطان التقى","فهو المهيبُ وليس ذا سلطان",131,"ن",1,0],["هدَمَ الأسرة فوق هام ملوكها","وظفرتِ أنت بدولة وسرير",132,"ر",1,0],["هدُّوا المدافع بالفئو","س، وبالعصيّ، وبالخناجر",133,"ر",1,0],["هَدْأَةُ البَهْوِ صَحَت سائِلَةً","أنتَ يا ابنَ اللَّيلِ مَن ذا اقتادَ كسحَك؟",134,"ك",1,0],["هدأ الصّراع وكفّ عن غمراته","من عاش في الدّنيا بروح مغمامر",135,"ر",1,0],["هَدِّأْْ بنطقِك رَوعَهم قد أوشكت","للحُزنِ ان تتمزقَ الأعصاب",136,"ب",1,0],["هدأ الحَقْلُ والمدينةُ والغابُ","ودوَّى الصَّدى ورَجْعُ الجواب",137,"ب",1,0],["هدايتَك اللهمَّ للشعب حائراً","أعِنْ خُطوات الناهضين وسدِّد",138,"د",1,0],["هَدَيْتَ لَهَا، إنّ التّكَرّمَ فِطْنَةٌ،","وَقَد يَغفُلُ الشّهْمُ الأرِيبُ ليَلؤْمَا",139,"م",2,0],["هُدُوءاً رِكابي لا تَزَالُ نَجيبَة،","إلى رَجُلٍ مُلْقىً، تَحِنّ سُلُوبُها",140,"ب",3,0],["هدموا من الشرف المرفع ما بنوا","ومحوا معالمه وكن زواهيا",141,"ي",2,0],["هدا ، وما اختضبت لِغيركِ أسهمٌ","بِدمى ، ولا احتكمت على َّ لحاظُ",142,"ظ",1,0],["هَدَّتْ حُصُوناً كُنَّ قَبْلُ مَلاَوِذاً","لِذَوِي الْكُهُولِ مَعاً وَالنِّسَوَانِ",143,"ن",1,0]]}