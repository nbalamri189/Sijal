try.dctabudhabi.ae/diwan/poem/199488","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199481","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43857","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43763","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43655","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117018","الكامل"],[106,"غادة البسفور","https://www.poetsgate.com/ViewPoem.aspx?id=179474",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[96,"موكب الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=17479",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[45,"هُوَيْنَاكَ مِنْ لَوْمٍ على حُبٍّ تَكَتّمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32085",""],[28,"رأيت بني مروان يرفع ملكهم","https://www.poetsgate.com/ViewPoem.aspx?id=21317",""],[105,"لمن الرواسم يرتمين صواديا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54876&r=&rc=46",""],[87,"سَكِرَتْ بِخَمْرِ حَدِيثِكِ الأَلْفَاظُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24011&r=&rc=273",""],[18,"كُنَّا نَغَارُ عَلَى الْعَوَاتِقِ أَنْ تَرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26470&r=&rc=36",""]],"verses":[["هَدى الغَرامُ دُموعي في مَسالِكِهِ","عَلَيهُمِ وَأَضَلَّت صَبرِيَ الطُرُقُ",0,"ق",1,0],["هدهدت كفاك رأسي مثلما","هدهد الفجر رياحين الرّوابي",1,"ي",1,0],["هَدِيُّكُمُ خَيرٌ أَباً مِن أَبيكُمُ","أَعَفُّ وَأَوفى بِالجِوارِ وَأَحمَدُ",2,"د",1,1],["هديّتي لكَ وُدٌّ لوْ بعَثْتُ به","لمْ يسْتَطِعْ حمْلُهُ الدُنْيا ومَنْ فِيها",3,"ي",3,0],["هدَفٌ لا تَني سِهامُ الليالي","عنْ سِباقٍ تُجاهَهُ وبِدارِ",4,"ر",1,0],["هدمَ السّدَّ وهْوَ ما هوَ فارُ","كيْفَ شيْخٌ مُكايِدٌ غَدّارُ",5,"ر",1,1],["هُدّتْ بِناه في سَبيلِ وفائِها","فكأنّها صرْعى بغَيْرِ عُقارِ",6,"ر",1,0],["هديّةُ مقْصورٍ عليْكَ اعْتِمادُهُ","وخِدْمةُ عبْدٍ مخلِصٍ لكَ صدْرُهُ",7,"ر",2,0],["هَدِيَّةُ بِرٍّ لَمْ يَكُنْ لِجَزيلِهَا","سِوَى الأَجْرِ وَالذِّكْرِ الجَمِيلِ كِفَاءُ",8,"ف",3,0],["هَدِيَّةٌ مِن شاعِرٍ بائِسٍ","إِلى الدِمِرداشي وَلِيِّ النِعَم",9,"م",1,1],["هَدَّأَت لَوعَتي وَسَرَّت قَليلاً","عَن فُؤادي وَلَطَّفَت بَعضَ ما بي",10,"ب",2,0],["هَدَأَت نيرانُ حُزني هَدأَةً","وَاِنطَوى حِفني فَعادَت لِلشُبوبِ",11,"ب",1,0],["هَدِيَّةُ مَن لَو أَنَّ الدَهرُ سَنّى","مُناهُ هَدى إِلَيكَ سُرى الخَيالِ",12,"ل",1,0],["هَدَايَا النَّاسِ مِنْ زَهْرِ الجنَانِ","وَمَا أَهْدِيهِ مِنْ زَهْرِ الجَنَانِ",13,"ن",1,1],["هُدَى الْوِزَارَاتِ إِذَا فَاتَهَا","وَجْهُ الْهُدَى فِي المَطْلَبِ المُبْهَمِ",14,"م",1,0],["هَدَّمْتَ فِي طُولِ البِلادِ وَعَرْضِهَا","أَعْلامَهَا الحُكَمَاءَ كُلَّ مُهَدَّمِ",15,"م",1,0],["هَدايا الناسِ بَعضِهِمُ لِبَعضٍ","تُوَلِّدُ في قُلوبِهِمُ الوِصالا",16,"ل",2,1],["هديتَ سبيلَ الله من ضَلَّ رشده","فلا زلتَ مهدياً إليه وهاديا",17,"ي",2,0],["هَدَرَتْ طبول العزّ تحت ظلالها","عنوان فتح إثرها يستعجلُ",18,"ل",1,0],["هدمت نظيرة ما بَنَت عاداتكم","من كل سجن للنساء مُهين",19,"ن",1,0],["هَداكَ الَّذي يَهدي الخَلائِفَ لِلتُقى","وَأُعطيتَ نَصراً لَم تَنَلهُ الخَلائِفُ",20,"ف",1,0],["هدماً للكنيف يلقى لدى المب","رك لا يتبع الصريف الهديرا",21,"ر",2,1],["هَدَفٌ تَعاوَرَهُ الرُماةُ كَأَنَّما","يَرمونَ جَندَلَةً بِعُرضِ المَشعَرِ",22,"ر",1,0],["هَداهُم بِهِ بَعدَ الضَلالَةِ رَبُّهُم","وَأَرشَدَهُم مَن يَتبَعِ الحَقَّ يَرشُدُ",23,"د",1,0],["هداها حماها زانها جادها اعتلى","فكان على الخمس الجهاتِ شهابها",24,"ب",3,0],["هديت قروم ذوي الفصاحة قبلها","وتقاعسوا عنها لأوَّل منزع",25,"ع",1,0],["هدَّدتموا بالضنا من ليسَ يرتدع","هيهات لم يبقَ فيه للضنا طمع",26,"ع",1,1],["هدّدني بالدين في جلق","مطالبٌ يفضّ لي خلقا",27,"ق",2,1],["هدمتَ بيت الغنى مما تجود به","فاهنأ بأبيات مدحٍ ليس تنهدم",28,"م",1,0],["هَدَرتْ فلما استفحلتْ","في دَنِّها سكن الهديرُ",29,"ر",1,0],["هديَّةَ ذي ذخر جزيلٍ موفَّرٍ","ومال قليل عن هداياه مُعْوِز",30,"ز",1,0],["هداه أقصى غريبٍ قصدَ وِجْهتِهِ","من بعد ما حار في داجٍ من الظُّلم",31,"م",1,0],["هدأتَ على الإساءة بي مُصرَّاً","ونفسي قد أَبَت عنك الهُدُوَّا",32,"و",2,0],["هديّةُ شمأَلٍ هَبَّتْ بليل","لأفنانِ الجِنان لها نَجِيُّ",33,"ي",1,0],["هَديرَ المُعَنّى أَلقَحَ الشَولَ غَيرَهُ","فَظَلَّ يُلَوّي رَأسَهُ بِقَتادِ",34,"د",1,0],["هَداني إِلَيكَ الفَرقَدانِ وَلاحِبٌ","لَهُ فَوقَ أَصواءِ المِتانِ عُلوبُ",35,"ب",1,0],["هِدانٌ أَخو وَطبٍ وَصاحِبُ عُلبَةٍ","يَرى المَجدَ أَن يَلقى خَلاءً وَأَمرُعا",36,"ع",2,0],["هد يقسو بمعول الموت ركنا","كان قد شادته الحياة متينا",37,"ن",2,0],["هداية الإمام","ومطلع السعود",38,"د",1,0],["هَدَمَت مَعالِمَها وَهَدَّت رُكنَها","وَأَضاعَتِ اِستِقلالَها المَأمولا",39,"ل",2,0],["هَدَروا دِماءَ الأُسدِ في آجامِها","وَالأُسدُ شارِعَةُ القَنا تَحميكِ",40,"ك",1,0],["هَدَروا دِماءَ الذائِدينَ عَنِ الحِمى","بِلِسانِ مُفتي النارِ لا مُفتيكِ",40,"ك",1,0],["هَدانا ضَوءُ ثَغرِكَ مِن ثَلاثٍ","كَما تَهدي المُنَوَّرَةُ الرِكابا",41,"ب",2,0],["هَدَدتَ أَميرَ المُؤمِنينَ كَيانَها","بِأَسطَعَ مِثلِ الصُبحِ لا يَتَكَذَّبُ",42,"ب",1,0],["هَدِيَّةٌ ما رَأَيتُ مُهديها","إِلّا رَأَيتُ العِبادَ في رَجُلِ",43,"ل",1,0],["هديتُهم صوبَ الفلاةِ وإنني","بُعَيدَ الوجَى هتّامُ رُوقِ المخارمِ",44,"م",1,0],["هدايا لحدِّ المرهفاتِ مسوقةٌ","فهل عندَ حدِّ المرهفاتِ قَبولُ",45,"ل",1,0],["هُديتَ لَها إِنَّ التَكَرُّمَ فِطنَةٌ","وَقَد يَغفُلُ الشَهمُ الأَريبُ لِيَلأُما",46,"م",2,0],["هَدَأَ الناسُ وَنامَت","كُلُّ عَينٍ غَيرَ عَيني",47,"ن",2,1],["هُدوءً رِكابي لا تَزالُ نَجيبَةً","إِلى رَجُلٍ مُلقىً تَحِنُّ سُلوبُها",48,"ب",3,0],["هُداةً وَمَهدِيِّينَ عُثمانُ مِنهُمُ","وَمَروانُ وَاِبنُ الأَبطَحَينِ المُطَيَّبُ",49,"ب",1,0],["هَديٍ تُساقُ إِلى حَيثُ الدِماءُ لَهُ","يَبلُلنَ مِن عَلَقِ الأَجوافِ كَتّانا",50,"ن",2,0],["هَدِيَّةً لم أدْرِ من ظَرفِها","أعجَبُ أم مِن ظَرفِ مُهديها",51,"ي",3,0],["هُدَيتَ يا طَيفُ قُل لِأَهلِ مِنىً","إِنَّ المُعَنّى هَواهُ أَفناهُ",52,"ا",2,0],["هَدَمتَ القَلبَ ثُمَّ سَكَنتَ فيهِ","فَكيفَ جَعَلتَ مَسكَنَكَ الخَرابا",53,"ب",2,0],["هَدَّ قَلبي مَن كانَ يُؤنِسُ قَلبي","إِذ نَبَذناهُ بِالعَراءِ سَقيما",54,"م",2,0],["هُدهُدٌ هَدَّ قَوَّتي حينَ لَم يُل","قِ إِلى العَبدِ مِن كِتابٍ كَريمِ",55,"م",1,0],["هَديَّةُ الصِنفِ وَدَربَندِيَّةٌ","أَو خُزَريّاتٌ بَدَت أَصائِلا",56,"ل",2,0],["هَدَمَ الضنى العادي قَوِيَّ شكيمتي","وثنى معاندتي وردَّ جماحي",57,"ي",1,0],["هدَّ قراري جريها في دمي","وهمسها في كر أنفاسي",58,"ي",1,0],["هدأ الليلُ هُنا لكنني","كنتُ في حُسنِك بالصّمتِ أُغنّي",59,"ي",1,0],["هدأت رسائل حبها","كالطفل في أحلامها",60,"م",3,0],["هدَيْتَ من ضلّ عن مجدٍ وعن كرَمٍ","بما تجاوَزَ قَدْرَ النار والعلمِ",61,"م",1,0],["هَدّ الضّلالَ فلم تقُمْ عُمُدٌ له","وأقامَ من عمد الهدى ما مالا",62,"ل",2,0],["هَدانا إِلَيها شَذا قَهوَةٍ","تُذيعُ لأَنفِكَ أَسرارَها",63,"ر",3,0],["هَدِيَّةً مِن صَمَدٍ جَوادِ","لَيسَ بِمَولودٍ وَلا وَلّادِ",64,"د",1,0],["هَدَمَت صُروفُ المَوتِ أَرفَعَ حائِطٍ","ضُرِبَت دَعائِمُهُ عَلى الإِسلامِ",65,"م",1,0],["هَدَأَت عَلى تَأميلِ أَحمَدَ هِمَّتي","وَأَطافَ تَقليدي بِهِ وَقِياسي",66,"س",2,0],["هَدَمَت مَساعيهِ المَساعي وَاِبتَنَت","خِطَطَ المَكارِمِ في عِراضِ الفَرقَدِ",67,"د",1,0],["هَدى بِها اللَّهُ دَوساً مِن ضَلالَتِها","فَتابَعَت أَمرَ داعِيها وَلَم تَهِمِ",68,"م",1,0],["هَدَفٌ لِلْعُيُوبِ فِي كُلِّ عُضْوٍ","مِنْهُ سَهْمٌ لِلطَّاعِنِينَ وَنَصْلُ",69,"ل",1,0],["هَدَرَت جِنايَةُ صَرفِ دَهرٍ جائِرٍ","نَفَضَ المَشيبَ بِعارِضَيَّ غُبارا",70,"ر",2,0],["هدم التّيهُ قديماً مُلكَكم","فبنى بلفورُ منه ما هَدمْ",71,"م",1,0],["هَدَّ قومي باسْمِ مُوسَى ظالمٌ","لو رأَى في القومِ موسى ما رَحِمْ",71,"م",1,0],["هَدَّتْ جَبابِرةُ الغُزاةِ كِيانَهُ","فهوَى وتلك جنايةُ السّفهاءِ",72,"ا",2,0],["هَداهُ إِلى المَعروفِ دينٌ يُضيئُهُ","مِنَ الذِكرِ ذي الآياتِ أَبلَجُ مُشرِقُ",73,"ق",1,0],["هِدَّةُ البَرِّ كُلُّها مِن قُواهُ","وَجَحيمُ البِحارِ مِن مُنشَآتِهْ",74,"ت",2,0],["هَدَموا مِنَ الإِسلامِ رُكناً عالِياً","نَهَضَ النَبِيُّ وَآلُهُ بِمُقامِهِ",75,"م",2,0],["هَدَّ الكَنائِسَ ما وَعَت جُدرانُها","مِن موبِقاتِ البَغيِ وَالعُدوانِ",76,"ن",1,0],["هِدايَتَكَ اللَهُمَّ إِنّي أَرى الأُلى","هُمُ القادَةُ الهادو