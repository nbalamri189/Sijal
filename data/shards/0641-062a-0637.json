,[270,"يا طائرا في الدوح ناح","https://www.aldiwan.net/poem35201.html","مجزوء الكامل"],[348,"نظرت من خلل السج","https://www.aldiwan.net/poem20746.html","مجزوء الرمل"],[377,"عفت نفسي أمانيها","https://www.aldiwan.net/poem59166.html","مجزوء الوافر"],[432,"يقر لغليلم المليك بن غليلم","https://www.aldiwan.net/poem12345.html","الطويل"],[458,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[482,"إن الأهاويل في جنب الوصول إلى","https://www.aldiwan.net/poem24293.html","البسيط"],[499,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[551,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"]],"verses":[["فَتَطَوَّقَ العَلياءَ وَه","وَ قَريبُ عَهدٍ بِالتَمائِم",0,"م",1,0],["فتَطارَحَتْ مُقَلُ الرّكائِبِ نحوَها","ولنا بِرامَةَ وِقْفَةُ المُتَحَبِّر",1,"ر",1,0],["فَتُطْعِمُنَا الْمَغَانِي وَالرَّوَابِي","وَتَسْقِينَا الْغُيُوثَ المُسْتَهلَّهْ",2,"ل",2,0],["فَتَطاحَنَ الجَيشانِ سا","عاتٍ تَشيبُ لَها الأَجِنَّه",3,"ن",2,0],["فَتَطَيَّرَتْ مِنْ حُكْمِهَا أَلْبَابُنَا","وَتَحَيَّرَتْ فِي حِكْمَةِ الرَّحْمَنِ",4,"ن",1,0],["فتطيبَ في تلك الربوعِ مدائحي","ويطولَ في ذاك المَقَام ثوائي",5,"ا",2,0],["فتطلُع الشمس في صباح","وتغرُب الشمس في مساء",6,"ا",2,0],["فتطلعا نحو السماء وحلقا","صُعُداً إلى الآفاق يرتقيان",7,"ن",1,0],["فَتَطَلَّق مَعَ العَنايَةِ إِنَّ ال","بِشرَ في أَكثَرِ الأُمورِ بَشيرُ",8,"ر",1,0],["فَتَطَلَّعَت في كُلِّ مَوقِعِ لَحظَةٍ","مِن كُلِّ غُصنٍ صَفحَةٌ وَعِذارُ",9,"ر",1,0],["فَتَطَوَّقَت بِالهَونِ مِنهُ حَمامَةٌ","يَعتادُها تَحتَ الظَلامِ عَويلُ",10,"ل",1,0],["فَتَطَرَّبتُ لِلهَوى ثُمَّ أَقصَر","تُ رِضاً بِالتُقى وَذو البِرِّ راضي",11,"ض",2,0],["فتطولُ فيه أكفُّ آلِ محَمدٍ","وتُغَلُّ فيه عن النّدى الطُّلَقاء",12,"ا",2,0],["فتطلب منه أن يحلَّ عقالها","فذلك ينفي كربها ويفيدها",13,"د",3,0],["فَتَطوف مثل فراشة","لاقَت بجنح اللَيل وقدا",14,"د",2,0],["فتطارحْنا حديثاً عَجَباً","فيه للروحِ وللعقلِ غِذاء",15,"ا",2,0],["فتطَلَّعتْ عَيْنٌ وأصْغَت بعدَها","أُذنٌ وهمَّت أَلْسُنٌ بسؤال",16,"ل",1,0],["فتطغى مشاهده كالحريق","ويقتحم المشهد المشهدا",17,"د",2,0],["فتَّ طائيهم عَطاءً وَمَبنىً","وَبِطيب الثَنا جدَّك مَعنا",18,"ن",2,0],["فتطيب بعد شتاتها مجموعة","والقرب يصلح طوره اطوارها",19,"ر",3,0],["فتطير آمال له ومآرب","ويروح يسأل رفده المسترفد",20,"د",1,0],["فَتُطِيعُ ذاهلةً وحادي","عيسها لليأسِ يَحدو",21,"د",2,0],["فتطوَّقتْ مِنْ ثغرها بقلادةٍ","وتوشَّحَتْ مِنْ حَلْيِها بِنطاقِ",22,"ق",1,0],["فَتَطَأطَأوا حَتّى حَسِبتُكَ بَينَهُم","ثَهلانَ أَو ذا الهَضبِ لا يَتَضَعضَعُ",23,"ع",1,0],["فتطلاب المني بالأمن غي","وكيف يضل من شهد الرشادا",24,"د",2,0],["فتطيرُ من غصنِ الى","غصنٍ عليهِ الزهرُ فاح",25,"ح",1,0],["فَتَطارَحْنا هَوانا","بِرِسالات الجفونِ",26,"ن",1,0],["فتُطربها مثانيها","وتُطربها مثانيها",27,"ي",3,0],["فتُطْلِعُ منها كوكبَ السَّعْدِ في النَّدَى","وتُرْسِلُ منها في الوَغَى كَوْكَبَ الرَّجْمِ",28,"م",1,0],["فتطلّعوا هُجناءَ من أطرافها","فخرَ الشواحج تنسُبُ الأخوالا",29,"ل",2,0],["فتطرَبُ والشادِي بها سامرُ المنى","وتشربُ ما يَسقِي وجفنُك كُوبُ",30,"ب",1,0],["فَتُطْعِمُها مَعارِكُهُ","وتُطْعِمُهُمْ مَراجِلُهُ",31,"ل",2,0],["فتطمح النفس صرفا بشرائرها","لوحدة الحق إنها لجنات",32,"ت",1,0],["فَتَطايَرَت عَنّي وَقُمتُ بِعاتِرٍ","صَدقِ المَهَزَّةِ ذي كُعوبٍ كَالنَوى",33,"ا",1,0],["فَتَطامَحوا وَتَطاوحوا بيد الرّدى","وَتَقوّموا ثُمّ اِنثنَوْا فتعوّجوا",34,"ج",3,0]]}