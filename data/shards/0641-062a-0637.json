oetry.dctabudhabi.ae/diwan/poem/21512","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35485","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132190","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125838","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83539","الخفيف"],[4586,"","https://poetry.dctabudhabi.ae/diwan/poem/80156","الطويل"],[4767,"عقد زينب","https://www.poetsgate.com/ViewPoem.aspx?id=179946",""],[4782,"مرافئ الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=198688",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5111,"أرجُ اللقاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212130",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5183,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=186492",""],[5183,"سمراء النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185681",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5408,"دمعة حزن","https://www.poetsgate.com/ViewPoem.aspx?id=190864",""],[5616,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205217",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5725,"ياقلب رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=178058",""],[402,"ألشرق طال سباته الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=36487",""],[5897,"غداً القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=160569",""],[5943,"أسطورة التخريبِ غنِّي وانشري","https://www.poetsgate.com/ViewPoem.aspx?id=11259",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5956,"حفيداي الطفلان أحمد وعابد","https://www.poetsgate.com/ViewPoem.aspx?id=206260",""],[6033,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215798",""],[6070,"سُبحانَ ربِّ الكَونِ والتكوينِ","https://www.poetsgate.com/ViewPoem.aspx?id=187747",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""],[6229,"ملاكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65181&r=&rc=8",""],[5126,"عاطفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87794&r=&rc=9",""],[5190,"دموع التماسيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78318&r=&rc=31",""],[6344,"رجع من شفة الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87978&r=&rc=18",""]],"verses":[["فَتَطَوَّقَ العَلياءَ وَه","وَ قَريبُ عَهدٍ بِالتَمائِم",0,"م",1,0],["فتَطارَحَتْ مُقَلُ الرّكائِبِ نحوَها","ولنا بِرامَةَ وِقْفَةُ المُتَحَبِّر",1,"ر",1,0],["فَتُطْعِمُنَا الْمَغَانِي وَالرَّوَابِي","وَتَسْقِينَا الْغُيُوثَ المُسْتَهلَّهْ",2,"ل",2,0],["فَتَطاحَنَ الجَيشانِ سا","عاتٍ تَشيبُ لَها الأَجِنَّه",3,"ن",2,0],["فَتَطَيَّرَتْ مِنْ حُكْمِهَا أَلْبَابُنَا","وَتَحَيَّرَتْ فِي حِكْمَةِ الرَّحْمَنِ",4,"ن",1,0],["فتطيبَ في تلك الربوعِ مدائحي","ويطولَ في ذاك المَقَام ثوائي",5,"ا",2,0],["فتطلُع الشمس في صباح","وتغرُب الشمس في مساء",6,"ا",2,0],["فتطلعا نحو السماء وحلقا","صُعُداً إلى الآفاق يرتقيان",7,"ن",1,0],["فَتَطَلَّق مَعَ العَنايَةِ إِنَّ ال","بِشرَ في أَكثَرِ الأُمورِ بَشيرُ",8,"ر",1,0],["فَتَطَلَّعَت في كُلِّ مَوقِعِ لَحظَةٍ","مِن كُلِّ غُصنٍ صَفحَةٌ وَعِذارُ",9,"ر",1,0],["فَتَطَوَّقَت بِالهَونِ مِنهُ حَمامَةٌ","يَعتادُها تَحتَ الظَلامِ عَويلُ",10,"ل",1,0],["فَتَطَرَّبتُ لِلهَوى ثُمَّ أَقصَر","تُ رِضاً بِالتُقى وَذو البِرِّ راضي",11,"ض",2,0],["فتطولُ فيه أكفُّ آلِ محَمدٍ","وتُغَلُّ فيه عن النّدى الطُّلَقاء",12,"ا",2,0],["فتطلب منه أن يحلَّ عقالها","فذلك ينفي كربها ويفيدها",13,"د",3,0],["فَتَطوف مثل فراشة","لاقَت بجنح اللَيل وقدا",14,"د",2,0],["فتطارحْنا حديثاً عَجَباً","فيه للروحِ وللعقلِ غِذاء",15,"ا",2,0],["فتطَلَّعتْ عَيْنٌ وأصْغَت بعدَها","أُذنٌ وهمَّت أَلْسُنٌ بسؤال",16,"ل",1,0],["فتطغى مشاهده كالحريق","ويقتحم المشهد المشهدا",17,"د",2,0],["فتَّ طائيهم عَطاءً وَمَبنىً","وَبِطيب الثَنا جدَّك مَعنا",18,"ن",2,0],["فتطيب بعد شتاتها مجموعة","والقرب يصلح طوره اطوارها",19,"ر",3,0],["فتطير آمال له ومآرب","ويروح يسأل رفده المسترفد",20,"د",1,0],["فَتُطِيعُ ذاهلةً وحادي","عيسها لليأسِ يَحدو",21,"د",2,0],["فتطوَّقتْ مِنْ ثغرها بقلادةٍ","وتوشَّحَتْ مِنْ حَلْيِها بِنطاقِ",22,"ق",1,0],["فَتَطَأطَأوا حَتّى حَسِبتُكَ بَينَهُم","ثَهلانَ أَو ذا الهَضبِ لا يَتَضَعضَعُ",23,"ع",1,0],["فتطلاب المني بالأمن غي","وكيف يضل من شهد الرشادا",24,"د",2,0],["فتطيرُ من غصنِ الى","غصنٍ عليهِ الزهرُ فاح",25,"ح",1,0],["فَتَطارَحْنا هَوانا","بِرِسالات الجفونِ",26,"ن",1,0],["فتُطربها مثانيها","وتُطربها مثانيها",27,"ي",3,0],["فتُطْلِعُ منها كوكبَ السَّعْدِ في النَّدَى","وتُرْسِلُ منها في الوَغَى كَوْكَبَ الرَّجْمِ",28,"م",1,0],["فتطلّعوا هُجناءَ من أطرافها","فخرَ الشواحج تنسُبُ الأخوالا",29,"ل",2,0],["فتطرَبُ والشادِي بها سامرُ المنى","وتشربُ ما يَسقِي وجفنُك كُوبُ",30,"ب",1,0],["فَتُطْعِمُها مَعارِكُهُ","وتُطْعِمُهُمْ مَراجِلُهُ",31,"ل",2,0],["فتطمح النفس صرفا بشرائرها","لوحدة الحق إنها لجنات",32,"ت",1,0],["فَتَطايَرَت عَنّي وَقُمتُ بِعاتِرٍ","صَدقِ المَهَزَّةِ ذي كُعوبٍ كَالنَوى",33,"ا",1,0],["فَتَطامَحوا وَتَطاوحوا بيد الرّدى","وَتَقوّموا ثُمّ اِنثنَوْا فتعوّجوا",34,"ج",3,0],["فتُطربنا ويُطربنا","صياح الديك قمَّار",35,"ر",1,0],["فتطلّع الجرذانُ كلُّهُمُ","فإذا بها مقطوعة الذنب!",36,"ب",1,0],["فتطارحت بينها أتقاضى","بعض ما يستقيم منه الثناء",37,"ا",2,0],["فتطلبت سلمه دون حرب","حيث قلبي ما مسه عنه قلب",38,"ب",1,0],["فتطير أفئدة بأجنحة المنى","عبر الزمان لترقب المقصودا",39,"د",2,0],["فتطلبها فقراً إليها وذلةً","لأنك عبدٌ بالأصالة معدَم",40,"م",1,0],["فتطمع فيه الكاعبات لنفعه","وترهب منه في أماكنها الأسد",41,"د",1,0],["فَتَطَايَرَت تِلكَ القُلُوبُ إلَيهش بِال","أشوَاقِ إذ مُلِئَت مِنَ العِرفَانش",42,"ن",2,0],["فتطلعت في فلسطين بدراً","دونه في التمام بدر التمام",43,"م",1,0],["فتطالعن لتوديع الإمام","وتهاوين عليه قائلات",44,"ت",1,0],["فتطير القلوب من ارتياعاً","كلما شدَّ راكباً ذا الجناح",45,"ح",1,0],["فتطلع إلى مشارف أسوا","ن وحدق فيما يرد النيلا",46,"ل",2,0],["فتَطَوَّقت أعناقُهم","من فضله حَتَّى أنا",47,"ن",2,0],["فتطمعُ أن تَمَلّكَ بالتَواني","وقد عرّضتَ حالكَ للتظنّي",48,"ن",2,0],["فتطرب بالثنا وتروح منه","بجودك مستزيداً مستعيدا",49,"د",2,0],["فتطلبت قتل ابن طه ضلةً","بالاغتيال ولو ببطن البيت حل",50,"ل",1,0],["فتطيب الانفاس والعيش يحلو","بعدما بالبعاد قد صار مرا",51,"ر",2,0],["فَتَطلُبَ شَعبَ الصَدعِ بَعدَ اِنفِتاقِهِ","فَتَعيا بِهِ فَالآنَ وَالأَمرُ سالِمُ",52,"م",1,0],["فَتطلع كَالكَأسِ إِذ تَستَحث","وَتَغرب كَالكَأس إِذ يشرَبُ",53,"ب",1,0],["فتطغى مجاري المياه وتطمو الس","سيول وتنقض فوق الهضاب",54,"ب",1,0],["فتطوى في سراها البحر طياً","بشوق متيمٍ نحو اللقاء",55,"ا",2,0],["فتطير أَفئدةُ اليهود به","على طول المدى",56,"د",2,0],["فَتَطيب النُفوسُ فَوزاً بِفَضل ال","لَهِ وَالفَوزُ فيهِ طيبُ النفوسِ",57,"س",1,0],["فتطْردُ عن حَوْضَي سعيدٍ ضوارِباً","ليجْزي بيومِ الكَمْعِ يوماً عَصَيْصَبا",58,"ب",2,1],["فتطير جذلَى بالتي عشِقَت","تَجتاز ما لا تبلغُ القمم",59,"م",1,0],["فتطيرَ مِن لا شيءَ كفتُهم","حتى تُرَى بالأرض ترتطم",59,"م",1,0],["فتطربنا الأماني راقصاتٍ","ونسرجُ نحو مخدعها المطايا",60,"ا",3,0],["فتطرق الرأس في استحياء غانيةٍ","عجزاً وتنطق لم تفصح من اللكن",61,"ن",1,0],["فتطربني وُرُودٌ حَالِمَاتٍ","فَتَسْكُبُ فِي اللَّظَى رَوحًا وَرَاحَا",62,"ح",2,0],["فَتُطْرِبُ الْعَاشِقَ الْوَلْهَانَ تُلْهِمُهُ","يَطْوِي الْفَيَافِيَ لِيْ يَسْعَى وَيَنْتَعِلُ",63,"ل",1,0],["فتطاولت كي أشمّ شذاها","لو أعارت طَولي إليها اهتماما",64,"م",2,0],["فتطلع نحو الشجيرة بالضف","ة بين الظلام والأنوار",65,"ر",1,0],["فَتطوَّف سبعاً عليها ويامِن","ذلك الركن واستلمه استلاما",66,"م",2,0],["فتطبع في قلب المعنى جنونه","وتسلبه لبا بما ثم ترتدي",67,"د",2,0],["فتطوّحت صورٌ ولاحتْ صورة","والذكريات شريطها يتوزّعُ",68,"ع",1,0],["فتُطلِقُ أكداسُ الرسالاتِ ضِحْكةً","فأرجعُ مكسوراً وحُلميَ كاذِبُ",69,"ب",1,0],["فَتُطْعَمُ حَتَّى تَشْتَكيْهَا بُطُوْنُهَا","وَ تُبْقِي كَأنَّ السَّبْعَ مَاْ مَسَّ صَحْنَكِ",70,"ك",1,0],["فتطير في ليلٍ بجنحِ حمامةٍ","روحي اليكم جنحها لم يطلعِ",71,"ع",1,0],["فتطيب نفساً ماشعبت من الندى","ريحا تطيّبها نسائم شِعْبهم",72,"م",1,0],["فتط