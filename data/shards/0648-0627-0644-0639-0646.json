{"poems":[[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[93,"السحب تركض في الفضاء ركض الخائفين","https://www.aldiwan.net/poem62795.html","عموديه"],[94,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[47,"توعدني شيبان بغيا وما","https://www.aldiwan.net/poem66845.html","البسيط"],[30,"بالعنبرية دار قد كلفت بها","https://www.aldiwan.net/poem5205.html","البسيط"],[33,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[33,"ردوا التحية أيها السفر","https://www.aldiwan.net/poem42513.html","الكامل"],[33,"ألمم بعفراء إن أصحابك ابتكروا","https://www.aldiwan.net/poem42541.html","البسيط"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[50,"إبخل على الدار بتكليم","https://www.aldiwan.net/poem65104.html","السريع"],[48,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[48,"غضب الأمير من الملام وهل ترى","https://www.aldiwan.net/poem22842.html","الكامل"],[15,"ليس رسم على الدفين ببالي","https://www.aldiwan.net/poem45253.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[47,"تُوعِدُنِي شَيْبَانُ بَغْياً ، وما","https://www.poetsgate.com/ViewPoem.aspx?id=31640",""],[113,"سعدت دمشق بطالع الشعراني","https://www.aldiwan.net/poem16211.html","الكامل"],[113,"وفد الربيع فقم لحث الكاس","https://www.aldiwan.net/poem16246.html","الكامل"],[119,"اهلا بهذا الاهيف البسام","https://www.aldiwan.net/poem40490.html","عموديه"],[155,"نفسي الفداء لسائل وافاني","https://www.aldiwan.net/poem1413.html",""],[203,"لا ترق مدرجة الصعود","https://www.aldiwan.net/poem45394.html","مجزوء الكامل"],[208,"قدم الربيع فحط في آذار","https://www.aldiwan.net/poem53147.html","الكامل"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[276,"قل للمطي اللواتي طال مسراها","https://www.aldiwan.net/poem52094.html","البسيط"],[290,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[333,"أكبرت عيدك هجرة المختار","https://www.aldiwan.net/poem54964.html","الكامل"],[347,"يا لقلبي من ذكريات الأماني","https://www.aldiwan.net/poem55330.html","الخفيف"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[447,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[457,"إني لمشتاق لربوة جلق","https://www.aldiwan.net/poem13808.html","الكامل"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139074",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66839","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122308","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199595","المسحوب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77665","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59040","المواليا"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202110","السريع"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143130","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112856","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112877","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109013","الكامل"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113739","البسيط"],[2184,"","https://poetry.dctabudhabi.ae/diwan/poem/104205","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27822","البسيط"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2235,"","https://poetry.dctabudhabi.ae/diwan/poem/203772","المنسرح"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104987","الكامل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18021","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93791","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3349,"","https://poetry.dctabudhabi.ae/diwan/poem/73843","البسيط"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133249","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69958","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69901","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78192","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123519","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54378","الخفيف"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104518","الخفيف"],[4702,"المبسم الحالي","https://www.poetsgate.com/ViewPoem.aspx?id=156813",""],[4755,"امسحوا رأسَ حُزنِكم","https://www.poetsgate.com/ViewPoem.aspx?id=189676",""],[4759,"غربتي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203678",""],[4869,"انتي سما لكن بها تجري الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=151608",""],[5084,"هلّ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=177785",""],[5107,"نداء من المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=32889",""],[5170,"ضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=175541",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5198,"ضحكتك حفلة","https://www.poetsgate.com/ViewPoem.aspx?id=135389",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5273,"أرق الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=178287",""],[5413,"عقيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=200595",""],[5751,"بينَ موتٍ وموت","https://www.poetsgate.com/ViewPoem.aspx?id=214771",""],[5829,"ربيع الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161988",""],[5845,"قلْ للمطيِّ اللواتي طالَ مسراها","https://www.poetsgate.com/ViewPoem.aspx?id=198493",""],[6056,"فخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=156699",""],[4442,"ظفرت دولة الربيع فغنى","https://www.poetsgate.com/ViewPoem.aspx?id=170994",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""]],"verses":[["وَالعَنبَرُ الوَردُ إِن عَبَثتَ بِهِ","مِثلَما زادَ عَرفُهُ طيبا",0,"ب",2,0],["وَالعَندَليبُ صُداحوهُ","لا ظُفرُهُ وَجَناحُهُ",1,"ه",1,0],["وأَلعنُ مَنْ لا يماشي الزَّمانَ","ويقنعُ بالعيشِ عيشِ الحجرْ",2,"ر",1,0],["والعندليب هب يشدو","بانتصار الغالب",3,"ب",1,0],["وَالعَنَزِيّونَ فَقَد أَوعَدوا","وَالحَربُ أَطوارٌ وَأَلوانُ",4,"ن",1,0],["وَالعَنبَرِيَّةُ وَحشٌ بَعدَ حِلَّتِها","مِنَ المُلاءَةِ أَسقى جَوَّها المَطَرُ",5,"ر",1,0],["وَالعَنبَرَ الأَكلَفَ المَسحوقَ خالَطَهُ","وَالزَنجَبيلَ وَراحَ الشامِ وَالعَسَلا",6,"ل",2,0],["وَالعَنبَرُ المَسحوقُ خالَطَهُ","وَقَرَنفُلٌ يَأتي بِهِ النَشرُ",7,"ر",1,0],["وَالعَنبَرُ الأَكلَفُ المَسحوقُ خالَطَهُ","وَالزَنجَبيلُ وَرَندٌ هاجَهُ السَحَرُ",8,"ر",1,0],["وَالعن الأنكليز وَاحمل ظباهم","إِن نَكران فَضلهم لَجَسيم",9,"م",1,0],["وَاِلعَن غُرابَ البَينِ بَغضاً لَهُ","فَإِنَّهُ داعِيَةُ الشومِ",10,"م",1,0],["وَالعَنبَريَّةُ لاتُبالي","أَن تَعيشَ بِغَيرِ عَنبَر",11,"ر",1,0],["وَالعُنسُ تُعتَقُ مِن أَذاكَ أَسَرُّ مِن","غُرِّ العَواتِقِ وَالغَواني العُنَسِ",12,"س",1,0],["وَالعَناجيجِ كَالقِداحِ مِنَ الشَو","حَطِ يَحمِلنَ شِكَّةَ الأَبطالِ",13,"ل",1,0],["والعناقيد من أغان ومن شعر","تتلوّى على الثرى المخضاب",14,"ب",1,0],["والعَنَزِيُّونَ فَقَدْ أَوْعَدُو","والحَرْبُ أَطْوَارٌ وأَلْوَانُ",15,"ن",1,0],["وَالعَنَدليب يَقول وَاطربي إِلى","مِن شَجوِهم قَبل الهَوى أَشجاني",16,"ن",2,0],["وَالعَندَليب مُصفق يَشدو عَلى","تِلكَ الهِضاب وَغُصنِها المَياس",17,"س",1,0],["والعندليب على الغصون مبرقم","شتان بين غرامه وغرامي",18,"م",2,0],["والعنكبوتُ تحوكُ والموسى معاً","ثم اليمين وإصبعُ الإنسانِ",19,"ن",1,0],["والعنكبوتُ إذا بنتْ","بيتاً فأهونُ بالخيوطِ",20,"ط",1,0],["والعندليب مُغَرِّدٌ بصَفيره","يحكي معاني رنَّة الأوتارِ",21,"ر",1,0],["والعندليب في الغصون يتلو","ان السرور صبوة وجهل",22,"ل",1,0],["وَالعنكبوت بنت بيتا عليه لكي","ترد فرقة كفر ضل مَسعاها",23,"ا",3,0],["والعن خسيسا قد عني","بالزور في نقل الخبر",24,"ر",1,0],["والعنكبوت بني معالم بيته","قدراً من المتصرف القهار",25,"ر",1,0],["والعناق اللذيذ يا ليل يتلو","هُ غلو القلبين في الخفقان",26,"ن",1,0],["والعنا والبلايا والغموم","فارفضوها أنها النزر المهان",27,"ن",1,0],["والعنهم عن مديحي فيهم فهم","باللعن أجدر إني تبت مرجعا",28,"ع",2,0],["والعندليب على الغصون مرجِّعٌ","شَدْوَ القِيانِ تزفُّ كأسَ مغَلّس",29,"س",1,0],["والعنقُ أوْلَى أنْ يُصان وأنْ","يشقى بجمرةِ دائِهِ الكَفَلُ",30,"ل",1,0],["والعنبر الرطب غدا قائلا","لا تدعني إلا بياعبدها",31,"ه",2,0],["والعنْ صَدى عمرِ بن سع","دٍ والملمّعِ بالنقيّهْ",32,"ي",2,0],["والعندليب امامه","ينضج نغمته ببادي",33,"د",2,0],["والعنكبوت مسدّي","بين الميم واليال",34,"ل",1,0],["وَالعَنكَبوت خَيَّمت في قَصر","مِن حصة الظهر لِبَعدِ العَصرِ",35,"ر",1,0],["وَالعَنكَبوت اِرتَضت المُبادَلَه","وَأَبت النِزاعَ وَالمُجادَلَه",35,"ه",1,0],["وَالعَنْدَلِيبْ يَخْتِمْ تَبَارَكْ مَا أحْلاَه","حينَ قامْ على كُرْسي قَضيبُو وَأنْشَدْ",36,"د",1,0],["وألْعَنُ الأدْلَمَ إذ لم تزل","صهاكة فيما مضى تزني",37,"ن",2,0],["واْلعنْ إلهى من يَرَى الإباحهْ","بِلَعْنَةٍ فاضحَةٍ مُجْتاحَه",38,"ه",1,0],["والعن إلهى غَالياً وقَالياً","ولا تذَرْ في الأرْض مِنّهُم باقيا",38,"ي",2,0],["والعنف للمركوب في اقدامه","يوم الوغى لا في الرُّواء المبهج",39,"ج",1,0],["والعنكبوت بنت كذاك غزالة","شكت الذي قد نالها لك سيدي",40,"د",2,0],["والعنكبوت بنسج قد وقته وابدت","ضرها ظبية في حالة النقم",41,"م",1,0],["والعنكبوت بأعلى الغار قد نسجت","مع الحمام وكانت قبل لم تحم",42,"م",1,0],["والعَن رجالاً أهرقوا دمه","سرّاً فأصبح سرهم علنا",43,"ن",2,0],["والعنكبوتُ أجادت حوك حلّتها","فما تخال خلال النسج من خلَل",44,"ل",1,0],["والعنكبوت لها ني نصره عمل","عن درك آياته جفن الضلال عمى",45,"م",2,0],["والعنكبوتُ حَمَته والحمامُ غدت","تحومُ حول حمى غارٍ به وغَروا",46,"ر",3,0],["والعنب البارد أضحى به","ما بين سوداء وبيضاء",47,"ا",2,0],["والعنكبوتُ بنتْ بيتاً لتسكنه","والروم تهدمه وقتاً وتبنيه",48,"ي",2,0],["والعنبر الهنديّ والرند الذك","ي ونفحةُ الحنوات بالاسحار",49,"ر",1,0],["والعَنهُمُ لَعناً كَبيراً واغزُهُم","بِعَسَاكِرِ التَّعطِيلِ غَيرَ جَبَانِ",50,"ن",1,0],["والعنبري الذي بوالده","سوّار في الناس يضرب المثل",51,"ل",1,0],["والعندليب بلحنه للغصنِ","أصبح يستميل",52,"ل",1,0],["وَاِلعَن إِلَهي عَضَلاً وَالقارَة","هُم كَلَّفونا ثِقَلَ الحِجارَة",53,"ه",1,0],["وَالعَنكبوت بِباب الغارِ قَد نسجت","حَتّى كَأنَّ رِداءً مِنهُ مَسدولُ",54,"ل",1,0],["والعِنبُ الحلْو له تركيب","أربعة يَفْصِلها الطبيبُ",55,"ب",1,0],["والعنايات لا حظتني وقالت","لي أبشر بخير حظ وحظوه",56,"و",2,0],["والعنكبوت نسيجها في غاره","ونواظر الكفار عنه تعمت",57,"ت",1,0],["وَالعَناقيدُ تَدَلّت","كَثرَيَّاتِ الذَّهَب",58,"ب",1,0],["وَالعَنهُ شَيخاً وَكَهلاً وَاِجفُهُ حَدَثاً","وَنِكهُ طِفلاً وَلَو أَلفَيتَهُ عَلَقَه",59,"ق",2,0],["وَالعَن زَنادِقَةَ الجَهالَةِ انَّهُم","آعناقُهم غُلَّت إِلى الأَذقانِ",60,"ن",1,0],["والعنكبوت مع الورقاء قد نسجا","بالغار بيتا وعشا حصنا غاره",61,"ر",2,0],["وَالعَندليبُ مغرّدٌ في دَوحِها","وَاتى الهزارُ مبشراً لحمامها",62,"م",3,0],["وَالعَندَليبُ مغرّدٌ","وَالليث اصبحَ يزأرُ",63,"ر",1,0],["وَالعَنبَر المَشهود وافَق صونَها","وَشُؤنَه تَتلى بِكُل كِتاب",64,"ب",1,0],["والعنكبوت بغاره","نسجت وعششت الحمامه",65,"م",2,0],["والعَنُودُ الكَنُودُ ذو الغِشِّ غشّا","هُ رِداءَ الرَّدى عناءُ العنادِ",66,"د",1,0],["وَالعَنْكَبُوتُ كَسَتْهُ نَسْجَها حُلَلاَ","فَالقَوْمُ مِن حَيْرَةٍ ضَلُّوا بِها السُبُلاَ",67,"ل",2,0],["والعناقيد في المشانق تحت ال","كرم قد أشرجوا عليها حصونه",68,"ن",2,0],["والعنق عانق هامة العز قاويها","اليا انثرت سود الجدايل على متونه",69,"ن",2,0],["والعَنُوا الحَربَ إنها","تشعر اليوم باستِيَا..",7