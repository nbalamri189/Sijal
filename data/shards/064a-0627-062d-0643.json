{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[119,"إليك ربكان أرباب الفحول سعت","https://www.aldiwan.net/poem42179.html","البسيط"],[382,"قد أومضت حكمة الإنجيل عن رسل","https://www.aldiwan.net/poem59236.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53920","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25347","الرجز"],[2265,"","https://poetry.dctabudhabi.ae/diwan/poem/142691","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91729","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205935","الرمل"],[4755,"رُوحِي ببَعضِ الصَّمتِ طَمَّاعَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184078",""],[3271,"عاهل الريف الثور","https://www.poetsgate.com/ViewPoem.aspx?id=104127",""],[5082,"دفءٌ وندى/ إلى أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=212473",""],[5264,"حقك يا شعب الحرق بجاز","https://www.poetsgate.com/ViewPoem.aspx?id=121866",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[6008,"من الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=60806",""]],"verses":[["يَا حَكِيماً عَلَى الحَدَاثَةِ فِي السِّ","نِّ تَقَدَّمْتَ سُنَّةَ الحُكَمَاءِ",0,"ا",2,0],["يا حكمة الأمر في كل الأمور وعن","واناً بديعاً به الأسرار قد جمعت",1,"ت",1,0],["يا حكمةَ اللَه ما أغناكَ عن بشرٍ","لو يعقلونكَ ما كان الهدى ظنّا",2,"ن",2,0],["يا حكماً يَعدلُ إذ يَحكمُ","إلى متى مُضناكَ لا تَرْحَمُ",3,"م",1,1],["يا حكم الحكما اكشف ما عترى بصري","بجاه طه الرضا يا أحكم الحكما",4,"م",2,0],["يا حَكَمُ الوارِثَ مِنْ عَبْدِ المَلِكْ","مِيراث أَحْسابٍ وَجُودٍ مُنْسَفِكْ",5,"ك",1,0],["يا حكيما أفكاره كالشموس","جزت في الطب فضل جالينوس",6,"س",1,1],["يا حكمة فرّقت بَيني وَبينهمُ","طُولي فَللمرء من أَيامه دولُ",7,"ل",1,0],["يا حكيمي وعليمي والذي","يعرف الأسرار عرفانًا شديدا",8,"د",2,1],["يا حِكمَةَ التَّقوِيمِ رُوحِي إِلى","غَيرِ الذي تَحكِينَ نَزَّاعَةُ",9,"ع",2,0],["يا حكمةً في روقكَ العاني ! كبا","في العقل ناهِضُها وطاش سديدُها",10,"د",3,0],["يا حكمةَ الأجيالِ كوني صوتَها","ثم اشهدي ما سرّني برحابها",11,"ب",3,0],["يا حكومه جبتى لى الكافيه - وموت بلا قافيه","وأدينا عايشين بالعافيه -- والعيشه مرار",12,"ر",1,0],["يا حكمةَ الله كم ساوت بمنطقها","بين العَييِّ وبين الحاذقِ الأربِ",13,"ب",1,0],["ياحك قرن بقرن وشد السياجي","خيالت ٍ يوم الملاقى عنيده",14,"د",2,0]]}