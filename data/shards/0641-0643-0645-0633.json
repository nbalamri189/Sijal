"الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72445","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139728",""],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124665","البسيط"],[408,"هي الدنيا وأنت بها خبير","https://www.poetsgate.com/ViewPoem.aspx?id=6956",""],[4834,"يا طالب الرزق لا تسع فإن لنا","https://www.poetsgate.com/ViewPoem.aspx?id=170958",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[4927,"الْحُبُّ دَيْنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=29619",""],[4927,"لُجَّةُ الأَحْزَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=29830",""],[4978,"تشطير أغنية حب","https://www.poetsgate.com/ViewPoem.aspx?id=177264",""],[5038,"تراتيل وموّال","https://www.poetsgate.com/ViewPoem.aspx?id=189578",""],[5050,"خير الرجال فتى في الهول قد ثبتا","https://www.poetsgate.com/ViewPoem.aspx?id=38203",""],[5074,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=175382",""],[5092,"جفاء","https://www.poetsgate.com/ViewPoem.aspx?id=182904",""],[5111,"غَفْوةُ الْحَلاجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212222",""],[5112,"فما الجوعين","https://www.poetsgate.com/ViewPoem.aspx?id=212832",""],[5136,"يا شمس أفق سما المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=121560",""],[5183,"عُمان","https://www.poetsgate.com/ViewPoem.aspx?id=186489",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5425,"بَغداد .. حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=199911",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5582,"قِفا بِمُقامٍ لِلأَحِبَّةِ ماصِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=63481",""],[5596,"نهضة عمان","https://www.poetsgate.com/ViewPoem.aspx?id=206777",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[5689,"انا عربي لا جنس أمجد من جنسي","https://www.poetsgate.com/ViewPoem.aspx?id=143432",""],[5736,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=203905",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5912,"عمر رضي الله عنه","https://www.poetsgate.com/ViewPoem.aspx?id=205012",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[6093,"هبوا إلى السيف ( البسيط )","https://www.poetsgate.com/ViewPoem.aspx?id=176038",""],[6127,"القلب قد وافاك","https://www.poetsgate.com/ViewPoem.aspx?id=191277",""]],"verses":[["فكم سرتَ محمودَ المسيرِ مهنأً","وعدتَ فكان العودُ أهنى وأحمدا",0,"د",2,0],["فكم سائلٍ لك أغنيتَه","وأوطانه غير أوطانكا",1,"ك",2,0],["فَكَم سَبِطٍ مِنهُم إِذا اِختَبَرَ اِمرُؤٌ","عُلالَتُهُ أَلفاهُ ذا خُلُقٍ جَعدِ",2,"د",1,0],["فَكَم سَخِطَ الأَنامُ وَأَنتَ راضٍ","وَكَم رَخُصَ المِلاحُ وَأَنتَ غالي",3,"ل",2,0],["فكم سجا الليلُ إِلا هامسٌ قَلِقٌ","كأنه نَفَسٌ في الليلِ مَشَّاءُ",4,"ا",2,0],["فَكَم سَلِمَ الجَهولُ مِنَ المَنايا","وَعوجِلَ بِالحِمامِ الفَيلَسوفُ",5,"ف",1,0],["فَكَمْ سَخِنَتْ بِالأَمْسِ عَيْنٌ قريرَةٌ","وَقَرَّتْ عُيُونٌ دَمعُهَا الْيوْمَ سَاكبُ",6,"ب",1,0],["فَكَمْ سَمَلُوا عَيْنَاً بِهَا تُبْصَرُ الْعُلا","وَشَلُّوا يَداً كَانَتْ بِهَا رَايَةُ النَّصْرِ",7,"ر",1,0],["فكم سال جفن كان في الخطب جامدًا","وكم ذاب قلب كان كالصخر قاسيا",8,"ي",2,0],["فكم سيف باغ حز أوداج دينه","بأفظع مما سيف ذي الشرك باخع",9,"ع",1,0],["فكم سيف باغ ز أوداج دينه","بأفظع مما سيف ذي الشرك باخع",10,"ع",1,0],["فَكَم سَهِرُوا اللَّيَالِى بِالغَواني","وكَم بِالدَّرسِ قَد سَهِرُوا اللَّيَالِى",11,"ل",2,0],["فَكَم سُنَّةٍ مَأثورَةٍ سَنَّ في النَدى","وَكَم غارَةٍ شَعواءَ في مالِهِ شَنّا",12,"ن",2,0],["فَكَم سارَ لي في مَدحِكُم مِن غَريبَةٍ","تَروقُ وَأَغلى الشِعرِ مَهراً غَرائِبُهْ",13,"ب",2,0],["فكم سبابٍ بينَ أهلِ الهوى","يكونُ تنبيهاً إلى الصلحِ",14,"ح",1,0],["فكم سَرَيْت إلى الأَعداءِ إذْ جَنَبُوا","وكم غدوتَ رَبيطَ الجَأشِ إذ فَشِلوا",15,"ل",3,0],["فكم سُفِكت منا دماءٌ بريئةٌ","من الحقِّ ليست للأمانِ تُريدُ",16,"د",1,0],["فكم سُفِكت منا دماءٌ بريئةٌ","وكم ضمنت تلك الدماءَ لحودُ",17,"د",1,0],["فكم سرقت من شذاكِ الصَّبا","وكم سرقت من سناكِ الحدَق",18,"ق",1,0],["فكم سيِّدٍ في قومهِ كان دوحةً","عَليها وكورٌ للنسورِ ومرقد",19,"د",1,0],["فكم سفكتم دمي وَدمعي","أَما عَلى القاتل الضمان",20,"ن",1,0],["فَكَم سمح الهوى بدمي وَدَمعي","وَكلفني بكم وَلَها وشاقا",21,"ق",2,0],["فَكَم ساغِبٍ ثَمَّ بَوَّأتَهُ","ضُروعَ المُنى حُفَّلاً فَاِمتَراها",22,"ا",3,0],["فَكَم سفهت عليكَ حلومُ قومٍ","فكنت البَدرَ تنبحُه الكِلابُ",23,"ب",1,0],["فكم سيدٍ مَرَّتْ رواحلُ عمرِه","بستين عاماً واستزادتْ ثمانيا",24,"ي",2,0],["فَكَم سَبحت بِالدَمع عَينٌ وَمُقلَةٌ","سبوحٌ لَها مِنها عَلَيها شَواهدُ",25,"د",1,0],["فكم سَبَكَت أطلالُه ثم قَدَّست","نفوساً بنفسي قُدْسُ تلك السبائك",26,"ك",1,0],["فكم سفكت فيهم نفوسٌ دماءها","فطوبى لمسفوكٍ وطوبى لسافك",26,"ك",1,0],["فكم سلكوا عليه","لنا سادات قادات",27,"ت",1,0],["فكَمْ سارتْ عليها مِن ملوكٍ","كأنّهمو علها لَمْ يسيروا",28,"ر",3,0],["فكم سَلَّ من كَرْبٍ وأنْقَذَ من عَمىً","وَروَّح من رُوحٍ ونفَّسَ من نَفْسِ",29,"س",1,0],["فكم سخطٍ على الدنيا وصدٍّ","عن الدولات وهي على الترضِّي",30,"ض",2,0],["فكم سد من ثغر وشيدت به على","وشد به ركن وصد به جهل",31,"ل",1,0],["فَكَم سَلَّطَ السِلَّ مِن مِطلِهِ","فَأَضنى بِهِ جَسَدَ المَوعِدِ",32,"د",1,0],["فكم سكبتُ على الأطلالِ مِن كَمَدٍ","دمعاً ألثَّ على تربٍ وأحجارِ",33,"ر",1,0],["فكم سعى فيهِ من صبٍّ فأهلكهُ","فقلت والشوق داعي البين حرَّكهُ",34,"ه",1,0],["فكم سَبَبٍ لهنّ إلى العطايا","وكم بابٍ لهنّ إلى الجِنانِ",35,"ن",1,0],["فَكَم سَكَنَ الدُنيا مُلوكٌ أَعِزَّةٌ","تَفانَوا فَلَم تَستَبِقِ مِنهُم لَها سَكَن",36,"ن",1,0],["فكم سَلَّ لمَّا سُلَّ من بطْنِ غِمدِه","لسانَ دَم من ضَرْبَةٍ خَلَقَتْ فَمَا",37,"م",2,0],["فكم سلَّ من صارمٍ مُغْمدٍ","وكم أَغمدَ الصَّارمَ الْمُنتَضى",38,"ض",2,0],["فَكَم سَكرَةٍ لِلمَوتِ يَمزُجُ كَأسها","لِحاسي الغَرام العارِضُ المُتَهَلِّلُ",39,"ل",1,0],["فَكَم سَحابة عَلى العُيون","أَزلتها بِأَحسَن الفُنون",40,"ن",1,0],["فَكَم سوّدتُ بِالبُهتان وَجهاً","يُضيء بِمَدح مصباح الظَلام",41,"م",1,0],["فكم سرى تحت ليل النقع مستتراً","له من السيف مصباح يسايره",42,"ر",2,0],["فكم ستر لغرس الدين سارت","عن العافين من شكر وحمد",43,"د",1,0],["فكم سمعوا الامام وكم أطاعوا","وكم نصحوا لهُ سِرّاً وجهرا",44,"ر",2,0],["فَكم سَفكت منّي غداة النوى دماً","وَكَم أَوسعت جرحاً لها في الجوارحِ",45,"ح",1,0],["فَكَمْ سَكْرَةٍ ليَ قَبْلَ الأَذا","نِ بَيْنَ دَواليبِهِ والدَّوالي",46,"ل",2,0],["فكم سم على مضض وغين","وكم في الدهر قد ترى عين عابر",47,"ر",1,0],["فكم سيد بين الغيابات حتفه","وآخر بالأصفاد والسوط مرهق",48,"ق",1,0],["فكم ساق من مصرٍ إلى الموت فتيةً","زهاها الصبا في عنفوان وريق",48,"ق",1,0],["فَكم سيلانٍ من أَخيه رَمى بِهِ","إِلَيَّ فكان السمَّ في جَسدي يَسري",49,"ر",2,0],["فكم سكرنا ولم نشرب بكأس طلا","وكم طربنا ولم نضرب باوتار",50,"ر",1,0],["فَكَم سفيه أَتاه اللَه من حيث لَم","يدر العَذاب ومكر اللَه محذور",51,"ر",1,0],["فَكَم سخطتَ عَلى من كانَ شيمته","وَقَد أَبحتَ له قبلَ الحِمامِ رِضا",52,"ض",2,0],["فكم سح في ساحاتها سيح عبرتي","ونظم جزع الدمع في جزعه عقدا",53,"د",2,0],["فكم سرت من حلة ابن مَزْيَدٍ","تنشقني بالشام مسكاً أذفرا",54,"ر",2,0],["فكم سهَّلْت لي صعباً منيعاً","وكم قربت لي أملاً بعيدا",55,"د",2,0],["فكم سَعَةٍ وافت على حين شدّةٍ","وقد يُرْتَجَى بعد الغروب طُلُوعُ",56,"ع",1,0],["فكم سبحت فلك المنى في بحارها","فاليوم استوت بي على الجودِي",57,"ي",1,1],["فكم سائل عنه تسيل مدامعي","بتذكاره وكفا كما يكف القطر",58,"ر",1,0],["فكم سعد بي بلطف اللَه من خلق","تبارك اللَه كم يسعد وكم يشقى",59,"ق",2,0],["فَكَم سَنَةٍ سَئِمتُكَ شَهرَ مايو","فَقُل لي كَم بقَينَ عَلى اِرتِحالي",60,"ل",2,0],["فَكَم سَمَحَ الهوى بِدَمي وَدَمعي","جَزاءً في الصَبابةِ لي وِفاقا",61,"ق",2,0],["فَكَم سَهرت مِن دونها أَعيُن لَهُم","حذاراً عَلَيها أَن يَقوم بِها ذعر",62,"ر",1,0],["فكم سقت راحتاه عسكرا وشفت","وفرحت كبدا إذ فرجت كربا",63,"ب",2,0],["فكم سُورةٍ أضحتْ بكل غريبةٍ","عَلَى الخَلْق تُتلى والزمانُ يُترجِم",64,"م",1,0],["فكم سهِرتُ الليالي","أشكو إِلَيكَ هَوايا",65,"ا",3,0],["فَكَم سَلَّت عَليّ بَنات دَهري","صفاحاً لَم تصافحها العُيونُ",66,"ن",1,0],["فَكَم سابِقاً محضتهُ الود راغِباً","وَلَم نَستَمِع في العَذل يَوماً مُشاغِباً",67,"ب",2,0],["فَكَم ساقَ بَحثاً في الفُنونِ مطوَّلا","وَكَم خاضَ بَحراً في العُلومِ عَميقاً",68,"ق",2,0],["فَكَم سارَت الرُكبانُ تَشدو بِذِكرِهِ","وَغنى بِهِ الراوي إِلى الظَعن حادِيا",69,"ي",2,0],["فكم سرٍ يذاع بها وزرٍ","يحل له وكم كمٍ يفتق",70,"ق",1,0],["فكم سلكت طريقاً في الهوى خطراً","وقد علمت بلوغ الأمن في الثاني",71,"ن",2,0],["فَكَم ساعَدتكُم عَن فعلِ فَحشٍ","وَإِن تَدعو لحادثةٍ أَجيبُ",72,"ب",1,0],["فكم سقيت بها العاني كؤوس منى","ممزوجة بالهنا سقيا لسقياك",73,"ك",1,0],["فكم سَهَّدتْ من مجتلى سَهر الحِجا","ببدرٍ على غصنٍ وغصنٍ على دِعص",74,"ص",1,0],["فَكَم سَرى لشاطئ البَحرِ بِنا","عَزمٌ جَلا هَمَّ النُفُوسِ وَسَرا",75,"ا",1,0],["فكم سرا عنهُ الهُمومَ من سرا","وكم تداوى مِن هوىً من ادوى",75,"ا",1,0],["فَكَم سَرَى رَكبٌ مُخِفٌّ نَحوَهُ","وَآبَ عَنهُ مُثقلاً بِما سَرَى",75,"ا",1,0],["فَكَمْ سَهَرْتُ اللَّيالي في العُكُوفِ عَلى","ما لَيْسَ يَنْفَعُ لا عِلْمَاً وَلا عَمَلاَ",76,"ل",2,0],["فكم سائر فيهِ ينام بساحلٍ","ويصحو على الشط الذي هو طالبه",77,"ب",2,0],["فكمْ ساكنٍ بالأمس قصراً ثوى بها","فأضْحَى دفيناً تحت عَفْرِ ترابها",78,"ب",3,0],["فكم سهم تفوَّقه المنايا","فتصمى من كلى المجد الصميما",79,"م",2,0],["فكم سَحَب السحاب بهنَّ ذيلاً","وكم أخملنَ من بعد الخمول",80,"ل",1,0],["فكم سقيت بها راحا معتقة","من راح ذي غيد رقت شمائله",81,"ل",2,0],["فكم سارت عليها من ملوك","كأنهمو عليها لم يسيروا",82,"ر",3,0],["فكم سعيت فأعياني تطلبه","وكم قعدت فيأتيني بلا طلب",83,"ب",1,0],["فكم سلوة للعشق ضيّعها النوى","إذا ما بلاك الجدّ حصنك القهر ُ",84,"ر",1,0],["فَكَمْ سُلِقَتْ فَتَاْةٌ دُوْنَ ذَنْبٍ","وَحَاْصَرَهَاْ مِنَ الآلاْمِ بَيْنُ",85,"ن",1,0],["فَكَمْ سَرَيْتُº وَ لَمْ أَعْبَأْ بِعَاْشِقَةٍ","نَاْحَتْ نُوَاْحاً يُحَاْكِيْ رَنَّةَ الْوَتَرِ",86,"ر",1,0],["(فكم سهرت الليالي تعتنين وكم )","باتت تُهَدهِدُنِي فِي اللّيلِ يُمنَاكِ",87,"ك",1,0],["فكمْ سُرّوا به يوماً","ويوماً غيرُهمْ كالوا",88,"ل",3,0],["فكم سموت أخي حلم وذي أدب","يبيت منتصبا في ليلة قنتا",89,"ت",2,0],["فَكَمْ سَلَبَتْ لُبِّي بِفِتنَةِ جِيْدِهَا","وفي عُنُقِ الحَسنَاءِ يُستَحْسَنُ الدُّرُّ",90,"ر",1,0],["فكم سعدت همومٌ في التلافي","ويحزنُ في الهوى يا صحْبُ سعدُ",91,"د",1,0],["فَكَمْ سَرَتْ مُهُجُ التَّحْنَانِ تُغْمِرُنِيْ","وَكَمْ تَحِنُّ إِلَى أوْصَافِهَا الصُّوَرُ",92,"ر",1,0],["فَكَمْ سُبَلًا عَبَرْتَ بِهَا كَلَالَا","وعَمْرُكَ حِجْرُ أَرْوِقَةٍ وَرِيفُ",93,"ف",1,0],["فكم سرور إلى القلب الولي سرى","وكم عدو شجى القلب مكبود",94,"د",1,0],["فكم سهام على لباتها اشتبكت","شقت بها دربها والكيد صوّال",95,"ل",1,0],["فكم سننٍ أحيا وكم بدعٍ نفى","وكم مشهد قد شيد أوهاه بالهد",96,"د",1,0],["فكمْ سُعدْنا بمَنْ قد حَلّلوا دمَنا","وكمْ لثمْنا غباءً كفّ من زَلّوا",97,"ل",3,0],["فَكَمْ سَطَعتِ جَمَالاً شَاقَ مُغْتَرِبَاً","وَكَمْ شَجَوتِ بِلَحنِ الشَوقِ أَفْواهَا",98,"ا",3,0],["فَكَمْ سارَ فِي نَهْجِ الغَرامِ بِسائِقٍ","أَخُو لَوْعَةٍ مِنْ قَبْلِ هذَا وَقائِدِ",99,"د",1,0],["فَكَمْ سَفَكَتْ مِنِّي غَداةَ النَّوَى دَماً","وَكَمْ أَوْسَعَتْ جُرْحاً لَها فِي جَوارِحِي",100,"ح",2,0],["فكم سرتِ بالشورى صراطاً ومنهجاً","وبالعدل ميزاناً وسيفاً له عضبا",101,"ب",2,0],["فَكَمْ سَوْطٍ عَلَى الظَّهْرِ الْ","جَرِيحِ كَأَنَّهُ الْجَمْرُ!",102,"ر",1,0],["فكم سبح الأمواج باسم شراعنا","وذلت له الهوجاء في السبح والعس",103,"س",1,0],["فكم سطرتُ جروحي ألفَ قافيةٍ","وكم نظمتُ هيامي عقدَ ألماسِ",104,"س",1,0],["فكم سبقت في الأقدمين مفاخر","لهم وسيادات وأفضل بيعةِ",105,"ه",1,0],["فكم سريتَ إلى صوتِ العُفاةِ بها","ليلاً ودمعكَ فوقَ الثوبِ ينهمرُ",106,"ر",1,0],["فكم سوف آلَفُ شخصاً لأنَّ","تشابُهَهُ معهم ما يزالُ...",107,"ل",1,0],["فكم سجدنا على أعتاب لندنهم","وكم بكينا دَماً في ساحِ برلينا",108,"ن",2,0],["فكم سيدي ليلاً أطيلَنْ فيقصُرَنْ","وما كان ليلي قبل حبك يُسهدُ",109,"د",1,0]]}