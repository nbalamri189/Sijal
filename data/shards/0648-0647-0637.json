{"poems":[[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21467","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[4929,"إبقي وثاقي مُحكماً","https://www.poetsgate.com/ViewPoem.aspx?id=200429",""],[5376,"وهل للهجر قرب ما أنابا","https://www.poetsgate.com/ViewPoem.aspx?id=189753",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""]],"verses":[["وَهِطالُ أَشتيةٍ يَعودُ عَليهما","هَبواتُها وَعجاجُها المزعوقُ",0,"ق",1,0],["وهطلت لموتهِ المدامعُ","كأنها السحائب الهوامعُ",1,"ع",1,0],["وَهَطُورُ نَحوَ البَرَاحِ اتجَه","وصاحَ أَجًندَ الطَّرَاوِد مَه",2,"ه",1,0],["وَهَطُورُ نَحوَ النَّهرِ ساقَ جُيُوشَهُ","بَعِيداً عَنِ الفُلكِ العِظامِ مَضَى بِها",3,"ه",2,0],["وهطولُ صوتِكِ مُفْعَماً بحنانه","في القلب من أوجاعِه يُشفيهِ",4,"ي",2,0],["وهطل من عيون لا تبالي","تضاهي في عطاياها السحابا",5,"ب",2,0],["وَ هَطَلْتَ بَعْدَ تَمَنُّعٍ فَغَمَرْتَنِي","سُبْحانَ مَنْ - رَغْمًا - بِأَرْضِيَ أَهْطَلَكْ",6,"ك",1,0]]}