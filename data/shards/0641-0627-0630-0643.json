om/ViewPoem.aspx?id=200663",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[1059,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.poetsgate.com/ViewPoem.aspx?id=108380",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[243,"أذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=50491",""],[5798,"رحلتِ","https://www.poetsgate.com/ViewPoem.aspx?id=138931",""],[5910,"فلطالما حاربتُ ذا سفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207125",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""],[6152,"يارب خيرة","https://www.poetsgate.com/ViewPoem.aspx?id=202759",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6198,"القرط الأزرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79237&r=&rc=11",""],[2220,"أشهد في خالقي بجوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11894&r=&rc=763",""]],"verses":[["فاذْكُرْ مُصابَكَ بابنِ عمّكَ أحْمَدٍ","والغُرِّ منْ آبائِكَ الأخْيارِ",0,"ر",1,0],["فأذْكَرَنا مَثْواهُ بالجنّةِ التي","وِعِدْنا بِها واللهُ مُنْجِزُ وَعْدِهِ",1,"د",2,0],["فاذْكُرْهُمَا وتَرَحَّمْ كُلَّما ذَكَرُوا","أعاظِماً أَلِّهُوا في الكونِ تأليها",2,"ي",3,0],["فاذْكُرْهُ إن الذكرَ منك سعادةٌ","وبها على كل النام قد افتخرْ",3,"ر",1,0],["فأذكر أولي الآداب من غير الألى","في مصر يغضب منك أهل جنابها",4,"ب",3,0],["فَاِذكُراني وَكَيفَ لاتَذكُراني","كُلَّما اِستَخوَنَ الصَديقُ الصَديقا",5,"ق",2,0],["فأُذكِرُ تارةً أخرى","بنفسي غيرَ مُتَّئبِ",6,"ب",1,0],["فاذكُرِ الوعدَ فهْو كالعهد والإخ","لافُ كالنَّكْثِ وهو بسْلٌ حرامُ",7,"م",1,0],["فَاِذكُريهِ مَعَ البُروقِ السَواري","وَاِندُبيهِ مَعَ الغُيوثِ الهَتونَه",8,"ن",2,0],["فَاِذكُر أَميرَ المُؤمِنينَ بَلاءَهُ","وَاِستَبقِهِ إِنَّ السُيوفَ قَليلُ",9,"ل",1,0],["فَاِذكُروا يَومَ مَشيبٍ","فيهِ تَبكونَ الشَبابا",10,"ب",2,0],["فَاِذكَر أَرامِلَ لا عَطاءَ لَها","وَمُسَجَّنينَ لِمَوضِعَ الأَجرِ",11,"ر",1,0],["فَاِذكُر ثَموداً وَعاداً أَينَ أَينَ هُمُ","لَو أَنَّ قَوماً بَقوا مِن قَبلِهِم لَبَقوا",12,"ق",3,0],["فاذكرِ العهدَ واحتفلْ بصديقٍ","حسَّنَ الظنَّ فيكَ لا خابَ ظنا",13,"ن",2,0],["فَاِذكُرِ العَهدَ بِالمُحَصَّبِ وَالوُد","دَ الَّذي كانَ بَينَنا ثُمَّ خُنتا",14,"ت",2,0],["فَأَذكَرَنا لَيلَةً بِاللِوى","وَعَهداً بِعَصرِ الصِبا أَطرَبا",15,"ب",2,0],["فَاِذكُر سَبيلَكَ إِن تَصَرَّمَ عَهدُهُ","وَجَرى لِغايَتِهِ الزَمانُ القُلَّبُ",16,"ب",1,0],["فأذكرتني ما قال عاشقُ خِلَّةٍ","بَرى جسمَه هجرانُها وصدودُها",17,"د",3,0],["فَاِذكُر صَباحَ العُقارِ وَاِسمُ بِهِ","لا بِصَباحِ الحُروبِ وَالعَطَبِ",18,"ب",1,0],["فَاِذكُري لَيلَةَ الخَمي","سِ لِساني المُلَجلِجِ",19,"ج",1,0],["فَاِذكُري وُدَّنا وَذوقي سِوانا","تَذكُرينا وَتَندَمي ما بَقيتِ",20,"ت",1,0],["فَاِذكُريني ذُكِرتِ في ظُلَّةِ العَر","شِ بِخَيرٍ تُفَرِّجي بَعضَ كَربي",21,"ب",2,0],["فَاِذكُري حَلفَتي أَقارِفُ أُخرى","يَومَ زَكّى تِلكَ اليَمينَ البُكاءُ",22,"ا",2,0],["فَاِذكُري وَأيَهُ عَلَيكِ وَجودي","حَسبُكِ الوَأيُ قادِحاً في السَخاءِ",23,"ا",2,0],["فَاذكُر مَسَاعِيَ أَقوَامٍ فَخَرتَ بِهِم","وَلاَ تَدَعهُم مِنَ الأَسماءِ أَغفالا",24,"ل",2,0],["فاذكروه على الليالي إذا ما","زحمَ الدهرُ ركنَكم وتألَّبْ",25,"ب",1,0],["فاذكروا شدوهُ بكل صباحٍ","وارقبوا من خياله إلمامَه",26,"م",2,0],["فاذكروا نهضةَ البيان بأرضٍ","أطلعتْ في سمائها أعلامَه",26,"م",2,0],["فاذكري في الغد أحباباً كراما","إنْ ألمَّت بك ذكراها لماما",27,"م",2,0],["فاذكريهم بالذي مرّ بهم","واقرئي تاريخهم ثم أعيدي",28,"د",2,0],["فاذكري الآن يا شواطئُ عيناً","شيَّعَتْ بالبكاءِ كلَّ سفينه",29,"ن",2,0],["فَأذْكُرْ لَهُ حُسْن الْبَلاَءِ وَقَدْ دَعَا","دَاعِي الوَلاَءِ إِلى جَلِيلِ فِعالِ",30,"ل",1,0],["فأذكى هنا جمرات السهاد","وأعطى هناك الرؤى والخدر",31,"ر",1,0],["فأذكر منزلنا في دمشق","ولثغة بركته الصافية",32,"ي",2,0],["فاذكرِ العهدَ بالمحصبِ، والو","دِّ الذي كان بيننا، ثمّ خنتا",33,"ت",2,0],["فَاذْكُرْ حِكاياتٍ بِأَيَّامِ الصِّبا","قَدْ قُلْتَها لي عَنْ هَوى الأوْطانِ",34,"ن",1,0],["فاذكروا نهضة البيان بأرض","أطلعت في سمائه أعلامه",35,"م",2,0],["فاذكر وصلا حكمه حكم غيبة","بلذة ذاك القرب من طلعة الحب",36,"ب",1,0],["فاذكري مني وداداً خالصاً","لا تغيّره تصاريف السنين",37,"ن",1,0],["فأذكَى النَّوى مُنثَلِماً وأغلَى","لَظَى زَفَرَاتِه فَبَكَى بُكَاءَ",38,"ا",2,0],["فَاِذكُر أَميرَ المُؤمِنينَ بِمَدحَةٍ","إِنَّ الوَليدَ لَهُ عَلَيَّ فُضولُ",39,"ل",1,0],["فَاِذكُري ذلِكَ وَالدَمعَ الَّذي","قَد ذرَفناهُ بِشَوقٍ وَحنين",40,"ن",1,0],["فَأَذكَرَني وُجوهَ الغيدِ بيضاً","سَوالِفُها وَلَم أَكُ بِالنَسِيِّ",41,"ي",1,0],["فأذكرَني به التفعيلُ بَيتاً","تضمَّنَ نصفَهُ الشَيخُ المَعَرِّى",42,"ر",2,0],["فاذكرننا متبسِّماتٍ في الدُّجى","فثغورُكنَّ كواكبُ السَّارينا",43,"ن",2,0],["فإذ كُنتَ جُندياً تحكّمتَ بالورى","تُحارِبُ مِنهم مَن طَغى وتُخاصِم",44,"م",1,0],["فاذكر أَبا القاسم الخاظى عبيدك في","تلك المَساكن كم من خائف أمنا",45,"ن",2,0],["فاذكرْ فتاك كذكراه لعهدِكمُ","عسى تخفف عنه بعضَ ما يجدُ",46,"د",1,0],["فاذْكُرْ إذَنْ خُططاً أظلّتْ وانجلَتْ","واشكُرْ إذَنْ نُعْمَى وَهوبٍ مُجْزِل",47,"ل",1,0],["فأَذكرُوني حُرماتٍ لهُ","أوكدُ منها حُرمةُ الشهرِ",48,"ر",1,0],["فَأذكُر بَيتَ مَن قَد قا","ل ما خَوفي مِن البَلل",49,"ل",1,0],["فاذكر الهك وفك الخلق إنس وجان","ولازم الذكر يامسكين طول الزمان",50,"ن",1,0],["فاذكروا ذاك هناك فعسى","نظرة من ربنا يحيي العظام",51,"م",1,0],["فاذكر الله دواما","لا تكن عبدا غفول",52,"ل",1,0],["فاذكر الله مدا الدهر ولا","تعدلن عنه إلى قيل وقال",53,"ل",1,0],["فاذكر للمات","واعمل ومهدلا خراك",54,"ك",1,0],["فاذكرْ أهاليكَ الذين تركتَهم","يتَجرَّعون مرارةَ الأحزان",55,"ن",1,0],["فاذكرونا مثل ذكرانا لكم","إن ذكراكم إلى النفس غذاها",56,"ا",3,0],["فاذكرونا مثل ذكرانا فما","عنكم نسهو مدى الدهر ولن",57,"ن",1,0],["فاذكر فدتك النفس مجلسنا","في الدرس تذكر كنه ما أنبي",58,"ب",2,0],["فأذكَرَ مَن لم تُنْسِهِ عَهدَهُ النَّوى","ولاَ طَمِعَتْ في يأْسِهِ ونُبُوِّهِ",59,"و",2,0],["فاذْكر من عَهد الغُوَير ليالياً","تمنَّيْتُ لو يجدي التمنّي رجوعها",60,"ع",3,0],["فاذكرونا بكتاب منكم","أنا ما زِلتُ له بالانتظار",61,"ر",1,0],["فاذكروا العهد الذي عاهدتموني","إن ودّي لكم منه الثبات",62,"ت",1,0],["فاذكرني دارا بمنعرج اللوى","نعمت بها إذ كنت واصلت تنعما",63,"م",2,0],["فاذكر بخير حلبا انها","تحفظ للأحباب عهد اغتراب",64,"ب",1,0],["فأذْكَرَني ثغرَ سُعدى وقد","تزحزح عن برقه البرقع",65,"ع",1,0],["فأَذكَى صباباتٍ تقادَمَ عهدُها","بأهلِ الحِمى حيَّ الحِمى والأجارعا",66,"ع",2,0],["فأذكرني تلك السنين التي انقضت","وقد كان فيها العمر في العد تاسعا",67,"ع",2,0],["فاذكر الله مخلصاً بخشوع","وتملل ذلا على الأعتابِ",68,"ب",1,0],["فاذْكُرْ حَديثاً جاءَ بالإِحْسانِ عن","خيرِ البَرِيَّةِ والمَحاسِنُ تُفعَلُ",69,"ل",1,0],["فاذكُرْ لهمْ تَولُّهي","ومَدمعاً كالسَّيْلِ ساحْ",70,"ح",1,0],["فاذكر عهودي إن قدمت على الحمى","فانشد فؤاداً بالأبيطح طاحا",71,"ح",2,0],["فاذكرَنْ عهدَك مِنِّي","مثلَ ذِكرِي لحِبائِك",72,"ك",1,0],["فَاِذكُر فُتوحاتِ العُقولِ بِرُشدِهِم","تَهدي لِحَقِّ العِلمِ وَالعِرفانِ",73,"ن",1,0],["فَاِذكُرْ بَلاغَتَهُ وَاِسمَعْ فصاحتَهُ","ففيهما مِن معاني اللُّطفِ صهباءُ",74,"ا",2,0],["فاذكر لمدنفها عن خبرها خيراً","فاليوم عندك من دوني بها خبر",75,"ر",1,0],["فَاِذكُر أَيادينا وَآلاءَنا","بِعَودَةٍ مِن حِلمِكَ الراشِدِ",76,"د",1,0],["فَاِذكُريها لي أَزُل عَنّا وَلا","تَسفِحي عَينَيكِ بِالدَمعِ السِجامِ",77,"م",1,0],["فأذكيت فينا لهيب الأسى","وهيجت فينا جمار الحرب",78,"ب",1,0],["فأذكيت جمراً من غراميَ محرقاً","وأجريت غيثاً من دموعي صيباً",79,"ب",2,0],["فَاِذكُريهِ فَهُوَ قَد أَش","غَلَ في ذِكراكِ لُبَّهْ",80,"ب",2,0],["فاذكر لهم صبابتي ووجدي","وقل لهم ما حالهم من بعدي",81,"د",2,0],["فاذكره وأعرض عليه نظما","لي فيه كاللؤلؤ النشيرِ",82,"ر",1,0],["فاذكرنا ذاك البعاد معاشراً","نأوا فكأنا ما ما لقيناهم قط",83,"ط",1,0],["فَإِذكُر بِلاداً وَقَوماً طالَما رَشَفت","كُؤُسَ لُطفِ علاك المُنعش العَطرِ",84,"ر",1,0],["فأَذْكَرَني بالغَضَا جِيرَةً","تَوَلَّوا وأُصْلِيتُ جَمْ