يسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[413,"قبر به سيد شريف","https://www.aldiwan.net/poem53910.html","مخلع البسيط"],[413,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[426,"عبير ثنا عبد الحميد يد الزهر","https://www.aldiwan.net/poem39902.html","الطويل"],[426,"تجلت لدينا في محاسنها مصر","https://www.aldiwan.net/poem40262.html","الطويل"],[429,"لو شاء بل بها ذيول الحندس","https://www.aldiwan.net/poem12516.html","الكامل"],[429,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[434,"صب قتيل المقلتين","https://www.aldiwan.net/poem2556.html","مجزوء الكامل"],[436,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[438,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[459,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[466,"لقد جار ما تشكوه في الحكم واعتدا","https://www.aldiwan.net/poem60213.html","الطويل"],[480,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[498,"أنت أهل المعروف يا معروف","https://www.aldiwan.net/poem37952.html","الخفيف"],[504,"قد ثبت الغي في العباد","https://www.aldiwan.net/poem2439.html","مخلع البسيط"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[512,"خر الورى حيدري عم نائله","https://www.aldiwan.net/poem20836.html","البسيط"],[512,"دهر دها قدر دارت نوائبه","https://www.aldiwan.net/poem20846.html","البسيط"],[512,"فخر الورى","https://www.aldiwan.net/poem20850.html","مجزوء الرجز"],[512,"فخر الورى حيدري عم نائله","https://www.aldiwan.net/poem20851.html","البسيط"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[560,"لعمرك ليس في الدنيا خليل","https://www.aldiwan.net/poem52737.html","الوافر"],[560,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"],[560,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[560,"قد عاهد الدهر أهليه فما غدرا","https://www.aldiwan.net/poem52874.html","البسيط"],[571,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"]],"verses":[["دَهرٌ تُؤَثِّرُ في جِسمي نَوائِبُهُ","فَما اِهتِمامي إِذا أَودى بِسِربالي",0,"ي",1,0],["دَهْرٌ تذَأّبَ مِنْ أبْنائِه نَقَدٌ","فأُوطِئَتْ عَرَبٌ أعقابَ أعْلاجِ",1,"ج",1,0],["دَهرٌ يَرى الغَدرَ مِن إِحدى طَبائِعِهِ","فَكَيفَ يَهنا بِهِ حُرٌّ يُصاحِبُهُ",2,"ب",2,0],["دَهَتني صُروفُ الدَهرِ وَاِنتَشَبَ الغَدرُ","وَمَن ذا الَّذي في الناسِ يَصفو لَهُ الدَهرُ",3,"ر",1,1],["دَهاها المَوتُ في الإِلفِ المُفَدّى","وَكَدَّرَ صَفوَها الدَهرُ الخَؤونُ",4,"ن",1,0],["دَهاهُ إِذا ماجَنَّهُ اللَيلُ أَنَّهُ","أَقامَ عَلَيهِ آخِرَ الدَهرِ سَرمَدا",5,"د",2,0],["دهى الجَزيرَة أَمرٌ لا عَزاءَ لَهُ","هَوَى لَهُ أُحُدٌ وَاِنهَدَّ ثَهلانُ",6,"ن",1,0],["دَهَتني الحادِثاتُ بِهِ فَأَمسَت","عَلَيَّ هُمومُها تَغدو وَتَسري",7,"ر",2,0],["دَهَى العُرُوبَة خَطْبٌ فَتَّ سَاعِدَهَا","مِنْ حَيْثُ لاَ يُتَّقَى بِالبَيْضِ واليَلَبِ",8,"ب",1,0],["دَهَى دِمَشْقَ بِنَارٍ مِنْهُ هَاتِكَةٍ","نَهَّاشَةِ اللُّسْنِ للأَعْرَاضِ وَالحُرَمِ",9,"م",1,0],["دَهْرٌ أَذمَّ لأَهْلِهِ وَمَلأْتِهِ","بِالمَحْمَدَاتِ فَعَادَ غَيْرُ مُذَمَّمِ",10,"م",1,0],["دَهَى فِي عَظِيمٍ يَبْدَأُ الذِّكْرُ بِاسْمِهِ","إِذَ عُدَّ في مصر الرِّجَالُ الأَعَاظمُ",11,"م",1,0],["دَهَانَا بِأَنْوَاعِ الأَذَى مُتَجَنِّباً","فَلَمْ يَكُ إِلاَّ صَارِخٌ مُتَظَلِّمُ",12,"م",1,0],["دَهاسٍ سَقَتها الدَلوَ حَتّى تَنَطَّقَت","بِنَورِ الخَزامى في التِلاعِ الجَوائِفِ",13,"ف",1,0],["دهانا لرامي الموت سهم مقرطس","نَجيفٌ بأدواء الحياة مريش",14,"ش",1,0],["دَهماءُ قَد دَجَنَت وَأَحنَقَ صُلبُها","وَأَحالَ فيها الرَضحُ وَالتَصريمُ",15,"م",1,0],["دهرٌ تولى بالصّبى فرَطاً","ومضى بمن يصبو ومن يصبي",16,"ب",2,0],["دَهَانِي منْ جفائك ما دهاني","ولم يَكُ للزَّمَان به وَعيدُ",17,"د",1,0],["دهرٌ يُشَيِّعُ سَبْتَه أحَدُهْ","متتابعٌ ما ينقضي أمَدُهْ",18,"د",2,1],["دهَّرَتْهُ جهالةٌ نصَّرته","ثم عادت عليه بالتمجيس",19,"س",1,0],["دهرٌ علا قدرُ الوضيع به","وهوى الشريف يحطُّهُ شرَفُهْ",20,"ف",2,1],["دهرٌ نهى الدهر عن جيرانِ دولتِه","فأحرم الدهرُ فيها أيَّ إحرامِ",21,"م",1,0],["دهرٌ ودُنيا تلاقِي كُلَّ مَنْ ولَدا","لديْهما بِمَحَلِّ الخَسْفِ والهُون",22,"ن",1,0],["دَهمٍ يَظَلُّ بِهِ الفَضاءُ مُعَضِّلاً","كَالطَودِ أَسوَدَ مُجفِلِ الأَثقالِ",23,"ل",1,0],["دَهاكَ الرَدى لَكِن عَلى حينِ فَجأَةٍ","فَتَبَّت يَداهُ غادِرٌ صَرَعَ النَدى",24,"د",2,0],["دَهاك وَلَم يُشفِق عَلى الصِبيَةِ الأُلى","تَرَكتُهُم يَبكونَ مَثنى وَمَوحَدا",24,"د",2,0],["دَهراً بَليداً ما يُنيلُ","وِدادَهُ إِلّا بَليد",25,"د",1,0],["دُهِشتُ حَتّى كَأَنّي لَم أَرَها","وَكِدتُ وَاللَهِ أَنسى أَن أُحَيِّها",26,"ي",3,0],["دَهَتني بِوِدٍّ قاتِلٍ وَهوَ مُتلِفي","وَكَم قَتَلَت بِالوُدِّ مَن وَدَّها دَها",27,"ه",2,0],["دهر مصائبه عندي بلا عدد","لم يجن أمثالها قبلي على أحد",28,"د",1,1],["دَهِمَتهُ تَطايِرُ الزَرَدَ المُح","كَمَ عَنهُ كَما يَطيرُ النَسيلُ",29,"ل",1,0],["دُهمٌ فَوارِسُها رُكّابُ أَبطُنِها","مَكدودَةٌ بِقَومٍ لا بِها الأَلَمُ",30,"م",1,0],["دهرٌ غريمٌ لم يُحِسَّ به","ريبٌ ولم يَفْطُنْ له خَطْبُ",31,"ب",1,0],["دَهَتكَ بِعِلَّةِ الحَمّامِ فَوزٌ","وَمالَت في الطَريقِ إِلى سَعيدِ",32,"د",1,1],["دَهيُ عودٍ ما إِن يَزالُ يُغَوّى","غَمرَةً ما يَخوضُها اِبنُ مَخاضِ",33,"ض",1,0],["دَهَمنا بِهِم بَكراً فَأَصبَحَ سَبيُهُم","تُقَسَّمُ بِالأَنهابِ فينا مَغانِمُه",34,"م",2,0],["دَهتني الليالي بعدَه ولربَّما","بَعثتُ عليها مِنه دَهياءَ صَيْلَما",35,"م",2,0],["دَهرٌ ترَفَّقَ بي فُواقاً صَرفُه","وسَطا عليَّ فكانَ غيرَ رَفيقِ",36,"ق",1,0],["دَهرٌ يُؤَمِّنُنا الخُطوبَ وَقَد نَرى","في كُلِّ ناحِيَةٍ لَهُنَّ شِباكا",37,"ك",2,0],["دَهرٌ ذَميمُ الحالَتَينِ فَما بِهِ","شيءٌ سِوى جودِ اِبنِ أُرتُقَ يُحمَدُ",38,"د",1,0],["دَهَتهُ المَنايا وَهيَ في حَدِّ سَيفِهِ","وَصَرفُ اللَيالي وَهوَ مِن بَعضِ حُبِّهِ",39,"ب",2,0],["دَهَتهُ المَنايا وَهيَ مِن دونِ بَأسِهِ","كَذا الصارِمُ الصَمصامُ يَفنيهِ مِبرَدُ",40,"د",1,0],["دُهمٍ إِذا ضَحِكَت في رَوضَةٍ طَفِقَت","عُيونُ نُوّارِها تَبكي مِنَ الفَرَحِ",41,"ح",1,0],["دهْرُنا أضحى ضنيناً","باللقا حتى ضَنينا",42,"ن",2,1],["دَهاها الخطبُ أحمرَ في نُفوسٍ","لَبسْنَ الموتَ أسودَ إذ دُهينا",43,"ن",2,0],["دَهانا مِنَ الأَقوامِ ما لَو دَها الصَفا","لَفاضَت دَماً عَن جانِبَيهِ المَذانِبُ",44,"ب",1,0],["دهمناهمو لا بل دهمنا نُفوسَنا","فهلّا علمنا أَيُّنا كان يُدهَمُ",45,"م",1,0],["دَهماءَ مِدفَأَةُ الشِتا","ءِ كَأَنَّ بِركَتها الحَظائِر",46,"ر",1,0],["دهاني الحبُّ وكنتُ امرءاً","يا قومُ ذا لُبّ وعَقلٍ رَصين",47,"ن",1,0],["دَهرِيَةٌ قَد مَضَت شَبيبَتُها","وَاِستَنشَقَتها سَوالِفُ الحِقَبِ",48,"ب",1,0],["دَهياءَ يَحدوها القَدَر","فَتِلكَ عَيني لَم تَذَر",49,"ر",1,0],["دهري ولا أنعتُ القلوصَ ولا","أجعلُ في غير مُنيَتي لسَني",50,"ي",1,0],["دَهاني نُكُسُ الحُبِّ","بِما قَد كُنتُ سَدَّيتُ",51,"ت",1,0],["دَهري قَتادٌ وَحالي ضالَةٌ ضَؤُلَت","عَمّا أُريدُ وَلَوني لَونُ لِبلابِ",52,"ب",1,0],["دُهماً تُوافَينا السُنو","نَ وَلَم يَكُن فيهِنَّ غُرُّ",53,"ر",1,0],["دَهرٌ يَكُرُّ وَيَومٌ ما يَمُرُّ بِنا","إِلّا يَزيدُ بِهِ المَعقولُ تَخبيلا",54,"ل",2,0],["دَهرٌ يَمُرُّ كَما تَرى فَأَهلَّةٌ","تَنمي لِتَكمُلَ أَو بُدورٌ تَسقَمُ",55,"م",1,1],["دَهْماءَ راكبةٍ ثلاثةَ أجْبُلٍ","عِظَماً وإن حُسبَتْ ثلاثَ أثافِ",56,"ف",1,0],["دُهمٌ كأَسْدفةِ الظَّلامِ وبعضُها","صفرُ المناظرِ كاصفرارِ العاجِ",57,"ج",1,0],["دهتهم فرادى واحداً بعد واحدٍ","كأن الليالي عند أهلي لها وتر",58,"ر",1,0],["دهرٌ على العالم دارتْ رحاهْ","فلم تدَعْ رسماً لأطلالهِ",59,"ه",1,0],["دهاه بالمقدور لم يدفع ال","خطب عن مهجته إذ دهى",60,"ه",2,0],["ده النوم يا ليل نعمة","يحلم بها الساهر",61,"ر",1,0],["دَهْرٌ يَغُرُّ وَآمَالٌ تَسُرُّ وَأَعْ","مَارٌ تَمُرُّ وَأَيَّامٌ لَهَا خُدَعُ",62,"ع",1,0],["دَهْرٌ كَأَنَّا مِنْ جَرَائِرِ سِلْمِهِ","فِي حَرِّ يَوْمِ كَرِيهَةٍ وجِلادِ",63,"د",1,0],["دَهَتْكَ صُرُوفُ الزمَانِ دِرَاكاً","فكَانَتْ رُمَاةً وَكُنْتَ الهَدَفْ",64,"ف",1,0],["دَهْرٌ غَشومٌ رَمَى","عَنْ قوْسِهِ أَخْدَعَكْ",65,"ك",1,1],["دَهَاكَ الرَّدَى فِي الرائِحِينَ فَرَاعَنا","كَأَنَّكَ غَادٍ فِي الصِّبَا فَمُبَكِّرُ",66,"ر",1,0],["دُهِشَ النسرُ وقد راقَت لهُ","هذه الغِبطةُ في الوكرِ الصغير",67,"ر",1,1],["دَهاني الدَهرُ في وَلَدي","فَماتَ البَهِج",68,"ج",1,0],["دَهَتنا اللَيالي بِالنَوى فَتَفَرَّقَت","جَآذِرُ كانَت تَلتَقي وَأُسودُ",69,"د",1,0],["دَهرٌ حَوادِثُهُ شَتّى الأَحاديثِ","فَاِسمَع بِما شِئتَ عَن نوحٍ وَعَن شيثِ",70,"ث",1,1],["دَهَتْها الليالي في سواه ولا أرَى","شَعُوباً لهذا الناس مِثْلَ شَعُوبِ",71,"ب",1,0],["دهتك نوازلٌ لو زُرْنَ رَضْوَى","لما أبقَيْنَ رَضْوَى أو شمامَا",72,"م",2,0],["دهَتِ البلادَ بعوضةٌ أجَمِيّةٌ","جاءت على قدَرٍ لمصرَ مُتاح",73,"ح",1,0],["دَهَمَ المصابُ فعَمَّ إلا أنَّه","فيما يخُصُّكَ ما أمَرَّ وأصْعبا",74,"ب",2,0],["دهشت حتّى كأنّي قطّ لم أرها","وكدت والله أنسى أن أحيّيها",75,"ي",3,0],["دهاك الردى لكن على حين فجأة","فتبّت يداه غادر صرح النّدى",76,"د",2,0],["دهاك ولم يشفق عل الصبيّة الألى","تركتهم يبكون مثنى وموحدا",76,"د",2,0],["دهر يُشبِّعُ سبتَه أحدُهُ","متتابعُ ما ينقضي أمدُهْ",77,"د",2,1],["دهرٌ ودُنيا تلاقِي كُلَّ مْنْ ولَدا","لديْهما بِمَحَلّه الخَسْفِ والهُون",78,"ن",1,0],["دهنتني بودٍ قاتلٍ، وهو متلفي،","وكم قتلتْ بالودّ من ودّها ، دها",79,"ه",2,0],["دَهرٌ يَقبّل آمالي وَأَوسَعَهُ","إِذ أَنتَ مِن أَهلِهِ حَمداً وَشُكرانا",80,"ن",2,0],["دهانا الهوى والوجد والبعد والجفا","بنيران لهف أوقعت أي حرقة",81,"ه",1,0],["دَهرَنَا باللوي إِذِ الوَصلُ عَذبٌ","لَم تُكَدِّرهُ خَشيَةُ التَّودِيعِ",82,"ع",1,0],["دهتِ النصارى بالجزيرة وطأةٌ","راعَ الجزيرةَ ذكرها والموصلا",83,"ل",2,0],["دَهماءَ كَاللَيلِ أَو شَقراءَ صافِيَةٍ","تُريكَ في اللَيلِ ثَوباً حاكَهُ الأُصُلُ",84,"ل",1,0],["دُهِيتُ بِفقدَانٍ لِمَن قَد وَجَدتُهُ","فَلا إمَدمَعُ يَرقَا ولا وَجدَ يَخمُدُ",85,"د",1,0],["دَهى الشِركَ مِنهُ مَشرَفيٌّ مُهَنَّدُ","وَرُمحٌ رُدَينيٌّ وَسَهمٌ مُسَدَّدُ",86,"د",1,0],["دهري يخاصمني فصالح بيننا","واكفف بحسن الراى كف المعتدى",87,"د",2,0],["دهينا من زمان ليس فيه","سوى متشامت أو مستريب",88,"ب",1,1],["دهاني النحس في حظي بداهية","قد حالفته فلا طول ولا قصر",89,"ر",1,0],["دهرٌ رمتني بريبه ريبه","ما تنقضي من خطوبه خطبه",90,"ب",2,1],["دَهتنا السَماءُ غَداةَ النِجابِ","بِغَيمٍ عَلى أُفقِهِ مُسبلِ",91,"ل",1,1],["دهش الفؤاد فكان أن يتفطّرا","