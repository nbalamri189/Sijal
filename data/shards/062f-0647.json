{"poems":[[53,"ما بعد يومك ما يسلو به السالي","https://www.aldiwan.net/poem29885.html","البسيط"],[63,"النجم يبعد مرمى طرفه الساجي","https://www.aldiwan.net/poem46197.html","البسيط"],[3,"كم يبعد الدهر من أرجو أقاربه","https://www.aldiwan.net/poem125.html",""],[3,"دهتني صروف الدهر وانتشب الغدر","https://www.aldiwan.net/poem165.html",""],[86,"مضيت ونحن أحوج ما نكون","https://www.aldiwan.net/poem10370.html","الوافر"],[73,"ليهن الهدى إنجاح سعيك في العدا","https://www.aldiwan.net/poem11949.html","الطويل"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[93,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[93,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[88,"أرى عيشنا تأبى المنون امتداده","https://www.aldiwan.net/poem45059.html","الطويل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[51,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[51,"دهر يشيع سبته أحده","https://www.aldiwan.net/poem10884.html","أحذ الكامل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"دهر علا قدر الوضيع به","https://www.aldiwan.net/poem65442.html","أحذ الكامل"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[91,"فديناك لو ان الردى قبل الفدا","https://www.aldiwan.net/poem8811.html","عموديه"],[91,"يا من قربت من الفؤاد","https://www.aldiwan.net/poem8819.html","عموديه"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[32,"خليلي إن قالت بثينة ما له","https://www.aldiwan.net/poem27773.html","الطويل"],[85,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[45,"دهتك بعلة الحمام فوز","https://www.aldiwan.net/poem62752.html","الوافر"],[45,"لابس من شبيبة أم ناض","https://www.aldiwan.net/poem64634.html","الخفيف"],[28,"غنمنا فقيما إذ فقيم غنيمة","https://www.aldiwan.net/poem5521.html","الطويل"],[61,"قصاراك أن تلقى الزمان مسلما","https://www.aldiwan.net/poem51453.html","الطويل"],[61,"أمحل صبوتنا دعاء مشوق","https://www.aldiwan.net/poem51532.html","السريع"],[49,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[66,"دمع مزائد قطره لا تجمد","https://www.aldiwan.net/poem38494.html","الكامل"],[66,"هو الدهر مغرى بالكريم وسلبه","https://www.aldiwan.net/poem40134.html","الطويل"],[66,"عيون لها مرأى الأحبة إثمد","https://www.aldiwan.net/poem40291.html","الطويل"],[44,"الغيم من بين مغبوق ومصطبح","https://www.aldiwan.net/poem29698.html","البسيط"],[69,"دهرنا أضحى ضنينا","https://www.aldiwan.net/poem28794.html","مجزوء الرمل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"مللنا وما مل العدو المغاضب","https://www.aldiwan.net/poem43099.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[75,"اسم الذي عذبني حبه","https://www.aldiwan.net/poem69004.html","السريع"],[48,"إصدع نجي الهموم بالطرب","https://www.aldiwan.net/poem10775.html","المنسرح"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"لست لربع أبكي ولا دمن","https://www.aldiwan.net/poem66596.html","المنسرح"],[50,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[46,"يأتي الردى ويواري إثلب جسدا","https://www.aldiwan.net/poem22199.html","البسيط"],[46,"أشدد يديك بما أقو","https://www.aldiwan.net/poem22590.html","مجزوء الكامل"],[46,"دع آدما لا شفاه الله من هبل","https://www.aldiwan.net/poem23166.html","البسيط"],[46,"دهر يمر كما ترى فأهلة","https://www.aldiwan.net/poem23317.html","الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[76,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147505","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202701","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42695","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55027","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55097","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54857","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142059","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43637","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[77,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[91,"لقاء وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=53392",""],[91,"كل من عليها فان","https://www.poetsgate.com/ViewPoem.aspx?id=53027",""],[51,"دهر يُشبِّعُ سبتَه أحدُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=27689",""],[51,"مكْرُ الزَّمانِ علينا غير مأمونِ","https://www.poetsgate.com/ViewPoem.aspx?id=30805",""],[32,"خليليّ، إن قالت بثينة ُ: ما لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=16029",""]],"verses":[["دَهرٌ تُؤَثِّرُ في جِسمي نَوائِبُهُ","فَما اِهتِمامي إِذا أَودى بِسِربالي",0,"ي",1,0],["دَهْرٌ تذَأّبَ مِنْ أبْنائِه نَقَدٌ","فأُوطِئَتْ عَرَبٌ أعقابَ أعْلاجِ",1,"ج",1,0],["دَهرٌ يَرى الغَدرَ مِن إِحدى طَبائِعِهِ","فَكَيفَ يَهنا بِهِ حُرٌّ يُصاحِبُهُ",2,"ب",2,0],["دَهَتني صُروفُ الدَهرِ وَاِنتَشَبَ الغَدرُ","وَمَن ذا الَّذي في الناسِ يَصفو لَهُ الدَهرُ",3,"ر",1,1],["دَهاها المَوتُ في الإِلفِ المُفَدّى","وَكَدَّرَ صَفوَها الدَهرُ الخَؤونُ",4,"ن",1,0],["دَهاهُ إِذا ماجَنَّهُ اللَيلُ أَنَّهُ","أَقامَ عَلَيهِ آخِرَ الدَهرِ سَرمَدا",5,"د",2,0],["دهى الجَزيرَة أَمرٌ لا عَزاءَ لَهُ","هَوَى لَهُ أُحُدٌ وَاِنهَدَّ ثَهلانُ",6,"ن",1,0],["دَهَتني الحادِثاتُ بِهِ فَأَمسَت","عَلَيَّ هُمومُها تَغدو وَتَسري",7,"ر",2,0],["دَهَى العُرُوبَة خَطْبٌ فَتَّ سَاعِدَهَا","مِنْ حَيْثُ لاَ يُتَّقَى بِالبَيْضِ واليَلَبِ",8,"ب",1,0],["دَهَى دِمَشْقَ بِنَارٍ مِنْهُ هَاتِكَةٍ","نَهَّاشَةِ اللُّسْنِ للأَعْرَاضِ وَالحُرَمِ",9,"م",1,0],["دَهْرٌ أَذمَّ لأَهْلِهِ وَمَلأْتِهِ","بِالمَحْمَدَاتِ فَعَادَ غَيْرُ مُذَمَّمِ",10,"م",1,0],["دَهَى فِي عَظِيمٍ يَبْدَأُ الذِّكْرُ بِاسْمِهِ","إِذَ عُدَّ في مصر الرِّجَالُ الأَعَاظمُ",11,"م",1,0],["دَهَانَا بِأَنْوَاعِ الأَذَى مُتَجَنِّباً","فَلَمْ يَكُ إِلاَّ صَارِخٌ مُتَظَلِّمُ",12,"م",1,0],["دَهاسٍ سَقَتها الدَلوَ حَتّى تَنَطَّقَت","بِنَورِ الخَزامى في التِلاعِ الجَوائِفِ",13,"ف",1,0],["دهانا لرامي الموت سهم مقرطس","نَجيفٌ بأدواء الحياة مريش",14,"ش",1,0],["دَهماءُ قَد دَجَنَت وَأَحنَقَ صُلبُها","وَأَحالَ فيها الرَضحُ وَالتَصريمُ",15,"م",1,0],["دهرٌ تولى بالصّبى فرَطاً","ومضى بمن يصبو ومن يصبي",16,"ب",2,0],["دَهَانِي منْ جفائك ما دهاني","ولم يَكُ للزَّمَان به وَعيدُ",17,"د",1,0],["دهرٌ يُشَيِّعُ سَبْتَه أحَدُهْ","متتابعٌ ما ينقضي أمَدُهْ",18,"د",2,1],["دهَّرَتْهُ جهالةٌ نصَّرته","ثم عادت عليه بالتمجيس",19,"س",1,0],["دهرٌ علا قدرُ الوضيع به","وهوى الشريف يحطُّهُ شرَفُهْ",20,"ف",2,1],["دهرٌ نهى الدهر عن جيرانِ دولتِه","فأحرم الدهرُ فيها أيَّ إحرامِ",21,"م",1,0],["دهرٌ ودُنيا تلاقِي كُلَّ مَنْ ولَدا","لديْهما بِمَحَلِّ الخَسْفِ والهُون",22,"ن",1,0],["دَهمٍ يَظَلُّ بِهِ الفَضاءُ مُعَضِّلاً","كَالطَودِ أَسوَدَ مُجفِلِ الأَثقالِ",23,"ل",1,0],["دَهاكَ الرَدى لَكِن عَلى حينِ فَجأَةٍ","فَتَبَّت يَداهُ غادِرٌ صَرَعَ النَدى",24,"د",2,0],["دَهاك وَلَم يُشفِق عَلى الصِبيَةِ الأُلى","تَرَكتُهُم يَبكونَ مَثنى وَمَوحَدا",24,"د",2,0],["دَهراً بَليداً ما يُنيلُ","وِدادَهُ إِلّا بَليد",25,"د",1,0],["دُهِشتُ حَتّى كَأَنّي لَم أَرَها","وَكِدتُ وَاللَهِ أَنسى أَن أُحَيِّها",26,"ي",3,0],["دَهَتني بِوِدٍّ قاتِلٍ وَهوَ مُتلِفي","وَكَم قَتَلَت بِالوُدِّ مَن وَدَّها دَها",27,"ه",2,0],["دهر مصائبه عندي بلا عدد","لم يجن أمثالها قبلي على أحد",28,"د",1,1],["دَهِمَتهُ تَطايِرُ الزَرَدَ المُح","كَمَ عَنهُ كَما يَطيرُ النَسيلُ",29,"ل",1,0],["دُهمٌ فَوارِسُها رُكّابُ أَبطُنِها","مَكدودَةٌ بِقَومٍ لا بِها الأَلَمُ",30,"م",1,0],["دهرٌ غريمٌ لم يُحِسَّ به","ريبٌ ولم يَفْطُنْ له خَطْبُ",31,"ب",1,0],["دَهَتكَ بِعِلَّةِ الحَمّامِ فَوزٌ","وَمالَت في الطَريقِ إِلى سَعيدِ",32,"د",1,1],["دَهيُ عودٍ ما إِن يَزالُ يُغَوّى","غَمرَةً ما يَخوضُها اِبنُ مَخاضِ",33,"ض",1,0],["دَهَمنا بِهِم بَكراً فَأَصبَحَ سَبيُهُم","تُقَسَّمُ بِالأَنهابِ فينا مَغانِمُه",34,"م",2,0],["دَهتني الليالي بعدَه ولربَّما","بَعثتُ عليها مِنه دَهياءَ صَيْلَما",35,"م",2,0],["دَهرٌ ترَفَّقَ بي فُواقاً صَرفُه","وسَطا عليَّ فكانَ غيرَ رَفيقِ",36,"ق",1,0],["دَهرٌ يُؤَمِّنُنا الخُطوبَ وَقَد نَرى","في كُلِّ ناحِيَةٍ لَهُنَّ شِباكا",37,"ك",2,0],["دَهرٌ ذَميمُ الحالَتَينِ فَما بِهِ","شيءٌ سِوى جودِ اِبنِ أُرتُقَ يُحمَدُ",38,"د",1,0],["دَهَتهُ المَنايا وَهيَ في حَدِّ سَيفِهِ","وَصَرفُ اللَيالي وَهوَ مِن بَعضِ حُبِّهِ",39,"ب",2,0],["دَهَتهُ المَنايا وَهيَ مِن دونِ بَأسِهِ","كَذا الصارِمُ الصَمصامُ يَفنيهِ مِبرَدُ",40,"د",1,0],["دُهمٍ إِذا ضَحِكَت في رَوضَةٍ طَفِقَت","عُيونُ نُوّارِها تَبكي مِنَ الفَرَحِ",41,"ح",1,0],["دهْرُنا أضحى ضنيناً","باللقا حتى ضَنينا",42,"ن",2,1],["دَهاها الخطبُ أحمرَ في نُفوسٍ","لَبسْنَ الموتَ أسودَ إذ دُهينا",43,"ن",2,0],["دَهانا مِنَ الأَقوامِ ما لَو دَها الصَفا","لَفاضَت دَماً عَن جانِبَيهِ المَذانِبُ",44,"ب",1,0],["دهمناهمو لا بل دهمنا نُفوسَنا","فهلّا علمنا أَيُّنا كان يُدهَمُ",45,"م",1,0],["دَهماءَ مِدفَأَةُ الشِتا","ءِ كَأَنَّ بِركَتها الحَظائِر",46,"ر",1,0],["دهاني الحبُّ وكنتُ امرءاً","يا قومُ ذا لُبّ وعَقلٍ رَصين",47,"ن",1,0],["دَهرِيَةٌ قَد مَضَت شَبيبَتُها","وَاِستَنشَقَتها سَوالِفُ الحِقَبِ",48,"ب",1,0],["دَهياءَ يَحدوها القَدَر","فَتِلكَ عَيني لَم تَذَر",49,"ر",1,0],["دهري ولا أنعتُ القلوصَ ولا","أجعلُ في غير مُنيَتي لسَني",50,"ي",1,0],["دَهاني نُكُسُ الحُبِّ","بِما قَد كُنتُ سَدَّيتُ",51,"ت",1,0],["دَهري قَتادٌ وَحالي ضالَةٌ ضَؤُلَت","عَمّا أُريدُ وَلَوني لَونُ لِبلابِ",52,"ب",1,0],["دُهماً تُوافَينا السُنو","نَ وَلَم يَكُن فيهِنَّ غُرُّ",53,"ر",1,0],["دَهرٌ يَكُرُّ وَيَومٌ ما يَمُرُّ بِنا","إِلّا يَزيدُ بِهِ المَعقولُ تَخبيلا",54,"ل",2,0],["دَهرٌ يَمُرُّ كَما تَرى فَأَهلَّةٌ","تَنمي لِتَكمُلَ أَو بُدورٌ تَسقَمُ",55,"م",1,1],["دَهْماءَ راكبةٍ ثلاثةَ أجْبُلٍ","عِظَماً وإن حُسبَتْ ثلاثَ أثافِ",56,"ف",1,0],["دُهمٌ كأَسْدفةِ الظَّلامِ وبعضُها","صفرُ المناظرِ كاصفرارِ العاجِ",57,"ج",1,0],["دهتهم فرادى واحداً بعد واحدٍ","كأن الليالي عند أهلي لها وتر",58,"ر",1,0],["دهرٌ على العالم دارتْ رحاهْ","فلم تدَعْ رسماً لأطلالهِ",59,"ه",1,0],["دهاه بالمقدور لم يدفع ال","خطب عن مهجته إذ دهى",60,"ه",2,0],["ده النوم يا ليل نعمة","يحلم بها الساهر",61,"ر",1,0],["دَهْرٌ يَغُرُّ وَآمَالٌ تَسُرُّ وَأَعْ","مَارٌ تَمُرُّ وَأَيَّامٌ لَهَا خُدَعُ",62,"ع",1,0],["دَهْرٌ كَأَنَّا مِنْ جَرَائِرِ سِلْمِهِ","فِي حَرِّ يَوْمِ كَرِيهَةٍ وجِلادِ",63,"د",1,0],["دَهَتْكَ صُرُوفُ الزمَانِ دِرَاكاً","فكَانَتْ رُمَاةً وَكُنْتَ الهَدَفْ",64,"ف",1,0],["دَهْرٌ غَشومٌ رَمَى","عَنْ قوْسِهِ أَخْدَعَكْ",65,"ك",1,1],["دَهَاكَ الرَّدَى فِي الرائِحِينَ فَرَاعَنا","كَأَنَّكَ غَادٍ فِي الصِّبَا فَمُبَكِّرُ",66,"ر",1,0],["دُهِشَ النسرُ وقد راقَت لهُ","هذه الغِبطةُ في الوكرِ الصغير",67,"ر",1,1],["دَهاني الدَهرُ في وَلَدي","فَماتَ البَهِج",68,"ج",1,0],["دَهَتنا اللَيالي بِالنَوى فَتَفَرَّقَت","جَآذِرُ كانَت تَلتَقي وَأُسودُ",69,"د",1,0],["دَهرٌ حَوادِثُهُ شَتّى الأَحاديثِ","فَاِسمَع بِما شِئتَ عَن نوحٍ وَعَن شيثِ",70,"ث",1,1],["دَهَتْها الليالي في سواه ولا أرَى","شَعُوباً لهذا الناس مِثْلَ شَعُوبِ",71,"ب",1,0],["دهتك نوازلٌ لو زُرْنَ رَضْوَى","لما أبقَيْنَ رَضْوَى أو شمامَا",72,"م",2,0],["دهَتِ البلادَ بعوضةٌ أجَمِيّةٌ","جاءت على قدَرٍ لمصرَ مُتاح",73,"ح",1,0],["دَهَمَ المصابُ فعَمَّ إلا أنَّه","فيما يخُصُّكَ ما أمَرَّ وأصْعبا",74,"ب",2,0],["دهشت حتّى كأنّي قطّ لم أرها","وكدت والله أنسى أن أحيّيها",75,"ي",3,0],["دهاك الردى لكن على حين فجأة","فتبّت يداه غادر صرح النّدى",76,"د",2,0],["دهاك ولم يشفق عل الصبيّة الألى","تركتهم يبكون مثنى وموحدا",76,"د",2,0],["دهر يُشبِّعُ سبتَه أحدُهُ","متتابعُ ما ينقضي أمدُهْ",77,"د",2,1],["دهرٌ ودُنيا تلاقِي كُلَّ مْنْ ولَدا","لديْهما بِمَحَلّه الخَسْفِ والهُون",78,"ن",1,0],["دهنتني بودٍ قاتلٍ، وهو متلفي،","وكم قتلتْ بالودّ من ودّها ، دها",79,"ه",2,0]]}