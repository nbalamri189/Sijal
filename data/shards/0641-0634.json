رمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1915","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50221","الرجز"],[106,"الكبش والقصاب","https://www.poetsgate.com/ViewPoem.aspx?id=179575",""],[77,"أنتم من مناسب الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=33807",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[9,"فِدًى لَبنى ذُهلِ بنِ شَيبانَ ناقَتي","https://www.poetsgate.com/ViewPoem.aspx?id=20023",""],[45,"بأيّ أسًى تُثْنَى الدّمُوعُ الهَوَامِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32193",""],[80,"فؤادِي نجيبٌ والجلالُ نجيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3009",""],[91,"قتل نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=53071",""],[46,"وجدتُ الناسَ في هَرْجٍ ومَرْجِ،","https://www.poetsgate.com/ViewPoem.aspx?id=18251",""],[28,"لم أر جارا لامرىء يستجيره","https://www.poetsgate.com/ViewPoem.aspx?id=16989",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[51,"نُعيدُ أقاويلَ مَمْلولة ً","https://www.poetsgate.com/ViewPoem.aspx?id=30614",""],[51,"يا داعياً نحو العلاءِ مُثَوِّباً","https://www.poetsgate.com/ViewPoem.aspx?id=27404",""],[78,"يا أَيُّها المَلِك الَّذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86540&r=&rc=85",""]],"verses":[["فَشَقَّها وَالحَديدُ مُطَّرِدٌ","وَخاضَها وَالضِرابُ مُضطَرِمُ",0,"م",1,0],["فَشَتّانَ أَنتُم وَالمُسيلونَ لِلجَدا","إِذا عَدِمَ العامُ النَدى رَوَّضوا المَحلا",1,"ل",2,0],["فَشَمَّ عَوالٍ ما تُرَدُّ صُدورُها","وَثَمَّ جِيادٌ ما يُفَلُّ رَعيلُها",2,"ل",3,0],["فَشَنَّ عَلَيهِ الأَزلَمُ العَودُ غارَةً","بِلا قَرعِ أَرماحٍ وَلا نَقعِ مَأزِقِ",3,"ق",1,0],["فَشَقَّ عَلىذاكَ التُرابِ مَزادَهُ","وَخَوّى عَلى تِلكَ القُبورِ وَجَعجَعا",4,"ع",2,0],["فَشَفَيتُ غُلَّ النَفسِ مِن حَوبائِهِ","نَهلاً يُعَلُّ مِنَ الدَمِ المُثعَنجِرِ",5,"ر",1,0],["فَشَمَّر لِمُظلِمَةٍ ما تَزا","لُ تَقبِضُ مِن بَطشَةِ الناظِرِ",6,"ر",1,0],["فَشُكراً لِمَن لَم يَجعَلِ الرِزقَ عِندَكُم","فَلا رَيَّ ظَمآنٍ وَلا شِبعَ غارِثِ",7,"ث",1,0],["فَشَوقاً إِلى وَجهِ الحَبيبِ تَلَهُّفي","وَمَيلاً إِلى دارِ الحَبيبِ تَلَفُّتي",8,"ي",1,0],["فَشَمائِلٌ فيها النَدى وَضَرائِبٌ","وَكَتائِبٌ فيها الرَدى وَمَقانِبُ",9,"ب",1,0],["فَشَوقي لَئيمٌ والدُّموعُ كَريمَةٌ","ووجدي سَفيهٌ والعَزاءُ حَليمُ",10,"م",1,0],["فَشَجاني ذا وَهاتيكَ مَعاً","أَيُّ خَطْبٍ طَرَقَ الصَبَّ هُنا",11,"ن",2,0],["فَشَفَيْتُ مِنْهُ النَّفْسَ حينَ اعْتَادَهُ","سَفَهاً عَلَيَّ مِنَ المَخيلَةِ داءُ",12,"د",3,0],["فَشَفَتْ غُلَّتَهُمْ بِالدْ","دَمِ أَطْرافُ الصِّفاحِ",13,"ح",1,0],["فَشَيَّدْتُ مَجْداً رَسَا أَصْلهُ","أَمُتُّ إلَيْهِ بِأُمٍّ وَأَبْ",14,"ب",1,0],["فشَدَّ بعَبْدِ اللهِ أَزْري وأعْصَمَتْ","يَميني بمَنْ باهَى بهِ العُرْب فارِسُ",15,"س",1,0],["فشُدَّتْ نَواصي الخَيْلِ وهْيَ تَدوسُهُ","بأثْبَتَ منْهُ في اللِّقاءِ وأرْسَخِ",16,"خ",1,0],["فشَيَّدَ ما بَناهُ أوَّلُوهُ","ورَوْقُ شَبابِهِ في العُنْفُوانِ",17,"ن",1,0],["فَشامَ بأَرْوَنْدَ ذاكَ الوَميضَ","وأينَ سَناهُ بنَجْدٍ سَناهْ",18,"ا",2,0],["فَشُبَّتْ لها تَحْتَ الأحِجّةِ أعْيُنٌ","لمَرْعىً على أطْرافِهِ العِزُّ حَوّضا",19,"ض",2,0],["فَشَعْبُ بَني العَبَّاسِ للمُرْتَجي غِنًى","وللمُبْتَغي عِزّاً وللمُعْتَفي شِعْبُ",20,"ب",1,0],["فَشِدْتَ ما أَسَّسَ الآباءُ مِن شَرَفٍ","حتى تحَلَّتْ بهِ الأيّامُ مِنْ عَطَلِ",21,"ل",1,0],["فَشَكَكتُ بِالرُمحِ الأَصَمِّ ثِيابَهُ","لَيسَ الكَريمُ عَلى القَنا بِمُحَرَّمِ",22,"م",1,0],["فَشَكَكتُ هَذا بِالقَنا وَعَلَوتُ ذ","مَع ذاكَ بِالذِكَرِ الحُسامِ الأَبتَرِ",23,"ر",1,0],["فَشَمَمتُ الريحَ مِن تِلقائِها","فَاِستَطارَ القَلبُ مِني شِقَقا",24,"ق",2,0],["فَشُكْراً أَيُّهَا الْمَوْلَى لِسَعْيٍ","بَرِيٍّ فِي الْوَفَاءِ مِنَ الْمَلاَمِ",25,"م",1,0],["فشُدَّ علَيْهِ الكَفَّ ذُخْرَ مضنّةٍ","وأسْكِنْ بهِ الأسْرارَ دارَ قَرارِ",26,"ر",1,0],["فشاهِدُ الزّورِ يقْضي حقَّ صاحِبِه","وبعْدَ هَذا بتِلْكَ العَيْنِ يَنْظُرُهُ",27,"ه",1,0],["فشَبا صَعْدَةٍ بثُغْرَةِ ذِمْرٍ","وغِرارٌ مُهنّدٌ في هادي",28,"د",2,0],["فَشَكَت إِلَيَّ كَلالَها","وَالجَهدَ مِن أَتعابِها",29,"ب",3,0],["فَشايَعَها ما أَبصَرَت تَحتَ دِرعِها","عَلى صَومِنا وَاِستَعجَلَتها أَناتُها",30,"ت",3,0],["فَشِباكِ باعِجَةٍ فَجَنبَي جائِرٍ","وَتَحُلُّ شاطِنَةً بِدارِ إِيادِ",31,"د",1,0],["فَشَكَّ غَيرَ قَليلٍ ثُمَّ قالَ لَهُ","اِذبَح هَدِيَّكَ إِنّي مانِعٌ جاري",32,"ي",1,0],["فَشَكَّ أَوداجَهُ وَالصَدرُ في مَضَضٍ","عَلَيهِ مُنطَوِياً كَاللَذعِ بِالنارِ",32,"ر",1,0],["فَشَكَّ لَها صَفحاتِها صَدرُ رَوقِهِ","كَما شَكَّ ذو العودِ الجَرادَ المُنَظَّما",33,"م",2,0],["فَشَرَيتُهُ بِأَجَمَّ أَسوَدَ حالِكٍ","بِعُكاظَ مَوقوفاً بِمَجمَعِها ضُحا",34,"ا",1,0],["فَشَمَّرت عَن عَمودَي بانَةٍ ذَبَلا","كَأَنَّ ضاحِيَ قِشرٍ عَنهُما اِنقَرَفا",35,"ف",2,0],["فَشَهِدنا ظُلماً يُقالُ لَهُ العَد","لُ وَوُدّاً يَسقي الحَميمَ الحَميما",36,"م",2,0],["فَشَمَّروا لِاِنتِقامٍ","مِن غافِلٍ في أَمانِ",37,"ن",1,0],["فَشَقَقنا إِلى الحَياةِ طَريقاً","وَأَصَبنا عَلى الزِحامِ مَجالا",38,"ل",2,0],["فَشُكري لِصُنعِكَ شُكرُ النَباتِ","بِبَطنِ الفَلاةِ لِقَطرِ السُحُب",39,"ب",1,0],["فَشَرابُكَ الماءُ الشُنا","نُ وَشُربِىَ الماءُ الحَميمُ",40,"م",1,0],["فَشَمِّر وَعَجِّل إِلَيها المَآبَ","وَخَلِّ الشَآمَ لِأَقدارِها",41,"ر",3,0],["فَشَرِّفها بِرَبِّكَ وَاِختَتِمها","وَأَسعَدِها بِدُستورٍ تَميمِ",42,"م",1,0],["فَشَكَرتُ رَبّي لَو قَراها جُبَّةً","لَقَتلتُهُ عَمداً بِلا سِكّينِ",43,"ن",1,0],["فَشامَ السُيوفَ بِهامِ الكُماةِ","وَرَوّى القَنا في نُحورِ البُهَم",44,"م",1,0],["فَشَبَّهتَهُم في الآلِ لَمّا تَكَمَّشو","حَدائِقَ دومِ أَو سَفيناً مُقَيَّرا",45,"ر",2,0],["فَشِراجَ ريمَةَ قَد تَقادَمَ عَهدُها","بِالسَفحِ بَينَ أُثَيِّلٍ فَبِعالِ",46,"ل",1,0],["فَشاقوكَ لَمّا وَجَّهوا كُلَّ وِجهَةٍ","سِراعاً وَخَلّوا عَن مَنازِلَ بَلقَعِ",47,"ع",1,0],["فَشَأنُ المَنايا إِذ أَصابَكَ رَيبُها","لِتَغدو عَلى الفِتيانِ بَعدَكَ أَو تَسري",48,"ر",2,0],["فَشَأنَ المَنايا بِالأَقارِبِ بَعدَهُ","لِتُعلِل عَلَيهِم عَلَّةٌ بَعدَ ناهِلِ",49,"ل",1,0],["فشاقني منهن ما شاقني","في روضة من زهرات الربيع",50,"ع",1,0],["فَشَدَدْتَ الرِّحَالَ فِي نُضْرَةِ القَوْ","مِ وَقَدْ عَزَّ فِي الجِهَادِ المُعِينُ",51,"ن",1,0],["فَشَتَّانَ مَا بَيْنَ الَّذِي كَانَ وَالَّذِي","دَهَانَا بِهِ الْيَوْمَ الزَّمَانُ المُرَاغِمُ",52,"م",1,0],["فَشَبَّهَ صَحبي نُوّارَها","بِديباجِ كِسرى وَعَصبِ اليَمَن",53,"ن",1,0],["فَشَدّوا عَلَيهِنَّ الرِحالَ فَصَمَّموا","عَلى كُلِّ هَولٍ مِن جَنانِ المُخاطِرِ",54,"ر",1,0],["فَشَدَّ إِصارَ الدينِ أَيّامَ أَذرُحٍ","وَرَدَّ حُروباً قَد لَقِحنَ إِلى عَقرِ",55,"ر",1,0],["فشارة هذا الملك رائقة الحُلى","بألوية حمر وبالصُّحف الحمرِ",56,"ر",1,0],["فشاع في الأزهار هذا الخبر","واستَوجب العطف على المرسل",57,"ل",1,0],["فشبّ منهوك القُوى مثلها","يشكو من الدهر الذي أيتمه",58,"م",2,0],["فشكراً للكرام وكلَّ شكر","لمن عضدوا الكرام بمَدِّ باع",59,"ع",1,0],["فشرّ العالمين ذوو خُمول","إذا فاخرتهم ذكروا الجدودا",60,"د",2,0],["فشاهدت فيه الحسن أزهر مشرقاً","له في العلا وجهٌ أغرّ مهَيب",61,"ب",1,0],["فَشُدّوا الحُبى لِلغَدرِ إِنّي مُشَمِّرٌ","إِذا ما عَلا مَتنَ المُفاضَةِ مِحمَلي",62,"ل",2,0],["فَشَيَّعَهُم حَمدٌ وَزانَت قُبورَهُم","سَرارَةُ رَيحانٍ بِقاعٍ مُنَوِّرِ",63,"ر",1,0],["فَشَلتُهُ أَرغَبُ في الزِيادَه","وَتِلكَ لِلطَرادِ شَرُّ عادَه",64,"ه",1,0],["فَشَراهُ مَن يَبغي الرَباحَ بِمالِهِ","قِرداً خَبيثاً ثائِرَ الصُمّاحِ",65,"ح",1,0],["فشم بارقاً قد خوَّلتك ولا تشم","لخولة أطلال ببرقة ثهمد",66,"د",1,0],["فشعاع تبرٍ صاعد","ودماء قومٍ مائره",67,"ر",2,0],["فشيبة الحمد عندي والولاء معاً","حقان بين أبي بكر وبين علي",68,"ي",1,0],["فشدَّ أمرؤٌ بالصبر كفّاً فإنهُ","له عِصمةٌ أسبابُها لا تُقضَّبُ",69,"ب",1,0],["فشكرتَ سيِّدَنا وقلتَ بفضله","ولقائِل الحق المبَيَّنِ منهجُ",70,"ج",1,0],["فشكَّكَنا في موته غير أنه","أبان لنا في طرفه وانكساره",71,"ر",2,0],["فشهدتَ الوغى برمحٍ طريحٍ","غير مستعمل ولا مركوز",72,"ز",1,0],["فشبهتُهُ بابن السبيل تعرضتْ","له وَه