{"poems":[[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[50,"جفن عيني قد كاد يسقط","https://www.aldiwan.net/poem62485.html","مجزوء الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122879","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109191","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64629","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100883","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48315","الطويل"],[5183,"أبا دواؤد","https://www.poetsgate.com/ViewPoem.aspx?id=180195",""]],"verses":[["كَان مَيتاً جِنَازَةً خَيرُ مَيتٍ","غَيَّبَتهُ حَفَائِرُ الأقوَامِ",0,"م",1,0],["كانَ ميعادُنا خُرو","جَ زِيادٍ وَقَد خَرَج",1,"ج",1,0],["كان ميعاده الخميس وقد م","ر خميس لوعده وخميس",2,"س",1,1],["كان ميلاً فصار حباً فعهداً","ختموا سره بعقد القران",3,"ن",1,0],["كأن مياه البدر في ماء وجهه","يرقرقها من جوهر البشر ساجم",4,"م",1,0],["كأَنَّ مياهها قطرات حُسن","وقد مسَحَ الشبابُ بها الجبينا",5,"ن",2,0],["كأنّ ميادينَ الطّراد صَحيفةٌ","يُريكَ بها الخطّيُّ خطّاً مُثَبّجا",6,"ج",2,0],["كأن مياه النهر تحت شعاعها","أسارير وجه من حبيب محجّب",7,"ب",1,0]]}