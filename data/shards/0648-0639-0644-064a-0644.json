{"poems":[[55,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[65,"وعليلة الألحاظ ترقد عن","https://www.aldiwan.net/poem45900.html","أحذ الكامل"],[65,"وعليلة اللحظات يشكو قرطها","https://www.aldiwan.net/poem46100.html","الكامل"],[93,"قال السماء كئيبة وتجهما","https://www.aldiwan.net/poem62735.html","عموديه"],[64,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[82,"نثر الجو على الأرض برد","https://www.aldiwan.net/poem31499.html","الرمل"],[82,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[47,"قُلْ للسّحابِ، إذا حَدَتْهُ الشّمألُ","https://www.poetsgate.com/ViewPoem.aspx?id=32160",""],[93,"ابتسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67935&r=&rc=214",""],[119,"من منصفي من دمعي المتدفق","https://www.aldiwan.net/poem40881.html","عموديه"],[125,"تنصلت للمولى على المنع والكره","https://www.aldiwan.net/poem23834.html","الطويل"],[309,"نسمات الحي وهنا إذ سرت","https://www.aldiwan.net/poem16846.html","الرمل"],[385,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[435,"رفقا بأسيرك يا أسما","https://www.aldiwan.net/poem41412.html","المتدارك"],[438,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[463,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[505,"لله من جفن هملن دموعه","https://www.aldiwan.net/poem37965.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126744","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126843","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53913","الرمل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123688","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119920","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122094","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11881","المديد"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101053","الرمل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76675","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71065","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88700","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65117","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34665","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70007","الكامل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143828","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111198","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33487","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72394","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204368","الكامل"],[5060,"بعض أهلّة","https://www.poetsgate.com/ViewPoem.aspx?id=214499",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5240,"لا تلمني فالنفس طال عناها","https://www.poetsgate.com/ViewPoem.aspx?id=171238",""],[5720,"ما أقسىٰ الوداع !","https://www.poetsgate.com/ViewPoem.aspx?id=201705",""],[5956,"العالمية قد تجلت عنده","https://www.poetsgate.com/ViewPoem.aspx?id=192636",""]],"verses":[["وَعُلىً لِأَبلَجَ مِن ذُؤابَةِ هاشِمٍ","يُثنى عَليهِ السُؤدُدُ المَعقودُ",0,"د",1,0],["وَعَلِيلَةِ الأَلْحاظِ تَرْقُدُ عَنْ","صَبٍّ يُصافِحُ جَفْنَهُ الأَرَقُ",1,"ق",1,1],["وَعَليلَةِ اللَّحَظاتِ يَشْكو قُرْطها","بُعْدَ المَسافَةِ مِنْ مَناطِ عُقُودِها",2,"د",3,1],["وَعَلَيَّ لِلأَحبابِ فَرضٌ لازِمٌ","لَكِنَّ كَفّي لَيسَ تَملُكُ دِرهَما",3,"م",2,0],["وعُلىً لوَ اَن الشمس تبلُغُها","في وجهِها سجدتْ لها الشُّهْبُ",4,"ب",1,0],["وعليلِ النّبْتِ ظمآنِ الثرى","عرّج الرّائدُ عنه فزهد",5,"د",1,0],["وعليلٍ لا يداوى قَرْحُهُ","من جنيّ الرشفِ بالعذبِ القراح",6,"ح",1,0],["وَعَلِيٍّ لمَّا تَفَلْتَ بِعَيْنَيْ","هِ وكلتاهما مَعاً رمْداءُ",7,"ا",2,0],["وعليَّ للصَّبْرِ الجمِيلِ مُفاضةٌ","زَغْفٌ أَفُلُّ بها شَباةَ سِنانِهَا",8,"ن",3,0],["وعليَّ للصَّبْر الجَمِيلِ مُفاضةً","تَلْقَى الرَّدَى فتَكِلُّ دُونَ صَبُورِه",9,"ر",2,0],["وعَلِيٌّ لَو ظلَّ وَهْوَ يُديرُ","الحُكْمَ مَا فَاقَهُ الغَدَاةَ مُدِيرُ",10,"ر",1,0],["وَعَليلَةِ الأَلحاظِ ناعِمَةِ الصِبا","غَرِيَ الوَخاةُ بِها وَلَجَّ العُذَّلُ",11,"ل",1,0],["وَعَلِيلَةِ الألحَاظِ، نَاعِمَةِ الصّبَا،","غُرِيَ الوُشَاةَ بِهَا، وَلَجّ العُذّلُ",12,"ل",1,0],["وعليّ للأإحباب فرض لازم","لكنّ كفّي ليس تملك درهما",13,"م",2,0],["وعليل قلب قد تناهبه النوى","لسوى حديث حبيبه لم يخفق",14,"ق",1,0],["وعلّي لما يرضى أنال جميعه","وعلّي أكُ المُهدَى على المنع والكُره",15,"ه",1,0],["وعلى لطف خفى شامل","ومنوح وفتوح بهرت",16,"ت",1,0],["وَعَليل النَسيم في الرَوض يَهفو","بِذبول ثَدي خَلوقاً رِقاق",17,"ق",1,0],["وعلي ليث الفتك وكم","بحسام السفك بري عظما",18,"م",2,0],["وعليلُ نفحةِ روضةٍ مطلولةٍ","باحتْ بما ضمّتْ من الأسرارِ",19,"ر",1,0],["وعَلِيلُ لَحْظِ الطَّرْفِ أَعدى طَرْفُهُ","قَلْبي بداءٍ لا يُفيقُ عليلُهُ",20,"ل",2,0],["وعليَّ للرفقاءِ في طلب العلا","والجاعلين لها الخطارَ مَراقيا",21,"ي",2,0],["وعَليلِ جسمٍ قد أُذيبَ تلَهُّفاً","لحِمًى تَريضُ العارِفينَ رُبُوعُهُ",22,"ع",2,0],["وَعلى لِساني ذكرهُ","كالمسكِ طيباً إن تكرّر",23,"ر",1,0],["وَعَلى لسانِ نبيّه","ربّ السما في الذكرِ ذمّه",24,"م",2,0],["وعليلٍ فمُه أبرأهُ","رشفُ ريقٍ منه بالشّهد امتزج",25,"ج",1,0],["وعليّ ليث الحروب أبي السب","طين زوج البتول باب الغبوب",26,"ب",1,0],["وعليلة الألحاظ ساحرة","زارت فليلي كله سحرُ",27,"ر",1,0],["وَعَلَيَّ لَثْمٌ لِلْمَوَاطِىءِ فِي الثَّرَى","بَعْدَ الَّذِينَ قَضَوْا بِذِلَّةِ مَوْقِفِي",28,"ف",2,0],["وَعَليلاً أَنتَ عائِدُهُ","قَد أَتاهُ اللَهُ بِالفَرَجِ",29,"ج",1,0],["وعليٌّ لم يطش رأياً ولم","يخش في اللَه من القوم ملاما",30,"م",2,0],["وعلى لحظة النزيه طلوع","كطلوع البشير بالتأييد",31,"د",1,0],["وعلىّ للرحمن أَنْ لا تلتقي","أَبداً بطيبِ مَنامِها أَشفاري",32,"ر",2,0],["وعليله ساقاه","قيداً بالدما تتفجر",33,"ر",1,0],["وعَلَى لِسانِ الجهمِ جَاءُوا حِزبَهُ","مِن كُلِّ صَاحِبِ بِدعَةٍ حَيرَانِ",34,"ن",1,0],["وَعَلَى للاستِعلاَءِ فَهيَ حَقيقَةٌ","فِيهِ لَدَى أربَابِ هَذَا الشَّانِ",34,"ن",1,0],["وعلي لم تزل افعاله","طاعة للمُصطَفى دام مؤيد",35,"د",1,0],["وعليلُ النّسيم مرّ بآس","يشتفي من زلالها بورود",36,"د",1,0],["وعليلها يسبى ويسمع","سب والده وشتمه",37,"م",2,0],["وعلى لوح الثرى آثارها","بيراع السير قد خطت كتابا",38,"ب",2,0],["وعليل النسيم يختلس العر","ف لتهوى عناقه الأغصان",39,"ن",1,0],["وعلى لفظها المُنَوِّ","نِ للامِ بالغنن",40,"ن",1,0],["وعليلُ الجسمِ وافاهُ الشفا","حينَ ناجاهُ سميُّ المصطَفى",41,"ف",2,0],["وعليلةٍ بليت بلاي وأصبحت","غرفاتها عن أهلهنَّ خلاء",42,"ا",2,0],["وعليلة اللحظات تكسر جفنها","بأحد من ذي شفرتين مصمم",43,"م",1,0],["وعليلٌ يبعثُ الأن","فاسَ من بعدِ غليلِ",44,"ل",1,0],["وعلى لبة العلا إن تراآى","فيه تزهو من المعالي نحور",45,"ر",1,0],["وعليَّ للسلطان طاعة مالك","كانت على المملوك ضربة لازب",46,"ب",1,0],["وعليلةٌ سُبُلُ النجاةِ.. عليلةٌ","حتى جهاتُ هروبها معتلَّه ْ",47,"ل",2,0],["وعلى لما دعاه أخوه","سبق الحاضريين والبدويا",48,"ي",2,0],["وعليل على الصعاب اسير","جرح القيد ساقه فيراها",49,"ا",3,0],["وَعَلِيلَهُ في كلِّ أمرٍ عادَهُ","يرنو إليه عَشيَّةً وبُكُورا",50,"ر",2,0],["وعلى لسان الأنبياء ترَدَّدَ ال","إسلام واستسلامهم إمضاءُ",51,"ا",2,0]]}