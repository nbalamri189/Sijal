{"poems":[[44,"وساجع في فروع الأيك هيجني","https://www.aldiwan.net/poem50282.html","البسيط"],[45,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[30,"لوى ابن أبي الرقراق عينيه بعدما","https://www.aldiwan.net/poem5063.html","الطويل"],[33,"أباكرة في الظاعنين رميم","https://www.aldiwan.net/poem41810.html","الطويل"],[52,"أباهل إني للحروب عواد","https://www.aldiwan.net/poem63892.html","الطويل"],[52,"أشاقك مغنى منزل متأبد","https://www.aldiwan.net/poem63906.html","الطويل"],[52,"أبا كرب كلني لهم المجاهد","https://www.aldiwan.net/poem63946.html","الطويل"],[1,"من الشر والتبريح أولاد معشر","https://www.aldiwan.net/poem34000.html","الطويل"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[409,"ثوى جبل العلم الذي طال واندكا","https://www.aldiwan.net/poem33612.html","الطويل"],[542,"إذا مت فادفني إلى أصل كرمة","https://www.aldiwan.net/poem69400.html","الطويل"],[1157,"","https://poetry.dctabudhabi.ae/diwan/poem/102903","الطويل"],[1690,"","https://poetry.dctabudhabi.ae/diwan/poem/74973","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110235","الطويل"],[2320,"","https://poetry.dctabudhabi.ae/diwan/poem/144650","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93399","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132562","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91793","الوافر"],[4009,"","https://poetry.dctabudhabi.ae/diwan/poem/20980","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/19012","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4832,"لطائف الحب أو مستطرف الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=166711",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5376,"يجوع الحرُ لا يرجو لَوَاكا","https://www.poetsgate.com/ViewPoem.aspx?id=204270",""],[5615,"ركبُ الرّحيل","https://www.poetsgate.com/ViewPoem.aspx?id=187988",""],[5997,"أباكَ","https://www.poetsgate.com/ViewPoem.aspx?id=214261",""]],"verses":[["أَباكِياً إِلفَهُ مِن بَعدِ فَرقَتِهِ","أَم جازِعاً لِلنَوى مِن قَبلِ أَن تَقعا",0,"ع",2,0],["أَبا كُلِّ طيبٍ لا أَبا المِسكِ وَحدَهُ","وَكُلَّ سَحابٍ لا أَخَصُّ الغَوادِيا",1,"ي",2,0],["أَباكَ وَقَد كانَ الوَليدُ أَرادَني","لِيَفعَلَ خَيراً أَو لِيُؤمِنَ أَوجَرا",2,"ر",2,0],["أَباكِرَةٌ في الظاعِنينَ رَميمُ","وَلَم يُشفَ مَتبولُ الفُؤادِ سَقيمُ",3,"م",1,1],["أَبا كَشكَشٍ لَمّا عَرَفتَ قَصائِدي","شَحَذتَ لَها في راحَتَيكَ زِنادُ",4,"د",1,0],["أَبا كَشكَشٍ وافَقتَ زَيداً لِفِعلِهِ","وَأَنتَ لِأُخرى وَالدَخيسُ عِيادُ",4,"د",1,0],["أَبا كَشكَشٍ لا تَدعُ فينا قَرابَةً","عَرَفتَ وَعِرفانُ القَبيحِ رَشادُ",4,"د",1,0],["أَبا كَرِبٍ لَم تُمسِ حبّى بَعيدَةً","فَما قَلبُ حُبّى عَن أَخيكَ بِمُبعَدِ",5,"د",1,0],["أَبا كَرِبٍ كِلني لِهَمِّ المُجاهِدِ","وَلا تَستَزِدني لَيسَ حُبّي بِزائِدِ",6,"د",1,1],["أَبا كَرِبٍ أَبلِغ لَدَيكَ رِسالَتي","أَبا جابِرٍ عَنّي وَلا تَدَعَن عَمرا",7,"ر",2,0],["أَبا كامِلٍ إِن غالَبَتكَ يَدُ الرَدى","وَلَم يُغنِكَ البَأسُ الَّذي لَيسَ يُدَّعا",8,"ع",2,0],["أبا كن للأيتام بعد أبيهم","فلم تعرف الأيتام ما العيشة الضنكا",9,"ك",2,0],["أُباكِرُها عند الشروقِ وتارةً","يُعاجلني بعد العشيّ غَبوقُها",10,"ق",3,0],["أبا كل مظلوم ومن لا أبا له","وغيث مغيثات أطلن التلددا",11,"د",2,0],["أباك وإخواناً له قد تتابعوا","وحق لهم من عبرة بنصيب",12,"ب",1,0],["أُباكرُ روضي يا ثريا فلا أرى","هزاري صداحاً على فنن البانِ",13,"ن",1,1],["أباً كان خيراً من أبيك أرومةً","وأوسط في سعدٍ وأرجح في الوزن",14,"ن",1,0],["أَباكية يَوماً وَلم يَأن وَقتُهُ","سينفد قَبلَ اليَومِ دَمعك فارفقي",15,"ق",2,0],["أبا كاظم ان الرثاء تعلة","وسلوة محزون به يتروح",16,"ح",1,0],["أُباكرُ للمدامة وَالنَدامى","وَيُسعدني الهَوى غَدواً وَروحا",17,"ح",2,0],["أَبا كَرِبٍ وَالأَيهَمَينِ كِلَيهِما","وَقَيساً بِأَعلى حَضرَمَوتَ اليَمانِيا",18,"ي",2,0],["أَباكِيَةٌ بَعدي جَنوبُ صَبابَةً","عَليَّ وَأُختاها بِماءِ عُيونِ",19,"ن",1,0],["أبا كل شيء قيل في وصفه حسن","إلى ذاك ينحو من كناك أبا الحسن",20,"ن",1,1],["أباك عرفان قوم لا وفاء لهم","فرب معرفة جرت إلى ندم",21,"م",1,0],["أباك صحبة أقوام إذا اصطحبوا","أخا لهم أنزلوه منزل الخدم",21,"م",1,0],["أباك ومن يهوى هداك ومنهمو","بنو عمك الأشياخ عما تحاوله",22,"ل",2,0],["أباكٍ في الهوى لما أباكا","فؤادٌ لم يُطعْ فينا أباكا",23,"ك",2,0],["أَ باكيَةَ العَينينِ ، عَيني لَكِ الفِدا","فإنَّ مُصَابي ، في الرَّحيلِ ، مُصابُ",24,"ب",1,0],["أباك أباْك لا تعصِ أباكَ","فما ناديْتهُ الِّإْ أتاكَ",25,"ك",1,1]]}