{"poems":[[75,"ثقي بي يا معذبتي فإني","https://www.aldiwan.net/poem11877.html","الوافر"],[10,"ألا ابلغ سليما وأشياعها","https://www.aldiwan.net/poem21136.html","المتقارب"],[90,"وأن أصدق برق أنت شائمه","https://www.aldiwan.net/poem44810.html","البسيط"],[91,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[63,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[92,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[101,"قدر أنتِ بشكل إمرأه","https://www.poetsgate.com/ViewPoem.aspx?id=14388",""],[123,"سأستجدي صغيراً من كبير","https://www.aldiwan.net/poem4351.html","الوافر"],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[185,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[266,"رؤوس العوالي للمعالي معاقل","https://www.aldiwan.net/poem38212.html","الطويل"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[411,"سل الله الغني تسأل جوادا","https://www.aldiwan.net/poem49996.html","الوافر"],[415,"أشمس الدولة اسمع بث شوق","https://www.aldiwan.net/poem32274.html","الوافر"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[447,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[463,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[494,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[563,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138352",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122754","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48647","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77669","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77594","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70835","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70806","البسيط"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34715","المتقارب"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137081",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137110",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205790","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204652",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112508","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112673","الرجز"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112377","الهزج"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89155","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89008","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114320","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77125","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[585,"يا رافع الصوت ينعى المفرد العلما","https://www.poetsgate.com/ViewPoem.aspx?id=161938",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5213,"الله يعلم اني منذ أبلغني","https://www.poetsgate.com/ViewPoem.aspx?id=170550",""],[5304,"اقف على درب المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=155912",""],[5324,"فأجمل قاتل أنت .","https://www.poetsgate.com/ViewPoem.aspx?id=207464",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5614,"الترحال","https://www.poetsgate.com/ViewPoem.aspx?id=1357",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5694,"واحد من المليار","https://www.poetsgate.com/ViewPoem.aspx?id=129911",""],[5792,"يحبونه","https://www.poetsgate.com/ViewPoem.aspx?id=180355",""],[5932,"صرخة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=37129",""],[5976,"شياطين الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=32795",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِن أَصبَحتِ قَد أَرضَيتِ قَوماً","بِسُخطي لَم يَكُن ذا فيكِ ظَنّي",0,"ن",2,0],["وَأَنّا صَبَحناهُمُ غارَةً","فَأَروَتهُمُ مِن نَقيعِ السِمامِ",1,"م",1,0],["وأن أصدق برق أنت شائمه","برق تنسَّم عنه الصارم الخَذِم",2,"م",1,1],["وأن أصيح مستغيثاً","من مضيض الألم",3,"م",1,0],["وإن أَصَخْتَ لتَغريدِ المديحِ فقد","وافَى مُغَرِّدُهُ وانحطَّ ناعبُه",4,"ب",2,0],["وَإِن أَصبَحَ المَجدُ التَليدُ لِفَقدِهِ","يَتيماً فَلا يَحزَن فَإِنَّكَ كافِلُه",5,"ل",2,0],["وإن إصلاحها إصلاح مملكة","وإن إهمالها موت وخسران",6,"ن",1,0],["وَإِنْ أصَابَ امْتِيَازاً قَلَّ مُدْرِكُهُ","لَدَى امْتَحَانٍ فَمَنْ يَجْدُرْ بِهِ يَصِبِ",7,"ب",1,0],["وإن أصدُقَنَّ \" فشوفي \" لهُ","عيونٌ من الشعرِ فيها حَوَر",8,"ر",1,0],["وأنا صوتكِ يا سيدتي","مثلما الآه امتداد الوَترِ",9,"ر",1,0],["وإن أَصفِر ليشربَ قالَ مَهلاً","أصِفرُ الجوفِ يشرَبُ بالصَفيرِ",10,"ر",1,0],["وأن أصور في القرطاس فتنته","لقالت الناس هذا منك بهتان",11,"ن",1,0],["وَأَنَّا صادِقُونَ إِذا فَخَرنَا","بَذَخنا فَوقَ بَذخِ البَاذِخِينا",12,"ن",2,0],["وان اصطبار المرء عند اقتداره","على الضد مهما امتاز للضد خاذل",13,"ل",1,0],["وَإِن أَصبحت تُرني عيونَ وسائلٍ","إِليك حسيراتٍ عَداها هُجودها",14,"د",3,0],["وإن أَصبحَ الأنصارُ عنّيَ غُيّباً","فناصرُ ديِنِ اللهِ لي منه ناصر",15,"ر",1,0],["وإن أصفاكَ سُلطانٌ بقُرب","فلا تُغْفِلْ تَرقُّبَكَ البِعادا",16,"د",2,0],["وإن أصبحتَ في خَلَدِي مُقيماً","بحيثُ يَجولُ فِكرِي من ضَمِيرِي",17,"ر",2,0],["وإنَّ اصطباري بعد طول بعادكم","دعا جلداً منه يبين التجلدا",18,"د",2,0],["وإن أصلي وداعاً قد دعوتك يا","رباه فاقبل وكن غوثي وملتحدي",19,"د",2,0],["وإن أَصفَى مَزادُكما فَمُدَّا","بأذنبةٍ هُنالكَ مُترَعاتِ",20,"ت",1,0],["وَإِنّا صبَحنا اليَزَنيَّةَ منكم","دَماً ثم رَوَّينا الصَفيحَ المُصَمَّما",21,"م",2,0],["وأنا صيده بغير شباك","لا حراكا لا نفرة لا صراخا",22,"خ",2,0],["وَإِن أَصابَ كَدَراً مَدَّ الكَدَر","سَنابِكُ الخَيلِ يُصَدِّ عْنَ الأَيَر",23,"ر",1,0],["وانا صداهم ليس لي فضل إذا","كررت قولا عنهمو منقولا",24,"ل",2,0],["وَإن أصابَكَ رَشُّ مِن غَمامَتِها","فالشّامِتُونَ إليهِم سَيلُها العَرِمُ",25,"م",1,0],["وإن أصبت فاتركي مَنْشورِيَهْ","في قبضتي لتسلمي بكورِيَهْ",26,"ه",1,0],["وإن أصبحت عندهم ذميماً","فإني عندك البر الحميد",27,"د",1,0],["وَإِن أَصابَتكَ يَد اِشتباهِ","فَاِركن إِلى العَقل وَالاِنتِباه",28,"ه",1,0],["وَإِن أُصيبوا بِدَواعي الفَقر","قالوا أُصِبنا بِدَواهي الدَهر",29,"ر",1,0],["وإنْ أصبر فلم أَسِطعْ","لما قد عيلَ من صبرى",30,"ر",2,0],["وإن أصَرَّ على الفعل القبيح أخو","لؤمٍ فلذة عيش الكلبِ في الجيَفِ",31,"ف",1,0],["وَإِن أَصلَحَ الحرمانُ من شَأنِ ناشىء","فَذلكمو الحِرمانُ نَوعٌ من البِرِّ",32,"ر",1,0],["وَإِن أَصبَحَت فَهيَ جَوّالَةٌ","كَغائِبَةٍ يَومَها شاهِدَه",33,"د",2,0],["وانا صدعت بامرك العالي بما","اوصيتني لما اتيت اودع",34,"ع",1,0],["وان اصغ بسوى علياك قافية","باي عذر الى علياك اعتذر",35,"ر",1,0],["وَإِن أَصلَدُوا يَوماً زِناداً فَإِنَّهُ","لَيُوري بِها نارَ الذَكاءِ المُحَرِّقِ",36,"ق",1,0],["وأناصب النفس العداء فتنطوي","ولربما يجني عليّ ثباتي",37,"ت",2,0],["وان أصلْ ربوتها","أصلِّ في محرابها",38,"ب",3,0],["وإن أصح ألفيت الحياة مجانة","بها مأتمى الباكى يقوم على عرسي",39,"س",2,0],["وإن أصبحت يوما بساحة مُنذر","يسوءُ صباحُ المنذرين ويكدرُ",40,"ر",1,0],["وان اصرت على فعل الشقاق فخذ","من اهلها حكما واعمد الى الحكم",41,"م",1,0],["وإن أصبت فتذكر ما جرى","على أولي العصمَة ساداتَُ الوَرى",42,"ر",2,0],["وإن أصيبوا فالحفظ حال قلوبهم","ومن أولى منهم بالأمور العظيمة",43,"ه",1,0],["وإن أصغى لصَوتِ النّا","يِ أشجَاهُ وأبكاهُ",44,"ا",2,0],["وإن أصبح الغلبان طوعاً لدهره","فكم بات مغلوباً لهمَّته الدهر",45,"ر",1,0],["وإن أصابت ليالي الحظ ذا أدبٍ","فإنَّ للبُلْهِ في وقتٍ إصاباتُ",46,"ت",1,0],["وَإِن أصَرِّح يَقُولُ اسمَح بِفَضلِكَ لِي","فَأنتَ فِي القَلبِ غَيرُ مَفصُولِ",47,"ل",1,0],["وَإِنَّ أَصعَبَ ما يُشقى الكِرامَ بِهِ","جُهدَ المُقِلِّ أَنّى في عَزمٍ مُقتَدَر",48,"ر",1,0],["وإنَّ أصولَ الدين ما جاءَ نَصُّه","بقرآنِ ربِّي وهو للحقِّ مبدعُ",49,"ع",1,0],["وإن أصدق تذكار يمثله","مصر التي مثلت من بعده الهمما",50,"م",2,0],["وإن أصغيت للسمار فيه","كمطويّ الضلوع على ضرام",51,"م",1,0],["وإن أصحرت بالحق لله مقولي","تنافر عني كل شاك وأعزل",52,"ل",1,0],["وان اصابت نظام الدين مديته","رجليك فهي بقلبي أثرت ألما",53,"م",2,0],["وانا صغيّر لكن الشوق عمّرك","ألبس شماغ الشيب والراس عدّاك",54,"ك",1,0],["وإنْ أصبَحتِ سكيناً","تُمَزِقُ فِيّ ماشِئتِ",55,"ت",1,0],["وإن أصرح أجامل في مواربةٍ","لأنهم يحملون الضيم في التهم",56,"م",1,0],["وأنا صابر ومتأمل على كل حال","عسى يوم من الفرقا يداويني",57,"ن",2,0],["وإنْ أصابَك مكروه فأنت إلى أل","أخوانِ تهْرعُ, ترجو لوْ تُمدُّ يَدُ",58,"د",1,0],["وأنا صوتي طويل ليا رقيت المئذنه وأذنت","يلجن الجبال وكل وادي تختفي جنه!",59,"ن",2,0],["وانا صدقت خلي في كلامه","اعرفه صاحبي كله مبادي",60,"د",2,0],["(و انا) (صوت غربه) حِلْمَهِ بْلاد تسمع له","(أنا) ( زهور ليلك) من بساتين مبتوره",61,"ر",2,0],["وانا صايم بشهر الخير .. ادوّر بس غفرانك","بلاني يا إله الكون .. عبيد ابليس .. جمهوره",62,"ر",2,0],["وأنا صلاةُ الفجرِ تشهقُ بعدما","ذُبِحَ المصَّلونَ الذينَ تَأَهَّبوا",63,"ب",3,0]]}