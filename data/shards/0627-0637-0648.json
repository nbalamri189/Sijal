الغيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81750&r=&rc=22",""]],"verses":[["أَطواقُ عارٍ إِن تَقَلَّدتُها","حَسَدتُ مِنها عُنُقَ العاطِلِ",0,"ل",1,0],["أَطوي البِلادَ إِلى ما لا أَذِلُ بِهِ","مِنَ البِلادِ وَما أَطوي عَلى خَطَرِ",1,"ر",1,0],["أَطْوي على ظِلٍّ قَصيرِ الخُطا","مَناسِمَ العيسِ المَطارِيبِ",2,"ب",1,0],["أَطوي فَيافي الفَلا وَاللَيلُ مُعتَكِرُ","وَأَقطَعُ البَيدَ وَالرَمضاءُ تَستَعِرُ",3,"ر",1,1],["أَطَورَينِ في عامٍ غَزاةٌ وَرِحلَةٌ","أَلا لَيتَ قَيساً غَرَّقَتهُ القَوابِلُ",4,"ل",1,0],["أَطوي شبابي للمشيب مراحلاً","برواحلِ الإصباح والإِمساءِ",5,"ا",2,0],["أطوى بِهِنَّ سُهُوبَ الأرض مُنْدَلثاً","على عرندسةٍ للخَرْق مِسبارُ",6,"ر",1,1],["أطوي على محض الوَلا مهجتي","وأنشر المدح بتبيان",7,"ن",1,0],["أَطوي الدياجي وَتَطويني عَلى جَزَعٍ","تَخشى اِفتِضاحي وَأَخشى الصُبحَ يَطويها",8,"ي",3,0],["أَطوعُ لأمرِ الحُبِّ طَوعَ مُسلِّمٍ","وَإِن كانَ مِن شأني إِباً وَنُفورُ",9,"ر",1,0],["أَطوي الضَميرَ عَلى حَرارَتِهِ","وَأَرومُ وَصلَ الحِبِّ في سِترِ",10,"ر",1,1],["أَطوادُ عِزٍّ فَوقَ أَنجَدَ نائِلٍ","وَكَأَنَّما بُركانُها نارُ القِرى",11,"ر",2,0],["أُطَوِّفَ ما أُتَوِّفُ ثُمَّ آوِي","إِلى بَيتٍ قَعيدَتُهُ لَكاعِ",12,"ع",1,1],["أَطوفُ بِقَصرِكُم في كُلِّ يَومٍ","كَأَنَّ لِقَصرِكُم خُلِقَ الطَوافُ",13,"ف",1,0],["أَطوي الشَكاةَ وَلا تُصَدِّقُني","وَإِذا اِشتَكَيتُ تَقولُ لي كَذَبا",14,"ب",2,0],["أَطوارُ دارِكَ بِعتَهُ مِن ظالِمٍ","وَالناسُ مِثلُ زَمانِهِم أَطوارُ",15,"ر",1,0],["أطوي الضلوع عَلى فؤاد خافق","وأعض من أسف عليك بناني",16,"ن",2,0],["أطوي الدّياجي وتطويني على جزع","تخشى افتضاحي وأخشى الصّبح يطويه",17,"ي",2,0],["أطوي مسارح طيره ومسابحاً","للحوت عبرَ طريقيَ المتشابكِ",18,"ك",1,0],["أَطْوِي نَهَارِي مُتْعَباً","أُحَيِّي الدُّجَى مُسْهَدَا",19,"د",2,0],["أَطوَلُ الحَياةِ إِذا","مُتَّ مِثلُ أَقصَرِها",20,"ر",3,0],["أَطْوَى الدُّجَى فَإِذَا ما الْيَأْسُ أَدْرَكَني","وَفَلَّ عَزْمِي بِسَيْفٍ مِنْهُ محدُودِ",21,"د",1,0],["اطوُوا مناهجكم، وخلُّ","وا الكُتْبَ تُخطئ أو تصيب",22,"ب",1,0],["أطوفُ به في صمته، وكأَنه","مُصَلى عتيقٌ لا تُقام شعائرهِ",23,"ر",2