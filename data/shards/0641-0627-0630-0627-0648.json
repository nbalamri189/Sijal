/diwan/poem/92020","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216827","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59473","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135643","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40099","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44730","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199060","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28701","الكامل"],[4935,"لاحت لعيني زهرة الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=129285",""],[5092,"على ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=139678",""],[5204,"فرجها دنّ بشوط","https://www.poetsgate.com/ViewPoem.aspx?id=200369",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5293,"تحذير","https://www.poetsgate.com/ViewPoem.aspx?id=186130",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5324,"خطاب ماكرة .","https://www.poetsgate.com/ViewPoem.aspx?id=207638",""],[5376,"بدرٌ أطاحَ بهيمَ ليلٍ ألْيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=202792",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5582,"قِفْ بِالدِّيارِ مُخاطِباً وَاسْتَخْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63518",""],[5612,"حجُّ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=205711",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5736,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=210606",""],[5881,"تلقاء مدين","https://www.poetsgate.com/ViewPoem.aspx?id=184317",""],[5956,"عِشْ مَعَ النباتِ والجمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=184145",""],[5956,"الجانبان","https://www.poetsgate.com/ViewPoem.aspx?id=193911",""],[6102,"العراب","https://www.poetsgate.com/ViewPoem.aspx?id=182907",""],[5309,"سكب الإباء على الفقير الواله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573725",""],[6237,"لكل صابونة ليفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77876&r=&rc=18",""]],"verses":[["فإذا وجَدْتُكَ نِلْتُ ما أمّلْتُهُ","أو لمْ أجِدْكَ فقدْ شَفَيتُ غَلِيلا",0,"ل",2,0],["فَإِذا وَعَدتُ الوَعدَ كُنتُ كَغارِمٍ","دَيناً أَقَرَّ بِهِ وَأَحضَرَ كاتِبا",1,"ب",2,0],["فَإذَا وَكَلْنَاهُمْ إلى أَسْقَامِهِمْ","عَرَتِ البِلاَدَ وَأَهْلَهَا الإسْقَامُ",2,"م",1,0],["فَإِذا وَطِئنَكَ يا أُخَيطِلُ وَطأَةً","لَم يَرجُ عَظمُكَ بَعدَهُنَّ جُبورا",3,"ر",2,0],["فَإِذا وَقَفتُ عَلى المَنازِلِ بِاللِوى","فاضَت دُموعي غَيرَ ذاتِ نِظامِ",4,"م",1,0],["فإذا وهبت ظلمت مالك مُحسناً","وإذا حكمت وزَنْت بالقسطاس",5,"س",1,0],["فإذا وُزنتم بالأباعدِ منكُمُ","كنتم ذُرىً والآخرون مَناسما",6,"م",2,0],["فَإِذا وَرائِيَ في الحَديقَةِ نابِحٌ","ضاري المَحاجِرِ ضامِرِ الأَحشاءِ",7,"ا",2,0],["فإذا وفدت على الوجود فكن أباً","أو كن خيالا في الوجود مشرَّدا",8,"د",2,0],["فَإِذا وَجَّهتَها نَحوَ طاغٍ","رَجَعَت تَرعَفُ مِنهُ قَناكَ",9,"ك",1,0],["فإذا وصلتَ خشيتُ منك قطيعةً","فالعيشُ أنت وَصُوله وَقَطُوعهُ",10,"ع",2,0],["فَإِذا وَذَلِكَ كانَ ظِلَّ سَحابَةٍ","نَفَحَت بِهِ في المُعصِراتِ دَبورُ",11,"ر",1,0],["فَإِذا وَليدَتُها فَقُلتُ لَها اِفتَحي","لِمُتَيَّمٍ صَبِّ الفُؤادِ مُصَيَّدِ",12,"د",1,0],["فَإِذا وَجَدتُ لَها وَساوِسَ سَلوَةٍ","شَفَعَ الضَميرُ إِلى الفُؤادِ فَسَلَّها",13,"ل",3,0],["فإذا وافقتْ مُنايَ تفاءَلْ","تُ وإلاَّ كذَّبتُ فيها ظنوني",14,"ن",2,0],["فإذا وقعن على الغديْ","ر ترتبتْ أسرابهنَّه",15,"ن",2,0],["فَإِذا وَرَدتَ مِناً فَغاياتُ المُنى","مَلقى جَرائِمَ في الحَياةِ كِبارِ",16,"ر",1,0],["فَإذِا وذلكَ يَا كُبَيْشَةُ لَمْ يَكُنْ","إِلاَّ كَحَلْمَةِ حَالِمٍ بِخَيَالِ",17,"ل",1,0],["فَإِذَا وَفى بِفُضُولِ مَا كسَبُوا لهُ","عَدَّ الذِي أَدى منَ الإِفضَالِ",18,"ل",1,0],["فَإِذَا وجَدْتَ الأَمْرَ مَقْضِيّاً","أَسَرَّكَ أَمْ شَجَاكْ",19,"ك",1,0],["فَإِذا وَنَى سَكَنَ الهَوَا","ءُ يَهزُّهُ هَزَّ السَّرِيرْ",20,"ر",1,0],["فإذا ودعت فرقة وتعفف","وإذا زهوت ولا أخال فأخلق",21,"ق",1,0],["فَإِذا وَصَلْتِ فَكُلُّ شَيْءٍ باسِمٌ","وإِذا هَجَرْتِ فكُل شَيْءٍ باكِي",22,"ك",2,0],["فَإذَا وَذَلِكَ لَيْسَ إلاَّ ذِكْرُهُ","وَإذَا مَضَى شَيْءٌ كَأَنْ لمْ يُفْعَلِ",23,"ل",1,0],["فإذا وُقيتِ، بحمدِ اللَّهِ، شِرّتَها","، فانجي، فَزارَ، إلى الأطوادِ، فاللُّوبِ",24,"ب",1,0],["فإذا ورَدْتَ مِنًى، فغاياتُ المُنى","مَلقَى جرائم، في الحياةِ، كِبار",25,"ر",1,0],["فإذا وقفت أمام حسنك صامتاً","فالصمت في حرم الجمال .. جمال",26,"ل",1,0],["فإذا وُزنتم بالأباعدِ منكُم","كنتم ذُراً والآخرون مَناسما",27,"م",2,0],["فَإِذا وَقَفت بِبابكم مُتَذَلِلاً","هَذا مَقام المُستَجير العائِذِ",28,"ذ",1,0],["فإذا وجَدْتَ لها بقلبك موضِعاً","أقدم إلى تزويجها برجاءِ",29,"ا",2,0],["فإذا ورَدت فماء أعذبِ مَوْرِد","وإذا صدَرتَ فرَوْح أفسحِ مَصدَرِ",30,"ر",1,0],["فَإِذا وَقَفت بِهِ فَصلِّ عَلى ثَرىً","سَكَبَت عَلَيهِ مَراحم الغفّارِ",31,"ر",1,0],["فإذا وقفت على الريا","ض الزاهرات الغزّلي",32,"ل",2,0],["فإذا وقفت على قبورهم","لم تعرف المولى من العبد",33,"د",1,0],["فإذا وثقتَ من الحبيبِ فربما","تجدِ الحبيبَ قدِ استحالَ عدوا",34,"د",3,0],["فإذا وصلتُم سالمينَ فبلّغوا","منّي السلام أهيلَ ذاك الوادي",35,"د",2,0],["فَإِذا وَيَومي في السَعادَةِ واحِدٌ","وَالناسُ في الأَيّامِ في يَومَينِ",36,"ن",1,0],["فإذا وفَوا لي بالودادِ وفى به","وإذا هُمُ غَدروا فقلبٌ غادِرُ",37,"ر",1,0],["فإذا وصلتَ إلى أغرِّ محَجَّبٍ","مخلوقةٍ كفّاهُ للإنفاقِ",38,"ق",1,0],["فإِذا وَصَفْتَ عُلاهُ قال لِيَ الوَرَى","للِّه ممدوحٌ ذَكَرْت وشاعِرُ",39,"ر",1,0],["فإذا وصلتُ ولم يُسعهم نائلي","لم يُرضِهم مني الذي أرضاني",40,"ن",2,0],["فإذا ونت فيها الرعود حدى بها","حادي الجنوب مقضقضاً جلجالها",41,"ل",3,0],["فإذا وسَمنَ على لئيم عرضَهُ","عاراً فليس لما عَلَطنَ نُصولُ",42,"ل",1,0],["فإذا وذلك ليس عندكِ نافعاً","لما مِللتِ وقلَّ منك نصيبي",43,"ب",2,0],["فإذا وعَوْا ما صُغْتُ من حِكَمٍ","فَضُلَ الجَهولُ وأذْعَن الفضل",44,"ل",1,0],["فإذا وائل طغتكين تذوكرت","أغنت سمات الجود عن أسمائها",45,"ا",3,0],["فَإِذا وَجَدتَ لِدِرهَمَيكَ حَلاوَةً","دَعها وَلا تَعبُر لَها بِرِياءِ",46,"ا",2,0],["فإذا وفى لك صاحب وغدرته","فاعلم بأن الله في المرصاد",47,"د",1,0],["فإذا وصلْتَ إِلى العَقيق فَقُلْ لهُمْ","قَلْبُ المتيم في الخيَامِ قَدْ انْبرَى",48,"ر",2,0],["فإذا وجدتك تغسلين فإنني","سأطير نحوك حالماً بتمتع",49,"ع",1,0],["فإذا وفَيْتَ لهم فأنت صديقهم","وإذا رعيتَهُمُ فأنت الجارُ",50,"ر",1,0],["فإذا وجهه ربيعٌ أنيقٌ","حين يصبو إلى الربيع الأنيق",51,"ق",1,0],["فَإِذا وَصَلت إِلَيهِ فَاِهنَأ بِالمُنى","فَلَقَد ظَفِرتَ بِما تَرومُ وتقصِدُ",52,"د",1,0],["فإذا وقفت وما قفوت","أتيت بالقلب السليمْ",53,"م",1,0],["فَإِذا وَنَت بالسيرِ لاحَ لِعينها","برقاً تألّق من مواهب حميرِ",54,"ر",1,0],["فاذا وصلتهم كان طودي راسخاً","وإذا قطعتم كان قاعاً صفصفا",55,"ف",2,0],["فإذا وصلت وقد بدت أعلامها","وشممت رائحة هنالك عاطرة",56,"ه",1,0],["فَإِذا وَلّى أَبو دُلَفٍ","وَلَّتِ الدُنيا عَلى أَثَرِه",57,"ر",2,0],["فَإِذا وَلّى حُمَيدٌ","فَعَلى الدُنيا السَلامُ",58,"م",1,0],["فإذا وزنتَ مقالَهُ بفعاله","فتوازنا فأخوك ذاك جمالُ",59,"ل",1,0],["فَإِذا وَصَفتُ لَها مُواصلَتي","فَزَعت حَداثَتُها إِلى الصَدِّ",60,"د",1,0],["فإذا وقفت على كلامي فاعتقد","تصديقه لا يغوك الكذاب",61,"ب",1,0],["فإذا وَهَبتَ له التَّأَمُّلَ لحظةً","تبدو إليك شَرَاسَةُ الحيوانِ",62,"ن",1,0],["فإِذا وَصلتُم لِلكَثِيب","فابكُوا بُكاءً مَع نَحِيب",63,"ب",1,0],["فإذا وقفت بها تذوب حشاشتي","شوقاً كأن الدار دار سعاد",64,"د",1,0],["فَإِذا وَذاكَ كَأَنَّهُ ما لَم يَكُن","إِلّا تَذَكّرهُ لِمَن لَم يَجهَلِ",65,"ل",1,0],["فإذا وقفت أمام ملكك منشداً","حسدت عظيم مقامي الجوزاء",66,"ا",2,0],["فَإِذا وَقَفتَ عَلى مَعالِمِ حاجِرٍ","وَقَطَعتَ أَغواراً بِها وَجِبالا",67,"ل",2,0],["فإذا وفي العبد المطيع بعهده","لله قامَ له الإله بحرمته",68,"ت",2,0],["فإذا وردن حِياضَه ورياضَه","وتربعت حيثُ الربيعُ الأوطفُ",69,"ف",1,0],["فَإِذا وَذلِكَ لَيسَ إِلّا حينَهُ","وَإِذا مَضى شَىءٌ كَأَنَّ لَم يُفعَلِ",70,"ل",1,0],["فَإِذا وَصَلتِ وَصَلتِ قَلبَ مُتَيَّمٍ","وَإِذا صَدَدتِ فَفي الصُدودِ هَلاكي",71,"ك",2,0],["فإذا ودك مم","ما كنت بالأمس تبيعه",72,"ه",1,0],["فَإِذا وَلَّى شَبابٌ","يَختَفي ذاكَ السّقام",73,"م",1,0],["فَإِذا وَقفت بِبابِهِ متشرفا","وصرفت عَن أَبوابه لَم أصرفِ",74,"ف",1,0],["فاذا وفيت إلى صديق منهمُ","أخلصت في ود له وسرائر",75,"ر",1,0],["فإذا ولاةُ الأمر راموا نفعها","عمدوا إلى دور العلوم فعمّروا",76,"ر",3,0],["فإذا وفاه الدهر نال وإن يخن","ما كان من ضرر ولا خسران",77,"ن",1,0],["فاذا وقفتَ فقف بقلب خاشعٍ","متبتلاً متأدباً كالعادهْ",78,"د",2,0],["فإذا وقفت تودع الحسن الذي","وارَيْتَه فرداً بغير نظير",79,"ر",1,0],["فإذا وهي قيد المروءة بينكم","فالخلق فوضى والدمار عتيد",80,"د",1,0],["فإذا وهبتُ فكلُّ قَفْزٍ مخصبٌ","وإذا نهبتُ فكلُّ ربعٍ بَلقعُ",81,"ع",1,0],["فإذا وصلت بها لتَحْذرْ سبحها","فسباحةٌ لو أمكنت يجري الفَلَكْ",82,"ك",1,0],["فإذا وقْعُ بَغْلَةٍ وغُلامٌ","يُفَرِّجُ الناسَ بين دَفْعٍ ولَهْزٍ",83,"ز",1,0],["فَإِذا وَصَفَتَ الناسَ قل","في حَقِّهم أَفعى وَعَقرَبْ",84,"ب",1,0],["فإذا وصلت إلى المدينة والحمى","فانزل فديتك مخبرا زوارا",85,"ر",2,0],["فإذا وصلت الحجرة الغرا فقل","يا سيدي عبد ببابك صارا",85,"ر",2,0],["فَإِذا وَفيتُم فَهيَ خَيرُ بِلادِكُم","وَإِذا غَدَرتُم فَهيَ سمٌّ مُنقَعُ",86,"ع",1,0],["فإذا وصلت أثبل سلع عرجن","سحراً على رحب الهنا الفيحاء",87,"ا",2,0],["فإذا وصلتُ فإنَّ قلبي متعبٌ","فأدورُ خلفيَ كي أداوي مهجتي",88,"ت",2,0],["فاذا واقعتها","فهو خرّوط ضروط",89,"ط",1,0],["فإذا وردْتَ الحَوْضَ ذُقْها كوْثرًا","عسَلاً مُصَفًّى فالنُّفوسُ ظِماءُ",90,"ا",2,0],["فإذا وقعت ولا وقعت ترقبي","عمرَ السجين يضيع في أغلاله",91,"ل",2,0],["فإذا وصلت وصلت كل مؤمل","وإذا قطعت قطعت كل جحود",92,"د",1,0],["فإذا وجدتكَ قد حزنت لعلّتي","سلوى أراكَ ..وبلسما القاكا",93,"ك",2,0],["فإذا وهنْت وخرَّ جنْحُك في السما","قُطِّعْتَ حتماً من شفارِ الفيصلِ",94,"ل",1,0],["فإذا وعيتَ كسرت قيد جهالة","أو أنْ تغورَ الى المذلة ساجدا",95,"د",2,0],["فَإِذا وَنَتْ فِي السَّيْرِ لاحَ لِعَيْنِها","بَرْقٌ تَأَلَّقَ مِنْ مَواهِبِ حِمْيَرِ",96,"ر",1,0],["فإذا وصلْتَ البيْتَ طُفْ سبْعاً بهِ","وارْوِ الظَّما في الحِجْرِ والأرْكانِ",97,"ن",1,0],["فإذا وصلْتَ السّوقَ رغْمَ زُحامِها","رنَّتْ مذكِّرةً بخبْزِ الصّاجِ !",98,"ج",1,0],["فإذا وردت حروفه ألفيتها","لك خيرُ زادٍ كي يطيب المرفأُ",99,"ا",1,0],["فإذا وصلت تركت بعض حكايتي","وشددت رحلي والمدى قنديلي",100,"ل",2,0],["فإذا وجدتَ من البهائم طيبةً","هذا شذوذٌ لا يشكِّلُ حُكْما",101,"م",2,0],["فإذا وَجَدْتَ لدى النبات أذيّة","هذا شذوذٌ ليس قاعدةٌ.. ولا..",102,"ل",2,0],["فَإِذا وَقَفتَ هُناكَ وَقفَةَ غافِلٍ","أَمسَيتَ قُربانًا عَلَى الأَنصابِ",103,"ب",1,0],["فَإِذا وَقَفتَ عَلى حَقيقَةِ حالِهِ","قُل لِلغَنِيِّ المُستَعِزِّ بِمالِهِ",104,"ه",1,0],["فإذا ولت الوظيفةُ ولوا","وأثاروا عليك حرباً عنيفةْ",105,"ف",2,0]]}