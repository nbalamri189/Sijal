0,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[400,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[400,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[406,"لي صديق أفضي إليه بسري","https://www.aldiwan.net/poem32321.html","الخفيف"],[407,"مضى لسبيله معن وأبقى","https://www.aldiwan.net/poem67484.html","الوافر"],[413,"زادك الله بهجة ووقارا","https://www.aldiwan.net/poem53883.html","الخفيف"],[413,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[429,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[429,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[434,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[434,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[436,"ولا في سرور العيد نحن مهنوه","https://www.aldiwan.net/poem34860.html","الطويل"],[436,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[441,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[447,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[459,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[459,"لم يدرجه إلى منصبه","https://www.aldiwan.net/poem15674.html","الرمل"],[459,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[459,"وكريم الملتقى ذو لسن","https://www.aldiwan.net/poem16152.html","الرمل"],[461,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[462,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[462,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[462,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[462,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[475,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[488,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[498,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[498,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[513,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[513,"بات يرعى السها بطرف مؤرق","https://www.aldiwan.net/poem12185.html","الخفيف"],[514,"أمعارف الدمن القفار توهم","https://www.aldiwan.net/poem48611.html","الكامل"],[527,"كذا فليكن رزء العلى والعوالم","https://www.aldiwan.net/poem37212.html","الطويل"],[536,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[536,"فقد الأحبة موقف كالموقف","https://www.aldiwan.net/poem47555.html","عموديه"],[536,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[536,"ما لمراكش تفيض سرورا","https://www.aldiwan.net/poem48173.html","عموديه"],[536,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[536,"إن تشا تحيى سعيدا","https://www.aldiwan.net/poem48212.html","عموديه"],[536,"عبد السلام ببلدة الحمراء","https://www.aldiwan.net/poem48306.html","عموديه"],[549,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[553,"ففر زهير خيفة من عقابنا","https://www.aldiwan.net/poem1924.html","الطويل"],[556,"إنني قائم بأمر الله","https://www.aldiwan.net/poem33629.html","الخفيف"],[556,"نشأة الروح بالغروب الطلوع","https://www.aldiwan.net/poem34385.html","الخفيف"],[556,"إن للكفر ظلمة في الوجود","https://www.aldiwan.net/poem34652.html","الخفيف"],[556,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[556,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[556,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أعملوا في هجوه الفكرا","https://www.aldiwan.net/poem2814.html","المديد"],[573,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[573,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"]],"verses":[["فَلَهُ هُنالِكَ لا عَلَيهِ إِذا","رَغَمَت أُنوفُ القَومِ للِتَعسِ",0,"س",1,0],["فَلَهَّفَ مِن حَسرَةٍ أُمَّهُ","وَوَلَّينَ مِن رَهَجٍ يَكتَسينا",1,"ن",2,0],["فَلَهفي عَلى تِلكَ الأَنامِلِ في البِلى","فَكَم نَسَجَت قَبلَ البِلى مِن مَفاخِرِ",2,"ر",1,0],["فَلِهَذا وَقَفتُ أَستَعطِفُ النا","سَ عَلى البائِسينَ في كُلِّ عامِ",3,"م",1,0],["فَلَهُ عَلى الدُنيا الجَديدَةِ نِعمَةٌ","يَشدو بِذِكرِ صَنيعِها الفَتَيانِ",4,"ن",1,0],["فَلَها مُقَلَّدُها وَمُقلَتُه","وَلَها عَلَيهِ سَراوَةُ الفَضلِ",5,"ل",1,0],["فَلَهُمْ وِدَادٌ صَادِقٌ مُتَقَادِمٌ","مَوْصُولَةٌ أَسْبَابُهُ بِوَتِينِي",6,"ن",2,0],["فَلَهُ الْيَوْمَ قِسْطُهُ","مِنْ خُلودٍ وَمِنْ عِظَمْ",7,"م",1,0],["فلهفي على بغداد إذ قد أضاعها","بنوها فسحقاً للبنين بها سحقا",8,"ق",2,0],["فلهذا نعم لهذا لهذا","نحن دَنّا بوحدة الديّان",9,"ن",1,0],["فلهذا نعم لهذا أهنّي","كل من حاز في العلوم أجازه",10,"ز",2,0],["فلهذا أقول قول معز","لك يرجو عمراً طويلاً سعيدا",11,"د",2,0],["فلهذا أجلّ عنها رجالا","شغلتهم علومهم بالدراسه",12,"س",2,0],["فَلَها هِبابٌ في الزِمامِ كَأَنَّها","صَهباءُ خَفَّ مَعَ الجَنوبِ جَهامُها",13,"م",3,0],["فَلَهُ إِذا وَنَتِ المَدامِعُ أَوهَمَت","عِصيانُ دَمعي فيهِ أَو عِصياني",14,"ن",2,0],["فَلَهفي عَلَيكَ غَداةَ الصَباحِ","إِذا هَتَفَت رَبَّةُ الهَودَجِ",15,"ج",1,0],["فَلَهفي عَلى الأَجلى سَليطٍ وَرَهطِهِ","وَلَهفي عَلى لَيثِ الغَريفِ أَبي جَبرِ",16,"ر",1,0],["فلهفي على دنيا العفاة تنكرت","ولهفي على ربع السماحة أقفرا",17,"ر",2,0],["فلهفي على آرائه","إليها الرماح السمر والعذب الصفر",18,"ر",1,0],["فلهذا في الجودِ حاكَى حبا الغي","ث وحاكى في البأسِ أسد العرين",19,"ن",1,0],["فَلَهُم لائمون فيما أتَوهُ","ورأوه لا يَعْدَموا اللَّوماءَ",20,"ا",2,0],["فله موضعٌ وفيه طَباخٌ","لبلاغٍ ذي مدة وانقضاءِ",21,"ا",2,0],["فلهمْ تَارَةً عِدَاتُ بُرُوقٍ","ولهم تارةً وَعِيدُ رُعُودِ",22,"د",1,0],["فله في عقل سامعه","عملٌ كالنفث في العُقَدِ",23,"د",1,0],["فله في القلوب ما لا نراه","في قلوب الهوى ولا أكبادِهْ",24,"د",2,0],["فلها الدَّهْرَ لاثِمٌ مُسْتَزيدٌ","ولها الدهر سامع مُسْتَعيدُ",25,"د",1,0],["فَلَهُ ناصر من اللَه إن جَا","دَ وإن لم يجُدْ فمن إبليس",26,"س",1,0],["فله من ناكة الروم ودٌّ","وله منهم أخوهم سواع",27,"ع",1,0],["فله إذا الأيام أشبه خيرها","يومُ الضعيفة صُبِّحت بطلاق",28,"ق",1,0],["فله في مهج العشْ","شاق حكمٌ واحتكامُ",29,"م",1,0],["فله منه حاجبٌ قد حماه","كلَّ عينٍ ترومه بامتهانِ",30,"ن",1,0],["فله من فعلكم أمثلةٌ","ينسِج الشعرُ عليها يُمَنه",31,"ن",2,0],["فلها مَعْقَدٌ بجيدي وثيق","وقرارٌ من ذات نفسي مكين",32,"ن",1,0],["فلهذا الأوانِ لا شك فيه","كنتَ علمي تروضها منذ حينِ",33,"ن",1,0],["فَلَهَوتُ لَيلَةَ ناعِمٍ ذي لَذَّةٍ","كَقَريرِ عَينٍ أَو كَناعِمِ بالِ",34,"ل",1,0],["فَلَهُ مِنَ الشَيخِ الأَصالَة وَالفَتى","إِقدامُهُ إِذ لِلفَتى أَوطارُ",35,"ر",1,0],["فَلَهُ في الغَربِ مَأثِرَةٌ","مِثلَها في التُركِ وَالعَجَمِ",36,"م",1,0],["فَلَهُ إِذا ذَكَرَ الدِيارَ وَأَهلَهُ","آهُ الغَريبِ وَأَبَّةُ الثَكَلانِ",37,"ن",1,0],["فله نواةٌ ذات نو","رٍ مشرقٍ وله ذوائب",38,"ب",1,0],["فَلَهُم وَقفَةٌ عَلى كُلِّ أَرضٍ","وَعَلى كُلِّ شاطِئٍ إِرساءُ",39,"ا",2,0],["فَلَهُ هَيبَةُ مَن لا يُتَرَجّى","وَلَهُ جودُ مُرَجّىً لا يُهابُ",40,"ب",1,0],["فَلَهُ بَنو عَبدِ العَزيزِ بنِ الرِضا","وَلِكُلِّ رَكبٍ عيسُهُم وَالفَدفَدُ",41,"د",1,0],["فَلَهُ كُلَّما أَتَتهُ أُمورٌ","مُشكِلاتٌ دَلائِلٌ مِن أُمورِ",42,"ر",1,0],["فَلَها أَن أُعينَها بِدُموعٍ","موقَفاتٍ عَلى الصَبابَةِ حُبسِ",43,"س",1,0],["فَلَهُ مِن مَدائِحي حوكمُهُ الأَو","فى وَلي مِن نَوالِهِ الغَمرِ حُكمي",44,"ي",1,0],["فلهذا أنت فيه","مبدىء ثم معيد",45,"د",1,0],["فلهُم عَزائِمُ ما امتضَيْنَ صَوارِماً","إلا جَلَيْنَ بها دُجى الأسيافِ",46,"ف",1,0],["فلهُ فيه اطِّرادٌ كامِنٌ","كاطِّرادِ الماءِ في العَضْبِ الذَّكَرْ",47,"ر",1,0],["فَلَهَونا وَنَعِمنا ثُمَّ لَم","يَدَعِ المَوتُ لِذي لُبٍّ فَرَح",48,"ح",1,0],["فَلَهُ الحَمدُ إِذ قَضاهُ عَلَينا","مُنزِلِ القَطرِ مِن مُتونِ السَحابِ",49,"ب",1,0],["فَلِهَذا قَطَعتُ عَتبي وَكُتبي","حَذَراً أَن أَرى الصُدودَ جَوابي",50,"ي",1,0],["فَلِهَذا أَصبَحتُ أَمنَحُكَ البُع","دَ وَعُذري تَعَذَّرُ الإِتِّفاقِ",51,"ق",1,0],["فَلِهَذا قَصَّرتُ في آدَبِ النَف","سِ وَطالَت بِهِ يَدي وَلِساني",52,"ي",1,0],["فَلِهَذا إِذا تَقادَمَ عَهدٌ","بَينَنا حُلتَ عَن وَفائي وَعَهدي",53,"د",2,0],["فَلِهَذا تَعَمَّقَت فيكَ أَقوا","مٌ بِأَقوالِهِم فَزانوا وَزادوا",54,"د",3,0],["فلها انتباهٌ في يديكَ وإنّها","لقطوف هامات الجُناةِ جَوانِ",55,"ن",1,0],["فَلِهَذا يَجِفُّ بَعدَ اِخضِرارٍ","قَبلَ رَوضِ الوِهادِ رَوضُ الرَوابي",56,"ب",2,0],["فلهُ عاداتُ سوءٍ","فاعلاتٌ فاعلاتُ",57,"ت",1,0],["فَلَها وَاِرتاحَ لِلخَودِ الَّتي","تَيَّمَت قَلبي بِذي طَعمٍ شَهي",58,"ي",1,0],["فَلَهَونا اللَيلَ حَتّى","هَجَمَ الصُبحُ هُجوما",59,"م",2,0],["فَلَهَونا لَيلَنا حَتّى إِذا","طَرَّبَ الديكُ وَهاجَ المُدَّكَر",60,"ر",1,0],["فَلَهُ حينَ يَقبِضُ المالُ كَفَّي","هِ وَيَمشي النَهارَ بالٌ رَخِيُّ",61,"ي",1,0],["فَلَهُ النّدى لا يدَّعِيهِ غَيرُهُ","إلاّ إذا كَذَبَ الغَمامُ المُسْبِل",62,"ل",1,0],["فَلَهُمْ كلُّ نِجادٍ مُرْتَدىً","ولهمْ كلُّ سليلٍ مُستَجاد",63,"د",1,0],["فلهُمْ ما انجابَ عنه فَجرُها","من قَليبٍ أو مَصادٍ أو مَراد",63,"د",1,0],["فَلَهَوتُ وَالظَلماءُ جاثِمَةٌ","بِالشَمسِ إِلّا أَنَّها جَسَدُ",64,"د",1,0],["فَلَهُ زَفرَةٌ إِلَيكِ وَشَوقٌ","حالَ بَينَ الهَوى وَبَينَ الهُجودِ",65,"د",1,0],["فَلَهَونا هَذي وَهَذي وَلَم نَأ","تِ حَراماً فيها وَلا تَفنيدا",66,"د",2,0],["فَلَهُ الفَضلُ حَيثُ كا","نَ عَلى مَن وَأى وَشَح",67,"ح",1,0],["فَلَهُنَّ الطَلاقُ مِنّي وَمِنّي","لَكِ طولُ الصَفاءِ وَالوُدِّ عَذبا",68,"ب",2,0],["فَلَهُ عَلَيَّ وَإِن تَجَنَّبَني","ما عِشتُ أَنّي لا أُجانِبُهُ",69,"ب",2,0],["فَلِهَذِهِ النَفسِ لَكَذوبِ تَشَوّفٌ","حَتّى تُكَفُّ عَنِ الأَذى بِهجارِ",70,"ر",1,0],["فَلَهُ مِنها عَلى أَحيانِها","صَفوَةُ الراحِ بِمَلذوذٍ خَصِر",71,"ر",1,0],["فَلَها الآنَ أُصَلّي قَبِلَتْ","ذاكَ مِنّي وهْيَ أرْضَى قِبْلَتي",72,"ي",1,0],["فله طورا خفاء","وله طورا ظهور",73,"ر",1,0],["فله الأرض ما لها من سكون","والسماوات ما بهنَّ فطور",74,"ر",1,0],["فلها مع الجَنفَ الذي ألقى بها","ودٌّ بقلبي نال من أجلادي",75,"د",2,0],["فَلَها مجاز في مجا","هلها تسير به وَمعدى",76,"د",2,0],["فلها الحمد بعد حمد الهي","ولها الشكر في مدى الأيام",77,"م",1,0],["فَلَهُ وَالشُّخُوصُ تُطْوَى نُشُورٌ","وَلَهُ وَالسِّنُونُ تَفْنَى دَوَامُ",78,"م",1,0],["فَلِهَذا العِقَابِ عَاوَدْتُ حُبِّي","وَلأَلْقَاهُ خُنْتُ عَهْداً وَثِيقَا",79,"ق",2,0],["فَلَهُ انْطِلاقُ النَّسْرِ لا","يَلْوِي بِشَيءٍ وَهْوَ سَامِي",80,"م",2,0],["فَلِهَذَا اخْتَارهُ صِنْواً لَهُمْ","وَهْوَ لاَ يَحْسَبُهُ أَحدثَ كُفْرَا",81,"ر",2,0],["فَلَهُ الذِّمَّةُ الَّتِي لَيْسَ تُوفَى","بِضُروبِ التَّكْرِيمٍ وَالتَّمْجِيدِ",82,"د",1,0],["فَلَهُ عِندَ المُؤَدِّبِ عِزٌّ","صَوتُ صَوّالٍ وَصيتُ وَصِيِّ",83,"ي",1,0],["فَلَها مُقَلَّدُها وَمُقلَتُها","وَلَها عَلَيهِ سَراوَةُ الفَضلِ",84,"ل",1,0],["فَلَهُ كُلَّ صَباحٍ في العِدى","وَقعَةٌ تَثلِمُ فيهِم وَتَهُدّ",85,"د",1,0],["فَلَهَوْنَا وفَرِحْنَا، ثمّ لَمْ","يَدَعِ المَوْتُ لذي اللّبّ فَرَحْ",86,"ح",1,0],["فله في الغرب مأثرة","مثلما في الترك والعجم",87,"م",1,0],["فله، إذا ذكر الدّيار واهله،","آه الغريب وأنّه الشّكلان",88,"ن",1,0],["فلهذِهِ النّفسِ الكَذوبِ تشَوّفٌ،","حتى تُكَفّ، عن الأذى، بهِجار",89,"ر",1,0],["فَلَهَوْنَا لَيْلَنا حَتَّى إذا","طَرَّبَ کلدِّيكُ وَهَاجَ المُدَّكِرْ",90,"ر",1,0],["فلهذا اضحى امام البرايا","وعليه في العارفين المعول",91,"ل",1,0],["فله كلاب أذية فرحوا بما","نقر الفراق عليه من جلجاله",92,"ل",2,0],["فلهذا رفعت قلباً بحسن الظ","ظن أمري للسيد المقبول",93,"ل",1,0],["فلهم قول كافرٍ ذي كنود","ولهم فعل راسخ الإيمان",94,"ن",1,0],["فلهُ من عزمتِهِ عَدَدٌ","ولهُ من نجدتِهِ عُدَدُ",95,"د",1,0],["فلها على سلْبِ الحشا","مع ضعفها أيّ اقتدارْ",96,"ر",1,0],["فَلَها العُتبى لَدَينا وَقَلَّت","أَبَداً حَتّى أَنالَ رِضاها",97,"ا",3,0],["فلها السَّرحَ بالبسالةِ يحمِى","ولها الفىءَ بالأما