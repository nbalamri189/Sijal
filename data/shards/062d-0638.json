{"poems":[[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[27,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[72,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[72,"ومهابة ذابت لها الفرسان ذوب","https://www.aldiwan.net/poem18738.html","الكامل"],[64,"دنيا تخادعني كأننى","https://www.aldiwan.net/poem67618.html","مجزوء الكامل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[78,"يا خبر من يلحظه ناظري","https://www.aldiwan.net/poem14166.html","السريع"],[89,"تلغى معاهدة واخرى تعقد","https://www.aldiwan.net/poem44875.html","الكامل"],[85,"حظوة اللورد قسمت","https://www.aldiwan.net/poem7292.html","مجزوء الخفيف"],[85,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[62,"قد كان لي في شبيبتي فرح","https://www.aldiwan.net/poem52490.html","المنسرح"],[61,"اصبر على مترادف الضراء","https://www.aldiwan.net/poem51830.html","الكامل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[69,"حظي حظ ناقص","https://www.aldiwan.net/poem28517.html","مجزوء الرجز"],[69,"أبائع حب القمح في وصل شادن","https://www.aldiwan.net/poem29011.html","الطويل"],[52,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"حظي من الخير منحوس وأعجب ما","https://www.aldiwan.net/poem63850.html","البسيط"],[46,"حظوظ فربع يحظى الغمام","https://www.aldiwan.net/poem22237.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54525","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[50,"حظي من الخبر منحوس وأعجب ما","https://www.poetsgate.com/ViewPoem.aspx?id=22610",""],[90,"يوم الجيش الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179194",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[46,"حُظوظٌ: فرَبْعٌ يُخطّى الغَمامَº","https://www.poetsgate.com/ViewPoem.aspx?id=18143",""],[109,"دمعي أسفا على شباب يجري","https://www.aldiwan.net/poem16661.html","الدوبيت"],[129,"أتملي من محاسنها","https://www.aldiwan.net/poem67436.html","المديد"],[135,"حظيت راحتي برسمك حفني","https://www.aldiwan.net/poem49076.html","الخفيف"],[182,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[182,"هتفت تبشر بالضحى الأطيار","https://www.aldiwan.net/poem67069.html","الكامل"],[186,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[186,"قد زادني أدب يمشي على قدم","https://www.aldiwan.net/poem43620.html","البسيط"],[186,"قالوا أتى العيد قلت العيد عادته","https://www.aldiwan.net/poem43794.html","البسيط"],[186,"في كل منقلب غيظ أساء به","https://www.aldiwan.net/poem43798.html","البسيط"],[186,"حظ بالمال النعيم رجال","https://www.aldiwan.net/poem43926.html","الخفيف"],[186,"حظ الفتى مما أتاه","https://www.aldiwan.net/poem43955.html","مجزوء الكامل"],[198,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[204,"نفس المحب دواؤها في دائها","https://www.aldiwan.net/poem53154.html","الكامل"],[235,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[235,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[235,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[235,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[261,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[270,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[270,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[275,"سما بأمرك إسعاد وإنجاد","https://www.aldiwan.net/poem25589.html","البسيط"],[282,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[285,"إلى العطف حركنا الركاب وعرجنا","https://www.aldiwan.net/poem39354.html","الطويل"],[364,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[364,"حظ من النصر والتأييد معتاد","https://www.aldiwan.net/poem60927.html","البسيط"],[364,"أأراكة الوادي سقتك غيوث","https://www.aldiwan.net/poem60972.html","الكامل"],[406,"أرى دهري تفضل واستفادا","https://www.aldiwan.net/poem50182.html","الوافر"],[409,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[409,"يا دار إن بخلت على","https://www.aldiwan.net/poem32500.html","مجزوء الكامل"],[409,"ذكر الوفاء خيالك المنتاب","https://www.aldiwan.net/poem32619.html","الكامل"],[410,"نواضر غلبا قد تدانت رءوسها","https://www.aldiwan.net/poem67525.html","الطويل"],[432,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[432,"اقطع مؤاخاة أخ جاف","https://www.aldiwan.net/poem12673.html","السريع"],[437,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[441,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[453,"ليس منا قال الحسود المعنى","https://www.aldiwan.net/poem61347.html","الخفيف"],[458,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[458,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[458,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[458,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[458,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[458,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[461,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[461,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[461,"حظرت على الحي نظم المدي","https://www.aldiwan.net/poem15688.html","المتقارب"],[464,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[477,"لاترض وجدك في أهل الهوى وسطا","https://www.aldiwan.net/poem15201.html","البسيط"],[500,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[500,"بروح رسول الله ينهج للرب","https://www.aldiwan.net/poem38083.html","الطويل"],[504,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[506,"صبرت على غدر الزمان وحقده","https://www.aldiwan.net/poem2440.html","الطويل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"حمائم شوق في الغصون تنوح","https://www.aldiwan.net/poem33554.html","الطويل"],[558,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"]],"verses":[["حَظُّ سِنُّ اِمرِئٍ نَأى مِنكَ قَرعٌ","وَقُصارى بَنانِهِ تَعضيضُ",0,"ض",1,0],["حظيت بملء العين حسناً وروعةً","عروس كبعض الحور جاد بها الخلد",1,"د",1,0],["حُظْوَةٌ لِلغَنِيِّ أُوتِيَ أنْ","يُقْرِضَ اللهَ وَهْوَ عَنْهُ غَنِي",2,"ن",2,0],["حَظُّهُ مِنْ سُرُورِ مَنْ سُرَّ فِيهِمْ","حَظُّهُ مِنْ سَقَامِ كُلِّ سَقِيمِ",3,"م",1,0],["حَظُّ الأُخَيطِلِ مِن تَلَمُّسِهِ الرِشا","في الرَأسِ لامِعَةُ الفَراشِ دَحولُ",4,"ل",1,0],["حظي من الدنيا هواي بجفنها","يا شقوتي منها بحظ أسود",5,"د",1,0],["حظٌّ توعَّرت المسالك نحوه","فإذا جريتُ وراءه أتعثر",6,"ر",1,0],["حَظَرَ الإِلَهُ حَرامَها","وَأَنا اِجتَنَبتُ حَلالَها",7,"ل",3,0],["حظي من الأسبوع لا تَنْسَهُ","ولا يكونَنْ سهميَ الأخيبا",8,"ب",2,0],["حَظُّ غيري من وصلكُمْ قُرَّةُ العيْ","ن وحظيِّ البكاءُ والتَّسْهيدُ",9,"د",1,0],["حَظي مما عندكم تافهٌ","وحظكُم من وُدِّيَ الأوفر",10,"ر",1,0],["حظيت وفازت من أنامل سيّدٍ","نفع المسود فساد باستحقاق",11,"ق",1,0],["حظِّيَ من لؤلؤيْك منعُك مَنْ","ظومَك منّي وتارة بدَدَكْ",12,"ك",1,0],["حظُّهم وافرٌ من الروحِ روحِ ال","لَهِ لا وافرٌ من الصلصالِ",13,"ل",1,0],["حَظِّيَ مِنهُ حَظُّ وَردِ الرُبى","مِن عِطرِهِ الفَوّاحِ وَالسَوسَنِ",14,"ن",1,0],["حَظُّكَ مِن شكريَ يا سيدي","بِما بَدا لي منك مَوفورُ",15,"ر",1,0],["حظروا عليه ان يقول مصرحا","فكأنه السيف الجراز المغمد",16,"د",1,0],["حظوة اللورد قُسمت","بين فتحي وبيرم",17,"م",1,1],["حَظُّها اليَومَ هَدَّةٌ وَقَديماً","صُرِّفَت في الحُظوظِ رَفعاً وَخَفضا",18,"ض",2,0],["حَظٌّ رَجَونا الخَيرَ مِن إِقبالِهِ","عاثَ المُفَرِّقُ فيهِ حَتّى أَدبَرا",19,"ر",2,0],["حظٌّ تولَّى فلستُ أُدرِكُهُ","إلّا بعونٍ من ابنةِ العنَبِ",20,"ب",1,0],["حَظَرَ الطبيبُ عليه طيبَ غِذائِه","وأباحَه مكروهَ كلِّ غِذاءِ",21,"ا",2,0],["حَظٌّ تَعاوَرَهُ البِقاعُ لِوَقتِهِ","وادٍ بِهِ صِفرٌ وَوادٍ مُفعَمُ",22,"م",1,0],["حظِّي حظٌّ ناقصٌ","مِنْ أصدقائي والعدى",23,"د",2,1],["حظيتَ بردِّ العجزِ للصبر فاحتقرْ","قليبَ حُبوب في حبيبِ قلوبِ",24,"ب",1,0],["حَظٌّ مَضى ما كُنتُ أَعرِفُ قَدرَهُ","حَتّى اِنتَهى فَعَرَفتُهُ حينَ اِنتَهى",25,"ه",2,0],["حَظٌّ مِنَ الدُنيا مَضى","لَو كانَ مَنعٌ أَو شِفا",26,"ف",2,0],["حَظيَ المسجدُ الحرامُ بمَمْشا","ها ولم يَنْس حَظه إِيلِيَاءُ",27,"ا",2,0],["حَظّي مِنَ الخَيرِ مَنحوسٌ وَأَعجَبُ ما","إِنّي أَراهُ عَلى الحِرمانِ مَحسودُ",28,"د",1,1],["حُظوظٌ فَرَبعٌ يُحَظّى الغَمامَ","وَربَعٌ يُجادُ وَرَبعٌ يُدَث",29,"ث",1,1],["حظروا علي لغير ذنب جئته","في موطني ما لَيسَ بالمَحظور",30,"ر",1,0],["حظي هُوَ الَّذي","من العمى عثر",31,"ر",1,0],["حَظُّ مِصْرَ قَضَى بِأَنْ تخْلُدَ الأَرْمَا","سُ فِيهَا وَتَهْوِيَ الأَعْلامُ",32,"م",1,0],["حَظُّ هَذَا القِرَانِ مِنْ نِعَمِ اللهِ","وَحَظُّ القِرَانِ للأَكُفَّاءِ",33,"ا",2,0],["حظُّ النبوغ لديهِ","أن لا ينالَ ثوابا",34,"ب",2,0],["حظي من الخبر منحوس وأعجب ما","إني أراه على الحرمان محسود",35,"د",1,1],["حظايا ترجى نظرةً منك أيَّها","تُريدُ وأيَّاً تنتقي وتَخَيَّر",36,"ر",1,0],["حَظٌّ من الموتِ محسودٌ خُصِصتَ به","والموتُ كالعيش مابين الورى قَسَم",37,"م",1,0],["حُظوظٌ: فرَبْعٌ يُخطّى الغَمامَº","وربْعٌ يجادُº وربعٌ يُدَثّ",38,"ث",1,1],["حَظي أَبَداً تَراهُ في نَومِهِ","لا يُوقظهُ ضَجيج يَوم الحَشر",39,"ر",1,0],["حَظِيَت منها شَواعِرهُ","بضِياءِ الصُبحِ والبِشر",40,"ر",1,0],["حظيتْ راحتي برسمك حفني","مثلما فاز بالمسرة صدري",41,"ي",1,1],["حَظٌّ أَصابَتهُ لَدَيكَ وَهَكَذا","ما زالَ دَأبُكَ في الوَرى أَن تَعدِلا",42,"ل",2,0],["حَظٌّ بِهِ بَيروتَ راقَ صَفاؤُها","وَتَزحزَحَت عَن أُفقِها الأَكدارُ",43,"ر",1,0],["حظي من النوم بعد الهجعة الأرقُ","ومن نهاري على أنبائه القلقُ",44,"ق",1,1],["حظّي به معشر خسّت نفوسهمُ","مثل البهائم حرّ فيهم حرفُ",45,"ف",1,0],["حظي من العيد بعد الأجر رحمته","مع الغبار وأكل الخبز بالصبر",46,"ر",1,0],["حظّ الأديب اللبيب الماء والكسر","وحظّ ذي الجهل فيه المال والبدر",47,"ر",1,0],["حظّ بالمال النعيم رجال","لم ينالوا من عمرهم ما أرادوا",48,"د",3,1],["حظّ الفتى ممّا أتا","هُ الله في الدنيا معاده",49,"د",2,1],["حظّي من الأيام نَدبٌ به","يُرْأَبُ ما يُصْدَعُ أو يُشْعَبُ",50,"ب",1,0],["حظُّ الرجال من النساء بأن يُرى","أحرارُ سادتها عبيدَ إمائها",51,"ا",3,0],["حَظراً عَلَيَّ وَقَد غِب","تُ مَع سِواكَ الحُضورُ",52,"ر",1,0],["حَظَرتَ عَلى مُقلَتَيَّ الرُقادَ","وَحَلَّلتَ سَفكَ دَمي وَهوَ حُجرُ",53,"ر",1,0],["حَظُّهُ مِنكَ حَظُّنا مِنهُ فَاِلبَس","هُ وَعَيَّد فيهِ بِطائِرِ سَعدِ",54,"د",1,0],["حَظَرتُ عَليها النَومَ بَعدَ فِراقِكُمُ","فَما يَلتَقي أَو يَلتَقي الهُدبُ وَالهُدبُ",55,"ب",