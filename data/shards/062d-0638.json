{"poems":[[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[27,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[72,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[72,"ومهابة ذابت لها الفرسان ذوب","https://www.aldiwan.net/poem18738.html","الكامل"],[64,"دنيا تخادعني كأننى","https://www.aldiwan.net/poem67618.html","مجزوء الكامل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[78,"يا خبر من يلحظه ناظري","https://www.aldiwan.net/poem14166.html","السريع"],[89,"تلغى معاهدة واخرى تعقد","https://www.aldiwan.net/poem44875.html","الكامل"],[85,"حظوة اللورد قسمت","https://www.aldiwan.net/poem7292.html","مجزوء الخفيف"],[85,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[62,"قد كان لي في شبيبتي فرح","https://www.aldiwan.net/poem52490.html","المنسرح"],[61,"اصبر على مترادف الضراء","https://www.aldiwan.net/poem51830.html","الكامل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[69,"حظي حظ ناقص","https://www.aldiwan.net/poem28517.html","مجزوء الرجز"],[69,"أبائع حب القمح في وصل شادن","https://www.aldiwan.net/poem29011.html","الطويل"],[52,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"حظي من الخير منحوس وأعجب ما","https://www.aldiwan.net/poem63850.html","البسيط"],[46,"حظوظ فربع يحظى الغمام","https://www.aldiwan.net/poem22237.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54525","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[50,"حظي من الخبر منحوس وأعجب ما","https://www.poetsgate.com/ViewPoem.aspx?id=22610",""],[90,"يوم الجيش الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179194",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[46,"حُظوظٌ: فرَبْعٌ يُخطّى الغَمامَº","https://www.poetsgate.com/ViewPoem.aspx?id=18143",""]],"verses":[["حَظُّ سِنُّ اِمرِئٍ نَأى مِنكَ قَرعٌ","وَقُصارى بَنانِهِ تَعضيضُ",0,"ض",1,0],["حظيت بملء العين حسناً وروعةً","عروس كبعض الحور جاد بها الخلد",1,"د",1,0],["حُظْوَةٌ لِلغَنِيِّ أُوتِيَ أنْ","يُقْرِضَ اللهَ وَهْوَ عَنْهُ غَنِي",2,"ن",2,0],["حَظُّهُ مِنْ سُرُورِ مَنْ سُرَّ فِيهِمْ","حَظُّهُ مِنْ سَقَامِ كُلِّ سَقِيمِ",3,"م",1,0],["حَظُّ الأُخَيطِلِ مِن تَلَمُّسِهِ الرِشا","في الرَأسِ لامِعَةُ الفَراشِ دَحولُ",4,"ل",1,0],["حظي من الدنيا هواي بجفنها","يا شقوتي منها بحظ أسود",5,"د",1,0],["حظٌّ توعَّرت المسالك نحوه","فإذا جريتُ وراءه أتعثر",6,"ر",1,0],["حَظَرَ الإِلَهُ حَرامَها","وَأَنا اِجتَنَبتُ حَلالَها",7,"ل",3,0],["حظي من الأسبوع لا تَنْسَهُ","ولا يكونَنْ سهميَ الأخيبا",8,"ب",2,0],["حَظُّ غيري من وصلكُمْ قُرَّةُ العيْ","ن وحظيِّ البكاءُ والتَّسْهيدُ",9,"د",1,0],["حَظي مما عندكم تافهٌ","وحظكُم من وُدِّيَ الأوفر",10,"ر",1,0],["حظيت وفازت من أنامل سيّدٍ","نفع المسود فساد باستحقاق",11,"ق",1,0],["حظِّيَ من لؤلؤيْك منعُك مَنْ","ظومَك منّي وتارة بدَدَكْ",12,"ك",1,0],["حظُّهم وافرٌ من الروحِ روحِ ال","لَهِ لا وافرٌ من الصلصالِ",13,"ل",1,0],["حَظِّيَ مِنهُ حَظُّ وَردِ الرُبى","مِن عِطرِهِ الفَوّاحِ وَالسَوسَنِ",14,"ن",1,0],["حَظُّكَ مِن شكريَ يا سيدي","بِما بَدا لي منك مَوفورُ",15,"ر",1,0],["حظروا عليه ان يقول مصرحا","فكأنه السيف الجراز المغمد",16,"د",1,0],["حظوة اللورد قُسمت","بين فتحي وبيرم",17,"م",1,1],["حَظُّها اليَومَ هَدَّةٌ وَقَديماً","صُرِّفَت في الحُظوظِ رَفعاً وَخَفضا",18,"ض",2,0],["حَظٌّ رَجَونا الخَيرَ مِن إِقبالِهِ","عاثَ المُفَرِّقُ فيهِ حَتّى أَدبَرا",19,"ر",2,0],["حظٌّ تولَّى فلستُ أُدرِكُهُ","إلّا بعونٍ من ابنةِ العنَبِ",20,"ب",1,0],["حَظَرَ الطبيبُ عليه طيبَ غِذائِه","وأباحَه مكروهَ كلِّ غِذاءِ",21,"ا",2,0],["حَظٌّ تَعاوَرَهُ البِقاعُ لِوَقتِهِ","وادٍ بِهِ صِفرٌ وَوادٍ مُفعَمُ",22,"م",1,0],["حظِّي حظٌّ ناقصٌ","مِنْ أصدقائي والعدى",23,"د",2,1],["حظيتَ بردِّ العجزِ للصبر فاحتقرْ","قليبَ حُبوب في حبيبِ قلوبِ",24,"ب",1,0],["حَظٌّ مَضى ما كُنتُ أَعرِفُ قَدرَهُ","حَتّى اِنتَهى فَعَرَفتُهُ حينَ اِنتَهى",25,"ه",2,0],["حَظٌّ مِنَ الدُنيا مَضى","لَو كانَ مَنعٌ أَو شِفا",26,"ف",2,0],["حَظيَ المسجدُ الحرامُ بمَمْشا","ها ولم يَنْس حَظه إِيلِيَاءُ",27,"ا",2,0],["حَظّي مِنَ الخَيرِ مَنحوسٌ وَأَعجَبُ ما","إِنّي أَراهُ عَلى الحِرمانِ مَحسودُ",28,"د",1,1],["حُظوظٌ فَرَبعٌ يُحَظّى الغَمامَ","وَربَعٌ يُجادُ وَرَبعٌ يُدَث",29,"ث",1,1],["حظروا علي لغير ذنب جئته","في موطني ما لَيسَ بالمَحظور",30,"ر",1,0],["حظي هُوَ الَّذي","من العمى عثر",31,"ر",1,0],["حَظُّ مِصْرَ قَضَى بِأَنْ تخْلُدَ الأَرْمَا","سُ فِيهَا وَتَهْوِيَ الأَعْلامُ",32,"م",1,0],["حَظُّ هَذَا القِرَانِ مِنْ نِعَمِ اللهِ","وَحَظُّ القِرَانِ للأَكُفَّاءِ",33,"ا",2,0],["حظُّ النبوغ لديهِ","أن لا ينالَ ثوابا",34,"ب",2,0],["حظي من الخبر منحوس وأعجب ما","إني أراه على الحرمان محسود",35,"د",1,1],["حظايا ترجى نظرةً منك أيَّها","تُريدُ وأيَّاً تنتقي وتَخَيَّر",36,"ر",1,0],["حَظٌّ من الموتِ محسودٌ خُصِصتَ به","والموتُ كالعيش مابين الورى قَسَم",37,"م",1,0],["حُظوظٌ: فرَبْعٌ يُخطّى الغَمامَº","وربْعٌ يجادُº وربعٌ يُدَثّ",38,"ث",1,1]]}