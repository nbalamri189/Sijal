te.com/ViewPoem.aspx?id=130612",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[6068,"قالت: أتظلمني -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175971",""],[4442,"هي الذكوات البيض من جانب الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=171009",""],[6115,"سرع ما رحت ياشهر الصيامي","https://www.poetsgate.com/ViewPoem.aspx?id=180970",""],[1923,"حظيت وقد صلف النساء سواها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599509",""],[186,"أمنازل الأحباب ما فعل الألى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55792&r=&rc=55",""],[5355,"طرق مسدودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86677&r=&rc=0",""],[463,"لمنْ طالعاتٌ في السراب أفولُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60278&r=&rc=334",""]],"verses":[["حَظُّ سِنُّ اِمرِئٍ نَأى مِنكَ قَرعٌ","وَقُصارى بَنانِهِ تَعضيضُ",0,"ض",1,0],["حظيت بملء العين حسناً وروعةً","عروس كبعض الحور جاد بها الخلد",1,"د",1,0],["حُظْوَةٌ لِلغَنِيِّ أُوتِيَ أنْ","يُقْرِضَ اللهَ وَهْوَ عَنْهُ غَنِي",2,"ن",2,0],["حَظُّهُ مِنْ سُرُورِ مَنْ سُرَّ فِيهِمْ","حَظُّهُ مِنْ سَقَامِ كُلِّ سَقِيمِ",3,"م",1,0],["حَظُّ الأُخَيطِلِ مِن تَلَمُّسِهِ الرِشا","في الرَأسِ لامِعَةُ الفَراشِ دَحولُ",4,"ل",1,0],["حظي من الدنيا هواي بجفنها","يا شقوتي منها بحظ أسود",5,"د",1,0],["حظٌّ توعَّرت المسالك نحوه","فإذا جريتُ وراءه أتعثر",6,"ر",1,0],["حَظَرَ الإِلَهُ حَرامَها","وَأَنا اِجتَنَبتُ حَلالَها",7,"ل",3,0],["حظي من الأسبوع لا تَنْسَهُ","ولا يكونَنْ سهميَ الأخيبا",8,"ب",2,0],["حَظُّ غيري من وصلكُمْ قُرَّةُ العيْ","ن وحظيِّ البكاءُ والتَّسْهيدُ",9,"د",1,0],["حَظي مما عندكم تافهٌ","وحظكُم من وُدِّيَ الأوفر",10,"ر",1,0],["حظيت وفازت من أنامل سيّدٍ","نفع المسود فساد باستحقاق",11,"ق",1,0],["حظِّيَ من لؤلؤيْك منعُك مَنْ","ظومَك منّي وتارة بدَدَكْ",12,"ك",1,0],["حظُّهم وافرٌ من الروحِ روحِ ال","لَهِ لا وافرٌ من الصلصالِ",13,"ل",1,0],["حَظِّيَ مِنهُ حَظُّ وَردِ الرُبى","مِن عِطرِهِ الفَوّاحِ وَالسَوسَنِ",14,"ن",1,0],["حَظُّكَ مِن شكريَ يا سيدي","بِما بَدا لي منك مَوفورُ",15,"ر",1,0],["حظروا عليه ان يقول مصرحا","فكأنه السيف الجراز المغمد",16,"د",1,0],["حظوة اللورد قُسمت","بين فتحي وبيرم",17,"م",1,1],["حَظُّها اليَومَ هَدَّةٌ وَقَديماً","صُرِّفَت في الحُظوظِ رَفعاً وَخَفضا",18,"ض",2,0],["حَظٌّ رَجَونا الخَيرَ مِن إِقبالِهِ","عاثَ المُفَرِّقُ فيهِ حَتّى أَدبَرا",19,"ر",2,0],["حظٌّ تولَّى فلستُ أُدرِكُهُ","إلّا بعونٍ من ابنةِ العنَبِ",20,"ب",1,0],["حَظَرَ الطبيبُ عليه طيبَ غِذائِه","وأباحَه مكروهَ كلِّ غِذاءِ",21,"ا",2,0],["حَظٌّ تَعاوَرَهُ البِقاعُ لِوَقتِهِ","وادٍ بِهِ صِفرٌ وَوادٍ مُفعَمُ",22,"م",1,0],["حظِّي حظٌّ ناقصٌ","مِنْ أصدقائي والعدى",23,"د",2,1],["حظيتَ بردِّ العجزِ للصبر فاحتقرْ","قليبَ حُبوب في حبيبِ قلوبِ",24,"ب",1,0],["حَظٌّ مَضى ما كُنتُ أَعرِفُ قَدرَهُ","حَتّى اِنتَهى فَعَرَفتُهُ حينَ اِنتَهى",25,"ه",2,0],["حَظٌّ مِنَ الدُنيا مَضى","لَو كانَ مَنعٌ أَو شِفا",26,"ف",2,0],["حَظيَ المسجدُ الحرامُ بمَمْشا","ها ولم يَنْس حَظه إِيلِيَاءُ",27,"ا",2,0],["حَظّي مِنَ الخَيرِ مَنحوسٌ وَأَعجَبُ ما","إِنّي أَراهُ عَلى الحِرمانِ مَحسودُ",28,"د",1,1],["حُظوظٌ فَرَبعٌ يُحَظّى الغَمامَ","وَربَعٌ يُجادُ وَرَبعٌ يُدَث",29,"ث",1,1],["حظروا علي لغير ذنب جئته","في موطني ما لَيسَ بالمَحظور",30,"ر",1,0],["حظي هُوَ الَّذي","من العمى عثر",31,"ر",1,0],["حَظُّ مِصْرَ قَضَى بِأَنْ تخْلُدَ الأَرْمَا","سُ فِيهَا وَتَهْوِيَ الأَعْلامُ",32,"م",1,0],["حَظُّ هَذَا القِرَانِ مِنْ نِعَمِ اللهِ","وَحَظُّ القِرَانِ للأَكُفَّاءِ",33,"ا",2,0],["حظُّ النبوغ لديهِ","أن لا ينالَ ثوابا",34,"ب",2,0],["حظيرة مفتقد ما بها","هناء سوى صرخة الفاقده",35,"د",2,0],["حظي من الخبر منحوس وأعجب ما","إني أراه على الحرمان محسود",36,"د",1,1],["حظايا ترجى نظرةً منك أيَّها","تُريدُ وأيَّاً تنتقي وتَخَيَّر",37,"ر",1,0],["حَظٌّ من الموتِ محسودٌ خُصِصتَ به","والموتُ كالعيش مابين الورى قَسَم",38,"م",1,0],["حُظوظٌ: فرَبْعٌ يُخطّى الغَمامَº","وربْعٌ يجادُº وربعٌ يُدَثّ",39,"ث",1,1],["حَظي أَبَداً تَراهُ في نَومِهِ","لا يُوقظهُ ضَجيج يَوم الحَشر",40,"ر",1,0],["حَظِيَت منها شَواعِرهُ","بضِياءِ الصُبحِ والبِشر",41,"ر",1,0],["حظيتْ راحتي برسمك حفني","مثلما فاز بالمسرة صدري",42,"ر",2,1],["حَظٌّ أَصابَتهُ لَدَيكَ وَهَكَذا","ما زالَ دَأبُكَ في الوَرى أَن تَعدِلا",43,"ل",2,0],["حَظٌّ بِهِ بَيروتَ راقَ صَفاؤُها","وَتَزحزَحَت عَن أُفقِها الأَكدارُ",44,"ر",1,0],["حظي من النوم بعد الهجعة الأرقُ","ومن نهاري على أنبائه القلقُ",45,"ق",1,1],["حظّي به معشر خسّت نفوسهمُ","مثل البهائم حرّ فيهم حرفُ",46,"ف",1,0],["حظي من العيد بعد الأجر رحمته","مع الغبار وأكل الخبز بالصبر",47,"ر",1,0],["حظّ الأديب اللبيب الماء والكسر","وحظّ ذي الجهل فيه المال والبدر",48,"ر",1,0],["حظّ بالمال النعيم رجال","لم ينالوا من عمرهم ما أرادوا",49,"د",3,1],["حظّ الفتى ممّا أتا","هُ الله في الدنيا معاده",50,"د",2,1],["حظّي من الأيام نَدبٌ به","يُرْأَبُ ما يُصْدَعُ أو يُشْعَبُ",51,"ب",1,0],["حظُّ الرجال من النساء بأن يُرى","أحرارُ سادتها عبيدَ إمائها",52,"ا",3,0],["حَظراً عَلَيَّ وَقَد غِب","تُ مَع سِواكَ الحُضورُ",53,"ر",1,0],["حَظَرتَ عَلى مُقلَتَيَّ الرُقادَ","وَحَلَّلتَ سَفكَ دَمي وَهوَ حُجرُ",54,"ر",1,0],["حَظُّهُ مِنكَ حَظُّنا مِنهُ فَاِلبَس","هُ وَعَيَّد فيهِ بِطائِرِ سَعدِ",55,"د",1,0],["حَظَرتُ عَليها النَومَ بَعدَ فِراقِكُمُ","فَما يَلتَقي أَو يَلتَقي الهُدبُ وَالهُدبُ",56,"ب",1,0],["حظها في العلى العطاء من الفضل","وحظى الحضيض والحرمان",57,"ن",1,0],["حظّي كحظّكِ في الشقاوةِ والهوى","فلتمتزج لتعاونٍ روحانا",58,"ن",2,0],["حظيتَ الحظوة الكبرى جزاءاً","لما أُوتيتَ من خُلُقٍ رضي",59,"ي",1,0],["حَظُّ اللواحِظ تَهجاعٌ تَقَرُّ بِهِ","وَحَظُّهُ مِنْكَ تَحتَ الليْلِ تَسْهادُ",60,"د",1,0],["حَظُّهُ يا مُبارِزَ الدينِ أَضحى","نائِماً دونَهُ وَأَنتَ عَليمُ",61,"م",1,0],["حظينا فزرنا روصة فاح طيبها","وبالشوق ودعنا الديار وأدلجنا",62,"ن",2,0],["حَظّي مِنَ الآدابِ أَسنى حَظِّ","وَالراحِ ما رَوَّقتُهُ مِن لَفظي",63,"ي",1,0],["حَظٌّ مِنَ النَصرِ وَالتَأييدِ مُعتادُ","وَرُتبَةٌ في العُلا وَالمَجدِ تَزدادُ",64,"د",1,1],["حَظٌّ رُزِقْتَ مَنالَهُ وحُرِمْتُه","والحَظُّ يَعجَلُ تارةً ويَريث",65,"ث",1,0],["حَظيت بِهِ فكنت هُناك قُسّاً","وَكانَ الناس كلهم إِيادا",66,"د",2,0],["حظَرَ الوفاءُ عليَّ أن أسلُو فلا","فُكَّ السُّلُوُّ من الغرامِ وَثَاقي