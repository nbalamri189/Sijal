,"https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5847,"المولد النبوي الشريف لعام 1435 ه","https://www.poetsgate.com/ViewPoem.aspx?id=176834",""],[5853,"دموعٌ وتوجع","https://www.poetsgate.com/ViewPoem.aspx?id=175615",""],[5939,"لا لن يموت أبي","https://www.poetsgate.com/ViewPoem.aspx?id=187199",""],[5943,"ماذا عسانا نرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=37271",""],[5956,"حقوقُ السَّائمةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183369",""],[6079,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=207375",""],[6097,"شَقائقُ ال\"نَيْسَانِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=190671",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[2220,"لا تعجلنّ فإنَّ الأمر حاصله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11430&r=&rc=304",""],[5126,"مرفوعة إلى صاحب الجلالة الملك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87829&r=&rc=44",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""]],"verses":[["وَالعُقابُ الشَغواءُ أَهبَطَها الني","قُ وَقَد أَرعَتِ النُجومَ سِماخا",0,"خ",2,0],["والعقْلُ كالبَحْرِ إن هالَتْكَ هيبتُهُ","فالشّعْرُ يسْبُرُ منْهُ مُنْتَهى العُمُقِ",1,"ق",1,0],["والعقل يثني عليه الركب وا أسفاً","للعقل يثني عليه الأينق الرّسم",2,"م",1,0],["والعقل والوصل الممرَّ المدْمَجا","أذكى شهابَ الحسن لا بل أَجّجا",3,"ج",2,0],["والعقابُ الجميل منك على ذا","ك حقيقٌ دون العقاب القبيحِ",4,"ح",1,0],["وَالعَقلُ في الشَرقِيِّ مِن أَوهامِهِ","كَالنَسرِ في الأَوهاق وَالأَصفادِ",5,"د",1,0],["والعقلُ رغْمَ مشيبهِ ووقَارِهِ","مَا زالَ في الأَيَّامِ جِدّ صغيرِ",6,"ر",1,0],["وَالعَقلُ غايَةُ جَريِهِ لِأَعِنَّةٍ","وَالجَهلُ غايَةُ جَريِهِ لِعِثارِ",7,"ر",1,0],["والعقد منها محكم","والصبغ فيها مشبعُ",8,"ع",1,0],["وَالعَقلُ مِن صَنعَةٍ وَتَجرُبَةٍ","شَكلانِ مَولودُهُ وَمُكتَسَبُه",9,"ب",2,0],["وَالعَقلُ مَقسومٌ فَلا تَزهَدَن","في طَلَبِ العِلمِ وَفي قَبسِهِ",10,"س",2,0],["وَالعَقلُ أَنفَسُ ما حُبيتَ وَإِن يُضَع","يَوماً يَضَع فَغوى الشَرابِ وَما حَلَب",11,"ب",1,0],["وَالعَقلُ زينٌ وَلَكِن فَوقَهُ قَدَرٌ","فَما لَهُ في اِبتِغاءِ الرِزقِ تَأثيرُ",12,"ر",1,0],["وَالعَقلُ أَنذَرَنا بِما هُوَ كائِنٌ","في الدَهرِ ثُمَّ تَشَعَّبَ الإِنذارُ",13,"ر",1,0],["وَالعَقلُ يَعجَبُ لِلشُروعِ تَمَجُّسٍ","وَتَحَنُّفٍ وَتَهَوُّدٍ وَتَنَصُّرِ",14,"ر",1,0],["وَالعَقلُ يَعجَبُ وَالشَرائِعُ كُلُّها","خَبَرٌ يُقَلَّدُ لَم يَقِسهُ قائِسُ",15,"س",1,0],["وَالعَقلُ كَالبَحرِ ما غيضَت غَوارِبُهُ","شَيئاً وَمِنهُ بَنو الأَيّامِ تَغتَرِفُ",16,"ف",1,0],["وَالعَقلُ في مَعنى العِقالِ وَلَفظِهِ","فَالخَيرُ يَعقِلُ وَالسَفاهُ يَحُلُّهُ",17,"ل",2,0],["وَالعَقلُ يُزجَرُ وَالطِباعُ مَعَ النُهى","كَالفيلِ يُضرَبُ رَأسُهُ بِالمِغوَلِ",18,"ل",1,0],["وَالعَقلُ يَزعَمُ أَيّاماً تُشاهِدُها","بَيضاً حَوادِثَ في داجي لَياليها",19,"ي",3,0],["وَالعَقل يخبط لاكتشاف سَبيله","في جوف لَيل للعماية مظلم",20,"م",1,0],["وَالعَقل يَعلم من سيا","حته الَّتي أَولته مجدا",21,"د",2,0],["وَالعَقلُ يَسعى لِنَفسي في مَصالِحِها","فَما لِطَبعٍ إِلى الآفاتِ جَذّابِ",22,"ب",1,0],["والعقل فيك مسافر متغرّب","والفكر يهرب حيث أنت المهرب",23,"ب",1,0],["والعقل والحق يحرران من","رق الهوى ويدعوان للعلا",24,"ا",1,0],["والعقل دلّ عليه لا قرآنه","في آية الكبرى ولا توراته",25,"ت",2,0],["والعقلُ قِدْما مَعقلٌ للعاقل","والصبرُ من خير مآلٍ آئل",26,"ل",1,0],["والعقدة اللطيفة الختميه","لنقش رمز النقطة البدئيه",27,"ه",1,0],["والعقلُ يردعُ أهلَه","وذوُو الجنون على خَطرْ",28,"ر",1,0],["والعقلُ يَقذِفُها إلى","شَطِّ السُّلوَّ ولا تَوَدُّ",29,"د",1,0],["وَالعُقاةُ الَّذين يُستَدفَعُ اليَأ","سُ بِهِم وَهوَ مُقمَطِرّ مَهيلُ",30,"ل",1,0],["والعقل مأسور بكف الهوى","مضطهد يتبعه الفضل",31,"ل",1,0],["والعقلُ أجملُ زينةٍ","لأخي النَّباهةِ والرَّويّه",32,"ي",2,0],["والعقل قيد للفتى وعقل","وكلما مر بلهو يحلو",33,"ل",2,0],["وَالعَقَباتِ السَبعُ في قَطعِها","مِن سَقَمِ الأَنجُمِ أَضحى سَليم",34,"م",1,0],["وَالعَقل كَالسَيف يَعرو متنه صَدأ","حيناً وَيَجلو صَداه الأنس وَالطَرَبُ",35,"ب",1,0],["وَالعَقل مِن واهب الإِحسان مُختَلف","في الخَلق مِنهُ غَريزيٌّ وَمُكتَسَبُ",35,"ب",1,0],["والعق للوالدين موجب للنكال","كذا قطيعه لارحام كعم وخال",36,"ل",1,0],["والعقل في التكليف أمر لازم","فاكشف لنا عن صبح ليلٍ أَلْيَلِ",37,"ل",1,0],["والعقل حتى غدوت في جدل","فأنت أنت الدليل في النظر",38,"ر",1,0],["والعقلُ ما كان إلاَّ ضيف صُحبتنا","هذا الوجودَ ولم يُفصم عن الرَّقمِ",39,"م",1,0],["والعقائر ارتفعت","والأكف تضطرب",40,"ب",1,0],["والعَقْلُ في التَّقْوى فَمَن جانَبَها","معَ الهَوى إلى الضَّلالِ ما عَقَلْ",41,"ل",1,0],["والعقول المستمدات بها","لاقتناص الغيب هنَّ الشبك",42,"ك",1,0],["والعقل يدرك أن ذلك غيرها","وهي المراتب ما لها نكران",43,"ن",1,0],["والعقل نور الله لكن هو في","ظلمة طبع فيك منك يحكم",44,"م",1,0],["والعقل قد قاموا به يحصرو","ن الدين في المستحسن النافع",45,"ع",1,0],["والعقل عن ذاك في ضلال","وليس يدري طريق رشد",46,"د",1,0],["والعقل يأبى والتناقض واضحٌ","بين الورى وإن استراب الجاحد",47,"د",1,0],["والعقل نور الله في ملكوته","وبه لنا التكليف وهو الشاهد",47,"د",1,0],["والعقل يقسم في الفرق الوجود إلى","قسمين قطعاً وجود الرب والعبد",48,"د",1,0],["والعقل في هذا المصابِ","من اللَّبيب هو الجُنُونُ",49,"ن",1,0],["والعِقد مَبْسِمُه ولستَ تَرَى","في السِّلْكِ منه زُمُرُّدَ العِقْد",50,"د",1,0],["والعقل في جسم صحيح سالمٌ","وكلاهما في النشء منك سليم",51,"م",1,0],["وَالعَقلُ لا يَعنو لِحالاتٍ إِذا","ما شاءَ أَوقَعَها بِحالِ تِفانِ",52,"ن",1,0],["وَالعَقلُ زالَ مِن المِطا","لِ بِوَعدِ مَحبوبي المُطالِ",53,"ل",1,0],["والعقد لا أنقض منه القوى","حتى يوارى القبر أطباقي",54,"ي",1,0],["والعقل شيء لا لديه ولا معي","والسمع باب بعده مقفول",55,"ل",1,0],["وَالعَقلُ قَد راح","مِن شُربِ اللّمى مَع رَاح",56,"ح",1,0],["وَالعَقلُ قَد تاهَ وَالأَبصارُ شاخِصةٌ","وَالفَهمُ قَد ضاعَ وَالأَفكار قَد ذَهَبَت",57,"ت",1,0],["والعقلُ نور والجهالةُ ظلمةٌ","شتانَ بين النورِ والظلمات",58,"ت",1,0],["والعقل والتدبير فيمن سِنُّها","قد زاد عن سنّ الفتاة العانت",59,"ت",1,0],["وَالعَقْبُ يَعْتَزُّ الدّهِيَّ الماكِرا","يُجْرِي دَهارِيسَ وَدَهْراً داهِرَا",60,"ر",2,0],["والعقول التي نخال انارت","أستسرت في ظلمة الأديان",61,"ن",1,0],["والعقل حار ومس الحزن وانكسرت","سفن الرجا فاذكرن حسن العنايات",62,"ت",1,0],["والعقل منذ كنت من شهودك","والفكرُ بعد العقل من جنودك",63,"ك",1,0],["والعقلُ يعقِلهُ على حَسَراته","ويَصُدُّ فيرُدّه مَحسورا",64,"ر",2,0],["وَالعَقل وَالكتمان","وَالقَلب وَاللسان",65,"ن",1,0],["وَالعَقل وَالنطف وَحُسن السيره","وَالفَهم وَالنية وَالسريره",66,"ه",1,0],["وَالعقد كَالخندَق في التّحصين","وَضَربه العَرضي كَالكَمين",67,"ن",1,0],["والعقل أقوى رتبة واعدل","من رتبه المنقوص حيث ينقل",68,"ل",1,0],["والعقل في الوافر وقص الكامل","كما تراه في مدار حامل",68,"ل",1,0],["والعقص في ثلاثة في الأول","وخامس وسابع له يلي",68,"ي",1,0],["وَالعقد كَالثُريا","في صَدرِها المَنقوش واي",69,"ي",1,0],["والعقر في كل حالٍ للإماء إذا","طاوعته رغباً في الوطء أو رهبا",70,"ب",2,0],["والعقل فيا بينهم","يوم التقارع والمصاعِ",71,"ع",1,0],["وَالعقد في مَلّانَ غَيرُ مُزلّجٍ","بِقوىً متيناتِ الحِبالِ شِدادِ",72,"د",1,0],["والعقلُ ليس له تقبيحُ ما قبحتْ","صفاتُه وله التحكيم في العِبَرِ",73,"ر",1,0],["والعقلُ أيضاً له رِدء يصدقه","في قوله فهو برٌّ في تحفيه",74,"ف",3,0],["وَالعَقلِ والفِطرَاتِ أيضاً كُلِّهَا","قَبلَ الفَسَادِ وَمُقتَضَى البُرهَانِ",75,"ن",1,0],["وَالعَقلُ دَلَّ عَلَى انتِهَاءِ الكَونِ أج","مَعِهِ إلَى رَبٍّ عَظِيمِ الشَّانِ",75,"ن",1,0],["وَالعقربُ العَوجاءُ مِن صَدغه","تحرس وَردَ الخَدِّ أن يُجتنَى",76,"ن",2,0],["والعَقلُ عِلقٌ مَصُونٌ لو يُباعُ لَقَد","أَلفيتَ بِيَّاعَهُ يُعطَونَ ما سأَلوا",77,"ل",3,0],["والعقل عقل عما","يجزا فعل الموسى",78,"س",2,0],["والعقلُ أصلاً قطُّ ما طاعَ وَرَق","أن يَعتَقِد في طِرسِ قطّ ورق",79,"ق",1,0],["والعقبةُ يا صَاحِ ثَمَّ الطور","ومَا يُوالِيهُم مِنَ البُرور",80,"ر",1,0],["والعقل نور اللّه إلا أنه","للعالم المحسوس غير ممازج",81,"ج",1,0],["والعقل مرآة حقائقنا بها","تبدو ومرأى الناس في مرآتها",82,"ت",3,0],["وَالعَقل نور أَنتُم مشكاته","وَالحَزم بر أنتُم أَطواده",83,"د",2,0],["والعقل نور عظيم نافع ابدا","به تميز انسان عن النعم",84,"م",1,0],["والعقل عند الهوى مجن","لو كان عند الشباب عقل",85,"ل",1,0],["والعقل كليلٌ في جهلٍ","بأمور الروح وأمرِ غدٍ",86,"د",1,0],["والعَقْلُ والفَضْلُ في مَجْدي وفي نُطُقي","وما تَكامَلَ في خُلْقي من الشَّرَفِ",87,"ف",1,0],["والعقد لو لم يكن يصفرّ لؤلؤه","والراح لو عذبت طعماً وما تفلت",88,"ت",1,0],["وَالعَقل يَرفع أَهلَه لَكنه","يذرى بهِ عند الَّذي لا يعقل",89,"ل",1,0],["والعقل من نسل الحياة وإنما","قد شاب وهي صغيرة تتزين",90,"ن",1,0],["والعقل ينهاك عمّا","تهذي به لو عقلتا",91,"ت",2,0],["والعقلُ في هذا الزمانِ آفةٌ","وربما يقْتُل أهلَه الذَّكَا",92,"ا",1,0],["والعقلُ رأس الفضل غيرُ مشارك","وبه لعمرك يُعرف الرحمانُ",93,"ن",1,0],["والعقلُ بَعل للحياةِ ومنهما","نُتجَ الجمال ووُلد الإيمانُ",93,"ن",1,0],["والعقلَ فانهَ يا أخي عن الجدلْ","والقلبَ فانهَ يا أخي عن الزللْ",94,"ل",1,0],["وَالعقلُ يَنبوعُ الفعالِ فان صفا","صفتِ المشارب واستُلذَّ الموردُ",95,"د",1,0],["وَالعَقلَ وَالغَوصَ عَلَى الحقَائِقِ","وَالعِلمَ بِالأَسرَارِ وَالدَّقَائِقِ",96,"ق",1,0],["والعقل يَظهَرُ إن علمٌ تعهّدهُ","كالنار كامنة والقدح يوريها",97,"ي",3,0],["والعقل قد بات مَعقولاً بما فعلت","عمداً بهجري وسرَّت قلب حسّادي",98,"د",2,0],["والعقل يبدي اهتماماً دون معرفةٍ","في عارفٍ عَرفه بالعُرف حَيّانا",99,"ن",2,0],["وَالعَقل يَنصب مِن حَبائله","نَصباً معاقدها مِن الشوك",100,"ك",1,0],["والعقل والشهرة راضيان","بالعلم بل بالحسن قاضيان",101,"ن",1,0],["والعقل معقل من ا لى النطق انتمى","فارحه من تعب يرى بالراح",102,"ح",1,0],["والعقلُ أوَّلُ لاحقٍ بمشيَّعٍ","يذرُ الجسومَ وما حوتْه هباءَ",103,"ا",2,0],["والعقل في راسك ترا النفس تغوي","احسب احساب الاخره والسؤالي",104,"ل",2,0],["والعقل مِمَّا صُبَّ فيه تعصُّباً","للقاسطين المارقين تحجرا",105,"ر",2,0],["والْعَقْ جراحَكَ إذْ ما أَنْتَ في صَلَفٍ","فَالشمسُ شارقةٌ يومًا بلا وَجَبِ",106,"ب",1,0],["والعقلُ فى يهماء يعوى ريحُها","والقلبُ فى ويلٍ يئنُ مجلَّفُ",107,"ف",1,0],["والعقد في جيد المليحة زينة","واراه في جيد القبيحة عايبا",108,"ب",2,0],["والعقد في الجيد يحلو والسوار يُرى","في معصم الغيد معنى راق كل شجي",109,"ج",2,0],["والعقل حطوا فيه مليون وسواس","وش شغلتك يا ابليس غير الوساويس",110,"س",1,0],["والعقل في كل المسافات سلطان","والود مفتاح القلوب الغليقه",111,"ق",2,0],["والعقلَ إذ طاشتْ به أنغامُها","فكأنّه في نشوةٍ يتأنّقُ",112,"ق",1,0],["والعقلُ قد تاهت خطاهُ تعثَّرَت","ياليتَهُ للنُّورِ يومًا يرجِعُ",113,"ع",1,0],["والعَقْلُ سِرُّ الكونِ..في مَنْظومَةٍ","كلُّ العُقولِ أمامها تَتَعَطَّلُ",114,"ل",1,0],["والعقلُ ينهاني ويصرُخ بي كفى","فالشوقُ يقتُلُ من يُطيعُ مشاعِرَهْ",115,"ر",2,0],["والعقل كالجسم في الأرياف قوته","تربو وفي حضر البلدان قد ضعفا",116,"ف",2,0],["والعقل يرزح تحت أشطان الأسى","ثكلى كأن عويلها تحبير",117,"ر",1,0],["والعقل أهدى للمرام من القطا","حتى يصادف والقضاء كمين",118,"ن",1,0],["والعقل يقترع الوجود مقامراً","بالعلم تحت أسرة الأسرار",119,"ر",1,0],["والعقل أغلا أن يعيش راتعا","سائمة بين الغدير والكلا",120,"ا",1,0],["والعقل عقال إذا مازجه","برد النعيم وجرئ إن غلى",120,"ا",1,0],["وَالعَقلُ نُورٌ فِي الفُؤَادِ مُرَكَّبٌ","وَبِهِ الأُمُورَ اللَّوذَعِيُّ مُمَارِسُ",121,"س",1,0],["وَالعَقْلُ نُورٌ والنُّفُوسُ جَوَاهِرٌ","وَالرُّوحُ غَيْبٌ وَالجُسُومُ مَحَامِلٌ",122,"ل",1,0],["والعقل ضل عن الرشاد سآمة","والقلب بات من الجفا ظمآنا",123,"ن",2,0],["وَالْعَقْلُ يَسْأَلُ أَسْبَابًا وَقَدْ خَفِيَتْ","تَوْقًا لِبَارِئِهِ بِالشَّوْقِ وَالنَّهَمِ",124,"م",1,0],["والعقل منه ذاهب والحشا","ملتهب والجسم يحكي الخيال",125,"ل",1,0],["والعقل يعقلها عن ما يقهقرها","عن منهج الحق كي تأتي بما يجب",126,"ب",1,0],["والعقلُ سلطانُ المشاعرِ بالهدى","فوقَ الغرائزِ والهوى يتربّعُ",127,"ع",1,0],["والعقلُ باتَ بِحيرةٍ ، وقلوبُنا","فقدَ الطريقَ لنبضِها حادينا",128,"ن",2,0],["والعقل في رأسي ولكنني","مما بلاني فيه ضيعته",129,"ت",2,0],["والعقل ما كلف خلايا المخ ما لا تستطيق","والفكر مثل الحج فرض وركن حسب المستطاع",130,"ع",1,0],["والعِقْدُ منفردٌ بالجيدِ حِلْيَتُهُ","ياقوتةٌ سطعتْ والدُّرُّ حلَّاهَا",131,"ا",3,0],["والعقل نبراس فان عاثت به الأ","هواء لم يسطع بداجي الظلم",132,"م",1,0],["والعقلُ ما تبعَ الهدايةَ سالمٌ","وإذا تنكّر دربها لا يسلَمُ",133,"م",1,0],["والعَقْلُ تاهَ مِنَ الصّبَابَةِ والجوى","فإلامَ تَرْمي أيّهَا المعقولُ؟؟",134,"ل",1,0],["والعقلُ يُدركُ ما بالقلبِ أَجحدُهُ","لا لنْ يَموتَ أبي والنهرُ والمَطَرُ",135,"ر",1,0],["والعقل ضلَّ طريقَه","وتحكَّمت فيه العجولْ",136,"ل",1,0],["والعقل أن نرعَى بني حِيِواننا","ونزورهُ أفراحه ومآتمهْ",137,"م",2,0],["والعقلُ إنْ حاججْتُهُ","أبدى تشوُّشَهُ ونُكْرا",138,"ر",2,0],["والعَقلُ _خارجَ سِرْبِهِ _ متذمرٌ","يشدو الحَنينَ، فَيَستفزُّ لِسانيهْ",139,"ن",3,0],["وَالعَقل قال أَذهلت من قلة السَعد","وَصاير عَلى كُل الدماغ ستار",140,"ر",1,0],["والعقلُ ليس له تقبيحُ ما قبحتْ","صفاتُهُ ولهُ في التحكيمِ في العبرِ",141,"ر",1,0],["والعقل عقلك في التفكير تعمله","فكل بحث إذا استعصى يدققه",142,"ق",2,0],["والعقلُ يسبحُ في بحاركِ هائماً","أودت بِهِ الأمواجُ والأنواءُ",143,"ا",2,0]]}