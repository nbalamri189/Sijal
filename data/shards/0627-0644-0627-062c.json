{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[57,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[88,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[31,"ألا جعل الله الأخلاء كلهم","https://www.aldiwan.net/poem6201.html","الطويل"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[87,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[47,"ألم تعلمي يا علو أني معذب","https://www.aldiwan.net/poem11437.html","الطويل"],[63,"ألا جزعت بيض السيوف على فتى","https://www.aldiwan.net/poem51982.html","الطويل"],[50,"بروحِ القدسِ والميلاد","https://www.aldiwan.net/poem66574.html","الهزج"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[108,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[164,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[189,"يا سادة حازوا المنا","https://www.aldiwan.net/poem14747.html","مجزوء الكامل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[241,"أغدت زيادتنا إلى النقصان","https://www.aldiwan.net/poem19295.html","الكامل"],[274,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[368,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[381,"ألا جانب المهذار ساء كلامه","https://www.aldiwan.net/poem66895.html","الطويل"],[407,"الاجتماع غنيمة","https://www.aldiwan.net/poem33481.html","مجزوء الكامل"],[436,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[443,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[456,"ماذا أصابك أيها البستاني","https://www.aldiwan.net/poem61801.html","الكامل"],[461,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[554,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[554,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[578,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[578,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["أَلا جُزتَ الجَوازي اليَومَ عَنّي","جَواداً لا أَغَمَّ وَلا هَجينا",0,"ن",2,0],["أَلا جَعَل اللَهُ الفِدا كُلَّ حُرَّةٍ","لِفَوزِ المُنى إِنّي بِها لَمُعَذَّبُ",1,"ب",1,0],["أَلا جَوابٌ يُرَوّي مِن جَوانِحِنا","ما لِلقُبورِ إِذا ما نودِيَت تَجِمُ",2,"م",1,0],["ألا جاد الحيا تلكم ظِباءً","تزيِّنها المقاصرُ لا الخيامُ",3,"م",1,0],["أَلا جَعَلَ اللَهُ الأَخِلّاءَ كُلَّهُم","فِداءً لِغَوثٍ حَيثُ أَمسَوا وَأَصبَحوا",4,"ح",3,1],["إِلّا جِراحُ الحَقِّ في","عَصرِ الحَصافَةِ وَالدِرايَه",5,"ا",3,0],["أَلِأَجلِ آجالٍ دَنَت وَتَهَيَّأَت","قَدَّرتَ ضَربَ الشاطِئِ المَتروكِ",6,"ك",1,0],["أَلا جَعَلَ اللَهُ الفِدا كُلَّ حُرَّةٍ","لِعَلوَ المُنى إِنّي بِها لَمُعَذَّبُ",7,"ب",1,0],["ألا جزعتْ بيضُ السيوف على فتىً","أَغَرَّ إذا ما جارَ بالسَّفْرِ غَيْهَبُ",8,"ب",1,1],["ألا جرتَ فإنّ الجورَ","من فعلِ أولي القُبحِ",9,"ح",1,0],["أَلأجل أن يَلقى السَعا","دة واحد يَشقى ألوف",10,"ف",1,0],["الأجنبُّي بأرضنا وبأرضكم","كالغيم في الجوِّ الطليقِ الصافي",11,"ف",2,0],["الا جزع لقاصفة وأخرى","تليها للمباين والقرين",12,"ن",1,0],["إلا جمال الدولةِ المعطى الندى","على انتهابِ رِفده مَواثقا",13,"ق",2,0],["ألاجري دمع عليه حسرةً","بدم وأعقبه التلوه والكرب",14,"ب",1,0],["إلا جذابتَنا فقد","جاءت مخالفةَ المذاهب",15,"ب",1,0],["ألا جيش قويّ البطش ضار","يذيق عداك أكواب العذاب",16,"ب",1,0],["الأَجْرُ وَالْوَجْدُ الْعَظِيمُ هُمَا هُمَا","قَدْ أَوْقَفَانِي مَوْقِفَ الْحَيْرَانِ",17,"ن",1,0],["ألأجل قطعة معدن تنتابُها","أيدي بَغيَّاتٍ وسكِّيرينا",18,"ن",2,0],["الأجلُّ الأجلُّ يختارُ منه","حين يختاره الأسدّ الأسدّا",19,"د",2,0],["ألا جانب المهذار ساء كلامه","ودنس عرضاً بالردى حين ينفث",20,"ث",1,1],["الاجتماع غنيمة","إن حارب الدهر الرجالا",21,"ل",2,1],["الأجلُّ الإمامُ سيدنا الحا","فظُ فخرُ الأئمةِ الصّنْديدُ",22,"د",1,0],["إلّا جبينَكَ يحدو صارِماً ضَرِماً","كالبدرِ تحتَ الدَّياجي يَتبَعُ الزُّهَرَهْ",23,"ر",2,0],["الأجنبيث مسيطرٌ في بيتكم","ومبيحُ عرضكمو لكل لسان",24,"ن",1,0],["ألا جاءني والقولُ حقٌّ وباطلٌ","نَعِيٌّ تغشَّى ثم أقشع عن رغمي",25,"م",2,0],["ألا جنّباني ما نبا بخلائقي","وحسبُكما ما كان وَفْقَ خلائقي",26,"ق",2,0],["أَلا جنِّبا قلبي الأذى لا يُطيقُهُ","وقولوا له إذْ ضلّ أين طريقُهُ",27,"ق",2,1],["الأَجلُّ الذي له السؤدد الأَع","ظم قد حازَه بكسب وطَبْع",28,"ع",1,0],["الأَجَلُّ الموقِّي النكباتِ الر","عنَ إِذ رُعن بالرِّياح النُّكْبِ",29,"ب",1,0]]}