{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[57,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[88,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[31,"ألا جعل الله الأخلاء كلهم","https://www.aldiwan.net/poem6201.html","الطويل"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[87,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[47,"ألم تعلمي يا علو أني معذب","https://www.aldiwan.net/poem11437.html","الطويل"],[63,"ألا جزعت بيض السيوف على فتى","https://www.aldiwan.net/poem51982.html","الطويل"],[50,"بروحِ القدسِ والميلاد","https://www.aldiwan.net/poem66574.html","الهزج"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[108,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[164,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[189,"يا سادة حازوا المنا","https://www.aldiwan.net/poem14747.html","مجزوء الكامل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[242,"أغدت زيادتنا إلى النقصان","https://www.aldiwan.net/poem19295.html","الكامل"],[275,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[382,"ألا جانب المهذار ساء كلامه","https://www.aldiwan.net/poem66895.html","الطويل"],[409,"الاجتماع غنيمة","https://www.aldiwan.net/poem33481.html","مجزوء الكامل"],[438,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[445,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[458,"ماذا أصابك أيها البستاني","https://www.aldiwan.net/poem61801.html","الكامل"],[463,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[556,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[556,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[580,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[580,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45198","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72302","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56569","الطويل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73522","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126668","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2392,"","https://poetry.dctabudhabi.ae/diwan/poem/123994","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87345","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105672","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105668","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93826","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200828","المتقارب"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101667","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65144","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129377","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91723","البسيط"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141231","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107537","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94573","الوافر"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4349,"","https://poetry.dctabudhabi.ae/diwan/poem/80110","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[4859,"أوردة النعيم!","https://www.poetsgate.com/ViewPoem.aspx?id=210845",""],[4862,"ولم تزل العبرات مخنوقه","https://www.poetsgate.com/ViewPoem.aspx?id=55632",""],[4984,"حي الفريقين","https://www.poetsgate.com/ViewPoem.aspx?id=175837",""],[4988,"في داخلي >>> (( إنسان ..... حاله مريعه","https://www.poetsgate.com/ViewPoem.aspx?id=157495",""],[4988,"ريق الفخر يحتاج كفواً يبّله","https://www.poetsgate.com/ViewPoem.aspx?id=180840",""],[5252,"تبي تسكتني","https://www.poetsgate.com/ViewPoem.aspx?id=36105",""],[5376,"أنامُ بملء عيني لستُ أصحو","https://www.poetsgate.com/ViewPoem.aspx?id=194860",""],[5418,"مَا أَبْطَأت أَخْبَار من احببته","https://www.poetsgate.com/ViewPoem.aspx?id=189153",""],[5526,"مالك لوى","https://www.poetsgate.com/ViewPoem.aspx?id=199668",""],[5526,"مفاهيم وجدال","https://www.poetsgate.com/ViewPoem.aspx?id=201189",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5736,"عيد وأرق","https://www.poetsgate.com/ViewPoem.aspx?id=208886",""],[5956,"أدواء بسرعة الأضواء","https://www.poetsgate.com/ViewPoem.aspx?id=202751",""],[242,"أغدت زيادتنا الى النقصان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563803",""],[463,"ألأجلِ تيسٍ لفظه وضُراطُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60177&r=&rc=233",""]],"verses":[["أَلا جُزتَ الجَوازي اليَومَ عَنّي","جَواداً لا أَغَمَّ وَلا هَجينا",0,"ن",2,0],["أَلا جَعَل اللَهُ الفِدا كُلَّ حُرَّةٍ","لِفَوزِ المُنى إِنّي بِها لَمُعَذَّبُ",1,"ب",1,0],["أَلا جَوابٌ يُرَوّي مِن جَوانِحِنا","ما لِلقُبورِ إِذا ما نودِيَت تَجِمُ",2,"م",1,0],["ألا جاد الحيا تلكم ظِباءً","تزيِّنها المقاصرُ لا الخيامُ",3,"م",1,0],["أَلا جَعَلَ اللَهُ الأَخِلّاءَ كُلَّهُم","فِداءً لِغَوثٍ حَيثُ أَمسَوا وَأَصبَحوا",4,"ح",3,1],["إِلّا جِراحُ الحَقِّ في","عَصرِ الحَصافَةِ وَالدِرايَه",5,"ا",3,0],["أَلِأَجلِ آجالٍ دَنَت وَتَهَيَّأَت","قَدَّرتَ ضَربَ الشاطِئِ المَتروكِ",6,"ك",1,0],["أَلا جَعَلَ اللَهُ الفِدا كُلَّ حُرَّةٍ","لِعَلوَ المُنى إِنّي بِها لَمُعَذَّبُ",7,"ب",1,0],["ألا جزعتْ بيضُ السيوف على فتىً","أَغَرَّ إذا ما جارَ بالسَّفْرِ غَيْهَبُ",8,"ب",1,1],["ألا جرتَ فإنّ الجورَ","من فعلِ أولي القُبحِ",9,"ح",1,0],["أَلأجل أن يَلقى السَعا","دة واحد يَشقى ألوف",10,"ف",1,0],["الأجنبُّي بأرضنا وبأرضكم","كالغيم في الجوِّ الطليقِ الصافي",11,"ف",2,0],["الا جزع لقاصفة وأخرى","تليها للمباين والقرين",12,"ن",1,0],["إلا جمال الدولةِ المعطى الندى","على انتهابِ رِفده مَواثقا",13,"ق",2,0],["ألاجري دمع عليه حسرةً","بدم وأعقبه التلوه والكرب",14,"ب",1,0],["إلا جذابتَنا فقد","جاءت مخالفةَ المذاهب",15,"ب",1,0],["ألا جيش قويّ البطش ضار","يذيق عداك أكواب العذاب",16,"ب",1,0],["الأَجْرُ وَالْوَجْدُ الْعَظِيمُ هُمَا هُمَا","قَدْ أَوْقَفَانِي مَوْقِفَ الْحَيْرَانِ",17,"ن",1,0],["ألأجل قطعة معدن تنتابُها","أيدي بَغيَّاتٍ وسكِّيرينا",18,"ن",2,0],["الأجلُّ الأجلُّ يختارُ منه","حين يختاره الأسدّ الأسدّا",19,"د",2,0],["ألا جانب المهذار ساء كلامه","ودنس عرضاً بالردى حين ينفث",20,"ث",1,1],["الاجتماع غنيمة","إن حارب الدهر الرجالا",21,"ل",2,1],["الأجلُّ الإمامُ سيدنا الحا","فظُ فخرُ الأئمةِ الصّنْديدُ",22,"د",1,0],["إلّا جبينَكَ يحدو صارِماً ضَرِماً","كالبدرِ تحتَ الدَّياجي يَتبَعُ الزُّهَرَهْ",23,"ر",2,0],["الأجنبيث مسيطرٌ في بيتكم","ومبيحُ عرضكمو لكل لسان",24,"ن",1,0],["ألا جاءني والقولُ حقٌّ وباطلٌ","نَعِيٌّ تغشَّى ثم أقشع عن رغمي",25,"م",2,0],["ألا جنّباني ما نبا بخلائقي","وحسبُكما ما كان وَفْقَ خلائقي",26,"ق",2,0],["أَلا جنِّبا قلبي الأذى لا يُطيقُهُ","وقولوا له إذْ ضلّ أين طريقُهُ",27,"ق",2,1],["الأَجلُّ الذي له السؤدد الأَع","ظم قد حازَه بكسب وطَبْع",28,"ع",1,0],["الأَجَلُّ الموقِّي النكباتِ الر","عنَ إِذ رُعن بالرِّياح النُّكْبِ",29,"ب",1,0],["أَلا جَعَلَ اللَهُ المُغيرَةَ وَاِبنَهُ","وَمَروانَ بَعلَى ذِلَّةً لِاِبنِ عامِرِ",30,"ر",1,1],["ألا جددي يا نفس وجدا وحسرة","فهذا فراق بعده ليس نلتقي",31,"ق",2,0],["ألا جمح الغاوون فيك جماحهم","فهيهات تجدي بعد هذا الشكائم",32,"م",1,0],["أَلا جئ لَنا بَأَبٍ واحِدٍ","وَضيعٍ وَنَحنُ نَحُطُّ الشَرَف",33,"ف",1,0],["ألا جز بالديار وحيهنه","فقد درست معالم حيهنه",34,"ن",2,1],["الأجنبيّ يعيش حراً","في ضفاف الرافدين",35,"ن",1,1],["الأجلُّ المعظُّم الصمدُ الأَر","وَعُ والماجدُ الحليمُ البصيرُ",36,"ر",1,0],["ألا جلدٌ يوم النوى أستعيرُهُ","لبَين حبيب زُمّ للبينِ عيرُهُ",37,"ر",2,1],["إلاَّ جرى دمعي حتى يُرى","في كل خد واحدٍ جَدْولا",38,"ل",2,0],["ألاَ جَوِّدُوا في آلَةِ الفُلكِ وآصلِحُوا","مواسِمَكُم والحِملَ ثُمَّ آتركُوا الوَسَن",39,"ن",1,0],["ألا جردوا الأقلام في القول مرة","فلا ينفعن السيف غير مجرد",40,"د",1,0],["الإجتماع ولا طبيب له فهم","بالجسم منه علة وسقام",41,"م",1,0],["ألا جبرا لديك لكسر عبد","بحسن حلاك صب مستهام",42,"م",1,0],["ألا جرعة من لذيذ الممات","تغيّر في الفم طعم الحياة",43,"ه",1,1],["أَلأجلِ هذا التاجِ خُنتِ متيَّماً","ضحَّى لديكِ بقلبِهِ قربانا",44,"ن",2,0],["ألا جرّدُوا للجامع الأعظم الهنا","بغيث وقُولوا فارقك العيثُ",45,"ث",1,1],["الأجر أجرك صائما أو مفطرا","والجود جودك مثريا أو معسرا",46,"ر",2,1],["ألا جَرى الدَهر وَاهتمّت بَوادره","فَغيّرت من جَميع أَومضت بصفي",47,"ف",2,0],["أَلاَ جَمِّعِي شَملَ الدُّموعِ المُبَدَّدَا","وَرُدِّي لِجَفنَيكِ المَنَامَ المُشَرَّدَا",48,"د",2,1],["أَلا جلَّ شأنك عن ذي الأمور","ونُزِهَتَ عن مثل هذا الهوى",49,"ا",1,0],["ألا جدرانهُ ازدانت ضياءً","تألَّق من سنا غيد الخدورِ",50,"ر",1,0],["ألا جنبه فهو طويس شوم","وما در شحة وفتاة عهر",51,"ر",1,0],["ألا جَعَلَ اللّهُ الأَخِلاَّءَ كلّهم","فِداءً على ما كان لابنِ المُهَلَّبِ",52,"ب",1,1],["أَلأَجرَعٍ تَحتَلُّهُ هِندُ","يَندى النَسيمُ وَيَأرَجُ الرَندُ",53,"د",1,1],["الأجل كورونا ابتدعنا صمتنا","وسرت بأوردة النعيم سآمة؟!",54,"م",2,0],["ألأجلِ ( ميتٍ ) لم يكن يحيىَ وقد","واراه في ظُلَمِ الثرى ببلاءِ",55,"ا",2,0],["ألا جددا عهد الهوى واتلوا شعرا","فرجع الأغاني قد يعيد لنا الذكرى",56,"ر",2,1],["الأجنبي بالصوت ---- يزعج لعيعه","واردننا ( أهله ) لك ( الله )ما شاال",57,"ل",1,0],["الأجنبي من خير الاقراب متروس","ويطيب فاله كل الاوقات فلّه",58,"ل",2,0],["الآ جروحي..زاد فيها عطبها","بغيت انا الفكه..وعودت منشوب",59,"ب",1,0],["ألا جرِّدْ لعزمك كلَّ نصلٍ","فما بالخذل تلغي الحقَّ تمحو",60,"ح",2,0],["إِلَّا جرى قلمي إِلَيْهِ حافياً","وشكا إِلَيْهِ تشوقي بدموعه",61,"ه",1,0],["الاجابه سيدي مضمونها مالك لوى","التشابه بالبشر محصور انهم من تراب",62,"ب",1,0],["الاجابه عندهم من قبل لاتقول السؤال !","والسؤال اللي ف بالي للعقول اللي فهيمه",63,"م",2,0],["إلاّ جرَتْ أدمعاً خُرساً شَواطئُهُ","وجاءها دمعُ كلِّ النَّخلِ مُنسربا!",64,"ب",2,0],["الاجواد آيات الندى في وجيهها","والانذال شرى ما يذاق جناه",65,"ا",2,0],["الاجواد ما تنوي بك البوق والردى","والانذال عيب ما يعد غياه",65,"ا",2,0],["الاجواد فعل الخير لذة نفوسهم","والانذال ملزوم يشاف خناه",65,"ا",2,0],["الاجواد جنات تعاقب أنهورها","والانذال صلدا من صخور صفاه",65,"ا",2,0],["الاجواد تاصف لك طريق يدلك","والانذال لعسرات الدروب إقداه",65,"ا",2,0],["الاجواد مثل الورد عطر روايحه","والانذال **ومٍ يطير سفاه",65,"ا",2,0],["الاجواد فيهم باب يسر ومعزه","والانذال عسرٍ ما عليه شفاه",65,"ا",2,0],["الاجواد زلة جارهم يدمحونها","والانذال تجزا الاقربين جناه",65,"ا",2,0],["الاجواد مثل النهر حلو شرابه","والانذال صباخٍ ملاح ماه",65,"ا",2,0],["الاجواد تبذل فضلها دون عرضها","والانذال دنسين العروض عراه",65,"ا",2,0],["الاجواد مثل الريف سعد سعوده","والانذال قحط الزمهرير شتاه",65,"ا",2,0],["الاجواد تامن شرهم وانت عندهم","والانذال شر مايطيب بلاه",65,"ا",2,0],["الاجواد مثل الصبح تمشي بنوره","والانذال ليلٍ مظلمٍ ممساه",65,"ا",2,0],["الاجواد حبات الندى يبذرونها","والانذال تبذر بالرخيص رياه",65,"ا",2,0],["الاجواد فعول الخير ما يجحدونها","والانذال حزم مايطيب حفاه",65,"ا",2,0],["الاجواد ماتلحق عزيز مذمه","والانذال تنطق بالصديق زراه",65,"ا",2,0],["الاجواد عز الجار والضيف","سلمهم والانذال بعيون العزيز قذاه",65,"ا",2,0],["إلا جراحي فقد نامت بأوردتي","تكوي الضلوع فيردي أحرفي السقمُ",66,"م",1,0],["الأجنبيُّ لنا أخفُّ تشدداً","إنَّ الرقيَّ مُخفِّفُ الأعباءِ",67,"ا",2,0],["الأجنبيُّ يلوح أكثرَ رأفة","لكنه سببٌ لكل شقاءِ",67,"ا",2,0],["الأجنبيُّ هو المنظِّم حالنا ال","معكوسَ إنه أخبثُ الخبثاءِ",67,"ا",2,0],["الأَجرُ وَالوَجد العَظيمُ هُما مَعاً","قَد أَوقَفاني مَوقِفَ الحَيرانِ",68,"ن",1,0],["ألأجلِ تيسٍ لفظه وضُراطُه","سيّانِ في التحصيل عند العاقلِ",69,"ل",1,1]]}