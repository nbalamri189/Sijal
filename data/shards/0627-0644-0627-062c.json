{"poems":[[53,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[86,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[29,"ألا جعل الله الأخلاء كلهم","https://www.aldiwan.net/poem6201.html","الطويل"],[85,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[85,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[45,"ألم تعلمي يا علو أني معذب","https://www.aldiwan.net/poem11437.html","الطويل"],[61,"ألا جزعت بيض السيوف على فتى","https://www.aldiwan.net/poem51982.html","الطويل"],[48,"بروحِ القدسِ والميلاد","https://www.aldiwan.net/poem66574.html","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""]],"verses":[["أَلا جُزتَ الجَوازي اليَومَ عَنّي","جَواداً لا أَغَمَّ وَلا هَجينا",0,"ن",2,0],["أَلا جَعَل اللَهُ الفِدا كُلَّ حُرَّةٍ","لِفَوزِ المُنى إِنّي بِها لَمُعَذَّبُ",1,"ب",1,0],["أَلا جَوابٌ يُرَوّي مِن جَوانِحِنا","ما لِلقُبورِ إِذا ما نودِيَت تَجِمُ",2,"م",1,0],["ألا جاد الحيا تلكم ظِباءً","تزيِّنها المقاصرُ لا الخيامُ",3,"م",1,0],["أَلا جَعَلَ اللَهُ الأَخِلّاءَ كُلَّهُم","فِداءً لِغَوثٍ حَيثُ أَمسَوا وَأَصبَحوا",4,"ح",3,1],["إِلّا جِراحُ الحَقِّ في","عَصرِ الحَصافَةِ وَالدِرايَه",5,"ا",3,0],["أَلِأَجلِ آجالٍ دَنَت وَتَهَيَّأَت","قَدَّرتَ ضَربَ الشاطِئِ المَتروكِ",6,"ك",1,0],["أَلا جَعَلَ اللَهُ الفِدا كُلَّ حُرَّةٍ","لِعَلوَ المُنى إِنّي بِها لَمُعَذَّبُ",7,"ب",1,0],["ألا جزعتْ بيضُ السيوف على فتىً","أَغَرَّ إذا ما جارَ بالسَّفْرِ غَيْهَبُ",8,"ب",1,1],["ألا جرتَ فإنّ الجورَ","من فعلِ أولي القُبحِ",9,"ح",1,0],["أَلأجل أن يَلقى السَعا","دة واحد يَشقى ألوف",10,"ف",1,0],["الأجنبُّي بأرضنا وبأرضكم","كالغيم في الجوِّ الطليقِ الصافي",11,"ف",2,0]]}