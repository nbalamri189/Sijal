{"poems":[[66,"قم بنا إنا قصدنا الإجتماع","https://www.aldiwan.net/poem39045.html","الخفيف"],[66,"قم بنا في صباح يوم الخميس","https://www.aldiwan.net/poem39051.html","الخفيف"],[66,"قلوا لديك فأخطأوا","https://www.aldiwan.net/poem41553.html","مجزوء الكامل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[116,"سلم لربك لا تحاذر","https://www.aldiwan.net/poem41121.html","عموديه"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[190,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[260,"هذا كتاب أم بشير سعاد","https://www.aldiwan.net/poem35761.html","الكامل"],[282,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[329,"رق وجه النسمات","https://www.aldiwan.net/poem55044.html","مجزوء الرمل"],[350,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[367,"من يذكر المولى تناسى عبده","https://www.aldiwan.net/poem16967.html","الكامل"],[404,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[433,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[438,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[438,"أترى حان لكم نحوي التفات","https://www.aldiwan.net/poem2562.html","الرمل"],[453,"قم بنا يا نديم فالطير غرد","https://www.aldiwan.net/poem13736.html","الخفيف"],[465,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"]],"verses":[["فَلَدَينا مُدامَةٌ ما أَتى النَص","صُ بِتَحريمِها وَلا الإِجماعُ",0,"ع",1,0],["فَلَدينا مُدامَةٌ وَنَدامى","كَبُدورٍ قَد أَحدَقَت بِشُموسِ",1,"س",1,0],["فَلَدَيكَ مِنّا فِتيَةٌ","عَن ثارِها لا تَفتَأُ",2,"ا",1,0],["فَلَدَيكَ آلاتٌ جَنوبٌ كُلُّها","فَاِحطِم بِأَصلَبِهِنَّ صُلبَ الشَمأَلِ",3,"ل",1,0],["فلدي التراب تساوت ال","اشباه طرا والنظائر",4,"ر",1,0],["فَلديهِ العرشُ كالنملِ الصغير","عِندَنا وَالأمرُ أعلى وأجل",5,"ل",1,0],["فَلَدَيهِ فَوقَ السَماءِ وَتَحتَ ال","أَرضِ وَالعَرشُ وَالحَضيضُ سَواءُ",6,"ا",2,0],["فَلَديهِ كلُّ الجِهات وقبلَ الد","دهرِ والدهرُ والمعاد سواءُ",6,"ا",2,0],["فَلديهِ فوقَ السماءِ وتحتَ ال","أرضِ وَالعرشُ الحضيض سواءُ",7,"ا",2,0],["فلديه سحبانٌ يشابه باقلاً","يذر الفصيح مكبّلاً بالضاد",8,"د",1,0],["فلديه في صوغ الكلام وسوقه","أيد أمد به إلى الإله قواه",9,"ا",2,0],["فلديك النور نار","والأغاريد شكاة",10,"ه",1,0],["فَلَدَيَّ أَبكارُ المَعاني تُجتَلى","وَإِلَيَّ أَخبارُ الحَقائِقِ تُسنَدُ",11,"د",1,0],["فَلَديَهِ لي قَلبٌ أَسيرٌ لَم أُرِد","إِلّا كَرامَتَهُ لَهُ لِأَرُدَّهُ",12,"د",2,0],["فلديه يجتمع الخصو","م وكل خاف منه يبدى",13,"د",2,0],["فلديهِ كُلُّ عقيلَةٍ لَطُفَتْ","حِلاًّ فمازَجَ نُورُها العَقْلا",14,"ل",2,0],["فلدمعي بالأسى صبب","ولناري بالجوى صعد",15,"د",1,0],["فلدمعي بعد مثواه انهماك","ولقلبي إذ تولّى حسرات",16,"ت",1,0],["فلدينا قرنفلٌ قد نماهُ","جَبَلُ الفتح نَشْرهُ قد تصَعّدْ",17,"د",1,0],["فلدنهُ بدنٌ لا راس يصحبهُ","يقلُّ رأس عدوٍّ ما له بدن",18,"ن",1,0],["فلدي من حسن الولاء عقيدة","يرضيك منها الجهر والإسرار",19,"ر",1,0]]}