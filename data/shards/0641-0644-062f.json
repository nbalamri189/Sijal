ى الرمقِ الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=214642",""],[5751,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=215023",""],[5897,"يا عيد .. ماذا عن غزة ؟","https://www.poetsgate.com/ViewPoem.aspx?id=174865",""],[5956,"بيت الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=182131",""],[6205,"محاولة لاقتفاء الضوء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88159&r=&rc=11",""]],"verses":[["فَلَدَينا مُدامَةٌ ما أَتى النَص","صُ بِتَحريمِها وَلا الإِجماعُ",0,"ع",1,0],["فَلَدينا مُدامَةٌ وَنَدامى","كَبُدورٍ قَد أَحدَقَت بِشُموسِ",1,"س",1,0],["فَلَدَيكَ مِنّا فِتيَةٌ","عَن ثارِها لا تَفتَأُ",2,"ا",1,0],["فَلَدَيكَ آلاتٌ جَنوبٌ كُلُّها","فَاِحطِم بِأَصلَبِهِنَّ صُلبَ الشَمأَلِ",3,"ل",1,0],["فلدي التراب تساوت ال","اشباه طرا والنظائر",4,"ر",1,0],["فَلديهِ العرشُ كالنملِ الصغير","عِندَنا وَالأمرُ أعلى وأجل",5,"ل",1,0],["فَلَدَيهِ فَوقَ السَماءِ وَتَحتَ ال","أَرضِ وَالعَرشُ وَالحَضيضُ سَواءُ",6,"ا",2,0],["فَلَديهِ كلُّ الجِهات وقبلَ الد","دهرِ والدهرُ والمعاد سواءُ",6,"ا",2,0],["فَلديهِ فوقَ السماءِ وتحتَ ال","أرضِ وَالعرشُ الحضيض سواءُ",7,"ا",2,0],["فلديه سحبانٌ يشابه باقلاً","يذر الفصيح مكبّلاً بالضاد",8,"د",1,0],["فلديه في صوغ الكلام وسوقه","أيد أمد به إلى الإله قواه",9,"ا",2,0],["فلديك النور نار","والأغاريد شكاة",10,"ه",1,0],["فَلَدَيَّ أَبكارُ المَعاني تُجتَلى","وَإِلَيَّ أَخبارُ الحَقائِقِ تُسنَدُ",11,"د",1,0],["فَلَديَهِ لي قَلبٌ أَسيرٌ لَم أُرِد","إِلّا كَرامَتَهُ لَهُ لِأَرُدَّهُ",12,"د",2,0],["فلديه يجتمع الخصو","م وكل خاف منه يبدى",13,"د",2,0],["فلديهِ كُلُّ عقيلَةٍ لَطُفَتْ","حِلاًّ فمازَجَ نُورُها العَقْلا",14,"ل",2,0],["فلدمعي بالأسى صبب","ولناري بالجوى صعد",15,"د",1,0],["فلدمعي بعد مثواه انهماك","ولقلبي إذ تولّى حسرات",16,"ت",1,0],["فلدينا قرنفلٌ قد نماهُ","جَبَلُ الفتح نَشْرهُ قد تصَعّدْ",17,"د",1,0],["فلدنهُ بدنٌ لا راس يصحبهُ","يقلُّ رأس عدوٍّ ما له بدن",18,"ن",1,0],["فلدي من حسن الولاء عقيدة","يرضيك منها الجهر والإسرار",19,"ر",1,0],["فَلَدى العود قال لي السَعد أَرّخ","أَزهرت دارنا بِنُور سَعيد",20,"د",1,0],["فلديه من بَرَاهِين الهوى","حُججٌ مُدْحِضَةٌ أقوى الحجج",21,"ج",1,0],["فلدائي خُصتُهُ خطراً","إذ دوائي ذلكَ الخَطرُ",22,"ر",1,0],["فلديه للوفد حوض إيادٍ","ذو ازدحام وروض جود مجود",23,"د",1,0],["فَلَدَيكَ تَأنيسُ الإِلَهِ مُوَصَّلٌ","ما أَنتَ عَن سَبَبِ الرِّضَى مَقطوعُ",24,"ع",1,0],["فلدينا من العساكر ما ضاق","بأدناهم الفضاء الرحيب",25,"ب",1,0],["فَلَدى المَنصورِ أَرجو نائِلاً","يُثقِلُ الظَهرَ وَيَثني الأَرؤُسا",26,"س",2,0],["فلديكم حططت رحلي واني","بكمو قد غنيت عقلا وعاده",27,"د",2,0],["فلدى الساجعات دارت كوس","من خمور ليست كخمر الزبيب",28,"ب",1,0],["فَلَدَيَّ أَرْحَبُ حَيِّزٍ لِوُفُودِهَا","أَبَداً وَلِلْحَمْدِ الْمُواصَلِ حَيِّزُ",29,"ز",1,0],["فلديَّ وكَفّها وعنه","سواي خُلّبها لموعه",30,"ع",2,0],["فلدى القوى هم ذياب مفازة","ولدى الضعيف هم اسود كراء",31,"ا",2,0],["فلدى الأحباب يشكو ما بها","ولدي العذّال يبدي جلدا",32,"د",2,0],["فلديها قبور مختلف الزوار فيها","صباحها ومساها",33,"ا",3,0],["فلديك لا غيث السماح بمقلع","كلا ولا ظل السماح بزائل",34,"ل",1,0],["فلديك ينبوع الندى متدفق","عذب وظل المكرمات ظليل",35,"ل",1,0],["فلديه لا شِرْب السَّماح مكدَّر","طَرِق ولا سرب النجاح منَفَّر",36,"ر",1,0],["فلدى السنين الشهب وردي أزرق","عذب ومن نبع الأماني أخضر",36,"ر",1,0],["فلديك منه إذا حللت جنابه","ملك أغر ودولة غراء",37,"ا",2,0],["فلديهِم خاءٌ وميمٌ وراءٌ","أي شيء بالله هذي الحروفُ",38,"ف",1,0],["فلدارون للقرود انتماء","ولنا الفخر بالجدود الرفيعه",39,"ع",2,0],["فَلَدى الخير ما هناك هنانا","وَلَدى الشرّ ما وقاك يَقينا",40,"ن",2,0],["فَلَدَيَّ ما تَهوينَ مِن شَأنِ الصِبا","وَطُلاوَةُ الأَخلاقِ وَالآدابِ",41,"ب",1,0],["فلديهم منك شنشنة","ظهرت بالجود إذ ظهروا",42,"ر",3,0],["فَلَدى لِقطوسَ حَيثُ الوَحشُ ذاع","غادَرا البَحرَ وَسارا في اليَفاع",43,"ع",1,0],["فلدى أخيل غمامةً نشرا","غشيت نواظره فما نظرا",44,"ر",2,0],["فَلدَيهِم سِيَّانِ قَرمٌ عَنِيدٌ","وجَبانٌ عَنِ الوَغى مُتَقاعِس",45,"س",1,0],["فَلَدَيهِ أَبَواهُ بَسَما","وَبِرفقٍ عَنهُ هكطُورُ رَمَى",46,"م",2,0],["فلديه من الدلال رواق","وعليه من الشبيبة سجف",47,"ف",1,0],["فلدعوة في جمعة منه على","جمع الخميس ترده مهزوما",48,"م",2,0],["فلدي سرُّ ذا الأمرِ انكشفْ","كلُّ هذا الجمع يا قوم عكفْ",49,"ف",1,0],["فلدعوة الرسل الكرام إجابة*","والمصطفى أخفى الدعاء وأخّرا",50,"ر",2,0],["فلديكَ ما يشفي منَ الجهْلٍ الذّي","جلبَ القيودَ لأمتي وكبولاً",51,"ل",2,0],["فلدى البيت قد دعوت عليهم","باسط الكفِّ فاستجيب الدُّعاء",52,"ا",2,0],["فَلديكِ أَلفُ زُجاجَةٍ ممدودةٍ","ولَديكِ مَليونُ احتمالٍ مُهْمَلِ",53,"ل",1,0],["فلديَّ متَّسعٌ من الخوفِ المبيَّت","بين ما يُفضي وما قد يَعتري",54,"ر",2,0],["فَلِدفْئنا مستقبلٌ خَظِلٌ","نحن ارتقينا كلّما نزلوا",55,"ل",3,0],["فلدي أوطار معجلة","ولتسأل المزمار والطبلا",56,"ل",2,0],["فلديَّ سرٌ هدّني سأبثّهُ","ولقد حيِيتُ مكتّما أسرارَها",57,"ر",3,0],["فلديّ بعدك خطوتان لأرعوي","ولديك كلّ العمر حتى تندما",58,"م",2,0]]}