38,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[440,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[440,"محلك بالدنيا وبالدين آهل","https://www.aldiwan.net/poem34914.html","الطويل"],[442,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[442,"سرور المرء مقرون ببوس","https://www.aldiwan.net/poem14375.html","الوافر"],[453,"عهدي بأيامي على النيربين","https://www.aldiwan.net/poem13897.html","السريع"],[459,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[459,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[459,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[459,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[459,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[462,"اذا اغبرت فجاج الأرض محلا","https://www.aldiwan.net/poem15373.html","الوافر"],[462,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[462,"يرجى نداه في القطوب وجوده","https://www.aldiwan.net/poem16133.html","الكامل"],[462,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[465,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[469,"يا غرة في جبهة الدهر","https://www.aldiwan.net/poem60102.html","السريع"],[471,"ألست أبا حفص هديت مخبري","https://www.aldiwan.net/poem4810.html","الطويل"],[478,"أبارقا شمته بالغور لماحا","https://www.aldiwan.net/poem15196.html","الرجز"],[478,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[480,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[483,"ونقطة باء في الحقيقة عينه","https://www.aldiwan.net/poem24329.html","عموديه"],[487,"يشتاق قلبي إلى مليكة","https://www.aldiwan.net/poem455.html",""],[494,"فلا انتزع الله الهدى عز بأسه","https://www.aldiwan.net/poem67366.html","الطويل"],[516,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[516,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[516,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[559,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[564,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[568,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[568,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[568,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[580,"خليلي طب على الأيام حالا","https://www.aldiwan.net/poem28337.html","الوافر"]],"verses":[["فما تقلّب طرفي في السماء وما","هذا المشيب وما شبت بي اللمم",0,"م",1,0],["فَما تَرشُفُ الماءَ إِلّا اِعتِلالاً","وَلا تَجرَعُ الماءَ إِلّا قَرَم",1,"م",1,0],["فَما تَشَبَّت بي دارٌ وَلا بَلَدٌ","أَنا الحُسامُ وَما تَحظى بِهِ الخِلَلُ",2,"ل",1,0],["فَما تَطلُبُ الأَيّامُ مِن مُتَغَرِّبٍ","لَهُ كُلَّ يَومٍ رِحلَةٌ وَنُزولُ",3,"ل",1,0],["فَما تُغني القَوادِمُ مِن جَناحٍ","تَحامَلَ إِن قَعَدنَ بِهِ الخَوافي",4,"ف",2,0],["فَما تَوَهُّجُ أَحشايَ عَلى نَفَرٍ","كانوا عَوادِيَ لِلأَيّامِ فَاِرتَجِعوا",5,"ع",3,0],["فَما تَرَكَت مِنكَ الصَوارِمُ وَالقَنا","وَلا أَخَذَت مِنكَ الحِسانُ الحَرائِدُ",6,"د",1,0],["فَما تَطلُبُ البيدُ مِن ساهِمٍ","يُثيرُ عَلَيها رِقابَ الرِكابِ",7,"ب",1,0],["فما تُمَدُّ إِلى غَيْرِ الدُّعاءِ يَدٌ","وليسَ يُفْتَحُ إلا بالثّناءِ فَمُ",8,"م",1,0],["فماتَتْ بجُمْعٍ إذ أظلَّتْ رِقابَهُمْ","سُيوفٌ يُصِمُّ المارِقينَ صَليلُها",9,"ل",3,0],["فَما تَرَكتُ لَهُم وَجهاً لِمُنهَزِمٍ","وَلا طَريقاً يُنَجّيهِم مِنَ العَطَبِ",10,"ب",1,0],["فَما تَزالُ لَنا أَشياءُ نُحدِثُها","تَكونُ لِلناسِ فيما بَعدَنا سُنَنا",11,"ن",2,0],["فَما تَبتَغينَ بِطولِ الصِيا","مِ إِذا أَنتِ أَورَدتِ نَفسي الحِماما",12,"م",2,0],["فَما تَدومُ عَلى حالٍ تَكونُ بِها","كَما تَلَوَّنُ في أَثوابِها الغولُ",13,"ل",1,0],["فَما تَرَكوها عَنوَةً عَن مَوَدَّةٍ","وَلَكِن بِحَدِّ المَشرِفِيّ اِستَقالَها",14,"ل",3,0],["فَمَا تَني تَحْمُدُ آثَارَهُ","وَتَحْفَظُ العَهْدَ وَتَرْعَى الذِّمَامْ",15,"م",1,0],["فَما تَرَكتَ لَهُم مِن عَينِ باقِيَةٍ","إِلاّ الأَرامِلَ وَالأَيتامَ مِن أَحَدِ",16,"د",1,0],["فما تُكبرُ الأملاكُ غيرَك آمراً","ولا ترهبُ الأشرافُ غيرك ناهيا",17,"ي",2,0],["فما تموجّ ماء النهر من غضب","وإنما أخذته رعدة الفرق",18,"ق",1,0],["فما ترك الجهود بلا نجاح","ولا فرصاً تمرّ بلا انتهاز",19,"ز",1,0],["فَما تَيمٌ غَداةَ الحِنوِ فينا","وَلا في الخَيلِ يَومَ عَلَت إِرابا",20,"ب",2,0],["فَما تَلقى مَحَلِّيَ في تَميمٍ","بِذي زَلَلٍ وَلا نَسَبي اِئتِشابا",21,"ب",2,0],["فَما تَقري وَتَنزِلُ يا اِبنَ تَيمٍ","وَعادَةَ لُؤمِ قَومِكَ تَستَعيدُ",22,"د",1,0],["فَما تَأمَنُ الوَجناءُ وَقعَةَ سَيفِهِ","إِذا أَنفَضوا أَو خَفَّ ما في الغَرائِرِ",23,"ر",1,0],["فَما تَرجو النُجومَ بَنو عِقالٍ","وَلا القَمَرَ المُنيرِ إِذا اِستَنارا",24,"ر",2,0],["فَما تَرجو وَلَيسَ هَوى الغَواني","لِأَصحابِ التَنَحنُحِ وَالسُعالِ",25,"ل",1,0],["فما تأتوا يكن حسناً جميلاً","وما تُسدوا لمكرمة تُنيروا",26,"ر",3,1],["فَما تَنازَلنا عَنِ الخُيولِ","يَمنَعُنا الحِرصُ عَنِ النُزولِ",27,"ل",1,0],["فَما تَطلُعُ الشَمسُ المُنيرَةُ فَوقَهُم","عَلى مِثلِهِ مِنهُم أَعَزَّ وَأَكرَما",28,"م",2,0],["فما تكلمت لكن","سكتّ من خلف أذني",29,"ي",1,0],["فما تطايَر كالمخلوقِ من شَررٍ","ولا تَوَاقَر كالمنحوت من خشبِ",30,"ب",1,0],["فما تحمي ذواتُ الدَّرِّ درَّاً","إذا صادفْنَ ملآنَ الوِطابِ",31,"ب",1,0],["فما تصبرُ للحلقِ","ولا تأذى بتشويكِ",32,"ك",1,0],["فما تاجرٌ باعَهُ حَمْدَهُ","بِمُحتقبٍ حَسْرَةَ النادمِ",33,"م",1,0],["فما تجهَّم حاجاتي لكثرتها","ولا تلوَّن منه الوجهُ ألوانا",34,"ن",2,0],["فما تنفك تُركَب كلَّ يوم","ذَلولَ الظهرِ خَوَّار العِنان",35,"ن",1,0],["فَما تَرَكَت أَسيافُنا مِن قَبيلَةٍ","تُحارِبُنا إِلّا لَها عِندَنا وِترُ",36,"ر",1,0],["فَما تَدري إِذا ما الناسُ ساروا","أَتَظعَنُ بَعدَ ذَلِكَ أَم تُقيمُ",37,"م",1,0],["فَما تَبَلَت تَبلاً فَيُدرَكَ عِندَها","وَلا سَبَقَتها في سِواها تُبولُها",38,"ل",3,0],["فَما تَرَكَت حَيّاتُنا لَكَ حَيَّةً","تَقَلَّبُ في أَرضٍ بَراحٍ وَلا بَحرِ",39,"ر",1,0],["فَما تَعبِسُ لِلحَزنِ","وَلا تَضحَكُ لِلسَهلِ",40,"ل",1,0],["فَما تَندى لَنا أَبَداً ضُلوعٌ","عَلَيكَ وَما تَجِفَّ لَنا شُؤونُ",41,"ن",1,0],["فَما تَعَكَّرَ إِلّا وَهوَ مُنحَبِسٌ","وَالنَفسُ كَالماءِ تَحكيهِ وَيَحكيها",42,"ي",3,0],["فَما تَعَزَّت بِأَنَّ الدَهرَ يَجمَعُنا","يَوماً وَلا فَرِحَت أَنّي أُمَنّيها",43,"ي",3,0],["فَما تُنبِتُ الغَبراءُ غَيرَ مَصائِبٍ","وَما تُمطِرُ الأَفلاكُ إِلّا دَواهِيا",44,"ي",2,0],["فَما تَنفَعُ في الدُنيا","وَلا تَشفَعُ في الأُخرى",45,"ر",2,0],["فَما تَصلُحُ لِلهَزلِ","وَلا تَصلُحُ لِلجَدِّ",46,"د",1,0],["فما تعلاتها والموت مدركها","إلا كما أمن المسلول للأَجل",47,"ل",1,0],["فما تركوا من الأخلاق سمحا","على وجه التراب ولا رضيا",48,"ي",2,0],["فَماتَ مَقتولاً وَطالَ صَلبُهُ","وَأُحرِقَت جِثَتُه بَعدَ البَلى",49,"ا",1,0],["فَماتَ تَحتَ المرهفات حرا","لَم يَألُ خَيرَ الأُمَهات بَرّا",50,"ر",2,0],["فَما تَيَّمتُ أَفئِدَةً","وَلا أَسكَرتُ آذانا",51,"ن",2,0],["فَماتا أَمامَ اللَهِ مَوتَ بَسالَةٍ","كَأَنَّهُما فيهِ مِثالٌ مُنَصَّبُ",52,"ب",1,0],["فَماتَ بِحَيْثُ ما سَمِعْتْهُ أُذْنٌ","فلا يُرْجَى لَهُ أَبَداً نُشُورُ",53,"ر",1,0],["فَماتَ ولا صَبْري على الأَجْرِ واقِفٌ","ولا أنا في عُمْرٍ إلى اللّهِ راغِبُ",54,"ب",1,0],["فَما تَقَلَّدَ بِالياقوتِ مُشبِهُها","وَلا تَقَلَّدَ بِالهِندِيَّةِ القُضُبِ",55,"ب",1,0],["فَما تُرَجّي النُفوسُ مِن زَمَنٍ","أَحمَدُ حالَيهِ غَيرُ مَحمودِ",56,"د",1,0],["فَما تَرَكوا الإِمارَةَ لِاِختِيارٍ","وَلا اِنتَحَلوا وِدادَكَ مِن وِدادِ",57,"د",1,0],["فَما تَرزُقُ الأَقدارُ مَن أَنتَ حارِمٌ","وَلا تَحرِمُ الأَقدارُ مَن أَنتَ رازِقُ",58,"ق",1,0],["فَما تُكَشِّفُكَ الأَعداءُ مِن مَلَلٍ","مِنَ الحُروبِ وَلا الآراءِ عَن زَلَلِ",59,"ل",1,0],["فَما تَقِفُ السِهامُ عَلى قَرارٍ","كَأَنَّ الريشَ يَطَّلِبُ النِصالا",60,"ل",2,0],["فَما تَرَكنَ بِها خُلداً لَهُ بَصَرٌ","تَحتَ التُرابِ وَلا بازاً لَهُ قَدَمُ",61,"م",1,0],["فَما تَزيدُ عَلى إِلمامَةٍ خُلَسٍ","بِأَحمَدَ بنِ عَلِيٍّ ثُمَّ تَنقَلِبُ",62,"ب",1,0],["فَما تَبرَحُ الآمالُ تَثني وُجوهَها","إِلى طارِفٍ مِن فَضلِهِم وَتَليدِ",63,"د",1,0],["فَما تَتَعاطى ما يَنالونَهُ يَدٌ","وَلا يَتَقَصّى ما يُنيلونَهُ شُكرُ",64,"ر",1,0],["فَما تَرَكَ المَنصورُ نَصرَكَ عِندَها","وَلا خانَكَ السَجادُ فيها وَلا الحَبرُ",65,"ر",1,0],["فَما تَخطِرُ الشُبّانُ فيها مَخيلَةً","وَلا الشَيبُ تَستَدعي وَقاراً كُهولُها",66,"ل",3,0],["فَما تَنفَكُّ بُشرى عَن تَرَدّي","عَدُوٍّ خاضِعٍ لَكَ مُستَكينِ",67,"ن",1,0],["فَماتَ وَلَم يُؤثَر وَما مِن قَبيلَةٍ","مِنَ الناسِ إِلّا قَد أَباتَ عَلى وِترِ",68,"ر",1,0],["فَماتَ وَلَم يَزِدهُ اللَهُ إِلّا","هَواناً وَهوَ مُهتَضَمُ النَصيرِ",69,"ر",1,0],["فَما تُقبِلُ الأَحياءُ مِن حُبِّ خِندِفٍ","وَلَكِنَّ أَطرافَ العَوالي تَصورُها",70,"ر",3,0],["فَما تَرَكَت لَها صَحراءُ غَولٍ","وَلا الصَوّانُ مِن جَذَمٍ نِعالا",71,"ل",2,0],["فَما تَحيَ لا أَرهَب وَإِن كُنتُ جارِماً","وَلَو عَدَّ أَعدائي عَلَيَّ لَهُم ذَحلا",72,"ل",2,0],["فَما تَمَّ في سَعدٍ وَلا آلِ مالِكٍ","غُلامٌ إِذا ما قيلَ لَم يَتَبَهدَلِ",73,"ل",1,0],["فَما تَرَكَ الجَرّاحُ إِذ ماتَ بَعدَهُ","مُجيراً عَلى الأَيّامِ ذاتِ الجَرائِمِ",74,"م",1,0],["فَما تَرَكَت بِالمَشرِعَينِ سُيوفُكُم","نُكوباً عَنِ الإِسلامِ مِمَّن وَرائِيا",75,"ي",2,0],["فما تم لنا الإفطا","ر بالقوت ولا صمنا",76,"ن",2,0],["فما ترى غصنا إلا وزهرته","تجلوه في جبة منها ودواج",77,"ج",1,0],["فما تَنِي بينَهُمُ","جَواهِرُ الرِّزْقِ نسَقْ",78,"ق",1,0],["فما تَعبي إلا لتجديدِ راحةٍ","ولا سَهَري إلا لطولِ رُقادي",79,"د",2,0],["فَما تَمَّ لي يَوماً إِلى اللَيلِ مَنظَرٌ","أ