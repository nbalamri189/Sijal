hat=shqas&qid=84675&r=&rc=5",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""]],"verses":[["مُرَوَّعٍ مِن حَولِهِ كَأَنَّهُ","صالٍ يَقي البُردَ نَوازي الشَرَرِ",0,"ر",1,0],["مَرّوا يَجُرّونَ الرِماحَ لِغارَةٍ","وَالطالِعاتُ عَنِ الدُجى لَم تُجرَرِ",1,"ر",1,0],["مَرّوا عَلى رَملَي زَرودَ فَهَل تَرَى","إِلصاقَةً لِحَشىً بِرَملِ زَرودِ",2,"د",1,0],["مُرَوَّعَةٌ لَو خَلفَها صَرَّ جُندُبٌ","رَأَيتُ لَها مِن رَوعَةِ القَلبِ أَفكَلا",3,"ل",2,0],["مَرَوا دِرَرَ الحروب دماً وقاسوا","من الهيجاء ضِرساً بعد ضرس",4,"س",1,0],["مُروا أَساطيلَكُم في البَحرِ تَرصُدُنا","وَتَأصُدُ البَحرَ مِن مَوجٍ وَحيتانِ",5,"ن",1,0],["مُروا فَتَصولُ الجُنودُ عَلَيهِم","تُعَلِّمهُم كَيفَ فَتكُ المَنون",6,"ن",1,0],["مَروانُ أَحزَمُها إِذا نَزَلَت بِهِ","حُدبُ الأُمورِ وَخَيرُها مَسؤولا",7,"ل",2,0],["مَروانُ لَيسَ لِلأُمور صاحِبا","وَإِن غَدَت لِذَيلِهِ مساحبا",8,"ب",2,0],["مَروانُ إِنَّ مَطِيَّتي مَعكوسَةٌ","تَرجو الحِباءَ وَرَبُّها لَم يَيأَسِ",9,"س",1,1],["مُروجٌ لِلقُلوبِ بِها اِمتِزاجٌ","كَأَنَّ عُيونَها أَيدي الكَريمِ",10,"م",1,0],["مَرّوا بِها خُزرَ العُيونِ فَأَوجَسَت","جَزَعاً وَكادَت بِالكُماةِ تَميدا",11,"د",2,0],["مُرَوَّعَةٌ أموالُهُ بعَطَائِهِ","كأنّ جنوناً مَسّها مِنْهُ أو خَبْلُ",12,"ل",1,0],["مُرْ ودَعْ همّي لأُمّي وأبي","إنما استأذنْتُ خيرَ الآمرِينْ",13,"ن",1,0],["مُرّو اللِقاءَ وَمُبقو العَقدِ إِن عَقَدوا","إِذا أَضاعَ مِنَ الميثاقِ مُشتَرِطُ",14,"ط",1,0],["مَروجٍ طَرُوجٍ تَبعَثُ الوُرقَ بَعدَما","يُعرِّسنَ شَكوى آهَةً وَتَذَمُّرا",15,"ر",2,0],["مُرُوجٌ كَسا القَريانُ ظَاهِرَ لَونِها","مِراراً مِنَ القُرَّاصٍ أَحوى وأَصفَرا",16,"ر",2,0],["مَرُّوا خِفافاً على الوادي كأنهمُ","مواكبُ السُّحُبِ البيضاءِ في الطَّفَلِ",17,"ل",1,0],["مرّوا على الغار مضللينا","وأخذوا السّبل مسائلينا",18,"ن",2,0],["مروان وهو منتهى أميّه","لم يفقد العزم ولا الحميّه",19,"ه",1,0],["مُرَوَّعَةٌ هِيجَتْ فَضَلَّتْ سَبِيلَهَا","فَسَارَتْ عَلَى الدُّنْيَا كَمَا انْتَشَرَ الرِّجْلُ",20,"ل",1,0],["مُرُوجٌ جَلاهَا الزَّهْرُ حَتَّى كَأَنَّها","سَمَاءٌ تَرُوقُ الْعَيْنَ بِالأَنْجُمِ الزُّهْرِ",21,"ر",1,0],["مَرُوضاً عَلَى الوَثَبَاتِ الكِبَا","رِ وَمُهْجَةُ مِصْرَ لَهُ تَرْأَمُ",22,"م",1,0],["مَرْوٌ تَشَكَّى الرِّجْلُ منه الأذى","وإِثمدٌ يُجعلُ فِي العَيْنِ",23,"ن",1,0],["مُرْ واِفتَح باقِيَ أنْدَلُسٍ","ما فِي صَبَبٍ أو فِي صَعَدِ",24,"د",1,0],["مُرْ وَانْهَ في الْحَقِّ فَالأَسْمَاعُ مُصْغِيَةٌ","فِدَاؤُكَ النَّفْسُ مِنْ نَاهٍ وَأمَّار",25,"ر",1,0],["مرّوا كأشرطةِ السّيما وما تركوا","إلا حُطاماً من الذكرى يُؤَسِّينا",26,"ن",2,0],["مروع ألمعي في بصيرته","من الذكاء لمحض الرأي تبيان",27,"ن",1,0],["مرّوا فتصول الجنود عليهم","تعلّمهم فتك المنون",28,"ن",1,0],["مروان آب إلى الحمى فتزيّنت","للقائه بعد القطيعة جلّق",29,"ق",1,0],["مروا خفاقا على الوادي كأنّهم","مواكب السّحب البيضاء في الطّفل",30,"ل",1,0],["مروءتنا في شأن قارع بابنا","مروءة ذي سير بأعلى المسالك",31,"ك",1,1],["مروى الصدى مالَه عن جوده مشغلٌ","لهف لنا عن جمان ليسَ ينتقلُ",32,"ل",1,0],["مروَّعُ القلب مكلومُ الحشا دنِفٌ","يكاد يَقضي ولا يُقضيَ له وطرُ",33,"ر",1,0],["مُروعه تحسَبُ في هاماتها","صوارما منه عليها تُنتَضَى",34,"ض",2,0],["مُرَوَّضٍ جادَ هَذا الغَيثُ تُربَتَهُ","فَراحَ في خِلَعٍ مِن نورِهِ وَغَدا",35,"د",2,0],["مروع المقلة طاوى الحشا","مؤنث الدل مريض البنان",36,"ن",1,0],["مروى الصدا بحر الندا والجدا","محى الهدى مفنى العدا بالردا",37,"د",2,0],["مروَّعاً يَفتحُ قَصرَ الضيا","أَمام شَمس النُهُرِ العائِدَه",38,"ه",1,0],["مُروا الزَمانَ يَواتيني فَتَسفِرَ لي","حُظوظُهُ وَتَفي أَيّامُهُ الغُدُرُ",39,"ر",1,0],["مُرَوِّحاً عَنْ جَوَى يُكْنَى أَبَا لَهَبٍ","وَزَفَرَاتٍ لَهُ حَمَّالَةُ الْحَطَبِ",40,"ب",1,0],["مروّعتي بالبين هَل من زيارة","تَعيش بها الارواح من قبل تَذهَب",41,"ب",1,0],["مُرَوَّقُ الأَخلاقِ يَغنى بِهِ","جَليسُهُ عَن شُربِ بِنتِ الدِنان",42,"ن",1,0],["مُرَوِّضُ الأَخلاقِ يُستَغنى بِهِ","عَن شُربِ ما رُوِّقَ مِن ماءِ العِنَب",43,"ب",1,0],["مروحاً من هم تدبيره","مستمسكاً باللَهِ معتصم",44,"م",1,0],["مروعة الظل مقرورةٌ","تعربدُ فيها رياح الخريف",45,"ف",1,0],["مَروحٍ تَغتَلي بِالبيدِ حَرفٍ","تَكادُ تَطيرُ مِن رَأيِ القَطيعِ",46,"ع",1,0],["مُروءةُ مُعسِرٍ عَفٍّ قَنوع","يُقَدِّرُ في مَعيشَتِهِ وَيُمسِك",47,"ك",1,1],["مَرَوِّعي سارَ لا شَطَّت زِيارَتُهُ","لِمّا اِنثَنى قاتِلي عَمداً بِلا قَوَدِ",48,"د",1,0],["مَروحاً يُجاذِبنُا في القِيادِ","تَخالُ مِنَ الفُؤادِ فيهِ اِقوِرارا",49,"ر",2,0],["مَرّوا سِراعاً نحْو دَارِ البَقا","ونحنُ في آثارَهم نرحْل",50,"ل",1,0],["مُرُوا النّسِيمَ إذا مَا الفجرُ أيقظَه","بحملِهِ طيبَ نَشرٍ مِنهُ أَحياني",51,"ن",2,0],["مُروّعٌ بالقِلَى والصَّدِّ ليس له","صبرٌ على الهجرِ والإعراضِ يُسْعِدُهُ",52,"د",2,1],["مرَّ والدَّهر فيه طلق المحيا","كمرور الخيال في الأَحلام",53,"م",1,0],["مَروضُ الحِلمِ طمّاح المواضي","إذا ساموهُ عفواً أو عقابا",54,"ب",2,0],["مروا بالعروف وانهوا عن نكير","وتقوى اللَه تفروا عراها",55,"ا",3,0],["مروا بالعرف وائتمروا وانهوا","عن النكر الَّذي يسم الجباها",56,"ا",3,0],["مرَّ وبقَّاني أغادي ربعَه","بجسدٍ يحسَبه تِمثالَه",57,"ل",2,0],["مَرَّ وولّاهم رَذايا سَرِحها","يدبِّرون منه أمراً مدْبِرا",58,"ر",2,0],["مُرٌّ وإن أجدَتْك أخلاقُهُ","شمائلَ الصهباءِ لم تَقطِبِ",59,"ب",1,0],["مُروي شفار المواضي وهي ظامئة","ومطعمُ الضيفِ في جدب وإرغاد",60,"د",1,0],["مُروِّي القنا واليوم تَظْمى كمانه","وهامي النَّدى والعامُ أشهبُ ماحلُ",61,"ل",1,0],["مروِّي سيوف الهند من مهج العِدى","ومُعْلي سنى النيران في كل منزل",62,"ل",1,0],["مُروي القنا من نحور الدارعين ضحى","إذا التقتْ وفَراتُ الجيش والثُّننُ",63,"ن",1,0],["مروي الهوامد والبيض الصَّوارم من","ماءِ المَكارمِ سَحّاً أوْ دَمِ الهامِ",64,"م",1,0],["مُروجُها مِن زَهرِها قَد حَكَت","بُسطاً مِنَ الديباجِ رومِيَّه",65,"ي",2,0],["مروت سحرك في إبان بابله","آت ليقتنص الألباب بالعجب",66,"ب",1,0],["مُروِي الصَّدَى","رَحبُ الفَنَا",67,"ن",2,0],["مُروِي الصَّدَى عَلقَمِيٌّ مجَّ عَاسِلُهُ","رَحبُ الفَنَا نَبَوِيَّاتٌ مَنَاقِبُهُ",68,"ب",2,0],["مروا بها وأثرتها فظباؤها","قنص إلى شرك الجميل يثار",69,"ر",1,0],["مرواد من نحور الدارعين لها","مكاحل ودم الأوداج إكحال",70,"ل",1,0],["مروعاً فَلَمّا لَم أَجِد غَيرَ فِتيَة","نِيام وَاكوار لَدَيهُن اينق",71,