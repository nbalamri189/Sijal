{"poems":[[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[53,"شيمي لحاظك عنا ظبية الخمر","https://www.aldiwan.net/poem30460.html","البسيط"],[63,"ألا بأبي بذي الأثلات ربع","https://www.aldiwan.net/poem45774.html","الوافر"],[55,"قد كنت أرجو وصلكم","https://www.aldiwan.net/poem26548.html","مجزوء الكامل"],[77,"على قدر ما يلتاح من ذلك الحسن","https://www.aldiwan.net/poem36020.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"يا نجعة الوزراء والنواب","https://www.aldiwan.net/poem36707.html","الكامل"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[86,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[71,"لطيفكم عندي يد لا أضيعها","https://www.aldiwan.net/poem4003.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[93,"بنات الدهر عوجي لا تهابي","https://www.aldiwan.net/poem9824.html","عموديه"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[37,"لطالما لثلثت رحلي مطيته","https://www.aldiwan.net/poem6995.html","البسيط"],[47,"لطيرتي بالصداع نالت","https://www.aldiwan.net/poem25109.html","مجزوء البسيط"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[72,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[72,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"جمعت آيتين محييه طورا","https://www.aldiwan.net/poem64619.html","الخفيف"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[51,"ويتيمة من كرمها ومديمها","https://www.aldiwan.net/poem66037.html","الكامل"],[51,"لو أنني ملكت طرد محبتي","https://www.aldiwan.net/poem66522.html","الكامل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[70,"رفعت رايتي على العشاق","https://www.aldiwan.net/poem42791.html","الخفيف"],[70,"يومنا يوم مطير","https://www.aldiwan.net/poem42877.html","مجزوء الرمل"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[78,"جاءتك ليلا في ثياب نهار","https://www.aldiwan.net/poem14058.html","الكامل"],[32,"لطاف الحشا بيض الخدود أوانس","https://www.aldiwan.net/poem27701.html","الطويل"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[43,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[62,"بدموعنا غسلت بقايا ذنبنا","https://www.aldiwan.net/poem52179.html","الكامل"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52220.html","السريع"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[45,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[45,"رأيت الرياض الزهر يونق نورها","https://www.aldiwan.net/poem65641.html","الطويل"],[28,"وآلفة برد الحجال احتويتها","https://www.aldiwan.net/poem5224.html","الطويل"],[61,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[61,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[49,"لطائر كل حادثة وقوع","https://www.aldiwan.net/poem62158.html","الوافر"],[49,"لطرفها وهو مصروف كموقعه","https://www.aldiwan.net/poem65377.html","البسيط"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[31,"أرقت فلم أنم طربا","https://www.aldiwan.net/poem42646.html","مجزوء الوافر"],[105,"جمعن المشارق في المؤتمر","https://www.aldiwan.net/poem42051.html","المتقارب"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[81,"إليكم يحن القلب في كل ساعة","https://www.aldiwan.net/poem61381.html","الطويل"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[13,"إني لمهد من ثناء فقاصد","https://www.aldiwan.net/poem2214.html","الطويل"],[48,"أحب إلي من وخد المطايا","https://www.aldiwan.net/poem65105.html","الوافر"],[48,"ثقيل يطالعنا من أمم","https://www.aldiwan.net/poem65265.html","المتقارب"],[48,"أوصي أخي إلى النديم","https://www.aldiwan.net/poem66608.html","مجزوء الكامل"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[46,"إذا طرق المسكين دارك فاحبه","https://www.aldiwan.net/poem23206.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141022",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16675","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42729","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54835","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55333","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54762","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[13,"لَقَدْ قَالَ الخَلِيُّ وَقَالَ حُلْساً","https://www.poetsgate.com/ViewPoem.aspx?id=180796",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[0,"ألا عِمْ صَبَاحاً أيّهَا الطّلَلُ البَالي","https://www.poetsgate.com/ViewPoem.aspx?id=4731",""],[51,"أعرف ورَّاقاً بآيينهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30682",""],[97,"في يوم الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=151462",""],[31,"أرقتُ فلم أنمْ طربا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18757&r=&rc=20",""],[90,"أجب أيُّها القلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66846&r=&rc=201",""]],"verses":[["لَطَمنا بِأَيديها الفَيافي إِلَيكُمُ","وَقَد دامَ إِغذاذٌ وَطالَ كَلالُ",0,"ل",1,0],["لَطابَ فَرعُكَ وَاِهتَزَّت أَراكَتُهُ","في المَجدِ إِنَّ المَعالي أَطيَبُ الشَجَرِ",1,"ر",1,0],["لَطَمتُ إِلَيهِ خَدَّ الأَرضِ حَتّى","تَراخَت في أَزِمَّتِها المَطيُّ",2,"ي",1,0],["لَطَلَبتُهُ وَجَمَعتُهُ","مِن كُلِّ أَرضٍ أَو سَماءِ",3,"ا",2,0],["لَطَائِفُهُ أَبْقَتْ عَلَيَّ فَكُلَّمَا","تَعَدَّيْتُ طَوْرِي فِيهِ غَيّبَنِي عَنِّي",4,"ي",1,0],["لَطَالَ وُقُوفٌ وَاسْتَهَلَّتْ مَدَامِعٌ","وَبُثَّ غَرَامٌ طَالَمَا صَانَهُ كَتْمُ",5,"م",1,0],["لَطْفٌ يَدُلُّ عَلَى الْعِنَايَةِ وَالرِّضَى","فَكَأَنَّهُ الْعُنْوَانُ فَوْقَ كِتَابِ",6,"ب",1,0],["لَطيفٌ كَصُدّادِ الصَفا لا تَغُرُّهُ","بِمُرتَقَبٍ وَحشِيَّةٌ وَهُوَ حازِمُ",7,"م",1,0],["لَطَمَت مَجدُلينُ بَعدَكَ خَدَّي","ها وَقامَت قِيامَةُ العَبَراتِ",8,"ت",1,0],["لِطَيفِكُمُ عِندي يَدٌ لا أضيعُها","سَأَشكُرُها شُكرَ الرِياضِ يَدَ القَطرِ",9,"ر",1,1],["لَطيفَةُ طَيِّ الكَشحِ غَيرُ مُفاضَةٍ","إِذا اِنفَلَتَت مُرتَجَّةً غَيرَ مِتفالِ",10,"ل",1,0],["لَطِيفاً فِي الْتِمَاسِ الْقَصْدِ حَتَّى","لَتَشْتَبِهُ المَضَايِقُ بِالرِّحَابِ",11,"ب",1,0],["لَطِّفْ أَسَاكَ أَبَا المَحَاسِنِ مَا النَّوَى","فِي اللهِ نَأْيٌ إِنَّهَا قُرْبَانُ",12,"ن",1,0],["لطالما لثلثت رَحْلي مطيتُه","في دِمْنة وسرتْ صفواً بأكدارِ",13,"ر",1,1],["لِطَيرَتي بِالصُداعِ نالَت","فَوقَ مَنالِ الصُداعِ مِنّي",14,"ي",1,1],["لطالب الجود شغل من فتوّته","وطالبِ العلم أشغال بإفتاء",15,"ا",2,0],["لطافة حفَّت بها هيبةٌ","كالسيف ذو الرّونق والمقطع",16,"ع",1,0],["لطابت على علياه طيبة دوره","غدت لمساعي حجّه كختام",17,"م",1,0],["لطالب الجود ملء رغبته","وطالب العلم ملء أفهامه",18,"م",2,0],["لطائفِ البيت الذي لم يزل","لطائف الآمال أركانه",19,"ن",2,0],["لِطيزِها في كلّ أيرٍ زنى","رأيٌ كرأي الصّقر في الأرنبِ",20,"ب",1,0],["لطفتْ مسالكها وخُصَّ مَحَلُّها","فكأنها انْشَقَّتْ من الأرواحِ",21,"ح",1,0],["لطفلنا موقِف تُغْضي الكُفاةُ له","وسيفُهُ فيهمُ أمضى من القدر",22,"ر",1,0],["لطفت فاغتدت تَحل من الأجْ","ساد من لطفها محل النفوس",23,"س",1,0],["لطيفةُ قدّ الثدي تُسند عودَها","إلى ناجمٍ في ساحةِ الصدر فالك",24,"ك",1,0],["لطُفتْ فقد كادتْ تكون مُشاعةً","في الجو مثلَ شُعاعها ونسيمِها",25,"م",3,0],["لَطردْتُها جهْدِي فكنتُ بأن أرى","لك زائراً والهجرُ في إمكاني",26,"ن",2,0],["لَطُفَت مَعانيها وَرَق","قَت وَالحَلاوَةُ في الرِقاقِ",27,"ق",1,0],["لَطُفَت في وَصفِ الهَوى كَلِماتي","أَينَ أَهلُ القُلوبِ وَالأَشواقِ",28,"ق",1,0],["لَطُفَت بِالدَنِّ حَتّى","قيلَ سِرٌّ وَضَميرُ",29,"ر",1,0],["لِطَيْفِ الحَيَاة الَّذي لا يُملُّ","وقلبُ الرَّبيعِ الشذيِّ الخضِرْ",30,"ر",1,0],["لَطُفَ الجُمودُ لِذا وَذا فَتآلَفا","لَم يَلقَ ضِدٌّ ضدّهُ بِنِفارِ",31,"ر",1,0],["لطافُ الحشَا بِيض الخدودِ أوَانِسٌ","عِذابُ الثّنايا قَد مثلنَ بِنا مَثلا",32,"ل",2,1],["لطيفة في لعبها","خفيفة في وثبها",33,"ه",2,0],["لَطَفَ اللَهُ فَعوفينا مَعاً","وَاِرتَهَنّا لَكَ بِالشُكرِ لِسانا",34,"ن",2,0],["لَطَفَ اللَهُ بِباريسَ وَلا","لَقِيَت إِلّا نَعيماً وَسَلاما",35,"م",2,0],["لَطَّفتَ رَأيَكَ في بِرّي وَتَكرِمَتي","إِنَّ الكَريمَ عَلى العَلياءِ يَحتالُ",36,"ل",1,0],["لطف الرؤوف بها فأحرق ذنبها","عنها وصان بلطفه أجسامها",37,"م",3,0],["لطيفة الخصر وأردافها","وجيدها من خصرها أكبرُ",38,"ر",1,0],["لطُفَتْ مواعِظُه فلم يَشْعُرْ بها","إِلّا اللبيبُ وعِلْمُه لم ينفَعِ",39,"ع",1,0],["لُطفُ الرَبيعِ لَها يَصوغُ حُلِيِّها","بِغَرائِبٍ مِن لُؤلُؤٍ وَزَبَرجَدِ",40,"د",1,0],["لَطيفُ الحَواشي مُخطَفُ الخَصرِ أَهيَفٌ","بِفَترِ لِحاظٍ سالِبِ اللُبِّ وَالعَقلِ",41,"ل",1,0],["لَطيفٌ إِذا ما اِنسَلَّ أَدرَكَ ما اِبتَغى","إِذا هُوَ لِلطِنءِ المَخوفِ تَقَتَّرا",42,"ر",2,0],["لَطائِمُ المِسْكِ والكافورِ فائحةٌ","منه ومُنْتَخَبُ الهِنْديِّ والغارِ",43,"ر",1,0],["لطمَتْ خدّضها بحُمْرٍ لِطافٍ","نال منها عَذابَ بيضٍ عِذابِ",44,"ب",1,0],["لِطائِرِ كُلَّ حادِثَةٍ وُقوعُ","وَلِلدُنيا بِصاحِبِها وَلوعُ",45,"ع",1,1],["لطرفها وهو مصروف كموقعه","في القلب حين يروع القلب موقعُهُ",46,"ع",2,1],["لَطَمَحتَ في الإِبراقِ وَالإِرعادِ","وَغَدا عَلَيَّ بِسَيلِ لَومِكِ غادِ",47,"د",1,1],["لَطَيفِ أَحَبِّ خَلقِ اللَ","هِ إِنساناً وَإِن غَضِبا",48,"ب",2,0],["لِطافِ الأنامِل بيض البنان","تذيب الحديد وتفري الحجرْ",49,"ر",1,0],["لَطمتكِ من سَفهٍ وسُوءِ خَلِيقَةٍ","يَدُهُ وتلكَ جنايةٌ ما تُغْفَرُ",50,"ر",1,0],["لَطائِفُ آدابٍ فُكاهَةُ مَجلِسٍ","مَوائِدُ أَمثالٍ نَوادِرُ أَشعارِ",51,"ر",1,0],["لَطابَ نَفسُ أَميرِ المُؤمِنينَ وَلَم","يَدَع لِصَوتِ الهُدى الداعي تَوَرُّعُهُ",52,"ع",2,0],["لَطيفُ الحَوايا يَقسِمُ الزادَ بَينَهِ","سَواءٌ وَبَينَ الذِئبِ قَسمَ المَشارِكِ",53,"ك",1,0],["لِطَرفي مِنهُ ميعادٌ بِطَرفٍ","وَفي قَلبي بِلَحظَتِهِ كُلومُ",54,"م",1,0],["لِطَلعَتِهِ وَخزَةٌ في الحَشا","كَوَقعِ المَشارِطِ في المُحتَجِم",55,"م",1,0],["لِط بالخلائق أجمعي","ن ولو بشيطانٍ رجيم",56,"م",1,0],["لِطارِفِ حُبٍّ أَصابَ الفُؤاد","وَقَد يَمنَعُ الطارِفُ التالِدا",57,"د",2,0],["لَطالَ عَلَيَّ الوَقتُ وَالنَفسُ عُمرُها","كَأَقصَرِ ظِلٍّ في الزَمانِ الشَمَردَلِ",58,"ل",1,0],["لُطِمنَ بِتُرسٍ شَديدِ الصِفا"