diwan.net/poem20797.html","الطويل"],[515,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[544,"تقيم المأتم الأعلى","https://www.aldiwan.net/poem1763.html","الهزج"],[554,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[559,"ذات تبدت في بديع حلاها","https://www.aldiwan.net/poem33589.html","الكامل"],[559,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[559,"دخل إلى بيت قلبي بارقه رفرف","https://www.aldiwan.net/poem34347.html","المواليا"],[559,"لطائر السر في أوج الرقيقه وكر","https://www.aldiwan.net/poem34539.html","المواليا"],[563,"أتتني بلا وعد من المنزل الأسنى","https://www.aldiwan.net/poem52898.html","الطويل"],[564,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[568,"قم قد أتى ضوء الصباح المسفر","https://www.aldiwan.net/poem69462.html","الرمل"],[568,"تبارك فاطر القمر اقتدارا","https://www.aldiwan.net/poem69691.html","الوافر"],[568,"مذبة تهدى إلى سيد","https://www.aldiwan.net/poem69814.html","السريع"],[571,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"],[587,"دعاه ورقم الليل بالبرق مذهب","https://www.aldiwan.net/poem17416.html","الطويل"]],"verses":[["لَطَمنا بِأَيديها الفَيافي إِلَيكُمُ","وَقَد دامَ إِغذاذٌ وَطالَ كَلالُ",0,"ل",1,0],["لَطابَ فَرعُكَ وَاِهتَزَّت أَراكَتُهُ","في المَجدِ إِنَّ المَعالي أَطيَبُ الشَجَرِ",1,"ر",1,0],["لَطَمتُ إِلَيهِ خَدَّ الأَرضِ حَتّى","تَراخَت في أَزِمَّتِها المَطيُّ",2,"ي",1,0],["لَطَلَبتُهُ وَجَمَعتُهُ","مِن كُلِّ أَرضٍ أَو سَماءِ",3,"ا",2,0],["لَطَائِفُهُ أَبْقَتْ عَلَيَّ فَكُلَّمَا","تَعَدَّيْتُ طَوْرِي فِيهِ غَيّبَنِي عَنِّي",4,"ن",2,0],["لَطَالَ وُقُوفٌ وَاسْتَهَلَّتْ مَدَامِعٌ","وَبُثَّ غَرَامٌ طَالَمَا صَانَهُ كَتْمُ",5,"م",1,0],["لَطْفٌ يَدُلُّ عَلَى الْعِنَايَةِ وَالرِّضَى","فَكَأَنَّهُ الْعُنْوَانُ فَوْقَ كِتَابِ",6,"ب",1,0],["لَطيفٌ كَصُدّادِ الصَفا لا تَغُرُّهُ","بِمُرتَقَبٍ وَحشِيَّةٌ وَهُوَ حازِمُ",7,"م",1,0],["لَطَمَت مَجدُلينُ بَعدَكَ خَدَّي","ها وَقامَت قِيامَةُ العَبَراتِ",8,"ت",1,0],["لِطَيفِكُمُ عِندي يَدٌ لا أضيعُها","سَأَشكُرُها شُكرَ الرِياضِ يَدَ القَطرِ",9,"ر",1,1],["لَطيفَةُ طَيِّ الكَشحِ غَيرُ مُفاضَةٍ","إِذا اِنفَلَتَت مُرتَجَّةً غَيرَ مِتفالِ",10,"ل",1,0],["لَطِيفاً فِي الْتِمَاسِ الْقَصْدِ حَتَّى","لَتَشْتَبِهُ المَضَايِقُ بِالرِّحَابِ",11,"ب",1,0],["لَطِّفْ أَسَاكَ أَبَا المَحَاسِنِ مَا النَّوَى","فِي اللهِ نَأْيٌ إِنَّهَا قُرْبَانُ",12,"ن",1,0],["لطالما لثلثت رَحْلي مطيتُه","في دِمْنة وسرتْ صفواً بأكدارِ",13,"ر",1,1],["لِطَيرَتي بِالصُداعِ نالَت","فَوقَ مَنالِ الصُداعِ مِنّي",14,"ي",1,1],["لطالب الجود شغل من فتوّته","وطالبِ العلم أشغال بإفتاء",15,"ا",2,0],["لطافة حفَّت بها هيبةٌ","كالسيف ذو الرّونق والمقطع",16,"ع",1,0],["لطابت على علياه طيبة دوره","غدت لمساعي حجّه كختام",17,"م",1,0],["لطالب الجود ملء رغبته","وطالب العلم ملء أفهامه",18,"م",2,0],["لطائفِ البيت الذي لم يزل","لطائف الآمال أركانه",19,"ن",2,0],["لِطيزِها في كلّ أيرٍ زنى","رأيٌ كرأي الصّقر في الأرنبِ",20,"ب",1,0],["لطفتْ مسالكها وخُصَّ مَحَلُّها","فكأنها انْشَقَّتْ من الأرواحِ",21,"ح",1,0],["لطفلنا موقِف تُغْضي الكُفاةُ له","وسيفُهُ فيهمُ أمضى من القدر",22,"ر",1,0],["لطفت فاغتدت تَحل من الأجْ","ساد من لطفها محل النفوس",23,"س",1,0],["لطيفةُ قدّ الثدي تُسند عودَها","إلى ناجمٍ في ساحةِ الصدر فالك",24,"ك",1,0],["لطُفتْ فقد كادتْ تكون مُشاعةً","في الجو مثلَ شُعاعها ونسيمِها",25,"م",3,0],["لَطردْتُها جهْدِي فكنتُ بأن أرى","لك زائراً والهجرُ في إمكاني",26,"ن",2,0],["لَطُفَت مَعانيها وَرَق","قَت وَالحَلاوَةُ في الرِقاقِ",27,"ق",1,0],["لَطُفَت في وَصفِ الهَوى كَلِماتي","أَينَ أَهلُ القُلوبِ وَالأَشواقِ",28,"ق",1,0],["لَطُفَت بِالدَنِّ حَتّى","قيلَ سِرٌّ وَضَميرُ",29,"ر",1,0],["لِطَيْفِ الحَيَاة الَّذي لا يُملُّ","وقلبُ الرَّبيعِ الشذيِّ الخضِرْ",30,"ر",1,0],["لَطُفَ الجُمودُ لِذا وَذا فَتآلَفا","لَم يَلقَ ضِدٌّ ضدّهُ بِنِفارِ",31,"ر",1,0],["لطافُ الحشَا بِيض الخدودِ أوَانِسٌ","عِذابُ الثّنايا قَد مثلنَ بِنا مَثلا",32,"ل",2,1],["لطيفة في لعبها","خفيفة في وثبها",33,"ه",2,0],["لَطَفَ اللَهُ فَعوفينا مَعاً","وَاِرتَهَنّا لَكَ بِالشُكرِ لِسانا",34,"ن",2,0],["لَطَفَ اللَهُ بِباريسَ وَلا","لَقِيَت إِلّا نَعيماً وَسَلاما",35,"م",2,0],["لَطَّفتَ رَأيَكَ في بِرّي وَتَكرِمَتي","إِنَّ الكَريمَ عَلى العَلياءِ يَحتالُ",36,"ل",1,0],["لطف الرؤوف بها فأحرق ذنبها","عنها وصان بلطفه أجسامها",37,"م",3,0],["لطيفة الخصر وأردافها","وجيدها من خصرها أكبرُ",38,"ر",1,0],["لطُفَتْ مواعِظُه فلم يَشْعُرْ بها","إِلّا اللبيبُ وعِلْمُه لم ينفَعِ",39,"ع",1,0],["لُطفُ الرَبيعِ لَها يَصوغُ حُلِيِّها","بِغَرائِبٍ مِن لُؤلُؤٍ وَزَبَرجَدِ",40,"د",1,0],["لَطيفُ الحَواشي مُخطَفُ الخَصرِ أَهيَفٌ","بِفَترِ لِحاظٍ سالِبِ اللُبِّ وَالعَقلِ",41,"ل",1,0],["لَطيفٌ إِذا ما اِنسَلَّ أَدرَكَ ما اِبتَغى","إِذا هُوَ لِلطِنءِ المَخوفِ تَقَتَّرا",42,"ر",2,0],["لَطائِمُ المِسْكِ والكافورِ فائحةٌ","منه ومُنْتَخَبُ الهِنْديِّ والغارِ",43,"ر",1,0],["لطمَتْ خدّضها بحُمْرٍ لِطافٍ","نال منها عَذابَ بيضٍ عِذابِ",44,"ب",1,0],["لِطائِرِ كُلَّ حادِثَةٍ وُقوعُ","وَلِلدُنيا بِصاحِبِها وَلوعُ",45,"ع",1,1],["لطرفها وهو مصروف كموقعه","في القلب حين يروع القلب موقعُهُ",46,"ع",2,1],["لَطَمَحتَ في الإِبراقِ وَالإِرعادِ","وَغَدا عَلَيَّ بِسَيلِ لَومِكِ غادِ",47,"د",1,1],["لَطَيفِ أَحَبِّ خَلقِ اللَ","هِ إِنساناً وَإِن غَضِبا",48,"ب",2,0],["لِطافِ الأنامِل بيض البنان","تذيب الحديد وتفري الحجرْ",49,"ر",1,0],["لَطمتكِ من سَفهٍ وسُوءِ خَلِيقَةٍ","يَدُهُ وتلكَ جنايةٌ ما تُغْفَرُ",50,"ر",1,0],["لَطائِفُ آدابٍ فُكاهَةُ مَجلِسٍ","مَوائِدُ أَمثالٍ نَوادِرُ أَشعارِ",51,"ر",1,0],["لَطابَ نَفسُ أَميرِ المُؤمِنينَ وَلَم","يَدَع لِصَوتِ الهُدى الداعي تَوَرُّعُهُ",52,"ع",2,0],["لَطيفُ الحَوايا يَقسِمُ الزادَ بَينَهِ","سَواءٌ وَبَينَ الذِئبِ قَسمَ المَشارِكِ",53,"ك",1,0],["لِطَرفي مِنهُ ميعادٌ بِطَرفٍ","وَفي قَلبي بِلَحظَتِهِ كُلومُ",54,"م",1,0],["لِطَلعَتِهِ وَخزَةٌ في الحَشا","كَوَقعِ المَشارِطِ في المُحتَجِم",55,"م",1,0],["لِط بالخلائق أجمعي","ن ولو بشيطانٍ رجيم",56,"م",1,0],["لِطارِفِ حُبٍّ أَصابَ الفُؤاد","وَقَد يَمنَعُ الطارِفُ التالِدا",57,"د",2,0],["لَطالَ عَلَيَّ الوَقتُ وَالنَفسُ عُمرُها","كَأَقصَرِ ظِلٍّ في الزَمانِ الشَ