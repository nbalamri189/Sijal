ثغر ما زال في اماثرات","https://www.aldiwan.net/poem11002.html","عموديه"],[402,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[403,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[429,"يا من له الآداب تسمو نسبة","https://www.aldiwan.net/poem41001.html","الكامل"],[432,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[437,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[438,"جمرة من صدى صوتها","https://www.aldiwan.net/poem505.html",""],[441,"ألا فانظروني بعين الصفا","https://www.aldiwan.net/poem14312.html","المتقارب"],[453,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[458,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[458,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[463,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[463,"مساحب كف سيدنا الحسين","https://www.aldiwan.net/poem928.html",""],[464,"لله يوم إذا تبلح وجهه","https://www.aldiwan.net/poem3251.html","عموديه"],[482,"تبدت معاني الجمع حشو ردائها","https://www.aldiwan.net/poem24496.html","عموديه"],[499,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[529,"أقول من بعد حمد والصلاة على","https://www.aldiwan.net/poem37209.html","البسيط"],[538,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[551,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[551,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[551,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[558,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[562,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[575,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[586,"وألثغ زار لكن","https://www.aldiwan.net/poem17597.html","المجتث"]],"verses":[["وَأَلثَمَتنِيَ ثَغراً ما عَدَلتُ بِهِ","أَريَ الجَنى بِبَناتِ الوابِلِ الرُذُمِ",0,"م",1,0],["وَالثَرى مُنتَشٍ يُعاقِرُهُ السَي","رُ دَماً جارِياً بِأَيدي النِياقِ",1,"ق",1,0],["وَالثَّغرُ مِنها كَعِقدٍ وَهوَ مُنتَظِمٌ","والدَّمعُ مِنّي كَعِقدٍ غَيرِ مُنتَظِمِ",2,"م",1,0],["وَأُلْثِمُ نَحْرَ القِرْنِ كُلَّ مُثَقَّفٍ","بَصيرٍ إِذا أَشْرَعْتُهُ بِالْمَقاتِلِ",3,"ل",1,0],["والثّأْرُ لا تَغْفُلُ عنهُ خِنْدِفٌ","فكيْفَ أغْضَيْتَ على الطّوائِلِ",4,"ل",1,0],["وَأَلثِمُ أَرضاً أَنتِ فيها مُقيمَةٌ","لَعَلَّ لَهيبي مِن ثَرى الأَرضِ يَبرُدُ",5,"د",1,0],["وَالثَغرُ مِن تَحتِ اللِثامِ كَأَنَّهُ","بَرقٌ تَلَألَأَ في الظَلامِ المُسدَلِ",6,"ل",1,0],["وَأَلثِمُ كَفَّ كَريمِ الجُدودِ","غِياثِ العُفاةِ مُزيلِ الكُرَب",7,"ب",1,0],["والثريا تمد كفا خضيبا","أعجمت بالسماك نون الهلال",8,"ل",1,0],["والثريا ستعتلي في أمان","من عِداء العَيّوق والدَبَران",9,"ن",1,0],["والثِم به ثغر الطبيعة باسماً","يَشفي من المشتاق حَرَ غليله",10,"ل",2,0],["وَالثانِيَ الصادِقَ المَحمودَ مَشهَدُهُ","وَأَوَّلَ الناسِ مِنهُم صَدَّقَ الرُسُلا",11,"ل",2,0],["والثاقب الفكر في غرّاء ينصبها","لكل طالب نعمى نصبَ إغراء",12,"ا",2,0],["وألثم عطفيه وجفنيه بعد ما","قُتلت برمح منهما ومهند",13,"د",1,0],["وألثم يمناه وفكريَ ظامئٌ","كأنيَ منها ألثم الوابل الغمرا",14,"ر",2,0],["وألثم معسولاً نظيماً كأنما","تنظم من لفظ العلاء نثيرا",15,"ر",2,0],["والثغرَ منه الواضح المفلَّجا","والشَّعَر المحلَوْلك المدرَّجا",16,"ج",2,0],["والثناء الجميل فيك إذ صُي","يِرَ للسامعين طراً سماعا",17,"ع",2,0],["وَالثالِثُ شَيخٌ في طَمرِ","ذو جِسمٍ يَحكي العُرجونا",18,"ن",2,0],["وَالثَوبُ قَد ضاقَ عَن إِخفائِها فَنَبا","عَنها فَيا لَيتَني بُردٌ لِأَحميها",19,"ي",3,0],["والثلج يحكى في الهوى","نطاف قطن ترتمى",20,"م",2,0],["وَالثَباتُ الَّذي أَجادوا قَديماً","عَلَّمَ الثابِتَينِ ذا الإِجفالا",21,"ل",2,0],["وَالثَناءُ المُحَلُّ يَفنى وَما يُع","قَدُ بِالشِعرِ مُدَّةَ الدَهرِ باقِ",22,"ق",1,0],["والثَّنايا العِذابُ تَثني على الوجْ","دِ الحَشا أو تُضاعِفُ التَّعذيبا",23,"ب",2,0],["وَالثُرَيّا وَلَّت وَمالَت إِلى الغَر","بِ فَكانَت كَالطائِحِ المَنكوسِ",24,"س",1,0],["وَالثُرَيّا سَبعَةٌ قَد أَشبَهَت","شَكلَ لَحيانٍ بِتَختٍ نُقِشا",25,"ش",2,0],["والثابتُ الحلمِ إذا ما هَفَتْ","له من الحلم هضابُ الرّعان",26,"ن",1,0],["والثريّا رجحَ الجوُّ بها","كابنِ ماءٍ ضمَّ للوكرِ جناح",27,"ح",1,0],["والثغرُ بالطرفِ قدْ حماهُ","إذْ راقَ لمساً وطابَ ريقا",28,"ق",2,0],["والثغرُ بالطرفِ قدْ حماهُ","فراقَ طيباً وطابَ ريقا",29,"ق",2,0],["وألْثغٍ يتجرّا","ويصبغُ العرضَ صبغا",30,"غ",2,1],["وَاِلثُم يَدَ اِبنِ أَبي الخِصالِ عَنِ العُلى","مُتَشَكِّراً وَاِضمُمهُ ضَمَّ عِناقِ",31,"ق",1,0],["وَالثَّغرُ خَاتَمُ دُرّ جَلَّ صَائِغُهُ","مِن نُطفَةِ الحُسنِ لاَ مِن نُطفةِ البَشَرِ",32,"ر",1,0],["وَالثُرَيّا كَنَورِ غُص","نٍ عَلى الغَربِ قَد نُثِر",33,"ر",1,0],["وَالثَديُ تَحسَبَهُ وَسنانَ أَو كَسِلاً","وَقَد تَمايَلَ مَيلاً غَيرَ مُنكَسِرِ",34,"ر",1,1],["وَالثالِثُ المُهَلَّبُ الكَبيرُ","في بَيتِ أِشرافٍ بِهِ تَدورُ",35,"ر",1,0],["وَالثُرَيّا وَالشَمسُ وَالنارُ وَالنَث","رَةُ وَالأَرضُ وَالضُحى وَالسَماءُ",36,"م",3,0],["وَالثَوبُ في أَرضِكَ وَخشِها","يُغنيكَ عَن أَثوابِ تِنَّيسها",37,"س",3,0],["وَالثَرَيّا رَهينَةٌ بِافْتِراقِ الشْ","شَمْلِ حَتّى تُعَدّ في الأفرادِ",38,"د",1,0],["وألثم النَّوْرَ في سنابله","مصفقاً للنسيمِ جذلانا",39,"ن",2,0],["والثرى بين ربيعٍ وشتاء","ضاحكُ النَّوَّارِ وهَّاجُ الكرومْ",40,"م",1,0],["والثرى من نَفَسِ الرُّوحِ الحنونْ","مهجةٌ تهفو وقلبٌ يخفقُ",40,"ق",1,0],["والثرى مرسلا على قدميك","من تعاشيبه سحاب الماء",41,"ا",2,0],["والثأر بالأهل الكرام والوطن","قضيةٌ قد شغلتْ أهل الفطن",42,"ن",1,0],["وَالثَّغْرُ مَا زَالَ فِي المَأْ","ثُرَاتِ رَاجِحَ كِفَّهْ",43,"ف",2,0],["والثلج في بيتي..وفي أضلعي وفي قوافيّ..وفي اللمّتين","أبصرني الصيف هنا مرة أشك أن يبصرني مرتين",44,"ن",1,0],["والثواني تهمي صديدا وشوكا","وستهمي وليس تدري إلى ما ؟",45,"م",2,0],["والثُدِيَّيْنِ كلُّ رُمانة فرعاءَ","تَهزا بأُختِها الرُمّانه",46,"ن",2,0],["والثَّنَاءُ المُنْحَلُ يَفْنَى ،وما يُعْقَدُ","بالشعْرِ مُدَّةَ الدَّهْرِ باقِ",47,"ق",1,0],["والثم أحبّتي الصغار ورفّها","غررا نواعم كالورود صباحا",48,"ح",2,0],["وألثم في داج من الخطب ثغره","فأقطف منه كوكبا ثمّ كوكبا",49,"ب",2,0],["والثلج جنّ فلم تبن سبل ولم تعرف شعاب","أخفى المعالم لا السفوح هي السفوح ولا الهضاب",50,"ب",1,0],["وألثمُ فاها كي تزول صبابتي","فيشتد ما ألقي من الهيمان",51,"ن",1,0],["والثلج في بيتي..وفي أضلعي","وفي قوافيّ..وفي اللمّتين",52,"ن",1,0],["والثم من جبينك لوح نور","فاجلو الفجر من سجف الظلام",53,"م",1,0],["والثعلبان سطا وصار مبارزاً","وبقيد ضنك اثقل الريبال",54,"ل",1,0],["والثريا تود لو صيغ منها","عنب للرئيس بعد الغِذاءِ",55,"ا",2,0],["وَالثُرَيا كأَنَّها كَفُّ خَوْدٍ","داخَلَتْها لِلْبَيْنِ رِعْدَةُ وَجْدِ",56,"د",1,0],["وَالثَديُ وَالشِبرُ المَديدُ وَناجِذٌ","وَالباعُ وَالذقنُ الَّذي لا يُنكَرُ",57,"ر",1,0],["وَالثغر من فرحٍ به مبتسمُ","بِحياتهِ صلّوا عليه وسلّموا",58,"م",3,0],["وألثمُ ترباً حين مستهُ أَدمعي","بروح البكا صلى عليك وسلما",59,"م",2,0],["والثوبُ والإبرةُ في كفِّها","طرسٌ عليهِ كلُّ خطٍّ جميلْ",60,"ل",1,0],["والثرى كلُّهُ قلوبٌ ضعافٌ","خشيتْ صولةَ الهوى الجبارِ",61,"ر",1,0],["والثغر منها لنا اضحى مبرده","يروي حديث الصحاح الجوهريات",62,"ت",1,0],["والثَمْ حصى بُقْعَةٍ الوسطى وقبِّلهُ","وادمعْ عليه بِمُنْهَلّ ومُنْسكِبِ",63,"ب",1,0],["وَالثَعلبُ المحتالُ ما","بَطَلت له حيلٌ وَمكرُ",64,"ر",1,0],["وأَلْثَمُ مُحْمَرَّ الخدودِ بإذنِها","وأُلْوَى على اللَّبّات طَوْراً وأحُمل",65,"ل",1,0],["وَالثِم ثَرىً لَو شارَفَت بي هُضبَهُ","أَودي المَطِيِّ لَثَمتُهُ بِجُفوني",66,"ن",2,0],["وَالثَغرُ رَيّانُ لَدنُ العِطفِ قَد عَقَدَت","لَآلِئُ الطَلِّ مِن أَوراقِهِ شَنَفا",67,"ف",2,0],["وَالثَغرِ كَاللُؤلَؤِ النَظيمِ وَإِن","غادَرَ دَمعي كَاللُؤلُؤِ البَدَدِ",68,"د",1,0],["وَالثَغرِ أَعذَبَ مِن زُلا","لِ الماءِ لِلظامي وَأَبرَد",69,"د",1,0],["وَالثَنايا الغُرُّ يَبسِم","نَ وَميضاً وَسَناءا",70,"ا",3,0],["والثُم ثراها كلَّه عَنِّى فلى","قَلبٌ أقام بِحَزنِها وبسَهلِها",71,"ل",3,0],["والثنايا درٌّ بقاموس ثغرٍ","كنظام الصحاح للجوهريّ",72,"ي",1,0],["والثغرُ زهرُ الياسمينَ إذا","حيَّاهُ نورُ الصبحِ بالقَطر",73,"ر",1,0],["والثأرُ منكِ ومن بنيكِ ذمامةٌ","للجاهِدِ المَوتورِ من باغيك",74,"ك",1,0],["والثم يَمين امام ماجد علم","أَحيا الهدى وَالنَدى وَالفرض وَالسننا",75,"ن",2,0],["والثم تربة نفحت عَبيرا","وانظر قبة ملئت ضياء",76,"ا",2,0],["وأَلثُمُ مِنْ أَسطارِها كُل فَائِن","بِمَا يَجتَلِى مِن رَقمِها كل رامِقِ",77,"ق",1,0],["والثرَيا بجانِب البَدْرِ تحْكي","راحَةً أوْمَأَتْ لِتَلْطِمَ خَدا",78,"د",2,0],["والْثمْ أنامِلَ شَرّفتْ ما صرّفَتْ","صُحُفا تناذَرَها العِدى وصِفاحا",79,"ح",2,0],["وَالثَعلَبُ الرَوّاغُ لا","يَروعُ لَيثاً قَسوَرا",80,"ر",2,0],["وَالثُرَيّا كَأَنَّها كَفُّ خودٍ","خُتِّمَت ياقوتاً وَتِبراً وَدُرّا",81,"ر",2,0],["وَالثَعلَبِيَّةُ كُلُّها","وَالبَدوُ مِن عانٍ وَمُطلَق",82,"ق",1,0],["واِلثِم الأَرضَ لديه خاضِعاً","واِستلم أَعتابَه العُليا اِستِلاما",83,"م",2,0],["واِلثِم ثَرى ذَلِكَ الوادي وَحُطَّ بِهِ","عَن الرِحال تَنل يا سَعدُ ما شيتا",84,"ت",2,0],["والثاني التالي البر التقى حوى ال","إحسان والعدل يا للَه من عمر",85,"ر",1,0],["والثورى الحبر الشحيح بدينه","الخائف المتخشع المتضرع",86,"ع",1,0],["واِلثم أناملها فَهُنَّ جداولٌ","ما إن يردَّ عُبابها المُتمادي",87,"د",2,0],["وَأَلثِم خدّ الوردِ يُخضله النّدى","وَقد عمّ نقطُ الخال ديناره الذهبي",88,"ب",2,0],["وَالثُرَيّا يَجيدُها تَتَباهى","أَقبَلَت نَحوَنا وَلاحَ بَهاها",89,"ا",1,0],["والثكالى ذُقن من كفّ الردى","حمَمَ الثكل فأبكين الجبال",90,"ل",1,0],["وَالثَمَنَ البَخسَ الَّذي بيعَ بِهِ","وَلِم غَدا عَبداً وَلَم يَبرَحَ حُر",91,"ر",1,0],["وَالثَم ثَرى مَن لي بِأَن أَلثُمَهُ","نِيابَةً عَنِ الشِفاهِ بِالمُقَل",92,"ل",1,0],["وَالثَغر دُرّاً وَطَرفك الوَسَنا","فَتِه دَلالاً أَهِم بِهِ شَجَنا",93,"ن",2,0],["وَألثُمُ تُربَ نَعلَيه فأَقضِي","بِلَثمِ تُرَابِهَا بَعضَ الذِّمَامِ",94,"م",1,0],["وأَلثِمُ أيدي العِيسِ في كلِّ منزلٍ","فهُنّ إذا زُرْنَ الحبيبَ حبائ