.html","الكامل"],[429,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[434,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[435,"جمرة من صدى صوتها","https://www.aldiwan.net/poem505.html",""],[438,"ألا فانظروني بعين الصفا","https://www.aldiwan.net/poem14312.html","المتقارب"],[451,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[461,"مساحب كف سيدنا الحسين","https://www.aldiwan.net/poem928.html",""],[462,"لله يوم إذا تبلح وجهه","https://www.aldiwan.net/poem3251.html","عموديه"],[480,"تبدت معاني الجمع حشو ردائها","https://www.aldiwan.net/poem24496.html","عموديه"],[497,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[512,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[512,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[512,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[527,"أقول من بعد حمد والصلاة على","https://www.aldiwan.net/poem37209.html","البسيط"],[536,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[549,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[549,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[549,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[549,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[556,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[560,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[573,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[584,"وألثغ زار لكن","https://www.aldiwan.net/poem17597.html","المجتث"]],"verses":[["وَأَلثَمَتنِيَ ثَغراً ما عَدَلتُ بِهِ","أَريَ الجَنى بِبَناتِ الوابِلِ الرُذُمِ",0,"م",1,0],["وَالثَرى مُنتَشٍ يُعاقِرُهُ السَي","رُ دَماً جارِياً بِأَيدي النِياقِ",1,"ق",1,0],["وَالثَّغرُ مِنها كَعِقدٍ وَهوَ مُنتَظِمٌ","والدَّمعُ مِنّي كَعِقدٍ غَيرِ مُنتَظِمِ",2,"م",1,0],["وَأُلْثِمُ نَحْرَ القِرْنِ كُلَّ مُثَقَّفٍ","بَصيرٍ إِذا أَشْرَعْتُهُ بِالْمَقاتِلِ",3,"ل",1,0],["والثّأْرُ لا تَغْفُلُ عنهُ خِنْدِفٌ","فكيْفَ أغْضَيْتَ على الطّوائِلِ",4,"ل",1,0],["وَأَلثِمُ أَرضاً أَنتِ فيها مُقيمَةٌ","لَعَلَّ لَهيبي مِن ثَرى الأَرضِ يَبرُدُ",5,"د",1,0],["وَالثَغرُ مِن تَحتِ اللِثامِ كَأَنَّهُ","بَرقٌ تَلَألَأَ في الظَلامِ المُسدَلِ",6,"ل",1,0],["وَأَلثِمُ كَفَّ كَريمِ الجُدودِ","غِياثِ العُفاةِ مُزيلِ الكُرَب",7,"ب",1,0],["والثريا تمد كفا خضيبا","أعجمت بالسماك نون الهلال",8,"ل",1,0],["والثريا ستعتلي في أمان","من عِداء العَيّوق والدَبَران",9,"ن",1,0],["والثِم به ثغر الطبيعة باسماً","يَشفي من المشتاق حَرَ غليله",10,"ل",2,0],["وَالثانِيَ الصادِقَ المَحمودَ مَشهَدُهُ","وَأَوَّلَ الناسِ مِنهُم صَدَّقَ الرُسُلا",11,"ل",2,0],["والثاقب الفكر في غرّاء ينصبها","لكل طالب نعمى نصبَ إغراء",12,"ا",2,0],["وألثم عطفيه وجفنيه بعد ما","قُتلت برمح منهما ومهند",13,"د",1,0],["وألثم يمناه وفكريَ ظامئٌ","كأنيَ منها ألثم الوابل الغمرا",14,"ر",2,0],["وألثم معسولاً نظيماً كأنما","تنظم من لفظ العلاء نثيرا",15,"ر",2,0],["والثغرَ منه الواضح المفلَّجا","والشَّعَر المحلَوْلك المدرَّجا",16,"ج",2,0],["والثناء الجميل فيك إذ صُي","يِرَ للسامعين طراً سماعا",17,"ع",2,0],["وَالثالِثُ شَيخٌ في طَمرِ","ذو جِسمٍ يَحكي العُرجونا",18,"ن",2,0],["وَالثَوبُ قَد ضاقَ عَن إِخفائِها فَنَبا","عَنها فَيا لَيتَني بُردٌ لِأَحميها",19,"ي",3,0],["والثلج يحكى في الهوى","نطاف قطن ترتمى",20,"م",2,0],["وَالثَباتُ الَّذي أَجادوا قَديماً","عَلَّمَ الثابِتَينِ ذا الإِجفالا",21,"ل",2,0],["وَالثَناءُ المُحَلُّ يَفنى وَما يُع","قَدُ بِالشِعرِ مُدَّةَ الدَهرِ باقِ",22,"ق",1,0],["والثَّنايا العِذابُ تَثني على الوجْ","دِ الحَشا أو تُضاعِفُ التَّعذيبا",23,"ب",2,0],["وَالثُرَيّا وَلَّت وَمالَت إِلى الغَر","بِ فَكانَت كَالطائِحِ المَنكوسِ",24,"س",1,0],["وَالثُرَيّا سَبعَةٌ قَد أَشبَهَت","شَكلَ لَحيانٍ بِتَختٍ نُقِشا",25,"ش",2,0],["والثابتُ الحلمِ إذا ما هَفَتْ","له من الحلم هضابُ الرّعان",26,"ن",1,0],["والثريّا رجحَ الجوُّ بها","كابنِ ماءٍ ضمَّ للوكرِ جناح",27,"ح",1,0],["والثغرُ بالطرفِ قدْ حماهُ","إذْ راقَ لمساً وطابَ ريقا",28,"ق",2,0],["والثغرُ بالطرفِ قدْ حماهُ","فراقَ طيباً وطابَ ريقا",29,"ق",2,0],["وألْثغٍ يتجرّا","ويصبغُ العرضَ صبغا",30,"غ",2,1],["وَاِلثُم يَدَ اِبنِ أَبي الخِصالِ عَنِ العُلى","مُتَشَكِّراً وَاِضمُمهُ ضَمَّ عِناقِ",31,"ق",1,0],["وَالثَّغرُ خَاتَمُ دُرّ جَلَّ صَائِغُهُ","مِن نُطفَةِ الحُسنِ لاَ مِن نُطفةِ البَشَرِ",32,"ر",1,0],["وَالثُرَيّا كَنَورِ غُص","نٍ عَلى الغَربِ قَد نُثِر",33,"ر",1,0],["وَالثَديُ تَحسَبَهُ وَسنانَ أَو كَسِلاً","وَقَد تَمايَلَ مَيلاً غَيرَ مُنكَسِرِ",34,"ر",1,1],["وَالثالِثُ المُهَلَّبُ الكَبيرُ","في بَيتِ أِشرافٍ بِهِ تَدورُ",35,"ر",1,0],["وَالثُرَيّا وَالشَمسُ وَالنارُ وَالنَث","رَةُ وَالأَرضُ وَالضُحى وَالسَماءُ",36,"م",3,0],["وَالثَوبُ في أَرضِكَ وَخشِها","يُغنيكَ عَن أَثوابِ تِنَّيسها",37,"س",3,0],["وَالثَرَيّا رَهينَةٌ بِافْتِراقِ الشْ","شَمْلِ حَتّى تُعَدّ في الأفرادِ",38,"د",1,0],["وألثم النَّوْرَ في سنابله","مصفقاً للنسيمِ جذلانا",39,"ن",2,0],["والثرى بين ربيعٍ وشتاء","ضاحكُ النَّوَّارِ وهَّاجُ الكرومْ",40,"م",1,0],["والثرى من نَفَسِ الرُّوحِ الحنونْ","مهجةٌ تهفو وقلبٌ يخفقُ",40,"ق",1,0],["والثرى مرسلا على قدميك","من تعاشيبه سحاب الماء",41,"ا",2,0],["والثأر بالأهل الكرام والوطن","قضيةٌ قد شغلتْ أهل الفطن",42,"ن",1,0],["وَالثَّغْرُ مَا زَالَ فِي المَأْ","ثُرَاتِ رَاجِحَ كِفَّهْ",43,"ف",2,0],["والثلج في بيتي..وفي أضلعي وفي قوافيّ..وفي اللمّتين","أبصرني الصيف هنا مرة أشك أن يبصرني مرتين",44,"ن",1,0],["والثواني تهمي صديدا وشوكا","وستهمي وليس تدري إلى ما ؟",45,"م",2,0],["والثُدِيَّيْنِ كلُّ رُمانة فرعاءَ","تَهزا بأُختِها الرُمّانه",46,"ن",2,0],["والثَّنَاءُ المُنْحَلُ يَفْنَى ،وما يُعْقَدُ","بالشعْرِ مُدَّةَ الدَّهْرِ باقِ",47,"ق",1,0],["وألثمُ فاها كي تزول صبابتي","فيشتد ما ألقي من الهيمان",48,"ن",1,0],["والثم من جبينك لوح نور","فاجلو الفجر من سجف الظلام",49,"م",1,0],["والثعلبان سطا وصار مبارزاً","وبقيد ضنك اثقل الريبال",50,"ل",1,0],["والثريا تود لو صيغ منها","عنب للرئيس بعد الغِذاءِ",51,"ا",2,0],["وَالثُرَيا كأَنَّها كَفُّ خَوْدٍ","داخَلَتْها لِلْبَيْنِ رِعْدَةُ وَجْدِ",52,"د",1,0],["وَالثَديُ وَالشِبرُ المَديدُ وَناجِذٌ","وَالباعُ وَالذقنُ الَّذي لا يُنكَرُ",53,"ر",1,0],["وَالثغر من فرحٍ به مبتسمُ","بِحياتهِ صلّوا عليه وسلّموا",54,"م",3,0],["وألثمُ ترباً حين مستهُ أَدمعي","بروح البكا صلى عليك وسلما",55,"م",2,0],["والثوبُ والإبرةُ في كفِّها","طرسٌ عليهِ كلُّ خطٍّ جميلْ",56,"ل",1,0],["والثرى كلُّهُ قلوبٌ ضعافٌ","خشيتْ صولةَ الهوى الجبارِ",57,"ر",1,0],["والثغر منها لنا اضحى مبرده","يروي حديث الصحاح الجوهريات",58,"ت",1,0],["والثَمْ حصى بُقْعَةٍ الوسطى وقبِّلهُ","وادمعْ عليه بِمُنْهَلّ ومُنْسكِبِ",59,"ب",1,0],["وَالثَعلبُ المحتالُ ما","بَطَلت له حيلٌ وَمكرُ",60,"ر",1,0],["وأَلْثَمُ مُحْمَرَّ الخدودِ بإذنِها","وأُلْوَى على اللَّبّات طَوْراً وأحُمل",61,"ل",1,0],["وَالثِم ثَرىً لَو شارَفَت بي هُضبَهُ","أَودي المَطِيِّ لَثَمتُهُ بِجُفوني",62,"ن",2,0],["وَالثَغرُ رَيّانُ لَدنُ العِطفِ قَد عَقَدَت","لَآلِئُ الطَلِّ مِن أَوراقِهِ شَنَفا",63,"ف",2,0],["وَالثَغرِ كَاللُؤلَؤِ النَظيمِ وَإِن","غادَرَ دَمعي كَاللُؤلُؤِ البَدَدِ",64,"د",1,0],["وَالثَغرِ أَعذَبَ مِن زُلا","لِ الماءِ لِلظامي وَأَبرَد",65,"د",1,0],["وَالثَنايا الغُرُّ يَبسِم","نَ وَميضاً وَسَناءا",66,"ا",3,0],["والثُم ثراها كلَّه عَنِّى فلى","قَلبٌ أقام بِحَزنِها وبسَهلِها",67,"ل",3,0],["والثنايا درٌّ بقاموس ثغرٍ","كنظام الصحاح للجوهريّ",68,"ي",1,0],["والثغرُ زهرُ الياسمينَ إذا","حيَّاهُ نورُ الصبحِ بالقَطر",69,"ر",1,0],["والثأرُ منكِ ومن بنيكِ ذمامةٌ","للجاهِدِ المَوتورِ من باغيك",70,"ك",1,0],["والثم يَمين امام ماجد علم","أَحيا الهدى وَالنَدى وَالفرض وَالسننا",71,"ن",2,0],["والثم تربة نفحت عَبيرا","وانظر قبة ملئت ضياء",72,"ا",2,0],["وأَلثُمُ مِنْ أَسطارِها كُل فَائِن","بِمَا يَجتَلِى مِن رَقمِها كل رامِقِ",73,"ق",1,0],["والثرَيا بجانِب البَدْرِ تحْكي","راحَةً أوْمَأَتْ لِتَلْطِمَ خَدا",74,"د",2,0],["والْثمْ أنامِلَ شَرّفتْ ما صرّفَتْ","صُحُفا تناذَرَها العِدى وصِفاحا",75,"ح",2,0],["وَالثَعلَبُ الرَوّاغُ لا","يَروعُ لَيثاً قَسوَرا",76,"ر",2,0],["وَالثُرَيّا كَأَنَّها كَفُّ خودٍ","خُتِّمَت ياقوتاً وَتِبراً وَدُرّا",77,"ر",2,0],["وَالثَعلَبِيَّةُ كُلُّها","وَالبَدوُ مِن عانٍ وَمُطلَق",78,"ق",1,0],["واِلثِم الأَرضَ لديه خاضِعاً","واِستلم أَعتابَه العُليا اِستِلاما",79,"م",2,0],["واِلثِم ثَرى ذَلِكَ الوادي وَحُطَّ بِهِ","عَن الرِحال تَنل يا سَعدُ ما شيتا",80,"ت",2,0],["والثاني التالي البر التقى حوى ال","إحسان والعدل يا للَه من عمر",81,"ر",1,0],["والثورى الحبر الشحيح بدينه","الخائف المتخشع المتضرع",82,"ع",1,0],["واِلثم أناملها فَهُنَّ جداولٌ","ما إن يردَّ عُبابها المُتمادي",83,"د",2,0],["وَأَلثِم خدّ الوردِ يُخضله النّدى","وَقد عمّ نقطُ الخال ديناره الذهبي",84,"ب",2,0],["وَالثُرَيّا يَجيدُها تَتَباهى","أَقبَلَت نَحوَنا وَلاحَ بَهاها",85,"ا",1,0],["والثكالى ذُقن من كفّ الردى","حمَمَ الثكل فأبكين الجبال",86,"ل",1,0],["وَالثَمَنَ البَخسَ الَّذي بيعَ بِهِ","وَلِم غَدا عَبداً وَلَم يَبرَحَ حُر",87,"ر",1,0],["وَالثَم ثَرى مَن لي بِأَن أَلثُمَهُ","نِيابَةً عَنِ الشِفاهِ بِالمُقَل",88,"ل",1,0],["وَالثَغر دُرّاً وَطَرفك الوَسَنا","فَتِه دَلالاً أَهِم بِهِ شَجَنا",89,"ن",2,0],["وَألثُمُ تُربَ نَعلَيه فأَقضِي","بِلَثمِ تُرَابِهَا بَعضَ الذِّمَامِ",90,"م",1,0],["وأَلثِمُ أيدي العِيسِ في كلِّ منزلٍ","فهُنّ إذا زُرْنَ الحبيبَ حبائب",91,"ب",1,0],["والثُريَّا خفَّاقة بجناح ال","غَربِ تَهوي كأنَّها رأسُ فَهدِ",92,"د",1,0],["والثانية ضعف اليقين في الدين","فإن هذى بغية الشياطين",93,"ن",1,0],["والثالثة طول الأمل ونسيان","الموت ذي يسقاه كل إنسان",93,"ن",1,0],["والثغر ما زال في اماثرات","راجح كفه",94,"ف",2,1],["والثّابت الجأش في حُمر الهياج فما","يلقاهُ ذو البأسِ إلاّ وهو في الكفنِ",95,"ن",1,0],["والثالث العجمي كبِشْرامٍ وَمَنْ","للعجل والشمس المنيرة عابد",96,"د",1,0],["والثم من الشهم البشير المرتضى","كفا نديا فاض فيض السحب",97,"ب",1,0],["والثِمْ بَنانَ يمينِه","وقلِ السلامُ عليك بَحْرا",98,"ر",2,0],["والثغر منها الثغر لا يقصدهُ","مقبّل إلا حمي بالردّ",99,"د",1,0],["والثنايا تموسقُ الصوتَ عذب","يتثنّى بخطوهِ فرحانا",100,"ن",2,0],["وألثم خدي بذاك التراب","وأنشد مدحي في المصطفى",101,"ف",2,0],["والثم ثرى مصر عنّي راكعا شغفا","وخذ فؤادي عني بعض قرباني",102,"ي",1,0],["والثائر العادي على أعدائه","ينقاد قَود العاجز المتزمِّلِ",103,"ل",1,0],["والثريا في مآخير الدجى","هامةٌ شمطاءُ غَلَّتْ مُشُطا",104,"ط",2,0],["والثرى أخضر لا يلبسه","جِلدةَ الشهباءِ عامٌ قُحِطا",104,"ط",2,0],["وآل ثم اصحاب على سائر","العلماء والصلحاء أنيفوا",105,"ف",3,0],["وآل ثم اصحاب كرام","عدد متحركات الخافقين",106,"ن",1,0],["والثلج يسقط دائباً كافوره","والأرض يكفر مسكها والعنبر",107,"ر",1,0],["وألثم أحجار الفيافي لأنها","شبيهة من أهوى ووصلها جورها",108,"ر",3,0],["والثَّوبُ يَخْلَقُ ثُمَّ يُشَرَى غَيْرُهُ","ويَصُونُ حُلَّتَهُ يُوَقِّيْهَا الأَذَى",109,"ا",1,0],["واِلثِم عَقيقةَ مِرشَفَيْها راشِفاً","منها ثَنايا اللؤلُؤِ المَكنونِ",110,"ن",1,0],["والثابتَ المِغوارَ والقِرْنَ الّذي","لا تستقرّ سُيوفُه بجُفونِ",110,"ن",1,0],["والثّابتَ الرأي المُسدَّدِ حيثُ لا","أسَدٌ يقرُّ ولا جَوادٌ يُكبَحُ",111,"ح",1,0],["واِلثِمْ حَشاهُ مفتّشاً في تُربِه","فهناك ضيّعتِ الحِسانُ عُهودي",112,"د",2,0],["والثَّبْتُ إنْ جاءَنا يَوْماً بفائِدَةٍ","في أيِّ فَنٍّ بِقَوْلٍ مِنْهُ مَجْزومِ",113,"م",1,0],["والثَّنَا مِنَّا يُشَاد","ودُعَانا في ازدِياد",114,"د",1,0],["وألثِمُ الصُّدغَ الّذي","عَقْرَبَهُ وزَرفَنَهْ",115,"ن",2,0],["والثَّغْرَ خافوه فقد أخذ الرّدى","مَن كان للثَّغرِ المخوفِ كِعاما",116,"م",2,0],["والثَّلْمُ ليس يَكون إِلّا في ظُبا ال","ماضى ويخلو منه وهْوَ كَهامُ",117,"م",1,0],["والثّوابُ الّذي يضيق بقومٍ","هو من أجلهمْ عليك فسيحُ",118,"ح",1,0],["والثنا رحمة تخص بلطف","مَن إليهم بالمؤمنين يشار",119,"ر",1,0],["والثاقِبُ الفِكرِ لو كانت إنارتُهُ","في البدرِ ما مَسَّهُ نَقصٌ ولا خُسِفَا",120,"ف",2,0],["والثَّغرُ قَد أَفْحمنِي نَظْمُه","يَا حَسَدَ المفحَمِ للشَّاعِر",121,"ر",1,0],["والثَّنايَا نُقْلَى وقد كادَ يُفْنَى","ماءُ أَطرافِها بلَثْمي وشُربي",122,"ي",1,0],["وَأَلْثَغَ زَارَ لَكِنْ","رَأَى رَقيبيَ أَصْغَى",123,"غ",2,1]]}