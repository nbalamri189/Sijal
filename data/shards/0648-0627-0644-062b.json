{"poems":[[53,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem29822.html","البسيط"],[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[63,"ولوعة بت أخفيها وأظهرها","https://www.aldiwan.net/poem45795.html","البسيط"],[63,"سقى الله رملي كوفن الغيث حافلا","https://www.aldiwan.net/poem45913.html","الطويل"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[3,"إِذا كان دمعي شاهدي كيف أجحَدُ","https://www.aldiwan.net/poem155.html",""],[3,"حكم سيوفك في رقاب العذل","https://www.aldiwan.net/poem192.html","الكامل"],[86,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[82,"عللاني بذكر تلك الليالي","https://www.aldiwan.net/poem29397.html","الخفيف"],[88,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[88,"إن العراق بعرضه وبطوله","https://www.aldiwan.net/poem44817.html","الكامل"],[23,"إذا تذكرت شجوا من أخي ثقة","https://www.aldiwan.net/poem21264.html","البسيط"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[72,"تعشقتها في الحلي غصناء منثورا","https://www.aldiwan.net/poem18770.html","الطويل"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[51,"يا أبا الصقر زادك الله في المجد","https://www.aldiwan.net/poem65411.html","الخفيف"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"حاطك الله يا أبا أسحاق","https://www.aldiwan.net/poem65202.html","الخفيف"],[61,"هذه الشمس أوشكت أن تغيبا","https://www.aldiwan.net/poem51805.html","الخفيف"],[66,"أوضحت نار خده للمجوس","https://www.aldiwan.net/poem39917.html","الخفيف"],[66,"كرر اللوم عليه إن تشا","https://www.aldiwan.net/poem40645.html","الرمل"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[69,"قد ألقت النار وجنتاه","https://www.aldiwan.net/poem28251.html","مخلع البسيط"],[69,"قد ألقت النار وجنتاه","https://www.aldiwan.net/poem29019.html","مخلع البسيط"],[69,"وألثغ يتجرا","https://www.aldiwan.net/poem29142.html","المجتث"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[81,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[52,"من معيني على السهر","https://www.aldiwan.net/poem27000.html","مجزوء الخفيف"],[50,"والثدي تحسبه وسنان أو كسلا","https://www.aldiwan.net/poem62367.html","الوافر"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[46,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[46,"ارتاحت النفس بتطهيرها","https://www.aldiwan.net/poem22848.html","السريع"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39560","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202537","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[104,"الصيف وأنا","https://www.poetsgate.com/ViewPoem.aspx?id=16827",""],[100,"كاهن الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=50426",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"حاطَكَ اللهُ يا أَبا إِسحَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32172",""],[51,"أعانقها والنفسُ بعدُ مشوقة","https://www.poetsgate.com/ViewPoem.aspx?id=30590",""]],"verses":[["وَأَلثَمَتنِيَ ثَغراً ما عَدَلتُ بِهِ","أَريَ الجَنى بِبَناتِ الوابِلِ الرُذُمِ",0,"م",1,0],["وَالثَرى مُنتَشٍ يُعاقِرُهُ السَي","رُ دَماً جارِياً بِأَيدي النِياقِ",1,"ق",1,0],["وَالثَّغرُ مِنها كَعِقدٍ وَهوَ مُنتَظِمٌ","والدَّمعُ مِنّي كَعِقدٍ غَيرِ مُنتَظِمِ",2,"م",1,0],["وَأُلْثِمُ نَحْرَ القِرْنِ كُلَّ مُثَقَّفٍ","بَصيرٍ إِذا أَشْرَعْتُهُ بِالْمَقاتِلِ",3,"ل",1,0],["والثّأْرُ لا تَغْفُلُ عنهُ خِنْدِفٌ","فكيْفَ أغْضَيْتَ على الطّوائِلِ",4,"ل",1,0],["وَأَلثِمُ أَرضاً أَنتِ فيها مُقيمَةٌ","لَعَلَّ لَهيبي مِن ثَرى الأَرضِ يَبرُدُ",5,"د",1,0],["وَالثَغرُ مِن تَحتِ اللِثامِ كَأَنَّهُ","بَرقٌ تَلَألَأَ في الظَلامِ المُسدَلِ",6,"ل",1,0],["وَأَلثِمُ كَفَّ كَريمِ الجُدودِ","غِياثِ العُفاةِ مُزيلِ الكُرَب",7,"ب",1,0],["والثريا تمد كفا خضيبا","أعجمت بالسماك نون الهلال",8,"ل",1,0],["والثريا ستعتلي في أمان","من عِداء العَيّوق والدَبَران",9,"ن",1,0],["والثِم به ثغر الطبيعة باسماً","يَشفي من المشتاق حَرَ غليله",10,"ل",2,0],["وَالثانِيَ الصادِقَ المَحمودَ مَشهَدُهُ","وَأَوَّلَ الناسِ مِنهُم صَدَّقَ الرُسُلا",11,"ل",2,0],["والثاقب الفكر في غرّاء ينصبها","لكل طالب نعمى نصبَ إغراء",12,"ا",2,0],["وألثم عطفيه وجفنيه بعد ما","قُتلت برمح منهما ومهند",13,"د",1,0],["وألثم يمناه وفكريَ ظامئٌ","كأنيَ منها ألثم الوابل الغمرا",14,"ر",2,0],["وألثم معسولاً نظيماً كأنما","تنظم من لفظ العلاء نثيرا",15,"ر",2,0],["والثغرَ منه الواضح المفلَّجا","والشَّعَر المحلَوْلك المدرَّجا",16,"ج",2,0],["والثناء الجميل فيك إذ صُي","يِرَ للسامعين طراً سماعا",17,"ع",2,0],["وَالثالِثُ شَيخٌ في طَمرِ","ذو جِسمٍ يَحكي العُرجونا",18,"ن",2,0],["وَالثَوبُ قَد ضاقَ عَن إِخفائِها فَنَبا","عَنها فَيا لَيتَني بُردٌ لِأَحميها",19,"ي",3,0],["والثلج يحكى في الهوى","نطاف قطن ترتمى",20,"م",2,0],["وَالثَباتُ الَّذي أَجادوا قَديماً","عَلَّمَ الثابِتَينِ ذا الإِجفالا",21,"ل",2,0],["وَالثَناءُ المُحَلُّ يَفنى وَما يُع","قَدُ بِالشِعرِ مُدَّةَ الدَهرِ باقِ",22,"ق",1,0],["والثَّنايا العِذابُ تَثني على الوجْ","دِ الحَشا أو تُضاعِفُ التَّعذيبا",23,"ب",2,0],["وَالثُرَيّا وَلَّت وَمالَت إِلى الغَر","بِ فَكانَت كَالطائِحِ المَنكوسِ",24,"س",1,0],["وَالثُرَيّا سَبعَةٌ قَد أَشبَهَت","شَكلَ لَحيانٍ بِتَختٍ نُقِشا",25,"ش",2,0],["والثابتُ الحلمِ إذا ما هَفَتْ","له من الحلم هضابُ الرّعان",26,"ن",1,0],["والثريّا رجحَ الجوُّ بها","كابنِ ماءٍ ضمَّ للوكرِ جناح",27,"ح",1,0],["والثغرُ بالطرفِ قدْ حماهُ","إذْ راقَ لمساً وطابَ ريقا",28,"ق",2,0],["والثغرُ بالطرفِ قدْ حماهُ","فراقَ طيباً وطابَ ريقا",29,"ق",2,0],["وألْثغٍ يتجرّا","ويصبغُ العرضَ صبغا",30,"غ",2,1],["وَاِلثُم يَدَ اِبنِ أَبي الخِصالِ عَنِ العُلى","مُتَشَكِّراً وَاِضمُمهُ ضَمَّ عِناقِ",31,"ق",1,0],["وَالثَّغرُ خَاتَمُ دُرّ جَلَّ صَائِغُهُ","مِن نُطفَةِ الحُسنِ لاَ مِن نُطفةِ البَشَرِ",32,"ر",1,0],["وَالثُرَيّا كَنَورِ غُص","نٍ عَلى الغَربِ قَد نُثِر",33,"ر",1,0],["وَالثَديُ تَحسَبَهُ وَسنانَ أَو كَسِلاً","وَقَد تَمايَلَ مَيلاً غَيرَ مُنكَسِرِ",34,"ر",1,1],["وَالثالِثُ المُهَلَّبُ الكَبيرُ","في بَيتِ أِشرافٍ بِهِ تَدورُ",35,"ر",1,0],["وَالثُرَيّا وَالشَمسُ وَالنارُ وَالنَث","رَةُ وَالأَرضُ وَالضُحى وَالسَماءُ",36,"م",3,0],["وَالثَوبُ في أَرضِكَ وَخشِها","يُغنيكَ عَن أَثوابِ تِنَّيسها",37,"س",3,0],["وَالثَرَيّا رَهينَةٌ بِافْتِراقِ الشْ","شَمْلِ حَتّى تُعَدّ في الأفرادِ",38,"د",1,0],["وألثم النَّوْرَ في سنابله","مصفقاً للنسيمِ جذلانا",39,"ن",2,0],["والثرى بين ربيعٍ وشتاء","ضاحكُ النَّوَّارِ وهَّاجُ الكرومْ",40,"م",1,0],["والثرى من نَفَسِ الرُّوحِ الحنونْ","مهجةٌ تهفو وقلبٌ يخفقُ",40,"ق",1,0],["والثرى مرسلا على قدميك","من تعاشيبه سحاب الماء",41,"ا",2,0],["والثأر بالأهل الكرام والوطن","قضيةٌ قد شغلتْ أهل الفطن",42,"ن",1,0],["وَالثَّغْرُ مَا زَالَ فِي المَأْ","ثُرَاتِ رَاجِحَ كِفَّهْ",43,"ف",2,0],["والثلج في بيتي..وفي أضلعي وفي قوافيّ..وفي اللمّتين","أبصرني الصيف هنا مرة أشك أن يبصرني مرتين",44,"ن",1,0],["والثواني تهمي صديدا وشوكا","وستهمي وليس تدري إلى ما ؟",45,"م",2,0],["والثُدِيَّيْنِ كلُّ رُمانة فرعاءَ","تَهزا بأُختِها الرُمّانه",46,"ن",2,0],["والثَّنَاءُ المُنْحَلُ يَفْنَى ،وما يُعْقَدُ","بالشعْرِ مُدَّةَ الدَّهْرِ باقِ",47,"ق",1,0],["وألثمُ فاها كي تزول صبابتي","فيشتد ما ألقي من الهيمان",48,"ن",1,0]]}