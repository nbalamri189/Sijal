{"poems":[[49,"إذا كان فضلي لا أسوغ نفعه","https://www.aldiwan.net/poem25167.html","الطويل"],[72,"أيا من راح عن حالي","https://www.aldiwan.net/poem43007.html","مجزوء الوافر"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[147,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[190,"أقول لمن أراد الحزم يوما","https://www.aldiwan.net/poem43549.html","الوافر"],[398,"أرى سنتي قد ضمنت بعجائب","https://www.aldiwan.net/poem53621.html","الطويل"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138386",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138229",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83339","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54129","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62673","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120018","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59115","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46514","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79422","الوافر"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102272","الوافر"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105297","الهزج"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107010","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133261","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120188","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83182","البسيط"],[4927,"طيب عيد العراق","https://www.poetsgate.com/ViewPoem.aspx?id=12982",""],[5135,"تتابعت الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206411",""],[5277,"بيني وبينها","https://www.poetsgate.com/ViewPoem.aspx?id=186896",""],[6023,"بأبواب الكرام كرام وضعت رحلي","https://www.poetsgate.com/ViewPoem.aspx?id=123908",""]],"verses":[["وَمِن أَضيَغَ الأَشياءِ مُهجَةُ عاقِلٍ","يَجوزُ عَلى حَوبائِها حُكمُ جاهِلِ",0,"ل",1,0],["وَمَن أَضحى أَخاً لي في ال","وِدادِ وَفي الحُنُوِّ أَبا",1,"ب",2,0],["وَمُناضِلٍ عَثَرَت بِهِ أَحسابُهُ","في مَسلَكٍ وَعِرٍ مِنَ الأَجدادِ",2,"د",1,0],["وَمَن أَضحى بِمُلكِكَ مُستَجيراً","فَما يُلفى لِخَطبٍ مُستَكينا",3,"ن",2,0],["ومن أضحى يعلّمُ في الضواحي","فينسب في الكلاب إلى سلوق",4,"ق",1,0],["وَمَن أَضمَرَ اللَهُمَّ سوءاً لِمُهجَتي","فَرُدَّ عَلَيهِ الكَيدَ أَخيبَ خائِبِ",5,"ب",1,0],["ومَن أضحى إلى سلمان يُعزى","وخِدْمَتِه فمحمول السلام",6,"م",1,0],["ومن اضحى نظمه فاق اللآلي","يليق بمن سما خلقا وحلما",7,"م",2,0],["ومن أضحت مواهبه كبحر","كبير قد طما فوق الحدود",8,"د",1,0],["وَمَن أَضحى لِأَمرٍ غَيرَ كُفؤٍ","فَأَليَقُ ما يَليقُ بِهِ اِجتِنابُ",9,"ب",1,0],["ومن أضحت له ذات تنادي","بحسن البشر حي على الفلاح",10,"ح",1,0],["ومن أضحك الدنيا سروراً حضورُه","فلا غَرْوَ إن أبكى السَّماواتِ غائبُهْ",11,"ب",2,0],["ومناضل عنها بسه","م في النوائب غير أفوق",12,"ق",1,0],["وَمَنْ أضْنَأتْهُ صُورَةٌ قَمَرِيَّةٌ","وَقَدْ كَتَمَ الأشْوَاقَ بَاحَ ضَنَاؤُهُ",13,"ا",3,0],["وَمن أَضاع جُندَه في السلم","لَم يَحفَظوه في لِقاء الخَصم",14,"م",1,0],["ومن أضيافِهِ الأشرافِ منهُمْ","سليمانُ بنُ منصورِ بنِ نوحِ",15,"ح",1,0],["ومن أضحى بناظره فتور","فما يزكو لعارضه نبات",16,"ت",1,0],["ومن أضيع ما ضيعت","في سر وفي جهر",17,"ر",1,0],["ومن أضاء السعد في ميلاده","الميمون يجلو بسناه الغسقا",18,"ق",2,0],["ومن اضاع صلاة اوزنا وكذا","شهود زور فدعهم مع قضاتهم",19,"م",1,0],["وَمِن إضَافَةٍ لتَالِيهَا وَمَا","لَم يَخلُ فَهوَ بِالجَوازِ وُسِمَا",20,"م",2,0],["ومَن أضاء الدياخى نورُ غُرّتهِ","فانشقّ صبحُ الهُدى في الحلّ والحرَمِ",21,"م",1,0],["ومن أضحى له هذا إماما","فليس بغير خالقه يبالي",22,"ل",2,0],["ومن أضحى لدين الله حرزاً","وللبيت العتيق وللمقام",23,"م",1,0],["وَمَن أَضاعَ تُراثاً مِن أُبوَّتِهِ","لَم يَستَفِد مِن سِواهُم قَدرَ ما فَقَدا",24,"د",2,0],["وَمُنَاْضِلُ الإِسْلاْمِ جَهْجَهَ صَوْتُهُ","وَتَكَاْثَرَتْ فِيْ أَرْضِهِ أَعْدَاْدُهُ",25,"د",2,0],["ومَنْ أَضْحَكَتْهُ اليَوْمَ في النَّاسِ بِيْضُهَا","فَفِي قَادِمِ الأيَّامِ تُبْكِيْهِ سُوْدُهَا",26,"د",3,0],["ومنْ اضاميمِ عشقي العاشقونَ رَوَوا","لمنْ يُحبُّونَ لحنَ القولِ من حججي",27,"ج",2,0],["ومن أضحى نزيل المجد يحيى","بجعفر فضله السّامي المحلِّ",28,"ل",1,0]]}