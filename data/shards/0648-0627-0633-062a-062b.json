{"poems":[[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[68,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[92,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[92,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[208,"شاقني الأهل لم تشقني الديار","https://www.aldiwan.net/poem53085.html","الخفيف"],[347,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[376,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[438,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[484,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[505,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[520,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129537","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202732","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107098","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132142","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4929,"القدس بوابة العبور إلى المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199179",""],[4984,"ساير النفس","https://www.poetsgate.com/ViewPoem.aspx?id=215652",""],[4984,"شاخت النفس","https://www.poetsgate.com/ViewPoem.aspx?id=215824",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5145,"من رأى البرق تعالى وسنا","https://www.poetsgate.com/ViewPoem.aspx?id=108060",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5670,"أُحاذِرُ !","https://www.poetsgate.com/ViewPoem.aspx?id=211202",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[5975,"أمة أبي لهب ...","https://www.poetsgate.com/ViewPoem.aspx?id=84579",""],[6256,"المضيفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65930&r=&rc=18",""]],"verses":[["واستَثقَبَ الشَرُّ من مَقَادِحِه","وكانَ في ظَهرِ آلةٍ حَدَبُ",0,"ب",1,0],["واستثاروا عجاجة الكرّ قِدماً","مُشْرعي كلّ ذابلٍ عسّالِ",1,"ل",1,0],["وَاِستَثقَلَت نُطقي بِها فَكَأَنَّما","لَقِيَت بِثالِثِ سورَةِ المُزَّمِّلِ",2,"ل",1,0],["وَاِستَثقَلوا مَن قامَ لِلصَلاةِ","فَكَيفَ مَن طَوَّلَ في القِراةِ",3,"ه",1,0],["واستثيري عواطفي ودعيني","أسمعُ البحرَ أغنيات الشبابِ",4,"ب",1,0],["واستثار الأرواح في الملإِ الأعلى","فأتلَعنَ نحوضهُ الأعناقا",5,"ق",2,0],["واستثاروا دفء الحياة فمات الم","وت º وانقضّ عرشه وهو راغم",6,"م",1,0],["واستَثْقَلَ النوتيُّ مِجْذَفَه","بَرِماً بمِقبَضه يُجَدِّده",7,"د",2,0],["واستثقلت كشفي لهُنَّ ، ولذَّ لي","كوني على ما استَثْقَلتْه مُحرَضا",8,"ض",2,0],["واستثني العتمات في ليل الشتا","والظهر للتبريد في أيام حر",9,"ر",1,0],["واستثاروا نار القصيد سَفاهاً","وتشكّوا لما ترامى الشرارُ",10,"ر",1,0],["واستثارت نفوسهم","ذكريات المصارع",11,"ع",1,0],["وَاِستَثمِروها عَلى الأَحقابِ مُثمِرَةً","ما لَيسَ مُستَثمِراً مِن أَصفَرِ القَصَبِ",12,"ب",1,0],["واستَثاروا السُّيوفَ فيكُم فقُمنا","نَستَثيرُ الأقلامَ في الأوراقِ",13,"ق",1,0],["واسْتَثْبَتَتْهُ لمُلْكِها فكأَنَّه","ثَهْلانُ ذو الهَضباتِ لا يَتَحَلْحَلُ",14,"ل",1,0],["واستثمر بوانكري لفرنكلان جني","غرس لغورو فأرضى العنصر العربي",15,"ب",2,0],["وأَسْتَثِجُّ عَجاجَ الرَّكبِ عن هِمَمٍ","والقومُ ما بين مندوبٍ ومُنْتَدِبِ",16,"ب",1,0],["واستثن والدك الكريم فإنما","أمددت من أنواره بضياء",17,"ا",2,0],["واستثارت من أقاصي لبه","صبوة كان رثاها ونعي",18,"ع",2,0],["وأستثيرهُم في كل آونةٍ","بالنفس والمال تُزْجيهم عزيماتُ",19,"ت",1,0],["واستثن حول والعطا بالقلب مع","تابع نصب أو منادى وارتفع",20,"ع",1,0],["واستثن مقصورا مضى في البحر","لقلة ولاعتلال يزري",21,"ي",1,0],["واستثن كف أول ورابع","لأجل تحريك لوقف مانع",21,"ع",1,0],["واستثن في الاوضاع باء البسمله","فانها بالاتصال معمله",22,"ه",1,0],["واستثن احوالاً تُرى لغيرهِ","في سيرها إذ لم تكن كسيره",22,"ه",1,0],["واستثيروا الليق في نثرته","فهو إن أصغى لكم خير معين",23,"ن",1,0],["واستثن جيّاظاً لذي سمنٍ به","قبحٌ لمُبصرِه إذا يُتَوَسَّمُ",24,"م",1,0],["واستثن منه الضَرْفَ للشجر الذي","للتين فهو لضاده يَستلزمُ",24,"م",1,0],["واستَثنِ نِضْمَ الزرعِ تعني أنه","أبدى امتلاءً فهو زرعٌ يَعظمُ",24,"م",1,0],["واستثن أحضالاً ومن يلعبْ بها","يحضلْ وهنَّ كعوبُ عاجٍ تُحكَمُ",24,"م",1,0],["واستثن أيضاً منه حنضلةً إذا","تعني الغدير بها لمن يتوهمُ",24,"م",1,0],["واستثنِ لي شاعر الفرسان عنترةً","لمّا غدا قوله بالفعل متّحدا",25,"د",2,0],["واستثنِ عمرو بن معدي كرب إن له","في الشعر والمجد مجداً خالداً أبدا",25,"د",2,0],["واستثنِ مَجرُوراً بِغَيرٍ مُعرَبَا","بِمَا لِمُستَثنى بإِلا نُسِبَا",26,"ب",2,0],["وَاستَثنِ نَاصِباً بِلَيسَ وَخَلاَ","وَبَعدَا وبيَكُونُ بَعدَ لاَ",26,"ل",2,0],["واستثن ذا الرا كشرضٍ والجريض سوى","ذي ذم أو ذي لزوم من بنى كرظا",27,"ظ",2,0],["واستثن ذااليا وذا الها نحو جاض وهل","ضٍ هكؤا فعل خلبٍ مشبهٌ شمظا",27,"ظ",2,0],["واستثنِ شاعرك الحقير فعنده","شرف الشمائل والعواطف كاف",28,"ف",1,0],["واستثمروا الارض التي اورثتم","فتكون انضر مرتعى او مرتع",29,"ع",1,0],["واسْتَثْقَلَ الشرفَ الرفيعَ وُلاتُهَا","لاشكَ...، أنتِ لفخرِها مِحْرابُ",30,"ب",1,0],["واستثر ميلها بحس لطيف","قد يعري الميول عنها جلاء",31,"ا",2,0],["واستثارت سقام ما ليس فيها","يِؤلم الجسم فهْو منها عليل",32,"ل",1,0],["واستثن من أشرافهم","قوما لهم فينا رتب",33,"ب",1,0],["واستثارت شجني صادحة","ذات ألحانٍ تثير الشجنا",34,"ن",2,0],["واستثمروا في الاتصال فبددوا","مليارَ . دُمْ جفن القضا بنعاسِ",35,"س",1,0],["‏وأستثير خيولَ الشعر مرتقبا","‏جِماحَها، طالما آوتْ لإخلادِ",36,"د",1,0],["واستثار الصدر من بركانه","نافثا من غيضه ما أودقا",37,"ق",2,0],["واستثمروا خيراتها وتنكّروا","للأمِّ واهبةً .. وللوهّابِ",38,"ب",1,0],["واستثارت عواطفاً وعيوناً","حينما أقبلت بقدّ لعوب",39,"ب",1,0]]}