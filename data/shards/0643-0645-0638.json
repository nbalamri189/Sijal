{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[53,"كم ظهر ميت مقفر جاوزته","https://www.aldiwan.net/poem64096.html","الكامل"],[53,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[53,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[46,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[46,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[48,"كم آية يؤنسها معشر","https://www.aldiwan.net/poem23548.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[98,"على صخور المكس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66372&r=&rc=48",""],[147,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[154,"لا يخدعنك ظاهر من باطن","https://www.aldiwan.net/poem68507.html","الكامل"],[230,"شمس المعالي كعقود الجمان","https://www.aldiwan.net/poem55208.html","السريع"],[280,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[369,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[376,"ما بين أجفاني ملاحم","https://www.aldiwan.net/poem57111.html","مجزوء الكامل"],[396,"كلنا أموات لكن بخت من قدم إحسان","https://www.aldiwan.net/poem54455.html","عموديه"],[466,"لا تشمتن بمن أسا وهوى","https://www.aldiwan.net/poem16071.html","أحذ الكامل"],[511,"قل للزنادق عني","https://www.aldiwan.net/poem2394.html","المجتث"],[520,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[534,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[580,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122690","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122712","البسيط"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139050",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145961","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59663","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62469","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62491","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96704","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78165","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101024","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89522","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109457","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130032","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53009","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91089","المديد"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54495","المجتث"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58029","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72428","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130297","الخفيف"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102009","البسيط"],[4690,"ما بَيْنَنا","https://www.poetsgate.com/ViewPoem.aspx?id=186149",""],[585,"يا أرض حسبك إرعاداً وإبراقاً","https://www.poetsgate.com/ViewPoem.aspx?id=161883",""],[5106,"صِدْقُ العِيُونِ مَرَايَتِيْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=150976",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[5419,"للحبّ غنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=51997",""],[5461,"لا هنت","https://www.poetsgate.com/ViewPoem.aspx?id=8541",""],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5853,"حيرة الممسوس","https://www.poetsgate.com/ViewPoem.aspx?id=175694",""]],"verses":[["كم ظَلَّلَتْها وحاطَتْها بأجنحةٍ","عن أعينِ الدَّهرِ قد كانت تُواريها",0,"ي",3,0],["كم ظهر مَيْتٍ مقفِرٍ جاوزتُهُ","فحللتُ ربعاً منك ليس بمقفرِ",1,"ر",1,1],["كم ظلِّ يأسٍ مطبق كشَّفته","عند اعتقاد اليأس من تكشيفه",2,"ف",2,0],["كم ظِلِّ يومٍ ممطرٍ لك مصعقٍ","متحمد الإمطار والإصعاق",3,"ق",1,0],["كم ظميٍ بظميٍ يرتوي","وغريق مستعين بغريق",4,"ق",1,0],["كَم ظَهرِ مَرتٍ مُقفِرٍ جاوَزتُهُ","فَحَلَلتُ رَبعاً مِنكَ لَيسَ بِمُقفِرِ",5,"ر",1,0],["كَم ظَلامٍ عَنِ العُلى قَد تَجَلّى","بِكَ وَالمَكرُماتُ عَنكَ رَواضِ",6,"ض",1,0],["كَم ظَلَمَ الأَقوامُ أَمثالَهُم","ثُمَّتَ بادوا فَمَتى يَلتَقون",7,"ن",1,0],["كم ظلّ يضربُ في صخورِكِ موجُهُ","مما أجَنَّ محبَّةً ووفاءَ",8,"ا",2,0],["كم ظَبْيَةٍ في أسَدٍ تَعْتَزي","وجاهِلٍ مُنَسَّبٍ في عُقَيْل",9,"ل",1,0],["كم ظلّ يضرب في صخور موجه","ممّا أجنّ محبّة وفاء",10,"ا",2,0],["كَم ظُلمَةٍ جَلَّيتَها بِكَواكِبٍ","يَطلُعنَ فَوقَ عَوامِلِ المُرّانِ",11,"ن",1,0],["كم ظاهر قد غرّ وهو مزورٌ","ولربّما خدع القلوب لسان",12,"ن",1,0],["كم ظَلَّ منهُ المَرءُ في جَحفَلٍ","وَباتَ في حِصنٍ رَفيعِ العِنان",13,"ن",1,0],["كَم ظامئٍ للظُّبا فِيهم تضَلُّعُه","وساغِبٍ للْقَنَا مِنْهم تَمَلُّؤُهُ",14,"ا",2,0],["كَم ظَرَّزَ المَدحَ وَالأَطراءَ مادِحُهُ","وَنِعمَ خُطَّتُهُ وَالحُسنُ خِطَّتُهُ",15,"ت",2,0],["كم ظَهْرِ أَرْضٍ منَ التقّبيل أُحْرَمُه","بظَهْرِ كَفٍّ منَ الوُفّادِ يُدْنيه",16,"ي",2,0],["كم ظمأةٍ لي إلى مراشِفها","كما يشاءُ الغَيورُ أظمؤها",17,"ا",3,0],["كم ظلَّ تُلِهبُهُ الخُدو","دُ وباتَ تُبردُه المباسِم",18,"م",1,0],["كم ظلم من مساكين ضعاف ونسوان","كم مساجد وأيتام وفقرا وصبيان",19,"ن",1,0],["كم ظالِمٍ أحْببتُ صَرْعَتهُ","فبكيْتُهُ ممَّا تورَّطَ بِهْ",20,"ب",2,0],["كم ظاميء لكلامي","يَرويه عَجباً فَيرويه",21,"ي",2,0],["كم ظفر نائبة في الدهر قلمها","عزم المظفر بالصمصام والقلم",22,"م",1,0],["كَمْ ظَنَّ ذُو حَمَقٍ في الضُّرِّ منْفَعَةً","وظَلَّ يَرْجُو نَجاةً مِنْ يَدِ العَطَبِ",23,"ب",1,0],["كَمْ ظَفَرٍ فَازَ به فاغْتَدى","يُنْعَت بالفَائِزِ والظَّافِر",24,"ر",1,0],["كَم ظَلَّ عِندَكَ وَفرٌ وَهوَ مُجتَمِعٌ","مِلءُ البِلادِ فأمسَى وَهوَ مُفتَرِقُ",25,"ق",1,0],["كَم ظَلَّ يَجمَعُ رُوقيهِ لينطَحَني","وَما يُفيدُ بِنَطحِ الصَّخرَةِ الوَعِلُ",26,"ل",1,0],["كم ظل يطرحها من لبس ذا شرف","جهرا ويوصف مع هذا بإتقان",27,"ن",1,0],["كم ظاميءٌ وجائعٌ هو الأسى","أشبعتُهُ مِن ظمأي وجُوعي",28,"ع",2,0],["كم ظمئنا لمورد بحماكم","فحمته جفونُكم بنبال",29,"ل",1,0],["كم ظلام قد محا","نورُه إذْ لُمحا",30,"ح",2,0],["كم ظلمة فيه استقلت فانجلت","عن راكبيه بنوره يوم استقل",31,"ل",1,0],["كم ظامئ أرواه إذ","من بحر كفَّيْه اغترفْ",32,"ف",1,0],["كم ظلام أزاحه وضلال","كم صباح أناره ورشاد",33,"د",1,0],["كَم ظلت فيه على حكمِ الهوى كلفاً","أقضي الفرائضَ عن وجدٍ وأنتقلُ",34,"ل",1,0],["كَم ظَلَ يِمدَح مَع ما فيهِ مِن عَوَج","وَإِن شَكا مِنهُ مَجروح وَمَقتولُ",35,"ل",1,0],["كم ظفرتم منه بما عجب التا","ميز عنه وناء بالعبء حملا",36,"ل",2,0],["كَم ظَنَّ قَومٌ إِذا حَقَّت شَقاوَتُهُم","بِأَن لَهُم عَنكَ إِمّا أَبعَدوا وَزَرُ",37,"ر",1,0],["كمظهر ذي المجد الأثيل ابن بيرمٍ","سمي رسول اللَه وهو محمد",38,"د",1,0],["كم ظلّ صاحبهُ بسح","رِ اللحظ منه وكم غوى",39,"و",2,0],["كم ظهرتْ في عهده مفاخرْ","فاقتْ به الأوائلُ الأواخرْ",40,"ر",1,0],["كَم ظلمت النَفس فيما قَضت","فَانتقذها قَد كَفاها الظلامْ",41,"م",1,0],["كم ظَهْرِ شركٍ قَصَمنا","وعِطْفِ عِزٍّ هَزَزْنا",42,"ن",2,0],["كم ظالمٍ مستدرَجٍ بنعيمهِ","حتَّى يؤاخذ بغتةً بدَمَارِ",43,"ر",1,0],["كم ظن قوم قبولا منه تم لهم","وحققوا الظن أني غير مقبول",44,"ل",1,0],["كم ظاهر مضمر لوجدي","لظاهر منهما ومضمر",45,"ر",1,0],["كم ظلام جعلته طيلساني","صاحبي همتي وقلبي مجني",46,"ن",2,0],["كم ظل فيها يعاطيني المدام رشا","من عذب ريق لداء القلب رياق",47,"ق",1,0],["كَمْ ظَلّ فينا راسِخًا","حتّى الرّسوخُ تَحَيّرا",48,"ر",2,0],["كم ظنك الناس فيما مر من زمن","بأنك الكون أصقاعاً وآفاقا",49,"ق",2,0],["كَمْ ظَنَّ قَلبِيْ نَبْضَهُ أَنْ يَنْتَهِيْ","أَمَلٌ بِنْبَضِيْ رَائِعٌ .. فَشَقَتْ ظُنُونُهْ",50,"ن",2,0],["كَمْ ظَهَرَتْ مِنْهُ مُعْجِزَاتٌ","تُعَدُّ بِالنَّجْمِ وَالرِّمَالِ",51,"ل",1,0],["كم ظلّ يحرم نفسَه من متعة الد","نيا ليمتع طفله منذ الصغرْ",52,"ر",1,0],["كم ظالم(ن) عاداك واعفيت واحسنت","واخلفت ظن جموع ناس(ن) يظنون",53,"ن",1,0],["كَمْ ظَلْتُ فِيهِ عَلَى حُكْمِ الهَوَى كَلِفاً","أَقْضِي الفَرائِضَ عَنْ وَجْدٍ وَأَنْتَفِلُ",54,"ل",1,0],["كم ظل من أملٍ في الروح يسكنني","بدّدْ ته بالمنى في داخلي عبثا",55,"ث",2,0]]}