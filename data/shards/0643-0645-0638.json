{"poems":[[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[51,"كم ظهر ميت مقفر جاوزته","https://www.aldiwan.net/poem64096.html","الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[44,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[44,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[46,"كم آية يؤنسها معشر","https://www.aldiwan.net/poem23548.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[96,"على صخور المكس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66372&r=&rc=48",""],[141,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[148,"لا يخدعنك ظاهر من باطن","https://www.aldiwan.net/poem68507.html","الكامل"],[223,"شمس المعالي كعقود الجمان","https://www.aldiwan.net/poem55208.html","السريع"],[273,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[318,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[362,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[362,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[369,"ما بين أجفاني ملاحم","https://www.aldiwan.net/poem57111.html","مجزوء الكامل"],[388,"كلنا أموات لكن بخت من قدم إحسان","https://www.aldiwan.net/poem54455.html","عموديه"],[459,"لا تشمتن بمن أسا وهوى","https://www.aldiwan.net/poem16071.html","أحذ الكامل"],[504,"قل للزنادق عني","https://www.aldiwan.net/poem2394.html","المجتث"],[513,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[527,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[573,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"]],"verses":[["كم ظَلَّلَتْها وحاطَتْها بأجنحةٍ","عن أعينِ الدَّهرِ قد كانت تُواريها",0,"ي",3,0],["كم ظهر مَيْتٍ مقفِرٍ جاوزتُهُ","فحللتُ ربعاً منك ليس بمقفرِ",1,"ر",1,1],["كم ظلِّ يأسٍ مطبق كشَّفته","عند اعتقاد اليأس من تكشيفه",2,"ف",2,0],["كم ظِلِّ يومٍ ممطرٍ لك مصعقٍ","متحمد الإمطار والإصعاق",3,"ق",1,0],["كم ظميٍ بظميٍ يرتوي","وغريق مستعين بغريق",4,"ق",1,0],["كَم ظَهرِ مَرتٍ مُقفِرٍ جاوَزتُهُ","فَحَلَلتُ رَبعاً مِنكَ لَيسَ بِمُقفِرِ",5,"ر",1,0],["كَم ظَلامٍ عَنِ العُلى قَد تَجَلّى","بِكَ وَالمَكرُماتُ عَنكَ رَواضِ",6,"ض",1,0],["كَم ظَلَمَ الأَقوامُ أَمثالَهُم","ثُمَّتَ بادوا فَمَتى يَلتَقون",7,"ن",1,0],["كم ظلّ يضربُ في صخورِكِ موجُهُ","مما أجَنَّ محبَّةً ووفاءَ",8,"ا",2,0],["كم ظَبْيَةٍ في أسَدٍ تَعْتَزي","وجاهِلٍ مُنَسَّبٍ في عُقَيْل",9,"ل",1,0],["كم ظلّ يضرب في صخور موجه","ممّا أجنّ محبّة وفاء",10,"ا",2,0],["كَم ظُلمَةٍ جَلَّيتَها بِكَواكِبٍ","يَطلُعنَ فَوقَ عَوامِلِ المُرّانِ",11,"ن",1,0],["كم ظاهر قد غرّ وهو مزورٌ","ولربّما خدع القلوب لسان",12,"ن",1,0],["كم ظَلَّ منهُ المَرءُ في جَحفَلٍ","وَباتَ في حِصنٍ رَفيعِ العِنان",13,"ن",1,0],["كَم ظامئٍ للظُّبا فِيهم تضَلُّعُه","وساغِبٍ للْقَنَا مِنْهم تَمَلُّؤُهُ",14,"ا",2,0],["كَم ظَرَّزَ المَدحَ وَالأَطراءَ مادِحُهُ","وَنِعمَ خُطَّتُهُ وَالحُسنُ خِطَّتُهُ",15,"ت",2,0],["كم ظَهْرِ أَرْضٍ منَ التقّبيل أُحْرَمُه","بظَهْرِ كَفٍّ منَ الوُفّادِ يُدْنيه",16,"ي",2,0],["كم ظمأةٍ لي إلى مراشِفها","كما يشاءُ الغَيورُ أظمؤها",17,"ا",3,0],["كم ظلَّ تُلِهبُهُ الخُدو","دُ وباتَ تُبردُه المباسِم",18,"م",1,0],["كم ظلم من مساكين ضعاف ونسوان","كم مساجد وأيتام وفقرا وصبيان",19,"ن",1,0],["كم ظالِمٍ أحْببتُ صَرْعَتهُ","فبكيْتُهُ ممَّا تورَّطَ بِهْ",20,"ب",2,0],["كم ظاميء لكلامي","يَرويه عَجباً فَيرويه",21,"ي",2,0],["كم ظفر نائبة في الدهر قلمها","عزم المظفر بالصمصام والقلم",22,"م",1,0],["كَمْ ظَنَّ ذُو حَمَقٍ في الضُّرِّ منْفَعَةً","وظَلَّ يَرْجُو نَجاةً مِنْ يَدِ العَطَبِ",23,"ب",1,0],["كَمْ ظَفَرٍ فَازَ به فاغْتَدى","يُنْعَت بالفَائِزِ والظَّافِر",24,"ر",1,0]]}