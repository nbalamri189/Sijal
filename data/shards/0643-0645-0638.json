{"poems":[[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[51,"كم ظهر ميت مقفر جاوزته","https://www.aldiwan.net/poem64096.html","الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[44,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[44,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[46,"كم آية يؤنسها معشر","https://www.aldiwan.net/poem23548.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[96,"على صخور المكس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66372&r=&rc=48",""]],"verses":[["كم ظَلَّلَتْها وحاطَتْها بأجنحةٍ","عن أعينِ الدَّهرِ قد كانت تُواريها",0,"ي",3,0],["كم ظهر مَيْتٍ مقفِرٍ جاوزتُهُ","فحللتُ ربعاً منك ليس بمقفرِ",1,"ر",1,1],["كم ظلِّ يأسٍ مطبق كشَّفته","عند اعتقاد اليأس من تكشيفه",2,"ف",2,0],["كم ظِلِّ يومٍ ممطرٍ لك مصعقٍ","متحمد الإمطار والإصعاق",3,"ق",1,0],["كم ظميٍ بظميٍ يرتوي","وغريق مستعين بغريق",4,"ق",1,0],["كَم ظَهرِ مَرتٍ مُقفِرٍ جاوَزتُهُ","فَحَلَلتُ رَبعاً مِنكَ لَيسَ بِمُقفِرِ",5,"ر",1,0],["كَم ظَلامٍ عَنِ العُلى قَد تَجَلّى","بِكَ وَالمَكرُماتُ عَنكَ رَواضِ",6,"ض",1,0],["كَم ظَلَمَ الأَقوامُ أَمثالَهُم","ثُمَّتَ بادوا فَمَتى يَلتَقون",7,"ن",1,0],["كم ظلّ يضربُ في صخورِكِ موجُهُ","مما أجَنَّ محبَّةً ووفاءَ",8,"ا",2,0],["كم ظَبْيَةٍ في أسَدٍ تَعْتَزي","وجاهِلٍ مُنَسَّبٍ في عُقَيْل",9,"ل",1,0],["كم ظلّ يضرب في صخور موجه","ممّا أجنّ محبّة وفاء",10,"ا",2,0]]}