{"poems":[[30,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[83,"لو تروا حب ما اجمل","https://www.aldiwan.net/poem54199.html","الخفيف"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[4,"يا مي قومي في المآتم واندبي","https://www.aldiwan.net/poem21176.html","الطويل"],[29,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[97,"أحببت مية حبا لا يعادله","https://www.aldiwan.net/poem24864.html","البسيط"],[97,"يا مية الحسناء هل يغزو الهوى","https://www.aldiwan.net/poem24867.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[116,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[125,"أهوى ولات اليوم حين تصابي","https://www.aldiwan.net/poem23733.html","الكامل"],[125,"هل تذكرين وأنت من غزلانه","https://www.aldiwan.net/poem23738.html","الكامل"],[125,"يا مي وادي الشتا صرت جنادبه","https://www.aldiwan.net/poem23784.html","البسيط"],[144,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[193,"يا نورة الهجر حلقت الصفا","https://www.aldiwan.net/poem27469.html","السريع"],[198,"يا مي ناب السمع عن بصري","https://www.aldiwan.net/poem39941.html","أحذ الكامل"],[224,"ألدمع من عيني لم يذرف","https://www.aldiwan.net/poem41626.html","السريع"],[260,"يا ميت الحب في العشاق أنت الحي","https://www.aldiwan.net/poem35319.html","المواليا"],[271,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[271,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[291,"يا دارها لا زلت آهلة","https://www.aldiwan.net/poem11666.html","أحذ الكامل"],[291,"أخشى عليك من العيون","https://www.aldiwan.net/poem11709.html","مجزوء الكامل"],[299,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[350,"يا مي مل الهوى إلا معناك","https://www.aldiwan.net/poem15813.html","البسيط"],[380,"يا مي ذات الطوق والمعضاد","https://www.aldiwan.net/poem4545.html","الرجز"],[430,"يا مي يا ظبية وادي اللوى","https://www.aldiwan.net/poem40271.html","السريع"],[430,"يا مي صبك كم يبيت معذبا","https://www.aldiwan.net/poem40721.html","الكامل"],[442,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[469,"يا من يبيع الرشد بالغي","https://www.aldiwan.net/poem59523.html","السريع"],[552,"لا قضى الله لقلبي","https://www.aldiwan.net/poem47894.html","البسيط"]],"verses":[["يا مَيُّ ذاتَ المَبسِمِ المَبرودِ","بَعدَ الرُقادِ وَالحَشا المَخضودِ",0,"د",1,0],["يام يفتح من البليد","فالقريب منها والبعيد",1,"د",1,0],["يا مياهاً جرت بدجلة تجتا","ز مروراً بجانبي بغداد",2,"د",1,0],["يا مَيُّ وَيحَكِ أَنجِزي المَوعودا","وَاِرعَي بِذاكَ أَمانَةً وَعُهودا",3,"د",2,0],["يا مَيَّ قومي في المَآتِمِ وَاِندُبي","فَتىً كانَ مِمَّن يَبتَني المَجدَ أَروَعا",4,"ع",2,1],["يا مَيَّ هَلّا يُجازي بَعضُ وَدَّكُمُ","أَم لا يُفادى أَسيرٌ عِندَكُم غَلِقُ",5,"ق",1,1],["يا مَيِّتاً فيهِ جَمالُ الحَياة","ما حازَ مِنكَ اللَحدُ إِلّا الرُفات",6,"ت",1,1],["يا ميّ يا قلبي الثاني أعيش به","وإن يكن فوق ظنِّي أنّني معه",7,"ع",2,0],["يا ميَّةُ الحسناء هل يغزو الهوى","قلبين ما كانا على ميعاد",8,"د",1,1],["يا مَيَّ إني قد مُنيت بظلمةٍ","والليلُ يجثم فوق صدر الوادي",8,"د",2,0],["يا ميسلون شهدتِ أي روايةٍ","دمويةٍ ورأيت أيَّ مذابحِ",9,"ح",1,0],["يامي صبرا واستقرى انها","عثرات حال ما لها استقبال",10,"ل",1,0],["يا مي أشطان الخيال أرثها","متح الوقائع من معين سر",11,"ر",1,0],["يا مي ما للقلب حال وجيبه","صمتاً كصمت الميت في أكفانه",12,"ن",2,0],["يا مي ما ذنبي إذا فر الصبا","ومضى ولم أجن الشباب لشأنه",12,"ن",2,0],["يا مي ما ذنبي إذا دهري عتا","وسواد حظي لج في طغيانه",12,"ن",2,0],["يا مي جلعاد الأشم كعهده","ما زال يريض جاثماً بمكانه",12,"ن",2,0],["يا مي ما برحت حمائم سدرنا","تشدو مصفقة على أغصانه",12,"ن",2,0],["يا مي قد عاد الربيع وعاودت","نفسي وساوس قصفه ودنانه",12,"ن",2,0],["يا مي قد صرت جنادب حقلنا","وفراشه يختال في طيرانه",12,"ن",2,0],["يا مي وادي الشتا صرت جنادبه","فطر شارب ذاك المجرم الجاني",13,"ن",2,1],["يامي دحنون وادي الحور حمرته","قد شابها ببياض طل نيسان",13,"ن",1,0],["يا مي شبنا وما تبنا فهل نزلت","بما انتهينا إليه آي قرآن",13,"ن",1,0],["يامَيُّ هَل لِدُنُوِّ دارِكِ رَجعَةٌ","أَم لِلعِتابِ لَدَيكُمُ إِعتابُ",14,"ب",1,0],["يا مِئزَرُ الأَسقامِ حَتّى مَتى","تَنقَعُ في حَوضٍ مِنَ الجُهدِ",15,"د",1,0],["يا مَيُّ نابَ السمعُ عن بَصَري","في الليلَةِ السوداءِ من صَفَرِ",16,"ر",1,1],["يا ميُّ والأحلامُ شاردةٌ","رُحماكِ رُدّيها لمفتَقِرِ",16,"ر",1,0],["يا ميّ والأيّامُ عابسةٌ","باللَهِ غنّي وارقُصي وذَري",16,"ر",2,0],["يا ميُّ والأقدارُ ساخِرةٌ","منّا ولم نسخَر ولم نثُر",16,"ر",1,0],["يا ميُّ ما لِلأَهلِ من مَدخَلٍ","بَينَ كَسيرِ الجِفنِ وَالمدنفِ",17,"ف",1,0],["يا ميت الحبّ في العشّاق أنت الحيّ","إن جزت عرب النقا سلم وحيِّ الحيّ",18,"ي",1,1],["يا ميُّ أفنى مُهجتي التّعليلُ","أكذا عزيزٌ عندكِ التّقبيلُ",19,"ل",1,1],["يا ميَّ لا تَبكي رجالَكَ إنَّهم","كُرَماءُ في السَّراءِ والضَّرَّاء",20,"ا",2,0],["يا مي حبك في دمي يجري","ولأنت كل مناي من دهري",21,"ر",2,0],["يا مي إني مولع دنف","أودى المقام به وما يدري",21,"ر",2,0],["يا ميّ لو تدرين ما أخفي","من الهم الدفين",22,"ن",1,0],["يا مي بين جوانحي","شتى النوازع والشجون",22,"ن",1,0],["يا (ميُّ) ما رأَيتِ في","ديارِنا من معجب",23,"ب",1,0],["يا مَيُّ مَلَّ الهَوى إِلّا مَعناكِ","وَحالَ صَبٌّ صَبا إِلَا لِمَعناكِ",24,"ك",1,1],["يا مَيُّ ذات الطوق والمعضاد","فدتك كل رعبل عصواد",25,"د",1,1],["يا ميّ يا ظبية وادي اللوى","هواك لم يترك بقلبي هوى",26,"و",2,1],["يا ميّ صبك كم يبيت معذباً","يرعى النجوم يذق طعم الكرى",27,"ر",2,1],["يا ميت أنت حي بالجميل فقد","أبقيته من فعال الخير في الجمل",28,"ل",1,0],["يا مَيِّتَ الخاطِرِ حَتّى مَتى","تَطعَنُ في خاطِري الحَيِّ",29,"ي",1,0],["يا ميلحَ الوَجهِ لِمْ تصْ","نعُ ما ليسَ مَليحا",30,"ح",2,0]]}