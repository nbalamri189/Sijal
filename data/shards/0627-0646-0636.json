{"poems":[[53,"أبرا إلى المجد من حرصي على الطلب","https://www.aldiwan.net/poem30707.html","البسيط"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[77,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[86,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[72,"أفدي خليلا ما كان يجمع لي","https://www.aldiwan.net/poem19414.html","المنسرح"],[51,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[89,"بثوا بألسنة لكم من نار","https://www.aldiwan.net/poem44922.html","الكامل"],[85,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[56,"أنضاء طلت دمعهم أطلالهم","https://www.aldiwan.net/poem58508.html","الكامل"],[62,"قالت حرمت الغنى من حيث أوتيه","https://www.aldiwan.net/poem52289.html","البسيط"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[62,"اسعد بيوم قد أتاك مبكرا","https://www.aldiwan.net/poem52391.html","الكامل"],[58,"إن عبدا أطاع ربا جليلا","https://www.aldiwan.net/poem30892.html","الخفيف"],[66,"سفها إذا شقت عليك جيوب","https://www.aldiwan.net/poem40296.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[44,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[105,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[81,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[48,"وفتية كنجوم الليل أوجههم","https://www.aldiwan.net/poem62482.html","البسيط"],[48,"أنضيت أحرف لا مما لهجت بها","https://www.aldiwan.net/poem65119.html","البسيط"],[48,"يا فضل قد أودعتني عظة","https://www.aldiwan.net/poem66203.html","الكامل"],[76,"زادني لومك إصرارا","https://www.aldiwan.net/poem39319.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54833","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[106,"الطبيب يس","https://www.poetsgate.com/ViewPoem.aspx?id=179703",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[77,"عهد الشباب سقى أيامك الأولا","https://www.poetsgate.com/ViewPoem.aspx?id=34202",""]],"verses":[["أَنضَيتُ سِتّاً وَعَشراً ما قَضَيتُ بِها","سِوى المُنى وَطَراً إِلّا مِنَ الأَدَبِ",0,"ب",1,0],["أَنضَيتِ عَيشَكِ عِفَّةً وَزَهادَةً","وَطُرِحتِ مُثقَلَةً مِنَ الأَعباءِ",1,"ا",2,0],["أنْضاءِ أفْيَحَ إنْ ضلّوا وإنْ ظمِئوا","شامُوا النّدى واسْتَدلّوا البيضَ والأسَلا",2,"ل",2,0],["أَنضَيتُها بَعدَما طالَ الهِبابُ بِها","تَأُمَّ هَوذَةَ لا نِكساً وَلا وَرَعا",3,"ع",2,0],["إِن ضاقَ صَدرُ النيلِ عَمّا هالَهُ","يَومَ الحَمامِ فَإِنَّ صَدرَكَ أَرحَبُ",4,"ب",1,0],["إِن ضاقَ مَيدانُ سَبقٍ مِن عَزائِمِهِم","صاحَت بِهِم فَأَرَوها أَلفَ مَيدانِ",5,"ن",1,0],["أَنْضَبَ الْبُؤْسِ ذِهْنَهُ فَعَرَاهُ","شِبْهُ عُقْمٍ وَلَمْ يَكُنْ بِعَقِيمِ",6,"م",1,0],["أَنَضيرَ ما بَيني وَبَينَكُمُ","صُرَمٌ وَما أَحدَثتُ مِن هَجرِ",7,"ر",1,0],["إن ضنَّ بالوصلِ من لقاه فما","يضنّ بالوصلِ من مهارقه",8,"ه",1,0],["أُنضِجَ القبحُ فيك جد","داً وما أُنضج المَشَجْ",9,"ج",1,0],["انضوا القديم وبالجديد توشحوا","حتام تختالون في الاطمار",10,"ر",1,0],["إن ضقت يا دارنا الدنيا بنا أملا","في دارِنا الخلد آمال بلا عدد",11,"د",1,0],["إِن ضاقَ ظَهرُ الأَرضِ عَنكَ فَبَطنُها","عَمّا وَراءَكَ مِن رُفاتٍ أَضيَقُ",12,"ق",1,0],["أَنْضاءُ طَلّتْ دَمْعَهم أَطْلالُهُمْ","فتخالُهُمْ بينَ الرُّسُومِ رُسُوما",13,"م",2,1],["إن ضاقَ خُطَّةُ حالي لم يضِقْ خُلُقي","أو قصَّرَ المالُ لم تقصُرْ له هممي",14,"م",2,0],["إنْ ضَنَّ غيثٌ أو جنَى قمرٌ","فيمينُه وجبينُه البَدَلُ",15,"ل",1,0],["أَنضى اليك الجُرْدَ يجشِمُها الفلا","عَجِلاً وخاضَ البِيدَ يطوِيها السُّرى",16,"ر",2,0],["إِن ضَربَ العِدا بِأَبيضَ يُرضي","سَيِّداً قادراً وَيُشفي غَليلا",17,"ل",2,0],["إِن ضاعَ ثارُكَ بَينَ آلِ مَحاسِنٍ","تِلكَ المَحاسِنُ كُلَّهُنَّ عُيوبُ",18,"ب",1,0],["إن ضاق خطوُ عبوس الأسد من جزَع","مَشَى إليه فسيحَ الخطو مبتسما",19,"م",2,0],["إِن ضَنَّ بِالجودِ مَقبوضُ اليَدَينِ سَخا","وَإِن عَتا ظالِمٌ في مُلكِهِ رَفَقا",20,"ق",2,0],["أَنضَيتُ في هَذا الأَنامِ تَجارِبي","وَبَلَوتُهُم بِمُفَحَّصاتِ مَذاهِبي",21,"ب",2,1],["أَنضَرَت أَيكَتي عَطاياكَ حَتّى","صارَ ساقاً عودي وَكانَ قَضيبا",22,"ب",2,0],["أَنُضِيعُ ما تركوا لنا ونخونُهم","لسنا إذَنْ مِمّن يخاف العارا",23,"ر",2,0],["أنضَجتَ نفسَكَ غَيظاً","فاليومَ تُنضِجُ جِلْدَكْ",24,"ك",1,0],["إن ضاق صَدْرُكَ حِينَ تُذكرُ أُمُّهُ","فلصدرها لو كنت تعلم أرحبُ",25,"ب",1,0],["إن ضمَّهم عند الشَهادةِ مَورِدٌ","لَذَّ المذاقُ لهم وطابَ المطعم",26,"م",1,0],["إِن ضَلَّ غَيرُكَ وَهُوَ أَكثَرُ ناصِراً","وَنَهَضتَ لِلإِسلامِ وَحدَكَ مُظهَرا",27,"ر",2,0],["أَنضاءِ كَأسٍ إِذا ما اللَيلُ جَنَّهُمُ","ساقَتهُمُ نَحوَها سَوقاً بِإِزعاجِ",28,"ج",1,0],["أَنضَيتِ أَحرُفَ لا مِمّا لَهَجتُ بِها","فَحُقَّ لي رِحلَةٌ مِنها إِلى نَعَمِ",29,"م",1,1],["إِن ضاقَ عَفوُكَ وَهوَ ذو سِعَةٍ","عَنّي فَلَيسَ بِواسِعٍ عَفوُ",30,"و",1,0],["أنضجتْ نارُ النَّوى كَبِدي","وَدُمُوعي تُطفِئُ النَّارا",31,"ر",2,0],["إن ضمهم نادى الحضور تنقلوا","من ذكر إسطورٍ إلى إسطور",32,"ر",1,0],["إنَّ ضلوعاً تحتمي في ضلوع","مقادرٌ ليس بها من رجوع",33,"ع",1,0],["إنْ ضجَّ في الأغلالِ منهم طليحْ","أخرسهُ السوطُ الذي يُرهفُ",34,"ف",1,0],["أَنْضَبَ مَاءُ عَيْنِهِ مِمَّا بِكَى","نَجْلَيْهِ حَتَّى قَلْبُهُ تَصَبَّبَا",35,"ب",2,0],["أَنْضَرْ بَنَبْتِكَ يَا جَنَانُ وَحَبَّذَا","هَذِي الغُصُونُ وَهَذِهِ الأَزْهَارُ",36,"ر",1,0],["إن ضاع يومي، ما أسفت على","خضر الربيع وزرقة الجلد",37,"د",1,0],["إن ضجَّ من آبٍ وحَرِّ وَثاقِهِ","فاليومَ يَدْرُجُ ما يشاءُ ويَخْطِر",38,"ر",1,0],["إن ضللت الشفاءَ في كلِّ وادٍ","كانَ «ياسينُ» بالشفاء ضمينا",39,"ن",2,0],["إن ضاق في أقدامنا، فلعلَّه","قد كان في قَدَميْ «لُويسٍ» أضيَقَا",40,"ق",2,0],["أنضاء أفيح إن ظلوا وإن ظمئوا","شاموا الندى واستبدلوا البيض والأملا",41,"ل",2,0]]}