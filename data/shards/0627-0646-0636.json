{"poems":[[53,"أبرا إلى المجد من حرصي على الطلب","https://www.aldiwan.net/poem30707.html","البسيط"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[77,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[86,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[72,"أفدي خليلا ما كان يجمع لي","https://www.aldiwan.net/poem19414.html","المنسرح"],[51,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[89,"بثوا بألسنة لكم من نار","https://www.aldiwan.net/poem44922.html","الكامل"],[85,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[56,"أنضاء طلت دمعهم أطلالهم","https://www.aldiwan.net/poem58508.html","الكامل"],[62,"قالت حرمت الغنى من حيث أوتيه","https://www.aldiwan.net/poem52289.html","البسيط"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[62,"اسعد بيوم قد أتاك مبكرا","https://www.aldiwan.net/poem52391.html","الكامل"],[58,"إن عبدا أطاع ربا جليلا","https://www.aldiwan.net/poem30892.html","الخفيف"],[66,"سفها إذا شقت عليك جيوب","https://www.aldiwan.net/poem40296.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[44,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[105,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[81,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[48,"وفتية كنجوم الليل أوجههم","https://www.aldiwan.net/poem62482.html","البسيط"],[48,"أنضيت أحرف لا مما لهجت بها","https://www.aldiwan.net/poem65119.html","البسيط"],[48,"يا فضل قد أودعتني عظة","https://www.aldiwan.net/poem66203.html","الكامل"],[76,"زادني لومك إصرارا","https://www.aldiwan.net/poem39319.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54833","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[106,"الطبيب يس","https://www.poetsgate.com/ViewPoem.aspx?id=179703",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[77,"عهد الشباب سقى أيامك الأولا","https://www.poetsgate.com/ViewPoem.aspx?id=34202",""],[109,"دار عليها وحشة وقتام","https://www.aldiwan.net/poem16508.html","الكامل"],[120,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[132,"بلغ سلامى إذا جئت البتول لها","https://www.aldiwan.net/poem54771.html","البسيط"],[142,"صبحها الدمع ومساها الأرق","https://www.aldiwan.net/poem58425.html","الرجز"],[143,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[143,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[156,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[182,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[198,"ومرنة قدحت زناد صبابتي","https://www.aldiwan.net/poem51939.html","الكامل"],[199,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[199,"إن ضحك القوم على بعضهم","https://www.aldiwan.net/poem45513.html","السريع"],[199,"إن ضقت بالعسر فلا تبتئس","https://www.aldiwan.net/poem45653.html","السريع"],[235,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[235,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[271,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[275,"إن ضاع قلبي فأين أطلبه","https://www.aldiwan.net/poem25636.html","المنسرح"],[282,"من مجيري من جور حلو المعاني","https://www.aldiwan.net/poem32329.html","الخفيف"],[282,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[297,"ليقعد الدهر بي ما شاء وليقم","https://www.aldiwan.net/poem33170.html","البسيط"],[297,"كوكب الصبح قد بدا يحكيك","https://www.aldiwan.net/poem33199.html","الخفيف"],[297,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[298,"مهوى الفؤاد على ما هجت من ضرم","https://www.aldiwan.net/poem36277.html","عموديه"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[328,"وقفت عمري على قومي وآمالي","https://www.aldiwan.net/poem54932.html","البسيط"],[342,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[348,"أنضيت هرتي الغضبى وجدياني","https://www.aldiwan.net/poem20761.html","البسيط"],[364,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[366,"يا مطمعي لفظا بكله","https://www.aldiwan.net/poem17385.html","الكامل"],[366,"لا تلن للخطوب واصلب فمن لا","https://www.aldiwan.net/poem17748.html","الخفيف"],[371,"إن ضاع قصدي لكم فكم سفر","https://www.aldiwan.net/poem57411.html","الطويل"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[380,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[393,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[400,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[409,"وضح الصباح لناظر المتأمل","https://www.aldiwan.net/poem31960.html","الكامل"],[409,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[416,"قدمت بالبشر وبالبشائر","https://www.aldiwan.net/poem54089.html","الرجز"],[429,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[429,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[437,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[439,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[439,"أنضيت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34916.html","الكامل"],[453,"حاصرتموني وحلتم دون إحساني","https://www.aldiwan.net/poem61606.html","البسيط"],[458,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[461,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[464,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[464,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[464,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[468,"جسم زجاج وروح راح","https://www.aldiwan.net/poem60282.html","مخلع البسيط"],[477,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[477,"ما ضر أهل الحمى لو أنهم رجعوا","https://www.aldiwan.net/poem15287.html","البسيط"],[483,"لمن الديار عفون بالجزع","https://www.aldiwan.net/poem2073.html","أحذ الكامل"],[538,"ذا اليوم تحسد مجده الأيام","https://www.aldiwan.net/poem47942.html","عموديه"],[538,"يا طاهر والله إنك طاهر","https://www.aldiwan.net/poem48188.html","عموديه"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"]],"verses":[["أَنضَيتُ سِتّاً وَعَشراً ما قَضَيتُ بِها","سِوى المُنى وَطَراً إِلّا مِنَ الأَدَبِ",0,"ب",1,0],["أَنضَيتِ عَيشَكِ عِفَّةً وَزَهادَةً","وَطُرِحتِ مُثقَلَةً مِنَ الأَعباءِ",1,"ا",2,0],["أنْضاءِ أفْيَحَ إنْ ضلّوا وإنْ ظمِئوا","شامُوا النّدى واسْتَدلّوا البيضَ والأسَلا",2,"ل",2,0],["أَنضَيتُها بَعدَما طالَ الهِبابُ بِها","تَأُمَّ هَوذَةَ لا نِكساً وَلا وَرَعا",3,"ع",2,0],["إِن ضاقَ صَدرُ النيلِ عَمّا هالَهُ","يَومَ الحَمامِ فَإِنَّ صَدرَكَ أَرحَبُ",4,"ب",1,0],["إِن ضاقَ مَيدانُ سَبقٍ مِن عَزائِمِهِم","صاحَت بِهِم فَأَرَوها أَلفَ مَيدانِ",5,"ن",1,0],["أَنْضَبَ الْبُؤْسِ ذِهْنَهُ فَعَرَاهُ","شِبْهُ عُقْمٍ وَلَمْ يَكُنْ بِعَقِيمِ",6,"م",1,0],["أَنَضيرَ ما بَيني وَبَينَكُمُ","صُرَمٌ وَما أَحدَثتُ مِن هَجرِ",7,"ر",1,0],["إن ضنَّ بالوصلِ من لقاه فما","يضنّ بالوصلِ من مهارقه",8,"ه",1,0],["أُنضِجَ القبحُ فيك جد","داً وما أُنضج المَشَجْ",9,"ج",1,0],["انضوا القديم وبالجديد توشحوا","حتام تختالون في الاطمار",10,"ر",1,0],["إن ضقت يا دارنا الدنيا بنا أملا","في دارِنا الخلد آمال بلا عدد",11,"د",1,0],["إِن ضاقَ ظَهرُ الأَرضِ عَنكَ فَبَطنُها","عَمّا وَراءَكَ مِن رُفاتٍ أَضيَقُ",12,"ق",1,0],["أَنْضاءُ طَلّتْ دَمْعَهم أَطْلالُهُمْ","فتخالُهُمْ بينَ الرُّسُومِ رُسُوما",13,"م",2,1],["إن ضاقَ خُطَّةُ حالي لم يضِقْ خُلُقي","أو قصَّرَ المالُ لم تقصُرْ له هممي",14,"م",2,0],["إنْ ضَنَّ غيثٌ أو جنَى قمرٌ","فيمينُه وجبينُه البَدَلُ",15,"ل",1,0],["أَنضى اليك الجُرْدَ يجشِمُها الفلا","عَجِلاً وخاضَ البِيدَ يطوِيها السُّرى",16,"ر",2,0],["إِن ضَربَ العِدا بِأَبيضَ يُرضي","سَيِّداً قادراً وَيُشفي غَليلا",17,"ل",2,0],["إِن ضاعَ ثارُكَ بَينَ آلِ مَحاسِنٍ","تِلكَ المَحاسِنُ كُلَّهُنَّ عُيوبُ",18,"ب",1,0],["إن ضاق خطوُ عبوس الأسد من جزَع","مَشَى إليه فسيحَ الخطو مبتسما",19,"م",2,0],["إِن ضَنَّ بِالجودِ مَقبوضُ اليَدَينِ سَخا","وَإِن عَتا ظالِمٌ في مُلكِهِ رَفَقا",20,"ق",2,0],["أَنضَيتُ في هَذا الأَنامِ تَجارِبي","وَبَلَوتُهُم بِمُفَحَّصاتِ مَذاهِبي",21,"ب",2,1],["أَنضَرَت أَيكَتي عَطاياكَ حَتّى","صارَ ساقاً عودي وَكانَ قَضيبا",22,"ب",2,0],["أَنُضِيعُ ما تركوا لنا ونخونُهم","لسنا إذَنْ مِمّن يخاف العارا",23,"ر",2,0],["أنضَجتَ نفسَكَ غَيظاً","فاليومَ تُنضِجُ جِلْدَكْ",24,"ك",1,0],["إن ضاق صَدْرُكَ حِينَ تُذكرُ أُمُّهُ","فلصدرها لو كنت تعلم أرحبُ",25,"ب",1,0],["إن ضمَّهم عند الشَهادةِ مَورِدٌ","لَذَّ المذاقُ لهم وطابَ المطعم",26,"م",1,0],["إِن ضَلَّ غَيرُكَ وَهُوَ أَكثَرُ ناصِراً","وَنَهَضتَ لِلإِسلامِ وَحدَكَ مُظهَرا",27,"ر",2,0],["أَنضاءِ كَأسٍ إِذا ما اللَيلُ جَنَّهُمُ","ساقَتهُمُ نَحوَها سَوقاً بِإِزعاجِ",28,"ج",1,0],["أَنضَيتِ أَحرُفَ لا مِمّا لَهَجتُ بِها","فَحُقَّ لي رِحلَةٌ مِنها إِلى نَعَمِ",29,"م",1,1],["إِن ضاقَ عَفوُكَ وَهوَ ذو سِعَةٍ","عَنّي فَلَيسَ بِواسِعٍ عَفوُ",30,"و",1,0],["أنضجتْ نارُ النَّوى كَبِدي","وَدُمُوعي تُطفِئُ النَّارا",31,"ر",2,0],["إن ضمهم نادى الحضور تنقلوا","من ذكر إسطورٍ إلى إسطور",32,"ر",1,0],["إنَّ ضلوعاً تحتمي في ضلوع","مقادرٌ ليس بها من رجوع",33,"ع",1,0],["إنْ ضجَّ في الأغلالِ منهم طليحْ","أخرسهُ السوطُ الذي يُرهفُ",34,"ف",1,0],["أَنْضَبَ مَاءُ عَيْنِهِ مِمَّا بِكَى","نَجْلَيْهِ حَتَّى قَلْبُهُ تَصَبَّبَا",35,"ب",2,0],["أَنْضَرْ بَنَبْتِكَ يَا جَنَانُ وَحَبَّذَا","هَذِي الغُصُونُ وَهَذِهِ الأَزْهَارُ",36,"ر",1,0],["إن ضاع يومي، ما أسفت على","خضر الربيع وزرقة الجلد",37,"د",1,0],["إن ضجَّ من آبٍ وحَرِّ وَثاقِهِ","فاليومَ يَدْرُجُ ما يشاءُ ويَخْطِر",38,"ر",1,0],["إن ضللت الشفاءَ في كلِّ وادٍ","كانَ «ياسينُ» بالشفاء ضمينا",39,"ن",2,0],["إن ضاق في أقدامنا، فلعلَّه","قد كان في قَدَميْ «لُويسٍ» أضيَقَا",40,"ق",2,0],["أنضاء أفيح إن ظلوا وإن ظمئوا","شاموا الندى واستبدلوا البيض والأملا",41,"ل",2,0],["إِن ضَلت الضيفان عَن أَبوابِهِ","يَهديهم لِسَبيلِهِ الإِكرام",42,"م",1,0],["إن ضرب الذهر بيننا فلقد","لف كما كان قبل شملي به",43,"ب",2,0],["أنضِى وأعمِلُ فِيهَا نَصَّ يَعمُلَةٍ","حَرٍ أن أنضُيَهَا فِيهَا وأُعمِلَهَا",44,"ل",3,0],["إن ضحِك البرقُ من الحَزْنِ رنا","أو فاحت الريحُ من الغَور نشِقْ",45,"ق",1,0],["إِن ضَيَّعوا الحَزمَ لَمّا نازَلوا حَلَبا","فَقَد أَصابوهُ لَمّا أَزمَعوا هَرَبا",46,"ب",2,0],["إِن ضَرَّهُم بُعدي بِظاهِرِ أَمرِهِ","فَلَرُبَّما ضَرَّ الزَمانُ لِيَنفَعا",47,"ع",2,0],["أَنضَيتُها بَعدَ المِراحِ إِلى امرِئ","جَلدِ القوى في كُلِّ ساعَة مَحبِسِ",48,"س",1,0],["أَنضاهُ محمل وَجدٍ لَم يَدَع أَسَفاً","إِلّا بَقايا ضُلوعٍ جاءَ يُبريها",49,"ي",3,0],["أنضَوْا شفارَهُمُ الصقيلة دونَهُ","حتى حَسِبْنا أنها أشفاره",50,"ر",2,0],["أنضجتهُ بالحبِّ حتى إذا ما","بلغَ النضجُ أطعمتهُ الأعادي",51,"د",2,0],["إن ضحكَ القومُ على بعضهمْ","فسوفَ يبكونَ على رمسِهِ",52,"ه",1,1],["إن ضقتَ بالعُسرِ فلا تَبْتَئِسْ","فربَّما دلَّ على ضِدَّهِ",53,"د",2,1],["أَنضِ ثَوبَ السُرى فَفي القَصرِ مِن بَغ","داذَ خِرقٌ لَهُ السَماحَةُ دينُ",54,"ن",1,0],["إِن ضَلَّ في الرَأيِ مَعشَرٌ فَلَهُ","نَهجٌ مِنَ الحَقِّ واضِحٌ جَدَدُ",55,"د",1,0],["ان ضاق بي وَبك الخناق فَلَم يضق","عَني وَعنك عَريض جاه محمد",56,"د",1,0],["إن ضاعَ قَلْبِي فَأينَ أطلُبُه","أوْ ذاعَ حُبّي فأنْتَ مُوجبُهُ",57,"ب",2,1],["إِنَّ ضِدَّ النِسيانِ تَصحيفُ حُبّي","لغُزي فيهِ واضِحُ البُرهانِ",58,"ن",1,0],["إِن ضِقتَ ذَرعاً بِأَقوامٍ سَواسِيَةٍ","فَما الكَريمُ بِأَن يُؤذى بِمُحتَمِلِ",59,"ل",1,0],["أَنضو اللَيالي وتَنضوني منادمةً","وما قرعتُ بها سنّاً من النَدمِ",60,"م",1,0],["إن ضَللتَ السَبيلَ في غَسَق","فبِمِشكاةِ نورها تَهديك",61,"ك",1,0],["إِن ضَلَّ مَن أَمَّ لَيلاً سوحَ حضرته","هداه من نَشره الذاكي فوائحُهُ",62,"ح",2,0],["إنْ ضقت ذرعاً بأمر في محبتِها","نبهْ له (بدرَ داغستان) ثم نم",63,"م",1,0],["إِن ضاعَ ذِكرك بيننا عن سلوةٍ","فَله بِأرجاءِ السماء تضوّعُ",64,"ع",1,0],["إن ضاحكوا دهرهم باريتهم فرحا","ورحت اشدو هنى القلب والبال",65,"ل",1,0],["إن ضحكن يقطرن سماً زعافاً","والابتسامات عندهن سلاح",66,"ح",1,0],["أَنضَيْتُ هِرَّتيَ الغَضْبى وَجِدْياني","وَأَهلَ بَيتي وَأَضيافي وَجِيراني",67,"ن",2,1],["أنضاءَ أسفارٍ لنا","أَفنَى عرائكَهنَّ ضُمر",68,"ر",1,0],["إِن ضاقَ بي بَلَدٌ فَما","ضاقَ الكَريمُ بِشَدِّ رَحلِه",69,"ل",2,0],["إِنَّ ضَربَ الحَديدِ ما كانَ إِلّا","حينَ أَبدى ليناً لِحَرِّ اللَهيبِ",70,"ب",1,0],["إن ضاعَ قَصدي لكم فكَم سَفرٍ","ضاعَ بِتنِّيسَ من مسافِرِه",71,"ه",1,1],["أَنضى الَّذي طَلَب الكِرام مِطية","وَانبث بَينَ رَواسم وَرُسوم",72,"م",1,0],["أَنضاء أَشواق لَما قَد شَفهم","وَصَلوا عُرى الآساد بِالآساد",73,"د",1,0],["أَنضو جَديدَ مَلبَسٍ","مُعتاضَ خَلقانٍ سَمِل",74,"ل",1,0],["إن ضَعُفْنا في عصرنا فلأنَّا","قد ركنَّا للغرب أقسى رُكونِ",75,"ن",1,0],["إن ضعُفَتْ عن حملِ ثِقلِي رجْلِي","ورَابَني عِثارُها في السَّهلِ",76,"ل",1,0],["أنضَى الوجيفُ رِكابَه وجيادَه","فكأنَّهُنَّ قلائدُ الأعناقِ",77,"ق",1,0],["أنضيتَ للعمران فُلْكَ همَّةٍ","فَعَمَّرت كلَّ مكانٍ داثر",78,"ر",1,0],["إن ضاء بدر علائه في منزل","تزهو مطالعه سناً ومواقفُ",79,"ف",1,0],["إن ضلّ ابن شهابٍ من اجرتَ دحى","تهديهِ نسبتك الغراء في الظلمِ",80,"م",1,0],["أنضيتُ أفراسي وأجهدت بها","روحي وعبدي عند مساريَ أبق",81,"ق",1,0],["إِن ضاقَ عن مرِّها رَحْبُ الفضاءِ فقد","نَفِذْتَ من قَلبِهِ فِيهَا إِلَى كَبدِهْ",82,"د",2,0],["أَنْضَيْتُ خَيْلِي فِي الهوى وَرِكَابِي","وَعَمَرْتُ كَأْسَ صِباً بِكَأْسِ نِصابِ",83,"ب",1,1],["إن ضاع عمرَ في طُغيانَ من نشدوا","ذلِّي فلي من كفاحي الحرِّ عمرانِ",84,"ن",1,0],["إن ضلَّت الآراءُ باجتماعها","كفَتْك آراؤك بانفرادِها",85,"د",3,0],["أنضيتُ شُكركما لفْظاً ومُعتقداً","فكل جارحةٍ مني بذاكَ فَمُ",86,"م",1,0],["انضنى الركائبَ والجفونَ إلى العلى","أولى بمن عشق العلى أن يسهدا",87,"د",2,0],["إن ضاقت الآفاق عن ذي فاقةٍ","فلهُ سبيلٌ من نوالك مهيع",88,"ع",1,0],["أنضاهمُ همُّ النَّصار وجمعهِ","وعناك من همّ المكارم ما عنى",89,"ن",2,0],["إِن ضَحِكَ الجُلَّنارُ مِنها","أَراكَ ثَغراً مِنَ الأَقاحي",90,"ي",1,0],["أنضيتُ فيه الناعجاتِ فِانْ وفَتْ","كَفلَتْ تلاقينا العتاقُ الضمَّرُ",91,"ر",1,0],["اِنْ ضنَّتِ السُّحْبُ جادَتْها غمائمُه","أو أمسكَ القطرُ أمسى وهو مُنْدَفِعُ",92,"ع",1,0],["أُنضي الرِكابَ عَلى مَكارِهِها","بِزَفيفِ بَينَ المَشيِ وَالوَضعِ",93,"ع",1,0],["إن ضاءَ منهُ فِرِندُهُ فاحذَر غِرا","رَهُ غاضِباً لِلدِّينِ فَهوَ حُسامُ",94,"م",1,0],["إن ضاءَ منه فِرندُه فاحذر غُضو","نَ حِدِّه فهو الحُسامُ الباترُ",95,"ر",1,0],["ان ضاق بي الحال يوما فانتفى جلدي","زاوجت فيه مديحي فانتفى ألمي",96,"م",2,0]]}