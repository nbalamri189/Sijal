مولانا","https://www.poetsgate.com/ViewPoem.aspx?id=190435",""],[5129,"مولاي","https://www.poetsgate.com/ViewPoem.aspx?id=120619",""],[5147,"من عاذلي ومن البلية","https://www.poetsgate.com/ViewPoem.aspx?id=166725",""],[5183,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=185639",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5183,"الدويّ الحيران","https://www.poetsgate.com/ViewPoem.aspx?id=180175",""],[5232,"العاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=211570",""],[5281,"درب الاقدار","https://www.poetsgate.com/ViewPoem.aspx?id=199271",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5376,"مهما بلغْتَ من هوانِ الدنا","https://www.poetsgate.com/ViewPoem.aspx?id=194866",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5431,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=183051",""],[5433,"سمها","https://www.poetsgate.com/ViewPoem.aspx?id=36233",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5447,"بردة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=208371",""],[5457,"إن ضاقت الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213335",""],[5464,"سبايا","https://www.poetsgate.com/ViewPoem.aspx?id=36084",""],[5484,"هذي الطلول فقف بنا يا ساري","https://www.poetsgate.com/ViewPoem.aspx?id=206304",""],[5490,"وقفت بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=176378",""],[5525,"يا حابس النور","https://www.poetsgate.com/ViewPoem.aspx?id=7273",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5612,"مكاشفة","https://www.poetsgate.com/ViewPoem.aspx?id=185750",""],[5821,"الروح للروح","https://www.poetsgate.com/ViewPoem.aspx?id=113758",""],[5829,"يا ضيعة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=152676",""],[5850,"إنَّ ضباعَ ابتكرتْ على سفرْ","https://www.poetsgate.com/ViewPoem.aspx?id=14112",""],[5929,"وتكاد تمطرنا السماء...","https://www.poetsgate.com/ViewPoem.aspx?id=202655",""],[5956,"مارستُ حُبك بالقصائد","https://www.poetsgate.com/ViewPoem.aspx?id=182610",""],[5956,"شمس وغيم","https://www.poetsgate.com/ViewPoem.aspx?id=183187",""],[5956,"بهدْي العقل","https://www.poetsgate.com/ViewPoem.aspx?id=184521",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6019,"حَفَاوَةُ اللِّقاءِ الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212920",""],[161,"شهادة ميلاد آدم","https://www.poetsgate.com/ViewPoem.aspx?id=175568",""],[186,"يا أربع الخيف يسقي الماء واديها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55807&r=&rc=70",""],[6259,"طرقت خيالاً بعد طول صدودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59364&r=&rc=12",""],[2220,"أنض الركاب إلى ربِّ السموات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11229&r=&rc=103",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""]],"verses":[["أَنضَيتُ سِتّاً وَعَشراً ما قَضَيتُ بِها","سِوى المُنى وَطَراً إِلّا مِنَ الأَدَبِ",0,"ب",1,0],["أَنضَيتِ عَيشَكِ عِفَّةً وَزَهادَةً","وَطُرِحتِ مُثقَلَةً مِنَ الأَعباءِ",1,"ا",2,0],["أنْضاءِ أفْيَحَ إنْ ضلّوا وإنْ ظمِئوا","شامُوا النّدى واسْتَدلّوا البيضَ والأسَلا",2,"ل",2,0],["أَنضَيتُها بَعدَما طالَ الهِبابُ بِها","تَأُمَّ هَوذَةَ لا نِكساً وَلا وَرَعا",3,"ع",2,0],["إِن ضاقَ صَدرُ النيلِ عَمّا هالَهُ","يَومَ الحَمامِ فَإِنَّ صَدرَكَ أَرحَبُ",4,"ب",1,0],["إِن ضاقَ مَيدانُ سَبقٍ مِن عَزائِمِهِم","صاحَت بِهِم فَأَرَوها أَلفَ مَيدانِ",5,"ن",1,0],["أَنْضَبَ الْبُؤْسِ ذِهْنَهُ فَعَرَاهُ","شِبْهُ عُقْمٍ وَلَمْ يَكُنْ بِعَقِيمِ",6,"م",1,0],["أَنَضيرَ ما بَيني وَبَينَكُمُ","صُرَمٌ وَما أَحدَثتُ مِن هَجرِ",7,"ر",1,0],["إن ضنَّ بالوصلِ من لقاه فما","يضنّ بالوصلِ من مهارقه",8,"ه",1,0],["أُنضِجَ القبحُ فيك جد","داً وما أُنضج المَشَجْ",9,"ج",1,0],["انضوا القديم وبالجديد توشحوا","حتام تختالون في الاطمار",10,"ر",1,0],["إن ضقت يا دارنا الدنيا بنا أملا","في دارِنا الخلد آمال بلا عدد",11,"د",1,0],["إِن ضاقَ ظَهرُ الأَرضِ عَنكَ فَبَطنُها","عَمّا وَراءَكَ مِن رُفاتٍ أَضيَقُ",12,"ق",1,0],["أَنْضاءُ طَلّتْ دَمْعَهم أَطْلالُهُمْ","فتخالُهُمْ بينَ الرُّسُومِ رُسُوما",13,"م",2,1],["إن ضاقَ خُطَّةُ حالي لم يضِقْ خُلُقي","أو قصَّرَ المالُ لم تقصُرْ له هممي",14,"م",2,0],["إنْ ضَنَّ غيثٌ أو جنَى قمرٌ","فيمينُه وجبينُه البَدَلُ",15,"ل",1,0],["أَنضى اليك الجُرْدَ يجشِمُها الفلا","عَجِلاً وخاضَ البِيدَ يطوِيها السُّرى",16,"ر",2,0],["إِن ضَربَ العِدا بِأَبيضَ يُرضي","سَيِّداً قادراً وَيُشفي غَليلا",17,"ل",2,0],["إِن ضاعَ ثارُكَ بَينَ آلِ مَحاسِنٍ","تِلكَ المَحاسِنُ كُلَّهُنَّ عُيوبُ",18,"ب",1,0],["إن ضاق خطوُ عبوس الأسد من جزَع","مَشَى إليه فسيحَ الخطو مبتسما",19,"م",2,0],["إِن ضَنَّ بِالجودِ مَقبوضُ اليَدَينِ سَخا","وَإِن عَتا ظالِمٌ في مُلكِهِ رَفَقا",20,"ق",2,0],["أَنضَيتُ في هَذا الأَنامِ تَجارِبي","وَبَلَوتُهُم بِمُفَحَّصاتِ مَذاهِبي",21,"ب",2,1],["أَنضَرَت أَيكَتي عَطاياكَ حَتّى","صارَ ساقاً عودي وَكانَ قَضيبا",22,"ب",2,0],["أَنُضِيعُ ما تركوا لنا ونخونُهم","لسنا إذَنْ مِمّن يخاف العارا",23,"ر",2,0],["أنضَجتَ نفسَكَ غَيظاً","فاليومَ تُنضِجُ جِلْدَكْ",24,"ك",1,0],["إن ضاق صَدْرُكَ حِينَ تُذكرُ أُمُّهُ","فلصدرها لو كنت تعلم أرحبُ",25,"ب",1,0],["إن ضمَّهم عند الشَهادةِ مَورِدٌ","لَذَّ المذاقُ لهم وطابَ المطعم",26,"م",1,0],["إِن ضَلَّ غَيرُكَ وَهُوَ أَكثَرُ ناصِراً","وَنَهَضتَ لِلإِسلامِ وَحدَكَ مُظهَرا",27,"ر",2,0],["أَنضاءِ كَأسٍ إِذا ما اللَيلُ جَنَّهُمُ","ساقَتهُمُ نَحوَها سَوقاً بِإِزعاجِ",28,"ج",1,0],["أَنضَيتِ أَحرُفَ لا مِمّا لَهَجتُ بِها","فَحُقَّ لي رِحلَةٌ مِنها إِلى نَعَمِ",29,"م",1,1],["إِن ضاقَ عَفوُكَ وَهوَ ذو سِعَةٍ","عَنّي فَلَيسَ بِواسِعٍ عَفوُ",30,"و",1,0],["أنضجتْ نارُ النَّوى كَبِدي","وَدُمُوعي تُطفِئُ النَّارا",31,"ر",2,0],["إن ضمهم نادى الحضور تنقلوا","من ذكر إسطورٍ إلى إسطور",32,"ر",1,0],["إنَّ ضلوعاً تحتمي في ضلوع","مقادرٌ ليس بها من رجوع",33,"ع",1,0],["إنْ ضجَّ في الأغلالِ منهم طليحْ","أخرسهُ السوطُ الذي يُرهفُ",34,"ف",1,0],["أَنْضَبَ مَاءُ عَيْنِهِ مِمَّا بِكَى","نَجْلَيْهِ حَتَّى قَلْبُهُ تَصَبَّبَا",35,"ب",2,0],["أَنْضَرْ بَنَبْتِكَ يَا جَنَانُ وَحَبَّذَا","هَذِي الغُصُونُ وَهَذِهِ الأَزْهَارُ",36,"ر",1,0],["إن ضاع يومي، ما أسفت على","خضر الربيع وزرقة الجلد",37,"د",1,0],["إن ضجَّ من آبٍ وحَرِّ وَثاقِهِ","فاليومَ يَدْرُجُ ما يشاءُ ويَخْطِر",38,"ر",1,0],["إن ضللت الشفاءَ في كلِّ وادٍ","كانَ «ياسينُ» بالشفاء ضمينا",39,"ن",2,0],["إن ضاق في أقدامنا، فلعلَّه","قد كان في قَدَميْ «لُويسٍ» أضيَقَا",40,"ق",2,0],["ان ضرابا بالصفاح خطة","ترد ما فات وترسي ما هفا",41,"ا",1,0],["أنضاهم التسبيح والترتيل","والتهجيد بين جوانح الأسحار",42,"ر",1,0],["أنضاء أفيح إن ظلوا وإن ظمئوا","شاموا الندى واستبدلوا البيض والأملا",43,"ل",2,0],["إِن ضَلت الضيفان عَن أَبوابِهِ","يَهديهم لِسَبيلِهِ الإِكرام",44,"م",1,0],["إن ضرب الذهر بيننا فلقد","لف كما كان قبل شملي به",45,"ب",2,0],["أنضِى وأعمِلُ فِيهَا نَصَّ يَعمُلَةٍ","حَرٍ أن أنضُيَهَا فِيهَا وأُعمِلَهَا",46,"ل",3,0],["إن ضحِك البرقُ من الحَزْنِ رنا","أو فاحت الريحُ من الغَور نشِقْ",47,"ق",1,0],["إِن ضَيَّعوا الحَزمَ لَمّا نازَلوا حَلَبا","فَقَد أَصابوهُ لَمّا أَزمَعوا هَرَبا",48,"ب",2,0],["إِن ضَرَّهُم بُعدي بِظاهِرِ أَمرِهِ","فَلَرُبَّما ضَرَّ الزَمانُ لِيَنفَعا",49,"ع",2,0],["أَنضَيتُها بَعدَ المِراحِ إِلى امرِئ","جَلدِ القوى في كُلِّ ساعَة مَحبِسِ",50,"س",1,0],["أَنضاهُ محمل وَجدٍ لَم يَدَع أَسَفاً","إِلّا بَقايا ضُلوعٍ جاءَ يُبريها",51,"ي",3,0],["أنضَوْا شفارَهُمُ الصقيلة دونَهُ","حتى حَسِبْنا أنها أشفاره",52,"ر",2,0],["أنضجتهُ بالحبِّ حتى إذا ما","بلغَ النضجُ أطعمتهُ الأعادي",53,"د",2,0],["إن ضحكَ القومُ على بعضهمْ","فسوفَ يبكونَ على رمسِهِ",54,"ه",1,1],["إن ضقتَ بالعُسرِ فلا تَبْتَئِسْ","فربَّما دلَّ على ضِدَّهِ",55,"د",2,1],["أَنضِ ثَوبَ السُرى فَفي القَصرِ مِن بَغ","داذَ خِرقٌ لَهُ السَماحَةُ دينُ",56,"ن",1,0],["إِن ضَلَّ في الرَأيِ مَعشَرٌ فَلَهُ","نَهجٌ مِنَ الحَقِّ واضِحٌ جَدَدُ",57,"د",1,0],["ان ضاق بي وَبك الخناق فَلَم يضق","عَني وَعنك عَريض جاه محمد",58,"د",1,0],["إن ضاعَ قَلْبِي فَأينَ أطلُبُه","أوْ ذاعَ حُبّي فأنْتَ مُوجبُهُ",59,"ب",2,1],["إِنَّ ضِدَّ النِسيانِ تَصحيفُ حُبّي","لغُزي فيهِ واضِحُ البُرهانِ",60,"ن",1,0],["إِن ضِقتَ ذَرعاً بِأَقوامٍ سَواسِيَةٍ","فَما الكَريمُ بِأَن يُؤذى بِمُحتَمِلِ",61,"ل",1,0],["أَنضو اللَيالي وتَنضوني منادمةً","وما قرعتُ بها سنّاً من النَدمِ",62,"م",1,0],["إن ضَللتَ السَبيلَ في غَسَق","فبِمِشكاةِ نورها تَهديك",63,"ك",1,0],["إِن ضَلَّ مَن أَمَّ لَيلاً سوحَ حضرته","هداه من نَشره الذاكي فوائحُهُ",64,"ح",2,0],["إنْ ضقت ذرعاً بأمر في محبتِها","نبهْ له (بدرَ داغستان) ثم نم",65,"م",1,0],["إِن ضاعَ ذِكرك بيننا عن سلوةٍ","فَله بِأرجاءِ السماء تضوّعُ",66,"ع",1,0],["إن ضاحكوا دهرهم باريتهم فرحا","ورحت اشدو هنى القلب والبال",67,"ل",1,0],["إن ضحكن يقطرن سماً زعافاً","والابتسامات عندهن سلاح",68,"ح",1,0],["أَنضَيْتُ هِرَّتيَ الغَضْبى وَجِدْياني","وَأَهلَ بَيتي وَأَضيافي وَجِيراني",69,"ن",2,1],["أنضاءَ أسفارٍ لنا","أَفنَى عرائكَهنَّ ضُمر",70,"ر",1,0],["إِن ضاقَ بي بَلَدٌ فَما","ضاقَ الكَريمُ بِشَدِّ رَحلِه",71,"ل",2,0],["إِنَّ ضَربَ الحَديدِ ما كانَ إِلّا","حينَ أَبدى ليناً لِحَرِّ اللَهيبِ",72,"ب",1,0],["إن ضاعَ قَصدي لكم فكَم سَفرٍ","ضاعَ بِتنِّيسَ من مسافِرِه",73,"ه",1,1],["أَنضى الَّذي طَلَب الكِرام مِطية","وَانبث بَينَ رَواسم وَرُسوم",74,"م",1,0],["أَنضاء أَشواق لَما قَد شَفهم","وَصَلوا عُرى الآساد بِالآساد",75,"د",1,0],["أَنضو جَديدَ مَلبَسٍ","مُعتاضَ خَلقانٍ سَمِل",76,"ل",1,0],["إن ضَعُفْنا في عصرنا فلأنَّا","قد ركنَّا للغرب أقسى رُكونِ",77,"ن",1,0],["إن ضعُفَتْ عن حملِ ثِقلِي رجْلِي","ورَابَني عِثارُها في السَّهلِ",78,"ل",1,0],["أنضَى الوجيفُ رِكابَه وجيادَه","فكأنَّهُنَّ قلائدُ الأعناقِ",79,"ق",1,0],["أنضيتَ للعمران فُلْكَ همَّةٍ","فَعَمَّرت كلَّ مكانٍ داثر",80,"ر",1,0],["إن ضاء بدر علائه في منزل","تزهو مطالعه سناً ومواقفُ",81,"ف",1,0],["إن ضلّ ابن شهابٍ من اجرتَ دحى","تهديهِ نسبتك الغراء في الظلمِ",82,"م",1,0],["أنضيتُ أفراسي وأجهدت بها","روحي وعبدي عند مساريَ أبق",83,"ق",1,0],["إِن ضاقَ عن مرِّها رَحْبُ الفضاءِ فقد","نَفِذْتَ من قَلبِهِ فِيهَا إِلَى كَبدِهْ",84,"د",2,0],["أَنْضَيْتُ خَيْلِي فِي الهوى وَرِكَابِي","وَعَمَرْتُ كَأْسَ صِباً بِكَأْسِ نِصابِ",85,"ب",1,1],["إن ضاع عمرَ في طُغيانَ من نشدوا","ذلِّي فلي من كفاحي الحرِّ عمرانِ",86,"ن",1,0],["إن ضلَّت الآراءُ باجتماعها","كفَتْك آراؤك بانفرادِها",87,"د",3,0],["أنضيتُ شُكركما لفْظاً ومُعتقداً","فكل جارحةٍ مني بذاكَ فَمُ",88,"م",1,0],["انضنى الركائبَ والجفونَ إلى العلى","أولى بمن عشق العلى أن يسهدا",89,"د",2,0],["إن ضاقت الآفاق عن ذي فاقةٍ","فلهُ سبيلٌ من نوالك مهيع",90,"ع",1,0],["أنضاهمُ همُّ النَّصار وجمعهِ","وعناك من همّ المكارم ما عنى",91,"ن",2,0],["إِن ضَحِكَ الجُلَّنارُ مِنها","أَراكَ ثَغراً مِنَ الأَقاحي",92,"ي",1,0],["أنضيتُ فيه الناعجاتِ فِانْ وفَتْ","كَفلَتْ تلاقينا العتاقُ الضمَّرُ",93,"ر",1,0],["اِنْ ضنَّتِ السُّحْبُ جادَتْها غمائمُه","أو أمسكَ القطرُ أمسى وهو مُنْدَفِعُ",94,"ع",1,0],["أُنضي الرِكابَ عَلى مَكارِهِها","بِزَفيفِ بَينَ المَشيِ وَالوَضعِ",95,"ع",1,0],["إن ضاءَ منهُ فِرِندُهُ فاحذَر غِرا","رَهُ غاضِباً لِلدِّينِ فَهوَ حُسامُ",96,"م",1,0],["إن ضاءَ منه فِرندُه فاحذر غُضو","نَ حِدِّه فهو الحُسامُ الباترُ",97,"ر",1,0],["ان ضاق بي الحال يوما فانتفى جلدي","زاوجت فيه مديحي فانتفى ألمي",98,"م",2,0],["إن ضاقت في جيد الأشعار وصفكم","فإننا لنداء الفدي نستبق",99,"ق",1,0],["إن ضاقَ بي وَطَنُ المِخلافِ أو جَهِلَت","أهلُوهُ حَقّي فَفي الآفاقِ مُتَّسَعُ",100,"ع",1,0],["ان ضاق للدهر في أَوصافهم فم","فَعاذر في ثناها ان يضيق فمي",101,"م",2,0],["إن ضرج البطحاءَ يوم تمردوا","دمُهم فأنت لذلك الدمِ غاسل",102,"ل",1,0],["إِنْ ضِقتَ ذَرعاً فَاِصطَبِرْ","فَالصّبرُ فيهِ يُنْجَحُ",103,"ح",1,1],["إن ضنَّ جفنك أن يجود بمائه","فالقلب موقوف على برحائهِ",104,"ا",3,1],["إن ضجر المنعمون أو سئموا","أعطى بلا ضجرة ولا سامِ",105,"م",1,0],["إن ضحك الناس من مديح","رأيته منه في شهيقِ",106,"ق",1,0],["إنْ ضَلَّلَ القَلْبَ دَاجِي شَعْرِهِ فَلَكَمْ","أهْدَى الهَوَى لعُيُونِي بدرُ طَلْعَتِهِ",107,"ت",2,0],["إنْ ضَلَّ قَلْبُ الصبّ فِيهِ بِشَعْرِهِ","فَلَقَدْ هَدَتْهُ الطَّلْعَةُ الغَرَّاءُ",108,"ا",2,0],["إن ضاق صدرك فاقصد","جدّ الجواد محمد",109,"د",1,1],["إِن ضاقَتِ الدُنيا عَلَيكَ بِفَجعَةٍ","نَزَلَ الأَسى مَعَها فَصَدرُكَ أَوسَعُ",110,"ع",1,0],["ان ضلّت الوفاد قال تودداً","ولقد انار لها مناهجها اسلكي",111,"ك",2,0],["إِنْ ضَيَّقَ الدَّهْرُ خِناقي فما","تَضيقُ بي رحمتُكَ الواسِعَهْ",112,"ع",2,0],["ان ضعفي ما قط يخفاك يا من","فضاء في الوجود والكون ساري",113,"ر",2,0],["إن ضل حنانك عن قلبي","فلهيب ضلوعي ترشده",114,"د",2,0],["إن ضاقت الأرض","فبطنها أستر",115,"ر",1,0],["انضآءُ سيْرٍ على الأنضآء تحْسَبُهُم","بين الفلا في الدُّجَى جنّانَ برهوتِ",116,"ت",1,0],["إن ضاق مذهبنا أو حلّ ساحتنا","ضنكٌ وأزمٌ فعند الفضل متّسع",117,"ع",1,0],["إن ضاعَ وِترُكَ يا بن حامي الدين","لا قال سيفُك للمنايا كوني",118,"ن",2,1],["إن ضلَّلتهم سماء النقع يوم وغًى","كانت وجوههم في لَيلها سُرجا",119,"ج",2,0],["إن ضمني بيت يضم مبرطلاً","لا ضمّني من أوج فضلك جوسق",120,"ق",1,0],["أنضرب رأس بنت البيت سرّاً","ورأس القرم نضربه جهارا",121,"ر",2,0],["إِن ضَنْ هامي المُزْن جادا أَو دَجا","ليلُ الحوادثِ والخطوب أَضاءا",122,"ا",2,0],["أَنضى هواك شبيبَتي وَذوى به","عودي له وَعَريتُ من ورقي بِه",123,"ب",2,0],["إن ضلَّ عن طرق العلياء سالكها","فعزمه ونداه النار والعلم",124,"م",1,0],["أنضيت من قطع الأكام كُومها","عُنْفاً فلا يَرْدَعُك المُعَنِّف",125,"ف",1,0],["أنضى الركاب إلى ربِّ السموات","وانبذ عن القلبِ أطوارَ الكراماتِ",126,"ت",1,1],["إن ضاق ظرفُ الدهرِ عن عينكم","فلم يضقْ عن عينكم صدري",127,"ر",2,0],["أنضاه نص سرى وهاجرة","حتى تسرى المني والنحض",128,"ض",1,0],["إن ضَامَنِي دَهرِي لِبَابِك أقَرعُ","وألوذُ بعفوك والرجا منك أطمَعُ",129,"ع",1,1],["إن ضل ركب الرجا يوماً بمجهله","إلى حماه لسان النار يهديه",130,"ي",2,0],["أَنضَجتُ كَيَّتُهُ فَظَلَّ منكِّساً","وسطَ النَديِّ كَأَنَّه مأمومُ",131,"م",1,0],["إن ضاع إحساني وحسن تجملي","فيهم فعند اللَه خير جزائي",132,"ي",1,0],["إن ضِقنَ عَن سِتَّه أصَابِع في النَّظَر","أنتَ على مَلكِي فَتَاكَ المَطَر",133,"ر",1,0],["إن ضامني بالظلم لحظك وسام","فقد سباني جيد سامي",134,"ي",1,0],["إِن ضَيفاً قاصِداً قُل","تَ لَهُ أَهلاً وَسَهلا",135,"ل",2,0],["إن ضقت يا صاح فيمم حيه","وانزل فثم منزل رحيب",136,"ب",1,0],["إن ضاق وافي الدرع منه بمنكب","ضخم فصدر العزم منه رحيب",137,"ب",1,0],["إن ضاع نعل فتى فهم نعل له","أو ينفتق كانوا لديه رقاعا",138,"ع",2,0],["ان ضعفي يحطني لحضيض","وفؤادي يطير بي للسماء",139,"ا",2,1],["ان ضوء النار يطفى عاجلا","هل لنا من ضوء شمس قبس",140,"س",1,0],["أنضجت روح الشعر في روحه","فاستيقظت في العقل رؤياه",141,"ا",2,0],["إن ضقت ذرعاً بما تَخشى فداحته","ففرجة الخطب مهما اشتدَّ ساحته",142,"ه",1,0],["إِن ضاقَ لي بَلَدٌ يَمَّمتُ لي بَلَداً","وَإِن نَبا مَنزِلٌ بي كانَ لي بَدَلُ",143,"ل",1,0],["ان ضيعوا ودهم فاني","على النوى حافظ لودى",144,"د",2,0],["إن ضل ساري الدجى والنجم متقد","اعدته نيرانه للمنزل الخصب",145,"ب",1,0],["إنْ ضاقَ مَسرُح ناقَتي في بلدةِ","فزِمامُها بيدي وما ضَاقَ الفَضا",146,"ض",2,0],["إن ضاعَ قَلبك فاتَّهمها أَنَّها","لِصُّ القلوبِ وَسارقُ الاكبادِ",147,"د",1,1],["انضوا عوامل عقلهم فتثلمت","واستوقفوا المبغى فزاد فرارا",148,"ر",2,0],["إن ضيّفوك لحاجةٍ","جاءوا بقيء في قُدَر",149,"ر",1,0],["أَنضتهُ شدّة بأسهِ","فَنما بها كرما وَلينا",150,"ن",2,0],["انْ ضَلَّ رأيُهم فانتَ شِهابُهم","وثِمالُهم انْ عَزَّتِ الأورَاقُ",151,"ق",1,0],["إن ضاع قدري في الأنام وماله","من رافع والعيش غير رغيد",152,"د",1,1],["ان ضلوا فيك فلا بدع ذ","قد ضلوا في عيسى أكثر",153,"ر",1,0],["أَنَضِنُّ بالذكرى على مهج","تركت لنا الدنيا وما فيها",154,"ي",3,0],["إن ضاق بالعبد حال","فذلك الضيق بشرى",155,"ر",2,1],["إن ضيف الكرام ضيف عزيز","أن كرامه عليهم وجوب",156,"ب",1,0],["إن ضامك الدهر فاستعصم بأشيح أو","أزرى بك الفقر فاستمطر بنان سبا",157,"ب",2,1],["أَنضختُ بِآطامِ المَدينَةِ أَربَعاً","وَخَمساً يُغَنّي فَوقَها اللَيلُ طائِرُ",158,"ر",1,1],["إن ضِقتَ يَوماً بِذَنبٍ","وَلَم تَكُن لَكَ حُجَّه",159,"ج",2,1],["إن ضاع شعرك في الغرام فإنما","بمديح أسعد تسعد الشعراء",160,"ا",2,0],["إن ضمّنا النسب الأثيل فإنه","ليس الغدو يقاس بالآصال",161,"ل",1,0],["إن ضيعوا الحسنى فغير عجيبة","ربما أضاع القطر واد مسبخ",162,"خ",1,0],["إِن ضَمَّنيَ التُربُ وَلَم يَشفِ جَوىً","فالوَيلُ إِذَن لِساكِنِ الأَجداثِ",163,"ث",1,0],["اِن ضَل سَعي فَهادى الصَبر يُرشِدُني","اِلى طَريقِ رَشادي وَاِستِقاماتي",164,"ت",2,0],["اِن ضاقَ بي ذَرعى اِلى مَن أَشتَكي","مِن بَعدِ فَقدِكَ كافِلا بِرِضائي",165,"ي",1,0],["إن ضاع وتر بني علي بينها","لا أرعدت أسيافكم في درع",166,"ع",1,0],["إن ضاع عرف نسميها بين الربا","فالعرف ضاع بها من الإحسان",167,"ن",1,0],["إنْ ضاقَ أَمرٌ فغيرُ هِمّتهِ","لكشفِ ضيقِ الأُمورِ لن يسعا",168,"ع",2,0],["أَنضَيتُها مِن ضُحاها أَو عَشِيَّتِها","في مُستَتَبٍّ يَشُقُّ البيدَ وَالأَكَما",169,"م",2,0],["إِن ضاقَ ذَرعٌ للفتى أفضَت بِهِ","إلى مَجالٍ للسُرُرِ قَد فَضا",170,"ا",1,0],["إن ضرّمَت نار البعاد خبالَها","أسفاً فكم منح بذاك خبالها",171,"ل",3,0],["إن ضعضع الجوْرُ قوى الأمصار","وشابَ ضعفَ العيشِ بالأكدار",172,"ر",1,0],["ان ضعتُ والشعر مما قد شهرت به","ونال جودُك أقواماً وما شعرو",173,"ر",2,0],["إن ضيَّعوا الحسنى فغير عجيبةٍ","فلقد أضاع القطرَ وادٍ مُسبخ",174,"خ",1,0],["إن ضاقت الدُنيا ففر","لله يا نعِم المفرْ",175,"ر",1,1],["إن ضاق العمر بأحزاني","أو تاه الدمع بأجفاني",176,"ن",2,1],["إن ضاقت الأرض بالأحلام في وطني","ما زال في الأفق ضوء الحلم يكتمل",177,"ل",1,0],["إن ضاق مني زماني لن أعاتبه","هل يعشق السفح من أحلامه الجبل",177,"ل",1,0],["إن ضاقت الأسباب يوما فلا","تزد على المطلوب في ما يرد",178,"د",1,0],["إن ضاقت الدنيا به وسعته (سورة الإنشراح)","لا بد من صنع الرجال ، ومثله صنع السلاح",179,"ح",1,0],["أنْضجْتُ فاكهةً لكنّها عجِفتْ","دهْراً تلاعبني كالتّلِّ والْأرْوى",180,"و",2,0],["إن ضاقتِ الدّنيا بما رحُبَت","فالفِكرُ بالتضييقِ يمتدُ",181,"د",1,0],["إن ضللتك وأوبقتك فإنها","طبعت على التمويه والطغيان",182,"ن",1,0],["أنضبتموه فعفتموه ولم يكن","من حق واردكم عقوق المورد",183,"د",1,0],["إِنْ ضَاعَ حَقٌّ وَغَابَ العَدْلُ عَنْ وَطَنِي","وَحُوكِمَ النُّورُ وَانْفَضَّتْ سَجَايَانَا",184,"ن",2,0],["إنْ ضاقَ بِي رَمْسي فبابُكَ مَقْصَدِي","إنِّي اسْتَجَرْتُ نصيريَ المَعْبودا",185,"د",2,0],["إن ضل ديمقراط فيك","فكم أمات وكم أضلا",186,"ل",2,0],["أنضبت موردكم عنكم وكم","جالدت من دونه من شربا",187,"ب",2,0],["إن ضغط الحكم الذي فرض استغ","لاله للشعوب بالبأساء",188,"ا",2,0],["أنضجته الدنيا فأينع فكراً","فأتى للنهى بكل عجيب",189,"ب",1,0],["إنْ ضمَّني فالكونُ يغدو قبلة ً","كلُّ المجرَّة والنجومُ لديهِ",190,"ي",2,0],["إِنْ ضَمَّها القَلَبْ لَا يِشبَعْ وَلا يِقْنَعْ","هَيْمَانْ مَا يِشْغَلِهْ عَنْهَا وَلا وَاحِدْ",191,"د",1,0],["إِنْ ضنَّ أَهْلٌ بِهِ زَهْواً وَ مَفْخَرَةً","فَأَهْلُنَا لَنْ يَقِلُّوا عَنْ أَهَالِيهِ",192,"ي",2,0],["إن ضاقتِ 