{"poems":[[55,"لحيا عهدهن حيا العهاد","https://www.aldiwan.net/poem30619.html","الوافر"],[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[95,"هو العيش جهد طائل وفتون","https://www.aldiwan.net/poem11186.html","الطويل"],[95,"هنيئاً أيها الملك الهمام","https://www.aldiwan.net/poem11307.html","الوافر"],[95,"لا تحقر الدرهم من مسعد","https://www.aldiwan.net/poem11340.html","السريع"],[95,"تولوا وقدر لي أن أقيما","https://www.aldiwan.net/poem11384.html","المتقارب"],[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[53,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[99,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[99,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[71,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[107,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54839","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[230,"أين سابا أين سابا يا ترى","https://www.aldiwan.net/poem55117.html","الرمل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[376,"وقف الليل والنهار وقد كان","https://www.aldiwan.net/poem57415.html","الوافر"],[409,"أقلب قلبا بعد بعدك في الجمر","https://www.aldiwan.net/poem33922.html","الطويل"],[409,"إلي أحاديث الصبابة تسند","https://www.aldiwan.net/poem33978.html","الطويل"],[415,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[422,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[466,"عجبت لحي لا تحل حباهم","https://www.aldiwan.net/poem16062.html","الطويل"],[520,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[567,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39046","الخفيف"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63884","الهزج"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77449","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56088","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27233","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137151",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205769","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58320","الرجز"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132720","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74104","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123912","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48281","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133093","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33225","الخفيف"],[5155,"الى معجزة الغناء العربي (ام كلثوم)","https://www.poetsgate.com/ViewPoem.aspx?id=176242",""],[5186,"بمحياك يا هلال العام","https://www.poetsgate.com/ViewPoem.aspx?id=156438",""],[2365,"أشاقك طائر غرد","https://www.poetsgate.com/ViewPoem.aspx?id=200645",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5444,"عروس جرونوبل","https://www.poetsgate.com/ViewPoem.aspx?id=205530",""],[5561,"الحوار السادس","https://www.poetsgate.com/ViewPoem.aspx?id=205186",""],[5616,"عهد","https://www.poetsgate.com/ViewPoem.aspx?id=203324",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[402,"ظللت لمصر وسودانها","https://www.poetsgate.com/ViewPoem.aspx?id=36311",""],[5804,"قصيدة يتكرر فيها حرف السين","https://www.poetsgate.com/ViewPoem.aspx?id=182858",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6090,"نهوضا يا شبيبتنا البواقي","https://www.poetsgate.com/ViewPoem.aspx?id=170916",""]],"verses":[["أَيَنسُبُني لَهُ ظَنٌّ غَوِيٌّ","وَكانَ الغَيُّ يَمكُرُ بِالرَشادِ",0,"د",1,0],["أَينَ سَعدٌ فَذاكَ أَوَّلُ حَفلٍ","غابَ عَن صَدرِهِ وَعافَ الخِطابا",1,"ب",2,0],["أَيَنْسَى وَفِي الأَعْقَابِ آثَارُ فَضْلِهِ","سَتَبْقَى وَمَا لِلصَّالِحَاتِ مَنُونُ",2,"ن",1,0],["أَيَنْسَى العُربُ مُنْقِذَهُمْ حُسَيْناً","وَمَا أَبْلَى بُنُوَّتُهُ العِظَامُ",3,"م",1,0],["أَيْنَ سَخَاءُ الْيَدِ تُغْنُونَهَا","بِهِ قَلِيلاً مِنْ سَخَاءِ الْفَمِ",4,"م",1,0],["أَيَنْسَى بَنُو العُرْبِ فِي كُلِّ نَادٍ","نَصِيرَهُمُ الأَرْيَحِيَّ الكَرِيمَا",5,"م",2,0],["أين سهام العيش مقسومة","وأين في الألفاظ تسهيمي",6,"م",2,0],["أين سلطانٌ عزيزٌ","لك في أرض العراق",7,"ق",1,0],["أينَ سعيٌ عهدتُه لك بِلغٌ","أتراني وافقْتُ شوطَ الكلالِ",8,"ل",1,0],["أيُنسَى تلاقينا وأنتِ حزينةٌ","ورأسُك كابٍ من عياءٍ ومن سهدِ",9,"د",1,0],["أين سُلطاني ومجدي والذي","حُبُّه مجدٌ وسلطانٌ وعِزَّه",10,"ه",1,0],["أيُنسى أذاهم للنبيِّ وبغضُهُمْ","وتكذيبُهُمْ والسمُّ في الشاةِ والسحرُ",11,"ر",1,0],["أَينسِيكمُ الدَّهرُ المَليمُ أُبُوَّةً","غطاريفَ صِيداً يبتنون المفاخرا",12,"ر",2,0],["أَيَنْسَى كرِيمٌ مِنْ بَنِي الُعْربِ فَضلَ مَا","وَقَفْتَ عَلَى تَجْديدهِ مُعْظَمَ الْعُمْرِ",13,"ر",1,0],["أَيْنَ سَامِي وَأَيْنَ صَبْرِي وَحِفْنِي","وَرِفَاقٌ جَاوَرْهُمُ فِي الهَوَادِي",14,"د",2,0],["أينسى بنو الدنيا مصارع أهلها","وفي كل قلب للمنية ميسم",15,"م",1,0],["أين ((سعد)) قالوا : رماه عشاء","مارد من (( قبا)) يسمى ((بجيره))",16,"ر",2,0],["أين سعد وعادل ورياض","ما لركب الرّدى المجدّ قفول",17,"ل",1,0],["أين سعد ؟ ولا ألوم اللّيالي","وهب الدّهر غاليا واستردّا",18,"د",2,0],["أين سابا أَين سابا يا تُرى","أَين سابا ذو المَزايا الباهِرَه",19,"ه",1,1],["أين سمع الحبيب أسكب فيه","ملء جنبي من أغان شريده",20,"ه",1,0],["أين سلطانُ مُقلتيك عَلينا","قل له ما يجوزُ في الحبِّ سحرُ",21,"ر",1,0],["أينساك قلب أنت فيه وإنما","ترحلت عن عيني وخيمت في فكري",22,"ر",2,0],["أينسى الفتى أوطانه ودياره","إذاً فهو من بين العوالم جَلْمَدُ",23,"د",1,0],["أيْن سَمعِي عمّا يقولُ العذولُ","أنا بالهَجرِ والنّوى مَشغولُ",24,"ل",1,0],["أينَ سكانُك لا كانَ النوى","أعْرَقَ البين بهم أم أشأما",25,"م",2,0],["أين سكانك لا أين هُمُ","أحجازا أقبلوها أم شآما",26,"م",2,0],["أيُنْسف قبرٌ ضمَّ مجد ابن خالدٍ","وأضْمر عِزَّاً من عُلاً ومناقِبِ",27,"ب",1,0],["أينسى وفي العينين صورة وجه","ه الكريم وعهد الانتقال قريب",28,"ب",1,0],["أين سيفي من لحظِ مَن يَقطعُ السَّيْ","فَ بلحظٍ لهُ كقَطعِ القُلامَهْ",29,"م",2,0],["أينَ سهْمٌ من نَظْرةٍ عن فُتُورِ","أينَ قَوْسٌ منْ حاجِبٍ مَقْرُونِ",30,"ن",1,0],["أين سابور أين كسرى أنو شر","وان ايه عن ابرويز العنيد",31,"د",1,0],["أَيَنْسى أخْذِيَ الكاسَ","على شوقٍ إلى كاس",32,"س",1,0],["أَيَنسى نَفيض إِيسَلي ثمّ وَجدةً","وَيَوم تَلاغٍ وَالقَنا تَتَكسّرُ",33,"ر",1,0],["أين سحبان الورى إذ ينطقُ","أين قسٌ أين أربا الحجى",34,"ج",2,0],["أين سرُّ الوصالِ بالله قل لي","منكما في الطلاق أو في النكاحِ",35,"ح",1,0],["أين سبط النَبي اصبح وترا","رزؤه في السما وفي الأرض جلا",36,"ل",2,0],["أينسى وارث الفضل المصفى","ويسلى صاحب الشرف الخطير",37,"ر",1,0],["أين سجع الهزار من صرخة البو","م صراخا يثير قلب السكون",38,"ن",1,0],["أينَ سَنكولي وطاجنة والسفا","رضي الله عنه وأينَ المزراقث والدَّبّوسُ",39,"س",1,0],["أين سباق غاية الفضل من","تقصر عنه سوابق الأوهام",40,"م",1,0],["أين سيناء من معارج قدس","جل تخصيص نيلها ان يرامها",41,"م",3,0],["أَيَنساكَ مِنّا الشوق أَو ينفدُ الجَوى","فَلا الشَوق مغنيّ وَلا الوَجد نافدُ",42,"د",1,0],["أين ساسان والسلاطين منه","ملاؤا الارض بسط علم وقدره",43,"ر",2,0],["أيُنْسبُ للبَدْرِ المُتَمّمِ نورُهُ","وقد يختفي في جَوّهِ المُتغيِّمِ",44,"م",1,0],["أينسى حسينا وهو قرة عينه","تريب المحيا قلبه قد تفطرا",45,"ر",2,0],["أينسى الفتى داع الردى وهو واصلٌ","يقيناً وهل ينسى الغريم المطالبُ",46,"ب",1,0],["أين سقمي إذاً وأين بكائي","بدني ناطقٌ ودَمعي شهيدُ",47,"د",1,0],["اين سلامة واين وحيد","ومئات منهن كن قيانا!!",48,"ن",2,0],["أين سعي الكرام في الخير","أين الرفق والبر أين بذل الكرام",49,"م",1,0],["أئن سجعت حمامة أي","كة أبديت ما تجد",50,"د",1,0],["أينسى زمان الصفو من عاش معدما","ويلعب بالأشواق والوجد نادل ؟",51,"ل",1,0],["أيُنسى ...والبياضُ على جبالٍ","أحال صخورَها في الأرضِ عرسا",52,"س",2,0],["أينسى أنَّ رحمتَهُ جميعٌ","وأنَّ النارَ يُطفئُها اغترابُ ؟",53,"ب",1,0],["أينسى حين يُضرب عن لقائي","بأني سوف أغرقه بسيلي!؟",54,"ل",2,0],["أين( سعْدٌ ) في ( القادسيةِ ) يرمي","الفرسَ صوْلاً و( المَرْزَبانُ ) مَهينُ؟",55,"ن",1,0],["أينسى بنو العرب في كل","ناد نصيرهم اريحي الكريما",56,"م",2,0],["أينَ سلوايَ فلا تُسعفُني","ساعةُ الأُنسِ لكيما أتنفَّسْ",57,"س",1,0],["أَيٌَنْسَى الحُبَّ مَنْ عَرَفَ الرَّشَادَا","فَكَيْفَ وَ نَارُ صَبْوَتِهِ اِتِّقَادا",58,"د",2,1],["أينسى الدَّهرُ رؤيا خالجَتْهُ:","«فخُذْ، يا خِلُّ، إسماعيلَ وانحرْ»",59,"ر",1,0],["أينسى الشعب كم قاسى شجونا","وظلما منه قلبي باحتراق",60,"ق",1,0]]}