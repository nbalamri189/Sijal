{"poems":[[76,"ترى يوسفا في ثوبه حسن صورة","https://www.aldiwan.net/poem13257.html","الطويل"],[83,"ترى يا زمان الوصل هل أنت راجع","https://www.aldiwan.net/poem61343.html","الطويل"],[124,"ترى ينسخ الإصباح من ظلمة القبر","https://www.aldiwan.net/poem49268.html","الطويل"],[124,"ترى يذكر الأحياء أهل المقابر","https://www.aldiwan.net/poem49360.html","الطويل"],[189,"يا صاح أين مضى قلبي فأطلبه","https://www.aldiwan.net/poem14130.html","البسيط"],[190,"محب أذاع الدمع ما في ضميره","https://www.aldiwan.net/poem43244.html","الطويل"],[190,"ألا يا أيها الغادي","https://www.aldiwan.net/poem43545.html","الهزج"],[214,"قالوا غدا العيد ماذا أنت لابسه","https://www.aldiwan.net/poem13363.html","البسيط"],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[371,"نسيمكم وهو العليل المعلل","https://www.aldiwan.net/poem17087.html","الطويل"],[469,"عيون المها مالي بسحرك من يد","https://www.aldiwan.net/poem3556.html","عموديه"],[590,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[591,"ترى يا جيرة الشعب","https://www.aldiwan.net/poem17973.html","مجزوء الوافر"],[591,"عذارك من ند يجل عن الند","https://www.aldiwan.net/poem17980.html","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16709","المجتث"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115901","الهزج"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11973","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123154","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123163","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123032","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97874","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109975","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102987","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70168","الوافر"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141695","الوافر"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75840","الوافر"],[4929,"الموت القادم من الصين","https://www.poetsgate.com/ViewPoem.aspx?id=211016",""],[5055,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=103542",""],[5136,"بكى سحرة لما تألق باسما","https://www.poetsgate.com/ViewPoem.aspx?id=121672",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[1155,"ترى يا جيرة الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=190928",""],[6075,"بين الذكرى والأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=213327",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""]],"verses":[["تَرى يوسُفاً في ثَوبِهِ حُسنَ صورَةٍ","وَتَسمَعُ داوُداً بِهِ مُتَرَنِّما",0,"م",2,1],["تُرَى يا زَمَانَ الوَصلِ هَل أنتَ رَاجِعُ","وَهَل مَاضِيَ الأفعَالِ مِنكَ مُضارعُ",1,"ع",1,1],["ترى ينسخ الإصباح من ظلمة القبر","ويكسر برد الموت محيٍ من الحر",2,"ر",1,1],["ترى يذكر الأحياء أهل المقابر","ويعتادهم فيها كشوق المسافر",3,"ر",1,1],["تُرَى يزولُ بِعادٌ صار يُبعِده","عني ويَرجِع لي قُرْبٌ يُقرِّبه",4,"ب",2,0],["ترى يده اليسرى إذا الشوق شفه","على كبد حرّى يزيد أنينه",5,"ن",2,0],["ترى ينساك نطيقا","بإيمان وتصديق",6,"ق",1,0],["ترى يجود زماني بالرجوع وهل","بالشمل يسمح لي الدهر المشت بنا",7,"ن",2,0],["تَرى يَدنو بِكُم مِن بَعدِ شَحطٍ","مَزارٌ أَو يُلِمُّ بِكُم لِمامُ",8,"م",1,0],["تُرى يا نَسيمَ الريحِ لا عَن جَهالَةٍ","أَأَنتَ أَمِ الصَبُّ المُعَنَّى المُوَكَّلُ",9,"ل",1,0],["ترى يجتني كفُّ الهوى ثمر المنى","بهِ من قضيب البانة المتأَوّد",10,"د",1,0],["تُرى يحنو الزمان عليَّ يوماً","فأَشكو ما لقِيت إِلى رحيم",11,"م",1,0],["تُرى يا جِيرَةَ الشِّعْبِ","يُسَرُّ بِوَصْلِكُمْ قَلْبي",12,"ب",2,1],["تُرى يَسْمَحُ الدَّهرُ الضَّنينُ بِقُرْبِكُمْ","وَأَحْظى بِكُمْ يا جِيرةَ العَلمِ الفَرْدِ",13,"د",1,0],["تَرى يَضُرُّكَ أَن لَو","يَكونَ مِنكَ وَفاءُ",14,"ا",2,0],["تُرى يعلَمُ مَن أهوَى","بما عندِى من الوَجدِ",15,"د",1,1],["تُرى يعلَمُ أو يدرِى","بما أُخفيهِ أو أُبدِى",15,"د",2,0],["تُرى يَوماً نَرى فيهِ الأَماني","وَتَجمَعُ شَملَنا كَأسُ الشَمولِ",16,"ل",1,0],["تُرى يشتفي يوماً مُقلّ وجائع","ألمّت به من ذا وذاك وجائع",17,"ع",1,1],["تُرى يا قطر يُروى منك صاد","غدا يبدي ودادك وهو صادق",18,"ق",1,0],["تُرى يُرى بكاس الوصل صاد","بحبك عن أهيل العذل صادف",19,"ف",1,0],["تَرَى يَزيدُ في الِّراعِ اليَمَنِي","بِثُلثِ إصبَع فِي التِّرِفَّا فَاتقِنِ",20,"ن",1,0],["ترى يزور صديق كنت أمنحه","ودى وأوليه ضل اللَه في داري",21,"ر",2,0],["تَرَى يَتاماهُ في تَيمٍ مُخامِرِهِم","واليُتمُ من شأنهِ تَيمٌ يُخامِرُهُ",22,"ر",2,0],["ترى يختشي من حلّ عقوة حيدرِ","وإن ساورته موبقات الكبائر",23,"ر",1,1],["تَرى يُمناك في الأعمال يُمناً","وَتَلقى اليسرَ مِن يُسراك ذخرا",24,"ر",2,0],["تُرى يتألفُ الشَّملُ الصَّديعُ","وآمَنُ من زماني ما يَروعُ",25,"ع",1,1],["تَرى يُمنى الكَتيبةِ مَن يَليها","يَخِرُّ عَلى مرافِقَها الكُثوفُ",26,"ف",1,0],["تُرَى .. !! ، يأْجُوجُ أَوْفَدَهُ رَسُوْلًا ؟","لتَدْشِينِ الفَنَا بَبنَ الأنامِ",27,"م",1,0],["ترى يا صاحبي برحل","على وقتٍ يداريني",28,"ن",2,0],["ترى يا حبيبي هل دريت بأنني","عليك جوى أمسى وأصبح هائما",29,"م",2,0],["ترى يطب بي شعبي رجوعي لغيله","وهل قد تروق الغيل أوبة شبله؟",30,"ل",2,1],["ترى يا جيرة الرمل","يعود بقربكم شملي",31,"ل",2,1],["تُرَى يَا حُسْنَ يُوسُفِنَا","وَهَبْتَ الصَّبَّ سِكِّينَا",32,"ن",2,0],["تُرى يجتمعُ الشّملُ","تُرى يَتَفِقُ الوصلُ",33,"ل",1,1],["تُرى يرجعُ من طيبِ","زماني ذلكَ الفَصْلُ",33,"ل",1,0],["تُرى ياقلب هل يكفي التمنّي","وهل يُغني التذاكرُ والوجيبُ؟",34,"ب",1,0]]}