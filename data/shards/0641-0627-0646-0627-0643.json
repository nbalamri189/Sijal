{"poems":[[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[37,"أهاجك مغنى دمنة ومساكن","https://www.aldiwan.net/poem38822.html","الطويل"],[74,"يمنى إمام الوقت قد أنشأت","https://www.aldiwan.net/poem20494.html","السريع"],[53,"يسائلني فرخ الزنا فيم عمتي","https://www.aldiwan.net/poem64555.html","الطويل"],[31,"أتعرف من أسماء بالجد روسما","https://www.aldiwan.net/poem6156.html","الطويل"],[30,"ولست بناس فضل مروان ما دعت","https://www.aldiwan.net/poem5320.html","الطويل"],[68,"ملكت ببعض برك رق شكري","https://www.aldiwan.net/poem38795.html","الوافر"],[68,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[46,"صريع هوى تغاديه الهموم","https://www.aldiwan.net/poem29685.html","الوافر"],[89,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[89,"بأي غزال في الخدور تهيم","https://www.aldiwan.net/poem8259.html","الطويل"],[89,"يا ناصر الحق على الباطل","https://www.aldiwan.net/poem8364.html","السريع"],[13,"أغرك مني يا ابن فعلة علتي","https://www.aldiwan.net/poem2236.html","الطويل"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[7,"أتاني أبيت اللعن أنك لمتني","https://www.aldiwan.net/poem2015.html","الطويل"],[48,"إذا ما الأصل ألفي غير زاك","https://www.aldiwan.net/poem22947.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42714","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42568","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42534","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42572","البسيط"],[13,"أغَرَّكَ مِنِّي يَا بْنَ فَعْلَةَ عِلَّتِي","https://www.poetsgate.com/ViewPoem.aspx?id=180811",""],[31,"عفا واسطٌ من أهْله فمذانُبْهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17431&r=&rc=4",""],[147,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[211,"ترى الرجل النحيف فتزدريه","https://www.aldiwan.net/poem27875.html","الوافر"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[240,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[266,"هل المجد إلا دوحة أنت فرعها","https://www.aldiwan.net/poem38142.html","الطويل"],[266,"تحية داع مخلص في دعائه","https://www.aldiwan.net/poem38280.html","الطويل"],[276,"إذا عهدوا فليس لهم وفاء","https://www.aldiwan.net/poem52095.html","البسيط"],[280,"قابلت نعماك بالسجود","https://www.aldiwan.net/poem25581.html","مخلع البسيط"],[343,"أراني في انتقاص كل يوم","https://www.aldiwan.net/poem68618.html","الوافر"],[358,"حبائل البر في استعطاف ذي الهيف","https://www.aldiwan.net/poem40031.html","البسيط"],[358,"أيا روح روحي رأيت العجب","https://www.aldiwan.net/poem40582.html","المتقارب"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[369,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[369,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[374,"قدمت فلم أترك لذي قدم حكما","https://www.aldiwan.net/poem4315.html","الطويل"],[411,"بنو فريغون قوم في وجوههم","https://www.aldiwan.net/poem49773.html","البسيط"],[447,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[470,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[473,"أيا من هو الماء الزلال الذي يجري","https://www.aldiwan.net/poem60085.html","الطويل"],[475,"تذكر سلمى بعد ما حال دونها","https://www.aldiwan.net/poem4693.html","الطويل"],[511,"زيادة حسن الصوت في الخلق زينة","https://www.aldiwan.net/poem2427.html","الطويل"],[521,"فإن أك حالكا فالمسك أحوى","https://www.aldiwan.net/poem48742.html","الوافر"],[534,"ظني بربي مليح","https://www.aldiwan.net/poem37475.html","المجتث"],[545,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[549,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[563,"نشأة الروح بالغروب الطلوع","https://www.aldiwan.net/poem34385.html","الخفيف"],[575,"شفيت النفس من حمل بن بدر","https://www.aldiwan.net/poem59476.html","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70835","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59547","الطويل"],[1250,"","https://poetry.dctabudhabi.ae/diwan/poem/73864","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73959","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6753","الكامل"],[1391,"","https://poetry.dctabudhabi.ae/diwan/poem/21202","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78187","الوافر"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134226","الوافر"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96345","المتقارب"],[1679,"","https://poetry.dctabudhabi.ae/diwan/poem/27073","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103208","الطويل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89658","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124743","الوافر"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105315","البسيط"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34969","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53043","الطويل"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111085","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28591","الوافر"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115068","الطويل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17702","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100913","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83213","الوافر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58372","الوافر"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104674","الوافر"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70387","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87421","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62951","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62854","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91323","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216463","السريع"],[3711,"","https://poetry.dctabudhabi.ae/diwan/poem/31525","الوافر"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21515","الهزج"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59449","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35532","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127241","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4293,"","https://poetry.dctabudhabi.ae/diwan/poem/18201","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83521","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83586","البسيط"],[4502,"","https://poetry.dctabudhabi.ae/diwan/poem/75854","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52137","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204300","الطويل"],[5563,"أزفُّ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215132",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[5688,"وغرّ بدا لي","https://www.poetsgate.com/ViewPoem.aspx?id=200926",""],[5956,"حنين إلى بلاد الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=183594",""],[6125,"جِرَاحِي لا تُضَمِّدها الأمَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=207908",""],[1333,"لو كنت في ديني من الابطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56026&r=&rc=4",""],[6221,"رحلة في دروب الذكريات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64919&r=&rc=3",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[5922,"مذكرة سرية ل\"غاليليو غاليلي\"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88225&r=&rc=0",""]],"verses":[["فَإِن أَكُ عَبداً قَد تَمَلَّكتَ رِقَّهُ","فَأَرفَعُ أَحوالي وَأَسنى وَأَشرَفُ",0,"ف",1,0],["فَإِن أَكُ مَعروقَ العِظامِ فَإِنَّني","إِذا وُزِنَ الأَقوامُ بِالقَومِ وازِنُ",1,"ن",1,0],["فإن أكن بالعشر هنأته","فإنه بالخمس هنَّاني",2,"ي",1,0],["فإن أكُ معتمّاً بثوب طهارةٍ","فإنك معتم بخزي المجالس",3,"س",1,0],["فَإِن أَكُ قَد عانَيتُ قَومي وَهِبتُهُم","فَهَلهِل وَأَولى عَن نُعَيمِ بنِ أَخثَما",4,"م",2,0],["فَإِن أَكُ مَحبوساً بِغَيرِ جَريرَةٍ","فَقَد أَخَذوني آمِناً غَيرَ خائِفِ",5,"ف",1,0],["فَإِن أَكُ قَد أَسَأتُ لَكَ التَقاضي","فَلا يَخفى عَلى مَولايَ عُذري",6,"ر",2,0],["فَإِن أَكُ قَد فارَقتُ إِلفاً وَمَعشَراً","كِراماً إِلى عَلياهُمُ العِزُّ يَجنَحُ",7,"ح",1,0],["فَإِن أَكُ قَد حَلَلتُ بِدارِ هونِ","صَبَوتُ بِها فَقَد يَصبو الحَليمُ",8,"م",1,0],["فَإِنْ أَكُ فَارَقْتُ الدِّيَارَ فَلِي بِهَا","فَؤَادٌ أَضَلَّتْهُ عُيُونُ الْمَهَا مِنِّي",9,"ن",2,0],["فَإِنْ أَكُ مَحْسُورَاً بِهَا فَلَرُبَّمَا","مَلَكْتُ عِنَانَ الْقَلْبِ وَهْوَ كَظِيمُ",10,"م",1,0],["فَإِنْ أَكُنْ جُرِّدْتُ مِنْ ثَرْوَتِي","فَفَضْلُ رَبِّي حلْيَةُ الْعَاطِلِ",11,"ل",1,0],["فَإِن أَكُ لَم أَخضِبكَ فيها فَإِنَّها","نُيوبُ أَساويدٍ اشَولُ عَقارِبِ",12,"ب",1,0],["فإن أكُ مَحسوداً على حُرّ مَدحكم","فغَيرُ نَكيرٍ في الزمان الأعاجيب",13,"ب",1,0],["فإنْ أكُ فارَقْتُ طِيبَ الحياةِ","حَميداً ووَدّعتُ عصرَ الصّبى",14,"ا",1,0],["فَإِن أَكُ مَظلوماً فَعَبدٌ ظَلَمتَهُ","وَإِن تَكُ ذا عُتبى فَمِثلُكَ يُعتِبُ",15,"ب",1,0],["فَإِن أَكدى المُنيلُ فَلا تَلُمهُ","فَقَد تَخلو مِنَ الرِسلِ الضُروعُ",16,"ع",1,0],["فَإِنْ أَكُ مُلْقَى الرَّحْلِ فِيهِمْ فَإِنَّنِي","لَهُمْ بِالْخِلالِ الصَّالِحَاتِ مُفَارِقُ",17,"ق",1,0],["فَإِنْ أَكُ مَشْغُوفَاً فَذُوا الْحِلْمِ رُبَّمَا","أَطَاعَ الْهَوَى وَالْحُبُّ مِنْ عُقَدِ السِّحْرِ",18,"ر",1,0],["فَإِنْ أَكُ فَارَقْتُ الشَّبَابَ فَقَبْلَهُ","بَكَيْتُ رَضَاعاً بَانَ عَنِّي حَمِيدُهُ",19,"د",2,0],["فَإِنْ أَكُنْ سِرْتُ عَنْ أَهْلِي وَعَنْ وَطَنِي","فَالنَّاسُ أَهْلِي وَكُلُّ الأَرْضِ لِي وَطَنُ",20,"ن",1,0],["فَإِنْ أَكُنْ قَدْ نِلْتُ مِنْ عِرْضِهِ","فَإِنَّنِي دَنَّسْتُ شِعْرِي بِهِ",21,"ب",2,0],["فَإِنْ أَكُنْ عِشْتُ فَرْدَاً بَيْنَ آصِرَتِي","فَهَا أَنَا الْيَوْمَ فَرْدٌ بَيْنَ أَنْدَادِي",22,"د",2,0],["فَإنْ أَكُ لَمْ أُخُضِبْكَ فِيهَا فَإنَّهَا","نيُوبُ أَسَاوِيدٍ وَشَوْلُ عَقَارِبِ",23,"ب",1,0],["فإنْ أكُ قد فتّ الكليبي بالعلى","فقدْ أهلكتهُ في الجراء مثالِبُه",24,"ب",2,0],["فَإِنِ اِكتَفَوا بِكَ في المُلِمِّ فَلَم تَزَل","أولى الزَمانِ بِنَصرِهِم مُتَكَفِّلا",25,"ل",2,0],["فَإِن أَكُ في شِرارِكُمُ قَليلاً","فَإِنّي في خِيارِكُمُ كَثيرُ",26,"ر",1,0],["فَأَنا كافِرٌ وَسَوفَ يَراني","كلُّ مَن مَرَّ بي أُزَوِّدُ كُفرا",27,"ر",2,0],["فَإِن أَكُن عالِياً عَلَيهِ","فَهوَ عَلى كاهِلي ثَقيلُ",28,"ل",1,0],["فإن أك قد فارقت بابك راحلاً","فكم من مضرات تعذر دفعها",29,"ع",3,0],["فإن أكرد المولى لما أنا ضامر","رحلت على فلك إليه بلا ضمر",30,"ر",1,0],["فان أَكرمتنا دنيا وأخرى","فَلَيسَ البحر تنقصه الدلاء",31,"ا",2,0],["فإِن أكُنْ قَبلُ في ضُبوبٍ","فَها أنا اليومَ في صُعودِ",32,"د",1,0],["فَإِن أَكُ قَد فَنيتُ وَماتَ بَعضي","فَإِنَّ الحِرصَ باقٍ فِيَّ حَيُّ",33,"ي",1,0],["فَإِن أَكُن بَعض آثام جَنيت فَما","أَنا إِلى غَير غَفّار بِمعترفِ",34,"ف",1,0],["فَإِن أَكُ أَذنَبت يا سَيّدي","فَإِنّ شَديد عِقابي وَجَب",35,"ب",1,0],["فإنْ أكُ غُصْتُ على الدُّرِّ فيكَ","فمنْ أجْلِ أنّك بحْرٌ خِضَمّ",36,"م",1,0],["فإنْ أكُ ودَّعتُ الغَداةَ غِوَايتي","وأصبحَ سَيْفي وهْو في يَدِ صاقل",37,"ل",1,0],["فإن أكُ عن حَجِّي له العامَ عاجزاً","على أنّني لم آل في البَذْلِ للجُهد",38,"د",1,0],["فإن أكُ في صدرٍ من العمر شارخاً","فكم لقنٍ عن همتي لقني الهما",39,"م",2,0],["فإنْ أكُنْ ساكِتاً عن شُكرِ أنعُمِهِ","فإنَّ ذاكَ لِعَجزي لا لإغفالي",40,"ل",2,0],["فإن أك كنت مسعوداً فإني","بغير قضاه غير المستعين",41,"ن",1,0],["فإنْ أكُنْ هِجتُ جُرحي فهوَ منكَ ذِما ً","ألَيسَ يَجمَعُنا مِن جُرحِنا نَسَبُ؟!",42,"ب",1,0],["فَإِن أَكُ قَد أَزَرَت عَلَيَّ إِساءَةٌ","فَرُبَّتَما يُزري الكُسوفُ عَلى البَدرِ",43,"ر",1,0],["فَإِن أَكُ قَد وَدَّعتُها وَهَجَرتُها","فَما عَن تَقالٍ كانَ ذاكَ التَهاجُرُ",44,"ر",1,0],["فان أك مغرى بالسّماع وحسنه","فحسبي اقتداء بالكريم ابن جعفرِ",45,"ر",1,0],["فإن أك حالِكاً فَالمِسك أَحوى","وَما لِسَواد جِلدي من دَواءِ",46,"ا",2,1],["فإِنْ أَكُنْ أَنَا شَيْئاً","فَذَاكَ أَمْرٌ رَبيحُ",47,"ح",1,0],["فَإِن أَكُ قَد هَفَوتُ إِلى أَميرٍ","فَعَن غَيرِ التَطَوُعِ وَالسَماحِ",48,"ح",1,0],["ف (أنا) كَ(أنتَ).. تعبتُ من عَبَثِيَّتي","في فَهْمِ مفتاح الوجودِ وقُفْلِهِ",49,"ل",2,0],["فأنا كالمجاز عنها وقالوا","صح نفي المجاز عند الخضوع",50,"ع",1,0],["فَإِن أَكُ قَد بَرَدتُ بِهِم غَليلي","فَلَم أَقطَع بِهِم إِلّا بَناني",51,"ي",1,0],["فإنْ أكتم هواها صا","ر دمعي مُفْشِياً سرى",52,"ر",2,0],["فإن أكُ نشواناً فذلك جنة","وإن أكُ سكراناً فذاك قيامه",53,"ه",1,0],["فَإِن أَكُ لا مالٌ لَدَيَّ فَإِنَّني","أَبو بَكر الصِّديقُ جَدّي وَلا فَخرُ",54,"ر",1,0],["فإن أك بالشكوى إليكم معرضاً","فشأني بشاني في هواكم مصرحُ",55,"ح",1,0],["فَأَنا كَمَن يَلقى الكَتيبَةَ أَعزَلاً","في مَأزِقٍ مُتَعَرِّضاً لِنِزالِ",56,"ل",1,0],["فَأَنا كارِهَةٌ بُغيَتُكُم","وَمَريرُ المَوتِ عِندي قَد حَلا",57,"ا",1,0],["فَإِن أَكُ بِالذُنوب قَضَيت عُمري","فَها أَنا قَد كَشَفتُ غِطاءَ أَمري",58,"ي",1,0],["فإن أك قد وردت الماء عذباً","فها أنا قد جرعت عليك صابا",59,"ب",2,0],["فأن أك ودعت جهل الصبا","ورث قوى حبله فأنحزم",60,"م",1,0],["فَإِن أَكُ قَصداً في الرَجالِ فَإِنَّني","إِذا حَلَّ أَمرٌ ساحَتي لَجَسيمُ",61,"م",1,0],["فإن أَكُ مَجلوداً فكُن أَنتَ جالدي","وإن أَكُ مَذبوحاً فَكُن أَنتَ تَذبَحُ",62,"ح",1,0],["فَإِن أَكُ قَد ثَكَلتكُ في حَياتي","وَفارَقَني بِكَ الأَلفُ الحَبيبُ",63,"ب",1,0],["فإن أكل الفريسة فاجتنبها","فما لله ربك من نديد",64,"د",1,0],["فان أكن أنا لم أشكرك عارفة","فالخير بالخير عند اللَه مثلان",65,"ن",1,0],["فَإِن أَكُ في أَخذِ العَطِيَّةِ مُربِحاً","فَإِنَّكَ في بَذلِ العَطِيَّةِ أَربَحُ",66,"ح",1,0],["فإن أك قد أدنيت والله عالم","بذنبي فقد أقلعت إقلاع تائب",67,"ب",1,0],["فان أك عن ذنب وسوء سريرة","ولم أك أهلاً أن انا باحسان",68,"ن",1,0],["فَإِن أَكدى لَئيمُ الظَّنِّ فيهِم","فَإِنّي قَد عَرَفتُ بِهِ اللِّئاما",69,"م",2,0],["فان أكُ قَد أُخرِجتُ عن دارِ بُغضةٍ","فَليسَ بِكفَّي مُخرِجِي سَعَةُ الأَرضِ",70,"ض",1,0],["فَإِن أَكُ لاقَيتُ الدَهاريسَ مِنهُما","فَقَد أَفنَيا النُعمانَ قَبلي وَتُبَّعا",71,"ع",2,0],["فإن أكُ أقررتُ الحسَام بغمدِه","فلى موقفٌ فى الجحفلين رهيب",72,"ب",1,0],["فإنّا كَالأُسودِ إِذا رَبَضنا","لَنا صَبرٌ وَلَيسَ نُقِرُّ جاني",73,"ن",2,0],["فإن أكُ مُعسِراً فأخو رجاءٍ","أُبَلّغُهُ قَريباً من مَعالي",74,"ل",2,0],["فإِن أَكرَمتَنا دُنيا وَأُخرى","وَعَنّا فيهِما دُفِعَ البَلاءُ",75,"ا",2,0],["فإن أكنْ وذكركمْ","طابَ ولذّ السهرْ",76,"ر",1,0],["فإن أكن جرتُ معهُ في مطاليتي","وَكانَ ذلك لي ذَنباً فوا أَسَفي",77,"ف",2,0],["فانْ أَكُ شختاً في الرجالِ فانني","لأَثقل ما لا يحملون حَمولُ",78,"ل",1,0],["فان أَكُ قد جَزعْتُ وسُرَّ قَومٌ","بأَني للنَّوائِبِ مُستَجيبُ",79,"ب",1,0],["فإنْ أكُ ودّعتُ الشبابَ فلمْ أكنْ","على عهدِ إذْ ذاكَ الأخلاء زاريا",80,"ي",2,0],["فَأَنا كَما شاءت لَها","طوعَ التَواصل وَالصُدود",81,"د",1,0],["فإن أكن أوفدت شعري لكم","فذاك عندي خير إيفاد",82,"د",1,0],["فَإِن أَكُ نائِياً عَنهُ فَإِنّي","سُرِرتُ بِأَنَّهُ غَبَنَ البِياعا",83,"ع",2,0],["فَإِن أَكتُمُهُ يَوماً","فَإِنّي سَوفَ أُبديهِ",84,"ي",2,0],["فإن أك قد فارقتُ قومي وأسرتي","لإِدراك شأو شاسع أنا طالبُهْ",85,"ب",2,0],["فَإِن أَكُ مُجزيّاً بِذَنبي فَإِنَّني","بِحَرِّ عَذابِ المُذنِبينَ جَديرُ",86,"ر",1,0],["فإن أك شيخ أهل النظم طرا","فإني تحت طاعته غلام",87,"م",1,0],["فإن أكن في الغرام لم أر ما","يجدى وقضيت في الهوى زمنا",88,"ن",2,0],["فَإِنّا كَذا كَم يَحمِلُ القَومَ خَوفُنا","عَلى آجِناتِ الماءِ غَيرِ عِذابِ",89,"ب",1,0],["فإن أَكُن مُخطِئاً فيما اِجتَهَدت بِهِ","فَردَّني لِصَوابي وَالصَوابُ أَغَر",90,"ر",1,0],["فَإِن أَكن قمتُ في حسن الوِداد عَلى","عَجزي لِمَن نَعتهُم قَد جاءَ في الكُتُبِ",91,"ب",1,0],["فَإِن أَكبر فَإِني في لِداتي","وَعَصرُ جَنوبَ مُقتَبَلٌ قَشيبُ",92,"ب",1,0],["فأنا كاتب إليها ثناءً","والغواني يَغُرّهُنَّ الثناءُ",93,"ا",2,0],["فإن أك شرّ العيشتين أعيشها","فإني إلى خير المماتين أقصد",94,"د",1,0],["فإن أك قد سكبت صدوق حسيّ","فقلبي لم يزل ثجًّا هميّا",95,"ي",2,0],["فأنا كأنفاسِ الربيعِ طليقةٌ","وجليّةٌ كالشمسِ لمْ أتبرقعِ",96,"ع",1,0],["فإنّا كرام النّسل أهل معزّة","نذود عن الإسلام دون ترفّق",97,"ق",1,0],["فإن أكُ لم أزل جَوْعانَ مالٍ","مَرَدُّه جئتُ من بيتٍ فقيرِ",98,"ر",1,0],["فإنْ أَكُ يَا أمِينةُ في عَذَابٍ","فَبَينَ يَدَيك أنْعَمُ في الجِنَانِ",99,"ن",1,0],["فأنا كمن يلقى الكتبية اعزلا","في مأزق متعرضا لنزال",100,"ل",1,0],["فان أكن غادرت أوطانكم","فخافقي باق ولم ينقل",101,"ل",1,0],["فأنا كالصِّلاء ، يُحرَقُ بالن","ار ِ ، ويهدى العبير للنُشّاق",102,"ق",1,0],["فَأَنَا كَ\" غَالِيلِي\" نُفِيتُ لِأَنَّنِي","قَدْ قُلْتُ: إِنَّ الأَرْضَ لِي كُرَوِيَّةْ",103,"ي",2,0]]}