دا منك إقصاءٌ وإبعادُ",4,"د",1,0],["أَنتَ الحَبيبُ وَلا سِوا","كَ وَلَم أَخُنكَ فَلا تَخُنّي",5,"ن",2,0],["أَنتَ الحَبيبُ وَما لي عَنكَ سُلوانُ","وَفيكَ ضَجَّ عَلَيَّ الإِنسُ وَالجانُ",6,"ن",1,1],["أَنتَ الحَياةُ وَمَن تُفا","رِقُهُ الحَياةُ فَكَيفَ حالُه",7,"ل",2,0],["أَنتَ الحَبيبُ الأَوَّلُ","وَلَكَ الهَوى المُستَقبَلُ",8,"ل",1,1],["أَنتَ الحَيا وَغِياثٌ نَستَغيثُ بِهِ","لَو نَستَطيعُ فَداكَ المالُ وَالوَلَدُ",9,"د",1,0],["أَنتَ الحَكيمُ فَلا تَرُعكَ مَنِيَّةٌ","أَعَلِمتَ حَيّاً غَيرَ رِفدِكَ داما",10,"م",2,0],["أَنتَ الحَقيقَةُ إِن تَحَجَّبَ شَخصُها","فَلَها عَلى مَرِّ الزَمانِ ظُهورُ",11,"ر",1,0],["أنتَ الحَيا ولربَّما قَبَضَ الحيَا","كَفاً وكفُّكَ نُجعَةُ الثَّقَلَيْنِ",12,"ن",1,0],["أنتَ الحَيا الجَوْدُ الذي آفاقُه","تَنهلُّ بالمعروفِ أو تَتَهَلَّلُ",13,"ل",1,0],["أنتَ الحُسامُ فِرندُهُ في مَتنِه","مُتردَّدٌ ويدُ المدائح صَيقَلُ",13,"ل",1,0],["أنتَ الحياةُ جَرَتْ في كلِّ مُنطَلقٍ","تَغشَى الكميَّ وتغشى الصَّارِمَ الخَذِما",14,"م",2,0],["أَنتَ الحَديث وَشُغلي","لَدى العَشي وَبُكره",15,"ر",2,0],["أنتَ الحَقيقَةُ أُيّدَتْ بحَقيقَةٍ","وسِواكَ عَينُ الإفْكِ والبُهتانِ",16,"ن",1,0],["أنتَ الحُسامُ فإنْ تُفللْ مَضارِبُهُ","فقبْلهُ مَا يُفلُّ الصَّارِمُ الذَّكَرُ",17,"ر",1,0],["أنتِ الحياة والنجا","ة والأمانُ المُجتَبَى",18,"ب",2,0],["أَنْتِ الحَقِيقَةَ فِي الحَيَاةِ وَكَاذِبٌ","غَيْرُ الهَوَى لِلمَائِتِ المَلحُودِ",19,"د",1,0],["أَنْتَ الحَكِيمُ وَلَمْ تَكُنْ","لِتضِيعَ فِي الرَّوْعِ اتِّئَادك",20,"ك",1,0],["أنت الحياة تفيض بالخصب","المعطر كالسحابه",21,"ب",2,0],["أنتَ الحبيبُ الذي تُرْجَى شفاعتُهُ","لك الوسيلةُ عند الله والجاهُ",22,"ا",2,0],["أنت الحياة التي نفس البقاء بها","بل أنت مكنون سر الله في البشر",23,"ر",1,0],["أنتِ الحياةُ وعمرٌ في سواكِ مضى","فإنما هو تبذيرٌ وتبديد",24,"د",1,0],["أنتِ الحَياةُ، جَمالُها وسُرُورُها","ولَأَنتِ في عَيني الثُّرَيَّا والزُّحَلْ",25,"ل",1,0],["أنتَ الحبيبُ المرتضى ولكَ الهنَا","وأنَا المحبُّ المبتلى ولى العَنَا",26,"ن",2,1],["أنت الحكيم ولا نزيدُك حكمةً","فوق الذي تجزى وأنتَ معَلَّمُ",27,"م",1,0],["أَنتَ الحُسامُ الَّذي لا يُنتَضى أَبَداً","إِلّا لِذُلِّ ضَلالٍ أَو لِعِزِّ هُدا",28,"د",2,0],["أَنتَ الحُسامُ الَّذي ما سُلَّ يَومَ وَغىً","إِلّا أَتاحَ حِماماً أَو أَباحَ حِما",29,"م",2,0],["أنت الحياة فمن يميل إلى الردى","ويجب بيع حياته بمهمات",30,"ت",1,0],["أنت الحياةُ وفي يديك مَقرُّها","ونَداك يُحْيِي منهما الحيوانا",31,"ن",2,0],["أَنتَ الحبيبُ إليكَ الأمرُ أجمعهُ","مِنَ المُهيمن في الدارين موكولُ",32,"ل",1,0],["أنت الحكيمُ إذا نَبَا","عن حكمة ذهنُ الحكيم",33,"م",1,0],["أَنتَ الحَبيبُ مِن البَريّة كُلِّها","وَمُحَمَّدٌ دونَ الوَرى المأمولُ",34,"ل",1,0],["أنتِ الحمامةُ غرَّها قفصٌ","هو من حديدٍ زانه طال",35,"ل",1,0],["أَنتَ الحَبيب الَّذي نَرجو عواطفه","غند الصراط اذا ما ضاقَت الحبل",36,"ل",1,0],["أنْتَ الحُسَامُ لِيُنْتَضَى مِنْ غمْدِهِ","فَيَقُطَّ هَامَةَ كَافِرِ الإِحْسَانِ",37,"ن",1,0],["أَنتَ الحَيا فَمَتى ما حَلَّ في بَلَدٍ","أَماتَهُ الجَدبُ أَحياهُ بِجَدواهُ",38,"ا",2,0],["أنت الحياة فما أرى","في غير قربك سعديه",39,"ي",2,0],["أَنتَ الحَياةُ الَّتي ما بَعدَها رَغَبٌ","أَو الحِمامُ الَّذي ما قَبلَهُ رَهَبُ",40,"ب",1,0],["أَنتَ الحَبيبُ بِعَينِهِ فَإِذا بدا","وَجهُ الصَباحِ فَأَنتَ عَينُ العاذِلِ",41,"ل",1,0],["أَنتَ الحَياةُ لِآدابٍ برعتَ بِها","فَليجرِ لي مِثل مَجرى السَمع وَالبَصَر",42,"ر",1,0],["أَنتَ أَلحقتَ بالذكيِّ غبيّاً","في اِصطِلامٍ وبالدّنيِّ هُماما",43,"م",2,0],["أنتَ الحبيب فلِمْ صني","عك لِي شبيهٌ بالتَّقالِي",44,"ل",2,0],["أنت الحقيق بأن يقال لك انتبه","من رقدة الغفلات يا إنسان",45,"ن",1,0],["أنت الحليمُ الذي يُرجى تجاوُزُهُ","عن جهل عبدٍ أساءَ القولَ والعَمَلا",46,"ل",2,0],["أَنت الحبيبُ محبَّةً لا تَنْتهي","ولها عليكَ ولايةٌ لا تُعزَل",47,"ل",1,0],["أَنت الحبيب عطفتَ أَم لم تعطِف","وأَنا الْمُحِبُّ صدفْتَ أَمْ لم تَصْدِف",48,"ف",1,0],["أَنت الحبيبُ إِلى قلبي وواحدُه","إِنِّي رأَيتكَ من دونِ الوَرى وَزَري",49,"ر",2,0],["أنت الحكيم الذي من شعره حكم","ومنه سحر بيان لبنا سحرا",50,"ر",2,0],["أنت الحرّي بما بلغت من السنا","لمناقب غراء فيك وضاء",51,"ا",2,0],["أنت الحريّ بكل شعر نظمه","درر باشكال زهت وصنوف",52,"ف",1,0],["أنت الحكيم بمعنييه بك اغتدى","شرق البلاد على المغارب يفتخر",53,"ر",1,0],["أنتِ الحياةُ وأنتِ قاتلة الفتى","عمداً ومنكِ صبابةُ المشتاقِ",54,"ق",1,0],["أنت الحبيب وسواك مالي","لو أنني أنفقت فيك مالي",55,"ي",1,0],["أنت الحليم ومن يعد","هذاء هن من السفاهِ",56,"ه",1,0],["أنت الحيي الأريحي الذي","بحر يديه العدّ لا ينضبُ",57,"ب",1,0],["أنت الحيي الأريحيّ الذي","يحيا بجدوى راحتيه الفقير",58,"ر",1,0],["أنت الحياة فإن أُهِجتَ فحية","من ساورته فما له من راقِ",59,"ق",1,0],["أنت الحبيب فقل يسمع وسل لتنل","واشفع تشفع فما ترضى رضيناه",60,"ا",2,0],["أنت الحبيب المرتضى","أنت الخليل المستند",61,"د",1,0],["أنت الحبيب فقل أسمع وسل لتنل","واشفع تشفع فعندي أنت مقبول",62,"ل",1,0],["أَنْتَ الحَلِيمُ وَالأَمِيرُ المُنْتَقِمْ","تَصْدَعُ بِالْحَقِّ وَتَنْفِي مِنْ ظُلَمْ",63,"م",1,0],["أنت الحميد الاحمد الغرّ الاّغرِّ","سناً به قد ضاءت الدنياُ",64,"ا",1,0],["انت الحميد المحصى والمبدى المعيد","المحي فاصلح سائر الاحوال",65,"ل",1,0],["أنت الحبيب إلى قلب المحبينا","أنت المجيب إلى كل المنادينا",66,"ن",2,0],["أَنتَ الحَبيب وَالمُجيب","هَواك لي أَضحى دينا",67,"ن",2,0],["أنت الحقيقُ بكُل ذكرٍ صالحٍ","ويَحق أنْ يُثْنى عَلَيكَ وَتُمدَحا",68,"ح",2,0],["أَنت الحُسامُ المُرتجى","في صدعِ داهيةٍ مَضاك",69,"ك",1,0],["أَنتَ الحَميم لآل حاميم الذرى","والجار وابن الجار وابن الجار",70,"ر",1,0],["أنت الحليم وراحم","رب مهيمن ثم بر",71,"ر",1,0],["أنت الحقيقة إن لم تنطقي فأنا","أروي لهم عنك أمثالاً وأخبارا",72,"ر",2,0],["أنتَ الحياةُ ومالي عنكَ منْصَرَفٌ","وأنت حظّيَ من دنيا ومِنْ دين",73,"ن",1,0],["أنت الحلال الحلو رق طبيعة","وصفا مزاجاً كالسحاب الغادي",74,"د",2,0],["أنتِ الحنونة فارثِ","لحال قلبي الحنون",75,"ن",1,0],["أنت الحبيب فليس قلبى طامعا","طول الحياة بغيركم يتولع",76,"ع",1,0],["أنت الحبيب وأنى للمحب على","قرب الحبيب عزاء غير بالنصب",77,"ب",1,0],["أنتِ الحياةُ قضت بلا أملٍ","أنت الشبابُ مضى بلا وزر",78,"ر",1,0],["أنت الحبيبُ فلو سألت جميع ما","عندي وجملة ما لدي لما كثر",79,"ر",1,0],["... أنت ألحاني","وحلمي في الهوى العذري",80,"ر",2,0],["أنت الحي القيوم ومن","لا ينعس أن حي نعسا",81,"س",2,0],["أنت الحبيب المصطفى","طه إمام المتقين",82,"ن",1,0],["أنتالحبيب ابن الحبيب