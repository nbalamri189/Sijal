{"poems":[[55,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[88,"ردوا علي بياني بعد محمود","https://www.aldiwan.net/poem10495.html","البسيط"],[73,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[93,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[63,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[60,"أغمض عيني في أمور كثيرة","https://www.aldiwan.net/poem31012.html","الطويل"],[99,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[82,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[46,"أغمد عن المهجات سيف الناظر","https://www.aldiwan.net/poem30243.html","الطويل"],[104,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[22,"قبح الإله بني بجاد إنهم","https://www.aldiwan.net/poem21681.html","الكامل"],[54,"يا نفس صبرا صبرا","https://www.aldiwan.net/poem26977.html","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202537","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43871","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[108,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[124,"أبعدوا عني الشفاه اللواتي","https://www.aldiwan.net/poem49329.html","الخفيف"],[146,"قد علمت ليلة الحمى ورعى","https://www.aldiwan.net/poem58345.html","المنسرح"],[146,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[164,"من عونه ربه في أمره غلبا","https://www.aldiwan.net/poem58896.html","البسيط"],[164,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[246,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[257,"وميض ثغر يفتر بالثغر","https://www.aldiwan.net/poem1447.html",""],[266,"اغمد شبا مرهفك الباتر","https://www.aldiwan.net/poem38276.html","السريع"],[287,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[371,"سأل اللوى وسؤاله تعليل","https://www.aldiwan.net/poem17329.html","الكامل"],[406,"الشفق الأحمر","https://www.aldiwan.net/poem6796.html","عموديه"],[422,"ما لي أودع كل يوم صباحا","https://www.aldiwan.net/poem54093.html","الكامل"],[438,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[445,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[463,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[563,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[580,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62465","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/141860","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112954","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80033","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48980","الخفيف"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26662","المنسرح"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49543","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49612","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110269","الرمل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45448","الوافر"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60872","الخفيف"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115395","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204821",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200062",""],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147324","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97990","السريع"],[3444,"","https://poetry.dctabudhabi.ae/diwan/poem/130736","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216704","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216832","الخفيف"],[3713,"","https://poetry.dctabudhabi.ae/diwan/poem/144950","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59450","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73128","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73121","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[5002,"على متن الخيال...","https://www.poetsgate.com/ViewPoem.aspx?id=202663",""],[5121,"نَوْمَةُ مَلاَك","https://www.poetsgate.com/ViewPoem.aspx?id=174100",""],[5324,"أغمد حسامك وارتحل ياعنترة .","https://www.poetsgate.com/ViewPoem.aspx?id=207628",""],[5324,"أغمض الجفن.","https://www.poetsgate.com/ViewPoem.aspx?id=211951",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""],[5409,"منعاك عز على العراق الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=155480",""],[5411,"ضجيج الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=185306",""],[5431,"أمطريني ماء طهركْ","https://www.poetsgate.com/ViewPoem.aspx?id=183436",""],[5431,"وما أحلى الرجوع إلى الطحينِ...","https://www.poetsgate.com/ViewPoem.aspx?id=199868",""],[5431,"تاج فوز....","https://www.poetsgate.com/ViewPoem.aspx?id=203359",""],[5447,"إلى حنظلة","https://www.poetsgate.com/ViewPoem.aspx?id=208326",""],[5456,"رحيل يشبه الموت .. !","https://www.poetsgate.com/ViewPoem.aspx?id=198750",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5577,"شطر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=177005",""],[5652,"إغماءة فقد","https://www.poetsgate.com/ViewPoem.aspx?id=168822",""],[5691,"ترتيلة مقدسية","https://www.poetsgate.com/ViewPoem.aspx?id=206355",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5736,"مواثيق باهتة","https://www.poetsgate.com/ViewPoem.aspx?id=208482",""],[5749,"سفر عبر الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=180574",""],[5848,"طعنتينك","https://www.poetsgate.com/ViewPoem.aspx?id=49222",""],[5939,"لَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=185495",""],[5943,"أغمضتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=92984",""],[5956,"شمس وغيم","https://www.poetsgate.com/ViewPoem.aspx?id=183187",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6213,"ما أحيلاه العناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76271&r=&rc=28",""],[6262,"لغةٌ أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""],[4222,"رسم علي لذلك الرسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52896&r=&rc=188",""]],"verses":[["أَغمَدتُموني بَعدَ صَقلِ الشَبا","إِغمادَ لا الماضي وَلا القاصِلِ",0,"ل",1,0],["أَغمَضتَ عَينَيكَ عَنها وَاِزدَرَيتَ بِها","قَبلَ المَماتِ وَلَم تَحفِل بِمَوجودِ",1,"د",1,0],["أَغمَدتَ سَيفاً مُرهَفاً شَفَراتُهُ","قَد كانَ في ذاتِ الإِلهِ مُجَرَّدا",2,"د",2,0],["أَغمامَ لَو شَهِدَ الوَقيطَ فَوارِسي","ما قيدَ يُعتَلُ عَثجَلٌ وَضِرارُ",3,"ر",1,0],["أَغمَضتُ أَجفاني عَلى مَضَضٍ","وَطَوَيتُ أَحشائي عَلى الجَمرِ",4,"ر",1,0],["أغَمامَةٌ بالشَّامِ شِمْنَ بُروقَها","أم شِمْنَ من بِشْرِ الأميرِ بُروقا",5,"ق",2,0],["أَغمِّضُ عَيني في أُمورٍ كَثيرَةٍ","وَإِنّي عَلى تَركِ الغُموضِ قَديرُ",6,"ر",1,1],["أغمضت عيني دونها خائفاً","مبتغياً لي رحمة في الظلام",7,"م",1,0],["أغُمْرَ الهوى كم ذا تُقَطّعُني عَذْلا","قتلتُ الهوى علماً أتقتلني جهلا",8,"ل",2,1],["أَغمِد عَنِ المُهجاتِ سَيفَ الناظِرِ","فَلَقَد فَتَرنَ مِنَ اللِحاظِ الفاتِرِ",9,"ر",1,1],["أَغمدان ما يُبكيكَ يا كَعبةَ الهُدى","وَفيم الأَسى يا هَيكل الفَضلِ وَالنَدى",10,"د",2,1],["أَغمارُ شُمطٍ لا تَثوبُ حُلومُهُم","عِندَ الصَباحِ إِذا تَعودُ العُوَّدُ",11,"د",1,0],["أَغمَدتُ عَنكُمُ سَيفي","وَقَد مَلَكتُ النَصرا",12,"ر",2,0],["أغمدوا أسيافهم ويح وما","عوّدوا أسيافهم حبسَ الغمود",13,"د",1,0],["أغمدها في هيكل الجلال","وشامها في كرم الخلال",14,"ل",1,0],["أُغمد لا كلا ًّ ولا مقصّرا","في حرب كسرى وقتال قيصرا",15,"ر",2,0],["اغمد وسُلَّ ليسَ لي وَزَرٌ","أنا على الحالَتْينِ مَقْتُولُ",16,"ل",1,0],["أُغْمِدَ السيْفُ بعدَ طُولِ جِدالٍ","وجدالُ السُيوفِ شَرُّ جِدال",17,"ل",1,0],["أغمدْتَ سيفَكَ حينًا، فانبرى نَفَرٌ","يدبِّرُ الفتَنَ الهوجاءَ والشَّغَبَا",18,"ب",2,0],["أغمضوا دوني الجفون اللواتي","هن فجر يضل صبح العباد",19,"د",1,0],["أُغمِضُ عينىَّ عن محاسنها","والقلبُ ما تذكر الجفونُ يعى",20,"ع",2,0],["أغمضِ العينَ بعده فغريبٌ","أن ترى مثلَه وأين وأنَّى",21,"ن",2,0],["أَغمَدَ الرومُ عَن حِمايَتِها البي","ضَ وَلَم يَشرَعوا القَنا المُنآدا",22,"د",2,0],["اغمدْ سيوفك فالأعداءُ قد رقدوا","واظهروا الحبُّ لما أبطنوا الرهبا",23,"ب",2,0],["اغمدْ سيوفك فالملوك رعيةٌ","والأسْدُ شاو والزبير خوارُ",24,"ر",1,0],["أغمدت فيه صارماً طالما","تثلم الدهرُ على حده",25,"د",2,0],["أُغمِض العَينَ حينَ لاحَ وَما","ذَلِكَ إِلّا لِخَوف مَن تَدري",26,"ر",2,0],["اغمد شبا مرهفك الباتر","لا حاجة بالسيف للساحر",27,"ر",1,1],["أَغمِد في الحَربِ السَيفَ فَمِن","لَحَظاتِكَ يُشهَرُ سَيفُ عَلي",28,"ل",2,0],["اِغمد شَباكَ عن القلوب وصِد بأه","دابِ الجُفون فإِنَّهنَّ شِباكُ",29,"ك",1,0],["اِغمِد سُيوفَكَ فَالدُنيا تُعاقِبُهُم","وَنَم فَإِنَّ اللَيالي عَنكَ تَعتَقِبُ",30,"ب",1,0],["اَغمِد لِسانَكَ أَن يَقولَ فَإِنَّهُ","عَضبٌ أَحاطَ بِجانِبَيهِ فُلولُ",31,"ل",1,0],["أغمضْتُ عينَ الشعر مستسلماً","لمَّا رأيت الشَّفَقَ الأحْمَرا",32,"ر",2,0],["أغمَدْتُهم في بطن منخفض الثرى","بيضاً كأمثال السُّيوف رقاق",33,"ق",1,0],["أُغَمِّضُ اللحْظَ منه حينَ ينظُرُ عن","جفنٍ هُوَ النصلُ إِرهافاً وإِرهابا",34,"ب",2,0],["أُغْمِدَ عَنهُ حُسامُ بَأْسٍ","فقد تَكَمَّى بدرعِ صَبْرِ",35,"ر",1,0],["أغمِّض عيني منه عن كاشف العمى","وأسترُ أُذْني فيه عن مُسْمِعِ الصُّمِّ",36,"م",1,0],["أغمضوا عنا لواحظكم","قد مزجتم دمعتي بدمي",37,"م",2,0],["أغَمضتُ شكوايَ من جَورٍ فَفسَّرها","بجَمعِنا منهُ بينَ الخَصْمِ والحَكَمِ",38,"م",1,0],["أَغْمَدْتَ سيْفَكَ لكِنْ في قلوبِهِم","وَظلَّ سَيْفُكَ في غِمْدٍ من الإِحَنِ",39,"ن",1,0],["أغمادُهَا تكفيهم عن سَلِّها","رُعباً فدع عنهم سِلال البيضِ",40,"ض",1,0],["اغمدوا البيض يا ملوك البلاد","ما تريدون من رقاب العباد",41,"د",1,1],["اغم شبابك واسألن عن سبلهم","فعساك تلقى من يدل لوصلهم",42,"م",1,1],["أغمدتْه في الترب كفِّي فشلَّت","فاتَ نصري وأبتُ بالخذلان",43,"ن",1,0],["أَغمدته المَنونُ سيفاً صَقيلاً","ذكرُه في القلوب سيفٌ صقيل",44,"ل",1,0],["أغمدت دمعي عليك معترفاً","بأنّ دمعي سلاح مغلوب",45,"ب",1,0],["أَغَمْزُ عُيُونٍ وَانكسارُ حَوَاجِبِ","أمِ البرقُ في جُنْحٍ من الليل دَائبِ",46,"ب",1,1],["أَغَمّضُ أجفاني كأنّيَ نائمٌ","وقد لَجّتِ الأحشاءُ في الخَفَقَان",47,"ن",1,0],["اغمض الجفن وطاب المرقد","ومضى يحلم في شأن المصير",48,"ر",1,0],["أَغَمُّ رَبابُهُ سَرِبٌ كلاهُ","هَزيمٌ رَعدُه تَرِعُ الدِلاءِ",49,"ا",2,0],["اغمضت عنها وكنت مطلعا","وحين يحفي السوال اجملها",50,"ل",3,0],["أَغمَروا عوده فألفوهُ نبْعاً","يصرعَ الغامزين عند الصراعِ",51,"ع",1,0],["اغمدي سيفي وقولي","جم يا سيف طويلا",52,"ل",2,1],["أغمضت عيني غير فاتحها","لاُعيد أيامي بأحلامي",53,"م",2,0],["أغمضتها كيلا تراك","بها العواذل في بهاكا",54,"ك",2,0],["أُغَمِّدُ الخَيْلَ بِالهَالاتِ مُشْتَعِلاً","بِمُنتَهَايَ وَمَثْقُوبًا بِأُمْنِيتِي!",55,"ت",2,0],["أغمضت عيني لئلا أرى","ما يشغل الولهان عن شربها",56,"ب",3,0],["أغمرتني في جالٍ من نداكَ فَلَم","أجد لَها المثلَ في تعدادِ أجوادِ",57,"د",1,0],["اغمد السيف فهذي وقعة","لم تصب فيها ولمّا تظفر",58,"ر",1,0],["أغمضت حولك الجفون ونامت","ومضى الموت بالثرى والجفون",59,"ن",1,0],["أغمِّضُ عيني عن صديقي، كأنني","لديه بما يأتي من القبح جاهلُ",60,"ل",1,1],["أغمدتُ سيفي في الرقا","ب وغُلَّ حدّيه سقيتُ",61,"ت",1,0],["أغمضت أجفانها وكنت ل