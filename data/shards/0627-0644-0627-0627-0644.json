oetsgate.com/ViewPoem.aspx?id=190507",""],[5007,"إنّهَا لا تَدْرِي...مَنْ يُخْبِرُهَا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=142528",""],[5038,"سل قلبي المكلوم","https://www.poetsgate.com/ViewPoem.aspx?id=188130",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5064,"الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=199136",""],[5084,"يا راكب ٍ حمراء","https://www.poetsgate.com/ViewPoem.aspx?id=177781",""],[5120,"ابْتِسَامَةُ شَمْس","https://www.poetsgate.com/ViewPoem.aspx?id=184373",""],[5194,"باوادع الدمام","https://www.poetsgate.com/ViewPoem.aspx?id=36274",""],[5198,"طفل الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=135210",""],[4223,"قَد أَقبَلَ الشَيخُ عَلى الحِمارِ","https://www.poetsgate.com/ViewPoem.aspx?id=136666",""],[5252,"اشلونك","https://www.poetsgate.com/ViewPoem.aspx?id=36106",""],[5277,"ذاكرةُ النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=186653",""],[5277,"ترَفُ الخوالج","https://www.poetsgate.com/ViewPoem.aspx?id=191056",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5277,"بغدادُ.. ربّةُ الشوقِ..","https://www.poetsgate.com/ViewPoem.aspx?id=198540",""],[5320,"إلا الرغيف","https://www.poetsgate.com/ViewPoem.aspx?id=40159",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[592,"علماً بأن النقل نقل ثابت","https://www.poetsgate.com/ViewPoem.aspx?id=128723",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[5431,"الحب معجزة الأكوان قاطبة","https://www.poetsgate.com/ViewPoem.aspx?id=191940",""],[5431,"رجولة...كالسهم يعبرُ شامخا لن تُخضعَه!!","https://www.poetsgate.com/ViewPoem.aspx?id=198116",""],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5458,"لا أحب الآفلين","https://www.poetsgate.com/ViewPoem.aspx?id=72400",""],[5464,"طاوي الديار","https://www.poetsgate.com/ViewPoem.aspx?id=33886",""],[5490,"أقرئهُ عنّي الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=176415",""],[5490,"غفلة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=176296",""],[5525,"طير السعد","https://www.poetsgate.com/ViewPoem.aspx?id=999",""],[5561,"حبٌّ في زمن الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=192736",""],[5621,"قِبلةُ الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=24566",""],[5652,"الا السهر مع حضرتك شي ثاني ..!","https://www.poetsgate.com/ViewPoem.aspx?id=152989",""],[5652,"هآك الوعود وشمريّك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=175027",""],[5663,"نجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200904",""],[5720,"أنتَ الإِلٰهُ","https://www.poetsgate.com/ViewPoem.aspx?id=201610",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5829,"ما سواها زائل","https://www.poetsgate.com/ViewPoem.aspx?id=204861",""],[5919,"عواصف اللهِ غارات بلا مَهَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=128684",""],[5923,"لغد أقول ....... ذاك دأبي قبل يوم الأفول","https://www.poetsgate.com/ViewPoem.aspx?id=146239",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"إليك تفتحتْ ورداتُ حبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=182073",""],[5956,"لا تضربوا الحيوان","https://www.poetsgate.com/ViewPoem.aspx?id=183383",""],[5956,"إلا إلى السُّودان أخلصِ موطن","https://www.poetsgate.com/ViewPoem.aspx?id=193792",""],[5956,"إني امرؤٌ متخلف أو أين أنا من التطور؟","https://www.poetsgate.com/ViewPoem.aspx?id=194463",""],[6093,"حبيبتي كالمُنسرح","https://www.poetsgate.com/ViewPoem.aspx?id=176618",""],[6142,"أذاكر أنت أم ناس خطاب رسو","https://www.poetsgate.com/ViewPoem.aspx?id=155718",""],[6142,"في ذكره الله آخى المسلمين وسا","https://www.poetsgate.com/ViewPoem.aspx?id=155717",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""],[6177,"وهج البُردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79139&r=&rc=21",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6224,"نَبِيُّ الوجع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88199&r=&rc=14",""],[2220,"إنّ الوجودَ وجودُ ربِّكَ لا تقلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11239&r=&rc=113",""],[2220,"الحكمُ حكمُ الجبرِ والاضطرارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11469&r=&rc=343",""],[2220,"هذا الوجودُ الذي بالعرف نعرفه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11744&r=&rc=614",""]],"verses":[["إِلّا الخِلافَةَ مَيَّزَتكَ فَإِنَّني","أَنا عاطِلٌ مِنها وَأَنتَ مُطَوَّقُ",0,"ق",1,0],["إلاّ الثّناءَ الخالدَ العطِرَ الشَّذَى","يُهْدي حديثَ مَكارمِ الأخْلاقِ",1,"ق",1,0],["إلاَّ الصَّدَافَةَ فَهْيَ ذُخْرٌ خَالِدٌ","أسْمَى وَأَسْنَى مَا اكْتَسَبْتَ وَتكْسِبُ",2,"ب",1,0],["أَلا إِلّا تَكُن إِبِلٌ فَمِعزى","كَأَنَّ قُرونَ جُلَّتِها العِصِيُّ",3,"ي",1,1],["إِلّا الظِباءَ بِها كَأَنَّ نَزيبَها","ضَربُ الشِراعِ نَواحِيَ الشِريانِ",4,"ن",1,0],["إِلاَّ الْمُلُوكَ وَمَا","جَادُوا بِهِ مَنْ رَغَبْ",5,"ب",1,0],["إِلاَّ الَّذِي لَمْ يَتَّخِذْ ذُخْراً لَهُ","مِنْ صَوْلَةٍ سَلَفَتْ وَمِنْ سُلْطَانِ",6,"ن",1,0],["إِلّا الإِمامَ فَإِنَّ عادَةَ جودِهِ","مَوصولَةٌ بِزِيادَةِ المُزدادِ",7,"د",1,0],["إلا التي في لجامٍ منه قيَّدَها","فإنه سامها عزَّ وتنويها",8,"ي",3,0],["إلّا الثناءَ فإني لست أنكِرُهُ","أو الدعاءَ لذي نُعمى وآلاءِ",9,"ا",2,0],["إلا الحديث فإنهُ","مثلُ اسمه أبداً حديثْ",10,"ث",1,0],["ألا الآن إذ لم تبقَ إلا عُلالتي","أُبادر شيبي بالملاهي وأبدُر",11,"ر",1,0],["إلاَّ الطُّفولَةَ حولنا تلهو","معَ الحُبِّ الصَّغيرْ",12,"ر",1,0],["الا الحياة ففيها","عن كل شيء شذوذ",13,"ذ",1,0],["إِلّا الرَواسي وَهيَ كائِنَةٌ","كَالعُهنِ وَهيَ سَريعَةُ المَرِّ",14,"ر",1,0],["أَلا إِلى اللَهِ تَصيرُ الأُمور","ما أَنتِ يا دُنيايَ إِلّا غُرور",15,"ر",1,1],["إلا التذكُّر وهو زادٌ منهِكٌ","ماذا تقوتُ خواطري ذكراهَا",16,"ا",3,0],["أَلا أَلقوا مَقاليدَ البِلادِ وَهَل لَها","رِتاجٌ فَيُلقي أَهلُها بِالمَقالِدِ",17,"د",1,0],["إِلّا التِماحاً وَبَعضُ الوَجهِ مُنكَشِفٌ","وَالبُردُ دُوني عَلى أَسماءَ مَستُورُ",18,"ر",1,0],["إِلّا الرَجاءَ وَقَد أَنى لِيَ أَن أَدى","طَمَعاً بِكُم وَرِضاً بِغَيرِ سَدادِ",19,"د",1,0],["إِلّا الَّذي أَبصَرَتهُ العَينُ إِذ وَقَفُوا","مِنهُم وَلَو خِفتُ ما قَد كانَ لَم يَكُنِ",20,"ن",1,0],["أَلا آلُ لَيلى أَزمَعوا بِقُفولِ","وَلَم يُنظِروا ذا حاجَةٍ لِرَحيلِ",21,"ل",1,1],["إِلَّا البَعُوضَ ولا يَزالُ مُعانِداً","لإِلهِهِ بِبَعُوضَةٍ مَخْذُولا",22,"ل",2,0],["إِلّا الَّذي أَثَّرَ مِن هُدّابِهِ","تَرى سَوامَ الوَحشِ تُحتَوى بِهِ",23,"ب",2,0],["إِلّا الدِراسَةَ لِلإِنجيلِ مِن كُتُبٍ","ذِكرَ المَسيحِ بِإِبلاجٍ وَإِفصاحِ",24,"ح",1,0],["إِلّا النَبِيُّ الطاهِرُ المَيمونُ","ذَلَّت بِكَ الدُنيا وَعَزَّ الدينُ",25,"ن",1,0],["إِلّا العِراصَ وَإِلّا الهُدبَ مِن دِمَنٍ","عَلى هَدامِلِها الأَهدامُ وَالنَجَدُ",26,"د",1,0],["إِلّا الدَيارَ الَّتي مِن حَولِها وُتِدَت","لَو كانَ يُخبِرُ عَن جيرانِهِ الوَتِدُ",26,"د",1,0],["إِلّا التَمَنّي أَن أَفوزَ بِكُم","فَتَحَرَّجي يا عَبدَ مِن غَضَبي",27,"ب",2,0],["إِلّا الأَوارِيَّ لَأياً ما أُبَيِّنُها","وَالنُؤيَ كَالحَوضِ بِالمَظلومَةِ الجَلَدِ",28,"د",1,0],["إلا الأثير الذي كان","في الوجود عميما",29,"م",2,0],["إلا الألى نظموه مثلما شعروا","الناس تذعن للألفاظ تسمعها",30,"ه",2,0],["إلا الإلهُ فإن يرحم تحَلَّ به","وإن أباهُ فلا ترجوهُ من أحدِ",31,"د",1,0],["ألا الرحمن نصر نبيه","فحيا تحيات العلا ذلك الحيا",32,"ي",2,0],["إلا الصداقَة َ فهي ذُخْرٌ خالدٌ","أسْمى وأسْنى ما اكْتَسَبْتَ وتَكْسِبُ",33,"ب",1,0],["إِلاَّ التَّمَنِّي أنْ أفُورَ بِكُمْ","فتحرَّجي يا \"عبدَ\" من غضبي",34,"ب",2,0],["الاّ القليل اللّي أجمعو دنيا ودين","صغار لاكنهم بما سووّّ .. كبار",35,"ر",1,0],["الاّ الرفيق اللّي يستغل طيب الرفيق","هذي اللّي ماهيب مقبوله ولا .. ممكنه",36,"ن",2,0],["الا النبي الهاشمي المصطفى","روح الوجود ورحمة الرحمن",37,"ن",1,0],["إِلّا الثِمادَ فَما يَنفَكُّ يَحفِرُها","في رَأَسِ شاهِقَةٍ عَيطاءَ مِظلالِ",38,"ل",1,0],["إلا التهيي للصلاةِ إِنها","ريحك والإِسلام مالُ المتجرِ",39,"ر",1,0],["إلا الثقات من النساء فهنّ إن","فتّشت أكبر غاية الآمال",40,"ل",1,0],["إلا الدراهم وهيَ غير مجيبة","ويجيب ما لم أدعه إفلاسي",41,"س",2,0],["إلا السلامة ممّا","يضرّني ويسرّه",42,"ر",2,0],["إلّا الأراقم والعقا","رب والثعالب والكلاب",43,"ب",1,0],["إلاّ العزيزَ فإنّه مَلِكٌ","كلُّ افتخارٍ عن عُلاه عَمي",44,"م",2,0],["إلا التي استخلصتُها وهْيَ لم","يَبْلُغُ مَدَى العمرِ لها شهرا",45,"ر",2,0],["أَلاَ الحمْدُ للهِ الذِي مِنْهُ إِرْشَادِي","وَتَعْلِيمُ جَهْلِي وَالصَّلاَةُ عَلَى الْهَادِي",46,"د",2,1],["إِلّا الجَآذِرَ تَمتَري بِأُنوفِها","عوذاً إِذا تَلَعَ النَهارُ تَعَطَّفُ",47,"ف",1,0],["إِلّا أَلِيَّةَ صادِقٍ بَرٍّ بِمَن","فيهِم أَتى لا في سِواهُم هَل أَتى",48,"ت",2,0],["إِلاَّ الشَّبابَ فلا يلوي، وَذاكرُهُ","مِمّا يُكابدُ لا ينفَكُّ محزونا",49,"ن",2,0],["إِلا الأَثافي ضَبَتها النارُ تَلفَحُها","وَهامِدٌ بَينَها في لَونِهِ طَحَلُ",50,"ل",1,0],["إلا الغَسِيلَ على الغَسِيلِ","كَذا علي مَرِّ الزَّمَنْ",51,"ن",1,0],["إِلّا النَدى وأمين المَجد ناشره","مروي الظما ذو المَعالي سَيّد الأُمَرا",52,"ر",2,0],["إِلّا النَدى وأمين المَجد باذله","مروي الظما ذو المَعالي سَيّد النبلا",53,"ل",2,0],["إِلّا النَدى وأمين المَجد واهبه","مروي الظما ذو المَعالي سَيّد النجبا",54,"ب",2,0],["إلاّ العِبادِيَّ زيْداً عند مَوقفِه","مُترجِماً عند كِسْرَى قَولَ نُعْمان",55,"ن",1,0],["إلاّ النّبيَّ والعِتَر","أَقبلَ لا يَمْشي الخَمَر",56,"ر",1,0],["إلاّ الأميرُ الماجِدُ المُرتَجي","نَواله الواهِبُ السُناح",57,"ح",1,0],["إلّا التي بسمُوِّها","كلَّ الفضائل حاويه",58,"ي",2,0],["إلّا الملاذ الملتجا","ومليحه أبداً مليحه",59,"ح",2,0],["إلّا الذي قد ذاق لذة نفعه","لتواضعٍ والكبريا لم يأتها",60,"ت",3,0],["الا الحمام الورق والغطاطا","فهن يلغطن به الغاطا",61,"ط",2,0],["إلا الأضاليل ومن لا يَزَل","يُوفي على مهلكه يَعصَب",62,"ب",1,0],["إلا الذي حلَّ السما وأنى","بمنافع جلَّتْ عن الحصر",63,"ر",1,0],["إلا الذين وفوا بعهد منكم","فإلى انقضاء العهد منكم ساعدوا",64,"د",3,0],["إلا التفاؤل يبدو من مخائلها","وإن سما فوق تكييفي وحسباني",65,"ن",2,0],["إلا المحبّة فالكريمُ بطبعه","يجدُ الكرامَ الأبعدين أدانيا",66,"ي",2,0],["إلا الخلودَ فتملَّ خالدا","كما تشاء وبرغم من رغِمْ",67,"م",1,0],["إِلّا الفَتى الصَبّارُ في النْ","نَجداتِ وَالفَرَسُ الوَقاحُ",68,"ح",1,0],["إلا العلوَّ عن العقوبةِ بعدما","ظفِرَت يداكَ بمُستَكينٍ خاضعِ",69,"ع",1,0],["إلا الذي يؤمن بالغيب لا","يقنع بالعقل وتصويره",70,"ر",2,0],["إلا الخروج عن طريق عدله","كمثل ما قد عودوا من قبله",71,"ه",1,0],["إِلّا التَزاوُرَ فَوقَ كُلِّ مُقَلَّصٍ","يَهدي الجِيادَ إِلى الخَميسِ أَغارا",72,"ر",2,0],["إِلّا الَّذي أَورَثَت كَثيرَةُ في ال","قَلبِ وَلِلحُبِّ سَورَةٌ عَجَبُ",73,"ب",1,0],["الا الرئيس فانه البحر الذي","حكما يفيض إذا ارتقى يتكلم",74,"م",1,0],["إلاّ الحمدُ للهِ حمداً كثيراً","وليِّ المحامدِ ربّاً غفورا",75,"ر",2,1],["إلا النبي رسول الله إن له","فضلاً وأنت بذاك الفضل تفتخر",76,"ر",1,0],["الا الأمير ابو الندى والمجد عثمان","الهمام الاصبد التمتام",77,"م",1,0],["إِلّا الإِمامَ المُرتَقي أَوجَ السُّهى","أَعني الهُمامَ اللّوذَعي الأَوحَدا",78,"د",2,0],["إلا الوصال بعد طول الهجر","ثم أراد سيدي وداعي",79,"ي",1,0],["إلاّ الدواءَ من الحبي","بِ ببلوغ الأُمْنِيَهْ",80,"ي",2,0],["إلاّ الَّذِيْ يَخْرُجُ بِالدَّلِيْلِ","وَلَيْسَ لِلاِخْراجِ مِنْ دَلِيْلِ",81,"ل",1,0],["إلا الذي يضر بالأبدان","أو غيرها فذاك شيء ثان",82,"ن",1,0],["ألا الرجاء بانها أرخت قد","طلبت لاعلى تاج ملك خالدِ",83,"د",1,0],["إِلا الَّذي أَبدوه في الشطرنج","لِلناس مِن علم سَديد النهج",84,"ج",1,0],["إِلا الإِله القادر الغَفور","بِلُطفِه ينجبر الكَسير",85,"ر",1,0],["الا الذي وضعته في الاول","من نصبها على اختلاف العمل",86,"ل",1,0],["ألا إلى اللّه الأمور صائرة","بعون لا إله إلا اللّه",87,"ه",1,0],["إلا إلى جهة تحدّد جَوهراً","متلبساً عرضاً تحقق موقفه",88,"ف",2,0],["إلا الذي بلطفه صفاه","بحق لا إله إلا اللّه",89,"ه",1,0],["إِلّا القَليلَ فَقَد وَجَدتُ ذَوي","عَهدٍ وَشُكرٍ أَيّما شُكرِ",90,"ر",1,0],["إلاَّ التُّقى معه أخوه","صالحٌ منها بذروه",91,"و",2,0],["إلّا الثناء فإن ترضى به بدلاً","سامت به مدحي الحسناء حسّانا",92,"ن",2,0],["إلا المقادر فاستهيم فؤاده","من أن رأى ذهبا يزين غزالا",93,"ل",2,0],["إِلّا الحَبيب الَّذي شغفت بِهِ","فَإِنَّهُ رقيَتي وَترياقي",94,"ق",2,0],["الا اليه فذا النجا","ة وذا الطريق المشتهر",95,"ر",1,0],["إلا الفضائل والتّقوى وكلّ يدٍ","مأثورةٍ فهي في عقد الثّن