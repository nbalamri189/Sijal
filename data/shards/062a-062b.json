/www.aldiwan.net/poem41401.html","الخفيف"],[433,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[433,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[433,"ومسامر تسليك عن سنة الكرى","https://www.aldiwan.net/poem12628.html","الكامل"],[433,"وأهيف أبقى من طلابي كله","https://www.aldiwan.net/poem12678.html","الطويل"],[459,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[462,"أبا الفوارس والأيام شاهدة","https://www.aldiwan.net/poem15151.html","البسيط"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[465,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[465,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[465,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[465,"تثنت من الأعطاف مخطفة سمر","https://www.aldiwan.net/poem3483.html","عموديه"],[465,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[478,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[480,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[501,"تثبت ولا تغضب إذا راح كاذب","https://www.aldiwan.net/poem37559.html","الطويل"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[516,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[552,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[560,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[563,"ماذا شعوب بني عثمان تنتظر","https://www.aldiwan.net/poem52830.html","البسيط"],[568,"رأيت الرياسة مقرونة","https://www.aldiwan.net/poem69475.html","المتقارب"],[568,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[576,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"]],"verses":[["تثنّى بالصليب ولو تثنى","لمفتي صلب عيسى لاستتابا",0,"ب",2,0],["تَثورُ إِلَيهِ سَوامُ اللِحاظِ","وَتَسرَحُ مِن حُسنِهِ في مَسامِ",1,"م",1,0],["تَثْني الخِلافَةُ عِطْفَيها بهِ جَذَلاً","لا زالَ يَسْتَنُّ في أعطافِها الجَذَلُ",2,"ل",1,0],["تُثْني رُباهُ على الغَمامِ إذا غَدا","عافِي النَّسيمِ بِسِرِّها يتكَلَّمُ",3,"م",1,0],["تُثْنِي عَلَيْكَ رَعِيَّةٌ آمَالُهَا","فِي أَنْ تَفُوزَ يَدَاكَ بِالآمَالِ",4,"ل",1,0],["تَثُجُّ رُواياهُ إِذا الرَعدُ زَجَّها","بِشابَةَ فَالقُهبِ المَزادَ المُحَذلَما",5,"م",2,0],["تُثْنِي وَتَرْعَى بِعُيُونِ الرِّضَا","جُهْدَ الرِّجَالِ الصُّبُرِ الْغُلْبِ",6,"ب",1,0],["تَثْقِيفُ أَبْنَائِكُمْ فِيهِ النَّجَاهِ لَكُمْ","مِنَ المَذَلاَّتِ وَالعِلاَّتِ وَالإِحَنِ",7,"ن",1,0],["تُثْنِي عَلَى الشَّهْمِ الَّذِي عَاشَ فِي","رِبَاعِهَا مَا عَاشَ مِنْ غَيْرِ ذَامْ",8,"م",1,0],["تَثني النِقابَ عَلى عِرنينِ أَرنَبَةٍ","شَمّاءَ مارِنُها بِالمِسكِ مَرثومُ",9,"م",1,0],["تَثَوَّرَ في قَرنِ الضُحى مِن شَقيقَةٍ","فَأَقبَلَ أَو مِن حِضنٍ كَبداءَ عاقِرِ",10,"ر",1,0],["تثب الوثبة الخفيفة كالبر","ق صعوداً في رقصها وصبوبا",11,"ب",2,0],["تَثَنَّت فَغُصنٌ ناعِمٌ أَم شَمائِلٌ","وَوَلَّت فَلَيلٌ فاحِمٌ أَم غَدائِرُ",12,"ر",1,0],["تثنت على رغمِ القلى وتربعت","لو صلي بحمى العاذلات مثلثه",13,"ث",2,0],["تثقف مثل أعالي الشآم","بما اشتعل الدهر من لفحه",14,"ح",2,0],["تثني شذاهُ على الغمام كما","تثني على سادتي أناشيدي",15,"د",2,0],["تثنى قضيباً فاح مسكاً رنا طلاً","سطا أسداً غنى حماماً بدا بدرا",16,"ر",2,0],["تثيرُ عَجاجةً وتثيرُ حُمَّى","لعذبِ الماء طُرّاً والشَّروبِ",17,"ب",1,0],["تَثني لِراويها الوَسائِدَ عِزَّةً","وَيَظَلُّ في النادي بِها مُتَصَدِّرا",18,"ر",2,0],["تُثيرُ وَتُبدي عَن دِيارٍ بِنَجوَةٍ","أَضَرَّ بِها مِن ذي البِطاحِ خَليجُ",19,"ج",1,0],["تَثَبَّتَ هُناك وَأَنّ القُلو","بَ بَينَ الضُلوع لَتأبى الفِرارا",20,"ر",2,0],["تُثابُ بِغاليهِ وَتُجزى بِطُهرِهِ","إِلى البَعثِ أَشلاءٌ لَهُم وَرُفاتُ",21,"ت",1,0],["تَثورُ وَتَستَأني وَتَنأى وَتَدَّني","وَتَغدو بِما تَغدي وَتَرمي وَتَنشُبُ",22,"ب",1,0],["تَثَنّى عَلى قَدرِ الطِعانِ كَأَنَّما","مَفاصِلُها تَحتَ الرِماحِ مَراوِدُ",23,"د",1,0],["تُثيرُ عَلى سَلَميَةَ مُسبَطِرّاً","تَناكَرُ نَحتَهُ لَولا الشِعارُ",24,"ر",1,0],["تَثوبُ حالُ الفَتى وَإِن لَجَّ صَر","فُ الدَهرِ يَجني عَلَيهِ أَو يَتِرُه",25,"ر",2,0],["تَثَنّى عَلى قَدٍّ غَريبٍ قَوامُهُ","وَتَضحَكُ عَن مُستَعذَبٍ أَفلَجِ الرَصفِ",26,"ف",1,0],["تَثني بَوادِرَهُ الأَناةُ وَرُبَّما","سارَت عَزيمَتُهُ فَكانَت جَحفَلا",27,"ل",2,0],["تَثَنّى الرِماحُ وَالحَربُ مَشبو","بُن لَظاها تَثَنّى الخَيزُرانِ",28,"ن",1,0],["تُثَمِّرُ مالُ الباهِلِيَّ كَأَنَّما","تَهِرُّ عَلى المالِ الَّذي أَنتَ كاسِبُه",29,"ب",2,0],["تَثاقَلُ أَركانٌ عَلَيهِ ثَقيلَةٌ","كَأَركانِ سَلمى أَو أَعَزُّ وَأَكثَفُ",30,"ف",1,0],["تُثيرُ قَعاقِعَ الأَلحى إِذا ما","تَلاقَت هاجِدَ العَرَقِ النِيامِ",31,"م",1,0],["تُثيرُ الصَّبا في الجَوِّ منه عَجاجَةً","كما انتشَرَ الكافورُ وهو سَحيقُ",32,"ق",1,0],["تثنى مثقلة منها مخففة","كأنما قسمت قضباً وأخفافا",33,"ف",2,0],["تُثفِّتحُ زَهْرَةَ الآمالِ فيها","فُتوحٌ لا يُقَدُّ لها بَريدُ",34,"د",1,0],["تَثني الدُّجى عن لونِه","فيعودُ مُبْيَضَّ الحِجاب",35,"ب",1,0],["تثِّني البرقِ يُذكِرُني الثَّنايا","على أثناءِ دجلةَ والشِّعابا",36,"ب",2,0],["تَثَنّى عَلى لَحظِ العُيونِ إِذا مَشَت","تَثَنِّيَ غُصنِ البانَةِ المُتَأَوِّدِ",37,"د",1,0],["تُثني عَليكَ الوَرى وَما شَهِدوا","مِنَ السَجايا إِلّا بِما عَلِموا",38,"م",3,0],["تَثَنّتْ بِعِطفَيها عنِ العِطفِ وانثَنتْ","كنشوانَ في بَرْدِ الصّبا مُتَرَنّحِ",39,"ح",1,0],["تُثَفّى الحَربُ مِنهُ حينَ تَغلي","مَراجِلُها بِشَيطانٍ رَجيمِ",40,"م",1,0],["تَثَبَّت إِنَّ قَولاً كانَ زوراً","أَتى النُعمانَ قَبلَكَ عَن زِيادِ",41,"د",1,0],["تُثني بِهِ ريحُ المَكارِمِ خوطَةً","في حَيثُ تَسجَعُ أَلسُنُ الشُعَراءِ",42,"ا",2,0],["تَثاءَبَ مِن مَسِّ الطَوى فَهوَ يَشتَكي","فَيَعوي وَقَد لَفَّتهُ نَكباءُ صَرصَرُ",43,"ر",1,0],["تَثني مَعاطِفَها اِهتِزازَ بَشاشَةٍ","تَترى وَخَفَّ بِها السُرورُ وَقارا",44,"ر",2,0],["تثورُ فلا تُريدُ سِوَى طعامٍ","ولا يَفْنَى القِرَى في المُطعميا",45,"ي",2,0],["تثور فتملأ الآفاقَ رُعباً","إذا ملأوا الفضاءَ مُحلِّقينا",45,"ن",2,0],["تَثِبُ العَزائِمُ مِنكَ في دَمِ أُمَّةٍ","تَأبى الهَوادَةَ أَو يَفيضَ سِجالا",46,"ل",2,0],["تَثورُ شُعوبُ العالَمينَ وَيَنطَوي","عَلى الذُلِّ شَعبٌ في السَكينَةِ راغِبُ",47,"ب",1,0],["تَثورُ فَتَمحو كُلَّ حِصنٍ وَتَرتَمي","فَتَمسَحُ مَقذوفاتُها كُلَّ جَحفَلِ",48,"ل",1,0],["تَثاقَلَ إِذ رَفَعتُ إِلَيهِ صَوتي","وَخَفَّ لَهُ الرَكينُ مِنَ الجِبالِ",49,"ل",1,0],["تَثورُ وَتَسكُنُ تَقضي الأُمورَ","فَتَطفو الحَوادِثُ أَو تَرسُبُ",50,"ب",1,0],["تَثَقَّلت عن كبِدي والحَشَا","فَكابَدتِ النَّفسُ أهوالَهَا",51,"ل",3,1],["تَثورُ كَأَنَّ الماءَ يَلسَعُ صِرفَها","وَصَوتُ المُغَنّي مِثلُ هَينَمَةِ الراقي",52,"ق",2,0],["تُثني عَلى كَرَمِ الوَلِيِّ بِنَفحَةٍ","عَن مِسكِ دارينٍ تَفُضُّ خِتاما",53,"م",2,0],["تَثني عَلى الحاذَينِ ذاخُصَلٍ","تَعمالُهُ الشَذَرانِ وَالخَطَرُ",54,"ر",1,0],["تَثاقَلتُ إِلاّ عَن يَدٍ أَستَفيدُها","وَزَورَةِ أَملاكٍ أَشُدُّ لَها أَزري",55,"ر",2,0],["تُثيرُ بِها وَاللَيلُ مُلقٍ رُواقَهُ","هُجودَ القَطا مُستَوقِداً غَيرَ هاجِدِ",56,"د",1,0],["تَثوبُ لَكَ القَبائِلُ مُجلِباتٍ","كَما ثابَت عَلى النُصُبَينِ عادُ",57,"د",1,0],["تَثاقَلَتِ الذَلفاءُ عَنّي وَما دَرَت","بِذي كَبِدٍ حَرّى يَغَصُّ قَريحُها",58,"ح",3,0],["تَثاقَلَ لَيلي فَما أَبرَحُ","وَنامَ الصَباحُ فَما أُصبِحُ",59,"ح",1,1],["تَثاءَبَ عَمروٌ إِذ تَثاءَبَ خالِدٌ","بِعَدوى فَما أَعَدَتنِيَ الثُؤباءُ",60,"ب",3,0],["تُثنى الخَناصِرُ في الكِرامِ عَلَيهُمُ","وَتُمَدُّ نَحوَ سِناهُمُ الأَجيادُ",61,"د",1,0],["تُثَقِّبُهُ مولَعاتٍ بِهِ","وَلَو لَم تَزُرهُ تَهاوى فَمَر",62,"ر",1,0],["تَثوبُ عَلَيهِم مِن أَبانٍ وَشُرمَةٍ","وَتَركَبُ مِن أَهلِ القَنانِ وَتَفزَعُ",63,"ع",1,0],["تثير ديارهم حزناً بقلبي","وتوحشني التهائم والنجودُ",64,"د",1,0],["تثبَّط مقيماً في مكانك وانتظر","إلى الصبح إن الصبح قد لَيس يبعد",65,"د",1,0],["تثير دخاناً من الجانبي","نِ وجه السماء به أقتم",66,"م",1,0],["تثور الشياطينُ من عطرها","كمجمرة الساحر الملتثمْ",67,"م",1,0],["تُثْني عليكَ البلادُ أنّكَ لا","تأخذُ مِن رِفْدِها وتَرْفِدُها",68,"د",3,1],["تَثِبِينَ مِنْ مُتَرَبَّعٍ","أَبَداً إِلَى مُترَبَّعِ",69,"ع",1,0],["تِثبُ اللِّحاظُ إِليْهِ مِنْ غرَقٍ","بِدمُوعِهَا فترَى بِهِ بِشْرَا",70,"ر",2,0],["تثور زوابع الصحراء حولي","وأحلم بالورود وبالأقاحي",71,"ح",2,0],["تَثني مَعاطِفها الغُصونُ وَما لَهُ","بَينَ الغُصونِ مِنَ الحَياءِ حَسيسُ",72,"س",1,0],["تَثِبُ الشّمسُ في السماءِ وشَمْسي","عُقِلَتْ دُونَها بألْفِ عِقَالِ",73,"ل",1,0],["تَثْني إليكَ القوافي","أعناقَها حين تُثني",74,"ن",2,0],["تَثِبُ الْجِبَالَ وَمَالَهَا","بَيْنَ الْكَوَاكِبِ مِنْ مصَدِّ",75,"د",1,0],["تثَّنت يوم أن بعثتك عِطفًا","ومالت يوم عُدتَ لها بجيد",76,"د",1,0],["تثني عليك الضاد ملءَ لهَاتها","إن كان يجزيك الثناء، وقلَّما",77,"م",2,0],["تثلم حدُّ السيف وانقصف القنا","وأصبح لا طعن هناك ولا ضرب",78,"ب",1,0],["تُثِيرُ بِهَا والليلُ مُلْقٍ رُوَاقَهُ","هجود القطا مستوقد غير هاجد",79,"د",1,0],["تثنت فيا خجلتا للغصون","وغنت فيا خجلتا للقصب",80,"ب",1,1],["تثَّبتْ لا ترعُكَ فليس عدلاً","ولا عَّودتَ نفسكَ أنْ تُراعا",81,"ع",2,0],["تثور به للموت أبية","وتأبى سوى عاداتهن الطبائع",82,"ع",1,0],["تثير في قلبي شكوك الهوى","لاذعة ثمّ تريد اليقين",83,"ن",1,0],["تثبت يا فؤاد فكل نشر","له طي ويفنى الكل مهما",84,"م",2,0],["تثاقل ما استطعت وانت تدري","بخف العشق يا سعد الجبالا",85,"ل",2,0],["تثور اذا الدجا دارت رحاه","ويشبع خدك الدمع انهمالا",85,"ل",2,0],["تثور مع الجمال اليه روحي","اذا امت مغانيه الجمال",86,"ل",1,0],["تثبت يا فؤاد فأي شيء","يصح له الآمان من الزوال",87,"ل",1,0],["تثاقل في حقوق الود كبرا","وخفف بالهوى وزن الرجاح",88,"ح",1,0],["تثاب بالحرق من حمل يجشمها","سخامه سحنة سوداء كالقار",89,"ر",1,0],["تَثَنَّت بِدِعصٍ فَوقَ دِعصٍ فَخِلتُهَا","مِنَ ألبَانِ غُصناً نَاعِماً مُتَثَنَيَا",90,"ي",2,0],["تثبت العقل وتمحوه كما","شاء من فجر وف البدء ضياها",91,"ه",2,0],["تثني على الملكِ الذي أيامُهُ","سترٌ على هذا الورى مسدولُ",92,"ل",1,0],["تُثنِى عواذله عليه بعذلهم","ولربّما نشَرَ الثناءَ اللُّوَّمُ",93,"م",1,0],["تُثني عَلَيهِ فَتَعتَريهِ نَشوَةٌ","فَكَأَنَّ مادِحَهُ سَقاهُ شَمولا",94,"ل",2,0],["تُثْنَى إِلَيْهِ أَعِنَّةُ الرَّوْعِ الَّذي","يَدَعُ الجَوادَ مِنَ الأَمَانِ هَجِي