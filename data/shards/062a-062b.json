sgate.com/ViewPoem.aspx?id=179696",""],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[50,"مللت مبيتي بالقرين وشاقني","https://www.poetsgate.com/ViewPoem.aspx?id=21804",""],[98,"لجام الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=55305",""],[90,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""]],"verses":[["تَثورُ إِلَيهِ سَوامُ اللِحاظِ","وَتَسرَحُ مِن حُسنِهِ في مَسامِ",0,"م",1,0],["تَثْني الخِلافَةُ عِطْفَيها بهِ جَذَلاً","لا زالَ يَسْتَنُّ في أعطافِها الجَذَلُ",1,"ل",1,0],["تُثْني رُباهُ على الغَمامِ إذا غَدا","عافِي النَّسيمِ بِسِرِّها يتكَلَّمُ",2,"م",1,0],["تُثْنِي عَلَيْكَ رَعِيَّةٌ آمَالُهَا","فِي أَنْ تَفُوزَ يَدَاكَ بِالآمَالِ",3,"ل",1,0],["تَثُجُّ رُواياهُ إِذا الرَعدُ زَجَّها","بِشابَةَ فَالقُهبِ المَزادَ المُحَذلَما",4,"م",2,0],["تُثْنِي وَتَرْعَى بِعُيُونِ الرِّضَا","جُهْدَ الرِّجَالِ الصُّبُرِ الْغُلْبِ",5,"ب",1,0],["تَثْقِيفُ أَبْنَائِكُمْ فِيهِ النَّجَاهِ لَكُمْ","مِنَ المَذَلاَّتِ وَالعِلاَّتِ وَالإِحَنِ",6,"ن",1,0],["تُثْنِي عَلَى الشَّهْمِ الَّذِي عَاشَ فِي","رِبَاعِهَا مَا عَاشَ مِنْ غَيْرِ ذَامْ",7,"م",1,0],["تَثني النِقابَ عَلى عِرنينِ أَرنَبَةٍ","شَمّاءَ مارِنُها بِالمِسكِ مَرثومُ",8,"م",1,0],["تَثَوَّرَ في قَرنِ الضُحى مِن شَقيقَةٍ","فَأَقبَلَ أَو مِن حِضنٍ كَبداءَ عاقِرِ",9,"ر",1,0],["تثب الوثبة الخفيفة كالبر","ق صعوداً في رقصها وصبوبا",10,"ب",2,0],["تَثَنَّت فَغُصنٌ ناعِمٌ أَم شَمائِلٌ","وَوَلَّت فَلَيلٌ فاحِمٌ أَم غَدائِرُ",11,"ر",1,0],["تثنت على رغمِ القلى وتربعت","لو صلي بحمى العاذلات مثلثه",12,"ث",2,0],["تثقف مثل أعالي الشآم","بما اشتعل الدهر من لفحه",13,"ح",2,0],["تثني شذاهُ على الغمام كما","تثني على سادتي أناشيدي",14,"د",2,0],["تثنى قضيباً فاح مسكاً رنا طلاً","سطا أسداً غنى حماماً بدا بدرا",15,"ر",2,0],["تثيرُ عَجاجةً وتثيرُ حُمَّى","لعذبِ الماء طُرّاً والشَّروبِ",16,"ب",1,0],["تَثني لِراويها الوَسائِدَ عِزَّةً","وَيَظَلُّ في النادي بِها مُتَصَدِّرا",17,"ر",2,0],["تُثيرُ وَتُبدي عَن دِيارٍ بِنَجوَةٍ","أَضَرَّ بِها مِن ذي البِطاحِ خَليجُ",18,"ج",1,0],["تَثَبَّتَ هُناك وَأَنّ القُلو","بَ بَينَ الضُلوع لَتأبى الفِرارا",19,"ر",2,0],["تُثابُ بِغاليهِ وَتُجزى بِطُهرِهِ","إِلى البَعثِ أَشلاءٌ لَهُم وَرُفاتُ",20,"ت",1,0],["تَثورُ وَتَستَأني وَتَنأى وَتَدَّني","وَتَغدو بِما تَغدي وَتَرمي وَتَنشُبُ",21,"ب",1,0],["تَثَنّى عَلى قَدرِ الطِعانِ كَأَنَّما","مَفاصِلُها تَحتَ الرِماحِ مَراوِدُ",22,"د",1,0],["تُثيرُ عَلى سَلَميَةَ مُسبَطِرّاً","تَناكَرُ نَحتَهُ لَولا الشِعارُ",23,"ر",1,0],["تَثوبُ حالُ الفَتى وَإِن لَجَّ صَر","فُ الدَهرِ يَجني عَلَيهِ أَو يَتِرُه",24,"ر",2,0],["تَثَنّى عَلى قَدٍّ غَريبٍ قَوامُهُ","وَتَضحَكُ عَن مُستَعذَبٍ أَفلَجِ الرَصفِ",25,"ف",1,0],["تَثني بَوادِرَهُ الأَناةُ وَرُبَّما","سارَت عَزيمَتُهُ فَكانَت جَحفَلا",26,"ل",2,0],["تَثَنّى الرِماحُ وَالحَربُ مَشبو","بُن لَظاها تَثَنّى الخَيزُرانِ",27,"ن",1,0],["تُثَمِّرُ مالُ الباهِلِيَّ كَأَنَّما","تَهِرُّ عَلى المالِ الَّذي أَنتَ كاسِبُه",28,"ب",2,0],["تَثاقَلُ أَركانٌ عَلَيهِ ثَقيلَةٌ","كَأَركانِ سَلمى أَو أَعَزُّ وَأَكثَفُ",29,"ف",1,0],["تُثيرُ قَعاقِعَ الأَلحى إِذا ما","تَلاقَت هاجِدَ العَرَقِ النِيامِ",30,"م",1,0],["تُثيرُ الصَّبا في الجَوِّ منه عَجاجَةً","كما انتشَرَ الكافورُ وهو سَحيقُ",31,"ق",1,0],["تثنى مثقلة منها مخففة","كأنما قسمت قضباً وأخفافا",32,"ف",2,0],["تُثفِّتحُ زَهْرَةَ الآمالِ فيها","فُتوحٌ لا يُقَدُّ لها بَريدُ",33,"د",1,0],["تَثني الدُّجى عن لونِه","فيعودُ مُبْيَضَّ الحِجاب",34,"ب",1,0],["تثِّني البرقِ يُذكِرُني الثَّنايا","على أثناءِ دجلةَ والشِّعابا",35,"ب",2,0],["تَثَنّى عَلى لَحظِ العُيونِ إِذا مَشَت","تَثَنِّيَ غُصنِ البانَةِ المُتَأَوِّدِ",36,"د",1,0],["تُثني عَليكَ الوَرى وَما شَهِدوا","مِنَ السَجايا إِلّا بِما عَلِموا",37,"م",3,0],["تَثَنّتْ بِعِطفَيها عنِ العِطفِ وانثَنتْ","كنشوانَ في بَرْدِ الصّبا مُتَرَنّحِ",38,"ح",1,0],["تُثَفّى الحَربُ مِنهُ حينَ تَغلي","مَراجِلُها بِشَيطانٍ رَجيمِ",39,"م",1,0],["تَثَبَّت إِنَّ قَولاً كانَ زوراً","أَتى النُعمانَ قَبلَكَ عَن زِيادِ",40,"د",1,0],["تُثني بِهِ ريحُ المَكارِمِ خوطَةً","في حَيثُ تَسجَعُ أَلسُنُ الشُعَراءِ",41,"ا",2,0],["تَثاءَبَ مِن مَسِّ الطَوى فَهوَ يَشتَكي","فَيَعوي وَقَد لَفَّتهُ نَكباءُ صَرصَرُ",42,"ر",1,0],["تَثني مَعاطِفَها اِهتِزازَ بَشاشَةٍ","تَترى وَخَفَّ بِها السُرورُ وَقارا",43,"ر",2,0],["تثورُ فلا تُريدُ سِوَى طعامٍ","ولا يَفْنَى القِرَى في المُطعميا",44,"ي",2,0],["تثور فتملأ الآفاقَ رُعباً","إذا ملأوا الفضاءَ مُحلِّقينا",44,"ن",2,0],["تَثِبُ العَزائِمُ مِنكَ في دَمِ أُمَّةٍ","تَأبى الهَوادَةَ أَو يَفيضَ سِجالا",45,"ل",2,0],["تَثورُ شُعوبُ العالَمينَ وَيَنطَوي","عَلى الذُلِّ شَعبٌ في السَكينَةِ راغِبُ",46,"ب",1,0],["تَثورُ فَتَمحو كُلَّ حِصنٍ وَتَرتَمي","فَتَمسَحُ مَقذوفاتُها كُلَّ جَحفَلِ",47,"ل",1,0],["تَثاقَلَ إِذ رَفَعتُ إِلَيهِ صَوتي","وَخَفَّ لَهُ الرَكينُ مِنَ الجِبالِ",48,"ل",1,0],["تَثورُ وَتَسكُنُ تَقضي الأُمورَ","فَتَطفو الحَوادِثُ أَو تَرسُبُ",49,"ب",1,0],["تَثَقَّلت عن كبِدي والحَشَا","فَكابَدتِ النَّفسُ أهوالَهَا",50,"ل",3,1],["تَثورُ كَأَنَّ الماءَ يَلسَعُ صِرفَها","وَصَوتُ المُغَنّي مِثلُ هَينَمَةِ الراقي",51,"ي",1,0],["تُثني عَلى كَرَمِ الوَلِيِّ بِنَفحَةٍ","عَن مِسكِ دارينٍ تَفُضُّ خِتاما",52,"م",2,0],["تَثني عَلى الحاذَينِ ذاخُصَلٍ","تَعمالُهُ الشَذَرانِ وَالخَطَرُ",53,"ر",1,0],["تَثاقَلتُ إِلاّ عَن يَدٍ أَستَفيدُها","وَزَورَةِ أَملاكٍ أَشُدُّ لَها أَزري",54,"ي",1,0],["تُثيرُ بِها وَاللَيلُ مُلقٍ رُواقَهُ","هُجودَ القَطا مُستَوقِداً غَيرَ هاجِدِ",55,"د",1,0],["تَثوبُ لَكَ القَبائِلُ مُجلِباتٍ","كَما ثابَت عَلى النُصُبَينِ عادُ",56,"د",1,0],["تَثاقَلَتِ الذَلفاءُ عَنّي وَما دَرَت","بِذي كَبِدٍ حَرّى يَغَصُّ قَريحُها",57,"ح",3,0],["تَثاقَلَ لَيلي فَما أَبرَحُ","وَنامَ الصَباحُ فَما أُصبِحُ",58,"ح",1,1],["تَثاءَبَ عَمروٌ إِذ تَثاءَبَ خالِدٌ","بِعَدوى فَما أَعَدَتنِيَ الثُؤباءُ",59,"ب",3,0],["تُثنى الخَناصِرُ في الكِرامِ عَلَيهُمُ","وَتُمَدُّ نَحوَ سِناهُمُ الأَجيادُ",60,"د",1,0],["تُثَقِّبُهُ مولَعاتٍ بِهِ","وَلَو لَم تَزُرهُ تَهاوى فَمَر",61,"ر",1,0],["تَثوبُ عَلَيهِم مِن أَبانٍ وَشُرمَةٍ","وَتَركَبُ مِن أَهلِ القَنانِ وَتَفزَعُ",62,"ع",1,0],["تثير ديارهم حزناً بقلبي","وتوحشني التهائم والنجودُ",63,"د",1,0],["تثبَّط مقيماً في مكانك وانتظر","إلى الصبح إن الصبح قد لَيس يبعد",64,"د",1,0],["تثير دخاناً من الجانبي","نِ وجه السماء به أقتم",65,"م",1,0],["تثور الشياطينُ من عطرها","كمجمرة الساحر الملتثمْ",66,"م",1,0],["تُثْني عليكَ البلادُ أنّكَ لا","تأخذُ مِن رِفْدِها وتَرْفِدُها",67,"د",3,1],["تَثِبِينَ مِنْ مُتَرَبَّعٍ","أَبَداً إِلَى مُترَبَّعِ",68,"ع",1,0],["تِثبُ اللِّحاظُ إِليْهِ مِنْ غرَقٍ","بِدمُوعِهَا فترَى بِهِ بِشْرَا",69,"ر",2,0],["تثور زوابع الصحراء حولي","وأحلم بالورود وبالأقاحي",70,"ي",1,0],["تَثني مَعاطِفها الغُصونُ وَما لَهُ","بَينَ الغُصونِ مِنَ الحَياءِ حَسيسُ",71,"س",1,0],["تَثِبُ الشّمسُ في السماءِ وشَمْسي","عُقِلَتْ دُونَها بألْفِ عِقَالِ",72,"ل",1,0],["تَثْني إليكَ القوافي","أعناقَها حين تُثني",73,"ي",1,0],["تَثِبُ الْجِبَالَ وَمَالَهَا","بَيْنَ الْكَوَاكِبِ مِنْ مصَدِّ",74,"د",1,0],["تثَّنت يوم أن بعثتك عِطفًا","ومالت يوم عُدتَ لها بجيد",75,"د",1,0],["تثني عليك الضاد ملءَ لهَاتها","إن كان يجزيك الثناء، وقلَّما",76,"م",2,0],["تثلم حدُّ السيف وانقصف القنا","وأصبح لا طعن هناك ولا ضرب",77,"ب",1,0],["تُثِيرُ بِهَا والليلُ مُلْقٍ رُوَاقَهُ","هجود القطا مستوقد غير هاجد",78,"د",1,0],["تثنت فيا خجلتا للغصون","وغنت فيا خجلتا للقصب",79,"ب",1,1],["تثَّبتْ لا ترعُكَ فليس عدلاً","ولا عَّودتَ نفسكَ أنْ تُراعا",80,"ع",2,0],["تثور به للموت أبية","وتأبى سوى عاداتهن الطبائع",81,"ع",1,0]]}