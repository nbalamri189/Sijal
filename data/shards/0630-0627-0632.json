{"poems":[[50,"رأى بخديه منبتا زغبا","https://www.aldiwan.net/poem66278.html","المنسرح"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198193","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133104","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83185","الرجز"],[5002,"شوكة الأوجاع....","https://www.poetsgate.com/ViewPoem.aspx?id=205730",""]],"verses":[["ذا زعفرانٌ والمسكُ تربتهُ","ينبتُ من تحت صدغِكَ الرجَل",0,"ل",1,0],["ذَا زَعَلٍ لِدَرسِهِ وحِفظِهِ","كَأنَّ نورَ الرَّوضِ نَظمُ لَفظِهِ",1,"ه",1,0],["ذا ((زاِئدُ)) اللَّيثِ الهِزَبْرِ وَ((خالِدٌ))","وَشُيوخُنا الأُمَرا لِشَخْصِكَ تَعْضُدُ",2,"د",1,0],["ذا زمان العكس والنكس مع ال","وكس والخرس مع غي الجماح",3,"ح",1,0],["ذا زمان أهل الشقا أهل الجفا","والرشا والجور والكذب الصراح",3,"ح",1,0],["ذا زينَةٍ وَرِيِّ","وباطن مَقليِّ",4,"ي",1,0],["ذا زلالُ العَهدِ صَافٍ شَهدُهُ","منحلٌ أنعامُه ُ ...من كُرُمِ",5,"م",1,0]]}