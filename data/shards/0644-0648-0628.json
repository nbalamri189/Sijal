{"poems":[[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"من لي بنجد وأيام بها سلفت","https://www.aldiwan.net/poem45540.html","البسيط"],[77,"سكن الحب فؤادي وعمر","https://www.aldiwan.net/poem36493.html","الرمل"],[73,"يا ليل طل لا أشتهي","https://www.aldiwan.net/poem11884.html","مجزوء الرجز"],[72,"أهلا بطيف على الجرعاء مختلس","https://www.aldiwan.net/poem19016.html","البسيط"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"ازجر القلب إذا القلب جمح","https://www.aldiwan.net/poem9414.html","الرمل"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[28,"لو بأبي جامع عرضت حاجتنا","https://www.aldiwan.net/poem5635.html","البسيط"],[49,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[66,"لو بعثتم في طي نشر النسيم","https://www.aldiwan.net/poem40338.html","الخفيف"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"هات كأس الراح أو خذها إليك","https://www.aldiwan.net/poem31354.html","الرمل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[44,"وأخ أملى عليه اختلاط ال","https://www.aldiwan.net/poem29717.html","الخفيف"],[44,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[105,"مصر أنت الحياة والموت طرا","https://www.aldiwan.net/poem43126.html","الخفيف"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[52,"يا رب يوم سرور","https://www.aldiwan.net/poem26997.html","مجزوء الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"اسقياني الحرام قبل الحلال","https://www.aldiwan.net/poem64513.html","الخفيف"],[50,"أعبد قد طال في ذكراك تفنيدي","https://www.aldiwan.net/poem63904.html","البسيط"],[50,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[50,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[46,"إجتنب الناس وعش واحدا","https://www.aldiwan.net/poem23414.html","السريع"],[76,"أنا في اللذات مخلوع العذار","https://www.aldiwan.net/poem39291.html","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147498","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54819","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[18,"أنكحها فقدها الأراقم في","https://www.poetsgate.com/ViewPoem.aspx?id=27769",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[109,"لو كنت أطمع بالمنام توهما","https://www.aldiwan.net/poem16185.html","الكامل"],[133,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[137,"إن كأس العجوز كأس رواء","https://www.aldiwan.net/poem67943.html","الخفيف"],[155,"بذمام عهدك في الهوى أتذمم","https://www.aldiwan.net/poem55560.html","الكامل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[192,"شرب الوصل دستج الهجر فاستطلق","https://www.aldiwan.net/poem27465.html","الخفيف"],[211,"جاد بالوعد في زمان بخيل","https://www.aldiwan.net/poem46272.html","الخفيف"],[211,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[211,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[211,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[225,"معشر القبط يا بني مصر في السر","https://www.aldiwan.net/poem55112.html","الخفيف"],[229,"قل لنزار أنت أس العلا","https://www.aldiwan.net/poem50994.html","السريع"],[235,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[235,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[250,"تزوج الشيخ أبي زوجة","https://www.aldiwan.net/poem15051.html","السريع"],[282,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32291.html","الرجز"],[282,"دع الحمى وليالي الضال والعلم","https://www.aldiwan.net/poem32450.html","البسيط"],[282,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[282,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32693.html","الرجز"],[297,"أما ترى الصبح قد لاحت بشائره","https://www.aldiwan.net/poem33253.html","البسيط"],[300,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[328,"لو بعثنا من القبور فحسبي","https://www.aldiwan.net/poem55069.html","الخفيف"],[338,"أيها النادب الشباب الذي قد","https://www.aldiwan.net/poem68726.html","الخفيف"],[364,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[364,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[364,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[416,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[461,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[461,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[464,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[470,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[479,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[500,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[505,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[514,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[514,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[562,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[567,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[567,"أنا أفدي التي تغدو","https://www.aldiwan.net/poem69590.html","مجزوء الوافر"]],"verses":[["لَو بِسِبطَي قَيصَرٍ أَو هِرقِلٍ","فَعَلوا فِعلَ يَزيدٍ ما عَدا",0,"ا",1,0],["لَو بيعَ عَصرُ شَبابٍ يَنقَضي لِفَتىً","لابتيعَ عَصرُ الصِّبا وَاللَّهوِ بِالمُهَجِ",1,"ج",1,0],["لوْ بَدا للحُورِ يوْماً وجْهُهُ","قُلْنَ جَلّ اللهُ ما هَذا بشَرْ",2,"ر",1,0],["لَو باتَ عِندي قَمَري","ما بِتُّ أَرعى قَمَرَك",3,"ك",1,0],["لو باشر الأفق يوماً يمن طلعته","لما سمعت بنجم ثمّ منتحس",4,"س",1,0],["لو بقدرِ الأسى بكيت لسالت","مهجة كم وفت لها أفضاله",5,"ل",2,0],["لو بذلنا فداءك الشمسَ والبدْ","رَ لقال الزمانُ زيدوا فداءَ",6,"ا",2,0],["لو بَدَتْ غُرَّتُها مِنْ خِدْرِها","قلتَ بَرْقٌ في ذُرا المُزن لمحْ",7,"ح",1,0],["لو بشاشٍ أضحتْ عظامُ الفياشي","لغدا الوغدُ سائراً نحو شاش",8,"ش",1,0],["لو به ما شكاهُ منا لما عرْ","رَضنا في نسيبه للهلاك",9,"ك",1,0],["لو بنوا فوق السهى مملكة","لوجدت العلم فيها الطنبا",10,"ب",2,0],["لَو بانَ بِالكَرَمِ الجَنينُ بَيانَهُ","لَدَرَت بِهِ ذَكَرٌ أَمُ اَنثى الحامِلُ",11,"ل",1,0],["لَو بَدا حُسنُهُ لِجِنِّ سُلَيما","نَ لَخَرّوا مِن رُكَّعٍ وَسُجودِ",12,"د",1,0],["لَو بِتِّ تَخلِجُكِ الهُمومُ أَوَيتِ لي","وَلَكانَ لَيلي مِنكِ لَيلَ الراقِدِ",13,"د",1,0],["لَو بِأَبي جامِعٍ عَرَّضتُ حاجَتَنا","أَنجَحتُ أَو بِبَني العَوجاءِ مِن قَطَنِ",14,"ن",1,1],["لَو بَذَلتُ النُصحَ الصَحيحَ لِنَفسي","لَم تَذُق مُقلَتايَ طَعمَ الرُقادِ",15,"د",1,0],["لَو بَذَلتُ النُصحَ الصَحيحَ لِنَفسي","هِمتُ أُخرى الزَمانِ في كُلِّ وادِ",15,"د",1,0],["لَو بَعَثتُم في طَيِّ نَشرِ النَسيمِ","بِسَلامٍ راقٍ لِقَلبي السَليمِ",16,"م",1,1],["لَو بَعَثتُم لِلعَبدِ فيها سَحاةً","لَأَعادَت بَعدَ المَماتِ حَياتَه",17,"ت",2,0],["لو بكى ناظري بِصَوْبِ دماءٍ","ما وَفَى الأسى بحسرةِ أُمَّي",18,"ي",1,0],["لَو بَدا صورةً إِلَيكَ لَأضْحَى","في ثرَى القبرِ وهو منكَ بديلُ",19,"ل",1,0],["لَو بَدا أَمُركَ لي مِن قَبلِ ذا","ما رَأَتْ ناظِرَتي ناظِرَتيك",20,"ك",1,0],["لَو بِتّ مُغتَبِقاً مُدامةَ ريقِها","لَخَشيتُ صارمَ جَفنِها العِربِيدِ",21,"د",1,0],["لَو بِأُسدِ العَريفِ نيطَت عُرى المَن","نِ لَذَلَّت رِقابُ أُسدِ العَريفِ",22,"ف",1,0],["لَو بَدَت سافِراً أُهينَت وَلَكِن","شَعَفَ الخَلقَ حُسنُها في النِقابِ",23,"ب",1,0],["لَو بَيَّنَت قَطُّ أَمراً قَبلَ مَوقِعِهِ","لَم تُخفِ ما حَلَّ بِالأَوثانِ وَالصُلُبِ",24,"ب",1,0],["لَو بِعَينَيكَ يا عَتيقُ نَظَرنا","لَيلَةَ السَفحِ قُرَّتِ العَينانِ",25,"ن",1,0],["لَو بَذَلنا النُفوسَ فيكِ كِباراً","ما قَضَينا القَليلَ مِن إِكرامِكْ",26,"ك",1,0],["لَو بَغى المَجدَ فَوقَهُ","أَصبَحا فيهِ فَرقَدَين",27,"ن",1,0],["لَو بِهِ ما بِها مِن الوَجدِ لَم يَن","هَ مُحِبّاً وَلم يُبالِ بَلاها",28,"ا",3,0],["لَو بِعتُهُ بِسِنينٍ","وَأَعمُرٍ وَدُهورِ",29,"ر",1,0],["لو بعضُ ما باتَ يُطَوى في جوانحهم","يَسمو لِغَيلانَ لم يَربَعْ على طَلَل",30,"ل",1,0],["لَو بَدا وَجهُهُ إِذا الشَمسُ دارَت","قُلتَ نورانِ صُوِّرا مِن مِثالِ",31,"ل",1,0],["لَو بِالجَلاميدِ مِن حُبّي لَكُم طَرَفٌ","لَأَثَّرَ الحُبُّ في قاسي الجَلاميدِ",32,"د",1,0],["لَو بِها ما بي إِلَيها","مِن حَنينٍ وَنَحيبِ",33,"ب",1,0],["لَو بَدا اليَأسُ مِن عُبَي","دَةَ قَد قامَ نادِبي",34,"ب",2,0],["لَو بُعِثَ المَنصورُ نادى أَيا","مَدينَةَ التَسليمِ لا تَسلَمي",35,"م",2,0],["لو بغيرِ الماءِ حَلْقي شَرِقٌ","كنتُ كالغَضّان بالماء اعتصاري",36,"ي",1,0],["لو بغيت الذي أراد بك الله","لأعطاك فوق ما أنت تبغي",37,"غ",2,0],["لَو بغَيرِ الماءِ حَلقي شَرِقٌ","كُنتُ كالغَصَّانِ بالماءِ اعتِصاري",38,"ي",1,0],["لَوْ بِغَيْرِ السَّعْيِ أَوْ مَوْضِعِهِ","كَانَ خَطْبِي لَمْ أَؤَخِّرْ بِاخْتِيَارِي",39,"ر",2,0],["لَو بِتُّ ظَمآنَ حَولَ وِردٍ","لَم أَتَضَرَّع لِمَن يُسَقّي",40,"ي",1,0],["لَو بَقى أَخَذت بِهِ الث","ثارَ مِن غَضَنفَرِها",41,"ر",3,0],["لَو بَكى المُستَهامُ بَعدَكَ حَتّى","يورِقُ الصَخرُ ما اِشتَفى المُستَهامُ",42,"م",1,0],["لَو بَقى كانَ مِن مَصا","بيح في العِلمِ رُسَّخِ",43,"خ",1,0],["لو بأبانين جاء يخطبها","ضرج ما أنف خاطب بدم",44,"م",1,0],["لو بكفِّي مَنْعتُ جُلَّ القوانينِ","على الحقِ نِقْمةً أن تُسَنَّا",45,"ن",2,0],["لو بكفي ملأت دور المحامين","عن المرأة الجْهولةِ نارا",46,"ر",2,0],["لَو بِتُ أَشكو ظُلمُهُ لَشَكَوتُهُ","لِمَليك هَذا الدَهر أَسما مَن سَما",47,"م",2,0],["لو بدلُوا أقدامُهم بقوادمٍ","طارُوا عن الأوطانِ كلَّ مطارِ",48,"ر",1,0],["لَو بِهِ يَشرَبُ البَعيرُ أَوِ الفي","لُ لَظَلّا في سَكرَةٍ وَغُمومِ",49,"م",1,0],["لَوْ بَيْنَ أَجْفَاني تَجَافاهُ الكَرى","مَا كَانَ يَحْلُمُ أَنَّهُ بِيَ يَحْلُمُ",50,"م",1,0],["لَو بَكَيتُ العَقيقَ بِالسَفحِ ما كا","نَ لِوَجدي غَيرَ اللِقاءِ شِفاءُ",51,"ا",2,0],["لَو بِقُراطِ كانَ ما بي وَجالي","نوس باتا بِأَكسَفِ بال",52,"ل",1,0],["لو بعيني نظرت وجهك لحظا","لبكى الصخر ساجدا والجماد",53,"د",1,0],["لو بعيني نظر اللاحى وجال","لرأى الفتنة في كل سبيل",54,"ل",1,0],["لو بحت باسمك ثار الكون أجمعه","مطالباً بدمي في روحك الغالي",55,"ي",1,0],["لو بحت يوما بأسرار الغرام بكم","بوح الجريح غفا عن جرحه الحاني",56,"ي",1,0],["لو بَلَغتُم على النجومِ صُعوداً","لاتَّهَمتُم كواكِبَ الجَوزاءِ",57,"ا",2,0],["لو بلغت بغدادُ أقصى المُنَى","نادتك دون الجِنّ والإنسِ",58,"س",1,0],["لَو باتَ في حُلمٍ يَراهُ لَعادَ خَو","فاً مِنكَ مَحظوراً عَليهِ رُقادُهُ",59,"د",2,0],["لَو باتَ مَن يُلحي عَلَيكَ مُسَهَّداً","ما لامَني فيكِ الغَداةَ وَفَنَّدا",60,"د",2,1],["لو برزت صُورَتها في الدُّجَى","ما جَسُرَت تبصُرها الجنُّ",61,"ن",1,0],["لَو بَكَتِ الوُرقُ بِبَعضِ دَمعِهِ","لامَّحَتِ الأَطواقُ مِن أَعناقِها",62,"ق",3,0],["لَو بارَزَ اللَيثَ في يَومِ الهياجِ لَوَل","لَى اللَيثُ يَمنَحُهُ أَكتافَ مُنهَزِمِ",63,"م",1,0],["لَو بِسِهامِهِ رَمى عَن قَوسِهِ","دَلوَ السَماءِ صارَ لِلمَوتِ شَبَك",64,"ك",1,0],["لَو بَكَتِ الوُرقُ بِبَعضِ أَدمُعي","لاِمَّحَتِ الأَطواقُ مِن أَعناقِها",65,"ق",3,0],["لَو باهَت الشَمسُ منه الوَجهَ لاِنبهرَت","مِن نوره وهو باهي الحُسنِ باهرُهُ",66,"ر",2,0],["لَو بي تَحَمَّسَتِ الرِكابُ إِذاً","ما خانَني حَسَبي وَلا وَفري",67,"ر",2,0],["لو بعثنا من القبور فحسبي","أنني عابد لسحر جمالك",68,"ك",1,1],["لَو بَكَيتَ الشَبابَ عُمرَ اللَيالي","لَم تَكُن باكِياً بِما يَستَحِقُّه",69,"ه",1,0],["لَو بَلَغَ التَشريفُ في التَضعيفِ","مَعدودَ قَولِ قائِلٍ تَشريفي",70,"ي",1,0],["لو بخَدِّي منه يكون غليلي","لأبتْ مُقلتايَ أن تَتندّى",71,"د",2,0],["لو بنو مُقلةٍ رأوْهُ لأضحَى","ولَقَلّوا لمَجْدهِ من فِداء",72,"ا",2,0],["لو بارز الليل البهيم أعانه","من صبح غرَّته عليه فيلق",73,"ق",1,0],["لو بدا الماءُ للعُطاشِ مع العِشْ","رِ وقيلتْ ثنتْ صدورَ الركابِ",74,"ب",1,0],["لو بزَّهُ عافوهُ في خضرِ الدجى","ما ضمَّهُ من لبْسةِ المُتفضلِ",75,"ل",1,0],["لو بالقدود ظفرتُ يوم سويقةٍ","لوصلتُ بل لضممتُ من ألفاتها",76,"ت",3,0],["لَو بِالَّذي عالَجتُ لينَ فؤادِهِ","فَأَبى يَلينُ بِهِ لَلانَ الجَندَلُ",77,"ل",1,0],["لو بت تسالني على أحوالها","لشفيت قلبك بالجواب الحاضر",78,"ر",1,0],["لو بدتْ لي نظرةٌ مِنْ وجهِهِمْ","لملأتُ الكونَ فيها طَرَبا",79,"ب",2,0],["لو بهم شيءٌ من يقينٍ ملكْتَ","لاستباحوا حصونَ وهمٍ وهدُّوا",80,"د",3,0],["لو بالبلاغةِ للنبوّةِ يدّعي","لَغدا وما قُرآنُه بعِضينِ",81,"ن",1,0],["لو بِيعَ وصلُك للعاني بمُهجتِه","هانَتْ عليه ومَن للعُمي بالبصَرِ",82,"ر",1,0],["لو باللّباسِ بدونِ البأسِ مفتخَرٌ","فاقَ البُزاةَ بحُسْنِ الملْبسِ الحَجَلُ",83,"ل",1,0],["لو بأفكارِ اللّيالي خطرَتْ","بيّضَتْ أنوارُها سودَ إماها",84,"ا",3,0],["لو بان شخص المجد كنت يمينه ال","طولى وكان العالمون شمالا",85,"ل",2,0],["لو باتَ في عينيَّ دَمعٌ واحدٌ","رَفعاً لهُ عن سَقْيِ ماءِ العُنصُرِ",86,"ر",1,0],["لَوْ بِحَقٍّ تَنَاوَلَ النَّجْمَ خَلْقٌ","نِلْتُ هَذِي النُّجُومَ بِاسْتِحْقَاقِ",87,"ق",1,0],["لَوْ بَدَّلَ اللَّهُ قَمْلَهُ غَنَمَاً","مَا طَمِعَ مِنْهُ فِي صُوفَهْ",88,"ف",2,0]]}