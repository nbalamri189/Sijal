{"poems":[[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"من لي بنجد وأيام بها سلفت","https://www.aldiwan.net/poem45540.html","البسيط"],[77,"سكن الحب فؤادي وعمر","https://www.aldiwan.net/poem36493.html","الرمل"],[73,"يا ليل طل لا أشتهي","https://www.aldiwan.net/poem11884.html","مجزوء الرجز"],[72,"أهلا بطيف على الجرعاء مختلس","https://www.aldiwan.net/poem19016.html","البسيط"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"ازجر القلب إذا القلب جمح","https://www.aldiwan.net/poem9414.html","الرمل"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[28,"لو بأبي جامع عرضت حاجتنا","https://www.aldiwan.net/poem5635.html","البسيط"],[49,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[66,"لو بعثتم في طي نشر النسيم","https://www.aldiwan.net/poem40338.html","الخفيف"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"هات كأس الراح أو خذها إليك","https://www.aldiwan.net/poem31354.html","الرمل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[44,"وأخ أملى عليه اختلاط ال","https://www.aldiwan.net/poem29717.html","الخفيف"],[44,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[105,"مصر أنت الحياة والموت طرا","https://www.aldiwan.net/poem43126.html","الخفيف"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[52,"يا رب يوم سرور","https://www.aldiwan.net/poem26997.html","مجزوء الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"اسقياني الحرام قبل الحلال","https://www.aldiwan.net/poem64513.html","الخفيف"],[50,"أعبد قد طال في ذكراك تفنيدي","https://www.aldiwan.net/poem63904.html","البسيط"],[50,"أنت يا نفس أنيبي","https://www.aldiwan.net/poem64842.html","مجزوء الرمل"],[50,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[46,"إجتنب الناس وعش واحدا","https://www.aldiwan.net/poem23414.html","السريع"],[76,"أنا في اللذات مخلوع العذار","https://www.aldiwan.net/poem39291.html","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147498","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54819","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[18,"أنكحها فقدها الأراقم في","https://www.poetsgate.com/ViewPoem.aspx?id=27769",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""]],"verses":[["لَو بِسِبطَي قَيصَرٍ أَو هِرقِلٍ","فَعَلوا فِعلَ يَزيدٍ ما عَدا",0,"ا",1,0],["لَو بيعَ عَصرُ شَبابٍ يَنقَضي لِفَتىً","لابتيعَ عَصرُ الصِّبا وَاللَّهوِ بِالمُهَجِ",1,"ج",1,0],["لوْ بَدا للحُورِ يوْماً وجْهُهُ","قُلْنَ جَلّ اللهُ ما هَذا بشَرْ",2,"ر",1,0],["لَو باتَ عِندي قَمَري","ما بِتُّ أَرعى قَمَرَك",3,"ك",1,0],["لو باشر الأفق يوماً يمن طلعته","لما سمعت بنجم ثمّ منتحس",4,"س",1,0],["لو بقدرِ الأسى بكيت لسالت","مهجة كم وفت لها أفضاله",5,"ل",2,0],["لو بذلنا فداءك الشمسَ والبدْ","رَ لقال الزمانُ زيدوا فداءَ",6,"ا",2,0],["لو بَدَتْ غُرَّتُها مِنْ خِدْرِها","قلتَ بَرْقٌ في ذُرا المُزن لمحْ",7,"ح",1,0],["لو بشاشٍ أضحتْ عظامُ الفياشي","لغدا الوغدُ سائراً نحو شاش",8,"ش",1,0],["لو به ما شكاهُ منا لما عرْ","رَضنا في نسيبه للهلاك",9,"ك",1,0],["لو بنوا فوق السهى مملكة","لوجدت العلم فيها الطنبا",10,"ب",2,0],["لَو بانَ بِالكَرَمِ الجَنينُ بَيانَهُ","لَدَرَت بِهِ ذَكَرٌ أَمُ اَنثى الحامِلُ",11,"ل",1,0],["لَو بَدا حُسنُهُ لِجِنِّ سُلَيما","نَ لَخَرّوا مِن رُكَّعٍ وَسُجودِ",12,"د",1,0],["لَو بِتِّ تَخلِجُكِ الهُمومُ أَوَيتِ لي","وَلَكانَ لَيلي مِنكِ لَيلَ الراقِدِ",13,"د",1,0],["لَو بِأَبي جامِعٍ عَرَّضتُ حاجَتَنا","أَنجَحتُ أَو بِبَني العَوجاءِ مِن قَطَنِ",14,"ن",1,1],["لَو بَذَلتُ النُصحَ الصَحيحَ لِنَفسي","لَم تَذُق مُقلَتايَ طَعمَ الرُقادِ",15,"د",1,0],["لَو بَذَلتُ النُصحَ الصَحيحَ لِنَفسي","هِمتُ أُخرى الزَمانِ في كُلِّ وادِ",15,"د",1,0],["لَو بَعَثتُم في طَيِّ نَشرِ النَسيمِ","بِسَلامٍ راقٍ لِقَلبي السَليمِ",16,"م",1,1],["لَو بَعَثتُم لِلعَبدِ فيها سَحاةً","لَأَعادَت بَعدَ المَماتِ حَياتَه",17,"ت",2,0],["لو بكى ناظري بِصَوْبِ دماءٍ","ما وَفَى الأسى بحسرةِ أُمَّي",18,"ي",1,0],["لَو بَدا صورةً إِلَيكَ لَأضْحَى","في ثرَى القبرِ وهو منكَ بديلُ",19,"ل",1,0],["لَو بَدا أَمُركَ لي مِن قَبلِ ذا","ما رَأَتْ ناظِرَتي ناظِرَتيك",20,"ك",1,0],["لَو بِتّ مُغتَبِقاً مُدامةَ ريقِها","لَخَشيتُ صارمَ جَفنِها العِربِيدِ",21,"د",1,0],["لَو بِأُسدِ العَريفِ نيطَت عُرى المَن","نِ لَذَلَّت رِقابُ أُسدِ العَريفِ",22,"ف",1,0],["لَو بَدَت سافِراً أُهينَت وَلَكِن","شَعَفَ الخَلقَ حُسنُها في النِقابِ",23,"ب",1,0],["لَو بَيَّنَت قَطُّ أَمراً قَبلَ مَوقِعِهِ","لَم تُخفِ ما حَلَّ بِالأَوثانِ وَالصُلُبِ",24,"ب",1,0],["لَو بِعَينَيكَ يا عَتيقُ نَظَرنا","لَيلَةَ السَفحِ قُرَّتِ العَينانِ",25,"ن",1,0],["لَو بَذَلنا النُفوسَ فيكِ كِباراً","ما قَضَينا القَليلَ مِن إِكرامِكْ",26,"ك",1,0],["لَو بَغى المَجدَ فَوقَهُ","أَصبَحا فيهِ فَرقَدَين",27,"ن",1,0],["لَو بِهِ ما بِها مِن الوَجدِ لَم يَن","هَ مُحِبّاً وَلم يُبالِ بَلاها",28,"ا",3,0],["لَو بِعتُهُ بِسِنينٍ","وَأَعمُرٍ وَدُهورِ",29,"ر",1,0],["لو بعضُ ما باتَ يُطَوى في جوانحهم","يَسمو لِغَيلانَ لم يَربَعْ على طَلَل",30,"ل",1,0],["لَو بَدا وَجهُهُ إِذا الشَمسُ دارَت","قُلتَ نورانِ صُوِّرا مِن مِثالِ",31,"ل",1,0],["لَو بِالجَلاميدِ مِن حُبّي لَكُم طَرَفٌ","لَأَثَّرَ الحُبُّ في قاسي الجَلاميدِ",32,"د",1,0],["لَو بِها ما بي إِلَيها","مِن حَنينٍ وَنَحيبِ",33,"ب",1,0],["لَو بَدا اليَأسُ مِن عُبَي","دَةَ قَد قامَ نادِبي",34,"ب",2,0],["لَو بُعِثَ المَنصورُ نادى أَيا","مَدينَةَ التَسليمِ لا تَسلَمي",35,"م",2,0],["لو بغيرِ الماءِ حَلْقي شَرِقٌ","كنتُ كالغَضّان بالماء اعتصاري",36,"ي",1,0],["لو بغيت الذي أراد بك الله","لأعطاك فوق ما أنت تبغي",37,"غ",2,0],["لَو بغَيرِ الماءِ حَلقي شَرِقٌ","كُنتُ كالغَصَّانِ بالماءِ اعتِصاري",38,"ي",1,0],["لَوْ بِغَيْرِ السَّعْيِ أَوْ مَوْضِعِهِ","كَانَ خَطْبِي لَمْ أَؤَخِّرْ بِاخْتِيَارِي",39,"ر",2,0],["لَو بِتُّ ظَمآنَ حَولَ وِردٍ","لَم أَتَضَرَّع لِمَن يُسَقّي",40,"ي",1,0],["لَو بَقى أَخَذت بِهِ الث","ثارَ مِن غَضَنفَرِها",41,"ر",3,0],["لَو بَكى المُستَهامُ بَعدَكَ حَتّى","يورِقُ الصَخرُ ما اِشتَفى المُستَهامُ",42,"م",1,0],["لَو بَقى كانَ مِن مَصا","بيح في العِلمِ رُسَّخِ",43,"خ",1,0],["لو بأبانين جاء يخطبها","ضرج ما أنف خاطب بدم",44,"م",1,0],["لو بكفِّي مَنْعتُ جُلَّ القوانينِ","على الحقِ نِقْمةً أن تُسَنَّا",45,"ن",2,0],["لو بكفي ملأت دور المحامين","عن المرأة الجْهولةِ نارا",46,"ر",2,0]]}