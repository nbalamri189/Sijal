.poetsgate.com/ViewPoem.aspx?id=5417",""],[5848,"رساله له فقط","https://www.poetsgate.com/ViewPoem.aspx?id=52031",""],[5848,"أنصحك تكسر الجوال","https://www.poetsgate.com/ViewPoem.aspx?id=48964",""],[5848,"كيف اكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=53095",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5956,"نحن سعداء","https://www.poetsgate.com/ViewPoem.aspx?id=184007",""],[6023,"والصباح استعار من هجر حبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=123863",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""],[6093,"(دوبيت) في الحج لنا كأمة مؤتمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=181806",""],[6115,"يسلمون اللى تعنوا في لزومي","https://www.poetsgate.com/ViewPoem.aspx?id=196472",""],[6127,"سلامٌ على جرحك","https://www.poetsgate.com/ViewPoem.aspx?id=199923",""],[6142,"أنت يا غرب من تيقظ علما","https://www.poetsgate.com/ViewPoem.aspx?id=155698",""],[6142,"جاءنا بالشريعة السهلة الس","https://www.poetsgate.com/ViewPoem.aspx?id=155701",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[519,"ما الرّاحُ إلا روحُ كلِّ حزينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9751&r=&rc=7",""],[6334,"الحُبٌّ البَدَوِيّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82255&r=&rc=5",""],[572,"شيخٌ لَنَا من مشايخِ الكوفَة ْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9388&r=&rc=245",""]],"verses":[["لَو بِسِبطَي قَيصَرٍ أَو هِرقِلٍ","فَعَلوا فِعلَ يَزيدٍ ما عَدا",0,"ا",1,0],["لَو بيعَ عَصرُ شَبابٍ يَنقَضي لِفَتىً","لابتيعَ عَصرُ الصِّبا وَاللَّهوِ بِالمُهَجِ",1,"ج",1,0],["لوْ بَدا للحُورِ يوْماً وجْهُهُ","قُلْنَ جَلّ اللهُ ما هَذا بشَرْ",2,"ر",1,0],["لَو باتَ عِندي قَمَري","ما بِتُّ أَرعى قَمَرَك",3,"ك",1,0],["لو باشر الأفق يوماً يمن طلعته","لما سمعت بنجم ثمّ منتحس",4,"س",1,0],["لو بقدرِ الأسى بكيت لسالت","مهجة كم وفت لها أفضاله",5,"ل",2,0],["لو بذلنا فداءك الشمسَ والبدْ","رَ لقال الزمانُ زيدوا فداءَ",6,"ا",2,0],["لو بَدَتْ غُرَّتُها مِنْ خِدْرِها","قلتَ بَرْقٌ في ذُرا المُزن لمحْ",7,"ح",1,0],["لو بشاشٍ أضحتْ عظامُ الفياشي","لغدا الوغدُ سائراً نحو شاش",8,"ش",1,0],["لو به ما شكاهُ منا لما عرْ","رَضنا في نسيبه للهلاك",9,"ك",1,0],["لو بنوا فوق السهى مملكة","لوجدت العلم فيها الطنبا",10,"ب",2,0],["لَو بانَ بِالكَرَمِ الجَنينُ بَيانَهُ","لَدَرَت بِهِ ذَكَرٌ أَمُ اَنثى الحامِلُ",11,"ل",1,0],["لَو بَدا حُسنُهُ لِجِنِّ سُلَيما","نَ لَخَرّوا مِن رُكَّعٍ وَسُجودِ",12,"د",1,0],["لَو بِتِّ تَخلِجُكِ الهُمومُ أَوَيتِ لي","وَلَكانَ لَيلي مِنكِ لَيلَ الراقِدِ",13,"د",1,0],["لَو بِأَبي جامِعٍ عَرَّضتُ حاجَتَنا","أَنجَحتُ أَو بِبَني العَوجاءِ مِن قَطَنِ",14,"ن",1,1],["لَو بَذَلتُ النُصحَ الصَحيحَ لِنَفسي","لَم تَذُق مُقلَتايَ طَعمَ الرُقادِ",15,"د",1,0],["لَو بَذَلتُ النُصحَ الصَحيحَ لِنَفسي","هِمتُ أُخرى الزَمانِ في كُلِّ وادِ",15,"د",1,0],["لَو بَعَثتُم في طَيِّ نَشرِ النَسيمِ","بِسَلامٍ راقٍ لِقَلبي السَليمِ",16,"م",1,1],["لَو بَعَثتُم لِلعَبدِ فيها سَحاةً","لَأَعادَت بَعدَ المَماتِ حَياتَه",17,"ت",2,0],["لَو بِأَبا نَينِ جاءَ يَخطُبُها","ضُرِّجَ ما أَنفُ خاطِبٍ بِدَمِ",18,"م",1,0],["لو بكى ناظري بِصَوْبِ دماءٍ","ما وَفَى الأسى بحسرةِ أُمَّي",19,"م",2,0],["لَو بَدا صورةً إِلَيكَ لَأضْحَى","في ثرَى القبرِ وهو منكَ بديلُ",20,"ل",1,0],["لَو بَدا أَمُركَ لي مِن قَبلِ ذا","ما رَأَتْ ناظِرَتي ناظِرَتيك",21,"ك",1,0],["لَو بِتّ مُغتَبِقاً مُدامةَ ريقِها","لَخَشيتُ صارمَ جَفنِها العِربِيدِ",22,"د",1,0],["لَو بِأُسدِ العَريفِ نيطَت عُرى المَن","نِ لَذَلَّت رِقابُ أُسدِ العَريفِ",23,"ف",1,0],["لَو بَدَت سافِراً أُهينَت وَلَكِن","شَعَفَ الخَلقَ حُسنُها في النِقابِ",24,"ب",1,0],["لَو بَيَّنَت قَطُّ أَمراً قَبلَ مَوقِعِهِ","لَم تُخفِ ما حَلَّ بِالأَوثانِ وَالصُلُبِ",25,"ب",1,0],["لَو بِعَينَيكَ يا عَتيقُ نَظَرنا","لَيلَةَ السَفحِ قُرَّتِ العَينانِ",26,"ن",1,0],["لَو بَذَلنا النُفوسَ فيكِ كِباراً","ما قَضَينا القَليلَ مِن إِكرامِكْ",27,"ك",1,0],["لَو بَغى المَجدَ فَوقَهُ","أَصبَحا فيهِ فَرقَدَين",28,"ن",1,0],["لَو بِهِ ما بِها مِن الوَجدِ لَم يَن","هَ مُحِبّاً وَلم يُبالِ بَلاها",29,"ا",3,0],["لَو بِعتُهُ بِسِنينٍ","وَأَعمُرٍ وَدُهورِ",30,"ر",1,0],["لو بعضُ ما باتَ يُطَوى في جوانحهم","يَسمو لِغَيلانَ لم يَربَعْ على طَلَل",31,"ل",1,0],["لَو بَدا وَجهُهُ إِذا الشَمسُ دارَت","قُلتَ نورانِ صُوِّرا مِن مِثالِ",32,"ل",1,0],["لَو بِالجَلاميدِ مِن حُبّي لَكُم طَرَفٌ","لَأَثَّرَ الحُبُّ في قاسي الجَلاميدِ",33,"د",1,0],["لَو بِها ما بي إِلَيها","مِن حَنينٍ وَنَحيبِ",34,"ب",1,0],["لَو بَدا اليَأسُ مِن عُبَي","دَةَ قَد قامَ نادِبي",35,"ب",2,0],["لَو بُعِثَ المَنصورُ نادى أَيا","مَدينَةَ التَسليمِ لا تَسلَمي",36,"م",2,0],["لو بغيرِ الماءِ حَلْقي شَرِقٌ","كنتُ كالغَضّان بالماء اعتصاري",37,"ر",2,0],["لو بغيت الذي أراد بك الله","لأعطاك فوق ما أنت تبغي",38,"غ",2,0],["لَو بغَيرِ الماءِ حَلقي شَرِقٌ","كُنتُ كالغَصَّانِ بالماءِ اعتِصاري",39,"ر",2,0],["لَوْ بِغَيْرِ السَّعْيِ أَوْ مَوْضِعِهِ","كَانَ خَطْبِي لَمْ أَؤَخِّرْ بِاخْتِيَارِي",40,"ر",2,0],["لَو بِتُّ ظَمآنَ حَولَ وِردٍ","لَم أَتَضَرَّع لِمَن يُسَقّي",41,"ق",2,0],["لَو بَقى أَخَذت بِهِ الث","ثارَ مِن غَضَنفَرِها",42,"ر",3,0],["لَو بَكى المُستَهامُ بَعدَكَ حَتّى","يورِقُ الصَخرُ ما اِشتَفى المُستَهامُ",43,"م",1,0],["لَو بَقى كانَ مِن مَصا","بيح في العِلمِ رُسَّخِ",44,"خ",1,0],["لو بكفِّي مَنْعتُ جُلَّ القوانينِ","على الحقِ نِقْمةً أن تُسَنَّا",45,"ن",2,0],["لو بكفي ملأت دور المحامين","عن المرأة الجْهولةِ نارا",46,"ر",2,0],["لَو بِتُ أَشكو ظُلمُهُ لَشَكَوتُهُ","لِمَليك هَذا الدَهر أَسما مَن سَما",47,"م",2,0],["لو بدلُوا أقدامُهم بقوادمٍ","طارُوا عن الأوطانِ كلَّ مطارِ",48,"ر",1,0],["لَو بِهِ يَشرَبُ البَعيرُ أَوِ الفي","لُ لَظَلّا في سَكرَةٍ وَغُمومِ",49,"م",1,0],["لَوْ بَيْنَ أَجْفَاني تَجَافاهُ الكَرى","مَا كَانَ يَحْلُمُ أَنَّهُ بِيَ يَحْلُمُ",50,"م",1,0],["لَو بَكَيتُ العَقيقَ بِالسَفحِ ما كا","نَ لِوَجدي غَيرَ اللِقاءِ شِفاءُ",51,"ا",2,0],["لَو بِقُراطِ كانَ ما بي وَجالي","نوس باتا بِأَكسَفِ بال",52,"ل",1,0],["لو بعيني نظرت وجهك لحظا","لبكى الصخر ساجدا والجماد",53,"د",1,0],["لو بعيني نظر اللاحى وجال","لرأى الفتنة في كل سبيل",54,"ل",1,0],["لو بحت باسمك ثار الكون أجمعه","مطالباً بدمي في روحك الغالي",55,"ي",1,0],["لو بحت يوما بأسرار الغرام بكم","بوح الجريح غفا عن جرحه الحاني",56,"ن",2,0],["لو بَلَغتُم على النجومِ صُعوداً","لاتَّهَمتُم كواكِبَ الجَوزاءِ",57,"ا",2,0],["لو بلغت بغدادُ أقصى المُنَى","نادتك دون الجِنّ والإنسِ",58,"س",1,0],["لَو باتَ في حُلمٍ يَراهُ لَعادَ خَو","فاً مِنكَ مَحظوراً عَليهِ رُقادُهُ",59,"د",2,0],["لَو باتَ مَن يُلحي عَلَيكَ مُسَهَّداً","ما لامَني فيكِ الغَداةَ وَفَنَّدا",60,"د",2,1],["لو برزت صُورَتها في الدُّجَى","ما جَسُرَت تبصُرها الجنُّ",61,"ن",1,0],["لَو بَكَتِ الوُرقُ بِبَعضِ دَمعِهِ","لامَّحَتِ الأَطواقُ مِن أَعناقِها",62,"ق",3,0],["لَو بارَزَ اللَيثَ في يَومِ الهياجِ لَوَل","لَى اللَيثُ يَمنَحُهُ أَكتافَ مُنهَزِمِ",63,"م",1,0],["لَو بِسِهامِهِ رَمى عَن قَوسِهِ","دَلوَ السَماءِ صارَ لِلمَوتِ شَبَك",64,"ك",1,0],["لَو بَكَتِ الوُرقُ بِبَعضِ أَدمُعي","لاِمَّحَتِ الأَطواقُ مِن أَعناقِها",65,"ق",3,0],["لَو باهَت الشَمسُ منه الوَجهَ لاِنبهرَت","مِن نوره وهو باهي الحُسنِ باهرُهُ",66,"ر",2,0],["لَو بي تَحَمَّسَتِ الرِكابُ إِذاً","ما خانَني حَسَبي وَلا وَفري",67,"ر",2,0],["لو بعثنا من القبور فحسبي","أنني عابد لسحر جمالك",68,"ك",1,1],["لَو بَكَيتَ الشَبابَ عُمرَ اللَيالي","لَم تَكُن باكِياً بِما يَستَحِقُّه",69,"ه",1,0],["لَو بَلَغَ التَشريفُ في التَضعيفِ","مَعدودَ قَولِ قائِلٍ تَشريفي",70,"ي",1,0],["لو بخَدِّي منه يكون غليلي","لأبتْ مُقلتايَ أن تَتندّى",71,"د",2,0],["لو بنو مُقلةٍ رأوْهُ لأضحَى","ولَقَلّوا لمَجْدهِ من فِداء",72,"ا",2,0],["لو بارز الليل البهيم أعانه","من صبح غرَّته عليه فيلق",73,"ق",1,0],["لو بدا الماءُ للعُطاشِ مع العِشْ","رِ وقيلتْ ثنتْ صدورَ الركابِ",74,"ب",1,0],["لو بزَّهُ عافوهُ في خضرِ الدجى","ما ضمَّهُ من لبْسةِ المُتفضلِ",75,"ل",1,0],["لو بالقدود ظفرتُ يوم سويقةٍ","لوصلتُ بل لضممتُ من ألفاتها",76,"ت",3,0],["لَو بِالَّذي عالَجتُ لينَ فؤادِهِ","فَأَبى يَلينُ بِهِ لَلانَ الجَندَلُ",77,"ل",1,0],["لو بت تسالني على أحوالها","لشفيت قلبك بالجواب الحاضر",78,"ر",1,0],["لو بدتْ لي نظرةٌ مِنْ وجهِهِمْ","لملأتُ الكونَ فيها طَرَبا",79,"ب",2,0],["لو بهم شيءٌ من يقينٍ ملكْتَ","لاستباحوا حصونَ وهمٍ وهدُّوا",80,"د",3,0],["لو بالبلاغةِ للنبوّةِ يدّعي","لَغدا وما قُرآنُه بعِضينِ",81,"ن",1,0],["لو بِيعَ وصلُك للعاني بمُهجتِه","هانَتْ عليه ومَن للعُمي بالبصَرِ",82,"ر",1,0],["لو باللّباسِ بدونِ البأسِ مفتخَرٌ","فاقَ البُزاةَ بحُسْنِ الملْبسِ الحَجَلُ",83,"ل",1,0],["لو بأفكارِ اللّيالي خطرَتْ","بيّضَتْ أنوارُها سودَ إماها",84,"ا",3,0],["لو بان شخص المجد كنت يمينه ال","طولى وكان العالمون شمالا",85,"ل",2,0],["لو باتَ في عينيَّ دَمعٌ واحدٌ","رَفعاً لهُ عن سَقْيِ ماءِ العُنصُرِ",86,"ر",1,0],["لَوْ بِحَقٍّ تَنَاوَلَ النَّجْمَ خَلْقٌ","نِلْتُ هَذِي النُّجُومَ بِاسْتِحْقَاقِ",87,"ق",1,0],["لَوْ بَدَّلَ اللَّهُ قَمْلَهُ غَنَمَاً","مَا طَمِعَ مِنْهُ فِي صُوفَهْ",88,"ف",2,0],["لَو بَكَت هَذِهِ السَماءُ عَلى قَو","مٍ كِرامٍ بَكَت عَلينا السَماءُ",89,"ا",2,0],["لو بالجدارة كل أحرز الرتبا","لكنت أفضل كفء للعلى خطبا",90,"ب",2,1],["لَو باكَرُوا بالماء سَحبَةَ طائِرٍ","لَم يَنجُ مِنها طائراً أو واقِعا",91,"ع",2,0],["لَو بِعتُ حَظي مِنَ الدُّنيا لِرُؤيَتِهِ","لا غَيرَها لَم أَكُن فيها بِمَغبُونِ",92,"ن",1,0],["لو بات عندي حبيبي","لغادرتني غمومي",93,"ي",1,0],["لو بأير الفيل نِيكتْ لن اكن","معَ أير الفيل إلا هُزأهْ",94,"ا",2,0],["لو باعتِ الأيّامُ آخَرَ مثله","بالعُمْر نقداً كنتُ أوَّلَ مُشْتَرِ",95,"ر",1,0],["لو بقيتم هكذا تغويكمُ","فتنة الشيطان أو تلهيكمُ",96,"م",1,0],["لو بقينا وأنتم في وفاق","لظفرنا بمطلق التصريف",97,"ف",1,0],["لو با بثين رأيت حبك قبل ما","الافيون انحله وحل بذاته",98,"ت",2,0],["لو بُثّ في غَسَقِ الظلامِ شعاعُها","طلع الصباحُ بغرّةِ الإِصباح",99,"ح",1,0],["لو بالخضوعِ يُذادُ عَذلُ مُتَيَّمٍ","أَبْدَيْتُ للعُذَّال ثَوبَ خضوع",100,"ع",1,0],["لو باتمس ثيابه","عظامٍ قد بلت",101,"ت",1,0],["لو بنعطا من ودّي","كان اتناول غزال",102,"ل",1,0],["لو بآتسخي بْدوايا","في حالات الخطر",103,"ر",1,0],["لَو بَدا نورُها بِوَجهِ كَفيفٍ","عادَ مِنهُ الكفيفُ غَيرَ كفيفِ",104,"ف",1,0],["لَو بِكأس مِنهُ لي قَد سَمَحا","كانَ يَشفي لِفُؤادي الزَّمِنِ",105,"ن",1,0],["لو باستطاعي والنفوسُ دمٌ","هرَّبتُ من أضغانِها بلدي",106,"د",2,0],["لو باح لي ذَنوباً","مِن ثَغره الشنيب",107