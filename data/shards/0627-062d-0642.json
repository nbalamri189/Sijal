ps://www.poetsgate.com/ViewPoem.aspx?id=61839",""],[5320,"يا ابن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=41646",""],[5348,"الخطب الجليل","https://www.poetsgate.com/ViewPoem.aspx?id=59566",""],[5413,"خذها من القلب ياصِدِّيقُ","https://www.poetsgate.com/ViewPoem.aspx?id=201374",""],[5431,"هاتِ القصيدة واسكر أيها الثملُ","https://www.poetsgate.com/ViewPoem.aspx?id=189979",""],[5431,"بكف الله ممزوجا بلوني....","https://www.poetsgate.com/ViewPoem.aspx?id=200700",""],[470,"أسفاً على كل الذي عشناه","https://www.poetsgate.com/ViewPoem.aspx?id=178049",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5660,"أَحَقُّ النّاسِ أَن تُهجى الشُعوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=23712",""],[5725,"احقا امام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=201575",""],[3216,"المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=28890",""],[5818,"وإنّ غداً لناظرهِ قريب","https://www.poetsgate.com/ViewPoem.aspx?id=199691",""],[5906,"في الحكمة / الإحسان / احقن أذى الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=189959",""],[5939,"بوريو","https://www.poetsgate.com/ViewPoem.aspx?id=185514",""],[5948,"أحقُّ من أنجزَ موعودَه","https://www.poetsgate.com/ViewPoem.aspx?id=100601",""],[5956,"كُلّنا نحيا بأعجوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184156",""],[5956,"الرقص بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185632",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[5956,"تحيتك الجليلة نهرُ نيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=193349",""],[5956,"شهقتُ وقد جاءت إليّ رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=193803",""],[5957,"لماذا عدتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=55378",""],[6123,"أحقاً عباد الله إن لست لاقياً","https://www.poetsgate.com/ViewPoem.aspx?id=84634",""],[5355,"لمن الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86687&r=&rc=10",""],[6277,"إبراهيم طوقان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64464&r=&rc=27",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""],[433,"لقاء القاهرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87049&r=&rc=2",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["أَحَقُّ مَن كانَتِ النَعماءُ سابِغَةً","عَلَيهِ مَن أَسبَغَ النُعمى عَلى الأُمَمِ",0,"م",1,1],["أَحَقُّ بِلادِ اللَهِ بِالمُزنِ أَرضُهُ","إِذا شامَ أَقصى خَطرَةِ البَرقِ رائِدُ",1,"د",1,0],["أَحَقّاً بِأَنَّ المَجدَ هيضَت جُبورُهُ","وَزالَ عَنِ الحَيّ الطَوالُ المَلاوِثُ",2,"ث",1,0],["أَحَقٌّ أَم خَيالُكَ زارَ شُعثاً","وَأَطلاحاً جَوانِحَ بِالقُيودِ",3,"د",1,0],["أَحَقٌّ بَلاغاتٌ أَتَتني مَشابِهاً","وَبَيِّن لَهُ إِنَّ البَيانَ مِنَ الصِدقِ",4,"ق",1,0],["أَحَقّاً رَأَيتَ الظاعِنينَ تَحَمَّلوا","مِنَ الغيلِ أَو وادي الوَريعَةِ ذي الأَثلِ",5,"ل",1,0],["أَحَقُّ بِها مِن فِتيَةٍ وَرَكائِبٍ","تُقَطِّعُ عَنها اللَيلَ عوجٌ ضَوامِرُ",6,"ر",1,0],["أحقًّا أراني في ثرى عتباته","نباتاً يحيي وَاكفَ المزن بالزهر",7,"ر",1,0],["أحقّاً رضيتَ بأنَّ الغنى","عدوٌّ لعبدك والفقر خِلُّ",8,"ل",1,0],["أحقُّ برِفْدك من آملي","ه من لم يؤمْله في الآملينا",9,"ن",2,1],["أَحَقُّ بِإِكرامِكُم طائِرٌ","يُغَرِّدُ في الرَوضِ وَالبَلقَعِ",10,"ع",1,0],["أَحَقُّ بِما قالَ ابنُ قَيسٍ لِمالِكٍ","وَأَولى بِما قالَ ابنُ أَوسٍ لِمُصعَبِ",11,"ب",1,0],["أَحِقِّي يا سماء مُنى نفوس","إليك لها إليك لها التجاء",12,"ا",2,0],["أحق أنهم دفنوا عليا","وحطوا في الثرى المرء الزكيا",13,"ي",2,1],["أحق بالشعر ولا بالهوى","من قيسٍ المجنونِ أو من جميل",14,"ل",1,0],["أَحَقٌّ أَنَّ مَحجوباً","سَلا عَنكَ بِفَخّارَه",15,"ر",2,0],["أَحَقٌّ أَنَّ مَطوِيَّ اللَيالي","سَيُنشَرُ بَينَ أَحمَدَ وَالوَليدِ",16,"د",1,0],["أَحَقٌّ كُنتِ لِلزَهراءِ ساحاً","وَكُنتِ لِساكِنِ الزاهي رِحابا",17,"ب",2,0],["أَحَقُّهُمُ بِالسَيفِ مَن ضَرَبَ الطُلى","وَبِالأَمنِ مَن هانَت عَلَيهِ الشَدائِدُ",18,"د",1,0],["أَحَقُّ عافٍ بِدَمعِكَ الهِمَمُ","أَحدَثُ شَيءٍ عَهداً بِها القِدَمُ",19,"م",1,1],["أَحَقُّ دارٍ بِأَن تُسمى مُبارَكَةً","دارٌ مُبارَكَةُ المَلكِ الَّذي فيها",20,"ي",3,1],["أحقّاً هممتمْ باللِّقاءِ لعلَّكُمْ","بدا لكُمُ أنَّ الطِباعَ تحولُ",21,"ل",1,0],["أَحَقّاً بِأَنَّ اللَيثَ بَعدَ اِبتِزازِهِ","نُفوسَ العِدى مِن شاسِعٍ وَمُجاوِرِ",22,"ر",1,0],["أَحَقُّ بِإِغلاءِ المُهورِ مِنَ الَّتي","رَبَت وَهيَ تَنزو في جُحورِ الوَلائِدِ",23,"د",1,0],["أَحَقَّ بَني حَوّاءَ أَن يُدرِكَ الَّتي","عَلَيهِم لَهُ لا يُستَطاعُ مَرامُها",24,"م",3,0],["أَحَقُّ أَباً وَاِبناً وَقَوماً إِذا جَرى","إِلى المَوتِ بِالمُستَأثَراتِ الجَسائِمِ",25,"م",1,0],["أَحَقّاً عادَ طَعمُ العَيشِ مُرّاً","وكانَ بزَفْتِك المَرْمُوقِ حُلوا",26,"و",2,0],["أحقاً تولَّى ذلك الهولُ وامَّحَت","خواطرُ ذاكَ الويل والرعب والحقدِ",27,"د",1,0],["أحقاً كنت في قربي","لعلي واهمٌ وهما",28,"م",2,1],["أَحَقُّ الناسِ بِالكَرَمِ اِمرُؤٌ لَم","يَزَل يَأوي إِلى أَصلٍ كَريمِ",29,"م",1,0],["أَحَقّاً أَنَّ حَيّاً سَوفَ يَقضي","وَقَد كَثُرَت بِصاحِبِيَ الظُنونُ",30,"ن",1,0],["أَحَقّاً بِأَن لَم تَهوَ غانِيَةٌ فَتىً","وَأَنَّ أُناساً لَم يُحِبّوا وَيَعشَقوا",31,"ق",3,0],["أَحَقّاً لَئِن دارُ الرَبابِ تَباعَدَت","أَوِ اِنبَتَّ حَبلٌ أَنَّ قَلبَكَ طائِرُ",32,"ر",1,0],["أَحَقّاً عِبادَ اللَهِ أَن لَستُ ناظِراً","إِلى قَرقَرى يَوماً وَأَعلامِها الغُبرِ",33,"ر",1,1],["أَحَقّاً عِبادَ اللَهِ أَن لَستُ وارِداً","وَلا صادِراً إِلّا عَلَيَّ رَقيبُ",34,"ب",1,0],["أَحَقّاً كُنتَ رَبَّ التاجِ فيها","وَكُنتَ الشَعبَ وَالملكَ النَبيلا",35,"ل",2,0],["أَحَقّاً أَنتَ داهِيَةٌ جَناها","عَلَينا مِن بَني التاميزِ جانِ",36,"ن",1,0],["أَحَقّاً أَنَّهُم صَدَقوا فَجاءوا","بِأَحسَنِ ما بَنى لِلخيرِ بانِ",36,"ن",1,0],["أَحَقّاً أَبا زِرٍّ حَديثٌ سَمِعتُهُ","وَإِلّا يَحَل مِن دونِ خَيرِكَ تَنفَعِ",37,"ع",1,1],["أَحَقُّ الصارِخينَ أَنا","بِواحَربا وَواسَلَبا",38,"ب",2,0],["أَحَقّاً مِنكَ أَنَّكَ لَن تَراني","عَلى حالٍ وَأَنّي لَن أَراكا",39,"ك",2,1],["أَحَقُّ مَنزِلَةٍ بِالتَركِ مَنزِلَةٌ","تَعَطَّلَت مِن هَوىً عِلقٍ لِأَهليها",40,"ي",3,0],["أحقُّ منزلةً بالتَركِ منزلَةً","وصلُ الحبيبُ عليها غير مأنوس",41,"س",1,0],["أَحَقّاً يَقولُ النَّاسُ في جُودِ حَاتمٍ","وَابْنُ سِنَانٍ كانَ فِيهِ سَخَاءُ",42,"ا",2,0],["أَحقائقٌ ما قد مثلن أَمامي","أَم ما أَرى صور من الأوهامِ",43,"م",1,1],["أحقر بعصر به الإنسان يعبد ما","في وهمه وله يعنو وينقاد",44,"د",1,1],["أَحقاً تَرى أَنَّ الهدى غير ما ندري","وأَنا جَميعاً في ضلال من الأمرِ",45,"ر",1,1],["أَحَقّاً أَتَانِي أَنَّ عَوْفَ بْنَ مَالِكٍ","بِبَطْنِ رَمَى يُهْدِي إليَّ القَوَافِيَا",46,"ي",2,1],["أحقّهم بالسّيف من ضرب الطّلى","وبالأمر من هانت عله الشّدائد",47,"د",1,0],["أحقاً فرغتِ إذن ما سُعارُكِ","لم يبْقَ يا نارُ ما يُنهَشُ",48,"ش",1,0],["أحقيقةٌ في الكونِ أم أُسطورةٌ","هذا الصِّراعُ الخالدُ الجبَّارُ",49,"ر",1,0],["أحقّاً ما يُقال شيوخُ جيلٍ","على أحقادهم فيه أكبُّوا",50,"ب",3,0],["أَحَقّاً أَتَانا الدهْرُ بِالْبِشْرِ بَعْدَ مَا","رَمَانَا بِهِ مِنْ مُتْعِسٍ إِثْرَ مُتْعِسِ",51,"س",1,0],["أَحَقُّ فَتَىً بِمَا تَصِفُ القَوَافِي","فَتىً فِيهِ الشَّجَاعَةُ وَالحَيَاءُ",52,"ا",2,0],["أحقيقة عرفا لظى","أم وصف مبتدع نجيب",53,"ب",1,0],["أحقاً أنَ ليلكِ صار ليلاً","وَمغْنَى اللهوِ قد أمسى ظلاما",54,"م",2,0],["أحقًّا بات «رأس التين» حِلاًّ","تطوِّقه الكتائبُ والسلاحُ؟",55,"ح",1,0],["أحقا عميد الدين لاقى حمامه","فاني أرى نفس الهدى تتلدم",56,"م",1,0],["أحقا عماد الاستقامة أصبحت","به اعوجيات من البين ترسم",56,"م",1,0],["أحقا ملاك الفضل اودى فتلكم","يمين الجد اشلاء والكف أجذم",56,"م",1,0],["أحقا منار العلم أسقطه الردى","كأن سقوط العلم للحتف مغنم",56,"م",1,0],["أحقا إمام الزهد عارضه الفنا","فهل أنف دنيانا من الزهد يرغم",56,"م",1,0],["أحقا سحاب البر أقلع نوؤه","فهل يتأتى بعد للبر موسم",56,"م",1,0],["أحقا جميل الصنع كفت يمينه","وكانت هي الطولى تبر وتنعم",56,"م",1,0],["أحقا بهاتيك المعاهد غمة","من الحزن اذ واراه لحد مغمم",56,"م",1,0],["أحقاً تقاعدتم بها وهي دينكم","وخارت عن العز المقيم العزائم",57,"م",1,0],["أحقا ًعباد الله بعض سيوفكم","لدعوة أهل الاستقامة حاسم",57,"م",1,0],["أحقا عباد الله بعض قواكم","لقوة عباد الصليب دعائم",57,"م",1,0],["أحقا عباد الله أن خياركم","تناصب قوام الهدى وتقاوم",57,"م",1,0],["أحق للبرق من تلقاء أرضهم","ولي فؤاد إلى الألاف حنان",58,"ن",1,1],["أحقاً أن \" أمَّ الخير \" منها","بعاصمة \" الرشيد \" أحاطَ شرّ",59,"ر",1,0],["أحقَّاً بينَنا اختلَفَتْ حُدودٌ","وما اختَلفَ الطريقُ ولا التراب",60,"ب",1,0],["أحقُ الناس بالتلطيفِ يغدو","وكل حياته عَنَتٌ وزَهْقُ",61,"ق",1,0],["أحَقُّ بإغْلاءِ المُهُورِ مِنَ الّتي","رَبَتْ وَهْيَ تَنزُو في حجورِ الوَلائدِ",62,"د",1,0],["أحَقُّ أباً وابْناً وَقَوْماً، إذا جَرَى","إلى المَجْدِ بالمُسْتأثَرَاتِ الجَسائِمِ",63,"م",1,0],["أحقّا عباد الله أن لست زائرا","بثينة إلا أُصْغِيَتْ لي المسامع",64,"ع",1,0],["أحقاً لئن دارُ الربابِ تباعدتْ،","أَوِ کنْبَتَّ حَبْلٌ أَنَّ قَلْبَكَ طَائِرُ",65,"ر",1,0],["أحقًّا غُوطةُ الفِرْدَوْسِ دُوني","ودوني مِن جِنانِ الخُلْدِ شِقُّ؟",66,"ق",1,0],["أحقت على الأرضين لعنة ربها","فصب عليها سخطه غير راحم",67,"م",1,0],["أحقّ أنت أم شَكّ","أمَعنىً أنت أم مَبنى",68,"ن",2,0],["أحقًّا فارق الدنيا شفيق","وغيب جسمه هذا المضيقُ",69,"ق",1,1],["أَحَقّاً غَدا الرَكبُ المُغِذُّ إِلى مِنى","وَساروا إِلى القَبرِ المُجَلَّلِ بِالسَنا",70,"ن",2,0],["أحق شيءٍ بحسن الصبرَ نائبة","لا بدّ منها وصرفٌ ليس ينصرفُ",71,"ف",1,0],["أحق شيء برد ما يخالفه","شهادة العقل فاحكم صنعة الجدل",72,"ل",1,0],["أَحَقُّ مُلوكِ الأَرضِ بِالمُلكِ مَن بِهِ","يَنالُ الغِنى الراجي وَتُحمى الحَقائِقُ",73,"ق",1,0],["أَحَقّاً ثَوى في اللَحدِ وَاِستَوطَنَ الثَرى","وَجاوَرَ فِيهِ كُلَّ ذِي نازِحٍ دانِ",74,"ن",1,0],["أَحَقَّاً يا حَمامَةَ بَطْنِ وَجٍّ","بهذا النّوحِ إِنّكِ تصدُقينا",75,"ن",2,1],["أَحَقّاً عِبادَ اللهِ أَنْ لستُ زائراً","عُفَيْراءَ إلاّ والوليدُ يَراني",76,"ن",2,0],["أَحَقّاً عِبادَ اللهِ أَن لَستُ ماشِياً","بِذِى الأَثلِ حَتَّى يُحشَرَ الثَّقَلانِ",77,"ن",1,0],["أَحقّاً عِبادَ اللهِ أَن لَستُ صادِراً","وَلا وارداً إِلاَّ عَلَىَّ رَقِيبُ",78,"ب",1,0],["أَحَقاً عِبادَ اللهِ أَن لَستُ رَائياً","سَنامَ الحِمى أُخرى اللّيَالى الغَوَابرِ",79,"ر",1,1],["أَحَقًّا عِبَادَ اللهِ أَن لَستُ مَاشِياً","بِمرحَابَ حتّى يُحشَرَ الثَّقَلاَنِ",80,"ن",1,0],["أحقّ الناس بالصفع الجلال","فتى يهوى الملاح بغير مال",81,"ل",1,1],["أحقّ بغضّ الطرف ما عاش من إذا","رنا غضّ عنه طرفه من يلاحظُه",82,"ظ",2,1],["أحقّ الناس بالذل الفقير","وأقربهم من الضرّ