ر خالد","https://www.aldiwan.net/poem40388.html","الطويل"],[369,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[374,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[380,"احقد على الشيطان إن كنت راهبا","https://www.aldiwan.net/poem59348.html","الطويل"],[383,"أعند الحر للأيام ثار","https://www.aldiwan.net/poem48783.html","الوافر"],[383,"لمن طلل بعد القطين تغيرا","https://www.aldiwan.net/poem49255.html","الطويل"],[399,"أحقاً بني أبناء سلمى بن جندلٍ","https://www.aldiwan.net/poem588.html",""],[405,"إمامنا حيدرة أفضل","https://www.aldiwan.net/poem46970.html","السريع"],[406,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[435,"أحق بقاع الأرض بالرفض بلدة","https://www.aldiwan.net/poem12636.html","الكامل"],[440,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[440,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[442,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[460,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[460,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[460,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[460,"أحقا يا أبا نصر فترجى","https://www.aldiwan.net/poem56074.html","الوافر"],[460,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[460,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[466,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[507,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[540,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[553,"أقول لزيد كفكف الخيل عنوة","https://www.aldiwan.net/poem47178.html","الطويل"],[555,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[555,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[560,"أنا النور المبين ولا أكني","https://www.aldiwan.net/poem33817.html","الوافر"],[566,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[566,"ولو كنت مثلي في الغرام متيما","https://www.aldiwan.net/poem888.html",""],[568,"أرقت فلم تخدع بعيني وسنة","https://www.aldiwan.net/poem1930.html","الطويل"],[575,"أحق ما كان من قلبي تباريح","https://www.aldiwan.net/poem3654.html","البسيط"],[589,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/124810","الرجز"],[811,"","https://poetry.dctabudhabi.ae/diwan/poem/31482","الوافر"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10489","الوافر"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/29374","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21405","الطويل"],[1101,"","https://poetry.dctabudhabi.ae/diwan/poem/20980","الطويل"]],"verses":[["أَحَقُّ مَن كانَتِ النَعماءُ سابِغَةً","عَلَيهِ مَن أَسبَغَ النُعمى عَلى الأُمَمِ",0,"م",1,1],["أَحَقُّ بِلادِ اللَهِ بِالمُزنِ أَرضُهُ","إِذا شامَ أَقصى خَطرَةِ البَرقِ رائِدُ",1,"د",1,0],["أَحَقّاً بِأَنَّ المَجدَ هيضَت جُبورُهُ","وَزالَ عَنِ الحَيّ الطَوالُ المَلاوِثُ",2,"ث",1,0],["أَحَقٌّ أَم خَيالُكَ زارَ شُعثاً","وَأَطلاحاً جَوانِحَ بِالقُيودِ",3,"د",1,0],["أَحَقٌّ بَلاغاتٌ أَتَتني مَشابِهاً","وَبَيِّن لَهُ إِنَّ البَيانَ مِنَ الصِدقِ",4,"ق",1,0],["أَحَقّاً رَأَيتَ الظاعِنينَ تَحَمَّلوا","مِنَ الغيلِ أَو وادي الوَريعَةِ ذي الأَثلِ",5,"ل",1,0],["أَحَقُّ بِها مِن فِتيَةٍ وَرَكائِبٍ","تُقَطِّعُ عَنها اللَيلَ عوجٌ ضَوامِرُ",6,"ر",1,0],["أحقًّا أراني في ثرى عتباته","نباتاً يحيي وَاكفَ المزن بالزهر",7,"ر",1,0],["أحقّاً رضيتَ بأنَّ الغنى","عدوٌّ لعبدك والفقر خِلُّ",8,"ل",1,0],["أحقُّ برِفْدك من آملي","ه من لم يؤمْله في الآملينا",9,"ن",2,1],["أَحَقُّ بِإِكرامِكُم طائِرٌ","يُغَرِّدُ في الرَوضِ وَالبَلقَعِ",10,"ع",1,0],["أَحَقُّ بِما قالَ ابنُ قَيسٍ لِمالِكٍ","وَأَولى بِما قالَ ابنُ أَوسٍ لِمُصعَبِ",11,"ب",1,0],["أَحِقِّي يا سماء مُنى نفوس","إليك لها إليك لها التجاء",12,"ا",2,0],["أحق أنهم دفنوا عليا","وحطوا في الثرى المرء الزكيا",13,"ي",2,1],["أحق بالشعر ولا بالهوى","من قيسٍ المجنونِ أو من جميل",14,"ل",1,0],["أَحَقٌّ أَنَّ مَحجوباً","سَلا عَنكَ بِفَخّارَه",15,"ر",2,0],["أَحَقٌّ أَنَّ مَطوِيَّ اللَيالي","سَيُنشَرُ بَينَ أَحمَدَ وَالوَليدِ",16,"د",1,0],["أَحَقٌّ كُنتِ لِلزَهراءِ ساحاً","وَكُنتِ لِساكِنِ الزاهي رِحابا",17,"ب",2,0],["أَحَقُّهُمُ بِالسَيفِ مَن ضَرَبَ الطُلى","وَبِالأَمنِ مَن هانَت عَلَيهِ الشَدائِدُ",18,"د",1,0],["أَحَقُّ عافٍ بِدَمعِكَ الهِمَمُ","أَحدَثُ شَيءٍ عَهداً بِها القِدَمُ",19,"م",1,1],["أَحَقُّ دارٍ بِأَن تُسمى مُبارَكَةً","دارٌ مُبارَكَةُ المَلكِ الَّذي فيها",20,"ي",3,1],["أحقّاً هممتمْ باللِّقاءِ لعلَّكُمْ","بدا لكُمُ أنَّ الطِباعَ تحولُ",21,"ل",1,0],["أَحَقّاً بِأَنَّ اللَيثَ بَعدَ اِبتِزازِهِ","نُفوسَ العِدى مِن شاسِعٍ وَمُجاوِرِ",22,"ر",1,0],["أَحَقُّ بِإِغلاءِ المُهورِ مِنَ الَّتي","رَبَت وَهيَ تَنزو في جُحورِ الوَلائِدِ",23,"د",1,0],["أَحَقَّ بَني حَوّاءَ أَن يُدرِكَ الَّتي","عَلَيهِم لَهُ لا يُستَطاعُ مَرامُها",24,"م",3,0],["أَحَقُّ أَباً وَاِبناً وَقَوماً إِذا جَرى","إِلى المَوتِ بِالمُستَأثَراتِ الجَسائِمِ",25,"م",1,0],["أَحَقّاً عادَ طَعمُ العَيشِ مُرّاً","وكانَ بزَفْتِك المَرْمُوقِ حُلوا",26,"و",2,0],["أحقاً تولَّى ذلك الهولُ وامَّحَت","خواطرُ ذاكَ الويل والرعب والحقدِ",27,"د",1,0],["أحقاً كنت في قربي","لعلي واهمٌ وهما",28,"م",2,1],["أَحَقُّ الناسِ بِالكَرَمِ اِمرُؤٌ لَم","يَزَل يَأوي إِلى أَصلٍ كَريمِ",29,"م",1,0],["أَحَقّاً أَنَّ حَيّاً سَوفَ يَقضي","وَقَد كَثُرَت بِصاحِبِيَ الظُنونُ",30,"ن",1,0],["أَحَقّاً بِأَن لَم تَهوَ غانِيَةٌ فَتىً","وَأَنَّ أُناساً لَم يُحِبّوا وَيَعشَقوا",31,"ق",3,0],["أَحَقّاً لَئِن دارُ الرَبابِ تَباعَدَت","أَوِ اِنبَتَّ حَبلٌ أَنَّ قَلبَكَ طائِرُ",32,"ر",1,0],["أَحَقّاً عِبادَ اللَهِ أَن لَستُ ناظِراً","إِلى قَرقَرى يَوماً وَأَعلامِها الغُبرِ",33,"ر",1,1],["أَحَقّاً عِبادَ اللَهِ أَن لَستُ وارِداً","وَلا صادِراً إِلّا عَلَيَّ رَقيبُ",34,"ب",1,0],["أَحَقّاً كُنتَ رَبَّ التاجِ فيها","وَكُنتَ الشَعبَ وَالملكَ النَبيلا",35,"ل",2,0],["أَحَقّاً أَنتَ داهِيَةٌ جَناها","عَلَينا مِن بَني التاميزِ جانِ",36,"ن",1,0],["أَحَقّاً أَنَّهُم صَدَقوا فَجاءوا","بِأَحسَنِ ما بَنى لِلخيرِ بانِ",36,"ن",1,0],["أَحَقّاً أَبا زِرٍّ حَديثٌ سَمِعتُهُ","وَإِلّا يَحَل مِن دونِ خَيرِكَ تَنفَعِ",37,"ع",1,1],["أَحَقُّ الصارِخينَ أَنا","بِواحَربا وَواسَلَبا",38,"ب",2,0],["أَحَقّاً مِنكَ أَنَّكَ لَن تَراني","عَلى حالٍ وَأَنّي لَن أَراكا",39,"ك",2,1],["أَحَقُّ مَنزِلَةٍ بِالتَركِ مَنزِلَةٌ","تَعَطَّلَت مِن هَوىً عِلقٍ لِأَهليها",40,"ي",3,0],["أحقُّ منزلةً بالتَركِ منزلَةً","وصلُ الحبيبُ عليها غير مأنوس",41,"س",1,0],["أَحَقّاً يَقولُ النَّاسُ في جُودِ حَاتمٍ","وَابْنُ سِنَانٍ كانَ فِيهِ سَخَاءُ",42,"ا",2,0],["أَحقائقٌ ما قد مثلن أَمامي","أَم ما أَرى صور من الأوهامِ",43,"م",1,1],["أحقر بعصر به الإنسان يعبد ما","في وهمه وله يعنو وينقاد",44,"د",1,1],["أَحقاً تَرى أَنَّ الهدى غير ما ندري","وأَنا جَميعاً في ضلال من الأمرِ",45,"ر",1,1],["أَحَقّاً أَتَانِي أَنَّ عَوْفَ بْنَ مَالِكٍ","بِبَطْنِ رَمَى يُهْدِي إليَّ القَوَافِيَا",46,"ي",2,1],["أحقّهم بالسّيف من ضرب الطّلى","وبالأمر من هانت عله الشّدائد",47,"د",1,0],["أحقاً فرغتِ إذن ما سُعارُكِ","لم يبْقَ يا نارُ ما يُنهَشُ",48,"ش",1,0],["أحقيقةٌ في الكونِ أم أُسطورةٌ","هذا الصِّراعُ الخالدُ الجبَّارُ",49,"ر",1,0],["أحقّاً ما يُقال شيوخُ جيلٍ","على أحقادهم فيه أكبُّوا",50,"ب",3,0],["أَحَقّاً أَتَانا الدهْرُ بِالْبِشْرِ بَعْدَ مَا","رَمَانَا بِهِ مِنْ مُتْعِسٍ إِثْرَ مُتْعِسِ",51,"س",1,0],["أَحَقُّ فَتَىً بِمَا تَصِفُ القَوَافِي","فَتىً فِيهِ الشَّجَاعَةُ وَالحَيَاءُ",52,"ا",2,0],["أحقيقة عرفا لظى","أم وصف مبتدع نجيب",53,"ب",1,0],["أحقاً أنَ ليلكِ صار ليلاً","وَمغْنَى اللهوِ قد أمسى ظلاما",54,"م",2,0],["أحقًّا بات «رأس التين» حِلاًّ","تطوِّقه الكتائبُ والسلاحُ؟",55,"ح",1,0],["أحق للبرق من تلقاء أرضهم","ولي فؤاد إلى الألاف حنان",56,"ن",1,1],["أحقاً أن \" أمَّ الخير \" منها","بعاصمة \" الرشيد \" أحاطَ شرّ",57,"ر",1,0],["أحقَّاً بينَنا اختلَفَتْ حُدودٌ","وما اختَلفَ الطريقُ ولا التراب",58,"ب",1,0],["أحقُ الناس بالتلطيفِ يغدو","وكل حياته عَنَتٌ وزَهْقُ",59,"ق",1,0],["أحَقُّ بإغْلاءِ المُهُورِ مِنَ الّتي","رَبَتْ وَهْيَ تَنزُو في حجورِ الوَلائدِ",60,"د",1,0],["أحَقُّ أباً وابْناً وَقَوْماً، إذا جَرَى","إلى المَجْدِ بالمُسْتأثَرَاتِ الجَسائِمِ",61,"م",1,0],["أحقّا عباد الله أن لست زائرا","بثينة إلا أُصْغِيَتْ لي المسامع",62,"ع",1,0],["أحقاً لئن دارُ الربابِ تباعدتْ،","أَوِ کنْبَتَّ حَبْلٌ أَنَّ قَلْبَكَ طَائِرُ",63,"ر",1,0],["أحقًّا غُوطةُ الفِرْدَوْسِ دُوني","ودوني مِن جِنانِ الخُلْدِ شِقُّ؟",64,"ق",1,0],["أحقت على الأرضين لعنة ربها","فصب عليها سخطه غير راحم",65,"م",1,0],["أحقّ أنت أم شَكّ","أمَعنىً أنت أم مَبنى",66,"ن",2,0],["أحقًّا فارق الدنيا شفيق","وغيب جسمه هذا المضيقُ",67,"ق",1,1],["أَحَقّاً غَدا الرَكبُ المُغِذُّ إِلى مِنى","وَساروا إِلى القَبرِ المُجَلَّلِ بِالسَنا",68,"ن",2,0],["أحق شيءٍ بحسن الصبرَ نائبة","لا بدّ منها وصرفٌ ليس ينصرفُ",69,"ف",1,0],["أحق شيء برد ما يخالفه","شهادة العقل فاحكم صنعة الجدل",70,"ل",1,0],["أَحَقُّ مُلوكِ الأَرضِ بِالمُلكِ مَن بِهِ","يَنالُ الغِنى الراجي وَتُحمى الحَقائِقُ",71,"ق",1,0],["أَحَقّاً ثَوى في اللَحدِ وَاِستَوطَنَ الثَرى","وَجاوَرَ فِيهِ كُلَّ ذِي نازِحٍ دانِ",72,"ن",1,0],["أَحَقَّاً يا حَمامَةَ بَطْنِ وَجٍّ","بهذا النّوحِ إِنّكِ تصدُقينا",73,"ن",2,1],["أَحَقّاً عِبادَ اللهِ أَنْ لستُ زائراً","عُفَيْراءَ إلاّ والوليدُ يَراني",74,"ن",2,0],["أَحَقّاً عِبادَ اللهِ أَن لَستُ ماشِياً","بِذِى الأَثلِ حَتَّى يُحشَرَ الثَّقَلانِ",75,"ن",1,0],["أَحقّاً عِبادَ اللهِ أَن لَستُ صادِراً","وَلا وارداً إِلاَّ عَلَىَّ رَقِيبُ",76,"ب",1,0],["أَحَقاً عِبادَ اللهِ أَن لَستُ رَائياً","سَنامَ الحِمى أُخرى اللّيَالى الغَوَابرِ",77,"ر",1,1],["أَحَقًّا عِبَادَ اللهِ أَن لَستُ مَاشِياً","بِمرحَابَ حتّى يُحشَرَ الثَّقَلاَنِ",78,"ن",1,0],["أحقّ الناس بالصفع الجلال","فتى يهوى الملاح بغير مال",79,"ل",1,1],["أحقّ بغضّ الطرف ما عاش من إذا","رنا غضّ عنه طرفه من يلاحظُه",80,"ظ",2,1],["أحقّ الناس بالذل الفقير","وأقربهم من الضرّ الضرير",81,"ر",1,1],["أَحقّاً فتى الفتيانِ سُلِّمَ للردى","وأَسْلَمَهُ جيرانُه والأقاربُ",82,"ب",1,0],["أحقاً رأيتَ الموتَ دامي المخالبِ","وفي كلِّ نادٍ عصبةٌ حولَ نادبِ",83,"ب",1,1],["أحقّ أن مغنى الثغر أقوى","واقفر من أحاديث الصحاب",84,"ب",1,0],["أَحَقُّ بِنا الظَلماءُ من كُلِّ وجهَةٍ","فَفينا وُجوهٌ يُستَبَدُّ صَفيقُها",85,"ق",3,0],["أَحَقُّ دارٍ وَأولى أَن نُهنِّئَها","دارٌ عَلى السَعدِ قَد شيدَت مَبانيها",86,"ي",3,1],["أَحَقُّ بِلَومٍ مَن سَهِرتُ مُراعِياً","لَهُ النَجمَ في تَنقيحِ غَرّاءَ كَالنَجمِ",87,"م",1,0],["أَحقَرُ مِن بَقَّةٍ وَأَجفى","خَلائِقاً مِن حِمارِ وَحشِ",88,"ش",1,0],["أَحَقًّا عِبَادَ اللهِ أُمْنَعُ مِنْ وَرْدٍ","تَبَدَّى بِلَحْظِي فِي خُدُودِ رَشاً هِنْدِي",89,"د",2,1],["أَحَقٌّ ما رَأَيتُ أَمِ اِحتِلامُ","أَمِ الأَهوالُ إِذ صَحبي نِيامُ",90,"م",1,1],["أحقُّ دارٍ بأن ترجُو النَّعيمَ لها","ما طابَ مُغتَبَقٌ فيها ومُصطبَح",91,"ح",1,0],["أحَقُّ مُلوكِ الأرْضِ رَأياً وَرايَةً","بِفَوْز ونَصر لاعَدا الفوْزَ والنّصْرا",92,"ر",2,0],["أحَقّاً طَربتَ إلَى الرّبْرَبِ","ومُذْ شَطَّت الدارُ لَمْ تَطْرَب",93,"ب",1,1],["أحقاً قضى ذاك الجلال وقوضت","مباني معال في السماء سوامك",94,"ك",1,0],["أحقاً ثوى بين هذي الرموس","وصار له بينها مضجع",95,"ع",1,0],["أَحقُّ صبٍّ بأَنْ يولى المعونةَ مَنْ","لم يأْلُ جهداً وَلكنْ حظه تمس",96,"س",1,0],["أَحقاً عبادَ اللهِ إنّ بلادَنا","تناوَلها الأيدي كَنَهْبٍ مقسم",97,"م",1,0],["أَحَقُّ الناسَ بِالتَفضي","لِ مَن تُرجى فَواضِلُهُ",98,"ل",2,0],["أَحقّ بَني الأَيّام بالحُزن وَالأَسا","كَريم عَلى الأَهوال للصَبر فاقدُ",99,"د",1,0],["أَحَقُّ سَحابٍ بِاِتِّقاءِ وَخيفَةٍ","سَحابٌ إِذا ما شاءَ أَدمى وَدَيَّما",100,"م",2,0],["أحقُّ امرئٍ أجلسَته العُلى","ليَفعلَ أمرينِ في مجلِسِ",101,"س",1,0],["احقد على الشيطان إن كنت راهباً","تنل من إله الحب حبّاً مع الحظِّ",102,"ظ",1,1],["أَحَقاً أَنتَ يا مَولايَ غادٍ","وَبَعدَك لي سُكون أَو قَرار",103,"ر",1,0],["أَحق مِن المَقتول ظُلماً بِرَحمة","مُشوقٌ رَأى ما هاجَ مِنهُ التَذَكُرا",104,"ر",2,0],["أَحَقاً بني أبناء سَلمَى بن جَندلٍ","وعيدُكُمُ إيايَ وَسطَ المجالسِ",105,"س",1,1],["أحقُّها من بَعدِ خير الورى","بالسَّبق في الفَضْل وأَوْلاَها",106,"ا",3,0],["أحقاً جرى ما يسبل العبرات","ويجري دماء العين لا الدمعات",107,"ت",1,1],["أحقُّ بقاعِ الأرضِ بالرَفْضِ بلدةٌ","خبَطْتَ بها الظَلْماءَ وسْطَ نهارِ",108,"ر",1,1],["أحقّا صددت وخُنتَ الودادا","وأبدلتني بالتداني البعادا",109,"د",2,1],["أحق بأن يدعى المعظم وحدهُ","وأولى البرايا أن يقال له ابنما",110,"م",2,0],["أَحَقَّ حقَّكَ فِي الملكِ الَّذِي ضَمِنَتْ","ميراثَهُ لَكَ أملاكٌ وأَقيالُ",111,"ل",1,0],["أحقًّاً تستقيدونَ","من الفُرسِ بنفسيْنا",112,"ن",2,0],["أحقُّ بالأرض إذا أنصفتُمُ","عامرُها بشرف العزائمِ",113,"م",1,0],["أحقّاً تقنَّصني بالحجا","ز في شِكَّتي رشأٌ أعزلُ",114,"ل",1,0],["أحقّاً يا أبا نصرٍ فتُرجَى","وُعودُك أم تسوِّفني مُحالا",115,"ل",2,1],["أحقُّ بآمالي أخو كرمٍ أرى","بعينِ يقيني عنده ما أؤمِّلُ",116,"ل",1,0],["أحقُّهم عندي بما قمتُ مثنياً","أعدِّده مَنْ فات إحسانهُ عَدِّي",117,"د",2,0],["أحقاً سيقضي البين فينا بحكمه","وتمسي سهول الحبّ وهي حزون",118,"ن",1,0],["أحقوقٌ وما استعادتْ رغيفا؟","أم فسادٌ بهِ استُعيدَتْ سَدومُ؟",119,"م",1,0],["أحَقًّا بني فاسِ بأنَّ بَنيكُمُ","لَقَوا من صُروفِ الدَّهرِ ما أغضَبَ الدَّهرا",120,"ر",2,0],["أَحقّاً بني الإِحجامِ ما طار عنكمُ","أطرتمْ وربّي في ضلوعكمُ اللَّدْنا",121,"ن",2,0],["أَحَقُّ مَنزِلَةٍ بِالتَركِ مَنزِلَةٌ","تَعَطَّلَت مِن هَوى نَفسي نَواديها",122,"ي",3,0],["أَحَقٌّ أَنَّهُ أَودى يَزيدُ","تَأَمَّل أَيُّها الناعي المُشيدُ",123,"د",1,1],["أحقق من أريد بعلم حقي","وأسكر من أشاء بخمر دني",124,"ن",2,0],["أحق امرؤ يدعى الإمام لأنه","لأهل الهدى جبر وأهل العمى كسر",125,"ر",1,0],["أحق إذا أشكو الجوى لا تجيبني","وتهجرني ظلماً وما أنا مجرم",126,"م",1,0],["أَحَقّاً أَبَيتَ اللَّعنَ أَنَّ اِبنَ فَرتَنا","عَلى غَيرِ إِجرامٍ بِرِيقِي مُشَرِّقي",127,"ق",2,0],["أَحَقُّ ما كانَ مِن قَلبي تَباريحُ","فَليُهنئ العَينَ إَنَّ الدَمعَ مَسفوحُ",128,"ح",1,1],["أحق وأعلا منظراً ومقامكم","أجل لدى أهل النهى المكارم",129,"م",1,0],["أَحَقُّ مالٍ فَكُلُوهُ بِأُكْلْ","أَمْوالُ تَيْمٍ وعَدِيّ وعُكُلْ",130,"ل",1,1],["أَحَقّاً أَنَّكُم لَمّا قَتَلتُم","نَدامايَ الكِرامَ هَجَوتُموني",131,"ن",2,0],["أَحَقُّ بِكُم وَأَجدَرُ أَن تَصيدوا","مِنَ الفُرسانِ تَرفُلُ في الدُروعِ",132,"ع",1,0],["أحق شبابكم من حرب قوم","له خلق وناحية وداب",133,"ب",1,0],["أَحَقُّ وَأَحرى أَن تَبيتَ لَدَيهُما","عَلى الأَمنِ في لَيلٍ تُخافُ غَوائِرُه",134,"ر",2,0],["أَحَقّاً عِبادَ اللَهِ أَن لَستُ سامِعاً","نَشيدَ الرُعاءِ المُعزِبينَ المَتالِيا",135,"ي",2,0]]}