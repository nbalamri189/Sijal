{"poems":[[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[89,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[43,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85381","الخفيف"],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[135,"لله همة ذا الرئيس فإنها","https://www.aldiwan.net/poem49109.html","الكامل"],[143,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[285,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[297,"لله مهجة واله لم يثنها","https://www.aldiwan.net/poem33079.html","الكامل"],[364,"ذهب التكرم والوفاء من الورى","https://www.aldiwan.net/poem60875.html","الكامل"],[461,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"]],"verses":[["وَفَشى ما كُنتَ تَضمُرُهُ","فَعَرَفنا ناقِضَ القَسَمِ",0,"م",1,0],["وفشا ضوءه فمزق ما قد","كان لليل من غلائل سود",1,"د",1,0],["وَفَشَت سَرائِرُنا إِلَيكَ وَشَفَّنا","تَعريضُنا فَبَدا لَكَ التَصريحُ",2,"ح",1,0],["وَفَشا صيتُ حسنها يَتَمَشى","مَع ذكر العفاف بين الأنام",3,"م",1,0],["وفشى ما كنت تضمره","فعرفنا ناقص القسم",4,"م",1,0],["وفشا العلا بين العباد فآمرٌ","بالعرف أو ناه أخاً عن منكر",5,"ر",1,0],["وَفَشَت جِراحٌ كانَ أَخطَرَ مَوقِعاً","مِنها وَأَنكى ما تُجِنُّ الأَضلُعُ",6,"ع",1,0],["وفشى التدجيل فيهم","واستظلوا بالقباب",7,"ب",1,0],["وَفشت سرائرُ للهوى لم يُفشِها","إِذ أَثَّرت في وجنتيه بخدشِها",8,"ه",2,0],["وفشَتْ خِياناتُ الثِّقاتِ وغيرهم","حتّى اتّهمْنا رُؤيةَ الأبصار",9,"ر",1,0],["وفَشا الحِذارُ به فكلُّ قبيلةٍ","جُهَّالُها من خوْفهِ حُلَماءُ",10,"ا",2,0]]}