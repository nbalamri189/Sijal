{"poems":[[93,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[91,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[45,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85381","الخفيف"],[93,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[139,"لله همة ذا الرئيس فإنها","https://www.aldiwan.net/poem49109.html","الكامل"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[290,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[302,"لله مهجة واله لم يثنها","https://www.aldiwan.net/poem33079.html","الكامل"],[369,"ذهب التكرم والوفاء من الورى","https://www.aldiwan.net/poem60875.html","الكامل"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99978","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59133","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48923","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77345","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93949","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107297","الكامل"],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""]],"verses":[["وَفَشى ما كُنتَ تَضمُرُهُ","فَعَرَفنا ناقِضَ القَسَمِ",0,"م",1,0],["وفشا ضوءه فمزق ما قد","كان لليل من غلائل سود",1,"د",1,0],["وَفَشَت سَرائِرُنا إِلَيكَ وَشَفَّنا","تَعريضُنا فَبَدا لَكَ التَصريحُ",2,"ح",1,0],["وَفَشا صيتُ حسنها يَتَمَشى","مَع ذكر العفاف بين الأنام",3,"م",1,0],["وفشى ما كنت تضمره","فعرفنا ناقص القسم",4,"م",1,0],["وفشا العلا بين العباد فآمرٌ","بالعرف أو ناه أخاً عن منكر",5,"ر",1,0],["وَفَشَت جِراحٌ كانَ أَخطَرَ مَوقِعاً","مِنها وَأَنكى ما تُجِنُّ الأَضلُعُ",6,"ع",1,0],["وفشى التدجيل فيهم","واستظلوا بالقباب",7,"ب",1,0],["وَفشت سرائرُ للهوى لم يُفشِها","إِذ أَثَّرت في وجنتيه بخدشِها",8,"ه",2,0],["وفشَتْ خِياناتُ الثِّقاتِ وغيرهم","حتّى اتّهمْنا رُؤيةَ الأبصار",9,"ر",1,0],["وفَشا الحِذارُ به فكلُّ قبيلةٍ","جُهَّالُها من خوْفهِ حُلَماءُ",10,"ا",2,0],["وفَشَا الحَدِيثُ بِحُبِّنا","والحُبُّ يَحْسُنُ إِنْ فَشَا",11,"ش",2,0],["وفشا سقامي ما كتمت من الأسى","وخفيت حتى لا أرى في مضجع",12,"ع",1,0],["وفَشَتْ ألْسُنُ نَمَّامِ السَّحَرْ","سِرَّهُ المَكْتُومْ",13,"م",1,1],["وفشا التفريق فيه والونى","فهو سهل الكسر مثلُ القِدَد",14,"د",1,0],["وَفَشا الطَلاقُ وَصارَ شَرعاً صالِحاً","في كُلِّ مُعتَقَدٍ وَكُلَّ مَكانِ",15,"ن",1,0],["وَفَشتُ دَهنُوهَ طويلٌ ظاهِر","أحجارُ سُودٌ كُن لَهُ مًحَاذر",16,"ر",1,0],["وفشت بخديه وما","بالت ولا كادت تخبا",17,"ب",2,0],["وفَشا الشيبُ برَأسي فَمَحَا","صبغَةً كانت بهِ كالغَسَقِ",18,"ق",1,0],["وفشت حوليه أرواح السلام","كلُّ زهر باعثٌ منه شذاه",19,"ه",1,0],["وفَشا النِزاعُ مِن التَأَسِّي والأَسى","كلٌّ يُرِيدُ هُوَ الذي يَتَقَدَّمُ",20,"م",1,0],["وفشا الجهل فيه واستفحل البؤْ","سُ عليه يهتاج للهيحاء",21,"ا",2,0]]}