{"poems":[[65,"معاهدها والعهد ينسى ويذكر","https://www.aldiwan.net/poem46143.html","الطويل"],[79,"أو لست من لاك الكلام وصاغه","https://www.aldiwan.net/poem36517.html","الكامل"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[88,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[26,"أساءلت رسم الدار أم لم تسائل","https://www.aldiwan.net/poem24083.html","الطويل"],[26,"أمن أم سفيان طيف سرى","https://www.aldiwan.net/poem24085.html","المتقارب"],[94,"سئمت الليالي وأوجاعها","https://www.aldiwan.net/poem38972.html","المتقارب"],[34,"ونحن منعنا يوم أول نساءنا","https://www.aldiwan.net/poem27735.html","الطويل"],[87,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[47,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[63,"وركب أمموا قحطا","https://www.aldiwan.net/poem51576.html","الهزج"],[46,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[178,"طربت إلى عمي وعاودني ذكري","https://www.aldiwan.net/poem46042.html","الطويل"],[203,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[216,"وافى كتابكم كالبدر لؤلؤة","https://www.aldiwan.net/poem37879.html","البسيط"],[231,"على أطلال الحب","https://www.aldiwan.net/poem24227.html","عموديه"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[276,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[295,"هناك بذلك العلم","https://www.aldiwan.net/poem11658.html","مجزوء الوافر"],[445,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[445,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[445,"أضاء لها فجر النهى فنهاها","https://www.aldiwan.net/poem34917.html","الطويل"],[447,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[534,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[556,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[566,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122820","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122804","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38121","البسيط"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145629","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96355","الطويل"],[1285,"","https://poetry.dctabudhabi.ae/diwan/poem/31530","الوافر"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128297","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79864","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108841","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66269","الرجز"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29561","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111250","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9640","المتقارب"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3466,"","https://poetry.dctabudhabi.ae/diwan/poem/124615","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44724","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28679","الوافر"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62125","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52168","السريع"],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5190,"حتى حين","https://www.poetsgate.com/ViewPoem.aspx?id=153350",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5939,"أفيقي!","https://www.poetsgate.com/ViewPoem.aspx?id=180000",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""]],"verses":[["فحَطّتْ بهِ رَحْلَ المُكِلِّ وظَهْرُها","منَ الشُّكْرِ والشِّعْرِ المُحَبَّرِ مُوقَرُ",0,"ر",1,0],["فحطَطْتُ رَحْلي بيْنَ نيرانِ القِرى","ورَميْتُ بيْنَهُمُ عَصا التّسْيارِ",1,"ر",1,0],["فَحَطَّت سَريعاً لَم يَخُنها فُؤادُها","وَلا عَينُها مِن خَشيَةِ السَوطِ تَغفُلُ",2,"ل",1,0],["فَحُطنا بِالرِعايَةِ كُلَّ يَومٍ","نَحُفُّكَ بِالوَلاءِ المُستَديمِ",3,"م",1,0],["فَحَطَمْتُ شِقَّيْهِ تَوَهُّمَ أَنَّ مَا","عَاقَبْتُهُ شَفَتَانِ آثِمَتَانِ",4,"ن",1,0],["فحطَّت الفقر عن عواتقنا","وحطت الهم عن عواتقها",5,"ق",3,0],["فَحَطَّ عَلَيها وَالضُلوعُ كَأَنَّها","مِنَ الخَوفِ أَمثالُ السِهامِ النَواصِلِ",6,"ل",1,0],["فَحَطَّ مِنَ الحُزَنِ المُغفِرا","تِ وَالطَيرُ تَلثَقُ حَتّى تَصيحا",7,"ح",2,0],["فَحَطَّمتُ كَأْسي وأَلقَيتُها","بوَادي الأَسَى وجَحيمِ العَذابْ",8,"ب",1,0],["فَحُطنا بِها أَكنافَ مَكَّةَ بَعدَما","أَرادَت بِها ما قَد أَبى اللَهُ خِندِفُ",9,"ف",1,0],["فحطمنا الشكيم سوى بقايا","إذا عضت أريناها الجماحا",10,"ح",2,0],["فَحَطهُ الرِماحُ أَغيَدَ مَجدو","لاً قَصيرَ الزُنّارِ وافي الإِزارِ",11,"ر",1,0],["فحطُّوا رَحلَهم منه","بوادي الجَدْبِ إذ حَطُّوا",12,"ط",3,0],["فَحَطَطتُ تَحتَ غَمامَةٍ مَغمورَةٍ","بِحَيا بُروقٍ ضاحِكاً وَرُعودِ",13,"د",1,0],["فَحَطَطْنا الرِّحالَ حيثُ يحَطُّ ال","وِزْرُ عنّا وترفع الحوجاءُ",14,"ا",2,0],["فحطَّه منها إلى البسيطِ","كطائرٍ آذنَ بالسُّقوطِ",15,"ط",1,0],["فحطَّه من هَضَباتِ ولبِ","من غيرِ تعْنيتٍ وغيرِ حَرْبِ",15,"ب",1,0],["فحط رجلك عنها انها بلغت","\"نزوى\" وطافت بها للمجد أركان",16,"ن",1,0],["فحطَطتِ رَحلكِ عند آل","يَمتصُّ رِيَّ الصادرين",17,"ن",1,0],["فَحَطَّ عَلَى حُكْمِي رِحالَ إِجابَةٍ","وَسار بِما أَهْواهُ طَوْعاً إلَى أَمْرِي",18,"ر",2,0],["فحطَّتْ أكفَّ الموتِ عنها لثامها","وهيهاتَ بعدَ الموتِ أن تتلثما",19,"م",2,0],["فحطَّ طائرهُ في أنملي فَجَرتْ","دموعُ عينيَّ عنها يعجز المَطَرُ",20,"ر",1,0],["فحطم كل شامخة","على الأحداث والدهر",21,"ر",1,0],["فَحُطها بِلَحظٍ مِنكَ تَبدوا لَوائِحاً","عَليها إِماراتُ السَعادَةِ وَالجَدِّ",22,"د",1,0],["فحط عَبد الرَحيم ومن يَليه","فأَنتَ بكل مطرح رَحيم",23,"م",1,0],["فحطوا في العلا جدثي","وفوق شوامخ القُنَن",24,"ن",1,0],["فحطَطْتُ رحلي منكَ فِي عِزِّ الحِمى","ومنعتُ أَهلي منكَ فِي أَهلِ الحَرَمْ",25,"م",1,0],["فَحَطَمْتَ عُدَّةَ مُلْكِها وفَصَمْتَ عُرْ","وَةَ جَمْعِها وكَفَيْتَ غَرْبَ جِماحِها",26,"ح",3,0],["فَحَطَّتْ بمغنى الجودِ والمجدِ رَحْلَها","وَأَلقت بِرَبْعِ المَكرُمَاتِ عَصَاها",27,"ا",3,0],["فحط من ذروة الأَوتاد أَعصمها","حتى تباريه في الدهنا نقانقه",28,"ق",2,0],["فحطّت وقد لفَّ هامَ الربى","من الليل مِطرَفُه المَخمَلُ",29,"ل",1,0],["فَحَطَطْتُ رَحْلي بَيْنَ سُكّانِ الحِمَى","وأَنْخْتُهُ في مُخْصِباتِ شِعابِهِ",30,"ب",2,0],["فحُطّا صاحِبَيَّ بهمْ رِحالي","قُبَيْلَ نزولِ أمرٍ ترقُبانِ",31,"ن",1,0],["فَحَطَّ في عَلقى وَفي مُكورِ","بَينَ تَواري الشَمسِ وَالذُرورِ",32,"ر",1,0],["فَحَطَّت جَيثُ لا كَدَرٌ وَشَنٌ","لَدَيهِ وَحَيثُما خَضِرٌ وَصَفوُ",33,"و",1,0],["فَحَطَّت بِشَمسٍ دُونَها الشَّمسُ رُتبَةً","فَتىً قَمَرٌ مِن دُونِهِ القَمَرانِ",34,"ن",1,0],["فَحَطَّ ما حَولَها يَبغي مُحاصَرةً","إِنْ لَم يمكِّن بمشتقٍّ منَ الظُّلَمِ",35,"م",1,0],["فَحُطَّ الرَّحْلَ! لا سَفَرًا قَريبًا","وَأُقسِمُ لا أراكَ لَهَا مُسَافِرْ",36,"ر",1,0],["فحطّوا إلينا شاصِياتٍ كأنها","مِن السِندِ مسلوبُ القميصِ رواعِفُ",37,"ف",1,0],["فَحَطَّ العُصمَ مِن أَكنافِ شِعرٍ","فَلَم يَترُك بِذي سَلعٍ حِمارا",38,"ر",2,0],["فحطوا بدار القدس في خير منزل","وفاز بزلفى ذي الجلال حلولها",39,"ل",3,0],["فحطيمُ البيتِ لو لم يشهداه","كلُّ مَن قد أمّه أضحى حطيما",40,"م",2,0],["فحططت رحلي في فناء رحابه","حتى غدوت على النجوم مخيما",41,"م",2,0],["فحط للزوراء كل شامخ","حيث أصاب من به قد رفعا",42,"ع",2,0],["فَحَطَّ مِنَ السولِ المُلِمِّ وَتَلَّهُ","يَحِفُّ بِأَرباضِ اللأَراكِ ضَريرُها",43,"ر",3,0],["فحطت قدر كل اخي كمال","تعرضها بمدح او نسيب",44,"ب",1,0],["فَحُطَّ أنجركَ وَمَيِّز فيهَا","إذا آستَقًرَّ مَركَبُك عليهَا",45,"ه",2,0],["فَحَطَّ الرَبيعَ فَتىً شَرمَحٌ","أَخوذُ الرَغائِبِ مَنّانُها",46,"ن",3,0],["فحط رحلي في ثراها وسعى","صحبي وصاروا في رباها شيعا",47,"ع",2,0],["فحطّت بها أحمالها وتورّقَت","خمائل في أزهارها الفكر راتع",48,"ع",1,0],["فحطّتْ عليهم بغْتَةً كلَّ فارسٍ","بَروْدِ الحَواشي والطِّعانُ حَريقُ",49,"ق",1,0],["فحططنا لما حططنا عن الده","ر بها كل زلةٍ وخطيه",50,"ي",2,0],["فَحُطَّ لَدى ساكِني الخُلدِ قَدرا","وَسامُوهُ بَعدَ التَّرَفُّع قَهرا",51,"ر",2,0],["فَحَطَّمَ الأَفراخَ وَالمَكانا","وَلَم يُبال بِالَّذي قَد كانا",52,"ن",2,0],["فَحط بِرحلِنا نعماً","فَبِتنا نَشكُرُ النِّعما",53,"م",2,0],["فحط الرعية في مريع جنابها","وأرأب ثآها واصطنع أحرارها",54,"ر",3,0],["فحطَّهُ عادي الرَّدى من علٍ","والهَفةَ الجوّ على نَسْرِهِ",55,"ر",2,0],["فحطَّ والصحبُ رحالاً لَهم","وأهلَه وصحبَه صبَّرا",56,"ر",2,0],["فحطوا بأرجاء الهياكل صورة","لك اعتقدوها كاعتقاد الأقانم",57,"م",1,0],["فَحَطَّمْتِهِ بِيَمِينِ الظُّنُونِ","وقَالَتْ شِمَالُكِ : مَنْ حطَّمَهْ ؟!",58,"م",2,0],["فحط رحل السرى فيها وحي بما","يجري من العين دانيها وقاصيها",59,"ي",3,0],["فحُطّي كعصفورةٍ فوقَ كفّي","ويكفي جمالُكِ للعينِ قُرّةْ",60,"ر",2,0],["فَحَطَّمَتنِي شَظَايا فَانتَثَرتُ ؛ هُنا","حُطَامَ قَلبٍ ؛ كَأَنِّي - وَيحَها - خَزَفُ",61,"ف",1,0]]}