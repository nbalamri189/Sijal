{"poems":[[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72142","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103513","المديد"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103457","المديد"],[4755,"دُرَّةُ الطِّين","https://www.poetsgate.com/ViewPoem.aspx?id=183558",""]],"verses":[["وَكَجَوْفِ َضَرَّتِهِ التي في جَوْفِهِ","جَوْفُ السَّماءِ سِبَحْلَةٌ جَوْفَاءُ",0,"ا",2,0],["وكجدلِ الجذعِ قَصرَتُهُ","وكهضبٍ ضخمُ مُلتَزَمِه",1,"م",2,0],["وَكجِزعٍ حَولَهُ ذَهَبٌ","ما يُديرُ اللحظُ مِن بَصَرِه",2,"ر",2,0],["وكَجَنَّةِ المَأوَى لَهَا مُلَحٌ","ولها مَعَ الأَبوابِ أَسماءُ",3,"ا",2,0]]}