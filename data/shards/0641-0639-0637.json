https://poetry.dctabudhabi.ae/diwan/poem/133111","الوافر"],[4692,"تاج الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=213014",""],[4733,"النظرة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=210308",""],[463,"إذا عمّ صحراءَ الغميرِ جدوبها","https://www.poetsgate.com/ViewPoem.aspx?id=14624",""],[4578,"بحبك برهان الغرام مسلم","https://www.poetsgate.com/ViewPoem.aspx?id=49522",""],[5002,"ياسيّدي","https://www.poetsgate.com/ViewPoem.aspx?id=205193",""],[6037,"يا جنة الطرف نار القلب مأواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=186096",""],[6093,"بئرٌ معطلةٌ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176094",""],[6093,"وللنبت روح","https://www.poetsgate.com/ViewPoem.aspx?id=193067",""],[2220,"إذا النور من فارٍ أو من طُور سيناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11135&r=&rc=9",""]],"verses":[["فعَطْفاً علينا إنّ فينا لِماجِدٍ","يُراقِبُ أعْقابَ الأحاديثِ مَصْنَعا",0,"ع",2,0],["فعطاياهُ دانياتٌ يدَ الده","رتوالَى كأنَّها في نظام",1,"م",1,0],["فعطلوا وطوقوا","وأخروا وقدموا",2,"م",3,0],["فَعَطَفَت وَمالَت","وَاِستَضحَكَت فَقالَت",3,"ت",1,0],["فَعَطَفَت عَلى الصَغيرِ أُمُّه","وَأَقبَلَت مِن وَجدِها تَضُمُّه",4,"ه",1,0],["فعطفاً فقد أودى بيَ الضُّرُ واشتفَى","زمانيَ من وطءٍ يرُضُّ ويفضخُ",5,"خ",1,0],["فَعِطفُهُ داخِلٌ خَفيفٌ","وَرَدفُهُ خارِجٌ ثَقيلُ",6,"ل",1,0],["فَعَطَفتُ راحِلَتي وَقُلتُ لِصاحِبي","أُنظُر بِعَمرِكَ نَحوَها أَن تومِضا",7,"ض",2,0],["فعطايا الحياة أوسع من","آمال أبنائها وأسخى حنانا",8,"ن",2,0],["فعطاك جم لو يقال لحاتم","خذه لكانت نفسه تتهيب",9,"ب",1,0],["فعطفاً على فرد شقي بعيشه","فليس شقيا في الحياد كمثله",10,"ه",1,0],["فعطّلَ جيداً أتلعاً كان مُطْلعاً","سميّك منصوباً بصَفح طَلاكِ",11,"ك",1,0],["فعطفا عريب الحي عطفا لمغرم","ورفقا بمن اودى الغرام به رفقا",12,"ق",2,0],["فَعطَّرْن مِن طِيبِهنَّ النَّسيمْ","وأبدَيْن مِن لَوْعتي المستِكنّه",13,"ن",2,0],["فَعُطَّت عَلَيها برودُ الغَمامِ","وَعَينُ السَماءِ شَديدٌ بُكاها",14,"ا",3,0],["فعَطْفاً أدام اللهُ ظِلَّك وارِفاً","علينا فَنصْرُ الحُرِّ أنت به أَحرى",15,"ر",2,0],["فَعَطاؤُهُ يَأتي وَلَو لَم تَأتِهِ","لا بُدَّ مِنهُ سَأَلتَ أَو لَم تَسأَلِ",16,"ل",1,0],["فعطل أقوام وجسَّم فرقة","وفاز امرؤ ما حام حول مبانيه",17,"ي",2,0],["فعَطفاً على المألوفِ من بِرِّ عهدهِ","وإن هو في هذا المقام جفاكا",18,"ك",2,0],["فعطاءٌ وربُّه مشكورُ","وعطاءٌ وربُّه مأجورُ",19,"ر",1,0],["فعطَفَتْ كلَّ صليفٍ ناشزٍ","على الخِشاشِ وعلى لين المَسَدْ",20,"د",1,0],["فعطفاً عليها الآنَ تَصْفُ حِياضُها","وتُبْقِلْ مَراعيها وتُدْمَلْ نُدوبُها",21,"ب",3,0],["فعطْفَةً تنْعَشُ جَدَّ العُلى","مُقيلةً منْ وهْنَةِ العاثِرِ",22,"ر",1,0],["فعطفاً على حال الرّعايا ورحمة","ويسرا هدى الرّحمن عبداً ميسرا",23,"ر",2,0],["فعطفاً على جسمي النَّحيل فاه","يمتُّ إلى أجفان عينيك بالسُّقمِ",24,"م",1,0],["فَعَطفٌ عَلى المَكروهِ نَفساً فَإِنَّهُ","قَضاءٌ عَميمٌ مَقصِداتُ مُقاتِلُهُ",25,"ل",2,0],["فعطلاَ رسمه الشرعيَّ واأسفا","وأبطلاه ولا لومٌ ولا فندُ",26,"د",1,0],["فَعَطْفاً عَلى مَنْ تَناهَتْ بِهِ الْ","خَطايا وما عَطَفَتْ لانتِهاءِ",27,"ا",2,0],["فعطاؤك الرزق المقسم في الورى","والدهر أنت وسيفك المقدار",28,"ر",1,0],["فعطّرْ بها إلباس عرضك إنها","لطيمة حمدٍ نشرها بك يعبقُ",29,"ق",1,0],["فعطفا على عان بمصر مخلّف","له منذ عام لم يزل متضعفا",30,"ف",2,0],["فعطفُها عطفُها ومطلبُها","في القصدِ بالرّشق من مطالبها",31,"ب",3,0],["فعطفا بني الزهراء إني بحبكم","عقدت نياط القلب قبل التمائم",32,"م",1,0],["فعطفًا رسولَ الله إنَّ مصابنا","أليم لدى حظٍّ من الدهر تاعس",33,"س",1,0],["فَعَطفاً علَىَّ فَعضطفاً عَلَى","عُبَيدٍ مُسَيكِنُكُم فِى المَلاَ",34,"ل",2,0],["فعطفك مرجوّ به خفض عيشتي","ورفع محلّي حيث يستحسن الحال",35,"ل",1,0],["فعطر أعرافاً لها فتعطرتْ","أزاح بها عن روضه اليانعِ الداء",36,"ا",2,0],["فعطر الكون طيبا يوم مولده","والانس اضحى من الاكد ارفي كنف",37,"ف",1,0],["فَعَطَفت فَضلاً نحوَهُم وحَمَلتَهُم","مِثلَ انعِطَافِ الأُمِّ للأَبناءِ",38,"ا",2,0],["فَعَطَت فَتاةٌ بضَّةٌ رَعبُوبَةٌ","غَطَّت ذُيُولُ جُفُونِها وجناتِهَا",39,"ت",3,0],["فَعَطفاً عَلَيها يا ابنَ هاشِمٍ إنَّها","لَها قَدَمٌ بالحقِّ قامَت شُهُودُها",40,"د",3,0],["فعطفاً على عبد كسير جنابه","وجد بعلاج القلب فهو نفور",41,"ر",1,0],["فعطفا على مضني الغرام فقد وهى","وشف فأشفى أن يموت بوجده",42,"د",2,0],["فعطفاَ علينا يا شفاء قلوبنا","ويا غوث خلق الله من جملة الشرِّ",43,"ر",1,0],["فعطفا على من براه الهوى","فصار المسيكين مثل الغريق",44,"ق",1,0],["فعطر سماعي من عبير امتداحه","وقل مسمعي في الغير أن يسمع العبري",45,"ر",2,0],["فعطلت الأفلاك والأرض زلزلت","وأوحشت الدنيا وسكانها تبكي",46,"ك",2,0],["فَعطفه فاتن للسمر نسبته","وَطَرفه فاتك لِلباترات نَمي",47,"م",2,0],["فعطشنا وماء ملح شربنا","ورمونا بكل ما كان يرعب",48,"ب",1,0],["فعطشا كلاهما فصادفا","بئراً لماء وسط تلك البيد",49,"د",1,0],["فعطفاً على من أم مغناك راجياً","نداك وحقق فيك ما يترجاه",50,"ا",2,0],["فعطرت أنفاسكم وندّه","كلا البرايا مشرقا ومغربا",51,"ب",2,0],["فعطلت الأفلاك حين هويه","وكادت له شم الجبال تزول",52,"ل",1,0],["فعطفاً يا شريف البعد منكم","وما يبصره من أهل الغشامه",53,"م",2,0],["فعطاءُ ربِكَ غير محدودٍ على","أهلِ الصلاةِ بمدمعٍ مسفوح",54,"ح",1,0],["فعطفٌ من حبيبٍ قد يُداوي","ونَزْرٌ من وصالٍ قد يُفيدُ",55,"د",1,0],["فعطفاً عليها الآنَ تصفُ حياضها","وتقبلْ مراعيها وتدملْ ندوبها",56,"ب",3,0],["فعطفاً على من بات فيك معانيا","شجوناً بها أحشاؤه تتكلم",57,"م",1,0],["فعطاؤُها بسليقة ٍمن بارئٍ","أهَى لها التِّحْنان دونَ الجَفْوهْ",58,"و",2,0],["فعطفه يا مناه وارحميه فمن","يمته طرفك لا يحييه إلا كِ",59,"ك",1,0],["فعطاؤكم ماءٌ لبارقةٍ إذا","مسَّ البسيطةَ ماستِ الأغصانُ",60,"ن",1,0],["فعطرُ كريمِ النَّبتِ يأتي كنَبتِهِ","زكيًا له في النَّفسِ مَرْسًى ومُستقرْ",61,"ر",1,0],["فعطرَ أعرافاً لهاه فتعطرتْ","أزاحَ بها عنْ روضهِ اليانعِ الداءَ",62,"ا",2,0]]}