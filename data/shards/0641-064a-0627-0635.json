{"poems":[[53,"دعا بالوحاف السود من جانب الحمى","https://www.aldiwan.net/poem29645.html","الطويل"],[53,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[53,"ألا يا ليالي الخيف هل يرجع الهوى","https://www.aldiwan.net/poem30437.html","الطويل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[71,"أشاقك من عليا دمشق قصورها","https://www.aldiwan.net/poem4027.html","الطويل"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[88,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[27,"لنعم الفتى والخيل تنحط في القنا","https://www.aldiwan.net/poem5939.html","الطويل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[91,"سلام على السيد المجتبى","https://www.aldiwan.net/poem8758.html","عموديه"],[70,"أيا باكيا لزمان الصبا","https://www.aldiwan.net/poem42382.html","المتقارب"],[70,"وإني إذا ارتاب الوشاة لأدمعي","https://www.aldiwan.net/poem42729.html","الطويل"],[70,"تنصل مما جرى واعتذر","https://www.aldiwan.net/poem42880.html","المتقارب"],[70,"أتتك ولم تبعد على عاشق مصر","https://www.aldiwan.net/poem42920.html","الكامل"],[62,"هناك الكرى يا راقد الليل إنني","https://www.aldiwan.net/poem52261.html","الطويل"],[97,"سألتك يا صخرة الملتقى","https://www.aldiwan.net/poem24782.html","المتقارب"],[80,"ولما التقى الأجسام من غير ريبة","https://www.aldiwan.net/poem31416.html","الطويل"],[105,"أراك على المغيب فهل تراني","https://www.aldiwan.net/poem43403.html","الوافر"],[102,"تحية لك يا مصر الفراعين","https://www.aldiwan.net/poem33034.html","السريع"],[39,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[50,"لقد كاد ما أخفي من الوجد والهوى","https://www.aldiwan.net/poem62289.html","الخفيف"],[46,"لو شاء ربي لصاغني ملكا","https://www.aldiwan.net/poem22596.html","المنسرح"],[46,"شربت الراح بالراح","https://www.aldiwan.net/poem23110.html","الهزج"],[76,"حال عن العهد لما أحالا","https://www.aldiwan.net/poem39236.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42539","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54644","السريع"],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[133,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[151,"زمان بتطهير القلوب موكل","https://www.aldiwan.net/poem68523.html","الطويل"],[161,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[161,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[170,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[186,"قل للذي فارق الشبابا","https://www.aldiwan.net/poem14097.html","مخلع البسيط"],[230,"ولما تلقى الغيث حسن غنائنا","https://www.aldiwan.net/poem51096.html","الطويل"],[260,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[343,"في اصطخاب الحياة","https://www.aldiwan.net/poem55316.html","مجزوء الخفيف"],[354,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[354,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[365,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[365,"لي فرس صائم حكى فرس الشطرنج","https://www.aldiwan.net/poem60870.html","المنسرح"],[365,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[365,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[404,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[410,"أساكن قلبي والمهامه بيننا","https://www.aldiwan.net/poem32281.html","الطويل"],[433,"رأيت الفقيه أبا طالب","https://www.aldiwan.net/poem12576.html","المتقارب"],[433,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[438,"أمن منزل بالجق أقوت معالمه","https://www.aldiwan.net/poem2537.html","الطويل"],[440,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[465,"رويدك يا من تدعي شرف العلى","https://www.aldiwan.net/poem3407.html","عموديه"],[478,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[478,"ألا حي آثار الرسوم الدوائر","https://www.aldiwan.net/poem15243.html","الطويل"],[478,"عفا منزل قد كان للغيد مألفا","https://www.aldiwan.net/poem15244.html","الطويل"],[515,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[552,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[552,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"]],"verses":[["فَيا صاحِبَي رَحلي أَقِلّا فَإِنَّني","رَأَيتُ بِلَيلى غَيرَ ما تَرَيانِ",0,"ن",1,0],["في أُصَيحابٍ مَفارِشُهُم","ثَمَّ أَنقاءٌ وَكُثبانُ",1,"ن",1,0],["فَيا صاحِبي إِن تُعطِ صَبراً فَإِنَّني","نَزَعتُ يَديَّ اليَومَ مِن طاعَةِ الصَبرِ",2,"ر",1,0],["في أُصولِ الأَرطي وَيُبدي عُروقاً","ثَئِداتٍ مِثلَ الأَعِنَّةِ خورا",3,"ر",2,0],["فَيا صاحِبَ العيدَينِ لا زِلتَ سالِماً","يُهَنّيكَ بِالعيدَينِ شَرقٌ وَمَغرِبُ",4,"ب",1,0],["فَيا صاحِبي نَجوايَ بِاللَهِ خَبّرا","رَهينَ صَباباتٍ عَسيرٌ يَسيرُها",5,"ر",3,0],["فيا صاحبَيْ نجوايَ والحب غاية","فمن سابقٍ جلَّي مداه ومن وانِ",6,"ن",1,0],["فيا صدر الفتاة رحُبت صدراً","فأنت مقرّ أسنى العاطفات",7,"ت",1,0],["فَيا صِمَّ مَن لِلخَيلِ تَنحِطُ في القَنا","وَيا صِمَّ مَن لِلمُندِياتِ الطَوارِقِ",8,"ق",1,0],["فيا صائغ اللفظ صوغ الشنوف","زهت في حلا سوقه النافق",9,"ق",1,0],["فَيا صاحِبَ الشِيَمِ الباهِراتِ","وَيا مَن تُحِلُّ لَدَيهِ الحُبا",10,"ب",2,0],["فَياصاحِبي قَد وَجَدتَ المُعينَ","وَمَن ذاقَ ما ذُقتَ مِن حَسرَتَيك",11,"ك",1,0],["فَيا صاحِبي أَمّا عَلَيَّ فَلا تَخَف","فَما يَطمَعُ الواشونَ في عاشِقٍ مِثلي",12,"ل",2,0],["فَيا صاحِبي قَد سَمِعتَ الحَدي","ثَ وَقَد صارَ عِندَكَ مِنهُ خَبَر",13,"ر",1,0],["فَياصاحِبي هَب لي بِحَقِّكَ وَقفَةً","يَكونُ بِها عِندي لَكَ الحَمدُ وَالأَجرُ",14,"ر",1,0],["فيا صاحبَيْ سرّي وجهريَ أسعدا","فلمْ يبقَ منِّي غيرَ ما تَرياني",15,"ن",2,0],["فيا صخرةً جمعت مهجتين","أفاءا إلى حسنها المنتقى",16,"ق",2,0],["فيا صورة في نواحي السحاب","رأينا بها همَّنا المغرِقا",16,"ق",2,0],["فيا صُبْحُ لا تُقْبِلْ فإنّكَ مُوحِشٌ","ويا لَيلُ لا تُدبِر فإنّكَ مؤنِسُ",17,"س",1,0],["فَيا صُنعَ الجَبابِرَةِ اِستَعانوا","عَلَيكَ بِخَيرِ رِدءٍ مُستَعانِ",18,"ن",1,0],["في أَصدِقائي أُغَزّى إِن هُمُ هَلَكوا","وَفي الصداقات ما لي مَن يُعزيني",19,"ن",2,0],["فَياصُبحُ كَمِّش غُبَّرَ اللَيلِ مُصعِداً","بِبَمّ وَنَبِّه ذا العِفاءِ المُوَّشَّحِ",20,"ح",1,0],["فيا صالحاً في قِسْمَةِ الماءِ بينهم","ولا ناقَة في أَرْضِهِمْ لَكَ تُعْقَرُ",21,"ر",1,0],["فيا صَاحِ خَبِّرني الَّذي أَنتَ صانِعٌ","بِقاتِلَتي ظُلماً وَما طَلَبَت ذَحلا",22,"ل",2,0],["في أَصلِنا الزَيغُ وَالفَسادُ وَهَ","ذا اللَيلُ طَبعٌ لِجِنحِهِ الخَدَرُ",23,"ر",1,0],["فَيا صاحِ نَهى الصاح","يَّ جَهلٌ عَنكَ مُدّارَك",24,"ك",1,0],["فيا صاحِ هذا مَقامُ المحبِّ","ورَبعُ الحبيبِ فَحُطَّ الرِّحالا",25,"ل",2,0],["في أصيل للشمل فيه شتات","لدواع وللدموع تلاقي",26,"ق",2,0],["فَيَا صَاحِبِي مَهْلاً فَلَسْتَ بِوَاجِدٍ","سِوَى حَاضِرٍ يَبْكِي فَجِيعَةَ غَائِبِ",27,"ب",1,0],["فَيا صاحِبي هَلْ مِنْ فَكَاكٍ لِوَاقِعٍ","بِأَسْرِ الهَوَى أَوْ مِنْ نَجاةٍ لِهَائِبِ",28,"ب",1,0],["فَيَا صَاحِبَي نَجْوَايَ قُومَا لِشُرْبِهَا","فَفِي مِثْلِ هَذَا الْيَوْمِ طَابَتْ لَنَا الْخَمْرُ",29,"ر",1,0],["فَيَا صَفِيَّ اللهِ يَهْنِيكَ أَنْ","قَدْ فُزْتَ مِنْهُ بِاللِّقَاءِ القَرِيْبْ",30,"ب",1,0],["فيا صُفرةَ الموتِ إنَّ الوجوهَ","تَساوى بها صَلَفٌ أو خَفَر",31,"ر",1,0],["فَيَاصِلُ إِن يُمِّمِّهم عَوِيصٌ","عَزِيزٌ أتعَب الأَذهَانَ هَانَا",32,"ن",2,0],["فيا صاح أعدد للرحيل فإنه","يؤخر أقواما وقوماً يعجّل",33,"ل",1,0],["فيا صبري لهجرك ما أقلا","ويا وجدي لحبك ما أجلا",34,"ل",2,0],["فيا صروف زماني قد شددت يدي","بعروة منه وثقى ليس تنفصم",35,"م",1,0],["فَيا صَفقَةَ الخسرانِ فيما تَبَدَّلُوا","وَهَل يَتَساوى تِبرُها وَتُرابُها",36,"ب",3,0],["في أصلِ لون المشيب شك","كيف إذا زال واسْتَتابا",37,"ب",2,0],["فيا صاحبي حُثَّ المدامة واسقني","فإني أرى في الدهر بعد الدجى فجرا",38,"ر",2,0],["فيا صادقاً لاحت بصفحة وجهه","دلائلُ صدقٍ منذ قد كان في المهد",39,"د",1,0],["في اصطخاب الحياة","واعتكار الليال",40,"ل",1,1],["فَيا صاح يَمّم رحب ساحة فَضلِهِ","تَرَ اليُسر في يُسراه وَاليمن في اليمنى",41,"ن",2,0],["فَيا صاح اِطّرح حُبّ الغَواني","وَلَو كلّلن بِالدرر الغَوالي",42,"ل",2,0],["فيا صاحبيَّ اليومَ والدّهرُ رائعي","بأعجَبِ أبكارٍ طَرقْنُ وعُون",43,"ن",1,0],["في أصفهانٍ معي وعَرْصَتُها","ذاتُ اتّساعٍ مُقطِّعِ النّفَس",44,"س",1,0],["في أَصفهانَ أَتى والخُوزُ مَقْصدُه","والدَّهرُ ضاربُ أخماسٍ لأَسداس",45,"س",1,0],["فيا صَدْرُ بل يا بَحْرُ لا زلْتَ زاخراً","بِحارُ البرايا عندَه كالضّحاضِح",46,"ح",1,0],["فيا صَفِيَّ الدين مَنْ نظمُه","في رتبة تسمو على المشتري",47,"ر",2,0],["فيا صخرُ ما الخنساءُ مثلي ولا نَهَى","بَوادِرَ دَمعِي ما قَضاهُ لَبيدُ",48,"د",1,0],["فيا صاديَ الفقرِ رِدْ بحرَه","ودعْ للظِّباءِ بها قلْتَها",49,"ت",3,0],["فيا صِهْرَ النبيّ اسماً ورسماً","شرُفتَ به وشرّفَكَ النبيُ",50,"ي",1,0],["فيا صاحبي اليوم عوجا لتسألا","فريق الحمى أمن استقلّت عزائمه",51,"م",2,0],["فيا صَدْرُ هاتِ زفيرَ الضُّلوعِ","ويا عَيْنُ هاتي غَزيرَ الدُّموعِ",52,"ع",1,0],["فيا صاحبي رحلي والليل عابس","لعلَّ السرى نهجٌ إلى ضاحك الصبح",53,"ح",1,0],["فيا صاحِبَيْ شكوايَ أن تنأَ عَلْوَةٌ","فلا تحسبا أنّي مِنَ الوجدِ أسلمُ",54,"م",1,0],["فيا صاحبيَّ اليومَ عوجا لعلَّنا","نُجَدَّدُ أوقاتَ اللَّقاءِ بحاجرِ",55,"ر",1,0],["فيا صاحبيَّ اليومَ عوجا بربعِهِ","فقد كانَ بُردُ اللَّهوِ فيهِ مُفَوَّفا",56,"ف",2,0],["في أصفهانَ ديارِ العزّ منزلُه","ونفْسُهُ فوقَ هامِ النّجمِ مَسعاها",57,"ا",3,0],["فيا صِبغَةً حُمِّلتُها غيرَ راغبٍ","ويا صبغةً بُدِّلْتُها غيرَ سائمِ",58,"م",1,0],["فَيا صارِماً أَغمدته يدٌ","لَنا بَعدكَ الصارِمُ المُنتضى",59,"ا",1,0]]}