ttps://www.poetsgate.com/ViewPoem.aspx?id=160420",""],[4940,"على غصن الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=212481",""],[5031,"دموع أهلي من ياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=165141",""],[585,"هنا المحفل المشهود بالشعب يزخر","https://www.poetsgate.com/ViewPoem.aspx?id=161897",""],[5127,"بنتُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=177312",""],[5127,"أﻻ عللاني بطيفِ الحبيبْ","https://www.poetsgate.com/ViewPoem.aspx?id=177330",""],[5219,"نصيحتي","https://www.poetsgate.com/ViewPoem.aspx?id=194910",""],[5302,"عهد الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=201740",""],[5376,"أهيم وداريا بدمعٍ أرومها","https://www.poetsgate.com/ViewPoem.aspx?id=188409",""],[5431,"وحبي له نورٌ وعطرٌ ولا شكلُ!!","https://www.poetsgate.com/ViewPoem.aspx?id=195351",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5431,"أن يظلّوا كشعلة مستنيره...","https://www.poetsgate.com/ViewPoem.aspx?id=198462",""],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[5582,"تَوَلَّى الشَّبابُ وَقَدْ أَدْبَرا","https://www.poetsgate.com/ViewPoem.aspx?id=187104",""],[5596,"ردا على الشيخ صالح بن خلفان البراشدي","https://www.poetsgate.com/ViewPoem.aspx?id=206749",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5829,"لا نخجل","https://www.poetsgate.com/ViewPoem.aspx?id=211531",""],[5950,"أغاني الراحلين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128337",""],[5979,"منازل عزٍ لو يحل ابن مزنةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181358",""],[5997,"حوار شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214369",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""],[6069,"خير ما أصبحت مخلوع العذار","https://www.poetsgate.com/ViewPoem.aspx?id=105669",""],[6132,"أَقُول للخل عداك الردى","https://www.poetsgate.com/ViewPoem.aspx?id=194880",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""],[6152,"الصبح عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203737",""],[5309,"تجاوز عن الأسواء فالحرب علة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573595",""],[5309,"هي الأخلاق تنبت كالنبات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573769",""]],"verses":[["فَيا صاحِبَي رَحلي أَقِلّا فَإِنَّني","رَأَيتُ بِلَيلى غَيرَ ما تَرَيانِ",0,"ن",1,0],["في أُصَيحابٍ مَفارِشُهُم","ثَمَّ أَنقاءٌ وَكُثبانُ",1,"ن",1,0],["فَيا صاحِبي إِن تُعطِ صَبراً فَإِنَّني","نَزَعتُ يَديَّ اليَومَ مِن طاعَةِ الصَبرِ",2,"ر",1,0],["في أُصولِ الأَرطي وَيُبدي عُروقاً","ثَئِداتٍ مِثلَ الأَعِنَّةِ خورا",3,"ر",2,0],["فَيا صاحِبَ العيدَينِ لا زِلتَ سالِماً","يُهَنّيكَ بِالعيدَينِ شَرقٌ وَمَغرِبُ",4,"ب",1,0],["فَيا صاحِبي نَجوايَ بِاللَهِ خَبّرا","رَهينَ صَباباتٍ عَسيرٌ يَسيرُها",5,"ر",3,0],["فيا صاحبَيْ نجوايَ والحب غاية","فمن سابقٍ جلَّي مداه ومن وانِ",6,"ن",1,0],["فيا صدر الفتاة رحُبت صدراً","فأنت مقرّ أسنى العاطفات",7,"ت",1,0],["فَيا صِمَّ مَن لِلخَيلِ تَنحِطُ في القَنا","وَيا صِمَّ مَن لِلمُندِياتِ الطَوارِقِ",8,"ق",1,0],["فيا صائغ اللفظ صوغ الشنوف","زهت في حلا سوقه النافق",9,"ق",1,0],["فَيا صاحِبَ الشِيَمِ الباهِراتِ","وَيا مَن تُحِلُّ لَدَيهِ الحُبا",10,"ب",2,0],["فَياصاحِبي قَد وَجَدتَ المُعينَ","وَمَن ذاقَ ما ذُقتَ مِن حَسرَتَيك",11,"ك",1,0],["فَيا صاحِبي أَمّا عَلَيَّ فَلا تَخَف","فَما يَطمَعُ الواشونَ في عاشِقٍ مِثلي",12,"ل",2,0],["فَيا صاحِبي قَد سَمِعتَ الحَدي","ثَ وَقَد صارَ عِندَكَ مِنهُ خَبَر",13,"ر",1,0],["فَياصاحِبي هَب لي بِحَقِّكَ وَقفَةً","يَكونُ بِها عِندي لَكَ الحَمدُ وَالأَجرُ",14,"ر",1,0],["فيا صاحبَيْ سرّي وجهريَ أسعدا","فلمْ يبقَ منِّي غيرَ ما تَرياني",15,"ن",2,0],["فيا صخرةً جمعت مهجتين","أفاءا إلى حسنها المنتقى",16,"ق",2,0],["فيا صورة في نواحي السحاب","رأينا بها همَّنا المغرِقا",16,"ق",2,0],["فيا صُبْحُ لا تُقْبِلْ فإنّكَ مُوحِشٌ","ويا لَيلُ لا تُدبِر فإنّكَ مؤنِسُ",17,"س",1,0],["فَيا صُنعَ الجَبابِرَةِ اِستَعانوا","عَلَيكَ بِخَيرِ رِدءٍ مُستَعانِ",18,"ن",1,0],["في أَصدِقائي أُغَزّى إِن هُمُ هَلَكوا","وَفي الصداقات ما لي مَن يُعزيني",19,"ن",2,0],["فَياصُبحُ كَمِّش غُبَّرَ اللَيلِ مُصعِداً","بِبَمّ وَنَبِّه ذا العِفاءِ المُوَّشَّحِ",20,"ح",1,0],["فيا صالحاً في قِسْمَةِ الماءِ بينهم","ولا ناقَة في أَرْضِهِمْ لَكَ تُعْقَرُ",21,"ر",1,0],["فيا صَاحِ خَبِّرني الَّذي أَنتَ صانِعٌ","بِقاتِلَتي ظُلماً وَما طَلَبَت ذَحلا",22,"ل",2,0],["في أَصلِنا الزَيغُ وَالفَسادُ وَهَ","ذا اللَيلُ طَبعٌ لِجِنحِهِ الخَدَرُ",23,"ر",1,0],["فَيا صاحِ نَهى الصاح","يَّ جَهلٌ عَنكَ مُدّارَك",24,"ك",1,0],["فيا صاحِ هذا مَقامُ المحبِّ","ورَبعُ الحبيبِ فَحُطَّ الرِّحالا",25,"ل",2,0],["في أصيل للشمل فيه شتات","لدواع وللدموع تلاقي",26,"ق",2,0],["فَيَا صَاحِبِي مَهْلاً فَلَسْتَ بِوَاجِدٍ","سِوَى حَاضِرٍ يَبْكِي فَجِيعَةَ غَائِبِ",27,"ب",1,0],["فَيا صاحِبي هَلْ مِنْ فَكَاكٍ لِوَاقِعٍ","بِأَسْرِ الهَوَى أَوْ مِنْ نَجاةٍ لِهَائِبِ",28,"ب",1,0],["فَيَا صَاحِبَي نَجْوَايَ قُومَا لِشُرْبِهَا","فَفِي مِثْلِ هَذَا الْيَوْمِ طَابَتْ لَنَا الْخَمْرُ",29,"ر",1,0],["فَيَا صَفِيَّ اللهِ يَهْنِيكَ أَنْ","قَدْ فُزْتَ مِنْهُ بِاللِّقَاءِ القَرِيْبْ",30,"ب",1,0],["فيا صباحاه وهل من سامع","لصرختي وهل يجيب من دعا",31,"ا",1,0],["فيا صُفرةَ الموتِ إنَّ الوجوهَ","تَساوى بها صَلَفٌ أو خَفَر",32,"ر",1,0],["فيا صعقات الحزن كم تتعهدي","قلوباً عليها للغموم غمود",33,"د",1,0],["فَيَاصِلُ إِن يُمِّمِّهم عَوِيصٌ","عَزِيزٌ أتعَب الأَذهَانَ هَانَا",34,"ن",2,0],["فيا صاح أعدد للرحيل فإنه","يؤخر أقواما وقوماً يعجّل",35,"ل",1,0],["فيا صبري لهجرك ما أقلا","ويا وجدي لحبك ما أجلا",36,"ل",2,0],["فيا صروف زماني قد شددت يدي","بعروة منه وثقى ليس تنفصم",37,"م",1,0],["فَيا صَفقَةَ الخسرانِ فيما تَبَدَّلُوا","وَهَل يَتَساوى تِبرُها وَتُرابُها",38,"ب",3,0],["في أصلِ لون المشيب شك","كيف إذا زال واسْتَتابا",39,"ب",2,0],["فيا صاحبي حُثَّ المدامة واسقني","فإني أرى في الدهر بعد الدجى فجرا",40,"ر",2,0],["فيا صادقاً لاحت بصفحة وجهه","دلائلُ صدقٍ منذ قد كان في المهد",41,"د",1,0],["في اصطخاب الحياة","واعتكار الليال",42,"ل",1,1],["فَيا صاح يَمّم رحب ساحة فَضلِهِ","تَرَ اليُسر في يُسراه وَاليمن في اليمنى",43,"ن",2,0],["فَيا صاح اِطّرح حُبّ الغَواني","وَلَو كلّلن بِالدرر الغَوالي",44,"ل",2,0],["فيا صاحبيَّ اليومَ والدّهرُ رائعي","بأعجَبِ أبكارٍ طَرقْنُ وعُون",45,"ن",1,0],["في أصفهانٍ معي وعَرْصَتُها","ذاتُ اتّساعٍ مُقطِّعِ النّفَس",46,"س",1,0],["في أَصفهانَ أَتى والخُوزُ مَقْصدُه","والدَّهرُ ضاربُ أخماسٍ لأَسداس",47,"س",1,0],["فيا صَدْرُ بل يا بَحْرُ لا زلْتَ زاخراً","بِحارُ البرايا عندَه كالضّحاضِح",48,"ح",1,0],["فيا صَفِيَّ الدين مَنْ نظمُه","في رتبة تسمو على المشتري",49,"ر",2,0],["فيا صخرُ ما الخنساءُ مثلي ولا نَهَى","بَوادِرَ دَمعِي ما قَضاهُ لَبيدُ",50,"د",1,0],["فيا صاديَ الفقرِ رِدْ بحرَه","ودعْ للظِّباءِ بها قلْتَها",51,"ت",3,0],["فيا صِهْرَ النبيّ اسماً ورسماً","شرُفتَ به وشرّفَكَ النبيُ",52,"ي",1,0],["فيا صاحبي اليوم عوجا لتسألا","فريق الحمى أمن استقلّت عزائمه",53,"م",2,0],["فيا صَدْرُ هاتِ زفيرَ الضُّلوعِ","ويا عَيْنُ هاتي غَزيرَ الدُّموعِ",54,"ع",1,0],["فيا صاحبي رحلي والليل عابس","لعلَّ السرى نهجٌ إلى ضاحك الصبح",55,"ح",1,0],["فيا صاحِبَيْ شكوايَ أن تنأَ عَلْوَةٌ","فلا تحسبا أنّي مِنَ الوجدِ أسلمُ",56,"م",1,0],["فيا صاحبيَّ اليومَ عوجا لعلَّنا","نُجَدَّدُ أوقاتَ اللَّقاءِ بحاجرِ",57,"ر",1,0],["فيا صاحبيَّ اليومَ عوجا بربعِهِ","فقد كانَ بُردُ اللَّهوِ فيهِ مُفَوَّفا",58,"ف",2,0],["في أصفهانَ ديارِ العزّ منزلُه","ونفْسُهُ فوقَ هامِ النّجمِ مَسعاها",59,"ا",3,0],["فيا صِبغَةً حُمِّلتُها غيرَ راغبٍ","ويا صبغةً بُدِّلْتُها غيرَ سائمِ",60,"م",1,0],["فَيا صارِماً أَغمدته يدٌ","لَنا بَعدكَ الصارِمُ المُنتضى",61,"ا",1,0],["في اِصطِفاقٍ وَرَنَّةٍ","وَاِعتِراكِ المَواكِبِ",62,"ب",1,0],["فَياصِلُ حَقٍّ بِالبَيانِ وَتارَةً","فَياصِلٌ إِذ دارَ الأَصَمُّ المُكَعَّبُ",63,"ب",1,0],["فَيا صَوبَ الحَيا باكِرَ ثَراهُ","فَمِنهُ طالَما سَحَّ العَطاءُ",64,"ا",2,0],["فَيا صاحِبَني جَنبَ الطَّريقِ أَوَقفَةٌ","تَضُرُّكُما حَتّامَ لا تَقِفانِ",65,"ن",1,0],["فيا صديق إني","عجبت من أطواري",66,"ر",2,0],["فَيا صادق الوَعد الَّذي في يَمينه","يسارٌ عَلى طُول الزَمان لِطالب",67,"ب",1,0],["فَيا صادق الوَعد الَّذي في ذمامه","يَلين لِمَشمولٍ بِهِ كُلُّ جانب",68,"ب",1,0],["فيا صاحب المورد الفاسد","تنح عن المنهج الحائد",69,"د",1,1],["فيا صاحب النيل والواديين","ورب ينابيعه الجاريه",70,"ي",2,0],["فيا صادياً يشكو إلى السيف غلة","ستروى إذا ما سال منك نجيع",71,"ع",1,0],["فيا صبح جاهد كافراً طال واستعن","عليه بنور المصطفى تجد النصرا",72,"ر",2,0],["فَيَا صُبْحَ لَيْلِ الفَرْعِ فِي فَلَقِ الضحَى","وَيَا نُورَ صُبْحِ الفَرْقِ بَيْنَ الغَيَاهِبِ",73,"ب",1,0],["فيا صاحبي ما أنت والله ناصح","ويا عاذلي ما أنت والله عاذل",74,"ل",1,0],["فَيا صاحِبي رَحلي دَنا المَوتُ فَاِنزِلا","بِرابِيَةٍ إِنّي مُقيمٌ لَيالِيا",75,"ي",2,0],["فَيا صاحِبا إِمّا عَرضتَ فَبلغن","بَني مازِنٍ وَالرَّيبَ أَن لا تَلاقِيا",75,"ي",2,0],["فيا صاحِبَيْ حَضّي على الغَيِّ أَمْسِكاً","فَحَسْبيَ ما أَسْلَفْتُهُ وكَفاني",76,"ن",2,0],["فيا صاحبي ان ما تاخر مطلب","فحبسك حبر قانت ومنيب",77,"ب",1,0],["فيا صاحبي نجواي عوجا على الحمى","لعل به رقياً لما أعجز الراقي",78,"ق",2,0],["فياصلةَ الحُسنى ويا جَبلَ العُلى","ويا قَمر الدّنيا ويا سيّدّ الورى",79,"ر",2,0],["فياصاح مالي والبطالة بعدما","بدا في سواد العارضين نُصولُ",80,"ل",1,0],["فَيَا صَاحِبَيْ نَجْوَايَ مِنْ آلِ عَامِرٍ","أَلاَ نَادِمَانِي بِالغَرَامِ مَدَى عُمْرِي",81,"ر",2,0],["فَيا صاحِبي أَشكُوكَ مِن غُربَةِ النَوى","فَقَد أَمحلَت جِسمِي وَحَلَّت عُرى صَبرِي",82,"ر",2,0],["فيا صفوةَ اللهِ من هاشمِ","تخيَّرك اللهُ من آدمِ",83,"م",1,0],["فيا صرح عبرينٍ سلمتَ من الرّدى","وهل زال بيت والتّقى في بِنائه",84,"ا",3,0],["فيا صاح ان كنت تبغي الهدى","تمسك بحبل التقى خير زاد",85,"د",1,0],["فيا صبوتى زيدى ويا رشد خلنى","وسفه عذولى في الصبابة باحلمى",86,"م",2,0],["فيا صاحبي من مثلنا في مقامنا","ومن ذا الذي قد نال ما نحن نلناه",87,"ن",3,0],["فيا صاحبي هذي التي بي قد جرت","وهذا الذي في حجنا قد عملناه",87,"ن",3,0],["فيا صاحبي إن حانَ قبلَك مَصرَعِي","وكنتَ على عَهدِ الرِّضى والهوى مَعِي",88,"ي",1,0],["فيا صاحبي شاوي أريحا هنيهة","فقد ثار في الأكباد قدح زنادها",89,"د",3,0],["فيا صفوة الحسب العادليَّ وم","ن بثَّ عدلاً أنام الأناما",90,"م",2,0],["فَي