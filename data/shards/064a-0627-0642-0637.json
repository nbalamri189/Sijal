{"poems":[[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141957","الرجز"],[111,"هزت العالم أدوار البشر","https://www.poetsgate.com/ViewPoem.aspx?id=105",""],[92,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[119,"صياد تدارك بالمدد","https://www.aldiwan.net/poem41152.html","عموديه"],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[210,"فرح الزمان فضاء بالأنوار","https://www.aldiwan.net/poem919.html",""],[215,"يا قطار الزيتون أنت قطار","https://www.aldiwan.net/poem46239.html","الخفيف"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[422,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[563,"يا قطرة بحر أمره الفياض","https://www.aldiwan.net/poem34422.html","الدوبيت"],[591,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138290",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63738","السريع"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59635","المنسرح"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133766","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108974","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141286","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132252","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131324","الرجز"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105649","الكامل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124680","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87384","الكامل"],[3328,"","https://poetry.dctabudhabi.ae/diwan/poem/101867","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125922","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133276","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29297","السريع"],[4032,"","https://poetry.dctabudhabi.ae/diwan/poem/132038","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119674","السريع"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138821",""],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"],[4750,"الثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=180406",""],[5072,"يا قطتي","https://www.poetsgate.com/ViewPoem.aspx?id=51799",""],[5111,"قطارُ العشقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212340",""],[5461,"يا ساعة الفرحه","https://www.poetsgate.com/ViewPoem.aspx?id=5285",""],[5493,"مثلَ النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=208609",""],[5606,"يحسب إن الفوزياجي بالرشاوي","https://www.poetsgate.com/ViewPoem.aspx?id=198631",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5973,"الماس يصبح أغلي حين نفقده","https://www.poetsgate.com/ViewPoem.aspx?id=29237",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6102,"رِقَّةٌ وَحشِيَّة !!","https://www.poetsgate.com/ViewPoem.aspx?id=184163",""]],"verses":[["يا قطعةً من كبدى","فداك يومي وغَدى",0,"د",2,1],["يا قطين النيل ما حادثة","بات جفن الدين منها في سهر",1,"ر",1,0],["يا قَطرةً من نِطاف الفجر ساقطها","من \" أرز \" لبنانَ خفَّاقُ الظلالِ ندى",2,"د",2,0],["يا قطب الشام وسيده","يا غوث الامة يا سندي",3,"د",2,0],["يا قطيع اللسان مالك والشع","ر وصوغ الكلام جم العناء",4,"ا",2,0],["يا قطبنا المرجو عند عضيلةٍ","غوث لمن في أمره محتار",5,"ر",1,0],["يا قطار الزيتون أنت قطار","يتمشى إلى مكان غرامي",6,"م",2,1],["يا قطعة مِن فؤادي ان عتبت فَما","جَفاك والدك النائي وَلا هجرا",7,"ر",2,0],["يا قطبَ دائرة الرئاسة والعلى","أضحى يدور لأمره دوارها",8,"ر",3,0],["يا قطرةَ بحرِ أمرِه الفياضِ","قس حالك ذا على زمان ماضي",9,"ي",1,1],["يا قَطْرُ عُمَّ دِمَشْقَ وَاخْصُصْ مَنْزِلاً","في قاسِيُون وحَلِّهِ بِنَباتِ",10,"ت",1,0],["يا قطب صنعك ظاهر بين الملا","وكفى بانك للعفاة ظهير",11,"ر",1,0],["يا قُطُبَيْ آلِ الإمامِ الأولى","هُمْ فَلَكُ البادين والحضَّر",12,"ر",1,0],["يا قطعة القلب مذْ نأيت لقد","تركت قلبي للوْجد والفكر",13,"ر",1,0],["يا قطعة من خيال","الإله في الأحياء",14,"ا",2,0],["يا قطب دائرة المعارف لم يدم","للعلم بعدك كوكبٌ وضّاء",15,"ا",2,0],["يا قطار اللّيل سر وارق الصّعابا","وانهب الأرض سهولاً وهضابا",16,"ب",2,1],["يا قطار اللّيل أمست بيننا","صلةٌ تجعلنا اليوم صحابا",16,"ب",2,0],["يا قطار اللّيل حمصٌ هدفي","أقطع البيد إليها والشّعابا",16,"ب",2,0],["يا قطب يا خنذيذ يا صمصام يا","بحر البحور وقرّة الأبصار",17,"ر",1,0],["يا قُطب هذا العصر يا حَبْرَ الهُدى","يا مَرْكزَ العِرْفَانِ يا بَحْرَ النَّدى",18,"د",2,1],["يا قطر فيك من الرجال","هياكل مثل الجليد",19,"د",1,0],["يا قطرةً من مهجةٍ مجروحةٍ","مقتولةٍ تسعى لبيتِ القاتل",20,"ل",1,0],["يا قُطرَ دائِرةِ المَعارف وَالحِجى","وَمُحيطَ فَضلٍ فاض في إِمدادهِ",21,"د",2,0],["يا قطب دائرة العلوم بأسرها","يا مركز العليا وكل فخار",22,"ر",1,0],["يا قطرة قد أسكنت","في القلب عاصفة الهيام",23,"م",1,1],["يا قطب دائرة الأقطاب أنت لنا","سيف بأفئدة الأعداء مغمود",24,"د",1,0],["يا قَطرَةً مِن نَدى","رَفَت عَلى زَهرَه",25,"ر",2,1],["يا قطب دائرة الوجود بأسره","يا من لعلياه البرايا قد لجوا",26,"ج",3,0],["يا قطبَ هذا الكون غَوثاً فقد","بلغ سيلُ الهمِّ منا الزُّبى",27,"ا",1,1],["يا قطبَ دائرة الإيجاد خلفكَ لا","كان الوجود ولا في الكن إمكان",28,"ن",1,0],["يا قطني درَّ الحديث وذوبه","عقيق مذاب في الدماء من الدم",29,"م",1,0],["يا قطاة العبيّه يا هيام الذلول","يا عيون النداوي يا رقبة الغزال",30,"ل",1,0],["يا قطّتي زمن ُ التكاسُل ِ قد مضى","وأتى اخْتراعُك ِ لي وجودا ً آخرا",31,"ر",2,0],["يَا قِطارَ العْشْقِ مهْلاً","ركبُ أحْلامِيْ يُناديْكْ",32,"ك",1,1],["يا قِطَارَ الحُلمِ رِفْقًا","ذيْ تَبَارِيحيْ تُناجيكْ",32,"ك",1,0],["يا قطرة الغيمه على يابس البيد","رد الحياة لخافقي يا ذهابه",33,"ب",2,0],["يا قطعةَ الهمِّ الطويلِ تناثَري","إني سئمْتُ منَ الرجوعِ لأذكرَهْ",34,"ر",2,0],["ياقطر ياكم عليكم من بلاوي","ريحكم طلعت وباقي فيه ريحه",35,"ح",2,1],["يا قطعة من إهاب المجد يا أمداً","قد أنكرتْهُ معاليه على العلنِ",36,"ن",1,0],["يا قطعة َ السكَّر ِ الكوبي ِّ لا تقِفي","مثل َ الجماد ِ وخيل ُ العمر ِ تنطلِق ُ",37,"ق",1,0],["يا قَطَّعَ اللَّهُ أسَبَابَ النَّوَى وَرَمَى","حُجُبَ البِعَادِ بِما يُبلِيْ حَوَاشِيْهَا",38,"ي",3,0],["يا قِطَّتِي؛ كَيفَ انسَلَلتِ إِلَى","حِضنِي؟ تَهُزِّينَ الهَوَى بِخُطى!",39,"ط",2,0],["يا قِطَّتِي؛ ما زِلتُ مُندَهِشًا","كَيفَ الغَرامُ عَلَى الفُؤادِ سَطا؟",39,"ط",2,0],["يا قِطَّتِي؛ ما زِلتُ أَسأَلُنِي:","(أَأَنا أَنا؟ مَن يَعشَقُ القِطَطا؟)",39,"ط",2,0]]}