id=188073",""],[5970,"كيف تشكو وفؤادي ما شكا","https://www.poetsgate.com/ViewPoem.aspx?id=130650",""],[6075,"طَيْفُ الْغَرَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=192917",""],[6089,"صاحبُها الوحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213749",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[6124,"شقراء مرت","https://www.poetsgate.com/ViewPoem.aspx?id=174657",""],[6124,"عرش الملوك","https://www.poetsgate.com/ViewPoem.aspx?id=174820",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""],[5190,"القنديل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78313&r=&rc=26",""],[5567,"وكن روحي لتفنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69067&r=&rc=6",""]],"verses":[["فَارْفَضَّ شَمْلُ الكَرى وَالطَّلُ يُخْضِلُنا","سَقيطُهُ وَثُغُورُ الصُّبْحِ تَبْتَسِمُ",0,"م",1,0],["فارْفَضَّ شَملُ الأُنْسِ إذ جمَعَ البِلى","بِزَرودَ بينَ مَعاهِدٍ وعُهودِ",1,"د",1,0],["فارْفَضَّ شملُهُمُ وكمْ مِنْ مَوْرِدٍ","للظّالِمينَ وليْسَ عنهُ مَصْدَرُ",2,"ر",1,0],["فارْفَعْ شِعارَ الحَقِّ في علَمِ الهُدى","حتّى يَقِرَّ على النّجومِ قَرارُهُ",3,"ر",2,0],["فَاِرفَعوا هَذِهِ الكَمائِمِ عَنّا","وَدَعونا نَشُمُّ ريحَ الشَمالِ",4,"ل",1,0],["فارفعْ لواء الفخر غيْرَ مدافعٍ","واسحب ذيول العسكر الجرارِ",5,"ر",1,0],["فارفع لواء الفخْر غير مُدافع","واسحَبْ ذيولَ العّزةِ القعساءِ",6,"ا",2,0],["فارفِ ما خرَّقتْ يداك بثوبٍ","ليِّنٍ مَسُّهُ نقيُّ البياضِ",7,"ض",1,0],["فارفضَّ ينهلُّ بغير ضبط","كأنه جُرحٌ عظيمُ البَطّ",8,"ط",1,0],["فارفُقْ بأسّ بناءٍ أنت ذِروتُهُ","فقد غدوتَ وما نالوهُ زِلزالا",9,"ل",2,0],["فَاِرفَع لِنَفسِكَ بَعدَ مَوتِكَ ذِكرَها","فَالذِكرُ لِلإِنسانِ عُمرٌ ثاني",10,"ن",2,0],["فَاِرفَعِ الصَوتَ إِنَّها هِيَ مِصرٌ","وَاِرفَعِ الصَوتَ إِنَّها الأَهرامُ",11,"م",1,0],["فارفِقْ بهم واستَبْقِ بعضَ ثنائِهمْ","كرماً فقد دانُوا بأنك أكرمُ",12,"م",1,0],["فَاِرفُض بِإِجمالٍ أُخُوَّةَ مَن","يَقلى المُقِلَّ وَيَعشَقُ المُثري",13,"ر",2,0],["فَارفَع بِدارِ الضَربِ باقي ذِكرِها","إِنَّ الرَفيعَ مَحَلَّةً مَن تَرفَعُ",14,"ع",1,0],["فَاِرفَعِ الصَومَ بِشُربٍ","وَاِمزُجِ الخَمرَ بِنَومِ",15,"م",1,0],["فَاِرفُضي العاذِلينَ وَاِقنَي حَياءً","لا يَكونوا عَلَيكِ حَظَّ مِثالي",16,"ل",2,0],["فارْفَعْ بكَفّي فإنّي طائشٌ قدَمي","وامْدُدْ بضَبْعي فإني ضَيّقٌ باعي",17,"ع",2,0],["فَارْفَعِ الصَّوْتَ وَأَيْقِظْهُمْ فَقَدْ","طَالَ عَهْداً بِهِمُ هَذَا السُّبَاتُ",18,"ت",1,0],["فارفق بعبد رق","يمتُّ بالغرام",19,"م",1,0],["فأرفق الحسن رفقا","هذا الوجود ظلال",20,"ل",1,0],["فَاِرفَضَّ مِن عَينَيَّ دَمعٌ ذارِفٌ","مِثلُ الجُمانِ مُفَرَّقٌ بِبِدادِ",21,"د",1,0],["فَأَرفَعَ صَوتي بِالسَلامِ مُرَدّدا اسلامٌ","كَعَرفِ الرَوضِ أَخضَلَهُ النَدى",22,"د",2,0],["فَاِرفضّ مِن فَرطِ خَجلَةٍ عَرَقاً","فَصارَ خَدّي بَديلَ مِنشَفَتِه",23,"ه",1,0],["فارفع لمعتمد الحكومة","خالص الشكر الوفير",24,"ر",1,0],["فارفعِ الأرضَ فوقَ كفيكَ وأْمر","يملأُ الأرضَ بعدَ ذاكَ السلامُ",25,"م",1,0],["فارفقي يا خطوب واتئدي","رحمة بالورى أو اشتدي",26,"د",2,0],["فَأَرفَعُ نَفسي عالِياً بَعد خَفضَةٍ","وَتُظهِرُ أَسمى في السُهولِ مَفاخِري",27,"ر",2,0],["فَاِرفَع إِذا عُرِضَت عَليكَ قَصائِدي","مَدحي إِلى المَلِكِ الرَحيمِ العادِلِ",28,"ل",1,0],["فارفَع جبينكَ باسماً وانظر إِلى","مَوجِ البحارِ وأَنجُمِ الزَّرقاء",29,"ا",2,0],["فارفق بمصر العارفين بقدرهم","وفخارهم وجدودهم أهل الرفا",30,"ف",2,0],["فَاِرفُل بِثَوبِ سِعادَةٍ خاطَت لَهُ","أَيدي عَلاكَ مَلابِسَ المَجدِ السَميكِ",31,"ك",1,0],["فارفعي السترَ فقد أوم","ن من بعد جحود",32,"د",1,0],["فارفقي بي وجنّبي","خلوتي كأسك الحزين",33,"ن",1,0],["فَاِرفق قَليلاً سَيدي","بِقَلبيَ المنفَطر",34,"ر",1,0],["فارفع بها كفيك في الأسحار أو","عقب الصلاة وعند نشر المصحف",35,"ف",1,0],["فارفعْ لواءً بالنجاحِ عَقدْتَهُ","بالنَّصرِ فِي سُبُلِ الهُدى مَوْسُوما",36,"م",2,0],["فارفق بنفسك إِن نفسك حرة","والحر من ذات الاله يهاب",37,"ب",1,0],["فأرفعهُ بالفعِل لو كان فاعلاً","وقد خَفَضَتْهُ من نقيصتِهِ رُبُّ",38,"ب",1,0],["فارفق بِنَفسك يا مُحاوِل غايتي","فَالمَهرُ مَهرٌ والحِمارُ حِمارُ",39,"ر",1,0],["فارفع البردة من نفسك عن","وجهن