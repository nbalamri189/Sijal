َ يا جفونَ ويكفي","ما بقلبي من صائبات السهامِ",68,"م",1,0],["فارفق به وأنِلهُ","مولاي ما يتمنّى",69,"ن",2,0],["فأرفع لواء المجد وانصر أمةً","كانت شموسا للهدى ومهودا",70,"د",2,0],["فارفع مباني ملكه وادفع به","كيد العدا وأنله ما هو آمل",71,"ل",1,0],["فَارْفُضْ قُرَيْشاً كلَّها","من أجلِ ذا الداءِ العُضال",72,"ل",1,0],["فَاِرفُضوا صُلحَهُم بِكُلِّ إِباءٍ","إِنَّهُم يُحسِنونَ لعبَ القُرودِ",73,"د",1,0],["فارفق به ولا تسل","عن قلبه المضيع",74,"ع",1,0],["فارفَع ضعيفكَ لا يَحُل بك ضعفهُ","يوماً فتُدركَه العواقبُ قد نَما",75,"ا",1,0],["فارْفَع لَهَا عَلَمَ الهُدى فَلِمِثْلِها","رَفَعتكَ أعلامُ السِّيادَةِ فِي الذرى",76,"ر",2,0],["فَاِرفَعوا فَوقَ الرُبى أَعلامَها","ثُمَّ حَيّوا خَفَقاتِ العَلَمِ",77,"م",1,0],["فارفعي الصوت بالغناء قليلاً","بدل النّوح يا طيور الأماني",78,"ن",2,0],["فارفق لرقٍّ عاشقٍ","متعلق برقيق بردك",79,"ك",1,0],["فارفعْ إلهي ظلماً أحاط به","أو أعم عيني كيلا ترى الظّلما",80,"م",2,0],["فارفق بقلبك ان نزعت صديقه","فلكم صديقٍ في الحشا كالدُّمَّل",81,"ل",1,0],["فارفق عليه فانه","قد تاب مما يكتب",82,"ب",1,0],["فأرفده عفواً يملك النفس عنده","إذا صار من رق انتقامك معتقا",83,"ق",2,0],["فارفق بصدرك واخلع عن حليته","يكفيك ما فيه من سقم ومن علل",84,"ل",1,0],["فارفع ازارا لنصف الساق مقتديا","فما تزده على الكعبين يضطرم",85,"م",1,0],["فاِرفعوها إنّ في رفعتها","كلّ ما نرجوه من هذا الجِهاد",86,"د",1,0],["فارفق بأمة مصطفاك محمد","واجعل إلى كنف السلام مآلها",87,"ل",3,0],["فارفُق عَلَى القَومِ الَّذِينَ تُرِيدُهُم","فهُمُ السَّوامُ وأنتَ فِيهِم ضَيعَمُ",88,"م",1,0],["فارفق ولو متملقا","يجبى لحضرتك الخراج",89,"ج",1,0],["فأرفعُ صدرٍ خارجٌ دون حسنها","وأدنى مكانٍ داخلٌ منتهى الصدر",90,"ر",1,0],["فَارفَع بِضَمِّ وانصِبَن فَتحاً وَجُر","كَسراً كذِكرِ اللهِ عَبدَهُ يَسُر",91,"ر",1,0],["فارفَع بها وَانصِب وَجُرَّ مَعَ أل","ودُونَ أل مَصحُوبَ أل وَمَا اتصَل",91,"ل",1,0],["فارفِض بها وتعَرَّ من أثوابِها","إن كان عندكَ للقضاءِ يقينُ",92,"ن",1,0],["فارفق لدى التغسيل بالجسد الذي","لو لامسته يد أضر حلولها",93,"ل",3,0],["فارفق أخيّ بنفس مثلك إنها","هيَ غاية الدُنيا وَأَين المَهرب",94,"ب",