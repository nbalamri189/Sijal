{"poems":[[90,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[82,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[89,"وذي حدب يلتج بالسفن كلما","https://www.aldiwan.net/poem8366.html","الطويل"],[19,"خُذلت على ليلة ساهره","https://www.aldiwan.net/poem338.html",""],[303,"لا هم دمعي من طول البكا نفدا","https://www.aldiwan.net/poem36823.html","عموديه"],[469,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[578,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96024","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67885","الرجز"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103431","الطويل"],[3666,"","https://poetry.dctabudhabi.ae/diwan/poem/29385","السريع"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99228","السريع"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21523","الطويل"]],"verses":[["كان إطروفة الزمان ظريفاً","طربِاً شادياً رقيقاً سديدا",0,"د",2,0],["كأنّ أطرافَ الظُّبَى بينَهُمْ","تفلقُ فوقَ الهامِ بيضَ الأداح",1,"ح",1,0],["كَأَنَّ اطِّرَادَ الْمَوْجِ فَوْقَ سَرَاتِهِ","نَعَائِمُ فِي عَرْضِ السَّمَاوَةِ جُفَّلُ",2,"ل",1,0],["كَأَنَّ أَطاوِلَ شَوكِ السِيالِ","تَشُكُّ بِها مَضجَعي شاجِرَه",3,"ر",2,0],["كأنَّ إطراقَهم في طولِ صمتِهمُ","كمن يراجعُ معنىً رائعاً شردا",4,"د",2,0],["كأن اطراد النهر سيف مجرد","وأفياؤها من جانبيه حمائل",5,"ل",1,0],["كَأَنَّ اِطِّلاعَ الشُهبِ بَينَ مَحاجِري","فَمِن ناظِري تَبدو وَفيهِ تَغيبُ",6,"ب",1,0],["كان اطاريف الاسنة تكتسي","دماً طرف صب احمر الدمع صيب",7,"ب",1,0],["كأنَّ أطرافَ المُدى","تجرحُ أعلى كَبِدِه",8,"د",2,0],["كأنَّ أطاريف الخضابِ بكفِّها","فصوص عقيقٍ فوق قضبِ زبرجدِ",9,"د",1,1],["كأن أطرافَ ولياتها","في شمألٍ حصا زعزاع",10,"ع",1,0],["كَأَنَّ أَطفالَ خيطانِ النَعامِ بِهِ","بَهمٌ مُخالِطُهُ الحَفّانُ وَالحولُ",11,"ل",1,0],["كأنَّ أَطرافَ بروقٍ هَفَتْ","راياتُ صُفْرٌ ومواضٍ صِفاحْ",12,"ح",1,0],["كأَنَّ اطِّرادَ الماءِ في جَنباتِها","تتَّبعُ ماءُ الدُرّ في سُبُكِ الذَهَب",13,"ب",1,0]]}