{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39668","البسيط"],[182,"ضاقت","https://www.aldiwan.net/poem50705.html","الكامل"],[254,"هل لعيش إذا مضى لزوال","https://www.aldiwan.net/poem2098.html","الخفيف"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122352","الكامل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20595","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138013",""],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145141","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130531","الكامل"],[4684,"أفرخ الزغلول","https://www.poetsgate.com/ViewPoem.aspx?id=202387",""],[4768,"المُستثنى بحبّها","https://www.poetsgate.com/ViewPoem.aspx?id=215532",""],[4859,"ظلال الأمنيات!","https://www.poetsgate.com/ViewPoem.aspx?id=206935",""],[6093,"يوماً وقفتُ بسَفْحِ الرِّيمِ مُخْتار (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""]],"verses":[["والمفتدون شُراةُ الخلد قل لهم","ما ينظم المدح ألحاناً وأشعارا",0,"ر",2,0],["والمُفْسِدونَ كَما الأفاعي قد دَنوا","مِنْ نابِهِمْ سُماً زُعافاً أخْرَجوا",1,"ج",3,0],["وَالمُفيدُ المالَ التِلادَ لِمَن يَع","فوهُ وَالواهِبُ الحِسانَ الغَوالي",2,"ل",2,0],["والمفصل السيف وهو من فَ","صَل العظم إذا قده على عجل",3,"ل",1,0],["والمفرغ السحر الحلال قوافيا","تزدان منه الغادة العطبول",4,"ل",1,0],["وَالمُفضِلونَ إِذا الرياحُ تَناوَحَت","وَالقائِلونَ هَلُمَّ لِلأَضيافِ",5,"ف",1,0],["وَالمُفرَدَاتُ بِغَيرِ تَركِيبٍ كَمِث","لِ الصَّوتِ تَنعَقُهُ بِتِلكَ الضَّانِ",6,"ن",1,0],["والمفاتيح بيدك من عصى طاع مغلوب","قم وقابل وخل الشور بالصدق معصوب",7,"ب",1,0],["والمفسدون تأمروا","ما فيهم أحد يشاك",8,"ك",1,0],["وَالمُفرَدُ الجَامِدُ فَارِغٌ وَإن","يُشتَقَّ فهو ذُو ضمِيرٍ مُستَكِن",9,"ن",1,0],["وَالمُفرَدَ المَنكُورَ وَالمُضَافَا","وَشِبهُهُ انصِب عَادِماً خِلاَفاً",9,"ف",2,0],["والمفضلين اذا المحول ترادفت","والقائلين هلمّ للاضياف",10,"ف",1,0],["والمفردات إزارها متهدّلٌ","العرض منسدحٌ كذا والطولُ",11,"ل",1,0],["والمفرداتُ سبايا قيدَ ذاكرتي","والوحيُ أنجبَ نصّاً خارج المعنى",12,"ن",2,0],["والمفرداتُ تساقطت من أضلعي","جمراً وينفخ في لظاه حنينُ",13,"ن",1,0],["والمُفرغونَ لنيلِ العزِّ أنْفُسَهُمْ","والمالئُونَ نفوسَ الخَلقِ إِكبارَا",14,"ر",2,0]]}