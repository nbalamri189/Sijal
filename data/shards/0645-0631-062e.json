{"poems":[[63,"كشف الصباح قناعه فتألقا","https://www.aldiwan.net/poem51525.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43847","البسيط"],[215,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[592,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49933","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100240","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40143","الكامل"],[4753,"عاشق السوسن","https://www.poetsgate.com/ViewPoem.aspx?id=108350",""],[5055,"صفوف الظل","https://www.poetsgate.com/ViewPoem.aspx?id=101655",""],[5061,"صدى الصوت","https://www.poetsgate.com/ViewPoem.aspx?id=147426",""],[5339,"نشيد الخمسين","https://www.poetsgate.com/ViewPoem.aspx?id=49008",""],[6056,"خصلتين ٍ فوق خدّه","https://www.poetsgate.com/ViewPoem.aspx?id=130327",""]],"verses":[["مُرْخٍ فُضولَ التَّاجِ في لَبَّاتِه","ومُشَمِّرٌ وَشْياً عليه مُنَمَّقا",0,"ق",2,0],["مُرْخِياً عُذْراً طِوَالاً كَرُمَتْ","عِنْدَ مَنْ لا يُرْسِلُونَ الْعُذْرَ عُذْرَا",1,"ر",2,0],["مَرَّ خَيالاً عَلَيَّ لَيلاً","فَبَدَّلَ السُهدَ بِالمَنامِ",2,"م",1,0],["مرخّم الصوت مبحوح لوافظهُ","في مسمع العاشق المشتاق ألحان",3,"ن",1,0],["مُرْخىً له ستائرُ أعوادُه","الخُضْرُ الذُّرا لِظلّهنَّ يَرتَدي",4,"د",2,0],["مرخص خضب ناعم فكأنه","من اللين هداب الدمقس المهذب",5,"ب",1,0],["مُرْخَي العذارين مأواه ومَسرَحهُ","بينَ العَذارى وربّاتِ الحوانيتِ",6,"ت",1,0],["مرخيات الجمود فوق متون","كل جعد يخال أرقم نفث",7,"ث",1,0],["مُرْخَى الذَّوائِبِ كَالعَروسِ يزينُهُ","طرْفٌ بِأَطرافِ الرّماحِ كَحيلُ",8,"ل",1,0],["مرخيا من فاحم الشعر الذي","جن مسدولا بعطف وانحنى",9,"ن",2,0],["مرخي ومروي للخَذَا والقنا ضَرْب","أغمَمْ وقص الناصية من سماعة",10,"ع",2,0],["مرخص لك بداخل عروقه وحاميك","ويدعي لك الله وين مارحت ياقاك",11,"ك",1,0],["مرّ خمسون ربيعاً كالخريف ِ","مرّ إخفاقٌ فلاحقت النجاحا",12,"ح",2,0],["مرخي ٍله خصلتين ٍٍ فوق خدّه","ماشي ٍ يلعب بهن والقلب ذايب",13,"ب",1,0]]}