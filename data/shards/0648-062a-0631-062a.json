{"poems":[[65,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[73,"ألا ليت شعري هل تبيت مغذة","https://www.aldiwan.net/poem3995.html","الطويل"],[75,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[95,"سلام عليكم والفواد المسلم","https://www.aldiwan.net/poem11363.html","الطويل"],[74,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[66,"قلوب العاشقين لها عيون","https://www.aldiwan.net/poem67541.html","الوافر"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[53,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[87,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[87,"لقد لبى زعيمكم النداء","https://www.aldiwan.net/poem62929.html","الوافر"],[87,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[45,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[47,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[47,"رأيت البحبحاني استقلت","https://www.aldiwan.net/poem66636.html","البسيط"],[52,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[48,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[119,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[136,"طربت لحضرة الشيخ الخديم","https://www.aldiwan.net/poem54741.html","الوافر"],[189,"أروض جاءني لك أم كتاب","https://www.aldiwan.net/poem14123.html","الوافر"],[240,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[463,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[469,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[543,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[563,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107235","الوافر"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107276","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88627","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145891","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59674","المتقارب"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56184","الوافر"],[1340,"","https://poetry.dctabudhabi.ae/diwan/poem/105885","الطويل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18455","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49958","المنسرح"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128706","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52090","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71076","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48261","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77343","الطويل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124679","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100292","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133975","البسيط"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35854","الطويل"],[3347,"","https://poetry.dctabudhabi.ae/diwan/poem/142289","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48295","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138542",""],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144496","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131951","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90013","الطويل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32676","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135619","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35571","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69993","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75680","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101349","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97096","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81940","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83655","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58042","الطويل"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4755,"مساء الخير يا وطنا يئن","https://www.poetsgate.com/ViewPoem.aspx?id=183638",""],[4755,"صنعاء والدولار","https://www.poetsgate.com/ViewPoem.aspx?id=200384",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4862,"صوت السنانير","https://www.poetsgate.com/ViewPoem.aspx?id=55619",""],[4888,"معراج عشقي .. (في حب الرسول)","https://www.poetsgate.com/ViewPoem.aspx?id=207773",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5185,"المهزوم","https://www.poetsgate.com/ViewPoem.aspx?id=70820",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[5277,"عصفورةُ الشّجن","https://www.poetsgate.com/ViewPoem.aspx?id=214550",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5667,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=214940",""],[5720,"بنورِ العلم","https://www.poetsgate.com/ViewPoem.aspx?id=200302",""],[5720,"لَذَّة الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=209147",""],[5736,"امتثال","https://www.poetsgate.com/ViewPoem.aspx?id=213791",""],[5751,"العامليّة","https://www.poetsgate.com/ViewPoem.aspx?id=214762",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5751,"مرسوم كوني بنرجسية شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214785",""],[959,"وترتاح عطفاها فأحسب أنها","https://www.poetsgate.com/ViewPoem.aspx?id=133738",""],[5781,"كثيرٌ من الحب في كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=202830",""],[5818,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=193071",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[5956,"ما منعوا الجروح تصيب غزةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202514",""],[6026,"مساحة للأرق","https://www.poetsgate.com/ViewPoem.aspx?id=214647",""]],"verses":[["وَتَرتاحُ لِلواشي بأُذنٍ سَمِيعَةٍ","تَلَقَّفُ مِنهُ ما يُنيرُ وَما يُسدي",0,"د",2,0],["وَتَرتَعُ مِن رَوضِ الحِمى في مَراتِعٍ","أَرَيت بِها الفَرغَينِ في مُطفيءِ الجَمرِ",1,"ر",1,0],["وَتَرَتني خُطوبُهُ في صَفِيٍّ","فاضِلٍ نابِهٍ مِنَ الدَهرِ وِترِ",2,"ر",1,0],["وَتَرْتَاحُ دُونَ الصِّدْقِ وَالصِّدْقُ مُتْعِبٌ","إِلَى الإِفْكِ عَمَّا لا نُكِنُّ يُتَرْجَمُ",3,"م",1,0],["وترتقبُ العصاةُ ندَى شفيعٍ","مجابٍ قبل ما وقع النداء",4,"ا",2,0],["وَتَرتَعُ في رِياضِ القُدسِ طَوراً","وَتَشرَبُ مِن بِحارِ العارِفينا",5,"ن",2,0],["وُتِرتُ بوتر فيك لا أستقيده","ولو أنني استنجدت بالصبر والنصر",6,"ر",1,0],["وترْتُهُ في عجوزٍ","جعلتها غِمْدَ بعضِي",7,"ض",2,0],["وتر تعلق في النعيم بآدم","غنى عليه بنوه والأصهار",8,"ر",1,0],["وَتَرتَقِبونَ مَطلَعَهُ صِغاراً","وَتَستَبِقونَ غُرَّتَهُ نِساءَ",9,"ا",2,0],["وَتَرتَجُّ مِنها لُجَّةٌ وَمَدينَةٌ","وَتَصلى نَواحٍ حَرَّها وَجِهاتُ",10,"ت",1,0],["وَتَرتَعُ دونَ نَبتِ الأَرضِ فينا","فَما فارَقتُها إِلّا جَديبا",11,"ب",2,0],["وَتَرتُ الهَوى إِلّا لَجاجَ مُعَذِّلٍ","وَمُعطي الهَوى إِلّا طُروقَ خَيالِ",12,"ل",1,0],["وَتَرتَ القَومَ ثُمَّ ظَنَنتَ فيهِم","ظُنوناً لَستَ فيها بِالحَكيمِ",13,"م",1,0],["وَتَرتَعِدُ النُقادَ أَوِ البَكاعا","مُسارَقَةً وَتَرضى بِالصَغارِ",14,"ر",1,0],["وَتَرتَعُ ما بَينَ النَبيئَينِ ناعِماً","بِعَيشَةِ خُلدٍ لَم تَنَلها السَمائِمُ",15,"م",1,0],["وترتدّ حتى الشهبُ عن سَبَحاتها","فلا ثَمَّ آفاقٌ ولا ثَمَّ أنجمُ",16,"م",1,0],["وترت صَغيرَ السِنِّ مُستَعظمَ السّنا","جَنِيَّ المحيّا قلب القَلب جَهبَذا",17,"ذ",2,0],["وَتَرَتنيهِ شَعوبُ وَما","لِغَوِيٍّ عِندَها قَوَدُ",18,"د",1,0],["وُترت قلوبُ العالمي","ن ضَعِيفُها والأليَس",19,"س",1,0],["وَتَرْتَجِي الغِيدُ لَوْ كَانَتْ لآلِئُهَا","نَظْماً مِنَ الشِّعْرِ أَوْ نَثْراً مِنَ الْخُطَبِ",20,"ب",1,0],["وترتجى اليوم وبل في غد","منه يدا اذ يرهب المشهد",21,"د",1,0],["وتَرتِيلِ الكِتَابِ عَلَى إتئَادٍ","بإِمعَانِ التَّفَهُّمِ مِن فَهِيمِ",22,"م",1,0],["وتَرْتشِف المَسامعُ منه لفظا","شَهِيًّا مثلَ ما رُشِف الرُّضاب",23,"ب",1,0],["وَتَرَتهُ نُوَبٌ لا","يُرتَجى مِنها اِنتِصارُه",24,"ر",2,0],["وَتَرتَني في مُقلَةٍ قَلَّما","أَعلَمُها نامَت عَلى وَتَرِ",25,"ر",1,0],["وتَرتُقُ ما فَتقته الرجالُ","ولا يرتُقون كما ترتُقُ",26,"ق",1,0],["وترتع في تلك الوجود لحاظنا","فهن رياض والثغور مناهل",27,"ل",1,0],["وترتَاحُ نفسِي إن أكُن قد عرَفتُه","وإلاَّ فإِني في التِفَاتٍ وفي سُؤلٍ",28,"ل",1,0],["وترتيبها في العلم يظهر هكذا","لدينا فمولود وأم ووالد",29,"د",1,0],["وترتعُ في رِياضِ الحُسنِ مِنّي","وَتَجنِي مِن جَناها كُلَّ حالِ",30,"ل",1,0],["وترتيلُ آياتِ الكتابِ مُنَوِّراً","بِها جوفَ لَيلِي في قيامِ تَهَجُّدِي",31,"د",2,0],["وترّتج عن كثبان رملة عالج","من السرب اكفال ثقيل خفيفها",32,"ف",3,0],["وَتَرْتِني سَهْم َحزن ٍمِن سِهَامِكِ هلْ","أذنبتُ إنْ كنتُ لمْ أخطيءْ ولمْ أصبِ",33,"ب",1,0],["وترتاح طوع الصّبا والصَّبا","إذا ما انثنى قدُّها واستقل",34,"ل",1,0],["وترتوى من شراب الأنس صافية","يا سعد من مات مملوءاً بصافيه",35,"ي",2,0],["وَتَرْتَمِي رَأْسَ المُسِيء الأَحْيَنِ","بِمِقْذَفٍ يَكْسِرُ هَضْب الأَوْجَنِ",36,"ن",1,0],["وترتعد الحوادث منه خوفاً","ويعرو الهول منه الارتهابُ",37,"ب",1,0],["وَتَرتيلُنا القرآنَ أفضلُ لِلذي","أُمِرنا بِهِ مِن مُكثِنا فيهِ والفِكرِ",38,"ر",1,0],["وَتَرتَمي بِالصَخرِ زَجلاً زاجِلا","مُعَجرَماتٍ بُزَّلاً سَغابِلا",39,"ل",2,1],["وترتضي في ابنك السعيد أَبي","عبد الإله المُنى وتحْمَدُهَا",40,"د",3,0],["وترتقي بجناحي ظلها أكما","كالطير في الجو يعلو ثم ينقلب",41,"ب",1,0],["وترت مَن كم على جمر الوغى","ألقت الأخمُص رجلاها صِيالا",42,"ل",2,0],["وَتَرْتَقِي بِأبِي عَمرٍو لِغَايَتِهِ","وَمَا يَخَافُ عَلَى المَأمونِ مُؤتَمَنُ",43,"ن",1,0],["وترتبطوا الجُرْدَ العِتاق مضافَةً","إلى ما ارتبطتم من عتاقِ بِغالِ",44,"ل",1,0],["وترتجُّ أرض اللهِ يومَ نزاله","بأوتادها الأطوادُ أو تتزلزلُ",45,"ل",1,0],["وَتَرتَدُّ عَينُ الشِعرِ عَنكَ حَسيرَةً","كَلَيلَة لحظٍ نورُها مُتَضائِلُ",46,"ل",1,0],["وترتوي منَ المعارفِ كما ار","تَوى بها في عصرِنا منِ اعتنى",47,"ا",1,0],["وتَرتئي طريقةَ الجِدِّ فذو ال","جِدِّ نبيهٌ ذِكرُه في المرتَقى",47,"ا",1,0],["وترتجيه من الرحمن سائلة","حتى استجيب بما ترجوه داعيها",48,"ي",3,0],["وَتَرتَفٍع لَهُم مِنَ المَطَالِع","يَرمِيهُمُ بَرِّ ظَلُومٌ طَامِع",49,"ع",1,0],["وترتجلُ الأرض انشودة","يرددها خضرُ اشجارها",50,"ا",1,0],["وترتاع أحياناً لدى السرى ريبة","كما ارتاع ظبي من تهامة نافرُ",51,"ر",1,0],["وترتمي بين أجواز الفلا شغفاً","والشوق في البيد حاديها وهاديها",52,"ي",3,0],["وترتجيه الملا في كل ملتمس","يلوح بالخير مبداه وآخره",53,"ر",2,0],["وَتَرتاحُ لِلوُفّادِ رَوحاً وَراحَةً","فَمروحكَ الإِعطاءُ دامَ لَكَ اليُسرُ",54,"ر",1,0],["وترتع النجوى على عرشها","وينتشى الوجد ويحلو النشيد",55,"د",1,0],["وترتاحُ قضبٌ للقواضِبِ عنْدها","فها هيَ روضٌ بالغَمائِمِ مُزْهِرُ",56,"ر",1,0],["وترته عن قوس الضغا","ئن اسهم من كل جانب",57,"ب",1,0],["وترتبت بالمرتب في ظه","ر أتاني لأ