{"poems":[[95,"أمات أولئك الجند الكرام","https://www.aldiwan.net/poem11420.html","الوافر"],[56,"خرجت مبكرا من سر من را","https://www.aldiwan.net/poem29346.html","الوافر"],[93,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[93,"يّها الراعي","https://www.poetsgate.com/ViewPoem.aspx?id=53026",""],[189,"تولى شباب واقتراب فأمعنا","https://www.aldiwan.net/poem14733.html","الطويل"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[556,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83284","الطويل"]],"verses":[["فَلَمَا ثَابَ لِلعَانِي شُعُورٌ","نَفَاهُ الضَّعْفُ عَنْهُ وَالسَّقَامُ",0,"م",1,0],["فَلَم أَثنِ العِنانَ وَقُلتُ أَمضي","فَوَجهُكَ يا عُمَيرُ خِرا وَخَيرُ",1,"ر",1,0],["فَلَمّا ثارَ ثائِرُ كُلِّ حُرٍّ","رَجِعتَ اليَومَ تَمتَدِحُ الحِيادا",2,"د",2,0],["فلمّا ثار ثائر حرّ","رجعت اليوم تمتدح الحيادا",3,"د",2,0],["فلما ثنى عنه الشباب عنانه","وشاهَد من جيش المَشيب مُكمَّنا",4,"ن",2,0],["فلما ثَوى ولكل امْرئٍ","مَنونٌ إذا حُمَّ إبَّانُها",5,"ن",3,0],["فَلمّا ثناه جنابُ الأجل","لِ نَفّض عن مَنكِبيهِ الغُبارا",6,"ر",2,0],["فَلَمّا ثَوى تَحتَ الرِغامِ وَذَلَّلَت","بِمَصرَعِهِ لِلعِلمِ شَمَّ المَراغِمِ",7,"م",1,0]]}