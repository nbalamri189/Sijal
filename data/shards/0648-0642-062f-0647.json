{"poems":[[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[27,"عرفت ببرقة الوداء رسما","https://www.aldiwan.net/poem5983.html","الوافر"],[51,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[51,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[51,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[85,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[85,"علمت بأن الحطام انصرف","https://www.aldiwan.net/poem7750.html","المتقارب"],[45,"جعلت فداك الدهر ليس بمنفك","https://www.aldiwan.net/poem65216.html","البسيط"],[45,"أعن سفه يوم الأبيرق أم حلم","https://www.aldiwan.net/poem65673.html","الطويل"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[74,"ويوم صقيل للشباب ظللته","https://www.aldiwan.net/poem12860.html","الطويل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[46,"أعكرم إن غنيت ألفيت نادبا","https://www.aldiwan.net/poem23341.html","الطويل"],[46,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9987","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54659","السريع"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[77,"نديمي عللني بمشمولة واسق","https://www.poetsgate.com/ViewPoem.aspx?id=34194",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[45,"جُعِلتُ فِداكَ، الدّهْرُ ليسَ بمُنفَكِّ","https://www.poetsgate.com/ViewPoem.aspx?id=33093",""],[116,"لقد ظن العذول نسيت حاشا","https://www.aldiwan.net/poem40924.html","عموديه"],[116,"ما هب نشر الصبا","https://www.aldiwan.net/poem41256.html","عموديه"],[133,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[133,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[133,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[148,"أقول لمحبوب تخلف من بعدي","https://www.aldiwan.net/poem47681.html","الطويل"],[151,"يا حاسد النعمة في غيره","https://www.aldiwan.net/poem68516.html","السريع"],[161,"هلموا فقد قامت على ساقها الحرب","https://www.aldiwan.net/poem59019.html","الطويل"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[187,"أقول لمن أراد الحزم يوما","https://www.aldiwan.net/poem43549.html","الوافر"],[196,"فما عزلوك مسبوقا ولكن","https://www.aldiwan.net/poem54386.html","الوافر"],[200,"أطاب لذلك لرشا الجفاء","https://www.aldiwan.net/poem45593.html","الوافر"],[213,"من لي باحوى من الآرام منتخب","https://www.aldiwan.net/poem37920.html","الطويل"],[230,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[276,"أشد بالقوافي ذكر علوة أو عليا","https://www.aldiwan.net/poem25451.html","الطويل"],[281,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[283,"لي عاذل في الحب ما أعذله","https://www.aldiwan.net/poem32635.html","السريع"],[283,"يا عاذلي أقصر فكم تتعب","https://www.aldiwan.net/poem32861.html","السريع"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[298,"سرت سحرا والنجم للغرب مائل","https://www.aldiwan.net/poem33191.html","الطويل"],[365,"وطالع من مشرق القباء","https://www.aldiwan.net/poem61019.html","الرجز"],[367,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[403,"ألحاظه كالسهام فعلا","https://www.aldiwan.net/poem46645.html","المنسرح"],[404,"أتت وخيول الهم في القلب ترتكض","https://www.aldiwan.net/poem33699.html","الطويل"],[404,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[404,"سلام على نجد ومن حل في نجد","https://www.aldiwan.net/poem33956.html","الطويل"],[404,"بالله يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[417,"لقد عجب الحسان الغيد لما","https://www.aldiwan.net/poem53981.html","الوافر"],[430,"من الصبابة تثني القد نيروز","https://www.aldiwan.net/poem40501.html","البسيط"],[440,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[442,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[459,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[459,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[480,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[517,"وقد هاجني للشوق نوح حمامة","https://www.aldiwan.net/poem48685.html","الطويل"],[539,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[554,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[559,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[576,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[586,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["وقد هرِمَتْ ممّا تطاوَلَ عُمْرُها","وممّا محَتْ أعْضاءَها حَمْيَةُ الزِّقِّ",0,"ق",1,0],["وَقَد هَرَّت كِلابُ الحَيِّ مِنّ","وَشذَّبنا قَتادَةَ مَن يَلينا",1,"ن",2,0],["وَقَد هَجَموا الرِهانَ فَما كَبَونا","وَما أَوهى قَناتِيَ مِن وُصومِ",2,"م",1,0],["وَقَد هَجَمَت وَأُمِّكَ خَيلُ قَيسٍ","عَلى رَعنِ السَلَوطَحِ ذي الأُرومِ",2,"م",1,0],["وقد هجمتَ لعمرِي","فانظر إلى أين تُفضي",3,"ض",2,0],["وقد هجوت امرءاً يجل عن ال","مدح وعندي الحفاظ لا الجزع",4,"ع",1,0],["وقد هتف الله في وحيه","به لقريش أشدَّ الهتاف",5,"ف",1,0],["وقد هجم الشتاء وكم لئيمٍ","عليه الخز والوبر اللُّوامُ",6,"م",1,0],["وقد هانت حياتهم عليهم","وكانوا بالحياة هم الشحاحا",7,"ح",2,0],["وقد هجر النظم نظم الجمان","وقد هجر النثر نثر الطرف",8,"ف",1,0],["وَقَد هَذَّبَتكَ النائِباتُ وَرِنَّما","صَفا الذَهَبُ الإِبريزُ قَبلَكَ بِالسَبكِ",9,"ك",1,0],["وَقَد هُدِيَ السُلطانُ لِلرُشدِ إِذ نَبا","بِأَغثَرَ مِن أَولادِ قُطرُبُّلٍ فَدمِ",10,"م",1,0],["وَقَد هاجَني مِنها عَلى النَأيِ دِمنَةٌ","لَها بِقُدَيدٍ دونَ نَعفِ المَشَلَّل",11,"ل",1,0],["وَقَد هَزَّ مِن عِطفَي نَديمٍ وَخوطَةٍ","أَنينُ حَمامٍ أَو غُلامٌ يُطَرِّبُ",12,"ب",1,0],["وَقُدها قَودَ مَأمونٍ عَلَيها","يُصاديها بِأَحسَنِ ما تُصادى",13,"د",2,0],["وَقد هَزَّ الحسامَ عليه عادٍ","بِيَوْمٍ نَوْمُه فيه هُبوبُ",14,"ب",1,0],["وَقَد هَمَمتُ بِيَحيى ثُمَّ أَدرَكَني","حِلمي فَأَمسَكتُها مُحمَرَّةً لَهَبا",15,"ب",2,0],["وَقَد هاجَ في الإِسلامِ كُلَّ مُوَلِّدٍ","وَأَطرَبَ ذا نُسكٍ وَآخَرَ مُجرِما",16,"م",2,0],["وَقَد هَتَمَ النُعمى هُمَيمُ اِبنُ غالِبٍ","لِما سارَ مِن أَقوالِهِ في الأَهاتِمِ",17,"م",1,0],["وقد هدأ المصباحُ إلَّا مجاجةً","من النورِ في عيني أديبٍ مُسهّدِ",18,"د",1,0],["وَقَد هَرَّت كِلابُ الحَيِّ مِنّا","وَشذَّبنا قَتادَةَ مَن يَلينا",19,"ن",2,0],["وَقَد هَتَفَت في جُنحِ لَيلٍ حَمامَةٌ","مُغَرَّدِةٌ تَشكو صُروفَ زَمانِ",20,"ن",1,0],["وَقَدُّهَا الْعَادِلُ فِي مَيْلِهَا","كَقَدِّكِ الْعَادِلِ إِنْ مِلْتِ",21,"ت",1,0],["وَقَد هَتَكَ الصُبحُ الجَلِيُّ كَفاءَهُ","وَلَكِنَّهُ جَونُ السَراةِ مُرَوَّقُ",22,"ق",1,0],["وقد هبطتُ بما أسديتُه لَكُمُ","من حالقٍ ولعل الله قد خارا",23,"ر",2,0],["وقد هرمت مما تطاول عمرها","ومما محت أعضاءها حمية الدق",24,"ق",1,0],["وقد هان شرُّ لو أطاقوا تحملاً","ولكنه لم يَبْقَ حتى التحّمل",25,"ل",1,0],["وَقَدْ هَذّبَتْكَ الَّنائباتُ، وَإنّمَا","صَفا الذّهبُ الإبرِيزُ قبْلكَ بالسّبْكِ",26,"ك",1,0],["وقد هارشت طبعك بالدنايا","وان الليث يحتقر الهراشا",27,"ش",2,0],["وقده كم وكم","عقل محب سبا",28,"ب",2,0],["وقد هيج البغضاء بعد مودة","هِجَاهُ وكان الناسُ مُجتنبينَها",29,"ه",2,0],["وقد هاج المتيم أن تنادوا","ورموا للنوى إبلا هِجانَا",30,"ن",2,0],["وقَد هَيَّجت آيَاتُ دُورٍ مَحِيلَةٍ","لَدَى مَيسةِ المَرضَى البَلاَبِلَ والجَوَى",31,"و",2,0],["وقد هالني بل قد أفاض مدامعي","وأضنى فؤادي بل تعدّى عن الحدّ",32,"د",1,0],["وقد هدى جفنك بدرُ الدُّجى","وأنت لا تطرف عن كوكبه",33,"ب",2,0],["وقد همَّ أن يغشى الشآم بنفسه","وان يملأ الأقطار عسكره اللجب",34,"ب",1,0],["وقد هلكوا إلا القليل فاتبعن","بهم من بقى منهم لحزبك يرهب",35,"ب",1,0],["وقده مسالما في لين قول","كما يحنو الرفيق على الرفيق",36,"ق",1,0],["وَقَد هيضَت لِنَكبَتِكَ القُدامى","كَذاكَ اللَهُ يَفعَلُ ما أَرادا",37,"د",2,0],["وقد هبَّ النسيمُ على فؤادي","كنضوِ اليأسِ هبَ لهُ الرجاءُ",38,"ا",2,0],["وقدّه تُخْجِلُ الأغصانَ ميسته","وردفه قد زرى بالموجِ والكُثُبِ",39,"ب",1,0],["وقد هزَم الأُسْدَ حتى انتهاك","فلمّا رآك غدَا لا يَرَى",40,"ا",1,0],["وَقَدْ هَجَرُوا حتَّى اليَراعَ فَإِنَّمَا","يَخُطُّون بِالخَطِيِّ مَا يَفْضَحُ الوَشْيَا",41,"ي",2,0],["وَقَدْ هَبَّتْ سُيُوفُكَ لامِعَاتٍ","تُفَرِّقُ في دُجُنَّتِهِ نَهارا",42,"ر",2,0],["وَقَدُّها مُعتَدِلٌ مِثلُ غُص","نِ البانِ سُبحانَ الَّذي عَدَّلَه",43,"ل",2,0],["وَقَدُّهُ أَطعَنُ مِن رُمحِهِ","وَلَحظُهُ مِن سَيفِهِ أَضرَبُ",44,"ب",1,0],["وَقدِّها القَضيب","ورِدفها الكَثيبِ",45,"ب",1,0],["وَقَد هُديتُ إلى حسن التخلُّص من","غيّ النَسيب بمدحي سيِّد الأُمَمِ",46,"م",1,0],["وَقَد همَّتِ الظَلماءُ في الأُفق بالسُرى","كَما همَّ بالسَير الخَليط المزايلُ",47,"ل",1,0],["وقَدُّه من شِدةِ الْتواء","كالغُصْنِ تحتَ العاصفِ الهَوجاء",48,"ا",2,0],["وَقَد هَدَّدوني بِالرَحيلِ وَما دَرَوا","بِأَنَّهُمُ قَد سافَروا قَبلُ بِالهَجرِ",49,"ر",1,0],["وقدُّه كالقَضيب ليناً","بل دونَهُ السّمرُ والبشامُ",50,"م",1,0],["وقد هيض فكري من أمور تعاظمت","فليس إلى شيء من المجد ينهض",51,"ض",1,0],["وقد هجروا ما كان من بِدَعٍ ومِنْ","عبادة من حلَّ المقابر في اللحد",52,"د",1,0],["وقد هتفوا عند الشدائد باسمها","كما يهتف المضطر بالصمد الفرد",53,"د",1,0],["وقده كلاْنه","غصن النقا مغتصباً",54,"ب",2,0],["وقد هدرت زماناً فاستقرت","وكانت لا تصيخ إلى قرار",55,"ر",1,0],["وقدها أم ردينيٌّ تميدُ به","أعطافها أم قضيب البان مهزوزُ",56,"ز",1,0],["وَقَدْ هاج مُصعبَ هيجَائِها","برَيبِ المَنونِ وأَحْمى خطامَهْ",57,"م",2,0],["وقد هيأ القوم زاد الصاحلي","ن وأنت أترحل من غير زاد",58,"د",1,0],["وقُدْها محدّبهً كالقسيِّ","من الضّال تسبي الفيافي نِضالا",59,"ل",2,0],["وقد هزّني والدجى مُسبَلٌ","وأسهرني والورى هُجَّعُ",60,"ع",1,0],["وقده في اعوجاج","وأنفه في التراب",61,"ب",1,0],["وَقَد هاجَني لِلشَّوقِ نوح حَمامَة","هتوف الضُحى هاجَت حماماً فَغَرَّدا",62,"د",2,1],["وقد هجمَ الصَّيفُ المُذيبُ لٍِصحَّتي","علىَّ فأرجو رُخصةً منكَ لي شَهرا",63,"ر",2,0],["وَقَدُّها مَمشوقٌ","مُنَعَّمٌ مَقدودُ",64,"د",1,0],["وقد هدى فيه إليه أمةً","بأمره قد جاء يعملونا",65,"ن",2,0],["وقدُّه الأَملَدُ لي قاتِلٌ","تمرَّدَ الأَمرَدُ بالأَمْلدَ",66,"د",1,0],["وقد هاجرتُ إِنكاراً لما قد","رأيتُ من المثالب والعيوب",67,"ب",1,0]]}