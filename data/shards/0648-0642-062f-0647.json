{"poems":[[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[27,"عرفت ببرقة الوداء رسما","https://www.aldiwan.net/poem5983.html","الوافر"],[51,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[51,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[51,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[85,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[85,"علمت بأن الحطام انصرف","https://www.aldiwan.net/poem7750.html","المتقارب"],[45,"جعلت فداك الدهر ليس بمنفك","https://www.aldiwan.net/poem65216.html","البسيط"],[45,"أعن سفه يوم الأبيرق أم حلم","https://www.aldiwan.net/poem65673.html","الطويل"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[74,"ويوم صقيل للشباب ظللته","https://www.aldiwan.net/poem12860.html","الطويل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[46,"أعكرم إن غنيت ألفيت نادبا","https://www.aldiwan.net/poem23341.html","الطويل"],[46,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9987","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54659","السريع"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[77,"نديمي عللني بمشمولة واسق","https://www.poetsgate.com/ViewPoem.aspx?id=34194",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[45,"جُعِلتُ فِداكَ، الدّهْرُ ليسَ بمُنفَكِّ","https://www.poetsgate.com/ViewPoem.aspx?id=33093",""]],"verses":[["وقد هرِمَتْ ممّا تطاوَلَ عُمْرُها","وممّا محَتْ أعْضاءَها حَمْيَةُ الزِّقِّ",0,"ق",1,0],["وَقَد هَرَّت كِلابُ الحَيِّ مِنّ","وَشذَّبنا قَتادَةَ مَن يَلينا",1,"ن",2,0],["وَقَد هَجَموا الرِهانَ فَما كَبَونا","وَما أَوهى قَناتِيَ مِن وُصومِ",2,"م",1,0],["وَقَد هَجَمَت وَأُمِّكَ خَيلُ قَيسٍ","عَلى رَعنِ السَلَوطَحِ ذي الأُرومِ",2,"م",1,0],["وقد هجمتَ لعمرِي","فانظر إلى أين تُفضي",3,"ض",2,0],["وقد هجوت امرءاً يجل عن ال","مدح وعندي الحفاظ لا الجزع",4,"ع",1,0],["وقد هتف الله في وحيه","به لقريش أشدَّ الهتاف",5,"ف",1,0],["وقد هجم الشتاء وكم لئيمٍ","عليه الخز والوبر اللُّوامُ",6,"م",1,0],["وقد هانت حياتهم عليهم","وكانوا بالحياة هم الشحاحا",7,"ح",2,0],["وقد هجر النظم نظم الجمان","وقد هجر النثر نثر الطرف",8,"ف",1,0],["وَقَد هَذَّبَتكَ النائِباتُ وَرِنَّما","صَفا الذَهَبُ الإِبريزُ قَبلَكَ بِالسَبكِ",9,"ك",1,0],["وَقَد هُدِيَ السُلطانُ لِلرُشدِ إِذ نَبا","بِأَغثَرَ مِن أَولادِ قُطرُبُّلٍ فَدمِ",10,"م",1,0],["وَقَد هاجَني مِنها عَلى النَأيِ دِمنَةٌ","لَها بِقُدَيدٍ دونَ نَعفِ المَشَلَّل",11,"ل",1,0],["وَقَد هَزَّ مِن عِطفَي نَديمٍ وَخوطَةٍ","أَنينُ حَمامٍ أَو غُلامٌ يُطَرِّبُ",12,"ب",1,0],["وَقُدها قَودَ مَأمونٍ عَلَيها","يُصاديها بِأَحسَنِ ما تُصادى",13,"د",2,0],["وَقد هَزَّ الحسامَ عليه عادٍ","بِيَوْمٍ نَوْمُه فيه هُبوبُ",14,"ب",1,0],["وَقَد هَمَمتُ بِيَحيى ثُمَّ أَدرَكَني","حِلمي فَأَمسَكتُها مُحمَرَّةً لَهَبا",15,"ب",2,0],["وَقَد هاجَ في الإِسلامِ كُلَّ مُوَلِّدٍ","وَأَطرَبَ ذا نُسكٍ وَآخَرَ مُجرِما",16,"م",2,0],["وَقَد هَتَمَ النُعمى هُمَيمُ اِبنُ غالِبٍ","لِما سارَ مِن أَقوالِهِ في الأَهاتِمِ",17,"م",1,0],["وقد هدأ المصباحُ إلَّا مجاجةً","من النورِ في عيني أديبٍ مُسهّدِ",18,"د",1,0],["وَقَد هَرَّت كِلابُ الحَيِّ مِنّا","وَشذَّبنا قَتادَةَ مَن يَلينا",19,"ن",2,0],["وَقَد هَتَفَت في جُنحِ لَيلٍ حَمامَةٌ","مُغَرَّدِةٌ تَشكو صُروفَ زَمانِ",20,"ن",1,0],["وَقَدُّهَا الْعَادِلُ فِي مَيْلِهَا","كَقَدِّكِ الْعَادِلِ إِنْ مِلْتِ",21,"ت",1,0],["وَقَد هَتَكَ الصُبحُ الجَلِيُّ كَفاءَهُ","وَلَكِنَّهُ جَونُ السَراةِ مُرَوَّقُ",22,"ق",1,0],["وقد هبطتُ بما أسديتُه لَكُمُ","من حالقٍ ولعل الله قد خارا",23,"ر",2,0],["وقد هرمت مما تطاول عمرها","ومما محت أعضاءها حمية الدق",24,"ق",1,0],["وقد هان شرُّ لو أطاقوا تحملاً","ولكنه لم يَبْقَ حتى التحّمل",25,"ل",1,0],["وَقَدْ هَذّبَتْكَ الَّنائباتُ، وَإنّمَا","صَفا الذّهبُ الإبرِيزُ قبْلكَ بالسّبْكِ",26,"ك",1,0]]}