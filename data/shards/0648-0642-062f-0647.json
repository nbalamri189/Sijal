 فَما كَبَونا","وَما أَوهى قَناتِيَ مِن وُصومِ",2,"م",1,0],["وَقَد هَجَمَت وَأُمِّكَ خَيلُ قَيسٍ","عَلى رَعنِ السَلَوطَحِ ذي الأُرومِ",2,"م",1,0],["وقد هجمتَ لعمرِي","فانظر إلى أين تُفضي",3,"ض",2,0],["وقد هجوت امرءاً يجل عن ال","مدح وعندي الحفاظ لا الجزع",4,"ع",1,0],["وقد هتف الله في وحيه","به لقريش أشدَّ الهتاف",5,"ف",1,0],["وقد هجم الشتاء وكم لئيمٍ","عليه الخز والوبر اللُّوامُ",6,"م",1,0],["وقد هانت حياتهم عليهم","وكانوا بالحياة هم الشحاحا",7,"ح",2,0],["وقد هجر النظم نظم الجمان","وقد هجر النثر نثر الطرف",8,"ف",1,0],["وَقَد هَذَّبَتكَ النائِباتُ وَرِنَّما","صَفا الذَهَبُ الإِبريزُ قَبلَكَ بِالسَبكِ",9,"ك",1,0],["وَقَد هُدِيَ السُلطانُ لِلرُشدِ إِذ نَبا","بِأَغثَرَ مِن أَولادِ قُطرُبُّلٍ فَدمِ",10,"م",1,0],["وَقَد هاجَني مِنها عَلى النَأيِ دِمنَةٌ","لَها بِقُدَيدٍ دونَ نَعفِ المَشَلَّل",11,"ل",1,0],["وَقَد هَزَّ مِن عِطفَي نَديمٍ وَخوطَةٍ","أَنينُ حَمامٍ أَو غُلامٌ يُطَرِّبُ",12,"ب",1,0],["وَقُدها قَودَ مَأمونٍ عَلَيها","يُصاديها بِأَحسَنِ ما تُصادى",13,"د",2,0],["وَقد هَزَّ الحسامَ عليه عادٍ","بِيَوْمٍ نَوْمُه فيه هُبوبُ",14,"ب",1,0],["وَقَد هَمَمتُ بِيَحيى ثُمَّ أَدرَكَني","حِلمي فَأَمسَكتُها مُحمَرَّةً لَهَبا",15,"ب",2,0],["وَقَد هاجَ في الإِسلامِ كُلَّ مُوَلِّدٍ","وَأَطرَبَ ذا نُسكٍ وَآخَرَ مُجرِما",16,"م",2,0],["وَقَد هَتَمَ النُعمى هُمَيمُ اِبنُ غالِبٍ","لِما سارَ مِن أَقوالِهِ في الأَهاتِمِ",17,"م",1,0],["وقد هدأ المصباحُ إلَّا مجاجةً","من النورِ في عيني أديبٍ مُسهّدِ",18,"د",1,0],["وَقَد هَرَّت كِلابُ الحَيِّ مِنّا","وَشذَّبنا قَتادَةَ مَن يَلينا",19,"ن",2,0],["وَقَد هَتَفَت في جُنحِ لَيلٍ حَمامَةٌ","مُغَرَّدِةٌ تَشكو صُروفَ زَمانِ",20,"ن",1,0],["وَقَدُّهَا الْعَادِلُ فِي مَيْلِهَا","كَقَدِّكِ الْعَادِلِ إِنْ مِلْتِ",21,"ت",1,0],["وَقَد هَتَكَ الصُبحُ الجَلِيُّ كَفاءَهُ","وَلَكِنَّهُ جَونُ السَراةِ مُرَوَّقُ",22,"ق",1,0],["وقد هبطتُ بما أسديتُه لَكُمُ","من حالقٍ ولعل الله قد خارا",23,"ر",2,0],["وقد هرمت مما تطاول عمرها","ومما محت أعضاءها حمية الدق",24,"ق",1,0],["وقد هان شرُّ لو أطاقوا تحملاً","ولكنه لم يَبْقَ حتى التحّمل",25,"ل",1,0],["وَقَدْ هَذّبَتْكَ الَّنائباتُ، وَإنّمَا","صَفا الذّهبُ الإبرِيزُ قبْلكَ بالسّبْكِ",26,"ك",1,0],["وقد هارشت طبعك بالدنايا","وان الليث يحتقر الهراشا",27,"ش",2,0],["وقده كم وكم","عقل محب سبا",28,"ب",2,0],["وقد هيج البغضاء بعد مودة","هِجَاهُ وكان الناسُ مُجتنبينَها",29,"ه",2,0],["وقد هاج المتيم أن تنادوا","ورموا للنوى إبلا هِجانَا",30,"ن",2,0],["وقَد هَيَّجت آيَاتُ دُورٍ مَحِيلَةٍ","لَدَى مَيسةِ المَرضَى البَلاَبِلَ والجَوَى",31,"و",2,0],["وقد هالني بل قد أفاض مدامعي","وأضنى فؤادي بل تعدّى عن الحدّ",32,"د",1,0],["وقد هدى جفنك بدرُ الدُّجى","وأنت لا تطرف عن كوكبه",33,"ب",2,0],["وقد همَّ أن يغشى الشآم بنفسه","وان يملأ الأقطار عسكره اللجب",34,"ب",1,0],["وقد هلكوا إلا القليل فاتبعن","بهم من بقى منهم لحزبك يرهب",35,"ب",1,0],["وقده مسالما في لين قول","كما يحنو الرفيق على الرفيق",36,"ق",1,0],["وَقَد هيضَت لِنَكبَتِكَ القُدامى","كَذاكَ اللَهُ يَفعَلُ ما أَرادا",37,"د",2,0],["وقد هبَّ النسيمُ على فؤادي","كنضوِ اليأسِ هبَ لهُ الرجاءُ",38,"ا",2,0],["وقدّه تُخْجِلُ الأغصانَ ميسته","وردفه قد زرى بالموجِ والكُثُبِ",39,"ب",1,0],["وقد هزَم الأُسْدَ حتى انتهاك","فلمّا رآك غدَا لا يَرَى",40,"ا",1,0],["وَقَدْ هَجَرُوا حتَّى اليَراعَ فَإِنَّمَا","يَخُطُّون بِالخَطِيِّ مَا يَفْضَحُ الوَشْيَا",41,"ي",2,0],["وَقَدْ هَبَّتْ سُيُوفُكَ لامِعَاتٍ","تُفَرِّقُ في دُجُنَّتِهِ نَهارا",42,"ر",2,0],["وَقَدُّها مُعتَدِلٌ مِثلُ غُص","نِ البانِ سُبحانَ الَّذي عَدَّلَه",43,"ل",2,0],["وَقَدُّهُ أَطعَنُ مِن رُمحِهِ","وَلَحظُهُ مِن سَيفِهِ أَضرَبُ",44,"ب",1,0],["وَقدِّها القَضيب","ورِدفها الكَثيبِ",45,"ب",1,0],["وَقَد هُديتُ إلى حسن التخلُّص من","غيّ النَسيب بمدحي سيِّد الأُمَمِ",46,"م",1,0],["وَقَد همَّتِ الظَلماءُ في الأُفق بالسُرى","كَما همَّ بالسَير الخَليط المزايلُ",47,"ل",1,0],["وقَدُّه من شِدةِ الْتواء","كالغُصْنِ تحتَ العاصفِ الهَوجاء",48,"ا",2,0],["وَقَد هَدَّدوني بِالرَحيلِ وَما دَرَوا","بِأَنَّهُمُ قَد سافَروا قَبلُ بِالهَجرِ",49,"ر",1,0],["وقدُّه كالقَضيب ليناً","بل دونَهُ السّمرُ والبشامُ",50,"م",1,0],["وقد هيض فكري من أمور تعاظمت","فليس إلى شيء من المجد ينهض",51,"ض",1,0],["وقد هجروا ما كان من بِدَعٍ ومِنْ","عبادة من حلَّ المقابر في اللحد",52,"د",1,0],["وقد هتفوا عند الشدائد باسمها","كما يهتف المضطر بالصمد الفرد",53,"د",1,0],["وقده كلاْنه","غصن النقا مغتصباً",54,"ب",2,0],["وقد هدرت زماناً فاستقرت","وكانت لا تصيخ إلى قرار",55,"ر",1,0],["وقدها أم ردينيٌّ تميدُ به","أعطافها أم قضيب البان مهزوزُ",56,"ز",1,0],["وَقَدْ هاج مُصعبَ هيجَائِها","برَيبِ المَنونِ وأَحْمى خطامَهْ",57,"م",2,0],["وقد هيأ القوم زاد الصاحلي","ن وأنت أترحل من غير زاد",58,"د",1,0],["وقُدْها محدّبهً كالقسيِّ","من الضّال تسبي الفيافي نِضالا",59,"ل",2,0],["وقد هزّني والدجى مُسبَلٌ","وأسهرني والورى هُجَّعُ",60,"ع",1,0],["وقده في اعوجاج","وأنفه في التراب",61,"ب",1,0],["وَقَد هاجَني لِلشَّوقِ نوح حَمامَة","هتوف الضُحى هاجَت حماماً فَغَرَّدا",62,"د",2,1],["وقد هجمَ الصَّيفُ المُذيبُ لٍِصحَّتي","علىَّ فأرجو رُخصةً منكَ لي شَهرا",63,"ر",2,0],["وَقَدُّها مَمشوقٌ","مُنَعَّمٌ مَقدودُ",64,"د",1,0],["وقد هدى فيه إليه أمةً","بأمره قد جاء يعملونا",65,"ن",2,0],["وقدُّه الأَملَدُ لي قاتِلٌ","تمرَّدَ الأَمرَدُ بالأَمْلدَ",66,"د",1,0],["وقد هاجرتُ إِنكاراً لما قد","رأيتُ من المثالب والعيوب",67,"ب",1,0],["وَقَد هِجتَ بِما حاوَل","تَ أَمراً كانَ مَدفونا",68,"ن",2,0],["وقد هامت الألباب فيه فلبت","تنزل روح اللَه في روح أمره",69,"ه",1,0],["وقد هامت الألباب في فهم قوله","له المثل الأعلى وليس كمثله",69,"ه",1,0],["وقد هام بي فيها نُهى كل أمة","تملت بها الآمال في كل ملة",69,"ه",1,0],["وقد همت بالإلهام عن وهم فهمه","وهمّي تلاها بالفهوم الفهيمة",69,"ه",1,0],["وقد هجرت في الهجر أوطان هجرتي","وحالت به عن كل حول ولم تحل",69,"ل",1,0],["وقد هَزموا أبا حفصٍ عميراً","وصاحبَهُ مِراراً فاستُطيروا",70,"ر",3,0],["وَقَدُّهُ قَد رسا مِن تَحتِهِ كفلٌ","كالغُصنِ فَوقَ الكثيبِ الراسِخِ الراسى",71,"س",2,0],["وقد هَوَتْ بهوَى نَفْسِي مَهَا سَبَأٍ","فهل دَرَتْ مُضَرٌ مَنْ تَيَّمَتْ سبَأُ",72,"ا",1,0],["وقد هذبت أخلاق الليالي","فعادت في مودتها حسانا",73,"ن",2,0],["وَقَدّه الغُصن مَيَّاساً عَلى نَسَقٍ","في مَيسِ ذي طَرَبٍ لا مَيسِ مُضطَرِبِ",74,"ب",1,0],["وَقَدْ هَطَلَتْهُ غَيْبَةٌ مِنْ سَحَابِهِمْ","وَكَالُوا لَهُ صَاعاً مِنَ النَّثِّ والْقَصّ",75,"ص",1,0],["وقدها