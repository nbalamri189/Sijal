udhabi.ae/diwan/poem/22802","الطويل"],[4691,"لكن الهوى حصلا !!","https://www.poetsgate.com/ViewPoem.aspx?id=64040",""],[4767,"الأتست (قسم اعتماد الصرف)","https://www.poetsgate.com/ViewPoem.aspx?id=88157",""],[4767,"على ضفة الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=178413",""],[4962,"أخي","https://www.poetsgate.com/ViewPoem.aspx?id=201630",""],[4984,"القضاء","https://www.poetsgate.com/ViewPoem.aspx?id=187632",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5121,"أُكَلِّمُ نَفْسِي","https://www.poetsgate.com/ViewPoem.aspx?id=213476",""],[5121,"هذا الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=214578",""],[5121,"الشِّعْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=215065",""],[5121,"مُدَلَّلَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=215375",""],[5121,"مُدلَّلَة 2","https://www.poetsgate.com/ViewPoem.aspx?id=215704",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5376,"بنا الأحزان بالآمال تترى","https://www.poetsgate.com/ViewPoem.aspx?id=191965",""],[5413,"إنه الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=200596",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5431,"أقيموا جدار الروح....","https://www.poetsgate.com/ViewPoem.aspx?id=210877",""],[5442,"سرى والدحى شوق إليه وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=114746",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5616,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203486",""],[5659,"لبئس صديقا من أراك مودة","https://www.poetsgate.com/ViewPoem.aspx?id=200461",""],[5691,"تدور بنا الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206080",""],[5701,"مقادير تمحو ما تشاء وتكتب","https://www.poetsgate.com/ViewPoem.aspx?id=164592",""],[5957,"لماذا هجرت فؤادي وعيني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=12043",""],[5957,"أفتش عنك","https://www.poetsgate.com/ViewPoem.aspx?id=27786",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""],[6069,"وقفت مع العشاق في كل موقفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105709",""],[6115,"على شأن مايشره عليه خيار الناس","https://www.poetsgate.com/ViewPoem.aspx?id=181444",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""]],"verses":[["فَلا تُنكِروا قُلعَةً مِن فَتىً","أَقامَ عَلى مَطلِكُم ما أَقاما",0,"م",2,0],["فَلا تَنظُر إِلَيَّ بِعَينِ عَجزٍ","فَرُبَّ مُهَنَّدٍ لَكَ في ثِيابي",1,"ب",2,0],["فلا تُنْكِري سَيْري إلَيْكِ على الوَجى","رَكائِبَ لا يُنْعَلْنَ غيرَ ظِلالِ",2,"ل",1,0],["فلا تَنْسَ لي هَذا الذِّمامَ فإنّهُ","لَخيْرُ ذِمامٍ قد وصَلْتُ به يَدي",3,"د",2,0],["فَلاَ تُنْكِرُوا أَنْ هَزَّتِ الرِّيحُ مَنْكِبي","وَأَذْهَلَنِي وَجْدِي عَنِ الأَهْلِ وَالصَّحْبِ",4,"ب",1,0],["فَلا تَنصِبوا لِلناسِ تِمثالَ عَبدِهِ","وَإِن كانَ ذِكرى حِكمَةٍ وَثَباتِ",5,"ت",1,0],["فَلا تُنكِري عَهدَ المَآذِنِ إِنَّهُ","عَلى اللَهِ مِن عَهدِ النَواقيسِ أَكرَمُ",6,"م",1,0],["فَلا تَنطِقوا إِلّا صَواباً فَإِنَّني","أَخافُ عَلَيكُم أَن يُقالَ تَهَوَّروا",7,"ر",3,0],["فَلا تُنكِروني إِنَّني أَنا ذاكُمُ","لَيالِيَ حَلَّ الحَيُّ غَولاً فَأَلعَسا",8,"س",2,0],["فَلا تُنكِر عَلى أَحَدٍ إِذا ما","طَوى عَنكَ الزِيارَةَ عِندَ ضيقِ",9,"ق",1,0],["فَلا تَنسَ الخَنازيرَ اللَواتي","مُسِخنَ مَعَ القُرودِ الخاسِئينا",10,"ن",2,0],["فَلا تُنكِح كَريمَكَ نَهشَلِيّاً","فَتَخلِطَ صَفوَ مائِكَ بِالغُثاءِ",11,"ا",2,1],["فلا تنكرا ما سامني مضض الهوى","فمن قبل ما أودى بقيس وغيلانِ",12,"ن",1,0],["فلا تُنكروا عهد الأخاء وقد أتت","تصافحكم فيه نزار وعدنان",13,"ن",1,0],["فلا تنكروا شمس الحقيقة أنها","لأظهَرُ من هذا الحديث المُرَجَّم",14,"م",1,0],["فلا تنفر بسمعك من غناءٍ","به غنّتك شادية بغوم",15,"م",1,0],["فَلا تُنكِريني يا اِبنَةَ العَمِّ إِنَّهُ","لِيَعرِفُ مَن أَنكَرتِهِ البَدوُ وَالحَضرُ",16,"ر",1,0],["فَلا تَنسِبَنَّ إِلَيَّ الخُمولَ","عَلَيكَ أَقَمتُ فَلَم أَغتَرِب",17,"ب",1,0],["فلا تنكرا تعبيس وجهي فإنما","تنقل ذاك الابتسام إلى شعري",18,"ر",2,0],["فلا تنكرا منه حلاوة لحظه","فذاك أراه بالنعاس معسلا",19,"ل",2,0],["فلا تنصبنَّ الحربَ لي بملامتي","وأنت سلاحي في حروب النوائبِ",20,"ب",1,0],["فلا تنسيَنَّ عِداتٍ مضتْ","فقِدماً تلبَّستَ أثوابَها",21,"ب",3,0],["فلا تنادر قائلاً عنده","أخاف أن يحزن معناقي",22,"ق",2,0],["فلا تنظري جري الأيامِنِ وأْمني","بيُمنِ الذي يمَّمْتُ جَرْيَ الأشائمِ",23,"م",1,0],["فَلا تَنزِل بِجَعدِيٍّ إِذا ما","تَرَدّى المُكرَعاتُ مِنَ الدُخانِ",24,"ن",1,0],["فَلا تُنكِروا طيبَ النَسيمِ إِذا سَرى","إِلَيكُم فَذاكَ الطيبُ فيهِ سَلامي",25,"م",2,0],["فَلا تُنكِروا مِنّي خُضوعاً عَهِدتُمُ","فَما أَنا في شَيءٍ سِوى الحُبِّ خاضِعُ",26,"ع",1,0],["فلا تنكروا أهل الجريدة ظاهري","جريدتكم يوم الفخار على رجلي",27,"ي",1,0],["فَلا تَنسَ أَمسِ وَآلاءَهُ","أَلا إِنَّ أَمسِ أَساسُ الوُجود",28,"د",1,0],["فَلا تَنَلكَ اللَيالي إِنَّ أَيدِيَها","إِذا ضَرَبنَ كَسَرنَ النَبعَ بِالغَرَبِ",29,"ب",1,0],["فَلا تُنكِرَنَّ لَها صَرعَةً","فَمِن فَرَحِ النَفسِ ما يَقتُلُ",30,"ل",1,0],["فلا تنهكِ الأرض واستبقِ من","رطوبتها ما يبل الرحم",31,"م",1,0],["فلاَ تَنأ وَلذَّاتُ","ك دانٍ منك نَائيها",32,"ي",3,0],["فَلا تَنسَ الوَقارَ إِذا اِستَخَفَّ ال","حِجى حَدَثٌ يَطيشُ لَهُ الوَقورُ",33,"ر",1,0],["فَلا تَنسَ يَوماً تُسَجّى عَلى","سَريرِكَ فَوقَ رِقابِ البَشَر",34,"ر",1,0],["فَلا تَنظُر إِلَيَّ وَلا تُرِدني","وَلا تُقرِب حِبالَكَ مِن حِبالي",35,"ل",2,0],["فَلا تَنوِ غَيرَ فِعالِ الجَميلِ","فَإِنَّ لِكُلِّ اِمرِئٍ ما نَوى",36,"و",2,0],["فَلا تَنسَ نَصيبَكَ في الدُنيا وَاِبتَدِر","إِلى الراحِ إِنَّ الراحَ لِلروحِ تُمسِكُ",37,"ك",1,0],["فَلا تُنكِروا قَتلي بِدِقَّةِ خَصرِهِ","فَإِنَّ جَليلَ الخَطبِ دونَ دَقيقِهِ",38,"ق",2,0],["فَلا تُنكِروا ذِلَّ القَوافي فَقَد رَأى","مُحَرَّمُها أَنّي لَها الدَهرَ رائِضُ",39,"ض",1,0],["فَلا تَنَم عَينُكَ مِن حاسِدٍ","غَضَّ حِراناً مِن عِنانِ الجِماح",40,"ح",1,0],["فَلا تَنظُري لَيلى إِلى العَينِ وَاِنظُري","إِلى الكَفِّ ماذا بِالعَصافيرِ تَفعَلُ",41,"ل",1,0],["فَلا تَنسَ أَطلالَ الدُجَيلِ وَمائَهُ","وَلا نَخَلاتِ الدَيرِ إِن كُنتَ ساقِيا",42,"ي",2,0],["فلا تَنْسُبْ لِقَوْلِ اللَّهِ رَيْباً","فما فِي قولِ رَبِّكَ ما يُرِيبُ",43,"ب",1,0],["فلا تنْكِرُوا أن يحْرَمَ الحَرَمُ الغِنَى","وَساكِنهُ مِنْ فَخْرِهِ الفَقْرُ وَالزُّهْدُ",44,"د",1,0],["فلا تُنسِهِ الأَيَّامُ ذِكْرَكَ إنَّهُ","به فَرِحٌ بينَ الملوكِ فخُورُ",45,"ر",1,0],["فلا تنْظُرِ العُمَّالُ لِلْمالِ إنَّهُ","عَلَى بَيْتِ مالِ المُسْلِمينَ غَيُورُ",45,"ر",1,0],["فَلا تَنسَوُوا اللَهَ الَّذي لَو هُديتُمُ","إِلى رُشدِكُم مازالَ مِنكُم عَلى ذِكرِ",46,"ر",1,0],["فَلا تَنقُض حِبالَ العَهدِ مِنّي","فَما تَخشى لَدَيَّ مِن اِنتِفاضي",47,"ض",2,0],["فَلا تُنكِر إِذا دَنَتِ الأَقاصي","وَلا تَعجَب إِذا مَرِهَ الكَحيلُ",48,"ل",1,0],["فَلاَ تَنتَهِي أَضغانُ قَومي بَينَهُم","وَسَوآتُهُم حَتّى يَصِيرُوا مَواليا",49,"ي",2,0],["فلا تندبِ الضَّعفى وتغصبْ حقوقهم","فتلكَ إذاً كانت شريعة أدغال",50,"ل",1,0],["فلا تَنْسَ تَأْبِينِي إِذا ما فقدتَني","وتَذْكارَ أَيَّامِي وفَضْلَ خلائِقِي",51,"ق",2,0],["فَلا تَنظُرا مِن نَحوِ أَعمُقِ دابِقٍ","وَلَكِن إِلى نَجدٍ وَأَنّى تَرى نَجدا",52,"د",2,0],["فلا تنس لي هذا الزمام فإنه","لخير ذمام قد وصلت به يدي",53,"د",2,0],["فلا تُنْكِريني، يابْنَةَ العَمِّ، إنّهُ","لَيَعْرِفُ من أنْكَرْتهِ البَدْوُ والحَضْرُ",54,"ر",1,0],["فلا تنسبنَّ إليَّ الخمولَ","أقمتُ عليكَ فلمْ أغتربْ",55,"ب",1,0],["فلا تنعتيني بموت الشعور","ولا تحسبي أنّ قلبي تحجر",56,"ر",1,0],["فَلاَ تُنْكِرُ الأَزْوَاجُ بَغْيَ نِسائِهَا","وَلاَ تكْبِرُ الزَّوْجَاتُ خَلْع حيَائِها",57,"ه",2,0],["فَلا تَنْثَنِي حَتَّى يَتِمّ مُرَادُهَا","وَحَتَّى يَكُونَ الحَقُّ فِي خِدْمَةِ البُطْلِ",57,"ل",1,0],["فلا تنبذنه بين أسد عوابس","وبين بلاء حيث ادبر اقبلا",58,"ل",2,0],["فلا تنسَى أمسِ وآلاءَه","ألا إن أمسِ أساسُ الوجود",59,"د",1,0],["فلا تندبوه أنه ليس بالأسى","حقيقاً ولا أهل الهموم العوائد",60,"د",1,0],["فلا تنفسوا شعراً على مفوفا","له لو علمتم جانب متخوف",61,"ف",1,0],["فَلا تَنهى غُواةَ بَني هُصيصٍ","بَنو تَيمٍ وَكُلُّهُمُ عَديمُ",62,"م",1,0],["فلا تنذروا سفكَ الدماء لنرعوى","فكلُّ صريعٍ باغرام قتيلُ",63,"ل",1,0],["فلا تنشُروا للباطلِ اليومَ رايةً","وهل يُنشَر المدفونُ في قَعر أرماسِ",64,"س",1,0],["فَلا تُنكِرِ الحُسّادُ أَن حُزتَ يافِعاً","مَحَلّاً لَهُ في المَهدِ كُنتَ مُؤَهَّلا",65,"ل",2,0],["فلا تنكرن ادعائي الهوى","فحسبك من باطني ظاهري",66,"ر",2,0],["فلا تنكر نجابتهم","فإن جميعهم نجب",67,"ب",1,0],["فَلا تُنسِني الأَيامُ عَهدَكَ بِاللِوى","أَجَل إِنَّ ما أَرَّبت لَيسَ بِناكِثِ",68,"ث",1,0],["فَلا تُنكري خَوضي الطَوامي وَجَوبِيَ ال","مَوامي إِذا الآلُ اِسجَهَرَّت طَياسِلُه",69,"ل",2,0],["فلا تُنْكرى من نهضتي ما عرفِته","وما هي إلا فوقَ ماعهِد الفرش",70,"ش",1,0],["فلا تنكروا بالحزن أن صرت حائرا","اشق جيوب الصبر من عظم حسرتي",71,"ي",1,0],["فلا تنكروا سكري به ان ريقه","هو الراح لكن ضيب الريح والطعم",72,"م",1,0],["فلا تنكروا جهلا من الوجه ما حوى","فهذا الذي لله في مجده سر",73,"ر",1,0],["فلا تُنكِري أَنْ رحتُ وحدَي مفرداً","وأَن بِتّ يَقظانَ الحِجَا غَيْرَ نَوام",74,"م",1,0],["فلا تَنْسَ منّي ناصحاً وابنَ والدٍ","ووالدةٍ ما فيه عنك نُفُور",75,"ر",1,0],["فلا تنْسَ فينا للأَميرِ قضِيَّةً","فَتَفْتَحَ باباً لِلْعِتَابِ مُجَرَّبا",76,"ب",2,0],["فَلَا تَنْتَقِدْهَا بِالْمَلاَمِ فَإِنَّنِي","أُحَمِّلُهَا بَيْتاً يَكُونُ لَهَا عُذْرَا",77,"ر",2,0],["فلا تنقضوا عَهدَ النبيِّ وعهدَها","وكونوا أمام اللهِ أهلَ المبرّةِ",78,"ه",1,0],["فلا تنامي على ضيمٍ ولا تقفي","حيرى فروحُ صلاحِ الدين ترعاك",79,"ك",1,0],["فَلا تُنْكِري ما أَحْدَثَ الدَّهْرٌ إِنَّما","نَوائِبُهُ أَقْرانُ كُلِّ فَتىً قَرْمِ",80,"م",1,0],["فَلا تُنكِرَنَّ هَداكَ المَليكُ","مَقالي فَمَن أَدمَنَ الكَأسَ كاسا",81,"س",2,0],["فلا تنكروا أن أقدم الصب في الهوى","وأردافه قالت لعاشقه ورا",82,"ر",2,0],["فلا تنكروا سكرى برؤياه إنني","سقتني حمي الحب راحةُ إنساني",83,"ي",1,0],["فلا تنتهز قبل انقضاء مقاصد","وفارق نديا فيه ما يعجب الداني",84,"ن",2,0],["فَلا تَنْكُرَنْ حَاليْهُما في مَوَاقِفٍ","هُنَالِكَ فِيهنَّ الجِوارِحُ تَشْهَدُ",85,"د",1,0],["فَلا تَنسب لِغَيرِهِم المَعالي","فَقَد ثَبَتت لَهُم عَقلا وَنَقلا",86,"ل",2,0],["فلا تَنأَى فإنّك من أُناسٍ","مَصائبُهمْ مصائب للمَعال",87,"ل",1,0],["فلا تنمني الأمجادُ إن لم تَسِرْبها","قوافٍ لآفاقِ البلادِ جوائب",88,"ب",1,0],["فَلا تُنكِروا الأَنفاسَ وَهيَ دِماؤُه