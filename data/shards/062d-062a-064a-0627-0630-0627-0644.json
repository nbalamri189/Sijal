{"poems":[[110,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[55,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[79,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[90,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[39,"حتى إذا لهبان الصيف هب له","https://www.aldiwan.net/poem6483.html","البسيط"],[74,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[74,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[74,"أطلق دموعك إن القلب معذور","https://www.aldiwan.net/poem18717.html","البسيط"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[51,"كأن عتابة من حسنها","https://www.aldiwan.net/poem64222.html","البسيط"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[99,"يا وحدتي جئت كي أنسى وها أنذا","https://www.aldiwan.net/poem24749.html","البسيط"],[99,"وليلة بات من أهوى ينادمني","https://www.aldiwan.net/poem24914.html","البسيط"],[82,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[82,"أسعاد إن كمال خلقك راعني","https://www.aldiwan.net/poem31405.html","الكامل"],[46,"لا يحمد السجل حتى يحكم الوذم","https://www.aldiwan.net/poem29707.html","البسيط"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[54,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[54,"داو الهموم بقهوة صفراء","https://www.aldiwan.net/poem27329.html","الكامل"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[50,"أضرمت نار الحب في قلبي","https://www.aldiwan.net/poem10811.html","السريع"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[50,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[50,"حميد ماذا دهاكا","https://www.aldiwan.net/poem66560.html","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[108,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[6,"لِمنِ الدِّيارُ عفونَ بالحَبسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14194&r=&rc=9",""],[132,"ما زلت في لهو وفي طرب وفي","https://www.aldiwan.net/poem50542.html","الكامل"],[164,"يا طيب ما يهدى قبيل الفجر","https://www.aldiwan.net/poem58782.html","الرجز"],[234,"مزجت ماء الكروم","https://www.aldiwan.net/poem50818.html","مجزوء الرمل"],[276,"أرياح نجد تممي الهابا","https://www.aldiwan.net/poem52113.html","الكامل"],[302,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[303,"لا تنكري جزعي وفرط تفجعي","https://www.aldiwan.net/poem36256.html","عموديه"],[355,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[358,"المجد كبر بالسرور وهللا","https://www.aldiwan.net/poem39589.html","الكامل"],[358,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[376,"يا هل على الطرفين من حاكم","https://www.aldiwan.net/poem57163.html","السريع"],[438,"أهلا ببيت خميلة","https://www.aldiwan.net/poem12557.html","مجزوء الكامل"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[591,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107238","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96980","الكامل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146220","الرجز"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96577","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130635","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77958","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108831","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108499","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49593","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100992","الكامل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17653","البسيط"],[1760,"","https://poetry.dctabudhabi.ae/diwan/poem/147721","الكامل"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138802",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53098","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2779,"","https://poetry.dctabudhabi.ae/diwan/poem/31401","الكامل"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142919","البسيط"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113865","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100422","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104672","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202608","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139968","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112336","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89148","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62798","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62750","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102385","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89996","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131058",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86521","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35560","السريع"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106729","البسيط"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107133","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141644","البسيط"],[4767,"عمري","https://www.poetsgate.com/ViewPoem.aspx?id=87029",""],[4767,"خوف وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=209076",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"يا دار يومك بالغميم محجل","https://www.poetsgate.com/ViewPoem.aspx?id=170533",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5442,"غنى بذكر الحمى فارتاح كل شجى","https://www.poetsgate.com/ViewPoem.aspx?id=114774",""],[2638,"عندما صمت الهزار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87864&r=&rc=21",""]],"verses":[["حتى إذا لم يَجِد جودا يجودُ به","رمى الكفوفَ وما رَوَّى بها كَبِدا",0,"د",2,0],["حَتّى إِذا لَم يَبقَ إِ","لاّ أَن يُلامَ وَأَن يُليما",1,"م",2,0],["حتّى إذا لقِحَتْ حُروبُ الجَدْبِ عنْ","أزْلٍ وغالَ جَنابَها إضْرارُهُ",2,"ر",2,0],["حَتّى إِذا لَمَعَ الدَليلُ بِثَوبِهِ","سُقِيَت وَصَبَّ رُواتُها أَشوالَها",3,"ل",3,0],["حتى إذا لاحَ من بُعدٍ لها عُمَرٌ","خارَت قُواها وكادَ الخَوفُ يُرديها",4,"ي",3,0],["حَتّى إِذا لَم يَجِد وَغلاً وَنَجنَجَها","مَخافَةَ الرَمي حَتّى كُلُّها هيمُ",5,"م",1,0],["حتى إذا لم يجد للأمر متسعاً","ولم يجد عن بلوغ العزّ مصطبرا",6,"ر",2,0],["حتى إذا لَهَبان الصيف هَبَّ له","وافغر الكالئين النجم أو كَرَبوا",7,"ب",3,1],["حتى إذا لجأوا إليك كفيتهم","شجناً وقلت أذلةُ العلياء",8,"ا",2,0],["حتى إذا لم يدَعْ لي صدقهُ أملاً","شرقتُ بالدمع حتى كادَ يشرق بي",9,"ب",2,0],["حتَّى إذا لاح مرفوعاً مدائده","وراحَ ذيل علاهُ وهو مجرور",10,"ر",1,0],["حَتّى إِذا لَم يَترُكوا لِعِظامِهِ","لَحماً وَلا لِفُؤادِهِ مَعقولا",11,"ل",2,0],["حَتّى إِذا لَوحُ الكَواكِبِ شَفَّهُ","مِنهُ الحَرائِرُ وَالسَفا المُتَنَصِّبُ",12,"ب",1,0],["حَتى إِذا لَم يَبقَ مِنها سِوى","حَفنَةِ بُرٍّ قَتَلَت نَفسَها",13,"س",3,0],["حَتّى إِذا لَقيَ الكَميَّ مُبارِزاً","شَغَلَتهُ بَهجَةُ حُسنِهِ عَن رَدِّهِ",14,"د",2,0],["حتى إذا لم يجد ريّاً ولا شبعاً","أفضى إلى الأمل المعطوب فاقتاتا",15,"ت",2,0],["حتى إذا لم يَدَع منها سوى رمقٍ","عَدَا على الرَّمقِ الباقي فجندلها",16,"ل",3,0],["حَتّى إذا لَذَعَ الغَرامُ فؤادَهُ","شربَ الغليلَ وأُشرِبَ البِلبالا",17,"ل",2,0],["حتَّى إذا لاح ابتسامك يجتلي","دُرّاً على عينيه ولّى ناكصا",18,"ص",2,0],["حَتّى إِذا لَم نَخَف نَقضَ الهَوى وَصَفَت","لَنا المَوَدَّةُ حَتّى ماؤُها سَجِمُ",19,"م",1,0],["حَتّى إِذا لَم يَعُد في الأَمر مَنزَعَةٌ","وَأَصبَحَ الشَّرُّ جَهراً غَيرَ مُنكَتِمِ",20,"م",1,0],["حَتّى إِذا لَجَّ الثَرى بِمائِها","وَمَلَّها صَدَّت صُدودَ مَن غَضِب",21,"ب",1,0],["حَتّى إِذا لَم يَبقَ إِلّا نورُها","في الدَنِّ وَاِعتَزَلَت عَنِ الأَقذاءِ",22,"ا",2,0],["حتى إذا لَمْ تَدَعْ شَأْوَاً لِمُسْتَبِقٍ","مِنَ الدُّنُوِّ وَلا مَرْقَىً لِمُسْتَنِمِ",23,"م",1,0],["حَتّى إِذا لَجَّجتُ بَحرَ الهَوى","وَطَمَّتِ الأَمواجِ في قَلبي",24,"ب",2,0],["حَتّى إِذا لَم تُطِق مِن","وَقعِ الصَفيرِ حَراكا",25,"ك",2,0],["حَتّى إِذا لَقِحَت أَرخَت عَقائِصَها","فَمالَ مُنتَثِراً عُرجونُها الرَجِلُ",26,"ل",1,0],["حتى إذا لم تُطِق من","وقع الصفان حِراكا",27,"ك",2,0],["حتّى إذا لحق الجواد تَضَرَّعَا","متوسلينِ إليه في استئمان",28,"ن",1,0],["حتى إذا لفَحَتها الريح هاجرةً","زكت وأربت على أملودها ورقا",29,"ق",2,0],["حَتّى إِذا لَم تَرضَها","صَرَفتَ عَنها نَظَرَك",30,"ك",1,0],["حتى إذا لاح الصباحُ لناظرٍ","شَهدُوا لكم بإصابة الأَهداف",31,"ف",1,0],["حتى إذا لف أولاها بآخرها","بشبهة ما تغطى نقرة الظفر",32,"ر",1,0],["حَتَّى إذا کلْتَفَعَ الظِّبَاءُ بِأطْ","رَافِ الظّلاَلِ وَقِلْنَ فِي الكُنْسِ",33,"س",1,0],["حتى إذا لاحَ المشيبُ بلّمتي","قطعتْ حبالَ مودتي ووسائلِي",34,"ل",2,0],["حتى إذا لاحت تباشر الضيا","وافتر في المشرق ثغر الفجر",35,"ر",1,0],["حَتَّى إذا لاحَ فيها","كاللُّؤلؤ المنظومِ",36,"م",1,0],["حَتّى اذا لم تَبقَ من أَعضائه","الا عظاما قد وهت واهابا",37,"ب",2,0],["حتىّ إِذا لم يكن من دونِه وَزَرٌ","شَفى الضغائنَ منه كُلُّ مَوزورِ",38,"ر",1,0],["حتى إذا لحدوه قامتْ ضجةٌ","كالرعدِ للملاءِ العليِّ الأرفع",39,"ع",1,0],["حَتّى إِذا لَحِقَت أَوائِلُها","أَو كدنَ عرقوبَيهِ بالنَهسِ",40,"س",1,0],["حَتّى إِذا لاحَ الصَباح تَظاهَرَت","أَنوارُها تَتلو الهَناء مرَتّلا",41,"ل",2,0],["حَتّى إِذا لَم يَدَع عَوناً لِمُلتَجئٍ","مِن الكماةِ وَلا عَيناً لِمُرتَقِبِ",42,"ب",1,0],["حتَّى إِذا لَم يَستَطع طاعَةً","عاقَبه بالسَّهرِ الدائِمِ",43,"م",1,0],["حتى إذا لعِبَ النّسيمُ","ببَردِها النّضْرِ الإهابِ",44,"ب",1,0],["حَتّى إذا لم أكُ في نصرَةٍ","من أحدٍ كان بكمْ نصري",45,"ر",2,0],["حتى إذا لم يره النبيّ","ناداه بين الناس يا عليّ",46,"ي",1,0],["حَتَّى إِذَا لَمْ يَفُزْ بِالصَّبْرِ حَامِلُهُ","رَامَ السُّلوَّ وَقَدْ لا يُسْعِدُ القَدَرُ",47,"ر",1,0],["حتَّى إِذا لم يبقَ طِرسٌ أَبيَضٌ","أَقبلتُ أُملِيها عَلى الحِيطانِ",48,"ن",1,0],["حتى إذا لم تبق لي من حيلة","قالت لي الأيام مذا تفعل",49,"ل",1,0],["حتى إذ الكبشُ ارتقى","في مُرْتَقَى ثم طلع",50,"ع",1,0],["حتى إِذا لبسوا وهن صوافن","مِيلُ اللجام تُلَجلجُ الأَقفالا",51,"ل",2,1],["حتى اذا لحدوه ظل يضوعهم","أرج بتربة ذلك الملحود",52,"د",1,0],["حَتّى إِذا لاح الصباح تأَملوا","فإِذا البلاد كما حكاها الناشد",53,"د",1,0],["حتى إذا لمحت شمس الضحى وضحت","بانت وقد قطعت من وصلها أملي",54,"ل",2,0],["حتى إذا لم يبق في أبوابه","عافٍ ولا ذو حاجة عصماء",55,"ا",2,0],["حتى إذا لم أُلْفِ فيه حَيْلَةً","إنْ أُوْمِ يَعْمَ وإن أقُلْ لا يَفْهم",56,"م",1,0],["حتى إذا لمحوا المنى وبدت","منها لحمد سراهم البشر",57,"ر",1,0],["حَتّى إِذا لاحَ ضَوءُ الصُبحِ باكَرَهُ","مُعاوِدُ الصَيدِ يُشلي أَكلُباً غُبُسا",58,"س",2,0],["حتّى إذا لفحتك نيران الجوى