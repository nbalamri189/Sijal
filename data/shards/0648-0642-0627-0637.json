{"poems":[[79,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[75,"يا ناسيا لي على عرفانه تلفي","https://www.aldiwan.net/poem11888.html","البسيط"],[90,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[87,"يود من الأرواح ما لا توده","https://www.aldiwan.net/poem7878.html","الطويل"],[47,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[82,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[82,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[90,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[119,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[314,"تبارك ذو العلا والكبرياء","https://www.aldiwan.net/poem50325.html","الوافر"],[369,"يا من لصب بأطراف المنى علق","https://www.aldiwan.net/poem60832.html","البسيط"],[422,"على مثله تجري الدموع السواجم","https://www.aldiwan.net/poem54054.html","الطويل"],[463,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[484,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[505,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[532,"كتابي أبا نصر إليك وحالتي","https://www.aldiwan.net/poem46019.html","الطويل"],[558,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[580,"تركت حبيب القلب تهمي جفونه","https://www.aldiwan.net/poem2847.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86638","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87207","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86788","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59710","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128080","الطويل"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105594","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133946","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112498","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81325","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118757","الطويل"],[3815,"","https://poetry.dctabudhabi.ae/diwan/poem/143161","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114506","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83144","البسيط"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123851","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[1901,"خليليَّ جهل الدهر أفقدني حِلمي","https://www.poetsgate.com/ViewPoem.aspx?id=160394",""],[4927,"أحلام الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29606",""],[3294,"يا راكب الجسرة للجسر","https://www.poetsgate.com/ViewPoem.aspx?id=173269",""]],"verses":[["وَقَاطِعُ الدَّوْلَةِ مُسْتَقْبِلٌ","فَلْتَسْتَعِذْ مِنْ شَرِّ أَوْصَابِهِ",0,"ب",2,0],["وَقاطِعاً صِلَتي مِن غَيرِ ما سَبَبٍ","تَاللَهِ إِنَّكَ عَن روحي لَمَسؤولُ",1,"ل",1,0],["وقاطرةٍ ترمي الفضا بدخانها","وتملأ صدر الأرض سيرها رعبا",2,"ب",2,0],["وَقاطَعتُ الغَوانِيَ بَعدَ وَصلٍ","فَقَد نَزَعَ الغَيورُ عَنِ اِتِّهامي",3,"م",2,0],["وقاطعني من كنت أرجو وفاءه","وأين أخو الود الذي دام وده",4,"د",2,0],["وَقاطِعٌ لِلخُصومِ اللُدِّ إِن نَخِبَت","قُلوبُهُم فَسَرايا عَزمِهِ نُخَبُ",5,"ب",1,0],["وقاطعِ أجوازِ الفيافي مُرَوّعٍ","بدَهرٍ رماه بالخُطوبِ وَرابا",6,"ب",2,0],["وقاطعةٌ طولَ السُّكاكِ وَعَرضه","تُحلّق من بُعْدِ السماءِ على قربِ",7,"ب",1,0],["وقاطرة ترمي الفضا بدُخانها","بدت نغمات ترقص الدمع منصبا",8,"ا",1,0],["وقاطع حبل العدى بصدمة","يبدو عجيب الفتك من بتارها",9,"ر",3,0],["وقاطع صديقا في الرخاء مدانيا","وفي الجدب أضنى الصحب عمدا بهجران",10,"ن",1,0],["وَقاطِنُها سَريعُ الظَعنِ عَنها","وَإِن كانَ الحَريصَ عَلى الثواءِ",11,"ا",2,0],["وقاطعَتْني لأنْ سارَقْتُها نظَراً","وليس في الحُبِّ قَطْعُ الصَّبِّ بالسَّرَق",12,"ق",1,0],["وقاطَعَني لا عن تقالٍ مقاطعٌ","وصارمني لا عن جفاءٍ مصارم",13,"م",1,0],["وقاطعٍ حبلَ الحفاظِ خالعٍ","شاور نجما مشرقيّا قد نَجمْ",14,"م",1,0],["وقاطنات سائرات معكم","تتبعكم مَحَلَّةً وسَفَرا",15,"ر",2,0],["وقاطِعَ مَثْناةِ الحبال حرانُهُ","بأيّ زمامٍ قِيدَ يعنو ويُسمِحُ",16,"ح",1,0],["وقاطعتها سعيلات أريق بها","دم تعهدها ردحا من الزمن",17,"ن",1,0],["وقاطَعَني كِبْراً برِقِّ ثِيابِهِ","وما ذاكَ إِلاَّ من عَلامَةِ قَطْعِهِ",18,"ع",2,0],["وقاطِعِ الكَذوبَ في فِرْيَتِهِ","فإنَّما المَلعونُ عادٌ افْتَرَى",19,"ا",1,0],["وقاطن ارض الشرك يطلب توبة","ويخرج من أرض الحطيم وزمزم",20,"م",1,0],["وَقاطِعَةٍ رِجلَ السَبيلِ مَخوَفَةٍ","كَأَنَّ عَلى أَرجائِها حَدَّ مِبرَدِ",21,"د",1,0],["وقَاطَعْتُه طَوْعاً وكَرْهاً ولا أَرَى","كأَعْجَبَ مِنْ سَمحٍ بهِ وضَنِينِ",22,"ن",1,0],["وقاطعت غيري المستقل بمقطعي","وحققت في جمعي هدى كل مجمع",23,"ع",1,0],["وَقاطعها في وَصلِها غَير طامع","فَتاقَت كَمُشتاق إِلَيهِ المَراتب",24,"ب",1,0],["وَقاطَعني في الحُب لا عَن مَلالة","وَلَكن لِشيء دينه لَيسَ يَرعاه",25,"ا",2,0],["وَقاطَعتني مِن غَير ذَنب فَعَلته","وَواليت مَن عادى فَأَضحى مؤيدا",26,"د",2,0],["وقاطعتُ أسبابي سواكم وُصنتها","عليكم وكنتم منظري وجنان",27,"ن",1,0],["وقاطعتنى لما وثقت بخائن","سعا يته مابيننا أو جبت هجرى",28,"ر",2,0],["وقاطع عضب مثل فاتر طرفه","يقطر أسد الغاب وهو بغمده",29,"د",2,0],["وقاطع شهوات النفس طاغية","حتى يهذبها بالصبر وتذليل",30,"ل",1,0],["وقاطعين طريق العيش أسلكه","وقطرُ غيثى بقومي بينهم همعا",31,"ع",2,0],["وقاطعٌ عن طريق اللّه منقطعٌ","عن باب مولاه محروم من القسم",32,"م",1,0],["وقاطعتنا بالنوى مواصلاً","لو أنصفت ما قطعت وصالها",33,"ل",3,0],["وقاطن سجنٍ وهو سيد قطره","غدا لنعام الذل يُطرق كالكركي",34,"ك",2,0],["وقاطعهم من كان حال حياتهم","بوصلهم وجداً بهم ليس يطمع",35,"ع",1,0],["وقاطِعُها بلا عُذرٍ مُعيدٌ","وقاطِعُ ما سِواها لا يخافُ",36,"ف",1,0],["وقاطامي سواه الحجل","وهو إن قام لبحثٍ أجدل",37,"ل",1,0],["وَقاطعُ القَولِ عَن أَخيهِ","تردُّه بِالصَغير سَلبا",38,"ب",2,0],["وقاطعني اهلي بها ومعاشري","وصارمني فيها طريفٌ وتالد",39,"د",1,0],["وَقاطِع لِمَن واصَلتَ أَيّامَ غَفلَةٍ","فَما واصَلَ العُذّالَ إِلّا مُقاطِعُ",40,"ع",1,0],["وقاطعتْ صَحْبي إذ رَأَيتُ صدورَهم","من الود والإخلاص كالأبُطنِ العُقمِ",41,"م",1,0],["وَقَاْطَعَتْكَº فَلاْ عِلْمٌº وَلاْ خَبَرٌ","وَفَوْقَكَ النَّحْسُ بَعْدَ السَّعْدِ قَدْ نَزَلاْ",42,"ل",2,0],["وقاطع الدو بزيافة","كالصقر قد حط على وكر",43,"ر",1,0]]}