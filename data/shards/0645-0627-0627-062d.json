","الخفيف"],[369,"قل لمن غاب شخصه عن عياني","https://www.aldiwan.net/poem57420.html","الوافر"],[374,"ما أحسن العقل يجلو فضل سيده","https://www.aldiwan.net/poem59325.html","البسيط"],[374,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[399,"ثق بالذي صير دون الورى","https://www.aldiwan.net/poem46930.html","السريع"],[406,"كم إلى كم أكاتم الناس","https://www.aldiwan.net/poem32596.html","مخلع البسيط"],[413,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[429,"شق الكمال عليه جيب سواده","https://www.aldiwan.net/poem12595.html","الكامل"],[429,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[432,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[436,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[441,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[447,"أين الشعور ؟","https://www.aldiwan.net/poem999.html",""],[451,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[456,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[456,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[462,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[466,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[466,"غدا من الدير إلى الدار","https://www.aldiwan.net/poem60104.html","السريع"],[477,"طلعت فينا هلالا","https://www.aldiwan.net/poem37051.html","المجتث"],[477,"بلبل في الروض غنى","https://www.aldiwan.net/poem37611.html","مجزوء الرمل"],[480,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[484,"يشتاق قلبي إلى مليكة","https://www.aldiwan.net/poem455.html",""],[498,"ما أحسن الصباح لما انبلجا","https://www.aldiwan.net/poem37671.html","الرجز"],[498,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[498,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[498,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[498,"عللونا بذكر سادات سلع","https://www.aldiwan.net/poem37824.html","الخفيف"],[498,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[512,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[549,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[551,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[557,"زارني من أحب قبل الصباح","https://www.aldiwan.net/poem69365.html","الخفيف"],[565,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[567,"ما أَحسن الغيرة في حينها","https://www.aldiwan.net/poem51992.html","السريع"],[573,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[573,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["ما اِحتَسَبَ المَرءُ قَد يَهونُ وَما","أَوجَعَ ما لا يَكونُ مَحسوبا",0,"ب",2,0],["ما اِحتَمَلتُ الإِعراضَ وَالصَدَّ حَتّى","قالَ فينا مَن خِفتُهُ أَن يَقولا",1,"ل",2,0],["ما أَحسَنَ الصَبرَ في مَواطِنِهِ","لا عَن حَبيبٍ لِطِيَّةٍ بَكَرا",2,"ر",2,0],["ما أَحسَنَ الوُدَّ إِذا كانَ مَن","تَهواهُ يَجزي الوُدَّ بِالوُدِّ",3,"د",1,1],["ما أَحكما غَيرَ الصِياحِ كَأَنَّما","لَقِنا جِدالَ المُرتَضى بنِ عَساكِرِ",4,"ر",1,0],["مَا أَحْسَنَ الإِحْسَانَ وَهْوَ مُصَرَّفٌ","فِي وَجْهِهِ تَصْرِيفَ رَأْيٍ مُحْكَمِ",5,"م",1,0],["مَا أَحْوَجَ الأَقْوَامَ إِنْ سَدَرُوا إِلَى","أَهْلِ الصَّلاحِ مَنَائِرَ الأَقْوَامِ",6,"م",1,0],["ما احيلى اغضاءة جعلتها","كغريق في لجّة الأحلام",7,"م",1,0],["ما أحسن العَلم الخفاق منتصباً","به تُشير",8,"ر",1,0],["ما أَحدَثَ الدَهرُ مِمّا تَعلَمينَ لَكُم","لِلحَبلِ صُرماً وَلا لِلعَهدِ نِسيانا",9,"ن",2,0],["ما أحسنَ العذبات لائقةً بكم","أما شعاراً أو لساناً يفتح",10,"ح",1,0],["ما أحسن الدِّين والدُّنيا يسوسهما","والطيلسان فلا تخفى مفاخره",11,"ر",2,0],["ما أحسن البيت من علياك متسقاً","أثني عليه وآويه وأنظمه",12,"م",2,0],["ما أحسنَ العيش في عيني وأنتَ به","أما وأنت بأكناف التراب فلا",13,"ل",2,0],["ما أحسن البيت من نعماك أسكنهُ","بكلِّ بيتٍ من الأمداح يعنيه",14,"ي",2,0],["ما أحْسَنَتْ إن كنتُ حَسَّنْتُهَا","ما ظَرَّفَتْ إن كنت ظرَّفْتُها",15,"ت",3,0],["ما أحسنَ الشكلين زوجاً مُزْوَجَا","ما أَملح الزوجين بل ما أَغْنجا",16,"ج",2,0],["ما احتشاد المديح كُفْءُ هُوَيْنا","هُ فأنَّى يكون كُفْء احتشادِهْ",17,"د",2,0],["ما أحسن العفوَ من المالكِ","لا سيما عن هائمٍ هالكِ",18,"ك",1,1],["ما أحدثَ الدهرُ توعيراً لمُلتمسٍ","إلّا دُعِيتَ أبا سهلٍ لِتسهيلِ",19,"ل",1,0],["ما أحسنَ الأرقَم طوقاً لها","وأحسنَ الأسودَ إكليلا",20,"ل",2,0],["ما احتبيْتَ السماعَ والشعرَ وجداً","بالغواني ولا بوصف المغاني",21,"ن",2,0],["ما أَحمَقَ الإِنسانَ يَسكُنُ لِلمُنى","وَالمَوتُ يَخطُرُ حَولَهُ وَيَجولُ",22,"ل",1,0],["ما أَحسَنَ الأَيّامَ قالَت يَومُكُم","وَالناسَ فَاِبتَدَرَت وَقالَت أَنتُمُ",23,"م",1,0],["ما أَحدَثَت في الدَهرِ طارِقَةً","تَبقى وَلَيسَ تَليدُها عَلَما",24,"م",2,0],["ما أُحَيلى الصَيفَ ما أَكرَمَهُ","مَلَأَ الدُنيا رَخاءً وَرَفاها",25,"ا",3,0],["ما اِحتِيالي في كِتابٍ","ضاقَ عَمّا في ضَميري",26,"ر",2,1],["ما احسن الدين قد ادلى بحجته","والعقل والنقل في رأس قد امتزجا",27,"ج",2,0],["ما احب الصباح من","بعد ليل قد ادلهم",28,"م",1,0],["ما أحسن الأضداد في","هذا الجمال المحكم",29,"م",1,0],["ما اِحمَرَّ مِن خَجَلٍ وَلا مِن ريبَةٍ","لَكِنَّما يَبكي بِدَمعٍ قاني",30,"ي",1,0],["ما أَحسَنَ الغَيثَ إِلّا ما حَكاكَ بِهِ","تَهتانُهُ وَاِقتَفاهُ مِنكَ وابِلُهُ",31,"ل",2,0],["ما أَحسَنَ الصَبرَ إِلّا عِندَ فُرقَةِ مَن","بِبَينِهِ صِرتُ بَينَ البَثِّ وَالحَزَنِ",32,"ن",1,0],["ما أَحسَنَ الأَيّامَ إِلّا أَنَّها","يا صاحِبَيَّ إِذا مَضَت لَم تَرجِعِ",33,"ع",1,0],["ما احترفت النفاق يوماً وشعري","ما اشتراه الملوك والأمراء",34,"ا",2,0],["ما أَحسِبُ النَّارَنْجَ إلا فِتنةً","هتَكَ الزَّمانُ لناظرٍ أستارَها",35,"ر",3,0],["ما أَحسَنَ الجود في الدُنيا وَفي الدينِ","وَأَقبَح البُخل فيمَن صِيغَ مِن طينِ",36,"ن",1,0],["ما أَحسَنَ الدين وَالدُنيا إِذا اِجتَمَعا","لا باركَ اللَهُ في دُنيا بِلا دينِ",36,"ن",1,0],["ما أَحسَنَ الدُنيا وَإِقبالَها","إِذا أَطاعَ اللَّهَ مَن نالَها",37,"ل",3,1],["ما أَحمَقَ الإِنسانَ في فَخرِهِ","وَهوَ غَداً في حُفرَةٍ يُقبَرُ",38,"ر",1,0],["ما أَحسَنَ الشُغلَ في تَدبيرِ مَنفَعَةٍ","أَهلُ الفَراغِ ذَوُو خَوضٍ وَإِرجافِ",39,"ف",1,0],["ما أَحسَنَ الدينَ وَالدُنيا إِذا اِجتَمَعا","وَأَقبَحَ الكُفرَ وَالإِفلاسَ بِالرَجُلِ",40,"ل",1,0],["ما أَحسَنَ الصُبحَ لَولا قُبحُ سُرعَتِهِ","وَأَعذَبَ اللَيلَ لَولا كَثرَةُ الأَرَقِ",41,"ق",1,0],["ما احتفاظي بعهود لم تصنها","وإلام الأسر والدنيا لديّ",42,"ي",1,0],["ما أَحْسَنَ العطف من تَأنيسِ نافِرَةٍ","كَأَنَّما رُضْتَ مِنها شادِناً خَرِقا",43,"ق",2,0],["ما أَحْرَقتْ خَدِّي سَواكِبُ أدمُعي","إلّا بِماءٍ في حَشَاهُ نارُ",44,"ر",1,0],["ما أَحسِبُ القَمَرَ المُنيرَ إِذا بَدا","بَدراً بِأَضوَأَ مِنكَ في الأَوهامِ",45,"م",1,0],["ما أَحسَنَ الوُدَّ وَالصَفاءَ وَما","أَقبَحَ مِنها الهِجرانَ وَالعُذرُ",46,"ر",1,0],["ما أَحرَقتها النار لكنما","ضُلوع مَفتون بِغُزلانها",47,"ن",3,0],["ما أحسَنَ الدّنْيا بشَمْلٍ جامِعٍ","لكنّها أُمُّ البَنينَ الثّاكِلُ",48,"ل",1,0],["ما أَحسَنَ الحَمدَ في دَوائِرِهِ","وَحَمدُ قَومٍ كَأَنَّهُ عَوَرُ",49,"ر",1,0],["ما أُحرِمَت عَنكَ خَطاطيفُهُ","فَاِرقَ عَلى ظَلعِكَ أَو قَبقِبِ",50,"ب",1,0],["ما أَحسَبُ الكَوكَبَ المِرّيخَ أَو زُحَلاً","إِلّا أَميرَينِ إِن طالَ المَدى عُزِلا",51,"ل",2,0],["ما أَحسَنَ الأَرضَ لَو كانَت بِغَيرِ أَذىً","وَنَحنُ فيها لِذِكرِ اللَهِ سُكّانُ",52,"ن",1,0],["ما أَحمَدُ الخَيرِيِّ فَألاً بِهِ","وَلا أَذُمُّ الوَردَ وَالسَوسَنا",53,"ن",2,0],["ما أَحوَجَتني إِلى وُرودٍ","لَمّا سَقَتني الخُمارَ رِيّا",54,"ر",3,0],["ما أحْسَنَ ما بُلْبلَ مِنْهُ الصُّدْغُ","قَدْ بَلْبَلَ عَقْلِي وَعَذُولي يلغو",55,"و",1,1],["ما أحسَنَ واو صُدْغِهِ حينَ بَدَتْ","يا ربّ عَسَى تكونُ واوَ العَطْفِ",56,"ف",1,0],["ما أَحسن النقد الَّذي","يَخلو من الحقد الذَميم",57,"م",1,0],["ما أَحسن الثوب النَظي","فِ وَراءه عرضٌ نَظيف",58,"ف",1,0],["ما أحسن الشعر مبثوثاً فرائده","كأَنَّه لؤلؤ رطب ومرجان",59,"ن",1,0],["ما أَحسَن الزهرَ يَزهو","في روضة غب طلِّ",60,"ل",1,0],["ما احتملوا يا ربّ هذا العذابْ","إلَّا رجاءَ الغوثِ من رحمتكْ",61,"ك",1,0],["ما احتواها الفجرُ إلَّا اتّقَدَتْ","جمرةً تذكو حنيناً والتياعا",62,"ع",2,0],["ما احْولَّ نَحْوِي لَحْظُ مُقْلَةِ ساخِطٍ","إِلا وضَعْتُ السَّهْم في إِنْسانِهَا",63,"ن",3,0],["ما أَحسَنَ الجِيدَ مِن مَلكَةَ وال","لَّبَّاتِ إذ زانَها تَرائِبُها",64,"ب",3,0],["مَا أَحْسَنَ الجَمْعَ بَينَ صِنْوٍ","وَصَنَّوِهِ مِنْ كريمِ جِنْسِ",65,"س",1,0],["مَا أَحْفَلَ الذِّكْرُ بِالمَجْ","دِ حِينَ يَنْشُرُ صُحْفَهْ",66,"ف",2,0],["مَا أَحْسَنَ الشِّعْرَ وَالوِجْدانُ مَصْدَرُهُ","كَأَنَّ هَاتِفَهُ مِنْ نَفْسِهِ هَتفَا",67,"ف",2,0],["مَا أَحْسَنَ الْفَرْعَ يَقُفُو الأَصْلَ مُهْتَدِياً","بِهَدْيِهِ في مَضَاءِ الْعَزْمِ وَالدَّأْبِ",68,"ب",1,0],["مَا أَحْمَدٌ إلاَّ لِوَاءُ بِلاَدِهِ","فِي الشَّرْقِ يَخْفُقُ فَوْقَ كُلِّ لِوَاءِ",69,"ا",2,0],["مَا أَحْسَنَ الأَصْلَ الزَّكِيَّ وَقَدْ نَمَا","مُتَجَدِّداً فِي فرْعِهِ المُخْضَوْضِرِ",70,"ر",1,0],["ما أحلى الوَصْلَ وأَعْذَبهُ","لولا الأيّامُ تُنَكِّدهُ",71,"د",2,0],["ما أَحْسَنَ الدُّنيا بحُسنِهما الّذي","تلتذُّه الأبصارُ والأَسماعُ",72,"ع",1,0],["ما أحزن الورد لم يعرف له عبق","وأضيع الغصن لم يقطف له ثمر",73,"ر",1,0],["ما أَحسَنَ الصِدقَ إِلّا","في قَولِنا عَنهُ هاتا",74,"ت",2,0],["ما أحَيْلى وثوبَه وهْو ماضٍ","يتحدَّى الزمانَ في فَتَكاتهْ",75,"ت",2,0],["ما أحْسَنَ السِينَ وجِيرَانهُ","وأَحْسَنَ الْمُصطَافَ والْمَرْبَعا",76,"ع",2,0],["ما أُحَيْلَى الصبا فهل لمحةٌ من","هُ ومن زهْوهِ ومن ريعانه",77,"ن",2,0],["ما احمرارُ الأصيلِ إلا دماءٌ","بقيتْ في يَدِ السماء شُهودا",78,"د",2,0],["ما أحبَّ التكبيرَ في بُكرةِ العي","د نشيدًا مرتَّلَ الأنغام!",79,"م",1,0],["ما أحرز الفنُّ الرفيعُ تقدمًا","إلا وكان النَّقْدُ من أسبابه",80,"ب",2,0],["ما احتواه في الله شكٌّ، ولا طُو","لُ التَحَرِّي عنه أثَار ارتْيَابه",81,"ب",2,0],["ما أحوجَ الشاعرَ الشاكي لمُغضِبَةٍ","وميزةُ الشاعرِ الحساسِ في الغضبِ",82,"ب",1,1],["ما أحسَنَ الصّبرَ، إلاّ عندَ فُرْقَةِ مَنْ","بِبَثّهِ صِر