{"poems":[[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126725","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45694","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75953","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[5956,"ريثما الموت يجىء","https://www.poetsgate.com/ViewPoem.aspx?id=181921",""]],"verses":[["هنّ مولى الورى بعُرسِ الجوادِ","مَن لهُ في العلاءِ بيض أيادي",0,"د",2,1],["هُنَّ مَدى الدَهر مُرضِعات","يَشتَقن رَيّاً إِلى الفِطام",1,"م",1,0],["هنَّ مِن إِيجادِ ربّي","أنشِئت مِن غَير جِنسِ",2,"س",1,0],["هن مهما شاب الزمان صبايا","راميات بلحظهن سهاما",3,"م",2,0],["هن مع النسر على تدان","تعرفها الاعراب بالظلمان",4,"ن",1,0],["هن من الصورة في بطن اليد","تجعلها الاعراب بعد الأسد",4,"د",1,0],["هنَّ مُلْكُ الغير، مرحى","ما لمخلوق أسيىءُ",5,"ا",1,0]]}