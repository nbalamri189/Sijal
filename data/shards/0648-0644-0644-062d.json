61",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[520,"أرى ابني على ركب الله فيهما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577453",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""],[4222,"أطاع دمعي وصبري في الغرام عصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52816&r=&rc=108",""]],"verses":[["وَلِلحُزنِ ثَوراتٌ تَجورُ عَلى الفَتى","كَما صَرَعَت هامَ الرِجالِ شَمولُ",0,"ل",1,0],["وَلِلحُداةِ عَلى آثارِنا زَجَلٌ","يُغزي المَطايا بِأَجوازِ القَراديدِ",1,"د",1,0],["وَلِلحِلمِ أَوقاتٌ وَلِلجَهلِ مِثلُها","وَلَكِنَّ أَوقاتي إِلى الحِلمِ أَقرَبُ",2,"ب",1,0],["وَللحَجيجِ ضَجيجٌ في جوانِبِهِ","يَقضونَ ما أَوجَبَ الرَّحمَنُ واِفتَرَضا",3,"ض",2,0],["ولَلْحَمْدُ أوْلى بالفَتى منْ ثَرائِهِ","وخَيْرٌ منَ المالِ الثّناءُ المُنَخَّلُ",4,"ل",1,0],["وَلِلحِلمِ أَوقاتٌ وَلِلجَهلِ مِثلُه","وَلَكِنَّ أَوقاتي إِلى الحِلمِ أَقرَبُ",5,"ب",1,0],["وَلِلحائِمِ العَطشانِ رَيٌّ بِريقِها","وَلِلمَرَحِ المُختالِ خَمرٌ وَمُسكِرُ",6,"ر",1,0],["وَلِلحُبِّ آياتٌ تَبَيَّنُ بِالفَتى","شُحوبٌ وَتَعرى مِن يَدَيهِ الأَشاجِعُ",7,"ع",1,0],["وَلِلحُبِّ آياتٌ تُبَيِّنُ لِلفَتى","شُحوباً وَتَعرى مِن يَدَيهِ الأَشاحِمُ",8,"م",1,1],["ولِلْحَقِيقَةِ مِنْهَا السِّرُّ إِنْ نَظَرَتْ","بَدَا لَهَا الشَّفْعُ وِتْراً عِنْدَمَا حَكَمَتْ",9,"ت",1,0],["وَلِلحَوادِثِ سلوانٌ يُهوّنُها","وَما لِما حَلَّ بِالإِسلامِ سلوانُ",10,"ن",1,0],["وَلِلْحَيَاءِ شُعَاعٌ","يَغُضُّ عَنْهَا الْجُفُونَا",11,"ن",2,0],["وللحرب صفّ من سطورٍ كأنها","حديدٌ يسوق الناكثين إلى الحشر",12,"ر",1,0],["وللحظ منه سنّةٌ عربيَّة","ألم تره في الحربِ قد كسَّر الجفنا",13,"ن",2,0],["وَلِلحَقِّ فينا خِصلَتانِ فَمِنهُما","ذَلولٌ وَأُخرى صَعبَةٌ لِلمَظالِمِ",14,"م",1,0],["وللحزن دمع في الماصب كلاهما","إذا كبرت ويلاته غير نافذ",15,"ذ",1,0],["وللحر آلام كثار وانما","على قدر الاحساس يأتي التألم",16,"م",1,0],["وَلِلحُرِّيَّةِ الحَمراءِ بابٌ","بِكُلِّ يَدٍ مُضَرَّجَةٍ يُدَقُّ",17,"ق",1,0],["وَلِلحُسّادِ عُذرٌ أَن يَشِحّوا","عَلى نَظَري إِلَيهِ وَأَن يَذوبوا",18,"ب",3,0],["وللحقيقةِ سِرٌّ لا يباحُ به","أضحى له الناسُ في بَهماءَ سَبروتِ",19,"ت",1,0],["وَلِلحَوادِثِ ساعاتٌ مُصَرَفَةٌ","فيهِنَّ لِلحَينِ إِدناءٌ وَإِقصاءُ",20,"ا",2,0],["وَلِلحَقِّ أَهلٌ لَيسَ تَخفى وُجوهُهُم","يَخِفُّ عَلَيهِم حَيثُ ما كانَ حَملُهُ",21,"ل",2,0],["وَلِلحَقِّ بُرهانٌ وَلِلمَوتِ فِكرَةٌ","وَمُعتَبَرٌ لِلعالَمينَ قَديمُ",22,"م",1,0],["وَلِلحِسابِ مَوقِفٌ","أَهوالُهُ تُرَوِّعُك",23,"ك",1,0],["وَلِلحَيِّ قَيسٍ نَفحَةٌ مِن سِجالِها","وَقَحطانَ وَالغُرِّ الطَوالِ بَني بَكرِ",24,"ر",1,0],["وَلِلحَنينِ بِقَلبي","مَحَلَّةٌ وَمَقيلُ",25,"ل",1,0],["وَلِلحُبِّ حُمّى تَعتَريني بِزَفرَةٍ","لَها في عِظامي نافِضٌ بَعدَ صالِبِ",26,"ب",1,0],["وَلِلحارِثِ الجَفنِيَّ سَيِّدِ قَومِهِ","لَيَلتَمِسَن بِالجَيشِ دارَ المُحارِبِ",27,"ب",1,0],["وَلِلحَقودِ عَلاماتٌ يَبِنُّ بِها","كَما رَأَيتَ بِشَدقِ الهادِرِ الزَبَدا",28,"د",2,0],["وَلِلحَيِّ رِزقٌ مِمّا أَتاهُ بِسَعيهِ","وَعَقلٌ وَلَكِن لَيسَ يَنفَعُهُ العَقلُ",29,"ل",1,0],["وللحَسَنِ الحُسْنى وإن جاد غيرُه","فذلكَ جُودٌ ليس بالمُتَعَمَّدِ",30,"د",1,0],["وَلِلْحِجارَةِ أَهْزَاجٌ إِذَا نَطَقَتْ","أَجابَها مِنْ طُيُورِ البَرِّ ناقرُهُ",31,"ر",2,0],["وَللحياة نواميس ملازمة","وَيل لِمَن هُوَ عنها كانَ ينحرف",32,"ف",1,0],["ولِلْحُدَاةِ عَلَى آثَارِهِمْ زَجَلٌ","ولِلسَّرَابِ عَلَى الحِزَّانِ تَبْغِيلُ",33,"ل",1,0],["وللحق أعناق البغاة خواضع","واذرعهم في بطشهن معاصم",34,"م",1,0],["وللحوادثِ سُلوانٌ يُسهلها","وما لمَا حل بالإسلام سُلوانُ",35,"ن",1,0],["وَللحَقّ أحْياناً، لَعَمري، مَرارَة ٌ،","وكل الذي دون الممات قليل",36,"ل",1,0],["وللحزنِ هزّاتٌ وللأُنْسِ مِثْلُها","يُخالِفُ بعضٌ بَعْضَها ويُناصر",37,"ر",1,0],["وللحبيب التعالي","وغن عرفناه جارا",38,"ر",2,0],["وَلِلحَينِ أَنّى ساقَني فَأَتاحَني","لِأَحبُلِها مِن بَينِ مُثرٍ وَمُعدِمِ",39,"م",1,0],["وَلِلحَمِيَّةِ لا عَن زِلَّةٍ حَكَمَت","بِالبُعدِ فارَقتُ أَخداناً وَخُلّانا",40,"ن",2,0],["وَلِلحالِ عُذرٌ لا يَزالُ يُنَهنِهُ","بِمَدحِ رَسولِ اللَهِ أَهدي وَأَهتَدي",41,"ي",1,0],["وَلِلحَقِّ وَالتَحقيقِ مِن غَيرِ شُبهَةٍ","وَلَمّا تَناهى طيبُ طَعمٍ وَنَكهَةٍ",42,"ه",1,0],["وَلِلحَقّ بُرهانٌ وَلِلرُشدِ مَنهَجُ","أَنافَ بِهِ فَوقَ السماكِ مَحَلُّنا",43,"ن",2,0],["وللحظ إن يسعف لسان ذليقة","يبن بها في النطق عربا أعاجمه",44,"م",2,0],["وللحب سلطان على كل قادر","ولو انه الملك الذي لا يغالب",45,"ب",1,0],["وَلِلحُجّابِ وَهمٌ غَيرُ هَذا","وَلِلأَوهامِ في الأَذهانِ فِعلُ",46,"ل",1,0],["وَلِلحَظ مَعنىً يَفهَمُ القَلبُ سرَّهُ","وَإِن لَم يُمط لَحظُ العُيونِ سِتارَهْ",47,"ر",2,0],["وَلِلحُبِّ ما بَينَ النُفوسِ مسالكٌ","طَوَت دونَ إِدراك الجُسوم اِختِبارَهْ",47,"ر",2,0],["وللحقّ مستنبط واحدٌ","وكل يرى الحقّ في مذهبه",48,"ب",2,0],["وَلِلحَياةِ وُجودٌ في جَوارِحِهِ","وَلِلوَسامَةِ ذَوبٌ في مَآقيهِ",49,"ي",2,0],["وللحسناءِ آمالٌ وماذا","يؤملُ في السما غيرُ المحالِ",50,"ل",1,0],["وللحنيفية السمحا اقام إلى","ان اصبحت لا بها زيغ ولا ميل",51,"ل",1,0],["وللحوادثِ غَفْلات ظَفْرنَ بها","يَلُفّنا الشوقُ أحياناً فنأتَلِفُ",52,"ف",1,0],["وَلِلحَفيف","همسٌ لَطيف",53,"ف",1,0],["وَلِلحَمَأ الغالي نَشيشٌ وَرَغوَةٌ","كَأَنَّ الوَرى مُستَنقَعٌ يَتَنَهَّدُ",54,"د",1,0],["وَلِلحُرِّ آمالٌ يَراها مشاهداً","تريه بِأُمِّ العَينِ أَنكى المَشاهِدِ",55,"د",1,0],["وللحلمِ يومَ البطش منّي حَمِيّةٌ","وللحِفْظ يوم الغَدْرِ فيّ تَغضُّب",56,"ب",1,0],["وللحزنِ والحبِّ أعذَبُ صوتٍ","وأرفَعُ شعرٍ وأقوى كلام",57,"م",1,0],["ولِلْحَظِّ لحْظٌ كَلَّ دُونَي خَاسِئاً","كَأني وإياهُ شُعَاعٌ وأرْمَدُ",58,"د",1,0],["وللحرمين الأكرمين سؤالنا","من اللَه أمناً شاملاً للمظاهر",59,"ر",1,0],["وللحوت بل للدود في العود بل لما","سوى ذاك أفلاك عليها أديرت",60,"ت",1,0],["وَلِلحليِ وَسواسٌ عَلَيها إِذا مَشَت","كَما اِهتَزَّ في ريحٍ مِنَ الصَيفِ عَشرِقُ",61,"ق",1,0],["وللحسنِ في خديهِ شمسٌ مقيمةٌ","وبدرُ كمالٍ لا يحورُ إلى محقِ",62,"ق",1,0],["وللحربِ عن أنيابِها الرُّوقِ كَشْرةٌ","إذا الطّعْنُ أَضحَى للجُنوبِ مُدغْدِغا",63,"غ",2,0],["وَلِلحُمقِ يا فِرعَونُ فيها مَآرِبٌ","إِذا ما طَفى فِرعَونُهُ وَتَعَظَّما",64,"م",2,0],["وللحبِّ غاياتٌ وأصعَبُها الرَّدى","وقَد صارَ عِندي عندَما نالَني سَهلا",65,"ل",2,0],["وللحبِّ منِّي ما أمِنتُ خيانةً","مَحَلَّةُ قلبٍ قلَّما يتقلَّبُ",66,"ب",1,0],["وللحِبِّ سُلْطانٌ وللعِشْقِ لَوْعَةٌ","بَلى كُلُّ عُمْرِ العاشقينَ وُلوعُ",67,"ع",1,0],["وللحبِّ استمعنا إذ","غدا مولاه مولانا",68,"ن",2,0],["وللحسن الفضل الذي هو كاسمه","وما كل أسماء الرجال سمات",69,"ت",1,0],["وللحجر المعروف قام استلامنا","مقام عهود في حقوق لوازب",70,"ب",1,0],["وللحوائجِ أوقاتٌ بها ارتُهِنَتْ","كأنفُسِ النَّاسِ للآجالِ ترتَصِدُ",71,"د",1,0],["وللحسين بعده إعظاما","والحق لو كان له فقاما",72,"م",2,0],["وللحروب مدى الازمان عاقبة","تملا النفوس باحزان واشجان",73,"ن",1,0],["وللحُتُوفِ تُربِّي كلُّ مُرضِعَةٍ","وللحِسَابِ بَرَى الأروَاحَ باريها",74,"ي",3,0],["وَللحق في الأحكام أَنتَ مؤيد","وَأَنتَ لكل الطَيبات فَعول",75,"ل",1,0],["وللحَواجِبِ أفواهٌ تُكلِّمُنا","تُثِيرُ بالقَلْبِ أنواعاً من الفرَحِ",76,"ح",1,0],["وللحمَى وبنيه لا لأنفسِكم","تكاثرون بأشياعٍ وأنصار",77,"ر",1,0],["وللحسن الزكي أبيه قالوا","سمي أبيك زاد المجد مجدا",78,"د",2,0],["(وَلِلْحُرِّيَّةِ «السَّوْدَاءِ» بَابٌ)","مِنَ البُرْكانِ يَعْصِفُ بِالعِراقِ",79,"ق",1,0],["وَلِلْحُبِّ رَهْطٌ لاَ يُمَاثِلُهُ رَهْطُ","تَمَادَى عَلى الْهِجْرَانِ مِنْ غَيْرِ عَادَةِ",80,"ه",1,0],["وللحرَادي مياه طاب مشربهُا","يود لو أنَّ تيموراً إليه نحا",81,"ح",2,0],["وللحفظ آيات وقطع لبلغم","وترك المعاصي والمحبة أجمعُ",82,"ع",1,0],["وللحليم المستشار هفوهْ","والكاملُ المولى الشديد القوّهْ",83,"و",2,0],["وَللحال بَعد الحالِ يَركَبُها الفَتى","وَللحُبِّ بعد السَّلوَةِ المُتَمَرِّدِ",84,"د",1,0],["وللّحَاظِ بِجَفْنَيْ مَنْ قُتِلْتُ بِهِ","صَحَائِفٌ سُطِّرَتْ فِيهَا المَنِيَّاتُ",85,"ت",1,0],["وَلِلَحْظِهِ بِيضُ الظُّبَي انْتَسَبَتْ كَمَا","لِقَوَامِهِ سُمْرُ الْعَوَالِي تُنْسَبُ",86,"ب",1,0]