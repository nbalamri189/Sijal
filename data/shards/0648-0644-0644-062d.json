",1,1],["وللحرب ما طالتْ على الناس آخر","وليس لحرب اللؤم والمجد آخرُ",113,"ر",1,0],["وللحب حالات تدل على الجوى","وتنبى عن العشاق حين تبين",114,"ن",1,0],["وللحسن معنى غير قد مهفهف","وغير شفاه عذبة حلوة لعس",115,"س",1,0],["وللحب طعم دائما متغير","فكم فيه من حلو وكم فيه من مرّ",116,"ر",1,0],["وللحب ألوان فمنه الهوى الذي","يكون غريزيا ومنه الهوى العذري",116,"ر",2,0],["وللحب أشكال سوى حب غادة","وفن وأوطان ومؤتلق التبر",116,"ر",1,0],["وَلِلْحَبَابِ على سُقْمَى جَدَاوِلِهَا","لسَّيْفِ والعِقْدِ نَضَّاءٌ وَنَضَّادُ",117,"د",1,0],["وللحسن الحسنى فإن جاد غيره","فذلك جود لا يبل لدى الخال",118,"ل",1,0],["ولِلحَمائِمِ أَلْحانٌ تُذَكِّرُنا","أَحْبابَنا بَيْنَ أَرْمالٍ وأَهْزاجِ",119,"ج",1,0],["وللحسن منها إن سرت فيه رونق","كأن به ماء الحياة ترقرقا",120,"ق",2,0],["وَلَلحارِثُ الجَفنِيُّ أَعلَمُ بِالَّذي","يَبوءُ به النُعمانُ إِن جَفَّ طائِرُه",121,"ر",2,0],["وَلَلْحُلمُ خَيرٌ فَاِعْلَمَنَّ مَغَبَّةً","مِنَ الجَهلِ إِلَّا أَن تشمسَ مِن ظُلْمِ",122,"م",1,0],["وللحية الرقشاء وشي ولولنها","عجيب وتحت الوشي سم مركب",123,"ب",1,0],["وللحرب فابعثها ضوابح إن جرت","بفرسانها مثل الرياح الهواجم",124,"م",1,0],["وَللحقوق يَدٌ يا طالما بُسطت","تَرجو معزّاً لَكي تَحظى بمنعته",125,"ت",2,0],["وللحسن الذي فيها","سنحيي الآن ذكراها",126,"ه",2,0],["وَلِلْحُسْنِ مَعْنىً واضِحٌ مِنْ جَبينِهِ","وَفِي خَصْرِهِ مَعْنىً دَقِيقُ خَفِيّهِ",127,"ي",2,0],["وللحمام أغاريد كما اختلفت","ورق الحمائم بالنوح الغراميّ",128,"ي",1,0],["ولِلحَوَافِزِ وَقعٌ والنعالُ لَها","خَفقٌ يُفَتِّتُ جِسمَ الجَلمَدِ الأَجَد",129,"د",1,0],["وَللحر ان كانوا كَذلك خجلة","من العفو أَنكى من عقاب المعاقب",130,"ب",1,0],["وللحرب سيف مصلت فوق رأسه","ودون امانيه تكاد المكائد",131,"د",1,0],["وللحقيقةِ حامِ","وللدنيّةِ ماحِ",132,"ح",1,0],["وللحمام حاءات إذا ما","ظفرت بها عثرت على النعيم",133,"م",1,1],["وللحلق الحديدة حين تنمى","وأطيبها حديث أخ كريم",133,"م",1,0],["وللحزن ما بين الضولع توقدٌ","وللدمع في صحن الخدود تَدَفُّق",134,"ق",1,0],["وللحَجَر السامي يمينك لامست","بأنملةٍ تخضرُّ منها الجلامد",135,"د",1,0],["ولِلحُلمِ مِن بَعدها خامسٌ","سَتَبدُو