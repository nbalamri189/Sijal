{"poems":[[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62462","الكامل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105387","الرمل"],[3523,"","https://poetry.dctabudhabi.ae/diwan/poem/131356","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126950","المديد"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108348",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139704",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""]],"verses":[["بِحِشمَتٍ وَعَلِيٍّ","أَبي الفُتوحِ وَحِفني",0,"ن",2,0],["بحشاي فيه مَهاة رم","لٍ لا تزور ولا تزارْ",1,"ر",1,0],["بحشاه لعبت أيدي الهوى","فغدا في طاعة الشوق وراحا",2,"ح",2,0],["بحشاه نار الشوق تنحل جسمه","ويكاد يدخل ملحد الأرماس",3,"س",1,0],["بحشا العشاق مسكنه","حببا يرعى من المهج",4,"ج",1,0],["بحشمة من يحوي به حسن خيمة","وشيمة نفس مثل زهر منمق",5,"ق",1,0],["بحشاه كم أجج الحزنُ وقداً","ومن العين كم أفاض نجيعا",6,"ع",2,0],["بحشري كن شفيعاً بي","وأنقذ من لك انتسبا",7,"ب",2,0]]}