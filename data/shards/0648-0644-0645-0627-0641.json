{"poems":[[93,"أقص عليكم ما جرى لي بالأمس","https://www.aldiwan.net/poem8975.html","عموديه"],[94,"غناه الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[45,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[52,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30495","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[92,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[136,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[136,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[234,"وسرب من الآنسات الحسان","https://www.aldiwan.net/poem51144.html","المتقارب"],[234,"ولما فاح لي نشر ذكي","https://www.aldiwan.net/poem51159.html","الوافر"],[240,"عليل الشوق فيك متى يصح","https://www.aldiwan.net/poem32107.html","الوافر"],[242,"إني سألتك بخير مرسل","https://www.aldiwan.net/poem18868.html","الرجز"],[354,"تغربت عن أهلي إليكم فكنتم","https://www.aldiwan.net/poem15541.html","الطويل"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[406,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[422,"على أي وجد طويت الضلوعا","https://www.aldiwan.net/poem53848.html","المتقارب"],[422,"مضى سيد من غر أبناء هاشم","https://www.aldiwan.net/poem54067.html","الطويل"],[427,"تملكتموا عقلي وطرفي ومسمعي","https://www.aldiwan.net/poem46401.html","الطويل"],[449,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[556,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[580,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122577","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69174","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117408","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112823","الرمل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113986","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125428","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27266","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137441",""],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116501","البسيط"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99544","الوافر"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/140124",""],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127015","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35621","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111417","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70133","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86398","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94629","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94573","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94541","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94422","الوافر"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123459","الوافر"],[4691,"حافظ القرآن الماجن","https://www.poetsgate.com/ViewPoem.aspx?id=174368",""],[4705,"ألا ما لشمل المجد أضحى مبددا","https://www.poetsgate.com/ViewPoem.aspx?id=127732",""],[5246,"تقلب الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=187046",""],[592,"اتاني تكتاب من صفى وذي ود","https://www.poetsgate.com/ViewPoem.aspx?id=128844",""],[427,"تملَّكتموا عقلي وطرفي ومسمَعي","https://www.poetsgate.com/ViewPoem.aspx?id=103579",""],[5402,"أساهِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=215712",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[1078,"خرجنا لنستقي بيوم تراكمت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=611786",""]],"verses":[["وَلَمّا فَتَحتُ البابَ أَبصَرتُ راهِباً","وَلَو كُنتُ طِفلاً قُلتُ غولٌ مِنَ الإِنسِ",0,"س",1,0],["ولَما فاضَتْ بالشِّعْرِ الح","يِّ مَشَاعِرهُ وقَصَائِدُهُ",1,"د",2,0],["وَلَمّا فَقَدنا مِثلَهُ دامَ كَشفُنا","عَلَيهِ فَدامَ الفَقدُ وَاِنكَشَفَ الكَشفُ",2,"ف",1,0],["وَلَمّا فارَقَتنا أُمُّ بَكرٍ","وَشَطَّت غُربَةً بَعدَ اِكتِئابِ",3,"ب",1,0],["ولمّا فَشا بِالدَّمْعِ مِنْ سِرِّ وجْدِنا","إِلى كاشحِينا ما القُلُوبُ كواتِمُ",4,"م",1,0],["ولما فارق ظهر الجمل","أنا لو خيرت لاخترت الخفا",5,"ف",2,0],["ولمَّا فَطَنتُ على حالة","تَليقُ بمنتحِرٍ مُحرِب..",6,"ب",1,0],["ولم أفضح بفاحشة تؤدى","إلى سجن أهان به زمانا",7,"ن",2,0],["ولم افخر وقد علمت أناس","قبيحى ما استكن وما استبانا",7,"ن",2,0],["ولَم أفرَح لِسَّرَاءَ اعتَرَتني","فَتَيلِكَ شِيمَةُ اللَّحزِ الجَبَانِ",8,"ن",1,0],["ولمّا فَتَرن بألحاظهنْ","نَ أَنشَبنْ نُشَّابَها في الكُبُودِ",9,"د",1,0],["ولمَّا فاح لي نَشْرٌ ذَكِيٌّ","من الخَوْخ المشَّبِه بالخدودِ",10,"د",1,1],["وَلَمّا فَلَّ جَيشَ الشَوقِ صَبري","وَعادَ رَذاذُ دَمعي وَهوَ سَحُّ",11,"ح",1,0],["وَلَمْ أُفَارِقْ حِلْيَةَ التَّذَلُّلِ","إِلاَّ خَصَصْتَنِي بِفَضْلٍ مُجْزِلِ",12,"ل",1,0],["وَلَم أَفقِدِ الأَوطانَ حَتّى رَحَلتُم","وَدَجتُم لِنَفسي غُربَةً مَعَ غُربَتي",13,"ت",2,0],["وَلِما فيهِ لِقَلبي شَفَّني","مَن لَمى فيهِ شِفاءٌ وَدُوَي",14,"ي",1,0],["ولم أفتح لها أبوابَ وهمٍ","ولم أجلبْ لها فكراً دَخيلا",15,"ل",2,0],["ولما فَقَدْتَ حبيبَ الفؤاد","غداة الغميم فقدت الهجوعا",16,"ع",2,0],["ولمَّا فقدناه بكينا لفقده","وقد عزَّ من يُبكى عليه ويفقدُ",17,"د",1,0],["ولمّا فنى صبري وقلَّ تجلُّدي","وفارَقتني نومي وحُرِّمَت مضجعي",18,"ع",2,0],["ولم أفز من حسنه","إلا بشبه اللمحة",19,"ه",1,0],["ولمّا فَضلت جميع الملوك","دَعَوناك فينا همام الهمامِ",20,"م",1,0],["ولم أُفن بالتقبيل وردةَ خدِّه","ولكن بها أَفْنَيْتُ حِنَّاءَ كَفِّه",21,"ف",2,0],["ولما فاخرَت بحاتِمها طيٌّ","ولا شاجعَت بعمروٍ زُبيد",22,"د",1,0],["ولمْ أفلسِفْ خنوعي","كيفَ الخنوعُ يُفلّسَفْ",23,"ف",1,0],["وَلَم أُفشِ سِرّاً كانَ بَيني وَبينَه","وَللسرّ راعٍ حافِظٌ وَرَقيبُ",24,"ب",1,0],["ولما فاضَ جودكم وفاقت","مكارمُكم بكثرتها السحابا",25,"ب",2,1],["ولما فيه عيايا شاهدوا","رفع قدر لم يروه في أحد",26,"د",1,0],["وَلَم أُفَارِق وَطَنِي مِنَ الوَهَل","وَلا المُعَاصَاةِ وَلا وَهيِ الرَّهَل",27,"ل",1,0],["ولَم أُفحِمِ الخنذيذَ في يومِ مجلسٍ","منَ الناسِ مشهودٍ وما كان مفحَما",28,"م",2,0],["ولما فاق حُسنُكِ كلَّ حُسنِ","تمنَّت كلُّ عينٍ أن تراكِ",29,"ك",1,0],["ولما فاح زهري هبّ سري","على نوري فصيَّره هشيما",30,"م",2,0],["ولما فنى دمعي لطول انسكابه","بكيت دما حتى بللت به الثرى",31,"ر",2,0],["ولم افصل كفاني قول ذي عجز","الكون فيه وفوق الكون قد فضلا",32,"ل",2,0],["ولم أفقد به ثوباً ولكن","دخلت محمداً وخرجت بشرا",33,"ر",2,0],["ولم أفتن بقرب من حبيب","ولم أحزن لبين من سعاد",34,"د",1,0],["ولما فوقت ايدي المنايا","له سهما بكف أولي الشقاق",35,"ق",1,0],["ولما فتحت أبواب النا","ر إذاً ولما كانت تسعر",36,"ر",1,0],["وَلمّا فَضَضت الخَتمَ عَنهُ تَضوّعَت","لَطيمة سَفر فضّ عَن مِسكِها الخَتمُ",37,"م",1,0],["ولمَّا فَرَاها تِسعَةً صارَ صَخرةٌ","بِحِكمَةِ مُبدِيها استَتَبَّ جُمُودُها",38,"د",3,0],["وَلَمّا في التَجلي ارّخوهُ","بَدا رَقمي لِفضل اللَهِ شُكري",39,"ر",2,0],["ولما فاح خالك وهو مسك","علمنا حق ندك كان عاجا",40,"ج",2,0],["وَلَم أَفه لِذَوى رد لِمَعرِفَتي","اِنَّ الحَبيب حَبيب في المَسَرّات",41,"ت",1,0],["ولما فاق في هذين شهمٌ","فريدٌ في المحامد والخلالِ",42,"ل",1,0],["ولما في المُنى وافى سفيراً","أجبتُ فعم صباحاً يا سفيري",43,"ر",2,0],["ولما في سما لبنان ذرَّت","شوارقهُ لقد خُلعَ الحدادُ",44,"د",1,0],["ولما فقتَ في الإنصاف عدلاً","وَفزتَ بسبق مضمار السياسه",45,"س",2,0],["ولم أفتَن بقُربٍ من رُوَيْمٍ","ولم أحزَنْ لبيْنٍ من سُعادِ",46,"د",1,0],["ولم أفخرْ عليهِ وفيه نقصٌ","وفي طبعي اعتدالٌ واستواءُ",47,"ا",2,0],["ولما فقدت القرم من آل هاشم","تقرح قلبي للمكارم والندى",48,"د",2,0],["ولم أفتقدْ يوماً نقيقَ ضفادعٍ","شجاها خريرُ الماءِ في جدولِ النهر",49,"ر",1,0],["ولما فضضت الختم أبصرت طيه","بديعاً أنيقاً بالبلاغة مستبد",50,"د",1,0],["ولمّا فنى صبري وقلَّ تجلُّدي","وفارَقني نومي وحُرِّمَت مضجعي",51,"ع",2,0],["ولمّا فاض شوقي فارقتني","وصارَ الدّمعُ من عيني يَسيلُ",52,"ل",1,0],["ولما فز العليا أرانا","يد البغضا ووجه المستهين",53,"ن",1,0],["ولما فاز بالنعمى لقانا","عبوس الوجه مقتضب الجبن",53,"ن",1,0],["ولما فرغنا من صلاة وبالدعا","شرعنا تسري الغيم اذ شح بالسح",54,"ح",1,0]]}