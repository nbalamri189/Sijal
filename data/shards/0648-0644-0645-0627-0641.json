{"poems":[[91,"أقص عليكم ما جرى لي بالأمس","https://www.aldiwan.net/poem8975.html","عموديه"],[92,"غناه الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30495","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[130,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[130,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[227,"وسرب من الآنسات الحسان","https://www.aldiwan.net/poem51144.html","المتقارب"],[227,"ولما فاح لي نشر ذكي","https://www.aldiwan.net/poem51159.html","الوافر"],[233,"عليل الشوق فيك متى يصح","https://www.aldiwan.net/poem32107.html","الوافر"],[235,"إني سألتك بخير مرسل","https://www.aldiwan.net/poem18868.html","الرجز"],[347,"تغربت عن أهلي إليكم فكنتم","https://www.aldiwan.net/poem15541.html","الطويل"],[347,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[397,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[413,"على أي وجد طويت الضلوعا","https://www.aldiwan.net/poem53848.html","المتقارب"],[413,"مضى سيد من غر أبناء هاشم","https://www.aldiwan.net/poem54067.html","الطويل"],[418,"تملكتموا عقلي وطرفي ومسمعي","https://www.aldiwan.net/poem46401.html","الطويل"],[441,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[549,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[573,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"]],"verses":[["وَلَمّا فَتَحتُ البابَ أَبصَرتُ راهِباً","وَلَو كُنتُ طِفلاً قُلتُ غولٌ مِنَ الإِنسِ",0,"س",1,0],["ولَما فاضَتْ بالشِّعْرِ الح","يِّ مَشَاعِرهُ وقَصَائِدُهُ",1,"د",2,0],["وَلَمّا فَقَدنا مِثلَهُ دامَ كَشفُنا","عَلَيهِ فَدامَ الفَقدُ وَاِنكَشَفَ الكَشفُ",2,"ف",1,0],["وَلَمّا فارَقَتنا أُمُّ بَكرٍ","وَشَطَّت غُربَةً بَعدَ اِكتِئابِ",3,"ب",1,0],["ولمّا فَشا بِالدَّمْعِ مِنْ سِرِّ وجْدِنا","إِلى كاشحِينا ما القُلُوبُ كواتِمُ",4,"م",1,0],["ولما فارق ظهر الجمل","أنا لو خيرت لاخترت الخفا",5,"ف",2,0],["ولمَّا فَطَنتُ على حالة","تَليقُ بمنتحِرٍ مُحرِب..",6,"ب",1,0],["ولم أفضح بفاحشة تؤدى","إلى سجن أهان به زمانا",7,"ن",2,0],["ولم افخر وقد علمت أناس","قبيحى ما استكن وما استبانا",7,"ن",2,0],["ولَم أفرَح لِسَّرَاءَ اعتَرَتني","فَتَيلِكَ شِيمَةُ اللَّحزِ الجَبَانِ",8,"ن",1,0],["ولمّا فَتَرن بألحاظهنْ","نَ أَنشَبنْ نُشَّابَها في الكُبُودِ",9,"د",1,0],["ولمَّا فاح لي نَشْرٌ ذَكِيٌّ","من الخَوْخ المشَّبِه بالخدودِ",10,"د",1,1],["وَلَمّا فَلَّ جَيشَ الشَوقِ صَبري","وَعادَ رَذاذُ دَمعي وَهوَ سَحُّ",11,"ح",1,0],["وَلَمْ أُفَارِقْ حِلْيَةَ التَّذَلُّلِ","إِلاَّ خَصَصْتَنِي بِفَضْلٍ مُجْزِلِ",12,"ل",1,0],["وَلَم أَفقِدِ الأَوطانَ حَتّى رَحَلتُم","وَدَجتُم لِنَفسي غُربَةً مَعَ غُربَتي",13,"ت",2,0],["وَلِما فيهِ لِقَلبي شَفَّني","مَن لَمى فيهِ شِفاءٌ وَدُوَي",14,"ي",1,0],["ولم أفتح لها أبوابَ وهمٍ","ولم أجلبْ لها فكراً دَخيلا",15,"ل",2,0],["ولما فَقَدْتَ حبيبَ الفؤاد","غداة الغميم فقدت الهجوعا",16,"ع",2,0],["ولمَّا فقدناه بكينا لفقده","وقد عزَّ من يُبكى عليه ويفقدُ",17,"د",1,0],["ولمّا فنى صبري وقلَّ تجلُّدي","وفارَقتني نومي وحُرِّمَت مضجعي",18,"ع",2,0],["ولم أفز من حسنه","إلا بشبه اللمحة",19,"ه",1,0],["ولمّا فَضلت جميع الملوك","دَعَوناك فينا همام الهمامِ",20,"م",1,0],["ولم أُفن بالتقبيل وردةَ خدِّه","ولكن بها أَفْنَيْتُ حِنَّاءَ كَفِّه",21,"ف",2,0]]}