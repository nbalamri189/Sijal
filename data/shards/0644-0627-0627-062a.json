{"poems":[[55,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[55,"يا ريم ذا الأجرع يرعى به","https://www.aldiwan.net/poem30716.html","السريع"],[79,"كل جار لغاية مرجوه","https://www.aldiwan.net/poem35837.html","الخفيف"],[73,"قدر متاح نظرة أرسلتها","https://www.aldiwan.net/poem3882.html","الكامل"],[74,"لا أترك الحب والعذال وعاظ","https://www.aldiwan.net/poem19156.html","البسيط"],[58,"يا كثير الدل والغنج","https://www.aldiwan.net/poem58472.html","المديد"],[47,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[54,"دعني فما طاعة العذال من ديني","https://www.aldiwan.net/poem26610.html","البسيط"],[52,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[47,"أرَيْتُكَ الآنَ ألَمْعُ البُرُوقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32839",""],[240,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[358,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[371,"فلا أهز رجالا لا اهتزاز لهم","https://www.aldiwan.net/poem17364.html","البسيط"],[371,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[435,"يا ظبية البان بين الرند والخزم","https://www.aldiwan.net/poem41405.html","البسيط"],[471,"أمسى الشباب مودعا محمودا","https://www.aldiwan.net/poem50445.html","الكامل"],[534,"لا أترك الإلحاحا","https://www.aldiwan.net/poem37470.html","مجزوء الرجز"],[563,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202805","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91142","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34548","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86509","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120365","الكامل"],[4767,"قمم","https://www.poetsgate.com/ViewPoem.aspx?id=178391",""],[4830,"حديث القافية","https://www.poetsgate.com/ViewPoem.aspx?id=202140",""],[4988,"إسكني في قلب مآا يعرف يخون","https://www.poetsgate.com/ViewPoem.aspx?id=145813",""],[5081,"دَعْنِي أُلَمْلِمُ مِنْكَ مَا تَتَأَسَّفُ","https://www.poetsgate.com/ViewPoem.aspx?id=190245",""],[5225,"سدتنا وأنت الذي منا","https://www.poetsgate.com/ViewPoem.aspx?id=27614",""],[5431,"لاأبعدَ الله من في حبهم صدقوا","https://www.poetsgate.com/ViewPoem.aspx?id=197622",""],[5956,"أحس عينيها تقولان لي:‏","https://www.poetsgate.com/ViewPoem.aspx?id=182192",""],[5956,"تركتُ البِيدَ عكس ما توخيت","https://www.poetsgate.com/ViewPoem.aspx?id=183701",""],[5956,"لِمَ عدت يا غالي لشعري؟","https://www.poetsgate.com/ViewPoem.aspx?id=193691",""],[6031,"نَصَحْتَ للَّهِ فلاَ تَتَّهِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46350",""],[6142,"الله ما أسناك يا كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=155677",""],[6201,"كينونة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87476&r=&rc=0",""],[6202,"القتل فيكم قد وجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86743&r=&rc=44",""],[6202,"يا مصر لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86769&r=&rc=70",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[463,"بكرتْ هيماً تحلُّ الرَّبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60115&r=&rc=171",""]],"verses":[["لا أَتَّقي طَعنَ الخُطوبِ إِذا","لا قَيتُها وَرِضاكَ مِن جُنَني",0,"ن",2,0],["لا أَتبَعُ القَلبَ إِلى غَيرِكُم","عَيني لَكُم عَينٌ عَلى قَلبي",1,"ب",2,0],["لا اتِّباعاً ولا اخْتِراعاً أرَتْنا","إذْ نظَرْنا عَروسُكَ المَجْلوَّهْ",2,"و",2,0],["لا أَتَّقي فيهِ الملامَ لِأَنَّني","أَخفَيتُهُ في القَلبِ عَن لُوّامي",3,"م",2,0],["لا أترك الحبّ والعذَّال وعَّاظ","ما دام في حفظه للقوم إحفاظ",4,"ظ",1,1],["لا أَتَاحَ اللّهُ ليْ فَرَجاً","يومَ أَدْعُو منكَ بالفَرَجِ",5,"ج",1,0],["لا أَتبَعُ الطَمَعَ القَليلَ وَلا أُرى","شَرِهاً إِلى الأَمَلِ الضَعيفِ الكاذِبِ",6,"ب",1,0],["لا أُتبِعُ المَتبولَ عَتباً وَلا","أَلومُ غَيرَ البارِئِ المُستَفيق",7,"ق",1,0],["لا أَتَّقي الراحَ بِالنُدمانِ مِن يَدِهِ","وَإِن سَقَتنِيَ حَولاً قُلتُ زيديني",8,"ن",2,0],["لا أَتَّقي حَسَدَ الضَغي","نِ وَلا أُخَوَّفُ صَوتَ راعِد",9,"د",1,0],["لا أُتْبعُ المتْبُولَ عَتْباً، وَلاَ","ألُومُ غَيرَ البَارِىءِ المُسْتَفيقْ",10,"ق",1,0],["لا أَتاحَ اللَهُ لي وَص","لَكَ إِن أَضمَرتُ سَلوَه",11,"و",2,0],["لا أَتّقي مِنكَ غَير الصَدّ مُنتَبِذاً","عَهد الهَوى وَزِمامَ الودّ مطّرحا",12,"ح",2,0],["لا أَتَّقي اِمرَأَةً في كَفِّهِ اِمرَأَةٌ","لِلسَيفِ بَل رَجُلاً يَسطو بِهِ رَجُلا",13,"ل",2,0],["لا أَتَّقي الإِثمَ في تَحذيرِ قَصدِهِمُ","بَل لا أُؤَمِّلُهُ في جُملَةِ القُرَبِ",14,"ب",1,0],["لا أَتَّضِع إِلَيهِ","حَتَى يَلينَ لِضِرسِ الماضِغِ الحَجَرُ",15,"ر",1,1],["لا اتقي الله في صب اخي وصب","لم يشفه غير لثم القرط والخزم",16,"م",1,0],["لا أَتَّقي حَسَكَ الضَغائِنِ بِالرُقى","فِعلَ الذَليلِ وَإِن بَقيتُ وَحيدا",17,"د",2,0],["لا أَتْركُ الإلْحاحا","مَسائِيَ والصَّباحا",18,"ح",2,1],["لا اتعاظ ولا اعتبار بشيءٍ","عندهم في شهادة ومغيب",19,"ب",1,0],["لا أتبْعُ الأوشالَ من بعدما","رأيتُ هذا العَارضَ المُسْبلا",20,"ل",2,0],["لا أتركُ المعنى الرفيع مشرّداً","أأردُّه ضيفاً عليّ كريما",21,"م",2,0],["لا أَتقي بَأس القوي","ي وَلا يَرى بَأسي الضَعيف",22,"ف",1,0],["لا أتبع اللهو فيها غير مترعةٍ","منها تفنن لي في كل سراء",23,"ا",2,0],["لا أتعس اللَه الأولى صانوا لنا","بحياطة الدستور كل ذمار",24,"ر",1,0],["لا اتقى باسا وعندي نجمه","ذخرا يقيني من ذوي الافساد",25,"د",1,0],["لاآتنا لمن اعتدى","رغم الهوان نعم نعم",26,"م",1,0],["لاأتقي خوفاً رقيبَ صبابتي","أو أطرَقَتْ أُذُنَيَّ ، لا ، الناهيَهْ",27,"ي",2,0],["لآآ تعيري هرج عآآآآآآآلم يفترون","آلمكآيد من زمن واهي آ تُحآآآك",28,"ك",1,0],["لَا آتِ إِلَّا مَنْ يُقَاوِمُ شِدَّتي","دَعْنِي أُلَمْلِمُ مِنْكَ مَا تَتَأَسَّفُ",29,"ف",1,0],["لا اتسمّع عاذلٍ عنّا","رايكمْ في الشعر يكفينا",30,"ن",2,0],["لاأتعب الله قلبا من عذوبته","شهدٌ يسيل على أرواح من عشقوا",31,"ق",3,0],["لاأتعب الله من للخير روضتهم","لله وجهتم بالنور قد غرقوا",31,"ق",3,0],["لا أتصورُ إن ترحلْ","يا خالدُ عن هذا المنزلْ",32,"ل",1,1],["لا أتركُ البِيدَ إلّا وهي عادلةٌ","كدأبِها دائماً من عهدِ بانيها*",33,"ي",3,1],["لا أتقن الحاسوب لولا صدفةٌ","جعَلتْك يومئذٍ ليَ الأخبارا",34,"ر",2,0],["لا أتَعَاطَى ما يُنَافِي التُّقَى","في خَلْوَتِي لا وحَيَاتِي قَسَمْ",35,"م",1,0],["لا أتنبأ أنني واصل","فالمتنبي شاعر يذكب",36,"ب",1,0],["لا أتركُ النظراتِ تقفو إثرهم","كسّرتُ قوسي .. واصطليتُ سِهامي",37,"م",2,0],["لا أتقي في الحكم قه","را أو أحابي مِن غضب",38,"ب",1,0],["لا أتقي فيك عذلا من مخاصمنا","ولا رأيت لمصر الوعي أقرانا",39,"ن",2,0],["لا أتقي أبدا ملامة عاتب","أو خفت من غول ومن ثرثار",40,"ر",1,0],["لاا تعبِّسْ نعمة ٌ ضاحكة ٌ","قاسمَ الحظَّ بها ماغلطا",41,"ط",2,0]]}