oem/72420","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139635",""],[4767,"استنهاض القلم","https://www.poetsgate.com/ViewPoem.aspx?id=201142",""],[4578,"زف المدامة واسع سعيك للصفا","https://www.poetsgate.com/ViewPoem.aspx?id=49483",""],[4869,"الاماكن","https://www.poetsgate.com/ViewPoem.aspx?id=151573",""],[4978,"ما أشبه الجدّ في التحليق بالهزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=177194",""],[5108,"الفارس","https://www.poetsgate.com/ViewPoem.aspx?id=35866",""],[5125,"إعادة حساب","https://www.poetsgate.com/ViewPoem.aspx?id=190397",""],[5135,"يا قومنا","https://www.poetsgate.com/ViewPoem.aspx?id=208730",""],[2365,"سلم على قبر الحسين وقل له","https://www.poetsgate.com/ViewPoem.aspx?id=200650",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[243,"مفضوحة لم تبق طي خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=50474",""],[5691,"ديار أهلها رحلوا...!","https://www.poetsgate.com/ViewPoem.aspx?id=206526",""],[5732,"ابيه يرحمني","https://www.poetsgate.com/ViewPoem.aspx?id=177905",""],[5732,"اقطف زهر مالاق","https://www.poetsgate.com/ViewPoem.aspx?id=177908",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5841,"بالقوافي وهمسها وعذب الخواطر والفصيح","https://www.poetsgate.com/ViewPoem.aspx?id=34910",""],[5879,"ما رام قلبي حقلا لست جدوله","https://www.poetsgate.com/ViewPoem.aspx?id=215461",""],[5895,"قد أتت سلوى","https://www.poetsgate.com/ViewPoem.aspx?id=214162",""],[5939,"هي كِبريائي عنكِ حالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=178588",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6288,"رسالة تعزية إلى علي بن الجهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76417&r=&rc=3",""],[289,"ذهبَ الموالِ فلاموا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22123&r=&rc=2",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["بِالقَدَمِ الأولى إِلى شَأوِ العُلى","وَالأَذرُعِ الطولى إِلى عَقدِ المِنَن",0,"ن",1,0],["بِالقِصارِ الصُفرِ إِن شِئ","تَ أَوِ السُمرِ الطِوالِ",1,"ل",1,0],["بِآلِ قُصَيٍّ حاوِلِ المَجْدَ تَنصرِفْ","على لَغَبٍ عن شأْوِكَ الرّيحُ تَلهَثُ",2,"ث",1,0],["بِالقَدرِ يَبعُدُ وَالتَواضُعِ يَدَّني","وَالبِشرِ يَشمِسُ وَالنَدى يَتَغَيَّمُ",3,"م",1,0],["بِالقَيرَوانِ وَبابِ الصينِ قَد زَبَروا","وَبابِ مَروٍ وَبابِ الهِندِ وَالصُغَدِ",4,"د",1,0],["بالقلمِ الرعبيّ من أجله","فظلَّ قلبُ الليث مرعوبا",5,"ب",2,0],["بِالقَوافي جَداوِلاً مِن وَفاءِ","وَالأَغاني خَمائِلاً مِن حَنانِ",6,"ن",1,0],["بالقطَّةِ البيضاءِ","بالشَّاةِ الوديعَةِ بالحميرْ",7,"ر",1,0],["بِالقُطنِ لَم يَرفَع قَواعِدَ مُلكِهِ","فِرعَونُ وَالهَرَمانُ مِن بُنيانِهِ",8,"ن",2,0],["بِالقَصرِ لا بِمَليكِ القَصرِ نازِلَةٌ","أَضحى لَها وَهوَ طَلقُ الوَجهِ جَذلانُ",9,"ن",1,0],["بِالقائِمِ الثامِنِ المُستَخلَفِ اِطَّأَدَت","قَواعِدُ المُلكِ مُمتَدّاً لَها الطِوَلُ",10,"ل",1,0],["بِالقَضاءِ البَليغِ كُنّا فَعِشنا","ثُمَّ زُلنا وَكُلُّ خَلقٍ يَزولُ",11,"ل",1,1],["بالقليل الجمعِ من أبنائها","تنزع النصر من الجمع العديد",12,"د",1,0],["بالقدس جيشٌ دونه رهبانُهُ","تحرّمت بعدلهم صلبانُهُ",13,"ه",1,0],["بِالْقَلْبِ أَحْضُرُهُ وَلَمْ","يَحْجُبْ سِوَى الْجِسْمِ الْغِيَابُ",14,"ب",1,0],["بالقول مجد عيسى والحبيب أتى","بالقول والفعل في التمجيد بالصغر",15,"ر",1,0],["بالقطب بالسبعة الأفراد سادتنا","بالعارفين بأهل الحال والكرم",16,"م",1,0],["بالقد والخد مذ تبدي","اذكرني البان مع نقاه",17,"ا",2,0],["بالقول والفعل قد ابدى مطالعة","فاللفظ منتظم والدر منتثر",18,"ر",1,0],["بِالقَصرِ مِن بَغداذَ لا بِطياسِ","أَهيَفُ مِثلُ الغُصُنِ المَيّاسِ",19,"س",1,1],["بِالقائِمِ المُستَضيءِ المُستَضاءِ بِهِ","إِذا اِدلَهَمَّت دِياجي الظُلمِ وَالظُلَمِ",20,"م",1,0],["بِالْقَصْرِ سَادَاتٌ ذَوُو هَدْيِ","رَضَعُوا لِبَانَ الْمَجْدِ مِنْ ثَدْيِ",21,"ي",1,1],["بِالقَومِ مُجتابي الحَديدِ كَأَنَّهُم","أُسدٌ عَلى لُحُقِ الأَياطِلِ شُزَّبِ",22,"ب",1,0],["بالقهر قد أخذوا مسكاً وغاليةً","ومنهما عوّضونا الوحلَ والطينا",23,"ن",2,0],["بِالقيْلِ مِنْ أبْناءِ قَيْلَةَ والذِي","لا يَنْتَمِي إلا إلَى الأَقْيَالِ",24,"ل",1,0],["بالقَولِ بَدوا حاتِماً","وَالفِعلِ ريحٌ في القُرُب",25,"ب",1,0],["بِالقَولُ وَاِكشِف حالَهُم وَمَحالَهُم","حَتّى إِذا قالوا سَلا فَأَصخَ لَهُم",26,"م",1,0],["بالقلبِ يَسْلو إن سلا دَنِفٌ","والقلبُ رَهْنٌ عندهم غَلِق",27,"ق",1,0],["بالقادسيّة والأَحياءُ شاهدةٌ","رَدَّت كتائبُنا الفُرسانَ والفيلا",28,"ل",2,0],["بِالقَتلِ هَدَّدَنا فيها فُلانُ وَلَو","كُنّا كُئوساً بِكَفَّيهِ لَما قَتَلا",29,"ل",2,0],["بالقلب واظب عليه يافتى واللسان","ثابر عليه ولا تعدل به قط ثان",30,"ن",1,0],["بالقرب منك يهُون عندي منهُمُ","مَن كان بَرّاً بي فأصبح جافيا",31,"ي",2,0],["بالقلب ما بقلبها من غصَّة","وجداً وما لوشحها من القلقْ",32,"ق",1,0],["بِالقَفصِ لِلقَصفِ مَنزِل كَثَبُ","ما لِلتَصابى في غَيرِهِ أَرَبُ",33,"ب",1,1],["بالقوم جميعاً بكل قطبٍ عالٍ","مضمار جلالٍ ذي مظهرٍ نوري",34,"ي",1,0],["بالقائِد السَّمحِ الكَرِيم أرومةً","المُفتفِي الآباءَ والأجدَادا",35,"د",2,0],["بالقرب منه له قد زادت أشواقي","والتفت الساق فينا منه بالساق",36,"ق",1,0],["بِالقَتلِ أَقواماً وأَقواماً أَسَر","تَحتَ الَّتي اِختارَ لَهُ اللَهُ الشَجَر",37,"ر",1,0],["بِالقَعصِ القاضي وَيَبعَجنَ الجُفَر","مِن قَصَبِ الجَوفِ وَيخلُلنَ الثُجَر",37,"ر",1,0],["بِالقورِ مِن قِفافِها وَالقورِ","وَنَسَجَت لَوامِعُ الحَرورِ",38,"ر",1,0],["بِالقيرِ وَالضَبّاتِ زَنبَرِيُّ","رَفَّعَ مِن جَلالِهِ الدارِيُّ",39,"ي",1,0],["بالقسط يحكم مصراً من شرائعه","لمورد العدل بين الناس قد شرعت",40,"ت",1,0],["بالقاسِمِ بن عَليٍّ نِمتُ عن مِحنِ الدُّ","نيا بمستَقَبلٍ منهنَّ أو ماضِ",41,"ض",1,0],["بالقول أسد ولكن","الفعل فعل الذئاب",42,"ب",1,0],["بالقطِّ شمعةُ مجلسٍ","تزهى وَيَزهو السامر",43,"ر",1,0],["بِالقوّة يَدفعُ والباسِ","عن روضتنا وَالمقياسِ",44,"س",1,0],["بِالقَولِ ضَنَّ فمهجتي","مِنهُ تَذوبُ عَلى المَقالِ",45,"ل",1,0],["بالقُرْب من مغناكِ يَبْغِي الشِّفا","مُتَيَّمُ القلب بشكواه",46,"ه",1,0],["بِالقَهرِ اِقهَرهُم يا قاهرْ","الأوّلَ مِنهُم والآخ