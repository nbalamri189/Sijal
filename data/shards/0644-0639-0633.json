{"poems":[[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[534,"خود رداح ربحله","https://www.aldiwan.net/poem37219.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38212","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96759","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96737","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128704","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128713","الكامل"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84533","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86266","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85213","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102734","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4830,"سَرارَةُ مُهجَتي","https://www.poetsgate.com/ViewPoem.aspx?id=194612",""],[5582,"عَرِّجْ بِذاتِ الكُورِ وَالنِّسْعَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=63590",""]],"verses":[["لعسكرِ مُكْرَمٍ حَقُّ اخْتصاصٍ","فلا يَكُ في مَصالحها تَوان",0,"ن",1,0],["لَعْساءُ لَمْياءُ دَعْجا","في حاجِبٍ أَزَجّا",1,"ج",2,0],["لعساءَ واضحةِ الجبين أسيلةٍ","وعثِ المؤزّرِ جثلةِ المتنقَّبِ",2,"ب",1,0],["لَعساءُ يُبدي لَنا ياقوتُ مَبسَمِها","درّاً وَريقاً غَدا يَشفي من العِللِ",3,"ل",1,0],["لعسا ملاثمها سلساً ملاهمها","مُلساً ملازمُها تاهت بإحسانِ",4,"ن",1,0],["لَعسا المراشفِ كالزلال رضابُها","غرثا الحشا مهضومة الكشحينِ",5,"ن",1,0],["لعسى أفوز من الإله بتوبة","واسير في سفن النجاة وأقلع",6,"ع",1,0],["لعسى يوقّع لي بمسموح الرضى","وعلى عوائد فضله يجريني",7,"ن",2,0],["لعساء في خَصَر قَنواء في صِغَر","كَالرّيم في بَقَر من وَحش عَدنانِ",8,"ن",1,0],["لعس الريق من عسيلة ثغر","لَيسَ عندي أَشهى من العسال",9,"ل",1,0],["لَعساءُ مِنها كُلَّما عَذب اللَمى","يَحلو لَدَيَّ مِنَ الغَرامِ عَذابي",10,"ب",2,0],["لعس مراشفه دعج نواظره","واحيرتي بين شهدي وسحريّ",11,"ي",1,0],["لعساله إن شك في الدرع غوصة","كما غاص في الغدران أسود سالخ",12,"خ",1,0],["لعسٌ مراشفهُم تخال ثغورهم","منضودةً تزهو بدُرِّ مباسم",13,"م",1,0],["لَعِسُ اللّمى لو مَسَّ بَردُ رِضابه","مَيْتاً لأولاهُ الحياةَ وأَنعَشا",14,"ش",2,0],["لَعْسا المَراشِفِ كالزُّلالِ رُضابُها","غَرْثَى الحَشا مَهْضُومَةُ الكَشْحَيْنِ",15,"ن",1,0]]}