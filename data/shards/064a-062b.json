{"poems":[[53,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[34,"تعلق روحي روحها قبل خلقنا","https://www.aldiwan.net/poem4884.html","الطويل"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[71,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[93,"هنيئا لكم أن تسمعوا شعر حافظ","https://www.aldiwan.net/poem11190.html","الطويل"],[93,"آنست بكم ولكن تم أنسي","https://www.aldiwan.net/poem11257.html","الوافر"],[30,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[88,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[27,"لو كنت في غمدان أو في عماية","https://www.aldiwan.net/poem5669.html","الطويل"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[72,"واحيلتي بظلام الطرة الداجي","https://www.aldiwan.net/poem18450.html","البسيط"],[72,"يا ويح من أصبح محت","https://www.aldiwan.net/poem19387.html","مجزوء الرجز"],[72,"يثني عليك لسان حالي في الورى","https://www.aldiwan.net/poem20308.html","الكامل"],[51,"مالي أسل من القراب وأغمد","https://www.aldiwan.net/poem61901.html","الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"ركبتك الخير التي لم يزل","https://www.aldiwan.net/poem66038.html","السريع"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[92,"يا قوم عيني شامت","https://www.aldiwan.net/poem38943.html","المجتث"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[45,"تفتأ عجبا بالشيء تدكره","https://www.aldiwan.net/poem63626.html","المنسرح"],[45,"ما لي لا يرحمني من أرحمه","https://www.aldiwan.net/poem66657.html","الرجز"],[28,"يثمر أولاد المخاض ابن ديسقٍ","https://www.aldiwan.net/poem1295.html",""],[99,"في المقهى","https://www.aldiwan.net/poem6248.html","عموديه"],[61,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[61,"وزنجية عرفت بالإباق","https://www.aldiwan.net/poem51528.html","المتقارب"],[61,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[49,"يضطرب الخوف والرجاء إذا","https://www.aldiwan.net/poem64207.html","المنسرح"],[80,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[44,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[74,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[74,"رحلت عنكم ولي فؤاد","https://www.aldiwan.net/poem13270.html","مجزوء البسيط"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[81,"ومعطل والحسن يعشق جيده","https://www.aldiwan.net/poem61445.html","الكامل"],[40,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[48,"يا منة إمتنها السكر","https://www.aldiwan.net/poem63374.html","السريع"],[48,"خذ العيش الهني من المجوس","https://www.aldiwan.net/poem66598.html","الوافر"],[48,"أحسن من ظبية لها رشأ","https://www.aldiwan.net/poem66599.html","المنسرح"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[50,"لا تبغ شر امرئ شرا من الداء","https://www.aldiwan.net/poem64885.html","البسيط"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[46,"عيدان قيناتنا من تحت أرجلها","https://www.aldiwan.net/poem22175.html","البسيط"],[8,"يثبون أرحاما وما يجفلونها","https://www.aldiwan.net/poem21766.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85601","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147485",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[22,"أرى العير تحدى بين قنٍّ وضارجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19793",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[7,"أهاجَكَ، من أسماءَ، رَسمُ المَنازِلِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17583",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[51,"نبكي الشبابَ لحاجاتِ النساءِ ولي","https://www.poetsgate.com/ViewPoem.aspx?id=30798",""],[105,"حماة الوغى أين السلام الموطد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54957&r=&rc=127",""]],"verses":[["يَثورُ إِذا أَوفى الصَباحُ عِجاجُها","وَيَعلو إِذا جَنَّ الظَلامُ دُخانُها",0,"ن",3,0],["يَثبُتُ في كَفِّهِ الحُسامُ كَما","يَعثُرُ في غَيرِ كَفِّهِ الكَرَمُ",1,"م",1,0],["يُثَمِّرُ المالَ وَيَأبى الغِنى","إِلّا مِنَ الذابِلِ وَالمِخذَمِ",2,"م",1,0],["يُثني عَلَيكَ بِكُلِّ عارِفَةٍ","أَبَداً وَسِترُ الغَيبِ مُنسَدِلُ",3,"ل",1,0],["يُثَقِّلُها لُبسُ الحَريرِ لِلينِها","وَتَشكو إِلى جاراتِها ثِقَلَ العِقدِ",4,"د",1,0],["يُثِرنَ الغُبارَ عَلى وَجهِهِ","كَلَونِ الدَواخِنِ فَوقَ الإِرينا",5,"ن",2,0],["يَثِبنَ نَحوَ الزُناةِ مِن شَبَقٍ","كَاِبنِ زُهَير البَرغوثِ في الوَثبِ",6,"ب",1,0],["يَثُورُ بِهَا الشَّوْقُ إِلَى شَدْوِ حَافِظٍ","فَكَيْفَ أَلَهِّيهَا بِتَرْتِيلِ مُطْرَانِ",7,"ن",1,0],["يَثِيرُ جَوَابُهَا أَمْوَاجَ شَوْقِ","وَلَيْسَ البَحْرُ إلاَّ بَحْر فَنِّ",8,"ن",1,0],["يُثَوِّرُ غِزلانَ الصَريمِ اِطِّرادُها","خُطوطَ الثَرى مِن كُلِّ دَلوٍ وَمِرزَمِ",9,"م",1,0],["يثني أزمّة هِيمها شوق إلى","ظل الأراك وأزرق سَلْسالِ",10,"ل",1,0],["يثير غبار الحادثات بكَرِّه","وهل نحن إلاّ من مُثار غباره",11,"ر",2,0],["يُثيرُ الكِلابَ آخِرَ اللَيلِ صَوتُهُ","كَضَبِّ العَرادِ خَطوُهُ مُتَقارِبُ",12,"ب",1,0],["يُثَبّي ثَناءً مِن كَريمٍ وَقَولُهُ","أَلا اِنعَم عَلى حُسنِ التَحِيَّةِ وَاِشرَبِ",13,"ب",1,0],["يثجُّ ماء دموعِي خطّ عارضه","ويلاه من عارضٍ للدَّمع ثجَّاج",14,"ج",1,0],["يثقل منه عند من","يرجوه حتَّى الورَقَا",15,"ق",2,0],["يثني عليك لسان حالي في الورى","أضعاف ما يثني عليك لساني",16,"ي",1,1],["يثمرْ لكم حَمدين حمداً منكُم","لهما وحمداً منهما لا ينفدُ",17,"د",1,0],["يُثني السهامَ عن المرمى وآونةً","يُمضي السهام إذا لاحت له الثُّغَر",18,"ر",1,0],["يُثني عليه بذاك حاسده","على مُعاداته وإبغاضه",19,"ض",2,0],["يثوْبُ لها بعد الحفا عند ذكرِه","أظلُّ وقاحٌ يرضخُ الصخرَ ميثَمُ",20,"م",1,0],["يُثيبُ على النياتِ إن قال قائل","فجار عن القصد الذي يتيمَّمُ",20,"م",1,0],["يثْلِم وفْرَ المال إعطاؤه","لكنَّ وفرَ الجاه لا يُثْلمُ",21,"م",1,0],["يثني عليهن نبلاً ظَنَّ مُرسلها","أنْ ليسَ شيءٌ من الأشياء يثينها",22,"ه",2,0],["يَثني مَساوِفُها غُرضوفَ أَرنَبَةً","شَمّاءَ مِن رَخصَةٍ في جيدِها أَوَدُ",23,"د",1,0],["يُثيرُ في الأرضِ ريحاً","يُهيجُ فيها غُبارا",24,"ر",2,0],["يُثِبنَكَ بِالَّذي أَولَيتَ شُكراً","وَأَينَ مِنَ الَّذي تولي الثَوابُ",25,"ب",1,0],["يُثنى عليِّ من العَلاء خناصِرٌ","ويُمَدُّ نحوي للسَّناءِ أصابِعُ",26,"ع",1,0],["يُثَبِّطنِي فضلي عن الغاية التي","يَخِفُّ إِليها جاهلٌ فيُصِيْبُ",27,"ب",1,0],["يَثلِمُ في وَفرِ لابِسٍ مِقَةً","يَكادُ حُبّاً لِحَظِّهِ يَفِرُه",28,"ر",2,0],["يُثني عَلَيكَ حِلُّهُ وَحَرَمُه","وَمِثلَهُ حَطيمُهُ وَزَمزَمُه",29,"م",2,0],["يُثَمِّرُ أَولادُ المَخاضِ ابنُ دَيسَقٍ","وَيُقري الضَبابَ الضَيفَ قُفعاً رَواجِبُه",30,"ه",1,1],["يثب الفنجان من لهفته","في يدي ، شوقا إلى فنجانها",31,"ن",3,0],["يثني بها الركب الركاب خفائفا","وتثار وهي ثقائل الأوساق",32,"ق",1,0],["يَثُورُ بها قَسطَلٌ أبيضٌ","على القَوْمِ غَيرُ كَثيفِ الرِّواقِ",33,"ق",1,0],["يثقِّفُها طِبٌّ بتثقيفِ مثلِها","ويخدُمُها حتى تَرِقَّ وتَعذُبا",34,"ب",2,0],["يَثنيه في السَّيرِ الحثيثِ بلحظِهِ","كالريحِ تَثني الغيمَ في غُلَوائِه",35,"ا",3,0],["يُثِرنَ الحَصى في وَجهِهِ وَهوَ لاحِقٌ","سِراعٌ تَواليهِ صِيابٌ أَوائِلُه",36,"ل",2,0],["يُثمِرُ مِن مَسِّهِ القَضيبُ وَلَو","يَمَسُّهُ غَيرُهُ لَما أَثمَر",37,"ر",1,0],["يُثْنَى النَّهارُ بِهِ على أَعْقابِهِ","حَتَّى كَأنَّ الشَّمسَ فيه تُكَوَّرُ",38,"ر",1,0],["يُثيرُ عَجاجَةً في كُلِّ ثَغرٍ","يَهيمُ بِهِ عَدِيُّ بنُ الرِقاعِ",39,"ع",1,0],["يَثني مَعاطِفَهُ وَأَذرُفُ عَبرَتي","فَإِخالُهُ غُصناً بِشاطِئِ جَعفَرِ",40,"ر",1,0],["يَثني بِها عِطفَيهِ كُلُّ مُثَقَّفٍ","لَدنٍ وَيَضحَكُ كُلُّ أَبيَضَ مِخذَمِ",41,"م",1,0],["يَثورُ في وَجنَتَيَّ جَيشاً","وَكانَ في جَفنِهِ كَمينا",42,"ن",2,0],["يُثيرُ الهامِدينَ وهم رُفاتٌ","ويَنهضُ بالجُذوعِ الجامدينا",43,"ن",2,0],["يَثورُ الرَدى مِنها فَلا القِرنُ باسِلٌ","إِذا جَعَلتَ آجالَهُم تَتَمَرَّدُ",44,"د",1,0],["يَثني الكُؤوسَ نَوافِحاً بِرَوائِحٍ","يَشرَبنَ مِن أَنفاسِهِ في كاسِهِ",45,"س",2,0],["يُثنى بَناتَ فُؤادِها رَشأٌ","طَفلٌ تَخَّونَ مَشيَهُ فَترُ",46,"ر",1,0],["يُثيرانِ جَوناً ذا ظِلالٍ كَأَنَّهُ","جَديدُ البِقاعِ هَيَّجَتهُ المَعاوِلُ",47,"ل",1,0],["يُثنى العَجاجُ عَلى مَفارِقِهِ","بِمُقَعَّبِ لَم يَعدُ أَن وَقُحا",48,"ح",2,0],["يَثني إِلَيكَ بِها سَوالِفَهُ","رَشأَ صِناعَةُ عَينِهِ السِحرُ",49,"ر",1,0],["يثيرُ بكل معركةٍ صناجاً","وداهيةً كداهيةٍ البسوسِ",50,"س",1,0],["يثير نقعاً مُقَرطقٌ غَنِجٌ","يدير كأساً وبعدها قدحا",51,"ح",2,0],["يَثني مَخالِبَ لَيثٍ عَن مَجاهِلِهِم","يُشفى بِأَمثالِهِنَّ الصابُ وَالصَدَرُ",52,"ر",1,0],["يَثِبُ الإِكامَ إِذا عَرَضنَ لِوَجهِهِ","مِن عَربِ أَغلَبَ لَيسَ مِن إِنعابِهِ",53,"ب",2,0],["يَثوي الوُفودُ وَأُدعى قَبلَ يَومِهُمُ","إِلى الحِباءِ وَلَم أَحضُر بِرَقّاءِ",54,"ا",2,0],["يُثِرنَ الحَصى حَتّى يُباشِرنَ بَردَهُ","إِذا الشَمسُ مَجَّت ريقَها بِالكَلاكِلِ",55,"ل",1,0],["يُثبِتنَ رَبّاً قَديراً لا كِفاءَ لَهُ","وَما عَمَدنَ لِغَيرِ اللَهِ إِثباتا",56,"ت",2,0],["يُثَبُّون أَرحاماً وَما يَجفِلُونها","وَأَخلاقَ وُدًّ ذَهَّبَتها المَذاهبُ",57,"ب",1,1],["يثبطني حب لبغداد لازب","وَيدفعني شوق إلى مصر مشتد",58,"د",1,0],["يثيرُ الليلَ أحقاداً","وصدرَ سحابهِ ضِغنا",59,"ن",2,0],["يثور تيَّارُهُ العاتي فيسأله","أيَّ الأساطيرِ من ماضيَّ خُيِّلَ لي",60,"ل",2,0],["يثبت فرد بلا قرين","وتهلك الشهب والبدور",61,"ر",1,0],["يُثَقِّفُ النَّشْءَ عَلَى أَنَّهُ","أَعْلَى مَنارٍ لأُولِي الذِّكْرِ",62,"ر",1,0],["يُثْنِي عَلَيْكِ وَيَحْفَظُ الذِّكْرَى لِمَا","أَسْدَيْتِ بَاقِيَ دَهْرِهِ المُتَعَاقِبِ",63,"ب",1,0],["يُثني على الفاروق تحسبه فتى","ذبيان قد أثنى على نعمانه",64,"ن",2,0],["يثني عليه العصران","من معشر ذوي شان",65,"ن",1,0],["يُثِيرَانِ جَوْناً ذا ظِلالٍ كَأَنَّهُ","جَدِيدُ نِقاعٍ هَيَّجَتْهُ المَعَاوِلُ",66,"ل",1,0],["يثربٌ والقدسُ منذُ احتلما","كعبتانا وهوى العرب هوانا",67,"ن",2,0],["يُثِرْنَ الحَصَى ، حتى يُباشِرْنَ بردَهُ","غذا الشمسُ مجتْ ريقها بالكلاكلِ",68,"ل",1,0],["يُثيرونَ من حولِها ضَجَّةً","بها عن مَخازيهمُ يُلتهى",69,"ا",1,0],["يثيرُ اهتماماً أديبٌ يجد","كما قيلَ نجمٌ جديدٌ ظهر",70,"ر",1,0],["يثيرُ حزيرانٌ جنونى ونقْمتَى","فأغتال أوثانى .. وأبكى .. وأكفرُ",71,"ر",1,0],["يثني عليهن نبلاً ظَنَّ مُرسلها","أنْ ليسَ شيءٌ من الأشياء يثنيها",72,"ي",3,0],["يثور الردى منها فلا القرن باسلٌ","ولا الطرف سباقٌ ولا الحصن أقود",73,"د",1,0]]}