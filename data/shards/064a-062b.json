 العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[465,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[465,"قلب لذكر الحمى بعد النوى يجب","https://www.aldiwan.net/poem3566.html","عموديه"],[465,"سهادي وليلي فيك ما لها حد","https://www.aldiwan.net/poem3629.html","عموديه"],[469,"وأخ يجرر فضل ذيل إخائي","https://www.aldiwan.net/poem60495.html","الكامل"],[483,"من يوم كنت عصا الوجدان تسيار","https://www.aldiwan.net/poem24372.html","عموديه"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[552,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[552,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[552,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[559,"إن الخريف هو الربيع الثاني","https://www.aldiwan.net/poem33745.html","الكامل"],[559,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[576,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[576,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[587,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["يَثورُ إِذا أَوفى الصَباحُ عِجاجُها","وَيَعلو إِذا جَنَّ الظَلامُ دُخانُها",0,"ن",3,0],["يَثبُتُ في كَفِّهِ الحُسامُ كَما","يَعثُرُ في غَيرِ كَفِّهِ الكَرَمُ",1,"م",1,0],["يُثَمِّرُ المالَ وَيَأبى الغِنى","إِلّا مِنَ الذابِلِ وَالمِخذَمِ",2,"م",1,0],["يُثني عَلَيكَ بِكُلِّ عارِفَةٍ","أَبَداً وَسِترُ الغَيبِ مُنسَدِلُ",3,"ل",1,0],["يُثَقِّلُها لُبسُ الحَريرِ لِلينِها","وَتَشكو إِلى جاراتِها ثِقَلَ العِقدِ",4,"د",1,0],["يُثِرنَ الغُبارَ عَلى وَجهِهِ","كَلَونِ الدَواخِنِ فَوقَ الإِرينا",5,"ن",2,0],["يَثِبنَ نَحوَ الزُناةِ مِن شَبَقٍ","كَاِبنِ زُهَير البَرغوثِ في الوَثبِ",6,"ب",1,0],["يَثُورُ بِهَا الشَّوْقُ إِلَى شَدْوِ حَافِظٍ","فَكَيْفَ أَلَهِّيهَا بِتَرْتِيلِ مُطْرَانِ",7,"ن",1,0],["يَثِيرُ جَوَابُهَا أَمْوَاجَ شَوْقِ","وَلَيْسَ البَحْرُ إلاَّ بَحْر فَنِّ",8,"ن",1,0],["يُثَوِّرُ غِزلانَ الصَريمِ اِطِّرادُها","خُطوطَ الثَرى مِن كُلِّ دَلوٍ وَمِرزَمِ",9,"م",1,0],["يثني أزمّة هِيمها شوق إلى","ظل الأراك وأزرق سَلْسالِ",10,"ل",1,0],["يثير غبار الحادثات بكَرِّه","وهل نحن إلاّ من مُثار غباره",11,"ر",2,0],["يُثيرُ الكِلابَ آخِرَ اللَيلِ صَوتُهُ","كَضَبِّ العَرادِ خَطوُهُ مُتَقارِبُ",12,"ب",1,0],["يُثَبّي ثَناءً مِن كَريمٍ وَقَولُهُ","أَلا اِنعَم عَلى حُسنِ التَحِيَّةِ وَاِشرَبِ",13,"ب",1,0],["يثجُّ ماء دموعِي خطّ عارضه","ويلاه من عارضٍ للدَّمع ثجَّاج",14,"ج",1,0],["يثقل منه عند من","يرجوه حتَّى الورَقَا",15,"ق",2,0],["يثني عليك لسان حالي في الورى","أضعاف ما يثني عليك لساني",16,"ن",2,1],["يثمرْ لكم حَمدين حمداً منكُم","لهما وحمداً منهما لا ينفدُ",17,"د",1,0],["يُثني السهامَ عن المرمى وآونةً","يُمضي السهام إذا لاحت له الثُّغَر",18,"ر",1,0],["يُثني عليه بذاك حاسده","على مُعاداته وإبغاضه",19,"ض",2,0],["يثوْبُ لها بعد الحفا عند ذكرِه","أظلُّ وقاحٌ يرضخُ الصخرَ ميثَمُ",20,"م",1,0],["يُثيبُ على النياتِ إن قال قائل","فجار عن القصد الذي يتيمَّمُ",20,"م",1,0],["يثْلِم وفْرَ المال إعطاؤه","لكنَّ وفرَ الجاه لا يُثْلمُ",21,"م",1,0],["يثني عليهن نبلاً ظَنَّ مُرسلها","أنْ ليسَ شيءٌ من الأشياء يثينها",22,"ه",2,0],["يَثني مَساوِفُها غُرضوفَ أَرنَبَةً","شَمّاءَ مِن رَخصَةٍ في جيدِها أَوَدُ",23,"د",1,0],["يُثيرُ في الأرضِ ريحاً","يُهيجُ فيها غُبارا",24,"ر",2,0],["يُثِبنَكَ بِالَّذي أَولَيتَ شُكراً","وَأَينَ مِنَ الَّذي تولي الثَوابُ",25,"ب",1,0],["يُثنى عليِّ من العَلاء خناصِرٌ","ويُمَدُّ نحوي للسَّناءِ أصابِعُ",26,"ع",1,0],["يُثَبِّطنِي فضلي عن الغاية التي","يَخِفُّ إِليها جاهلٌ فيُصِيْبُ",27,"ب",1,0],["يَثلِمُ في وَفرِ لابِسٍ مِقَةً","يَكادُ حُبّاً لِحَظِّهِ يَفِرُه",28,"ر",2,0],["يُثني عَلَيكَ حِلُّهُ وَحَرَمُه","وَمِثلَهُ حَطيمُهُ وَزَمزَمُه",29,"م",2,0],["يُثَمِّرُ أَولادُ المَخاضِ ابنُ دَيسَقٍ","وَيُقري الضَبابَ الضَيفَ قُفعاً رَواجِبُه",30,"ه",1,1],["يثب الفنجان من لهفته","في يدي ، شوقا إلى فنجانها",31,"ن",3,0],["يثني بها الركب الركاب خفائفا","وتثار وهي ثقائل الأوساق",32,"ق",1,0],["يَثُورُ بها قَسطَلٌ أبيضٌ","على القَوْمِ غَيرُ كَثيفِ الرِّواقِ",33,"ق",1,0],["يثقِّفُها طِبٌّ بتثقيفِ مثلِها","ويخدُمُها حتى تَرِقَّ وتَعذُبا",34,"ب",2,0],["يَثنيه في السَّيرِ الحثيثِ بلحظِهِ","كالريحِ تَثني الغيمَ في غُلَوائِه",35,"ا",3,0],["يُثِرنَ الحَصى في وَجهِهِ وَهوَ لاحِقٌ","سِراعٌ تَواليهِ صِيابٌ أَوائِلُه",36,"ل",2,0],["يُثمِرُ مِن مَسِّهِ القَضيبُ وَلَو","يَمَسُّهُ غَيرُهُ لَما أَثمَر",37,"ر",1,0],["يُثْنَى النَّهارُ بِهِ على أَعْقابِهِ","حَتَّى كَأنَّ الشَّمسَ فيه تُكَوَّرُ",38,"ر",1,0],["يُثيرُ عَجاجَةً في كُلِّ ثَغرٍ","يَهيمُ بِهِ عَدِيُّ بنُ الرِقاعِ",39,"ع",1,0],["يَثني مَعاطِفَهُ وَأَذرُفُ عَبرَتي","فَإِخالُهُ غُصناً بِشاطِئِ جَعفَرِ",40,"ر",1,0],["يَثني بِها عِطفَيهِ كُلُّ مُثَقَّفٍ","لَدنٍ وَيَضحَكُ كُلُّ أَبيَضَ مِخذَمِ",41,"م",1,0],["يَثورُ في وَجنَتَيَّ جَيشاً","وَكانَ في جَفنِهِ كَمينا",42,"ن",2,0],["يُثيرُ الهامِدينَ وهم رُفاتٌ","ويَنهضُ بالجُذوعِ الجامدينا",43,"ن",2,0],["يَثورُ الرَدى مِنها فَلا القِرنُ باسِلٌ","إِذا جَعَلتَ آجالَهُم تَتَمَرَّدُ",44,"د",1,0],["يَثني الكُؤوسَ نَوافِحاً بِرَوائِحٍ","يَشرَبنَ مِن أَنفاسِهِ في كاسِهِ",45,"س",2,0],["يُثنى بَناتَ فُؤادِها رَشأٌ","طَفلٌ تَخَّونَ مَشيَهُ فَترُ",46,"ر",1,0],["يُثيرانِ جَوناً ذا ظِلالٍ كَأَنَّهُ","جَديدُ البِقاعِ هَيَّجَتهُ المَعاوِلُ",47,"ل",1,0],["يُثنى العَجاجُ عَلى مَفارِقِهِ","بِمُقَعَّبِ لَم يَعدُ أَن وَقُحا",48,"ح",2,0],["يَثني إِلَيكَ بِها سَوالِفَهُ","رَشأَ صِناعَةُ عَينِهِ السِحرُ",49,"ر",1,0],["يثيرُ بكل معركةٍ صناجاً","وداهيةً كداهيةٍ البسوسِ",50,"س",1,0],["يثير نقعاً مُقَرطقٌ غَنِجٌ","يدير كأساً وبعدها قدحا",51,"ح",2,0],["يَثني مَخالِبَ لَيثٍ عَن مَجاهِلِهِم","يُشفى بِأَمثالِهِنَّ الصابُ وَالصَدَرُ",52,"ر",1,0],["يَثِبُ الإِكامَ إِذا عَرَضنَ لِوَجهِهِ","مِن عَربِ أَغلَبَ لَيسَ مِن إِنعابِهِ",53,"ب",2,0],["يَثوي الوُفودُ وَأُدعى قَبلَ يَومِهُمُ","إِلى الحِباءِ وَلَم أَحضُر بِرَقّاءِ",54,"ا",2,0],["يُثِرنَ الحَصى حَتّى يُباشِرنَ بَردَهُ","إِذا الشَمسُ مَجَّت ريقَها بِالكَلاكِلِ",55,"ل",1,0],["يُثبِتنَ رَبّاً قَديراً لا كِفاءَ لَهُ","وَما عَمَدنَ لِغَيرِ اللَهِ إِثباتا",56,"ت",2,0],["يُثَبُّون أَرحاماً وَما يَجفِلُونها","وَأَخلاقَ وُدًّ ذَهَّبَتها المَذاهبُ",57,"ب",1,1],["يثبطني حب لبغداد لازب","وَيدفعني شوق إلى مصر مشتد",58,"د",1,0],["يثيرُ الليلَ أحقاداً","وصدرَ سحابهِ ضِغنا",59,"ن",2,0],["يثور تيَّارُهُ العاتي فيسأله","أيَّ الأساطيرِ من ماضيَّ خُيِّلَ لي",60,"ل",2,0],["يثبت فرد بلا قرين","وتهلك الشهب والبدور",61,"ر",1,0],["يُثَقِّفُ النَّشْءَ عَلَى أَنَّهُ","أَعْلَى مَنارٍ لأُولِي الذِّكْرِ",62,"ر",1,0],["يُثْنِي عَلَيْكِ وَيَحْفَظُ الذِّكْرَى لِمَا","أَسْدَيْتِ بَاقِيَ دَهْرِهِ المُتَعَاقِبِ",63,"ب",1,0],["يُثني على الفاروق تحسبه فتى","ذبيان قد أثنى على نعمانه",64,"ن",2,0],["يثني عليه العصران","من معشر ذوي شان",65,"ن",1,0],["يُثِيرَانِ جَوْناً ذا ظِلالٍ كَأَنَّهُ","جَدِيدُ نِقاعٍ هَيَّجَتْهُ المَعَاوِلُ",66,"ل",1,0],["يثربٌ والقدسُ منذُ احتلما","كعبتانا وهوى العرب هوانا",67,"ن",2,0],["يُثِرْنَ الحَصَى ، حتى يُباشِرْنَ بردَهُ","غذا الشمسُ مجتْ ريقها بالكلاكلِ",68,"ل",1,0],["يُثيرونَ من حولِها ضَجَّةً","بها عن مَخازيهمُ يُلتهى",69,"ا",1,0],["يثيرُ اهتماماً أديبٌ يجد","كما قيلَ نجمٌ جديدٌ ظهر",70,"ر",1,0],["يثير بي كلّ حسن فتنة وهوى","فما أمرّ بماء غير صديان",71,"ن",1,0],["يثيرُ حزيرانٌ جنونى ونقْمتَى","فأغتال أوثانى .. وأبكى .. وأكفرُ",72,"ر",1,0],["يثني عليهن نبلاً ظَنَّ مُرسلها","أنْ ليسَ شيءٌ من الأشياء يثنيها",73,"ي",3,0],["يثور الردى منها فلا القرن باسلٌ","ولا الطرف سباقٌ ولا الحصن أقود",74,"د",1,0],["يثور تيّاره العاتي فيسأله :","أي الأساطير من ماضيذ خيّل لي ؟",75,"ل",2,0],["يُثيرانِ الجَنادِلَ كابِياتٍ","إِذا جارا مَعاً وَإِذا اِستَقاما",76,"م",2,0],["يثور بنار الغرام لارض مي","ويا لله كم فعل الغرام",77,"م",1,1],["يثنى عليه رعاه الله من امم","والدهر تصغى لما يثنى مسامعه",78,"ع",2,0],["يثور اذا سارت جنائب من بهم","توله يتلوها ولم يعرف البطا",79,"ط",2,0],["يُثِيرُ صَبَاكَ نَسِيمُ الصَّبَا","وقَد كَانَ إِن هَبَّ مُستَلطَفَا",80,"ف",2,0],["يَثورُ إليهِ حاسِرَاً غيرَ دارِعٍ","ويقضي عليه دارِعاً غيرَ حاسِرِ",81