{"poems":[[90,"أسمعي لي قبل الرحيل كلاما","https://www.aldiwan.net/poem44407.html","الخفيف"],[275,"مسن في الوشي بين زهر ونور","https://www.aldiwan.net/poem35260.html","الخفيف"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205528","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114566","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114589","الخفيف"],[4750,"سبحان واليك ياليلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180448",""],[5011,"سر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197862",""]],"verses":[["حُبَّ ماءُ الحياة منك بثغر","طائر القلب حول سمطَيه حاما",0,"م",2,0],["حبُّ ما شفَّتِ الغلائلُ عنه","بين شوقٍ ولذّةٍ وحبور",1,"ر",1,0],["حب مسوف ثم حب قاتل","فاختر لنفسك في الهوى من تصطفي",2,"ف",2,0],["حبُّ مزنٍ لا بل يَذوبُ إذا را","ءَهُ علماً بأنَّهُ ما حكاهُ",3,"ا",2,0],["حُبُّ مِثلِي لِمِثلِهِ لا يُغَيا","إن يكن في حُبِّ المحبينَ غايَه",4,"ه",1,0],["حبٍ مع حبّ غيري ماظهر فرقه","غديتّ كنّي شفيع وحبّه الزرقا",5,"ق",2,0],["حب مهما لك وصفته عنه يقصرن الوصوف","لا تعذبني وإلا سرت وتركت المكلا لك إذا ما فيك معروف",6,"ف",1,0]]}