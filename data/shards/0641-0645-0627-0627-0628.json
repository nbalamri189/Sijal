oem/136506",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83357","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83672","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83484","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83428","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33677","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33243","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35121","البسيط"],[4767,"تاج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=179616",""],[4852,"دعاء الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=215060",""],[5213,"قف بي على أبرق الحمى أو الاثل","https://www.poetsgate.com/ViewPoem.aspx?id=170512",""],[5277,"جيرةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=192256",""],[5550,"أميل إلى","https://www.poetsgate.com/ViewPoem.aspx?id=211613",""],[5550,"لماذا","https://www.poetsgate.com/ViewPoem.aspx?id=211905",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5638,"سلام على الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=199062",""],[5638,"حكم الخنازير","https://www.poetsgate.com/ViewPoem.aspx?id=206324",""],[5662,"لبيت تخفق الأرواح فيه","https://www.poetsgate.com/ViewPoem.aspx?id=195026",""],[5725,"لك ياحلوتي في القلب ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=192578",""],[5829,"واسقط حكمة الرجل الحصيف","https://www.poetsgate.com/ViewPoem.aspx?id=211484",""],[5912,"شغب الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=205013",""],[5957,"مياه الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=204516",""],[6048,"أنَا التي مِن فَمي تُستَنزَلُ الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=198214",""],[6093,"يتيم في مشاعرنا","https://www.poetsgate.com/ViewPoem.aspx?id=195186",""],[6102,"قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=184624",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[6225,"إحياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78068&r=&rc=153",""]],"verses":[["فَما آبَ حَتّى اِستَفرَغَ المَجدُ كُلُّهُ","شَروبٌ عَلى غَيظِ العَدوِّ أَكولُ",0,"ل",1,0],["فَما أَبقَتِ الأَيامُ مِنَ المالِ عِندَن","سِوى جِذمِ أَذوادٍ مُحَذَّفَةِ النَسلِ",1,"ل",1,0],["فَما أُبنَ حَتّى إِضنَ أَنقاضَ شِقَّةٍ","حَراجيجَ وَاِحدَودَبنَ تَحتَ البَراذِعِ",2,"ع",1,0],["فما أبرم الأقوام يوماً لحيلة","من الأمر إلا قلَّدوك احتيالها",3,"ل",3,0],["فما ابن الكيّس النمري فيكم","ولا أنتم هناك بدغفلينا",4,"ن",2,0],["فَمَا ابنُ الكَيِّسِ النَّمَريبِّ فِيكُم","وَمضا أَنتُم هُنَاكَ بِدَغفَلِينَا",5,"ن",2,0],["فما أبالي إذا استكثرت عائلةً","فقد كفى همّ إصباحي وإمسائي",6,"ا",2,0],["فَما أَبكي مِنَ الغُربَةِ","عَن جارٍ وَعَن خِدنِ",7,"ن",1,0],["فَما أَبصَرَ الدُنيا بِعَينِ دُنوِّهِ","وَلا وِزرَ فيها لِلمُحِبِّ المُصاقِبِ",8,"ب",1,0],["فَما أَبقَت مِنِ اِبنِ أَبي دُؤادٍ","سِوى جَسَدٍ يُخاطِبُ بِالمَعاني",9,"ن",2,0],["فَما اِبناكِ إِلّا اِبنٌ مِنَ الناسِ فَاِصبِري","فَلَن يَرجِعَ المَوتى حَنينُ المَآتِمِ",10,"م",1,0],["فما أبقيتَ إلا مُخْطَفَاتٍ","حَمَاها الخَصْرُ منها والنُّهودُ",11,"د",1,0],["فَما أَبقَيتَ لِلسَيفِ اليَماني","شَجاً فيهِم وَلا الرُمحِ الرُدَيني",12,"ن",2,0],["فَمَا أَبْصَرْتُ غَيْرَ أَخِي كِذَابٍ","خَلُوبِ الْوُدِّ مَصنُوعِ الْحَنانِ",13,"ن",1,0],["فَما اِبنُ شَمالٍ باتَ يَهفو كَأَنَّما","بِهِ خَلفَ أَستارِ الدُجى مَسُّ أَولَقِ",14,"ق",1,0],["فما أبصروا منّا امرأً غيرَ مُحجمٍ","ولا وَجدوا من قومنا غيرَ ناصرِ",15,"ر",1,0],["فَما اِبتَغيتُ وَعَيني","ك مِن هَواهنَّ ذره",16,"ر",2,0],["فَما أُبالي إِذا نَطَقتُ بِذا","مَن جَدَّ مِنهُنَّ بَعدُ أَو هَزَلا",17,"ل",2,0],["فَما أَبعَدَت إِلّا أَجَلَّ مُقارِنٍ","وَلا بَلَّغَت إِلّا خَسيسَ المَآرِبِ",18,"ب",1,0],["فَما آبَ مِنها بَعدَما غابَ غائِبٌ","وَلا يَعدَمُ الحينَ المُجَدَّدَ عادِمُ",19,"م",1,0],["فَما أَبقَتِ الأَيامُ مِنَ المالِ عِندَنا","سِوى جِذمِ أَذوادٍ مُحَذَّفَةِ النَسلِ",20,"ل",1,0],["فَمَا أَبْصَرَتْهُ الْخَيْلُ حَتَّى تَمَطَّرَتْ","بِفُرْسَانِهَا واسْتَتْلَعَتْ كَيْفَ تَخْلُصُ",21,"ص",1,0],["فَمَا أَبْصَرْتُ فِي الإِخْوَانِ نَدْبَاً","يَجِلُّ عَنِ الْمَلامَةِ وَالْعِتَابِ",22,"ب",1,0],["فَما أَبدَت لِمُستامٍ خِداما","وَلا فَضَّ الزَمانُ لَها خِتاما",23,"م",2,0],["فما أبالي وعرضي وافرٌ أخلت","داري من المال أم حصباؤها الذهبُ",24,"ب",1,0],["فما أبصرت عيني كيحي وإنني","لأنشر في أهل أكنها هذه الفتيا",25,"ي",2,0],["فما أبصرت عيني ولا سمعت بمن","يدانيك أذني في الملوك الذواهب",26,"ب",1,0],["فما أبلغتهم قدرة الله ريقهم","ولا أمهلت منهم نياما ليقظة",27,"ه",1,0],["فَما أَبتَغي مِن مالك بَعدَ دارمٍ","وَلا أَبتغي مِن دارم بَعدَ نَهشلِ",28,"ل",1,0],["فَما أُبالي بِمَن غالَ الزَمانُ إِذا","وَقانِيَ اللَهُ في عَليائِهِ حَذَري",29,"ر",2,0],["فما أبصَرت عَيني ولا لمسَت يَدي","ولا سمِعَت أذني ولا خالَ باليا",30,"ل",3,0],["فما أبردَ الدّمعَ الصفيَّ على الحَشى","فللنَفسِ منهُ في مَصائبها ذخر",31,"ر",1,0],["فَما أبقَت الأَيامُ منِّي وقَد جَرى","حَديثُ الصِّبا إِلا الأَسى والتَّلهُّفا",32,"ف",2,0],["فَما أَبهم المَقدور إِلّا لِيَرتَجى","وَلا ضاقَ طَوق الكَرب إِلّا لِيفرجا",33,"ج",2,0],["فَما أُبالي إذا ما مت ما صَنعُوا","كلُّ امرئ بسبيل الموت مرصود",34,"د",1,0],["فما أبلتِ الأيام جِدَّةَ عزمتي","ولا أخَذَتْ تلك الحوادث من صبري",35,"ر",2,0],["فما أبصرتْ عيني كمحمود ماجداً","ولا كشهاب الدين بالعلم معلما",36,"م",2,0],["فما أَبْقَى الإِباءَ لغيرِ مَلْكٍ","حوى الشَّرَفَ المُمَنَّعَ والإِباءَ",37,"ا",2,0],["فما أَبْطَأْتَ إِذ أَبطأتْ يدُ قادِحٍ","أَتاكَ وَقَدْ أَوْرى لك النُّجحَ زَنْدُهُ",38,"د",2,0],["فما أبطلَ الرحمنُ باطِلَ من بغى","عَلَى الحَقِّ إِلّا أَن يُحقَّ بكَ الحَقَّا",39,"ق",2,0],["فما أبقت لي الأيام منها","سوى التأسيف والدمع الهتون",40,"ن",1,0],["فما أبالي صَرفَ الليالي","وأنتُمُ بينها وبيني",41,"ن",2,0],["فما أبالي أجارَ أم عدل ال","رزق بأيْمان غيركم قُسِما",42,"م",2,0],["فما أبالي أرخصَ ال","بائع منه أم غلا",43,"ل",2,0],["فما أبالي أيَّ يو","ميَّ لقيتُ الأجلا",43,"ل",2,0],["فما ابن عليٍّ فيهمُ إن دعوتهُ","لحادثةٍ إلا الحسامَ تَسُلُّهُ",44,"ل",2,0],["فما أبالي حالباتِ المزن أن","تفطِمني بعدك أو أن تُرضِعا",45,"ع",2,0],["فما أبالي وهُم الباقون لي","مَن ذا فَنِي في الناس أو مَن ذا نفِدْ",46,"د",1,0],["فما ابن طراد بالنَّؤوم عن القِرى","ولا مرتج أبوابه دون طارق",47,"ق",1,0],["فما أبالي وقد جادَ الزمانُ به","عُمِّرتُ في الناس ألفاً أو دنا أجلي",48,"ل",2,0],["فما ابنُ طِرادٍ بالخذولِ للائِذٍ","إِذا نوَبُ الأيامِ ذَلَّ نَصيرُها",49,"ر",3,0],["فما أبو جَعْفَرٍ بوانٍ","عن حَقِّ فَضْلٍ وحُسْنِ عهْدِ",50,"د",1,0],["فما أبو جعفرٍ إِلا حليفُ تُقىً","أيامُهُ كُلها من نُسْكهِ رَجبُ",51,"ب",1,0],["فَما أُبالي إِذا أَمسَيتِ جارَتَنا","مُقيمَةً هَل أَقامَ الناسُ أَم ساروا",52,"ر",3,0],["فَما أُبالي إِذا ما كنتَ لي كَنَفاً","مَن صَدَّ أَو بَتَّ مِن أَقرانهِ قَرَني",53,"ن",2,0],["فما أبالِي وقد فارقتهمْ غَبَناً","شُحّاً منَ الدَهرِ في نفعٍ ولا جودا",54,"د",2,0],["فما أبقوا سوى ذكر جميل","لما صنعوا من العمل المفيد",55,"د",1,0],["فما أَبصرتَ مصرُ من مثلهِ","وقد فُجعَت في العصور الأُوَل",56,"ل",1,0],["فما أَبْعَدَ صرفي هم","ةً في اللهوِ مصروفه",57,"ف",2,0],["فما أبدوا لعزتهم ذليلاً","وكنا الأسد وهي لنا سوام",58,"م",1,0],["فَما أَبصروا إلّا الجلالةَ أَشرقت","عَليك وإلّا البيض والبيض والملدا",59,"د",2,0],["فَما اِبن سعدى ولا القعقاع أسمح من","ه للجليسِ وللعافي إذا قدما",60,"م",2,0],["فما أبو حنيفة والشافعى","حَيْثُهُمْ قد نَفَعُوا بنافع",61,"ع",1,0],["فما أَبْهى إِذا ما اليومُ أَضحى","وما أَشْهى إِذا ما اللَّيلُ جَنَّا",62,"ن",2,0],["فما أبقت لنا الصهباء ستراً","معودة على هتك الستور",63,"ر",1,0],["فما أبقت لذي رشد رشاداً","ولا محجوبة سكنت حجابا",64,"ب",2,0],["فما ابن ماء سماء وابن زائدة","وقاتل المحل جوداً أو أبو دلفا",65,"ف",2,0],["فما أبقى شهاباً لم يصوَّب","ولا شمساً تنيرُ ولا هلالا",66,"ل",2,0],["فما أبت حتى أرعوى جهلها","وآضت لهيدا كعود السلم",67,"م",1,0],["فَما أَبقَوا وَلا هَمّوا بِبُقيا","وَنَقلُ الطَبعِ لَيسَ بِمُستَطاعِ",68,"ع",1,0],["فما أبهو للموت أو رهبوا له","جنوداً مصر من وقع الردى حذرات",69,"ت",1,0],["فما أبالي بما لاقى الخليفة من","بغي الخصي وعصيان ابن حمدان",70,"ن",1,0],["فَما أَبقى بِها التَأويبُ طِرقاً","وَلا تَرَكَ الوَجيفُ لَها طِراقا",71,"ق",2,0],["فما أبعد الضيم من حازم","رأى الذل في بلدة فاغترب",72,"ب",1,0],["فما أبالي إذا نفسي تساعدني","على النجاة بمن قد فاز أو هلكا",73,"ك",2,1],["فما ابتليتُ ولكني أراه إذا","رأيت رأياً على كره يصوِّبني",74,"ن",2,0],["فما أبتغي حِولاً عنها ولا بدلاً","وحير العقلَ تبديلٌ وتحويل",75,"ل",1,0],["فما أبالي بما يفوت إذا","كان الذي قد ذكرته حكمي",76,"م",2,0],["فما ابتغي عثرات الخليل","ولا ابتغيين عليه الوثوب",77,"ب",1,0],["فَما أَبهاه في دست المَعالي","بِقَصر مِنهُ يَرتَعد الجَليل",78,"ل",1,0],["فما أبصرت عينٌ كإبداعِ حسنها","وقتلِ الهوى منها ولا الأذن أسمعت",79,"ت",1,0],["فما أَبصَرَت عَينَايَ قَطُّ مُهَذَّباً","مِنَ الناسِ إلا دائِبَ الفِكرِ والحزنِ",80,"ن",1,0],["فَما أَبقَت سُيوفُ الأَوسِ مِنكُم","وَحَدُّ ظُباتِها إِلّا شَريدا",81,"د",2,0],["فَما أَبقيتَ مِن مَعنىً غَريبٍ","توشِّيهِ بِلَفظٍ مِنكَ حالي",82,"ل",2,0],["فَما أَبصَرتُ مِن خِلٍّ وَفيٍّ","وَلا أَلفَيتُ مَشكُورَ الخِلالِ",83,"ل",1,0],["فما ابتكرتم لنا ولكن","قيلا سمعنا لكم وقالا",84,"ل",2,0],["فما أبالي إذا ما لمتني أبداً","وربما ذقت طعم اللوم كالضَّرَبِ",85,"ب",1,0],["فما ابتدعوا كلا ولا تبعوا هوى","ولا هدموا مما بنى المصطفى ركنا",86,"ن",2,0],["فما أبوك الذي نطريه مغترب","وإنما هو للرحمن مقترب",87,"ب",1,0],["فما أبهى اِتّحادهمُ المرجّى","وقَد نسجوا به العليا وزانوا",88,"ن",3,0],["فما أبلتِ الأيّام آيات مجدهم","ولا طاشَ سهمٌ صوّبوهُ وسدّدوا",89,"د",3,0],["فما أبقت الأيام من عرصاتها","لمن جاءها غير الرسوم الدوارس",90,"س",1,0],["فما أبهجَ الساعاتِ إذ هبتِ الصَّبا","وفاح علينا البانُ والرَّنْد والعِطر",91,"ر",1,0],["فما أبقراط بل ابن الحسين وما","جليان في حكمة منه وأحكام",92,"م",1,0],["فما أبالي الكرة من طاعةٍ","ولا أبالي سخطاً من رضا",93,"ض",2,0],["فما أبصروا الا سنا الستر وادعوا","بأنك رب كيف لو كشف الستر",94,"ر",1,0],["فَما أَبغَضوا مثلي سُدى غَير أَنَّهُم","يَعدّون مَدحي فيكُم كَالمآثم",95,"م",1,0],["فَما أَبيت أَهاب الدَهر مرتجفاً","أَخشى العَوادي وَأَبكي سوء منقلب",96,"ب",1,0],["فَما أَبصرت عَلياه إِلّا بَصائرٌ","تجرُّ عَلى الأَبصار ستراً مُخبّأ",97,"ا",1,0],["فما أَبقى بعيني غيرَ دمعٍ","وما أَبقى بقلبك غيرَ حُزنِ",98,"ن",1,0],["فما ابتغوا لذة ولا هُمْ","طلاب سر