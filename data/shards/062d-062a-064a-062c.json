{"poems":[[95,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[87,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[33,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202533","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[101,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[164,"وفقت زادك رب العرش توفيقا","https://www.aldiwan.net/poem59189.html","الوافر"],[227,"شهدت بحزمك في الأمور مساجد","https://www.aldiwan.net/poem55410.html","الكامل"],[234,"قواضب الرأي أمضى من شبا القضب","https://www.aldiwan.net/poem51226.html","البسيط"],[242,"مات الحفيظ فمن يحفظ من عاشا","https://www.aldiwan.net/poem19724.html","البسيط"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[290,"طربت بنا ريح النسيم","https://www.aldiwan.net/poem39376.html","مجزوء الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[309,"يا زائري حين لا واش من البشر","https://www.aldiwan.net/poem16751.html","البسيط"],[333,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[519,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[556,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[566,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53874","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48513","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77559","الرجز"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105519","الكامل"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110682","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100989","الكامل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96244","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71039","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53164","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93589","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93530","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118814","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89117","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62931","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101244","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75831","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125831","الكامل"],[4130,"","https://poetry.dctabudhabi.ae/diwan/poem/198746","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54336","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28728","الرجز"],[4764,"عروس الموت","https://www.poetsgate.com/ViewPoem.aspx?id=27726",""],[4767,"تجارة خاسرة","https://www.poetsgate.com/ViewPoem.aspx?id=179991",""],[4958,"على قدر التعلق","https://www.poetsgate.com/ViewPoem.aspx?id=59099",""],[5163,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=33950",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5277,"أوراق خريفية","https://www.poetsgate.com/ViewPoem.aspx?id=185877",""],[5365,"الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=190439",""],[5431,"ولغير وصلك سيدي لا أقتلُ","https://www.poetsgate.com/ViewPoem.aspx?id=192967",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5672,"من بقايا الرثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=206450",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5829,"ربيع الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161988",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5894,"حين استهل الظبيُ كالمصباح","https://www.poetsgate.com/ViewPoem.aspx?id=131415",""],[6070,"رسائل الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189907",""]],"verses":[["حَتَّى جَلا الأَعْدَاءُ عَنَّ أَوْطَانِهِ","وَسَمَا مَكَانُ العُرْبِ فِي الأَقْوَامِ",0,"م",1,0],["حَتّى جَرى البَينُ فِيما بَينَنا بِيَدٍ","عَسراءَ تَمنَعُنِي حَظّي وَتَمنَعُهُ",1,"ع",2,0],["حتى جرى الماء من أثنائها ذهبا","يسقى ممالك لا تَروىَ ودولات",2,"ت",1,0],["حَتّى جَفَونا وَنَحنُ نَتبَعُهُم","أَلَيسَ بِاللَهِ بِئسَ ما صَنَعوا",3,"ع",3,0],["حتى جرى لغاية الرجال","فلم يزل مجلي المجال",4,"ل",1,0],["حتّى جلا كسرى عن المدائن","وآب بالإيوان والخزائن",5,"ن",1,0],["حتى جبا الأرض إليهم من جبا","وملكوا الدنيا فكانوا أعجبا",6,"ب",2,0],["حتى جلتها دولة الوليد","في أزين الطريف والتليد",7,"د",1,0],["حتى جمالُك , ليس يذهلني","إن غاب من حينٍ إلى حين",8,"ن",1,0],["حتى جرت وقعة عظمى بباغتة","وكان فارسها المشهور برقوقا",9,"ق",2,0],["حتى جمعت من الفخار مراتباً","تقضي بأنك في المفاخر واحد",10,"د",1,0],["حتى جلستَ على الجوزاء منفرِداً","بها وقبَّلْتَها في موضع الشَّنب",11,"ب",1,0],["حَتَّى جَهِلْنَا مُصَاباً لاَ نَظِيرَ لَهُ","جَاشَ عَلَيْنَا شُرُودَ الْوَحْدِ فَانْحَاشَا",12,"ش",2,0],["حَتّى جَمَعتَ لِمَعشَرِ الإِسلامِ بَي","نَ الصَخرَةِ العُظمى وَبَينَ المِشعَرِ",13,"ر",1,0],["حتى جرى ذهب الاصي","ل على اللجين المستنير",14,"ر",1,0],["حتّى جرى في خبر","ذكرُ كلابِ عَبقَرِ",15,"ر",1,0],["حَتّى جَعَلَت بِأَمرِ اللَهِ في قَفَصِ","لَيَبتَليكَ فَكُن مِن مِن خَيرِ مُختَبَرِ",16,"ر",1,0],["حتى جرى ما أنت أدرى به","استغفر الله وأشكو القدر",17,"ر",1,0],["حَتَّى جَدَعْتَ أُنُوفَ الشِّركِ قاطِبةً","بأَنفِ مَعقلِ كُفرٍ أَنتَ جادِعُهُ",18,"ع",2,0],["حتّى جلَتْ شفقَ الدُجى وتوقّدتْ","في أبنُسيّ الليلِ شُعلةُ زَندِهِ",19,"د",2,0],["حتّى جعلتَ لحاضرٍ أو ناظرٍ","كلَّ الّذي رَمَقَتْه عينُ النّاظرِ",20,"ر",1,0],["حَتّى جَلا أَعجازَ لَيلٍ غاطِ","عِنهُ لياحُ اللَونِ كَالفُسطاطِ",21,"ط",1,0],["حتّى جَرَى القدر المَحْتُومُ سَابِقُهُ","فخابَ ظنّي وما أمّلتُه انْعَكَسَا",22,"س",2,0],["حتى جرى دمهم فروى غلة","لم يروها النيل المبارك مترعا",23,"ع",2,0],["حَتّى جَفا كُل البُيوت وَجَلا","بِنَفسِهِ وَبِالجَمالِ في الخَلا",24,"ل",2,0],["حتى جرى القدر المحتم","فاغتدى غرض الحتوف",25,"ف",1,0],["حتى جننت والهوى","محارب لمن عقل",26,"ل",1,0],["حتى جلتها للعيو","ن منصة العهد الأخير",27,"ر",1,0],["حتى جنايته بما","فعل المشيب بمفرقي",28,"ق",2,0],["حتى جَرَبْتُ بني الزمان وأَهله","وجَريْتُ فيهم مِثْلَ ما يجري الدَّمُ",29,"م",1,0],["حتى جلت جذوتها وانكشفت","جمرتها عن كل ليث باسل",30,"ل",1,0],["حَتَّى جَرَت تِلكَ الدِّمَاءُ كَأنَّهَا","فِي يَومِ عِيدٍ سُنَّةُ القُربَانِ",31,"ن",1,0],["حَتّى جَلَوت بِنُور اللَه ظلمتها","وَالناس لا هَون لا يَدرون مُذ كيدوا",32,"د",3,0],["حَتّى جَرين مِن الدِماء جَداول","خاضَت خُيول المُسلِمين عبابها",33,"ب",3,0],["حتى جرى من مقلتي ما كفى","وحار عقلي في بحار الذهول",34,"ل",1,0],["حتى جرى قطر الندى كالقطر","عباس حكمٍ في الندى بسامُ",35,"م",1,0],["حتى جرى جِريالُ حُبّكَ في دَمي","وَمَشى ودَادُكَ في مَشاشِ عِظامِي",36,"م",2,0],["حتى جرى ما جرى في كربلاء فسل","ينبيك عما جرى فيه محرمه",37,"م",2,0],["حتى جَرى الدَهرُ فيما بيننا بيدِ","عسراءَ تمنعُني حظّي وتمنعُهُ",38,"ه",1,0],["حتى جرى ما سح من تلك العبر","غيناً على السلاح والسهل انهمر",39,"ر",1,0],["حَتّى جَناحاص سُدَّةٍ المَركَبَةٍ","وَقَوسُها مِن تَحتِ تِلكَ السُدَّةِ",40,"ه",1,0],["حَتَّى جَمِيعُ صُفُوفِهِم عِلماً تُحِي","طُ برَأيِهِ فأتى بأَفصَحِ خُطبَة",41,"ه",1,0],["حَتَّى جَعَلْتُهُمُ مُرْفَضََّ أَمْسِلَةٍ","منْ بَطْنِ وادٍ يَقيء النّاسَ مِتْآمِ",42,"م",1,1],["حتى جعلت القدس بابل","في تكاثرها العديد",43,"د",1,0],["حتى جعلت البحر عذباً سائغاً","وجعلتَ قفر البرّ روضاً أخضرا",44,"ر",2,0],["حتى جرى في الخدِّ منّي أَسْطُراً","فعرفتُ أَنَّ الشوقَ من إملائهِ",45,"ا",3,0],["حَتَّى جَرى جَريَ الجُمانِ أَدمُعُه","وَالحُبُّ داءٌ عاجِلاً سَيَصرَعُه",46,"ع",2,0],["حتى جمود الكون / من مقربه ادفه","اقلها / لا انكشف / نزفي / يغطيني",47,"ن",2,0],["حتى جحدتَ مقالةً","فعلاً يُبيِّن ميلَكا",48,"ك",2,0],["حتى جَهلتُ مِنَ الودا","عِ مَنِ المُوَدَّعُ بَيْنَنَا",49,"ن",2,0],["حتى جلسنا عند نبعٍ","من حوله نبت النخيل",50,"ل",1,0],["حتَى جَلَى مِرآتَهَا فَتَلألَأَت","فِيهَا شُمُوسُ حَقَايِقٍ وَشَمَايِلُ",51,"ل",1,0],["حتى جفاه الراحلون جميعهم","فرداً..وحملُ الإغترابِ ثقيلُ",52,"ل",1,0],["حتَّى جَمَعتُ من الأشواقِ ما عَجِزَتْ","عن حَمْلِ نيرانها الأشعارُ والخُطَبُ",53,"ب",1,0],["حتى جرت في الروح منك جداولٌ","إذْ كم يزيد لك الحنين ويثقلُ",54,"ل",1,0],["حتى جَمَعتَ ضِباعَ الأرضِ تنهَشُني","وكُنتَ بَغلتَهم للغَيِّ والجَمَلا",55,"ل",2,0],["حتى جلى بالضاد سر جمالها","ومضى بها يسمو على الغايات",56,"ت",1,0],["حتى جهلت الشوق كيف يقودني","لبيوتهم والليل وسط ظلامه",57,"م",2,0],["حتى جلا لي ضيء البدر عن بعد","تسابقت لك تشكو الوجد أدمعه",58,"ع",2,0],["حتى جلت عنا من بعد خزيتها","جند الفرنجة وازدانت روابينا",59,"ن",2,0],["حتى جَرمتُ بساحِ القومِ مجزرةً","من هولها هَرعتْ في البيدِ تنهملُ",60,"ل",1,0],["حتى جعلت الدهر نحوك ساجدا","حمدا وشكرا خافض الأجناح",61,"ح",1,0],["حتى جلستُ أنادي الرُّوحَ مِنْ ألمٍ","أما كفاها دموع العينِ في القاعِ",62,"ع",1,0]]}