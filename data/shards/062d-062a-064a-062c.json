{"poems":[[93,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[31,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202533","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[99,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[160,"وفقت زادك رب العرش توفيقا","https://www.aldiwan.net/poem59189.html","الوافر"],[222,"شهدت بحزمك في الأمور مساجد","https://www.aldiwan.net/poem55410.html","الكامل"],[229,"قواضب الرأي أمضى من شبا القضب","https://www.aldiwan.net/poem51226.html","البسيط"],[237,"مات الحفيظ فمن يحفظ من عاشا","https://www.aldiwan.net/poem19724.html","البسيط"],[282,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[285,"طربت بنا ريح النسيم","https://www.aldiwan.net/poem39376.html","مجزوء الكامل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[304,"يا زائري حين لا واش من البشر","https://www.aldiwan.net/poem16751.html","البسيط"],[328,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[514,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[551,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[561,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"]],"verses":[["حَتَّى جَلا الأَعْدَاءُ عَنَّ أَوْطَانِهِ","وَسَمَا مَكَانُ العُرْبِ فِي الأَقْوَامِ",0,"م",1,0],["حَتّى جَرى البَينُ فِيما بَينَنا بِيَدٍ","عَسراءَ تَمنَعُنِي حَظّي وَتَمنَعُهُ",1,"ع",2,0],["حتى جرى الماء من أثنائها ذهبا","يسقى ممالك لا تَروىَ ودولات",2,"ت",1,0],["حَتّى جَفَونا وَنَحنُ نَتبَعُهُم","أَلَيسَ بِاللَهِ بِئسَ ما صَنَعوا",3,"ع",3,0],["حتى جرى لغاية الرجال","فلم يزل مجلي المجال",4,"ل",1,0],["حتّى جلا كسرى عن المدائن","وآب بالإيوان والخزائن",5,"ن",1,0],["حتى جبا الأرض إليهم من جبا","وملكوا الدنيا فكانوا أعجبا",6,"ب",2,0],["حتى جلتها دولة الوليد","في أزين الطريف والتليد",7,"د",1,0],["حتى جمالُك , ليس يذهلني","إن غاب من حينٍ إلى حين",8,"ن",1,0],["حتى جرت وقعة عظمى بباغتة","وكان فارسها المشهور برقوقا",9,"ق",2,0],["حتى جمعت من الفخار مراتباً","تقضي بأنك في المفاخر واحد",10,"د",1,0],["حتى جلستَ على الجوزاء منفرِداً","بها وقبَّلْتَها في موضع الشَّنب",11,"ب",1,0],["حَتَّى جَهِلْنَا مُصَاباً لاَ نَظِيرَ لَهُ","جَاشَ عَلَيْنَا شُرُودَ الْوَحْدِ فَانْحَاشَا",12,"ش",2,0],["حَتّى جَمَعتَ لِمَعشَرِ الإِسلامِ بَي","نَ الصَخرَةِ العُظمى وَبَينَ المِشعَرِ",13,"ر",1,0],["حتى جرى ذهب الاصي","ل على اللجين المستنير",14,"ر",1,0],["حتّى جرى في خبر","ذكرُ كلابِ عَبقَرِ",15,"ر",1,0],["حَتّى جَعَلَت بِأَمرِ اللَهِ في قَفَصِ","لَيَبتَليكَ فَكُن مِن مِن خَيرِ مُختَبَرِ",16,"ر",1,0],["حتى جرى ما أنت أدرى به","استغفر الله وأشكو القدر",17,"ر",1,0],["حَتَّى جَدَعْتَ أُنُوفَ الشِّركِ قاطِبةً","بأَنفِ مَعقلِ كُفرٍ أَنتَ جادِعُهُ",18,"ع",2,0],["حتّى جلَتْ شفقَ الدُجى وتوقّدتْ","في أبنُسيّ الليلِ شُعلةُ زَندِهِ",19,"د",2,0],["حتّى جعلتَ لحاضرٍ أو ناظرٍ","كلَّ الّذي رَمَقَتْه عينُ النّاظرِ",20,"ر",1,0],["حَتّى جَلا أَعجازَ لَيلٍ غاطِ","عِنهُ لياحُ اللَونِ كَالفُسطاطِ",21,"ط",1,0]]}