{"poems":[[46,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[113,"صالح للخير لما أن بنى","https://www.aldiwan.net/poem16319.html","الرمل"],[139,"في كل شيء شكله معجب","https://www.aldiwan.net/poem49149.html","السريع"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[240,"خليفة الله الذي وعوده لا تخلف","https://www.aldiwan.net/poem31820.html","مجزوء الرجز"],[369,"مجلسك العالي الذي أستقي","https://www.aldiwan.net/poem60896.html","السريع"],[396,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[411,"بأبي نظمك الذي جل قدرا","https://www.aldiwan.net/poem49629.html","الخفيف"],[449,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[563,"ربنا من لطفه لا يدرك","https://www.aldiwan.net/poem33505.html","الرمل"],[563,"فنحت عندنا المليح فاها","https://www.aldiwan.net/poem33654.html","الخفيف"],[563,"لا تكن إلا لمولاك أنا","https://www.aldiwan.net/poem33718.html","الرمل"],[563,"أنت هو الملفوظ واللافظ","https://www.aldiwan.net/poem34401.html","السريع"],[563,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[563,"إن هذا الصبا وهذا الصباحا","https://www.aldiwan.net/poem34664.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119954","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19972","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141297","الكامل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124296","الطويل"],[1792,"","https://poetry.dctabudhabi.ae/diwan/poem/107033","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124730","الرمل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100467","الكامل"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104434","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105067","السريع"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101679","الخفيف"],[2832,"","https://poetry.dctabudhabi.ae/diwan/poem/111565","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79705","الرمل"],[3227,"","https://poetry.dctabudhabi.ae/diwan/poem/143348","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112638","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112286","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205893","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205883",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85055","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4858,"إيهِ يا مصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=138074",""],[5979,"أخذت لحاظي من جنا خديك","https://www.poetsgate.com/ViewPoem.aspx?id=181346",""],[6023,"قل لمن بالقريض بزَّ الفحولا","https://www.poetsgate.com/ViewPoem.aspx?id=123905",""]],"verses":[["وَهوَ وَلَمّا تَهبِط ثَنِيَّتُهُ","لا الرُبعُ في جَربِهِ وَلا السُدسُ",0,"س",1,0],["وَهُوَ والي الشام مَن أَضحى لَهُ","حسن ذكر في جَميع الأَلسُنِ",1,"ن",1,0],["وهو وإن طال التنائي معي","فلم يَزل طرْفي له ناظرا",2,"ر",2,0],["وَهوَ وَالرُسلُ وَالمَلائِكُ وَالخَل","قُ جَميعاً لِرَبِّهِم فُقَراءُ",3,"ا",2,0],["وَهوَ وَقَد بَلَوتُهُ","مُهَذَّبٌ مُثَقَّفُ",4,"ف",1,0],["وهْو وإنْ لم يَرَهُ كلّما","فَكّر فيه شَدَّ مِن ظَهْره",5,"ر",2,0],["وهو وسط القبر جيفه","ماله فرش او وساده",6,"د",2,0],["وهو وِردٌ لكُلِّ شربٍ فُراتٍ","وحَياةٌ لكُلِّ أُنْسٍ رُفاتِ",7,"ت",1,0],["وهو ورد على غصون تمشت","أم بدور تنزلت وشموس",8,"س",1,0],["وهو ورح سابح في بحره","مثل ما يسبح فيه السمك",9,"ك",1,0],["وهو وجه وفي الحديث جميل","ويحب الجمال إن الله",10,"ه",1,0],["وهو وهو الله لا غير فكن","هو لا أنت تدلَّى ودنا",11,"ن",2,0],["وهو وجود مطلق ثابت","قد حار فيه السعد والجاحظ",12,"ظ",1,0],["وهو وجه واحد صبغته","حكمها النافذ من غير نفود",13,"د",1,0],["وهو وهو الله الوجود تعالى","عن شبيه له إذا غبت لاحا",14,"ح",2,0],["وهو وأن كان سكبت فقد","أدرك يوم السبق من داحسِ",15,"س",1,0],["وهو والذي ركب البرا","ق وسار سيرا مقصتد",16,"د",1,0],["وهو وسطى قلائد المجد عزا","وهو إنسان مقلتيه فخارا",17,"ر",2,0],["وَهوَ وَإِن كانَ ظَلوماً ناقِد","لَيسَ تَجوز عِندَهُ المَكايد",18,"د",1,0],["وَهوَ وَإِن كانَ اِبنَ فَرعى وائِل","فَبِمَساعيهِ تَرَقّى في الحَسَب",19,"ب",1,0],["وهو والمصطفى بنادي العُلى شف","عٌ وكلٌّ يقوم في القوم وترا",20,"ر",2,0],["وهووا على أهل الزّعامة في الحمى","من ينحرون الشّعب كالأغنام",21,"م",1,0],["وهو واحد في ذاته وصفاته","وأفعاله الحسنى مقالةَ جازم",22,"م",1,0],["وهو ولي الأمر بالنص الجلي","وعنده علم الكتال المنزل",23,"ل",1,0],["وهو والآل الأنام ضلالاً","والمضلات من لدنه ابتداها",24,"ا",3,0],["وهو وجدانٌ وإن كانت له","زوجةٌ برجاءُ دعجاءُ الحدق",25,"ق",1,0],["وهو وإلى وجه الثرى صرعى وفي","ذاك الهوي إلى الجنان تسنموا",26,"م",3,0],["وهووا على وجه الثرى ونفوسهم","عجزت إذ الباري أحب جوارها",27,"ر",3,0],["وهو وان عذبني بالجفا","ما زلت أهواه ويهواني",28,"ن",2,0],["وهو وعد جلا الأماني أمامي","واراني ما رمت أمراً معدّا",29,"د",2,0],["وهو وجدي أنهم خمسة مضوا","وقد أقعصوا خمسين قرماً مسوما",30,"م",2,1],["وهو والمال لديه","عاش مثل السجناء",31,"ا",2,0],["وهوَ وإنْ أبدى بخدَّيه لي","بَدراً هدى ساريَهُ المُدْلجا",32,"ج",2,0],["وهوَ ومن بارَزَهُ تباهَلا","أن يجعَلَ اللَهُ المحِقّ القاتِلا",33,"ل",2,0],["وَهوَوا في قاعِ بحرٍ أيّ قاع","مَاؤهُ هَيهات فِيهِ ينضبُ",34,"ب",1,0],["وهو والركب الذي من حوله","في اشتياق وانطلاق وانتظار",35,"ر",1,0],["وهو وَهْمٌ في خزائنكمْ","وخيال كاذب الوطرِ",36,"ر",1,0],["وهو والسر واحد يا مريدي","مسفر عن وجوه سر التثني",37,"ن",2,0],["وهو ولي الأمر قد يخذل من","يحث للإقدام في حر الفتن",38,"ن",1,0],["وهو والطّغمةُ من أعوانه","بُؤرَةُ الشّرّ وعونُ الكافرينا",39,"ن",2,0],["وهو ويك نضح دمي وعز علي أن","ألقاك في عرض الخطاب بويك",40,"ك",1,0],["وهو وصفٌ يخصّ من قد تعالى","عن زوال وأن يلاقي مثيلا",41,"ل",2,0]]}