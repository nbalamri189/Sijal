{"poems":[[55,"إلى الله إني للعظيم حمول","https://www.aldiwan.net/poem29901.html","الطويل"],[53,"إلهي أجرني من شنيف وزيرك","https://www.aldiwan.net/poem64922.html","الطويل"],[91,"لقد كان منك اليك السبيل","https://www.aldiwan.net/poem44883.html","المتقارب"],[47,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[47,"بعينيك إعوالي وطول شهيقي","https://www.aldiwan.net/poem65197.html","الطويل"],[68,"خليلي ما أغبى المغالين في الهوى","https://www.aldiwan.net/poem40098.html","الطويل"],[47,"لِمَا وَصَلَتْ أسماءُ مِنْ حَبلِنَا شكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31345",""],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138079",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[4929,"ساعة فخر","https://www.poetsgate.com/ViewPoem.aspx?id=199536",""],[5183,"جلوة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=186442",""],[1043,"النفوس الكبيرة","https://www.poetsgate.com/ViewPoem.aspx?id=89183",""]],"verses":[["وَلَيسَ طِباعُ الناسِ وَقفاً وَرُبَّما","تَفاضَلَ فيهِم أَنفُسٌ وَعُقولُ",0,"ل",1,0],["ولي سطوةٌ بعد الأناةِ مُبيرةٌ","وإطراقةُ الثُّعبان تُؤذن بالنهش",1,"ش",1,0],["وليس طريق الردى موعراً","فيتعب سالكه او يطول",2,"ل",1,0],["وَلَيسَ طَليقَ القَومِ مَن راحَ أَو غَدا","يَسومُ التَصابي وَالمَشيبُ لَهُ أَسرُ",3,"ر",1,0],["وَلَيسَ طَليقُ اليَومِ مَن رَجَعَت لَهُ","صُروفُ اللَيالي في غَدٍ بِطَليقِ",4,"ق",1,0],["وَلَيسَ طَموحُ الناظِرَينِ بِمُبصِرٍ","إِذا كانَ لَحظُ القَلبِ غَيرَ طَموحِ",5,"ح",1,0],["وَلَيسَ طَليق مَنْ رَاِحُ، أوْ غَدَا","يَسُومُ التّصَابي، والمَشيبُ لَهُ أسرُ",6,"ر",1,0],["وليس طماح النفوس سوى","عذاب النهى وجوى الأضلع",7,"ع",1,0],["ولي سَطَواتٌ تذلُّ العَزيزَ","وتوهي قُوى الأسدِ الضّيغمِ",8,"م",1,0],["وليس طبعِيْ التباهيْ بالذين مَضَوا","حتى ولو رضعوا الجوزاءَ واحتلبوا",9,"ب",3,0],["وليس طبعي بمخمور الفؤاد على","غش ولا مقولي للطيش مرتئيا",10,"ي",2,0],["وليس طماح النفوس سوى","عذاب النهى وجوع الأضلعِ",11,"ع",1,0]]}