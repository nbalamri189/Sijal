{"poems":[[54,"وما تاه على الناس","https://www.aldiwan.net/poem27407.html","الهزج"],[51,"قل لعمار بن عما","https://www.aldiwan.net/poem64068.html","مجزوء الرمل"],[66,"يا رب أعط العاشقين بصبرهم","https://www.aldiwan.net/poem40106.html","الكامل"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[135,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[160,"عطف الحبيب وشمت بارقة الرضا","https://www.aldiwan.net/poem58958.html","الكامل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[257,"حسب الخليع ملجا","https://www.aldiwan.net/poem2666.html","منهوك المنسرح"],[259,"أنا الله اعتصامي","https://www.aldiwan.net/poem35814.html","مجزوء الرمل"],[259,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[271,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[282,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[285,"دعك من هذا فماذا","https://www.aldiwan.net/poem39359.html","مجزوء الرمل"],[285,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[380,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"]],"verses":[["وَإِذ قاذِفُكَ المُفحِ","شُ في أَمنٍ مِنَ الحَدِّ",0,"د",1,0],["وأذِقْني فرجَ الزوْ","جة مُنقاداً لأمري",1,"ر",2,0],["وَأَذِقهُمُ بَردَ السُرورِ فَطالَما","صَبَروا عَلى حَرِّ الغَرامِ المُقلِقِ",2,"ق",1,0],["وأَذِقْهُ حُكمكَ في الممالكِ إنّها","ذاقتْ على يدهِ الحِمامَ مِرارا",3,"ر",2,0],["وَأَذَقْتَ بالرُّمْحِ الصَّمِيمِ كُماتَها","طَعْمَ الرَّدَى واالصَّارِمِ الصَّمْصَامِ",4,"م",1,0],["وإذ قربوا منها وإذ صعدوا بها","وإذ مس هاتيك الرقاب حبول",5,"ل",1,0],["وإذ قمت بالإصلاحِ منتبذَ الهوى","رقمتَ اسمك السامي على صفحة الدهرِ",6,"ر",1,0],["وأذقه طعم رضاك تحيى نفسه","بين النفوس ودعه سيفا ينتضا",7,"ض",2,0],["وَإِذ قلتم كَي تُصلِحوا فحشَ غيّكم","ثَلاثَتها فردٌ غدا أمركم إمرا",8,"ر",2,0],["وَإِذ قَرُبتَ مِنّي","غَدَوتَ مُنشِدا",9,"د",2,0],["وأذقني يا إلهي","لذّة القرب المزكّى",10,"ك",2,0],["وأذقني لذّة توحيد ال","أفعال وكن بي خير حفي",11,"ف",2,0],["وأذقه برد رضاك عنه فَلَم يخب","من كان عينك بالرضا تَرعاه",12,"ا",2,0],["وَإِذ قَدحُنا واري الزِنادِ وَقِدحنا ال","مُعَلّا وَأَنوارُ الدُنُوِّ تَلوحُ",13,"ح",1,0],["واذ قال أعد ما","قلت قلت الدرس هذا",14,"ا",1,0],["واذ قفلتم وحل البدر منزله","والشمس مشرقه هل للنجوم سرى",15,"ر",2,0],["وَأَذَقتَني غصص التَغرب بَعدَما","أَفرَدَت عَن سَكني وَأَهل وِدادي",16,"ي",1,0],["وأَذقتُ النفسَ من شُهْدِ المُنَى","ثم عرَّضْتُ لها بالعَلْقَمِ",17,"م",1,0]]}