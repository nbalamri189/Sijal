{"poems":[[56,"وما تاه على الناس","https://www.aldiwan.net/poem27407.html","الهزج"],[53,"قل لعمار بن عما","https://www.aldiwan.net/poem64068.html","مجزوء الرمل"],[68,"يا رب أعط العاشقين بصبرهم","https://www.aldiwan.net/poem40106.html","الكامل"],[107,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[139,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[164,"عطف الحبيب وشمت بارقة الرضا","https://www.aldiwan.net/poem58958.html","الكامل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[262,"حسب الخليع ملجا","https://www.aldiwan.net/poem2666.html","منهوك المنسرح"],[264,"أنا الله اعتصامي","https://www.aldiwan.net/poem35814.html","مجزوء الرمل"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[276,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[287,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[290,"دعك من هذا فماذا","https://www.aldiwan.net/poem39359.html","مجزوء الرمل"],[290,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[385,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[438,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122666","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122815","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38943","الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145815","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64551","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77223","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100350","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67598","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130128","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86252","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86259","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114272","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94798","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94759","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33161","الكامل"],[4942,"هواك والذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=188294",""],[5493,"نشيدُ الشجر","https://www.poetsgate.com/ViewPoem.aspx?id=197037",""],[5538,"الله يقسم من أضاع فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=142624",""],[6070,"لإنكَ أذكى مِنَ \"الغوغلِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=194210",""],[6102,"قالت لها ..","https://www.poetsgate.com/ViewPoem.aspx?id=184632",""]],"verses":[["وَإِذ قاذِفُكَ المُفحِ","شُ في أَمنٍ مِنَ الحَدِّ",0,"د",1,0],["وأذِقْني فرجَ الزوْ","جة مُنقاداً لأمري",1,"ر",2,0],["وَأَذِقهُمُ بَردَ السُرورِ فَطالَما","صَبَروا عَلى حَرِّ الغَرامِ المُقلِقِ",2,"ق",1,0],["وأَذِقْهُ حُكمكَ في الممالكِ إنّها","ذاقتْ على يدهِ الحِمامَ مِرارا",3,"ر",2,0],["وَأَذَقْتَ بالرُّمْحِ الصَّمِيمِ كُماتَها","طَعْمَ الرَّدَى واالصَّارِمِ الصَّمْصَامِ",4,"م",1,0],["وإذ قربوا منها وإذ صعدوا بها","وإذ مس هاتيك الرقاب حبول",5,"ل",1,0],["وإذ قمت بالإصلاحِ منتبذَ الهوى","رقمتَ اسمك السامي على صفحة الدهرِ",6,"ر",1,0],["وأذقه طعم رضاك تحيى نفسه","بين النفوس ودعه سيفا ينتضا",7,"ض",2,0],["وَإِذ قلتم كَي تُصلِحوا فحشَ غيّكم","ثَلاثَتها فردٌ غدا أمركم إمرا",8,"ر",2,0],["وَإِذ قَرُبتَ مِنّي","غَدَوتَ مُنشِدا",9,"د",2,0],["وأذقني يا إلهي","لذّة القرب المزكّى",10,"ك",2,0],["وأذقني لذّة توحيد ال","أفعال وكن بي خير حفي",11,"ف",2,0],["وأذقه برد رضاك عنه فَلَم يخب","من كان عينك بالرضا تَرعاه",12,"ا",2,0],["وَإِذ قَدحُنا واري الزِنادِ وَقِدحنا ال","مُعَلّا وَأَنوارُ الدُنُوِّ تَلوحُ",13,"ح",1,0],["واذ قال أعد ما","قلت قلت الدرس هذا",14,"ا",1,0],["واذ قفلتم وحل البدر منزله","والشمس مشرقه هل للنجوم سرى",15,"ر",2,0],["وَأَذَقتَني غصص التَغرب بَعدَما","أَفرَدَت عَن سَكني وَأَهل وِدادي",16,"د",2,0],["وأَذقتُ النفسَ من شُهْدِ المُنَى","ثم عرَّضْتُ لها بالعَلْقَمِ",17,"م",1,0],["وأذقتَني بَردَ الحَياةِ وقَد أرَى","عَرَضَ الحِمامِ مُنازِعاً أو نازِعا",18,"ع",2,0],["وأَذقتَني ضِعفَ الحَياةِ هَنيئَةً","والماءُ أَشرَبُهُ فَلا أَهناهُ",19,"ا",2,0],["وَإِذ قُلِّدتَه أرّخت مِنهُ","حَباكَ النّصر وَالفَتح المُبينا",20,"ن",2,0],["واذ قدحَ الحصى فرط اقتحامٍ","واذ سبق المدى فرط اتقادِ",21,"د",1,0],["وأذقه الهوان والخزي يا قا","در واثلل عروشه كل ثل",22,"ل",1,0],["وإذ قضى العجز فيهم حكمه فزعوا","فاستنجدوا بالقنا والصارم القضم",23,"م",1,0],["وَأَذَقتَني وَأَنا العَزي","زُ الهون فيكَ وَما شَفاك",24,"ك",1,0],["وَإِذ قَضَيت غزاةً فَأتَنِف عَمَلاً","للحَج فَالحَج للإسلامِ تَكميلُ",25,"ل",1,0],["واذ قرقف الشرب الندامى مدامةٌ","واذ قرقفي ذاك الرضاب المروّق",26,"ق",1,0],["وأذقتُهُ حَرَّ السِّنا","نِ وقد تَبَدى القَرمُ مِنا",27,"ن",2,0],["وَأَذَقتني من قبل نبت نَواجذي","طَعمَ الجفا فسَئِمت منه كآبة",28,"ه",1,0],["وَإِذ قَد شَدت فيها بَلابِل عزِّهِ","وَغَنَّت بِها في رَوض أُنس حَمائِم",29,"م",1,0],["وَاِذ قَد عادَ في عِزٍّ وَسرّت","بِهِ الاحرار مَع كُل العَبيد",30,"د",1,0],["وَإِذ قَالَ إبرَاهِيمُ فِي سُورَةٍ لَهُ","بَدَا كَأخٍ فِي البِكرِ فِي الفَتحِ مِن دُونِ مَا شَطِّ",31,"ط",1,0],["وَإِذ قَومي لِأُسرَتِها عَدُوٌّ","لِتُبلِيَ بَينَها سَجلاً وَخاما",32,"م",2,0],["وَإِذ قَضَينا مشن شرابٍ ضافي","وَخَيرِ زادٍ حَقَّ لِلأَضيافِ",33,"ف",1,0],["وإذ قلتُ يا مولايَ بالرُحم حفَّها","دهاراً باخدار النعيم بنعمةِ",34,"ه",1,0],["وإذ قبل أن أهوى أتاني تعمُّداً","فصادف قلباً خالياً فتمكَّنا",35,"ن",2,0],["وأذقتني حرَّ الهوى","ومنعتني بردَ الثوابِ",36,"ب",1,0],["وأذق رؤايَ قصيدة","قد ضم معناها كتابُ",37,"ب",1,0],["وأذقتُه رزق الإله مظلِّلا","بالفيء سترا من خروقات العِدَى",38,"د",2,0],["وأذقتني مر القلا ونصبتي","شبحاً تخلى عن مذاق الزاد",39,"د",1,0],["وإذْ قلتَ رأياً بلا حجّةٍ","لقالوا أصبتَ على عَجَلِ",40,"ل",1,0],["وَ أَذَقتُها سُمَّ انتِقامِي قُبلَةً","وَ سَقَيتُها مِلحَ المَكِيدَةِ سُكَّرا !",41,"ر",2,0]]}