{"poems":[[65,"أنا ابن الملوك الصيد من فرع خندف","https://www.aldiwan.net/poem46106.html","الطويل"],[95,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[30,"كأني إذا ما كنت عندك مشرف","https://www.aldiwan.net/poem5446.html","الطويل"],[99,"أحبك ما حييت وأنت حسبي","https://www.aldiwan.net/poem24943.html","الوافر"],[41,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[124,"أجوب فيافي العيش سدمان حئرا","https://www.aldiwan.net/poem49282.html","الطويل"],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[164,"سماط ما أراه أم مناخ","https://www.aldiwan.net/poem58912.html","الوافر"],[510,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[567,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104554","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64071","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109362","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133963","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108407",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114436","السريع"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35107","الطويل"],[402,"إلى أهلها تنعى النهى والعزائم","https://www.poetsgate.com/ViewPoem.aspx?id=36218",""],[6125,"مَتَىٰ يَا لَيلُ تَشرَعُ بالفِرَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207932",""]],"verses":[["وَفِيَّ إِذا ما ضُنَّ بِالرِّفْدِ جُودُهُمْ","وَإِقْدامُهُمْ عِنْدَ الرُّدَيْنِيَّةِ السُّمْرِ",0,"ر",1,0],["وَفِيٌّ إِذَا مَا انْهَارَ وُدُّ مُمَاذِقٍ","فَمَا اِلَّذِي يَبْنِي مِنَ الْوُدِّ هَادِمُ",1,"م",1,0],["وَفِيٌّ إِذا ضَنَّ البَخيلُ بِمالِهِ","وَفِيٌّ إِذا أَعطى بِذِمَّتِهِ حَبلا",2,"ل",2,0],["وفي أذنيَّ من شفتيك عتب","إذا أنا ساعة أضجعت جنبي",3,"ب",2,0],["وَفِيَّ إِذا تَرادَفَتِ المَوالي","عَلَيَّ بِمُنجِياتِ الشَتمِ كافي",4,"ف",2,0],["وفي أذني صوتٌ ندىٌّ يحثني","يميد بعطفي حسنه ويميل",5,"ل",1,0],["وَفيٌّ إِذا خانَ الشَقيقُ وَدافِعٌ","إِذا حاصَ عَن دَفعِ المُلِمِّ المُحارِبُ",6,"ب",1,0],["وفي إذن الجهول إذا تلمه","على تفريطه الصمم الصلاخ",7,"خ",1,0],["وفي أُذُنيْهِ بُقيا من صهيلٍ","لأمسٍ هابَهُ بحرٌ وبرُّ",8,"ر",1,0],["وفي أُذُنِ الجَهولِ يضيعُ هَدْراً","كضَوءِ الصُّبحِ في عينِ الضَّريرِ",9,"ر",1,0],["وفيٌّ اذا أمَّ الظباءَ مخاتلاً","سريعٌ اذا ما أمَّها وهو في جَهرِ",10,"ر",1,0],["وفيٌّ إذا أعطى الوثائقَ لامرئٍ","ولا خير فيمن لا تصحُّ وثائقه",11,"ق",2,0],["وفي اذني عن النصحاء وقر","وعندي من مقالتهم ملال",12,"ل",1,0],["وفيٌّ إذا ما قال فالفعل سابق","همام يحوزا الغرقدين تناوله",13,"ل",2,0],["وفيٌّ اذا ما راح يدعي لنكبة","فما قد درى في دهره الضر والخنا",14,"ن",2,0],["وفي إذا خلوا جلوها عَرُو","ساً جلتِ اللثامَ للمعتني",15,"ن",2,0],["وَفي أُذنِكَ الجَوزاءُ قُرطاً مُعَلَّقاً","وَلِلنَّجمِ في يُمناكَ ضِغثُ بَهارِ",16,"ر",1,1],["وفي إذا ما انهار ود مماذق","فما للذي يبني من الود هادم",17,"م",1,0],["وفِي أُذنَيَّ أَسمَعُ صَوتَ صَنعَا","تَئنُّ وتَشتَكي ألَمَ النِّفَاقِ",18,"ق",1,0]]}