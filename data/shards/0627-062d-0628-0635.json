{"poems":[[90,"أحب صراحتى قولا وفعلا","https://www.aldiwan.net/poem45064.html","الوافر"],[87,"يقولون لم تطرى عليا وأخته","https://www.aldiwan.net/poem7248.html","الطويل"],[68,"أحب صديقا منصفا في ازدياده","https://www.aldiwan.net/poem38564.html","الطويل"],[202,"خليلي ما حب البنين ببدعة","https://www.aldiwan.net/poem51944.html","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124537",""]],"verses":[["أحبّ صراحتى قولاً وفعلاً","وأكره أن أميل إلى الرياء",0,"ا",2,1],["أحبِ صغار العالمين لأجلهم","ويعطف قلبي ذو أب ويتيم",1,"م",1,0],["أُحِبُّ صَديقاً مُنصِفاً في اِزدِيادِهِ","يُخَفِّفُ عَن قَصدٍ وَيُبرِمُ عَن عُذرِ",2,"ر",1,1],["أُحبُّ صلاحَ الدهرِ في جانبيهما","ولولاهما ما كنتُ أَحْفَلُ بالدهر",3,"ر",1,0],["أُحبَِّ صريحَ الضَّأنِ لو كان هاجِري","كَما احتاجت البَكمَاءُ وَهناً لِزَاجر",4,"ر",1,1]]}