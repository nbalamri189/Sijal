{"poems":[[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[45,"دروع لملك الروم هذي الرسائل","https://www.aldiwan.net/poem9969.html","الطويل"],[30,"وليلة بتنا بالغريين ضافنا","https://www.aldiwan.net/poem5267.html","الطويل"],[203,"شكوت هواها فاشتكتني إلى هجر","https://www.aldiwan.net/poem45650.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82796","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56188","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109330","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89385","الطويل"],[5136,"بروحي شمس على بانة","https://www.poetsgate.com/ViewPoem.aspx?id=121770",""],[5436,"ياساهر الليل / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=178429",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""]],"verses":[["فقاست أليمَ الطبخ يوماً مُكَمَّلاً","يخالسُها أجزاءها وتُخالسه",0,"س",2,0],["فَقاسَمَكَ العَينَينِ مِنهُ وَلَحظَهُ","سَمِيُّكَ وَالخِلُّ الَّذي لا يُزايِلُ",1,"ل",1,0],["فَقاسَمتُهُ نِصفَينِ بَيني وَبَينَهُ","بَقِيَّةَ زادي وَالرَكايِبُ نُعَّسُ",2,"س",1,0],["فقاسمتُها قلبي وقلتُ لعاذلي","لها شطرها مما قسمتَ ولي شطري",3,"ر",2,0],["فقاسم العمال ما كان ظهر","من دون ما كان أسرّ واستتر",4,"ر",1,0],["فَقاسى أَذاها وَأَهوالها","وَدافع ما شاءَ أَو لَم يَشا",5,"ا",1,0],["فقاسم الجمع في يوم الوغى أسد","له سطا إن عرا الأطواد تنهدمُ",6,"م",1,0],["فقاست اليوم على ما مضى","عمري لقد أخطأ مقياسها",7,"س",3,0],["فقاسيت فيها السقيَ والبذر مدة","تؤجَّر للزمِّير في القلع غلمان",8,"ن",1,0],["فقاسمتها ليس بي جفوة","ولكنني خفت حراسها",9,"س",3,0],["فقاسموهم بنو اعمامنا سفهاً","وانّ اشرفهم قد فاقهم ضررا",10,"ر",2,0],["فَقَاسِمِينَا شُرُودَ الطَّرْفِ وَ اجْتَرِحي","قصيدةً مِنْ عِنَاقِ المَجدِ والشَّفرَه",11,"ر",2,0]]}