w.poetsgate.com/ViewPoem.aspx?id=206524",""],[5718,"ألائمتى","https://www.poetsgate.com/ViewPoem.aspx?id=213932",""],[5746,"طمأنة","https://www.poetsgate.com/ViewPoem.aspx?id=207106",""],[402,"سلام عليكم والفؤاد المسلم","https://www.poetsgate.com/ViewPoem.aspx?id=36305",""],[6046,"الظمأ الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=35226",""],[6082,"نبض اخير","https://www.poetsgate.com/ViewPoem.aspx?id=59137",""],[6120,"أَيَا طَالِبَ الْبُعْد","https://www.poetsgate.com/ViewPoem.aspx?id=216032",""],[6171,"مدينة الرسول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84675&r=&rc=5",""],[5355,"نُزُوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87127&r=&rc=22",""],[6225,"إشباع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78019&r=&rc=105",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""],[4960,"محاولة للتي لن تعود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87991&r=&rc=3",""],[6279,"العابث الهاذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78844&r=&rc=60",""]],"verses":[["إِلى أَينَ مَرمى قَصدِها وَسُراها","رَمى اللَهُ مِن أَخفافِها بِوَجاها",0,"ا",3,1],["إِلى أَينَ خَلفِيَ أَثني العِنانَ","إِذا ما وَجَدتُ أَمامي إِماما",1,"م",2,0],["إلى أين ؟ من شعب لثان بداخلي","متى سوف آتي ! حين تمضي رغائبي",2,"ب",2,0],["إِلَى أَيِّ حِينٍ فِي وَنًى وَتَقَاعُسٍ","تُدَفِّعُنَا الدُّنْيَا أَمَاماً وَنُحْجِمُ",3,"م",1,0],["إِلَى أَيِّ حِينٍ فِي قِلًى وَتَخَاذُلٍ","وَشَمْلٍ شَتِيتٍ وَالْعِدَى تَتَحَكَّمُ",3,"م",1,0],["إِلَى أَيِّ حِينٍ وَالصُّرُوفُ زَوَاجِرٌ","نَعِيشُ كَمَا يَقْضِي عَلَيْنَا التَّوَهُّمُ",3,"م",1,0],["إلى أيِّ عَدلٍ أم لأَيَّةِ سِيرَةٍ","سِوَاهم يَؤُمُّ الظَّاعِنُ المُتَرَحِّلُ",4,"ل",1,0],["إلى أياديك انتهى مطلبي","فيا لها فيحاء مخضرّه",5,"ر",2,0],["إلى أين بِي عن صَاعِدٍ وانْتِجَاعِهِ","وقد رَادَهُ الروَّادُ قبلي فأَحْمَدُوا",6,"د",3,0],["إلى أين بالآمال بعد نواله","إلى أين وافى آخر السَّفَر السَّفْر",7,"ر",1,0],["إلى أين بالآمالِ بعدَ نواله","إلى أين وافى السَّفْرُ آخرَ منزلِ",8,"ل",1,0],["إلى أيّ ما فيه قصدتَ حسبته","هو الغرضُ المقصودُ فيه الميمَّمُ",9,"م",1,0],["إلى أينَ بي إنْ خانَ حبلُكَ قَبْضَتي","وأي النوى إن كان ذلك أنتوي",10,"ت",3,0],["إِلى أَيما غايَةٍ تَركُضينَ","أَلا مُستَقَرٌّ أَلا مَوإِلُ",11,"ل",1,0],["إلى أَيِّ فِتْيانِ النّدى قَصَدَ الرَّدى","وأَيُّهُمُ نابَتْ حِمَاهُ النّوائِبُ",12,"ب",1,0],["إِلى أَيِّ حينٍ أَنتَ في زِيِّ مُحرِمِ","وَحَتّى مَتى في شِقوَةٍ وَإِلى كَمِ",13,"م",1,1],["إِلى أَيِّ سِرٍّ في الهَوى لَم أُخالِفِ","وَأَيُّ غَرامٍ عِندَهُ لَم أُصادِفِ",14,"ف",1,1],["إلى أيّامنا في الدهرِ بيضاً","نَخوضُ غياهبَ الأحداثِ جُونا",15,"ن",2,0],["إِلى أَيِّ دَهرٍ فَافتَدِه أَنتَ هَكَذا","وَقَلبُكَ بِالشَجوِ المُبَرِّحِ مُعَلَقُ",16,"ق",1,0],["إِلى أَيِّ حينٍ كُنتَ في صَبوَةِ اللاهي","أَما لَكَ في شَيءٍ وُعِظتَ بِهِ ناهِ",17,"ه",1,1],["إلى أينَ تَبغي ليس خَلفك مذهبٌ","ولا لجوادٍ في لحاقك مطمع",18,"ع",1,0],["إلى أي وقتٍ نعبد الظلم خشية","فنسجد للقوم البغاة ونركع",19,"ع",1,0],["إلى أين نأوى حين يظلم ليلنا","إذا هدموا ما قد بنينا ولم يبنوا",20,"ن",3,0],["إلى أين تمضي أيها التائه الخطى","يساريك برقٌ أو يباريك عاصفُ",21,"ف",1,0],["إلى أَيِّ امْتِدَادٍ في البَقَاءِ","تُرَوِّعُني مُنَايَا أَصْدِقَائِي",22,"ا",2,1],["إِلى أَيِّ ضوءٍ مِن بُروقِ المُنى تَعشو","وَغَيث الصَوادي سارَ منكَ بِهِ نَعشُ",23,"ش",1,1],["إلى أينَ صاروا وماذا لقوا","وكانوا كمثلك في الدور حيناً",24,"ن",2,0],["الى أين يسمو علو البنا","وقرح المعاول بالقاعده",25,"د",2,0],["إلى أي حينٍ ينكر القلب قلبه","متى سوف تدري ماتقول الجرائد؟؟",26,"د",1,0],["إلى أين أمضي وهل أنثني ؟","أمامي خطير وخلفي خطير",27,"ر",1,0],["إلى أيما غاية تركضين ؟","ألا مستقر ؟ ألا موئل؟",28,"ل",1,0],["إلى أي شيء يصير هوانا","أيبلى كما هي أجسادُنا؟",29,"ن",2,0],["إلى أي شطر من حياتي أيمّمُ","وكلُّ الذي فيها سموم وعلقمُ",30,"م",1,1],["إلى أين تدعوني ومالك مقلة","تجف ولا شوق يرجىّ زواله",31,"ل",2,0],["إلى أين والشمس المنيرة تجتلي","أغرك نجم طالع في دجنة",32,"ه",1,0],["إلى أى باب غير بابك أقرع","وفي أى جود غير جودك أطمع",33,"ع",1,1],["إِلَى أَىِّ حِينٍ أَنتَ ضَارِبُ غَمرَةٍ","مِنَ الجَهلِ لاَ يُسلِيكَ نَأيٌ وَلاَ قُربُ",34,"ب",1,1],["إلى أين هذا التبر يجرى وحوله","حرائق من أرض على الري جدباء",35,"ا",2,0],["إلى أين صرتم هل نزلتم بدارةٍ","لها من سناكم في دجى الليل مشرق",36,"ق",1,0],["إلى أين صرتم آه إني أبحكم","ومن صدكم عني أخاف وأفرق",36,"ق",1,0],["إلى أين أنت وحتى متى","عبورك يا بدر فوق العصر",37,"ر",1,0],["إِلى أَيِّ ضَنىً أَفضى","هَوى أَجفانِكَ المَرضى",38,"ض",2,1],["إلى أياديك يا ذا الجود قد رفعت","أيدي العصاة وإن جاروا وإن قنطوا",39,"ط",3,0],["إلى أيّما واد وفي أيّ مجهل","من الزمن الدوّار فارقتني قسرا",40,"ر",2,0],["إلى أين في هذه الفانية","نروح ونغدو وماذا هيه",41,"ي",2,1],["إلى أينَ مَسرَى العِيسِ تحت رِحالِها","وبابُ أَمينِ المُلْكِ خَيرُ مَحَطِّها",42,"ط",3,0],["إلى أَيِّما الحَيَّينِ تُركُوا فإِنَّكُم","ثفالُ الرَّحَى مِن تَحتِها لا يَريمُها",43,"م",3,0],["إلى أينَ يا هذا الجمالُ تسُوقني","تُراني سألْقى للسؤالِ جوابا ؟!",44,"ب",2,0],["إلى أي حين في الضلالة أنتم","جهلتم بأن اللّه أقدر قادر",45,"ر",1,0],["إلى أينَ تبغي بالأُبوَّة والعلى","بنفس جميع النَّاس دون علاها",46,"ا",3,0],["إلى أيِّ ذكرٍ غيرِ ذكرِكَ أرتاحُ","ومن أيّ بحرٍ بعد بحرِكَ أمتاحُ",47,"ح",1,1],["إلى إيطاليا خفوا وطيروا","هنالك لا هنا لكمو المصير",48,"ر",1,1],["إلى أين أما تأل","مُ يا سائقَها الأيْنا",49,"ن",2,0],["إلى أين يا سائق البكرتينِ","عن الطَّلْح من أَجأٍ والسَّلَمْ",50,"م",1,0],["إلى أين وابن الغاضريّة شاهدٌ","يغرُّك نجمٌ أو يدلُّك خارتُ",51,"ت",1,0],["إلى أيمن الزوراء شرقي دجلةٍ","ربيع المقاوي في السنين العوارق",52,"ق",1,0],["إِلى أَينَ مَن أَيّامُهُ العيدُ كُلُّها","مَآكِلُهُ مَصفوفَةٌ وَمَواكِبُه",53,"ب",2,0],["إلى أين قد غابَ الخطيب أخو الندى","حميد السجايا سامي الخلق سيّدُ",54,"د",1,0],["إلى أين يأوي الإنكليز وكلّنا","نُحاربهُ بالسيفِ والرمحِ والقلم",55,"م",1,0],["إلى أي مستمع اشتكى","وما أنا ذو العلة الخافيه",56,"ي",2,0],["إلى أيِّ المدائنِ سرتَ يوماً","لقيتَ قبورها مثلَ القصور",57,"ر",1,0],["إلى أين َيا رَفَّة َالضلع ِتمضي","توقفْ ، فنحن ُإليك َظِماءُ",58,"ا",2,0],["إلى أين َيا صُبحَنا راحِلٌ","فبعدَك َكلّ ُالليالي مسَاءُ",58,"ا",2,0],["إلى أين َيا أجملَ الميتين","وكيفَ تعَافُ النجومَ السماءُ",58,"ا",2,0],["إلى أين المفر من المنايا","وأسهمها مسددة مصيبة",59,"ب",2,0],["إلى أيوب نصر الله وافى","باقبالٍ وعزّ مستديمِ",60,"م",1,1],["إلى أين يسمو علو البنا","وقرح المعول بالقاعده",61,"د",2,0],["إلى أيِّ حيٍّ غيرهم أنا راحِلٌ","وفي أَيِّ أهلٍ بعدهم مُتطلَّبي",62,"ب",2,0],["إلى أيان أنت أخو سهاد","وتصبح هائما في كل واد",63,"د",1,1],["إلَى أين إنْ أغلَقْتَ بَابَكَ دُونَنَا","وَحَاشَاكَ أنْ يُؤذَى بِعِرضِكَ جَانِي",64,"ن",2,0],["إلى أي شرق أم إلى أي مغرب","أوجّه وجهي عنكم يا بني دهري",65,"ر",2,0],["إلى أين عن دمكم بالطفوف","وتأبى حميتكم ان يطل",66,"ل",1,0],["إِلى أَيْنَ عن حلب بالمنى","وما بعدها لِلْغِنَى مستقرّ",67,"ر",1,0],["إلى أين والموت في إثركم","سميعاً مطيعاً لما قد أمرْ",68,"ر",1,0],["إلى إيوانه نصُّوا المطايا","وإن كانت رذايا قد بُرِينَا",69,"ن",2,0],["إلى أين عن حلب بالمنى","وقد لاح من أفقها بدر أمن",70,"ن",1,0],["إلى أين نمضى أيها الدهر بعدما","نصير هباء لا ضجيج ، ولا ضمت",71,"ت",1,1],["إلى أين يمضى شيبا وشبابنا","إلى أين يمضى الومض والنبض والصوت",71,"ت",1,0],["إلى أين يسرى الظاعنون الأوائل","وأين استقرّت بعد ذاك الفضائل",72,"ل",1,1],["إلى أين تمضي قلت للملك الذي","يفيد صلات جمة وجوائزا",73,"ز",2,0],["إلى أين بالأبطال تسعى بهم شدّا","أعقلك باقٍ أم بك المسّ لا يهدا",74,"د",2,1],["إلى أيّ يوم لم يقم لك موقف","به الشوس تقعي والرؤوس به تخدي",75,"د",2,0],["الى أين التدهورُ ينتهي بي","نزولٌ يستمرُّ أم اصطدام",76,"م",1,0],["الى أين أمضي بالقريض وعالمي","يكاد من الآلات أن يُنكرَ النّفسا",77,"س",2,1],["الى أين أين ؟ أجبْ يا طريقي","لقد زدت َ بُعداً بفقد الرفيق",78,"ق",1,1],["إليّ أيا عطاشى الشعر تلقوا","لديّ الريّ من صافي الشراب",79,"ب",1,1],["إلى أين يا حسادَ شعري وشهرتي","فإن تهربوا مني سأقتلكم باسمي",80,"ي",1,0],["إلى أيّ وادٍ شفَّ عيسى مَسيرُها","وَفي أَيّ نادٍ لا تحِلّ ظهورها",81,"ه",2,1],["إِلى أَين تَبغي السَير عَنا وَإِننا","غَرائر لا نَقوى عَلى البُعد وَالرَدى",82,"د",2,0],["إلى أين لا أحظى به وإلى متى","أقضّي زماني في عسى ولعلّما",83,"م",2,0],["إلى أين تمضي والقلوب خوافق","تئن وهذا باقر من يغازله",84,"ل",2,1],["إلى أي دار بعد دار