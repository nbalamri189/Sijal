{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[90,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[47,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[47,"أما العداة فقد أروك نفوسهم","https://www.aldiwan.net/poem66804.html","البسيط"],[47,"قطعت أبا ليلى وما كنت قبله","https://www.aldiwan.net/poem66869.html","الطويل"],[63,"وشاحب اللبسة والأعضاء","https://www.aldiwan.net/poem51835.html","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[280,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[310,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[354,"أغبى الورى من لم يجد نفسه","https://www.aldiwan.net/poem15873.html","السريع"],[405,"اغبر آفاق السماء وكورت","https://www.aldiwan.net/poem4520.html","الكامل"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34413","الطويل"],[1267,"","https://poetry.dctabudhabi.ae/diwan/poem/144524","الرجز"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87908","الكامل"],[3308,"","https://poetry.dctabudhabi.ae/diwan/poem/144432","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62910","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44908","الخفيف"],[5191,"لم أجد إلّا ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=215183",""],[5434,"عجل على المسجد","https://www.poetsgate.com/ViewPoem.aspx?id=37620",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""]],"verses":[["أَغبارُ دَرٍّ مِن عَطائِكَ تُفتَدى","مِن دَرِّ غَيرِكَ بِالضُروعِ الحُفَّلِ",0,"ل",1,0],["أَغُبُّهُ وَبِرُغمي","إِنَّ الزِيارَةَ غِبُّ",1,"ب",1,0],["أَغباشَ لَيلٍ تِمامٍ كانَ طارَقَهُ","تَطَخطُخُ الغَيمِ حَتّى ما لَهُ جُوَبُ",2,"ب",1,0],["أغبىَ البريّة أرفاهم لعادته","وأعقل الناس خرّاق لعادات",3,"ت",1,0],["أَغبَبتَ سَيبَكَ كَي يَجِمَّ وَإِنَّما","غُمِدَ الحُسامُ المَشرَفِيُّ لِيُنتَضى",4,"ض",2,0],["أَغبَبتُهُ أَن أَستَميحَ لَهُ يَداً","أَو أَن أُعَنِّيَ فِيَّ مِنهُ لِسانا",5,"ن",2,0],["أَغُبُّ السَلامَ حينَ تَكثيرِ مَعشَرٍ","يَعُدّونَ تَكريرَ السَلامِ تَقاضِيا",6,"ي",2,0],["أغبرَ يحوي الرزقَ من غَبراءِ","خَفيفةٍ ثقيلةِ الأرجاءِ",7,"ا",2,0],["أَغِبّ مَزارَهُ وَأَغيب عَنهُ","وَأَحزاني كَما تَغدو تَروحُ",8,"ح",1,0],["أَغَبَّ الفَتْحُ كَيْ يَزْدَادَ حُبّاً","وَهَبَّ مُبَشِّراً والدَّهْرُ مُصغِي",9,"غ",2,0],["اِغبن بصفقة بائعٍ حوباءهُ","بثمالة ما إن تروّي شاربا",10,"ب",2,0],["أَغبى الوَرى مِن لَم يَجِد نَفسَهُ","تَخُصُّهُ إِلّا بِرَأيِ العَوامِ",11,"م",1,1],["اِغبرّ آفاقُ السماءِ وكوّرت","شمسُ النهارِ وأظلم العصرانِ",12,"ن",1,1],["أَغبَّ مديحي هيبةً ثم زاره","ولابُدَّ ببورقاءِ بالطَّبعِ أَنْ تشْدو",13,"د",2,0],["أغِبُّ مَزاري أَحمِلُ الثِقلَ عَنهُمُ","وَأَخضَعُ وَالأَيّامُ لي لَيسَ تَخضَعُ",14,"ع",1,0],["أَغْبَر يَحْوى الزُّرْقَ من غَبْرَاءِ","خَفِيفةٍ ثَقِيلةِ الأَرْجَاءِ",15,"ا",2,0],["اغبى مجدٍّ لاذخار المال في","امَلٍ برحمة وارثٍ بعد المَنى",16,"ن",2,1],["أغبرٌ قبّحته غبراءُ للري","حِ دَويّ فيها وكان جميلاً",17,"ل",2,0],["أَغباوةٌ بالعُربِ والعَجَمِ","أَم كلُّهم اِلْبٌ على ظُلْمِي",18,"م",2,1],["أَغبياءٌ عَليهمُ قَسماتٍ","مُعرباتٍ وَأَيّما أَعرابِ",19,"ب",1,0],["أغبرَ الكفّينِ.. أشعثَ","لا أفيقُ.. ولا أنامْ",20,"م",1,0],["اغبط تقي صار زوده بتقواه","عبد لصوت العبد يرخي سموعه",21,"ع",2,0],["أغبط الشطّ على ما يَلتقيهِ","ليس مثلي أنا لا ألقى احتفالا",22,"ل",2,0]]}