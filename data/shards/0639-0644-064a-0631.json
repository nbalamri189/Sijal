{"poems":[[53,"أعاتب أيامي وما الذئب واحد","https://www.aldiwan.net/poem30632.html","الطويل"],[63,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[86,"ألم تر في الطريق إلى كياد","https://www.aldiwan.net/poem10519.html","الوافر"],[0,"لمن طلل أبصرته فشجاني","https://www.aldiwan.net/poem57.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[93,"على رغم النوى أبقى قريباً","https://www.aldiwan.net/poem11220.html","الوافر"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[88,"إذا شئت أن تسري بكافرة الصوى","https://www.aldiwan.net/poem44444.html","الطويل"],[37,"تعاطى فراخ المكر طورا وتارة","https://www.aldiwan.net/poem7488.html","الطويل"],[23,"يا عين جودي بدمع منك أسبال","https://www.aldiwan.net/poem21523.html","البسيط"],[89,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[28,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[61,"وعقفاء مثل هلال السما","https://www.aldiwan.net/poem51597.html","المتقارب"],[2,"رأيت بني آل امرئ القيس أصفقوا","https://www.aldiwan.net/poem25052.html","الطويل"],[49,"على رسول الله مني السلام","https://www.aldiwan.net/poem63104.html","السريع"],[66,"رعى الله قوما أصلحونا بجورهم","https://www.aldiwan.net/poem38757.html","الطويل"],[80,"وجسم له من غيره روح لذة","https://www.aldiwan.net/poem31563.html","الطويل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[76,"فؤادي رميت وعقلي سبيت","https://www.aldiwan.net/poem39477.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16668","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142055","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10251","الطويل"],[106,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[2,"رأيتُ بني آلِ امرىء القيسِ أصفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=5267",""],[39,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[115,"اقول لحب قط لم يعرف الوفا","https://www.aldiwan.net/poem40889.html","عموديه"],[115,"على رسلك اصبر يا رسول التلفهي","https://www.aldiwan.net/poem40895.html","عموديه"],[115,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[115,"احن الى بغداد والشوق مقلق","https://www.aldiwan.net/poem41145.html","عموديه"],[124,"على رسلك يا ليلى","https://www.aldiwan.net/poem23785.html","مجزوء الوافر"],[142,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[160,"نصيبي منك يوم البعد بعد","https://www.aldiwan.net/poem58667.html","البسيط"],[169,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[189,"على رأس هذا الكون نعل محمد","https://www.aldiwan.net/poem35115.html","الطويل"],[203,"القوم أعلم لولا مقدمي فرسي","https://www.aldiwan.net/poem68159.html","البسيط"],[211,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[212,"ولي طفلة غرثى الوشاحين قدها","https://www.aldiwan.net/poem37847.html","الطويل"],[223,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[235,"أرى الأيام صيغتها تحول","https://www.aldiwan.net/poem31790.html","الوافر"],[237,"بقبر الصعيدي فاستشفعن","https://www.aldiwan.net/poem19092.html","المتقارب"],[249,"أسائلة عميرة عن أبيها","https://www.aldiwan.net/poem2129.html","الوافر"],[259,"نوافح روض الفيض بالطيب تنفح","https://www.aldiwan.net/poem35941.html","الطويل"],[270,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[270,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[275,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[280,"سأشكر ما مننت به ومثلي","https://www.aldiwan.net/poem60758.html","الوافر"],[294,"ألا رب من يغتابني ود أنني","https://www.aldiwan.net/poem1752.html","الطويل"],[316,"تأوب عيني طيف ألم","https://www.aldiwan.net/poem69423.html","المتقارب"],[320,"على رأسها الرمان ترغب بيعه","https://www.aldiwan.net/poem67106.html","الطويل"],[337,"بانت سعاد فنوم العين مملول","https://www.aldiwan.net/poem45422.html","البسيط"],[391,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[391,"ياتاركا للمدارس ليس هذا حسن","https://www.aldiwan.net/poem54482.html","عموديه"],[400,"تلاميذ النبوة","https://www.aldiwan.net/poem6731.html","عموديه"],[403,"أهذا الذي في كأس نظمك قرقف","https://www.aldiwan.net/poem33638.html","الطويل"],[416,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[452,"أحن إلى تلك الربى والمعاهد","https://www.aldiwan.net/poem13715.html","الطويل"],[453,"يعز علي أن ألفى المعزى","https://www.aldiwan.net/poem61775.html","الوافر"],[458,"أسترشد البان وهو غضبان","https://www.aldiwan.net/poem55858.html","المنسرح"],[458,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[464,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[477,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[479,"سلام عليكم من ورا البحر أينما","https://www.aldiwan.net/poem37606.html","الطويل"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[482,"فيض بجمع الجمع صار حديثه","https://www.aldiwan.net/poem24480.html","عموديه"],[505,"الراحل","https://www.aldiwan.net/poem61092.html","الطويل"],[513,"أبت غلبات الشوق ألا تقربا","https://www.aldiwan.net/poem67785.html","الطويل"],[558,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[558,"على رغم أنف الحاسدين مقامي","https://www.aldiwan.net/poem34184.html","الطويل"],[562,"على رسم هاتيك الديار البلاقع","https://www.aldiwan.net/poem52872.html","الطويل"],[575,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"]],"verses":[["عَلَيَّ رِداءٌ مِن جَمالِكَ واسِعٌ","وَعِندِيَ عِزٌّ مِن جَلالِكَ خالِدُ",0,"د",1,0],["على رَوازِحَ يَخْضِبْنَ السّريحَ دَماً","كادَتْ تَمَسُّ أديمَ الأرضِ بالثّفَنِ",1,"ن",1,0],["عَلَيَّ رَقيبٌ لَهُ حافِظٌ","فَقُل في اِمرِئٍ غَلِقٍ مُرتَهَن",2,"ن",1,0],["عَلى رَغمِ المُروءَةِ قَد ظَفِرتُم","وَلَكِن بِالأُسودِ مُصَفَّدينا",3,"ن",2,0],["عَلى رَبَذٍ يَزدادُ عَفواً إِذا جَرى","مِسَحٍّ حَثيثِ الرَكضِ وَالزَأَلانِ",4,"ن",1,0],["عَلى رَجُلٍ كَريمِ الخيمِ أَضحى","بِبَطنِ حَفيرَةٍ صَخِبٍ صَداها",5,"ا",3,0],["عَلَى رَغْمِ النَّوَى أَبْقَى قَرِيباً","وَلَيْسَ بِضائِرِي بُعْدُ المَكَانِ",6,"ن",1,1],["عَلى رَعلَةٍ صُهبِ الذَفارى كَأَنَّها","قَطاً باصَ أَسرابَ القَطا المُتَواتِرِ",7,"ر",1,0],["عَلى رَأسِهِ أُمٌّ لَهُ يَهتَدي بِها","جِماعَ أُمورٍ لا يُعاصي لَها أَمرا",8,"ر",2,0],["على رسلكم يا قوم كم تسمعوننا","مقالة محقودٍ عليه وحاقد",9,"د",1,0],["على رسلة من هذه وتكمُشٍ","بهاتيك إن هاج الرواع أمتلالها",10,"ل",3,0],["عَلى رَسولٍ لَنا مَحضٍ مَشارِبُهُ","سَمحِ الخَليقَةِ عَفٍّ غَيرِ مِجهالِ",11,"ل",1,0],["على ريعٍ لميةَ زايلتهُ","ولم يك عَرف مية عنه زالا",12,"ل",2,0],["عَلى رِجالٍ إِذا هُمُ قَدَحوا","فيكَ فَبَيني وَبَينَهُم نَحَبُ",13,"ب",1,0],["عَلَيَّ رَأَيتُ يا اِبنَ أَبي عَقيلٍ","وَرائي مِنكَ أَظفاراً وَنابا",14,"ب",2,0],["على رَوْضٍ كأنَّ صَباه بُلَّتْ","غَلائِلُها بماءِ الزَّعْفَرانِ",15,"ن",1,0],["على رأسِها زَهرَةٌ غَضَّةٌ","كَنَجمِ الظَّلامِ إذا عَسعَسا",16,"س",2,0],["عَلى رِسلِكُم إِنّا سَنُعدي وَراءَكُم","فَتَمنَعُكُم أَرماحُنا أَو سَنُعذِرُ",17,"ر",1,0],["عَلى رَسولِ اللَهِ مِنّي السَلام","ما كانَ إِلّا رَحمَةً لِلأَنام",18,"م",1,1],["عَلى رِسلِكُم في الجَورِ إِن عُدتَ ثانِياً","وَإِن بِتُّ مَغروراً بِكُم فَعَلى رِسلي",19,"ل",2,0],["على روْضَةٍ تحيا بحيّةِ جَدْوَلٍ","يفيءُ عليه ظلّ أجنحة القضبِ",20,"ب",1,0],["عَلَى رُتَبٍ يَخفَى السُّهَا حَسَداً لَهَا","ويَصفَرُّ وجهُ البَدرِ والبَدرُ راغِمُ",21,"م",1,0],["عَلى رَيبِ المَنونِ تَداوَلَتهُ","فَأَفنَتهُ وَلَيسَ لَها فَناءُ",22,"ا",2,0],["على رَسْمِ دَارٍ قِفارٍ وَقَفْتُ","وَمِن ذِكرِ عَهدِ الحبيبِ بَكَيْتْ",23,"ت",1,0],["عَلى رأسها تحثو التراب بكفها","وَتذرف عَيناها مدامع كالوبل",24,"ل",1,0],["على رنينِ المنجَلِ الحاصدِ","مضى يُغنِّي وهوَ لا يطربُ",25,"ب",1,0],["على رِسْلكنَّ فقد عاقبته","بأقوالكنَّ بناتُ القدرْ",26,"ر",1,0],["على راحٍ من الآدابِ صِرْفٍ","ونُقْلٍ من بَسِيطٍ أوْ طَوِيل",27,"ل",1,0],["على رسلكم ليس الفتى غير شاعرٍ","يغنّي كما شاء الخيالُ قصائده",28,"د",2,0],["عَلِيٌّ رَقي كِتفَ النَبِيِّ مُحَمَّدٍ","فَهَل كَسَّرَ الأَصنامَ خَلقٌ سِوى عَلي",29,"ي",1,1],["على رِسْلكم، إني أقيم بقفرة","يجوز على الأحياء فيها الترحم",30,"م",1,0],["على رغم أنف الموت ذكُرك خالدُ","ترِنُّ بسَمع الدهر منكَ القصائدُ",31,"د",1,1],["على رسلكم إن الليالي قصيرة","وما هي ألا غدوة ورواح",32,"ح",1,0],["على رغم روح الطهر عيسى أذلتم","براء ذماء هونتها الفظائع",33,"ع",1,0],["على رسلكم، إنّا سنعدي وراءكم","فتمنعكم أرماحنا، أو ستعذرُ",34,"ر",1,0],["ً على رأسهِ من فضِّ أليسَ حائنِ","أَخُو قَنَصٍ يَهْوِي كَأَنَّ سَرَاتَهُ",35,"ه",1,0],["على رسلكم يا قوم كم سمعوننا","مقالة محقود عليه وحاقد",36,"د",1,0],["على رأيك اصنع مثلما انت تشتهي","اذا يبس العود المتين تقصفا",37,"ف",2,0],["على رسلك اصبر يا رسول التلفهي","نممت لجلاسي على سر الخفي",38,"ي",1,1],["على رسلك ارفق بي احباه انني","حليف اسى اودت به لوعة الهجر",39,"ر",1,0],["على روحه مني السلام تحفه","صنوف ايادي الغب بالمسك والند",40,"د",1,0],["على رسلك يا ليلى","فدربي ليس من هونه",41,"ن",2,1],["على رِسْلكم في الحبّ إنّا عصابةٌ","إذا ظفِرتْ في الحبِّ عفَّ ضميرُها",42,"ر",3,0],["على رأسي وعيني ظلم هند","رضيت بكلما فعلته هند",43,"د",1,0],["عَلى رِسلِكُم وَاِمشُوا رُوَيداً فَتيهُكُم","عَلى عَبدَلِيٍّ مِن عَجيبِ العَجائِبِ",44,"ب",1,0],["عَلى رأسهِ اِنصبّت عَصاهُ كأنّها","قَناةٌ لهُ شقَّت وأَجرت بهِ نَهرا",45,"ر",2,0],["عَلى رأسِ هذا الكون نعلٌ محمّدٍ","عَلَت فجميعُ الخلق تحت ظلالهِ",46,"ه",1,1],["عَلى رَحالَةِ مِلواحٍ مُثابِرَةٍ","نَحوَ الصَريخِ إِذا ما ثَوَّبَ الداعي",47,"ي",1,0],["على رفقهم بالصب ألفُ تحيةٍ","وألفٌ وألاف من القلب تنفق",48,"ق",1,0],["على رَوْضةٍ غَنّاءَ طيبةِ الثرى","يَحُمّ حواشيها الحَيا بزلاله",49,"ل",2,0],["عَلى رُخامِ المَذبَح النَيِّر","أَمام أَوجاعي أَمامَ الأَلَم",50,"م",1,0],["عَلى رِسلٍ فَما لَكَ مِن مُجارٍ","إِلى رُتَبِ العَلاءِ وَلا رَسيلُ",51,"ل",1,0],["عَلَى رَسْمِهِ مَا هَمَتْ دِيمَةٌ","صَلاَةٌ مِنَ اللهِ مُولِي الْمِنَنْ",52,"ن",1,0],["عَلى رَبِذٍ قَوائِمُهُ إِذا ما","شَأَتهُ الخَيلُ يَنسَرِبُ اِنسِرابا",53,"ب",2,0],["على روضة الأذكار بات هبوبها","فأغصانُها وجداً به تترنّح",54,"ح",1,0],["على رِدفَيكِ بَغداد اسبطرّت","وفيها المجدُ يَعتَنِقُ الفِخارا",55,"ر",2,0],["على روحي أفيضي النورَ حتى","أرى فجراً على روضٍ ندي",56,"ي",1,0],["على رِسلِكُم إنّ الكَواكِبَ بَعضُ ما","تَدُوسُ مَطاياكُم إلى الكَوْكَبِ الدرِّي",57,"ر",2,0],["عَلَى رُغْمِ الزَّمانِ أَجَرْتَ مِنْهُ","وَقَدْ قَلَّ الْمُمانِعُ وَالْمُجِيرُ",58,"ر",1,0],["على رِشدةٍ من أمه أو لِغيَّة","فيغلبها فحل على النسل مُنجب",59,"ب",1,0],["على رأسها معجر أزرق","وفي جيدها سبحة من برم",60,"م",1,0],["عَلى رَأسِها الرُمّانُ تَرغَبُ بَيعَهُ","جُزافاً لِمَن يَشري بِبَضعِهِ أَعشارِ",61,"ر",1,1],["عَلى رِجامَينِ مِن خُطّافِ ماتِحَةٍ","يَهدي صُدورَهُما أُرقٌ مَراقيلُ",62,"ل",1,0],["على رسول الله","خاتم رسل الله",63,"ه",1,0],["على رسولك أبي القاسم مجلى الفتن","والآل والصحب والتابع لهم في الرسن",64,"ن",1,0],["\" عليٌّ \" رابع الخلفاء, إن","لنمنحه مشاعرنا \" احترام