tsgate.com/ViewPoem.aspx?id=171235",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4930,"سقط القناع","https://www.poetsgate.com/ViewPoem.aspx?id=213437",""],[2177,"هما العلمان بالزوراء لاحا","https://www.poetsgate.com/ViewPoem.aspx?id=127085",""],[5007,"إنّهَا لا تَدْرِي...مَنْ يُخْبِرُهَا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=142528",""],[5011,"نار والله نار","https://www.poetsgate.com/ViewPoem.aspx?id=9504",""],[5038,"زهرة البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=196716",""],[5055,"ساحة الأخوان","https://www.poetsgate.com/ViewPoem.aspx?id=101653",""],[5055,"مركئين العز","https://www.poetsgate.com/ViewPoem.aspx?id=104298",""],[5102,"إثارة واستجابة","https://www.poetsgate.com/ViewPoem.aspx?id=12892",""],[5183,"حائم المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180264",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""],[5198,"مسرح الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=135528",""],[5274,"صدى الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204120",""],[5277,"وشمٌ خزعليٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=200431",""],[5277,"الحسينُ(ع) فخرُ المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=206472",""],[5411,"طَوّف بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185344",""],[5411,"ما زِلْتُ أُحِبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=189583",""],[5411,"يَهمُّ بِيَ العَذابُ","https://www.poetsgate.com/ViewPoem.aspx?id=202889",""],[5431,"قنطار شوق زرعت الروح ياحمص","https://www.poetsgate.com/ViewPoem.aspx?id=192391",""],[5431,"هو الحب شطرنجٌ حصان وبيدق","https://www.poetsgate.com/ViewPoem.aspx?id=197760",""],[5431,"شفاهٌ من القلب المراقِ تُخَضّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=198270",""],[5431,"فيرميه الصباح على سريري","https://www.poetsgate.com/ViewPoem.aspx?id=198702",""],[5447,"أول الخلق .. أول الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=208390",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5493,"أسيرُ الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=213401",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5596,"جامع الإمام الخليل بن شاذان","https://www.poetsgate.com/ViewPoem.aspx?id=206784",""],[5732,"قلبي نهبته","https://www.poetsgate.com/ViewPoem.aspx?id=177915",""],[5751,"أميرة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214765",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5848,"ملامح غياب","https://www.poetsgate.com/ViewPoem.aspx?id=52018",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5953,"سلام على أرض الحسين وحضرته","https://www.poetsgate.com/ViewPoem.aspx?id=93792",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5969,"على رسل الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=198684",""],[6078,"ياأيُّها المتعبون","https://www.poetsgate.com/ViewPoem.aspx?id=202779",""],[6115,"بعض البشر يلبس الشرهه على راسه","https://www.poetsgate.com/ViewPoem.aspx?id=180457",""],[6124,"ألا فانتظروني","https://www.poetsgate.com/ViewPoem.aspx?id=174988",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[1583,"الموعد الضائع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73063&r=&rc=20",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[463,"أسترشدُ البانَ وهو غضبانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60198&r=&rc=254",""],[6314,"الدرب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88074&r=&rc=9",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""],[572,"غَادِيَة ٌ والشّمسُ في طِرَادِهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9256&r=&rc=113",""]],"verses":[["عَلَيَّ رِداءٌ مِن جَمالِكَ واسِعٌ","وَعِندِيَ عِزٌّ مِن جَلالِكَ خالِدُ",0,"د",1,0],["على رَوازِحَ يَخْضِبْنَ السّريحَ دَماً","كادَتْ تَمَسُّ أديمَ الأرضِ بالثّفَنِ",1,"ن",1,0],["عَلَيَّ رَقيبٌ لَهُ حافِظٌ","فَقُل في اِمرِئٍ غَلِقٍ مُرتَهَن",2,"ن",1,0],["عَلى رَغمِ المُروءَةِ قَد ظَفِرتُم","وَلَكِن بِالأُسودِ مُصَفَّدينا",3,"ن",2,0],["عَلى رَبَذٍ يَزدادُ عَفواً إِذا جَرى","مِسَحٍّ حَثيثِ الرَكضِ وَالزَأَلانِ",4,"ن",1,0],["عَلى رَجُلٍ كَريمِ الخيمِ أَضحى","بِبَطنِ حَفيرَةٍ صَخِبٍ صَداها",5,"ا",3,0],["عَلَى رَغْمِ النَّوَى أَبْقَى قَرِيباً","وَلَيْسَ بِضائِرِي بُعْدُ المَكَانِ",6,"ن",1,1],["عَلى رَعلَةٍ صُهبِ الذَفارى كَأَنَّها","قَطاً باصَ أَسرابَ القَطا المُتَواتِرِ",7,"ر",1,0],["عَلى رَأسِهِ أُمٌّ لَهُ يَهتَدي بِها","جِماعَ أُمورٍ لا يُعاصي لَها أَمرا",8,"ر",2,0],["على رسلكم يا قوم كم تسمعوننا","مقالة محقودٍ عليه وحاقد",9,"د",1,0],["على رسلة من هذه وتكمُشٍ","بهاتيك إن هاج الرواع أمتلالها",10,"ل",3,0],["عَلى رَسولٍ لَنا مَحضٍ مَشارِبُهُ","سَمحِ الخَليقَةِ عَفٍّ غَيرِ مِجهالِ",11,"ل",1,0],["على ريعٍ لميةَ زايلتهُ","ولم يك عَرف مية عنه زالا",12,"ل",2,0],["عَلى رِجالٍ إِذا هُمُ قَدَحوا","فيكَ فَبَيني وَبَينَهُم نَحَبُ",13,"ب",1,0],["عَلَيَّ رَأَيتُ يا اِبنَ أَبي عَقيلٍ","وَرائي مِنكَ أَظفاراً وَنابا",14,"ب",2,0],["على رَوْضٍ كأنَّ صَباه بُلَّتْ","غَلائِلُها بماءِ الزَّعْفَرانِ",15,"ن",1,0],["على رأسِها زَهرَةٌ غَضَّةٌ","كَنَجمِ الظَّلامِ إذا عَسعَسا",16,"س",2,0],["عَلى رِسلِكُم إِنّا سَنُعدي وَراءَكُم","فَتَمنَعُكُم أَرماحُنا أَو سَنُعذِرُ",17,"ر",1,0],["عَلى رَسولِ اللَهِ مِنّي السَلام","ما كانَ إِلّا رَحمَةً لِلأَنام",18,"م",1,1],["عَلى رِسلِكُم في الجَورِ إِن عُدتَ ثانِياً","وَإِن بِتُّ مَغروراً بِكُم فَعَلى رِسلي",19,"ل",2,0],["على روْضَةٍ تحيا بحيّةِ جَدْوَلٍ","يفيءُ عليه ظلّ أجنحة القضبِ",20,"ب",1,0],["عَلَى رُتَبٍ يَخفَى السُّهَا حَسَداً لَهَا","ويَصفَرُّ وجهُ البَدرِ والبَدرُ راغِمُ",21,"م",1,0],["عَلى رَيبِ المَنونِ تَداوَلَتهُ","فَأَفنَتهُ وَلَيسَ لَها فَناءُ",22,"ا",2,0],["على رَسْمِ دَارٍ قِفارٍ وَقَفْتُ","وَمِن ذِكرِ عَهدِ الحبيبِ بَكَيْتْ",23,"ت",1,0],["عَلى رأسها تحثو التراب بكفها","وَتذرف عَيناها مدامع كالوبل",24,"ل",1,0],["على رنينِ المنجَلِ الحاصدِ","مضى يُغنِّي وهوَ لا يطربُ",25,"ب",1,0],["على رِسْلكنَّ فقد عاقبته","بأقوالكنَّ بناتُ القدرْ",26,"ر",1,0],["على راحٍ من الآدابِ صِرْفٍ","ونُقْلٍ من بَسِيطٍ أوْ طَوِيل",27,"ل",1,0],["على رسلكم ليس الفتى غير شاعرٍ","يغنّي كما شاء الخيالُ قصائده",28,"د",2,0],["عَلِيٌّ رَقي كِتفَ النَبِيِّ مُحَمَّدٍ","فَهَل كَسَّرَ الأَصنامَ خَلقٌ سِوى عَلي",29,"ي",1,1],["على رِسْلكم، إني أقيم بقفرة","يجوز على الأحياء فيها الترحم",30,"م",1,0],["على رسولك مولانا الحفي بنا","محمدوعلى اولاده الطهر",31,"ر",1,0],["على رغم أنف الموت ذكُرك خالدُ","ترِنُّ بسَمع الدهر منكَ القصائدُ",32,"د",1,1],["على رسلكم إن الليالي قصيرة","وما هي ألا غدوة ورواح",33,"ح",1,0],["على رغم روح الطهر عيسى أذلتم","براء ذماء هونتها الفظائع",34,"ع",1,0],["على رسلكم، إنّا سنعدي وراءكم","فتمنعكم أرماحنا، أو ستعذرُ",35,"ر",1,0],["ً على رأسهِ من فضِّ أليسَ حائنِ","أَخُو قَنَصٍ يَهْوِي كَأَنَّ سَرَاتَهُ",36,"ه",1,0],["على رسلكم يا قوم كم سمعوننا","مقالة محقود عليه وحاقد",37,"د",1,0],["على رأيك اصنع مثلما انت تشتهي","اذا يبس العود المتين تقصفا",38,"ف",2,0],["على رسلك اصبر يا رسول التلفهي","نممت لجلاسي على سر الخفي",39,"ف",2,1],["على رسلك ارفق بي احباه انني","حليف اسى اودت به لوعة الهجر",40,"ر",1,0],["على روحه مني السلام تحفه","صنوف ايادي الغب بالمسك والند",41,"د",1,0],["على رسلك يا ليلى","فدربي ليس من هونه",42,"ن",2,1],["على رِسْلكم في الحبّ إنّا عصابةٌ","إذا ظفِرتْ في الحبِّ عفَّ ضميرُها",43,"ر",3,0],["على رأسي وعيني ظلم هند","رضيت بكلما فعلته هند",44,"د",1,0],["عَلى رِسلِكُم وَاِمشُوا رُوَيداً فَتيهُكُم","عَلى عَبدَلِيٍّ مِن عَجيبِ العَجائِبِ",45,"ب",1,0],["عَلى رأسهِ اِنصبّت عَصاهُ كأنّها","قَناةٌ لهُ شقَّت وأَجرت بهِ نَهرا",46,"ر",2,0],["عَلى رأسِ هذا الكون نعلٌ محمّدٍ","عَلَت فجميعُ الخلق تحت ظلالهِ",47,"ه",1,1],["عَلى رَحالَةِ مِلواحٍ مُثابِرَةٍ","نَحوَ الصَريخِ إِذا ما ثَوَّبَ الداعي",48,"ع",2,0],["على رفقهم بالصب ألفُ تحيةٍ","وألفٌ وألاف من القلب تنفق",49,"ق",1,0],["على رَوْضةٍ غَنّاءَ طيبةِ الثرى","يَحُمّ حواشيها الحَيا بزلاله",50,"ل",2,0],["عَلى رُخامِ المَذبَح النَيِّر","أَمام أَوجاعي أَمامَ الأَلَم",51,"م",1,0],["عَلى رِسلٍ فَما لَكَ مِن مُجارٍ","إِلى رُتَبِ العَلاءِ وَلا رَسيلُ",52,"ل",1,0],["عَلَى رَسْمِهِ مَا هَمَتْ دِيمَةٌ","صَلاَةٌ مِنَ اللهِ مُولِي الْمِنَنْ",53,"ن",1,0],["عَلى رَبِذٍ قَوائِمُهُ إِذا ما","شَأَتهُ الخَيلُ يَنسَرِبُ اِنسِرابا",54,"ب",2,0],["على روضة الأذكار بات هبوبها","فأغصانُها وجداً به تترنّح",55,"ح",1,0],["على رِدفَيكِ بَغداد اسبطرّت","وفيها المجدُ يَعتَنِقُ الفِخارا",56,"ر",2,0],["على روحي أفيضي النورَ حتى","أرى فجراً على روضٍ ندي",57,"ي",1,0],["على رِسلِكُم إنّ الكَواكِبَ بَعضُ ما","تَدُوسُ مَطاياكُم إلى الكَوْكَبِ الدرِّي",58,"ر",2,0],["عَلَى رُغْمِ الزَّمانِ أَجَرْتَ مِنْهُ","وَقَدْ قَلَّ الْمُمانِعُ وَالْمُجِيرُ",59,"ر",1,0],["على رِشدةٍ من أمه أو لِغيَّة","فيغلبها فحل على النسل مُنجب",60,"ب",1,0],["على رأسها معجر أزرق","وفي جيدها سبحة من برم",61,"م",1,0],["عَلى رَأسِها الرُمّانُ تَرغَبُ بَيعَهُ","جُزافاً لِمَن يَشري بِبَضعِهِ أَعشارِ",62,"ر",1,1],["عَلى رِجامَينِ مِن خُطّافِ ماتِحَةٍ","يَهدي صُدورَهُما أُرقٌ مَراقيلُ",63,"ل",1,0],["على رسول الله","خاتم رسل الله",64,"ه",1,0],["على رسولك أبي القاسم مجلى الفتن","والآل والصحب والتابع لهم في الرسن",65,"ن",1,0],["\" عليٌّ \" رابع الخلفاء, إن","لنمنحه مشاعرنا \" احتراما \"",66,"م",2,0],["على رغمه الأوراق تجمع بيننا","بنظمكم وصل لشملي يؤلف",67,"ف",1,0],["على رغم من عاداك قلت مُؤَرِّخاً","بفتوى عبيد الله لا زال يقتدى",68,"د",2,0],["على روضة ريّا ترفُّ وموْعِدٍ","من العيش فيْنان الأراكة بارد",69,"د",1,0],["على رغم المصاب أبا رجاءٍ","تصبر حينما الصبرُ الفداء",70,"ا",2,0],["على رؤوس الأعيادِ حِليَتُها","وهْي ملوك الأيام تيجانُ",71,"ن",1,0],["على رعْي واديكم يجرُّ حبالَه","ويُشبعه غضٌّ لكم وهشيمُ",72,"م",1,0],["على رغم قيسٍ لن يباح لرّبها","ذمارٌ منيعٌ لم يقم دونه ذمر",73,"ر",1,0],["على روضٍ جِمامُ الماءِ فيه","يسيحُ فيرتوي منه الجَميمُ",74,"م",1,0],["على رسلكم يا نازحون فإنما"