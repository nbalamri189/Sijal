oem590.html",""],[405,"أشفق على الدرهم والعين","https://www.aldiwan.net/poem49449.html","البسيط"],[405,"كان ينابيع الثرى ثدي مرضع","https://www.aldiwan.net/poem49510.html","الطويل"],[405,"لئن كدر الدهر الخؤون مشاربي","https://www.aldiwan.net/poem49824.html","الطويل"],[409,"كعهدك بانات الحمى فوق كثبها","https://www.aldiwan.net/poem31848.html","الطويل"],[416,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[416,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[437,"طويت لكم سر الضمير على وفى","https://www.aldiwan.net/poem2511.html","الطويل"],[437,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[439,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[443,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[458,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[458,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[495,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[500,"شروق بغربي اللوا لألأت لنا","https://www.aldiwan.net/poem37796.html","الطويل"],[500,"أصاحب بيتي كل ما قام في الورى","https://www.aldiwan.net/poem37812.html","الطويل"],[500,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[505,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[529,"يجاهرني العدو بكل نكر","https://www.aldiwan.net/poem37467.html","الوافر"],[536,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[551,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[551,"تضاحكت لما رأيت المشيب","https://www.aldiwan.net/poem47349.html","المتقارب"],[551,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[558,"أيا ساكنين الشرق قد شرقت بكم","https://www.aldiwan.net/poem34313.html","الطويل"],[558,"بنا المولى هو الأحرى","https://www.aldiwan.net/poem34525.html","الهزج"],[558,"حرارة عشقه تعطي بروده","https://www.aldiwan.net/poem34565.html","الوافر"],[558,"هو الله ربي هو المبتدا","https://www.aldiwan.net/poem34598.html","المتقارب"],[558,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[563,"ألا أني خليلك يا حويرى","https://www.aldiwan.net/poem13613.html","الوافر"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[567,"جد لي ببركارك الذي صنعت","https://www.aldiwan.net/poem69811.html","المنسرح"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["فَقولا لِلمُنَفَّضِ مِذرَوَيهِ","خُضِ الأَمرَ اِنغِماساً وَاِنغِطاطا",0,"ط",2,0],["فَقَوَّمَ بِالأَذى مِنها صِعاداً","وَذَلَّلَ بِالرُقى مِنها صِعابا",1,"ب",2,0],["فَقولوا لَها قولي لِفَوزٍ تَعَطَّفي","عَلى جَسَدٍ لا رَوحَ فيهِ سَليبِ",2,"ب",1,0],["فَقولوا لَهُم جِئناهُ مِن ماءِ زَمزَمٍ","لِنَشفيهِ مِن داءٍ بِهِ بِذَنوبِ",2,"ب",1,0],["فَقولي لَها يا شَمسُ عَنِّيَ ما الَّذي","يَسُرُّكِ في قَتلي أَما لَكِ مِن بُقيا",3,"ا",1,0],["فَقوموا برَسْمِ الحقِّ فِيها فقَدْ عَفا","وهُبّوا لنَصْرِ الدّينِ فيها فقدْ أشْفَى",4,"ف",2,0],["فقولا رسولَ الله يا خيْرَ خَلْقِهِ","وأكْرَمَ مُخْتارٍ أبانَ به الرشْدا",5,"د",2,0],["فَقَوْل حَبِيبٍ إِذْ يَقْول تشُّوقاً","عَسَى وَطَنٌ يَدْنُو إِلَيَّ حَبِيبُ",6,"ب",1,0],["فَقوموا عَلى الأَبوابِ مِنهُ وَهَجهِجوا","فَإِنَّ الفَتى أَفجِر بِشَخصٍ وَأَغلِمِ",7,"م",1,0],["فَقومي يا صَفِيَّةُ في نِساءٍ","بِحَرِّ الشَمسِ لا يَبغينَ ظِلّا",8,"ل",2,0],["فَقَوْمٌ مِنْ مُلُوكٍ كَيْفَ كَانَتْ","مَرَاتِبُهُمْ وَقَوْمٌ مِنْ طَغَامِ",9,"م",1,0],["فَقولا لِمَيٍّ إِن بِها الدارُ ساعَفَت","أَلا ما لِمَيٍّ لا تُؤَدّى فُروضُها",10,"ض",3,0],["فَقْودك للعقول بيوم سلم","كقودك للجيوش بيوم هَيج",11,"ج",1,0],["فَقولا لِواديها الَّذي نَزَلَت بِهِ","أَوادِيَ ذي القَيصومِ أَمرَعتَ وادِيا",12,"ي",2,0],["فَقوما فَقولا بِالَّذي قَد عَلِمتُما","وَلا تَخمِشا وَجهاً وَلا تَحلِقا شَعَر",13,"ر",1,0],["فَقولا لَهُ إِن كانَ يَقسِمُ أَمرَهُ","أَلَمّا يَعِظكَ الدَهرُ أُمُّكَ هابِلُ",14,"ل",1,0],["فَقولا لَهُ مِن أَصدَقِ الوُدِّ أَنَّني","جَعَلتُكَ مِمّا رابَني الدَهرَ مَفزَعا",15,"ع",2,0],["فقولهم أبيض في الهبات","كقولهم أحمر في الصفات",16,"ت",1,0],["فقولا للأميرِ وإنْ رآني","بمَزْجر ما يُهانُ من الكلابِ",17,"ب",1,0],["فَقُولا لِلَّذي أصْبَ","حَ ذا حَطْبٍ وذا قدحِ",18,"ح",1,0],["فقولا له بِئسَ الجنى ماجَنَيْتَه","لنفسِك يا ثلطاً جَنيّاً كما ثُلِطْ",19,"ط",1,0],["فقولا لعمروٍ أنت حرٌّ سِيابُه","لشيمةِ حرٍّ محسنِ الحلم مجْمِلِ",20,"ل",1,0],["فقولا له هبني كما أنا صلعة","ألستُ حصينَ الخَلفِ عفَّ المقدَّمِ",21,"م",1,0],["فقوِّمْ بما دون المجاعةِ إنَّها","سِهامٌ حِدادٌ بلْ سيوفٌ صوارمُ",22,"م",1,0],["فقولا للأميرِ وقتهُ نَفْسِي","صروفَ الحادثاتِ وإن جفاني",23,"ن",2,0],["فَقودوا الجِيادِ المُسنِفاتِ وَأَحقِبوا","عَلى الأَرحَبِيّاتِ الحَديدَ المُقَطَّعا",24,"ع",2,0],["فقوة الألماس","وماله من باس",25,"س",1,0],["فَقَوِّ حَضارَةَ الماضي بِأُخرى","لَها زَهوٌ بِعَصرِكَ وَاِتِّسامُ",26,"م",1,0],["فَقولا لِقَيسٍ قَيسِ عَيلانَ تَجتَنِب","بُحوري إِذا طَمَّت وَعَبَّ عُبابُها",27,"ب",3,0],["فَقَولا لِمَن أَمسى بِهِ مُتَغالِياً","وَلَم يَدرِ أَنّي مُرخِصٌ ذَلِكَ الغالي",28,"ي",1,0],["فَقَولُهُ وَطولُهُ وَحَولُهُ","لِلمُعتَني وَالمُعتَفي وَالمُعتَدي",29,"ي",1,0],["فَقَوَّمتَ زَيغَ الحَقِّ وَهوَ مُمَنَّعٌ","وَقُمتَ بِعِبءِ المُلكِ وَهُوَ شَديدُ",30,"د",1,0],["فَقولا لِمُقرانَ فيمَ المُقامُ","وَهَذا حَصادُكُمُ قَد حَضَر",31,"ر",1,0],["فَقَوَّمتَ لي ما اِعوَجَّ مِن قَصدِ هِمَّتي","وَبَيَّضتَ لي ما اِسوَدَّ مِن وَجهِ مَطلَبي",32,"ي",1,0],["فَقوَّضَت عُمُدَ التَّرحالِ وَاِنصَرَفَت","لَيلاً إِلى حَيثُ لَم تَسرَح وَلَم تَسُمِ",33,"م",1,0],["فقوموا على ساقَيْ حديدٍ وشمِّروا","لنيلِ علاءٍ واهجروا النومَ واطلبوا",34,"ب",3,0],["فَقولي لِواشينا كَما كُنتُ قائِلاً","لِواشيكُمُ رَغماً عَصيتُ عَلى رَغمِ",35,"م",1,0],["فَقولا لَهُ إِن جاءَ أَهلاً وَمَرحَباً","وَلينا لَهُ كَي يَطمَئنَّ وَسَهِّلا",36,"ل",2,0],["فَقوموا وَلا تُعطوا اللِئامَ مَقادَةً","وَقوموا وَإِن كانَ القِيامُ عَلى الجَمرِ",37,"ر",1,0],["فَقَوْمٌ منهم فُتِنُوا بِعِجْلٍ","وَقَوْماً منهم فَتَنَ الصَّليبُ",38,"ب",1,0],["فَقولوا لِلَّذي أَهوى","وَكَيفَ تَكَلُّمُ القَمَرِ",39,"ر",1,0],["فَقوما فَاِلقَحا خَمراً بِماءٍ","فَإِنَّ نِتاجَ بَينِهِما السُرورُ",40,"ر",1,0],["فقومَن واسقني الراحَ","على الإعلان والسُمعه",41,"ع",2,0],["فَقَوَّمَ اللَهُ أَضعانَ القُلوبِ بِهِ","وَأَدرَكَ الدينَ إِذ إِدراكُهُ عَسِرُ",42,"ر",1,0],["فَقولي لَها مِنّي السَلامُ وَرَحمَةٌ","وَأَن اِسأَلِ الفَعّالَ ما فَعَلَت بَعدي",43,"د",2,0],["فَقولي تَصدُقي ذاكُم","صَفِيٌّ مِن بَني كَعبِ",44,"ب",1,0],["فَقَولُكُمُ رَبِّ اِسقِنا غَيرُ مُمطِرٍ","وَلَكِن بِهَذا دانَتِ العُربُ وَالعُجُمُ",45,"م",1,0],["فَقَولٌ جَزاءٌ ما وَقَولٌ تَهاوُنٌ","وَآخَرُ يُجزى إِنسُهُ لا البَهائِمُ",46,"م",1,0],["فقُويْقٌ في أنْفُسِ القَوْمِ بَحْرٌ","وحَصَاةٌ منها تَطِيرُ ثَبِير",47,"ر",1,0],["فَقَوٌّ فَرَهبي فَالسَليلُ فَعاذِبٌ","مَطافيلُ عوذِ الوَحشِ فيهِ عَواطِفُ",48,"ف",1,0],["فقَوسُكَ شِرْيانَةٌ","وَنبْلُكَ جَمْرُ الغَضا",49,"ض",2,0],["فَقولوا لِحِصنٍ إِن تَعانى عَداوَتي","يَبيتُ عَلى نارٍ مِنَ الحُزنِ وَالوَجدِ",50,"د",1,0],["فَقُومَا انْظُرَا ما يَصْنَعُ الصُّبْحُ بِالدُّجَى","فَإِنِّي أَرَى مَا لَيْسَ يَبْلُغُهُ الذُّكْرُ",51,"ر",1,0],["فَقَومُكَ لا تَجهَل عَلَيهِم وَلا تَكُن","لَهُم هَرِشاً تَغتابُهُم وَتُقاتِلُ",52,"ل",1,0],["فقولي إنه القمر!","أو البحر الذي ما انفك بالأمواج..",53,"ج",1,1],[".. فقولي إنه القمر","غداً؟ لا تذكريه!...",53,"ه",1,0],["فقولوا رسول الله يا خير خلقه","وأكرم مختار أبان به الرشدا",54,"د",2,0],["فقوموا برسم الحق فينا فقد عفا","وهبوا لنصر الدين فينا فقد أشفا",55,"ف",2,0],["فقَوَّمَ اللَّهُ أضْغَانَ الْقُلُوبِ بِهِ","وأدرك الدين إذ إدراكه عسرُ",56,"ر",1,0],["فقولوا لهم تعساً فقد سُدَّ مَخْرَجٌ","يَفرُّونَ منه مثلما سُدَّ مَدْخَل",57,"ل",1,0],["فقولوا لمن ظن أنّ الكفاحَ","غَلةُ مزرعةٍ ، تكذِب",58,"ب",1,0],["فقولا له هبني كما ينا صلعة","ألستُ حصينَ الخلفِ عفَّ المقدم",59,"م",1,0],["فقولي اسلمي للحبيب الذي طوى","على المكر درعا ليس يسلم سالمه",60,"م",2,0],["فقوموا بباب الله في كشف كربنا","فكم فرج الباري لاجلكم كربا",61,"ب",2,0],["فقوم لعمري طيب الكون حالهم","وقد ملأ والأرجاء من نشرهم عطرا",62,"ر",2,0],["فقوموا بمسكين ضعيف مشت","تباعد عنه أهله وحبائبه",63,"ب",2,0],["فقوموا اسمعوا في هزمة الرعد صوته","وفي سجعة الغريد ما بات شاديا",64,"ي",2,0],["فقولوا لها إن كنت ترضين عيشتي","فجودي بطيفٍ إن يعزّ وصال",65,"ل",1,0],["فَقوما ففي عُرضِ البَسيطَةِ مُنتَأىً","ومُتَّدَعٌ عَن مَوضِعِ الذُلِّ نازِحُ",66,"ح",1,0],["فَقُومُوا بِعَزمٍ وَاِجعَلُوني مُقَدَّماً","فَأَيُّ حُسامٍ لَم تُرَصَّع حَمائِلُه",67,"ل",2,0],["فَقُولُوا لَهُم إِنّا تَرَكنا أَخاكُمُ","بِحَيث مَآلُ الراغِبينَ مَآلُ",68,"ل",1,0],["فَقَومي الأُلى أَجلُوا قُضاعَةَ عَنوَةً","وَدانَت لَهُم كَلبٌ وَنَهدٌ وَخَولانُ",69,"ن",1,0],["فقَوَّم معوجَّ الليالي بعدله","وذلَّل صعبَ الدهر وهْو كَنود",70,"د",1,0],["فَقولوا لَهم فَليَخلقوا لِشعيرةٍ","وَمِنهُم أصولُ الخلقِ أو يخلقوا بُرّا",71,"ر",2,0],["فقولوا لعبادِ الدنانيرَ ويحهمْ","ألا ذكروا يوماً عبيدَ الدراهمِ",72,"م",1,0],["فقومٌ تدلوا لتحتِ الثرى","وقومٌ تعالوا لفوق الشُّهبْ",73,"ب",1,0],["فَقولا لِكَعبٍ يَثَنّي البُكا","وَلِلنَيءِ مِن لَحمِهِ يَنضُجِ",74,"ج",1,0],["فقوبلنا بإجلالٍ وعزٍّ","وإكرام يعيي الحاسبينا",75,"ن",2,0],["فَقَوافيكَ زُخرفٌ وَبَريقٌ","كَعِظامٍ في مَدفَنٍ من رُخامٍ",76,"م",1,0],["فَقوْلي كلُّه صِدقٌ","وعبدُ اللّه يَشهَد لي",77,"ل",2,0],["فقومي فقد شاب رأسُ الدُّجى","بنور سَنا فجرهِ المُصْبح",78,"ح",1,0],["فقوما إلى ساقِيكما فاهتِفا به","ولا تَفْتحا باباً من الهمِّ مُرْتَجا",79,"ج",2,0],["فَقولوا لِلَّذي آلى يَميناً","أَفِيَّ نَذَرتَ يا أَوسُ النُذورا",80,"ر",2,0],["فقوّتُكم منهُ وقُوتُهُ بكم","فلوذوا من الدنيا بسورٍ وسورة",81,"ه",1,0],["فقولوا إذا ما النَّسرُ طارَ مُحلِّقاً","عَرفناكَ سا