ة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5725,"لدن القوام","https://www.poetsgate.com/ViewPoem.aspx?id=208950",""],[5809,"اشباه","https://www.poetsgate.com/ViewPoem.aspx?id=205191",""],[5817,"أ لو نمتي","https://www.poetsgate.com/ViewPoem.aspx?id=190710",""],[5895,"هَلُمِّى أمَّ معبد خبرينا","https://www.poetsgate.com/ViewPoem.aspx?id=199856",""],[5943,"رضا الإنسانِ صعبٌ بالأماني","https://www.poetsgate.com/ViewPoem.aspx?id=34674",""],[5952,"غنائي ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=205982",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6031,"نَصَحْتَ للَّهِ فلاَ تَتَّهِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46350",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6070,"إذا صلَحتْ نوايا النّاسِ حتماً","https://www.poetsgate.com/ViewPoem.aspx?id=194606",""],[6090,"نهوضا يا شبيبتنا البواقي","https://www.poetsgate.com/ViewPoem.aspx?id=170916",""],[6152,"هواك الغرم والمغنم","https://www.poetsgate.com/ViewPoem.aspx?id=203036",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[6259,"قفوا جددوا عتباً على من لهُ العتب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59358&r=&rc=6",""],[6357,"وأنتِ النساءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76502&r=&rc=11",""]],"verses":[["فَقولا لِلمُنَفَّضِ مِذرَوَيهِ","خُضِ الأَمرَ اِنغِماساً وَاِنغِطاطا",0,"ط",2,0],["فَقَوَّمَ بِالأَذى مِنها صِعاداً","وَذَلَّلَ بِالرُقى مِنها صِعابا",1,"ب",2,0],["فَقولوا لَها قولي لِفَوزٍ تَعَطَّفي","عَلى جَسَدٍ لا رَوحَ فيهِ سَليبِ",2,"ب",1,0],["فَقولوا لَهُم جِئناهُ مِن ماءِ زَمزَمٍ","لِنَشفيهِ مِن داءٍ بِهِ بِذَنوبِ",2,"ب",1,0],["فَقولي لَها يا شَمسُ عَنِّيَ ما الَّذي","يَسُرُّكِ في قَتلي أَما لَكِ مِن بُقيا",3,"ا",1,0],["فَقوموا برَسْمِ الحقِّ فِيها فقَدْ عَفا","وهُبّوا لنَصْرِ الدّينِ فيها فقدْ أشْفَى",4,"ف",2,0],["فقولا رسولَ الله يا خيْرَ خَلْقِهِ","وأكْرَمَ مُخْتارٍ أبانَ به الرشْدا",5,"د",2,0],["فَقَوْل حَبِيبٍ إِذْ يَقْول تشُّوقاً","عَسَى وَطَنٌ يَدْنُو إِلَيَّ حَبِيبُ",6,"ب",1,0],["فَقوموا عَلى الأَبوابِ مِنهُ وَهَجهِجوا","فَإِنَّ الفَتى أَفجِر بِشَخصٍ وَأَغلِمِ",7,"م",1,0],["فَقومي يا صَفِيَّةُ في نِساءٍ","بِحَرِّ الشَمسِ لا يَبغينَ ظِلّا",8,"ل",2,0],["فَقَوْمٌ مِنْ مُلُوكٍ كَيْفَ كَانَتْ","مَرَاتِبُهُمْ وَقَوْمٌ مِنْ طَغَامِ",9,"م",1,0],["فَقولا لِمَيٍّ إِن بِها الدارُ ساعَفَت","أَلا ما لِمَيٍّ لا تُؤَدّى فُروضُها",10,"ض",3,0],["فَقْودك للعقول بيوم سلم","كقودك للجيوش بيوم هَيج",11,"ج",1,0],["فَقولا لِواديها الَّذي نَزَلَت بِهِ","أَوادِيَ ذي القَيصومِ أَمرَعتَ وادِيا",12,"ي",2,0],["فَقوما فَقولا بِالَّذي قَد عَلِمتُما","وَلا تَخمِشا وَجهاً وَلا تَحلِقا شَعَر",13,"ر",1,0],["فَقولا لَهُ إِن كانَ يَقسِمُ أَمرَهُ","أَلَمّا يَعِظكَ الدَهرُ أُمُّكَ هابِلُ",14,"ل",1,0],["فَقولا لَهُ مِن أَصدَقِ الوُدِّ أَنَّني","جَعَلتُكَ مِمّا رابَني الدَهرَ مَفزَعا",15,"ع",2,0],["فقولهم أبيض في الهبات","كقولهم أحمر في الصفات",16,"ت",1,0],["فقولا للأميرِ وإنْ رآني","بمَزْجر ما يُهانُ من الكلابِ",17,"ب",1,0],["فَقُولا لِلَّذي أصْبَ","حَ ذا حَطْبٍ وذا قدحِ",18,"ح",1,0],["فقولا له بِئسَ الجنى ماجَنَيْتَه","لنفسِك يا ثلطاً جَنيّاً كما ثُلِطْ",19,"ط",1,0],["فقولا لعمروٍ أنت حرٌّ سِيابُه","لشيمةِ حرٍّ محسنِ الحلم مجْمِلِ",20,"ل",1,0],["فقولا له هبني كما أنا صلعة","ألستُ حصينَ الخَلفِ عفَّ المقدَّمِ",21,"م",1,0],["فقوِّمْ بما دون المجاعةِ إنَّها","سِهامٌ حِدادٌ بلْ سيوفٌ صوارمُ",22,"م",1,0],["فقولا للأميرِ وقتهُ نَفْسِي","صروفَ الحادثاتِ وإن جفاني",23,"ن",2,0],["فَقودوا الجِيادِ المُسنِفاتِ وَأَحقِبوا","عَلى الأَرحَبِيّاتِ الحَديدَ المُقَطَّعا",24,"ع",2,0],["فقوة الألماس","وماله من باس",25,"س",1,0],["فَقَوِّ حَضارَةَ الماضي بِأُخرى","لَها زَهوٌ بِعَصرِكَ وَاِتِّسامُ",26,"م",1,0],["فَقولا لِقَيسٍ قَيسِ عَيلانَ تَجتَنِب","بُحوري إِذا طَمَّت وَعَبَّ عُبابُها",27,"ب",3,0],["فَقَولا لِمَن أَمسى بِهِ مُتَغالِياً","وَلَم يَدرِ أَنّي مُرخِصٌ ذَلِكَ الغالي",28,"ل",2,0],["فَقَولُهُ وَطولُهُ وَحَولُهُ","لِلمُعتَني وَالمُعتَفي وَالمُعتَدي",29,"د",2,0],["فَقَوَّمتَ زَيغَ الحَقِّ وَهوَ مُمَنَّعٌ","وَقُمتَ بِعِبءِ المُلكِ وَهُوَ شَديدُ",30,"د",1,0],["فَقولا لِمُقرانَ فيمَ المُقامُ","وَهَذا حَصادُكُمُ قَد حَضَر",31,"ر",1,0],["فَقَوَّمتَ لي ما اِعوَجَّ مِن قَصدِ هِمَّتي","وَبَيَّضتَ لي ما اِسوَدَّ مِن وَجهِ مَطلَبي",32,"ب",2,0],["فَقوَّضَت عُمُدَ التَّرحالِ وَاِنصَرَفَت","لَيلاً إِلى حَيثُ لَم تَسرَح وَلَم تَسُمِ",33,"م",1,0],["فقوموا على ساقَيْ حديدٍ وشمِّروا","لنيلِ علاءٍ واهجروا النومَ واطلبوا",34,"ب",3,0],["فَقولي لِواشينا كَما كُنتُ قائِلاً","لِواشيكُمُ رَغماً عَصيتُ عَلى رَغمِ",35,"م",1,0],["فَقولا لَهُ إِن جاءَ أَهلاً وَمَرحَباً","وَلينا لَهُ كَي يَطمَئنَّ وَسَهِّلا",36,"ل",2,0],["فَقوموا وَلا تُعطوا اللِئامَ مَقادَةً","وَقوموا وَإِن كانَ القِيامُ عَلى الجَمرِ",37,"ر",1,0],["فَقَوْمٌ منهم فُتِنُوا بِعِجْلٍ","وَقَوْماً منهم فَتَنَ الصَّليبُ",38,"ب",1,0],["فَقولوا لِلَّذي أَهوى","وَكَيفَ تَكَلُّمُ القَمَرِ",39,"ر",1,0],["فَقوما فَاِلقَحا خَمراً بِماءٍ","فَإِنَّ نِتاجَ بَينِهِما السُرورُ",40,"ر",1,0],["فقومَن واسقني الراحَ","على الإعلان والسُمعه",41,"ع",2,0],["فَقَوَّمَ اللَهُ أَضعانَ القُلوبِ بِهِ","وَأَدرَكَ الدينَ إِذ إِدراكُهُ عَسِرُ",42,"ر",1,0],["فَقولي لَها مِنّي السَلامُ وَرَحمَةٌ","وَأَن اِسأَلِ الفَعّالَ ما فَعَلَت بَعدي",43,"د",2,0],["فَقولي تَصدُقي ذاكُم","صَفِيٌّ مِن بَني كَعبِ",44,"ب",1,0],["فَقَولُكُمُ رَبِّ اِسقِنا غَيرُ مُمطِرٍ","وَلَكِن بِهَذا دانَتِ العُربُ وَالعُجُمُ",45,"م",1,0],["فَقَولٌ جَزاءٌ ما وَقَولٌ تَهاوُنٌ","وَآخَرُ يُجزى إِنسُهُ لا البَهائِمُ",46,"م",1,0],["فقُويْقٌ في أنْفُسِ القَوْمِ بَحْرٌ","وحَصَاةٌ منها تَطِيرُ ثَبِير",47,"ر",1,0],["فَقَوٌّ فَرَهبي فَالسَليلُ فَعاذِبٌ","مَطافيلُ عوذِ الوَحشِ فيهِ عَواطِفُ",48,"ف",1,0],["فقَوسُكَ شِرْيانَةٌ","وَنبْلُكَ جَمْرُ الغَضا",49,"ض",2,0],["فَقولوا لِحِصنٍ إِن تَعانى عَداوَتي","يَبيتُ عَلى نارٍ مِنَ الحُزنِ وَالوَجدِ",50,"د",1,0],["فَقُومَا انْظُرَا ما يَصْنَعُ الصُّبْحُ بِالدُّجَى","فَإِنِّي أَرَى مَا لَيْسَ يَبْلُغُهُ الذُّكْرُ",51,"ر",1,0],["فَقَومُكَ لا تَجهَل عَلَيهِم وَلا تَكُن","لَهُم هَرِشاً تَغتابُهُم وَتُقاتِلُ",52,"ل",1,0],["فقولي إنه القمر!","أو البحر الذي ما انفك بالأمواج..",53,"ج",1,1],[".. فقولي إنه القمر","غداً؟ لا تذكريه!...",53,"ه",1,0],["فقولوا رسول الله يا خير خلقه","وأكرم مختار أبان به الرشدا",54,"د",2,0],["فقوموا برسم الحق فينا فقد عفا","وهبوا لنصر الدين فينا فقد أشفا",55,"ف",2,0],["فقَوَّمَ اللَّهُ أضْغَانَ الْقُلُوبِ بِهِ","وأدرك الدين إذ إدراكه عسرُ",56,"ر",1,0],["فقولوا لهم تعساً فقد سُدَّ مَخْرَجٌ","يَفرُّونَ منه مثلما سُدَّ مَدْخَل",57,"ل",1,0],["فقولوا لمن ظن أنّ الكفاحَ","غَلةُ مزرعةٍ ، تكذِب",58,"ب",1,0],["فقولا له هبني كما ينا صلعة","ألستُ حصينَ الخلفِ عفَّ المقدم",59,"م",1,0],["فقولي اسلمي للحبيب الذي طوى","على المكر درعا ليس يسلم سالمه",60,"م",2,0],["فقوموا بباب الله في كشف كربنا","فكم فرج الباري لاجلكم كربا",61,"ب",2,0],["فقوم لعمري طيب الكون حالهم","وقد ملأ والأرجاء من نشرهم عطرا",62,"ر",2,0],["فقوموا بمسكين ضعيف مشت","تباعد عنه أهله وحبائبه",63,"ب",2,0],["فقوموا اسمعوا في هزمة الرعد صوته","وفي سجعة الغريد ما بات شاديا",64,"ي",2,0],["فقولوا لها إن كنت ترضين عيشتي","فجودي بطيفٍ إن يعزّ وصال",65,"ل",1,0],["فَقوما ففي عُرضِ البَسيطَةِ مُنتَأىً","ومُتَّدَعٌ عَن مَوضِعِ الذُلِّ نازِحُ",66,"ح",1,0],["فَقُومُوا بِعَزمٍ وَاِجعَلُوني مُقَدَّماً","فَأَيُّ حُسامٍ لَم تُرَصَّع حَمائِلُه",67,"ل",2,0],["فَقُولُوا لَهُم إِنّا تَرَكنا أَخاكُمُ","بِحَيث مَآلُ الراغِبينَ مَآلُ",68,"ل",1,0],["فَقَومي الأُلى أَجلُوا قُضاعَةَ عَنوَةً","وَدانَت لَهُم كَلبٌ وَنَهدٌ وَخَولانُ",69,"ن",1,0],["فقَوَّم معوجَّ الليالي بعدله","وذلَّل صعبَ الدهر وهْو كَنود",70,"د",1,0],["فَقولوا لَهم فَليَخلقوا لِشعيرةٍ","وَمِنهُم أصولُ الخلقِ أو يخلقوا بُرّا",71,"ر",2,0],["فقولوا لعبادِ الدنانيرَ ويحهمْ","ألا ذكروا يوماً عبيدَ الدراهمِ",72,"م",1,0],["فقومٌ تدلوا لتحتِ الثرى","وقومٌ تعالوا لفوق الشُّهبْ",73,"ب",1,0],["فَقولا لِكَعبٍ يَثَنّي البُكا","وَلِلنَيءِ مِن لَحمِهِ يَنضُجِ",74,"ج",1,0],["فقوبلنا بإجلالٍ وعزٍّ","وإكرام يعيي الحاسبينا",75,"ن",2,0],["فَقَوافيكَ زُخرفٌ وَبَريقٌ","ك