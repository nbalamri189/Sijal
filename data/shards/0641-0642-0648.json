{"poems":[[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[55,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[55,"إلى الله أشكو إنه موضع الشكوى","https://www.aldiwan.net/poem26557.html","الطويل"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[42,"إذا ما رأيتم ناشىء الحي منكم","https://www.aldiwan.net/poem50341.html","الطويل"],[10,"أيا عيني ويحكما استهلا","https://www.aldiwan.net/poem21121.html","الوافر"],[93,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[30,"بكيت وما يبكيك من رسم منزل","https://www.aldiwan.net/poem29575.html","الطويل"],[88,"سمي المصطفى لا زلت تعلو","https://www.aldiwan.net/poem44816.html","الوافر"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[4,"تمنى ابنتاي أن يعيش أبوهما","https://www.aldiwan.net/poem21169.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[47,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"ألا يا أيها الشاكر والمطنب في المدح","https://www.aldiwan.net/poem9411.html","الهزج"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"تجلد عمرو للهجاء تجملا","https://www.aldiwan.net/poem65974.html","الطويل"],[51,"يعيرني لبس العمامة سادرا","https://www.aldiwan.net/poem66007.html","الطويل"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"جرى الأضحى رسيل المهرجان","https://www.aldiwan.net/poem66393.html","الوافر"],[38,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"بأرض الجيزة اجتاز الغمام","https://www.aldiwan.net/poem8084.html","الوافر"],[28,"لئن أصبحت قيس تلوي رؤوسها","https://www.aldiwan.net/poem1278.html",""],[66,"تيقن مذ أعرضت أني له سالي","https://www.aldiwan.net/poem40100.html","الطويل"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[44,"أمقران يا ابن بنات العلوج","https://www.aldiwan.net/poem30034.html","المتقارب"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[31,"أقلي البعاد أم بكر فإنما","https://www.aldiwan.net/poem41335.html","الخفيف"],[31,"خليلي عوجا نسأل اليوم منزلا","https://www.aldiwan.net/poem41854.html","السريع"],[22,"ألا كل أرماح قصار أذلة","https://www.aldiwan.net/poem21671.html","الطويل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"أراح الله من بصري","https://www.aldiwan.net/poem63327.html","مجزوء الوافر"],[48,"مضى أيلول وارتفع الحرور","https://www.aldiwan.net/poem63370.html","الوافر"],[48,"نك ابن العم ذا القربى","https://www.aldiwan.net/poem66212.html","الهزج"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[50,"تصلي الضحى شتى وتمسي فنلتقي","https://www.aldiwan.net/poem63878.html","الطويل"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[46,"مكان ودهر أحرزا كل مدرك","https://www.aldiwan.net/poem23282.html","الطويل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[76,"أأحرم منك الرضا","https://www.aldiwan.net/poem38839.html","مجزوء المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2268","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[50,"لاح الهوى واستنار العدلُ والبصر","https://www.poetsgate.com/ViewPoem.aspx?id=22647",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[51,"يُعيّرني لُبْسَ العمامة ِ سادراً","https://www.poetsgate.com/ViewPoem.aspx?id=30354",""]],"verses":[["فَقولا لِلمُنَفَّضِ مِذرَوَيهِ","خُضِ الأَمرَ اِنغِماساً وَاِنغِطاطا",0,"ط",2,0],["فَقَوَّمَ بِالأَذى مِنها صِعاداً","وَذَلَّلَ بِالرُقى مِنها صِعابا",1,"ب",2,0],["فَقولوا لَها قولي لِفَوزٍ تَعَطَّفي","عَلى جَسَدٍ لا رَوحَ فيهِ سَليبِ",2,"ب",1,0],["فَقولوا لَهُم جِئناهُ مِن ماءِ زَمزَمٍ","لِنَشفيهِ مِن داءٍ بِهِ بِذَنوبِ",2,"ب",1,0],["فَقولي لَها يا شَمسُ عَنِّيَ ما الَّذي","يَسُرُّكِ في قَتلي أَما لَكِ مِن بُقيا",3,"ا",1,0],["فَقوموا برَسْمِ الحقِّ فِيها فقَدْ عَفا","وهُبّوا لنَصْرِ الدّينِ فيها فقدْ أشْفَى",4,"ف",2,0],["فقولا رسولَ الله يا خيْرَ خَلْقِهِ","وأكْرَمَ مُخْتارٍ أبانَ به الرشْدا",5,"د",2,0],["فَقَوْل حَبِيبٍ إِذْ يَقْول تشُّوقاً","عَسَى وَطَنٌ يَدْنُو إِلَيَّ حَبِيبُ",6,"ب",1,0],["فَقوموا عَلى الأَبوابِ مِنهُ وَهَجهِجوا","فَإِنَّ الفَتى أَفجِر بِشَخصٍ وَأَغلِمِ",7,"م",1,0],["فَقومي يا صَفِيَّةُ في نِساءٍ","بِحَرِّ الشَمسِ لا يَبغينَ ظِلّا",8,"ل",2,0],["فَقَوْمٌ مِنْ مُلُوكٍ كَيْفَ كَانَتْ","مَرَاتِبُهُمْ وَقَوْمٌ مِنْ طَغَامِ",9,"م",1,0],["فَقولا لِمَيٍّ إِن بِها الدارُ ساعَفَت","أَلا ما لِمَيٍّ لا تُؤَدّى فُروضُها",10,"ض",3,0],["فَقْودك للعقول بيوم سلم","كقودك للجيوش بيوم هَيج",11,"ج",1,0],["فَقولا لِواديها الَّذي نَزَلَت بِهِ","أَوادِيَ ذي القَيصومِ أَمرَعتَ وادِيا",12,"ي",2,0],["فَقوما فَقولا بِالَّذي قَد عَلِمتُما","وَلا تَخمِشا وَجهاً وَلا تَحلِقا شَعَر",13,"ر",1,0],["فَقولا لَهُ إِن كانَ يَقسِمُ أَمرَهُ","أَلَمّا يَعِظكَ الدَهرُ أُمُّكَ هابِلُ",14,"ل",1,0],["فَقولا لَهُ مِن أَصدَقِ الوُدِّ أَنَّني","جَعَلتُكَ مِمّا رابَني الدَهرَ مَفزَعا",15,"ع",2,0],["فقولهم أبيض في الهبات","كقولهم أحمر في الصفات",16,"ت",1,0],["فقولا للأميرِ وإنْ رآني","بمَزْجر ما يُهانُ من الكلابِ",17,"ب",1,0],["فَقُولا لِلَّذي أصْبَ","حَ ذا حَطْبٍ وذا قدحِ",18,"ح",1,0],["فقولا له بِئسَ الجنى ماجَنَيْتَه","لنفسِك يا ثلطاً جَنيّاً كما ثُلِطْ",19,"ط",1,0],["فقولا لعمروٍ أنت حرٌّ سِيابُه","لشيمةِ حرٍّ محسنِ الحلم مجْمِلِ",20,"ل",1,0],["فقولا له هبني كما أنا صلعة","ألستُ حصينَ الخَلفِ عفَّ المقدَّمِ",21,"م",1,0],["فقوِّمْ بما دون المجاعةِ إنَّها","سِهامٌ حِدادٌ بلْ سيوفٌ صوارمُ",22,"م",1,0],["فقولا للأميرِ وقتهُ نَفْسِي","صروفَ الحادثاتِ وإن جفاني",23,"ن",2,0],["فَقودوا الجِيادِ المُسنِفاتِ وَأَحقِبوا","عَلى الأَرحَبِيّاتِ الحَديدَ المُقَطَّعا",24,"ع",2,0],["فقوة الألماس","وماله من باس",25,"س",1,0],["فَقَوِّ حَضارَةَ الماضي بِأُخرى","لَها زَهوٌ بِعَصرِكَ وَاِتِّسامُ",26,"م",1,0],["فَقولا لِقَيسٍ قَيسِ عَيلانَ تَجتَنِب","بُحوري إِذا طَمَّت وَعَبَّ عُبابُها",27,"ب",3,0],["فَقَولا لِمَن أَمسى بِهِ مُتَغالِياً","وَلَم يَدرِ أَنّي مُرخِصٌ ذَلِكَ الغالي",28,"ي",1,0],["فَقَولُهُ وَطولُهُ وَحَولُهُ","لِلمُعتَني وَالمُعتَفي وَالمُعتَدي",29,"ي",1,0],["فَقَوَّمتَ زَيغَ الحَقِّ وَهوَ مُمَنَّعٌ","وَقُمتَ بِعِبءِ المُلكِ وَهُوَ شَديدُ",30,"د",1,0],["فَقولا لِمُقرانَ فيمَ المُقامُ","وَهَذا حَصادُكُمُ قَد حَضَر",31,"ر",1,0],["فَقَوَّمتَ لي ما اِعوَجَّ مِن قَصدِ هِمَّتي","وَبَيَّضتَ لي ما اِسوَدَّ مِن وَجهِ مَطلَبي",32,"ي",1,0],["فَقوَّضَت عُمُدَ التَّرحالِ وَاِنصَرَفَت","لَيلاً إِلى حَيثُ لَم تَسرَح وَلَم تَسُمِ",33,"م",1,0],["فقوموا على ساقَيْ حديدٍ وشمِّروا","لنيلِ علاءٍ واهجروا النومَ واطلبوا",34,"ب",3,0],["فَقولي لِواشينا كَما كُنتُ قائِلاً","لِواشيكُمُ رَغماً عَصيتُ عَلى رَغمِ",35,"م",1,0],["فَقولا لَهُ إِن جاءَ أَهلاً وَمَرحَباً","وَلينا لَهُ كَي يَطمَئنَّ وَسَهِّلا",36,"ل",2,0],["فَقوموا وَلا تُعطوا اللِئامَ مَقادَةً","وَقوموا وَإِن كانَ القِيامُ عَلى الجَمرِ",37,"ر",1,0],["فَقَوْمٌ منهم فُتِنُوا بِعِجْلٍ","وَقَوْماً منهم فَتَنَ الصَّليبُ",38,"ب",1,0],["فَقولوا لِلَّذي أَهوى","وَكَيفَ تَكَلُّمُ القَمَرِ",39,"ر",1,0],["فَقوما فَاِلقَحا خَمراً بِماءٍ","فَإِنَّ نِتاجَ بَينِهِما السُرورُ",40,"ر",1,0],["فقومَن واسقني الراحَ","على الإعلان والسُمعه",41,"ع",2,0],["فَقَوَّمَ اللَهُ أَضعانَ القُلوبِ بِهِ","وَأَدرَكَ الدينَ إِذ إِدراكُهُ عَسِرُ",42,"ر",1,0],["فَقولي لَها مِنّي السَلامُ وَرَحمَةٌ","وَأَن اِسأَلِ الفَعّالَ ما فَعَلَت بَعدي",43,"د",2,0],["فَقولي تَصدُقي ذاكُم","صَفِيٌّ مِن بَني كَعبِ",44,"ب",1,0],["فَقَولُكُمُ رَبِّ اِسقِنا غَيرُ مُمطِرٍ","وَلَكِن بِهَذا دانَتِ العُربُ وَالعُجُمُ",45,"م",1,0],["فَقَولٌ جَزاءٌ ما وَقَولٌ تَهاوُنٌ","وَآخَرُ يُجزى إِنسُهُ لا البَهائِمُ",46,"م",1,0],["فقُويْقٌ في أنْفُسِ القَوْمِ بَحْرٌ","وحَصَاةٌ منها تَطِيرُ ثَبِير",47,"ر",1,0],["فَقَوٌّ فَرَهبي فَالسَليلُ فَعاذِبٌ","مَطافيلُ عوذِ الوَحشِ فيهِ عَواطِفُ",48,"ف",1,0],["فقَوسُكَ شِرْيانَةٌ","وَنبْلُكَ جَمْرُ الغَضا",49,"ض",2,0],["فَقولوا لِحِصنٍ إِن تَعانى عَداوَتي","يَبيتُ عَلى نارٍ مِنَ الحُزنِ وَالوَجدِ",50,"د",1,0],["فَقُومَا انْظُرَا ما يَصْنَعُ الصُّبْحُ بِالدُّجَى","فَإِنِّي أَرَى مَا لَيْسَ يَبْلُغُهُ الذُّكْرُ",51,"ر",1,0],["فَقَومُكَ لا تَجهَل عَلَيهِم وَلا تَكُن","لَهُم هَرِشاً تَغتابُهُم وَتُقاتِلُ",52,"ل",1,0],["فقولي إنه القمر!","أو البحر الذي ما انفك بالأمواج..",53,"ج",1,1],[".. فقولي إنه القمر","غداً؟ لا تذكريه!...",53,"ه",1,0],["فقولوا رسول الله يا خير خلقه","وأكرم مختار أبان به الرشدا",54,"د",2,0],["فقوموا برسم الحق فينا فقد عفا","وهبوا لنصر الدين فينا فقد أشفا",55,"ف",2,0],["فقَوَّمَ اللَّهُ أضْغَانَ الْقُلُوبِ بِهِ","وأدرك الدين إذ إدراكه عسرُ",56,"ر",1,0],["فقولوا لهم تعساً فقد سُدَّ مَخْرَجٌ","يَفرُّونَ منه مثلما سُدَّ مَدْخَل",57,"ل",1,0],["فقولوا لمن ظن أنّ الكفاحَ","غَلةُ مزرعةٍ ، تكذِب",58,"ب",1,0],["فقولا له هبني كما ينا صلعة","ألستُ حصينَ الخلفِ عفَّ المقدم",59,"م",1,0]]}