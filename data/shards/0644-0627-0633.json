يل"],[536,"يا جلال العصر علما","https://www.aldiwan.net/poem47938.html","عموديه"],[536,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[536,"مثل التهامي ما في الأرض من بطل","https://www.aldiwan.net/poem47989.html","عموديه"],[536,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[536,"لله أيام مع الأحباب","https://www.aldiwan.net/poem48291.html","عموديه"],[549,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[549,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[549,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[556,"كن غنيا في صورة الفقراء","https://www.aldiwan.net/poem35079.html","الخفيف"],[560,"لمن الخيام ومن هنالك نازل","https://www.aldiwan.net/poem52901.html","الكامل"],[565,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[573,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"],[573,"لأسرفت يا حماه في شدة الوقد","https://www.aldiwan.net/poem2968.html","الطويل"],[573,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"],[573,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[584,"أهلا بوجهك لا حجبت عن نظري","https://www.aldiwan.net/poem17534.html","البسيط"],[584,"يمينا بطيب شباب الزمان","https://www.aldiwan.net/poem17808.html","المتقارب"],[585,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"]],"verses":[["لَأَستَمطِرَنَّ العِزِّ نُفساً مُريغَةً","وُرودَ عَلاءٍ أَو وُرودَ حِمامِ",0,"م",1,0],["لا سَحَبَ النَشوانُ مِن ذَيلِهِ","فيها وَلا دَرَّت عَلَيها الكُروم",1,"م",1,0],["لا سَفيرٌ إِلَيكَ إِلّا مَعالي","كَ وَلا شافِعٌ إِلَيكَ سِواكا",2,"ك",2,0],["لَأُسَقِّيَنَّكَ كَأسَ لاذِعَةٍ","لا العَبُّ يُنفِدُها وَلا المَصُّ",3,"ص",1,0],["لا سُقِيتُنَّ الحَيا مِنْ إِبلٍ","تَذْرَعُ الأرْضَ بِصَحْبي وَتَبوعُ",4,"ع",1,0],["لأَسْتَودِعَنَّ الدّهْرَ فيكمُ قَصائِداً","وهنَّ يُوشِّحْنَ الثّناءَ المُخلَّدا",5,"د",2,0],["لا سَيءٌّ عِندَكُم يُغني وَلا حَسَنٌ","فَالمُحسِنونَ سَواءٌ وَالمُسيئونا",6,"ن",2,0],["لِأَسرَعَ ما مَلَلتِ فَدَتكِ نَفسي","وَخُنتِ وَلَيسَ يُعجِبُني المَلولُ",7,"ل",1,0],["لَأَستَمسِكَن بِالوُدِّ ما ذرَّ شارِقٌ","وَما ناحَ قُمريٌ وَما لاحَ كَوكَبُ",8,"ب",1,0],["لاَ سِيَّمَا مَنْ دَخَلتْ أُذْنُهُ","وَانْتَفَخَتْ مِنْ تَحْتِ أَثْوَابِهِ",9,"ب",2,0],["لا سِرُّهُنَّ لَدَينا ضائِعٌ مَذِقٌ","وَكاتِماتٌ إِذا اِستودِعنَ أَسراري",10,"ي",1,0],["لَاِستَنزَلَتهُ عَيطَلٌ مَكحولَةٌ","حَوراءُ جادَ لَها النِجادَ خَريفُ",11,"ف",1,0],["لَأَستَشعِرَنَّ أَعلى دَريسَيَّ مُسلِماً","لَوَجهِ الَّذي يُحيي الأَنامَ وَيَقتُلُ",12,"ل",1,0],["لا سَكَّنَ اللَهُ قَلباً عَقَّ ذِكرَكُمُ","فَلَم يَطِر بِجَناحِ الشَوقِ خَفّاقا",13,"ق",2,0],["لَأَستَجِدَّنَّ في عِشقي لَها زَمَناً","يُنسي سَوالِفَ أَيّامي وَأَزماني",14,"ن",2,0],["لا سوقَةٌ مِنهُمُ يَبقى وَلا مَلِكٌ","مِمَّن تَمَلَّكَهُ الأَحرارُ وَالرومُ",15,"م",1,0],["لا سُبَّةً تَخْشَى وَلا شُبْهَةً","مِنْ سُقْمَاءِ الرَّأْيِ أَوْ رُمْدِهِ",16,"د",2,0],["لا سافِرُ النِيِّ مَدخولٌ وَلا هَبِجٌ","عاري العِظامِ عَلَيهِ الوَدعُ مَنظومُ",17,"م",1,1],["لا سيما لما رأى من ثغرهِ","زهراً وأين الزهر من تلك الدُرَرْ",18,"ر",1,0],["لِأَسماءَ إِذ لَمّا تَفُتنا دِيارُها","وَلَم نَخشَ مِن أَسبابِها أَن تَجَذَّما",19,"م",2,0],["لِإِسمَعيلَ بي وَبَنيهِ فَخرٌ","وَفي إِسحَقَ بي وَبَنيهِ عُجبُ",20,"ب",1,0],["لا سمع للاّثم في حبكم","أعوذ بالله السميع العليم",21,"م",1,0],["لا سيما في ربيع مُمْرعٍ غَدقٍ","ما انْفَكّ يُتْبعُ أنواءً بأنواءِ",22,"ا",2,0],["لا سيّما بفمٍ يَظَل","لُ مَنِيُّ ناكتِهِ شرابهْ",23,"ب",2,0],["لا سَلَبَ اللّهُ سرابيلَكُمْ","من هذه النُّعمى ولن تُسلبا",24,"ب",2,0],["لا سيما وله وجهُ به قحةٌ","وعارضٌ كجبين الطير مَهْلوبُ",25,"ب",1,0],["لا سيما وقد اكتهلت وقد تَرى","ورع الإمام وبأْسَهُ المتهيَّبا",26,"ب",2,0],["لاسيما ولعلَّ الهزلَ غايتُهُ","لا غيرُهُ ولبذر الجدِّ مُحتَرثُ",27,"ث",1,0],["لاسِيما لأبي البنا","تِ الناظرات من الفُرَجْ",28,"ج",1,0],["لا سِيَّما من كان يو","قن أنه إن مات عائدْ",29,"د",1,0],["لا سيما والعذر في تقليلها","أنَّ امتنانك مُبْدَأٌ ومُعادُ",30,"د",1,0],["لا سيَّما من عَفْوتُ عنه فأطْ","غَتْه أَناتي وهيَّجَتْ صَيدضهْ",31,"د",3,0],["لأستميحنّ كلّ ذاك لمب","كائيك بعد استماحة الدِّررِ",32,"ر",1,0],["لاسيّما ندّك الذي منعتْ","جوْدته أن يُسبَّ عطاره",33,"ر",2,0],["لاسيما ولقولي فيه منزلةٌ","من سيد مثَّلاهُ الشمس والقمر",34,"ر",1,0],["لا سقاك الإلهُ غيثاً ولا أر","واك إلا من ريقها الممزوز",35,"ز",1,0],["لا سيما والذي يكفيه حاضِرُه","لعارفِ اللَهِ من هاتيك مُمْتعضُ",36,"ض",1,0],["لا سبط الخطو في المهارب حا","شاك ولكن في كل مزدحَف",37,"ف",1,0],["لا سلاليمُك الطّوال تُنجّي","ك من سَطْوَتي ولا أنفاقُك",38,"ك",1,0],["لأسيّرَنَّك في البلا","دِ بِما أقَمْتَ وطال خَفْضُك",39,"ك",1,0],["لا سقى اللَّهُ جسمَهُ من حيا المُز","نِ ولا رُوحَه من السلسبيل",40,"ل",1,0],["لا سيما في مديح ممتدَحٍ","مشتهر الذكر سائر المثلِ",41,"ل",1,0],["لا سيّما عند خضبِ الشيخ لحيَتَهُ","ورأسه واختضابُ الشيخ منتصلُ",42,"ل",1,0],["لاسْتوى عندك بيْتٌ","يتحدَّاكَ وسَهْمُ",43,"م",1,0],["لا سؤالٌ من بعد رِفدك إلا","كالزنا بعد نعمةِ الإحصان",44,"ن",1,0],["لا سيما والمديحُ زورٌ","والحقُّ في تلكُمُ الخَبايا",45,"ا",3,0],["لِأَسماءَ مُحتَلٌّ بِناظِرَةِ البِشرِ","قَديمٌ وَلَمّا يَعفُهُ سالِفُ الدَهرِ",46,"ر",1,1],["لِأُساجِلَ الوَرقاءَ في تَغريدِها","وَتَهُزُّ روحي نَفحَةُ المِزمارِ",47,"ر",1,0],["لِأُسامِرَ الأَقمارَ في أَفلاكِها","تَحتَ الظَلامِ إِذا غَفا سُمّاري",47,"ر",2,0],["لا سِلمَ ما بَيني وَبَينَهُمُ","لا سِلمَ بَينَ الهِر وَالفَأرِ",48,"ر",1,0],["لا سُموماً مِنَ السَوافي اللَواتي","تَملَءُ الأَرضَ في الظَلامِ عَويلا",49,"ل",2,0],["لا سافِحٌ مِن سَوافِحِ الطَيرِ يَث","نيني وَلا ناعِبٌ إِذا نَعَبا",50,"ب",2,0],["لا سيفه ماض ولا","خميسه عرمرم",51,"م",1,0],["لا سِرتِ مِن إِبِلٍ لَوَ أَنّي فَوقَها","لَمَحَت حَرارَةُ مَدمَعَيَّ سِماتِها",52,"ت",3,0],["لأستخرج الروح من إخوتي","فطوعي شبابهم والكهولُ",53,"ل",1,0],["لا سلوةٌ فيطيبُ عن","كَ ولا حِمامُ فيستريحُ",54,"ح",1,0],["لَاِستَهَلَّت سَماؤُهُ فَمُطِرنا","ذَهَباً في اِنهِلالِ تِلكَ الذِهابِ",55,"ب",1,0],["لَأَسرَعَ في عَقلي الَّذي بِتُّ مَوهِناً","أَرى مِن قَريبٍ لا الَّذي بِتُّ أَشرَبُ",56,"ب",1,0],["لا سَبَبي واهِنٌ لَدَيهِ وَلا","وَجهِيَ عَن وَجهِهِ بِمَحجوبِ",57,"ب",1,0],["لَأَسمَعتَني في ظُلمَةِ الهَجرِ دَعوَةً","عَلى الهَجرِ في وَقتٍ مِنَ العَفوِ مُقمِرِ",58,"ر",1,0],["لاسِيَّما في بَدءِ عَدلٍ لَم يَخُن","فيهِ أَمانَتَهُ الإِمامُ الناصِرُ",59,"ر",1,0],["لِأَسلَحَ حينَ يُمسي مِن حُبارى","وَأَضرَطَ حينَ يُصبِحُ مِن حِمارِ",60,"ر",1,0],["لَأَسماءَ إِذ أَهلي لِأَهلِكِ جيرَةٌ","وَإِذ كُلُّ مَوعودٍ لَها أَنتَ آمِلُه",61,"ل",2,1],["لا سُقِيَتْ حانةُ أُتْرُجَّةٍ","غَيْثاً ولا حانةُ مولودِها",62,"د",3,1],["لا سُقِيَت أَطلالُكَ الداثِرَه","وَلا اِنقَضَت عَثرَتُكَ العاثِرَه",63,"ر",2,1],["لا سَأَلتُ الخَلاصَ مِنكَ وَإِن كُن","تَ بَلاءَ الهَوى عَلَيَّ تُثيرُ",64,"ر",1,0],["لِإِسحَقَ بنِ إِبراهيمَ كَفٌّ","كَفَت عافيهِ نَوءَ المِرزَمَينِ",65,"ن",1,0],["لا سورَةٌ تُتَّقى مِنهُ وَلا بَلَهٌ","وَلا يَحيفُ رِضاً مِنهُ وَلا غَضَبُ",66,"ب",1,0],["لا سيَّما منصبٌ جديدٌ","فكفؤُهُ عالمٌ عتيقُ",67,"ق",1,0],["لَاِستَيقَنَت غَيرَ ما ظَنَّت بِصاحِبِها","وَأَيقَنَت أَنَّ لَحجاً لَيسَ مِن وَطَني",68,"ن",2,0],["لِأَسيلَةِ الخَدَّينِ واضِحَةٍ","يُعشى بِسُنَّةِ وَجهِها البَدرُ",69,"ر",1,0],["لاسَلَوتُ الدَهرَ عَن مَلِكٍ","طَلِقِ وَجهِ العُرفِ وَالشِيَمِ",70,"م",1,0],["لا سَمَت في الوُجودِ أَعلامُ مُلكٍ","أَو يَكونَ السِماكُ مِن أَعلامِكْ",71,"ك",1,0],["لا سِيَّما وَالغُصنُ يُزهِرُ زَهرَهُ","وَيَهُزُّ عِطفَ الشارِبِ المُرتاحِ",72,"ح",1,0],["لا سمتْ أُمَّةٌ دَهَتْها خطوبٌ","أرْهَقَتْها ولا يثورُ فتاها",73,"ا",3,0],["لِأَسماءَ إِذ قَلبي بِأَسماءَ مُغرَمٌ","وَفي ذِكرِ أَسماءَ المَليحَةِ مُهجَرُ",74,"ر",1,0],["لِأَسيلَةِ الخَدَّينِ جازِئَةٍ لَها","مِسكٌ يُعَلُّ بِجَيبِها وَعَبيرُ",75,"ر",1,0],["لا سِيَّما إِن طالَ عُمرُ الأُمَّه","وَنَظَرَت سَلامَةً وَنِعمَه",76,"ه",1,0],["لاسِيَّما هذا الأَدِيبُ الّذي","أتَى مِنَ النَّظْمِ بأجْناسِ",77,"س",1,0],["لأسيافهِ من بُدْنِه وعُصاته","نجيعان مُهراقٌ عَبيطٌ ومصبوب",78,"ب",1,0],["لِأَسماءٍ يُسَمّيهِن","نَ أَشجَعُ حينَ يَنتَسِبُ",79,"ب",1,0],["لا سِيَّما إِن شَداكَ ذو نُطَفٍ","يا دارُ أَقوَت بِالتَفِّ مِن جُدَدِ",80,"د",1,0],["لا سِيَّما عِندَ يَهودِيَّةٍ","حَوراءَ مِثلَ القَمَرِ الساري",81,"ي",1,0],["لا سِيَّما إِن أُديرَت مِن مُقَرطَقَةٍ","أَو مُرهَفٍ كَقَضيبِ البانِ مَيّاسِ",82,"س",1,0],["لا سِيَّما لِلَّذي يُخَطُّ عَلَيهِ ال","وِزرُ إِن قالَ أَو رَنا وَلَحَظ",83,"ظ",1,0],["لا سَلَتْ عاذِلتي عنْه نَفسي","أَكثري في حبِّهِ أَو أَقلِّي",84,"ل",2,0],["لا سَقى الغَيث بعد مَوتي قَبري","ما لِقَبري نفع من الأغياث",85,"ث",1,0],["لا سامح اللَه في بغداد طائفة","من بعد ما أَبرموا لي عهدهم نقضوا",86,"ض",3,0],["لا سامح اللَه ناساً مِن بَني وَطَني","داسوا بأَرجلهم حقي وَما ندموا",87,"م",3,0],["لا سنّ للدارسين فيها","طلّابها فتيةٌ وشيب",88,"ب",1,0],["لا سقية أغنت ولا رقية","ولا تميمات ولا عوذه",89,"ذ",2,0],["لا سَمِيعٌ يَفْقَهُ الْقَوْ","لَ وَلا حَيٌّ يَصُوتُ",90,"ت",1,0],["لأُسْرَتِهَا رَعَاهَا الله نُبْلٌ","بِهِ ازدَانَ الأَوَاخِرُ وَالأَوَالِي",91,"ل",2,0],["لاَ سِلمَ أَبْهَجُ مِنْ تَهَا","يُلِ رُكْنِهِ المُتزَعزِعِ",92,"ع",1,0],["لا سَقَاك الْغَيْثُ يَا جَهْلُ فكَمْ","سُقِيَتْ فِي كَأْسِكَ الأَقْوَامُ مُرَّا",93,"ر",2,0],["لاَ سِتْرَ يَسْترُهُ وَمَا مِنْ مِفْضَلٍ","غَيْرُ القَذى تكْسَاه تِلْكَ الأَضْلُعُ",94,"ع",1,0],["لا سِرَّ لِلْغَابِ إِلاّ وهْيَ تُنْبِئُهُ","بِهِ خِلاَلَ تَنَاجِي الرِّيحِ وَالشَّجَرِ",95,"ر",1,0],["لا سلام عليك يا قصر مني","لا ولا جادك الحيا ببرود",96,"د",1,0],["لا سَمعَ الجارُ فيكَ عِندي","حَسيسُ نارٍ وَلا مُدقِّ",97,"ق",1,0],["لَأَستَسقِيَنَّ العَينَ غَيثاً لِرَبعِكُم","وَإِن زادَهُ صَوبُ الدُموعِ مُحولا",98,"ل",2,1],["لَأَستَنشِقَنَّ الريحَ شَوقاً إِلَيكُمُ","إِذا هِيَ هَبَّت بُكرَةً وَأَصيلا",98,"ل",2,0],["لَأَسعَفتُمُ المُشتاقَ لَو ذُقتُمُ الهَوى","فَأحيَيتُمُ بِالوَصلِ مِنهُ قَتيلا",98,"ل",2,0],["لَأَستَرزِقَنَّ اللَهَ نَوماً فَرُبَّما","وَجَدتُ إِلَيكُم في المَنامِ سَبيلا",98,"ل",2,0],["لَأَستَحسِنَنَّ الذُلَّ في طاعَةِ الهَوى","وَأَيُّ مُحبٍّ لا يَعيشُ ذَليلا",98,"ل",2,0],["لاسيما ولنا بذلك موعدٌ","ووفاءُ موعدكم وفاء يؤثَر",99,"ر",1,0],["لا سِفاحٌ وَلا نِكاحٌ وَلا ما","يوجِبُ الأُمَّهاتِ والآباءَ",100,"ب",3,0],["لا سائلٌ، أو مُحْسنٌ","الكلُّ في عَيْشِ رغيد",101,"د",1,0],["لأسيلة ال