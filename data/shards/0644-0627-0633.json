52.html","عموديه"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[38,"إني امرؤ لم أزل وذاك من الله","https://www.aldiwan.net/poem7834.html","المنسرح"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[43,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[62,"جرى بين هرمس والشمس في","https://www.aldiwan.net/poem52164.html","المتقارب"],[62,"يا من يسيء إلى الأنام","https://www.aldiwan.net/poem52460.html","مجزوء الكامل"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"كم من حنين إليك مجلوب","https://www.aldiwan.net/poem11046.html","المنسرح"],[45,"فداؤك نفسي دون رهطي ومعشري","https://www.aldiwan.net/poem63567.html","الطويل"],[45,"قل للوزير وماعدا سلطانه","https://www.aldiwan.net/poem63575.html","الكامل"],[45,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[28,"لأسماء إذ أهلي لأهلك جيرة","https://www.aldiwan.net/poem5390.html","الطويل"],[61,"لا سقيت حانة أترجة","https://www.aldiwan.net/poem51694.html","السريع"],[44,"لا سقيت أطلالك الداثره","https://www.aldiwan.net/poem30043.html","السريع"],[44,"يا غزالا قطاف وجنته الور","https://www.aldiwan.net/poem30248.html","الخفيف"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[69,"من كان في علمه دخيلا","https://www.aldiwan.net/poem29155.html","مخلع البسيط"],[31,"هيهات من أمة الوهاب منزلنا","https://www.aldiwan.net/poem41292.html","البسيط"],[31,"لمن الديار رسومها قفر","https://www.aldiwan.net/poem42527.html","الكامل"],[74,"يا صدى بالثغر جاوره","https://www.aldiwan.net/poem13261.html","المديد"],[105,"مصر أنت الحياة والموت طرا","https://www.aldiwan.net/poem43126.html","الخفيف"],[81,"غيري يميل إلى كلام اللاحي","https://www.aldiwan.net/poem61541.html","الكامل"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[40,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[22,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem21640.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"قل لولي الدولة المرتجى","https://www.aldiwan.net/poem18074.html","السريع"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"ألا يا حادثا فيه","https://www.aldiwan.net/poem62438.html","مجزوء الوافر"],[48,"سقيا لغير العلياء والسند","https://www.aldiwan.net/poem62548.html","المنسرح"],[48,"الشرب في ظلة خمار","https://www.aldiwan.net/poem63268.html","السريع"],[48,"اعزم على سلوة إلا عن الكاس","https://www.aldiwan.net/poem63431.html","البسيط"],[46,"الموت حظ لمن تأمله","https://www.aldiwan.net/poem22930.html","المنسرح"],[76,"يا طويل الهجر لا تنس وصلي","https://www.aldiwan.net/poem39008.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85333","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85559","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85459","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147484","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42546","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55159","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141924","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43657","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23583","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9997","الخفيف"],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[90,"على حدود فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179015",""],[45,"حَذَرْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[91,"فلسفة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=53232",""],[38,"إنّي امرؤٌ لمْ أزلْ ، وذاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=21140",""],[51,"قصيدة ٌ كرَّها مُثقّفها","https://www.poetsgate.com/ViewPoem.aspx?id=30242",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""]],"verses":[["لَأَستَمطِرَنَّ العِزِّ نُفساً مُريغَةً","وُرودَ عَلاءٍ أَو وُرودَ حِمامِ",0,"م",1,0],["لا سَحَبَ النَشوانُ مِن ذَيلِهِ","فيها وَلا دَرَّت عَلَيها الكُروم",1,"م",1,0],["لا سَفيرٌ إِلَيكَ إِلّا مَعالي","كَ وَلا شافِعٌ إِلَيكَ سِواكا",2,"ك",2,0],["لَأُسَقِّيَنَّكَ كَأسَ لاذِعَةٍ","لا العَبُّ يُنفِدُها وَلا المَصُّ",3,"ص",1,0],["لا سُقِيتُنَّ الحَيا مِنْ إِبلٍ","تَذْرَعُ الأرْضَ بِصَحْبي وَتَبوعُ",4,"ع",1,0],["لأَسْتَودِعَنَّ الدّهْرَ فيكمُ قَصائِداً","وهنَّ يُوشِّحْنَ الثّناءَ المُخلَّدا",5,"د",2,0],["لا سَيءٌّ عِندَكُم يُغني وَلا حَسَنٌ","فَالمُحسِنونَ سَواءٌ وَالمُسيئونا",6,"ن",2,0],["لِأَسرَعَ ما مَلَلتِ فَدَتكِ نَفسي","وَخُنتِ وَلَيسَ يُعجِبُني المَلولُ",7,"ل",1,0],["لَأَستَمسِكَن بِالوُدِّ ما ذرَّ شارِقٌ","وَما ناحَ قُمريٌ وَما لاحَ كَوكَبُ",8,"ب",1,0],["لاَ سِيَّمَا مَنْ دَخَلتْ أُذْنُهُ","وَانْتَفَخَتْ مِنْ تَحْتِ أَثْوَابِهِ",9,"ب",2,0],["لا سِرُّهُنَّ لَدَينا ضائِعٌ مَذِقٌ","وَكاتِماتٌ إِذا اِستودِعنَ أَسراري",10,"ي",1,0],["لَاِستَنزَلَتهُ عَيطَلٌ مَكحولَةٌ","حَوراءُ جادَ لَها النِجادَ خَريفُ",11,"ف",1,0],["لَأَستَشعِرَنَّ أَعلى دَريسَيَّ مُسلِماً","لَوَجهِ الَّذي يُحيي الأَنامَ وَيَقتُلُ",12,"ل",1,0],["لا سَكَّنَ اللَهُ قَلباً عَقَّ ذِكرَكُمُ","فَلَم يَطِر بِجَناحِ الشَوقِ خَفّاقا",13,"ق",2,0],["لَأَستَجِدَّنَّ في عِشقي لَها زَمَناً","يُنسي سَوالِفَ أَيّامي وَأَزماني",14,"ن",2,0],["لا سوقَةٌ مِنهُمُ يَبقى وَلا مَلِكٌ","مِمَّن تَمَلَّكَهُ الأَحرارُ وَالرومُ",15,"م",1,0],["لا سُبَّةً تَخْشَى وَلا شُبْهَةً","مِنْ سُقْمَاءِ الرَّأْيِ أَوْ رُمْدِهِ",16,"د",2,0],["لا سافِرُ النِيِّ مَدخولٌ وَلا هَبِجٌ","عاري العِظامِ عَلَيهِ الوَدعُ مَنظومُ",17,"م",1,1],["لا سيما لما رأى من ثغرهِ","زهراً وأين الزهر من تلك الدُرَرْ",18,"ر",1,0],["لِأَسماءَ إِذ لَمّا تَفُتنا دِيارُها","وَلَم نَخشَ مِن أَسبابِها أَن تَجَذَّما",19,"م",2,0],["لِإِسمَعيلَ بي وَبَنيهِ فَخرٌ","وَفي إِسحَقَ بي وَبَنيهِ عُجبُ",20,"ب",1,0],["لا سمع للاّثم في حبكم","أعوذ بالله السميع العليم",21,"م",1,0],["لا سيما في ربيع مُمْرعٍ غَدقٍ","ما انْفَكّ يُتْبعُ أنواءً بأنواءِ",22,"ا",2,0],["لا سيّما بفمٍ يَظَل","لُ مَنِيُّ ناكتِهِ شرابهْ",23,"ب",2,0],["لا سَلَبَ اللّهُ سرابيلَكُمْ","من هذه النُّعمى ولن تُسلبا",24,"ب",2,0],["لا سيما وله وجهُ به قحةٌ","وعارضٌ كجبين الطير مَهْلوبُ",25,"ب",1,0],["لا سيما وقد اكتهلت وقد تَرى","ورع الإمام وبأْسَهُ المتهيَّبا",26,"ب",2,0],["لاسيما ولعلَّ الهزلَ غايتُهُ","لا غيرُهُ ولبذر الجدِّ مُحتَرثُ",27,"ث",1,0],["لاسِيما لأبي البنا","تِ الناظرات من الفُرَجْ",28,"ج",1,0],["لا سِيَّما من كان يو","قن أنه إن مات عائدْ",29,"د",1,0],["لا سيما والعذر في تقليلها","أنَّ امتنانك مُبْدَأٌ ومُعادُ",30,"د",1,0],["لا سيَّما من عَفْوتُ عنه فأطْ","غَتْه أَناتي وهيَّجَتْ صَيدضهْ",31,"د",3,0],["لأستميحنّ كلّ ذاك لمب","كائيك بعد استماحة الدِّررِ",32,"ر",1,0],["لاسيّما ندّك الذي منعتْ","جوْدته أن يُسبَّ عطاره",33,"ر",2,0],["لاسيما ولقولي فيه منزلةٌ","من سيد مثَّلاهُ الشمس والقمر",34,"ر",1,0],["لا سقاك الإلهُ غيثاً ولا أر","واك إلا من ريقها الممزوز",35,"ز",1,0],["لا سيما والذي يكفيه حاضِرُه","لعارفِ اللَهِ من هاتيك مُمْتعضُ",36,"ض",1,0],["لا سبط الخطو في المهارب حا","شاك ولكن في كل مزدحَف",37,"ف",1,0],["لا سلاليمُك الطّوال تُنجّي","ك من سَطْوَتي ولا أنفاقُك",38,"ك",1,0],["لأسيّرَنَّك في البلا","دِ بِما أقَمْتَ وطال خَفْضُك",39,"ك",1,0],["لا سقى اللَّهُ جسمَهُ من حيا المُز","نِ ولا رُوحَه من السلسبيل",40,"ل",1,0],["لا سيما في مديح ممتدَحٍ","مشتهر الذكر سائر المثلِ",41,"ل",1,0],["لا سيّما عند خضبِ الشيخ لحيَتَهُ","ورأسه واختضابُ الشيخ منتصلُ",42,"ل",1,0],["لاسْتوى عندك بيْتٌ","يتحدَّاكَ وسَهْمُ",43,"م",1,0],["لا سؤالٌ من بعد رِفدك إلا","كالزنا بعد نعمةِ الإحصان",44,"ن",1,0],["لا سيما والمديحُ زورٌ","والحقُّ في تلكُمُ الخَبايا",45,"ا",3,0],["لِأَسماءَ مُحتَلٌّ بِناظِرَةِ البِشرِ","قَديمٌ وَلَمّا يَعفُهُ سالِفُ الدَهرِ",46,"ر",1,1],["لِأُساجِلَ الوَرقاءَ في تَغريدِها","وَتَهُزُّ روحي نَفحَةُ المِزمارِ",47,"ر",1,0],["لِأُسامِرَ الأَقمارَ في أَفلاكِها","تَحتَ الظَلامِ إِذا غَفا سُمّاري",47,"ر",2,0],["لا سِلمَ ما بَيني وَبَينَهُمُ","لا سِلمَ بَينَ الهِر وَالفَأرِ",48,"ر",1,0],["لا سُموماً مِنَ السَوافي اللَواتي","تَملَءُ الأَرضَ في الظَلامِ عَويلا",49,"ل",2,0],["لا سافِحٌ مِن سَوافِحِ الطَيرِ يَث","نيني وَلا ناعِبٌ إِذا نَعَبا",50,"ب",2,0],["لا سيفه ماض ولا","خميسه عرمرم",51,"م",1,0],["لا سِرتِ مِن إِبِلٍ لَوَ أَنّي فَوقَها","لَمَحَت حَرارَةُ مَدمَعَيَّ سِماتِها",52,"ت",3,0],["لأستخرج الروح من إخوتي","فطوعي شبابهم والكهولُ",53,"ل",1,0],["لا سلوةٌ فيطيبُ عن","كَ ولا حِمامُ فيستريحُ",54,"ح",1,0],["لَاِستَهَلَّت سَماؤُهُ فَمُطِرنا","ذَهَباً في اِنهِلالِ تِلكَ الذِهابِ",55,"ب",1,0],["لَأَسرَعَ في عَقلي الَّذي بِتُّ مَوهِناً","أَرى مِن قَريبٍ لا الَّذي بِتُّ أَشرَبُ",56,"ب",1,0],["لا سَبَبي واهِنٌ لَدَيهِ وَلا","وَجهِيَ عَن وَجهِهِ بِمَحجوبِ",57,"ب",1,0],["لَأَسمَعتَني في ظُلمَةِ الهَجرِ دَعوَةً","عَلى الهَجرِ في وَقتٍ مِنَ العَفوِ مُقمِرِ",58,"ر",1,0],["لاسِيَّما في بَدءِ عَدلٍ لَم يَخُن","فيهِ أَمانَتَهُ الإِمامُ الناصِرُ",59,"ر",1,0],["لِأَسلَحَ حينَ يُمسي مِن حُبارى","وَأَضرَطَ حينَ يُصبِحُ مِن حِمارِ",60,"ر",1,0],["لَأَسماءَ إِذ أَهلي لِأَهلِكِ جيرَةٌ","وَإِذ كُلُّ مَوعودٍ لَها أَنتَ آمِلُه",61,"ل",2,1],["لا سُقِيَتْ حانةُ أُتْرُجَّةٍ","غَيْثاً ولا حانةُ مولودِها",62,"د",3,1],["لا سُقِيَت أَطلالُكَ الداثِرَه","وَلا اِنقَضَت عَثرَتُكَ العاثِرَه",63,"ر",2,1],["لا سَأَلتُ الخَلاصَ مِنكَ وَإِن كُن","تَ بَلاءَ الهَوى عَلَيَّ تُثيرُ",64,"ر",1,0],["لِإِسحَقَ بنِ إِبراهيمَ كَفٌّ","كَفَت عافيهِ نَوءَ المِرزَمَينِ",65,"ن",1,0],["لا سورَةٌ تُتَّقى مِنهُ وَلا بَلَهٌ","وَلا يَحيفُ رِضاً مِنهُ وَلا غَضَبُ",66,"ب",1,0],["لا سيَّما منصبٌ جديدٌ","فكفؤُهُ عالمٌ عتيقُ",67,"ق",1,0],["لَاِستَيقَنَت غَيرَ ما ظَنَّت بِصاحِبِها","وَأَيقَنَت أَنَّ لَحجاً لَيسَ مِن وَطَني",68,"ن",2,0],["لِأَسيلَةِ الخَدَّينِ واضِحَةٍ","يُعشى بِسُنَّةِ وَجهِها البَدرُ",69,"ر",1,0],["لاسَلَوتُ الدَهرَ عَن مَلِكٍ","طَلِقِ وَجهِ العُرفِ وَالشِيَمِ",70,"م",1,0],["لا سَمَت في الوُجودِ أَعلامُ مُلكٍ","أَو يَكونَ السِماكُ مِن أَعلامِكْ",71,"ك",1,0],["لا سِيَّما وَالغُصنُ يُزهِرُ زَهرَهُ","وَيَهُزُّ عِطفَ الشارِبِ المُرتاحِ",72,"ح",1,0],["لا سمتْ أُمَّةٌ دَهَتْها خطوبٌ","أرْهَقَتْها ولا يثورُ فتاها",73,"ا",3,0],["لِأَسماءَ إِذ قَلبي بِأَسماءَ مُغرَمٌ","وَفي ذِكرِ أَسماءَ المَليحَةِ مُهجَرُ",74,"ر",1,0],["لِأَسيلَةِ الخَدَّينِ جازِئَةٍ لَها","مِسكٌ يُعَلُّ بِجَيبِها وَعَبيرُ",75,"ر",1,0],["لا سِيَّما إِن طالَ عُمرُ الأُمَّه","وَنَظَرَت سَلامَةً وَنِعمَه",76,"ه",1,0],["لاسِيَّما هذا الأَدِيبُ الّذي","أتَى مِنَ النَّظْمِ بأجْناسِ",77,"س",1,0],["لأسيافهِ من بُدْنِه وعُصاته","نجيعان مُهراقٌ عَبيطٌ ومصبوب",78,"ب",1,0],["لِأَسماءٍ يُسَمّيهِن","نَ أَشجَعُ حينَ يَنتَسِبُ",79,"ب",1,0],["لا سِيَّما إِن شَداكَ ذو نُطَفٍ","يا دارُ أَقوَت بِالتَفِّ مِن جُدَدِ",80,"د",1,0],["لا سِيَّما عِندَ يَهودِيَّةٍ","حَوراءَ مِثلَ القَمَرِ الساري",81,"ي",1,0],["لا سِيَّما إِن أُديرَت مِن مُقَرطَقَةٍ","أَو مُرهَفٍ كَقَضيبِ البانِ مَيّاسِ",82,"س",1,0],["لا سِيَّما لِلَّذي يُخَطُّ عَلَيهِ ال","وِزرُ إِن قالَ أَو رَنا وَلَحَظ",83,"ظ",1,0],["لا سَلَتْ عاذِلتي عنْه نَفسي","أَكثري في حبِّهِ أَو أَقلِّي",84,"ل",2,0],["لا سَقى الغَيث بعد مَوتي قَبري","ما لِقَبري نفع من الأغياث",85,"ث",1,0],["لا سامح اللَه في بغداد طائفة","من بعد ما أَبرموا لي عهدهم نقضوا",86,"ض",3,0],["لا سامح اللَه ناساً مِن بَني وَطَني","داسوا بأَرجلهم حقي وَما ندموا",87,"م",3,0],["لا سنّ للدارسين فيها","طلّابها فتيةٌ وشيب",88,"ب",1,0],["لا سقية أغنت ولا رقية","ولا تميمات ولا عوذه",89,"ذ",2,0],["لا سَمِيعٌ يَفْقَهُ الْقَوْ","لَ وَلا حَيٌّ يَصُوتُ",90,"ت",1,0],["لأُسْر