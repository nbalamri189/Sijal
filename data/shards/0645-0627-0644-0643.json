95,"","https://poetry.dctabudhabi.ae/diwan/poem/143842","الخفيف"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111319","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90754","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90820","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54489","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73177","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133156","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139198","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33500","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33455","السريع"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147272","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72899","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72803","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72922","السريع"],[4726,"مآل كل امرءٍ للموت والعطب","https://www.poetsgate.com/ViewPoem.aspx?id=146654",""],[4755,"صَوتَكْ سَالْ في دَفتَري","https://www.poetsgate.com/ViewPoem.aspx?id=195278",""],[4788,"يا سيده","https://www.poetsgate.com/ViewPoem.aspx?id=132280",""],[4799,"شيطنه","https://www.poetsgate.com/ViewPoem.aspx?id=12261",""],[4869,"انتي سما لكن بها تجري الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=151608",""],[4916,"حلم الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=135376",""],[4935,"مالك الملك بجودٍ كملك","https://www.poetsgate.com/ViewPoem.aspx?id=129536",""],[4988,"نزوحي .. نكهة الحاظر وعبق الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=182912",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5136,"فديت من يثنيه سكر الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=121497",""],[5136,"واعجبي قلبي اللجوج الطموح","https://www.poetsgate.com/ViewPoem.aspx?id=121541",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5183,"المصاب المؤلم","https://www.poetsgate.com/ViewPoem.aspx?id=180255",""],[5198,"المناجيم","https://www.poetsgate.com/ViewPoem.aspx?id=136104",""],[2365,"مالك فى الجهل من عذير","https://www.poetsgate.com/ViewPoem.aspx?id=200647",""],[2365,"وحارس غفلة حرّاسه","https://www.poetsgate.com/ViewPoem.aspx?id=200644",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5455,"صمت المكان","https://www.poetsgate.com/ViewPoem.aspx?id=34700",""],[5461,"يزحف الموت","https://www.poetsgate.com/ViewPoem.aspx?id=5305",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5573,"العدل والميل","https://www.poetsgate.com/ViewPoem.aspx?id=200222",""],[5675,"مالك القلب بعدك القلب طارا","https://www.poetsgate.com/ViewPoem.aspx?id=170609",""],[5739,"الوتين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155469",""],[5843,"الدرب خطوه","https://www.poetsgate.com/ViewPoem.aspx?id=51284",""],[5848,"أفضل طريقة للحياة","https://www.poetsgate.com/ViewPoem.aspx?id=51941",""],[5848,"من يد ما نعدمها","https://www.poetsgate.com/ViewPoem.aspx?id=50614",""],[5848,"مالك ومال للتعب ياجارة الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=48821",""],[5848,"والله إني عليك احرص من امك وابوك","https://www.poetsgate.com/ViewPoem.aspx?id=48836",""],[5939,"قهوة عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=195307",""],[5970,"عيل صبري من تباريح أسي","https://www.poetsgate.com/ViewPoem.aspx?id=130609",""],[5993,"الشعر ديوان العرب وانت بومه","https://www.poetsgate.com/ViewPoem.aspx?id=186756",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[463,"جاء بها والخيرُ مجلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59980&r=&rc=36",""]],"verses":[["ما لَكَ تَرضى أَن يُقالَ شاعِرٌ","بُعداً لَها مِن عَدَدِ الفَضائِلِ",0,"ل",1,0],["ما لَكَ عَن دارِ العُلى","أُخرى اللَيالي ناقِلُ",1,"ل",1,0],["ما لَكُم لايَزالُ مِنكُم كِتابٌ","يورِثُ الهَمَّ وَالبُكاءَ الطَويلا",2,"ل",2,0],["ما لَكُم لَم تَكتُبوا","جَوابَ تِلكَ الكُتُبِ",3,"ب",1,0],["مَالَكَ وَضَّاحُ دَائمَ الغَزَلِ","أَلَستَ تَخشَى تَقَارُبَ الأَجَلِ",4,"ل",1,1],["ما لكفيهِ في الثراء هدوّ","فهو فيه كسابحٍ في ماء",5,"ا",2,0],["مالكٌ بعد مالك وكذا الأن","جمُ يتلو العقيبُ منها العقيبا",6,"ب",2,0],["ما لك عندي من خراج فزَجا","وهو الثّناءُ المستماح المرتجى",7,"ج",2,0],["مالك في بغضك إن مت خلف","إلا بنيك الخلف من شر سلف",8,"ف",1,0],["مالَكَ عِزُّ التَغلِبِيِّ الَّذي لَهُ","بَنى اللَهُ في شُمِّ الجِبالِ الحَوارِكِ",9,"ك",1,1],["ما لَكُم تَشكونَ مِن مُحتَكِمٍ","أُضتُمُ أَلسِنَكُم أَن تَشكُرَه",10,"ر",2,0],["ما لَكِ يا هَذِهِ لا تَهتُفين","لِصاهِبِ الدَولَةِ وَالباسِ",11,"س",1,0],["ما لَكِ يا هَذِهِ لا تَضحَكين","لِلحَبَبِ الضاحِكِ في الكاسِ",11,"س",1,0],["مالِكُها مِن خَجلَةٍ","كَأَنَّهُ في مَخزِيَه",12,"ي",2,0],["مالِكي في خُلقِهِ مَلَلٌ","أَنا مَملوكٌ وَمَملولُ",13,"ل",1,0],["ما لَكَ في فِعلِكَ مِن مُشبِهٍ","ما تَمَّ في العالَمِ ما تَمَّ لَكَ",14,"ك",1,0],["مالِكي أَنتَ لا عَدِم","تُكَ يا خَيرَ مَن مَلَك",15,"ك",1,1],["مَا لَكَ لا تُصغي لغيرِ الأَسى","مَا لَكَ لا ترنو لغيرِ الكُلُومْ",16,"م",1,0],["مَا لَكَ قَدْ أصْبَحْتَ لا تصرفُ الأَيَّامْ","إلاَّ في شِعابِ الجَحيمْ",16,"م",1,0],["مالِكَةٌ عامِلَةٌ","مُصلِحَةٌ مُعَمِّرَه",17,"ر",2,0],["مالٌ كَأَنَّ غُرابَ البَينِ يَرقُبُهُ","فَكُلَّما قيلَ هَذا مُجتَدٍ نَعَبا",18,"ب",2,0],["مال كغصن بانة","يزينها اهتزازها",19,"ه",2,1],["ما لَكَ مُذ كُنتَ لاعِباً مَرِحاً","تَسحَبُ ذَيلَ السَفاهِ وَالبَطَرِ",20,"ر",1,0],["ما لَكَ لا تَرجِعُ السَلامَ عَلى ال","زُوّارِ إِلّا بِطَرفَةِ النَظَرِ",21,"ر",1,0],["ما لَكَ قَد حُلتَ عَن إِخائِكَ وَاِس","تَبدَلتَ يا عَمرُ شيمَةً كَدِرَه",22,"ر",2,1],["ما لك لا تَبكي بُكاءً بالأسى","بين رسومٍ وَبَوَالي أربُعِ",23,"ع",1,0],["ما لِكَثيبِ الحِمى إِلى عَقِدِه","ما بالُ جَرعائِهِ إِلى جَرَدِه",24,"د",2,1],["مالكي أصبحَ لكنْ","شغلوه بالقدورِ",25,"ر",1,0],["مالِكُ المُلكِ مَضَت أَحكامُهُ","وَجَرَت أَقدارُهُ في العالَمينْ",26,"ن",1,0],["ما لَكُم لا تَنجَلي غُمَّتُكُم","أَتُحِبّونَ اِشتِدادَ الغُمَمِ",27,"م",1,0],["مَالِكُ الملكِ تَعالى ما لَهُ","في عُلاهُ مِن شريكٍ يُعْهَدُ",28,"د",1,0],["ما لَكَ وَالذكريات تذعرها","تَثير مَكنونها وَتَنشرها",29,"ر",3,1],["ما لَكُم بَعضَكُم يمزق بَعضاً","أَفرَغتُم مِن العَدوّ اللدودِ",30,"د",1,0],["مَا لَكُم إِخْوَةَ الكِتابِ أُناساً","ليس يُرْعَى للحقِّ منكم إخاءُ",31,"ا",2,0],["ما لَكَ أَم ما دَهاكَ وَيلُكَ ما","غالَكَ حَتّى اِنفَرَدتَ مُكتَإِبا",32,"ب",2,0],["ما لَكَ بِالتُرَّهاتِ مُشتَغِلاً","أَفي يَدَيكَ الأَمانُ مِن سَقَرِ",33,"ر",1,0],["مالِكِيٌّ تَنشَقُّ عَن وَجهِهِ الحَر","بُ كَما اِنشَقَّتِ الدُجى عَن ضِياءِ",34,"ا",2,0],["ما لَكُم لا تَرَونَ طُرقَ المَعالي","قَد يَزورُ الهَيجاءَ وَزيرُ نِساءِ",35,"س",3,0],["ما لَكَ تَستَجهِلُني دائِماً","وَإِنَّما ذَلِكَ مِن جَهلِكا",36,"ك",2,0],["ما لكل الأكوان إلا إلهٌ","واحدٌ لا يزول وهو الأثير",37,"ر",1,0],["مَا لَكَ تَجْرِي إِلَيْنَا غَيْرَ ذِي رَسَنٍ","وقَدْ تَكُونُ إِذَا نُجْرِيكَ تُعْنِينَا",38,"ن",2,0],["مالك لم تنتفع بعقل","هل عصفت بالعقول ريح",39,"ح",1,0],["مالك شيءٌ وإذا","أطعت فالرحمة لك",40,"ك",1,0],["مالك لم تصغ إلى عاذل","أحل في المسمع منك الصمم",41,"م",1,1],["مَآلِكُ حَمْلُها يُجْزَى بشُكْرٍ","وإنْ تأَبَوْا سِوى مالٍ فَمال",42,"ل",1,0],["مال كما شاء العفاف والكرم","زكا كهدي البيت أو حلْيِ الحرَمْ",43,"م",1,0],["ما لكَ والناسَ أبا ترابِ","ليس الذئابُ لك بالأتراب",44,"ب",1,0],["مَالِكاً مِنْهُمُ القُلُوبِ بِزِينَا","تِ السَّجَايَا وَبِالطِّبَاعِ الرِّقَاقِ",45,"ق",1,0],["مَا لَكِ في الْمَجْدِ مِنْ شَبِيه","وما لِجَدْوَاهُ مِنْ حُدُودِ",46,"د",1,0],["ما لكم والثياب؟ إن أباكم","آدمًا كان يلبس الأوراقا",47,"ق",2,0],["مالك الاّّّ أغلا القصايد يالعيوف","يا مسقّي الفرعتين أم الشتل",48,"ل",1,0],["مالك من الاسما معاي ألا البعل","يابعلها اللي بيدها قساوته",49,"ت",2,0],["ما لكم تشكون من محتكم","رضتم ألسنكم أن تشكره ؟",50,"ر",2,0],["ما لكم لا ترَوْنَ طُرْقَ المعالي،","قد يزورُ الهيجاءَ زيرُ نساءِ",51,"س",3,0],["مالكم لا تنجلي غمتكم","أتحيون اشتداد الغمم",52,"م",1,0],["مالكَ في الركبِ غريمٌ ما