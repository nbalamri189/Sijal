{"poems":[[79,"أنتم من مناسب الأمجاد","https://www.aldiwan.net/poem36605.html","الخفيف"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[90,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[276,"من لنفس ثناها","https://www.aldiwan.net/poem52122.html","مجزوء الرمل"],[406,"نقش على جدار الوطن","https://www.aldiwan.net/poem6788.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48710","الخفيف"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79450","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120855","الطويل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124715","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117291","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139687",""],[5387,"غردي","https://www.poetsgate.com/ViewPoem.aspx?id=53731",""],[5431,"ياعراق....","https://www.poetsgate.com/ViewPoem.aspx?id=207993",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""]],"verses":[["مَنْ كَعمْرو مُفْني البَراجِمِ والمُدْ","نِ وقد ألْقِحَتْ حُروبُ الشِّدادِ",0,"د",1,0],["مَنْ كَعَبَّاسِ فِي تَفَرُّدِهِ","عَزَّ نَصْراً وَجَلَّ سُلْطَانَا",1,"ن",2,0],["من كعبد المحسن الشهم الذي","حفّه بالموت عزّ وجلال",2,"ل",1,0],["مَن كَعَمرِو البِلادِ وَالضادُ مِمّا","شادَ فيها وَالمِلَّةُ الغَرّاءُ",3,"ا",2,0],["مَنْ كَعَبْدِ الْعَزِيزِ طَلاَّعَ أَنْجَا","دٍ صِعابٍ إِذَا دَعَاهُ الضَّمِيرُ",4,"ر",1,0],["مِنْكَ عَزْمُ الدَّاعي وَفَضْلُ الْمُجَلِّي","وَمِنَ اللّهِ مَا تَرَى مِنْ ثَوَابِه",5,"ب",2,0],["منك عَبد الرَحيم اليَوم","يَرجو جَزاها",6,"ا",3,0],["من كعبة رفع الإله مقامها","وحمى حماها من طواغيت الفتن",7,"ن",1,0],["منك عندي الصنيع والأدب الغض","ضُ ومني لك البيان الحكيم",8,"م",1,0],["من كعبد العزيز أقوى على الده","ر يلاقي الخطوب سمحاً لعوبا",9,"ب",2,1],["من كعبةٍ قد أصبحَتْ","للمجدِ والعليا مدارا",10,"ر",2,0],["مَن كعليّ ذي الشجاعة والرّضا","لإصراخ مَذعورٍ وإيواء مطرودِ",11,"د",1,1],["من كعبد الحميد إن نَكَصَ الذِّم","رُ حرّت مواطيء الأقدامِ",12,"م",1,0],["من كعلياء أبى بكر الذي","حاز بالإيثار بيضاء اليد",13,"د",1,0],["من كعبة الله وافي وهو كعبتنا","أتى لكعبة بيتٍ للسما رفعا",14,"ع",2,0],["منك على ضلوعنا إذا شدوت مشتلُ","ثرثر على آذاننا ما ضرنا أن نثملُ",15,"ل",1,0],["منك عُلمتُ منطق الطير شدوا","كي أغني ويرقص الإشراق",16,"ق",1,0],["مَنْ كعبد الحميدِ إنْ نَأَصَ الدَمْ","مُ وجُرَّتْ مواطئُ الأقدامِ",17,"م",1,0]]}