{"poems":[[68,"وإذا فاتك الغنى نكص العز","https://www.aldiwan.net/poem38558.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[141,"ما لسلمى تجنبت","https://www.aldiwan.net/poem67949.html","مجزوء الخفيف"],[228,"ما لسلمى التي استبدت وما لي","https://www.aldiwan.net/poem41624.html","الخفيف"],[447,"أعزيكمو في ميت لم يزل عندي","https://www.aldiwan.net/poem14445.html","الطويل"],[463,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[484,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76907","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110258","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127381","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62902","السريع"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34661","المنسرح"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45023","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73402","السريع"],[4684,"حالٌ واحدٌ وألفُ سؤل","https://www.poetsgate.com/ViewPoem.aspx?id=201032",""],[4692,"مدي ذراعيك","https://www.poetsgate.com/ViewPoem.aspx?id=204505",""],[5324,"فأنا المصلوب من غير صليب.","https://www.poetsgate.com/ViewPoem.aspx?id=211384",""]],"verses":[["ما لِسانُ الفَقيرِ إِلّا قَصيرٌ","عَجَباً إِن أَطاقَ رَدَّ السَلامِ",0,"م",1,0],["ما لسانُ القريضِ من عربيٍ","كلسانِ القريضِ من طُمْطُماني",1,"ن",2,0],["مال سَمْعُ الدنيا إليه وأصغَتْ","هاتفاتُ المُنَى إلى هاتفاته",2,"ت",2,0],["ما لِسعدٍ حُفْرةٌ واحدةٌ","هو مِلءُ القلبِ ملءُ الأرَضين",3,"ن",1,0],["ما لسناه كتمان","صبح أضاء الأكوان",4,"ن",1,0],["ما لسلطانهم على الحرّ حكم","كلّ نفس إباؤها سلطان",5,"ن",1,0],["ما لسعد في الموت يزداد قربا","من فؤادي ما ازداد هجرا وبعدا",6,"د",2,0],["ما لِسَلمى تَجَنَّبَت","وَصلَنا اليَومَ مالَها",7,"ل",3,1],["ما لِسَلمى الَّتي اِستَبَدَّت وَما لي","أَنا في الحُبِّ مَيَّتُ الآمالِ",8,"ل",1,1],["مآل سعيد الجد في الأَرض حفرة","يحل بها المحروم من طالع السعد",9,"د",1,0],["ما لساري اللهوِ في ليل الصِّبا","ضَلَّ في فجرٍ برأسي وضَحا",10,"ح",2,0],["ما لسلمي يهزها الخيلاء","يتهادى بها الهوى والهواء",11,"ا",2,1],["ما لسان ثغرو المروق","ورضاب ذاك الرشيف",12,"ف",1,0],["مالسفر بالطف أمسوا","حلولاً وأصبحوا",13,"ح",3,0],["ما لسعيدِ بنِ مُحرزٍ أَترى","يُحرزه مِنْ أَذايَ مُحْرزُه",14,"ز",2,0],["ما لسقمي مِن طبيبٍ غيرها","لا ولا لي مِن شفيعٍ شَفعا",15,"ع",2,0],["ما لسِوَانا هَا هنا مَقالُ","لَنَا المجالُ فِيه والمصَالُ",16,"ل",1,0],["ما لساني إذا أجبتك عيّا","عَن جَوابي وَلا حُسامي كَليلا",17,"ل",2,0],["ما لسلمى يا ميُّ طالت نواها","لا نراها ولا نرى من يراها",18,"ا",3,1],["ما لسمعي لا يعي صوت الرقيب","عم هذا الكون أم ذا مستحيل",19,"ل",1,0],["ما لسيورِ الهندِ مزءُودة","في خلِلِ الأَجفانِ ما تُنتضَى",20,"ا",1,0],["ما لسروري بالشك ممتزجاً","حتى كأني أراه في حلم",21,"م",1,0],["ما لِسانُ الدينِ يَرمي عارما","يا زَمانَ الوَصلِ بالأَندَلُسِ",22,"س",1,0],["ما لسمعي في ضجيجٍ وهدير","ما لعقلي في شتاتٍ وحيَر",23,"ر",1,0],["ما لَسعَت كَفَّكَ عَن هَفوَةٍ","أَغنَمَ منها هذهِ العَقرَبُ",24,"ب",1,0],["مال سحتٍ يزول كالليل خبّاً","لا وما أكسب اللئيم وأغنى",25,"ن",2,0],["ما لست أعرفه قد تهت في وطني","وأنت صرت غداة البين لي وطنا",26,"ن",2,0],["ما لست أعرفه أنكرته زمنا","ما أصعب الروح لمّا تنكرُ الزمنا",26,"ن",2,0],["مالساعاتي طويلات كدرب","فيه ضيّعت جميل الأمنيات",27,"ت",1,0]]}