{"poems":[[47,"عليك السلام أيها القمر البدر","https://www.aldiwan.net/poem63569.html","الطويل"],[77,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[463,"سألت غزالا شف قلبي عن اسمه","https://www.aldiwan.net/poem55817.html","الطويل"],[505,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127971","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76161","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86328","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109912","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36743","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85270","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113824","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120524","الكامل"],[4858,"طابتِ الأيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=138207",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5956,"هلّل إلى التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=192293",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[463,"سألتُ غزالا شفَّ قلبي عن اسمه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60277&r=&rc=333",""]],"verses":[["هُوَ اِسمُ فِراقٍ طالَ أَو قَصُرَ المَدى","فَلِلصَدرِ مِنهُ ما يَحِرُّ لَهُ الصَدرُ",0,"ر",1,0],["هو استنّ للرّيحِ هذا الهُبوبَ","وَرَشّحَ ذا العارِضَ المُرتكِم",1,"م",1,0],["هوَ استَنّ تَفضيلَها للمُلوكِ","وأبْقَى لها أثَراً في العُلَى",2,"ا",1,0],["هو اسمٌ يَعاف الصاحلون استماعَه","لأن الذي يهواه يبغضُهُ اللهُ",3,"ه",1,0],["هو أَسرارُ الهُدَى علَّمَنا","فاعْتَقَدْنا كلُّ ما قدْ عَلَّمَا",4,"م",2,0],["هو أسمى رتبة","هو أجدى مِنحا",5,"ح",2,0],["هو أسنى من أن يخب صبا","جعل المدح فيه خير سفير",6,"ر",1,0],["هو أسهل الاشياء منك وانما","دون الوصول الى هناك حتوف",7,"ف",1,0],["هُوَ استنبط الأصول فاكتسى بِهِ ال","فقهَ مِن ديباجِ إِنشائِه وَشيا",8,"ي",2,0],["هو اِسمٌ رُباعِيٌّ وَاِن شِئت شَطره","فَنِصفاه في التَحقيقِ يا صاح حرفان",9,"ن",1,0],["هُوَ اسمٌ ثُلاثيٌّ ولا ثُلثَ سالمٌ","لهُ لا ولا نِصفٌ ولا رَبعَ يُحتَسَب",10,"ب",1,0],["هُوَ اسمٌ رُباعِيٌّ إِذا رُمتَ عَكسَهُ","وَسَهَّلتَ مِنهُ هَمزَةً حينَ تَقلِبُ",11,"ب",1,0],["ةوأسوس أهل الملك من ساس من رعى","برفقٍ فان لم يغنى أغناه صارمه",12,"م",2,0],["هو استضاف أمير العرب في عسر","عبد العزيز وخويَيه بتكريم",13,"م",1,0],["هواس كل سياسة وايالة","يزداد فيه ملكه بنيانا",14,"ن",2,0],["هو إسلامٌ ، وقد حرّقني","أسرُهُ ، يا ربِّ ، فامنن بوليدي",15,"د",2,0],["هُوَ أسْمى منْ أنْ يُهانَ ولا ذَنْبَ","لَهُ بل بذاكَ غيْرُ خَليقِ",16,"ق",1,0],["هو أسرع البشر الذين يخطط","ون ويعملون بحكمةٍ وثباتِ",17,"ت",1,0],["هو أسوة عظمى لخيرِ تصاهرٍ","يُرضي الرسولَ وربَّهُ قبل البشرْ",18,"ر",1,0],["هو أسر ليس دارا","فيه سَجني في القوالبْ",19,"ب",1,0],["هو اسمٌ يعاف الصالحون استماعه","لأن الذي يهواه يبغضه اللهُ",20,"ه",1,0]]}