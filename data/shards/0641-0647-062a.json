{"poems":[[53,"ورياض تخايل الأرض فيها","https://www.aldiwan.net/poem61829.html","الخفيف"],[91,"فهت بالحق فجازو","https://www.aldiwan.net/poem44772.html","مجزوء الرمل"],[87,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39542","الكامل"],[108,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[182,"من بيان سجرا","https://www.aldiwan.net/poem50708.html","الكامل"],[445,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80261","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77914","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141296","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48255","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77204","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126219","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205553",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34571","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94770","الكامل"],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[4927,"أشواق الْعُشَّاْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=29719",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5628,"البحث عن بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=191332",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""]],"verses":[["فهتاف الممتعات أهازي","جُ يُقَفِّينَهُنَّ بالهَدْهادِ",0,"د",1,0],["فهت بالحق فجازو","ني بسب وامتهان",1,"ن",1,1],["فَهتك القُبورَ وَهِيَ حُرمه","مَن ماتَ فاِترُك لِلمَميت جُرمه",2,"ه",1,0],["فهتفتُ أستوحي قديمَ ملاحني","فتهدَّجَتْ وتعثَّرَتْ بأنيني",3,"ن",2,0],["فهتف: جد لي بالجلاء، فقال لي:","حتى تجود لنا به «إنْجِلْترا»",4,"ر",2,0],["فهتكنا عنك الستار كأنّ لم","يخطر الإثم بيننا عريانا",5,"ن",2,0],["فهَتُون قَوْلي سامقٌ وإنِ انحنى","والشِّعرُ مِن حرفي تفجَّرَ مُبْهِرا",6,"ر",2,0],["فَهَتَكْتَ بالبِيضِ الرِّقاقِ سُجُوفَها","وفَضَضْتَ بالجُرْدِ العِتاقِ خِتامَها",7,"م",3,0],["فَهَتفتُ لَما لاحَ ارّخ نورهُ","في الأُفقِ ضاءَ لَنا شِهابٌ سامي",8,"ي",1,0],["فهتكم ستر سكينتي لسماعه","واِشتال مني كل عضو ساكن",9,"ن",1,0],["فهتفت من أنتنّ من بين الورى","فالقلب ذاب تلهفاً وتحسّرا",10,"ر",2,0],["فهتفتُ منه منَاضِلاً ومبَارياً","في أيْكِه وُرْقُ الحمامِ الهُتَّفِ",11,"ف",1,0],["فهتكت عن شمس الظهيرة حجبها","والليل غرة صبحه لم تسفر",12,"ر",1,0],["فَهَتَكتُ سَجفَ الخَزِّ عَن إِنسِيَّةٍ","سَجَدَ الجَمالُ لِوَجهِها وَالنورُ",13,"ر",1,0],["فة تَوَارِيخِنَا مَكَارِمُ خُلُقِ","فإقبِسُوها من ذا الكتابِ الخَفِيفِ",14,"ف",1,0],["فهتفت فليحي الجما","ل وقد يعاقب من هتفْ",15,"ف",1,0],["فهتكت ستر مجونه بتهتكي","في كل ملهيةٍ وبحت وباحا",16,"ح",2,0],["فهتَفتُ لا عجبٌ لأن وزيرنا","واصه أهاج النور في رأس السنَه",17,"ن",2,0],["فَهَتَفْتُ: إِنَّ الْحُبَّ يَبْقَىْ مَرْجِعاً(24)","وَمُوَجِّهاً لِلْعَاْشِقِيْنَ، وَمَصْدَرَاْ(25)",18,"ر",2,0],["فَهَتَفْتُ: يَاْ قَلْبِيْº دَوَاْؤُكَ عِنْدَهَاْ","وَهِيَ الْعِلاْجُ لأَعْشَقِ الْعُشَّاْقِ",19,"ق",1,0],["فَهَتَفْتُ: يَاْعَفْرَاْءُ! حُبُّكِ خَاْلِدٌ","يُمْسِيْ وَيُصْبِحُº شَاْدِياً صَدَّاْحَاْ",20,"ح",2,0],["فهتفتُ إنّي يا بثينةُ مَن","قاسى هواكِ ومسّهُ الضُرُّ",21,"ر",1,0],["فَهَتَفنا لَكِنَّهُ كَهَزارٍ","فَرَّ مِن أَسرِهِ فأَبدى حُبورَه",22,"ر",2,0]]}