{"poems":[[51,"ورياض تخايل الأرض فيها","https://www.aldiwan.net/poem61829.html","الخفيف"],[89,"فهت بالحق فجازو","https://www.aldiwan.net/poem44772.html","مجزوء الرمل"],[85,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39542","الكامل"],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[100,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[179,"من بيان سجرا","https://www.aldiwan.net/poem50708.html","الكامل"],[440,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"]],"verses":[["فهتاف الممتعات أهازي","جُ يُقَفِّينَهُنَّ بالهَدْهادِ",0,"د",1,0],["فهت بالحق فجازو","ني بسب وامتهان",1,"ن",1,1],["فَهتك القُبورَ وَهِيَ حُرمه","مَن ماتَ فاِترُك لِلمَميت جُرمه",2,"ه",1,0],["فهتفتُ أستوحي قديمَ ملاحني","فتهدَّجَتْ وتعثَّرَتْ بأنيني",3,"ن",2,0],["فهتف: جد لي بالجلاء، فقال لي:","حتى تجود لنا به «إنْجِلْترا»",4,"ر",2,0],["فهتكنا عنك الستار كأنّ لم","يخطر الإثم بيننا عريانا",5,"ن",2,0],["فهَتُون قَوْلي سامقٌ وإنِ انحنى","والشِّعرُ مِن حرفي تفجَّرَ مُبْهِرا",6,"ر",2,0],["فَهَتَكْتَ بالبِيضِ الرِّقاقِ سُجُوفَها","وفَضَضْتَ بالجُرْدِ العِتاقِ خِتامَها",7,"م",3,0]]}