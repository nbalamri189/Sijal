مُ","https://www.poetsgate.com/ViewPoem.aspx?id=212108",""],[5145,"أتنكر أني بكم مغرم","https://www.poetsgate.com/ViewPoem.aspx?id=108229",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5419,"خيرٌ وأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=39918",""],[5431,"فإن الصبرَ من عزم الأمور","https://www.poetsgate.com/ViewPoem.aspx?id=187730",""],[5491,"سأترك الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215020",""],[5522,"يا سادتي ما سلا قلبي محبتكم","https://www.poetsgate.com/ViewPoem.aspx?id=188704",""],[4623,"دعوني فاني لست أخشى من العين (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146684",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[694,"قد كان بعدك أنباء وهنبثة","https://www.poetsgate.com/ViewPoem.aspx?id=81337",""],[6070,"بكيتُ حتى سَكَبْتُ الحِبْرَ مِنْ قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=197536",""],[6187,"الدائرة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82160&r=&rc=4",""]],"verses":[["فقد رأيت غلاماً صيغ منفرداً","بالحسن يصبو إليه كل إنسان",0,"ن",1,0],["فَقَدَرتُ لِلوَردِ المُغَلِّسِ غُدوَةً","فَوَرَدتُ قَبلَ تَبَيُّنِ الأَلوانِ",1,"ن",1,0],["فقد رمَّ حاليَ تاج العُلى","ونابَ الصديقُ عن الصاحب",2,"ب",1,0],["فقد رأى القلبُ من نذالته","ما رأتِ العينُ من سماجتِهِ",3,"ت",2,0],["فَقَد راحَ غَضباناً وَلي ما رَأَيتُهُ","ثَلاثَةُ أَيّامٍ وَذا اليَومُ رابِعُ",4,"ع",1,0],["فقد راعني أنَّ المشيبَ مُسَلِّمٌ","كما رابني أنَّ الشبابَ مُودِّعُ",5,"ع",1,0],["فَقَد رُكِزَت سُمرُ الرِماحِ وَأُغمِدَت","رِقاقُ الظُبا مَجفُوَّها وَرَفيعُها",6,"ع",3,0],["فَقَد رُزِئَ الأَقوامُ قَبلِيَ بِاِبنِهِم","وَإِخوانِهِم فَاِقني حَياءَ الكَرائِمِ",7,"م",1,0],["فَقَد رَفَعَ الإِسلامُ سَلمانَ فارِسٍ","وَقَد وَضَعَ الشِركُ الشَريفَ أَبا لَهَب",8,"ب",1,0],["فَقَد رَضيتُ بِما أَصبَحتِ راضِيَةً","ها قَد هَلَكتُ عَلى اِسمِ اللَهِ وَالبَرَكَه",9,"ك",2,0],["فقد رثى لي وألانَ القولا","والحمدُ للهِ على ما أولى",10,"ل",2,0],["فَقَد رَأَت وَوَعَت عَنهُنَّ وَاِختَلَفَت","ما بَينَهُنَّ وَمَن يَهوَينَ بِالكُتُبِ",11,"ب",1,0],["فَقَد رَأَيتُ بَناتِ الدَهرِ غافِلَةً","في الغُبَّرَينِ وَما حَيٌّ بِخَلّادِ",12,"د",1,0],["فَقَدْ رَأَوْا رَأْي عَيْنٍ كَيْفَ بُورِك فِي","جَنَى سَلِيمٍ وَسَمْعانٍ مُذِ ائْتَلَفَا",13,"ف",2,0],["فَقَدَّرت الأَعداء ناعيكَ وَالها","وَقَد دَرَت العَلياء أَيّ فَتى ينعى",14,"ع",2,0],["فقَد رَجَعَتْ وُفودُ الأرْضِ تُثني","بذاكَ الطَّوْلِ، وَالمِنَنِ الجِسَامِ",15,"م",1,0],["فَقَدْ رُكّزَتْ سُمرُ الرّماحِ وَأُغمدتْ","رِقاقُ الظُّبَا مَجفُوُّهَا وَصَنيعُهَا",16,"ع",3,0],["فقد رضيت الأكواخ وهي نعيم","وهجرت القصور وهي شقاء",17,"ا",2,0],["فقدر لنا الخيرَ الذي أنت أهلهُ","فما أحدٌ عما تُقَدِّرُ حائدُ",18,"د",1,0],["فقدرتْ للوردِ المغلِّسِ غُدْوة ً","فوردْتُ قبلَ تَبيُّنِ الأوانِ",19,"ن",1,0],["فَقَد رَاضَ الدَّفَاتِرَ في صِبَاهُ","وأبدَى الغَثَّ مِنهَا والسَّمِينَا",20,"ن",2,0],["فَقَد رأَينَا بِه سِيمَا تُؤيِّدُ ما","أخفَاهُ مِن حَالِهِ والنَّاسُ مُطَّلِعَه",21,"ع",2,0],["فقدرُ هذا هيّنٌ عندنا","وحقُّ إسماعيل لا يُجهل",22,"ل",1,0],["فقدر شكر الفتى لله نعمته","كقدر صبر الفتى للحادث الجلل",23,"ل",1,0],["فَقَد رَحَلَ المُختارُ عَن خَيرِ مَنزِلٍ","إِلى يَثرِبٍ تَسري بِهِ العِيسُ مُصعَدا",24,"د",2,0],["فَقَد رُبَّما لِلجَدِّ يُكرَمُ ناهِقٌ","فَيُخلى لَهُ المَرعى وَيُحرَمُ صاهِلُ",25,"ل",1,0],["فقَدْرُك لا يجوز عليه خَفْضٌ","إلى أنْ يدخلَ الأفعالَ خَفْض",26,"ض",1,0],["فقدرُ امرىءٍ حَسْبُ ما عنده","منَ العلمِ لا مالَه من وَسام",27,"م",1,0],["فَقَدرُهُ كَقِدرِهِ","وَقِدرُهُ كَقَدرِهِ",28,"ر",2,0],["فقد رَثَّت قُوى العهدِ","كما رثَّت قوى الحُبِّ",29,"ب",1,0],["فقد رأيت شرار النار ملتهباً","بمسقط الماء من خزان أسوان",30,"ن",1,0],["فَقَدْ ردَّ الملائِكُ في رَدَاهُمْ","شَياطِيناً لنَزْوٍ أوْ لنَزْغِ",31,"غ",1,0],["فَقَد رَفَع التجريدُ عِيسى إلى السّما","وَساخَ بقارونَ التموّلُ في الأرضِ",32,"ض",1,0],["فَقَدِّر فَكُلُّ اِمرِئٍ قادِمٌ","عَلى عِلمِ ما كانَ قَد قَدَّما",33,"م",2,0],["فَقَد راقَ أُنسي وَالصَفا وَقتهُ صَفا","فَللّه عَيشي ما أَلذّ وما أَهنى",34,"ن",2,0],["فقد رمَى العِيسُ بالأبصارِ خاشعةً","ومَدَّتِ الخيّلُ للتَّرحالِ آذانا",35,"ن",2,0],["فقد رَضيتُ على أن","لا تَبعَثي التَّسهيدا",36,"د",2,0],["فقد راحَ مسلوبَ العَزَاءِ كأَنَّه","ووُقِّيتَ مما يَضْرِبُ اللَّوْمَ أَهْوَجَا",37,"ج",2,0],["فقد رَأَتْ أَنَّهُ حقّاً لَهُ خُلِقَتْ","كَمَا رأَى أَنَّهُ حَقّاً لَهَا خُلِقا",38,"ق",2,0],["فَقَدْ رَأَى الأَرضَ تأباهُ فَتُنْكِرُهُ","إِذْ لا سِوى دمِ من عادَاكَ تَعْرِفُهُ",39,"ف",2,0],["فقد رضيتُ قديماً ما شقيتُ به","ولم أزل ذلكَ المستعذبَ الراضي",40,"ض",2,0],["فقد رتَعتَ منه في ال","معبَّقِ المعتَمِّ",41,"م",1,0],["فقد رآكَ وانتَشى","مِن حُسنِكَ الفَتَّانِ",42,"ن",1,0],["فقد رأوا منك ماذا كنتَ تعملهُ","في ضالعٍ شذّ أو في مارقٍ مَرَقا",43,"ق",2,0],["فقد رئي فيه من القعود","من سائر الحضور والوفود",44,"د",1,0],["فَقَدِّرْ سَخِيَّ النَّفْسِ يُوفِيكَ كُلَّمَا","تَقَلَّبَ دَهْرٌ، أو نَبَاكَ حبيبُ",45,"ب",1,0],["فَقَدْ رَاقَنِي يَوْمَ الوَداعِ وَراعَنِي","بِحُسْنٍ وحُزْنٍ فرقُهُ وفَرِيقُهُ",46,"ق",2,0],["فقد رجُوتُك لي دنيا وآخرَةً","للعفوِ والنَّصرِ في حِلِّت وإمرار",47,"ر",1,0],["فَقَد رُميَت بَنُو عَبسٍ بحِصنٍ","إلَى أَن جاوَزَت بِالرَّغمِ حِصنَا",48,"ن",2,0],["فقدّرَان اكونَ عديمَ حظٍّ","لذلك خُصَّ بي فرطُ الذكاءِ",49,"ا",2,0],["فقدرك الفخم ليس يلفي","مثلي هماماً له يواتي",50,"ي",1,0],["فَقدّروا الجُعل لَهُ وَسارا","مِن بَعد أَن قَد أَخَذَ القَرارا",51,"ر",2,0],["فقد رزق الطير في وكره","وخصَّ الجنين بطيب الغذا",52,"ا",1,0],["فقد رأيت للشريف ان يرى","أخا الشريف وأبا للشرف",53,"ف",1,0],["فقدركم القدر الرفيع وها أنا","على قدر حالي قد رفعت قصيدتي",54,"ي",1,0],["فقدّروا للثلث ثلث ذا العدد","والنصف بالنصف الذي له يُعَد",55,"د",1,0],["فَقَدْ رَدَدْتُ كُؤُوسَ الرَّاحِ مُتْرَعَةً","عَلى السُّقاةِ وَكَانَتْ جُلَّ مَشْرُوبي",56,"ب",2,0],["فقدري بهذا الاسم يخترق السما","كفاني اختيار الحق في كل موطن",57,"ن",1,0],["فقدر اللَه أن يرقى لجنته","وأن أدوم بدار الذل والنكد",58,"د",1,0],["فقدر كراه يأخذه ذهوباً","فقيرٌ أو أخو عدمٍ أسيرُ",59,"ر",1,0],["فَقَدرُكَ كُلَّ يَومٍ قَد تَسامى","وَجَدُّكَ كُلَّ يَومٍ قَد تَراقى",60,"ق",2,0],["فقد رأى منه في مصر له سنداً","وفي سوى مصر منه قد رأى سندا",61,"د",2,0],["فقدر المال عند نداك هين","وسعر الشعر عند علاك غالي",62,"ل",2,0],["فقد رابني أني أرى الصبح أقتماً","لمصرعه والليل ما زال سرمدا",63,"د",2,0],["فقد ركزت مدى الأيام ألوية","من العدالة بين الناس تنتشر",64,"ر",1,0],["فقد ردني عما سالت ولَم يكن","يرد سؤالي ويخالف في وعدي",65,"د",2,0],["فقد راعهم من آل عثمان دولة","مجيدية دانت لها الترك والعرب",66,"ب",1,0],["فقد رمت أن أجنى من الخد وردة","لأطفى بها نارا لها الوجد أشعلا",67,"ل",2,0],["فقد رجوت الوَصَل من","هذا القوم الألفي",68,"ي",1,0],["فقدْره لي منقصٌ قدري","ومنقصٌ إكبارهُ كِبْري",69,"ر",2,0],["فقد رأينا عليا","يقدّم الفاروقا",70,"ق",2,0],["فقد رآينا أطبّاء الورى ذكروا","بالراح والعين تقوى العين والراح",71,"ح",1,0],["فقد رماني الدهر عن فقره","بسهم فقرٍ غير لغبان",72,"ن",1,0],["فقد راقت بك الدنيا بسرٍّ","وسُرَّت حين بها تكون والي",73,"ل",2,0],["فقد ركبتكَ خيلُ أبي شُجاعٍ","بضَيمٍ لم يكنْ لكَ في الحِسابِ",74,"ب",1,0],["فقد رمى بك قولٌ كنتَ قائلَه","على فَقارَةِ صعبٍ ظهرُهُ عارِ",75,"ر",1,0],["فقد رفَعَتْ أبْصارَها كل بلدةٍ","من الشوقِ حتّى أوْجَعَتْها الأخادِعُ",76,"ع",1,0],["فقد رأينا فعل الزمان بأه","ليه كفعل الشواظ في حطبه",77,"ب",2,0],["فقد راقَتِ الدّنْيا جَمالاً وبهجةً","وقد أخصَبَتْ منْها بِطاحٌ عَثاعِثُ",78,"ث",1,0],["فقد راقَها منهُ الكمال وقُرْبُه","وقد راعَها منهُ المنالُ وبُعْدُهُ",79,"د",2,0],["فقدرةُ الله في تاريخها سندٌ","دار السعودُ بدار الفخر والطربِ",80,"ب",1,0],["فقد رُزينا بمَنْ هُدَّتْ لِمَصْرعها","شُمّ الشوامخ وانْهدّت ذُرى القُلَلِ",81,"ل",1,0],["فقدر لي منها الشفاء لعلتي","وذاك مرادي أبتغي وأريد",82,"د",1,0],["فَقَد رَقرقت كَأسَ الهَوى كفُّ وَاعظٍ","وَأُدمِجَ زورُ الخدع في الأَدب الغَض",83,"ض",1,0],["فَقد راقَ لي دَهري وَوافت مسرّتي","وَصافى الَّذي أَهوى وَأَزهَر طالعي",84,"ع",2,0],["فقد روى السادة الأخيار أجمعهم","رواية صح معناها ومبناها",85,"ا",3,0],["فَقَد رَقاهُ مَولاهُ لَدَيهِ","لِيَعطي جَنَّة الاحبار اَجرا",86,"ر",2,0],["فقد روَّيتُ قبركَ من عيوني","بما يكفيهِ للابد السحابا",87,"ب",2,0],["فقد رثى شامتى لى مذ رأى سقمى","زاك وحرّ لهيب الوجد في ذاك",88,"ك",1,0],["فَقَد رَدَّهُ شَيخُ النُحاةِ اِبنُ مالِكٍ","وَناهيكَ مِن حَبرٍ بِذاكَ مَسودِ",89,"د",1,0],["فَقَد رابَني أن الشُؤون تضارب","وَأنَّ شُهود الصالحات غيوب",90,"ب",1,0],["فَقَد رَأَيت سَواد الناس في جَلب","يُناضِلون بِلا قَوس وَلا وَتَر",91,"ر",1,0],["فقدرة العالي لمجد مستعد","وهو بما يعمل فيه متحد",92,"د",1,0],["فقد رماك بريبٍ لا شفاء له","إلا النصوح التي ترضى من التوب",93,"ب",1,0],["فقد رَضينا على كيدِ الزمان لنا","ألّا يكونَ بنا فقرٌ إلى أحدِ",94,"د",1,0],["فقد راضوا على هذا نفوساً","لهم نافت عن أخلاق العنيد",95,"د",1,0],["فَقَدْ رَوَى ثِقَةٌ عنْ مِثْلهِ نَبَأً","يَهِيجُ سِرَّ الفتى الحُرِّ الأَبي الفَهِمِ",96,"م",1,0],["فقد راحَ يبغي العيشَ والعيشُ مطْلَبٌ","وفي كلِّ أرضٍ يقتفي العمرَ هادمُهْ",97,"م",2,0],["فقدرُها قدرُ عمْر المرء ممتلِئاً","بالصّالحات , فهل تبغي لها سببا ؟",98,"ب",2,0],["فقدّرْ لنا لقيا تفيضُ مسرّةً","فأنتَ الذي بالأمرِ يحصلُ أمرُهُ",99,"ر",2,0],["فقدرُكَ بالإكرامِ يسكنُ داخلي","بصدقِ قريضي وانثيالِ مشاعري",100,"ر",2,0],["فقد رقَّ الفؤادُ لكلِّ أمٍ","وسال الدّم من حدق المدامعْ",101,"ع",1,0],["فَقَدَّرَهُ الْعُشَّاْقُ فِي الْعِشْقِ قَدْرَهُ","وَمَاْ قَدَّرُوْا إِلاَّ الَّلبِيْبَ الْمُهَذَّبَاْ",102,"ب",2,0],["فَقَدْ رَوَّعُوا الأَطْفَاْلَ جَرَّاْءَ بَطْشِهِمْ","فَكَمْ مَنْزِلٍ أَضْحَىْ مِنَ الإِنْسِ خَاْلِيَاْ",103,"ي",2,0],["فقد رأب الدستور منه صدوعه","فأصبح كالمرآة في العين صافيا",104,"ي",2,0],["فَقَد رَوَتِ المَحَافِلُ أنَّ نُورًا","كَمَثلِ البدْرِ مَسْكنُه ُالسَّمَاء ُ",105,"ا",2,0],["فقد رضعوا من ندى كفه","أفاويق لا حان أن يفطموا",106,"م",3,0],["فقد رد صديق عليه وقد رأى","مقالته الشنعا فأحسن في الرد",107,"د",1,0],["فقد رمت أن لا يعبد الله وحده","وأن يعبد إلا قوام من دونه الخلقا",108,"ق",2,0],["فقد رمانا بأمر ما نظن به","كيما