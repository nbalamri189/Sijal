{"poems":[[53,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55191","الكامل"],[119,"روحي وأرواح الوجود","https://www.aldiwan.net/poem42166.html","مجزوء الكامل"],[173,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[236,"حيتك السنة الحيا من دار","https://www.aldiwan.net/poem44590.html","الكامل"],[236,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[276,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[580,"حسنها كل ساعة يتجدد","https://www.aldiwan.net/poem3089.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83318","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86940","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119892","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73531","البسيط"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144772","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133988","الكامل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105085","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88923","الكامل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141843","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90893","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[5205,"كتب الجمال بطرس خذك أسطراً","https://www.poetsgate.com/ViewPoem.aspx?id=120995",""],[5277,"قبضةٌ من السَّنا","https://www.poetsgate.com/ViewPoem.aspx?id=211273",""],[5290,"رعي الحقوق كما علمت حقيق","https://www.poetsgate.com/ViewPoem.aspx?id=113130",""],[5324,"احبك هل تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=214022",""],[5704,"يا ليت...","https://www.poetsgate.com/ViewPoem.aspx?id=198741",""],[6152,"28 فبراير","https://www.poetsgate.com/ViewPoem.aspx?id=202883",""],[6152,"عائشة رضي الله عنها","https://www.poetsgate.com/ViewPoem.aspx?id=203081",""]],"verses":[["هو أحرى بأن يشكَّ ويُغْرَى","باتهام الحكيم في التقديرِ",0,"ر",1,0],["هُوَ أَحْمدُ السَّمَحُ الَّذِي فِي وَرْدهِ","مِنْ كُلِّ مَحْمِدَةٍ شِفَاءُ غَلِيلِ",1,"ل",1,0],["هو أحمد ومحمد ال","محمود مصباح السعود",2,"د",1,0],["هُوَ أَحنى عَلى الرَعايا وَإِن عَق","قَتهُ مِن والِدٍ عَلى الأَولادِ",3,"د",1,0],["هو أحمد المختار أحمد مرسل","قتّال كل معاند ختار",4,"ر",1,0],["هو أحمد الآتي بخير شريعة","بيضاء عن وجه الهداية أسفرت",5,"ت",1,0],["هُوَ أَحمَدُ الهادي البَشيرُ مُحَمَّد","قَتّالُ أَهلِ الشِّركِ وَالطُّغيانِ",6,"ن",1,0],["هُوَ أَحمَد الهادي المجاهد والَّذي","يروى بكوثره الغَليل الصادي",7,"د",2,0],["هو أَحْمى مِمَّا تَدَرَّعَ في الحر","ب وهْوَ أَمْضَى مِنْ مَشْرِفيٍّ مُهند",8,"د",1,0],["هُوَ أَحمَدُ المَحمودِ مَن في حِلِّهِ","كَنَفُ الوُجودِ تُشرِفُ الثَقَلانِ",9,"ن",1,0],["هُوَ أَحرى ببنت فكرٍ عَروسٍ","ساقَها خدمةً إِلَيهِ فَتاه",10,"ا",2,0],["هُوَ أَحمَد بِنُ محمدٍ مَن ذكرُهُ","يَبقى مَدى الدُنيا بِغَير تَناسي",11,"س",2,0],["هو أحلى من الخدود إذا","أنبت فيها الحياء ورد القطافِ",12,"ف",1,0],["هو أحمد المترضى عدلا ومعرفة","لذاك لم يعد عن مولاه منصرفا",13,"ف",2,0],["هو أحمد المرتضى عدلا ومعرفه","وكيف نصرف من بالعدل قد علما",14,"م",2,0],["هُوَ اِحمِرارُ دِماءِ الرُوم سَيَّلَها","بِالبيضِ مَن مَرَّ مِن آبائي الأَوَلِ",15,"ل",1,0],["هو أحمد الأوصاف فرد زمانه","ووحيده من قادة وخواص",16,"ص",1,0],["هو أحمدُ البدوِيُّ ساكنُ طندتا","هذا أبو الأطقابِ والفتيان",17,"ن",1,0],["هو أحمد الفعال خيري القصد من","شمل الملا بتفضل وتكرّم",18,"م",1,0],["هو أحلى لدي من راكد الغد","ران والماء صاف وراسب",19,"ب",1,0],["هو أحمد الأسماء أسمى حامد","هو أصلح الأعلام والأعمال",20,"ل",1,0],["هو أحمد الهادي البشير المنذر ال","زَاكي المنير الوجْه للمستَعْلِمِ",21,"م",1,0],["هو أحمد المدعو حمدي حبذا","ذات بمعناها تسامى أسمان",22,"ن",1,0],["هو أحمدٌ خيرُ الخلائقِ كلِّها","عبدٌ عزيزٌ صفوةٌ مختارُ",23,"ر",1,0],["هو أحيا المبدأ الصحيح وأفنى","\"مادعوه \"\"الطريقة المدرسية\"\"\"",24,"ي",2,0],["هو أحمد المحمود عند مليكه","سامي المفاخر والعناصر والذرى",25,"ر",2,0],["هو (أحمدٌ)..و(المحكماتُ) تدلّنا","أنّ (الصراطَ) إلى (المحمّدِ) يتبعُ",26,"ع",1,0],["هو أحمد ومحمد والمصطفى","والمجتبي والصادق المصدوق",27,"ق",1,0],["هو: أحبّكِ ..هل تحبيني?","هي: أحبكَ قبل تكويني",28,"ي",1,1],["هو أحمد المحمود هو المرتضى","من نوره سطع الضيا متتاليا",29,"ي",2,0],["هو أحمد ذاك الموشح بالندى","من عاش للخلق الرفيع نديما",30,"م",2,0],["هو إحتواء وتقدير ومغفرة","لا .. ليس زيفا وأحلاما وترفيها",31,"ي",3,0]]}