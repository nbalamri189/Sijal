خات من أعلى المنارة","https://www.poetsgate.com/ViewPoem.aspx?id=142533",""],[5413,"الفراعينُ الجددُ","https://www.poetsgate.com/ViewPoem.aspx?id=201418",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5563,"العين أصدق في الخبر","https://www.poetsgate.com/ViewPoem.aspx?id=213594",""],[5582,"لِمن مربع بالسفحِ أَقوت ملاعبه","https://www.poetsgate.com/ViewPoem.aspx?id=63464",""],[5638,"رثاء الشيخ أحمد ياسين","https://www.poetsgate.com/ViewPoem.aspx?id=198130",""],[5638,"رثاء البطل عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203607",""],[5725,"ولجارتي عتب عليّ","https://www.poetsgate.com/ViewPoem.aspx?id=192275",""],[5725,"ناسك","https://www.poetsgate.com/ViewPoem.aspx?id=198348",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5845,"أنسمة ُ طيبٍ أمْ صبا طيبة ً هبا","https://www.poetsgate.com/ViewPoem.aspx?id=198483",""],[5854,"أذكيتَ نيرانَ وجدي يا نسيمُ كفى ((بين الحاء والباء))","https://www.poetsgate.com/ViewPoem.aspx?id=197020",""],[161,"لفي كبدٍ خُلِقْتَ فَمَنْ تَلومُ ؟ !","https://www.poetsgate.com/ViewPoem.aspx?id=155650",""],[6147,"ترشف ..من دموعي..","https://www.poetsgate.com/ViewPoem.aspx?id=151494",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""]],"verses":[["وَرَأَوا أَنَّ طَريقَ ال","مَجدِ وَعرٌ وَإِكامُ",0,"م",1,0],["وَرَأَوا في مَناكِبِ المُلكِ وَهناً","فَدَعَوا بِاِسمِهِ فَكانَ جِبارا",1,"ر",2,0],["وَرَأوا بَوايجَها تَلوحُ وَرَيحَها","تَسري وَعارِضَها الغَزيرَ يَجودُ",2,"د",1,0],["ورَأَوا عُلا إسْحاقَ شَيّدَ سَمْكَها","كَرَمُ الرّضيِّ فَيا لَهُ منْ مَفْخَرِ",3,"ر",1,0],["وراوَدَ منْها فارِكاً قدْ تمنّعَتْ","فأهْوى لَها نصْلاً وهدّدَها رعْدا",4,"د",2,0],["وَرَأَوني سامِرِيّاً","يُتَّقى مِنهُ المَساسُ",5,"س",1,0],["وَرَأَوْا كَرَأْيِي أَمْثَلَ الْ","خُطَطِ التَّآلُفِ وَالرِّبَابَا",6,"ب",2,0],["ورأوا عليك ومنك في ال","مهد النُّهى ذات البصائرْ",7,"ر",1,0],["ورأوا عزمه لدينٍ ودنيا","شافياً كافياً غنيًّا مليّا",8,"ي",2,0],["ورأوْكَ مثل الطَّوْدِ ليْسَ بِنَاطِحٍ","لكنَّهُ يوهِي الرُّؤُوسَ النُّطَّحَا",9,"ح",2,0],["ورأوا بقيَّتَهُ أصحَّ معاذةٍ","للطِّفل بين موازجٍ وقوامِط",10,"ط",1,0],["ورأوا مكانك ريثَما أخليتَهُ","كمكانِ بعضِ الراسياتِ أزيلا",11,"ل",2,0],["وَرَأَوا جَلالَكَ في الضَريحِ فَكُلُّهُم","يَهوى وَيَرجو لَو مَكانَكَ يُقبَرُ",12,"ر",1,0],["وَرَأَوكَ قَد عَرَّضتَ صَدرَكَ لِلظُبى","عِندَ الحُصونِ فَعَرَّضوا الأَكفالا",13,"ل",2,0],["ورأوْا على الأَشواكِ ظلِّيَ هامِداً","فتخيَّلوا أَنِّي قضيْتُ ذَمائي",14,"ي",1,0],["وَرَأَوا غُبارَكَ في السُها وَتَراكَضوا","مَن لِلنُجومِ وَمَن لَهُم بِلَحاقِ",15,"ق",1,0],["وَرَأَوا لِلَّذينَ سادوا وَشادوا","سُبَّةً أَن تُسَخَّرَ الأَعداءُ",16,"ا",2,0],["وَرَأَوكَ اِعتَلَيتَ فَاِنتَحَروا حِق","داً عَلى مُبدِءِ العُلُوِّ مُعيدِه",17,"د",2,0],["وَرَأَوا أَنَّهُم إِذا وَصَلواتِ","كَ المَساعي بِالفِكرِ ذابوا نُحولا",18,"ل",2,0],["وَراوٍ عَلَيَّ الشِعرَ ما أَنا قُلتُهُ","كَمُعتَرِضٍ لِلرُمحِ دونَ الطَرائِدِ",19,"د",1,0],["ورأَوهُ شمساً في غَمامةِ نائلٍ","تَهمي وبدراً في دُجُنَّةِ عِثْيَرِ",20,"ر",1,0],["وَرَأوكَ مُعتَصِمَ العَزائِمِ فَاِختَشوا","بِكَ يَومَ عَمّورِيَّةَ المَشهودا",21,"د",2,0],["ورأوْا كلّ مُهْجَةٍ منهمُ سا","لتْ على صَدر رُمْحِه الزاعبيِّ",22,"ي",1,0],["وَرَأَوا بِلادَ اللَهِ قَد لَفَظَتهُمُ","أَكنافُها رَجَعوا إِلى جَوّابِ",23,"ب",1,0],["وَراوَدَ الغَيثَ فَاِنهَلَّت بَوادِرُهُ","بَعدَ الجُمودِ بِمُنهَلٍّ وَمُنسَجِمِ",24,"م",1,0],["ورأوه صُلْباً لا تَلِينُ قَناتُه","في الخطبِ يَفْدَحُ والمصيبةِ تَعْظُمُ",25,"م",1,0],["وَرَأوا في كُل قَلب حَوله","جذوةَ العزمِ وَنورَ الأَمَلِ",26,"ل",1,0],["وَرَأَوا شَمائِلَ ماجِدٍ أُنُفٍ","يُعطي عَلى المَيسورِ وَالعُسرِ",27,"ر",1,0],["وَرَاوَدَتْهُ الجِالُ الشُّمُّ مِنْ ذَهبٍ","عَنْ نَفْسِهِ فأراها أيُّما شَمَمِ",28,"م",1,0],["ورأوْهُ من حيثُ التَقَتْ أبصارُهمْ","مُتَصَوَّراً في صورةِ البُرْهانِ",29,"ن",1,0],["وَرأوا هنالك فارساً فإذا به","فرد أَتى يَعدو بلا أعوان",30,"ن",1,0],["وَرَأوكَ وَضّاحَ الجَبينِ كَما يُرى","قَمَرُ السَماءِ التِمِّ لَيلَةَ يَكمُلُ",31,"ل",1,0],["ورَأوْا في الْجَلالِ تُوتَنْخَموناً","صاعِداً جَدُّه رَفِيعاً لِواؤُه",32,"ا",3,0],["وَرَأوْا عَاهِلاً يَفِيضُ جَلالاً","مِنْ هُدَى ربِّه العَزِيزِ الْحَمِيدِ",33,"د",1,0],["ورَأَوْا شَبَاباً كالْجُمَان يَزِينُه","أَنَّى التَفَتَّ جَلالَةٌ ووَقَار",34,"ر",1,0],["ورَأوْا سَيِّداً يُضِيءُ شَباباً","باسِماً كَالمُنَى وَيَهْتَزُّ جُودا",35,"د",2,0],["وراوَدَتْهُ الجبالُ الشُّمُّ مِن ذَهَبٍ","عن نفسِه فأراها أيَّمَا شَمَمِ",36,"م",1,0],["ورأوا في السّلمِ ديناً يُقْتَضى","ورأوا في الحربِ للدَّين اقتضِاء",37,"ا",2,0],["وَرَأوْكَ اعتَلَيْتَ فانتَحَرُوا حِقْ","داً عَلى مُبدِىءِ الَعلِو مُعيدِهْ",38,"د",2,0],["وَرأوْا أنّهُمْ إذا وَصَلُوا تِلْ","كَ المَساعي بالفِكرِ ذابوا نحُولا",39,"ل",2,0],["وراوا أنني أسير هواهم","فرموني وأثقلوا الأغلالا",40,"ل",2,0],["وراودتُها عن لثمِهِ فَتَمَنَّعَت","وما عادةُ الأغصانِ أن تَمنَعَ الثَمَر",41,"ر",1,0],["ورأَوه والظفر التليد","جناه بين الفاتحين",42,"ن",1,0],["ورأوك أتقى عالمين بأنه","لولاك ما نال امرؤ ما نالا",43,"ل",2,0],["وراوا هوانا ما جرى حتى لقد","أكلوا الأكفّ ندامة وتنالا",43,"ل",2,0],["ورأوا محيا سرُّ منه من رأى","لسماحةٍ ورجاحةٍ ووسامِ",44,"م",1,0],["ورأوا هناك وقد نأيتُم أَنهم","يفدون موتاً حاضراً بمماتِ",45,"ت",1,0],["ورأوا أموراً لا تطاق فهللوا","من هولها لما رأوك وكبروا",46,"ر",3,0],["ورأوا رضى الباري الأهم فاسخطوا","من أسخطوا فيه بلا استحشام",47,"م",1,0],["ورأوا من فلك الأف","لاك تأثير المنير",48,"ر",1,0],["ورأوا أن فقيرا","صاحب المال الكثير",48,"ر",1,0],["ورأوا أن غنيّا","في غدٍ كل فقير",48,"ر",1,0],["ورأوا ما خرجوا منه","إلى دار الغرور",48,"ر",1,0],["ورأوا مصدر أروا","حهم قبل النشور",48,"ر",1,0],["ورأوا آثار تكرا","ر تصاريف الدهور",48,"ر",1,0],["وَرَأوا صحبهُ أُسوداً وأَقوى ال","أسدِ بَأساً ما ناله إزراءُ",49,"ا",2,0],["ورأوا عيونكِ فاستها","موا بالغزالةِ والغزالِ",50,"ل",1,0],["وَرَأوا جِسمَ الوجودِ","يَتَمَشّى لِلزَوالِ",51,"ل",1,0],["وَرَأَوكَ غايَةَ ما أُريدُ فَشَمَّروا","لِلبَينِ باعاً لا عَداهُ شلولُ",52,"ل",1,0],["وَرَأَوا عُقابَهُمُ المُدِلَّةَ أَصبَحَت","نُبِذَت بِأَفضَحَ ذي مَخالِبَ جَهضَمِ",53,"م",1,0],["وَرَاوَغَنِي لِيَخلُوَ بي خِداعاً","وَلا يَدرِي الشَّقِيُّ بِمَن يُخَالي",54,"ل",2,0],["وَرأوه بدرا ساطِعا متنقلا","بالنور في الارحام والاصلاب",55,"ب",1,0],["وَرَأَوا عُيونَ التُركِ أَسرَعَ في الوَغى","فَتكاً بِكُلِّ مُدَجَّجٍ وَمُتَوَّجِ",56,"ج",1,0],["وَرَأوا كأنّ الدرسَ أتعبَ مِقولي","فَتَدارَكوه براحةِ الحلقومِ",57,"م",1,0],["ورأوا فوق هامهم","أكؤس الراح تمتهن",58,"ن",1,0],["وَرَأَوا تَحريمَ ما حَلَلتُهُ","وَاِستَباحوا حُرَمي في حَرَمي",59,"ي",1,0],["وراويةُ المدائحِ لي عِيابٌ","تُجابُ بها السُّهولُ أَوِ الحُزوم",60,"م",1,0],["ورأوْك أكبرَ هِمّةً فَتَزاحَموا","من حَولِ حَوضِ نَوالِك المَوْرود",61,"د",1,0],["وراوحْتُ بين السَّرجِ والكُورِ سابقاً","على مِثْلِ خفاقِ الجناحَيْنِ أخْرج",62,"ج",1,0],["ورأَوا عُبابَ الفضلِ أَزبَدَ زاخِراً","فَثَنى السِنانَ قريبُهُم والنائي",63,"ي",1,0],["وَراودت قَلبي في التَسَلي بِغَيرِكُم","فَزايَلَني وَاِزدَدتُ كلماً عَلى كلم",64,"م",1,0],["وَرَأوا أَميرَ المُؤمِنينَ فَأَيقَنوا","أَنَّ الوهادَ تَطولها الأَطواد",65,"د",1,0],["ورأوا جباه الساحرين تعفَّرتْ","سجدوا لربّ العالمين خشوعا",66,"ع",2,0],["ورأوك تستبقي النساء رهائناً","وتُدير قتلاً في الرجال فظيعا",66,"ع",2,0],["ورأوك في غيِّ التطاول سادراً","فتبرؤوا مما جنيتَ جميعا",66,"ع",2,0],["ورأوا دماً تُجْرِيهِ مِنِّي أدمعي","قالوا وقد نحر الكرى للزائر",67,"ر",1,0],["ورأوْا أنَّني مَرِيعٌ بزُهدي","في مَلاهِيهِمْ نَفاقُ نِفاقي",68,"ق",2,0],["ورأوا سواهُ على الحقيقةِ هالكاً","في الحال والماضي والإستقبال",69,"ل",1,0],["ورأَوْا هِلالَ الملكِ فَوْقَ سَريرِهِ","بسنا المكارِمِ والهدى المُتَهَلِّلِ",70,"ل",1,0],["ورأَوْا بقُرْبِكَ أَنَّهُمْ قَتَلُوا النَّوى","فاسْتُحيِيَت ولها عَلَيْهِمْ ثارُ",71,"ر",1,0],["وراودَه داعي النُّهَى فأجابه","إلى الصبر إلّا أن يقالَ يخونُ",72,"ن",1,0],["وراوح المهرجانُ العيدَ فاختلفا","عليك ما جَرَت الأرواحُ بالسفنِ",73,"ن",1,0],["ورأوا ظلامَ الأمر منذُ خبا","عنهم سراجُ النَّهْي والأمرِ",74,"ر",1,0],["وراوحَها القِعابَ ليعتشيها","فضرعٌ زلَّ أو خِلفٌ يَنِدُّ",75,"د",1,0],["وراودني ملوكُ الناس عنها","وكلٌّ باذلٌ فيها خطيبُ",76,"ب",1,0],["وراووقنا يبكي بمرجان دمعه","وكاساتها عن لؤلؤٍ تتب