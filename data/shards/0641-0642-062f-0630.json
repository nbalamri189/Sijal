{"poems":[[65,"أقول لصاحبي والوجد يمري","https://www.aldiwan.net/poem45705.html","الوافر"],[65,"خليلي إن السيل قد بلغ الزبى","https://www.aldiwan.net/poem45713.html","الطويل"],[23,"لعمرو أبيك الخير يا شعث ما نبا","https://www.aldiwan.net/poem21234.html","الطويل"],[91,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[89,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[189,"توالى عذابي من عذاب المراشف","https://www.aldiwan.net/poem14600.html","الطويل"],[564,"أنخ هديت الاينقا","https://www.aldiwan.net/poem69351.html","مجزوء الرجز"],[572,"وما زال يبري أعظم الجسم حبها","https://www.aldiwan.net/poem69627.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59807","الطويل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69466","الوافر"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120790","الهزج"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85162","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34683","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33298","الوافر"],[5025,"ضربت جحيشاً ضربة لا لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=52764",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5720,"شبابُ القنفذة","https://www.poetsgate.com/ViewPoem.aspx?id=199902",""]],"verses":[["فَقَد ذَكَّرتِنا شَجَناً قَديماً","وَأَيَّ هَوىً عَلى إِضَمٍ نَسينا",0,"ن",2,0],["فَقَد ذَلَّ حَتَّى كادَ يَرحَمُهُ العِدا","وَما الحُبُّ يا ظَمياءُ إِلّا كَذلِكِ",1,"ك",1,0],["فَقَد ذاقَتِ الأَوسُ القِتالَ وَطُرِّدَت","وَأَنتَ لَدى الكَنّاتِ كُلَّ مُطَرَّدِ",2,"د",1,0],["فقد ذوىَ الغصن الذي كان ناضراً","وقد عطِّل الجيد الذي كان حاليا",3,"ي",2,0],["فقد ذُدْتُم الهِيمَ الخوامسَ عن دمي","وقد كَرَبتْ أعناق قومٍ تَفَسَّخُ",4,"خ",1,0],["فَقَدْ ذُقْتُ طَعْمَ الدَّهْرِ حَتَّى لَفَظْتُهُ","وَعَاشَرْتُ حَتَّى قُلْتُ لاِبْنِ أَبِي دَعْنِي",5,"ن",2,0],["فقدذاق صَرْفُ الدهر عودى وهَزه","فأَلفاهُ مُرا لا يَلينُ لعاطِف",6,"ف",1,0],["فَقَدْ ذَوى عود النَّوى","وغُصْنُ وصْلى أوْرَقَا",7,"ق",2,0],["فَقَدْ ذُبْتُ حَتَّى صِرْتُ إِنْ أَنَا زُرْتُهَا","أَمِنْتُ عَلَيْهَا أَنْ يَرَى أَهْلَهَا شَخْصِي",8,"ي",1,0],["فقد ذكر ابن القيم الحبر أنها","قضية عين خصصت بمحمد",9,"د",1,0],["فقد ذهب المجد الصريح بفقده","وقد فُقد المعروف والخلق السبط",10,"ط",1,0],["فَقَد ذُقتُم قِراعَ بَني أَبيكُم","غَداةَ الرَوعِ بالبيضِ الذَكورِ",11,"ر",1,0],["فقد ذاقت كما شئنا","لباس الجوع والخوف",12,"ف",1,1],["فقد ذكرنا صور البروج","وشرح سر علمها البهيج",13,"ج",1,0],["فقد ذبحت في مقلتي سنة الكرى","وهادمها في متن خدي شواهده",14,"د",2,0],["فقد ذهبت بشاشة كل شيءٍ","وعادَ الدينُ مطروحاً مهينا",15,"ن",2,0],["فقد ذهبَ العزاءُ وعيلَ صبري","ولستُ بكلِّ ما ألقى بصيرُ",16,"ر",1,0],["فقد ذقت يا جحش بن سودة ضربتي","وجدربتني إن كنت من قبل في شك",17,"ك",1,0],["فقد ذكر الأعلام من كل جهبذ","مناقبهم واستوعبوها لتعلما",18,"م",2,0],["فقد ذادوا ومازالوا بصدقٍ","على عهدٍ متينٍ . . لا يلِينُ",19,"ن",1,0]]}