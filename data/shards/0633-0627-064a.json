ttps://www.aldiwan.net/poem12720.html","السريع"],[451,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[456,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[456,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[477,"بين كفيها طرحت الأملا","https://www.aldiwan.net/poem36897.html","الكامل"],[477,"فيك يحلو الغزل","https://www.aldiwan.net/poem36917.html","مجزوء الرمل"],[477,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[477,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[477,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[491,"رقراقة في السراب تحسبها","https://www.aldiwan.net/poem67389.html","البسيط"],[507,"كل شيءٍ مصيره للزوال","https://www.aldiwan.net/poem744.html","الخفيف"],[507,"سا ئل سدوس التي أفنى كتائبها","https://www.aldiwan.net/poem747.html",""],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[536,"سائلي عنه وعن سيرته","https://www.aldiwan.net/poem48201.html","عموديه"],[541,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[549,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[549,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[549,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[551,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[556,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[556,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[558,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[565,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[573,"أغناك طرفك أن تسل الأبترا","https://www.aldiwan.net/poem2954.html","الكامل"]],"verses":[["سَائِل بِقومي لِم نَبا الدَهرُ بِهِم","عَن غَيرِ ضِغَنٍ وَرَماهُم عَن شَزَن",0,"ن",1,0],["سائِلاتِ الرِفاقِ أَينَ مَصابُ ال","غَيثِ مِن جَوِّ مَربَعٍ وَمَصيفِ",1,"ف",1,0],["سائِل بِصَحبي أَنّى وُجهَةٍ سَلَكوا","عَنّا وَأَيَّ الثَنايا بَعدَنا طَلَعوا",2,"ع",3,0],["سايَرتُ أَزماني فَلَم أَبلُغ مَدىً","حَتّى اِستَقَلَّ بي الثَناءُ السائِرُ",3,"ر",1,0],["سائِل بِهِ يَومَ الزُبَيرِ مُشَمِّراً","يَختالُ بَينَ ذَوابِلٍ وَصِفاحِ",4,"ح",1,0],["سائِل عَنِ الطَودِ لِم خَفَّت قَواعِدُهُ","وَكانَ إِن مالَ مِقدارٌ بِهِ رَجَحا",5,"ح",2,0],["سائِل عُمَيرَةَ حَيثُ حَلَّت جَمعَه","عِندَ الحُروبِ بِأَيِّ حَيٍّ تُلحَقُ",6,"ق",1,1],["سائِلي يا عُبَيلَ عَنّي خَبير","وَشُجاعاً قَد شَيَّبَتهُ الحُروبُ",7,"ب",1,0],["سائِل تَميماً بِهِ أَيّامَ صَفقَتِهِم","لَمّا أَتَوهُ أَسارى كُلَّهُم ضَرَعا",8,"ع",2,0],["سائِل بَني أَسَدٍ عَنّا فَقَد عَلِموا","أَن سَوفَ يَأتيكَ مِن أَنبائِنا شَكَلُ",9,"ل",1,0],["سائِلوا سيشِلاً أَأَوجَسَ خَوفاً","وَسَلوا طارِقاً أَرامَ اِنسِحابا",10,"ب",2,0],["سائِلاً عَن وَصِيَّةَ اللَهِ فيهِ","آخِذاً قوتَهُ بِحَدِّ الحُسامِ",11,"م",1,0],["سائِلوا اللَيلَ عَنهُمُ وَالنَهارا","كَيفَ باتَت نِسائُهُم وَالعَذارى",12,"ر",2,1],["سائِلوا الطَيرَ إِذا ما هاجَكُم","شَدوُها بَينَ الهَوى وَالطَرَبِ",13,"ب",1,0],["سائِلا القَلبَ إِن قَدرتُم عَلى أَن","تَسأَلاهُ عَنِ اِسمِ من حَلَّ فيهِ",14,"ي",2,0],["سائِلِ الرَبعَ وَالدِيارَ اللَواتي","بِتُّ أَسقي طلولَها مِن دُموعي",15,"ي",1,1],["سائلْ ببدرٍ عنهمُ بدرَ الهدى","فبهم على حزب الضلال قد انتصرْ",16,"ر",1,0],["سائِل ذَوي يَمَنٍ وَسائِلهُم بِنا","في الأَزدِ إِذ نَدَبوا لَنا مَسعودا",17,"د",2,0],["سائِل تَميماً وَبَكراً عَن فَوارِسِنا","حينَ اِلتَقى بِإِيادِ القُلَّةِ الكَدَرُ",18,"ر",1,0],["سائِل بِهِنَّ أَبا رَبيعَةَ كُلَّهُم","وَاِسأَل بَني غُبَرٍ غَداةَ الحائِرِ",19,"ر",1,0],["سائِل بَني الحَرثِ المُزري بِمَعشَرِهِ","أَينَ الغَزالُ عَلَيهِ الدُرُّ مِن ذَهَبِ",20,"ب",1,0],["سائِل بِحَنبَلَ إِن أَرَدتَ بَيانَها","ماذا أَرادَ بِخُربِها المَنقوبِ",21,"ب",1,0],["سائِل بَني الأَشعَرِ إِن جِئتَهُم","ما كانَ أَنباءُ أَبي واسِعِ",22,"ع",1,1],["سائِل أَبا كَرِبٍ وَسائِل تُبَّعاً","عَنّا وَأَهلَ العِترِ وَالأَزلامِ",23,"م",1,0],["سائِل قُرَيشاً وَأَحلافَها","مَتى كانَ عَوفٌ لَها يُنسَبُ",24,"ب",1,1],["سائلي عن شرحِ حالي","كيفَ حالُ الضعفاء",25,"ا",2,1],["سائلي اليوم كيف حالِيَ في القس","مِ ونظارة القضاة السراة",26,"ه",1,1],["سائرات في الأفقِ بين الجواري","والجواري في حسنها كالعبدا",27,"د",2,0],["سائلي عن شرح حالي بعد من","خلفوني مفرداً بين الورى",28,"ر",2,1],["سائلي سائلَ الدموع بخدِّي","عن جوى القلب وانظري مغناك",29,"ك",1,0],["سايرتها خيل العطا مسرجات","في حلاها ومسرجات الأهله",30,"ل",2,0],["سائلاها عسى يجيب صدَاها","أين ولَّى مجيب أهل السؤال",31,"ل",1,0],["سائلي عن قديم دهريَ إيهاً","ذاك وقتٌ مضى ودهرٌ تولَّى",32,"ل",2,0],["سائرات أقلامه يوم حفظ","وعطاءً على الصراطِ سويّا",33,"ي",2,0],["سائر الذكر إن عكست وإن أس","قطت حرفاً كذاك منه السريّ",34,"ي",1,0],["سائلْ بسؤدَدِهِ المعا","شرَ بل ندَاهُ وانسكابهْ",35,"ب",2,0],["سائلْ بذلك بَخْسَهُ","حقَّ الغواني واغتصابهْ",35,"ب",2,0],["سائل بذلك عَنْه حربَ المهتدِي","وكباشَهَا من ناطح ونطيحِ",36,"ح",1,0],["سائلي عن أبي الحسين بدا الصُّب","ح فأغنى عن جَذْوةٍ في وَقُودِ",37,"د",1,0],["سائر المدح وإن كا","ن بكم إغذاذُ سيره",38,"ر",2,0],["سائراتٍ في الأرضِ شرقاً وغرباً","فاغدُ للإثمِ آمناً غير خاش",39,"ش",1,0],["سائس تدبيره ورائِضه","كخير سُوَّاسه وروَّاضه",40,"ض",2,0],["سائل صديقاً عن الطائي هل ذهبت","دماء قتلاه أو جرحاه أطلافا",41,"ف",2,0],["سائل أبا الصقر إذا جئتَه","عن أمِّه ذات البساتيقِ",42,"ق",1,1],["سائلي عن أبي الحسين بدا الصب","حُ فأغنى أن تستضيء الذُّبالا",43,"ل",2,0],["سائلْ بيَ الشعرَ إني من مَصاعبهِ","فإن أبيتَ فهبني من أَزامِلِهِ",44,"ل",2,0],["سائلاً جِلَّها لغيْرِ اشتطاطٍ","سائلاً دِقَّها لغير اغتنامِ",45,"م",1,0],["سائل القمعَ ليلة القَفْص عنهُ","بين حاناتها وبينَ الكُروم",46,"م",1,0],["سائلْ بذاك ابنَهُ الحرْ","رَ فهْو أدرى وأعلمْ",47,"م",1,0],["سائلا خالداً بأنباء أيري","وأبا يوسفٍ فقد مارساني",48,"ي",1,0],["سائِلاتٍ أَذا رَسولُ سَلامٍ","مِن بَني الأَرضِ أَم نَذيرُ فَناءِ",49,"ا",2,0],["سائِلِ الفَجرَ أَعِندَ الفَجرِ طين وَرُخامُ","وَاِسأَلِ القَصرَ أَلا يُخفيهِ كَالكوخِ الظَلام",50,"م",1,0],["سائِلوها أَو سَلو عَن حالِها","إِن جَهِلتُم كُلَّ طِفلٍ مُحُِلِ",51,"ل",1,0],["سائل بنى عصرك هل منهم","من لبس الإكليل بعد الكليل",52,"ل",1,0],["سائل عَليّا فَهُوَ ذُو علمٍ بِها","وَاِستَخبرِ الحسينَ تعلمِ النبا",53,"ا",1,0],["سائِلي عَلى حَقيقَةِ الناسِ عُذراً","لَيسَ فيهِم حَقيقَةٌ فَتُقالُ",54,"ل",1,0],["سائِلوا زَحلَةً عَن أَعراسِها","هَل مَشى الناعي عَلَيها فَمَحاها",55,"ا",3,0],["سائِل حِراءَ وَروحَ القُدسِ هَل عَلِما","مَصونَ سِرٍّ عَنِ الإِدراكِ مُنكَتِمِ",56,"م",1,0],["سائِلِ الشَعبَ عَنكَ وَالعَلَمَ الخَفّا","قَ أَو سائِلِ اللِواءَ الظَليلا",57,"ل",2,0],["سائَهُ الدَهرُ وَما زالَ يَسوء","ما عَلَيهِ لَو أَسا ما جَرَحا",58,"ح",2,0],["سائِغٌ لِذي سَغَبٍ","سائِغٌ وَلا سَغَبُ",59,"ب",1,0],["سائِلِ الدَهرَ مُذ عَرَفناهُ هَل يَع","رِفُ مِنّاً إِلّا الفَعالَ الحَميدا",60,"د",2,0],["سائِرٌ لَفظُهُ بِكُلِّ صَوابٍ","وَهُوَ في بَيتِهِ أَليفٌ قُعودِ",61,"د",1,0],["سائِل سُلَيماً بِهِ إِذ ماقَ جاهِلُها","حيناً فَأَدرَكَهُ مَكروهُ ما اِقتَرَفا",62,"ف",2,0],["سائِخٌ في الأَرضِ لا تَرفَعُهُ","خَصلَةٌ يَخثُرُ فيها أَو يَرِق",63,"ق",1,0],["سائِل بِهِ أَرضَ العِراقِ فَكَم لَهُ","فِعلاً أُقيمُ بِذِكرِهِ الإِسلامُ",64,"م",1,0],["سائِل بِأَيّامِهِ عَنهُ الأُلى اِجتَرَموا","ماذا بِهِم صَنَعَت عَواقِبُ الجَرَمِ",65,"م",1,0],["سائل به وائلاً فقد مَلَكَت","أُولى المعالي به وأُخراها",66,"ا",3,0],["سائلٌ من شِعابِ وَجْرَةَ ثاوٍ","بينَ أجزاعِها وبين البُراقِ",67,"ق",1,0],["سائِلْ بِصَوْل