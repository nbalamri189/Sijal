{"poems":[[68,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[82,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[46,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[139,"للعلم في عصر الضياء شروق","https://www.aldiwan.net/poem49040.html","الكامل"],[193,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[216,"عليوة إن الدمع أفشى وخبرا","https://www.aldiwan.net/poem37887.html","الطويل"],[236,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[308,"ركبت في البحر يوما مع أخي أدب","https://www.aldiwan.net/poem57815.html","البسيط"],[325,"شرحت صدر أخاكا","https://www.aldiwan.net/poem61652.html","المجتث"],[369,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[409,"قرت العين ببشرى","https://www.aldiwan.net/poem33920.html","مجزوء الرمل"],[409,"مرحبا يا مرحبا يا مرحبا","https://www.aldiwan.net/poem34127.html","الرمل"],[422,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[422,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[435,"لا وعينيك والجبين وجيدك","https://www.aldiwan.net/poem40281.html","الخفيف"],[443,"أيقطعنا في حبه من نواصله","https://www.aldiwan.net/poem2572.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138332",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138188",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138257",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138253",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87113","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86910","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86762","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67822","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67837","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105447","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120093","المديد"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96612","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121069","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64771","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112855","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67379","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87339","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83239","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65959","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93803","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115697","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74216","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74314","الخفيف"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106035","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82832","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89050","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85164","الرمل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32487","الهزج"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44632","البسيط"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141844","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93244","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97104","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72720","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72457","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52167","الرمل"],[4829,"وصيّة العلطبيس","https://www.poetsgate.com/ViewPoem.aspx?id=34264",""],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[4927,"السِّنْجَاْبُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=6966",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5102,"المجلس الملكي لشؤون الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=14096",""],[5183,"فتاة النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185689",""],[5273,"عانس","https://www.poetsgate.com/ViewPoem.aspx?id=180576",""],[5338,"أمة العرب قفي واستلهمي","https://www.poetsgate.com/ViewPoem.aspx?id=187618",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5652,"تعددت احوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=165350",""],[5975,"يا من ألوذ به","https://www.poetsgate.com/ViewPoem.aspx?id=52988",""],[6328,"عنتر والماسنجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""]],"verses":[["شَرَحَ الإِلَهُ الصَدرَ مِنكَ لِأَربَعٍ","فَرَأى المَلائِكَ حَولَكَ الإِخوانُ",0,"ن",1,0],["شرَحَ اللّه صَدرَها لي فأشْهَى","ما إليها إحصانُ جسمي وضمّي",1,"م",2,0],["شُرِحَت بِدَولَتِكَ الصُدورُ وَأَصبَحَت","خُشُعُ العُيونِ إِلَيكَ وَهيَ سَوامِ",2,"م",1,0],["شرحَ المَزَاول للمزُاول فانتهى","بكلامه التحبيرُ والتنسيقُ",3,"ق",1,0],["شرحَ الصدورَ فقُل بهِ وبشرحهِ","ما شئتَ في مدحِ النبيّ معظّما",4,"م",2,0],["شَرَحت فوقَ أحمرِ المتنِ سمرُ ال","خطّ حتّى بَدا وزال الخفاءُ",5,"ا",2,0],["شرحتُ لها الأخبارَ وهي تُجيبني","وأعصر من عيني مُوقاً ومحجرا",6,"ر",2,0],["شرح الملائك صدره في أربع","يا حبذا ما ضم منه المخيط",7,"ط",1,0],["شَرَحَ المَلائِكُ صَدرَهُ وَاِستَخرَجوا","مِنهُ نَصيبَ الدَّاحضِ الشَيطانِ",8,"ن",1,0],["شرحت يا بحر صدري اليوم قلت له","لا تنكر الشرح يا نحوي للنيل",9,"ل",1,0],["شَرَحتُ صَدرَ أَخاكا","وَما عُدَوتُ أَخاكا",10,"ك",2,1],["شَرَحْتَ صَدْريَ عنْد الصَّدْرِ في حُجَجٍ","أَوردْتَها لي ومَنْ يَسْمَعْ بها يَخَل",11,"ل",1,0],["شرحت أسطره مني","بما أهواه صدرا",12,"ر",2,0],["شرحت أسطره صدري فهل","هو بلقيس أتتنا من سبا",13,"ب",2,0],["شَرَحَتْ معنى معاليه لنا","فهيَ لا تخفى على غير البليد",14,"د",1,0],["شرح اللهُ صدْرَهُ فأرانا","في سَواد الخطوب بيض الأَيادي",15,"د",2,0],["شرح لام العذار رد على من","لام صباً مسلسلاً بقيودك",16,"ك",1,0],["شرحت من الإحسان صدري وظفّرت","يدايَ يودّ كنت دهري أحاوله",17,"ل",2,0],["شرح الصدور قدوم اكرم ماجد","بشمائل ومناقب موصوف",18,"ف",1,0],["شرح اقترار الثغر منك صدورنا","وجلا عن الأرواح هما فانجلى",19,"ل",2,0],["شرحت محامدك الصدور جميعها","وبذكرها تشدو الورى وتغرد",20,"د",1,0],["شرح الصدور بقربه من بعدما","كان الفؤاد مبلبلا في بعده",21,"د",2,0],["شرح اللَه صَدر علياه فيها","بِبُلوغ المُنى وَقَمع الغَريم",22,"م",1,0],["شَرح اللَه صَدر مَصر وَسادَت","عِندَ تَشريفه عَلى الأَمصار",23,"ر",1,0],["شَرح اللَه صَدرَه وَحَباه","في زَمان الهَنا بِعُمرٍ مَديد",24,"د",1,0],["شرح اللَه صَدره في بِلاد","دَفع الجور عَن بَنيها وَأَنصف",25,"ف",1,0],["شَرَحْتُ لَهُمْ مَا حَلَّ بي بَعْدَ فَقْدِهِمْ","جَرَى دَمْعُ وَاسْتَهَلَّ لِبُعْدِهِمْ",26,"م",1,0],["شَرَحْنَا لِمَنْ يَدْرِي الْكَلاَمَ وَيَفْهَمُ","مَفَاخِرَهُ وَالذَِكْرُ أعْلى وَأعْظَمُ",27,"م",1,0],["شرح اللَه صدره لعلوم","وبمعنى صفاته طال شرح",28,"ح",1,0],["شرَّح الله الصدور بمن","صدره في الجود منشرحُ",29,"ح",1,0],["شرحتُ له حالي وما قد لقيتهُ","غَداةَ بهِ للبين جدّت ركائبُه",30,"ب",2,0],["شرحتُ لوجدي في محبتكم صدرا","وقد صبرت نفسي فلم أستطع صَبرا",31,"ر",2,1],["شَرَحْتُ لِوَجْدي في مَحَبَّتِكُمْ صَدْرا","وصَبَّرَني صَحْبي فَلَمْ أَسْتَطِعْ صَبْرا",32,"ر",2,1],["شرح الصدور جميل لطفك سيدي","والستر منك به صلاح المفسد",33,"د",1,1],["شرح الغرام كما علمت طويلُ","قد أظمعتني النفس وهيَ أبيةٌ",34,"ه",1,0],["شِرَحَبِيلُ مَا لِلدّينِ فَارَقْتَ أمْرَنَا","وَلَكِنْ لِبُغْضِ الْمَالِكِيّ جَرِيرِ",35,"ر",1,1],["شرح الصدر منه فهو مصفى","قد تزكي من كل ذام وعاب",36,"ب",1,0],["شَرحنَا قياساتِ السهيلِ ورامِحٍ","ولم يَبقَ إلاّ أعزلٌ وَهو طالِع",37,"ع",1,0],["شَرحتُهُ يَا صَاحِبي وَالعُهدَه","على الذي رَوَاهُ لِي وَعَدَّه",38,"ه",1,0],["شَرَحتَ نُهى أَبيكَ وَسُرَّ قَلبي","وَقَرَّت فيكَ عَينُ الوالِداتِ",39,"ت",1,0],["شرحت مقالاً في الفرائض محكماً","دقيق المعاني مضمراً أي اضمار",40,"ر",1,1],["شرح الصدور قدوم أعدل وال","فادر مدام الأنس صاح ووال",41,"ل",1,1],["شرح غريب حسنه","مفصل ومجمل",42,"ل",1,0],["شَرح المَواقف الَّذي ما نسجا","حَقاً عَلى منهاجه من درجا",43,"ج",2,0],["شَرحته عِصابة وَتَلَتهُم","فتية بَينَ ناسخ وَمَحشي",44,"ش",2,0],["شرحت متون مصيبة أحزانها","بسطت كتاباً للسقام مطولا",45,"ل",2,0],["شَرحتُ شَكاتي لِلَّذي يُرتَجى لها","وَيا طالَما فاهَت بها أَلسُنٌ قَبلي",46,"ل",2,0],["شرحتْ صدورَ معيةٍ منظومةٍ","في ظل صدر المؤمنين جنودا",47,"د",2,0],["شرح الدمع على متن الخدود","ما ألاقيه من الظبى الشرود",48,"د",1,1],["شَرَحنا لَكَ أَخبارا","وَأَدمَجناكَ أَخبارا",49,"ر",2,0],["شَرحٌ يَطولُ وَلَكن مَوقِفي لَكُم","في الحال مَوقفُ تَرحيبٍ وَتَبجيلِ",50,"ل",1,0],["شرح البخاري الذي في سكله","نظمت علوم الشرع مثل بحار",51,"ر",1,0],["شرح الحديث به فكم من مشكل","فيه انجلى للعيْن بالآثار",51,"ر",1,0],["شرح المنبر صدرا","لتلقيك رحيبا",52,"ب",2,1],["شرحت حال ذوي التمييز منتظماً","فعاد شمل الهدى والدين منشرحا",53,"ح",2,0],["شرح لما في الصدور منه","بدا شفاء لنا شفاها",54,"ا",3,0],["شرحت تهذيبه فكنت له","يا عضد السعد ساعد العضد",55,"د",1,0],["شرح شرحت الصدور فيه كما","أزحت ما في القلوب من كمد",55,"د",1,0],["شرح لمتن السعد ألبس حلة","وبوشي تعليقاته حشاها",56,"ا",3,0],["شَرَح الدهرُ عليها","إن لِلشّرّ إلها",57,"ا",1,0],["شرحنا شرح حد الترح في قافن هزيجيّه","جهلها جاهل(ن) محدودة افكارة بالاسياجي",58,"ج",2,0],["شرحتُ بها صدر المعالي رقيقةً","حواشي معانيها البهية بالشرحِ",59,"ح",1,0],["شَرَحْتُ إِلَى السِّنْجَاْبِ فَحْوَىْ قَضِيَّتِيْ","فَمَاْ فَهِمَ السِّنْجَاْبُ قَوْلِيْ º وَ هَرْوَلاْ",60,"ل",2,1],["شَرْحُ الْمَحَبَّةِ بِالْحَوَاْشِيْ مُعْجِزٌ","فِيْهِ اخْتَبَرْتُ الْعَيْنَ º وَالْمِصْبَاْحَاْ",61,"ح",2,0],["شرحوا المخطّطَ أبرزوا أهدافَه","للعالم الممتد همْ سفراءُ",62,"ا",2,0],["شرحيه بنصال المقل","واطرحيه بين حمر الكلل",63,"ل",1,1],["شَرَحْتُ لها بآهاتي هُمومي","وكيفَ تَموتُ ساعاتي حَسَارى",64,"ر",2,0],["شرحوهُ ألفَ شرْحٍ وله","عَقَدَ القَوْمُ ألوفَ القِمَمِ",65,"م",1,0],["شرحت متون طغاتها",": باب الولوج إلى الضياع!!",66,"ع",1,0],["[ شَرَحْتُ لَها ما أَشْتَكِي فَتَضَرَّجَتْ","مَحاسِنُ مِنْها إِذْ بِماءِ الحَيا تَنْدِي ]",67,"د",2,0],["شرح الله صدرها فتجلت","شمس علم جلت فلول الظلام",68,"م",1,0],["شرحت علمٍ كود هالغير يعلمْ","من واقعٍ شفناه وانباج زيفه",69,"ف",2,0],["شرحتَ صدري لعشقي فيكَ من زمنٍ","وزدتَ فيكَ غرامي ثُمَّ تُشجيني",70,"ن",2,0],["شرحي يطولُ ولا أريدُ إطالة","وتقاسُ حرّياتُنا بالمسْطرة",71,"ر",2,0]]}