{"poems":[[55,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[54,"ما قليل منك لي بقليل","https://www.aldiwan.net/poem26750.html","المديد"],[119,"قل لشيخ يؤذي النبي عناداً","https://www.aldiwan.net/poem40846.html","عموديه"],[124,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[228,"كنت بالأمس ربة العاشقينا","https://www.aldiwan.net/poem41911.html","الخفيف"],[438,"دون بيض الخدور سمر العوالي","https://www.aldiwan.net/poem12694.html","الخفيف"],[6019,"غيابُ (هلالٍ)","https://www.poetsgate.com/ViewPoem.aspx?id=205482",""]],"verses":[["أَنتَ أَفسَدتَني عَلى كُلِّ مَأمو","لٍ وَأَعدَيتَني عَلى كُلِّ خَطبِ",0,"ب",1,0],["أنت أفلتَّ من حَبائِلِ قومٍ","ذُقْتَ منهم أذىً كثيراً وَظُلما",1,"م",2,0],["أَنتَ أَفسَدتَ الحَياةَ بِهَجرٍ","وَمَماتي بِحِسابٍ طَويلِ",2,"ل",1,0],["انت افرطت بالتمادي وللآ","ل خيول في ساحة الاحوال",3,"ل",1,0],["أنت أفسدتني وعلمتني ال","حب فهلا أصلحت مني هلا",4,"ل",2,0],["أَنتِ أَفسَدتِه وَكان غُلاماً","ثُمَّ صَيَّرتِهِ من الباذِرينا",5,"ن",2,0],["أنتَ أُفْقٌ للمَكْرُماتِ عليٌّ","لاحَ فيه محمّدٌ كالهِلالِ",6,"ل",1,0],["أنتَ افترشتَ الأَرضَ نُبلَ سَماحةٍ ،","فَامتَدَّ مِنْ عُمقِ الصَّلاحِ ظِلالُ",7,"ل",1,0]]}