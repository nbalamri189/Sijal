{"poems":[[55,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[47,"أبا سعيد وفي الأيام معتبر","https://www.aldiwan.net/poem63565.html","البسيط"],[46,"أبا سعيد تلاقت عندك النعم","https://www.aldiwan.net/poem30354.html","البسيط"],[46,"أبا سعيد وما وصفي بمتهم","https://www.aldiwan.net/poem30359.html","البسيط"],[107,"أبا سفيان أي دم تريد","https://www.aldiwan.net/poem43580.html","الوافر"],[107,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[69,"فداؤك من إذا رمت امتنانا","https://www.aldiwan.net/poem18139.html","الوافر"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49159","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140820",""],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[79,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[79,"أيغلبُ من عاداك والله غالبُه","https://www.poetsgate.com/ViewPoem.aspx?id=33204",""],[79,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[216,"أبا سيدي ما زلت بالدهر باقيا","https://www.aldiwan.net/poem37907.html","الطويل"],[305,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[310,"أبا سعيد وليس البعد عنك قلى","https://www.aldiwan.net/poem56484.html","السريع"],[411,"أخ تباعد عني شخصه ودنا","https://www.aldiwan.net/poem49716.html","البسيط"],[411,"أبا سليمانكم أوليت من حسن","https://www.aldiwan.net/poem49726.html","البسيط"],[447,"أبا ساحباً ذيل البطالة والصبا","https://www.aldiwan.net/poem14400.html","الطويل"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[469,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[470,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[500,"أبا سعد رويدك في مراسك","https://www.aldiwan.net/poem9886.html","الوافر"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145638","الوافر"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79553","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100951","البسيط"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69433","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53121","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53054","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28553","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28497","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60944","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132100","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59509","الطويل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32655","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135069","الطويل"],[4356,"","https://poetry.dctabudhabi.ae/diwan/poem/143365","الوافر"],[5183,"لفح الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180226",""],[5246,"أبا سليمان يا من في الفؤاد له","https://www.poetsgate.com/ViewPoem.aspx?id=187051",""],[5320,"هما فى النار مقتول وقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=40899",""],[5402,"أبا سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=215515",""],[5526,"معاني كلمة أصحاب","https://www.poetsgate.com/ViewPoem.aspx?id=199059",""],[5596,"ابوسرور فقيد الفقه والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206773",""],[5695,"لولا الحب....","https://www.poetsgate.com/ViewPoem.aspx?id=212443",""],[402,"كانت عيون الريب الساهرة","https://www.poetsgate.com/ViewPoem.aspx?id=36585",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[469,"أجنها الفكر وأبداها العبق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574814",""],[6173,"برقيةُ دمعٍ إلى أبي سلمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86799&r=&rc=13",""]],"verses":[["أَبا سَعدٍ دُعاءٌ لَو تَراخَت","أَوائِلُهُ لَعاقَبَها لِساني",0,"ن",2,0],["أبا سالِمٍ دين الإلاهِ بكَ اعْتَلى","أبا سالِمٍ ظِلُّ الأمانِ بكَ امْتَدّا",1,"د",2,0],["أَبا سَعيدٍ وَفي الأَيّامِ مُعتَبَرُ","وَالدَهرُ في حالَتَيهِ الصَفوُ وَالكَدَرُ",2,"ر",1,1],["أَبا سَعيدٍ تَلاقَت عِندَكَ النِعَمُ","فَأَنتَ طَودٌ لَنا مُنجٍ وَمُعتَصَمُ",3,"م",1,1],["أَبا سَعيدٍ وَما وَصفي بِمُتَّهَمٍ","عَلى الثَناءِ وَلا شُكري بِمُختَرَمِ",4,"م",1,1],["أبا سُفيانَ أيَّ دَمٍ تُرِيدُ","هِيَ العنقاءُ مَطلبُها بَعِيدُ",5,"د",1,1],["أبا سُفيانَ ذلك ما تراهُ","هو البأسُ المصمِّمُ لا سِواهُ",6,"ه",1,0],["أبا سُفيانَ دّعْ صفوانَ يبكي","وعكرمةً يُطيل من التشكّي",7,"ي",1,0],["أبا سُفيانَ لا يقتلْكَ همَّا","ولا يذهبْ بحلمكَ أن تُذَمّا",7,"م",2,0],["أبَاسِطُهُ وَأَحْذَرُهُ كَأَنِّي","أُمَارِسُ مِنْ خَلاَئِقِهِ السِّباعا",8,"ع",2,0],["أبا سُفيانَ ليس لكم ذِمامُ","كتمتَ الحقَّ تطمعُ في المحالِ",9,"ل",1,0],["أبا سُفيانَ هل أبصرتَ نارا","كنارِ القومِ إذ باتوا سُهارى",9,"ر",2,0],["أبا سعيدٍ جنب العتابا","فرب راءٍ خطأً صوابا",10,"ب",2,1],["أَبَأسُكَ قارَضَت فيهِ اللَيالي","فَهَلّا أَحسَنت فيهِ القِراضا",11,"ض",2,0],["أَبَا سَالِمٍ دِينُ الإلاَهِ بِكَ اعْتَلَى","وَأُيِّدَ رُكْنٌ مِنْهُ وَاعْتَزَّ جَانِبُهْ",12,"ب",2,0],["أبا سالم دينُ الإله بك اعتَلى","وأيَّد ركنٌ منه واعتزَّ جانبُه",13,"ب",2,0],["أبا سالم دين الإله بك اعتلى","أبا سالم ظل الأمان بك امتدا",14,"د",2,0],["أبا سيدي ما زلتَ بالدهرِ باقياً","وما لكَ في العَلْياءِ ثانٍ وثالث",15,"ث",1,1],["أَبا سالِمٍ إِن كُنتَ وُلّيتَ ما تَرى","فَأَسجِح فَقَد لا قَيتَ سَكناً بِأَبهَرا",16,"ر",2,0],["أَبا سعيدٍ وليسَ البعد عنكَ قلىً","ريبُ الزمانِ رقيبٌ ليس يندفعُ",17,"ع",1,1],["أبا سُليمانَ سِرْ إنْ شئتَ أو فأقِمْ","بحيث شِئتَ دَنا مَثواكِ أمْ شَطَنا",18,"ن",2,0],["أبا سُليمانَكم أولَيْتَ من حَسَنٍ","وكْم جَزَيْتَ وكم واليْتَ من مِنَنِ",19,"ن",1,1],["أَبا ساحباً ذيل البطالة والصبا","معاب على أمثالك اليوم لآن صبا",20,"ب",2,1],["أبا سعدٍ قدحتُ بمصلِداتٍ","فلما فُضَّ زندُك لي وراها",21,"ا",3,0],["أبا سعدٍ ولو عثروا بعيبٍ","مشوا فيه بحقٍّ أو تعدّي",22,"د",2,0],["أباسمٌ بالغور أم برقٌ حفا","أم صارمٌ جرّد أم سهمٌ مرقْ",23,"ق",1,0],["أبا سِنان ٍ ، أراني مُوقِظا ً وَجَعي","وَما ليَ الآنَ في إيقاظِهِ أرَبُ",24,"ب",1,0],["أبا سعد رُوَيْدَك في مراسكْ","ولا تبرز بكيدك لي وباسكْ",25,"ك",1,1],["أَبِاسْمِ العَدْلِ نُشْعِلُها حُرُوبًا؟","وَبِاسْمِ العَدْلِ تَنْفَجِرُ المَآقِي؟",26,"ق",2,0],["أبا سليمانَ سِرْ في الأرضِ فأَقِمْ","فأنتَ عندي دَنَا مثواكَ أو شطَنَا",27,"ن",2,1],["أبا سليمان أدميت القلوبَ بما","لم يأت قبلك عَمٌّ صالح وأب",28,"ب",1,0],["ابا سعيد فاني جئت منتجعا","أرجو نوالك لما مَسَّني الضرر",29,"ر",1,0],["أَبا سَلامَةَ عِش وَاسلَم حَلِيفَ عُلاً","وَسُؤددٍ بِشُعاعِ النَجمِ مَقرُونِ",30,"ن",1,0],["أبا سعيد معمل البيض إذا","أحجم كلُّ باسل مشمر",31,"ر",1,0],["أبا سعيد رعاك الله أيّ فتىً","إن غاب عني فحمدي عنه لم يغبِ",32,"ب",1,0],["أَبا سابِقٍ لِلّه فيكَ سَريرَة","قَضَت بِقَريبِ النَّصرِ مِنهُ سَريعِهِ",33,"ع",2,0],["أَبا سابِقٍ ما أَنزَلَ اللَّهُ نَصرَهُ","عَلى فِئَةٍ إِلَّا وَأَنتَ لَها رَدُّ",34,"د",1,0],["أبا سَعدُ أنتم وسَط همدان غرة","وراسٌ وإن حلت بكل مكان",35,"ن",1,0],["أبا سليمان ما للمجد منتدباً","يشجي القلوب بصوت في بكاه أغَنّ",36,"ن",1,0],["أبا سليمان لما إن أمرت سرى","داءان بي سقم الأحشاء والسأم",37,"م",1,0],["أبا سنَدٍ قرمَ الملوكِ ابن زاملٍ","ومن يتَّقيه في المكَرّ المصادمُ",38,"م",1,0],["أَبا سَعيدٍ لَنا في شاتِكَ العِبَرُ","جاءَت وَما إِن لَها بَولٌ وَلا بَعَرُ",39,"ر",1,1],["أبا سالم فيكم لقد سدت في الورى","وحزت معال دونها وقع الفخر",40,"ر",1,0],["أبا سَهلٍ حجابُك طالَ حتى","تَبيَّن منه في العليا قُصورُكْ",41,"ك",1,1],["أبا سرور أتاني في صحائفه","كالمسك عتبك يزكو في غواليه",42,"ي",2,0],["أبا سليمان يا من في الفؤاد له","أزكى المحبة تقديري لكم أهب",43,"ب",1,1],["أباسم الدين والأوطان بطشا","يتامى شردوا وبكت أرامل",44,"ل",1,0],["أبا سليمان ماذا ينفع الامل","أخوك قد اسرفت في جسمه العلل",45,"ل",1,1],["‫ابَ أسألك عن شي تفصيل واعراب‬","خابرك راع ِ شور ، مع طالب الشور",46,"ر",1,1],["اب َأسألك ياصاح عن كلمة أصحاب","وش هي معانيها وسط عتمة النور ؟",46,"ر",1,0],["أباسرور وقد قدمت محتسبا","لله مكتسبا فاهنأ بمغتنم",47,"م",1,0],["أَبِاسم الدّينِ تُزهق كلّ روح","وبِاسمِ الدّين تُنتهكُ الذِّمامُ",48,"م",1,0],["أبأس ما سارت بأطمارها","لمتك إلا بهجة سائرة",49,"ر",2,0],["أبا سعيد لك البشرى مصفقة","إليك رائحها مني وغاديها",50,"ي",3,0],["أباسمٌ بالغور أو برقٌ حفا","أم صارمٌ جُرِّد أم سهمٌ مرقْ",51,"ق",1,0],["أبا سلمى شراييني سرابٌ","وقلبي بيتُ عنقاءِ السرابِ",52,"ب",1,0]]}