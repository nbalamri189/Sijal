{"poems":[[47,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[47,"عش حميدا في ظل عيش حميد","https://www.aldiwan.net/poem63491.html","الطويل"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[89,"عرف الهوى في نظرتي فنهاني","https://www.aldiwan.net/poem8212.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[47,"يا أخَا الأزْدِ ما حَفِظتَ الإخَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=32957",""],[47,"عش حميداً في ظل عيش حميد","https://www.poetsgate.com/ViewPoem.aspx?id=31607",""],[228,"تذكري حين يزف الضحى","https://www.aldiwan.net/poem41618.html","السريع"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16711","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27221","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126968","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105147","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4987,"ماهى اول غلا","https://www.poetsgate.com/ViewPoem.aspx?id=49570",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5525,"الخل العنيد","https://www.poetsgate.com/ViewPoem.aspx?id=872",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""]],"verses":[["يَومَ فَرَّقتَ مِن كَتائِبِ آرا","ئِكَ جُنداً لا يَأخُذونَ عَطاءَ",0,"ا",2,0],["يَومُ فِطرِ الأَيّامِ مِثلُكَ في آلِ","م حُمَيدٍ وَآلِ عَبدِ الحَميدِ",1,"د",1,0],["يَومَ فَتحٍ سَقى أُسودَ الضَواحي","كُثَبَ المَوتِ رائِباً وَحَليبا",2,"ب",2,0],["يَوْمٌ فَقَدْتُ الْحِلْمَ فِيهِ وَشَفَّنِي","وَلَهٌ أَصَابَ جَوَانِحِي فَرَمَانِي",3,"ن",2,0],["يومَ في الحكومة لم","يفعَلوا كما يجب",4,"ب",1,0],["يَوْمُ فَخْرٍ شَهِدْتُمُوهُ فَمَا غَا","بَ بِهِ نِيلُهَا وَلا الأَهْرَامُ",5,"م",1,0],["يَوْمَ فارُوقَ دُمْ عَلَى صَفْحَةِ الدَّهْرِ","حَفِيلاً بِالْبُشْرَيَاتِ مَجِيدا",6,"د",2,0],["يَوْمَ فَرّقْتَ مِنْ كَتائِبِ آرَاك","كَ جُنْداً لا يأخُذونَ عَطَاءَ",7,"ا",2,0],["يوم فطر الأيام مثلك في آل","حميد وآل عبد الحميد",8,"د",1,0],["يَومَ فُؤادي مُثقَلاً بِالأَسى","ينامُ في حفرِتِه البارِدَه",9,"ه",1,0],["يَومَ فيكُم ذلَّةٌ عَن عِزَّةٍ","وَلَنا مِنكُم سِباءٌ وَإِسارُ",10,"ر",1,0],["يوم فيه صِبْغُ الدعاوي يحول","نحن قومٌ مقامنا بالعلى خُصّْ",11,"ص",1,0],["يَومَ فاتَت بِهِ بَوادِرَ شُؤمٍ","فَرُزينا بِهِ الثَرى وَالثَراءَ",12,"ا",2,0],["يومُ فصلٍ تبلى السرائرُ فيه","حائراتٌ من هولِهِ هَلعاء",13,"ا",2,0],["يومَ فقري ويوم حشري لربي","وبه همتي ومنه اهتمامي",14,"م",2,0],["يَومَ فبراير عد اليوم ذِكرى","ربّ ذِكرى أَهاجَتِ الأَحزانا",15,"ن",2,0],["يومَ فارقُتهُ فما اعتَضْتُ منه","سَكناً يجمع الهوى ومَحَلاّ",16,"ل",2,0],["يوم في الترب لقى خر الحسين","ترب الخد قطيع الودجين",17,"ن",1,0],["يَومَ فضحٍ قَد اشرَقَت وَجنَة مِن","مَكَّةٍ وافتَرَّت كُدًى وكَدَاءُ",18,"ا",2,0],["يَومَ في شُوراهُ آلى أَنَّهُ","يُحرِقُ الأَشراعَ وَالقَومَ يُبيد",19,"د",1,0],["يَومَ في الخِفيَةِ عَن أُمٍّ وَأب","عَلِقا حُبّاً وَفازا بالأَرب",19,"ب",1,0],["يوم فيه قد غال بدر المعالي","الخسف والشمس سامها التكوير",20,"ر",1,0],["يوم في عثير الضلال أمي","عثرت أي عثرةٍ لا تقال",21,"ل",1,0],["يوم فلّت على الخصر النحيل الجدايل","وإستدارت خجل مدرى تصنّع غرام",22,"م",1,0],["يَوْمَ فَاقَتْ فِي الْحَنَايَا","شُعْلَةُ الأَنْوَارِ فِكْرَا",23,"ر",2,0],["يوم فاع اركى جناحه على قاسي الحديد","وانكسر ريش النداوي ولا الله وفقه",24,"ق",2,0],["يوم فكرّت بأمر القاف وجيت أحسمه","قال لو فيه خيره ، كان غيرك غلب",25,"ب",1,0]]}