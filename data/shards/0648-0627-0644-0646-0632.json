{"poems":[[48,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[556,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109802","الكامل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105566","الطويل"],[5302,"الفؤاد الذي عانى","https://www.poetsgate.com/ViewPoem.aspx?id=200943",""]],"verses":[["وَالنَزعُ فَوقَ فِراشٍ","أَشَقُّ مِن أَلفَ ضَربَه",0,"ب",2,0],["وَالنَزرُ يَكفيني مَعَ الكَرَمِ الَّذي","أَحيا نِزاراً في دُناها وَالقَصا",1,"ص",2,0],["وآلُ نِزارٍ زَعْزَعتْ من عروشهمْ","بأيدي الرَّزايا السّود هوجاءُ زَعْزعُ",2,"ع",1,0],["والنزار اليوم مذ ضاعت فشا","كلُّ ضعف في ريامٍ واطّردْ",3,"د",1,0],["والنزع يجذب نفسها من صدرها","فترده عنها الغضاضة والصبى",4,"ا",1,0],["وآل نزارٍ حطمي البيض والقنا","وقري صغاراً خر من بينك البدر",5,"ر",1,0],["والنزف أبقاه منطويا","والشعر يحييه أحيانا",6,"ن",2,0]]}