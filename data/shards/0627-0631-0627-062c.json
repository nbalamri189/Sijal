{"poems":[[57,"هجرت الندامى خشية السكر إنما","https://www.aldiwan.net/poem26345.html","الطويل"],[36,"سأصرم لبنى هبل وصلك مجملا","https://www.aldiwan.net/poem4906.html","الطويل"],[95,"أراجع نفسي هل أنا ذلك الذي","https://www.aldiwan.net/poem11266.html","الطويل"],[32,"أمن دمنة بالجو جو جلاجل","https://www.aldiwan.net/poem29571.html","الطويل"],[49,"وراءك يانمير فلا أمام","https://www.aldiwan.net/poem25152.html","الوافر"],[47,"أراجعة سعدى علي هجودي","https://www.aldiwan.net/poem63518.html","الطويل"],[47,"أما اشتقت يا إنسان حين هجرتني","https://www.aldiwan.net/poem64523.html","الطويل"],[47,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[47,"غرام ما أتيح من الغرام","https://www.aldiwan.net/poem65678.html","الوافر"],[52,"يا ليت لي قلبا بقلب يثيب","https://www.aldiwan.net/poem64808.html","الوافر"],[52,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[47,"أما اشتقت يا إنسان حين هجرتني","https://www.poetsgate.com/ViewPoem.aspx?id=31208",""],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[215,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[463,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[463,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[471,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem50386.html","الطويل"],[520,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65049","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132856","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53183","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106904","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100260","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132742","الوافر"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105623","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28734","الطويل"],[4729,"أَرَاجِعٌ لي عَيشي الفَارِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=109457",""],[5220,"تحياتي لمن دمر حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=25568",""],[520,"أراجعة لي عيشة الزمن النضر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577522",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""],[6302,"هنيئاً للشَّمالِ .. هُناك عيدُ!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86213&r=&rc=11",""],[6320,"نَزِيفُ القَهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84335&r=&rc=32",""]],"verses":[["أَراجِعَةٌ تِلكَ اللَيالي كَعَهدِنا","بِهِنَّ وَمِصبَاحُ المَوَدَّةِ يَزهَرُ",0,"ر",1,0],["أَراجِعَةٌ يا لُبنُ أَيّامُنا الأُلى","بِذي الطَلحِ أَم لا ما لَهُنَّ رُجوعُ",1,"ع",1,0],["أُرَاجِعُ نَفْسِي هَلْ أَنَا ذَلِكَ الَّذِي","عَهِدْتُ بِأَمْسِي أَمْ أَنَا رَجُلٌ ثَانِ",2,"ن",1,1],["أَراجِعَةٌ يا مَيُّ أَيّامُنا الَّتي","بِذي الرِمثِ أَم لا ما لَهُنَّ رُجوعُ",3,"ع",1,0],["أَراجِيَةً خُوَيلَفَةً ذِماماً","وَراءَكِ لا أَمانَ وَلا ذِمامُ",4,"م",1,0],["أَراجِعَةٌ سُعدى عَلَيَّ هُجودي","وَمُبدِلَتي مِن أَنحُسٍ بِسُعودِ",5,"د",1,1],["أَراجِعَةٌ أَيّامُنا مِثلَ عَهدِها","وَأَنتَ عَلَيها إِن أَرَدتَ قَديرُ",6,"ر",1,0],["أَراجِعٌ مِن شَبابي قَيضُ مُبتَذَلٍ","أَنفَقتُهُ في لُباناتِ الهَوى سَرَفا",7,"ف",2,0],["أَراجِعَتي يَداكَ بِأَعوَجِيٍّ","كَقَدحِ النَبعِ في الريشِ اللُؤامِ",8,"م",1,0],["أَراجِعٌ أَنتَ لَنا مَجلِساً","بَينَ مُدامٍ وَسَماعِ مُنيب",9,"ب",1,0],["أَراجِعٌ لي بَعضُ ما قَد مَضى","بِالمَيثِ أَم هِجرانُها واجِبُ",10,"ب",1,0],["أراجعة أيامنا مثل عهدها","ونت عليها، إن أدرت، قدير",11,"ر",1,0],["أَراجِعٌ لي الدَهرُ حَولاً كامِلاً","إِلى الَّذي عَوَّدَ أَم لا يُرتَجى",12,"ا",1,0],["أراجع أحلامي فأنسى عهودها","إلى بهرة النسيان سهمى يفوّق",13,"ق",1,0],["أراجعُ نفسي أيُّ ذنب رمى بها","إلى السخط منكم والظنونُ تُرَجِّمُ",14,"م",1,0],["أراجعٌ لي والمُنَى هَلْهَلَةٌ","فطالعٌ نجمُ زمانٍ غَرَبا",15,"ب",2,0],["أراجعٌ لي بضمانِ المنَى","ملحوبُ أو ما ضمّ ملحوبُ",16,"ب",1,0],["أَراجِعَةٌ قَلبي عَلَيَّ فَرائِحٌ","مَعَ الرَكبِ لَم يُكتَب عَلَيكِ قَتيلُ",17,"ل",1,0],["أراجعة لي عيشة الزمن النضر","وعيش تقضى في كنانة والنظر",18,"ر",1,1],["أُراجِعُهُ مَحْضَ الْفَوائِدِ جاهِداً","فَأَقْبِسهُ طَوراً ولي مِنهُ قابِسُ",19,"س",1,0],["أراجعةٌ تلك الليالي كعهدها","إلى الوصلِ أم لا يُرتجى لي رجوعُها",20,"ع",3,1],["أراجَعتْ مَلالَها","فأْبدَتِ اعْتِلالَها",21,"ه",2,0],["أراجعة لي فيك وهي تَعِلَّة","غُدَيَّات ليلات تقضت وآصال",22,"ل",1,0],["أَراجعةٌ في الزمان أماني","الحياة ومدنية ما نأى",23,"ا",1,0],["أراجعةٌ أيّام لهويَ والهوى","باغلمةٍ مُردٍ وملمومةٍ جُردِ",24,"د",1,0],["اراجعة لنا أيام وصل","زهت زهو الربى غب الغمام",25,"م",1,0],["أراجي الود من قلب الغواني","رجوت الآل أخطاك القطار",26,"ر",1,0],["أُراجِعُ سُلواناً وَإِنِّي لَخائِفٌ","فَإِن حَقَّ خَوفي فَالثَّمانونَ مَوعِدي",27,"د",2,0],["أَرَاجِعٌ لي عَيشي الفَارِطُ","أَم هو عَني نَازِحٌ شاحِطُ",28,"ط",1,1],["اراجع دفتر الذكرى واقلب","مع الاوراق ماضي ذكراتي",29,"ت",2,0],["أراجعةٌ لي عيشة الزمن النضر","وعيشٌ تقضى في كنانة والنضر",30,"ر",1,1],["أراجع طيف آمالي","عظيم النهج والشان",31,"ن",1,0],["أُراجع \"سيرتي\" هلْ كنتُ إلاَّ ...","جَنَىً زكَّاهُ سعيُكما الحميدُ ..",32,"د",1,0],["أَرَاجِيفُ الدُّجَى حَتْماً سَتَفْنَى","وَيَبْقَى الصُّبْحُ يَجْتَاحُ الظَّلاَمَا",33,"م",2,0]]}