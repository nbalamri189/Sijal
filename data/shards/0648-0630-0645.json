{"poems":[[39,"وإنا لذوادون عن حرماتنا","https://www.aldiwan.net/poem7682.html","الطويل"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[53,"أيها السيد الذي فاق في الجود","https://www.aldiwan.net/poem66076.html","الخفيف"],[93,"وسائلة أي المذاهب مذهبي","https://www.aldiwan.net/poem62662.html","عموديه"],[47,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[51,"إذا قل مال المرء قل صديقه","https://www.aldiwan.net/poem62193.html","الطويل"],[82,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[46,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[48,"إياك والأيمان تلقي بها","https://www.aldiwan.net/poem22636.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[92,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[119,"لا تلم يا مهذب الانذالا","https://www.aldiwan.net/poem40617.html","عموديه"],[136,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[186,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[190,"جمل ما لشرحها تفصيل","https://www.aldiwan.net/poem43460.html","الطويل"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[266,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[280,"بشراي هذا مبدأ الإقبال","https://www.aldiwan.net/poem25535.html","الكامل"],[353,"ولرب ذي لؤم غلطت بقصده","https://www.aldiwan.net/poem19875.html","الكامل"],[396,"جزى الله المصائب كل خير","https://www.aldiwan.net/poem54603.html","عموديه"],[415,"صديق لي تنكر بعد ود","https://www.aldiwan.net/poem32045.html","الوافر"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[463,"عذيري من باغ علي أحبه","https://www.aldiwan.net/poem56307.html","الطويل"],[469,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[498,"حفظت منك بما لم يجر في خلدي","https://www.aldiwan.net/poem67296.html","عموديه"],[520,"شكا ألم التوديع وهو أليم","https://www.aldiwan.net/poem12252.html","الطويل"],[556,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[556,"لو انك عرجت في منزل","https://www.aldiwan.net/poem48112.html","المتقارب"],[558,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34400","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48505","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59535","الطويل"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178054","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16830","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64762","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64896","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31498","الوافر"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116538","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46438","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110255","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58440","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100512","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123929","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92039","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101374","البسيط"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67620","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66103","البسيط"],[4750,"الطيب","https://www.poetsgate.com/ViewPoem.aspx?id=180398",""],[4935,"شرف الرجال فضائل العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=129366",""],[5183,"ألف أهلا","https://www.poetsgate.com/ViewPoem.aspx?id=185692",""],[186,"عرجا في ربوعها وسلاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55810&r=&rc=73",""]],"verses":[["وذمّتنا محفوظة برماحنا","إذا ما أضاع الذمّة المتحفّرُ",0,"ر",1,0],["وذمُّ الناس مجلوبٌ رخيصٌ","لأيسرِ علَّةٍ والحمدُ غالي",1,"ل",2,0],["وذِمامي كما علمتَ وقدْ قدْ","دَمْتُ وعداً في عقده استحكامُ",2,"م",1,0],["وَذَمَّ إِلَيَّ الرِقَّ ثُمَّ اُِستَرَقَّني","وَصَوَّرَ ظُلماً فيهِ تَمجيدُهُ عَدلا",3,"ل",2,0],["وَذِمَّةٍ بِكَ لَم يُشبِه تَأَكُّدُها","إِلّا وَفاؤُكَ لِلأَقوامِ بِالذِمَمِ",4,"م",1,0],["وَذَمَّ إِلَيهِ خِدنُهُ طَعمَ عودِهِ","وَقَد كانَ يَستَحليهِ حينَ يَذوقُهُ",5,"ق",2,0],["وَذَمَاءُ الليلِ على طَرْفٍ","كترحّلِ روحٍ عن جَسَدِ",6,"د",1,0],["وَذَمَلتُ في الأَيّامِ حَتّى أَسحَتَت","شَطَّي سَنَامي وَاِنتَحَت في غارِبي",7,"ب",2,0],["وَذِمَّةُ المُؤمِنِ مَخفورَةٌ","بِالدينِ لا تَدنو لَها مُخفِرَه",8,"ر",2,0],["وَذمتُ أُناساً لَو حَلمتُ لِجَهلِهِم","رَبِحتُ وَنَقَّفتُ الَّذي لَم أنقّفِ",9,"ف",1,0],["وذمُّوا أنَّهم كانوا عُكوفاً","عليهِ في الغُدُوِّ وفي الرواح",10,"ح",1,0],["وذميم الاصول عز لذل","قام في نوعه فقال وصالا",11,"ل",2,0],["وذم الصالحين فهم جميعا","له خُصَصا إذا وقع الخِصام",12,"م",1,0],["وَذَّمَّ أبَّاهَ عَالِمَ كُلِّ فَنٍّ","كريم النفس إِن ذكر الكرام",12,"م",1,0],["وذم الشيخ عبدَالله مَن عَن","مراتبه تقاصرتِ الأنام",12,"م",1,0],["وذم الشيخ أحمدَ وهو قطب","من أرباب الندى ملك همام",12,"م",1,0],["وَذِمامٌ كَأَنَّهُ الصَخرَةُ الصَّم","ماءُ لاقَت مِن الخُطوبِ مياها",13,"ا",3,0],["وذممنا زماننا وهو خصبٌ","فأتى بعده زمان مهول",14,"ل",1,0],["وَذِمَّةً مِنهُ لَو أُذِمَّ بِها","لِذي شَبابٍ ما ريعَ بِالهَرَمِ",15,"م",1,0],["وذممت للقلب الهلاك ولا أرى","بدم المحب على الهوى من يدعي",16,"ع",2,0],["وَذَمَمْتُ تَرْحَالاً وَحِلاً قَبْلَها","فَحَمِدْتُ عُقْبَى الحِلِّ والتَّرْحالِ",17,"ل",1,0],["وَذَممْتُ عَنّي فِعْلهُ وَشَكَرْتُهُ","لَمَّا رَجَعْتُ على يَدَيْهِ تَائِبا",18,"ب",2,0],["وذم وافر وذهاب أجر","فلا يرضى بذا غير الشقاة",19,"ه",1,0],["وذَمّ اليومَ ما حَمدتْه منّي","تجارِبُه وأمس بِه شهيدُ",20,"د",1,0],["وذمّةٌ مرعيّةٌ أسندَها","إلى حفاظ غالبٍ نزارُها",21,"ر",3,0],["وذَمّاً ولو ما جاء غيرُك خاطباً","جزاءً به مني لقد سَهُلَ الخطبُ",22,"ب",1,0],["وذمَّ أناس ثقل ما أنا حامل","وما علموا أنَّ الضلوع لهُ قبر",23,"ر",1,0],["وذمة الدهر معتصماً","بما تلقيته فرداً بلا مدد",24,"د",1,0],["وذم حميد العيش من بعد راحل","صحيح الأماني أو يعود سقيم",25,"م",1,0],["وذمّ رجالٌ أنّني غيرُ مُعْجَبٍ","فيا عَجَباً ماذا يفيدهُمُ عُجْبي",26,"ب",2,0],["وَذَمُّ الفَتى مِثلُ مَدحِ الفَتى","لأشكالِهِ وَلأكفائِهِ",27,"ا",3,0],["وَذَمَّ كَمِيُّ وَاِستُفِزَّ مُبارِزٌ","وَأُرهِبَ مَرهوبٌ وَخاطَرَ مُقدِمُ",28,"م",1,0],["وَذمام لِجاره وَاِحتِفال","بِغَريب لَم يَنصرف عَن قُراه",29,"ا",2,0],["وَذَمَمتُ مَن يَهوى جَفاءَ محبّهِ","وَسَلَكتُ مَدحاً في النَبيِّ حَميدا",30,"د",2,0],["وذمامه ومرامه وجهاده","وجلاله وبنيه بل نجبائه",31,"ا",3,0],["وذمَّ ذِماماً طالما قد رعيتهُ","وطالبه مَن كان يرجو طِلابه",32,"ب",2,0],["وذمة من يزيدٍ حال جانبها","دوني فأنجيت عفواً غير مجهود",33,"د",1,0],["وَذُمَّ دَهراً يُفيضُ أَنعُمَهُ","عَلى اللَئيمِ المُذَمَّمِ الوَغدِ",34,"د",1,0],["وَذَمَمْتَها واللهُ يَعْلَمُ أَنَّها","لَكَ خُلَّةٌ وَكَفى بِهِ مِنْ شاهِدِ",35,"د",1,0],["وذِمْرٌ هو الضِّرغامُ يَزْأَرُ في الوَغَى","فيَخْرَسُ مِنْ بَعْدِ الهَديرِ فنيقُها",36,"ق",3,0],["وذمة جوارُها لا يُخْفَرُ","ونعمة آثارها لا تكفَرُ",37,"ر",1,0],["وَذِمَّتُهُ إِذا قَحَمَت جُمادى","وَعاقَبَ نَوءَها خَصَرٌ شَديدُ",38,"د",1,0],["وذمام قومي يلا رجعتُ ولا الكرى","يوماً إِلى أجفان عينيك راجعُ",39,"ع",1,0],["وَذَمَمتني مِن غَيرِ ذَنبٍ جئته","فَأَفدتَ أَن غَيَرت ماءَ صَفائي",40,"ا",2,0],["وذِمارُ ليلى لم يكن كذِمارِ فا","تنتي تحفُّ به أسودُ الغاب",41,"ب",1,0],["وَذَمَمْتَ النُّجومَ والفقْة والطِّبَّ","وخالفتَ مَن لهُ المعقولُ",42,"ل",1,0],["وذمة لرعاة الحق ما رعيت","وحرمة لرسول اللَه لم تصن",43,"ن",1,0],["وذمة عندي لدهر سلمت","أو لو النهى من شفرات حده",44,"د",2,0],["وَذُمَّ زَمانٌ ما وفي بدوامه","وَلا ذُمَّ عيشٌ مرَّ إذ نحن جُمَّع",45,"ع",1,0],["وذُمِيذا مِن لَسبُسٍ بِنتُ فُريا","سَ تَلِيهِ في مَرقَدٍ شِيدَ خِدرا",46,"ر",2,0],["وذم كل فرار من مبارزة","إلا فرارك من غي إلى رشد",47,"د",1,0],["وذممنا العبيدَ حتى إذا نح","ن بَلونا الموَلَى عَذَرنا العبيدا",48,"د",2,0],["وذِمَّةِ الْعُرْبِ والايامُ شاهِدَةٌ","لَنُضْرِ مَنَّ الوَغَى في السَّهْلِ والظَّلَمِ",49,"م",1,0],["وذمةٍ ماهيب تندان للحق المصيب","جعل قشاش الحطب لاسَرح يقتشها",50,"ش",3,0],["وذممت كل شريف أصل طاهر","يسمو بعرفان على الأقران",51,"ن",1,0],["وذمام القلب في حج","رك فاقبله وليا",52,"ي",2,0],["وذمام كأنه الصخرة الصماء","لاقت من الخطوب مياها",53,"ا",3,0]]}