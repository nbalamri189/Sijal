ل"],[46,"تزوج إن أردت فتاة صدق","https://www.aldiwan.net/poem22690.html","الوافر"],[46,"تزوجتها وهي فيما تظن","https://www.aldiwan.net/poem22873.html","المتقارب"],[46,"تزوج بعد واحدة ثلاثا","https://www.aldiwan.net/poem22963.html","الوافر"],[46,"أشهد أني رجل ناقص","https://www.aldiwan.net/poem23271.html","السريع"],[19,"خُذلت على ليلة ساهره","https://www.aldiwan.net/poem338.html",""],[15,"لمن دمنة أقوت بحرة ضرغد","https://www.aldiwan.net/poem45272.html","الطويل"],[76,"كم ألحم السيف في أبناء ملحمة","https://www.aldiwan.net/poem39314.html","البسيط"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85576","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21094","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/199525","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5204","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54206","الطويل"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[50,"أذكرت نفسي عشية الأحدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21801",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"النشيد الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=178973",""],[90,"فطار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178939",""],[45,"تَزَوّجْتَها، بَعدَ إحْرَاقِها","https://www.poetsgate.com/ViewPoem.aspx?id=32171",""],[80,"شموسٌ دعاهنّ وشكُ الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=3318",""],[80,"لم نؤت ليلتنا الغرّاء من قِصَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3221",""],[28,"إليك سبقت ابني فزارة بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=21003",""],[51,"إذا أحدقوا بي في المَكرِّ حجزتهم","https://www.poetsgate.com/ViewPoem.aspx?id=30009",""],[51,"يا أيُّها المعتضِدُ المعضودُ","https://www.poetsgate.com/ViewPoem.aspx?id=28493",""],[51,"أكلتُ رغيفاً عند عيسى فملَّني","https://www.poetsgate.com/ViewPoem.aspx?id=26826",""],[105,"أعن خطب الخلافة تسألينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55027&r=&rc=197",""],[105,"سائلوا الأبطال هل ملوا الكفاحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55106&r=&rc=276",""],[91,"الفراشة المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67880&r=&rc=160",""],[87,"ألا هتفَت بالأيكِ ساجِعة ُ القُمرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23969&r=&rc=231",""]],"verses":[["تَزهو عَلى تِلكَ الظِبا","ءِ فَلَيتَ شِعري مَن أَباها",0,"ا",3,0],["تَزَوَّدنَ مِنّا كُلَّ قَلبٍ وَمُهجَةٍ","وَزَوَّدنَنا لِلوَجدِ عَضَّ الأَباهِمِ",1,"م",1,0],["تَزاحَمُ أَنجُمُهُ لِلأُفو","لِ وَالبَدرُ في إِثرِ ذاكَ الزِحامِ",2,"م",1,0],["تَزافَرَ صَحبي يَومَ ذي الأَثلِ زَفرَةً","تَذوبُ قُلوبٌ مِن لَظاها وَأَدمُعُ",3,"ع",1,0],["تَزَوَّد مِنَ الماءِ النُقاخِ فَلَن تَرى","بَوادي الغَضا ماءً نُقاخاً وَلا بَردا",4,"د",2,1],["تُزَعزِعُ ريحُ الصَبا مَتنَهُ","كَما لَطَمَ المَزجُ خَدَّ الشَرابِ",5,"ب",1,0],["تُزيرُ عودَ البَشامِ اللَّدنَ مَكسِرُهُ","فَماً يَمُجُّ عَلَيهِ الخَمرَ وَالضَرَبا",6,"ب",2,0],["تُزَفُّ إِلى نادِيكَ مُلْساً مُتونُها","وتُهدَى إِلى أكْفائِهِنَّ العَرائِسُ",7,"س",1,0],["تَزَعْزَعُ أعوادُ المَنابِرِ باسْمِهِ","فتَحْسَبُها منْ هِزَّةٍ تتكلَّمُ",8,"م",1,0],["تَزيدُ على الإقْواءِ حُسْناً كأنّهُمْ","حُلولٌ بِها والدّارُ مِنْ أهلِها قَفْرُ",9,"ر",1,0],["تَزَوَّدتُ مِنها بَعضَ ما فيهِ ريحُها","وَزَوَّدتُها وَالقَلبُ حَرّانُ هائِمُ",10,"م",1,0],["تُزْري بطيبِ أواليها أواخرُها","كذلِكَ السّبْقُ يبْدو آخِرَ الطّلقِ",11,"ق",1,0],["تزْدادُ أشْواقي إذا يوْمٌ خَلا","كتَضاعُفِ الأعْدادِ بالأصْفارِ",12,"ر",1,0],["تَزورُكَ أثناءَ الزّمانِ كأنّها","عُفاةٌ تُرجّي راحَتَيْكَ وقُصّادُ",13,"د",1,0],["تَزِنُ الجِبالَ رَزانَةً أَحلامُهُم","وَأَكُفُّهم خَلَفٌ مِنَ الأَمطارِ",14,"ر",1,0],["تَزَوَّدتَ مِن دُنياكَ ذِكراً مُخَلَّداً","وَذاكَ لَعَمري نِعمَ زادُ المُسافِرِ",15,"ر",1,0],["تَزِنُ الكَلامَ كَأَنَّهُ","ماسٌ بِميزانِ التِجارِ",16,"ر",1,0],["تُزهى بِمَعنىً سَرِيٍّ","أَتى بِمَعنىً شَموسِ",17,"س",1,0],["تَزيدُ عَلى الأَيّامِ نوراً وَبَهجَةً","وَتَذوي اللَيالي وَهيَ غَضٌّ حَبيرُها",18,"ر",3,0],["تَزورُ اِمرِءاً أَمّا الإِلَهَ فَيَتَّقي","وَأَمّا بِفِعلِ الصالِحينَ فَيَأتَمي",19,"م",2,0],["تَزورُ بُيوتاً حَولَهُ ما تُحِبُّها","وَتَهجُرُهُ سَقياً لِمَن أَنتَ هاجِرُ",20,"ر",1,0],["تَزيفُ كَما زافَت إِلى سَلِفاتِها","مُباهِيَةٌ طَيَّ الوِشاحِ مَيودُ",21,"د",1,0],["تُزَفُّ إِلَى نَجِيبٍ أَلِمَعِيٍّ","شَأْى وَرِهَانُهُ أَسْمَى رِهَانِ",22,"ن",1,0],["تُزْهَى بِهَا عَلْيَاءُ أَنْتَ فُؤَادُهَا","وَبِعَيْنِهَا ولِعَيْنِهَا إِنْسَانُ",23,"ن",1,0],["تُزْجِي الصِّحَافِيَّ الأمِينَ المُجْتَبَى","عَفَّ الْجُيُوبِ مُطَهَّرَ الأَرْدانِ",24,"ن",1,0],["تَزِيدُ اللَّحْنَ بِعْدَ اللَّحْنِ طيباً","فَيَعْدُو بِالبَدَاعَةِ كُلَّ ظَنِّ",25,"ن",1,0],["تَزِيدُ أَرْكَانَ الحِمَى قُوَّةً","بِقُوَّةِ الرُّكْنِ الَّذِي يُدْعَمُ",26,"م",1,0],["تَزْهُو الْعُقُولُ بِرَشْحٍ مِنْ نَدَاهُ كَمَا","تَزْهُو الحُقُولُ سَقَاهَا الْعَارِضُ الرَّذِمُ",27,"م",1,0],["تُزِيلُ دُجَى الرِّيَبِ المُسْدَلاتِ","بِأَمْضَى وَأَلْمَعَ مِنْ صَارِمِ",28,"م",1,0],["تُزيغُ خَلائِقَ أَبْنَائِهَا","بِمَا زَاغَ مِنْ فِكْرِهَا الوَاهِمِ",28,"م",1,0],["تَزْدَادُ لَهْفاً عَلَيْهَا","مَا ازْدَادَ فِيهَا الْجَرَائِمْ",29,"م",1,0],["تَزْهُو دَرَارِئُهُ عَلَى عَذَبَاتِهِ","حِيناً وَتَنْطِفُ بِالنُّضَارِ الهَامِي",30,"ي",1,0],["تَزُورُ بِهِ دِياراً لَمْ تَزُرْهَا","مُلِمّاً بِالمَقَامِ وَبِالمُقيمِ",31,"م",1,0],["تَزينُكَ إِن جَرَّدتَها مِن ثيابِها","وَأَنتَ إِذا جَرَّدتَ يَوماً تَشينُها",32,"ن",3,0],["تَزُمُّ بِيَ الأُركوبَ أَدماءُ حُرَّةٌ","نَهوزٌ وَإِن تُستَذمَلِ العيسُ تَذمُلِ",33,"ل",1,0],["تَزيدُ الخَيزُرانَ يَداه طيباً","وَيَختالُ السَريرُ بِهِ اِختِيالا",34,"ل",2,0],["تَزاوَرنَ عَن قُرّانَ عَمداً وَمَن بِهِ","مِنَ الناسِ وَاِزوَرَّت سُراهُنَّ عَن حَجرِ",35,"ر",1,0],["تَزدادُ لِلعَينش إِبهاجا إِذا سَفَرَت","وَتَحرَجُ العَينُ فيها حينَ تَنتَقِبُ",36,"ب",1,0],["تزوّج صنّين الفتى بنت جاره","فأضواء بيروت الوسيطة عرسه",37,"س",2,0],["تزلزلت الحصون بها وكانت","تطاول في مناعتها القرونا",38,"ن",2,0],["تُزَجّيه كفّ الأجنبيّ مسخَّراً","فيمشي بأعباء الأجانب مُثقلا",39,"ل",2,0],["تزيد به العقول هدىً ورشداً","وتَستعلي النفوس به شعورا",40,"ر",2,0],["تَزَوَّد مِثلَ زادِ أَبيكَ فينا","فَنِعمَ الزادُ زادُ أَبيكَ زادا",41,"د",2,0],["تَزيدونَ الحَياةَ إِلَيَّ حُبّاً","وَذِكرٌ مِن حِبائِكُمُ حَميدُ",42,"د",1,0],["تَزورُ جارَتَهُم وَهناً جِفانُهُمُ","وَما فَتىً لَهُمُ وَهناً بِزَوّارِ",43,"ر",1,0],["تَزورُ بَناتُهُ جَدَثاً مُقيماً","بِنَفسي ذَلِكَ الجَدَثُ المَزورُ",44,"ر",1,0],["تَزَوَّجتُم نَوارَ وَلَم تُريدوا","لِيُد