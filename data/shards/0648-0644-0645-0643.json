{"poems":[[90,"إذا شئت أن تسري بكافرة الصوى","https://www.aldiwan.net/poem44444.html","الطويل"],[51,"رب أمر يسوء ثم يسر","https://www.aldiwan.net/poem62071.html","الخفيف"],[447,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79419","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77304","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103407","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133260","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90874","الكامل"]],"verses":[["ولم كيفها هذا الخلاف وإنما","أطافت بنقص للحقيقة زائد",0,"د",1,0],["وَلِمَكرِ الدُنيا خَطافيفُ لَهوٍ","وَخَطاطيفُها إِلَيها تَجُرُّ",1,"ر",1,0],["ولمكة حدد لنا","نهج الطريق العافيه",2,"ي",2,0],["ولِمْ كلُّ هذا الاحتشامِ بمجلسٍ","يزيِّنُهُ الريحانُ والشمسُ والراحُ",3,"ح",1,0],["وَلِم كَرِهوا الشورى وَجاءَ بِفَضلِها","عَنِ اللَهِ جِبريلٌ لِسَيِّدِ عَدنانِ",4,"ن",1,0],["ولمكٌ أبوه كان في الروع رائعاً","جريئاً على نفس الكميِّ المضارب",5,"ب",1,0],["ولمكة حالا رجع","وبأمر مولاه صدع",6,"ع",1,0],["ولمكرمات عابديات بها","رب المكارم للقلوب استعبدا",7,"د",2,0]]}