{"poems":[[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83307","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59255","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53043","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91098","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44727","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127107","الوافر"],[4423,"","https://poetry.dctabudhabi.ae/diwan/poem/124246","الهزج"],[4888,"جنات الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=207675",""],[5431,"وحقك لاتعتب....","https://www.poetsgate.com/ViewPoem.aspx?id=214590",""]],"verses":[["فَمَا أَضَاعَتْ فَلَيْسَ يُحْمَى","وَمَا حَمَتْهُ فَمَا يُضَاعُ",0,"ع",1,0],["فَما اِضطَلَعَت بِالسَيفِ أَيدي جُنودِها","وَإِن مَهَرَت في الشَحذِ أَيدي قُيونِها",1,"ن",3,0],["فَمَا أضَا الصُّبْحُ لَوْلاَكِ ابْتَسَمْتِ لَهُ","وَلا دَجَا اللَّيْلُ حَتَّى جَنَّ صُدْغَاكِ",2,"ك",1,0],["فما أضرم الأعداء نار مكيدة","فكانت لهم إلا كنار الحُباحِب",3,"ب",1,0],["فَما أَضعت صَديقاً ظَلَّ يَحفظني","وَلا ضحكت لَدى وَلهان مكتئب",4,"ب",1,0],["فَما اِضطَرَبت نَفي اِضطِراباً مِن الرَدى","وَلَكِنَني شَخص حَزين عَلى جنسي",5,"ي",1,0],["فما أضحى بنهد الخود مغرى","ولكن كان يهوي الطرف نهدا",6,"د",2,0],["فما أضحكك الدهر","كذاك الدهر يبكيكا",7,"ك",2,0],["فما أضنى الهوى منّا","طريحَ القَلبِ أو أعيا",8,"ي",2,0],["فما أُضرمت لائي على الظلم ثورةً","ولا آثرت نفسي فقيرا ليُكفأ",9,"ا",1,0]]}