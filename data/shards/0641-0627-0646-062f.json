{"poems":[[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[63,"وعدت والخل موفي له زفرا","https://www.aldiwan.net/poem45718.html","البسيط"],[57,"لم يبق في الناس إلا المكر والملق","https://www.aldiwan.net/poem24659.html","البسيط"],[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[88,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[88,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[88,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[32,"شهدت بأني لم تغير مودتي","https://www.aldiwan.net/poem27813.html","الطويل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[43,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[58,"يا أكرم الخلق على الله","https://www.aldiwan.net/poem30804.html","السريع"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[31,"بعثت وليدتي سحرا","https://www.aldiwan.net/poem42479.html","مجزوء الوافر"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[48,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[50,"يا صاح بين حاجتي","https://www.aldiwan.net/poem63885.html","مجزوء الكامل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[46,"روحي كالنار أذابت دمي","https://www.aldiwan.net/poem23431.html","السريع"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"],[116,"بالله ياحبا اضا","https://www.aldiwan.net/poem40892.html","عموديه"],[144,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[144,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[151,"كم في الدياجير من ذخر وفائدة","https://www.aldiwan.net/poem68518.html","البسيط"],[161,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[186,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[187,"عدوك في النفاق عدو سوء","https://www.aldiwan.net/poem43656.html","الوافر"],[212,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[212,"ولى شبابك لم ننعم بنضرته","https://www.aldiwan.net/poem46817.html","البسيط"],[261,"ألا أبلغ لديك أبا حميسٍ","https://www.aldiwan.net/poem1114.html",""],[266,"الغبيط","https://www.aldiwan.net/poem8370.html","عموديه"],[276,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[276,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[283,"بكاظمة قفوا وسلوا","https://www.aldiwan.net/poem32641.html","مجزوء الوافر"],[286,"سلام يا إمام المسلمينا","https://www.aldiwan.net/poem39409.html","الوافر"],[306,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[349,"حجابه قد زاد في عرضه","https://www.aldiwan.net/poem20420.html","السريع"],[365,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[367,"فلا تجمعوا للدهر في ذات بينكم","https://www.aldiwan.net/poem17961.html","الطويل"],[378,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[478,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[478,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[552,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[559,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[576,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"]],"verses":[["فَإِن دُموعي جَرينَ نَهنَهَها","عِلمي بِأَن قَد ظَفِرتَ بِالأَرَبِ",0,"ب",1,0],["فَإِنَّ دَغدَغَةَ الأَقداحِ مُهدِيَةٌ","إِليَّ تَعتَعَةً لِلسُّكرِ تَعبَثُ بي",1,"ب",2,0],["فَإِن دَعَتكَ ضَروراتٌ لِعِشرَتِهِم","فَكُن جَحيماً لَعَلَّ الشَوكَ يَحتَرِقُ",2,"ق",1,0],["فَإِنَّ دَوائِرَ الأَيّامِ يُفني","تَتابُعُ وَقعِها الذَكَرَ الحُساما",3,"م",2,0],["فإنّ دبور الذلّ ألوت بعّزه","وكادت سموم الجهل تحرقه جدبا",4,"ب",2,0],["فإن دجت الخطوب بجانبيها","طلعتم في دُجُنَّتها بدورا",5,"ر",2,0],["فاندبوا يا قوم منه بطلا","هو للأبطال حسن وجمال",6,"ل",1,0],["فَإِن دامَ هَذا الصَرمُ مِنكِ فَإِنَّني","لَأَغبَرِها في الجانِبَينِ رَهينُ",7,"ن",1,0],["فاندك بغيهم ببقى مثله","والله للباغين بالمرصاد",8,"د",1,0],["فاندفع الماجور","بسحره يدور",9,"ر",1,0],["فَاِندَفَعَ الظَبيُ لِذاكَ يَبكي","وَقالَ مِن بَعدِ اِنجِلاءِ الشَك",10,"ك",1,0],["فَإِنَّ دُموعَ العَينِ غُدرٌ بِرَبِّها","إِذا كُنَّ إِثرَ الغادِرينَ جَوارِيا",11,"ي",2,0],["فإنْ دعاكَ إليه ذِكْرُ مأدُبِةٍ","فما نَشأْتَ وفيها للعُلى أدَبا",12,"ب",2,0],["فَاِندُب لَهُ حَيدَرَ لا غَيرَهُ","فَلَيسَ بِالغَمرِ وَلا اللاهي",13,"ا",3,0],["فإن دنا الليل برّحت بي","وساكن الليل كم أثار",14,"ر",1,0],["فَأَنْدى بَني ماءِ السماءِ مُحَمَّدٌ","وهل طَلُّ معروفِ السماء كوابِلِه",15,"ل",2,0],["فَإِن داويتِ ذا سَقَمٍ","فَأَخزى اللَهُ مِن كَفرَك",16,"ك",1,0],["فَإِن دَقَّتِ الهَيجاءُ أَرماحَ حَلبَةٍ","فَثَمَّ مِنَ الآراءِ أَمضى لَهاذِمِ",17,"م",1,0],["فَإِن دَنَّسَ المالُ عِرضَ ذي شَرَفٍ","فَإِنَّ عِرضي يُصانُ بِالمالِ",18,"ل",1,0],["فَاِندُب لِوِدِّكَ واحِداً","أَو كُن كَذي الفَرسِ الوِجادِ",19,"د",1,0],["فَاِندُب لَها روحَ القُلو","بِ فَلَيسَ عَن شَرَفٍ بِبارِد",20,"د",1,0],["فَاِندَم عَلى الذَنبِ إِذا جِئتَهُ","فَمِن شُروطِ التائِبينَ النَدَم",21,"م",1,0],["فَإِن دانَيتُهُم لَم تَعدُ ظُلَماً","وَمَنّاً في الأُمورِ بِغَيرِ مَنِّ",22,"ن",1,0],["فاندب المرج فالكنيسة فالشط","ط وقل آه يا معاهد آها",23,"ا",3,0],["فاندب زمانك يا خؤُ","ن لتلف دمعك ما نشف",24,"ف",1,0],["فَإِنَّ دونَ المَعالي شُقَّةً بَعُدَت","بِها المَشَقَّةُ دونَ الفَوزِ وَالشَجَبُ",25,"ب",1,0],["فَاِندُب لِمَملَكَةِ العِراقِ ضَراغِماً","عَلَّمتَهُم فَرسَ العِدى فَتَعَلَّموا",26,"م",3,0],["فاندب ذنوبَكَ واستوهب إقالتها","فالعفو عند اعترافِ العبدِ ينتَظَرُ",27,"ر",1,0],["فإن دوام ملك أبي حسين","شفاء للقلوب من السقام",28,"م",1,0],["فإنْ دَعاني الهوى لَبيَّتُ دعْوتَه","وإن دعاني لسانُ العَتْب لم أُجِب",29,"ب",1,0],["فإن دقّت مكائده تحصّى","عليك اللفظ واطلب الشناعا",30,"ع",2,0],["فاندب رجاءك في دنيا وعدت بها","أحالها الدهر مغنىً غير مأهول",31,"ل",1,0],["فاندب رجاءك في دنيا وعدت بها","أحلها الدهر مغنى غير مأهولِ",32,"ل",1,0],["فَإِنَّ دِيارَكُم بِجَنوبِ بُسٍّ","إِلى ثَقفٍ إِلى ذاتِ العُظومِ",33,"م",1,0],["فاندفعا إلى الرقص الشهيِّ","وموجةُ الإيقاعِ ترفعُ ذيلَ فستانِ الفتاةِ",34,"ه",1,0],["فأَنْدَلُسٌ قَدْ بُشِّرَتْ بِلِقائِهِ","تَرَقّبُ منْ تلْقائِه الفُلْكَ والسُّفْنا",35,"ن",2,0],["فإن دَوَّخَتْ فيهِ العِنَادَ جيادُهُ","فقَد نَسَفَتْ فيهِ سَفائِنُه الكُفرا",36,"ر",2,0],["فَإِن داموا عَلى هَجري","فَلا سَهلٌ وَلا جَبَلُ",37,"ل",1,0],["فان دعاء مثلك مستجاب","وأنت اليوم قطب المتقينا",38,"ن",2,0],["فإنّ دولةَ مَولانا المشير لها","مِنَ العنايةِ أركانٌ بتشييدِ",39,"د",1,0],["فَإنْ دُفِعْنَا وَوَقَعْنا لهُ","فَقَدْ وَقَعْنا في الطَّوِيلِ العَرِيضْ",40,"ض",1,0],["فإن دعا كان جُودُ الغَيثِ مُتَّصلاً","وإن سَخا كان غَيْثُ الجُودِ مُنَهمِرا",41,"ر",2,0],["فَإِنَّ دُخولَ الناسِ في ذا وَمِثلِهِ","دُخولٌ لَعَمري بَينَ سَيفٍ وَقائِمِ",42,"م",1,0],["فاندقَّ طودُ الكفر مندكّاً وقد","فرَّ اللعينُ به فولَّى هاربا",43,"ب",2,0],["فاِنَّ دمعي الذي قد كنتَ تعهدُه","لم يُبْقِ منه النوى فضلاً لمُزدادِ",44,"د",1,0],["فِانَّ دمعي بسُقيا تربِه قَمِنٌ","سَقَى زمانكِ هَطّالُ الحيا ورَعَى",45,"ع",2,0],["فَإِنْ دُوَلٌ مِنكم مَشينَ تَبختُراً","زَماناً فقد تمشى الطِّلاحُ اللواغِبُ",46,"ب",1,0],["فإن داعي الكمال مني","يسمع من شاء بامتنان",47,"ن",1,0],["فإِن دنوتَ فقلبي عنك مُنْتزِحٌ","وإِن نشطتَ فحبي فيكَ قد كَسَلا",48,"ل",2,0]]}