{"poems":[[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[63,"وعدت والخل موفي له زفرا","https://www.aldiwan.net/poem45718.html","البسيط"],[57,"لم يبق في الناس إلا المكر والملق","https://www.aldiwan.net/poem24659.html","البسيط"],[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[88,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[88,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[88,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[32,"شهدت بأني لم تغير مودتي","https://www.aldiwan.net/poem27813.html","الطويل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[43,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[58,"يا أكرم الخلق على الله","https://www.aldiwan.net/poem30804.html","السريع"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[31,"بعثت وليدتي سحرا","https://www.aldiwan.net/poem42479.html","مجزوء الوافر"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[48,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[50,"يا صاح بين حاجتي","https://www.aldiwan.net/poem63885.html","مجزوء الكامل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[46,"روحي كالنار أذابت دمي","https://www.aldiwan.net/poem23431.html","السريع"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"]],"verses":[["فَإِن دُموعي جَرينَ نَهنَهَها","عِلمي بِأَن قَد ظَفِرتَ بِالأَرَبِ",0,"ب",1,0],["فَإِنَّ دَغدَغَةَ الأَقداحِ مُهدِيَةٌ","إِليَّ تَعتَعَةً لِلسُّكرِ تَعبَثُ بي",1,"ب",2,0],["فَإِن دَعَتكَ ضَروراتٌ لِعِشرَتِهِم","فَكُن جَحيماً لَعَلَّ الشَوكَ يَحتَرِقُ",2,"ق",1,0],["فَإِنَّ دَوائِرَ الأَيّامِ يُفني","تَتابُعُ وَقعِها الذَكَرَ الحُساما",3,"م",2,0],["فإنّ دبور الذلّ ألوت بعّزه","وكادت سموم الجهل تحرقه جدبا",4,"ب",2,0],["فإن دجت الخطوب بجانبيها","طلعتم في دُجُنَّتها بدورا",5,"ر",2,0],["فاندبوا يا قوم منه بطلا","هو للأبطال حسن وجمال",6,"ل",1,0],["فَإِن دامَ هَذا الصَرمُ مِنكِ فَإِنَّني","لَأَغبَرِها في الجانِبَينِ رَهينُ",7,"ن",1,0],["فاندك بغيهم ببقى مثله","والله للباغين بالمرصاد",8,"د",1,0],["فاندفع الماجور","بسحره يدور",9,"ر",1,0],["فَاِندَفَعَ الظَبيُ لِذاكَ يَبكي","وَقالَ مِن بَعدِ اِنجِلاءِ الشَك",10,"ك",1,0],["فَإِنَّ دُموعَ العَينِ غُدرٌ بِرَبِّها","إِذا كُنَّ إِثرَ الغادِرينَ جَوارِيا",11,"ي",2,0],["فإنْ دعاكَ إليه ذِكْرُ مأدُبِةٍ","فما نَشأْتَ وفيها للعُلى أدَبا",12,"ب",2,0],["فَاِندُب لَهُ حَيدَرَ لا غَيرَهُ","فَلَيسَ بِالغَمرِ وَلا اللاهي",13,"ا",3,0],["فإن دنا الليل برّحت بي","وساكن الليل كم أثار",14,"ر",1,0],["فَأَنْدى بَني ماءِ السماءِ مُحَمَّدٌ","وهل طَلُّ معروفِ السماء كوابِلِه",15,"ل",2,0],["فَإِن داويتِ ذا سَقَمٍ","فَأَخزى اللَهُ مِن كَفرَك",16,"ك",1,0],["فَإِن دَقَّتِ الهَيجاءُ أَرماحَ حَلبَةٍ","فَثَمَّ مِنَ الآراءِ أَمضى لَهاذِمِ",17,"م",1,0],["فَإِن دَنَّسَ المالُ عِرضَ ذي شَرَفٍ","فَإِنَّ عِرضي يُصانُ بِالمالِ",18,"ل",1,0],["فَاِندُب لِوِدِّكَ واحِداً","أَو كُن كَذي الفَرسِ الوِجادِ",19,"د",1,0],["فَاِندُب لَها روحَ القُلو","بِ فَلَيسَ عَن شَرَفٍ بِبارِد",20,"د",1,0],["فَاِندَم عَلى الذَنبِ إِذا جِئتَهُ","فَمِن شُروطِ التائِبينَ النَدَم",21,"م",1,0],["فَإِن دانَيتُهُم لَم تَعدُ ظُلَماً","وَمَنّاً في الأُمورِ بِغَيرِ مَنِّ",22,"ن",1,0],["فاندب المرج فالكنيسة فالشط","ط وقل آه يا معاهد آها",23,"ا",3,0]]}