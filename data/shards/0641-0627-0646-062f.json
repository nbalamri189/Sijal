{"poems":[[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[65,"وعدت والخل موفي له زفرا","https://www.aldiwan.net/poem45718.html","البسيط"],[59,"لم يبق في الناس إلا المكر والملق","https://www.aldiwan.net/poem24659.html","البسيط"],[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[90,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[90,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[90,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[34,"شهدت بأني لم تغير مودتي","https://www.aldiwan.net/poem27813.html","الطويل"],[87,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[87,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[45,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[63,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[60,"يا أكرم الخلق على الله","https://www.aldiwan.net/poem30804.html","السريع"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[82,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[33,"بعثت وليدتي سحرا","https://www.aldiwan.net/poem42479.html","مجزوء الوافر"],[76,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[50,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[52,"يا صاح بين حاجتي","https://www.aldiwan.net/poem63885.html","مجزوء الكامل"],[52,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[48,"روحي كالنار أذابت دمي","https://www.aldiwan.net/poem23431.html","السريع"],[48,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"],[119,"بالله ياحبا اضا","https://www.aldiwan.net/poem40892.html","عموديه"],[147,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[147,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[154,"كم في الدياجير من ذخر وفائدة","https://www.aldiwan.net/poem68518.html","البسيط"],[164,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[189,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[190,"عدوك في النفاق عدو سوء","https://www.aldiwan.net/poem43656.html","الوافر"],[215,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[215,"ولى شبابك لم ننعم بنضرته","https://www.aldiwan.net/poem46817.html","البسيط"],[265,"ألا أبلغ لديك أبا حميسٍ","https://www.aldiwan.net/poem1114.html",""],[270,"الغبيط","https://www.aldiwan.net/poem8370.html","عموديه"],[280,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[280,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[287,"بكاظمة قفوا وسلوا","https://www.aldiwan.net/poem32641.html","مجزوء الوافر"],[290,"سلام يا إمام المسلمينا","https://www.aldiwan.net/poem39409.html","الوافر"],[310,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[353,"حجابه قد زاد في عرضه","https://www.aldiwan.net/poem20420.html","السريع"],[369,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[371,"فلا تجمعوا للدهر في ذات بينكم","https://www.aldiwan.net/poem17961.html","الطويل"],[382,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[482,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[482,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[556,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[580,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122759","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96975","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64408","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77597","الرجز"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129528","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72275","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56098","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109073","الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132811","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52112","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201718","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27332","المجتث"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141734","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27224","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77284","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60967","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94290","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136987",""],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58487","الخفيف"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102339","الوافر"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96106","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112682","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68017","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62743","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62942","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127015","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86296","المجتث"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92063","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85278","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202332","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97074","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90824","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94825","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83197","الرجز"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147275","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4767,"ساعات الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129785",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5111,"لوْ... لاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=212322",""],[5135,"وطن السماحة","https://www.poetsgate.com/ViewPoem.aspx?id=201961",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5212,"سلاماً يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=212058",""],[5351,"هنا اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=202214",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5691,"أفْوافٌ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207696",""],[3856,"قَالُوا: الزَّمانُ كفيلٌ أنْ يُسَلِّينا","https://www.poetsgate.com/ViewPoem.aspx?id=215908",""],[5924,"سكنى الفنادق ذلُّ","https://www.poetsgate.com/ViewPoem.aspx?id=186930",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"العواطف أساس الصالحات وأساس الفن الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=192122",""],[6124,"إمرأة هلت","https://www.poetsgate.com/ViewPoem.aspx?id=174941",""]],"verses":[["فَإِن دُموعي جَرينَ نَهنَهَها","عِلمي بِأَن قَد ظَفِرتَ بِالأَرَبِ",0,"ب",1,0],["فَإِنَّ دَغدَغَةَ الأَقداحِ مُهدِيَةٌ","إِليَّ تَعتَعَةً لِلسُّكرِ تَعبَثُ بي",1,"ب",2,0],["فَإِن دَعَتكَ ضَروراتٌ لِعِشرَتِهِم","فَكُن جَحيماً لَعَلَّ الشَوكَ يَحتَرِقُ",2,"ق",1,0],["فَإِنَّ دَوائِرَ الأَيّامِ يُفني","تَتابُعُ وَقعِها الذَكَرَ الحُساما",3,"م",2,0],["فإنّ دبور الذلّ ألوت بعّزه","وكادت سموم الجهل تحرقه جدبا",4,"ب",2,0],["فإن دجت الخطوب بجانبيها","طلعتم في دُجُنَّتها بدورا",5,"ر",2,0],["فاندبوا يا قوم منه بطلا","هو للأبطال حسن وجمال",6,"ل",1,0],["فَإِن دامَ هَذا الصَرمُ مِنكِ فَإِنَّني","لَأَغبَرِها في الجانِبَينِ رَهينُ",7,"ن",1,0],["فاندك بغيهم ببقى مثله","والله للباغين بالمرصاد",8,"د",1,0],["فاندفع الماجور","بسحره يدور",9,"ر",1,0],["فَاِندَفَعَ الظَبيُ لِذاكَ يَبكي","وَقالَ مِن بَعدِ اِنجِلاءِ الشَك",10,"ك",1,0],["فَإِنَّ دُموعَ العَينِ غُدرٌ بِرَبِّها","إِذا كُنَّ إِثرَ الغادِرينَ جَوارِيا",11,"ي",2,0],["فإنْ دعاكَ إليه ذِكْرُ مأدُبِةٍ","فما نَشأْتَ وفيها للعُلى أدَبا",12,"ب",2,0],["فَاِندُب لَهُ حَيدَرَ لا غَيرَهُ","فَلَيسَ بِالغَمرِ وَلا اللاهي",13,"ا",3,0],["فإن دنا الليل برّحت بي","وساكن الليل كم أثار",14,"ر",1,0],["فَأَنْدى بَني ماءِ السماءِ مُحَمَّدٌ","وهل طَلُّ معروفِ السماء كوابِلِه",15,"ل",2,0],["فَإِن داويتِ ذا سَقَمٍ","فَأَخزى اللَهُ مِن كَفرَك",16,"ك",1,0],["فَإِن دَقَّتِ الهَيجاءُ أَرماحَ حَلبَةٍ","فَثَمَّ مِنَ الآراءِ أَمضى لَهاذِمِ",17,"م",1,0],["فَإِن دَنَّسَ المالُ عِرضَ ذي شَرَفٍ","فَإِنَّ عِرضي يُصانُ بِالمالِ",18,"ل",1,0],["فَاِندُب لِوِدِّكَ واحِداً","أَو كُن كَذي الفَرسِ الوِجادِ",19,"د",1,0],["فَاِندُب لَها روحَ القُلو","بِ فَلَيسَ عَن شَرَفٍ بِبارِد",20,"د",1,0],["فَاِندَم عَلى الذَنبِ إِذا جِئتَهُ","فَمِن شُروطِ التائِبينَ النَدَم",21,"م",1,0],["فَإِن دانَيتُهُم لَم تَعدُ ظُلَماً","وَمَنّاً في الأُمورِ بِغَيرِ مَنِّ",22,"ن",1,0],["فاندب المرج فالكنيسة فالشط","ط وقل آه يا معاهد آها",23,"ا",3,0],["فاندب زمانك يا خؤُ","ن لتلف دمعك ما نشف",24,"ف",1,0],["فَإِنَّ دونَ المَعالي شُقَّةً بَعُدَت","بِها المَشَقَّةُ دونَ الفَوزِ وَالشَجَبُ",25,"ب",1,0],["فَاِندُب لِمَملَكَةِ العِراقِ ضَراغِماً","عَلَّمتَهُم فَرسَ العِدى فَتَعَلَّموا",26,"م",3,0],["فاندب ذنوبَكَ واستوهب إقالتها","فالعفو عند اعترافِ العبدِ ينتَظَرُ",27,"ر",1,0],["فإن دوام ملك أبي حسين","شفاء للقلوب من السقام",28,"م",1,0],["فإنْ دَعاني الهوى لَبيَّتُ دعْوتَه","وإن دعاني لسانُ العَتْب لم أُجِب",29,"ب",1,0],["فإن دقّت مكائده تحصّى","عليك اللفظ واطلب الشناعا",30,"ع",2,0],["فاندب رجاءك في دنيا وعدت بها","أحالها الدهر مغنىً غير مأهول",31,"ل",1,0],["فاندب رجاءك في دنيا وعدت بها","أحلها الدهر مغنى غير مأهولِ",32,"ل",1,0],["فَإِنَّ دِيارَكُم بِجَنوبِ بُسٍّ","إِلى ثَقفٍ إِلى ذاتِ العُظومِ",33,"م",1,0],["فاندفعا إلى الرقص الشهيِّ","وموجةُ الإيقاعِ ترفعُ ذيلَ فستانِ الفتاةِ",34,"ه",1,0],["فأَنْدَلُسٌ قَدْ بُشِّرَتْ بِلِقائِهِ","تَرَقّبُ منْ تلْقائِه الفُلْكَ والسُّفْنا",35,"ن",2,0],["فإن دَوَّخَتْ فيهِ العِنَادَ جيادُهُ","فقَد نَسَفَتْ فيهِ سَفائِنُه الكُفرا",36,"ر",2,0],["فَإِن داموا عَلى هَجري","فَلا سَهلٌ وَلا جَبَلُ",37,"ل",1,0],["فان دعاء مثلك مستجاب","وأنت اليوم قطب المتقينا",38,"ن",2,0],["فإنّ دولةَ مَولانا المشير لها","مِنَ العنايةِ أركانٌ بتشييدِ",39,"د",1,0],["فَإنْ دُفِعْنَا وَوَقَعْنا لهُ","فَقَدْ وَقَعْنا في الطَّوِيلِ العَرِيضْ",40,"ض",1,0],["فإن دعا كان جُودُ الغَيثِ مُتَّصلاً","وإن سَخا كان غَيْثُ الجُودِ مُنَهمِرا",41,"ر",2,0],["فَإِنَّ دُخولَ الناسِ في ذا وَمِثلِهِ","دُخولٌ لَعَمري بَينَ سَيفٍ وَقائِمِ",42,"م",1,0],["فاندقَّ طودُ الكفر مندكّاً وقد","فرَّ اللعينُ به فولَّى هاربا",43,"ب",2,0],["فاِنَّ دمعي الذي قد كنتَ تعهدُه","لم يُبْقِ منه النوى فضلاً لمُزدادِ",44,"د",1,0],["فِانَّ دمعي بسُقيا تربِه قَمِنٌ","سَقَى زمانكِ هَطّالُ الحيا ورَعَى",45,"ع",2,0],["فَإِنْ دُوَلٌ مِنكم مَشينَ تَبختُراً","زَماناً فقد تمشى الطِّلاحُ اللواغِبُ",46,"ب",1,0],["فإن داعي الكمال مني","يسمع من شاء بامتنان",47,"ن",1,0],["فإِن دنوتَ فقلبي عنك مُنْتزِحٌ","وإِن نشطتَ فحبي فيكَ قد كَسَلا",48,"ل",2,0],["فَإن دُفِنَت تَحتَ التُرابِ خِصالُهُ","فَما دُفِنَت تَحتَ التُّرابِ مَكارِمُه",49,"م",2,0],["فإن دم الإنجاب من آل غلابٍ","أريق على كف ابن ضبع ملفق",50,"ق",1,0],["فاندب بقايا آل","أحمد أنهم خير البقايا",51,"ا",3,0],["فَاِندُب أَخاك إِن يَقَع أَو واسي","فَالدَهر مَعروف الأَسى في الناسِ",52,"س",1,0],["فإن دون تلكما مهامهاً","قد لبس الصيف بها برد الشتا",53,"ا",1,0],["فإن دمعت عيناك فلتبكِ يوسفاً","فذاك بموصول المدامع أجدر",54,"ر",1,0],["فإن دنا الغيث واستسقت مرابعه","ربىً فدمعي بالتسكاب ينجده",55,"د",2,0],["فانديه مفضالٌ حزومٌ محكمٌ","أياديه انشت في الوجود المكارما",56,"م",2,0],["فاندسّ بينهما وقال له اسقه","وأدار عنه الوجه كي لا يخجلا",57,"ل",2,0],["فإنَّ دعائي مُستجابٌ لأنَّهُ","سُلالةُ قلبي والقلوب ضُرُوبُ",58,"ب",1,0],["فإنَّ دماكم طِحنَ في كلّ معشر","ولا ثارَ حتَّى ليس تبقين معشرا",59,"ر",2,0],["فانَّ دهريَ لا يبقى على احدِ","لله ما يفعلُ الغرامُ",60,"م",1,0],["فاندبي شيعتيك إن شئت حربا","يركبوا للهياج عوجَ الجياد",61,"د",1,0],["فاندب العلم لأقوام قضوا","شهداء الجهل في حيهم",62,"م",1,0],["فاندبي السعي لقوم كسلوا","فأصيبوا بنبال النقم",62,"م",1,0],["فإن دعاك الرسولُ يوماً","فافزع إليه إذا فزعتا",63,"ت",2,0],["فإن دارَك هذي","دارُ اختبارٍ وبلوى",64,"و",2,0],["فإنَّ دخْلاً يريد بلوغه","ومَن حصَّل الأوتار قد حصَّلَ المنى",65,"ا",1,0],["فإنْ دعيت الذي يلقيه من حكم","عليك كانت لك الأسرار أفلاكا",66,"ك",2,0],["فَإِنَّ دينَ الهَوى يا ريمُ يَجمَعُنا","وَلَيسَ كَالحُبِّ مِن دينٍ لِمُعتَنِق",67,"ق",1,0],["فإنْ دَنَى منك فسايله ليْ","بالله ما الأَمْرُ وكيف السَّبَبْ",68,"ب",1,0],["فإن دخلوا بيتي أخلا وآمنوا","فصفحا ورب البيت ذو العفو والصفح",69,"ح",1,0],["فاندبه فهو حريّ بأن","يبكي عليه اصغراك",70,"ك",1,0],["فَاِندُبهُما حَيَّينِ وَاِبكِ عَلَيهِما","فَكِلاهُما مَيتٌ وَإِن لَم يُقبَرِ",71,"ر",1,0],["فاندبيها يا أمَّ طوغانَ وابكي","فَقْدَها إنَّ فَقدها يوم عيدي",72,"د",2,0],["فإنَّ دنياكم بكم استقرَّت","فأولوا أهلها خلقاً سديدا",73,"د",2,0],["فان دمنا بذاك وطال عمر","بناوبكم ولم يحدث نكيرا",74,"ر",2,0],["فاندب وَنُح وابكِ بدَمعِ سائلِ","على أب الأيتام والأرامل",75,"ل",1,0],["فإن دياري لا تزالُ مَراتِعاً","لغزلانِ أنسٍ كالبذور الطوالع",76,"ع",1,0],["فإنْ دَلّلْتُ فشيءٌ أنتَ فاعلُه","إنّ الدّلالةَ في المعروفِ كالعَمَلِ",77,"ل",1,0],["فان ديارَ بني عامرٍ","ذُيولُ الرياحِ بها تُسحَبُ",78,"ب",1,0],["فإن دَجا ليلُ روْعٍ أنت مَلجأُهُ","وإن تفاقَمَ أمْرٌ أنتَ مَفْزَعُهُ",79,"ع",2,0],["فإنَّ دماً لو تعلمينَ جَنَيْتِهِ","على الحيِّ جاني مثلِهِ غيرُ سالمِ",80,"م",1,0],["فإن دماءكم ذهبت جباراً","ببيض أولي الضلالة والنفاق",81,"ق",1,0],["فَاِندَم عَلى سوءِ فِعل","قَد كُنت فيهِ بَغيا",82,"ي",2,0],["فاندُب أَسىً ان لم تَكُن","لبُكا الجفونِ بمستطيعِ",83,"ع",1,0],["فاندب ذويه وَقُل هناك مؤرخاً","حسنٌ له الحسنى بفضل اللَه",84,"ه",1,0],["فأند به ندب محب للحبيب رثى","بحرقة من فواد في تلهبه",85,"ب",2,0],["فإن دمعي كصوب المزن أيسره","وإن وجدي كحر النار أبرده",86,"د",2,0],["فاندفعوا بالبأس في وجه العدى","والحرب إما ظفرٌ إما ردى",87,"د",2,0],["فإن دمك السخين سفك","لا نعشٌ يهيأ لك",88,"ك",1,0],["فاندفع تذري بريسا الدموع","مذ أبصرت فطرقل قد مزقت",89,"ت",1,0],["فاندك من عدنان شامخ مجدها","السامي فقل للراسيات تصدعي",90,"ع",2,0],["فاندبه والدمع يسبق منطقي","أيا ابن الهداة الغر من قد سموا قدرا",91,"ر",2,0],["فاندك طور العقل حين بدا له","من فوقه ما لم يكن بحسابه",92,"ب",2,0],["فانديك يا ذا الفيلسوف ألا اقتبل","عذري لأنك أنت أوَّلُ عاذرِ",93,"ر",1,1],["فَإِن دُعِيتَ لِلدُخولِ فادخُلِ","وَإِن أَبوا فاتركهُمُ لا تُثقِلِ",94,"ل",1,0],["فإن دال الزمان علي دهرا","فقلبي مفعم بالياسمينِ",95,"ن",1,0],["فإن دليل الحياة الأثرْ","وما الناس إلا بما يفعلونْ",96,"ن",1,0],["فاندُبي يا أمة الخير فروعاً","واندبي ما شئت مفقودَ الأصول",97,"ل",1,0],["فإن دك حفار القبور رجاءهم","فمثلك من يبني الرجاء مؤاسيا",98,"ي",2,0],["فَانْدُبْ إذَا شِئْتَ لَا فَجْرٌ وَلَا أمَلٌ","آهٍ.. عَلَىْ حُلُمٍ كَمْ بَاتَ يَرْعَاك",99,"ك",1,0],["فانداحَ نورُ الحقِّ من عَرَصَاتِها","فأحالَ هذا التُربَ تِبْراً عَسْجَدا",100,"د",2,0],["فأندلس وآثينا وروما","نذيرات الدهور بذا العقاب",101,"ب",1,0],["فَإِنْ دَجَّ الدُّجى كانوا كأنْجُمِهِ","وإِنْ حَلَّ الصَّباحُ فَصُبْحُهم هَزَعا",102,"ع",2,0],["فإن دماءنا هطلت بحوراً","عليكَ أفيكَ حسٌ أو مشاعر؟",103,"ر",1,0],["فإنْ دعوتَ لشهمٍ بالسلامةِ في","عُمانَ، فاللهَ نرجو الفضلَ والمِنَنَا",104,"ن",2,0],["فانْداحَ في الآفاقِ يسْتُرُ خِدْرَها","وسَجاهُ حارِسُها وما هُوَ نائِمُ",105,"م",1,0],["فإن دَعا عاشِقٌ؛ لَم يَبقَ مِن أحَدٍ","تحتَ السَّماواتِ؛ إلَّا قالَ: آمِينا",106,"ن",2,0],["فإن دفعت إليها","فحجرةٌ لا أقل",107,"ل",1,0],["فاندكَّ أسفله وأعلاه على","أثر التجلِّي حيث صار ترابا",108,"ب",2,0],["فإنْ دخلتْ عواطفُنا لشعرٍ","ونثرٍ.. يصبح التعبير حيّا",109,"ي",2,0],["فانْدفعتْ نحو القاعِ","أعشابًا وأغاني.",110,"ي",1,0]]}