{"poems":[[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[86,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[88,"إليك ما شاهدت عيني من العجب","https://www.aldiwan.net/poem44424.html","البسيط"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[62,"قد زرعنا النضار في الفضة","https://www.aldiwan.net/poem52156.html","الخفيف"],[62,"قد جاءنا في حكمة مكنونة","https://www.aldiwan.net/poem52204.html","الكامل"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[97,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[22,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem21640.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"زودينا نائلا أو عدينا","https://www.aldiwan.net/poem26641.html","المديد"],[46,"عبر الشباب لأمه العبر","https://www.aldiwan.net/poem22589.html","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30460","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21045","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[106,"أيها النشء","https://www.poetsgate.com/ViewPoem.aspx?id=179767",""],[116,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[161,"وقفت على بيتين من أثقل الشعر","https://www.aldiwan.net/poem59177.html","الطويل"],[187,"نفسي يخادعها الأمل","https://www.aldiwan.net/poem43464.html","مجزوء الكامل"],[199,"ولست باحيا من رجال رأَيتهم","https://www.aldiwan.net/poem52005.html","الطويل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[283,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[288,"أبلغ ضبيعة أن البلاد","https://www.aldiwan.net/poem1919.html","المتقارب"],[304,"احرص على سبق المدى في العلا","https://www.aldiwan.net/poem58244.html","السريع"],[306,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[372,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[378,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[394,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[401,"موقف وصول الرسول للمدينة","https://www.aldiwan.net/poem6780.html","عموديه"],[404,"لله درك يا ابن إسماعيلا","https://www.aldiwan.net/poem33595.html","الكامل"],[404,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[407,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[433,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[444,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[453,"ما آل برمك في ذرى بغداد","https://www.aldiwan.net/poem13714.html","الكامل"],[459,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[459,"أنا اليوم مما تعهدين بعيد","https://www.aldiwan.net/poem56239.html","البسيط"],[459,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[459,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[469,"يا سائلي عن حالتي","https://www.aldiwan.net/poem59682.html","مجزوء الكامل"],[496,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[507,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[539,"بدون اجتهاد لا يكون التعلم","https://www.aldiwan.net/poem47465.html","عموديه"],[539,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[552,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[568,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"]],"verses":[["وَحَصَّنَها فَلَيسَ يَنالُ مِنها","ذَنوباً مَن يَهُمُّ وَلا ذِنابا",0,"ب",2,0],["وَحَصِّنهُ بِإِحسانٍ وَعَدلٍ","فَحِصنُ المُلكِ إِحسانٌ وَعَدلُ",1,"ل",1,0],["وحصنٍ منيع في ذراها قد ارتقى","فأبعد في الجو الفضاء المراقيا",2,"ي",2,0],["وحصّنوه من الأعلى بمشتبك","من الحبال جديل غير منقضب",3,"ب",1,0],["وحصنت القرى طولا وعرضا","بآساد يهيبِّن العرينا",4,"ن",2,0],["وَحِصنٌ تَسامى مِن دُموقو كَأَنَّهُ","مُعَشِّشُ نَسرٍ أَو بِهَذا يُلَقَّبُ",5,"ب",1,0],["وحصدنا من الشموس شموسنا","وحصدنا من البدور بدورا",6,"ر",2,0],["وحصيد زرعي مثل بذري خارج","عني وفيَّ أمانة وصلاحُ",7,"ح",1,0],["وَحُصَّت أَماني المُعتَفينَ بِحَيثُ لا","يُحاذَرُ بَأساءُ الحَياةِ وَلا الفَقرُ",8,"ر",1,0],["وحصدت آمالي فإن","نَ الموتَ أرحمُ منجلا",9,"ل",2,0],["وحصاةُ أناتك لو وُزِنَتْ","أنْسَتْ برجاحتها حَضَنَا",10,"ن",2,0],["وحصداءُ فولاذيّةُ النّسجِ لم تَزَلْ","من اللهذمِ الوقّادِ مطفئةً وقدا",11,"د",2,0],["وحصري ماذا تحتها مِنْ زبالةٍ","فيا كسرَ قلبي عندما تُرفعُ الحصرُ",12,"ر",1,0],["وَحَصداءُ تَزري بِالسِنانِ حَصينَةً","وَوَجهٌ وَقّاحٌ بِالحَديدِ مُقَنَّعُ",13,"ع",1,0],["وَحِصناً تَرتَمي نُوَبُ اللَيالي","هَوالِكَ عَن ذُراهُ أَو تفادى",14,"د",2,0],["وحِصْنُ الصَّعْبِ أذعنَ بعد كبرٍ","وأعلنَ بعد غِلظتِهِ المَتابا",15,"ب",2,0],["وَحَصى الكَثيبِ بِصَفحَتَيهِ كَأَنَّهُ","خَبَثُ الحَديدِ أَطارَهُنَّ الكيرُ",16,"ر",1,0],["وَحَصَلَ الزَوجُ لِضُعفِ حيلَتِه","عَلى نُواحِهِ وَنَتفِ لِحيَتِه",17,"ه",1,0],["وَحَصَرتَ الناسَ مِن كُلِّ عادٍ","بِسُيوفٍ وَقَناً قَد رَوَينا",18,"ن",2,0],["وَحَصُلتُ مِن وَرِقٍ عَلى وَرَقٍ","بيضٍ يَشُقُّ مُتونَها الحِبرُ",19,"ر",1,0],["وحَصَّلْتُ ما أَدركْتُ مِن طُول لِذَّتي","فلم أُلْفِهِ إِلَّا كصَفْقةِ خاسِرِ",20,"ر",1,0],["وَحِصنٍ سَرَّهُ فَعَلاَ مَهيباً","يُجازي القُلَّ بالَحجمِ الكَثيرِ",21,"ر",1,0],["وَحَصْحَصَ حَقُّ الشَّيءِ رَاعَ جَمَالُهُ","وَلَم تَخْفَ عُوْراتٌ بِهِ وَعُيُوبُ",22,"ب",1,0],["وحصنُكِ لا يلينُ له حديدُ","ولو شُهُبُ الدُجَى كانت سهاما",23,"م",2,0],["وحصِّنُوا أرضَكم من كلِّ مغتصبٍ","بكلِّ مدَّرعٍ في الحرب متَّرِسِ",24,"س",1,0],["وحصَّلوا، إنما التحصيلُ في صِغرٍ","نقش على الصخر لا يمحوه ماحيه",25,"ي",2,0],["وحصن همته العليا وقايتنا","ان مس ن نازلات الدهر تعنيت",26,"ت",1,0],["وحصّين تعز بعد ذاك وبعده","حديث الحبيشي والوثوب على البر",27,"ر",1,0],["وحصلت تحت مقالهم","ولى وأدبر بل بطل",28,"ل",1,0],["وَحصن بصحراء الثويّة بيته","أَلا إِنَّما الدنيا متاع يمتعُ",29,"ع",1,0],["وَحُصونَ خَيبَرَ جاءَها لَمّا عَصَت","بِالجَيشِ ذي السَطَواتِ وَالسُلطانِ",30,"ن",1,0],["وَحِصانُهُ بَحرٌ يَموجُ بِسَرجِهِ","بَحرٌ وَيَزأَرُ فَوقَهُ ضِرغامُ",31,"م",1,0],["وَحِصنٌ حَصينٌ لِأَبنائِهِم","وَريفٌ لِإِبلِهِمُ مُخصِبُ",32,"ب",1,0],["وحصل العلم كما ينبغي","ولا تدع فائدةً فائته",33,"ه",1,0],["وَحصحصَ أنّ الحليّ مشغولُ أهله","وَأنّ العواري مستردّ رديدها",34,"د",3,0],["وحصلنَ في أبياتِ شِع","ري كالقصائِر في القصورِ",35,"ر",1,0],["وحصنه في حصن البتولة مريمٍ","عليها سلام اللَه ما أسفر الصبح",36,"ح",1,0],["وَحَصَّلَت في عَقدِها التَبارا","وَثَلَّثَت فَهيَ تَحوزُ النارا",37,"ر",2,0],["وحصانُ الشَّوقِ أرْخيتُ له","حَبْله ، فازداد شوقا وسعى",38,"ع",2,0],["وحصلت منه على لطائف لم يزل","فيما علمت بها سواك بخيلا",39,"ل",2,0],["وحصل مملوكاً وداراً وبغلة","وأسرج مركوباً وسرج بالشمع",40,"ع",1,0],["وَحصرتُ نَفسي بالعفاف عَن الَّتي","تصم الكَريم وَفي العفاف حِصارُ",41,"ر",1,0],["وحصّنتُ عنه دَراءَ السنينَ","فثارَ عليّ من الأشهرِ",42,"ر",1,0],["وحصن قد غدا في الجو","يحكي حنطة تذري",43,"ي",1,0],["وحصافة قرنت بطيب مكاسرٍ","وفصاحة وُصِلَت بطول نجاد",44,"د",1,0],["وحصينةٍ من حسن رأ","يك لا يُقَضُّ صِدارُها",45,"ر",3,0],["وحَصَّ غرابي يا ابنة القومِ أجدلٌ","بصيرٌ بأوكار الشبابِ صَيودُ",46,"د",1,0],["وحصداءُ من نُعماه كلُّ مسدَّدٍ","له حَيَدٌ عن سَردها ونُكوبُ",47,"ب",1,0],["وحصَّنَ صدر اقلبُ أحمدَ تحته","يضيق ذراعُ الدهر وهو رحيبُ",48,"ب",1,0],["وَحَصَلتُ بَعدَهُم عَلى","مَن هُم لِقَلبِ الدَهرِ هَمُّ",49,"م",1,0],["وحصَّنها بعيدان طوال","وزينها بقضبان الكروم",50,"م",1,0],["وحصب الورى يوم تسقى الثرى","سحائب من دمها الهامر",51,"ر",1,0],["وحَصِّل كثيراً منه وهو المُرادُ في","قَليلِ زَمانٍ منكَ إن كنتَ تَفهَمُ",52,"م",1,0],["وحَصيرٍ مِن تُراثٍ","لبَنِي عبدِ المَدانِ",53,"ن",1,0],["وحصّنها وعند اللَّه علمٌ","بأنّك لم تدع فيها عِقالا",54,"ل",2,0],["وحَصَلَّتُ أَسْرَارَ الصَّدِيْقِ بِمُحْرَزٍ","مِنَ الحِفْظِ عِنْدِي مَا لِخَاتَمِهِ فَضُّ",55,"ض",1,0]]}