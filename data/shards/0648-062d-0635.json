8","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127136","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123525","الطويل"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45027","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94656","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94330","الكامل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29470","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83654","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58099","السريع"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113824","البسيط"],[4623,"","https://poetry.dctabudhabi.ae/diwan/poem/140152",""],[4658,"","https://poetry.dctabudhabi.ae/diwan/poem/111554","الطويل"],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4927,"قالت: أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=30176",""],[5025,"ضربت جحيشاً ضربة لا لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=52764",""],[5060,"بعض أهلّة","https://www.poetsgate.com/ViewPoem.aspx?id=214499",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[5564,"يالله يا فكّاك حبل المناشيب","https://www.poetsgate.com/ViewPoem.aspx?id=186843",""],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5691,"فصايل","https://www.poetsgate.com/ViewPoem.aspx?id=206214",""],[5943,"ماللطريق بدوننا قنديلُ","https://www.poetsgate.com/ViewPoem.aspx?id=61822",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[5997,"لا تخشي","https://www.poetsgate.com/ViewPoem.aspx?id=214204",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6145,"شيخ الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=7798",""],[463,"لمنَ الطلولُ تراقصتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60065&r=&rc=121",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""]],"verses":[["وَحَصَّنَها فَلَيسَ يَنالُ مِنها","ذَنوباً مَن يَهُمُّ وَلا ذِنابا",0,"ب",2,0],["وَحَصِّنهُ بِإِحسانٍ وَعَدلٍ","فَحِصنُ المُلكِ إِحسانٌ وَعَدلُ",1,"ل",1,0],["وحصنٍ منيع في ذراها قد ارتقى","فأبعد في الجو الفضاء المراقيا",2,"ي",2,0],["وحصّنوه من الأعلى بمشتبك","من الحبال جديل غير منقضب",3,"ب",1,0],["وحصنت القرى طولا وعرضا","بآساد يهيبِّن العرينا",4,"ن",2,0],["وَحِصنٌ تَسامى مِن دُموقو كَأَنَّهُ","مُعَشِّشُ نَسرٍ أَو بِهَذا يُلَقَّبُ",5,"ب",1,0],["وحصدنا من الشموس شموسنا","وحصدنا من البدور بدورا",6,"ر",2,0],["وحصيد زرعي مثل بذري خارج","عني وفيَّ أمانة وصلاحُ",7,"ح",1,0],["وَحُصَّت أَماني المُعتَفينَ بِحَيثُ لا","يُحاذَرُ بَأساءُ الحَياةِ وَلا الفَقرُ",8,"ر",1,0],["وحصدت آمالي فإن","نَ الموتَ أرحمُ منجلا",9,"ل",2,0],["وحصاةُ أناتك لو وُزِنَتْ","أنْسَتْ برجاحتها حَضَنَا",10,"ن",2,0],["وحصداءُ فولاذيّةُ النّسجِ لم تَزَلْ","من اللهذمِ الوقّادِ مطفئةً وقدا",11,"د",2,0],["وحصري ماذا تحتها مِنْ زبالةٍ","فيا كسرَ قلبي عندما تُرفعُ الحصرُ",12,"ر",1,0],["وَحَصداءُ تَزري بِالسِنانِ حَصينَةً","وَوَجهٌ وَقّاحٌ بِالحَديدِ مُقَنَّعُ",13,"ع",1,0],["وَحِصناً تَرتَمي نُوَبُ اللَيالي","هَوالِكَ عَن ذُراهُ أَو تفادى",14,"د",2,0],["وحِصْنُ الصَّعْبِ أذعنَ بعد كبرٍ","وأعلنَ بعد غِلظتِهِ المَتابا",15,"ب",2,0],["وَحَصى الكَثيبِ بِصَفحَتَيهِ كَأَنَّهُ","خَبَثُ الحَديدِ أَطارَهُنَّ الكيرُ",16,"ر",1,0],["وَحَصَلَ الزَوجُ لِضُعفِ حيلَتِه","عَلى نُواحِهِ وَنَتفِ لِحيَتِه",17,"ه",1,0],["وَحَصَرتَ الناسَ مِن كُلِّ عادٍ","بِسُيوفٍ وَقَناً قَد رَوَينا",18,"ن",2,0],["وَحَصُلتُ مِن وَرِقٍ عَلى وَرَقٍ","بيضٍ يَشُقُّ مُتونَها الحِبرُ",19,"ر",1,0],["وحَصَّلْتُ ما أَدركْتُ مِن طُول لِذَّتي","فلم أُلْفِهِ إِلَّا كصَفْقةِ خاسِرِ",20,"ر",1,0],["وَحِصنٍ سَرَّهُ فَعَلاَ مَهيباً","يُجازي القُلَّ بالَحجمِ الكَثيرِ",21,"ر",1,0],["وَحَصْحَصَ حَقُّ الشَّيءِ رَاعَ جَمَالُهُ","وَلَم تَخْفَ عُوْراتٌ بِهِ وَعُيُوبُ",22,"ب",1,0],["وحصنُكِ لا يلينُ له حديدُ","ولو شُهُبُ الدُجَى كانت سهاما",23,"م",2,0],["وحصِّنُوا أرضَكم من كلِّ مغتصبٍ","بكلِّ مدَّرعٍ في الحرب متَّرِسِ",24,"س",1,0],["وحصَّلوا، إنما التحصيلُ في صِغرٍ","نقش على الصخر لا يمحوه ماحيه",25,"ي",2,0],["وحصن همته العليا وقايتنا","ان مس ن نازلات الدهر تعنيت",26,"ت",1,0],["وحصّين تعز بعد ذاك وبعده","حديث الحبيشي والوثوب على البر",27,"ر",1,0],["وحصلت تحت مقالهم","ولى وأدبر بل بطل",28,"ل",1,0],["وَحصن بصحراء الثويّة بيته","أَلا إِنَّما الدنيا متاع يمتعُ",29,"ع",1,0],["وَحُصونَ خَيبَرَ جاءَها لَمّا عَصَت","بِالجَيشِ ذي السَطَواتِ وَالسُلطانِ",30,"ن",1,0],["وَحِصانُهُ بَحرٌ يَموجُ بِسَرجِهِ","بَحرٌ وَيَزأَرُ فَوقَهُ ضِرغامُ",31,"م",1,0],["وَحِصنٌ حَصينٌ لِأَبنائِهِم","وَريفٌ لِإِبلِهِمُ مُخصِبُ",32,"ب",1,0],["وحصل العلم كما ينبغي","ولا تدع فائدةً فائته",33,"ه",1,0],["وَحصحصَ أنّ الحليّ مشغولُ أهله","وَأنّ العواري مستردّ رديدها",34,"د",3,0],["وحصلنَ في أبياتِ شِع","ري كالقصائِر في القصورِ",35,"ر",1,0],["وحصنه في حصن البتولة مريمٍ","عليها سلام اللَه ما أسفر الصبح",36,"ح",1,0],["وَحَصَّلَت في عَقدِها التَبارا","وَثَلَّثَت فَهيَ تَحوزُ النارا",37,"ر",2,0],["وحصانُ الشَّوقِ أرْخيتُ له","حَبْله ، فازداد شوقا وسعى",38,"ع",2,0],["وحصلت منه على لطائف لم يزل","فيما علمت بها سواك بخيلا",39,"ل",2,0],["وحصل مملوكاً وداراً وبغلة","وأسرج مركوباً وسرج بالشمع",40,"ع",1,0],["وَحصرتُ نَفسي بالعفاف عَن الَّتي","تصم الكَريم وَفي العفاف حِصارُ",41,"ر",1,0],["وحصّنتُ عنه دَراءَ السنينَ","فثارَ عليّ من الأشهرِ",42,"ر",1,0],["وحصن قد غدا في الجو","يحكي حنطة تذري",43,"ي",1,0],["وحصافة قرنت بطيب مكاسرٍ","وفصاحة وُصِلَت بطول نجاد",44,"د",1,0],["وحصينةٍ من حسن رأ","يك لا يُقَضُّ صِدارُها",45,"ر",3,0],["وحَصَّ غرابي يا ابنة القومِ أجدلٌ","بصيرٌ بأوكار الشبابِ صَيودُ",46,"د",1,0],["وحصداءُ من نُعماه كلُّ مسدَّدٍ","له حَيَدٌ عن سَردها ونُكوبُ",47,"ب",1,0],["وحصَّنَ صدر اقلبُ أحمدَ تحته","يضيق ذراعُ الدهر وهو رحيبُ",48,"ب",1,0],["وَحَصَلتُ بَعدَهُم عَلى","مَن هُم لِقَلبِ الدَهرِ هَمُّ",49,"م",1,0],["وحصَّنها بعيدان طوال","وزينها بقضبان الكروم",50,"م",1,0],["وحصب الورى يوم تسقى الثرى","سحائب من دمها الهامر",51,"ر",1,0],["وحَصِّل كثيراً منه وهو المُرادُ في","قَليلِ زَمانٍ منكَ إن كنتَ تَفهَمُ",52,"م",1,0],["وحَصيرٍ مِن تُراثٍ","لبَنِي عبدِ المَدانِ",53,"ن",1,0],["وحصّنها وعند اللَّه علمٌ","بأنّك لم تدع فيها عِقالا",54,"ل",2,0],["وحَصَلَّتُ أَسْرَارَ الصَّدِيْقِ بِمُحْرَزٍ","مِنَ الحِفْظِ عِنْدِي مَا لِخَاتَمِهِ فَضُّ",55,"ض",1,0],["وحُصونٍ في رمسَ قامت جِبالاً","شاهقاتٍ تهابهُنَّ النُّسور",56,"ر",1,0],["وحصانها الدر النضيد ودجلة","إما تعاقها ذكاء نضار",57,"ر",1,0],["وَحصّنها بِالعَدل حَتّى لَقد غَدَت","بِها أَيّ شاة لا تَهاب لقا الأُسد",58,"د",1,0],["وَحصَّنت الأَبراجَ مِنها مَدافعٌ","تَسوق إلى المَغرور أَثقَل كلة",59,"ه",1,0],["وحَصَّلَ في التفسير كابنِ عطية","وفي السرد كالدّاني الذي أحْكَمَ السّرْدَا",60,"د",2,0],["وحصون وجيوش عودت","مصر أن تنصر في الحرب العوان",61,"ن",1,0],["وحَصلتِ بالمرمى البعي","دِ وكنتِ بالمرأى القريبِ",62,"ب",1,0],["وَحصنٌ حَصينٌ لا يطالُ نَزيله","مَنيع يَردّ الطّرفَ وَهوَ كَليلُ",63,"ل",1,0],["وَحَصلت بَينَهُما مدافعه","لِأَخذِها وَوَقعت مُنازَعَه",64,"ه",1,0],["وَحَصل الإِشكالُ في القَضيه","وَبِالشُهود تَمَّت البَليّه",65,"ه",1,0],["وَحصَّل الماءَ عَن قَليلٍ","وَالضوء مِن تَحتِهِ تَقلَّب",66,"ب",1,0],["وَحَصلَ الأنسُ العَميمُ لِلبَلَد","وَأَهلها مِن والِدٍ وَما وَلَد",67,"د",1,0],["وحصن البأس بالندى فغدا","أمن الأماني وغالة الغيل",68,"ل",1,0],["وَحَصَلتُ مِن ثِقَةِ الإِلَهِ بِمَأمِنٍ","لَمّا وَثِقتُ بِواثِقِ الأَمراءِ",69,"ا",2,0],["وَحِصنٍ مَنيعٍ قَد صَبَحتُ بِغارَةٍ","وَأَهلِ نَعيمٍ يضربُ الطَّبلَ لاعِبُه",70,"ب",2,0],["وحصون الأسماء معقل أمني","وغيوث الأسماء غيثي لمحلي",71,"ل",2,0],["وحصله فيها كليث غضنفر","أبي أشبل عبل الذراع مديد",72,"د",1,0],["وحصن كفر لاتا وهاب تدانيا","لَنَا، وذُراها للأَنُوقِ به وَكرُ",73,"ر",1,0],["وحصن بسرفود وأنب سهلت","لنَا، واستحالَ العُسرُ، وهو لنَا يُسرُ",73,"ر",1,0],["وحصَّلتَ عِلما من بلادٍ بعيدة","وأتمَمته تجتازُ برّاً على بحر",74,"ر",1,0],["وحصن أرقان والأحواق ضعضعها","وبالمثقب والتينات غادانا",75,"ن",2,0],["وحصدته وكتبته قوت الورى","تحيي النفوس به وتغني البائسا",76,"س",2,0],["وحصةُ العمالِ مضمونةٌ","في جملةِ الأموال تستبعُ",77,"ع",1,0],["وحصِّنّي بالألطافِ في كل شدّةٍ","بسُرعةِ تفريجِ الكروبِ فروّجنا",78,"ن",2,0],["وَحِصنُهُم حِصنٌ مَنِيع","بِهمُو أَلُوذُ إِلَى الشَّفِيع",79,"ع",1,0],["وحُصِّبَتِ الآثامُ عندَ مُحصَّب","وبالخَيف زال الخوفُ عن كلِّ من عنى",80,"ن",2,0],["وحصنِ زياد غودةً السبت نافثَا","سماماً أراك ابن الأراقم أرقما",81,"م",2,1],["وحصبت بالشعب ثم أصعدت","لا تنقضي أنفاسها تصعدا",82,"د",2,0],["وحصَّنَ هذا الحصن منه حُشاشة","بها خوف بطش من سطاك يذيب",83,"ب",1,0],["وَحُصونٍ لَمّا وَرَدَت عَلَيها","أَيقَنَت بِالبَلاءِ تِلكَ الحُصونُ",84,"ن",1,0],["وحَصَلَ الكونُ في حماه","وأحكم العلم والتصرُّفِ",85,"ف",1,0],["وحصن السَّمع إذ تنادي","وخلص القول إذ تنادى",86,"د",2,0],["وحصن عن الفحشا الجوارح كلها","تكن لك في يوم اجزا خير شهد",87,"د",1,0],["وحصنكَ عالٍ يرفُّ عليه","لواءٌ هو الشرفُ الأَمنع",88,"ع",1,0],["وحصنه من عين جن برقية","اعيذنّه كيد الزمان المنكّد",89,"د",1,0],["وحصلنا في نزهتين وفي حسنين","بين المياه والآكام",90,"م",1,0],["وَحَصانٍ كَأَنَّها الشَمسُ حُسناً","كَفَّنَتها الأَطمارُ نَجلاءَ كَحلا",91,"ل",2,0],["وحصرا ولا كالسجن في قوم صالح","وآونة برا وآونة بحرا",92,"ر",2,0],["وحصان تفحَّلت كحصان","أو كفحل عودٍ من البدنِ عيد",93,"د",1,0],["وحصانٍ لم تجد كسر حجابٍ","أبرزت تخفض طرفيها انكسارا",94,"ر",2,0],["وحصّل العلمَ وزنه بالتقى","وسائر الأوقات فيه استغرق",95,"ق",1,0],["وحصونا تندك أثر حصون","واصطدام للخصم يقرع خصمه",96,"م",2,0],["وحصى سواهم من زجاج وأثمد","وحصى حماهم جوهر وعقيق",97,"ق",1,0],["وَحصونَ مصرٍ لا تَهي","رفعتك رافعة العماد",98,"د",1,0],["وحصرُها عن صحيح عدِّ","في مائةٍ كلها شهودُ",99,"د",1,0],["وحصلْنا على نِفاق أجازي","هِ بصبري عليه غصباً ورغْما"