//www.poetsgate.com/ViewPoem.aspx?id=214785",""],[5785,"هواكم يا حياة الروح واجب","https://www.poetsgate.com/ViewPoem.aspx?id=131559",""],[5790,"قدمت عليك يا رب البرايا","https://www.poetsgate.com/ViewPoem.aspx?id=111955",""],[5799,"تبسم فجر الحق وأنجابت الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=124750",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5823,"الحياة سباق","https://www.poetsgate.com/ViewPoem.aspx?id=59136",""],[5823,"أيا موت زر","https://www.poetsgate.com/ViewPoem.aspx?id=59147",""],[5829,"ما الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=191512",""],[5910,"في الدفاع عن السُّنَّة النبوية الشريفة","https://www.poetsgate.com/ViewPoem.aspx?id=206238",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[5956,"نبع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182080",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[5956,"حنينٌ لقرية \"بيت أجنادٍ\" ثم انطفاءُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=207910",""],[6102,"إِفراط ..","https://www.poetsgate.com/ViewPoem.aspx?id=182848",""],[5309,"سنبدع بالفكر النعيم المخلدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573799",""],[242,"سقى ام العلاء وبنت مجد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563801",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[6190,"أتيتُ سهواً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87002&r=&rc=8",""],[3469,"نأتك أُمامة ُ إلا سَؤالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19196&r=&rc=14",""],[5190,"اعذريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78335&r=&rc=48",""]],"verses":[["فَما قَلبي وَإِن جَهِلوا بِقاسٍ","وَلا حِلمي وَإِن قَطَعوا بِهافِ",0,"ف",1,0],["فَما قُربُ مَولى السوءِ إِلّا كَبُعدِهِ","بَلِ البُعدُ خَيرٌ مِن عَدوٍّ تُقارِبُهُ",1,"ب",2,0],["فَما قَبلَ مَن أَهوى طَوى البَدرَ هَودَجٌ","وَلا صانَ ريمَ القَفرِ خِدرٌ مُسَجَّفُ",2,"ف",1,0],["فَما قاتَلوا عَن رَبِّهِم وَرَبيبِهِم","وَلا آذَنوا جاراً فَيَظفَرَ سالِما",3,"م",2,0],["فمَا قَوْلُكُمْ فِي مُصْلِحٍ صُنْعَ رَبِّهِ","وَحِكْمَتُهُ قَوْسٌ وَمَغْزَاهُ أَسْهُمُ",4,"م",1,0],["فَما قُبِلَت بِالرُشدِ مِنهُم رِعايَةٌ","وَلا لِوَلِيٍّ بِالأَمانَةِ دينُ",5,"ن",1,0],["فَمَا قُلنَا لِبَارِق قَد أسَأتُم","وَلاَ قُلنَا لِبَارِقَ أَعتِبُونَا",6,"ن",2,0],["فما قَلُوصٌ تبيت الليلَ مُعْمَلَةً","تُضحي وراكبُها لم يَعْدُ مُمْساها",7,"ه",2,1],["فما قليلٌ قليل ذي كرمٍ","يطيبُ إقلاله وإكثاره",8,"ر",2,0],["فما قلَّل غُرَّامي","ولا كثَّرَ أموالي",9,"ل",2,0],["فَما قادوا الجِيادَ وَلا اِفتَلَوها","وَلا رَكِبوا مُخَيَّسَةَ الرِكابِ",10,"ب",1,0],["فَما قَطَعتُ عَلَيهِ","لَكِن قُطِعتُ عَلَيهِ",11,"ي",2,0],["فَما قَبلَها سَمِعَ العالَمونَ","وَلا عَلِموا مُصحَفاً يُختَصَر",12,"ر",1,0],["فَما قامَ لِلمِرّيخِ شَخصُ عُطارِدٍ","وَلا قُمتُمُ لِلقَومِ عِندَ التَكافُحِ",13,"ح",1,0],["فَما قاتَلَت عَنهُ المَنونَ جُنودُهُ","وَلا دافَعَت أَملاكُهُ وَذَخائِرُه",14,"ر",2,0],["فَما قَطَعَت بِالمُستَميحِ ظُنونَهُ","فَيُكدي وَلا خابَت لَدَيهِ وَسائِلُه",15,"ل",2,0],["فَما قَدرُ ما أَبقى إِذا كانَ مَوضِعي","مِنَ الحُبِّ أَن أَبلى عَلَيهِ وَلا أُبلي",16,"ل",2,0],["فَما قامَ بَعدَ الدارِ قَوّادُ فِتنَةٍ","لِيُشعِلَها إِلّا وَمُروانُ ضارِبُه",17,"ب",2,0],["فَما قُمتَ حَتّى هَمَّ مَن كانَ مُسلِماً","لِيَلبِسَ مُسوَدّاً ثِيابَ الأَعاجِمِ",18,"م",1,0],["فَما قَعَدَ العَبدانِ حَتّى قَرَيتُهُ","حَليباً وَشَحماً مِن ذُرى الشَولِ وارِيا",19,"ي",2,0],["فَما قيلَ فينا بَعدَها مِن مَقالَةٍ","فَما غادَرَت منّا جَديداً لِلاَبَسِ",20,"س",1,0],["فَما قُلُبي فيها لِأَوَّلِ نازِحٍ","وَلا سَمُري فيها لِأَوَّلِ عاضِدِ",21,"د",1,0],["فَما قِدحاكَ لِلباري وَلَيسَت","مُتونُ صَفاكَ مِن نُهَزِ المُرادي",22,"د",2,0],["فَمَا قَيَّدَتْنِي لَفْظَةٌ دُونَ حِكْمةٍ","وَلا غَرَّنِي قَوْلٌ فَمِلْتُ إِلَى الدَّعْوَى",23,"و",2,0],["فَما قَلبُ اِبنِ عَبدِ اللَهِ فيها","بِصاحٍ في الحَياةِ وَلا مُفيقِ",24,"ق",1,0],["فَما قَصَّرَت بي في المَطالِبِ هِمَّةٌ","وَلَكِنَّني أَسعى إِلَيها وَأُحرَمُ",25,"م",1,0],["فَما قَلاني قَبلَها عَشيرُ","إِنّي لأُلحى ثُمَّ لا أَخيرُ",26,"ر",1,0],["فَما قُلتُ مِن لَوعَةٍ","أَلِمّي بِنا يا لَمِ",27,"م",1,0],["فَمَا قُذُفَاتُ الْعِزِّ إِلَّا لِمَاجِدٍ","إِذَا هَمَّ جَلَّى عَزْمُهُ كُلَّ غَاسِقِ",28,"ق",1,0],["فما قتالك بعد الحكم راضية","وما قتالك من لم يرض بالنهر",29,"ر",1,0],["فما قاتلوا ربهم وربيبهم","ولا آذنوا جاراً فيظفرَ سالما",30,"م",2,0],["فَمَا قَاتَلَتْ عَنْهُ المَنَايَا جُنُودُهُ،","وَلاَ دَافَعَتْ أمْلاَكُهُ وَذَخَائِرُهْ",31,"ر",2,0],["فما قبلها سمعَ العالمون","ولا علموا مصحفاً يختضر",32,"ر",1,0],["فما قَولي لكم صبراً ولكن","أقولُ لكم به أجرٌ عظيمُ",33,"م",1,0],["فما قامتْ الشجعانُ إلا وسيفُه","بهاماتهم من مأزق الحرب راكعُ",34,"ع",1,0],["فَما قَلبُ طَودٍ شَامِخٍ مُتَوَقِّعٍ","هِجَائِي إلاَّ دَائِمَ الخَفَقَانِ",35,"ن",1,0],["فَما قَومُنا بِالقَومِ يَغشَونَ ظُلمَنا","وَما نَحنُ فيما ساءَهُم بِخِفافِ",36,"ف",1,0],["فما قُصَّ للنَّسريْن فيه قوادمٌ","ولا رُبِطتْ ساقُ الثريا بأمراسِ",37,"س",1,0],["فما قوى يخاف الفوت فامش دلا","فانت تدرك ما تبغي على مهل",38,"ل",1,0],["فما قلت إلا ما علمت وجوبه","وما يرتضيه الله عند التنافر",39,"ر",1,0],["فما قومي بثعلبة بن سعد","ولا بفزارة الشعرى رقابا",40,"ب",2,0],["فما قيمة أهل العل","م فيهم جفّت بلوطه",41,"ط",2,0],["فَما قطُّ شاهَدنا حِماراً مُسابقاً","جَواداً وَتيساً صارعَ الليثَ وَالنِمرا",42,"ر",2,0],["فما قلب الصغيرِ سوى كتابٍ","تسطرُ في صحائفهِ الخِلالُ",43,"ل",1,0],["فَما قُلتُ إيهٍ بَعدَها لِمُسامِرٍ","مِنَ الناسِ إِلّا قَالَ قَلبِيَ آها",44,"ا",3,0],["فَمَا قَبِلَتْ لَهَا هِبَةً هَوَاناً","لَهَا وَتَقَذُّراً لِعَطَاءِ مُكْدِ",45,"د",1,0],["فما قام منكم بالعدالةِ طارفٌ","كذبتَ وأيمُ الله أنتَ كنودُ",46,"د",1,0],["فما قام منكم بالعدالةِ طارفٌ","ولا سار منكم بالسدادِ تليدُ",47,"د",1,0],["فَما قضى حبّه قَلبي لنيربها","وَلا قَضى نحبه وَذي لواديها",48,"ي",3,0],["فما قطراتُ الطلِّ في كاسِ وردةٍ","يقبِّلُها طيفُ النسيمِ ويَنسَلُّ",49,"ل",1,0],["فَما قَرّ لي دمع وَلا كف مدمع","وَلا طابَ لي عيش وَلا لذ مشرب",50,"ب",1,0],["فما قُمْرِيةٌ ألقى","بها الجزّارُ مذبوحهْ",51,"ه",1,0],["فما قلت من خوفٍ مخاف