 قَصرتْ فيه الجيادُ عن المَدا","ولا نُهْنِهَتْ أسْدُ الرجالِ عن الكَفْحِ",128,"ح",1,0],["فما قبضْنا اللُهى لوْلا مكارمُها","ولا بسَطْنا يَداً لوْلا أيادِيها",129,"ي",3,0],["فما قامَ إلاّ بينَ أيدٍ تُقيمُهُ","كما عطفَتْ ريحُ الصَّبا عودَ ساسَمِ",130,"م",1,0],["فما قال ماضٍ ليس فعلاً مضارعاً","ولا فعل امر عندما الشيءَ يطلب",131,"ب",1,0],["فما قلت إيهٍ بعدها لمسامرٍ","من الناس إلا قلبي أها",132,"ه",2,0],["فما قسّ يقاس به","ولا الأعشى ولا الكندي",133,"د",2,0],["فما قد راقني دهرٌ دَهَتني","بهِ أَرزاؤُهُ فحَطَمنَ رَوقي",134,"ق",2,0],["فَما قَبلَ مَنعاهُ مُصابٌ نُجلُّه","وَإِن جَلَّت الأَرزاءُ كَلّا وَلا بَعدُ",135,"د",1,0],["فما قصَّرتَ عن أَملٍ طَويلٍ","وَما روّضت في اللذاتِ جَمحا",136,"ح",2,0],["فَما قَضى الدَهر لي فيها عَلى وَطر","وَلا اهتدت بي إِلى آمالي السبل",137,"ل",1,0],["فما قلت في إثرِ امرئٍ غاله الردى","مقالَ عبيد إثرَ هُلكِ ابنِ عاصم",138,"م",1,0],["فَما قامَ لي مما أَطلت اختباره","بنصر سِوى صَبري عَفى اللَه عَن صَبري",139,"ر",2,0],["فما قاتلت كفان لا عيب فيهما","بجسم مريض القلب والعضلات",140,"ت",1,0],["فَما قَعَد الأَنامُ عَن المَعالي","لِعَجزِهُم وَحانَ بِها نُهوضي",141,"ض",2,0],["فَما قالَ عَمروٌ إِذ يَجودُ بِنَفسِهِ","لضاربِهِ حَتّى قَضى نَحبَهُ دَعني",142,"ن",2,0],["فما قال يوما لا لراجي نواله","ولا قصر الجدوى بنان له سبط",143,"ط",1,0],["فما قبس في جود وتجويد منطقٍ","به الملك الجهنِيّ والملك الكندي",144,"د",2,0],["فما قمتُ الا والربوع خليةٌ","وليسَ بها من جِيرة الحى سُكان",145,"ن",1,0],["فما قدر الدناء وما بقاها","ضعيف الحال يفنى كالجليد",146,"د",1,0],["فما قَوْلُهُمْ إِلاَّ الضلاَلُ بْنُ فَهْلَلٍ","وما فِعْلُهُمْ الا الخِيانَةُ والفِسْقُ",147,"ق",1,0],["فما قَرَّتْ لما لاقَتْهُ عَيْني","ولكِّني عَلَى مَضَضٍ ثَوَيْتُ",148,"ت",1,0],["فما قبلَه قبلٌ ولا بعدَ بعدِهِ","على خلقِه نعماؤُهُ تتجدَّدُ",149,"د",1,0],["فما قَصْدُنَا شرّاً وتأسيسَ فتنةٍ","وإهراقَ أرواح بماضي البواتر",150,"ر",1,0],["فما قرَّ مذ فارقته في مكانهِ","ولا كانَ إلا طارئاً ضل عن فكري",151,"ر",2,0],["فما قدر ذي الدنيا وما قدر أهلها","وما اللهو بالأولاد أو بالكواعب",152,"ب",1,0],["فَمَا قَاوَم