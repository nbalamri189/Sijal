{"poems":[[55,"ردي مر الورود ولا تعافي","https://www.aldiwan.net/poem29969.html","الوافر"],[44,"لحى الله مولى السوء لا أنت راغب","https://www.aldiwan.net/poem50392.html","الطويل"],[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[0,"ألا قبح الله البراجم كله","https://www.aldiwan.net/poem68.html",""],[95,"رمى الجاهل الباغي فأودى بجاره","https://www.aldiwan.net/poem11367.html","الطويل"],[56,"على الكره ما فارقت أحمد وانطوى","https://www.aldiwan.net/poem27461.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"فما قلوص تبيت الليل معملة","https://www.aldiwan.net/poem7988.html","البسيط"],[53,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[53,"كريم كثرت قدما","https://www.aldiwan.net/poem65895.html","الهزج"],[31,"غدا ابنا وائل ليعاتباني","https://www.aldiwan.net/poem6060.html","الوافر"],[72,"لي صاحب غاب عني","https://www.aldiwan.net/poem42384.html","المجتث"],[87,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[47,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[47,"محل على القاطول أخلق داثره","https://www.aldiwan.net/poem63630.html","الطويل"],[47,"سقى ربعها سح السحاب وهاطله","https://www.aldiwan.net/poem65565.html","الطويل"],[47,"أقم علها أن ترجع القول أو علي","https://www.aldiwan.net/poem65594.html","الطويل"],[30,"إليك من الصمان والرمل أقبلت","https://www.aldiwan.net/poem1293.html",""],[30,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[60,"أيحسب أولاد الجهالة أننا","https://www.aldiwan.net/poem30995.html","الطويل"],[46,"قفوا جددوا من عهدكم بالمعاهد","https://www.aldiwan.net/poem30543.html","الطويل"],[46,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[89,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[33,"أحب لحب عبلة كل صهر","https://www.aldiwan.net/poem42213.html","الطويل"],[35,"كفى حزنا أن الغنى متعذر","https://www.aldiwan.net/poem25821.html","الطويل"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[48,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[0,"ألا قبح الله البراجم كلها","https://www.poetsgate.com/ViewPoem.aspx?id=4790",""],[47,"مَحَلٌّ على القَاطُولِ أخْلَقَ داثِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31192",""],[87,"قِفوا بالقبور نُسائِلْ عُمَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9605&r=&rc=95",""],[132,"مشايخنا مصابكم عظيم","https://www.aldiwan.net/poem50526.html","الوافر"],[132,"إذا ما بدا برق بنعمان لامع","https://www.aldiwan.net/poem50583.html","الطويل"],[136,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[138,"عجبت لحلم يا ابن شيبة عازب","https://www.aldiwan.net/poem21018.html","الطويل"],[146,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[164,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[169,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[190,"نفوس الناس بالشح","https://www.aldiwan.net/poem43661.html","الهزج"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"لكل فتى من الدنيا كمال","https://www.aldiwan.net/poem45676.html","الوافر"],[236,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[241,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[245,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[245,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[256,"سقى دمشق وأياماً مضت فيها","https://www.aldiwan.net/poem1480.html",""],[274,"قد اجتمعت فيك المحاسن يا جمل","https://www.aldiwan.net/poem35426.html","الطويل"],[275,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[302,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[307,"وذي خبر وافي بما لا يقوله","https://www.aldiwan.net/poem58128.html","الطويل"],[353,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[368,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[368,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[381,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[381,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[406,"صرفت عن الكيميا همتي","https://www.aldiwan.net/poem46413.html","المتقارب"],[407,"لا صبر لا صبر على ذا البعاد","https://www.aldiwan.net/poem33937.html","السريع"],[407,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[413,"نظام الدين لا سقيا لخطب","https://www.aldiwan.net/poem32267.html","الوافر"],[420,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[420,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[441,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[443,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[443,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[445,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[461,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[461,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[467,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[480,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[485,"إذا انطبعت مرأى بمرآك تنعكس","https://www.aldiwan.net/poem24459.html","عموديه"],[554,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[554,"قل للألى أطمعوني في وصالهم","https://www.aldiwan.net/poem47743.html","البسيط"],[565,"عفت دار كقلبك بعد سلمى","https://www.aldiwan.net/poem52972.html","الطويل"],[590,"أثابك مولاك المهابة والرضى","https://www.aldiwan.net/poem11505.html","عموديه"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67418","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/15","المتقارب"],[1021,"نأتك أُمامة ُ إلا سَؤالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19196&r=&rc=14",""]],"verses":[["فَما قَلبي وَإِن جَهِلوا بِقاسٍ","وَلا حِلمي وَإِن قَطَعوا بِهافِ",0,"ف",1,0],["فَما قُربُ مَولى السوءِ إِلّا كَبُعدِهِ","بَلِ البُعدُ خَيرٌ مِن عَدوٍّ تُقارِبُهُ",1,"ب",2,0],["فَما قَبلَ مَن أَهوى طَوى البَدرَ هَودَجٌ","وَلا صانَ ريمَ القَفرِ خِدرٌ مُسَجَّفُ",2,"ف",1,0],["فَما قاتَلوا عَن رَبِّهِم وَرَبيبِهِم","وَلا آذَنوا جاراً فَيَظفَرَ سالِما",3,"م",2,0],["فمَا قَوْلُكُمْ فِي مُصْلِحٍ صُنْعَ رَبِّهِ","وَحِكْمَتُهُ قَوْسٌ وَمَغْزَاهُ أَسْهُمُ",4,"م",1,0],["فَما قُبِلَت بِالرُشدِ مِنهُم رِعايَةٌ","وَلا لِوَلِيٍّ بِالأَمانَةِ دينُ",5,"ن",1,0],["فَمَا قُلنَا لِبَارِق قَد أسَأتُم","وَلاَ قُلنَا لِبَارِقَ أَعتِبُونَا",6,"ن",2,0],["فما قَلُوصٌ تبيت الليلَ مُعْمَلَةً","تُضحي وراكبُها لم يَعْدُ مُمْساها",7,"ه",2,1],["فما قليلٌ قليل ذي كرمٍ","يطيبُ إقلاله وإكثاره",8,"ر",2,0],["فما قلَّل غُرَّامي","ولا كثَّرَ أموالي",9,"ل",2,0],["فَما قادوا الجِيادَ وَلا اِفتَلَوها","وَلا رَكِبوا مُخَيَّسَةَ الرِكابِ",10,"ب",1,0],["فَما قَطَعتُ عَلَيهِ","لَكِن قُطِعتُ عَلَيهِ",11,"ي",2,0],["فَما قَبلَها سَمِعَ العالَمونَ","وَلا عَلِموا مُصحَفاً يُختَصَر",12,"ر",1,0],["فَما قامَ لِلمِرّيخِ شَخصُ عُطارِدٍ","وَلا قُمتُمُ لِلقَومِ عِندَ التَكافُحِ",13,"ح",1,0],["فَما قاتَلَت عَنهُ المَنونَ جُنودُهُ","وَلا دافَعَت أَملاكُهُ وَذَخائِرُه",14,"ر",2,0],["فَما قَطَعَت بِالمُستَميحِ ظُنونَهُ","فَيُكدي وَلا خابَت لَدَيهِ وَسائِلُه",15,"ل",2,0],["فَما قَدرُ ما أَبقى إِذا كانَ مَوضِعي","مِنَ الحُبِّ أَن أَبلى عَلَيهِ وَلا أُبلي",16,"ل",2,0],["فَما قامَ بَعدَ الدارِ قَوّادُ فِتنَةٍ","لِيُشعِلَها إِلّا وَمُروانُ ضارِبُه",17,"ب",2,0],["فَما قُمتَ حَتّى هَمَّ مَن كانَ مُسلِماً","لِيَلبِسَ مُسوَدّاً ثِيابَ الأَعاجِمِ",18,"م",1,0],["فَما قَعَدَ العَبدانِ حَتّى قَرَيتُهُ","حَليباً وَشَحماً مِن ذُرى الشَولِ وارِيا",19,"ي",2,0],["فَما قيلَ فينا بَعدَها مِن مَقالَةٍ","فَما غادَرَت منّا جَديداً لِلاَبَسِ",20,"س",1,0],["فَما قُلُبي فيها لِأَوَّلِ نازِحٍ","وَلا سَمُري فيها لِأَوَّلِ عاضِدِ",21,"د",1,0],["فَما قِدحاكَ لِلباري وَلَيسَت","مُتونُ صَفاكَ مِن نُهَزِ المُرادي",22,"د",2,0],["فَمَا قَيَّدَتْنِي لَفْظَةٌ دُونَ حِكْمةٍ","وَلا غَرَّنِي قَوْلٌ فَمِلْتُ إِلَى الدَّعْوَى",23,"و",2,0],["فَما قَلبُ اِبنِ عَبدِ اللَهِ فيها","بِصاحٍ في الحَياةِ وَلا مُفيقِ",24,"ق",1,0],["فَما قَصَّرَت بي في المَطالِبِ هِمَّةٌ","وَلَكِنَّني أَسعى إِلَيها وَأُحرَمُ",25,"م",1,0],["فَما قَلاني قَبلَها عَشيرُ","إِنّي لأُلحى ثُمَّ لا أَخيرُ",26,"ر",1,0],["فَما قُلتُ مِن لَوعَةٍ","أَلِمّي بِنا يا لَمِ",27,"م",1,0],["فَمَا قُذُفَاتُ الْعِزِّ إِلَّا لِمَاجِدٍ","إِذَا هَمَّ جَلَّى عَزْمُهُ كُلَّ غَاسِقِ",28,"ق",1,0],["فما قتالك بعد الحكم راضية","وما قتالك من لم يرض بالنهر",29,"ر",1,0],["فما قاتلوا ربهم وربيبهم","ولا آذنوا جاراً فيظفرَ سالما",30,"م",2,0],["فَمَا قَاتَلَتْ عَنْهُ المَنَايَا جُنُودُهُ،","وَلاَ دَافَعَتْ أمْلاَكُهُ وَذَخَائِرُهْ",31,"ر",2,0],["فما قبلها سمعَ العالمون","ولا علموا مصحفاً يختضر",32,"ر",1,0],["فما قَولي لكم صبراً ولكن","أقولُ لكم به أجرٌ عظيمُ",33,"م",1,0],["فما قامتْ الشجعانُ إلا وسيفُه","بهاماتهم من مأزق الحرب راكعُ",34,"ع",1,0],["فَما قَلبُ طَودٍ شَامِخٍ مُتَوَقِّعٍ","هِجَائِي إلاَّ دَائِمَ الخَفَقَانِ",35,"ن",1,0],["فَما قَومُنا بِالقَومِ يَغشَونَ ظُلمَنا","وَما نَحنُ فيما ساءَهُم بِخِفافِ",36,"ف",1,0],["فما قُصَّ للنَّسريْن فيه قوادمٌ","ولا رُبِطتْ ساقُ الثريا بأمراسِ",37,"س",1,0],["فما قوى يخاف الفوت فامش دلا","فانت تدرك ما تبغي على مهل",38,"ل",1,0],["فما قلت إلا ما علمت وجوبه","وما يرتضيه الله عند التنافر",39,"ر",1,0],["فما قومي بثعلبة بن سعد","ولا بفزارة الشعرى رقابا",40,"ب",2,0],["فما قيمة أهل العل","م فيهم جفّت بلوطه",41,"ط",2,0],["فَما قطُّ شاهَدنا حِماراً مُسابقاً","جَواداً وَتيساً صارعَ الليثَ وَالنِمرا",42,"ر",2,0],["فما قلب الصغيرِ سوى كتابٍ","تسطرُ في صحائفهِ الخِلالُ",43,"ل",1,0],["فَما قُلتُ إيهٍ بَعدَها لِمُسامِرٍ","مِنَ الناسِ إِلّا قَالَ قَلبِيَ آها",44,"ا",3,0],["فَمَا قَبِلَتْ لَهَا هِبَةً هَوَاناً","لَهَا وَتَقَذُّراً لِعَطَاءِ مُكْدِ",45,"د",1,0],["فما قام منكم بالعدالةِ طارفٌ","كذبتَ وأيمُ الله أنتَ كنودُ",46,"د",1,0],["فما قام منكم بالعدالةِ طارفٌ","ولا سار منكم بالسدادِ تليدُ",47,"د",1,0],["فَما قضى حبّه قَلبي لنيربها","وَلا قَضى نحبه وَذي لواديها",48,"ي",3,0],["فما قطراتُ الطلِّ في كاسِ وردةٍ","يقبِّلُها طيفُ النسيمِ ويَنسَلُّ",49,"ل",1,0],["فَما قَرّ لي دمع وَلا كف مدمع","وَلا طابَ لي عيش وَلا لذ مشرب",50,"ب",1,0],["فما قُمْرِيةٌ ألقى","بها الجزّارُ مذبوحهْ",51,"ه",1,0],["فما قلت من خوفٍ مخافةَ أنه","إذا راح من عندي له يتوجه",52,"ه",1,0],["فَما قَضى لِلحَقِّ حَقّاً مَن قَضى","نَحباً بِحُبِّ غَيرِهِ وَالنَفسَ غَر",53,"ر",1,0],["فما قصَّروا بي عن مدىً من كرامةٍ","ولكنّني عن شُكْرِهم أنا قاصر",54,"ر",1,0],["فما قَطْرُه الجاري سوى عَرَقٍ له","تُحَدّرِهُ عن وَجْهِه كفُّ سالت",55,"ت",1,0],["فما قام فيه ناسكٌ وهو ماسكٌ","يدَ اللَه إلّا قاده كفُّ ماسك",56,"ك",1,0],["فما قام حقّاً في المواليد كلِّهم","نبيٌّ له بالفضل قدرُ المُعَمَّد",57,"د",1,0],["فما قُلتُ للبدرِ أنت اللّجين","ولا قلتُ للشمس أنت الذهبْ",58,"ب",1,0],["فما قرأت النحو حباً له","ولا أصول الفقه منا المراد",59,"د",1,0],["فما قَلْعُ هذا الغرس إلا بتوبة","محققة منا ونستغفر الربا",60,"ب",2,0],["فمَا قلبي لسُلوانٍ مُطيعٌ","ولا السّلوان عنك بمستطاعِ",61,"ع",1,0],["فما قلتُ بيتاً في سواك ولا جرى","به قلمي يوماً بمدح ابن آدم",62,"م",1,0],["فما قصَّرْتَ عن تقديم خيرٍ","تُنالُ به المثوبةُ والجزاء",63,"ا",2,0],["فما قضيت به للنفس مأربة","لكنّما زاد جسمي في الهوى سقما",64,"م",2,0],["فما قَصُرَتْ رِماحُكَ عن عَدُوٍّ","ولَوْ أَعْيا بِهِ أَمَدُ التَّنائِي",65,"ا",2,0],["فما قَصَّرَتْ بي عن عُلاكَ شفاعَةٌ","ولا بِكَ عن مِثلي جَزَاءٌ وإَِحسانُ",66,"ن",1,0],["فما قبضت من الطيف الملم بها","إلا كمن قبضت أكفافه الأفقا",67,"ق",2,0],["فما قَرَوْها والقِرَى ميسَّرٌ","إلا المنى مكذوبةً والأملا",68,"ل",2,0],["فما قائل إلا من الماء قولُهُ","ولا فاعلٌ إلا من النار فعلُهُ",69,"ل",2,0],["فما قبضت إلاَّ نفوس عداهمُ","ولا أمسكت غير الظبي والشكائمِ",70,"م",1,0],["فما قالةُ الأشعارِ لو كنتِ حاكماً","لها وأردتِ النصفَ إلا عبيدُها",71,"د",3,0],["فما قامت الأعداد إلا بواحد","ولولاها ما غنت مثاني على أيك",72,"ك",1,0],["فما قُدِّمتُمُ إلّا سَفاهاً","وَلا أُمِّرتُمُ إلّا غِلاطا",73,"ط",2,0],["فما قرعتُ لهمْ باباً لأدخلَهُ","ولا رفعتُ إليهمْ مرّةً راسي",74,"س",2,0],["فما قُلنا طَرابُلُسٌ سَماءٌ","إلى أَنْ أَطلَعَت في الأُفقِ نَجْما",75,"م",2,0],["فما قل من معروف جودك عندكم","يكون كثيراً عندنا لا مقللاًَ",76,"ل",2,0],["فَمَا قُتِلَتْ عَكٌّ وَلَخْمٌ وَحِمْيَرٌ","وَعْيلاَنُ إلاَّ يَوْمَ حَرْبِ عَوَانِ",77,"ن",1,0],["فَما قُلتُ ما نَطَقوا باطِلاً","وَلا كُنتُ أَرهَبُهُ أَن يُقالا",78,"ل",2,0],["فما قلتُ مانطقوا","ولا كنتُ أرهبُه أن يُقالا",79,"ل",2,0]]}