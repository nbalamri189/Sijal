{"poems":[[74,"خليلي والأشواق تروي حديثها","https://www.aldiwan.net/poem19557.html","الطويل"],[74,"إلى م العشق واللائمة","https://www.aldiwan.net/poem19678.html","السريع"],[80,"غريب بأرض المغربين أسير","https://www.aldiwan.net/poem14214.html","الطويل"],[68,"أرسلت في الكؤوس بالمعجزات","https://www.aldiwan.net/poem39185.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[113,"من لإحتراق حشاشة الملهوف","https://www.aldiwan.net/poem16209.html","الكامل"],[208,"في هوى مثل ذا تطيب المعاصي","https://www.aldiwan.net/poem53108.html","الخفيف"],[435,"هبت نسيمات السرور","https://www.aldiwan.net/poem40742.html","مجزوء الكامل"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[449,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48976","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105858","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137949",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60820","الرمل"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123824","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130809",""],[3916,"","https://poetry.dctabudhabi.ae/diwan/poem/122202","المنسرح"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69908","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77030","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72857","الكامل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99116","الخفيف"],[4797,"ليه المسا","https://www.poetsgate.com/ViewPoem.aspx?id=50255",""],[5431,"هدية بعيد الزواج ...","https://www.poetsgate.com/ViewPoem.aspx?id=207439",""]],"verses":[["سبكت بها ودّي فصحّ كأنه","سجايا بني السبكيّ للمتأمّل",0,"ل",1,0],["سبكيَّة التبر سبيكية","أوصافه في المدحِ في اللاّزمهْ",1,"م",2,0],["سَبكيهِ في زاهيه وَالزاهرُ النَدى","وَطُلاّبُهُ وَالعَرفُ ثَمَّ نَكيرُ",2,"ر",1,0],["سَبَكَ الدَهرُ تِبرَها فَتَراءَت","كَسَنا الشَمسِ في الصَفا وَالصِفاتِ",3,"ت",1,0],["سَبَكَت في كلِّ عامٍ وَدقضهُ","فَظباءُ الرَّوضِ يَقرِ منَ الثَّمَر",4,"ر",1,0],["سَبكت مَعانيهِ البَديعة فَأَغتَدي","لِعُلاك حلياً لَم يَنَل بِأُلوف",5,"ف",1,0],["سبك الحسنُ فيه فضَّةَ لونٍ","فأذاب القلوبَ ذوبَ الرصاصِ",6,"ص",1,0],["سبكت لنا في الراح إكس","يراً لتذهيب الكدورِ",7,"ر",1,0],["سَبَكْتُهُ عامِريَّ السِّنْخِ مُنْقَطِعاً","إِلَيْكَ من سائِرِ الآمالِ مُنْقَضِبا",8,"ب",2,0],["سبكناها رصاصا قد","تغلغل في جسومهم",9,"م",1,0],["سبك القريض منضداً فحوى به","حكماً مرصعةً بعِقد جُمان",10,"ن",1,0],["سَبَك الخميلةَ عسجداً ووديلة","لما غدت شمسُ الطهيرةِ نارُهُ",11,"ر",2,0],["سبكتها يد الطبيعة منذ ال","بدءِ سبكاً في قالب الإِتقانش",12,"ن",2,0],["سَبَكَ الرحمنُ من نُوْرِهما","جوهراً في جوهرٍ في جوهرٍ",13,"ر",1,0],["سبكت بنار العتب فضة خدّه","فأذهب اكسير الحيا ذلك السبكا",14,"ك",2,0],["سبك الذل على ابوابها","بلظاه خاتماً من ذهب",15,"ب",1,0],["سبكت صعب الكلام حتى بدا","وما رأينا سواك من سبكه",16,"ك",2,0],["سبكَ المديرُ بِهِ صَفائحَ ما لَها","في الغَربِ ذكر وَهِيَ زاد مسافرِ",17,"ر",1,0],["سَبَكتُ مَعانيها بِأَحسَنَ قالِب","فَصُغتُ بِها عَقدُ الجُمانِ مُنضَدا",18,"د",2,0],["سبَكَ القريض وصاغَهُ حليا له","وبهِ ككفي عن صناعةِ كاسب",19,"ب",1,0],["سبك الشرق منه تبراً مذاباً","لفرند الشعاع فيه بريق",20,"ق",1,0],["سبك مديح ومدح غيرك مسبّه","تقول واذني صوتها تقول لك هات",21,"ت",1,0],["سبك القصيد قلائدا ذهبيّة","فعلت سهام الحاذق الخلّاقِ",22,"ق",1,0]]}