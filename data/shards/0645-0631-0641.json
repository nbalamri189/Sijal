ر والنقد","https://www.poetsgate.com/ViewPoem.aspx?id=85958",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5692,"ياقانصين الصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179109",""],[5722,"النهر الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12693",""],[5848,"مع المحبه لتركي رويع","https://www.poetsgate.com/ViewPoem.aspx?id=48979",""],[5848,"أحد ينام وحط راسه","https://www.poetsgate.com/ViewPoem.aspx?id=48835",""],[6089,"نهر البصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=212970",""],[6142,"ها هو البرقُ مرودٌ من حديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=155683",""],[6355,"يوم الفداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66542&r=&rc=2",""]],"verses":[["مَرَّ فَناجى بِالهَوى طَرفُهُ","طَرفي وَلَم أَنطِق وَلَم يَنطِقِ",0,"ق",1,0],["مَرَّ فِي بَالِنَا فَأَحْيَانَا","كيْفَ لَوْ زَارَنَا وَحَيَّانَا",1,"ن",2,1],["مرفوعة مثل نوء السماك","وأفق غرة شهرلشهر نحيرا",2,"ر",2,0],["مَرفوعَةٌ عَن عُيونِ الناسِ في غُرَفٍ","لا يَطمَعُ الشُمطُ فيها وَالتَنابيلُ",3,"ل",1,0],["مرّ في تلك الظلال لنا","كمرور الحلم في الوسن",4,"ن",1,0],["مَرَّ فَقامَ الناسُ مِن لاعِنٍ","وَقائِلٍ شَوَّهتَ يا عُرَّه",5,"ر",2,0],["مُرَفرِفَةٍ حولَ البيوتِ وفودُها","مُحَلِّقَةٍ حَولَ السُّقوفِ وكورُها",6,"ر",3,0],["مرفوعةٌ حُجْبُه للزائرينَ وهل","للصُّبحِ مزَّقَ جِلبابَ الدُّجى حُجُبُ",7,"ب",1,0],["مُرَفَّهُونَ حِسَانٌ فِي مَجَالِسِهِمْ","وَفِي الْحُرُوبِ إِذَا لاَقَيْتَهُمْ بُهَمُ",8,"م",1,0],["مُرَفَّلَةً يسْحبنَ أذيالَ يُمنَةٍ","ويركُضْنَ ديباجاً وَوَشْياً مَحبَّرا",9,"ر",2,0],["مَرفوعة لخفيّ سمع راحم","مدفوعة مِن قَلبي المَكسور",10,"ر",1,0],["مرّ في وحشتي نعيما وأنسا","ومحا أدمعي رحيما شفيقا",11,"ق",2,0],["مرفرفًا في الجَوِّ بالجنَاح","مُحَلِّقًا في سائر النواحي",12,"ح",2,0],["مرّ في الآباد فاستوقفه","من لييلات شبابي ألف أمس",13,"س",1,0],["مَرُفُوعَةٌ هاماتنا لا نَنْحَنِي","لا نَنْثَنِي بالصَّدِّ خَلْفًا للوَرَاءْ",14,"ا",2,0],["مرّ في طيبةٍ وموسى وعيسى","ولَقد شَرُفت به إيلياءُ",15,"ا",2,0],["مر في الروض ولم تشعر به","وسرى سراً وما أيقظ وسنا",16,"ن",2,0],["مرفوعةً لَكَ فِي العُلا أَعلامُها","لما غَدَتْ بك عافِياً آثارُها",17,"ر",3,0],["مرفوعةَ الأعناقِ ليس لزهوها","معنى الغرور بل السموِّ شِعاراَ",18,"ر",2,0],["مرفرفين على بِرّي وتكرمتي","حتى غدا شعَري في لِمّتي شَمطا",19,"ط",2,0],["مرفرِفين على حقّي بحفظهِمُ","رامين نحوي بأسماعٍ وأبصارِ",20,"ر",1,0],["مرّ فلم يعطِف لحُبِّ الصِّبا ال","جاني ولا حقِّ العلا الواجبِ",21,"ب",1,0],["مر في الطريق فلا ترى دون الفضا","لم ينفتح باب بها أو روشن",22,"ن",1,0],["مرفوعةٌ بعَمُودٍ تحتَ أجنِحةٍ","منَ المَلائكِ رَفَّتْ فوقَ أعلاهُ",23,"ا",2,0],["مر في الركب عليه","بسلام الأنبياءِ",24,"ا",2,0],["مَرَّ فَظَنَ رَأس هَذا حَجَرا","أَلقى عَلَيها السُلحافةَ وَجَرى",25,"ر",2,0],["مر في سبق الكرام على","سابق من جوده أرنِ",26,"ن",1,0],["مُرَفَّعٌ عَنْ شَبِيهٍ فِي خَلاَئِقِهِ","إذْ عَنْهُ قَدْ عَقِمَتْ أرْحَامُ حَوَّاءِ",27,"ا",2,0],["مرفّل زد الخفيف آخرا","قل ولقد سلبته مثابرا",28,"ر",2,0],["مرفوعةً وعليها","مراجلُ الزاد تغلي",29,"ل",2,0],["\"مرفّع القدر\" عزيز الحمى","\"وقد تدانى جوده\" للمنال",30,"ل",1,0],["مَرَّ فيه نَوىً فطار شَعَاعاً","لسناه لما استطار شعاعه",31,"ع",2,0],["مرفوعة فوق الأسرة يتكئ","هو والحبيب بخلوة وأمان",32,"ن",1,0],["مُر فَما في مِصرَ إِلّا طاعَةٌ","لِرَئيسِ الوَفدِ فَخرُ الآمِرين",33,"ن",1,0],["مَرفُوعُ هِمَّةٍ عن اعتماد","مِنّى عليها وكذا استِنادى",34,"د",2,0],["مرَفَّهُ الشأوِ سبّاقُ على مهَلٍ","مستحصدُ الرأيِ لا كهلٌ ولا غمُرُ",35,"ر",1,0],["مُرفعاتٍ لنواحي عالي","وتَهبُطُ للماءِ في السواحلِ",36,"ل",1,0],["مُرٌّ فان أرضيتَه فحلاوةٌ","قَصَعت بذكرك غُلَّةَ الملتاح",37,"ح",1,0],["مر في بيتهم عليه زمان","خاله حقبة من الأحقاب",38,"ب",1,0],["مرفَّهين مدى الأيام في نعمٍ","مستجمعين المنى في الروح والبدن",39,"ن",1,0],["مَرفُوعاً أو مَنصُوباً أو مُرَكبَّاً","وَإن رَفَعتَ أوَّلاًلاَ تَنِصِبَا",40,"ب",2,0],["مرفوع المنصوب يوجدان","في اسم وفعل كيخيب الجاني",41,"ي",1,0],["مَرَّ في رَوضاتِ خَيرٍ رَبا","بِلادَ السادَةِ الغُرُرِ",42,"ر",1,0],["مرفقة أعطيتها فردةً","رُمتُ لها أختاً فلم يَتَّفقْ",43,"ق",1,1],["مرَّ فيه والرَّوضُ زاهٍ فأضحَى","ساحِباً فوقَ نَورهِ أَذيالَه",44,"ل",2,0],["مر فيها النَسيم فاعتلَّ و","البرقُ فولىَّ بقلبه الَخفاق",45,"ق",1,0],["مرّ فأبْدى احمرارُ وجنتِه","من دمِ قلبي هواهُ ما وجَدا",46,"د",2,0],["مرفع القدر يعليه تواضعه","بلطفِه كرمت للوفد أفعال",47,"ل",1,0],["مرفوع قدرٍ بخفض النفس منتصباً","المنف في دهره بالجد والصب",48,"ب",1,0],["مرفئي في بحار حبِّك ناءٍ","وشراعي في لُجِّهنَّ حطامُ",49,"م",1,0],["مرفوض ياللى بعت غيره عشانه","أزريت عن رد الجزا أو تهاونت",50,"ت",1,1],["مرفرفات ٌ هي الرايات ُ أحمدُنا","والأفق ُ يا شمس َ أحباب ِ الهوى رَحِب ُ",51,"ب",1,0],["مَرَّ في أيامِ ذاكرتي","زارعًا في قفرها زَهَرا",52,"ر",2,0],["مرفوض مبدأ نسمعه من كل شاب","مو مشكله كلن يصلح عااازته",53,"ت",2,0],["مر في خاطره الإث","مُ الذي حاول طيه",54,"ي",2,0],["مُرَفرفاتٍ على الأوجاع، داميةً","وأنتَ ترنو إليها مُشفقاً حَدِبا",55,"ب",2,0],["مرفوعة السيقان قبا شمره","تزيد على المنقور يوم الزاد",56,"د",1,0],["مرَّ في الأرض كالربيع ائتلاقاً","وكأيامهِ صفاءً وبشرا",57,"ر",2,0],["مر في بالي البارح كلام وكلام","يعربه من قدر يقراه ويترجمه",58,"م",2,0],["مرفوع هذا العشق من دون ضمّة","مكسور هذا القلب ماله مناعه",59,"ع",2,0],["مرفَّعٌ ، قائدٌ بالْفصْلِ ذُو شَرَفٍ","مثبِّتٌ ، معدنُ الأحكام والقِيَمِ",60,"م",1,0],["مر في محجري نهارٍ وليلٍ","بين أهدابِ ذينِ بيضٍ وسودِ",61,"د",1,0],["مرفوعةٌ فوق الكواكب هامُنا","لم تنحنِ ذلاَّ ولم تبسُطْ يدا",62,"د",2,0]]}