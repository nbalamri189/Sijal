,[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91670","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92024","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206160",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128938","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131060",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131048",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102963","الكامل"],[3943,"","https://poetry.dctabudhabi.ae/diwan/poem/205127","المديد"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146861","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125811","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94818","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73195","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136627",""],[4929,"قوة الإرادة (من وحي صورة )","https://www.poetsgate.com/ViewPoem.aspx?id=201406",""],[4955,"وإذا ابتُليتَ بجاهلٍ متعنِّتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190666",""],[5036,"أنا صائِمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=151402",""],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[5131,"ودَّعتُهُ وعلى فؤادي حسرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175584",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5185,"ودّع جمال","https://www.poetsgate.com/ViewPoem.aspx?id=71966",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5299,"لا تلعبي في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210539",""],[5324,"خطاب ماكرة .","https://www.poetsgate.com/ViewPoem.aspx?id=207638",""],[5376,"بطحاء درعا بالدماء تسيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=199000",""],[5449,"اضحك بقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=196924",""],[5465,"وإذا نطقن تخالهن نواظما","https://www.poetsgate.com/ViewPoem.aspx?id=98440",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5970,"كن مع الناس تر الناس معك","https://www.poetsgate.com/ViewPoem.aspx?id=130589",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[6115,"المجلس اللى فيه غيبه ونمات","https://www.poetsgate.com/ViewPoem.aspx?id=180511",""]],"verses":[["وإذا أبكاني الجوع ولم","تملكي شيئا سوى الوعد الكذّاب",0,"ب",1,0],["وإذا أَبيتَ الشُّكْرَ مِن مُتَقَبِّلٍ","جَدْوَى يديْكَ حَمَيْتَهُ أنْ يفرحا",1,"ح",2,0],["وإذا أبَى المسؤولُ إلّا قولَ لا","للسَّائِلِ اسْتَحْيَيْتَ أن تتنحْنَحَا",1,"ح",2,0],["وإذا آبٍ أباها","قال نيكيه ببظرِكْ",2,"ك",1,0],["وإذا أبو عيسى حَمَى مُتَحرِّماً","أضحى يَحُلُّ بمَعْقِل وعَليِّ",3,"ل",2,0],["واذا ابوا فخذيه","منهم في مكافحة غلابا",4,"ب",2,0],["وَإِذا أَبو الفَضلِ استَعارَ سَجِيَّةً","لِلمَكرُماتِ فَمِن أَبي يَعقوبِ",5,"ب",1,0],["وَاِذا اِبتُليتَ بِبَذلِ وَجهِكَ سائِلاً","فَاِبذُلهُ لِلمُتَكَرِّمِ المِفضالِ",6,"ل",1,0],["وَإِذا اِبنُ آدَمَ حَلَّ في أَكفانِهِ","حَلَّ اِبنُ أُمِّكَ في المَكانِ الشاسِعِ",7,"ع",1,0],["وَإِذا اِبتُليتَ بِبَذلِ وَجهِكَ سائِلاً","فَاِبذُلهُ لِلمُتَكَرِّمِ المِفاضِلِ",8,"ل",1,0],["وَإِذا اِبنُ آدَمَ نالَ رِفعَةَ مَنزِلٍ","قُرِنَ اِبنُ آدَمَ عِندَها بِسِفالِ",9,"ل",1,0],["وإذا ابن آوى مدّ ذات رُنُوِّهِ","كَحَلَتْهُ بابن حَنِيّةٍ مرنانِ",10,"ن",1,0],["وَإِذا أَبوها نائِمٌ وَعَبيدُهُ","مِن حَولِها مِثلُ الجِمالِ الهُرَّجِ",11,"ج",1,0],["وإذا أبَيْتَ فعزمَةٌ مضّاءَة","لا بُدّ أنّ قضاءَها مفعول",12,"ل",1,0],["وإذا أبيْتَ، فَلِي هِجَا","ءٌ، دونهَ سلْخ الجلود",13,"د",1,0],["وإذا أبيت فعزمة مضاءة ...لا بد أن قضاءها مفعول","وليغزونهم الأحق بغزوهم ... والله عنه مايشاء وكيل",14,"ل",1,0],["وَإِذا اِبتليت بِفقد أَهلك وَالحِمى","وَشغلت في قَطع الفلا وَالفدفد",15,"د",1,1],["واذا ابتليت بمشكل فبحكمة","حلل عقود الخبط من اشكاله",16,"ل",2,0],["وإذا أَبَيْتِ فقد أَموتُ، وتَنْدِمي","أَبَدًا، ولكنْ ليسَ بعد الموتِ حَلّْ",17,"ل",1,0],["وإذا أبدى نبيٌّ عبرة","فهو لا ينكر فيمن تبعه",18,"ع",2,0],["وإذا أبيت سوى اقتفا آثاره","ورضيت صحبة أوليا الشيطان",19,"ن",1,0],["وَإِذا اِبتَدَوا بَحثُوا البَذا فَكَأَنَّهُم","دُجَجٌ تَباحَثُ عذرَةً بِفَضاءِ",20,"ا",2,0],["وإذا ابتسمت اليوم من فرح","فلتعبسن ملامح الأبد",21,"د",1,0],["وَإِذا أَبُو الذَّوّادِ حاطَكَ ذائِداً","فَلَقَدْ أَخَذْتَ مِنَ اللَّيالِي مَوْثِقا",22,"ق",2,0],["وإذا أبيتم فابشروا بصواعقٍ","غير الّتي يطفي لظاها الماءُ",23,"ا",2,0],["وَإِذَا ابتدأت بِسَعد جدّك مَطلَباً","كَفَلَت لَكَ الأَقدَارُ بِالإتمَامِ",24,"م",1,0],["وإذا أَبدأوا إليه أَعادوا","صَدَراً ليس يَنْقَضي ووُرودا",25,"د",2,0],["وإذا أبصرَ شيخاً قاصد","ساحَةَ الأقصى ، بعنفٍ سَحَبَهْ",26,"ب",2,0],["وإذا أبتْ نَفسي هَوا","هُ مَعَ الخيانَةِ خَان صَبرِي",27,"ر",2,0],["وإذا أَبصرتُ منه طلعةً","راعني بين جمالٍ وجلال",28,"ل",1,0],["وإذا أَبهم أمرٌ في العُلى","كشفَتْ آراؤه عن كلِّ مبهم",29,"م",1,0],["وإِذا أَبو جُعْرَانَ جاءَ بشعرِهِ","من بَعْرِهِ فاعذِرْهُ في إِفْرَاطِهِ",30,"ط",2,0],["وإذا ابن أيوبٍ جرى فوراءه","وادٍ على الأعداءِ منك يسيلُ",31,"ل",1,0],["وإذا أُبْطِنَ منهم واحِدٌ","في الثَّرى بينَ البَرايا يظهَرُ",32,"ر",1,0],["وإذا ابتدهت بديهة يا سيدي","فأراك عند بديهتي تتقلق",33,"ق",1,1],["وَإِذا اِبتَغى وطناً يقيم بهِ","سحُّ الحَيا فرُباكُمُ الخُضْرُ",34,"ر",1,0],["وإذا أبَيتُ اليومَ صبراً في البِلا","طوعاً صبرتُ غداً وأنفي راغمُ",35,"م",1,0],["وإذا ابتُليتَ بما بهِ نَفَذَ القَضا","فاصبرْ على بلواكَ أو لا تَصبِرِ",36,"ر",1,0],["وإِذا أَبْطأَتْ ركائُب دمْعِي","فأَنيني في حَثِّها كالْحُداءِ",37,"ا",2,0],["وإذا ابتليت بنكسةٍ من حمقهم","فاحذر لنفسك أن تفر وتنكصا",38,"ص",2,0],["وإذا أبهم أمر في العلا","كشفت آراؤه عن كل مبهم",39,"م",1,0],["وإذا أبصروا النار ذات وقيد","إلى عمل كل مرء سعى",40,"ع",2,0],["وإذا أبطرتْ يد غير أهل","منك عادت عليه عتباً شديدا",41,"د",2,0],["وإذا أبو الفضل الكري","م حماك سالمك الحمامُ",42,"م",1,0],["وَإِذا اِبتسمت قلت بدا","لؤلؤٌ في الثغرِ منها منتظم",43,"م",1,0],["وإذا آب إلى الاخر","ى فطوبى ومآب",44,"ب",1,0],["وإذا ابتسمن أريننا شنبَاً","ولمىً به التفليج والظَّلمُ",45,"م",1,0],["وإذا أبو إسحاق زرتُ فناءَه","غادرتُ ثوبَ خصاصتي مرفوضا",46,"ض",2,0],["وإذا ابتسمن تبسموا وإذا دعوا","لبينهم فإذا دعون أجابوا",47,"ب",3,0],["وإذا أبو الطّفل انثنى عجلاً","من شغله للبيت مفتقدا",48,"د",2,0],["وإذا أبرموا النوى فعهودي","محكمات لديهم لا تضيع",49,"ع",1,0],["وَإِذا أَبو الفَتحِ المَهو","لِ أَتى يُهَروِلُ وَهوَ زاعِقِ",50,"ق",1,0],["وإذا أبيت فما لملك","يا ظلوم سوى الدثور",51,"ر",1,0],["وإذا أبراها شرطاً على","أنها تعطيه ألفاً أقرعا",52,"ع",2,0],["واذا أبى الا القطيعة والجفا","ورأى الصواب بغيرنا ابنا",53,"ن",2,0],["واذا ابن النبي هاج لحرب","اخصبت وحشها ورافت فلاها",54,"ا",3,0],["وإذا أبصرته لم أره","وهو ذو شوقٍ عليه يحتوي",55,"و",2,0],["وإذا أبصر عيني","أنني عينُ شُهودِهْ",56,"د",2,0],["وإذا أبى الا اللجاج فقل له","في النار من يحجوهما في النار",57,"ر",1,0],["واذا أبت ذا الشان نفسك فات","همها ثم راجع مطلع الايمان",58,"ن",1,0],["وإذا ابن عمك لجّ بعض لجاجةٍ","فانظر به عدة ولا تستعجل",59,"ل",1,0],["وإذا ابتذلتك يا مصون فكيف بي","بأخٍ أتِيهُ بصونه وبسترِهِ",60,"ر",2,0],["وإذا أبصرتَ مَنارَ هُدا","فإظهر فَرداً فوقَ الشَبجِ",61,"ج",1,0],["وَإِذا أَبو الهادي اِعتصمت بِهِ فَقَد","أَمسيت مِنهُ بضفتي ثَهلان",62,"ن",1,0],["وَإِذا أَبو عَتمان أَنكَر نعمَةً","أَمسى أَبو مرعي عَلَيهِ شَهيدا",63,"د",2,0],["واذا ابت فلانها","لا شك تحتقر العطيه",64,"ي",2,0],["وإذا أبدت في الأرض طلعة نجمه","فسناه في أفق المعالي ناجم",65,"م",1,0],["وإذا أبدين شجواً ونياح","أوجعوهن بأطراف الرماح",66,"ح",1,0],["وإذا ابتغوك جروا إليك بلهفة","مثل النزيف أتيته بالماء",67,"ا",2,0],["وإذا أبت نفس الفتى من علمه","وعظا دعت شيطانها فيسوق",68,"ق",1,0],["وَإِذا أَبصَرت مَنَا رَهُدىً","فاظهَر فَرداً فَوقَ الثَبَجِ",69,"ج",1,0],["وإذا أبو الهاميّ واجه مقصداً","فاجزم بأن اليسر بعد العسر",70,"ر",1,0],["وإذا أبو الإقبال واجه قابلاً","قالت فراسته الصواب قبالي",71,"ل",2,0],["واذا ابتدتْ ومضت بنا في خَطوها","وجُلوسِها حَلَقُ الخليطِ السَّامِرِ",72,"ر",1,0],["وإذا أبطركم إنكم","لم يزل نجم علاكم في صعود",73,"د",1,0],["وإذا ابتدأت عروض نسج ريض","جعلت تذل لما أريد وتسهل",74,"ل",1,0],["وَإِذا أَبو عمرو عَددتَ فِعالَهُ","نفدَ الكَلامُ وَفَضلُهُ لا يَنفَدُ",75,"د",1,1],["وَإِذا أَبو حَفصٍ ذَكَرت فَمَرحَباً","بِالصالِحين فَذاكَ جَمعٌ مفرَدُ",76,"د",1,1],["وَإِذا اِبتُليتَ بِعُسرَةٍ فاِصبر لَها","فالعُسرُ فَردٌ بَعدَهُ يُسرانِ",77,"ن",1,0],["واذا ابانَ لك العدوُّ بَشاشةً","فأَحذَر ولا يَخدَعكَ منهُ تبسُّمُ",78,"م",1,0],["وإذا أبصرت ذا شجو فقل","مات من كان به مستأسرا",79,"ر",2,0],["واذا أَبنتَ الصدرَ قُل أَرضٌ وَلا","تخفى عليك فثمَّ بَحرٌ فيه حَبّ",80,"ب",1,0],["وَإِذا أَبيتَ تسليّاً عنهم فقم","نَشكو النَوى بَعدَ الهَوى للوحدة",81,"ه",1,0],["وَإِذا أبكيتنا هنِّئ بِهِ","جَنةً فازَت بشهمٍ وافد",82,"د",1,0],["وإذا ابتكرتِ فقلدي","نغم الأسى والشجو فينا",83,"ن",2,0],["وإذا أبرم أمراً لم يكد","رأيه يخطي القضا والقدرا",84,"ر",2,0],["واذا أبو سرحان يقفز فوقه","فقضى عليه بموتة شنعاء",85,"ا",2,0],["وإذا أبوا أن ينطقوا بثنا","فلكل طرس مقول وفم",86,"م",1,0],["وإذا ابتسمن فربّ برق بعده","تأتي الصواعق ملؤها آلام",87,"م",1,0],["وَإِذَا أبْدى اعْتِذَاراً ظَالِمٌ","لَمْ يَدَعْ لِلَّوْمِ وَالعَتْبِ مَحَلْ",88,"ل",1,0],["وإذا أبى فعلي قلب نجاحه","بخسارة وصلاحه بفساد",89,"د",1,0],["وإذا أبصرت في الروض شيئاً","مثله في الحسن فارجع عليا",90,"ي",2,0],["وإذا ابن عزم لم يقم متجرداً","للحادثات فصارم في غمده",91,"د",2,0],["وإذا ابنُ هذا العصر جاء مفاخرا","بعلاه فاخرناه بالأَجداد",92,"د",1,0],["وإذا أبتغيتَ الأكلَ جادَ بروحهِ","ليفوز من فمكَ الظريف بقبلةِ",93,"ه",1,0],["وَإِذا اِبتَسَمنَ جَلَونَ عَن بَرَدٍ","عَذبٍ كَأَنَّ الراحَ مَكرَعُهُ",94,"ع",2,0],["وإذا أبو يحيى تعاجَلَ والحيا","أزْرَتْ أناملهُ بِنَوْءِ المِزْرَم",95,"م",1,0],["وإذا ابتسامُ البرقِ حركَ ساكِناً","في القَلبِ حُركتُم بكُلِّ تَبَّسُمِ",96,"م",1,0],["واذا أبيت سوى الصبابة والهوى","فاكُتم هواك ولا أخالَك تكتم",97,"م",1,0],["وإذا ابنُ آدمَ لم يثق في تفسه","كلُّ الدروبِ أمامَهُ تَتعَسَّرُ",98,"ر",1,0],["وإذا ابتُليتَ بجاهلٍ متعنِّتٍ","فاجعل سكُوتَكَ في النِّقاشِ سبيلا",99,"ل",2,1],["وإذا ابتُليتَ ، وكنتَ فيهم قاضيا","فاحكُم كما تهوَى ، لأنك صائِمُ",100,"م",1,0],["وإذا ابتسمت فبارقٌ متلألئ","بالنور يفتح أعين العميان",101,"ن",1,0],["وإذا أبينا الذلَّ دون إبائنا","وطنٌ تولاه الدخيلُ فسيطرا)",102,"ر",2,0],["وإذا أبيت فانه الداء الذي","يزجيه غراً وأخو تغرير",103,"ر",1,0],["وإذا ابتسمت أضفت نورا مبهراً","ماذا تخبيء كنت في التكوين؟",104,"ن",1,0],["وإذَا ابتَسَمتُ مُوَاسِيًا جُرحِي .. هَمَى","دَمعِي .. عَلَى خَدّي فضِقتُ تَوَجُّعَا",105,"ع",2,0],["وإذا أبيتِ ستشهدين حرائقي","وزلازلي كي تَقبَلي كي تقنَعي",106,"ع",2,0],["وإذا أبيت فللفراقِ طريقه....","أن كنت ترضى أن أعيش بلاكا",107,"ك",2,0],["وإذا ابتليت فقمْ لربك ساجدا","فالوجه في نعمى الاله أسيلُ",108,"ل",1,0],["وإذا ابتسمتَ لعاشقينِ على الطَّريقِ","تكونُ قد خالفتَ أنظمةَ البَّكاءْ",109,"ا",2,0],["وإذا ابتسمن فأنهن غمامة","أو أقحوان الرمل بات معينا",110,"ن",2,0],["واذا ابيت فانت لست بصادق","في ودنا يا مدعي لوداد",111,"د",1,0],["وإذا أبكاك دهر غادر","مسحوا عنك جميعاً أدمعك",112,"ك",1,0],["وإذا ابتعدتَ.. فما ابتعدتَ","..فإنَّ في جنبيَّّّ مهدَكْْ",113,"ك",1,0],["واذا ابتلاك الله ببعض العلاقات","خلك ذهين أحذر رفيق المشاريه",114,"ي",2,0]]}