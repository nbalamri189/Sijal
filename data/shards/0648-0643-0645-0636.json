{"poems":[[79,"وأبيض من ذوي الأشجار يبدو","https://www.aldiwan.net/poem36761.html","الوافر"],[75,"أصخ لمقالتي واسمع","https://www.aldiwan.net/poem11966.html","مجزوء الوافر"],[94,"يا قلب كم فيك من دنا محجبة","https://www.aldiwan.net/poem38914.html","البسيط"],[58,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[63,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[71,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[48,"إنا معاشر هذا الخلق في سفه","https://www.aldiwan.net/poem22978.html","البسيط"],[108,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[79,"وأبيضَ من بني الأشجارِ يبدو","https://www.poetsgate.com/ViewPoem.aspx?id=33303",""],[119,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[136,"بذات الدخن أدورة بوال","https://www.aldiwan.net/poem54764.html","الوافر"],[182,"عين سين","https://www.aldiwan.net/poem50696.html","الوافر"],[190,"سلني عن الدهر وأخباره","https://www.aldiwan.net/poem43830.html","السريع"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[246,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[246,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[376,"هو اليأس إلا من حديث مقوت","https://www.aldiwan.net/poem57517.html","الطويل"],[396,"إليك المعذرة يا عالم الحال","https://www.aldiwan.net/poem54546.html","عموديه"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[466,"أداري المرء ذا خلق نكير","https://www.aldiwan.net/poem15478.html","الوافر"],[520,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[556,"أقول لصحبي وقد هوموا","https://www.aldiwan.net/poem47189.html","المتقارب"],[557,"في رحاب الحب","https://www.aldiwan.net/poem24828.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122722","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86670","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64694","المجتث"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77212","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93657","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70353","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100262","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200635","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74185","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74177","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123938","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91840","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85203","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85264","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131267",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133261","البسيط"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103573","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72957","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139642",""],[5002,"حبٌّ ودمعه.....","https://www.poetsgate.com/ViewPoem.aspx?id=204713",""],[5174,"ضادٌ تُعطرُ روح الكون..","https://www.poetsgate.com/ViewPoem.aspx?id=184996",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5497,"قد توقد لاهبه","https://www.poetsgate.com/ViewPoem.aspx?id=205951",""],[5616,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=203333",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[5948,"قُل للأميرِ الذي يرجو نوافَله","https://www.poetsgate.com/ViewPoem.aspx?id=100580",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""],[5190,"في رثاء النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85067&r=&rc=142",""]],"verses":[["وَكَمْ ضَرْبٍ يُقَاسِي كُلَّ يَوْمٍ","إِذَا ضُرِبَتْ عَلَى قَوْمٍ ضَرِيبَهْ",0,"ب",2,0],["وَكَم ضَرَّ اِمرِأً أَمرٌ","تَوَهَّمَ أَنَّهُ يَنفَع",1,"ع",1,0],["وَكَمْ ضَفَرْتَ أَكاليلاً مورَّدَةً","طارتْ بها زَعْزَعٌ تدوي وتَحْتَدِمُ",2,"م",1,0],["وكَمْ ضَرْبَةٍ واصَلَتْ كَفّهُ","لِفَيْصَلِهِ فاحْتَوى الفَيْصَلُ",3,"ل",1,0],["وكم ضربتُ بماضٍ منه ذي شُطَبٍ","عَضْبٍ مضَارِبُه حلوٍ ضَرائبُه",4,"ب",2,0],["وكم ضَحْوَةٍ كلفْتُه ردَّ لهفةٍ","فغابَ ووافاني وقدْ أذَّنَ العصرُ",5,"ر",1,0],["وَكَم ضَحِكتُ إِلَيها وَهِيَ عابِسَةٌ","ثُمَّ اِفتَكَرتُ فَزالَ الحُبُّ وَالكَلَفُ",6,"ف",1,0],["وكم ضاق الجمالُ بطالبيه","وأُوذيَ بالتَّجمل والخضاب!",7,"ب",1,0],["وكم ضربٍ يقاسي كلَّ يومٍ","إذا ضربت على قومٍ ضربيَة",8,"ب",3,0],["وكم ضعيف به أحواله انتهضت","إلى المعالي واتجاه من النقم",9,"م",1,0],["وكَم ضَرَبُوا إِذَا الأُرَبَى أَلَمَّت","لِوَصلِ الرُّودِ أكبَادَ الجِمَالِ",10,"ل",1,0],["وكم ضاقت على نفسي رِحابٌ","فأطلقتُ الدّعاءَ لكيْ يقيني",11,"ن",2,0],["وكم ضعيف جاهل عاجز","أديل باليسر على فقره",12,"ر",2,0],["وَكَم ضلَّ رَأياً مِن سَقامةِ فهمهِ","بِأمرٍ صحيحٍ مِن شَريعتنا الغرّا",13,"ر",2,0],["وكم ضَمَّ بطنُ البحرِ أشلاءَ جمَّةً","تروجُ بما فيه الخراب يزيدُ",14,"د",1,0],["وكم ضمّ بطنُ البحر أشلاءَ جمةً","تمزِّقُ أحشاءً لها وكُبُودُ",15,"د",1,0],["وكم ضامر الأَحشاء يطوي نهاره","بحر هجير ماتهنا بشربة",16,"ه",1,0],["وَكَم ضَرَبتَ بِسَيفٍ مالَهُ قَرَبٌ","كَما زَحَفتَ بِجَيشٍ ما لَهُ لَجَبُ",17,"ب",1,0],["وكم ضَمنت عنه تباشيرُ وجههِ","نجاحاً لراجيه فوفَّت وأوفَتِ",18,"ت",1,0],["وكم ضر أزاح بمحض فضل","وأشيالم تكن تخطر على البال",19,"ل",1,0],["وكَمْ ضَرَبُوا بِقِداحِ الحُنُوِّ","عَلَيَّ ففازُوا بِقِسْمٍ سَوَاءِ",20,"ا",2,0],["وكم ضَمَّ ذَاكَ اللَّيْلُ مِنْ أُمِّ شادِنٍ","أَضَلَّتْهُ فِي جَوْفِ الفَلا وأَضَلَّها",21,"ل",3,0],["وكم ضَحِكٍ كتمتُ به دُموعاً","ليسلمَ عندَه سِري وعقْلي",22,"ل",2,0],["وكم ضاع تدبير الفتى وهو حازم","ومالت به الآمال وهو لبيب",23,"ب",1,0],["وكم ضِيمَ وسْطَ مغانِيهِمُ","فتىً قبل حبّهِمُ لم يُضَمْ",24,"م",1,0],["وكم ضمتك عيناي اشتياقا","وكم حملتك في شوق ذراعي",25,"ع",2,0],["وَكَم ضاحِكٍ يُخفِى بَينَ الضُّلُوع","مِِن بُغضِهِ لَكَ داءً عَضالا",26,"ل",2,0],["وَكَم ضاعَت الأَلغام جَهلاً وَباطِلاً","لطُغيان هَذا الماء مِن قبل ثورة",27,"ه",1,0],["وكم ضللت لعطف الزهو معتنقا","كم اغتديت لكاس الغي مرتشقا",28,"ق",2,0],["وَكْم ضَرَبْتَ عَلَيْها","مِنْ حَلْقَةٍ بِالمقانِبْ",29,"ب",1,0],["وكم ضموا لعنق غل صدر","وجونس قلب منحتهم بمحنه",30,"ن",2,0],["وَكَم ضَجَّت سَفينٌ بِالمَخازي","وَيَأبى النيلُ إِلّا أَن تَسيرا",31,"ر",2,0],["وَكَم ضيقت فيهِ الفَضا مِنكَ نَقمة","فَباتَ وَلم يؤيسه حلمك أَن تَعفو",32,"ف",2,0],["وكم ضاحكٍ لك أَحشاؤه","تمَنَّاك أَن لو لَقِيتَ الحماما",33,"م",2,0],["وكم ضرةً روعاء منهم لأروعٍ","إذا أنكرتها الشوس تعرف بالقدّ",34,"د",1,0],["وكم ضحكٍ يثير أسىً وحزناً","كما ضحكتْ صبايا الثاكلينا",35,"ن",2,0],["وكم ضمت عقارب من وشاة","بألسنةٍ لوادغَ للقلوب",36,"ب",1,0],["وَكَم ضَمها لِلصَدر مِنهُ إِشارة","إِلى أَنَّهُم للعالمين صُدور",37,"ر",1,0],["وَكَم ضَيغم ألجمته السَيف مصلتاً","فَأَصبح مِن فَوق التُراب يَميل",38,"ل",1,0],["وكم ضاع أبيض حظ على","سواد الشعور وسود الحدق",39,"ق",1,0],["وكَم ضاقَ صَدرٌ من معانٍ ضُئيلةٍ","أَبانَ خوافيا بما هُوَ شارحُ",40,"ح",1,0],["وَكَم ضَيغمٍ أَدناه هينٌ إِلى الفَنا","فَأَضحى عَلى عزِّ المَكان ذَليلا",41,"ل",2,0],["وكم ضربة من سيف ساجي عيونهم","بقلبي عنا شهد لها ومدام",42,"م",1,0],["وكم ضيف يرون لديه ثاوٍ","ونار للقرى فوق القلالي",43,"ل",2,0],["وكم ضاقت الدنيا بأهل خصاصةٍ","فكان لهم في أرضنا المنزل الرحب",44,"ب",1,0],["وكم ضربتَ بسيفِ الحق في عنُقٍ","وكم هدمت لجيش الكفر من أطم",45,"م",1,0],["وكم ضمَّ ظهرُ الأرض منكم وبطنها","بدور دجى من كل أشوسٍ حازم",46,"م",1,0],["وكم ضاقت عليه الأرض فيها","بما رحبت ومن لك بالطريدِ",47,"د",1,0],["وكم ضارع فيه من الله طالب","نجاحاً به نال الأماني واُسعدا",48,"د",2,0],["وكمْ ضاَدَّني شرْعُ النَّوىَ في الهوَى وكمْ","رَسَا بي الأسَى والوَجدُ في قدْ تَفرَّعا",49,"ع",2,0],["وكم ضممت لحضن الشعر ألثمه","حتى تعانقني في الروحٍ أفكارُ",50,"ر",1,0],["وكم ضحكت لقارئها العجوز53","كما افتخرت براهبها العجوز54",51,"ز",1,0],["وكم ضحكت بوجهك من قريب","وكم طعنتك غدرا من وراء",52,"ا",2,0],["وكم ضلت النجوى قلوبا لزيفها","وكم بالأذى تفتي بجهلٍ عمائمُ",53,"م",1,0],["وكم ضُيعتْ أرواح شعب مسالم","فجهلٌ كحد السيف للحق قاصمُ",53,"م",1,0],["وكم ضمّ في جنح الظلام بصدره","لظىً من حنينٍ قد توقّد لاهبهْ",54,"ب",2,0],["وكم ضحكت عليّ نجوم رأسي","وقالت كيف حالك يا همامُ؟",55,"م",1,0],["وَكَمْ ضَيَّعْتَ فِي الأَسْرِ السْ","سِنِينَ وَهَا هِيَ الْعُمْرُ!",56,"ر",1,0],["وكم ضمّت شهيدا في ثراها","وتحت ترابها يحلو الرقادُ",57,"د",1,0],["وكم ضمَّت لحود الأرض ضدّاً","وحاشا النبت أن ينسى جذوره",58,"ر",2,0],["وكم ضَريكٍ أجاءته شقاوتَهُ","إليكَ إذ أنشَبتْ ضَّراؤها نَابا",59,"ب",2,0],["وكم ضحى وكم صبرا","وعند الخالق ادَّخرا",60,"ر",2,0],["وَ كَمْ ضَرَبَتْ جَمَاجِمَنَا شُمُوسٌ","وَ رَعَّبَنَا ظَلَامٌ مُسْتَكِينُ",61,"ن",1,0],["وكم ضاقت الدنيا عليهِ ، فلم يكن","..إذا اشتدت البلوى.. سوى جلمدٍ صخرِ",62,"ر",1,0]]}