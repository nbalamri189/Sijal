{"poems":[[77,"وأبيض من ذوي الأشجار يبدو","https://www.aldiwan.net/poem36761.html","الوافر"],[73,"أصخ لمقالتي واسمع","https://www.aldiwan.net/poem11966.html","مجزوء الوافر"],[92,"يا قلب كم فيك من دنا محجبة","https://www.aldiwan.net/poem38914.html","البسيط"],[56,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[61,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[46,"إنا معاشر هذا الخلق في سفه","https://www.aldiwan.net/poem22978.html","البسيط"],[106,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[77,"وأبيضَ من بني الأشجارِ يبدو","https://www.poetsgate.com/ViewPoem.aspx?id=33303",""],[116,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[133,"بذات الدخن أدورة بوال","https://www.aldiwan.net/poem54764.html","الوافر"],[179,"عين سين","https://www.aldiwan.net/poem50696.html","الوافر"],[187,"سلني عن الدهر وأخباره","https://www.aldiwan.net/poem43830.html","السريع"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[242,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[242,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[305,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[367,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[372,"هو اليأس إلا من حديث مقوت","https://www.aldiwan.net/poem57517.html","الطويل"],[392,"إليك المعذرة يا عالم الحال","https://www.aldiwan.net/poem54546.html","عموديه"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[440,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[462,"أداري المرء ذا خلق نكير","https://www.aldiwan.net/poem15478.html","الوافر"],[516,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[552,"أقول لصحبي وقد هوموا","https://www.aldiwan.net/poem47189.html","المتقارب"],[553,"في رحاب الحب","https://www.aldiwan.net/poem24828.html","عموديه"]],"verses":[["وَكَمْ ضَرْبٍ يُقَاسِي كُلَّ يَوْمٍ","إِذَا ضُرِبَتْ عَلَى قَوْمٍ ضَرِيبَهْ",0,"ب",2,0],["وَكَم ضَرَّ اِمرِأً أَمرٌ","تَوَهَّمَ أَنَّهُ يَنفَع",1,"ع",1,0],["وَكَمْ ضَفَرْتَ أَكاليلاً مورَّدَةً","طارتْ بها زَعْزَعٌ تدوي وتَحْتَدِمُ",2,"م",1,0],["وكَمْ ضَرْبَةٍ واصَلَتْ كَفّهُ","لِفَيْصَلِهِ فاحْتَوى الفَيْصَلُ",3,"ل",1,0],["وكم ضربتُ بماضٍ منه ذي شُطَبٍ","عَضْبٍ مضَارِبُه حلوٍ ضَرائبُه",4,"ب",2,0],["وكم ضَحْوَةٍ كلفْتُه ردَّ لهفةٍ","فغابَ ووافاني وقدْ أذَّنَ العصرُ",5,"ر",1,0],["وَكَم ضَحِكتُ إِلَيها وَهِيَ عابِسَةٌ","ثُمَّ اِفتَكَرتُ فَزالَ الحُبُّ وَالكَلَفُ",6,"ف",1,0],["وكم ضاق الجمالُ بطالبيه","وأُوذيَ بالتَّجمل والخضاب!",7,"ب",1,0],["وكم ضربٍ يقاسي كلَّ يومٍ","إذا ضربت على قومٍ ضربيَة",8,"ب",3,0],["وكم ضعيف به أحواله انتهضت","إلى المعالي واتجاه من النقم",9,"م",1,0],["وكَم ضَرَبُوا إِذَا الأُرَبَى أَلَمَّت","لِوَصلِ الرُّودِ أكبَادَ الجِمَالِ",10,"ل",1,0],["وكم ضاقت على نفسي رِحابٌ","فأطلقتُ الدّعاءَ لكيْ يقيني",11,"ن",2,0],["وكم ضعيف جاهل عاجز","أديل باليسر على فقره",12,"ر",2,0],["وَكَم ضلَّ رَأياً مِن سَقامةِ فهمهِ","بِأمرٍ صحيحٍ مِن شَريعتنا الغرّا",13,"ر",2,0],["وكم ضَمَّ بطنُ البحرِ أشلاءَ جمَّةً","تروجُ بما فيه الخراب يزيدُ",14,"د",1,0],["وكم ضمّ بطنُ البحر أشلاءَ جمةً","تمزِّقُ أحشاءً لها وكُبُودُ",15,"د",1,0],["وكم ضامر الأَحشاء يطوي نهاره","بحر هجير ماتهنا بشربة",16,"ه",1,0],["وَكَم ضَرَبتَ بِسَيفٍ مالَهُ قَرَبٌ","كَما زَحَفتَ بِجَيشٍ ما لَهُ لَجَبُ",17,"ب",1,0],["وكم ضَمنت عنه تباشيرُ وجههِ","نجاحاً لراجيه فوفَّت وأوفَتِ",18,"ت",1,0],["وكم ضر أزاح بمحض فضل","وأشيالم تكن تخطر على البال",19,"ل",1,0],["وكَمْ ضَرَبُوا بِقِداحِ الحُنُوِّ","عَلَيَّ ففازُوا بِقِسْمٍ سَوَاءِ",20,"ا",2,0],["وكم ضَمَّ ذَاكَ اللَّيْلُ مِنْ أُمِّ شادِنٍ","أَضَلَّتْهُ فِي جَوْفِ الفَلا وأَضَلَّها",21,"ل",3,0],["وكم ضَحِكٍ كتمتُ به دُموعاً","ليسلمَ عندَه سِري وعقْلي",22,"ل",2,0],["وكم ضاع تدبير الفتى وهو حازم","ومالت به الآمال وهو لبيب",23,"ب",1,0],["وكم ضِيمَ وسْطَ مغانِيهِمُ","فتىً قبل حبّهِمُ لم يُضَمْ",24,"م",1,0],["وكم ضمتك عيناي اشتياقا","وكم حملتك في شوق ذراعي",25,"ع",2,0]]}