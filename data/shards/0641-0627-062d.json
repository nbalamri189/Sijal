https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72204","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9968","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42511","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42498","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2232","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199502","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43723","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54222","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[77,"جاءتك تعرف بالشميم سراها","https://www.poetsgate.com/ViewPoem.aspx?id=34148",""],[77,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[96,"إمرأة وشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17498",""],[13,"إنَّ بِالْشِّعْبِ الَّذِي دُونَ سَلْعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180818",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"على مجلسي","https://www.poetsgate.com/ViewPoem.aspx?id=179010",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[45,"أبلغْ أبا حَسَنٍ بآيَةِ جُودِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31786",""],[45,"وَجَدْتُ وَعْدَكَ زُوراً في مُزَوَّرَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31634",""],[45,"فَأَحْسَنُ ما قالَ امْرؤٌ فِيكَ دَعْوَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=32024",""],[91,"أيا نيل","https://www.poetsgate.com/ViewPoem.aspx?id=53039",""],[91,"ابسمي","https://www.poetsgate.com/ViewPoem.aspx?id=53427",""],[91,"لقاء وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=53392",""],[46,"الصّدرُ بيتٌ، إذا ما السرُّ زايلَهُ،","https://www.poetsgate.com/ViewPoem.aspx?id=18533",""],[35,"أشاقكَ برقٌ آخرَ الليلِ واصبُ","https://www.poetsgate.com/ViewPoem.aspx?id=21913",""],[51,"ناشدتُك اللَّه في قَدري ومنزلتي","https://www.poetsgate.com/ViewPoem.aspx?id=27260",""],[32,"لقد اورثت قلبي وكان مصححا","https://www.poetsgate.com/ViewPoem.aspx?id=107",""],[101,"هَجَرَتنا وهَجَرْنا زَيْنَبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62437&r=&rc=29",""],[3,"يا صاحبي لا تَبْكِ رَبعاً قد خلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10744&r=&rc=98",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["فَاِحذَر عَواقِبَ ما جَنَيتَ فَرُبَّما","رَمَتِ الجِنايَةُ عُرضَ قَلبِ الجاني",0,"ي",1,0],["فَاِحذَر مَرامِيَ الأَقدارِ عَن مَلِكٍ","ما أَمَرَ الدَهرُ فَهوَ مُمتَثَلُ",1,"ل",1,0],["فَأَحجَمَ عَنها هائِباً نَزَواتِها","وَطارَ عَليها الشَحشَحانُ المُخاطِرُ",2,"ر",1,0],["فأحْداقُهُنَّ تَرُشُّ الدّموعَ","وأنْفاسُهُنَّ تَقُدُّ الوَضينا",3,"ن",2,0],["فأحْجَموا عنهُ والأقدامُ ناكصَةٌ","وللأمورِ إذا أخلَقْنَ تَجديدُ",4,"د",1,0],["فأحلم أن الجنين","وليد بلا مرضع",5,"ع",1,0],["فَاِحذَر فَزارَةَ قَبلَ تَطلُبُ ثَأرَه","وَتُريكَ يَوماً نارُهُ لا تُصطَلى",6,"ل",2,0],["فَأَحيي فَتىً قَد ماتَ هَمّاً وَكَفِّرِي","يَمينَكِ إِن كانَت عَلَيكِ يَمينُ",7,"ن",1,0],["فَإِحداهُما كَأسُ هَجرِ الحَبيبِ","وَكَأسُ الفِراقِ هيَ الصَيلَمُ",8,"م",1,0],["فَاحْمَرَّ خَدُّ الْوَرْدِ بَيْنَ أَبَاطِحِ","وَافْتَرَّ ثغرُ الزَّهْرِ بِيْنَ غُصُونِ",9,"ن",1,0],["فَاحْذَرْ صَغِيرَ الأَمْرِ وَلْتَحْفِلْ بِهِ","وَإِذَا غَفَلْتَ فَإِنَّهُ يُسْتَفْحَلُ",10,"ل",1,0],["فاحتَلتَ حينَ صَرَمتَني","وَالمَرءُ يَعجِزُ لا المَحالَه",11,"ل",2,0],["فَاِحجُبوا الشَمسَ وَاِحبِسوا الرَوحَ عَنّا","وَاِمنَعونا طَعامَنا وَالشَرابا",12,"ب",2,0],["فَاِحذَر عَلى التَختِ أَن يَسري الخَرابُ لَهُ","فَتَختُ سُلطانَةٍ أَعدى مِنَ الجَرَبِ",13,"ب",1,0],["فَأَحيَت بِنَفسِيَ ذِكرى الشَبابِ","وَما كانَ مِنها وَمِنهُ اِنطَوى",14,"ا",1,0],["فَاِحذَر سِياسَتَهُم وَكُن في يَقظَةٍ","سَعدِيَّةٍ إِنَّ السِياسَةَ غولُ",15,"ل",1,0],["فَأَحضَرتُها خَضراءَ مَجّاجَةَ الثَرى","مُسَلَّمَةً ما حَصَّ أَوراقَها الفَتلُ",16,"ل",1,0],["فَأَحسِنِ الظَنِّ لا تَرتَب بِعَهدِ فَتىً","تَعفو العُهودُ وَتَبقى مِنهُ آثارُ",17,"ر",1,0],["فَاِحسِم دَواعِيَ كُلِّ شَرٍّ دونَهُ","فَالداءُ يَسري إِن عَدا لا يُحسَمُ",18,"م",1,0],["فَأُحَيي هَداكِ اللهُ مَن قَد قَتَلتِهِ","وَعاصِي كَما يُعصى لَدَيهِ الأَقارِبُ",19,"ب",1,0],["فَأَحْنَقَتْهُ مُبَارَاتِي وَلا جَرَمٌ","وَلَيْسَ فِي حَنَقِ المَوْتُورِ مِنْ جُرُمِ",20,"م",1,0],["فَاحَ رَيْحَانُهَا وَلاحَ الخَزَامُ","وَجَلَتْ عَنْ حُلِيهَا الأَكْمَامُ",21,"م",1,1],["فَاحْمُوا حِمَاهَا وَلا تُهْتَكْ سَتَائِرُهَا","عَنْ مُنْجِبَاتِ العُلَى يَسْتَحْيِهَا العُقْمُ",22,"م",1,0],["فَاِحمَدِ اللَهَ عَلى صُحبَتِهِ","وَاِسأَلِ الرَحمَنَ مِنهُ العافِيَه",23,"ي",2,0],["فاحِشُ القَصيدَ بِهِم وَفَرِّغ فيهِمُ","قَلباً حَشَوتَ هَواهُ بِاللَذاتِ",24,"ت",1,0],["فَاِحفَظ عَشيرَتَكَ الأَدنَينَ إِنَّ لَهُم","حَقّاً يُفَرِّقُ بَينَ الزَوجِ وَالمَرَةِ",25,"ه",1,0],["فَأَحكَمتَها لا أَنتَ في الحُكمِ عاجِزٌ","وَلا أَنتَ فيها عَن هُدى الحَقِّ جائِرُ",26,"ر",1,0],["فاحرص على أدب تحيا النفوس به","فإنما قيمة الإنسان بالأدب",27,"ب",1,0],["فأحم لهم حديد الشعر حتى","تُذيق نفوسهم حرّ المكاوي",28,"ي",1,0],["فأحنف ربّ الحلم بالحلم فقته","وفي الجود قد فقت ابن زائدة معنا",29,"ن",2,0],["فَأَحسِن فَلا عارَ فيما صَنَعتَ","تُحيِي جُدوداً وَتَبري جُدودا",30,"د",2,0],["فأحسابكم لا تنحلوها سواكم","فيقبل بعض المخفقين انتحالَها",31,"ه",2,1],["فَاِحمَرَّتِ الأَوجُهُ وَالعُيونُ","وَقالَ هَذا مَوضُعٌ مَلعونُ",32,"ن",1,0],["فَأَحوَطُ لِلإِسلامِ أَن لا يُضيعَني","وَلي عَنكَ فيهِ حَوطَةٌ وَمَنابُ",33,"ب",1,0],["فَاِحتَواها فَتىً يُهينُ لَها الما","لَ وَنادَمتُ صالِحَ اِبنَ عِلاطِ",34,"ط",1,0],["فَأَحياؤُنا مِن خَيرِ مَن وَطِئَ الثَرى","وَأَمواتُنا مِن خَيرِ أَهلِ المَقابِرِ",35,"ر",1,0],["فأحسنْ بها في راحةٍ علويةٍ","كما افترَّ عن لمعِ البروقِ سحاب",36,"ب",1,0],["فأحسنَ لي في الوفا والجفا","وشيَّخني في الرِّضا والغضب",37,"ب",1,0],["فاح نشراً وبدا فالبدر من","حسدٍ خافٍ ونشرُ الروضِ خافت",38,"ت",1,0],["فأحجم إجلالاً عن القولِ واللقا","ويبعثي من سائق البرّ باعث",39,"ث",1,0],["فأحسنُ من صوبِ السحاب هباتهِ","وأحسنُ من تلكَ الهبات رواجها",40,"ج",3,0],["فأحسنْ بها من كفِّ ساقٍ كأنه","إذا حفَّها محتاب ثوب مورَّد",41,"د",1,0],["فأحييته بعد الرَّدى أو أقمته","وقد طالَ من تحتِ التراب هموده",42,"د",2,0],["فاح ذكراً وفاض في الخلق نهراً","فحمدنا الرِّياض والأنهارا",43,"ر",2,0],["فأحسن بها للملكِ في كلِّ حالةٍ","بشائرَ عند السيف والعزّ والنصر",44,"ر",1,0],["فأحسن بها في الطرس هيفا كحيلة","تريك قدود العرب مع ثقل الترك",45,"ك",1,0],["فأحبب بذاك الحسن وهو مدا الدجى","بلثميَ مختومٌ وضمِّيَ مقفل",46,"ل",1,0],["فأحيين وُدًّا كانَ كالرسم عافياً","بسقط اللوى بين الدخول فحومل",47,"ل",1,0],["فأحسن بذاك الطرس في كلِّ ناظر","وأعصم بذيَّاك اليراع وأكرم",48,"م",1,0],["فاحكم على كلِّ الأنام فقد","أصبحت رب السيف والقلم",49,"م",1,0],["فاحْبس هباتك عني إنني رجلٌ","أخاف بغياً على نفسي وعدوانا",50,"ن",2,0],["فأحسن بهم في دياجي السطور","قياماً وبالنجم هم يهتدون",51,"ن",1,0],["فاحبسي الشكوى فلولاك لم