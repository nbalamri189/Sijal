{"poems":[[57,"قد كنت أرجو وصلكم","https://www.aldiwan.net/poem26548.html","مجزوء الكامل"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[87,"لما أتم نوح السفينه","https://www.aldiwan.net/poem8025.html","الرجز"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[46,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[257,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[287,"في خد من أهواه خير طراز","https://www.aldiwan.net/poem32740.html","الكامل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[411,"وإن هممت بأمر","https://www.aldiwan.net/poem49621.html","المجتث"],[420,"سما عمر لما أتته رسائل","https://www.aldiwan.net/poem4486.html","الطويل"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[445,"اليوم نادتك السيادة هيت لك","https://www.aldiwan.net/poem34848.html","الكامل"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[469,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[484,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[505,"سينسج لي بسمك الكون بدر","https://www.aldiwan.net/poem37997.html","الوافر"],[534,"إن أفلس الذهن فقسه على","https://www.aldiwan.net/poem37363.html","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56191","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1365,"","https://poetry.dctabudhabi.ae/diwan/poem/202424","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109319","الوافر"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120874","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87342","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87338","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87343","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87339","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203473","الخفيف"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140258",""],[4033,"","https://poetry.dctabudhabi.ae/diwan/poem/101191","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58043","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204246","البسيط"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4859,"جارة الحسن!","https://www.poetsgate.com/ViewPoem.aspx?id=202343",""],[4984,"تفاءل","https://www.poetsgate.com/ViewPoem.aspx?id=187718",""],[5131,"وداعاً وإِنْ كان الوداعُ تألمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=42556",""],[5616,"خيام","https://www.poetsgate.com/ViewPoem.aspx?id=203428",""],[456,"عروس الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84502&r=&rc=1",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""]],"verses":[["فَقَسَمتُهُ بَيني وَبَي","نَ حَبيبِ نَفسي بِالسَواءِ",0,"ا",2,0],["فقِسْتِ بما ألقاهُ ما قد لقيتِه","شهدتِ بحق أنَّ داهيتي أطمْ",1,"م",1,0],["فَقِس عَلى ذَلِكَ أَحوالَ البَشَر","إِن شَمِلَ المَحذورُ أَو عَمَّ الخَطَر",2,"ر",1,0],["فقس لتدرك مكنون العلوم فبال","قياس أطلع أقوم على عبرِ",3,"ر",1,0],["فَقَسا لِتَزدَجِروا وَمَن يَكُ حازِماً","فَليَقسُ أَحياناً وَحيناً يَرحَمُ",4,"م",1,0],["فَقسمتَهم في المُلتَقى قِسمَ جائِرٍ","وان كُنتَ فيهم عادِلاً وَمعدّلا",5,"ل",2,0],["فَقِسِيّه بِشَباتِها قَد أَشبَهَت","قَوسَ السَماءِ بِفَضلِها المُمتازِ",6,"ز",1,0],["فَقسٌ بها دون التحيّة باقلٌ","وَعمرو لو اِستام المثول اِنثنى نخبا",7,"ب",2,0],["فقِسْ قياساً صحيحاً","واحكُمْ بِضِدِّ النَّتيجَهْ",8,"ه",1,0],["فقسط فيما بينهم كل جزية","وكل رفاد كان أهنا وأحمدا",9,"د",2,0],["فقسّم منها ما أفاد وما احتوى","ومن قبل ما يثوي ومن بعد ما ثوى",10,"ث",3,0],["فَقَسَمْتَهُمْ بَيْنَ الصَّوارِمِ والقَنا","إِلّا الَّذِينَ مَلأْتَ مِنْهُمْ أَحْبُلَكْ",11,"ك",1,0],["فقِسْمٌ للمصانِعِ والحشايا","وقسم للمصارِعِ والرِّجَامِ",12,"م",1,0],["فقسيٌّ تهدي ولسن بأو","تارٍ سهاماً تصمي بلا أفواقِ",13,"ق",1,0],["فقسم جامد ثاو","أمام القوم أهراما",14,"م",2,0],["فقِسمَةُ خالِصِ النِيَّاتِ نورٌ","وقسمَةُ فاسِدِ النِيَّاتِ ضَيزَى",15,"ز",2,0],["فَقِسْ ولا تَقْسُ عَداك الرَّدَى","يا رَبِّ لَيّنْ قَلْبَهُ إنْ قَسَا",16,"س",2,0],["فَقَسَمَانَا فِرَقاً وَطَحْطَحا","وَمَنْ هَدَى اللَّهُ اهْتَدى وَأَفْلَحا",17,"ح",2,0],["فقسمة القاسم المفضال لا برحت","تعلو وتزداد والمولى يعظمها",18,"م",3,0],["فقس على هذا ووقع بلعل","منه وحقّق بعسى تعطى الأمل",19,"ل",1,0],["فقسيها أجفانها وسهامها","حدقاتها ولحاظهن نصول",20,"ل",1,0],["فقسم بي نرمه برجوم لفظ","فلا دية هناك ولا قُسامه",21,"م",2,0],["فقسيّهم عربية مهما رمت","أصمت فما عن نبلهنّ محيدُ",22,"د",1,0],["فَقِس تَينكِ الرائيتينِ بِعَكسِهم","وإن آنتهاءَ الجاهِ عَالٍ وغَايِر",23,"ر",1,0],["فَقِسهُما وَقِس بِعَجزِ المَركَبِ","نَجماً وَقَيِّد ثُمخَّ إجرِ واكتُب",24,"ب",1,0],["فَقِس على السُّهَيلِ أيضاً والظليم","أربَعَةً ضَيِّقَه وَكُن عليم",25,"م",1,0],["فَقِسهُم على هذا بشرقٍ ومَغربٍ","وأشمِل بهم وأَجنِب وأخِّر وقَدِّمِ",26,"م",1,0],["فَقِسهُم وَصَلِّ على النبيِّ مُحَمَّدٍ","إذا لاحَ عَيُّوقٌ ونَسرٌ مُعَظَّمِ",26,"م",1,0],["فَقِسهُم وَأكثِر مِن صَلاَتِكَ مُعلِناً","على المُصطَفَى المُختَارِ بَينَ العَشَايِر",27,"ر",1,0],["فَقِس فَرقَداً عِندَ البُطَينِ وأصلُهُ","على الحَدِّ خَمسٌ باحتِكامٍ مُنَاسِبِ",28,"ب",1,0],["فَقِسها ولا تَخشَى إذا كُنتَ حَازِماً","وَإهدِ عليها جَاسِراً غَيرَ هَايِبِ",28,"ب",1,0],["فَقِسه مِن عَدَنٍ والكوسُ أوَّلُهُ","إن كُنتَ طالِبَ خَلفَاتٍ وحَصوَينِ",29,"ن",1,0],["فقِسهُم وَجَرِّب للمناتِخِ لا تَكُن","أخا غَفلَةٍ لا يَعرِفُ الحزمَ راتِع",30,"ع",1,0],["فَقِس على الفَرقَد بِهَذَا الوَصفِ","عِندَ الحِمَارَينِ فَهَاكً وَصفِي",31,"ي",1,0],["فَقِسهمَا بالحدِّ سَبعَة مُحكَمَه","وهوَ قياسٌ جَيدٌ فالزَمَه",32,"ه",1,0],["فقسطُ صاحبِ دينٍ فى زهادته","وقسط صاحب دنيا فى الملذاتِ",33,"ت",1,0],["فقسّموا من بعضها أقساما","وخَصَّصوها للقرى سهاما",34,"م",2,0],["فقسّموه عندهم يا صاح","يا من سناه في ضيا المصباح",34,"ح",1,0],["فقس البيض عنك والأم ربت","ك بحضن الحب النقي الطهور",35,"ر",1,0],["فقسمت النوح شطرين معاً","فلها الشطر ولي الشطر يبين",36,"ن",1,0],["فقسمت بينهما فنورك في السما","يهدي الملائك للسبيل الأرشد",37,"د",1,0],["فقِسْمَتُهُ عدلٌ وفيها قد استوى","ذليلٌ ومقدامٌ غنيٌ ومُعْسِرُ",38,"ر",1,0],["فقس به الفلك الدوار واجْرِ كما","يجري بلا أجل يخشى وينتظر",39,"ر",1,0],["فَقَسِّمْ نخِْتَلجْ طَرباً .. فَإِنَّا","رَأَيْنَاهَا تَقَاسِيمَاً عَلَى (الْأُرْ..)",40,"ر",1,0],["فقسوة الحزنِ يا صنعاء تُرهقني","وبؤرة الخوفِ في الأعماقِ تتّسعُ",41,"ع",1,0],["فقسمة أرزاقنا حُدِّدَتْ","لمن أمسك المال أو أنفقا",42,"ق",2,0],["فقسْمٌ بِأحساء ودوحةٍ","وقسمٌ تبنَّاه الكويتُ فأكرما",43,"م",2,0],["فقسا الشعر في ثغور القوافي","وذوى السحر في عيون الظباءِ",44,"ا",2,0],["فقسا الشعر والشعور وغابت","عن وجوه النساء نعمى النساء",44,"ا",2,0],["فقَساني وتَنَاسى أنَّني","ذو هيَام ٍ في متَاهِ الظُّلَم",45,"م",1,0],["فَقِسْمَةُ الموتِ فِي الأَوطانِ قِسْمَتُنَا","والكُلُّ مِنَّا شَهيدٌ مِنْذُ أَنْ فُطِرَا",46,"ر",2,0]]}