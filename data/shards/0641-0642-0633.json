{"poems":[[55,"قد كنت أرجو وصلكم","https://www.aldiwan.net/poem26548.html","مجزوء الكامل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[85,"لما أتم نوح السفينه","https://www.aldiwan.net/poem8025.html","الرجز"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[250,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[280,"في خد من أهواه خير طراز","https://www.aldiwan.net/poem32740.html","الكامل"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[402,"وإن هممت بأمر","https://www.aldiwan.net/poem49621.html","المجتث"],[411,"سما عمر لما أتته رسائل","https://www.aldiwan.net/poem4486.html","الطويل"],[413,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[436,"اليوم نادتك السيادة هيت لك","https://www.aldiwan.net/poem34848.html","الكامل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[462,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[477,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[498,"سينسج لي بسمك الكون بدر","https://www.aldiwan.net/poem37997.html","الوافر"],[527,"إن أفلس الذهن فقسه على","https://www.aldiwan.net/poem37363.html","السريع"]],"verses":[["فَقَسَمتُهُ بَيني وَبَي","نَ حَبيبِ نَفسي بِالسَواءِ",0,"ا",2,0],["فقِسْتِ بما ألقاهُ ما قد لقيتِه","شهدتِ بحق أنَّ داهيتي أطمْ",1,"م",1,0],["فَقِس عَلى ذَلِكَ أَحوالَ البَشَر","إِن شَمِلَ المَحذورُ أَو عَمَّ الخَطَر",2,"ر",1,0],["فقس لتدرك مكنون العلوم فبال","قياس أطلع أقوم على عبرِ",3,"ر",1,0],["فَقَسا لِتَزدَجِروا وَمَن يَكُ حازِماً","فَليَقسُ أَحياناً وَحيناً يَرحَمُ",4,"م",1,0],["فَقسمتَهم في المُلتَقى قِسمَ جائِرٍ","وان كُنتَ فيهم عادِلاً وَمعدّلا",5,"ل",2,0],["فَقِسِيّه بِشَباتِها قَد أَشبَهَت","قَوسَ السَماءِ بِفَضلِها المُمتازِ",6,"ز",1,0],["فَقسٌ بها دون التحيّة باقلٌ","وَعمرو لو اِستام المثول اِنثنى نخبا",7,"ب",2,0],["فقِسْ قياساً صحيحاً","واحكُمْ بِضِدِّ النَّتيجَهْ",8,"ه",1,0],["فقسط فيما بينهم كل جزية","وكل رفاد كان أهنا وأحمدا",9,"د",2,0],["فقسّم منها ما أفاد وما احتوى","ومن قبل ما يثوي ومن بعد ما ثوى",10,"ث",3,0],["فَقَسَمْتَهُمْ بَيْنَ الصَّوارِمِ والقَنا","إِلّا الَّذِينَ مَلأْتَ مِنْهُمْ أَحْبُلَكْ",11,"ك",1,0],["فقِسْمٌ للمصانِعِ والحشايا","وقسم للمصارِعِ والرِّجَامِ",12,"م",1,0],["فقسيٌّ تهدي ولسن بأو","تارٍ سهاماً تصمي بلا أفواقِ",13,"ق",1,0],["فقسم جامد ثاو","أمام القوم أهراما",14,"م",2,0],["فقِسمَةُ خالِصِ النِيَّاتِ نورٌ","وقسمَةُ فاسِدِ النِيَّاتِ ضَيزَى",15,"ز",2,0],["فَقِسْ ولا تَقْسُ عَداك الرَّدَى","يا رَبِّ لَيّنْ قَلْبَهُ إنْ قَسَا",16,"س",2,0]]}