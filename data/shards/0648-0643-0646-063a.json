{"poems":[[53,"أشارت بالخضاب إلى الخضاب","https://www.aldiwan.net/poem8337.html","الوافر"],[215,"نصيب الأعادي منك لو يعلمونه","https://www.aldiwan.net/poem46296.html","الطويل"],[556,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82838","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66362","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58085","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58034","البسيط"],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[469,"وكن غنيا عن كل ارض بأختها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574824",""]],"verses":[["وكنِّ غرائراً إلّا بشيبٍ","يُخيِّلُهُ المُخَيِّلُ بالشبابِ",0,"ب",1,0],["وكن غوثها حتى ترفّ كأنما","تحسُّ من القايات طيب صبا نجد",1,"د",1,0],["وكن غُصّةً في لَهاةِ العدوِّ","ورغماً على مَعْطِسِ الرّاغمِ",2,"م",1,0],["وكن غوثة يوم المعاد ونجه","من النار وارفع في الجنان له قدرا",3,"ر",2,0],["وَكُن غافِراً ذَنبَ خِلٍّ أَسا","فَخَيرُ الكِرامِ الَّذي قَد غَفَر",4,"ر",1,0],["وكن غياثي وملاذي إذا","من بين اخواني أمسي فقيد",5,"د",1,0],["وكن غاسلاً أقذارَ كلِّ خطيئةٍ","ببحرِ الهُدَى واعْمُمْ به الجسمَ مُسْبغَا",6,"غ",2,0],["وكنْ غياثَ بني غبراء كلِّهمُ","لا سيما كلُّ أعمى ذاهبِ البصر",7,"ر",1,0],["وكنْ غفوراً إذا ما جئتُ مقترفاً","شعراً وقد قَصُرتْ وصفاً قوافيهِ",8,"ي",2,0],["وكن غصناً نضيراً ذا ثمارٍ","ظليلاً لا تزاحمه الغصونُ",9,"ن",1,0],["وكن غنيا عن كل أرض بأختها","وإنَّ حل مغناها كواعب عين",10,"ن",1,1]]}