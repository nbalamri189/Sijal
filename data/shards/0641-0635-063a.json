{"poems":[[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"ألا قل لابن معن ذا","https://www.aldiwan.net/poem64281.html","الهزج"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[96,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=12695",""],[186,"أمسى النجيب بهذا الرمس محتجبا","https://www.aldiwan.net/poem61062.html","البسيط"],[230,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[266,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[385,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[520,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[520,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[567,"صبرا بني البندقي الأكرمين على","https://www.aldiwan.net/poem52609.html","البسيط"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124614","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35399","الوافر"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69335","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109290","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53208","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77254","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67202","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137280",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137037",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83213","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204960","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44720","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4767,"أحلام عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=180049",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[5185,"الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=71576",""],[5493,"إلى المنفى أعود","https://www.poetsgate.com/ViewPoem.aspx?id=197216",""],[5701,"سهرت أنظمه والناس قد هجعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164586",""]],"verses":[["فصغَى إليك برأيه","والحاسدون لهم زفيرُ",0,"ر",1,0],["فَصُغ ما كُنتَ حَلَّيتَ","بِهِ سَيفَكَ خَلخالا",1,"ل",2,0],["فصُغِ البيانَ بِهِ وأَنْطِقْ حَدّهُ","يَسْمَعْ إِليكَ مكرَّراً ومُعادا",2,"د",2,0],["فَصغِ الحُليَّ لَهَا وَتَوِّجْ رَأْسَهَا","إِذْ تَسْتَقِلُّ بِأَنْجُمٍ زَهْرَاءِ",3,"ا",2,0],["فصغت تسمعها الريّاح وقرّ في الموج اضطراب","أنا والربيع مشرّدان وللشذا معنا ذهاب",4,"ب",1,0],["فَصغَت بَيتاً مِن التاريخِ قُلتُ بِهِ","قَد ماتَ بَعدَ النَجيبِ الشعرُ وَالأَدبُ",5,"ب",1,0],["فَصَغَّرت كلَّ موجودٍ ضَخامَتُها","وَغضَّ بُنيانُها من كلِّ بُنيانِ",6,"ن",1,0],["فصغر الحزم منك اكبرهم","وارتد بالخزي عنك كل ردى",7,"د",2,0],["فَصُغتُ لِجيد المَجد طَوق مَدائح","إِذا سَمِعَ المَحزون أَبياتِها غِنى",8,"ن",2,0],["فصغى ولكن المهابة والحيا","منعاه مما يشتهي ويريد",9,"د",1,0],["فصغير باك بقلب قريح","وكبير ينوح بالأشجان",10,"ن",1,0],["فَصُغتُ للقبرِ تاريخاً رقَمْتُ بهِ","يسقيكَ قَطرُ النَّدَى يا منزِلَ القَمرِ",11,"ر",1,0],["فصغت إليك قلوبهم وعيونهم","واكفّهم والسؤل والالحاح",12,"ح",1,0],["فَصُغتُ مِنَ الأَهِلَّةِ وَالحَنايا","أَساوِرَ وَالخَلاخِلَ وَالبُرينا",13,"ن",2,0],["فصغ لؤلؤءاً من \"مدحيَ ابن\" ملوكنا","\"إمام الورى\" الباهي على الخلق رفدُه",14,"د",2,0],["فَصُغِّرَ بِهرامٌ وَبُخِّلَ حاتَمٌ","وَجُبِّنَ بِسطامٌ وَغُلِّطَ لُقمانُ",15,"ن",1,0],["فصغ من معاني مجده جوهر الثنا","ودع عنك ذكرى مبسم الرشأ الأحوى",16,"و",2,0],["فصغرت قدراً إن غدوت وهمتي","بسوى المعظم تطلب التعظيما",17,"م",2,0],["فَصُغتُ إِطاراً من عَقيق لِرَسمِها","بِدَمعٍ مِنَ العَينَينِ وَالقَلبِ يَنضَحُ",18,"ح",1,0],["فَصَغى لما حدَّثَتَه","لكَ مَسمَعي لا بل جميعي",19,"ع",2,0],["فصغت لك التهاني من لجين","وصغت لها التهاني من لئال",20,"ل",1,0],["فصغت فيك الثنا عن كنه معرفة","وصاحب البيت ادرى بالذي فيه",21,"ي",2,0],["فَصُغتُ لَها عَلى الإصباحِ دُرَّاً","قَلائِدَ لَن تُتاحَ لِمَن عَداني",22,"ن",2,0],["فصغار الأنام تكبر شعري","وكبار الأنام تكبر أمري",23,"ر",2,0],["فَصِغارُكُم قَد يَضحَكونَ بِأُنسكم","وَدُموعَنا فَوقَ الخُدود غِزارُ",24,"ر",1,0],["فصغت الشهامة للرجل","من الكون مجموع كل الكبرْ",25,"ر",1,0],["فصغتُ الشوق والأحلا","مَ للمحبوب أبياتا",26,"ت",2,0],["فصغرت الشمس في مقلتي","إذا الشمس من فيضها تسرج",27,"ج",1,0],["فصغيرهم عند الشدائد عاقل","وعجوزهم عند الحراك غلام",28,"م",1,0],["فصُغتُ له منَ الآمالِ طوْقًا","ليُنْجيَهُ إذا غرِقَ الجنُودُ",29,"د",1,0],["فصغ قوافيه إذ ذاك متئدا","كما يصوغ النضار الصائغ الصنع",30,"ع",1,0]]}