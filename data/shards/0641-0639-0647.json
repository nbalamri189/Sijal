{"poems":[[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[64,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[107,"بني مرة اقضوا أمركم قبل غالب","https://www.aldiwan.net/poem43576.html","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[56,"تَجَاوَبنَ بالإرنانِ وَالزَّفراتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16977&r=&rc=1",""],[136,"أهاجت لك الأشجان لمحة بارق","https://www.aldiwan.net/poem54786.html","الكامل"],[208,"أقاسي في الهوى ما لا تقاسي","https://www.aldiwan.net/poem53122.html","الوافر"],[228,"لقد بلغت بهم الحده","https://www.aldiwan.net/poem41900.html","المتقارب"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[422,"عسى نظرة من ناصر والتفاتة","https://www.aldiwan.net/poem54029.html","الطويل"],[457,"سل الركب هل مروا على جيرة الرند","https://www.aldiwan.net/poem13747.html","الطويل"],[463,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[556,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66978","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59784","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59817","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113985","الطويل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108453","الرمل"],[2272,"","https://poetry.dctabudhabi.ae/diwan/poem/131432","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120721","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66466","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91783","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199064","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119609","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83623","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141661","الطويل"],[4778,"غرامك سلوتي","https://www.poetsgate.com/ViewPoem.aspx?id=188170",""],[5129,"حكايتنا","https://www.poetsgate.com/ViewPoem.aspx?id=122674",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5442,"سل الركب هل مروا بجرعاء مالك","https://www.poetsgate.com/ViewPoem.aspx?id=114770",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5861,"عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=188049",""],[5943,"من خانَ فينا","https://www.poetsgate.com/ViewPoem.aspx?id=34380",""],[6143,"عذرا رسول الله...","https://www.poetsgate.com/ViewPoem.aspx?id=175095",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""]],"verses":[["فَعَهدُ الأَميرِ كَعَهدِ الرَشيدِ","يَمُتُّ إِلَيهِ بِحَبلِ النَسَب",0,"ب",1,0],["فعهدي على أنّ الحوادثَ جَمَّةٌ","به وهو ريَّانُ العساليجِ مائِدُ",1,"د",1,0],["فعهدي به والدهرُ أغيَدُ والهَوى","بماء صِباهُ والزمانُ قَشِيبُ",2,"ب",1,0],["فَعَهَدٌ على عهدٍ من اللهِ ثابتٍ","وإلفٌ على إلفٍ من الدينِ راتِبِ",3,"ب",1,0],["فَعَهدي بِها خُضرَ المَعاهِدِ مَألَفاً","مِنَ العَطِراتِ البيضِ وَالخَفِراتِ",4,"ت",1,0],["فَعَهْدِي بِهَا خُضرَ المَعاهِدِ، مَأْلفاً","وبالرُّكنِ والتَّعَريفِ والْجَمَرَاتِ",5,"ت",1,0],["فَعَهدُكِ مَحفُوظٌ ولُقيَاكِ مُنيَةٌ","وَمرآكِ لِلعَينَينِ أحسُنُ رَائِقِ",6,"ق",1,0],["فعهدك في الغرور كعهد وردٍ","وعهديَ في الإسار كعهد آسِ",7,"س",1,0],["فَعَهدُ الغُموضِ مَضى وَتَصَدّى","لَهُ عَهدُنا ناقِضاً عَهدَه",8,"د",2,0],["فَعَهدي بهاتيكَ المَعاهدِ لم تزل","شوادِنُها تَعطو وأَغصانُها تَغطو",9,"ط",2,0],["فعهدي بها كانت تميل تشوُّقاً","إلي ولكن عنيَ الآن تَعطِف",10,"ف",1,0],["فعَهْدي به برٌّ رؤوفٌ وراحِمٌ","تَعاهَدَني من قَبلُ بالعُسْرِ واليُسْرِ",11,"ر",1,0],["فعهدي بهم لا ينزعون عن الوفا","بحال ولا يلوونَ عن صادق العهد",12,"د",1,0],["فعهودٌ ما شئت تُلغَى وأيما","نٌ على غير حِلِّها تُستثنى",13,"ن",2,0],["فَعَهدي بهِ لا يهتدِي البين طُرْقَه","وَلا تَطرق الأحزانُ مِن أَهلهِ قلبا",14,"ب",2,0],["فَعَهْدِي به في ذلك الدَّوْحِ كَانِساً","ومَنْ ليَ بالرُّجْعَى إلى ذلك العَهْدِ",15,"د",1,0],["فعهدك محفوظٌ لديَ رعيته","وعهدي منبوذٌ لديك مضيع",16,"ع",1,0],["فعهدي على الهجران يزداد جدة","وشوقي على طول البعاد يطول",17,"ل",1,0],["فعَهدةُ فالغُلّانُ من ذي محارَةٍ","فخَيشومُهُ قيعانُهُ فمَسايُلُه",18,"ل",2,0],["فعهدناكم مثالاً للسخا","وإليكم قد أشرنا بالبنان",19,"ن",1,0],["فعهدى بها العهد القديم وانني","على كل حال في هواها مقصر",20,"ر",1,0],["فَعَهدِيَ محفوظٌ وحَسبِي بِحفظِهِ","شهادةُ ربٍّ العالمين تبارَكا",21,"ك",2,0],["فعهدي بهذا الدهر أحول كلما","رنا قلبت جفناه طرف زنيم",22,"م",1,0],["فَعهدي بِأَهليها جبالٌ ترفعت","إِلى أَنجُمِ الجَوزاء حَيث استقلت",23,"ت",1,0],["فعهدك عهد بالمسرات حافل","وأنت لنا من كل حادثة ذخر",24,"ر",1,0],["فعهدي وقد كنتَ من حشدِه","فَمِمَّ العقوقُ وماذا جرى",25,"ر",2,0],["فعهدُ الأَعادي قالصُ الظلِّ مُنقضٍ","ونجمُ الموالي طالعٌ غيرُ منقضِّ",26,"ض",1,0],["فَعهد محبّتي عهدٌ صَحيحٌ","بِفَضل اللَهِ لَم يَفسخه فاسِخ",27,"خ",1,0],["فعهدي باسم الآكلات فلانة","وعهدي باسم الآكلين فلان",28,"ن",1,0],["فعهدي فيك ميال لقربي","وما أقررت في يوم نواكا",29,"ك",2,0],["فَعُهودُنا لَيستْ بُنودَ وُرَيقَةٍ","لِوصَالِنا كالرَّاسياتِ جُذورْ",30,"ر",1,0],["فعهدي بهم أنصار دين محمد","على الملة السمحا وليسوا ذوي غدر",31,"ر",1,0],["فعهدي به لما استقلت ركابكم","وقد قال لنساري إلى طيبة سربي",32,"ب",2,0],["فعهدي به يوم الرحيل عن الحمى","وقد ضاع مني بين تلك المسالك",33,"ك",1,0],["فعهدته وصّال رحْمٍ مغدقٍ","فيم الجفا اصواته لم تجرسِ",34,"س",1,0],["فعهدي بأهليها ملوك إذا سخوا","يروا المائة الحمراء أيسر منةِ",35,"ه",1,0],["فعهدًا ووعدًا سنرمي الطغاة","بسهمِ اللهيب وبرق الرعود",36,"د",1,0],["فعهد الله في الأعناقِ دينٌ","يشدُّ بحبلهِ من خانَ فينا",37,"ن",2,0],["فعهدا يارسول الله كي نمضي","فقد جار الهوى فينا ومازلنا",38,"ن",2,0],["فعهدنا اليوم مع عهد الرسول غدا","الفرق بينهما كالفحم والدرر",39,"د",3,0]]}