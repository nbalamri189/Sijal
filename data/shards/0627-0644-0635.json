{"poems":[[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[77,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[71,"إن القدود على تأودها","https://www.aldiwan.net/poem3974.html","أحذ الكامل"],[73,"أرخصتني من بعد ما أغليتني","https://www.aldiwan.net/poem11889.html","الكامل"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[93,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[93,"ألصيد لهو الملوك من قدم","https://www.aldiwan.net/poem11360.html","المنسرح"],[93,"هذي الرزيئة فيك","https://www.aldiwan.net/poem11471.html","مجزوء الكامل"],[27,"هاج الشجون برهبى ربع أطلال","https://www.aldiwan.net/poem5956.html","البسيط"],[37,"الصادعون صفا من لا يواجدهم","https://www.aldiwan.net/poem6487.html","البسيط"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[72,"وسواس حلا لا كوسواس","https://www.aldiwan.net/poem19020.html","السريع"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[64,"الصب رب محب","https://www.aldiwan.net/poem67668.html","المجتث"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"صوت سوريا الجميله","https://www.aldiwan.net/poem62756.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[38,"طال العشاء ونحن بالهضب","https://www.aldiwan.net/poem7686.html","الكامل"],[78,"الصبح قد مزق ثوب الدجى","https://www.aldiwan.net/poem13984.html","السريع"],[89,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[89,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[89,"ما شاهدت عيني ممث","https://www.aldiwan.net/poem44910.html","مجزوء الكامل"],[85,"ذكر الحداثة جهلها وغرامها","https://www.aldiwan.net/poem7105.html","الكامل"],[85,"يا راغب الخيرات أنت بقية","https://www.aldiwan.net/poem7141.html","الكامل"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[85,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[85,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[43,"الصوم والفطر والأعياد والعصر","https://www.aldiwan.net/poem9566.html","البسيط"],[62,"الصلب يخلط بالرطوبة مدة","https://www.aldiwan.net/poem52221.html","الكامل"],[58,"الصبر مفتاح ما يرجى","https://www.aldiwan.net/poem30841.html","مخلع البسيط"],[49,"كل امرئ فكما يدين يدان","https://www.aldiwan.net/poem63132.html","الكامل"],[49,"ما كل ما تشتهي يكون","https://www.aldiwan.net/poem63158.html","مجزوء البسيط"],[49,"الصمت في غير فكرة سهو","https://www.aldiwan.net/poem63199.html","المنسرح"],[49,"الصدق إيمان وربتما","https://www.aldiwan.net/poem63223.html","الكامل"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[66,"أنجوم روض أم نجوم سماء","https://www.aldiwan.net/poem40989.html","الكامل"],[66,"نار الشموع توقدت","https://www.aldiwan.net/poem40992.html","مجزوء الكامل"],[66,"أهلا بها شمط الذوائب والذرى","https://www.aldiwan.net/poem41341.html","الكامل"],[66,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[66,"أهلا بها كالقضب في كثبانها","https://www.aldiwan.net/poem41343.html","الكامل"],[66,"إني ليطربني العذول فأنثني","https://www.aldiwan.net/poem41355.html","الكامل"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[97,"آه من لحن سماوي","https://www.aldiwan.net/poem24608.html","مجزوء الرمل"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[80,"الصبح شر بغيض","https://www.aldiwan.net/poem31540.html","المجتث"],[44,"عنت فأعرض عن تعريضها أربي","https://www.aldiwan.net/poem29680.html","البسيط"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[105,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[105,"ذهب السرور وولت الأعياد","https://www.aldiwan.net/poem43120.html","الكامل"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[81,"لا تركنن مع الذنوب لعزة","https://www.aldiwan.net/poem61473.html","الكامل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[67,"الصبح بدا من طلعته","https://www.aldiwan.net/poem18129.html","المتدارك"],[48,"حسبي جوى إن ضاق بي أمري","https://www.aldiwan.net/poem63317.html","السريع"],[50,"الصدق أفضل ما حضرت به","https://www.aldiwan.net/poem64778.html","الكامل"],[46,"الصبر يوجد إن باء له كسرت","https://www.aldiwan.net/poem22394.html","البسيط"],[46,"الصدر بيت إذا ما السر زايله","https://www.aldiwan.net/poem22430.html","البسيط"],[46,"الصبر أروح من حاج تكلفه","https://www.aldiwan.net/poem22433.html","البسيط"],[46,"الصمت أولى وما رجل ممنعة","https://www.aldiwan.net/poem22550.html","البسيط"],[46,"ألصبح أصبح والظلا","https://www.aldiwan.net/poem23107.html","مجزوء الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141000",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39589","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55177","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141927","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199473","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117020","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23950","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"الطفل الموءود!","https://www.poetsgate.com/ViewPoem.aspx?id=179638",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""]],"verses":[["الصارِمُ المَشهورُ يُنذِرُ نَفسَهُ","فَخُذوا الحِذارَ مِنَ الحُسامِ المُغمَدِ",0,"د",1,0],["الصّبْرُ إلا في هواكَ حَميدُ","الخَطْبُ صعْبٌ والمَرامُ بَعيدُ",1,"د",1,1],["أَلصَقَ العَذمَ وَالعَذابَ بِقَبّاءَ","تَرى في سَراتِها تَحسيرا",2,"ر",2,0],["الصَبرُ إِن فَكَّرتَ أَعظَمُ عُدَّةٍ","وَالحَقُّ لَو يَدرونَ خَيرُ سِلاحِ",3,"ح",1,0],["الصَدُّ مِنكَ سَجِيَّةٌ عُرِفَت","مِثلَ السَماحَةِ في بَني يَمَنِ",4,"ن",1,0],["الصَبرُ شَهدٌ عِندَما جَرَّعتِني","وَالنارُ بَردٌ عِندَما أَصلَيتِني",5,"ن",2,0],["أَلَصُّ الضُروسِ حَنِيُّ الضُلوعِ","تَبوعٌ طَلوعٌ نَشيطٌ أَشَر",6,"ر",1,0],["الصَّالِحِ الوَرِعِ المُوفِي أَمَانَتَهُ","إِيفَاءَ مَنْ طَبْعُهُ يَنْبُو عَنِ الرِّيَبِ",7,"ب",1,0],["الصَّمْتُ أَفْصَحُ وَالأَفْعَالُ نَاطِقَةٌ","مِمَّا تُنَمِّقَهُ الأقْوَالُ في الْخُطُبِ",7,"ب",1,0],["الصَّوْتُ صَوْتُ الحِمَى يُوحِي إِرَادَتَهُ","إِنْ لَمْ يَجِبْهُ إِلَيْهَا شَاعِرٌ فَمَنِ",8,"ن",1,0],["أَلصَّريحِ الَّذِي إِذَا","نَاصَرَ الْحَقَّ مَا احْتَشَمْ",9,"م",1,0],["أَلصَّيْدُ لَهْوُ المُلُوكِ مِنْ قِدَمِ","وَالنُّجُبُ النَّابِهِينَ فِي الأُمَمِ",10,"م",1,1],["الصَّائِغَاتِ مِنَ البَنَا","تِ عُقُودَ زَهْرِ أَوْ لآَلْ",11,"ل",1,0],["الصادِعونَ عَلى الجَبّارِ بَيضَتَهُ","وَالحامِلونَ أُموراً ذاتَ أَثقالِ",12,"ل",1,0],["الصادعون صَفَا من لا يواجدهم","والمُرْأبون بأذن الله ما شعَبوا",13,"ب",3,1],["الصاحب الشرفِ الرفيع على السها","قدراً برغم الحاسد العوَّاء",14,"ا",2,0],["الصاحب المربي على ما روى","عن ابن عبَّاد بن مرداس",15,"س",1,0],["الصاعد الرتب التي خاضت به","نهر المجرَّة لا يقال لها مَهِ",16,"ه",1,0],["الصُبُّ رَبِّ مُحِبُّ","نَوالُهُ مِنكَ عُجبُ",17,"ب",1,1],["الصريحين في الصلاح إذا ما","خَلَّطَ الناسُ رائباً وحليبا",18,"ب",2,0],["الصّادِقِ الوعْدِ على أنه","ما زال فعَّالاً بلا وعْدِ",19,"د",1,0],["الصَيدُ غَيرَكَ إِن سَهِرَت دَإِن تَنَم","فَالصَيدُ أَنت وَلَحمُكَ المُختارُ",20,"ر",1,0],["الصَيفُ يَنفُثُ حَرَّهَُ مِن حَولِنا","وَأَنا أُحِسُّ كَأَنَّني مَقرورُ",21,"ر",1,0],["الصِبا فيهِ عَليلَه","تَتَداوى بِنَداه",22,"ه",1,0],["الصالِحُ المَلِكُ الَّذي لِزَمانِهِ","حُسنٌ يَتيهُ بِهِ الزَمانُ وَرَونَقُ",23,"ق",1,0],["أَلصَقتُ صَحبي مِن هَواكِ بِهِم","وَقُلوبُنا تَنزو مِنَ الرُهبِ",24,"ب",1,0],["الصُبحُ قَد مَزَّقَ ثَوبَ الدُجى","فَمَزِّقِ الهَمَّ بِكَفي مَها",25,"ه",2,1],["الصبح لما ابيض من انوارها","اخنى على ضوء النجوم اللمع",26,"ع",1,0],["الصدق يلقى حرمة","والكذب لا يحترم",27,"م",1,0],["الصورة الحسناء را","مِزة إلى حسن السريره",28,"ر",2,0],["الصدر من غرف الحياة دعامها","فإذا ألح السل هدّ دِعامها",29,"م",3,0],["الصم قد سمعوا حديثك في الندى","والخرس ألسنة بشكرك تفصح",30,"ح",1,0],["الصائلات قدودا","في البال أي مصال",31,"ل",1,0],["الصاحِبُ اِبنُ الصاحب الكَريمِ","الجللُ المَطلَب وَالغَريمِ",32,"م",1,0],["الصابِرينَ وَنَفسُ الأَرضِ واجِفَةٌ","الضاحِكينَ إِلى الأَخطارِ وَالقُحَمِ",33,"م",1,0],["الصاعِدينَ إِلى العَدُوِّ عَلى الظُبى","النازِلينَ عَلى القَنا الخَطّارِ",34,"ر",1,0],["الصَبرُ وَالإِقدامُ فيهِ إِذا هُما","قُتِلا فَأَقتُلُ مِنهُما الإِحجامُ",35,"م",1,0],["الصارِخونَ إِذا أُسيءَ إِلى الحِمى","وَالزائِرونَ إِذا أُغيرَ عَلى الشَرى",36,"ر",2,0],["الصابِراتُ لِضَرَّةٍ وَمَضَرَّةٍ","المُحيِياتُ اللَيلَ بِالأَذكارِ",37,"ر",1,0],["الصابِرينَ إِذا حَلَّ البَلاءُ بِهِم","كَاللَيثِ عَضَّ عَلى نابَيهِ في النُوَبِ",38,"ب",1,0],["الصَومُ وَالفِطرُ وَالأَعيادُ وَالعَصرُ","مُنيرَةٌ بِكَ حَتّى الشَمسُ وَالقَمَرُ",39,"ر",1,1],["الصلب يخلط بالرطوبة مدة","فيصير رطباً سائلاً طيارا",40,"ر",2,1],["الصَبرُ مِفتاحُ ما يُرجّى","وَكُلُّ خَيرٍ بِهِ يَكونُ",41,"ن",1,1],["الصِدقُ شَيءٌ لا يَقومُ بِهِ اِمرُؤٌ","إِلّا وَحَشوُ فُؤادِهِ الإيمانُ",42,"ن",1,0],["الصَبرُ أَنجى مَطيِّ عَزمٍ","يُطوى بِهِ السَهلُ وَالحُزونُ",43,"ن",1,0],["الصَمتُ في غَيرِ فِكرَةٍ سَهو","وَالقَولُ في غَيرِ حِكمَةٍ لَغو",44,"و",1,1],["الصِدقُ إيمانٌ وَرُبَّتَما","عِندَ الضَرورَةِ يَنفَعُ الكَذِبُ",45,"ب",1,1],["الصادِقُ الوَعدِ كَما جاءَ بِهِ","نَصُّ الكِتابِ وَالصَحيحِ المُسنَدِ",46,"د",1,0],["الصالِحِ المَلِكِ الَّذي أَكنافُهُ","كَهفُ الوُفودِ وَكَعبَةُ الفُقَراءِ",47,"ا",2,0],["الصالِحِ السُلطانِ وَه","هابِ النَفائِسِ لِلنُفوسِ",48,"س",1,0],["الصالِحِ المَلِكِ الَّذي بِسَماحِهِ","أَمسى الثَرا وَطأً 