سريع"],[438,"الصبر من كرم الأخلاق فاصطبر","https://www.aldiwan.net/poem14368.html","البسيط"],[438,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[441,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[451,"الصيف أين هو الحبيب فما أرى","https://www.aldiwan.net/poem61223.html","الكامل"],[451,"ليس منا قال الحسود المعنى","https://www.aldiwan.net/poem61347.html","الخفيف"],[456,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[456,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[459,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[459,"أهلا بغر قوافيكم لقد طلعت","https://www.aldiwan.net/poem16069.html","البسيط"],[459,"قد شاع أن تميما وهي من شهدت","https://www.aldiwan.net/poem16402.html","البسيط"],[459,"يفل غرب الرزايا وهي باسلة","https://www.aldiwan.net/poem16442.html","البسيط"],[466,"الصبح ينثر فوق مسك","https://www.aldiwan.net/poem60535.html","مجزوء الكامل"],[477,"الحقائق هبها اليوم تمثيلا","https://www.aldiwan.net/poem36953.html","البسيط"],[480,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[513,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[513,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[513,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[513,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[522,"الصلاة عليك يا شمس الكمال","https://www.aldiwan.net/poem13293.html","الوافر"],[527,"قلب تقلب في فنون","https://www.aldiwan.net/poem37273.html","مجزوء الكامل"],[527,"هوت العقيق وما هوت فكأنها","https://www.aldiwan.net/poem37342.html","الكامل"],[536,"مراكش متفاخر متباه","https://www.aldiwan.net/poem47519.html","عموديه"],[536,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[560,"هذا الكتاب الكبير النفع مع صغر","https://www.aldiwan.net/poem52728.html","البسيط"],[562,"الصبر ثوى لما حجبوا","https://www.aldiwan.net/poem860.html",""],[567,"إن الكريم إذا ما كان ذا كذب","https://www.aldiwan.net/poem52044.html","البسيط"],[573,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[573,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[573,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[583,"الصفو من ماء العنب","https://www.aldiwan.net/poem1563.html",""],[584,"كم يشمت بي في حبك العذال","https://www.aldiwan.net/poem17647.html","مخلع الرمل"],[584,"الصب بحبه عليه وله","https://www.aldiwan.net/poem17829.html","الدوبيت"]],"verses":[["الصارِمُ المَشهورُ يُنذِرُ نَفسَهُ","فَخُذوا الحِذارَ مِنَ الحُسامِ المُغمَدِ",0,"د",1,0],["الصّبْرُ إلا في هواكَ حَميدُ","الخَطْبُ صعْبٌ والمَرامُ بَعيدُ",1,"د",1,1],["أَلصَقَ العَذمَ وَالعَذابَ بِقَبّاءَ","تَرى في سَراتِها تَحسيرا",2,"ر",2,0],["الصَبرُ إِن فَكَّرتَ أَعظَمُ عُدَّةٍ","وَالحَقُّ لَو يَدرونَ خَيرُ سِلاحِ",3,"ح",1,0],["الصَدُّ مِنكَ سَجِيَّةٌ عُرِفَت","مِثلَ السَماحَةِ في بَني يَمَنِ",4,"ن",1,0],["الصَبرُ شَهدٌ عِندَما جَرَّعتِني","وَالنارُ بَردٌ عِندَما أَصلَيتِني",5,"ن",2,0],["أَلَصُّ الضُروسِ حَنِيُّ الضُلوعِ","تَبوعٌ طَلوعٌ نَشيطٌ أَشَر",6,"ر",1,0],["الصَّالِحِ الوَرِعِ المُوفِي أَمَانَتَهُ","إِيفَاءَ مَنْ طَبْعُهُ يَنْبُو عَنِ الرِّيَبِ",7,"ب",1,0],["الصَّمْتُ أَفْصَحُ وَالأَفْعَالُ نَاطِقَةٌ","مِمَّا تُنَمِّقَهُ الأقْوَالُ في الْخُطُبِ",7,"ب",1,0],["الصَّوْتُ صَوْتُ الحِمَى يُوحِي إِرَادَتَهُ","إِنْ لَمْ يَجِبْهُ إِلَيْهَا شَاعِرٌ فَمَنِ",8,"ن",1,0],["أَلصَّريحِ الَّذِي إِذَا","نَاصَرَ الْحَقَّ مَا احْتَشَمْ",9,"م",1,0],["أَلصَّيْدُ لَهْوُ المُلُوكِ مِنْ قِدَمِ","وَالنُّجُبُ النَّابِهِينَ فِي الأُمَمِ",10,"م",1,1],["الصَّائِغَاتِ مِنَ البَنَا","تِ عُقُودَ زَهْرِ أَوْ لآَلْ",11,"ل",1,0],["الصادِعونَ عَلى الجَبّارِ بَيضَتَهُ","وَالحامِلونَ أُموراً ذاتَ أَثقالِ",12,"ل",1,0],["الصادعون صَفَا من لا يواجدهم","والمُرْأبون بأذن الله ما شعَبوا",13,"ب",3,1],["الصاحب الشرفِ الرفيع على السها","قدراً برغم الحاسد العوَّاء",14,"ا",2,0],["الصاحب المربي على ما روى","عن ابن عبَّاد بن مرداس",15,"س",1,0],["الصاعد الرتب التي خاضت به","نهر المجرَّة لا يقال لها مَهِ",16,"ه",1,0],["الصُبُّ رَبِّ مُحِبُّ","نَوالُهُ مِنكَ عُجبُ",17,"ب",1,1],["الصريحين في الصلاح إذا ما","خَلَّطَ الناسُ رائباً وحليبا",18,"ب",2,0],["الصّادِقِ الوعْدِ على أنه","ما زال فعَّالاً بلا وعْدِ",19,"د",1,0],["الصَيدُ غَيرَكَ إِن سَهِرَت دَإِن تَنَم","فَالصَيدُ أَنت وَلَحمُكَ المُختارُ",20,"ر",1,0],["الصَيفُ يَنفُثُ حَرَّهَُ مِن حَولِنا","وَأَنا أُحِسُّ كَأَنَّني مَقرورُ",21,"ر",1,0],["الصِبا فيهِ عَليلَه","تَتَداوى بِنَداه",22,"ه",1,0],["الصالِحُ المَلِكُ الَّذي لِزَمانِهِ","حُسنٌ يَتيهُ بِهِ الزَمانُ وَرَونَقُ",23,"ق",1,0],["أَلصَقتُ صَحبي مِن هَواكِ بِهِم","وَقُلوبُنا تَنزو مِنَ الرُهبِ",24,"ب",1,0],["الصُبحُ قَد مَزَّقَ ثَوبَ الدُجى","فَمَزِّقِ الهَمَّ بِكَفي مَها",25,"ه",2,1],["الصبح لما ابيض من انوارها","اخنى على ضوء النجوم اللمع",26,"ع",1,0],["الصدق يلقى حرمة","والكذب لا يحترم",27,"م",1,0],["الصورة الحسناء را","مِزة إلى حسن السريره",28,"ر",2,0],["الصدر من غرف الحياة دعامها","فإذا ألح السل هدّ دِعامها",29,"م",3,0],["الصم قد سمعوا حديثك في الندى","والخرس ألسنة بشكرك تفصح",30,"ح",1,0],["الصائلات قدودا","في البال أي مصال",31,"ل",1,0],["الصاحِبُ اِبنُ الصاحب الكَريمِ","الجللُ المَطلَب وَالغَريمِ",32,"م",1,0],["الصابِرينَ وَنَفسُ الأَرضِ واجِفَةٌ","الضاحِكينَ إِلى الأَخطارِ وَالقُحَمِ",33,"م",1,0],["الصاعِدينَ إِلى العَدُوِّ عَلى الظُبى","النازِلينَ عَلى القَنا الخَطّارِ",34,"ر",1,0],["الصَبرُ وَالإِقدامُ فيهِ إِذا هُما","قُتِلا فَأَقتُلُ مِنهُما الإِحجامُ",35,"م",1,0],["الصارِخونَ إِذا أُسيءَ إِلى الحِمى","وَالزائِرونَ إِذا أُغيرَ عَلى الشَرى",36,"ر",2,0],["الصابِراتُ لِضَرَّةٍ وَمَضَرَّةٍ","المُحيِياتُ اللَيلَ بِالأَذكارِ",37,"ر",1,0],["الصابِرينَ إِذا حَلَّ البَلاءُ بِهِم","كَاللَيثِ عَضَّ عَلى نابَيهِ في النُوَبِ",38,"ب",1,0],["الصَومُ وَالفِطرُ وَالأَعيادُ وَالعَصرُ","مُنيرَةٌ بِكَ حَتّى الشَمسُ وَالقَمَرُ",39,"ر",1,1],["الصلب يخلط بالرطوبة مدة","فيصير رطباً سائلاً طيارا",40,"ر",2,1],["الصَبرُ مِفتاحُ ما يُرجّى","وَكُلُّ خَيرٍ بِهِ يَكونُ",41,"ن",1,1],["الصِدقُ شَيءٌ لا يَقومُ بِهِ اِمرُؤٌ","إِلّا وَحَشوُ فُؤادِهِ الإيمانُ",42,"ن",1,0],["الصَبرُ أَنجى مَطيِّ عَزمٍ","يُطوى بِهِ السَهلُ وَالحُزونُ",43,"ن",1,0],["الصَمتُ في غَيرِ فِكرَةٍ سَهو","وَالقَولُ في غَيرِ حِكمَةٍ لَغو",44,"و",1,1],["الصِدقُ إيمانٌ وَرُبَّتَما","عِندَ الضَرورَةِ يَنفَعُ الكَذِبُ",45,"ب",1,1],["الصادِقُ الوَعدِ كَما جاءَ بِهِ","نَصُّ الكِتابِ وَالصَحيحِ المُسنَدِ",46,"د",1,0],["الصالِحِ المَلِكِ الَّذي أَكنافُهُ","كَهفُ الوُفودِ وَكَعبَةُ الفُقَراءِ",47,"ا",2,0],["الصالِحِ السُلطانِ وَه","هابِ النَفائِسِ لِلنُفوسِ",48,"س",1,0],["الصالِحِ المَلِكِ الَّذي بِسَماحِهِ","أَمسى الثَرا وَطأً لِمَن وَطِىءَ الثَرى",49,"ر",2,0],["الصالِحِ المَلِكِ الَّذي إِنعامُهُ","قَيدُ الغَنِيِّ وَطَوقُ جيدِ المُفلِسِ",50,"س",1,0],["الصالِحِ المَلِكِ الَّذي نَعماؤُهُ","قَد أَغنَتِ الغُرَباءَ عَن أَوطانِها",51,"ن",3,0],["الصالِحُ المَلِكُ الَّذي إِنعامُهُ","كَنزُ الفَقيرِ وَطَوقُ جيدِ المُغتَني",52,"ي",1,0],["الصالِحُ المَلِكُ المَشكورُ نائِلُهُ","وَرُبَّ نائِلِ مُلكٍ غَيرِ مَشكورِ",53,"ر",1,0],["الصالِحُ المَلِكُ الَّذي صَلُحَت بِهِ","رُتَبُ العَلاءِ وَلاحَ طالِعُ سَعدِهِ",54,"د",2,0],["الصّبا في ريح لبنا","ن رقيق النفحات",55,"ت",1,0],["الصبا لن أراه","والهوى لن يعود",56,"د",1,0],["الصبا لن أراه","والهوى لن يؤوب",56,"ب",1,0],["الصبح شرّ بغيضِ","والليلُ خير حبيبِ",57,"ب",1,1],["الصَبرُ كاسٍ وَبَطنُ الكَفِّ عارِيَةٌ","وَالعَقلُ عارٍ إِذا لَم يُكسَ بِالنَشَبِ",58,"ب",1,0],["الصُبحُ مَشهورٌ بِغَيرِ دَلائِلٍ","مِن غَيرِهِ اِبتُغِيَت وَلا أَعلامِ",59,"م",1,0],["الصَبرُ أَجمَلُ غَيرَ أَن تَلَدُّداً","في الحُبِّ أَحرى أَن يَكونَ جَميلا",60,"ل",2,0],["الصَبرُ أَجمَلُ وَالقَضاءُ مُسَلَّطٌ","فَاِرضَوا بِهِ وَالشَرُّ فيهِ خِيارُ",61,"ر",1,0],["الصّادعُ الأزماتِ يَتركُ لَيْلُها","أَهْدَى الهُداةِ مُضَلَّلاً حَيْرانا",62,"ن",2,0],["الصيدُ من نُسُكِ الحياةِ لِمُتَّقٍ","يخشَى عذابَ الهُونِ حين يُصادُ",63,"د",1,0],["الصاعِدينَ عَلى العروشِ جَماجِماً","الرافِعينَ ذُرى القُصورِ رِقابا",64,"ب",2,0],["الصُلحُ أَجمَلُ وَالجُنودُ أَعِزَّةٌ","وَالسِلمُ أَفضَلُ وَالسُيوفُ حِدا