{"poems":[[10,"طرق النعي على صفينة غدوة","https://www.aldiwan.net/poem21083.html","الكامل"],[87,"الحيوان خلق له عليك حق","https://www.aldiwan.net/poem7932.html","مجزوء الرجز"],[33,"إن الخليط مودعوك غدا","https://www.aldiwan.net/poem42570.html","الكامل"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54954","الكامل"],[92,"الخريف في فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179054",""],[123,"ركب إلى نار الجحيم مسيرهم","https://www.aldiwan.net/poem4349.html","الكامل"],[154,"كانت للمسرة معهدا","https://www.aldiwan.net/poem68484.html","الطويل"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[215,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[309,"يا هاجري كم ذا تكون مهاجري","https://www.aldiwan.net/poem16862.html","الكامل"],[333,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[347,"كسف هذي تراها ام ليالي","https://www.aldiwan.net/poem55324.html","الرمل"],[382,"ألحي قبلا هو القدوس ثم هو","https://www.aldiwan.net/poem59419.html","الطويل"],[438,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[519,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133835","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46545","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110278","الخفيف"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92053","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205883",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73095","الكامل"],[4702,"الصحبة اللي غرت القلب","https://www.poetsgate.com/ViewPoem.aspx?id=155197",""],[4764,"خذني معك","https://www.poetsgate.com/ViewPoem.aspx?id=26378",""],[4778,"الحي أكرم منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=204702",""],[4867,"بعض","https://www.poetsgate.com/ViewPoem.aspx?id=13196",""],[4916,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=177311",""],[709,"عَرِّجْ عَلَى الْبَانِ وانْشُدْ فِي مَجَانِيْهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2907",""],[5461,"قصيدة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=5295",""],[5573,"كل ذكرى في حياتك هي حياتك","https://www.poetsgate.com/ViewPoem.aspx?id=204558",""],[5587,"الدنيا يا الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=197804",""],[5606,"يالله إن الحكم بيديك والشكوى عليك","https://www.poetsgate.com/ViewPoem.aspx?id=194673",""],[5756,"الليالي السرمدية","https://www.poetsgate.com/ViewPoem.aspx?id=5438",""],[5893,"ما للعرب تاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=141278",""],[5976,"يا حرف","https://www.poetsgate.com/ViewPoem.aspx?id=30520",""],[5976,"مخاوين إسْعدي","https://www.poetsgate.com/ViewPoem.aspx?id=33492",""],[5997,"الموتُ","https://www.poetsgate.com/ViewPoem.aspx?id=214291",""],[6093,"أخشاب وأحجار","https://www.poetsgate.com/ViewPoem.aspx?id=198909",""],[6102,"وطن ولا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=182752",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""]],"verses":[["الحَيُّ يَعلَمُ أَنَّ جَفنَتَهُ","تَغدو غَداةَ الريحِ أَو تَسري",0,"ر",2,0],["الحَيوانُ خَلقُ","لَهُ عَلَيكَ حَقُّ",1,"ق",1,1],["الحَينُ ساقَ إِلى دِمِشقَ وَما","كانَت دِمِشقُ لِأَهلِنا بَلدا",2,"د",2,0],["الحياةُ البَغيُ والدِّينُ الهَوى","والضّعيفُ الخَصمُ والسّيفُ الحكمْ",3,"م",1,0],["الحَيُّ أَعْطَى نَاظِرينَ أَلَيْسَ مِن","غُبْنٍ عَلَيْهِ الاجْتِزَاءُ بِنَاظِرِ",4,"ر",1,0],["الحيُّ بادٍ عُجْبُه وعندَه","عجيبُ أمرٍ مضحكٍ بديعه",5,"ع",2,0],["الحيُّ منهم لا يُرى مستوطِنا","والمَيتُ منهم لا يُرى مقبورا",6,"ر",2,0],["الحيا ما دام حياً خيالها","سجالاً يكلُّ الليل عنهن الوزن",7,"ن",1,0],["الحيُّ والمحيي الطبيبُ الفطنُ","قامَت بهِ بعدَ الممات السننُ",8,"ن",1,0],["الحياة الحقّ حربٌ وعناء","وتهاويل بروق ورعود",9,"د",1,0],["الحياة الحقّ يؤذيها الأمان","من شقاء الروح في دنيا ودين",9,"ن",1,0],["الحياة الحق يؤذيها القرار","فانشدوا الراحة في ظل الحتوف",9,"ف",1,0],["الحيلي المشهور فرد زمانه","شيخ الشيوخ بباطن وبظاهر",10,"ر",1,0],["الحياة الحياة حولي وما أز","جوه منها ضرورة لوجودي",11,"د",2,0],["الحياة خالبات من بروق","والانام سافيات من رمال",12,"ل",1,0],["ألحي قبلاً هو القدوس ثم هو ال","ملك العظيم فلا يدنوه إنكارُ",13,"ر",1,1],["الحَيَا من غُيوثِكَ البارقاتِ","والجَنَى من أُصولِكَ الباسِقاتِ",14,"ت",1,1],["الحيدَريُّ الّذي دانَ الزّمانُ له","حتّى اِستكانَ وخافَتْهُ دَواهِيهِ",15,"ي",2,0],["الحي أنت ولو دهت","عينيك داهية الغياب",16,"ب",1,0],["الحيلة الخفيه","كَالصعدة الخَطيه",17,"ه",1,0],["الحي والقيوم باق لا يبيد","سبحانه ذو الطول مبدي ومعيد",18,"د",1,0],["الحياةُ الحياةُ عندهم ما","لٌ وقصفٌ ومرقصٌ وغواني",19,"ن",2,0],["الحى والحياة وصف ذاته","لا يدخل التكييف في صفاته",20,"ه",1,0],["الحَيُّ للموت وَالمَوجودُ للعدمِ","وَالفَرحُ للحُزن وَالشبانُ للهرمِ",21,"م",1,1],["الحياة الحق ناضرة","فاقطفوا من غصنها النضرِ",22,"ر",1,0],["أُلحي عليكَ ولو دَرى بصبَابتي","لأراحني من لومه مَن يعذُلُ",23,"ل",1,0],["الحي فعله حي يبقى ولو مات","ذكره ينومس كل جيلٍ يجوني",24,"ن",2,0],["الحين يِرجع وأكتفي مِن طيوفك","يِجعل غِيابك يَا هنا الروح خَيره",25,"ر",2,0],["الحي أكرم عند الناس منزلة","وما الحياة سوى للراسخ الأبقى",26,"ق",2,1],["الحياة لها قوس وقوس يحدي","تبتدي بصياح وتنتهي بخلاف الامري",27,"ر",2,0],["الحياه اللي تفنّن في اختباري","كل يوم يمر بي اكره شعوره",28,"ر",2,0],["أَلْحَيْدَرِيُّ الَّذِي دَانَ الزَّمَانُ لَهُ","حتّى استكانَ وخافتْ دواهيهِ",29,"ي",2,0],["الحياة آشوفها والموت فيني","واعذاب اللي بغاك ولا لقاك",30,"ك",1,0],["الحياه اتمر بك مافات فاتك","إنقضى ماعاد يرجع لك نديمه",31,"م",2,0],["الحْيَاةْ فِيهَا وْدَاعَةْ","وْ آهْ يَا مُوتْ كَانْ تَدِينِي",32,"ن",2,0],["الحياة الى اصبحت بين ذاك وبين ذيك","لا تلومون الذي من شقاها ملها",33,"ل",3,0],["الحياه اللي تسمي لعبة الشاطر خطيه","ماتساوت في عيوني مع جناحين الذبابه",34,"ب",2,0],["الحين تنهض خير من عض الإبهام","ما ينفع الحسره ضياع السياده",35,"د",2,0],["الحين جا وقت البلش نبغي العون","يا جعْل تفداك العفون الملاعين .. !!",36,"ن",1,0],["الحين انا خصمك وَأَنت المعتدي .. !!","ولا جاز لي منك المجامل بالكلام .. !!",37,"م",1,0],["الحيُّ موَّات فمن ذاك الذي","نالَ الخلود بسائرِ الأجناسِ",38,"س",1,0],["الحيُّ والدَّارُ والأبوابُ إنْ رحلوا","عنَّها الأحبَّةُ أخشابٌ وأحجَارُ",39,"ر",1,0],["الحَينُ في مَنفاهُ أَرحَمُ لَو","في غَمرَةِ التَّحنانِ يَقتَحِمُهْ",40,"م",2,0],["الحياةُ وقد عَرفنا ظِلال","أيّ كسبٍ لمن تفيّأ ظِلاّ ً؟",41,"ل",2,0]]}