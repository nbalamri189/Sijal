{"poems":[[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[74,"ولائط ألثغ قلنا له","https://www.aldiwan.net/poem19254.html","السريع"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[93,"لمني إذا حلت عن عهودي","https://www.aldiwan.net/poem62733.html","عموديه"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[89,"ديني الحنيف وربي الله","https://www.aldiwan.net/poem8200.html","أحذ الكامل"],[71,"يقول بدر طالع","https://www.aldiwan.net/poem28321.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54827","الخفيف"],[147,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[164,"عندي لوالد أحمد ولأحمد","https://www.aldiwan.net/poem58984.html","الكامل"],[228,"عند ذا هب جالسا وتهيا","https://www.aldiwan.net/poem41607.html","الخفيف"],[325,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[438,"لا تجرد علي مرهف جفني","https://www.aldiwan.net/poem12738.html","الخفيف"],[470,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[505,"بين الكتائب والكثبان جلجلة","https://www.aldiwan.net/poem37780.html","البسيط"],[580,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122312","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64042","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70808","السريع"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138103",""],[1135,"","https://poetry.dctabudhabi.ae/diwan/poem/124200","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87820","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71052","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48249","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77205","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201148","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201039","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205082","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205054","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204695","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202989","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79716","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112577","المجتث"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103625","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132009","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111049","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33304","الخفيف"],[4927,"مؤامرات ومؤتمرات سورية","https://www.poetsgate.com/ViewPoem.aspx?id=79602",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[5216,"قناة السويس","https://www.poetsgate.com/ViewPoem.aspx?id=187002",""],[5277,"أمرأةُ العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=210686",""],[5295,"رسالةٌ من حواء","https://www.poetsgate.com/ViewPoem.aspx?id=210738",""],[5314,"أحدث غيما","https://www.poetsgate.com/ViewPoem.aspx?id=214822",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5464,"يا هند","https://www.poetsgate.com/ViewPoem.aspx?id=6842",""],[5536,"أنا وعشتار!!","https://www.poetsgate.com/ViewPoem.aspx?id=37059",""],[5664,"دعوة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=46525",""],[5703,"أميرة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=206077",""],[5853,"صمت الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=175622",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6102,"تقولين خذني","https://www.poetsgate.com/ViewPoem.aspx?id=183319",""],[6237,"هموم الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77903&r=&rc=45",""]],"verses":[["أَنا أُمُّ التَشريعِ قَد أَخَذَ الرو","مانُ عَنّي الأُصولَ في كُلِّ حَدِّ",0,"د",1,0],["أنا امرؤ درهم تحصيله","يخرج من بغَّا إلى بغَّا",1,"غ",2,0],["أنا أميرُ الشعر في وصف ذا","ومدح ذا رُتّب ديوانه",2,"ن",2,0],["أنا أميرُ الكلام لا كَذباً","أصدعُ بالفخر غيرَ فيّاش",3,"ش",1,0],["أَنا إِمامُ الَّذينَ هاموا","وَأَيُّ قَومٍ بِلا إِمامِ",4,"م",1,0],["انا اما حضرت فالقوم خرس","واذا لم احضر فهم غير خرس",5,"س",1,0],["أَنَا أُمَّةٌ وَحْدِي عَلَى سَرَفٍ","فِي حُبِّهِ وَالنَّاسُ أَشْبَاهُ",6,"ا",2,0],["أنا إمامي مالكٌ","فقلتُ أنتَ مالكي",7,"ي",1,0],["أَنَا أَمضِي مُدَافِعاً عَن بِلاَدي","ذَائِداً دُونَهَا العَدُوَّ المُغِيرَا",8,"ر",2,0],["إِنا أَمِنّا السوءَ مُنذُ وَليتَنا","فَوَقَتكَ أَنفُسُنا مِنَ الأَسواءِ",9,"ا",2,0],["أنا آمن منه بعنقي ذمة","عندي لوالد أحمد ولا حمد",10,"د",1,0],["أَنا أَمشي إِلى الضَريحِ حَثيثاً","فَعَذابي يَثورُ في رِئَتَيّا",11,"ي",2,0],["أَنا أَمشي وَأَنتَ تُقبِلُ نَحوي","كَحبيبٍ مُسافِرٍ جاءَ مِن صُدفَه",12,"ف",2,0],["أنا أمشى في الناس بائع خبزٍ","زاهداً فيه قانعاً بالفتات",13,"ت",1,0],["أَنا اِمرُؤٌ عَجِبتَ اَو لَم تَعجَبِ","يَأكُلُني الهَمُّ إِذا لَم أَشرَبِ",14,"ب",1,0],["أنا إمّا حيٌّ ينفخ المزامي","رَ وإما ميْتٌ يجس المثاني",15,"ن",2,0],["إنَّا امتُحِنَّا بِأيام ٍ بِنا امتُحِنَتْ","تَعْدو عَلَينا ، وَتَشكو مِن تَغاضِينا !",16,"ن",2,0],["أَنا امرؤٌ تُرهِبُ الأَيَّام زفْرَتُهُ","واللَّيلُ منه لبَرِّ الفجرِ ينهزِمُ",17,"م",1,0],["أَنَا أَميرُ العُشَّاقْ","قَلْبي لِوائي الخفَّاقِ",18,"ق",1,1],["انا امرؤ صنعتي التغزل والمد","ح وفني الانشاء والخطب",19,"ب",1,0],["أنا إِما خَلَفتني فيه بالح","نى ولم أَجْزِ عاجزٌ متخلِّف",20,"ف",1,0],["أنا امرؤ لا يغرُرَنِّي امرؤ","تعجَّب الراءون من لُبسه",21,"س",2,0],["أنا امرؤ هاضت الأشجان جانبه","فبات ما بات مطويا على شجن",22,"ن",1,0],["أنا امرؤ أنكر ما","يعرف أهل الأدب",23,"ب",1,0],["إِنّا أَملنا الخَيرَ يَومَ قُدومِها","فَعَسى الإِلَهُ يُحَقِّقُ المَأمولا",24,"ل",2,0],["أَنا امْرُؤُ بلَغَتْ نفسي بما أَمَلَتْ","وإِنَّني في بني الدنيا لهم عَلَمُ",25,"م",1,0],["أنا امرؤ قد تركتُ اللهوَ حين بدا","صُبْحُ المشيبِ ولم يَعْقُبْهُ تغليسُ",26,"س",1,0],["أَنا اِمرُؤ في صَميمِ الذُلِّ مَرتَبَتي","مِن مِصرَ لا نَبَطاً قَومي وَلا جَلَبا",27,"ب",2,0],["أنا إما أحببت خلا فاني","جاعل ظلهُ عليّ لزاما",28,"م",2,0],["أنا إما أجدتُ نسخاً لشعري","لم تر العين عيبه وفسادَه",29,"د",2,1],["أنا اما أن لا أكون كغيري","شاعراً أو أكون وحدي الشاعر",30,"ر",1,0],["أنا أمشي ولم أزل في مكاني","أنا كهلا ما زلت مثلي صبيا",31,"ي",2,0],["أنا إمّا عزمت أمراً أكمّلْ","ه ولو أبصر الممات حياله",32,"ل",2,0],["أنا إما فقدت خلاً ودودا","زاد قلبي بأساً وعزماً جديدا",33,"د",2,1],["أنا أمكم مصر التي ساء حظها","وحاق بها خطب الدخيل المشاغب",34,"ب",1,0],["أنا أمكم مصر التي هد ركنها","بما حملوها من صنوف المتاعب",34,"ب",1,0],["أنا أمكم مصر التي أنشأتكم","تمنون فيها من جميع الرغائب",34,"ب",1,0],["أنا إمام الطليعة","إذ يلتقي الجيشان",35,"ن",1,0],["إنَّا أمنا من الأيام غائلها","ومن حتوف الليالي خوض اغمار",36,"ر",1,0],["أنا امرؤ ان نبت بي أرض اندلس","جئت العراق فقامت لي على قدم",37,"م",1,0],["أنا أم سحنون الذي طار صيته","وأم لقوم شيدوا المجد والعلا",38,"ل",2,0],["أنا أمكم ثكلى فقدت ممجدا","به ضنت الأيام أن تفضلا",38,"ل",2,0],["أنا أمسيت أحمل الذنب رضوى","وثبيراً حملته فوق ظهري",39,"ر",2,0],["أنا أملي حروفهُ ودموعي","يتبعنَ الهوى ويشفينَ صدرا",40,"ر",2,0],["أَنَاْ آمَنْتُ أَنَّ النَّصْرَ آتٍ","وَإِنْ طَاْلَ الْحِصَاْرُ عَلَى الْحِصَاْرِ",41,"ر",1,0],["أنا أموت ويبقى لي دمٌ وبهِ","تحيا المهارق من دوني إلى الأزل",42,"ل",1,0],["أنا أمضي على عهد انتمائي","فإن الحرَّ من يوفي عهودَهْ",43,"د",2,0],["أنا أمٌ لكلِّ شبابِ مصرٍ","وإنَّ الأمَّ تحتضنُ الصَبيّا",44,"ي",2,0],["أنا امْراةٌ تلبّسها قنوطٌ","وأخبارُ الوشاةِ عَليّ تترى",45,"ر",2,0],["أنا امْرَأَةٌ مِنْ ضِلْعِ آدَمَ جِئْتُ كيْ","يعودَ إلَى الْفِرْدَوْسِ حينَ أقابِلُهْ",46,"ل",2,0],["أنا امرأة من نجع يعرب مرتعي","خلود ولي مد الخلود أصول",47,"ل",1,0],["أنا أمكَ وأبوكَ فلانٌ","لن يرضى أبداً أن تُقتل",48,"ل",1,0],["أنا أمَّةٌ في الحزنِ لا نَفَرٌ","أمّا الهوى فأنا به الفَرْدُ",49,"د",1,0],["انا امتداد لعصر ما قبل امتداد الانكماش","وانا انكماش لا يديلوجيات تقديس الوثن!",50,"ن",1,0],["انا امك ياهيه امك حملتك والعذاب الوان","ولدتك والالم سكين يركز داخل لهاتي",51,"ت",2,0],["أنا أميرةُ عِشْقٍ ما لَها شَبهٌ","كما أراكَ بعين القلبِ سُلطانا",52,"ن",2,0],["أنا أمضي إلى الهوى وأغني","بين حبي وثورتي وانتصاري",53,"ر",2,0],["أَنا أُمَّةٌ بِالشِّعرِ ؛ أَلفُ قَبِيلَةٍ","لَكِنَّنِي فِي الحُبِّ قَلبٌ واحِدُ",54,"د",1,0],["أَنَا أُمَّةٌ - بِالشِّعْرِ - وَ النَّاسُ أَحْرُفٌ","إِذَا الْتَمَّ شَمْلُ النَّاسِ ظَلَّ لَفِيفا",55,"ف",2,0],["أنا آمنت بالذي خلق الكون","وما فيه من هدى أو فسادِ",56,"د",1,0]]}