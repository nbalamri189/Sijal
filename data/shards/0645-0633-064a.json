{"poems":[[55,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[55,"يا ناشد النعماء يقفو إثرها","https://www.aldiwan.net/poem30480.html","الرجز"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[95,"وافى الكتاب فأحيا","https://www.aldiwan.net/poem9828.html","عموديه"],[74,"مسئلة الدار غدت","https://www.aldiwan.net/poem18348.html","مجزوء الرجز"],[87,"الليل بدموعه جاني","https://www.aldiwan.net/poem6808.html","عموديه"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[47,"لديك هوى النفس اللجوج وسولها","https://www.aldiwan.net/poem65582.html","الطويل"],[107,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[48,"مسيحية من قبلها موسوية","https://www.aldiwan.net/poem22142.html","الطويل"],[48,"ألا إن الظباء لفي غرور","https://www.aldiwan.net/poem22262.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16692","الكامل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/854","الوافر"],[119,"هززت لهمي والزمان المعاند","https://www.aldiwan.net/poem41155.html","عموديه"],[136,"أثار غريمى وشجا عقيلى","https://www.aldiwan.net/poem54762.html","الطويل"],[185,"ألا حييا الأطلال بالجرع العفر","https://www.aldiwan.net/poem59043.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[197,"كتبت وليلي بالسهاد نهار","https://www.aldiwan.net/poem13040.html","الطويل"],[214,"مسير قد ألم به هناء","https://www.aldiwan.net/poem13311.html","الوافر"],[371,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[409,"صفي الدين قد وافى النظام","https://www.aldiwan.net/poem33417.html","الوافر"],[505,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[568,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120096","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120090","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120030","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121646","الوافر"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3487,"","https://poetry.dctabudhabi.ae/diwan/poem/111547","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62928","المتقارب"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117858","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70132","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133169","المتقارب"],[4797,"ذالليل كن نجومه شوي واشتات","https://www.poetsgate.com/ViewPoem.aspx?id=132228",""],[254,"َمسى سُمَيرٌ قَد بانَ فَاِنقَطَعا","https://www.poetsgate.com/ViewPoem.aspx?id=37551",""],[5277,"دفّةُ الأفلاك","https://www.poetsgate.com/ViewPoem.aspx?id=185841",""],[5277,"غزال الكرخ","https://www.poetsgate.com/ViewPoem.aspx?id=187701",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5386,"بين ضلوعنا","https://www.poetsgate.com/ViewPoem.aspx?id=35004",""],[5431,"ونور من الرحمن يجلو وساوسي","https://www.poetsgate.com/ViewPoem.aspx?id=189700",""],[5431,"أمريم في الأقصى وأنت الممانعُ","https://www.poetsgate.com/ViewPoem.aspx?id=190318",""],[5431,"ودفء به طهرٌ جليٌ وملمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=190446",""],[5444,"إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205072",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5616,"الصقر","https://www.poetsgate.com/ViewPoem.aspx?id=205772",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5725,"مسّيته بدرا","https://www.poetsgate.com/ViewPoem.aspx?id=178243",""],[5818,"تعلّمت أنّ الأمور الكبيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=193177",""],[5950,"الشرهه الراهية للطيّب الراهي","https://www.poetsgate.com/ViewPoem.aspx?id=140770",""],[5956,"إسلام ساندرا","https://www.poetsgate.com/ViewPoem.aspx?id=193137",""],[6093,"إِذَا وَعَظَ المَوْتُ الحَيَاةَ ( الطّويل )","https://www.poetsgate.com/ViewPoem.aspx?id=187181",""],[6125,"فَظِيعٌ ما أحلُّوا أو أبَاحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=210570",""],[5464,"يا أخت هارون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66201&r=&rc=20",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""]],"verses":[["مَسيري إِلى لَيلِ الشَبابِ ضَلالُ","وَشَيبي ضِياءٌ في الوَرى وَجَمالُ",0,"ل",1,1],["مُسيلَةً بَينَ العَقيقِ وَالحِمى","أَضواجَ بَطنِ الأَرضِ أَو أَجزاعَها",1,"ع",3,0],["مَسيلُها فينا وَمُستَقَرُّها","طَودُ العُلى وَشَمسُها وَبَدرُها",2,"ر",3,0],["مَسيرٌ مَعَ الأَقدارِ ما فيهِ وَنيَةٌ","وَلا وَقعَةٌ بَعدَ اللُغوبِ لِراكِبِ",3,"ب",1,0],["مُسَيَّجُ مِنْ غَرَامِي","وَغَيْرَتِي بِلَهِيبِ",4,"ب",1,0],["مسئلة الدار غدتْ","بيني وبين من أحب",5,"ب",1,1],["مِسير الأيام تجمعنا","إن كان في الصبر بقايه",6,"ا",3,0],["مُسَيطِرُ الفُرسِ يَبغي في رَعِيَّتِهِ","وَقَيصَرُ الرومِ مِن كِبرٍ أَصَمُّ عَمِ",7,"م",1,0],["مَسيرٌ تَلَقّى الأَرضُ مِنهُ رَبيعَها","وَيَبهَجُ عَنهُ حَزنُها وَسُهولُها",8,"ل",3,0],["مسيحَ الهندِ إنّ بمصرَ شعباً","يَشُقُّ عليكَ إن خَضَعَ الهنودُ",9,"د",1,0],["مَسِيحٌ من بني عُثمانَ سَمْحٌ","يُرينا الحقَّ أسطعَ واليقينا",10,"ن",2,0],["مَسيحِيَّةٌ مِن قَبلِها موسَوِيَّةٌ","حَكَت لَكَ أَخباراً بَعيداً ثُبوتُها",11,"ت",3,1],["مَسيرُكَ في البِلادِ أَقَلُّ رُزءاً","مَعَ الفِئَتَينِ مِن قُمَرٍ وَخُرجِ",12,"ج",1,0],["مَسّي البَياضَ لَعَلّ شَرْخاً عائدٌ","أو عَلّ نَشْرَكِ بالمَشيبِ يَصُوك",13,"ك",1,0],["مُسيءٌ مُحسِنٌ طَوراً وَطَوراً","فَما أَدري عَدُوّي أَم حَبيبي",14,"ب",2,1],["مسيلمة الكذاب والقوم حوله","دعاهم حيارى بين بال وشارد",15,"د",1,0],["مُسَيئِيمُ الخُلَيِّقَةِ إبتَدَاءً","مُنَيكِيرُ القُوَيلَةِ في الحُويلِ",16,"ل",1,0],["مُسيلُ الرُّيا واهِى الكُلَى سَبِطُ الذُّرا","أَهلّةُ نَضّاخِ النّدَى سابِغ القَطرِ",17,"ر",1,0],["مُسيلمةُ الجدُّ الكبير وعرسهُ","سَجاحٌ لكلٍّ منهمُ الجدّةُ الكبرى",18,"ر",2,0],["مَسيرٌ دَعاهُ الناسَ سَيراً","تَوَسُّعاً وَمَعنى اِسمِهِ إِن حَقَّقوهُ أَسارُ",19,"ر",1,0],["مسير قد ألمّ به هناء","ودهرٌ كل ما فيه صفاءٌ",20,"ا",2,1],["مَسيرُ بِلا نُجحٍ وَلا أَمَلٍ لَهُ","وَلا نِيَّةٍ في العَودِ ثَمَّ وَلا الصَبرِ",21,"ر",1,0],["مسير الشمس سارت في النواحي","فما عنها خلا يوماً مقام",22,"م",1,0],["مُسَيْكِينُ قلبي ذابَ من لوعَةِ النَّوى","ووالاهُ جمرٌ لاهِبٌ وزُلالُ",23,"ل",1,0],["مُسيموا الغَضيَياتِ بِكُلِّ أَرضٍ","حَماها الخَوفُ غاشِيَة المُسيمِ",24,"م",1,0],["مسيت يا مجد الهدى","والدين والمولى المظفر",25,"ر",1,1],["مسيت بالخير يا جوادا","ما مس من يجتديه ضر",26,"ر",1,1],["مسّيت بالخيرات يا منعما","إن جار دهر فبه نستجير",27,"ر",1,1],["مَسِيرَ زامَينِ بأريَاحِ الصُّوَر","يَبعُدُ لَم يُشتَافَ مِنهَا بالنَّظَر",28,"ر",1,0],["مسير ستَّه أشهرٍ حقيقَه","إفهَم وَجملَه جُزرٍ في الطريقَه",29,"ه",1,0],["مَسِيرَةَ أربَعَةِ أزوَامِ","بِريحِ أزيَب كَمُلا تَمَامِ",30,"م",1,0],["مَسَيرَ يَا خِي سَبعَةِ أَيَّامِ","يَجُونَ بالشَّاشَاتِ يَا هُمَامِي",30,"ي",1,0],["مَسِيرُ شَهرٍ عَن سُفَالَه مَغرِب","يَمِيلُ لِلشَّمَالِ عًن مُجَرِّب",30,"ب",1,0],["مسية من سيرة أي سيرة","فخذها فقد دلت على حسن سيرتي",31,"ي",1,0],["مَسِيلُ الصبحِ طَمَّ على الكواكبْ","وقد ظمِئتْ إلى السَّيْرِ النَّجائِبْ",32,"ب",1,1],["مسيره عن ان يحل الجبهة","كذاك ان صار وولى وجهه",33,"ه",1,0],["مسيحية خوطية كلما انثنت","تشكت أذى الزنار من رقة الخصر",34,"ر",1,0],["مَسيح الجميمِ بها والهَشيمِ","فكلُّ مَسيمٍ بها عابِثُ",35,"ث",1,0],["مسيلمة الكذاب منهم بلا حيا","يسمّي ابن بنت المصطفى بابي جهل",36,"ل",1,0],["مسيل الندى الفياض من جود أحمد","ومسطور آيات التجلّي وطورها",37,"ر",3,0],["مسيحيّو بني الشَهباءِ جادوا","وَشادوا حصنَ مقبرةٍ مؤبد",38,"د",1,0],["مسيطرٌ في كل أعمالها","يندمج الكل بشخصيته",39,"ت",2,0],["مسير العباد في البلاد","وحامل العافي بأدنى زاد",40,"د",1,0],["مسيكين من حب حياته معذب","فإني لكم صب ألا فاسعفوني",41,"ي",1,0],["مسيرها دقات واكثره وقفات","هي ريضه وانا ارقب الصبح واخيل",42,"ل",1,0],["َمسى سُمَيرٌ قَد بانَ فَاِنقَطَعا","يا لَهفَ نَفسي لِبَينِهِ جَزَعا",43,"ع",2,1],["مسيرةُ روحِ الحبِّ أحلامُ شاعرٍ","يُهَدْهِدُهُ الحبُّ المحيطُ بهِ الوجدُ",44,"د",1,0],["مسيرتي ترسم الأحلامُ خطوتَها","وتحتسي جذوةً مشبوبةً وطرا",45,"ر",2,0],["مسيرٌ موجعٌ طبعُ الليالي","بدربِ الموتِ ساقَ الناسَ حتْمُ",46,"م",1,0],["مسّيك بالخير ( اهجدي ) ... يا دمعة وخِلّك معاك","أرجوك لا تستكثري جرحٍ ........... صداه يطولنا",47,"ن",2,1],["مسيحا بروح القدس عمّ سلامه","وأحيا بما في الحب عندّ التلامسِ",48,"س",1,0],["مسيح سيأتي من بطون كثيرة","وعشقك ولّادٌ ونحن المزارعُ",49,"ع",1,0],["مسيحٌ بآلامي وقلبيَ كيّسُ","يداوي جراحاتٍ غلاظاً ويؤنسُ",50,"س",1,1],["مسيرةٌ، صدقاتٌ ، والدعاءُ لهم","قصائدٌ ، قممٌ ، موجٌ من الخُطب",51,"ب",1,0],["مُسَيْلِمَةُ الكَذَّابُ مِنْ قَبْلِ ذَا ادَّعَى","نُبُوءَتَهُ فِي قَوْمِهِ وَسَجاحُ",52,"ح",1,0],["[ مُسَيْطِرٌ فِي أُولِي الأَلْبابِ دَيْدَنُهُ","يُحْيِي وَيُتْلِفُ إِنْ صافَى وَإِنْ هَجَرا ]",53,"ر",2,0],["مسيلمة يمر على السرايا","وتنفخ في رمادهم سجاح؟",54,"ح",1,0],["مسيحية الاخلاص في مذبح الهوى","ترى في دماء العشق صٓلْباً مقدسا",55,"س",2,0],["مسّيته بدرا اتى مقمرا","يشعّ في وجه الدجى مزهرا",56,"ر",2,1],["مسيرة عام ٍ ب خطوةِ رِجْل ٍ","وأولى الخطى للرضيع عثيرةْ",57,"ر",2,0],["مسيّت حبلك وطاح بقصرك الواهي","ولولا التجارب فكلّ الناس خيّاله",58,"ل",2,0],["مسيحُ الحب يمزج أصغريهِ","بدينِ كرامةٍ وبدينِ عدلِ",59,"ل",1,0],["مَسِيرٍ بَأَرْوَاحٍ ويَحْدُو مَسِيْرَها","دُمُوعُ مُحِبٍّ أَوْ نُوَاحُ الثَّوَاكِلِ",60,"ل",1,0],["مُسَيلَمةٌ تَقلَّد كلَّ عرشٍ","ويَنْصِبُ في دِمَائهمُ القِدَاحُ",61,"ح",1,0],["مُسَيَّرون جموعاً لا خيار لها","ونَحْسَبُ القاتلَ المأجورَ حامينا !",62,"ن",2,0],["مسيَّجٌ بشذاها –خاشعاً- جسدي","يغتاله من أقاصي بوحِِه الدَّنفُ",63,"ف",1,0]]}