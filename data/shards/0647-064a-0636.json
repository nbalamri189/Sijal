{"poems":[[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[466,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122859","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53100","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112598","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45008","الكامل"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28783","الخفيف"],[585,"ما للديار خلت لكل شريد","https://www.poetsgate.com/ViewPoem.aspx?id=161917",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5956,"القومية الآدمية الحوّائية العالمية","https://www.poetsgate.com/ViewPoem.aspx?id=182850",""]],"verses":[["هي ضربةٌ بالسيف إلا أنه","سيفٌ ضرْبتَ به وَلِيَّكَ مُصْفَحَا",0,"ح",2,0],["هيضَ الجناحُ وضِقتُ","ذَرعاً بالجناحِ المستعارِ",1,"ر",1,0],["هي ضوْءٌ وهو ضوْءٌ ونَدىً","كُلَّما أشْرَقَ بِشْراً هَتَنا",2,"ن",2,0],["هي ضرة لك في التماع ضيائها","وبحسن صورتها لدى ايقادها",3,"د",3,0],["هي ضعضعت شمَّ الجبال وأخضعت","من لم يكن لمذلّة متعودا",4,"د",2,0],["هي ضد بكل هم وحزن","هل ترى ظلمة مع النبراس",5,"س",1,0],["هي ضجعة روحي بها في جنة","ماذا يهم إذا فقدت حياتي",6,"ت",2,0],["هَيضَ الجَناحُ وَبَلَغَ السَيل الزُبى","إِن لَم تُعالِج زائِفي بِرواج",7,"ج",1,0],["هيضت جسور المعالي بعد لائمها","وانأد غصن الندى إذ بان وازره",8,"ر",2,0],["هيضَ عَظمي الغُداةَ إِذ صِرتُ فيهِ","إِنَّ عَظمي قَد كانَ غَيرَ مَهيضِ",9,"ض",1,1],["هي ضجةٌ خرست وخطةُ عصبةٍ","درست وإن السهم غير سديد",10,"د",1,0],["هيضت لواعجٍ وسط الفواد","المنازل والرسوم الدارسات",11,"ت",1,0],["هي ضدُّ وحدة كوننا أمُّ الأذى","ترمي بنا نحو التأزَّم والبِلى ‏",12,"ل",2,0]]}