{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[90,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[49,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[53,"إن أبا حفص وعثنونه","https://www.aldiwan.net/poem8163.html","السريع"],[63,"قد أغتدي والصبح في إقدامه","https://www.aldiwan.net/poem51434.html","الرجز"],[68,"زار وصبغ الظلام قد نصلا","https://www.aldiwan.net/poem40970.html","المنسرح"],[54,"قد أغتدي وفي الدجى مبالغ","https://www.aldiwan.net/poem26840.html","الرجز"],[54,"قد أغتدي والليل قد تقضى","https://www.aldiwan.net/poem26881.html","الرجز"],[54,"قد أغتدي في صبح ليل فاش","https://www.aldiwan.net/poem26892.html","الرجز"],[54,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[54,"قد أغتدي والليل كالغراب","https://www.aldiwan.net/poem27237.html","الرجز"],[54,"قد أغتدي والصبح كالمشيب","https://www.aldiwan.net/poem27238.html","الرجز"],[54,"من يشتري مشيبي","https://www.aldiwan.net/poem27240.html","مجزوء الرجز"],[69,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[50,"لضوء برق ظللت مكتإبا","https://www.aldiwan.net/poem10770.html","المنسرح"],[50,"قد أغتدي والليل في إهابه","https://www.aldiwan.net/poem62456.html","الرجز"],[50,"قد أغتدي والطير في مثواتها","https://www.aldiwan.net/poem62480.html","الرجز"],[50,"قد أغتدي في فلق الإصباح","https://www.aldiwan.net/poem62541.html","الرجز"],[50,"قد أغتدي بزرق صبيح","https://www.aldiwan.net/poem62543.html","الرجز"],[50,"قد أغتدي والليل أحوى السد","https://www.aldiwan.net/poem63254.html","الرجز"],[50,"قد أغتدي والليل في اعتكاره","https://www.aldiwan.net/poem63410.html","الخفيف"],[50,"قد أغتدي والصبح مشهور","https://www.aldiwan.net/poem63411.html","الخفيف"],[50,"قد أغتدي والليل داج عسكره","https://www.aldiwan.net/poem63415.html","الرجز"],[50,"قد أغتدي والصبح محمر الطرر","https://www.aldiwan.net/poem63417.html","الوافر"],[50,"قد أغتدي بزرق جراز","https://www.aldiwan.net/poem63418.html","الرجز"],[50,"قد أغتدي قبل مذاذ الخامس","https://www.aldiwan.net/poem64349.html","الرجز"],[50,"قد أغتدي قبل طلوع الشمس","https://www.aldiwan.net/poem64350.html","الرجز"],[50,"قد أغتدي والليل في ادهمامه","https://www.aldiwan.net/poem65274.html","الرجز"],[50,"قد أغتدي والليل في مكتمه","https://www.aldiwan.net/poem65276.html","الرجز"],[50,"قد أغتدي والصبح في دجاه","https://www.aldiwan.net/poem66201.html","الرجز"],[48,"ما راعها من قرى عم وجارمها","https://www.aldiwan.net/poem23042.html","البسيط"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50052","الرجز"],[80,"فيما مضى كنت بالأعياد مسرورا","https://www.poetsgate.com/ViewPoem.aspx?id=1465",""],[113,"لا العيد من بعد سكان الحمى عيد","https://www.aldiwan.net/poem16189.html","البسيط"],[119,"عج بالركائب ساحة الجرعاء","https://www.aldiwan.net/poem42181.html","الكامل"],[146,"فر من الحب قلبه فنجا","https://www.aldiwan.net/poem58352.html","المنسرح"],[234,"قد أغتدي قبل الصباح المسفر","https://www.aldiwan.net/poem51001.html","الرجز"],[234,"قد أغتدي قبل طلوع الفجر","https://www.aldiwan.net/poem51066.html","الرجز"],[234,"قد أغتدي والليل في دجاه","https://www.aldiwan.net/poem51274.html","الرجز"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[356,"قد أغتدي والليل مركوم الظلم","https://www.aldiwan.net/poem68967.html","الرجز"],[369,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[438,"قد أغتدي والصبح خفاق العذب","https://www.aldiwan.net/poem12462.html","الرجز"],[438,"شق الصباح غلالة الظلماء","https://www.aldiwan.net/poem12771.html","الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[447,"هجيت ما بي وقد كشفت مكنوني","https://www.aldiwan.net/poem14489.html","البسيط"],[458,"يا ندوبي تصبري يا ندوبي","https://www.aldiwan.net/poem61232.html","الخفيف"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126806","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110415","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145890","الرجز"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96314","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64962","الرجز"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105209","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67965","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28600","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93556","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113697","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203471","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103529","البسيط"],[3249,"","https://poetry.dctabudhabi.ae/diwan/poem/198804","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86337","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138615",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138700",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109985","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44683","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4858,"إلى إنسانٍ كريمٍ عالي الهمّة","https://www.poetsgate.com/ViewPoem.aspx?id=141391",""],[5092,"نظرةٌ في عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=149793",""],[5285,"قلبٌ يُباع ويُشترى","https://www.poetsgate.com/ViewPoem.aspx?id=204398",""],[5363,"ربّاهُ آمالي بجودك لائذهْ","https://www.poetsgate.com/ViewPoem.aspx?id=199944",""],[5376,"أيها الغاصب ....إنها القدس","https://www.poetsgate.com/ViewPoem.aspx?id=188543",""],[5512,"الأم ( غفوت )","https://www.poetsgate.com/ViewPoem.aspx?id=204345",""],[5574,"خُفُّ اليأْس","https://www.poetsgate.com/ViewPoem.aspx?id=206000",""],[5691,"المربد","https://www.poetsgate.com/ViewPoem.aspx?id=206353",""],[5873,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215307",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""]],"verses":[["قَد أُغبِطَ المَيسُ عَلى عَقرِهِ","مَع نَقَبِ المَنسِمِ عاماً فَعام",0,"م",1,0],["قَد أَغارا عَلى أَكُفٍّ بَراها","بارِئُ الكائِناتِ لِلإِتقانِ",1,"ن",1,0],["قد اغتالها الطليان وهي بمضجع","من الأمن لم يُقضِض برعب على الجنب",2,"ب",1,0],["قَد أَغضَبوكُم فَاِغضَبوا وَتَأَهَّبوا","لِلحَربِ أُهبَةَ ثائِرٍ غَضبانِ",3,"ن",1,0],["قد أُغريا بي يهجواني معاً","وحدي وكان الأكثرُ الغالبا",4,"ب",2,0],["قد أغتدي والصُّبحُ في إقدامِه","واللَّيلُ قد أعرَضَ لانِهزامِه",5,"م",2,1],["قَد أَغرَقَ الناسَ","سَيلُهُ العَرِمُ",6,"م",1,0],["قَد أَغتَدي وَفي الدُجى مَبالِغُ","وَالفَجرُ لِلساقَةِ مِنها صائِغُ",7,"غ",1,1],["قَد أَغتَدي وَاللَيلُ قَد تَقَضّى","بِزَورَقٍ أَرخى بِهِ وَاِنفَضّا",8,"ض",2,1],["قَد أَغتَدي في صُبحِ لَيلٍ فاشِ","بِنَيرَجٍ لَهبٍ مُلَبٍّ ناشِ",9,"ش",1,1],["قَد أَغتَدي عَلى الجِيادِ الضُمَّرِ","وَالصُبحُ في طُرَّةِ لَيلٍ مُسفِرِ",10,"ر",1,1],["قَد أَغتَدي وَاللَيلُ كَالغُرابِ","راخي القِناعِ حالِكُ الإِهابِ",11,"ب",1,1],["قَد أَغتَدي وَالصُبحُ كَالمَشيبِ","بِقارِحٍ مُسَوَّمٍ يَعبوبِ",12,"ب",1,1],["قَد أَغتَدي بِقارِحٍ","مُسَوَّمٍ يَعبوبِ",13,"ب",1,0],["قد أَغْنَتِ الفَقَراءَ وافْتَقَرَتْ لَهمْ","هِمَمُ الملوكِ فما تَزالَ مُؤَمِّلَهْ",14,"ل",2,0],["قَدِ اِغتَرَفتَ الهُمومَ وَالبَثَّ وَال","وَجدَ وَهُزتَ الأَحزانَ وَالكُرَبا",15,"ب",2,0],["قَد أَغتَدي وَاللَيلُ في إِهابِهِ","أَدعَجُ ما جُرِّدَ مِن خِضابِهِ",16,"ب",2,1],["قَد أَغتَدي وَالطَيرُ في مَثواتِها","لَم تُعرِبِ الأَفواهُ عَن لُغاتِها",17,"ت",3,1],["قَد أَغتَدي في فَلَقِ الإِصباحِ","بِمُطعَمٍ يوجِزُ في سَراحِ",18,"ح",1,1],["قَد أَغتَدي بِزُرَّقٍ صَبيحٍ","مَحضٍ لِمَن يَنسِبُهُ صَريحِ",19,"ح",1,1],["قَد أَغتَدي وَاللَيلُ أَحوى السُدِّ","وَالصُبحُ في الظَلماءِ ذو تَقَدّي",20,"د",2,1],["قَد أَغتَدي وَاللَيلُ في اِعتِكارِهِ","بِأَغضَفٍ يَموجُ في شِوارِهِ",21,"ر",2,1],["قَد أَغتَدي وَالصُبحُ مَشهورُ","قَد طَلَعَت فيهِ التَباشيرُ",22,"ر",1,1],["قَد أَغتَدي وَاللَيلُ داجٍ عَسكَرُه","وَالصُبحُ يَفري جُلَّهُ وَيَدحَرُه",23,"ر",2,1],["قَد أَغتَدي وَالصُبحُ مُحمَرُّ الطُرَر","وَاللَيلُ تَحدوهُ تَباشيرُ السَحَر",24,"ر",1,1],["قَد أَغتَدي بِزُرَّقٍ جُرازِ","مَحضٍ رَقيقِ الزَفِّ وَالطِرازِ",25,"ز",1,1],["قَد أَغتَدي قَبلَ مَذاذِ الخامِسِ","بِضَرِمٍ يَنغِصُ كَفَّ اللامِسِ",26,"س",1,1],["قَد أَغتَدي قَبلَ طُلوعِ الشَمسِ","بِأَحجَنِ الخَطمِ كَمِيِّ النَفسِ",27,"س",1,1],["قَد أَغتَدي وَاللَيلُ في اِدهِمامِهِ","لَم يَحسِرِ الصُبحُ دُجى ظَلامِهِ",28,"م",2,1],["قَد أَغتَدي وَاللَيلُ في مَكتَمِهِ","بِيُؤيُؤٍ أَسفَعَ يُدعى بِاِسمِهِ",29,"م",2,1],["قَد أَغتَدي وَالصُبحُ في دُجاهُ","كَطُرَّةِ البُردِ عَلامَتاهُ",30,"ا",2,1],["قَد أَغرَقوا في مَعاصيهِمُ فَما لَهُمُ","لا يُؤنِسونَ مِنَ الطوفانِ تَغريقا",31,"ق",2,0],["قد أغتدي نشوانَ من خَمرِ الكَرى","أسحبُ بُردَيَّ على بُردِ الثَّرى",32,"ا",1,1],["قد أُغمضت بعد أن كانت مفتّرةً","أبصارهنّ حسيراتٍ مكاسيرا",33,"ر",2,0],["قَد أَغرَقَت مُقلَتي قَلبي بِأَدمُعِها","إِن السُرور الَّذي أُبديهِ تَقليدُ",34,"د",1,0],["قد أغرقوا الدنيا برأفتهم كما","داسوا بباس جبهة الجوزاء",35,"ا",2,0],["قد أغربَ القينُ في سهامهمُ","راشَ بهُدبٍ ونصَّلَ الدَّعجَا",36,"ج",2,0],["قد أغتدِي قبل الصباح المسفِر","والليلُ في ديجوجه المعسكِرِ",37,"ر",1,1],["قد أغتدي قبل طلوعِ الفجر","والليل في مثل خِضاب الشَعْرِ",38,"ر",1,1],["قد أغْتِدي والليلُ في دُجاهُ","والصبح لم يَنْهَضْ به سَناهُ",39,"ا",2,1],["قد اغتر ذاك الشيخ من ضعف شعبه","وأسمائه اللاتي بها يتلقب",40,"ب",1,0],["قَد أَغربت في وَضعها وَتطوّقت","سوراً وَهل تتطوّق العنقاءُ",41,"ا",2,0],["قد أغتدي والليلُ مركومُ الظلم","والصبح في ثني الظلام مكتتم",42,"م",1,1],["قد أغتدِي بالعِيسِ مُبتكِراً","والصبْحُ طِفْلٌ في الدجى يَحبو",43,"ب",2,0],["قد أغتدي والصبحُ خفّاقُ العذَبْ","وعسكَرُ الليلِ مجدٌّ في الهرَبْ",44,"ب",1,1],["قد أُغمدتْ أسيافُ ماءٍ في الحَشى","مصقولةٌ تَفْري كِلى البَيْداءِ",45,"ا",2,0],["قد أغرقت كل البحار بحارها","وتحملت كل الجبال جبالها",46,"ل",3,0],["قد أغبنتني الليالي الخائنات بها","وكنت لولا الليالي غير مغبون",47,"ن",1,0],["قد أغني وما غنائي سوى دم","عي وحينا دمي سرى في نسبي",48,"ب",2,0],["قد أغلق الحظُّ البهيم سُبُلي","حجازَها وشامَها واليمنا",49,"ن",2,0],["قَدِ اِغتصبت أرض العروبة واِعتدت","عليها ولم تترك لأبنائها رِزقا",50,"ق",2,0],["قد اغتالها الدهر الخؤُون وحبَّذا","لو اغتالني عنها فعاكس في الأمرِ",51,"ر",1,0],["قد أُغلِقَ المزادُ لا","شارٍ لكمْ أو بَائِعُ",52,"ع",1,0],["قد أغتدى والصبحُ في حِجابه","والليلُ لم يأوِ إلى مآبهِ",53,"ب",2,1],["قد أَغْتَدي واللَّيلُ مَطْلولُ الدَّمِ","بأَهْرَتِ الشِّدْقِ عَريضِ المُقْدِمِ",54,"م",1,1],["قد أغلقت باب الندى من بعده","وأوثقت منهدة الجوانب",55,"ب",1,0],["قَدِ اغتَرَبتُ نازِحاً عَن وَطَنِي","مُستَعدِياً كُلَّ مِخشٍّ مِطعَنِ",56,"ن",1,0],["قد أغص السماء والأرض مجداً","ورداه أغصها بشجاها",57,"ا",3,0],["قَد أَغرَقَ الدَّمعُ أَجفانِي وَأَدخَلَني","نارَ الأَسى عَزمِيَ الوانِي فَوانَدَمِي",58,"م",2,0],["قد اغتدي والليل وردٌ منسرُه","كأنما ألقت عليه آزرُه",59,"ر",2,1],["قَد أَغاروا فَحَووا ما بِالفَنا","مِن تَمام وَقَوام وَهَضَم",60,"م",1,0],["قَد أَغرَقَت كِسرى وَمِن في جَنبه","فَطفت قَلانسهم عَلى جَنباتها",61,"ت",3,0],["قد اغتربت ابناؤك الغر كي يرى","بهم لك خفاقاً بكل على بند",62,"د",1,0],["قَد أغتَدي وَالصُّبحُ في تَوريسه","تَقضي العُيونُ لَهُ بِوَجهِ عَليلِ",63,"ل",1,0],["قد اغتنمتم بعادي عن مجالسكم","وليس قربكم في النَّاس يغتنمُ",64,"م",1,0],["قد أغضبوا العدل في أحكام عدلهم","فالعدل يبرأ من أحكام منتقم",65,"م",1,0],["قد أغتدي وعيون الفجر واسنةٌ","والشمس راقدةٌ عن عين باغيها",66,"ي",3,1],["قد أغولت ملء الجفون وصار","هتان الدموع طعامها وشرابها",67,"ب",3,0]