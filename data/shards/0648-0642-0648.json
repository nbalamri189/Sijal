"","https://poetry.dctabudhabi.ae/diwan/poem/200123","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"أفي مُسْتَهِلاّتِ الدّموعِ السّوَافحِ","https://www.poetsgate.com/ViewPoem.aspx?id=33041",""],[45,"خيَالٌ مُلِمٌّ، أو حَبيبٌ مُسَلِّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=32021",""],[91,"قنبلة الفناء","https://www.poetsgate.com/ViewPoem.aspx?id=53228",""],[28,"رعت ناقتي من أم أعين رعية","https://www.poetsgate.com/ViewPoem.aspx?id=21091",""],[28,"أبا حاتم ما حاتم في زمانه","https://www.poetsgate.com/ViewPoem.aspx?id=21365",""],[99,"بالأحمرِ فقَط","https://www.poetsgate.com/ViewPoem.aspx?id=16902",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[52,"داو الهمومَ بقهوة ٍ صفراءِ ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14640&r=&rc=9",""],[31,"طربتَ، وردّ من تهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18895&r=&rc=158",""],[31,"ألما بذاتِ الخالِ، فاستطلعا لنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19051&r=&rc=314",""],[31,"تَصَابَى القَلْبُ وَکدّكَرَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18896&r=&rc=159",""],[31,"بَعَثْتُ وَلِيدَتي سَحَراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18919&r=&rc=182",""],[31,"هَيْهَاتَ مِنْ أَمَة ِ الوَهّابِ مَنْزِلُنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19109&r=&rc=371",""],[88,"تحرّ إذا صادقتَ مَن رُدُّه مَحض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19572&r=&rc=75",""]],"verses":[["وَقولوا لِجيرانٍ عَلى الخَيفِ مِن مِنىً","تَراكُم مَنِ اِستَبدَلتُمُ بِجِوارِيا",0,"ي",2,0],["وَقودُ الخَيلِ تَركَعُ مِن وَجاها","وَقَد غَلَبَ النَجيعُ عَلى الكُلومِ",1,"م",1,0],["وَقَومي الضامِنونَ الأَم","نَ إِن هَجَموا عَلى حُرَمِ",2,"م",1,0],["وَقَولَةُ خِزيٍ فيكُمُ تَستَفِزُّني","وَأَعلَمُ أَن لا بُدَّ مِن أَن أَقولَها",3,"ل",3,0],["وَقَودُ الجِيادِ عَلى أَنَّها","تَصاهَلُ تَحتَ القُنيِّ الطِوالِ",4,"ل",1,0],["وَقورٌ فَإِن لَم يَرعَ حَقِّيَ جاهِلٌ","سَأَلتُ عَنِ العَوراءِ كَيفَ تُقالُ",5,"ل",1,0],["وُقوا شَرَّها وَاليَومُ مُستَوجِفُ الحَشا","لَهُ أَبجَلٌ مِن عائِذِ الطَعنِ فائِرُ",6,"ر",1,0],["وَقورٍ ما اِستَخَفَّتهُ اللَيالي","وَلا خَدَعَتهُ عَن جِدٍ بِمَزحِ",7,"ح",1,0],["وَقورٌ فَلا الأَلحانُ تَأسِرُ عَزمَتي","وَلا تَمكُرُ الصَهباءُ بي حينَ أَشرَبُ",8,"ب",1,0],["وَقَوَّضتَ الخِيامَ تَذُبُّ عَنها","أُسودُ وَغىً وَأَصفَرتَ الوِطابا",9,"ب",2,0],["وَقورٌ إِذا زَعزَعَتهُ الخُصو","مُ وَاِنفَرَجَت حَلَقاتُ الحُبى",10,"ا",1,0],["وَقَوَّمتُ مِن أَعناقِها عَن ضَلالِها","بِأَرجاءِ عُريانِ الطَّريقَةِ واضِحِ",11,"ح",1,0],["وَقَوافٍ مُلْسِ المُتونِ شِدادِ ال","أَسْرِ غُرٍّ مَصْقُولَةِ الأَطرافِ",12,"ف",1,1],["وقَولٍ أتاني والحوادِثُ جمّةٌ","ودونيَ منْ ذاتِ الأراكَةِ صَفْصَفُ",13,"ف",1,0],["وقوى تختطف العزل كما","يخطف الصقر من الجو الحماما",14,"م",2,0],["وَقَولَكَ لِلشَيءِ الَّذي لا تَنالُهُ","إِذا ما حَلا في العَينِ يا لَيتَ ذا لِيا",15,"ي",2,0],["وَقوماً آخَرينَ سَعَوا وَعادو","حَيارى ما رَأوا أَثَراً لِأَثري",16,"ر",2,0],["وَقولوا لَهُم يا أَهلَ يَثرِبَ أَسعِدوا","عَلى جَلَبٍ لِلحادِثاتِ جَليبِ",17,"ب",1,0],["وَقورٌ إذا الأبْطالُ طاشَتْ حُلومُها","وأقْدَمُ في الهَيْجاءِ صَفّاً الى صَفِّ",18,"ف",1,0],["وَقُولاَ أمِيرَ الْمُسْلِمِينَ تَحِيَّةً","حَبَاك بِهَا عَبْدٌ حَلِيفُ غَرَامِهِ",19,"م",2,0],["وَقَوَّضْتُ رَحْلِي عَنْ بِلاَدٍ نَبَا بِهَا","مِهَادِي إِلَى حَيْثُ السَّلاَمَةُ وَالسِّلْمُ",20,"م",1,0],["وَقُولاَ لَهَا رَيّاً فَأَكْنَافُ رِيَّةٍ","مَأَمَّ نَوَانَا فَابْشِرِي بِاحْتِلاِلِه",21,"ل",2,0],["وَقَوْرَاءَ مِنْ قَوْسِ الْغَمَامِ ابْتَغُوا لَهَا","مِثَالاً أَدَارُوهَا بِلاَ شَكِّ",22,"ك",1,1],["وقَواضِباً بِيضاً سُقينَ دمَ العِدى","فبَدا على صَفَحاتِها توْرِيدُهُ",23,"د",2,0],["وَقُولاَ لِمَنْ شُدَّتْ إِلَيْهِ نُسُوعُهُ","يُؤَمِّلُ مِنْهُ النَّصْرَ فِيمَا يَرُوعُهُ",24,"ه",1,0],["وَقَومُكَ لا تَحمِل عَلَيهِم وَلا تَكُن","بِهِم هارِشاً تَغتابُهُم وَتُقابِلُ",25,"ل",1,0],["وُقوفاً فَلَمّا حانَ مِنّا إِناخَةٌ","شَرِبنا قُعوداً خَلفَنا رُكَباتُها",26,"ت",3,0],["وَقَومُكَ إِن يَضمَنوا جارَةً","يَكونوا بِمَوضِعِ أَنضادِها",27,"د",3,0],["وَقَومٍ تَصرِفُ الأَنيابُ مِنهُم","عَلَينا ثُمَّ لَم يَصِدِ الوَعيدُ",28,"د",1,0],["وَقورٌ إِذا ما الجَهلُ أَعجَبَ أَهلَهُ","وَمِن خَيرِ أَخلاقِ الرِجالِ وُقورُها",29,"ر",3,0],["وُقوفاً وَراءَ الطَعنِ وَالخَيلُ تَحتَهُم","تُشَدُّ عَلى أَكتافِهِنَّ القَوادِمُ",30,"م",1,0],["وُقوفاً بِما كانَ مِن لَأمَةٍ","وَهُنَّ صِيامٌ يَلُكنَ اللُجُم",31,"م",1,0],["وَقَومَكَ فَاِستَبِقِ المَوَدَّةَ فيهِمُ","وَنَفسَكَ جَنِّبها الَّذي قَد يَعيبُها",32,"ب",3,0],["وَقُوموا فآسوا قَومَكُم فَاِجمَعُوهُمُ","وَكونوا يَداً تَبني العُلا وَتُدافِعُ",33,"ع",1,0],["وقَولَةٍ لعَليٍّ قالَها عُمَرٌ","أكرِم بسامِعِها أعظِم بمُلقيها!",34,"ي",3,0],["وَقَومٌ عِدىً يُبدونَ عَن صَفَحاتِهِم","وَأَزهَرُها مِن ظُلمَةِ الحِقدِ أَكلَفُ",35,"ف",1,0],["وَقَوامٌ كَما اِستَقامَ قَضيبُ ال","بانِ إِذ عَلَّهُ ثَراهُ الأَريضُ",36,"ض",1,0],["وُقوفاً بِها صَحبي عَلَيَّ مَطِيِّهُم","يَقولونَ لا تَهلِك أَسىً وَتَجَمَّلِ",37,"ل",1,0],["وَقولا لِقَلبٍ قَد سَلا راجِعِ الهَوى","وَلِلعَينِ أَذري مِن دُموعِكِ أَو دَعي",38,"ع",2,0],["وَقولي إِنَّ خَيرَ بَني سُلَيمٍ","وَفارِسَهُم بِصَحراءِ العَقيقِ",39,"ق",1,0],["وَقَوّادَ خَيلٍ نَحوَ أُخرى كَأَنَّها","سَعالٍ وَعِقبانٌ عَلَيها زَبانِيَه",40,"ي",2,0],["وَقَوْلُهَا فِي هَرِمٍ جَاعِلٍ","هَوَى الغوَانِي شُغُلاً شَاغِلَهْ",41,"ل",2,0],["وَقَوْلُهَا خَطْرَة فِكْرٍ لَهَا","كَأَنَّهَا عَنْ نَفْسِهَا قَائلَهْ",41,"ل",2,0],["وُقوفاً لَدى الأَبوابِ طُلاّبَ حاجَةٍ","عَوانٍ مِنَ الحاجاتِ أَو حاجَةً بِكرا",42,"ر",2,1],["وُقوفاً عَلى مَطموسَةٍ قَطَعَت بِها","نَوى الصَيفِ أَقرانَ الجَميعِ الأَوالِفِ",43,"ف",1,0],["وَقَومٍ كِرامٍ أَنكَحَتنا بَناتِهِم","ظُباتُ السُيوفِ وَالرِماحِ المَداعِسُ",44,"س",1,0],["وقولتي اسمع منّي","واندفع واغنّي",45,"ي",1,0],["وقوراءَ قد دُرْنا بهالة بدرها","كما دارت الزُهرُ النجومُ على البدر",46,"ر",1,0],["وقَوّضت الأيام بنيان مجدها","فرَبْع المعالي بَينهنَ محول",47,"ل",1,0],["وقولا لمن قد لام صَهْ وَيْك أننا","على حال في المواطن أخوان",48,"ن",1,0],["وَقَومٍ قَد سَمَوتَ لَهُم فَدانوا","بِدُهمٍ في مُلَملَمَةٍ رَداحِ",49,"ح",1,0],["وَقَومٍ ضامِزينَ عَلى نَداهُم","إِذا سُئِلوا كَما ضَمَزَ الحَميرُ",50,"ر",1,0],["وَقولا هُوَ المَرءُ الَّذي لا خَليلَهُ","أَضاعَ وَلا خانَ الصَديقَ وَلا غَدَر",51,"ر",1,0],["وَقَولي أَلا لا يُبعِدِ اللَهُ أَربَدا","وَهَدّي بِهِ صَدعَ الفُؤادِ المُفَجَّعا",52,"ع",2,0],["وُقُوفاً يَنظُرُونض بِهِ إِلَينَا","لِقَائِلِنَا المُوَفَّقِ مُنصِتِينَا",53,"ن",2,0],["وَقورٌ وَرَيعانُ الصِبا يَستَفِزُّها","فَتَأرَنُ أَحياناً كَما أَرِنَ المُهرُ",54,"ر",1,0],["وَقَومٌ أَلِفناهُمُ","وَغُصنُ الصِبا أَخضَرُ",55,"ر",1,0],["وَقَومٌ مَتى ما أَلقَهُم رَوِيَ القَنا","وَأَرضٌ مَتى ما أَغزُها شَبِعَ النَسرُ",56,"ر",1,0],["وَقَولَها وَدُموعُ العَينِ واكِفَةٌ","هَذا الفِراقُ الَّذي كُنّا نُحاذِرُهُ",57,"ر",2,0],["وُقوفُكَ في الدِيارِ عَلَيكَ عارُ","وَقَد رُدَّ الشَبابُ المُستَعارُ",58,"ر",1,1],["وَقَومٌ مِثلُ مَن صَحِبوا كِرامٌ","وَخَيلٌ مِثلُ مَن حَمَلَت خِيارُ",58,"ر",1,0],["وَقورٌ وَأَحداثُ الزَمانِ تَنوشُني","وَلِلمَوتِ حَولي جيئَةٌ وَذَهابُ",59,"ب",1,0],["وَقَومٍ مِنَ البَغضاءِ زورٍ كَأَنَّما","بِأَجوافِهِم مِمّا تُجِنُّ لَنا الجَمرُ",60,"ر",1,1],["وَقَولَ السَفاهِ وَاِقصِدوا لِأَبيكُمُ","ثَقيفٍ فَإِنَّ القَصدَ في ذاكَ أَجمَلُ",61,"ل",1,0],["وقوَّى ضعيف الحالِ منا بدهرِهِ","خلا ما بلحظِ الغِيدِ من فترات",62,"ت",1,0],["وقوعِ بيتي لسنٍّ","لم يوفِ في العمر عدَّك",63,"ك",1,0],["وقومٌ يخافون مسّ الهجاء","وقد سلكوا فيه طريق الغرَر",64,"ر",1,1],["وقوّس من ثقل الرزية أظهراً","فلا غَرْوَ أن أصمى الحشا بنباله",65,"ل",2,0],["وقُوفٌ على بابِ وتشييعُ موكب","وإنشاد جُمَّاع وتلك مَقادر",66,"ر",1,0],["وقولنا القول يروى","قدْماً بشرٍّ وخير",67,"ر",1,0],["وقولُهُمُ إياه شكر تقودهم","إليه بفعل لم تَشنْه خَسائسه",68,"س",2,0],["وقوافٍ يقول مُستمِعُوها","آذنْتَ كلُّ صعبةٍ بارتياض",69,"ض",1,0],["وقومك أحنى على رهنهم","وما البدر من عود نبع فُرِع",70,"ع",1,0],["وقولي ألا إنَّ اكتئاباً لشاخِصٍ","سيُعْقِبُهُ اللَّهُ ابتهاجاً بقادمِ",71,"م",1,0],["وقوَّمَني إلى أن قام عُودي","فما في متنهِ أودٌ يُقامُ",72,"م",1,0],["وقوَّمَتْني يد من سيِّدٍ حَدِبٍ","بل شيمةٌ منه أعْدَتْ شيمتي كرما",73,"م",2,0],["وَقَوَّيتَ في أَبنائِها الحُبَّ نَحوَها","وَكُنتَ لَهُم في ذاكَ أَفضَلَ قُدوَةِ",74,"ه",1,0],["وَقَوامٌ لَو رَآهُ الغُصنُ بان","خَجِلاً مِن ذَلِكَ الغُصنِ الرَطيب",75,"ب",1,0],["وَقَوَّضَ مَفعولَها الراسِياتِ","فَصارَت غُباراً لَهُ جَلجَلَه",76,"ل",2,0],["وَقولوا كَذا قَد أَرادَ الإِلَهُ","وَإِن قَدَّرَ اللَهُ شَيئاً يَكون",77,"ن",1,0],["وقَوامٌ يَكادُ يَنْطُقُ بالأَلحانِ","في كلِّ وقفةٍ وقعودِ",78,"د",1,0],["وَقولي يا بُثَينَةُ حَسبَ نَفسي","قَليلُكِ أَو أَقَلُّ مِنَ القَليلِ",79,"ل",1,0],["وقولي له يا روح بعدك عيشنا","تعسر حتى كاد لا يُتَحمَّل",80,"ل",1,0],["وقوم يرتقون إلى المعالي","وقوم ما لهم فيها مراقى",81,"ق",2,0],["وقوّموه كريما","على الزمان معينا",82,"ن",2,0],["وقور في الحوادث لا يبالى","سيوف البغى تغمد أو تسل",83,"ل",1,0],["وقوم أحمد قد ضلوا شريعته","وضيعوا كل إسلام وإيمان",84,"ن",1,0],["وقومك عند مرقدهم نيام","فهل تحصى على القوم السنينا",85,"ن",2,0],["وَقوبِلَت في الفرس بِالمُحبّذِ","مِن كُلِّ دهقانٍ وَكُلِّ موبِذِ",86,"ذ",1,0],["وَقَولُكَ مِن فَوقِ قَولِ الرِجالِ","وَفِعلُكَ مِن فِعلِهِم أَنبَلُ",87,"ل",1,0],["وَقَوامٍ يَروي الغُصنُ لَهُ","نَسَباً وَالرُمحُ يُفَنِّدُهُ",88,"د",2,0],["وَقوما هاتِفَينِ بِهِ وَلَكِن","كَما كانَ الأَوائِلُ يَهتِفونا",89,"ن",2,0],["وَقولا لِلنَزيلِ قُدومَ سَعدٍ","وَحَيّا اللَهُ مَقدَمَكَ اليَمينا",89,"ن",2,0],["وُقوفَينَ في وَقفَينِ شُكرٍ وَنائِلٍ","فَنائِلُهُ وَقفٌ وَشُكرُهُمُ وَقفُ",90,"ف",1,0],["وقولا لإِخواني أرى عهدَ ودِّكُمْ","كعهدِ الغواني أو كظلِّ الغمائمِ",91,"م",1,0],["وَقورٌ تُعانيهِ الأُمورُ فَتَنجَلي","غَيايَتُها عَن وازِنِ الحِلمِ راجِحِ",92,"ح",1,0],["وَقورُ النَواحي وَالنَدى يَستَخِفُّهُ","لَنا وَأَميرُ الشَرقِ وَالجودُ آمِرُه",93,"ر",2,0],["وُقوفاً بِأَعلى مَنظَرٍ قَد تَوازَنَت","مَناكِبُ مِنهُم مِثلَ ماوَقَفَ الصَفُّ",94,"ف",1,0],["وُقوفُكَ في أَطلالِهِم وَسُؤالُها","يُريكَ غُروبَ الدَمعِ كَيفَ اِنهِمالُها",95,"ل",3,1],["وَقَوافٍ أَهدَيتُها لِمُراعٍ","حُسنَ أَمثالِها عَلى أَمثالِه",96,"ل",2,0],["وَقورٌ يَرُدُّ العَفوُ فَرطَ شَذاتِهِ","وَفي القَومِ أَشتاتٌ مُليمٌ وَمُحرِمُ",97,"م",1,0],["وَقورٌ تَحتَ السَكينَةِ ما يَر","فَعُ وَمِن طَرفِهِ ضَجاجُ الخُصومِ",98,"م",1,0],["وَقَومٌ يَهُزّونَ الرِماحَ بِمُلتَقىً","أَساوِرُهُ مَرهوبَةٌ وَمَزارِبُه",99,"ب",2,0],["وَقَومٌ أَبوهُم غالِبٌ جُلُّ مالِهِم","مَحامِدُ أَغلاها مِنَ المَجدِ غالِبُ",100,"ب",1,1],["وَقَومٍ أَحاطَت لَو تُريدُ دِماءَهُم","بِأَعناقِهِم أَعمالَهُم لَو تُثيرُها",101,"ر",3,0],["وُقوفاً بِها صَحبي عَلَيَّ كَأَنَّني","بِها سَلَمٌ في كَفِّ صاحِبِها ثَأرُ",102,"ر",1,0],["وَقَومٌ أَبوهُم غالِبٌ أَنا مالُهُم","وَعامٌ تَمَشّى بِالفِراءِ أَرامِلُه",103,"ل",2,0],["وُقوفاً بِها صَحبي عَلَيَّ وَإِنَّما","عَرَفتُ رُسومَ الدارِ بَعدَ التَوَهُّمِ",104,"م",1,0],["وَقَومٍ يَعَضّونَ الأَكُفَّ صُدورُهُم","عَلَيَّ وَغارى غَيرُ مُرضىً رِغامُها",105,"م",3,0],["وقولتي والتفاتي عند منصرفي","والشوق يزعج قلبي أيّ إزعاج",106,"ج",1,0],["وَقورُ السَّجايا في النَّدِيِّ رَكينُها","شَرودُ العَطايا في المُحولِ خَليعُها",107,"ع",3,0],["وقواطنا في الماء تحسب أنها","شم الهشاب لبسن ليلا أربدا",108,"د",2,0],["وقوَّمْتَ منهم جانباً لظُهورِهم","وأشرَفْتَهم بالمشرفيَّةِ مُنشِدا",109,"د",2,0],["وَقَودُكَ لِلعَدُوِّ الخَيلَ قُبّاً","مُسَوَّمَةً جَنابَكَ فَيلَقانِ",110,"ن",1,0],["وَقَولُ اللَهِ ذاكَ لَنا","وَلَيسَ لِقَولِهِ خَلَفُ",111,"ف",1,0],["وَقَولي كَذا قَد كانَ ظاهِرُ فِعلِهِ","وَكُفّي فَعِندَ اللَهِ عِلمُ السَرائِرِ",112,"ر",1,0],["وَقَولُكَ أَنتُم بَنو بَنيهِ","وَلَكِن بَنو العَمِّ أَولى بِها",113,"ب",3,0],["وقواريرُ حَبابٍ سَبَحَتْ","من سُلافِ الكرم في ماءٍ كريم",114,"م",1,0],["وَقَوْصَرّةٍ فيها رؤوسُ جدودهم","إلى اليوم ملآن بأفلاقِها العفرُ",115,"ر",1,0],["وَقومي حاسِراً في حاسِراتٍ","خَوامِشَ لِلنُحورِ وَلِلخُدودِ",116,"د",1,0],["وَقَوافٍ قَد ضَجَّ مِنها لِما اِستُع","مِلَ فيها المَرفوعُ وَالمَخفوضُ",117,"ض",1,0],["وُقوفٌ في ظِلالِ الذَمِّ تُحمى","دَراهِمُها وَلا يُحمى الذِمارُ",118,"ر",1,0],["وقوفي على بابهمْ رفعةٌ","ويا طولَ طرديَ إنْ لمْ أقفْ",119,"ف",1,1],["وَقَولَها لِلثُرَيّا يَومَ ذي خُشُبٍ","وَالدَمعُ مِنها عَلى الخَدَّينِ ذو سَنَنِ",120,"ن",1,0],["وَقولا لَهَ إِنَّ النَوى أَجنَبيَّةٌ","بِنا وَبِكُم قَد خِفتُ أَن تَتَتَمَّما",121,"م",2,0],["وَقولا لَها لا تَقبَلي قَولَ كاشِحٍ","وَقولي لَهُ إِن زَلَّ أَنفُكَ أَرغِما",121,"م",2,0],["وَقولا لَها لَم يُسلِنا النَأيُ عَنكُمُ","وَلا قَولُ واشٍ كاذِبٍ إِن تَنَمَّما",121,"م",2,0],["وَقولا لَها ما في العِبادِ كَريمَةٌ","أَعَزَّ عَلَينا مِنكِ طُرّاً وَأَكرَمَ",121,"م",1,0],["وَقولا لَها لا تَسمَعِنَّ لِكاشِحٍ","مَقالاً وَإِن أَسدى لَدَيكِ وَأَلحَما",121,"م",2,0],["وَقولا لَها لَم أَجنِ ذَنباً فَتَعتُبي","عَلَيَّ بِحَقٍّ بَل عَتَبتِ تَجَرُّما",121,"م",2,0],["وَقولا لَهُ وَاللَهِ ما الماءُ لِلصَدى","بِأَشهى إِلَينا مِن لِقائِكَ فَاِعلَما",121,"م",2,0],["وَقولا لَهُ ما شاعَ قَولُ مُحَرِّشٍ","لَدَيَّ وَلا رامَ الرِضا أَو تَرَغَّما",121,"م",2,0],["وَقولا لَهُ إِن تَجنِ ذَنباً أَعُدُّهُ","مِنَ العُرفِ إِن رامَ الوُشاةُ التَكَلُّما",121,"م",2,0],["وَقولي في مُلاظَةٍ","لِزَينَبَ نَوِّلي عُمَرَك",122,"ك",1,0],["وَقَولُها لِأُختِها","أَمُطمَئنٌّ عُمَرُ",123,"ر",1,0],["وَقولي في مُلاطَفَةٍ","لِزَينَبَ نَوِّلي عُمَرا",124,"ر",2,0],["وَقولا قَد ظَفِرتَ بِها","كَفاكَ وَخَبِّرا الخَبَرا",125,"ر",2,0],["وَقولا إِنَّ سِرَّكَ يَو","مَ بَطنِ الخَيفِ قَد شُهِرا",125,"ر",2,0],["وَقولا في مُلاطَفَةٍ","أَزَينَبُ نَوِّلي عَمرا",125,"ر",2,0],["وَقَولَها لِلفَتاةِ إِذ أَفِدَ ال","بَينُ أَغادٍ أَم رائِحٌ عُمَرُ",126,"ر",1,0],["وَقولُ بَكرٍ أَلَم تُلمِم لِنَسأَلَهُم","وَاِنظُر فَلا بَأسَ بِالتَسليمِ وَالنَظَرِ",127,"ر",1,0],["وَقَولَها وَدُموعُ العَينِ تَسبِقُها","في نَحرِها دَينُ هَذا القَلبِ مِن عُمرِ",127,"ر",1,0],["وَقَولُها لِفَتاةٍ غَيرِ فاحِشَةٍ","أَرائِحٌ مُمسِياً أَم باكِرٌ عُمَرُ",128,"ر",1,0],["وَقَولي لِنِسوانٍ لَحَينَكِ في الهَوى","إِذا عَقلُ إِحداهُنَّ مِن وَصلِنا عَزَب",129,"ب",1,0],["وَقورٍ عَلى ظَهرِ الفَلاةِ كَأَنّهُ","طِوالَ اللَيالي مُفَكِّرٌ في العَواقِبِ",130,"ب",1,0],["وَقَولٍ لَهُ في مَعقَدِ الحِلمِ حِكمَةٌ","يُحَلُّ بِها في اللَهِ طَوراً وَيَعقُدُ",131,"د",1,0],["وُقورٌ عَلى مَرِّ اللَيالي كَأَنَّما","يُصيخُ إِلى نَجوى وَفي أُذنِهِ وَقرُ",132,"ر",1,0],["وَقَوراءَ بَيضاءِ المَحاسِنِ طَلقَةٍ","لَبِستُ بِها اللَيلَ البَهيمَ نَهارا",133,"ر",2,1],["وقولك كله لا عيب فيه","وهل في الوحي من شيء يعاب",134,"ب",1,0],["وَقُوموا فاجْمعوا الشَّملَ الصَّديعا","هلمّوا فاطلبوا الشّأنَ الرّفيعا",135,"ع",2,0],["وقُوّةٌ لرسولِ الله شائعةٌ","بين القبائلِ يرعاها وتَرعاهُ",136,"ا",2,0],["وَقولا لَهُ أَأَنتَ سَويتَ هَذِهِ","بِلا وَتَدٍ حَتّى إِطمَأَنَّت كَما هِيا",137,"ي",2,0],["وَقولا لَهُ أَأَنتَ رَفَّعتَ هَذِهِ","بِلا عَمَدٍ أَرفِق إِذاً بِكَ بانِيا",137,"ي",2,0],["وَقولا لَهُ أَأَنتَ سَوَّيتَ وَسطَها","مُنيراً إِذا ما جَنَّهُ اللَيلُ هادِيا",137,"ي",2,0],["وَقولا لَهُ مَن يُرسِلُ الشَمسَ غَدوَةً","فيُصبِحُ ما مَسَت مِنَ الأَرضِ ضاحِيا",137,"ي",2,0],["وَقولا لَهُ مَن يُنبِتُ الحَبَّ في الثَرى","فيُصبِحُ مِنهُ البَقلُ يَهتَزُ رابِيا",137,"ي",2,0],["وَقَومٍ لَحا لَحوَ العِصِيِّ فَأَصبَحوا","مَراميلَ بَعدَ الوَفرِ بيضَ المَبارِكِ",138,"ك",1,0],["وَقَويمٌ كَالخَطِّ يَزدادُ ليناً","بِدِماءِ الأَحشاءِ وَالجَوفِ يُغذى",139,"ذ",2,0],["وَقولي هَوى عَرشُ المَكارِمِ وَالعُلى","وَعُطِّلَ ميزانٌ مِنَ العِلمِ راجِعُ",140,"ع",1,0],["وَقَوسُهُ وَسَهمُهُ","وَسَيفُهُ في لَحظَتِه",141,"ت",2,0],["وَقَوَافِيَّ ليسَ فيها صِقالٌ","مِنْ نَدىً لا وليس فيها زَفَارَهْ",142,"ر",2,0],["وَقولي ما بَدا لَكِ أَن تَقولي","فَما ذا كُلُّهُ إِلّا لِحُبّي",143,"ب",2,0],["وُقوفُ رَيحانَةٍ عَلى أُذُنٍ","وَسَيرُ كَأسٍ إِلى فَمٍ بِيَدِ",144,"د",1,0],["وَقَولُ الفُيوجِ كِتابُ الأَميرِ","وَخَتمُ القَراطيسِ بِالجَرجَسِ",145,"س",1,0],["وَقَولُكِ لِلرَسولِ عَلَيكَ غَيري","فَلَيسَ إِلى التَواصُلِ مِن سَبيلِ",146,"ل",1,0],["وَقَولٍ قُلتُهُ فَأَصَبتُ فيهِ","وَلَم أَحفِل مَقالَةَ مَن لَحاني",147,"ن",2,1],["وقوفُ ريحانةٍ على أذنٍ","وسعي كأسٍ إلى فمٍ بيَدِ",148,"د",1,0],["وَقَومٌ يَنظُرونَ إِلَيَّ شَزراً","كَأَنَّ كُلومَهُم مِنّي دوامِ",149,"م",1,1],["وَقَومٌ نالَهُم بِجَدىً وَقَومٌ","أَصابَتهُم كَتائِبُهُ فَكادوا",150,"د",3,0],["وَقَومٌ زَعَموا أَنّي","مِنَ الشَكِّ تَخَلَّيتُ",151,"ت",1,0],["وَقَومٌ يُنكِرونَ سَحابَ قَومي","رَفَعنا فَوقَهُم غُرَّ السَحابِ",152,"ب",1,0],["وَقَوامٌ يَعلو القِوامَ وَنَحرٌ","طابَ رُمّانُهُ عَلَيهِ الأَياءُ",153,"ا",2,0],["وَقوتِيَ الشَيءُ أَبى مِثلَهُ","فَصيحُ هَذا الخَلقِ وَالأَلكَنُ",154,"ن",1,0],["وُقوفاً بِها صَحبي عَلَيَّ مَطيَّهُم","يَقولونَ لا تَهلِك أَسىً وَتَجَلَّدِ",155,"د",1,0],["وَقَومي خِيارٌ مِن أُسَيِّدَ شِجعَةٌ","كِرامٌ إِذا ما المَوتُ خَبَّ وَهَروَلا",156,"ل",2,0],["وَقَوارِصٍ بَينَ العَشيرَةِ تُتَّقى","داوَيتُها وَسَمَلتَها بِسِمالِ",157,"ل",1,0],["وَقَومٍِ يَهيِنُونَ أَعراضَهُم","كَوَيتُهُمُ كَيَّةَ المُكلِبِ",158,"ب",1,0],["وقوَّضَ الإمام عند ذلكا","وقلبُه صَبٌّ بما هُنالكا",159,"ك",2,0],["وقواف تسيل في كل واد","طفحت منها دجلة وَالنيل",160,"ل",1,0],["وَقوم إلى استقلال أوطانهم سعوا","أولئك فوق الأرض يبقى لهم ذكر",161,"ر",1,0],["وَقوم كرام ساءهم وَشك فرقتي","وَقوم تمنوا أَن يَزول وجودي",162,"د",2,0],["وقوفاً عَلى الأجداث تَتلو قصائداً","فَتَبكي وَتُبكي السامعين قصيدها",163,"د",3,0],["وقوافٍ كأنها نغماتٌ","هاجها الشجوُ في يراعٍ مثقّبْ",164,"ب",1,0],["وقول النصارى إله يضام","ويظلم حيا ولا ينتصر",165,"ر",1,0],["وقول اليهود إله يحب","رسيس الدماء وريح القتر",165,"ر",1,0],["وقوم أتوا من أقاصي البلد","لرمي الجمار ولثم الحجر",165,"ر",1,0],["وَقَومي مَعَ الأَيّامِ عَونٌ عَلى دَمي","وَقَد طَلَبوني بِالقَنا وَالصَفائِحِ",166,"ح",1,0],["وَقوماً آخَرينَ سَعَوا وَعادوا","حَيارى ما رَأوا أَثَراً لِأَثري",167,"ر",2,0],["وَقُورٌ وَأَحْلامُ الرِّجَالِ خَفِيفَةٌ","صَبُورٌ وَنَارُ الْحَرْبِ مِرْجَلُهَا يَغْلِي",168,"ي",1,0],["وَقُولُوا بِجَهْرٍ لِلمُسِرِّينَ رَيْبَهُمْ","أَفِي الشَّمْسِ رَيْبٌ بَعْد رائِعَة الفَجْرِ",169,"ر",1,0],["وَقَوْمٌ وَادِعُونَ أُوْلُو ذَكَاءٍ","شَمَائِلُهُمْ مُحَبَّبَةٌ جِيَادُ",170,"د",1,0],["وَقُوَّةُ نَفْسٍ إِذَا صُرفَتْ","فَمَا من بَعيدٍ عَلَيْهَا بَعيدُ",171,"د",1,0],["وَقِوَامُ أَمْرِ المُسْلِمينَ إِمَامُهُمْ","يَزَعُ السّفِيهَ ويَقْمَعُ العُدْوَانَا",172,"ن",2,0],["وقولوا زَلَلْنَا عَنْ مَخَالِبِ خَادِرٍ","بِهِ وَحَرٌ في الصّدْرِ مَا لَمْ يمارسِ",173,"س",1,0],["وقولي: كيف أعتذر؟","وهل تدرين ما الكلمات؟",174,"ت",1,0],["وقوة حفظ ثم صحة نقله","فما مثله من طالب لا ولا مقري",175,"ر",2,0],["وَقَوافٍ سَالَتْ مِنَ اللُّطْفِ حتَّى","لَحَسِبْنَا الْمُجْتَثَّ مِنْهَا طَويلاَ",176,"ل",2,0],["وَقُورٌ بدَرْسِ الدِّينِ يُطْرِق خاشِعاً","من النُّسْكِ يَرْجُو ربَّه ويُرَاقِبُه",177,"ب",2,0],["وقَوافٍ سَلْ أبا حَزْرَتِها","وسَلِ الأَخْطَلَ كَيْفَ ابتَدعَأها",178,"ا",3,0],["وقُوَّاتُ «باريسَ» قد أوْعَدَت","فما خَشيَتْ مصر إيعادها",179,"د",3,0],["وقواضبا بيضا سقين دم العدا","فبدا على صفحاتها توريده",180,"د",2,0],["وقويٌ باسم الضعافِ مجيلٌ","ظُفْرَهُ في محزِّ ألفِ ضعيف",181,"ف",1,0],["وقُولي قد صَبْرتُ على اغتباقٍ","فماذا لو صَبرتُ على اصِطباح",182,"ح",1,0],["وقولوا لمن ظنَ أنَّ الجموعَ","مطايا تُسَخَّرُ : يا \" ثعلب \"",183,"ب",1,0],["وقوافيَّ مثلَ حُسنك لما","تَتَعرَّينَ حرّةٌ عُريانة",184,"ن",2,0],["وَقُورٌ تُعَانيهِ الأُمُورُ، فتَنْجَلي","غَيَابَتُهَا عَنْ وَازِنِ الحِلمِ، رَاجحِ",185,"ح",1,0],["وَقُورٌ، يَرُدُّ العَفوُ فَرْطَ شَذاتِهِ،","وفي القَومِ أشتاتٌ: مُلِيمٌ وَمُجرِمُ",186,"م",1,0],["وقوّض مفعولها الراسيات","فصارت غبارا له جلجه",187,"ل",3,0],["وُقُوفاً بهَا صَحْبي عَليّ، كَأنّني","بهَا سَلَمٌ في كَفّ صَاحِبِهِ ثَأرُ",188,"ر",1,0],["وَقَوْم يَهُزّونَ الرّمَاحَ بِمُلْتَقىً،","أسَاوِرُهُ مَرْهُوبَةٌ وَمَرَازِبُهْ",189,"ب",2,0],["وقوارب صيد ، وطيورا",".. وغروبا وردي المئزر",190,"ر",1,0],["وقوتُه الحكمة ُ لا الحُكَّامُ","تَرْعى جَنَابَيْ داره الأيتامُ",191,"م",1,0],["وقوقدتْ في ليلة ٍ من قارها","كتوقّدِ المِرّيخِ في الظّلماءِ",192,"ا",2,0],["وقولا: إنّ سركَ، يومَ","مَ بَطْنِ الخَيْفِ قَدْ شُهِرا",193,"ر",2,0],["وقولا لها: إنّ النوى أجنبية ٌ","بنا، وبكم، قد خفتُ أن تتتمما",194,"م",2,0],["وقولا لها: ما في العبادِ كريمة ٌ","أَعَزَّ عَلَيْنا مِنْكِ طُرَّاً وَأَكْرَمَا",194,"م",2,0],["وقولا له: ما شاعَ قولُ محرشٍ","لدي، ولا رامَ الرضا، أم ترغما",194,"م",2,0],["وقولي في مُلاطَفَة ٍ","أزينبُ نوِّلي عُمَرا!",195,"ر",2,0],["وَقولي، في مُعَاتَبَة ٍ،","لِزَيْنَبَ: نَوِّلي عُمَرَك",196,"ك",1,0],["وقولها للثريا يومَ ذي خشبٍ،","وَکلدَّمْعُ مِنْهَا عَلَى الخَدَّيْنِ ذو سَنَنِ",197,"ن",1,0],["وقو اساس الود بالصدق فالذي","على جرف هار يؤسس ينقض",198,"ض",1,0]]}