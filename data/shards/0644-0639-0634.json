{"poems":[[2,"لسلمى بشرقي القنان منازل","https://www.aldiwan.net/poem25022.html","الطويل"],[173,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145777","المتقارب"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124668","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58016","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35086","الوافر"],[4800,"العنيده","https://www.poetsgate.com/ViewPoem.aspx?id=104750",""]],"verses":[["لَعِشنا ذَوي أَيدٍ ثَلاثٍ وَإِنَّما ال","حَياةُ قَليلٌ وَالصَفاءُ التَباذُلُ",0,"ل",1,0],["لِعِشرينَ لاحَ الشَّيبُ فِيَّ وَأَوجَفَت","عَلَيَّ خُيولُ المُرزِئاتِ الضَوابِحُ",1,"ح",1,0],["لَعِشتُ عَزيزاً فيهمُ وَلما اِجتَرا","يَمُدُّ إِليَّ الضَّيمَ باعاً وَلا يَدا",2,"د",2,0],["لِعَشْرِ سِنينٍ مَضَتْ عَالِقٌ","بِرِجْلَيَّ هَاتينِ طِيْنُ قُرَاهَا",3,"ا",3,0],["لِعَشْرٍ مَضَتْ تَرتَدي عُريَهَا","وتشْكُو ويُبْكي السَمَا مُشتكَاهَا",3,"ا",3,0],["لعشتروت الزورقُ الأخضرُ","يسبحُ في النور ولا يَعثرُ",4,"ر",1,1],["لعشرِ محرَّمٍ من عامِ خَمْسٍ","وستِّينٍ تَقَضَّتْهَا الدُّهُورُ",5,"ر",1,0],["لِعَشرٍ مِن مَنِيَّتِهِ خَوالٍ","مَلَأنَ جَوىً ضُلوعِيَ وَاِكتِراثا",6,"ث",2,0],["لعشقي لك معي أصدق شهاده","أنا بْدونك بهاالدنيا شريده",7,"د",2,0]]}