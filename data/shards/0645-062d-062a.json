x?id=186607",""],[5186,"محت الدهور الراسخات وقصرت","https://www.poetsgate.com/ViewPoem.aspx?id=156481",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5324,"ما عاد سجيل العراق يقضّهم .","https://www.poetsgate.com/ViewPoem.aspx?id=207471",""],[5463,"هنا تركني .. أعاني أحترق ساهر ..","https://www.poetsgate.com/ViewPoem.aspx?id=34270",""],[5463,"وينك عذولي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=34271",""],[5573,"تدرين انا محتار ياكثر اساميك","https://www.poetsgate.com/ViewPoem.aspx?id=200072",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5573,"البارحه خايلت وصلك سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=213729",""],[5629,"جداً حزين","https://www.poetsgate.com/ViewPoem.aspx?id=184504",""],[5756,"سمو المجد","https://www.poetsgate.com/ViewPoem.aspx?id=5373",""],[5764,"الواقع المر","https://www.poetsgate.com/ViewPoem.aspx?id=137045",""],[5764,"رجلي وبابك","https://www.poetsgate.com/ViewPoem.aspx?id=191426",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5837,"سجين المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=181854",""],[5848,"فرحة حزين","https://www.poetsgate.com/ViewPoem.aspx?id=50617",""],[5950,"محتاج لي ليلٍ طويل وخلوة","https://www.poetsgate.com/ViewPoem.aspx?id=139965",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""]],"verses":[["مُحتَزِماً قَد لَبِسَ القَتاما","رَأَيتَهُم ضَراغِماً تَسامى",0,"م",2,0],["مُحتَمِلُ الأَعباءِ لا","يَجُرُّها مِنَ السَأَم",1,"م",1,0],["مُحّتْ جوانِبَها البُرودُ وإنْ تكُنْ","شبّتْ بِها الأعْداءُ جُذْوَةَ نارِ",2,"ر",1,0],["مَحَتها الريحُ وَالأَمطارُ حَتّى","حَسِبتَ رُسومَها في الأَرضِ شاما",3,"م",2,0],["مُحتَمِلاً ثِقْلاً على رأْسه","تضعُفُ عنه قُوَّةُ الجَلْدِ",4,"د",1,0],["محتقراً ما أتى وقد غمر ال","آمال طُولاً وجاوز الهمما",5,"م",2,0],["محترما معظِّما","مبجلا هذا النسب",6,"ب",1,0],["محتالة على الغضب","شاكية ولا سبب",7,"ب",1,0],["مُحتَقَرٌ في هِمَّتي","كَشَعرَةٍ في مَفرِقي",8,"ق",2,0],["مُحتَضَرِ البابِ إِمّا آذِنِ النَقَرى","أَو فائِتٍ لِعُيونِ الوَفدِ مَحجوبِ",9,"ب",1,0],["مَحَت رسمَ الكَرى عن مُقْلتَيه","رَواسمُ لا تَمَلُّ من الرَّسيمِ",10,"م",1,0],["مَحَتها رِياحٌ لِمَنونِ عَواصِفٌ","عَلى أَنَها لا تُتَّقى حينَ تَعصِفُ",11,"ف",1,0],["مَحَت نَكَباتُهُ سُبُلَ المَعاني","وَأَطفَأَ لَيلُهُ سُرُجَ العُقولِ",12,"ل",1,0],["مَحَتِ الكَرى بَينَ الجُفونِ وَرُبَّما","غَسَلَت سَوادَ المُقلَةِ الكَحلاءِ",13,"ا",2,0],["مُحتَجِباتٍ غَيرَ بادِياتِ","إِلّا بِأَن يُجلَبنَ بِالطاساتِ",14,"ت",1,0],["محتدما بينها نزاع","لأجل أن يحصل البقاء",15,"ا",2,0],["مَحَت تخومُ بنيها الضادُ فاتَّحَدَتْ","أقطارُهم؛ فهمو في الضاد إخوان",16,"ن",1,0],["محترق الأكباد من حسرته","لاغوث لا منصف لا يلوي الى",17,"ا",1,0],["محتمشا مضطغنا صمصامة","يحوش أكداس الرعال كالقطا",17,"ا",1,0],["محتبه فرض على كل مسلم","يدين بهذا عندنا البدو والحضر",18,"ر",1,0],["مُحتَكِراً لِلمَجِّ وَالرُزِّ وَال","حِنطَةِ وَالشَعيرِ وَالتَمرِ",19,"ر",1,0],["محت آيةَ الطائيّ سورةُ جودِه","كآية ليلٍ قد محاها عَيام",20,"م",1,0],["محت قيساً وليلاهُ الليالي","وغال الموت غيلاناً وميّا",21,"ي",2,0],["مُحتَجِبٌ عَن كُلِّ ذامٍ عِرضُهُ","وَلَيسَ عَن حُسنِ الثَنا بِمُحتَجَب",22,"ب",1,0],["محتْ بودقِ الرزايا والفجائع مِنْ","صحفِ الكمالِ سوادَ القلبِ والمقل",23,"ل",1,0],["مَحَت آثارها للحيّ نأيٌ","وممَّنْ أَنْتَ تهواه نزوح",24,"ح",1,0],["محت آيها الأرواح وابتكرت بها","بواكر سحب الأتي المسحب",25,"ب",1,0],["مُحتجِزاً أندبُ مِن أمسِيَ ال","ماضي أخاً ماتَ ولم يُعقب",26,"ب",1,0],["محتفلٌ بالخطوب دوني فقد","أصبحت بالخطب غير محتفل",27,"ل",1,0],["محت أعلامها أيدي السوافي","كما تمحو الصحيفة كفُّ ماحي",28,"ح",2,0],["مَحَتِ السّوادَ خُدودُهُم فتورّدت","وجِفانهُم ممّا سفكْنَ من الدِّما",29,"م",2,0],["محتجب لكنه ظاهر","لكل من عنه نفى الإشتباه",30,"ا",2,0],["مَحَتِ الرّياحُ سُطُورَ آيِهِما","ذَرواً فَما يُعرَفنَ بِالوَهمِ",31,"م",1,0],["مَحَتِ الرّياحُ طُلُولَه فَكَأنَّما","أبقينَ من زُبُرِ الأَوائِل مُصحَفا",32,"ف",2,0],["مَحَتِ الخُطوبُ طُلولَه فَكَأنمّا","أبقَينَ مِن زُبَرِ لاأوائِلِ مُصحَفا",33,"ف",2,0],["مَحَت فَصاحَتُها دَعوى مُعارِضها","وَقَد كَسَتها يَداها ثَوبَ مُمتحقِ",34,"ق",1,0],["محتقب للشكر لا للهمى","والشكر من أنفس ما يحتقب",35,"ب",1,0],["مُحْتَنِيَ البَغْيِ مُهَاناً صاغِرا","تَسْحَبُ رِجْلاهُ قِمِطْراً شاغِرا",36,"ر",2,0],["مُحْتَدِماً فِي صَدْرِهِ تَوَغُّمُهْ","لَوْ يُسأَلُ الجَدْعَ أَقَرَّ تَصْلِمُهْ",37,"م",2,0],["محترِزاً مِن العَدو مُحتَرس","تَنج وَتَسلم مِن أَذاه وَتكس",38,"س",1,0],["مُحتَدِمَ الجَري يُبارى ظِلَّهُ","وَيُعرِقُ الأَحقَبَ في سَوطِ الخبب",39,"ب",1,0],["محت آية الأفقار آية فضلهم","وجاءوا على حصر الكمال بسلطان",40,"ن",1,0],["محتني يد الرحمن عَن حرف صورتي","وغيبني عني فَلَم أَر إِلّا هُوَ",41,"ه",2,1],["محت سرور اذنوب الدهر أجمعها","فماله بعد ذنب غير مغتفر",42,"ر",1,0],["مُحْتَكِمَاتٌ في دماءِ الورى","كأنَّها من ذاكَ في حِلِّ",43,"ل",1,0],["محت يد شعب السين بيضاء سوءَ ما","أتى شيخُه والمرء يحزُ به الأمر",44,"ر",1,0],["محتمى الجانب موفور الحبا","نافذ الجاه ومرفوع السند",45,"د",1,0],["محتد كالتبر وضاء السنا","والحسام العضب تجلوه القيون",46,"ن",1,0],["مَحَت ظُلماتُ الشرك أنوارُ هديهِ","فظلَّت الجلباب الضلال تمزّقُ",47,"ق",1,0],["محت يد الأنواء آياته","إلا بقايا أسطرٍ تبدو",48,"د",2,0],["مُحتَكِماً فيهِ بضيقٍ حُسِبَا","فَقِس وَجَرِّبهُ كَمَن قَد جَرَّبَا",49,"ب",2,0],["مُحْتَجِباً لا يزالُ وهو إِذا","رأَيتَه بالصُّدودِ مُحْتَجِب",50,"ب",1,0],["مُحتَرِقٌ ما مَسّني حَريقُ","يَرثي ليَ العَدوَّ وَالصَديقُ",51,"ق",1,0],["مُحتَجَزٍ عَن الطَريق المَهيَعِ","مُجَلَّلٍ بساحاتٍ وُقَّعِ",52,"ع",1,0],["محت حسد الحسّاد حتّى غدو بها","وكلّ عدُوّ للعدُوّ مُصاحبُ",53,"ب",1,0],["محت فصاحتها من كان ذا لسنٍ","فكلهم برمٌ بالنطق من خجل",54,"ل",1,0],["محته يد القضاء فراح","لا روح ولا جسد",55,"د",1,0],["محتفة بكوكب خفى","يبصره ذو بصر ذكى",56,"ك",2,0],["محترق الأحشاء من حسرته","ممتحق الشاهد من حيرته",57,"ت",2,1],["محتَّم مدحي مستحب وواجبٌ","لعليائه إذ فاق في الدهر حاتمه",58,"م",2,0],["محتْهُ الرياحُ الهُوجُ يَحْننَّ بالحصى","ونَوءُ الثريّا الجَودُ منهُ ووابلُهْ",59,"ل",2,0],["مُحتلُّ أحْوِيَةٍ عليهمْ بهجةٌ","بسواءِ مُشْرِفةٍ بهمْ مِحْلالِ"