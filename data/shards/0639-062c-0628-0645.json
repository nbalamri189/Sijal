{"poems":[[55,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[47,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54902","الخفيف"],[422,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99075","المديد"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70377","الخفيف"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32388","الرمل"]],"verses":[["عَجَبٌ مِنَ الأَيّامِ رُؤيَةُ مِثلِهِ","نَجمَ العُلى إِذ كُلُّ نَجمٍ غارِبُ",0,"ب",1,0],["عَجَبٌ مِنهُ يَومَ ذاكَ وَمِنّي","يَتَقَصّى بِالضاحِكِ اِستِغرابَهُ",1,"ب",2,0],["عجَبٌ مَا رَأَيْتُهُ فِي زَمَانِي","مِنْ بُغَاثٍ مُسْتَنْسِرٍ لا يَطِيرُ",2,"ر",1,1],["عَجبٌ منه ومن أخلاقِه","لو تَتبَّعْتَ أعاجيب الزمان",3,"ن",1,0],["عجب ما مثله عجب","فعلوا بي غير ما يجب",4,"ب",1,1],["عجبٌ من عجائب البر والبحْ","ر ونَوْعٌ فَرْدٌ وشكْلٌ غريبُ",5,"ب",1,0],["عَجَبٌ ما عَجَبٌ أَعجَبَني","مِن غُلامٍ حَكَمِيٍّ أُصُلا",6,"ل",2,1]]}