{"poems":[[83,"هب النسيم على الرياض مع السحر","https://www.aldiwan.net/poem54309.html","الكامل"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[4,"الكلب والشاعر في منزل","https://www.aldiwan.net/poem21284.html","السريع"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[23,"هل ههنا من ولد قرد من أحد","https://www.aldiwan.net/poem21546.html","الرجز"],[51,"لنا صديق مارد","https://www.aldiwan.net/poem65827.html","مجزوء الرجز"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[45,"ذكرتنيك روحة للشمول","https://www.aldiwan.net/poem65597.html","الخفيف"],[45,"أهلك والليل أيها الرجل","https://www.aldiwan.net/poem65644.html","المنسرح"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[100,"في بيتها العريق","https://www.poetsgate.com/ViewPoem.aspx?id=50421",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"ضائع في المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=50409",""],[100,"لص تحت الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=50429",""],[100,"رحلة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=50115",""],[100,"صنعاني يبحث عن صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=50407",""],[116,"هل هداك الله ففاضت عيوننا","https://www.aldiwan.net/poem41255.html","عموديه"],[133,"يا أيها القوم إني سائل ألكم","https://www.aldiwan.net/poem54754.html","البسيط"],[136,"هل هذه الشمس منها الطرف مفتون","https://www.aldiwan.net/poem48889.html","البسيط"],[136,"في كل شيء شكله معجب","https://www.aldiwan.net/poem49149.html","السريع"],[143,"يا شهوة النوم وما لدته","https://www.aldiwan.net/poem58393.html","السريع"],[161,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[262,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[372,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[372,"أما اشتفى كاشح ولا حاسد","https://www.aldiwan.net/poem57477.html","المنسرح"],[433,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[454,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[459,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[459,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[465,"هل هز بالأعطاف سمر صعاده","https://www.aldiwan.net/poem3623.html","عموديه"],[466,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[471,"هل هيجتك مغاني الحي والدور","https://www.aldiwan.net/poem4714.html","البسيط"],[476,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[496,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[516,"حرت ماذا أقول فيما دهاني","https://www.aldiwan.net/poem12293.html","الخفيف"],[552,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[560,"أيها الناظر فيه في سطح المرى","https://www.aldiwan.net/poem69354.html","الرمل"]],"verses":[["هل هذه أم روضة البشرى التي","فيها لأرباب البصائر مُعتَبَرْ",0,"ر",1,0],["هل هذّ بنيانها من فوقُ صاعقة","أوهدَ بنيانها من تحتُ زلزال",1,"ل",1,0],["هَل هُوَ إِلّا باسِطٌ كَفَّهُ","يَستَطعِمُ الوارِدَ وَالصادِرا",2,"ر",2,0],["هَل هِيَ إِلّا ظَبيَةٌ مُطفِلٌ","مَألَفُها السِدرُ بِنَعفي بَرام",3,"م",1,0],["هَل هَهُنا مِن وُلدِ قِردٍ مِن أَحَد","يَرُدُّ عَنهُم رَجَزَ اليَومِ وَغَد",4,"د",1,1],["هل هو إلا قولهم","واهاً له ما أنيكهْ",5,"ك",2,0],["هل هابط وهداً كمن","فوق السحاب له مكر",6,"ر",1,0],["هَل هُيِّئَت دَرَجُ السَما","ءِ لَهُ وَهَل نُصَّ الأَثير",7,"ر",1,0],["هَل هُمُ لا رَأَيتُهُمُ غَيرُ أَبنا","ءِ شُيَيخٍ رَثِّ الأَداةِ ضَئيلِ",8,"ل",1,0],["هَل هُوَ إِلّا سَبيلُ أَوَّلِكَ ال","ماضينَ أَينَ الجَحاجِحُ الأُوَّلُ",9,"ل",1,0],["هل هُوَ إلا طالِعٌ للهُدى","سارَ منَ التُّرْبِ إلى سَعْدِهِ",10,"د",2,0],["هِلْ هِيَ إِلَّا مُدَّةٌ تَنْقَضِي","وَكُلُّ نَفْسٍ خُلِقَتْ لِلرَّدَى",11,"د",2,0],["هَلْ هَذِهِ المَثُلاتُ وَهْيَ رَوَائِعٌ","فِيْهَا لَنَا عِظَةٌ وَفَصْلُ خِطَابِ",12,"ب",1,0],["هل هذا البيت بعزته","أمسى أحضانا مبذولة",13,"ل",2,0],["هل هنا لابن سبيل الريح من","موعدٍ؟ أو هاهنا دفء لقاءِ؟",14,"ا",2,0],["هل هنا أو هناك غير جذوع","غير طين يضجّ ، يعدو وبقعي",15,"ع",2,0],["هل هذا الأحسن أم هذا ؟","يبدو لا شيء هنا أحسن",16,"ن",1,0],["هل هنا موطني ؟ وأضغي : وهل","لي موطن غيره على الأرض ثاني ؟",17,"ن",2,0],["هل هذه صنعاء ... ؟ مضت","صنعا سوى كسر بوالي",18,"ل",2,0],["هل هداك الله ففاضت عيوننا","دماء وراح القلب بالنار لاهبا",19,"ب",2,1],["هَل هذِه قِصةٌ وَحدِى انفَرَدتُ بها","جَوَابُ مَريمَ لِى من عام أوَ لَكُم",20,"م",1,0],["هل هذه الشمس منها الطرف مفتونُ","أم مظهر الحسن يبدو فيه تحسينُ",21,"ن",1,1],["هل هذه الدنيا سواه وهل","في الكونِ شيء غير هذا الربيب",22,"ب",1,0],["هل هو إلا مِيتَةُ عُجِّلتْ","وإنما قد قرُبت رجَعتُهْ",23,"ه",1,0],["هل هذه صفة الرجال ذوي التفا","أين الحجا أين الحياء من الورا",24,"ر",2,0],["هل هوى تلك العراص","جاذب أيدي القلاص",25,"ص",1,1],["هَل هي بئرُ زمزم","أَم هيَ بحرُ القُلزم",26,"م",1,0],["هَل هائِمٌ دَنِفٌ كَما أنا هائِمُ","فأقِيمَهُ لكَ لائِماً يا لائِمُ",27,"م",1,1],["هل هيَ إلا من السيوفِ وهل","يُسعدُها غير ذلك الساعِد",28,"د",1,0],["هل هدمَ العَسْرُ بعد رِفعَتِه","إلا بما شادَ في العُلى وبَنى",29,"ن",2,0],["هل هيئة الأمم التي قد كفنت","في المهد أم أسر يمض أنينها",30,"ن",3,0],["هل هو إلا أن قيل جُنَّ بها","نَعَمْ على كلّ ما جَنَتْ نَعَمُ",31,"م",1,0],["هل هو إلا الشيب أمَّ مالك","لابدّ أن يصبحَ ليلُ الممسي",32,"س",2,0],["هل هزَّ بالأعطافِ سمرَ صعادهِ","أم جرَّد الألحاظَ من أغمادهِ",33,"د",2,1],["هَل..هَل سَمِعتُكَ يا مَولايَ تَسألُني ؟","أدري بأنَّكَ تَدري فَوقَ ما أصِفُ",34,"ف",1,0],["هَل هَيَّجَتكَ مَغاني الحَيِّ والدُورُ","فاشتَقت إِنَّ البَعيدَ الدارِ مَعذورُ",35,"ر",1,1],["هَل هاجَكَ اللَيلَ كَليلٌ عَلى","أَسماءَ مِن ذي صُبُرٍ مُخيِلِ",36,"ل",1,0],["هل هذه البيضُ من الآثارِ","إلا لثاني المصطفى في الغارِ",37,"ر",1,0],["هل هو الدهر قد تعدى عليه","أم أمور جرت من الرحمن",38,"ن",1,0],["هَل هاجَ شَوقَك صوتُ الطائرِ الغَرِدِ","في الرّبعِ والرّبعُ عُريانٌ بلا أحدِ",39,"د",1,1],["هلْ هُوَ النّاظر فيه غيرُكمْ","أمْ خيَالُ مِنْكَ فيه قَدْ سرَى",40,"ر",2,0]]}