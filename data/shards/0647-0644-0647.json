://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[5302,"برزت بكل أناقة","https://www.poetsgate.com/ViewPoem.aspx?id=205143",""],[5353,"بيروت تحفل بالأسى","https://www.poetsgate.com/ViewPoem.aspx?id=215399",""],[5376,"في غوطةِ الشامِ أحزانٌ وآلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=192672",""],[5443,"درس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185153",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5620,"سُباعِيَّةٌ عَلى الْقَبرْ","https://www.poetsgate.com/ViewPoem.aspx?id=196905",""],[5672,"أشواقنا","https://www.poetsgate.com/ViewPoem.aspx?id=214933",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[5725,"قالوا","https://www.poetsgate.com/ViewPoem.aspx?id=194072",""],[5746,"طائرُ الحيّ","https://www.poetsgate.com/ViewPoem.aspx?id=207129",""],[5776,"إسراءٌ ممهورٌ بالدمْ","https://www.poetsgate.com/ViewPoem.aspx?id=205848",""],[5829,"نكبة 2012","https://www.poetsgate.com/ViewPoem.aspx?id=152668",""],[1920,"جدارٌ مُنهك","https://www.poetsgate.com/ViewPoem.aspx?id=198877",""],[6075,"في صفحة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=190530",""],[6120,"‏أُكذُوبَةُ الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=213466",""],[6120,"قَلْبِيْ عَلَىٰ نَارِ الصَّبَابَةِ يَكْتَوِي","https://www.poetsgate.com/ViewPoem.aspx?id=213514",""],[6171,"بيت شعري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86322&r=&rc=0",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6202,"هيهات هيهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86756&r=&rc=57",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""]],"verses":[["هل هذه أم روضة البشرى التي","فيها لأرباب البصائر مُعتَبَرْ",0,"ر",1,0],["هل هذّ بنيانها من فوقُ صاعقة","أوهدَ بنيانها من تحتُ زلزال",1,"ل",1,0],["هَل هُوَ إِلّا باسِطٌ كَفَّهُ","يَستَطعِمُ الوارِدَ وَالصادِرا",2,"ر",2,0],["هَل هِيَ إِلّا ظَبيَةٌ مُطفِلٌ","مَألَفُها السِدرُ بِنَعفي بَرام",3,"م",1,0],["هَل هَهُنا مِن وُلدِ قِردٍ مِن أَحَد","يَرُدُّ عَنهُم رَجَزَ اليَومِ وَغَد",4,"د",1,1],["هل هو إلا قولهم","واهاً له ما أنيكهْ",5,"ك",2,0],["هل هابط وهداً كمن","فوق السحاب له مكر",6,"ر",1,0],["هَل هُيِّئَت دَرَجُ السَما","ءِ لَهُ وَهَل نُصَّ الأَثير",7,"ر",1,0],["هَل هُمُ لا رَأَيتُهُمُ غَيرُ أَبنا","ءِ شُيَيخٍ رَثِّ الأَداةِ ضَئيلِ",8,"ل",1,0],["هَل هُوَ إِلّا سَبيلُ أَوَّلِكَ ال","ماضينَ أَينَ الجَحاجِحُ الأُوَّلُ",9,"ل",1,0],["هل هُوَ إلا طالِعٌ للهُدى","سارَ منَ التُّرْبِ إلى سَعْدِهِ",10,"د",2,0],["هِلْ هِيَ إِلَّا مُدَّةٌ تَنْقَضِي","وَكُلُّ نَفْسٍ خُلِقَتْ لِلرَّدَى",11,"د",2,0],["هَلْ هَذِهِ المَثُلاتُ وَهْيَ رَوَائِعٌ","فِيْهَا لَنَا عِظَةٌ وَفَصْلُ خِطَابِ",12,"ب",1,0],["هل هذا البيت بعزته","أمسى أحضانا مبذولة",13,"ل",2,0],["هل هنا لابن سبيل الريح من","موعدٍ؟ أو هاهنا دفء لقاءِ؟",14,"ا",2,0],["هل هنا أو هناك غير جذوع","غير طين يضجّ ، يعدو وبقعي",15,"ع",2,0],["هل هذا الأحسن أم هذا ؟","يبدو لا شيء هنا أحسن",16,"ن",1,0],["هل هنا موطني ؟ وأضغي : وهل","لي موطن غيره على الأرض ثاني ؟",17,"ن",2,0],["هل هذه صنعاء ... ؟ مضت","صنعا سوى كسر بوالي",18,"ل",2,0],["هل هداك الله ففاضت عيوننا","دماء وراح القلب بالنار لاهبا",19,"ب",2,1],["هَل هذِه قِصةٌ وَحدِى انفَرَدتُ بها","جَوَابُ مَريمَ لِى من عام أوَ لَكُم",20,"م",1,0],["هل هذه الشمس منها الطرف مفتونُ","أم مظهر الحسن يبدو فيه تحسينُ",21,"ن",1,1],["هل هذه الدنيا سواه وهل","في الكونِ شيء غير هذا الربيب",22,"ب",1,0],["هل هو إلا مِيتَةُ عُجِّلتْ","وإنما قد قرُبت رجَعتُهْ",23,"ه",1,0],["هل هذه صفة الرجال ذوي التفا","أين الحجا أين الحياء من الورا",24,"ر",2,0],["هل هوى تلك العراص","جاذب أيدي القلاص",25,"ص",1,1],["هَل هي بئرُ زمزم","أَم هيَ بحرُ القُلزم",26,"م",1,0],["هَل هائِمٌ دَنِفٌ كَما أنا هائِمُ","فأقِيمَهُ لكَ لائِماً يا لائِمُ",27,"م",1,1],["هل هيَ إلا من السيوفِ وهل","يُسعدُها غير ذلك الساعِد",28,"د",1,0],["هل هدمَ العَسْرُ بعد رِفعَتِه","إلا بما شادَ في العُلى وبَنى",29,"ن",2,0],["هل هيئة الأمم التي قد كفنت","في المهد أم أسر يمض أنينها",30,"ن",3,0],["هل هو إلا أن قيل جُنَّ بها","نَعَمْ على كلّ ما جَنَتْ نَعَمُ",31,"م",1,0],["هل هو إلا الشيب أمَّ مالك","لابدّ أن يصبحَ ليلُ الممسي",32,"س",2,0],["هل هزَّ بالأعطافِ سمرَ صعادهِ","أم جرَّد الألحاظَ من أغمادهِ",33,"د",2,1],["هَل..هَل سَمِعتُكَ يا مَولايَ تَسألُني ؟","أدري بأنَّكَ تَدري فَوقَ ما أصِفُ",34,"ف",1,0],["هَل هَيَّجَتكَ مَغاني الحَيِّ والدُورُ","فاشتَقت إِنَّ البَعيدَ الدارِ مَعذورُ",35,"ر",1,1],["هَل هاجَكَ اللَيلَ كَليلٌ عَلى","أَسماءَ مِن ذي صُبُرٍ مُخيِلِ",36,"ل",1,0],["هل هذه البيضُ من الآثارِ","إلا لثاني المصطفى في الغارِ",37,"ر",1,0],["هل هو الدهر قد تعدى عليه","أم أمور جرت من الرحمن",38,"ن",1,0],["هَل هاجَ شَوقَك صوتُ الطائرِ الغَرِدِ","في الرّبعِ والرّبعُ عُريانٌ بلا أحدِ",39,"د",1,1],["هلْ هُوَ النّاظر فيه غيرُكمْ","أمْ خيَالُ مِنْكَ فيه قَدْ سرَى",40,"ر",2,0],["هَل هُوَ إن صَفَّقَ النَّسيمُ لَهُ","تَرقُصُ أوراقُهُ وَأَغصانُه",41,"ن",2,0],["هل هجتُ أبطالاً وسقتُ كتائباً","وحملت بالأسياف والنيران",42,"ن",1,0],["هل هذه بكر الربا","ام هذه غرر الرشاد",43,"د",1,0],["هَل هَذِهِ النملة بِي تُقاسُ","ما صَحَ قَطُّ بَينَنا قِياس",44,"س",1,0],["هَل هُو مثل المَوضع المَسكون","يحسن في النفوس وَالعُيون",45,"ن",1,0],["هَلهَل النَسجِ لَيسَ يَستُرُ مِنهُ","عَورَةً أَو يَصونُ من سَوءائِه",46,"ا",3,0],["هل هو إلا هكذا العذاب","وقد إذا الإصطبل والجناب",47,"ب",1,0],["هل هَمى دَمْعُ الغَمام به","واستَهلَّتْ منه أَجفانُ",48,"ن",1,0],["هل همْ لِحَيْني صَبَوْا في حينَ قلتُ لهمْ","يا للأحبةِ إِنَّ الهَجرَ قتَّالُ",49,"ل",1,0],["هل هاجر الدار يدري بعد غربته","ان السرور بعيد عن محبيه",50,"ي",2,0],["هل هذه الأرواح إلاّ جوهرٌ","أبَداً يُرَى بِيَدِ الحِمَامِ نضيدا",51,"د",2,0],["هل همزة من ما وأي أينا","كم كيف أيان متى ام أنى",52,"ن",2,0],["هَلهِل لِكَعبٍ بِعدَما وَقَعَت","فَوقَ الشُؤونِ بِمِعصَمٍ فَعمِ",53,"م",1,0],["هلهلت تندب من بعد ارعواً عُصُرا","أيام تسحب من ربط الصبا حُلَلا",54,"ل",2,0],["هل هزمنا حتى أضعنا عقولاً","وغدونا نع