{"poems":[[55,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[65,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[68,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54957","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54313","السريع"],[240,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[257,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[369,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[466,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[580,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65045","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95557","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47124","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204632","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74174","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70038","الوافر"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105573","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52146","الكامل"],[4768,"المُستثنى بحبّها","https://www.poetsgate.com/ViewPoem.aspx?id=215532",""],[4797,"تالي عصير","https://www.poetsgate.com/ViewPoem.aspx?id=29435",""],[4929,"عيناك إن رفع الغرام لواء","https://www.poetsgate.com/ViewPoem.aspx?id=205904",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5488,"يابارق من جدا الشرق سناي","https://www.poetsgate.com/ViewPoem.aspx?id=100728",""],[5956,"استبشري يا زوجتي أنا قادمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182383",""],[5956,"لا تَقبلين بعاشق متمرس ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182626",""]],"verses":[["رَأيٌ يُغَبُّ إِذا الرِجالُ تَلَهوَجوا","الآراءَ أَو عَجِلوا عَنِ التَسديدِ",0,"د",1,0],["رَأيٌ يَغُبُّ لِحَزمٍ","وَنائِلٌ لا يَغُبُّ",1,"ب",1,0],["رأيٌ يُطِلُّ على الخُطوبِ فتَنْجَلي","عنهُ وكَيْدٌ بالعَدوِّ يَحيقُ",2,"ق",1,0],["رَأيٌ يَرى ما تَحتَ أَطباقِ الثَرى","وَعُلاً تُريدُ إِلى السَماءِ صُعودا",3,"د",2,0],["رائياً إنكارَ ضُرٍّ مَسّهُ","حَذَرَ التّعنيفِ في تعريفِ رَي",4,"ي",1,0],["رَأْيٌ يُصِيبُ مِنَ الْحَقَائِقِ مَا","يَخْفَى وَيخْطِيءُ دُونَهُ النَّظَرُ",5,"ر",1,0],["رَأَيٌ يُريكَ اللَّيْلَ شمْس الضحى","وَهِمَّةٌ كَالنجْم في بُعْدِهِ",6,"د",2,0],["رَأيٌ يَفُلُّ البيضَ وَهيَ حَدائِدٌ","وَسُطىً تَرُدُّ الجَيشَ وَهوَ عَرَمرَمُ",7,"م",1,0],["رأيٌ يُضيءُ اذا الحَوادِثُ أَظلَمَت","فَدجت وَيَمضي وَالحُسام كَليلُ",8,"ل",1,0],["رائياً في ابْنكَ النّجيب من الآ","مال ما قد رأَتْه فيكَ الجُدود",9,"د",1,0],["رأيٌ يكون على الغُيوبِ طليعةً","فالمُضمرُ المكنونُ مثلُ المُظْهَر",10,"ر",1,0],["رأَيْي فَطِيرٌ ذُكَّ آخِرهُ","والرأْيُ يُحْمَدُ بَعْدَ تَخْمِيرِ",11,"ر",1,0],["رائِيُّهُ حائِزُ الْقِلى","إِذْ قَلْبُهُ مِثْلُ قَلْبِ هَجْري",12,"ر",2,0],["رأىٌ يحلل معضلاً","كالشمس تعتورُ الجلي",13,"ي",1,0],["رأي يردُّ على الزمان سهامَه","حتَّى تبيتَ صروفُه أَهدافَها",14,"ف",3,0],["رائيه يذكر ربّه عن غفلة","وفؤاده يَحْيَى بقولٍ مرشدِ",15,"د",1,0],["رأيي ورأيك واحد لكنما","هذا التخالف بيننا لمطامع",16,"ع",1,0],["رَأي يريك صَباح الحَق مُنبَلِجاً","كَأَنَّما اِنشَقَ عَن جَنبيه ديجور",17,"ر",1,0],["رأيٌ يريك الليلَ مثل الفجرِ","ما للبليغ في الثنا بلوغُ",18,"غ",1,0],["رَأى يَعقوب مرقاةَ المَعالي","فامَّ بِها نَعيماً غَيرَ فائت",19,"ت",1,1],["رأي يريك الغيب في جنباته","كالصبح يطلع في السرار الأرقتم",20,"م",1,0],["رأيي كرأيك في الزمان وأهله","والناسُ فوضى والحياة أمانِ",21,"ن",1,0],["رأيي المُكبّلُ مصلوبٌ لمبدئه ِ","واللحنُ مُعتَقلٌ في خانة المغنى",22,"ن",2,0],["رايي كذا يا عاشقين الغنادير ..",".. ماله على وجه البسيطه وزيني",23,"ن",2,0],["رائيك ليس لقلبه من حيلةٍ","للعشق إلا أن يبيتَ وعاءا",24,"ا",3,0],["رائي التي هشّت عليها ياؤها","فبدت تُخزّن ومضها القدسيا",25,"ي",2,0],["راييت قلبي على كم كذا راي","وقفرته الحال والسد كله",26,"ل",2,0],["رأيي ورأيُكِ يا حبيبة صائبٌ","أمّا كلام الناصحين مزاعمُ",27,"م",1,0],["‏ ‏رأيي الذي بالفعل عاش ممارساً","‏ ‏ خيرٌ من اللاجي لعادة مفلس ِ",28,"س",1,0]]}