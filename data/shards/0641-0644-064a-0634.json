{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[95,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[56,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[53,"نبئت أن ابن خنساء","https://www.aldiwan.net/poem64960.html","المجتث"],[68,"هكذا إن بنى المنازل بان","https://www.aldiwan.net/poem40973.html","الخفيف"],[68,"أطلقت نطقي بالمحامد عندما","https://www.aldiwan.net/poem41346.html","الكامل"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[107,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[89,"أعائدٌ بكِ - يا ريحانة ُ - الزمنُ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23866&r=&rc=128",""],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[147,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[164,"أهلا بما أنسى الذنوب المذنب","https://www.aldiwan.net/poem58813.html","الكامل"],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[286,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[369,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[369,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[408,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[445,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[482,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[556,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[580,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107252","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122612","البسيط"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145644","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77921","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101064","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69378","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198395","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198392","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105009","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121011","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67193","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200056","الوافر"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121428","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123929","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114283","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95371","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125349","المتدارك"],[4755,"جَاءَ الذي راحَ أو رَاحَ الذي جَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=190325",""],[4829,"شمّا والمرج الدهيماني","https://www.poetsgate.com/ViewPoem.aspx?id=34260",""],[4578,"روض المعاني بأفنان الفنون دنا","https://www.poetsgate.com/ViewPoem.aspx?id=49598",""],[4119,"يا ليت أن الصد مصدود","https://www.poetsgate.com/ViewPoem.aspx?id=16113",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5444,"يمن المحن","https://www.poetsgate.com/ViewPoem.aspx?id=185390",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5493,"هذا الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=204450",""],[5688,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=200833",""],[402,"في حيكم لي قلب جد مرتهن","https://www.poetsgate.com/ViewPoem.aspx?id=36470",""],[6045,"ذكرى الشموخ","https://www.poetsgate.com/ViewPoem.aspx?id=206788",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""]],"verses":[["فَليَشكُرَنكَ ما شَكَرتُكَ غالِبٌ","وَذَوائِبُ الآباءِ مِن عَدنانِ",0,"ن",1,0],["فَليَشمَتِ الحُسّادُ في رَجُلٍ","أَمسَت مُناهُ وَأَصبَحَت صَرعى",1,"ع",2,0],["فَلْيَشْهَدُوا الْيَوْمَ وَالإِجْلالُ يُخْطِئُهُمْ","إِلَيْكَ مَا لِصَحِيحِ المَجْدِ مِنْ ثَمَنِ",2,"ن",1,0],["فَليَشكُروا اللَهَ ما شُكَري بِزائِدِهِم","وَليَحمَدوهُ فَإِنَّ الحَمدَ ذو مِقَةِ",3,"ه",1,0],["فلْيشكرِ الدهرُ لكم إِنّهُ","أرضى بكم من بعدما أغضبا",4,"ب",2,0],["فليشكروا لك أن كابدتَ دونهمُ","تلك الغمارَ التي تُودي بمن سبحا",5,"ح",2,0],["فليشتم النَغلُ عرضي","بالشَّتم لا المتقضِّي",6,"ض",2,0],["فَليَشِد قَبلَهُ البِناءَ كَما قَد","شَيَّدَتهُ مَناقِبُ السُلطانِ",7,"ن",1,0],["فَليَشكُرَنكَ نِيابَةً عَن مَنطِقي","صَدرُ الطُروسِ وَأَلسَنُ الأَقلامِ",8,"م",1,0],["فَليَشكُروا جُنحَ الظَلامِ وَدَروَذاً","فَهُمُ لِدَروَذَ وَالظَلامِ مَوالي",9,"ل",2,0],["فَلْيَشْكُروها مِنْهُ أُكْرُومَةً","مِن حَقِّها الواجبِ أن تُشكرا",10,"ر",2,0],["فَلْيَشْغَبِ الدَّهْرُ أَوْ تَسْكُنْ نَوَافِرُهُ","فَلَسْت مِنْهُ عَلَى مَا فَاتَ أَحْتَرِنُ",11,"ن",1,0],["فليشهدوا بعيونهم","أين السماع من الشهود؟",12,"د",1,0],["فليشهَدِ الناسُ طراً إنني خَجِلٌ","وليشهَدِ الناسُ طراً إنني بَرِم",13,"م",1,0],["فَلْيَشْغَبِ الدَّهْرُ، أَوْ تَسْكُنْ نَوَافِرُهُ","فَلَسْتُ مِنْهُ عَلَى مَا فَاتَ أَحْتَزِنُ",14,"ن",1,0],["فَليَشِم غَيرُنا السَحابَ فَقَد أَن","شَأتَ في الأَرضِ ديمَةَ وَطفاءَ",15,"ا",2,0],["فَليَشكُرَنَّكَ مَن تَعِبتَ مُشَمِّراً","كَي يَستَريحَ وَمَن سَهِرتَ لِيَرقُدا",16,"د",2,0],["فَليَشكُرَنَّكَ مَن تَعِبتَ مُشَمِّراً","حَتّى اِستَراحَ وَمَن سَهِرتَ وَناما",17,"م",2,0],["فليشكرنَّ الله عبدٌ قد جزى","هذا الجزا بعبادة لن تتعبا",18,"ب",2,0],["فَليَشكُرَنَّكَ مَن وَسَمتَ بِميسَمِ ال","حَسَناتِ أَيّاماً لَهُ أَغفالا",19,"ل",2,0],["فلي شجون من الأشجان ما عُرفَتْ","قبلي لمن قلبَه بالبين مَتبولُ",20,"ل",1,0],["فليَشِ العالمونَ أللَهُ يدري","أنّني ما صنعتُ غير الخير",21,"ر",1,0],["فَلي شَرابٌ عَذبُهُ مالِحٌ","لَهُ شَرابٌ مِلحُهُ عَذبُ",22,"ب",1,0],["فلْيَشْكُرَنَّ صَنيعَكَ المُلْكُ الّذي","أَبرمْتَه بالرَّأْيِ وهْو سَحيل",23,"ل",1,0],["فَلْيشكُرِ المُلْكُ ما أولَيتَ من منَنٍ","ولن يُصيبَ مَزيدَ البِرِّ مَن غَمَطا",24,"ط",2,0],["فلْيشكُرِ السلطانُ دام جلالُه","ما قد رَعْيتَ لمُلْكهِ وليَحْمَد",25,"د",1,0],["فَلْيشكروا اللهَ إذ ولاّكَ أرضَهمُ","فإنّها مِنّةٌ من أعظم المِننِ",26,"ن",1,0],["فليَشْكُرَنَّ الدينُ أَنْ أَوْليتَهُ","عطفَ الشقيقِ وخُلَّةَ الأَرحامِ",27,"م",1,0],["فَلْيَشْكُرِ اللهَ يَا مَنْصورُ مِنكَ يَداً","كَشَفْتَ عَنِّي بِهَا الأَحزانَ والكُرَبا",28,"ب",2,0],["فلي شأنَُاذا طفقتْ تراءَ ى","على حَضَنٍ وللأشواقِ شانُ",29,"ن",1,0],["فلي شُغلٌ عمّنْ أقامَ بمنْ مَضى","وعن معجباتٍ رُقْنَنَا بالعجائبِ",30,"ب",1,0],["فلَيْشكُرنَّك مِقْولي عن مُهْجةٍ","نَادت فكان نَداك رَجْعَ جَوابها",31,"ب",3,0],["فلِي شأنٌ عنِ الأغيارِ مُغنٍ","وَلِي شُغلٌ عَنِ الأشعارِ كافِ",32,"ف",1,0],["فَليَشرُفِ الحَرمُ الشَّريفُ بِحَجَّةٍ","رَتقَت مِنَ الَّدينِ الحَنيفِ فُتُوقا",33,"ق",2,0],["فليشكُروا لَكَ سَعياً لمي َفُتكَ بما","طافا مِنَ الأرض ذو القرنين والخَضِر",34,"ر",1,0],["فَلْيَشْهَدِ الثَّقَلانِ أنِّيَ مُبْتَلًى","والحُبُّ فيكَ مَدى الزَّمانِ شِفاءُ",35,"ا",2,0],["فليَ شاهدٌ مما ترينَ يجيبُ","تقول خليُّ البال عني وما رأت",36,"ت",1,0],["فليشتَفي منكم غَليل سقمي","وليشتَفي منكم غَليل فهمي",37,"ي",1,0],["فلي شيمة الحر الوفي وإنني","وصحبي غداً يا قوم مفترقان",38,"ن",1,0],["فَليَشكُروا مَلِكاً بِهِ وَبِخَيلِهِ","فَخَرَت كُهُولٌ مِنهُمُ وَشَبابُ",39,"ب",1,0],["فَلْيشْهَدِ التَّارِيخُ فَخْرَ صَنِعِةِ","في كلِّ قُطْرٍ نَاهضِ الأَمْجادِ",40,"د",1,0],["فليشهدْ التاريخُ كم هو مُصْلِحٌ","آثارُهُ نطقتْ بحُسْنِ جَلاِء",41,"ا",2,0],["فليشمتوا فمصاب آل محمد","مما يُسَرُّ به بنو مروان",42,"ن",1,0],["فليشهدنك له فؤادٌ صادقٌ","وشهودُهُ قَامَت عليهِ شهودُهُ",43,"د",2,0],["فَلْيَشكروا سوءاتهم كَمْ عنهُمو","بكشفها ذاكَ الهِزبر أعرضا",44,"ض",2,0],["فلي شغل عن الماضي بآتٍ","فإن أخطأت فيه فصحّحوه",45,"و",2,0],["فليشكرنَّ محمدٌ أسيافَ من","لولاه كان كخالدِ بن سنان",46,"ن",1,0],["فليشكر الفضل أياي منعم","أيقته في ابقاء شمس سعده",47,"د",2,0],["فَليَشهِدَ الثَّقَلاَنِ أنِّي خَادِمٌ","لِغُبَارِ نَعلِكَ لاَثِمٌ لِثَرَاكَ",48,"ك",1,0],["فليشكرن الدين ما اوليته","واللّه والقبر الشريف بيثرب",49,"ب",1,0],["فَليَشتَغِل بَعدَ البُلوغِ بِالأَهَم","ثُمَّ الأهمِّ فَاتِحاً لِمَا انبَهَم",50,"م",1,0],["فليشرب ويسكر","من قهوة مولانا",51,"ن",2,0],["فَلْيَشرَبِ الحُزنُ ما أبْقَاهُ في مُقَلِي","وَلْيَأكُلِ الشِّعرُ مِن كَفَّيَّ ما شاءَ",52,"ا",2,0],["فل يشهد العالم جميع انّي جنون الغائبات","والله ماجن يم حدّن قبلي بنات السارقين",53,"ن",1,0],["فليشكروا صنع من أضحى الرئيس لها","جرجيس من للقوم قد حسنا",54,"ن",2,0],["فليشكر الناس ظلال المنى","إن رواق العدل ممدود",55,"د",1,0],["فليشهدِ التاريخُ قبلَ رحيلهِ","أهلَ الوفاءِ عن المحبةِ عبّروا",56,"ر",3,0],["فليشرقِ اليمنُ السعيدُ بخافقي","لأراه مكسواً بثوبِ الفرحة",57,"ه",1,0],["فليشهد الدهرُ أنا لا ننامُ على","عهدِ قطعناهُ حتى نسْلِمَ الرّمَقا.",58,"ق",2,0],["فلَيشربَنَّ القلبُ كأسَ بدايةٍ","ولَيسقيَنَّ المنتهَى منْ نخبهِ",59,"ب",2,0],["فليشهد الثّقلان أنّي مجرم","إن مسّه بطش العدا وحقود",60,"د",1,0],["فليشهدوا اليوم والإجلال يخطئهم","غليك ما لصحيح المجدمن ثمن",61,"ن",1,0],["فليشهدِ التاريخُ أن يمينه","وكَفَت ندى وبحزمها كَفَتِ الردا",62,"د",2,0],["فليشكر الكل ذيل الرحمتين على","جدوى مواهبها نعمى أياديها",63,"ي",3,0]]}