{"poems":[[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[48,"أجل سلاح يتقي المرء قرنه","https://www.aldiwan.net/poem22523.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[366,"بالجد والجد حاول ذروة الشرف","https://www.aldiwan.net/poem68088.html","البسيط"],[398,"يا زائرين اجتمعوا جموعا","https://www.aldiwan.net/poem53509.html","الرجز"],[591,"بحقك لا تهجر فهجرك قاتل","https://www.aldiwan.net/poem17506.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70919","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136230","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104412","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52082","الكامل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113864","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74208","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131979","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78266","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95069","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81296","المنسرح"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104903","الكامل"],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""]],"verses":[["وكن زينة السما","ء في عيون الراقب",0,"ب",1,0],["وكنزاً من العِلم الرُّبوبيِّ إنّهُ","هو العلمُ حقّاً لا القِيافةُ والزَّجْر",1,"ر",1,0],["وَكَنزُكَ في الغَبراءِ لا بُدَّ ضائِعٌ","وَلَكِن لَدى الخَضراءِ يُحمى وَيُذخَرُ",2,"ر",1,0],["وكَنْز به من جَنَّةِ الْخُلْدِ دُرّةٌ","تردُّ ثمينَ الدُّرِّ وهي سِخاب",3,"ب",1,0],["وَكَنز مجد اِذا ما ضَلّ ناشِدَه","تَقول همته أَقبِل وَلا تَخف",4,"ف",1,0],["وَكَنز عِلم اللَهِ في الخَلائِقِ","جَعفَرٍ الصادِقِ أَتقى صادِق",5,"ق",1,0],["وَكَنْزُ اصْطِبارِي عِنْدَ فَقْدِكَ نافِذٌ","كما أنَّ سَهْمَ اللَّحْظِ فِي القَلْبِ نافِذُ",6,"ذ",1,0],["وكن زارعا زرعَ التصَبُّرِ واسْقِه","بماء بحورِ العلم كي تحصد الزرعا",7,"ع",2,0],["وكنَزَتُ ما يبقى وعشتُ مسدِّداً","والزادُ ما خبَّأتُ من دعواتهِ",8,"ت",2,0],["وكنزي يقيني وهو في كل حالة","غناي إذا استغنى الجهول بكنزه",9,"ز",2,0],["وَكَنزاً لا تَخافُ عَلَيهِ لِصّاً","خَفيفَ الحَملِ يوجَدُ حَيثُ كُنتا",10,"ت",2,0],["وكنز عن العلم الربوبي إن تشا","يخبرك ظهر الغيب ما أنت صانع",11,"ع",1,0],["وَكَنَزْتَ مِنهَا كُلَّ أدثم أشقَرٍ","وَرَبَطْتَ فِيهَا كُلَّ أقدَحَ أدهَمِ",12,"م",1,0],["وكنز در ثمين في حفاظ فم","لكنه بأفاعي الصدغ مرصود",13,"د",1,0],["وَكنز السخا مِن كَفه الجود وَالرخا","بحب الاخا في اللَه مستجمع الأَمر",14,"ر",1,0],["وكنز من الدر تحت التراب","تنظم عقده ثم انتثر",15,"ر",1,0],["وكنْز حوقلةٍ ارزقنَّا","وانفق لنا واخلفْ لننفقنّا",16,"ن",2,0],["وَكَنز مَبسضمِ الزاهى وَلُؤلُؤهِ","مُرصَد بافاع مِن ذَوائِبُه",17,"ب",2,0],["وكن زاهداً فيها وسلم لخالقٍ","ولا تعتبر حالاً كظلٍّ عبورُها",18,"ر",3,0],["وَكَنزها العَبقري روح قَدَح","أَخي هِزار أَن حركته صَدح",19,"ح",1,0],["وكنزت شعري في الجفون","فخاله الراؤون سحرا",20,"ر",2,0],["وكن زاهدا بالعيش تسمُ برفعة","لعوبٌ هي الدنيا وزهدك سالم",21,"م",1,0],["وَكَنْزُها كَنْزُها الأبْهى عروبَتُها","يَظَلُّ في أحْلَكِ السَّاعاتِ مَأمُولا",22,"ل",2,0]]}