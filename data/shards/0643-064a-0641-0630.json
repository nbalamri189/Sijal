{"poems":[[99,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[102,"لافتة على طريق العيد العاشر لثورة سبتمبر","https://www.poetsgate.com/ViewPoem.aspx?id=50428",""],[303,"مقلة عبرى ودمع يكف","https://www.aldiwan.net/poem36328.html","عموديه"],[367,"لن أعودَ لأبكي","https://www.aldiwan.net/poem11628.html","عموديه"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96642","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58287","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94465","الرمل"],[4764,"يا جروح(ن) ما شكتني","https://www.poetsgate.com/ViewPoem.aspx?id=32994",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""]],"verses":[["كيف ذاك الحب أمسى خبراً","وحديثاً من أحاديث الجوى",0,"ج",3,0],["كيف ذقنا وجع الميلاد كم","ضحك المهد لنا أو كم بكينا",1,"ن",2,0],["كيف ذرَّتْ في فؤادي حبَّها","ثم صدَّتْ فهيَ بي لا ترأَف",2,"ف",1,0],["كيف ذا يا حبيبي تَستَبيحُ عذابي","وَتعودُ بهذا الحنانْ؟",3,"ن",1,1],["كَيفَ ذاكَ النوء وَالعرصة بَل","كَيفَ ذاكَ المُصطلا وَالمُنتَضَد",4,"د",1,0],["كيف ذُقتَ الخشوعَ هلْ هُوَ حلوٌ","يا حريفي باللهِ أم حرّيفُ",5,"ف",1,0],["كيف ذا والشمس في الفرق بدت","في دُجى الجعدِ الَّذي عنهُ سُدِل",6,"ل",1,0],["كيف ذي الارواح تنزف / تكسر اقلام الكتابه","والكآبة شي لازم بعد ما هي حوطتني",7,"ن",2,0],["كَيْفَ ذاكَ النُّؤْيُ وَالعَرْصَةُ بَلْ","كَيْفَ ذاكَ المُصْطَلَى وَالمُنْتَضَدْ",8,"د",1,0],["كَيفَ ذَاكَ اللّيْثُ قدْ أَضْحَى سَرَاباً","قَدْ تَوَارَى بَعدَمَا كَانَ الْيَقِينَا",9,"ن",2,0],["كيف ذا ؟ وأنا ضليع ٍ في مداهيل الغزل","أسمع إن الذيب تالي وقتنا صاده غزال",10,"ل",1,0]]}