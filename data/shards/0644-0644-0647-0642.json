e/diwan/poem/131040",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133310","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133292","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130556","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102928","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69961","البسيط"],[3953,"","https://poetry.dctabudhabi.ae/diwan/poem/110730","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127154","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102752","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45042","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83403","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117262","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117261","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58117","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35431","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139737",""],[5005,"تبسمٌ على شفاه الألم","https://www.poetsgate.com/ViewPoem.aspx?id=197387",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5741,"إني كتبت ختمةً","https://www.poetsgate.com/ViewPoem.aspx?id=187452",""],[5956,"ضربتْ سكوني يا إلهُ شجونُها","https://www.poetsgate.com/ViewPoem.aspx?id=192384",""],[6089,"إني أقمتُ جدارَ نسيانٍ على حبي","https://www.poetsgate.com/ViewPoem.aspx?id=214556",""],[6110,"في كاظمة أو ذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=141177",""],[2220,"هنيتُ بالشهرِ بلْ هني بيَ الشهرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11379&r=&rc=253",""]],"verses":[["لِلَّهِ قَوْمي فَكَمْ ندىً خَضِلٍ","فَيهِمْ وَكَمْ مَحْتِدٍ لَهُمْ سَنِمِ",0,"م",1,1],["لِلَّهِ قَوْمُكَ وَالرِّمَاحُ شَوَاجِرٌ","وَالْبِيضُ تَلْتَهِمُ الطّلَى وَالْهَامَا",1,"م",2,0],["لِلَّهِ قَوْمُكَ عِنْدَ مُشْتَجَرِ الْقَنَا","إِذْ ثَوَّبَ الدَّاعِي الْمُهِيبُ وَأَقْبَلُوا",2,"ل",3,0],["لِلَّهِ قَوْمُكَ آلُ نَصْرٍ وَالْقَنَا","قِصَدٌ وَأَجْسَامُ العِدَى أَشْلاَءُ",3,"ا",2,0],["لِلَّهِ قاضي دَينَدوزَ فَإِنَّهُ","قاضٍ إِذا أَسدى أَطالَ وَأَعرَضا",4,"ض",2,1],["للهِ قَبْرٌ أَوَتْ إِلَيْهِ","وَفَارَقَتْ أَوْجَهَا السَّنِيَّا",5,"ي",2,0],["لِلَّهِ قَلبُكَ ما يَخافُ مِنَ الرَدى","وَيَخافُ أَن يَدنو إِلَيكَ العارُ",6,"ر",1,0],["لِلَّهِ قَلبٌ رَثَّت عَلائِقُهُ","بِهِ وَأَثوابُ حُزنِهِ جُدَدُ",7,"د",1,0],["لِلَّهِ قاهِرَةُ المُعِزِّ فَإِنَّها","بَلَدٌ تَخَصَّصَ بِالمَسَرَّةِ وَالهَنا",8,"ن",2,1],["لِلَّهِ قَومي الأُلى صانوا مَنازِلَهُم","عَنِ الخُطوبِ كَما أَفنَوا مُنازِلَهُم",9,"م",1,0],["للهِ قطّانٌ سبا لينا","وقالَ إذْ أبصرَنا نبكي",10,"ي",1,1],["لله قولي لعبد اللهِ والده","قولاً أتى وفق علياه على قدرِ",11,"ر",1,0],["لِلَّهِ قَلبِيَ ماذا قَد أُتيحَ لَهُ","حَرُّ الصَبابَةِ وَالأَوجاعُ وَالوَصَبُ",12,"ب",1,0],["للّهِ قَومُكَ يا ابنَ زيدٍ إنّهم","سمعوا الكِتابَ فشايعوكَ وأسلموا",13,"م",3,0],["لِلّه قَلبك في الكُهولة إِنَّهُ","تَرك الشَبيبة في حَياءٍ تطرقُ",14,"ق",1,0],["لِلّهِ قَلب","أَغواه حُبٌّ",15,"ب",1,0],["لِلَّه قَومي مَتى يَستَنكِفونَ وَقَد","ذاقوا من الخسف أشكالاً وألوانا",16,"ن",2,0],["للهِ قَوْمٌ بِالثَّبَاتِ تَدَرَّعُوا","وَبِكُلِّ جَامِعَةِ الشَّتَاتِ تَذرَّعُوا",17,"ع",3,1],["للهِ قلبُك! إنهُ","بالحبِّ والإِسلامِ عامر",18,"ر",1,0],["لله قومك والرماح شواجر","والبيض تلتهم الصلى والهاما",19,"م",2,0],["لله قومُك آل نصرٍ والقنا","قِصَرٌ وأجسامُ العِدا أشلاءُ",20,"ا",2,0],["للّه قومي كيف عكر صفوهم","طيش الشيوخ وخفة الشبان",21,"ن",1,0],["للّه قعوار خمار عريكته","صيغت من اللطف والايناس واللين",22,"ن",1,0],["لِلَّهِ قَلبٌ له مُبيَضُّ كُلِّ رَجاً","قَد أودَعَ اللهُ في سَودَائِهِ حِكمَه",23,"م",2,0],["لِلَهِ قَبرٌ ضُمِّنَت","فيهِ عِظامُ اِبنِ الطَويلِ",24,"ل",1,0],["لله قومٌ يُبيحون القِرَى كرما","وينهرون ضيوفَ الأعينِ النُّجُلِ",25,"ل",1,0],["لِلَّهِ قَدرُكَ ما أَجَلَّ وَأَشرَفا","وَمَضاءُ عَزمِكَ أَيَّ حادِثَةٍ كَفا",26,"ف",2,1],["لِلَّهِ قَولٌ فيكَ لَم أَكسِب بِهِ","إِثماً وَظَنٌّ لَم يَكُن تَرجيما",27,"م",2,0],["لله قلبي ما اقوى تجلده","يلقى الحوادث طلقا وهو مكتئبُ",28,"ب",1,0],["لِلّهِ قَومٌ مِن ذُؤابَةِ جَعفَرٍ","لَم يُغمِضوا جَفناً عَلى الأَقذاءِ",29,"ا",2,0],["لِلَّهِ قَلبٌ فيكُمُ أضلَلتُهُ","سَفَهاً وَظَنّي أَنَّهُ مُستَودَعُ",30,"ع",1,0],["لِلَّهِ قَلْعَةُ بِيرانٍ وَعِزَّتهَا","عَلَى الأَعَاصِيرِ فِي ماضِي الأَعَاصِيرِ",31,"ر",1,1],["لله قومٌ حموني","من حادثاتِ الليالي",32,"ي",1,1],["للّه قانونٌ أقامَ سياسةً","شَرعيّةً مرصوصة البنيانِ",33,"ن",1,0],["لِلّه قدك رقة وتأوداً","كالخيزرانة أو كغصن البان",34,"ن",1,0],["لِلَّهِ قَولي أَبا الحُسَينِ فَما","أَقرَب قَولي بِالصِّدقِ من أَمَلي",35,"ل",2,0],["للَهِ قبرُك ما حوى","وله سَريرُكَ ما أسَر",36,"ر",1,0],["للَه قلبٌ تُقلِّبْهُ عواملُهُ","فراح معمولَ أفراحٍ وأحزانِ",37,"ن",1,1],["للَه قَيلٌ في الملوك سَميدعٌ","أضحى بكم ثغرُ العدوِّ دَكادكا",38,"ك",2,0],["لله قلب يد البلوى تقلّبهُ","والعاذلون لديه في الهوى شيع",39,"ع",1,0],["لله قلبَا قرينَيْ صبوةٍ قطعَا","ليلَ الرضا سهراً أحلى من الوسنِ",40,"ن",1,1],["لله قلبٌ حَسَنٌ صبُره","ما سُئل الذِّلّة إلا أبَى",41,"ا",1,0],["لّلهِ قلبي كم يَلِجُّ به الهوى","فيبيتُ يُنجِدُ وجدُه ويُغَوِّرُ",42,"ر",1,0],["للّه قوله مذ كنا على ثقة","فلنعلن الحق وليصدع به الحادي",43,"د",2,0],["للّهِ قومٌ في حبائِلِ حُسنِهم","قنصوا الكَرى لجفونِهم من عِندنا",44,"ن",2,0],["للّهِ قومٌ بأكنافِ الحِمى نزَلوا","همُ الأحبّةُ إن صدّوا وإن وصَلوا",45,"ل",3,1],["للَّه قَومٌ رأيتُ قبلك فو","ق العرش من هذه البِنا جُثُما",46,"م",2,0],["للَّه قلبُ عميدٍ خرّ منجدلاً","لمّا رأته لحاظُ الأعينِ النُّجُلِ",47,"ل",1,0],["للَّه قلبٌ ما اِطمأنّ به الهوى","إِلّا تلوُّمَ مُزمِعٍ متحمِّلِ",48,"ل",1,0],["لِلَه قلب بهم ما انفك متبعا","إثر الركائب إن حلوا وإن رحلوا",49,"ل",3,0],["للهِ قبرٌ حاز با","طنُه الجمالَ وظاهرُه",50,"ر",2,0],["لله قافِيةٌ أَهْدَيْتَها كلفاً","بودِّ ذي كَلَفٍ ما بَعْدَهُ كَلَف",51,"ف",1,0],["لِلَّهِ قَومٌ عُرِفوا بِالنُّبلِ","وَعَرفوا لِلعِلمِ قَدر الفَضلِ",52,"ل",1,0],["لِلّه قُبة إِيمان تشيدها","مِن قُبة كإياة الشمس بَيضاء",53,"ا",2,1],["لله قلبي لقد أضحى غداة غدت","حمولهم للجوى حلفاً وللكمد",54,"د",1,0],["لله قوموا قانتين فيها","نار المعاصي نورها يطفيها",55,"ه",2,0],["لله قوم أنقذوني بعدما","قد كنت من نار الشقا على شفا",56,"ف",2,0],["لله قوم سروا في ليل وجهتهم","ليشهدوا حسن من اضحوا من انصاره",57,"ر",2,0],["لله قلب قد تلقى في الهوى","حكما بها الأمثال مني تضرب",58,"ب",1,0],["لله قلب من هوى احبابه","ووداده لهمو وحبهمو احتشى",59,"ش",2,0],["لله قوم على التقوى بنوا رتبا","عليا ولكنهم يا صاحبي درجوا",60,"ج",3,0],["لله قصر شامخ","مدّ النواظر عنهُ قاصر",61,"ر",1,0],["للهِ قلبي ما أغرى الغرامَ به","وحسنُ صبريَ لولا أنه غُلِبا",62,"ب",2,0],["للَه قلب محبه كلف","ومدمع من جفائه يكف",63,"ف",1,1],["لله قصائد فقت بها الدر","المختارَ المنتظما",64,"م",2,0],["لله قلبُك وهو أغضبُ للهدى","ما كان أصبرَه لهتك الدين",65,"ن",1,0],["للهِ قد اصبحتُ عبداً للشرا","وانا الذي تخشاُ آسادُ الشرا",66,"ر",2,0],["للَه قومٌ كالرياض بشاشةً","غر الوجوه أكارمٌ أخيار",67,"ر",1,1],["لله قلبي ما أشدّ خفوقه","عند اهتزاز قوامها المياسِ",68,"س",1,0],["لله قلبي والحسان ينشنه","بخصورهن قنا الملاح خصور",69,"ر",1,0],["للهِ قومٌ أقامُوا الوجدَ إِذْ رحلوا","بمهجتى وهي تَسْعَى إثْرَ عِيِسهِمِ",70,"م",1,0],["لله قبرك أيّ برّ حلّه","وثوى به من عفّة وتزهّد",71,"د",1,0],["لله قومٌ لهم في كلِّ حادثةٍ","شانٌ وصورتهم من لا له شانُ",72,"ن",1,1],["لله قومٌ بتركِ الاقتداء شقوا","وآخرون بترك الاقتدا سعدوا",73,"د",3,0],["لله قاموا غيرة لم يقصدوا","ردّاً عليه لما رأوه فاوّلوا",74,"ل",3,0],["لله قومٌ بقعر البحرِ منزلُهم","فمن يراهم يقول الشخصُ مكبوتُ",75,"ت",1,1],["لله قومٌ لهم فطنةٌ","تراهم كالحمر الوحشي",76,"ش",2,0],["لله قومٌ لما ذكرنا","تحققوا فيه هم رجاله",77,"ل",2,0],["لله قومٌ لهم علمٌ ومعرفةٌ","وهم عليه إذا يدعوهمُ لبد",78,"د",1,0],["لله قومِ غزاةٌ ما لهم عددٌ","وإن أسماءَه الحسنى هي العدد",78,"د",1,0],["لله قومٌ إذا ما أصلحوا فسدوا","وثم قوم إذا ما أفسدوا صلحوا",79,"ح",3,0],["لله قومٌ تراهم","بحالِ ذُلٍّ ونكس",80,"س",1,0],["لله قومٌ ذوو أعلم مقامهمُ","الشمسُ والتينُ والأحقاقُ والفجرُ",81,"ر",1,0],["للّه قد وجب الدَّوَامْ","وسِوَاه نهبٌ لِلْحِمَامْ",82,"م",1,1],["لله قَلبٌ شَامَ هَاتِيكَ البُرُو","قَ مِنَ الخِيَامِ فَهَمَّ بِالطَّيرَانِ",83,"ن",1,0],["للّه قوم بدت اشبالهم درراً","بين الورى وبوجه الدهر كالغرر",84,"ر",1,0],["لِلّه قومك ما اَصفى قُلوبهم","كَأَنَّها خُلقت مِن خالص الذهب",85,"ب",1,0],["لله قَوْمٌ إِذا حلّوا بمَنزلةٍ","حَلَّ النَّدى ويسير الجودُ إِن ساروا",86,"ر",3,0],["للَه قبة أنوار سمت وزهت","كزخرف مفرغ في جو منسبك",87,"ك",1,1],["لِلَّهِ قَد أَخلَصَت العِباد","تَفطّرت لِأَجل ذا الأَكبادُ",88,"د",1,0],["للَه قاضي قنا","أمسى وأصبح واعظا",89,"ظ",2,1],["لِلّه قلبي كم يحمل","في الغرام من العظائم",90,"م",1,0],["لِلّه قومي عند مشتَجرِ القنا","إذ ثوَّبَ الداعي المهيبُ وأَقبلُوا",91,"ل",3,1],["لِلّه قلبكِ إذ قلبي يطارحهُ","وجدي فيخفق ولهاناً لولهانِ",92,"ن",1,0],["لله قومٍ رفعتُ ذكرُهمُ","مدحا وهُم يُخفضونني ذمّا",93,"م",2,1],["لله قد نجحت سريرة قصده","إن السرائر بعضها الهام",94,"م",1,0],["لِلَّهِ قد أَخلَصوا في كُلِّ ما عملوا","إذ لم يَكُن لهم في غيره قصدُ",95,"د",1,0],["لِلَّه قَوماً في العلى غررا","ظَلمتهم الأَحكام فاِنظَلَموا",96,"م",3,0],["لِلَّهِ قَومٌ أَدرَكوا","سِرَّ الحَياة وَما يجب",97,"ب",1,0],["للَه قارعة دهت ركن الهدى","سقت النفوس شجىً كؤوس حمام",98,"م",1,0],["للهِ قلبي ما يَجِنْ","نُ من الهمومِ وما يُوَاري",99,"ر",2,0],["لله قلبك ما لقيت","من الأذى من كل ناصب",100,"ب",1,0],["لِلّه قلبي فكم خطب تحمله","به الليالي وكم صعب تجشمه",101,"م",2,0],["لِلّه قَوم لَم يَزَل مِن دَأبِهُم","خَوض البِحار وَكُل برّ مقفر",102,"ر",1,0],["لِلّه قَلبٌ مِن فراقك ذائبُ","أَبَدا وَطَرفٌ بِالمَدامع ساكبُ",103,"ب",1,1],["لِلّه قَلبٌ وَجسم ذا بِهِمْ كَلِفٌ","شَتّى الهُمومِ وَذا أَضحى لَهُم حَرَضا",104,"ض",2,0],["لِلّه قَومٌ بِالخَنا بلغوا المُنى","وَعلوا عَلى هامِ العلا بِالأَخمص",105,"ص",1,0],["للّه قامتها الهيفاء أن خطرت","تكاد تذهب روحي من تهاديها",106,"ي",3,0],["لله قائد جيش حين تنسبه","تراه ينتمي إلى خير الألى عدلوا",107,"ل",3,0],["لله قوم شربنا