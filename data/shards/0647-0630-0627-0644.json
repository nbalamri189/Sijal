ر كعام","https://www.poetsgate.com/ViewPoem.aspx?id=156514",""],[5205,"ملك محاسنه جنوده","https://www.poetsgate.com/ViewPoem.aspx?id=121000",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5282,"سيرةٌ شعرية","https://www.poetsgate.com/ViewPoem.aspx?id=214654",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5442,"العيد عيد مهنأ بقبوله","https://www.poetsgate.com/ViewPoem.aspx?id=114786",""],[5574,"مشاهداتٌ من روضةِ الباري","https://www.poetsgate.com/ViewPoem.aspx?id=206021",""],[5574,"تائية أبي ريما","https://www.poetsgate.com/ViewPoem.aspx?id=206045",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5691,"أطواق منضدة","https://www.poetsgate.com/ViewPoem.aspx?id=206439",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5899,"تقمص","https://www.poetsgate.com/ViewPoem.aspx?id=31951",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""]],"verses":[["هَذا لِواؤُكَ خَفّاقٌ يُظَلِّلُنا","وَذاكَ شَخصُكَ في الأَكبادِ مُرتَسِمُ",0,"م",1,0],["هَذا لَهُ تَجري الدِماءُ وَذا لَهُ","تَجري القَرائِحُ بِالمَديحِ وَتُعنِقُ",1,"ق",1,0],["هذا لعمر اللّه جهل تضحك ال","عقلاء منه وتهزأ الأحرار",2,"ر",1,0],["هذا لعمر اللَّه جور عدّه","من فرط ضلّتها اولو ألبابها",3,"ب",3,0],["هذا لعمر أبيك ما","يدعو الحليم إلى انتحابه",4,"ب",2,0],["هذا لعمر اللّه يأبى مثله","مَن عاش ذا شرفٍ وكان مُهَذَّبا",5,"ب",2,0],["هذا لموطنه وذاك لربّه","وقفا أجلّ مواقف الأبرار",6,"ر",1,0],["هذا للحلمِ معنًى في خلائقهِ","لا تستطيلُ إليه سَورَة الغضب",7,"ب",1,0],["هذا له سبب فيما يحاوِله","وذا لهُ من مقالِ الشعر أسباب",8,"ب",1,0],["هذا له إكرامُه ومقامُه","ولذاك عاجلُ رفدِه وسراحُه",9,"ح",2,0],["هذا لِذاك وهذا بعْدهُ قَسَمٌ","بِمَشْهَدٍ من جَلال اللّه مشْهودِ",10,"د",1,0],["هذا لعمرك سُؤدد","لكنه أيضاً مؤكَّدْ",11,"د",1,0],["هذا لذاك ورُبَّ قافيةٍ","قد قلتُها كالطعنة الخلس",12,"س",1,0],["هذا لعمري عجبٌ عاجبٌ","يا من قفاه منظر مَسمَعُ",13,"ع",1,0],["هذا لذاك وإنْ أجاد مُجيدُنا","فلما فعلْتَ عن المقال تمهُّلُ",14,"ل",1,0],["هذا لذاك وإن لم نوف سيدنا","حقَّ الثناء وكان الحقُّ ذا ثمَن",15,"ن",1,0],["هذا لذاكَ أبا الحسين وبعدَه","إجراءُ مدحِك شأوَه المُتباطِنا",16,"ن",2,0],["هَذا لِيَعلَمَ أَنّي","في غَيبِهِ لَم أَخُنهُ",17,"ن",2,0],["هذا لعمري ما يرى","عقلي بوجه مجمل",18,"ل",1,0],["هذا له من نشاط ما يقدمه","وذا يؤخره عن غايه الكسل",19,"ل",1,0],["هذا لعمري في البطولة فوق ما","في الحرب يفعله الكمي المعلم",20,"م",1,0],["هذا لعمري إن يص","ح فانه لمن العجائب",21,"ب",1,0],["هذا لعمري ما سمعت وانه","للناس فيه مصائب ودواهي",22,"ي",1,0],["هذا لكم وجه الندى والهدى","فاستقبلوه خير مستقبل",23,"ل",1,0],["هَذا لَهُم بَيتٌ عَلى بَيتِهِم","ما أَشبَهَ المَسجِدَ بِالمَسجِدِ",24,"د",1,0],["هذا ليمتنعَ الكمالُ ويعلمَ ال","جُهَّالُ أَنَّ اللّهَ فَرْدٌ قادِرُ",25,"ر",1,0],["هَذا لِذا وَالفَتحُ مِفتاحُ النَدى","وَزَهرَةُ الدُنيا وَيَنبوعُ الأَدَب",26,"ب",1,0],["هَذا لِذَنبٍ فَلَن أَعودَ لَهُ","ما أَعقَبَت ريحَ شَمأَلٍ نُكُبُ",27,"ب",1,0],["هَذا لَعَمري وَالحُرُّ لا يَرتَضي ال","هونَ وَإِن قَلَّ عِندَهُ النَشَبُ",27,"ب",1,0],["هَذا لِهَذا وَالدَهرُ لِلغِنى سَبَبٌ","وَالمَرءُ في نَفسِهِ لَهُ عِلَلُ",28,"ل",1,0],["هَذا لِهَذا وَاِبنُ هِندٍ مَحجَرٌ","مُذَبذَبٌ مُطَّرِدٌ مُؤَخَّرُ",29,"ر",1,0],["هَذا لَكُم مِنَ الغُلامِ الغالِبي","مِن ضَربِ صِدقٍ وَقَضاءِ الوَاجِبِ",30,"ب",1,1],["هَذا لَعَمري يا أَبا جَعفَرٍ","جَزاءُ مَن رَبّى بَني الناسِ",31,"س",1,0],["هذا لساني يدَّعي لومَكُمْ","وليس في قلبي عليكُمْ ملامْ",32,"م",1,0],["هَذا لَنا وَلَهُم فيما مَضى مَثَلٌ","وَإِنَّما يَضرِبُ الأَمثالَ واعيها",33,"ي",3,0],["هَذا لعَمُركُمُ العُقوقُ بِعينهِ","أَكَذا تُخلّى الأُمُّ في بَلوائِها",34,"ا",3,0],["هَذا لِهَذا فَما لِذي إِحَنٍ","يَدُسُّ لي كَيدَهُ وَيَختَتِلُ",35,"ل",1,0],["هذا لعمري اسمهُ كامِلا","في كُلّ بيتٍ منهُ حرفٌ مَكين",36,"ن",1,0],["هَذا لِذاكَ كَما هَذا وَذاكَ لِذا","فَالشَملُ مُنتَظِمٌ وَالحَبلُ مُتَّصِلُ",37,"ل",1,0],["هَذا لِيُمنِكَ وَالإِنسانُ مُفتَخِرٌ","وَالفَخرُ فيهِ وَفي أَيّامِهِ كَبَدُ",38,"د",1,0],["هَذا لعمري ما أَرا","ه في القَريض ولا أَحيد",39,"د",1,0],["هذا لِتَعْلَمَ أني ما نَهَضْتُ إلى","قَضَاء حَجٍّ فأغْفَلْتُ المَواقيتا",40,"ت",2,0],["هذا لسان القوم يا بنيّا","على أساس ثابت مبنيا",41,"ي",2,0],["هَذا لَعَمْرُ أَبِيكَ داعِيَةُ الرِّضَا","وَسَلامَةُ العُقْبَى وَمِفْتَاحُ الْغِنَى",42,"ا",1,0],["هَذَا لِقَاءٌ يُوغتُوا","فِيهِ بِنَارٍ تَحْتَدِمْ",43,"م",1,0],["هَذا لكمْ شُكْرِي بِشِعْرٍ خَالِصٍ","لاَ شَيءَ فِيه مُصَرَّع وَمُرَصَّعُ",44,"ع",1,0],["هذا لأبرأمن قول قذفت به","طارت نوافذه حراًعلى كبدى",45,"د",2,0],["هَذا لِهَذا ، والدَّهْرُ ذُو عِلَلٍ","والمرْءُ في نَفْسِهِ لَهُ عِلَلُ",46,"ل",1,0],["هذا لأن لذي الأمامة رتبة","في البر فالأولى به تقرير بر",47,"ر",1,0],["هذا له قَدٌّ رشيق مُذْهَبٌ","قد أذهبت عقل الورى حركاتُه",48,"ت",2,0],["هذا له طرفٌ غضيضٌ أَحْوَرٌ","يَفْرِى النُّهَى مبهورةً شفراتُه",48,"ت",2,0],["هَذا لأَنَّ عَذابي صارَ يَعْذُبُ لِي","فيها وَأَنَّ حَيَاتي مِنْ أَيادِيها",49,"ي",3,0],["هَذا لَعَمْرُكَ مَاعُونٌ بَخِلْتَ بِهِ","عَلى العُيُونِ وَبِئْسَ الخِلَّةُ البخَلُ",50,"ل",1,0],["هَذا لَعَمري أَطاعَ الكاشِحينَ وَلَم","يَعطِف وَأَصغى إِلى الواشينَ إِذعانا",51,"ن",2,0],["هذا لذاكَ هوى وذاكَ بذا","صبٌ كحاسي الخمرِ والخمرِ",52,"ر",1,0],["هذا لإقبال الأمير وحظه","لينال منه سقط ما قد نالا",53,"ل",2,0],["هذا له الاشجار حين دعا اتت","تسعى على ساق بغير تمادي",54,"د",2,0],["هذا لحق مثلما","أن الخلائق ينطقون",55,"ن",1,0],["هذا لعمر آلهك الفضل الذي لا","ريب فيه والثناء الأقسط",56,"ط",1,0],["هذا له وحده فقل لي","من أنت في الناس يا وضيع",57,"ع",1,0],["هذا لسانُ الحالِ منهُ قائلٌ","كن ليِّناً مثلي وإلا تُقصَف",58,"ف",1,0],["هذا لعمري لسخطُ الله أو غضبٌ","من النبي على ساهينَ لاهينا",59,"ن",2,0],["هذا لعمركِ ما يُذيبُ حشاشتي","تبكي نعيماً تحتَ ظلّ مقيل",60,"ل",1,0],["هَذا لَنا مِنهُم وَنَتبَعُ عيسَهُم","إِن أَيمَنوا أَو أَنجَدوا أَو أَتهَموا",61,"م",3,0],["هَذا لِمَن أَحبّا","وَإِن يَشا فغِبّا",62,"ب",2,0],["هذا لعمري منتهى السعاده","سبحان ربي من رجاه ما خاب",63,"ب",1,0],["هَذا لِأَنَّ شَريفَ النَفسِ أَكرَمَها","مَن لَيسَ يَحتاجُ تِبياناً وَتَوصيفا",64,"ف",2,0],["هذا لِهذا فَما بالُ الَّتي وَعَدَت","وَكانَ مِن وَعدِها اللَيّانُ وَالخُلُفُ",65,"ف",1,0],["هذا له رأس","وذا له ذنب",66,"ب",1,0],["هَذا لَعَمرِكُمُ الصَغارُ بِعَينِهِ","لا أُمَّ لي إِن كانَ ذاكَ وَلا أَبُ",67,"ب",1,0],["هَذا لعمركَ ما الدُنيا تزان بِهِ","وَهَل سِوى مَن أَضَلّ اللَه يُنكرهُ",68,"ر",2,0],["هذا لِساني قَصير عَن مَديحُكُم","لا أَستَطيع اِلَيهِ ان أَمدّ يَدا",69,"د",2,0],["هذا لعمري منتهى السعاده","طلبت ذا الفضل العظيم",70,"م",1,0],["هذا لمن يعصى الرب الكريم الجليل","تراه مشغول عن دينه بقال وقيل",71,"ل",1,0],["هذا لسان الطُرسِ مسترسِلٌ","يخبِرُنا عمّا أحنّ الفؤادْ",72,"د",1,0],["هذا لهم والقومُ لا قومي هُمُ","جنسا وعُقْرُ ديارهم لا داريا",73,"ي",2,0],["هذا لحرِّ فارسٍ نسبتُهُ","وتلك من عِلج النصارَى الجِبْسِ",74,"س",1,0],["هذا لذاك هلالُ أفق سمائه","حقاً وذاك لذا صبيحةُ عيده",75,"د",2,0],["هذا لساني وقد أحللت عقدته","يا أفصح الناس نطقا في بني الضاد",76,"د",1,0],["هذا لعمري محض انسانية","وجبت فلا عذر ولا تخيير",77,"ر",1,0],["هذا لركبته هذا لرهبته","هذا لرغبته هذا إذا طربا",78,"ب",2,0],["هذا لسلطان اقتدارك راكعٌ","خوفاً وهذا للسكينةِ ساجدُ",79,"د",1,0],["هذا لعمرك أمرٌ شأنه عجبٌ","أردت ابراز موجودٍ بمفقود",80,"د",1,0],["هذا لعمرُ الحقِّ وصفُ مَن هُدِى","وواجِبٌ بِفعلهِ أن نقتَدِي",81,"د",2,0],["هَذَ الصَّبُوحُ فَمَا الَّذِي","بِصَبُوحِ صُبْحِكَ تَنْتَظِرْ",82,"ر",1,1],["هذا له على الحديث جائز","إذا هم في حربهم تحاجزوا",83,"ز",3,0],["هذا لعمري أعجب العجائب","أن يطلب المطلوب حق الطالب",83,"ب",1,0],["هَذا لَنا بَدرٌ أتَمُّ وَذا لَنا","جَبَلٌ أشَمُّ وَذاكَ بَحرٌ خِضرَمُ",84,"م",1,0],["هذا ليعلم أن الحق كان كما","قد صار يبدو بحكم غير منخرم",85,"م",1,0],["هذا له قُربةٌ منّي ومنزلةٌ","كانت لهارونَ من موسى بن عمرانا",86,"ن",2,0],["هذا لنا شيعةٌ وشيعَتُنا","أعطانَي اللهُ فيهمُ الأمَلا",87,"ل",2,0],["هذ