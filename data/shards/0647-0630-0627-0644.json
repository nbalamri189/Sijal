{"poems":[[88,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[88,"سكن الظلام وبات قلبك يخفق","https://www.aldiwan.net/poem68942.html","الكامل"],[90,"قالوا نخلد ذكره بحديقة","https://www.aldiwan.net/poem44396.html","الكامل"],[90,"من جور مصر على العروبة أنها","https://www.aldiwan.net/poem44419.html","الكامل"],[90,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[90,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[74,"عوض بكأسك ما أتلفت من نشب","https://www.aldiwan.net/poem18227.html","البسيط"],[74,"فتحت للناس أبواب المقاصد لا","https://www.aldiwan.net/poem18329.html","البسيط"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[53,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[53,"ما ضر مدحا في جواد","https://www.aldiwan.net/poem61865.html","مجزوء الكامل"],[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[53,"إن كنت صفعانا ولي ضيعة","https://www.aldiwan.net/poem65385.html","السريع"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[53,"ما أشبه العرف والإحسان بالحسنِ","https://www.aldiwan.net/poem66441.html","البسيط"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[72,"لي صاحب غبت عنه","https://www.aldiwan.net/poem42678.html","المجتث"],[91,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[91,"في الغرب حيث كلا الجنسين يشتغل","https://www.aldiwan.net/poem44869.html","الطويل"],[91,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[91,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[91,"الناس طرا آمنوا بالله","https://www.aldiwan.net/poem45096.html","الكامل"],[87,"بات المعنى والدجى يبتلى","https://www.aldiwan.net/poem7887.html","السريع"],[87,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[64,"قد كان حظي في الكتابة ناقصا","https://www.aldiwan.net/poem52389.html","الكامل"],[47,"ما للكبير في الغواني من أرب","https://www.aldiwan.net/poem10669.html","الرجز"],[47,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[47,"أهلك والليل أيها الرجل","https://www.aldiwan.net/poem65644.html","المنسرح"],[60,"أنا علي فاسألوني تخبروا","https://www.aldiwan.net/poem31062.html","الرجز"],[60,"هذا لكم من الغلام الغالبي","https://www.aldiwan.net/poem31158.html","الرجز"],[46,"نكست رأسي بين جلاسي","https://www.aldiwan.net/poem30032.html","الكامل"],[71,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[107,"أم تدافع يأسها برجائها","https://www.aldiwan.net/poem43414.html","الكامل"],[54,"تعاهدتك العهاد يا طلل","https://www.aldiwan.net/poem26766.html","المنسرح"],[77,"اسم الذي عذبني حبه","https://www.aldiwan.net/poem69004.html","السريع"],[50,"بادر صبوحك وانعم أيها الرجل","https://www.aldiwan.net/poem64497.html","البسيط"],[52,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85376","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[7,"يَا دَارَ مَيَّةَ (المعلقات)","https://www.poetsgate.com/ViewPoem.aspx?id=10023",""],[47,"أَهْلك واللَّيلَ أَيَّها الرَّجُلُ","https://www.poetsgate.com/ViewPoem.aspx?id=31816",""],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[132,"صب تحرقه أسى لرعاته","https://www.aldiwan.net/poem50654.html","الكامل"],[159,"هي الحياة التي تحيا النفوس بها","https://www.aldiwan.net/poem55507.html","البسيط"],[159,"يا ذا الذي ورد خديه إذا أخذت","https://www.aldiwan.net/poem55564.html","البسيط"],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[203,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[208,"سنة يزاد بها الأمير جمالا","https://www.aldiwan.net/poem53156.html","الكامل"],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[225,"مولاي قد نامت عيون","https://www.aldiwan.net/poem55273.html","مجزوء الكامل"],[235,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[260,"يا أيها الحاكم الرقيع","https://www.aldiwan.net/poem48333.html","مخلع البسيط"],[274,"لا تطلبن تعطفا من معطف","https://www.aldiwan.net/poem35332.html","الكامل"],[274,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[274,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[286,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[301,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[324,"ما بال نجم العلا قد لاح مؤتلفا","https://www.aldiwan.net/poem67151.html","البسيط"],[326,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[346,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[347,"وإذا تكون كريهة أدعى لها","https://www.aldiwan.net/poem24184.html","الكامل"],[357,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[365,"يا ابن الاماجد لا تخش الردى أبدا","https://www.aldiwan.net/poem68121.html","البسيط"],[395,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[395,"فاز المخفون في اليوم العظيم الطويل","https://www.aldiwan.net/poem54542.html","عموديه"],[436,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[461,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[461,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[467,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[482,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[482,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[498,"علي أن لا أريح العيش والقتبا","https://www.aldiwan.net/poem9763.html","البسيط"],[503,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[503,"لله في الكون عهد قد جرى ومضى","https://www.aldiwan.net/poem37645.html","البسيط"],[541,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[570,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["هَذا لِواؤُكَ خَفّاقٌ يُظَلِّلُنا","وَذاكَ شَخصُكَ في الأَكبادِ مُرتَسِمُ",0,"م",1,0],["هَذا لَهُ تَجري الدِماءُ وَذا لَهُ","تَجري القَرائِحُ بِالمَديحِ وَتُعنِقُ",1,"ق",1,0],["هذا لعمر اللّه جهل تضحك ال","عقلاء منه وتهزأ الأحرار",2,"ر",1,0],["هذا لعمر اللَّه جور عدّه","من فرط ضلّتها اولو ألبابها",3,"ب",3,0],["هذا لعمر أبيك ما","يدعو الحليم إلى انتحابه",4,"ب",2,0],["هذا لعمر اللّه يأبى مثله","مَن عاش ذا شرفٍ وكان مُهَذَّبا",5,"ب",2,0],["هذا لموطنه وذاك لربّه","وقفا أجلّ مواقف الأبرار",6,"ر",1,0],["هذا للحلمِ معنًى في خلائقهِ","لا تستطيلُ إليه سَورَة الغضب",7,"ب",1,0],["هذا له سبب فيما يحاوِله","وذا لهُ من مقالِ الشعر أسباب",8,"ب",1,0],["هذا له إكرامُه ومقامُه","ولذاك عاجلُ رفدِه وسراحُه",9,"ح",2,0],["هذا لِذاك وهذا بعْدهُ قَسَمٌ","بِمَشْهَدٍ من جَلال اللّه مشْهودِ",10,"د",1,0],["هذا لعمرك سُؤدد","لكنه أيضاً مؤكَّدْ",11,"د",1,0],["هذا لذاك ورُبَّ قافيةٍ","قد قلتُها كالطعنة الخلس",12,"س",1,0],["هذا لعمري عجبٌ عاجبٌ","يا من قفاه منظر مَسمَعُ",13,"ع",1,0],["هذا لذاك وإنْ أجاد مُجيدُنا","فلما فعلْتَ عن المقال تمهُّلُ",14,"ل",1,0],["هذا لذاك وإن لم نوف سيدنا","حقَّ الثناء وكان الحقُّ ذا ثمَن",15,"ن",1,0],["هذا لذاكَ أبا الحسين وبعدَه","إجراءُ مدحِك شأوَه المُتباطِنا",16,"ن",2,0],["هَذا لِيَعلَمَ أَنّي","في غَيبِهِ لَم أَخُنهُ",17,"ن",2,0],["هذا لعمري ما يرى","عقلي بوجه مجمل",18,"ل",1,0],["هذا له من نشاط ما يقدمه","وذا يؤخره عن غايه الكسل",19,"ل",1,0],["هذا لعمري في البطولة فوق ما","في الحرب يفعله الكمي المعلم",20,"م",1,0],["هذا لعمري إن يص","ح فانه لمن العجائب",21,"ب",1,0],["هذا لعمري ما سمعت وانه","للناس فيه مصائب ودواهي",22,"ي",1,0],["هذا لكم وجه الندى والهدى","فاستقبلوه خير مستقبل",23,"ل",1,0],["هَذا لَهُم بَيتٌ عَلى بَيتِهِم","ما أَشبَهَ المَسجِدَ بِالمَسجِدِ",24,"د",1,0],["هذا ليمتنعَ الكمالُ ويعلمَ ال","جُهَّالُ أَنَّ اللّهَ فَرْدٌ قادِرُ",25,"ر",1,0],["هَذا لِذا وَالفَتحُ مِفتاحُ النَدى","وَزَهرَةُ الدُنيا وَيَنبوعُ الأَدَب",26,"ب",1,0],["هَذا لِذَنبٍ فَلَن أَعودَ لَهُ","ما أَعقَبَت ريحَ شَمأَلٍ نُكُبُ",27,"ب",1,0],["هَذا لَعَمري وَالحُرُّ لا يَرتَضي ال","هونَ وَإِن قَلَّ عِندَهُ النَشَبُ",27,"ب",1,0],["هَذا لِهَذا وَالدَهرُ لِلغِنى سَبَبٌ","وَالمَرءُ في نَفسِهِ لَهُ عِلَلُ",28,"ل",1,0],["هَذا لِهَذا وَاِبنُ هِندٍ مَحجَرٌ","مُذَبذَبٌ مُطَّرِدٌ مُؤَخَّرُ",29,"ر",1,0],["هَذا لَكُم مِنَ الغُلامِ الغالِبي","مِن ضَربِ صِدقٍ وَقَضاءِ الوَاجِبِ",30,"ب",1,1],["هَذا لَعَمري يا أَبا جَعفَرٍ","جَزاءُ مَن رَبّى بَني الناسِ",31,"س",1,0],["هذا لساني يدَّعي لومَكُمْ","وليس في قلبي عليكُمْ ملامْ",32,"م",1,0],["هَذا لَنا وَلَهُم فيما مَضى مَثَلٌ","وَإِنَّما يَضرِبُ الأَمثالَ واعيها",33,"ي",3,0],["هَذا لعَمُركُمُ العُقوقُ بِعينهِ","أَكَذا تُخلّى الأُمُّ في بَلوائِها",34,"ا",3,0],["هَذا لِهَذا فَما لِذي إِحَنٍ","يَدُسُّ لي كَيدَهُ وَيَختَتِلُ",35,"ل",1,0],["هذا لعمري اسمهُ كامِلا","في كُلّ بيتٍ منهُ حرفٌ مَكين",36,"ن",1,0],["هَذا لِذاكَ كَما هَذا وَذاكَ لِذا","فَالشَملُ مُنتَظِمٌ وَالحَبلُ مُتَّصِلُ",37,"ل",1,0],["هَذا لِيُمنِكَ وَالإِنسانُ مُفتَخِرٌ","وَالفَخرُ فيهِ وَفي أَيّامِهِ كَبَدُ",38,"د",1,0],["هَذا لعمري ما أَرا","ه في القَريض ولا أَحيد",39,"د",1,0],["هذا لِتَعْلَمَ أني ما نَهَضْتُ إلى","قَضَاء حَجٍّ فأغْفَلْتُ المَواقيتا",40,"ت",2,0],["هذا لسان القوم يا بنيّا","على أساس ثابت مبنيا",41,"ي",2,0],["هَذا لَعَمْرُ أَبِيكَ داعِيَةُ الرِّضَا","وَسَلامَةُ العُقْبَى وَمِفْتَاحُ الْغِنَى",42,"ا",1,0],["هَذَا لِقَاءٌ يُوغتُوا","فِيهِ بِنَارٍ تَحْتَدِمْ",43,"م",1,0],["هَذا لكمْ شُكْرِي بِشِعْرٍ خَالِصٍ","لاَ شَيءَ فِيه مُصَرَّع وَمُرَصَّعُ",44,"ع",1,0],["هذا لأبرأمن قول قذفت به","طارت نوافذه حراًعلى كبدى",45,"د",2,0],["هَذا لِهَذا ، والدَّهْرُ ذُو عِلَلٍ","والمرْءُ في نَفْسِهِ لَهُ عِلَلُ",46,"ل",1,0],["هذا لأن لذي الأمامة رتبة","في البر فالأولى به تقرير بر",47,"ر",1,0],["هذا له قَدٌّ رشيق مُذْهَبٌ","قد أذهبت عقل الورى حركاتُه",48,"ت",2,0],["هذا له طرفٌ غضيضٌ أَحْوَرٌ","يَفْرِى النُّهَى مبهورةً شفراتُه",48,"ت",2,0],["هَذا لأَنَّ عَذابي صارَ يَعْذُبُ لِي","فيها وَأَنَّ حَيَاتي مِنْ أَيادِيها",49,"ي",3,0],["هَذا لَعَمْرُكَ مَاعُونٌ بَخِلْتَ بِهِ","عَلى العُيُونِ وَبِئْسَ الخِلَّةُ البخَلُ",50,"ل",1,0],["هَذا لَعَمري أَطاعَ الكاشِحينَ وَلَم","يَعطِف وَأَصغى إِلى الواشينَ إِذعانا",51,"ن",2,0],["هذا لذاكَ هوى وذاكَ بذا","صبٌ كحاسي الخمرِ والخمرِ",52,"ر",1,0],["هذا لإقبال الأمير وحظه","لينال منه سقط ما قد نالا",53,"ل",2,0],["هذا له الاشجار حين دعا اتت","تسعى على ساق بغير تمادي",54,"د",2,0],["هذا لحق مثلما","أن الخلائق ينطقون",55,"ن",1,0],["هذا لعمر آلهك الفضل الذي لا","ريب فيه والثناء الأقسط",56,"ط",1,0],["هذا له وحده فقل لي","من أنت في الناس يا وضيع",57,"ع",1,0],["هذا لسانُ الحالِ منهُ قائلٌ","كن ليِّناً مثلي وإلا تُقصَف",58,"ف",1,0],["هذا لعمري لسخطُ الله أو غضبٌ","من النبي على ساهينَ لاهينا",59,"ن",2,0],["هذا لعمركِ ما يُذيبُ حشاشتي","تبكي نعيماً تحتَ ظلّ مقيل",60,"ل",1,0],["هَذا لَنا مِنهُم وَنَتبَعُ عيسَهُم","إِن أَيمَنوا أَو أَنجَدوا أَو أَتهَموا",61,"م",3,0],["هَذا لِمَن أَحبّا","وَإِن يَشا فغِبّا",62,"ب",2,0],["هذا لعمري منتهى السعاده","سبحان ربي من رجاه ما خاب",63,"ب",1,0],["هَذا لِأَنَّ شَريفَ النَفسِ أَكرَمَها","مَن لَيسَ يَحتاجُ تِبياناً وَتَوصيفا",64,"ف",2,0],["هذا لِهذا فَما بالُ الَّتي وَعَدَت","وَكانَ مِن وَعدِها اللَيّانُ وَالخُلُفُ",65,"ف",1,0],["هذا له رأس","وذا له ذنب",66,"ب",1,0],[