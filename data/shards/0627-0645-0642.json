{"poems":[[53,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[73,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[73,"أسقيط الطل فوق النرجس","https://www.aldiwan.net/poem11953.html","الرمل"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[47,"ما آن أن أرتاع للشيب","https://www.aldiwan.net/poem25263.html","مجزوء الكامل"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[45,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[61,"قل لابن حرب قد جنيت","https://www.aldiwan.net/poem51654.html","مجزوء الكامل"],[61,"أمقدم يا أبا المقدام أنت على","https://www.aldiwan.net/poem51756.html","البسيط"],[97,"لمن الصمت والفؤاد المشرد","https://www.aldiwan.net/poem24603.html","الخفيف"],[80,"فارقتكم وفراقكم صعب","https://www.aldiwan.net/poem31571.html","أحذ الكامل"],[44,"أمقران يا ابن بنات العلوج","https://www.aldiwan.net/poem30034.html","المتقارب"],[44,"أما والذي غشى المبارك خزية","https://www.aldiwan.net/poem30068.html","الطويل"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[102,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[91,"الطين","https://www.poetsgate.com/ViewPoem.aspx?id=53032",""],[128,"مذ مدة ما جاءنا","https://www.aldiwan.net/poem50602.html","مجزوء الكامل"],[129,"يا صاح ما لك لا ترد","https://www.aldiwan.net/poem67453.html","مجزوء الكامل"],[142,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[142,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[143,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[169,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[182,"أمقلدا جيدي بعقد نظامه","https://www.aldiwan.net/poem67020.html","الكامل"],[222,"نبت الأفاح بأرض مرجان","https://www.aldiwan.net/poem55444.html","مجزوء الكامل"],[353,"يا للأماجد هل يقاس لديكم","https://www.aldiwan.net/poem40170.html","الكامل"],[353,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[393,"مولاي لم لم تدع عبدك","https://www.aldiwan.net/poem53431.html","مجزوء الكامل"],[403,"ولقد ذكرتك بعد أن جد النوى","https://www.aldiwan.net/poem33651.html","الكامل"],[575,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"]],"verses":[["أَمَقاصِرَ الغِزلانِ غَيَّرَكِ البِلى","حَتّى غَدَوتِ مَرابِضَ الغِزلانِ",0,"ن",1,0],["أَمُقاماً أَلَذُّ في غَيرِ عَليا","ءَ وَزادي مِن عيشَتي زادُ ضَبِّ",1,"ب",1,0],["أَم قَضيبُ البانِ يَعنيهِ الهَوى","أَم غَزالُ القَفرِ يُصبيهِ الغَزَل",2,"ل",1,0],["أَمَقتولَةَ الأَجفانِ مالَكِ والِهاً","أَلَم تُرِكِ الأَيّامُ نَجماً هَوى قَبلي",3,"ل",2,0],["أَم قَريضٌ جاءَني عَن مَلِكٍ","مالِكٍ بِالبِرِّ رِقَّ الأَنّفُسِ",4,"س",1,0],["أمقدم الفتيان في طلب العلى","ساء العلى إن كنت أول عاثر",5,"ر",1,0],["أَم قَد أَمِنتُ الحادِثا","تِ مِنَ الغَوادي وَالسَواري",6,"ر",2,0],["أَم قَوِيٌّ إِذَن مُرِ النَومَ إِذ يَغ","شاك وَاللَيلُ عَن جُفونِكَ يَرتَد",7,"د",1,0],["امقت من قومي ومن خيمهم","تعصب الاغرار والحمس",8,"س",1,0],["أَمُقِلٌّ مِن غُزرِهِ كُلُّ غَيثٍ","أَم مُخِلٌّ بِفَيضِهِ كُلُّ بَحرِ",9,"ر",1,0],["أَمِقُ الكوفَةَ أَرضاً وَأَرى","نَجَفَ الحيرَةِ أَرضاها وَطَن",10,"ن",1,0],["أم قد مُنِعْتَ الفِكْرَ في","ه كما مُنِعتَ من النَّظَر",11,"ر",1,0],["أَمُقدِمٌ يا أبا المِقدامِ أنتَ على","شِعري وتاركُهُ أسلابَ غاراتِ",12,"ت",1,1],["أم قناع قد مزقته الليالي","عن هوى دون طائل فتجرد",13,"د",1,0],["أمقيمةٌ والرّكبُ مُرْتَحِلٌ","بالصّبرِ عنك تَرَحّلَ الركبُ",14,"ب",1,0],["أَمُقرانُ يا اِبنَ بَناتِ العُلوجِ","وَنَسلَ اليَهودِ شِرارِ البَشَر",15,"ر",1,1],["أَمُقرانُ كَم قِرنٍ لَقيتَ بِمَشهَدٍ","فَكانَ بِهِ رَفعاً وَكُنتَ بِهِ نَصبا",16,"ب",2,0],["أَمُقامُ وَصلٍ أَم مَقامُ فِراقِ","فَالقُضبُ بَينَ تَصافُحٍ وَعِناقِ",17,"ق",1,1],["اَمقوِّضَ الدُّولاتِ مَنْ","لي مِنْ صُروفِك بالأَمانِ",18,"ن",1,0],["أَمَقُّ غُرَيرِيٌّ كَأَنَّ قُتودَهُ","عَلى مُثلَثٍ يَدمى مِنَ الحُقبِ حاجِبُه",19,"ب",2,0],["أمقرورةٌ أم غفا وانطوى","على نفسه اللَّهبُ المتعبُ",20,"ب",1,0],["أم قد شربتَ زجاجةً","من صنع بار الكونتننتْ",21,"ت",1,0],["أمْ قُلوبٌ مُحِطَّاتٌ على سا","حلِ لُجِّ الأسى بِمَوجِ الخُطوبِ",22,"ب",1,0],["أم قويّ ؟ إذن مر النوم إذ يغشا","والليل عن جفونك يرتد",23,"د",1,0],["أَمْ قد بَدا مِنّا مَقَا","لٌ في عواقبه ضَررْ",24,"ر",1,0],["أم قصَّرت نفسي ودون","مداكِ أبعادٌ وجُهدُ",25,"د",1,0],["أم قعقَعتْ عَمَدُ الخيام أم ار","تفعَتْ قِبابهُمُ على البُزْلِ",26,"ل",1,0],["أمُقاما بعالجٍ والمطايا","عَرضَ يبرينَ بالظائعن تَخدِى",27,"د",2,0],["أَم قَد كَساكَ النورَ ذو النورِ الَّذي","ما زالَ في آبائِهِ مُتَنَقِّلا",28,"ل",2,0],["أَم قِراهُ لِلضَيفِ أَم ضَربُهُ بِال","سيفِ فَوقَ الطُلا وَتَحتَ الهَوادي",29,"د",2,0],["أمقَلِّداً جيدي بِعقدِ نِظامهْ","وَمَشنِّفاً سَمعي بَدُرِّ كَلامهْ",30,"م",2,1],["أم قبلت زهر الريا","ض شقائق ابن المنذر",31,"ر",1,0],["أَم قَولُكُم هَذا سُكوتٌ خامل","كَمقالكم هَذاك بلبل مَجلسِ",32,"س",1,0],["أَمقدام ذا الجَيش المقدَّم دونهُ","مِن الرُعب جَيش لِلعداة نَذيرُ",33,"ر",1,0],["أَم قيلَ عَربَدَ ذات يَو","مٍ حين صارَ إلى المدامِ",34,"م",1,0],["أم قد تناسيتم عهوداً بالحمى","وليالياً مرت بذات الأرجع",35,"ع",1,0],["أَمقرِّبَ النعماءِ منِّي بعد ما","شطَّ المزارُ بها وأَبعدَ قُرْبها",36,"ب",3,0]]}