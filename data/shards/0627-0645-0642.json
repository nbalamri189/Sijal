tps://poetry.dctabudhabi.ae/diwan/poem/123519","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73200","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73147","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104514","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4690,"نُصوصٌ ولُصوص","https://www.poetsgate.com/ViewPoem.aspx?id=175474",""],[4778,"بان الفساد","https://www.poetsgate.com/ViewPoem.aspx?id=191349",""],[4852,"سُرِق الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=215157",""],[4862,"سماحة اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=55376",""],[4978,"تشطير أشواق الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=178202",""],[5046,"من عاند الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=198513",""],[5050,"أسعد الأقوام في الحرب البطل","https://www.poetsgate.com/ViewPoem.aspx?id=38205",""],[5119,"لست تدري","https://www.poetsgate.com/ViewPoem.aspx?id=196605",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5213,"أرأيت كيف تقصف الاسل","https://www.poetsgate.com/ViewPoem.aspx?id=170519",""],[5431,"الا اجتراحك في عشق إذا لفحا","https://www.poetsgate.com/ViewPoem.aspx?id=198342",""],[788,"أمق رقيق الأسكيتن كأنه","https://www.poetsgate.com/ViewPoem.aspx?id=92905",""],[5596,"نغزى وسحرا","https://www.poetsgate.com/ViewPoem.aspx?id=206186",""],[5689,"لمذا خلقت لماذا أعود","https://www.poetsgate.com/ViewPoem.aspx?id=143408",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5717,"هوت الجباه على جمالك سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=170582",""],[5781,"هاتها نصفَ وسادةٍ وقلب","https://www.poetsgate.com/ViewPoem.aspx?id=202834",""],[5790,"سقاك يا دار هطال من الديم","https://www.poetsgate.com/ViewPoem.aspx?id=112138",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5943,"تشطير لتشطير ( ماذا عساني في هواك )","https://www.poetsgate.com/ViewPoem.aspx?id=138285",""],[5970,"كل بصفحة وجه العيش متبول","https://www.poetsgate.com/ViewPoem.aspx?id=130578",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[4222,"كن عاذري في حبهم لا عاذلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52871&r=&rc=163",""]],"verses":[["أَمَقاصِرَ الغِزلانِ غَيَّرَكِ البِلى","حَتّى غَدَوتِ مَرابِضَ الغِزلانِ",0,"ن",1,0],["أَمُقاماً أَلَذُّ في غَيرِ عَليا","ءَ وَزادي مِن عيشَتي زادُ ضَبِّ",1,"ب",1,0],["أَم قَضيبُ البانِ يَعنيهِ الهَوى","أَم غَزالُ القَفرِ يُصبيهِ الغَزَل",2,"ل",1,0],["أَمَقتولَةَ الأَجفانِ مالَكِ والِهاً","أَلَم تُرِكِ الأَيّامُ نَجماً هَوى قَبلي",3,"ل",2,0],["أَم قَريضٌ جاءَني عَن مَلِكٍ","مالِكٍ بِالبِرِّ رِقَّ الأَنّفُسِ",4,"س",1,0],["أمقدم الفتيان في طلب العلى","ساء العلى إن كنت أول عاثر",5,"ر",1,0],["أَم قَد أَمِنتُ الحادِثا","تِ مِنَ الغَوادي وَالسَواري",6,"ر",2,0],["أَم قَوِيٌّ إِذَن مُرِ النَومَ إِذ يَغ","شاك وَاللَيلُ عَن جُفونِكَ يَرتَد",7,"د",1,0],["امقت من قومي ومن خيمهم","تعصب الاغرار والحمس",8,"س",1,0],["أَمُقِلٌّ مِن غُزرِهِ كُلُّ غَيثٍ","أَم مُخِلٌّ بِفَيضِهِ كُلُّ بَحرِ",9,"ر",1,0],["أَمِقُ الكوفَةَ أَرضاً وَأَرى","نَجَفَ الحيرَةِ أَرضاها وَطَن",10,"ن",1,0],["أم قد مُنِعْتَ الفِكْرَ في","ه كما مُنِعتَ من النَّظَر",11,"ر",1,0],["أَمُقدِمٌ يا أبا المِقدامِ أنتَ على","شِعري وتاركُهُ أسلابَ غاراتِ",12,"ت",1,1],["أم قناع قد مزقته الليالي","عن هوى دون طائل فتجرد",13,"د",1,0],["أمقيمةٌ والرّكبُ مُرْتَحِلٌ","بالصّبرِ عنك تَرَحّلَ الركبُ",14,"ب",1,0],["أَمُقرانُ يا اِبنَ بَناتِ العُلوجِ","وَنَسلَ اليَهودِ شِرارِ البَشَر",15,"ر",1,1],["أَمُقرانُ كَم قِرنٍ لَقيتَ بِمَشهَدٍ","فَكانَ بِهِ رَفعاً وَكُنتَ بِهِ نَصبا",16,"ب",2,0],["أَمُقامُ وَصلٍ أَم مَقامُ فِراقِ","فَالقُضبُ بَينَ تَصافُحٍ وَعِناقِ",17,"ق",1,1],["اَمقوِّضَ الدُّولاتِ مَنْ","لي مِنْ صُروفِك بالأَمانِ",18,"ن",1,0],["أَمَقُّ غُرَيرِيٌّ كَأَنَّ قُتودَهُ","عَلى مُثلَثٍ يَدمى مِنَ الحُقبِ حاجِبُه",19,"ب",2,0],["أمقرورةٌ أم غفا وانطوى","على نفسه اللَّهبُ المتعبُ",20,"ب",1,0],["أم قد شربتَ زجاجةً","من صنع بار الكونتننتْ",21,"ت",1,0],["أمْ قُلوبٌ مُحِطَّاتٌ على سا","حلِ لُجِّ الأسى بِمَوجِ الخُطوبِ",22,"ب",1,0],["أم قويّ ؟ إذن مر النوم إذ يغشا","والليل عن جفونك يرتد",23,"د",1,0],["أَمْ قد بَدا مِنّا مَقَا","لٌ في عواقبه ضَررْ",24,"ر",1,0],["أم قصَّرت نفسي ودون","مداكِ أبعادٌ وجُهدُ",25,"د",1,0],["أم قعقَعتْ عَمَدُ الخيام أم ار","تفعَتْ قِبابهُمُ على البُزْلِ",26,"ل",1,0],["أمُقاما بعالجٍ والمطايا","عَرضَ يبرينَ بالظائعن تَخدِى",27,"د",2,0],["أَم قَد كَساكَ النورَ ذو النورِ الَّذي","ما زالَ في آبائِهِ مُتَنَقِّلا",28,"ل",2,0],["أَم قِراهُ لِلضَيفِ أَم ضَربُهُ بِال","سيفِ فَوقَ الطُلا وَتَحتَ الهَوادي",29,"د",2,0],["أمقَلِّداً جيدي بِعقدِ نِظامهْ","وَمَشنِّفاً سَمعي بَدُرِّ كَلامهْ",30,"م",2,1],["أم قبلت زهر الريا","ض شقائق ابن المنذر",31,"ر",1,0],["أَم قَولُكُم هَذا سُكوتٌ خامل","كَمقالكم هَذاك بلبل مَجلسِ",32,"س",1,0],["أَمقدام ذا الجَيش المقدَّم دونهُ","مِن الرُعب جَيش لِلعداة نَذيرُ",33,"ر",1,0],["أَم قيلَ عَربَدَ ذات يَو","مٍ حين صارَ إلى المدامِ",34,"م",1,0],["أم قد تناسيتم عهوداً بالحمى","وليالياً مرت بذات الأرجع",35,"ع",1,0],["أَمقرِّبَ النعماءِ منِّي بعد ما","شطَّ المزارُ بها وأَبعدَ قُرْبها",36,"ب",3,0],["ام قد حكى عن راحة ال","جواد جوداً ونقل",37,"ل",1,0],["أم قد أتانا بشير اليمن مبتهجاً","يقول يا صاح قم للأنس مغتنما",38,"م",2,0],["أمُقتَصِري أَن لا أحِّنُ صَبابَةٌ","لِزَوجي ما لي لا أحِنُّ وَأُرزِمُ",39,"م",1,0],["أمقتولةَ الأجفانِ من دمعِ حزنِها","أفيقي فإنّي قد أفقتُ من الحزن",40,"ن",1,0],["أمَق رقِيق الإسْكتين كأنه","وجارُ ضِباعٍ بين سُوقة والنَّقْب",41,"ب",1,1],["ام قدود سمر تنادي النزالا","طاعنات لمن يروم الوصالا",42,"ل",2,0],["أم قد غدوتَ تعد شع","ري الجزل من سقط المتاعِ",43,"ع",1,0],["أمُقَتِّلَ الصّيدِ الكُمَاةِ بِرعبِهِ","لِمَنِ ادّخَرْتَ السَّيْفَ وَالمُرَّانَا",44,"ن",2,0],["أم قدارٌ أم الحبابة أم أح","مر لاقت به البلاء ثمودُ",45,"د",1,0],["أَم قتَلُنا حَلا لَها","فأكثَرَت دَلالَها",46,"ه",2,0],["أمقيلَ مَن لبس الهجير تغرُّباً","ومعرّسَ السارين تنزِعُ لغّبا",47,"ب",2,0],["أَم قلوبٌ تُضيئُها النارُ حزناً","وبأسلاكِها يسيلُ الضِّياء",48,"ا",2,0],["أم قلب عاشقها بنار خدودها","يشوى وعارضها عليه دخان",49,"ن",1,0],["أم قطب دائرة الجمال بخده","متنكرٌ في زي عبدٍ أسود",50,"د",1,0],["أم قلت ان القرب أكبر عاذل","فأراك لم تجعل اليه سبيلا",51,"ل",2,0],["أم قد نسيت وثيق عهد بيننا","ولقد عهدتك في الوداد أصيلا",51,"ل",2,0],["أمقتبلٌ أنا أَم ذا وداعٌ","وهل فَرِحٌ أنا أم غاب بالي",52,"ل",2,0],["أم قد ذكرتَ سُهولها","وهي البساطُ الأخضَرُ",53,"ر",1,0],["أم قد غدا في لظى الرمضاء ركبهم","نحو الردى والهدى للّه من حكم",54,"م",1,0],["أم قابلتك مع القبول تحية","أَرِجت فقلت عن الأحبة تَنْقُل",55,"ل",1,0],["أمقبل أرض الشرك أَوْضَاعَ ضُمَّر","تمسيهم فرسانهم وتصبِّح",56,"ح",1,0],["أم قَد جَرَت مَجرَى الضُّرُورِيَّاتِ لاَ","تَحتَاجُ نَقلاً وَهيَ ذَاتُ بَيَانِ",57,"ن",1,0],["أمقيمٌ بعده يصحبه","أم دعاه للردى فامتثلا",58,"ل",2,0],["أم قد تركب كالانسان عنصره","وطبعه وترى اما له وابا",59,"ب",2,0],["أم قينة من بنات الترك يعجبني","منها البنان اذا ما لاح مختضبا",59,"ب",2,0],["اَمقتنصي الظبا رِيمي دَعوه","وَدُونَكُم الجآذر وَالظِباءا",60,"ا",3,0],["ام قد تغنت على القيثار مرسلة","صوتاً به قد جلونا الهم والكدرا",61,"ر",2,0],["ام قد سطا ريب المون على التي","اوفت بعلياها على كيوان",62,"ن",1,0],["أم قتيلٌ مضرَّج بدماء","أم غريبٌ معفَّر بغبار",63,"ر",1,0],["أَم قَضَينا حاجاتِنا فَإِلى المَو","تِ مَصيرُ المُلوكِ وَالأَقيالِ",64,"ل",1,0],["أم قناني الراح فضت عن سلاف","من رحيق بسحيق المسك يختم",65,"م",1,0],["أم قصر إبراهيم أشرق نوره","وحلى معانيه بدت للحس",66,"س",1,0],["أَمُقَلِّداً سيفَ الفُتو","رِ دَمي الذي تتقلّدُ",67,"د",1,0],["أمقوضين قفوا لصب ريثما","يقضي لبانة قلبه الولهان",68,"ن",1,0],["أَمقلّدي كافورَ في كفرانكم","نِعَماً بها لِرقابكم تطويقُ",69,"ق",1,0],["أَمَقيلنا عثراتنا","هَلّا تركت لنا مقيلا",70,"ل",2,0],["أمقيم الدهر معتذلا","بعد ما قد كان في عوج",71,"ج",1,0],["أمقلة السحب كم أبدعت من غنج","في النرجس الغض من أهداب نجلاء",72,"ا",2,0],["أم قوافيك التي حبرتها","خالها النشوان خمرا مسكرا",73,"ر",2,0],["أَمقام إِبراهيم شادتك النُهى","وَلَك التَهاني وَالمَفاخر وهبةُ",74,"ه",1,0],["أمقربي لحد الشهيد طواعة","أو تعلمون الطائع المنقادا",75,"د",2,0],["أم قد غدوت من الكدر","تشكو عذابك للسنين",76,"ن",1,0],["أَمْ قدْ شَجَاكَ على قضيبكَ أنّني","لِنَوَى قضيبِ البانةِ المَيَّادِ",77,"د",1,0],["أَمْ قلتَ للَّيْلِ طُلْ فأفْرَط في الط","طَاعةِ حتى إصْبَاحهُ ظُلَمُ",78,"م",1,0],["أَم قطعة الديباج أَم زهر الربا","أَم عطفة من هاجر ووصاله",79,"ل",2,0],["أم قد صبوت إلى ربي وادي الظبا","فتلا الغرام عليك آيةَ حتفه",80,"ف",2,0],["أم قد ذكرت غزال ذيّاك الحمى","بشهود ظبي الواديين وخشفه",80,"ف",2,0],["أم قلت للباغى السلو","وقد أفضت الدمع لامه",81,"م",2,0],["أَم ق كفى سبباً إلى دركِ المُنى","صدقُ الولاء وحُسنُ ظنِّ الآمل",82,"ل",1,0],["أم قد ألمَّ بكَ الطَّيفُ الطَّروقُ فمُذ","أَغشاكَ حرُّ الأَنفُسِ العَرِقُ",83,"ق",1,0],["أم قد حكيتَ البدرَ ليلةَ تِمِّهِ","فاستَعظمَ المحكيُّ قدرَ الحاكي",84,"ك",2,0],["أم قوس محتوم القضاء","يزج مبري المقادر",85,"ر",1,0],["أم قد درت نكب الرياح بأنه","أولى بأن يثوي السماء مقيلا",86,"ل",2,0],["أمْ قَدْ رَضيتَ بِمَوقِعٍ","في سافلٍ ما أوْضَعَهْ",87,"ع",2,0],["أم قد نسيتم مع الأيام خالقكم","أم قد دفنتوه في لحد الأولى سبقوا ؟!",88,"ق",3,0],["أمقدَّرٌ لي أن أظَلَّ رمادَ نارٍ","رغم بردِكَ يحترِقْ ؟",89,"ق",1,0],["أم قسوة الأيام جاءت فجأةً","فنسيتُ يوماً كنت فيه منعّما",90,"م",2,0],["(أم قد هذيت فخلتهن أعاديا )","فنحرتُ آخرها وهنَّ فلول",91,"ل",1,0],["أمْ قدْ رمَتْكَ برمشِ العينِ فاتنةٌ","حتى هجرتَ وجرَّعْتَ الهوى الألما",92,"م",2,0],["أم قعود والمعاصي ظهرت","وأهيل الدين كل في وجل",93,"ل",1,0],["أُمَّ قَلْبَيْنَا نِدَاءٌ","فَاحْتَذَيْنَا الأَنْبِيَاءْ",94,"ا",2,0],["أمقتدر تعنو الورى لاقتداره","ليمنى اقتداري اشدد به وليسراه",95,"ا",2,0],["\"أمقالات \"\"جابر\"\" أم مقاما\"","\"ت تباري \"\"الأحرار\"\" فيها الحريري\"",96,"ر",2,0],["أمْ قَد أمِنتَ مِنَ المُهَيمِنِ مَكرَهُ","أم آيِسٌ مِنْ رَوحِهِ أم هَازِلُ؟",97,"ل",1,0],["أم قد مللت مودتي لقلا","هيهات ما من شأنك الملل",98,"ل",1,0],["أم قبلة الخلق اكسيرا ينادمها","ويرشف الوقت أقداحا بها طفحا",99,"ح",2,0],["أمق رقيق الأسكيتن كأنه","وجار ضباع بين سوقة والنقب",100,"ب",1,1],["أم قد تناسيت عهداً","ما بيننا كان سرا",101,"ر",2,0],["أمقت طول مقامي بها","ولكن أحاذر منها الصدود",102,"د",1,0],["أم قد مضى من قبل أن","اقضي من الدنيا الوطر؟",103,"ر",1,0],["أمقلدا حكم الشريعة فالورى","تبع لرأيك إذ رأتك مقلدا",104,"د",2,0],["أَمْ قُشْعَريرَةُ قُبْلةٍ مَوْعودَةٍ","مِنْ كَيْدِ غُرٍّ في غِوًى يَتَرنَّحُ",105,"ح",1,0],["أم قد تغير ما قد كنت أعهده","منهم وما كان لي بالعهد من قدم",106,"م",1,0],["أم قد رأيت جوازه، كلاَّ فقد","ألقى عليك أولوا الهداة عتابا",107,"ب",2,0],["أم قد هذيت فخلتهن أعاديا)","((وظننتُ أني بينهنَّ قتيلُ",108,"ل",1,0],["أم قد خلقنا لنشقى في حظيرتها","والمرء يلقاه من أيامه غول",109,"ل",1,0],["أم قيد وسعك أن تنهنه زفرةً","نارية يرمي الجوى جمراتها",110,"ت",3,0],["أَم قُسوسٍ مَجَّدوا الضَّعفَ وَما","أُغرِموا إِلاّ بِنَصبِ الصُّلُبِ",111,"ب",1,0],["أَم قًضاةٍ حَكَموا عَن عِفَّةٍ","وَنَفَوا بِالعَدلِ شَرَّ الكُرَبِ",111,"ب",1,0],["أَم قَضَوا لاهينَ لَم يَذَّكِروا","لَذَّةَ الحُزنِ وَعُقبى الطَّرَبِ",111,"ب",1,0],["أَمْ قَدْ رَغِبْتَ عن «الجَواز»","وَزَمَّ مُقْلَتَكَ «الوجوبُ»؟",112,"ب",1,0],["أّ مُقْتَحِمَ الْأَهْوَالِ مُجْتَرِئَ الرَّدَى","أَ وِسْعُكَ أَفْعَالٌ تَضِيقُ بِهَا الْبُهْمُ؟!",113,"م",1,0],["أم قد كفى سببا إلى درك المنى","صدق الولاء وحسن ظن الآمل",114,"ل",1,0]]}