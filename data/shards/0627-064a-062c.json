ps://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5431,"الى قمرٍ أسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=198438",""],[5431,"أنطقُ الضاد خائفا من زماني ...","https://www.poetsgate.com/ViewPoem.aspx?id=199742",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[5490,"حديث الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=176287",""],[5508,"يا سيّدي قد رمُيتُ من زمني","https://www.poetsgate.com/ViewPoem.aspx?id=110835",""],[5528,"لوعة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=201198",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[1547,"تُراهْم حين صدّوا عن لقائي","https://www.poetsgate.com/ViewPoem.aspx?id=16708",""],[5638,"حنين إلى القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200124",""],[5736,"فتات حديث","https://www.poetsgate.com/ViewPoem.aspx?id=211831",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[402,"روعت بالفراق بعد الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=36040",""],[5790,"من مبلغ عني المليك الأروعا","https://www.poetsgate.com/ViewPoem.aspx?id=111886",""],[5956,"أتاني الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181868",""],[5956,"حبي الحلال","https://www.poetsgate.com/ViewPoem.aspx?id=181977",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5977,"جروح تبرأ","https://www.poetsgate.com/ViewPoem.aspx?id=213270",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6259,"أحياه بعد الله إذ حياه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59407&r=&rc=55",""]],"verses":[["أَيَجُرُّني عَن رَعيِ أَنعُمِهِ","مَن كانَ قَبلُ أُجِرُّهُ رَسَني",0,"ن",2,0],["أَيَجزَعُ المَرءُ لِما فاتَهُ","وَكُلُّ ما يُدرِكُهُ فَوتُ",1,"ت",1,0],["أَيُّ جَدٍّ وَأَبٍ يَدعوهُما","جَدَّ يا جَدَّ أَغِثني يا أَبا",2,"ا",1,0],["أَيُجمَعُ شَملٌ أَو تُراحُ مَطيَّةٌ","وَأَنتَ بِتَفريقِ الأَحِبَّةِ مُولَعُ",3,"ع",1,0],["أيَجْمُلُ أنْ أُجْفى فآتيَ مُغْضَباً","وتأتيَ ما لا تَرتَضيهِ لنا العُلا",4,"ل",2,0],["أيُجدي بُعيدَ القتل علمي بقاتلي","وأن الذي راوغتهُ كان أروغا؟",5,"غ",2,0],["أَيُّ جَنىً لِلأَكفِّ دَانِي","مَا لِلمُبَارَى بِهِ يَدَانِ",6,"ن",1,0],["أَيجْهَرُ بِالشَّكْوَى وَأَنْتَ سَميعُهُ","أَيُعْلِنُ بالنَّجْوَى وَأَنْتَ عَلِيمُهُ",7,"م",2,0],["أَي جُنودَ الرَئيسِ نادوا جِهاراً","فَإِذا لَم يُجِب فَشُقّوا الثِيابا",8,"ب",2,0],["أَيَجمُلُ بي هَذا العُقوقُ وَإِنَّما","عَلى غَيرِ هَذا العَهدِ قَد عَرَفاني",9,"ن",2,0],["أَيَجمُلُ بِالأَديبِ أَديبِ مِصرٍ","بُكاءُ الطِفلِ أَرهَقَهُ الفِطامُ",10,"م",1,0],["أَيَجمُلُ مِن بَعدِ هَذا وَذاكَ","بِأَن نَستَكينَ وَأَن نَجمُدا",11,"د",2,0],["أَيَجمُلُ أَن أُبيحَكَ مَحضَ وُدّي","وَأَنتَ تَسومُني سوءَ العَذابِ",12,"ب",1,0],["أي جمعٍ يحيط بي من حصيفا","ت الغواني ومن سراة الرجال",13,"ل",1,0],["أي جرح في إبائي راعف","فاته الآسي فلم يلتئم",14,"م",1,0],["أيُّ جسم يَبقى على غِيَر الده","ر خَلِيَّاً من قاتل الأدواءِ",15,"ا",2,0],["أيُجدب يا للناس مرعَى وليِّكم","وأنتم غيوثٌ للورى وبحور",16,"ر",1,0],["أيَّ جيد ترونه ليس يمسي","في عرى عارفاتكم مربوقا",17,"ق",2,0],["أيَّ جناياته اضطغنتَ له","فليس هذا أوانَ مضطغنكْ",18,"ك",1,0],["أَيَجعَلُ بَطناً مُنتِنَ الريحِ مُقفِراً","عَلى بَطنِ خَودٍ دائِمِ الخَفَقانِ",19,"ن",1,0],["أَيَجهَلُ الحُبَّ مَن أَصحَت بِهِ حُرقٌ","تَكادُ مِن حَرِّها الأَحشاءُ تَتَّقِدُ",20,"د",1,0],["أيجوز أن الأرض تُس","كن وحدها بين الكواكب",21,"ب",1,0],["أَيُّ جَدَّيكَ لَم يَفُت وَهُوَ ثانٍ","مِن مَساعيهِ أَلسُنَ المُدّاحِ",22,"ح",1,0],["أَيجمُلُ أن أرى منك انحرافاً","ولا عاراً أتيتُ ولا شَنارا",23,"ر",2,0],["أَيَجوزُ أَن تَخفى عَلَيكَ قَضِيَّتي","وَالناسُ في مُضَرٍ بِها تَتَكَلَّمُ",24,"م",1,0],["أَيَجوزُ أَن يُمسي السَقيمُ مُبَرَّأً","مِنها وَصِبيانُ المَكاتِبِ تُتهَمُ",24,"م",1,0],["أيُّ جَيشَيك مُغرِقي ليليَ الطا","غِي أم الشوقُ وحده وهو عارم",25,"م",1,0],["أي جلالٍ فاته وصفه","وأي حسن فيه لم يرسم",26,"م",1,0],["أَيَجني عَلى مُهجَتي طَرفُهُ","وَيُخضَبُ مِن دَمِها كَفُّهُ",27,"ف",2,1],["أيْجمُلُ أن نَذِلَّ وأن نَضِيعا","ونُطعِمَ لَحمنا القومَ الجِياعا",28,"ع",2,0],["أَيَجُوزُ قَوْلُ مَنَزِّهٍ لإِلههِ","سبحانَ قاتِلِ نَفْسِهِ فأَقُولا",29,"ل",2,0],["أَيَجلو الشَمسَ لِلرائي نَهارٌ","فَقَد شَرَقَت وَمَشرِقُها مُضِبُّ",30,"ب",1,0],["أيُّ جَديدٍ لكَ لم تُبْلِهِ","وأيُّ أقرانِكَ لم تُرْدِهِ",31,"د",2,0],["أيُّ جوادٍ قد كبا","وأيُّ سيفٍ قد نبا",32,"ب",2,1],["أيُجحد في الشرق النبوغُ ويُزدرى","ويشقى بمصر النابهونَ الغطارفُ",33,"ف",1,0],["أَيَجْمُلُ بِالْعَهْدِ أَنْ يُسْتَبَاحَ","لِوَاشٍ وَلِلْوُدِّ أَنْ يُقْطَعَا",34,"ع",2,0],["أَيُّ جَاٍٍ سَمَا إِلَيْهِ فَأَجْرَى","دَمَهُ الحُرَّ تَبَّ أَهْلُ الشِّقَاقِ",35,"ق",1,0],["أَيُّ جَيشٍ يُدَرِّبُونَ لِمِصْرٍ","وَوَلِيُّ التَّدْرِيبِ فِيهِ العَادِي",36,"د",2,0],["أيجهل الدهر اذ خضت الغمار به","ان ليس يعحزني عن خوضه الوشل",37,"ل",1,0],["أي جذلى رجعت عنها ومنها","واليها جنازتي وزفافي",38,"ف",2,0],["ايجمل نقض العهد والود حفظه","من الدين اذ في حفظه جاءنا الامر",39,"ر",1,0],["أيجحد من جلالتك السناء","وانت لعمتة الدنيا ضياء",40,"ا",2,1],["أَيَجوزُ ذاكَ وَقَد أَضاقَ مَذاهِبي","عَن مُلكِهِ مَلِكٌ أَنالَ فَأَوسَعا",41,"ع",2,0],["أَيُجحَدُ ما توليهِ آلاءُ مُنعِمٍ","إِذا جارَ صَرفُ الدَهرِ كانَ لَهُ صَرفا",42,"ف",2,0],["أيَجحَدُ فَضلَهُ عقلٌ سليمٌ","وقد نطقت بسؤدده الحمام",43,"م",1,0],["أَيَجمُلُ أَن أُجفى وَأُنفى وَعِندَكُم","لِمَن لَيسَ مِثلي عِيشَةٌ وَمُقامُ",44,"م",1,0],["أيجلوكَ يا عضبَ الشبا ما هذت بهِ","وقبلكَ ما ضرَِّ النبيُّ هريرها",45,"ر",3,0],["أَيَجزَعُ كَعبٌ لِأَشياعِهِ","وَيَبكي مِنَ الزَمَنِ الأَعوَجِ",46,"ج",1,1],["أيجمل عيد أنت فيه مخاصمي","مخاصمة العين الكحيلة للبدر",47,"ر",1,0],["أَيُّ جَمرٍ أَحَرُّ من جَمرِ حُبٍّ","صادَفَ القَلبَ مَوقِداً فَاِستَقَرّا",48,"ر",2,0],["أَي جَمال النِساءِ أوليتَ حُكماً","فَاِحتَكِم ما تَشاءُ في الضّعفاءِ",49,"ا",2,0],["أَيَجمُلُ أن تُنعى الفَضائلُ لِلوَرى","وَلم تكُ في الباكينَ وَيحكَ باكِيا",50,"ي",2,0],["أَيَجوزُ أَن أَغشى حِماكَ فَأَنثَني","صِفراً يَدي وَيَداكَ مَلأى بِالثَنا",51,"ن",2,0],["أي جفنٍ أجريتَ منهُ دموعاً","كان لولاكَ في السماكين بُعدا",52,"د",2,0],["أيجرؤُ ذِئبٌ أن يدوس برجلِهِ","بلاداً بعباس الأمير تسودُ",53,"د",1,0],["أيجرؤُ ذِئبٌ أن يدوس برجلِهِ","عريناً وفي ذاكَ العرينِ أسودُ",54,"د",1,0],["أيَجُوزُ أنْ يُرْتَابَ في إظْهَارِه","ولهُ المَلائِكُ والمُلوكُ ظَهيرُ",55,"ر",1,0],["أَيَجْمُلُ بِيَ الْعَزاءُ وَأَنْتَ ثاوٍ","أَيَحْسُنُ بِي الْبَقاءُ وَأَنْتَ فانِ",56,"ن",1,0],["أَيَجُوزُ فِي حُكْمِ الْمُرُؤَةِ أَنْ","أَظْما وَدُونَ سَماحِكَ الْبَحْرُ",57,"ر",1,0],["أَيَجوزُ حَجُّهُمُ وَما مِن لَحظَةٍ","إِلّا بِها مِنهُنَّ يُقتَلُ مُسلِمُ",58,"م",1,0],["أَيَجودُ مَولانا عَلِيٌّ بِنَعمَةٍ","مِن فَضلِهِ مَحضاً وَلَستَ مُؤَمَّلا",59,"ل",2,1],["أَيُّ جَهلٍ يَكونُ أَبَين مِن جَه","لٍ أَراني أُضحي عَلَيهِ وَأُمسي",60,"ي",1,1],["إيجابُ وَجدي فيهِ سالِبُ سَلوَتي","عَنهُ لِأَنّي مِنهُ أَيسَرُ مِنِّهِ",61,"ن",2,0],["أَيّ جاه مِثل جاه المُصطَفى","معدن المَعروف كَنز الحسب",62,"ب",1,0],["أيجوز أن يغدو أسيراً بعدها","ويقاد بالتقليد كالعميان",63,"ن",1,0],["أيجوز أن أعطى الحصى عوضاً","مني على عِقْدٍ من الدُّر",64,"ر",1,0],["أيجهل مثلي منصب الحق بعدما","عرفت يقيناً ما حوى كل دفتر",65,"ر",1,0],["أيجوز بين المسلمين بقاؤهم","أبداً فأين دليل ذا والشاهد",66,"د",1,0],["أَيَجوز أَن أَشكو إِضاقَة عيشة","وَالمال عندك واهِن وَالجاهُ",67,"ا",2,0],["أيجهل الأَمر على علمٍ به","والجهل بالعاقل عَيبٌ فاضح",68,"ح",1,0],["أيّ جمع هذا وأيّ اتِّفاق","وصحابٍ أماجد ورفاق",69,"ق",1,1],["أيجوز ان أشكو اللغوب وقد غدا","يحكي رضاب الثغر طعم الكوثر",70,"ر",1,0],["أيجورُ الزمانُ يا ثِقةَ المُلْ","كِ وأنت الكفيلُ لي بالنجاحِ",71,"ح",1,1],["أيجوز أن تنحوا مقالة من","ضلوا بما قالوه بل أفكوا",72,"ك",3,0],["أيجوز ل