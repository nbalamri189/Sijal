{"poems":[[53,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[53,"قد آن أن يسمعك الصوت","https://www.aldiwan.net/poem30673.html","السريع"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"فؤاد ببين الظاعنين مروع","https://www.aldiwan.net/poem45790.html","الطويل"],[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[100,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[77,"أكرم بها من بناء باني","https://www.aldiwan.net/poem36022.html","مخلع البسيط"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[86,"دعاني رفاقي والقوافي مريضة","https://www.aldiwan.net/poem10483.html","الطويل"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[86,"سمعنا حديثاً كقطر الندى","https://www.aldiwan.net/poem10921.html","المتقارب"],[73,"أتهجرني وتغصبني كتابي","https://www.aldiwan.net/poem11903.html","الوافر"],[93,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"ليهنك أن قد مر من صدر دولة","https://www.aldiwan.net/poem62950.html","الطويل"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[78,"يا جاهل الحب إن الحب لي سند","https://www.aldiwan.net/poem14242.html","البسيط"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[45,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[97,"لا تجزعوا للشاعر الملهم","https://www.aldiwan.net/poem24985.html","السريع"],[74,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[105,"شباب محمد سيروا سراعا","https://www.aldiwan.net/poem41934.html","الوافر"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[46,"نفوس للقيامة تشرئب","https://www.aldiwan.net/poem22091.html","الوافر"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42688","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"]],"verses":[["أَيَجُرُّني عَن رَعيِ أَنعُمِهِ","مَن كانَ قَبلُ أُجِرُّهُ رَسَني",0,"ي",1,0],["أَيَجزَعُ المَرءُ لِما فاتَهُ","وَكُلُّ ما يُدرِكُهُ فَوتُ",1,"ت",1,0],["أَيُّ جَدٍّ وَأَبٍ يَدعوهُما","جَدَّ يا جَدَّ أَغِثني يا أَبا",2,"ا",1,0],["أَيُجمَعُ شَملٌ أَو تُراحُ مَطيَّةٌ","وَأَنتَ بِتَفريقِ الأَحِبَّةِ مُولَعُ",3,"ع",1,0],["أيَجْمُلُ أنْ أُجْفى فآتيَ مُغْضَباً","وتأتيَ ما لا تَرتَضيهِ لنا العُلا",4,"ل",2,0],["أيُجدي بُعيدَ القتل علمي بقاتلي","وأن الذي راوغتهُ كان أروغا؟",5,"غ",2,0],["أَيُّ جَنىً لِلأَكفِّ دَانِي","مَا لِلمُبَارَى بِهِ يَدَانِ",6,"ن",1,0],["أَيجْهَرُ بِالشَّكْوَى وَأَنْتَ سَميعُهُ","أَيُعْلِنُ بالنَّجْوَى وَأَنْتَ عَلِيمُهُ",7,"م",2,0],["أَي جُنودَ الرَئيسِ نادوا جِهاراً","فَإِذا لَم يُجِب فَشُقّوا الثِيابا",8,"ب",2,0],["أَيَجمُلُ بي هَذا العُقوقُ وَإِنَّما","عَلى غَيرِ هَذا العَهدِ قَد عَرَفاني",9,"ي",1,0],["أَيَجمُلُ بِالأَديبِ أَديبِ مِصرٍ","بُكاءُ الطِفلِ أَرهَقَهُ الفِطامُ",10,"م",1,0],["أَيَجمُلُ مِن بَعدِ هَذا وَذاكَ","بِأَن نَستَكينَ وَأَن نَجمُدا",11,"د",2,0],["أَيَجمُلُ أَن أُبيحَكَ مَحضَ وُدّي","وَأَنتَ تَسومُني سوءَ العَذابِ",12,"ب",1,0],["أي جمعٍ يحيط بي من حصيفا","ت الغواني ومن سراة الرجال",13,"ل",1,0],["أي جرح في إبائي راعف","فاته الآسي فلم يلتئم",14,"م",1,0],["أيُّ جسم يَبقى على غِيَر الده","ر خَلِيَّاً من قاتل الأدواءِ",15,"ا",2,0],["أيُجدب يا للناس مرعَى وليِّكم","وأنتم غيوثٌ للورى وبحور",16,"ر",1,0],["أيَّ جيد ترونه ليس يمسي","في عرى عارفاتكم مربوقا",17,"ق",2,0],["أيَّ جناياته اضطغنتَ له","فليس هذا أوانَ مضطغنكْ",18,"ك",1,0],["أَيَجعَلُ بَطناً مُنتِنَ الريحِ مُقفِراً","عَلى بَطنِ خَودٍ دائِمِ الخَفَقانِ",19,"ن",1,0],["أَيَجهَلُ الحُبَّ مَن أَصحَت بِهِ حُرقٌ","تَكادُ مِن حَرِّها الأَحشاءُ تَتَّقِدُ",20,"د",1,0],["أيجوز أن الأرض تُس","كن وحدها بين الكواكب",21,"ب",1,0],["أَيُّ جَدَّيكَ لَم يَفُت وَهُوَ ثانٍ","مِن مَساعيهِ أَلسُنَ المُدّاحِ",22,"ح",1,0],["أَيجمُلُ أن أرى منك انحرافاً","ولا عاراً أتيتُ ولا شَنارا",23,"ر",2,0],["أَيَجوزُ أَن تَخفى عَلَيكَ قَضِيَّتي","وَالناسُ في مُضَرٍ بِها تَتَكَلَّمُ",24,"م",1,0],["أَيَجوزُ أَن يُمسي السَقيمُ مُبَرَّأً","مِنها وَصِبيانُ المَكاتِبِ تُتهَمُ",24,"م",1,0],["أيُّ جَيشَيك مُغرِقي ليليَ الطا","غِي أم الشوقُ وحده وهو عارم",25,"م",1,0],["أي جلالٍ فاته وصفه","وأي حسن فيه لم يرسم",26,"م",1,0],["أَيَجني عَلى مُهجَتي طَرفُهُ","وَيُخضَبُ مِن دَمِها كَفُّهُ",27,"ف",2,1],["أيْجمُلُ أن نَذِلَّ وأن نَضِيعا","ونُطعِمَ لَحمنا القومَ الجِياعا",28,"ع",2,0],["أَيَجُوزُ قَوْلُ مَنَزِّهٍ لإِلههِ","سبحانَ قاتِلِ نَفْسِهِ فأَقُولا",29,"ل",2,0],["أَيَجلو الشَمسَ لِلرائي نَهارٌ","فَقَد شَرَقَت وَمَشرِقُها مُضِبُّ",30,"ب",1,0],["أيُّ جَديدٍ لكَ لم تُبْلِهِ","وأيُّ أقرانِكَ لم تُرْدِهِ",31,"د",2,0],["أيُّ جوادٍ قد كبا","وأيُّ سيفٍ قد نبا",32,"ب",2,1],["أيُجحد في الشرق النبوغُ ويُزدرى","ويشقى بمصر النابهونَ الغطارفُ",33,"ف",1,0],["أَيَجْمُلُ بِالْعَهْدِ أَنْ يُسْتَبَاحَ","لِوَاشٍ وَلِلْوُدِّ أَنْ يُقْطَعَا",34,"ع",2,0],["أَيُّ جَاٍٍ سَمَا إِلَيْهِ فَأَجْرَى","دَمَهُ الحُرَّ تَبَّ أَهْلُ الشِّقَاقِ",35,"ق",1,0],["أَيُّ جَيشٍ يُدَرِّبُونَ لِمِصْرٍ","وَوَلِيُّ التَّدْرِيبِ فِيهِ العَادِي",36,"د",2,0]]}