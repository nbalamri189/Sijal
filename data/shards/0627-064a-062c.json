{"poems":[[53,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[53,"قد آن أن يسمعك الصوت","https://www.aldiwan.net/poem30673.html","السريع"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"فؤاد ببين الظاعنين مروع","https://www.aldiwan.net/poem45790.html","الطويل"],[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[100,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[77,"أكرم بها من بناء باني","https://www.aldiwan.net/poem36022.html","مخلع البسيط"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[86,"دعاني رفاقي والقوافي مريضة","https://www.aldiwan.net/poem10483.html","الطويل"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[86,"سمعنا حديثاً كقطر الندى","https://www.aldiwan.net/poem10921.html","المتقارب"],[73,"أتهجرني وتغصبني كتابي","https://www.aldiwan.net/poem11903.html","الوافر"],[93,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"ليهنك أن قد مر من صدر دولة","https://www.aldiwan.net/poem62950.html","الطويل"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[78,"يا جاهل الحب إن الحب لي سند","https://www.aldiwan.net/poem14242.html","البسيط"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[45,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[97,"لا تجزعوا للشاعر الملهم","https://www.aldiwan.net/poem24985.html","السريع"],[74,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[105,"شباب محمد سيروا سراعا","https://www.aldiwan.net/poem41934.html","الوافر"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[46,"نفوس للقيامة تشرئب","https://www.aldiwan.net/poem22091.html","الوافر"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42688","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[113,"لكل مقام في مقال الهوى سر","https://www.aldiwan.net/poem41118.html","عموديه"],[113,"أيجحد من جلالتك السناء","https://www.aldiwan.net/poem41473.html","عموديه"],[141,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[141,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[148,"بحمد الله يفتتح الكلام","https://www.aldiwan.net/poem68494.html","الوافر"],[167,"صعود العلا إلا عليك حرام","https://www.aldiwan.net/poem1666.html",""],[197,"أراك الحمى هل قبلتك ثغورها","https://www.aldiwan.net/poem45651.html","الطويل"],[201,"أيجزع كعب لأشياعه","https://www.aldiwan.net/poem68169.html","المتقارب"],[209,"سلام على من لا أسميه إنني","https://www.aldiwan.net/poem46610.html","الطويل"],[221,"حمل الداء من شواطىء مصرا","https://www.aldiwan.net/poem41608.html","الخفيف"],[221,"كيف قوضتم بناء القضاء","https://www.aldiwan.net/poem41913.html","الخفيف"],[223,"تدفق دموعا أو دما أو قوافيا","https://www.aldiwan.net/poem55094.html","الطويل"],[233,"يا خير من لبس النعال وخير من","https://www.aldiwan.net/poem31735.html","الكامل"],[239,"أيها الفاتك الأثيم رويدا","https://www.aldiwan.net/poem45755.html","الخفيف"],[239,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[239,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[273,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[278,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[278,"أبلغ أبا الفضل الذي شهدت","https://www.aldiwan.net/poem60732.html","أحذ الكامل"],[280,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[318,"أيجود مولانا علي بنعمة","https://www.aldiwan.net/poem67230.html","الكامل"],[336,"أي جهل يكون أبين من جهل","https://www.aldiwan.net/poem68748.html","الخفيف"],[347,"من لي بوصل ممنع قطعت يدي","https://www.aldiwan.net/poem15928.html","الكامل"],[359,"مقلتي قد نلت كل الارب","https://www.aldiwan.net/poem68142.html","الرمل"],[400,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[400,"أبيات شعرك لا قصور بها","https://www.aldiwan.net/poem33907.html","الكامل"],[400,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[400,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[403,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[413,"في كل يوم للمنون صولة","https://www.aldiwan.net/poem53940.html","الرجز"],[413,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[426,"برزت تفاخر بالجبين الأقمر","https://www.aldiwan.net/poem41402.html","الكامل"],[429,"أيجور الزمان يا ثقة المل","https://www.aldiwan.net/poem12784.html","الخفيف"],[434,"أين الخليط وأية سلكوا","https://www.aldiwan.net/poem2600.html","الكامل"],[434,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[451,"الصيف أين هو الحبيب فما أرى","https://www.aldiwan.net/poem61223.html","الكامل"],[456,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[462,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[462,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[462,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[477,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[503,"خيال الحقل","https://www.aldiwan.net/poem27894.html","مجزوء الوافر"],[513,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[561,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[584,"أيجمل سلواني إذا هجر الحب","https://www.aldiwan.net/poem17419.html","الطويل"]],"verses":[["أَيَجُرُّني عَن رَعيِ أَنعُمِهِ","مَن كانَ قَبلُ أُجِرُّهُ رَسَني",0,"ي",1,0],["أَيَجزَعُ المَرءُ لِما فاتَهُ","وَكُلُّ ما يُدرِكُهُ فَوتُ",1,"ت",1,0],["أَيُّ جَدٍّ وَأَبٍ يَدعوهُما","جَدَّ يا جَدَّ أَغِثني يا أَبا",2,"ا",1,0],["أَيُجمَعُ شَملٌ أَو تُراحُ مَطيَّةٌ","وَأَنتَ بِتَفريقِ الأَحِبَّةِ مُولَعُ",3,"ع",1,0],["أيَجْمُلُ أنْ أُجْفى فآتيَ مُغْضَباً","وتأتيَ ما لا تَرتَضيهِ لنا العُلا",4,"ل",2,0],["أيُجدي بُعيدَ القتل علمي بقاتلي","وأن الذي راوغتهُ كان أروغا؟",5,"غ",2,0],["أَيُّ جَنىً لِلأَكفِّ دَانِي","مَا لِلمُبَارَى بِهِ يَدَانِ",6,"ن",1,0],["أَيجْهَرُ بِالشَّكْوَى وَأَنْتَ سَميعُهُ","أَيُعْلِنُ بالنَّجْوَى وَأَنْتَ عَلِيمُهُ",7,"م",2,0],["أَي جُنودَ الرَئيسِ نادوا جِهاراً","فَإِذا لَم يُجِب فَشُقّوا الثِيابا",8,"ب",2,0],["أَيَجمُلُ بي هَذا العُقوقُ وَإِنَّما","عَلى غَيرِ هَذا العَهدِ قَد عَرَفاني",9,"ي",1,0],["أَيَجمُلُ بِالأَديبِ أَديبِ مِصرٍ","بُكاءُ الطِفلِ أَرهَقَهُ الفِطامُ",10,"م",1,0],["أَيَجمُلُ مِن بَعدِ هَذا وَذاكَ","بِأَن نَستَكينَ وَأَن نَجمُدا",11,"د",2,0],["أَيَجمُلُ أَن أُبيحَكَ مَحضَ وُدّي","وَأَنتَ تَسومُني سوءَ العَذابِ",12,"ب",1,0],["أي جمعٍ يحيط بي من حصيفا","ت الغواني ومن سراة الرجال",13,"ل",1,0],["أي جرح في إبائي راعف","فاته الآسي فلم يلتئم",14,"م",1,0],["أيُّ جسم يَبقى على غِيَر الده","ر خَلِيَّاً من قاتل الأدواءِ",15,"ا",2,0],["أيُجدب يا للناس مرعَى وليِّكم","وأنتم غيوثٌ للورى وبحور",16,"ر",1,0],["أيَّ جيد ترونه ليس يمسي","في عرى عارفاتكم مربوقا",17,"ق",2,0],["أيَّ جناياته اضطغنتَ له","فليس هذا أوانَ مضطغنكْ",18,"ك",1,0],["أَيَجعَلُ بَطناً مُنتِنَ الريحِ مُقفِراً","عَلى بَطنِ خَودٍ دائِمِ الخَفَقانِ",19,"ن",1,0],["أَيَجهَلُ الحُبَّ مَن أَصحَت بِهِ حُرقٌ","تَكادُ مِن حَرِّها الأَحشاءُ تَتَّقِدُ",20,"د",1,0],["أيجوز أن الأرض تُس","كن وحدها بين الكواكب",21,"ب",1,0],["أَيُّ جَدَّيكَ لَم يَفُت وَهُوَ ثانٍ","مِن مَساعيهِ أَلسُنَ المُدّاحِ",22,"ح",1,0],["أَيجمُلُ أن أرى منك انحرافاً","ولا عاراً أتيتُ ولا شَنارا",23,"ر",2,0],["أَيَجوزُ أَن تَخفى عَلَيكَ قَضِيَّتي","وَالناسُ في مُضَرٍ بِها تَتَكَلَّمُ",24,"م",1,0],["أَيَجوزُ أَن يُمسي السَقيمُ مُبَرَّأً","مِنها وَصِبيانُ المَكاتِبِ تُتهَمُ",24,"م",1,0],["أيُّ جَيشَيك مُغرِقي ليليَ الطا","غِي أم الشوقُ وحده وهو عارم",25,"م",1,0],["أي جلالٍ فاته وصفه","وأي حسن فيه لم يرسم",26,"م",1,0],["أَيَجني عَلى مُهجَتي طَرفُهُ","وَيُخضَبُ مِن دَمِها كَفُّهُ",27,"ف",2,1],["أيْجمُلُ أن نَذِلَّ وأن نَضِيعا","ونُطعِمَ لَحمنا القومَ الجِياعا",28,"ع",2,0],["أَيَجُوزُ قَوْلُ مَنَزِّهٍ لإِلههِ","سبحانَ قاتِلِ نَفْسِهِ فأَقُولا",29,"ل",2,0],["أَيَجلو الشَمسَ لِلرائي نَهارٌ","فَقَد شَرَقَت وَمَشرِقُها مُضِبُّ",30,"ب",1,0],["أيُّ جَديدٍ لكَ لم تُبْلِهِ","وأيُّ أقرانِكَ لم تُرْدِهِ",31,"د",2,0],["أيُّ جوادٍ قد كبا","وأيُّ سيفٍ قد نبا",32,"ب",2,1],["أيُجحد في الشرق النبوغُ ويُزدرى","ويشقى بمصر النابهونَ الغطارفُ",33,"ف",1,0],["أَيَجْمُلُ بِالْعَهْدِ أَنْ يُسْتَبَاحَ","لِوَاشٍ وَلِلْوُدِّ أَنْ يُقْطَعَا",34,"ع",2,0],["أَيُّ جَاٍٍ سَمَا إِلَيْهِ فَأَجْرَى","دَمَهُ الحُرَّ تَبَّ أَهْلُ الشِّقَاقِ",35,"ق",1,0],["أَيُّ جَيشٍ يُدَرِّبُونَ لِمِصْرٍ","وَوَلِيُّ التَّدْرِيبِ فِيهِ العَادِي",36,"د",2,0],["ايجمل نقض العهد والود حفظه","من الدين اذ في حفظه جاءنا الامر",37,"ر",1,0],["أيجحد من جلالتك السناء","وانت لعمتة الدنيا ضياء",38,"ا",2,1],["أَيَجوزُ ذاكَ وَقَد أَضاقَ مَذاهِبي","عَن مُلكِهِ مَلِكٌ أَنالَ فَأَوسَعا",39,"ع",2,0],["أَيُجحَدُ ما توليهِ آلاءُ مُنعِمٍ","إِذا جارَ صَرفُ الدَهرِ كانَ لَهُ صَرفا",40,"ف",2,0],["أيَجحَدُ فَضلَهُ عقلٌ سليمٌ","وقد نطقت بسؤدده الحمام",41,"م",1,0],["أَيَجمُلُ أَن أُجفى وَأُنفى وَعِندَكُم","لِمَن لَيسَ مِثلي عِيشَةٌ وَمُقامُ",42,"م",1,0],["أيجلوكَ يا عضبَ الشبا ما هذت بهِ","وقبلكَ ما ضرَِّ النبيُّ هريرها",43,"ر",3,0],["أَيَجزَعُ كَعبٌ لِأَشياعِهِ","وَيَبكي مِنَ الزَمَنِ الأَعوَجِ",44,"ج",1,1],["أيجمل عيد أنت فيه مخاصمي","مخاصمة العين الكحيلة للبدر",45,"ر",1,0],["أَيُّ جَمرٍ أَحَرُّ من جَمرِ حُبٍّ","صادَفَ القَلبَ مَوقِداً فَاِستَقَرّا",46,"ر",2,0],["أَي جَمال النِساءِ أوليتَ حُكماً","فَاِحتَكِم ما تَشاءُ في الضّعفاءِ",47,"ا",2,0],["أَيَجمُلُ أن تُنعى الفَضائلُ لِلوَرى","وَلم تكُ في الباكينَ وَيحكَ باكِيا",48,"ي",2,0],["أَيَجوزُ أَن أَغشى حِماكَ فَأَنثَني","صِفراً يَدي وَيَداكَ مَلأى بِالثَنا",49,"ن",2,0],["أي جفنٍ أجريتَ منهُ دموعاً","كان لولاكَ في السماكين بُعدا",50,"د",2,0],["أيجرؤُ ذِئبٌ أن يدوس برجلِهِ","بلاداً بعباس الأمير تسودُ",51,"د",1,0],["أيجرؤُ ذِئبٌ أن يدوس برجلِهِ","عريناً وفي ذاكَ العرينِ أسودُ",52,"د",1,0],["أيَجُوزُ أنْ يُرْتَابَ في إظْهَارِه","ولهُ المَلائِكُ والمُلوكُ ظَهيرُ",53,"ر",1,0],["أَيَجْمُلُ بِيَ الْعَزاءُ وَأَنْتَ ثاوٍ","أَيَحْسُنُ بِي الْبَقاءُ وَأَنْتَ فانِ",54,"ن",1,0],["أَيَجُوزُ فِي حُكْمِ الْمُرُؤَةِ أَنْ","أَظْما وَدُونَ سَماحِكَ الْبَحْرُ",55,"ر",1,0],["أَيَجوزُ حَجُّهُمُ وَما مِن لَحظَةٍ","إِلّا بِها مِنهُنَّ يُقتَلُ مُسلِمُ",56,"م",1,0],["أَيَجودُ مَولانا عَلِيٌّ بِنَعمَةٍ","مِن فَضلِهِ مَحضاً وَلَستَ مُؤَمَّلا",57,"ل",2,1],["أَيُّ جَهلٍ يَكونُ أَبَين مِن جَه","لٍ أَراني أُضحي عَلَيهِ وَأُمسي",58,"ي",1,1],["إيجابُ وَجدي فيهِ سالِبُ سَلوَتي","عَنهُ لِأَنّي مِنهُ أَيسَرُ مِنِّهِ",59,"ن",2,0],["أَيّ جاه مِثل جاه المُصطَفى","معدن المَعروف كَنز الحسب",60,"ب",1,0],["أيجوز أن يغدو أسيراً بعدها","ويقاد بالتقليد كالعميان",61,"ن",1,0],["أيجوز أن أعطى الحصى عوضاً","مني على عِقْدٍ من الدُّر",62,"ر",1,0],["أيجهل مثلي منصب الحق بعدما","عرفت يقيناً ما حوى كل دفتر",63,"ر",1,0],["أيجوز بين المسلمين بقاؤهم","أبداً فأين دليل ذا والشاهد",64,"د",1,0],["أَيَجوز أَن أَشكو إِضاقَة عيشة","وَالمال عندك واهِن وَالجاهُ",65,"ا",2,0],["أيجهل الأَمر على علمٍ به","والجهل بالعاقل عَيبٌ فاضح",66,"ح",1,0],["أيّ جمع هذا وأيّ اتِّفاق","وصحابٍ أماجد ورفاق",67,"ق",1,1],["أيجوز ان أشكو اللغوب وقد غدا","يحكي رضاب الثغر طعم الكوثر",68,"ر",1,0],["أيجورُ الزمانُ يا ثِقةَ المُلْ","كِ وأنت الكفيلُ لي بالنجاحِ",69,"ح",1,1],["أيجوز أن تنحوا مقالة من","ضلوا بما قالوه بل أفكوا",70,"ك",3,0],["أيجوز لي خوض الخضمّ وأنثني","عن مائه متيمّما بصعيد",71,"د",1,0],["أيجيء موعده بسخر جائر","ويكون مولده الأغر ظلاما",72,"م",2,0],["أيُّ جمالٍ زِنتني اليومَ به","زانك بين الناس من مدحي غدا",73,"ا",1,0],["أيُّ جسومٍ ولا نفوسَ بها","أيُّ حنايا ولا تماثيل",74,"ل",1,0],["ايُّ جواد فكري وايّ مدى","يفوت طرفي والطِرفَ في الطّوَل",75,"ل",1,0],["أيجزع مقتول ويأمن قاتل","ويخضع مظلوم ويشمخ ظالم",76,"م",1,0],["أيجمل بالشبيبة وهي أم","لهم أن يتركوها في اضطهاد",77,"د",1,0],["أيُجزَى الناسُ باسم الل","هِ والميزان لم يُنصب؟!",78,"ب",1,0],["أيجدب خدي من ربيع مدامعي","وربعي من نعمى يديه خصيب",79,"ب",1,0],["أَيَجتَمِعُ البَحرانِ إِلّا إِذا رَسا","سَفينٌ مُدنّاتٌ إِلَيهِ قَوارِبُه",80,"ب",2,0],["أَيَجْمُلُ سُلْوانِي إِذَا هَجرَ الحِبُّ","أَمِ الصَّبْرُ أَوْلَى بِي إِذَا وَلَّه الحُبُّ",81,"ب",1,1]]}