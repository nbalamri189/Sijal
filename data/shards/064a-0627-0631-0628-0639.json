gate.com/ViewPoem.aspx?id=193404",""],[5956,"ما جاء لي من أي ضَوءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193825",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6093,"بِكَ لا بغيرِكَ تَنْجَحُ الآمَالُ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181650",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[6125,"عَيْنِي مسهَّدةٌ وقَلْبِي واجِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=210913",""],[6125,"يا ربّ عونك فالأيَّامُ تخذلني","https://www.poetsgate.com/ViewPoem.aspx?id=210974",""],[6152,"يا رب عونك","https://www.poetsgate.com/ViewPoem.aspx?id=203736",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""]],"verses":[["يَا رّبِّ عَفَوْكَ حَتَّى المَاءَ يُعْزِزُهُمْ","فَمُرْ تَجُدْهَمْ بِنَقْعِ الغُلَّةِ الدِّيَمِ",0,"م",1,0],["يا رُبُّ عائِذَةٍ بِالغَورِ لَو شَهِدَت","عَزَّت عَلَيها بِدَيرِ اللُجِّ شَكوانا",1,"ن",2,0],["يا رُب عبدٍ مَالِكٍ سيِّداً","وإن غدا في رِبْقَةِ العبْدِ",2,"د",1,1],["يا رُبّ عُرفٍ أتاه ما طلب ال","حمدَ بإتيانه ولا خَسِره",3,"ر",2,0],["يا رب عهد ووعد من ذوي كرم","يستهلكان ويبقى الغدر والخُلُف",4,"ف",1,0],["يا رَبِّ عَجِّل لَها بِتَوبَتِها","وَاِغسِل بِماءِ التُقى خَطاياها",5,"ا",3,0],["يا رَبُّ عَن إِساءَتي","يا سَيِّدي ما أَحمَلَك",6,"ك",1,0],["يا رَبّ عَجّل جَمعَ هَذا بِذا","وَقَرّب الشَكلَ إِلى شَكلِهِ",7,"ل",2,0],["يا رُبَّ عَينٍ لِلشَرِّ جالِبَةٍ","فَتِلكَ عَينٌ تَشقى بِما جَلَبَت",8,"ت",1,0],["يا رُبَّ عَيشٍ كانَ يُغبَطُ أَهلُهُ","بِنَعيمِهِ قَد قيلَ كانَ فَزالا",9,"ل",2,0],["يا ربِّ عفوكَ قد عبدتُكَ مشركاً","شِركاً تضيقُ بإثمه الرحماتُ",10,"ت",1,1],["يا رَبعُ لَو رَبَعوا عَلى اِبنِ هُمومِ","مُستَسلِمٍ لِجَوى الفِراقِ سَقيمِ",11,"م",1,1],["يا رَبِّ عافِ الوَزيرَ وَاِصرِف","بي عَنهُ مَكروهَ كُلِّ صَرفِ",12,"ف",1,1],["يا رَبِّ عَجِّل مِمّا تَرى فَرَجي","وَاِقضِ لِكَربي مِنهُ بِتَنفيسِ",13,"س",1,0],["يا رَبعُ وَاِستَبدَلتَ بَعدَهُمُ","وَسَكَنتَ بَعدَهُمُ إِلى سَكَنِ",14,"ن",1,0],["يا رُبَّ عَوراءَ ذي قُربى كَتَمتُ وَلَو","فَشَت لَأَلقَت عَلى الأَعناقِ أَطواقا",15,"ق",2,0],["يا رَبعُ شُغلَكَ إِنّي عَنكَ في شُغُلِ","لا ناقَتي فيكَ لَو تَدري وَلا جَمَلي",16,"ل",2,1],["يا رَبِّ عيشَةُ ذي الضَلالِ خَسارُ","أَطلِق أَسيرَكَ فَالحَياةُ إِسارُ",17,"ر",1,1],["يا رب عونك فالذئاب تلوح لي","مثل اللصوص وَفي الأكف حراب",18,"ب",1,0],["يا ربِّ عفْواً فأَنْتَ موْلىً","قَصَّر في أَمْرِكَ العبيدُ",19,"د",1,0],["يا رَبعُ أَينَ تَوَجَّهَت سَلمى","أَمضَت فَمُهجَةَ نَفسِهِ أَمضى",20,"ض",2,1],["يا رب عصر مضى لا النيل مُرْتَجزٌ","ولا تحس خريرَ النيل آذان",21,"ن",1,0],["يا رُبّ عَينٍ للشّرّ جالِبَة ٍ،","فتلْكَ عينٌ تُجلَى بِمَا جَلَبَتْ",22,"ت",1,0],["يا ربّ عفوك قد ثملت فخلّني","لغوايتي وتهتّكي وشرابي",23,"ب",2,0],["يا ربّ علّمها المسير إلى الردى","بسبيل عزّتها ونيل مرامها",24,"م",3,0],["يا ربع كَم لَكَ مِن شَجيّ هالك","مغرى بِجؤذرك المَصون الهاتك",25,"ك",1,1],["يَا ربِّ عَجِّل شفائى دُونَمَا تَعَبٍ","على مُرَادِى واسعَا في وإسعَادِى",26,"د",2,1],["يا رَبعَ أَندَرَشٍ سَقاكَ مِن شَجَني","دَرٌّ يُمَرِّحُ عِندَ السَّكبِ بِالدُّرَرِ",27,"ر",1,0],["يا ربِّ عبد قد دعاك معولاً","فاحسن لديك بدوه والمنقلب",28,"ب",1,0],["يارب عفوك واسع شمل الورى","ما ضاق فضلك عن فتى حاشاه",29,"ا",2,0],["يا رب عبدك هارب من ذنبه","داع وقد مدت إليك يداه",29,"ا",2,0],["يا رب علم لو أبوح بجوهر","منه لقالوا عابد الاوثان",30,"ن",1,0],["يا رب عفوك عن شيخ وذي حنف","قد أدبتهُ صروف الدهر بالتلف",31,"ف",1,1],["يا رب عفواً فإني خائف وجل","وليس لي صالح يرجى لا عمل",32,"ل",1,1],["يَا رَبِّ عَجِّلْ عَلَى مَنْ سَامَ عِشْرَتَنَا","بَخْساً بِدَاهِيَةٍ تَطْغَى دَيَاجِيهَا",33,"ي",3,0],["يا رب عرفه رضواناً ومغفرةً","يا رب الحفه من استبرقٍ لحفا",34,"ف",2,0],["يا رب عبدك ببابك","يخشي أليم عذابك",35,"ك",1,0],["يا رَبِّ عَبدُكَ في الآثامِ قَد بَرَعَت","أَيدي هَواهُ وَمَحضِ العَفوِ طِلبَتُهُ",36,"ت",2,0],["يا ربع قلبي ذاب في آلامه","فغدوت لا قلباً غدوت قلوبا",37,"ب",2,0],["يا رَبّ عامِلنا بِما أَنتَ لَه","أَهلٌ وَجُد بِالعَفو وَاِستُر ما مَضى",38,"ا",1,0],["يا رَبعُ ما أَنتَ إِذ زُمَّت رِحالُهُمُ","لِلبَينِ أَوَّلُ صَبٍّ أَلبَسوهُ بِلى",39,"ل",2,0],["يا رَبِّ عُدني عِندَ مَوتي إنَّني","سَوءٌ وعِدني بَعدَها العَلياءَ",40,"ا",2,0],["يا رب عبدك قسا قلبه وفعله فسد","وضاع وقته وهو حائر كثير النكد",41,"د",1,0],["يا رب عجل بغارة منك من غير يد","في الحال في الحال يا مولاي فالصبر قد",41,"د",1,0],["يا رب عمري تقضي في الريا والكذب","وكسب الآثام فادركني الهي بطب",42,"ب",1,0],["يا رب عفواً فالذنوب عظيمة","والخطب أعظم في القلوب سواهي",43,"ي",1,0],["يا رب عجل بالنجاة وأعطني","أجراً أفوز به غداً في الناس",44,"س",1,0],["يا رب عجل غارة تشفي الجوى","بجنود عفو للذنوب تريح",45,"ح",1,0],["يا رب عَلاَّمَ كلِ خفية","ما الجهر ما الأسرار ما التصريح",45,"ح",1,0],["يا رب عفوا من مسيء","خائف ما كان منه",46,"ه",1,1],["يا ربع بلّ لك الأوام متيَّمٌ","إنْ جَفَّ ناظره بماءِ فؤاده",47,"د",2,0],["يا رُبَّ عزمٍ بالدنا جرَّدتُه","كأنَّه حدّ الحسام المنتضى",48,"ا",1,0],["يا رب عفواً فإني","غريق أثام فكري",49,"ر",2,1],["يا رب عفواً وإحساناً ونيل مني","وبعده في جنان الخلد تخليد",50,"د",1,0],["يا رب عفوك إنني بك واثق","من هول ذاك اليوم أي الواثق",51,"ق",1,0],["يا رب عفوك إني قد وقفت على","باب الرجا ويدي ممدودةً بوعا",52,"ع",2,0],["يا رب عفوك إن عفوك واسعٌ","إن الكريم لمن دعاه سميع",53,"ع",1,0],["يا رب عفوك إنني","قد تبت من آصاريه",54,"ي",2,0],["يا رب عفوك أَجري غير منسمح","إِلا بلطفك يغدو الأَمر منسمحا",55,"ح",2,0],["يا رب عفوك إني منك في ثقة","ليس اتكالي على فعلي ولا ديني",56,"ن",2,0],["يا ربعُ قد كنتَ لي قبلَ النوى وطناً","بلغتُ فيكَ على رغمِ العِدى وَطَرا",57,"ر",2,0],["يا رُبَّ عَرجَلَةٍ أَصابوا خَلَّةً","دَأَبوا وَحارَ دَليلُهُم حَتّى بَكى",58,"ا",1,0],["يا رَبِّ عَجِّل لَنَا الرُّجوعَ إلى ال","أَوْطانِ فالقَلْبُ نَحْوَها نَزَعا",59,"ع",2,0],["يا رب عجل بجاه المصطفى فرجي","وسهل الامر وانقذني من الغمم",60,"م",1,0],["يا رب عبد قد بسط","كف التوسل إذ سقط",61,"ط",1,1],["يا ربِّ عبدُكَ يرجُو العَفْوَ منتصِباً","ببابكَ الواسِعِ المَيمونِ طائرُهُ",62,"ه",1,1],["يا رُبَّ عَطَّارٍ بِسُكَّرِ ثَغْرِهِ","سَكِرَ المُحِبُّ وَلَمْ يَفِقْ مِنْ سُكْرِهِ",63,"ه",1,1],["ي