{"poems":[[53,"يا غائبا نقض الودادا","https://www.aldiwan.net/poem30597.html","مجزوء الكامل"],[100,"وحدة الشاعر","https://www.aldiwan.net/poem24839.html","عموديه"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[88,"من مبسم الغازي إلى الفاروق","https://www.aldiwan.net/poem44800.html","الكامل"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[51,"يا وهب يا صاحب البريد ألا تكتب","https://www.aldiwan.net/poem9231.html","المنسرح"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[58,"يا عمرو ويحك قد أتاك","https://www.aldiwan.net/poem31001.html","مجزوء الكامل"],[49,"الناس في الدين والدنيا ذو درج","https://www.aldiwan.net/poem62020.html","البسيط"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[49,"النّاسُ في الدين والدّنْيا، ذوُو درَجِ،","https://www.poetsgate.com/ViewPoem.aspx?id=16973",""],[51,"صَبْحة َ النَّوْرُوز في الأحدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27680",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[85,"اخترتَ يومَ الهولِ يومَ وداعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9609&r=&rc=99",""],[136,"للعلم في عصر الضياء شروق","https://www.aldiwan.net/poem49040.html","الكامل"],[161,"هموا بحرب ومناهم به الحلم","https://www.aldiwan.net/poem58920.html","البسيط"],[165,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[211,"لواحظ تشهر بيض الصفاح","https://www.aldiwan.net/poem13460.html","السريع"],[233,"قلب رسيس هواك في سودائه","https://www.aldiwan.net/poem14725.html","الكامل"],[238,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[271,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[283,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[283,"من منصفي من غزال الترك ذي الدعج","https://www.aldiwan.net/poem32835.html","البسيط"],[298,"أما الصبوح فإنه فرض","https://www.aldiwan.net/poem33232.html","أحذ الكامل"],[299,"من ضاق ذرعا بالبلية فليزر","https://www.aldiwan.net/poem36253.html","عموديه"],[304,"من ضاع منه وفاكم","https://www.aldiwan.net/poem58219.html","المجتث"],[329,"واقع أروع من نسج الخيال","https://www.aldiwan.net/poem55008.html","الرمل"],[365,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[367,"أنا منك بين مراتع","https://www.aldiwan.net/poem17296.html","مجزوء الكامل"],[378,"ما بين جفني والأحبة برزخ","https://www.aldiwan.net/poem66880.html","الكامل"],[378,"من لي بقلب أستميحه","https://www.aldiwan.net/poem66886.html","مجزوء الكامل"],[454,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[459,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[530,"ما للطعام وللثياب أتيته","https://www.aldiwan.net/poem37126.html","الكامل"],[563,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"]],"verses":[["مَن ضاعَ مِثلي مِن يَدَي","هِ فَلَيتَ شِعري ما اِستَفادا",0,"د",2,0],["من ضراعات المساكين ومن","خيلاء المستبد القاهر",1,"ر",1,0],["مِن ضَيغَمٍ مِن ضِراءَ الأُسدِ مُخدِرَةً","بِبَطنِ عَثَّرَ غيلٌ دونَهُ غيلُ",2,"ل",1,0],["مَنضورَةَ الجَنّاتِ حالِيَةَ الرُبا","مَطلولَةَ السَرَحاتِ وَالأَرواحِ",3,"ح",1,0],["مِن ضَميري بِلَوعَةِ الحُزنِ حَتّى","نَكَأَ الحُزنُ في فُؤادي فِقاحا",4,"ح",2,0],["من ضئضئ العرب الكرام زكا لكم","نسب يروق بمجده المَنسوق",5,"ق",1,0],["من ضراب تشبّ من وقعةِ النا","رُ وتطفي حرارةُ الشحناء",6,"ا",2,0],["من ضرطةٍ خانك الحِتارُ بها","فمعَّرَتْ وَيْبَها فَتىً دَمِثا",7,"ث",2,0],["من ضعيفِ الركنِ لكنْ","لحظُ عينيهِ سهامُ",8,"م",1,0],["من ضنَّ عنِّي ببذلِ نائلهِ","ضنَنتُ عنه ببذلِ أيامي",9,"م",2,0],["مَن ضاقَ بِالدُنيا فَلَيسَ حَكيمَها","إِنَّ الحَكيمَ بِها رَحيبُ الباعِ",10,"ع",1,0],["مِن ضَحاياهُ وَما أَكثَرَها","ذَلِكَ الكارِهُ في غَضِّ العُمُر",11,"ر",1,0],["مِن ضَربَةٍ نَجلاءَ يَب","قى صِيتُها عِندَ الهَزاهِزِ",12,"ز",1,0],["مَن ضاقَ عَنكَ فَأَرضُ اللَهِ واسِعَةٌ","في وَجهِ كُلِّ مَضيقٍ وَجهُ مُنفَرِجِ",13,"ج",1,0],["من ضحكة السَّحَرِ المشبوب ضحكتُنا","ومن رفيفِ الصِّبا فيه أغانينا",14,"ن",2,0],["من ضَلَّ فيه فمالَهُ من عاذرٍ","والمرءُ يَخبِطُ في الظّلامِ فَيُعْذَرُ",15,"ر",1,0],["مُنضَجٍ غَيرِ مُعجَلٍ وَهوَ إِن أُم","كِنَ في فُرصَةٍ سَريعُ الوُثوبِ",16,"ب",1,0],["من ضل عنه ماله","وقضى بنوه فما بقاؤه؟",17,"ا",3,0],["مَنْ ضاقَ عنكَ، فأرْضُ الله واسِعة ٌ،","في كلّ وَجْهِ مَضِيقٍ وَجْهُ مُنفَرَج",18,"ج",1,0],["من ضباء غير نافرة ٍ","غاية ٍ في الحسن والغَيَد",19,"د",1,0],["منضمة الشفاه .. لا تفصحي","أريدُ أن أبقى بوهمِ الفمٍ",20,"م",1,0],["مَنْ ضَاقَ بالدنيا فليس حكيمَها","إتّ الحكيمَ بها رحيبُ الباع",21,"ع",1,0],["من ضمه نسب الكرام فإنهُ","لاريب في الشرف الأثيل عريقُ",22,"ق",1,0],["من ضيع الحزم والأسباب في يده","لم يجده الحزم شيئا حين تنصرم",23,"م",1,0],["مَن ضَيَّعَ الحَزمَ جَنى لِنَفسِهِ","نَدامَةً أَلذَعَ مِن سَفع الذكا",24,"ا",1,0],["من ضاء صبح الجود منه وقد","نادى مناديه الفلاح الفلاح",25,"ح",1,0],["مَن ضامِنٌ لي أن أَفوزَ بِنَظرَةٍ","مِن شَربَةٍ أَو نَهلَةٍ مِن مائِهِ",26,"ا",3,0],["مَنْ ضَلَّ عَنْ أَعْلامِهِ","لمْ يَدْرِ كَيْفَ اللهً يُعْبَدْ",27,"د",1,0],["من ضعفِنا قد أخَذتم كلَّ قوَّتِكم","وما أقمتم على عهدٍ ولا ذمم",28,"م",1,0],["مِن ضيقِ أَجفانِهِ سُبلُ الهَوى اِتَّسَعَت","عَلَيَّ ما حيلَتي وا حَيرَتي فيها",29,"ي",3,0],["مِن ضيقِ أَجفانِهِ سُبل الهَوى اِتَّسَعَت","فَما عَلى عاشِقيهِ فيهِ مِن حَرَجِ",30,"ج",1,0],["مَن ضمَّهُ فَتحَ السُرورُ له","باباً وَكانَ لعيشِه الخَفضُ",31,"ض",1,0],["من ضاق ذرعاً بالبلية فليزرْ","هذا الضريح يهنْ عليه بلاؤه",32,"ا",3,1],["من ضاع منه وفاكم","وحال عنكم وحادا",33,"د",2,1],["من ضِفافِ الرين طارت شُعلة","شبّها الفُهرَرُ حمراءُ الظلال",34,"ل",1,0],["من ضاربٍ كُرَةً ينُزِّقُها","في مَلْعبٍ أو رائضٍ مُهرا",35,"ر",2,0],["مَنضورَةً في حُسنِها","وَالنَضرُ يُعرَفُ في اليَمَنْ",36,"ن",1,0],["من ضاقت السبع السموات العلا","عنه ومريم فيه أرضٌ سَربَخ",37,"خ",1,0],["من ضل أنت هداؤه","حقّاً وأنت له نصيحه",38,"ح",2,0],["من ضروبِ اللهَّوِ الغريبِ ولو أنَّ","الُمجِّلى من بينهم بهلوانث",39,"ن",2,0],["من ضامنات الحاج لو دانيتَها","بالنجم لم تُلْوَ به ولم تُلطْ",40,"ط",1,0],["مَنْ ضاقَتِ الدُّنْيا عَلَيْهِ بأسْرِها","هانَتْ عَلَيْهِ مَصائِبُ الأدْيانِ",41,"ن",1,0],["مَن ضاعَ أكثرُ شِعرِهِ في باطلٍ","فكأنما قد ضاعَ أكثرُ عُمرِهِ",42,"ر",2,0]]}