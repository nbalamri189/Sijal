,""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[6160,"على نَوافِذِ الغَيبِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87103&r=&rc=20",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""]],"verses":[["مَن ضاعَ مِثلي مِن يَدَي","هِ فَلَيتَ شِعري ما اِستَفادا",0,"د",2,0],["من ضراعات المساكين ومن","خيلاء المستبد القاهر",1,"ر",1,0],["مِن ضَيغَمٍ مِن ضِراءَ الأُسدِ مُخدِرَةً","بِبَطنِ عَثَّرَ غيلٌ دونَهُ غيلُ",2,"ل",1,0],["مَنضورَةَ الجَنّاتِ حالِيَةَ الرُبا","مَطلولَةَ السَرَحاتِ وَالأَرواحِ",3,"ح",1,0],["مِن ضَميري بِلَوعَةِ الحُزنِ حَتّى","نَكَأَ الحُزنُ في فُؤادي فِقاحا",4,"ح",2,0],["من ضئضئ العرب الكرام زكا لكم","نسب يروق بمجده المَنسوق",5,"ق",1,0],["من ضراب تشبّ من وقعةِ النا","رُ وتطفي حرارةُ الشحناء",6,"ا",2,0],["من ضرطةٍ خانك الحِتارُ بها","فمعَّرَتْ وَيْبَها فَتىً دَمِثا",7,"ث",2,0],["من ضعيفِ الركنِ لكنْ","لحظُ عينيهِ سهامُ",8,"م",1,0],["من ضنَّ عنِّي ببذلِ نائلهِ","ضنَنتُ عنه ببذلِ أيامي",9,"م",2,0],["مَن ضاقَ بِالدُنيا فَلَيسَ حَكيمَها","إِنَّ الحَكيمَ بِها رَحيبُ الباعِ",10,"ع",1,0],["مِن ضَحاياهُ وَما أَكثَرَها","ذَلِكَ الكارِهُ في غَضِّ العُمُر",11,"ر",1,0],["مِن ضَربَةٍ نَجلاءَ يَب","قى صِيتُها عِندَ الهَزاهِزِ",12,"ز",1,0],["مَن ضاقَ عَنكَ فَأَرضُ اللَهِ واسِعَةٌ","في وَجهِ كُلِّ مَضيقٍ وَجهُ مُنفَرِجِ",13,"ج",1,0],["من ضحكة السَّحَرِ المشبوب ضحكتُنا","ومن رفيفِ الصِّبا فيه أغانينا",14,"ن",2,0],["من ضَلَّ فيه فمالَهُ من عاذرٍ","والمرءُ يَخبِطُ في الظّلامِ فَيُعْذَرُ",15,"ر",1,0],["مُنضَجٍ غَيرِ مُعجَلٍ وَهوَ إِن أُم","كِنَ في فُرصَةٍ سَريعُ الوُثوبِ",16,"ب",1,0],["من ضل عنه ماله","وقضى بنوه فما بقاؤه؟",17,"ا",3,0],["مَنْ ضاقَ عنكَ، فأرْضُ الله واسِعة ٌ،","في كلّ وَجْهِ مَضِيقٍ وَجْهُ مُنفَرَج",18,"ج",1,0],["من ضباء غير نافرة ٍ","غاية ٍ في الحسن والغَيَد",19,"د",1,0],["منضمة الشفاه .. لا تفصحي","أريدُ أن أبقى بوهمِ الفمٍ",20,"م",1,0],["مَنْ ضَاقَ بالدنيا فليس حكيمَها","إتّ الحكيمَ بها رحيبُ الباع",21,"ع",1,0],["من ضمه نسب الكرام فإنهُ","لاريب في الشرف الأثيل عريقُ",22,"ق",1,0],["من ضيع الحزم والأسباب في يده","لم يجده الحزم شيئا حين تنصرم",23,"م",1,0],["مَن ضَيَّعَ الحَزمَ جَنى لِنَفسِهِ","نَدامَةً أَلذَعَ مِن سَفع الذكا",24,"ا",1,0],["من ضاء صبح الجود منه وقد","نادى مناديه الفلاح الفلاح",25,"ح",1,0],["مَن ضامِنٌ لي أن أَفوزَ بِنَظرَةٍ","مِن شَربَةٍ أَو نَهلَةٍ مِن مائِهِ",26,"ا",3,0],["مَنْ ضَلَّ عَنْ أَعْلامِهِ","لمْ يَدْرِ كَيْفَ اللهً يُعْبَدْ",27,"د",1,0],["من ضعفِنا قد أخَذتم كلَّ قوَّتِكم","وما أقمتم على عهدٍ ولا ذمم",28,"م",1,0],["مِن ضيقِ أَجفانِهِ سُبلُ الهَوى اِتَّسَعَت","عَلَيَّ ما حيلَتي وا حَيرَتي فيها",29,"ي",3,0],["مِن ضيقِ أَجفانِهِ سُبل الهَوى اِتَّسَعَت","فَما عَلى عاشِقيهِ فيهِ مِن حَرَجِ",30,"ج",1,0],["مَن ضمَّهُ فَتحَ السُرورُ له","باباً وَكانَ لعيشِه الخَفضُ",31,"ض",1,0],["من ضاق ذرعاً بالبلية فليزرْ","هذا الضريح يهنْ عليه بلاؤه",32,"ا",3,1],["من ضاع منه وفاكم","وحال عنكم وحادا",33,"د",2,1],["من ضِفافِ الرين طارت شُعلة","شبّها الفُهرَرُ حمراءُ الظلال",34,"ل",1,0],["من ضاربٍ كُرَةً ينُزِّقُها","في مَلْعبٍ أو رائضٍ مُهرا",35,"ر",2,0],["مَنضورَةً في حُسنِها","وَالنَضرُ يُعرَفُ في اليَمَنْ",36,"ن",1,0],["من ضاقت السبع السموات العلا","عنه ومريم فيه أرضٌ سَربَخ",37,"خ",1,0],["من ضل أنت هداؤه","حقّاً وأنت له نصيحه",38,"ح",2,0],["من ضروبِ اللهَّوِ الغريبِ ولو أنَّ","الُمجِّلى من بينهم بهلوانث",39,"ن",2,0],["من ضامنات الحاج لو دانيتَها","بالنجم لم تُلْوَ به ولم تُلطْ",40,"ط",1,0],["مَنْ ضاقَتِ الدُّنْيا عَلَيْهِ بأسْرِها","هانَتْ عَلَيْهِ مَصائِبُ الأدْيانِ",41,"ن",1,0],["مَن ضاعَ أكثرُ شِعرِهِ في باطلٍ","فكأنما قد ضاعَ أكثرُ عُمرِهِ",42,"ر",2,0],["من ضلال كلما ملتم إليهْ","صرتم من ضعفكم طوع يديهْ",43,"ه",1,0],["منضم ورد الخد أول ما","يبدو فإن جمشته انفتحا",44,"ح",2,0],["مَنْ ضربةُ السيفِ حين تَضْرِبُهُ","في وَجْهِهِ غَرْزُ إِبرةٍ تُغْرَز",45,"ز",1,0],["مِن ضَربِ سَيفٍ وَمِن رَمي السّهامِ ومِنْ","طَعنِ الرِّماحِ مِنَ العَسَّالَة الذّبُلِ",46,"ل",1,0],["من ضم للمجد الأثيل معالياً","قعساء غرّاً نالها من ذاته",47,"ت",2,0],["من ضلهم حرم يلجى لجانبه","إذا الرعية لاقت شدة وجفا",48,"ف",2,0],["مَنْ ضَلَّ عن عِلْمِهِ بخالقِهِ","رآهُ فيها يَقولُ سُبحاني",49,"ن",2,0],["مَن ضَيع الجداء","لَم يخلص الوَلاء",50,"ا",2,0],["من ضحت الجن لهول بأسه","فالبشر الضعيف أدنى للردى",51,"ا",1,0],["مِنْ ضِئْضِىءِ الخَزْرَجِ الغُرِّ الَّذِينَ هُمُ","مَا هُمْ إِذَا مَا دَعَا لِلحَرْبِ دَاعِيهَا",52,"ي",3,0],["مِنْ ضِئْضِىءِ الأَنْصَارِ أَكْرَمِ أُسْرَةٍ","نَصَرُوا النَّبِيَّ فَفُضِّلُوا تَفْضِيلاَ",53,"ل",2,0],["مِنْ ضِئْضِىءِ الْمَجْدِ الذي طُلاَّبُهُ","دَرَجُوا وَطِيبُ ثَنَائِهِمْ لَمْ يُدْرَجِ",54,"ج",1,0],["مَن ضَيَّعَ السٍرَّ يَوماً أَو أَشادَ بِهِ","فَقَد مَنَعتُ مِن الواشينَ أَسراري",55,"ر",2,0],["مِن ضربِ تسع وتسعين مُحكّكة","مثل المَصابيحِ في الظلماء تأتلقُ",56,"ق",1,0],["من ضحاه عندما تلقي على","نهره الصافي خيوطاً كالحرير",57,"ر",1,0],["من ضيا نور وجه في اخدوده اللهب","كنه البدر مشرق كاسينه ظلام",58,"م",1,0],["من ضدّه كان كل ضدٍّ","فلم يكن ذلك اعتداء",59,"ا",2,0],["من ضمه أعطاه كلَّ مكتم","من علمه كشفاً له في ضمته",60,"ت",2,0],["مَنْ ضَمَّهُمْ شَمْلُ العَباء وأُذهِبُوا","رِجْساً فيال لك من مقامٍ عَالِ",61,"ل",1,0],["من ضيق عيش سعره فيها غلا","يا آمراً بكرامة الأضياف لا",62,"ل",2,0],["من ضيق عينيه لما ان رأى جلدي","اعدى بجفنيه جسم الناحل الدنف",63,"ف",1,0],["من ضمة لقبلة لرشفة","لعضة بها اروي غللي",64,"ل",2,0],["مِن ضئضئي نَظم الزَمان نُجومه","سَمطاً فَأَودَعَها بِذاكَ الجيد",65,"د",1,0],["من ضِئضِئ المَجد الرَفيع وَمَعدن الش","شَرف المَنيع وَنخبة البَيت الصَفي",66,"ف",2,0],["من ضوئه تم بدر العلم مكتملاّ","فما نجوم الهدى إلا زواهره",67,"ر",2,0],["مُنضِياً كَومَ المَطايا","بَينَ سَيرٍ وَاِدِّلاجِ",68,"ج",1,0],["من ضلّ عن طُرقُ الأدب فهو له","بها هُويدي بلا شكّ ولا ريب",69,"ب",1,0],["من ضيّف العُظَما بها","مدحوه لا مدحوا نعاجه",70,"ج",2,0],["من ضاق عنه الحظُّ في","مصر أتى فيرى افتراجه",70,"ج",2,0],["من ضائع الإيمان والأيمان","هذا فلانٌ من علاه باهرُ",71,"ر",1,0],["من ضل في غي وانكر رشده","هو منكر شمس الضحى بجحود",72,"د",1,0],["من ضرب دفك برهان تبين لي","ما لا تبين من طبل ومزمار",73,"ر",1,0],["من ضربة القدح التي في الجدع","وأعطه الرفع الذي في الرفع",74,"ع",1,0],["من ضوء عينيّ ومن صحتي","سدىً ومن وقتي وما أكسب",75,"ب",1,0],["من ضغطهم فبايعوا للمهتدي","فانخلع المعتز يلقى باليد",76,"د",1,0],["من ضئضي المجد الأثيل تفرّعاً","وبدارة العيوق حلاًّ أوّلا",77,"ل",2,0],["مَن ضاقَ ذرعاً وَناداها تبادرهُ","بِالغَوثِ مِمّا أَفاضتهُ أَياديها",78,"ي",3,0],["مِن ضَعيفٍ في نَفسهِ أَيّ ضَعفٍ","يتَزَيا بِمَظهرِ الغلّابِ",79,"ب",1,0],["من ضوئهن البدر قابس","أفدي المراشف واللمى",80,"م",2,0],["من ضوء سناها ونشر عطر شذاها","تعطير رباها وضوء من سكن العين",81,"ن",1,0],["منضَّدةً بدرٍّ من لفاظٍ","تفوق عقود الماس الزخارِف",82,"ف",1,0],["منضدةً شعراً تضيءُ عقودهُ","بجوهر معنى اللفظ كالماس منفوسِ",83,"س",1,0],["من ضلَّ في شَعرهِ يُهدَي بمبسمهِ","وثغرهِ البارقِ الشاري بهِ شاري",84,"ر",2,0],["مَن ضَنَّ بِالعِلمِ عَلى الجُهالِ","أَبخَلُ ممَّن ضَنَّ بِالأمالِ",85,"ل",1,0],["مَن ضَمَّه الشراكُ","فَما لَهُ فَكاكُ",86,"ك",1,0],["من ضيع المال أبدى عيبه وجنى","تمهينه أبداً من كل ممتهن",87,"ن",1,0],["من ضيع الدرس يرى هاذياً","عند اعتبار الناس ما في يديه",88,"ي",2,0],["من ضيع الحزم تصحبه الندامة في","أيامه ويرى ذل المهاوين",89,"ن",1,0],["من ضاق به دار","أو أعطشه نار",90,"ر",1,0],["مِن ضَنى الشوقِ إلفُهُ","وهواهُ يُديمُهُ",91,"م",2,0],["من ضيع العمر في لهو وفي لعب","وغصنه مثمر لم يحظ بالأمل",92,"ل",1,0],["من ضل عن طرق المكارم فليقف","في بابه يبصر هداها المقتفى",93,"ف",2,0],["من ضاع عند الله قط ثوابه","لم تخلف الدنيا عليه بانفع",94,"ع",1,0],["من ضمير الصبر ثد فرغه","حينما أظهر فيه عملا",95,"ل",2,0],["من ضحكة الأجناس كم عانيت","طيب معي وغدر ورا ظهري",96,"ر",2,0],["من ضمنها أنّ الحكومة زمرةٌ","معصومةٌ، رغم المئاسيْ المُنكرَة",97,"ر",2,0],["من ضمنها أن الرئيس مُقدس؛","فرئيسُنا قد صار ربَّ المغفرَة",97,"ر",2,0],["من ضَوعِه تبقى الحياةُ بشَهٰدِها","ونسائمُه تُهدْى يعانقُها البَشَرْ",98,"ر",1,0],["من ضيقةً غطت على #ظلم_بشار","خلت عيوني ،،،ماتفارق سهرها",99,"ر",3,0],["مُنضِّدُ ضادهِ مثل الجُمانِ","من اليمنِ تَسمَّعْنا \"هذيلهْ\"",100,"ل",2,0],["من ضَيَّعَ اللهوَ في بَدْءِ الشباب طَوَى","كشحاً على أسف لم يُغْنِ في العُقَبِ"