{"poems":[[53,"يا غائبا نقض الودادا","https://www.aldiwan.net/poem30597.html","مجزوء الكامل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[88,"من مبسم الغازي إلى الفاروق","https://www.aldiwan.net/poem44800.html","الكامل"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[51,"يا وهب يا صاحب البريد ألا تكتب","https://www.aldiwan.net/poem9231.html","المنسرح"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[58,"يا عمرو ويحك قد أتاك","https://www.aldiwan.net/poem31001.html","مجزوء الكامل"],[49,"الناس في الدين والدنيا ذو درج","https://www.aldiwan.net/poem62020.html","البسيط"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[49,"النّاسُ في الدين والدّنْيا، ذوُو درَجِ،","https://www.poetsgate.com/ViewPoem.aspx?id=16973",""],[51,"صَبْحة َ النَّوْرُوز في الأحدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27680",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[85,"اخترتَ يومَ الهولِ يومَ وداعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9609&r=&rc=99",""]],"verses":[["مَن ضاعَ مِثلي مِن يَدَي","هِ فَلَيتَ شِعري ما اِستَفادا",0,"د",2,0],["مِن ضَيغَمٍ مِن ضِراءَ الأُسدِ مُخدِرَةً","بِبَطنِ عَثَّرَ غيلٌ دونَهُ غيلُ",1,"ل",1,0],["مَنضورَةَ الجَنّاتِ حالِيَةَ الرُبا","مَطلولَةَ السَرَحاتِ وَالأَرواحِ",2,"ح",1,0],["مِن ضَميري بِلَوعَةِ الحُزنِ حَتّى","نَكَأَ الحُزنُ في فُؤادي فِقاحا",3,"ح",2,0],["من ضئضئ العرب الكرام زكا لكم","نسب يروق بمجده المَنسوق",4,"ق",1,0],["من ضراب تشبّ من وقعةِ النا","رُ وتطفي حرارةُ الشحناء",5,"ا",2,0],["من ضرطةٍ خانك الحِتارُ بها","فمعَّرَتْ وَيْبَها فَتىً دَمِثا",6,"ث",2,0],["من ضعيفِ الركنِ لكنْ","لحظُ عينيهِ سهامُ",7,"م",1,0],["من ضنَّ عنِّي ببذلِ نائلهِ","ضنَنتُ عنه ببذلِ أيامي",8,"م",2,0],["مَن ضاقَ بِالدُنيا فَلَيسَ حَكيمَها","إِنَّ الحَكيمَ بِها رَحيبُ الباعِ",9,"ع",1,0],["مِن ضَحاياهُ وَما أَكثَرَها","ذَلِكَ الكارِهُ في غَضِّ العُمُر",10,"ر",1,0],["مِن ضَربَةٍ نَجلاءَ يَب","قى صِيتُها عِندَ الهَزاهِزِ",11,"ز",1,0],["مَن ضاقَ عَنكَ فَأَرضُ اللَهِ واسِعَةٌ","في وَجهِ كُلِّ مَضيقٍ وَجهُ مُنفَرِجِ",12,"ج",1,0],["من ضحكة السَّحَرِ المشبوب ضحكتُنا","ومن رفيفِ الصِّبا فيه أغانينا",13,"ن",2,0],["من ضَلَّ فيه فمالَهُ من عاذرٍ","والمرءُ يَخبِطُ في الظّلامِ فَيُعْذَرُ",14,"ر",1,0],["مُنضَجٍ غَيرِ مُعجَلٍ وَهوَ إِن أُم","كِنَ في فُرصَةٍ سَريعُ الوُثوبِ",15,"ب",1,0],["من ضل عنه ماله","وقضى بنوه فما بقاؤه؟",16,"ا",3,0],["مَنْ ضاقَ عنكَ، فأرْضُ الله واسِعة ٌ،","في كلّ وَجْهِ مَضِيقٍ وَجْهُ مُنفَرَج",17,"ج",1,0],["من ضباء غير نافرة ٍ","غاية ٍ في الحسن والغَيَد",18,"د",1,0],["منضمة الشفاه .. لا تفصحي","أريدُ أن أبقى بوهمِ الفمٍ",19,"م",1,0],["مَنْ ضَاقَ بالدنيا فليس حكيمَها","إتّ الحكيمَ بها رحيبُ الباع",20,"ع",1,0]]}