],[307,"أبياتك الغر التي أبدعتها","https://www.aldiwan.net/poem57727.html","الكامل"],[352,"قطائفك التي رقت جسوما","https://www.aldiwan.net/poem19855.html","الوافر"],[390,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[438,"وطالب حاجة بعيدا","https://www.aldiwan.net/poem26349.html","مخلع البسيط"],[471,"غزال تدلله دله","https://www.aldiwan.net/poem59767.html","المتقارب"],[570,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[709,"","https://poetry.dctabudhabi.ae/diwan/poem/1898","الكامل"],[709,"بكرتْ سمية ُ غدوة ً فتمتعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26324&r=&rc=2",""]],"verses":[["كَغَرّاءَ سَوداءِ المَدامِعِ تَرتَعي","بِحَومَلَ عِطفَي رَملَةٍ وَتَناهِيا",0,"ي",2,0],["كغادة لمعاني الحسن جامعة","تقاسم الحسن عاريها وكاسيها",1,"ي",3,0],["كغوَّاصِ لُجٍّ على فاقةٍ","يحاولُ أسبابَ إثرائِه",2,"ا",3,0],["كَغَمامَةٍ يَجلو عَلَيكَ بَريقُها","في السّرد لمعَ البارقِ المُتَهلِّلِ",3,"ل",1,0],["كَغَرِيٍّ أَجسَدَت رَأَسَهُ","فُرُعٌ بَينَ رِئاسٍ وَحام",4,"م",1,0],["كَغَربَي شَنَّةٍ خَلَقينِ مَجّا","غَريضَ الماءِ مِن خُرَزِ الأَشافي",5,"ف",2,0],["كَغُصنِ الغَضا فَوقَ النَقا نَفَحَت لَهُ","جَنُوبٌ تُكَفّى فَرعَهُ وَهوَ مُشرِفُ",6,"ف",1,0],["كَغَريضِ مَوهِبَةٍ أَطافَ بِمائِها","طَودٌ تَمَنَّعَ أَن تُنالَ لِصابُهُ",7,"ب",2,0],["كَغُرَّةِ الأَزهَرِ المَنسوبِ قَد حُسِرَت","عَنهُ الجِلالُ تِلالاً وَهوَ مُصطَخِمُ",8,"م",1,0],["كَغَزالٍ فاتَهُ","فَرعُ غُصنٍ فَعَطا",9,"ط",2,0],["كَغُرَّةٍ جَلَت عَنِ الشَبابِ","بِكَلبَةٍ سَريعَةِ الوِثابِ",10,"ب",1,0],["كَغابٍ تُحَرِّقُ أَطرافُهُ","عَلى لُجَّةٍ مِن حَديدٍ جَرى",11,"ا",1,0],["كَغُرَّةِ البَدرِ إِذا ال","شَهرُ بَدا مُنَصَّفا",12,"ف",2,0],["كَغادَة ما عَلى وج","هها الجَميل قناع",13,"ع",1,0],["كغابة اللّيث إن مرّ العدوّ بها","رأى الزّماجر والأظفار واللّبدا",14,"د",2,0],["كغيول محنية تصفقها الصبا","زرق كأثواب السماء جمامها",15,"م",3,0],["كغراب ، يرتمي فوق جراده","سقطت وجعى ، تدلّت كالوساده",16,"د",2,1],["كَغُصني بانة بِتنا اِعتِناقاً","مِن الوَرد الجَنيّ عَلى فِراش",17,"ش",1,1],["كغنى سخا يحيى وجود يِمينه","عن أن يُذكَر بالوعود وينشدُ",18,"د",1,0],["كغانيةٍ فارقتْ صبَّها","فأرختْ غليها حدادَ الشعرْ",19,"ر",1,0],["كَغيمٍ خَفيفٍ يَمسح النورُ وَجهَهُ","لِأُولى رِياح اللَيلِ يَنحلُّ في الشَفَق",20,"ق",1,0],["كغصنٍ بلا زهرِ وزهرٍ بلا شذا","فعيشُكَ إن لم تهوَ كيفَ يطيب",21,"ب",1,0],["كَغَماغِمِ الثيرانِ بَينَهُمُ","ضَربٌ تُغَمَّضُ دونَهُ الحَدَقُ",22,"ق",1,0],["كغريقٍ بات يدعو منقذاً","بعدما أَدرك زنديه الونى",23,"ا",1,0],["كغابةٍ كانت الدنيا وهم هَمجٌ","حتّى إذا ولدتْ أنثى لهم وَأدوا",24,"د",3,0],["كغمامةٍ ترخى على ليل الشبا","ب الغض أو صبح المشيب ذيولها",25,"ل",3,0],["كَغْيمٍ رَقَّ لِكِنْ فِيهِ قَطرٌ","غَدَا المَرْعَى الجَدِيبُ بِهِ خَصيبَا",26,"ب",2,0],["كَغُزلانٍ خَذَلنَ بِذاتِ ضالٍ","تَنوشُ الدانِياتِ مِنَ الغُصونِ",27,"ن",1,0],["كَغارِسٍ في الثَّرى نَواةً","لِيَأْكُلَ التَّمْرَ في مُقامِهْ",28,"م",2,0],["كَغُصنَينِ في دَوحَةٍ بَعضُنا","يَمُدُّ عَلى بَعضِنا ظِلَّهُ",29,"ل",2,0],["كَغَزَالَة القَفْرِ السَّنِي","حَةِ عَارَضَتْكِ أو البَريْحَهْ",30,"ح",2,0],["كَغَريضِ سارِيَةٍ أَدَرَّتهُ الصَبا","مِن ماءِ أَسجَرَ طَيِّبِ المُستَنقَعِ",31,"ع",1,0],["كغريضِ سارية ٍ أدارتهُ الصبا","مِنْ ماءِ أَسْجَرَ طَيِّبِ المُسْتَنْقَعِ",32,"ع",1,0]]}