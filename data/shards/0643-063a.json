{"poems":[[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[85,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[61,"حبيب حباك بلينوفر","https://www.aldiwan.net/poem51819.html","المتقارب"],[80,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[40,"أسائل عن وجناء في السجن جارها","https://www.aldiwan.net/poem42282.html","الطويل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[52,"راب دهر وسطا","https://www.aldiwan.net/poem26869.html","مجزوء الرمل"],[52,"قد أغتدي والليل كالغراب","https://www.aldiwan.net/poem27237.html","الرجز"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[48,"نبه نديمي يوسفا","https://www.aldiwan.net/poem64394.html","مجزوء الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[100,"أمسية حجرية","https://www.poetsgate.com/ViewPoem.aspx?id=50362",""],[109,"كغصني بانة بتنا اعتناقا","https://www.aldiwan.net/poem16573.html","الوافر"],[160,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[199,"زهته الملاحة حتى سفر","https://www.aldiwan.net/poem45638.html","المتقارب"],[223,"أيا قبلة مرت على ضفتي في","https://www.aldiwan.net/poem41448.html","الطويل"],[270,"حذار فأحداق الملاح حبوب","https://www.aldiwan.net/poem35457.html","الطويل"],[287,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[298,"ثكلت مقلته طيب الكرى","https://www.aldiwan.net/poem36847.html","عموديه"],[302,"يا صاحب القبة الخضراء","https://www.aldiwan.net/poem65690.html","البسيط"],[303,"أبياتك الغر التي أبدعتها","https://www.aldiwan.net/poem57727.html","الكامل"],[348,"قطائفك التي رقت جسوما","https://www.aldiwan.net/poem19855.html","الوافر"],[386,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[434,"وطالب حاجة بعيدا","https://www.aldiwan.net/poem26349.html","مخلع البسيط"],[468,"غزال تدلله دله","https://www.aldiwan.net/poem59767.html","المتقارب"],[567,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"]],"verses":[["كَغَرّاءَ سَوداءِ المَدامِعِ تَرتَعي","بِحَومَلَ عِطفَي رَملَةٍ وَتَناهِيا",0,"ي",2,0],["كغادة لمعاني الحسن جامعة","تقاسم الحسن عاريها وكاسيها",1,"ي",3,0],["كغوَّاصِ لُجٍّ على فاقةٍ","يحاولُ أسبابَ إثرائِه",2,"ا",3,0],["كَغَمامَةٍ يَجلو عَلَيكَ بَريقُها","في السّرد لمعَ البارقِ المُتَهلِّلِ",3,"ل",1,0],["كَغَرِيٍّ أَجسَدَت رَأَسَهُ","فُرُعٌ بَينَ رِئاسٍ وَحام",4,"م",1,0],["كَغَربَي شَنَّةٍ خَلَقينِ مَجّا","غَريضَ الماءِ مِن خُرَزِ الأَشافي",5,"ي",1,0],["كَغُصنِ الغَضا فَوقَ النَقا نَفَحَت لَهُ","جَنُوبٌ تُكَفّى فَرعَهُ وَهوَ مُشرِفُ",6,"ف",1,0],["كَغَريضِ مَوهِبَةٍ أَطافَ بِمائِها","طَودٌ تَمَنَّعَ أَن تُنالَ لِصابُهُ",7,"ب",2,0],["كَغُرَّةِ الأَزهَرِ المَنسوبِ قَد حُسِرَت","عَنهُ الجِلالُ تِلالاً وَهوَ مُصطَخِمُ",8,"م",1,0],["كَغَزالٍ فاتَهُ","فَرعُ غُصنٍ فَعَطا",9,"ط",2,0],["كَغُرَّةٍ جَلَت عَنِ الشَبابِ","بِكَلبَةٍ سَريعَةِ الوِثابِ",10,"ب",1,0],["كَغابٍ تُحَرِّقُ أَطرافُهُ","عَلى لُجَّةٍ مِن حَديدٍ جَرى",11,"ا",1,0],["كَغُرَّةِ البَدرِ إِذا ال","شَهرُ بَدا مُنَصَّفا",12,"ف",2,0],["كَغادَة ما عَلى وج","هها الجَميل قناع",13,"ع",1,0],["كغابة اللّيث إن مرّ العدوّ بها","رأى الزّماجر والأظفار واللّبدا",14,"د",2,0],["كغراب ، يرتمي فوق جراده","سقطت وجعى ، تدلّت كالوساده",15,"د",2,1],["كَغُصني بانة بِتنا اِعتِناقاً","مِن الوَرد الجَنيّ عَلى فِراش",16,"ش",1,1],["كغنى سخا يحيى وجود يِمينه","عن أن يُذكَر بالوعود وينشدُ",17,"د",1,0],["كغانيةٍ فارقتْ صبَّها","فأرختْ غليها حدادَ الشعرْ",18,"ر",1,0],["كَغيمٍ خَفيفٍ يَمسح النورُ وَجهَهُ","لِأُولى رِياح اللَيلِ يَنحلُّ في الشَفَق",19,"ق",1,0],["كغصنٍ بلا زهرِ وزهرٍ بلا شذا","فعيشُكَ إن لم تهوَ كيفَ يطيب",20,"ب",1,0],["كَغَماغِمِ الثيرانِ بَينَهُمُ","ضَربٌ تُغَمَّضُ دونَهُ الحَدَقُ",21,"ق",1,0],["كغريقٍ بات يدعو منقذاً","بعدما أَدرك زنديه الونى",22,"ا",1,0],["كغابةٍ كانت الدنيا وهم هَمجٌ","حتّى إذا ولدتْ أنثى لهم وَأدوا",23,"د",3,0],["كغمامةٍ ترخى على ليل الشبا","ب الغض أو صبح المشيب ذيولها",24,"ل",3,0],["كَغْيمٍ رَقَّ لِكِنْ فِيهِ قَطرٌ","غَدَا المَرْعَى الجَدِيبُ بِهِ خَصيبَا",25,"ب",2,0],["كَغُزلانٍ خَذَلنَ بِذاتِ ضالٍ","تَنوشُ الدانِياتِ مِنَ الغُصونِ",26,"ن",1,0],["كَغارِسٍ في الثَّرى نَواةً","لِيَأْكُلَ التَّمْرَ في مُقامِهْ",27,"م",2,0],["كَغُصنَينِ في دَوحَةٍ بَعضُنا","يَمُدُّ عَلى بَعضِنا ظِلَّهُ",28,"ل",2,0],["كَغَزَالَة القَفْرِ السَّنِي","حَةِ عَارَضَتْكِ أو البَريْحَهْ",29,"ح",2,0]]}