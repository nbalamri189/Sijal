{"poems":[[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[85,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[61,"حبيب حباك بلينوفر","https://www.aldiwan.net/poem51819.html","المتقارب"],[80,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[40,"أسائل عن وجناء في السجن جارها","https://www.aldiwan.net/poem42282.html","الطويل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[52,"راب دهر وسطا","https://www.aldiwan.net/poem26869.html","مجزوء الرمل"],[52,"قد أغتدي والليل كالغراب","https://www.aldiwan.net/poem27237.html","الرجز"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[48,"نبه نديمي يوسفا","https://www.aldiwan.net/poem64394.html","مجزوء الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"]],"verses":[["كَغَرّاءَ سَوداءِ المَدامِعِ تَرتَعي","بِحَومَلَ عِطفَي رَملَةٍ وَتَناهِيا",0,"ي",2,0],["كغادة لمعاني الحسن جامعة","تقاسم الحسن عاريها وكاسيها",1,"ي",3,0],["كغوَّاصِ لُجٍّ على فاقةٍ","يحاولُ أسبابَ إثرائِه",2,"ا",3,0],["كَغَمامَةٍ يَجلو عَلَيكَ بَريقُها","في السّرد لمعَ البارقِ المُتَهلِّلِ",3,"ل",1,0],["كَغَرِيٍّ أَجسَدَت رَأَسَهُ","فُرُعٌ بَينَ رِئاسٍ وَحام",4,"م",1,0],["كَغَربَي شَنَّةٍ خَلَقينِ مَجّا","غَريضَ الماءِ مِن خُرَزِ الأَشافي",5,"ي",1,0],["كَغُصنِ الغَضا فَوقَ النَقا نَفَحَت لَهُ","جَنُوبٌ تُكَفّى فَرعَهُ وَهوَ مُشرِفُ",6,"ف",1,0],["كَغَريضِ مَوهِبَةٍ أَطافَ بِمائِها","طَودٌ تَمَنَّعَ أَن تُنالَ لِصابُهُ",7,"ب",2,0],["كَغُرَّةِ الأَزهَرِ المَنسوبِ قَد حُسِرَت","عَنهُ الجِلالُ تِلالاً وَهوَ مُصطَخِمُ",8,"م",1,0],["كَغَزالٍ فاتَهُ","فَرعُ غُصنٍ فَعَطا",9,"ط",2,0],["كَغُرَّةٍ جَلَت عَنِ الشَبابِ","بِكَلبَةٍ سَريعَةِ الوِثابِ",10,"ب",1,0],["كَغابٍ تُحَرِّقُ أَطرافُهُ","عَلى لُجَّةٍ مِن حَديدٍ جَرى",11,"ا",1,0],["كَغُرَّةِ البَدرِ إِذا ال","شَهرُ بَدا مُنَصَّفا",12,"ف",2,0],["كَغادَة ما عَلى وج","هها الجَميل قناع",13,"ع",1,0]]}