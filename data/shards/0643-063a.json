{"poems":[[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[63,"حبيب حباك بلينوفر","https://www.aldiwan.net/poem51819.html","المتقارب"],[82,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[41,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[42,"أسائل عن وجناء في السجن جارها","https://www.aldiwan.net/poem42282.html","الطويل"],[42,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[42,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[54,"راب دهر وسطا","https://www.aldiwan.net/poem26869.html","مجزوء الرمل"],[54,"قد أغتدي والليل كالغراب","https://www.aldiwan.net/poem27237.html","الرجز"],[54,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[50,"نبه نديمي يوسفا","https://www.aldiwan.net/poem64394.html","مجزوء الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[111,"همم الملوك أجلها أعظامها","https://www.poetsgate.com/ViewPoem.aspx?id=533",""],[102,"أمسية حجرية","https://www.poetsgate.com/ViewPoem.aspx?id=50362",""],[113,"كغصني بانة بتنا اعتناقا","https://www.aldiwan.net/poem16573.html","الوافر"],[164,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[203,"زهته الملاحة حتى سفر","https://www.aldiwan.net/poem45638.html","المتقارب"],[228,"أيا قبلة مرت على ضفتي في","https://www.aldiwan.net/poem41448.html","الطويل"],[275,"حذار فأحداق الملاح حبوب","https://www.aldiwan.net/poem35457.html","الطويل"],[292,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[303,"ثكلت مقلته طيب الكرى","https://www.aldiwan.net/poem36847.html","عموديه"],[307,"يا صاحب القبة الخضراء","https://www.aldiwan.net/poem65690.html","البسيط"],[308,"أبياتك الغر التي أبدعتها","https://www.aldiwan.net/poem57727.html","الكامل"],[353,"قطائفك التي رقت جسوما","https://www.aldiwan.net/poem19855.html","الوافر"],[391,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[440,"وطالب حاجة بعيدا","https://www.aldiwan.net/poem26349.html","مخلع البسيط"],[473,"غزال تدلله دله","https://www.aldiwan.net/poem59767.html","المتقارب"],[572,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110441","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62526","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16808","الوافر"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102307","الوافر"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1898","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77788","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127999","البسيط"],[1879,"","https://poetry.dctabudhabi.ae/diwan/poem/198784","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109458","البسيط"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76138","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200949","الكامل"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146495","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112309","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105774","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111441","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69955","الرمل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105185","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52158","الطويل"],[4755,"كَغَريبٍ تَنَاهَشَتْهُ الهُمُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=187242",""],[5038,"سحرتني","https://www.poetsgate.com/ViewPoem.aspx?id=195425",""],[5074,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=153511",""],[5111,"انْطلِاق","https://www.poetsgate.com/ViewPoem.aspx?id=212626",""],[5277,"رقيا الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=206125",""],[5302,"لقاء حب","https://www.poetsgate.com/ViewPoem.aspx?id=200063",""],[5376,"ونصْبَ عينيَّ فيها رَسْمُ معقودِ","https://www.poetsgate.com/ViewPoem.aspx?id=188343",""],[5431,"هو في النهاية واقعٌ لايملصُ","https://www.poetsgate.com/ViewPoem.aspx?id=198801",""],[5431,"أنا وأنا والإنعتاق الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=200430",""],[5431,"حيدرة ...دعوة للمحبة","https://www.poetsgate.com/ViewPoem.aspx?id=204619",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5725,"لك ياحلوتي في القلب ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=192578",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5781,"جنون بلون وحدتي","https://www.poetsgate.com/ViewPoem.aspx?id=202843",""],[5790,"رعى الله ليلا زارني في ظلامه","https://www.poetsgate.com/ViewPoem.aspx?id=112125",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[5948,"قُل للأميرِ الذي يرجو نوافَله","https://www.poetsgate.com/ViewPoem.aspx?id=100580",""],[6125,"هي الحبُّ المُعَتَّقُ في دِمَائي","https://www.poetsgate.com/ViewPoem.aspx?id=210959",""],[3155,"إلى قُمْريَّة الشط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75612&r=&rc=35",""],[6221,"عذبة النجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64917&r=&rc=1",""],[1460,"بكرتْ سمية ُ غدوة ً فتمتعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26324&r=&rc=2",""]],"verses":[["كَغَرّاءَ سَوداءِ المَدامِعِ تَرتَعي","بِحَومَلَ عِطفَي رَملَةٍ وَتَناهِيا",0,"ي",2,0],["كغادة لمعاني الحسن جامعة","تقاسم الحسن عاريها وكاسيها",1,"ي",3,0],["كغوَّاصِ لُجٍّ على فاقةٍ","يحاولُ أسبابَ إثرائِه",2,"ا",3,0],["كَغَمامَةٍ يَجلو عَلَيكَ بَريقُها","في السّرد لمعَ البارقِ المُتَهلِّلِ",3,"ل",1,0],["كَغَرِيٍّ أَجسَدَت رَأَسَهُ","فُرُعٌ بَينَ رِئاسٍ وَحام",4,"م",1,0],["كَغَربَي شَنَّةٍ خَلَقينِ مَجّا","غَريضَ الماءِ مِن خُرَزِ الأَشافي",5,"ف",2,0],["كَغُصنِ الغَضا فَوقَ النَقا نَفَحَت لَهُ","جَنُوبٌ تُكَفّى فَرعَهُ وَهوَ مُشرِفُ",6,"ف",1,0],["كَغَريضِ مَوهِبَةٍ أَطافَ بِمائِها","طَودٌ تَمَنَّعَ أَن تُنالَ لِصابُهُ",7,"ب",2,0],["كَغُرَّةِ الأَزهَرِ المَنسوبِ قَد حُسِرَت","عَنهُ الجِلالُ تِلالاً وَهوَ مُصطَخِمُ",8,"م",1,0],["كَغَزالٍ فاتَهُ","فَرعُ غُصنٍ فَعَطا",9,"ط",2,0],["كَغُرَّةٍ جَلَت عَنِ الشَبابِ","بِكَلبَةٍ سَريعَةِ الوِثابِ",10,"ب",1,0],["كَغابٍ تُحَرِّقُ أَطرافُهُ","عَلى لُجَّةٍ مِن حَديدٍ جَرى",11,"ا",1,0],["كَغُرَّةِ البَدرِ إِذا ال","شَهرُ بَدا مُنَصَّفا",12,"ف",2,0],["كَغادَة ما عَلى وج","هها الجَميل قناع",13,"ع",1,0],["كغابة اللّيث إن مرّ العدوّ بها","رأى الزّماجر والأظفار واللّبدا",14,"د",2,0],["كغيول محنية تصفقها الصبا","زرق كأثواب السماء جمامها",15,"م",3,0],["كغراب ، يرتمي فوق جراده","سقطت وجعى ، تدلّت كالوساده",16,"د",2,1],["كَغُصني بانة بِتنا اِعتِناقاً","مِن الوَرد الجَنيّ عَلى فِراش",17,"ش",1,1],["كغنى سخا يحيى وجود يِمينه","عن أن يُذكَر بالوعود وينشدُ",18,"د",1,0],["كغانيةٍ فارقتْ صبَّها","فأرختْ غليها حدادَ الشعرْ",19,"ر",1,0],["كَغيمٍ خَفيفٍ يَمسح النورُ وَجهَهُ","لِأُولى رِياح اللَيلِ يَنحلُّ في الشَفَق",20,"ق",1,0],["كغصنٍ بلا زهرِ وزهرٍ بلا شذا","فعيشُكَ إن لم تهوَ كيفَ يطيب",21,"ب",1,0],["كَغَماغِمِ الثيرانِ بَينَهُمُ","ضَربٌ تُغَمَّضُ دونَهُ الحَدَقُ",22,"ق",1,0],["كغريقٍ بات يدعو منقذاً","بعدما أَدرك زنديه الونى",23,"ا",1,0],["كغابةٍ كانت الدنيا وهم هَمجٌ","حتّى إذا ولدتْ أنثى لهم وَأدوا",24,"د",3,0],["كغمامةٍ ترخى على ليل الشبا","ب الغض أو صبح المشيب ذيولها",25,"ل",3,0],["كَغْيمٍ رَقَّ لِكِنْ فِيهِ قَطرٌ","غَدَا المَرْعَى الجَدِيبُ بِهِ خَصيبَا",26,"ب",2,0],["كَغُزلانٍ خَذَلنَ بِذاتِ ضالٍ","تَنوشُ الدانِياتِ مِنَ الغُصونِ",27,"ن",1,0],["كَغارِسٍ في الثَّرى نَواةً","لِيَأْكُلَ التَّمْرَ في مُقامِهْ",28,"م",2,0],["كَغُصنَينِ في دَوحَةٍ بَعضُنا","يَمُدُّ عَلى بَعضِنا ظِلَّهُ",29,"ل",2,0],["كَغَزَالَة القَفْرِ السَّنِي","حَةِ عَارَضَتْكِ أو البَريْحَهْ",30,"ح",2,0],["كغصنٍ مثمرٍ لمَّا جَنَينَا","لهُ ثمراُ ذَوَى وبَغَى الذبولا",31,"ل",2,0],["كغيث تدلىّ من سَماء بروضة","فعمّمها بالنبت من كل جانب",32,"ب",1,0],["كَغَيمٍ رَقَّ في أَطرافِ جَوٍّ","وَماءٍ ساحَ في قاعٍ فَسيحِ",33,"ح",1,0],["كغصن البان تعطفه شمال","إذا ما مالت به كأس الشمول",34,"ل",1,0],["كَغَريضِ سارِيَةٍ أَدَرَّتهُ الصَبا","مِن ماءِ أَسجَرَ طَيِّبِ المُستَنقَعِ",35,"ع",1,0],["كغصون أَطراف الكروم تقابلت","فَتَعانَقَت فَإِذا الفَريق جَميع",36,"ع",1,0],["كغمدان المنيف وقصر هكرٍ","وبينونِ المنيفةِ محكمينا",37,"ن",2,0],["كغادة من بنات الروم حلتها","من لازورد عليها أنفس الدرر",38,"ر",1,0],["كغمامة تروي الديار وَسَيلها","يسقي العطاش بمائه وفراتهِ",39,"ت",2,0],["كَغَانيَةٍ رأتْكَ فَلَفَّعَتْهَا","وَلِيدَتُهَا بمنخضر البرُودِ",40,"د",1,0],["كغاصبٍ أمةً فابتاعها رجلٌ","منه فأولدها عشرين منتجبا",41,"ب",2,0],["كغادةٍ سفرت عنها النقاب إلى","عبد العزيز الذي قد عز جانبه",42,"ب",2,0],["كغنَمٍ تفرَّقت في غيهبٍ","بين أخاديدٍ يسوقُها الظَّما",43,"ا",1,0],["كَغَيثٍ سَقى أَفعى فَجاءَت بِسمها","وَصاحَبَ أَصدافاً فَأثمَرتِ الدُرّا",44,"ر",2,0],["كغزالة نادت غزالا غائبا","وإذا بها سمعت حمارا ينهق",45,"ق",1,0],["كغُصن النقا في لِينه واعتداله","ورئم الفلا في جِيده ونِفاره",46,"ر",2,0],["كغيمِ ربيعٍ خلتها ببَياضها","ومثل ضيا شمس الأصيل المنيرَةِ",47,"ه",1,0],["كغصنٍ ثنته الريحُ عندَ اعتداله","رياحٌ غوادٍ بالردى وروائحُ",48,"ح",1,1],["كغادتين ازدانتا بالفكر","وليتا هيفست من حيث انثنى",49,"ن",2,0],["كغَمامَةٍ قَارِيَّةِ سَبَحَت عَلى","وَجهِ البِحارِ بِشدَّةِ الأَنوَاءِ",50,"ا",2,0],["كغبارٍ بادَ من ريح الجَنوب","وَبَدا الانجيل في أَرض القُلوب",51,"ب",1,0],["كغرة في جبهة الاقمار","يا ليت شعرى هل له من رد",52,"د",1,0],["كغصن من الريحان لكن برده","يلاث على جيش تروق حواشيه",53,"ي",2,0],["كغيظِ عمروٍ علياً في حكومته","يا ليته لم يكن في أمره حكما",54,"م",2,0],["كغصن البان تسعى نحو صب","غدا من بعدها يشكو المطالا",55,"ل",2,0],["كغصنٍ لقد عرّاه من ثوبه الشتا","فكاد يلاقي الموتَ وهو مجالد",56,"د",1,0],["كَغَريبٍ تَنَاهَشَتْهُ الهُمُومُ","قَلِقًا يَقعُدُ الدُّجَى ويَقُومُ",57,"م",1,1],["كغزال باد لا يلوي","شاق النساك بلا مشعرْ",58,"ر",1,0],["كَغَمَامَةٍ مَرَّتْ تُسَابِقُ ظِلَّهَا","وتَرَاكَضَتْ كَالطَّيْفِ عَبْرَ خَيَالِي",59,"ل",2,0],["كَغِنَاءٍ يَتَهَادَى فِيْ فَمِيْ","كَمِيَاهٍ مِنْ صَفَاءٍ تَنْدَلِقْ",60,"ق",1,0],["كغصنِ البانِ أو أطرى حبيبي","وديعُ الطبعِ صافٍ كالحليبِ",61,"ب",1,1],["كغيمة قد تهادى سحرها ألقا","وغيثها لجريح ذاهل حضرا",62,"ر",2,0],["كغصنِ بانٍ وقد ماستْ وما التفتتْ","للطيرِ أعطافُها من بعد تنهيدِ",63,"د",1,0],["كغراب شؤْمٍ إذْ يحوم توهما","حول الصداقة إذْ يعود وينكصُ",64,"ص",1,0],["كغيمٍ قد تشكّل من دموعٍ","لتهمي في سهول النفس حزنا",65,"ن",2,0],["كغولٍ شاردٍ نتنٍ","يجزّ رقاب مجزرة",66,"ر",2,0],["كغلس الليلِ مظلمةٍ","تكيل الغلّ والحسدا",67,"د",2,0],["كغريبٍ آمالُه تتلاشى","في بلادٍ يسودُ فيها الظلام",68,"م",1,0],["كغصن البان ملمسه طريا","بوجه الريح ثنياً ما ألنْتِ",69,"ت",1,0],["كَغَائصٍ في مَتَاهَاتٍ يُرَتّبها","والغَوصُ في قُبّراتِ التّيهِ عَاداتُ",70,"ت",1,0],["كَغُصَّةِ أَقْلامٍ أَفيضُ نَوائِحًا","فَجُلُّ نَديمُ الحَرْفِ لَوْمٌ وَعَذْلُ",71,"ل",1,0],["كغصن النقا من أين للغصن قده","وبدر الدجى في حسنه وكماله",72,"ل",2,0],["كغازٍ يقيم الليل حِرزًا لحَربِهِ","أتَت دون أن يدري ، وحلّت بقلبهِ",73,"ب",2,1],["كغائبٍ شَاهدٍ يخفَي عليك كما","مَنْ غَابَ عنكَ فوافى حظُّه غَابَا",74,"ب",2,0],["كغصنِ البانِ في فَننٍ ترائى","ليجذبَ كلَّ أنواعِ اشتهائي",75,"ا",3,0],["كغَابةٍ خلفَ غاباتٍ، يَضِلُّ بها","شِعْري، يَتيهُ على لألائِها الثّمِلِ",76,"ل",1,0],["كغابات نخل ٍ شامخات إلى العلى","تعلمنا قاماتها الفخر والزهوا",77,"و",2,0],["كغريضِ سارية ٍ أدارتهُ الصبا","مِنْ ماءِ أَسْجَرَ طَيِّبِ المُسْتَنْقَعِ",78,"ع",1,0]]}