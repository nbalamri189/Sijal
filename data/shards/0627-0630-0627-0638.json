{"poems":[[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[93,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[83,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[72,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[72,"إذا ظفرت يوما بقربكم المنا","https://www.aldiwan.net/poem20155.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[61,"أما وأبيك لا أنساه تدمي","https://www.aldiwan.net/poem51394.html","الوافر"],[58,"إذا هبت رياحك فاغتنمها","https://www.aldiwan.net/poem30840.html","الوافر"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[22,"إذا ظعنت عنا بجاد فلا دنت","https://www.aldiwan.net/poem21704.html","الطويل"],[48,"لعمري ما تهيج الكأس شوقي","https://www.aldiwan.net/poem65296.html","الوافر"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140949",""]],"verses":[["إِذا ظَنَنّا وَقَدَّرنا جَرى قَدَرٌ","بِنازِلٍ غَيرِ مَوهومٍ وَمَظنونِ",0,"ن",1,0],["إِذا ظُلَمٌ لَم أَمضِ فيها عَزيمَةً","فَساعَةُ لَيلي مِثلُ حَولٍ مُجَرَّمِ",1,"م",1,0],["إِذا ظَمِئَت عيسٌ إِلَيكَ فَإِنَّما","حَقائِبُها تَروي لُجَبناً وَعَسجَدا",2,"د",2,0],["إِذَا ظَلَّتْ إِلَى حِينٍ","فَعَدْلُ اللهِ حَامِيهَا",3,"ي",3,0],["إذا ظمئت منها الذوابل في الوغى","جداولُ أنهارِ السيوف تُروّيها",4,"ي",3,0],["إذا ظنَّ تبعيد الحمامِ وصلنه","بشدٍّ على رغم النفوس وتقريب",5,"ب",1,0],["إذا ظفرت يوماً بقربكُم المنا","فلست أبالي من تباعد أو دنا",6,"ن",2,1],["إذا ظفرت عندهُ بموعدٍ","يقول كم مال أفادته يدي",7,"ي",1,0],["إذا ظلتِ البيداءُ تطفو إِكامُها","وترسُبُ في غَمْرٍ من الآلِ ناضبِ",8,"ب",1,0],["إذا ظُلَلٌ قدْ لَوّحتْ ببروقها","إلى ظُلَلٍ قد أرجفت برعودها",9,"د",3,0],["إِذا ظَفِرَت مِنكِ العُيونُ بِنَظرَةٍ","أَثابَ بِها مُعيِ المَطِيِّ وَرازِمُه",10,"م",2,0],["إذا ظَمِئَت فِراخُ أبيكَ يَوماً","سقَاها من رِقابِ القَوم رَيَّا",11,"ي",2,0],["إِذا ظَفِرَت يَداكَ فَلا تَقصِّر","فَإِنَّ الدَهرَ عادَتَهُ يَخونُ",12,"ن",1,0],["إذا ظَلّلَتْهُ الطيرُ كانت أجورها","جسوماً ثَنى عن طَعنها الزُّرْقَ رُعّفَا",13,"ف",2,0],["إِذا ظُلُماتُ الرَأيِ أُسدِلَ ثَوبُها","تَطَلَّعَ فيها فَجرُهُ فَتَجَلَّتِ",14,"ت",1,0],["إذا ظَمِئَتْ نُفوسُهُمُ ارتوينا","وروَّينا الأعنَّةَ والبُنودا",15,"د",2,0],["إِذا ظَمِئَت عَينٌ إِلى الغَمضِ ذادَها","مِنَ الهَمِّ مُهتاجٌ يَقومُ وَيَقعُدُ",16,"د",1,0],["إِذا ظَعَنَت عَنّا بِجادٌ فَلا دَنَت","وَلا رَجَعَت حاشا مُعَيَّةَ وَالجَعدِ",17,"د",1,1],["إِذا ظَفِرَت بِهِ كَفّي اِستَفادَت","لِنَفسي عَن تَجَمُّعِها الأَماني",18,"ي",1,0],["إِذا ظَعَنُوا يَوماً سَمِعتَ خِلالَهُم","غِناءً وَتَأييهاً وَنَقراً وَحادِيا",19,"ي",2,0],["إذا ظفرت بي عنده يد سيدي","فإن زليخا من عذابيَ تكثر",20,"ر",1,0],["إذا ظفرت منك العيون بنظرةٍ","أثاب بها معيي المطيّ ورازمه",21,"م",2,0]]}