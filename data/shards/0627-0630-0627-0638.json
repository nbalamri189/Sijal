{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[55,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[95,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[85,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[74,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[74,"إذا ظفرت يوما بقربكم المنا","https://www.aldiwan.net/poem20155.html","الطويل"],[74,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[45,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[63,"أما وأبيك لا أنساه تدمي","https://www.aldiwan.net/poem51394.html","الوافر"],[60,"إذا هبت رياحك فاغتنمها","https://www.aldiwan.net/poem30840.html","الوافر"],[82,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[46,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[107,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[107,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[22,"إذا ظعنت عنا بجاد فلا دنت","https://www.aldiwan.net/poem21704.html","الطويل"],[50,"لعمري ما تهيج الكأس شوقي","https://www.aldiwan.net/poem65296.html","الوافر"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62234","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140949",""],[96,"تعالوا نعدّ الصّيد","https://www.poetsgate.com/ViewPoem.aspx?id=15668",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[113,"يعد علي أنفاسي ذنوبا","https://www.aldiwan.net/poem16186.html","الوافر"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[147,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[154,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[197,"تفرق قلبي في هواه فعنده","https://www.aldiwan.net/poem13086.html","الطويل"],[215,"حضرت وما في الجيب غير دراهم","https://www.aldiwan.net/poem46234.html","الطويل"],[236,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[242,"قد آن أن ينجز الوعد الذي وعدا","https://www.aldiwan.net/poem18143.html","البسيط"],[303,"رأى البرق في جنح الدجى يتألق","https://www.aldiwan.net/poem36295.html","عموديه"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[369,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[369,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[371,"وإني لمطوي الضلوع على جوى","https://www.aldiwan.net/poem17094.html","الطويل"],[373,"ألا بان جيراني ولست بعائف","https://www.aldiwan.net/poem1874.html","الطويل"],[408,"تخطر كالبدر المنير على غصن","https://www.aldiwan.net/poem46742.html","الطويل"],[409,"إلى الأشراف أعيان الأنام","https://www.aldiwan.net/poem33410.html","الوافر"],[411,"تقسم قلبي في هواه فعندهه","https://www.aldiwan.net/poem49829.html","الطويل"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[447,"إذا ظفرت نفسي إليك تقاصد","https://www.aldiwan.net/poem14303.html","الطويل"],[447,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[447,"تصاممت عن قذع السفيه حفيظة","https://www.aldiwan.net/poem14394.html","الطويل"],[463,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[463,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[466,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[466,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[466,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[482,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[487,"كتبت لقاضي العشق سطرا من الهوى","https://www.aldiwan.net/poem24441.html","عموديه"],[491,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[556,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[563,"إذا ظهر نحن غبنا أو ظهرنا غاب","https://www.aldiwan.net/poem34744.html","المواليا"],[567,"لما رأيتك ترعى ذمة العرب","https://www.aldiwan.net/poem52875.html","البسيط"],[567,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[580,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54163","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129531","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100125","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1334,"","https://poetry.dctabudhabi.ae/diwan/poem/76576","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46470","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89532","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109419","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93580","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102437","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45810","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109914","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132143","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85270","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59477","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76510","الوافر"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119463","المتقارب"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/145861","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45038","الطويل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28731","الوافر"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139165","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99110","السريع"],[4804,"اذا ظلم الشيب رأس الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=92079",""],[4981,"رسول اللّه","https://www.poetsgate.com/ViewPoem.aspx?id=190521",""],[5052,"نزفُ العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=205964",""],[5092,"غريبٌ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=177768",""],[5225,"الي..؟","https://www.poetsgate.com/ViewPoem.aspx?id=36752",""],[307,"بذكر المصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=215238",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5979,"حمى الله من كيد الزمان خلائقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181360",""],[6093,"إِذَا ظَهَرَ المَشْيْبُ بِوَجْهِ حَيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=180714",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""]],"verses":[["إِذا ظَنَنّا وَقَدَّرنا جَرى قَدَرٌ","بِنازِلٍ غَيرِ مَوهومٍ وَمَظنونِ",0,"ن",1,0],["إِذا ظُلَمٌ لَم أَمضِ فيها عَزيمَةً","فَساعَةُ لَيلي مِثلُ حَولٍ مُجَرَّمِ",1,"م",1,0],["إِذا ظَمِئَت عيسٌ إِلَيكَ فَإِنَّما","حَقائِبُها تَروي لُجَبناً وَعَسجَدا",2,"د",2,0],["إِذَا ظَلَّتْ إِلَى حِينٍ","فَعَدْلُ اللهِ حَامِيهَا",3,"ي",3,0],["إذا ظمئت منها الذوابل في الوغى","جداولُ أنهارِ السيوف تُروّيها",4,"ي",3,0],["إذا ظنَّ تبعيد الحمامِ وصلنه","بشدٍّ على رغم النفوس وتقريب",5,"ب",1,0],["إذا ظفرت يوماً بقربكُم المنا","فلست أبالي من تباعد أو دنا",6,"ن",2,1],["إذا ظفرت عندهُ بموعدٍ","يقول كم مال أفادته يدي",7,"ي",1,0],["إذا ظلتِ البيداءُ تطفو إِكامُها","وترسُبُ في غَمْرٍ من الآلِ ناضبِ",8,"ب",1,0],["إذا ظُلَلٌ قدْ لَوّحتْ ببروقها","إلى ظُلَلٍ قد أرجفت برعودها",9,"د",3,0],["إِذا ظَفِرَت مِنكِ العُيونُ بِنَظرَةٍ","أَثابَ بِها مُعيِ المَطِيِّ وَرازِمُه",10,"م",2,0],["إذا ظَمِئَت فِراخُ أبيكَ يَوماً","سقَاها من رِقابِ القَوم رَيَّا",11,"ي",2,0],["إِذا ظَفِرَت يَداكَ فَلا تَقصِّر","فَإِنَّ الدَهرَ عادَتَهُ يَخونُ",12,"ن",1,0],["إذا ظَلّلَتْهُ الطيرُ كانت أجورها","جسوماً ثَنى عن طَعنها الزُّرْقَ رُعّفَا",13,"ف",2,0],["إِذا ظُلُماتُ الرَأيِ أُسدِلَ ثَوبُها","تَطَلَّعَ فيها فَجرُهُ فَتَجَلَّتِ",14,"ت",1,0],["إذا ظَمِئَتْ نُفوسُهُمُ ارتوينا","وروَّينا الأعنَّةَ والبُنودا",15,"د",2,0],["إِذا ظَمِئَت عَينٌ إِلى الغَمضِ ذادَها","مِنَ الهَمِّ مُهتاجٌ يَقومُ وَيَقعُدُ",16,"د",1,0],["إِذا ظَعَنَت عَنّا بِجادٌ فَلا دَنَت","وَلا رَجَعَت حاشا مُعَيَّةَ وَالجَعدِ",17,"د",1,1],["إِذا ظَفِرَت بِهِ كَفّي اِستَفادَت","لِنَفسي عَن تَجَمُّعِها الأَماني",18,"ن",2,0],["إِذا ظَعَنُوا يَوماً سَمِعتَ خِلالَهُم","غِناءً وَتَأييهاً وَنَقراً وَحادِيا",19,"ي",2,0],["إذا ظفرت بي عنده يد سيدي","فإن زليخا من عذابيَ تكثر",20,"ر",1,0],["إِذَا ظَلتِ العِيسُ الخَوَامِسُ والقَطَا","مَعَاً في هَدَالٍ يَتْبَعُ الرِّيحَ مَائِلُهْ",21,"ل",2,0],["إذا ظفرت منك العيون بنظرةٍ","أثاب بها معيي المطيّ ورازمه",22,"م",2,0],["إذا ظلّ مجد العرب في الشام سالما","فمجد بني قحطان في الشرق سالم",23,"م",1,0],["إذا ظمئت في قطعها البيد نسمة","ألمّت به وهنا فرنّحها السّكر",24,"ر",1,0],["أَذا ظَنَ الذُباب خَشيتُ مِنهُ","لِفَقد مُساعِدي يُلفى مُجيبا",25,"ب",2,0],["إِذا ظَفِرتُ بِأَن يَرتاحَ جودُكَ لي","فَما لِنائِبَةٍ نابٌ وَلا ظُفُرُ",26,"ر",1,0],["إِذا ظَلَّ يَحمي قيلَ عَودٌ مُجَرَّبٌ","وَإِن ظَلَّ يَهمي قيلَ بِالدَهرِ مُغتَرُّ",27,"ر",1,0],["إِذا ظَفِرَت بِالرُشدِ بَعدَ سَفاهِها","صَلاحُ فُؤادي جُرعَةٌ مِن مِياهِها",28,"ه",2,0],["إِذا ظَمِئَت نَفسي أَقولُ لَهُ اِسقِني","فَإِن لَم تَكُن راحٌ لَدَيكَ فَريقُ",29,"ق",1,0],["إذا ظلمت ليلى بفضل جمالها","فإني بشعرى في هواها لظالم",30,"م",1,0],["إذا ظهروا للدهر أورق عوده","وأصبح مجني المحاسن مقطوفا",31,"ف",2,0],["إِذَا ظَفِرْتُ بِهَا أُنْشِدُ مِنْ طَرَبٍ","بُشْرَى فَقَدْ أَنْجَزَ الإِقْبالُ مَا وَعَدَا",32,"د",2,0],["إِذا ظنَّ عبدٌ نفسَه باتَ سيداً","فلا عتقُه يُرجى وَلا هو يأْبق",33,"ق",1,0],["إِذا ظفرت كفّاك يوماً بصاحبٍ","فَأودعه في جفنِ الرعاية والهدبِ",34,"ب",1,0],["إذا ظَمئتْ من نَحْرِ طاغٍ إلى دَمٍ","غدا لاهثاً منه السِّنانُ ليُولَغا",35,"غ",2,0],["إذا ظَلَّ مَن طَوَّقْتَه البِرَّ جاحِداً","عَقدتَ مكانَ الطَّوقِ منه المُهَنّدا",36,"د",2,0],["إِذا ظَمِئَت يَوماً فَلا نَزَلَ الحَيا","وَإِن خَبَطَت يَوماً فَلا طَلَعَ النَجمُ",37,"م",1,0],["إذا ظَعَنَ الحَيُّ الجميعُ اجْتَنَبْتُهُم","مكانَ النَّدِيمِ لِلنَّجيِّ المُساعِفِ",38,"ف",1,0],["إذا ظَنّ صِدقَ العذلِ ضنَّ بوصلِه","فَيقتل مَنْ لا يَجْتَنِي الذنْبِ بالظَنّ",39,"ن",1,0],["إذا ظنوا بمال عند شخص","ببطن الجيب أو تحت الحزام",40,"م",1,0],["إذا ظمِئَتْ رُوحي أقولُ لهُ اسقِني","فإنْ لم يكُنْ خَمرٌ لديْكَ فَرِيقُ",41,"ق",1,0],["إِذا ظَنَنتُ بِأَنّي قَد ظفرت بِما","أَبغي يقصِّرُني عَنهُ بِلا سَبَبِ",42,"ب",1,0],["إذا ظفرت نفسي إليك تقاصد","فلا بد لي من حكمة ومقاصد",43,"د",1,1],["إذا ظفرت نفسي بعفوك خالقي","فقد زال عنها الغبن يوماً به الغبن",44,"ن",1,0],["إذا ظهرت شنعاء من ذات فاحشٍ","فمرجعها إن لم تجبه بفيها",45,"ي",3,0],["إذا ظهر طرف لم يطق غير فارس","ففُرسانُها المستبطنون زحامُ",46,"م",1,0],["إذا ظنَّ أمراً فاليقينُ وراءه","ويصدقُ ظنٌّ تارةً ويحوبُ",47,"ب",1,0],["إذا ظمئت أغنى الدلاصُ بلمعه","فكل كميٍّ مُنْقعٌ لأُوامِ",48,"م",1,0],["إِذا ظمئت والوِردُ دانٍ تنكَّبتْ","حِذارَ الثفاتٍ نحوهُم بجِرانِ",49,"ن",1,0],["إذا ظمىءَ العَسَّالُ من لهب الوغى","فموْردُهُ لَبَّاتُهُمْ والحَناجِرُ",50,"ر",1,0],["إذا ظمئت أكبادها شربتْ دماً","وإنْ سغبتْ لاذت بعلك المس