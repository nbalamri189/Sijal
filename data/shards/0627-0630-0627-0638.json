{"poems":[[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[93,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[83,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[72,"نظير أب كنا فقدنا ومحبوب","https://www.aldiwan.net/poem18242.html","الطويل"],[72,"إذا ظفرت يوما بقربكم المنا","https://www.aldiwan.net/poem20155.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[61,"أما وأبيك لا أنساه تدمي","https://www.aldiwan.net/poem51394.html","الوافر"],[58,"إذا هبت رياحك فاغتنمها","https://www.aldiwan.net/poem30840.html","الوافر"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[22,"إذا ظعنت عنا بجاد فلا دنت","https://www.aldiwan.net/poem21704.html","الطويل"],[48,"لعمري ما تهيج الكأس شوقي","https://www.aldiwan.net/poem65296.html","الوافر"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140949",""],[94,"تعالوا نعدّ الصّيد","https://www.poetsgate.com/ViewPoem.aspx?id=15668",""],[94,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[110,"يعد علي أنفاسي ذنوبا","https://www.aldiwan.net/poem16186.html","الوافر"],[144,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[144,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[151,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[194,"تفرق قلبي في هواه فعنده","https://www.aldiwan.net/poem13086.html","الطويل"],[212,"حضرت وما في الجيب غير دراهم","https://www.aldiwan.net/poem46234.html","الطويل"],[232,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[238,"قد آن أن ينجز الوعد الذي وعدا","https://www.aldiwan.net/poem18143.html","البسيط"],[299,"رأى البرق في جنح الدجى يتألق","https://www.aldiwan.net/poem36295.html","عموديه"],[306,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[365,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[365,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[367,"وإني لمطوي الضلوع على جوى","https://www.aldiwan.net/poem17094.html","الطويل"],[369,"ألا بان جيراني ولست بعائف","https://www.aldiwan.net/poem1874.html","الطويل"],[403,"تخطر كالبدر المنير على غصن","https://www.aldiwan.net/poem46742.html","الطويل"],[404,"إلى الأشراف أعيان الأنام","https://www.aldiwan.net/poem33410.html","الوافر"],[406,"تقسم قلبي في هواه فعندهه","https://www.aldiwan.net/poem49829.html","الطويل"],[407,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[442,"إذا ظفرت نفسي إليك تقاصد","https://www.aldiwan.net/poem14303.html","الطويل"],[442,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[442,"تصاممت عن قذع السفيه حفيظة","https://www.aldiwan.net/poem14394.html","الطويل"],[459,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[459,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[462,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[462,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[462,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[465,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[478,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[483,"كتبت لقاضي العشق سطرا من الهوى","https://www.aldiwan.net/poem24441.html","عموديه"],[487,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[552,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[559,"إذا ظهر نحن غبنا أو ظهرنا غاب","https://www.aldiwan.net/poem34744.html","المواليا"],[563,"لما رأيتك ترعى ذمة العرب","https://www.aldiwan.net/poem52875.html","البسيط"],[563,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[576,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"]],"verses":[["إِذا ظَنَنّا وَقَدَّرنا جَرى قَدَرٌ","بِنازِلٍ غَيرِ مَوهومٍ وَمَظنونِ",0,"ن",1,0],["إِذا ظُلَمٌ لَم أَمضِ فيها عَزيمَةً","فَساعَةُ لَيلي مِثلُ حَولٍ مُجَرَّمِ",1,"م",1,0],["إِذا ظَمِئَت عيسٌ إِلَيكَ فَإِنَّما","حَقائِبُها تَروي لُجَبناً وَعَسجَدا",2,"د",2,0],["إِذَا ظَلَّتْ إِلَى حِينٍ","فَعَدْلُ اللهِ حَامِيهَا",3,"ي",3,0],["إذا ظمئت منها الذوابل في الوغى","جداولُ أنهارِ السيوف تُروّيها",4,"ي",3,0],["إذا ظنَّ تبعيد الحمامِ وصلنه","بشدٍّ على رغم النفوس وتقريب",5,"ب",1,0],["إذا ظفرت يوماً بقربكُم المنا","فلست أبالي من تباعد أو دنا",6,"ن",2,1],["إذا ظفرت عندهُ بموعدٍ","يقول كم مال أفادته يدي",7,"ي",1,0],["إذا ظلتِ البيداءُ تطفو إِكامُها","وترسُبُ في غَمْرٍ من الآلِ ناضبِ",8,"ب",1,0],["إذا ظُلَلٌ قدْ لَوّحتْ ببروقها","إلى ظُلَلٍ قد أرجفت برعودها",9,"د",3,0],["إِذا ظَفِرَت مِنكِ العُيونُ بِنَظرَةٍ","أَثابَ بِها مُعيِ المَطِيِّ وَرازِمُه",10,"م",2,0],["إذا ظَمِئَت فِراخُ أبيكَ يَوماً","سقَاها من رِقابِ القَوم رَيَّا",11,"ي",2,0],["إِذا ظَفِرَت يَداكَ فَلا تَقصِّر","فَإِنَّ الدَهرَ عادَتَهُ يَخونُ",12,"ن",1,0],["إذا ظَلّلَتْهُ الطيرُ كانت أجورها","جسوماً ثَنى عن طَعنها الزُّرْقَ رُعّفَا",13,"ف",2,0],["إِذا ظُلُماتُ الرَأيِ أُسدِلَ ثَوبُها","تَطَلَّعَ فيها فَجرُهُ فَتَجَلَّتِ",14,"ت",1,0],["إذا ظَمِئَتْ نُفوسُهُمُ ارتوينا","وروَّينا الأعنَّةَ والبُنودا",15,"د",2,0],["إِذا ظَمِئَت عَينٌ إِلى الغَمضِ ذادَها","مِنَ الهَمِّ مُهتاجٌ يَقومُ وَيَقعُدُ",16,"د",1,0],["إِذا ظَعَنَت عَنّا بِجادٌ فَلا دَنَت","وَلا رَجَعَت حاشا مُعَيَّةَ وَالجَعدِ",17,"د",1,1],["إِذا ظَفِرَت بِهِ كَفّي اِستَفادَت","لِنَفسي عَن تَجَمُّعِها الأَماني",18,"ن",2,0],["إِذا ظَعَنُوا يَوماً سَمِعتَ خِلالَهُم","غِناءً وَتَأييهاً وَنَقراً وَحادِيا",19,"ي",2,0],["إذا ظفرت بي عنده يد سيدي","فإن زليخا من عذابيَ تكثر",20,"ر",1,0],["إذا ظفرت منك العيون بنظرةٍ","أثاب بها معيي المطيّ ورازمه",21,"م",2,0],["إذا ظلّ مجد العرب في الشام سالما","فمجد بني قحطان في الشرق سالم",22,"م",1,0],["إذا ظمئت في قطعها البيد نسمة","ألمّت به وهنا فرنّحها السّكر",23,"ر",1,0],["أَذا ظَنَ الذُباب خَشيتُ مِنهُ","لِفَقد مُساعِدي يُلفى مُجيبا",24,"ب",2,0],["إِذا ظَفِرتُ بِأَن يَرتاحَ جودُكَ لي","فَما لِنائِبَةٍ نابٌ وَلا ظُفُرُ",25,"ر",1,0],["إِذا ظَلَّ يَحمي قيلَ عَودٌ مُجَرَّبٌ","وَإِن ظَلَّ يَهمي قيلَ بِالدَهرِ مُغتَرُّ",26,"ر",1,0],["إِذا ظَفِرَت بِالرُشدِ بَعدَ سَفاهِها","صَلاحُ فُؤادي جُرعَةٌ مِن مِياهِها",27,"ه",2,0],["إِذا ظَمِئَت نَفسي أَقولُ لَهُ اِسقِني","فَإِن لَم تَكُن راحٌ لَدَيكَ فَريقُ",28,"ق",1,0],["إذا ظلمت ليلى بفضل جمالها","فإني بشعرى في هواها لظالم",29,"م",1,0],["إذا ظهروا للدهر أورق عوده","وأصبح مجني المحاسن مقطوفا",30,"ف",2,0],["إِذَا ظَفِرْتُ بِهَا أُنْشِدُ مِنْ طَرَبٍ","بُشْرَى فَقَدْ أَنْجَزَ الإِقْبالُ مَا وَعَدَا",31,"د",2,0],["إِذا ظنَّ عبدٌ نفسَه باتَ سيداً","فلا عتقُه يُرجى وَلا هو يأْبق",32,"ق",1,0],["إِذا ظفرت كفّاك يوماً بصاحبٍ","فَأودعه في جفنِ الرعاية والهدبِ",33,"ب",1,0],["إذا ظَمئتْ من نَحْرِ طاغٍ إلى دَمٍ","غدا لاهثاً منه السِّنانُ ليُولَغا",34,"غ",2,0],["إذا ظَلَّ مَن طَوَّقْتَه البِرَّ جاحِداً","عَقدتَ مكانَ الطَّوقِ منه المُهَنّدا",35,"د",2,0],["إِذا ظَمِئَت يَوماً فَلا نَزَلَ الحَيا","وَإِن خَبَطَت يَوماً فَلا طَلَعَ النَجمُ",36,"م",1,0],["إذا ظَعَنَ الحَيُّ الجميعُ اجْتَنَبْتُهُم","مكانَ النَّدِيمِ لِلنَّجيِّ المُساعِفِ",37,"ف",1,0],["إذا ظَنّ صِدقَ العذلِ ضنَّ بوصلِه","فَيقتل مَنْ لا يَجْتَنِي الذنْبِ بالظَنّ",38,"ن",1,0],["إذا ظنوا بمال عند شخص","ببطن الجيب أو تحت الحزام",39,"م",1,0],["إذا ظمِئَتْ رُوحي أقولُ لهُ اسقِني","فإنْ لم يكُنْ خَمرٌ لديْكَ فَرِيقُ",40,"ق",1,0],["إِذا ظَنَنتُ بِأَنّي قَد ظفرت بِما","أَبغي يقصِّرُني عَنهُ بِلا سَبَبِ",41,"ب",1,0],["إذا ظفرت نفسي إليك تقاصد","فلا بد لي من حكمة ومقاصد",42,"د",1,1],["إذا ظفرت نفسي بعفوك خالقي","فقد زال عنها الغبن يوماً به الغبن",43,"ن",1,0],["إذا ظهرت شنعاء من ذات فاحشٍ","فمرجعها إن لم تجبه بفيها",44,"ي",3,0],["إذا ظهر طرف لم يطق غير فارس","ففُرسانُها المستبطنون زحامُ",45,"م",1,0],["إذا ظنَّ أمراً فاليقينُ وراءه","ويصدقُ ظنٌّ تارةً ويحوبُ",46,"ب",1,0],["إذا ظمئت أغنى الدلاصُ بلمعه","فكل كميٍّ مُنْقعٌ لأُوامِ",47,"م",1,0],["إِذا ظمئت والوِردُ دانٍ تنكَّبتْ","حِذارَ الثفاتٍ نحوهُم بجِرانِ",48,"ن",1,0],["إذا ظمىءَ العَسَّالُ من لهب الوغى","فموْردُهُ لَبَّاتُهُمْ والحَناجِرُ",49,"ر",1,0],["إذا ظمئت أكبادها شربتْ دماً","وإنْ سغبتْ لاذت بعلك المساحل",50,"ل",1,0],["اِذا ظلمَ الذي قد كنتَ ترجو","عواطفَ عدلِه فلِمَنْ تلومُ",51,"م",1,0],["إذا ظفرت يمناك بالدهر","زمانك بالإسراف واستتعب الطرفا",52,"ف",2,0],["إِذا ظِلُّ قَومٍ كانَ ظَلَّ غَيايَةٍ","تُذَعذِعُهُ الأَرواحُ مِن كُلِّ مَفجَرِ",53,"ر",1,0],["إذا ظمئتْ أحشاؤهمْ من حفيظةٍ","فلم تروهمْ غيرُ الدّماءِ السّوائلِ",54,"ل",1,0],["إذا ظَهَرْ نحن غبنا أو ظهرنا غابْ","وجودُ حقٍّ بنا مثل الأسدْ في غابْ",55,"ب",1,1],["إذا ظَفِرتُ بقَلبٍ غيرِ مُبتعِدٍ","فما أبالي برَيعٍ غيرِ مُقتَربِ",56,"ب",1,0],["إذا ظَفِرتْ يدي بكَفاف عَيْشٍ","فماذا بعدَهُ تلكَ الفَضولُ",57,"ل",1,0],["إِذا ظَهرَتْ كان الحِجَابُ من الحِجىَ","وإِن سفرت نابَ الحَيَاءُ عن النَّقْبِ",58,"ب",1,0]]}