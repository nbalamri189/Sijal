{"poems":[[110,"تأبط شرا","https://www.shoaraa.com/p12775",""],[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[438,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137344",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46519","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97075","الطويل"]],"verses":[["فلم بإقتران الشرط يجزم فعله","ولا يتعدى الشرط فعلي ليُجزما",0,"م",2,0],["فلم برتُ حتى قيل في ظل سخطةٍ","وأصبحتُ للتَّرحيم نَصباً معرَّضا",1,"ض",2,0],["فلم بعثت رسل وسنت شرائع","وأنزل قرآن بهذي الزواجر",2,"ر",1,0],["فلمُبْهَمٍ ما رقّ من إيضاحِه","ولأدْهَمٍ ما راقَ من أوضاحه",3,"ح",2,0],["فِلم بنتَ عنَّا فأَدميت منَّا","القلوبَ فرقَّ لهُنَّ الجماد",4,"د",1,0],["فلِم بِأَصناف الأَذى يعذبه","المال يَكفيهِ فَلَم يهذبه",5,"ه",1,0],["فلمبتهجٍ ولِمُنتهِجِ","فالنفسُ إذا تُرِكَت رَقَدَت",6,"ت",1,0],["فلم بعدك الأفلاك دارت وأنها","تحدب منها قبل أن تصب الظهر",7,"ر",1,0]]}