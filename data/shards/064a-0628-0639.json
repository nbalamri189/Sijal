{"poems":[[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[53,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[53,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[87,"كان على بعض الدروب جمل","https://www.aldiwan.net/poem8008.html","الرجز"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"أصدود غلا بها أم دلال","https://www.aldiwan.net/poem65596.html","الخفيف"],[63,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[107,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[54,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[48,"قد يحج الفتى ويغنى بعرس","https://www.aldiwan.net/poem22640.html","الخفيف"],[48,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42541","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141956","الخفيف"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199474","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54255","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[24,"إنّ عِرْسِي قد آذنتْني أخِيراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10866&r=&rc=7",""],[119,"لله لطف سر برهانه","https://www.aldiwan.net/poem42191.html","السريع"],[190,"أيا ذا الذي في كفه مرهف الشبا","https://www.aldiwan.net/poem43341.html","الطويل"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[422,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[435,"يا سمي النبي رفقا بصب","https://www.aldiwan.net/poem41040.html","الخفيف"],[438,"بركة بوركت فنحن لديها","https://www.aldiwan.net/poem12417.html","الخفيف"],[458,"قالوا طيور تغالي في محبتها","https://www.aldiwan.net/poem61224.html","البسيط"],[463,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[463,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[469,"حي ظباء بالعقيق غيدا","https://www.aldiwan.net/poem3466.html","عموديه"],[469,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[498,"ذو قصر أحدب من غير كبر","https://www.aldiwan.net/poem67295.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122701","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101525","الرمل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82601","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77870","الهزج"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108796","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203029","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200176","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121873","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133243","الوافر"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146888","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18828","الكامل"],[4718,"ماعاد لي بالحب شفٍ وراده","https://www.poetsgate.com/ViewPoem.aspx?id=137174",""],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""],[4778,"دعك من يا ليت","https://www.poetsgate.com/ViewPoem.aspx?id=196787",""],[4802,"يلعن أبو الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=32352",""],[5092,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=139892",""],[5136,"يا خير من جال على سابح","https://www.poetsgate.com/ViewPoem.aspx?id=121597",""],[5281,"علِّميني","https://www.poetsgate.com/ViewPoem.aspx?id=199316",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[5606,"الوحده أحسن من اللي رفقته بايره","https://www.poetsgate.com/ViewPoem.aspx?id=194252",""],[5616,"كمل النصاب","https://www.poetsgate.com/ViewPoem.aspx?id=203468",""],[5674,"نزف الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=196438",""],[5732,"يبعد هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177894",""],[5736,"وبي شوقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=208490",""],[5851,"حزن اليتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=175236",""],[5944,"طلع الشعر علينا","https://www.poetsgate.com/ViewPoem.aspx?id=212850",""],[5956,"بعد الشّيب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182016",""],[5956,"هدايا للأطفال العرب من صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=192184",""]],"verses":[["يَبعَثُ العَزفُ وَالتَرَنُّمُ مِنها","وَنَذيرٌ إِلى الخَميسِ نَذيرا",0,"ر",2,0],["يبعث الساكنَ البعيد اهتياجاً","ويداوي حرارة المهتاجِ",1,"ج",1,0],["يبعثُ نشراً له تطيبُ به","أنجادُ إقليمه وأغواره",2,"ر",2,0],["يَبعَثُني مِن مَرقَدي بُكاها","وَأَفتَحُ العَينَ عَلى شَكواها",3,"ه",2,0],["يَبعَثُ الضَوءَ لِلبِلادِ فَتَسري","في سَناهُ الفُهومُ وَالفُهَماءُ",4,"ا",2,0],["يَبعُدُ البائِنُ المُبَرِّزُ فَوتاً","وَتَدانى الضُروبُ وَالأَشكالُ",5,"ل",1,0],["يَبعَثُ منه جسَداً","أعضاؤُه طُرَّاً حَدَق",6,"ق",1,0],["يَبعثُ القومُ مِثلَها من لُجَيْنٍ","يُعجِبُ النّاظِرينَ والنُّقّادا",7,"د",2,0],["يَبعَثُها شَمائِلاً وَيَنثَني","جَنائِباً إِلى فُؤادٍ يَضطَرِب",8,"ب",1,0],["يَبعَثُ اللَهُ في نَهارٍ وَلَيلٍ","بَرَكاتٍ مِن رِزقِهِ مَدرورَه",9,"ر",2,0],["يَبِعْنَ تُراثَ آباءٍ كِرَام","ويَشْرِينَ الحُجُولَ أوِ الحِجالا",10,"ل",2,0],["يبعث بالزّاد ويرسل المدد","وينفذ الكتب ويأخذ العدد",11,"د",1,0],["يَبْعَثُ الصَّوْتَ مُرْسَلاً فَإِذا مَا","غَضَّ مِنْهُ اسْتَدَارَ بَينَ اللَّهَاةِ",12,"ه",1,0],["يبعث الدارجين في الأعصر الغبر","وكانوا على رحاها غبارا",13,"ر",2,0],["يبعثرني الشوق حين تغيبين","فوق الجبال وتحت البحار",14,"ر",1,1],["يَبْعَثْنَ آياتِ الولا","ءِ إلى الأميرةِ مُخْلِصات",15,"ت",1,0],["يبْعَثُ الغَيْثَ والرجاءَ لقاصٍ","ويَمُدُّ اليَمينَ بِرّاً لِداني",16,"ن",2,0],["يبعثُ العزفُ والترنمُ منها","ونزيرٌ إلى الخَمِيسِ نزِيرا",17,"ر",2,0],["يبعث من ألطافه رحمةً","عند أشد الاحتياج الفرج",18,"ج",1,0],["يبعّض أجسام الورى غير هائب","ويأخذ جذرا من عطاء ونائل",19,"ل",1,0],["يَبعُدُ عنه في الحُضَر","بعدَ تماحٍ من أَثر",20,"ر",1,0],["يبعثُ الله منهم كلّ عصرٍ","علماء أفاضلاً أعلاما",21,"ا",1,0],["يبعث الوجد إلى كلّ حشا","لِخَلِيٍّ من هواه حيث لا وجد",22,"د",1,0],["يبعث السطور مني لتنبي","عن أسير مقيد بهواكا",23,"ك",2,0],["يبعث الرَّقْصُ مِنْهُمُ حركَاتٍ","سَرَقَتْ بعْضَها طِوالُ الرِّماح",24,"ح",1,0],["يبعثر الماء درّا في تنافسها","كأنّها كرنفال الفنّ للرّائي",25,"ي",1,0],["يبعثن للأعراض كلَّ كريمة","بُذلتْ وما بُذلتْ لغير مصونِ",26,"ن",1,0],["يبعثُ بأسُه الردى","إلى النفوس رُسُلا",27,"ل",2,0],["يبعثُ منها بُرْدُه","مع النسيم نَفحا",28,"ح",2,0],["يبعثُها مفصِحاً لسانٌ","ماضٍ إذا لَجلَجَ الخطيبُ",29,"ب",1,0],["يبعد نيلاً حين يدنو عزَّةً","فهل رأيت دانياً بعيدا",30,"د",2,0],["يبعدهم يأسٌ وتدني طماعةٌ","فيجهل جفني والجوانح تحلم",31,"م",1,0],["يبعثه الحرص ويعييه الخطر","ثم هوى مستيقناً لما افتكر",32,"ر",1,0],["يَبعَثنَ هاجِدَةَ الكَرَى عَن مَجهَلٍ","مِثل الأديمِ وَلاحِبٍ كالمِفرَقِ",33,"ق",1,0],["يبعث الارواحَ من اجدثها","منهُ عكس الشمس يشفى الارمدُ",34,"د",1,0],["يَبعّث مِنهُ النَّدى في المُحول","رَبيعا سَحائِبُه تَهطِل",35,"ل",1,1],["يبع دُنياه بالأُخرى","وَلا يصغي إِلى العَذلِ",36,"ل",1,0],["يبعِّد ذا ظلامَ الليل عنا","وهذا ظلمَ أوباشِ الرجال",37,"ل",1,0],["يبعث الخلق من دياجي قبورٍ","هشمتها تقلباتُ الزمانِ",38,"ن",1,0],["يبعثُ الأرضَ كل عامٍ فتحيا","بعد موتٍ بهيجةَ الأغصانِ",38,"ن",1,0],["يَبعَثُ النُّورَ في القلوبِ فَيَهدى","من يَشاءُ المحيطُ بالأكوان",38,"ن",1,0],["يبعث الشعر بهم صيحته","ليروا في السابحين الكادحين",39,"ن",1,0],["يبعّد بحر الشعر كالطفل درّة","ويدنيه منه وهو يلهو ويسخر",40,"ر",1,0],["يبعّدني طبعٌ عن الناس نافرٌ","فأحسبي بين الورى جالساً وحدي",41,"ي",1,0],["يبع برأس المال بالسوق ما اشترى","وكل اناء بالذي فيه ينضح",42,"ح",1,0],["يبعثته جنود الشرك ولت","وأهل الكفر قد هلكوا وباروا",43,"ر",3,0],["يبعث النائل الجسيم فيقفو","ه بمن على العفاة سفيه",44,"ي",2,0],["يَبعَث الآمس القَضية خلصا","مِن كَذاب مربدة عَريانه",45,"ن",2,0],["يَبعى عَلى حَدَثِ الزَمانِ وَرَيبِهِ","وَعَلى جَفائِكِ إِنَّهُ لَكَريمُ",46,"م",1,0],["يبعدك عن ربك وكثر العباده","وتصير لعبه في يدين الوراعين",47,"ن",1,0],["يبعث الروحَ مِن جديدٍ بجسمٍ","كاد يفنى فعاد بالروحِ حيا",48,"ي",2,0],["يبعث للترغيب مالاً ولل","ترهيب كم يشحذُ حدَّ الظبا",49,"ب",2,0],["يبعث الأحزان في أوصاله","ويثير الشك طورا والأسى",50,"س",2,0],["يبعد رجايا وتقصر غصب خطواتي","واموت من ليل يجرحني يبكيني",51,"ن",2,0],["يُبَعْثِرُهُ هَوَى الأحلامِ تِيهاً","ويجمعُ شِعرَهُ , لِمَ من شتاتِهْ؟!",52,"ت",2,0],["يبعث لي أكلي لها نشوة","أحسن من نشوة مسطار",53,"ر",1,0],["يَبعَثُ الدُّنيا نَشِيدًا","وهوَ بالأحبَابِ أَشفَق",54,"ق",1,0],["يبعث الحب في النهار ويغدو","في تخوم المساء أروع ساهر",55,"ر",1,0],["يبعث الروح في الحياة ويحيي","ماالذي مات في المسا أو كادا",56,"د",2,0],["يبعث الدفء في محيطي فأبقى","في انتظار لأن يشد ذراعي",57,"ع",2,0],["يبعث الله جنده كل حين","كي يُقيموا مشاعلا في المغارز",58,"ز",1,0],["يبعد اللي قريب ولا يقرب بعيد","ويثير فتنه وهي من طبعها ثايره",59,"ر",2,0],["يبعثرنا الزمان وتصطفينا","مخالبه وقد كمل النصاب",60,"ب",1,0],["يبعثرني ابتعادُكَ.. يعتريني","جنونُ القلبِ في سبعٍ عجافِ",61,"ف",1,0],["يبعد هموم القلب شوة محياه","والقلب مني يحضرن به نواميه",62,"ي",2,0],["يبعثرنا غياب الجسم لكن","حضور الروح يجمعنا سويا",63,"ي",2,0],["يبعثر الحزن أوراقي لتجمعها","كف الخريف بوهم ضل مسعاه",64,"ا",2,0],["يَبعَثُ اللهُ قَيِّمًا كلَّ قَرنٍ","يهتدي من هُداهُ كلُّ العُصاةِ",65,"ه",1,0],["‏ ‏يبعُدْن عنَّي باحتقار مُبْهَمٍ","‏ ‏ هل هُنّ حقاً هكذا أم ذا كذبْ؟",66,"ب",1,0],["يبعثُ القصفُ دخاناً أشيبا","ذا تصاوير تحاكي الدِّبَبا",67,"ب",2,0]]}