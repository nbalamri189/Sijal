لِّصٌ مِن كُلِّ مُعيٍ مُشكِلٍ","أَعيا سِواهُ بِأَحسَنِ التَخليصِ",38,"ص",1,0],["مُتَخَمِّطٌ يَطَأُ الرَّجِالَ شَهَامَةً","وَطْءَ الفَنِيقَ مَدارجُ القِرْدانِ",39,"ن",1,0],["مُتَخَيِّفات الوَشيِ تَحسَبُ زَهرها","خَلَعَت عَلَيهِ بُرودَهُنَّ الحورُ",40,"ر",1,0],["متخالفات خلقةً وطبيعةً","والطعم مُرٌّ حامض حلواء",41,"ا",2,0],["مُتخضِلاً برشاشه متعجّباً","من باردِ الكافور في غليَانِهِ",42,"ن",2,0],["مُتخمِّطٌ للعارِ يَشْنؤهُ","وبه الى حبِّ العُلى كَلَفُ",43,"ف",1,0],["مُتَخَصِّصٌ بِخَلائِقٍ لَو أَنها","قُطنٌ غَدَت مِنها لَنا حِبَراتٌ",44,"ت",1,0],["مُتَخمِّطٌ يَعِدُ الرّجا","لَ ودونهمْ خَرْقٌ مَضَلُّ",45,"ل",1,0],["مُتَخَمّطٌ يَلقَى الأسِنَّة حاسِراً","ثَبتَ الجنانِ كأنما هُو دارع",46,"ع",1,0],["متخرّقِ في البذل مدّةَ يسره","متجَلّد في عسره متجمّل",47,"ل",1,0],["مُتخالفُ الألوانِ يجمعُ شَملَهُ","ريحانُ ريحً ضبا وريحُ جَنوبِ",48,"ب",1,0],["متخيِّراً غرر السنين مواعداً","بنعيمهنَّ وسعدهنَّ بشيرا",49,"ر",2,0],["متخلق بالحلم لا يعتاده","غضبٌ ولا يسري إليه بمرصد",50,"د",1,0],["مُتَخَشّعاً لِلدَّهرِ أَلبسَ حُلَّةً","في النائِباتِ بعَولَةٍ وَتَبَلُّدِ",51,"د",1,0],["متخفف أي انني دمث","واخفه من حركته قدس",52,"س",1,0],["متخطرين بظل فردوس على","ماء فرات تحت طيب مجان",53,"ن",1,0],["مُتَخَشَِّعاً طَبِناً لِكُلِّ عَظيمةٍ","تَتلو القرانَ وأَنتَ ذِئبٌ أَغبَرُ",54,"ر",1,0],["مُتَخَصِّصٌ في التيه كم بحديثه","قد فسّروا السحر الحلال وأوّلُوا",55,"ل",3,0],["مُتَخلّقَ الشحَّ المطاع بمُرَّةٍ","ومحافظاً أَموالَهُ كوديعة",56,"ع",2,0],["متخبب ذملا يحفز مهره","خببا وآخر خلفه مخبوب",57,"ب",1,0],["مُتَخَرِّفٌ سَلَبَ الرَبيعُ رِدائَهُ","صَخِبُ الظَلامِ يُجيبُ كُلَّ نُهاقِ",58,"ق",1,0],["متخطياً حُجُجَ المعا","ذِرِ واثباً لومَ اللوائِمْ",59,"م",1,0],["متخطياً صُلْفَ الحَرِيزِ الى المَلا","ونَقَا الكثيبِ الى الكُراعِ الاوعَرِ",60,"ر",1,0],["متخذاً للوعظ أطراف القنا","عن منبرٍ حيث عليه أعوزا",61,"ز",2,0],["مُتَخنِّثاً مُتَأوِّداً فِي مَشيِهِ","فَكَأنَّهُ لَحمٌ بِلاَ عَظمِ",62,"م",1,0],["مُتَخيِّر الصحراء دار إقامة","إن الليوث ديارُها الصحراء",63,"ا",2,0],["متخيّر شم الأساتذة الأولى","بهم زهت دار العلو