{"poems":[[53,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[88,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[4,"أقوى وعري واسط فبرام","https://www.aldiwan.net/poem21194.html","الكامل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"لي أربعون من السنين","https://www.aldiwan.net/poem10868.html","مجزوء الكامل"],[51,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[91,"ما عز من لم يصحب الخذما","https://www.aldiwan.net/poem62738.html","عموديه"],[38,"طال العشاء ونحن بالهضب","https://www.aldiwan.net/poem7686.html","الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[45,"أرج لريا طلة رياه","https://www.aldiwan.net/poem66848.html","الكامل"],[28,"ولنا قراسية تظل خواضعا","https://www.aldiwan.net/poem5475.html","الكامل"],[80,"وفدت عليك سعادة الأعوام","https://www.aldiwan.net/poem31285.html","الكامل"],[44,"متخمط في غمرة متهتك","https://www.aldiwan.net/poem30013.html","الكامل"],[74,"يا لين عطفي واخضرار جنابي","https://www.aldiwan.net/poem12874.html","الكامل"],[74,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[48,"وملحة في العذل ذات نصيحة","https://www.aldiwan.net/poem64431.html","الكامل"],[48,"وملحة بالعذل ذات نصيحة","https://www.aldiwan.net/poem66631.html","الكامل"],[50,"يا ليلتي تزداد نكرا","https://www.aldiwan.net/poem62410.html","مجزوء الكامل"],[8,"أيا دار سلمى بالحرورية اسلمي","https://www.aldiwan.net/poem21840.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85784","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[118,"سيل همومي قد طغى عبابا","https://www.aldiwan.net/poem49337.html","الرجز"],[141,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[280,"ضربت إلى قصد الشهاب القوصي","https://www.aldiwan.net/poem32724.html","الكامل"],[284,"لله درك أي جنة خائف","https://www.aldiwan.net/poem34054.html","الكامل"],[303,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[400,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[450,"لم أنس موقف ساعة في موطن","https://www.aldiwan.net/poem13934.html","الكامل"],[459,"الله جارك من أخي شرف","https://www.aldiwan.net/poem15448.html","أحذ الكامل"],[466,"بركات عندي كاسمه بركات","https://www.aldiwan.net/poem60341.html","الكامل"],[549,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"]],"verses":[["مُتَخَلِّيَ الأَقطارِ إِلّا مِن جَوىً","وَنَشيجِ كُلِّ خَريدَةٍ مِعطارِ",0,"ر",1,0],["مُتَخَدِّدُ الخَدَينِ مُغ","بَرُّ الذَوائِبِ وَالضُفورِ",1,"ر",1,0],["مُتَخَشِّعٌ بَعدَ الأَنيسِ جَنابُهُ","مُتَضائِلٌ بَعدَ القَطينِ فِناؤُهُ",2,"ا",3,0],["متخاذلين بها وهم أعوانها","ومن البلاء تخاذل الأعوان",3,"ن",1,0],["مُتَخَصِّرينَ البابَ كُلَّ عَشِيَّةٍ","غُلباً مُخالِطُ فَرطِها أَحلامُ",4,"م",1,0],["مُتَخِذَاتٍ من الخَراشِيِّ كال","حِليَةِ منها السُّمُوطُ والحُقُبُ",5,"ب",1,0],["مُتَخَيَّرٌ لا للزَّكاءِ أَلِيِّةً","لكنْ ليُجرَحَ دونَ نَفْسِك مُجْرَحا",6,"ح",2,0],["مُتَخَوَّناً مُتَنَقَّصاً","منِّي مزيداً في الأبَدْ",7,"د",1,0],["متخصِّصٌ بالمجد إلا أنه","بفساد ما يسعى له متخصصُ",8,"ص",1,0],["متخصّراً قلماً نحيفاً جسمه","في وزن ضخم الشأن غير نحيفه",9,"ف",2,0],["مُتَخَمِّطٌ في سَيرِهِ مُتَأَوِّدٌ","كَالغُصنِ بَينَ صَباً وَبَينَ شَمالِ",10,"ل",1,0],["مُتَخاذِلينَ عَلى جَهالَتِهِم","إِنَّ القَوِيَّ يَهونُ مُنقَسِما",11,"م",2,0],["مُتَخَتِّمينَ عَلى مَعارِفَنا","نَثني لَهُنَّ حَواشِيَ العَصبِ",12,"ب",1,0],["متخاذِلَ الخُطُواتِ والأَقدامِ","وجلستُ تَحْتَ السِّنديانَةِ واجماً",13,"م",2,0],["مُتَخَضِّبٌ بِدَمِ الفَوارِسِ لابِسٌ","في غيلِهِ مِن لِبدَتَيهِ غيلا",14,"ل",2,0],["متخرِّقٌ في العُرْف منبسطٌ","متأزِّرٌ بالمجدِ مشتمِلُ",15,"ل",1,0],["مُتَخَلِّقٌ مِن حُسنِ كُلِّ خَليقَةٍ","كَعُطارِدٍ في طَبعِهِ المُتَمَزِّجِ",16,"ج",1,0],["مُتَخَيِّرٌ أَلفاكِ خيرَةَ نَفسِهِ","مِمَّن نَآهُ الوُدُّ أَو أَدناهُ",17,"ا",2,0],["مُتَخَمِّطٌ قَطِمٌ لَهُ عادِيَّةٌ","فيها الفَراقِدُ وَالسِماكُ الأَعزَلُ",18,"ل",1,0],["مُتخَتّمٌ لعُفاتهِ وَعُداتِهِ","بالجود أو بقبيعة الصمصامِ",19,"م",1,0],["مُتَخَمِّطٌ في غَمرَةٍ مُتَهَتِّكُ","ما إِن يُبالي أَيَّ وَجهٍ يَسلُكُ",20,"ك",1,1],["مُتَخايِلٌ في صَدرِ كُلِّ جَريدَةٍ","بِقَصيدَةٍ وَكَتيبَةٍ لِكِتابِ",21,"ب",1,0],["مُتَخايِلاً أَمشي البَرازَ وَدونَهُ","مِن أَرقَمٍ سِدرٌ أَلُفُّ وَضالُ",22,"ل",1,0],["مُتَخَوِّفاً منه المصيرَ لِمَنْزِلٍ","مُسْتَوْبِل المَرْعَى وبيل المَوْرِدِ",23,"د",1,0],["مُتَخَلٍّ من اثنتينِ بريءٌ","من إمامٍ عَدْلٍ ودينٍ حنيف",24,"ف",1,0],["مُتَخَرسِنٍ دينُ النَصارى دينُهُ","ذي قُرطُقٍ لَم يَتَّصِل بِبَنائِقِ",25,"ق",1,0],["متخرّسٍ دينُ النصارى دينهُ","ذي قُرطقٍ لم يتّصل ببنائقِ",26,"ق",1,0],["مُتَخَشِّعاً تَحتَ الهَوى","عَشراً وَتَحتَ المَوتِ عَشرا",27,"ر",2,0],["مُتَخَمِّطاً فِيما أُصيبَ مِن ال","دَرواءِ مِثلَ تَخَمطُِّ القَرمِ",28,"م",1,0],["متخذاً لنفسه","من ثديها وساده",29,"ه",1,0],["مُتخلفين عن الزمان كأنهم","أشباحُ كهفٍ أو ظلالُ مساحرِ",30,"ر",1,0],["مُتَخَشِّعَاً أَمْشِي الضَّرَّاءَ كَأَنَّنِي","أَخْشَى الْفُجَاءَةَ مِنْ صِيَالِ أَعَادِي",31,"ي",1,0],["مُتخيّرٌ مِنْ كل مَعْنىً يَانِعٍ","يُكْسَى عَلى قدَرٍ بِثَوْبٍ زَاهِرِ",32,"ر",1,0],["مُتَخَيراً حُلْوَ الجَنَى","أَو ناقِراً صَفْوَ الغَدِيرْ",33,"ر",1,0],["متخيراً منهنَّ ما أبتكر الضحى","من لؤلؤٍ غب السحابِ الغادي",34,"ي",1,0],["متخاذلُ الأسلوب، ليس بمُفهمٍ","معنى، ولو نطق الجماد فأفهما",35,"م",2,0],["متخذاً جراحه أكوابا","بكرهه ودمه شرابا",36,"ب",2,0],["مُتَخَطَّفٌ لَم يُغنِ عَنهُ قَومُهُ","شَيئاً بَلِ اِندَفَعوا وَقَد قيلَ اِدفَعوا",37,"ع",3,0],["مُتَخَلِّصٌ مِن كُلِّ مُعيٍ مُشكِلٍ","أَعيا سِواهُ بِأَحسَنِ التَخليصِ",38,"ص",1,0],["مُتَخَمِّطٌ يَطَأُ الرَّجِالَ شَهَامَةً","وَطْءَ الفَنِيقَ مَدارجُ القِرْدانِ",39,"ن",1,0],["مُتَخَيِّفات الوَشيِ تَحسَبُ زَهرها","خَلَعَت عَلَيهِ بُرودَهُنَّ الحورُ",40,"ر",1,0],["متخالفات خلقةً وطبيعةً","والطعم مُرٌّ حامض حلواء",41,"ا",2,0],["مُتخضِلاً برشاشه متعجّباً","من باردِ الكافور في غليَانِهِ",42,"ن",2,0],["مُتخمِّطٌ للعارِ يَشْنؤهُ","وبه الى حبِّ العُلى كَلَفُ",43,"ف",1,0],["مُتَخَصِّصٌ بِخَلائِقٍ لَو أَنها","قُطنٌ غَدَت مِنها لَنا حِبَراتٌ",44,"ت",1,0],["مُتَخمِّطٌ يَعِدُ الرّجا","لَ ودونهمْ خَرْقٌ مَضَلُّ",45,"ل",1,0]]}