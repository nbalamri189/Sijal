مل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82242","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144014","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116684","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95529","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87918","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100220","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62888","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138567",""],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106797","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206168","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117958","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131249",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86508","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86465","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91047","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90872","الكامل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117199","الكامل"],[4699,"عذراً رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=153987",""],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""],[4869,"بردانه","https://www.poetsgate.com/ViewPoem.aspx?id=151541",""],[4908,"عدْ يا ضنايَ","https://www.poetsgate.com/ViewPoem.aspx?id=207337",""],[5057,"الذكرى العاشرة","https://www.poetsgate.com/ViewPoem.aspx?id=214118",""],[5131,"ودَّعتُهُ وعلى فؤادي حسرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175584",""],[5273,"حمى","https://www.poetsgate.com/ViewPoem.aspx?id=191955",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5431,"رجولة...كالسهم يعبرُ شامخا لن تُخضعَه!!","https://www.poetsgate.com/ViewPoem.aspx?id=198116",""],[5431,"ملكَ القصيدة قبلةً قبلهْ!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200159",""],[5431,"تغريبة الحضارة العربية ...","https://www.poetsgate.com/ViewPoem.aspx?id=212197",""],[5526,"الياس","https://www.poetsgate.com/ViewPoem.aspx?id=192390",""],[5628,"شمس الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=178541",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5897,"إيه .. يا جنة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=176413",""],[5956,"من طبع أرتين","https://www.poetsgate.com/ViewPoem.aspx?id=205426",""],[5956,"اختصكِ الرحمن بالتوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=207452",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6093,"الكلام يشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204829",""]],"verses":[["مُتَخَلِّيَ الأَقطارِ إِلّا مِن جَوىً","وَنَشيجِ كُلِّ خَريدَةٍ مِعطارِ",0,"ر",1,0],["مُتَخَدِّدُ الخَدَينِ مُغ","بَرُّ الذَوائِبِ وَالضُفورِ",1,"ر",1,0],["مُتَخَشِّعٌ بَعدَ الأَنيسِ جَنابُهُ","مُتَضائِلٌ بَعدَ القَطينِ فِناؤُهُ",2,"ا",3,0],["متخاذلين بها وهم أعوانها","ومن البلاء تخاذل الأعوان",3,"ن",1,0],["مُتَخَصِّرينَ البابَ كُلَّ عَشِيَّةٍ","غُلباً مُخالِطُ فَرطِها أَحلامُ",4,"م",1,0],["مُتَخِذَاتٍ من الخَراشِيِّ كال","حِليَةِ منها السُّمُوطُ والحُقُبُ",5,"ب",1,0],["مُتَخَيَّرٌ لا للزَّكاءِ أَلِيِّةً","لكنْ ليُجرَحَ دونَ نَفْسِك مُجْرَحا",6,"ح",2,0],["مُتَخَوَّناً مُتَنَقَّصاً","منِّي مزيداً في الأبَدْ",7,"د",1,0],["متخصِّصٌ بالمجد إلا أنه","بفساد ما يسعى له متخصصُ",8,"ص",1,0],["متخصّراً قلماً نحيفاً جسمه","في وزن ضخم الشأن غير نحيفه",9,"ف",2,0],["مُتَخَمِّطٌ في سَيرِهِ مُتَأَوِّدٌ","كَالغُصنِ بَينَ صَباً وَبَينَ شَمالِ",10,"ل",1,0],["مُتَخاذِلينَ عَلى جَهالَتِهِم","إِنَّ القَوِيَّ يَهونُ مُنقَسِما",11,"م",2,0],["مُتَخَتِّمينَ عَلى مَعارِفَنا","نَثني لَهُنَّ حَواشِيَ العَ