{"poems":[[79,"وهت مني القوى بطريق شاط","https://www.aldiwan.net/poem36481.html","الوافر"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[53,"ورياض تخايل الأرض فيها","https://www.aldiwan.net/poem61829.html","الخفيف"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[30,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[99,"داوِ ناري والتياعي","https://www.aldiwan.net/poem24791.html","مجزوء الرمل"],[46,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[48,"هياما يصير الجسم في هامد الثرى","https://www.aldiwan.net/poem23339.html","الطويل"],[48,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39582","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147505","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19310","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141969","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[121,"قيثار1","https://www.aldiwan.net/poem24075.html","الخفيف"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[275,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[309,"سرى البرق من نجد فهيج لي شجوي","https://www.aldiwan.net/poem16861.html","الطويل"],[411,"وهت عزماتك عند المشيب","https://www.aldiwan.net/poem49377.html","المتقارب"],[438,"هو ملتقى أرج النواسم فانظرا","https://www.aldiwan.net/poem12311.html","الكامل"],[438,"صاحبت في سفري لك الآمالا","https://www.aldiwan.net/poem12397.html","الكامل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[519,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[572,"قد جاد طيفك لي بوعدك","https://www.aldiwan.net/poem69734.html","مجزوء الكامل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53731","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39224","الكامل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145642","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59215","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133817","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64772","الوافر"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18422","الرجز"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126643","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65952","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65991","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205426","الخفيف"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37522","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92069","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70015","الطويل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111198","الكامل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34760","الهزج"],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4755,"هَا قَدْ أَسَالَ دَمِي.. وخَطَّا","https://www.poetsgate.com/ViewPoem.aspx?id=187695",""],[4858,"الى حقود لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=35295",""],[4927,"الوداع المحزن","https://www.poetsgate.com/ViewPoem.aspx?id=29644",""],[4927,"الْحُبُّ الْمُتَوَقِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=29846",""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5376,"يا ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5790,"هي دارهم وأنا المحب المغرم","https://www.poetsgate.com/ViewPoem.aspx?id=112128",""],[5858,"نقش معلمي","https://www.poetsgate.com/ViewPoem.aspx?id=187984",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5908,"تعرفت منهم بالغربين أربعا","https://www.poetsgate.com/ViewPoem.aspx?id=170975",""],[5977,"سعادة وأمان","https://www.poetsgate.com/ViewPoem.aspx?id=212739",""],[6046,"إسلامي في عصر الكفر","https://www.poetsgate.com/ViewPoem.aspx?id=37429",""],[6142,"لا تسل ما جرى بميلاده الأز","https://www.poetsgate.com/ViewPoem.aspx?id=155704",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[5001,"وهتفت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80716&r=&rc=6",""],[572,"قد جَادَ طيفُكَ لي بِوَعْدِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9226&r=&rc=83",""]],"verses":[["وهَتْ منّي القُوى بطَريقِ شاطِ","ودارَ على تألُّمي الإزارُ",0,"ر",1,1],["وَهَتْ كُلُّ دِرْعٍ فَانْثَنَى كُلُّ مُنْصُلٍ","سِوَى صَاعِدٍ والموتُ للموت يَنْهَدُ",1,"د",1,0],["وَهَتْ قُبَّةُ الإسلام حتى اجْتَبيتَهُ","فقد أصْبَحَتْ مَعْمُودَةً بِعَمُودها",2,"د",3,0],["وهتافُ المفجِّعات أرانيمُ","شجا البائسات فيهن بادي",3,"د",2,0],["وهتفتُ يا روحَ الجمالِ تَدَفَّقي","كالنَّهرِ في فِكري وفي أَحلامي",4,"ي",1,0],["وهَتّكِ ستْراً في الحَشَا كان مُسْبَلاً","على الشّوقِ حتّى عَنّفَتْني أَقاربي",5,"ب",2,0],["وهتكتَ سِتْرَ الباطنيّةِ بعدَما","لُطَّتْ وراءَ غُيوبِها الأستارُ",6,"ر",1,0],["وَهَتَّكَتِ الأَطنابَ كُلُّ عَظيمَةٍ","لَها تامِكٌ مِن صادِقِ النِيِّ أَعرَفُ",7,"ف",1,0],["وهتاف القلب بالشك","وى على غير انتفاع",8,"ع",1,0],["وَهَتَّكتُ بِالقَولِ الخَنا حُرمَةَ العُلى","وَأَسلَكتُ حُرَّ الشِعرِ في مَسلَكِ العَبدِ",9,"د",1,0],["وَهَتَّكَتِ الأَقدارُ بَعدَ صِيانَةٍ","أَيامى نِساءٍ ما تَخَوَّفنَ أَيّاما",10,"م",2,0],["وَهَت أَديانُهُم مِن كُلِّ وَجهٍ","فَهَل عَقلٌ يُشَدُّ بِهِ عُراها",11,"ا",3,0],["وهتافٌ بالشاطئين صداه","تَتناجى بهِ الملوكُ الصيدُ",12,"د",1,0],["وهُتافُ روحي في خِضمٍّ صاخبٍ","خِلتُ الفضاء الرَّحبَ فيه يغرقُ",13,"ق",1,0],["وهت عقود كان في عصره","أحكمها لا عاقد ما وهى",14,"ه",2,0],["وَهَتَفَت تَقولُ لِلأَغرارِ","مَقالَةَ العارِفِ بِالأَسرارِ",15,"ر",1,0],["وهَتِ العزائمُ للمصاب فلم تطق","أجسادها أن تحملَ الأكبادا",16,"د",2,0],["وهُتَافُ الإِخْلاَصِ يَخترِق الْجوَّ","فتُمْليه واضِحاً أَصْداؤه",17,"ا",3,0],["وهتكنا مخابيء الإثم في الحيّ","وعدنا نفتّش الأكفانا",18,"ن",2,0],["وهُتافي على الرُّبا والفَيافي","ونَشِيدي وعِزَّتي وخضوعي",19,"ع",2,0],["وهتافهم ما رن","أصفرك الأغر له رنين",20,"ن",1,0],["وهَتَفتَ من ذكرِ المَصيفِ وذكرها","ما كان أطيَبَهُ وأطيَبَ فاها",21,"ا",3,0],["وهتافة ورقاء في عذباتها","تذكر عهداً كان والغصن لم يذو",22,"و",1,0],["وَهَت عزماتُكَ عندَ المشيبِ","وما كانَ من حَقِّها أن تَهِي",23,"ت",3,1],["وهَتَكْتُ جَيْبَ الدَّنِّ عن مَشْمُولَةٍ","تُلْقِي على السَّقِي رِداءً أَحْمَرا",24,"ر",2,0],["وهتفتُ باسْمِكَ وهو فأْلٌ صادقٌ","فَوَجَدْتُه في راحَتَيْك نَوالا",25,"ل",2,0],["وهَتَفْتُ فِي جُنْدِ الصَّبا فأَجَابَني","فِي كُلِّ صَبٍّ بالأَحِبَّةِ صَابِ",26,"ب",1,0],["وَهَتَّكَت سَترَ الدُجى أَنوارُهُ","وَأَسبَلَت عَلى الوَرى أَستارُهُ",27,"ه",1,0],["وهتَكْتُ عن سِينِ الثّنايا لِثامَها","فأبصَرْتُ عينَ الخَضْرِ في ظُلمةِ الشَّعْرِ",28,"ر",1,0],["وَهَتَكْتُ سِتْرَ ضِياءِ جِسْ","مِكَ من فُتُوقِ سحابِ بُرْدِكْ",29,"ك",1,0],["وهَتَكْنَ ثِنْيَ الليل عن","بيض السَّوالفِ والصّفاحِ",30,"ح",1,1],["وهَتكتُ أستارَ الوَقار ولَمْ أُبَل","للباقِلا تَلْحظ بطرفٍ أَشْوسِ",31,"س",1,0],["وَهَتْ كُلُّ أَرْكانِ العُرُوبةِ فَجْأَةً","وما خِلْتُ في يَومٍ أَرَى الحَقَّ وَاهِيا",32,"ي",2,0],["وَهتكتُ أمْرَ الحُبّ فيكَ وَطَابَ لِي","خَلْعُ العِذَارِ عَلَى العِذَارِ السُّنْدُسِي",33,"س",2,0],["وهتافُ الينبوع يُوعِدُ بالخصب","وصمتُ الصحراء تحتَ الرمِال",34,"ل",1,0],["وهتْكُ السِّتْرِ صبرُ عنها","إِذا غَنّتْهُ مِنْ خِلْفِ السِّتارَهْ",35,"ر",2,0],["وَهَتفى مُعطيةً طَروحا","حَيثُ تُلافي الأَبَرَّةُ القَبيحا",36,"ح",2,0],["وهتكت سرا غامضاً","حتى على الرجل البصير",37,"ر",1,0],["وَهَت بُحُورُ العِدى وَالنُجبُ حامِلَةٌ","تِلكَ القِبابَ عَلَيها الوَشيُ وَالحبَرُ",38,"ر",1,0],["وهتك ستره","لمصرع الفيلسوف المنتخب",39,"ب",1,0],["وهت عروة الاسلام فانجذ أصله","ومات ولكن ماله من مآتم",40,"م",1,0],["وهتاف الذكرى يردد في النف","س أغاني نشيده المنغوم",41,"م",1,0],["وَهَتَكْتُمْ حَريمَ كُلِّ مَجيدِ","فَاخْسَأُوا يا كِلابَ شَرِّ العِبادِ",42,"د",1,0],["وهَتْ لنظامِ المُلكِ أَركانُ معَشَرٍ","وعاد نظامُ الدينِ فالْتأم الكَسر",43,"ر",1,0],["وهت مهجةٌ جَرْحَى بكت أعين مَرْهى","فيا دمعُ ما أجرى ويا حزمُ ما أوهى",44,"ه",2,1],["وهُتَّاف بألحان","وسُمَّار على الحانِ",45,"ن",1,0],["وَهتفتُ إِن كانَ ابن ماريا ناي","عَن بَيت لَحم فَلا بُلوغ لَمأربي",46,"ب",2,0],["وهتكت فيه فروج كل مفاضة","زرت على ذي لبدتين غشمشم",47,"م",1,0],["وَهَتَّكتِ سُتورَ البَي","تِ لِلوَحشَةِ وَالوِحدَه",48,"د",2,0],["وهُتّكت الستور عن المعاصي","وقد نشرت صحائف والبنود",49,"د",1,0],["وهَتَفتُ: خُذْنِيْ فَالسَّمَا","أَطَّتْ, وظَهْرُ الأرضِ أَطَّا",50,"ط",2,0],["وهتكتَ السِّتْرَ حتّى","بان ما أخفى حريرُهْ!",51,"ر",2,0],["وَ هَتَفْتَ : يَا عَفْراءُ! هَلْ مِنْ نَظْرَةٍ؟","وَأَضَاْعَ صَوْتَكَ فِي الزُّحَاْمِ عَوِيْلُ!",52,"ل",1,0],["وَهَتَفْتَ: يَاْ عَفْرَاْءُ! إِنِّيْ عَاْشِقٌ","وَمُشَرَّدٌº أَرْعَى الْهَوَىْº وَالْغِيْدَاْ",53,"د",2,0],["وهتافهم ياأرض أنت حياتنا","كيف الخنوع وأنت منطلق الشمم",54,"م",1,0],["وهتكُ أعراضنا والشمسُ ساطعةٌ","فقد غدونا بذات الشأنِ عميانا",55,"ن",2,0],["وهتافُ الحقِّ يلاحقُه","صهيونٌ جاء بلا عللِ",56,"ل",1,0],["وهتكت خدر الليث وهو ممنع","ولثمت خد الرئم وهو منعم",57,"م",1,0],["وهتفت \"لبيك\" القصيدة إنني","ها قد لبست اليومَ ثوبَ المُحرِمِ",58,"م",1,0],["وهتفت أسألها الرجوع لضيعتي","ما ردّ صوت قد يريح مسامعي",59,"ع",2,0],["وهت بعد ما الورى الخليط مقوضا","وأزمع عنها أنسها حين أزمعا",60,"ع",2,0],["وهتفت يا رحمن اغفر زلتي","ما خاب عبدٌ صادقٌ ما خابا",61,"ب",2,0],["وهتافُ العزّةِ تَخْنُقُهُ","غُصَصٌ مِنْ ضَعْفٍ .. بلْ عارِ",62,"ر",1,0],["وهتاف البطحاء من كل وجهٍ","بضروب التكبير والتحميد",63,"د",1,0],["وهتفت والدنيا تردد عاليا","شر المباديء ما يباع ويشترى",64,"ر",2,0],["وهتفت أدعو من فؤاد خاشع","ربي اغثنا فالبلاء جسيم",65,"م",1,1],["وهتكْتُ سِتْرَ ضياءِ جِسمِكَ","في فنونِ سجافِ بُرْدِكْ",66,"ك",1,0]]}