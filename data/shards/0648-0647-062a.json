{"poems":[[77,"وهت مني القوى بطريق شاط","https://www.aldiwan.net/poem36481.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"تحلبت الأنواء بعد جمودها","https://www.aldiwan.net/poem9994.html","الطويل"],[51,"ورياض تخايل الأرض فيها","https://www.aldiwan.net/poem61829.html","الخفيف"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[28,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[97,"داوِ ناري والتياعي","https://www.aldiwan.net/poem24791.html","مجزوء الرمل"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[46,"هياما يصير الجسم في هامد الثرى","https://www.aldiwan.net/poem23339.html","الطويل"],[46,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39582","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147505","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19310","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141969","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"]],"verses":[["وهَتْ منّي القُوى بطَريقِ شاطِ","ودارَ على تألُّمي الإزارُ",0,"ر",1,1],["وَهَتْ كُلُّ دِرْعٍ فَانْثَنَى كُلُّ مُنْصُلٍ","سِوَى صَاعِدٍ والموتُ للموت يَنْهَدُ",1,"د",1,0],["وَهَتْ قُبَّةُ الإسلام حتى اجْتَبيتَهُ","فقد أصْبَحَتْ مَعْمُودَةً بِعَمُودها",2,"د",3,0],["وهتافُ المفجِّعات أرانيمُ","شجا البائسات فيهن بادي",3,"د",2,0],["وهتفتُ يا روحَ الجمالِ تَدَفَّقي","كالنَّهرِ في فِكري وفي أَحلامي",4,"ي",1,0],["وهَتّكِ ستْراً في الحَشَا كان مُسْبَلاً","على الشّوقِ حتّى عَنّفَتْني أَقاربي",5,"ب",2,0],["وهتكتَ سِتْرَ الباطنيّةِ بعدَما","لُطَّتْ وراءَ غُيوبِها الأستارُ",6,"ر",1,0],["وَهَتَّكَتِ الأَطنابَ كُلُّ عَظيمَةٍ","لَها تامِكٌ مِن صادِقِ النِيِّ أَعرَفُ",7,"ف",1,0],["وهتاف القلب بالشك","وى على غير انتفاع",8,"ع",1,0],["وَهَتَّكتُ بِالقَولِ الخَنا حُرمَةَ العُلى","وَأَسلَكتُ حُرَّ الشِعرِ في مَسلَكِ العَبدِ",9,"د",1,0],["وَهَتَّكَتِ الأَقدارُ بَعدَ صِيانَةٍ","أَيامى نِساءٍ ما تَخَوَّفنَ أَيّاما",10,"م",2,0],["وَهَت أَديانُهُم مِن كُلِّ وَجهٍ","فَهَل عَقلٌ يُشَدُّ بِهِ عُراها",11,"ا",3,0],["وهتافٌ بالشاطئين صداه","تَتناجى بهِ الملوكُ الصيدُ",12,"د",1,0],["وهُتافُ روحي في خِضمٍّ صاخبٍ","خِلتُ الفضاء الرَّحبَ فيه يغرقُ",13,"ق",1,0],["وهت عقود كان في عصره","أحكمها لا عاقد ما وهى",14,"ه",2,0],["وَهَتَفَت تَقولُ لِلأَغرارِ","مَقالَةَ العارِفِ بِالأَسرارِ",15,"ر",1,0],["وهَتِ العزائمُ للمصاب فلم تطق","أجسادها أن تحملَ الأكبادا",16,"د",2,0],["وهُتَافُ الإِخْلاَصِ يَخترِق الْجوَّ","فتُمْليه واضِحاً أَصْداؤه",17,"ا",3,0]]}