{"poems":[[88,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[74,"لا وخمر بابليه","https://www.aldiwan.net/poem20560.html","مجزوء الرمل"],[87,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[435,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110735","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38188","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38706","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119965","الرمل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121183","الخفيف"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22590","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94131","السريع"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66373","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[5431,"جدّ باهظ...","https://www.poetsgate.com/ViewPoem.aspx?id=202658",""],[3294,"يا راكب الجسرة للجسر","https://www.poetsgate.com/ViewPoem.aspx?id=173269",""],[5670,"جئتُ يا شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=211123",""]],"verses":[["حاتِمَ الطُليانِ قَد قَلَّدتَنا","مِنَّةً نَذكُرُها عاماً فَعاما",0,"م",2,0],["حاتميِّ الكف يثني","من أذى الدهر عديَّه",1,"ي",2,0],["حاتِمُ لَو شامَها","أَقلَعَ عَمّا زَعَم",2,"م",1,0],["حاتِمُ المُلوكِ إِذا","ضاقَ بِالنَدى النَشَبُ",3,"ب",1,0],["حاتم بالجود لكن","كفه بالبذل اسمح",4,"ح",1,0],["حاتمُ الجود أحنفُ الحلم قيسُ الرأي","عمرو والإقدام كسرى عدلا",5,"ل",2,0],["حاتميُّ السَّماحُ يخلي بيوتَ ال","مال جوداً ويملأُ الدَّهر فضلا",6,"ل",2,0],["حاتم الجود والسماحة بحر","سائغ للورود والرواد",7,"د",1,0],["حاتَمُ الجُودِ وَأَعلى كَرَما","من يَسُمْهُ بالعَطا لم يبخسِ",8,"س",1,0],["حاتمُ الجودِ سَخِيُّ العَربِ","أَخجَلَت كَفّاهُ سَحَّ المَطرِ",9,"ر",1,0],["حاتمُ الجودِ هوَ البحرُ تَرى","أَيّ بَحرٍ من نراه لا يُمَد",10,"د",1,0],["حاتم عبدك بالجو","دِ وكعب لك خادم",11,"م",1,0],["حاتم طي كل نجل جواد","حاتم العصر عين رفد معين",12,"ن",1,0],["حاتِمٌ لَو كانَ حَيّاً","عاشَ في ظِلِّ جَناحي",13,"ح",2,0],["حاتمة بالجود وهي التي","كانت لنا في عصرنا حاتمه",14,"م",2,0],["حاتم الجود والندى أحنف ال","حلم إياس الذكاء بالاتفاق",15,"ق",1,0],["حاتمٌ في الجُود بحرٌ ف يالكرم","ملجأ الوفد إذا ما الخَطب جال",16,"ل",1,0],["حاتميّ الفؤاد شهدٌ مصفّى","وكنانيٌ في النهى مثل جاحظْ",17,"ظ",1,0],["حاتم طي قد طوى ذكره","بنشر جود طيب النشر",18,"ر",1,0],["حاتميُ البشر كم صوّرتَه","مُقتراً يمنع إخراجَ الزكاة",19,"ه",1,0]]}