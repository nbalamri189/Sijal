"","https://poetry.dctabudhabi.ae/diwan/poem/125786","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133231","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90910","المجتث"],[4281,"","https://poetry.dctabudhabi.ae/diwan/poem/73890","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133165","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72416","المنسرح"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136399",""],[4755,"ماذا عَنِ الحُبِّ –قالت مُهْرَةٌ- ودَنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=184816",""],[5102,"بنت السجان","https://www.poetsgate.com/ViewPoem.aspx?id=12893",""],[5186,"حسبك الجهد بذله لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=156491",""],[5351,"موعد الله","https://www.poetsgate.com/ViewPoem.aspx?id=202649",""],[5616,"رؤية","https://www.poetsgate.com/ViewPoem.aspx?id=203340",""],[5725,"مالي ارى الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=215175",""],[5786,"حتّامَ دمعك في الأطلال ينسكبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50654",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5966,"حومة فكر","https://www.poetsgate.com/ViewPoem.aspx?id=158864",""],[6102,"سارة","https://www.poetsgate.com/ViewPoem.aspx?id=184409",""],[6148,"يا رب عفوك","https://www.poetsgate.com/ViewPoem.aspx?id=201836",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6344,"فلسفة الضّياع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87975&r=&rc=15",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["لأنني عالمٌ بأنك لا","تعتِبُ فيما أصلحتُ من عملي",0,"ل",2,0],["لأنني يلزمني","كلُّ الذي يلزمُهُ",1,"م",2,0],["لأنني إن تُهْتُ في جيرتي","بنائِكٍ أخْتيَ سُفِّهْتُ",2,"ت",1,0],["لِأَنَّني قَد حِرتُ في التَفَكُّرِ","لَمّا سَمِعتُ أَنَّهُ مِن سُكَّرِ",3,"ر",1,0],["لأنني منْ بينكمْ","رُبيتُ حرّاً ديِّنا",4,"ن",2,0],["لأنني كلُّ الفنا","ألقاهُ منْ بعضِ الفندْ",5,"د",1,0],["لا نَنثُرُ الدُرَّ فيهِ بَينَنا كَلِماً","حَتّى أُقَبِّلُهُ مِن مَبسَمٍ نَسَقا",6,"ق",2,0],["لَإِن نَزَحَت دارٌ بِلَيلى لَرُبَّما","غَنينا بِخَيرٍ وَالزَمانُ جَميعُ",7,"ع",1,1],["لا نَنشُدُ العَهدَ المُؤَكَّدَ بَينَنا","النيلُ عَهدٌ دائِمٌ وَذِمامُ",8,"م",1,0],["لِأَنَّني أُكرِمُ عِرضي وَلا","أَقرُنُهُ يَوماً إِلى عِرضِكا",9,"ك",2,0],["لاَ نَنْسَ حَقّاً لِلْكِنَانَةِ وَاجِباً","إِيْفَاؤُهُ وَلِقوْمِهَا الأَمْجَادِ",10,"د",1,0],["لاَ نَنْسَ عَهْدَ جَنِيفَ وَالإِلْفَ الَّذِي","عَادتْ طَوَالِعُهُ بِخَيْرِ تَوَالِي",11,"ل",2,0],["لأنني جزّأته نصفه","سيفي ، ونصف داخلي مستشار",12,"ر",1,0],["لأنني منها ، فمي بعضها","يخاف لا تدري غداً أين فوك",13,"ك",1,0],["لأنني إن تُهْتُ في حيرتي","بنائك أخْتي سُفِّهْتُ",14,"ت",1,0],["لأنني لم أجد أخا ثقة","يسلم عند انتقاد منتقد",15,"د",1,0],["لأنني عالمٌ بأنك لو","شممت ريا نسيمها العطر",16,"ر",1,0],["لأنني عاقلٌ ويعجبني","لزوم بيتي وأكره السفرا",17,"ر",2,0],["لِأَنَّني طِرتُ إِلى غايَتي","طِفلاً وَأَشياخُهُم تَحبو",18,"ب",2,0],["لِأَنَّني في حالَةِ الظاهِرِ وَال","باطِنِ لِمَشهَدِ بِالغَيبِ مُقِر",19,"ر",1,0],["لِأَنَّني كَفَرتُ أَعمالي فَأَو","رَدتُ سَراباً عِندَهُ اللَهُ حَضَر",19,"ر",1,0],["لإن نقاء النفس من كدر العمى","يكونُ بإمساكٍ وصومٍ وصحة",20,"ه",1,0],["لأنّني أرى به فُتورا","لولاه ما كان يُرى مقهُورا",21,"ر",2,0],["لأنّني قد سكنتُ بيتاً","دارتْ على بابه الدوائرْ",22,"ر",1,0],["لانَّنِي فِيهِ عَلَى نِيَّةٍ","يُخبِرُ عَن بَاطِنِهَأ الظَّاهِرُ",23,"ر",1,0],["لِأَنَّني لا اَرى بِعَيني","مَن هُوَ مِن طينَةِ الكِرامِ",24,"م",1,0],["لِأَنَّني ما تَرَكتُ قَطَّ يَدي","مُذ كُنتُ طِفلاً إِلّا عَلى النُقَطِ",25,"ط",1,0],["لِأَنَّني لَستُ أَرضى لَئمَ مُبتَسِمٍ","إِن لَم يَكُن لِيَ في إِغريضِهِ غَرضُ",26,"ض",1,0],["لإن نحنث متنا فآياتنا","تقوم مدى الدهر من بعدنا",27,"ن",2,0],["لأنَّني عن شَمِّ تُربِ بابِهمْ","يَقصُرُ مِثلي ويَكِلُّ مَلْمَحي",28,"ح",2,0],["لأنني من ظله","في ذمة لا تخفر",29,"ر",1,0],["لأنَّني مُسافِرٌ","قصدَ الدَّوا سَلِمتُمُ",30,"م",1,0],["لأنني عندي أنا وعندكم","وعنده لا شيء عال ودني",31,"ن",2,0],["لأنني عن أمره","كن فيكون باعتنا",32,"ن",2,0],["لأننا خلق له","بأمره كوَّننا",32,"ن",2,0],["لأَنني أَرْتَجِي عَلَيْها","منَ مَالِكِي أَلْفَ أَلْفِ بَدْره",33,"ر",2,0],["لا ننسكم ما يينا أو نرى بدلاً","أنى يكون ونار البين تكوينا",34,"ن",2,0],["لا ننسَ من غدقت اكفهمو على","مشروعنا كغيوث بر تهطل",35,"ل",1,0],["لا ننسَ معركة الازهار تذكرنا","مجدا قديما ومجهودات سكان",36,"ن",1,0],["لِأَنَّ نَجاحَ الصَقعِ في حُسنِ أَهلِهِ","إِذا كانَ أَمرِ الوُدِّ في القَومِ مُحكَما",37,"م",2,0],["لأنني لا أقُومُ مِن أوَدي","ما دمتُ حتَّى تَقومَ مِن أوَدِك",38,"ك",1,0],["لا نَنبا الغَيثَ عَن سِهامٍ وَلازا","ل تَمُجُّ المياهَ رَيّاً سِهامُ",39,"م",1,0],["لأَنَّنا من عترة المُصطَفى","زرنا إِمامين إِمامين",40,"ن",1,0],["لِأَنني صرتُ مَحسوباً عَلَيكَ وَلا","أَنفكُّ عَنكَ إِلى أَن يَنتَهي أَجَلي",41,"ل",2,0],["لأَنّ نصف الناسِ أَعداء لِمَن","قَد ولي الحكم وبِالعَدل اِقتَرن",42,"ن",1,0],["لأنني حر أديبٌ فلا","أُطيق للشتم ولا السب",43,"ب",1,0],["لأنني رب إملاقٍ ومسْكنةٍ","وأنتمُ أهلُ توفيرٍ وتكثيرِ",44,"ر",1,0],["لأنني لمْ أسَاومْ","ما عِشتُ أوْ أتزلفْ",45,"ف",1,0],["لأنني من يعتيريه إذا","أبصر أطباقك مثل الطرب",46,"ب",1,0],["لأنني ما برحت أهدي","رائق نثري له ونظمي",47,"م",2,0],["لا نَنَسى ما لَدَيكَ فينا مِن يَدٍ أَبَداً","تَطوق بِالجَميل الجيدا",48,"د",2,0],["لأنني منكَ في عزٍّ وفي دعةٍ","وهكذا كنتُ في أهلي وفي وطني",49,"ي",1,0],["لأنني أمنت رزايا الدهور","وإن حل خطب فلن أجزعا",50,"ع",2,0],["لأَنني قَدمتهُم لِجَهلي","لِشَهوَةٍ وَشُبهَةٍ بَدَت لي",51,"ي",1,0],["لأنني في جوار قومٍ","بغّضني قربهم حياتي",52,"ي",1,0],["لِأَنَّ نَداكَ يُطفي المَحلَ عَنها","وَتُحييها أَياديكَ الرِطابُ",53,"ب",1,0],["لأنني جعلت إذ طويته","عليه حبلا طالما عقدته",54,"ه",1,0],["لا نَنتحيك بسم هَجوٍ صائِبٍ","ما يَصنَع العَنين بِالعَذراء",55,"ا",2,0],["لأَنَّ نَومِى جَفا أَوطانَ مَضجَعِهِ","وَأخلَفَتهُ بِها سُهداً بِلاَ وَسَن",56,"ن",1,0],["لا نَنثَني أَبداً نُثني عَلَيك بها","نَظماً وَنثراً وَتَفصيلاً بِتَبويبِ",57,"ب",1,0],["لأنني 