gate.com/ViewPoem.aspx?id=128719",""],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5413,"ما أعمقَ الحبَّ!","https://www.poetsgate.com/ViewPoem.aspx?id=208596",""],[5431,"رفاق الجنّ...","https://www.poetsgate.com/ViewPoem.aspx?id=214964",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5595,"لَقيتُها ، وكأنَّ الدّمْعَ يُؤنِسُها","https://www.poetsgate.com/ViewPoem.aspx?id=177969",""],[5596,"مجاراة قصيدة الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=206695",""],[5638,"فلتفخري مصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=198248",""],[5691,"فخ وبصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=206216",""],[5691,"أقولُ لأمَّتي...!","https://www.poetsgate.com/ViewPoem.aspx?id=207393",""],[5704,"يا سعد من ترك الدنيا بما فيها ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200013",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5771,"ليسَ إلَّا","https://www.poetsgate.com/ViewPoem.aspx?id=189110",""],[402,"يا شاعر النيل جار النيل بالشيم","https://www.poetsgate.com/ViewPoem.aspx?id=36422",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[5943,"جنَّةُ النارِ","https://www.poetsgate.com/ViewPoem.aspx?id=41590",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5957,"الرحيل الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179589",""],[5997,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=214289",""],[6093,"هبوا إلى السيف ( البسيط )","https://www.poetsgate.com/ViewPoem.aspx?id=176038",""],[6093,"حَرْثُ فِكْرٍ ( الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=183200",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[6124,"ندي الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=194309",""],[4960,"الليلية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87988&r=&rc=0",""],[454,"لبّيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82670&r=&rc=34",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["فَخانَ يَدي ثُمَّ اِنثَنى بِفَرارِهِ","فَكانَ لِعُنقي اليَومَ أَوّلَ فارِثِ",0,"ث",1,0],["فَخارٌ لَوَ اَنَّ النَجمَ أُعطِيَ مِثلَهُ","تَرَفَّعَ أَن يَأوي أَديمَ سَماءِ",1,"ا",2,0],["فَخامَرَني ما خانَني قَدَمي لَهُ","وَإِن رَدَّ عَنّي نُفرَةَ الجأشِ إِيناسُ",2,"س",1,0],["فَخالِي رَفيعُ السَّمْكِ في العُجْمِ بَيْتُهُ","وَعَمِّي لَهُ جُرْثومَةُ المَجْدِ في العَرَبْ",3,"ب",1,0],["فَخايَلَ في ثِنْي المُفاضَةِ ظِلَّهُ","وَسُلّتْ بِأَطْرافِ العَوالي حُقُودُها",4,"د",3,0],["فَخالَلتُهُ ثُمَ أَكرَمتُهُ","فَلَم أَستَفِد مِن لَدُنهُ فَتيلا",5,"ل",2,0],["فَخافوكَ حَتّى لَو تَناجَوا بِنَجوَةٍ","لَخالوا رِياضاً فَوقَهُم يَتَسَمَّعُ",6,"ع",1,0],["فخالِدٌ كان يَدري أنّ صاحِبَه","قد وَجَه النَّفسَ نحوَ اللهِ تَوجيها",7,"ي",3,0],["فَخاصِر دَولَةً تَفنى اللَيالي","وَلَم يُلمِم بِساحَتِها مُديلُ",8,"ل",1,0],["فَخالِدُ أَولى بِالتَعَذُّرِ مِنكُمُ","غَداةَ عَلا نَهجاً مِنَ الحَقِّ واضِحا",9,"ح",2,0],["فخانني بعد همي","والهمة الغلابه",10,"ب",2,0],["فخار لم يكن يوماً","ليخطر لي على بال",11,"ل",1,0],["فَخَارٌ لِلْكِنَانَةِ أَنْ تَكُونِي","رَئِيسَةَ الاتِّحَادِ اليَعْرُبِي",12,"ي",1,1],["فَخَارُهُ حَيْثُ يَلْقَى رَحْمَةً وَهُدًى","وَحَيْثُ يَنْهَى عَنِ الأَهْوَاءِ وَالنقمِ",13,"م",1,0],["فخاض غَمر المنايا صابراً وأبى","على الفرار انغماراً في مهانته",14,"ت",2,0],["فخاتم أهل الجود في بطن كفّه","وياقوت أهل الخط في فصّ خاتمه",15,"ه",1,0],["فخانته واقتطعت ماله","ألا حبذا الخائن المقتطع",16,"ع",1,0],["فخالقُ الناس أعراءً بلا وبر","كاسي البهائم أوباراً وأصوافا",17,"ف",2,0],["فخارت قواها في غضير شبابها","وحارت فلم تدر الذي هي تفعل",18,"ل",1,0],["فَخانَها مِن قَيصَرٍ سَعدُهُ","وَأُيِّدَت بِالقَيصَرِ الأَسعَدِ",19,"د",1,0],["فَخاضَ إِلى مَكامِنِها الحُتوفا","وَما هابَ الرُماةَ مُسَدِّدينا",20,"ا",1,0],["فَخاضَ بِالسَيفِ بَحرَ المَوتِ خَلفَهُمُ","وَكانَ مِنهُ إِلى الكَعبَينِ زاخِرُهُ",21,"ر",2,0],["فَخاضَتْ نَجيعَ القَوْمِ خَوْضاً كأنّهُ","بكُلِّ نَجيعٍ لمْ تَخُضْهُ كَفيلُ",22,"ل",1,0],["فَخافوكَ حَتّى ما لِقَتلٍ زِيادَةٌ","وَجاؤوكَ حَتّى ما تُرادُ السَلاسِلُ",23,"ل",1,0],["فَخالَفتَ مَريَمَ في دينِها","وَفارَقتَ ناموسَها المُنتَهَج",24,"ج",1,0],["فَخاضوا لَظاها وَاصطَلوا بِشَرارِها","وَكانوا لَدى الهَيجا كَشَربِ مُدامِ",25,"م",1,0],["فَخارُ مَجدِكَ نَجمُ الدينِ إِن فَخَرَت","أَهلُ السِيادَةِ ساوى النَجمَ أَو سادا",26,"د",2,0],["فَخالَطتُ أَطرافَ الأَسِنَّةِ أَنجُماً","وَدُستُ لِهالاتِ البُدورِ دِيارا",27,"ر",2,0],["فَخاضَ شَراباً بارِداً في زُجاجَةٍ","وَطَرَّحَ فيهِ سَلوَةً وَسَقانِيا",28,"ي",2,0],["فخاضها خالدٌ شعواءَ كالحةً","إذا جَرَى الهولُ في أرجائِها عَصَفَا",29,"ف",2,0],["فَخالَطَ سَهلَ الأَرضِ لَم يَكدَحِ الصَفا","بِهِ كَدحَةٌ وَالمَوتُ خَزيانُ يَنظُرُ",30,"ر",1,0],["فَخافي عِقابَ اللَهِ في قَتلِ مُسلِمٍ","بَرِيءٍ وضلم يَقتُل قَتيلاً فَيُقتَلُ",31,"ل",1,0],["فَخالِفْ أُمَّتَيْ موسى وَعيسى","فما فيهمْ لخالِقِهِ مُنِيبُ",32,"ب",1,0],["فَخاتَلَنا فَأَسكَرَنا فَنِمنا","إِلى أَن هَمَّ ديكٌ بِالصِياحِ",33,"ح",1,0],["فَخافي شِرَّتي وَدَعي رَجائي","فَإِنّي مِثلَ عادِ الناسِ عادِ",34,"د",1,0],["فَخالِفِ الناسَ تَرشُد كُلَّما نَطَقوا","فَاِصمُت حَميداً وَإِن هُم أَنصَتوا فَقُلِ",35,"ل",1,0],["فَخاضَت نَجيعَ الجَمعِ خَوضاً كَأَنَّهُ","بِكُلِّ نَجيعٍ لَم تَخُضهُ كَفيلُ",36,"ل",1,0],["فخافوك حتّى ما لقتلٍ زيادةٌ","وجاءوك حتّى ما تزاد السّلاسل",37,"ل",1,0],["فخالَ ذلكَ أحلاماً أُذَكِّرُها","بعدَ النَّعيمِ وكانَ العَيشُ أطوارا",38,"ر",2,0],["فَخَارٌ لِمِصْرَ بِشِبْلِ العَرِي","نِ يَشِبُّ وَيَكْلأُهُ الضَّيْغَمُ",39,"م",1,0],["فَخَاراً صَاحبَ الْيُوبِيلِ هَذا","ثَوَابُ عَنَائِكَ الجَمِّ الطَّوِيلِ",40,"ل",1,0],["فَخَانُوا وَقَدْ أَعْطُوا يداً وَتَخَاذَلُوا","أبى اللهُ إلاّ أمرَهُ وَهْوَ أصْنعُ",41,"ع",1,0],["فَخالَفتُ كَما خالَ","فَ شَيخٌ كانَ كَلّابا",42,"ب",2,0],["فِخاراً أبا الفارُوقِ لم يَبْقَ مَنهَجٌ","إلى العلمِ إلاّ صار سَهْلاً مُعَبَّدا",43,"د",2,0],["فَخاراً سُيُوطٌ فِيكِ خَيْرُ مُمَلَّكٍ","تَحُجُّ لَهُ آمالُ مِصر وتُهْرَع",44,"ع",1,0],["فَخافوكَ حَتّى ما لِقَتلٍ زِيادَةٌ","وَجاؤوكَ حَتّى ما تُزادُ السَلاسِلُ",45,"ل",1,0],["فخافت فلا تفصح بما طرق الهدى","جهارا وقل قد أسلم الغاب خادره",46,"ر",2,0],["فَخَامَرَ لَيْلَى الخَوْفُ ثُمَّ تَحَوَّلاَ","إِلى غَيْرَةٍ وَالغَيْرَةُ انْقَلَبتْ إِلى",47,"ل",2,0],["فخَالِفْ هَوَاكَ فإنَّ الهوَى","يقودُ النفوسَ إلى ما يعابُ",48,"ب",1,0],["فَخاتَت غَزالاً جاثِماً بَصُرَت بِهِ","لَدى سَمُراتٍ عِندَ أَدماءَ سارِبِ",49,"ب",1,0],["فخالف هواها فهي ان ما زجرتها","تسمك مراعي الذل فالحرص خميها",50,"ه",2,0],["فخان الحبيب الصبر فانقض فوقه","ينادي مرمّاً لا يبالي المناديا",51,"ي",2,0],["فخاطبت العينان منها كليهما","وكان حديث العين أبلغ ما نُقل",52,"ل",1,0],["فخاطر وقع تحت الترام ولا تخفْ","ونم تحت بيت الوقف وهو مخربُ",53,"ب",1,0],["فخّاره لهج الأنا","م بمدحه يُسرى ويمنى",54,"ن",2,0],["فخان الذي أعددته لفراقكم","وولت جيوش الصبر وهي غرور",55,"ر",1,0],["فخالفوهم وأقتدوا بفعله","يا بئس ما اعتاضوا بجد لعبا",56,"ب",2,0],["فخانته أقدار السما وبدا له","من الله امر لم يكن عنه عالما",57,"م",2,0],["فَخالِدُ أَولى بِالتَعَذُّرِ مِنكُمُ","غَداةَ عَلا نَهجاً مِنَ الأَمرِ واضِحا",58,"ح",2,0],["فخاف حياء أن يهين غوانيا","لهن باسفار الفتون صحائف",59,"ف",1,0],["فخابوا وما إن خيَّب الله ظنَّه","ولله فيما أنكروه غُيوب",60,"ب",1,0],["فخاب لدى القاعية الفدم خيبة","بخفي حنين عاد بل هو أخيب",61,"ب",1,0],["فخاطب السلطانَ في مَرَّةً","واحدةً من قبل تنوي السَّفَرا",62,"ر",2,0],["فَخافَ اليَمانونَ مِن بَأسِهِ","فَراغَ إِلَيهِ رَعاعٌ سَفاها",63,"ا",3,0],["فَخابَ مِن بَعدِهِمُ قِدحُهُ","وَكانَ في القِدحِ المُعَلّى فَهان",64,"ن",1,0],["فخانها الدهر في أبهى محاسنها","وزال ما كان من سحر واغراء",65,"ا",2,0],["فَخارٌ لا يساويهِ فخارٌ","مَناطُ النَجم من أَدناهُ أَدنى",66,"ن",2,0],["فَخافوا الخزيَ من عارٍ وَحاشا","حماهم أَن تُلِمَّ به المَخازي",67,"ز",2,0],["فخاصرها بيمناه وَألقتْ","عَلى مخفوضِ عاتقه اليسارا",68,"ر",2,0],["فَخالَ وَمَن يَسمع يخل ما أحالهُ","عَلى هترةٍ خبرِ الأمورِ يحيدها",69,"د",3,0],["فَخابوا وَما إِن خابَ مِن دَمِ خَيرِهِم","شِباةُ مِتَلٍّ في يَمينِيَ مارِنِ",70,"ن",1,0],["فَخاضَ أَمامَهُنَّ الماءَ حَتّى","تَبَيَّنَ أَنَّ ساحَتَهُ قَفيرُ",71,"ر",1,0],["فَخالف ما قال الفَلاسف خصره","لَطيفاً بِهِ المَعنى الكَثيف مُؤثِّرُ",72,"ر",1,0],["فَخَافُوا أمِينَ اللهِ فِي السِّلمِ وَالوَغَى","وَنحّوا بَقايَا الغَدرِ عَن صَوبِهِ نَحّوا",73,"ح",3,0],["فخاضَها على غَرَر","من القَنا بمُشتَجَر",74,"ر",1,0],["فخالطَهمْ حتّى يصلِّي وما درَى الصْ","صَلاةَ فأضحى واقِفاً وهْو حائر",75,"ر",1,0],["فخاضَ في فَنٍّ منَ الرماء","إصماؤه يكونُ في الإشْواء",76,"ا",2,0],["فخاري بفِعْلي لا بقومي ومعشري","على أنّني نَجلُ الجحاجحة الشمِّ",77,"م",1,0],["فخافت عليه أن يكذبه الملا","ويزداد من في قلبه مرض عما",78,"م",2,0],["فخار الملوك بأعوانها","وخير البلاد بعمرانها",79,"ن",3,1],["فخافوا سيفه وبه استجاروا","وقد طرحوا السنة والنصالا",80,"ل",2,0],["فخاطِري مُقتَحمٌ","للّهوِ من أخطارِهِ",81,"ر",2,0],["فخانني الدهر في حظي وأعدمني","من كان أضحى عليه متّكلي",82,"ل",2,0],["فَخَاصَمْنَ بِيضَ الْهِنْدِ فِيكَ إِلَى العُلا","وَحَقٌّ لِمَنْ فِي القُرْبِ منكَ يُخاصِمُ",83,"م",1,0],["فخاطر هذا في الزمان كخاطر","غريباً وإن حاز المكارم كلها",84,"ل",3,0],["فخاطر نعم من يرجى وإخوته","الطاهرين من الأدناس والحوض",85,"ض",1,0],["فخار ثناء الناس طرا لهمة","أبت راحة ما لم تنل اشرف القصد",86,"د",1,0],["فخالت الصفر تبرا والدجى قبس","والنثر شعرا وعقد الدر من مسد",87,"د",1,0],["فخانك فيه من الغادري","ن من غيَّر الحقَّ أو بدّلا",88,"ل",2,0],["فخارُ كل فخورٍ فيك جُملَتهُ","فكل مُثْنٍ على الأمْجاد يَعْنيكا",89,"ك",2,0],["فخافٍ لهُ قَرْعُ الرَّويَّة سالمٌ","وبادٍ لهُ صدرُ القَناةِ حَطيمُ",90,"م",1,0],["فخاراً بمرفوع العمادِ كأنما","مُحيَّاه شمسٌ طبَّق الأرض نورُها",91,"ر",3,0],["فخاطبتُها بعدُ الأنيسِ واِنَّه","خِطابٌ على علاّتهِ غيرُ نافعِ",92,"ع",1,0],["فخاطبناك بالحسنى وقلنا","لعله مخطىء وعساه تابا",93,"ب",2,0],["فخاتَمُهُ لم ينتزع من يَمينِه","سوىً كان بالكفِّ اليَمين أو اليُسرى",94,"ر",2,0],["فخانته في الأولى بطانة وده","ورب حبيب في قميص حباب",95,"ب",1,0