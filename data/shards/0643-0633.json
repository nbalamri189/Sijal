7",""],[11,"أبَى طُولُ لَيلِكَ إلاّ سُهُودا","https://www.poetsgate.com/ViewPoem.aspx?id=16841",""],[90,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[45,"شَطَّ مِنْ ساكِنِ الغُوَيْرِ مَزَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31263",""],[45,"قُلْ للخَيالِ، إذا أرَدتَ، فعَاوِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32882",""],[51,"أبا حسنٍ قد قلتَ لو كان فَعّالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30293",""],[51,"ألا ليس شيبُك بالمتَّزعْ","https://www.poetsgate.com/ViewPoem.aspx?id=29516",""],[51,"قد وَصَلَتْ قارُورتي","https://www.poetsgate.com/ViewPoem.aspx?id=27156",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[85,"طويَ البساطُ وجفت الأقداحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9595&r=&rc=85",""],[85,"أرى شجراً في السماء احتجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9658&r=&rc=148",""]],"verses":[["كَسَفَ البِلى ذاكَ الجَمالَ المُجتَلى","وَأَجَرَّ ذاكَ المِقوَلَ الجَوّالا",0,"ل",2,0],["كَسوبٌ إِذا ما اِكتَفى بِالقَني","صِ لَم يَدَّخِر مَطعَماً لِلعِيالِ",1,"ل",1,0],["كَسَلُ الأَيّامِ عَنهُم غَرَّهُم","رُبَّما جاءَ زَمانٌ قَد نَشَط",2,"ط",1,0],["كَسَونا قَنانا ثِيابَ الدِماءِ","وَنَحنُ مِنَ العارِ فيها عَوارِ",3,"ر",1,0],["كَساقِطَةٍ إِحدى يَدَيهِ إِزاءَهُ","وَقَد جَبَّها صَرفُ الزَمانِ مِنَ الزَندِ",4,"د",1,0],["كَسِقاطِ النارِ أَورى قَدحُهُ","كُلَّما فَرَّ عَنِ النارِ وَقَد",5,"د",1,0],["كَساهُمُ البُهمَةَ الدَهماءَ عَجزُهُمُ","وَالعَزمُ أَلبَسَكَ التَحجيلَ وَالفَرَحا",6,"ح",2,0],["كَسَوقِ البَطيءِ بِسَوطِ السريعِ","يَنوءُ وَيُعجِلُهُ الضارِبُ",7,"ب",1,0],["كَسا القَنا وَالطُّلى مِنْ أَرْؤُسٍ وَلُهاً","في الحَرْبِ وَالسِّلْمِ تِيجانَاً وَأَطْواقا",8,"ق",2,0],["كساهُ الدُّجى حُلّةً والصّباحُ","يَلوحُ بِجَبْهَتِهِ والشّوى",9,"ا",1,0],["كَسا الفَجْرُ منْ نُورِهِ صَفْحَتَيْ","هِ واللّيلُ ألبَسَهُ منْ دُجاهْ",10,"ا",2,0],["كَسَوتُ الجَعدَ جَعدَ بَني أَبانٍ","سِلاحِيَ بَعدَ عُريٍ وَاِفتِضاحِ",11,"ح",1,0],["كَساني الهَوى أَثوابَهُ إِذ عَلِقتُها","فَرُحتُ إِلى العُشّاقِ في خِلعَةِ الحُبِّ",12,"ب",1,0],["كَسَا لَحْدَكَ الرَّيْحَانُ وَالرَّوْحُ وَالرِّضَى","فَقَدْ كُنْتَ رَوْحِي فِي الْحَيَاةِ وَرَيْحَانِي",13,"ي",1,0],["كَسَبِيكِ اللُّجَيْنِ ذَهَّبَهُ الصَّا","نِعُ سُبْحَانَه بِشَمْسِ الأَصِيلِ",14,"ل",1,0],["كَسَحَتْ بهِنّ ذُبابَ سَرْحِ تجَلُّدِي","لَيْلاً فحَبْلُ الصّبْرِ جِدُّ رَثِيثِ",15,"ث",1,0],["كَساني وَلَم استَكسِهِ فَحَمَدتُهُ","أَخٌ لَكَ يُعطيكَ الجَزيلَ وَناصِرُ",16,"ر",1,1],["كَسَحقِ اليَماني قَد تَقادَمَ عَهدُهُ","وَجِدَّتُهُ ما شِئتَ في العَينِ واليَدِ",17,"د",1,0],["كَسَوتُ قُتودَ الرَحلِ عَنساً تَخالُها","مَهاةً بِدَكداكِ الصُفَيِّينِ فاقِدا",18,"د",2,0],["كَسَتهُ بَعوضُ القَريَتَينِ قَطيفَةً","مَتى ما تَنَل مِن جِلدِهِ يَتَزَنَّدِ",19,"د",1,0],["كَساكُم عُلاثَةُ أَثوابَهُ","وَوَرَّثَكُم مَجدَهُ الأَحوَصُ",20,"ص",1,0],["كَسوبٌ إِلى أَن شَبَّ مِن كَسبِ واحِدٍ","مُحالِفُهُ الإِقتارُ لا يَتَمَّوَلُ",21,"ل",1,0],["كَسَفَ الدَهرُ لَونَها وَاِستَعارَت","لَونَ وَجهِ الكَذوبِ عِندَ اللِقاءِ",22,"ا",2,0],["كَسَوتَ الأَزهَرَ المَعمورَ ثَوباً","مِنَ الإِجلالِ وَالعِزِّ المُقيمِ",23,"م",1,0],["كَسَدَ العَلقُ في دِمَشقَ فَأَضحى","يَستَميلُ القُلوبَ بِالتَمويهِ",24,"ي",2,0],["كَسا شَعَرٌ وَجهَيهِما وَعَلَيهِما","فُروعٌ بَدَت يَسرَحن وَالخلقُ أَطوارُ",25,"ر",1,0],["كَسَبوا المَكارِمَ مِن مُتونِ صَوارِمٍ","وَجَنوا المَعالي مِن صُدورِ صِعادِ",26,"د",1,0],["كَسَدَت فَلَمّا قُمتُ مُمتَدِحاً بِها","مَلِكَ المُلوكِ غَدَوتُ أَربَحُ متجَرا",27,"ر",2,0],["كَسَوتَني مِن ثِيابِ السَقمِ أَسبَغَها","ظُلماً وَصَيَّرتَ مِن لَحفِ الضَنى فُرُشي",28,"ي",1,0],["كُسِيَ الحُسنَ فَهُوَ يَفتَنُّ فيهِ","ساحِباً ذَيلَ بُردِهِ المُسبَكِرِّ",29,"ر",1,0],["كَسَونَ الرَيطَ ذا الهُدبِ اليَماني","خُصوراً فَوقَ أَعجازٍ ثِقالِ",30,"ل",1,0],["كَسَالِكِ وَعْزٍ رَاقَهُ حُسْنُ كَوْكَبٍ","فَأَرْجُلُهُ تَدْمَى وَعَيْنَاهُ فِي السَّمَا",31,"م",2,0],["كَسودانٍ لَبِسنَ ثِيابَ خَزٍّ","وَقَد تُرِكوا مَكاشيفَ الرُؤوسِ",32,"س",1,0],["كَسَتها عَجاجَ البُرقَتَينِ وَراوَحَت","بِذَيلٍ مِنَ الدَهنا عَلى الدارِ مُرفَلِ",33,"ل",1,0],["كَسا الأَرضَ بُهمى غَضَّةً حَبَشِيَّةً","تَؤاماً وَنُقعانُ الظُهورِ الأَقارِعِ",34,"ع",1,0],["كَساكَ الَّذي يَكسو المَكارِمِ حُلَّةً","مِنَ المَجدِ لا تَبلى بَطيئاً نُفوضُها",35,"ض",3,0],["كَساهُنَّ لَونَ السودِ بَعدَ تَعَيُّسٍ","لِوَهبينَ إِحماشُ الوَليدَةِ بِالقِدرِ",36,"ر",1,0],["كَسا اللُؤمُ اِمرِئِ القَيسِ كُهبَةً","أُضِرَّ بِها بِيضُ الوجوهِ وَسودُها",37,"د",3,0],["كسرتَ تماثيل الصّليب وأُخرسَتْ","نواقيسُ كانت بالضلال تناغيها",38,"ي",3,0],["كساني الهوى ثوبَ السقام وإنه","متى صحَّ حبُّ المرء لا شيءَ يُسقمُ",39,"م",1,0],["كسروا تماثيل الصليب ومثّلوا","بمن انتمى لولائه تمثيلا",40,"ل",2,0],["كَساكَ اللُؤمُ لُؤمُ أَبيكَ تَيمٍ","سَرابيلاً بِنائِقُهُنَّ سودُ",41,"د",1,0],["كَساكَ الحَنطَبِيُّ كِساءَ صوفٍ","وَمِرعِزّى فَأَنتَ بِهِ تَغيدُ",41,"د",1,0],["كُسَّ السَنابِكِ شُزَّباً أَقرابُها","مِمّا أَطالَ غُزاتُها التَقويدا",42,"د",2,0],["كَسَونا ذُبابَ السَيفِ هامَةَ عارِضٍ","غَداةَ اللِوى وَالخَيلُ تَدمى كُلومُها",43,"م",3,0],["كَساهُنَّ الهَواجِرُ كُلَّ يَومٍ","رَجيعاً بِالمَغابِنِ كَالعَصيمِ",44,"م",1,0],["كَسَفينَةِ الهِندِيِّ طابَقَ دَرءَها","بِسَقائِفٍ مَشبوحَةٍ وَدِهانِ",45,"ن",1,0],["كَسَبقِ الجَوادِ غَداةَ الرِهانِ","أَربى عَلى السِنِّ شَأواً مَديدا",46,"د",2,0],["كَسَينا صُروفَ الدَهرِ ليناً وَغِلظَةً","وَكُلّاً سَقاناهُ بِكَأسَيهِما الدَهرُ",47,"ر",1,0],["كسوت العِلافيَّات هُوجاً كأنها","مجادلُ شدَّ الراصفون اجتدالَها",48,"ه",2,1],["كَسَونا أُخُوَّتَنا بِالصَفاءِ","كَما كُسِيَت بِالكَلامِ المَعاني",49,"ي",1,0],["كَسَتهُ سَرابيلَ البِلى بَعدَ عَهدِهِ","وَجَونٌ سَرى بِالوابِلِ المُتَهَزَّمِ",50,"م",1,0],["كَساكَ هِشامُ بنُ الوَليدِ ثِيابَهُ","فَأَبلِ وَأَخلِف مِثلَها جُدُداً بَعدُ",51,"د",1,0],["كَسّابِ مَكرُمَةٍ مِطعامِ مَسغَبَةٍ","وَهّابِ عيدِيَةٍ وَجَناءَ شِملالِ",52,"ل",1,0],["كسر اللواحظ ناصب فكرِي","فضنيت بين الكسرِ والنصب",53,"ب",1,0],["كسرت كؤوس شعري بعدَ دورٍ","وتبتَ على يدي شيخ الشيوخ",54,"خ",1,0],["كسناء نور الدين ذي ال","أفضال والفضل الأغرّ",55,"ر",1,0],["كسوت العبد برداً من فخارٍ","حريريٍّ على العليا تحرّر",56,"ر",1,0],["كسرى من الدولة الشهباء منكسرٌ","قِدماً وقيصر بالتقصير مرتبك",57,"ك",1,0],["كسطور شمس الدين طيّ طروسه","تسطو على الأعداء بالإعدام",58,"م",1,0],["كسوتني خضراء ما نالها","من منعم غيري ولا سامها",59,"ه",2,1],["كَسُرعَةِ الوَهمِ لِمَن وَهمُهُ","عَلى دِقيقِ الغامِضِ الغائِرِ",60,"ر",1,0],["كسا عراءَ الرُّبَا طَيالسةً","خُضراً وبالعَبْقَرِيِّ رَدَّاها",61,"ا",3,0],["كساءَ بني نُوبَخت مهلاً فإنني","أراك تُناغي طيلسانَ بني حربِ",62,"ب",1,1],["كسائي كسائي إنه الدربُ بيننا","فلا تَدَعِ الثَغرَ المخُوفَ بلا دَرْبِ",62,"ب",1,0],["كسَّبَتْني جرائمي","مكسباً ساء مكسبا",63,"ب",2,0],["كَسُورةٍ قد غُيِّرت","عمّا عليه نزلَتْ",64,"ت",1,0],["كسوْتُم جُنوباً منكُم لِبْسَةَ القِلى","وعرَّيْتُمُوها من لِباس المحامدِ",65,"د",1,0],["كَسَبْتُمْ يساراً واكتَسبتم ببخلِكمْ","شَناراً عليكم باقياً غير بائدِ",65,"د",1,0],["كسَرار الشهر بل أخ","فى مَخَطَّاً من سرار",66,"ر",1,0],["كُسين لبوس الحسن من كل غادةٍ","لها خُلُقٌ عفٌّ وخَلْق مصوّر",67,"ر",1,0],["كَسَاهُ من النوار أبيضُ ناصعٌ","وأحمر قِنوانٌ وأصفرُ وارس",68,"س",1,0],["كسا طيزها شمطٌ لابدٌ","على القمل كالصوف لم يُنْفش",69,"ش",1,0],["كسَّبتُهُ صحبة الملوك بشت","ميه فَرَاشُوه خيرَ أرياش",70,"ش",1,0],["كَسَبُوها لمنحِها لا كقومٍ","كَسَبُوها لمنعها حُرّاض",71,"ض",1,0],["كسقف السماء أغاث العبا","د شكراً لرافعه إذ رفع",72,"ع",1,0],["كساكم أبو دلف خيمَه","فكلٌّ بسكَّتِهِ منطبع",72,"ع",1,0],["كسوناكم منها ونحن بِغرَّةٍ","مدائح لم تغبط بربح بُيوعها",73,"ع",3,0],["كُسِي المهابة كلها بغنائه","في كل نازل مضلعٍ ومُطيفه",74,"ف",2,0],["كساك من زينة الدنيا لتكسوه","من سترها فاكسُهُ يا خير من كافى",75,"ف",2,0],["كسرٌ لناكِس دارٍ كنْتَ تحذَرُهُ","وصحّةٌ لك تُحيينا بمحياكا",76,"ك",2,0],["كسبتْ له التجويرَ قبلك عصبةٌ","فكسبْتَ بعدهُمُ له التعديلا",77,"ل",2,0],["كسا المجدَ من أبرادهِ بعدَ عُرْيِهِ","وحلَّى العلا من حَلْيه وهي أعْطالُ",78,"ل",1,0],["كسِلَ الأيرُ أو ينشّطه أيرٌ","وكذا لم تأنَّس الأشكالُ",79,"ل",1,1],["كساهُ الذي أعلاهُ بُرْءاً وصحّةً","وكانت له الأيامُ خيرَ خليلِ",80,"ل",1,0],["كُسيتُ البيضَ أخلاقاً رِماماً","فوصْلُ البيضِ أخلاقٌ رِمامُ",81,"م",1,0],["كساه الغيثُ كِسوتَه