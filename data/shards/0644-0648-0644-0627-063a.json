{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[47,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[63,"جاءت هديتك التي","https://www.aldiwan.net/poem51794.html","مجزوء الكامل"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[48,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[108,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[113,"يا من إذا عثر الزمان أقاله","https://www.aldiwan.net/poem16199.html","الكامل"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[215,"يا ليل يا ليلى يا ليل","https://www.aldiwan.net/poem46606.html","المواليا"],[287,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[343,"دع الرياء لمن لج الرياء به","https://www.aldiwan.net/poem68623.html","البسيط"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59128","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64780","الكامل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102210","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100757","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132100","البسيط"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113659","الكامل"],[4866,"خواطر ليل","https://www.poetsgate.com/ViewPoem.aspx?id=194768",""],[5837,"بلاك بيري","https://www.poetsgate.com/ViewPoem.aspx?id=181725",""],[5853,"حلم باللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188363",""],[5956,"تتنعمان بجدة حنّانة (والحمد لله)","https://www.poetsgate.com/ViewPoem.aspx?id=205166",""]],"verses":[["لَولا غَمامُ نَداكَ أَصبَحَ راكِبٌ","يَشكو الأُوامَ وَقَد أَناخَ بِمَنهَلِ",0,"ل",1,0],["لَولا غَرامي بِالعَفوِ قَد لَقِيَ الظ","الِمُ شَرّاً وَساءَ مُنقَلَبُه",1,"ب",2,0],["لولا غرائبُ فِعلِها","لارْتَدَّ في لونِ الغُراب",2,"ب",1,0],["لولا غُلُوُّكَ في المطامعِ ما انْبَرى","يَبغِي الزِّيادةَ طَامعٌ لم يقنعِ",3,"ع",1,0],["لوْلا غَضَا نَجْدٍ وقُلاّمُهُ","لم يُثْنَ بالطّيبِ على رَنْدِهِ",4,"د",2,0],["لولا غطارفُ في الدنيا الجديدة، ما","أصْغت إلى لغة الأعراب آذان",5,"ن",1,0],["لَولا غَزارة عِلمِهِ لَم تَسطَع","الشَعراءُ مَدح جَنابِهِ إِجلالا",6,"ل",2,0],["لولا غنائي وشعري","لمات روح الوجود",7,"د",1,0],["لولا غناؤك ما خلّدت في نارك","إذن أغنّى",8,"ن",2,0],["لَولا غَدرُ الأَيّامِ بِهِ","لَم يُهدِ المَدحَ مَعَ الرُسُلِ",9,"ل",1,0],["لَولا غِناكَ لَكُنتَ الكَلبَ عِندَهُمُ","فَإِن أَبَيتَ فَجَرِّب وَاِشقَ بِالنَدَمِ",10,"م",1,0],["لولا غَوالي الدُرِّ بين شِفاهِهِم","لم يرخُصِ الياقوتُ من عَبَراتِهِ",11,"ت",2,0],["لَوْلاَ غَمَامُ نَدَى أيْدِيكَ يُمْطِرُنَا","لأصْبَحَ الجُود فِينَا كَاسِفَ البَالِ",12,"ل",1,0],["لولا غرامُكَ بالحُروبِ وخوضِها","بارَتْ ورُبَّ نَفيسةٍ لا تُشتَرى",13,"ر",2,0],["لولا غيومٌ يومَ تَيبيسِ الكِسا","تِسري لِحَجب السُحب جُلّ ضيائها",14,"ا",3,0],["لولا غرامك ما انثنيت بناظر","يلقاك بين مهابة وخشوع",15,"ع",1,0],["لولا غرور شريك أنت تابعه","ما ضل عن ناظريك المنهج الأممُ",16,"م",1,0],["لولا غزير الدَّمع أحرقه الحشا","لولاه أصبح مغرقاً ببكائهِ",17,"ا",3,0],["لولا غلاه، إنّي من العام نايم","ولا شكت عيني سهرها بالأبيات",18,"ت",1,0],["لولا غلاك اللي تمكّن بالاقفاص","لاقول لك فارق عسى فيه غيري",19,"ر",2,0],["لولا غرامك ياحبيبة خافقي","..............ما بت في دعة التنسك مرهقا",20,"ق",2,0],["لولا غسيلُ الله آماقاً لنا","من سُقْمها لسنا نشيم ضياءا",21,"ا",3,0]]}