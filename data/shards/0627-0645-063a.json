{"poems":[[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[86,"أخت الكواكب ما رماك","https://www.aldiwan.net/poem10485.html","مجزوء الكامل"],[86,"أدلال ذاك أم كسل","https://www.aldiwan.net/poem68842.html","المديد"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[89,"أضاء ثم تدلى يأفل القمر","https://www.aldiwan.net/poem44783.html","البسيط"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[96,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[129,"مذ مدة ما جاءنا","https://www.aldiwan.net/poem50602.html","مجزوء الكامل"],[143,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[156,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[175,"أمغنية مع الظلم الخطوب","https://www.aldiwan.net/poem46064.html","الوافر"],[186,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[200,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[223,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[230,"ما تمناك جعفر يا منى جع","https://www.aldiwan.net/poem50742.html","الخفيف"],[230,"أيها الفاضل الذي فضل العالم","https://www.aldiwan.net/poem50800.html","الخفيف"],[329,"أصامت أنت أم نشوان يا قلمي","https://www.aldiwan.net/poem54960.html","البسيط"],[343,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[430,"نسمات البان من العلم","https://www.aldiwan.net/poem40851.html","المتدارك"],[433,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[453,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[459,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[465,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[530,"أصعدت مرتفعا إلى أوج السما","https://www.aldiwan.net/poem37165.html","الكامل"],[552,"شاقك البرق اليماني","https://www.aldiwan.net/poem47375.html","مجزوء الرمل"],[552,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"]],"verses":[["أَم غابَ رَبُّكَ فَاِعتَرَتكَ خَصاصَةٌ","فَلَعَلَّ رَبُّكَ أَن يَعودَ مُؤَيَّدا",0,"د",2,0],["أَم غارَ مِنكَ السابِحا","تُ وَأَنتَ تَسبَحُ في الأَثيرِ",1,"ر",1,0],["أَم غَريقٌ أَنتَ في جَذَلٍ","أَم بِكاساتِ الهَنا ثَمِلُ",2,"ل",1,0],["أَم غَنِيٌّ باتَ يَشغَلُهُ","مالَهُ وَالكَسبُ وَالأَمَلُ",2,"ل",1,0],["أم غاب مع طفل أخيرُ دجنتي","لا كوكبي فيها ولا أسحاري",3,"ر",2,0],["أَم غَنِيٌّ هَيهاتِ تَختالُ لَولا","دودَةُ القَزِّ بِالحَباءِ المُبَجَّد",4,"د",1,0],["ام غاب عنه فلما ثاب مفتقدا","الفاه قد قام فيه حية ذكر",5,"ر",1,0],["أَم غَفلَةٌ حَدَثَت في","كَ أَم هَوىً أَضناكا",6,"ك",2,0],["أم غُصْتَ في لجج البحا","رِ وفي مجاهلها دُفِنْتْ",7,"ت",1,0],["أم غصت في لجّ البحار","وفي مجاهلها دفنت ؟",8,"ت",1,0],["\" أم غوركَي \" ليت عندي وحيه","لأوفى ( بنتَك ) اليومَ الثناء",9,"ا",2,0],["أمْ غيَّر الودَّ النوى","أمْ رَبعٌ ودى قد دثَرْ",10,"ر",1,0],["أم غرَّد الحادى بقافيةٍ","منها غرابُ البين يستملى",11,"ل",2,0],["أَمَغْنى الهَوى غالَتْكَ أَيدي النَّوائبِ","فَأَصْبَحْتَ مَغْنىً لِلْصَّبا والجَنائبِ",12,"ب",1,1],["أَمُغْنيَةٌ مَعَ الظُلْمِ الْخُطُوبُ","فيُغْفرَ مَا جَنَتْهُ مِنَ الذَّنُوبِ",13,"ب",1,1],["أمُغيثَ الدين نَصْرا حين لم","يبقَ منه منكبٌ لم يُنْكَب",14,"ب",1,0],["أم غدا كمشبههِ","البدرُ ليس يقتربُ",15,"ب",1,0],["أم غرّكم حُلُم الحميد","ورفقه بالعالمين",16,"ن",1,0],["أمغانٍ لشَعْبِه لا سَقَى الغي","ثُ ولا جادَ من مغانيكِ مَغْنى",17,"ن",2,0],["أم غدا مَذهبُ التَّناسُخ حقّاً","فرمى فيك روحَه النَّظَّام",18,"م",1,0],["أم غيض نبع الأماني الحور فانطمست","آيات نورك في داج من الظلم",19,"م",1,0],["ام غاص في الدو","من بعد اعياء",20,"ا",2,0],["أمغرد ذاك الدوح أمن","شغف تشدو ام من ألم",21,"م",1,0],["أَمْ غَرَّ مِنَّي الليالِي أَنَّها جَذَبَتْ","بِمِقْوَدِي فَرَأَتْنِي طَيَّعَ الرَّسَنِ",22,"ن",1,0],["أم غادةٌ فتانة اللحظ لها","جيدٌ كجيدِ الريم يعطو لامِعا",23,"ع",2,0],["أم غال ذا الحسبين حاميَ ذَودِها","قدرٌ أراح على الغدوِّ سَوامَها",24,"م",3,0],["أمغنّي الشّربِ الكرام بها أعدْ","ومديرةَ الصهباء هاتِ وهاك",25,"ك",1,0],["أَمْ غُصْتَ في البَحْرِ الخِضَمِّ فَجِئْتَ بالدّ","رِّ الثَّمينِ مُنَقِّباً ومُنَظِّما",26,"م",2,0],["أم غدا كاليَمَنِ اليو","مَ به هذا العقيقُ",27,"ق",1,0],["أمغريةً باللّوم في سمعِ معرضٍ","دعوتِ شَروداً ما يحيقُ بهِ سِحْرُ",28,"ر",1,0]]}