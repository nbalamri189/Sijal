{"poems":[[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[88,"أخت الكواكب ما رماك","https://www.aldiwan.net/poem10485.html","مجزوء الكامل"],[88,"أدلال ذاك أم كسل","https://www.aldiwan.net/poem68842.html","المديد"],[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[93,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[91,"أضاء ثم تدلى يأفل القمر","https://www.aldiwan.net/poem44783.html","البسيط"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[98,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[132,"مذ مدة ما جاءنا","https://www.aldiwan.net/poem50602.html","مجزوء الكامل"],[146,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[159,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[178,"أمغنية مع الظلم الخطوب","https://www.aldiwan.net/poem46064.html","الوافر"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[203,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[234,"ما تمناك جعفر يا منى جع","https://www.aldiwan.net/poem50742.html","الخفيف"],[234,"أيها الفاضل الذي فضل العالم","https://www.aldiwan.net/poem50800.html","الخفيف"],[333,"أصامت أنت أم نشوان يا قلمي","https://www.aldiwan.net/poem54960.html","البسيط"],[347,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[435,"نسمات البان من العلم","https://www.aldiwan.net/poem40851.html","المتدارك"],[438,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[457,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[463,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[469,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[534,"أصعدت مرتفعا إلى أوج السما","https://www.aldiwan.net/poem37165.html","الكامل"],[556,"شاقك البرق اليماني","https://www.aldiwan.net/poem47375.html","مجزوء الرمل"],[556,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122717","الوافر"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124039","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44793","السريع"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145616","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62490","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59112","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64816","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136281","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49915","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111838","الكامل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104463","الكامل"],[2402,"","https://poetry.dctabudhabi.ae/diwan/poem/177943","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137382",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93872","المتدارك"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93840","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94025","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93817","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100339","الكامل"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/82779","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112331","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138534",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138533",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108160","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66344","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91513","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132142","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97097","الكامل"],[4176,"","https://poetry.dctabudhabi.ae/diwan/poem/96537","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90829","الكامل"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138771",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72809","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139752",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52181","البسيط"],[4862,"ولم تزل العبرات مخنوقه","https://www.poetsgate.com/ViewPoem.aspx?id=55632",""],[4983,"أسائل الليل","https://www.poetsgate.com/ViewPoem.aspx?id=29439",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[3294,"ربع محا الحدثان رسمه","https://www.poetsgate.com/ViewPoem.aspx?id=173276",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[6068,"‫#المغرب‬ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=177019",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[6270,"كأنما شمْعة الرقرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69083&r=&rc=7",""]],"verses":[["أَم غابَ رَبُّكَ فَاِعتَرَتكَ خَصاصَةٌ","فَلَعَلَّ رَبُّكَ أَن يَعودَ مُؤَيَّدا",0,"د",2,0],["أَم غارَ مِنكَ السابِحا","تُ وَأَنتَ تَسبَحُ في الأَثيرِ",1,"ر",1,0],["أَم غَريقٌ أَنتَ في جَذَلٍ","أَم بِكاساتِ الهَنا ثَمِلُ",2,"ل",1,0],["أَم غَنِيٌّ باتَ يَشغَلُهُ","مالَهُ وَالكَسبُ وَالأَمَلُ",2,"ل",1,0],["أم غاب مع طفل أخيرُ دجنتي","لا كوكبي فيها ولا أسحاري",3,"ر",2,0],["أَم غَنِيٌّ هَيهاتِ تَختالُ لَولا","دودَةُ القَزِّ بِالحَباءِ المُبَجَّد",4,"د",1,0],["ام غاب عنه فلما ثاب مفتقدا","الفاه قد قام فيه حية ذكر",5,"ر",1,0],["أَم غَفلَةٌ حَدَثَت في","كَ أَم هَوىً أَضناكا",6,"ك",2,0],["أم غُصْتَ في لجج البحا","رِ وفي مجاهلها دُفِنْتْ",7,"ت",1,0],["أم غصت في لجّ البحار","وفي مجاهلها دفنت ؟",8,"ت",1,0],["\" أم غوركَي \" ليت عندي وحيه","لأوفى ( بنتَك ) اليومَ الثناء",9,"ا",2,0],["أمْ غيَّر الودَّ النوى","أمْ رَبعٌ ودى قد دثَرْ",10,"ر",1,0],["أم غرَّد الحادى بقافيةٍ","منها غرابُ البين يستملى",11,"ل",2,0],["أَمَغْنى الهَوى غالَتْكَ أَيدي النَّوائبِ","فَأَصْبَحْتَ مَغْنىً لِلْصَّبا والجَنائبِ",12,"ب",1,1],["أَمُغْنيَةٌ مَعَ الظُلْمِ الْخُطُوبُ","فيُغْفرَ مَا جَنَتْهُ مِنَ الذَّنُوبِ",13,"ب",1,1],["أمُغيثَ الدين نَصْرا حين لم","يبقَ منه منكبٌ لم يُنْكَب",14,"ب",1,0],["أم غدا كمشبههِ","البدرُ ليس يقتربُ",15,"ب",1,0],["أم غرّكم حُلُم الحميد","ورفقه بالعالمين",16,"ن",1,0],["أمغانٍ لشَعْبِه لا سَقَى الغي","ثُ ولا جادَ من مغانيكِ مَغْنى",17,"ن",2,0],["أم غدا مَذهبُ التَّناسُخ حقّاً","فرمى فيك روحَه النَّظَّام",18,"م",1,0],["أم غيض نبع الأماني الحور فانطمست","آيات نورك في داج من الظلم",19,"م",1,0],["ام غاص في الدو","من بعد اعياء",20,"ا",2,0],["أمغرد ذاك الدوح أمن","شغف تشدو ام من ألم",21,"م",1,0],["أَمْ غَرَّ مِنَّي الليالِي أَنَّها جَذَبَتْ","بِمِقْوَدِي فَرَأَتْنِي طَيَّعَ الرَّسَنِ",22,"ن",1,0],["أم غادةٌ فتانة اللحظ لها","جيدٌ كجيدِ الريم يعطو لامِعا",23,"ع",2,0],["أم غال ذا الحسبين حاميَ ذَودِها","قدرٌ أراح على الغدوِّ سَوامَها",24,"م",3,0],["أمغنّي الشّربِ الكرام بها أعدْ","ومديرةَ الصهباء هاتِ وهاك",25,"ك",1,0],["أَمْ غُصْتَ في البَحْرِ الخِضَمِّ فَجِئْتَ بالدّ","رِّ الثَّمينِ مُنَقِّباً ومُنَظِّما",26,"م",2,0],["أم غدا كاليَمَنِ اليو","مَ به هذا العقيقُ",27,"ق",1,0],["أمغريةً باللّوم في سمعِ معرضٍ","دعوتِ شَروداً ما يحيقُ بهِ سِحْرُ",28,"ر",1,0],["أمَغرُورٌ بِدَنِّ الخَمرِ هَوِّن","عَلَيكَ فَإنَّما في الدَّنِ خَلُّ",29,"ل",1,0],["أمغالي الدأماء في غلوائها","وخليفة الغيث الملث أن أخلفا",30,"ف",2,0],["أَم غَيرَ لَألاءِ الظِبا وَالقَنا","يُزيلُ مِن قَلبي دُجى الغاسِقِِ",31,"ق",1,0],["أمغنى سليمى اسلم سقاك الحيا مثنى","وإن كان ما أغنى وقوف على مغنى",32,"ن",2,1],["أم غصنُ بانٍ تجلىّ في كثيب نقاً","أم قدُّه قام في رِدف به اضطجعا",33,"ع",2,0],["أمْ غَيْهَبٌ سُدِلَتْ حَوَاشِيهِ عَلَى","شَفَقٍ كَأنَّ أدِيمَهُ عِقْيَانُ",34,"ن",1,0],["أَمَغْنَى اللِّوى مَهْما نَسِيتُ فما أَنْسَى","زَماناً بِه غَازْلتُ غِزلانَكَ اللُّعْسَا",35,"س",2,1],["ام غرك الزخرف الفاني واشغلك","الدار التي حشوها الا فات والعلل",36,"ل",1,0],["أم غيره جردته من نفسه","أم غيره هو ذاته أم ما الصفه",37,"ف",2,0],["أمُغرىً بأنواع الهوى متعلّقاً","بأسباب لهوٍ قلمَّا يتقضَّبُ",38,"ب",1,0],["ام غادروا الاوطارَ في اوطانهم","مذ حاذروا غدرَ الزمان العادي",39,"د",2,0],["ام غادروهُ رفيقَ وجدي والضنى","وتلهفي وتذللي وسهادي",39,"د",2,0],["أم غازلتك من اللحاظ بأدعج","فحسبت عن شغف لها بك يخبر",40,"ر",1,0],["أم غادة فردةٌ في الحسن غانيةٌ","فتانة أقبلت في حليها عطره",41,"ر",2,0],["أم غادة كشف لثام جمالها","فبدت لنا من وجهها الأنوار",42,"ر",1,0],["أم غر شمائل قد نظمت","في سمط اللؤلؤ والجوهر",43,"ر",1,0],["أم غر أخلاقك اللواتي","كأنها القرقف الحلال",44,"ل",1,0],["أم غادة غنيت بالحسن على حلل","وقد غدت بعقود الدر حالية",45,"ه",1,0],["أم غصون الربا تباهت وأبدت","معصماً زانه سوار الجدول",46,"ل",1,0],["أم غد الكون يزدهي بعزيز","حسن الاسم والمسمى الأجمل",46,"ل",1,0],["أمغازلي بالطرف مرهف","ومقابلي بالقدّ أهيف",47,"ف",1,1],["أَم غُيومٌ طُفنَ في شَمس الغُروب","قَبلَ أَن يَغرَقنَ في بَحر الظَّلام",48,"م",1,0],["أمغدها بمطهرات","نزهت عن كل وصمه",49,"م",2,0],["أم غارَ تحتَ البحرِ أم","قد سارَ من فوق القمر",50,"ر",1,0],["أمغسل الزهراء اني لا أرى","أولى وأرأف منك بالزهراء",51,"ا",2,1],["أمغسل الزهراء عز عليك ما","قد نالها من ذا سواك كفيلها",52,"ل",3,0],["أم غرت حين رنت إليه عيوننا","تشتاق منه وجنتين ومبسما",53,"م",2,0],["أَم غابَ تَحتَ الأَرضِ أَم صَعِدَ السَما","فَرأى بِها المَلَكوتَ رأيَ عيانِ",54,"ن",1,0],["أم غادة في مروط الحسن مائسة","خريدة ذات ثغر أملج شنبِ",55,"ب",1,0],["ام غدا صارمُ النفوسِ كَهاماً","إذ تصلَّدنَ واعتَراهُ الكَلالُ",56,"ل",1,0],["أَم غصن بَان يحاكي قدَّه انعطفا","فمِلت من طربِ وَالدمعُ لي يَسقي",57,"ق",2,0],["امغنت في طلب الإخاء فلم أفز","بأخٍ تعزّ به الأخوّة وافِ",58,"ف",1,0],["أم غاب عنها بدرها أم حجبت","شمس الهداية من بني ياسين",59,"ن",1,0],["أمُغَطَّى منِّي على بصري بال","حُبِّ أم أنتِ أكملُ الناسِ حُسنَا",60,"ن",2,0],["أمغيثها وبك الهناء لها بأن","أصلحت ما الأواء منها افسدا",61,"د",2,0],["أم غلبكم وهنت وأنت مشيمها","أم ضاع وترك وهو عندك واضح",62,"ح",1,0],["أم غواني سفح لبنان لمن","حل بغداد أشارت باليدين",63,"ن",1,0],["أم غاض يمٌّ بفيض الفضل ملتطمٌ","أم ساخ طودُ معالٍ شامخ القنن",64,"ن",1,0],["أمٌّ غذته فلما شبّ برّ بها","لم يألٌ بِرّاً ولم يشتطَّ كفرانا",65,"ن",2,0],["أم غاظكم إذ فقتكم وسبقتكم","بنجائبي ورجعتموا لوراءِ",66,"ا",2,0],["أم غركم مازورتْ أقلامكم","من باطلٍ في ساحةِ ( الأفياءِ )",66,"ا",2,0],["أم غادرت جنة الأشواق وانتحرت","أغصانها, وذوى ورد ونوار",67,"ر",1,0],["أمغريتي باللوم فيما أرومه","لك الويل ما أنآك عني وأنآني",68,"ن",2,0],["أمغاني معارف، تيمته","أم مباني معالف، وبهار؟",69,"ر",1,0],["أم غاب إلفٌ بلا عذرٍ لغيبته","حتى تنوح بشجوٍ خانهُ الطربُ",70,"ب",1,0],["أمغذها بمطهرات","نزهت عن كل وصمه",71,"م",2,0],["أَمُغْنِي رُعاةَ الصَّدْعِ صَدْعَ نُجُولَةٍ","لَدَى حَيْثُ ذاتُ الصَّدْعِ تَنْجُلُ بالصَّدْعِ",72,"ع",1,0],["أم غال صبرك طول ما","قد نال صفوك من كدر؟",73,"ر",1,0],["أمغرب الشوق إن الشوق تطفئه","منك الهتون بوصل دام ما زاﻻ",74,"ا",1,0],["أم غِرتَ منه؟ فيا لقلبك قاسياً","ماذا تركت لحسنه فتغارا؟",75,"ر",2,0],["أم غمغمات عصيّات صواحبها","مقطعات يدا ما همّ واشتعلا",76,"ل",2,0]]}