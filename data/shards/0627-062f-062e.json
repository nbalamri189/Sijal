{"poems":[[95,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[87,"وعن عظيم ثروته","https://www.aldiwan.net/poem6962.html","مجزوء الرجز"],[87,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[33,"أدخل الله رب موسى وعيسى","https://www.aldiwan.net/poem42206.html","الخفيف"],[107,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[107,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[78,"قد أوضح الله للإسلام منهاجا","https://www.aldiwan.net/poem39470.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72238","الرجز"],[97,"اقرئيها (أوراق ميت )","https://www.poetsgate.com/ViewPoem.aspx?id=718",""],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[141,"قامت إلي بتقبيل تعانقني","https://www.aldiwan.net/poem67924.html","البسيط"],[164,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[190,"انتفع بالناس وانفع","https://www.aldiwan.net/poem43836.html","الرمل"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[289,"إني إذا ما شاعر هاجانيه","https://www.aldiwan.net/poem44348.html","الرجز"],[290,"أهلا وسهلا بالإمام","https://www.aldiwan.net/poem39347.html","مجزوء الرجز"],[325,"يا سيدي مصطفى يا خير من سعدت","https://www.aldiwan.net/poem67215.html","البسيط"],[331,"يعقوب ينظر في الأمو","https://www.aldiwan.net/poem44236.html","مجزوء الكامل"],[435,"ما للمعالي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[438,"قل للمضيرة عني","https://www.aldiwan.net/poem12410.html","المجتث"],[473,"حمام من لست له ذاكرا","https://www.aldiwan.net/poem59556.html","السريع"],[563,"ادخلو في تصرف الرحمان","https://www.aldiwan.net/poem33743.html","الخفيف"],[580,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122676","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66777","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66641","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66850","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101486","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104553","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77591","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77673","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77650","الرجز"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216909","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117756","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112870","البسيط"],[1404,"","https://poetry.dctabudhabi.ae/diwan/poem/34866","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48910","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48924","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105030","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120753","السريع"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119191","المنسرح"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105661","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94230","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94115","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94048","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94073","الرمل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204976","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205054","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200156",""],[3207,"","https://poetry.dctabudhabi.ae/diwan/poem/144657","السريع"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89111","المتدارك"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89107","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89382","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129336","البسيط"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130426","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135784","الرجز"],[3916,"","https://poetry.dctabudhabi.ae/diwan/poem/122212","السريع"],[4415,"","https://poetry.dctabudhabi.ae/diwan/poem/204003","المنسرح"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35476","الرمل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113835","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204196",""],[4750,"ياعيون اللي على المرقب تعلاّ","https://www.poetsgate.com/ViewPoem.aspx?id=180433",""],[4755,"ذَاتُ اللذيذَين","https://www.poetsgate.com/ViewPoem.aspx?id=184702",""],[4778,"أهواكَا","https://www.poetsgate.com/ViewPoem.aspx?id=188197",""],[4578,"صج المنى بضياء وجهك أبلج","https://www.poetsgate.com/ViewPoem.aspx?id=49369",""],[4852,"عُرس القصائد","https://www.poetsgate.com/ViewPoem.aspx?id=214355",""],[4852,"تيها","https://www.poetsgate.com/ViewPoem.aspx?id=214378",""],[5102,"خيرا وسلاما","https://www.poetsgate.com/ViewPoem.aspx?id=17647",""],[5324,"دنيا الشعراء.","https://www.poetsgate.com/ViewPoem.aspx?id=211169",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5536,"أعطني الناي َ وغنيّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=23194",""],[5608,"أحلا قصيد","https://www.poetsgate.com/ViewPoem.aspx?id=33532",""],[5690,"أدخلو بيت مقدسٍ","https://www.poetsgate.com/ViewPoem.aspx?id=172276",""],[5691,"باب الخليفة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207262",""],[5776,"حَطَّابٌ كما تشتهي البُذور ....","https://www.poetsgate.com/ViewPoem.aspx?id=206899",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[5848,"با علم عليك","https://www.poetsgate.com/ViewPoem.aspx?id=53156",""],[192,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=16376",""],[5937,"بَين رِمشَين","https://www.poetsgate.com/ViewPoem.aspx?id=211818",""],[5956,"يا خادم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[6035,"متى أردتمُ رفعَ الثوب تَمْتَثِلُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177094",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[5567,"أدخل في الغيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81750&r=&rc=22",""]],"verses":[["أَدْخَلَهَا مَعْهَدَ عِلْمٍ بِهِ","تَحْفَظُ حِفْظَ القُنْيَةِ الفَاخِرَهْ",0,"ر",2,0],["أدخل بنا في الجد يا رشاد","متى تراه",1,"ه",1,0],["اُدخُلي الجَنَّةَ مِن رَوضَتِه","إِنَّ فيها غُرفَةً لِلصابِرين",2,"ن",1,0],["أَدخَلَ اللَهُ رَبُّ موسى وَعيسى","جَنَّةَ الخُلدِ مَن مَلاني خَلوقا",3,"ق",2,1],["ادخُلوها خُشّعاً إن رَضِيَتْ","لِثراها الحُرِّ منكم قدما",4,"م",2,0],["ادخلوها بنعمةٍ وسلامٍ","وَاعْمرُوها بأهلِكم والبنينا",5,"ن",2,0],["أَدْخَلْتَ في قُبَّةِ الإسْلامِ مَارِقَةً","أَخْرَجْتَهُمْ مِنْ دِيَارِ الشِّرْكِ إخْراجا",6,"ج",2,0],["ادخلوها يا أَهلها بِسَلامٍ","وكلوا ما شئتم من الطيبات",7,"ت",1,0],["إِدْخالُه عامٌ وعامٌ سَلُّهُ","في استِ زياد بن قُنَيْعٍ كلُّهُ",8,"ل",2,0],["أدخلي بالشموع فهي من الظلمة","وكر في صدرها منحوت",9,"ت",1,0],["أدْخُلوا \" جنَّةَ \" النَّعيم تُلاقوا","ألفَ \" رضوانَ \" فاتحاً ألفَ باب",10,"ب",1,0],["أَدخُل فَدَيتُكَ لا يَشعُر بِنا أَحَدٌ","نَفسي لِنَفسِكَ مِن داءٍ تُفَدّيها",11,"ي",3,0],["أدخلت قومك لم تقدَّر مخرجاً","حتى لقد نشبوا ومثلك ينشبُ",12,"ب",1,0],["أدخلت غيظا على قل","ب أخي عين قريره",13,"ر",2,0],["أَدخَلَتني في مقامٍ شَرُفا","كلُّ مَن يَدخلهُ في مأمنِ",14,"ن",1,0],["أَدخَلتني مِن رِضاها حَرَما","كلُّ مَن يدخلهُ لم يبأسِ",15,"س",1,0],["أدخلتهاست أمه علانيه","بشار يا بشار ياابن الزانيه",16,"ه",1,0],["أدخل هنيئا بالسلا","م يا سعدنا بالزائر",17,"ر",1,0],["أَدخَلتَني في بُيوتٍ رامَ ناظِمُها","إِظهارُ فَضلٍ عَلَيهِ القَدَرُ مَحسودُ",18,"د",1,0],["أَدخَلتَهُ فَعَلا عَلَي","كَ كَذاكَ شُؤمُ الناصِيَه",19,"ه",1,0],["ادخل بما كنت في دنياك تعملهُ","من المبرات إعلاناً واسرارا",20,"ر",2,0],["أَدخَلْتَ نفسَكَ طُولاً","بينَ الكرامِ وعَرْضا",21,"ض",2,0],["أَدخَلَنيهِ حُسنُ ظَنّي بِهِ","وَرُبَّما أَسلَمَني ظَنّي",22,"ن",2,0],["ادخلو في تصرف الرحمانِ","واخرجوا عن تصرف نفساني",23,"ن",2,1],["أَدخلْتَني نارَ الجحيمِ","فصرتَ يا رضوانُ مالِكْ",24,"ك",1,0],["أدخَلتَني حَرَمَ الأمانِ ومُهجَتي","وَعَشيرَتي مِن حَولِهِ تُتَخَطَّفُ",25,"ف",1,0],["أدخِلْ إليَّ أحبَّ الخلق كُلّهمِ","طُرّاً إليكَ فمنهُ واجعلنه وَليِ",26,"ل",2,0],["أَدْخِل إليَّ أَحبَّ الخَلقِ كلهمِ","طرّاً إليكَ فأعطاهُ الذي طلبا",27,"ب",2,0],["ادخل إلى أحبّ الخلقِ كلّهم","حبّاً إليكَ وكان ذاك عليّا",28,"ي",2,1],["ادخلوها مقصورةً ذات عرشٍ","فوقهُ ماكرٌ كثيرُ الرياءِ",29,"ا",2,0],["أدخلِنيَ اللهمَّ بابَ الرِّضى","وكن مِن الشدَّةِ لي مفرجا",30,"ج",2,0],["أَدخل فيها رَأسه وَذاقَها","فَأَطبَقَت لِوقتها أَشداقها",31,"ه",2,0],["أَدخلها كيساً وَقالَ ذوقي","لأحرِمَنكِ المَشيَ في الطَريق",32,"ق",1,0],["اُدخل بِبَطني وَأَقم دَليلا","وَاظهر المَعقول وَالمَنقولا",33,"ل",2,0],["ادْخِرْ فُؤادكَ أنْ يَتُوقَ إلى الحِمَى","إنّ القُلوبَ إلى سُعَاد شُوّقُ",34,"ق",1,1],["أدخلته وأولئك الأقوام قد","شدوا المآزر فوق كثبان النقا",35,"ق",2,0],["أدخله معك جنان الخلد عدته","وخذه فورا من الاوحال والعطل",36,"ل",1,0],["أَدخَلتَ رَأسَكَ في الرَحِم","وَعَلِمتَ أَنَّكَ تَنهَزِم",37,"م",1,0],["أدخلته دار اليتامى فآوته","وأَنُستهُ يتمَه والعُسرا",38,"ر",2,0],["أَدخِلوا الشمس خدرَها فكفاه","ظلمةٌ إنّها به عمياء",39,"ا",2,0],["أدخُلُوها قد بارَكَ اللَهُ فيها","في خُلودٍ لا يعتريه فناءُ",40,"ا",2,0],["أدخلوها تطايرَ الهولُ فيها","فاغِرَاتٌ أفواهُها غضباء",40,"ا",2,0],["ادخُل حَظيراتِ السَّلامَةِ هارِباً","لا تَرتَكِب مَحظورَ فِعلٍ يَحرُمُ",41,"م",1,0],["أدخل بجهدك أصبعا في أليم وان","ظر ما تعلقه اذا بعيان",42,"ن",1,0],["أدخلوا الباب سجداً إن باب ال","عسكريين دونه باب حطه",43,"ط",2,0],["ادخُل على اسمِ اللهِ في خيرِ دار","محل طُهرٍ ومُقامِ اعتبار",44,"ر",1,1],["أدخلنا داره وأكرمنا","ودسّ إمراته",45,"ه",1,0],["أُدخُل تَدَافَا بالشَّمَالِ الغامِر","وَإن يَكُن وَاطِي فَظَلَّ سَايِر",46,"ر",1,0],["أدخلاني السجن قهراً لا بأمري واختياري","فأنا في حالتي وجد مهين واحتقار",47,"ر",1,0],["ادخلي في عبادي اليوم أرخ","وادخلي جنتي أجل جناني",48,"ن",2,0],["أدخل حمى مقامه تلق به","من المنى ما ليس بالمنون",49,"ن",1,0],["أدخل تجد مسجداً أنواره بهرت","وحسن رونقه يزهو على الأموي",50,"و",2,1],["أدخل الحمام هذا يا حميم","وتعجب من نعيم في حميم",51,"م",1,1],["أُدخِلوا لم يَلقَ ضُرّاً","جَنَّتَ دارِ العَطاءِ",52,"ا",2,0],["أدخل مثل الروح في روحه","كالحلم والعالم بي حالم",53,"م",1,0],["أدخلوه بين القوافي أسيرا","وهو يبكي ولا يراهم بكيا",54,"ي",2,0],["ادخلني السجن في مصحٍّ","جميع أربابه كرامُ",55,"م",1,1],["أدخل في الملك يداً رعدةً","أخرجها من بعد إدخالها",56,"ل",3,0],["ادخل بيمناك واخرج باليسار وعذ","باللّه سم وسل مولاك من قسم",57,"م",1,0],["ادخل بأمانٍ مبتهجاً","فالشوق لمصر لا يحصر",58,"ر",1,0],["ادخل إلى الحرم الذي فيه الصفا","للطائفين وكعبة للزائر",59,"ر",1,0],["ادخلوها بسلامٍ من اللَ","ه تعالى واسكنوا آمنينا",60,"ن",2,1],["أدخلت في نسب الإتراك غانية","تنمي الى مضر أكرم به نسبا",61,"ب",2,0],["أدخلت نفسي ومن خاللت من أحد","في الميم والصاد من لفظ اسمك الصمد",62,"د",1,1],["أدخلتهم جيب أبهى من به سبَحَت","شياظِمُ العيس من بطحان للبلد",62,"د",1,0],["أدخلت نفسي وأهلي جيب من شهدَت","بصدق بعثته الغزلان بالجرد",62,"د",1,0],["أدخلتها وأولئك الأقوام قد","شدوا المآزر فوق كثبان النقا",63,"ق",2,0],["أدخلْ لنا في حفظك المكنونِ","عن شرِّ كلِّ الإنس والجنونِ",64,"ن",1,0],["أدخل ذاك الخصر في عدم","وردفه أخرجه للوجود",65,"د",1,0],["أدخلها وادعاً فتجلب لي","رقة قلبي من أهلها سكنا",66,"ن",2,0],["أدخُلِ الحانا وشاهد","ثمّ أحبابً كراماً",67,"م",2,0],["ادخلوها ب