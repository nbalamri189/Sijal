","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[343,"أيها الفارس المشيح المغير","https://www.aldiwan.net/poem68659.html","الطويل"],[353,"أيها الفاضل الأديب يمينا","https://www.aldiwan.net/poem19899.html","الخفيف"],[353,"أيها الفاضل الذي قصر الفا","https://www.aldiwan.net/poem20783.html","الخفيف"],[442,"ايها الفاضل الذي قد هداني","https://www.aldiwan.net/poem2475.html","الخفيف"],[505,"أيها الفجر النسيمات شذت","https://www.aldiwan.net/poem38044.html","الرمل"],[558,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[580,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/198755","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78163","الرمل"],[2161,"","https://poetry.dctabudhabi.ae/diwan/poem/95686","الخفيف"],[2180,"","https://poetry.dctabudhabi.ae/diwan/poem/198363","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200487","الخفيف"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100181","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101225","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216704","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85174","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86368","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90940","الخفيف"],[457,"","https://poetry.dctabudhabi.ae/diwan/poem/61706","الخفيف"],[4679,"صانك الله من صروف البلاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=142762",""],[4881,"فنجان قهوتي","https://www.poetsgate.com/ViewPoem.aspx?id=181729",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5628,"لحن الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=178524",""],[5725,"انسام طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=183345",""],[402,"أيها الفاضل الهام تهنأ","https://www.poetsgate.com/ViewPoem.aspx?id=36246",""],[402,"أيها الفارس الشجاع ترجل","https://www.poetsgate.com/ViewPoem.aspx?id=36057",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6189,"عاهة مستديمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83601&r=&rc=68",""]],"verses":[["أَيُّهَا الفَاضِلُ الهُمَامُ تَهَنَّأْ","بَالِغاً بِالرُّقِيِّ أَسْمَى مَقَامِ",0,"م",1,0],["أيها الفتح المفدّى","خفْ من العاتب فتحه",1,"ح",2,0],["أَيُّها الفائِقُ أَهلَ ال","عَصرِ في مَرأى وَمَخَبرْ",2,"ر",1,1],["أَيُّها الفاجِرُ جَهلاً بِالنَسَب","إِنَّما الناسُ لِأُمٍّ وَلِأَب",3,"ب",1,1],["أَيُّها الفاضِلُ الَّذي لَفظُهُ الدُر","رُ وَلَفظُ الأَنامِ كَالأَصدافِ",4,"ف",1,1],["أيُّها الفاضلُ الذي عزلُوهُ","فتبسمتُ مِنْ غبونٍ وضنكِ",5,"ك",1,1],["أَيُّها الفَيلَسوف جئتَ بِخَير","فَسَلاماً وَراحَةً وَتَحيه",6,"ي",2,0],["أَيُّها الفِتيانُ في مَجلِسِنا","جَرِّدوا مِنها وِراداً وَشُقُر",7,"ر",1,0],["أيها الفاتحُ لا يغررك ما","أنت فيه من حصونٍ وسدود",8,"د",1,0],["أَيُّهَا الفَارِسُ الشُّجَاعُ تَرَجَّلْ","قَدْ كَبَا مُهْرُكَ الأَغَرُّ المُحَجَّلْ",9,"ل",1,1],["أَيُّهَا الْفَاضِلُ الحَبِيبُ الَّذِي فَا","رَقَنَا سَاعَةً وَطَالَ الْبِعَادُ",10,"د",1,0],["أَيهَا الفُرْسَانُ رُوَّادَ السَّمَاءْ","إِنَّنَا قَوْم إلى المَجْدِ ظِمَاءْ",11,"ا",2,1],["أَيُّهَا الفَارِسُ المُجَلَّى وَقَدْ جَاءَ","أَخِيراً فَبَزَّ كُلَّ سَبوقِ",12,"ق",1,0],["أيها الفارس الذي اقتحم الشمس","وألقى رداءه الأرجواني",13,"ن",2,0],["أيها الفُلك، إِن بلغتَ بنا السُّو","دَانَ، فاهدأ، فقد بلغنا الأماني",14,"ن",2,0],["أيْهَا الفِتْيَانُ في مجْلِسِنَا،","جرِّدوا منْها وِارداً وشُقُر",15,"ر",1,0],["أَيُّها الفاسي أَتى ري","حُكَ قَبلَ النَجو يَفغَم",16,"م",1,1],["أَيُّها الفاتِحونَ في الأَرضِ طُرّا","أَيُّها الشارِبونَ كَأسَ الدِماءِ",17,"ا",2,0],["أَيُّها الفَجرُ يا حَبيب الشَقِيّي","نِ وَيا مشعل الهَوى وَالشَبابِ",18,"ب",1,0],["أَيُّها الفارِض السلاحَ عَلَينا","كَيفَ بِاللّهِ تستحلُّ الفرضا",19,"ض",2,0],["اَيُّها الفَجر يا سِراجَ البَرايا","عَجَباً مِنكَ كلَّ يَومٍ تَزورُ",20,"ر",1,0],["أَيُّها الفُؤادُ تما","ديكَ في الهَوى عَجبُ",21,"ب",1,0],["أيّها الفاضل الّذي فَضَل العا","لَمَ في فهمه فليس يرامُ",22,"م",1,1],["أيها الفاتكُ الأثيمُ رويداً","كل يومٍ تكيدُ للتاج كيدا",23,"د",2,1],["أيُّها الفاضِلُ الذي قد حَباهُ","ذهنُه من علومِه بكنُوزِ",24,"ز",1,1],["أيها الفنّانُ ما أج","ملَ دنياكَ وأكرم",25,"م",1,0],["أيها الفيلسوف أنفقت أيّا","مك فيما لا يشترى برماد",26,"د",1,0],["أيها الفارغون إلّا من الما","ل ومن حاشد من الألقاب",26,"ب",1,0],["أَيُّها الفارِسُ المُشيحُ المُغيرُ","إِنَّ قَلبي مِن السِلاحِ يَطيرُ",27,"ر",1,1],["أَيُّها الفَاضِلُ الأَدِيبُ يَمِيناً","لَمْ يَكُنْ في مَوَدَّتي مَا يُرِيبُ",28,"ب",1,1],["أُيَّها الفاضِلُ الذي قَصَّرَ الفا","ضِلُ عن صَنعتْيهِ والأصفهاني",29,"ن",2,1],["ايها الفاضل الذي قد هداني","نَحوَ مَن حمدتُه باختباري",30,"ر",2,1],["أيُّها الفجرُ النُّسَيْماتُ شَذتْ","عنكَ مِسكاً حينَما لُحْتَ صَباحا",31,"ح",2,1],["أَيُّها الفاخِرونَ بِالعِزِّ وَالعِ","زُّ لِقومٍ سِواهُم وَالفَخارُ",32,"ر",1,0],["أَيها الفاضِلُ الَّذِي حَازَ فَضْلاً","عزَّ فِيه التَّعديدُ والتَّحدِيدُ",33,"د",1,0],["أيها الفارس المسجّى سلاماً","يا أمير العطاء والإِحسان",34,"ن",1,0],["أيها الفارس الشهيد وداعاً","في رحاب الفردوس والرضوان",34,"ن",1,0],["أَيُّها الفَتاك طَرفاً","صالَ بِالبيض الصِفاح",35,"ح",1,0],["ايها الفاضل الذي قد هداني","نَحوَ مَن قد حمدتُه باختباري",36,"ر",2,1],["أيها الفاجعي بركني وعزي","هبلتني إن لم أرعك الهبول",37,"ل",1,0],["أيها الفلْس ما أرى فيك خيراً","حيث جافيتَ كلّ صاحب خير",38,"ر",1,1],["أيها الفاضل الذي طال فاستأ","ثر في فضله على ابن الأثير",39,"ر",1,1],["أيها الفاضل الذي قد عرفنا","بسناه معنى التقى والصلاح",40,"ح",1,0],["ايُّها الفاسقُ المملِّقُ آهاً","من دواهي لِسانك الملاقِ",41,"ق",1,0],["أيها الفاتك بالعرض الذي","صانه الطهر ترفق واحذر",42,"ر",1,0],["أيها الفانون في هذي الدنى","خلدكم يا قوم آجال تَوالي",43,"ي",1,0],["أيها الفتان هيا","عاطني كاس الحميا",44,"ي",2,0],["أيها الفاتن العقول بثغر","علم البرق كيف يومض لمحا",45,"ح",2,0],["أيها الفانك اتق اللَه ربا","قد كساك الجمال فازددت عجبا",46,"ب",2,1],["أيها الفاضلُ الذي قد هداني","نحوَ ما قد حمدته باختيار",47,"ر",1,1],["أيها الفاضل الفريد بحزمِ","ونشاط وهمة وإباء",48,"ا",2,0],["أيها الفنجان طوبى لك كم","أنت سالٍ بهناء تنعمُ",49,"م",1,0],["أيها الفترة اقترفت ذنوباً","قد تلقى عقابها النبلاء",50,"ا",2,0],["ايها الفارس الذي أرضعته","وغذته من سحرها الصحراء",51,"ا",2,0],["أيّها الفاضحُ سرّي كيف لي","بعْدَ فضْحِ السرّ أن أسْتترا",52,"ر",2,0],["ايها الفارس في اغوارها","هل الفْتٓ النقع من وقع الضباحِ",53,"ح",1,0],["أيها الفاضل الهام تهنأ","بالغا بالرقي أسمى مقام",54,"م",1,1],["أيها الفارس الشجاع ترجل","وقد كبا مهرك الأغر المحجل",55,"ل",1,1],["أيّها الْفكْر الْحائر الْيوم ترْسو","بين آمالٍ تغتلي لاحْتوائي",56,"ا",2,0],["أيها الفارسُ الجَميلُ وداعاً","فتحُنا رحمةٌ وحبٌ وصفحُ",57,"ح",1,0],["أيها الفارس الجميلُ أجبني","كيف يعلو على الشوامخ سفْح",57,"ح",1,0]]}