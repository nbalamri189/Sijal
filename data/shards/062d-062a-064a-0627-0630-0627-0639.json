{"poems":[[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[95,"زرت حمى الحسناء والشمس قد","https://www.aldiwan.net/poem11365.html","السريع"],[39,"أولى وأولى له حسنى وسيئة","https://www.aldiwan.net/poem6509.html","البسيط"],[74,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[74,"ماذا من الشوق جناي والأرق","https://www.aldiwan.net/poem19358.html","السريع"],[31,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[93,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[93,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[87,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[58,"بأبي الثلاث الآنسات","https://www.aldiwan.net/poem58630.html","مجزوء الكامل"],[45,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[64,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[68,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[54,"قرب الحبيب إلى المحب الوامق","https://www.aldiwan.net/poem26806.html","الكامل"],[54,"يا مدخل الصلع حماما يزيدهم","https://www.aldiwan.net/poem27137.html","البسيط"],[50,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42553","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[124,"يا حبذا أمسى من","https://www.aldiwan.net/poem49366.html","مجزوء الرجز"],[159,"إني طلبت إلى القرطاس يحمل لي","https://www.aldiwan.net/poem55590.html","البسيط"],[189,"أفرط نسياني إلى غاية","https://www.aldiwan.net/poem14552.html","السريع"],[246,"زاحفت أيامي وزاحفنني","https://www.aldiwan.net/poem45756.html","السريع"],[261,"يا سيدي جودك المشهور ما فعلا","https://www.aldiwan.net/poem48367.html","البسيط"],[275,"ما جئت ألتزم القوام الناحلا","https://www.aldiwan.net/poem35412.html","الكامل"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[295,"أسفا لقد ولى الشباب ولم أفد","https://www.aldiwan.net/poem11672.html","الكامل"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[369,"زف المنام إلي طيف خياله","https://www.aldiwan.net/poem60669.html","الكامل"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[376,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[376,"خلصت من خدعات الأعين النجل","https://www.aldiwan.net/poem57198.html","الكامل"],[376,"أخفيت عزمك للفراق فما خفي","https://www.aldiwan.net/poem57294.html","الكامل"],[398,"يا زائرين اجتمعوا جموعا","https://www.aldiwan.net/poem53509.html","الرجز"],[398,"يا زائرا قد قصد المشاهدا","https://www.aldiwan.net/poem53586.html","الرجز"],[412,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[415,"وصاحب صاحبته","https://www.aldiwan.net/poem31717.html","عموديه"],[415,"ما أنصفوا في الحب إذ حكموا","https://www.aldiwan.net/poem32534.html","السريع"],[438,"ومزنر أضحى يقول ثلاثة","https://www.aldiwan.net/poem12607.html","الكامل"],[449,"الرقة البيضاء تشكو ولا","https://www.aldiwan.net/poem56022.html","عموديه"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[463,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[466,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[470,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[473,"وعاتق من بنات البر صافية","https://www.aldiwan.net/poem60043.html","البسيط"],[482,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[515,"أزوركم فتكاد الأرض تقبض بي","https://www.aldiwan.net/poem1579.html",""],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63917","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77499","الرجز"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96298","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78041","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50016","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108687","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42474","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82155","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107008","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[3472,"","https://poetry.dctabudhabi.ae/diwan/poem/89617","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131057",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59513","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139422",""],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28683","الكامل"],[4759,"ليته عدلا","https://www.poetsgate.com/ViewPoem.aspx?id=204047",""],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[4904,"كانَ الْقِرى لَحْمي","https://www.poetsgate.com/ViewPoem.aspx?id=175727",""],[4119,"يا ليت أن الصد مصدود","https://www.poetsgate.com/ViewPoem.aspx?id=16113",""],[5101,"حضن الغوى","https://www.poetsgate.com/ViewPoem.aspx?id=202973",""],[5239,"عرس بجزين يا مستعبد النجف","https://www.poetsgate.com/ViewPoem.aspx?id=190941",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5464,"يا أخت مكة","https://www.poetsgate.com/ViewPoem.aspx?id=701",""],[5628,"نذاء الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178463",""],[5909,"ما عندنا ما عندكم من نارِ","https://www.poetsgate.com/ViewPoem.aspx?id=210240",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""]],"verses":[["حَتّى إِذا عَرَّسوا في حَيثُ تَفرُشُهُم","نَمارِقَ الرَملِ أَنقاءٌ وَكُثبانُ",0,"ن",1,0],["حَتَّى إِذَا عَنَّ لَهُ شَخْصُهَا","وَقَدْ بَدَتْ فِي وَشْيِهَا النَّاعِمِ",1,"م",1,0],["حتى إذا علم التدراج واتخذت","رجلاه كالدرع آثار على الكثبِ",2,"ب",1,0],["حتَّى إذا عادَ إليَّ الرِّضى","عادَ بحمدِ الله سجادي",3,"د",2,0],["حتَّى إذا عادَ إلى صرحِها","قامَ له الغصنُ على قدّه",4,"د",2,0],["حتَّى إذا عادَ إمام الهدى","تساعد السعد فرق الفرق",5,"ق",1,0],["حَتّى إِذا عَلِمَ الإِلَهُ نَكالَهُ","وَتَصاغَروا لِلحَربِ أَيَّ صَغارِ",6,"ر",1,0],["حَتّى إِذا عَضَّها نابُ الطَوى نَفَرَت","تَستَنزِلُ الرِزقَ فيها الفَرد وَالنَفَرا",7,"ر",2,0],["حَتّى إِذا عَكَفَت عَلَيَّ وَساوِسي","وَنَبا الفِراشُ نَزَعتُ لِلتَجوالِ",8,"ل",1,0],["حَتّى إِذا عَرَّدَت عَنهُ سَوابِقُها","وَعانَقَ المَوتَ مِنها سَبعَةٌ عَدَدُ",9,"د",1,0],["حتى إذا عدت يا دنيا همو عرفوا","قصد المنجم من تلك الإذاعات",10,"ت",1,0],["حتى إذا عايَنْتُهُنَّ","وللأُمورِ مُسَبِّباتُ",11,"ت",1,0],["حَتّى إِذا عُقِدَت فيهِ القِبابُ لَهُ","أَهَلَّ لِلَّهِ باديهِ وَحاضِرُهُ",12,"ر",2,0],["حتى إذا عجزت عن استخراج","نفسها ولا ثبات لاستغراقها",13,"ق",3,0],["حَتّى إِذا عَبَثَ الكَرى بِجُفونِهِ","كانَ الوِسادَةَ ساعِدي وَالمِرفَقُ",14,"ق",1,0],["حَتّى إِذا عَرَفوا الهَدى وَرَمَت يَدٌ","ما جَمَعَت لِمُخاتِلٍ وَلِسارِقِ",15,"ق",1,0],["حَتّى إِذا عَرِقوا مِن حَرِّهِ شَرَعوا","وَكُلُّهُم بِخُلوفٍ مِنهُ قَد لُطِخا",16,"خ",2,0],["حَتّى إِذا عُقِرَت سالَت سُلالَتُها","في قَعرِ مَعصَرَةٍ كَالعَندَمِ القاني",17,"ن",2,0],["حتى إذا عَفتِ الصبابةُ وانقضى","ما بيننا أَقبَلتُ أسأَلهنَّ",18,"ن",1,0],["حتى إذا عرّى الخريف غصونها","من وشي تلك الحلَّة الخضراءِ",19,"ا",2,0],["حتى إذا عزّنا المرأى وأجهدنا","دلّ الشعور على أن ذاك موضعه",20,"ه",1,0],["حتى إذا عَبرَتْ ليالٍ طوَّفَتْ","أحلامُه بالبحر ذاتَ مساءِ",21,"ا",2,0],["حتى إِذا عَلَمُ الصَّبا","حِ أَشار مِن تِلْكَ المعالِمْ",22,"م",1,0],["حتّى إِذا عَرَفتَ تلكَ الأَبنيهْ","واحدَها وجَمعها والتَّثنيهْ",23,"ه",1,0],["حَتَّى إِذَا عَلِمتْ أَنِّي بِهَا كَلِفٌ","وَأَنَّنِي مِنْ تَجَنِّيهَا عَلَى خَطَرِ",24,"ر",1,0],["حَتَّى إِذَا عَلِمَتْ مَا حَلَّ بِي ورَأَتْ","سُقْمِي وخَافَتْ عَلَى نَفْسٍ بِهَا افْتَضَحَتْ",25,"ت",1,0],["حَتَّى إِذَا عُدْنَا عَلَى","صَوْتِ المُؤَذِّنِ بِالْعَشَاءْ",26,"ا",2,0],["حتى إذا عجَموا قناةً مُرَّةً","شوكاءَ ، تُدمي مَن أتاها حاطبا",27,"ب",2,0],["حتّى إذا عزّ الشهود تمحّلوا","فرأوا شهودا في القريض عدولا",28,"ل",2,0],["حتى إذا عاد الربي","ع واكتسى الروض الحبر",29,"ر",1,0],["حَتَّى إِذا عَلِمَ القِرْطاسُ ما كَتَبَتْ","كَفِّي مِنَ الشَّوْقِ في أَحْشائِهِ احْتَرَقا",30,"ق",2,0],["حتى إذا عاودتُ طالعتُها","ذَكَّرتِ العينُ بها النفسا",31,"س",2,0],["حتَّى إذا عدتُ إلى مِنزلي","وجدتُ سوءَ العَيشِ في المنزلِ",32,"ل",1,0],["حتى إذا عاد من أرسلته بيدٍ","صفرٍ وما كان عندي أنه وصلا",33,"ل",2,0],["حتى إذا عدنا وزندي عالقٌ","بذراعِها والوقتُ يذهبُ عاجلا",34,"ل",2,0],["حتى إذا عرَضَت فأعرَضَ خائفاً","أدَنت من الخدَّين ما أشقانا",35,"ن",2,0],["حتى إذا عرضت له تاييس في","حللٍ الجمال وفتنة الأهداب",36,"ب",1,0],["حَتّى إِذا عَفَتِ المَذاهِبُ وَاِغتَدَت","مِنها سُهولُ الأَرضِ وَهيَ وُعورُ",37,"ر",1,0],["حَتّى إِذا عَمَّها بِالماءِ وَاِمتَلَأَت","ساقَت تَوالِيَهُ شامِيَّةٌ شَمِلُ",38,"ل",1,0],["حتّى إذا عَمّتِ البُشْرى وقيل لقد","حَلّتْ مَواكبُه حَلَّتْ عَزاليه",39,"ي",2,0],["حتّى إذا عبَث السُّباتُ بقَدِّه","عَبثاً يَكونُ الجِدُّ من أمثاله",40,"ل",2,0],["حتّى إذا عُدْتُ إلى مَجْثمِي","عُدْتُ إلى عُمّالِ سُوءٍ وقاح",41,"ح",1,0],["حتَّى إذا عَرَفته صارَ حَوادِثاً","وتَرى هُناكَ القَبضَ والتَّسلِيما",42,"م",2,0],["حتَّى إِذا عَلِقَت كفاهُ صحتُ بِه","هَذا عَليٌّ وهَذا غُرَّةُ بنُ عَلِي",43,"ل",2,0],["حتَّى إِذا عَلِمَت بذاكَ جفونُه","كشَفَت بفَيضِ الدَّمعِ ما لَم يُكشَفِ",44,"ف",1,0],["حَتّى إِذا عُدتُم إِلى الغَريِّ","فَسَلِّموا عَنّي عَلى الوَصِيِّ",45,"ي",1,0],["حَتّى إِذا عُدتُم إِلى بَغدانِ","لمشَهد الزَكاءِ وَالرِضوانِ",45,"ن",1,0],["حَتّى اِذا عدتَ لِأَرض الكوفَه","البَلدَةِ الطاهِرَة المَعروفَه",46,"ه",1,0],["حَتّى إِذا عَلِمَ الزَمانُ بِأَنَّني","من لائِذيه حادَ عَن إِقدامي",47,"م",2,0],["حتى إذا عاينته","عاينت منه ما أبيته",48,"ت",2,0],["حتّى إِذا عصرُ الشّبابِ اِنقضَى","وأَشرَقَتْ في ليليَ الأَنجُمُ",49,"م",1,0],["حتى إذا علِقَتْ بنا يدُ مُنكرٍ","كانت لنا فيما يقولُ مقاصدُ",50,"د",1,0],["حتى إذا عاد إلى منصب","سواه قد آمن حرمانها",51,"ن",3,0],["حتى إذا عرفوا طبي","عته وما طوت المشاعر",52,"ر",1,0],["حتى إذا علِقَ الرجاء بها رمتْ","عن قوس نازحةِ المزار شَطونِ",53,"ن",1,0],["حتى إذا عادَ نِقْضاً بعد شِرَّتهِ","وكادَ يلْحقُ بالأمواتِ والرِّممِ",54,"م",1,0],["حتى إذا عَجَمُوا صُلْبَ القَناةِ فَلَم","يُلْفُوا، كما وَهِمُوا، باناً ولا قَصَبا",55,"ب",2,0],["حَتّى إِذا عَبَثَت أَيدي السُقاةِ بِها","أَبدَت حَباباً كَتُفّاحِ القَواريرِ",56,"ر",1,0],["حتى إذا عيسُهُمُ للنوى