gate.com/ViewPoem.aspx?id=207124",""],[5957,"زارني حرفٌ جميلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=37427",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6055,"إلى الحداثة....مع التحية","https://www.poetsgate.com/ViewPoem.aspx?id=30577",""],[4442,"أنت والسجن صارم وقراب","https://www.poetsgate.com/ViewPoem.aspx?id=171198",""],[6099,"قانأ","https://www.poetsgate.com/ViewPoem.aspx?id=35798",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["أَينَعَت بَينَنا المَوَدَّةُ حَتّى","جَلَّلَتنا وَالدَهرَ بِالأَوراقِ",0,"ق",1,0],["أَينَ عِقبانُكِ الخَواطِفُ حَلَّق","نَ وَأَبقَينَ عِندَكِ الأَوكارا",1,"ر",2,0],["أَينَ عَنكُم لِلَّذي يَبغي بِكُم","ظِلَّ عَدنٍ دونَها حَرُّ لَظى",2,"ا",1,0],["أَينَ عَنكُم لَمُضِلٍّ طالِبٍ","وَضَحَ السُبلِ وَأَقمارَ الدُجى",2,"ا",1,0],["أَينَ عَنكُم لِلَّذي يَرجو بِكُم","مَع رَسولِ اللَهِ فَوزاً وَنَجا",2,"ا",1,0],["أَيْ نَعْشَهُ فِيكَ الْعَفافُ مُشَيِّعاً","وَالْعِلْمُ مَبْكِياً بِكُلِّ جنَانِ",3,"ن",1,0],["أينَ عيشي والشمل فيه جميع","ومراحِي وما استقلّ الفريق",4,"ق",1,0],["أينَ عبد الحميد من نثرِهِ الجز","ل الذي قد كساه ثوب الذميم",5,"م",1,0],["أين عنّي سعادةٌ من سعيدٍ","جَدِّكم لا برحتُمُ سُعَداءَ",6,"ا",2,0],["أين عنّي سلامة من سليما","نَ تَقيني بدرعِها أنْ أساءَ",6,"ا",2,0],["أين عنّي قَسْمُ الوزير أبي القا","سم أحرارَ ماله أنصباءَ",6,"ا",2,0],["أين عنّي إحسانُ صِنْوَينِ قدَّا ال","حسنَ قدّاً تَسَمِّياً واكْتِناءَ",6,"ا",2,0],["أين عن مُعْرِقٍ من الخيلِ طرفٍ","عزَّ إحضارُهُ اقتحامَ العُقابِ",7,"ب",1,0],["أين عنه وقارُ ما يدَّعيهِ","من عُلومٍ لحامليها قُطُوبُ",8,"ب",1,0],["أين عينٌ بعيدةٌ","من فتور ومن دعَجْ",9,"ج",1,0],["أينَ عَسى يَعدِلُ عنه لاعسا","تكادُ من غُلْمتِه أن تُسْلَسا",10,"س",2,0],["أين عُقبى صبري وشُكري ونَشري","أين من فائتِ الزمانِ اعتياضي",11,"ض",2,0],["أينَ عُمَّاره الأُلى عمَروهُ","دَهْرَهُمْ في تلاوة وصيام",12,"م",1,0],["أَيْنَ عَزْمُ الحَيَاةِ لا شيءَ إلاَّ","الموتُ والصَّمْتُ والأَسى والظَّلامُ",13,"م",1,0],["أينعت عصرا طويلا وأتت","دون أن نستأنف العصر الطويل",14,"ل",1,0],["أيّ نعيمٍ في الصِّبَا والمُقْتَرَحْ","وشغلُ كفّيّ بكوبٍ وقَدَحْ",15,"ح",1,1],["أينَ عادٌ أينَ فرعونُ ومَنْ","رفعَ الأهرامَ مَنْ يسمعْ يخلْ",16,"ل",1,0],["أَينَ عَيشي بِكَ في ظِلِّ المُنى","في فُنونٍ دائِماتٍ وَفُتون",17,"ن",1,0],["أَينَ عَنكَ الشَمسُ يا لَيلَ الصُدودِ","عِندِيَ الصَبرُ فَقُل هَل مِن مَزيدِ",18,"د",1,1],["أَينَ عَمرٌ لَمّا دَعا أُمَّ عَمرٍ","وَلَدَيها مِنَ المُدامَةِ صَحنُ",19,"ن",1,1],["أَين عزي في دولة الأتراكِ","أَنا مِمّا فقدته أَنا باكي",20,"ك",2,1],["أَينَعَت عَصراً طَويلاً وَأَتى","دونَ أَن تَستَأنَفَ العَصرُ الطَويل",21,"ل",1,0],["أينَ عنَّا إخطارُنا المالَ وال","أَنفُسَ إذ ناهَدُوا لِيومِ نَوالٍ",22,"ل",1,0],["أَيْنَ عِيسَى وَتَاجُهُ الشَّوْكُ مِنْ مُتْ","رَفِ رُومَا وَتَاجُهُ مِنْ وُرُودِ",23,"د",1,0],["أينَ عيناك تنظراني وكفّي","فوقَ قلبي ودمعتي فوقَ خدّي",24,"د",2,0],["أَينَ عَهدُ تُبّعِها","أَينَ عَهدُ قَيصَرِها",25,"ر",3,0],["أيْنَ عزُّ المُلْكِ الّذي كانَ للآ","مالِ في سَوْحهِ مَرَاحٌ ومَغْدَى",26,"د",2,0],["أين عهدُ الشباب واللّهوِ يا شع","رُ وأين الهَوى وأين المغاني",27,"ن",2,0],["أين عَمْروٌ فتى العُرُوبة والإِقْدامِ","أَوْفَى مُجَاهدٍ بالعقودِ",28,"د",1,0],["أين عهدُ الرشيد يحشو فم الشا","عر بالدرِّ؟ أين عهدُ الرشيد؟",29,"د",1,0],["أيْن عشٌ رفَّ النعيمُ عليه","من قصور رَانَتْ عليها الكآبة؟",30,"ب",2,0],["أيْن عهدُ الرشيد حين تحدَّى","في السموات عارِضًا هتانا؟",31,"ن",2,0],["أين عشّي وجودلي وجناني ؟","أين جوّي ؟ وأين برّ أماني ؟",32,"ن",2,1],["أينَ ، عن حرمة الأمومةِ داستْها","وحوشٌ ، المصلحونَ الغَيارى",33,"ر",2,0],["أَيْنَعْنَا، قَالَتْ سُفْرَتُنَا","أَرِنِيْ يَا بَرْقُ سَنَىْ جَمْرِيْ",34,"ر",2,0],["أَينَ عَنّا إِخطارُنا المالَ وَالأَن","فس إِذ ناهَدوا لِيَومِ المَجالِ",35,"ل",1,0],["أينعى فوق ذواه","واحفظي عهد السقاة",36,"ه",1,0],["أَيْنَعْتَ لِي في نَبْعَتِي وَرقَ الغِنى","وَدَفَعْتَ عَنِّي بِاليَقِينِ ظُنُونا",37,"ن",2,0],["أَينَ عَن ثارِها هَناةُ فُروعُ ال","عِزِّ أَم أَينَ كَهفُهُ المَأمولُ",38,"ل",1,0],["أَينَ عَزمي وَأَنا المانِعُها","يَومَ تَأتي مُشرَئِبّات الهَوادي",39,"د",2,0],["أين عُذّالي أراحوا في سبات","وترّدوا في جحيم من خمول",40,"ل",1,0],["أَيْنَ عَهْدُكُمُ الْمُؤَكَّدُ أَيْنَا","أَنِقِيضَ الْمُرَادِ كُنَّا ارْتَضَيْنَا",41,"ن",2,1],["أين عيشي بها القديمُ وذاك الت","يَّهُ فيها وخطَرَتي والشَّملَه",42,"ل",2,0],["أين عقلي أين قلبي","ضَيعاني في السّرابِ!",43,"ب",1,0],["أَيْنَ عُذْرِي إَذا اسْتَزَدْتُكَ جُوداً","لَمْ يَدَعْ خَلَّةً لَدَيَّ تُسَدُّ",44,"د",1,0],["أين علم الكشف من نظر","أين رأى العين من خبر",45,"ر",1,0],["أَيُّ نِعَمٍ هَكَذا مُحَمَّد باشا","عَينُ أَعيانِ ثَغرِنا الناضوري",46,"ر",2,0],["أين عاد بل أين جنة عاد","ارم ابن صالح وثمود",47,"د",1,0],["أَيُّ نعمائك يقضي حقّها","أيُّها السَّيِّد هذا العبد شكرا",48,"ر",2,0],["أينَ عهدُ الهوى بآرام نجدٍ","وبلوغ المَشوق فيها المراما",49,"ا",1,0],["أَيّ نعمائك أقضي حقَّها","فلَقَدْ حمَّلَتْني حملاً ثقيلا",50,"ل",2,0],["أينَ عهدي بهم فقد طال عهدي","فسُقي عهدهم بصَوب عِهاد",51,"د",1,0],["أين عهدٌ مضى وعصرٌ تقضى","بين أسد الشرى وغزلان رامه",52,"م",2,0],["أين عادَ المطواعُ ثَم وهل غي","ر انقياد مجانب لخلاف",53,"ف",1,0],["إي نعم وهو إن يعد جنينا","ساد في الحلم قادرا واستكنا",54,"ن",2,0],["أيّ نعمى للوصل عندي لو قصّر","من عمر جفوتي من أطاله",55,"ل",2,0],["أينعت رغم الذاريات بحقله","فالكم مفتر عن الزهر الندي",56,"د",2,0],["أينع الزهر أنت يا","قدها يا غصن التقى",57,"ق",2,0],["أينعت أزهار دوحتكم","روضكم طابت مجانيه",58,"ي",2,0],["أيُّ نعيمٍ لم يزلْ","مُجَمَّعاً ما اِفترقا",59,"ق",2,0],["أين عَمرو مِن بَسالَتِه","أينَ عَباسٌ ومِرداسُ",60,"س",1,0],["أَين عَبد الحَميد رَبُّ المَعاني","مِنكَ يا مَن أَحكَمتَ وَضع المَباني",61,"ن",2,1],["أينَ عَطْفُ الجِيادِ من عَطْفِ جِيْدٍ","وانْعِطافُ الرِّماحِ من عِطْفِ لِيْنِ",62,"ن",1,0],["أيّ نعمى للوصل عندي لو قص","صر من عمر جفوتي من أطاله",63,"ل",2,0],["أي نعم فازوا وحازوا فوق ما","قد رجوا والكل منهم قد ورد",64,"د",1,0],["أين علي المرتضى","مقهقر الكتائب",65,"ب",1,0],["أين عزم الذى أعانته أيد","عند من وحده علا الأهرامَا",66,"م",2,0],["أينعت روضةُ الهنا فاجتنينا","لكم التهنياتِ منها ثِمارا",67,"ر",2,0],["أين عيس المنون فيك استقلت","بالحصيف المضفّر الآراء",68,"ا",2,0],["أي نعم أنتما كذلك لكنْ","هي في القلب نقطة سوداءُ",69,"ا",2,0],["أى نعش قد استقل ببحر","العلم والفضل والندى العجاج",70,"ج",1,0],["أين عنه أبوه حيدرة الكرا","ر تفني بسيفه الأعداء",71,"ا",2,0],["اين عبد العزيز أصبح مثلى","ضائعاً في جزيرة الأسبان",72,"ن",1,0],["أين علامات الحجى والنهى","بل اين ىيات التقى والطلاح",73,"ح",1,0],["اينعى ابن حسّان فتى الأرض كلها","فكيف وما دكت على ظهرها الهضب",74,"ب",1,0],["أي نعم يرضى به اشرفنا","وتراه بالرضى معترفا",75,"ف",2,0],["أينع الفكر في خمائلها الغ","نَّاء ما يملأ الزمان جلالا",76,"ل",2,0],["أي نعمى تضاءت أمة التثلي","ث فيها لملة التوحيد",77,"د",1,0],["أيّ نعمى طالت فروعاً وأضفت","ها ظلالاً أصولها الناصريّة",78,"ي",2,0],["أيّ نعمى ضفت على الملك الظاف","ر منها ملابس الإسعاد",79,"د",1,0],["أين عفوّ اسمه","من اسمه المنتقم",80,"م",1,0],["أين عيش لنا مضى فيك ما أس","رع عنا ذهابه وزواله",81,"ل",2,0],["أَينَعَ الذِكرُ وَاِزدَهى في ذُراهُ","وَتَغَنّى فَأَطرَبَ الإيحاءُ",82,"ا",2,0],["أين عهدُ الرواحِ هل هُوَ إتٍ","أم صباحي مُمَاثِلٌ للرُّواحِ",83,"ح",1,0],["أين عيش العروس إذ يبطح السُّك","ر حبيبي ما بين تلك الأباطح",84,"ح",1,0],["أين علمت ارتقاء الجو والسر","عندي في صعودي صينُ",85,"ن",1,0],["أينع الغصن وطاب المجتني","وهفا الدوح إلى رجع الهديل",86,"ل",1,0],["أينعت إذ جادها صوب الحيا","وذوت من بعد أن جف نداها",87,"ا",3,0],["أينَ عادٌ وَتُبّعٌ وأولو الرَّس","وأينَ الألى وأين نَصير",88,"ر",1,0],["أينَ عيناهُ تنظُرُ الخمرَ إذ عُطّلَ","منهُ الرَّاووقُ والمجريسُ",89,"س",1,0],["أينّ عيناهُ ينظُرُ المزرَ إذا أو","حشَ منهُ المأجورُ والقادوسُ",89,"س",1,0],["أينَ عَيناهُ والحشائشُ يُحْرَق","نَ بنارٍ تُراعُ منها المجوسُ",89,"س",1,0],["أينَ عَيناه تَنْظُرُ والحا","نةَ قَدْ هَدَّمَتْ ذَراها الفؤوس",89,"س",1,0],["أئن عَراني دهري بنائبةٍ","أصبح منها الفؤاد مشتعلا",90,"ل",2,0],["أين علامة الزمان ومن قد","كان فخر المحققين الكرام",91,"م",1,0],["اين عيناه منك اين المحيا","اين جيد عليه يا بدر متا",92,"ت",2,0],["أينعت في افنانها ثمرات","من رياض الفضل الجزيل المزيد"