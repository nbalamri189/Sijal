{"poems":[[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[90,"أبعد الدهر في الفضاء مكره","https://www.aldiwan.net/poem45074.html","الخفيف"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[31,"هل تعرف الدار قد محت معارفها","https://www.aldiwan.net/poem6079.html","البسيط"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[92,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[132,"أتاني كتاب من شقيقى ووالدى","https://www.aldiwan.net/poem50625.html","الطويل"],[147,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[147,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[287,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[505,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[519,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[556,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[567,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104051","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67004","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72296","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126187","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112887","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79791","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113979","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111800","الكامل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81897","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47154","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47153","الكامل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82174","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120573","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88977","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48300","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86301","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138553",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216701","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117924","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135563","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127773","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76745","الكامل"],[4739,"أنا إنسان","https://www.poetsgate.com/ViewPoem.aspx?id=28153",""],[4788,"ذكرى تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=132307",""],[4797,"الحب مثل النوم","https://www.poetsgate.com/ViewPoem.aspx?id=29437",""],[4800,"لو انساهم","https://www.poetsgate.com/ViewPoem.aspx?id=105043",""],[4805,"حكمه","https://www.poetsgate.com/ViewPoem.aspx?id=176602",""],[4805,"لجة صمت 2","https://www.poetsgate.com/ViewPoem.aspx?id=176603",""],[4816,"قالت","https://www.poetsgate.com/ViewPoem.aspx?id=8486",""],[4816,"المارد الموهوب","https://www.poetsgate.com/ViewPoem.aspx?id=23719",""],[4869,"الامير نايف بن عبدالعزيز رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=138050",""],[4955,"وتبخرت أفراحنا","https://www.poetsgate.com/ViewPoem.aspx?id=188733",""],[5039,"نجد واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=48112",""],[5338,"لي في هباتك حيرة لا توصف","https://www.poetsgate.com/ViewPoem.aspx?id=187913",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5338,"عرش الإمامة جنب حوض الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=190172",""],[5461,"حنا العرب","https://www.poetsgate.com/ViewPoem.aspx?id=22531",""],[5550,"لا تكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=215331",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5608,"تخنقني عبْرَه","https://www.poetsgate.com/ViewPoem.aspx?id=33244",""],[5616,"العقد الفريد","https://www.poetsgate.com/ViewPoem.aspx?id=204588",""],[5648,"وش فيك ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=154660",""],[5739,"اكتبيني بقرطاس ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131226",""],[402,"ولو المدينة وجهكم ودعوني","https://www.poetsgate.com/ViewPoem.aspx?id=36524",""],[5819,"بنت صور","https://www.poetsgate.com/ViewPoem.aspx?id=215659",""],[5848,"مع الإعتذار للجنة التحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=48960",""],[5848,"ختامها مسك","https://www.poetsgate.com/ViewPoem.aspx?id=53164",""],[5848,"اشك إنه صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=53202",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[6056,"وطفاء الحجاجين","https://www.poetsgate.com/ViewPoem.aspx?id=130183",""]],"verses":[["ولَوِ الجواري الخُنّسُ انْتسَبَتْ الى","أقْوامِ عزْمِكَ ما خَنَسْنَ خُنوسا",0,"س",2,0],["ولو الشمس ضوعفت ألف ضعف","لم تكن في أثيره غير ذرةّ",1,"ر",2,0],["ولو الفكر غاص فيه مغذّاً","لم يكن بالغاً يدّ الدهر قعره",1,"ر",2,0],["ولو التقيتَ وحاتماً لحسبتَهُ","أعداه جودُك أن عراك نزيلا",2,"ل",2,0],["ولو التوَوْا لرميتَهم بمكائدٍ","أخفَى من الأجلِ الحبيسِ مكامنا",3,"ن",2,0],["وَلَو إِلى اِبنِ خُدَيشٍ كانَ مَرحَلُنا","وَاِبنَي دَجاجَةَ قَومٍ كانَ أَخيارِ",4,"ر",1,0],["وَلَو اِلتَقَينا حَيثُ يَصغي ساعَةً","لَسَقتهُ بَينَ مَلامَةٍ وَتَشَكُّرِ",5,"ر",1,0],["وَلَوِ الوَاجِبُ المُخَلَّفُ لَمْ يَثْنِكَ","لَمْ تُلْفَ مُبْطِئاً بِاللِّحَاقِ",6,"ق",1,0],["وَلَوِ الزَّمَان أَرَادَ عَادُوا خُضَّعاً","لِجَمِيلِ رَأْيِكَ عَوْدَ الاسْتِغْفَارِ",7,"ر",1,0],["وَلَو الْجِبَالُ جُعِلْنَ بَعْضَ حِجَارِهِ","وَلُحِمْنَ حَتَّى المَاءُ لاَ يَتَسَرَّبُ",8,"ب",1,0],["وَلَوِ البَدْرُ يَسْتَطِبُّ إِلَيْهِ","لَشَفَى مَا بِهِ مِنَ العِلاَّتِ",9,"ت",1,0],["وَلَوِ الْوَفَاءُ بَدَا مِثَالاً لَمْ يَكُنْ","أَحَدٌ سِوَاهُ مِثَالَهُ المَصْدُوقَا",10,"ق",2,0],["ولوالدٍ وُرِّثْتُ من دَمِه","محضَ الإباء وسورةَ الغَضَب",11,"ب",1,0],["ولو التَقى من بعدِ طُولِ تَفَرُّقٍ","الشَيخُ ، والقِسيّسُ ، والحَاخام",12,"م",1,0],["ولو أَلُف خطٍّ ما تسلَّت قلوبنا","بها ليس تُسْلِينَا سُطورُ الكواغد",13,"د",1,0],["وَلَوِ الوَغى شُبَّت كَفَيتَ مُصالِتاً","كَيدَ الطُغاةِ كَما كَفَيتَ مُدَبِّرا",14,"ر",2,0],["وَلَوِ اِلتَمَستَ حُضورَ مَلكِهِمُ غَداً","لَأَتاكَ إِسلاماً أَوِ اِستِسلاما",15,"م",2,0],["وَلَو الرُحمُ حينَ يَغضَبُ لِلَ","هِ عَداهُ لَذابَتِ الأَشياءُ",16,"ا",2,0],["وَلَو أَلِفَ اللَيثُ الهَصورُ عَرينَهُ","لَماتَ طوىً فيهِ وَإِن كانَ ذا لِبدِ",17,"د",1,0],["ولو الْتَفَتُّ لميِّتٍ وهَزَزْتُهُ","بمَديحِ عَلْياكُمْ لعاشَ من العَدَمْ",18,"م",1,0],["ولو إلى أرضه يهوي الهِلالُ دُجىً","لم ترضَهُ أنّه من نَعلِها بدَلُ",19,"ل",1,0],["ولوِ الرّدى ممّا يدافعه الفتى","لدفعتُ عنه بكلّ غالٍ أرْوَقِ",20,"ق",1,0],["ولَوِ الحَواريُّونَ نَصُّوهُ عَلَى","قَدَرٍ بمجتمعٍ لهم ومخُيَّمِ",21,"م",1,0],["ولو اللّيالي صورت أَيامها","منها لما اتَّصلت بداجٍ مُسرفِ",22,"ف",1,0],["ولوِ الأمورُ جَرَتْ على مِقْدَارِها","حَمَلَ السِّلاحَ لكَ السِّماكُ الأعْزَلُ",23,"ل",1,0],["وَلو الغصن بِهذا أَعلَما","لَتَمنّى أَنَّه لَم يُغرَسِ",24,"س",1,0],["ولو إلى مقعد زفت لقام على","الأقدام يسعى ولم تقعده آفات",25,"ت",1,0],["ولو إلى أخرس ألقوا صحيفتها","للذ في السمع من فحواه نغمات",25,"ت",1,0],["ولو إلى غيره أدعى وتجعل لي","ما في البسيطة لم أعلق به أنفا",26,"ف",2,0],["ولوالديه وكل من يدعو له","بالخير ثم أحبه وتوددا",27,"د",2,0],["ولو البحور ودوحها وسماؤها","نقسا واقلاما غدت وطروسا",28,"س",2,0],["ولوالدي فكن حبيبي ساترا","واتمم لنا بهدى وسر قد سرا",29,"ر",2,0],["ولو النجومُ الزهرُ تملِكُ أَمرها","لهوت تُقَبِّلُ دهرها أعتابها",30,"ب",3,0],["ولِوالِدَيَّ وأُسرتي وعشائِري","أرجو الخلاصَ منَ الهلاكِ بكُم وَلي",31,"ل",2,0],["ولو السحائبُ أُخبرت بكَ اقبلت","واتاكَ منها بالثناءِ مطيرُها",32,"ر",3,0],["وَلَوْ أَلْقَيْتُ سِرِّي فَوْقَ مَيْتٍ","لَقَامَ بِقُدْرَةِ الْمَوْلَى سَعَى لِي",33,"ل",2,0],["وَلَوْ أَلْقَيْتُ سِرِّي فِي جِبَالٍ","لَدُكْتُ وَاختَفَتْ بَيْنَ الرِّمَالِ",33,"ل",1,0],["وَلَوْ أَلقْيتُ سِرِّي فِي بِحَارٍ","لَصَارَ الْكُلُّ غَوْراً فِي الزَّوَالِ",33,"ل",1,0],["ولو الفرج فلا بأس وقد","عابه قومٌ عليه ورعا",34,"ع",2,0],["وَلَو الزَمان جَرى بفهمك أَولاً","ما جئت إِلّا آخر الفهماء",35,"ا",2,0],["وَلوِ آلْمَعِالِي صُوِّرَتْ وتجسَّدْت","لأتاك مَحْضُ الودّ من إقباله",36,"ل",2,0],["ولو المراونةُ أهْتَدَوا لتَأَخَّرُوا","عمّا يحقّ لكم بغير جدال",37,"ل",1,0],["ولو ألحقتناهم وفينا بلولة","وفيهن واليوم العبوري شامس",38,"س",1,1],["ولو السحاب الواكفات كَكَفَّهِ","لم يَشكُ من مَحلِ الزمانِ صعيد",39,"د",1,1],["ولوالديه وللشيوخ شيوخه","ولمن يجب فجد عليه بتوبتي",40,"ي",1,0],["ولو الهلال سوارها وحجالها","القوس والإكليل بعد غطاء",41,"ا",2,0],["ولوِ الوَجْهُ مِنكِ أُطْلِعَ لَيْلاً","لاتّخَذْناهُ هادياً ودَليلا",42,"ل",2,0],["وَلَو الى السَند اضحى وهوَ يَزمَعُه","لِمَ التَجَشُّمُ وَالاِيّام باخِلَةٌ",43,"ه",1,0],["ولو الدهر لابن أحمد ابدى","في الوغى صفحة لكان الفقيدا",44,"د",2,0],["ولَوِ الثُرَيَّا جاوَرَتهم ساعةً","لَغَشِي محاسنَها لذاك شَنارُ",45,"ر",1,0],["ولو ألقى الضياء على جدار","له ظلاً لأوشك أن يميلا",46,"ل",2,0],["ولو الكفاءة في الإمارة روعيت","لم تلف قط عليه من متأمر",47,"ر",1,0],["وَلَوِ الزَّهرُ فِي الأفانِينِ مُبدِي","شَنَبٍ كَانَ للثَّنَايَا كَفاءُ",48,"ا",2,0],["ولو إليه كلهم قد رفعا","طريقَه ونورها قد سطعا",49,"ع",2,0],["وَلَّوا لَدى الأَراغِسِ الفِرارا","وَخَلفَهُم أَتريذُ بَأساً ثارا",50,"ر",2,0],["ولو ألفُ بانٍ تحتهم هادمٌ كفى","فكيف وبانٍ تحتَهُ ألفُ هادمِ",51,"م",1,0],["ولو الجبال يهزها ليهدها","عادت أعاليها وهن أسافل",52,"ل",1,0],["ولو الغي شعوري مابقى لي صاحب ولا خلان","يرافقني على مر الزمن جرحي ودمعاتي",53,"ت",2,0],["ولو الهوى مافيه نسيان وجحود","ماباح من زود الغلا قو سدي",54,"د",2,0],["ولو النباات يطّلعه دمعة هيام؟","شفتوا على وجهي ورود وبساتين",55,"ن",1,0],["ولو المح طرف ثوبه تلاقي الشوق مني يْفوح","يشمّه من قرا شعري ويعرف وش بوجداني",56,"ن",2,0],["ولو المخابر بالمظاهر رهينه","كبد السماء زامت بخذلان الانجاس",57,"س",1,0],["ولو الاماني صدقها دفن الاوهام","ما كان منهو طق باب ٍ يخون",58,"ن",1,0],["ولو الحظ رجال صرعته بيميني","من كثر ما عانيت من نحسته لي",59,"ي",1,0],["ولو الشعر منهاج هجر المزايين","وما بعثرت سود الليالي الخوالي",60,"ل",2,0],["ولو الجسد يآنآس بالارض مدفون","نآيف بقا عآيش بروس النوآيف",61,"ف",1,0],["ولو الجبالُ تجرَّعَت","أهوالَنا لَتشقَّقَت",62,"ت",1,0],["ولو الجروح تجاوب اللي سألها","ماعشت بين الدم والدمع محتار",63,"ر",1,0],["وَلِوَالِدَيَّ فَأَنْتَ أَرْحَمُ شَافِعٍ","إِنْ هَالَنَا يَوْمَ القِيَامَةِ مَوْقِفُ",64,"ف",1,0],["وَلِوَالِدَيَّ وَإِخْوَتِي وَصَحَابَتِي","وَلأُمَّةٍ مَاتَتْ عَلَىٰ التَّوْحِيدِ",65,"د",1,0],["وَلِوَالِدَيَّ اغْفِرْ فِإِنِّي وَارِثٌ","مِنْ طِيبِ ذَاتِهِمَا مَوَارِيثَ الوِلَا",66,"ل",2,0],["وَلِوَالِدَيَّ فِإنَّ لِي سَبَبًا بِهِ","أَرْجُو الَّذِي أَبْغِي رَجَاءَ مُقَصِّرِ",67,"ر",1,0],["ولو المطر منكم منعتم صبوبه","لا شك رزق الخلق من عند وهاب",68,"ب",1,0],["ولوِ النّسْرُ وطّن السفْحَ يَوْمًا","حمَّلتْه الأيَّامُ عبئًا ثقيل",69,"ل",1,0],["ولو البشرتطلب فناه ومضرته","فلا ضرته لو تجمع الكيد قاطبه",70,"ب",2,0],["ولو السلامه باالخلا له تلقيت","وأطلب نجاتي لوسكنت الكهوفي",71,"ف",2,0],["ولو الحزن يمّي .. بشوقي .. نحرته","وريّحت خلق الله .. مِنْ شَرْ.. بلاويه",72,"ي",2,0],["ولو القى العدو جبال. نار","لما. رجفوا ولا اختلج الوريد",73,"د",1,0],["ولو الصدر بالحضن ضمك ويحويك","ليهون مابالكون لعيون سلطان",74,"ن",1,0],["ولو المحبه مابنيتي لها ساس.","اعتق خفوقي من جهنم هجيرك",75,"ك",1,0],["ولو المدينة وجهكم ودعوني","أنا في هواي وعزلتي وجنوني",76,"ن",2,1],["ولو ألفيتني في بحر عشق","لقلت بحارهم تهوى الجبالا",77,"ل",2,0],["ولو السعيد تمّر به صابه جنان","ينسى القنص واللي على الريم يرمون",78,"ن",1,0],["ولو المحبة دايم ختامها مسك","ما كانت الورده يجي حولها اشواك",79,"ك",1,0],["ولو الزمن في لحظة يبل ريقي","ما صارت سنيني على قلبي اغلال",80,"ل",1,0],["ولوالديه اغفر وسامح أهلَهُ","ورفاقَهُ وأحبَّةً شُعراءَ",81,"ا",2,0],["ولوالهدف إنه .! تمتع مع الزين","اللي سلب عقلي ، بجد وجدارة",82,"ر",2,0]]}