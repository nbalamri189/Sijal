.net/poem12626.html","المتقارب"],[438,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[440,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[440,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[442,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[444,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[444,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[450,"لم تغن عن هفوات النفس آداب","https://www.aldiwan.net/poem980.html",""],[453,"هذي الرياض وهذه","https://www.aldiwan.net/poem13731.html","مجزوء الكامل"],[453,"يا مؤثرا للهو طيب النعمه","https://www.aldiwan.net/poem13927.html","الكامل"],[459,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[459,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[459,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[459,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[462,"دلفت بجيش ذي زهاء كأنه","https://www.aldiwan.net/poem15308.html","الطويل"],[462,"هذا الغدير وحوله من عزه","https://www.aldiwan.net/poem15434.html","الكامل"],[462,"تمنى مقامي من تميم كليبها","https://www.aldiwan.net/poem15669.html","الطويل"],[462,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[462,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[462,"يا راكبا يقطع الفيافي","https://www.aldiwan.net/poem16141.html","مخلع البسيط"],[465,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[465,"قم نديمي فاسفك دم الزق","https://www.aldiwan.net/poem3306.html","عموديه"],[465,"ورياضِ محنية دفنت بها الأسى","https://www.aldiwan.net/poem3382.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[469,"يا أنظف العالم في الغسل","https://www.aldiwan.net/poem59722.html","السريع"],[469,"قد أوقد الزهر مصابيحه","https://www.aldiwan.net/poem59958.html","السريع"],[469,"يا من سجيته الندى","https://www.aldiwan.net/poem60214.html","مجزوء الكامل"],[469,"ليلتنا ليلة لها نسب","https://www.aldiwan.net/poem60446.html","المنسرح"],[478,"حمام بأعلى الجلهتين ينوح","https://www.aldiwan.net/poem15261.html","الطويل"],[478,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[478,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[480,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[480,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[483,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[496,"قسماً لا زعزع الشيب","https://www.aldiwan.net/poem10237.html","مجزوء الرمل"],[506,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[514,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[514,"زعمت بنفسي أنت أنك مغرم","https://www.aldiwan.net/poem67793.html","الطويل"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[516,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[516,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[539,"وحقك يا منيتي ما أحب","https://www.aldiwan.net/poem48284.html","عموديه"],[552,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[552,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[552,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[554,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[559,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[563,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[568,"رأيت الرياسة مقرونة","https://www.aldiwan.net/poem69475.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["فَأَغُضُّ مِن جَزَعي وَأَم","حو الدَمعَ مِن بَينِ المَآقي",0,"ق",2,0],["فَأَغفَلتَهُ ثُمَّ اِنتَضَيتَ عَزيمَةً","نَزَعتَ بِها مِن قَلبِهِ حُمَّةَ الحِقدِ",1,"د",1,0],["فَأَغمَدَها في اِحمِرارِ الشَقي","قِ وَجَرَّدَها في بَياضِ الأَقاحِ",2,"ح",1,0],["فَاِغتالَني سَقَمي الَّذي في باطِني","أَخفَيتُهُ فَأَذاعَهُ الإِخفاءُ",3,"ا",2,0],["فأَغْصَانُهُ مُلْتَفَّةٌ مِنْ رِمَاحِهِ","وَأَوْرَاقُهُ مُخْضَرَّةٌ مِنْ نِصَالِهِ",4,"ل",2,0],["فأغْرى بها كفَّ الغِلابِ فأصْبَحَتْ","ذَلولاً ولمْ تسْطِعْ لإمرَتِهِ رَدّا",5,"د",2,0],["فَاِغتَرَّها فَشَآها وَهِيَ غافِلَةٌ","حَتّى رَأَتهُ وَقَد أَوفى لَها شَرَفا",6,"ف",2,0],["فَأَغارَت وَأَوجُهُ القَومِ بيضٌ","ثُمَّ غارَت وَقَد كَسَتهُنَّ قارا",7,"ر",2,0],["فَأَغفى قَليلاً ثُمَّ طارَ بِرَحلِها","لِيَكسَبَ مَجداً أَو يَحورَ لَها نَهبُ",8,"ب",1,0],["فاغفروا لي ذنبي فقد زاد منكم","نصرائي من زاد فيهم عيالي",9,"ل",2,0],["فأغلى لؤلؤ البحر","فدى لؤلؤة الدار",10,"ر",1,0],["فاغمد سُيوفك إن العفو منصلت","واهنأ بشعب محبّ غير مُنحاز",11,"ز",1,0],["فاغفر عليك سلام الله ما طلعت","شمس وما ضاء بدر الليل أولالا",12,"ل",2,0],["فاغرة الأفواه للأطيار","طالبة لهنَّ بالأوتار",13,"ر",1,0],["فاغتنم خُطةً منحتُكَ منها","مَحْمِلاً هيِّناً وحمداً رغيبا",14,"ب",2,0],["فاغدُ في أمنٍ من الرقِّ ومن","سطوة الدهر وذل الإضطهادِ",15,"د",1,0],["فأغثني أغاثك الله إني","في يد الدهر مطلقٌ مأسورُ",16,"ر",1,0],["فاغضبْ على الأشياء أو خلِّها","بحيث أجرتْها مقاديرها",17,"ر",3,0],["فَأَغْضِ على إقذاء عينك صاغراً","فجَدُّك أدنى للسّفال وأصغر",18,"ر",1,0],["فاغضبْ على عِرسِكَ التي تركتْ","عِرضكَ عَهْناً لكلِّ نفّاش",19,"ش",1,0],["فاغرٌ في جماجم القوم أفوا","هَ جمالٍ أَوَارِكٍ أو غواضي",20,"ض",2,0],["فاغسلوا العار الذي ليط بكم","بدم الخلال غسلاً في لَطف",21,"ف",1,0],["فاغفُلْ فما زِلتَ في الإقالةِ وال","صفحِ غريراً في الرأي مُحتَنِكا",22,"ك",2,0],["فأغمدِ السيفَ عنك وانْتَضهِ","لمن يعاديك يلحقوا إرما",23,"م",2,0],["فاغدُ عني وانظر لنفسك دوني","ليس يُجزَى سواي عما أَدين",24,"ن",1,0],["فَأَغمَدَ في صَدرِهِ مُديَةً","أَشَدُّ مَضاءً مِنَ الباتِرِ",25,"ر",1,0],["فَاِغرُب شُقيتَ الدَهرِ غَيرَ مُوَدِّعٍ","مِنَ القَومِ إِلا بِالظُبى وَالصَوارِمِ",26,"م",1,0],["فَأَغلَقَ اللَهُ باباً","مِنهُ دَخَلتُ إِلَيكُم",27,"م",1,0],["فأَغفى على صدرِهِ المطمَئِنِّ","وفي روحِهِ حُلُمٌ مُسْتَكينْ",28,"ن",1,0],["فاغضُضِ الطَّرفَ في الظَّلامِ وحاذِرْ","فتنَةَ النُّورِ فهيَ رُؤْيا مَهُولهْ",29,"ه",1,0],["فأغمضت أمه قليلا","ثم أرعوت تنظر السماء",30,"ا",2,0],["فَاِغتَرَفَ العُصفورُ مِن إِحسانِهِ","وَحَرَّكَ الصَنيعُ مِن لِسانِهِ",31,"ه",1,0],["فاغْتَرَّهُ السّيْفُ وهو خادِمُهُ","مَتَى يُهِبْ في الوَغَى بهِ يُجِبِ",32,"ب",1,0],["فَأَغزو مَن غَزا وَبِهِ اِقتِداري","وَأَرمي مَن رَمى وَبِهِ أُصيبُ",33,"ب",1,0],["فَاِغتَبَطَت إِذ رَأَت تَزَيُّنَها","بِمِثلِهِ وَالجِراحُ تَحسُدُها",34,"د",3,0],["فَاِغتَظ بِقَومٍ وَهشوذَ ما خُلِقوا","إِلّا لِغَيظِ العَدوِّ وَالحاسِد",35,"د",1,0],["فَاِغفِر فِدىً لَكَ وَاِحبُني مِن بَعدِها","لِتَخُصَّني بِعَطِيَّةٍ مِنها أَنا",36,"ن",2,0],["فَاِغتَنِم فُرصَةَ الزَمانِ فَما يَد","ري مُطيقٌ لَها مَتى لا يُطيقُ",37,"ق",1,0],["فَأَغِثني بِما بِهِ يُشتَرى دُن","نُ عَجوزٍ خَمّارُهُ مُشتَريهِ",38,"ي",2,0],["فَأَغلَقَ مِن وَراءِ بَني كُلَيبٍ","عَطِيَّةُ مِن مَخازي اللُؤمِ بابا",39,"ب",2,1],["فَأَغضِ بِشُفرَيكَ الذَليلَينِ وَاِجتَدِح","شَرابَكَ ذا الغَيلِ الَّذي كُنتَ تَجدَحُ",40,"ح",1,0],["فَأَغنوا سَفيهَ القَومِ لا يَغرُرَنَّكُم","كَما غُرَّ مِن لَم تُغنِ عَنهُ تَمائِمُه",41,"م",2,0],["فأغراضُك اللاتي تُصابُ مَقاتِلٌ","وأسهُمُك اللاتي تُصيبُ حِمامُ",42,"م",1,0],["فأغنيتَني بالجُودِ عن كلِّ مُمْسِكٍ","أكافِحُه عن جُودِهِ وأُقارِعُه",43,"ع",2,0],["فَاغْدُ سِرّاً بنا إلى قَفَصِ الملْ","حيِّ فالعيشُ فيه غَضٌّ نَضيرُ",44,"ر",1,0],["فَاغفِر ذُنوبي إِنَّها جَمَّةٌ","وَاستُر خَطائي إِنَّكَ الساتِرُ",45,"ر",1,0],["فَاغفِر ذُنوبي يا رَحي","مُ فَأَنتَ سَتّارُ العُيوبِ",46,"ب",1,0],["فَأَغضَبَنا وَإِن أَرضى البَرايا","وَأَظمَأنا وَإِن رَوّى البِلادا",47,"د",2,0],["فَأَغصانٌ مِنَ النَسَماتِ تُثنى","وَأَزهارٌ عَلى الأَنواءِ تَثني",48,"ن",2,0],["فَاِغنَم وَفى مَوعِدِ اللَيالي","مِن قَبلِ أَن تُحدِثَ اِنتِكاثا",49,"ث",2,0],["فَاِغتَنِمِ العَيشَ وَلا","تَرُدَّ مِنهُ ما وَرَد",50,"د",1,0],["فَاِغتَنِم ساعَةَ اللِقاءِ فَما تَع","لَمُ نَفسٌ بِأَيِّ أَرضٍ تَموتُ",51,"ت",1,0],["فَاِغزُ العِدى بِعَزمَةٍ مِن شَأنِها","إِتيانُ حَزمِ الرَأيِ مِن أَبوابِهِ",52,"ب",2,0],["فَأَغضَبتُهُ أَن قُلتُ يا أَحسَنَ الوَرى","وَكادَ بِأَن يُفضي إِلى الشَتمِ وَاللَعنِ",53,"ن",1,0],["فَاِغنِ بِالنِعمَةِ الَّتي هِيَ كَالحَو","راءِ لا فارِكٍ وَلا بِعَلوقِ",54,"ق",1,0],["فأغمدْ سيفَ لحظِك فهْوَ ماضٍ","فما يُبقي عليَّ ولا يقيني",55,"ن",2,0],["فأغنتني بملقاها","وألقتني بمغناها",56,"ا",3,0],["فَأَغضَيتُ إِغضاءَ الكَريمِ لِفِتيَةٍ","كِرامِ الحُلى وَالمُنتَمى وَالأَواصِرِ",57,"ر",1,0],["فَأغرَاهُ مَا أثنَى عَلَيكَ شَقِيقُهُ","فَجَاءَكَ لَم تَبعُد عَلَيهِ المَرَاحِلُ",58,"ل",1,0],["فأَغِثْنَا يَا مَنْ هُوَ الغَوثُ والغَيْ","ثُ إذا أَجْهَدَ الورَى اللّأْوَاءُ",59,"ا",2,0],["فاغتالهُ كي يحوزَ نعجتَهُ","ولانَ للحبِّ عند مُقتَلبِه",60,"ل",3,0],["فَاِغتالَ ذَلِكُمُ وَغَيَّرَهُ","عَصرٌ تَناسَخَها إِلى عَصرِ",61,"ر",1,0],["فَاِغفِر ذُنوباً لِتُجزى بَعدَ مَغفِرَةٍ","وَاِعذُر لِتُصبِحَ بَينَ الناسِ مَعذورا",62,"ر",2,0],["فَاِغدُ كَاللُؤلُؤِ الَّذي بِاِسمِهِ","أَغناكَ عَن نِسبَةٍ إلى خيدازِ",63,"ز",1,0],["فَأَغاثَت بِوِردِها مودَعاتٍ","في هُجولٍ تَقُلُّ فيها الصَلاصِل",64,"ل",1,0],["فاغْتَبَقْنا بيْضَاءَ كالفِضّةِ المَحْ","ضِ وعِفْنا حَمْراءَ كالأرْجُوانِ",65,"ن",1,0],["فاغتظ بقومٍ وهسوذ ما خلقوا","إلا لغيظ العدوّ والحاسد",66,"د",1,0],["فاغفر لما صنع الزمان فإنها","بؤسى تمرُّ على الشعوبِ وأنعُمُ",67,"م",1,0],["فاغرورقتْ بدموعِ الوجدِ أعيننا","وأشفَقَتْ من وجيب القلب أحناءُ",68,"ا",2,0],["فأَغْشَى دِيارَ الذَّاكِرينَ وإِن نَأَتْ","أَجارِع مِن دارِي هَوىً لهَواها",69,"ا",3,0],["فَأَغْرَمْتُهُ قُبْلَةً","عَفَا اللَّهُ عَمَّا سَلَفْ",70,"ف",1,0],["فَاغْتَفِرْهَا زَلَّةً مِنْ خَاطِئٍ","لَمْ يَكُنْ بِاللهِ يَوْمَاً أَشْرَكَا",71,"ك",2,0],["فاغْنَمْ حياتَكَ بِالشَّبَابِ مُجَدِّداً","والْعَيْشُ أَرْغدُ ما عَهِدْتَ وَأَنْضَرَا",72,"ر",2,0],["فأغوص في الأبدية ال","خرساء والأزل القطوب",73,"ب",1,0],["فاغتَنِمِ العَيشَ الذي من حَقِّه","إذا صَفَتْ أيامُه أن يُغتَنَمْ",74,"م",1,0],["فاغرس اصول التقى ما دمت مقتدرا","واعلم بانك بعد الموت لاقيها",75,"ي",3,0],["فأَغِثْنِي بما بهِ يُشْترَى دَنُّ","عَجُوزٍ خَمَّارُهُ مُشْتَرِيهِ",76,"ي",2,0],["فَاغمُرْ جَوَانِبَهَا بِجَدٍّ صَاعِدٍ،","وَالبَسْ بَشَاشَتَها بِحَظٍّ مُقبِلِ",77,"ل",1,0],["فاغدي على الرمل وروحي يضع","ورد ويفرش طيبه أقحوان",78,"ن",1,0],["فَاِغتَدى مَدحُهُ الغَني عَن المَد","ح بِشُكر مُعَطر الأَذيال",79,"ل",1,0],["فاغدو قرير العين من بعد لوعتي","وفجر عنائي بالمنى يتفجر",80,"ر",1,0],["فأغثه بسر قدسك يا من","أرشد العالمون من أنذارك",81,"ك",1,0],["فأغثني وارحم بفضلك فقري","وتحنن قد ذبت مما أعارك",81,"ك",1,0],["فاغتنم ذاك اللسان فإن ال","ملك للألسن الفصاح الكلام",82,"م",1,0],["فاغسلْ يديك من الزما","نِ وأهلِه متفردَا",83,"د",2,0],["فاغتنم إن كنت متجراً","خَلَساً من راحة المحن",84,"ن",1,0],["فَاغْفِرْ لِعَبْدِكَ يا مَوْلايَ زَلَّتَهُ","أَوْ لاَ فَحُكْمُكَ فِينا غَيْرُ مُحْتَكِمِ",85,"م",1,0],["فاغمد سيوفك رغبةً لا رهبةً","ما في قتيل فرّ مرعوباً سمن",86,"ن",1,0],["فأغمدت وهي من غيظ ومن حنق","عليهم في حشا أغمادها ثَغرُ",87,"ر",1,0],["فأغضيت عنهم والمهيمن ساخط","فلم يلهموا إلا الغواية والجهلا",88,"ل",2,0],["فأغل الماءَ جهدكَ ثم دعهُ","يبيتُ به على الأحشاء بردُ",89,"د",1,0],["فاغضضْ إذا أقبلنَ طرفك إِنه","غضُّ وطرفُ السانحات غضيضُ",90,"ض",1,0],["فاغضب لربك وانتقم لحدوده","ممن يضيم الدين كل مضام",91,"م",1,0],["فَأَغمَضتُ جَفناً وَالقَذى مِلءُ ناظِري","وَأَبدَيتُ سلماً لَيسَ تخشى دَغائِلُه",92,"ل",2,0],["فاغْنَمْ بنا مُلَح الزمانِ مُبادِرا","وتَملَّ منها حَظَّ من لم يُبْخَس",93,"س",1,0]