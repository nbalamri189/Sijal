{"poems":[[53,"أترى نراح من الفراق","https://www.aldiwan.net/poem29923.html","مجزوء الكامل"],[53,"سلا ظاهر الأنفاس عن باطن الوجد","https://www.aldiwan.net/poem30601.html","الطويل"],[53,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[3,"رمت الفؤاد مليحة عذراء","https://www.aldiwan.net/poem121.html",""],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[24,"بان الشباب وأمسى الشيب قد أزفا","https://www.aldiwan.net/poem21869.html","البسيط"],[86,"سائلوا الليل عنهم والنهارا","https://www.aldiwan.net/poem10926.html","الخفيف"],[10,"وخرق كأنضاء القميص دوية","https://www.aldiwan.net/poem20946.html","الطويل"],[93,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[93,"إذا ما انفرط العقد","https://www.aldiwan.net/poem11073.html","الهزج"],[88,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"ياسمي الخليل إياك أدعو","https://www.aldiwan.net/poem8332.html","الخفيف"],[51,"ما على الأحرار من رق إذا","https://www.aldiwan.net/poem61880.html","الرمل"],[51,"يا غيورا أن يهتك المستور","https://www.aldiwan.net/poem62847.html","الخفيف"],[51,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[51,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"يا ابن حسان لا تشكن في دينى","https://www.aldiwan.net/poem66483.html","الخفيف"],[91,"تأمل في أمسه الدابر","https://www.aldiwan.net/poem8837.html","عموديه"],[91,"إلى حيث ألقت يا زمان المظالم","https://www.aldiwan.net/poem62715.html","عموديه"],[70,"لكتموني رخيصا","https://www.aldiwan.net/poem42390.html","المجتث"],[92,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[85,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[43,"أيدري ما أرابك من يريب","https://www.aldiwan.net/poem9458.html","الوافر"],[43,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[43,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[43,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[45,"بيننا حرمة وعهد وثيق","https://www.aldiwan.net/poem65195.html","الخفيف"],[45,"يا ابن من طاب في المواليد حرا","https://www.aldiwan.net/poem66862.html","الخفيف"],[28,"فأغلق من وراء بني كليب","https://www.aldiwan.net/poem4952.html","الوافر"],[28,"تكاثر يربوع عليك ومالك","https://www.aldiwan.net/poem4981.html","الطويل"],[28,"بني جارم إن الصغير بقدره","https://www.aldiwan.net/poem5579.html","الطويل"],[61,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[61,"عذلت وهل عذل المتيم نافعه","https://www.aldiwan.net/poem51566.html","الطويل"],[61,"أربعاء حسامه مشهور","https://www.aldiwan.net/poem51674.html","الخفيف"],[49,"كل حياة فلها مدة","https://www.aldiwan.net/poem62109.html","السريع"],[49,"والله لا أرجو سوا","https://www.aldiwan.net/poem64121.html","مجزوء الكامل"],[66,"فأفرط في ترادفه وزادا","https://www.aldiwan.net/poem38682.html","الوافر"],[66,"وجنح دجنة فيه اغتبقنا","https://www.aldiwan.net/poem38806.html","الوافر"],[66,"يا من غدا للأنام غيثا","https://www.aldiwan.net/poem39069.html","مجزوء البسيط"],[66,"يا مالك العصر ومن","https://www.aldiwan.net/poem39071.html","مجزوء الرجز"],[66,"ليس كل الأوقات يجتمع الشم","https://www.aldiwan.net/poem40304.html","الخفيف"],[66,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[44,"ومحتكم في الخمص طورا وفي البدن","https://www.aldiwan.net/poem30095.html","الطويل"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[69,"أراني الله وجهك كل حين","https://www.aldiwan.net/poem28575.html","الوافر"],[69,"ورب غزالة طلعت","https://www.aldiwan.net/poem28746.html","مجزوء الوافر"],[74,"لك الخير أي الخير في رد صاحب","https://www.aldiwan.net/poem12963.html","الطويل"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"وشاعر ما يفيق من خطله","https://www.aldiwan.net/poem66556.html","المنسرح"],[50,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[46,"كم يسر الأمر لم تأمل تيسره","https://www.aldiwan.net/poem22627.html","البسيط"],[46,"فارسا كان رب فارس كسرى","https://www.aldiwan.net/poem22775.html","الخفيف"],[46,"عجبا للقطا من الكدر والجو","https://www.aldiwan.net/poem23274.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141038",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30504","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42722","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[58,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""],[45,"يا بْنَ مَنْ طَابَ في المَوَالِيدِ حُرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=31683",""],[45,"جُمِعَتْ أُمُورُ الدّينِ بَعدَ تَزَيُّلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31869",""]],"verses":[["فَأَغُضُّ مِن جَزَعي وَأَم","حو الدَمعَ مِن بَينِ المَآقي",0,"ي",1,0],["فَأَغفَلتَهُ ثُمَّ اِنتَضَيتَ عَزيمَةً","نَزَعتَ بِها مِن قَلبِهِ حُمَّةَ الحِقدِ",1,"د",1,0],["فَأَغمَدَها في اِحمِرارِ الشَقي","قِ وَجَرَّدَها في بَياضِ الأَقاحِ",2,"ح",1,0],["فَاِغتالَني سَقَمي الَّذي في باطِني","أَخفَيتُهُ فَأَذاعَهُ الإِخفاءُ",3,"ا",2,0],["فأَغْصَانُهُ مُلْتَفَّةٌ مِنْ رِمَاحِهِ","وَأَوْرَاقُهُ مُخْضَرَّةٌ مِنْ نِصَالِهِ",4,"ل",2,0],["فأغْرى بها كفَّ الغِلابِ فأصْبَحَتْ","ذَلولاً ولمْ تسْطِعْ لإمرَتِهِ رَدّا",5,"د",2,0],["فَاِغتَرَّها فَشَآها وَهِيَ غافِلَةٌ","حَتّى رَأَتهُ وَقَد أَوفى لَها شَرَفا",6,"ف",2,0],["فَأَغارَت وَأَوجُهُ القَومِ بيضٌ","ثُمَّ غارَت وَقَد كَسَتهُنَّ قارا",7,"ر",2,0],["فَأَغفى قَليلاً ثُمَّ طارَ بِرَحلِها","لِيَكسَبَ مَجداً أَو يَحورَ لَها نَهبُ",8,"ب",1,0],["فاغفروا لي ذنبي فقد زاد منكم","نصرائي من زاد فيهم عيالي",9,"ي",1,0],["فأغلى لؤلؤ البحر","فدى لؤلؤة الدار",10,"ر",1,0],["فاغمد سُيوفك إن العفو منصلت","واهنأ بشعب محبّ غير مُنحاز",11,"ز",1,0],["فاغفر عليك سلام الله ما طلعت","شمس وما ضاء بدر الليل أولالا",12,"ل",2,0],["فاغرة الأفواه للأطيار","طالبة لهنَّ بالأوتار",13,"ر",1,0],["فاغتنم خُطةً منحتُكَ منها","مَحْمِلاً هيِّناً وحمداً رغيبا",14,"ب",2,0],["فاغدُ في أمنٍ من الرقِّ ومن","سطوة الدهر وذل الإضطهادِ",15,"د",1,0],["فأغثني أغاثك الله إني","في يد الدهر مطلقٌ مأسورُ",16,"ر",1,0],["فاغضبْ على الأشياء أو خلِّها","بحيث أجرتْها مقاديرها",17,"ر",3,0],["فَأَغْضِ على إقذاء عينك صاغراً","فجَدُّك أدنى للسّفال وأصغر",18,"ر",1,0],["فاغضبْ على عِرسِكَ التي تركتْ","عِرضكَ عَهْناً لكلِّ نفّاش",19,"ش",1,0],["فاغرٌ في جماجم القوم أفوا","هَ جمالٍ أَوَارِكٍ أو غواضي",20,"ض",2,0],["فاغسلوا العار الذي ليط بكم","بدم الخلال غسلاً في لَطف",21,"ف",1,0],["فاغفُلْ فما زِلتَ في الإقالةِ وال","صفحِ غريراً في الرأي مُحتَنِكا",22,"ك",2,0],["فأغمدِ السيفَ عنك وانْتَضهِ","لمن يعاديك يلحقوا إرما",23,"م",2,0],["فاغدُ عني وانظر لنفسك دوني","ليس يُجزَى سواي عما أَدين",24,"ن",1,0],["فَأَغمَدَ في صَدرِهِ مُديَةً","أَشَدُّ مَضاءً مِنَ الباتِرِ",25,"ر",1,0],["فَاِغرُب شُقيتَ الدَهرِ غَيرَ مُوَدِّعٍ","مِنَ القَومِ إِلا بِالظُبى وَالصَوارِمِ",26,"م",1,0],["فَأَغلَقَ اللَهُ باباً","مِنهُ دَخَلتُ إِلَيكُم",27,"م",1,0],["فأَغفى على صدرِهِ المطمَئِنِّ","وفي روحِهِ حُلُمٌ مُسْتَكينْ",28,"ن",1,0],["فاغضُضِ الطَّرفَ في الظَّلامِ وحاذِرْ","فتنَةَ النُّورِ فهيَ رُؤْيا مَهُولهْ",29,"ه",1,0],["فأغمضت أمه قليلا","ثم أرعوت تنظر السماء",30,"ا",2,0],["فَاِغتَرَفَ العُصفورُ مِن إِحسانِهِ","وَحَرَّكَ الصَنيعُ مِن لِسانِهِ",31,"ه",1,0],["فاغْتَرَّهُ السّيْفُ وهو خادِمُهُ","مَتَى يُهِبْ في الوَغَى بهِ يُجِبِ",32,"ب",1,0],["فَأَغزو مَن غَزا وَبِهِ اِقتِداري","وَأَرمي مَن رَمى وَبِهِ أُصيبُ",33,"ب",1,0],["فَاِغتَبَطَت إِذ رَأَت تَزَيُّنَها","بِمِثلِهِ وَالجِراحُ تَحسُدُها",34,"د",3,0],["فَاِغتَظ بِقَومٍ وَهشوذَ ما خُلِقوا","إِلّا لِغَيظِ العَدوِّ وَالحاسِد",35,"د",1,0],["فَاِغفِر فِدىً لَكَ وَاِحبُني مِن بَعدِها","لِتَخُصَّني بِعَطِيَّةٍ مِنها أَنا",36,"ن",2,0],["فَاِغتَنِم فُرصَةَ الزَمانِ فَما يَد","ري مُطيقٌ لَها مَتى لا يُطيقُ",37,"ق",1,0],["فَأَغِثني بِما بِهِ يُشتَرى دُن","نُ عَجوزٍ خَمّارُهُ مُشتَريهِ",38,"ي",2,0],["فَأَغلَقَ مِن وَراءِ بَني كُلَيبٍ","عَطِيَّةُ مِن مَخازي اللُؤمِ بابا",39,"ب",2,1],["فَأَغضِ بِشُفرَيكَ الذَليلَينِ وَاِجتَدِح","شَرابَكَ ذا الغَيلِ الَّذي كُنتَ تَجدَحُ",40,"ح",1,0],["فَأَغنوا سَفيهَ القَومِ لا يَغرُرَنَّكُم","كَما غُرَّ مِن لَم تُغنِ عَنهُ تَمائِمُه",41,"م",2,0],["فأغراضُك اللاتي تُصابُ مَقاتِلٌ","وأسهُمُك اللاتي تُصيبُ حِمامُ",42,"م",1,0],["فأغنيتَني بالجُودِ عن كلِّ مُمْسِكٍ","أكافِحُه عن جُودِهِ وأُقارِعُه",43,"ع",2,0],["فَاغْدُ سِرّاً بنا إلى قَفَصِ الملْ","حيِّ فالعيشُ فيه غَضٌّ نَضيرُ",44,"ر",1,0],["فَاغفِر ذُنوبي إِنَّها جَمَّةٌ","وَاستُر خَطائي إِنَّكَ الساتِرُ",45,"ر",1,0],["فَاغفِر ذُنوبي يا رَحي","مُ فَأَنتَ سَتّارُ العُيوبِ",46,"ب",1,0],["فَأَغضَبَنا وَإِن أَرضى البَرايا","وَأَظمَأنا وَإِن رَوّى البِلادا",47,"د",2,0],["فَأَغصانٌ مِنَ النَسَماتِ تُثنى","وَأَزهارٌ عَلى الأَنواءِ تَثني",48,"ن",2,0],["فَاِغنَم وَفى مَوعِدِ اللَيالي","مِن قَبلِ أَن تُحدِثَ اِنتِكاثا",49,"ث",2,0],["فَاِغتَنِمِ العَيشَ وَلا","تَرُدَّ مِنهُ ما وَرَد",50,"د",1,0],["فَاِغتَنِم ساعَةَ اللِقاءِ فَما تَع","لَمُ نَفسٌ بِأَيِّ أَرضٍ تَموتُ",51,"ت",1,0],["فَاِغزُ العِدى بِعَزمَةٍ مِن شَأنِها","إِتيانُ حَزمِ الرَأيِ مِن أَبوابِهِ",52,"ب",2,0],["فَأَغضَبتُهُ أَن قُلتُ يا أَحسَنَ الوَرى","وَكادَ بِأَن يُفضي إِلى الشَتمِ وَاللَعنِ",53,"ن",1,0],["فَاِغنِ بِالنِعمَةِ الَّتي هِيَ كَالحَو","راءِ لا فارِكٍ وَلا بِعَلوقِ",54,"ق",1,0],["فأغمدْ سيفَ لحظِك فهْوَ ماضٍ","فما يُبقي عليَّ ولا يقيني",55,"ي",1,0],["فأغنتني بملقاها","وألقتني بمغناها",56,"ا",3,0],["فَأَغضَيتُ إِغضاءَ الكَريمِ لِفِتيَةٍ","كِرامِ الحُلى وَالمُنتَمى وَالأَواصِرِ",57,"ر",1,0],["فَأغرَاهُ مَا أثنَى عَلَيكَ شَقِيقُهُ","فَجَاءَكَ لَم تَبعُد عَلَيهِ المَرَاحِلُ",58,"ل",1,0],["فأَغِثْنَا يَا مَنْ هُوَ الغَوثُ والغَيْ","ثُ إذا أَجْهَدَ الورَى اللّأْوَاءُ",59,"ا",2,0],["فاغتالهُ كي يحوزَ نعجتَهُ","ولانَ للحبِّ عند مُقتَلبِه",60,"ل",3,0],["فَاِغتالَ ذَلِكُمُ وَغَيَّرَهُ","عَصرٌ تَناسَخَها إِلى عَصرِ",61,"ر",1,0],["فَاِغفِر ذُنوباً لِتُجزى بَعدَ مَغفِرَةٍ","وَاِعذُر لِتُصبِحَ بَينَ الناسِ مَعذورا",62,"ر",2,0],["فَاِغدُ كَاللُؤلُؤِ الَّذي بِاِسمِهِ","أَغناكَ عَن نِسبَةٍ إلى خيدازِ",63,"ز",1,0],["فَأَغاثَت بِوِردِها مودَعاتٍ","في هُجولٍ تَقُلُّ فيها الصَلاصِل",64,"ل",1,0],["فاغْتَبَقْنا بيْضَاءَ كالفِضّةِ المَحْ","ضِ وعِفْنا حَمْراءَ كالأرْجُوانِ",65,"ن",1,0],["فاغتظ بقومٍ وهسوذ ما خلقوا","إلا لغيظ العدوّ والحاسد",66,"د",1,0],["فاغفر لما صنع الزمان فإنها","بؤسى تمرُّ على الشعوبِ وأنعُمُ",67,"م",1,0],["فاغرورقتْ بدموعِ الوجدِ أعيننا","وأشفَقَتْ من وجيب القلب أحناءُ",68,"ا",2,0],["فأَغْشَى دِيارَ الذَّاكِرينَ وإِن نَأَتْ","أَجارِع مِن دارِي هَوىً لهَواها",69,"ا",3,0],["فَأَغْرَمْتُهُ قُبْلَةً","عَفَا اللَّهُ عَمَّا سَلَفْ",70,"ف",1,0],["فَاغْتَفِرْهَا زَلَّةً مِنْ خَاطِئٍ","لَمْ يَكُنْ بِاللهِ يَوْمَاً أَشْرَكَا",71,"ك",2,0],["فاغْنَمْ حياتَكَ بِالشَّبَابِ مُجَدِّداً","والْعَيْشُ أَرْغدُ ما عَهِدْتَ وَأَنْضَرَا",72,"ر",2,0],["فأغوص في الأبدية ال","خرساء والأزل القطوب",73,"ب",1,0],["فاغتَنِمِ العَيشَ الذي من حَقِّه","إذا صَفَتْ أيامُه أن يُغتَنَمْ",74,"م",1,0],["فاغرس اصول التقى ما دمت مقتدرا","واعلم بانك بعد الموت لاقيها",75,"ي",3,0],["فأَغِثْنِي بما بهِ يُشْترَى دَنُّ","عَجُوزٍ خَمَّارُهُ مُشْتَرِيهِ",76,"ي",2,0],["فَاغمُرْ جَوَانِبَهَا بِجَدٍّ صَاعِدٍ،","وَالبَسْ بَشَاشَتَها بِحَظٍّ مُقبِلِ",77,"ل",1,0]]}