{"poems":[[107,"يا أيها الشعب الذلول أما كفى","https://www.aldiwan.net/poem43103.html","الكامل"],[33,"أتوصلُ زينبُ، أمْ تهجرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18900&r=&rc=163",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145847","المجتث"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97928","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117858","الطويل"],[5038,"في الحكمة / الصدق3","https://www.poetsgate.com/ViewPoem.aspx?id=190169",""],[5956,"اتّق شرّ من أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=192409",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""]],"verses":[["اللِصُّ يَغضَبُ إِن جَعَلنا ذِكرَهُ","يَوماً بذكر زعيمِهم مقرونا",0,"ن",2,0],["أَلِلْصَّرْمِ تَطَّلِبينَ الذُّنُوبَ","ولم أجنِ ذنباً لكي تغدروا",1,"ر",3,0],["أللصُ صارَ شريفاً","والدِيْنُ دِيْناً مُحَرَّفْ",2,"ف",1,0],["اللص والمسروق منه تقدما","يوما بمحكمة لقاضٍ راشد",3,"د",1,1],["أللصب من سلمى على بخلها به","وقوف على باب الخبا لا يضيرها",4,"ر",3,0],["أَللِّصُّ يُحْسَبُ كَالْكَذّابِ أَخْلاقا","في شِرْعَةِ الْحَقِّ صارَ الْكِذْبُ سَرّاقا",5,"ق",2,1],["اللص يؤذي كلَّ من أسدَى له","خيراً، ولا يُوفي ولا يتراحمُ",6,"م",1,0],["أَلِلصَّهايِنَةِ الأَوغادِ مَوثِقُكُمْ ؟","وَ لِلعُرُوبَةِ أَوهامُ الأَباطِيلِ !",7,"ل",1,0]]}