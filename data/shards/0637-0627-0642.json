{"poems":[[94,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[261,"طاقة آس جنيت منها","https://www.aldiwan.net/poem48350.html","مخلع البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63885","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70726","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102563","الكامل"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142952","الخفيف"],[5277,"حمامةٌ زادُها الكتابُ..","https://www.poetsgate.com/ViewPoem.aspx?id=215560",""],[5431,"تحول الشهوة إلى فن....","https://www.poetsgate.com/ViewPoem.aspx?id=207322",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[5956,"الكون في عينيَّ صِهري مصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=200542",""]],"verses":[["طاقاتِ وردٍ آبدٍ","تُزري بأَورادِ القُصورْ",0,"ر",1,0],["طاقة آسٍ جنيت منها","بلحظتي نرجساً ووردا",1,"د",2,1],["طاقُ أديمٍ طائفيٌّ منَ ال","أنفس في القيمةِ والأنفس",2,"س",1,0],["طاقتْ علينا بها صِرْفاً وقد جعلَتْ","تُديرها بين نُيَّامٍ وجُلاَّسِ",3,"س",1,0],["طاق الهوى المعقول يا أسفي على","عقل زكيّ رادع لهوائي",4,"ي",1,0],["طاقة نغصت علي شبابي","فتعمدت نتفها غير وان",5,"ن",1,1],["طاقُ الجدارِ بصمتها متشبّثٌ","يخشى إذا نطقتْ يفزّ من الهواءْ",6,"ا",2,0],["طاقة الحب عنده ألف ذئبٍ","ضارياتٍ وبدرها في اكتمالِ",7,"ل",1,0],["طاقة المرء عقله إذْ تسامى","يجعل الطين واحة من خيال",7,"ل",1,0],["طاقة الحب منبع الكون منها","قوة الدفع مطلقا ألف حافز",8,"ز",1,0],["طاقة الشحن بالبرودة تخبو","(إنتروبيا) عن ردعها الكون عاجز",8,"ز",1,0],["طاقاتُ إيجابٍ تضمُ قلوبَهم","وزنودُهمْ مخلوقة كي تسعفا..",9,"ف",2,0]]}