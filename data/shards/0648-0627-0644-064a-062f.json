{"poems":[[189,"جام حوى في الظرف كل باب","https://www.aldiwan.net/poem14090.html","الرجز"],[422,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[469,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81237","الخفيف"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116056","الكامل"],[4906,"يهنيكِ يا بلدةَ المختارِ من مُضَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=173613",""]],"verses":[["واليدُ بين السَّيْرِ والإياب","في نَقْلِها للفم كالدُّولابِ",0,"ب",1,0],["واليدُ الطولى له من قبلها","أَخَذَتْ من كلّ آبٍ بزمام",1,"م",1,0],["وإلى ديماسها وهو الدجى","فغدا شمسَ ضحى عمَّ سناها",2,"ا",3,0],["وَاليَدُ العُظمى وَكُلُّ أَيا","دِيكَ يا مَولايَ أَعظَمُها",3,"م",3,0],["وَإِلى دعائك تنصت ال","حسنى لتعرف من دَعا",4,"ع",2,0],["وإلى ديارهم انثنى الأبناء وال","أصهار مع كل الجماهير الأخر",5,"ر",1,0],["وَاليَد الطهر خَضبتها دِماء","مِن صَريع مجندل أَو أَسير",6,"ر",1,0],["وإلى دياركُم نَحِنُّ صَبابةً","وَنَفُضُّ أوعيَةَ الدموعِ ونُرسِلُ",7,"ل",1,0],["والي دمشقٍ وحاميها محمّدُ من","به تباهَتْ أهالي الحجِّ والعُمَر",8,"ر",1,0]]}