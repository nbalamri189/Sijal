{"poems":[[55,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[55,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[57,"غضب الحبيب فهاج لي استعبار","https://www.aldiwan.net/poem26367.html","الكامل"],[74,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[53,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[47,"أترى حمولة لا يحمل نفسه","https://www.aldiwan.net/poem63463.html","الكامل"],[47,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[46,"متطلب بصدوده قتلي","https://www.aldiwan.net/poem30132.html","الكامل"],[76,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12662","الكامل"],[92,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[113,"وفد الربيع فقم لحث الكاس","https://www.aldiwan.net/poem16246.html","الكامل"],[131,"طرقت أسيماء الرحال ودوننا","https://www.aldiwan.net/poem24275.html","الكامل"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[369,"يرمي فؤادي وهو في سودائه","https://www.aldiwan.net/poem58720.html","الكامل"],[369,"وافى كتاب من فتى كرم","https://www.aldiwan.net/poem60659.html","أحذ الكامل"],[369,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[385,"يا من لصب واله","https://www.aldiwan.net/poem49241.html","مجزوء الكامل"],[469,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[505,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[556,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[698,"","https://poetry.dctabudhabi.ae/diwan/poem/146793","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48672","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48670","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120023","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96726","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80236","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49977","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49994","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122094","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77252","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107001","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100924","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79719","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105800","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138713",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45775","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109955","الكامل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140269",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91069","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120386","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[5102,"لا أهلاً ولا سهلا..","https://www.poetsgate.com/ViewPoem.aspx?id=12859",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5409,"صدق الهوى ما كل ود صادق","https://www.poetsgate.com/ViewPoem.aspx?id=155297",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5956,"في قاع نفسي حبكم مرصودُ","https://www.poetsgate.com/ViewPoem.aspx?id=194626",""],[5956,"سحُبٌ تفيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=208561",""]],"verses":[["مُتَطاوِلٌ يوفي مُعَرِّدُهُ","عُنقاً تَضاءَلَ خَلفَها الكَفَلُ",0,"ل",1,0],["مُتَطامِناً مِن بَعدِ ما وَضَعَت لَهُ","أَيّامُهُ خَدَّ الذَليلِ الأَضرَعِ",1,"ع",1,0],["مُتَطاعِمَينِ بِريقِنا في خَلوَةٍ","مِثلَ الفِراخِ تَزُقُّها الأَطيارُ",2,"ر",1,0],["متطابق النعماء صانت كفّه","سرح القريض وشرَّدت أموالها",3,"ل",3,0],["متطول نشتط في تكليفنا","أبداً ولا يشتط في تكليفه",4,"ف",2,0],["مُتَطاوِلٌ حَتّى كَأَنَّكَ صاعِدٌ","أَو رَبُّ مَكرُمَةٍ مِنِ اِبنى صاعِدِ",5,"د",1,0],["مُتَطَلِّعينَ إِلى لِقائِكَ أَصبَحوا","بَينَ المُخَبِّرِ عَنكَ وَالمُستَخبِرِ",6,"ر",1,0],["مُتَطَلِّبٌ بِصُدودِهِ قَتلي","فَردُ المَحاسِنِ وَجهُهُ شُغلي",7,"ي",1,1],["مُتَطَلِّعينَ إِلى الحُروبِ كَأَنَّما","يَستَطلِعونَ بِها وُجوهَ عَرائِسِ",8,"س",1,0],["مُتطلّعينَ نرَى تَقلُّبَ وجههِ","في مثلِ إيماضِ البُروقِ اللُّمَّعِ",9,"ع",1,0],["متطامنِ النظراتِ إلا أنها","نفَّاذةٌ لمكامن الأهواءِ",10,"ا",2,0],["متطلبٍ حقَّ الحياةِ لخافِقٍ","أمسى مهيضَ كرامةٍ وإباءِ",10,"ا",2,0],["مُتَطَاوِلُ الْخَدَّيْنِ فِي","وَجهٍ حَدِيدِ الْمَقْطَعِ",11,"ع",1,0],["مُتَطَوِّعاً تَسْخُو بِمَا يُفنِي القُوى","مِنْ جُهْدِ أَيَّامٍ وسُهدِ لَيَالِ",12,"ل",1,0],["مُتَطَيِّراً لَمّا أَتَتهُ لِأَنَّها","لَونانِ باطِنُها خِلافُ الظاهِرِ",13,"ر",1,0],["مُتطامِنٌ لم تُخْشَ صَولتُه","لكبْ تَضيقُ بصائِلٍ يَده",14,"د",2,0],["مُتَطَوِقاً بِسَحيق مسك جيدُهُ","مُتَلَفِحاً في عَنبَريّ لباس",15,"س",1,0],["مُتَطَلِّعٌ بِالكَفِّ يَنهَضُ مُقدِماً","مُتَتابِعٌ في جَريِهِ يَعبوبُ",16,"ب",1,0],["مُتَطَرِّحاً أَبَداً وَكَم مِن خامِلٍ","طَلَبَ النَباهَةَ فَاِستَزادَ خُمولا",17,"ل",2,0],["مُتَطاوِلٌ أسفارُه مُتَوسِّدٌ","وَجَناتُه إحدى يَدَيْ وَجنْائه",18,"ا",3,0],["مُتَطَوِّقاً لِلبِرِّ مِن يَدِهِ","وَمُقَرَّطاً بِالدُرِّ مِن كَلِمِ",19,"م",1,0],["مُتَطِلعاتٌ للعُيونِ ضُحىً","وأكُفُّها لوجوهِها نُقْب",20,"ب",1,0],["مُتَطير مِن تَيهِهِ","أَبَداً مِن اسم وِصالِهِ",21,"ل",2,0],["متطفّلٌ في العلم لا متمنّعٌ","متواضعٌ في الله لا يترفّع",22,"ع",1,0],["مُتَطَيْلِسٌ درعَ الوَقارِ مَكانَةً","وهو التُّرابُ المحضُ في الخَلَواتِ",23,"ت",1,0],["متطاولٍ فإذا عرضتَ لِلَحْظِهِ","لصقتْ أسرّةُ وجههِ بالجلمدِ",24,"د",1,0],["متطبب كالغصن في حركاته","صيرت روحي في هواه سبيلا",25,"ل",2,1],["متطلعاً والناس في غمراتهم","يتآكلون ضغينة وخبالا",26,"ل",2,0],["متطرباً بحفيفه مستروحاً","في شوقه ذاك الثرى المتنسما",27,"م",2,0],["متطايراتٍ مثل ما طار السُّرى","من بين سَرغٍ مُحْصَد وَحَماط",28,"ط",1,0],["متطول ما زال يب","دِل عسر آمله بيسرِ",29,"ر",1,0],["مُتطأطئينَ له هناك بأوجهٍ","كانت تُصانُ عنِ الخضوعِ وهامِ",30,"م",1,0],["مُتَطائرَ الأَفكار مُنسحقَ القِوى","أَبَداً يَريني العشق هَول طرادِ",31,"د",1,0],["متطَلبات من العُلى آثارها","متناولان من الأمور كبارَها",32,"ا",1,0],["متَطلَّبُ حسنَ الثناءِ يعُدُّهُ","عِوَضاً له ممّا أفاد وأتلفا",33,"ف",2,0],["مُتَطَأْطِئاً لَكَ حَاسِراً عَنْ رَأْسِهِ","يَرْجُو وَيَأْمَلُ مِنْكَ نَيْلَ تَعَطُّفِ",34,"ف",1,0],["مُتَطَلِّعٍ مِنْ كُلِّ نَجْدٍ قَاذِفٍ","تُرْبَ العِرَاقِ عَلَى أَبَاطِحِ مَنْبِجِ",35,"ج",1,0],["متطلباً اقصى المطالب","خاطب الخطب الجليل",36,"ل",1,0],["مُتَطَفِّلٌ في الحُبِّ من","نَزَلَ المَشيبُ بِهِ وَحَلّا",37,"ل",2,0],["متطلباً لجلال قدرك جبة","تبتاعها كيما تكون جليلا",38,"ل",2,0],["متطلبُ الدنيا بغيرِ وسيلةٍ","متطلبٌ ربحاً من الخُسرَان",39,"ن",1,0],["متطلعاً حولي ودوني لا أرى","إلا الردى متعطشاً لذمائي",40,"ا",2,0],["متطلباً فيمن أراه مخلصاً","والكل يشفق أن يمس ردائي",40,"ا",2,0],["متَطلِّعين كَما تطلَّع صائِمٌ","لِيَرى هِلالَ العيدِ لَيلَة يُرمَقُ",41,"ق",1,0],["متطوساً في لونه متعصفراً","احسن بمنظره وطيب المخبر",42,"ر",1,0],["متطلباً ماء لري","فؤاده والدمع ساجم",43,"م",1,0],["متطول وَالطول مِن عاداتِهِ","فَلِذاكَ كُل في الثَناء مُقَصر",44,"ر",1,0],["متطحناً غُرماً حَلِيَّ اللفظِ ذا","دمعٍ سجيمٍ سالَ كالتَيَّارِ",45,"ر",1,0],["متطلباً ممن أحب شفاعةً","فيما جرى من صدنا المتقدم",46,"م",1,0],["متطلع يَهوَى بدور طويلع","قَد تيمته بشوقها تَيماء",47,"ا",2,0],["متطلبا عثراته ليبث ما","منها اختفى ويعد ذاك مكاسبا",48,"ب",2,0],["متطلبا عثرات خلق الله كي","يغتاب مفتخرا بها لقيسا",49,"س",2,0],["\"متطرفون\" و\"فاشيون\" بزعمهم","وبجهلهم استعذبوا الألقابا",50,"ب",2,0],["متطلبا بشعاب مكة ندوة","من غالب لبست ثياب معالي",51,"ل",2,0],["متطلعاً في الافق لمحة بارقٍ","يجلو الظلام وما هنالك بارق",52,"ق",1,0],["متطلع نحو السماء","كأنه يشكو العذابا",53,"ب",2,0],["متطلّعٌ للأغنياتِ تجنبتْ","شركاً، ولمّا يحْوها ديوانيا",54,"ي",2,0],["متطوعٌ أنا للوفاءِ لخالدٍ","إذْ ليس أفضل منه بالعطفِ الجلِي",55,"ل",2,0],["متطوعٌ بضميركم لغياثنا","عن عادةِ الأبوينِ لست تحيدُ",56,"د",1,0],["متطوعٌ لإفادة الغرقَى الألى","بالذات مِن سوريّةٍ أو مصرِ",57,"ر",1,0]]}