{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[55,"غضب الحبيب فهاج لي استعبار","https://www.aldiwan.net/poem26367.html","الكامل"],[72,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[45,"أترى حمولة لا يحمل نفسه","https://www.aldiwan.net/poem63463.html","الكامل"],[45,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[44,"متطلب بصدوده قتلي","https://www.aldiwan.net/poem30132.html","الكامل"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12662","الكامل"],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[110,"وفد الربيع فقم لحث الكاس","https://www.aldiwan.net/poem16246.html","الكامل"],[128,"طرقت أسيماء الرحال ودوننا","https://www.aldiwan.net/poem24275.html","الكامل"],[144,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[365,"يرمي فؤادي وهو في سودائه","https://www.aldiwan.net/poem58720.html","الكامل"],[365,"وافى كتاب من فتى كرم","https://www.aldiwan.net/poem60659.html","أحذ الكامل"],[365,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[381,"يا من لصب واله","https://www.aldiwan.net/poem49241.html","مجزوء الكامل"],[465,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[501,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[552,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"]],"verses":[["مُتَطاوِلٌ يوفي مُعَرِّدُهُ","عُنقاً تَضاءَلَ خَلفَها الكَفَلُ",0,"ل",1,0],["مُتَطامِناً مِن بَعدِ ما وَضَعَت لَهُ","أَيّامُهُ خَدَّ الذَليلِ الأَضرَعِ",1,"ع",1,0],["مُتَطاعِمَينِ بِريقِنا في خَلوَةٍ","مِثلَ الفِراخِ تَزُقُّها الأَطيارُ",2,"ر",1,0],["متطابق النعماء صانت كفّه","سرح القريض وشرَّدت أموالها",3,"ل",3,0],["متطول نشتط في تكليفنا","أبداً ولا يشتط في تكليفه",4,"ف",2,0],["مُتَطاوِلٌ حَتّى كَأَنَّكَ صاعِدٌ","أَو رَبُّ مَكرُمَةٍ مِنِ اِبنى صاعِدِ",5,"د",1,0],["مُتَطَلِّعينَ إِلى لِقائِكَ أَصبَحوا","بَينَ المُخَبِّرِ عَنكَ وَالمُستَخبِرِ",6,"ر",1,0],["مُتَطَلِّبٌ بِصُدودِهِ قَتلي","فَردُ المَحاسِنِ وَجهُهُ شُغلي",7,"ي",1,1],["مُتَطَلِّعينَ إِلى الحُروبِ كَأَنَّما","يَستَطلِعونَ بِها وُجوهَ عَرائِسِ",8,"س",1,0],["مُتطلّعينَ نرَى تَقلُّبَ وجههِ","في مثلِ إيماضِ البُروقِ اللُّمَّعِ",9,"ع",1,0],["متطامنِ النظراتِ إلا أنها","نفَّاذةٌ لمكامن الأهواءِ",10,"ا",2,0],["متطلبٍ حقَّ الحياةِ لخافِقٍ","أمسى مهيضَ كرامةٍ وإباءِ",10,"ا",2,0],["مُتَطَاوِلُ الْخَدَّيْنِ فِي","وَجهٍ حَدِيدِ الْمَقْطَعِ",11,"ع",1,0],["مُتَطَوِّعاً تَسْخُو بِمَا يُفنِي القُوى","مِنْ جُهْدِ أَيَّامٍ وسُهدِ لَيَالِ",12,"ل",1,0],["مُتَطَيِّراً لَمّا أَتَتهُ لِأَنَّها","لَونانِ باطِنُها خِلافُ الظاهِرِ",13,"ر",1,0],["مُتطامِنٌ لم تُخْشَ صَولتُه","لكبْ تَضيقُ بصائِلٍ يَده",14,"د",2,0],["مُتَطَوِقاً بِسَحيق مسك جيدُهُ","مُتَلَفِحاً في عَنبَريّ لباس",15,"س",1,0],["مُتَطَلِّعٌ بِالكَفِّ يَنهَضُ مُقدِماً","مُتَتابِعٌ في جَريِهِ يَعبوبُ",16,"ب",1,0],["مُتَطَرِّحاً أَبَداً وَكَم مِن خامِلٍ","طَلَبَ النَباهَةَ فَاِستَزادَ خُمولا",17,"ل",2,0],["مُتَطاوِلٌ أسفارُه مُتَوسِّدٌ","وَجَناتُه إحدى يَدَيْ وَجنْائه",18,"ا",3,0],["مُتَطَوِّقاً لِلبِرِّ مِن يَدِهِ","وَمُقَرَّطاً بِالدُرِّ مِن كَلِمِ",19,"م",1,0],["مُتَطِلعاتٌ للعُيونِ ضُحىً","وأكُفُّها لوجوهِها نُقْب",20,"ب",1,0],["مُتَطير مِن تَيهِهِ","أَبَداً مِن اسم وِصالِهِ",21,"ل",2,0],["متطفّلٌ في العلم لا متمنّعٌ","متواضعٌ في الله لا يترفّع",22,"ع",1,0],["مُتَطَيْلِسٌ درعَ الوَقارِ مَكانَةً","وهو التُّرابُ المحضُ في الخَلَواتِ",23,"ت",1,0],["متطاولٍ فإذا عرضتَ لِلَحْظِهِ","لصقتْ أسرّةُ وجههِ بالجلمدِ",24,"د",1,0]]}