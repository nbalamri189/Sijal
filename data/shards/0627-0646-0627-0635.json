{"poems":[[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[88,"كل شيء من عالم الذرات","https://www.aldiwan.net/poem44975.html","الخفيف"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"أواه من جائرة جاره","https://www.aldiwan.net/poem18725.html","السريع"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[89,"غندى له قدره في كل مؤتمر","https://www.aldiwan.net/poem44776.html","البسيط"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[61,"أعاد الله عيدك بالسرور","https://www.aldiwan.net/poem51647.html","الوافر"],[66,"ما حلة ابن دبيس","https://www.aldiwan.net/poem40655.html","المجتث"],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[44,"إعلم وأنت المرء غير معلم","https://www.aldiwan.net/poem29708.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[105,"ناج الشهيد وحدث بعده الأثرا","https://www.aldiwan.net/poem42131.html","البسيط"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[46,"أنا صائم طول الحياة وإنما","https://www.aldiwan.net/poem22412.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30433","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""]],"verses":[["إِن أَصفَحَت عَنهُ الخُدودُ فَطالَما","عَطَفَت لَهُ بِلَواحِظٍ وَنَواظِرِ",0,"ر",1,0],["إنْ أصْبَحَتْ أرْضُ الخِلافَةِ معْدِنا","فالنّاسُ تُرْبَتُهُ وأنْتَ نُضارُهُ",1,"ر",2,0],["أنَاصِرَ دينِ اللهِ وابْنَ نَصيرِهِ","على حينَ لا يُغْني نَصيرٌ ولا يُجْدي",2,"د",2,0],["إِن أَصابَ الرَغيفَ مِن بَعدِ كَدٍّ","صاحَ مَن لي بِأَن أُصيبَ الإِداما",3,"م",2,0],["أن أصل الثراء فلس هل سا","لت سيول إلاّ من القطرات",4,"ت",1,0],["إن أصدَرُوا الأمرَ أصدَرُوه مَعَاً","أَو أَورَدُوا أَبلَغُوُه ما قَرَبُوا",5,"ب",3,0],["أن أصبحت للعهدِ نبَّاذة","فعينها للعقل خمَّاره",6,"ر",2,0],["أنا صادٍ ذادني عن مشْرَبٍ","سائغٍ يشفي الصَّدى دهْرٌ كَنودُ",7,"د",1,0],["إن أصلَ من نارَيْ هواه وهجرِهِ","ما قد أملَّ حديثُه جُلّاسي",8,"س",2,0],["أنا صبٌّ مُستهامُ","مِن هَوى مَن لا يُرامُ",9,"م",1,1],["انا صب بها أغنت جهارا","ام اتى شدوها كهمس الليالي",10,"ي",1,0],["أَنا صَخرَةُ الوادي إِذا ما زوحِمَت","وَإِذا نَطَقتُ فَإِنَّني الجَوزاءُ",11,"ا",2,0],["أناصرَ دولةِ الإسلامِ صبْراً","فإنَّ الصَّبْرَ من عَزمِْ الأمورِ",12,"ر",1,0],["إِن أَصبَحَ الماءُ غَوراً","جاءَت بِماءٍ مَعينِ",13,"ن",1,0],["أَنا صَبٌّ قَضَت لَهُ شِرعَةُ العِش","قِ بِأَلّا يَموتَ غَيرَ شَهيدِ",14,"د",1,0],["أَنَّ اِصطِناعَ العُرفِ ما لَم تولِهِ","مُستَكمَلاً كَالبُردِ ما لَم يُعلَمِ",15,"م",1,0],["إِن أَصبَحَت هَضَباتُ قُدسَ أَصابَها","قَدَرٌ فَما زالَت هِضابُ شَمامِ",16,"م",1,0],["إنْ أُصغروا ما رأوا في النجمِ إذْ نزلت","فالذنبُ للطرفِ لا للنجمِ في الصغرِ",17,"ر",1,0],["إنّا صَبَرنا على ما كان من مَضَضٍ","يُوهِي الجلاميدَ والعُقْبىَ لمن صَبرَا",18,"ر",2,0],["إن أصلها وصلت طائعةً","وإذا ما بنتُ عنها لم تبن",19,"ن",1,0],["أَنا صائِمٌ طولَ الحَياةِ وَإِنَّما","فِطري الحِمامُ وَيَومَ ذاكَ أُعَيِّدُ",20,"د",1,1],["إن أَصابَت إحدى التوابع ضرَّا","ءُ أَحس الجَميع بالضراء",21,"ا",2,0],["أنا صخرة الوادي إذا ما زوحمت","فإذا نطقت فإنني الجوزاء",22,"ا",2,0],["أَناصِلُّهُمْ عنْدَ الخِصَامِ فخَلِّهِمْ","للِسانِ هذى الحَيَّةِ الرَّقْشاءِ",23,"ا",2,0],["إن أصبحتْ مصرُ الخصيبةُ جنَّةً","في عهدك العُمَريِّ فهو الكَوْثَرُ",24,"ر",1,0],["إِنْ أصاخَتْ فالقَوْلُ غيرُ فَصِيحٍ","أَوْرَنَتْ فالوُجوهُ غيرُ حِسانِ",25,"ن",1,0],["أنا صخرةٌ ما إن تخوِّفُني","هذي الرياحُ الهوجُ بالصَخَب",26,"ب",1,0]]}