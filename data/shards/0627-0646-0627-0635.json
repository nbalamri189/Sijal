{"poems":[[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[88,"كل شيء من عالم الذرات","https://www.aldiwan.net/poem44975.html","الخفيف"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"أواه من جائرة جاره","https://www.aldiwan.net/poem18725.html","السريع"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[89,"غندى له قدره في كل مؤتمر","https://www.aldiwan.net/poem44776.html","البسيط"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[61,"أعاد الله عيدك بالسرور","https://www.aldiwan.net/poem51647.html","الوافر"],[66,"ما حلة ابن دبيس","https://www.aldiwan.net/poem40655.html","المجتث"],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[44,"إعلم وأنت المرء غير معلم","https://www.aldiwan.net/poem29708.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[105,"ناج الشهيد وحدث بعده الأثرا","https://www.aldiwan.net/poem42131.html","البسيط"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[46,"أنا صائم طول الحياة وإنما","https://www.aldiwan.net/poem22412.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30433","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[116,"ركب الاحبة ضحوة","https://www.aldiwan.net/poem41113.html","عموديه"],[116,"آه من فتك طرفها القتال","https://www.aldiwan.net/poem41688.html","الخفيف"],[134,"نصر بكل سعادة مقرون","https://www.aldiwan.net/poem4205.html","الكامل"],[161,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[187,"أنا صنعت بنفسي فاسمعوا اخبري","https://www.aldiwan.net/poem43777.html","البسيط"],[198,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[233,"بين المزرد والمورد","https://www.aldiwan.net/poem14808.html","مجزوء الكامل"],[238,"حير اللب ما بذي الأوراق","https://www.aldiwan.net/poem19507.html","الخفيف"],[238,"قضيت ما وعد التلاقي","https://www.aldiwan.net/poem19747.html","مجزوء الكامل"],[283,"لو لم يلح في خده عذاره","https://www.aldiwan.net/poem32781.html","الرجز"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[305,"الحمد الله على كل ما","https://www.aldiwan.net/poem16784.html","السريع"],[343,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[365,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[365,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[365,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[365,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[367,"كأنك مخلوق كما شاءت العلا","https://www.aldiwan.net/poem17169.html","الطويل"],[381,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[404,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[410,"من رزق الصبر نال بغيته","https://www.aldiwan.net/poem32022.html","المنسرح"],[410,"اصبر إذا ناب خطب وانتظر فرجا","https://www.aldiwan.net/poem32032.html","البسيط"],[433,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[444,"إن أصبحت بيروت دار مدارس","https://www.aldiwan.net/poem55958.html","عموديه"],[462,"يا باذل المال في عدم وفي سعة","https://www.aldiwan.net/poem15323.html","البسيط"],[462,"يا خيرة الله حلي عند مجتهد","https://www.aldiwan.net/poem15394.html","البسيط"],[465,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[480,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[497,"شام يا ذا السيف","https://www.aldiwan.net/poem55807.html","عموديه"],[516,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[539,"أنا صب متيم ما حييت","https://www.aldiwan.net/poem48258.html","عموديه"],[552,"لم تدع لي نوب الأي","https://www.aldiwan.net/poem47305.html","مجزوء الرمل"],[559,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[559,"إن قوما لم يروا","https://www.aldiwan.net/poem34263.html","مجزوء الرمل"],[559,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[563,"عليك كل اعتمادي أيها الصمد","https://www.aldiwan.net/poem52823.html","البسيط"],[565,"في فؤادي من الغرام لهيب","https://www.aldiwan.net/poem885.html",""],[568,"ما تغطي أكوار تلك البدور","https://www.aldiwan.net/poem69679.html","الخفيف"],[576,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[587,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"]],"verses":[["إِن أَصفَحَت عَنهُ الخُدودُ فَطالَما","عَطَفَت لَهُ بِلَواحِظٍ وَنَواظِرِ",0,"ر",1,0],["إنْ أصْبَحَتْ أرْضُ الخِلافَةِ معْدِنا","فالنّاسُ تُرْبَتُهُ وأنْتَ نُضارُهُ",1,"ر",2,0],["أنَاصِرَ دينِ اللهِ وابْنَ نَصيرِهِ","على حينَ لا يُغْني نَصيرٌ ولا يُجْدي",2,"د",2,0],["إِن أَصابَ الرَغيفَ مِن بَعدِ كَدٍّ","صاحَ مَن لي بِأَن أُصيبَ الإِداما",3,"م",2,0],["أن أصل الثراء فلس هل سا","لت سيول إلاّ من القطرات",4,"ت",1,0],["إن أصدَرُوا الأمرَ أصدَرُوه مَعَاً","أَو أَورَدُوا أَبلَغُوُه ما قَرَبُوا",5,"ب",3,0],["أن أصبحت للعهدِ نبَّاذة","فعينها للعقل خمَّاره",6,"ر",2,0],["أنا صادٍ ذادني عن مشْرَبٍ","سائغٍ يشفي الصَّدى دهْرٌ كَنودُ",7,"د",1,0],["إن أصلَ من نارَيْ هواه وهجرِهِ","ما قد أملَّ حديثُه جُلّاسي",8,"س",2,0],["أنا صبٌّ مُستهامُ","مِن هَوى مَن لا يُرامُ",9,"م",1,1],["انا صب بها أغنت جهارا","ام اتى شدوها كهمس الليالي",10,"ل",2,0],["أَنا صَخرَةُ الوادي إِذا ما زوحِمَت","وَإِذا نَطَقتُ فَإِنَّني الجَوزاءُ",11,"ا",2,0],["أناصرَ دولةِ الإسلامِ صبْراً","فإنَّ الصَّبْرَ من عَزمِْ الأمورِ",12,"ر",1,0],["إِن أَصبَحَ الماءُ غَوراً","جاءَت بِماءٍ مَعينِ",13,"ن",1,0],["أَنا صَبٌّ قَضَت لَهُ شِرعَةُ العِش","قِ بِأَلّا يَموتَ غَيرَ شَهيدِ",14,"د",1,0],["أَنَّ اِصطِناعَ العُرفِ ما لَم تولِهِ","مُستَكمَلاً كَالبُردِ ما لَم يُعلَمِ",15,"م",1,0],["إِن أَصبَحَت هَضَباتُ قُدسَ أَصابَها","قَدَرٌ فَما زالَت هِضابُ شَمامِ",16,"م",1,0],["إنْ أُصغروا ما رأوا في النجمِ إذْ نزلت","فالذنبُ للطرفِ لا للنجمِ في الصغرِ",17,"ر",1,0],["إنّا صَبَرنا على ما كان من مَضَضٍ","يُوهِي الجلاميدَ والعُقْبىَ لمن صَبرَا",18,"ر",2,0],["إن أصلها وصلت طائعةً","وإذا ما بنتُ عنها لم تبن",19,"ن",1,0],["أَنا صائِمٌ طولَ الحَياةِ وَإِنَّما","فِطري الحِمامُ وَيَومَ ذاكَ أُعَيِّدُ",20,"د",1,1],["إن أَصابَت إحدى التوابع ضرَّا","ءُ أَحس الجَميع بالضراء",21,"ا",2,0],["أنا صخرة الوادي إذا ما زوحمت","فإذا نطقت فإنني الجوزاء",22,"ا",2,0],["أَناصِلُّهُمْ عنْدَ الخِصَامِ فخَلِّهِمْ","للِسانِ هذى الحَيَّةِ الرَّقْشاءِ",23,"ا",2,0],["إن أصبحتْ مصرُ الخصيبةُ جنَّةً","في عهدك العُمَريِّ فهو الكَوْثَرُ",24,"ر",1,0],["إِنْ أصاخَتْ فالقَوْلُ غيرُ فَصِيحٍ","أَوْرَنَتْ فالوُجوهُ غيرُ حِسانِ",25,"ن",1,0],["أنا صخرةٌ ما إن تخوِّفُني","هذي الرياحُ الهوجُ بالصَخَب",26,"ب",1,0],["انا صابر ايدا علي","ه وعنه ما انا صابر",27,"ر",1,0],["أنا صبري لها وحاشاي أن أش","غل عنها حتى ألف بخالي",28,"ل",2,0],["إن أصبحت وهي البرامك أمةٌ","في ظلمها فحاسمُهُ هارون",29,"ن",1,0],["أن أصبحت لزبيد عندك ضرة","فمن الضرائر عادة لا تؤثر",30,"ر",1,0],["أنا صنعت بنفسي فاسمعوا اخبري","قتلتُ نفسي بسيف المزح والنظر",31,"ر",1,1],["أنا صديان يا لتعس نصيبي","أنا سهران يا لطول انتحابي",32,"ب",2,0],["أَنا صاحِبُ الجَفنِ القَري","ح عَلَيكَ وَالطَرفِ المُسَهَّد",33,"د",1,0],["إِنْ أَصِفْهَا بِالْحُسْنِ وَالإِشْرَاقِ","كُنْتُ شَبَّهْتُهَا بِذَاتِ الْمِحَاقِ",34,"ق",1,0],["أَنْ أَصْطَلِي نَارَ الْفِرَا","قِ فَكَانَ حَتْماً مَقْضِيَا",35,"ي",2,0],["إِنَّ اِصفِراري في الهَوى مِن هَجرِهِ","في خَدِّهِ أَوجَبَهُ اِحمِرارُهُ",36,"ر",2,0],["إنَّ اِصطِحابَ المائِق","من أَعظمِ البوائقِ",37,"ق",1,0],["إن أصاب البل من مائها","قلباً صدى يختص بالحكم",38,"م",1,0],["انا صب متيم","بك يا فتنة الفتن",39,"ن",1,0],["إن أَصبحَتْ حرباً لهمْ حُرِبوا","أو أَصبَحتْ سِلْماً لهمْ سَلِموا",40,"م",3,0],["أنا صائنٌ وَجْهي وإنْ صفِرَتْ يَدي","كم من أَغَرَّ ولا يكونُ مُحَجَّلا",41,"ل",2,0],["إن أصبحَ الدَّهرُ ليلاً داجياً فلقد","بدَتْ مساعيهِ فيه أنجماً زُهُرا",42,"ر",2,0],["إن أصبحَتْ قُبلةُ التّوديعِ فائِتَتي","فَسَلْوتي أنّها للعَودِ تُدَّخَر",43,"ر",1,0],["أَناصِحَهُ في المَجدِ كُفَّ فَإِنَّهُ","يَراكَ بِعَينِ المَجدِ لَستَ بِناصِحِ",44,"ح",1,0],["أَنا صاحب القَلب المَعَذب في الهَوى","أَبَداً يَزيد وَجيبهُ وَندوبَهُ",45,"ب",2,0],["أنا صبٌّ إليه يا ليت شعري","هل أباري شيوخه وأجاري",46,"ر",2,0],["إنَّ اصْطبارَ الزّجاجِ للسّبك والنْ","نيرانِ أدناهُ من فَمِ الملِكِ",47,"ك",1,0],["إن اصطبارَ ابنةِ العُنقودِ إذْ حُبِسَتْ","في ظُلمةِ القارِ أدَّاها إلى الكاسِ",48,"س",1,0],["أنا صبٌّ بوصلِها مستهامٌ","وهي بالهَجْرِ صبّةٌ مستهامَهْ",49,"م",2,0],["إن أصبحت بيروت دار مدارس","بل جنة بالفضل والعرفان",50,"ن",1,1],["انَّ اصفرار مِجَنِّ الشمس عن حزن","على عُلاهُ لمرْماها إِلى الأُفُقِ",51,"ق",1,0],["اِنَّ اصْطفاءَ أمير المؤمنين لهُ","أمُّ المناقبِ يا للّهِ خاطرهُ",52,"ر",2,0],["أناصرَ دين الله بالسيف آخراً","وناصرهُ كالأوّلينَ قليل",53,"ل",1,0],["أنا صوتهم فاسمع بحقك صوتهم","ولسانهم عند الدعاء لساني",54,"ن",2,0],["أنا صَوتي مِنكَ يا بَرَدَى","مثلما نَبعُك مِن سُحُبي",55,"ب",2,0],["إن أصح كأس الصبابة والصبا","فلدي من خمر الغرام خمار",56,"ر",1,0],["أنا صَبٌّ متيَّمٌ ما حَييتُ","تَيَّمَتني لمَّا تَبدَّت بِتيتُ",57,"ت",1,1],["أنا صِفْرٌ مِن أخلّا","ئي وما كنتُ مَلولا",58,"ل",2,0],["أنا صاحب الأمر الإلهي","أنا آمر أبداً وناهي",59,"ا",3,1],["أنا صب مغرمُ","واصطباري عدمُ",60,"م",1,0],["أنا صب أهيم في كل شيء","حيث ألغيت جملة الكائنات",61,"ت",1,0],["إَن أَصبَحَ العبدُ يوماً عنكَ مُبتَعِداً","فإِنَّ حِلمَكَ عنهُ ليسَ يَبتَعِدُ",62,"د",1,0],["أنا صب موله مستهام","طال هجري وعز صبري الجميل",63,"ل",1,0],["أنا صَبٌّ بِصَبْوَةٍ وتشاجٍ","وتَجَنّى وتربها مَنْثُورِ",64,"ر",1,0],["أَنا صادٍ إشن لم تَجُدْ لي عطايا","هُ وغُفْل إِن لم يَسِمْني نَوالُه",65,"ل",2,0],["أَنَا صَابِرٌ بَلْ شَاكِرٌ في الحُبِّ إنْ","أَخْلَفْتَ عَهْدَ الوَصْلِ أَوْ لَمْ تُخلِفِ",66,"ف",1,0]]}