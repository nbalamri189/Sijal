5032,"حال شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=191236",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5136,"رق قلبي ومدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=121941",""],[5174,"حوار مع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187134",""],[5232,"إلى شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=213608",""],[5277,"قسمةٌ ضيزى","https://www.poetsgate.com/ViewPoem.aspx?id=186525",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[5408,"لأنك إنّي","https://www.poetsgate.com/ViewPoem.aspx?id=190763",""],[5408,"لماذا أنا وهو لا","https://www.poetsgate.com/ViewPoem.aspx?id=190787",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5411,"مَقام الْوَرْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=196446",""],[5431,"أنا وأنا والإنعتاق الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=200430",""],[5436,"ياعيد اهلي / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177540",""],[5459,"حروف ثائرة","https://www.poetsgate.com/ViewPoem.aspx?id=197607",""],[5582,"خَيالٌ سَرَى نَوْمَةَ السَّامِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187098",""],[5700,"قصيدة 1900","https://www.poetsgate.com/ViewPoem.aspx?id=207503",""],[5769,"أُأرجوحة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215847",""],[5790,"لا تقولوا سلا ومل هوانا","https://www.poetsgate.com/ViewPoem.aspx?id=112149",""],[5853,"((مناجاة ))","https://www.poetsgate.com/ViewPoem.aspx?id=175664",""],[5939,"أفيقي!","https://www.poetsgate.com/ViewPoem.aspx?id=180000",""],[5956,"إني أحدد يا حبيبة موقعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182108",""],[5956,"صائنة حبِّي تخاطبني","https://www.poetsgate.com/ViewPoem.aspx?id=185217",""],[5956,"شاعر الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=192499",""],[5956,"شهيد الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=201541",""],[5956,"أنا الكهلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207213",""],[5977,"إنني أمل","https://www.poetsgate.com/ViewPoem.aspx?id=212728",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[6093,"إذا ما أمْرضَتْ نفسي المعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=176267",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""],[6124,"عمق التابوت","https://www.poetsgate.com/ViewPoem.aspx?id=174824",""],[6131,"الجذرُ..العتيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=189264",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""],[6310,"شريان التحدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71999&r=&rc=3",""]],"verses":[["إِن أَصفَحَت عَنهُ الخُدودُ فَطالَما","عَطَفَت لَهُ بِلَواحِظٍ وَنَواظِرِ",0,"ر",1,0],["إنْ أصْبَحَتْ أرْضُ الخِلافَةِ معْدِنا","فالنّاسُ تُرْبَتُهُ وأنْتَ نُضارُهُ",1,"ر",2,0],["أنَاصِرَ دينِ اللهِ وابْنَ نَصيرِهِ","على حينَ لا يُغْني نَصيرٌ ولا يُجْدي",2,"د",2,0],["إِن أَصابَ الرَغيفَ مِن بَعدِ كَدٍّ","صاحَ مَن لي بِأَن أُصيبَ الإِداما",3,"م",2,0],["أن أصل الثراء فلس هل سا","لت سيول إلاّ من القطرات",4,"ت",1,0],["إن أصدَرُوا الأمرَ أصدَرُوه مَعَاً","أَو أَورَدُوا أَبلَغُوُه ما قَرَبُوا",5,"ب",3,0],["أن أصبحت للعهدِ نبَّاذة","فعينها للعقل خمَّاره",6,"ر",2,0],["أنا صادٍ ذادني عن مشْرَبٍ","سائغٍ يشفي الصَّدى دهْرٌ كَنودُ",7,"د",1,0],["إن أصلَ من نارَيْ هواه وهجرِهِ","ما قد أملَّ حديثُه جُلّاسي",8,"س",2,0],["أنا صبٌّ مُستهامُ","مِن هَوى مَن لا يُرامُ",9,"م",1,1],["انا صب بها أغنت جهارا","ام اتى شدوها كهمس الليالي",10,"ل",2,0],["أَنا صَخرَةُ الوادي إِذا ما زوحِمَت","وَإِذا نَطَقتُ فَإِنَّني الجَوزاءُ",11,"ا",2,0],["أناصرَ دولةِ الإسلامِ صبْراً","فإنَّ الصَّبْرَ من عَزمِْ الأمورِ",12,"ر",1,0],["إِن أَصبَحَ الماءُ غَوراً","جاءَت بِماءٍ مَعينِ",13,"ن",1,0],["أَنا صَبٌّ قَضَت لَهُ شِرعَةُ العِش","قِ بِأَلّا يَموتَ غَيرَ شَهيدِ",14,"د",1,0],["أَنَّ اِصطِناعَ العُرفِ ما لَم تولِهِ","مُستَكمَلاً كَالبُردِ ما لَم يُعلَمِ",15,"م",1,0],["إِن أَصبَحَت هَضَباتُ قُدسَ أَصابَها","قَدَرٌ فَما زالَت هِضابُ شَمامِ",16,"م",1,0],["إنْ أُصغروا ما رأوا في النجمِ إذْ نزلت","فالذنبُ للطرفِ لا للنجمِ في الصغرِ",17,"ر",1,0],["إنّا صَبَرنا على ما كان من مَضَضٍ","يُوهِي الجلاميدَ والعُقْبىَ لمن صَبرَا",18,"ر",2,0],["إن أصلها وصلت طائعةً","وإذا ما بنتُ عنها لم تبن",19,"ن",1,0],["أَنا صائِمٌ طولَ الحَياةِ وَإِنَّما","فِطري الحِمامُ وَيَومَ ذاكَ أُعَيِّدُ",20,"د",1,1],["إن أَصابَت إحدى التوابع ضرَّا","ءُ أَحس الجَميع بالضراء",21,"ا",2,0],["أنا صخرة الوادي إذا ما زوحمت","فإذا نطقت فإنني الجوزاء",22,"ا",2,0],["أَناصِلُّهُمْ عنْدَ الخِصَامِ فخَلِّهِمْ","للِسانِ هذى الحَيَّةِ الرَّقْشاءِ",23,"ا",2,0],["إن أصبحتْ مصرُ الخصيبةُ جنَّةً","في عهدك العُمَريِّ فهو الكَوْثَرُ",24,"ر",1,0],["إِنْ أصاخَتْ فالقَوْلُ غيرُ فَصِيحٍ","أَوْرَنَتْ فالوُجوهُ غيرُ حِسانِ",25,"ن",1,0],["أنا صخرةٌ ما إن تخوِّفُني","هذي الرياحُ الهوجُ بالصَخَب",26,"ب",1,0],["انا صابر ايدا علي","ه وعنه ما انا صابر",27,"ر",1,0],["أنا صبري لها وحاشاي أن أش","غل عنها حتى ألف بخالي",28,"ل",2,0],["إن أصبحت وهي البرامك أمةٌ","في ظلمها فحاسمُهُ هارون",29,"ن",1,0],["أن أصبحت لزبيد عندك ضرة","فمن الضرائر عادة لا تؤثر",30,"ر",1,0],["أنا صنعت بنفسي فاسمعوا اخبري","قتلتُ نفسي بسيف المزح والنظر",31,"ر",1,1],["أنا صديان يا لتعس نصيبي","أنا سهران يا لطول انتحابي",32,"ب",2,0],["أَنا صاحِبُ الجَفنِ القَري","ح عَلَيكَ وَالطَرفِ المُسَهَّد",33,"د",1,0],["إِنْ أَصِفْهَا بِالْحُسْنِ وَالإِشْرَاقِ","كُنْتُ شَبَّهْتُهَا بِذَاتِ الْمِحَاقِ",34,"ق",1,0],["أَنْ أَصْطَلِي نَارَ الْفِرَا","قِ فَكَانَ حَتْماً مَقْضِيَا",35,"ي",2,0],["إِنَّ اِصفِراري في الهَوى مِن هَجرِهِ","في خَدِّهِ أَوجَبَهُ اِحمِرارُهُ",36,"ر",2,0],["إنَّ اِصطِحابَ المائِق","من أَعظمِ البوائقِ",37,"ق",1,0],["إن أصاب البل من مائها","قلباً صدى يختص بالحكم",38,"م",1,0],["انا صب متيم","بك يا فتنة الفتن",39,"ن",1,0],["إن أَصبحَتْ حرباً لهمْ حُرِبوا","أو أَصبَحتْ سِلْماً لهمْ سَلِموا",40,"م",3,0],["أنا صائنٌ وَجْهي وإنْ صفِرَتْ يَدي","كم من أَغَرَّ ولا يكونُ مُحَجَّلا",41,"ل",2,0],["إن أصبحَ الدَّهرُ ليلاً داجياً فلقد","بدَتْ مساعيهِ فيه أنجماً زُهُرا",42,"ر",2,0],["إن أصبحَتْ قُبلةُ التّوديعِ فائِتَتي","فَسَلْوتي أنّها للعَودِ تُدَّخَر",43,"ر",1,0],["أَناصِحَهُ في المَجدِ كُفَّ فَإِنَّهُ","يَراكَ بِعَينِ المَجدِ لَستَ بِناصِحِ",44,"ح",1,0],["أَنا صاحب القَلب المَعَذب في الهَوى","أَبَداً يَزيد وَجيبهُ وَندوبَهُ",45,"ب",2,0],["أنا صبٌّ إليه يا ليت شعري","هل أباري شيوخه وأجاري",46,"ر",2,0],["إنَّ اصْطبارَ الزّجاجِ للسّبك والنْ","نيرانِ أدناهُ من فَمِ الملِكِ",47,"ك",1,0],["إن اصطبارَ ابنةِ العُنقودِ إذْ حُبِسَتْ","في ظُلمةِ القارِ أدَّاها إلى الكاسِ",48,"س",1,0],["أنا صبٌّ بوصلِها مستهامٌ","وهي بالهَجْرِ صبّةٌ مستهامَهْ",49,"م",2,0],["إن أصبحت بيروت دار مدارس","بل جنة بالفضل والعرفان",50,"ن",1,1],["انَّ اصفرار مِجَنِّ الشمس عن حزن","على عُلاهُ لمرْماها إِلى الأُفُقِ",51,"ق",1,0],["اِنَّ اصْطفاءَ أمير المؤمنين لهُ","أمُّ المناقبِ يا للّهِ خاطرهُ",52,"ر",2,0],["أناصرَ دين الله بالسيف آخراً","وناصرهُ كالأوّلينَ قليل",53,"ل",1,0],["أنا صوتهم فاسمع بحقك صوتهم","ولسانهم عند الدعاء لساني",54,"ن",2,0],["أنا صَوتي مِنكَ يا بَرَدَى","مثلما نَبعُك مِن سُحُبي",55,"ب",2,0],["إن أصح كأس الصبابة والصبا","فلدي من خمر الغرام خمار",56,"ر",1,0],["أنا صَبٌّ متيَّمٌ ما حَييتُ","تَيَّمَتني لمَّا تَبدَّت بِتيتُ",57,"ت",1,1],["أنا صِفْرٌ مِن أخلّا","ئي وما كنتُ مَلولا",58,"ل",2,0],["أنا صاحب الأمر الإلهي","أنا آمر أبداً وناهي",59,"ا",3,1],["أنا صب مغرمُ","واصطباري عدمُ",60,"م",1,0],["أنا صب أهيم في كل شيء","حيث ألغيت جملة الكائنات",61,"ت",1,0],["إَن أَصبَحَ العبدُ يوماً عنكَ مُبتَعِداً","فإِنَّ حِلمَكَ عنهُ ليسَ يَبتَعِدُ",62,"د",1,0],["أنا صب موله مستهام","طال هجري وعز صبري الجميل",63,"ل",1,0],["أنا صَبٌّ بِصَبْوَةٍ وتشاجٍ","وتَجَنّى وتربها مَنْثُورِ",64,"ر",1,0],["أَنا صادٍ إشن لم تَجُدْ لي عطايا","هُ وغُفْل إِن لم يَسِمْني نَوالُه",65,"ل",2,0],["أَنَا صَابِرٌ بَلْ شَاكِرٌ في الحُبِّ إنْ","أَخْلَفْتَ عَهْدَ الوَصْلِ أَوْ لَمْ تُخلِفِ",66,"ف",1,0],["ان أصبح الكل جذلاناً فلا عجبٌ","ان المسرّات طرّاً عمّت الامما",67,"م",2,0],["إنا صنائعهم وقد بلغت بهم","حد النهاية قدرة الصناع",68,"ع",1,0],["أَناصحٌ بَعد هَذا الغيِّ أَرشدَهُ","حرصاً عَلَيهِ إِلى تَركٍ وَسلوان",69,"ن",1,0],["إن أصبحوا خير القبائل مالكاً","فلأنت خير المالكين قبيلا",70,"ل",2,0],["أَنا صَبٌّ قَد سَقاهُ في الهَوى","بَدرُ حسنٍ خَمرَ وَجدٍ ثمّ راحْ",71,"ح",1,1],["أَنا صَبٌّ قَد جَفاني","أَحسَنُ الأَقمارِ شَكلا",72,"ل",2,1],["أَنا صَبٌّ وَفي هَواها قتيلٌ","وقتيلُ الغَرامِ خيرُ شهيدِ",73,"د",1,0],["أَنا صَبٌّ بِالتّصابي وَالهَوى","ذابَ مِنهُ القَلبُ وَالجِسمُ اِنتَحَل",74,"ل",1,0],["أنا صَبٌّ بغير شينٍ وكافِ","والذي بي من الصبابة كاف",75,"ف",1,1],["أناصرُ إنْ واراك رمسٌ عن الورى","فقد بقيتْ للناس منكَ الفضائل",76,"ل",1,0],["أنا صَامِتٌ صَمتي كلامُ","وَجَعي كنومِي لا يَنامُ",77,"م",1,1],["أنا صادق في ما أقول وضامن","أن الزمان إذا أقول يكرر",78,"ر",1,0],["أَنا صَبٌّ كَما تَشاءُ وَتَهوَى","شاعِرٌ ماجِنٌ خَليعٌ جَوادُ",79,"د",1,1],["إن أصلت في لفظها أو فرعت","أو فرقت في وضعها في أو جمعت",80,"ت",1,0],["إنْ أصَحَّ الوصل توبته","كانَ ذنب البين مغتَفَرَا",81,"ر",2,0],["إنّ اصطبارَ الجَنينِ في ظُلَمِ ال","أحشاءِ أفضى به إلى النّورِ",82,"ر",1,0],["أَناصِرَ دينِ اللَهِ لازِلتَ ناصِرِ","عَلى زَمَنٍ فِيهِ الأَديبُ مُطَّهَدُ",83,"د",1,0],["إن أُصِبْنَا فإليكَ المُشْتَكى","أو أَصَبْنَا فعليكَ المُعْتَمد",84,"د",1,0],["أنا صابر في الحب صبر شمونة","أمّ المكابيين في بلواها",85,"ا",3,0],["إن أصحرت نشرت قوائمها","كالريح عاصفة لها مر",86,"ر",1,0],["أنا صهر مختار أنا الختن الذي","أتاني به الفاروقُ عند أبي بكر",87,"ر",1,0],["أنا صورةٌ من صورةٍ لم تقم بنا","ولو أنها قامتْ لأدركني العجبُ",88,"ب",1,0],["أنا صاحبُ الملك الذي قال إنني","أنا نائبٌ فيه بأصدقِ قيلِ",89,"ل",1,1],["ان اصفرار اللون منهُ حكماً","بأنهُ قد كان صبّاً مغرما",90,"م",2,0],["أنا صابرٍ للِفِرْقْيا يِعْلَها ما تعود","تِوَثّر على الوَلهان السَدّ منْه يْبوح",91,"ح",1,0],["أَنا صادٍ لِنَشوَةٍ وَاِرتِياحِ","رَدِّديهِ لِلصُبحِ هَل مِن صَباحِ",92,"ح",1,0],["إنّ اصطلاماً غَيبَةُ الفؤادِ","عن كل مشهودِ سوى المَعبُودِ",93,"د",1,0],["إِن أَصلَحت يَده مِن أَمره طَرفا","رَأى يَ