{"poems":[[87,"قبر الوزير تحية وسلاما","https://www.aldiwan.net/poem62828.html","الكامل"],[92,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[280,"ويح ابن آدم غرته سلامته","https://www.aldiwan.net/poem25389.html","البسيط"],[371,"هذي قرون حماة جئت تأخذها","https://www.aldiwan.net/poem17165.html","البسيط"],[374,"يا سيف دين الله عش سالماً","https://www.aldiwan.net/poem4275.html","السريع"],[382,"الذكر يحدث أشباحا مخيلة","https://www.aldiwan.net/poem59173.html","البسيط"],[398,"المجد أجمع ما حوته يميني","https://www.aldiwan.net/poem53666.html","الكامل"],[406,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[411,"يا عائب الحبر والأقلام ما قدحت","https://www.aldiwan.net/poem50069.html","البسيط"],[415,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[438,"قدر الأثير على الأثير علي","https://www.aldiwan.net/poem12765.html","الكامل"],[445,"جاءتك خاضعة أعناقها الأمم","https://www.aldiwan.net/poem34812.html","البسيط"],[458,"أهتز قربك كالزمان قصيدة","https://www.aldiwan.net/poem61380.html","الكامل"],[463,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138278",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126756","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62667","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56594","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77847","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121535","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137290",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201690","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100734","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87404","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89319","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102976","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73342","الدوبيت"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/118194","البسيط"],[4788,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=132283",""],[4869,"المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=151553",""],[5111,"الفهري","https://www.poetsgate.com/ViewPoem.aspx?id=212044",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5198,"وهل يخفى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=135398",""],[5212,"شبيه موسى","https://www.poetsgate.com/ViewPoem.aspx?id=212105",""],[5271,"لمْ أَدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=62008",""],[5277,"خضراءُ تعشقُ ذبولَها..","https://www.poetsgate.com/ViewPoem.aspx?id=206805",""],[5365,"الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=190439",""],[5365,"تجلّيات صوفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=191063",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5455,"دفتر اوجاعي","https://www.poetsgate.com/ViewPoem.aspx?id=34427",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5574,"آياتُ الدجى وهواجسُ عاشقٍ أدمن الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206012",""],[5574,"تائية أبي ريما","https://www.poetsgate.com/ViewPoem.aspx?id=206045",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5638,"رثاء وأمل في اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=198247",""],[5695,"الموعد المؤجّل..","https://www.poetsgate.com/ViewPoem.aspx?id=212395",""],[5704,"ثَمِلُ الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=191156",""],[5704,"طربُ العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=191318",""],[5792,"ارحم عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=180359",""],[5956,"قوانين المحبة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182607",""],[6085,"سر ياقلم","https://www.poetsgate.com/ViewPoem.aspx?id=8675",""]],"verses":[["هَذي قُبورُكُمُ وَتِلكَ قُبورُنا","مُتَجاوِرينَ جَماجِماً وَعِظاما",0,"م",2,0],["هذي قُبُورُ بَنِي أَبِيكَ ودُورُهُمْ","يَمْلأنَ عرْضَاً في الحِجَازِ وطُولا",1,"ل",2,0],["هَذِي قراراتكم شَلاَّءُ، مُودَعَةٌ","غَيَابَةَ السجن، عنها النُّورُ مُحْتَجِب",2,"ب",1,0],["هذي قسيّ الليالي غيرُ صائنةٍ","سهامها عن أخي حبو وتقريس",3,"س",1,0],["هَذي قُرونُ حماةٍ جِئتَ تَأخُذُها","وَإِنَّ إِمساكَها يُفضي إِلى حَلَبِ",4,"ب",1,1],["هذي قوافي الخالويهيّ لا","يَطرَح منها لفظةً طارِهُ",5,"ر",2,0],["هذي قِوَى الروح في الإنسان إن حصلت","في العقل صيَّرتِ المجهول معقولا",6,"ل",2,0],["هذي قَريعَةُ دهرِها وافَتكُمُ","في مَعرِضِ التَحسينِ وَالترصين",7,"ن",1,0],["هذي (قويزةُ) قلبي صار يُنْكره","وعبَّرتْ هي عن رفضي ونكراني",8,"ن",2,0],["هَذي قَليبُ القُلوبِ الصَّادِياتِ وذي","أرشاؤها يُستقى مِنها بلا تَعَبِ",9,"ب",1,0],["هذي قصورُهُمُ أمست قبورَهُمُ","كذاكَ كانوا بها من قبلُ سكّانا",10,"ن",2,0],["هذي قضيّةُ حالِه فتلطّفوا","في العُذْرِ عنه الآن فهو صبيُّ",11,"ي",1,0],["هذِي قَوَاصِي ملوكِ الشِّرْكِ مُذْعِنَةٌ","تُنْبَا وتُعْلَمُ أَنَّ الشِّرْكَ يُصطَلَمُ",12,"م",1,0],["هذي قصيدتي التي أنكرتها","من قبل عادت لي أحبّ رجائيا",13,"ي",2,0],["هذي قضايا رسولِ اللّه مهمَلةٌ","غدراً وشملُ رسول اللّه منصدِعُ",14,"ع",1,0],["هذى قصائده هذى نشئده","كالسلبيل لنا من ذاقها سكرا",15,"ر",2,0],["هذي قَصيدتيَ الّتي قدّمتها","نَرجو قَبولا لا نُريدُ أُجورا",16,"ر",2,0],["هذي قلاع وأجناد بأرضك أم","هي البروج السماويات والشهب",17,"ب",1,0],["هذي قصورهم وتلك","قبورهم أضحت عِبَرْ",18,"ر",1,0],["هذي قلوب لا تهاب الحمام","هذي صدور لا تبالي الصدام",19,"م",1,0],["هذي قصيدة قاصد لم يقتصد","إِلّا عَلى مقدار فهم القاري",20,"ر",2,0],["هَذي قلوبُ المهتدين وما حَوَت","بالهَدى من صدقٍ ومن إيمانِ",21,"ن",1,0],["هذي قواف كما شاءت بلاغتها","ولو تباع لكان الحسن يشريها",22,"ي",3,0],["هذي قرينتك التي يعلو بها","شعري ويغلو في الثناء كلامي",23,"م",2,0],["هذي قياساتُكَ في الداماني","قياسُ نَتخَاتِكَ يارُبَّاني",24,"ي",1,0],["هذي قيامتنا الصغرى قد ابتدأت","فهل قيامتنا الكبرى على التبع",25,"ع",1,0],["هذي قوافيك في الالياذة ابتسمت","عن لؤلؤ مودع في خير ديوان",26,"ن",1,0],["هذي قضايا الحبّ أَن","لا صعبَ فيهِ سوى اللوائم",27,"م",1,0],["هذي قصيدي فإن أُقبَلْ فمن كرم","قد عم غيري وإن أُرْدَدْ فوا ندمي",28,"م",2,0],["هَذي قوافٍ على أسِّ النّسيبِ إلى","خِطاب عُلْياك قد شيّدْتُ مَبْناها",29,"ا",3,0],["هذي قصيدتك الغراء قد لبست","ثوباً بديعاً تمنى وشبه الزهر",30,"ر",1,0],["هذي قِصَصي رفعتُها عن حُزني","في حُبِّك لا عنِ الغَضا والحَزنِ",31,"ن",1,1],["هذي قوانين يلفى من تتبعها","ما يشبه البحر فيضا من نواحيه",32,"ي",2,0],["هذي قصيدة حب والمطلب رضاك","أرسلتها والشوق يجتاح روحي",33,"ح",2,0],["هذي قسيمه من هبوب النسآيم","فيهآ عتب قلبٍ من الحآل نآفر",34,"ر",1,0],["هَذِي قَصَائِدنَا تَرَاقَصَ نورُهَا","فَإذَا سَنَا إزوَرْدِهَا بَرَّاقُ",35,"ق",1,0],["هذي قناديلٌ تُزيِّنُ هامتي","من جذوةِ الفكرِ استمدتْ نورَها",36,"ر",3,0],["هذي قويّة لاحشا مااصدّ وابعد ياملاك","انا الوفا طبعي ولااحبّ الخيانة والغدر",37,"ر",1,0],["هذي قُلوبُ العاشِقينَ تَزاحَمَتْ","تاقَتْ إِلى حُكمٍ بِصَوتِكَ يَصدُرُ",38,"ر",1,0],["هذي قصائدي أدمنتكِ مواسمًا","للحبِ تزهو في ربى الصفحاتِ",39,"ت",1,0],["هذي قوافي الشوقِ تحكي أنَّني","بهواكِ كمْ يامنتُ بُعْداً أعسرا",40,"ر",2,0],["هذي قصيدي على أعتابِكُم وَقَفَتْ","تبكي الطُّلُولَ وقد ناديتُ مَنْ ذهبُوا",41,"ب",3,0],["هذي قصيدي على أعتابِهِم وقَفَتْ","تبكي الحروفَ يَحِنُّ الّليلُ والطّلَلُ",42,"ل",1,0],["هذي قريشُ حجيجُ اللهِ يقْصدُها","من كلِّ صوبٍ من الإشْراكِ في غَمَمِ",43,"م",1,0],["هذي قريش وكلُّ الناسِ تألفُها","الشرْكُ والرقُّ وأدُ البنتِ في الأدمِ",43,"م",1,0],["هذي قصيده قلتها في عتابه","وهذي قصيده قلتها يوم فرقاه",44,"ا",2,0],["هذي قصائِدُه ُ الكُبرى تُعَلِّمُنا","كيفَ المَجَرَّاتُ يَشَّكَلْن َتَشكيلا",45,"ل",2,0],["١٧- هذي قرابيني عليكَ يُهيلُها","حُلُمي الذي يخْشى الصّباحَ ومكْرَهُ",46,"ر",2,0],["٢٠- هذي قوافي قِصّتي قدْ ألهبَتْ","صدري، فبِتُّ أجولُ في أبْياتِها",47,"ت",3,0],["هذي قوافيَّ قد حمّلتها وَهجا ً","والشعرُ ما زالَ مِنْ حرّاقة يَرِدُ",48,"د",1,0],["هَذِي قُبُورٌ لا النُّجُومُ مُشِعَّةٌ","أَيُضِيءُ لَيْلَ الْيَائِسِينَ رِجَامُ",49,"م",1,0],["هذِي قراءةُ شاعرٍ مستمتعٍ","متخيّلٍ متفلسفٍ في آنِ",50,"ن",1,0],["هذي قصيدتها أبياتهَا ختمتْ","أوصافها شردتْ والشِّعْرُ قَدْ ذَهلاَ",51,"ل",2,0],["هذي قصيدتها بالدمع أكتبها","بالسُّهْدِ أطعمها سرًّا وإعْلَانَا",52,"ن",2,0],["هذي قيودك حلها من ايديني","حب يذل القلب ياناس ما ابيه",53,"ي",2,0],["هذي قوانين المحبة والهدى‎","أمّا قوانين البلاد ندوسُها‎",54,"س",3,0],["هذي قصيده قلتها يا اخواني","فيها نصايح إشملت بعض الابيات",55,"ت",1,0]]}