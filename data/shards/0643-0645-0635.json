{"poems":[[53,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[53,"لا تعذلني في السكوت","https://www.aldiwan.net/poem29867.html","مجزوء الكامل"],[77,"سبع مضت من زمان الليل وا أسفي","https://www.aldiwan.net/poem35926.html","البسيط"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[47,"ماصاحبي إلا الذي من بشره","https://www.aldiwan.net/poem25110.html","الكامل"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[72,"كم صار مثل دبيب النمل لي كلم","https://www.aldiwan.net/poem20485.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"كم صديق عرفته بصديق","https://www.aldiwan.net/poem65207.html","الخفيف"],[45,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[66,"طلب الود بالزيارة زور","https://www.aldiwan.net/poem38679.html","الخفيف"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[97,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[97,"إن السراة الأباظيين قد عظموا","https://www.aldiwan.net/poem24970.html","البسيط"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[44,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[52,"كم صنيع شكرته لبني وهب","https://www.aldiwan.net/poem26575.html","الخفيف"],[48,"عليك باليأس من الناس","https://www.aldiwan.net/poem64343.html","السريع"],[46,"يسمون بالجهل عبد الرحيم","https://www.aldiwan.net/poem22499.html","المتقارب"],[46,"أنافق الناس إني قد بليت بهم","https://www.aldiwan.net/poem23518.html","البسيط"],[46,"كم صرف المولود عن والد","https://www.aldiwan.net/poem23554.html","السريع"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54720","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55002","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54854","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[45,"يا أخا الحارِثِ بنِ كَعبِ بنِ عمرو","https://www.poetsgate.com/ViewPoem.aspx?id=32074",""]],"verses":[["كَم صَبرُ خافي الشَخصِ مُستَجِنِّ","مُنطَمِرٍ مِنَ الأَذى في سِجنِ",0,"ن",1,0],["كَم صَبَغَ الدَهرُ قَميصَ الثَرى","وَعادَ رِقُّ الأَرضِ ضاحي الوُشوم",1,"م",1,0],["كَم صامِتٍ مُتَوَقِّعٍ","أَنّى يَعِنُّ لَهُ المَقالُ",2,"ل",1,0],["كمْ صُنْتُ جوْهرَهُ بالجَهْدِ فانتُهِبَتْ","وكيفَ والأمرُ حقٌّ إنْ نظَرْتَ وَفِي",3,"ي",1,0],["كَم صَكَّ مَسمَعَنا بِجَندَلِ لَفظِهِ","وَأَطالَ مِحنَتَنا بِطولِ لِسانِهِ",4,"ن",2,0],["كم صورةٍ لك في الفتوح وسورةٍ","تُجلى وتُتلى بكرة وأصيلا",5,"ل",2,0],["كَم صاحِبٍ لَم أَغنَ عَن إِنصافِهِ","في عُسرِهِ وَغَنيتُ عَن إِحسانِهِ",6,"ه",1,0],["كمْ صافحت من راحتيهِ يد امرئ","عشراً وصبحه الهناءُ فعيَّدا",7,"د",2,0],["كم صار مثل دبيب النمل لي كلمٌ","من الهوان صغيراً بين أقراني",8,"ي",1,1],["كم صرعةٍ بين العبي","دِ وخَلْوةٍ لك مُسْترابهْ",9,"ب",2,0],["كَم صَليب من الصفا آيستْهُ","عُقبُ الدهر أيما تأييس",10,"س",1,0],["كمصباحِ الكرام بني بويبٍ","أبى حسنٍ لشانئهِ الهُبولُ",11,"ل",1,0],["كَم صَيحَةٍ لِلدَهرِ في آذانِنا","مَرَّت كَما مَرَّت عَلى أَرماسِ",12,"س",1,0],["كم صاحب لبدور الأرض فارقهم","لم يحص من حشرات الأرض ما صحبا",13,"ب",2,0],["كَم صَعَّبَ اليَومُ مِن سَهلٍ هَمَمتَ بِهِ","وَسَهَّلَ الغَدُ في الأَشياءِ ما صَعُبا",14,"ب",2,0],["كَم صَريحٍ إِلَيهِ غَشَّت بَياضاً","أَوجُهِ المَكرُماتِ سودُ أُسودِه",15,"د",2,0],["كَم صَديقٍ عَرَفتُهُ بِصَديقٍ","صارَ أَحظى مِنَ الصَديقِ العَتيقِ",16,"ق",1,1],["كَم صَحيحٍ قَدِ اِدَّعى السُقمَ فيهِ","وَعَليلٍ لَيلَهُ يَنيكُ قِياما",17,"م",2,0],["كَمُصَلصِلٍ يَعدو عَلى بَيدانَةٍ","حَقباءَ مِن حُمُرِ القَنانِ مُشَرَّدِ",18,"د",1,0],["كَم صَديقٍ يُقَصِّرُ السَعيَ تَخفي","فاً بِقَصدٍ وَكَم عَدُوٍّ يَزورُ",19,"ر",1,0],["كَم صِيامٍ قَرَنتَهُ بِقِيامٍ","وَصَلاةٍ وَصَلتَها بِصِلاتِ",20,"ت",1,0],["كم صِحتُ إذا أبصرت هذا الجهاد","وميسم الذلة فوق الجباه",21,"ه",1,0],["كم صحت والعين تذري الدمع في أسف","على الجواهر في كف الردى العادي",22,"د",2,0],["كَمْ صَديقٍ بكاكَ مثلي بدَمعٍ","طائعٍ من شؤونه لا عصيِّ",23,"ي",1,0],["كَم صامِتٍ صامِتِيِّ الضَربِ فُزتُ بِهِ","مِنهُ وَحَليٍ مِنَ المَعروفِ حَلّاني",24,"ي",1,0],["كَم صارِمٍ عَضبٍ أَنافَ عَلى فَتىً","مِنهُم لِأَعباءِ الوَغى حَمّالِ",25,"ل",1,0],["كم صريعٍ لكِ في أشلائِه","مَصرعُ القُربَى وأشلاءُ الرَّحِمْ",26,"م",1,0],["كَم صَنيعٍ شَكَرتُهُ لِبَني وَه","بٍ بَدا لي وَما اِهتَدَيتُ إِلَيهِ",27,"ي",2,1],["كَم صاحِبٍ قَد كانَ لي وامِقاً","إِذ كانَ في حالاتِ إِفلاسِ",28,"س",1,0],["كَمِصباحِ لَيلٍ بَدا يَستَنيرُ","ثُمَّ تَناقَصَ حَتّى خَمَد",29,"د",1,0],["كَم صاحِبٍ يَتَمَنّى لَو نُعيتُ لَهُ","وَإِن تَشَكَّيتُ راعاني وَفَدّاني",30,"ي",1,0],["كَم صَرَفَ المَولودُ عَن والِدٍ","خَيراً وَكَم أُمٍّ لَهُ لَم يَمُن",31,"ن",1,1],["كم صائنٍ عن قُبْلَةٍ خدَّهُ","سُلّطَتِ الأرْضُ على خَدّهِ",32,"د",2,0],["كم صُدوداً عساكَ ترْحَمُ شكْوا","يَ ولو باسْتِمَاعِ قولي عساكا",33,"ك",2,0],["كَم صَريعٍ مِن صَدمَةٍ أَو صَريعٍ","مِن سُمومٍ مُخَدَّرِ الأَوصالِ",34,"ل",1,0],["كَمْ صَانَ عِرْضاً طَاهِراً مِنْ رِيبَةٍ","وَنَفَى أَذى عَنْ عَاثِرٍ مَنكودِ",35,"د",1,0],["كمْ صَائِدٍ صَادَ مَا يُرْدِيهِ مَأْكَلُهُ","وَصَارِعٍ بَاتَ حَقّاً وَهْوَ مَصْرُوعُ",36,"ع",1,0],["كَمْ صُغْتَ آيَةَ وَحْيٍ","يُعِيدُهَا النَّاسُ شِعْرَا",37,"ر",2,0],["كم صاحب أحرقت نفسك دونه","فهوى عليك بقسوة الوقاد",38,"د",1,0],["كم صنَعْنَا مِنْ عقُولٍ ورجَالْ للَوطنْ","عُرِفُوا بالنبلِ فيمن عُرِفَا",39,"ف",2,0],["كم صابروا عَنَتَ الحياةِ وعُسْرَها","بخلائقٍ غُرِّ الوجوهِ صِباح",40,"ح",1,0],["كم صبرنا على الخطُوبِ كرامًا","واعتصمنا عند الطَّوى بالإباء",41,"ا",2,0],["كم صانعٍ بالقارِ خُضِّبَ ثوبُه","فعددتُ هذا القارَ خيرَ وشاحِ",42,"ح",1,0],["كم صِبغَ من قطَراته","للمترَف الدرُّ النَّضيد!",43,"د",1,0],["كم صديقٍ من وَجهه يقطر البشْ","ر، ولا يأمَنُ الصَّديقُ غيابه",44,"ب",2,0],["كم صدَّعُونا بأقوال مُهَلْهلَةِ","ليست بشعرٍ؛ ولا نثرٍ، ولا زَجَل!",45,"ل",1,0],["كم صرّفتنا يدٌ كنا نُصرّفها","وبات يحكمنا شعب ملكناه",46,"ا",2,0],["كَم صَحيحٍ قد ادّعى السّقمَ فيهِ،","وَعَليلٍ قَد ادّعَى البِرْسَامَا",47,"م",2,0]]}