{"poems":[[53,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[53,"لا تعذلني في السكوت","https://www.aldiwan.net/poem29867.html","مجزوء الكامل"],[77,"سبع مضت من زمان الليل وا أسفي","https://www.aldiwan.net/poem35926.html","البسيط"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[47,"ماصاحبي إلا الذي من بشره","https://www.aldiwan.net/poem25110.html","الكامل"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[72,"كم صار مثل دبيب النمل لي كلم","https://www.aldiwan.net/poem20485.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[85,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"كم صديق عرفته بصديق","https://www.aldiwan.net/poem65207.html","الخفيف"],[45,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[66,"طلب الود بالزيارة زور","https://www.aldiwan.net/poem38679.html","الخفيف"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[97,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[97,"إن السراة الأباظيين قد عظموا","https://www.aldiwan.net/poem24970.html","البسيط"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[44,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[52,"كم صنيع شكرته لبني وهب","https://www.aldiwan.net/poem26575.html","الخفيف"],[48,"عليك باليأس من الناس","https://www.aldiwan.net/poem64343.html","السريع"],[46,"يسمون بالجهل عبد الرحيم","https://www.aldiwan.net/poem22499.html","المتقارب"],[46,"أنافق الناس إني قد بليت بهم","https://www.aldiwan.net/poem23518.html","البسيط"],[46,"كم صرف المولود عن والد","https://www.aldiwan.net/poem23554.html","السريع"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54720","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55002","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54854","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[45,"يا أخا الحارِثِ بنِ كَعبِ بنِ عمرو","https://www.poetsgate.com/ViewPoem.aspx?id=32074",""],[107,"مدحي لغيرك في الورى تقليد","https://www.aldiwan.net/poem16191.html","الكامل"],[113,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[118,"لا تدرها فإنني غير صاح","https://www.aldiwan.net/poem49342.html","الخفيف"],[145,"يا أيها الريح الجنوب تحملي","https://www.aldiwan.net/poem47644.html","الكامل"],[153,"لجنون الهوى وهبت جناني","https://www.aldiwan.net/poem55511.html","الطويل"],[153,"ليل شعر من فوق صبح جبين","https://www.aldiwan.net/poem55611.html","الخفيف"],[158,"التام جرح والاساة غيب","https://www.aldiwan.net/poem59006.html","الرجز"],[167,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[183,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[184,"كم صاحب صاحبته في التقى","https://www.aldiwan.net/poem43712.html","السريع"],[184,"عزب مفتاحه بيده","https://www.aldiwan.net/poem43936.html","المديد"],[196,"ألوت بأهل اللوى المهرية النجب","https://www.aldiwan.net/poem51984.html","البسيط"],[197,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[208,"ما في الديار مجاوب والنبي باطي","https://www.aldiwan.net/poem13435.html","المواليا"],[223,"أقريب من دنف غده","https://www.aldiwan.net/poem55170.html","المتدارك"],[227,"كم بدير القصير لي من بكور","https://www.aldiwan.net/poem51009.html","الخفيف"],[248,"أيهذا الأمير قد أشكل المعنى","https://www.aldiwan.net/poem15043.html","الخفيف"],[257,"عند قطب التصريف طولا وعرضا","https://www.aldiwan.net/poem35966.html","الخفيف"],[269,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[280,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[280,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[295,"أدر المدامة بالكبير","https://www.aldiwan.net/poem33264.html","مجزوء الكامل"],[303,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[326,"أمل لا يزال فوق المرام","https://www.aldiwan.net/poem54962.html","الخفيف"],[347,"كم صرعت من أسد العرين","https://www.aldiwan.net/poem15976.html","الرجز"],[359,"ان وجدي كل يوم في ازدياد","https://www.aldiwan.net/poem68123.html","الرمل"],[362,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[364,"هذا عذاب لا يفتر","https://www.aldiwan.net/poem16991.html","مجزوء الكامل"],[369,"طرفان طرف مساعد","https://www.aldiwan.net/poem57475.html","مجزوء الكامل"],[390,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[397,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[402,"من جعل الصبر في مقاصده","https://www.aldiwan.net/poem49481.html","المنسرح"],[406,"لا تجزعن لخطب","https://www.aldiwan.net/poem32156.html","المجتث"],[429,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[429,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[429,"شق الكمال عليه جيب سواده","https://www.aldiwan.net/poem12595.html","الكامل"],[434,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[456,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[456,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[462,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[462,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[462,"ما نال من وصلكم بعض الذي وجبا","https://www.aldiwan.net/poem3498.html","عموديه"],[462,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[512,"كم صاحب لوفد رحولك تدور رحاه","https://www.aldiwan.net/poem20935.html","المواليا"],[513,"إن كنت أزمعت على المسير","https://www.aldiwan.net/poem12128.html","الرجز"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[556,"كم صورة في قطعة الشمع","https://www.aldiwan.net/poem34374.html","السريع"],[573,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"]],"verses":[["كَم صَبرُ خافي الشَخصِ مُستَجِنِّ","مُنطَمِرٍ مِنَ الأَذى في سِجنِ",0,"ن",1,0],["كَم صَبَغَ الدَهرُ قَميصَ الثَرى","وَعادَ رِقُّ الأَرضِ ضاحي الوُشوم",1,"م",1,0],["كَم صامِتٍ مُتَوَقِّعٍ","أَنّى يَعِنُّ لَهُ المَقالُ",2,"ل",1,0],["كمْ صُنْتُ جوْهرَهُ بالجَهْدِ فانتُهِبَتْ","وكيفَ والأمرُ حقٌّ إنْ نظَرْتَ وَفِي",3,"ي",1,0],["كَم صَكَّ مَسمَعَنا بِجَندَلِ لَفظِهِ","وَأَطالَ مِحنَتَنا بِطولِ لِسانِهِ",4,"ن",2,0],["كم صورةٍ لك في الفتوح وسورةٍ","تُجلى وتُتلى بكرة وأصيلا",5,"ل",2,0],["كَم صاحِبٍ لَم أَغنَ عَن إِنصافِهِ","في عُسرِهِ وَغَنيتُ عَن إِحسانِهِ",6,"ه",1,0],["كمْ صافحت من راحتيهِ يد امرئ","عشراً وصبحه الهناءُ فعيَّدا",7,"د",2,0],["كم صار مثل دبيب النمل لي كلمٌ","من الهوان صغيراً بين أقراني",8,"ي",1,1],["كم صرعةٍ بين العبي","دِ وخَلْوةٍ لك مُسْترابهْ",9,"ب",2,0],["كَم صَليب من الصفا آيستْهُ","عُقبُ الدهر أيما تأييس",10,"س",1,0],["كمصباحِ الكرام بني بويبٍ","أبى حسنٍ لشانئهِ الهُبولُ",11,"ل",1,0],["كَم صَيحَةٍ لِلدَهرِ في آذانِنا","مَرَّت كَما مَرَّت عَلى أَرماسِ",12,"س",1,0],["كم صاحب لبدور الأرض فارقهم","لم يحص من حشرات الأرض ما صحبا",13,"ب",2,0],["كَم صَعَّبَ اليَومُ مِن سَهلٍ هَمَمتَ بِهِ","وَسَهَّلَ الغَدُ في الأَشياءِ ما صَعُبا",14,"ب",2,0],["كَم صَريحٍ إِلَيهِ غَشَّت بَياضاً","أَوجُهِ المَكرُماتِ سودُ أُسودِه",15,"د",2,0],["كَم صَديقٍ عَرَفتُهُ بِصَديقٍ","صارَ أَحظى مِنَ الصَديقِ العَتيقِ",16,"ق",1,1],["كَم صَحيحٍ قَدِ اِدَّعى السُقمَ فيهِ","وَعَليلٍ لَيلَهُ يَنيكُ قِياما",17,"م",2,0],["كَمُصَلصِلٍ يَعدو عَلى بَيدانَةٍ","حَقباءَ مِن حُمُرِ القَنانِ مُشَرَّدِ",18,"د",1,0],["كَم صَديقٍ يُقَصِّرُ السَعيَ تَخفي","فاً بِقَصدٍ وَكَم عَدُوٍّ يَزورُ",19,"ر",1,0],["كَم صِيامٍ قَرَنتَهُ بِقِيامٍ","وَصَلاةٍ وَصَلتَها بِصِلاتِ",20,"ت",1,0],["كم صِحتُ إذا أبصرت هذا الجهاد","وميسم الذلة فوق الجباه",21,"ه",1,0],["كم صحت والعين تذري الدمع في أسف","على الجواهر في كف الردى العادي",22,"د",2,0],["كَمْ صَديقٍ بكاكَ مثلي بدَمعٍ","طائعٍ من شؤونه لا عصيِّ",23,"ي",1,0],["كَم صامِتٍ صامِتِيِّ الضَربِ فُزتُ بِهِ","مِنهُ وَحَليٍ مِنَ المَعروفِ حَلّاني",24,"ي",1,0],["كَم صارِمٍ عَضبٍ أَنافَ عَلى فَتىً","مِنهُم لِأَعباءِ الوَغى حَمّالِ",25,"ل",1,0],["كم صريعٍ لكِ في أشلائِه","مَصرعُ القُربَى وأشلاءُ الرَّحِمْ",26,"م",1,0],["كَم صَنيعٍ شَكَرتُهُ لِبَني وَه","بٍ بَدا لي وَما اِهتَدَيتُ إِلَيهِ",27,"ي",2,1],["كَم صاحِبٍ قَد كانَ لي وامِقاً","إِذ كانَ في حالاتِ إِفلاسِ",28,"س",1,0],["كَمِصباحِ لَيلٍ بَدا يَستَنيرُ","ثُمَّ تَناقَصَ حَتّى خَمَد",29,"د",1,0],["كَم صاحِبٍ يَتَمَنّى لَو نُعيتُ لَهُ","وَإِن تَشَكَّيتُ راعاني وَفَدّاني",30,"ي",1,0],["كَم صَرَفَ المَولودُ عَن والِدٍ","خَيراً وَكَم أُمٍّ لَهُ لَم يَمُن",31,"ن",1,1],["كم صائنٍ عن قُبْلَةٍ خدَّهُ","سُلّطَتِ الأرْضُ على خَدّهِ",32,"د",2,0],["كم صُدوداً عساكَ ترْحَمُ شكْوا","يَ ولو باسْتِمَاعِ قولي عساكا",33,"ك",2,0],["كَم صَريعٍ مِن صَدمَةٍ أَو صَريعٍ","مِن سُمومٍ مُخَدَّرِ الأَوصالِ",34,"ل",1,0],["كَمْ صَانَ عِرْضاً طَاهِراً مِنْ رِيبَةٍ","وَنَفَى أَذى عَنْ عَاثِرٍ مَنكودِ",35,"د",1,0],["كمْ صَائِدٍ صَادَ مَا يُرْدِيهِ مَأْكَلُهُ","وَصَارِعٍ بَاتَ حَقّاً وَهْوَ مَصْرُوعُ",36,"ع",1,0],["كَمْ صُغْتَ آيَةَ وَحْيٍ","يُعِيدُهَا النَّاسُ شِعْرَا",37,"ر",2,0],["كم صاحب أحرقت نفسك دونه","فهوى عليك بقسوة الوقاد",38,"د",1,0],["كم صنَعْنَا مِنْ عقُولٍ ورجَالْ للَوطنْ","عُرِفُوا بالنبلِ فيمن عُرِفَا",39,"ف",2,0],["كم صابروا عَنَتَ الحياةِ وعُسْرَها","بخلائقٍ غُرِّ الوجوهِ صِباح",40,"ح",1,0],["كم صبرنا على الخطُوبِ كرامًا","واعتصمنا عند الطَّوى بالإباء",41,"ا",2,0],["كم صانعٍ بالقارِ خُضِّبَ ثوبُه","فعددتُ هذا القارَ خيرَ وشاحِ",42,"ح",1,0],["كم صِبغَ من قطَراته","للمترَف الدرُّ النَّضيد!",43,"د",1,0],["كم صديقٍ من وَجهه يقطر البشْ","ر، ولا يأمَنُ الصَّديقُ غيابه",44,"ب",2,0],["كم صدَّعُونا بأقوال مُهَلْهلَةِ","ليست بشعرٍ؛ ولا نثرٍ، ولا زَجَل!",45,"ل",1,0],["كم صرّفتنا يدٌ كنا نُصرّفها","وبات يحكمنا شعب ملكناه",46,"ا",2,0],["كَم صَحيحٍ قد ادّعى السّقمَ فيهِ،","وَعَليلٍ قَد ادّعَى البِرْسَامَا",47,"م",2,0],["كَم صُغت فيكَ مِن القَريض فَرائِداً","هِيَ في نُحور المُكرَمات عُقودُ",48,"د",1,0],["كم صد عفريت نفس عن تهجمه","وفي النفوس كما تدري عفاريت",49,"ت",1,0],["كم صريعٍ لم يرشف الكأس يوماً","صرعته كأس الهوى