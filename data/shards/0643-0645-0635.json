/ViewPoem.aspx?id=34871",""],[5002,"على متن الخيال...","https://www.poetsgate.com/ViewPoem.aspx?id=202663",""],[5002,"صرخة الأوطان.....","https://www.poetsgate.com/ViewPoem.aspx?id=205192",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[585,"يا صارخاً أجفلت من صوته الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=161844",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5092,"مرّةً لو نلتقي","https://www.poetsgate.com/ViewPoem.aspx?id=176222",""],[5186,"لا خير في الشكوى وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156478",""],[5198,"ليل داجي","https://www.poetsgate.com/ViewPoem.aspx?id=136228",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5259,"ضاءت بنور غيابك الأيامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186807",""],[5284,"غيث الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=191798",""],[308,"قل لي مَا شَيْء إِذا رمت إِن","https://www.poetsgate.com/ViewPoem.aspx?id=189406",""],[307,"مرآة الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=215293",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5431,"رحماك يارب السماء","https://www.poetsgate.com/ViewPoem.aspx?id=185254",""],[5431,"هل يرتوي الدهر من دمع المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=193388",""],[5431,"لاتقنطوا ....","https://www.poetsgate.com/ViewPoem.aspx?id=201584",""],[5459,"أخرستُ أصواتي ..","https://www.poetsgate.com/ViewPoem.aspx?id=202213",""],[5695,"براءة ووفاء..","https://www.poetsgate.com/ViewPoem.aspx?id=212553",""],[5704,"على موانىء الرحيل ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204262",""],[5736,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=208501",""],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""],[5823,"درب الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=59186",""],[5829,"صبوة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=148226",""],[5830,"سَلِي العُرُوبَةَ","https://www.poetsgate.com/ViewPoem.aspx?id=200822",""],[5916,"أيُّهَا الْسَارِحُ","https://www.poetsgate.com/ViewPoem.aspx?id=190588",""],[5956,"أرجو بقايَ لأجل زوجي الصابرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183732",""],[5956,"أ تُصَدِّقون محبة استعماركم؟","https://www.poetsgate.com/ViewPoem.aspx?id=192046",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[5970,"كم صديق أنا أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=130608",""],[161,"ننتظر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=163041",""],[6082,"قفْ عند حَدّك","https://www.poetsgate.com/ViewPoem.aspx?id=180123",""],[6093,"لا يَنحني إلا ليلتقطَ الفصولْ","https://www.poetsgate.com/ViewPoem.aspx?id=203946",""],[6097,"الباب يشهد...","https://www.poetsgate.com/ViewPoem.aspx?id=192045",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[6277,"حبّ الزعامات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64469&r=&rc=32",""]],"verses":[["كَم صَبرُ خافي الشَخصِ مُستَجِنِّ","مُنطَمِرٍ مِنَ الأَذى في سِجنِ",0,"ن",1,0],["كَم صَبَغَ الدَهرُ قَميصَ الثَرى","وَعادَ رِقُّ الأَرضِ ضاحي الوُشوم",1,"م",1,0],["كَم صامِتٍ مُتَوَقِّعٍ","أَنّى يَعِنُّ لَهُ المَقالُ",2,"ل",1,0],["كمْ صُنْتُ جوْهرَهُ بالجَهْدِ فانتُهِبَتْ","وكيفَ والأمرُ حقٌّ إنْ نظَرْتَ وَفِي",3,"ف",2,0],["كَم صَكَّ مَسمَعَنا بِجَندَلِ لَفظِهِ","وَأَطالَ مِحنَتَنا بِطولِ لِسانِهِ",4,"ن",2,0],["كم صورةٍ لك في الفتوح وسورةٍ","تُجلى وتُتلى بكرة وأصيلا",5,"ل",2,0],["كَم صاحِبٍ لَم أَغنَ عَن إِنصافِهِ","في عُسرِهِ وَغَنيتُ عَن إِحسانِهِ",6,"ه",1,0],["كمْ صافحت من راحتيهِ يد امرئ","عشراً وصبحه الهناءُ فعيَّدا",7,"د",2,0],["كم صار مثل دبيب النمل لي كلمٌ","من الهوان صغيراً بين أقراني",8,"ي",1,1],["كم صرعةٍ بين العبي","دِ وخَلْوةٍ لك مُسْترابهْ",9,"ب",2,0],["كَم صَليب من الصفا آيستْهُ","عُقبُ الدهر أيما تأييس",10,"س",1,0],["كمصباحِ الكرام بني بويبٍ","أبى حسنٍ لشانئهِ الهُبولُ",11,"ل",1,0],["كَم صَيحَةٍ لِلدَهرِ في آذانِنا","مَرَّت كَما مَرَّت عَلى أَرماسِ",12,"س",1,0],["كم صاحب لبدور الأرض فارقهم","لم يحص من حشرات الأرض ما صحبا",13,"ب",2,0],["كَم صَعَّبَ اليَومُ مِن سَهلٍ هَمَمتَ بِهِ","وَسَهَّلَ الغَدُ في الأَشياءِ ما صَعُبا",14,"ب",2,0],["كَم صَريحٍ إِلَيهِ غَشَّت بَياضاً","أَوجُهِ المَكرُماتِ سودُ أُسودِه",15,"د",2,0],["كَم صَديقٍ عَرَفتُهُ بِصَديقٍ","صارَ أَحظى مِنَ الصَديقِ العَتيقِ",16,"ق",1,1],["كَم صَحيحٍ قَدِ اِدَّعى السُقمَ فيهِ","وَعَليلٍ لَيلَهُ يَنيكُ قِياما",17,"م",2,0],["كَمُصَلصِلٍ يَعدو عَلى بَيدانَةٍ","حَقباءَ مِن حُمُرِ القَنانِ مُشَرَّدِ",18,"د",1,0],["كَم صَديقٍ يُقَصِّرُ السَعيَ تَخفي","فاً بِقَصدٍ وَكَم عَدُوٍّ يَزورُ",19,"ر",1,0],["كَم صِيامٍ قَرَنتَهُ بِقِيامٍ","وَصَلاةٍ وَصَلتَها بِصِلاتِ",20,"ت",1,0],["كم صِحتُ إذا أبصرت هذا الجهاد","وميسم الذلة فوق الجباه",21,"ه",1,0],["كم صحت والعين تذري الدمع في أسف","على الجواهر في كف الردى العادي",22,"د",2,0],["كَمْ صَديقٍ بكاكَ مثلي بدَمعٍ","طائعٍ من شؤونه لا عصيِّ",23,"ي",1,0],["كَم صامِتٍ صامِتِيِّ الضَربِ فُزتُ بِهِ","مِنهُ وَحَليٍ مِنَ المَعروفِ حَلّاني",24,"ن",2,0],["كَم صارِمٍ عَضبٍ أَنافَ عَلى فَتىً","مِنهُم لِأَعباءِ الوَغى حَمّالِ",25,"ل",1,0],["كم صريعٍ لكِ في أشلائِه","مَصرعُ القُربَى وأشلاءُ الرَّحِمْ",26,"م",1,0],["كَم صَنيعٍ شَكَرتُهُ لِبَني وَه","بٍ بَدا لي وَما اِهتَدَيتُ إِلَيهِ",27,"ي",2,1],["كَم صاحِبٍ قَد كانَ لي وامِقاً","إِذ كانَ في حالاتِ إِفلاسِ",28,"س",1,0],["كَمِصباحِ لَيلٍ بَدا يَستَنيرُ","ثُمَّ تَناقَصَ حَتّى خَمَد",29,"د",1,0],["كَم صاحِبٍ يَتَمَنّى لَو نُعيتُ لَهُ","وَإِن تَشَكَّيتُ راعاني وَفَدّاني",30,"ن",2,0],["كَم صَرَفَ المَولودُ عَن والِدٍ","خَيراً وَكَم أُمٍّ لَهُ لَم يَمُن",31,"ن",1,1],["كم صائنٍ عن قُبْلَةٍ خدَّهُ","سُلّطَتِ الأرْضُ على خَدّهِ",32,"د",2,0],["كم صُدوداً عساكَ ترْحَمُ شكْوا","يَ ولو باسْتِمَاعِ قولي عساكا",33,"ك",2,0],["كم صرفتنا يد كنا نصرفها","وبات يحكمنا شعب ملكناه",34,"ا",2,0],["كَم صَريعٍ مِن صَدمَةٍ أَو صَريعٍ","مِن سُمومٍ مُخَدَّرِ الأَوصالِ",35,"ل",1,0],["كَمْ صَانَ عِرْضاً طَاهِراً مِنْ رِيبَةٍ","وَنَفَى أَذى عَنْ عَاثِرٍ مَنكودِ",36,"د",1,0],["كمْ صَائِدٍ صَادَ مَا يُرْدِيهِ مَأْكَلُهُ","وَصَارِعٍ بَاتَ حَقّاً وَهْوَ مَصْرُوعُ",37,"ع",1,0],["كَمْ صُغْتَ آيَةَ وَحْيٍ","يُعِيدُهَا النَّاسُ شِعْرَا",38,"ر",2,0],["كم صاحب أحرقت نفسك دونه","فهوى عليك بقسوة الوقاد",39,"د",1,0],["كم صنَعْنَا مِنْ عقُولٍ ورجَالْ للَوطنْ","عُرِفُوا بالنبلِ فيمن عُرِفَا",40,"ف",2,0],["كم صابروا عَنَتَ الحياةِ وعُسْرَها","بخلائقٍ غُرِّ الوجوهِ صِباح",41,"ح",1,0],["كم صبرنا على الخطُوبِ كرامًا","واعتصمنا عند الطَّوى بالإباء",42,"ا",2,0],["كم صانعٍ بالقارِ خُضِّبَ ثوبُه","فعددتُ هذا القارَ خيرَ وشاحِ",43,"ح",1,0],["كم صِبغَ من قطَراته","للمترَف الدرُّ النَّضيد!",44,"د",1,0],["كم صديقٍ من وَجهه يقطر البشْ","ر، ولا يأمَنُ الصَّديقُ غيابه",45,"ب",2,0],["كم صدَّعُونا بأقوال مُهَلْهلَةِ","ليست بشعرٍ؛ ولا نثرٍ، ولا زَجَل!",46,"ل",1,0],["كم صارعت عنت الخطوب وما مضت","من ظالم إلاّ تلقّت أظلما",47,"م",2,0],["كَم صَحيحٍ قد ادّعى السّقمَ فيهِ،","وَعَليلٍ قَد ادّعَى البِرْسَامَا",48,"م",2,0],["كم صَعْبةٌ أنتِ .. تَصْويراً وتَهْجِيَةً","إذا لَمَسْتُكِ ، يبكي في يدي الحَجَرُ",49,"ر",1,0],["كَم صُغت فيكَ مِن القَريض فَرائِداً","هِيَ في نُحور المُكرَمات عُقودُ",50,"د",1,0],["كم صد عفريت نفس عن تهجمه","وفي النفوس كما تدري عفاريت",51,"ت",1,0],["كم صريعٍ لم يرشف الكأس يوماً","صرعته كأس الهوى السفاح",52,"ح",1,0],["كم صابروا كم كابروا كم غادروا","أعتى أعاديهم كعصف مؤكل",53,"ل",1,0],["كَمْ صَلاةٍ عَلَى فَتىً ماتَ سُكْراً","قَدْ أُقِيمَتْ فِينا بِغَيْرِ أَذَانِ",54,"ن",1,0],["كَمْ صَباحٍ صَبَّحْتُهُ بِصَبُوحٍ","وَمَساءٍ مَسَّيْتُهُ بِغَبُوقِ",55,"ق",1,0],["كم صادق في الود لو قطعته","ما صدر وهو بالجفا يعذب",56,"ب",1,0],["كَم صَكَّ بِالسَيفِ وَالأَبطالُ جائِلَةٌ","مِن مُعلَمٍ في نَدِيِّ الحَيِّ كَالعَلَمِ",57,"م",1,0],["كم صارعتْ من قُوىَ خَطْبٍ فما وَهَنتْ","وصارعتْ من سَنا صعب فلم تَخِم",58,"م",1,0],["كم صاحب صاحبته في التقى","أسكنته مسكن أنفاسي",59,"س",2,1],["كم صريع بات في كمد","قد شجي بالغيظ من ولده",60,"د",2,0],["كم صرَّفَ الجيشَ منهم قادةٌ فُهُمٌ","وأحرزَ المجدَ منهم سادةٌ نُجُبُ",61,"ب",1,0],["كم صرعنَ من أسدٍ","حينَ غالبوا غلبوا",62,"ب",3,0],["كم صحت في الحي اسما اين هي باحي","أجابني الحي السما النها يا حي",63,"ي",1,0],["كم صُغتُ التَبرَ له شَركاً","وَقَضَيتُ اللَيلَ أُنضِدهُ",64,"د",2,0],["كم صبوحٍ شَدَدْته بغَبوقٍ","وظلامٍ وصلتُه بنهارِ",65,"ر",1,0],["كم صدورٍ مُصَفَّفَات وكم من","شَبَكٍ دونها وكم من صَوَاني",66,"ن",2,0],["كَم صِلاتٍ مِنَ العَوائِدِ فيهِ","أَورَدَتهُ مِن مَورِدِ الفَضلِ حَوضا",67,"ض",2,0],["كَم صبا قَلبي بها وَلَها","كَما أَذابَت مهجَتيولها",68,"ه",2,0],["كَم صادَ أَصيَدَ قَسراً فَهوَ عانيهِ","يَبكي عَلى مَلكٍ وافاهُ ناعيهِ",69,"ي",2,0],["كَم صاحِبٍ حاصِبٍ لي غَيرَ مُتَّئِبٍ","فَالخِلُّ كَالخَلِّ وَالإِخوانُ خُوّانُ",70,"ن",1,0],["كَم صاغ مِن مِننٍ له","أَضحَت قَلائدَ للنُحورِ",71,"ر",1,0],["كَم صائلٍ يَستخفّ الشرع صيّرهُ","مُفلّلَ النابِ مقلومَ الأظافيرِ",72,"ر",1,0],["كم صديق محّضته الودّ صرفا","كان أقسى عليّ من أيّامي",73,"م",2,0],["كَمَ صَرَعتُ مِن أُسُدِ العِرينِ","عَينُ المَهى بِأَسهُمِ العُيونِ",74,"ن",1,1],["كَم صَرفت القَلب عَن عِشقته","وَتَجلدت وَلكِن ما أَفاد",75,"د",1,0],["كم صافحَتْ كفُّه من مَرّة لك يا","كفَّ الثُّريّا وإنْ لم تَرضَ علْياك",76,"ك",1,0],["كَم صامَ قَلبٌ عَن ذُنو","بٍ ثُمَّ لاحَ لَهُ فَأَفطَر",77,"ر",1,0],["كم صادرٍ عن جودِه","قوَّى عزيمةَ واردِ",78,"د",1,0],["كَم صارِمٍ جاءَهُ عَلى ظَمأٍ","فَحينَ جَدَّ القراعُ أَرواهُ",79,"ا",2,0],["كم صوابٍ في ظَنِّنا، لو رجعن","للموازين، ما رأينا صَوابا",80,"ب",2,0],["كمْ صدمَةٍ للزَّمان مُنْكَرَةٍ","لّما رأى الصَّبرَ صَدّ ما صدَما",81,"م",2,0],["كم صابَرَ الدهرَ قومٌ","فأدركوا ما أحَبَّوا",82,"ب",3,0],["كم صارخِ مِنَّا ومُلْتَطِمٍ","في زاخِرٍ منه ومُلْتَطِمِ",83,"م",1,0],["كم صِبْغُ همٍّ بسناهُ ماضِ","نَضا عليه سيفَ حدٍّ ماضِ",84,"ض",1,0],["كم صارمٍ ملقًى بعاتقِ صارمٍ","بصُعودِه أو دافعٌ بصِعادِه",85,"د",2,0],["كم صارم ملقى بعاتق صارمٍ","أنخشى عليه ونجده ونجاده",85,"د",2,0],["كم صدّ عنّي ودارهُ صدد","منّي فراحَ الفؤادُ في كربِه",86,"ب",2,0],["كم صاحبٍ والنارُ لي في قلبه","خالبتُ بارقَ وجهه المتَهلّلا",87,"ل",2,0],["كم صاحبٍ بالأمس صادفَ بِطنةً","فترتْ به لما رآني مخمَصا",88,"ص",2,0],["كم صينَ من عقدٍ نفيسٍ قدره","ضنَّا وأغمد عزهً من مُرهف",89,"ف",1,0],["كم صدرِ أفقِ شققنهُ عن دجى ال","ليل وصبحٍ جلون تحت حلك",90,"ك",1,0],["كم صنت نفسي فلما أن عرفتكمُ","بذلتها للهوى والبينِ محتسبا",91,"ب",2,0],["كم صبوةٍ عطفتك عنها سلوةٌ","وتقول لستُ أعودُ ثمَّ تعود",92,"د",1,0],["كم صاحب لوفد رحولك تدور رحاه","سوّاك مثل الطحين وعلك برحاه",93,"ه",1,1],["كمصحف يقرن بالطنبور","وصاهل يعرض في الحمير",94,"ر",1,0],["كم صادنا ثَمَّ فصِرْنا رِقَّهُ","مِنْ شَعَرٍ جعدٍ وَمِن وَجهٍ حَسَنْ",95,"ن",1,0],["كم صعبةٍ ركبتها معضلةٍ","تُطعمها الريثَ إذا أكدَى العَجَلْ",96,"ل",1,0],["كَم صائِلٍ في ذَرا تَمهيدِ مَملَكَةٍ","لَولا يَزيدُ بَني شَيبانَ لَم يَصُلِ",97,"ل",1,0],["كم صفقة ريحت باعوا الكماة بها","تحل ما ألغزوه يوم حر بهم",98,"م",1,0],["كم صورة في قطعة الشمعِ","مفيدةٍ للفرق والجمعِ",99,"ع",1,1],["كم صادَ طيْفُكِ طرفي بعد هَجْعَتِهِ","فالجَفْنُ فَخّي والأَهْدَابُ أَشْرَاكِي",100,"ك",2,0],["كم صغير جبرته بعد يتم","وفقير نَعَشْتَهُ بعد عدمِ",101,"م",1,1],["كم صنته من عيون الحاسدين وما","علمت أن صروف الدهر تحدسني",102,"ن",2,0],["كَم صَيَّرَ الوَلهانَ مثلَ الخَيالْ","وَاِغتَصَب العشّاق كلّ المُهجْ",103,"ج",1,0],["كم صيَّرا منْ جُعلا رِزْقَه","يبعُر من يُبْسٍ كمثل البعيرْ",104,"ر",1,0],["كمْ صَدَّعُونَا بالوُعُودِ سَخِيِّةً","حتى لَمَسْنَا في السَما الأقمَارا",105,"ر",2,0],["كم صدَّني عنه فضول تشكي","وفمٌ بوصف ليس يبرح لاهج",106,"ج",1,0],["كم صنت وجه مؤمل","منا ببذلك للمكارم",107,"م",1,0],["كم صائل أفنى وكم حسن","أسنى وكم من عائلٍ أقنى",108,"ن",2,0],["كم صعرت للعدا حدودا","وصغّرت عندنا العظائم",109,"م",1,0],["كم صاح في عشّاقه طرفه","من لم أبت مسكره في وصاح",110,"ح",1,0],["كَم صارَ لي مِن هواها والنسيب بها","في الناسِ مِن نظمِ ديوانٍ وديوانِ",111,"ن",1,0],["كَم صاحب خَلصت سَرائره لَه","لَم يَنقلب مِنهُ بود صادق",112,"ق",1,0],["كَم صَدمة لَكَ فيهم مَشهورة","في قَفصة ريعت لَها الزوراء",113,"ا",2,0],["كم صاحب عرض الفداء له ولم","يرض القضاء فخاب ظن فداته",114,"ت",2,0],["كَم صَغير لَهُم خَلا عَن صِغار","وَكَبير لِكبر نَفسٍ وَباسِ",115,"س",1,0],["كمصطفى الفخر وناهيك به","في شرف