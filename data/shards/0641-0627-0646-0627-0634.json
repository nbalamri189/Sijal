{"poems":[[37,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[56,"أمطلب أنت مستعذب","https://www.aldiwan.net/poem27510.html","المتقارب"],[89,"ردي الكرى لأراك في أحلامه","https://www.aldiwan.net/poem8244.html","الكامل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[201,"أسفر الصبح قم نحيي الصباحا","https://www.aldiwan.net/poem39883.html","الخفيف"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[371,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[438,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[505,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70777","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136315","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113735","الطويل"],[2117,"","https://poetry.dctabudhabi.ae/diwan/poem/111331","الطويل"],[2135,"","https://poetry.dctabudhabi.ae/diwan/poem/203565","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27846","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137432",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122499","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99400","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89267","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127014","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141231","الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117186","الطويل"],[4881,"لوعة واعتلال","https://www.poetsgate.com/ViewPoem.aspx?id=187292",""],[5281,"احتراقُ الفَراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199734",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[5574,"عزائمنا","https://www.poetsgate.com/ViewPoem.aspx?id=206017",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَإِن أَشرَقَت مِنها بطونٌ وَأَبشَرَت","لَهُ إِذ ثَوى فيها مُقيماً رَهينا",0,"ن",2,0],["فَإِن أَشفِ مِنكَ تَكُن سُبَّةَ","وَإِن أَعفُ عَنكَ فَما تَعقِلُ",1,"ل",1,0],["فَإِنِ اشْتَبَهْتَ وَلَمْ تَجِدْ لَكَ هَادِياً","فَاسْمَعْ أَنِينَ الْقَلْبِ عِنْدَ خِيَامِهِ",2,"م",2,0],["فإِن أَشْكُ ما بِي للأَميرِ فإنّه","لَيَعْلَمُ مِنهُ ما أُسِرُّ وأَجْهَرُ",3,"ر",1,0],["فَإِن أَشْكَتِ الأيّامُ تُلقِ قِيادَها","إليه وتَجفُ مَن جَفَاهُ وتَهجُرُ",3,"ر",1,0],["فإن أشدُ بالمجدِ الذي شِدْتَ ركنَهُ","فما هو إلَّا ركن قومي وسودَدي",4,"د",2,0],["فإنّا شعوبٌ من سُلالة آدم","لنا في مراقي العلم والفن سُلّمُ",5,"م",1,0],["فأنا شاعرٌ خلقت لأشقى","لا لألقى سعادةً وفلاحا",6,"ح",2,0],["فإن أَشار ناصحا","بالخَير كانَ صالحا",7,"ح",2,0],["فَإِن أَشكُ داراً جاوَرَتني بِظالِمِ","ظَلَمتُ وَكُنتُ الظالِمَ المُتَظَلِّما",8,"م",2,0],["فإِن أَشبعته وخلاكَ ذَمٌّ","فكَمْ أَشْبَعْتَ من أُمَمِ جِياعِ",9,"ع",1,0],["فإِنْ أَشْفِ وَجدي من تباريحِ ظِلْمِهِ","بِضَمِّي لَهُ أَيقَنْتَ أَنِّيَ ظالِمُ",10,"م",1,0],["فإنْ أشرَحِ البَلوى تَهاجَمَ عُذَّلي","وإنْ أَكتُمِ البَلوى تعَجَّبَ عُذَّالي",11,"ل",2,0],["فإن أشهرَ من هاتيكَ لو نظرتْ","عيونكم نورَ أهل المجدِ والكرم",12,"م",1,0],["فان اشهدتك الكائنات رسومها","فبالغ بكل الهم في محو ذا الرسم",13,"م",1,0],["فإن اشتياقي نحوكم زاد عَزمُهُ","وأغلَبُ ظني أنني اليومَ زائرُ",14,"ر",1,0],["فان اشتغالي بالعلوم ولا أرى","سواها لنا ذخرا فنعم الذخائر",15,"ر",1,0],["فإن اشتقت منه طيب ثنايا","ه أقبل مواضع العض فيها",16,"ه",2,0],["فإن أشركت نفسي فلم يك غيرها","وإن وجدتْ كانت على مركبٍ وعر",17,"ر",1,0],["فإن اشتياقي نحو رؤيا جماله","كثير وصبرى حين غاب قليل",18,"ل",1,0],["فإِنَّ اشتِيَاقِي من عَمِيدِ بَلاَبِلٍ","لمَجرَى بنانِ الشيخ ذرِّيَةِ الدَّنَا",19,"ن",2,0],["فإن أشعّة الآمال تحكي","نضالاً واخزات للقلوب",20,"ب",1,0],["فإن أشعر فما هو من رجالي","وإن يصفع فما أنا من رجاله",21,"ل",2,0],["فإن أشرعت نحوهم العوالي","تقول لك المعالي خلِّ عنكا",22,"ك",2,0],["فإن أشأموا وخداً فإني مشئم","وان أعرقوا وجدا بهم أنا معرق",23,"ق",1,0],["فإن أشار ناصاً","بالخير كان صالحا",24,"ح",2,0],["فَإِن أَشرَقَتِ فِيهِ الغَزَالَةُ خِلتَهَا","كَعَينٍ بجَِوفِ البَحرِ تَقذِفُ عَسجَدَا",25,"د",2,0],["فإن أشكُ من ليلي بجُرجانَ طولَهُ","فقد كنتُ أشكو منهُ بالبصرةِ القِصَر",26,"ر",1,0],["فأنا شاعرٌ تهزُّ كياني","نسْمةٌ عِطْرُها الهوى والجَمالُ/",27,"ل",1,0],["فإنْ أَشكُو فللنَّجوَى شكاتي","وإنْ أمضِي يُغالِطني الطَّريقُ",28,"ق",1,0],["فإن أشد بل أولى وأحرى","ركوب للمحارم حين لام",29,"م",1,0],["٣- فإنْ أشرقتْ روحي، فإنَّ خيولَها","على سفْحِ شمسي تمتطيها الملاحمُ",30,"م",1,0],["فإن أشر الخلق من كان ناقصا","ومن هو بالتقصير يلقى ويكدر",31,"ر",1,0],["فإن أشارَ بالبعد ذاك لبُعده","وإن أشار بالقرب فاعتبرهُ أهلا",32,"ل",2,0]]}