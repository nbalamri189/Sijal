oWhat=shqas&qid=18785&r=&rc=48",""],[4,"قَضِّ اللُّبانَة َ لا أبَا لكَ واذْهَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10908&r=&rc=4",""]],"verses":[["فَاِجسُر عَلى الأَهوالِ إِن كُنتَ رَجُل","وَنَل بِأَطرافِ القَنا ما لَم يُنَل",0,"ل",1,0],["فَاِجعَلِ الآنَ ما سَأَلتُكَ بِرّاً","إِنَّما البِرُّ مَنزِلٌ مَألوفُ",1,"ف",1,0],["فَأَجهَرُ بِالوَلاءِ وَلا أُوَرّي","وَأَنطِقُ بِالبَراءِ وَلا أُحابي",2,"ب",2,0],["فاجْذِبْ بضَبْعي ففي الأحرارِ مُصطَنَعٌ","وحِلْيَةُ السّيّدِ المَتْبوعِ تابِعُهُ",3,"ع",2,0],["فأجْزَلُها بَرْدٌ عليْكَ مُسَهَّمٌ","وأسْهَلُها عِقْدٌ لدَيْكَ مُفَصَّلُ",4,"ل",1,0],["فأجْرَرْتُهُ حَبْلَ المُنى غيرَ أنّني","سَلَكْتُ بهِ نَهْجاً إِلى الغَيّ مَهْيَعا",5,"ع",2,0],["فَأَجَبتُها إِنَّ المَنِيَّةَ مَنهَلٌ","لا بُدَّ أَن أُسقى بِكَأسِ المَنهَلِ",6,"ل",1,0],["فَأَجابَني مُتَبَسِّماً لا يَرعَوي","هَيهاتَ تَضرِبُ في حَديدٍ بارِدِ",7,"د",1,0],["فَاِجعَل لِنَفسِكَ مِنهُ حَظّاً وافِراً","وَاِهجُر لَهُ طيبَ الرُقادِ وَعَبسِ",8,"س",1,0],["فأجَبْتُهُمْ أنا والمُهيْمِنِ كارِهٌ","في خِدْمَةِ الموْلَى مُحِبٌّ فيهِ",9,"ه",1,0],["فأجَبْتُهُمْ شَدّوا الرّكائِبَ مَوْهِناً","وتحمّلوا الأقْمارَ تحْتَ هَزيعِ",10,"ع",1,0],["فَاجْلُ عَنْ نَفْسِكَ لاَ تَحْفِلْ بِهَا","حُجُبَ الْوَهمِ إِذَا مَا اعْتَرَضَتْ",11,"ت",1,0],["فَأجَبْتُهُ لَيْسَ التَّنَقُّل مَذْهَبِي","كَلاّ ولاَ حَثُّ الرَّكَائِبِ شَانيِ",12,"ن",2,0],["فأجِرْ في الوَرى الجَميلَ وعامِلْ","منْهُ كنْزَ الغِنَى ومَثْوَى الرَّباحِ",13,"ح",1,0],["فَأَجمَعتُ يَأساً لا لُبانَةَ بَعده","وَلَليأسُ أَدنى لِلعَفافِ مِنَ الطَمَع",14,"ع",1,0],["فَاِجعَلوا أَمواتَنا اليَومَ بِها","خَيرَ رَمزٍ لِرَجاءٍ مُنتَظَر",15,"ر",1,0],["فَاِجمَعوا كَيدَكُم وَروعوا حِماها","إِنَّ عِندَ العَرينِ أُسداً غِضابا",16,"ب",2,0],["فَاِجعَل شِعارَكَ رَحمَةً وَمَوَدَّةً","إِنَّ القُلوبَ مَعَ المَوَدَّةِ تُكسَبُ",17,"ب",1,0],["فَأَجابَتني بِصَوتٍ راعَني","وَأَرَتني الظَبيَ لَيثاً أَغلَبا",18,"ب",2,0],["فَأَجَبنَها وَعَجِبنَ كَيفَ تَجاهَلَت","هُوَ ذَلِكَ المُتَوَجِّعُ المُتَأَلِّمُ",19,"م",1,0],["فَأَجابوهُم فَتىً ذو مِرَّةٍ","مِن بَني مِصرٍ لَهُ فَضلٌ وَجود",20,"د",1,0],["فَاِجعَلوا حَفلَةَ الخَليلِ صَفاءً","بينَ مِصرٍ وَأُختِها وَسَلاما",21,"م",2,0],["فَأَجابَهُ المَرءُ اللَعينُ بِقَولِهِ","الحَقُّ لا يُسليكَ مِثلُ أَخيكا",22,"ك",2,0],["فَأَجفَلوا وَزَعيمُ القَومِ غايَةُ ما","يَرجو مِنَ اللَهِ أَن تَبقى لَهُ حَلَبُ",23,"ب",1,0],["فَأَجلى عُلوجَ الرومِ عَنها وَأُفرِحَت","قُلوبُ رِجالٍ حالَفَت بَعدَها الحُزنا",24,"ن",2,0],["فَأَجْمَعُوا أَمْرَهُمْ فِي السِّلْم وَاعْتَزَمُوا","نَقْضاً لِمَا أَبْرَمُوا فِي سَاحَةِ الرَّهَبِ",25,"ب",1,0],["فَاجَأْتَنِي بِالنَّأْيِ قَبْلَ أَوَانِهِ","هَلْ حُرْقَةٌ كَالنَّأْيِ قَبْلَ أَوَانِ",26,"ن",1,0],["فَاجْعَلُوهُ لِغَابِر الظُّلْمِ حَدَّا","وَاجْعَلُوهُ لِمَبْدَأِ العَدْلِ عَهْدَا",27,"د",2,0],["فَأَجَابَهُ وَبِهِ تَفَكُّرُ غَائِبٍ","عَنْ رُشْدِهِ وَلَهُ تَبصُّرُ مُلْهَمِ",28,"م",1,0],["فَأَجلَينَ عَن خَوفِ المَنِيَّةِ بَعدَما","دَنا دَنوَةَ المُنصاعِ غَير المُراجِعِ",29,"ع",1,0],["فَأَجفَلنَّ أَن يَعلونَ مَتناً يُثِرنَهُ","أَو الأَكمَ تَرفَضُّ الصُخورُ الكَوابِحُ",30,"ح",1,0],["فأجلت في الأزهار لحظ تعجّبي","ولفكرتي بصفاتهنّ مرور",31,"ر",1,0],["فاجمعوا الجيش في العراق ليرعى","ما به من طَريفكم والتَليد",32,"د",1,0],["فأجمِعوا الرأيَ فيما تعلمون به","ثم أعلموا بنشاط يُنكِر المللا",33,"ل",2,0],["فاجمعوا الشمل ناهضين فإنّ ال","كُفر في الدين عجزكم والخمول",34,"ل",1,0],["فاجرِ يا ماء إن جربتَ رويداً","بأناةٍ ومهلةٍ واتئاد",35,"د",1,0],["فَاِجمَع أَشِظَّتَها إِلى أَقتابِها","وَاِخرُج فَما لَكَ في الرِحالِ مَقيلُ",36,"ل",1,0],["فَأَجمادَ ذي رَقدٍ فَأَكنافَ ثادِقٍ","فَصارَةَ يوفي فَوقَها فَالأَعابِلا",37,"ل",2,0],["فَاِجتازَ مُنقَطَعَ الكَثيبِ كَأَنَّهُ","نِصعٌ جَلَتهُ الشَمسُ بَعدَ صِوانِ",38,"ن",1,0],["فَاِجمَع فِداءٌ لَكَ الوالِدانِ","لِما كُنتَ فينا بِخَيرٍ مُريدا",39,"د",2,0],["فاجل عني حالاً أرانيَ منها","كلَّ يومٍ في غارةٍ شعواء",40,"ا",2,0],["فأجبْتهم روحِي الفداءُ لمالكٍ","قد كانَ في هذا العروضِ هوَ السبب",41,"ب",1,0],["فاجْلب نظمي ونثري له","وأروي الصحيحين عن مدحه",42,"ح",2,0],["فأجعل النوم وردِي","في الليلِ والدَّمع وردَك",43,"ك",1,0],["فأجابها باللهِ ثمَّ رسولهِ","يستنجد المنبوذُ حين يلوذ",44,"ذ",1,0],["فاجْعل بإحسانكَ مفتاحه","وإنْ تعاصى فاقْلع السكّرَه",45,"ر",2,0],["فاجْعل له في الأنام شأد","بفرس سوقها بديع",46,"ع",1,0],["فأجبتها روحي فلا نِصفٌ لكم","إن لم يداركنا ولا ليَ درهم",47,"م",1,0],["فاجْتدِي أو فاجْتني أو فاجْتلي","وفتاةٍ أتمنَّى وصلها",48,"ه",2,0],["فَاِجتَمَعنا لِمَعانٍ","وَاِفتَرَقنا لَمَعانِ",49,"ن",1,0],["فَاجمَع الأَجزاء جَمعاً","مِن جُسومٍ نَيِّراتِ",50,"ت",1,0],["فاجعلي موضعَ التعجُّب من شَيْ","بِيَ عُجباً بفَرْعك الغِرْبيبِ",51,"ب",1,0],["فأجبتُه إذ قال ذا","كَ بخُطبةٍ فَصَلَتْ خطابهْ",52,"ب",2,0],["فأجابت بشرِّ حالٍ فقلنا","لِمْ فقالت من شهوة الزَّرْنَبَنْبِ",53,"ب",1,0],["فاجعل خِفارته ذَرا","ك فإنه نِعْم الخفيرُ",54,"ر",1,0],["فاجأ الناس خالداً وابنَ عشر","قد علاه يخوض بالأير جَعْرَهْ",55,"ه",1,0],["فاجأني الشيب على صبوةٍ","أيُّ يد في الغيِّ لم تَغمِس",56,"س",1,0],["فاجعل الموتَ مُستراحَك مني","فرجُ الموت دون رَوح الخلاص",57,"ص",1,0],["فأجابت بشرِّ حالٍ فقُلنا","لمْ فقالتْ خَتنتُ نفسي بِليطِ",58,"ط",1,0],["فأُجيبوا إجابة","لم تقع في المسامع",59,"ع",1,0],["فاجتنب الشر فهو مجتنب","واتبع الخير فهو متبع",60,"ع",1,0],["فأجره لي إن النفس قد ألفت","آثار كفيك والمعروف مألوف",61,"ف",1,0],["فاجعلهما حظي وعجِّلهما","وارض من المطل بما قد سبق",62,"ق",1,0],["فاجتدى نخلة قريباً جناها","قد أنافت على النخيل بسوقا",63,"ق",2,0],["فاجعلْ تصَفُّحكَ المديحَ تفرساً","في غيبِ ما تُسدِي غداً وتُنيلُ",64,"ل",1,0],["فاجتَلى هامَهم بسيفِ دهاءٍ","لم يزل قاطعاً بغير استلالِ",65,"ل",1,0],["فأجبتُها إني امرؤٌ هيامَةٌ","في كل وادٍ ما أُفيقُ هَماهِما",66,"م",2,0],["فاجمعْ همومَكَ في همٍّ تؤيِّدهُ","بالعزمِ إنَّ هُمومَ الفسلِ شذَّان",67,"ن",1,0],["فأجمُّوا الأيورَ طرفة عين","واتركوا فضل نُطفةٍ لجنين",68,"ن",1,0],["فَأَجَبتُها أَن ما لِجِسمِيَ أَنَّهُ","أَودى بَنِيَّ مِنَ البِلادِ فَوَدَّعوا",69,"ع",3,0],["فَأَجمَعَ الأَمرَ أُصلاً ثُمَّ أَورَدَها","وَلَيسَ ماءٌ بِشُربِ البَحرِ مَعدولُ",70,"ل",1,0],["فَأَجابَت مُحارِبٌ وَغَنِيٌّ","وَدَعا دونَ ذاكَ شِبراً سَلولا",71,"ل",2,0],["فَاِجذُبيني إِن يَكُن مِنِّيَ نَفعٌ لِلتُرابِ","فَاِجذُبيني إِن 