],[5720,"المعلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=200150",""],[5720,"كَأَنَّكَ الشَّمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=201280",""],[5720,"الوَعد","https://www.poetsgate.com/ViewPoem.aspx?id=207828",""],[5763,"تحية للمعلم","https://www.poetsgate.com/ViewPoem.aspx?id=27064",""],[5784,"ذكر الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=189817",""],[5818,"الكروش","https://www.poetsgate.com/ViewPoem.aspx?id=196499",""],[5827,"الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=208734",""],[5939,"هي كِبريائي عنكِ حالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=178588",""],[5956,"في قاع نفسي حبكم مرصودُ","https://www.poetsgate.com/ViewPoem.aspx?id=194626",""],[5956,"يا حُبَّنا الأعلى","https://www.poetsgate.com/ViewPoem.aspx?id=194669",""],[6032,"خلب الغرام جنانا","https://www.poetsgate.com/ViewPoem.aspx?id=181523",""],[6069,"يا من سلب الفؤاد أين العوض","https://www.poetsgate.com/ViewPoem.aspx?id=105679",""],[6070,"الشره","https://www.poetsgate.com/ViewPoem.aspx?id=188136",""],[6070,"الذنوب العارية","https://www.poetsgate.com/ViewPoem.aspx?id=188432",""],[6070,"المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=188466",""],[6115,"الشهره اللى تجي بالكذب ماهي لي","https://www.poetsgate.com/ViewPoem.aspx?id=180492",""],[6127,"اقرأ","https://www.poetsgate.com/ViewPoem.aspx?id=197852",""],[6133,"قولة أهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=33826",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[5190,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78337&r=&rc=50",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["يا مَنْ سُكوتي في هَواهُ تَفَكُّرٌ","فِي شأنِهِ وإذا نَطَقْتُ عَنَيْتُهُ",0,"ت",2,0],["يا من سجعت بمدحِه إذ لم أزل","بنداه ثمَّ ندى ذويه مطوَّقا",1,"ق",2,0],["يا من سريت إلى ذُرا أبوابه","سير الغريب إلى منازل أهله",2,"ل",2,0],["يا من سرت مدحي له فتزاحمت","في الخافقين قصائري وطوالي",3,"ل",2,0],["يا من سَمادُ قَراحهِ من أرضهِ","لا غيرها وغُلامهُ الحرَّاثُ",4,"ث",1,0],["يا منْ سكونُ النفس في تأميلهِ","وبلوغها المأمولَ في تأميلِهِ",5,"ل",2,1],["يا من سطا بهزيل لا حراك به","أَسْمِنه ثم انتقم منه إذا سمنا",6,"ن",2,0],["يا مَنسَكَ المَعروفِ أَحرَمَ مَنطِقي","زَمَناً وَقَد لَبّاكَ مِن ميقاتِهِ",7,"ت",2,0],["يا مَن سَلا عَن حَبيبٍ بَعدَ ميتَتِهِ","كَم بَعدَ مَوتِكَ أَيضاً عَنكَ مِن سالِ",8,"ل",1,0],["يا مَن سَلا عَن حَبيبٍ بَعدَ غَيبَتِهِ","كَم بَعدَ مَوتِكَ مِن ناسٍ وَمِن سالِ",9,"ل",1,0],["يا مَن سَمَحتُ لَها بِروحي في الهَوى","أَرخَصتِني وَعَلَيَّ ما أَغلاكِ",10,"ك",1,0],["يا مَنْ سبى شمسَ الضحى","بالنورِ ما قلبي حديدْ",11,"د",1,1],["يا مَنْ سبى بالنورِ شمسَ الضحى","قَلْبُ المعنَّى لم يكنْ بالحديدْ",12,"د",1,0],["يا مُنسِيَ المَأتَمِ أَشجانَهُم","لَمّا أَتاهُم في المُعَزّينا",13,"ن",2,1],["يَا مَنْ سَمَا بِنَفْسه كَمَا سَمَا","بِشَرَفِ المَحْتدِ وَالمِيلاَدِ",14,"د",1,0],["يا من سقانا كؤوس الهجر مترعة","بكى بساط الهوى لما طويناه",15,"ا",2,0],["يا من سكنتم في القلوب فرحبكم","فيها وآيات الغرام فسيح",16,"ح",1,0],["يا منْ سَقامُ جفونهِ","لسقامِ عاشقهِ طبيبُ",17,"ب",1,1],["يا مَنْ سَبا ريّاهُ عَرْفُ الصِّبا","وذرَّ من أزرارهِ شارِقُ",18,"ق",1,1],["يا من سعى لغناهُ","وعادَ بعدُ فقيرا",19,"ر",2,1],["يا من سبا الشعراء نمل عذاره","النجم يشهد لي بأني صدنف",20,"ف",1,1],["يا من سَقاني الجَمَّ من وُدِّه","هذا ودادي كلّه فاكرَع",21,"ع",1,0],["يا مَن سبي العُشّاق حُسنُهُ","لَمّا رَنا بِالغنجِ جَفنُه",22,"ن",2,1],["يا مَن سَجاياهُ تُضيءُ لِوَفدِهِ","فَتُخالُ في لَيلِ الحَوادِثِ أَنجُما",23,"م",2,0],["يا مَن سَهِرتُ مُفَكِّراً في مَدحِهِ","أَيَجوزُ أَن أُمسي لَدَيكَ مُذَمِّما",23,"م",2,0],["يا من سرى من مكة للمسجد ال","أَقصى عَلى ظهر البُراق المنجب",24,"ب",1,0],["يا مَنْ سُحرتَ بقوله هَلْ ذاك من","تأْثيرِ عينيها وأَنت جليسها",25,"س",3,0],["يا مَن سَبى حُسنَ الظّبا وَذوي الصبا","هبّ الصّبا مِن عَرفكم فَصبا الأرق",26,"ق",1,0],["يا مَن سَوابقُ أيّامي بحَضْرتِه","كانٍتِ لأوجُهِها أفعالُه غُرَرا",27,"ر",2,0],["يا مَنْ سريرتُه عَدْلٌ وسيرتُه","لكلِّ مُستَخْبِرٍ عنها ومُخْتَبِر",28,"ر",1,0],["يا مَن سَفَكتُ دِمائي في الدُموعِ لَهُ","وَالنَفسُ في زَفَراتٍ قَيَّدَت نَفسي",29,"س",2,1],["يا مَن سَحائِبُ جُودِه","بالجَودِ هاطِلةُ الغَمامَه",30,"م",2,1],["يا من سمَوتِ إلى العلياء صاعدةً","كالإبن نفساً وجسماً حين رقَّاكِ",31,"ك",1,1],["يا من سرت عنه سباق محامد","تجتاب بين دكادك ورمال",32,"ل",1,0],["يا منسي الناس آلاما لعلتهم","عوفيت واسلم كعيسى في سويدائي",33,"ي",1,0],["يا مَن سَجِيَّتُهُ النَدى","أَهوِن بِإرجافِ العِدا",34,"د",2,1],["يا من سَهِرْتُ لكُمْ بغَلْغَلَةِ الدُّجا","حتَّى من الفجرِ اسْتَفاضَ طُلُوعُهُ",35,"ع",2,0],["يا من سمَت بسَماء المَجدِ رُتبتُهُ","وصارَ ذِكرُهُ في الأفواهِ كالعَسَلِ",36,"ل",1,0],["يا مَنْ سَكِرتَ وليسَ السُّكْرُ عادتَهُ","بخَمْرةٍ لم يُفِقْ من سُكرِها أحَدُ",37,"د",1,0],["يا مَنْ سأَلتُ سَحَابَه رَيَّ الصَّدى","لما صَدِيتُ فَجاءَ بالطُّوفَانِ",38,"ن",1,0],["يا من سبى في الحسنِ عبلةَ عبدةً","رفْقاً عليَّ فليسَ قلبي عنترَا",39,"ر",2,0],["يا مَن سقتهُ المنايا خمرةً طفَحَت","من أجلها كلُّ قلبٍ باتَ سكرانا",40,"ن",2,0],["يا من سكنت القلب هذا جرحنا","سيشيب والأسقام في الأبدان",41,"ن",1,0],["يا مَن سُنَنٌ وَآثارٌ إِذا","تُلِيَت يَرى الأَعمى وَيَغنى المعدِمُ",42,"م",1,0],["يا مَن سُرِرتُ بِملكه وَعَلائه","اليَومَ أَعلَمُ أَن دَهري أَنصَفا",43,"ف",2,0],["يا من سمى عن جسم أو عن حجى","أو شرب ماء أو ذواق الطعام",44,"م",1,0],["يا من سرى مثل بدر عن لواحظنا","هلا سمعت لنا نوحا إليك سرى",45,"ر",2,0],["يا من سقت عشاقها","من خمرها تريقاها",46,"ه",2,0],["يا مَن سلافة خمرها من نورها","أَحرقت إِذ أَشرقت أَهرقت الدما",47,"م",2,0],["يا من سما فوق الكواكب مجده","فالنجم وان والسماك الأعزل",48,"ل",1,0],["يا من سَطا سَيفها الماضي على كَبدي","ما من خلاقي أن أشكُو إلى أحَدِ",49,"د",1,1],["يا مَنْ سَمتْ من صِيدِ كَهْلانٍ بهِ","هِمَمٌ وطالَتْ في العَلاء رُؤوسُ",50,"س",1,0],["يا مَن سَقاني من سلافَه نَثرِهِ","صِرفاً وغَنَّى شِعرُهُ تَغريدا",51,"د",2,0],["يا مَن سهر طرفه الشهي","وجار على جسمي النحيف",52,"ف",1,0],["يا من سقى أملي منه على ظمئي","أغرُّ ملآنُ حوضِ الجودِ مُتْرَعُه",53,"ع",2,0],["يا مَن سُيولُ العَطايا","هَتّانَةٌ مِن يَدَيهِ",54,"ه",1,1],["يا من سواه يخون العهد ابق على","من طبعه فيك حفظ العهد والذمم",55,"م",1,0],["يا من سما النجم مجداً في تفرده","فكان بين نجوم المجد كالقمر",56,"ر",1,1],["يا مَن سَرى شائِماً بَرقا لِغَيرهم","سَريت تخبط في عَشواء معتسفا",57,"ف",2,0],["يا من سكنتم في الفؤَاد ترَّفقوا","ولكم علينا منَّةٌ وتكرمُ",58,"م",1,0],["يا من سقاني الكؤوس سائغةً","وكأس أخلاقه غدا أسوغ",59,"غ",1,1],["يا من سجاياه كروض ناضر","طلعت باندية الفضائل انجما",60,"م",2,0],["يا من سموت الى العلاء به غدا","كل يقصر عن بلوغ مداكا",61,"ك",2,0],["يا من سعيتم لمحو الرق هل لكمو","في محو رقٍّ يقود الشعب كالشاء",62,"ا",2,0],["يا من سكنوا العذيب من أحشائي","تعذيبكم يا سادتي ما أعذب",63,"ب",1,0],["يا من سقمي بها وفرط الذلِ","يحلو ويذوب مثل ذوب النحلِ",64,"ل",1,0],["يا مَن سَما الجَوزاء عقد نطاقه","حَتّى أَنافَ عَلى قُرون المُشتَري",65,"ر",2,0],["يا مَن سَما مَجده نَجم السَما شَرَفاً","حَتّى رَقى صاعِداً في أَرفَع الدرج",66,"ج",1,0],["يا من سألت بقسمتي","عن ميت حظى فاسأل",67,"ل",1,0],["يا مَن سقَى مِن حَنْظَل عَسَلاً","أرَقْتَ في غيرِ طائلٍ عَسَلَكْ",68,"ك",1,1],["يا من سلانا ثم رام ودادنا","قَد فاتَ ما قد فات من اوقاتهِ",69,"ت",2,0],["يا مَن سَطا سيفُ لحظبها عَلى مهج","ماذا تُرى من عَذابِ الصَب تلقينا",70,"ن",2,0],["يا مِن سِوى حبهِ لَم نتخذ ابداً","راياً وَلَم نَعتَقِد غَيرَ الهَوى دينا",70,"ن",2,0],["يا مَن سلب نَوم عَيني طرفه النعاس","وعذّب القَلب ما بَينَ الرّجا وَالياس",71,"س",1,1],["يا من سلبت مني عقلاً","اسرته بالطرف الأحور",72,"ر",1,0],["يا من سمعت بعمونٍ وعزّته","عمون من فوق ما عنه امرءٌ سمعا",73,"ع",2,0],["يا من سمعتُ به فشوق ناظري","من فرط ما شنفتُ منه مسامعا",74,"ع",2,0],["يا من سكن القلب وما فيه سواه","رفقاً بمحب بك قد طال عناه",75,"ه",1,1],["يا من سما غارب الزورا بذي شطب","من عزمه واستقال الميس والخلسا",76,"س",2,0],["يا من سما بذكاءِ فِطنتهِ","على أَوصافِ واصِف",77,"ف",1,1],["يا مَن سَحائِبُ فَضلِهِ","فَضلُ السَحابِ إِذا اِنسَجَم",78,"م",1,0],["يا من سقى دمه التراب أراك قد","عودت حتى بالدماء الجودا",79,"د",2,0],["يا من سما شرفاً جميعَ الناسِ","وعلا على الأصنافِ والأجناسِ",80,"س",1,1],["يَامَن سَهَا وَعَصَى إنَّ العَصَا قََرَعَت","قَرعاً لِذِي الحِلمِ فَاقفُ الحَقَّ وَادَّلِجِ",81,"ج",1,0],["يا من سما العرش والأفلاك منزلة","ومن بنصر الصبا قد خصه الله",82,"ه",1,0],["يا من سما السبع الطباق إلى العلا","ودنا وكلم ربه وتشرفا",83,"ف",2,0],["يا من سلا عهد الهوى","سل عن متيم هوى",84,"ه",3,0],["يا مَن سَرت في العالَمين صَفاته","أَنتَ المُنى وَالعَون وَالمَقصود",85,"د",1,0],["يا من سما أقرانه فغدا على","دست الإمارة ضيغماً ذا لبدة",86,"ه",1,0],["يا مَن سموتِ سما الأفلاك في صفةٍ","لكِ المهيمن في تعريفها وصفا",87,"ف",2,0],["يا من سموتَ على العقول بحكةٍ","ما ضَرَّها بالمشكلات عَسيرُ",88,"ر",1,0],["يا مَن سلبتم رشادي في بعادكُم","أمسيتُ أرجو من الدنيا وصالكُم",89,"م",1,1],["يا من سبى الأبطال من سابق","بنعسه السودا وهيف القدود",90,"د",1,0],["يا من سلا كيف كان من يجد","كيف يكونُ العليلُ والكمدُ",91,"د",1,1],["يا مَن سِواكَ ذَهابٌ حادِثٌ عَدَمٌ","يا ذا الرُبوبِيَّةِ الكُبرى عَلى الأُمَمِ",92,"م",1,0],["يا من سمت شمس العلى بسعودِها","ولها الورى دانت برغم حسودِها",93,"د",3,1],["يا من سما قنن السما بمكارم","كفُّ العلى ألقت لها الإقليدا",94,"د",2,0],["يا من سماك غيوم ومزون واشراق","وارضك ورود ونبع واغصان وعذوق",95,"ق",1,0],["يا من سكنت القلب من دون تكليف","صدك باقصى مهجتي جارحني",96,"ن",2,0],["يامنْ سكناهُ شعابُ القلب","وبعد الموت هي المرقدْ",97,"د",1,0],["يا من سمت بمعانيه قوافينا","ونظم ألفاظه أبدي القوى فينا",98,"ن",2,1],["يا من سعدت بنوره وحمدت من","أشراق صبح سناه خير جيدِ",99,"د",1,0],["يَامن سكبتَ الحبَّ فيضَ مشاعرٍ","يروي الفؤادَ وينبت الأشواقا",100,"ق",2,1],["يامن سهرت عيناي له","أودى بالجفن تسهَّدُهُ",101,"د",2,0],["يامن سعيتم جهدكم لسقوطكم","وشطحتمو بقصائدٍ عصماءِ",102,"ا",2,0],["يا مَن سكنتَ بدون إذنٍ مهجتي","فحذارِ من هجرِ الفؤاد حذَارِ",103,"ر",1,0],["يامن سكبت الخمر في احداقنا","تجتاحني سكراتها وهشيمُها",104,"م",3,0],["يا من سلكت إلى الغواية مسلكا","وظننت أن فيها ستجني المنفعة",105,"ع",2,0],["يا من سها ثم اشتهى أسرارها","ما بال قلبك لا يرى رؤياها؟!",106,"ا",3,0],["يا مَن سألتَ عنِ السعيدةِ إن تكُن","مِمّن هواها لا تسُرّكَ حالا .",107,"ل",2,0],["يا من سألتم عن (