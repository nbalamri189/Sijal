{"poems":[[47,"هويناك من لوم على حب تكتما","https://www.aldiwan.net/poem65682.html","الطويل"],[50,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[164,"من قلد العلما واقدم أعذرا","https://www.aldiwan.net/poem59178.html","الكامل"],[234,"حللت عقد المعاني فاعتلى الكلم","https://www.aldiwan.net/poem50824.html","البسيط"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[520,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[520,"ترى عند نجم الدين علم بما عندي","https://www.aldiwan.net/poem12071.html","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114710","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140044",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135244","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102978","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44906","البسيط"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81248","السريع"],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""]],"verses":[["أُؤَلِّفُ نَفساً قَد أُعيدَت عَلى الجَوى","شَعاعاً وَقَلباً في الغَواني مُقَسَّما",0,"م",2,0],["أَو لِفتِ نارٍ بِيَدِ المُشيرِ","حَتّى هَوى لِلوَكرِ كَالمَمطورِ",1,"ر",1,0],["أو لفظة جمدت على شفتيك من","فزَع كما ماتت على شفتيّا",2,"ي",2,0],["أول فقد قال الإله وخلقه","كل إلى الباني به فقد عرا",3,"ر",2,0],["أو لفظ أغيَدَ مَعْشوقٍ لعاشِقِه","مِن بعدِ لا وهو يَبْغي وصلَه نَعَمُ",4,"م",1,0],["أَوَلُّ فَضلٍ أَخِرُ ميلادُهُ","دينُ الهُدى بِغَيرِهِ لَم يُعمَدِ",5,"د",1,0],["أؤلف بين أفراد المعاني","بألفاظ يؤلفها انفرادي",6,"د",2,0],["أؤلف زور القول فيهم وقد أبت","مساعيك لي أن توقع الغي بالرشد",7,"د",1,0],["أَوّل فعلِنا بِها أَتَينا","مَسجِدَها العصرَ بِهِ صلّينا",8,"ن",2,0],["أو لفعلٍ فاعلٌ ربي به","جاهلٌ في البدوِ يوماً والحضر",9,"ر",1,0],["أَو لَفظَ نادرةٍ تَوَلَّى خَطُّها","وأَقامَ طيَّ صدورِنا مَعناهُ",10,"ا",2,0],["أول فتحي بفاتحات","من آل حاميم في ابتدائي",11,"ا",2,0],["أوَّلٌ فتّاحٌ ووهّابٌ مبدي","هب لنا فتحاً دائماً يا غفورُ",12,"ر",1,0],["أو لفتة من جيد عطفك إنما","لفتات أجياد المها لا تنكر",13,"ر",1,0],["أَو لَفتةٍ مِن غَزالٍ نافرٍ خَفِرٍ","أَو بسمةٍ مِن ثَنايا طفلةِ الدارِ",14,"ر",1,0],["أؤلف اللفظ مع وزن بمدحه مو","لانا وذم عدو بين الثلم",15,"م",1,0],["أَو لَفته عجلى وَفي وَثبة","يَفتأ مَجنوناً بِها الشاعر",16,"ر",1,0],["أوّل في الدين ذوقدم","وله عز إذا انتسبا",17,"ب",2,0]]}