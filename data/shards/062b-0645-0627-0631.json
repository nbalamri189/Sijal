36105",""],[5277,"بغداد ..مفتاحُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=191008",""],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[351,"جَاءَ البَرِيدُ بِقرطاسٍ يَخبُّ بِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=4530",""],[5493,"شِعر بعمقِ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=197000",""],[5493,"أيمضي عمري","https://www.poetsgate.com/ViewPoem.aspx?id=197575",""],[5512,"قضيت العمر أعجنه بصبري","https://www.poetsgate.com/ViewPoem.aspx?id=204500",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[5720,"المتْرفَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205536",""],[5736,"سقيا","https://www.poetsgate.com/ViewPoem.aspx?id=208217",""],[5742,"لطائف الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=206976",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5943,"بناءُ النَّفسِ يلزمه اعتناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=34822",""],[6070,"يامنْ قَضَيْتَ سنينَ العُمْرِ في الضَّجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197522",""],[6124,"رنات عود","https://www.poetsgate.com/ViewPoem.aspx?id=201238",""],[6131,"على سلَّمِ المَوتِ نهْتديْ","https://www.poetsgate.com/ViewPoem.aspx?id=189334",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""],[6318,"يا قُدسُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66166&r=&rc=16",""],[5190,"نامي بظلِّ قصائدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78344&r=&rc=57",""]],"verses":[["ثُمَّ اِرتَمَت بِالغَيثِ فيهِ غَمامَةٌ","وَسَقَت غَليلَ الجَدبِ بِالتَهتانِ",0,"ن",1,0],["ثُمَّ ارْتَقَيْتَ ثَنِيَّةَ الثَّغْر الَّتِي","هِيَ للِضَّلاَلِ مُعَرَّسٌ وَمَقِيلُ",1,"ل",1,0],["ثُمَّ أَرسَلتُ إِلَيها أَنَّني","مُعذِرٌ عُذري فَرُدّيهِ بِأَن",2,"ن",1,0],["ثِمارٌ تَضَمَّنَ إِدراكَها","هَواءٌ أَحاطَ بِها مُعتَدِل",3,"ل",1,0],["ثُمَّ اِرمِ بي في قَعرِ مُظلِمَةٍ","إِن عُدتُ بَعدَ اليَومَ في الحُمُقِ",4,"ق",1,0],["ثم ارعَوَى حين أفرَخَ الرَّوعُ فا","ستَخرَجَ منه الحَفِيظَةَ الغَضَبُ",5,"ب",1,0],["ثم ارعوى حين افرخ الروع","فاستخرج الحفيضة الغضب",6,"ب",1,0],["ثمارُهُ في شُمِّ أغصانِهِ","لكنني إن شئتُ عَطَّفْتُها",7,"ت",3,0],["ثمارُ صدقٍ إذا عاينْتَ ظاهرها","لكنها حين تبلو الطعمَ خُطبان",8,"ن",1,0],["ثُمَّ اِرعَوَيتُ وَصِرتُ في","حَدِّ السَكينَةِ وَالخُشوعِ",9,"ع",1,0],["ثُمَّ اِرفَأَنَّ حِفاظاً بَعدَ نَفرَتِهِ","فَكَرَّ مُستَكبِرٌ ذو حَربَةٍ حَرِدُ",10,"د",1,0],["ثمَّ ارتديتم","لَبوسَ خِزيٍ وعارا",11,"ر",2,0],["ثم ارهفته فكان سلاحي","ثم غنيته فكان نشيدي",12,"د",2,0],["ثم ارتمى باندفاع لامرد له","في البحر يقحم فيه وهو اسوان",13,"ن",1,0],["ثم ارفع الصوت يجئك الصدى","من مجلس ونادى الصواب",14,"ب",1,0],["ثُمَّ اِرتَقَت عَنِ المُوا","ءِ فَعَوَت وَهَرَّتِ",15,"ت",1,0],["ثُمَّ أَرادَت أَن تَذوقَ قَبلَهُ","فَاِستَطعَمَت بِنتُ الكِرامِ أَكلَهُ",16,"ه",1,0],["ثُمَّ أَراني لَدَيكَ مُطَّرِحاً","أُجفى عَلى حُرمَتي وَأَجتَنِبُ",17,"ب",1,0],["ثُمَّ أَرْسَى بِهَا هُبُوطٌ يَلِيهِ","حَرَكاَتٌ مِنْ بَعْدِهِنَّ سُكُونُ",18,"ن",1,0],["ثُمَّ اِرعَوَت شَيئاً وَخَفَّضَ جَأشَها","بَعدَ الطُموحِ تَهَجُّدي وَتَوَدُّدي",19,"د",2,0],["ثُمَّ اِرتَحَلتُ وَلِلسَماءِ ذُؤابَةٌ","شَهباءُ تُخضَبُ وَالظَلامُ خِضابُ",20,"ب",1,0],["ثُمَّ اِرعَوَت ضَجَّةُ الآذيِّ وَاِنحَسَرَت","بَقِيَّةُ السَيلِ مِن زورٍ وَبُهتانِ",21,"ن",1,0],["ثِمارُ نُجحٍ سَحابُ الرَأي يُمطِرُها","وَأَنتَ تَغرِسُها وَالدينُ يَجنيها",22,"ي",3,0],["ثُمَّ أَرابَ الزَمانُ فَاِقتَسَموا","أَيدي سَبا في البِلادِ فَاِنشَعَبوا",23,"ب",3,0],["ثُمَّ أَرسَلتُ بازَ صِدقٍ نَشيطاً","يَقتُلُ الوَزَّ ثُمَّ وَالدُرّاجا",24,"ج",2,0],["ثُمَّ أَربى عَلى الصَبابَةِ حَتّى","مَلأَ القَلبَ وَالحَشى وَالضَميرا",25,"ر",2,0],["ثمَّ ارتقَوا منها إلى حَواضرِ","فغادروها مثلَ أَمسِ الدَّابرِ",26,"ر",1,0],["ثم اِرعوَت من بعد ساعة غيبةٍ","تَبكي كأن عيونها ميزاب",27,"ب",1,0],["ثُمَّ ارتأت أن المنو","ن إذا به لاذَت حماها",28,"ا",3,0],["ثمَّ ارْتَحَلْنَ نَيّاً بَعْد تَضْحِيَةٍ","مِثْلَ الْمَخَارِيفِ مِنْ جَيْلانَ أَوْ هَجَرِ",29,"ر",1,0],["ثُمَّ ارْتَأَوْا أَنْ يَقْتُلُو","هُ بِصَفْحِهِمْ عَمَا اجْتَرَمْ",30,"م",1,0],["ثُمَّ ارْتَمَى بِفُيُوضِهِ مِنْ حَالِقٍ","في المَهْبِطِ الصَّادِي مِنَ الْجَرْعَاءِ",31,"ا",2,0],["ثُمَّ ارْتَمَتْ تَصْدَعُ مَنْ صَادَفَتْ","فِي المُرْتَمَى مِنْ حيْثُ لَمْ يَنْظُرِ",32,"ر",1,0],["ثِمارُ المُنى مَن يَجنِها دونَ إِلفِهِ","يَجِد طَيِّباتِ العَيشِ مِثلَ الخَبائِثِ",33,"ث",1,0],["ثم ارتمت كعجوز","من قبل بدأ الشبيبة",34,"ب",2,0],["ثم ارعوت ضجة الآذي وانحسرت","بقية السبل من زورٍ وبهتان",35,"ن",1,0],["ثمّ ارتمت كعجوز","هن قبل بدء الشبيبه",36,"ب",2,0],["ثم ارتَحَلنَا إِلى التَّأوِيلِ تَصحَبُنَا","أَدِلَّةٌ مِن نُصُوصِ السَّادةِ الغُرَرِ",37,"ر",1,0],["ثُمَّ أَربى عَلى النَواشِطِ مِنها","سابِحٌ بَعدَ غَربِهِ مَوّارُ",38,"ر",1,0],["ثم أرسا الجبال فيها إلى يو","م تراها كعهنك المنفوش",39,"ش",1,0],["ثُمَّ اِرتَضوا فيهِ بِأَوَّلِ داخِلٍ","فَأَتى الأَمينُ الطَيِّبُ الأَردانِ",40,"ن",1,0],["ثُمَّ اِرتَأوا ظُلماً وَعدواً بَينَهُم","سِرّاً رَويّة مُفكِرٍ حَيرانِ",40,"ن",1,0],["ثُمَّ اِرتَوى الدوسِيُّ بَعدَ إِياسِهِ","عَلَلاً عَلى نَهلٍ فَثِق بِبَيانِ",40,"ن",1,0],["ثمارُ غراسِ المدح فيه كواعب","لهنَّ حقوق ماتلات بواعثُ",41,"ث",1,0],["ثمّ أرجو دعاءكم كلَّ وقتٍ","وهو منّا لكم نراه عباده",42,"د",2,0],["ثمَّ ارتَقُوا في شُعَاعِ الشَّمسِ كُلُّكُمُ","إلى السَّماءِ فَأنتُم أكرَمُ النَّاسِ",43,"س",1,0],["ثُمَّ أَروي مِنِ ابنِ هَرمَةَ لِلنا","سِ بِشِعرٍ مُحَبَّرِ الإيضاحِ",44,"ح",1,0],["ثُمَّ أَروي مِنِ اِبنِ سيرينَ لِلعل","مِ بِقَولٍ مُنَوَّرِ الإِفصاحِ",44,"ح",1,0],["ثُمَّ أَروي مِن اِبنِ سيرينِ لِلشِع","رِ وَقَولِ النَسيبِ وَالأَمداحِ",44,"ح",1,0],["ثِمارٌ حَلاوَتُها في القُلوبِ","وَفي السَمعِ إِن مَجَّها ثَمَّ فَم",45,"م",1,0],["ثِمارٌ يَنابيعُ أَنوارِها","تُمَزِّقُ بِالفِكرِ حُجبَ الظُلَم",45,"م",1,0],["ثُمَّ اِرعَوَت في سَوادِ اللَيلِ وَاِدَّكَرَت","وَقَد تَمَزَّعَ صادٍ لَحمُهُ دَفِرُ",46,"ر",1,0],["ثمّ اِرعوَيت حذاراً أَن يكون من ال","حرمانِ عُذري وكَم عذرٍ هو الجرمُ",47,"م",1,0],["ثمارها من معاني الفكر تقطفها","يد الخيال وتهديها إلى الجاني",48,"ن",2,0],["ثم ارحض الإثم في تيار رحمته","بمدمعي قائلاً يا خاطئ انفرجا",49,"ج",2,0],["ثم أُروي الواغلينَ وَلَم","أَكُ كَلباً بينهم كَلِبا",50,"ب",2,0],["ثم أرجو بأنني","فوق مارمت أمنح",51,"ح",1,0],["ثم ارتجعنا من منى بتنا بها","أيام تشريق الثلاث فحسبيه",52,"ي",2,0],["ثم أردت ذكر ما قد احتووا","عليه مما عرفوا وما رووا",53,"و",3,0],["ثم أراد عندما افتضوه","في بعثه الحكم إذا أتوه",53,"ه",1,0],["ثم ارعوت هذه الأحزان فاستعرت","وأضرمت بعد في الحشا مضطرما",54,"م",2,0],["ثمار عقولهم جاءت بيسر","ولو وجدوا بالاستنباط عسرا",55,"ر",2,0],["ثِمَارُ المَجْدِ يَقْطِفُها لُبَاباً","فَيلْقِى الشَّوكْ عنْها والقُشُورَا",56,"ر",2,0],["ثُمَّ اِرتَقى الأُفقَ بِالجِسمِ الكَريمِ عُلىً","وَالروحُ خادِمُهُ وَالقَلبُ ما ضَعفا",57,"ف",2,0],["ثُم أَراه كُنهَ ما كانَ طَلب","إِذ هِيَ فَأس يَدُها مِن الخَشَب",58,"ب",1,0],["ثم ارفعا الطرف هل تبدو لنا ظعنٌ","بحائلٍ يا عناء النفس من ظعن",59,"ن",1,0],["ثِمَارُ هَوَاهُ أيْنَعَتْ وَهوَ فِي الْحَشَا","فَحَبَّةُ قَلْبي أَصْلُهَا وَهُوَ لابِثُ",60,"ث",1,0],["ثماركم زمان القيظ تأتي","ولي ثمرٌ أتى زمن الرّبيع",61,"ع",1,0],["ثم ارمِ بي بعضَ البلاد وخلني","أنقضَّ فوق عِقابها كعُقاب",62,"ب",1,0],["ثم ارْتَحَلْتَ إِلى دِمْشَقَ مُوَضِّحاً","سُبلَ الرَّشادِ المَحْضَ للسُلاَّكِ",63,"ك",1,0],["ثمار جنيناها ببستان جودها","فيا حبذا ذاك الجناء الذي نجني",64,"ن",2,0],["ثم ارجعي نحو الاله بهمة","علوية وتضرعي بدعاء",65,"ا",2,0],["ثم ارتقيتَ إلى السماءِ فجدت لي","من أفقها بأهلةٍ ونجومِ",66,"م",1,0],["ثم ارعويتُ وما بِكَفِّيَ طائِل","من لذّةِ الدنيا سوى تَبِعاتِها",67,"ت",3,0],["ثم اردفنه للذي كتبته","حتى تُوافي نصفَ ما نصبتَهُ",68,"ه",1,0],["ثم ارجعن لمينة وربعِ","في قول او ثلث بياض الاربعِ",68,"ع",1,0],["ثم ارْعَويتُ وكَفَّ الشّيب من اسري","وازمع الحلُم تسويدي وإرشادي",69,"د",2,0],["ثم ارتدى بالحلم وادّرَع النّهى","مغضٍ عن الجهال أو متغاضي",70,"ض",2,0],["ثم ارعويتُ وقد نويتُ تواضعاً","لصروف أَيّام وشيبٍ شاملِ",71,"ل",1,0],["ثم ارعويتُ وكان اللهو من أربي","لو أنني خلت في نفسي الصّبا رَمقا",72,"ق",2,0],["ثم ارتحلنا وخلّفنا ديارَهمُ","بلاقعاً ليس إلاّ البُومُ والوتدُ",73,"د",1,0],["ثُمَّ أَراهُ رَأيُه أَنَّهُ","أَمسى إِلَيهِ مِنهُم أَحوَجا",74,"ج",2,0],["ثم أَرقى مِنطاد فكري إلى با","ريسَ أَمْ المدائن الزاهراتِ",75,"ت",1,0],["ثم أَرقى منطاد فكري إلى اليا","بانِ مأوى أُسْدِ الفلا والبُزاةِ",75,"ه",1,0],["ثم أرقى منطاد فكري إلى","مصرٍ ديارِ العلوم والمكرماتِ",75,"ت",1,0],["ثمار غروس الولا كل آ","ن لكم نعمة غضّة تحدث",76,"ث",1,0],["ثم ارجع إلى المقام فهلل","واحمد الله وارفع الأذيالا",77,"ل",2,0],["ثم ارتحلنا بذاك الماء نحو تهب","فلم نصادف بها للماء وجدانا",78,"ن",2,0],["ثمار المعالي من جناها رقي بها","إلى خير ما ينجو به من شقا الخبث",79,"ث",1,0],["ثمار الرجى أجني بنشر مديحه","إذا نشر الأموات والخلق تبعث",80,"ث",1,0],["ثم ارفعا الطرفَ هل تبدو لنا ظُعُنٌ","بِقَرقرى يا عناءَ النفس من ظعنِ",81,"ن",1,0],["ثم ارتقت حتى ابتك رضى بمن","لم يرض كعبك أن يراه صعيدا",82,"د",2,0],["ثُمَّ ارتضَى أن صَارَ قَوَّاداً لأر","بَابِ الفُسُوقِ وَكُلِّ ذِي عِصيَانِ",83,"ن",1,0],["ثُمَّ ارتَضَوا أن يَجعَلُوا مَعبُودَهُم","مِن هَذِهِ الأحجَارِ وَالأوثَانِ",83,"ن",1,0],["ثُمَّ اِرجِعوا فَأَكِبّوا في بُيوتِكُمُ","كَما أَكَبَّ عَلى ذي بَطنِهِ الهَرِمُ",84,"م",1,0],["ثِمارُ المُنَى تُجنَى بجاهِ محمدٍ","إذا أُعضِلَت يوماً دواهي الحوادثِ",85,"ث",1,0],["ثم أرسلتها كمنحدرِ السَّي","لِ تهادى من المكانِ اليفاعِ",86,"ع",1,0],["ثم أرخت سلاسل الشعى حتى","قيدت كل مغرم يهواها",87,"ا",3,0],["ثمار العلا تجني بحث الدلائث","لَدى الكران المجد في كف ضابث",88,"ث",1,1],["ثمارها في غاية اللطافة","لا ضرر فيها ولا مخافة",89,"ه",1,0],["ثم اركبوا الشعب نحو غايتكم","مطيّة سهلة لمن ركبا",90,"ب",2,0],["ثم أروي ما قد سمعت اليكم","بعد حلّ الرموز والإبهام",91,"م",1,0],["ثمار ما قد غرست تجنى","فانتظر السقم عن قريب",92,"ب",1,0],["ثِمار علمٍ لها الجاني يمدُّ يَداً","من النُهى لا من الأَوصال والعَصبِ",93,"ب",1,0],["ثم ارتحل صوب المدينة إنها","لمحمد كانت حمى وحريما",94,"م",2,0],["ثم ارتدى المحرومُ فضلَ ردائها","فغلت مراجلُ إحنةٍ ونفار",95,"ر",1,0],["ثم ارتحلت والحشى مودعي","والقلب يصلى في سعير أضلعى",96,"ع",2,0],[