"ن",1,0],["يُبقَرُ عَنهُنَّ بَطنُها أَبَداً","وَما تَشَكّى وَلا يَسيلُ دَمُ",10,"م",1,0],["يَبقى السُرورُ بِها وَتَب","قى المَكرُماتِ لِساكِنيها",11,"ي",3,0],["يَبقى اليَسيرُ مِنَ الكَثي","رِ فَكيفَ ظَنُّكَ بِالقَليلِ",12,"ل",1,0],["يبقى بها نقشُ الكلامِ كأنّما","نُقِشَتْ على الصّخرِ الأصَمِّ الأحرف",13,"ف",1,0],["يُبقي لِذي المَعروفِ مَعروفُهُ","حَمداً وَتَنزاحُ الأَكاذيبُ",14,"ب",1,0],["يَبقى بناء العلم بر","هاناً عَلى فضل البناة",15,"ه",1,0],["يُبْقِي عَلَى الأَطْفَالِ وَهْيَ قُوَى الحِمَى","مِنْ أَنْ يُضَيِّعَها عَلَيْه مُضَيِّعُ",16,"ع",1,0],["يبقَى قليلُ المالِ مِنْ بَعْدِهِ","ويَذْهَبُ المالُ على كُثْرِهِ",17,"ر",2,0],["يبقى إلى يوم الدين شاربها","في سكرة وهو غير سكران",18,"ن",1,0],["يبقى البني آدم مجرد ومخلوق","ملك .. ولكن في الحقيقه بلا ملك",19,"ك",1,0],["يبقى الشباب نديّا في شمائله","فلم يشب قلبه إن شاب فوداه",20,"ا",2,0],["يَبقى اللَئيمُ مَدى الحَياةِ فَلا","يَرتاعُ مِنهُ لِحادِثٍ صَدرُ",21,"ر",1,0],["يبقيك شعرى بقاء لا فناء له","ما كان شعرى لهذا العالم الفاني",22,"ن",2,0],["يبقى لذي مرض أو مرية شبه","أو مشكل لا ورب البيت والحجر",23,"ر",1,0],["يُبْقيهِ حِلْمٌ ستُغْنيهِ مَغبّتُه","كم سقْطِ جَهْلٍ به زَنْدُ الحِجاوَريا",24,"ي",2,0],["يَبْقونَ في نِعمةٍ كالقَطْرِ دائمةٍ","مَقْرونةٍ بهَواديها تَواليها",25,"ي",3,0],["يَبقى النَدى بَعدَكَ مِقدارَ ما","يَبقى نَضيرُ الرَوضِ بَعدَ السَحاب",26,"ب",1,0],["يبقي لقطب العلم فحر العصر","ذكرا مجيدا يا له من ذكر",27,"ر",1,0],["يبقَى الذي أعطتك منها ما ذكتْ","شمسٌ ويفنَى كلُّ ما تعطيني",28,"ن",2,0],["يبقين للذكر المخلّد رحمةً","لك من فم الراوي وعينِ المجتَلي",29,"ل",2,0],["يبقى عليك ما دَعت","أمُّ هديل تَهتفُ",30,"ف",1,0],["يبقِّرُ عنها بطونَ الظِّباءِ","من الألف واحدةٌ تُنجِبُ",31,"ب",1,0],["يبقي من الذخر والأحوالُ شاهدةٌ","طيبَ المحامد لا عيناً ولا وَرِقا",32,"ق",2,0],["يبقى مساحب برديها وما وطئت","وطال ليلٌ فبم تسهر ولم أنمِ",33,"م",1,0],["يَبقى النَّدى ما بَدا للضَّوءِ منهُ مَدى","يَجري إليهِ ، ويَبقى الأيكُ سُلطانا!",34,"ن",2,0],["يَبقى التُّقى والغِنى في الناسِ ما عَمِروا","وَيُفقَدانِ جَميعاً إِن هُمُ فُقِدوا",35,"د",3,0],["يبقى ويفنى الناس في شؤمه","قوموا انظروا كيف بخوت اللئام",36,"م",1,0],["يَبقَى أمامَكَ لا يَريمُ مَكانَهُ","أيَخافُ أنه لا يُرَى بِعِيانِ",37,"ن",1,0],["يبقى الكلامُ وكلُّ كَلْمٍ مؤلمٍ","يمحوه ليلٌ أو نهارٌ مشرقُ",38,"ق",1,0],["يُبقي ويُفني ثمّ يسلبُ ماكساً","بالرَّغم فهوَ المُلبِسُ النَّزَّاعُ",39,"ع",1,0],["يبقى بعيداً عنك يخشاك أن","تُطفِيَهُ شيطانُك الداني",40,"ن",2,0],["يُبِقي لنا الخُبْرُ فيها بعدَهُ خَبَراً","إلى زَمانٍ فيمضي ذلكَ الخَبَرُ",41,"ر",1,0],["يُبْقَى علينا دمَ الحياةِ ولاَ","يُخْرِجُ إلا المخْتَلّ والفاسِدْ",42,"د",1,0],["يبقى مُوَفيًّ لا انْصِرا","فٌ يَتَّقيه ولاَ انْصِرَامُ",43,"م",1,0],["يبقى القريض لناظيمه صحائفاً","بيضا زهت كالدر أي زهاء",44,"ا",2,0],["يَبقى لها فوقَ الشِّفاهِ بَقِيَّةٌ","كالزَّعفرانِ عَلى جِباهِ غَوَانِ",45,"ن",1,0],["يَبقى مَعَ الأَهرامِ ذِكرَكَ ثابِتاً","وَيَظَلُّ قَبرُكَ مِثلَها مَشهودا",46,"د",2,0],["يبقى سمانا كالشموس .... مضيئة","ونظل نسعى...لأ كتمال",47,"ل",1,0],["يَبقى بَقاءَ الدّهر يَسْري ذِكْرُهُ","بين الأفاضِلِ يُستفادُ إذا انْقَضَى",48,"ض",2,0],["يَبقى لنا الأمنَ حيّاً ما بقيتَ لنا","على الليالي ويقضي نَحبَه الفَزَع",49,"ع",1,0],["يَبقى لَها رَمَقٌ إِذا اِحتَرَقَت","لَكِنّني قَد صِرتُ لا رَمَقا",50,"ق",2,0],["يَبقى إِلى وَقت صَلاة العَصر","يَأتي بِقَصد نَهيهِ وَالأَمر",51,"ر",1,0],["يبقى عزاءُ النفسِ وهيَ كظيمةٌ","رغمَ الرحيلِ فأنتَ حيٌّ بينَنا",52,"ن",2,0],["يبقى على دست الخلا","فة قيماً متديِّنا",53,"ن",2,0],["يبقى به ذكرٌ لهُ","طول الزمان أمير المؤمنينخلَّدُ",54,"د",1,0],["يبقى طويل العُمْرِ","مُخلّداً بالذكرِ",55,"ر",1,0],["يبقرن عَن مهجاتهم وَكَأَنهن","نَ مِن الوَقار عَلَيهم رُحَماء",56,"ا",2,0],["يبقى حياة الدهر اعجازه","ومعجز الرسل لحين الممات",57,"ت",1,0],["يبقى على مهجتي ما لست استره","والسر يشرح ما في غيهب الظلم",58,"م",1,0],["يبقى مصابك وهو يذكرنا","لو كان ينفع مثلنا الذكر",59,"ر",1,0],["يبقى تراثاً لقوم يفخرون به","إذا توالت على الأعقاب أعصارُ",60,"ر",1,0],["يبقى المريض ليشفي","حيناً ويودى الطبيب",61,"ب",1,0],["يبقى المحب على عهد المحب له","إذ يلتقيه يزيد الحب تمكينا",62,"ن",2,0],["يبق لي شيءٌ يباع بدرهم","كيف السبيل إِلى وفاء ديوني",63,"ن",2,0],["يبقى على توفيقه تقواه","بحقّ لا إله إلا اللّه",64,"ه",1,0],["يبقى الثَّناءُ وتَذهبُ الأموالُ","ولكلِّ دهرٍ دولةٌ ورجالُ",65,"ل",1,1],["يبقى كما اشتهت العُلى","غضًّا تهاداه الدهورُ",66,"ر",1,0],["يبقى مدى الاعصارِ والاجيالِ","اتنكرُ حبي والمدامعُ تبديهِ",67,"ه",1,0],["يبقى المصابُ عليلاً ما لَهُ أَمَلٌ","لا مال يفديه لا تلهيه عشرتهُ",68,"ه",1,0],["يَبِقُ بينَ مُحْزِنٍ وَمُسهِلِ","عَدْوَ الظَّليمِ في ظهور الأحْبُل",69,"ل",1,0],["يَبقى مَعَ التَّقوى وَيَخلُدُ بَعدَهُ","وَحَياتُه حُلُمٌ مِنَ الأَحلامِ",70,"م",1,0],["يَبقى بَقاءَ النَيِّرَينِ مُخَلَّداً","لَكُمُ عَلى الأَحقابِ وَالأَعوامِ",71,"م",1,0],["يَبقى عَلَيكَ إِلى المَعادِ وَيَنقَضي","أَمَدُ الزَمانِ فَلا يَكُونُ لَهُ اِنقِضا",72,"ض",2,0],["يبقى مسرور قد غَفَر","ذنبه رب البشر",73,"ر",1,0],["يبقى به بعد هذا النصف من بلدٍ","معناه دل عليه سكر القصب",74,"ب",1,0],["يبقى العمل والعِلْم من بعد الآشهاد","والموت ياتي الطفل لي في المهادي",75,"د",2,0],["يَبقى أَزاهرَ في الطُروسِ ضَواحِكاً","تندى عَلى لَحظِ العُيونِ وَتعبَقُ",76,"ق",1,0],["يبقين في جيد الزمان","أطواق جود ومنن",77,"ن",1,0],["يبقى عليٌّ لكم ويبقى صنُوه","وأبو اعفيفٍ ساحب الأذيالِ",78,"ل",1,0],["يبقى الى الحشر لكم مفخراً","فذّاً يَرى كالعلَم المفرد",79,"د",1,0],["يبقى مع الأيام ما سجلته","من كل قافية لها ترديد",80,"د",1,0],["يبقى يحرك رجليه وإن عجزا","حيناً عن القفز حتى ظُن وسنانا",81,"ن",2,0],["يبقى يحنّ الى الرجوع فتى له","وطن فكيف بمن له وطنان",82,"ن",1,0],["يبقى لك التاريخ في صفحاته","ذكراً على مر الدهور مجيدا",83,"د",2,0],["يبقى لك الذكرَ الجميلَ وشعرُهُ","بفم الزمان وسمعهِ منهوب",84,"ب",1,0],["يبقى الدخيل الذي كنا نعيرهُ","بالفقر عن ملكهِ في مصرَ ذوَّادا",85,"د",2,0],["يبقى القريض بذكر فضلك خالداً","حتى يعدَّ الدهر من اعماره",86,"ر",2,0],["يبقي لعين الآبدين رينا","وجاحداً للدين للديان",87,"ن",1,0],["يبقى امير المؤمنين بنعمة","بالنصر محتفلاً على اعدائه",88,"ا",3,0],["يَبقى التَّفَرُّقُ ما بَقِيتُ كَما تَرى","خَفّف عَلَيكَ وَلَو أَزولُ لزالا",89,"ل",2,0],["يبقى الثناءُ ويُخْلَى المالُ عن لَحِزٍ","يخشى 