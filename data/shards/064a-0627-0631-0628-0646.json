spx?id=112743",""],[5457,"يا رب نوِّرْ لي الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=213115",""],[5493,"نشيدُ الشجر","https://www.poetsgate.com/ViewPoem.aspx?id=197037",""],[5611,"كل امرىء وسط التراب يكون","https://www.poetsgate.com/ViewPoem.aspx?id=165153",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5720,"شهرُ الفضائل","https://www.poetsgate.com/ViewPoem.aspx?id=211932",""],[5736,"منبج","https://www.poetsgate.com/ViewPoem.aspx?id=208889",""],[5742,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=206896",""],[5861,"ياربنا","https://www.poetsgate.com/ViewPoem.aspx?id=188087",""],[1920,"الدَّيْن","https://www.poetsgate.com/ViewPoem.aspx?id=198701",""],[5956,"خذني إليك أيا ربي","https://www.poetsgate.com/ViewPoem.aspx?id=182488",""],[5956,"لم ألقَ حسناءً عليّ تجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=182620",""],[5956,"المصائب الراتعة من ممارسات الأطباء الغبية المائعة","https://www.poetsgate.com/ViewPoem.aspx?id=193100",""],[5956,"الثلاثي المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=193163",""],[5956,"الأمُّ كادت أن تكون إلها","https://www.poetsgate.com/ViewPoem.aspx?id=193404",""],[5956,"من مزايا البنك الإسلامي للتنمية","https://www.poetsgate.com/ViewPoem.aspx?id=193485",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"مثل انبثاق الفجر صوت محمد","https://www.poetsgate.com/ViewPoem.aspx?id=194380",""],[5956,"ما أحسن الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=194558",""],[5956,"أثمنُ مِنَ الشمس والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=194748",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""],[5956,"الناي بِنْتي ما لها تكرارُ","https://www.poetsgate.com/ViewPoem.aspx?id=203444",""],[5956,"المجد ينبع من عينيك والهممُ","https://www.poetsgate.com/ViewPoem.aspx?id=206263",""],[5956,"الشعر يُشعل نورَه العظماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208507",""],[5956,"يا ربَّنا انصرها على أعدائها","https://www.poetsgate.com/ViewPoem.aspx?id=214089",""],[5956,"(إِنما الْأَعمال بِالنِّيات، وإِنما لِكل امْرِئ ما نوَى)","https://www.poetsgate.com/ViewPoem.aspx?id=214090",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5977,"الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=213286",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""]],"verses":[["يا رُبَّ ناكِثِ بَيعَتَينِ تَرَكتَهُ","وَخِضابُ لِحيَتِهِ دَمُ الأَوداجِ",0,"ج",1,0],["يا رُبّ ناعورة غنَّت لنا وبكت","كحالة الصبّ بين اليأس والأمل",1,"ل",1,1],["يا رُبَّ نائيةٍ كأنَّ ضِرامَها","دانٍ إذا شِمناه بالأبصارِ",2,"ر",1,1],["يا رُبّ نَفس لِلّه مُسلمة","قامَ نَبيّ الهَوى يَنصّرها",3,"ر",3,0],["يا ربّ نيقٍ آواهُ بَعدَكَ مِن","خَوف أَعاديهِ وَهوَ أَوّاهُ",4,"ا",2,0],["يا ربّنا أرِنِي أنظُرْ إليكَ بها","عِنْدَ القُدومِ وعامِلني بإكرام",5,"م",1,0],["يا رُبَّ نشء غذاه من حشاشته","ومن عصارة ماءِ الفكر روَّاه",6,"ا",2,0],["يا رب نادبة ما جف مدمعها","وعينها في نظام الحلي والحلل",7,"ل",1,0],["يا رب نادية ما جف مدمعها","وعينها في نظام الحلي والحلل",8,"ل",1,0],["يا ربنا يا ارحم الراحمين","يا واهب الارزاق للعالمين",9,"ن",1,1],["يا ربنا بجاهه العظيم","وقدره وفضله العميم",10,"م",1,0],["يا ربنا بالمرشد البصري","شيخ الطريق العارف الولي",10,"ي",1,0],["يا ربنا وبالحبيب العجمي","خليقة البصري عالي الهمم",10,"م",1,0],["يا ربنا بالعارف الطائي","داود قطب الأًصفيا الرضيّ",10,"ي",1,0],["يا ربنا بالمرشد المعروف","شيخ الورى الكرخى الهمام الصوفي",10,"ي",1,0],["يا ربنا بالسقطي السري","محي الطريق الكوكب البهي",10,"ي",1,0],["يا ربنا بالفاضل البغدادي","أعنى الجنيد تاج ذي الإرشاد",10,"د",1,0],["يا ربنا بالواصل الشبلي","كنز الكمال المرشد الولي",10,"ي",1,0],["يا ربنا بالروذ بادي الكامل","أستاذ أهل القرب والفضائل",10,"ل",1,0],["يا ربنا بابن تركان البطل","غلام صاحب التقي زين العمل",10,"ل",1,0],["يا ربنا بالسيد الصياد","سبط ا