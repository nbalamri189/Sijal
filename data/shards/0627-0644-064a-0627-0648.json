{"poems":[[95,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[254,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[254,"أنية الغداة أم انتقال","https://www.aldiwan.net/poem2099.html","الوافر"],[254,"كفى بالنأي من أسماء كافي","https://www.aldiwan.net/poem2105.html","الوافر"],[280,"إلى أوطانه حن العميد","https://www.aldiwan.net/poem25574.html","الوافر"],[285,"أما وعتاق العيس لو وجدت وجدي","https://www.aldiwan.net/poem60687.html","الطويل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67415","المتقارب"],[6070,"رحى الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=188815",""],[5567,"حوادم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69069&r=&rc=7",""]],"verses":[["إلى أوجها الأعلى رفعت تحيتي","وفي كل قلبٍ رجعها قد ترددا",0,"د",2,0],["إِلى أَوسِ بنِ حارِثَةَ بنِ لَأمٍ","لِيَقضِيَ حاجَتي وَلَقَد قَضاها",1,"ا",3,0],["إِلى أَوسِ بنِ حارِثَةَ بنِ لَأمٍ","وَحَقَّ لِقاءُ رَبِّكَ لَو يُنالُ",2,"ل",1,0],["إِلى أَوسِ بنِ حارِثَةَ بنِ لَأمٍ","لِرَبِّكِ فَاِعلَمي إِن لَم تَخافي",3,"ف",2,0],["إلى أوْطَانِه حَنّ العَمِيدُ","فَظَلّ كَأنّه غُصْنٌ يَمِيدُ",4,"د",1,1],["إِلى أَوْحَدٍ أُهْدِي لَهُ الْحَمْدَ وَحْدَهُ","بَحَقٍّ وَ لا يُهْدِي إِلَيَّ الْغِنى وَحْدِي",5,"د",2,0],["إلى أَوحدِ الدُّنيا الكبيرِ الذي غدا","إلى كابرٍ يَنْميهِ في المجدِ كابر",6,"ر",1,0],["إلى أولِ النَّاسِ بَعْدَ الرسُولِ","وَصِنْوِ الرسْولِ مِنَ الْعَالَمينَا",7,"ن",2,0],["إلى أولادِ أولادٍ","وبيتُ العمرِ يَنخَرِبُ",8,"ب",1,0],["إلى أول من استخدم مصطلح ( حوادم )","الأستاذ نهاد خياطة",9,"ه",1,1]]}