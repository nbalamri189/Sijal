x?id=208519",""],[5206,"في الصديق والصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=187434",""],[5211,"رَجاءُ القَوْمِ ليْسَ لهُ رَجاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=176160",""],[4572,"دستْ سعادُ رسولاً غير متهمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=15010",""],[5277,"رسائلُ عشقٍ بغدادية..5","https://www.poetsgate.com/ViewPoem.aspx?id=191524",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5480,"قابوس","https://www.poetsgate.com/ViewPoem.aspx?id=9887",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5690,"أنا المترجم قانوناً غدا حكما","https://www.poetsgate.com/ViewPoem.aspx?id=172216",""],[5977,"توأم روحي","https://www.poetsgate.com/ViewPoem.aspx?id=213068",""],[6023,"إن رُمتَ أن تُسبر طبع امرئٍ","https://www.poetsgate.com/ViewPoem.aspx?id=123903",""],[6037,"يا جنة الطرف نار القلب مأواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=186096",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[4661,"رقد السيف واستراح الأعادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57064&r=&rc=3",""],[6248,"رجع الخاصرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86024&r=&rc=1",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""]],"verses":[["وَأَنْتَ جَرَّبَكَ الرَّحْمَانُ مُخْتَبِرا","لِكَيْ يَرَى مِنْكَ فِعْلَ الْحَافِظِ الْكَالِي",0,"ل",2,0],["وَأَنْتَ جَميعُ أَسْبَابي","إِذَا مَا أَعْوزَ السَّبَبُ",1,"ب",1,0],["وأن تُجمِع الدنيا على ردّ طامع","أشار إلى أسيافه مُتَهدِّدا",2,"د",2,0],["وأنتجْ به درّ الحباب فهكذا","قطار الحيا درَّ البحار نتاجها",3,"ج",3,0],["وانتجع أفق بني حم","مادٍ الأندين أفقا",4,"ق",2,0],["وَإِن تَجلُبِ المَوتَ الذُعافَ إِلَيهِمِ","كَتائِبُ مِن نَبهانَ مُرٌّ يَقودُها",5,"د",3,0],["وَأَنتَ جَبينُ المُلكِ بَل أَنتَ سَمعُهُ","وَأَنتَ لِسانُ المُلكِ حينَ تَقولُ",6,"ل",1,0],["وأنتِ جهري وهمسي","صديقةً وحبيبه",7,"ه",1,0],["وإن تَجْهَلِيهِ فَعِيدانُهُ","لظى الشمس تلذَعُ منها الكباءَ",8,"ا",2,0],["وَإِن تَجهَليني بَعدَ عِلمٍ فَإِنَّني","عُرِضتُ عَلى الأَحداثِ بَعدَكُمُ عَرضا",9,"ض",2,0],["وَأَنْتِ جَدِيرَةٌ أَدَباً وَحُسْناً","وَأخْلاَقاً بإِعْجَابِي وَحُبِّي",10,"ي",1,0],["وإن تجَهَّم قمتم حول مَضْجَعهِ","حتى ينامَ قريرَ العين مسرورا",11,"ر",2,0],["وان تجمَعُوا الشَمْل من أُمَّةٍ","يفرِّقُها \" الجَدُّ \" و\" المذهب \"",12,"ب",1,0],["وانتجعْ أُفق بني حم","اد الأنْدَين أُفقا",13,"ق",2,0],["وأنت جولة بحر عين مدتها","في العالم الأزلي المحض قد نبعت",14,"ت",1,0],["وأنت جبريل توحي لي وأنظم ما","توحيه من غرر الآيات والجمل",15,"ل",1,0],["وَأَنتَ جَمَعتَ شَملَ الأَمنِ فينا","فَلا شَتَّت لَكَ الأَيّامُ شَملا",16,"ل",2,0],["وأنت جاهي إذا هملتني انهدمت","قواعد كنت قد أسستها وبنا",17,"ن",2,0],["وأنت جبانٌ في الحروبِ وقابضٌ","على المالِ أما العرْضُ منك مُشَتَّعُ",18,"ع",1,0],["وإن تجده غير لازم كسر","عيناً فصغه منه مثل ما ذكر",19,"ر",1,0],["وإن تجد بعينه الاعلال","فسمه بأجرف كقال",19,"ل",1,0],["وَإن تجِد من بَينِها ساعةً","جَعبَتُها من غَصَصٍ خالِيَه",20,"ي",2,0],["وَأَنتَ جَديرٌ بِاِصطِناعي وَقادِرٌ","عَلى حَسمِ دائي عارِفٌ بِدَوائي",21,"ي",1,0],["وَانْتَجَعْتُ مُزْنَ الْغَائِبِ مَنْ أَحْ","يَى بِغَرْبٍ رَبْعَ الرَّشَادِ الدَّرِيسَا",22,"س",2,0],["وإن تجلي جمالُهْ وانجلي مجلاه","فَهِمْ وقل في مجالي ذكرِهِ الله",23,"ه",1,0],["وانتَجِعْهُم مُوسِراً أو مُعسِراً","تَرِد الجُود زُلالاً خَصِرا",24,"ر",2,0],["وَأَنْتَ جَعَلْتَ بَيْنَهُما انْتِساباً","بِما آلى إِباؤُكَ وَانْتِساجا",25,"ج",2,0],["وإن تجهز إلى مغناه ألف رجا","تلق الأماني والإقبال والفرجا",26,"ج",2,0],["وإن تجردت فاعمل باليقين وبال","علم إن كنت موقوفاً مع السبب",27,"ب",1,0],["وأنتَ جَسّرْتَني حتّى جَسَرْتُ بِما","أكرمْتَني فطلَبْتُ المَطلَبَ الشَّططا",28,"ط",2,0],["وَان تجبني من حياءٍ بلا","أَبعث اِلَيكَ القُطنَ وَالمَغزلا",29,"ل",2,0],["وإن تجدْ عيباً بهِ","فأنتَ أولَى مَنْ سَتَرْ",30,"ر",1,0],["وأَنتَ جارٍ من العَلْيا عَلَى سُنَنٍ","تَدَارُكُ الحربِ من أَزْكَى شرائِعِها",31,"ع",3,0],["وانتجع همة الإمام الرفاعي","علم الشرق سيد الأقطاب",32,"ب",1,0],["وإنْ تُجِلْ في ثراها طَرْفَ مُختبرٍ","لا تَلقَ إلّا حَديقاتٍ وغُدرانا",33,"ن",2,0],["وأنتَ جامع شملَ العربِ قائدها","إلى السعادة تدعى صاحب العلَمِ",34,"م",1,0],["وأنتج الذكر الأنثى وقد عكست","بختمها الحكم فيها وهو منفصل",35,"ل",1,0],["وأنت جعلتَني في كل خَطبٍ","حُساماً في يديك على عداكا",36,"ك",2,0],["وَأَنتَ جَدير بِالمَحامد وَالثَنا","وَمثلُك مَن طابَ الزَمان بذكره",37,"ر",2,0],["وإن تجاوز ما يرضى الحليفُ به","فإن عندك للغضبانِ ما يزع",38,"ع",1,0],["وَأَن تَجيء عِنده وَتَعرج","وَفي يَدي هندٍ تَجي وَتَخرُج",39,"ج",1,0],["وإن تجدْهُ زائداً مفرِّطا","فالرأيُ أن يُفصدَ أو أَنْ يُشْرَطا",40,"ط",2,0],["وإن تجدْ ما يُشَك فيه فقلْ","شتان بين العطشان والساقى",41,"ق",2,0],["وإن تجده أخا جَدْعِ فكن فطِناً","وقل سلام وكن عن قربه نازى",42,"ز",2,0],["وإن تجدْ ما يُشَك فيه فدَعْ","وخذْ يقيناً وخلِّ ما التْبسا",43,"س",2,0],["وإن تجابَنْتَ ليَّنْتَ الكلامَ وقد","نُوديتَ باسمٍ حقير غيرِ مُنصرف",44,"ف",1,0],["وَإنْ تَجَرُوا في سُؤْدَدٍ وَتَزَايَدُوا","فَأنْفَسُ مَا يُهْدَي لَهُمْ جَوْهَرُ الشِّعْرِ",45,"ر",1,0],["وإن تجزع جزعنا ما اصطبرنا","وصرنا مثل منبوذ العراء",46,"ا",2,0],["وإِنْ تَجافَيْتِني بِلا سَبَبٍ","فما أَمرَّ الجَفا وأَحْلاكِ",47,"ك",1,0],["وأنت جمعت من قلبي","هوى قد كان مشتركا",48,"ك",2,0],["وإن تجد من الثلاثي كأدَد","فاصرفه عنهم بالسماع أو لُبَد",49,"د",1,0],["وإن تجد فائدة في النكره","فابدأ به وادع ونوّع صوره",49,"ه",1,0],["وإن تجد كل القصيد للرجز","وواحد من كامل فقد غمز",50,"ز",1,0],["وان تُجدد غيرَها في الشهر لم","تنظر بها تغيُّرا في الوضعِ ثَم",51,"م",1,0],["وان تجد صلابةً فيُشتَرط","ان تنحت الوجه الذي له فقط",51,"ط",1,0],["وان تجد كلاهما سيانِ","فمستوٍ في الوصف والبيانِ",51,"ن",1,0],["وانتجت مريم عيسى المسيح به","كأنما هو للروح المسيح أب",52,"ب",1,0],["وأَنت جَوادٌ يملك الجودُ مالَهُ","فيغني ذوي الحاجات أَو يكرم الوَفْدَا",53,"د",2,0],["وأنتَ جوادٌ يا عليُّ ومُجتدّى غدا","حوضُك المورود ملآن مُطْفحا",54,"ح",2,0],["وأنت جدير بها من قدي","مِ ولكنها حكمة قاضيه",55,"ي",2,0],["وَإِن تجدي ما خلف ظَهركِ واسِعا","فَما قِبَلي من جانِب الأَرضِ أَوسَع",56,"ع",1,0],["وانتجع مَربعَ عيش خَضِل","واطلبِ الرزق بربع خَصِب",57,"ب",1,0],["وان تجد نفسى شكت أينها","فاصبب علىّ الكاس أودنها",58,"ه",2,0],["وإنْ تَجانَفَتِ الأيّامُ قوَّمَها","بعزمِ مُخْتَبرٍ في حدِّ مُهْتَبِل",59,"ل",1,0],["وإن تجرد منهما الرضيعة","فلم تكن بذاتها ممنوعه",60,"ه",1,0],["وإِن تجاهلتَ فأَنصارُ دِي","نِ اللَهِ من آبائِه الأكرَمِين",61,"ن",1,0],["وأنتج منه محو كل ضلالة","إلى أن أنار الدين بالحق وانتشر",62,"ر",1,0],["وأنت جدير في مسارك دائما","يوفقك المولى لما كنت تعمل",63,"ل",1,0],["وانتجزَ الوعدُ في لقاءٍ","ألقى عصَاهُ بهِ السُّرورُ",64,"ر",1,0],["وان تجد بينهم يوماً أخا شرف","وعفة تلقهم منه مضاجيرا",65,"ر",2,0],["وانتجعتْ دمعي بروق لمعت","بأبرق السّفح فظلّ سافحا",66,"ح",2,0],["وإن تجليت في شرقي مشهده","علماً تنزه فيك العالُ والدون",67,"ن",1,0],["وإن تجلت من الأكوان كلِّهم","فاسق المواطرَ حيّاً من بني مطر",68,"ر",1,0],["وان تجد خبنا وحذفا فيها","فضربها أبتر أو يحكيها",69,"ه",2,0],["وان تجدب ربوع العلم يوماً","سقاها علمك الصافي العهادا",70,"د",2,0],["وَإِن تَجمَعِ الآفاتِ فَالبُخلُ شَرُّها","وَشَرُّ مِنَ البُخلِ المَواعيدُ وَالمَطلُ",71,"ل",1,0],["وان تجاسر في أكل الرغيف غدا","كأنه جبل في الجوف يحمله",72,"ل",2,0],["وَأَنتَجت أَفراخاً مَضوا لِسَبيلهم","عَلى حينِ نَقلٍ مِن سَريرٍ وَمِن مَهدِ",73,"د",1,0],["وإن تجدي شكّاً بقولي فجربي","بواحدةٍ تمسي وعندك ما عندي",74,"د",2,0],["وإن تجاوز في ظُلم الورى أحدٌ","حدّا تجاوز وتُب عليه لم يهج",75,"ج",1,0],["وان تجشيت فاستر قبحه بثنا","وانس جليسك في اكل وفي كلم",76,"م",1,0],["وان تجد حاجة عنت له فإذا","بادر اليها ببذل المال والقدم",76,"م",1,0],["وان تَجَلَّت جلَت عيوناً","بنور وجهٍ بلا نِقابِ",77,"ب",1,0],["وَإِنْ تَجِدُوا بِالشِّعْبِ سَيْلاً وَلُجَةً","فَأَنْتُمْ بِمَجْرَى الدَّمْعِ يَا سَاكِني قَلْبِي",78,"ب",2,0],["وَإِن تَجَرَّدَ أَمثالٌ خَدعتَ بِها","مِنَ الفَرَزدَقِ يَمضي ما مَضى السَفَرُ",79,"ر",1,0],["وأنتَ جلوتَ دولتَه هَدِيّاً","وقد لبِسْتَ سرابيلَ القَتامِ",80,"م",1,0],["وَاِن تَجهَل لَهُ وَزناً وَمَعنى","فَسَل عَنهُ ابا زَيد الهِلال",81,"ل",1,0],["وَإِن تُجهَدِ الأَموالُ لا يَعجَزِ النَدى","عَلَينا فَذو صَبرٍ كَريمٌ وَهاضِمُ",82,"م",1,0],["وَإِن تَجاسَرتِ أَن تَقولي","قولي إِذا بَدا",83,"د",2,0],["وانتجعنا حماه إذ هجم العس","ر فنلنا الغنى وحزنا النجاحا",84,"ح",2,0],["وإن تجهلوا أمري فغن صحائفي","حوت من حديث العز قولا مفصلا",85,"ل",2,0],["وَإِن تجهلوا أَمري فَإِن دماءكم","إِلى اليَوم ما جَفّت بِأَعتابنا سفكا",86,"ك",2,0],["وان تجلى البدر من افقه","واخترقت أنواره غرفتي",87,"ي",1,0],["وأنتجت الأفكار فيك عجائبا","روائع ما إن يستطاع لها حصر",88,"ر",1,0],["وإن تجلَّيتَ برحمةٍ تُرى","فكن لنا برحمةٍ مكثِّرا",89,"ر",2,0],["وأنت جامعٌ ويا بديعُ","كمِّلْ قضاء حاجتي سريعُ",90,"ع",1,0],["وإن تجد عجبا منه فلا عجب","وما ببدع من البحر الأعاجيب",91,"ب",1,0],["وَإِن تَجزَعِي لِلبيَنِ لَستُ بِجَازِعٍ","وَلاَ تَاركٍ رَأيَ الصَّوَابِ المُسَدَّدَا",92,"د",2,0],["وَإِن تجبر بِوَصلِكَ كَسر قَلبي","تَبَيَّنَ مِنكَ مِنٌّ لا يَبورُ",93,"ر",1,0],["وَإِن تَجاهَلتَ فاِدري","سُلوانَ ذي الاكتِئابِ",94,"ب",1,0],["وإن تجرَّد منهُ حرفُ آخرهِ","في الأصل والقلب فيه الأمر قد ظهرا",95,"ر",2,0],["وان تجد بالعام في رسالة","تغني عن البدور والغزالة",96,"ه",1,0],["وَإِنْ تَجاوَزَ في زَعْمٍ لَهُ وَغَلاَ","فَلْيَحْتَقِرْ مَدْحَهُ وَلْيَقْصُرِ الاََمَلاَ",97,"ل",2,0],["وأنت جامعُ ما فيهنَّ من حَسَنٍ","فقد تكامَلَ فيك النفعُ والضرَرُ",98,"ر",1,0],["وانت جواد حلبة كل فضل","بميدان الفصاحة والكمال",99,"ل",1,0],["وأنت جوهر ذاك ال","حد الذي لا يفلُّ",100,"ل",1,0],["وَأَنتِ جَنَّةُ رَيحانِ لَها أَرَجٌ","أَو رَوضَةٌ نُضِحَت بِالوَبلِ وَالدِيَمِ",101,"م",1,0],["وان تجرى الارتال كالبرق سرعة","وكالرعد جلجالا وكالغيث تنويلا",102,"ل",2,0],["وان تجرى الانهار في الارض عذ