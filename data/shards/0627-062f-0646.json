ttps://www.poetsgate.com/ViewPoem.aspx?id=214648",""],[6036,"قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=84095",""],[6093,"ما للهوى أعذارُ","https://www.poetsgate.com/ViewPoem.aspx?id=178349",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6093,"تركة شيب","https://www.poetsgate.com/ViewPoem.aspx?id=206166",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["أَدنى قَرابَتِنا إِليها أَنَّنا","شَخصانِ يَجمَعُنا إِلَيهِ نِزارُ",0,"ر",1,0],["أَدنى لِشَرٍّ مِن كِلابٍ عُقدِ","وَهُم أَذَلُّ مِن كِلابٍ عُقدِ",1,"د",1,0],["أَدنى مَرامِكَ هِمَّةٌ","فَوقَ السِماكِ الأَعزَلِ",2,"ل",1,0],["أَدْنَى أَحَادِيثِهِ لَوْ رُوجِحَتْ رَجَحَتْ","أَغْلَى النَّفَائِسِ بِالأَقْدَارِ وَالقِيَمِ",3,"م",1,0],["أَدنى تَقاذُفِهِ التَقريبُ أَو خَبَبٌ","كَما تَدَهدى مِن العَرضِ الجَلاميدُ",4,"د",1,0],["أَدْنَى الحجيجُ مزارهنَّ ثلاثةٌ","بمِنّى لَوَاَنَّ مِنىَ ديارُ قرارِ",5,"ر",1,0],["أدنيت من نارِ فكري عودَ مبعثه","عند الثناء ففاحت نفحة العود",6,"د",1,0],["أدنى حياصته إلى أردافه","فانظر لزخرفها على الأحقاف",7,"ف",1,0],["أدنيت للطرفِ قبراً أنت ساكنه","عسى أساعد في شجوي وفي قلقي",8,"ق",2,0],["أَدَنَيتَني مِنكَ حَتّى","ظَنَنتُ أَنَّكَ أَني",9,"ن",2,0],["أَدنو فَيُبعِدُني خَوفي فَيُقلِقُني","شَوقٌ تَمَكَّنَ في مَكنونِ أَحشائي",10,"ا",3,0],["أَدْنِ شخصي إذا شَدَتْ لك بستا","نُ وغنت غناءها غَنَّاءَ",11,"ا",2,0],["أدناهما مثل السقام والدنف","بيتك بيت نَطِفٌ كلَّ النطف",12,"ف",1,0],["أدنته منها الأمُّ الأسيفه","وهي لبادي الدموع تخفى",13,"ف",2,0],["أَدُنيا الخَيلِ يا مَكسي","كَدُنيا الناسِ غَدّارَه",14,"ر",2,0],["أَدنى اِبتِسامٍ مِنكَ تَحيا القَرائِحُ","وَتَقوى مِنَ الجِسمِ الضَعيفِ الجَوارِحُ",15,"ح",1,1],["أَدنى مَزارٍ وَسطَ أَحسَنِ بُقعَةٍ","وَأَجَلَّ زُوّارٍ لِأَبهى مَجلِسِ",16,"س",1,0],["أَدنو وَأُقصِرُ عَن مَداهُ وَإِنَّما","أَرمي مِنَ المَلعونِ في بُرجاسِ",17,"س",1,0],["أَدنو وَتَبعُدُ في الوِصالِ مُنَكِّباً","عَنّي وَتِلكَ قَضِيَّةٌ لا تُرتَضى",18,"ض",2,0],["أَدنى مَنازِلِها لِطالِبِها","خِمسُ المُؤَوِّبِ لِلقَطا الكُدرِ",19,"ر",1,0],["أدنَى المَكارِمَ وهيَ نازِحَةٌ","بالجودِ منه وشرَّدَ العُسْرا",20,"ر",2,0],["أدنو إلى الرُّقَباءِ لا من حبِّهم","وأصدُّ عنه وليس من بَغضائِه",21,"ا",3,0],["أَدنَتهُ أَيدي العيسِ مِن ساحَةٍ","كَأَنَّها مَسقَطُ رَأسِ الغَريبِ",22,"ب",1,0],["أَدنَيتُ رَحلي إِلى مُدنٍ مَكارِمَهُ","إِلَيَّ يَهتَبِلُ اللَذ حَيثُ أَهتَبِلُ",23,"ل",1,0],["أَدنِ المُعَبَّدَةَ السِنادَ وَأَنئِها","بِالسَيرِ ما دامَ الطَريقُ مُعَبَّدا",24,"د",2,0],["أَدنَت نِقاباً عَلى الخَدَّينِ وَاِنتَسَبَت","لِلناظِرينَ بِقَدٍّ لَيسَ يَنتَسِبُ",25,"ب",1,0],["أدنيتُها مِنْ خدِّهِ","والنارُ فاكهةُ الشتا",26,"ت",2,0],["أَدنو وَيَجمَحُ بِيَ الإِباءُ فَأَعزُبُ","وَأَرى الرضى آناً وَآناً أَغضَبُ",27,"ب",1,1],["اُدْنُ يا جعفرٌ لك الرتَبُ العل","يا وكنتَ أمرأً بهن قَمِينا",28,"ن",2,0],["اُدنُ يا أشبهَ الرجالِ بأعلى ال","ناسِ قَدْراً وخيرهم أجمعينا",28,"ن",2,0],["أدنى الرجالِ من المهالك مَن إذا","عَرضتْ منايا الخالدينَ أباها",29,"ا",3,0],["أُدَنّيها مِن الجَدوى","وَتُدنيني مِنَ الكَربِ",30,"ب",1,0],["اِدنُ مِنّي تَلقَني ذا مِرَّةٍ","ناصِحَ الجَيبِ كَريماً في الإِخا",31,"ا",1,0],["أَدُنياكَ تَخطُبُها أَيِّماً","وَيُعضِلُها دونَكَ العاضِلُ",32,"ل",1,1],["أَدُنيايَ اِذهَبي وَسِوايَ أُمّي","فَقَد أَلمَمتِ لَيتَكِ لَم تُلِمّي",33,"م",2,1],["أدْنى الفوارِسِ مَن يُغِيرُ لمَغْنَمِ","فاجْعَلْ مُغَارَكَ للمَكارِم تَكرُمِ",34,"م",1,1],["أدْنَيْنَني حتّى إذا التَهبَ الجَّوى","أقْصَيْنَني أضعافَ ما أدْنَينَني",35,"ن",2,0],["أَدنى المَراتِبِ في الصَبابَةِ عِندَها","تَلَفُ المُحِبِّ وَطولُ وَجدِ المُغرَمِ",36,"م",1,0],["أدَنا المزارُ وقرَّت العينانِ","وفرغتما من لهفةٍ وحنانِ",37,"ن",1,1],["أَدُنيايَ مالي في اِنقِطاعي وَغُربَتي","إِلَيكِ ثَوابٌ مِنكِ دَينٌ وَلا نَقدُ",38,"د",1,0],["أَدْنى الرِّجَالِ إِلَى الكَمَالِ وَلَمْ يَكُنْ","فِي العَصْرِ شَيْءٌ مُغْرِياً بِكَمَالِ",39,"ل",1,0],["أَدْنَاهُ مُخْتَصّاً بِهِ فَوَفَى لَهُ","بِفُؤَادِ شَهْمٍ لاَ لِسَانِ مُمَاذِقِ",40,"ق",1,0],["أَدْنَى الْكِفَاحِ كِفَاحُ المَرْءِ عَنْ سَفَهٍ","لِلاحْتِفَاظِ بِعُمْرٍ رَهْنِ تَحْدِيدِ",41,"د",1,0],["أَدْنَى فِعَالِكَ لاَ يُكَافِئُهُ","أَسْنَى الْقَرِيضَ وَأَفْصَحُ الخُطُبِ",42,"ب",1,0],["أَدْنَاهُ عَبْدُ اللهِ مِنْهُ فَبَاتَ فِي","نُعْمَى وَطَالِعُهُ لَدَيْهِ سَعِيدُ",43,"د",1,0],["أَدْنَى مِنَ الْمَلِكِ الْعَظِيمِ مَكَانَهُ","صِدْقٌ وَرَأْيٌ فِي الأُمُورِ سَدِيدُ",44,"د",1,0],["أدنو... اطل","ينتشي التصفيقْ",45,"ق",1,0],["آدَني دَهري فَأَبَّدني","وَاِحتَمى في العِبءِ فَاِحتَمَلا",46,"ل",2,0],["أدنى حقوقك تشقيق القلوب واز","هاق النفوس متى تخطر لمدكر",47,"ر",1,0],["أدنى المواطن موطن إن هزّه","جرح الكرامة للصراع تمادى",48,"د",2,0],["أدنو ولا يعرفنني","أبكي ولا يسألن : مثالي",49,"ل",2,0],["أدنو فيبعدني خوف فيقلقني","شوق تمكّن في مكنون أحشائي",50,"ا",3,0],["ادْنُ مِنِّي تلْقَني ذا مِرَّة ٍ","ناصِح الحُبِّ كرِيماً في الإِخا",51,"ا",1,0],["أدنو ولا حرفتي أبكي ولا يسألن : مالي","وأقول : من أين الطريق ؟ وهنّ أغبى من سؤالي",52,"ل",2,0],["أُدَنِّسُ عِرضَ المَرءِ حَتَّى كَأنَّهُ","بِنُقبَةِ نَقسٍ شِيبَ أَو قِطِرَانِ",53,"ن",1,0],["أدنا همو من أمانيهم وأبعدني","فما أكترثت بإدناءٍ وتبعيدِ",54,"د",1,0],["أَدناهُ مِن أَندى الأَئِمَّةِ راحَةً","لِمُؤَمِّليهِ أَكرَمُ الوُزَراءِ",55,"ا",2,0],["أَدنى الرَجاءُ إِلَيكَ مَن لَم يُدنِهِ","وَطَنٌ لَقَد نادى نَداكَ فَأَسمَعا",56,"ع",2,0],["أَدنَيتَ لي الحَظَّ الَّذي عَهدي بِهِ","وَإِذا دَنا يَوماً تَأَخَّرَ عاما",57,"م",2,0],["أدنت ذويه واقضتهم سياسته","فهم لديه ولا يدرون أين هم",58,"م",1,0],["أَدنيتَه منك تقريباً فكان له","به جمالٌ وإجلال وإيناس",59,"س",1,0],["أدن خديك من فؤادي قليلا","جمرة الزهر يشتهيها الغريق",60,"ق",1,0],["أدن ثغريك من فؤادي قليلا","إنني ظامىء وأنت الرحيق",60,"ق",1,0],["أَدَنت يداك مِن اللمى نربيجها","متبطِّناً بِالزَنبَقِ المَحبوكِ",61,"ك",1,0],["أَدْنَفْتَني مذْ شَكَت ألحاظُك الدّنفا","وانقدّ خصرُك لِينا وانْثنى هَيَفَا",62,"ف",2,1],["أَدنى صَبابَةِ مُهجَتي فيهِ الَّذي","أَضحَت حَديث عَجائِبَ وَنَوادِرِ",63,"ر",1,0],["أَدنى مَحَلَّتَها عَلى","شَحطِ المَزارِ وَقَرَّبا",64,"ب",2,0],["أَدنَتكَ مِنهُ فِراسَةٌ نَبَوِيَةٌ","تُملي عَليهِ الحَقَّ وَهوَ مُغيَّبُ",65,"ب",1,0],["أدنَت مُسامَرَتي حتَّى إذا بَلَغَت","غالت حياتي وفاتَتني بمجلُودِ",66,"د",1,0],["أَدنيتَ حَين تَميم حينَ صُلتَ بِهِ","وَرُعتَ ياقوتاً المُستَكبرِ الجاني",67,"ن",2,0],["أَدنى مَراشِفَه فَقُلتُ تَعَجّباً","كَذِبَ الَّذي زَعمَ الخَيالَ مِن المُنى",68,"ن",2,0],["أدنتي لماذا قلتَ شرُّ بلاءِ","على المرءِ ذكرُ السَّعدِ يومَ شقاءِ",69,"ا",2,1],["أَدناه من قاب قوس حين كلمه","بالغَيب من بعد ما قالَ التَحيات",70,"ت",1,0],["أَدْنى اشْتِياقِي أَنْ أَبِيتَ عَلِيلاً","وَأَقَلُّ وَجْدِي أَنْ أَذُوبَ نُحُولا",71,"ل",2,1],["أدنُ مني فدتكَ نفسي ولا تبخل","فقلبي يفيضُ بالأشواق",72,"ق",1,0],["أَدنيتُه نظراً مني لحرمته","وَذو الديانة للأَرحام يحترمُ",73,"م",1,0],["أَدنِهِ منكَ جِواراً فَلَقَد","ضاقَ وَاللَه به في الهِند فَسحُ",74,"ح",1,0],["أَدنو فيُقصيني جَفاها راهِباً","منها وتُدنيني الصَبابَةُ راغِبا",75,"ب",2,0],["أدنني منك","على قربك من سرى وجهري",76,"ي",1,0],["أدنني منك فما أدري","بما أصبحت تدري",76,"ي",1,0],["أدنني منك قليلا","وادن من روحي قليلا",76,"ل",2,0],["أَدنو فَيُبعِدُني بِغَيرِ جِنايَةٍ","مِنّي وَيُكَلِّمُني بِسوءِ كَلامِهِ",77,"م",2,0],["أدنيتهُ فَنأى وَزاد بِعجبه","وَرَمى بِسَهم الصَدّ قَلب مُحبّهِ",78,"ه",1,0],["أَدْنَى المُعنَّى منه حتّى إذا","تَيَّمَهُ في الحُبِّ أَقْصاه",79,"ا",2,0],["أدناكِ من بلدٍ فيه البَديعُ ومن","لُقياهُ أقصاكِ ظُلْماً حينَ أدْناك",80,"ك",1,0],["أدْنَى إليهمْ خُلُوُّ الرَّبْعِ مِن أَنَسٍ","وطالما كرَع الظَّمآنُ في الرَّنَق",81,"ق",1,0],["أدنَى اليمانينَ منّا البرقُ إذ رَحلوا","فبات يُسرِعُ خلْفَ الرَّكْبِ مُرتكضا",82,"ض",2,0],["أدْنَى سَراياكَ ما تَرمي العدوَّ به","كوامناً خيلُه في طَيِّ قِرْطاس",83,"س",1,0],["أدنيتُ في مَدحِكَ أقطارها","منِّي فما للأرضِ أقطارُ",84,"ر",1,0],["أدنى الصغائر يأباها فكيف ترى","في تي الكبائر مُنْتَشْباً ومنتشطا",85,"ط",2,0],["أدنى شواظ النار يؤلمُ مَسُّه","من ذا يطيق جحيمها بذكائه",86,"ا",3,0],["أَدنى مَناقبك الفت","وَّة وَالمُروَّة وَالكَرَم",87,"م",1,0],["أدَنْت نحو