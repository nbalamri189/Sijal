"],[3934,"","https://poetry.dctabudhabi.ae/diwan/poem/132032","الخفيف"],[4109,"","https://poetry.dctabudhabi.ae/diwan/poem/97555","البسيط"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95800","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83125","السريع"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35082","البسيط"],[5149,"أيها القدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212221",""],[4045,"إن شمل الشيب قناع البلى","https://www.poetsgate.com/ViewPoem.aspx?id=200281",""],[2110,"لا تبك رسما عفا ولا طللا","https://www.poetsgate.com/ViewPoem.aspx?id=156290",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""]],"verses":[["لا يظلمنِّي ولا سِنى ولا","يظلم خلاخيله ولا أُزرَه",0,"ر",2,0],["لا يظهر التأثير في أمة","ترى نوال السعد في بعده",1,"د",2,0],["لا يَظُنَّنَّ مَعشَري أَنَّ بُعدي","عَنهُمُ اليَومَ موجِبٌ لِلتَراخي",2,"خ",2,1],["لا يَظهَرُ العَجزُ مِنّا دونَ نَيلِ مُنىً","وَلَو رَأَينا المَنايا في أَمانينا",3,"ن",2,0],["لا يُظهِرُ الدَهرُ ما في فَصلِ بَيعَتِهِ","إِلى المَجالِسِ إِلّا وَهوَ يَرتَعِدُ",4,"د",1,0],["لا يظلم الحر إلا من يطاوله","ويظلم النذل أدنى منه في الصول",5,"ل",1,0],["لا يَظُنُّ الأَعداءُ أَنَّ مُقامي","حَيثُ يَغتالُني المَحَلُّ الشَحيطُ",6,"ط",1,0],["لا يظن الدهر اني مهمل","بعد مدحي من يجيز الشعرا",7,"ر",2,0],["لا يظنّ المصاب فقد نعيمٍ","قَد يكون النعيم عين المصابِ",8,"ب",1,0],["لا يَظعَنونَ عَلى عَمياءَ إِن ظَعَنوا","وَلا يُطيلونَ إِخماداً عَنِ السُرَبِ",9,"ب",1,0],["لا يَظفَرُ الفَرّارُ منك بمأْمَنٍ","حتّى يَصيرَ مُجاوِرَ الدِّيماس",10,"س",1,0],["لا يظفرنّ الحزنُ منك بمهجةٍ","لم تلق يوما ما له تتذلّلُ",11,"ل",1,0],["لا يظن الزمان أنك تنسى","عظم الخطب فالسلو عسير",12,"ر",1,0],["لا يظهرون من جميع ما به","قد وصفوا فعلا من الأفعال",13,"ل",1,0],["لا يظهر المخفي عن","عينيك إلا بعد طمسك",14,"ك",1,0],["لا يَظُنُّ الصحيحُ فجأةَ سُقمٍ","وإذا اعتَلَّ لا يَظُنُّ شِفاءَ",15,"ا",2,0],["لا يُظهرُ الجبنَ ولا الشجاعهْ","مُصطنِعاً دَهاه واخْتداعهْ",16,"ه",1,0],["لا يظنَّ الفتيان أن يَسبقوني","بشبابِ أخذت منه نَصيبي",17,"ب",2,0],["لا يظهر في الرمل إن مشت قدماه","والصخر له خر ساجدا وله لان",18,"ن",1,0],["لا يظُنّ الظنون أنّ مقامي","بالينيبع لاطّلّاب العلوم",19,"م",1,0],["لا يظعنون على العمياء إن طغنوا","ولا يمارون إن ماروا بإكثار",20,"ر",1,0],["لا يظهرُ البِشْرُ في رِضَاهُ ولا","يُعرفُ وجهُ القُطُوبِ في غَضَبِهْ",21,"ب",2,0],["لا يظن الجهول ذلك لهواً","من سليمان أو علي وافتخار",22,"ر",1,0],["لا يُظْمِئُ الوجدُ الحُمولَ التي","سرَتْ ومن دمْعي لها مَشرَبُ",23,"ب",1,0],["لا يظلم المرء سوى نفسه","ولا يخاف المرء من غيره",24,"ر",2,0],["لا يظن الحسود ذاك وإن د","بّ دبيب التوريد في وجنتيه",25,"ي",2,0],["لا يظن العدو أن انحنائي","كبر عندما عدمت شبابي",26,"ي",1,1],["لا يظهر البشر في دجاها","كلّا ولا يبصر الخفر",27,"ر",1,0],["لا يَظهر العيدُ في أَقطارهم أبداً","إذ كُل أيامهم من حُسنها عيد",28,"د",1,0],["لا يَظفَرُ المُحسِنُ فيها وَلَو","بِالخادِع المَمطولِ مِن وَعدِه",29,"د",2,0],["لا يُظهِرُ السُكرُ حالاً مِن ذَوائِبِهِم","إِلا اِلتِفافَ الصَبا في أَلسُنِ العَذَبِ",30,"ب",1,0],["لا يُظْهِرُ الَمرْءُ إلّا قَيْدَ أَنْمُلَةٍ(6)","مِنَ الخَبايَا، بِمُغْري القَولِ يَستترُ",31,"ر",1,0],["لا يظفر الواشى بإفساد ما","بينهم إن دبّ نزّاغا",32,"غ",2,0],["لا يظمأ الدهر قط واردها","ولا يرى عن نعيمها حولا",33,"ل",2,0],["لَا يُظْلَمُونَ؛ فَكَيْفَ بَعْدُ تَقَوَّلُوا:","الدِّينُ دِينُ الْجُورِ وَ الطُّغْيَانِ?!",34,"ن",1,0]]}