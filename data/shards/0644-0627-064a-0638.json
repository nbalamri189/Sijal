{"poems":[[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[85,"اسمعنا بارنج في صده","https://www.aldiwan.net/poem7265.html","السريع"],[66,"لا يظنن معشري أن بعدي","https://www.aldiwan.net/poem41574.html","الخفيف"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[158,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[162,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[269,"بارق بالابرق الفرد سرى","https://www.aldiwan.net/poem52054.html","الرمل"],[303,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[361,"أمن رسوم بأعلى الجزع من شرب","https://www.aldiwan.net/poem1722.html","البسيط"],[362,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[456,"للنقص من أعمارنا ما يكمل","https://www.aldiwan.net/poem56077.html","الكامل"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[556,"الناس موصوفون بالأفعال","https://www.aldiwan.net/poem34198.html","الرجز"],[556,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"],[560,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"]],"verses":[["لا يظلمنِّي ولا سِنى ولا","يظلم خلاخيله ولا أُزرَه",0,"ر",2,0],["لا يظهر التأثير في أمة","ترى نوال السعد في بعده",1,"د",2,0],["لا يَظُنَّنَّ مَعشَري أَنَّ بُعدي","عَنهُمُ اليَومَ موجِبٌ لِلتَراخي",2,"ي",1,1],["لا يَظهَرُ العَجزُ مِنّا دونَ نَيلِ مُنىً","وَلَو رَأَينا المَنايا في أَمانينا",3,"ن",2,0],["لا يُظهِرُ الدَهرُ ما في فَصلِ بَيعَتِهِ","إِلى المَجالِسِ إِلّا وَهوَ يَرتَعِدُ",4,"د",1,0],["لا يظلم الحر إلا من يطاوله","ويظلم النذل أدنى منه في الصول",5,"ل",1,0],["لا يَظُنُّ الأَعداءُ أَنَّ مُقامي","حَيثُ يَغتالُني المَحَلُّ الشَحيطُ",6,"ط",1,0],["لا يظن الدهر اني مهمل","بعد مدحي من يجيز الشعرا",7,"ر",2,0],["لا يظنّ المصاب فقد نعيمٍ","قَد يكون النعيم عين المصابِ",8,"ب",1,0],["لا يَظعَنونَ عَلى عَمياءَ إِن ظَعَنوا","وَلا يُطيلونَ إِخماداً عَنِ السُرَبِ",9,"ب",1,0],["لا يَظفَرُ الفَرّارُ منك بمأْمَنٍ","حتّى يَصيرَ مُجاوِرَ الدِّيماس",10,"س",1,0],["لا يظفرنّ الحزنُ منك بمهجةٍ","لم تلق يوما ما له تتذلّلُ",11,"ل",1,0],["لا يظن الزمان أنك تنسى","عظم الخطب فالسلو عسير",12,"ر",1,0],["لا يظهرون من جميع ما به","قد وصفوا فعلا من الأفعال",13,"ل",1,0],["لا يظهر المخفي عن","عينيك إلا بعد طمسك",14,"ك",1,0],["لا يَظُنُّ الصحيحُ فجأةَ سُقمٍ","وإذا اعتَلَّ لا يَظُنُّ شِفاءَ",15,"ا",2,0]]}