{"poems":[[75,"عمر من يعمر ذا المجلسا","https://www.aldiwan.net/poem11931.html","السريع"],[95,"ملك العراق تجلة وسلام","https://www.aldiwan.net/poem11313.html","الكامل"],[85,"الملك أصبح علينا","https://www.aldiwan.net/poem54204.html","مجزوء الرمل"],[74,"مسلسل الدمع أسير الفؤاد","https://www.aldiwan.net/poem18550.html","السريع"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[74,"والذي زاد مقليك اقتدارا","https://www.aldiwan.net/poem18699.html","الخفيف"],[53,"حان كلام المعاتب الخرس","https://www.aldiwan.net/poem64655.html","المنسرح"],[80,"الملك في طي الدفاتر","https://www.aldiwan.net/poem14190.html","مجزوء الكامل"],[80,"أرمدت أم بنجومك الرمد","https://www.aldiwan.net/poem14197.html","أحذ الكامل"],[87,"قالوا فرنسا أنذرت سلطاننا","https://www.aldiwan.net/poem7587.html","الكامل"],[87,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[87,"قم ناج جلق وانشد رسم من بانوا","https://www.aldiwan.net/poem63693.html","البسيط"],[87,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[87,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[64,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[51,"هل عند أهل القبور من خبر","https://www.aldiwan.net/poem62099.html","المنسرح"],[68,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[68,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[68,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[71,"قد كان عبس باسما","https://www.aldiwan.net/poem28923.html","مجزوء الرجز"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[107,"هل في جفونكما دمع لممتاح","https://www.aldiwan.net/poem43147.html","البسيط"],[107,"عهد لمصر من الحياة جديد","https://www.aldiwan.net/poem43166.html","الكامل"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[83,"انهض بأمرك فالهدى مقصود","https://www.aldiwan.net/poem61540.html","الكامل"],[48,"لكون خلك في رمس أعز له","https://www.aldiwan.net/poem22258.html","البسيط"],[48,"الملك لله لا ننفك في تعب","https://www.aldiwan.net/poem22400.html","البسيط"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/14439","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30493","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54240","البسيط"],[108,"حرب الرذيلة","https://www.poetsgate.com/ViewPoem.aspx?id=179641",""],[153,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[163,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[163,"أتاكم من يسترد الغصبا","https://www.aldiwan.net/poem58809.html","الرجز"],[163,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[163,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[163,"أطمع في الوصل وما أناله","https://www.aldiwan.net/poem58915.html","الرجز"],[163,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[163,"الملك الناصر سلطاننا","https://www.aldiwan.net/poem58962.html","السريع"],[163,"بالسعد دار نجم هذا الدار","https://www.aldiwan.net/poem58972.html","الرجز"],[163,"إن له فرط غرام وأسا","https://www.aldiwan.net/poem58976.html","الرجز"],[163,"لم أستطع أنهى اللتي انهلت","https://www.aldiwan.net/poem59009.html","السريع"],[163,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[163,"الدين دين ربنا والملك","https://www.aldiwan.net/poem59186.html","الرجز"],[228,"اليوم آن لشاكر أن يجهرا","https://www.aldiwan.net/poem55197.html","الكامل"],[232,"لم يسمع القلب فيه للناهي","https://www.aldiwan.net/poem50734.html","المنسرح"],[232,"أنعم من العيش بما تشتهي","https://www.aldiwan.net/poem51135.html","السريع"],[232,"جارية مرهفة القد","https://www.aldiwan.net/poem51177.html","السريع"],[238,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[238,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[262,"إن سطا الدهر واعتدى","https://www.aldiwan.net/poem35952.html","مجزوء الخفيف"],[264,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[273,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[273,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[285,"هذا الحمى ورنده وبانه","https://www.aldiwan.net/poem32404.html","الرجز"],[285,"الملك الأمجد الذي شهدت","https://www.aldiwan.net/poem32661.html","المنسرح"],[323,"الملك لله جل القرد والشان","https://www.aldiwan.net/poem61619.html","البسيط"],[351,"صار أيري دجاجة تخصن البي","https://www.aldiwan.net/poem20153.html","الخفيف"],[356,"الملك لله من شاء الإله به","https://www.aldiwan.net/poem39591.html","البسيط"],[367,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[367,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[367,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[405,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[412,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[440,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[455,"الأخطبوط أراه بدل شكله","https://www.aldiwan.net/poem61358.html","الكامل"],[455,"يا مالكا لا عن وراثة شامخ","https://www.aldiwan.net/poem61646.html","الكامل"],[460,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[465,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[516,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[517,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[529,"الملك عندي متعة الشباب","https://www.aldiwan.net/poem45953.html","الرجز"],[553,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[555,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[577,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"]],"verses":[["المَلِكُ الغَمرُ النَدى المُقتَني","مِن كُلِّ حَمدٍ عِلقَهُ الأَنفُسا",0,"س",2,0],["المُلْكُ فِي بَغْدَادَ حُرٌّ رَاسِخٌ","وَالعَيشُ فِي بَلَدِ السَّلامِ سَلامُ",1,"م",1,0],["الملك أصبح علينا","هاذ هو صباح الأفراح",2,"ح",1,1],["الملك تقول جينا","أو أحد يمشي بمصباح",2,"ح",1,0],["الملك العابد نام الورى","بعدله وهو كثير السهاد",3,"د",1,0],["الملك العالم والضيغم ال","باسل والمفرد والندره",4,"ر",2,0],["المليك المؤيد اللازم السؤ","دد إن حلَّ حلَّ أو سار سارا",5,"ر",2,0],["الملكُ إن كنتَ ناظراً نسَبٌ","بين ابن بَهرامَ وابن تَوفُلُس",6,"س",1,0],["الملكُ في طيّ الدَفاتِرْ","فَتخلّ عَن قَود العَساكِرْ",7,"ر",1,1],["المُلكُ لا يُبقي عَلى أَحَدٍ","وَالمَوتُ لا يَبقى لَهُ أَحَدُ",8,"د",1,0],["الملك بينهما بأيمن طالع","والدين بينهما بخير منار",9,"ر",1,0],["المُلتَقي الأَحداثَ إِن","نَزَلَت كَأَن لَم تَنزِلِ",10,"ل",1,0],["المُلكُ أَن تَعمَلوا ما اِستَطَعتُمو عَمَلاً","وَأَن يَبينَ عَلى الأَعمالِ إِتقانُ",11,"ن",1,0],["المُلكُ أَن تُخرَجَ الأَموالُ ناشِطَةً","لِمَطلَبٍ فيهِ إِصلاحٌ وَعُمرانُ",11,"ن",1,0],["المُلكُ تَحتَ لِسانٍ حَولَهُ أَدَبٌ","وَتَحتَ عَقلٍ عَلى جَنبَيهِ عِرفانُ",11,"ن",1,0],["المُلكُ أَن تَتَلافَوا في هَوى وَطَنٍ","تَفَرَّقَت فيهِ أَجناسٌ وَأَديانُ",11,"ن",1,0],["المُلكُ كانَ وَلَم يَكُن قُطنٌ فَلَم","يُغلَب أُبُوَّتُنا عَلى عُمرانِهِ",12,"ن",2,0],["المُلكُ مَرتَبَةُ الشُعوبِ فَإِن يَفُت","عِزُّ السِيادَةِ فَالشُعوبُ سَوامُ",13,"م",1,0],["المُلكُ وَالدُوَلاتُ ما يَبني القَنا","وَالعِلمُ لا ما تَرفَعُ الأَحلامُ",14,"م",1,0],["المُلكُ بَينَ يَدَيكَ في إِقبالِهِ","عَوَّذتُ مُلكَكَ بِالنَبِيِّ وَآلِهِ",15,"ل",2,1],["المُلكُ زُلزِلَ في فُروقٍ ساعَةً","كانوا لَهُ الأَوتادَ في زِلزالِهِ",15,"ل",2,0],["المُلكُ لِلإِناثِ في الد","دُستورِ لا لِلذُكَرَه",16,"ر",2,0],["الملك الشيخ العقيم الذي","تحت يديه الحزن والسهلُ",17,"ل",1,1],["المُلكُ لِلَّهِ لا شَريكَ لَهُ","تَجري القَضايا مِنهُ عَلى قَدَرِ",18,"ر",1,0],["المَلِكُ الصالِحُ الَّذي ظَهَرَت","مِنهُ السَجايا وَطابَتِ الشِيَمُ",19,"م",1,0],["المَلِكُ الجامِعُ الفَضائِلَ وَال","باذِلُ في الصالِحاتِ ما خَزَنَه",20,"ن",2,0],["المَلِكُ النَدبُ الَّذي شُكرُهُ","صارَ اِعتِباراً لِلوَرى وَاِصطِلاح",21,"ح",1,0],["الملحدونَ ابتهجوا","بموتِهِ والشِّيَعُ",22,"ع",1,0],["المُلكُ مُعتَصِمٌ بِهِ مُستَمسِكٌ","مِنهُ بِأَوثَقِ ذِمَّةٍ وَضَمانِ",23,"ن",1,0],["المُلكُ لِلَهِ كَم أَهوى بِمَملَكَةٍ","شَمّاءَ ما بَينَ إِمساءٍ وَإِصباحِ",24,"ح",1,0],["المُلكُ عالٍ وَالمَواكِبُ فَخمَةٌ","وَسَنا الحَضارَةِ واسِعٌ مَمدودُ",25,"د",1,0],["المُلكُ أَجمَعُ وَالجَلالُ لِواحِدٍ","صَمَدٍ تَبارَكَ وَحدَهُ وَتَسامى",26,"م",2,0],["المَلِكُ رَأسٌ أَنتَ مِغفَرُ رَأسِهِ","فيما يُباهي تاجُهُ المَعقودُ",27,"د",1,0],["المَلكُ يَحتاجُ أُلّافاً لِتُنصِرَهُ","وَالمَيتُ لَيسَ إِلى خَلقٍ بِمُحتاجِ",28,"ج",1,0],["المُلكُ لِلَّهِ لا نَنفَكُّ في تَعَبٍ","حَتّى تَزايَلَ أَرواحٌ وَأَجسادُ",29,"د",1,1],["المَليكُ الَّذي يَرى المَنَّ إِشرا","كاً بِوَصفِ اّلمُهَيمِنِ المَنّانِ",30,"ن",1,0],["الملك المنفرد الجبار","الدائم الجلال والإكبار",31,"ر",1,0],["المُلْحِفِينَ رِداءَ الشَّمْسِ مَجدهُمُ","والمُنْعِلِينَ الثُّرَيَّا أَخْمص القَدمِ",32,"م",1,0],["ألملم الجمرات الخضر من كبدي","وأستردّ الصّبا والحبّ والكبدا",33,"د",2,0],["أَلْمُلْكُ فِي إِبّانِ عِزَّتِهِ","شقَّ العنَانَ وطَاولَ الزُّهْرَا",34,"ر",2,0],["الملك كان ملكهم","سواه قعب من لبن",35,"ن",1,0],["المُلْك فِي بَيْتِكمْ كَسْباً وَمَوْهِبَةً","يُزْهَى عَلَى كلِّ مَوْهُوبٍ وَمُكْتَسَبِ",36,"ب",1,0],["المليك المليك","حُبُّه ملء قلوب المخلصينْ",37,"ن",1,0],["المُلْكُ فيكَ طَبِيعةٌ ووِرَاثةٌ","والمَجْدُ فيكَ سَليقَةٌ ونِجَار",38,"ر",1,0],["المُلْكُ في ظلِّه طَابتْ مَشارِعُه","والدِّينُ في عَهْدِه قَامَتْ شَعَائِرُه",39,"ر",2,0],["المُلْكُ بالأخلاق يُبْنَى أسُّه","لا بالمجازر والدَّمِ السفاح",40,"ح",1,0],["الملك ناس ذكره مَأمُو","نَهُ بك بل رشيده",41,"د",2,0],["الملك يؤتيهِ المهيمنُ من يشا","والحرصُ منك يزدك عنهُ بعادا",42,"د",2,0],["الملك الظاهر ذو المجد الذي","إذا دعا داع نداه لبا",43,"ب",2,0],["الملك عدل والمشد برفقه","لم يال في طلب عن المجهود",44,"د",1,0],["الملك بينكمُ بحقِ وراثةٍ","يقضي وبين الناس بالأقسامِ",45,"م",1,0],["الملكُ فيكم نسبةٌ خلقيةٌ","من جُملتي لحم به وعِظام",45,"م",1,0],["الملك المنصور بالسيف فمن","ما كره زواله زوا لَهُ",46,"ل",2,0],["الملك الناصر دين الهدى","ابن المليك الاشرف الهمة",47,"ه",1,0],["الملك الناصر سلطاننا","سامى الذرا المدرة مروى الصدا",48,"د",2,1],["الملك لله فهذا خبر","يكتب في غرائب الأخبار",49,"ر",1,0],["الملك الناصر من حسبي عطا","كون فناه لي مأوي وعطن",50,"ن",1,0],["الملك الناصر من نوره","نحو الهدى اضا التي ضلت",51,"ت",1,0],["الملك الناصر من لا خاطر","إلا له فيه حساب الجبر",52,"ر",1,0],["الملك الظاهر يحي من به","حي موحد ومات مشرك",53,"ك",1,0],["المُلكُ من يُمناه على العهدِ الذي","أَخَذَته قبلُ عليه ناضِرَةُ القُرى",54,"ر",2,0],["الملِك الوارث الإمامةَ عن","كلّ إمامٍ أغَرَّ أَواهِ",55,"ه",1,0],["الملبِسي النُّعْمَى التي صَيَّرتْ","أدانيَ اللُحْمة لي حُسَّدا",56,"د",2,0],["المُلكْ ذو عِقْد ولكنَّه","في عصره واسطةُ العِقْد",57,"د",1,0],["المَلِكُ العادِلُ في حُكمِهِ","فَهوَ مِنَ الأَملاكِ مَعدودُ",58,"د",1,0],["المَلِكُ العادِلُ الَّذي كَشَفَ ال","لَهُ بِهِ هَمَّ كُلِّ مَكروبِ",59,"ب",1,0],["المليك الشريف من","طاب أصلاً ومحتدا",60,"د",2,0],["الملوي الذي يؤرقه","جمع المعالي وبذل أنعمه",61,"م",2,0],["الملك لا يبنيه إلا هامهم","فالهام آساس لملكٍ واطد",62,"د",1,0],["الملكُ أصبحَ دَعوى في طوائفهم","واستمسكوا بعرى اللّذاتِ غاوينا",63,"ن",2,0],["المَلِكُ الأَشرَفُ شاه