"عذبة النجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64917&r=&rc=1",""],[2588,"إلمَ لصحبنا عنا استتار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83306&r=&rc=254",""],[6233,"في خمس دقائق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82085&r=&rc=30",""],[6325,"أمنيات لطفلٍ عاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88019&r=&rc=1",""],[4222,"نصر أنار لملككم برهانه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52911&r=&rc=203",""]],"verses":[["المَلِكُ الغَمرُ النَدى المُقتَني","مِن كُلِّ حَمدٍ عِلقَهُ الأَنفُسا",0,"س",2,0],["المُلْكُ فِي بَغْدَادَ حُرٌّ رَاسِخٌ","وَالعَيشُ فِي بَلَدِ السَّلامِ سَلامُ",1,"م",1,0],["الملك أصبح علينا","هاذ هو صباح الأفراح",2,"ح",1,1],["الملك تقول جينا","أو أحد يمشي بمصباح",2,"ح",1,0],["الملك العابد نام الورى","بعدله وهو كثير السهاد",3,"د",1,0],["الملك العالم والضيغم ال","باسل والمفرد والندره",4,"ر",2,0],["المليك المؤيد اللازم السؤ","دد إن حلَّ حلَّ أو سار سارا",5,"ر",2,0],["الملكُ إن كنتَ ناظراً نسَبٌ","بين ابن بَهرامَ وابن تَوفُلُس",6,"س",1,0],["الملكُ في طيّ الدَفاتِرْ","فَتخلّ عَن قَود العَساكِرْ",7,"ر",1,1],["المُلكُ لا يُبقي عَلى أَحَدٍ","وَالمَوتُ لا يَبقى لَهُ أَحَدُ",8,"د",1,0],["الملك بينهما بأيمن طالع","والدين بينهما بخير منار",9,"ر",1,0],["المُلتَقي الأَحداثَ إِن","نَزَلَت كَأَن لَم تَنزِلِ",10,"ل",1,0],["المُلكُ أَن تَعمَلوا ما اِستَطَعتُمو عَمَلاً","وَأَن يَبينَ عَلى الأَعمالِ إِتقانُ",11,"ن",1,0],["المُلكُ أَن تُخرَجَ الأَموالُ ناشِطَةً","لِمَطلَبٍ فيهِ إِصلاحٌ وَعُمرانُ",11,"ن",1,0],["المُلكُ تَحتَ لِسانٍ حَولَهُ أَدَبٌ","وَتَحتَ عَقلٍ عَلى جَنبَيهِ عِرفانُ",11,"ن",1,0],["المُلكُ أَن تَتَلافَوا في هَوى وَطَنٍ","تَفَرَّقَت فيهِ أَجناسٌ وَأَديانُ",11,"ن",1,0],["المُلكُ كانَ وَلَم يَكُن قُطنٌ فَلَم","يُغلَب أُبُوَّتُنا عَلى عُمرانِهِ",12,"ن",2,0],["المُلكُ مَرتَبَةُ الشُعوبِ فَإِن يَفُت","عِزُّ السِيادَةِ فَالشُعوبُ سَوامُ",13,"م",1,0],["المُلكُ وَالدُوَلاتُ ما يَبني القَنا","وَالعِلمُ لا ما تَرفَعُ الأَحلامُ",14,"م",1,0],["المُلكُ بَينَ يَدَيكَ في إِقبالِهِ","عَوَّذتُ مُلكَكَ بِالنَبِيِّ وَآلِهِ",15,"ل",2,1],["المُلكُ زُلزِلَ في فُروقٍ ساعَةً","كانوا لَهُ الأَوتادَ في زِلزالِهِ",15,"ل",2,0],["المُلكُ لِلإِناثِ في الد","دُستورِ لا لِلذُكَرَه",16,"ر",2,0],["الملك الشيخ العقيم الذي","تحت يديه الحزن والسهلُ",17,"ل",1,1],["المُلكُ لِلَّهِ لا شَريكَ لَهُ","تَجري القَضايا مِنهُ عَلى قَدَرِ",18,"ر",1,0],["المَلِكُ الصالِحُ الَّذي ظَهَرَت","مِنهُ السَجايا وَطابَتِ الشِيَمُ",19,"م",1,0],["المَلِكُ الجامِعُ الفَضائِلَ وَال","باذِلُ في الصالِحاتِ ما خَزَنَه",20,"ن",2,0],["المَلِكُ النَدبُ الَّذي شُكرُهُ","صارَ اِعتِباراً لِلوَرى وَاِصطِلاح",21,"ح",1,0],["الملحدونَ ابتهجوا","بموتِهِ والشِّيَعُ",22,"ع",1,0],["المُلكُ مُعتَصِمٌ بِهِ مُستَمسِكٌ","مِنهُ بِأَوثَقِ ذِمَّةٍ وَضَمانِ",23,"ن",1,0],["المُلكُ لِلَهِ كَم أَهوى بِمَملَكَةٍ","شَمّاءَ ما بَينَ إِمساءٍ وَإِصباحِ",24,"ح",1,0],["المُلكُ عالٍ وَالمَواكِبُ فَخمَةٌ","وَسَنا الحَضارَةِ واسِعٌ مَمدودُ",25,"د",1,0],["المُلكُ أَجمَعُ وَالجَلالُ لِواحِدٍ","صَمَدٍ تَبارَكَ وَحدَهُ وَتَسامى",26,"م",2,0],["المَلِكُ رَأسٌ أَنتَ مِغفَرُ رَأسِهِ","فيما يُباهي تاجُهُ المَعقودُ",27,"د",1,0],["المَلكُ يَحتاجُ أُلّافاً لِتُنصِرَهُ","وَالمَيتُ لَيسَ إِلى خَلقٍ بِمُحتاجِ",28,"ج",1,0],["المُلكُ لِلَّهِ لا نَنفَكُّ في تَعَبٍ","حَتّى تَزايَلَ أَرواحٌ وَأَجسادُ",29,"د",1,1],["المَليكُ الَّذي يَرى المَنَّ إِشرا","كاً بِوَصفِ اّلمُهَيمِنِ المَنّانِ",30,"ن",1,0],["الملك المنفرد الجبار","الدائم الجلال والإكبار",31,"ر",1,0],["المُلْحِفِينَ رِداءَ الشَّمْسِ مَجدهُمُ","والمُنْعِلِينَ الثُّرَيَّا أَخْمص القَدمِ",32,"م",1,0],["ألملم الجمرات الخضر من كبدي","وأستردّ الصّبا والحبّ والكبدا",33,"د",2,0],["أَلْمُلْكُ فِي إِبّانِ عِزَّتِهِ","شقَّ العنَانَ وطَاولَ الزُّهْرَا",34,"ر",2,0],["الملك كان ملكهم","سواه قعب من لبن",35,"ن",1,0],["المُلْك فِي بَيْتِكمْ كَسْباً وَمَوْهِبَةً","يُزْهَى عَلَى كلِّ مَوْهُوبٍ وَمُكْتَسَبِ",36,"ب",1,0],["المليك المليك","حُبُّه ملء قلوب المخلصينْ",37,"ن",1,0],["المُلْكُ فيكَ طَبِيعةٌ ووِرَاثةٌ","والمَجْدُ فيكَ سَليقَةٌ ونِجَار",38,"ر",1,0],["المُلْكُ في ظلِّه طَابتْ مَشارِعُه","والدِّينُ في عَهْدِه قَامَتْ شَعَائِرُه",39,"ر",2,0],["المُلْكُ بالأخلاق يُبْنَى أسُّه","لا بالمجازر والدَّمِ السفاح",40,"ح",1,0],["الملك ناس ذكره مَأمُو","نَهُ بك بل رشيده",41,"د",2,0],["الملك يؤتيهِ المهيمنُ من يشا","والحرصُ منك يزدك عنهُ بعادا",42,"د",2,0],["الملك الظاهر ذو المجد الذي","إذا دعا داع نداه لبا",43,"ب",2,0],["الملك عدل والمشد برفقه","لم يال في طلب عن المجهود",44,"د",1,0],["الملك بينكمُ بحقِ وراثةٍ","يقضي وبين الناس بالأقسامِ",45,"م",1,0],["الملكُ فيكم نسبةٌ خلقيةٌ","من جُملتي لحم به وعِظام",45,"م",1,0],["الملك المنصور بالسيف فمن","ما كره زواله زوا لَهُ",46,"ل",2,0],["الملك الناصر دين الهدى","ابن المليك الاشرف الهمة",47,"ه",1,0],["الملك الناصر سلطاننا","سامى الذرا المدرة مروى الصدا",48,"د",2,1],["الملك لله فهذا خبر","يكتب في غرائب الأخبار",49,"ر",1,0],["الملك الناصر من حسبي عطا","كون فناه لي مأوي وعطن",50,"ن",1,0],["الملك الناصر من نوره","نحو الهدى اضا التي ضلت",51,"ت",1,0],["الملك الناصر من لا خاطر","إلا له فيه حساب الجبر",52,"ر",1,0],["الملك الظاهر يحي من به","حي موحد ومات مشرك",53,"ك",1,0],["المُلكُ من يُمناه على العهدِ الذي","أَخَذَته قبلُ عليه ناضِرَةُ القُرى",54,"ر",2,0],["الملِك الوارث الإمامةَ عن","كلّ إمامٍ أغَرَّ أَواهِ",55,"ه",1,0],["الملبِسي النُّعْمَى التي صَيَّرتْ","أدانيَ اللُحْمة لي حُسَّدا",56,"د",2,0],["المُلكْ ذو عِقْد ولكنَّه","في عصره واسطةُ العِقْد",57,"د",1,0],["المَلِكُ العادِلُ في حُكمِهِ","فَهوَ مِنَ الأَملاكِ مَعدودُ",58,"د",1,0],["المَلِكُ العادِلُ الَّذي كَشَفَ ال","لَهُ بِهِ هَمَّ كُلِّ مَكروبِ",59,"ب",1,0],["المليك الشريف من","طاب أصلاً ومحتدا",60,"د",2,0],["الملوي الذي يؤرقه","جمع المعالي وبذل أنعمه",61,"م",2,0],["الملك لا يبنيه إلا هامهم","فالهام آساس لملكٍ واطد",62,"د",1,0],["الملكُ أصبحَ دَعوى في طوائفهم","واستمسكوا بعرى اللّذاتِ غاوينا",63,"ن",2,0],["المَلِكُ الأَشرَفُ شاه اَرمَنَ لا","زالَ قَوِيّاً ثابِتاً سُلطانُهُ",64,"ن",2,0],["المَلِكُ الأَمجَدُ الَّذي شَهِدَت","لَهُ مُلوكُ الزَمانِ بِالفَضلِ",65,"ل",1,1],["المُلكُ لِلَهِ جَلَّ القَردُ وَالشانُ","يَبقى وَيَفنى سواهُ الإِنسُ وَالجانِ",66,"ن",1,1],["المِلاحَ المِلاحَ وَيلي عَلَيْهِ","والمِلا