Poem.aspx?id=213432",""],[5989,"عيناك بحر ..","https://www.poetsgate.com/ViewPoem.aspx?id=181620",""],[463,"عاتبتُ دهري في الجناية ِ لو وعى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60125&r=&rc=181",""],[4222,"كيف قلتم في مقلتيه فتور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52785&r=&rc=77",""],[6341,"طواف الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87287&r=&rc=16",""],[6346,"أغالب قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83393&r=&rc=9",""]],"verses":[["وَلَجلَجَ مَن نَعاكِ وَكُلُّ ناعٍ","يُجَمجِمُ أَو يُلَجلِجُ في الكَلامِ",0,"م",1,0],["ولجَدِّ مَنْ شرَح الكِتابَ تَحيُّزي","هَذا إذا اخْتلَفَ انْتِماءُ النّاسِ",1,"س",1,0],["وَلَجْتُ عَلَى الْغِيرَانِ بَيْتَ فَتَاتِهِ","وَجُبْتُ عَرِينَ اللَّيْثِ وَهْوَ يَهُولُ",2,"ل",1,0],["وَلَجَتْ بِهِ بَابَ الحَيَاةِ وَهَيَّأَتْ","لِلْمَجْدِ مَا يَرْجُوهُ يَوْمَ صِيَالِهَا",3,"ل",3,0],["وَلَجَّجتُ في حُلوِ الزَمانِ وَمُرِّهِ","وَأَنفَقتُ مِن عُمري بِغَيرِ حِسابِ",4,"ب",1,0],["ولَجتَ للعلمِ أبواباً متى خطرت","بها العزائم أبوابَ العلى تلج",5,"ج",1,0],["وَلُجَيني وَعَسجَدي","وَخِلالي وَمَحتَدي",6,"د",2,0],["وَلَجُدتَ حَتّى كِدتَ تَبخَلُ حائِلاً","لِلمُنتَهى وَمِنَ السُرورِ بُكاءُ",7,"ا",2,0],["وَلَجَّ بِهِ الجَفاءُ فَلَيسَ يَدري","أَيَظعَنُ أَم يُقيمُ عَلى الجَفاءِ",8,"ا",2,0],["وَلَجلَجتُ في قَولي وَكُنتُ مَتى أَقُل","بِمُسمِعَةٍ في مَجمَعٍ لا أُلَجلِجِ",9,"ج",1,0],["وَلَجَّ في كَرَمٍ لا يَبتَغي بَدَلاً","مِنهُ وَإِن لامَ فيهِ عاذِلٌ وَلَحى",10,"ح",2,0],["وَلَجَّ بِكَ الهِجرانُ حَتّى كَأَنَّما","تَرى المَوتَ في البَيتِ الَّذي كُنتَ تَيلَفُ",11,"ف",1,0],["وَلَجتِ بِعَينَيكِ الصَيودَينِ مَولِجاً","مِنَ النَفسِ إِن لَم يوقِ نَفسي حِمامُها",12,"م",3,0],["ولجأتُ من دَهْري إليه فكان لي","رُكناً على الحِدْثانِ غيرَ ضَعيفِ",13,"ف",1,0],["وَلَجَّ في العَذلِ أَقوامٌ مَقَتُّهُمُ","كَأَنَّ في أُذُني عَن عَذلِهِم صَمَمُ",14,"م",1,0],["وَلَجتُ يَوماً فِناهُ","لِكَي أُجَدِّدَ أُنسي",15,"س",2,0],["وَلَجَأتُ مِنكَ إِلى اِبنِ مَلكٍ أَنبَأَت","عَنهُ خَلائِقُهُ بِطيبِ المُحتَدِ",16,"د",1,0],["وَلَجَفَّ نُوّارُ الكَلامِ وَقَلَّما","يُلفى بَقاءُ الغَرسِ بَعدَ الماءِ",17,"ا",2,0],["وَلُجِّ هَنْدَسَةٍ تَجْرِي بِحِكْمَتِهِ","جَدَاوِلُ الْمَاءِ فِي هَالٍ مِنَ الأَكَمِ",18,"م",1,0],["وَلُجَّةٍ تُفرَقُ أَو تُعشَقُ","فَما تَني أَحشاؤُها تَخفِقُ",19,"ق",1,1],["ولجامٍ من العبيرِ","أشيلِ المركبِ",20,"ب",1,0],["وَلِجِسمي إِلى التُرابِ هُبوطٌ","وَلِرَوحي إِلى الهَواءِ صُعودُ",21,"د",1,0],["وَلُجَيماً عَنِ الفَوا","رِسِ حَتّى أَبي دُلَف",22,"ف",1,0],["وَلُجَينٌ لَجنٌ كَبيرَةِ لَفظٍ","وَلِجَيمٌ كَذاكَ أَخلاقُ سَهلِ",23,"ل",1,0],["ولجتم طريق العنف تستنهجونه","أَما عَن طَريق العنف يا قوم معدل",24,"ل",1,0],["وَلُجَّةُ بَحْرٍ كُلَّما هَبَّ عَاصِفٌ","مِنَ الرِّيحِ دَوَّى مَوْجُهَا المُتَنَاطِحُ",25,"ح",1,0],["ولجت على الغيران بيت قبابه","وجئت عرين الليث وهو يهول",26,"ل",1,0],["ولجئتَ مُقتَنصَ الشباب ولارتمَتْ","من حولك الظَبيَاتُ والآرام",27,"م",1,0],["وَلَجَّ الفُؤادُ فَما عَسى أَن أصنَعا","وَلَقَد نُصحتُ، فَلَم أُرِدْ أَن أَسمَعا",28,"ع",2,1],["ولجاء الرسول طه التجأنا","بانخلاع عن جملة الأعذار",29,"ر",1,0],["ولجوده مدت أيادي الأنبيا","وتأدبوا بالغيب في آدابه",30,"ب",2,0],["وَلِج بابَ الخُمولِ فَذا زَمانٌ","أَباحَ اليَعرَ لَحمَ الشَيذُمانِ",31,"ن",1,0],["ولجَّ بكَ الجفاءُ فما تبالي","بما ألقى من الوجدِ الأليمِ",32,"م",1,0],["ولج بها الهوى كلفا فباتت","تهدّد باقتحام الموج داري",33,"ر",2,0],["وَلَجَأتُ مِنهُ إِلى مَقيلٍ بارِدٍ","وَحَلَلتُ مِنهُ عَلى مُقيلِ العاثِرِ",34,"ر",1,0],["ولجذع النخلة فادنُ وهُزْ","واقطف ثمراتِ القصد وحُزْ",35,"ز",1,0],["ولجَّ هواه بي حتى","وهمتُ بأَنه هوس",36,"س",1,0],["وَلجّ عَلى التهوُّرِ في نزالي","وَخالَفني كأنّي قلتُ هَجرا",37,"ر",2,0],["وَلجنْسِها البَأْسُ الشَّدِيدُ وَهذهِ","فَضَلَتْ عليهِ بالنَّدَى والبَاسِ",38,"س",1,0],["وَلِجِسمٍ أَذابَهُ رائِدُ الحُسنِ","وَأَخنى عَلَيهِ طولُ الفِراقِ",39,"ق",1,0],["ولَجُزْتُ ساحةَ حيِّكمْ فطرقتُكمْ","مزُوراً ولم تَرَني العيونُ نُحولا",40,"ل",2,0],["وَلَجاجي فَهوَ يغلِبُهُ","وَهوَ كَالدُنيا لِمَن غَلَبا",41,"ب",2,0],["وَلِجَرحِهِ جُرحٌ سِوى","جَرحِ الجَوارِحِ بِالنِبالِ",42,"ل",1,0],["وَلَجتُ مِنَ اللُطفِ سَمَّ الخِياطِ","وَأَشكو مِنَ الحَظِّ ضيقَ المَجالِ",43,"ل",1,0],["ولج الإلهُ ديارَ ملكِ أبيه مع","أنصاره حقّاً بلا تمويه",44,"ي",2,0],["وَلجلق الفَيحاءِ مِن بَلَدٍ","مَسكية الأَرواح وَالنَشر",45,"ر",1,0],["وَلَجتُ فأنساني الحياةَ وأهلَها","شعورٌ عميقٌ في فؤاديَ يُوْغِلُ",46,"ل",1,0],["وَلَجْتُ إليها، والصَّباحُ قصيدةٌ","بأوزانِها البيضاءِ يَصْدَحُ بُلْبْلُ",46,"ل",1,0],["ولِجِدّه نسجَتْ قديماً إنها","لَيَدٌ يحقّ لمثلِها أن تُشكرا",47,"ر",2,0],["ولجامع الشرح الصغ","ير مؤلف شرح سديد",48,"د",1,0],["وَلِجودِهِ مِن نَفسِهِ داعٍ إِذا","ناداهُ حَيَّ عَلى النَدى لَبّاهُ",49,"ا",2,0],["ولجَهلِهمْ طَرَفوا بطُول صدُودِهم","وَملاَلِهم طَرفْي وهُم إنْسَانُهُ",50,"ن",2,0],["ولَجَّ اشتياقٌ كنتُ أَتّهِم النّوَى","علَيهِ إِلى أَن زَادَ سَورَتَه القُربُ",51,"ب",1,0],["ولجت في طاعته العليا","وبغير رضاه لم تلج",52,"ج",1,0],["ولُجَّةٍ من صَفِيحِ الهندِ خُضْتَ بِهَا","من المنايا إِلَى نَيْلِ المُنى لُججا",53,"ج",2,0],["ولجنة الفردوس روحك روحت","وعليك من لطف الاله خليع",54,"ع",1,0],["ولجاءه حبُّ السلامة مؤذناً","بسلامه من كل داءٍ معضلِ",55,"ل",1,0],["وَلَجَ الحِمامُ اليك باباً ما شكا","غيرَ الزحامِ عليك فيه داخلُ",56,"ل",1,0],["ولَجُوا عرينَك آمنين وربما","مرّوا به صعبَ الولوج ممنَّعا",57,"ع",2,0],["وَلَجتَ رُواقَ العزّ حتى اقتحمتَهُ","بلا وازعٍ عنه ولا ردِّ حاجبِ",58,"ب",1,0],["ولج ابن كوزانٍ وإن لَجاجَهُ","ردىً ذاهب بالعرض منه وبالعمر",59,"ر",1,0],["وَلج الضَّيْمُ إلى مَنْ عِزُّكمْ","بين فَتْكٍ من يديه ولَسَنْ",60,"ن",1,0],["ولَجْتُ عليه والمُلوكُ بنجْوةٍ","يُذادون عن صعب المراتج مُغْلق",61,"ق",1,0],["ولِجانٍ جَلَّ منهُ جُرْمُهُ","فتغمَّدْتَ بصَفْحٍ واحْتمالِ",62,"ل",1,0],["ولجرِ الأرزاقِ إذ يرفع الأقدارَ","عامَ الخمول والإعدامِ",63,"م",1,0],["وَلِجامَةٌ مَملوءَةٌ","أَبهى وَأَحسَنُ مِن غَديرِ",64,"ر",1,0],["ولِجُرحِ حبَّةِ قلبهِ يومَ النوى","لا كنتَ مِن جُرحٍ بها مقروفِ",65,"ف",1,0],["ولج باب الحظوظ وقل سلام","على الأحرار في هذي الديار",66,"ر",1,0],["ولجَمْعِ شملي بينَ مروَةَ والصَّفَا","ثأثيرُ حالٍ فيه أَحْلى مُسْتَلَمْ",67,"م",1,0],["ولَجَ الهَوى فيه فأخرَجَ كِبده","فلِذا بَذيُّ الدّمعِ من حدَقاتِهِ",68,"ت",2,0],["ولَجْتَ قُلوبَ البيضِ كالسّرِّ نحوَها","وخُضْتَ بلِمّاتِ الملمّاتِ كالمِدْرا",69,"ر",2,0],["ولجت أبوابها قبل المجيب ولو","رام الولوج ابتداء منه لم يلج",70,"ج",1,0],["ولجلتُ آفاقَ البلادِ وجُبْتُها","حتى أُكَثِّرَ بالغني حُسَّادي",71,"د",2,0],["ولَجَاءَ معتذراً إِلَيْ","ىَ من اهتِضامي واطِّراحي",72,"ح",2,0],["ولجّ في العصيان والتمادي","في الغي والعيث وفي الفساد",73,"د",1,0],["ولجَدِّكَ المنصُورِ فَضلٌ أعجَزَ ال","رّاقي وَغَضَّ عَدُوَّهُ المَخذُولا",74,"ل",2,0],["وَلَجَّ به العُكُوفُ عَلَى الأثافي","فَظَلَّ مِنَ الثَّلاثِ السُّفعِ سَفعا",75,"ع",2,0],["وَلجَ الدارَ طافِحَ الوجهِ بِشراً","حاسباً نَفسهُ من الأغنياءِ",76,"ا",2,0],["وَلجندها بِكَ وَهوَ صاحب سَطوة","فَتح وَنَصر دائم وَتصرُّف",77,"ف",1,0],["وَلجيش منتقيهِ","ما لَهُ في الحَرب دافعْ",78,"ع",1,0],["وَلجندها بِكَ يا أَمير لَدى الوَغى","فَتح مُبين لا يكاد يُقارَن",79,"ن",1,0],["ولجت دعاوي الجانبين فلم نصل","إلى من نجاريه ولا من نخالف",80,"ف",1,0],["ولجوا المعاقلَ والحصونَ وأترصُوا","أغلاقها لو ينفعُ الإِتراص",81,"ص",1,0],["وَلِجِ الرّياضَ تَرى الزّهورَ جَواهِراً","قَد كُلِّلَت أَشجارُها في الأرؤُسِ",82,"س",1,0],["ولجت بالجفا حتى شهدنا","لدهشة حول جفوتها القيامه",83,"م",2,0],["ولَجَّ في الهجر مَنْ تبْغِى صداقتَه","جَفاً وخانك ظلما مَنْ به تثِق",84,"ق",1,0],["ولجَّ بي الهوى أثني عليه","ولا والله لا أحصي ثناه",85,"ا",2,0],["ولجَّ وماج الرّدف واهتزّ قدّكِ ال","قويم فحارَ البدرُ والدّعصُ والبان",86,"ن",1,0],["وَلجسمٍ قَد براهُ الوجدُ حت","تى غَدا مُنتحفاً مثل الألِف",87,"ف",1,0],["ولجمع الحشود من كلِّ حصن","سلب مهمل لهم ونهوب",88,"ب",1,0],["ولجعفر الطيار صر","عى في دمائهم كثير",89,"ر",1,0],["ولجندب سهل البلاد وعذبُها","ولي المِلاح وخبتهن المجدبُ",90,"ب",1,0],["وَلَجَجْتُ إِذْ لَجَّ العَذولُ فَرُعتُهُ","وَلَرُبمَّا ضَرَّ اللَّجوجَ لَجاجُهُ",91,"ج",2,0],["وَلَجَّ في البُكاء وَالنحيب","فَقالَ ما يبكيكَ يا حَبيبي",92,"ي",1,0],["وَلِجَ المَسَامِعَ مَدْحُهُ الأَهْدَى كَمَا","وَلِجَ الكِتَابُ كِنَانَةَ الرَّقَّاصِ",93,"ص",1,0],["ولجةً بالأمس عادت وَشَلاً","واردُها اليومَ تمنَّى لا ورَد",94,"د",1,0],["وَلَجُبتُ أَجيابَ الفَلا وَطَوَيتُها","طَيَّ المُلا بِنَجيبَةٍ قَوداءِ",95,"ا",2,0],["ولجت في عمايتها قريش","تصارحه العداوة والخصاما",96,"م",2,0],["ولجت بي في غامضات الخطايا","آه من ذلك التولج آها",97,"ا",3,0],["وَلَجَ العزيزُ عَرينَهُ من بَعدِ أن","أهدى سلاماً ضاع فيه بياني",98,"ي",1,0],["ولجها الجانب الشرقي سابقها","وسدد الجوف منه الثاقب الذرب",99,"ب",1,0],["ولجاسَ سيفي في خلال جسومهم","ما لا يُواريه ضريحُ الأَقْبُرِ",100,"ر",1,0],["وَلِجَدِّهِ قَد أَدخَلَتهُ فَضَمَّهُ","وَرُقِيَّهُ أَعلَى وَرَقَّ لَهُ وَسَر",101,"ر",1,0],["وَلِجَدِّهِ فِيهِ وِدَادٌ وَاعتِنا","وَلِذَاكَ كَفَّلَ عَمَّهُ فَحنا وَبَر",101,"ر",1,0],["ولجين برودنيه مترقرقاً","والكرم يضحك عن نضيد نضاره",102,"ر",2,0],["ولججت في لجي سمرقند فانتهت","بي الأرض بهما أقعدت كل ناحس",103,"س",1,0],["ولجفنه ماء الدموع","فرائح منها وغادي",104,"د",2,0],["ولج في الخلف ولو","أضمر هجري لوصل",105,"ل",1,0],["ولج المنزل الكريم وقابل","ه وقبل يديه والأقداما",106,"م",2,0],["وَلِجَهلِهِم بِالرُّوحِ مَع أحكَامِهَا","وَصِفَاتِهَا للإلفِ بالأبدانِ",107,"ن",1,0],["ولجَّ بالهجر عليه وقد","أعرض إذ عرَّض في عتبه",108,"ب",2,0],["ولج على رزقك من بابه","واقصد له ما عشت في بكرتك",109,"ك",1,0],["ولج العدى في لجة بعد لجة","من المين لم تخطر لدينا بخاطر",110,"ر",1,0],["وَلَجادَت السُحب الثقال بَدرَها","وَبها البَوارق لا يَشب سَعيرها",111,"ر",3,0],["وَلجدّه كشف الغطاء وَإِن يَكُن","ما زادَ في كَشف الغِطاء يَقينا",112,"ن",2,0],["ولجنا مفازا من عنان محمد","به بشر المختار فاطمة الزهرا",113,"ر",2,0],["ولجاه النبي ملجأ عز","حسن الذات كامل الأوصاف",114,"ف",1,0],["ولجوا الباب وعادوا","وعلى العين غشاء",115,"ا",2,0],["ولج السجن يرء طاهر","وأخو زلاته لم يلج",116,"ج",1,0],["ولجهل يهيم في كل وادي","ترك الحق والصواب وراه",117,"ه",1,0],["ولجَّجتُ فِي الأفكار ثُمَّ تراجع اخ","تياري إِلَى استحسان دين العجائز",118,"ز",1,0],["ولج بالعلم في التقوى فإني","رأيت النسك يسرعه نتاجا",119,"ج",2,0],["وَلِجاجُ الحبّ لا يبقي عَلى","مَن تَفانى في الهَوى إِلّا الفَناءَ",120,"ا",2,0],["ولجلجَ عَمروٌ نظرةً لَجْلَجَتْ بها","لواحظُهُ فيض الدموعِ السّواجِمِ",121,"م",1,0],["ولجّةُ جودٍ موْجُها يتدفّعُ","هو البدْرُ في أفْقِ الخِلافةِ مُعْتَلِ",122,"ل",1,0],["ولجت بهذا مذ رأيت مقيداً","وهذا طليقا والسعادة في الأقوى",123,"و",2,0],["ولج الكتائب مقدماً","فكأنه ذو مهجتين",124,"ن",1,0],["ولجَمرةٌ لَمَست بتلكَ الكلبتين","شِفاهَ آشعيا النبيِّ كما رَوَى",125,"ا",1,0],["وَلَجُوا بدِينِ اللَهِ أَفواجاً فإِن","مُتَمجِّساً قد كانَ أو مُتَهوِّدا",126,"د",2,0],["ولجابرٍ كَسَرَ الزَمانُ بخَطبِهِ","واعتاضَ عالي عن عَلاهُ بوَهسِهِ",127,"س",2,0],["ولِجُوا حِمَى قايينَ رأسِ المُبدِعينَ","وبِكرِ مَن بِنفاقِهِ قد ساروا",128,"ر",3,0],["وُلجَّ ذي ثبجٍ طامٍ كأن بهِ","أعلامَ لبنانَ أو كثبانَ ذي سَلَمِ",129,"م",1,0],["وَلُجينُ النَهر راقَ فَترى","فَوقَ سفحِه جَبينَ القَمر",130,"ر",1,0],["وَلجهلهم عذلوا وَلَو","عَرَفوا الحَقيقةَ يعذرون",131,"ن",1,0],["ولجفنٍ كلما قيلَ غَفا","أو سيغفو زاره طيفُ الأرقْ",132,"ق",1,0],["ولج يوسعني ذما ويمنعني","فصدّه في الجواب الصاد والهاء",133,"ا",2,0],["وَلِجامٍ في رَأسِ أَجرَدَ كَالجِذ","عِ طِوالٍ وَأَبيَضٍ قَصّالِ",134,"ل",1,0],["وَلِجَيشِه بالكَفِّ عن","أَبناءِ فاطمة أَمَرْ",135,"ر",1,0],["ولجلمودٍ من الصخر عمد","من صفاً بدد في تلك الجدد",136,"د",1,0],["وَلَجَت حَشَاكَ فَأَنتَ حَتماً هالِكٌ","وأَنا أنا نِلتُ المَفَاخِرَ وَالعُلا",137,"ل",2,0],["وَلَجَت بأَعلى ثَدِيهِ في صَدرِهِ","وَقَفَت عَلى رِئَةٍ بِنَصلٍ بادي",138,"د",2,0],["وَلَجَ الجِلدَ وَهوَ بِالجُرحِ هامي","بِدَمٍ أَسوَدٍ تَعَكَّرَ شَكلا",139,"ل",2,0],["وَلجَ الحَبيبُ الامس بُستاناً لَهُ","يا مَن نشدتِ استبشري بِبَيانِهِ",140,"ن",2,0],["وَلجت تجار الفَضل سوق صفاتِهِ","فَرَأوا بِقَلب الحبر ربحاً يذخرُ",141,"ر",1,0],["ولجميعها تعلُّقٌ بِما","تذكره من الطِباع الحكما",142,"م",2,0],["ولج الأمير قبل عيرٍ وما جرى","بإخراجنا فاغفر له رب ما فعل",143,"ل",1,0],["ولجّ بها داعي الهوى فأمضها","وأسهدَ جفنيها فأشفت على السل",144,"ل",1,0],["ولجة تمج در الصدف","وجنة بها أعالي الغرف",145,"ف",1,0],["ولجوا منشدين يا عين هذا","من يدين الهدى أزال الضلالا",146,"ل",2,0],["ولجنة الماوى دعاه مؤرخا","داعي الممات بشهر ميلاد النبي",147,"ب",2,0],["ولجامع الأشعار بادر واتخذ","لك منبراً واصعد عليه واخطب