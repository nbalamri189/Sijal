{"poems":[[53,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[77,"يا واحد العليا بلا إلباس","https://www.aldiwan.net/poem35885.html","الكامل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[93,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[47,"فلا تصفن الحرب عندي فإنها","https://www.aldiwan.net/poem25371.html","الطويل"],[72,"مدت إليك المعالي طرف مبتهج","https://www.aldiwan.net/poem18454.html","البسيط"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[45,"أصابت قلبه حدق الظباء","https://www.aldiwan.net/poem10202.html","الوافر"],[45,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[45,"أطاع عاذله في الحب إذ نصحا","https://www.aldiwan.net/poem62687.html","البسيط"],[28,"عزفت بأعشاش وما كدت تعزف","https://www.aldiwan.net/poem5335.html","البسيط"],[28,"لأدنو من أرض لأرضك إن دنت","https://www.aldiwan.net/poem5546.html","الطويل"],[61,"أمعنفي إن زدت في التعنيف","https://www.aldiwan.net/poem51547.html","الكامل"],[49,"إني أكاثر أعدائي مغالطة","https://www.aldiwan.net/poem64315.html","البسيط"],[66,"وصاحب لي مصافي","https://www.aldiwan.net/poem40948.html","المجتث"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[44,"يا موضع الشدنية الوجناء","https://www.aldiwan.net/poem30593.html","الكامل"],[87,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[74,"ولجة تفرق أو تعشق","https://www.aldiwan.net/poem13188.html","السريع"],[48,"قل لذي الدل تولب","https://www.aldiwan.net/poem66563.html","مجزوء الخفيف"],[46,"صاح ما تضحك البروق شماتا","https://www.aldiwan.net/poem22423.html","الخفيف"],[46,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[46,"كن وشيكا في حاجة أو مكيثا","https://www.aldiwan.net/poem23260.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[78,"وَلَجَّ الفُؤادُ فَما عَسى أَن أصنَعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86478&r=&rc=23",""]],"verses":[["وَلَجلَجَ مَن نَعاكِ وَكُلُّ ناعٍ","يُجَمجِمُ أَو يُلَجلِجُ في الكَلامِ",0,"م",1,0],["ولجَدِّ مَنْ شرَح الكِتابَ تَحيُّزي","هَذا إذا اخْتلَفَ انْتِماءُ النّاسِ",1,"س",1,0],["وَلَجْتُ عَلَى الْغِيرَانِ بَيْتَ فَتَاتِهِ","وَجُبْتُ عَرِينَ اللَّيْثِ وَهْوَ يَهُولُ",2,"ل",1,0],["وَلَجَتْ بِهِ بَابَ الحَيَاةِ وَهَيَّأَتْ","لِلْمَجْدِ مَا يَرْجُوهُ يَوْمَ صِيَالِهَا",3,"ل",3,0],["وَلَجَّجتُ في حُلوِ الزَمانِ وَمُرِّهِ","وَأَنفَقتُ مِن عُمري بِغَيرِ حِسابِ",4,"ب",1,0],["ولَجتَ للعلمِ أبواباً متى خطرت","بها العزائم أبوابَ العلى تلج",5,"ج",1,0],["وَلُجَيني وَعَسجَدي","وَخِلالي وَمَحتَدي",6,"ي",1,0],["وَلَجُدتَ حَتّى كِدتَ تَبخَلُ حائِلاً","لِلمُنتَهى وَمِنَ السُرورِ بُكاءُ",7,"ا",2,0],["وَلَجَّ بِهِ الجَفاءُ فَلَيسَ يَدري","أَيَظعَنُ أَم يُقيمُ عَلى الجَفاءِ",8,"ا",2,0],["وَلَجلَجتُ في قَولي وَكُنتُ مَتى أَقُل","بِمُسمِعَةٍ في مَجمَعٍ لا أُلَجلِجِ",9,"ج",1,0],["وَلَجَّ في كَرَمٍ لا يَبتَغي بَدَلاً","مِنهُ وَإِن لامَ فيهِ عاذِلٌ وَلَحى",10,"ح",2,0],["وَلَجَّ بِكَ الهِجرانُ حَتّى كَأَنَّما","تَرى المَوتَ في البَيتِ الَّذي كُنتَ تَيلَفُ",11,"ف",1,0],["وَلَجتِ بِعَينَيكِ الصَيودَينِ مَولِجاً","مِنَ النَفسِ إِن لَم يوقِ نَفسي حِمامُها",12,"م",3,0],["ولجأتُ من دَهْري إليه فكان لي","رُكناً على الحِدْثانِ غيرَ ضَعيفِ",13,"ف",1,0],["وَلَجَّ في العَذلِ أَقوامٌ مَقَتُّهُمُ","كَأَنَّ في أُذُني عَن عَذلِهِم صَمَمُ",14,"م",1,0],["وَلَجتُ يَوماً فِناهُ","لِكَي أُجَدِّدَ أُنسي",15,"س",2,0],["وَلَجَأتُ مِنكَ إِلى اِبنِ مَلكٍ أَنبَأَت","عَنهُ خَلائِقُهُ بِطيبِ المُحتَدِ",16,"د",1,0],["وَلَجَفَّ نُوّارُ الكَلامِ وَقَلَّما","يُلفى بَقاءُ الغَرسِ بَعدَ الماءِ",17,"ا",2,0],["وَلُجِّ هَنْدَسَةٍ تَجْرِي بِحِكْمَتِهِ","جَدَاوِلُ الْمَاءِ فِي هَالٍ مِنَ الأَكَمِ",18,"م",1,0],["وَلُجَّةٍ تُفرَقُ أَو تُعشَقُ","فَما تَني أَحشاؤُها تَخفِقُ",19,"ق",1,1],["ولجامٍ من العبيرِ","أشيلِ المركبِ",20,"ب",1,0],["وَلِجِسمي إِلى التُرابِ هُبوطٌ","وَلِرَوحي إِلى الهَواءِ صُعودُ",21,"د",1,0],["وَلُجَيماً عَنِ الفَوا","رِسِ حَتّى أَبي دُلَف",22,"ف",1,0],["وَلُجَينٌ لَجنٌ كَبيرَةِ لَفظٍ","وَلِجَيمٌ كَذاكَ أَخلاقُ سَهلِ",23,"ل",1,0],["ولجتم طريق العنف تستنهجونه","أَما عَن طَريق العنف يا قوم معدل",24,"ل",1,0],["وَلُجَّةُ بَحْرٍ كُلَّما هَبَّ عَاصِفٌ","مِنَ الرِّيحِ دَوَّى مَوْجُهَا المُتَنَاطِحُ",25,"ح",1,0],["ولجت على الغيران بيت قبابه","وجئت عرين الليث وهو يهول",26,"ل",1,0],["ولجئتَ مُقتَنصَ الشباب ولارتمَتْ","من حولك الظَبيَاتُ والآرام",27,"م",1,0],["وَلَجَّ الفُؤادُ فَما عَسى أَن أصنَعا","وَلَقَد نُصحتُ، فَلَم أُرِدْ أَن أَسمَعا",28,"ع",2,1]]}