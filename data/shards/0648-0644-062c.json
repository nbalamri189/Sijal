{"poems":[[53,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[77,"يا واحد العليا بلا إلباس","https://www.aldiwan.net/poem35885.html","الكامل"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[93,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[47,"فلا تصفن الحرب عندي فإنها","https://www.aldiwan.net/poem25371.html","الطويل"],[72,"مدت إليك المعالي طرف مبتهج","https://www.aldiwan.net/poem18454.html","البسيط"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[45,"أصابت قلبه حدق الظباء","https://www.aldiwan.net/poem10202.html","الوافر"],[45,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[45,"أطاع عاذله في الحب إذ نصحا","https://www.aldiwan.net/poem62687.html","البسيط"],[28,"عزفت بأعشاش وما كدت تعزف","https://www.aldiwan.net/poem5335.html","البسيط"],[28,"لأدنو من أرض لأرضك إن دنت","https://www.aldiwan.net/poem5546.html","الطويل"],[61,"أمعنفي إن زدت في التعنيف","https://www.aldiwan.net/poem51547.html","الكامل"],[49,"إني أكاثر أعدائي مغالطة","https://www.aldiwan.net/poem64315.html","البسيط"],[66,"وصاحب لي مصافي","https://www.aldiwan.net/poem40948.html","المجتث"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[44,"يا موضع الشدنية الوجناء","https://www.aldiwan.net/poem30593.html","الكامل"],[87,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[74,"ولجة تفرق أو تعشق","https://www.aldiwan.net/poem13188.html","السريع"],[48,"قل لذي الدل تولب","https://www.aldiwan.net/poem66563.html","مجزوء الخفيف"],[46,"صاح ما تضحك البروق شماتا","https://www.aldiwan.net/poem22423.html","الخفيف"],[46,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[46,"كن وشيكا في حاجة أو مكيثا","https://www.aldiwan.net/poem23260.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[78,"وَلَجَّ الفُؤادُ فَما عَسى أَن أصنَعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86478&r=&rc=23",""],[113,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[113,"يا مرسلاً لاذ الورى بجنابه","https://www.aldiwan.net/poem42163.html","الكامل"],[167,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[197,"اراك نسيت يا ظبي الصريم","https://www.aldiwan.net/poem45571.html","الوافر"],[209,"طمعت بقرب دجلة قبل هذا","https://www.aldiwan.net/poem46761.html","الوافر"],[233,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[257,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[296,"تعالى المبدع القدس","https://www.aldiwan.net/poem36858.html","عموديه"],[303,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[346,"شهدت دواة الفتح ساعة فتحها","https://www.aldiwan.net/poem20398.html","الكامل"],[347,"من لصب متيم مشتاق","https://www.aldiwan.net/poem15802.html","الخفيف"],[362,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[364,"افترى في عذله كذبا","https://www.aldiwan.net/poem16928.html","المديد"],[364,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[364,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[374,"حقا لقد صعد المسيح موجها","https://www.aldiwan.net/poem59134.html","الكامل"],[377,"سقت الغريب حمائم الفجر","https://www.aldiwan.net/poem49205.html","أحذ الكامل"],[397,"في جوف الكعبة","https://www.aldiwan.net/poem6711.html","عموديه"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[400,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[403,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[406,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[406,"ألمياء إن شطت بنا الدار عنوة","https://www.aldiwan.net/poem32511.html","الطويل"],[426,"كحلت بالسحر وبالدعج","https://www.aldiwan.net/poem41429.html","المتدارك"],[436,"ما أطبق الهم إلا ريثما انفرجا","https://www.aldiwan.net/poem34794.html","البسيط"],[438,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[456,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[456,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[459,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[459,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[459,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[462,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[466,"صيد السرور أجل من المعقول","https://www.aldiwan.net/poem60006.html","مجزوء الكامل"],[475,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[477,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[498,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[512,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[512,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[527,"الدر أهداه لي في المنظر البهج","https://www.aldiwan.net/poem37487.html","البسيط"],[565,"لولا أبو الفرج الذي فرجت به","https://www.aldiwan.net/poem69718.html","الكامل"],[565,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَلَجلَجَ مَن نَعاكِ وَكُلُّ ناعٍ","يُجَمجِمُ أَو يُلَجلِجُ في الكَلامِ",0,"م",1,0],["ولجَدِّ مَنْ شرَح الكِتابَ تَحيُّزي","هَذا إذا اخْتلَفَ انْتِماءُ النّاسِ",1,"س",1,0],["وَلَجْتُ عَلَى الْغِيرَانِ بَيْتَ فَتَاتِهِ","وَجُبْتُ عَرِينَ اللَّيْثِ وَهْوَ يَهُولُ",2,"ل",1,0],["وَلَجَتْ بِهِ بَابَ الحَيَاةِ وَهَيَّأَتْ","لِلْمَجْدِ مَا يَرْجُوهُ يَوْمَ صِيَالِهَا",3,"ل",3,0],["وَلَجَّجتُ في حُلوِ الزَمانِ وَمُرِّهِ","وَأَنفَقتُ مِن عُمري بِغَيرِ حِسابِ",4,"ب",1,0],["ولَجتَ للعلمِ أبواباً متى خطرت","بها العزائم أبوابَ العلى تلج",5,"ج",1,0],["وَلُجَيني وَعَسجَدي","وَخِلالي وَمَحتَدي",6,"ي",1,0],["وَلَجُدتَ حَتّى كِدتَ تَبخَلُ حائِلاً","لِلمُنتَهى وَمِنَ السُرورِ بُكاءُ",7,"ا",2,0],["وَلَجَّ بِهِ الجَفاءُ فَلَيسَ يَدري","أَيَظعَنُ أَم يُقيمُ عَلى الجَفاءِ",8,"ا",2,0],["وَلَجلَجتُ في قَولي وَكُنتُ مَتى أَقُل","بِمُسمِعَةٍ في مَجمَعٍ لا أُلَجلِجِ",9,"ج",1,0],["وَلَجَّ في كَرَمٍ لا يَبتَغي بَدَلاً","مِنهُ وَإِن لامَ فيهِ عاذِلٌ وَلَحى",10,"ح",2,0],["وَلَجَّ بِكَ الهِجرانُ حَتّى كَأَنَّما","تَرى المَوتَ في البَيتِ الَّذي كُنتَ تَيلَفُ",11,"ف",1,0],["وَلَجتِ بِعَينَيكِ الصَيودَينِ مَولِجاً","مِنَ النَفسِ إِن لَم يوقِ نَفسي حِمامُها",12,"م",3,0],["ولجأتُ من دَهْري إليه فكان لي","رُكناً على الحِدْثانِ غيرَ ضَعيفِ",13,"ف",1,0],["وَلَجَّ في العَذلِ أَقوامٌ مَقَتُّهُمُ","كَأَنَّ في أُذُني عَن عَذلِهِم صَمَمُ",14,"م",1,0],["وَلَجتُ يَوماً فِناهُ","لِكَي أُجَدِّدَ أُنسي",15,"س",2,0],["وَلَجَأتُ مِنكَ إِلى اِبنِ مَلكٍ أَنبَأَت","عَنهُ خَلائِقُهُ بِطيبِ المُحتَدِ",16,"د",1,0],["وَلَجَفَّ نُوّارُ الكَلامِ وَقَلَّما","يُلفى بَقاءُ الغَرسِ بَعدَ الماءِ",17,"ا",2,0],["وَلُجِّ هَنْدَسَةٍ تَجْرِي بِحِكْمَتِهِ","جَدَاوِلُ الْمَاءِ فِي هَالٍ مِنَ الأَكَمِ",18,"م",1,0],["وَلُجَّةٍ تُفرَقُ أَو تُعشَقُ","فَما تَني أَحشاؤُها تَخفِقُ",19,"ق",1,1],["ولجامٍ من العبيرِ","أشيلِ المركبِ",20,"ب",1,0],["وَلِجِسمي إِلى التُرابِ هُبوطٌ","وَلِرَوحي إِلى الهَواءِ صُعودُ",21,"د",1,0],["وَلُجَيماً عَنِ الفَوا","رِسِ حَتّى أَبي دُلَف",22,"ف",1,0],["وَلُجَينٌ لَجنٌ كَبيرَةِ لَفظٍ","وَلِجَيمٌ كَذاكَ أَخلاقُ سَهلِ",23,"ل",1,0],["ولجتم طريق العنف تستنهجونه","أَما عَن طَريق العنف يا قوم معدل",24,"ل",1,0],["وَلُجَّةُ بَحْرٍ كُلَّما هَبَّ عَاصِفٌ","مِنَ الرِّيحِ دَوَّى مَوْجُهَا المُتَنَاطِحُ",25,"ح",1,0],["ولجت على الغيران بيت قبابه","وجئت عرين الليث وهو يهول",26,"ل",1,0],["ولجئتَ مُقتَنصَ الشباب ولارتمَتْ","من حولك الظَبيَاتُ والآرام",27,"م",1,0],["وَلَجَّ الفُؤادُ فَما عَسى أَن أصنَعا","وَلَقَد نُصحتُ، فَلَم أُرِدْ أَن أَسمَعا",28,"ع",2,1],["ولجاء الرسول طه التجأنا","بانخلاع عن جملة الأعذار",29,"ر",1,0],["ولجوده مدت أيادي الأنبيا","وتأدبوا بالغيب في آدابه",30,"ب",2,0],["وَلِج بابَ الخُمولِ فَذا زَمانٌ","أَباحَ اليَعرَ لَحمَ الشَيذُمانِ",31,"ن",1,0],["ولجَّ بكَ الجفاءُ فما تبالي","بما ألقى من الوجدِ الأليمِ",32,"م",1,0],["ولج بها الهوى كلفا فباتت","تهدّد باقتحام الموج داري",33,"ي",1,0],["وَلَجَأتُ مِنهُ إِلى مَقيلٍ بارِدٍ","وَحَلَلتُ مِنهُ عَلى مُقيلِ العاثِرِ",34,"ر",1,0],["ولجذع النخلة فادنُ وهُزْ","واقطف ثمراتِ القصد وحُزْ",35,"ز",1,0],["ولجَّ هواه بي حتى","وهمتُ بأَنه هوس",36,"س",1,0],["وَلجّ عَلى التهوُّرِ في نزالي","وَخالَفني كأنّي قلتُ هَجرا",37,"ر",2,0],["وَلجنْسِها البَأْسُ الشَّدِيدُ وَهذهِ","فَضَلَتْ عليهِ بالنَّدَى والبَاسِ",38,"س",1,0],["وَلِجِسمٍ أَذابَهُ رائِدُ الحُسنِ","وَأَخنى عَلَيهِ طولُ الفِراقِ",39,"ق",1,0],["ولَجُزْتُ ساحةَ حيِّكمْ فطرقتُكمْ","مزُوراً ولم تَرَني العيونُ نُحولا",40,"ل",2,0],["وَلَجاجي فَهوَ يغلِبُهُ","وَهوَ كَالدُنيا لِمَن غَلَبا",41,"ب",2,0],["وَلِجَرحِهِ جُرحٌ سِوى","جَرحِ الجَوارِحِ بِالنِبالِ",42,"ل",1,0],["وَلَجتُ مِنَ اللُطفِ سَمَّ الخِياطِ","وَأَشكو مِنَ الحَظِّ ضيقَ المَجالِ",43,"ل",1,0],["ولج الإلهُ ديارَ ملكِ أبيه مع","أنصاره حقّاً بلا تمويه",44,"ي",2,0],["وَلجلق الفَيحاءِ مِن بَلَدٍ","مَسكية الأَرواح وَالنَشر",45,"ر",1,0],["وَلَجتُ فأنساني الحياةَ وأهلَها","شعورٌ عميقٌ في فؤاديَ يُوْغِلُ",46,"ل",1,0],["وَلَجْتُ إليها، والصَّباحُ قصيدةٌ","بأوزانِها البيضاءِ يَصْدَحُ بُلْبْلُ",46,"ل",1,0],["ولِجِدّه نسجَتْ قديماً إنها","لَيَدٌ يحقّ لمثلِها أن تُشكرا",47,"ر",2,0],["ولجامع الشرح الصغ","ير مؤلف شرح سديد",48,"د",1,0],["وَلِجودِهِ مِن نَفسِهِ داعٍ إِذا","ناداهُ حَيَّ عَلى النَدى لَبّاهُ",49,"ا",2,0],["ولجَهلِهمْ طَرَفوا بطُول صدُودِهم","وَملاَلِهم طَرفْي وهُم إنْسَانُهُ",50,"ن",2,0],["ولَجَّ اشتياقٌ كنتُ أَتّهِم النّوَى","علَيهِ إِلى أَن زَادَ سَورَتَه القُربُ",51,"ب",1,0],["ولجت في طاعته العليا","وبغير رضاه لم تلج",52,"ج",1,0],["ولُجَّةٍ من صَفِيحِ الهندِ خُضْتَ بِهَا","من المنايا إِلَى نَيْلِ المُنى لُججا",53,"ج",2,0],["ولجنة الفردوس روحك روحت","وعليك من لطف الاله خليع",54,"ع",1,0],["ولجاءه حبُّ السلامة مؤذناً","بسلامه من كل داءٍ معضلِ",55,"ل",1,0],["وَلَجَ الحِمامُ اليك باباً ما شكا","غيرَ الزحامِ عليك فيه داخلُ",56,"ل",1,0],["ولَجُوا عرينَك آمنين وربما","مرّوا به صعبَ الولوج ممنَّعا",57,"ع",2,0],["وَلَجتَ رُواقَ العزّ حتى اقتحمتَهُ","بلا وازعٍ عنه ولا ردِّ حاجبِ",58,"ب",1,0],["ولج ابن كوزانٍ وإن لَجاجَهُ","ردىً ذاهب بالعرض منه وبالعمر",59,"ر",1,0],["وَلج الضَّيْمُ إلى مَنْ عِزُّكمْ","بين فَتْكٍ من يديه ولَسَنْ",60,"ن",1,0],["ولَجْتُ عليه والمُلوكُ بنجْوةٍ","يُذادون عن صعب المراتج مُغْلق",61,"ق",1,0],["ولِجانٍ جَلَّ منهُ جُرْمُهُ","فتغمَّدْتَ بصَفْحٍ واحْتمالِ",62,"ل",1,0],["ولجرِ الأرزاقِ إذ يرفع الأقدارَ","عامَ الخمول والإعدامِ",63,"م",1,0],["وَلِجامَةٌ مَملوءَةٌ","أَبهى وَأَحسَنُ مِن غَديرِ",64,"ر",1,0],["ولِجُرحِ حبَّةِ قلبهِ يومَ النوى","لا كنتَ مِن جُرحٍ بها مقروفِ",65,"ف",1,0],["ولج باب الحظوظ وقل سلام","على الأحرار في هذي الديار",66,"ر",1,0],["ولجَمْعِ شملي بينَ مروَةَ والصَّفَا","ثأثيرُ حالٍ فيه أَحْلى مُسْتَلَمْ",67,"م",1,0],["ولَجَ الهَوى فيه فأخرَجَ كِبده","فلِذا بَذيُّ الدّمعِ من حدَقاتِهِ",68,"ت",2,0],["ولَجْتَ قُلوبَ البيضِ كالسّرِّ نحوَها","وخُضْتَ بلِمّاتِ الملمّاتِ كالمِدْرا",69,"ر",2,0],["ولجت أبوابها قبل المجيب ولو","رام الولوج ابتداء منه لم يلج",70,"ج",1,0],["ولجلتُ آفاقَ البلادِ وجُبْتُها","حتى أُكَثِّرَ بالغني حُسَّادي",71,"د",2,0],["ولَجَاءَ معتذراً إِلَيْ","ىَ من اهتِضامي واطِّراحي",72,"ي",1,0],["ولجّ في العصيان والتمادي","في الغي والعيث وفي الفساد",73,"د",1,0]]}