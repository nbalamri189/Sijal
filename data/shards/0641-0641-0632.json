{"poems":[[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[87,"سمعت أن فأرة أتاها","https://www.aldiwan.net/poem8003.html","الرجز"],[30,"قضيت قضاء في الخلافة ثابتا","https://www.aldiwan.net/poem5465.html","الطويل"],[60,"الناس من جهة التمثال اكفاء","https://www.aldiwan.net/poem31209.html","البسيط"],[33,"إن الحبيب ألم بالركب","https://www.aldiwan.net/poem42625.html","الكامل"],[50,"دع الربع ما للربع فيك نصيب","https://www.aldiwan.net/poem10774.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[139,"جليت بالبرهان صبح الهدى","https://www.aldiwan.net/poem49100.html","السريع"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[190,"بكى صبي فرأت أمه","https://www.aldiwan.net/poem43634.html","السريع"],[354,"تجردت نفسي عن نفسي","https://www.aldiwan.net/poem15741.html","السريع"],[358,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[445,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[457,"إِذا ما مضى للمرء يوم من البشر","https://www.aldiwan.net/poem13763.html","الطويل"],[463,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[463,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[484,"صديقك أيها الممدوح جوزي","https://www.aldiwan.net/poem37584.html","الوافر"],[556,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77592","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77561","الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105520","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121992","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113960","المتقارب"],[2637,"","https://poetry.dctabudhabi.ae/diwan/poem/22609","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100929","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84839","الطويل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84840","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94266","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94215","المتقارب"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96433","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133999","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134145","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53028","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92010","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45540","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139525",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5183,"الموقف الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=180261",""],[5596,"نغزى وسحرا","https://www.poetsgate.com/ViewPoem.aspx?id=206186",""],[5704,"رُجُوع","https://www.poetsgate.com/ViewPoem.aspx?id=191319",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[6064,"ألم تر أني لما حضرت","https://www.poetsgate.com/ViewPoem.aspx?id=96332",""],[6225,"الحصادُ المُرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78052&r=&rc=137",""]],"verses":[["فَفُزتَ بِها ثَمانِيَ مُعلَماتٍ","نَصَرتَ بِها النُبوَّةَ وَالكِتابا",0,"ب",2,0],["ففُزْ يا أميرَ المؤمنينَ ببَيْعَةٍ","موثّقَةٍ قد حلّ عُرْوَتَها الغَدْرُ",1,"ر",1,0],["فَفَزِعَت لَمّا رَأَتهُ الفارَه","وَاِعتَصَمَت مِنهُ بِبَيتِ الجارَه",2,"ه",1,0],["فَفُزتَ بِما فازا بِهِ مِن خِلافَةٍ","وَزِدتَ عَلى مَن كانَ قَبلَكَ بِالحَصلِ",3,"ل",1,0],["فَفُز بِعِلمٍ وَلا تَطلُب بِهِ بَدَلاً","فَالناسُ مَوتى وَأهُلُ العِلمِ أَحياءُ",4,"ا",2,0],["فَفَزِعتُ مِن نَومِ عَلى وَسَنٍ","وَذَكَرتُ ما قَد هاجَ مِن نُصبي",5,"ب",2,0],["فَفُزِّعَ مِن إِدلاجِنا بَعدَ هَجعَةٍ","وَلَيسَ سِوى ذي الكِبرِياءِ رَقيبُ",6,"ب",1,0],["فَفُزتَ عليهمُ لَمَّا التقَينَا","بتاجِكَ فَوزَةَ القِدحِ الأَريبِ",7,"ب",1,0],["فَفُزْ بِمَا شِئْتَ مِنْ لُطْفٍ وَمِنْ أَدَبٍ","وَمِنْ عَفَافٍ وَمِنْ ظرْفٍ وَمِنْ حَوَرِ",8,"ر",1,0],["ففزتُ بالنصر كما اعتدتَه","جوزيتَ خيراً يا أب النصرِ",9,"ر",1,0],["ففُزْ بالقناعةِ كنزا يَقيك","ويُغنيك دون حسودٍ مُسام",10,"م",1,0],["ففزّعت بي طفلها فانضوى","خوفا إليها يظهر الطاعه",11,"ع",2,0],["فَفُزتُ بِالفَيءِ فَلَم يُضحِني","مُذ عُذتُ بِالجِنِّ مِنَ الإِنسِ",12,"س",1,0],["ففُز بِالتَهاني يا مُحَمَّد وَاِغتَنم","بُلوغ الأَماني بِالصبيحة وَالبُكرَه",13,"ر",2,0],["فَفُزْ يَا مُظَفَّرُ مِمَّنْ شَجاكَ","بِأَكْرَمِ ذُخْرٍ وأزكى شَفِيعِ",14,"ع",1,0],["ففزنا بما تبغي النفوسُ من المنى","وما تشتهي الآمال من دَوْحها النَضْر",15,"ر",1,0],["ففزْ بهما واشدد على العزّ فيهما","عُرًى لا يَرى خطبٌ مكانَ انفصامِها",16,"م",3,0],["ففز بها وقل لها","نصراً بكم وفتحا",17,"ح",2,0],["ففز بالفخر واظفر بالأماني","وقل بالعز يا خضراء فوزي",18,"ز",2,0],["ففزتُ بأَسنى ما حَوَتْهُ رواجبِي","وجاوزت في أمِّ المصيباتِ حدَّها",19,"د",3,0],["فَفَزع الناسُ وَشاعَ الكَربُ","وَالصُلح نامَ ثُمَ قامَ الحَربُ",20,"ب",1,0],["فَفَزع الثَعلَبُ لِلكلبَين","وَفَرَّ يَشكو لِغُراب البَين",21,"ن",1,0],["فَفُزت مِنهُ بِجَزيل البرّ","مِن بَعدما قابَلَني بِالبِشرِ",22,"ر",1,0],["ففز في جنان الخلد كاظم آنسا","بأبكار حور حاليات المراشف",23,"ف",1,0],["فَفُزْتُ فِي كُتُبِ الآثَارِ حِينَ غَدَتْ","تُرْوَى بِسِلْسِلَةٍ عُظْمَى من الذَّهَبِي",24,"ي",1,0],["فَفُزتَ وكُنتَ لأمثالِها","وأمثالُها لكَ في المجمَعِ",25,"ع",1,0],["فَفُزنا بِعَبّادٍ وَيَحيى بنَ بَشَّةٍ","وَدارَت رَحانا بَعدَهُم بِشَليلِ",26,"ل",1,0],["ففزعت لما قلنَ ذا","ك أبو عصام وخفت أمرا",27,"ر",2,0],["فَفز بِزَفاف أَنتَ شَمس سُعوده","وَبَدر عُلاه بِالتَهاني لَقَد صَفا",28,"ف",2,0],["فَفُز بِقران أَنتَ بَدر سُعوده","وَشَمس تَهانيه بِسعدك تَسعد",29,"د",1,0],["ففز بها وانتهز تظفر بغاية ما","تبغيه جزما وما جزم كمظنون",30,"ن",1,0],["ففز بالتهاني وقل أن تؤرخ","غلامي حبيب زكي أصيل",31,"ل",1,0],["ففُزتُ كما فازا وجاورت غايةً","يُقَصِّرُ عنها السابقُ المتمهِلُ",32,"ل",1,0],["ففز بالمعالي كيفما شئت في الهنا","فبشراك قد وافت بصدق المواعيد",33,"د",1,0],["ففز بجزيل الأجر وهو مؤرخ","لا سنى ثواب الحج بشرى محمد",34,"د",1,0],["ففُزْ بفعل صالح الأعمالِ","تحز صلاح الحال والمآل",35,"ل",1,0],["فَفُزتُ لَنا تَختال بِالحُسنِ والبها","فَقالَت وَقَد تاهَ الدَلالُ بِعَطفِها",36,"ه",2,0],["ففز بجنان الخلد وانعم برحمةٍ","وَعش بجميل إنَّ ذكرَك طيِّب",37,"ب",1,0],["ففز بنعيم سرمدي مخلّدٍ","وَذر وحشةَ الدُنيا بإيناس جنة",38,"ه",1,0],["فَفُزنا بِها مَجداً وَفاءَ عَدُوُّنا","بِحِقدٍ وَقَتلٍ في النُفوسِ الأَوانِحِ",39,"ح",1,0],["ففزنا بلقياه كما فاز في لقا","رضا الله والغفران كهلاً وشائبا",40,"ب",2,0],["ففزت بلدة الرضوان فاهنأ","بجنات بلغت بهن قصدا",41,"د",2,0],["ففزت من الفرودس بالرتب الع","لى لديه فدم في غبطة متفنقا",42,"ق",2,0],["ففزت من الفردوس بالرتب الع","لى لديه فدم في غبطة متفنقا",43,"ق",2,0],["ففزّ خارج صدري","من شوقه ثم فرّا",44,"ر",2,0],["ففزعتُ من شوقي إلى هذا الذي","قد عادَ يحْدُوهُ الحنينُ محَلِّقَا",45,"ق",2,0],["ففَزعنَ مِن قَولي ونَفَّضْنَ العَفا","ومَسحنَ ما أندى عليهِ الَمدمَعُ",46,"ع",1,0],["ففزت بأحسن أسمائهم","وأقبح منزلة الداخلينا",47,"ن",2,0],["ففُزْ بحظِّكَ . لا . لا , سرتُ مهتديا","بالحقِّ .. والأرضُ ضاقتْ والفضا انتقلا !",48,"ل",2,0]]}