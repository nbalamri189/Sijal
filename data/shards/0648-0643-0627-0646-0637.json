{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[55,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[65,"وأغر إن عذر الورى","https://www.aldiwan.net/poem45937.html","مجزوء الكامل"],[73,"لو أن قاضي الحب ممن يرتشي","https://www.aldiwan.net/poem3961.html","الكامل"],[90,"أ تونس أن في بغداد قوما","https://www.aldiwan.net/poem44988.html","الوافر"],[47,"لأوشك شعب الحي أن يتفرقا","https://www.aldiwan.net/poem65185.html","الطويل"],[30,"ليست ترد ديات من قد قتلت","https://www.aldiwan.net/poem5440.html","الكامل"],[63,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[51,"الجود لا ينفك حامده","https://www.aldiwan.net/poem63119.html","السريع"],[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[82,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8240","الكامل"],[108,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[164,"خذا بي نحو الصوت لا تتبعا الصدى","https://www.aldiwan.net/poem58787.html","الطويل"],[164,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[199,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[203,"أمن الظبا ذاك الغرير المعجب","https://www.aldiwan.net/poem45580.html","الكامل"],[292,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[370,"لمن الديار بروضة السلان","https://www.aldiwan.net/poem44474.html","الكامل"],[463,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[469,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[498,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[556,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66816","الوافر"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67013","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48629","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77538","الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56620","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73961","الكامل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124693","الكامل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79448","البسيط"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96324","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125466","البسيط"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34718","المجتث"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93642","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132570","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100720","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206168","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85048","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102938","الكامل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18804","الكامل"],[4858,"الطيرُ في بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=33864",""],[4119,"نبت الجفون فما اغتمضن وإنما","https://www.poetsgate.com/ViewPoem.aspx?id=16124",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5198,"بوصلة","https://www.poetsgate.com/ViewPoem.aspx?id=136236",""],[5219,"المتهمة البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=194914",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["وَكانَ طَريقُ الجودِ عِندَكَ مَأمَناً","فَأَذأَبَ بِالقَومِ اللِئامِ وَأَسبَعا",0,"ع",2,0],["وَكَأَنَّ طولَ العُمرِ رَوحَةُ راكِبٍ","قَضّى اللُغوبَ وَجَدَّ في الإِسراءِ",1,"ا",2,0],["وَكَأَنَّ طُرَّةً صُبْحِهِ","لِيثَتْ بِناصِيَةِ الدُّجَى",2,"ج",2,0],["وَكَأَنَّ طُرَّتَهُ وَضَوءَ جَبينِهِ","صُبحٌ تَوَضَّحَ تَحتَ لَيلٍ أَغطَشِ",3,"ش",1,0],["وكان طوافه شرقاً وغرباً","لغير تكسُّب وسوى ارتِفاد",4,"د",1,0],["وَكانَ طَريقُ المَجدِ خَلفَكَ واضِحاً","وَفِعلُ المَعالي لَو أَرادوهُ مُطلَقا",5,"ق",2,0],["وَكَأَنَّ طَعمَ رُضابِ فيها إِذ بَدَت","بَرَدٌ بِفَرعِ بَشامَةٍ مَصقولِ",6,"ل",1,0],["وكان طريقُ القَصْفِ وعراً عليهِمُ","فسهَّلْتَه حتى رَأَوه مُعبَّدا",7,"د",2,0],["وَكانَ طَوى كَشحاً عَلى مُستَكِنَّةٍ","فَلا هُوَ أَبداها وَلَم يَتَجَمجَمِ",8,"م",1,0],["وَكَأَنَّ طَعمَ العَيشِ حينَ مَضى","حُلُمٌ يُحَدِّثُ عَنهُ حالِمُهُ",9,"م",2,0],["وكأنّ طيبَ ثنائِهِ أرجٌ","عن روَضِهِ يَتَنَفّسُ السّحَرُ",10,"ر",1,0],["وكأنّ طعنته وِجَارٌ واسِعٌ","فلثعلبِ الخطِّيِّ فيه ضُبَاحُ",11,"ح",1,0],["وكأنّ طَيْفاً ما اهتَدى فبعثْتُمُ","مِسكَ الجيوب الرَّدْعَ منه بَديلا",12,"ل",2,0],["وكأن طياراتهم","في الجو عقبان جوارح",13,"ح",1,0],["وَكَأَنَّ طارِقَها عَلى علَلِ الكَرى","وَالنَجمُ وَهناً قَد دَنا لِتَغورِ",14,"ر",1,0],["وكأَن طعم الموت في","أفواههم شهد وراح",15,"ح",1,0],["وَكَانَ طَوَى كَشْحاً عَلَى مُسْتَكِنَّةٍ","فَلاَ هُوَ أَبْدَاهَا وَلَمْ يَتَقَدَّمِ",16,"م",1,0],["وَكَأَنَّ طَعمَ مُدامَةٍ جَبَلِيَّةٍ","قَد عُتِّقَت سَنَتَينِ لَمّا تُنكَسِ",17,"س",1,0],["وكان طليقاً بالجدالِ لسانُه","فلما وعى منك المال تقيّدا",18,"د",2,0],["وكان طفلاً متى ما يلق مئزره","يزجره ملك فيستحيي ويحتشم",19,"م",1,0],["وَكَأَنَّ طَعمَ الزَنجَبيلِ وَلَذَّةً","صَهباءَ ساكَ بِها المُسَحِّرُ فاها",20,"ا",3,0],["وكأنَّ طرتهُ طليعةُ ليلةٍ","حلكتْ فأشرقَ في دجاها كوكبُ",21,"ب",1,0],["وَكَأَنَّ طَعمَ الزَنجَبيلِ بِهِ","إِذ ذُقتَهُ وَسُلافَةَ الخَمرِ",22,"ر",1,0],["وكأنَّ طَعمَ مُدامَةٍ جَبَليّةٍ","بالمِسكِ والكافورِ والرَّيحانِ",23,"ن",1,0],["وكان طفى الزمان به","أُوامي أو شفى قَرَمي",24,"م",2,0],["وكأنَّ طرَّتهُ وضوءَ جبينه","ليلٌ دجا فاعتاقه صبح أضا",25,"ض",2,0],["وَكَأَنَّ طَرفَ الشَمسَ مَطروفٌ وَقَد","جَعَلَ الغُبارَ لَهُ مَكانُ الأَثمد",26,"د",1,0],["وكأنّ طَلعة شيبةٍ في مَفْرقٍ","عندَ الغواني ضربةٌ من فالِقِ",27,"ق",1,0],["وكان طعامُهُ خبزاً وزيتاً","ويؤثر باللُّحومِ الطارِقينا",28,"ن",2,0],["وكأنَّ طَرْفِي مِسْمَعِي وكأنَّه","صَوْتٌ وشَكْلُ خُطُوْطِهِ تلحيْنُ",29,"ن",1,0],["وكان طالَعَ بَيْتَيْ بِنْتِهِ وهما","أمام عاشقها الولهان فانقلبا",30,"ب",2,0],["وَكانَ طَبعه الجَميل الشافي","أَن يَحمل الناس عَلى الأَكتافِ",31,"ف",1,0],["وكأنَّ طَعمَ مُدامَةٍ عانِيَّةٍ","شَمِلَ الرياقَ وخالَطَ الأسنانا",32,"ن",2,0],["وكأن طيفاً قد ألم بنا","وارتد وهو مروع عجل",33,"ل",1,0],["وكأن طرتهُ ونور جبينه","لليلٌ تألقَّ فيه بارق صبحه",34,"ح",2,0],["وكأنّ طيبك في دمي","يحيا على أمل متاح",35,"ح",1,0],["وَكَانَ طَرفُ الدَّهرِ عَنِّي نَائِمَا","فَإِن أفز كَانَ قَضَاءً لازِما",36,"م",2,0],["وكانَ طُهْراً فصارَ أَجْرا","وكانَ ظَهْراً فصارَ ذُخْرا",37,"ر",2,0],["وكان طلاب الغانيات كأنما","تباعده منهن ان يتقربا",38,"ب",2,0],["وَكانَ طالوتُ لَهُ حَسودا","فَأَظفَرَ اللَهُ بِهِ داودا",39,"د",2,0],["وكان طيفُ المُنَى بالبِشرِ مُبتَسِماً","ترنو إليه نجومُ اللَّيلِ من صَعَدِ",40,"د",1,0],["وَكانَ طَلقاً ضَحوكاً","يُجيبُ كُلَّ أَوانِ",41,"ن",1,0],["وَكَأن طفل النَبت في مَهد الربى","أرواه مِن ثَدي الغَمام رضاع",42,"ع",1,0],["وكأن طاووس السقاة جلا الطلا","طاسات راح أترعت أرواحا",43,"ح",2,0],["وكان طوع مساعيك التي سلفت","لو كنت تبقى لنا المستقبل الرغد",44,"د",1,0],["وكان طليقاً أزهر اللون وجهه","وللغرب وجه اصفر اللون شاحبه",45,"ب",2,0],["وكأن طيبة والهياكل حولها","ملء الفضاء أواهلٌ شمَّاء",46,"ا",2,0],["وكان طلعة يوسف","أعطته منها الحسن وهبه",47,"ب",2,0],["وكأن طائرة النبال إذا هوت","قبسات ضوء الكوكب المتوهج",48,"ج",1,0],["وَكَأَنَّ طَعمَ سَلافَةٍ مَشمولَةٍ","تَنصَبُّ في إِثرِ السِواكِ الأَغيَدِ",49,"د",1,0],["وكأنَّ طيورَكِ يا بلدي","تخلو من نسْرٍ أو رَخَمِ!",50,"م",1,0],["وكأن طرفي حين أبكته دما","ألقى الشعاع بخدها فتوردا",51,"د",2,0],["وكان طايح دمعها في خدها","ورداً تبادر فوق صحن مذهب",52,"ب",1,0],["وكان طبعك تناسى الود ماتذكره","من تناسى تجاهلته وقلبي نساه",53,"ا",2,0],["وكان طعامه زيتا وخبزا","ويعطيني طوال الشهر مالا",54,"ل",2,0],["وَكَأَنْ طَارِقًا لَمْ يَخُضْهَا بِحَارًا","وَجِبالاً إِلَى مَنِيعِ السُّهُولِ",55,"ل",1,0]]}