{"poems":[[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[63,"وأغر إن عذر الورى","https://www.aldiwan.net/poem45937.html","مجزوء الكامل"],[71,"لو أن قاضي الحب ممن يرتشي","https://www.aldiwan.net/poem3961.html","الكامل"],[88,"أ تونس أن في بغداد قوما","https://www.aldiwan.net/poem44988.html","الوافر"],[45,"لأوشك شعب الحي أن يتفرقا","https://www.aldiwan.net/poem65185.html","الطويل"],[28,"ليست ترد ديات من قد قتلت","https://www.aldiwan.net/poem5440.html","الكامل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[49,"الجود لا ينفك حامده","https://www.aldiwan.net/poem63119.html","السريع"],[80,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8240","الكامل"],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[156,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[160,"خذا بي نحو الصوت لا تتبعا الصدى","https://www.aldiwan.net/poem58787.html","الطويل"],[160,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[195,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[199,"أمن الظبا ذاك الغرير المعجب","https://www.aldiwan.net/poem45580.html","الكامل"],[287,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[365,"لمن الديار بروضة السلان","https://www.aldiwan.net/poem44474.html","الكامل"],[458,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[464,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[493,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[551,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"]],"verses":[["وَكانَ طَريقُ الجودِ عِندَكَ مَأمَناً","فَأَذأَبَ بِالقَومِ اللِئامِ وَأَسبَعا",0,"ع",2,0],["وَكَأَنَّ طولَ العُمرِ رَوحَةُ راكِبٍ","قَضّى اللُغوبَ وَجَدَّ في الإِسراءِ",1,"ا",2,0],["وَكَأَنَّ طُرَّةً صُبْحِهِ","لِيثَتْ بِناصِيَةِ الدُّجَى",2,"ج",2,0],["وَكَأَنَّ طُرَّتَهُ وَضَوءَ جَبينِهِ","صُبحٌ تَوَضَّحَ تَحتَ لَيلٍ أَغطَشِ",3,"ش",1,0],["وكان طوافه شرقاً وغرباً","لغير تكسُّب وسوى ارتِفاد",4,"د",1,0],["وَكانَ طَريقُ المَجدِ خَلفَكَ واضِحاً","وَفِعلُ المَعالي لَو أَرادوهُ مُطلَقا",5,"ق",2,0],["وَكَأَنَّ طَعمَ رُضابِ فيها إِذ بَدَت","بَرَدٌ بِفَرعِ بَشامَةٍ مَصقولِ",6,"ل",1,0],["وكان طريقُ القَصْفِ وعراً عليهِمُ","فسهَّلْتَه حتى رَأَوه مُعبَّدا",7,"د",2,0],["وَكانَ طَوى كَشحاً عَلى مُستَكِنَّةٍ","فَلا هُوَ أَبداها وَلَم يَتَجَمجَمِ",8,"م",1,0],["وَكَأَنَّ طَعمَ العَيشِ حينَ مَضى","حُلُمٌ يُحَدِّثُ عَنهُ حالِمُهُ",9,"م",2,0],["وكأنّ طيبَ ثنائِهِ أرجٌ","عن روَضِهِ يَتَنَفّسُ السّحَرُ",10,"ر",1,0],["وكأنّ طعنته وِجَارٌ واسِعٌ","فلثعلبِ الخطِّيِّ فيه ضُبَاحُ",11,"ح",1,0],["وكأنّ طَيْفاً ما اهتَدى فبعثْتُمُ","مِسكَ الجيوب الرَّدْعَ منه بَديلا",12,"ل",2,0],["وكأن طياراتهم","في الجو عقبان جوارح",13,"ح",1,0],["وَكَأَنَّ طارِقَها عَلى علَلِ الكَرى","وَالنَجمُ وَهناً قَد دَنا لِتَغورِ",14,"ر",1,0],["وكأَن طعم الموت في","أفواههم شهد وراح",15,"ح",1,0],["وَكَانَ طَوَى كَشْحاً عَلَى مُسْتَكِنَّةٍ","فَلاَ هُوَ أَبْدَاهَا وَلَمْ يَتَقَدَّمِ",16,"م",1,0],["وَكَأَنَّ طَعمَ مُدامَةٍ جَبَلِيَّةٍ","قَد عُتِّقَت سَنَتَينِ لَمّا تُنكَسِ",17,"س",1,0],["وكان طليقاً بالجدالِ لسانُه","فلما وعى منك المال تقيّدا",18,"د",2,0],["وكان طفلاً متى ما يلق مئزره","يزجره ملك فيستحيي ويحتشم",19,"م",1,0],["وَكَأَنَّ طَعمَ الزَنجَبيلِ وَلَذَّةً","صَهباءَ ساكَ بِها المُسَحِّرُ فاها",20,"ا",3,0],["وكأنَّ طرتهُ طليعةُ ليلةٍ","حلكتْ فأشرقَ في دجاها كوكبُ",21,"ب",1,0],["وَكَأَنَّ طَعمَ الزَنجَبيلِ بِهِ","إِذ ذُقتَهُ وَسُلافَةَ الخَمرِ",22,"ر",1,0],["وكأنَّ طَعمَ مُدامَةٍ جَبَليّةٍ","بالمِسكِ والكافورِ والرَّيحانِ",23,"ن",1,0],["وكان طفى الزمان به","أُوامي أو شفى قَرَمي",24,"م",2,0],["وكأنَّ طرَّتهُ وضوءَ جبينه","ليلٌ دجا فاعتاقه صبح أضا",25,"ض",2,0],["وَكَأَنَّ طَرفَ الشَمسَ مَطروفٌ وَقَد","جَعَلَ الغُبارَ لَهُ مَكانُ الأَثمد",26,"د",1,0],["وكأنّ طَلعة شيبةٍ في مَفْرقٍ","عندَ الغواني ضربةٌ من فالِقِ",27,"ق",1,0]]}