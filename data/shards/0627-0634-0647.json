8",""],[5606,"ليت فلان نام","https://www.poetsgate.com/ViewPoem.aspx?id=207434",""],[5608,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=32911",""],[5652,"مشكلة لا صرت تدري وش بلاك ؟","https://www.poetsgate.com/ViewPoem.aspx?id=190146",""],[5668,"لم أعشق سواه","https://www.poetsgate.com/ViewPoem.aspx?id=179114",""],[5691,"أشهد اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=206120",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5694,"اعشقك نجد","https://www.poetsgate.com/ViewPoem.aspx?id=132105",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5756,"لا قبلك ولا بعدك سعد","https://www.poetsgate.com/ViewPoem.aspx?id=5368",""],[5756,"سمو المجد","https://www.poetsgate.com/ViewPoem.aspx?id=5373",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[402,"آلاء فاروق المفدى","https://www.poetsgate.com/ViewPoem.aspx?id=35465",""],[5790,"أشهد أن الله سبحانه","https://www.poetsgate.com/ViewPoem.aspx?id=111966",""],[5829,"الزحف المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=204629",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5939,"بي لها","https://www.poetsgate.com/ViewPoem.aspx?id=179999",""],[5953,"بيني وبينك عصمة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=93833",""],[5956,"إن عشتُ للربيع","https://www.poetsgate.com/ViewPoem.aspx?id=183183",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"قبرُ شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183885",""],[5956,"الصلة المقدسة","https://www.poetsgate.com/ViewPoem.aspx?id=192027",""],[5969,"الثوري العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=198903",""],[6056,"الأحلام الوردية","https://www.poetsgate.com/ViewPoem.aspx?id=130357",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[6217,"قَدْرُ المُدامَة ِ فوقَ قَدْرِ الماءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23123&r=&rc=0",""],[6225,"نداء الأرض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80913&r=&rc=182",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""],[2220,"أشهد في خالقي بجوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11894&r=&rc=763",""]],"verses":[["أَشهى إِلَينا مِن غِنائِكَ مَسمَعاً","زَجَلُ الضَراغِمِ بَينَهُنَّ قِراعُ",0,"ع",1,0],["أَشهى إِلَيَّ مِنَ النَعيمِ يَدومُ لي","وَأَلَذُّ مِن نِعَمٍ عَلَيَّ مُراحِ",1,"ح",1,0],["أَشَهِدْتَ مِنْ إِيمائِهِمْ","مَا يَجْعَلُ الْبُعْدَ اقْتِرَابَا",2,"ب",2,0],["أشهدت لهفته عليه","حين قيل دنا بعاده",3,"د",2,0],["أَشَهَدْتَهُ أَيَّامَ أُغْمِدَتِ الظُّبَى","وَتَلاقَتِ الآرَاءُ فِي المَيْدَانِ",4,"ن",1,0],["أَشَهِيدَ أَنْبَلِ مَا يُكَابِدُ مُغْرَمٌ","بِبِلادِهِ مِنْ حُبِّهَا وَيُعَانِي",4,"ن",2,0],["أَشْهَدُهُ وَالقِطَارُ يَفْرِي","بِسُرْعَةِ البَارِقِ الظَّلامَا",5,"م",2,0],["أَشهى حَديثَ النَدمانِ في فَلَقِ ال","صُبحِ وَصَوتَ المُسامِرِ الغَرِدِ",6,"د",1,0],["أشهدُ إن لم ترح وتغدو","جليس قعقاعٍ بنِ شور",7,"ر",1,0],["أُشهِدُ اللَه أن وزنك عندي","دون وزن النقير والقِطمير",8,"ر",1,0],["أُشهِدُ اللَّه إن تركتُكَ أني","لم أجرب حلاوة الإقتناص",9,"ص",1,0],["أشهر في الناس بالجميل من ال","أبلق بين الجياد بالبلق",10,"ق",1,0],["أَشهِدُ الصُبحَ فائِضاً","في مُروجِ الزَبَرجَدِ",11,"د",1,0],["أَشهِدُ اللَيلَ لابِساً","طَيلَسانَ التَمَرُّدِ",11,"د",1,0],["أُشهِدُ الغَيثَ مُعطِياً","أُشهِدُ الحَقلَ يَجتَدي",11,"د",2,0],["أُشهِدُ الأَرض وَالسَما","أُشهِدُ اللَهَ موجِدي",11,"د",2,0],["أَشهى إِلى نَفسي مِنَ الذُلِّ الرَدى","لا يَرتَضي بِالذُلِّ غَيرُ جَبانِ",12,"ن",1,0],["أَشهى مِنَ العودِ المُرَنَّمِ مَنطِقاً","وَأَلَذُّ مِن أَوتارِهِ تَغريدا",13,"د",2,0],["أشهَى إِلى قلبي وألطفُ موقعاً","من أن أُلمَّ بملتقَى الأقرانِ",14,"ن",1,0],["أَشهَدُ بِاللَهِ لَقَد قارَبَ ال","باحِثُ عَن عَيبِكَ أَو أَنصَفا",15,"ف",2,0],["أشهى إلى الملحيّ من قبلة","لذيذة في إثرهها عضه",16,"ض",2,1],["أَشهَدُ بِاللَهِ وَآياتِهِ","شَهادَةً باطِنَةً ظاهِرَه",17,"ه",1,1],["أشهابٌ في دجى الليل ثَقَبْ","أم سراجٌ نارُهُ ماءُ العِنَبْ",18,"ب",1,1],["أشهى من الوجهِ الجميلِ إليهمُ","وجهُ \" الكتابِ \" وَوُدُّهُ المخطوب",19,"ب",1,0],["أَشَهراً كُلَّهُ إِلّا ثَلاثاً","أَقَمتَ عَلى مُصارَمَتي وَهَجري",20,"ر",2,0],["أُشهِدُ الرَحمَنَ لا يَجمَعُنا","سَقفُ بَيتٍ رَجَباً حَتّى رَجَب",21,"ب",1,0],["أَشَهِدْتَ ما عَقدَ الهُداةُ وأَبرَمتْ","أيدي الحُماةِ الجِلَّةِ الأخيارِ",22,"ر",1,0],["اشهَدي يا مِصرُ أَعمالَ البَنينْ","وَاِنظُري الآياتِ حيناً بَعدَ حينْ",23,"ن",1,1],["أَشْهَدُ الآنَ مُوقِناً مُطمئِنّاً","أنّه اللّهُ رَبُّنا المعبودُ",24,"د",1,0],["اشهَدْ حُنَيْنُ بما رأيتَ ولا تَخَفْ","خَصماً يُنازِعُ أو عَدُوّاً يَشْغَبُ",25,"ب",1,0],["أَشهى مِنَ القَهوَةِ وَالكاسِ","عَلى نَسيمِ الوَردِ وَالآسِ",26,"س",1,1],["أشهَدتَهم كلَّ فَضْفاض القميص ضحىً","في سْرجِ كلّ طِمِرّ العدوِ قَيدودِ",27,"د",1,0],["أَشهى إِلى النَفسِ مِن عَدوِ الكِلابِ عَلى","أَرانِبِ الصَيدِ أَو مِن رَميِ بُرجاسِ",28,"س",1,0],["اِشهَدوا أَنّي بَريءٌ","مِن هَواها مُتَخَلّي",29,"ل",2,0],["أشهى على النفس من عدو الكلاب عل","أرانب الصيد من رمي ببرجاسِ",30,"س",1,1],["أشهى من الحلبة والركضِ","إليّ شمُّ النرجسِ الغضّ",31,"ض",1,1],["أَشهى لِنَفسي لَو أُثَقِّلُها","وَلِما بِها مِن لَيلَةِ القَدرِ",32,"ر",1,0],["أَشهَدُ أَنّي رَجُلٌ ناقِصٌ","لا أَدَّعي الفَضلَ وَلا أَنتَحِل",33,"ل",1,1],["أَشْهَدْتَ فِيهِ مِصْرَ آيَةَ بَهْجَةٍ","أَبَداً يُرَدِّدُ ذِكْرَهَا السُّمَّارُ",34,"ر",1,0],["اشْهَدْتنَا فِي يَوْمِ خُطْبَتِهَا","يَوْماً يَضِنُّ بِمِثْلِه العُمْرُ",35,"ر",1,0],["أَشْهَدْتَ هَذَا الْعَصْرَ مِنْ تَصْعِيدِهَا","فِي المَجْدِ مَا لَمْ تَشْهَدِ الأَعْصَارُ",36,"ر",1,0],["أَشَهِدْتُ خَيْراً لاَ يُنَاهِضُهُ","شَرٌّ إِلى أَنْ يَدْحَرَ الشَّرَّا",37,"ر",2,0],["أَشَهِدْتُمُ آيَاتِ مَا ال","بَلَدُ الأَمِينُ لَكُمْ أَعَدَّا",38,"د",2,0],["أَشَهِدْتُمُ فِي المُلْتَقَى","بِجَلاَلِ ذَاَ الحَشْدِ حَشْدَا",38,"د",2,0],["أَشَهِدْتُمُ التَّرْحِيبَ وَالتَّ","رْحِيبَ فِي مَمْسَى وَمَغْدَى",38,"د",2,0],["أشهدي الريح والسحاب، إذا ما","عزبَ الحق عن بني الإنسان",39,"ن",1,0],["اشهَدي دجلةٌ بأني – كما كنتُ -","قوياً جسماً وعزماً وذِهنا",40,"ن",2,0],["أشهد أن الاّّ تقال ال غيره والاّّ اا له","صاحبن في بيد قلبي . قاطعلّه فرجه",41,"ج",2,0],["أشهدُ ما يكونُ على هجاءِ","هُجيتَ به إذا عاقبتَ فيه",42,"ي",2,1],["أَشهى إِلَيَّ مِن الزُلال عَلى الظَما","مَرآهُ في الإِصباح وَالإِمساءِ",43,"ا",2,1],["أَشهَدُ في الدُنيا وَما سِواها","أَن لا إِلهَ غَيرُهُ إِلها",44,"ه",2,0],["أَشهَدُ أَنَّ الدينَ دينُ أَحمدِ","فَلَيسَ مَن خالَفَهُ بِمُهتَدي",44,"ي",1,0],["أُشهِدُ اللَهَ وَالمَلائِكَةَ الأَبْ","رار وَالعابِدينَ أَهلَ الصَلاحِ",45,"ح",1,1],["أَشهى إِلى الشربِ يَومَ جَلوَتَها","مِنَ الفَتاةِ الكَريمَةِ النَسَبِ",46,"ب",1,0],["أشهَى له من قَينةٍ مطربٍ","عناقُهُ جرداءَ صَهَّالَهْ",47,"ل",2,0],["اشهد بالله لقد أطربني","سعدكم حتى رقصتُ فرحا",48,"ح",2,0],["أَشْهُرٌ خُصَّتْ بفضلٍ ظاهر","هو من فضْلِك مثل القُضُب",49,"ب",1,0],["أشهى إليّ من السلا","م أو الوقوف على صلف",50,"ف",1,0],["أَشهى إِلى الحُرِّ من طعامٍ","يُختمُ بِالشُهدِ والملامَه",51,"ه",1,0],["أَشْهَدُ ألا إِلَهَ إِلا اللهْ","مُحمدٌ المُصْطفى رَسُولُ اللهْ",52,"ه",1,1],["أشهرتِ فينا ظبا الحاظِكِ السُودِ","في غير ثأرٍ عيونَ الخُرَّد الغيدِ",53,"د",1,1],["أَشهِر بِهِ في نَشرِ تاريخه ال","مَشحونِ بِالفَضلِ وَسِحرِ البَيان",54,"ن",1,0],["أَشهى إلى المضنى العَليل من الشِفا","وأَلذّ في العَينينِ من غَمضِ الوَسَن",55,"ن",1,0],["أَشهى وأَبهى من نظم قافيَةٍ","أَهدَيتَها للمحبِّ من كثَبِ",56,"ب",1,0],["أشهد أن اللَه حي قدير","له البقاء الحق كالقدم",57,"م",1,0],["أَشهدتنا مِصداقَ قول نبيّنا","هِيَ أمّتي كالوابل الهتّانِ",58,"ن",1,0],["أَشهدتَنا عَن فضلكَ اللهمّ ما","لا يستقلُّ بِشكرهِ الثقلانِ",58,"ن",1,0],["أَشهدتَني اللّهمّ فَضلك عاجلاً","مِثلَ الّذي أشهدتني أَن تقهرا",59,"ر",2,0],["أشهدته عناية الله في التم","حيص أن كان عونه ومنيله",60,"ل",2,0],["أشهديني فأنا الصوفي","يفنى في الشهود",61,"د",1,0],["أَشهى لَهُ الأَجل المُتاح أَو العلى","من أَن يَعيش لَدى الأَنام محقّرا",62,"ر",2,0],["أشهبُ خيلٍ خَلَّ المجالَ له","أدهمُ