181709",""],[4984,"الليل نصف زماننا","https://www.poetsgate.com/ViewPoem.aspx?id=191454",""],[4984,"الْعُزْلَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=200982",""],[4984,"تَسْعَى إِلَى الْجَاهِ","https://www.poetsgate.com/ViewPoem.aspx?id=201287",""],[585,"يا ساحة المجد أين المعجب الصلف","https://www.poetsgate.com/ViewPoem.aspx?id=161925",""],[585,"حييت من وطنٍ كالركن مستلم","https://www.poetsgate.com/ViewPoem.aspx?id=161912",""],[585,"يا رب أقدام كان الداء منحسما","https://www.poetsgate.com/ViewPoem.aspx?id=161846",""],[5139,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=68955",""],[5246,"لبيك من طلب القريض تكرما","https://www.poetsgate.com/ViewPoem.aspx?id=187070",""],[5318,"إربْد، عروسُ البلادِ وستُ الدُررْ","https://www.poetsgate.com/ViewPoem.aspx?id=206867",""],[5318,"سأكتبُ أنكِ أحلى البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=210309",""],[5318,"\"لإربدَ\" أن تُعاتبَ ما اْستطابتْ..","https://www.poetsgate.com/ViewPoem.aspx?id=211011",""],[5343,"عجزت عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=132536",""],[5431,"حكمةٌ وسعادة....","https://www.poetsgate.com/ViewPoem.aspx?id=207031",""],[5431,"صحوة الأرض...","https://www.poetsgate.com/ViewPoem.aspx?id=208842",""],[5458,"كان جدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=72394",""],[5582,"نَهَكَ الغَرامُ فُؤادَهُ وَحَشاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187332",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5704,"المذاهب الاربعه...","https://www.poetsgate.com/ViewPoem.aspx?id=200005",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5853,"ظلمة الشك","https://www.poetsgate.com/ViewPoem.aspx?id=175613",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[5956,"إبليس","https://www.poetsgate.com/ViewPoem.aspx?id=194037",""],[4442,"أحمامة الوادي أصدحي أو هينمي","https://www.poetsgate.com/ViewPoem.aspx?id=171017",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[313,"أمل يخيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66500&r=&rc=22",""],[2220,"إنّ التحرّك عن ضجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11463&r=&rc=337",""]],"verses":[["فَأَربِح بِها مِن صَفقَةٍ لِمُبايِعٍ","وَأَعظِم بِها أَعظِم بِها ثُمَّ أَعظِمِ",0,"م",1,0],["فأربط ذي مسامعَ أنت جأشا","إذا أنتفخت من الوَهَل السُّحورُ",1,"ر",1,1],["فاربَعْ عليك فمن رمى","صُعُداً بجَنْدلِهِ أصابهْ",2,"ب",2,0],["فارببهُ واحرسْ جَناه تَحْظَ به","وصُنهُ عن مَسِّ معشرٍ نُجُس",3,"س",1,0],["فَاِربَء بِنَفسِكَ وَالحَياةُ قَصيرَةٌ","أَن تَجعَلَ الأَضغانَ مِن أَحمالِها",4,"ل",3,0],["فَاِربَأ بِعَزمِكَ لَم تَدَع مِن مَنصِبٍ","يُفضي إِلى رُتَبِ العُلى لَم تَأتِهِ",5,"ت",2,0],["فاربأ بنفسك نحو من حمل العلا","والمجدُ حالُ تفاوتٍ في نقلهِ",6,"ل",2,0],["فَاِربِط لِأُمِّكَ عَن رَبيكَ أَتانَهُ","وَاِخسَأ فَما بِكَ لِلكِرامِ فَخارُ",7,"ر",1,1],["فَاِربُطوا شَدقَها إِذا نَفَخَت","فَذاكَ أَولى بِها مِنَ الناءِ",8,"ا",2,0],["فَأَربَعَةٌ لِأَربَعَةٍ","لِكُلِّ طَبيعَةٍ رِطلُ",9,"ل",1,0],["فَاِربَع عَلى خُلُقٍ لَهُ خَطَرٌ","في الصالِحينَ يَفوزُ مُحتَسِبُه",10,"ب",2,0],["فَارْبَأْ يَفاعاً أَوِ اتَّخِذْ سَرَباً","إِنْ كَانَ يُغْنِي الْيَفَاعُ وَالسَّرَبُ",11,"ب",1,0],["فَارْبَحْ مَلامَكَ يَا عَذُولُ فَإِنَّنِي","راضٍ بِسُقْمِي فِي الْهَوَى وَعَذَابِي",12,"ب",2,0],["فاربأ بنفسك والحياة قصيرة","أن تجعل الأضغا ن من أحمالها",13,"ل",3,0],["فَارْبِطْ لأُمّكَ عَنْ أبِيكَ أتَانَهُ،","وَاخْسأ فَما بكَ للكرَامِ فَخَارُ",14,"ر",1,0],["فاربط على هذا المقام القلب لا","يغرر فشأن قلوبنا كر وفر",15,"ر",1,0],["فاربع على ضلع الرزانة والحجا","وانعم بمين وقارك الكذاب",16,"ب",1,0],["فاربع على ضلع المنية إنها","وأبيك أغنى من أغن مرابعي",17,"ع",2,0],["فاربأْ بعمرك أن يمر ولم تَؤُبْ","مُسترشدا من ذي الوَرَى بثَنَاءِ",18,"ا",2,0],["فَاِربَع فَما لِلبيضِ فيكَ لُبانَةٌ","لِسِواكَ خوطُ البانَةِ الأُملودُ",19,"د",1,0],["فاربعاء احد ثم اثبت","خميسها للسنة المقبلة",20,"ه",1,0],["فاربأ بنفسك تنج من سطواتها","إن السلامة في لزوم المسجد",21,"د",1,0],["فاربَعْ مع الكرماءِ تحت وفائهم","حتى تقولَ لك العلا لا تربعِ",22,"ع",1,0],["فأربح بأيمن صفقة مأمونة","وأسعد بفال الطائر الميمون",23,"ن",1,0],["فأربى على كلِّ السفينِ سفينُكم","وبرّز تبريزاً ببأسِ وجرأة",24,"ه",1,0],["فاربطْ عَلَى قلبٍ وَطأمنْ لوعةً","واشددْ عَلَى كبدٍ وَصابر جاهدا",25,"د",2,0],["فَاِربأ بِنفسك أَن تكون كداجنٍ","في صفوِ عيشٍ عن مآل يخدعُ",26,"ع",1,0],["فَأَربابُ العَلاءِ لَهُ عَبيدٌ","وَلي وَلَهُ غَدا مَولىً وَعَبدا",27,"د",2,0],["فَاِربع عَلى ظلعك إِنّ الَّذي","سابقته أَجول مِن قطربِ",28,"ب",1,0],["فارْبطْ له جأْشَ الصَبور لرَيْبه","ثَبْتاً وأمْهِلْ كُلَّ ريحٍ تَرْكُد",29,"د",1,0],["فاربَعْ بربعٍ لا يزالُ نَزيلَه","حُسنُ الثّناءِ وخَشيةُ الخَلاّقِ",30,"ق",1,0],["فاربَعْ هناك إنّهُ","مربَعُ تاجِ العرَبِ",31,"ب",1,0],["فارْبِطْ لَهَا يَا أَبا مَرْوانَ جأْشَ فتىً","سَما فَأَتْبَعَ حَتَّى عادَ يُتَّبَعُ",32,"ع",1,0],["فأربعة جاءت على إثر ماية","مفسّرة بطناً ومشروحة ظهرا",33,"ر",2,0],["فأَربعون وتقفوها ثمانية","سهام من شيّد الاسلام بالأَسل",34,"ل",1,0],["فأربعون من الأعوام إن خمدت","نار الحروب فنار الحقد تلتهب",35,"ب",1,0],["فَأَربَحَ أَقواماً بِأَنفَعِ سَعيِهِم","وَضَرَّ أُناساً آخَرينَ وَأَخسَرا",36,"ر",2,0],["فاربَع بطول فسحة في عمر","وارتع بصَافي طِيب عيشٍ أرغدِ",37,"د",1,0],["فأربعة يقال هي الصبا","والدبور هي النعامى والشمالُ",38,"ل",1,0],["فاربع أشاطرك السرور وخلني","من ذكر أطلال عفت وربوعِ",39,"ع",1,0],["فأربى على الوادي المقدس في طوى","وطاول عرش الله فخراً بمن حوى",40,"ح",3,0],["فأربأ بنفسك أن تكون ذليلةً","فالذلُّ داهية لها دهماء",41,"ا",2,0],["فاربط البر بالبحار وأسس","دولة تبهر المعادين بهرا",42,"ر",2,0],["فَاِربَأ بِنَفسِكَ أَن تصادِق اِحمَقاً","إِن الصديقَ عَلى الصَديقِ مُصدق",43,"ق",1,0],["فَارْبَحْ إذنْ يا ابنَ الحُسَينِ وكلُّنا","يَلقَى بِرِبحِكَ رَوضَةً وَغَدِيرَا",44,"ر",2,0],["فاربع على ذا إن تكن رابعاً","وخلِّ عن هندٍ وعن جملِ",45,"ل",1,0],["فأربعةٌ خمسُ البنين ومثلها","من العدد الجدات تحوي وتقنعُ",46,"ع",1,0],["فأربعةٌ في ستةٍ وهو فرضهم","إذا ضربت جاءتك في الضرب تلمعُ",46,"ع",1,0],["فأربعٌ على ثالثةٍ سها","بنت لبونٍ إن تكن تربع",47,"ع",1,0],["فَاِربَأ بِنَفسِكَ عَن دارٍ تَذِلُّ بِها","لَو أَنَّ حَصباءَها دُرٌّ وَمَرجانُ",48,"ن",1,0],["فاربحْ قعودَك تسترحْ","قتكونَ من أهل الظفر",49,"ر",1,0],["فأربعة في أول الأمر عمدة","وأربعة في آخر الأمر قلد",50,"د",1,0],["فأربعة بالزور يهلك نفسه","وباغ ومظلوم وقاض تعمد",51,"د",1,0],["فاربأ بنفسك لا يمتكَ غرامُهم","إنَّ الغرام سحابةٌ تتقشَّع",52,"ع",1,0],["فَاِربَدَّ طالِعُهُم وَاِنشَقَّ هَيكَلُهُم","وَاِستَكَّ حارِسُهُم واجتاح زلزالُ",53,"ل",1,0],["فأرباب ذي الدنيا لديه وغيرهم","سواء فلا يختص ذوو الامر",54,"ر",1,0],["فاربأ بنفسك عَمّا كانَ في صغر","من المَحارِم وَالزم حمية الندم",55,"م",1,0],["فاربأ بعمرك أَن يَروحَ مضيَّعاً","فيهِ فذلك عَن قَليلٍ ينفَدُ",56,"د",1,0],["فاربعْ بنا يَا أخا الحاجاتِ إِن لنا","بمنزلِ الجودِ أطواراً من النِّعَم",57,"م",1,0],["فارْبَعْ بِنَا يَا دهرُ إن زمانَنا","لَهُو الربيعُ وقفْ عَلَى أفنائه",58,"ا",3,0],["فَارْبَعْ ليَهْنِك مَرْبعٌ","رحبُ الجوانبِ والفِنا",59,"ن",2,0],["فَاَربُب صَنيعَكَ بي فَإِنَّ بِأَعيُنٍ","لِلكاشِحينَ وَسَمعِهِم ما تَصنعُ",60,"ع",1,0],["فاربح تجارةَ عمرٍ لا بقاءَ لَهُ","وَاسعد بما جاد دَهرٌ قلَّما صلحا",61,"ح",2,0],["فاربأ بحسنك أن يكون كحبة","خضراء ملقاة ليوم جفاف",62,"ف",1,0],["فًاربَدَّ ناظِرُهُ وَلولا أُمهُ","قِبرِيسُ مُبصِرَةٌ لأَدرَكهُ البِلى",63,"ل",2,0],["فاربأ بنفسك يا هذا وكن حذرا","وصر قرينا محبا حيث ما صاروا",64,"ر",3,0],["فَاِربَع في عَشرٍ فَما كانَ بَعدَ ذا","فَتَضرِبُهُ في مِثلِهِ وَاِحذَر اَن تُخطي",65,"ط",2,0],["فَاربأ بِنفسك أَن تَميل مَع الهَوى","إِن الهَوى يطغي مَع الميلان",66,"ن",1,0],["فاربط يدي ولغيركم","وابيك لن اتعهَّدا",67,"د",2,0],["فَاِربَأ بِنا يا دَهر مُستَمسِكاً","وَاِستَبقنا يا دَهر قبلَ العَطَب",68,"ب",1,0],["فاربأ بنفسك وفكر لا تكن كالجماد","فأخرج اخرج هديت الخير نلت الرشاد",69,"د",1,0],["فاربأ بنفسك واقنع","وقر بزهدك عيونك",70,"ك",1,0],["فاربأ بنفسك إن ترد يا ذا النجا","والزم خصوصك وليسعك الدارُ",71,"ر",1,0],["فاربأ بنفسك ان تعيش مقصراً","قد اقنعتك طهارة المتيمم",72,"م",1,0],["فاربأ بنفسك من طيش تعاب به","وإن تكن حزت معه العلم والشرفا",73,"ف",2,0],["فأربعةٌ في كلِّ عامٍ تَداولتْ","فصولٌ فلا من خامسٍ غيرُ تَسْأَلُ",74,"ل",1,0],["فأربعةٌ فلوا كثيرٌ قليلُها","فدونكَها في السطر تُرْوَى وتُنْقَلُ",74,"ل",1,0],["فأربأ بنفسك من تهاويلاته","قبل انتزاعك من سرابيلاته",75,"ه",1,0],["فا رباب النهى جاؤوا فعالاً","عليها صيب الإبداع جادا",76,"د",2,0],["فأربعة من معدن قد تكونت","ومنها حياة الكل بعد مماتها",77,"ت",3,0],["فاربأ بنفسك أن تكون مجللاً","بظلال جهلٍ أو قتامة عاب",78,"ب",1,0],["فأربعة أوزان كل مقللٍ","وأربعة أوزان كل مكثر",79,"ر",1,0],["فاربأ بنفسك عن تذكر سيء","إن النقائص لا تريدك واقفا",80,"ف",2,0],["فارْبأْ بنفسك أن تنحاز منعزلا","تجنبا للأذى واللغْطِ والوَحَل",81,"ل",1,0],["فاربأ بنفسك أن ترجوَ ودهمُ","أو تقدح النار في المعروض بالزند",82,"د",1,0],["فاربأ بنفسك عن قومٍ سواسيةٍ","في الخزي يبرأ من دعواهم الشرف",83,"ف",1,0],["فاربط على قلبك الخفاق مضطلعاً","بالعبء بعد دبيب الوهن والسأم",84,"م",1,0],["فاربأ بأقدام وارفق باليراع فما","أهرقت منه مداداً بل أرقت دما",85,"م",2,0],["فاربأْ بنفسكَ أن تكون مطيّةً","للخادعين وللسياسة مَعْبرا",86,"ر",2,0],["فاربأ بنفسك كي تراعيَ صحةً","أُوليتها ولك الثواب جزيلا",87,"ل",2,0],["فإربدُ أرضٌ بها الطيبونَ","جنانٌ وزهرٌ، ربيعٌ، شجرْ",88,"ر",1,0],["فإربدُ عطرُ المواسم فيها","تعدى النسائمَ طِيباً وزاد",89,"د",1,0],["ف\"إربدُ\" ليسَ بالأنباءِ تدري","وأنبائي تقولُ استوطنتني،",90,"ن",2,0],["فَارْبَأْ بِنَفْسِكَ عَنْ مَقَالِ جَهَالَةٍ","يُرْدِيكَ عَنْ عِزٍّ فَتَغْدُوا الأَخْسَرَا",91,"ر",2,0],["فاربأ بقلبك أن يلازم عادةً","كسرُ التعوّدِ حكمةٌ وسعادة!!",92,"د",2,0],["فاربط خيولك لا تهوي قوائمها","بحفرة الطين بين الهون والعيب",93,"ب",1,0],["فاربأ بنفسك يعربياً للعلا","واسلك سبيل السادة العظماء",94,"ا",2,0],["فَارْبَعْ فَدُونَكَ فِي العُلا يا ذَا العُلا","نَجْمُ الثُّرَيَّا رُتْبَةً وَالجاهُ",95,"ا",2,0],["[ فارْبَعْ فَدُونَكَ فِي العُلُوِّ مَنازِلاً","نَجْمُ السُّها وَالكَوْكَبُ السَّيَّارُ ]",96,"ر",1,0],["فأربعة مذاهبنا جميعا","مثبتة كما رَسِّ الجبال",97,"ل",1,0],["فاربأ بنفسك قبل مد يديه في","إقباله لك في بساط تهان",98,"ن",1,0],["فاربأ بنفسكَ أن تكون بظلمةٍ","هدفاً لظنٍ ما أتاه يقين",99,"ن",1,0],["فاربط حزامك فالمغول جيادهم","حبلى المواخض أطرف العربان",100,"ن",1,0],["فاربأ بنفسك يا فتى وارفقْ بها","وبوعيها فالرفقُ خير زميلِ",101,"ل",1,0],["فاربأ بنفسك أن تعيش مقصرا","قد أنفعتك طهارة المنيعم",102,"م",1,0],["فَأربأ بِنَفسِكَ أَن تَنهارَ مِن أَلَمٍ","وَأربأ بِحُسنِكَ أَن يَربَدَّ مِن سَأمِ",103,"م",1,0],["فاربأ بنفسك أن تكون معذبا","وانظر إلى الماضي بعين الساخر",104,"ر",1,0],["فاربحْ قعودكَ تسترحْ","فتكونَ من أهل الظفر",105,"ر",1,0]]}