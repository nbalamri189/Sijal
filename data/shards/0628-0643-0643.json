{"poems":[[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[240,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[823,"","https://poetry.dctabudhabi.ae/diwan/poem/198756","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53102","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65115","الخفيف"],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""]],"verses":[["بِكَ كُنتُ أَدفَعُ كُلَّ عادِيَةٍ","وَأُجيبُ في الجُلّى إِذا أُدعى",0,"ع",2,0],["بك كانت أيام مصر كأعياد","فحالت إلى مآتم بعدك",1,"ك",1,0],["بك كانت امارة الشعر تزهو","مذ تقلدتها بالاستحقاق",2,"ق",1,0],["بِكَ كَفَّ اللَهُ كَفَّ الرَزايا","وَكَفى اللَهُ الأَنامَ القِتالا",3,"ل",2,0],["بِكَ كانَت نُضرَةُ ال","عَيشِ فَواللَت وَاِخضارُه",4,"ر",2,0],["بك كاهن الأصنام يَجحَدُ كفرَه","حيناً يرى أصنامَه تنهان",5,"ن",1,0],["بك كم عبرنا في الحياة صعابها","حتى بلغنا برَّ كل أمانِ",6,"ن",1,0],["بكَ كيف ينجو من حوادث صرفها","مَن لَم يَجد في الأرض عنها مهربا",7,"ب",2,0],["بك كنت أعتد الليالي عدة","وأجير من جور الزمان المعتدي",8,"د",2,0],["بكُ كلُّ الزّمان والعيد يهنا","وبأنجالك السّراة النّجاد",9,"د",1,0],["بك كرم الله الجدود وطهر آل","الآباء إذ ولدوك جيلا جيلا",10,"ل",2,0]]}