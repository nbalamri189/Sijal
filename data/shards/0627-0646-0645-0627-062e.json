{"poems":[[53,"أبق من مالك الممزق","https://www.aldiwan.net/poem65792.html","مجزوء الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[91,"لا يخاف الراعي ذئابا تعاوى","https://www.aldiwan.net/poem44761.html","الخفيف"],[33,"ليت هندا أنجزتنا ما تعد","https://www.aldiwan.net/poem42576.html","الرمل"],[83,"أخذوا موثق العذار على الخد","https://www.aldiwan.net/poem61501.html","الخفيف"],[77,"سقني الخمر بعيني قاتلي","https://www.aldiwan.net/poem69070.html","الرمل"],[132,"عجلة الإنسان لوم","https://www.aldiwan.net/poem50478.html","مجزوء الرمل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[408,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[1289,"","https://poetry.dctabudhabi.ae/diwan/poem/205166","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27909","الرمل"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142900","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66542","الرمل"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142993","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111407","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81300","الخفيف"],[4771,"قُلتُ إذ قِيلَ لي حَبيبكَ يَشكو","https://www.poetsgate.com/ViewPoem.aspx?id=106605",""],[5694,"ياشين قهر الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=129914",""],[5749,"قبل عذري","https://www.poetsgate.com/ViewPoem.aspx?id=170290",""]],"verses":[["إنما خافَ من سما","حِك لا من غوائلكْ",0,"ك",1,0],["انما خشيتي إلا لك في تلك","المحاني الكثيرة التجعيد",1,"د",1,0],["انما خوفه اذا الليل ادجى","من ذئاب تندس بين الخراف",2,"ف",1,0],["إِنَّما خُبِّلَ قَلبي فَاِجتَوى","صَعدَةً في سابِرِيٍّ تَطَّرِد",3,"د",1,0],["إِنَّما خَدُّهُ الحُسامُ فَظُلمٌ","حَملُهُ لِلنِجادِ في كُلِّ حالِ",4,"ل",1,0],["إنما خَطَّ على عارِضِهِ","مثلَ ما في خاتمي قد نُقِشا",5,"ش",2,0],["إنما خيرُ السجيّه","عجلةٌ عند العَطيَّه",6,"ي",2,0],["إنّما خصّصَ الحبيبَ بسرٍّ","لِسِواه ما زالَ عنه الخفاءُ",7,"ا",2,0],["إنّما خولان حِصْنٌ شامخٌ","حَرَمٌ مَن حَلَّ فيه لا يُرامُ",8,"م",1,0],["إنما خيم البلاء علينا","حين أفتى في مصرنا طربال",9,"ل",1,1],["إنما خص بقوم للذي","كان فيهم من ذُكاء ثم عيّ",10,"ي",1,0],["إنما خلني لبؤسي وحيداً","ألعق الجرح في السكون العميق",11,"ق",1,0],["إِنَّما خِدْمَةُ مُوسى جَنَّةٌ","عِنْدَها أَوْطَانُنا قَدْ نُسِيَتْ",12,"ت",1,0],["إنما خده غلالة وردٍ","نفضت صبغها على مقلتيه",13,"ي",2,0],["إِنَّما خَشيَتي منِ ابنَةِ شَيخِ ال","بحرِ أَن تَعتَلي بِمَكرٍ وَتيهِ",14,"ي",2,0],["إن ما خضب تلك الأنملا","دم مشعوف جرى من شعف",15,"ف",1,0],["إِنَّما خَطوها وَثَوب إِلى المَج","د وَما لِلصِبا عَلى الطَفر ساق",16,"ق",1,0],["إنَّما خدُّه غلالةُ وَرْدٍ","نَفَضت صِبغَتَها على مُقْلتيهِ",17,"ي",2,0],["إن ماخذينا زمام النصر بيدينا","ونادى لنا الله بيومٍ يبر الأسقامي",18,"م",2,0],["انما خايف يجيني فلخر لبالي","دركت لغاية وعلا سوم قدري",19,"ي",1,0]]}