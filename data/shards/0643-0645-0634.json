{"poems":[[3,"حسناتي عند الزمان ذنوب","https://www.aldiwan.net/poem130.html",""],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[86,"أخرق الدف لو رأيت شكيبا","https://www.aldiwan.net/poem68871.html","الخفيف"],[93,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[93,"عشيرة الأحرار في مأتم","https://www.aldiwan.net/poem11353.html","السريع"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[4,"المرء يدعو للسلام","https://www.aldiwan.net/poem21285.html","مجزوء الكامل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[70,"يا من لعين أرقت","https://www.aldiwan.net/poem43000.html","المجتث"],[85,"ردت الروح على المضنى معك","https://www.aldiwan.net/poem7134.html","الرمل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"ردت الروح على المضنى معك","https://www.aldiwan.net/poem63657.html","الرمل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[49,"يا ساكن القبر عن قليل","https://www.aldiwan.net/poem63066.html","مجزوء البسيط"],[49,"إيها إليك أخي إيها","https://www.aldiwan.net/poem63196.html","مجزوء الكامل"],[66,"لئن وهى عقد السحاب الثمين","https://www.aldiwan.net/poem40656.html","الرجز"],[97,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[97,"أبي أخي كعبة آمالنا","https://www.aldiwan.net/poem24966.html","السريع"],[80,"إني امرؤ لا ترى لساني","https://www.aldiwan.net/poem31253.html","مخلع البسيط"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[69,"كم شببت لي فتاة","https://www.aldiwan.net/poem28163.html","المجتث"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"أيها الفاضل الذي عزلوه","https://www.aldiwan.net/poem28566.html","الخفيف"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[48,"يا خليلي قد خلعت عذاري","https://www.aldiwan.net/poem63291.html","الخفيف"],[48,"هل عرفت الربع أجلى","https://www.aldiwan.net/poem65035.html","مجزوء الرمل"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[46,"الحظ يقسم عاش بشر ما اشتكى","https://www.aldiwan.net/poem22566.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39650","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147477",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202690","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54322","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"الطبيب يس","https://www.poetsgate.com/ViewPoem.aspx?id=179703",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""]],"verses":[["كَم شُجاعٍ دَنا إِلَيَّ وَنادى","يا لَقَومي أَنا الشُجاعُ المَهيبُ",0,"ب",1,0],["كمْ شدّ منْ عقدٍ وَثيقٍ حُكْمُهُ","في اللهِ أو أفْتى بحلِّ وِثاقِ",1,"ق",1,0],["كمْ شامِخِ الأنْفِ ينْثَني فرَحاً","بالَ عليْهِ زمانُهُ وخَري",2,"ر",2,0],["كَم شَكَوتَ السُهادَ لي يَومَ كُنّا","بِالبَساتينِ نَستَعيدُ الشَبابا",3,"ب",2,0],["كَم شَرِبتَ المُدامَ في حَضرَةِ الشَي","خِ جِهاراً وَكَم سُقيتَ الحَليبا",4,"ب",2,0],["كَمَشْمُولَةٍ مِنْ مُشْتَهَى النَّفْسِ قُطِّرَتْ","يُعَاطِيكَهَا فِي مَجْلِسِ الأُنْسِ نُدْمَانُ",5,"ن",1,0],["كَمْ شَادَ لِلإِحْسَانِ مِنْ مَعْهَدٍ","وَشَادَ لِلْعِرْفَانِ مِنْ مَعْلَمِ",6,"م",1,0],["كم شاعر قد قفا له أثراً","وناقد راح يبتغي زلله",7,"ل",2,0],["كم شاعر يدعي وليس له","من شعره غير منطق الحجله",7,"ل",2,0],["كَم شامِتٍ بِيَ إِن هَلِكتُ","وَقائِلٍ لِلَّهِ دَرُّه",8,"ر",2,0],["كم شدَّ للسعي في أُكرومةٍ لَبَباً","أضحى كريماً به مُسترخِيَ اللَّبَبِ",9,"ب",1,0],["كم شامخٍ باذخ بنعمته","أضَلَّهُ قبليَ المضلّونا",10,"ن",2,0],["كَم شَرِقَت بِدَمعِها","عَينَيَ لَمّا أَشرَقَت",11,"ت",1,0],["كم شكوت البث يا ليل إلى","مطلع البدر عسى أن يُطلِعك",12,"ك",1,0],["كَم شَيَّدَ المُصلِحونَ العامِلونَ بِها","في الشَرقِ وَالغَربِ مُلكاً باذِخَ العِظَمِ",13,"م",1,0],["كَم شَكَوتُ البَينَ بِاللَيلِ إِلى","مَطلَعِ الفَجرِ عَسى أَن يُطلِعَك",14,"ك",1,0],["كَم شاتِمٍ قابَلتَهُ","بِتَرَفُّعِ الأَسَدِ الشَتيمِ",15,"م",1,0],["كَمْ شَرِقَتْ مِنْهُمُ السُّيُوفُ وكَمْ","رُوِّيَتِ الأَرْضُ مِنْ دَمٍ سَرِبِ",16,"ب",1,0],["كم شفيق عصيت فيك ولو لم","يعصني القلب ما عصيت شفيقا",17,"ق",2,0],["كَم شاهِدٍ أَنَّها سَتَفنى","مِن مَنزِلٍ مُقفِرِ مُحيلِ",18,"ل",1,0],["كَم شَهوَةٍ لِفَسادِ دي","نِكَ قَد رَأَيتُكَ تَشتَهيها",19,"ي",3,0],["كَم شاهَدَت عَينايَ مِن أَهلِها","إِظهارَ مَعروفٍ وَإِضمارَ دين",20,"ن",1,0],["كم شُعَبٍ لاحت فلم تختلف","لأيِّها نغدو وأنَّى نسير",21,"ر",1,0],["كم شاعر منطقه خانه","فاغرورقت بالشعر عيناه",22,"ا",2,0],["كم شاتمٍ لي عَفَوْتُ عَنْهُ","مُصَمِّماً في اللّسانِ نَهْوا",23,"و",2,0],["كم شاخصٍ فيه يطيلُ تَعَجّباً","من دوحَةٍ نَبَتتْ من العقيانِ",24,"ن",1,0],["كم شجاعٍ خاض في مهجته","بسنانٍ في الحيازيم رسب",25,"ب",1,0],["كَمْ شببتْ لي فتاةٌ","مِنْ وجهها الصبحُ يُسفرْ",26,"ر",1,1],["كم شجاعٍ لم ينلْ منها غنى","وجبانٍ نالَ غاياتِ الأملْ",27,"ل",1,0],["كمشيبِ الرءوسِ يضحك لمَّا","يبتدي وَهْوَ في الحقيقةِ يبكي",28,"ي",1,0],["كم شادَ منكمْ قوى الدنيا أخٌ فأخٌ","وسادَ فيكم إلى العليا أبٌ فَأبُ",29,"ب",1,0],["كَم شَمَمنا مِن خَدِّهِ الوَردَ غَضّاً","وَمَزَجنا رُضابَهُ بِعُقارِ",30,"ر",1,0],["كَم شَفَينَ العَينَ مِنهُن","نَ رَميقاً وَاِكتِحالا",31,"ل",2,0],["كَمِّشِ الوَأيَ إِذا وَجَّهتَهُ","وَاِلقَ زُوّارَكَ رَوضاً وَنَدا",32,"د",2,0],["كَم شُرنَ مِن أَريٍ يَكونُ مَقيلُهُ","ثَغراً يُشارُ لَهُ وَلَيسَ يُشارُ",33,"ر",1,0],["كم شرَّقا أو غرَّبا في صعود","وارتفعا حتى كأن لن يعود",34,"د",1,0],["كم شهيدٍ فيكِ مهدور الدِّماء","لا تُراعِي أنتِ أمُّ الشُّهداءْ",35,"ا",2,1],["كم شموسٍ عَبرَتْ هذا الفضاء","وألوفٍ من بدورٍ ونجومْ",36,"م",1,0],["كم شفاهٍ بهنّ من قُبلاتي","وهَجُ النّارِ في عواصفَ خُرسِ",37,"س",1,0],["كم شفيت مريضة","من مرض فما اشتفت",38,"ت",1,0],["كم شوه الباطل حين سوّدا","كالنار تعلو بالدّخان أسودا",39,"د",2,0],["كم شكوت البين بالليل الى","الى مطلع الفجر عسى ان يطلعك",40,"ك",1,0],["كَمْ شَادَ مَجْدَاً وَكَمْ أَوْدَى بِمَنْقَبَةٍ","رَفْعاً وَخَفْضَاً بِمَرْجُوٍّ وَمَحْذُورِ",41,"ر",1,0],["كَمْ شَاكِياً أَشْكَتْ مِنَ الْ","أَلَمِ المُبَرِّحِ وَالسُّهَادْ",42,"د",1,0],["كَمْ شَارِداً آوَتْ وَقَدْ","حُرِمَ الحَشِيَّةَ وَالْوِسَادْ",42,"د",1,0],["كَمْ شَهِيداً خَلَّدَ التَّا","رِيخُ فِيهِ وَشَهِيدا",43,"د",2,0],["كم شموس في سما الماضي وكم","من نجوم في سما المستقبل",44,"ل",1,0],["كم شهدناه في شواهد نص","ورأيناه في تعارض رأي",45,"ي",1,0],["كم شدَا شعرِي على دوحتِكُمْ","أيّ شعرٍ غَرِدٍ أيّ غِنَاءْ",46,"ا",2,0],["كم شارِدٍ في مِصْرَ يا كُثْرَه","من عَدَدٍ يَسْخُر مِنْ حَصْرِه",47,"ر",2,0],["كم شاهدتْ قوماً زهتْ أيامُهم","حيناً وجاءت بعدَهم أقوام",48,"م",1,0],["كم شكونا، فزارنا، فاسترحنا","فكأنَّا قبلَ العلاج شُفينا",49,"ن",2,0],["كم شربنا الدَّواءَ وهْو أُجاجٌ","من يديه فكان عذبًا معينا",49,"ن",2,0],["كم شهورٍ مضت عليه طوالاً","طولَ ليل العشَّاقِ عند الجفاء",50,"ا",2,0],["كم شعَّ من أُفْقها علمٌ، ومعرفةٌ","وأنبتَتْ أرضُها خيلاً، وفُرسانا",51,"ن",2,0],["كم شيَّعَ الأدبُ المفجوعُ مُختضَراً","لدى العيونِ وعندَ الصدر مُحتَسَبا",52,"ب",2,0]]}