امل"],[393,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[403,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[403,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[409,"بالغور أهلك يابثين وأهلنا","https://www.aldiwan.net/poem32403.html","الكامل"],[416,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[416,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[416,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[439,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[441,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[453,"قالوا طيور تغالي في محبتها","https://www.aldiwan.net/poem61224.html","البسيط"],[453,"هاتى ثلوجك هاتي","https://www.aldiwan.net/poem61589.html","المجتث"],[453,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[461,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[463,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[464,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[464,"شب نار الأحشاء ماء البكاء","https://www.aldiwan.net/poem3437.html","عموديه"],[468,"ومسمع مستبشع المنظر","https://www.aldiwan.net/poem60076.html","السريع"],[477,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[515,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[515,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[551,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[558,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[562,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[586,"كم شمل صبر هجركم فرقه","https://www.aldiwan.net/poem17625.html","السريع"]],"verses":[["كَم شُجاعٍ دَنا إِلَيَّ وَنادى","يا لَقَومي أَنا الشُجاعُ المَهيبُ",0,"ب",1,0],["كمْ شدّ منْ عقدٍ وَثيقٍ حُكْمُهُ","في اللهِ أو أفْتى بحلِّ وِثاقِ",1,"ق",1,0],["كمْ شامِخِ الأنْفِ ينْثَني فرَحاً","بالَ عليْهِ زمانُهُ وخَري",2,"ر",2,0],["كَم شَكَوتَ السُهادَ لي يَومَ كُنّا","بِالبَساتينِ نَستَعيدُ الشَبابا",3,"ب",2,0],["كَم شَرِبتَ المُدامَ في حَضرَةِ الشَي","خِ جِهاراً وَكَم سُقيتَ الحَليبا",4,"ب",2,0],["كَمَشْمُولَةٍ مِنْ مُشْتَهَى النَّفْسِ قُطِّرَتْ","يُعَاطِيكَهَا فِي مَجْلِسِ الأُنْسِ نُدْمَانُ",5,"ن",1,0],["كَمْ شَادَ لِلإِحْسَانِ مِنْ مَعْهَدٍ","وَشَادَ لِلْعِرْفَانِ مِنْ مَعْلَمِ",6,"م",1,0],["كم شاعر قد قفا له أثراً","وناقد راح يبتغي زلله",7,"ل",2,0],["كم شاعر يدعي وليس له","من شعره غير منطق الحجله",7,"ل",2,0],["كَم شامِتٍ بِيَ إِن هَلِكتُ","وَقائِلٍ لِلَّهِ دَرُّه",8,"ر",2,0],["كم شدَّ للسعي في أُكرومةٍ لَبَباً","أضحى كريماً به مُسترخِيَ اللَّبَبِ",9,"ب",1,0],["كم شامخٍ باذخ بنعمته","أضَلَّهُ قبليَ المضلّونا",10,"ن",2,0],["كَم شَرِقَت بِدَمعِها","عَينَيَ لَمّا أَشرَقَت",11,"ت",1,0],["كم شكوت البث يا ليل إلى","مطلع البدر عسى أن يُطلِعك",12,"ك",1,0],["كَم شَيَّدَ المُصلِحونَ العامِلونَ بِها","في الشَرقِ وَالغَربِ مُلكاً باذِخَ العِظَمِ",13,"م",1,0],["كَم شَكَوتُ البَينَ بِاللَيلِ إِلى","مَطلَعِ الفَجرِ عَسى أَن يُطلِعَك",14,"ك",1,0],["كَم شاتِمٍ قابَلتَهُ","بِتَرَفُّعِ الأَسَدِ الشَتيمِ",15,"م",1,0],["كَمْ شَرِقَتْ مِنْهُمُ السُّيُوفُ وكَمْ","رُوِّيَتِ الأَرْضُ مِنْ دَمٍ سَرِبِ",16,"ب",1,0],["كم شفيق عصيت فيك ولو لم","يعصني القلب ما عصيت شفيقا",17,"ق",2,0],["كَم شاهِدٍ أَنَّها سَتَفنى","مِن مَنزِلٍ مُقفِرِ مُحيلِ",18,"ل",1,0],["كَم شَهوَةٍ لِفَسادِ دي","نِكَ قَد رَأَيتُكَ تَشتَهيها",19,"ي",3,0],["كَم شاهَدَت عَينايَ مِن أَهلِها","إِظهارَ مَعروفٍ وَإِضمارَ دين",20,"ن",1,0],["كم شُعَبٍ لاحت فلم تختلف","لأيِّها نغدو وأنَّى نسير",21,"ر",1,0],["كم شاعر منطقه خانه","فاغرورقت بالشعر عيناه",22,"ا",2,0],["كم شاتمٍ لي عَفَوْتُ عَنْهُ","مُصَمِّماً في اللّسانِ نَهْوا",23,"و",2,0],["كم شاخصٍ فيه يطيلُ تَعَجّباً","من دوحَةٍ نَبَتتْ من العقيانِ",24,"ن",1,0],["كم شجاعٍ خاض في مهجته","بسنانٍ في الحيازيم رسب",25,"ب",1,0],["كَمْ شببتْ لي فتاةٌ","مِنْ وجهها الصبحُ يُسفرْ",26,"ر",1,1],["كم شجاعٍ لم ينلْ منها غنى","وجبانٍ نالَ غاياتِ الأملْ",27,"ل",1,0],["كمشيبِ الرءوسِ يضحك لمَّا","يبتدي وَهْوَ في الحقيقةِ يبكي",28,"ي",1,0],["كم شادَ منكمْ قوى الدنيا أخٌ فأخٌ","وسادَ فيكم إلى العليا أبٌ فَأبُ",29,"ب",1,0],["كَم شَمَمنا مِن خَدِّهِ الوَردَ غَضّاً","وَمَزَجنا رُضابَهُ بِعُقارِ",30,"ر",1,0],["كَم شَفَينَ العَينَ مِنهُن","نَ رَميقاً وَاِكتِحالا",31,"ل",2,0],["كَمِّشِ الوَأيَ إِذا وَجَّهتَهُ","وَاِلقَ زُوّارَكَ رَوضاً وَنَدا",32,"د",2,0],["كَم شُرنَ مِن أَريٍ يَكونُ مَقيلُهُ","ثَغراً يُشارُ لَهُ وَلَيسَ يُشارُ",33,"ر",1,0],["كم شرَّقا أو غرَّبا في صعود","وارتفعا حتى كأن لن يعود",34,"د",1,0],["كم شهيدٍ فيكِ مهدور الدِّماء","لا تُراعِي أنتِ أمُّ الشُّهداءْ",35,"ا",2,1],["كم شموسٍ عَبرَتْ هذا الفضاء","وألوفٍ من بدورٍ ونجومْ",36,"م",1,0],["كم شفاهٍ بهنّ من قُبلاتي","وهَجُ النّارِ في عواصفَ خُرسِ",37,"س",1,0],["كم شفيت مريضة","من مرض فما اشتفت",38,"ت",1,0],["كم شوه الباطل حين سوّدا","كالنار تعلو بالدّخان أسودا",39,"د",2,0],["كم شكوت البين بالليل الى","الى مطلع الفجر عسى ان يطلعك",40,"ك",1,0],["كَمْ شَادَ مَجْدَاً وَكَمْ أَوْدَى بِمَنْقَبَةٍ","رَفْعاً وَخَفْضَاً بِمَرْجُوٍّ وَمَحْذُورِ",41,"ر",1,0],["كَمْ شَاكِياً أَشْكَتْ مِنَ الْ","أَلَمِ المُبَرِّحِ وَالسُّهَادْ",42,"د",1,0],["كَمْ شَارِداً آوَتْ وَقَدْ","حُرِمَ الحَشِيَّةَ وَالْوِسَادْ",42,"د",1,0],["كَمْ شَهِيداً خَلَّدَ التَّا","رِيخُ فِيهِ وَشَهِيدا",43,"د",2,0],["كم شموس في سما الماضي وكم","من نجوم في سما المستقبل",44,"ل",1,0],["كم شهدناه في شواهد نص","ورأيناه في تعارض رأي",45,"ي",1,0],["كم شدَا شعرِي على دوحتِكُمْ","أيّ شعرٍ غَرِدٍ أيّ غِنَاءْ",46,"ا",2,0],["كم شارِدٍ في مِصْرَ يا كُثْرَه","من عَدَدٍ يَسْخُر مِنْ حَصْرِه",47,"ر",2,0],["كم شاهدتْ قوماً زهتْ أيامُهم","حيناً وجاءت بعدَهم أقوام",48,"م",1,0],["كم شكونا، فزارنا، فاسترحنا","فكأنَّا قبلَ العلاج شُفينا",49,"ن",2,0],["كم شربنا الدَّواءَ وهْو أُجاجٌ","من يديه فكان عذبًا معينا",49,"ن",2,0],["كم شهورٍ مضت عليه طوالاً","طولَ ليل العشَّاقِ عند الجفاء",50,"ا",2,0],["كم شعَّ من أُفْقها علمٌ، ومعرفةٌ","وأنبتَتْ أرضُها خيلاً، وفُرسانا",51,"ن",2,0],["كم شوت روحه الضلوع ويوما","لفظ الروح فاطمأنّت ضلوعه",52,"ع",2,0],["كم شاق هذا اللّيل خلّا إلى","خلّ ومطواعا إلى نافر",53,"ر",1,0],["كم شغلنا سوق النفاق فبعنا","واشترينا بضاعة مرذوله",54,"ل",2,0],["كم شيَّعَ الأدبُ المفجوعُ مُختضَراً","لدى العيونِ وعندَ الصدر مُحتَسَبا",55,"ب",2,0],["كَم شَقَقت البُحور بَحراً فَبَحراً","وَهِيَ عِندي تَعدُّ بَعض السَواقي",56,"ي",1,0],["كم شق قلبا بالهدى فجرى به","نور الهدى متفجرا كالماء",57,"ا",2,0],["كم شاعرٍ في قِبابِ الشَّمْسِ هامَتُهُ","وعالِمٍ ثَوْبُهُ الإخلاصُ والزُّهْدُ",58,"د",1,0],["كَم شَرِبنا كم أكلنا","خُبزَنا مُرّاً وَحُلوا",59,"ل",3,0],["كم شربنا بهن حمر التصابي","وجنينا بهن مسرةً ونعيما",60,"م",2,0],["كَم شَاعِرٍ ذَرِبٍ غَادَرتُ في كُرَبٍ","إِذ صَارَ بالهَجوِ القُرحُ مُندَمِلا",61,"ل",2,0],["كم شدة ضاق عنها الذرع وانفرجت","وموقفٍ بعد فرط الضيق يتسعُ",62,"ع",1,1],["كم شرّدوا كم بدّدوا وتعوّدوا","تشتيت كل كتيبةٍ بالصيقل",63,"ل",1,0],["كم شامتٍ حينَ يَلقى مُهجتي قُبضتْ","يقولُ أرغمتِ الأيامُ أنفَ علي",64,"ي",1,1],["كَم شَكَونَا فِرَاقكُم فَدَعَونَا","جَمَعَ اللهُ شَملَنَا عَن قَرِيبِ",65,"ب",1,0],["كم شكونا فرقَكُم فدَعَونا","جمَع اللهُ شَملَنا عَن قريب",66,"ب",1,0],["كم شاد في العلياءِ من شرفٍ","يزداد تجديدا على القِدَم",67,"م",1,0],["كم شهوة سدّت عليّ وجوهها","بين الوني وتخلّف الإقبال",68,"ل",1,0],["كم شربة قد سقي فما نفعت","بل زاد شرب الدواء في كمده",69,"د",2,0],["كَمْ شَاعَ قَبْلَكَ أقوالٌ بِلا عَمَلٍ","حتّى أتَيْتَ فَكانَ القَوْلُ والعَمَلُ",70,"ل",1,0],["كم شهوةٍ مستقرَّة فرحاً","قد انجلت عن حلول آفاتِ",71,"ت",1,1],["كم شهواتٍ سلَبنَ صاحبها","ثوبَ الديانات والمروءاتِ",71,"ت",1,0],["كم شجى هوميرا في الغرب به","وبه في الشرق غص بنتهوا",72,"ه",3,0],["كم شقت من علة طلعتها","في بني الشرق وأحيت من رمم",73,"م",1,0],["كَم شاعِرٍ نَوَّرَت في روحِهِ قُبَلي","فَكُلُّ قُبلَةِ حُبٍّ مِن فَمي قَمَرُ",74,"ر",1,0],["كَم شاعِر خبثَت فيهِ عَرائِسُه","فَراحَ يُملي بِأَنياب وَأَظفارِ",75,"ر",1,0],["كم شَنَّعا عنَّي القبِيحَ وكم","سَلاَّ حُسامينِ مَشْرَفيَّيْنِ",76,"ن",1,0],["كم شموسٍ بعين شمس أُذيلت","لوداع رأى به الحِلْمُ عَجْزه",77,"ز",2,0],["كَم شدَّ مِن حَجرٍ لِمسغبةٍ وَكَم","أَضحى عَلى اللّزباتِ ذا إِدمانِ",78,"ن",1,0],["كم شفى عاهةً بإمداد سرٍّ","ولكم قد أقام من مفلوج",79,"ج",1,0],["كم شاقني مرأى الجمالِ فلم تذُق","في الليلِ عيني لذّةَ الإغماض",80,"ض",1,0],["كم شاقني وتصبّاني وأطربني","إذ كنتِ ورقاءَ في روضٍ تنوحينا",81,"ن",2,0],["كَم شجٍ آلَمَهُ لَومُ الخَلِيِّ","فَأَبى الإِصغاءَ بِالسَمعِ الأَبِيِّ",82,"ي",1,1],["كم شريد خال يالوطاب طريد","ليس يحوي إلا النفاق وطابُه",83,"ب",2,0],["كَم شامتٍ قد كانَ يأمُل أَن يَرى","ربعَ الوداد وقد رآه مَحيلا",84,"ل",2,0],["كَم شَنَّ مِن فتنٍ للصبِّ فاتنةٍ","وَشبَّ حرَّ جوىً في القلب فاترهُ",85,"ر",2,0],["كَم شنَّفت كأَساً بدُرِّ حَبابها","بل كم شفت نفساً بِقُرب حبيبها",86,"ب",3,0],["كم شدةٍ أذهلتني عند سوْرتِها","عَنْ كلِّ ما علقته النفس الاّك",87,"ك",1,0],["كم شدة ضاق منها الصدر والنادى","تخوف القلب منها شرها العادي",88,"ي",1,0],["كم شدة نام الفتى لورودها","ما هب حت أدبرت أيامها",89,"م",3,0],["كَم شاعِرٍ مُفلِقٍ أَو ناثِرٍ أَرِبِ","لَدى السَماعِ لَها قَد هامَ مِن طَرَبِ",90,"ب",1,0],["كم شربناهُ رقّة وحنانا","وأرقناه أدمعاً تتشكّى",91,"ك",2,0],["كَمِشحاجٍ أَضَرَّ بِخانِفاتٍ","ذَوابِلَ مِثلَ أَخلافِ النُسوعِ",92,"ع",1,0],["كَمْ شِدَّةٍ جَاءَ في أَعقابِها فَرَجٌ","عَن فَجْرِهِ انشَق لَيْلُ الحَادِثِ الجَلَلِ",93,"ل",1,1],["كَم شُجون برَّحت بي وجوى","لَيتَ بِالعاذل مِنها بَعض ما بي",94,"ي",1,0],["كَم شَنَعوا وَتَفَوّهوا","وَتَقَوّلوا كَذبا عَلَيّ",95,"ي",1,0],["كَم شَريف تَراهُ في السلم بَدرا","وَتَراهُ في الحَربِ ليثا غَيورا",96,"ر",2,0],["كم شِدَّةٍ آخذةٍ بالنَّفسِ","فَرَّجهَا عنَّا بغيرِ لُبسِ",97,"س",1,0],["كَم شَقيّ قَد اِستَرَق تَقيا","دَولة الجَهل غَصة الأَتقيا