{"poems":[[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[72,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"ليعاقب وسمي جود وليه","https://www.aldiwan.net/poem66723.html","الطويل"],[70,"لا تلمني أو فلمني","https://www.aldiwan.net/poem42453.html","مجزوء الرمل"],[89,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[45,"ذكرتنيك روحة للشمول","https://www.aldiwan.net/poem65597.html","الخفيف"],[45,"قل للوزير الذي وزارته","https://www.aldiwan.net/poem66671.html","المنسرح"],[48,"يا حبذا مجلس قد كان يجمعنا","https://www.aldiwan.net/poem63282.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[202,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[223,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[326,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[362,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[390,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[436,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"]],"verses":[["أن تَزُرِ الشاغور يوماً تجد به","من الحسن ما قد خصّ بالفضل جنسه",0,"س",2,0],["أنت زينتها وكم زينت الأغ","ماد قدماً بالمرهفات المواضي",1,"ض",2,0],["أنت زنتَ القلائد الزُّهْرَ قِدْماً","ضعفَ ما زانتِ القلائدُ جيدَكْ",2,"ك",1,0],["أنت زَهَّدْتَ في الكرامَ فلا أعْ","دمنا الله فيهِمُ تزهيدَكْ",2,"ك",1,0],["أنت زَينٌ لكلِّ مدح وحَلْيٌ","يُتَبَاهَى به ويُزْهَى رويُّهْ",3,"ي",2,0],["إِن تَزُرني فَبِذا الشَر","طِ وَإِلّا لا تَزُرني",4,"ن",2,0],["إن تزِنوا محمدا","بالطود فهو فاضل",5,"ل",1,0],["إِن تَزُرهُ تَجِدهُ أَخلَقَ مِن شَي","بِ الغَواني وَمِن تَعَفّي الطُلولِ",6,"ل",1,0],["أَنتَ زَعيمُ السُلطانِ في الحُكمِ تُم","ضيهِ وَمُختارُهُ وَمُؤتَمَنُه",7,"ن",2,0],["أَنَّت زَماناً كَما أَنَّ المَريضُ وَما","تُشفى فَدافَعَ عَنها الخالِقُ الباري",8,"ي",1,0],["إِنْ تَزُرْ مِنْ مَعَاهِدِ الْفَضْلِ دَاراً","فِي ذُرَاهَا لَهُ الشِّعَارُ المُقَامُ",9,"م",1,0],["إنْ تَزُرْ يا طَيْرُ دَوْحَتَهُ","بَيْنَ زَهْرٍ ناضِرٍ وجَنِي",10,"ن",2,0],["أنت زَيَّنتَها فأظهرتَ فيها","كرماً حين أظهر الناسُ لُوما",11,"م",2,0],["إِن تَزِد فَذو كرمٍ","لِلكِرامِ يَنتَسِبُ",12,"ب",1,0],["أنتِ زيّنتِ لي الخطيئة حتى","كدتُ أرتابُ في عقاب السماء",13,"ا",2,0],["إنْ تَزُرْهُ تَر كفّاً كالحَيا","حين يُمتاحُ ووجْهاً ذا حَياء",14,"ا",2,0],["أَنتَ زوجُ الزَهراءِ حورِيَّةِ الاِن","سِ وَخَيرِ النِساءِ عِندَ اِمتِيازِ",15,"ز",1,0],["إِنْ تَزرَع المعروفَ فهو غَمامَةٌ","أَوْ تَبدَأ النَّعْماءَ فَهوَ مُعيدُها",16,"د",3,0]]}