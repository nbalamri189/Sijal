{"poems":[[90,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[74,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[53,"ليعاقب وسمي جود وليه","https://www.aldiwan.net/poem66723.html","الطويل"],[72,"لا تلمني أو فلمني","https://www.aldiwan.net/poem42453.html","مجزوء الرمل"],[91,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[47,"ذكرتنيك روحة للشمول","https://www.aldiwan.net/poem65597.html","الخفيف"],[47,"قل للوزير الذي وزارته","https://www.aldiwan.net/poem66671.html","المنسرح"],[50,"يا حبذا مجلس قد كان يجمعنا","https://www.aldiwan.net/poem63282.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[208,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[230,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[333,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[369,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[398,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126905","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70791","الخفيف"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216694",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137050",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128263","الرجز"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103457","المديد"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117869","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114503","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103012","الخفيف"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86368","الخفيف"],[4536,"","https://poetry.dctabudhabi.ae/diwan/poem/97713","الخفيف"],[4739,"صوت البعد","https://www.poetsgate.com/ViewPoem.aspx?id=35233",""],[4767,"سيد الساجدين","https://www.poetsgate.com/ViewPoem.aspx?id=198230",""],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[4830,"أنغام الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=200113",""],[5064,"حُطام مقدور بائس","https://www.poetsgate.com/ViewPoem.aspx?id=199131",""],[5183,"سمراء النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185681",""],[5225,"السحابة","https://www.poetsgate.com/ViewPoem.aspx?id=30819",""],[5455,"انت زعلان","https://www.poetsgate.com/ViewPoem.aspx?id=213962",""],[5848,"كأنها الفرقى طلبتك حاجتين","https://www.poetsgate.com/ViewPoem.aspx?id=48893",""],[5977,"إلى فلذة الكبد","https://www.poetsgate.com/ViewPoem.aspx?id=213284",""]],"verses":[["أن تَزُرِ الشاغور يوماً تجد به","من الحسن ما قد خصّ بالفضل جنسه",0,"س",2,0],["أنت زينتها وكم زينت الأغ","ماد قدماً بالمرهفات المواضي",1,"ض",2,0],["أنت زنتَ القلائد الزُّهْرَ قِدْماً","ضعفَ ما زانتِ القلائدُ جيدَكْ",2,"ك",1,0],["أنت زَهَّدْتَ في الكرامَ فلا أعْ","دمنا الله فيهِمُ تزهيدَكْ",2,"ك",1,0],["أنت زَينٌ لكلِّ مدح وحَلْيٌ","يُتَبَاهَى به ويُزْهَى رويُّهْ",3,"ي",2,0],["إِن تَزُرني فَبِذا الشَر","طِ وَإِلّا لا تَزُرني",4,"ن",2,0],["إن تزِنوا محمدا","بالطود فهو فاضل",5,"ل",1,0],["إِن تَزُرهُ تَجِدهُ أَخلَقَ مِن شَي","بِ الغَواني وَمِن تَعَفّي الطُلولِ",6,"ل",1,0],["أَنتَ زَعيمُ السُلطانِ في الحُكمِ تُم","ضيهِ وَمُختارُهُ وَمُؤتَمَنُه",7,"ن",2,0],["أَنَّت زَماناً كَما أَنَّ المَريضُ وَما","تُشفى فَدافَعَ عَنها الخالِقُ الباري",8,"ر",2,0],["إِنْ تَزُرْ مِنْ مَعَاهِدِ الْفَضْلِ دَاراً","فِي ذُرَاهَا لَهُ الشِّعَارُ المُقَامُ",9,"م",1,0],["إنْ تَزُرْ يا طَيْرُ دَوْحَتَهُ","بَيْنَ زَهْرٍ ناضِرٍ وجَنِي",10,"ن",2,0],["إنتزعنا الملك من غاصبه","وكتبنا بالدم الغمر الجلاء",11,"ا",2,0],["أنت زَيَّنتَها فأظهرتَ فيها","كرماً حين أظهر الناسُ لُوما",12,"م",2,0],["إِن تَزِد فَذو كرمٍ","لِلكِرامِ يَنتَسِبُ",13,"ب",1,0],["أنتِ زيّنتِ لي الخطيئة حتى","كدتُ أرتابُ في عقاب السماء",14,"ا",2,0],["إنْ تَزُرْهُ تَر كفّاً كالحَيا","حين يُمتاحُ ووجْهاً ذا حَياء",15,"ا",2,0],["أَنتَ زوجُ الزَهراءِ حورِيَّةِ الاِن","سِ وَخَيرِ النِساءِ عِندَ اِمتِيازِ",16,"ز",1,0],["إِنْ تَزرَع المعروفَ فهو غَمامَةٌ","أَوْ تَبدَأ النَّعْماءَ فَهوَ مُعيدُها",17,"د",3,0],["إن تَزُر مُسلماً فزُر قبر هاني","فجزاء الإحسان بالإحسانِ",18,"ن",1,1],["إنْ تزرْهم ترَ الغزارةَ وال","خيرَ وتلْقَى الإحسانَ والإكراما",19,"م",2,0],["انتزع من عالم الماضي خبر","وانسجه في عالم الحاضر حرير",20,"ر",1,0],["ان تزرنا في الحول يوماً كفانا","ان كل الزمان منك سعيد",21,"د",1,0],["إن تزل عن طوعه السبع الشداد","خر منها كل سامي السمك عال",22,"ل",1,0],["انتَزِع يا صاحِ بازينا","واغدُ نَنفي العُسرَ مِن يُسُرِه",23,"ر",2,1],["ان تزرني اطعمك كل لذيذ","من قواز وكبة محشيه",24,"ي",2,0],["إن تزر ذاته تجد خير ذاتٍ","فوق هام السهى تجر الرداءَ",25,"ا",2,0],["إِنْ تَزِدْهُ نَظَراً زِدْتُ بِهِ","مَا سَبَى اللُّبَّ وَأدْهَى مِنْ عَقَلْ",26,"ل",1,0],["إن تزِد لَحظاً تَزِد ما","لَيسَ تَستوفِيهِ",27,"ه",1,0],["إن تزر ساعة فلسنا نبالي","بافتقاد الأقمار عاما فعاما",28,"م",2,0],["إن تزعُما أنني كبرت فلم","ألف ثقيلا نكسا ولا ورعا",29,"ع",2,0],["إن تزن أرضه عددت ثراه","لسواه من المعاقل سطحا",30,"ح",2,0],["أَنت زوّجتني وَما كنتُ أَدري","وَأَتاني النساءُ للتزيينِ",31,"ن",1,1],["انتزعت الصمت من روح الكلام","وارتضيت البعد صوتي والمصير",32,"ر",1,1],["أنت زينُ العباد حقاً وما الشي","طانُ إلا تطاولٌ واجتراء",33,"ا",2,0],["أنتَ زُرْتَ في المَنامِ صَحيحاً","غَلْغَلَتْ في عِظامِهِ الأَسْقام",34,"م",1,0],["أنتِ زهرٌ عابقٌ في غصنه","فاتنُ الحسنِ فسبحانَ الجليلْ",35,"ل",1,0],["إن تَزلْ يا قلبُ فيه مُحْرَضًا","فأنا منكَ أيا قَلبُ برَاءْ",36,"ا",2,0],["أنت زهر الربيع في بسمة الفج","ر ومسك الختام في الأسحار",37,"ر",1,0],["إنت زايد إنت الأول والمجاب","وانته الحامي إذا خوفٍ بدى",38,"د",2,0],["انت زعلان لجفاي مادريت إن زعلي","يوم قلبك مايبيني قد ماقلبي يبيك",39,"ك",1,0],["أنت زوّدت المفارق حبتين","والا انا .. ودي لو انك ما تروح",40,"ح",1,0],["أنت زرعٌ طالما أسقيته","مني حباً فتنامى وربا",41,"ب",2,0]]}