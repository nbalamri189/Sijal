72517","الرمل"],[4691,"بهجة العيد هويفا عندكم","https://www.poetsgate.com/ViewPoem.aspx?id=59590",""],[4693,"اهداء الى خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=33403",""],[4701,"غزل عذري","https://www.poetsgate.com/ViewPoem.aspx?id=184188",""],[4701,"يَحْكِي لعينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=50541",""],[4755,"عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203643",""],[5026,"فيلسوف القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=210478",""],[3271,"عاهل الريف الثور","https://www.poetsgate.com/ViewPoem.aspx?id=104127",""],[3271,"اللاجئون","https://www.poetsgate.com/ViewPoem.aspx?id=131014",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5111,"مَعَارِيجُ الرُّؤَى","https://www.poetsgate.com/ViewPoem.aspx?id=212631",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[5431,"محض التعقل ما لله قد صعدا","https://www.poetsgate.com/ViewPoem.aspx?id=187678",""],[5431,"في بهو عشقك هذا القلب قد سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=190123",""],[5431,"لم يبقِ دمعا مُحزِنا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198188",""],[5431,"كوب من البن !!...","https://www.poetsgate.com/ViewPoem.aspx?id=203341",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5694,"أسطورة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=129916",""],[5739,"اسطورة الانفاس ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127063",""],[5847,"وردة الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=1228",""],[5943,"أسطورة التخريبِ غنِّي وانشري","https://www.poetsgate.com/ViewPoem.aspx?id=11259",""],[5954,"أسطورتي","https://www.poetsgate.com/ViewPoem.aspx?id=195113",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""],[6198,"عيناكِ أسطورتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79269&r=&rc=43",""],[3984,"الذئاب الحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64417&r=&rc=23",""]],"verses":[["أَسطو بِجَأشِ فَتىً يُفَرِّقُ سَيفُهُ","جَيشَ الحِمامِ إِذا التَقى الجَمعانِ",0,"ن",1,0],["أُسطولُهُم أَمَلٌ في البَحرِ مُرتَحِلٌ","وَجَيشُهُم عَمَلٌ في البَرِّ مُغتَرِبُ",1,"ب",1,0],["أُسطولُنا الحَقُّ الصُراحُ وَجَيشُنا ال","حُجَجُ الفِصاحُ وَحَربُنا التَدليلُ",2,"ل",1,0],["أَسطَرَتهُم مَدافِعُ الروسِ ناراً","أَصبَحوا بَعدَها بِغَيرِ جُلودِ",3,"د",1,0],["أُسطولُ ربّكَ للقتالِ وجيشُه","إن جَدَّ جِدُّ الجيشِ والأسطولِ",4,"ل",1,0],["أَسطُرٌ لابَ حَولَهُنَّ جَهولٌ","فَهوَ يَرجو هَدياً بِأَسطَرلابِ",5,"ب",1,1],["أسْطُولُها يملأُ البحر المحيطَ دَماً","وجيشُهَا يملأُ الآطَامَ تَحصينَا",6,"ن",2,0],["أسطول سلم تقر العينَ رؤيتهُ","لم تندلع منه نحوَ الشطِّ نيران",7,"ن",1,0],["أُسطورة أنت في العصر الحديث، غدًا","تروي أحاديثَها السُّمار والكتب",8,"ب",1,0],["أسطرهم مدافع الروس نارا","أصبحوا بعدها بغير جلود",9,"د",1,0],["أسطو به والشوقُ أعظم سطوةً","مني فينقادُ العظيمُ لأعظم",10,"م",1,0],["أَسطو عليهِ برمحٍ من مَعاطِفِهِ","وَصارمٍ من ظُبى أَجفانِه الوُطُفِ",11,"ف",1,0],["أُسطولهم يا بحر كان رسالةً","للواهمين حروفها بيضاء",12,"ا",2,0],["أُسطولهم يا بحر أصبح مَعلم","حراً تطير بفضله الأنباء",12,"ا",2,0],["أسطو بماضي الشفرتين أحدبٍ","غراره يبتّ أوداج العدى",13,"ا",1,0],["أسطا بلحظٍ أم بأبيضَ صارمٍ","وخطا بقدٍّ أم بأسمرَ ذابل",14,"ل",1,0],["أسطولُ فجرٍ وراءَ الغيبِ مُحْتَجِبٌ","ضاقَتْ بمينائِهِ الأرواحُ والحَدَقُ!",15,"ق",1,0],["أسطورة صاغ الخيال فنونها","لكنها جاءت أحَبُّ وأعجبا",16,"ب",2,0],["أسطورة لم تختلج بفم","ولم تخطر ببال",17,"ل",1,0],["اسطول جون بول مدى بحره","وجيش غليوم مدى بره",18,"ر",2,1],["أَسطارُ دُرٍّ فُصِّلَت بِلآلِئٍ","شِبهُ القَلائِدِ لِلعَقائلِ مُقتَنى",19,"ن",2,0],["أَسْطو عليه وقلبي لو تمكَّن مِنْ","كَفَّيَّ غَلَّهما غَيْظاً إِلى عُنُقي",20,"ي",1,1],["اسطر اسطرا ترى كل سطر","سبعة سبعة بغير التباس",21,"س",1,0],["أسطيعُ وقْدَ النارِ فيك بفرُقتي","لكن أكون هناك صرت رمادا",22,"د",2,0],["أُسْطُورَةٌ عَنْ غُبَارِ الظُّلْمِ نَاشِزَةٌ","تَصُوغُ مِنْ غَلَسِ الأحْزَانِ مَمْلَكَتِيْ",23,"ت",2,0],["اسطع فأنت خيال ربك في الفضا","ومثاله المتألق الوضاح",24,"ح",1,0],["أَسطرُ الحياء به","باللحاظ تكتتب",25,"ب",1,0],["أسطر اثباتها محومتي","أبصرت مرت كلمح البصر",26,"ر",1,0],["أسطر الشعر لقد صيرتها","نغما يتلو أغاني قدميكِ",27,"ك",1,0],["أسطورة شادها عبدا لعزيز لنا","ولمّ جعث شتات غير ملتئم",28,"م",1,0],["أسطورةُ العاشقِ العذريَّ كاذبة","عذرية الحبِّ أنَّ الرُّوحَ عذراءُ",29,"ا",2,0],["أسطورةُ القلبِ أن يأتي الشتاء غدا","في ماطرٍ دافئٍ في صَحو كفَّيكِ",30,"ك",1,0],["أُسطُورَةُ الجَيشِ يا مَن أَسطَرُوهُ لَنا","خُرَافَةٌ مِن خِرَافٍ إِن دَنَا النَّمِرُ",31,"ر",1,0],["أسطورتانِ *لشَهريار* عَليهما","*سَقْراطُ* يرسُمُ خُطْوةً لِيُسافِرْ",32,"ر",1,0],["أسطار مَظْلَمةٍ وآية ذلّةٍ","أعيا فلاسفة الورى ترديدُها",33,"د",3,0],["أسطورةٌ تُخجل النيا حكايتها","بل نقمةٌ في حشا الأحرار تستعرُ",34,"ر",1,0],["أسْطوْرَة ٌصَاغَهَا \"غُسْتِين ُ\"ثَبََّتَهَا","طَوْعًا عَلَى عَتَبَات ِالْفِكْر ِتَعْتَدِلُ",35,"ل",1,0],["أسْطُورَةٌ مِنْ جَوىً تَسْرِيْ لَظَىً بِدَمِيْ","تيهٌ أنَا وَهُنَا قَدْ تَاهَتِ الطُّرُقُ",36,"ق",1,0],["أسطورةُ جيشكِ كاذبةٌ","يا اسرائيل وإيهامُ",37,"م",1,0],["أسطورةٌ نقلَ العَبيرُ رُموزَها","للعَالمينَ فَأدركوا معناها",38,"ا",3,0],["اسطع بدربك إنّ المجد منتظرٌ","كم شاقه الوهن فامضِ اليوم منفردا",39,"د",2,0],["أسطورة بدمي من نزفها قلمي","فاض المداد به واستنزف الجسدا",40,"د",2,0],["أسطورةٌ هي (أننا)","والوهم أنت (بلا أنا )",41,"ن",2,0],["اسطورة تبقى بلا شغفٍ","لو ماالتهمت بلحظة نصفه !!!",42,"ف",2,0],["أسطورة ُالحُلفاء ِ وَلَّتْ مثلما","بادَت ْ قديما ًسيرَة ُ الدُخَلاء",43,"ا",2,0],["أسطورة العصر حطمت الأساطيري","تفوز في مهرجان الزين وسباقه",44,"ق",2,0],["اسطورة الانفاس ..... زين المحيا.","في جوف قلبي ... للقوافي تودد.",45,"د",1,1],["أسطرها مثل الضياء مشاعرا","تصور في نفسي ويرسمها الفكر ُ",46,"ر",1,0],["أسطورة َ التخريبِ غنِّي وانشري","من كلِّ لحنٍ ما يجنُّ بهِ العربْ",47,"ب",1,1],["أسطورتي كتبت من حبر مقبرتي","لن أسمع اللوم طيري يا جناحاتي",48,"ت",2,0],["أسطورةُ الدَّورِ الذي تحيا بهِ","يا قلبُ فاْعقِلْ بَينَ رُشدٍ أو دَدِ",49,"د",1,0],["أُسطورتان... هما عيناكِ... عندهما","كل الأساطير والأحلام.. من عدم",50,"م",1,0],["أسطورة الأسَدِ المهزوم تمهرها","جداولٌ من دمٍ تجتاح (( ردفانا ))",51,"ن",2,0]]}