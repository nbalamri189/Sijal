{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[91,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[46,"أسطر لاب حولهن جهول","https://www.aldiwan.net/poem22361.html","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[91,"سقوط بورت ارثور","https://www.poetsgate.com/ViewPoem.aspx?id=53022",""],[196,"يا برق نجد هل شعرت بمتهم","https://www.aldiwan.net/poem51892.html","الكامل"],[295,"جلا الكؤوس فجلى ظلمة السدف","https://www.aldiwan.net/poem33219.html","البسيط"],[397,"حينما يكون البحر شاهداً","https://www.aldiwan.net/poem6727.html","عموديه"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[462,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[542,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"]],"verses":[["أَسطو بِجَأشِ فَتىً يُفَرِّقُ سَيفُهُ","جَيشَ الحِمامِ إِذا التَقى الجَمعانِ",0,"ن",1,0],["أُسطولُهُم أَمَلٌ في البَحرِ مُرتَحِلٌ","وَجَيشُهُم عَمَلٌ في البَرِّ مُغتَرِبُ",1,"ب",1,0],["أُسطولُنا الحَقُّ الصُراحُ وَجَيشُنا ال","حُجَجُ الفِصاحُ وَحَربُنا التَدليلُ",2,"ل",1,0],["أَسطَرَتهُم مَدافِعُ الروسِ ناراً","أَصبَحوا بَعدَها بِغَيرِ جُلودِ",3,"د",1,0],["أُسطولُ ربّكَ للقتالِ وجيشُه","إن جَدَّ جِدُّ الجيشِ والأسطولِ",4,"ل",1,0],["أَسطُرٌ لابَ حَولَهُنَّ جَهولٌ","فَهوَ يَرجو هَدياً بِأَسطَرلابِ",5,"ب",1,1],["أسْطُولُها يملأُ البحر المحيطَ دَماً","وجيشُهَا يملأُ الآطَامَ تَحصينَا",6,"ن",2,0],["أسطول سلم تقر العينَ رؤيتهُ","لم تندلع منه نحوَ الشطِّ نيران",7,"ن",1,0],["أُسطورة أنت في العصر الحديث، غدًا","تروي أحاديثَها السُّمار والكتب",8,"ب",1,0],["أسطرهم مدافع الروس نارا","أصبحوا بعدها بغير جلود",9,"د",1,0],["أسطو به والشوقُ أعظم سطوةً","مني فينقادُ العظيمُ لأعظم",10,"م",1,0],["أَسطو عليهِ برمحٍ من مَعاطِفِهِ","وَصارمٍ من ظُبى أَجفانِه الوُطُفِ",11,"ف",1,0],["أُسطولهم يا بحر كان رسالةً","للواهمين حروفها بيضاء",12,"ا",2,0],["أُسطولهم يا بحر أصبح مَعلم","حراً تطير بفضله الأنباء",12,"ا",2,0],["أسطو بماضي الشفرتين أحدبٍ","غراره يبتّ أوداج العدى",13,"ا",1,0],["أسطا بلحظٍ أم بأبيضَ صارمٍ","وخطا بقدٍّ أم بأسمرَ ذابل",14,"ل",1,0],["أسطولُ فجرٍ وراءَ الغيبِ مُحْتَجِبٌ","ضاقَتْ بمينائِهِ الأرواحُ والحَدَقُ!",15,"ق",1,0]]}