oem/53102","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53180","المديد"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95203","الطويل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95201","الوافر"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198395","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93702","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123744","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100196","الكامل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138544",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131233",""],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90838","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90995","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/205870","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147312","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4935,"إن باري الخلق غافر","https://www.poetsgate.com/ViewPoem.aspx?id=129274",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[4119,"من لقلب يألف الفكرا","https://www.poetsgate.com/ViewPoem.aspx?id=16151",""],[5186,"لم يبق لي في الساح جولة جائل","https://www.poetsgate.com/ViewPoem.aspx?id=156459",""],[5199,"رابطة عبس العالميه","https://www.poetsgate.com/ViewPoem.aspx?id=150974",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[5376,"فلْتعْلُونَّ وإن، تكنْ فكبيرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204769",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[5977,"ذكريات رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=213257",""],[6038,"العيد الوطني للملكة 1422ه","https://www.poetsgate.com/ViewPoem.aspx?id=25699",""],[6069,"تصغي لتستمع اصطحا","https://www.poetsgate.com/ViewPoem.aspx?id=105672",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6127,"تموز","https://www.poetsgate.com/ViewPoem.aspx?id=198708",""]],"verses":[["وَلِصَوْتِكَ الرَّنَّانِ مَا طَالَ المَدَى","فِي كُلِّ جَانِحَةٍ صَدّى تَحْنَانِ",0,"ن",1,0],["ولَصمتُهُ عن ذكرها أولى به","من عدِّها في الفخر عند فخارِ",1,"ر",1,0],["ولِصَوْبِ السهامِ حوْليكَ وَبْلٌ","لاخضرار الحياةِ مِنهُ ذُبولُ",2,"ل",1,0],["ولَصَرَّتْ حَلَقٌ ماذيَّةٌ","وقناً ذُبلٌ وأسيْافٌ تَقِد",3,"د",1,0],["ولصاح القضاه ما اسمي وعمري ؟","من ورائي ؟ ما أصل أصلي وفرعي ؟",4,"ع",2,0],["ولصوصا كأنّهم قوم \" يا جوج \"","صغار النهى كبار العمائم",5,"م",1,0],["ولصوتك الحاني بأجفان الربا","غزل وفي قلب الربيع غرام",6,"م",1,0],["ولِصبِّكِ الولهانِ طابَ تأمُّلٌ","وعلى التأمُّلِ يَعذُبُ التأميل",7,"ل",1,0],["ولصورتي سور المحا","سن فأقتريها واستمل",8,"ل",1,0],["ولصالح النيات كن متحرياً","مستكثراً منها وراقب وأخشع",9,"ع",1,0],["ولِصاحِبِ البَيتِ المُني","فِ عَلَى العُلى خُلقٌ منيفُ",10,"ف",1,0],["ولصَوبِ غَيثٍ ما عَلِمتُ أجادَني","بكرُ السحابِ بوَبلِه أم عيسى",11,"س",2,0],["ولصوص فاحترس منهم فهم","يلبسون الميت أثواب الكفن",12,"ن",1,0],["ولصدر معتدل الكعوب حطمته","في صدر كبش كتيبة قمقام",13,"م",1,0],["ولصوتِ داعٍ بالصَّرِيخِ مُثَوِّبٍ","ولِفَكِّ عانٍ بالخطوبِ مُقيَّدِ",14,"د",1,0],["ولِصوتِ الحَلْي في تَخطارهِ","صوتُ أفراخِ القطا لما انثنى",15,"ن",2,0],["ولصدغه في خده","حرف تنوق كاتبه",16,"ب",2,0],["وَلصّان في جَحش صَغير تَشاجراً","فَذَلِكَ كَم شاهَدته في بَني الفِلحِ",17,"ح",1,0],["ولصوت مبكايي استجاب وقد رثى","لي قابلاً مني صلاتي والطلبْ",18,"ب",1,0],["وَلصحبه وَلمن يدين بحبه","وَمهاجري الأَوطان وَالأَنصار",19,"ر",1,0],["ولصبري فقدت من فرط كتمي","ما على فاقد التصبر عتب",20,"ب",1,0],["ولصممت منها حفائظ معشر","صبر على التوقاف والتبراك",21,"ك",1,0],["ولصّ يصان وحرّ يدان","وصحف ٌ تعطّل في العاصمه",22,"م",2,0],["وَلِصَفوِ الماءِ أَقذا","ءٌ وَلِلخَمرِ خُمارُ",23,"ر",1,0],["ولصمته أحرى به","ولو أن منطقه يزينه",24,"ه",1,0],["ولصوص أوصياء نصبوا","لشعوب حسبوهم قاصرين",25,"ن",1,0],["ولصد وجه الحرب عنك ولم يطق","قصداً إليك من القنا المتقصد",26,"د",1,0],["ولصُدغ فيه حيث به","مرسلاً في فترة المقل",27,"ل",1,0],["ولِصٍّ غَدَا للقلبِ منّي سارقاً","ويحلف لي لا خانني ويَمينُ",28,"ن",1,1],["ولصّ سَارق من بعد نَهبٍ","لبَيتِ القلبِ من جفنِ منامي",29,"ي",1,1],["ولصِالِحِ المجمُوعِ كّرَّسَ ((زايدٌ))","أعمَالَهُ في همَّة وسدادِ",30,"د",1,0],["وَلَصبرُ أَيوب الَّذي ادَّرَعوا بِهِ","مِن نَسج داودٍ أَشَدُّ وَأَحكَم",31,"م",1,0],["وَلصوته زجل الرعود تَطير بِا","لالباب دَمدمة لَهُ وَهَدير",32,"ر",1,0],["ولِصَدِّه أهدى الضنى","مُتَحَيِّراً فيه طبيبُه",33,"ب",2,0],["ولصونها أيدي النبوة شيدت","من هيبة الباري المنيع حصون",34,"ن",1,0],["ولصح جسمها السقيم من كل ما","أصابه من عشق الأمور العادية",35,"ه",1,0],["ولصلح شر اميةٍ قد الجأوا","وجفوه ويلهم باعظم جفوة",36,"ه",1,0],["ولصدر كل بنانةٍ مطلولةٍ","من وردها الذ فر الأريج وسام",37,"م",1,0],["ولصحبى والمنشدين مديحى","ولمصغ لهم للقرّاء",38,"ا",2,0],["ولصيته صوت به الدنيا زهت","من غربها حتى بلاد الصين",39,"ن",1,0],["ولصبيتهم في كل بهجة دوحة","صوت رخيم شدوه وغناه",40,"ا",2,0],["ولصيته الصوت الذي","غنى الزمان به وغرد",41,"د",1,0],["ولصحّةِ الإنسان وجّه همّهُ","تقوى العقولُ بصحّةِ الأجسامِ",42,"م",1,0],["ولصعبة في فهمها إن صعبت","تتفاوت الأفهام والأسباب",43,"ب",1,0],["ولِصمّ الصلاد أقسى فؤاداً","شقتها ألينُ الوجود الماءُ",44,"ا",2,0],["ولصحبي يا ألهي","جد وكن خير موازر",45,"ر",1,0],["ولصَمْتِهِ لُغَةٌ تُغَرِّبُ فَهْمَها","أُذنُ العذابِ وتَفقهُ الأجفانُ",46,"ن",1,0],["ولصب بالغرام قضى","ما قضى من وصلكم وطرا",47,"ر",2,0],["ولصرح ناديكم سعى نور الهدى","بجمال أسحار ولطف أصائل",48,"ل",1,0],["ولصبيان عبس بدولة الاردن طليقين القبول","اهل الفعول الى لها تاريخ والشاهد شهد",49,"د",1,0],["ولصغت طيبتك التي ما عاقبت","من حاربوك قصائدا للشاني",50,"ن",2,0],["وَلِصَحْبِهِ مَنْ مَاتَ غَيْرَ مُجَانِفٍ","لِسَبيلِهِ أَوْ نَاقِضٍ لِعُهُودِ(٢٤)",51,"د",1,0],["وَلَصيحةٌ في إثرها يعلو السما","نصرٌ وما في عقبها الأعذارُ",52,"ر",1,0],["ولصوت الأذان أصداء شجوٍ","في سماها فدمعها مدرار",53,"ر",1,0],["ولصوصُ أوطاني أقلُّ قساوةً","فالدينُ في أرضي يُخفِّف داءَها",54,"ا",3,0],["ولصوتِ أمي وهي تدعو ربها","بصلاتها كم تطرب الأذنانِ",55,"ن",1,0],["ولصروح العلم شيدت أنت وبنيت","مليكنا الهمام سنة نبينا الكريم نهجاً له",56,"ل",2,0],["ولصيته السامي الصفا","ت بسائر الأمصار سائر",57,"ر",1,0],["وَلِ\"صَالِحٍ\" بِشِعَابِنَا","خَيْلٌ أّغَارَ فَأمْكَنَ",58,"ن",1,0],["وَلَصوتُكَ المحزونُ كانَ مزلْزِلاً","عشتارُ خالتْ جُنْدَها قدْ بُعْثِرا",59,"ر",2,0]]}