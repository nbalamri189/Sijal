{"poems":[[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"]],"verses":[["وَلِصَوْتِكَ الرَّنَّانِ مَا طَالَ المَدَى","فِي كُلِّ جَانِحَةٍ صَدّى تَحْنَانِ",0,"ن",1,0],["ولَصمتُهُ عن ذكرها أولى به","من عدِّها في الفخر عند فخارِ",1,"ر",1,0],["ولِصَوْبِ السهامِ حوْليكَ وَبْلٌ","لاخضرار الحياةِ مِنهُ ذُبولُ",2,"ل",1,0],["ولَصَرَّتْ حَلَقٌ ماذيَّةٌ","وقناً ذُبلٌ وأسيْافٌ تَقِد",3,"د",1,0]]}