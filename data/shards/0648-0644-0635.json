{"poems":[[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[100,"ضائع في المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=50409",""],[100,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[100,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=50149",""],[270,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[281,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[304,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[371,"أوهاني الواهي الضعيف","https://www.aldiwan.net/poem57303.html","مجزوء الخفيف"],[371,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[403,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[409,"أسفي على عصر الشباب تصرمت","https://www.aldiwan.net/poem31640.html","عموديه"],[439,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"]],"verses":[["وَلِصَوْتِكَ الرَّنَّانِ مَا طَالَ المَدَى","فِي كُلِّ جَانِحَةٍ صَدّى تَحْنَانِ",0,"ن",1,0],["ولَصمتُهُ عن ذكرها أولى به","من عدِّها في الفخر عند فخارِ",1,"ر",1,0],["ولِصَوْبِ السهامِ حوْليكَ وَبْلٌ","لاخضرار الحياةِ مِنهُ ذُبولُ",2,"ل",1,0],["ولَصَرَّتْ حَلَقٌ ماذيَّةٌ","وقناً ذُبلٌ وأسيْافٌ تَقِد",3,"د",1,0],["ولصاح القضاه ما اسمي وعمري ؟","من ورائي ؟ ما أصل أصلي وفرعي ؟",4,"ع",2,0],["ولصوصا كأنّهم قوم \" يا جوج \"","صغار النهى كبار العمائم",5,"م",1,0],["ولصوتك الحاني بأجفان الربا","غزل وفي قلب الربيع غرام",6,"م",1,0],["ولِصبِّكِ الولهانِ طابَ تأمُّلٌ","وعلى التأمُّلِ يَعذُبُ التأميل",7,"ل",1,0],["ولصورتي سور المحا","سن فأقتريها واستمل",8,"ل",1,0],["ولصالح النيات كن متحرياً","مستكثراً منها وراقب وأخشع",9,"ع",1,0],["ولِصاحِبِ البَيتِ المُني","فِ عَلَى العُلى خُلقٌ منيفُ",10,"ف",1,0],["ولصَوبِ غَيثٍ ما عَلِمتُ أجادَني","بكرُ السحابِ بوَبلِه أم عيسى",11,"س",2,0],["ولصوص فاحترس منهم فهم","يلبسون الميت أثواب الكفن",12,"ن",1,0],["ولصدر معتدل الكعوب حطمته","في صدر كبش كتيبة قمقام",13,"م",1,0],["ولصوتِ داعٍ بالصَّرِيخِ مُثَوِّبٍ","ولِفَكِّ عانٍ بالخطوبِ مُقيَّدِ",14,"د",1,0]]}