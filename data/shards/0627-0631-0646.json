{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[0,"غشيت ديار الحي بالبكرات","https://www.aldiwan.net/poem55.html","الطويل"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[51,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[51,"ذقت الطعوم فما التذذت كراحة","https://www.aldiwan.net/poem62995.html","الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[70,"هذه أول حاجاتي إليك","https://www.aldiwan.net/poem42386.html","الرمل"],[70,"أرني وجهك بكره","https://www.aldiwan.net/poem42872.html","مجزوء الرمل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[89,"ارنو الى زهر النجوم","https://www.aldiwan.net/poem44675.html","مجزوء الكامل"],[85,"جعلت حلاها وتمثالها","https://www.aldiwan.net/poem62953.html","المتقارب"],[45,"أخذت جعفر برأس القطار","https://www.aldiwan.net/poem64526.html","الخفيف"],[28,"صيداء شأمية حرف كمشترف","https://www.aldiwan.net/poem5496.html","البسيط"],[97,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[97,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[97,"يا قاسي البعد كيف تبتعد","https://www.aldiwan.net/poem24916.html","المنسرح"],[44,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[33,"أقول لأصحابي وقد طلبوا الصلى","https://www.aldiwan.net/poem25912.html","الطويل"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[105,"عام أهاب به الزمان فأقبلا","https://www.aldiwan.net/poem42112.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[102,"ما كنت أرغب أن أسمى قاسيا","https://www.aldiwan.net/poem33111.html","الكامل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[48,"يا رب ثور بمكان قاص","https://www.aldiwan.net/poem64358.html","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39669","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72208","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16628","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42708","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[45,"أخذت جعفر برأس القطار","https://www.poetsgate.com/ViewPoem.aspx?id=31209",""],[51,"ذقتُ الطعوم فما التذذت كراحة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29081",""],[130,"لاحت قصور الخيال","https://www.aldiwan.net/poem67457.html","المجتث"],[136,"حتام تأسى والحمام محتم","https://www.aldiwan.net/poem49156.html","الكامل"],[143,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[179,"حريرة","https://www.aldiwan.net/poem50703.html","الكامل"],[179,"اني اتيتك لاجئا","https://www.aldiwan.net/poem50715.html","الكامل"],[196,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[196,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[212,"وجه جميل بلا وحي أطوف به","https://www.aldiwan.net/poem46303.html","البسيط"],[212,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[227,"الحياة الغالية","https://www.aldiwan.net/poem24234.html","عموديه"],[260,"ربنا إننا لهجنا بذكرك","https://www.aldiwan.net/poem35973.html","الخفيف"],[271,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[343,"أخي فداك الروح يا حبيبي","https://www.aldiwan.net/poem55321.html","الرجز"],[343,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[343,"انا خيال ارى حالي بلا حال","https://www.aldiwan.net/poem55381.html","البسيط"],[366,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[453,"أرنت الورق وهنا فوق أبراج","https://www.aldiwan.net/poem13683.html","البسيط"],[453,"تألق برق من غريب اللوى جنحا","https://www.aldiwan.net/poem13702.html","الطويل"],[453,"أرن في عذبات الأيك مرنان","https://www.aldiwan.net/poem13930.html","البسيط"],[454,"دور من القدم الغالي مجللة","https://www.aldiwan.net/poem61368.html","البسيط"],[465,"ما لي بألحاظ الظباء يدان","https://www.aldiwan.net/poem3424.html","عموديه"],[530,"صف قلبي من كدورات الذنوب","https://www.aldiwan.net/poem37520.html","الرمل"],[552,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[552,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"]],"verses":[["أَرنو إِلى يَقَقِ المَشيبِ فَلا أَرى","إِلّا قَواضِبَ لِلرِقابِ تُسَلَّلُ",0,"ل",1,0],["أَرَنَّت مِنَ الشَيبِ العَجيبِ الَّذي رَأَت","وَهَل أَنتِ مِني وَيبَ غَيرِكِ أَمثَلُ",1,"ل",1,0],["أَرَنَّ عَلى حُقبٍ حَيالٍ طَروقَةٍ","كَذَودِ الأَجيرِ الأَربَعِ الأَشَراتِ",2,"ت",1,0],["أَرَنَّ عَلَيها قارِباً وَاِنتَحَت لَهُ","طُوالَةُ أَرساغِ اليَدَينِ نُحوصُ",3,"ص",1,0],["أَرَنَّ سَهْمُ الرَّدَى إِرْنَانَ مُنْتَحِبِ","وَسَالَ بِالدَّمْعِ وَجْهُ السَّيْفِ ذِي الشُّطَبِ",4,"ب",1,1],["أرني سواي من الذين صنعتهم","رَجُلاً نسخَت صلاحه بفسادِ",5,"د",1,0],["أرني صديقاً لا ينوء بسقطةٍ","من عيبه في قدر صدر نهار",6,"ر",1,0],["أرني الذي عاشرتَهُ فوجدتهُ","متغاضياً لك عن أقل عثار",6,"ر",1,0],["أرني الغناء على الثناء ومَن يرى","عدلَ السَّنام من الجذورِ فراسِنا",7,"ن",2,0],["أَرِني ما لَم أَزَل أَسمَعُهُ","مِن أَيادٍ رُوِيَت لي عَن يَدَيك",8,"ك",1,0],["أَرِني وَجهَكَ بُكرَه","وَاِشفِني مِنكَ بِنَظرَه",9,"ر",2,1],["أَرنو إلى الأَدواحِ في جبروتها","فأخالُها عَمَدَ السَّماءِ أَمامي",10,"ي",1,0],["أرنو إلى الأُفُقِ الكئيبِ أَمامي","فأَرى المبانيَ في الضَّبابِ كأَنَّها",10,"ه",2,0],["أرْنُو إلى الشَّمْسِ المُضِيئةِ هازِئاً","بالسُّحْبِ والأَمطارِ والأَنواءِ",11,"ا",2,0],["ارنو الى زهر النجو","م فلا يفارقني سروري",12,"ي",1,1],["أَرَنَّ بِغابِرِها العَبقَرِيُّ","وَغَنّى بِمِثلِ البُكا حالَها",13,"ل",3,0],["أَرِنيهِ يَفري السَواعِدَ وَالها","مَ وَيُسقى مِنَ الدِماءِ الجَواري",14,"ر",2,0],["أَرَنَّ وَاِنتَظَرَتهُ أَينَ يَعدِلُها","مُكَدَّحاً بِجَنينٍ غَيرِ مَهشومِ",15,"م",1,0],["أرنو إليكِ وبي خوفُ يساورني","وأَنثَني ولطرفي عنكِ إِغضاءُ",16,"ا",2,0],["أرنو لدمعي بادياً","في وجهِكَ المتهللِ",17,"ل",1,0],["أرنو إلى الناس في جموعهم","أشقتهُمُ الحادثاتُ أم سَعِدوا",18,"د",3,0],["أَرِني حَليفاً لِلصِبا جارى الصِبا","في حَلبَةِ الأَحزانِ لَم يَتَفَطَّرِ",19,"ر",1,0],["أَرَنَّت بِأَعلى الصَوتِ مِنها فَهَيَّجَت","فُؤاداً مُعَنّى بِالمَليحَةِ لَو تَدري",20,"ر",2,0],["أرِنا الوغَى تجلو السُّيوفَ بَواتِراً","والخيلَ جُرْداً والعَجاجَ مُثارا",21,"ر",2,0],["أَرِنا كِتابَكَ أو فَدَعْه مُحجَّباً","إنّا نَراهُ على المغيبِ مُؤمَّلا",22,"ل",2,0],["أرِني يَدَيْكَ أفِيهما لِأُمَيَّةٍ","وِردٌ من الموتِ الذُّعافِ مُثمَّلُ",23,"ل",1,0],["أرنو بلهفة عاشقٍ لم يبقَ من","صبر لديَّ وقد حنوتُ عليها",24,"ي",3,0],["أَرَنَّت رَنيناً يَدلِقُ السَهمَ حَفزُها","إِذا حانَ مِنهُ بِالرَمِيِّ وُقوعُ",25,"ع",1,0],["أَرنَبَةً سَوداءَ كَالعَناصي","بِها يُعاطي وَبِها يُعاصي",26,"ص",2,0],["أرنو إلى الصحراء حيث الرمال","نامت كأنَّ اللفح فيها ظلال",27,"ل",1,0],["أرنو وحيداً للمكانِ الخالي","كأسي وكأسُك فارغانِ حِيالي",28,"ي",1,0],["أرنو إلى الصهباء غامَ شعاعُها","وامتدَّ نحو النفسِ ظلُّ جنابها",28,"ه",2,0],["أرنو إلى وجهكَ الضَّاحي فيشرقُ لي","عن صفحتي مَرِحٍ في الخُلد جذلانِ",29,"ن",1,0],["أَرَنَّ عليها قارِباً وانْتَحَتْ لَهُ","مُبَرَّةُ أرساغِ اليَدَيْنِ زَرُوفُ",30,"ف",1,0],["أرَنّتْ بها من خَشيَةِ الموْتِ رَنّةً","فدَلّ عليها النّاعِباتِ رنينُها",31,"ن",3,0],["أَرْنُو إِلَيْهَا وَهْيَ فِي شَأْنِهَا","كَنَظْرَةِ الْعَانِي إِلَى الْمُطْلَقِ",32,"ق",1,0],["أَرْنُو وَمَرْبَأَتِي بقَايَا هَيْكَلٍ","مِنْ أَعْجَبِ الآثَارِ وَالأَبْلاَدِ",33,"د",1,0],["أَرْنُو إِلى الطُّورِ الأَشَمِّ فَأَجْتَلِي","إيماضَ بَرْقٍ وَاضِحَ الإِيمَاءِ",34,"ا",2,0],["أرنو لها اليومَ والذكرى تُؤرِّقني","كما تنبَّه بعد الْحُلمِ وسنان",35,"ن",1,0],["أَرْنُو إِلى عَهْدٍ لَهُنَّ كأَنمَا","أَرْنُو لِنَجْمٍ في السَّمَاءِ بَعِيدِ",36,"د",1,0],["أرنو إليها إذا مشيْتُ، وإن","جلستُ في مجلس، كشفتُ يدي",37,"د",2,0],["أرنيه يفري السوعد والها","م، ويسقى من الدماء الجواري",38,"ر",2,0],["أرني الي عاشرتَهُ فوجدتهُ","متغاضياً لك عن أقل عثار",39,"ر",1,0],["أرنو بليلٍ كئِيبٍ","وطرفُ جسمي كليل",40,"ل",1,0],["أرِني امرءاً في دهرهِ لا يشتكي","أمراً وينجد في الأمورِ ويتهمُ",41,"م",1,0],["أرِنى مِيتَةً تطيبُ بها النف","سُ وقتلاً يلَذُّ غيرَ الحبِّ",42,"ب",1,0],["أرْنو إلى وَصْلِ الحَبيبِ مُناجِيًا","فالبْوحُ مِنْ نَفَحَاتِهِ يَتَبَرَّكُ",43,"ك",1,0],["أرْنو لمرسى كيْ يُجيرَ سفينتي","فتمورُ أرياحُ السَّواهِكِ لا تَذَرْ",44,"ر",1,0],["أَرِنٌ ما يَزالُ يَلقُطُ زُرّاً","مَعَهُ مِن جُلودِهِنَّ سَحاءُ",45,"ا",2,0],["أَرِنٌ يَعَضُّ بكاذِهِنَّ كَأَنَّهُ","قِدحٌ يَظَلُّ بِهِ المُناضِلُ يَغتَلي",46,"ل",2,0],["أرنو إليه وأستهدى بطلعته","نوراً يبدد ما ألقاه من زمني",47,"ن",2,0],["أرنو إلى نورها حينا فيبهرني","ويفضح السر من مكنون كتماني",48,"ي",1,0],["أرنو إلى الاصباح ثم تمجه","نفسي وأنظر كارهاً للمغربِ !",49,"ب",1,0],["أَرِنا رَبَّنا بِكَ الحَقَّ حَقّاً","عَن تَجَلّي آثارِ أَقدارِ قَدرِك",50,"ك",1,0],["أرنو إليها فأسلو كلّما خَطَرت","ذكرى تلوحُ كنورِ الصّبح في خلدي",51,"د",2,0],["أرنو إلى شخصك لا أراكا","معي فأشتاق إلى مرآكا",52,"ك",2,0],["أرنو اليك لالقى","على شفاك هواء",53,"ا",2,0],["ارنو إليّ فلا الفي سوى شبح","محطم لف في اكفان اسمال",54,"ل",1,0],["أرنو إليها فلا الفي لها أثراً","فاطمئن إلى ليلي واوجالي",54,"ل",2,0],["أَرَنَّ عَشِيَّةً فاستَعجَلَتهُ","قوائمُ كُلُّها رَبِذٌ سَطُوعُ",55,"ع",1,0],["أرنَّت الوُرْقُ وهنا فوق أبراج","ورجَّعت بين إرمال وإهزاج",56,"ج",1,1],["أرنَّ بشجو هاجَ بي كلَّ لوعى","لعهد سفحت الدمع في إِثره سفحا",57,"ح",2,0],["أرنَّ في عَذَباتِ الأيكِ مِرْنانُ","ولاحَ للبرْقِ إِسرارٌ وإِعلانُ",58,"ن",1,1],["أرنو إليها فتعدوني بنظرتها","إلى ترقرق غدران وشطآن",59,"ن",1,0],["أرني له في الحسن ندّاً واحداً","أو مثل فخر الدين في الفرسانِ",60,"ن",1,0],["أَرني ما يَجْذِبُ القلْبَ إلَى","ما هُوَ الأَوْلَى بعلْمي ومشيبي",61,"ب",2,0],["أَرِني العجائبَ يا أباها","فكَبَخْصِ عيني أنْ أراها",62,"ا",3,1],["أرِني فبين جوانحي","ممّا تُرينيهِ لَظاها",62,"ا",3,0],["أرِنِي منهُمُ وخذْ مُهلَةً طو","لَ مدا الدّهرِ واجداً مأمونا",63,"ن",2,0],["أَرِنِي بها صَفْواً بغيرِ تكدُّرٍ","وحلاوةً ما سِيطَ فها العلقمُ",64,"م",1,0]]}