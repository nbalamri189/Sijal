=&rc=37",""],[6361,"ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66810&r=&rc=40",""]],"verses":[["أَرنو إِلى يَقَقِ المَشيبِ فَلا أَرى","إِلّا قَواضِبَ لِلرِقابِ تُسَلَّلُ",0,"ل",1,0],["أَرَنَّت مِنَ الشَيبِ العَجيبِ الَّذي رَأَت","وَهَل أَنتِ مِني وَيبَ غَيرِكِ أَمثَلُ",1,"ل",1,0],["أَرَنَّ عَلى حُقبٍ حَيالٍ طَروقَةٍ","كَذَودِ الأَجيرِ الأَربَعِ الأَشَراتِ",2,"ت",1,0],["أَرَنَّ عَلَيها قارِباً وَاِنتَحَت لَهُ","طُوالَةُ أَرساغِ اليَدَينِ نُحوصُ",3,"ص",1,0],["أَرَنَّ سَهْمُ الرَّدَى إِرْنَانَ مُنْتَحِبِ","وَسَالَ بِالدَّمْعِ وَجْهُ السَّيْفِ ذِي الشُّطَبِ",4,"ب",1,1],["أرني سواي من الذين صنعتهم","رَجُلاً نسخَت صلاحه بفسادِ",5,"د",1,0],["أرني صديقاً لا ينوء بسقطةٍ","من عيبه في قدر صدر نهار",6,"ر",1,0],["أرني الذي عاشرتَهُ فوجدتهُ","متغاضياً لك عن أقل عثار",6,"ر",1,0],["أرني الغناء على الثناء ومَن يرى","عدلَ السَّنام من الجذورِ فراسِنا",7,"ن",2,0],["أَرِني ما لَم أَزَل أَسمَعُهُ","مِن أَيادٍ رُوِيَت لي عَن يَدَيك",8,"ك",1,0],["أَرِني وَجهَكَ بُكرَه","وَاِشفِني مِنكَ بِنَظرَه",9,"ر",2,1],["أَرنو إلى الأَدواحِ في جبروتها","فأخالُها عَمَدَ السَّماءِ أَمامي",10,"ي",1,0],["أرنو إلى الأُفُقِ الكئيبِ أَمامي","فأَرى المبانيَ في الضَّبابِ كأَنَّها",10,"ه",2,0],["أرْنُو إلى الشَّمْسِ المُضِيئةِ هازِئاً","بالسُّحْبِ والأَمطارِ والأَنواءِ",11,"ا",2,0],["ارنو الى زهر النجو","م فلا يفارقني سروري",12,"ي",1,1],["أَرَنَّ بِغابِرِها العَبقَرِيُّ","وَغَنّى بِمِثلِ البُكا حالَها",13,"ل",3,0],["أَرِنيهِ يَفري السَواعِدَ وَالها","مَ وَيُسقى مِنَ الدِماءِ الجَواري",14,"ر",2,0],["أَرَنَّ وَاِنتَظَرَتهُ أَينَ يَعدِلُها","مُكَدَّحاً بِجَنينٍ غَيرِ مَهشومِ",15,"م",1,0],["أرنو إليكِ وبي خوفُ يساورني","وأَنثَني ولطرفي عنكِ إِغضاءُ",16,"ا",2,0],["أرنو لدمعي بادياً","في وجهِكَ المتهللِ",17,"ل",1,0],["أرنو إلى الناس في جموعهم","أشقتهُمُ الحادثاتُ أم سَعِدوا",18,"د",3,0],["أَرِني حَليفاً لِلصِبا جارى الصِبا","في حَلبَةِ الأَحزانِ لَم يَتَفَطَّرِ",19,"ر",1,0],["أَرَنَّت بِأَعلى الصَوتِ مِنها فَهَيَّجَت","فُؤاداً مُعَنّى بِالمَليحَةِ لَو تَدري",20,"ر",2,0],["أرِنا الوغَى تجلو السُّيوفَ بَواتِراً","والخيلَ جُرْداً والعَجاجَ مُثارا",21,"ر",2,0],["أَرِنا كِتابَكَ أو فَدَعْه مُحجَّباً","إنّا نَراهُ على المغيبِ مُؤمَّلا",22,"ل",2,0],["أرِني يَدَيْكَ أفِيهما لِأُمَيَّةٍ","وِردٌ من الموتِ الذُّعافِ مُثمَّلُ",23,"ل",1,0],["أرنو بلهفة عاشقٍ لم يبقَ من","صبر لديَّ وقد حنوتُ عليها",24,"ي",3,0],["أَرَنَّت رَنيناً يَدلِقُ السَهمَ حَفزُها","إِذا حانَ مِنهُ بِالرَمِيِّ وُقوعُ",25,"ع",1,0],["أَرنَبَةً سَوداءَ كَالعَناصي","بِها يُعاطي وَبِها يُعاصي",26,"ص",2,0],["أرنو إلى الصحراء حيث الرمال","نامت كأنَّ اللفح فيها ظلال",27,"ل",1,0],["أرنو وحيداً للمكانِ الخالي","كأسي وكأسُك فارغانِ حِيالي",28,"ي",1,0],["أرنو إلى الصهباء غامَ شعاعُها","وامتدَّ نحو النفسِ ظلُّ جنابها",28,"ه",2,0],["أرنو إلى وجهكَ الضَّاحي فيشرقُ لي","عن صفحتي مَرِحٍ في الخُلد جذلانِ",29,"ن",1,0],["أَرَنَّ عليها قارِباً وانْتَحَتْ لَهُ","مُبَرَّةُ أرساغِ اليَدَيْنِ زَرُوفُ",30,"ف",1,0],["أرَنّتْ بها من خَشيَةِ الموْتِ رَنّةً","فدَلّ عليها النّاعِباتِ رنينُها",31,"ن",3,0],["أَرْنُو إِلَيْهَا وَهْيَ فِي شَأْنِهَا","كَنَظْرَةِ الْعَانِي إِلَى الْمُطْلَقِ",32,"ق",1,0],["أَرْنُو وَمَرْبَأَتِي بقَايَا هَيْكَلٍ","مِنْ أَعْجَبِ الآثَارِ وَالأَبْلاَدِ",33,"د",1,0],["أَرْنُو إِلى الطُّورِ الأَشَمِّ فَأَجْتَلِي","إيماضَ بَرْقٍ وَاضِحَ الإِيمَاءِ",34,"ا",2,0],["أرنو لها اليومَ والذكرى تُؤرِّقني","كما تنبَّه بعد الْحُلمِ وسنان",35,"ن",1,0],["أَرْنُو إِلى عَهْدٍ لَهُنَّ كأَنمَا","أَرْنُو لِنَجْمٍ في السَّمَاءِ بَعِيدِ",36,"د",1,0],["أرنو إليها إذا مشيْتُ، وإن","جلستُ في مجلس، كشفتُ يدي",37,"د",2,0],["أرنيه يفري السوعد والها","م، ويسقى من الدماء الجواري",38,"ر",2,0],["أرني الي عاشرتَهُ فوجدتهُ","متغاضياً لك عن أقل عثار",39,"ر",1,0],["أرنو بليلٍ كئِيبٍ","وطرفُ جسمي كليل",40,"ل",1,0],["أرِني امرءاً في دهرهِ لا يشتكي","أمراً وينجد في الأمورِ ويتهمُ",41,"م",1,0],["أرِنى مِيتَةً تطيبُ بها النف","سُ وقتلاً يلَذُّ غيرَ الحبِّ",42,"ب",1,0],["أرْنو إلى وَصْلِ الحَبيبِ مُناجِيًا","فالبْوحُ مِنْ نَفَحَاتِهِ يَتَبَرَّكُ",43,"ك",1,0],["أرْنو لمرسى كيْ يُجيرَ سفينتي","فتمورُ أرياحُ السَّواهِكِ لا تَذَرْ",44,"ر",1,0],["أَرِنٌ ما يَزالُ يَلقُطُ زُرّاً","مَعَهُ مِن جُلودِهِنَّ سَحاءُ",45,"ا",2,0],["أَرِنٌ يَعَضُّ بكاذِهِنَّ كَأَنَّهُ","قِدحٌ يَظَلُّ بِهِ المُناضِلُ يَغتَلي",46,"ل",2,0],["أرنو إليه وأستهدى بطلعته","نوراً يبدد ما ألقاه من زمني",47,"ن",2,0],["أرنو إلى نورها حينا فيبهرني","ويفضح السر من مكنون كتماني",48,"ي",1,0],["أرنو إلى الاصباح ثم تمجه","نفسي وأنظر كارهاً للمغربِ !",49,"ب",1,0],["أَرِنا رَبَّنا بِكَ الحَقَّ حَقّاً","عَن تَجَلّي آثارِ أَقدارِ قَدرِك",50,"ك",1,0],["أرنو إليها فأسلو كلّما خَطَرت","ذكرى تلوحُ كنورِ الصّبح في خلدي",51,"د",2,0],["أرنو إلى شخصك لا أراكا","معي فأشتاق إلى مرآكا",52,"ك",2,0],["أرنو اليك لالقى","على شفاك هواء",53,"ا",2,0],["ارنو إليّ فلا الفي سوى شبح","محطم لف في اكفان اسمال",54,"ل",1,0],["أرنو إليها فلا الفي لها أثراً","فاطمئن إلى ليلي واوجالي",54,"ل",2,0],["أَرَنَّ عَشِيَّةً فاستَعجَلَتهُ","قوائمُ كُلُّها رَبِذٌ سَطُوعُ",55,"ع",1,0],["أرنَّت الوُرْقُ وهنا فوق أبراج","ورجَّعت بين إرمال وإهزاج",56,"ج",1,1],["أرنَّ بشجو هاجَ بي كلَّ لوعى","لعهد سفحت الدمع في إِثره سفحا",57,"ح",2,0],["أرنَّ في عَذَباتِ الأيكِ مِرْنانُ","ولاحَ للبرْقِ إِسرارٌ وإِعلانُ",58,"ن",1,1],["أرنو إليها فتعدوني بنظرتها","إلى ترقرق غدران وشطآن",59,"ن",1,0],["أرني له في الحسن ندّاً واحداً","أو مثل فخر الدين في الفرسانِ",60,"ن",1,0],["أَرني ما يَجْذِبُ القلْبَ إلَى","ما هُوَ الأَوْلَى بعلْمي ومشيبي",61,"ب",2,0],["أَرِني العجائبَ يا أباها","فكَبَخْصِ عيني أنْ أراها",62,"ا",3,1],["أرِني فبين جوانحي","ممّا تُرينيهِ لَظاها",62,"ا",3,0],["أرِنِي منهُمُ وخذْ مُهلَةً طو","لَ مدا الدّهرِ واجداً مأمونا",63,"ن",2,0],["أَرِنِي بها صَفْواً بغيرِ تكدُّرٍ","وحلاوةً ما سِيطَ فها العلقمُ",64,"م",1,0],["أرنو لأوعِيةِ الكلامِ مسَافِراً","في هَدأتي مُتفرِّداً بدمائي",65,"ا",2,0],["أَرنةُ الحُزنِ أَم ذي رَنَة الطَرَبِ","فَقَد أَهاجَ صَداها القَلب في لجب",66,"ب",1,1],["أرنو إليه كأنني","وكأنما هو في جواري",67,"ر",2,0],["أرنو إلى الآفاق وهي جوامد","ونثور أشجاني لها فتذوب",68,"ب",1,0],["أرنو وجهها شذراً وقد ربضت","من فوق منضدتي الجرداء كالأسد",69,"د",1,1],["أرني العدل فيه يا قائماً بال","قسط والعدل منك ليس بسهل",