{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[0,"غشيت ديار الحي بالبكرات","https://www.aldiwan.net/poem55.html","الطويل"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[51,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[51,"ذقت الطعوم فما التذذت كراحة","https://www.aldiwan.net/poem62995.html","الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[70,"هذه أول حاجاتي إليك","https://www.aldiwan.net/poem42386.html","الرمل"],[70,"أرني وجهك بكره","https://www.aldiwan.net/poem42872.html","مجزوء الرمل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[89,"ارنو الى زهر النجوم","https://www.aldiwan.net/poem44675.html","مجزوء الكامل"],[85,"جعلت حلاها وتمثالها","https://www.aldiwan.net/poem62953.html","المتقارب"],[45,"أخذت جعفر برأس القطار","https://www.aldiwan.net/poem64526.html","الخفيف"],[28,"صيداء شأمية حرف كمشترف","https://www.aldiwan.net/poem5496.html","البسيط"],[97,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[97,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[97,"يا قاسي البعد كيف تبتعد","https://www.aldiwan.net/poem24916.html","المنسرح"],[44,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[33,"أقول لأصحابي وقد طلبوا الصلى","https://www.aldiwan.net/poem25912.html","الطويل"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[105,"عام أهاب به الزمان فأقبلا","https://www.aldiwan.net/poem42112.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[102,"ما كنت أرغب أن أسمى قاسيا","https://www.aldiwan.net/poem33111.html","الكامل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[48,"يا رب ثور بمكان قاص","https://www.aldiwan.net/poem64358.html","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39669","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72208","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16628","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42708","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[45,"أخذت جعفر برأس القطار","https://www.poetsgate.com/ViewPoem.aspx?id=31209",""],[51,"ذقتُ الطعوم فما التذذت كراحة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29081",""]],"verses":[["أَرنو إِلى يَقَقِ المَشيبِ فَلا أَرى","إِلّا قَواضِبَ لِلرِقابِ تُسَلَّلُ",0,"ل",1,0],["أَرَنَّت مِنَ الشَيبِ العَجيبِ الَّذي رَأَت","وَهَل أَنتِ مِني وَيبَ غَيرِكِ أَمثَلُ",1,"ل",1,0],["أَرَنَّ عَلى حُقبٍ حَيالٍ طَروقَةٍ","كَذَودِ الأَجيرِ الأَربَعِ الأَشَراتِ",2,"ت",1,0],["أَرَنَّ عَلَيها قارِباً وَاِنتَحَت لَهُ","طُوالَةُ أَرساغِ اليَدَينِ نُحوصُ",3,"ص",1,0],["أَرَنَّ سَهْمُ الرَّدَى إِرْنَانَ مُنْتَحِبِ","وَسَالَ بِالدَّمْعِ وَجْهُ السَّيْفِ ذِي الشُّطَبِ",4,"ب",1,1],["أرني سواي من الذين صنعتهم","رَجُلاً نسخَت صلاحه بفسادِ",5,"د",1,0],["أرني صديقاً لا ينوء بسقطةٍ","من عيبه في قدر صدر نهار",6,"ر",1,0],["أرني الذي عاشرتَهُ فوجدتهُ","متغاضياً لك عن أقل عثار",6,"ر",1,0],["أرني الغناء على الثناء ومَن يرى","عدلَ السَّنام من الجذورِ فراسِنا",7,"ن",2,0],["أَرِني ما لَم أَزَل أَسمَعُهُ","مِن أَيادٍ رُوِيَت لي عَن يَدَيك",8,"ك",1,0],["أَرِني وَجهَكَ بُكرَه","وَاِشفِني مِنكَ بِنَظرَه",9,"ر",2,1],["أَرنو إلى الأَدواحِ في جبروتها","فأخالُها عَمَدَ السَّماءِ أَمامي",10,"ي",1,0],["أرنو إلى الأُفُقِ الكئيبِ أَمامي","فأَرى المبانيَ في الضَّبابِ كأَنَّها",10,"ه",2,0],["أرْنُو إلى الشَّمْسِ المُضِيئةِ هازِئاً","بالسُّحْبِ والأَمطارِ والأَنواءِ",11,"ا",2,0],["ارنو الى زهر النجو","م فلا يفارقني سروري",12,"ي",1,1],["أَرَنَّ بِغابِرِها العَبقَرِيُّ","وَغَنّى بِمِثلِ البُكا حالَها",13,"ل",3,0],["أَرِنيهِ يَفري السَواعِدَ وَالها","مَ وَيُسقى مِنَ الدِماءِ الجَواري",14,"ر",2,0],["أَرَنَّ وَاِنتَظَرَتهُ أَينَ يَعدِلُها","مُكَدَّحاً بِجَنينٍ غَيرِ مَهشومِ",15,"م",1,0],["أرنو إليكِ وبي خوفُ يساورني","وأَنثَني ولطرفي عنكِ إِغضاءُ",16,"ا",2,0],["أرنو لدمعي بادياً","في وجهِكَ المتهللِ",17,"ل",1,0],["أرنو إلى الناس في جموعهم","أشقتهُمُ الحادثاتُ أم سَعِدوا",18,"د",3,0],["أَرِني حَليفاً لِلصِبا جارى الصِبا","في حَلبَةِ الأَحزانِ لَم يَتَفَطَّرِ",19,"ر",1,0],["أَرَنَّت بِأَعلى الصَوتِ مِنها فَهَيَّجَت","فُؤاداً مُعَنّى بِالمَليحَةِ لَو تَدري",20,"ي",1,0],["أرِنا الوغَى تجلو السُّيوفَ بَواتِراً","والخيلَ جُرْداً والعَجاجَ مُثارا",21,"ر",2,0],["أَرِنا كِتابَكَ أو فَدَعْه مُحجَّباً","إنّا نَراهُ على المغيبِ مُؤمَّلا",22,"ل",2,0],["أرِني يَدَيْكَ أفِيهما لِأُمَيَّةٍ","وِردٌ من الموتِ الذُّعافِ مُثمَّلُ",23,"ل",1,0],["أرنو بلهفة عاشقٍ لم يبقَ من","صبر لديَّ وقد حنوتُ عليها",24,"ي",3,0],["أَرَنَّت رَنيناً يَدلِقُ السَهمَ حَفزُها","إِذا حانَ مِنهُ بِالرَمِيِّ وُقوعُ",25,"ع",1,0],["أَرنَبَةً سَوداءَ كَالعَناصي","بِها يُعاطي وَبِها يُعاصي",26,"ص",2,0],["أرنو إلى الصحراء حيث الرمال","نامت كأنَّ اللفح فيها ظلال",27,"ل",1,0],["أرنو وحيداً للمكانِ الخالي","كأسي وكأسُك فارغانِ حِيالي",28,"ي",1,0],["أرنو إلى الصهباء غامَ شعاعُها","وامتدَّ نحو النفسِ ظلُّ جنابها",28,"ه",2,0],["أرنو إلى وجهكَ الضَّاحي فيشرقُ لي","عن صفحتي مَرِحٍ في الخُلد جذلانِ",29,"ن",1,0],["أَرَنَّ عليها قارِباً وانْتَحَتْ لَهُ","مُبَرَّةُ أرساغِ اليَدَيْنِ زَرُوفُ",30,"ف",1,0],["أرَنّتْ بها من خَشيَةِ الموْتِ رَنّةً","فدَلّ عليها النّاعِباتِ رنينُها",31,"ن",3,0],["أَرْنُو إِلَيْهَا وَهْيَ فِي شَأْنِهَا","كَنَظْرَةِ الْعَانِي إِلَى الْمُطْلَقِ",32,"ق",1,0],["أَرْنُو وَمَرْبَأَتِي بقَايَا هَيْكَلٍ","مِنْ أَعْجَبِ الآثَارِ وَالأَبْلاَدِ",33,"د",1,0],["أَرْنُو إِلى الطُّورِ الأَشَمِّ فَأَجْتَلِي","إيماضَ بَرْقٍ وَاضِحَ الإِيمَاءِ",34,"ا",2,0],["أرنو لها اليومَ والذكرى تُؤرِّقني","كما تنبَّه بعد الْحُلمِ وسنان",35,"ن",1,0],["أَرْنُو إِلى عَهْدٍ لَهُنَّ كأَنمَا","أَرْنُو لِنَجْمٍ في السَّمَاءِ بَعِيدِ",36,"د",1,0],["أرنو إليها إذا مشيْتُ، وإن","جلستُ في مجلس، كشفتُ يدي",37,"د",2,0],["أرنيه يفري السوعد والها","م، ويسقى من الدماء الجواري",38,"ر",2,0],["أرني الي عاشرتَهُ فوجدتهُ","متغاضياً لك عن أقل عثار",39,"ر",1,0]]}