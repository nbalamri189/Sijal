{"poems":[[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[47,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[30,"نمتك قروم أولاد المعلى","https://www.aldiwan.net/poem5619.html","الوافر"],[412,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[422,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[580,"تظنني قد بت محموما","https://www.aldiwan.net/poem2803.html","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79999","السريع"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102114","المجتث"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100305","الرمل"],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""]],"verses":[["تخمَّطها بالبيض والسُّمر عُنوةً","أبو الطَّيب الليثُ الهِزبر الخُنابس",0,"س",1,0],["تَخَمَّطَ فَحلَ الحَربِ حَتّى تَواضَعَت","لَهُ وَاِعتَلاها ذا مَشيبٍ وَأَمرَدا",1,"د",2,0],["تَخَمُّطَ تَغلِبَ الغَلباءِ أَلقَت","عَلى الثَرثارِ بَركاً وَالرَحوبِ",2,"ب",1,0],["تَخَمَّطُ في رَبيعَةَ بَينَ بَكرٍ","وَعَبدِ القَيسِ في الحَسَبِ اللُهامِ",3,"م",1,0],["تخمد الحَرب حين تَغمِد بأساً","وَتُسيل الدِماء حينَ تَسُلُّ",4,"ل",1,0],["تخمد النَّارُ وما لي أرى","للجوى من مهجة الصّبّ خمودا",5,"د",2,0],["تَخْمُدُ أُولَى الليل نيرانُكُمُ","والشمسُ مع نيرانه كلا ولا",6,"ل",2,0],["تخِمتُ من جُوعٍ وإِنِّي كما","تعرِفُني مَا زِلْتُ مَنْهُوما",7,"م",2,0],["تخمد شهبُ الأُفق لكن به","مواقدُ النيران لا تخمد",8,"د",1,0],["تَخمُر تَكُن لي طينه","ألا يا أحمد",9,"د",1,0],["تخمش الأوجه بالعشر وتدعو","بحنين يسكت الهيم العشارا",10,"ر",2,0],["تخمة الدهر والطبيب بعيد","يا لشعري وما الطبيب سواه",11,"ا",2,0]]}