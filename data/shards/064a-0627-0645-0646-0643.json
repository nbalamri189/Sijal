{"poems":[[74,"ودعت بابك لا وداع القالي","https://www.aldiwan.net/poem19532.html","الكامل"],[53,"تأمل العيب عيب","https://www.aldiwan.net/poem8304.html","المجتث"],[53,"أقول إذ هتف الداعي بمصرعه","https://www.aldiwan.net/poem66399.html","البسيط"],[72,"دعوا الوشاة وما قالوا وما نقلوا","https://www.aldiwan.net/poem42743.html","البسيط"],[72,"يا من كلفت به عشقا ولم أره","https://www.aldiwan.net/poem42878.html","البسيط"],[47,"أبقاك ربك في عز وتأييد","https://www.aldiwan.net/poem63547.html","البسيط"],[159,"يا منكرا شكواي نار الهوى","https://www.aldiwan.net/poem55786.html","السريع"],[214,"يا من كتمت هواه خوف فراقه","https://www.aldiwan.net/poem13508.html","الكامل"],[240,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[240,"قم قبل إسفار الصباح","https://www.aldiwan.net/poem32117.html","مجزوء الكامل"],[264,"يا منكرين على من","https://www.aldiwan.net/poem35547.html","المجتث"],[276,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[354,"يا من كلفت بحبه إذ كان عن","https://www.aldiwan.net/poem15779.html","الكامل"],[385,"برق بدا جنح الدجى يتألق","https://www.aldiwan.net/poem48835.html","الكامل"],[408,"يا منكرا فضل بني أحمد","https://www.aldiwan.net/poem46505.html","السريع"],[549,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[563,"يا منكرين لكم في ناركم كيات","https://www.aldiwan.net/poem34730.html","المواليا"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112431","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110734","الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123700","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119967","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59114","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202119","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46507","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79496","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77913","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118376","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110315","الكامل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126361","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77421","الرجز"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113675","المجتث"],[3327,"","https://poetry.dctabudhabi.ae/diwan/poem/144510","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139895","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86271","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138484",""],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178026","المنسرح"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36066","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54438","المنسرح"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45008","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94590","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94723","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141687","الكامل"],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[4755,"كذبة إبريل","https://www.poetsgate.com/ViewPoem.aspx?id=197484",""],[4955,"لو أنَّ حزني قد تجسد خلته","https://www.poetsgate.com/ViewPoem.aspx?id=188756",""],[5011,"قمري البان","https://www.poetsgate.com/ViewPoem.aspx?id=197870",""],[5081,"دُعَاءُ مُضْطَّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187761",""],[5206,"في علم الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187418",""],[5277,"لست الحطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=190909",""],[5277,"لصُّ الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=191010",""],[5277,"حكايةٌ بغدادية..","https://www.poetsgate.com/ViewPoem.aspx?id=202411",""],[5283,"بدر على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=207946",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5431,"شهوة الموت...","https://www.poetsgate.com/ViewPoem.aspx?id=204950",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[1117,"تاج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=19415",""],[5725,"ونعيم ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=194801",""],[5751,"عشرون يوما","https://www.poetsgate.com/ViewPoem.aspx?id=215009",""],[5785,"قيلوا بنا تحت الظلال الظليل","https://www.poetsgate.com/ViewPoem.aspx?id=131567",""],[5943,"رثاء الشاعرة النيلية عبلة محمد زقزوق","https://www.poetsgate.com/ViewPoem.aspx?id=56464",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5992,"يا مَنْ كَغُرَّتِه الهلالُ أما ترى","https://www.poetsgate.com/ViewPoem.aspx?id=41840",""],[6031,"يا مُنْكِراً هَدْمَ الحُصُونِ إذَا اعْتَصَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46352",""],[6068,"في القلب من ذكر الرسول سعادة -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175852",""],[6068,"طمع الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177484",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""]],"verses":[["يا من كبار بنيّ شاموا فضله","فتطفلوا أن بلّغت أطفالي",0,"ل",2,0],["يا منكر المجدِ فيهم","أليس منهم صهيبُ",1,"ب",1,0],["يا مُنكراً ونكيراً أوجِعاهُ فَقَدْ","خَلَوْتُما بقليلِ الخير ملْعون",2,"ن",1,0],["يا مَن كَلامي لَهُ إِن كانَ يَسمَعُهُ","يَجِد كَلاماً عَلى ما شاءَ يَشتَمِلُ",3,"ل",1,0],["يا مَن كَلِفتُ بِهِ عِشقاً وَلَم أَرَهُ","وَالعِشقُ لِلقَلبِ لَيسَ العِشقُ لِلبَصَر",4,"ر",1,1],["يا مَن كَساهُ إِلَهي ثَوبَ مَكرُمَةٍ","وَمَن حَباهُ بِتَطهيرِ المَواليدِ",5,"د",1,0],["يا مُنكِراً شَكوايَ نارَ الهَوى","قد زدتَني كرباً عَلى كَرْبي",6,"ب",2,1],["يا من كتمت هواه خوف فراقه","جسمي به أودى السقام فراقه",7,"ق",2,1],["يا مَن كَفاني رَيبَ دَهري أَنَّني","أَمسَيتُ بَينَ الناسِ مِن شُعَرائِهِ",8,"ا",3,0],["يا مَن كَفاني أَن أَمُدَّ","يَداً إِلى الأَيدي الشِحاحِ",9,"ح",1,0],["يا منكرين على من","لربّهم ذاكرينا",10,"ن",2,1],["يا منكر البعث هَذا","ما كنت منه نجيد",11,"د",1,0],["يا مَن كَلِفتُ بِحُبِّهِ إِذ كانَ عَن","عَينِ المَلاحِظِ بِالحَيا مُتَبَرقِعا",12,"ع",2,1],["يا مَن كَرهت العَيش بَعد فِراقِهِ","قَد كُنت مِن هَذا التَفَرُق أَفرقُ",13,"ق",1,0],["يا مُنكراً فَضْلَ بني أحمدٍ","كُنْ لِلَّذي تَسْمعُه مُنْصِتا",14,"ت",2,1],["يا منكرَ الذاتِ حتَّى آثَرَتْ أَرَقاً","كي يستريحَ عبيدٌ شَفَّهُمْ أَرَقُ",15,"ق",1,0],["يا منكرين لكم في ناركم كيّاتْ","نياتكم جعلت أعمالكم حياتْ",16,"ت",1,1],["يا من كشفت الكرب عن أوطاننا","أوقدت فينا جذوة الأحزان",17,"ن",1,0],["يا مَن كَساه اللَه حلةَ هَيبةٍ","خضعت لَها في الخافقين ضَراغم",18,"م",1,0],["يا من كواكب رشده","تهدى المضل إلى الرشد",19,"د",1,0],["يا منكراً حركاتنا في حب من","أفديه من بين الأنام بروحي",20,"ح",2,1],["يا من كان عليه حتما واجبا","تخجيل كعب في السماح وحاتمِ",21,"م",1,0],["يَا مُنْكِراً دعوَى خلاَفته ارْتَجِعْ","فَلَقَدْ أتيتَ الزُّورَ وَالبُهْتَانَا",22,"ن",2,0],["يا من كفى في الفلك نو","حا إذ طمى الما واستبد",23,"د",1,0],["يا من كفى اسماعيل من","ذبح بذبح مستعد",23,"د",1,0],["يا من كفى ذا النون","من موت لجثته ازدرد",23,"د",1,0],["يا منْ كَسَى التاجَ الجَمَالَ وطالما","قد كان زَيْن مَفَارِقٍ وَجِبَاهِ",24,"ه",1,0],["يأمن كُل خائف في دارِه","غَير الصَّفا وَالكَوم مِن عشاره",25,"ه",1,0],["يا منْ كساهُ اللهُ أرديةَ العُلى","وحباهُ عطرَ ثنائِها المتضوعِ",26,"ع",1,1],["يا منكراً حركات كلها كرم","إِنَّ الأَكارمِ لا تَنهى عَن الكرم",27,"م",1,0],["يا منكرا جمعنا حرفا على حرف","لتتئد لا تكن للمرتمى هدفا",28,"ف",2,1],["يا من كتائبه المكا","رم والفضائل والصنائع",29,"ع",1,0],["يا من كلفت به فعذب مهجتي","رفقاً على كلف الفؤاد معذب",30,"ب",1,1],["يا مَن كَساني رَحمَةً عِزّاً","لا تَكسُني مِن ذِلَّةٍ عَدلا",31,"ل",2,1],["يا من كوى ألف قلبٍ","سامح من النار قلبا",32,"ب",2,0],["يا من كحلت بحسن صورته","عيني وكانت تشتكي الرمدا",33,"د",2,1],["يا منكر الأشواق لست بعاشق","ما يعرف الأشواق إلا العاشق",34,"ق",1,0],["يا منكِراً بِغرور جَهلٍ فَضلُهُ","إِذ لَم يَكُ الاحرى بِافضال فَمن",35,"ن",1,0],["يا منكراً ولاية المرتضى","لا كنت يوم الحشر من حزبه",36,"ب",2,1],["يا من كنيا عن اسمه زمناً","نتبع مرضاته ويجترم",37,"م",1,0],["يا مَن كَلِفتُ بِحُبِّهِ","كَلَفي بِكاساتِ العُقار",38,"ر",1,1],["يا منكراً من هوىً بُليتُ بهِ","علاقةً ما يكادُ يَعْرِفُها",39,"ف",3,0],["يا مَن كَساهُ اللَهُ فَضلاً قَصّرَت","عَنهُ يَدُ السَراجِ وَالحَلّاجِ",40,"ج",1,0],["يا منكراً شمس الضحاءِ طلوعها","أعميت لحظاً أم تكلَّفتَ أفترا",41,"ر",2,0],["يا منكراً حسن الكرامة حُسنهُ","أعميتَ عقلاً أم ألمَّ بك الوسنَ",42,"ن",1,1],["يا منكراً لحقيقة الغول اعتقدْ","إنَّ النوى هي في الحقيقة غول",43,"ل",1,0],["يا مَن كَبِرْتَ على خُنُوعِكَ.. مَن تُرَى","بَينِي وبَينَكَ والكَرَامَةِ حالا؟!",44,"ل",2,0],["يا مَن كَذَبتُ فَصَدَّقَتْ أَنا صادِقٌ","مُتَهَالِكٌ, وزَمَانُهُ تَمثِيلُ",45,"ل",1,0],["يامَنْ كشفتم بعدَ غدري وجهكم","ماكنتُ أدري أنَّكُم حيَّاتُ",46,"ت",1,0],["يا من كمل حسنك وفعلك دوب لي ما هو حسن","يا من غمض جفنك جفوني للكرى بعدك جفن",47,"ن",1,0],["يَا مَنْ كَتَبْتَ عَلَيْكَ رَحْمَةَ عَبْدِهِ","اجْعَلْ فُؤَادِي فِي رَحَابِةِ ظِلِّهَا",48,"ل",3,0],["يَا مُنكِرِي السِّرِّ الذي","فِي البَيضَةِ الشَّقْرَا كَمَشْ",49,"ش",1,0],["يامن كَفَرْتَ بِنعْمةٍ ممن أتى","يدعوك للخير العميمِ بمن دعا",50,"ع",2,0],["يا من كناصعةِ السحابِ بوجهها","للغيم تشكو عريَها الصحراءُ",51,"ا",2,0],["يا من كتبتكِ بيتَ شعرٍ أبيضٍ","يخلو منَ الهمزاتِ واللمزاتِ",52,"ت",1,0],["يا من كتابُ اللهِ زيَّنَ لفظَها","وجنانُنا من فوقها قدماكِ",53,"ك",1,0],["يا مَن كأنَّ البدرَ يحسدُ كِ","أهو المُصَوِّرُنِي مُصَوِّرُ كِ؟",54,"ك",1,0],["يامن كفرتَ!!...وتلك الأرض معضلة !!","لم تقبل الحلّ لم يهدِ النهى شرحُ !!",55,"ح",1,0],["يا منكرَ الشّمسِ هذي الشّمسُ قد طلعت","دنيا الهناءةِ عامٌ بعده عامُ",56,"م",1,0],["يا من كساها الحُسنُ ثوبَ شمائل ٍ","وكسا مُحيّاها الجميلَ كمالُ",57,"ل",1,0],["يا منكر الاحباب بعد فراقنا","هل يرتجى بعد الفراق خصيمُ",58,"م",1,0],["يا مَنْ كتبتِ على قلبي حروفَكِ في","لينٍ فصارَ دمي نهرًا جرى رُطَبا",59,"ب",2,0],["يا من كسا جسمي ثياب الأصيل","وأجرى دموعي كالمواطر",60,"ر",1,0],["يامن كفلتِ يتيمًا والكفيلُ له","بصحبةِ المصطفى تاجٌ على الرأسِ",61,"س",1,0],["يا من كتبت لنا بانك ناصح","هلا ظهرت لنا رعاك الهادي",62,"د",2,0],["يا مَنْ كَغُرَّتِه الهلالُ أما ترى","بدو الهلال وقد بدا في المشرقِ",63,"ق",1,1],["يا مُنْكِراً هَدْمَ الحُصُونِ إذَا اعْتَصَتْ","بِدعائِمِ التَّأسِيسِ والتَّشهِيقِ",64,"ق",1,1],["يا منكرا بين الصحائف فضله","أو شاتما مستغرقا في سبّه",65,"ب",2,0],["يا منكرا ما للهوى من وقعة","في مهجة ما كنت من غرمائها",66,"ا",3,0],["يا من كسته الخطوب خوفا","من حل ذاك الفناء يأمن",67,"ن",1,0]]}