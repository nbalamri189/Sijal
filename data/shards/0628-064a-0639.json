"https://www.poetsgate.com/ViewPoem.aspx?id=200258",""],[6102,"نَفَقَ الحِمارُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185211",""],[5051,"يا عنترة !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87708&r=&rc=2",""],[6310,"شريان التحدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71999&r=&rc=3",""]],"verses":[["بَيعَةُ إِبراهيمَ مَشؤومَةٌ","تُقتَلُ فيها الخَلقُ أَو تُقحَطُ",0,"ط",1,0],["بِيع للأطماع فيها","حقكم بيع الخَساره",1,"ر",2,0],["بي عنْ صُدودِك ضعفٌ","ولي بشُكركَ نَهضُ",2,"ض",1,0],["بيعاً صحيحاً لازماً شرعياً","ثم شراءً قاطعاً مرعيَّا",3,"ي",2,0],["بي عروضيٌّ مليحٌ","موتتي فيهِ حياتي",4,"ي",1,1],["بي عروضيٌّ مليحٌ","موتتي فيهِ حياةُ",5,"ه",1,1],["بِيعوا لِقومٍ فاسقينَ فما رَعَوْا","حَقَّ العبيدِ وحُرمةَ الخُدّامِ",6,"م",1,0],["بيعت لتهرق في الكؤوس مدامة","هي - لا روتهم - أنفس تتألم",7,"م",1,0],["بي عَلَيكَ ما مَنَعَ الن","نفسَ مِن تَصَبُّرِها",8,"ر",3,0],["بيعَتْ مبادئُنا، فما أبصرتُه","في السوق ساوم مرةً، أو سُووِما",9,"م",2,0],["بيعة ً يوماً ولا فكَّ رُهُونا","صاحبي قفْ بي فإني لم أجد",10,"د",1,0],["بيعه في رقابنا لأبي غازي","وللإبن بعده والحفيد",11,"د",1,0],["بيعت نساؤهمَ وبيع بنوهم","وبناتهم ومضى الرجال قتالا",12,"ل",2,0],["بَيعةُ الركنِ منه وهو يمينُ ال","لَهِ تمّت فتمّ الاِستيلاءُ",13,"ا",2,0],["بي عَذابٌ مِنها كِشِعرِكَ رَحبُ","تَقرِّبُني نَفسي فَتُبعِدُني غَلوا",14,"ل",3,0],["بي علةٌ تقطع أسبابها","من راحة الصحة أسبابي",15,"ب",2,0],["بَيعُها بُيوتُها مَساجِدٌ","وَالنَخلُ وَالأَعنابُ رِزقٌ وَسَكَر",16,"ر",1,0],["بيعت لَها الأَنفُس مِن طَلعَةٍ","بَدريّةٍ جَلَّت عَن المُشتري",17,"ر",2,0],["بي عَناءٌ ولى لديك اعِتناءٌ","لم يَزلْ لي إذا طَلبْتُ عَتيدا",18,"د",2,0],["بي علةٌ وحروفها محسوبة","هي ستة ودواؤها لم يعمل",19,"ل",1,0],["بيع كالعبد حين يختمه","البائع بالضرب وهو طوعا يلبي",20,"ب",2,0],["بي عن خُطَّةِ الهَوان التفاتٌ","مثلما ألفِتَ البعيرُ المُغِدُّ",21,"د",1,0],["بي عليم غير أن له","حكمة تهزَى بكل حجا",22,"ج",2,0],["بيعكم الأرواح في عرصة الوغى","ربحتم به شيئين الفخر والأجرا",23,"ر",2,0],["بيعتكم إياي وفي شرّها","ربي وقال إذ أبان أمرها",24,"ه",2,0],["بي عِذارُ الحِبِّ قَد بانَ لَنا","وَهوَ لِلحَسناءِ مِن أَكسابِها",25,"ه",2,1],["بي عِذارُ الحِبِّ يَبدو","فَوقَ وَردِ الخدّ ظَاهِرْ",26,"ر",1,1],["بيعَةُ المَأمونِ آخِذَةٌ","بِعَنانِ الحَقِّ في أُفقِه",27,"ق",2,1],["بيعوا بِسوقِ البَرلَمانِ وَقامِروا","بِمَصالِحِ الشَعبِ الفَقيرِ المُعدِمِ",28,"م",1,0],["بيع بَيعَ الرقيق مِن بَعدِ رُؤيا","وإلى السِّجنِ سيقَ وهو بَرَاء",29,"ا",2,0],["بَيْعَتِي وَاللهِ صِدقاٌ","ثابتاً ما فيه مين",30,"ن",1,0],["بيع الكرام عن الكرام بعفة","ما بيعهم كالبائع الحلاف",31,"ف",1,0],["بَيعَةَ الرِضوانِ قَد فازوا بِها","أَسفَلَ الغُصنِ المُدَلّى فَدَنا",32,"ن",2,0],["بيعتْ علينا الراديات بوفرة","من ذا يبيع الذوق لاستعمالها",33,"ل",3,0],["بيعت (وداد) بالمزا","د وقلبها دام وجيع",34,"ع",1,0],["بيعةُ كرهٍ نالها معاوية","وهي على البصير غير خافية",35,"ه",1,0],["بِيعةُ قُسطنطينةٍ","أُمّ الكراسي الفاسقه",36,"ق",2,0],["بيعت باسواقها العليا فكان لها ال","شاري وشدّد في أحرازها الطلبا",37,"ب",2,0],["بي علة مما اكابده","لا الطب يُبرئها ولا السحر",38,"ر",1,0],["بَيعةٌ قد عَقَدوها","لك بالطَّيْرِ الأيامن",39,"ن",1,0],["بيعَت كَما باعَ مَجنوهٌ جَواهِرَهُ","من العداة فَهَل كنّا مجانينا",40,"ن",2,0],["بيعت عوالمهم، دُكت مدائنهم","وللرياح بجوف الليل تصخابُ",41,"ب",1,0],["بيعت لحوم المسلمين رخيصة","والعظم بعد اللحم حتما يُكسر",42,"ر",1,0],["بيعة ولاء أكلبية كنّها شمس النهار أجهرا","حرب ٍ لمن حارب الاسلام وانصار لمن ينصره",43,"ر",2,0],["بَيعَةٌ تِلكَ، فاحذَرُوا مَن أَتَاها","واحذَرُوها، فالمَوتُ كَالحَربِ سِلعَة",44,"ع",2,0],["بيعقوب بالأسباط بالآية التي","صرفت بها عن يوسف السوء إذ هما",45,"م",2,0],["بيعتِ الأحلامُ في وهج ِ الضّحى","واشترى كلُّ خبيثٍ مبدأه ْ",46,"ا",2,0],["بي عالمٌ مثل الشموس مشعشعٌ","يهب الضياء الى النبات ليرفعه",47,"ع",2,0],["بيعت مصانعنا وأتلف عزّنا","ومن الكنوز جوارنا يتبضّعُ",48,"ع",1,0],["بيع على رغم مالكيه","معتبط ليس يستبيع",49,"ع",1,0],["بيعة وفا ما هيب زيف ولانفاق","نقولها والله عليها يشهدا",50,"د",2,0],["بيعي وأشتري وبدلي","رخيص قومٍ ب الذي لا يُباع",51,"ع",1,0],["بيعوا بأسواقِ النخاسة حلمَنا","ولنا دَمٌ ..وشعوبُنا لا تصفحُ .",52,"ح",1,0],["بِيعَتْ ضَمائِرُنا , وَ دِيسَ يَقِينُنا","وَ تَحَكَّمَ الرَّقَّاصُ ؛ وَ الطَّبَّالُ",53,"ل",1,0],["بيعَتْ سماءُ العُرْبِ بَلْهَ تُرابَهُم","فاستَطعموا قمحَ الخضوعِ وسُكَّرَهْ",54,"ر",2,0],["بيع الأراضي والسلام مع العدا","والسُّمّ فينا ينخُر",55,"ر",1,0]]}