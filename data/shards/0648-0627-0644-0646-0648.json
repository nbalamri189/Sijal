ttps://www.poetsgate.com/ViewPoem.aspx?id=138276",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6078,"نيليّة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=202774",""],[6100,"خسرتك","https://www.poetsgate.com/ViewPoem.aspx?id=52548",""],[6102,"احتياج ..","https://www.poetsgate.com/ViewPoem.aspx?id=182836",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[6102,"معلمة الموسيقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=185060",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[6152,"حديث بحر","https://www.poetsgate.com/ViewPoem.aspx?id=201779",""],[6152,"الصبح وجهكِ والشروق ضياؤه","https://www.poetsgate.com/ViewPoem.aspx?id=213225",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""]],"verses":[["والنُّؤْيُ أنْحَلَهُ البِلى فكأنّها","أهْدَتْ إلَيهِ سِوارَها المَفْصوما",0,"م",2,0],["وَالنَومُ قَد نَفَّرَهُ أَحوَرٌ","أَغَنُّ ساجي الطَرفِ سَحّارُ",1,"ر",1,0],["وَالنُؤيُ قَد هَدَّمَ أَعضادَهُ","تَقادُمُ العَهدِ بِوادٍ تَهام",2,"م",1,0],["وَالنورِ مُستَتِراً فَقُلتُ لَها","كُفّي المَلامَة وَاِقصُري الفَنَدا",3,"د",2,0],["وَالنورُ مُنبَثِقا وَمُنتَشِراً","إِن لَم يَكُن لِلناسِ هُدى",3,"د",2,0],["وَالنورُ يَبني حَولَكَ في السُفوحِ وَفي الذُرى","دوراً مُزَخرَفَةً وَحيناً يَهدِمُ",4,"م",1,0],["وَالنورُ عِطرٌ في تَعريجِها","وَالعِطرُ نورٌ في حَواشيها",5,"ي",3,0],["وَالنورُ لِلمُدلِجِ وَالمُجتَلي","وَالدُرُّ لِلغائِصِ وَالمُقتَني",6,"ي",1,0],["وَالنُواسِيُّ وَالنَدامى أَمنِهِم","سامِرٌ يَملَأُ الدُجى أَو نادِ",7,"د",1,0],["وَالنَوى خُطَّةٌ مِنَ الدَهرِ ما يَن","فَكُّ يُشجى بِها المُحِبُّ وَيَبلى",8,"ل",2,0],["وَالنَوالُ القَليلُ يَكثُرُ إِن شا","ءَ مُرَجّيكَ وَالكَثيرُ يَقِلُّ",9,"ل",1,0],["والنَّورُ في حَلْيَين مُش","تَبهينِ من طلٍّ ووَابِل",10,"ل",1,0],["والنَّوْرُ إن جادَ الغَمامُ به","حملَتْ له ريحُ الصَّبا نَشْرا",11,"ر",2,0],["والنوى كالردَى عذابٌ ولكن","يمسكُ القلبُ حُلمَه باللقاءِ",12,"ا",2,0],["والنور أين النور هل غاله","ماحٍ محا الفجر وأخفاه",13,"ا",2,0],["وَالنُؤيُ أُهمِدَ شَطرُهُ فَكَأَنَّهُ","تَحتَ الحَوادِثِ حاجِبٌ مَقرونُ",14,"ن",1,0],["وَالنَورَ نَورَ العَرارِ أُجرِيَ في","تَسهيمِهِ المُجتَلى عَلى يَنَعِه",15,"ع",2,0],["والنورُ لَنْ “يُعْمِي” جُفوناً","قد جُبِلْنَ على الظلامِ",16,"م",1,0],["والنومُ أَدْعَى للنُزُولِ","على السَّكِينَةِ والنِّظَامِ",16,"م",1,0],["وَالنورُ مُبتَسِمٌ وَخَدُّ","الوَردِ مَحطوطُ النِقابِ",17,"ب",1,0],["وَالنورُ عِقدٌ وَالغُصونُ سَوالِفٌ","وَالجِذعُ زَندٌ وَالخَليجُ سِوارُ",18,"ر",1,0],["وَالنورُ يَرقُمُ مِن بِساطِ بَسيطَةٍ","وَالغَيمُ يَنشُرُ مِن جَناحِ رِواقِ",19,"ق",1,0],["وَالنورُ طَرفٌ قَد تَنَبَّهَ دامِعٌ","وَالماءُ مُبتَسِمٌ يَروقُ صَقيلُ",20,"ل",1,0],["وَالنور ذو لحظات في خَمائلها","كَأَنَّها لَحظات النَهدِ اللعين",21,"ن",1,0],["وَالنَومُ عِندَ الفَتاةِ أَرشُفُها","وَجَدتُني ثَمَّ فارِسَ العَرَبِ",22,"ب",1,0],["وَالنورُ في حُكمِ الخَواطِرِ مُحدَثٌ","وَالأَوَّلِيُّ هُوَ الزَمانُ المُظلِمُ",23,"م",1,0],["والنورُ سِرٌّ في ضَميرِ الدُّجى","والفجرُ طيفٌ لم يَبنْ للعيانْ",24,"ن",1,0],["والنوح على الدوح حلي","للصارخ الشاكي",25,"ي",1,0],["وَالنُّوْرُ في أَوْرَاقِهَا مُتَنَخِّلٌ","يَصْفُوا ذَرُوراً في عُيُونِ الرَّاقِبِ",26,"ب",1,0],["وَالنُّورَ سَخَّرْنَ كَيْمَا","يُبْدِعْنَهُ وَالْمَاءَ",27,"ا",2,0],["والنَوم من فَزَعِ \" الرؤى \" يبساً","رُدِّيه ، او بدمائها غَرِقا",28,"ق",2,0],["والنور منبثقا ومنتشرا","إن لم يكن للناس فيه هدى ؟",29,"د",2,0],["والنور يبني في السّفوح وفي الذّرى","دورا مزخرفة وحينا يهدم",30,"م",1,0],["والنور في عيني ولا منّ عليك ولا كذاب","أنا من عرفت : تجلّد عند النوائب واحتساب",31,"ب",1,0],["والنور عطر في تعاريجها","والعطر نور في حواشيها",32,"ي",3,0],["وَالنَوم أَينَ وَباب الحُزن بَعدَهُم","عَلَيهِ كَف تَمَنى المَوت يَقرَعَهُ",33,"ه",1,0],["والنوم سلطانٌ مراسيمُه","تُلقى على العينينِ والرأسِ",34,"س",1,1],["والنُّور بين مدنَّرٍ ومدرهم","حيث التفتّ رأيته ملء الملا",35,"ل",2,0],["والنواس قد علموا أني أخو جميل","فلست أنفق غلا في الرساتيق",36,"ق",1,0],["وَالنورُ عَن عين الوجودِ مكتّما","اللَّهُ قَد صلّى عليهِ وسلّما",37,"م",2,0],["وَالنورُ في جَبينهِ ذو وقدِ","زوّجهُ أبوهُ خيرَ حرّةٍ",38,"ه",1,0],["والنّور عمّ جميع أرضكم التي","حازت بك البركات بالأسرار",39,"ر",1,0],["والنون من لام بضعف أبدل أو","من واو هم وشد فاقف ماقفوا",40,"ف",3,0],["والنون من نبل واو يبدل","وفي فم عن ذاك ليس يعدل",40,"ل",1,0],["وَالنورُ أَشهى قُبَل","تَلُفُّها الأَسرار",41,"ر",1,0],["وَالنوقُ فَلا سَرَت بِلَيلٍ داجٍ","إِن عُدنَ وَلَم يَحمِلنَ مِنكُم خَبَرا",42,"ر",2,0],["وَالنورُ يَبسِمُ ثَغرُهُ","طَرَباً وَدَمعُ المُزنِ واكِف",43,"ف",1,0],["والنُّورُ مُنتشِرٌ لدَيكِ أهِلَّةً","والزَّهرُ مُنتشِرٌ عليكِ رَذاذا",44,"ذ",2,0],["وَالنوق حين تكلمت بفخاره","وَلغير ذاك البدر لم تتكلم",45,"م",1,0],["والنوم قد غاب منذ غبتم","ولم تقع لي عليه عيني",46,"ي",1,0],["وَالنُؤيُ فيها وَمَشجوجٌ يُجاوِرُهُ","وَلَيسَ أَن شُجَّ بِالأَفهارِ يَرتَمِلُ",47,"ل",1,0],["والنور يسلبه","ما ضوؤه يهب",48,"ب",1,0],["والنُّورُ في ذاكَ السَّوادِ كَأنَّما","نَظَرَتْ إليكَ بَعَيْنِ ذاتِ كِناسِ",49,"س",1,0],["والنواويرُ في الأكمة تجلى","حبباً من لجينها مقلوبا",50,"ب",2,0],["والنواوير بمسك فتقتْ","بين خلجانِ وظلِّ سجسجِ",51,"ج",1,0],["والنور يرفض أصباغا وزركشة","في الريش والماء بل آيا نحييها",52,"ي",3,0],["والنّور فوق الماء ذائب فضّة","من فوق مائعِ عسجدِ يتألّق",53,"ق",1,0],["والنومُ مذ رحلَ الخليطُ عنِ الحِمى","ونأى الحبائبُ بعدهنَّ غِرارُ",54,"ر",1,0],["والنُّورُ نورٌ بارِزٌ","والفَيْضُ فيضٌ حاصِلُ",55,"ل",1,0],["والنّؤومُ المُوَقِّتُ اليومَ يدعُو","نا لِتَعيين وقتِها بالمَنامَه",56,"م",2,0],["والنَّورُ في حافاتِهِ مُتفسِّحٌ","والأُقحوانُ بجانبيهِ مُفَلَّجُ",57,"ج",1,0],["وَالنّوى كَالرّدى وَفَقدٌ كَفَقدٍ","غَير أن غائبُ الرّدى لا يؤوبُ",58,"ب",1,0],["والنور بالظلمات يظهر عادة","وكذلك الظلمات من نور تَبينْ",59,"ن",1,0],["والنور نور الذات في ظلامنا","ولم نزل نحنُ له الشئونا",60,"ن",2,0],["والنور والظلمات أنت حقيقةٌ","وسوى كمالك كله نقصانُ",61,"ن",1,0],["والنور تل