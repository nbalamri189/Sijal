{"poems":[[57,"اصرف فؤادك يا عباس ملتفتا","https://www.aldiwan.net/poem26417.html","البسيط"],[57,"ما زلت أسخر ممن","https://www.aldiwan.net/poem26466.html","المجتث"],[80,"مولاي ياذا الأيادي","https://www.aldiwan.net/poem14064.html","المجتث"],[45,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[47,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[63,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[18,"لما نعى الناعي كليباً أظلمت","https://www.aldiwan.net/poem23944.html","الكامل"],[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[190,"ما زلت أحذر من وقوع فراقهم","https://www.aldiwan.net/poem43541.html","الكامل"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[266,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[369,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[369,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[415,"لو أن كتبي بقدر الشوق واصلة","https://www.aldiwan.net/poem31686.html","عموديه"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[563,"علم عظيم النفع للعالم","https://www.aldiwan.net/poem34181.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86918","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122378","الرجز"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17563","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96653","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72313","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50016","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133869","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11987","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69400","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199634","المسحوب"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122501","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112326","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48381","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48305","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20892","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97077","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93772","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73298","الكامل"],[4339,"","https://poetry.dctabudhabi.ae/diwan/poem/105724","الكامل"],[5184,"قَطَّعْتُ كلَّ اصابعي","https://www.poetsgate.com/ViewPoem.aspx?id=196813",""],[5725,"بغداد يا خوف الفؤاد وأمنه","https://www.poetsgate.com/ViewPoem.aspx?id=214502",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5790,"نظري إليكم والركاب تساق","https://www.poetsgate.com/ViewPoem.aspx?id=112085",""],[5956,"فاجعُ المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=182538",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""]],"verses":[["حَتّى أَبانَ الهَوى ما كانَ يَستُرُهُ","ضَنّي بِها وَأَبادَ الروحَ وَالجَسَدا",0,"د",2,0],["حَتّى اِبتُليتُ بِمَن لا","يُحِبُّني وَأُحِبُّه",1,"ب",2,0],["حَتّى أَبَحتُ حِماها","بِمُرهِفاتٍ حِدادِ",2,"د",1,0],["حَتّى أَبو الفَضلِ اِبنُ عَبدِ اللَهِ رُؤ","يَتُهُ المُنى وَهيَ المَقامُ الهائِلُ",3,"ل",1,0],["حَتّى اِبتَدَأتَ بِما اِبتَدَأتَ بِعُظمِهِ","فَغَلَبتَ عُظمَ تَماسُكي وَتَزَهُّدي",4,"د",2,0],["حتّى أباحَ حريمَهم لا ظالماً","وضحَنا على أبكارِهْم لا مُشفِقا",5,"ق",2,0],["حَتّى أُبيدَ قَبيلَةً وَقَبيلَةً","وَقَبيلَةً وَقَبيلَتَينِ جَميعا",6,"ع",2,0],["حَتّى أَبانَ عَنِ اِعتِزامِ لَم يَزَل","لِلمالِ وَالباغي العَنيدِ مُبيدا",7,"د",2,0],["حتّى ابتليت به فهان شديدهُ","والصبر يفتحُ كل باب مغلق",8,"ق",1,0],["حتى أبِيت بين غِيدٍ نُهَّد","أرشُف شَهْداً كامِنا في بَرَد",9,"د",1,0],["حتى أباد أخ أخاه","وفيهما حلم رصين",10,"ن",1,0],["حتّى أَبانَ لَه المهيمنُ مسلكاً","لا تَستقلُّ بِه قوى الإنسانِ",11,"ن",1,0],["حتّى أُبِلَّ بما يَجشَمْنَ من عِلَلٍ","أدنفِنني وأَبُلَّ الصَّدرَ من غُلل",12,"ل",1,0],["حتّى أَبَتْ نَفْسُهُ إلاّ مُؤاخَذةً","بما جنَى الدَّهرُ في أيّامِه الأُوَل",13,"ل",1,0],["حتى أبوح بما أشكو إليك كما","باح المريض بشكواه إلى الآسي",14,"س",2,0],["حَتَّى ابْنُ شَنْجٍ يَوْمَ أَمَّكَ خاضِعاً","تَسعى إِلَيْكَ بِهِ نَدَامَةُ تائِبِ",15,"ب",1,0],["حتى أبى عن أن يُرى ساجداً","لربه من قوة الواهم",16,"م",1,0],["حَتّى أَبث ثَناءه بَينَ الوَرى","وَبِهِ أُحلِّي دائِماً أَشعاري",17,"ر",2,0],["حتى ابي الفضل الشريف راشد","كنز الرجا ومهزة القبائل",18,"ل",1,0],["حَتّى اِبتُليتُ بِحُلوِهِ وَبِمُرِّهِ","فَالحُلوُ مِنهُ لِلقُلوبِ مُذيبُ",19,"ب",1,0],["حتّى أبحتَ إلى الأعداءِ صاعقةً","تصبُّ منها عليهم كلَّ محذورِ",20,"ر",1,0],["حتى أبان لهم بقائم سيفه","في الدين نهج حرامه وحلاله",21,"ل",2,0],["حتى ابتداء ناصب جرّ كأو","والواو إلا أن إلى أن قد رووا",22,"و",3,0],["حتَّى أَبَرَّ إلي لي بكَرامةٍ","وأجلِّ معروفٍ وأَجزلِ نائِلِ",23,"ل",1,0],["حتى ابتليت بمعبري","فحصلت بين الناس شامه",24,"م",2,0],["حَتّى أَبَنتُ حَديثَ حادِثَةِ النَوى","لِمُؤَيَّدِ الدينِ الوَزيرِ أَبي عَلي",25,"ل",2,0],["حَتّى أَبادَ بَناتِ أَرحَبَ خَبطُها","جُنحَ الظَلامِ إِلَيهِمُ وَالبِيدا",26,"د",2,0],["حتى ابتنى قلل العلياء من شرف","ورم ساحتها الجرباء بالرمم",27,"م",1,0],["حتى أبين حالتي له بمكتوب","يشرف عليها سيد كل الملاحي",28,"ح",2,0],["حتى أبحت الكل منهم صاغراً","من حد ردمان إلى بيعات",29,"ت",1,0],["حتى ابن ُزيدانَ رأسُ المالِكيّ بِهَا","قَد قَامَ عَن حُكمِهِ بالفِقه يُرجِعُهُ",30,"ع",2,0],["حتى ابتليتُ بليلَةٍ","دهماء عنها الصبح بان",31,"ن",1,0],["حتّى ابْنُ نصْرٍ وهْوَ قُطْبُ الهُدى","بالنّجْمِ منّي لمْ يَزل يهْتَدي",32,"ي",1,0],["حتى أباحَتْ لمْحَة من وصْلِها","سمَحَتْ بها الأيامُ بعْدَ جفاها",33,"ا",3,0],["حَتّى أَبانوا كُل ما قَد أَشكَلا","عَلى سِواهُم فَاِستَبانَ وَاِنجَلى",34,"ل",2,0],["حتى أبادهمُ على أحزاهمُ","صرعى بكلّ نقيرةٍ ومَكانِ",35,"ن",1,0],["حتى أبيدوا فانثنى","سبط الهدى من غير ناصر",36,"ر",1,0],["حَتّى اِبتززت حَياتها","وَعَتَوت في رُوح طَهور",37,"ر",1,0],["حَتَّى أَبثَّكُمُ الغَرامَ وَما حَوَى","قَلبي وما صَنَعت بِهِ الأشواقُ",38,"ق",1,0],["حتّى أبادهمُ على أخراهمُ","صرعى بكُلِّ نُقَيرةٍ ومكان",39,"ن",1,0],["حَتّى ابتدا بِسْمِكَ اللّهُمَّ مذْبَحُنا","وَبِاسْمِكَ الآنَ شَرُّ الْخَلْقِ مَعْبوْدُ",40,"د",1,0],["حتى أباهي الشامتين بنزفه","وأردّ سبّاب الهوى بسبابهِ",41,"ب",2,0],["حتى أبابيلُ السّماء تمنّعتْ","عن فيلهِ لمّا تمادى في الحيلْ",42,"ل",1,0],["حتى أبثكم الغرام وما حوى","قلبي وما صنعت بي الأشواق",43,"ق",1,0],["حتى أبيعَ مُؤَلَّفي وأطيرَ من","قَطْرٍ لآخر ناسياً ذكراكا",44,"ك",2,0],["حتى أبوي اللي سنيدي من الناس","ماهمتها فرقاي يومها نواها",45,"ا",3,0],["حتى أبنت عن اللظى في ملمس","وكشفت في شرب عن الأكدار",46,"ر",1,0]]}