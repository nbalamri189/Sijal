{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[88,"ما لهذا النجم في السحر","https://www.aldiwan.net/poem10504.html","المديد"],[88,"أيها الوسمي زر نبت الربا","https://www.aldiwan.net/poem10855.html","الرمل"],[95,"يا أمير القلوب يحفظك الله","https://www.aldiwan.net/poem9826.html","عموديه"],[72,"أيها الزائرون أه","https://www.aldiwan.net/poem43012.html","مجزوء الخفيف"],[52,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39620","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[121,"عاوز إيه","https://www.aldiwan.net/poem24057.html","الرمل"],[310,"أيها الزائر أمل ما تريد","https://www.aldiwan.net/poem56565.html","الرمل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[366,"أيها الزائر المقام الحسيني","https://www.aldiwan.net/poem68062.html","الخفيف"],[484,"بلبل في الروض غنى","https://www.aldiwan.net/poem37611.html","مجزوء الرمل"],[543,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126824","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126867","الخفيف"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77432","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87768","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92047","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92032","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127070","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[5111,"مَرْحَى","https://www.poetsgate.com/ViewPoem.aspx?id=212337",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5409,"نبتت فوق روضة من غدير","https://www.poetsgate.com/ViewPoem.aspx?id=155302",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5670,"جئتُ يا شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=211123",""],[5693,"يا مجرّات الثريا .","https://www.poetsgate.com/ViewPoem.aspx?id=35144",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[6361,"شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66814&r=&rc=44",""]],"verses":[["أَيُّها الزارِعُ سَقياً","فَبِذا الزَرعِ أُوامُ",0,"م",1,0],["أَيُّها الزِنجِيُّ ما لَكَ لَم","تَخشَ فينا خالِقَ البَشَرِ",1,"ر",1,0],["أَيُّها الزَهرُ أَفِق مِن سِنَةٍ","وَاِصطَبِح مِن خَمرَةٍ لَم تُعتَصَر",2,"ر",1,0],["أَيُّهَا الزَّائِرُ الَّذِي تَلْتَقِيهِ","مُهَجٌ حَيْثُ حَلَّ بِالتَّرْحِيبِ",3,"ب",1,0],["أَيُّها الزائِرونَ أَه","لاً وَسَهلاً وَمَرحَبا",4,"ب",2,1],["أَيُّها الزاري عَلى أَيّامِهِ","رُبَّ يَومٍ لَكَ مَشهورٌ أَغَر",5,"ر",1,0],["أيُّها الزائرُ المعاودُ ما ألْ","قاكَ أحسنتَ بالمزار صنيعا",6,"ع",2,0],["أيّها الزاعمون أنّا فرقنا","صائد الليث لا يكون فروقا",7,"ق",2,0],["أَيُّهَا الزَّائِرُ الْعَظِيمُ أَثَابَ اللهُ","مِنكَ الجَميلَ خَيْرَ الثَّوَابِ",8,"ب",1,0],["أيّها الزّهرةُ ناجي عاشقًا","يَحتسي مِن كأسِ حِرمانِكِ قَهْرَه",9,"ر",2,0],["أيُّها الزائرُ أمّل ما تريد","فَلِمن قَد زُرته الباعُ المديد",10,"د",1,1],["أيها الزاهدون في غمرة الإث","م سلاماً من زاهدٍ عبقري",11,"ي",1,0],["أَيُّها الزائِر المقام الحسيني","هكَذا هكَذا يَكونُ المَقام",12,"م",1,1],["أيها الزاهي بتاج","ما تجلّى للعيون",13,"ن",1,0],["أيها الزائر الذي","كل أنس معه وفد",14,"د",1,0],["أيّها الزائرون ندوتنا اليو","مَ إِلَيكم منّي الثنا المُتواصل",15,"ل",1,0],["أيّها الزائر المكلّل بالإق","بال والعزّ فيك نِلنا المَغانِم",16,"م",1,0],["ايها الزاخر الَّذي كل من يَنحو","له من نداه يملا وطابه",17,"ب",2,0],["أَيُّها الزائِرُ قَبري","بَينَكَ اللَهُ وَبَيني",18,"ي",1,1],["أَيُّها الزاخر فَضلاً كُلَّما","صَدَرت عَنهُ دِلاء المُغتَرِف",19,"ف",1,0],["أَيها الزائر العَزيز المُفدى","قف وَفكّر وَما تحيط العُقول",20,"ل",1,0],["أَيها الزوار قرّوا أَعيناً","وَاشهدوا شمس المَعالي في مدار",21,"ر",1,0],["أيها الزوار نلتم","ههنا أقصى المرام",22,"م",1,1],["أيها الزائري لفائدة لا","ترم المستحيل ما ذاك عندي",23,"ي",1,0],["أيُّهَا الزَّائِرُ مَرْحَى","تُنْشِدُ البَهْجَةُ سَهْلاَ",24,"ل",2,1],["أيها الزاعمون انا احتكرنا","دعوة الحق وحدنا وانزوينا",25,"ن",2,0],["أيها الزهرة الجميلة صبراً","ليس فصل الربيع كل الفصول",26,"ل",1,0],["أيها الزاهد الذي لم يعقه","الزهد أيان تدعه الهيجاء",27,"ا",2,0],["أيها الزورق أدرك أحرفي","(واقصُدِ البحرَ وخلّ القنوات)!",28,"ت",1,0],["أيّها الزائر مهلا","في مدّرات المروج",29,"ج",1,0],["أيها الزائرون مشهد نور","لحسين ظفرتم بالسرور",30,"ر",1,1],["أيها الزائر الليلي","ينابيع من نور تتفجر حولك",31,"ك",1,1]]}