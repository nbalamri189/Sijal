{"poems":[[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[71,"قل لتقي الدين حاشاك من","https://www.aldiwan.net/poem28572.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16675","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[469,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64040","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65081","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77372","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132615","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138530",""],[5956,"يا صديقتي العنزة","https://www.poetsgate.com/ViewPoem.aspx?id=183423",""],[6093,"ذات موصدة","https://www.poetsgate.com/ViewPoem.aspx?id=204990",""]],"verses":[["قَلَّلْتُهُ فيكم وهذَّبتُهُ","عمداً وما قلَّلَ من هذّبا",0,"ب",2,0],["قلْ لتقيِّ الدينِ حاشاكَ مِنْ","إضاعةِ الصاحبِ والجارِ",1,"ر",1,1],["قُلْ لِتِرْبِ الآدابِ في كلّ فَنٍّ","وحَليفِ النّدى وحَرْبِ العَذُولِ",2,"ل",1,1],["قل لتلك العهودِ في رَهَج الحَرْ","بِ، وفي سكرة القنا والغلاصم",3,"م",1,0],["قَلَّلتُمُ عَدَدَ العِدى بِقَواضِبٍ","كَثَّرنَ أَزوادَ النُسورِ الحُوَّمِ",4,"م",1,0],["قل لتلك القدود أنتِ غصونٌ","فمتى كانت البدور ثمارا",5,"ر",2,0],["قل لِتِربِ النَّدى أبي الحسن العا","رفِ فَضَل الأرفاد والإسعاف",6,"ف",1,0],["قُلْ لتقيِّ الدِّين يا مَنْ هَدَى","إِلى العُلا مِنْهاجُهُ الواضحُ",7,"ح",1,1],["قُلَلٌ تَعيثُ بِها الذِئابُ فَواتِكاً","ما بَينَ دانيها وَشُمِّ هِضابِها",8,"ب",3,0],["قُل لِتِلكَ الجُموعِ غَرَّتهُم الدُن","يا فَهاموا بِها الشَتاتُ الشَتاتُ",9,"ت",1,0],["قل لتقيل بسيوف لحظها","مالك ما بين الورى من ثائر",10,"ر",1,0],["قل لتلك الضلوع بعدك قلبي","ما له جابرٌ فدتك القلوب",11,"ب",1,0],["قَلَّلْتِ فِيَّ الاهتمامَ تماما","وأنا أَموت إهانةً وهياما",12,"م",2,1],["قَلَّلْتِ حبَّكِ لي أ أنتِ نسيتِني","أمْ ليس تهوى الماشيات أناما ؟",12,"م",2,0],["قَلَّلْتَ من شأنٍ لذاتكَ مُجْحِفاً","لوْ قد فَطنتَ رأيتَ ثَمَّ زمردَةْ",13,"د",2,0]]}