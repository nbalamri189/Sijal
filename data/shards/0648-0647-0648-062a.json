{"poems":[[55,"شرف الخلافة يا بني العباس","https://www.aldiwan.net/poem30200.html","الكامل"],[90,"قل لنجلا نجلا أبي اللمع إني","https://www.aldiwan.net/poem45060.html","الخفيف"],[93,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[64,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[104,"لي بالحياة تعلق وتشدد","https://www.aldiwan.net/poem33119.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[79,"هي أسعدٌ ما دونهنَّ حجابُ","https://www.poetsgate.com/ViewPoem.aspx?id=33307",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[93,"موت العبقري","https://www.poetsgate.com/ViewPoem.aspx?id=52962",""],[146,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[159,"قم فاجل همي يا غلام","https://www.aldiwan.net/poem55556.html","مجزوء الكامل"],[295,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[376,"سر فما يلقاك في","https://www.aldiwan.net/poem57521.html","مجزوء الرمل"],[469,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[563,"إنما الإيمان نور","https://www.aldiwan.net/poem33785.html","مجزوء الرمل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126891","الكامل"],[723,"","https://poetry.dctabudhabi.ae/diwan/poem/102033","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109005","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108974","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108550","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144760","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125374","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52066","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118393","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69374","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130751","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124674","الكامل"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130037","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138683",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131239",""],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97085","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52143","الكامل"],[4767,"مواجهة","https://www.poetsgate.com/ViewPoem.aspx?id=215693",""],[4578,"خطرت لأعطاف المحاسن ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=49618",""],[4578,"قد رعت يا ريب المنون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=49406",""],[4927,"مَجْدُ الْعِرَاْق","https://www.poetsgate.com/ViewPoem.aspx?id=30480",""],[4119,"أشرق البهو يا جبين الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=16212",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5436,"شوق التراب(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34912",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5839,"جرح","https://www.poetsgate.com/ViewPoem.aspx?id=62092",""],[6019,"ذبولٌ يطوقُ زهرةَ عُمرك","https://www.poetsgate.com/ViewPoem.aspx?id=175268",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["وَهَوَت بِهِ أَيدٍ أَنامِلُها القَنا","مَهوى كُلَيبٍ عَن يَدي جَساسِ",0,"س",1,0],["وهو تجديد قوةٍ ونشاطٍ","لجسوم روازح أطلاح",1,"ح",1,0],["وَهوَ تُربُ الإِنسانِ مُنذُ اِستَ","وى في الأَرضِ حَيّاً يَمشي عَلى خُطُواتِه",2,"ت",2,0],["وهو تنين رمزهم","وبه زوسم شهر",3,"ر",1,0],["وَهَوَت بِكلكلها عَلى أَعدائِها","وَتَفَرَغَت مَصرٌ لِمَن يَتَنَمرَد",4,"د",1,0],["وهوت غلى الدرك السحيق وقادها","في الغي شرذمة من الأوغاد",5,"د",1,0],["وهوتْ إليه أسِنَّة وأسِرَّة","ومواكبٌ وكتائبٌ وكتابُ",6,"ب",1,0],["وهَوَت كرامتٌ تولَّت أمرها","خِططٌ ، تولَّى امَرها إحكام",7,"م",1,0],["وهو ترب الإنسان منذ استوى","في الأرض حيا مشى على خطواته",8,"ت",2,0],["وهوْت من الجوزاء مِنْطقَةٌ","زهراءُ لم تُعقد على خصرِ",9,"ر",1,0],["وهوت بنو أَسَدٍ تَسُلُّ لقاحَها","فتسيل بين الحَزْنِ فالصَّمّانِ",10,"ن",1,0],["وَهَوَتْ لِتغْرِبَ فَانْثَنى","عَنْها بِمَغْرِبِها ابْتِسامُ",11,"م",1,0],["وهوت فوق تربة الوطن الغالي","بسهم أصابها بالجنان",12,"ن",1,0],["وهوت كما تهوى الكواكب","بعد إشراق وومض",13,"ض",1,0],["وهو تحت الغوطةِ الز","زَرقاءِ خافٍ مُتخبّي",14,"ب",2,0],["وهوت نجومُ المشرفية ف","ي البروج من الترايك",15,"ك",1,0],["وهوَتْ عواليه الطِعانَ فأوشَكَتْ","قبلَ الصّدورِ زجاجُها أن تطعَنا",16,"ن",2,0],["وهَوَت أَودٌ وَلِلسُمرِ بِنا","في سَبابِ القَومِ قَصدٌ وَاِنكِسارُ",17,"ر",1,0],["وهو تصديق وإذعا","ن وتسليم متين",18,"ن",1,0],["وَهَوت منَ الإسلام أيّ دعامة","لمّا هَوى وتضعضع البنيانُ",19,"ن",1,0],["وهوت دعامات العلى","بعد الصعود إلى النرول",20,"ل",1,0],["وهو تغير لمشبه علم","وهكذا الإقعاد فيها أن تتم",21,"م",1,0],["وهوت بدور المجد وان","دكّت معالمها القويمه",22,"م",2,0],["وهوت ربوع العلم والحلم انقضت","أيامه وطوتهما الدهناء",23,"ا",2,0],["وهوت نجوم الياسمين فخلتها","درراً تفرقها يد النسمات",24,"ت",1,0],["وهوت كواكبه تشق بجندها","حجب الظلام وترتمي لغروب",25,"ب",1,0],["وهوت على مَهدِ السَّقَامَ عَليلةً","تَشكُو الذي يَبدُو وتكتمُ ما اختَفَى",26,"ا",1,0],["وَهَوَتْ بِأملاكِ الطَّوائِفِ بَعْدَمَا","سَقَطَ الخَلاَئِفُ في فضَا البُرْناس",27,"س",1,0],["وهو تطليقٌ إذا ما لم تكن","فديةٌ في الخلعِ فافهم واسمعا",28,"ع",2,0],["وهوت لذا اركانهم حتى بقوا","صرعى سكارى غير شرب ندام",29,"م",1,0],["وَهَوَت ذُروَةُ العُلى فَبَناها","بِالصَقِيلَينِ عَزمِهِ وَحُسامِه",30,"م",2,0],["وهو تذكار سلام مقبلِ","وجمال كاملٍ مستقبل",31,"ل",1,0],["وهو تعالى نقصه محال","وواجب في حقه الكمال",32,"ل",1,0],["وهو تعالى مينه محال","فصح بالدليل الاستدلال",32,"ل",1,0],["وهوت الى حضنِ المياه فضمّها","موجٌ يجيء على المياهِ ويذهبُ",33,"ب",1,0],["وهوت يوم هوى فانكدرت","لم نجد من بعده سلوى فبعدا",34,"د",2,0],["وهوَت بسعدٍ بعد طول جهادهِ","فاِنهدَّ ركنُ النيل لمّا أدبَرا",35,"ر",2,0],["وهو تلميذ الامام الاسجي","العالم الحبر السري النهج",36,"ج",1,0],["وهوت له شهب السماء بقوسها","وأطاعه الاصباح والامساء",37,"ا",2,0],["وهوت كما انهالت على وجه الثرى","من صم شاهقة الذي هضباتها",38,"ت",3,0],["وهوت هذه كجلمود صخرٍ","حطه السيل والضلال مبير",39,"ر",1,0],["وهو تَرجُمان اللَهِ بل قَهرَمانُهُ","وقِسطاسُهُ الحقُّ المُقامُ بهِ العدلُ",40,"ل",1,0],["وهوت إلى الدركات من عليائها","لما تولى الغاصبون زمامها",41,"م",3,0],["وهوت أشلاؤهم حمراً","كحمر ثاويه",42,"ه",1,0],["وهوت برمضاء الهجير فظللت","أشلائها شجر الرماح الشرع",43,"ع",1,0],["وهوَت إلى دَرَك الشقاء تجمّداً","أُممٌ أطالت في السكون منامَها",44,"م",3,0],["وهوَت بفأسِ وضيعِ قومٍ","لِيهُدَّ أسقفَها الرفيعة",45,"ع",2,0],["وهوت معاطفها تميل مع الهوى","وأحر أحشاءي بنار الهاوية",46,"ي",2,0],["وهوت بصدمته حصون تجلدي","وعدت عليَّ من الهموم عوادي",47,"د",2,0],["وَ هَوَتْ عَلَىْ جَيْشِ الْعَدُوِّ ، وَ نَوَّرَتْ","لَيْلَ الْعِرَاْقِ بِقَاْطِعٍ وَقَّاْدِ",48,"د",1,0],["وهو تاج الملوك فالملك العاطل","حال به على كل حال",49,"ل",1,0],["وهوت فيهم كما انقض نسرٌ","يخبط الأرض مثخناً بالجراح",50,"ح",1,0],["وهوَتْ نجمة ُالحنانِ ابتهاجاً","تنشرُ الشوقَ في الترابِ غراما",51,"م",2,0],["وهوت إلى دارك الجحيم عصائب","غلبت عليهم شقوة وبلاء",52,"ا",2,0],["وهوتْ «مُراكشُ» حولَه وتألمّتْ","«لبنانُ»، واستعدى جديسَ وتُبَّعا",53,"ع",2,0],["وهوت قلاعٌ في الخليج وتونسٍ","والأرز أصبح موقدَ الإحراقِ",54,"ق",1,0],["وهوتْ زهورُ العمرِ حينَ ذبولِهِ","فمضيتَ لم تُكملْ حصادَ فصولِهِ",55,"ل",2,1],["وهوت عقول شعبنا صرعى ترى","أن الظلام كومضة الإصباح",56,"ح",1,0],["وهوت بعرش طالما","آوى العداوة والضغينة",57,"ن",2,0]]}