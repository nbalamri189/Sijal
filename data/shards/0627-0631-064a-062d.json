177123",""],[4959,"أَهْلَاً بِكَ يَا شَهْرَ الصِّيَام","https://www.poetsgate.com/ViewPoem.aspx?id=211445",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5174,"لغتنا والمساكين","https://www.poetsgate.com/ViewPoem.aspx?id=208528",""],[5213,"خليلي هل يدنو من الحي شاسعه","https://www.poetsgate.com/ViewPoem.aspx?id=170502",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[3294,"أتعلم أيها السيف الصقيل","https://www.poetsgate.com/ViewPoem.aspx?id=173273",""],[5542,"غدا يتحدث الرطب","https://www.poetsgate.com/ViewPoem.aspx?id=10030",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[5725,"الا ياسليمى","https://www.poetsgate.com/ViewPoem.aspx?id=178415",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6078,"بصماتٌ على جدارِ الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=203265",""]],"verses":[["أَرى حُبَّيكِ يَنمي كُلَّ يَومٍ","وَجَورُكِ في الهَوى عَدلٌ فَجوري",0,"ر",2,0],["أَرَى حُمُراً تَرعَى وَتُعلَفُ ما تَهوى","وَأُسداً جِياعاً تَظمَأُ الدَّهرَ لا تُروى",1,"و",2,1],["أرِيحُوا فقَدْ يمّمْتُمْ حَضْرَةَ النّدى","وأوْرَدْتُمُ في مَوْرِدِ الرِّفْقِ والرِّفْدِ",2,"د",1,0],["أَريَحِيٌّ صَلتٌ يَظَلُّ لَهُ القَو","مُ رُكوداً قِيامَهُم لِلهِلالِ",3,"ل",1,0],["أُريحَ فُؤادُكَ مِمّا ضَناهُ","وَصَدرُكَ مِمّا عَلَيهِ اِنكَدَر",4,"ر",1,0],["أَريَحِيٌّ إِذا هَمَت راحَتاهُ","عَلَّمَت واكِفَ الحَيا كَيفَ يَندى",5,"د",2,0],["أَرى حينَ زالَت عيرُ سَلمى بِرابِغٍ","وَهاجَ القُلوبَ الساكِناتِ زَوالَها",6,"ل",3,0],["أَرْيَحِيٌّ يُصِيبُ قِسْطاً كَبِيراً","مِنْ نَدَاهُ الحَرِيبُ وَالمَحْرُومُ",7,"م",1,0],["أريحيّ من الملوك أريبٌ","فائض البحر ذو عجائب كثر",8,"ر",1,0],["أرْيَحيٌّ بمثلهِ يُبْتنى المج","دُ وتسمو به فروعُ البناءِ",9,"ا",2,0],["أَرْيَحيٌّ له إذا جَمَدَ الكز","زُ بَنانٌ تذوبُ للمستذيبِ",10,"ب",1,0],["أرَيْحَانَةَ العَيْنَينِ والأَنْفِ والحَشا","ألا لَيْتَ شعري هَلْ تغيَّرْتَ عن عهدي",11,"د",2,0],["أريحيٌّ مُلحَّظٌ في النوادي","للأيادي يهزُّك التلحيظ",12,"ظ",1,0],["أريحيٌّ تخاف بائقة الطو","فان من بطن كفه أن تبوقا",13,"ق",2,0],["أريحيٌّ يعطي العطية في العط","لة أضعافَ أختها وهْو والِ",14,"ل",1,0],["أريحيٌّ معطي العطية في العُط","لةِ أضعافَ أختها وهْو والي",15,"ل",2,0],["أَريحُ أَريجَ المِسكِ في عَرَصاتِها","وَإِن لَم أُرِح مَروانَ فيها وَلا لَخما",16,"م",2,0],["أَرى حُلَلاً مَطَوّاةً حِساناً","عَداني أَن أَراكَ بِها اِعتِلالي",17,"ل",2,1],["أُريحتْ عليه ثَلَّةُ المجدِ إذْ غَدا","لها من معينِ الملْكِ زندٌ وساعِدُ",18,"د",1,0],["أَريَحِيّاتُ صَبوَةٍ وَمَشيبُ","مِن سَجايا الأَريبُ شَيئاً عَجيبُ",19,"ب",1,1],["أَريَحِيٌّ يَشيدُ نائِلَهُ البِش","رُ إِذا ما نَعى النَوالُ القُطوبُ",20,"ب",1,0],["أَرى حاجَتي يَدنو إِلَيها مَنالُها","فَإِن مُدَّتِ الأَيدي إِلَيها تَعَلَّتِ",21,"ت",1,0],["أَريَحِيٌّ إِذا غَدا صَرَّفَتهُ","شِيَمُ المَكرُماتِ حَيثَ يُريدُ",22,"د",1,0],["أَريَحِيٌّ لَهُ عَلى مُجتَديهِ","رِقَّةُ الوالِدِ الرَحيمِ الرَؤوفِ",23,"ف",1,0],["أَريحِيٌّ إِمّا يُوافِقُ ما تَه","وى وَإِمّا يَكفيكَ حَربَ الخِلافِ",24,"ف",1,0],["أَرى حُبَّ لَيلى لا يَبيدُ فَيَنقَضي","وَلا تَلتَوي أَسبابُهُ فَتَحَلَّلُ",25,"ل",1,0],["أَريَحِيٌّ إِذا تَهَلَّلَ لِلجو","دِ أَضاءَت طَلاقَةٌ وَقَبولُ",26,"ل",1,0],["أَرى حَوزَةَ الإِسلامِ حينَ وَليتَها","تُخَرِّمَ باغيها وَحيطَ حَريمُها",27,"م",3,0],["أرى حاجتي لم يَنأَ منها أوائلٌ","فكيفَ نأى منها عليَّ الأواخِرُ",28,"ر",1,0],["أَرى حُمُراً تَرعى وَتَأكُلُ ما تَهوى","وَأُسداً جِياعاً تَظمَأُ الدَهرَ ما تَروى",29,"و",2,1],["أَرى حَرباً مُغيّبةً وَسِلماً","وَعَهداً لَيسَ بِالعَهدِ الوَثيقِ",30,"ق",1,1],["أُريح أقداماً وهت من عياء","وأرقب العالَم من مجلسي",31,"ي",1,0],["أَريَحِيٌّ حُلْوُ الشَّمائِلِ تَجري","بَينَ أَخلاقِهِ شَمُول العقارِ",32,"ر",1,0],["أريحيٌّ بجودِها راحتاه","بَخَّلَتْ صَوْبَ كلِّ غيثٍ هتونِ",33,"ن",1,0],["أَريَحِيّاً مُساعِداً","غَيرَ نِكسٍ وَلا بَرِم",34,"م",1,0],["أَرى حَسَبي لا يَستَطيعُ كِفاءَهُ","عَلى أَنّني أَهفو لَهُ وَأَريعُ",35,"ع",1,0],["أَريحوا البِلادَ مِنكُمُ وَدَبيبُكُم","بِأَعراضِنا فِعلُ الإِماءِ العَواهِرِ",36,"ر",1,0],["أَريَحِيٌّ إِلى المَحامِدِ يَهتَز","زُ اِهتِزازَ المُهَنَّدِ المَشهورِ",37,"ر",1,0],["أَرى حاجَتي عِندَ الأَميرِ مَريضَةً","فَهَلّا تُداويها وَأَنتَ طَبيبُها",38,"ه",2,0],["أَريَحِيٌّ لَهُ يَدٌ تُمطِرُ النَي","لَ وَأُخرى سُمٌّ عَلى الأَعداءِ",39,"ا",2,0],["أَرى حُسنَ الشَمائِلِ مِنكَ حَثَّت","عَلَيهِ الأَيمَنُ المُتَوَسِّداتُ",40,"ت",1,0],["أَرى حَيوانَ الأَرضِ غَيرَ أَنيسِها","إِذا اِقتاتَ لَم يَفرَح بِظُلمٍ وَلا جَدا",41,"د",2,1],["أَرى حُسنَ البَقاءِ لِمَن يُرَجّي","فَلاحاً أَو بِهِ رَجُلٌ يَعيشُ",42,"ش",1,1],["أَرى حَيوانَ الأَرضِ يَرهَبُ حَتفَهُ","وَيُفزِعُهُ رَعدٌ وَيُطمِعُهُ بَرقُ",43,"ق",1,0],["أَرى حَلَباً حازَها صالِحٌ","وَجالَ سِنانٌ عَلى جِلَّقا",44,"ق",2,0],["أَرى حَبلاً حادِثاً في النِسا","ءِ حَبلَ أَذاةٍ بِهُنَّ اِتَّصَل",45,"ل",1,1],["أَريحانتي قَد طالَ رقدك فاِيقظي","أريحانتي من أَكثر النوم يصدع",46,"ع",1,0],["أَريحانتي ما بال خدك ذابِلاً","وَعَهدي به بالأمس ريان ينصع",46,"ع",1,0],["أَريحانَتي إنا قتلناك ليتَني","هلكت وَما أَبصرت غصنك يهزع",46,"ع",1,0],["أرى حُلفاء الأمْس لم يَحْفِلوا به","وما زال من خُلْفِ الوعودِ يعاني",47,"ن",2,0],["أَرَى حُمُراً فَوْقَ الصَّواهِلِ جَمّةً","فأَبْكي بعَيْنِي ذُلَّ تِلْكَ الصَّواهِلِ",48,"ل",1,0],["أَرْيَحِيٌّ يَهْتزُّ لِلعَمَلِ الطَّيِّ","بِ مِنْ نَفْسِهِ بِلاَ إِغْرَاءِ",49,"ا",2,0],["أرْيَحِيٌّ؛ يكاد يمنح أرْبَا","ب الخطايا صلاتَهُ، وصِيَامه",50,"م",2,0],["أرَى حاجَتي يدنُو إليْكَ منالُها،","فإنْ مُدّتِ الأيْدي إلَيْها تَعَلّتِ",51,"ت",1,0],["أريحيات صبوة ومشيب","من سجايا الأريب شيء عجيب",52,"ب",1,1],["أريحيّ تكاد نورق بالنعمى","لأعدائه القنا والنصول",53,"ل",1,0],["أَرْيَحيٌّ له إذا حَمَدَ الكزْ","زُ بَنانٌ تذوبُ للمستذيب",54,"ب",1,0],["أَريحيّ لَهُ مِن الشَرَف الصَد","ر وَباقي الأَنام صَف النِعال",55,"ل",1,0],["أرى حسراتٍ في النفوسِ تهافتتْ","لها قطعُ الأحشاءِ من كلِّ جانبِ",56,"ب",1,0],["أرى حُبِّيكَ فيه ضروب عقلٍ","وحُبُّ الناس ضربٌ من جنونِ",57,"ن",1,0],["أريحيّ الطباع فاض سناه","كالذي يصنع الحسام الفرند",58,"د",1,0],["أَريَحِيٌّ لِلمُرَجّي","جودَهُ فَوزُ القِداحِ",59,"ح",1,0],["أرِيحُ الصَّبا هَبَّتْ عَلَى زَهرِ الرُّبَا","فأصْبَحَ منها كلُّ قُطْرٍ مُطَيَّبا",60,"ب",2,1],["أَريَحَيٌّ أَمضى عَلى الهَولِ مِن لَي","ثٍ هَموسِ السُرى أَبي أَشبالِ",61,"ل",1,0],["أرى حبّه فرضاً عليّ ومذهبي","هواه وإنّي فيه بالحبّ أشطحُ",62,"ح",1,0],["أرى حبّي شراراً مُستَطيرا","فَخافي أن ترَي مِنهُ سعيرا",63,"ر",2,1],["أرى حُسنكِ الفتانَّ يبدو لناظري","كبرقٍ ولا يُبقي سوى الحسرات",64,"ت",1,0],["أرى حُلَلَ النَّباهَةِ قَدْ أَظَلَّتْ","تُنازِعُ فِيَّ أَطْمارَ الْخُمُولِ",65,"ل",1,0],["أَريَحِيّاً فَرعاً وَمَعقِلَ عِزٍّ","قَصُرَت دونَهُ طِوالُ الجِبالِ",66,"ل",1,0],["أَريحيٌّ لَو حاتمٌ ضَنَّ بِالتُر","ب لَأَمسى بِالتبر غَير ضَنينِ",67,"ن",1,0],["أَريحيٌّ مَتى بِنا نوديَ النا","دي لِبَذل النَدى دَعونا نَواله",68,"ل",2,0],["أَرى حَمامَ الحِمى غَنَّت سَواجعه","فَأَعرَبَت لَحن دَهر كادَ يضمرهُ",69,"ر",2,0],["أَرى حزبكم بِالقُرب قَد بَلغ المُنى","وَلَم يَك حَظّي بَعدَ فَرضي سِوى النَدبِ",70,"ب",1,0],["أَريحيّ كَم حبا مننا","من ندىً جادَت بواكرُه",71,"ر",2,0],["أَريحيّ كَم حبا مننا","من ندىً جادَت هَواطلُه",72,"ل",2,0],["أَريحيّ كَم حَبا مننا","من ندىً جادَت سحائبُه",73,"ب",2,0],["أَريحيّ كَم حَبا مِننا","غَير مَغبون بِما اِكتَسَبا",74,"ب",2,0],["أريحيٌّ لم يزل متخذاً","دأبَ المعروف والإحسان دابا",75,"ب",2,0],["أريحيٌّ تهدى إليه القوافي","والقوافي لمثل علياه تهدى",76,"د",2,0],["أَريحيٌّ بنى له الجودُ بيتاً","قد أَطافَ الورى به تعظيما",77,"م",2,0],["أريحيٌّ مهذّبٌ أصمعُ القل","بِ وفيٌّ بالعهد والميثاقِ",78,"ق",1,0],["أريحيّ يرى المدائح والشك","ر من الخلق جنّة وحريرا",79,"ر",2,0],["أريحي الوجا يا ناق ما بعد ذا وجا","فقد نلت ما نلناه من مقتضى الرجا",80,"ج",2,1],["أريحوا الوجا بع الوجا عند كوك","على رأسه من نور شمس الضحى أسنى",81,"ن",2,0],["أَريَحِيٌّ إذا ذكرتَ الندى أص","غى بِأُذْنَيه مُخلِياً لك فهمَهْ",82,"م",2,0],["أريحيٌّ