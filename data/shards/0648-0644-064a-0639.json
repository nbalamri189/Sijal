{"poems":[[53,"لحيا عهدهن حيا العهاد","https://www.aldiwan.net/poem30619.html","الوافر"],[63,"هي النفس في مستنقع الموت تبرك","https://www.aldiwan.net/poem45893.html","الطويل"],[55,"كذبت على نفسي فحدثت أنني","https://www.aldiwan.net/poem26221.html","الطويل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[88,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[47,"أيلحاني على العبرات لاح","https://www.aldiwan.net/poem25341.html","الوافر"],[72,"قاضي القضاة بيمنى حكمه القلم","https://www.aldiwan.net/poem19672.html","البسيط"],[51,"على عاقد الزنار تحت قضيب","https://www.aldiwan.net/poem8643.html","الطويل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[70,"لعلك تصغي ساعة وأقول","https://www.aldiwan.net/poem42763.html","الطويل"],[66,"وحقك إني قانع بالذي تهوى","https://www.aldiwan.net/poem38475.html","الطويل"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[80,"ولي عصا من طريق الذم أحمدها","https://www.aldiwan.net/poem31280.html","البسيط"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[44,"أيا زينة الدنيا وجامع شملها","https://www.aldiwan.net/poem29990.html","الطويل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"ألا ترى ما أعطي الأمين","https://www.aldiwan.net/poem66135.html","الرجز"],[46,"تنافس قوم على رتبة","https://www.aldiwan.net/poem22379.html","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16705","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43858","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[115,"شهامة الطبع قادتني إلى الأدب","https://www.aldiwan.net/poem41721.html","البسيط"],[115,"رعى الله أياما تقضت بشيخون","https://www.aldiwan.net/poem41763.html","الطويل"],[132,"ألا عج من حيازيم المطي","https://www.aldiwan.net/poem54681.html","الوافر"],[143,"أرقدت عن قلق الفؤاد مشوقه","https://www.aldiwan.net/poem11787.html","الكامل"],[143,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[160,"الحمد لله حمدا ليس يحصيه","https://www.aldiwan.net/poem58981.html","البسيط"],[166,"أجدك ما ينفك قلب محبس","https://www.aldiwan.net/poem47039.html","الطويل"],[169,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[169,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[186,"لاح المشيب فأبكاني على زمن","https://www.aldiwan.net/poem43445.html","البسيط"],[212,"فلي كبد ما انفك عنها غليلها","https://www.aldiwan.net/poem37837.html","الطويل"],[235,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[235,"خليفة الله أنت في الدين وال","https://www.aldiwan.net/poem31824.html","المنسرح"],[235,"وأقسم لو سمتني أن تنال","https://www.aldiwan.net/poem31920.html","المتقارب"],[235,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[235,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[275,"يفندني في العامرية لومي","https://www.aldiwan.net/poem25519.html","الطويل"],[275,"تمكن من مسامعه العذول","https://www.aldiwan.net/poem25544.html","الوافر"],[280,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[280,"سقوه كأس فرقتهم دهاقا","https://www.aldiwan.net/poem60789.html","الوافر"],[320,"يا حظ مصر فقد جاد الزمان لها","https://www.aldiwan.net/poem67226.html","البسيط"],[326,"ولي عند رؤيته روعة","https://www.aldiwan.net/poem44247.html","الخفيف"],[348,"ولي عليه أدام الله دولته","https://www.aldiwan.net/poem20431.html","البسيط"],[349,"سواي لميل الحب عنه يفاسخ","https://www.aldiwan.net/poem15565.html","الطويل"],[353,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[361,"سوى الحب من دنياكم لست أطاب","https://www.aldiwan.net/poem68133.html","الطويل"],[366,"نعم يعرف الحق الجلي ويصدف","https://www.aldiwan.net/poem17036.html","الطويل"],[380,"ترى عندكم في الحب بعض الذي عندي","https://www.aldiwan.net/poem49198.html","الطويل"],[391,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[402,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[405,"للمرء من شهوته آمر","https://www.aldiwan.net/poem49378.html","السريع"],[416,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[432,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[439,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[458,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[458,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[458,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[464,"شغفي بأعطاف الغصون الهيف","https://www.aldiwan.net/poem3453.html","عموديه"],[468,"لنا أخ من أتى إليه","https://www.aldiwan.net/poem59545.html","مخلع البسيط"],[500,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[504,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[538,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[551,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[562,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"يقولون لم خلى هواه فلانه","https://www.aldiwan.net/poem2849.html","الطويل"],[575,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[575,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"]],"verses":[["وَلي عَزمٌ تَعوذُ بِهِ العَوالي","إِذا فَزِعَت إِلى مُهَجِ الأَعادي",0,"د",2,0],["وَلي عَزَماتٌ يَعْلَمُ القِرْنُ أَنَّها","بِهِ قَبْلَ تَجْريدِ الصَّوارِمِ تَفْتكُ",1,"ك",1,0],["وَلي عَبرَتانِ ما تُفيقانِ عَبرَةٌ","تَفيضُ وَأُخرى بِالصَبابَةِ تُخنَقُ",2,"ق",1,0],["وَليَعلَمَ الغَربُ أَنّا","كَأُمَّةِ اليابانِ",3,"ن",1,0],["ولي عند أخوان الصفا أريحيّة","إلى كل خلّ في الزمان موافق",4,"ق",1,0],["وَلي عِندَ العُداةِ بِكُلِّ أَرضٍ","دُيونٌ في كَفالاتِ الرِماحِ",5,"ح",1,0],["ولىّ عليّ ووافى بعد مشبهه","كالسّيل أقبل لما ولّت الدّيم",6,"م",1,0],["ولي عَبرةٌ موصولةٌ بنحيبِ","ونفسٌ عليه الدهرَ ذاتُ وجيبِ",7,"ب",1,0],["وليعلم الناسُ أنني رجل","ورّادُ هيجاءَ غيرُ ورّاش",8,"ش",1,0],["وليعدل الجائرون عن قُحمٍ","بمن أتاها مَحيقُ حائقها",9,"ق",3,0],["ولي عِرضٌ تكانفهُ لسانٌ","كأنّ كليهما سيفٌ صقيل",10,"ل",1,0],["وَلي عِندَ بَعضِ الناسِ قَلبٌ مُعَذَّبٌ","فَيا لَيتَهُ يَرثي لِذاكَ وَيَرحَمُ",11,"م",1,0],["وَلي عِندَكُم قَلبٌ أَضَعتُم عُهودَهُ","عَلى أَنَّهُ جارٌ لَكُم وَنَزيلُ",12,"ل",1,0],["وَلِيٌّ عَنِ الفَحشا سَريعٌ إِلى النَدى","بَعيدٌ عَنِ المَرأى قَريبٌ مِنَ النَجوى",13,"و",2,0],["ولَّى عن الأيك الفخو","ر به إلى عرضِ الفضاء",14,"ا",2,0],["ولي عصا من طريق الذمّ أحْمَدُها","بها أُقدّمُ في تأخيرها قدمي",15,"ي",1,1],["ولي عزمة لم تبعْ في السُّرَى","نشاط السّهادِ بنومِ الكسلْ",16,"ل",1,0],["وَلي عَزْمَةٌ لا يَطْبَعُ القَيْنُ مثلَها","وَلَو أَنَّهُ في الغمدِ لِلهامِ فَصّالُ",17,"ل",1,0],["وَلي عِدَةٌ قَد راثَ عَنّي نَجاحُها","وَمَجدُكَ أَدنى رائِدٍ في اِقتِضائِها",18,"ا",3,0],["وَلّى عَلى كُرهٍ وَبَينَ ضُلوعِهِ","وَجدٌ يُغالِبُهُ عَلى السُلوانِ",19,"ن",1,0],["وليَعْبُدُوا غيرَ المسيحِ فليس في","دينِ الترَهُّبِ بعدها تأمِيل",20,"ل",1,0],["وَلِيُّ عَهدٍ ما لَهُ قَرينُ","وَلا لَهُ شِبهٌ وَلا خَدينُ",21,"ن",1,0],["وَلي عَمَلٌ كَجَناحِ الغُرابِ","أَو جِنحِ لَيلٍ إِذا مارَتَب",22,"ب",1,0],["ولي عَجَبٌ من مُشْتَراةٍ بِهَجْمَةٍ","جُمِعْنَ خِياراً وهْيَ تُجْمَعُ في هَجْم",23,"م",1,0],["وَلْيَعْلَمِ النَّاسُ فِي اَقْصَى البَسِيطَةِ مَا","قَدْ أحْرَزُوهُ لَهُ عِزَّا وتَوْطِيدَا",24,"د",2,0],["وَلَيَعْلَمَنَّ النَّاسُ بَعْدَكَ أَمْرَهُمْ","فَتُلاَمُ مَا طَالَ المَدَى وتُؤَنَّبُ",25,"ب",1,0],["وَليَعْصِمَنْكَ الْيَوْمَ مَا","نَهْنَهْتَ عِلْماً مِنْ نُهَاكْ",26,"ك",1,0],["ولّى عَلى حين شَدَّ عضدي","وَهوَ بِقَلبِ الكَظيمِ ثاوِ",27,"و",1,0],["ولْيَعِشْ للبِلادِ فاروقُ مِصْرٍ","قُدْوَةَ الناهِضِينَ رَمْزَ الأمَاني",28,"ن",2,0],["وليعلَمِ الثَّقلانِ: أنَّا لم نَزَلَ","نَحْمِي، كما حَمَتِ الجدودُ الغِيلا",29,"ل",2,0],["وليعبدوا غير الميح فليس فى ... د ين الترهب بعدها تأ ميل","أهل الفرار فليت شعرى عنهم ... هل حدثوا أن الطباع تحول؟",30,"ل",1,0],["ولي عن الغير تجريد ولي همم","تعلو بأن تنسب التأثير للسبب",31,"ب",1,0],["ولي عريض الجاه شهم مكرم","غيور شديد الباس غوث المساكين",32,"ن",1,0],["وَلَىٍّ عَالِمٍ حَبرٍ شَرِيفٍ","لَهُ اجتَمَعَت كَرَاماتُ الوَلِيِّ",33,"ي",1,0],["وَليَعتَصِم بِمُمَلَّكٍ قَهَرَ العِدى","حَتّى لَدانَ عَدُوُّهُ لِصَديقِهِ",34,"ق",2,0],["وَليَعلَموا أَنَّ النَجابَةَ خَلَّةٌ","خَصَّ الإِلَهُ بِنيلِها الأَتراكا",35,"ك",2,0],["وَليُعلِماهُ بِأَنَّ هَذي هُدنَةٌ","أَضحَت لِمَلكِهِمُ المَروعِ مِلاكا",35,"ك",2,0],["وليعتصم منه بالتقوى محاربه","فانها منه قبل الأسر تنجيه",36,"ي",2,0],["ولي عَبَراتٌ فوقَ خَدِّي رواقصٌ","ولي حَسَراتٌ تحتَ ضلعي قَوارِصُ",37,"ص",1,0],["وَلِي عَزمَةٌ إِن ساعَدَ الجدُّ أَشرَقَت","وَنافَت عَلى شُمِّ الرِعانِ الشَوامِكِ",38,"ك",1,0],["وَلِي عَن مَكانِ الذُلِّ مَنأىً وَمَرحَلٌ","وَذا الناسُ في الدُنيا غَريبٌ وَآهِلُ",39,"ل",1,0],["ولّى عليّ حروبا إن فجعت به","عند الوفاة إذا فارقت مأمولي",40,"ي",1,0],["ولي عَبْرةٌ طولَ الزمانِ أصونُها","وها أنا في الأهواءِ كُرْهاً أذيلها",41,"ل",3,0],["وَلّى عَلى الأَعقابِ يَجمَعُ نَفسَهُ","كَالأُفعَوانِ اِنسَلَّ مِن خِرشائِهِ",42,"ا",3,0],["وَلي عِيالٌ لا دَرَّ دَرُّهُمُ","قَد أَكَلوني دَهري وَما شَبِعوا",43,"ع",3,0],["وَلي عِندَ أَيّامِ دَهري المَشومِ","وُعودٌ مِنَ الحَظِّ لَم تُنجَزِ",44,"ز",1,0],["وَلّى عَلى أَعقابِها كُلُّها","طَريدَةً وَالكَلبُ مَطرودُ",45,"د",1,0],["وَلي عَلَيهِم فَضيلَةُ السَبقِ في","مَدحِكَ فَاِعرِف سَبقي وَتَعقيبي",46,"ب",2,0],["ولِي عِنْدَ لُبْنَى لَوْ تَسَنَّى لُبَانَةٌ","أزَجِّي إلَى مَاذِيِّهَا كُلَّ عَلْقَمِ",47,"م",1,0],["ولِي عَزْمٌ على تَقْبِيل فِيها","سَأُمْضيهِ وإنْ أنِفَ القَبيلُ",48,"ل",1,0],["وَلِي عِنْدَ الزَّمانِ مُطالَباتٌ","فَما عُذْرِي وَأَنْتَ بِها كَفيلي",49,"ل",2,0],["وَلي عَزْمٌ أَنَالُ بِهِ انْفِتاحاً","لِبابِ الْمَجْدِ إِنْ خِفْتُ انْغِلاقا",50,"ق",2,0],["وَلِيُّ عَهدٍ إِلى المُلكِ المَصونِ بِهِ","تَشتَدُّ أَزراً وَتَستَبقي الوَلاءَ لَها",51,"ه",2,0],["وَلي عِندَ رُؤيَتِهِ رَوعَةٌ","تُحَقِّقُ ما ظَنَّهُ المُتَّهِم",52,"م",1,1],["وَلي عليهِ أَدامَ اللَّهُ دَولتَهُ","رَسْمٌ سَفَرْتُ بهِ والوَقْتُ قَد أَزِفَا",53,"ف",2,1],["وَلي عَلَمٌ فيهِ وَعِلمٌ بِباطِنٍ","لَظاهِرِهِ طَودٌ عَلى العَقلِ شامِخُ",54,"خ",1,0],["وَلي عَجَب مِن عادل القَدّ ظالمٍ","يَجور وَما لي مِن جَفاه مجيرُ",55,"ر",1,0],["وَلي عفة أَرجو بِها نَيل مطلبي","اذا عَز يَوماً في المَحَبَّةِ مَطلَب",56,"ب",1,0],["وَلي عَطفَةٌ مِنهُ وَلي مِنهُ رِقَّةٌ","كَما البيضُ رَقَّت وَالقِسِيُّ تَعَطَّفُ",57,"ف",1,0],["وَلي عِندَهُم قَلب يُعذب بِالجَفا","وَفي أَضلُعي قَلبٌ يَذوب مِن البُعدِ",58,"د",1,0],["وليعتمد عليه في جميع","أموره من هين أو رفيع",59,"ع",1,0],["ولي عاذلانِ على مالِكي","فهذا نكيرٌ وذَا مُنكرُ",60,"ر",1,0],["وليعرف اللّه بأفعالِهِ","وليعرِف الأَفعالَ باللّهِ",61,"ه",1,0],["ولي عَبرة لم ترقا عند ادّكاره","كما لي فيه عبرة المتفكر",62,"ر",1,0],["ولي عندَ زَوْرِ الطيفِ من طيبِ نَشْرِها","ومن فيضِ دمعي روضةٌ وغَديرُ",63,"ر",1,0],["ولْيعلمِ الأَقرانُ حينَ تدِبُّ لي","تَحْتَ الوغى أَنِّي لَحِقْتُ بِصَفِّهِ",64,"ف",2,0],["وليَعْمُرَنَّ بذكرِ مجدِكَ أَعصُراً","ويُبَشِّرَنَّ بطولِ عمرِكَ أزمنا",65,"ن",2,0],["وليعطينَّك حقّ سبقك قاضياً","دَينَ الوفاء ودينُهُ ممطولُ",66,"ل",1,0],["ولي عوائدُ جُودٍ منك لو طَرَقت","سَتامُ مُلكَكَ لم تُحرَمْ ولم تخِبِ",67,"ب",1,0],["ولي عزمةٌ في ضمانِ القبولِ","سَتُدْرِكُ إن ساعدتني هُبوبا",68,"ب",2,0],["ولَّى عن جفني السهادَ فكيف لا","أبكي لياليَ غمضيَ المصروفِ",69,"ف",1,0],["وَلّى عَلى ما لِهِ نَداهُ","فَاَخرَجَ الأَمرَ عَن يَدَيهِ",70,"ي",2,0],["ولي على كلِّ محلٍّ خيَّموا","به مماتٌ مُقَلِقٌ ومصْرَعُ",71,"ع",1,0],["ولي على اهل الولاية فايق","على إلى اعلا المدارج نايل",72,"ل",1,0],["وَلي عَوائدُ مِنهُم بِالجَميل لَها","بمنهم اِتصالٌ غَيرُ مُنحَسِمِ",73,"م",1,0],["وليَعفُ مولانا ويصفَحُ إن أكُن","أقدَمتُ عما كنتُ عنه أُحجِمُ",74,"م",1,0],["ولِي عِوَضٌ بوجوهِ الصّوا","بِ مُشرقةً عن وجوه الحِسانِ",75,"ن",1,0],["وليُّ عهدٍ أميرُ المؤْمنينَ فَرَت","بعزمهِ بيضُ أُسْدٍ أسوَدَ القِمَمِ",76,"م",1,0],["وليعلم الماضي ويدري الباقي","بأنه قدم لاتسحقاق",77,"ق",1,0],["ولي عند ذكراهُ خيولٌ سوابقٌ","من الدَّمع ما هَيَّجتُها بِحِرَانِ",78,"ن",1,0],["ولي عِدىً أَنفاسُهم","كالسُّمِّ والسُّمُومِ",79,"م",1,0],["وَلِي عَنْ وِصَالِ الحَاجِبيَّةِ حَاجِب","مِن الْعَيْشِ صَدَّ الْقَلْبَ أَنْ يَنْقَع الصَّدى",80,"د",2,0]]}