185,"د",3,0],["وليعلموا انّ العراق له صدى","فوق المدى مثل الردى لايثلمُ",186,"م",1,0],["وليعلموا انا اذا ما ازلفت","نحو العلى ارواحنا تتقدمُ",186,"م",1,0],["وليَعلمِ الأوغادُ أنَّ نهايةً","حانتْ لكلِّ عصابةِ الطُّغيانِِ",187,"ن",1,0],["وَلِي عُذْرِي إِذَا يَبِسَتْ حُرُوْفِي","عَلَى شَفَتِي وَجَفَّ صَدَىً أَثِيْرُ",188,"ر",1,0],["ولي عهد المملكه واف الخصال","بحر المكارم محد يلحق له مدى",189,"د",2,0],["وليعلموا طلل الخراب بقلبنا","قد هدّها فعل الصدود بصبّهم",190,"م",1,0],["ولي عينٌ تتوقُ إلى رؤاهم","ولي قلبٌ يرى رغم الغيابِ",191,"ب",1,1],["ولي على دفتري سطرٌ يشابهني","فهل أُلامُ إذا أعليتُ أناتي",192,"ت",2,0],["ولي عاذلٌ في حبكم ليس ينتهي","ولكنني عنه أصم وأبكم",193,"م",1,0],["ولي عاذل في حبها غير عاذرٍ","وما تنفع الأبصار لولا البصائر",194,"ر",1,0],["وليّ عهد السعودية من الغانمين","حرٍ من اللي فعلهم يسبق أقوالها",195,"ل",3,1],["ولي عَينٌ تَخافُ اللهَ صَبّا","وأُخرى لا يُفارِقُها انفِصامي",196,"م",2,0],["ولي عند ربي ما وثقت بِهِ وما","قرأتُ بآياتِ الكتابِ المُنَزَّلِ",197,"ل",1,0],["ولي عند الحساب نظام شرح","على التوحيد معروف نظيف",198,"ف",1,0],["وَلَّى عليَّ العارفينَ جحودَهُ","وغدوتُ تحتَ الكلِّ وهو سعيدُ",199,"د",1,0],["ولي عنالك خله بمنزل أخوك","تقضي له اللازم على حد مسعاك",200,"ك",1,0],["ولي عوائدُ جودٍ منك لو طرقت","تستامُ ملككَ لم تحرمْ ولم تخبِ",201,"ب",1,0],["ولي على صفحات الحُبِّ أودية","يسيل فيها جنوني حين أرتابُ",202,"ب",1,0]]}