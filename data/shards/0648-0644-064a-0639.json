/ViewPoem.aspx?id=37617",""],[5436,"ياعيد اهلي / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177540",""],[5436,"لبيك يا علم العراق ( عادل العاني )","https://www.poetsgate.com/ViewPoem.aspx?id=30629",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[5725,"ياقلب رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=178058",""],[5736,"ولي عين","https://www.poetsgate.com/ViewPoem.aspx?id=208187",""],[5736,"تعاويذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=214522",""],[5790,"حلفتم لنا أن لا تخونوا فخنتم","https://www.poetsgate.com/ViewPoem.aspx?id=112127",""],[5790,"خذوا حذركم من طرفها فهو ساحرُ","https://www.poetsgate.com/ViewPoem.aspx?id=111917",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[5952,"ليلُكَ مُنْجَلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=197047",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""],[463,"هبْ من زمانكَ بعضَ الجدّ للعبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59955&r=&rc=11",""],[6300,"دين الصبابة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82844&r=&rc=15",""]],"verses":[["وَلي عَزمٌ تَعوذُ بِهِ العَوالي","إِذا فَزِعَت إِلى مُهَجِ الأَعادي",0,"د",2,0],["وَلي عَزَماتٌ يَعْلَمُ القِرْنُ أَنَّها","بِهِ قَبْلَ تَجْريدِ الصَّوارِمِ تَفْتكُ",1,"ك",1,0],["وَلي عَبرَتانِ ما تُفيقانِ عَبرَةٌ","تَفيضُ وَأُخرى بِالصَبابَةِ تُخنَقُ",2,"ق",1,0],["وَليَعلَمَ الغَربُ أَنّا","كَأُمَّةِ اليابانِ",3,"ن",1,0],["ولي عند أخوان الصفا أريحيّة","إلى كل خلّ في الزمان موافق",4,"ق",1,0],["وَلي عِندَ العُداةِ بِكُلِّ أَرضٍ","دُيونٌ في كَفالاتِ الرِماحِ",5,"ح",1,0],["ولىّ عليّ ووافى بعد مشبهه","كالسّيل أقبل لما ولّت الدّيم",6,"م",1,0],["ولي عَبرةٌ موصولةٌ بنحيبِ","ونفسٌ عليه الدهرَ ذاتُ وجيبِ",7,"ب",1,0],["وليعلم الناسُ أنني رجل","ورّادُ هيجاءَ غيرُ ورّاش",8,"ش",1,0],["وليعدل الجائرون عن قُحمٍ","بمن أتاها مَحيقُ حائقها",9,"ق",3,0],["ولي عِرضٌ تكانفهُ لسانٌ","كأنّ كليهما سيفٌ صقيل",10,"ل",1,0],["وَلي عِندَ بَعضِ الناسِ قَلبٌ مُعَذَّبٌ","فَيا لَيتَهُ يَرثي لِذاكَ وَيَرحَمُ",11,"م",1,0],["وَلي عِندَكُم قَلبٌ أَضَعتُم عُهودَهُ","عَلى أَنَّهُ جارٌ لَكُم وَنَزيلُ",12,"ل",1,0],["وَلِيٌّ عَنِ الفَحشا سَريعٌ إِلى النَدى","بَعيدٌ عَنِ المَرأى قَريبٌ مِنَ النَجوى",13,"و",2,0],["ولَّى عن الأيك الفخو","ر به إلى عرضِ الفضاء",14,"ا",2,0],["ولي عصا من طريق الذمّ أحْمَدُها","بها أُقدّمُ في تأخيرها قدمي",15,"م",2,1],["ولي عزمة لم تبعْ في السُّرَى","نشاط السّهادِ بنومِ الكسلْ",16,"ل",1,0],["وَلي عَزْمَةٌ لا يَطْبَعُ القَيْنُ مثلَها","وَلَو أَنَّهُ في الغمدِ لِلهامِ فَصّالُ",17,"ل",1,0],["وَلي عِدَةٌ قَد راثَ عَنّي نَجاحُها","وَمَجدُكَ أَدنى رائِدٍ في اِقتِضائِها",18,"ا",3,0],["وَلّى عَلى كُرهٍ وَبَينَ ضُلوعِهِ","وَجدٌ يُغالِبُهُ عَلى السُلوانِ",19,"ن",1,0],["وليَعْبُدُوا غيرَ المسيحِ فليس في","دينِ الترَهُّبِ بعدها تأمِيل",20,"ل",1,0],["وَلِيُّ عَهدٍ ما لَهُ قَرينُ","وَلا لَهُ شِبهٌ وَلا خَدينُ",21,"ن",1,0],["وَلي عَمَلٌ كَجَناحِ الغُرابِ","أَو جِنحِ لَيلٍ إِذا مارَتَب",22,"ب",1,0],["ولي عَجَبٌ من مُشْتَراةٍ بِهَجْمَةٍ","جُمِعْنَ خِياراً وهْيَ تُجْمَعُ في هَجْم",23,"م",1,0],["وَلْيَعْلَمِ النَّاسُ فِي اَقْصَى البَسِيطَةِ مَا","قَدْ أحْرَزُوهُ لَهُ عِزَّا وتَوْطِيدَا",24,"د",2,0],["وَلَيَعْلَمَنَّ النَّاسُ بَعْدَكَ أَمْرَهُمْ","فَتُلاَمُ مَا طَالَ المَدَى وتُؤَنَّبُ",25,"ب",1,0],["وَليَعْصِمَنْكَ الْيَوْمَ مَا","نَهْنَهْتَ عِلْماً مِنْ نُهَاكْ",26,"ك",1,0],["ولّى عَلى حين شَدَّ عضدي","وَهوَ بِقَلبِ الكَظيمِ ثاوِ",27,"و",1,0],["ولْيَعِشْ للبِلادِ فاروقُ مِصْرٍ","قُدْوَةَ الناهِضِينَ رَمْزَ الأمَاني",28,"ن",2,0],["وليعلَمِ الثَّقلانِ: أنَّا لم نَزَلَ","نَحْمِي، كما حَمَتِ الجدودُ الغِيلا",29,"ل",2,0],["وليعبدوا غير الميح فليس فى ... د ين الترهب بعدها تأ ميل","أهل الفرار فليت شعرى عنهم ... هل حدثوا أن الطباع تحول؟",30,"ل",1,0],["ولي عن الغير تجريد ولي همم","تعلو بأن تنسب التأثير للسبب",31,"ب",1,0],["ولي عريض الجاه شهم مكرم","غيور شديد الباس غوث المساكين",32,"ن",1,0],["وَلَىٍّ عَالِمٍ حَبرٍ شَرِيفٍ","لَهُ اجتَمَعَت كَرَاماتُ الوَلِيِّ",33,"ي",1,0],["وَليَعتَصِم بِمُمَلَّكٍ قَهَرَ العِدى","حَتّى لَدانَ عَدُوُّهُ لِصَديقِهِ",34,"ق",2,0],["وَليَعلَموا أَنَّ النَجابَةَ خَلَّةٌ","خَصَّ الإِلَهُ بِنيلِها الأَتراكا",35,"ك",2,0],["وَليُعلِماهُ بِأَنَّ هَذي هُدنَةٌ","أَضحَت لِمَلكِهِمُ المَروعِ مِلاكا",35,"ك",2,0],["وليعتصم منه بالتقوى محاربه","فانها منه قبل الأسر تنجيه",36,"ي",2,0],["ولي عَبَراتٌ فوقَ خَدِّي رواقصٌ","ولي حَسَراتٌ تحتَ ضلعي قَوارِصُ",37,"ص",1,0],["وَلِي عَزمَةٌ إِن ساعَدَ الجدُّ أَشرَقَت","وَنافَت عَلى شُمِّ الرِعانِ الشَوامِكِ",38,"ك",1,0],["وَلِي عَن مَكانِ الذُلِّ مَنأىً وَمَرحَلٌ","وَذا الناسُ في الدُنيا غَريبٌ وَآهِلُ",39,"ل",1,0],["ولّى عليّ حروبا إن فجعت به","عند الوفاة إذا فارقت مأمولي",40,"ي",1,0],["ولي عَبْرةٌ طولَ الزمانِ أصونُها","وها أنا في الأهواءِ كُرْهاً أذيلها",41,"ل",3,0],["وَلّى عَلى الأَعقابِ يَجمَعُ نَفسَهُ","كَالأُفعَوانِ اِنسَلَّ مِن خِرشائِهِ",42,"ا",3,0],["وَلي عِيالٌ لا دَرَّ دَرُّهُمُ","قَد أَكَلوني دَهري وَما شَبِعوا",43,"ع",3,0],["وَلي عِندَ أَيّامِ دَهري المَشومِ","وُعودٌ مِنَ الحَظِّ لَم تُنجَزِ",44,"ز",1,0],["وَلّى عَلى أَعقابِها كُلُّها","طَريدَةً وَالكَلبُ مَطرودُ",45,"د",1,0],["وَلي عَلَيهِم فَضيلَةُ السَبقِ في","مَدحِكَ فَاِعرِف سَبقي وَتَعقيبي",46,"ب",2,0],["ولِي عِنْدَ لُبْنَى لَوْ تَسَنَّى لُبَانَةٌ","أزَجِّي إلَى مَاذِيِّهَا كُلَّ عَلْقَمِ",47,"م",1,0],["ولِي عَزْمٌ على تَقْبِيل فِيها","سَأُمْضيهِ وإنْ أنِفَ القَبيلُ",48,"ل",1,0],["وَلِي عِنْدَ الزَّمانِ مُطالَباتٌ","فَما عُذْرِي وَأَنْتَ بِها كَفيلي",49,"ل",2,0],["وَلي عَزْمٌ أَنَالُ بِهِ انْفِتاحاً","لِبابِ الْمَجْدِ إِنْ خِفْتُ انْغِلاقا",50,"ق",2,0],["وَلِيُّ عَهدٍ إِلى المُلكِ المَصونِ بِهِ","تَشتَدُّ أَزراً وَتَستَبقي الوَلاءَ لَها",51,"ه",2,0],["وَلي عِندَ رُؤيَتِهِ رَوعَةٌ","تُحَقِّقُ ما ظَنَّهُ المُتَّهِم",52,"م",1,1],["وَلي عليهِ أَدامَ اللَّهُ دَولتَهُ","رَسْمٌ سَفَرْتُ بهِ والوَقْتُ قَد أَزِفَا",53,"ف",2,1],["وَلي عَلَمٌ فيهِ وَعِلمٌ بِباطِنٍ","لَظاهِرِهِ طَودٌ عَلى العَقلِ شامِخُ",54,"خ",1,0],["وَلي عَجَب مِن عادل القَدّ ظالمٍ","يَجور وَما لي مِن جَفاه مجيرُ",55,"ر",1,0],["وَلي عفة أَرجو بِها نَيل مطلبي","اذا عَز يَوماً في المَحَبَّةِ مَطلَب",56,"ب",1,0],["وَلي عَطفَةٌ مِنهُ وَلي مِنهُ رِقَّةٌ","كَما البيضُ رَقَّت وَالقِسِيُّ تَعَطَّفُ",57,"ف",1,0],["وَلي عِندَهُم قَلب يُعذب بِالجَفا","وَفي أَضلُعي قَلبٌ يَذوب مِن البُعدِ",58,"د",1,0],["وليعتمد عليه في جميع","أموره من هين أو رفيع",59,"ع",1,0],["ولي عاذلانِ على مالِكي","فهذا نكيرٌ وذَا مُنكرُ",60,"ر",1,0],["وليعرف اللّه بأفعالِهِ","وليعرِف الأَفعالَ باللّهِ",61,"ه",1,0],["ولي عَبرة لم ترقا عند ادّكاره","كما لي فيه عبرة المتفكر",62,"ر",1,0],["ولي عندَ زَوْرِ الطيفِ من طيبِ نَشْرِها","ومن فيضِ دمعي روضةٌ وغَديرُ",63,"ر",1,0],["ولْيعلمِ الأَقرانُ حينَ تدِبُّ لي","تَحْتَ الوغى أَنِّي لَحِقْتُ بِصَفِّهِ",64,"ف",2,0],["وليَعْمُرَنَّ بذكرِ مجدِكَ أَعصُراً","ويُبَشِّرَنَّ بطولِ عمرِكَ أزمنا",65,"ن",2,0],["وليعطينَّك حقّ سبقك قاضياً","دَينَ الوفاء ودينُهُ ممطولُ",66,"ل",1,0],["ولي عوائدُ جُودٍ منك لو طَرَقت","سَتامُ مُلكَكَ لم تُحرَمْ ولم تخِبِ",67,"ب",1,0],["ولي عزمةٌ في ضمانِ القبولِ","سَتُدْرِكُ إن ساعدتني هُبوبا",68,"ب",2,0],["ولَّى عن جفني السهادَ فكيف لا","أبكي لياليَ غمضيَ المصروفِ",69,"ف",1,0],["وَلّى عَلى ما لِهِ نَداهُ","فَاَخرَجَ الأَمرَ عَن يَدَيهِ",70,"ي",2,0],["ولي على كلِّ محلٍّ خيَّموا","به مماتٌ مُقَلِقٌ ومصْرَعُ",71,"ع",1,0],["ولي على اهل الولاية فايق","على إلى اعلا المدارج نايل",72,"ل",1,0],["وَلي عَوائدُ مِنهُم بِالجَميل لَها","بمنهم اِتصالٌ غَيرُ مُنحَسِمِ",73,"م",1,0],["وليَعفُ مولانا ويصفَحُ إن أكُن","أقدَمتُ عما كنتُ عنه أُحجِمُ",74,"م",1,0],["ولِي عِوَضٌ بوجوهِ الصّوا","بِ مُشرقةً عن وجوه الحِسانِ",75,"ن",1,0],["وليُّ عهدٍ أميرُ المؤْمنينَ فَرَت","بعزمهِ بيضُ أُسْدٍ أسوَدَ القِمَمِ",76,"م",1,0],["وليعلم الماضي ويدري الباقي","بأنه قدم لاتسحقاق",77,"ق",1,0],["ولي عند ذكراهُ خيولٌ سوابقٌ","من الدَّمع ما هَيَّجتُها بِحِرَانِ",78,"ن",1,0],["ولي عِدىً أَنفاسُهم","كالسُّمِّ والسُّمُومِ",79,"م",1,0],["وَلِي عَنْ وِصَالِ الحَاجِبيَّةِ حَاجِب","مِن الْعَيْشِ صَدَّ الْقَلْبَ أَنْ يَنْقَع الصَّدى",80,"د",2,0],["وَلي عَلى الهَجر صَبرٌ لا يُشاركني","مِن المُحبين فيهِ غَير رئبال",81,"ل",1,0],["وليُّ عَهدِ أَبيهِ كان نصَّ عَلى اس","تخلافه فَاِنتَظر يا خير منتظَرِ",82,"ر",1,0],["وليعد كل واحد منكم بع","د تجاريبكم إلى أخويه",83,"ي",2,0],["ولي عندكم عشرون عاماً طويلة","مسخرة فيها القوى والضمائرُ",84,"ر",1,0],["ولي عمٌّ يضنُّ بما لديهِ","ويزعمُ أنَّ رزقي في يديهِ",85,"ه",1,1],["وَلي عَلى ما قُلتهُ حِكايَه","وَهيَ لِما مَثَّلتُهُ وِقايَه",86,"ه",1,0],["وليٌّ عليه رحمة اللهِ كلما","تحدَّثَ مِنْطيقٌ وما قال قائلُ",87,"ل",1,0],["ولي عزة في الملك تسمو ورحمة","على كبد الأصحاب تمطر بالبَرْدِ",88,"د",1,0],["وليعقوب باسمه نال سرا","صير الطرف بالضياء كحيلا",89,"ل",2,0],["وَلِيّ عَهْدِكَ فِي مُلْكٍ وَفي شَرَفٍ","وَتِرْبِ مَجْدِك في دُنْيَا وَفي دِينِ",90,"ن",1,0],["وَلي عَزَماتٌ كَالسُيوفِ قَواضِباً","إِذا عَنَّ خَطبٌ وَالحُتوفُ قَواضِيا",91,"ي",2,0],["ولي عَزْمةٌ إن تمَّمَ الله خَطْبَها","كفاني تمامُ العزْم للصَّدر شافيا",92,"ي",2,0],["وليعطِ علماً منه عنها عينها","كي زمرة النشاش تدري أينها",93,"ه",2,0],["ولِي عَلى صِدْقيَ مِنْ مُقْلَتي","شاهدُ عَدْلٍ وهو مَجْروحُ",94,"ح",1,0],["ولي عمل ان يقبل إليه بعضه","ربحت وحسبي منه ما أنا عامل",95,"ل",1,0],["ولي علة لو أن معشار عشرها","على سد ذي القرنين لانهدم السد",96,"د",1,0],["ولي على جودهِ ضمانٌ","وهو أصحُّ الأنامِ ذمّه",97,"م",2,0],["ولي عبراتٌ لا تضنّ بمائها","تديّمُ في أجراعكم وتريق",98,"ق",1,0],["وَلّى عَنِ الدُنيا بَنو بَرمكٍ","فَلَو تَوالى الناسُ ما زادا",99,"د",2,1],["وَليّ عهدِ البَشَر","وَاِبنِ إِمامِ البَشَر",100,"ر",1,0],["ولي على الذروة من","دنيايَ حلمٌ أَنور",101,"ر",1,0],["ولي عزمة أرمي بها دار غربة","لبزل المهاري دونها متعسف",102,"ف",1,0],["ولى عنده عُتبى إذا لم أبح بها","تلهب قلبي بالجوى فتشَعشعا",103,"ع",2,0],["ولي على من ثكلت رجالها","وكابدت ذاك المصاب لمدهشا",104,"ش",2,0],["ولي على ترتيب ما بعثت إلى","تراتيبه شعرا قرائح من شعر",105,"ر",1,0],["ولَّى على غُلّةٍ وبَرحٍ","وأَسلَمَ الباردَ النُّقاخا"