{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"أتذكراني طلب الطوائل","https://www.aldiwan.net/poem29897.html","الرجز"],[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[86,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[86,"أبكي وعين الشرق تبكي معي","https://www.aldiwan.net/poem10376.html","السريع"],[71,"لولا ادكارك تل راهط والحمى","https://www.aldiwan.net/poem4004.html","الكامل"],[0,"ديمة هطلاء فيها وطف","https://www.aldiwan.net/poem76.html","الرمل"],[88,"نزلت تجر إلى الغروب ذيولا","https://www.aldiwan.net/poem44454.html","الكامل"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[27,"قد غلبتني رواة الناس كلهم","https://www.aldiwan.net/poem4428.html","البسيط"],[27,"قد غير الحي بعد الحي إقفار","https://www.aldiwan.net/poem5739.html","البسيط"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[23,"لمن سواقط صبيان منبذة","https://www.aldiwan.net/poem21486.html","البسيط"],[72,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[51,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[51,"أبق من مالك الممزق","https://www.aldiwan.net/poem65792.html","مجزوء الخفيف"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[91,"عدمت قلبي إذا لم يعدم الجلدا","https://www.aldiwan.net/poem8814.html","عموديه"],[78,"يا بديع الحسن والإح","https://www.aldiwan.net/poem13982.html","مجزوء الرمل"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"حول الحقيقة في الحياة طوافي","https://www.aldiwan.net/poem44615.html","الكامل"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[89,"أكبر بفيصل من مليك حازم","https://www.aldiwan.net/poem44730.html","الكامل"],[89,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[56,"ذات سراويل تحت أقمصة","https://www.aldiwan.net/poem58489.html","المنسرح"],[56,"خل بيني وبين حب المدام","https://www.aldiwan.net/poem58497.html","الخفيف"],[45,"اللوم منك وإن نصحت غرام","https://www.aldiwan.net/poem66646.html","الكامل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[97,"كم تجرعنا هوانا","https://www.aldiwan.net/poem24766.html","مجزوء الرمل"],[22,"يا دار هند عفت إلا أثافيها","https://www.aldiwan.net/poem22028.html","البسيط"],[52,"قد غضبت بنت النميرية","https://www.aldiwan.net/poem26572.html","السريع"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[48,"لا تعوجا على رسوم ديار","https://www.aldiwan.net/poem62608.html","الخفيف"],[48,"وغرير الشباب محتبك الحسن","https://www.aldiwan.net/poem65103.html","الخفيف"],[48,"أعرض عن الربع إن مررت به","https://www.aldiwan.net/poem66176.html","البسيط"],[48,"قد غمس الزنبور صفرة","https://www.aldiwan.net/poem66229.html","السريع"],[48,"قد غنينا عن الشتاء","https://www.aldiwan.net/poem66247.html","مجزوء الخفيف"],[50,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[46,"إذا دنوت لشام أو مررت به","https://www.aldiwan.net/poem22474.html","البسيط"],[46,"الليالي مغيرات السجايا","https://www.aldiwan.net/poem23004.html","الخفيف"],[46,"أودى السرور بدار كلها حزن","https://www.aldiwan.net/poem23448.html","البسيط"],[46,"قد غدت النحل إلى نورها","https://www.aldiwan.net/poem23550.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85306","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85447","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12821","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"]],"verses":[["قَد غادَروا الإيوانَ بَعدَ فِراقِهِم","يَنعى القَطينَ وَيَندُبُ الحُلّالا",0,"ل",2,0],["قَد غارَ قَبلي الرُمحُ في عُتَيبَةٍ","تَحتَ العَوالي وَكُلَيبِ وائِلِ",1,"ل",1,0],["قَد غَنِيَ المُلكُ بِكُم","وَهوَ إِلَيكُم مُفتَقِر",2,"ر",1,0],["قد غَزَتْني الخُطوبُ غزْوَ الأعادي","وبَرَتْني الهُمومُ بَرْيَ قِداحِ",3,"ح",1,0],["قَد غَفَونا وَاِنتَبَهنا فَإِذا","نَحنُ غَرقى وَإِذا المَوتُ أَمَم",4,"م",1,1],["قَد غالَتِ الأَسقامُ أَضلاعَهُ","وَالرَأسُ في شُغلٍ عَنِ الأَضلُعِ",5,"ع",1,0],["قَد غَيَّرَت غِيَرُ اللَيالي كُلَّ حا","لاتي وَشَوقي وَالغَرامُ هُما هُما",6,"م",2,0],["قَد غَدا يَحمِلُني في أَنفِهِ","لاحِقُ الإِطلَينِ مَحبوكٌ مُمِر",7,"ر",1,0],["قد غادرت كبد السماء منيرة","تدنو قليلا للأفول قليلا",8,"ل",2,0],["قد غُولط الناس بأثوابها","في أنّها من معمل الانتخاب",9,"ب",1,0],["قد غَرَّد المجد في جوانبه","فاهتَزّ عِطف الفَخار من طربه",10,"ب",2,0],["قَد غَلَّبَتني رُواةُ الناسِ كُلِّهِمُ","إِلّا حَنيفَةَ تَفسوا في مَناحيها",11,"ي",3,1],["قَد غَيَّرَ الحَيَّ بَعدَ الحَيِّ إِقفارُ","كَأَنَّهُ مُصحَفٌ يَتلوهُ أَحبارُ",12,"ر",1,1],["قَد غَلَّ في الغُلِّ بِسطاماً فَوارِسُنا","وَاِستَودَعوا نِعمَةً في آلِ حَجّارِ",13,"ر",1,0],["قَد غادَروهُ لِحُرِّ الوَجهِ مُنعَفِراً","وَخالُها وَأَبوها سَيِّدُ النادي",14,"ي",1,0],["قد غسل الليل بصابونه","وفاض في صبغ المسا فانمسح",15,"ح",1,0],["قد غمزتَ الدين قدْماً","فانثنى رِخْوَ المغَامز",16,"ز",1,0],["قد غدا كلُّ معدم","واجداً من فواضلكْ",17,"ك",1,0],["قد غُلِّظتْ تلك القلو","بُ ولُطّفتْ تلك الأناملْ",18,"ل",1,0],["قَد غادَرَ الفَضلَ بِالأَحزانِ مُنفَرِداً","مَن كانَ بِالفَضلِ دونَ الناسِ مُنفَرِدا",19,"د",2,0],["قَد غَنينا بِسَنا وَجْ","هَكَ عَن ضَوءِ السراجِ",20,"ج",1,0],["قد غرست القريض في أرض مصر","فسمت منه في العراق فروع",21,"ع",1,0],["قد غرني منها التبسم طاهرا","متى نسيت مكانتي ومطافي",22,"ي",1,0],["قد غالب الصبى الاسى","في رزئه فما غلب",23,"ب",1,0],["قد غرهم من قال من سفه به","ثوروا فسيف الجيش غير جراز",24,"ز",1,0],["قد غرست التجديد في النشء حتى","كاد لولا الجمود يثمر غرسي",25,"ي",1,0],["قَد غَيَّبَ الغَربُ شَمساً لا سَقامَ بِها","كانَت عَلى جَنَباتِ الشَرقِ تَتَّقِدُ",26,"د",1,0],["قَدُّ غُلامٍ وخلقُ جاريةٍ","قامتْ مِنَ الطِّيبِ بينَ خِلْطَينِ",27,"ن",1,0],["قَدْ غَنينا بالرَّطْلِ عنْ كُلِّ حَقٍّ","فلهذا الشّيطانُ يَرْعى ذِمامي",28,"م",2,0],["قَد غابَ عَنها مِنهُ نورٌ ضَوءُهُ","يَجلو سَوادَ اللَيلِ وَهوَ ظَلامُ",29,"م",1,0],["قد غَنِينا عَنِ السَّحابِ ولو كا","نَ رَحيقاً بين السُّقاةِ وشَهْدا",30,"د",2,0],["قد غدونا غرض الر","رامي كما شاء رمانا",31,"ن",2,0],["قَد غَيَّرَ الدَهرُ مِن بَعدي مَعارِفَها","وَالريحُ فَاِدَّفَنَت فيها مَغانيها",32,"ي",3,0],["قَد غَضِبَت بِنتُ النُمَيرِيَّةِ","وَلي سِواها أَلفُ سُرِّيَّه",33,"ي",2,1],["قد غَصَّ بالماءِ القَراحِ وكان لوْ","يُسقَى المُثمَّلُ عندكم لم يَغصَص",34,"ص",1,0],["قَد غَنينا بِهِنَّ عَصراً طَويلاً","وَأَصَبنا بِهِنَّ مَلهىً وَصَيدا",35,"د",2,0],["قَد غَذاهُ النَعيمُ فَاِحمَرَّتِ الوَج","نَةُ مِنهُ عَلى فَسادِ الحُلومِ",36,"م",1,0],["قَد غَبَرَت في الدِنانِ مَسكَنُها","وَطَحتَ ظِلِّ العَريشِ مَأواها",37,"ا",3,0],["قد غُمسَ الزنبورُ صُفرةٍ","ليس لأذنيه بها طاقه",38,"ق",2,1],["قد غنينا عن الشتاء","وعن اللّبسِ للفراءِ",39,"ا",2,1],["قَد غِبتُ عَنها فَما رَقَّت لِغَيبَتِنا","وَقَد شَهِدتُ فَلَم تَشهَد وَلَم تَغِبِ",40,"ب",1,0],["قَد غَيَّرَ الدَهرُ مِنهُ بعدَ مُبتَهَجٍ","وَأَلحَدَ السَيفُ فيهِ بَعدَ تَوحيدِ",41,"د",1,0],["قَد غَدا القَومُ لِلنُضارِ فَنالو","هُ وَبِتنا وَمَن لَنا بِالزُيوفِ",42,"ف",1,0],["قَد غُلِّبَ المينُ حَتّى الصِدقُ مُستَتِرٌ","وَغُيِّبَ الرَشَدُ حَتّى خَفَّتِ الرُزُنُ",43,"ن",1,0],["قَد غَدَتِ النَحلُ إِلى نورِها","وَيحَكِ يا نَحلُ لِمَن تَكسِبين",44,"ن",1,1],["قد غَرَّني أَنَّه كا","ن باسماً كمثالك",45,"ك",1,0],["قَد غبت عَن كل العيو","ن هناك إلا عن ضَميري",46,"ر",2,0],["قد غيَّرتنا الليالي بعدها سِيراً","وخلفتنا العوادي بعضَ أشتاتِ",47,"ت",1,0],["قَدْ غَرَّهُ الْعَدَدُ الْجَرَّارُ مُجْتَمِعاً","مِنْ جَيْشِهِ وَالسِّلاَحُ الْجَمُّ وَالْعُدَدُ",48,"د",1,0],["قَد غادَرَ الحُبُّ بَني آدَمٍ","بَينَ جَريحٍ مُثبَتٍ أَو قَتيل",49,"ل",1,0],["قَدْ غَصَّتِ الأرْضُ بأشْلاَئِهِمْ","وأصْبَحَ الْبَحْرُ بِهَا مُتْرَعَأ",50,"ع",2,0],["قَدْ غَرَسْناهُ رَوْضَ عِلْمٍ فأزْرَى","حُسْنهُ بالْحَدَائقِ الباسِقاتِ",51,"ت",1,0],["قَدْ غَرَسْتَ الْوَلاَءَ في كُلِّ قَلْبٍ","فَتَفَيَّأْ في ظِلِّهِ مَمْدُودَا",52,"د",2,0]]}