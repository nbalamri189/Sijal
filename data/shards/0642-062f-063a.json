","الكامل"],[438,"لا جدد الله فيما بينكم حزنا","https://www.aldiwan.net/poem14483.html","البسيط"],[456,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[456,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[456,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[456,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[456,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[466,"قد غاب وجه البدر في","https://www.aldiwan.net/poem59832.html","مجزوء الكامل"],[466,"الغيم ممدود السرادق","https://www.aldiwan.net/poem59837.html","مجزوء الكامل"],[477,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[488,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[498,"آيات تلك الحضرة القدسيه","https://www.aldiwan.net/poem37708.html","الكامل"],[498,"ماذا يقول عليل شفه وله","https://www.aldiwan.net/poem38085.html","البسيط"],[503,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[513,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[536,"قد غاب عبد الله عني من غدا","https://www.aldiwan.net/poem47575.html","عموديه"],[536,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[536,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[536,"قد غبت أمس كما يغيب الفرقد","https://www.aldiwan.net/poem48218.html","عموديه"],[549,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[560,"يا ليلة من ليالي الطيبات بها","https://www.aldiwan.net/poem52529.html","البسيط"],[560,"اليوم لاح لنا في الحي شمسان","https://www.aldiwan.net/poem52711.html","البسيط"],[560,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[560,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[560,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[560,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[560,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[584,"يا قلب كم ذا الخفوق والقلق","https://www.aldiwan.net/poem17614.html","المنسرح"]],"verses":[["قَد غادَروا الإيوانَ بَعدَ فِراقِهِم","يَنعى القَطينَ وَيَندُبُ الحُلّالا",0,"ل",2,0],["قَد غارَ قَبلي الرُمحُ في عُتَيبَةٍ","تَحتَ العَوالي وَكُلَيبِ وائِلِ",1,"ل",1,0],["قَد غَنِيَ المُلكُ بِكُم","وَهوَ إِلَيكُم مُفتَقِر",2,"ر",1,0],["قد غَزَتْني الخُطوبُ غزْوَ الأعادي","وبَرَتْني الهُمومُ بَرْيَ قِداحِ",3,"ح",1,0],["قَد غَفَونا وَاِنتَبَهنا فَإِذا","نَحنُ غَرقى وَإِذا المَوتُ أَمَم",4,"م",1,1],["قَد غالَتِ الأَسقامُ أَضلاعَهُ","وَالرَأسُ في شُغلٍ عَنِ الأَضلُعِ",5,"ع",1,0],["قَد غَيَّرَت غِيَرُ اللَيالي كُلَّ حا","لاتي وَشَوقي وَالغَرامُ هُما هُما",6,"م",2,0],["قَد غَدا يَحمِلُني في أَنفِهِ","لاحِقُ الإِطلَينِ مَحبوكٌ مُمِر",7,"ر",1,0],["قد غادرت كبد السماء منيرة","تدنو قليلا للأفول قليلا",8,"ل",2,0],["قد غُولط الناس بأثوابها","في أنّها من معمل الانتخاب",9,"ب",1,0],["قد غَرَّد المجد في جوانبه","فاهتَزّ عِطف الفَخار من طربه",10,"ب",2,0],["قَد غَلَّبَتني رُواةُ الناسِ كُلِّهِمُ","إِلّا حَنيفَةَ تَفسوا في مَناحيها",11,"ي",3,1],["قَد غَيَّرَ الحَيَّ بَعدَ الحَيِّ إِقفارُ","كَأَنَّهُ مُصحَفٌ يَتلوهُ أَحبارُ",12,"ر",1,1],["قَد غَلَّ في الغُلِّ بِسطاماً فَوارِسُنا","وَاِستَودَعوا نِعمَةً في آلِ حَجّارِ",13,"ر",1,0],["قَد غادَروهُ لِحُرِّ الوَجهِ مُنعَفِراً","وَخالُها وَأَبوها سَيِّدُ النادي",14,"ي",1,0],["قد غسل الليل بصابونه","وفاض في صبغ المسا فانمسح",15,"ح",1,0],["قد غمزتَ الدين قدْماً","فانثنى رِخْوَ المغَامز",16,"ز",1,0],["قد غدا كلُّ معدم","واجداً من فواضلكْ",17,"ك",1,0],["قد غُلِّظتْ تلك القلو","بُ ولُطّفتْ تلك الأناملْ",18,"ل",1,0],["قَد غادَرَ الفَضلَ بِالأَحزانِ مُنفَرِداً","مَن كانَ بِالفَضلِ دونَ الناسِ مُنفَرِدا",19,"د",2,0],["قَد غَنينا بِسَنا وَجْ","هَكَ عَن ضَوءِ السراجِ",20,"ج",1,0],["قد غرست القريض في أرض مصر","فسمت منه في العراق فروع",21,"ع",1,0],["قد غرني منها التبسم طاهرا","متى نسيت مكانتي ومطافي",22,"ي",1,0],["قد غالب الصبى الاسى","في رزئه فما غلب",23,"ب",1,0],["قد غرهم من قال من سفه به","ثوروا فسيف الجيش غير جراز",24,"ز",1,0],["قد غرست التجديد في النشء حتى","كاد لولا الجمود يثمر غرسي",25,"ي",1,0],["قَد غَيَّبَ الغَربُ شَمساً لا سَقامَ بِها","كانَت عَلى جَنَباتِ الشَرقِ تَتَّقِدُ",26,"د",1,0],["قَدُّ غُلامٍ وخلقُ جاريةٍ","قامتْ مِنَ الطِّيبِ بينَ خِلْطَينِ",27,"ن",1,0],["قَدْ غَنينا بالرَّطْلِ عنْ كُلِّ حَقٍّ","فلهذا الشّيطانُ يَرْعى ذِمامي",28,"م",2,0],["قَد غابَ عَنها مِنهُ نورٌ ضَوءُهُ","يَجلو سَوادَ اللَيلِ وَهوَ ظَلامُ",29,"م",1,0],["قد غَنِينا عَنِ السَّحابِ ولو كا","نَ رَحيقاً بين السُّقاةِ وشَهْدا",30,"د",2,0],["قد غدونا غرض الر","رامي كما شاء رمانا",31,"ن",2,0],["قَد غَيَّرَ الدَهرُ مِن بَعدي مَعارِفَها","وَالريحُ فَاِدَّفَنَت فيها مَغانيها",32,"ي",3,0],["قَد غَضِبَت بِنتُ النُمَيرِيَّةِ","وَلي سِواها أَلفُ سُرِّيَّه",33,"ي",2,1],["قد غَصَّ بالماءِ القَراحِ وكان لوْ","يُسقَى المُثمَّلُ عندكم لم يَغصَص",34,"ص",1,0],["قَد غَنينا بِهِنَّ عَصراً طَويلاً","وَأَصَبنا بِهِنَّ مَلهىً وَصَيدا",35,"د",2,0],["قَد غَذاهُ النَعيمُ فَاِحمَرَّتِ الوَج","نَةُ مِنهُ عَلى فَسادِ الحُلومِ",36,"م",1,0],["قَد غَبَرَت في الدِنانِ مَسكَنُها","وَطَحتَ ظِلِّ العَريشِ مَأواها",37,"ا",3,0],["قد غُمسَ الزنبورُ صُفرةٍ","ليس لأذنيه بها طاقه",38,"ق",2,1],["قد غنينا عن الشتاء","وعن اللّبسِ للفراءِ",39,"ا",2,1],["قَد غِبتُ عَنها فَما رَقَّت لِغَيبَتِنا","وَقَد شَهِدتُ فَلَم تَشهَد وَلَم تَغِبِ",40,"ب",1,0],["قَد غَيَّرَ الدَهرُ مِنهُ بعدَ مُبتَهَجٍ","وَأَلحَدَ السَيفُ فيهِ بَعدَ تَوحيدِ",41,"د",1,0],["قَد غَدا القَومُ لِلنُضارِ فَنالو","هُ وَبِتنا وَمَن لَنا بِالزُيوفِ",42,"ف",1,0],["قَد غُلِّبَ المينُ حَتّى الصِدقُ مُستَتِرٌ","وَغُيِّبَ الرَشَدُ حَتّى خَفَّتِ الرُزُنُ",43,"ن",1,0],["قَد غَدَتِ النَحلُ إِلى نورِها","وَيحَكِ يا نَحلُ لِمَن تَكسِبين",44,"ن",1,1],["قد غَرَّني أَنَّه كا","ن باسماً كمثالك",45,"ك",1,0],["قَد غبت عَن كل العيو","ن هناك إلا عن ضَميري",46,"ر",2,0],["قد غيَّرتنا الليالي بعدها سِيراً","وخلفتنا العوادي بعضَ أشتاتِ",47,"ت",1,0],["قَدْ غَرَّهُ الْعَدَدُ الْجَرَّارُ مُجْتَمِعاً","مِنْ جَيْشِهِ وَالسِّلاَحُ الْجَمُّ وَالْعُدَدُ",48,"د",1,0],["قَد غادَرَ الحُبُّ بَني آدَمٍ","بَينَ جَريحٍ مُثبَتٍ أَو قَتيل",49,"ل",1,0],["قَدْ غَصَّتِ الأرْضُ بأشْلاَئِهِمْ","وأصْبَحَ الْبَحْرُ بِهَا مُتْرَعَأ",50,"ع",2,0],["قَدْ غَرَسْناهُ رَوْضَ عِلْمٍ فأزْرَى","حُسْنهُ بالْحَدَائقِ الباسِقاتِ",51,"ت",1,0],["قَدْ غَرَسْتَ الْوَلاَءَ في كُلِّ قَلْبٍ","فَتَفَيَّأْ في ظِلِّهِ مَمْدُودَا",52,"د",2,0],["قد غبت لكن أي وآيات الهوى","تمثال شخصك لم يزل في بالي",53,"ي",1,0],["قد غبت لا غبت ولكنها","اجزاء قلبي لك دوما تشير",54,"ر",1,0],["قد غرك اليوم امهال رتعت به","هون عليك فللامهال أوقات",55,"ت",1,0],["قد غشه سلف بالغش ساد ولم","يفقه سيفشل اذ تبدو الخفيات",55,"ت",1,0],["قد غادرُوا قلبَ السليمِ","لبيتهم قلبا سليما",56,"م",2,0],["قَد غَصَّ بالأردافِ منها مَرطُها","والحِجلُ حتى كاد أن يَتَفَصَّمَا",57,"م",2,0],["قَدْ غَارَ بَعْدَ انْجِذَابِهِ لِهَوًى","يَرْمِي بِطَرْفِ يُغْرِي الرُّؤَى العمْيَا",58,"ي",2,0],["قد غارَ في اللّحمِ كَعْباها وظَنِّيَ أنْ","سَيَطلعانِ على مَجرى الوِشاحِ مَعا",59,"ع",2,0],["قَد غَدونا فريسةَ الكافِرينا","سَل لَنا اللَّه منهُ فَتحاً مُبينا",60,"ن",2,0],["قَد غَلا القَلبُ مُذ نَأَت عَنكَ داري","غَلَيانُ القُدورِ عِندَ الصَلاءِ",61,"ا",2,0],["قد غرسنا لك المَلامة في الأن","فُس إذ حُلتَ عن كريم الغِراسِ",62,"س",1,0],["قد غَزاني هواك أيَّدَكَ اللَ","هُ بجُندٍ يطلبنَ قلبي بثارِ",63,"ر",1,1],["قد غرد الطير فقم يا غلام","فالصبح قد مزق ثوب الظلام",64,"م",1,1],["قد غَيَّبوا ماجِداً كانت مَناقِبُه","بها الزَمانُ إذا ما زَلَّ يَعتَذِرُ",65,"ر",1,0],["قَدْ غَلَّهُ الْإِيغَالُ فِي شَهَوَاتِهِ","إِذْ أَوْثَقَتْهُ ذُنُوبُهُ إِكْرَاهَا",66,"ا",3,0],["قد غفا قلبي، ودمعي","في عيوني كالّلهيبِ!",67,"ب",1,0],["قد غضبت ستي وقد أنكرت","قرقعةً تظهر في ظهري",68,"ر",2,1],["قد غالبوا الدهرَ والأرزاءَ فانتصروا","والمجد إن سارَ عنهم زارَ إغبابا",69,"ب",2,0],["قَدْ غَضَّ يَوْمُكَ ناظِرِي بَلْ فَضَّ فَقْ","دُكَ أَضْلُعِي وَأَقَضَّ بُعْدُكَ مَضْجَعِي",70,"ي",1,0],["قَد غادَرَ العَبَراتِ الشَيبُ فانِيَةً","وَفي مَذَّمَتِهِ تَفنَى العِباراتُ",71,"ت",1,0],["قد غرَّدت فيها المَثا","نِي قبلَ تَغريد الطّيورِ",72,"ر",1,0],["قد غادرَته النوى رهنَ الخُطوب ولَم","يزل يُماسيه منها ما يُصابِحُهُ",73,"ح",2,0],["قد غبت عني وما أعددت لي جلداً","ألقى به حر أشواقي وأشجاني",74,"ي",1,1],["قد غار من حسني أخي","وبقيت مثل السيف فردا",75,"د",2,0],["قَد غَزا سيفُ لحظهِ في فُؤادي","وَهو في جفنهِ بغنجٍ محلّى",76,"ل",2,0],["قَد غَازَلَتني بغتةً لحظاتهُ","لا بَل غَزَتني حيثُ لا أَتحذّرُ",77,"ر",1,0],["قَد غادَرت إِذ غربت شَمسُها","أهلّةً لَم يَكتمل مدُّها",78,"د",3,0],["قَد غَدَونا بِنارِهِ نَتَلَظّى","وَهوَ في الخُلدِ ناعِمٌ غَيرَ سائِلِ",79,"ل",1,0],["قد غدرتم ونقضتم ذمما","فجزيناكم وداداً وولاء",80,"ا",2,0],["قَد غادَرَت نارَ فُؤادي مُصطَلىً","لِرَكبِها وَماءَ عَيني مَورِدا",81,"د",2,0],["قَد غَنِيَ الوَعدُ عَنِ التَقاضي","وَأَعرَضَ الغيدُ عَنِ الإِعراضِ",82,"ض",1,0],["قد غبْتُ حَوْلاً ثُمّ جئتُ مُكلِّفاً","ولربّما ثَقُلَ الجليسُ وثَقّلا",83,"ل",2,0],["قد غار من مَسِّ أيدي الرُّسْلِ لي فأَبى","بقَبسةِ الفَخرِ منه غيرَ إقباس",84,"س",1,0],["قد غلبنا بما حرمنا عليكم","وغلبتم بما رزقتم علينا",85,"ن",2,0],["قد غادرتني أَحيرُ في فِكَرٍ","أتعبني في الأمور أسهلُها",86,"ل",3,0],["قد غَرَّدَ الطائِرُ السِرِّيُّ من طَرَبٍ","لما رأى القُضبَ تَرقُصْ رَقصَ هَيفاءِ",87,"ا",2,0],["قَد غالَها ما غالَ ذو ال","أَوتاد وَاِستَقصى نَفيره",88,"ر",2,0],["قَد غابَ عَن نَظَري مع","ب البَدر عَن سَدف اللَيالي",89,"ي",1,0],["قَد غابَ عَن مُقلَتي مَن كان ناظِرُها","وَعَوَّضت مِنهُ طُول اللَيل وَالأَرَق",90,"ق",1,1],["قَدُّ غُلامٍ صيغَ من فضةٍ","مُتَّصِل الحاجِبِ بِالحاجِبِ",91,"ب",1,0],["قَدْ غَدَا أَبكمَ لا","يُمكنُهُ رَجْع الجوابِ",92,"ب",1,0],["قد غربل العلم فانتقاه فما","لصا