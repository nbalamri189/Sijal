{"poems":[[79,"بارك عليها بذكر الله من قصص","https://www.aldiwan.net/poem36013.html","الطويل"],[90,"يا موطنا ما انتضيناها مهندة","https://www.aldiwan.net/poem44465.html","البسيط"],[173,"كم أرجع الزفرات في أحشائي","https://www.aldiwan.net/poem1594.html",""],[422,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[435,"تاالله يا ظبيات الروم إن لعبت","https://www.aldiwan.net/poem39853.html","البسيط"],[443,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[592,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60841","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60833","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60842","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115492","الكامل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32741","الكامل"],[3461,"","https://poetry.dctabudhabi.ae/diwan/poem/34017","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72409","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52168","السريع"],[5038,"قم من جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=190216",""],[5135,"يا قومنا","https://www.poetsgate.com/ViewPoem.aspx?id=208730",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[592,"يا عين فابكي على الإخوان لو بدم","https://www.poetsgate.com/ViewPoem.aspx?id=128812",""],[592,"يا طالب العلم الشريف الأقوم","https://www.poetsgate.com/ViewPoem.aspx?id=128811",""],[5510,"قاضي الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205628",""]],"verses":[["تَا اللهِ مَا حُكْمُهَا يَوْماً بِمُنْتَقَضٍ","كَلاَّ وَلاَ بَدْرُهَا يَوْماً بِمُنْتَقَصِ",0,"ص",1,0],["تا الله لم ينكسر في الحرب عسكرنا","من أجل قِلّته أو من جبانته",1,"ت",2,0],["تااللَّهِ أُقسِمُ لَو دَعَوتُ بِنُدبَتي","حَيّاً لَلبّى دَعوَتي وَنِدائي",2,"ا",2,0],["تاالله ما يحيي المتيَّم وصله","إلاَّ مميت سلوّه بصدوده",3,"د",2,0],["تااللَه يا ظبيات الروم إن لعبت","بين المعاطف منكنّ الصبا ميسا",4,"س",2,1],["تاالله لو تقصد الأطواد عن سخطٍ","زالت لديك ولم يوجد لها أثر",5,"ر",1,0],["تا الله لا أستفيق الدهر أندبكم","ما صاحب الحب في المحبوب مليوم",6,"م",1,0],["تا الله أقسم إلاَّ أنني رَجلٌ","الصدق كان مديحي فيك والقسَمُ",7,"م",1,0],["تا الله أكلُ بعدَ الظاعنين يدي","وابن الحسين لي المعتاضُ والبَدل",8,"ل",1,0],["تاالله أُقْسِمُ أني من تذكّرها","تمضي عليَّ صلاتي لا أصليها",9,"ي",3,0],["تا اللَهِ ما جلَدي عليكُم طائعٌ","كلّا ولا واللَهِ قلبي الهادي",10,"ي",1,0],["تا اللَهِ إِن كانَت أُمَيَّةُ قَد أَتَت","قَتلَ اِبنِ بِنتِ نَبِيِّها مَظلوما",11,"م",2,1],["تااللَهِ ما جَلَدي مِن بُعدِهِم جَلَدٌ","وَلا اِختِزانُ دُموعي عَنهُمُ بَخَلُ",12,"ل",1,0],["تا اللّه ما آدم المنهي عن الشجر","كلاَّ ولا دوره من أقدم الرتب",13,"ب",1,0],["تا الله يا أهل الكساء","يا آل فخر الانبياء",14,"ا",2,1],["تاالله لا تسكنُ نفس امرئٍ","قد شبّت الثورةُ في صدره",15,"ر",2,0],["تَا اللهِ لَيسَ لَها إِلّا السُّيوفُ دَوا","فَالْيَومَ قامَ الْعِراقُ الْحُرُّ يَعْتَدِلُ",16,"ل",1,0],["تا الله ما سادوا علينا كثرةً","لكنْ هجرنا هديَنا والمسجدا",17,"د",2,0],["تا الله ما امتحنوا النساء تعنتا","لكن لتقديس الهدى من رانه",18,"ن",2,0],["تاالله ما في الناس مثلك يا أبي","في لطفك الممزوج بالإحسان",19,"ن",1,0],["تا الله إن كان ذا ذنباً لقد هزلت","واخلولق العلم فيما بيننا وعم",20,"م",1,0],["تا الله هذا إفك أفاك وما","ذا لحكم إلا حكم من لم يسلم",21,"م",1,0],["تا الله أنتَ وحلمُ العمرِ أمنيةٌ","الحرف يثملُ ..قمحُ الخدِّ ذبّاحُ",22,"ح",1,0]]}