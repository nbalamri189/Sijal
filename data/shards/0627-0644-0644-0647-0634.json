{"poems":[[47,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[30,"هذا الذي تعرف البطحاء وطأته","https://www.aldiwan.net/poem5493.html","البسيط"],[107,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[309,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[366,"يا ابن الاماجد لا تخش الردى أبدا","https://www.aldiwan.net/poem68121.html","البسيط"],[382,"الله شمس يرى في الكون منبجسا","https://www.aldiwan.net/poem59279.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100917","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132126","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117297","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89581","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89572","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52143","الكامل"],[5397,"تبلجت ليلة في سعدها طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=157936",""],[5869,"اعذب الألفاظ","https://www.poetsgate.com/ViewPoem.aspx?id=57075",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=182371",""],[6125,"قفْ بالمعرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=210899",""]],"verses":[["اللَهُ شَرَّفَهُ وَأَعلى ذِكرَهُ","وَرَآهُ غَيثَ عِبادِهِ وَبِلادِهِ",0,"د",2,0],["اللَهُ شَرَّفَهُ قِدماً وَعَظَّمَهُ","جَرى بِذاكَ لَهُ في لَوحِهِ القَلَمُ",1,"م",1,0],["اللَهُ شاءَ فَمَن يُبَدِّلُ حُكمَهُ","وَقَضى القَضاءَ فَمَن يَرُدُّ وَيَمنَعُ",2,"ع",1,0],["اللَه شرفه اللَه أزلفه","بالحب والقرب والأسرار والأثر",3,"ر",1,0],["اللَهُ شَرّ فكم قَدما وَطهركم","وَخَصَّكُم يا بَني الزَهرا بِكُل هُدى",4,"د",2,0],["اللَه شمسٌ يُرَى في الكون منبجِساً","ونحن نبصره كالشمس في الطَفَلِ",5,"ل",1,1],["الله شرفهم بالمصطفى كرما","وخصهم فلذا كانوا أخصاه",6,"ا",2,0],["الله شرفه بخير رسالة","والله خصّصه بأعظم منزل",7,"ل",1,0],["الله شادَ على يديكَ بيوتَه","أبِكلِّ بيتٍ للنبىِّ مُقام",8,"م",1,0],["الله شاء فكنّا أصدقاء فلا","تعبت بحسن صنيع الله أيدينا",9,"ن",2,0],["اللَه شرف قدر أحمد في الورى","وأحل في اسمى علي مرقاه",10,"ا",2,0],["اللَهُ شَرَّفَها وَشَرَّفَ أَهلَها","شَرَفاً عَلى البُلدانِ وَالسُكّانِ",11,"ن",1,0],["اللَهُ شَرَّفَكُم عَلى كُلِّ الوَرى","بِمَكارِمِ الأَخلاقِ وَالأَعراقِ",12,"ق",1,0],["اللهُ شرَّفها فأهبطَ وحْيَهُ","فيها وعظّم بالمسيحِ مقامَها",13,"م",3,0],["الله شرف يوما في خليقته","به سنا الحجة المهدي قد طلعا",14,"ع",2,0],["اللهُ شَهْد الهَوَىَ والوُدُّ لَيْسَ لَهَا","فِي مُهْجَةِ المُتَّقِي شَيْءٌ يُسَاوِيهَا",15,"ي",3,0],["الله شاء فراقنا عن بعضنا","حتى أعيش معذَّباً ومُناجيا",16,"ي",2,0],["اللهُ شرَّع والمقبوح مُعترضٌ","هل ساقَ من خيرٍ .. في لجةٍ وثبا",17,"ب",2,0]]}