{"poems":[[59,"ولولا الشعر بالعلماء يزري","https://www.aldiwan.net/poem24701.html","الوافر"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[93,"أبا الشعب إطلع من حجابك يلتقي","https://www.aldiwan.net/poem8986.html","عموديه"],[45,"أطاعن خيلا من فوارسها الدهر","https://www.aldiwan.net/poem9607.html","الطويل"],[64,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[22,"ألا آل ليلى أزمعوا بقفول","https://www.aldiwan.net/poem21653.html","الطويل"],[54,"وأشجار نارنج كأن ثمارها","https://www.aldiwan.net/poem26958.html","الطويل"],[77,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[50,"ألا حي المنازل بالعقيق","https://www.aldiwan.net/poem66579.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[135,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem24176.html","الطويل"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[257,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[285,"سقوه كأس فرقتهم دهاقا","https://www.aldiwan.net/poem60789.html","الوافر"],[358,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[385,"إذا هب علوي تنفس عن جمر","https://www.aldiwan.net/poem49254.html","الطويل"],[445,"زمان جديد وصنع جديد","https://www.aldiwan.net/poem34911.html","المتقارب"],[466,"أبا دلف ان جار بين وصرحت","https://www.aldiwan.net/poem15421.html","الطويل"],[469,"وأشجار موز نزلنا بها","https://www.aldiwan.net/poem3214.html","عموديه"],[473,"رياض مشرقات زاهرات","https://www.aldiwan.net/poem60348.html","الوافر"],[567,"لمن طلل بوادي الرمل باد","https://www.aldiwan.net/poem52899.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37778","المتقارب"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/199358","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70906","الطويل"],[957,"","https://poetry.dctabudhabi.ae/diwan/poem/79661","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120041","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119998","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119870","الوافر"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73534","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112779","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136781",""],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128749","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28610","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130803",""],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100200","الوافر"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99350","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62777","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91938","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59467","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114535","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104880","المنسرح"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139552",""],[4680,"على نَغَمات الريح","https://www.poetsgate.com/ViewPoem.aspx?id=190640",""],[4830,"فَلَكُ الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=194200",""],[5136,"أذاب فؤاد عاقه غراما","https://www.poetsgate.com/ViewPoem.aspx?id=121666",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5605,"بلادي ..ملحمتي","https://www.poetsgate.com/ViewPoem.aspx?id=159576",""],[5606,"جددي ياعين دمعك","https://www.poetsgate.com/ViewPoem.aspx?id=195419",""],[5818,"البنات كالنبات","https://www.poetsgate.com/ViewPoem.aspx?id=181760",""],[5075,"ولابد أن يستمر الحداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82757&r=&rc=3",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""]],"verses":[["وَأَشجَعَ في الوَغي مِن كُلِّ لَيثٍ","وَآلِ مُهَلَّبٍ وَبَني يَزيدِ",0,"د",1,0],["واشِجاتٍ حُمراً كَأَنَّ بِأَظلافِ","يَدَيهِ مِن مائِهِنَّ عَبيرا",1,"ر",2,0],["وَأَشْجَارُهَا تُؤْتِي الزَّكِيَّ مِنَ الْجَنَى","وَأَطْيَارُهَا حَوْلَ الْجَنَى تَتَرَنَّمُ",2,"م",1,0],["وَأَشجَعَها قَلباً وَأَكرَمَها يَداً","إِذا قالَ لَم يَترُك مَجالاً لِأَحمَقِ",3,"ق",1,0],["وَأَشجَعُ مِنّي كُلَّ يَومٍ سَلامَتي","وَما ثَبَتَت إِلّا وَفي نَفسِها أَمرُ",4,"ر",1,0],["وأُشجي عِداكم بالحِفاظ عليكمُ","وأنتمْ شجىً بين اللّها والحلاقمِ",5,"م",1,0],["وَأَشجَيتُ أَيّامي بِصَبرٍ جَلَونَ لي","عَواقِبَهُ وَالصَبرُ مِثلُ اِسمِهِ صَبرُ",6,"ر",1,0],["وَأَشجَعُ في الهَيجاءِ مِن لَيثِ غابَةٍ","إِذا مُستَباةٌ لَم تَثِق بِحَليلِ",7,"ل",1,0],["وَأَشجارُ نارَنجٍ كَأَنَّ ثِمارَها","حِقاقُ عَقيقٍ قَد مُلِئنَ مِنَ الدُرِّ",8,"ر",1,1],["وأشجعهم في مجلس الملك ناطق","وأبينهم في هيبة الملك سالم",9,"م",1,0],["وأشجع من عين رأته فلم تَجُد","حشاشةُ نفس أمسكتها الحيازم",9,"م",1,0],["وأشجى نغمةٍ من صوتٍ طبل","حنينُ الزيرِ مع وترٍ نطوقِ",10,"ق",1,0],["وأشجتِ السُّحْبَ موسيقاهُ فاعتنقتْ","وأُسدِلتْ من خدور الشُّهبِ أستارُ",11,"ر",1,0],["وَأَشجَعَ قَد أَدرَكنَهُم فَتَرَكنَهُم","يَخافونَ خَطفَ الطَيرِ مِن كُلِّ جانِبِ",12,"ب",1,0],["وَأشجعُ الناسِ وأَتقى الناسِ","وَأكرمُ الناسِ وأوفى الناسِ",13,"س",1,0],["وَأَشجَعهم مَن حاوَلَ العَيشَ مَدبراً","مِن الخُضر لما عايَنَ المَوتَ مُقبِلا",14,"ل",2,0],["وَأَشجى مِن ضَياعِ العُمرِ حَتّى","أَغَصُّ بِبارِدِ الماءِ القَراحِ",15,"ح",1,0],["وَأَشْجَعُ مَنْ رَأَيْنَاهُ شُجَاعٌ","يُلاقِيهِ السُّرُورُ بِأَنْ يُلاَقِي",16,"ق",2,0],["وأشجاه بَرق الأَبرقين فَقَلبه","تقلّبهُ أَيدي الغَرام عَلى الجَمرِ",17,"ر",1,0],["وَأَشجاهُ مَسراهُ فَفاضَت دُموعُهُ","وَأَفكر في البَلوى فَذابَ مِن الفكر",18,"ر",1,0],["وأَشجعَ من حملته الخيولُ","وأَهيَبَ من رَهِبَتْهُ الأُسودُ",19,"د",1,0],["وأشْجعُ في حرب الرَّزايا وانني","برزئك منخوبٌ حُشاشته فسْلُ",20,"ل",1,0],["وأشجار موز نزلنا بها","فيا شكر الله ألطافها",21,"ف",3,1],["وَأَشجارٌ وَأَغصانٌ وَقُضبٌ","عَرائِشُها كَواسٍ حالِياتُ",22,"ت",1,0],["وأشجاهم بمَسئَلةٍ لخَصْمٍ","وأرواهم بفائدةٍ لِصادِ",23,"د",1,0],["وَأَشجو بِلا عقلٍ أَسيرُ مَعَ الهَوى","فَلا نكرَ أَدريهِ وَلا أَعرِفُ العُرفا",24,"ف",2,0],["وأشجارُ آسٍ بَدا حَبُّها","فولَّت بها عن فؤادي الغُمومُ",25,"م",1,1],["وأشجت وأبكت وهي غير شجيّة","وقد لذّ في جنح الظلام هجوعها",26,"ع",3,0],["وأشجارُها الرمَّان والكرم والأشا","وطمح وسدْرٌ لا من البان والغضا",27,"ض",2,0],["وأشجَعُ إن لاقيتموهمْ فإنّهم","لذبيان مولى في الحروب وناصرُ",28,"ر",1,0],["وأشجع من يجول غداة حرب","على عبل الشوى نهد الجزاره",29,"ر",2,0],["وأشجع من تحمي عليه مفاضة","غداة يرامي معلما وحامي",30,"م",2,0],["وأشجع من يجالد يوم حرب","ويوم السلم أبرع من يجادل",31,"ل",1,0],["وَأَشجاني إِذا لاحَت بُروقٌ","وَأَطرَبَني إِذا غَنَّت حَمامُ",32,"م",1,0],["واشجوا القلوب وحركوا أشواقنا","بمقالة الفصحاء والظرفاء",33,"ا",2,0],["واشجعَ من لَيثِ العَرينِ بسالةً","وأَجوَدَ من مُزْن الرَّبيع واسْمَحا",34,"ح",2,0],["وأشجانٌ عن القلبِ","نسيمُ الروضِ يرويها",35,"ي",3,0],["وأشجيت الحمائم في مناحٍ","يهدُّ حشاك والاطواد هدَّا",36,"د",2,0],["وَأَشجَعُ إِن ضارَبتَهُ بِمُهَنَّدٍ","وَأَعلَمُ إِن جادَلتَهُ بِلِسانِ",37,"ن",1,0],["واشجعهم اضحى كان يد الهوى","قد انتزعت منه الفؤاد الذي وعى",38,"ع",2,0],["وأشجعها إذا ما ناب أمر","يرد الدارعين إلى وراها",39,"ا",3,0],["وأشجار محملة كؤوساً","تضاحك في احمرار واخضرار",40,"ر",1,0],["وأشجعُ منه قد تَفرّجَ قلبُهُ","لخوفكَ حتى رمتَ بالرمحِ سَدَّهُ",41,"د",2,0],["وَأَشجعُ الناس من كانت عزيمتُه","مع الحزامة تغنيه عن الحُلَفا",42,"ف",2,0],["وأشجار من الآباء كبرى","وأغصان من الأبناء مُلد",43,"د",1,0],["وأشجعهُا قلباً وأبذخُها عُلىّ","وأكثرها مجداً وأرحبها صدرا",44,"ر",2,0],["وأشجارُهُ مثلُ العرائسِ تنجلي","مُتوجةٌ والجيدُ منها مُطوَّقُ",45,"ق",1,0],["وأشجى أمير المؤمنين وفاطماً","وأبناءها أشجى ملائكة السما",46,"م",2,0],["وأشجارُ سَطْرَى بَدَتْ كالسطُو","رِ نَمقَهُن البليغُ البصيرُ",47,"ر",1,0],["واشجع القوم من يفر به","كما تفر المعزى من الأسد",48,"د",1,0],["واُشجى الدينَ والدنيا بنعىٍ","به أم العلا تزداد كربا",49,"ب",2,0],["وأشجانه عمرٌ من التيه والمدى","غياهب ليلٍ لا تُفك طلاسمُه",50,"م",2,0],["وأشجعَ مَنْ عليها حيث كانت","دماءُ الطّفِ أفكاراً ولوْنا",51,"ن",2,0],["وأشجاه وبات خلى بال","وخان عهود من حفظ الذماما",52,"م",2,0],["وأشجارٌ بلا ثمرٍ وظلٍّ","ستقطعها من الجذر الفؤوسُ",53,"س",1,0],["وأشجار وأنهار ونور","جنان الخلد ينعم بالظلال",54,"ل",1,0],["وأشجبي ماصار والا نددي","لين كل الناس تدري وأش بلاك",55,"ك",1,0],["وأشجار ٍ دنَتْ من جور حمْلٍ","وأخرى مستطيلاتٍ خِفافِ",56,"ف",1,0],["وأشجارٍ سميكاتٍ غِلاظٍ","وأشجارٍ رقيقاتٍ نِحَافِ",56,"ف",1,0],["وأشجارُ عز وأشجارُ مجد","وواحاتُ فخر ونهرُ إباءْ",57,"ا",2,0],["وأشجار تباد من الرزايا","كبار الجذع تصرعها المنية",58,"ي",2,0]]}