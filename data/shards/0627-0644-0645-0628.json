{"poems":[[55,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[55,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[55,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[73,"لو أن غير الدهر كان العادي","https://www.aldiwan.net/poem4010.html","الكامل"],[95,"أغادية بكرت بالحيا","https://www.aldiwan.net/poem11146.html","المتقارب"],[95,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[29,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[49,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[53,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[91,"وددت لو أني كنت في مصر محشورا","https://www.aldiwan.net/poem44924.html","الطويل"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[64,"المبدأ الأول في","https://www.aldiwan.net/poem52199.html","مجزوء الرجز"],[47,"تذكر محزونا وأنى له الذكرى","https://www.aldiwan.net/poem10214.html","الطويل"],[47,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[47,"أعاد شكوى من الطيف الذي اعتادا","https://www.aldiwan.net/poem63468.html","البسيط"],[47,"ليالينا بين اللوى فزرود","https://www.aldiwan.net/poem63519.html","الطويل"],[30,"سرى لك طيف من سليمة بعدما","https://www.aldiwan.net/poem5552.html","الطويل"],[63,"أفق من سكرة الأمل المحال","https://www.aldiwan.net/poem51465.html","الوافر"],[82,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[82,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[33,"ألم خيال من سليمى فأرقا","https://www.aldiwan.net/poem42215.html","الطويل"],[33,"ألم طيف فهاج لي طربي","https://www.aldiwan.net/poem42616.html","المنسرح"],[107,"دار العروبة ترفع الأعلاما","https://www.aldiwan.net/poem42089.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[47,"ليالينا بين اللوى فزرود","https://www.poetsgate.com/ViewPoem.aspx?id=31334",""],[47,"تذكر محزوناً، وأني له الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=31565",""],[96,"الدمية المحطّمة","https://www.poetsgate.com/ViewPoem.aspx?id=15615",""],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[33,"أَلَمَّ خَيالٌ مِنْ سُلَيْمَى فَأَرَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18969&r=&rc=232",""],[265,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[274,"ألم بجسم كان غصنا من الآس","https://www.aldiwan.net/poem35598.html","الطويل"],[275,"خيال سعد أسعف بالمزار","https://www.aldiwan.net/poem52064.html","الوافر"],[285,"مضى رمضان أو كأني به مضى","https://www.aldiwan.net/poem1367.html",""],[368,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[384,"أمن بعد ما بان الفريق وأدلجا","https://www.aldiwan.net/poem48769.html","الطويل"],[407,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[410,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[420,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[436,"ألم به طيف الخيال مسلما","https://www.aldiwan.net/poem12475.html","الطويل"],[436,"وأهدى نسيم الروض مسكا وعنبرا","https://www.aldiwan.net/poem12526.html","الطويل"],[441,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[461,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[461,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[461,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[467,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[467,"وباسم شمت في الظلماء بارقة","https://www.aldiwan.net/poem3385.html","عموديه"],[467,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[471,"ألم بي في ليلة بدرها","https://www.aldiwan.net/poem60173.html","السريع"],[498,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[541,"ألم به الوشي فأعرض هازئا","https://www.aldiwan.net/poem47505.html","عموديه"],[554,"ألم خيال من أميمة طارق","https://www.aldiwan.net/poem47373.html","الطويل"],[554,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"]],"verses":[["أَلَمَّ بِعوجٍ كَالحَنايا مُناخَةٍ","عَلى جِزعِ وادٍ ذي رُبىً وَمَجاني",0,"ن",2,0],["أَلَمَّ بِنا وَاللَيلُ قَد شابَ رَأسُهُ","وَقَد مَيَّلَ الغَربُ النُجومَ وَمالا",1,"ل",2,0],["المُبشِراتُ العُلى مَنازِلُهُم","وَالقِمَمُ العالِياتُ وَالقُلَلُ",2,"ل",1,0],["أَلَمَّ بِنا كَنَبضِ العِرقِ وَهناً","فَلَمّا جازَنا مَلَأَ السَماءَ",3,"ا",2,0],["المُبصِرونَ إِذا السَنابِكُ أَطلَعَت","شَمسَ الظَهيرَةِ في ثِيابِ حِدادِ",4,"د",1,0],["أَلَمَّ بِهَا دَهْرَهَا قَاتِلاً","فَيَا قِتْلَةً لا تَفِيهَا دِيَهْ",5,"د",3,0],["أَلَمَّ بِالطبِّ رَيْبٌ","كَأَنَّهُ فَأْسُ هَادِمْ",6,"م",1,0],["أَلَمَّ بِنا الخَيالُ بِذاتِ عِرقٍ","فَحَيّا اللَهُ ذَلِكَ مِن خَيالِ",7,"ل",1,0],["أَلَمَّ بِنا وَجُنحُ اللَيلِ داجٍ","خَيالٌ زارَ وَهناً مِن نَوارِ",8,"ر",1,0],["المُبْرِقِ البشرَ الملِثِّ الجَدَا","مُجانباً قَعْقَعَةَ الرعْدِ",9,"د",1,0],["المّ بزهر الفكر ريان نافحاً","وابصر روض العلم اخضر ممطورا",10,"ر",2,0],["المُبلِغينَ الدينَ ذُروَةَ سَعدِهِ","الرافِعينَ المُلكَ أَوجَ كَمالِهِ",11,"ل",2,0],["المبدأ الأول في","علوما فرد أحد",12,"د",1,1],["أَلَمَّ بِسَفرٍ لاغِبينَ وَأَينُقٍ","ذَرَعنَ بِنا مِن أَذرِعاتٍ إِلى بُصرى",13,"ر",2,0],["أَلَمَّ بي طَيفُها وَهناً فَأَعوَزَهُ","عِندي وُجودُ كَرىً بِالدَمعِ مَطرودِ",14,"د",1,0],["أَلَمَّ بي وَبَياضُ الصُبحِ مُنتَظِرٌ","قَد رَقَّ عَنهُ سَوادُ اللَيلِ أَو كادا",15,"د",2,0],["أَلَمَّ بِخوصٍ كَالقِسِيِّ سَواهِمٍ","وَشُعثٍ عَلى كُثبِ العَقَيقِ هُجودِ",16,"د",1,0],["أَلَمَّ بِحَسرى بَينَ حَسرى تَوَسَّدوا","مَذارِعَ أَنضاءٍ تَجافَينَ سُهَّما",17,"م",2,0],["أُلِمُّ برَبعِها حَذِراً فألقَى","مُلِمَّ الشَّيبِ في لِمَمِ الجِبالِ",18,"ل",1,0],["أَلمّ بساقي عبرةٍ حدَّ قفرة","بِمِنْسَمِ حرفٍ كلَّما بُلّ يُلْطَمُ",19,"م",1,0],["أَلَمَّ بِصَبٍّ لَيسَ يَدري أمِرجَلٌ","يفور بنيرانِ الأسى مِنهُ أو صَدرُ",20,"ر",1,0],["أَلَمَ بِبَطحاءِ الكَديدِ وَصُحبَتي","هُجودٌ فَزادَ القَلبَ حُزناً وَشَوَّقَ",21,"ق",1,0],["أَلَمَّ بي وَالرِكابُ ساكِنَةٌ","لَيلاً وَهَمّي بِذِكرَتي وَصَبي",22,"ب",2,0],["المبتنينَ على السّماكِ عُروشَهم","نوراً يَعِزُّ على الشُّموسِ مراما",23,"م",2,0],["أَلَمَّ بِهِمْ مُدَارَكَةً فَأَفْنَى","أُصُولَهُمُ الزَّكِيَّةَ وَالْفروعا",24,"ع",2,0],["ألم بخوض كالقسي سواهم","وشعث على كثيب العقيق هجود",25,"د",1,0],["ألم بسفر لاغبين، وأنيق","ذرعن بنا من أذرعات إلى بصرى",26,"ر",2,0],["ألمّ به إثمي فندّاه بالمنى","ومرّ به وهنا فطيّبه عاري",27,"ر",2,0],["ألمّ بكفي النجوم وأنتقي","مزرّرها في باقتي والمعصّبا",28,"ب",2,0],["أَلَمَّ بِبَطْحَاءِ الكَدِيدِ وَصُحْبَتي","هجودٌ، فزادَ القلبَ حزناً وشوقا",29,"ق",2,0],["ألم بنا يختال غير ملوم","بقطع من الظلماء طيف ظلوم",30,"م",1,1],["ألمَّ بجسمٍ كان غُصناً من الآسِ","ذبولٌ من الجرحِ الذي ما لهُ آسِ",31,"س",1,1],["ألم بمضجَعي نفظرت منه","بما ظفر الفرزدق من نوار",32,"ر",1,0],["ألم بنا كالطيف في الصيف زائراً","فخيم فينا ساعة ثم قوضا",33,"ض",2,0],["ألمَّ به ساري الخيالِ ببَلْدةٍ","وأُخْرَى بها أهْلُ الحبيبِ نُزول",34,"ل",1,0],["أَلَمَّ بِنَضو لِلزيارة مُرتجِ","فَصادَف مِنهُ مَسلَك الهَم مرتجا",35,"ج",2,0],["ألمَّ بجسمي عارض طال مكثه","وأعيا الأطبا منه طول سقامي",36,"م",2,1],["أَلَم بِمَضجَعي بعد الكَلالِ","خَيالٌ من هِلالِ بَني هِلالِ",37,"ل",1,1],["ألمَّ بنا بجنحِ الليل وهناً","كما جرّدت من سيف فرندا",38,"د",2,0],["ألمّ به طيفُ الخيال مسلِّما","فأذكَرَهُ من لوعةٍ ما تقدّما",39,"م",2,1],["ألمّ به والصبحُ قد لاحَ جيشُه","وهمّتْ جيوشُ الليلأن تتصرّما",39,"م",2,0],["ألم بنا في مجلسِ اللهوِ وانثَنى","وقد أودَع الأحزانَ قلباً متيّما",40,"م",2,0],["ألم به صرف الحوادث عنوةً","ولكنما من بعدها الدهر نادم",41,"م",1,0],["ألمَّ بمخدوعين عن كل راحةٍ","بما طلبوا العُليا مُناخا ومظعَنا",42,"ن",2,0],["ألمَّ بمعتنقٍ ساعديْه","يطارح منها الأمانيَّ ذِكرا",43,"ر",2,0],["أَلمُّ بهم ما لا يُلَمُّ بشاعبٍ","وأرأبُ فيهم صدعَ ما ليسَ يُرأبُ",44,"ب",1,0],["المبغضون لحبّ المجد ما لهمُ","كأنهُ عند صبٍ عاشقٍ عذل",45,"ل",1,0],["ألمَّ بالروض كي يجلو معاطفهُ","فنوره خجلٌ في غصنهِ الخضد",46,"د",1,0],["المبكياتُ عيون الزّغف سمرهم","دماً وإن ضوعفت منها السرابيل",47,"ل",1,0],["أَلَمَّ بي في لَيلَةٍ بَدرُها","كَمِثلِ مِرآةٍ بَدَت تَصدا",48,"د",2,1],["ألمّ بنا والليل في درع ثاكل","لِواحدِها والنجم في لون عاشق",49,"ق",1,0],["ألمَّ به الوَشِي فأعرَضَ هَازئاً","فقُلتُ قَضِيبُ البانِ حرَّكَه الهَوَى",50,"و",2,1],["ألمّ بنا لم ندر كيف لِمامُهُ","وقد طالما عاقته عنّا العوائقُ",51,"ق",1,0],["ألَمَّ بنا وما رَكبَ المطايا","ولا أَسرى ولا اِدّلجَ اِدّلاجا",52,"ج",2,0],["أَلَمَّ بِصُحبَتي وَهُم هُجودٌ","خَيالٌ طارِق ٌ مِن أُمِّ حصن",53,"ن",1,1]]}