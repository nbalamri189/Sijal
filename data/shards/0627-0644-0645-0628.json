","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45976","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102750","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90845","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90805","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90743","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90872","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90844","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73163","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117225","الوافر"],[4656,"","https://poetry.dctabudhabi.ae/diwan/poem/98049","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52181","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4829,"شمّا والمرج الدهيماني","https://www.poetsgate.com/ViewPoem.aspx?id=34260",""],[4119,"لعل خيالا ضل حين انتيابها","https://www.poetsgate.com/ViewPoem.aspx?id=16090",""],[5064,"خلا بِكَ شوقٌ يا فُؤادُ جديدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199128",""],[585,"أجل إنه الفجر الذي أنت آمله","https://www.poetsgate.com/ViewPoem.aspx?id=161921",""],[5100,"كل نفس ذائقة الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=207695",""],[592,"يا راكباً جلعداً وجناء عيهلة","https://www.poetsgate.com/ViewPoem.aspx?id=128816",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5431,"حنظلة...مازال في العشق الكثير لنكمله!","https://www.poetsgate.com/ViewPoem.aspx?id=198015",""],[5720,"المُبدِعُونَ*","https://www.poetsgate.com/ViewPoem.aspx?id=199622",""],[5723,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=25485",""],[5861,"أنت عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=189721",""],[5956,"ما ذَلَّ حكمٌ إنْ يقربْ ناقدا","https://www.poetsgate.com/ViewPoem.aspx?id=184127",""],[5956,"الرقابةُ صاحبةُ العظمةِ المصطنعة","https://www.poetsgate.com/ViewPoem.aspx?id=185621",""],[6115,"المبتدأ والخبر","https://www.poetsgate.com/ViewPoem.aspx?id=180539",""],[6227,"زامِر الحيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87061&r=&rc=4",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["أَلَمَّ بِعوجٍ كَالحَنايا مُناخَةٍ","عَلى جِزعِ وادٍ ذي رُبىً وَمَجاني",0,"ن",2,0],["أَلَمَّ بِنا وَاللَيلُ قَد شابَ رَأسُهُ","وَقَد مَيَّلَ الغَربُ النُجومَ وَمالا",1,"ل",2,0],["المُبشِراتُ العُلى مَنازِلُهُم","وَالقِمَمُ العالِياتُ وَالقُلَلُ",2,"ل",1,0],["أَلَمَّ بِنا كَنَبضِ العِرقِ وَهناً","فَلَمّا جازَنا مَلَأَ السَماءَ",3,"ا",2,0],["المُبصِرونَ إِذا السَنابِكُ أَطلَعَت","شَمسَ الظَهيرَةِ في ثِيابِ حِدادِ",4,"د",1,0],["أَلَمَّ بِهَا دَهْرَهَا قَاتِلاً","فَيَا قِتْلَةً لا تَفِيهَا دِيَهْ",5,"د",3,0],["أَلَمَّ بِالطبِّ رَيْبٌ","كَأَنَّهُ فَأْسُ هَادِمْ",6,"م",1,0],["أَلَمَّ بِنا الخَيالُ بِذاتِ عِرقٍ","فَحَيّا اللَهُ ذَلِكَ مِن خَيالِ",7,"ل",1,0],["أَلَمَّ بِنا وَجُنحُ اللَيلِ داجٍ","خَيالٌ زارَ وَهناً مِن نَوارِ",8,"ر",1,0],["المُبْرِقِ البشرَ الملِثِّ الجَدَا","مُجانباً قَعْقَعَةَ الرعْدِ",9,"د",1,0],["المّ بزهر الفكر ريان نافحاً","وابصر روض العلم اخضر ممطورا",10,"ر",2,0],["المُبلِغينَ الدينَ ذُروَةَ سَعدِهِ","الرافِعينَ المُلكَ أَوجَ كَمالِهِ",11,"ل",2,0],["المبدأ الأول في","علوما فرد أحد",12,"د",1,1],["أَلَمَّ بِسَفرٍ لاغِبينَ وَأَينُقٍ","ذَرَعنَ بِنا مِن أَذرِعاتٍ إِلى بُصرى",13,"ر",2,0],["أَلَمَّ بي طَيفُها وَهناً فَأَعوَزَهُ","عِندي وُجودُ كَرىً بِالدَمعِ مَطرودِ",14,"د",1,0],["أَلَمَّ بي وَبَياضُ الصُبحِ مُنتَظِرٌ","قَد رَقَّ عَنهُ سَوادُ اللَيلِ أَو كادا",15,"د",2,0],["أَلَمَّ بِخوصٍ كَالقِسِيِّ سَواهِمٍ","وَشُعثٍ عَلى كُثبِ العَقَيقِ هُجودِ",16,"د",1,0],["أَلَمَّ بِحَسرى بَينَ حَسرى تَوَسَّدوا","مَذارِعَ أَنضاءٍ تَجافَينَ سُهَّما",17,"م",2,0],["أُلِمُّ برَبعِها حَذِراً فألقَى","مُلِمَّ الشَّيبِ في لِمَمِ الجِبالِ",18,"ل",1,0],["أَلمّ بساقي عبرةٍ حدَّ قفرة","بِمِنْسَمِ حرفٍ كلَّما بُلّ يُلْطَمُ",19,"م",1,0],["أَلَمَّ بِصَبٍّ لَيسَ يَدري أمِرجَلٌ","يفور بنيرانِ الأسى مِنهُ أو صَدرُ",20,"ر",1,0],["أَلَمَ بِبَطحاءِ الكَديدِ وَصُحبَتي","هُجودٌ فَزادَ القَلبَ حُزناً وَشَوَّقَ",21,"ق",1,0],["أَلَمَّ بي وَالرِكابُ ساكِنَةٌ","لَيلاً وَهَمّي بِذِكرَتي وَصَبي",22,"ب",2,0],["المبتنينَ على السّماكِ عُروشَهم","نوراً يَعِزُّ على الشُّموسِ مراما",23,"م",2,0],["أَلَمَّ بِهِمْ مُدَارَكَةً فَأَفْنَى","أُصُولَهُمُ الزَّكِيَّةَ وَالْفروعا",24,"ع",2,0],["ألم بخوض كالقسي سواهم","وشعث على كثيب العقيق هجود",25,"د",1,0],["ألم بسفر لاغبين، وأنيق","ذرعن بنا من أذرعات إلى بصرى",26,"ر",2,0],["ألمّ به إثمي فندّاه بالمنى","ومرّ به وهنا فطيّبه عاري",27,"ر",2,0],["ألمّ بكفي النجوم وأنتقي","مزرّرها في باقتي والمعصّبا",28,"ب",2,0],["أَلَمَّ بِبَطْحَاءِ الكَدِيدِ وَصُحْبَتي","هجودٌ، فزادَ القلبَ حزناً وشوقا",29,"ق",2,0],["ألم بنا يختال غير ملوم","بقطع من الظلماء طيف ظلوم",30,"م",1,1],["ألمَّ بجسمٍ كان غُصناً من الآسِ","ذبولٌ من الجرحِ الذي ما لهُ آسِ",31,"س",1,1],["ألم بمضجَعي نفظرت منه","بما ظفر الفرزدق من نوار",32,"ر",1,0],["ألم بنا كالطيف في الصيف زائراً","فخيم فينا ساعة ثم قوضا",33,"ض",2,0],["ألمَّ به ساري الخيالِ ببَلْدةٍ","وأُخْرَى بها أهْلُ الحبيبِ نُزول",34,"ل",1,0],["أَلَمَّ بِنَضو لِلزيارة مُرتجِ","فَصادَف مِنهُ مَسلَك الهَم مرتجا",35,"ج",2,0],["ألمَّ بجسمي عارض طال مكثه","وأعيا الأطبا منه طول سقامي",36,"م",2,1],["أَلَم بِمَضجَعي بعد الكَلالِ","خَيالٌ من هِلالِ بَني هِلالِ",37,"ل",1,1],["ألمَّ بنا بجنحِ الليل وهناً","كما جرّدت من سيف فرندا",38,"د",2,0],["ألمّ به طيفُ الخيال مسلِّما","فأذكَرَهُ من لوعةٍ ما تقدّما",39,"م",2,1],["ألمّ به والصبحُ قد لاحَ جيشُه","وهمّتْ جيوشُ الليلأن تتصرّما",39,"م",2,0],["ألم بنا في مجلسِ اللهوِ وانثَنى","وقد أودَع الأحزانَ قلباً متيّما",40,"م",2,0],["ألم به صرف الحوادث عنوةً","ولكنما من بعدها الدهر نادم",41,"م",1,0],["ألمَّ بمخدوعين عن كل راحةٍ","بما طلبوا العُليا مُناخا ومظعَنا",42,"ن",2,0],["ألمَّ بمعتنقٍ ساعديْه","يطارح منها الأمانيَّ ذِكرا",43,"ر",2,0],["أَلمُّ بهم ما لا يُلَمُّ بشاعبٍ","وأرأبُ فيهم صدعَ ما ليسَ يُرأبُ",44,"ب",1,0],["المبغضون لحبّ المجد ما لهمُ","كأنهُ عند صبٍ عاشقٍ عذل",45,"ل",1,0],["ألمَّ بالروض كي يجلو معاطفهُ","فنوره خجلٌ في غصنهِ الخضد",46,"د",1,0],["المبكياتُ عيون الزّغف سمرهم","دماً وإن ضوعفت منها السرابيل",47,"ل",1,0],["أَلَمَّ بي في لَيلَةٍ بَدرُها","كَمِثلِ مِرآةٍ بَدَت تَصدا",48,"د",2,1],["ألمّ بنا والليل في درع ثاكل","لِواحدِها والنجم في لون عاشق",49,"ق",1,0],["ألمَّ به الوَشِي فأعرَضَ هَازئاً","فقُلتُ قَضِيبُ البانِ حرَّكَه الهَوَى",50,"و",2,1],["ألمّ بنا لم ندر كيف لِمامُهُ","وقد طالما عاقته عنّا العوائقُ",51,"ق",1,0],["ألَمَّ بنا وما رَكبَ المطايا","ولا أَسرى ولا اِدّلجَ اِدّلاجا",52,"ج",2,0],["المُبِرّينَ في المَحافِلِ أن لا","يَنقُصُوا عَن أبيهِما في القياس",53,"س",1,0],["المُبيدينَ المَواضي في العِدا","والمُطيلينَ المَعالي بِالعَوالي",54,"ل",2,0],["ألمَّ بِنا الخَيالُ فَزارَ غَبّاً","وَقَد كانَت زيارَتُهُ لِماما",55,"م",2,0],["ألمّ بنا في دامس الليل فانجلى","فلما انثنى عنّا وودّع أظلما",56,"م",2,0],["ألمَّ بجسمي مذ رحلتَ نحولُه","وفارقَ جفني مذ نأيتَ رقادُهُ",57,"د",2,0],["ألمَّ بهِ طيفٌ مِن الحنِّ طارِقٌ","وقد كان ذا رأيٍ وقولٍ مُسدَّدِ",58,"د",1,0],["المبتني بنيانَ مجدٍ ما له","غيرُ النجومِ الزُّهْرِ من آساس",59,"س",1,0],["أَلَمَّ بِي طَيْفُ حِرْمَانٍ فَأَرَّقَنِي","فَبِتُّ مُعْتَنِقاً للْهَمِّ والكُرَبِ",60,"ب",1,0],["ألم بنا وهنا وللنجم بهتة","كبهتة عين النرجس الخضل الندى",61,"د",2,0],["ألمَّ بخد كيف شاء جمالُه","فقلت لصحبي يخلق اللّه ما يشا",62,"ش",2,0],["ألَمَّ بِي طيفُهُ وَهْنًا فَأعْوَزَهُ","عِنْدِي وجُودُ كَرًى بِالدَّمْعِ قد حُجِبَا",63,"ب",2,0],["ألم بنا وهنا على حين غفلة","فتم عليه نشرها والتبسم",64,"م",1,0],["المُبْرِزَاتِ نُهُودَهُنَّ أسنَّةً","الرَّاشِقَاتِ عُيُونَهُنَّ نِبَالاَ",65,"ل",2,0],["المُبْدِيَاتِ مِنَ الحِجَالِ لَطَائِفًا","المُهْدِيَاتِ إلَى القُلُوبِ وَبَالاَ",65,"ل",2,0],["المبرى من كل عيب وريب","والمسوى بغير نقص وعي",66,"ي",1,0],["أَلم بالملك مِن آلامك الأَلم","وَمال بِالمَعلوات الساق وَالقدم",67,"م",1,1],["المبدي للنجدة علماً","قد فاق جميع الأعلامِ",68,"م",1,0],["أَلمَّ بِها ما بِنا مِنْ هوىً","أَلْمَّ فيتَّمَنَا كُلَّنا",69,"ن",2,0],["أَلَمَّ بي طيفُهُ وقَدْ عَسْعَسَ الَّ","ليلُ فخِلتُ الصَّباحَ قَدْ أَصْبَحْ",70,"ح",1,0],["ألمّ بها في حسنها وشبابها","كوردة بستان جنتها أناملهْ",71,"ل",2,1],["ألمّ به خطب من الجور فادح","كما انقضّ باز أقتم الريش كاسره",72,"ر",2,0],["المبتدى من فعله صار الخبر","ولو جرت أحكامه على الإبَر",73,"ر",1,0],["المبتدا وخبر والفعل أو","فاعله ونائباً عنه رأوا",74,"ا",3,0],["المبتدا اسم وهو يرفع الخبر","ورفعه بالابتداء يعتبر",74,"ر",1,0],["أَلَمَّ بِنا وَالرُكبُ قَد وَضَعَتهُمُ","نَواجي السُرى قودٌ بِأَغبَرَ قاتِمِ",75,"م",1,0],["ألم بجنبه ضيفاً قراه","صوارمها وخرصان تميد",76,"د",1,0],["ألمَّ بياقوت الملاحة خده","وزاد بريحان العذار شذاه",77,"ا",2,0],["ألمَّ بها عذراء لفّاء بضةً","كأن أباها البدر أو أمها الشعرى",78,"ر",2,0],["ألمَّ بك الكمال فصار سوراً","كدائرة نهايتها ابتداء",79,"ا",2,0],["ألم بي طيفها إلمام معتذرِ","وما تواني عن التسآل عن خبري",80,"ر",2,1],["ألم بنا وراء بني أبيه","يدبر غارة المتلصصينا",81,"ن",2,0],["ألم بي الهوى من كل فج","وسهمي عن مرامي العقل طاشا",82,"ش",2,0],["الم بنا وهنا وقد حال دونها","فياف بها الهادي يضل عن القصد",83,"د",1,0],["أَلَمَّ بِصُحبَتي وَهُم هُجودٌ","خَيالٌ طارِق ٌ مِن أُمِّ حصن",84,"ن",1,1],["أَلَمَّ بي يشكو الكَلاَل ساهراً","حتى إذا أرق جَفْنِي هَوَّما",85,"م",2,0],["المُبدِياتِ مِنَ الثُغورِ لِآلِياً","تَشفي بِريقَتِها ضَعيفاً تالِفا",86,"ف",2,0],["أَلِم بِمَنزِلِ أَحبابٍ لَهُم ذِمَمُ","سَحَّت عَلَيهِم سَحابٌ صَوبُها دِيَمُ",87,"م",1,1],["ألم بها فابتز بهجة حسنها","وصوّح فيها ريق الورق الندي",88,"د",2,0],["ألمّ بها في فتية هاشمية","فكل تراه في سما مجده بدرا",89,"ر",2,0],["أَلَم بِهِ خطب مِن الدَهر مُظلم","تحمل مِن أَكداره وَتقَلدا",90,"د",2,0],["الم بعارضيه نصف لام","وهم بشاربيه نصف صاد",91,"د",1,0],["ألم بلا داء يهيج لواعجاً","وجوى بلا نار يثير ضراما",92,"م",2,0],["ألمّ بنا الأضحى فقلت له أهلا","وإن كان مولانا بما قلته أولى",93,"ل",2,1],["المبدع البديع للأفعال","البادئ المبدى بلا مثال",94,"ل",1,0],["ألمَّ بوقعه خبر فظيع","فدكَّ بثقل فادحه الهضابا",95,"ب",2,0],["ألمّ بنا وهناً فقال: سلام","خيال لسلمى والرفاق نيام"