{"poems":[[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[90,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[29,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[72,"وزائر على عجل","https://www.aldiwan.net/poem42734.html","مجزوء الرجز"],[45,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[71,"رجل جراد صدها","https://www.aldiwan.net/poem28067.html","مجزوء الرجز"],[33,"هيهات من أمة الوهاب منزلنا","https://www.aldiwan.net/poem41292.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[50,"قد أغتدي في فلق الإصباح","https://www.aldiwan.net/poem62541.html","الرجز"],[50,"قد أغتدي بزرق صبيح","https://www.aldiwan.net/poem62543.html","الرجز"],[48,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62303","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[103,"يا نَسْمَة ً رنّحتْ أعطافَ وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62435&r=&rc=27",""],[139,"بظلك كل شخص يستقيل","https://www.aldiwan.net/poem49110.html","الوافر"],[164,"تدارك من زمانك ما افدتا","https://www.aldiwan.net/poem59135.html","الوافر"],[228,"ألا تبصر الأغصان بللها القطر","https://www.aldiwan.net/poem41891.html","الطويل"],[234,"أيا دير مرحنا سقتك رعود","https://www.aldiwan.net/poem51140.html","الطويل"],[276,"لاقيت يا نفس حقا ما حكى الحاكي","https://www.aldiwan.net/poem52112.html","البسيط"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[309,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[327,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[396,"يا حسرتي ضاع عمري في البطالات","https://www.aldiwan.net/poem54608.html","عموديه"],[408,"فراقكم هاج اشتياقي وأشجاني","https://www.aldiwan.net/poem46756.html","الطويل"],[435,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[438,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[438,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[458,"لماذا الثورة اشتعلت لماذا","https://www.aldiwan.net/poem61350.html","الوافر"],[482,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[491,"ألا هل فؤادي إذ صبا اليوم نازع","https://www.aldiwan.net/poem481.html",""],[543,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[556,"وقالوا نراها خطة مدلهمة","https://www.aldiwan.net/poem47255.html","الطويل"],[556,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130146","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63848","الهزج"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90575","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96617","المتقارب"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16756","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64687","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64659","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49971","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79808","الطويل"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77681","الوافر"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106704","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52078","السريع"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100461","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71058","السريع"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104786","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42480","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109320","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53139","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27178","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67213","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93738","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93682","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93831","البسيط"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105352","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204484","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200140","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133994","البسيط"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76537","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48288","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48325","الطويل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104849","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129356","السريع"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21394","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33126","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133301","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111061","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135098","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83652","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133068","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139728",""],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102009","البسيط"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124661","الرجز"],[5121,"دَوْلَةُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=59598",""],[5431,"زمانٌ لا يكفّ عن الخداع","https://www.poetsgate.com/ViewPoem.aspx?id=215980",""],[5582,"أَلا هَلْ فَتَحْتَ مِنَ الشَّوْقِ بَابَا","https://www.poetsgate.com/ViewPoem.aspx?id=63469",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[6125,"مَا إنْ رَأيتُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=210595",""],[2220,"أحبابُنا أين هُمُ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19302&r=&rc=844",""],[5190,"الوردة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78331&r=&rc=44",""]],"verses":[["فَكَم واعَسَت بِالرَكبِ مِن مُتَعَسَّفٍ","غَليظٍ وَأَخفافُ المَطِيِّ دوامِ",0,"م",1,0],["فكم وجد الذليل به اعتزازاً","وكم لبِس الحزين به سرورا",1,"ر",2,0],["فَكَم واعَسنَ مِن حَبلٍ إِلَيهِم","وَمِن قورٍ مُواجِهُهُنَّ قورُ",2,"ر",1,0],["فَكَم وَكَم سَتَرتَ لي","مِن خَطَإٍ وَمِن خَطَل",3,"ل",1,0],["فَكَم وَكَم نِعمَةٍ مُجَلِّلَةٍ","رَبَّيتَها كانَ مِنكَ مَولِدُها",4,"د",3,0],["فكمْ وكمْ للطفِهِ","في هذهِ الرجلِ يدُ",5,"د",1,0],["فَكَم وَكَم مِن حَديثٍ قَد خَلَوتُ بِهِ","في مَسمَعٍ مِنكُم أَو مَنظَرٍ حَسَنِ",6,"ن",1,0],["فَكَم وَكَم مِن رَجُلٍ نَبيلِ","ذي هَيبَةٍ وَمَركَبٍ جَليلِ",7,"ل",1,0],["فَكَم وَكَم مِن هارِبٍ ذَليلِ","وَكَم أَسيرٍ خاضِعٍ مَغلولِ",7,"ل",1,0],["فَكَم وَكَم ذي جُدَّةٍ لِياحِ","وَنازِبٍ أَعفَرَ ذي طَماحِ",8,"ح",1,0],["فَكَم وَكَم مِن طُوَّلٍ طَموحِ","لَم يُنجِهِ طُمورُهُ في اللوحِ",9,"ح",1,0],["فَكَم وَلَدٍ لِلوالِدَينِ مُضَيِّعٍ","يُجازيهِما بُخلاً بِما نَجَلاهُ",10,"ل",3,0],["فَكَمْ وَطِئْنَا بِهَا مِنْ شَافهٍ بَطَلٍ","وكَمْ أَخَذْنَا مِنَ انْفَالٍ نُفَاديهَا",11,"ي",3,0],["فَكَمْ وَقْفَةٍ إذْ ذَاكَ وَ المَوْتُ دُونَهَا","وَقَفْنَا وَمَا نَلْوِي اتِّقَاءَ عِقَابِ",12,"ب",1,0],["فَكمْ وزنّا فما أجدتْ موازنةٌ","في صَفْحةِ الغيبِ ما يُعْيي الموازينا",13,"ن",2,0],["فَكمْ وزنّا فما أجدتْ موازنة ٌ","في صَفْحة ِ الغيبِ ما يُعْي الموازينا",14,"ن",2,0],["فكم وعدٍ وفيت وكم صعاب","غدوت على مفارقها تصول",15,"ل",1,0],["فكم وضعت لطالبه جناحا","ملئكة السماء فلا حرمتا",16,"ت",2,0],["فَكَم وَقفَةٍ في بَعَلبَكَّ وَقفَتَها","تُراقِب مَسرى البَدر تتبِعُه الزُهرُ",17,"ر",1,0],["فكم واصلتْنا في رُبَاك أوانِسٌ","يَطُفْنَ علينا بالمدامة غِيد",18,"د",1,0],["فَكَم وَديعة شوق لي اليك مضت","قَد كنت يوم النَوى اودعتها فاك",19,"ك",1,0],["فَكَم وَكَم حازَ من سهل ومن جبل","ومن وعور الى أم القُرى وَقرى",20,"ر",2,0],["فكم وكم ضل بالأهوا وطاعتها","من عاقل جامع للعلم والعمل",21,"ل",1,0],["فَكَم وَرَدنا مِن مَنهَلٍ أَبِدٍ","أَعذَبُ ما نَستَقي بِهِ المِلَحُ",22,"ح",1,0],["فكم ولدٍ وافى عدوّاً لوالدٍ","صلاه جحيماً نارُها تتلهَّف",23,"ف",1,0],["فكم ولدٍ حلى الحياء بعشرةٍ","ومظهره عما يسير به شرح",24,"ح",1,0],["فكم وكم جادكم أعطى بلا سبب","وكم فتح كم منح كم من عطيات",25,"ت",1,0],["فكم وقعةٍ بيني وبينَ صروفه","تهونُ لها أيام عبسٍ وذبيان",26,"ن",1,0],["فكم وشح القرطاس برد رسالة","مونقة زهراء تركية بكر",27,"ر",1,0],["فكم وَقَفَ العافِي فقالَ له هَلاَ","وكم عَثَرَ الجانِي فقالَ له لَعَا",28,"ع",2,0],["فكم وحتّى ومتى","بعدَ الرِّضا تسخطني",29,"ي",1,0],["فكم وغد حيالك مشرئب","إلى الطاغوت في فكر تهاذى",30,"ذ",2,0],["فكم واقفتُ جيشُ الحبَّ حتى","سئمتُ كفاحَه صُبحاً ومُيْسى",31,"س",2,0],["فَكَم وافِدٍ مِنا شَريفٌ مَقامَهُ","وَكَم حافِظٍ لِلقِرنِ وَالقِرنُ وادِعُ",32,"ع",1,0],["فكَم وكَم مِن نُكتَةٍ تفعَلُ بِال","ألبَابِ فِعلَ القُرقُفِ المُعَتَّقِ",33,"ق",1,0],["فكم وَرْطَةٍ ضاقتْ عليّ فلم يزلْ","بِيَ اللَّه حتّى اِنتاشني من خلالها",34,"ل",3,0],["فكم وطنٍ بالوُدِّ مِنِّي سكنتُه","وإنْ لم أُجرّرْ في جوانِبِه بُرْدِي",35,"د",2,0],["فكم واقِفٍ أرْدَى وكم سائرٍ هَدَّى","وكم حكمةٍ أبْدى وكم مملقٍ أغْنى",36,"ن",2,0],["فكم وسط قلبي للبتول وزوجها","وأولادها من حرقة تتجدد",37,"د",1,0],["فكم وجهٍ مصونٍ في","نواحي البيتَ قد صُفِّر",38,"ر",1,0],["فَكَم وَجَدنا فيهِ مِن أَفاضِل","مِن عُلَما وَأُمَرا وَكامِلِ",39,"ل",1,0],["فكم وشى الواشي إذا رمتها","واشٍ رقيب وخبيثٍ لئيم",40,"م",1,0],["فَكم واردٍ في السراب ماءً","ولم يلق ذلك إلّا سرابا",41,"ب",2,0],["فَكَم وَقفَةٍ في الرَوعِ مِنهُم وَحَملَةٍ","أَثارَت بَناتُ الحَتفِ مِن كُلِّ جانِبِ",42,"ب",1,0],["فَكَمْ والِهٍ مِنْ بَني عُذْرَةٍ","إليَّ انْتَمى في الْهَوى وانْتَسَبْ",43,"ب",1,0],["فَكَمْ وَعْدٍ لَكُمْ أَنْجَزْتُمُوهُ","بِفَضْلٍ مِنْكُمُ قَبْلَ اقْتِضَاءِ",44,"ا",2,0],["فكم واردٍ قد صادف الخصب والنّدى","وآخر عنه بالرّفاهة صادر",45,"ر",1,0],["فكم ولجوا منكم مَغارةَ أرقمٍ","وكم لكم داسوا عرينة مُلبد",46,"د",1,0],["فَكَم والى وَأَولى مِن جَميل","وَبِرٍّ بِالفِعالِ وَبِاللّسانِ",47,"ن",1,0],["فكم وقعةٍ فِي البَذلِ أفنَت بنانُهُ","بها المالَ حَتَّى ليسَ في الأرضِ بائسُ",48,"س",1,0],["فَكَمْ وَقَانَا من أذىً مُدهِش","وَعدُ لَهُ صُبحا وَعند العَشِي",49,"ي",1,0],["فكم واضح منهم كالهلال","أهالت يداي عليه الرمال",50,"ل",1,0],["فكم وكم عَنَّاه خَوْضُ العَنا","وكم وكم أَشقاه طول الشَّقا",51,"ق",2,0],["فَكَم وَكَم هالِكٌ نُجِّى بِحُرمَتِهِ","بهِ على آدَمٍ قَد تابَ ذُو القِدَمِ",52,"م",1,0],["فكم وافاكَ شيطانٌ رجيمٌ","ثقيلُ الروحِ يستقصي آثاركْ",53,"ك",1,0],["فكم ولغوا اناء أخي اضطرار","وكم ذي عسرة بلغوا ضراره",54,"ر",2,0],["فكم ولَّدت نعماك شكري صنيعة","وما الشكر إلا حيث تزكو الصنائع",55,"ع",1,0],["فَكَم وَكَم أَطلُبُهُم","وَكَم سَأَلتُ بَينَهُم",56,"م",1,0],["فكم وردَ الأحبارُ بحر عُلومه","فقالوا حقيقٌ أنت في كلها بحر",57,"ر",1,0],["فَكم وَكَم أعتقت رقّاً مَواهبُه","وَكَم قَد استعبدت حراً أَياديه",58,"ي",2,0],["فَكَم وَاعدت ذات الجَمال فَما وَفَت","بِوَعد وَلا نار الهيام بِها اِنطفت",59,"ت",1,1],["فكم وكم همم تسمو بهمته","كأنها أنجم دارت على القطب",60,"ب",1,0],["فكم وكم من حلى يحلى","بحليها جيدنا المعطل",61,"ل",1,0],["فكم وكم قبل منها ناظري","وجنتها وليته كان فما",62,"م",2,0],["فكم وضعت نظاماً كي يسير به","فظل مغرىً بسير غير منتظم",63,"م",1,0],["فكم وسعت ثيابك من أفاعي","همومٍ مقلقات بالدبيب",64,"ب",1,0],["فكم وعدوني بالخروج ولم تزل","عيوني مع الموتى الى موعد النشر",65,"ر",1,0],["فكم وكم حسنات اثمرت منناً","من خير صنع رياض العدل مبديها",66,"ي",3,0],["فَكَم وَصلَةٍ في ال