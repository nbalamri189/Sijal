&qid=77881&r=&rc=23",""],[6244,"ما هو الكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=510&r=&rc=3",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["لَيسَ مِنهُم مَن ساقَ تِلكَ المَصاعي","بِ غِلاباً وَقادَ ذاكَ القِطارا",0,"ر",2,0],["لَيسَ مِنّا المُضَرَّبونَ وَلا قَي","سٌ وَلا جَندَلٌ وَلا الحَدَاءُ",1,"ا",2,0],["لَيسَ مِن حادِثِ الزَمانِ إِذا","حَلَّ عَلى أَهلِ غِبطَةٍ مِن مُجيرِ",2,"ر",1,0],["ليس موسَى هذا بصاحِبِ فِرْعَو","ني ولا في عَصاهُ منْ تأثيرِ",3,"ر",1,0],["لَيسَ مِنّاً مَن يَني أَو يَنثَني","أَو يَعُقُّ النيلَ في رَعيِ الذِمَم",4,"م",1,0],["لَيسَ مِنكِ الهَوى وَلا أَنتِ مِنهُ","اِهبِطي مِصرَ أَنتِ مِن قَومِ موسى",5,"س",2,0],["ليس معنى توحيدِنا اللهَ في الملّ","ة إلا اتحادَنا في الكيان",6,"ن",1,0],["ليس من غاية الحياة البقاء","فلذا خاب في الخلود الرجاء",7,"ا",2,1],["ليس ما قد جتى علينا بها إلا ق","قار أدهى مما جنى التمويل",8,"ل",1,0],["لَيسَ مِن ساكِنٍ تَحَرَّكَ إِلّا","أَنتَ حَركتهُ خَفِيَّ المَكانِ",9,"ن",1,0],["لَيسَ مِن فِعلِ زَمانٍ","لا وَلا فِعلِ الزُناةِ",10,"ه",1,0],["ليس من حلَّ بالمحلِّ الذي أن","ت به من سماحةٍ ووفاءِ",11,"ا",2,0],["ليس من قائِل المديح ولكنْ","من أناسٍ تدعوهم الغوغاء",12,"ا",2,0],["ليس من حقِّ من أتيح لإنجا","دك أن لا تُجِدَّ في إنجادِهْ",13,"د",2,0],["ليس من جاء عائذاً فتطوَّلْ","تَ بتكليمه يرى ذاك قصدا",14,"د",2,0],["ليس من فقرٍ على راجيكُمُ","وكذا ليست عليكم فاقره",15,"ر",2,0],["ليس مثلي يترك القصْ","دَ ويمشي في العِراض",16,"ض",1,0],["ليس ما تصنعونه","أوليائي بضائع",17,"ع",1,0],["ليس ممن يُسدُّ دون وليٍّ","باب عُرفٍ لفتحه باب عرف",18,"ف",1,0],["ليس من يذهب علواً","مثل من يذهب عمقا",19,"ق",2,0],["ليس من دائك هذا","غير طول النتف راقي",20,"ق",2,0],["ليس من العدلِ أن تعذّبني","بالهجرِ بعد الظهورِ في زِينك",21,"ك",1,0],["ليس منّي وإن فررتَ مَفرٌّ","أنا شيءٌ إليه منهُ مساقُك",22,"ك",1,0],["ليسَ ممّنْ إذا ألحّ شفيعٌ","أخلقَ الوجه عنده بابتذالِ",23,"ل",1,0],["ليسَ منْ كنتَ ريحَه ببعيدٍ","من سماءٍ تبلُّه ببلالِ",23,"ل",1,0],["ليسَ من عادةِ الأميرِ المُرَجَّى","أن يغولَ امرءاً رجا أن يعولهْ",24,"ل",2,0],["ليس من جدتَهُ بوسْميِّ عُرفٍ","غانياً عن وليِّك المتوالي",25,"ل",2,0],["ليس ممن إذا ألَحَّ شفيعٌ","أخلق الجاه عنده بابتذالِ",25,"ل",1,0],["ليس مستأثراً عليهم يدَ الده","رِ بعِلقٍ من المحامِد غالِ",25,"ل",1,0],["ليس من حيلة تُنْهنهُ عنَّي الْ","وَجدَ إلا غروبُ دمعٍ سجام",26,"م",1,0],["ليس مستحسِناً لك المطلَ والخُلْ","فَ سِوَى من يراكَ مثلَ الغَواني",27,"ي",1,1],["ليس من جوهرِ الحديدِ مَصُوغاً","بل من المجدِ نصلُهُ وجُفونه",28,"ن",2,0],["ليس من كبرياءَ فيه ولكن","كلُّ وجه لذلك الوجه عاني",29,"ن",2,0],["ليس منه الخمولُ بل منك والأط","وادُ تخفَى عن خاشعاتِ القنان",29,"ن",1,0],["ليس ممن يضلُّ في الدَّهْم حتى","يُبتَغى بالسؤال والنِّشدان",29,"ن",1,0],["ليس مدحٌ يفي بمدحك إلا","صلوات المليك في القرآن",29,"ن",1,0],["ليسَ منه ولا من الموت بُدٌّ","لرشيدٍ ولا لنفسٍ غويَّهْ",30,"ي",2,0],["لِيُسمِعَني وَاللَيلُ بَينِ وَبَينَهُ","عَنِ الجارِ بِالجافي وَلا المُتَناوِمِ",31,"م",1,0],["لَيسَ ما أَشكوهُ مِنهُ واحِداً","كُلُّ شَيءٍ مَرَّ بي فيهِ نَكِد",32,"د",1,0],["ليس من حظ العبقري اذا","برّ ز الا العداء والبغضاء",33,"ا",2,0],["ليس من يدرس الطبيعة بحا","ثا بناج من تهمة الالحاد",34,"د",1,0],["ليس من هذا الموت يا نفس بد","فهو للناس من تراث الجدود",35,"د",1,0],["ليس منا الاجساد بالروح تحيا","انما يحيا الروح بالاجساد",36,"د",1,0],["ليس موت الآباء الا ضمانا","لحياة الابناء والاحفاد",36,"د",1,0],["ليس من لم يكن تحسس","منها سوى حجر",37,"ر",1,0],["ليس من حبي للمنية اني","ان دنت مني اصبعاً ادن باعا",38,"ع",2,0],["ليس ما للحياة من رونق في","نظر الشيخ الهمّ الاّ خداعا",38,"ع",2,0],["ليس محمودا ان تقيمي طويلا","بين حملاق العين والاهداب",39,"ب",1,0],["ليس من عار في الرجوع على من","ضلّ في سيره طريق الصواب",39,"ب",1,0],["ليس من طبعها البكاء ولكن","شربت ماء دجلة والفرات",40,"ت",1,0],["ليس موت الأطفال هيناً فقد ين","بُغ منهم نوابغٌ أذكياء",41,"ا",2,0],["لَيسَ مِنهُم إِلّا فَتىً عَبقَرِيٌّ","لَيسَ في المَجدِ بِالدَعِيِّ الدَخيلِ",42,"ل",1,0],["لَيسَ مَن ماتَ بِخافٍ عَنكُمو","أَو قَليلِ الفِعلِ فيكُم وَالأَثَر",43,"ر",1,0],["لَيسَ مَن يَركَبُ سَرجاً لَيِّناً","مِثلَ مَن يَركَبُ أَعرافَ الرِياح",44,"ح",1,0],["لَيسَ مِن عُمرِيَ يَومٌ","لا تَرى فيهِ لِقائي",45,"ا",3,0],["لَيسَ مَن ماتَ فَاستَراحَ بِمَيتٍ","إِنَّما المَيتُ مَيِّتُ الأَحياءِ",46,"ا",2,0],["لَيسَ مِن غَضبَةٍ عَلَيهِم وَلَكِن","هوَ نَجمٌ يَعلو مَعَ الكُتّابِ",47,"ب",1,0],["لَيسَ مِن دونِيَ الحِجابُ عَلى المَر","ءِ وَلَكِن دونَ المَعالي حِجابُه",48,"ب",2,0],["لَيسَ مِن عُصبَةٍ إِذا اِستَأنَفوا السَع","يَ في تَسافُلٍ وَاِنخِفاضِ",49,"ض",1,0],["لَيسَ مِثلي عَلى الهَوانِ أَبا نَص","رٍ وَلا الذُلِّ في المَواطِنِ أَغضى",50,"ض",2,0],["لَيسَ مَن كانَ صالِحاً مُستَقيماً","مِثل مَن كانَ هاذياً وَذَليلا",51,"ل",2,0],["لَيسَ مَعالي الأَخلاقِ إِلّا لِمَن","يَصبِرُ عِندَ المَكروهِ إِن نَزَلا",52,"ل",2,0],["لَيسَ مالٌ لَم يُقَدِّمهُ ذُخراً","رَبُّهُ بَينَ يَدَيهِ بِمالِ",53,"ل",1,0],["لَيسَ مِن شَأنِنا التَقَيُّدُ بِالشَر","بِ فَإِن زالَت زالَتِ الأَطماعُ",54,"ع",1,0],["لَيسَ مِثلي يُخَبِّرُ الناسَ عَن آ","بائِهِم قُتِّلوا وَيَنسى القِتالا",55,"ل",2,1],["ليَ سَمْعٌ صدّ عن قَوْلِ اللّواحْ","وفؤادٌ هامَ بالغيدِ الملاحْ",56,"ح",1,1],["لَيسَ مِنّا مَن شَكا عِلَّتَهُ","مَن شَكا ظُلمَ حَبيبٍ ظَلَما",57,"م",2,0],["لَيسَ مَن كانَ غائِباً فَقَدَتهُ ال","عَينُ حَقّاً كَالشاهِدِ المَفقودِ",58,"د",1,0],["ليسَ مَنْ يقطعُ طرقاً بطلاً","إنما مَنْ يتّقِ اللهَ بطلْ",59,"ل",1,0],["ليسَ ما يحوي الفتى عَنْ عزمِهِ","لا ولا ما فاتَ يوماً بالكسلْ",59,"ل",1,0],["ليس من مالَ عن الحقِّ كمن","جعل الحقَّ سبيلاً يُلتزَمْ",60,"م",1,0],["ليس من حاجَةٍ لم تُتَحْ لَكَ بع","دُ ولا ثَمَّ مَطلبٌ مَنْشُودُ",61,"د",1,0],["ليس مَن بَرَّ فأرضَى رَبَّهُ","مِثلَ من أرضَى هَواهُ وفَجَرْ",62,"ر",1,0],["ليس مَن يركبُ الدّنيّةَ يَخشى","مَركبَ الموتِ بالحياةِ جديرا",63,"ر",2,0],["ليس من رامَ رِفعةً أو سناءً","مِثلَ من رامَ ناقةً أو بعيرا",63,"ر",2,0],["لَيسَ مِنَ السُلوان عَن حُس","نِهِ الفَتّان قَلبي قَريح",64,"ح",1,0],["ليس مني لو أراه","مرَّةً غيرَ سليم",65,"م",1,0],["لَيسَ مِن حامٍ لِكَيدٍ يَنبَري","فيهِ 