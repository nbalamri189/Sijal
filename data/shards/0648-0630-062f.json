{"poems":[[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[371,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[520,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[534,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[543,"أتاك كما تأتي اللآلئ في العقد","https://www.aldiwan.net/poem48213.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48508","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96613","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100828","البسيط"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89988","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81274","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139630",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5050,"خفف العذل عن محب تصامم","https://www.poetsgate.com/ViewPoem.aspx?id=38204",""],[5101,"إنما الاقصى عقيدة","https://www.poetsgate.com/ViewPoem.aspx?id=197418",""],[5582,"ستبدي خفيّات الأمورِ العواقبُ","https://www.poetsgate.com/ViewPoem.aspx?id=63465",""],[520,"عنان اليالي في يديك مسلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577658",""]],"verses":[["وَذُدتَهُمُ عَمّا رَضيتَ مِنَ العُلى","وَغادَرتَ مالَم تَرضَ مِنها مُقَسَّما",0,"م",2,0],["وَذُدتَ مَخوفاتِ الخُطوبِ مُجامِلاً","فَعادَ سَحيلاً كُلُّما كانَ مُبرَما",0,"م",2,0],["وَذُدتُ قَلبي عَن ذَلِكَ المَرام","كَما ذادَ ظَمآنا عَنِ الماءِ ناهِلُ",1,"ل",1,0],["وذدت الأعادي عن حريم خلائف","حمى حلها سيف بكفك محرم",2,"م",1,0],["وذُدْ عَنْهُمُ من أَفْظَ","عَ فيهمْ أَيَّ إفظاعِ",3,"ع",1,0],["وذُدتَ عنِ الإسلام مَن رام كَيدُه","وأطفأتَ نِيرَانا مُؤَجَّجَةَ الوَقد",4,"د",1,0],["وذدت عنهم جماهير العدى فنجوا","وأنت في حومة الميدان منفرد",5,"د",1,0],["وَذدت العِدا عَن ملكها بجحافلٍ","تصبّ على الأعداء منها المصائبُ",6,"ب",1,0],["وَذُدْتَ عَنْ غائرةِ التَهامِي","وَالعامَ جَلَّيْتَ وَكُلَّ عامِ",7,"م",1,0],["وذدتهم وزجاج الرمح عاملة","والسيف يلعب بالاجسام والقلل",8,"ل",1,0],["وذدت عَنهُ كبداً شارفَت","وِرداً فحفَّت كحفيف القَطاه",9,"ا",2,0],["وذد بجاهك عني كل حادثة","يا خير من عن حياض الحق قد ذادا",10,"د",2,0],["وذد عن جند طروادٍ","ونسوة جندها النبلا",11,"ل",2,0],["وَذُد عَن حِماهُ ما عَقَدتَ حِبالَهُ","بِحَبلِكَ وَاِستُرهُ بِما لَكَ مِن سِترِ",12,"ر",1,0],["وذد مريدى لفتنة وأذى","عنى اذا الموت جيشه قهرا",13,"ر",2,0],["وذد أذى الفتنتين عنى","ان ضمنى في القفار قبر",14,"ر",1,0],["وَذد الأَسى وَدَع التَخاذُل وَاِطرَح","خَور النُفوس وَما أَراكَ بِخائر",15,"ر",1,0],["وذدتَ عن الإسلام بعد حماته","بمذود فصلٍ عنه ذو العرش ذائد",16,"د",1,0],["وذد عن زنى وامر رناء بطهره","ولس القضا اختر إن دعاه قضاء",17,"ا",2,0],["وذد عن حمى المكارم من لا","يدر ما الحل في العلا والمحارم",18,"م",1,0],["وذد عما اعتقدتّ بكل شيء","وقاوم انما الاقصى عقيدة ...",19,"د",2,0],["وَذُدْتُ العِدَى عَنْ مُلْكِها بِجَحافِلٍ","تُصَبُّ عَلَى الأَعْداءِ مِنْها المَصائِبُ",20,"ب",1,0],["وذدت الأعادي عن حريم خلائفٍ","حمى حلها سيف بكفك مخرم",21,"م",1,0]]}