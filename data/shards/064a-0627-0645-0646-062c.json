oetsgate.com/ViewPoem.aspx?id=109732",""],[5628,"أميرة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=178481",""],[5648,"فصلة الفيش","https://www.poetsgate.com/ViewPoem.aspx?id=156247",""],[5688,"سلّم لربك","https://www.poetsgate.com/ViewPoem.aspx?id=200911",""],[5701,"يا منجب الأبناء والأحفاد","https://www.poetsgate.com/ViewPoem.aspx?id=164691",""],[5853,"مواثيق الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175624",""],[5956,"كم من نتائج حققت لقيانا","https://www.poetsgate.com/ViewPoem.aspx?id=192239",""],[5956,"من أي نجم جئتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=194561",""],[5957,"لَكَ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=12232",""],[5998,"نمت دموعي على سرى وكتماني","https://www.poetsgate.com/ViewPoem.aspx?id=190054",""],[6031,"يا مَنْ جَرَحْتِ حُشَاشَةَ المُشْتَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=46312",""],[6069,"سفرت فخلت سواد معجرها","https://www.poetsgate.com/ViewPoem.aspx?id=105666",""],[6078,"بلقيس شعري","https://www.poetsgate.com/ViewPoem.aspx?id=203024",""]],"verses":[["يا مُنجِزاً وَعيدَهُ","وَما طِلاً ما وَعَدا",0,"د",2,0],["يا مَن جُعِلتُ فِداهُ","وَمَن بَراني هَواهُ",1,"ا",2,1],["يا من جلبت لسوق أنعمه الثنا","سلعاً فعاش بها الرجا وتعيَّشا",2,"ش",2,0],["يا من جفاني فلفظي بعد جفوته","وجيد قصديَ لا حلوٌ ولا حالي",3,"ل",2,0],["يا من جَنَى لأبيه القتل ثم غدا","حرباً لِثَائِرِهِ صدَّقْتَ مَنْ ثلبا",4,"ب",2,0],["يا مَنْ جلا دهْرُنا دُجاهُ بهِ","وعَنْ تباشِير وجْهِهِ ضَحكا",5,"ك",2,1],["يا مَن جَرى مِن مُقلَتَيهِ إِلى الهَوى","صِرفاً وَدارَ بِوَجنَتَيهِ مُشعشَعا",6,"ع",2,0],["يا مَنْ جناب الفضلِ أصبحَ مُمْعراً","فغدَا بهِ خَضِلَ المذانبِ مُمْرِعا",7,"ع",2,0],["يا مَن جَرى حُبّيهِ في مُهجَتي","جَريَ النَدى في زَهرِ النَرجِسِ",8,"س",1,0],["يا مَن جَعَلَ الظِباءَ لِلأُسدِ تَصيد","وَالسادَةَ في مَواقِفِ العِشقِ عَبيد",9,"د",1,1],["يا مَن جَعَلَ البِرَّ لِلعُفاةِ قُيوداً","قَد زِدتَ مِنَ المَنِّ عُنقَ عَبدِكَ أَغلال",10,"ل",1,0],["يا مَن جَعَلَ العالِمَ الفَصيحَ بَليداً","بِالبَحثِ كَما صَيَّرَ الفلاسِفَ جُهّال",10,"ل",1,0],["يا من جروا في البال ما برحوا به","أترى جرينا عندكم في البال",11,"ل",1,0],["يا مَن جَداهُ قَليلُ","وَمَن بَلاهُ طَويلُ",12,"ل",1,1],["يا مَن جَفاني وَمَلّا","نَسيتَ أَهلاً وَسَهلا",13,"ل",2,1],["يَا مَنْ جَرَتْ مِنْ نَبْعَتَيْهَا","الأريحِيَّةُ وَالمَعَالِي",14,"ل",2,0],["يا من جَحَدتْ عيناه دمِي","وعلى خدَّيْه توَرُّدهُ",15,"د",2,0],["يا مَنْ جَلَبْتُم لنا هذا الوباءَ، خذوا","نصيبَكم منه قبل الغير موفورا",16,"ر",2,0],["يا من جرى من مقتيه إلى الهوى","صِرفاً، ودار بوَجنتيْه مُشَعْشَعا",17,"ع",2,0],["يا منجزَ الوعْد يا محي الصخاء وَيا","سِرَاجَ مِلّتنا يا سَيِّد الأُمَمِ",18,"م",1,0],["يا منجز الوعد الوَرَى","من حاضِرٍ أو غائبِ",19,"ب",1,0],["يا مَن جَعَلتُم رِضَا المَولَى تِجَارَتكُم","وبِعتُمُ دُرَّكُم فِيهِ ودَارَتَكُم",20,"م",1,1],["يا من جفاه ذليل أن موجبه","نقص به أصبح المجفو موصوفا",21,"ف",2,0],["يا من جفاني بغير ذنب","حسبي منك الصدود حسبي",22,"ي",1,1],["يا من جلا قتر الضلال ومن إذا","ما أمه العافي انجلى إقتاره",23,"ر",2,0],["يا مُنجِزَ الميعادِ في زَمَنٍ تَوا","صى أَهلُهُ بِالمَنعِ وَالإِلطاطِ",24,"ط",1,0],["يا مَن جَعَلناهُ لِحاجَتِنا","أَهلاً فَأَسلَمَنا إِلا الياسِ",25,"س",1,1],["يا مَن جَلا بِقُدومِهِ ال","مَيمونِ عَن عَيني قَذاها",26,"ا",3,1],["يا مَن جُعِلتُ فِداؤَهُ","ما هَكَذا عاهَدتَني",27,"ن",2,0],["يا مَن جِيادُ الخَيلِ وَالرِماحُ وَال","صِفاحُ في يَومِ الوَغى بُستانُهُ",28,"ن",2,0],["يا مَن جَفَوني فَجُفو","ني بَعدَهُم لَم تَهجَعِ",29,"ع",1,0],["يا مُنجياً لوطاً وَقَد أَسرى دُجى","بِأَهله وَاللَيل مَسدول الغطا",30,"ا",1,0],["يا مَن جَعلْتُك مَقْصِدِي فغدا","سَهْلاً إليكَ رُكوبِيَ الوَعرا",31,"ر",2,0],["يا مَن جَفاني وَمَلا","رِفقاً بِعَبدك مَهلا",32,"ل",2,1],["يا مَن جَفاني بِلا ذَنب وَلا سَبب","إِلّا لَما نَقل الواشي مِن الكذب",33,"ب",1,0],["يا من جميع الرسل تحت لوائه","في الحشر مثلي كلمه وخليله",34,"ل",2,0],["يا مَنْ جفا إذ رأى في ظاهري خلَلاً","وانفضَّ عنَّي أوغادٌ وأوباشُ",35,"ش",1,1],["يا من جعلت لما يقول مسامعي","أصداف ذاك اللؤلؤ المكنون",36,"ن",1,0],["يا منجم العمر.. يا بدئي وخاتمتي","وخير ما في أني فيك أكتهل!",37,"ل",1,0],["يا مَن جَنَيتُ عَلَيهِ ما أُقِرُّ بِهِ","وَكَم مُقِرٍّ نَجا إِذ قالَ ما فَعَلا",38,"ل",2,1],["يا مَن جَنى ذَنباً عَلى ذَنبي","لا تَستَتَر بِالجَحدِ عَن عَتبي",39,"ب",2,1],["يا منجنون بحذف ثاني حرفه","إن كنت فاعل ما أرى فتحرّج",40,"ج",1,0],["يا مَنْ جفاني في الضّحى","وأَزارني وهْناً خيالَهْ",41,"ل",2,0],["يا مَن جَلا عينَ البعيدِ برَسْمِ ما","كانتْ بهِ أُذُنُ القريبِ تُشنَّفُ",42,"ف",1,0],["يا مَنْ جَعَلْتُ إِخاءَهُ لِي عُدَّةً","فِي يَوْمِ يَدَّخِرُالخَلِيلَ خليلُ",43,"ل",1,0],["يا من جلت دُرَّ لفظٍ جآءَ يخبرنا","عن لطف خُلقٍ أتى في الناس بالعجبِ",44,"ب",1,0],["يا مَن جَرى من أَدمعي ما كَفى","وَما اِكتَفى",45,"ف",2,0],["يا من جعلت ترابه ناصيتي","قد صوح نيتها اغثني بنداك",46,"ك",1,0],["يا من جعلنا ثناه ذخرنا ابدا","فعطر الارج الشحري ارجانا",47,"ن",2,0],["يا من جميعيَ مشغول بخدمته","أرحمْ لُجَيْنَ جدموعٍ فيكم ذهبا",48,"ب",2,0],["يا مَن جَفا النَومُ جَفني مِثلَ جَفوَتِهِ","صِف لِيَ المَنامَ فَإِنّي لَستُ أَعرِفُهُ",49,"ف",2,0],["يا منجي المعتر يا غوث الندا","يا ملجأ المضطر يا ذخر العديم",50,"م",1,0],["يا من جفانا ولو قد شاء كان إلى","جنابنا دون أهل الأرض ينعطف",51,"ف",1,0],["يا مَن جَمَعتَ اللُطفَ مِن بَين الوَرى","لَم تَتَّرِك لِسواكَ شَيئاً فَاِقنَعِ",52,"ع",1,0],["يا منجد الغرقى ويا","منجى العباد من المضار",53,"ر",1,0],["يا من جميع الخير فهو نواله","وله مواهب لا تحد ولا تعد",54,"د",1,0],["يا من جميع الفيض من نفحاته","وتفكر العقلاء في آياته",55,"ت",2,1],["يا مَنْ جَفا في القُرْبِ ثُمَّ نَأى","فَشَكا الهَوى بِالكُتْبِ والرُّسُلِ",56,"ل",1,1],["يا من جميعُ الحُسْنِ بعضُ صفاتِهِ","وحلاوةُ الدُّنيا تذاقُ بفيهِ",57,"ه",1,1],["يا من جَلالة وَجهها يَجلو العمى","يا شَمس يا مصباح يا بدر السما",58,"م",2,0],["يا منجنيق يا حريق النور","يا ترجمان هرجمان القاري",59,"ي",1,0],["يا من جفاني بغير جرمٍ","أقصر فقد نلت ما تريد",60,"د",1,0],["يا من جمال محياه وَرونقه","إليه قَد ساقَ ما يَختاره وَجبى",61,"ب",2,0],["يا من جعلت السلم يسطع نوره","في الجارتين وكم بذلت جهودا",62,"د",2,0],["يا مَن جفاه لا ينهي","ولا عليّ وصله رئيف",63,"ف",1,0],["يا من جعلت في الهوى الوصال حراماً","مَن قال بحلّ الجفا فديتك من قال",64,"ل",1,0],["يا من جعلوا وصالهم لي زادا","الشوق إلى حماكم بي زادا",65,"د",2,1],["يا منجياً من غمّه ذا النّون","من بعد ما أشفى على المَنُونِ",66,"ن",1,0],["يا مُنَجّي البَيتَ العَتيقَ قَديماً","نَجِّ مِصراً مِن اِبنِها مَحمودِ",67,"د",1,0],["يا منجدي والدهر يغمر جانبي","ومنبهي من نومة الأغفال",68,"ل",1,0],["يا منجدي والدهر يبعث حربه","شعثاء قد لبست رداء عَجاجها",69,"ج",3,1],["يا من جفا فجفاني الطيف هجرك لي","بأي عذر فعذر الطيف في السهر",70,"ر",1,0],["يا من جفا فارفقَن عليه","مستعبَداً لا يرى السراحا",71,"ح",2,0],["يا من جبينك مع الغرّه يوب","عن القمر والغزال الشاقره",72,"ر",2,0],["يا من جعلت إذا خطا","خدي له أرضاً ليرضى",73,"ض",2,1],["يا من جهلت من الأوطان قيمتها","ادخل حمى الليث تعرف قيمة الوطن",74,"ن",1,0],["يا من جلت لي معنى البدر طلعته","ممثلاً وهو بعض من معانيها",75,"ي",3,0],["يا من جميع الحسن منتظم","فيه كنظم الدر في العقد",76,"د",1,1],["يا مُنجِدَ الأمْلاكِ بالعزْمِ الذي","أبْدَى السّبيلَ لمُنجِدٍ ولمُتْهِمِ",77,"م",1,0],["يا من جمعت لنا بنفس حرة","لطف الغزال الى مروة ضيغمِ",78,"م",1,0],["يا من جننت به وذا عقلي الذي","يبدو على وجه الجنون براقع",79,"ع",1,0],["يا من جهلت مكانَ راغب في الورى","إعلم بأنك جاهل لسواه",80,"ا",2,0],["يا من جلت غلس الظلماء طلعته","وطلعة لبدر وهنا تذهب الغلسا",81,"س",2,0],["يا من جرى جوده والعفو في قرن","وحلمه فاض بين الناس واشتهرا",82,"ر",2,0],["يا مَن جعلت لعيسى في السَّما نُزُلاً","وَالقَوم قَد دمدموا والحزب يَزدحم",83,"م",1,0],["يا مَن جَفا قَسوةً ما كانَ أَلينَه","عَطفاً عَلَينا نُوافيه وَنَحترم",84,"م",1,0],["يامن جلاء الغواشي من طبائعه","والشمس تختص بالضوء النهاريّ",85,"ي",1,0],["يا منجداً ناديتهُ مُستنجداً","في خَلّتي والمرءُ يُنجدُ خِلَّهُ",86,"ل",2,0],["يا منجزاً كرماً من أرخوا ملأ","أنت الجواد يُجود غير محدودِ",87,"د",1,0],["يا من جعلت من التّوحُّدِ عيدنا","وإذا هللتَ فعيدنا عيدانِ",88,"ن",1,0],["يا من جميع الكائنات بأسرها","علواً وسفلاً دون ما استثناء",89,"ا",2,0],["يا من جفاني بعد ان سلب النهى","مني فليت الوجد بعدك بارح",90,"ح",1,0],["يا منجم الصبر لو أنَّ الصدى يصلُ","أيوب نادى وصاح السهلُ والجبلُ",91,"ل",1,1],["يا مَنْ جَعَلتَ غِراسَ قَلْبي زَهْرَةً","وَ سَقيتُ شَوقِي مِنْ حَنينِكَ مُرَّني",92,"ن",2,0],["يا مَن جعلتَ لحبّكَ الأعيادا","وأراكَ للرّأيِ الرّدي مُنقادا",93,"د",2,1],["يا مَن جمعتِ من الطوائفِ ثُلّةً","من تالدٍ أرسى هناكَ حواضرهْ",94,"ر",2,0],["يا من جفا ووفى للغير سوعده","يا من رمانا ويا من عقلنا قمرا",95,"ر",2,0],["يَا مَنْ جَعَلْتَ الشِّعْرَ يَبْدُو حِرْفَةً","الشِّعْرُ حِسٌّ لَا يَكُونُ مَعَاجِمَا",96,"م",2,0],["يَاْ مِنْجَمَ الخََلْقِ قَدْ أُذْخِرْتَ فِيْ مَلِكٍ","فِيْ جَوفِِهِ اجْتَمَعَتْ إِنْسَاْنُنَا فِيْهِ",97,"ي",2,0],["يا من جرى في وجود الغيث جودك","يا بحر المكارم جرى الماء في العود",98,"د",1,0],["يَا مَن جَعَلْتُ لَهُ الجَوزَاءَ مَملَكَةً","كُلُّ النُّجُومِ عَلَى أَسوَارِهَا جُندُ",99,"د",1,0],["يا مَنْ جعلتَ مصارعَ","العشّاقِ في عينيك فنّ",100,"ن",1,1],["يا منجياً في الجبِّ يوسفَ أنجن","الضرُّ مسَّ ولا أطيقُ تحمّلا",101,"ل",2,0],["يا منجياً في الجبِّ يوسفَ أنجني","الضرُّ مسَّ ولا أطيقُ تحمّلا",102,"ل",2,0],["يا منجب الصيد تعيا فيك قافيتي","ماذا يقول بوصف الوالد الولدُ ؟",103,"د",1,0],["يا من جنت يده عليه شقاءه","فأحاله قدراً هناك متاحا",104,"ح",2,1],["يا من جعلتَ الفكرَ لي قبساً سما","بجوارحي في ما قَلَتْهُ عيوبُ",105,"ب",1,0],["يا مَنْ جعلتِ حقيقةَ ًحُلُمَ الصبا","وملأت ِ أيّامي رضىً وسرورا",106,"ر",2,0],["يامن جهل بالحال والوضع بانعاش","مدام باقي روح لابد باعيش",107,"ش",1,0],["يا من جهلتم وربّ الناس يخبُركم","وعذركم داحض في الأصل مبتور",108,"ر",1,0],["يا منجب الأبناء والأحفاد","يا أظرف الآباء والأجداد",109,"د",1,1],["يا منْ جعلتِ الشعر أجمل زهرةٍ","هذا فؤادي فازرعيهِ ورودا",110,"د",2,0],["يا من جعلت اللَّامُهم مَهمةً","كبرى تفيد وجودنا الحيرانا",111,"ن",2,0],["يا من جعلتم كلَّ شخصٍ حولكم","أمثالَكم في الشغلِ والأخلاقِ",112,"ق",1,0],["يا من جلبت النور في أغواري","ضمدت جرحي أينعت أزهاري",113,"ر",2,1],["يَا من جفاني وأقصاني وغادرني","صبا واشمت بِي من كَانَ يلحاني",114,"ن",2,0],["يا مَنْ جَرَحْتِ حُشَاشَةَ المُشْتَاقِ","ظُلْماً بِشَبَا صَوَارِمِ الأَحْدَاقِ",115,"ق",1,1],["يا من جفا طرفي فأرقه","وخلا بقلبٍ حشوه جمر",116,"ر",1,0],["يامن جمعتَ شتاتَ الروحِ في جسدي","أُهديكَ روحي لتغفو فوقَ شطآني",117,"ن",2,0]]}