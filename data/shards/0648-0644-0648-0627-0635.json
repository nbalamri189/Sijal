{"poems":[[57,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[90,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[29,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[53,"جزى القاسم الحسنى محسن وجهه","https://www.aldiwan.net/poem62855.html","الطويل"],[53,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[47,"ألم تعلمي يا علو أني معذب","https://www.aldiwan.net/poem11437.html","الطويل"],[30,"تبكي على المنتوف بكر ابن وائل","https://www.aldiwan.net/poem5515.html","الطويل"],[35,"تقول العدا لا بارك الله في العدا","https://www.aldiwan.net/poem25843.html","الطويل"],[83,"تثقلت عن كبدي والحشا","https://www.aldiwan.net/poem61300.html","المتقارب"],[104,"أحرارنا قد كشفتم عن بطولتكم","https://www.aldiwan.net/poem32981.html","البسيط"],[8,"بالأرض أستاهم عجزا وأنفهم","https://www.aldiwan.net/poem21763.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42586","المنسرح"],[10,"","https://poetry.dctabudhabi.ae/diwan/poem/2126","الوافر"],[30,"تبكي على المنتوف بكر بن وائل","https://www.poetsgate.com/ViewPoem.aspx?id=22013",""],[173,"أبى الدهر أن يلقاك إلا محارباً","https://www.aldiwan.net/poem1599.html",""],[214,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[280,"لله قلعة بيران وعزتها","https://www.aldiwan.net/poem25443.html","البسيط"],[403,"أمست أمامةُ صمتاً ما تكلمنا","https://www.aldiwan.net/poem690.html",""],[466,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[556,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48827","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72255","الوافر"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96464","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146764","الطويل"],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[6031,"أَتَعْجَبُ من أتَانِكَ حِينَ أَنَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46351",""]],"verses":[["وَلَو أَصبَحَت تَسعى لِتوصِلَ بَينَنا","سَعِدتُ وَأَدرَكتُ الَّذي كُنتُ أَطلُبُ",0,"ب",1,0],["ولو أصاب البحر من عارها","لغار منه ماؤه وانحسر",1,"ر",1,0],["وَلَو أَصبَحَ الناسُ حَرباً عِدىً","لِقَيسٍ وَخِندِفَ ما ضارَها",2,"ر",3,0],["ولو أصبح الممدوح حياً تخيَّرتْ","له نفسُه ما يصطفي المتخير",3,"ر",1,0],["ولواصف في جملة من وصفه","شغلٌ لعمر أبيك عن تصنيفه",4,"ف",2,0],["وَلَو أَصبَحَت تَسعى قَصيرَةُ بَينَنا","سَعِدتُ وَأَدرَكتُ الَّذي كُنتُ أَطلُبُ",5,"ب",1,0],["وَلَو أَصبَحا مِن غَيرِ بَكرِ اِبنِ وائِلٍ","لَكانَ عَلى الجاني ثَقيلاً دِماهُما",6,"م",2,0],["وَلَو أَصبَحَت لَيلى تَدِبُّ عَلى العَصا","لَكانَ هَوى لَيلى جَديداً أَوائِلُه",7,"ه",1,0],["ولَو أصبحت منك فِي خِفَّةٍ","لَبَلَّغَهَا اللهُ آمَالَهَا",8,"ل",3,0],["ولو أُصيب بجرحٍ بعضُكم خطاً","فيها إذاً لرتعتم بالحفاواتِ",9,"ت",1,0],["وَلَو أَصابُوا كُراعاً لاَ طَعامَ لَهُم","لَم يُنضِجُوها وَلَو أَعطَوا لَها حَطَبا",10,"ب",2,0],["وَلَوْ أَصَخْنَا لِكُلِّ مُنْتَقِدٍ","فَكُلُّ شَيءٍ فِي الدَّهْرِ مُنْتَقَدُ",11,"د",1,0],["وَلَو أَصبَحتُ في جُشَمٍ هَدِيّاً","إِذاً أَصبَحتُ في دَنَسٍ وَفَقرِ",12,"ر",1,0],["وَلَوْ أصْبَحَا مِنْ غَيرِ بكْرِ بن وَائلٍ","لَكَانَ عَلى الجَاني ثَقِيلاً دِمَاهُمَا",13,"م",2,0],["وَلَو أَصبَحَت في دارِ بَكرٍ وَتَغلِبٍ","لَما رامَ أَن يَأتي لَها النَّذلُ خاطِبا",14,"ب",2,0],["ولو اصير ترابا في هواك فلا","اسلو لاني على الاشواق مجبول",15,"ل",1,0],["ولو أصغى أولو الألباب يوما","لهمس الوحي في تلك الروابي",16,"ب",2,0],["وَلَوْ أَصَرَّتْ عَلَى الإعْراضِ ثَانِيَةً","لأَصْبَحَتْ بَيْنَ تَخْريبٍ وَتَدْميرِ",17,"ر",1,0],["ولو أصابت لقالت وهي صادقَةٌ","إن الرياضَةَ لا تُنصِبكَ للشيبِ",18,"ب",1,0],["ولو أصاب عُباب البحر أيْسرُه","لأصبح البحرُ معدوداً من الوشل",19,"ل",1,0],["ولو أُصِبْتِ بداءٍ قد أصِبْتُ به","علمتِ ما في فؤادٍ بات يهواكِ",20,"ك",1,0],["ولو أصابوا لما خافوا ولا غضبوا","وكلكم خير مرضيٍّ ومأمون",21,"ن",1,0],["ولو أصغيت نحوك في سبيل ال","تجمل كان يمنعني وفائي",22,"ي",1,0],["وَلَو أَصبَحتُ فِى حَكَمٍ مُقِيما","وَخَفَّ الزَّحفُ لَم أَرهَب أَثَامَا",23,"م",2,0],["ولو أصغى لنغمتنا مليّاً","لذاب بذلك النغم المذيب",24,"ب",1,0],["ولو أصبحت داراً لك الأرض كلها","لضاقت بمن ينتاب دارك سائلا",25,"ل",2,0],["وَلَوْ اصْطَفَيْتُ سِواكَ كُنْتُ كَبائِعٍ","فِيما يَرُومُ يَقِينَهُ بِظُنُونِهِ",26,"ن",2,0],["ولَو أصْبَحتَ وحْدَكَ في بِسَاطِ ابْ","نِ دَاوودٍ لَمَالَ بِكَ البِسَاطُ",27,"ط",1,0]]}