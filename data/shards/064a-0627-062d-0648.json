{"poems":[[53,"عيني إلى من أحب تختلج","https://www.aldiwan.net/poem9241.html","المنسرح"],[119,"صاح يمم ان رمت نيل الاماني","https://www.aldiwan.net/poem40476.html","عموديه"],[215,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[505,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[505,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[508,"يا حوشب الجلف ويا شيخ كلع","https://www.aldiwan.net/poem21739.html","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136317","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136372","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118784","المديد"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126252","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133133","الرمل"],[5558,"احْذَرْ قِلاعي بلْ جُنودي","https://www.poetsgate.com/ViewPoem.aspx?id=211847",""],[5956,"لعنة الله على رأيِ طبيب بيطريٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=192230",""]],"verses":[["يا حُورُ ما للحبيب يفعل بي","أشياء لا يستحلُّها الحَرَجُ",0,"ج",1,0],["يا حويدي الاظعان ان سرت ليلا","وفرى العيس وجنة القيعان",1,"ن",1,0],["يا حوارِيّ في المعاني وحزنى","وجنودي فيما تثير شجوني",2,"ن",2,0],["يا حويدي المطي كم ذا التراخي","هيا بنا هيا لقصد الخيام",3,"م",1,0],["يا حُوَيْدي النِّياقِ طرْ بالنِّياقِ","واحْدِرَنْها إلى بِطاحِ العِرَاقِ",4,"ق",1,0],["يا حُوَيْدي النِّياقِ باللهِ عنِّي","بلِّغِ الحيَّ لوعَتي واحْتِراقي",4,"ق",2,0],["يا حُوَيْدي العِيسِ إِن سِرْتَ دُجاً","لبِطاحِ الشَّرقِ دونَ الكُثُبِ",5,"ب",1,0],["يَا حَوشَبُ الجِلفُ وَيَا شَيخَ كَلَع","أيُّكُمَا أَرَادَ أَشتَرَ النَّخَع",6,"ع",1,1],["يا حويدي المطي ان جزت يوماً","بربوع بها الاحبة خيم",7,"م",1,0],["يا حويد المطي قف عند سلع","فالمنى فيه والنقا والمصلى",8,"ل",2,0],["يا حويدي العيس فيه أنخ","واحذر التعريج عن نهره",9,"ر",2,0],["ياحويدى المطى قف بالمطايا","بفنا من أخى عهدنا وداده",10,"د",2,0],["يا حويدي الركب هل تدنوا إلي","تنظر أحوالي وتشرح ما لدي",11,"ي",1,1],["يا حويدي قل لأحبابي عسى","عودةٌ منكم تنجي ما رسا",11,"س",2,0],["يا حوتُ قد بَلَغَ التَكبُّرُ أَوجَهُ","احْذَرْ فإنّ الخَوضَ فِيَّ خَطيرُ",12,"ر",1,1],["يا حواسّاً لافتراسٍ دون حسٍّ","أ يُطيق الجوعَ ذا بطنُ الطبيبِ؟",13,"ب",1,0]]}