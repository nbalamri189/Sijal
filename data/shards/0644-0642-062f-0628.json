 في العلوم فإنهم","https://www.aldiwan.net/poem33941.html","الطويل"],[406,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[416,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[416,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[416,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[429,"لقد بلغ المعالي من تسامت","https://www.aldiwan.net/poem39851.html","الوافر"],[429,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[429,"تتهنى يا أمير المجد في","https://www.aldiwan.net/poem40838.html","الرمل"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[441,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[441,"من لائمي إن سفحت الدمع من مقلي","https://www.aldiwan.net/poem14476.html","البسيط"],[452,"لقد بشرتنا باقتبال وجدة","https://www.aldiwan.net/poem13691.html","الطويل"],[453,"سفارة كافور تعلممنا الهدى","https://www.aldiwan.net/poem61602.html","الطويل"],[464,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[464,"لقد بوركت يا بن المبارك بلدة","https://www.aldiwan.net/poem3187.html","عموديه"],[464,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[467,"لقد برأم البو الصحور وقد ترى","https://www.aldiwan.net/poem2051.html","الطويل"],[470,"تذكر سلمى بعد ما حال دونها","https://www.aldiwan.net/poem4693.html","الطويل"],[477,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[513,"لقد باعدت عنك أخا شقيقا","https://www.aldiwan.net/poem67746.html","الوافر"],[534,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[553,"عاود عزاءك لا يعنف بك الذكر","https://www.aldiwan.net/poem68392.html","البسيط"],[558,"لقد بت من فرط الأسى طول ليلتي","https://www.aldiwan.net/poem34706.html","الطويل"],[586,"أما ولآل من شتيت ابتسامه","https://www.aldiwan.net/poem17501.html","الطويل"]],"verses":[["لَقَد بَقِيَت مِنَ الدُنيا حُطاماً","بِأَيدينا وَقَد عَزَّ الحُطامُ",0,"م",1,0],["لَقَد بِتُّ مَحسوداً عَلَيكَ لِأَنَّني","فَتاكَ وَهَل غَيرُ المُنَعَّمِ يُحسَدُ",1,"د",1,1],["لَقَد بَلَّغَتني دَواعي هَواكَ","إِلى غايَةٍ ما جَرَت لي بِبالِ",2,"ل",1,0],["لَقَد بَكَرَ الناعي عَلَينا بِدَعوَةٍ","عَوانٍ أَمَضَّتنا لَها لَوعَةٌ بِكرُ",3,"ر",1,0],["لَقَدْ بَيَّنْتِ مَا نَهَجَ التَّصَافِي","بِأَبْلَغِ حِجَّةٍ وَأَسَدِّ رأْيِ",4,"ي",1,0],["لَقَدْ بُتْنَا وَنَحْنُ عَلَى يَقِينٍ","فَأَصْبَحْنَا وَلَيْسَ لَنَا يَقِينُ",5,"ن",1,0],["لَقَدْ بَدَا مَا تَخَافُ صَوْلَتَهُ","فَارْمِ وَإِلاَّ رُمِيتَ مِنْ أُمَمِ",6,"م",1,0],["لَقَدْ بَكَيْنَاهُ وَالْعَلْيَاءُ مُسْعِدَةٌ","مُشَيِّعِيهِ بِدَمْعِ العَارِضِ الهَطِلِ",7,"ل",1,0],["لَقدَ بَلَّتِ الأَخماسَ مِنكَ بِسائِسٍ","هَنيِء الجَدا مُرّ العُقوبَةِ ناسِكِ",8,"ك",1,0],["لقد بان صبري يوم بينك إذ قضى","به صرف دهر لم يزل يتقلّب",9,"ب",1,0],["لقد بقيت للخالديين بعده","مناقب غرّ دونهنّ الفراقد",10,"د",1,0],["لقد بتّ مطروف النواظر بالسُّهد","تقلّبني فوق الفراش يد الوجْد",11,"د",1,1],["لَقَد بُنِيَت يَوماً بُيوتُ مُجاشِعٍ","عَلى الخُبثِ حَتّى قَد أُصِلَّت قُعورُها",12,"ر",3,0],["لَقَد بَعَثَت هِزّانُ جَفنَةَ وافِداً","فَآبَ وَأَحذى قَومَهُ شَرَّ مَغنَمِ",13,"م",1,0],["لقد بلغت كلب بسبي حُظوة","كفتها قديمات الفضائح والوصبِ",14,"ب",1,0],["لَقَد بُدِّلَت نَجرانُ بَعدَ مُلوكِها","مَخاليفَ سوءٍ قَومُها وَنِساؤُها",15,"ا",3,1],["لقد بشّرتني بلحاقِ ماضٍ","أحبَّ إليَّ من بَرْدِ الشرابِ",16,"ب",1,0],["لَقَد بَلَغَت بِهِ روحي التَراقي","وَقَد نَظَرَت بِهِ عَيني الهَلاكا",17,"ك",2,0],["لَقَد بَسَطتُكَ حَتّى رُحتُ مُنبَسِطاً","إِنَّ الكَريمَ عَنِ الفَحشاءِ يَنقَبِضُ",18,"ض",1,0],["لَقَد بانَ مِن تاريخِهِ في هِزَّةٌ","فَقُل في كِتابٍ بِالسُرورِ مُؤَرَّخِ",19,"خ",1,0],["لَقَد بانَ لي أَشياءُ مِنكَ تُريبُني","وَهَيهاتَ يَخفى مَن يَكونُ مُريبا",20,"ب",2,0],["لَقَد بَسَطَ اللَهُ المَكارِمَ مِن كَفّي","فَلَستُ عَلى العلاّت مِنها أَخا كَفِّ",21,"ف",1,1],["لقد بات ذاك الوجه في ذمة الثرى","فعل الثرى إذ ضمه غير هارد",22,"د",1,0],["لقد بكى سامعه","فدمعه منسجم",23,"م",1,0],["لقد بلغت من السبعين غايتها","والقبر لي بعد هذا العمر ينتظر",24,"ر",1,0],["لقد بات عندي طيف ليلى مواصلا","فجيد الى جيد ونحر الى نحر",25,"ر",1,0],["لقد بيضت للملك الليالي","فليل الملك بالزينات حالي",26,"ي",1,0],["لَقَد بَدَّلَكَ الدَهرُ","مِنَ الإِقبالِ إِدبارَه",27,"ر",2,0],["لَقَد بَعَثَ اللَهُ عَهدَ الفُنونِ","وَأَخرَجَتِ الأَرضُ مَثّالَها",28,"ل",3,0],["لَقَد بَيَّضتَ لِلمُلكِ اللَيالي","بِسَيفٍ يَفضَحُ الفَجرَ المُبينا",29,"ا",1,0],["لقد بغَّضَ المرآةَ عنديَ أنَّها","تطالعُني بالشيبِ من كل جانبِ",30,"ب",1,1],["لَقَد بَسَطَ الآمالُ حادِثُ وَقعَةٍ","بِدِجلَةَ أَجرَتها دِماءً فَمُدَّتِ",31,"ت",1,0],["لَقَد بَعَثتُ عِتاقَ الخَيلِ سارِيَةً","مِثلَ القَطا الجونِ يَتبَعنَ القَطا الجونا",32,"ن",2,0],["لَقَد بانَ لَم يُسبَق بِوِترٍ وَلَم يَدَع","إِلى الغَرَضِ الأَقصى مِنَ المَجدِ مَنزَعا",33,"ع",2,0],["لَقَد بانَ لِلغاوي مَفاخِرُ أَصبَحَت","عَلى الناسِ مِنّي كَالنَهارِ مُبينُها",34,"ن",3,1],["لَقَد بالَيتُ مَظعَنَ أُمِّ أَوفى","وَلَكِن أُمُّ أَوفى لا تُبالي",35,"ي",1,0],["لَقَد بُلِغتُ ما قالا","فَما بالَيتُ ما قالا",36,"ل",2,0],["لَقَد بِعتُهُ قَلبي بِخَلوَةِ ساعَةٍ","فَأَصبَحَ حَقّاً ثابِتاً مِن حُقوقِهِ",37,"ق",2,0],["لَقَد بَسَمَت لَنا الأَيّامُ لَمّا","بَذَلتَ لَنا مُحَيّاً غَيرَ جَهمِ",38,"م",1,0],["لقد بَهَرَتْ شهبَ الدراري منيرةً","مآثرُ منكمْ لا يكاثِرُهَا الرّمْلُ",39,"ل",1,0],["لقدْ بلغَ المنى قبرٌ حواهُ","أتتسعُ المقابرُ للبحورِ",40,"ر",1,0],["لقد بُلينا بمالكيٍّ","يقدحُ في التركِ كلَّ حينِ",41,"ن",1,1],["لَقَد بِتُّ بَينَ الرَعدِ وَالقَطرِ أَشتَكي","بِسَمعِيَ مِن وَقرٍ وَظَهرِيَ مِن وَقرِ",42,"ر",1,0],["لَقَد باعَدَت نَفساً عَلَيها شَفيقَةً","وَقَلباً عَصى فيها الحَبيبَ المُقَرَّبا",43,"ب",2,0],["لَقَد بَلَغَ الوَفاءُ فَأَخبِرونا","بِقَتلى مَن تُقَتِّلُنا رِياحُ",44,"ح",1,0],["لَقَد بَلَغَ الشَيطانُ مِن آلِ هاشِمٍ","مَبالِغَهُ مِن قَبلُ في آلِ يوسُفِ",45,"ف",1,0],["لَقَد بَلِيَت نَفسي بِمَن لا يُجيبُني","وَذاكَ عَذابٌ فَوقَ كُلِّ عَذابِ",46,"ب",1,1],["لقد بات يسري في جنوبك لابسا","لعزمك طَبُ بالجياد رفيق",47,"ق",1,0],["لَقَد بَسَطَ الرَحمَنُ مِنّي مَوَدَّةً","إِلَيها وَمِن قَومٍ لَدَيَّ جُلوسِ",48,"س",1,0],["لَقَد بَرَحَت طَيرٌ وَلَستُ بِعائِفٍ","وَإِن هاجَ لي بَعضَ الغَرامِ بُروحُها",49,"ح",3,1],["لَقَد بُدِّلتُ حالاً بَعدَ حالٍ","فَصِرتُ إِلى الغُرورِ مِنَ الغُرورِ",50,"ر",1,0],["لَقَد بَعِلَ المَرءُ عَمرٌو بِها","فَصُدَّ عَنِ الكاسِ في بَعلَبَك",51,"ك",1,0],["لَقَد بَكَّرَت في خِفِّها وَإِزارِها","لِتَسأَلَ بِالأَمرِ الضَريرَ المُنَجِّما",52,"م",2,1],["لقد بَتَّ حبلَ الوصلِ وهو وثيقُ","حُسامٌ منَ الهِجْرانِ ليسَ يَليقُ",53,"ق",1,0],["لَقَد بكتك مَعاليك الَّتي اِشتهرت","وَهذه الناس من ترك ومن عرب",54,"ب",1,0],["لقد بُعثتْ من الأحقابِ مِصرٌ","أَجل بُعِثت وهبَّ اليوم شعْبُ",55,"ب",1,0],["لَقَد بَعَثَ المُهاجِرَ أَهلُ عَدلٍ","بِعَهدٍ تَطمَئِنُّ بِهِ القُلوبُ",56,"ب",1,0],["لَقَدْ بَعَثَ اللهُ الْقَرِيضَ وَأَنْشَرَتْ","لَهُ دَوْلَةُ العَبَّاسِ مُلْكاً مُؤَيَّدَا",57,"د",2,0],["لَقَدْ بِتَّ مِنْهُمْ فِي المقَامِ الَّذِي بِهِ","إِذَا ذُكِرَ الأَفْذاذُ فِي الخَلْقِ تُذْكَرُ",58,"ر",1,0],["لَقَد بَلاكَ اللَهُ في الد","دنيا وَلكِن أَجَرَك",59,"ك",1,0],["لقد بان صبري يوم ببنيك إذ قضى","به صرف دهر لم يزل يتقلب",60,"ب",1,0],["لقد بعثَ المهاجرَ أهلُ عدلٍ","بعهدٍ تطمنُّ بهِ القلوبُ",61,"ب",1,0],["لقد بخلوا حتى برد سلامنا","وكانوا لعمر المجد اسخى من السحب",62,"ب",1,0],["لقد برزت إلى هولِ المنايا","وجوهٌ كان يحجبُها اللثامُ",63,"م",1,0],["لقد بت أمس كما بت أنت","عثاري دثاري ويأمي وماد",64,"د",1,1],["لقد بت أمس كما بت أنت","جزوعاً خشوعاً مروع الفؤاد",64,"د",1,0],["لقد بت أَمس كما بت أَنت","عثاري دثاري ويأسي وساد",64,"د",1,0],["لَقَد بَلَغَت أَبناءُ صَعصَعَةٍ بِكُم","ذُرى شَرَفٍ لا تَدَّعيهِ الكَواكِبُ",65,"ب",1,0],["لَقَد بَنَيتَ غِياثَ المُسلِمينَ لَهُم","بِالجِدِّ وَالجَدِّ عِزّاً لَيسَ يَنهَدِمُ",66,"م",1,0],["لَقَد بَغى نَصرَ قاصٍ قَصَّرَت يَدُهُ","عَن نَصرِ مَن دارُهُ مِن دارِهِ أَمَمُ",66,"م",1,0],["لَقَد بَهَرَ الأَنوارَ شُعاعِهِ","وَقامَ بِأَمرِ اللَهِ جُهدَ اِضطِلاعِهِ",67,"ه",1,0],["لَقَد بَهَرَت شَمسَ الضحى مُعجِزاتُهُ","بَراهينُهُ لا تَنقَضي وَهِباتُهُ",68,"ه",1,0],["لقد بَرَّحَ البَيْنُ المُبَرِّحُ والحبُّ","بقلبي وهل يبقى عَلَى لوعةٍ قلبُ",69,"ب",1,1],["لقد بارت بهم صرعى ظباه","كذا كنا ويوشك أن تكونوا",70,"ن",3,0],["لقد بيضت راياتك البيض وجهه","وأبقت له ذكراً تدوم خلوده",71,"د",2,0],["لقد بعتها حري عليك رخيصة","وكانت بهذا منك غير حقيقة",72,"ه",1,0],["لَقَد بَذَلُوا المَجهودَ فيما يَسوءُني","وَقَد كُنتُ أَرمي دونَهُم وَأُجالِدُ",73,"د",1,0],["لَقَد بَناها الجُرَيجيريُّ أَسقُفُنا","بَيتاً لِبُطرسَ تَسعى نَحوَهُ البَشَرُ",74,"ر",1,1],["لقد بانَ عني منكمُ كلُّ سيدٍ","هو الفضلُ أو فالفضلُ منه مَصُوغ",75,"غ",1,0],["لقد بلغَ الإقبالُ بي غاية المنى","وجار كذاك البدر في التمّ يكسف",76,"ف",1,0],["لقد بعدت شقة بيننا","ولو أن حلفاً لكم منزل",77,"ل",1,0],["لَقَد بَطِرتَ فَلَم تُستَر مُخَدّرَةٌ","وَقَد زَنَيتَ فَلَم يَهنَأ حَبيبانِ",78,"ن",1,0],["لَقَد بَلَغَت بِهِم الحِدَّه","فَمن أَيِّنا نَطلُب النَجدَه",79,"د",2,1],["لَقد بوغِتَت تلك المُنى فَتَصرَّمَت","وَلم تَقضِ منها النَفسُ أَيسَرَ سولِها",80,"ل",3,0],["لقد برأ الخلق ابتداء من الثرى","بلا مسعد فيما يسوّى ويصنع",81,"ع",1,0],["لقد بتّ من مجلى السرور بروضةٍ","جنى العمرُ من أزهارها زينةَ الدنيا",82,"ي",2,0],["لقد بعدت عنهُ فظلّت قريبة","من القلبِ إن القلبَ عشّاقُ أوهام",83,"م",1,0],["لَقَدْ بَاتَ أَهْلُوها بِلَيْلَةِ مَاخِضٍ","وَقَدْ عَضَّلَتْ وَضْعاً وَمَا فَتَرَتْ طَلْقَا",84,"ق",2,0],["لَقَدْ بَرَّحَتْ كَفّاكَ فِي الْجُودِ بِالْحَيا","فَلا عاقَها إِلاّ عَنِ الْبُخْلِ عائِقُ",85,"ق",1,0],["لَقَد بَعُدَت مِنّي زَرودٌ وَأَينَ مِن","كَئيبٍ بِأَبوابِ البَريدِ زَرودُ",86,"د",1,0],["لَقَد بَثَّ بَدرُ الدينِ أَنوارَ عَدلِهِ","وَإِحسانِهِ حَتّى اِنجَلا كُلُّ غَيهَبِ",87,"ب",1,0],["لَقَد بَلَغت مِنها الرياضةُ مبلغاً","تَناهَت بِهِ ثقفاً وطوعاً لِمَن أَمطى",88,"ط",2,0],["لَقد بَدّلَت بالكفرِ نِعمة ربّها","وَوشكانَ منثوراً بِنعمى كنودها",89,"د",3,0],["لَقَدْ بَرَدَ الهواءُ عَلَيَّ فارحَمْ","فَما حالُ السِّراجِ مَعَ الهَواءِ",90,"ا",2,0],["لَقَد بَيَّنَت لِلعَينِ أَحداجُها مَعاً","عَلَيهِنَّ حو