poetsgate.com/ViewPoem.aspx?id=201407",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5956,"هلال ونجمة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182427",""],[5956,"جلادُ بيتي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182553",""],[5956,"سَقامٌ وبيلٌ بعادكِ عني","https://www.poetsgate.com/ViewPoem.aspx?id=193938",""],[6035,"رسالة إلى الجار ، والآخر هناك !","https://www.poetsgate.com/ViewPoem.aspx?id=176961",""],[6035,"عَمائمُ الحقد حرفُ الإفك طَرَّزَها .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177145",""],[6052,"وقفة على البحر الميت","https://www.poetsgate.com/ViewPoem.aspx?id=35193",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[6093,"تَزيدُ قناعتيْ حِيْناً فحيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177693",""],[6259,"ألمتْ ودوني من تهامة بيدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59367&r=&rc=15",""],[4222,"بلغت بالجد ما لا يبلغ البشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52782&r=&rc=74",""]],"verses":[["لَقَد بَقِيَت مِنَ الدُنيا حُطاماً","بِأَيدينا وَقَد عَزَّ الحُطامُ",0,"م",1,0],["لَقَد بِتُّ مَحسوداً عَلَيكَ لِأَنَّني","فَتاكَ وَهَل غَيرُ المُنَعَّمِ يُحسَدُ",1,"د",1,1],["لَقَد بَلَّغَتني دَواعي هَواكَ","إِلى غايَةٍ ما جَرَت لي بِبالِ",2,"ل",1,0],["لَقَد بَكَرَ الناعي عَلَينا بِدَعوَةٍ","عَوانٍ أَمَضَّتنا لَها لَوعَةٌ بِكرُ",3,"ر",1,0],["لَقَدْ بَيَّنْتِ مَا نَهَجَ التَّصَافِي","بِأَبْلَغِ حِجَّةٍ وَأَسَدِّ رأْيِ",4,"ي",1,0],["لَقَدْ بُتْنَا وَنَحْنُ عَلَى يَقِينٍ","فَأَصْبَحْنَا وَلَيْسَ لَنَا يَقِينُ",5,"ن",1,0],["لَقَدْ بَدَا مَا تَخَافُ صَوْلَتَهُ","فَارْمِ وَإِلاَّ رُمِيتَ مِنْ أُمَمِ",6,"م",1,0],["لَقَدْ بَكَيْنَاهُ وَالْعَلْيَاءُ مُسْعِدَةٌ","مُشَيِّعِيهِ بِدَمْعِ العَارِضِ الهَطِلِ",7,"ل",1,0],["لَقدَ بَلَّتِ الأَخماسَ مِنكَ بِسائِسٍ","هَنيِء الجَدا مُرّ العُقوبَةِ ناسِكِ",8,"ك",1,0],["لقد بان صبري يوم بينك إذ قضى","به صرف دهر لم يزل يتقلّب",9,"ب",1,0],["لقد بقيت للخالديين بعده","مناقب غرّ دونهنّ الفراقد",10,"د",1,0],["لقد بتّ مطروف النواظر بالسُّهد","تقلّبني فوق الفراش يد الوجْد",11,"د",1,1],["لَقَد بُنِيَت يَوماً بُيوتُ مُجاشِعٍ","عَلى الخُبثِ حَتّى قَد أُصِلَّت قُعورُها",12,"ر",3,0],["لَقَد بَعَثَت هِزّانُ جَفنَةَ وافِداً","فَآبَ وَأَحذى قَومَهُ شَرَّ مَغنَمِ",13,"م",1,0],["لقد بلغت كلب بسبي حُظوة","كفتها قديمات الفضائح والوصبِ",14,"ب",1,0],["لَقَد بُدِّلَت نَجرانُ بَعدَ مُلوكِها","مَخاليفَ سوءٍ قَومُها وَنِساؤُها",15,"ا",3,1],["لقد بشّرتني بلحاقِ ماضٍ","أحبَّ إليَّ من بَرْدِ الشرابِ",16,"ب",1,0],["لَقَد بَلَغَت بِهِ روحي التَراقي","وَقَد نَظَرَت بِهِ عَيني الهَلاكا",17,"ك",2,0],["لَقَد بَسَطتُكَ حَتّى رُحتُ مُنبَسِطاً","إِنَّ الكَريمَ عَنِ الفَحشاءِ يَنقَبِضُ",18,"ض",1,0],["لَقَد بانَ مِن تاريخِهِ في هِزَّةٌ","فَقُل في كِتابٍ بِالسُرورِ مُؤَرَّخِ",19,"خ",1,0],["لَقَد بانَ لي أَشياءُ مِنكَ تُريبُني","وَهَيهاتَ يَخفى مَن يَكونُ مُريبا",20,"ب",2,0],["لَقَد بَسَطَ اللَهُ المَكارِمَ مِن كَفّي","فَلَستُ عَلى العلاّت مِنها أَخا كَفِّ",21,"ف",1,1],["لقد بات ذاك الوجه في ذمة الثرى","فعل الثرى إذ ضمه غير هارد",22,"د",1,0],["لقد بكى سامعه","فدمعه منسجم",23,"م",1,0],["لقد بلغت من السبعين غايتها","والقبر لي بعد هذا العمر ينتظر",24,"ر",1,0],["لقد بات عندي طيف ليلى مواصلا","فجيد الى جيد ونحر الى نحر",25,"ر",1,0],["لقد بيضت للملك الليالي","فليل الملك بالزينات حالي",26,"ي",1,0],["لَقَد بَدَّلَكَ الدَهرُ","مِنَ الإِقبالِ إِدبارَه",27,"ر",2,0],["لَقَد بَعَثَ اللَهُ عَهدَ الفُنونِ","وَأَخرَجَتِ الأَرضُ مَثّالَها",28,"ل",3,0],["لَقَد بَيَّضتَ لِلمُلكِ اللَيالي","بِسَيفٍ يَفضَحُ الفَجرَ المُبينا",29,"ا",1,0],["لقد بغَّضَ المرآةَ عنديَ أنَّها","تطالعُني بالشيبِ من كل جانبِ",30,"ب",1,1],["لَقَد بَسَطَ الآمالُ حادِثُ وَقعَةٍ","بِدِجلَةَ أَجرَتها دِماءً فَمُدَّتِ",31,"ت",1,0],["لَقَد بَعَثتُ عِتاقَ الخَيلِ سارِيَةً","مِثلَ القَطا الجونِ يَتبَعنَ القَطا الجونا",32,"ن",2,0],["لَقَد بانَ لَم يُسبَق بِوِترٍ وَلَم يَدَع","إِلى الغَرَضِ الأَقصى مِنَ المَجدِ مَنزَعا",33,"ع",2,0],["لَقَد بانَ لِلغاوي مَفاخِرُ أَصبَحَت","عَلى الناسِ مِنّي كَالنَهارِ مُبينُها",34,"ن",3,1],["لَقَد بالَيتُ مَظعَنَ أُمِّ أَوفى","وَلَكِن أُمُّ أَوفى لا تُبالي",35,"ي",1,0],["لَقَد بُلِغتُ ما قالا","فَما بالَيتُ ما قالا",36,"ل",2,0],["لَقَد بِعتُهُ قَلبي بِخَلوَةِ ساعَةٍ","فَأَصبَحَ حَقّاً ثابِتاً مِن حُقوقِهِ",37,"ق",2,0],["لَقَد بَسَمَت لَنا الأَيّامُ لَمّا","بَذَلتَ لَنا مُحَيّاً غَيرَ جَهمِ",38,"م",1,0],["لقد بَهَرَتْ شهبَ الدراري منيرةً","مآثرُ منكمْ لا يكاثِرُهَا الرّمْلُ",39,"ل",1,0],["لقدْ بلغَ المنى قبرٌ حواهُ","أتتسعُ المقابرُ للبحورِ",40,"ر",1,0],["لقد بُلينا بمالكيٍّ","يقدحُ في التركِ كلَّ حينِ",41,"ن",1,1],["لَقَد بِتُّ بَينَ الرَعدِ وَالقَطرِ أَشتَكي","بِسَمعِيَ مِن وَقرٍ وَظَهرِيَ مِن وَقرِ",42,"ر",1,0],["لَقَد باعَدَت نَفساً عَلَيها شَفيقَةً","وَقَلباً عَصى فيها الحَبيبَ المُقَرَّبا",43,"ب",2,0],["لَقَد بَلَغَ الوَفاءُ فَأَخبِرونا","بِقَتلى مَن تُقَتِّلُنا رِياحُ",44,"ح",1,0],["لَقَد بَلَغَ الشَيطانُ مِن آلِ هاشِمٍ","مَبالِغَهُ مِن قَبلُ في آلِ يوسُفِ",45,"ف",1,0],["لَقَد بَلِيَت نَفسي بِمَن لا يُجيبُني","وَذاكَ عَذابٌ فَوقَ كُلِّ عَذابِ",46,"ب",1,1],["لقد بات يسري في جنوبك لابسا","لعزمك طَبُ بالجياد رفيق",47,"ق",1,0],["لَقَد بَسَطَ الرَحمَنُ مِنّي مَوَدَّةً","إِلَيها وَمِن قَومٍ لَدَيَّ جُلوسِ",48,"س",1,0],["لَقَد بَرَحَت طَيرٌ وَلَستُ بِعائِفٍ","وَإِن هاجَ لي بَعضَ الغَرامِ بُروحُها",49,"ح",3,1],["لَقَد بُدِّلتُ حالاً بَعدَ حالٍ","فَصِرتُ إِلى الغُرورِ مِنَ الغُرورِ",50,"ر",1,0],["لَقَد بَعِلَ المَرءُ عَمرٌو بِها","فَصُدَّ عَنِ الكاسِ في بَعلَبَك",51,"ك",1,0],["لَقَد بَكَّرَت في خِفِّها وَإِزارِها","لِتَسأَلَ بِالأَمرِ الضَريرَ المُنَجِّما",52,"م",2,1],["لقد بَتَّ حبلَ الوصلِ وهو وثيقُ","حُسامٌ منَ الهِجْرانِ ليسَ يَليقُ",53,"ق",1,0],["لَقَد بكتك مَعاليك الَّتي اِشتهرت","وَهذه الناس من ترك ومن عرب",54,"ب",1,0],["لقد بُعثتْ من الأحقابِ مِصرٌ","أَجل بُعِثت وهبَّ اليوم شعْبُ",55,"ب",1,0],["لَقَد بَعَثَ المُهاجِرَ أَهلُ عَدلٍ","بِعَهدٍ تَطمَئِنُّ بِهِ القُلوبُ",56,"ب",1,0],["لَقَدْ بَعَثَ اللهُ الْقَرِيضَ وَأَنْشَرَتْ","لَهُ دَوْلَةُ العَبَّاسِ مُلْكاً مُؤَيَّدَا",57,"د",2,0],["لَقَدْ بِتَّ مِنْهُمْ فِي المقَامِ الَّذِي بِهِ","إِذَا ذُكِرَ الأَفْذاذُ فِي الخَلْقِ تُذْكَرُ",58,"ر",1,0],["لَقَد بَلاكَ اللَهُ في الد","دنيا وَلكِن أَجَرَك",59,"ك",1,0],["لقد بلوت الدهر في عفوته","فكدر الصفو وجد ما عقى",60,"ا",1,0],["لقد بلوتُ الدهر في عفوته","فكدَّر الصوف وجدَّ ما عقى",61,"ا",1,0],["لقد باع في ذات الجهادين نفسه","فما اربح البيع العظيم وافضلا",62,"ل",2,0],["لقد بان صبري يوم ببنيك إذ قضى","به صرف دهر لم يزل يتقلب",63,"ب",1,0],["لقد بعثَ المهاجرَ أهلُ عدلٍ","بعهدٍ تطمنُّ بهِ القلوبُ",64,"ب",1,0],["لقد بخلوا حتى برد سلامنا","وكانوا لعمر المجد اسخى من السحب",65,"ب",1,0],["لقد برزت إلى هولِ المنايا","وجوهٌ كان يحجبُها اللثامُ",66,"م",1,0],["لقد بت أمس كما بت أنت","عثاري دثاري ويأمي وماد",67,"د",1,1],["لقد بت أمس كما بت أنت","جزوعاً خشوعاً مروع الفؤاد",67,"د",1,0],["لقد بت أَمس كما بت أَنت","عثاري دثاري ويأسي وساد",67,"د",1,0],["لَقَد بَلَغَت أَبناءُ صَعصَعَةٍ بِكُم","ذُرى شَرَفٍ لا تَدَّعيهِ الكَواكِبُ",68,"ب",1,0],["لَقَد بَنَيتَ غِياثَ المُسلِمينَ لَهُم","بِالجِدِّ وَالجَدِّ عِزّاً لَيسَ يَنهَدِمُ",69,"م",1,0],["لَقَد بَغى نَصرَ قاصٍ قَصَّرَت يَدُهُ","عَن نَصرِ مَن دارُهُ مِن دارِهِ أَمَمُ",69,"م",1,0],["لَقَد بَهَرَ الأَنوارَ شُعاعِهِ","وَقامَ بِأَمرِ اللَهِ جُهدَ اِضطِلاعِهِ",70,"ه",1,0],["لَقَد بَهَرَت شَمسَ الضحى مُعجِزاتُهُ","بَراهينُهُ لا تَنقَضي وَهِباتُهُ",71,"ه",1,0],["لقد بَرَّحَ البَيْنُ المُبَرِّحُ والحبُّ","بقلبي وهل يبقى عَلَى لوعةٍ قلبُ",72,"ب",1,1],["لقد بارت بهم صرعى ظباه","كذا كنا ويوشك أن تكونوا",73,"ن",3,0],["لقد بيضت راياتك البيض وجهه","وأبقت له ذكراً تدوم خلوده",74,"د",2,0],["لقد بعتها حري عليك رخيصة","وكانت بهذا منك غير حقيقة",75,"ه",1,0],["لَقَد بَذَلُوا المَجهودَ فيما يَسوءُني","وَقَد كُنتُ أَرمي دونَهُم وَأُجالِدُ",76,"د",1,0],["لَقَد بَناها الجُرَيجيريُّ أَسقُفُنا","بَيتاً لِبُطرسَ تَسعى نَحوَهُ البَشَرُ",77,"ر",1,1],["لقد بانَ عني منكمُ كلُّ سيدٍ","هو الفضلُ أو فالفضلُ منه مَصُوغ",78,"غ",1,0],["لقد بلغَ الإقبالُ بي غاية المنى","وجار كذاك البدر في التمّ يكسف",79,"ف",1,0],["لقد بعدت شقة بيننا","ولو أن حلفاً لكم منزل",80,"ل",1,0],["لَقَد بَطِرتَ فَلَم تُستَر مُخَدّرَةٌ","وَقَد زَنَي