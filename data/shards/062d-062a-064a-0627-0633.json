ww.poetsgate.com/ViewPoem.aspx?id=201336",""],[5431,"الحب دربٌ آمنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201942",""],[5431,"جنون مثلي...3","https://www.poetsgate.com/ViewPoem.aspx?id=212848",""],[2553,"يا دار عمرة","https://www.poetsgate.com/ViewPoem.aspx?id=1423",""],[5455,"الأسرار","https://www.poetsgate.com/ViewPoem.aspx?id=34367",""],[5528,"قلب على مسرح الاحتضار","https://www.poetsgate.com/ViewPoem.aspx?id=201290",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[5582,"هَبَّتْ تُغَرِّدُ مِنْ فَوْقِ الأَمالِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63490",""],[5582,"هَذِي أُمَيْمٌ تَجَلَّى شَخْصُها وَبَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63503",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5736,"لعنة الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=208873",""],[5861,"شكوى أم","https://www.poetsgate.com/ViewPoem.aspx?id=188057",""],[5910,"حتى استقلَّت بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=206284",""],[6052,"ثمار الخير","https://www.poetsgate.com/ViewPoem.aspx?id=35377",""],[6127,"ظلمة واهمة","https://www.poetsgate.com/ViewPoem.aspx?id=188639",""],[6142,"يا فاتحا مغلق الأمصار أجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=155743",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[463,"أفلحَ قومٌ إذا دعوا وثبوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59958&r=&rc=14",""],[6253,"روما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6421&r=&rc=3",""],[6262,"الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80112&r=&rc=10",""],[6366,"ما لم يقله الرّسّام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86676&r=&rc=4",""]],"verses":[["حَتّى اِستَباحوا آلَ عَوفٍ عَنوَةً","بِالمَشرَفِيِّ وَبِالوَشيجِ الذُبَّلِ",0,"ل",1,0],["حَتّى اِستَفَقتُ أَخيراً بَعدَما نُكِحَت","كَأَنَّما كانَ ذاكَ القَلبُ حَيرانا",1,"ن",2,0],["حَتّى اِستَخَفَّ بِحَقِّ اللَهِ أَكثَرُهُم","وَفي الَّذي حَمَلوا مِن حَقِّهِ شُغِلوا",2,"ل",3,0],["حَتّى اِستَحَلَّوا قِسمَةَ السُجودِ","وَالمَسحَ بِالأَيدي مِنَ الصَعيدِ",3,"د",1,0],["حتى استجار الليل من لفحاتها","ركبٌ سرَوا فهدتهم الجَوزاء",4,"ا",2,0],["حتى استقلّوا كالكواكب فوقنا","تجلو الظلام بنورها المتهلِّل",5,"ل",1,0],["حتى استحال الكرخ مشهد أبْؤس","تبكي به الفتيان والفَتَيات",6,"ت",1,0],["حَتّى استَرَحنَ إِلَيكَ مِن طولِ السُرى","وَمِنَ الحَفا وَسَرائِحِ التَخديمِ",7,"م",1,0],["حتى استعر","وهج الفكر",8,"ر",1,0],["حتَّى اسْتقام عمود الدين وانْفتحت","سبل الهدى وخبت تلك الأضاليل",9,"ل",1,0],["حتَّى اسمه منتقص لمنْ وعى","كما يقال في سُعاد يا سُعا",10,"ع",2,0],["حتى استمال من العدوِّ مودَّةً","ما ألقيتْ لمقدِّرٍ في رُوع",11,"ع",1,0],["حتى استقلَّتْ به قُواهُ كما","كان وأضحَى سكُونُهُ حَركا",12,"ك",2,0],["حَتّى اِستَبانَت مَعَ الإِصباحِ رامِيَها","كَأَنَّهُ في حَواشي ثَوبِهِ صُرَدُ",13,"د",1,0],["حَتّى اِستَكانوا وَهُم مِنّي عَلى مَضَضٍ","وَالقَولُ يَنفُذُ ما لا تَنفُذُ الإِبَرُ",14,"ر",1,0],["حَتّى اِستَبانوا جِيادَ الخَيلِ مُعلِمَةً","وَكَوكَبُ المَوتِ يَعشى دونَهُ البَصَرُ",15,"ر",1,0],["حَتّى اِستَقَرَّ بِهِ الرَدى في حُفرَةٍ","وَخَلا لِغَيرِ جَوادِهِ المِضمارُ",16,"ر",1,0],["حتى استبدَّ بك الحِمامُ فلم تجدْ","عوناً على سُمر اللِّدانِ الشُرَّعِ",17,"ع",1,0],["حَتّى اِستَقامَت رُؤوسٌ كانَ يَحمِلُها","أَجسادُ قَومٍ وَفي أَعناقِهِم صَعَرُ",18,"ر",1,0],["حَتّى اِستَقامَ لِوَجهِ سُنَّتِهِ","وَدَرى وَلَم يَكُ قَبلَها يَدري",19,"ر",2,0],["حَتّى اِستَغاثَت بِماءٍ لا رِشاءَ لَهُ","مِنَ الأَباطِحِ في حافاتِهِ البُرَكُ",20,"ك",1,0],["حَتّى اِستَضاءَ بِشُعلَةِ السُوَرِ الَّتي","رَفَعَت لَهُ سَجفاً عَنِ الأَسرارِ",21,"ر",1,0],["حَتّى اِستَقَرَّ بِعَبدِ اللَهِ فَاِنبَلَجَت","أَنوارُ غُرَّتِهِ كَالبَدرِ في البُهُمِ",22,"م",1,0],["حَتّى اِستَتَمَّ وَلا نُقصانَ يَلحَقُهُ","خَمساً وَعِشرِينَ سِنُّ البارِعِ الفَهِمِ",22,"م",1,0],["حَتّى اِستَرابَت قُرَيشٌ وَاِستَبَدَّ بِها","جَهلٌ تَرَدَّت بِهِ في مارِجٍ ضَرِمِ",22,"م",1,0],["حَتّى اِستَجابَت لَهُ الأَنصارُ وَاِعتَصَمُوا","بِحَبلِهِ عَن تَراضٍ خَيرَ مُعتَصمِ",22,"م",1,0],["حَتّى اِستَذَلَّت وَعادَت بَعدَ نَخوَتِها","تُلقي إِلى كُلِّ مَن تَلقاهُ بِالسَّلَمِ",22,"م",1,0],["حَتّى اِسمَدَرَّ بَصيرُ العَينِ وَاِبتَدَرَت","أَخصامُها عَبرَةً مِن لاعِجِ الكَمَدِ",23,"د",1,0],["حَتّى اِستَلَمنَ الرُكنَ في أُنُفٍ","مِن لَيلِهِنَّ يَطَأنَ في الأُزرِ",24,"ر",1,0],["حَتّى اِستَمَرُّوا وَطَرفُ العَينِ يَتبَعُهُم","بِواكِفٍ مِن دُمُوعِ العَينِ ذي سِنَنِ",25,"ن",1,0],["حَتّى اِستَغاثَت بِالأَمانِ صاغِرَه","وَغَمَدَ السَيفَ بِكَفٍّ قادِرَه",26,"ه",1,0],["حَتّى اِستَثارَهُمُ دَليلٌ فارِطٌ","يَسمو لِغايَتِهِ بِعَينَي أَجدَلِ",27,"ل",1,0],["حَتّى اِستَغاثَ مَعَ الشُروقِ بِمَنهَلٍ","فيهِ دَواحٍ مِن قَطا أَفواجِ",28,"ج",1,0],["حَتّى اِستَهَلَّت بِسودٍ","مُسَهَّداتٍ جِعادِ",29,"د",1,0],["حَتّى اِستَباحا سَنامَ الأَرضِ فَاِنصَرَفا","عَن آلِ مَروانَ صَرعى غَيرَ نُهّادِ",30,"د",1,0],["حَتّى اِستَصَحّوا وَحَتّى قيلَ قَد رَجَعوا","مِمّا دَعَتهُم إِلَيهِ العادَةُ العُنُدُ",31,"د",1,0],["حَتّى اِستَمَدَّ بِهارونِ فَآزَرَهُ","فَمِن هُناكَ أَتاهُ النَصرُ وَالمَدَدُ",31,"د",1,0],["حَتّى اِستَلَبنا مُلكَها","بِمُلكِنا المُستَلَبِ",32,"ب",1,0],["حَتّى اِستَباحوا عَسكَرَ الكَذّابِ","بِالطَعنِ بَعدَ الطَعنِ وَالضِرابِ",33,"ب",1,0],["حَتّى اِستَقَلَّ بِجَمعٍ لا كِفاءَ لَهُ","يَنفي الوُحوشَ عَنِ الصَحراءِ جَرّارِ",34,"ر",1,0],["حَتّى اِستَغاثَت بِأَهلِ المِلحِ ما طَعِمَت","في مَنزِلٍ طَعمَ نَومٍ غَيرَ تَأويبِ",35,"ب",1,0],["حتّى استوى فيا بناءٌ مُحكمُ","فحَلَّه عاملُه والحشمُ",36,"م",1,0],["حَتَّى اسْتَبَنْتُ الهُدَى والبِيدُ هَاجِمَةٌ","يَخْشَعْنَ في الآلِ غُلْفاً أَوْ يُصَلِّينَا",37,"ن",2,0],["حتى استقلت دولة الرشيد","ونهضت بركنها المشيد",38,"د",1,0],["حَتَّى اسْتَقَرَّتْ عَيَاءً","مِنْ وَثْبِهَا المتَمَادِي",39,"د",2,0],["حتى استقامت له في الكون سيطرة","من فطرة الله بين العز والظفر",40,"ر",1,0],["حتى استغاثتْ بأهلِ الملحِ ، ما طمعتْ","، في منزلٍ ، طعمَ نومٍ غيرَ تأويبِ",41,"ب",1,0],["حتى استخف بدين الل