{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[93,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[87,"قيل ما الفن قلت كل جميل","https://www.aldiwan.net/poem7122.html","الخفيف"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[107,"بلغت مطيك أول الركبان","https://www.aldiwan.net/poem42117.html","الكامل"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[240,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[347,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[369,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[408,"يهنا المعالي قدوم منك ميمون","https://www.aldiwan.net/poem46917.html","البسيط"],[438,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[447,"العذل يقلق والصبابة تلبس","https://www.aldiwan.net/poem14308.html","الكامل"],[458,"أهذا هو الفنان نسمعه فنا","https://www.aldiwan.net/poem61703.html","الطويل"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[556,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[568,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122774","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122542","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122672","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138090",""],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16726","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136131","البسيط"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82296","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77853","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95384","الرمل"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33090","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68034","الوافر"],[3467,"","https://poetry.dctabudhabi.ae/diwan/poem/145097","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129396","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118765","الخفيف"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99233","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35504","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35588","البسيط"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21523","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90965","الرمل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123457","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99103","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[4755,"مَرَّ قِربِي.. كَأَنّهُ كانَ حُلْمَا","https://www.poetsgate.com/ViewPoem.aspx?id=197774",""],[4784,"برق التهاني في سناه ائتلقا","https://www.poetsgate.com/ViewPoem.aspx?id=170935",""],[5206,"الرد على منكر علم الحِكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187403",""],[5213,"حي ربوعا بالعذيب درسا","https://www.poetsgate.com/ViewPoem.aspx?id=170491",""],[5431,"بروحه احتشدا","https://www.poetsgate.com/ViewPoem.aspx?id=213694",""],[5725,"وجه تجسد بالمحاسن أجملا","https://www.poetsgate.com/ViewPoem.aspx?id=213320",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""]],"verses":[["مَرَقتُ مِنها مُروقَ النَجمِ مُنكَدِراً","وَقَد تَلاقَت مَصاريعُ الرَدى دوني",0,"ن",2,0],["مرقَدٌ واحِدٌ نَصيبُكَ مِنهُ","أَفَتَدري كَم فيكَ لِلذَرِّ مَرقَد",1,"د",1,0],["مرقت كالسهام تخرق ابعا","د فضاء حدوده فوق حدسي",2,"س",2,0],["مرقصات الوليد أعجب لفظا","بين أجزائه وأطرب معنى",3,"ن",2,0],["مَرقُومَةُ الجِيدِ مِن مِسكٍ وَغالِيَةٍ","مَخضُوبَةُ الساقِ وَالكَفَّينِ بِالعَنَمِ",4,"م",1,0],["مَرقَى الرّجالِ إلى الخُلودِ وسُلَّمٌ","يَنحطُّ عنه العاجزُ المُتواني",5,"ن",2,0],["مَرقىً رَقاه على متنِ البراقِ علا","كلَّ الأنامِ به في شرحه طولُ",6,"ل",1,0],["مَرَقوا عَنِ الدينِ الحَنيفِ بِبَغيِهِم","كَالسَهمِ مِن كَبِدِ الحَنِيَّةِ يمرُقُ",7,"ق",1,0],["مَرْقُوم الخَدِّ مُوَرّدُه","يَكْسُونِي السُّقمَ مُجَرَّدُهُ",8,"د",2,1],["مرقص ضاحك يحف به البش","ر ويغدى في صحنه ويراحُ",9,"ح",1,1],["مرقص عابث يعج عجيجاً","كل ما فيه جلبة وصياح",9,"ح",1,0],["مَرقْتَ مُروقَ السَّهْمِ منّي مُودِّعاً","على حينَ ظَهري كالحنيّة إذْ تُحنى",10,"ن",2,0],["مرقومةٌ لم تحكْ شبهاً لها عَدَنٌ","ولا حكى نَشرَها المسكيِّ دارينُ",11,"ن",1,0],["مرَقَتْ في الدُجى","من ودادٍ تُرْعى بهنّ الحُقوقُ",12,"ق",1,0],["مرقت مروق السهم لي عيرانه","هوجاء مامون تسير عرندس",13,"س",1,0],["مرقرقَ أنفاسِ الطبيعةِ فتنةً","وواهبها للنَاس ألحانه الحسنىَ",14,"ن",2,0],["مرقِّعاً بالمنَى أرجو غداً فغداً","تأتي الحظوظُ وحظّي بعدُ منتَظرُ",15,"ر",1,0],["مُرقِّصَةٌ للسّامعين نشيدُها","كما رقصتْ بالشّاربين مُدامُ",16,"م",1,0],["مَرَقَت عَلى الإِجماعِ وَالنَصّينِ وال","فِقهِ الَّذي بِهِما مُروقَ مُصارِمِ",17,"م",1,0],["مَرقُومَةً لا يَهتَدي لِعُرُوضِها","وَضَرُوبِها فِكرُ الصَّنَاعِ الرّاقِمِ",18,"م",1,0],["مَرقُومَةَ الطَّرفين نَمنمَ وشيَها","صَنِعٌ إذا مَدَح المظفرَ أسهبا",19,"ب",2,0],["مَرقُومَة الطَّرفَين يُطرفُ سِحرُها","فتَرى لَه الحَجَرَ الأصمَّ سَميعا",20,"ع",2,0],["مُرقُسُ ما أَخبَرَنا بِذا الخَبَر","عَنهُ وَلا لوقا حُكاهُ في الأَثَر",21,"ر",1,0],["مرقرق مثل فيض القطر منسكب","يا ضيعة القطر في جوف الصياخيد",22,"د",1,0],["مَرَقتُ بِنَهرِ المَسرِقانِ عَشِيَّةً","فَأَبصَرتُ أَقماراً تَروحُ وَتَغرُبُ",23,"ب",1,1],["مرقاك سر وعين القرب أوله","ومنشاء الوجد تحكيه النهايات",24,"ت",1,0],["مَرَقَت فَصارَت قَحبَةً","بِجِعالَةٍ وَبِلا جِعالَه",25,"ل",2,0],["مرقوب يعقوب المقيد بالعمى","من فقد يوسف أَمره المتآسف",26,"ف",1,0],["مرقة دهناً وسمناً يا فتى","فارتشفها فهي أشهى من مدام",27,"م",1,0],["مُرَقَّقَةِ الأَذنابِ نُمرٍ ظُهورُها","مُخَطَّطَةِ الآماقِ غُلبِ الغَوارِبِ",28,"ب",1,0],["مَرَقْن من الفَلاة بِهِ مُروقا","حَنايا كالقِسِيِّ بهم تَهاوَى",29,"ا",3,0],["مرقن من الزوراء في سورة الدجى","كما انصاع من بيض القسي سهامها",30,"م",3,0],["مرقد الطهر سمي المصطفى","خير خلق اللَه أصلاً وانتسابا",31,"ب",2,0],["مر قلب الرجاء فيه فارخ","قمر السعد زف أكرم شمس",32,"س",1,0],["مرقلاتٍ نحو الحجاز لتقضي","واجباتٍ يفوز من أدّاها",33,"ا",3,0],["مَرَقْتُ به في مَتْن أَدهم صاهلٍ","أَغَرَّ إذا أَبْرَقْتُ بالسيف أَرْعَدا",34,"د",2,0],["مَرَقت إِلَيهِ مِن خلَلِ الدّياجي","مُروقَ السَّهمِ إِذ جَدّ اِنفِلاتا",35,"ت",2,0],["مَرَقَت مِن حَوزِها كَالنّجمِ مُرتَدياً","بِمرهَفِ الحَدِّ مِثل النّجمِ قطّاعِ",36,"ع",1,0],["مُرَقَّقَةِ الأَخفافِ صُمٌّ عِظامُها","شَديدَة طيِّ الصُّلب مَعصوبَةُ العَصَب",37,"ب",1,0],["مرقد فيه توارى فرقد","كان كشافا دجا ليل الكرب",38,"ب",1,0],["مرقتَ مُروقَ السّهم من خيرِ ملّةٍ","وأوغلتَ في خزيٍ ودينٍ مثلَّم",39,"م",1,0],["مرقْتُ منها وثغر الصبح مبتسمٌ","إلى أغرَّ يرى المذخور ما وهبا",40,"ب",2,0],["مرقد الفرقدين ذاك ومنه","مطلع النيرين جهراً أنارا",41,"ر",2,0],["مَرَّ قِربِي.. كَأَنّهُ كانَ حُلْمَا..","قُلتُ: قُل ما تُريدُهُ لَم يَقُل ما..",42,"م",2,1],["مرقد قدس فيه أملاك ذي","العزة فوج حوله قد أحدقا",43,"ق",2,0],["مَرقُورِيوسَ ثُمَّ ذُو مُقرَاطِهم","مَع رَيْسَمُوسَ زَانَهُ التَّنْفِيسُ",44,"س",1,0],["مرقالة تفوت مهباب الصبا","وتسبق البرق إذا تمرسا",45,"س",2,0],["مرقّعَ النعل يستميتُ طوى","لكنه الحب زاده أبدا",46,"د",2,0],["مرقاك أضناني ودونك ابحر","وأنا الغريق أذود موجك مقتلا",47,"ل",2,0],["مرقت أمة نفته وأمست","بذنوب الذنوب تنهز نهزا",48,"ز",2,0]]}