{"poems":[[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[85,"يا من تمد له الملوك أكفها","https://www.aldiwan.net/poem54343.html","الكامل"],[74,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[63,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem51442.html","الطويل"],[71,"لله هاتيك السياط كأنها","https://www.aldiwan.net/poem29226.html","الكامل"],[136,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[139,"لله همة ذا الرئيس فإنها","https://www.aldiwan.net/poem49109.html","الكامل"],[164,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[189,"أيام ملكك أعياد وأعراس","https://www.aldiwan.net/poem14555.html","البسيط"],[214,"أحيا الربيع الأرض بعد مماتها","https://www.aldiwan.net/poem13322.html","الكامل"],[302,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[463,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[543,"لله أيام مع الأحباب","https://www.aldiwan.net/poem48291.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83322","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64075","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120024","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69408","المتدارك"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108459","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53244","السريع"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47173","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137365",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83226","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122445","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112330","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112296","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103865","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48424","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91357","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34601","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102972","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35647","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36649","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36483","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36687","الدوبيت"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73320","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136528",""],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198559","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136378",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4691,"تحييك يا مهجتي رسائلُها","https://www.poetsgate.com/ViewPoem.aspx?id=215986",""],[4692,"قلب تآكل من شوق ومن سقم","https://www.poetsgate.com/ViewPoem.aspx?id=191653",""],[5213,"هذا العذيب فأين سرب رئامه","https://www.poetsgate.com/ViewPoem.aspx?id=170537",""],[5213,"وجد تذوب له الجوانح","https://www.poetsgate.com/ViewPoem.aspx?id=170432",""],[5956,"ودِّعْ بلاداً ذكْرهنّ عواطرُ","https://www.poetsgate.com/ViewPoem.aspx?id=215547",""],[5974,"لله هذا القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207119",""],[6031,"رَعَتْ قُريشٌ فِينَا الذِّمامَ على","https://www.poetsgate.com/ViewPoem.aspx?id=46269",""]],"verses":[["للهِ هَبُّتُهُمْ للهِ غَارَتُهُمْ","تَحْتَ الرَّصَاصِ وَفِي أَسْمَاعِهِمْ صَمَمُ",0,"م",1,0],["للهِ هل شرف يضاهي ذا الذي","أوليته من منةِ غَرَّاءِ",1,"ا",2,0],["لله همتك الممكّن رفعها","ماذا جزمت بها من الأفعال",2,"ل",1,0],["للهِ همةُ يحيى أين وجَّهَهَا","لو أنها شيَّعَتْهُ مُدّة العمر",3,"ر",1,0],["للهِ هِمَّتُكَ التي رَجَعَتْ بها","هِمَمُ الملوكِ الصَّاعِداتُ هُموما",4,"م",2,0],["للهِ هاتيكَ السياطُ كأنها","أقلامُ مسكٍ تستمدُّ خلوقا",5,"ق",2,1],["لِلَّهِ هَيبَةُ لَيثٍ مِنهُ وَاضِحَةٌ","كَأنَّه وهو ضَاحٍ هُوَّ في أجَمَه",6,"م",2,0],["لله همةُ ذا الرئيس فإنها","طفقت تقول لهمة الدهر اقصري",7,"ر",2,1],["لله همتهُ التي من شأنها","أن تردف النعماء بالنعماءِ",8,"ا",2,0],["للهِ هِمّتُك العَلْياء كم جَمَعت","من خَلةٍ عاش منها الفضلُ والباس",9,"س",1,0],["للّه هاتيك الليبلات التي","قد فزت باللذات من اوقاتها",10,"ت",3,0],["لِلَّه همّتُك الَّتي فاقَت عَلى","هِمم الأَعاظِم شيخِها وَفَتاها",11,"ا",3,0],["للّه هذا اليومُ يوماً أنجز ال","دهرُ به ما كان فيه يَعِدُ",12,"د",1,0],["لله هاتِيك المجالسُ عُطِّرت","بفرَائٍدٍ مَوصولةِ الأسبابِ",13,"ب",1,0],["لِلَهِ هَذِهِ عُلى بايِ الزَمانِ فَهَل","لِمِثلِ مَحصولِهِ في المَجدِ تَحصيلُ",14,"ل",1,0],["لله هضبةُ أرفاقٍ يَلوذُ بها","مَنْ وسَّدَتْهُ صروفُ الدهر مِرفَقه",15,"ق",2,0],["لله همته التي يسمو بها","منه فتى جزل العطاء همام",16,"م",1,0],["لِلّهِ هُمُ فَهُمُ نَفَرٌ","راقُوا بِمَساعٍ لَم تَرُقِ",17,"ق",1,0],["لله هاتيك الجوائب أنها","لأولي المعارف والفضائل منهل",18,"ل",1,0],["لله هذا السؤدد المعتلى","والحسب الوضاح والمنصب",19,"ب",1,0],["للّه هُمْ ومحاسنٌ خُصُّوا بها","سَمَحَتْ بها الأيّام وهي جهام",20,"م",1,0],["لله همتك الغراء إن بها","عزما لغيرك يا مولاي ما عهدا",21,"د",2,0],["لِلَهِ هَذا اليَومُ إِن أَصيلَهُ","نَفحٌ تُراضُ بِهِ المُنى وَتُسامُ",22,"م",1,0],["للهِ هِمَّتُكَ العُلْيَا وَغَيْرَةُ رُو","حِكَ الكبير وأًخْلاَقٌ وَءادَابٌ",23,"ب",1,0],["لله هاتيك الليا","لي والفؤاد بها خلي",24,"ل",2,0],["للهِ هَاتِيكَ الغُصُو","نُ يهُزّها نَغَمُ الخريرِ",25,"ر",1,0],["للَه هجرك إنه","ساعٍ لبرئي مجتهد",26,"د",1,0],["للهِ هادٍ إلى قصْدِ السّبيلِ هَدَى","أفْكارَ فكْري بما منها يُهادِيها",27,"ي",3,0],["لِلّه هاتيكَ المناسكُ والصوا","معُ والمشاهدُ حيثُ كلُّ امانِ",28,"ن",1,0],["لِلّه هذي الآخذاتُ عُقولَ من","لَزمَ الهَوى فَأَهان عزةَ أَنفس",29,"س",1,0],["للّه هاتفةٌ هبَّت مرجعةً","زبورَ داودَ طوراً بعد أطوار",30,"ر",1,0],["للَه هاتيك الكناس تكفلت","بحفاظهن مجاثم الآساد",31,"د",1,0],["للَه هم امرىء وافت صوارمه","بجازر عنق الأوثان والصلب",32,"ب",1,0],["لِلّهِ هَيفاء قَدَّمتها","هَيفاءَ كَالغُصنِ في التَثَنّي",33,"ن",2,1],["لِلَّهِ هَوى يَفتِنني مَبسمُهُ","ما الزهرُ كعقدِ لُؤلؤٍ يَنظمُهُ",34,"ه",1,1],["لِلَّهِ هَوى خِصالُهُ لا أُحصي","ما زُرَّ عَلى غير هَواه قُمصي",35,"ي",1,1],["لِلَّهِ هَوىً خَسِرتُ فيهِ ديني","ما كادَ يُغِبُّ ذكره في حينِ",36,"ن",1,1],["للهِ هاتيكَ الخَيامُ وبدرُها","وكِناسُ هَذاكَ الصَّريمِ وريمُهُ",37,"م",2,0],["لله هاتيكَ الظُعون وما بها","الا ابنُ أم الريم أدعجَ أغيد",38,"د",1,0],["لله هذا اليوم لو ظفرت يدي","فيه بحفظ العهد في لقابل",39,"ل",1,0],["لله هداة رأوا صباح رباح","منه فتحروا به الصراط بإذعان",40,"ن",1,0],["لِلَّهِ هُم فَلَشَدَّ ما نَفَضوا مِنَ اِم","تِعَةِ الحَياةِ حَقائِبَ الأَجسادِ",41,"د",1,0],["لله هيفا أتتْ كفارسةٍ","سلاحُها في الهوى خلاخلُها",42,"ل",3,0],["لله هذا فؤادٌ في شقاوته","طفل ولكن بقلب العاشق النهمِ",43,"م",1,0],["للّه هاتيك الربوع فكم حوت","كللا تقل البدر عند تمامه",44,"م",2,0],["للّه هاتيك الديار","وغيدها البيض السوانح",45,"ح",1,0],["لله هم ضد الشآم لأنها","فوق الصراطِ وكلهنَّ كوافرُ",46,"ر",1,0],["لله هذا القلب كم حاولته","في الحب ،أقسم لا هوى إلاك",47,"ك",1,0],["لِلَّهِ هُم ما أَحَبَّ للضيفِ إنْ","حَلَّ وللطيِّباتِ ما أَحبَّا",48,"ب",2,0]]}