أدلت","به في الجوّ هاجرةٌ حَلوب",3,"ب",1,0],["كَخَصمِ بَني بَدرٍ غَداةَ لَقيتُهُم","وَمِن قَبلُ قَد قَوَّمتُ دَرءَ رَبيعِ",4,"ع",1,0],["كخالية من كوعها وهي تبتغي","صلاح اديم ضيّعته وتعمل",5,"ل",1,1],["كَخُوط الخيزرانِ يُريك ليناً","ويأبى الكسر من عطفيهِ آبِ",6,"ب",1,0],["كخصف آدم من أوراق جنته","ولم يكن قبل ذاك الخصف خصّافا",7,"ف",2,0],["كخريدةٍ نظرت إلى إلفٍ لها","فتلثَّمت خجلاً بكم أزرقِ",8,"ق",1,0],["كَخيالٍ من عالَمِ الموتِ يَنْسابُ","بصَمْتٍ مَا بَيْنَ رَمْسٍ وَرَمْسِ",9,"س",1,0],["كَخَليلِ اللَهِ في حَضرَتِهِ","خَرَّتِ النارُ خُشوعاً وَاِحتِراما",10,"م",2,0],["كَخَنساءَ سَفعاءِ المَلاطِمِ حُرَّةٍ","مُسافِرَةٍ مَزؤودَةٍ أُمِّ فَرقَدِ",11,"د",1,0],["كَخُضوعِ النَجمِ لِلشَم","سِ إِذا رامَت طُلوعا",12,"ع",2,0],["كَخُوطَةِ بانٍ بَلَّهُ صَوبُ دِيمَةٍ","إِذا حَرَّكَتهُ الرِيحُ بِالماءِ أَخضَلا",13,"ل",2,0],["كَخَراجِ السَماءِ سيبُ يَدَيهِ","لِقَريبٍ وَنازِحِ الدارِ ناءِ",14,"ا",2,0],["كَخَبيءِ نِعمَ وَبِئسَ يَخبَأُ فيهِما","وَيَكونَ ذاكَ عَلى اِشتِراطِ مُفَسِّرِ",15,"ر",1,0],["كَخَيلٍ صِيامٍ تَألَكُ الدَهرَ لُجمَها","بِغَيظٍ فَقَد أَدمى نَواجِذَها الأَلكُ",16,"ك",1,0],["كخَلاَفِ البَحرِ تَعلُو غَمرَةً","إذ سَجَا التَّيَّارُ منه واسبَكَر",17,"ر",1,0],["كخفق الأماني كنجوى غدير","شذى الصدى زنبقيّ الخرير",18,"ر",1,0],["كخيوطٍ من فضَّةٍ بتْنَ طوع الرّيح","بين الشمال والشرقي",19,"ي",1,0],["كخائن يَنتَهِش الأرابدا","وكنْ صديقاً حَفظ المعاهدا",20,"د",2,0],["كخنساءَ، سعفاءِ الملاطمِ، حرة ٍ","مسافرة ٍ، مزؤودة ٍ، أمِّ فرقدِ",21,"د",1,0],["كَخَطِّ الصَحيفَةِ بَعدَ الزَما","نِ تَبقى حُلوكَةُ أَنقاسِها",22,"ه",2,0],["كَخاضِبٍ وَاللَيالي غَيرُ آلِيَةٍ","تُذيعُ مِن شَيبِهِ ما يَكتُمُ الكَتَمُ",23,"م",1,0],["كخفقةِ قلبٍ أَو كقُبْلَةِ عاشقٍ","عَلَى حَذَرٍ أَو رَدِّ طرْفِ المراقبِ",24,"ب",1,0],["كخدِّ محبوبةٍ تبدو لعاشِقها","فإنْ بَدا لَهما واشٍ تُنَقِّبُه",25,"ب",2,0],["كخضَمٍّ غَرقَ الهَمُّ بِهِ","فَاِعتَرى أَمواجَه صمتُ الجلال",26,"ل",1,0],["كَخائِضِ الُوَحْلِ إِذْ طالَ الْعَناءُ بِهِ","فَكُلَّما قَلْقَلَتْهُ نَهْضَةٌ رَسَبا",27,"ب",2,0],["كَخُلقِ بَدرِ الدينِ فَه","يَ الرَوحُ وَالرَيحانُ",28,"ن",1,0],["كخاتمٍ من عقيقٍ","وفصه لازورد",29,"د",1,0],["كخيربه تمحى الذنوب ودعوة","تجاب من الجاني ورب شفاعة",30,"ه",1,0],["كخيال يطوف في هدأة الفك","ر يموج كما يموج الضياء",31,"ا",2,0],["كَخاضب الشَيب لتزيينه","يَسوّد الفرع وَتَأبى الأُصول",32,"ل",1,0],["كَخافِقِ الآلِ لَم تَبُرُد بِهِ غُلَلي","وَخاطِفِ البَرقِ لَم يُمتَع بِهِ بَصَري",33,"ر",2,0],["كخِصالِ الفَضْلِ إذ جُمعَتْ","فِي سليل السَّادة الفُضَلا",34,"ل",2,0],["كخاطرِ الأسعدِ في كُتْبِه","للحافظِ الحَبْرِ عن الكاملِ",35,"ل",1,0],["كخَوْطِ البانِ يُجْنى من ذُراهُ","على من يَجتَني وردٌ جنيُّ",36,"ي",1,0],["كخلعٍ رحتَ بها مكتسياً","عزّاً وتُكسَى اللِّبَدَ الضراغمُ",37,"م",1,0],["كخضر البنود إذا نشرت","وجاذبت الريح أعطافا",38,"ف",2,0],["كخوذةٍ فوق درع حولها أسل","سمر أسنتها مخضوبة بدم",39,"م",1,0],["كخوذةٍ فوق درعٍ حولها أسلٌ","سمرٌ ولكنَّها مخضوبةٌ بدمِ",40,"م",1,0],["كَخَرائِطٍ مِن مُصمَتٍ","خُتِمَت بِشَمعٍ أَصفَرِ",41,"ر",1,0],["كخديجة هذي التي","فيها الشباب مضيع",42,"ع",1,0],["كخائفٍ في بلادِ مَضْيَعَةٍ","مستترٍ بالظّلامِ منفردِ",43,"د",1,0],["كخيال العقول يثبت فيها","ما أرادت بأن يكون هنالك",44,"ك",1,0]]}