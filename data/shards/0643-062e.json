{"poems":[[53,"وذي ضغن معسولة كلماته","https://www.aldiwan.net/poem29846.html","الطويل"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[93,"هو العيش جهد طائل وفتون","https://www.aldiwan.net/poem11186.html","الطويل"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[4,"دعي اللوم أو بيني كشق صديع","https://www.aldiwan.net/poem21174.html","الطويل"],[37,"كخالية من كوعها وهي تبتغي","https://www.aldiwan.net/poem7674.html","الطويل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"يا من بغرته الهلال أما ترى","https://www.aldiwan.net/poem65751.html","الكامل"],[92,"ينقضي العيش بين شوق ويأس","https://www.aldiwan.net/poem38933.html","الخفيف"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[31,"علق القلب وزوعا","https://www.aldiwan.net/poem42235.html","مجزوء الرمل"],[40,"رأتني خضيب الرأس شمرت مئزري","https://www.aldiwan.net/poem42314.html","البسيط"],[50,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[46,"يا نفس آه لمتجر متنزر","https://www.aldiwan.net/poem22699.html","الكامل"],[46,"هو الفلك الدوار أجراه ربه","https://www.aldiwan.net/poem23061.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[2,"غَشِيتُ دِياراً بالبَقيعِ فثَهْمَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19485&r=&rc=11",""]],"verses":[["كَخارِزِ مَقدودِ الأَديمِ رَأَيتَهُ","يَبينُ عَنِ الإِشفى وَطَوراً يَغُلُّهُ",0,"ل",2,0],["كَخَذولٍ تَرعى النَواصِفَ مِن تَث","ليثَ قَفراً خَلا لَها الأَسلاقُ",1,"ق",1,0],["كَخِدْمَتِكَ الأَوْطَانِ فَلْيَخْدُمِ الأُلَى","رَأَوْا نَهْضَةَ العُمْرَانِ كَيْفَ تَكُونُ",2,"ن",1,0],["كخيط من لعاب الشمس أدلت","به في الجوّ هاجرةٌ حَلوب",3,"ب",1,0],["كَخَصمِ بَني بَدرٍ غَداةَ لَقيتُهُم","وَمِن قَبلُ قَد قَوَّمتُ دَرءَ رَبيعِ",4,"ع",1,0],["كخالية من كوعها وهي تبتغي","صلاح اديم ضيّعته وتعمل",5,"ل",1,1],["كَخُوط الخيزرانِ يُريك ليناً","ويأبى الكسر من عطفيهِ آبِ",6,"ب",1,0],["كخصف آدم من أوراق جنته","ولم يكن قبل ذاك الخصف خصّافا",7,"ف",2,0],["كخريدةٍ نظرت إلى إلفٍ لها","فتلثَّمت خجلاً بكم أزرقِ",8,"ق",1,0],["كَخيالٍ من عالَمِ الموتِ يَنْسابُ","بصَمْتٍ مَا بَيْنَ رَمْسٍ وَرَمْسِ",9,"س",1,0],["كَخَليلِ اللَهِ في حَضرَتِهِ","خَرَّتِ النارُ خُشوعاً وَاِحتِراما",10,"م",2,0],["كَخَنساءَ سَفعاءِ المَلاطِمِ حُرَّةٍ","مُسافِرَةٍ مَزؤودَةٍ أُمِّ فَرقَدِ",11,"د",1,0],["كَخُضوعِ النَجمِ لِلشَم","سِ إِذا رامَت طُلوعا",12,"ع",2,0],["كَخُوطَةِ بانٍ بَلَّهُ صَوبُ دِيمَةٍ","إِذا حَرَّكَتهُ الرِيحُ بِالماءِ أَخضَلا",13,"ل",2,0],["كَخَراجِ السَماءِ سيبُ يَدَيهِ","لِقَريبٍ وَنازِحِ الدارِ ناءِ",14,"ا",2,0],["كَخَبيءِ نِعمَ وَبِئسَ يَخبَأُ فيهِما","وَيَكونَ ذاكَ عَلى اِشتِراطِ مُفَسِّرِ",15,"ر",1,0],["كَخَيلٍ صِيامٍ تَألَكُ الدَهرَ لُجمَها","بِغَيظٍ فَقَد أَدمى نَواجِذَها الأَلكُ",16,"ك",1,0],["كخَلاَفِ البَحرِ تَعلُو غَمرَةً","إذ سَجَا التَّيَّارُ منه واسبَكَر",17,"ر",1,0],["كخيوطٍ من فضَّةٍ بتْنَ طوع الرّيح","بين الشمال والشرقي",18,"ي",1,0],["كخائن يَنتَهِش الأرابدا","وكنْ صديقاً حَفظ المعاهدا",19,"د",2,0],["كخنساءَ، سعفاءِ الملاطمِ، حرة ٍ","مسافرة ٍ، مزؤودة ٍ، أمِّ فرقدِ",20,"د",1,0]]}