عصورَكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197720",""],[5569,"مريم والعراق","https://www.poetsgate.com/ViewPoem.aspx?id=60534",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5587,"يا جزائر","https://www.poetsgate.com/ViewPoem.aspx?id=196573",""],[5595,"دُمْ في عُلاكَ مُعلّماً كلَّ الورى","https://www.poetsgate.com/ViewPoem.aspx?id=144653",""],[5626,"بلّغ سلامي للتي أهواها","https://www.poetsgate.com/ViewPoem.aspx?id=189697",""],[5628,"الوثنيون المتوحشون","https://www.poetsgate.com/ViewPoem.aspx?id=178537",""],[5660,"أَتُحِبُّني بَعدَ الَّذي كانا","https://www.poetsgate.com/ViewPoem.aspx?id=36844",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5691,"سباق الموت","https://www.poetsgate.com/ViewPoem.aspx?id=206099",""],[5725,"يانسمة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178891",""],[5725,"عراق","https://www.poetsgate.com/ViewPoem.aspx?id=188952",""],[5770,"طار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178360",""],[5770,"رثاء الشهيد فيصل الحسيني","https://www.poetsgate.com/ViewPoem.aspx?id=178701",""],[5790,"هذا العذيب وهذا الرند والبان","https://www.poetsgate.com/ViewPoem.aspx?id=112145",""],[5952,"عراق","https://www.poetsgate.com/ViewPoem.aspx?id=207806",""],[5956,"أخلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=194553",""],[5956,"أثمنُ مِنَ الشمس والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=194748",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[6038,"العشق","https://www.poetsgate.com/ViewPoem.aspx?id=25688",""],[6160,"قناديلُ عراقيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87104&r=&rc=21",""],[6160,"صَقيعٌ لنبوءةٍ عارِية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87101&r=&rc=18",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6235,"نسرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77693&r=&rc=8",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""],[6305,"لا تَبْكِ قَتْلاكَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87353&r=&rc=26",""]],"verses":[["هَذا العَزاءُ وَإِن تَحزَن فَلا عَجَبٌ","إِنَّ البُكاءَ بِقَدرِ الحادِثِ الجَلَلِ",0,"ل",1,0],["هَذا العَقيقُ وَفيهِ مَرأىً مونِقٌ","لِلعَينِ لَو كانَ العَقيقُ عَقيقا",1,"ق",2,0],["هَذّا العِظاتِ عَلَينا في سُكونِهِما","كَصارِمَينِ ذَوي غَربٍ يُهَذّانِ",2,"ن",1,0],["هَذَا العَبِيرُ المُسْعَدُّ","مِنْ جَنَّةٍ مُسْتَمَدُ",3,"د",1,1],["هذا العصاميُّ، العظاميُّ، الذي","أكبرت فيه تقابلَ الأضداد",4,"د",1,0],["هذا العراق قد انجلت شُبُهاتُه","وصَفا من الأقذاءِ والأدرانِ",5,"ن",1,0],["هذا العراقُ إليكِ حنَّ نخيلُه","والشامُ بين تذكُّرٍ وتذمُّر",6,"ر",1,0],["هَذا العُدا مُتلاقِيا فِئَة الهُدَى","فَتَقَسّمُوا الأتراحا والأفراحا",7,"ح",2,0],["هَذا العَقيقُ وَهَذا الرَّندُ وَالبانُ","فَكَيفَ تَبخَلُ لي بِالدَّمعِ أَجفانُ",8,"ن",1,1],["هَذَا العَقِيقُ فقِفْ بِنا يا حادِي","فبِهِ سُلِبْتُ حُشَاشتي ورُقادِي",9,"د",2,0],["هذا العلي المرتضى اسما ومن","همته يعلمها الأكثرُ",10,"ر",1,0],["هذا العلي الاسعدي","المرعبي المحتشم",11,"م",1,0],["هذا العزاء وذا تأبين والدكم","عني أتاكم وقلبي بالأساء صلي",12,"ل",2,0],["هذا العقيقُ وهذهِ أقمارُهُ","فإلامَ قلبُك لا يقرُّ قرارهُ",13,"ر",2,1],["هذا العقيق تلك أعلام الحمى","فإلام وخدك والدجى قد هوما",14,"م",2,1],["هذا العَطاءُ لهُ بِعلمِ الغَيبِ قد","أوْلاهُ باريهِ فَخَلِّ النَّاسا",15,"س",2,0],["هذا العَقيقُ وتلكَ شُمُّ رِعانِهِ","فاِمزُجْ لُجينَ الدّمعِ منْ عِقْيانِهِ",16,"ن",2,1],["هَذَا العَقِيقُ فَقِفْ عَلَى أَبْوابِهِ","مُتَمايِلاً طَرَباً لِوَصْلِ عِرَابهِ",17,"ب",2,1],["هذا العُسَيليُّ الذي نَزَلَ الثَّرى","كالغُصنِ من حُمرِ المنايا يُقصَفُ",18,"ف",1,1],["هذا العزيزُ ابنُ إِبراهيمَ نِسبتُهُ","تُصاغُ من أَولياءِ اللهِ والرُسُلِ",19,"ل",1,0],["هَذَا العَقيقُ فمَا لِقَلْبِكَ يَخْفِقُ","أَتراهُ مِنْ طَربٍ إِلَيْهِ يُصَفِّقُ",20,"ق",1,1],["هذا العقيق فخلني","ينهل من جفني عقيق",21,"ق",1,0],["هذا العَقيقُ فَخلِّني يا هذَا","أَجري دموعي وابلاً ورَذاذا",22,"ذ",2,1],["هذا العيان بلا امْتراءٍ إنّما","سمْعُ الكيان زخارف تُتوهَّمُ",23,"م",1,0],["هذا العقيق وهذا البان والعذب","وهذه الحلة الفيحاء والكئب",24,"ب",1,1],["هَذا العنا ذاك العنا","وَذا الضنى ذاكَ الضَنى",25,"ن",2,0],["هذا العَقيقُ فَعَدِّ أَي","دي العيسِ عَن غُلَوائِها",26,"ا",3,1],["هذا العراق وقد ناداك ساكنه","حييت إنك أنت الحر حييتا",27,"ت",2,0],["هذا العريش حكى عريشي أحمد","في يوم بدر شاده ببنائه",28,"ا",3,1],["هذا العُلى حقاً فهل من شاعرٍ","يصف العُلى وصفي لها أم كاتب",29,"ب",1,0],["هذا العراق وتلك مصر شجية","والشام عاكفة على ذكراك",30,"ك",1,1],["هَذا العدوّ قد طَغى","وقد تَعَدَّى وَبَغَى",31,"غ",2,1],["هذا العراقي همام الأمة","ومقتدى أكابر الأئمة",32,"ه",1,0],["هذا العدوُّ الذي وافَتْ مراكِبُهُ","للحرْبِ يرْفَعُها من بحْرِها ثبَجُ",33,"ج",1,0],["هذا العَجيزي الَّذي وافَت مَكارِمه","بِمُعجِزاتٍ وَآيات من العجب",34,"ب",1,0],["هذا العراق وأنت فيه مفرد","فانظر امورك بالتأني تقدرا",35,"ر",2,0],["هذا العَدُوُّ الذي تُخشى مكامنُهُ","فان يُصادق علمتَ الصِدقَ منهُ مِرا",36,"ر",2,0],["هذا العتو على اللّ","ه والجراءة بحتا",37,"ت",2,0],["هذا العيانُ دليلُ لا جُحودَ له","والجزءُ مندرجُ الإِثباتِ في الجُمَلِ",38,"ل",1,0],["هذا العَذولُ عليكُمُ ما لي ولَه","انا قد رضيتُ بذا الغرام وذا الوَلَه",39,"ل",2,1],["هذا العقيق وبانه والأجرع","وقصورُ كاظمةٍ خلاء بلقعُ",40,"ع",1,1],["هذا العظيمُ من الحلواءِ مأكَلُهُ","فالدودُ صَارَ له من بَعْدُ أَكَّالاَ",41,"ل",2,0],["هذا العلاء فهل له من جاحد","هذا الفخار فهل به من يكفر",42,"ر",1,0],["هذا العزيز وكل شيء دونه","هو هين وله النفوس فداء",43,"ا",2,0],["هذا العزيز يعز من بفنائه","مستعصم من جور دهر اعسر",44,"ر",1,0],["هذا العراق وهذا دأبه وطنٌ","لكل خطبٍ عظيم الهول يُنتدبُ",45,"ب",1,0],["هذا العشاءُ العائليُّ.. مُؤجَّلٌ د","هرينِ.. جوعُ الغائبين تألَّهْ",46,"ل",2,0],["هذا العراقُ مُكبلٌ ومُقيدٌ","قل لي بربِكَ كيف تُبصرُ ما ترى ؟",47,"ر",2,0],["هذا العقيق وذي ربا أزهاره","فانشق عبير خزامه وعراره",48,"ر",2,1],["هذا العِرَاقُ.. وتِلكَ بَعضُ مَآثِرٍ","عُظمَى.. حَمَامًا تَرتَقِي وحِمَاما",49,"م",2,0],["هذا العِنانُ هو الحنين وفيضُه","وبه نُقادُ إلى أحبّة قلبنا",50,"ن",2,0],["هذا العراق وضوءُ الربّ, مسجده ُ,","يا شاتما عِرض َارضي نالك الحممُ",51,"م",1,0],["هذا العتاب لمه؟ مهلاً عذوليَ مه","تحرَّقَتْ كبدٌ، أكبادُ كمْ شَبِمه",52,"م",2,0],["هذا العتابُ إليك يبسط كفه","جدْ من حنانك كم أطلت عنادا",53,"د",2,0],["هذا الْعذولُ بألْفِ عُذْرٍ صدّني","أَشْكو إِلَيكَ وأنْتَ ما أنْصَفْتَني",54,"ن",2,1],["هذا العراق ممزق الأوصال","بنظامهم ساقوا له الأسبابا",55,"ب",2,0],["هَذَاْ الْعَرِيْقُ كَإِطْنَاْبِ السُّهَاْ ذَهَبَتْ","أَضْوَاْؤُهُ جُمَلَاً فِيْ سَرْمَدٍ ذَهَبَيْ",56,"ب",2,0],["هذا العلاج ومن يعمل به سيرى","آثار خير ويكفي أمر علته",57,"ت",2,0],["هذا العذيب وفي مجاريه المنى","جار فهلا صادر أن وارد",58,"د",1,0],["هذا العذيب محط أسرار الهوى","باد فهلا قافل أو قاصد",58,"د",1,0],["هذا العذيب وهل يقاس بمائه","مستنقع كدر الموارد راكد",58,"د",1,0],["هذا العذيب فأين سرب رئامه","تجتاز بين ربوعه وخيامه",59,"م",2,1],["هذا العذيب وهذا الحي قد لمعت","فيه على البعد للسارين نيران",60,"ن",1,0],["هذا العراقُ وسوحُ المجدِ تعرفه","بيارقاً رفرفتْ باليسرِ والكَرْبِ",61,"ب",1,0],["هذا العراقُ جروحه","واللهِ ما إنْ تُحتوى",62,"و",2,0],["هذا العراقُ دمارُهُ لا ينتهي","والشامُ منْ نارٍ لظىً تتعبأُ",63,"ا",1,0],["هذا العراق وكل الناس يعرفه","فيه الألى للذرى منها المفاتيحُ",64,"ح",1,0],["هذا العتابْ نحوك وان فيه وصب","فإنّ قول الحرّ واصب",65,"ب",1,0],["هذا العراق وللزمان شهادة","فخر الخليقة لا يهان ويقهَرُ",66,"ر",1,0],["هذا العراق بأهله متفائل","لاتخذلوه ضمائرا ومواقفا",67,"ف",2,0],["هذا العراق بكلّ نبضٍ ماثلٌ","وبكلّ وجهٍ مقلة وعيونُ",68,"ن",1,0],["هذا العراقُ إذا تأخّرَ ردُّهُ","سيكونُ موتُ الغاصبينَ مصيرا",69,"ر",2,0],["هذا العراق وكان في","زمن من الأزمان بحرا",70,"ر",2,0],["هذا العراق ومنهُ غضبة ضيغمٍ","زأرٓت فهابته البهام صُميْدعا",71,"ع",2,0],["هذا العراق يلفه جوع العدى","ويلفه كيد به غدارُ",72,"ر",1,0],["هذا العمانيُ الذي لم يُثنِه بُعدٌ","ولم يُخطِ الهُدى عُنوانا",73,"ن",2,0],["هذا العيد أحسبّ إنه [ عزا ] هالنفس لي بيّه","هذا العيد ؟ .. أجل لحظه أبكشخ لي بهالزينه",74,"ن",2,0],["هذا العزوفُ شبيه بالذي أجدُ","قلبٌ يحيقُ بهِ ما يشتكي الجسدُ",75,"د",1,1],["هذا العراقُ مدى التاريخِ في ضنكٍ","مَنْ لم يطأهُ من القُوّادِ لا يصلُ",76,"ل",1,0],["هذا العراقُ زمانُ الصمتِ أرهقه","حتى يكادَ ضميرُ الحقِّ ينفجرُ",77,"ر",1,0],["[ هذا العَتِيكِيُّ هذا خَيْرُ مَنْ وَخَدَتْ","بِهِ النَّجائِبُ ذا مَنْ لِلضُّيُوفِ قَرَى ]",78,"ر",2,0],["هَذَا العَبِيرُ بِيَوْمِ العِشْقِ مُنْدَفِقٌ","مِنْ حُبِّهَا كَلَهِيبِ النَّارِ تَزْدَهِرُ",79,"ر",1,0],["هَذا العراق ُ لديك كلُّ سمائهِ","بَحرٌ يُقلَّبُ والبحُور حيارى",80,"ر",2,0],["هذا العَذابُ بِحُبِّها قَدْ ذُقْتُهُ","ما كُنتُ أعْرِفُ ما الهَوى لَوْلاها",81,"ا",3,0],["هذا العراقُ يئنُّ مِنْ زَمَن ولا","أحد يداويه فبات سقيما",82,"م",2,0],["هَذا العَزاءُ لِمُدنَفٍ وَصِبٍ","ذاقَ الأَسى في العِشقِ أَلوانا",83,"ن",2,0],["هذا العراق ُحروفُه أ ُرْجوزتي","فالعينُ عَيْنُ عَزيمة ٍ ومَضاء",84,"ا",2,0],["هذا العِراقُ شَهيدٌ","وليْسَ يُنْسى العِراقُ",85,"ق",1,0],["هذا العراق عراق الله لؤلؤه","تبات فيه شموس ليس كالنجم",86,"م",1,0],["هذا العراق سليل مجد مذ حوى","آل النبوة فازدهى بردائه",87,"ا",3,0],["هذا العُقوق ورثتهُ حِقَباً","فاستوطن الأنساغ والعصا",88,"ص",2,0],["هذا العفيف يداً، يعاف لسانه","ردّ الجواب على مقال الجاهل",89,"ل",1,0],["هذا العذيب وهذا الرند والبان","فسائل الربع أين الركب قد بانوا",90,"ن",3,1],["هذا العراق العطر في جنباته","ضَوْعُ الثرى ودم الحسين دليل",91,"ل",1,0],["هذا العظيم بشكله وبفعله","وبقوله.. رمزُ المحبة لا القِلى",92,"ل",2,0],["هذا العلاء ملاك الأرض قاطبة","فليس أثمنَ منه الشمسُ والقمرُ",93,"ر",1,0],["هذا العظيم مُذكري بعبارةٍ","قيلتْ بخالد الوليد لتُأثرا:",94,"ر",2,0],["هذا العشق والمشكله","ان المنال صعب الوصول",95,"ل",1,0],["هذا العراقُ، لكي يضيءَ لنا","دَربًا ... أَضاءَ العُمرَ واحتَرَقَا",96,"ق",2,0],["هذا العراقُ ... عرفتهُ ولدًا","وعشقتهُ ... عطرًا بنا عَلِقَا",96,"ق",2,0],["هَذا العراقُ بِكلِّ شِبْرٍ مُوْجَعٌ","سَيَئِنُّ ما نَزَلتْ بِأرضٍ نَائِبةْ",97,"ب",2,0],["هذا العظيم شعيب شيخنا . وهنا","موسى الكليم له الألواح تنتخب",98,"ب",1,0],["هذا العراق كأسيافٍ مقطّعةٍ","يعيش جيلٌ بِكِسْرِ الخبز مسكينا",99,"ن",2,0],["هذا العراقُ مُوزَّعُ الأشلاءِ لا","أرضٌ تُخطُّ ولا السياسةُ تُرسَم",100,"م",1,0],["هذا العراقُ ترى في النفطِ دولتَهُ","وباعة ُالنفطِ أمجادٌ مصاحيبُ!",101,"ب",1,0],["هذا العراقُ ترى الآبارَ تملؤهُ","وليس للشعبِ مِالآبار ِأنبوب !",101,"ب",1,0]]}