{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[10,"يا عين جودي بالدموع علي","https://www.aldiwan.net/poem21086.html","مجزوء الكامل"],[53,"حان كلام المعاتب الخرس","https://www.aldiwan.net/poem64655.html","المنسرح"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[46,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[107,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[77,"المدنفان من البرية كلها","https://www.aldiwan.net/poem69079.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[108,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[102,"الغبار والمرائي الباطنية","https://www.poetsgate.com/ViewPoem.aspx?id=50349",""],[102,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[101,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""],[139,"للعلم في عصر الضياء شروق","https://www.aldiwan.net/poem49040.html","الكامل"],[164,"الملك الناصر سلطاننا","https://www.aldiwan.net/poem58962.html","السريع"],[215,"أقبل العيد ما رأينا صفاه","https://www.aldiwan.net/poem46236.html","الخفيف"],[239,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[275,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[332,"رقرقت فيك ملاحني وغنائي","https://www.aldiwan.net/poem54944.html","الكامل"],[332,"يا ربة الشعر والأحلام ما صنعت","https://www.aldiwan.net/poem55054.html","البسيط"],[395,"وصيتي يا علي","https://www.aldiwan.net/poem54589.html","عموديه"],[420,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[436,"منتاب مصركما بالرفد مغمور","https://www.aldiwan.net/poem12354.html","البسيط"],[464,"أمدحه أبلج كالنهار","https://www.aldiwan.net/poem16108.html","الرجز"],[518,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[518,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"]],"verses":[["المُدَّعي أَنَّهُ بِحِكمَتِهِ","عَلَّمَ بقراطَ صَنعَةَ الطِبِّ",0,"ب",1,0],["المِدرَهُ الفَيّاضُ يَحمِلُ","عَن عَشيرَتِهِ الكِبَر",1,"ر",1,0],["المدنَفَاتِ العيون لا رمداً","الفاتراتِ الجفونِ لا النُّعُس",2,"س",1,0],["المُدَّعونَ عَلى الوَرى","حَقَّ القِيامَةِ وَالوِصايَه",3,"ا",3,0],["المَديحُ الجَزيلُ وَالشُكرُ وَالفِك","رُ وَمُرُّ العِتابِ وَالتَحريضُ",4,"ض",1,0],["المُدْرِكاتِ الحقَّ يَفْزَعُ صَارِخاً","ويَضِجُّ بين مَخالِبِ الأغوالِ",5,"ل",1,0],["المُدركاتُ عدُوَّهُ ولوَ انّهُ","قَمَرُ السّماءِ لَهُ النُّجومُ مَعاقِل",6,"ل",1,0],["المُدْنَفَانِ منَ البرِيّةِ كلِّهَا","جسمي وطَرْفٌ بابليٌّ أحوَرُ",7,"ر",1,1],["أَلمُدَّعُون الْبَحْثَ حِي","نَ الْقَصْدُ مِنْهُمْ أَنْ يَغِيبُوا",8,"ب",3,0],["المُدنْ مثل الناس في آجالها","تفنى البلاد إذا قضت أعمارها",9,"ر",3,0],["المداد الأبيض السريّ بلا","أيّ سرّ .. ما الذي يبدى ويضمر؟",10,"ر",1,0],["المدى يستحم في وعد عينيك","وينسى في شاطئيه انتظاره",11,"ر",2,0],["المدرجُ العاجيُّ.. بانتظاري","لي عندهُ خميلة ٌونبعُ..",12,"ع",1,0],["المدرك الأسرارَ وهي خفيّة","ومبِين وجه الحقّ وهو دقيق",13,"ق",1,0],["المدرة المحمود رب العطا","الناصر السلطان مفنى العدا",14,"د",2,0],["المدين الحزين يظما حتى","يشتهى أن يزيده الدين حزنا",15,"ن",2,0],["المُدلِيَينِ إِلى النَبِي","يِ مُحَمَّدٍ بِقَرابَتَينِ",16,"ن",1,0],["المدانى قاب قَوسين الَّذي","كان للأملاك وَالرسل اماما",17,"م",2,0],["المدفع الجبار فصل قضائهم","والهدم غايتهم من الإنشاء",18,"ا",2,0],["ألمد مد الأماني منك أدناني","والجزر جزر ابتئاسي عنك أنآنى",19,"ن",2,0],["المدعي للصلاح","وللعيوب جحود",20,"د",1,0],["المدْرِكونَ بعون الله ما طلبوا","والفائزون بما يرجون من أَمل",21,"ل",1,0],["المَدْحُ منهم بما أَبْدَتْ محاسِنُهُمْ","مُخَبِّرٌ ومُجيدُ المدح مخبورُ",22,"ر",1,0],["المُدْركينَ قاصياتِ الثَّارِ","والمُنْهِبي حَوافِرِ الجَرَّارِ",23,"ر",1,0],["المدركون ثار آل المصطفى","من بعد ما كاد يضيع ثاره",24,"ر",2,0],["المدح يدري أنكم أكبر","من كل ما ينظم أو ينثر",25,"ر",1,0]]}