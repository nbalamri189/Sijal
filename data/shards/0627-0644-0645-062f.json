{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[10,"يا عين جودي بالدموع علي","https://www.aldiwan.net/poem21086.html","مجزوء الكامل"],[53,"حان كلام المعاتب الخرس","https://www.aldiwan.net/poem64655.html","المنسرح"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[46,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[107,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[77,"المدنفان من البرية كلها","https://www.aldiwan.net/poem69079.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[108,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[102,"الغبار والمرائي الباطنية","https://www.poetsgate.com/ViewPoem.aspx?id=50349",""],[102,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[101,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""],[139,"للعلم في عصر الضياء شروق","https://www.aldiwan.net/poem49040.html","الكامل"],[164,"الملك الناصر سلطاننا","https://www.aldiwan.net/poem58962.html","السريع"],[215,"أقبل العيد ما رأينا صفاه","https://www.aldiwan.net/poem46236.html","الخفيف"],[240,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[276,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[333,"رقرقت فيك ملاحني وغنائي","https://www.aldiwan.net/poem54944.html","الكامل"],[333,"يا ربة الشعر والأحلام ما صنعت","https://www.aldiwan.net/poem55054.html","البسيط"],[396,"وصيتي يا علي","https://www.aldiwan.net/poem54589.html","عموديه"],[422,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[438,"منتاب مصركما بالرفد مغمور","https://www.aldiwan.net/poem12354.html","البسيط"],[466,"أمدحه أبلج كالنهار","https://www.aldiwan.net/poem16108.html","الرجز"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[520,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18483","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49912","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69353","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200805","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121765","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88953","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86508","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102928","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107517","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101363","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95800","البسيط"],[4797,"طيبك يابوخالد هماليل وبروق","https://www.poetsgate.com/ViewPoem.aspx?id=132242",""],[4798,"وطن الجنى","https://www.poetsgate.com/ViewPoem.aspx?id=20227",""],[4816,"اهداء للصديق سعيد الحجري","https://www.poetsgate.com/ViewPoem.aspx?id=199475",""],[4860,"حدث العاقل بما لا يعقله","https://www.poetsgate.com/ViewPoem.aspx?id=32518",""],[4984,"عِيدُ مِيلَاد","https://www.poetsgate.com/ViewPoem.aspx?id=200981",""],[4997,"الأحول","https://www.poetsgate.com/ViewPoem.aspx?id=108085",""],[5401,"بذر المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=85369",""],[5739,"هيه يالمسترجله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=131708",""],[5756,"أول الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=5365",""],[5757,"برقيّةٌ إلى المتنبّي","https://www.poetsgate.com/ViewPoem.aspx?id=59801",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5843,"أعطني حريتي اطلق يديه","https://www.poetsgate.com/ViewPoem.aspx?id=51302",""],[6093,"المدح (مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=188471",""],[6115,"من يطلب المدح كنّه يطلب الذمّه","https://www.poetsgate.com/ViewPoem.aspx?id=180489",""],[6134,"المدح فيك يضيق بالشعار","https://www.poetsgate.com/ViewPoem.aspx?id=169563",""],[6134,"يا أيها الشهم الرفيع مقامه","https://www.poetsgate.com/ViewPoem.aspx?id=169528",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""]],"verses":[["المُدَّعي أَنَّهُ بِحِكمَتِهِ","عَلَّمَ بقراطَ صَنعَةَ الطِبِّ",0,"ب",1,0],["المِدرَهُ الفَيّاضُ يَحمِلُ","عَن عَشيرَتِهِ الكِبَر",1,"ر",1,0],["المدنَفَاتِ العيون لا رمداً","الفاتراتِ الجفونِ لا النُّعُس",2,"س",1,0],["المُدَّعونَ عَلى الوَرى","حَقَّ القِيامَةِ وَالوِصايَه",3,"ا",3,0],["المَديحُ الجَزيلُ وَالشُكرُ وَالفِك","رُ وَمُرُّ العِتابِ وَالتَحريضُ",4,"ض",1,0],["المُدْرِكاتِ الحقَّ يَفْزَعُ صَارِخاً","ويَضِجُّ بين مَخالِبِ الأغوالِ",5,"ل",1,0],["المُدركاتُ عدُوَّهُ ولوَ انّهُ","قَمَرُ السّماءِ لَهُ النُّجومُ مَعاقِل",6,"ل",1,0],["المُدْنَفَانِ منَ البرِيّةِ كلِّهَا","جسمي وطَرْفٌ بابليٌّ أحوَرُ",7,"ر",1,1],["أَلمُدَّعُون الْبَحْثَ حِي","نَ الْقَصْدُ مِنْهُمْ أَنْ يَغِيبُوا",8,"ب",3,0],["المُدنْ مثل الناس في آجالها","تفنى البلاد إذا قضت أعمارها",9,"ر",3,0],["المداد الأبيض السريّ بلا","أيّ سرّ .. ما الذي يبدى ويضمر؟",10,"ر",1,0],["المدى يستحم في وعد عينيك","وينسى في شاطئيه انتظاره",11,"ر",2,0],["المدرجُ العاجيُّ.. بانتظاري","لي عندهُ خميلة ٌونبعُ..",12,"ع",1,0],["المدرك الأسرارَ وهي خفيّة","ومبِين وجه الحقّ وهو دقيق",13,"ق",1,0],["المدرة المحمود رب العطا","الناصر السلطان مفنى العدا",14,"د",2,0],["المدين الحزين يظما حتى","يشتهى أن يزيده الدين حزنا",15,"ن",2,0],["المُدلِيَينِ إِلى النَبِي","يِ مُحَمَّدٍ بِقَرابَتَينِ",16,"ن",1,0],["المدانى قاب قَوسين الَّذي","كان للأملاك وَالرسل اماما",17,"م",2,0],["المدفع الجبار فصل قضائهم","والهدم غايتهم من الإنشاء",18,"ا",2,0],["ألمد مد الأماني منك أدناني","والجزر جزر ابتئاسي عنك أنآنى",19,"ن",2,0],["المدعي للصلاح","وللعيوب جحود",20,"د",1,0],["المدْرِكونَ بعون الله ما طلبوا","والفائزون بما يرجون من أَمل",21,"ل",1,0],["المَدْحُ منهم بما أَبْدَتْ محاسِنُهُمْ","مُخَبِّرٌ ومُجيدُ المدح مخبورُ",22,"ر",1,0],["المُدْركينَ قاصياتِ الثَّارِ","والمُنْهِبي حَوافِرِ الجَرَّارِ",23,"ر",1,0],["المدركون ثار آل المصطفى","من بعد ما كاد يضيع ثاره",24,"ر",2,0],["المدح يدري أنكم أكبر","من كل ما ينظم أو ينثر",25,"ر",1,0],["المد كالنصب وكالنصبين مط","في الكل والمشق ثلاثه تخط",26,"ط",1,0],["المدرِكونَ إذا أيديهم طلبت","والسابقون برأس الوترِ من طلبا",27,"ب",2,0],["المدركونَ من الغايات ما طلبوا","والنَّازلونِ كراماً حيثُ ما شاؤا",28,"ا",2,0],["المُدركيِّ الحُميديِّ الَّذي شَهِدَت","لَهُ البَرِيَّةُ قاصِيها وَدانِيها",29,"ي",3,0],["المدحُ والمُدّاح إنْ قصَّروا","عنك فَفي حِلْمك أن تَقْبلاَ",30,"ل",2,0],["المداني قاب قوسين الذي","نال مرأى واقتراباً وكلاما",31,"م",2,0],["المدح يحسبُه اللبيب تهكمّاً","إن لم يؤيده دليلٌ مقنعُ",32,"ع",1,1],["المَدُّ بعد الجَزْرِ قالوا إنه","يأْتِي من البدرِ المُنِيرِ الطَّالِعِ",33,"ع",1,1],["المدير المدبّر الليث في الحر","ب سديد الآراء فيما يديرْ",34,"ر",1,0],["المدح يقصر أن أرد حسناته","هو قدره عن كل مدح أكثر",35,"ر",1,0],["المدح شرح المكرمات وكم ترى","في المدح كل منقحٍ ومصنف",36,"ف",1,0],["المدرك الأمد البعيد بسابق","من دون خطوته بلوغ ذكاء",37,"ا",2,0],["المدحُ ليس لهُ بغيركِ رونقُ","مهما ينمِّق شاعرٌ ويُرقَقُ",38,"ق",1,1],["المدلجون العيس تحمل غلمة","أجفانهم مالت إلى التهويم",39,"م",1,0],["المدركين بجدهم شأو العلا","أهل المكارم باليد البيضاء",40,"ا",2,0],["المَدحُ عندهُمُ قُربى وَقَصدُهُم","يدٌ لديهم وَأُفق الجود مَقصود",41,"د",1,0],["المدح فنجال ليمناك مسيوق","ما دام طيبك في دلال الفعل فاح",42,"ح",1,0],["المدح فنجال ٍ ليمناك مسيوق","تقهو دام المدح في خاطري فاح",42,"ح",1,0],["المدنياتِ لك الشوامخَ من علٍ","والجنةِ الأخرى تكاشفُ من مِنى",43,"ن",2,0],["المدح في طاريك تزهى حروفه","ان جاب راعي القرب او جاب نافي",44,"ف",2,0],["المدح لو زاد يصبح معضله","يعني لا هذا ولا هذا...أبي",45,"ب",2,0],["المَدْخَلُ الْأَثَرِيُّ منفتح على","عصر بعيد في الرؤى يتعثر",46,"ر",1,0],["المدحُ قالوا في الوجوهِ مذمةٌ","والّذمُّ مدحٌ للكبير يُجمِّلُ",47,"ل",1,0],["المد عالي وكنز البحر يبغى كفاح","ماكل نهام وقت العاصفه يربحه",48,"ح",2,0],["المدارس من نشاط ليا فتور.","لا عقاب ولا حساب ولا نظير.",49,"ر",1,0],["المديره من تديره في حدور.","والعلامه واضحه كبر البعير.",49,"ر",1,0],["المدح في غيرك من الناس نقصان","والخير منغيرك مثل مدة الدين",50,"ن",1,0],["المدْحُ فيكَ ينُوءُ بالعَزْم ِالذي","هدَّ اليَرَاعَ.. وزادَهُ القِرْطاسُ",51,"س",1,0],["المدح في شخصكم يحتاج شاعر فطين","ما يمدح إلا هل الطالات وأبطالها",52,"ل",3,0],["المدينه ماعرفت سر أرتحالي","يوم حشت الباب وأعطيتك قفايه",53,"ا",3,0],["المَدْحُ ذَاكَ هَدِيَّةٌ","أُهْدِيْهِ لِلأحْبَاب",54,"ب",1,1],["المدح ماهو لمن يسعى ورى النمّه","ولا لمن للمنافق يرخي اذانه",55,"ن",2,0],["المدح للي يقف دايم على القمّه","فعله ومجده يسويها بذرعانه",55,"ن",2,0],["المدح للى بدلوه ياصل الجمّه","كريم ويعز زواره وضيفانه",55,"ن",2,0],["المدح للي يسد السمع ويصمّه","عن كل واشي خبيث النفس مرضانه",55,"ن",2,0],["المدح للي مايرضى في ولد عمّه","يسخى بروحه في الضيقه على شانه",55,"ن",2,0],["المدح مايقبل المخذول والرمّه","الفسل يبقى على زوره وبهتانه",55,"ن",2,0],["المدح فيك يضيق بالشعار","يامن حويت محامد الأثار",56,"ر",1,1],["المدح فيك أقل ما هو واجب","والشكر فرض مع جزيل ثناء",57,"ا",2,0],["المدى ارتاع وأعيا كبرَهُ","بلبلٌ حام بعينيكِ وطار",58,"ر",1,0]]}