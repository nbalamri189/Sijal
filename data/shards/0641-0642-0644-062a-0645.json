e/diwan/poem/104933","السريع"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67575","الرجز"],[4692,"شعري كل ما أملك","https://www.poetsgate.com/ViewPoem.aspx?id=196832",""],[4858,"حنين إلى الأهل والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=138206",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[585,"ذكرت له أيامنا فتنهدا","https://www.poetsgate.com/ViewPoem.aspx?id=161845",""],[585,"هي الجزيرة فيها الصيحة العمم","https://www.poetsgate.com/ViewPoem.aspx?id=161893",""],[5087,"أجتاز بي اليوم في الطريق فتى","https://www.poetsgate.com/ViewPoem.aspx?id=96361",""],[5136,"شريت منه وردة شمها","https://www.poetsgate.com/ViewPoem.aspx?id=121593",""],[5186,"رمى النهب عن قوس الهوى رآئش التهم","https://www.poetsgate.com/ViewPoem.aspx?id=156476",""],[5186,"غيد الهوى والجوى حاولن تجريبي","https://www.poetsgate.com/ViewPoem.aspx?id=156473",""],[5277,"مناجل الخجل","https://www.poetsgate.com/ViewPoem.aspx?id=186030",""],[5320,"غزال","https://www.poetsgate.com/ViewPoem.aspx?id=41641",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5443,"دموع اليراع في ليل الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=185143",""],[5497,"هيفاء غانيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=208895",""],[5497,"جادت تودعني","https://www.poetsgate.com/ViewPoem.aspx?id=210242",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5605,"شاعر الجود","https://www.poetsgate.com/ViewPoem.aspx?id=159616",""],[5612,"في ساحةِ الوَجْد","https://www.poetsgate.com/ViewPoem.aspx?id=179431",""],[5733,"مَرَرْتُ بِزاهٍ عَلىَ بِاِبه","https://www.poetsgate.com/ViewPoem.aspx?id=201640",""],[5761,"شكوني لأبي .","https://www.poetsgate.com/ViewPoem.aspx?id=13805",""],[5790,"قالوا الرشيدي على ما به","https://www.poetsgate.com/ViewPoem.aspx?id=111940",""],[5881,"تنثر أعذاراً وتختلق","https://www.poetsgate.com/ViewPoem.aspx?id=183796",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[6152,"بك إكتملت حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=205864",""],[5309,"قالت جماعة مغرورين نحن هنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573901",""],[6355,"اليأس ينحت عمري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66549&r=&rc=9",""],[6355,"إنجازات تربيتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66637&r=&rc=97",""]],"verses":[["فقلت معاذ الشيب يا غيرك الفنى","لقد وقر الباقي من العمر ذاهبه",0,"ب",2,0],["فَقُلتُ مَن مُعاقِدي","عَلى الرَدى قالَ أَنا",1,"ن",2,0],["فَقُلْتُ مَا بَالُهُمُ قَالَ لِي","أُلْقِيَ لِلْحُبِّ كِتَابٌ كَريمْ",2,"م",1,0],["فقلتَ: ما كان عبدُ الله يُشبِعُها","لو لم يكن وَلَدي أو كان يُرويها",3,"ي",3,0],["فقلت من سحر عينيك الذي سُحرت","به المشاعر من سمع ومن بصر",4,"ر",1,0],["فقلت مشيراً نحوها بحفاوة","إلا أن هذا الشعر من أبدع الشعر",5,"ر",1,0],["فَقُلتُ ماهَذا الصِياحُ وَالقَلَق","أَكُلُّ هَذا فَرَحٌ بِذا الطَلَق",6,"ق",1,0],["فقلتُ مدح العلاءِ أعذبُ من","تغزُّلي واقتضيتها رتبه",7,"ب",2,0],["فقلتُ من كُثرِ ما أشكو بهِ ضرراً","والشعرُ يفسده كُثرُ الضرورات",8,"ت",1,0],["فقلتُ ما تطريز هذا الأذى","فقلن هذا الحلط والبلغم",9,"م",1,0],["فقلتُ ما الاسم قال موسى","قلت هنا تحلق الذقون",10,"ن",1,0],["فقلت ما أعجب ذا غِرَّة","يهدي ذوي الحُنْكَةِ للقصْدِ",11,"د",1,0],["فقلت ما ناك مثلي مثل زوجته","لكن إخال عدواً كاشحاً نزغه",12,"غ",2,0],["فقلتُ مُدامُ أفواهِ الغواني","مُدامٌ لا يعادله مُدامُ",13,"م",1,0],["فَقُلتُ مَنازِلُنا خالِيَه","مِنَ الفَحم وَالفَحمُ نار وَنور",14,"ر",1,0],["فَقُلتُ مَن هَذا فَقالَ صَحبي","مُوَسوَسٌ يَهذي مِنَ الخُبالِ",15,"ل",1,0],["فَقُلتُ ما أَنا مِمَّن لا يُواصِلُني","وَلا ثَوائِيَ إِلّا رَيثَ أَرتَحِلُ",16,"ل",1,0],["فقلت مرحى ولكن","لي في يقينك شك",17,"ك",1,0],["فَقُلتُ مَنِ الحامي أَلَيثٌ غَضَنفَرٌ","مِنَ التُركِ ضارٍ أَم غَزالٌ مُرَبَّبُ",18,"ب",1,0],["فقلتُ مِنْ بعد ما شَاهَدْتُ هَيئتَهُ","حَسْبِي بِذَا عِوَضاً مِنْ خَمْرَتي وكَفا",19,"ف",2,0],["فقلتُ ما أنتِ مثلي أنتِ في دَعَةٍ","طولَ النهارِ ويومي كلُّهُ قَلقُ",20,"ق",1,0],["فَقُلتُ ما هُوَ إِلّا الشَأمُ تَركَبُهُ","كَأَنَّما المَوتُ في أَجنادِهِ البَغَرُ",21,"ر",1,0],["فقلت ما يبكيك قل لي لقد","اصبحت في ديوان أموات",22,"ت",1,0],["فَقُلتُ مَلَلتُ السَيرَ مُذ ظَفِرَت يَدي","بِأَضعافِ ما أَختارُهُ وَأُريدُ",23,"د",1,0],["فَقُلتُ مَع قِلَّةِ الأَنصارِ وَالخَوَلِ","لَو كُنتُ مِن مازِنٍ لَم تَستَبِح إِبِلي",24,"ي",1,0],["فَقُلتُ ما بالُ هَذا ال","فَتى اِشمَأَزَّ وَصَدّا",25,"د",2,0],["فقلتُ ما هوَ في أعراضِ عدَّتِهِ","إلاَّ أغنُّ غضيضُ الطرفِ مكحولُ",26,"ل",1,0],["فقلتُ ما تصنعُ يا منيتي","قال توابيتٌ لعشاقي",27,"ي",1,0],["فقلتُ ماذي خلعةٌ","بل لعنةٌ مزوَّقهْ",28,"ه",1,0],["فقلتُ من يرضى خمولي إذنْ","فكنتَ أنتَ المحسِنُ المجمِلا",29,"ل",2,0],["فقلتُ ما هو في الأعراضِ أجمعِها","إلا أغنُّ غضيضِ الطرفِ مكحولُ",30,"ل",1,0],["فقلتُ ما ذا وَقْتُهُ فارجعي","وعاوديني ليلةً غَيْرَها",31,"ه",2,0],["فَقُلتُ مَن ذا المُحَيِّيَ وَاِنتَبَهتُ لَهُ","أَم مَن مُحَدِّثُنا هَذا الَّذي زارا",32,"ر",2,0],["فَقُلتُ مَروعاً لِلرَسولِ الَّذي أَتى","تَراهُ لَكَ الوَيلاتُ مِن أَمرِها جِدّا",33,"د",2,0],["فَقُلتُ مَرُوعاً لِلرَسُولِ الَّذي أَتى","تُراهُ لَكَ الوَيلاتُ مِن نَفسِها جِدّا",34,"د",2,0],["فَقُلتُ ما لي حاجَةٌ غَيرَها","فَقالَ ها مِنكَ لَقيتُ البَلاءِ",35,"ا",2,0],["فَقُلتُ مَن ذا الَّذي بِالنارِ عَذَّبَها","لا خَفَّفَ اللَهُ عَنهُ كُربَةَ النارِ",36,"ر",1,0],["فَقُلتُ مَن أَنتَ بِالمَسيحِ وَبِال","إِنجيلِ سَطَّرتُهُ عَلى وَرَقِه",37,"ق",2,0],["فَقُلتُ ما كانَتِ الحُمّى لِتَعهَدَني","مِن غَيرِ ما عِلَّةٍ إِلّا لِحُمّاكا",38,"ك",2,0],["فَقُلتُ موسى نَجِيُّ ال","مُهَيمِنِ المَنّانِ",39,"ن",1,0],["فقلتُ متى رأيتَ الذ","ئبَ مأموناً على الغَنَم",40,"م",1,0],["فَقُلتُ مَعاذَ اللَهِ لَستُ بِفاعِلٍ","نَهاني أَميرُ المُؤمِنينَ أَميري",41,"ر",2,0],["فَقُلتُ مُعَبِّراً ذَهَبٌ ذَهابي","وَتِلكَ نَباهَةٌ لي في اِندِراسي",42,"س",2,0],["فقلت ما غير وهم","أكبره الوصف والنعوت",43,"ت",1,0],["فَقُلْتُ مَا لِحُمُولِ الحَيِّ قَدْ خَفِيَتْ","أَكَلَّ طَرْفِيَ أَمْ غَالَتْهُمُ الغُولُ",44,"ل",1,0],["فقُلْتُ مَنِ الزَّائِرِي والدُّجى","يَسُدُّ العُيُونَ بِثَوْبٍ أَحمّ",45,"م",1,0],["فقلت ما رأيك في منزل","خال وفي قصف وفي خمر",46,"ر",1,0],["فقلت: ما شرطك؟ فاستصعبت","واشترطت ما جاز عن قدري",46,"ر",2,0],["فقُلتُ مُفَرِّج الكُرُبا","تِ أَودى وَالبُكا فَرَجُ",47,"ج",1,0],["فقلت: ما أنت؟ قالت: إنني عرقُ","من جبهة الزارع المسكين قَدْ سالا!",48,"ل",2,0],["فقلت مطاراٍ امة الشرق هكذا","تملكت الاطيار أعلى الممالك",49,"ك",1,0],["فقُلتُ : مالي حاجَة ٌ غَيرَها ،","فقال: هامنك لقيتُ البضلاءْ",50,"ا",2,0],["فقلتُ مقال أخي فطنة ٍ،","سَمِيعٍ بِمَنْطِقِها مُبْصِر:",51,"ر",1,0],["فقلت من فرط شؤن الهوى","وكوكب الصبح المنيع استنار",52,"ر",1,0],["فقلت ما الكتم والآثار ظاهرة","ظهور نار القرى ليلاً على علم",53,"م",1,0],["فَقُلتُ مَا شَاهَدَتَ عَينَاكِ فِيهِ مِنَ السَيسَا","عَلَى مَا ادَّعَاهُ النَّاسُ مِن عَظَمَه",54,"م",2,0],["فقلت من الأفراح فيه مؤرخاً","لتأهيل سعدٍ طالع البدر أسفرا",55,"ر",2,0],["فقلت مولاي قد خرّجتَ نابتةً","فيما مضى يا لهم من فتيةٍ نُجبِ",56,"ب",1,0],["فقلت مَن عجم الأعوادِ مختبراً","أحوالها ماز بين النبع والغرَبِ",56,"ب",1,0],["فقلت معاذ الله ما أنا منهمو","فإن تصبري أحمدت والخير في الصبرِ",57,"ر",1,0],["فقلت مقيمٌ يجيبُ المنَى","ويجمع بين الغِنى والغَناءِ",58,"ا",2,0],["فقلتُ من التعجب كيف هذا","بِلا واشٍ أَتيتَ وَلا رَقيبِ",59,"ب",1,0],["فقلتم عليك الرفق فالرفق لم يكن","مع الشيء إلا زان منه وسددا",60,"د",2,0],["فقلتم على كره رضينا بحكمه","ففقر يقاسي في الحيوة ولا القتل",61,"ل",1,0],["فقلت مهلا فأما أحمد ففتى","ذا غيرة كان في البارى وذا غضب",62,"ب",1,0],["فقلت ما كسبك أو ما الذي","تقتاته من نفل جاري",63,"ر",2,0],["فقلت مهر المثل في مذهبي","عدل على أبعد غاياته",64,"ت",2,0],["فقلت من ذا الذي أرجوه لي فرجا","فقال أنا فرج زن لي كرى البيت",65,"ت",1,0],["فقلت من خدها أم من لواحظها","أم من تدللها أم من تأبيها",66,"ي",3,0],["فقلتُ متى أراك أبا حسينٍ","فجاوبني إذا اتَّسخت ثيابي",67,"ي",1,0],["فقلت ما قال قبلي نسوةٌ بصرت","بيوسف الحسن ما هذا الفتى بَشرا",68,"ر",2,0],["فقلت ما قوبلت بالرد من خطأ","الا لكثرة ما فيها من الكذب",69,"ب",1,0],["فقلت مؤرخاً نصر سعيد","بنصب مدافع الطرز الجديد",70,"د",1,0],["فقُلتُ مهلاً فما عليكِ إن ام","سيتُ غوياً غيِّي ولا رشدي",71,"د",2,0],["فقلت ماتَ حماري","تعيش أنت وتبقى",72,"ق",2,0],["فقلت ما أحسن ما قلتمُ","أقوم حتى ألحق الظهرا",73,"ر",2,0],["فَقُلتُ مَن أيُّكُم واللهُ يَأجُرُهُ","يُعيرُ قُوَّتَهُ مِنّي إلى ضَعَفِي",74,"ف",2,0],["فقلتُ من المحاسنِ زوّدِيني","لآمَنَ في العواثيرِ العِثارا",75,"ر",2,0],["فَقُلتُ ما الشعرُ هَذا ما ترينَ به","وإنَّما هو نَبتُ الحِلم والكَرَمِ",76,"م",1,0],["فقلت منهوم الهوى لم يكن","يشبع إن لذت له المائده",77,"ه",1,0],["فَقُلتُ مُعتذراً خوفَ الوشاةِ رَقا","دَمعي فصابُ فُؤادي لا يروّيهِ",78,"ي",2,0],["فَقُلت ما فيهِ نَقص لَو وزنت لَكُم","صِفاته يا بدور الحلم وَالرَشدِ",79,"د",1,0],["فَقُلت مَتى يَعرو عذولي ماغس","فَقالَ وَهَل واش لعرضك ماغثُ",80,"ث",1,0],["فقلتُ مْجِلِسَ عزِّ الدّينِ فاستَبَقَتْ","شَوقاً إلى مَدْحِ عُلْياهُ قَوافيه",81,"ي",2,0],["فقلتُ من أي نائكِيهِ تُرى","فقال مِمَّن ولِي القضا بعده",82,"د",2,0],["فقلتُ معاذَ اللهِ أخدَعُ خُلّةً","على حينَ زُمّتْ للرّحيلِ رِكاب",83,"ب",1,0],["فقُلتُ ما أَحسنَ ما قُلتَهُ","لَو كانَ ما تَذكرُه تَفعَلُه",84,"ه",1,0],["فقلت ماجرالك تقطعنه","وأنت أخو الفصاحة والبيان",85,"ن",1,0],["فقلت من يعرفه","لفقده ينتحب",86,"ب",1,0],["فقلت ما كل فتىً","من الرجال يُحْبَبُ",86,"ب",1,0],["فقلتُ مالي وكَتمِي ما تُخالِجُني","فيه الظّنونُ كفعلِ المُغضَبِ المَلِقِ",87,"ق",1,0],["فقلتُ ما أَقْبَحَ ما","جئتَ به يا رَجُلُ",88,"ل",1,0],["فقلتُ ما أحسنَ قطْرَ النّدى","منتثراً في ورقِ الورْدِ",89,"د",1,0],["فقلت مَهٍ لم تدرِ أَني مبرّز","على كل غرّيد بما أنا صادح",90,"ح",1,0],["فقلتُ منْ وابنُ من هذا فإنَّ لهُ","عقلاً وعقلُ الفتى من أشرف الشّيَم",91,"م",1,0],["فقلت من لم يكن مثلي ومثلهم","في الوجد والحسن فالتفريق يسليه",92,"ي",2,0],["فقلت من فرط وجدي","نعم المساء مسائي",93,"ي",1,0],["فقلت من فرط وجدي","ولم أكن بالسفيه",94,"ي",2,0],["فقلت مدحت الشيخ شعرا مشاركا","بني وطني مذ ألبسوه التهانيا",95,"ي",2,0],["فقلت متى صددت عن القوافي","وأين أنا كأني في المنام",96