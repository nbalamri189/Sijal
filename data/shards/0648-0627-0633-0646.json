{"poems":[[63,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[29,"ألا يا إسلمي بالسعد يا أخت دارم","https://www.aldiwan.net/poem6171.html","الطويل"],[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[97,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[210,"خطرت تسحب أذيال الرسم","https://www.aldiwan.net/poem26481.html","عموديه"],[222,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[238,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[276,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[276,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[354,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[366,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[378,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[440,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[478,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[516,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[516,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"]],"verses":[["وأسِنّةُ المُرّانِ حَولَ بُيوتِهِمْ","شُدَّتْ بِها عُذُرُ العِتاقِ الضُّمَّرِ",0,"ر",1,0],["وَأُسنِدَ أَمرُ الحَيِّ بَعدَ اِلتِباسِهِ","إِلى كُلِّ جَلدٍ مُبرَمِ الأَمرِ حازِمِ",1,"م",1,0],["وَأَسنى الوَردُ إِذ أَعطى شَذاهُ","مَكانَتَهُ فَكُن في الواهِبينا",2,"ن",2,0],["وأسنى من تخطَّر في دلال","وأطهر من تعثَّر في حياء",3,"ا",2,0],["واسندي رأسَكِ الصغيرَ إلى","ثائرٍ في الضلوع مُضطربِ",4,"ب",1,0],["واسندوا الرأي إليهم كلما","عبس الدهر إليكم وابتسم",5,"م",1,0],["واسندوا الحكم للكرام فمنا","في الهوى والضلال عالم رجس",6,"س",1,0],["وَأَسْنِدِ اللهُ لَهَمْ هِمَماً","مَا أُسْنِدَ الْحُسْنُ إِلَى الظَّبْيَهْ",7,"ي",2,0],["وَأسْنَى الفُتُوحِ الطَّالِعاتُ سَوَافِراً","ولم تَتَلَثَّم بالقَتَامِ العَساكِرُ",8,"ر",1,0],["وَأسْنَى البَذْل من مَوْلَىً جَوادٍ","إصَاخَتُهُ إلى عَبْدٍ شكورِ",9,"ر",1,0],["وَأَسنى لهُ الخاقانُ منزلةً جَلَت","عَلى الدولِ العُظمى على الدولةِ الوسطى",10,"ط",2,0],["وَأَسنى الأَذكياء نُهىً وَحلماً","وَأَصفى الأَغنياء تُقىً وَزُهدا",11,"د",2,0],["وإِسنادُ الأَسِنَّةِ نحوَ نَحري","وَهَزُّ المَشرَفِيَّةِ والوُقوعُ",12,"ع",1,0],["واسنِد إلى مريمٍ ما حزتَ من حكمٍ","فالفضل في غيرها في الناس لم يَقُم",13,"م",1,0],["وأَسِنَّةُ الخَطِّ الَّتِي خَطَّتْ عَلَى","شِيَعِ الضلالَةِ حَينَها المحتوما",14,"م",2,0],["واسنانه انقضت وفي ظهره انحنا","ومحمر ذاك الدم قد صار أصفرا",15,"ر",2,0],["وأسنشقُ الاْرواحَ مِن نحوِ أرضِه","ليذهبُ ما ألقاهُ مِن غلَّةِ الصدرِ",16,"ر",1,0],["وأسنانٌ تُفدّيها اللآلي","بأكبرِها وإن كانت صِغارا",17,"ر",2,0],["وأسند الدهر إليهم ظهره","فعز ظهر الدهر باستناده",18,"د",2,0],["وأسندت الأمور إلى عظيم","يكشف غمة الكرب العظام",19,"م",1,0]]}