{"poems":[[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[31,"ألا يا إسلمي بالسعد يا أخت دارم","https://www.aldiwan.net/poem6171.html","الطويل"],[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[99,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[213,"خطرت تسحب أذيال الرسم","https://www.aldiwan.net/poem26481.html","عموديه"],[225,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[241,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[279,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[279,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[309,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[357,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[369,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[381,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[443,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[466,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[480,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[517,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[518,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[518,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21442","الطويل"]],"verses":[["وأسِنّةُ المُرّانِ حَولَ بُيوتِهِمْ","شُدَّتْ بِها عُذُرُ العِتاقِ الضُّمَّرِ",0,"ر",1,0],["وَأُسنِدَ أَمرُ الحَيِّ بَعدَ اِلتِباسِهِ","إِلى كُلِّ جَلدٍ مُبرَمِ الأَمرِ حازِمِ",1,"م",1,0],["وَأَسنى الوَردُ إِذ أَعطى شَذاهُ","مَكانَتَهُ فَكُن في الواهِبينا",2,"ن",2,0],["وأسنى من تخطَّر في دلال","وأطهر من تعثَّر في حياء",3,"ا",2,0],["واسندي رأسَكِ الصغيرَ إلى","ثائرٍ في الضلوع مُضطربِ",4,"ب",1,0],["وأسنى حظوظي أن أوفق معية","وحب الى يوم القيامة دائم",5,"م",1,0],["واسندوا الرأي إليهم كلما","عبس الدهر إليكم وابتسم",6,"م",1,0],["واسندوا الحكم للكرام فمنا","في الهوى والضلال عالم رجس",7,"س",1,0],["وَأَسْنِدِ اللهُ لَهَمْ هِمَماً","مَا أُسْنِدَ الْحُسْنُ إِلَى الظَّبْيَهْ",8,"ي",2,0],["وَأسْنَى الفُتُوحِ الطَّالِعاتُ سَوَافِراً","ولم تَتَلَثَّم بالقَتَامِ العَساكِرُ",9,"ر",1,0],["وَأسْنَى البَذْل من مَوْلَىً جَوادٍ","إصَاخَتُهُ إلى عَبْدٍ شكورِ",10,"ر",1,0],["وَأَسنى لهُ الخاقانُ منزلةً جَلَت","عَلى الدولِ العُظمى على الدولةِ الوسطى",11,"ط",2,0],["وَأَسنى الأَذكياء نُهىً وَحلماً","وَأَصفى الأَغنياء تُقىً وَزُهدا",12,"د",2,0],["وإِسنادُ الأَسِنَّةِ نحوَ نَحري","وَهَزُّ المَشرَفِيَّةِ والوُقوعُ",13,"ع",1,0],["واسنِد إلى مريمٍ ما حزتَ من حكمٍ","فالفضل في غيرها في الناس لم يَقُم",14,"م",1,0],["وأَسِنَّةُ الخَطِّ الَّتِي خَطَّتْ عَلَى","شِيَعِ الضلالَةِ حَينَها المحتوما",15,"م",2,0],["واسنانه انقضت وفي ظهره انحنا","ومحمر ذاك الدم قد صار أصفرا",16,"ر",2,0],["وأسنشقُ الاْرواحَ مِن نحوِ أرضِه","ليذهبُ ما ألقاهُ مِن غلَّةِ الصدرِ",17,"ر",1,0],["وأسنانٌ تُفدّيها اللآلي","بأكبرِها وإن كانت صِغارا",18,"ر",2,0],["وأسند الدهر إليهم ظهره","فعز ظهر الدهر باستناده",19,"د",2,0],["وأسندت الأمور إلى عظيم","يكشف غمة الكرب العظام",20,"م",1,0],["وأَسنانَ سَوءٍ شاخِصاتٍ كأَنَّها","سوامُ أُناسٍ سارحٌ قَد تَبَدّدا",21,"د",2,0]]}