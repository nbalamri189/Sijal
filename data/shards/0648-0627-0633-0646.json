{"poems":[[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[31,"ألا يا إسلمي بالسعد يا أخت دارم","https://www.aldiwan.net/poem6171.html","الطويل"],[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[99,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[213,"خطرت تسحب أذيال الرسم","https://www.aldiwan.net/poem26481.html","عموديه"],[226,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[242,"إن رجالا زينوا الحليه","https://www.aldiwan.net/poem19745.html","السريع"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[358,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[370,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[382,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[445,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[482,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[520,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66968","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96358","الطويل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75742","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119280","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35345","الوافر"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216849",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64541","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122030","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53150","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27207","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47173","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21442","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75888","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116498","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132705","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62803","الطويل"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35066","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34667","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59491","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101367","الوافر"],[4125,"","https://poetry.dctabudhabi.ae/diwan/poem/203229","الطويل"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145391","الطويل"],[4718,"انا عضيدي لابغيته","https://www.poetsgate.com/ViewPoem.aspx?id=137153",""],[4724,"ماس وغصونه مواريجي","https://www.poetsgate.com/ViewPoem.aspx?id=25792",""],[4750,"بهازيج الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=180401",""],[5122,"لا قلت ....!","https://www.poetsgate.com/ViewPoem.aspx?id=28150",""],[5436,"صبر ايوب / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177648",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5644,"إني معك","https://www.poetsgate.com/ViewPoem.aspx?id=198655",""],[5725,"ضرباً بهارية الصفاح","https://www.poetsgate.com/ViewPoem.aspx?id=177494",""]],"verses":[["وأسِنّةُ المُرّانِ حَولَ بُيوتِهِمْ","شُدَّتْ بِها عُذُرُ العِتاقِ الضُّمَّرِ",0,"ر",1,0],["وَأُسنِدَ أَمرُ الحَيِّ بَعدَ اِلتِباسِهِ","إِلى كُلِّ جَلدٍ مُبرَمِ الأَمرِ حازِمِ",1,"م",1,0],["وَأَسنى الوَردُ إِذ أَعطى شَذاهُ","مَكانَتَهُ فَكُن في الواهِبينا",2,"ن",2,0],["وأسنى من تخطَّر في دلال","وأطهر من تعثَّر في حياء",3,"ا",2,0],["واسندي رأسَكِ الصغيرَ إلى","ثائرٍ في الضلوع مُضطربِ",4,"ب",1,0],["وأسنى حظوظي أن أوفق معية","وحب الى يوم القيامة دائم",5,"م",1,0],["واسندوا الرأي إليهم كلما","عبس الدهر إليكم وابتسم",6,"م",1,0],["واسندوا الحكم للكرام فمنا","في الهوى والضلال عالم رجس",7,"س",1,0],["وَأَسْنِدِ اللهُ لَهَمْ هِمَماً","مَا أُسْنِدَ الْحُسْنُ إِلَى الظَّبْيَهْ",8,"ي",2,0],["وَأسْنَى الفُتُوحِ الطَّالِعاتُ سَوَافِراً","ولم تَتَلَثَّم بالقَتَامِ العَساكِرُ",9,"ر",1,0],["وَأسْنَى البَذْل من مَوْلَىً جَوادٍ","إصَاخَتُهُ إلى عَبْدٍ شكورِ",10,"ر",1,0],["وَأَسنى لهُ الخاقانُ منزلةً جَلَت","عَلى الدولِ العُظمى على الدولةِ الوسطى",11,"ط",2,0],["وَأَسنى الأَذكياء نُهىً وَحلماً","وَأَصفى الأَغنياء تُقىً وَزُهدا",12,"د",2,0],["وإِسنادُ الأَسِنَّةِ نحوَ نَحري","وَهَزُّ المَشرَفِيَّةِ والوُقوعُ",13,"ع",1,0],["واسنِد إلى مريمٍ ما حزتَ من حكمٍ","فالفضل في غيرها في الناس لم يَقُم",14,"م",1,0],["وأَسِنَّةُ الخَطِّ الَّتِي خَطَّتْ عَلَى","شِيَعِ الضلالَةِ حَينَها المحتوما",15,"م",2,0],["واسنانه انقضت وفي ظهره انحنا","ومحمر ذاك الدم قد صار أصفرا",16,"ر",2,0],["وأسنشقُ الاْرواحَ مِن نحوِ أرضِه","ليذهبُ ما ألقاهُ مِن غلَّةِ الصدرِ",17,"ر",1,0],["وأسنانٌ تُفدّيها اللآلي","بأكبرِها وإن كانت صِغارا",18,"ر",2,0],["وأسند الدهر إليهم ظهره","فعز ظهر الدهر باستناده",19,"د",2,0],["وأسندت الأمور إلى عظيم","يكشف غمة الكرب العظام",20,"م",1,0],["وأَسْنَى المُنى ما نِيْلَ في مَيْعَةِ الصِّبَا","وهل تَحْسُنُ الأشياءُ بعد فَواتِها",21,"ت",3,0],["وأَسنَد أمرَ الناسِ بعد التباسِهِ","إِلى كل جَلدٍ مُبرمِ الأمرِ حازِم",22,"م",1,0],["وَأسنى فَتى طابَت سَجاياه واسمه","أَما نشره في العالمين له نفح",23,"ح",1,0],["وآس نساء حاسرات بكسوة","لترسو وتسمو بالسناء وساعد",24,"د",1,0],["وَأَسنَدتُ الرَجاءَ إِلَيكَ كَيما","أُحَدِّثَ في السَماحَةِ عَن غَطاءِ",25,"ا",2,0],["واسْنِدَت خيلي مطاليجِ","قبل طلع الشمس لافَنّه",26,"ن",2,0],["وأسنى مقاماتي وأزكى تصرفي","مع التوب تفويضي إليك بليتي",27,"ي",1,0],["وَأَسْنَدَ وَجْدِي مِنْ أَحَادِيثِ حُسْنِهَا","غَرائِبَ لَمْ تَخْطُرْ بِبَالِ وَلاَ فِكْرِ",28,"ر",1,0],["وأسنة ترد الدماء كأنها","حبب يجول على الشمول القرقف",29,"ف",1,0],["وأسند الأمر في التلقي","له تكن صاحبَ استناد",30,"د",1,0],["واسنَنْفِذِ المقدورَ في تعظيمهم","قَوْمٌ أَجَلَّهُمُ الكتابُ عِظَامُ",31,"م",1,0],["وأَسنانَ سَوءٍ شاخِصاتٍ كأَنَّها","سوامُ أُناسٍ سارحٌ قَد تَبَدّدا",32,"د",2,0],["وأُسنُدهُ عنِّي في ثلاثةِ أوجُهٍ","مُبّيِّنَةٍ للناسِ في النَّظمِ والنَّثرِ",33,"ر",1,0],["وَأَسنانُهُ أُنثى عَلى ذكرٍ أَتَت","لِكَسرِ العِظامِ الصُلبِ مِنها تفقّدُ",34,"د",1,0],["واسنى صلاة حان وقت ادائها","وتكبيرها كالعيد فيها مسبع",35,"ع",1,0],["واسنى العطايا والمواهب كلها","هو العلم ينميه وينمو به العقل",36,"ل",1,0],["وأسندتِ الشَّعرَ الرقابُ نحورُها","إلى حَرِّ ضربٍ صادقٍ وطِعانِ",37,"ن",1,0],["وَأَسِنَّةٍ أُثبِتنَ في لُدُنٍ","خُطِّيَّةٍ بِأَكُفِّهِم زُهرِ",38,"ر",1,0],["وأسنانٌ كريش البط","بين أصولها عفن",39,"ن",1,0],["وأسني الهبات وأُردي الكُماةِ","وأصفح عن زلَّةِ المجرمِ",40,"م",1,0],["وآسنٍ آجنٍ تعوي الذئابُ به","عُوجاً وتغني به الرُّقطُ الزهاليلُ",41,"ل",1,0],["واسندَهُ غضاً طرياً أئمةٌ","بشرقٍ وغربٍ نشرُ كلٍّ ميممُ",42,"م",1,0],["وأسناهُ ما بالغربِ طلعةُ شمسِهِ","وآسهُ في أرجائِهِ يتنسَّمُ",42,"م",1,0],["وأسنُّ تسْنيمَ القُبو","رِ لِكلُّ قبرٍ يُحْتَفَرْ",43,"ر",1,0],["وأسنمة يسيل السمن منها","توزع بين أفواه جياع",44,"ع",1,0],["وأسنده عن واقديّ أضالعي","فأضحى صحيحاً بالغرام مُعَلّلا",45,"ل",2,0],["واسنده عنكم لخير خليفة","غدا ثاني المهدي للخلق هاديا",46,"ي",2,0],["واسندتها لك ياجزاء باراعي الباس الشديد","لك هيبتٍ عند القبايل كلها يحكابها",47,"ب",3,0],["واسندت خيلي مطاليجي","في الهوى والموت يردنّه",48,"ن",2,0],["واسند على كوكب بالشعر يطلل طلول","سود الليال يتبدد منه ديجورها",49,"ر",3,0],["واسن بالسن ولاالعين بالعيني","ولا يقولون لازم تدرس الحاله",50,"ل",2,0],["واسندٓ الظهر ربوتي ذا قرار","امسي قد ضاع في الاسى يانسيُّ",51,"ي",1,0],["وأسند كلاما في السماع لأهله","وقيد حديثا في العيان بابان",52,"ن",1,0],["واسند برأسك هاهنا","وانس الذي قد أوجعَكْ",53,"ك",1,0],["واسنَّةٌ انصالها","قد كشّرتْ مثل السراحِ",54,"ح",1,0]]}