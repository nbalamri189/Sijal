{"poems":[[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[90,"لو أسكر الإنسان باطل أمره","https://www.aldiwan.net/poem45061.html","الطويل"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[87,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[68,"ما عشت لا زاركم إلا ثناي وإن","https://www.aldiwan.net/poem40956.html","البسيط"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[113,"إن مدح الملوك يقبح فضلا","https://www.aldiwan.net/poem16635.html","الخفيف"],[199,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[208,"ليت حظي من كل عيشي رضاكا","https://www.aldiwan.net/poem53209.html","الخفيف"],[563,"لو أن من يطلب مولاه","https://www.aldiwan.net/poem33668.html","السريع"],[2163,"","https://poetry.dctabudhabi.ae/diwan/poem/124034","الطويل"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200292","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60955","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66443","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36788","البسيط"],[4767,"رقية","https://www.poetsgate.com/ViewPoem.aspx?id=178825",""],[5183,"كأس الكمي","https://www.poetsgate.com/ViewPoem.aspx?id=180187",""],[5536,"أبناء السبيل!!","https://www.poetsgate.com/ViewPoem.aspx?id=22609",""]],"verses":[["لَو أَخلَصَ النيلُ وَالأُردُنُّ وُدَّهُما","تَصافَحَت مِنهُما الأَمواهُ وَالعُشُبُ",0,"ب",1,0],["لو أخلص الإنسان في إحسانه","لم يرجُ أن يجزي على الإحسان",1,"ن",1,0],["لو أخلص الرجل التقيّ بدنيه","ما كان ذا طمع بحور جنان",1,"ن",1,0],["لو أخلص الغزّى بنُصرة دينهم","ما حلّ سبي حرائر النسوان",1,"ن",1,0],["لو اختصمت أهل المكارم في الندى","لقال مقال الحقّ ملكي وفي يدي",2,"د",2,0],["لَو أُخِّرَت في العَيشِ بَعدَكَ ساعَةً","لَبَكَت عَلَيكَ بِمَدمَعِ الخَنساءِ",3,"ا",2,0],["لَوِ اِختَصَرتُم مِنَ الإِحسانِ زُرتُكُمُ","وَالعَذبُ يُهجَرُ لِلإِفراطِ في الحَضَرِ",4,"ر",1,0],["لو أخّرَتْهُ منيَّةٌ لتقدّمَتْ","في الجود همّتُهُ عَلى الأَجوادِ",5,"د",1,0],["لو اخْتَصَرْتم من الإحسانِ زُرْتُكمُ","والعَذْبُ يُهْجَرُ للإفراطِ في الخَصَرِ",6,"ر",1,0],["لَو أَخَذنا عزّ الخِلافة مِنهُم","لَم يُوازي مَزَلة الإِنشاء",7,"ا",2,0],["لَو أَخطَأَ المَوتُ شَيئاً أَو تَخَطَّأَهُ","لَأَخطَأَ الأَعصَمُ المُستَوعِلُ الصَدَعا",8,"ع",2,0],["لو أخذتَ المِرآةَ أبصرتَ وجهاً","شاهداً لي بأنَّ ذاك كذاكا",9,"ك",2,0],["لو أخلصوا في الله إخلاصهم","في غيره ناجاهم الله",10,"ه",1,0],["لو اختبروه منصفين وأمعَنوا","أبان لهم ما انكروا صادق الخبر",11,"ر",1,0],["لو اختصرتم من الإحسان زرتكُمُ","والطيِّبُ العذبُ في الأوراد كالخطر",12,"ر",1,0],["لو أخطلٌ جارَاه أو جرول","لقيلَ هذا يومَ لا ينطقون",13,"ن",1,0],["لَو أَخلص النصح الأسا","ة نَجا الضَنيُّ مِن العطب",14,"ب",1,0],["لو اختصرتم من الإحسان زرتكم","سعياً على الراس لا سعياً على البصر",15,"ر",1,0],["لَوِ اِختَصَرتُم مِنَ الإِحسانِ زُرتُكُم","وَالعَذبُ يُهجَرُ لِلإِفراط في الحَصَرِ",16,"ر",1,0],["لو اختفى بليلةٍ رأيتِ من","بنوره استضاء قد تشوقا",17,"ق",2,0],["لو أخذت الزمام تحت لواء ال","دهر حربا لرضت كل عنيف",18,"ف",1,0],["لو اخذوا من ظلوعهم نار وحطب ثم احرقوك","الخاسر النمرود والرابح براهيم الخليل",19,"ل",1,0]]}