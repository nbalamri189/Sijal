[303,"وجبة لها لون","https://www.aldiwan.net/poem56451.html","مجزوء الوافر"],[318,"الدهر باغ معتدي","https://www.aldiwan.net/poem61623.html","مجزوء الكامل"],[347,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[359,"أيها الاهيف الذي أهواه","https://www.aldiwan.net/poem68044.html","الخفيف"],[377,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[377,"كل يوم تزيد فيه شجوني","https://www.aldiwan.net/poem48831.html","الخفيف"],[388,"يا من له الخلق الحسن والخلق والعقل ومن","https://www.aldiwan.net/poem54485.html","عموديه"],[393,"يا جار طلحة هل ترد لبونهُ","https://www.aldiwan.net/poem613.html",""],[400,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[403,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[426,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[426,"رفقا بأسيرك يا أسما","https://www.aldiwan.net/poem41412.html","المتدارك"],[429,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[438,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[441,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[456,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[462,"قبح الله آب ما آب شهراً","https://www.aldiwan.net/poem3132.html","عموديه"],[462,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[462,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[466,"يا شريف الأغراس والأغراق","https://www.aldiwan.net/poem59811.html","الخفيف"],[475,"أراها عن الجزع تبغي عدولا","https://www.aldiwan.net/poem15225.html","المتقارب"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[493,"إن لله عبيدا في زوايا الأرض غبرا","https://www.aldiwan.net/poem9859.html","مجزوء الرمل"],[498,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[504,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[512,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[536,"كأس الخطوب بذا العدو دهاق","https://www.aldiwan.net/poem47536.html","عموديه"],[549,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[549,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[556,"قلوب متى منه خلت فنفوس","https://www.aldiwan.net/poem34450.html","الطويل"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[560,"وجبت زيارة تربة مبرورة","https://www.aldiwan.net/poem52588.html","الكامل"]],"verses":[["وَجُب غَيرَ مُستَكثِرٍ بِالصِحابِ","حَزناً يَغولُ المَطايا وَسَهلا",0,"ل",2,0],["وَجُبَّ بَينَ فُروجِ اللَيلِ أَسنِمَةً","ما اِستافَ أَخفافَها أَينٌ وَلا ضَجَرُ",1,"ر",1,0],["وَجَبانٍ لَوَيتَ عَنهُ فَأَمسى","وَجِلَ العَينِ مِن قِراعِ الرُقادِ",2,"د",1,0],["وَجِباهُ الصِّيدِ لاثِمَةٌ","ما تَمَسُّ الأَرْضُ مِنْ قَدَمي",3,"ي",1,0],["وجبَرْتَ بعْدَ الكَسْرِ قومَكَ جاهِداً","تُغْني العَديمَ وتطْلِقُ المَحْبوسا",4,"س",2,0],["وَجبَتْ غُرُّ الْمَزَايَا","مِنْ طِوَالٍ أَوْ عِرَاضِ",5,"ض",1,0],["وجِبالِ عِزٍّ لا تذِلُّ أُنوفُها","إلا لعِزِّ الواحِدِ القهّارِ",6,"ر",1,0],["وَجَبَيْتَ مَالَ اللهِ وَاسْتَخْلَصْتَهُ","مِنْ بَيْنَ ظُفْر لِلسِّيَاعِ وَنَابِ",7,"ب",1,0],["وجبين دجلة قد صفا متألّقاً ف","حكى السماء محاسناً وجمالا",8,"ل",2,0],["وَجُبنَ بِلادَ الرومِ سِتّينَ لَيلَةً","تُغاوِرُ مَلكَ الرومِ فيمَن تُغاوِرُ",9,"ر",1,0],["وَجِبريلٌ أَمينُ اللَهِ فينا","وَروحُ القُدسِ لَيسَ لَهُ كِفاءُ",10,"ا",2,0],["وجبين إذا ذكرتُ سناه","بتّ أبكي صبابةً للصباح",11,"ح",1,0],["وجَبَتْ جُنوبُ عِداكَ إنَّ جُنُوبَهُم","أولى الجنوبِ بوجبةِ المصروعِ",12,"ع",1,0],["وجُب البر واركب البحر واسلم","إن للبدر في السرى أوطارا",13,"ر",2,0],["وَجِبالاً مَوائِجاً في جِبالٍ","تَتَدَجّى كَأَنَّها الظَلماءُ",14,"ا",2,0],["وجبالُ أحلامٍ تَقِلْ","لُهُمُ الأسِرَّةُ والمَنابِر",15,"ر",1,0],["وَجَبينُ هَذا كَالشِهابِ جَلا الدُجى","عَنهُ وَهَذا كَالشِهابِ الموقَدِ",16,"د",1,0],["وَجَبْهَةُ الْجَوِّ غَمَامٌ حَافِلُ","وَبَيْنَ هَذَيْنِ نَسِيمٌ حَائِلُ",17,"ل",1,0],["وجَبَّ شتَى مقاييسٍ أخذتُ بها","مقياسُ صبرٍ على ضُرٍّ وتوطين",18,"ن",1,0],["وَجَبينٍ وَحاجِبٍ لَم يُصِبهُ","نَتفُ خَطٍّ كَأَنَّهُ خَطُّ نونِ",19,"ن",1,0],["وَجَبين مثل الجَريدة لَما","لَم تَجد كاتِباً عَفيفاً نزيها",20,"ي",3,0],["وَجَبَت عَلَيهِ كَسرَةٌ أَو رَميَةٌ","أَنفي بِها عَنّي الأَقَلَّ الأَخبَثا",21,"ث",2,0],["وَجَبَ السُّجُودُ لهُ فلما أنْ عصى","قالت خطيئَتُهُ لهُ اركعْ واسْجُدِ",22,"د",1,0],["وَجِبالُ فارانَ الرَّواسِي إنّها","نالت عَلَى الدُّنيا به التَّفضيلا",23,"ل",2,0],["وَجَبَتْ عليَّ لهُ حُقُوقٌ لَمْ","أَقُمْ منها بماضِيَةٍ ولا مُسْتَقْبِلَهْ",24,"ل",2,0],["وَجُبتُ سَرابِيّاً كَأَنَّ إِكامَهُ","جِوارٍ وَلَكِن ما لَهُنَّ نُهودُ",25,"د",1,0],["وَجِبِلَّةُ الناسِ الفَسادُ فَظَلَّ مَن","يَسمو بِحِكمَتِهِ إِلى تَهذيبِها",26,"ب",3,0],["وَجَبَبتَ في الجَري الخُيو","لَ وَكُنتَ مِن وَضحٍ مُجَبَّب",27,"ب",1,0],["وَجَبرٌ وَكَسرٌ لَهُ في الزَمانِ","وَيُكسَرُ يَوماً فَلا يَنجَبِر",28,"ر",1,0],["وَجَب الثناءُ لأسلميٍّ ماجدٍ","شَرفتْ به نَسباً وعزّتْ أَسلَمُ",29,"م",1,0],["وجبينُ صاحِبها العزيزِ وإنّهُ","نورٌ على إصباحها مُتقدِّمُ",30,"م",1,0],["وجبالٌ من الثلوج تدجى","رائعاتِ السفوح والأعرافِ",31,"ف",1,0],["وَجَبِينُ مُكَلل بِنُضَارٍ","وَمُحَيّاً ضَاحٍ أَسِيلُ الْخُدُودِ",32,"د",1,0],["وَجَبِيناً فِي الْعَيْنِ يَزْهُو نُوراً","وَلِسَاناً فِي السَّمْعِ يَقْطُرُ شَهْدا",33,"د",2,0],["وجبتُ البحر.. يدفعني شراعي","إلى المجهولِ.. في جُزرِ المُحالِ",34,"ل",1,0],["وجِبَالٌ تَسِيرُ في يَوْم حَشْرٍ","كلُّ فِنْدٍ تَراهُ يَتْبَعُ فِنْدا",35,"د",2,0],["وجِبْريلُ يَهْفُو فَوْقَه بجَنَاحِه","حَنَاناًن وفَيْضُ اللّهِ يَنْهَلُّ سَاكِبُه",36,"ب",2,0],["وجَبيناً علويّاً مُشْرِقاً","يبهَرُ العينَ ويمحو الظُّلمَا",37,"م",2,0],["وَجَبْهَة ُ الْجَوِّ غَمَامٌ حَافِلُ","وَ بينَ هذينِ نسيمٌ جائلُ",38,"ل",1,0],["وجبهناهم بطعنٍ كما تن","هز في جمة الطوي الدلاء",39,"ا",2,0],["وجباه الذرى مرايا تجلت","من ثريات مقلتيك شراره",40,"ر",2,0],["وَجِبالُ فارانَ الرَّواسِي إنها","حيناً وحيناً يُظهرونَ عويلا",41,"ل",2,0],["وجبينٌ كغُرّةً البدرَ فيه","أثرٌ للهمومِ مثلُ الكُسوف",42,"ف",1,0],["وجِبْرِيلُ يَهْفُو فَوْقَه بجَناحِه","حَنَاناً وفَيْضُ اللّهِ يَنْهَلُّ سَاكِبُه",43,"ب",2,0],["وجبال مَنْطَ جبال الأندلس التي","منها وفيهَ عبارة لم تحسما",44,"م",2,0],["وجبال أيلة هل بها","كلأ يسر الزائرين",45,"ن",1,0],["وجبهةُ تبدو بسابع عشر","والخراتان في ثلاثين ظهر",46,"ر",1,0],["وجبهةٌ تلفى عند سابعَ عشرةٍ","وعند الثلاثينَ الخراتانِ تظهرُ",47,"ر",1,0],["وجُبتُ ديارَ أورُبّا وفيها","شهدت عجيبَ عيد الكرنفالِ",48,"ل",1,0],["وجبتُ القِفارَ وطفتُ البلادَ","فلم أرَ حُرّا سِواهُ ولَنْ",49,"ن",1,0],["وجبتُ طريقاً ذا خطوبٍ طوارقٍ","فمِن حَرِجٍ ضنَكٍ ومن ضَرِسٍ صَعب",50,"ب",1,0],["وجبينٌ قد تَباهى أبلجاً","من سناهُ الكونُ ضوءاً يُكتسى",51,"س",2,0],["وجبّرة وغربالا إذا ما","رآه عدّوّه يوما يحن",52,"ن",1,0],["وجبت البلاد وأقطارها ال","فساح جميعا فخفت القرونا",53,"ن",2,0],["وَجبريلُ نعمَ العونُ وَالصاحب الّذي","زِياراتهُ بالوحيِ للمُصطفى تترى",54,"ر",2,0],["وَجبريلُ الأمينُ يقول حدّي","هُنا لا أستطيعُ القربَ أصلا",55,"ل",2,0],["وَجبَةُ ظَبيٍ ناعِمٍ مُختَزم","وَكِسَرٌ مِن خُبزِكَ المُحرّمِ",56,"م",1,0],["وجبين زاه وخدّ اسيل","وعيون نشوى وقد رشيق",57,"ق",1,0],["وجبينٍ زاهٍ وقدّ رشيقٍ","وعيونٍ نشوى وخدٍّ أسيلِ",58,"ل",1,0],["وجبهتها اقمارها بك اشرقت","وعنها اميطت في الخدور البراقع",59,"ع",1,0],["وجبهتها الغراء حالت كأنها","تغازلها لونا من الليل اسودا",60,"د",2,0],["وجبينك في الليل أضاء قلنا","هذى أنوار على العيون غاشيه",61,"ه",1,0],["وجبهتها الغراء سافرة غدت","تضىء بها الاقمار في حندس الشعر",62,"ر",1,0],["وجبينٌ به تُنِير نُجوم السْ","سَعدِ فينا ويَستضِيء الظَّلام",63,"م",1,0],["وَجُبتُ الأَرضَ تَلفُظُني المَرامي","وَتُنكِرُني السَباسِبُ والقِفارُ",64,"ر",1,0],["وَجُبْنَا إِلَى مَثْوَاكَ أَفْوَازَ مَهْمَهٍ","عَسَى بَحْرُكَ الزَّخَّارُ مِنْ فَيْضِهِ نُجْزَى",65,"ز",2,0],["وَجُبْتُ لَهُ الْبَيْدَاءَ وَهْيَ عَرِيضَةٌ","بِهَا الْقَلْبُ خَفَّاقٌ كَمَا خَفَقَ الآلُ",66,"ل",1,0],["وجبنت عن طعن العدى يوم","الوغى ويدى قصيره",67,"ر",2,0],["وجبت إليك البيدا قطعها سرى","وسير الدياجي حين يسود قطعها",68,"ع",3,0],["وَجبال منيفة شامخات","وَعيون معينة وَسيول",69,"ل",1,0],["وَجبْت مِن بَني الجَبارِ أودَى","عَلَى صُغْرٍ بِلَهْدَمِهِ الطّريرِ",70,"ر",1,0],["وَجبّة دَكناءُ فَضفاضَةٌ","وَطَيلَسانُ حَسن النيرِ",71,"ر",1,0],["وجب الثناء على جماعة جادو","إذ شيدوا بيت الإله وجادوا",72,"د",3,1],["وجبال وهل رمال","وهل ظباء بالرقمتين",73,"ن",1,0],["وَجبّةٍ لَها لون","يَروقُ العينَ إِشراقُه",74,"ه",1,1],["وَجَبَ البُكاءُ عَلى المَلا","فيهِ لَهُ كَم مِن يَدِ",75,"د",1,0],["وَجَبرُ كِسرى ضَمُّ فَتحٍ بِهِ","قابِلني في وُفقِها الحِبُّ",76,"ب",1,0],["وَجُبتُ بِالآفاقِ آفاقَ السَما","واتِ العُلى مُراجِعاً فيها النَظَر",77,"ر",1,0],["وَجَبين كَأَنَّهُ فَلق الصب","ح بَدا فَوقَ غُصن بان ضِياه",78,"ا",2,0],["وَجَبت شَفاعَتُهُ لِكُلِ مُوَحدٍ","وَأَنا عَلى التَوحيد بِالتَصميم",79,"م",1,0],["وَجَبين الصُبح الشَريق كَمينٌ","في حَشا اللَيل مودَع كَالجَنين",80,"ن",1,0],["وجب البلاد فأيها","أرضاك فاختر وطن",81,"ن",1,0],["وجَبا نُفيع يوم أورد أهله","فكأنها ظلت نصارى صُيِّما",82,"م",2,0],["وجُب الأقطار وانزل حيث لا","تشتهي وأنف عن العين الوسن",83,"ن",1,0],["وَجَبينه بَدر وَساحَة صَدرِهِ","بَرٌ وَأَنمُلُ راحَتَيهِ أَبحُرُ",84,"ر",1,0],["وجبين الأيام أشرق حسنا","وتردت ثوب الجمال العصورُ",85,"ر",1,0],["وجبين الصلط وطرته","نعمان الخد به نمّا",86,"م",2,0],["وجبينٌ كشارقِ الشمسِ يهْدي","بسناهُ من أتلفْتهُ الطريقُ",87,"ق",1,0],["وجبت الأرض مقفرة الزنازي","عفت من كل مغزلة وعين",88,"ن",1,0],["وجبال علت جبالا كأن ال","رأس منها في مطلع الدبران",89,"ن",1,0],["وجبينُ كلِّ متوَّجٍ","هو لا البخيلُ ولا الجبانُ",90,"ن",1,0],["وجبّ الصَّوم فيهِ شرعاً فصمنا","في جحيمٍ رجاءَ قرب الجحيم",91,"م",1,0],["وجبال الحجى خليقٌ بها التخ","ليد لو كانت الجبال تدوم",92,"م",1,0],["وجبالُ الحلم الرواسخ أن","أفظعَ خطبٌ يسفّهُ الأحلاما",93,"م",2,0],["وَجُبُنٌّ كَالإِحتِمالِ وَمِلحٌ","كَبَياضِ الحَنُوِّ وَالإِشفاقِ",94,"ق",1,0],["وجبتِ الظلامَ واهوالَهُ","متى أجتابتِ النُّجبُ فيه الشَّليلا",95,"ل",2,0],["وجبت قفارا مع ظباء لعلني","أرى طلعة أبهى من الشمس تلقاني",96,"ن",2,0],["وجبالاً دحيت أر","ضاً وبحراً عاد برا",97,"ر",2,0],["وجُبْتُ بيضَ دمشقٍ واتَّصلْتُ بها","وقد وقفْتُ بهاتيكَ المَحاريبِ",98,"ب",1,0],["وجبت إلى قدسه المرتضى","فخلصته من يد الكافر",99,"ر",1,0],["وجِبالُ حِلمٍ إن إليهِ نسَبْتَهم","فهمُ هِضابُ القدسِ حولَ حِراءِ",100,"ا",2,0],["وجَب الدهادُ بني بلادِي فانهَضُوا","أليومَ يعذُبُ للحِمَام مَذَاق",101,"ق",1,0],["وجَب الجِهَادُ بني بِلادي فَليكُن","مِنكم لِميدَانِ الجِهادِ سِبَاق",101,"ق",1,0],["وَجُبتَ أَعداءَها عَنها فَلو طلبتْ","لها عدوّاً طِوالَ الدّهرِ لم تَجِدِ",102,"د",1,0],["وَجبَّ اللَّهُ غارِبَكمْ فَكونوا","كَظالعةٍ تحيد عن المَراحِ",103,"ح",1,0],["وجبريل إن ينفخ بروح مسيحه","تبدت رهابين به وقسوس",104,"س",1,0],["وجبريل كانت في السموات صورة","له عظمت فوق السماكين والنسر",105,"ر",1,0],["وَجَبَتْ زيارةُ تُربةٍ مبرورةٍ","في طَيِّها شخصُ الكَرامةِ بائتُ",106,"ت",1,1]]}