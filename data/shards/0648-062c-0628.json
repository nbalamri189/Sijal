 النظم الأرق الأنفس","https://www.poetsgate.com/ViewPoem.aspx?id=156549",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5490,"حديث الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=176287",""],[5491,"أنت الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=197208",""],[5510,"رأيت الشيب","https://www.poetsgate.com/ViewPoem.aspx?id=206469",""],[5528,"هلْ مِنْ سُلُو ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201114",""],[5596,"مكة الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=206191",""],[5616,"شموخا أيتها المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=204845",""],[5626,"اتركْ هواها","https://www.poetsgate.com/ViewPoem.aspx?id=189468",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""],[5704,"طلع البدر علينا","https://www.poetsgate.com/ViewPoem.aspx?id=202941",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5845,"كلُّ شيءٍ منكمْ عليكمْ دليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=15454",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"طلع البدر عليكم وعلَينا","https://www.poetsgate.com/ViewPoem.aspx?id=192704",""],[5973,"احذري أن تحصي من المراق","https://www.poetsgate.com/ViewPoem.aspx?id=13682",""],[5974,"ابتسامة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=200334",""],[5975,"عيناكِ .. أم نجم الصباحِ !!","https://www.poetsgate.com/ViewPoem.aspx?id=53291",""],[6024,"مية","https://www.poetsgate.com/ViewPoem.aspx?id=186352",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6091,"دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=177535",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[6152,"ولدت مسافرا","https://www.poetsgate.com/ViewPoem.aspx?id=204435",""],[313,"أمل المحروم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66512&r=&rc=34",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""],[5190,"اعذريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78335&r=&rc=48",""]],"verses":[["وَجُب غَيرَ مُستَكثِرٍ بِالصِحابِ","حَزناً يَغولُ المَطايا وَسَهلا",0,"ل",2,0],["وَجُبَّ بَينَ فُروجِ اللَيلِ أَسنِمَةً","ما اِستافَ أَخفافَها أَينٌ وَلا ضَجَرُ",1,"ر",1,0],["وَجَبانٍ لَوَيتَ عَنهُ فَأَمسى","وَجِلَ العَينِ مِن قِراعِ الرُقادِ",2,"د",1,0],["وَجِباهُ الصِّيدِ لاثِمَةٌ","ما تَمَسُّ الأَرْضُ مِنْ قَدَمي",3,"م",2,0],["وجبَرْتَ بعْدَ الكَسْرِ قومَكَ جاهِداً","تُغْني العَديمَ وتطْلِقُ المَحْبوسا",4,"س",2,0],["وَجبَتْ غُرُّ الْمَزَايَا","مِنْ طِوَالٍ أَوْ عِرَاضِ",5,"ض",1,0],["وجِبالِ عِزٍّ لا تذِلُّ أُنوفُها","إلا لعِزِّ الواحِدِ القهّارِ",6,"ر",1,0],["وَجَبَيْتَ مَالَ اللهِ وَاسْتَخْلَصْتَهُ","مِنْ بَيْنَ ظُفْر لِلسِّيَاعِ وَنَابِ",7,"ب",1,0],["وجبين دجلة قد صفا متألّقاً ف","حكى السماء محاسناً وجمالا",8,"ل",2,0],["وَجُبنَ بِلادَ الرومِ سِتّينَ لَيلَةً","تُغاوِرُ مَلكَ الرومِ فيمَن تُغاوِرُ",9,"ر",1,0],["وَجِبريلٌ أَمينُ اللَهِ فينا","وَروحُ القُدسِ لَيسَ لَهُ كِفاءُ",10,"ا",2,0],["وجبين إذا ذكرتُ سناه","بتّ أبكي صبابةً للصباح",11,"ح",1,0],["وجَبَتْ جُنوبُ عِداكَ إنَّ جُنُوبَهُم","أولى الجنوبِ بوجبةِ المصروعِ",12,"ع",1,0],["وجُب البر واركب البحر واسلم","إن للبدر في السرى أوطارا",13,"ر",2,0],["وَجِبالاً مَوائِجاً في جِبالٍ","تَتَدَجّى كَأَنَّها الظَلماءُ",14,"ا",2,0],["وجبالُ أحلامٍ تَقِلْ","لُهُمُ الأسِرَّةُ والمَنابِر",15,"ر",1,0],["وَجَبينُ هَذا كَالشِهابِ جَلا الدُجى","عَنهُ وَهَذا كَالشِهابِ الموقَدِ",16,"د",1,0],["وَجَبْهَةُ الْجَوِّ غَمَامٌ حَافِلُ","وَبَيْنَ هَذَيْنِ نَسِيمٌ حَائِلُ",17,"ل",1,0],["وجَبَّ شتَى مقاييسٍ أخذتُ بها","مقياسُ صبرٍ على ضُرٍّ وتوطين",18,"ن",1,0],["وَجَبينٍ وَحاجِبٍ لَم يُصِبهُ","نَتفُ خَطٍّ كَأَنَّهُ خَطُّ نونِ",19,"ن",1,0],["وَجَبين مثل الجَريدة لَما","لَم تَجد كاتِباً عَفيفاً نزيها",20,"ي",3,0],["وَجَبَت عَلَيهِ كَسرَةٌ أَو رَميَةٌ","أَنفي بِها عَنّي الأَقَلَّ الأَخبَثا",21,"ث",2,0],["وَجَبَ السُّجُودُ لهُ فلما أنْ عصى","قالت خطيئَتُهُ لهُ اركعْ واسْجُدِ",22,"د",1,0],["وَجِبالُ فارانَ الرَّواسِي إنّها","نالت عَلَى الدُّنيا به التَّفضيلا",23,"ل",2,0],["وَجَبَتْ عليَّ لهُ حُقُوقٌ لَمْ","أَقُمْ منها بماضِيَةٍ ولا مُسْتَقْبِلَهْ",24,"ل",2,0],["وَجُبتُ سَرابِيّاً كَأَنَّ إِكامَهُ","جِوارٍ وَلَكِن ما لَهُنَّ نُهودُ",25,"د",1,0],["وَجِبِلَّةُ الناسِ الفَسادُ فَظَلَّ مَن","يَسمو بِحِكمَتِهِ إِلى تَهذيبِها",26,"ب",3,0],["وَجَبَبتَ في الجَري الخُيو","لَ وَكُنتَ مِن وَضحٍ مُجَبَّب",27,"ب",1,0],["وَجَبرٌ وَكَسرٌ لَهُ في الزَمانِ","وَيُكسَرُ يَوماً فَلا يَنجَبِر",28,"ر",1,0],["وَجَب الثناءُ لأسلميٍّ ماجدٍ","شَرفتْ به نَسباً وعزّتْ أَسلَمُ",29,"م",1,0],["وجبينُ صاحِبها العزيزِ وإنّهُ","نورٌ على إصباحها مُتقدِّمُ",30,"م",1,0],["وجبالٌ من الثلوج تدجى","رائعاتِ السفوح والأعرافِ",31,"ف",1,0],["وَجَبِينُ مُكَلل بِنُضَارٍ","وَمُحَيّاً ضَاحٍ أَسِيلُ الْخُدُودِ",32,"د",1,0],["وَجَبِيناً فِي الْعَيْنِ يَزْهُو نُوراً","وَلِسَاناً فِي السَّمْعِ يَقْطُرُ شَهْدا",33,"د",2,0],["وجبتُ البحر.. يدفعني شراعي","إلى المجهولِ.. في جُزرِ المُحالِ",34,"ل",1,0],["وجِبَالٌ تَسِيرُ في يَوْم حَشْرٍ","كلُّ فِنْدٍ تَراهُ يَتْبَعُ فِنْدا",35,"د",2,0],["وجِبْريلُ يَهْفُو فَوْقَه بجَنَاحِه","حَنَاناًن وفَيْضُ اللّهِ يَنْهَلُّ سَاكِبُه",36,"ب",2,0],["وجَبيناً علويّاً مُشْرِقاً","يبهَرُ العينَ ويمحو الظُّلمَا",37,"م",2,0],["وَجَبْهَة ُ الْجَوِّ غَمَامٌ حَافِلُ","وَ بينَ هذينِ نسيمٌ جائلُ",38,"ل",1,0],["وجبهناهم بطعنٍ كما تن","هز في جمة الطوي الدلاء",39,"ا",2,0],["وجبن القوى أن تعدّ القوى","لتستهدف الأعزل المجهدا",40,"د",2,0],["وجباه الذرى مرايا تجلت","من ثريات مقلتيك شراره",41,"ر",2,0],["وَجِبالُ فارانَ الرَّواسِي إنها","حيناً وحيناً يُظهرونَ عويلا",42,"ل",2,0],["وجبينٌ كغُرّةً البدرَ فيه","أثرٌ للهمومِ مثلُ الكُسوف",43,"ف",1,0],["وجِبْرِيلُ يَهْفُو فَوْقَه بجَناحِه","حَنَاناً وفَيْضُ اللّهِ يَنْهَلُّ سَاكِبُه",44,"ب",2,0],["وجبهت بالحقّ العنيف عدوّها","وعدوّها ثمل الضغائن أخرق",45,"ق",1,0],["وجبال مَنْطَ جبال الأندلس التي","منها وفيهَ عبارة لم تحسما",46,"م",2,0],["وجبال أيلة هل بها","كلأ يسر الزائرين",47,"ن",1,0],["وجبهةُ تبدو بسابع عشر","والخراتان في ثلاثين ظهر",48,"ر",1,0],["وجبهةٌ تلفى عند سابعَ عشرةٍ","وعند الثلاثينَ الخراتانِ تظهرُ",49,"ر",1,0],["وجُبتُ ديارَ أورُبّا وفيها","شهدت عجيبَ عيد الكرنفالِ",50,"ل",1,0],["وجبتُ القِفارَ وطفتُ البلادَ","فلم أرَ حُرّا سِواهُ ولَنْ",51,"ن",1,0],["وجبتُ طريقاً ذا خطوبٍ طوارقٍ","فمِن حَرِجٍ ضنَكٍ ومن ضَرِسٍ صَعب",52,"ب",1,0],["وجبينٌ قد تَباهى أبلجاً","من سناهُ الكونُ ضوءاً يُكتسى",53,"س",2,0],["وجبّرة وغربالا إذا ما","رآه عدّوّه يوما يحن",54,"ن",1,0],["وجبت البلاد وأقطارها ال","فساح جميعا فخفت القرونا",55,"ن",2,0],["وَجبريلُ نعمَ العونُ وَالصاحب الّذي","زِياراتهُ بالوحيِ للمُصطفى تترى",56,"ر",2,0],["وَجبريلُ الأمينُ يقول حدّي","هُنا لا أستطيعُ القربَ أصلا",57,"ل",2,0],["وَجبَةُ ظَبيٍ ناعِمٍ مُختَزم","وَكِسَرٌ مِن خُبزِكَ المُحرّمِ",58,"م",1,0],["وجبين زاه وخدّ اسيل","وعيون نشوى وقد رشيق",59,"ق",1,0],["وجبينٍ زاهٍ وقدّ رشيقٍ","وعيونٍ نشوى وخدٍّ أسيلِ",60,"ل",1,0],["وجبهتها اقمارها بك اشرقت","وعنها اميطت في الخدور البراقع",61,"ع",1,0],["وجبهتها الغراء حالت كأنها","تغازلها لونا من الليل اسودا",62,"د",2,0],["وجبينك في الليل أضاء قلنا","هذى أنوار على العيون غاشيه",63,"ه",1,0],["وجبهتها الغراء سافرة غدت","تضىء بها الاقمار في حندس الشعر",64,"ر",1,0],["وجبينٌ به تُنِير نُجوم السْ","سَعدِ فينا ويَستضِيء الظَّلام",65,"م",1,0],["وَجُبتُ الأَرضَ تَلفُظُني المَرامي","وَتُنكِرُني السَباسِبُ والقِفارُ",66,"ر",1,0],["وَجُبْنَا إِلَى مَثْوَاكَ أَفْوَازَ مَهْمَهٍ","عَسَى بَحْرُكَ الزَّخَّارُ مِنْ فَيْضِهِ نُجْزَى",67,"ز",2,0],["وَجُبْتُ لَهُ الْبَيْدَاءَ وَهْيَ عَرِيضَةٌ","بِهَا الْقَلْبُ خَفَّاقٌ كَمَا خَفَقَ الآلُ",68,"ل",1,0],["وجبنت عن طعن العدى يوم","الوغى ويدى قصيره",69,"ر",2,0],["وجبت إليك البيدا قطعها سرى","وسير الدياجي حين يسود قطعها",70,"ع",3,0],["وَجبال منيفة شامخات","وَعيون معينة وَسيول",71,"ل",1,0],["وَجبْت مِن بَني الجَبارِ أودَى","عَلَى صُغْرٍ بِلَهْدَمِهِ الطّريرِ",72,"ر",1,0],["وَجبّة دَكناءُ فَضفاضَةٌ","وَطَيلَسانُ حَسن النيرِ",73,"ر",1,0],["وجب الثناء على جماعة جادو","إذ شيدوا بيت الإله وجادوا",74,"د",3,1],["وجبال وهل رمال","وهل ظباء بالرقمتين",75,"ن",1,0],["وَجبّةٍ لَها لون","يَروقُ العينَ إِشراقُه",76,"ه",1,1],["وَجَبَ البُكاءُ عَلى المَلا","فيهِ لَهُ كَم مِن يَدِ",77,"د",1,0],["وَجَبرُ كِسرى ضَمُّ فَتحٍ بِهِ","قابِلني في وُفقِها الحِبُّ",78,"ب",1,0],["وَجُبتُ بِالآفاقِ آفاقَ السَما","واتِ العُلى مُراجِعاً فيها النَظَر",79,"ر",1,0],["وَجَبين كَأَنَّهُ فَلق الصب","ح بَدا فَوقَ غُصن بان ضِياه",80,"ا",2,0],["وَجَبت شَفاعَتُهُ لِكُلِ مُوَحدٍ","وَأَنا عَلى التَوحيد بِالتَصميم",81,"م",1,0],["وَجَبين الصُبح الشَريق كَمينٌ","في حَشا اللَيل مودَع كَالجَنين",82,"ن",1,0],["وجب البلاد فأيها","أرضاك فاختر وطن",83,"ن",1,0],["وجَبا نُفيع يوم أورد أهله","فكأنها ظلت نصارى صُيِّما",84,"م",2,0],["وجُب الأقطار وانزل حيث لا","تشتهي وأنف عن العين الوسن",85,"ن",1,0],["وَجَبينه بَدر وَساحَة صَدرِهِ","بَرٌ وَأَنمُلُ راحَتَيهِ أَبحُرُ",86,"ر",1,0],["وجبين الأيام أشرق حسنا","وتردت ثوب الجمال العصورُ",87,"ر",1,0],["وجبين الصلط وطرته","نعمان الخد به نمّا",88,"م",2,0],["وجبينٌ كشارقِ الشمسِ يهْدي","بسناهُ من أتلفْتهُ الطريقُ",89,"ق",1,0],["وجبت الأرض مقفرة الزنازي","عفت من كل مغزلة وعين",90,"ن",1,0],["وجبال علت جبالا كأن ال","رأس منها في مطلع الدبران",91,"ن",1,0],["وجبينُ كلِّ متوَّجٍ","هو لا البخيلُ ولا الجبانُ",92,"ن",1,0],["وجبّ الصَّوم فيهِ شرعاً فصمنا","في جحيمٍ رجاءَ قرب الجحيم",93,"م",1,0],["وجبال الحجى خليقٌ بها التخ","ليد لو كانت الجبال تدوم",94,"م",1,0],["وجبالُ الحلم الرواسخ أن","أفظعَ خطبٌ يسفّهُ الأحلاما",95,"م"