{"poems":[[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[55,"من معيد لي أيا","https://www.aldiwan.net/poem30672.html","مجزوء الرمل"],[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[53,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[68,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[52,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116991","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[331,"عجبا للذي نعى الناعيان","https://www.aldiwan.net/poem44240.html","الخفيف"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[406,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[591,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138179",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136093","الخفيف"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140223",""],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139317",""],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110326","الرمل"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102465","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132637","السريع"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130101","المجتث"],[3380,"","https://poetry.dctabudhabi.ae/diwan/poem/147238","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62943","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[5121,"كفن الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=37445",""],[6225,"انغلاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81727&r=&rc=438",""]],"verses":[["أَينَ رَبُّ السَديرِ وَالحيرَةِ البَي","ضاءِ أَم أَينَ صاحِبُ الإيوانِ",0,"ن",1,0],["أَينَ راقٍ لِغَرامي","وَطَبيبٌ لِشَكاتي",1,"ت",2,0],["أَينَ رِدجو وَأَينَ ما كانَ فيها","مِن مَغانٍ مَأهولَةٍ وَغَواني",2,"ن",2,0],["أين رأسٌ كأنه","مِنْ مَشَقِّ اسْتها خرَجْ",3,"ج",1,0],["أَينَ رومِيَّةُ ما قَيصَرُها","ما لَياليها المُرِنّاتُ الوَتَر",4,"ر",1,0],["أَينَ رَبَّ السَريرِ وَالحيرَةِ البَي","ضاءِ أَم أَينَ رَبُّ ذاتِ العِمادِ",5,"د",1,0],["أَينَ رَبَّ السَريرِ وَالجيزَةِ البَي","ضاءُ ذاتِ النَخيلِ وَالأَعتابِ",6,"ب",1,0],["أَينَ رَبُّ الآراءِ وَالرُتبَةِ العَل","ياءِ وَالماجِدُ الرَفيعُ الجَنابِ",6,"ب",1,0],["أين راحت لواعجي أين آلامي","اللواتي أهرمنني في الشباب",7,"ب",1,0],["أَينَ رَوحٌ عَنّي فَإِنَّ لِرَوحٍ","نَفَحاتٍ يَغنى بِها المُنتابُ",8,"ب",1,0],["أين راحَ اليومَ هل رام السَّلاما","أم على الشاطئِ أغفى ثم ناما",9,"م",2,0],["أينَ رواياتُكَ فيما مَضى","عن ابن عونٍ وابن سبرين",10,"ن",1,0],["أَيْنَ رَمْسِيسُ والكُمَاةُ حَوَالَيْهِ","مُشاةٌ في الموْكِب المشْهُودِ",11,"د",1,0],["أين رجال الله ما شأنكم","الى متى في ديننا نرضى الدنا",12,"ا",1,0],["أين رجال الله أين غارهم","قد هدم الحوض ودمت الركى",12,"ا",1,0],["أين ربيع الأرض أين غيثها","يا حربا لا غيثها ولا السدا",12,"ا",1,0],["أَينَ رَبُّ الزَوراءِ قَد قَلَّدَتهُ ال","مَلِكَ عِشرونَ حِجَّةً وَاِثنَتانِ",13,"ن",1,0],["أين راح النهار كيف أتى اللي","لُ وفيم الإشراقُ فيم السرار",14,"ر",1,0],["أين راياتُ خالدٍ والمثنَّى","أينَ إشراقةُ الصَّباحِ العراقي؟",15,"ق",2,0],["أين رؤوسُ القومِ من أخامصٍ","في مَفخرٍ أمْ أين وَهْدٌ من قُنَنْ",16,"ن",1,0],["أَيْنَ راحُ الوِصالِ بَلْ أَيْنَ كانَ ال","هَجْرُ بَلْ كَيْفَ لِلدنوِّ سَبيلُ",17,"ل",1,0],["أين روضي أين ما كان به","من ينابيع الأماني أين نهري",18,"ر",2,0],["أين راوي حديث ليلى فاني","مخبر عن حقيقة الأنباء",19,"ا",2,0],["أين ريعان الصبا لما أتى","رائع الشيب ينادي بالبدار",20,"ر",1,0],["اين رشدي ماذا جرى ما احتيالي","لكنهُ بين المخافة والرجا",21,"ج",2,0],["اين رشدي يا اخا الارشاد اين","ماذا أرى بيروس عدتَ فكيف قد",21,"د",1,0],["أينَ رَبُّ الأقلامِ يوم نِداءٍ","كَعوالي الرِّماحِ يَومَ الطِّعانِ",22,"ن",1,0],["أينَ رَبُّ الحِصنِ الحَصينِ بسُور","اء ورَبُّ القصر المُنيفِ المشيد",23,"د",1,0],["أين رب الغدن الراسي على","صدر بيت الدين ضواً للسدير",24,"ر",1,0],["أينَ روحي أينَ بدني","أينَ نفسي وهوها",25,"ا",1,0],["أين ربيع الناس ان صوحت","نبتاً وأين الجبل الراسي",26,"س",2,0],["أَئِن رَضينا مليكاً","قالوا طغى في الفسادِ",27,"د",1,0],["أين روقا عبد شمسٍ أين هم","أين أهل الباع منهم والحسبْ",28,"ب",1,1],["أَين ربُّ الملوكِ خُرَّةَ فيرو","زَ وأين اصطِباحُه والغَبوقُ",29,"ق",1,0],["أينَ ربْعُ الحِمى سَقى فيه عَهْداً","قد ألِفْناهُ كُل عهْدٍ باجِسْ",30,"س",1,0],["أين ربح الذي يرى القار مسكاً","يقتنى أو يرى النحاس نضارا",31,"ر",2,0],["أَيْنَ رُوحِي هَفْهِفِي بَرْدًا وَصُبِّي","كُلَّ مَائِي وَارْتِوَائِي مِلْءَ كَوْنِي",32,"ن",2,0],["أين ريحُ الحُبِّ ؟.. رَيْحا","نُ الصبا أمسَى حطاما",33,"م",2,0]]}