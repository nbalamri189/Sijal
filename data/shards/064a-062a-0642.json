,[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""],[5358,"ذهب الدهرُ بنا","https://www.poetsgate.com/ViewPoem.aspx?id=21475",""],[5376,"يتقاطرُ الشعراءُ عندَ ضيافة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193741",""],[5431,"تغريبة الحضارة العربية ...","https://www.poetsgate.com/ViewPoem.aspx?id=212197",""],[5490,"وللحديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=176364",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5866,"مدح القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=182810",""],[5897,"يا عيد .. ماذا عن غزة ؟","https://www.poetsgate.com/ViewPoem.aspx?id=174865",""],[5956,"الساقطون همْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181858",""],[5956,"غرِّدْ أيا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200909",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["يَتَقيني بِالخِلابِ وَإِن","جَدَحوا عِرضي لَهُ شَرِبَه",0,"ب",2,0],["يَتَّقي الأَرضَ بِدَفٍّ شاسِفٍ","وَضُلوعٍ تَحتَ صُلبٍ قَد نَحَل",1,"ل",1,0],["يتقنصن لي جآذر كالدَّوِّ","يُباغمن من وراء الحِجابِ",2,"ب",1,1],["يتقي جانب التقيّ وتخشى الإن","سُ والجن من سليمان حدا",3,"د",2,0],["يتقاضى صديقَهُ مثل ما يب","ذل من ذات نفسه بالسواءِ",4,"ا",2,0],["يتَّقي نظرة المُدلِّ بجدوا","هُ ويَعْتَدُّها من التثريبِ",5,"ب",1,0],["يتقي الخُلْفَ في العِداتِ ولكن","يتوخَّى الإِخْلاف في إيعادِهْ",6,"د",2,0],["يتقارعونَ الموت عن مُسكٍ","ومع القِراعِ إفاتةُ المُسك",7,"ك",1,0],["يتقاضوْن في الغُلول نضالاً","من ديونِ السلاح بعد نضالِ",8,"ل",1,0],["يتقصاه مُغْرقَ النَّزْعِ فيه","كتقصِّي الطبيب سبْرَ الأميم",9,"م",1,0],["يتَّقي جودُهُ صُلولَ القناطي","رِ كما يُتَّقَى صُلولُ اللِّحام",10,"م",1,0],["يتقي ألسنَ السؤال بعرضٍ","وافرٍ مُكرَمٍ ومالٍ مُهان",11,"ن",1,0],["يتقاذفون وللكنائس هِزة","ويسوع ينظرو الزكية تسمع",12,"ع",1,0],["يَتَقاذَفونَ بِذاتِ هَولٍ لَم تَهَب","حَرَمَ المَسيحِ وَلا حِمى العَذراءِ",13,"ا",2,0],["يَتَقَبَّلُ الوادي الحَياةَ كَريمَةً","مِن راحَتَيكَ عَميمَةً تَتَدَفَّقُ",14,"ق",1,0],["يَتَقَيَّلونَ ظِلالَ كُلِّ مُطَهَّمٍ","أَجَلِ الظَليمِ وَرِبقَةِ السَرحانِ",15,"ن",1,0],["يَتَقَرّى الغادي رَباعَ سَماحٍ","مِن نَصيبينِهِ إِلى بَرقَعيدِه",16,"د",2,0],["يَتَقَصّى ضَمانُهُ دَرَكَ الخَط","بِ وَيُعدي عَلى الزَمانِ جِوارُه",17,"ر",2,0],["يَتَقَيَّلُ المُعتَزُّ فَضلَ جُدودِهِ","بِخِلالِ مَحمودِ الخِلالِ مُوَفَّقِ",18,"ق",1,0],["يَتَّقي الهَولَ مِنهُ طَوراً وَطَوراً","جودُهُ سَعدٌ لِكُلِّ شَقِيِّ",19,"ي",1,0],["يتّقي حدّ سيفه كلّ علج","بحبيكِ الماذيّ في الآذيِّ",20,"ي",1,0],["يتّقي فيضَ النّدى مَنْ كَفّهُ","عيل منه لدغ دهر يَنتَهب",21,"ب",1,0],["يَتقدَّمونَ مُغامرينَ أَعِزَّةً","والنّارُ سَيْلٌ والرَّصاصُ رُكامُ",22,"م",1,0],["يَتَقارَعونَ عَلى الشَهادَةِ أَيُّهُم","يُمسي لِطَهَ في الجِنانِ نَزيلا",23,"ل",2,0],["يَتقلَّبُ الآباءُ في حَسَرَاتِهم","وكأنّما الأبناءُ ليسوا مِنْهُمُ",24,"م",1,0],["يَتَقَرَّبُ المَجدُ البَعي","دُ بِحَيثُ يَغضَبُ مَن يُفاخِر",25,"ر",1,0],["يَتَّقِي حُرُّ وجْهِي الحَرَّ والبَرْ","دَ وَقَدْ عَزَّ مِنْ لَظى الاتِّقاءُ",26,"ا",2,0],["يَتَّقي المَوتَ بِهِ أَشياعُهُ","حينَ جَفَّ الريحُ وَاِنشَقَّ البَصَر",27,"ر",1,0],["يَتَقاطَعونَ وَفي القَطيعَةِ راحَةٌ","مِن بُؤسِ عَيشٍ بِالأَذاةِ مُوَصَّلِ",28,"ل",1,0],["يَتَقَرَّوْنَ جَوْزَ كُلِّ فَلاةٍ","جُنْحَ لَيْلٍ جَوْزَاؤُه من رِكابِي",29,"ب",2,0],["يَتَّقِي الحَادِثَاتِ مِنْ قَبْلِ أَنْ تَحْ","دُثَ وَالظَّنُّ بَعْضُهُ إِلْهَامُ",30,"م",1,0],["يَتَقَاسَمُ الأَفْرَاحَ فِيهِ","الشَّرْقُ مِنْ قَاصٍ وَدَانِ",31,"ن",1,0],["يَتَقَاصَرُ الأَنْدَادُ عَنْكَ وَمَا بِهِم","مِنْ سَابِقٍ إِلاَّ غَدَا مَسْبُوقَا",32,"ق",2,0],["يَتَقَيَّلُ العَبّاسَ عَمَّ مُحَمَّدٍ","وَوَصِيَّهُ فيما يَقولُ وَيَفعَلُ",33,"ل",1,0],["يتقَرّى في الشعر مَيل الجم","اهيرِ ليحظَى بصيحةِ استحسان",34,"ن",1,0],["يتقاتلون على بقايا تمرة","فخناجر مرفوعة وحراب",35,"ب",1,0],["يتقامَرون على المنايا بينَهم","حُمْراً ، فلا الأيسارُ والأزلام",36,"م",1,0],["يَتَقَيّلُ المُعتَزُّ فَضْلَ جُدودِهِ،","بخِلالِ مَحمودِ الخِلالِ، مُرَفَّقِ",37,"ق",1,0],["يَتَقضَى ضَمَانُهُ دَرَكَ الخَطْ","بِ وَبُعدِي على الزّمانِ جِوارُهْ",38,"ر",2,0],["يَتَقَبّلُ العَبّاسُ عَمَّ مُحَمَّدٍ،","وَوَصِيَّهُ، فِيمَا يَقُولُ وَيَفْعَلُ",39,"ل",1,0],["يتقّي حدّ سيفه كلّ علج","يجيبكِ الماذيّ في الآذيّ",40,"ي",1,0],["يتَّقي نفحة َ اللسانِ ويغشى","كلَّ طعن وكلَّ ضرب طِلَخفِ",41,"ف",1,0],["يَتَّقي اللَهَ في السَري","رَةِ تَقواهُ في العَلَن",42,"ن",1,0],["يَتَّقي اللَه وَهَل يَظفَرُ بِال","أمنِ من حَرّ لَظىً غَيرُ التَقِيِّ",43,"ي",1,0],["يَتقضّى أَدواءها منه عدلٌ","بَرزخٌ بينَ صولة وليانِ",44,"ن",1,0],["يَتَقَتَّلنَ لِلحَليمِ مِنَ القَو","مِ فَيَسبِينَهُ بِحُسنِ الدَلالِ",45,"ل",1,0],["يتقاسمون الذلّ لقمة سائل","عجزت طبيعته عن الإعطاء",46,"ا",2,0],["يتّقى حين يطمئن وقد ين","تجعُ الغيثَ في سراب الفلاة",47,"ه",1,0],["يتقاتل الجيشان هذا فائزٌ","في كل معركة وذاك مهانُ",48,"ن",1,1],["يَتَقارَضْنَ بِها حَتّى اِستَوَت","أَشهُرَ الصَيفِ بِسَافٍ مُنفَجِرْ",49,"ر",1,0],["يتقلّبون على مفارش نسكهم","حرّاً ونيران البلا تتوقّد",50,"د",1,0],["يتقي الهل يخشاه بسر وإعلان","جانب الخلق من إنس وجن وشيطان",51,"ن",1,0],["يتقارب كلٌّ منا في داخله كالأجَمِ الفارغ","فإذا مال تنحنح",52,"ح",1,0],["يتقاضى النّديمَ محتبِسَ الكأ","سِ ويشدو عليه قبلَ التقاضي",53,"ض",2,0],["يتقارعون على الضيوفِ إذا الدجى","سُدَّتْ مطالعُه بريحٍ صَرْصَر",54,"ر",1,0],["يُتَّقى هاجِسهُ في سُخْطهِ","ويُرى الموتَ صريحاً اِنْ أشارا",55,"ر",2,0],["يتقصَّفُ العاديُّ عند مرورهِ","فَرَقاً وترْجُفُ تحتهُ الصَّحراء",56,"ا",2,0],["يتقرّبُ الجاني إليه لعَفْوهِ ال","مأمولِ عند السُخْطِ في زلّاتهِ",57,"ت",2,0],["يَتَقلَّبُ الثَكْلانُ في أحزانِهِ","كَتَقلُّبِ الجَذْلانِ في أفراحِهِ",58,"ح",2,0],["يَتَّقي العينَ أن تَراهُ وَ يَخشَى","عينَهُ كلُّ فارسٍ تحتَ لامهْ",59,"م",2,0],["يَتَقَهْقَرُ الجَيْشُ اللهامُ مَخَافَةً","مِنْهُ إِذَا وَافَى أَمامَ جُنُودِهِ",60,"د",2,0],["يَتَّقي اللَهَ في الأُمورِ وَقَد أَف","لَحَ مَن كانَ هَمَّهُ الإِتِّقاءُ",61,"ا",2,0],["يَتَّقي أَهلُها النُفوسَ عَلَيها","فَعَلى نَحرِها الرُقى وَالتَميمُ",62,"م",1,0],["يَتَّقي الذَمَّ بِالفَعالِ وَيَبني","مَجدَ مَن قَد تَضَمَّنَتهُ القُبورُ",63,"ر",1,0],["يَتقرّبون إِلى الإِله بحبّهِ","لتحطّ فيه عنهم الأوزارُ",64,"ر",1,0],["يتَقيَّلانِ مِن الوَصيِّ وأحمِد","شَرفاً يَقِلُّ الحمدُ في آحادِه",65,"د",2,0],["يتقاتلون على حطيم زائل","ولربما قتل الخدين خدين",66,"ن",1,0],["يتقرّى شثّاً ويألفُ طبا","قاً ويقرو ضالاً ويرعى مراخا",67,"خ",2,0],["يتقرَّى المرتَ المروراةَ ورّا","داً على الظِّمءِ وِرْدَها النشاشا",68,"ش",2,0],["يَتقي مسّه وان مَسّ يَوما","أَمّ فيه المطهرون بحارا",69,"ر",2,0],["يَتَقَضَّى بِالتَّلاقِي حُزنُهُ","مَع غَزالٍ كَلَّمَتنِي عَينُهُ",70,"ه",1,0],["يتقاسمن بالأيو","رِ كما تُقسَمُ التُحَف",71,"ف",1,0],["يتَقَابلونَ بأوجُهٍ مقبولةٍ","وَضمائِرٍ شُحِنتْ من الشَّحناءِ",72,"ا",2,0],["يتقاتلون ديانة وجهالة","ومريدُ هذا القتل أكبرُ مُلحِد",73,"د",1,0],["يتقى البردَ في الشتاءِ فيبقى","بين دفءٍ ومطعَمٍ في أمانِ",74,"ن",1,0],["يتقدَّمُ الإِنذارُ وَعْدَ مَغارِه","لا عن تَرَقُّبِ غِرَّةٍ وخِداعِ",75,"ع",1,0],["يَتَقي بِهِ نَفيانَ كُلِّ عَشِيَّةٍ","فَالماءُ فَوقَ مُتونِهِ يَتَصَبَّبُ",76,"ب",1,0],["يَتَّقي اللَهَ مِثلَ ما يَتَّقي الذَم","م وَيُمسي وَالحَمدُ جُلُّ اغتِنامِه",77,"م",2,0],["يَتَقَلَّدُ العَضبَ الحُسامَ وَتَحتَهُ","قَلبٌ أَحَدُّ مِنَ الحُسامِ وَأَقطَعُ",78,"ع",1,0],["يتقاسمون الشجو غاد","بالعزا ومهجر",79,"ر",1,0],["يتقحم الأهوال محتقراً لها","ومن الذي لغمارها يتقحم",80,"م",1,0],["يتقيل الملهوف تحت ظلاله","ويخيم المعروف بين خيامه",81,"م",2,0],["يتقدَّسُ الرَّحمنُ جَلَّ جَلاَلُهُ","عَنهَا وَعَن أعضَاءِ ذِي جُثمَانِ",82,"ن",1,0],["يتقاتَلونَ بِهمَّةٍ مشهودةٍ","يَتبادلونَ نوائِباً بِشِدادِ",83,"د",1,0],["يَتِّقِ اللهُ في الأمور وتخشاه","ويُخشى إذا مشى في الحديد",84,"د",1,0],["يتقلد المعروف منه معاطفاً","فتخاله فوق النجاد نجادا",85,"د",2,0],["يتقلب فيه على شوكٍ","للشوق أقض مضاجعه",86,"ع",2,0],["يتقاسمون من البلاد عراصها","والقاطنين كأنهم أنعام",87,"م",1,0],["يتقاضى المدير في الشهر ألفا","وهو نزر بحق ذاك المدير",88,"ر",1,1],["يتقاضونها على الرغم مما","هو فيه من بؤس عيش عسير",88,"ر",1,0],["يتقلبون بنعمة","فوق النمارق في حبور",89,"ر",1,0],["يتقلبون على الوسادِ كأنما","فُرشت مضاجِعُهم بشوكِ قتادِ",90,"د",1,0],["يتقلبون عَلى بساطٍ همومها","كتقلب الأمواج ضمن بحارِ",91,"ر",1,0],["يتقرَّب الدهقان فيه ببنته","فيزقُّها في كأسها حمراء",92,"ا",2,0],["يتقشع الإظلام إذ يبدو له","وجه كمثل الكوكب الوهاجِ",93,"ج",1,0],["يتقي افشاء ما يعطيه من","حيث لا تشعر باليمني الشمال",94,"ل",1,0],["يَتَقطَرن أَنجُماً في أَكاليل","مِن الزَهر أَسرَجت أَوراقَه",95,"ق",2,0],["يتقّي الناس فحشه وأذاه","مثلما يتّقون بول الحمار",96,"ر",1,0],["يتقشع الياقوت في لياتها","بوساوس تشفي من الوسواس",97,"س",1,0],["يتقي منك اتقاء","وهو يوليك الجميلا",98,"ل",2,0],["يَتَقاسَمُونَ بحارَهُ وسَحابَهُ","ويُعَيِّرُونَ تُرابَهُ لِشُحُوبهِ!",99,"ب",2,0],["يتقاتلون على الفتات وكسرة","فغدو الأسارى بل هم الغرباء",100,"ا",2,0],["يتقيل الحرباء في ألوانها","ويمد مثل لسانها الممدود",101,"د",1,0],["يتقوى بصرامته","من على الأيام ينتصر",102,"ر",1,0],["يتقاضاك غريماً دينه","أنت لكن دينه كالغاصب",103,"ب",1,0],["يتقاضى الهناء صاعاً فصاعا","وعلى العكس آخر كالنهيب",104,"ب",1,0],["يتقي الدنيا على دمه","ويخاف الدهر في محنه",105,"ن",2,0],["يتّقي الحرَّ بظِلّي جالساً","فبماذا أتقي حرَّ الهَجِيرْ ؟",106,"ر",1,0],["يتقاطرُ الشعراءُ عندَ ضيافة ٍ","للشاعراتِ فكلهنَّ عروسُ",107,"س",1,1],["يتقاتلون على الحصاد مذاهبا","سنت على الأطماع حين تؤلف",108,"ف",1,0],["يَتقيّلُ التاريخُ في أفيائهِ","ويُقيمُ ما مرّتْ عليهِ قرونُ",109,"ن",1,0],["يَتَّقِي اللَّهَ فِي الرَّعِيَّةِ يَخْشَى","مَوْقِفًا فِيهِ يُنْصَبُ الْمِيزَانُ!",110,"ن",1,0],["يتقاضاها حنين وبكا","أي حال يا ترى تشكو وأي",111,"ي",1,0],["يتقدم اصفوفنا شيخاً وقاره يزيد","اللي توشّح وشّاح الطيب وتقلده",112,"د",2,0],["يتقاسمان شهادة زرعت","للنصر من أنوارها حقلا",113,"ل",2,0],["‏ ‏يتقربون لها بوجه باسمٍ","‏ ‏ ومشاعرٍ ملغومةٍ بالحيلة ِ",114,"ه",1,0],["يتقوقعون بشوقهم دون اللقا","وجميعنا نقضي الحياة تقوقعا",115,"ع",2,0],["يتقاضاكم الأخوة في الإحساس","...والجراح والنضال المجيد",116,"د",1,0]]}