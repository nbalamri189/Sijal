wPoem.aspx?id=191469",""],[5431,"مشاعر معلبة!","https://www.poetsgate.com/ViewPoem.aspx?id=207402",""],[5458,"وداعاً يا رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=72282",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5612,"حلم العمر","https://www.poetsgate.com/ViewPoem.aspx?id=198379",""],[5628,"قصيدة حب للأطفال","https://www.poetsgate.com/ViewPoem.aspx?id=178755",""],[5677,"ميثاق غلا ...!","https://www.poetsgate.com/ViewPoem.aspx?id=179806",""],[5732,"نبيك يامن سلت عن بعض الاحوال","https://www.poetsgate.com/ViewPoem.aspx?id=177875",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[402,"لك في ارتجال جلائل الهمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54014&r=&rc=866",""]],"verses":[["إِجْعَلْ ثِقَاتِكَ حَكَماً","وَابْسِطْ مَجَال البّتِّ لِلْحَكَمِ",0,"م",1,0],["أَجُعادُ إِنّي لا يَزالُ يَنوبُني","هَمٌّ يُرَوَّحُ مَوهِناً وَبُكورا",1,"ر",2,0],["اِجعَلوا مَعقِلَها أَيمانَكُم","بِالصَفيحِ المُصطَفى غَيرِ الفُطُر",2,"ر",1,0],["أجَعْفَرُ حُزتَ جميعَ العُيُوبِ","فما فيكَ من خَلَّةٍ تُمْدَحُ",3,"ح",1,1],["اجعْل لعبدك رفداً","فمزْحُ رفْدك جِدُّ",4,"د",1,0],["اجعلوا الصبر لهم حيلتكم","قَلَّت الحيلة في قال وقيل",5,"ل",1,0],["إجعل العام رضا الإسلام أو","بلغ الإِسلام فيه مأربا",6,"ب",2,0],["اِجعَل رِثاءَكَ لِلرِجالِ جَزاءَ","وَاِبعَثهُ لِلوَطَنِ الحَزينِ عَزاءَ",7,"ا",2,1],["اِجعَلوها رُسلَكُم أَهلَ الهَوى","تَحمِلُ الأَشواقَ عَنكُم وَالغَراما",8,"م",2,0],["أَجعَلُكَ الفَذَّ مِن قِداحِهِمِ","إِذا أُجيلَت وَإِن هُمُ غَضِبوا",9,"ب",3,0],["أَجَعَلتَ الجَزاءَ لي مِن مَديحي","كَ اِطِّراحاً وَغَفلَةً ماتُقَضّى",10,"ض",2,0],["أَجَعلانَ الرَغامِ بَني كُلَيبٍ","شِرارَ الناسِ أَحساباً وَدارا",11,"ر",2,0],["أَجَعدِيٌّ أَسَكُّ مِنَ المَخازي","أَمِ العَجلانُ زائِدَةُ الرِئالِ",12,"ل",1,0],["إجعل جليسك دفترا في نشره","للميت من حكم العلوم نثور",13,"ر",1,1],["اِجعَل مُعَرَّجَكَ التَكَرُّ","مَ ما وَجَدتَ لَهُ انعِراجا",14,"ج",2,0],["إجعليه ذكرى له واجمعي الآرا","ء فيه واستكتبي الأصحابا",15,"ب",2,0],["إِجعَل لِعَيني في الكَرى حَظّاً","وَلا تَكُن لي مالِكاً فَظّا",16,"ظ",2,1],["اِجعَلي في الكَرى لِعَيني نَصيبا","كَي تَنالَ المَكروهَ وَالمَحبوبا",17,"ب",2,1],["اجعلي دُنياكِ في رنّاتهِ","تارةً عُرساً وآناً مأتما",18,"م",2,0],["اجْعَلْ لِباسَكَ من طَرائفِ صُنعِها","نِعمَ اللّباسُ وبُورِكَ السِّربالُ",19,"ل",1,0],["أجعلتموهم للحفاظِ جُنودَكم","وزعمتموهم إخوةً ورفاقا",20,"ق",2,0],["اجعَل سَبيلَكَ أَن تَعِفَّ عَنِ الأَذى","وَخُذِ التَرَفُّقَ وَالآناةَ شِعارا",21,"ر",2,0],["اجعلِ الخيرَ قريناً إن أبى","كلُّ غاوٍ إنّه نِعمَ القرين",22,"ن",1,0],["أَجعَلُ الحُبَّ بَينَ حِبيّ وَبَيني","قاضِياً إِنَّني بِهِ اليَومَ راضِ",23,"ض",1,1],["أَجَعفَرُ إِنَّ الحَمدَ يَبقىلِأَهلِهِ","جَمالاً وَلا تَبقى الكُنوزُ عَلى الكَدِّ",24,"د",1,0],["إِجعَل تُقاكَ الهاءَ تَعرِف هَمسَها","وَالراءَ كَرَّرَها الزَمانَ مُكَرِّرُ",25,"ر",1,1],["اجعل قصارك في أن","تعيش عيشاً رغيدا",26,"د",2,1],["أجعل لنا من كل ضيق مخرجا","والطف بنا يا من إليه الملتحي",27,"ي",1,0],["اجعل زكاة سديرك المعمور","اصلاح بيتي فهو أي فقير",28,"ر",1,1],["اجعل شعارك سوء الظن تنح به","من كان مستيقظا قلت مصائبه",29,"ب",2,0],["اجعل فؤادي دواةً والمدادَ دمي","وهاك فابرِ عظامي موضعَ القَلَمِ",30,"م",1,1],["إجعل خفايا السماء","مما يرى قلبي",31,"ي",1,0],["اِجعلْ يديك على قلبي فقد ضَعُفَتْ","قُوَاه عن حَملِ ما فيه وأضلُعه",32,"ع",2,0],["أجعلتم سَقْيَ الحجيج كمن آ","من بالله مؤمِناً لا يداري",33,"ر",2,0],["اِجْعَلْ خُطَانَا خُطَى مَنْ قَالَ مَطْلَبُهُ","لَهُ هَنِيئاً مَرِيئاً قَوْلَةَ الْوَمَقِ",34,"ق",1,0],["أَجعَلُ المالَ لِعِرضي جُنَّةً","إِنَّ خَيرَ المالِ ما أَدّى الذِّمَم",35,"م",1,0],["أجعَلُهُ فِيهِ طَعَامَ النَّسرِ","أَو لاَ فَرَبِّي عَاذِرِي بِغُذرِي",36,"ر",2,0],["إجعلْ إلَهك (إلوهيم) واقتسِموا","أدوار شرٍّ به الشرقُ سيلتهِبُ",37,"ب",1,0],["إجعليهِ إن تَبَدَّى","لِذَوي الإثراءِ قالوا",38,"ل",3,0],["إجعلي منه حليفاً","لسُهادٍ في اللَّيالي",38,"ي",1,0],["اجعل طعامك من غير الحرام على","مقدار علمك واترك ما به الباس",39,"س",1,0],["أجعله ما عشت لي وزيرا","وبعد موتي فيكم أميرا",40,"ر",2,0],["اجعل مكانك في الجوانح واتخذ","سبلاً على الأبصار والوجنات",41,"ت",1,0],["اِجعِل عِدانا هالِكهْ","بِسَهمِ قَهركَ المُصيب",42,"ب",1,0],["اِجعَلهُ يا ذا الفَضلِ","عَلى عِداهُ ظاهِرا",43,"ر",2,0],["أجعفر هل كان التهدد عنوة","لنعماى لما أن مننت صداق",44,"ق",1,0],["أَجْعَلُ حَجِّي حُجَّةً عَلَّني","أَراكمُ بَيْنَ الصَّفَا والحجُونْ",45,"ن",1,0],["أَجَعَلتَ عِرسَكَ شَقوَةً","غَرَضاً لِأَسهُمِ كُلِّ رامِ",46,"م",1,0],["إجعلى البيت جنة لا تتيري","فى سماء الصفاء منك الضبّابَا",47,"ب",2,0],["إجعلوها بالعلم عُضواً مفيداً","لا تقولوا حياتُهُنّ بَلاء",48,"ا",2,0],["إجعلوها لغةً رسميةً","في الحمى متبوعةً لا تابعة",49,"ع",2,0],["اِجعَلوا إِن مُتُّ يَوماً كَفَني","وَرَقَ الكَرمِ وَقَبري مَعصَرَهْ",50,"ر",2,1],["اجعلت من منع الاراك وعافه","والبان يعجب كل نظرة ناظر",51,"ر",1,0],["اجعل قراي لديكم ما تشتهي","نفسي الفدى لك والجميع لك الفدى",52,"ا",1,0],["اِجعَلتَني لِلبَرجُمَي حَقيبَةً","وَالبُرجَمي هُوَ اللَئيمُ المُحقَبِ",53,"ب",1,0],["اجعَله في الجنان","جواري لا براح",54,"ح",1,0],["اجعلوهُ من نصيبي في","حزبنا لا تفضحوا ولدى",55,"د",2,0],["اجعله قطبا ثاني","محمد المنّان",56,"ن",1,0],["اِجعَل مُشيرَكَ أَهلَ العِلمِ إِنَّ لَهُم","رَأياً إِذا فالَ رَأيُ المُتَري نَجَحا",57,"ح",2,0],["اِجعَل مُشيرَكَ في أَمرٍ تُحاوِلُهُ","مُهَذَّبَ الرَأيِ ذا عِلمٍ وَذا أَدَبِ",58,"ب",1,0],["اجْعَلْ قلادة جيدي في أصابعه","وارْحَمْ به قلبِيَ المُضنَى به القاسي",59,"س",2,0],["أجعفر هو أم بحر طمى كرما","وفاض حتى تخطى غاية الكرم",60,"م",1,0],["اِجعَل جَليسَك دَفتَراً في نَشرِهِ","لِلمَيت مِن حكم العُلوم نشور",61,"ر",1,1],["اِجعَل الزَوج مِن سِراجَك فَرداً","وَاِقتَصَد يا غُلام وَالقَصد أَجدى",62,"د",2,1],["اجعل بواعث قصد قلبك مجتبا","وما سوى المقصود طرّا فاجتنب",63,"ب",1,0],["إجعل لكلِّ تِرِفَّا زادَ جاهُكُمُ","ثُمناً وَمَبداكُمُ الهيرانُ مجعولُ",64,"ل",1,0],["إجعَل على منزِلِكَ الإشارَه","من بَيتِ أرضٍ صحَّ أو حجارَه",65,"ه",1,0],["إجعَلَهَا وَخرَابَهَا يمينَا","والبعضَ في اليَسَارِ يَا فطينَا",66,"ن",2,0],["اجعله أول ما تحيي البلاد به","إنا نؤمل جيشاً منك يغشانا",67,"ن",2,0],["أجعَلني غدا في أمنٍ","من وقفة لا نرضاها",68,"ا",3,0],["أجعل الجهلَ لي شفيعَ ودادي","لأناسٍ حتى انقشاعِ السحاب",69,"ب",1,0],["اجعله يأخذ ايدينا اذا عبس","الوجوه او شاهدوا تكوير شمسهم",70,"م",1,0],["اجعل عزاءَك في الوزير جميلا","اعزز علينا أن يموت قتيلا",71,"ل",2,1],["اجعل لعقلكَ مرآةً تَراهُ بِها","وانظر اليهِ بعين الفكر تُصلحُهُ",72,"ه",1,1],["اجعل العلم يا فتى لك قيدا","واتق اللَه لا تخنه رويدا",73,"د",2,1],["اجعل لنفسك بين قومك مذهبا","حسنا تجده لقدرك المقياسا",74,"س",2,1],["أجعل قِرابَك فضَّةً مَسبُوكةً","وأصُغ عليك من الزَّبرجدِ قائما",75,"م",2,0],["اجعل فداء ولدي ذود آبال","سوف ترى شكري عند الإحلال",76,"ل",1,0],["أجعل بها مرسى حياتك إنما","للماخرات من النفوس مُراسي",77,"س",2,0],["اجعل لسرك من فؤادك منزلا","لا يستطيع له اللسان دخولا",78,"ل",2,1],["أَجَعَلتَ أَسعَدَ لِلرِماحِ دَريئَةً","هَبِلَتكَ أَمُّكَ أَيَّ جَردٍ تَرقَعُ",79,"ع",1,0],["أجعل الساعد اليمين وسادي","فإذا ماانقلبت كان الشمالا",80,"ل",2,0],["اجعل لي الخير هنا متمّما","ومن جميع ضررٍ لي سلِّما",81,"م",2,0],["اجعل معاجك للحميا لا الحمى","فمعرج الأقداح خير معرج",82,"ج",1,0],["إجعلوا الأمة فيهم حكماً","بانتخابات صحاح وادخلوها",83,"و",3,0],["إجعل لنفسك من معقولها عدداً","فعدة العقل كم تأتي على العدد",84,"د",1,0],["أجعل ما لي دون الدنا غرَضاً","وما وهى م الأمور فانصدعا",85,"ع",2,0],["اجعل النار لي مثوى ولبسني أغلال","عند أبي جهل وأصحابه وعجل بالآجال",86,"ل",1,0],["إِجعَلِ الصَّبرَ لِما تحذرُهُ","جُنَّةً فَالصَّبرُ مِفتاحُ الظَفَر",87,"ر",1,0],["إِجعَلي نَفسَكِ لي ناصِرَةً","لَستُ إِلَّا بِكِ مِنكُم اِنتَصَر",87,"ر",1,0],["أجَعتَ بنيكَ وأعرَيتَهُم","ولَم تؤتَ في ذاك من قِلّّه",88,"ل",2,0],["أَجَعَلتِ ذَنبَكِ ذَنبَهُ وَظَلَمتِهِ","عِندَ التَحاكُمِ وَالمُدِلُّ ظَلومُ",89,"م",1,0],["اجعلوا الحب للحياة سبيلا","يبعث الشوق يستميل الجميلا",90,"ل",2,1],["أجعفر فقت في خلقٍ وخُلق","جميع الخلق حاضرهم وبادي",91,"ي",1,1],["اِجعَل العِلمَ أَوَّلاً","وَاِجعَلِ الشِعرَ آخِرا",92,"ر",2,1],["اجعل العقد على العقد عليق","وأنادي يا لأسرار القضا",93,"ض",2,0],["اجعل حروفك للإيضاح واضحة","إن جف حبر دواتي فالمداد دمي",94,"م",2,0],["اجعَلْ فُؤَادَكَ للصَّوَابِ دَلِيلَا","واركَنْ إِلَيهِ مَتَى ضَلَلتَ سَبِيلَا",95,"ل",2,1],["اجعلْ لِكِرشِكَ زَاداً تَستَعِينُ بِهِ","بَقلاً وَفِجلاً وَثُوماً بَعدَهُ البَصَلُ",96,"ل",1,0],["أجعلتَ عيدَكَ بالصّلاحِ متوَّجَاً","أم قد ركزْتَ لباطلٍ أوتادا ؟",97,"د",2,0],["اجعل لأيامها السوداء خاتمة","مسودَّةً ومآلا ساء منقلباد",98,"ب",3,0],["إجعلْ لسانَكَ نخلةً تُمتِعْ بِهِ","سمعَ الأنامِ برطبِه وبعَذبِهِ",99,"ب",2,1],["أجعل صديقَكَ نفسَكْ","وجوفَ بيتك جلْسَكْ",100,"ك",1,1],["اجعل كلام الكاذبين ريحا","لتسلم الهم وتستريحا",101,"ح",2,1],["اجعل فؤادي من لها ولها","أولها لا إله إلا الله",102,"ل",2,0],["اجعل لساني مطابقاً لضمير","القلب في لا إله إلا الله",102,"ل",2,0],["أجعلت حجتك التي تدلى بها","فعل الرعاع وكل قدم أوغد",103,"د",1,0],["أجعجعةٌ وفينا الذكرُ يتلى","وحيدرةٌ يقومُ ولا فقارُ",104,"ر",1,0],["اجعل عواءك بوح الحزنِ من شجن","لعله بالغٌ في البعدِ من رحلا",105,"ل",2,0],["أجعلتني في نهر عشقك جدولا؟","ثم انجرفت إلى الخصام تؤسس...!",106,"س",1,0],["اجعل قصيدك طازجا كي أرغبه","زمن المشاعر منته ومعلبة!",107,"ه",1,1],["اجعلنا يا رباه من عتقائه","وارحم فزاد المذنبين قليل",108,"ل",1,0],["أَجَعَلْتَ اللَّوْمَ عِنْدِي دَيْدَناً","لَهْوُهُ عِنْدَكَ يُنْسِي كُلَّ دَدْ",109,"د",1,0],["إجْعَلْهُ دوْماً في الجَوانحِ ساكِناً","وحَذارِ للحُسّادِ أًن تُبْديهِ",110,"ي",2,0],["اجعلوا منّي صديقا فأنا","منْ زمان لمْ يَعُدْ لِي أصدقاءْ",111,"ا",2,0],["آجع واذا شفتك بطيف الهوى طبت","ضدين لمت فيك داي ودوايه",112,"ا",3,0],["أجعل بقلبك له محل ومدهال","تلقاه ذخر بمعضلات المواجيب",113,"ب",1,0],["اجعلوني مركبا في بحركم","غارقا والناس حولي يضحكون",114,"ن",1,0],["اجعل إلهي بني أعدائنا بدداً","واحرقْ دماهم كما هم أحرقوا علمي",115,"م",2,0],["إجعل ثقاتك للقرى حكما","وابسط مجال البت للحكم",116,"م",1,0]]}