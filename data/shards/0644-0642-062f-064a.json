{"poems":[[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"لقد يرتقي في الجمع فرد ذرى المجد","https://www.aldiwan.net/poem44863.html","الطويل"],[107,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[203,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[412,"محل العلى أني حللت محلها","https://www.aldiwan.net/poem50133.html","الطويل"],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18348","المتقارب"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124298","الطويل"],[2394,"","https://poetry.dctabudhabi.ae/diwan/poem/146281","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93847","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48325","الطويل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34712","الخفيف"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67605","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136485",""],[5002,"هدية العام الجديد...","https://www.poetsgate.com/ViewPoem.aspx?id=202150",""],[5358,"أيام عاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=21764",""],[470,"اللامبالاة","https://www.poetsgate.com/ViewPoem.aspx?id=178019",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""]],"verses":[["لقد يهتز لي غصنٌ رطيبٌ","وقد يرتجُّ لي دِعْصٌ ركامُ",0,"م",1,0],["لقد يرتقي في الجمع فرد ذرى المجد","ويعظم حتى تبصر الجمع في الفرد",1,"د",1,1],["لقد يَسَّرَ اللَّهُ تِلكَ الصعابَ","فما من عَصِيٍّ ولا مِن عَسِرْ",2,"ر",1,0],["لَقَد يسوؤك يا من ضمه جدث","أن القبور بيوت ما لها شرف",3,"ف",1,0],["لقد يبصر المرءُ السما ونجومها","وما في العُلى من معجزات خوارقِ",4,"ق",1,0],["لَقَد يَمَّمَت علياً تَميم وَطال في","سَماء العُلى من فَخرِ فرعك أَصلها",5,"ل",3,0],["لَقَد يَكشِفُ القَولُ عَيَّ الفَتى","فَيَبدو وَيَستُرُهُ ما سَكَت",6,"ت",1,1],["لقد يسر القرآن للذّكر فاعلمن","وتحجير قوم بالحديث متبّر",7,"ر",1,0],["لقد يسّر الرحمن صعب مرامه","فأبصرت أضعاف الذي كنت أسمع",8,"ع",1,0],["لقد يرزق المرء العناية نائماً","ويحرم إدراك العناية من يسهر",9,"ر",1,0],["لقد يمّمَتْ مَثْوى العُلى فأفادَها","صنائِعَ يُرْضي الآمِلينَ جَميلُها",10,"ل",3,0],["لَقَديماً ما شُتِّتَ البَينُ وَالأُل","فَةُ مِن صاحِبٍ فَصَبرٌ جَميلُ",11,"ل",1,0],["لقد يَستضيءُ القومُ بي في أمورهم","ويخبو ضياءُ العين والرأيُ ثاقبُ",12,"ب",1,0],["لقد يأسَ الأحبّةُ مذ أهالوا","عليكَ برغمِ أنف المجدِ تُربا",13,"ب",2,0],["لقد يبسَتْ أزاهيرٌ وفلّ","وعامٌ انقَضى شربَ القضايا",14,"ا",3,0],["لقد يعودُ الذي جافى أسيرتَهُ","نفسٌ- بها بعضَ أيام ٍ - يُسَلّيها",15,"ي",3,0],["لقد يَبِسَتْ أَضْلُعِي كلُّها","وجَفَّ من العَتْبِ حتى القلَمْ",16,"م",1,0],["لقد يجمع الله كُلَّ المنايا‏","وكُلَّ الحياةِ لنا في مُحَيّا",17,"ي",2,0]]}