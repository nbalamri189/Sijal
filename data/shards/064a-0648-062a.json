{"poems":[[88,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[72,"صفحا لصرف الدهر عن هفواته","https://www.aldiwan.net/poem42997.html","الكامل"],[111,"همم الملوك أجلها أعظامها","https://www.poetsgate.com/ViewPoem.aspx?id=533",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122605","الكامل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90650","البسيط"],[1570,"","https://poetry.dctabudhabi.ae/diwan/poem/147424","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74192","الكامل"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28316","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91811","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118012","الكامل"],[5411,"حَبيبْين كُنَّا","https://www.poetsgate.com/ViewPoem.aspx?id=198334",""],[5688,"لعنة المنّ","https://www.poetsgate.com/ViewPoem.aspx?id=211080",""],[6125,"مَا للمَعَالِيَ مِنْ ذُرًا وشِمَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=212564",""]],"verses":[["يُؤَتّى إِلى قُرّائِهِ أَنَّ نَسجَهُ","لِيَومٍ وَأَنَّ الحائِكَ اليَومَ فيهِمُ",0,"م",1,0],["يُؤتي المَنايا وَالمُنى كَاللَيثِ في","غاباتِهِ وَالغَيثُ في غَبّاتِهِ",1,"ت",2,0],["يؤتى بأثقال الجبال جرائما","فيزول بالعفو العظيم لزامها",2,"م",3,0],["يؤتَى الشقيُّ إذا طَغَى مِن شِقوةٍ","غَلَبَت عَلَيهِ فماتَ غيرُ سعيد",3,"د",1,0],["يُؤتى الخليفةُ منهُ كلما طَلَعَت","شمسُ النهارٍِ بأنواعٍ من التُّحفِ",4,"ف",1,0],["يؤتَى ويؤتَى شيخه وعجوزه","وبناته وجميع من في الدار",5,"ر",1,0],["يؤتي الزَكاة لِمَن أَتى متعرضاً","لِنداه وَهوَ الراكع المتشهد",6,"د",1,0],["يُؤتَّى إِلَيهِ أَنَّ كُلَّ ثَنِيَّةٍ","تَيَمَّمَها تَرمي إِلَيهِ بِقاتِلِ",7,"ل",1,0],["يُؤتى اليهِ بالنُذورِ ويأخُذُ ال","أَعشارَ وَهوَ الماكسُ العَشَّارُ",8,"ر",1,0],["يُؤتى الجهول بغيه وَيُرَدُّ أر","باب العقول عن المُنى وَيكفّر",9,"ر",1,0],["يؤتى بفضل الله جل وسعيه ال","حظ الموفر من تراث نبيه",10,"ي",2,0],["يوتِّرني هَمْزُ الأثير وَغَمْرَةٌ","تَشدُّ إليْها غنَّةً تَتَرَجَّف",11,"ف",1,0],["يؤتي من البذل أرداه وأخبثه","سرا ويؤتي جميل البذل في الجهر",12,"ر",1,0],["يُؤتَىٰ بِهِ والمَكرُمَاتُ تَحُوطُهُ","وخِصَالُهُ شُمُّ الجِبَالِ رَوَاسِي",13,"س",2,0]]}