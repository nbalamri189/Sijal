في العيش عزّة وعلاء",3,"ا",2,0],["لم تُعوِّضكَ دارُهُ منه لمَّا","ظِلتَ تبكي وللصبابة فَرط",4,"ط",1,0],["لم تعرُني وهناً حبالتُه","إلا عرا قلبي تفجُّعه",5,"ع",2,0],["لَم تَعلَمي وَالخَيرُ أَن لا تَعلَمي","كَم في السُكوتِ فَواجِعاً وَمَآسي",6,"س",2,0],["لَم تَعِث في وَجهِكَ الوَضّاحِ","أَلحاظَ الثَعالِب صُن جَمالَك",7,"ك",1,0],["لَم تَعلَمِ الحَسناءُ أَنَّ قَطيلَها","مَن لَم تَرَ أَبَداً سِواهُ جَميلا",8,"ل",2,0],["لَم تَعدُ شاطِئَها وَلَم","تَبلُغ إِلى ثَبَجِ العُبابِ",9,"ب",1,0],["لم تُعْضِل الأحداثُ إلا طبَّقَتْ","منهنَّ عزمتُك المُبِرَّةُ مفصِلا",10,"ل",2,0],["لَم تُعطِها أَمَلاً وَلَم تَشغَل بِها","فِكراً وَلَم تَسال لَها عَن مَوضِعِ",11,"ع",1,0],["لَم تَعدُ مُذ أَدرَكتَ أَربَعَةً","إِلّا بِسابِقِ غايَةٍ تَجري",12,"ر",2,0],["لم تَعتَرِضْ غِزلانُهُم يَومَ النَّقا","إلا لكي يُخْجلِنَ غِزلانَ النَّقا",13,"ق",2,0],["لم تَعثُرِ الخيلُ بهِ في عِثْيَرِ","يَنسى به المطعونُ فَرْطَ المُنكَرِ",14,"ر",1,0],["لم تَعْرَ من صِبْغِ الذَّوائبِ إذ غدَتْ","مَطمومةً ليسَت بذاتِ ذوائبِ",15,"ب",1,0],["لَم تَعتَذِر قَطُّ مِن ذَنبٍ إِلى أَحَدٍ","وَالحُرُّ مُعتَذِرٌ إِن زَلَّةً فَعَلا",16,"ل",2,0],["لَم تُعطَ مَعَ أُذُنَيكَ نُطقاً واحِداً","إِلّا لِتَسمَعَ ضِعفَ ما تَتَكَلَّمُ",17,"م",1,0],["لَم تَعلَمِ الأَبصارُ في جَريِهِ","قادِمَةً خَفَّت بِهِ أَم جَناح",18,"ح",1,0],["لمتُ عَلَيكِ الدَّهرَ في صَرْفِهِ","وقلتُ للأحداث صَمِّي صَمَام",19,"م",1,0],["لَم تُعانِق رَجُلاً فيما مَضى","طَفلَةٌ غَيداءُ في حُلَّتِها",20,"ت",3,0],["لم تَعلمي أمَطايا اللَّهِ حاملةٌ","منكِ الجلالَ المحلَّى أم مطاياهُ",21,"ا",2,0],["لَمْ تَعكسوا آيةَ الخلاَّقِ بل رجعت","إلى اليهودِ بكم قُربى وأطباعُ",22,"ع",1,0],["لَم تُعالِج دَمحَقاً بائِتاً","شُجَّ بِالطَخفِ لِلدمِ الدَعاع",23,"ع",1,1],["لَم تَعرِفِ الشَمسُ أَنَّها خُلِقَت","وَلا اِختِلافُ الحَرورِ وَالصَرَدِ",24,"د",1,0],["لَم تُعطِنا العِلمَ أَخبارٌ يَجيءُ بِها","نَقلٌ وَلا كَوكَبٌ في الأَرضِ مَرصودُ",25,"د",1,0],["لَم تُعطِ قَطُّ أُنوفاً جُدِّعَت شَمَماً","فَلَيتَ كَفَّكَ لَم تَجدَع أَخا الشَمَمِ",26,"م",1,0],["لم تعرفِ المعروفَ أفعالهُ","قطُّ كما لم يُنكرُ المُنكَرا",27,"ر",2,0],["لَم تُعينيني على صَرفِ النَّوى","آهِ لو كنتِ على الدهرِ أعَنتِ",28,"ت",1,0],["لم تعتمد على عقول فارس","ولا سيوف الدّيلم الفوارس",29,"س",1,0],["لَمْ تَعْتَقِدْ إِلاَّ الْوَلاءَ وَقَدْ أَبَى","لَكَ أَنْ تُلَبِّيَ دَاعِيَ الإِخْفارِ",30,"ر",1,0],["لَمْ تُعَلِّمْهُمُ المَسَاعِيَ إِلاَّ","وَمَدَى الْعَزْمِ لَيْسَ بِالمَحْصُورِ",31,"ر",1,0],["لَمْ تَعْدُ مَا في النَّفْسِ مِنْ","شَتَّى الْهَواجسِ والْخَوَاطرْ",32,"ر",1,0],["لُمتُ عَلى الدَمعِ فَاِنتَهى بي","حُزني حَتّى اِنتَهى العَذولُ",33,"ل",1,0],["لَمْ تَعْرِف السَّوْطَ إِلاَّ صَوْتَ مُرْتَجِزٍ","كَأنَّ في فيهِ مِزْماراً مِنَ القَصَبِ",34,"ب",1,0],["لم تَعُدْ مصرُ طعامًا سائغًا","لجياع الغرب من شاء طَهاهْ",35,"ا",2,0],["لم تُعدْ تحكُمُ مصرًا أسرةٌ","تشتري العرش بإحناء الجباهْ",35,"ا",2,0],["لم تَعرُ قلبَكَ سكتةٌ، لكنه","قد ذاب من عطفٍ ومن إشفاق",36,"ق",1,0],["لم تعد نهنأ ، ولا نأسى ، ذوت","خضرة الانس ، خبت نار الترح",37,"ح",1,0],["لمْ تُعظِها أمَلاً، وَلمْ تُشغِلْ بِهَا","فِكراً، وَلمْ تسألْ لهَا عنْ موْضِعِ",38,"ع",1,0],["لم تعلم الحسناء أنّ قتيلها","من لم تر أبدا سواء جميلا",39,"ل",2,0],["لم تعرف الحور أشهى من سلافتنا","رفّ الهجير ندى لما سقيناه",40,"ا",2,0],["لَمْ تُعانِقْ رَجُلاً في مَضَى","طفلة ٌ غيداءُ في حلتها",41,"ت",3,0],["لم تعدَم الدنيا ولا الدينُ مِن","أبنائهم وزارةً أو قَضا",42,"ض",2,0],["لم تعرفوا مقدار ما أوتيتمُ","وأَتيته فأنا عليه حريضُ",43,"ض",1,0],["لَم تَعُد تَرشِفُ ذيّاكَ الرضاب","بِسِوى التِذكار",44,"ر",1,0],["لم تعبِّر بلاغتي ولساني","منه عن عُشْر ما حوتْ أسراري",45,"ر",2,0],["لَم تُعَنِّفهُ بِالمَلامِ وَشَرُّ ال","وُدِّ وُدُّ مُستَحدَث بِعِتابِ",46,"ب",1,0],["لَم تَعُد عَنهُمُ الظُبا حينَ أَشلا","ها عَلَيهِم إِلّا وَهُم أَشلاءُ",47,"ا",2,0],["لم تعدْ بَعْضاً مُصاباً","قد رماني ما رماكَ",48,"ك",1,0],["لم تعدني رغم أني","كنت دوما عند وعدي",49,"د",2,0],["لم تعلم العلياء إلا باسمه","فكأنه علم على العلياء",50,"ا",2,0],["لم تعرفِ الأقلامُ كفَّ أبيكَ في","حقلٍ وما كانت لهُ ميراثا",51,"ث",2,0],["لم تعصمِ الخلفاءَ منهم عصمةٌ","قرشيّةٌ ما مَسّها الأنداد",52,"د",1,0],["لم تعرفوا الحقَّ إِلا بين أسلحةٍ","مركومةٍ تسكبُ النيرانَ تسكابا",53,"ب",2,0],["لَم تعرُ مرتوب العفافِ مروءةٌ","لَوليِّ نِعمَتها شكَت ما يَعتري",54,"ر",2,0],["لَم تَعدموا بِحياتهِ ومماتهِ","خيراً كما يُبقي الغمامُ ثَجيجه",55,"ج",2,0],["لَم تَعرِفِ الخَيلُ العُرابُ سَواءَنا","عَشِيَّةَ أَغواثٍ بِجَنبِ القَوادِسِ",56,"س",1,1],["لم تعد بيننا فروق سوى القد","رة سرّ الإيجاد والإعدام",57,"م",1,0],["لم تعُد غير مسرحٍ لأفاعي ال","وَهمِ تغذو بسمّها أفكاري",58,"ر",2,0],["لم تعد تعرف السلام سوى","أسطورة خطها يراع غبي",59,"ي",1,0],["لَم تَعتَرِضكَ وَقَد قَصَد","تُكَ دونَ حاجاتي سَآمَه",60,"م",2,0],["لَم تَعرُ جِسمَكَ عِلَّةٌ بَل صِحَّةٌ","خَلَعَت عَلَيكَ نُضارَها لِلناظِرِ",61,"ر",1,1],["لَم تَعدِلوا قَسمَكُم أَنَّ اللَيالي لي","وَأَن شَمسَكَ قَد وَلَّت بِأَيّامي",62,"م",2,0],["لم تعقْه فدافد وحزون","وقفار مهولة وجبال",63,"ل",1,0],["لم تعطه غانيةٌ قبلةً","إلاّ كمن تهزأُ من رُشدهِ",64,"د",2,0],["لم تَعِبها هزَّةٌ في قدّها","إنه من صفة الرمح الخطَلْ",65,"ل",1,0],["لمْ تعرِفا بعدُ كيفَ يُمسيْ","العدوُّ منْ صُحبةٍ تطِيبُ",66,"ب",1,0],["لمْ تعرِفا المُفسِديْنِ والتّوْ","بُ ليسَ منْ بعدهِ ذنوبُ",66,"ب",1,0],["لم تعل إلا خدمة وصيانة","وكذا السيوف تصان في الأغماد",67,"د",1,0],["لم تعترض حظك منها فترة","فلا أن تقابلها بحظ فاتر",68,"ر",1,0],["لم تعتقل إلا عقيلة معشر","لعلاك منهم غارب وسنام",69,"م",1,0],["لم تعرفوا شوقاً فلم تأووا لمن","يُضحِي ويُمسِي نحوكم يتشوّقُ",70,"ق",1,0],["لَم تُعطِ في عطائِها تَكديرا","حَرايَةً وَلَم يَكُن مَهبورا",71,"ر",2,0],["لم تَعَهدِ العُليا فَتىً كمُحمَّدٍ","في النَّاسِ وَهْيَ لَدَيهِ مما يُعهَدُ",72,"د",1,0],["لَم تَعرِفِ الحِقدَ في يَومِ سَريرَتُهُ","وَلا وَعى سِرُّهُ شَيئاً سِوى الطيبِ",73,"ب",1,0],["لَم تَعرِفِ الكِبرَ في قضولٍ وَلا عَمَلٍ","كَلّا وَلا سَرَت يَوماً سَيرَ مُختالِ",74,"ل",1,0],["لم تعثر أَقدامها يوم أَمسى","قدم الموت بالنفوس عثورا",75,"ر",2,0],["لم تعرف الدنيا نبياً مرسلاً","في ذا الشباب ولا رأت أبرارا",76,"ر",2,0],["لم تعطك الألقاب إلا همة","ملء الوجود وأنعم لا تنفد",77,"د",1,0],["لم تعرف الأيام مملكة هوت","من قبلهم في ليلة ونهار",78,"ر",1,0],["لَمْ تَ