{"poems":[[190,"إذا التقيا صباحا","https://www.aldiwan.net/poem43178.html","المجتث"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39035","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125377","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109855","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"]],"verses":[["من لغيري عن","خصال ردية ورضيّة",0,"ي",2,0],["مَنْ لِغُصنٍ بِلِينِ ذاكَ التَّثَنِّي","مَنْ لِبَدْرٍ بنُورِ ذَاكَ الجَبينِ",1,"ن",1,0],["مَن لغُصنِ النَّقا بلينِ قوامِك","أو لزَهرِ الرُبى بحسنِ ابتسامك",2,"ك",1,1],["من لغصن النقا بلين قوامك","او لزهر الربى جمال ابتسامك",3,"ك",1,1],["مَنْ لِغِرٍّ يَسُومه الدهرُ خَسْفاً","يَقْدَح الماءَ كي يَشُبّ الضِّراما",4,"م",2,0]]}