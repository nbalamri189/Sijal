{"poems":[[55,"أقول وقد جاز الرفاق بذي النقا","https://www.aldiwan.net/poem30530.html","الطويل"],[65,"ألا ليت شعري هل أرى أم سالم","https://www.aldiwan.net/poem45785.html","الطويل"],[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[53,"إذا كان صبري للعاجل","https://www.aldiwan.net/poem65905.html","الخفيف"],[72,"أنا في الحقيقة أنتم","https://www.aldiwan.net/poem42699.html","مجزوء الكامل"],[45,"مبيتي من دمشق على فراش","https://www.aldiwan.net/poem9714.html","الوافر"],[47,"أبا الطيب اسمع لا سمعت بحادث","https://www.aldiwan.net/poem64556.html","الطويل"],[46,"كف الندى أضحت بغير بنان","https://www.aldiwan.net/poem30297.html","الكامل"],[71,"هذا اليهودي الطبيب إذا رأى","https://www.aldiwan.net/poem28391.html","الكامل"],[107,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[107,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[48,"يعلم إلهي يوجد الضعف شيمتي","https://www.aldiwan.net/poem22051.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[173,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[190,"كلفت بدنيا لست أنكر حالها","https://www.aldiwan.net/poem43436.html","الطويل"],[208,"فديتك ما للدهر فيك وللقلى","https://www.aldiwan.net/poem53260.html","الطويل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[376,"هواي الذي أبدي واضمره يحيى","https://www.aldiwan.net/poem56924.html","الطويل"],[443,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[463,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[463,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48669","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37731","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62501","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96740","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96648","الطويل"],[1083,"","https://poetry.dctabudhabi.ae/diwan/poem/29489","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79799","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108720","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26512","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177843","الطويل"],[2147,"","https://poetry.dctabudhabi.ae/diwan/poem/73698","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121004","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137257",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100936","الطويل"],[2772,"","https://poetry.dctabudhabi.ae/diwan/poem/199404","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140052",""],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96427","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112500","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112569","الكامل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67590","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62763","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123942","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205917","المتدارك"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72848","المتقارب"],[4852,"حيرانة","https://www.poetsgate.com/ViewPoem.aspx?id=214392",""],[4856,"عصفورة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=36740",""],[5038,"تفافيح","https://www.poetsgate.com/ViewPoem.aspx?id=189581",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5444,"عروق التبر","https://www.poetsgate.com/ViewPoem.aspx?id=203348",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5732,"اصبر على ضيم الليالي ونكدها","https://www.poetsgate.com/ViewPoem.aspx?id=177837",""],[5911,"عجب لذا الكحال كَيفَ أضلني","https://www.poetsgate.com/ViewPoem.aspx?id=188964",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[5309,"أأصوغ في مدح العتاة قصيدي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573937",""],[6192,"نقاط استفهام إلى شاعر صهيوني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63735&r=&rc=5",""],[463,"لمن طللٌ بلوى عاقلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60218&r=&rc=274",""]],"verses":[["أَأَصبِرُ وَالوَعساءُ بَيني وَبَينَكُم","وَأَعلامُ خَبتٍ إِنَّني لَجَليدُ",0,"د",1,0],["أَأُصغي إِلى اللاّحي وَبَيني وَبَينها","حَديثٌ كَسِمطِ اللؤلؤِ المُتناسِقِ",1,"ق",1,0],["أأُصانِعُ الأعداءَ فيكِ وطالَما","خَضَبَ القَنا بدِماءِ قوْمِكَ مَعْشَري",2,"ر",2,0],["أأصبرُ هذا المدى كُلَّه","لغير رغيبٍ ولا طائلِ",3,"ل",1,0],["أَأَصونُ دَمعي في الهَوى","لِأَعَزَّ عِندي مِنكُمُ",4,"م",1,0],["أَأَصبِرُ عَنكَ لَم تَبخَل بِشَيءٍ","وَلَم تَقبَل عَلَيَّ كَلامَ واشِ",5,"ش",1,0],["أَأَصبِرُ لا وَاللَهِ ما لي تَجَلُّدٌ","فَأَسلو وَلا عَن حُسنِ وَجهِكَ مِن صَبرِ",6,"ر",1,0],["أَأَصابَ مِنكَ المَوتُ فُرصَةَ ساعَةٍ","فَعَدا عَلَيكَ وَأَنتُما أَخَوانِ",7,"ن",1,0],["أأصونُها عنْ أختها شمسِ الضحى","ويرى محاسنَها العدوُّ الكافرُ",8,"ر",1,0],["أأصنعُ الصُّنْعَ مَحموداً فَيخذِلُني","أبٌ أراه لغيرِي خيرَ مِعوانِ",9,"ن",1,0],["أأصحابُ اليمينِ بكم أُصِيبوا","لأنتم شَرُّ أصحابِ الشِّمالِ",10,"ل",1,0],["أَأُصبِحُ في الدُنِّيا كَما هُوَ عالِمٌ","وَأَدخُلُ ناراً مِثلَ قَيصَرَ أَو كِسرى",11,"ر",2,0],["أأصبر عن أحبائي الألى قد","ثَوَوا إني إذاً رجل جليد",12,"د",1,0],["أَأَصْبَحَ اليَوْمَ فَقِيدَ قَوْمهِ","مَنْ عَاشَ فِيهِمْ فَاقِدَ الأَنْدَادِ",13,"د",1,0],["أأصون عرضي وابنتي وحياتها","وعلاجها يحتاج للإنفاق",14,"ق",1,0],["أأصبت أم أخطات في","مسعاك نهج المحسنين",15,"ن",1,0],["أَأَصبِرُ إِمّا شاكِياً مُتَعَتِّباً","إِلى شامِتٍ أَو باكِياً أَتَظَلَّمُ",16,"م",1,0],["أأصبوا إليها راغبا في دوامها","وقد عرفتني لو عرفت زوالها",17,"ل",3,0],["أأصبر للهجران أم أطلب الرضا","وهيهات أن ترضى وهيهات من صبري",18,"ر",2,0],["أأصبِرُ عن نادِيه يوماً يَمرُّ بي","وما أنا فيه حاضِرٌ ومُحاضِر",19,"ر",1,0],["أأصبر عن يَحيَى وأطوي وِصالَهُ","إذاً فَطَواني عَنه صَرفُ الرَّدى طَيَّا",20,"ي",2,0],["أأصغيتُ فيك إلى كاشحٍ","وهل حال عنك فؤادي وحادا",21,"د",2,0],["أأصيبَ بالشمس الضُّحَى أم خولست","فيها الليالي البيضُ بدرَ تمامِ",22,"م",1,0],["أأصحو على النظرِ البابلي","يِ والخمرُ والسحرُ في بابلِ",23,"ل",1,0],["أأصبر عنه حين أصبحَ كلسياً","هو الغصن أعطافاً وأوراقه الشعر",24,"ر",1,0],["أأصبر حتى يسقط العرشُ بينهم","وتلتهم النيران تلك الخمائلا",25,"ل",2,0],["أَأَصْحو وعَيْناها سُقاةُ مُدامَةٍ","وَمَبْسمُها كاسٌ يَحلُّ لمُغرَمِ",26,"م",1,0],["أأصبو إلى غيره ضِلّةً","وما أليقَ الغَيّ بالخاسرِ",27,"ر",1,0],["أأصرف بالملام عنان لهوي","وقلبي مستقادٌ بالعنانِ",28,"ن",1,0],["أأصلح سواس الأمور عقيدةً","إِذا كشفوا عن خافيات العقائدِ",29,"د",1,0],["أأصرّها وبني عمّي ساغبٌ","فكفاكِ من إبةٍ عليّ وعَابِ",30,"ب",1,0],["أَأَصبو ويعروني على الشيب صَبْوَة","وان كان غياً بالكبير إذا صبَا",31,"ب",2,0],["أأصدرُ ظمآناً وقد جئتُ مُورِداً","رجائيَ مِن جدواك أعذبُ منهلِ",32,"ل",1,0],["أأصبح سيفاً من سيوف معمرٍ","تعوَّد أن يفري القلوب ولا يفرى",33,"ر",2,0],["أَأَصدُقُ أَم أَكني عَنِ الصِدقِ أَيُّما","تَخَيَّرتَ أَدَّتهُ إِلَيكَ المَحافِلُ",34,"ل",1,0],["أأصبر لا والله ما الصبر شيمتي","على من له وجه من الشمس أضوأ",35,"ا",1,0],["أَأَصدُرُ عَن مَغنىً بِهِ النُّورُ سَادِراً","وَأَرحَلُ ظَمآناً عَلى شاطىءِ البَحرِ",36,"ر",1,0],["أأصمك الاضغال يوم تحملوا","ام صرت بعد الضاعنين بليدا",37,"د",2,0],["أأصحابَ‍نا يا صاحِبَ الأدباءِ","ويا نخبة الكُتّابِ والشُّعراءِ",38,"ا",2,1],["أأصبر للفراق وطال حتى","وهي جلدي وقل الاصطبار",39,"ر",1,0],["أأصبحتُ ملءَ الأرض حتى إذا نَبَا","مكانىَ بى لم ألقَ غير مكانى",40,"ن",2,0],["أَأَصْبو إِلى الْحُور الحِسان وهِمَّتي","تَهِيمُ بِضَرب الْهامِ قاهِرةً ضِدّي",41,"د",2,0],["ااصبر في أواخر عمري صبري","وقد وافى عذارك في المبادي",42,"د",2,0],["أأصرمُهُ فالصرمُ شر مغبة","ونفسي إليهِ بالوصالِ تطلَّعُ",43,"ع",1,0],["أَأَصد عَن جد وَعَبد اللَه لي","وَأحاد عَنهُ وَفي بَقاه بَقائي",44,"ي",1,0],["أأصبح مسجونا وما كنت مذنبا","ولا حزبتني في الحياة ذنوب",45,"ب",1,0],["أأصوغ في عرس المليك قصيدة","وأنا إلى الموت الرهيب زفافي",46,"ف",2,0],["أَأُصطادُ خَدععاً ببذلِ الأمانِ","وهَيهاتَ ذلكَ صَعبٌ عَسِرْ",47,"ر",1,0],["أأصْحَبُ فيه الذُّلَ والعَضْبُ صارمٌ","وأركبُ فيه الخَسفَ والطِرْفُ سالِمُ",48,"م",1,0],["أأصبو إلى عهد الصبابة بعد ما","تجاوزت عن سن الشباب مراحلا",49,"ل",2,0],["أأصنام باغين تبغونها","وأنتم تذلون ذل الخدم",50,"م",1,0],["أأصبرُ عنهم وهم للحشا","حياةٌ بها جسم أنسي يعاد",51,"د",1,0],["أأصدّقُ الموهومَ .. أنّي عشقُهُ","وأذيقهُ شهدَ الهوى وبيانَهْ؟!",52,"ن",2,0],["أَأَصبحَ غُصننا يا حُبُ جَدْباً؟","أرى عصفورتي هَجَرَتْ عريني",53,"ن",2,0],["أَأَصْبرُ عنْ هواها واللّيالي","حمَلْنَ صَوى الْجَنانِ على السَّفودِ",54,"د",1,0],["أأصيبت في مقلتيها السماء","فبكت من بكائها الغبراء",55,"ا",2,1],["أ أصلح دنيانا وأصلح ديننا","وأبدل بعد الخوف أمنا بما فعل",56,"ل",1,0],["أأصومُ؟ كلا، فالصيامُ محرمٌ","فزدِ السعادةَ باللقاءِ مُعيّدا",57,"د",2,0],["أأصبرُ بعدَما قد سارَ ليلاً","أُهيلُ الحيِّ وارتحلَ الفريقُ",58,"ق",1,0],["ااصبر على ضيم الليالي ونكدها","وناجي القلب بالفواد عليل",59,"ل",1,1],["أأصاب مِنْهُ فِي ثَلَاثَة أعين","هَذَا لعمركم الصغار بِعَيْنِه",60,"ن",2,0],["أَأَصبَحَ الحَقُّ كِلماتٍ نُرَدِّدُها","عَلَى المَقاهِي بِنَفثاتِ النَّراجِيلِ ؟",61,"ل",1,0],["أَأَصوغُ في مَدحِ العُتاةِ قَصيدي","وَحُروفُهُ كَاللُّؤلُوءِ المَنضودِ",62,"د",1,1],["أَأصبَحَ حَشْوَ قُنبُلَةٍ وَطَائِرَةٍ وَشَارَا؟","أَمَ اصْبَحَ خَنجَرًا في الظَّهْرِ أَو خِزيًا وَعَارَا؟",63,"ر",2,0],["أأصحو على النظرِ البابليّ","والخمرُ والسحرُ في بابلِ",64,"ل",1,0]]}