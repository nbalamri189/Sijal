{"poems":[[74,"أرأيت نهج الحق كيف يبين","https://www.aldiwan.net/poem20170.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[242,"أشكر لمندوصة خير الأخايير","https://www.aldiwan.net/poem18831.html","البسيط"],[276,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[280,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[285,"من كان مثل أبي علي فلينل","https://www.aldiwan.net/poem60759.html","الكامل"],[543,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122622","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112764","الكامل"],[1711,"","https://poetry.dctabudhabi.ae/diwan/poem/145765","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62137","الكامل"],[6031,"عَاثَ الحِمامُ فما أبقَى وما تَرَكَا","https://www.poetsgate.com/ViewPoem.aspx?id=46283",""],[572,"قد جاءَنا الورقُ الذي وفَّرتَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9350&r=&rc=207",""]],"verses":[["والعضب يعرف قدره وعناءه","إن سلّ أو غمضت عليه جفون",0,"ن",1,0],["والعَضْبُ لا يَشْفي امْرَأً من ثأرِهِ","إلاّ بفَقْدِ نِجادِهِ وقِرابِهِ",1,"ب",2,0],["وَالْعَضْبَ مَنْ يَعْتَلِي هَامَ الْكُمَاةِ بِهِ","وَالتِّبْرَ دَهْقَانَ نَقَّادِ الدَّنَانِيرِ",2,"ر",1,0],["وَالعضو كلمه وَالجذع حن وَفي","مَعناه تَسليم أَحجار وَأَشجار",3,"ر",1,0],["والْعَضْبُ لم يَعْلَقْ بِهِ عَلَقٌ","حَيْثُ العَوامِلُ ما لَهَا عَمَلُ",4,"ل",1,0],["وَالْعَضْبُ لَيْسَ بِبَيِّنٍ تَأْثِيرُهُ","وَالأَثْرُ حَتّى يَنْتَضِيهِ الْمُنْتَضِي",5,"ض",2,0],["والعَضبُ بعدَ الشَّحذِ أروعُ ما يُرَى","في فَريهِ هَاماً عنِ الأجسَاد",6,"د",1,0],["والعضوُ كلَّمَه إذ صارَ في يَدِه","بِسَمَّةٍ مِن بَغيٍّ ذاتِ زُنّار",7,"ر",1,0],["والعضو خاطبه وفاه بسمه","والغيم ظلله وكم فضل ورد",8,"د",1,0],["والعضبُ ليس يروقُ رونقُ مائه","وفرندِهِ إلاَّ بحسنِ صقالِهِ",9,"ه",1,0],["والعضو من شاة تكلم بالذي","اصلاه عند الطبخ بالسمية",10,"ه",1,0],["والعضب يدركه الصدا ما لم يبل","في كل معركة بضرب الهام",11,"م",1,0],["والعضبُ ما استلَّ من رأيٍ إذا التَحَمَتْ","عُرَى الخُطُوبِ وأَمرُ الأُمَّةِ التَبَكَا",12,"ك",2,0],["والعَضْبُ يَلمعُ في الظَّلامِ كأنَّهُ","من نورِ وجهِكَ أَو ذُكائِكَ مقتَبَسْ",13,"س",1,0]]}