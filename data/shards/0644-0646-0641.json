{"poems":[[80,"بكيت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem14230.html","الطويل"],[91,"لكل طلوع يا ذكاء أفول","https://www.aldiwan.net/poem44942.html","الطويل"],[107,"ألي في الهوى ما لي وللائم العذر","https://www.aldiwan.net/poem43125.html","الطويل"],[83,"أثار الليث ألحاظ نيام","https://www.aldiwan.net/poem61486.html","الوافر"],[48,"هو البر في بحر وإن سكن البرا","https://www.aldiwan.net/poem22605.html","الطويل"],[48,"لنفسي إن تنأ عن الجسم روعة","https://www.aldiwan.net/poem22657.html","الطويل"],[48,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[80,"بَكيتُ إِلى سربِ القَطا إِذ مَرَرنَ بي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87616&r=&rc=162",""],[164,"يا من لدمع مارقي وصبيبه","https://www.aldiwan.net/poem58943.html","الكامل"],[186,"مثوى به نزل المقيم ميمما","https://www.aldiwan.net/poem61149.html","الكامل"],[234,"إمام الهدى سعد وفأل مبارك","https://www.aldiwan.net/poem50894.html","الطويل"],[240,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[369,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[371,"وإني لمطوي الضلوع على جوى","https://www.aldiwan.net/poem17094.html","الطويل"],[382,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[409,"فأغضب الكرم إذ بالفخر قد هدرت","https://www.aldiwan.net/poem33442.html","البسيط"],[412,"لنفسك لم لا عذر قد نفذ العذر","https://www.aldiwan.net/poem50166.html","الطويل"],[447,"أيا أهل القبور فما جواب","https://www.aldiwan.net/poem14369.html","الوافر"],[563,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107247","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137569",""],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67831","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107191","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202086","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65079","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50034","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79991","المنسرح"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108497","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109408","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109450","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93660","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205035","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132701","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28868","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89122","المتدارك"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103622","الطويل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145184","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91130","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136027","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4007,"","https://poetry.dctabudhabi.ae/diwan/poem/130303","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66133","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72448","الطويل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123854","الخفيف"],[4968,"لَحْنُ الحَيَاةِ","https://www.poetsgate.com/ViewPoem.aspx?id=206762",""],[5136,"لنفيس الكلام روح يهز الن","https://www.poetsgate.com/ViewPoem.aspx?id=121690",""],[5338,"لطيبة الغراء شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=187891",""],[5410,"إلى حبيبتي في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=133056",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[186,"مثوى به نزل المقيم ميمماً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55930&r=&rc=193",""],[6259,"لنفسكِ لم لا عذر قد نفدَ العذرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59410&r=&rc=58",""],[6279,"نِداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78852&r=&rc=68",""]],"verses":[["لِنَفسي إِلى لُقيا الحِمامِ تَشوُّفٌ","سِوايَ يُحِبُّ العَيشَ في ساقِهِ كَبلُ",0,"ل",1,0],["لنفسي مقام في السماء ستهتدي","إليه إذا بالنفس جدّ رحيل",1,"ل",1,0],["لِنَفسي وَفائي إن وَفَيتُ بِعَهدِها","وَبي لا بِها إِن خُنتُ حُرمَتَها الغَدرُ",2,"ر",1,0],["لِنَفسٍ قَد حَلَلتَ عُرى عَزاها","وَعَينٍ قَد عَبَدتُ بِها النُجوما",3,"م",2,0],["لِنَفسِيَ ما أَطعَمتُ لَم يَدرِ آكِلٌ","سِوايَ أَحُلواً جازَ في الفَمِ أَم مُرّا",4,"ر",2,0],["لِنَفسِيَ إِن تَنأَ عَنِ الجِسمِ رَوعَةٌ","كَرَوعَةِ أُنثى أُجلِيَت عَن دِيارِها",5,"ر",3,1],["لِنُفوسٍ جَوازِئٍ بِاِصطِبارٍ","يَتَوَقَّعنَ خِلسَةً لِلجَوازِ",6,"ز",1,0],["لِنَفسي إذا ناجيت نَفسي ضراعة","وأَوجه آمالي الَّتي بطلت غبر",7,"ر",1,0],["لِنَفسي إِلى لُقيا الحِمامِ تَشوُّفٌ","سِوايَ يُحِبُّ العَيشَ في ساقِهِ حَجلُ",8,"ل",1,0],["لنفس ذيبي إِهلكت فان تسلَ","ممن به هذا فقل من ذيبه",9,"ب",2,0],["لِنَفوزَ مِن تاريخِه بوُقُوفِنا","في الحَشر بَينَ جَماعةِ الأَبرارِ",10,"ر",1,0],["لِنَفْسِ طبيبٍ جَسَّ عِرْفَكَ سُؤْلُها","فقد جَسّ ما لا يَنْتَهِيه مُماسِك",11,"ك",1,0],["لِنَفسِهِ لا لَكُم كانَت إِساءَتُهُ","وَفي بَنيهِ سَرى لا فيكُمُ الضَرَرُ",12,"ر",1,0],["لِنَفْسِك تَغْدو ضائراً إن قَتلْتَه","لأنّك لو أبقَيْتَه لَفداكا",13,"ك",2,0],["لنَفْسي اصطنَعْتُ القومَ حتَّى إذا حَوَوا","بيَ السُؤلَ جازَوْني جَزاءَ التَماسح",14,"ح",1,0],["لِنَفسي أُريدُ الوَصلَ لا بَعدَ مَوتِها","فَلا خُبرَ لي بَعدَ المَماتِ وَلا عِلمُ",15,"م",1,0],["لِنْ في الخطاب لأحمقٍ متعنتٍ","شكسٍ وكن بجداله فَأفاء",16,"ا",2,0],["لنفسه قائلاً والقلب ملتهب","واحر قلباه ممن قلبه شبم",17,"م",1,0],["لِنَفسِكَ لُم لا عُذرَ قَد نفذ العُذرُ","بذا حكم المَقدور إِذ قُضيَ الأَمرُ",18,"ر",1,1],["لنفخ الصور هم فيها همود","رهائن للأحبة غير صور",19,"ر",1,0],["لنفسه وغيره","بلا ثبوبت زمنا",20,"ن",2,0],["لنفسه فكيف يدعيها","له ولم يكن يقوم فيها",21,"ه",2,0],["لِنُفشِي الغَرامَ ونُشفِي السِّقامَ","بوَصلِ الكِرامِ نُجُومِ الوَرى",22,"ر",2,0],["لنفسك هذا الحب أضحى وقايةً","وفيه روى الرأي المصيب رواية",23,"ه",1,0],["لنفسك شيطان يظل مكلما","وللعقل في علم الفصول معلما",23,"م",2,0],["لنفسي أسعى على غاية","فإن صلحت نلت ما أتمنى",24,"ن",2,0],["لِنَفْسٍ بِهِ يَوْمَ الْحِسَابِ تَوَسَّلَتْ","وَكَمْ حَلَّ عَنْهَا مِنْ أُمُورٍ قَدْ أَشْكَلَتْ",25,"ت",1,0],["لِنَفسِي وفت سُعدَى بِما قَد تَمَنَّتِ","وَمَنَّت وما مَنَّت بِمَا هِيَ منَّتِ",26,"ت",1,1],["لنفسك نفسي فدية أنَّ فرْضَ ما","لنفسك أن تُفْدي ونفسي أنْ تفدِي",27,"د",2,0],["لِنفُوسٍ تَتَمارَى فيهِ هل","عِنْديَ شكٌ بهِ أَو غَيَّذاً",28,"ذ",2,0],["لِنفسه وَهَكَذا الغَزاله","ألطفها ببره ذؤاله",29,"ه",1,0],["لن فاعلا مستفعلن عنه خلف","لجمعه الحكم الذي به اتصف",30,"ف",1,0],["لنفسيهما في فعل كل فضيلةٍ","ضميرا وفاء ليس يُتَّهمانِ",31,"ن",1,0],["لنفسه ما يزال في طلب الرا","حة يومَ المعاد يتعبُها",32,"ب",3,0],["لنفوس من آله أرقوها","وأسالوا على الفيافي دماها",33,"ا",3,0],["لنفينا اتراح كل محب","ومحونا آثار كل حسود",34,"د",1,0],["لنفسها تَخِذته خير مصطحبٍ","والشمس تألف من ابراجها الأسَدا",35,"د",2,0],["لنفع الورى تلقاه يسبق غيره","وعن كل ما فيه الأذى يتجنب",36,"ب",1,0],["لِنَفخ الصُور إِسرافيل وافى","أم الناعي أَراد بِنا انخسافا",37,"ف",2,1],["لنفسي مجرى للعراقيل جارف","فتيارها حر وتيارهم عبد",38,"د",1,0],["لنفسي هاد للعلا ودليل","وللعز مني صاحب وخليل",39,"ل",1,1],["لِنَفسي حَديثٌ دونَ صَحبي وَأَصبَحَت","تَزيدُ لِعَينَيَّ الشُّخوصُ السَّواجِعُ",40,"ع",1,0],["لنفوذ ملاحظه سرُّ","ولذيذ تلفُّظِهِ سحرُ",41,"ر",1,1],["لنفسك أكرمني ولا لمعاشر","اذا انتقذوا كانوا زيوف الدراهم",42,"م",1,0],["لنفسك صاحبن منهم وجانب","شرارا واصرمنهم من حبالك",43,"ك",1,0],["لِنفعل في ذا اليَوم بِالسَيف وَالقَنا","فَعائلنا فيما تقضَّى مِن الدَهر",44,"ر",1,0],["لنفحاتك تعرُّضي فلا","تردّني من العطيّاتِ العُلى",45,"ل",2,1],["لنفني طروادة الكافره","وأبناءها والنسا الطاهره",46,"ه",1,0],["لنفسه من غير أن تحبه","فقد أطال غمه وكربه",47,"ه",1,0],["لنفسه هممٌ من قاس أصغرها","بهمّة الدهر فاعلم أنه كذبا",48,"ب",2,0],["لَنَفْتَحَ في هامِ النُّجُومِ مَسالِكاً","تُعَبِّدَها مِنا الظُّبَى والذَّوابِلُ",49,"ل",1,0],["لنفثة سحري ينتمين لحاطها","وألفاظ تعزى لرقة أسحاري",50,"ر",2,0],["لنفيس النفوس بالفتك يأتي","بفعال تجوز حد المواضي",51,"ض",2,0],["لِنٌفُوسٍ سَاحِرَةٍ خُلٍقَتْ","كَالوَرْدَةِ مُذْ فَاحَتْ عَبَقَا",52,"ق",2,0],["لنفيس الكلام روح يهز الن","نفس هز الرياض ودق الغمام",53,"م",1,1],["لِنَفْسِكَ اسْتَحْرِزْ وَلاَ تَتَّخِذْ","بِطَانَةَ الْجَهْلِ لِنَيْلِ الْمَعَالْ",54,"ل",1,0],["لنفيقَ مِنُ سُكْرٍ وندركَ أننا","صارتْ لنا بينَ الخِيامِ خِيامُ",55,"م",1,0],["لنفوسٍ بميتمٍ وانكسارٍ","وجدارٍ يُقيمه التحنانُ",56,"ن",1,0],["لنفسه وما جنى من هلكه","يا طول بؤساه ويا طول الحرب",57,"ب",1,0],["لنفور من تاريخه بوقوفنا","في الحشر بين جماعة الأبرار",58,"ر",1,0],["لنفسكِ لم لا عذر قد نفدَ العذرُ","بذا حكم المقدور إذ قُضي الأمرُ",59,"ر",1,1],["لِنَفتَرِقَ الآنَ تحت الظلامِ","حِفاظاً على المَوعِدِ المُرتَقَبْ",60,"ب",1,0]]}