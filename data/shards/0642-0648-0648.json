{"poems":[[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[443,"دعوا مقلتي تغفي إذا لم يكن وصل","https://www.aldiwan.net/poem2512.html","الطويل"],[463,"ينام على الغدر من لا يغار","https://www.aldiwan.net/poem56201.html","المتقارب"],[466,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96709","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202100","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90825","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90894","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90834","الطويل"],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""]],"verses":[["قَؤُولٌ وَأَحْلامُ الرِّجَالِ عَوَازِبٌ","صَؤُولٌ وَأَفْوَاهُ الْمَنَايَا فَوَاغِرُ",0,"ر",1,0],["قؤول فعول للمكارم والندى","سريع وحسن القول أن يحسن الفعل",1,"ل",1,0],["قؤولٌ إذا الألسنُ المطلَقا","تُ قيَّدَها حَصَرٌ وانكسارُ",2,"ر",1,0],["قؤُولٌ تهاب اللُّدُّ بأس صوابه","إذا حبستْ نُطق الفصيح الخصائم",3,"م",1,0],["قؤولٌ فعولٌ حيث قال فحسبهُ","منال العلا فيما يقول ويفعلُ",4,"ل",1,0],["قؤولا في ولائهم فعولا","بَذول النّصح في سِرّ وجَهْر",5,"ر",1,0],["قؤول إذا ما الحكم أشكل أمره","بفصل خطاب كالمهندة البتر",6,"ر",1,0],["قؤول مسكر الفصحاء لفظا","هوالكاسات والخمر المعاني",7,"ن",2,0],["قؤول لدى فصل الخطاب مهذب","أحد من الفصال رايا مسددا",8,"د",2,0],["قَؤُولٌ فَعُولٌ لِما قالَ لَمْ","يَزَلْ فاعِلاً كُلَّ ما كانَ قَالا",9,"ل",2,0]]}