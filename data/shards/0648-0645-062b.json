َمَرَّ يَحرُقُ بِالأَنيابِ لِليَمَنِ",0,"ن",1,0],["وَمِثلِكِ ظالِمَةِ المُقلَتَينِ","تَلاقى الجَمالُ عَلَيها وَتَم",1,"م",1,0],["وَمِثلُكَ إِن أَولى الجَميلَ أَتَمَّهُ","وَإِن بَدَأَ الإِحسانَ زادَ وَوالى",2,"ل",2,0],["وَمِثلِيَ لا يَأسى عَلى ما يَفوتُهُ","إِذا كانَ عُقبى ما يَنالُ زَوالُ",3,"ل",1,0],["وَمِثلُكَ أَهدى أَن يُقادَ إِلى الهُدى","وَأَرشَدُ أَن يَنجازَ عَن جِهَةِ الرُشدِ",4,"د",1,0],["وَمِثلُكَ مَن قَذَفَتهُ الخُطو","بُ في صَدرِ كُلِّ خَميسٍ لَجِب",5,"ب",1,0],["وَمِثلُ سَمعِكَ يَدعوهُ إِلى كَرَمٍ","قَولٌ تُشَيِّعُهُ أَنفاسُ مَكروبِ",6,"ب",1,0],["وَمِثلُكَ مَن يُعشى إِلى ضَوءِ نارِه","وَيُلفى قِراهُ عِندَ كُلِّ خِباءِ",7,"ا",2,0],["ومِثْلي حين تُبْتَدَرُ المَعالي","تَهونُ عليهِ أطْرافُ الرِّماحِ",8,"ح",1,0],["ومِثْلُكَ زانَ سُؤْدَدَ أوّلِيهِ","بِطارِفِهِ وزَيّنَهُ التِّلادُ",9,"د",1,0],["وَمُثقَلَةِ الأَردافِ مَهضومَةِ الحَشا","لِصورَتِها في الحُسنِ فَضلٌ عَلى الصُوَر",10,"ر",1,0],["ومِثْليَ يبْقَى علَى عهْدِهِ","إذا أعْرَضَ الخِلُّ أو أقْبَلا",11,"ل",2,0],["ومِثْلُكَ يُرْجى للقَبولِ وللرِّضى","وعنْدكَ أيضاً للصّنيعة موْضِعُ",12,"ع",1,0],["وَمَثْوَاكَ مَقْصُودٌ وَحُبُّكَ طَاعَةٌ","وَأَمْرٌ عَلَى الأَعْيَانِ مُفْتَرَضٌ حَتْمُ",13,"م",1,0],["وَمِثْلُكَ يَرْتَاحُ لِلْمَكْرُمَاتِ","وَمَا لَكَ بَيْنَ الْوَرَى مِنْ مِثَالِ",14,"ل",1,0],["ومثْلُكَ مَنْ يُعْنى بمِثْلي فإنّني","تَهيمُ المَعالي في ثَنائي وفي شُكْري",15,"ر",2,0],["ومثلُكَ مَنْ يرْعى الدّخيلَ ومَنْ دَعا","بِيا لمَرينٍ جاءَهُ العِزُّ والنّصْرُ",16,"ر",1,0],["ومِثْلُكَ مَنْ يَرْمي بهمَّتِهِ العُلى","ويَرْفَعُ أعْلامَ الثّناءِ المُجَدَّدِ",17,"د",1,0],["وَمِثلُ الَّذي تولونَني في بُيوتِكُم","يُقَنّي سِناناً كَالقُدامى وَثَعلَبا",18,"ب",2,0],["وَمِثلِكِ خَودٍ بادِنٍ قَد طَلَبتُها","وَساعَيتُ مَعصِيّاً لَدَينا وُشاتُها",19,"ت",3,0],["وَمِثلِكِ مُعجَبَةٍ بِالشَبا","بِ صاكَ العَبيرُ بِأَجسادِها",20,"د",3,0],["وَمَثنى نَواجٍ ضُمَّرٍ جَدَلِيَّةٍ","كَجَفنِ اليَماني نَيُّها قَد تَحَسَّرا",21,"ر",2,0],["وَمَثابَةً لِلرِزقِ أَحمَدُها","ما رَدَّ مِسكيناً وَلا دَعّا",22,"ع",2,0],["وَمَثَّلَ في شَيلوكَ لِلبُخلِ سِحنَةً","عَلَيها غُبارُ الهونِ وَالوَجهُ أَقتَمُ",23,"م",1,0],["وَمَثَّلَ لي عَرشَ الخِلافَةِ خاطِري","فَأَرهَبَ قَلبي وَالجَلالَةُ تُرهِبُ",24,"ب",1,0],["وَمُثَقَّفٍ إِن رامَ مُهجَةَ فارِسٍ","لَم تَحمِها مَوضونَةُ الأَدراعِ",25,"ع",1,0],["وَمِثلِيَ قَد تَهفو بِهِ نَشوَةُ الصِبا","وَمِثلُكَ قَد يَعفو وَمالَكَ مِن مِثلِ",26,"ل",1,0],["وَمِثلُكَ والى مِثلَهُ فَتَصافَيا","كَما صافَتِ الماءَ القَراحَ مُدامُ",27,"م",1,0],["وَمِثلُكِ بَيضاءَ العَوارِضِ طِفلَةٍ","لَعوبٍ تُنَسّيني إِذا قُمتُ سِربالي",28,"ل",2,0],["وَمِثلُكَ مِن طُلّابِها خَلصَت لَهُ","وَقارُكَ مَرضِيٌّ وَرَبعُكَ جَحفَلُ",29,"ل",1,0],["وَمُثَقَّفٍ ثَبْتٍ وَنَدْبٍ حُوَّلٍ","يَتَتَبَّعُ الشُّبُهَاتِ فِي تَجْوَالِهَا",30,"ل",3,0],["وَمِثْلُهَا يُدْهِشُ فِي صَائِدٍ","لُلأُسْدِ مِنْ كُلِّ حِمىً لا يُرَامْ",31,"م",1,0],["وَمِثْلُكَ مَنْ تَوَرَّدَهَا عَيُوفاً","وَمِثْلُكَ مَن جَلا عَنْهَا كَرِيمَا",32,"م",2,0],["وَمِثلُ الحَمامِ الوُرقِ مِمّا تَوَقَّدَت","بِهِ مِن أَراطي حَبلِ حُزوى إِرينُها",33,"ن",3,0],["وَمِثلِ فَوارِسٍ مِن آل جَلٍّ","إِذا ما الحَربُ رَفَّعَتِ الإِزارا",34,"ر",2,0],["وَمِثلَكَ قَد قَصَدتُ لَهُ فَأَمسى","أَخا حِلمٍ وَما هُوَ بِالحَليمِ",35,"م",1,0],["وَمِثلُكَ مَعدومُ النَظيرِ مِنَ الوَرى","وَشِعرُكَ مَعدومُ الشَبيهِ مِنَ الشِعرِ",36,"ر",1,0],["وَمِثلُ أَبي فِراسٍ مَن تَجافى","لَهُ عَن فِعلِهِ مِثلُ الأَميرِ",37,"ر",1,0],["وَمِثلي أَطاقَ وَلَكِنَّني","أُكَلِّفُ نَفسي الَّذي آدَها",38,"د",3,0],["ومثلي ما لعشقتهِ هدوّ","يرامُ ولا لسلوتهِ اهتداء",39,"ا",2,0],["ومثلي من بكى لفراقِ بابٍ","علائيّ الفعالِ المستجاده",40,"د",2,0],["ومثلك من أسدى لمثلي أنعماً","تسرّ وآفاق البلاد تذيعها",41,"ع",3,0],["ومثلك إما للسرير منعماً","يثوب وإما للجواد مطهما",42,"م",2,0],["ومثلك من حلَّت أياديه حسنها","فزادَ وثنى حظّها فتكمَّلا",43,"ل",2,0],["ومثل المستهام أخي التصابي","شجت أطلالها الدرس المثولُ",44,"ل",1,0],["ومثلي رأى الحُسنى بعينٍ جَليَّةٍ","وأغضى عن العوراء غيرَ مُؤنِّبِ",45,"ب",1,0],["ومثليَ محتاجٌ إلى ذي سماحةٍ","كريمِ السجايا أريحيِّ الضرائبِ",46,"ب",1,0],["ومثلُكُمْ خُصَّ بأمثالِهِ","ومثلُكُمْ عن مثلِهِ ثَوَّبا",47,"ب",2,0],["ومثل امرئٍ أفنى مطالك عمرَهُ","كفاه لعمري مثل نائلك النزرِ",48,"ر",1,0],["ومثلك في النُّوك قد كادني","فأصبح ذا عملٍ حابِطِ",49,"ط",1,0],["ومثلُك من لم يُلْقَ في ثوبِ بِذْلةٍ","ولا مَلْبسٍ قد دنَّسَتْه المطامع",50,"ع",1,0],["ومثلك اختار مثله وكذا","من كان بالمسلمين ذا لطف",51,"ف",1,0],["ومثلك لا يُدَل على رشادٍ","كفاك بلمحةٍ من ناظريكا",52,"ك",2,0],["ومثلُك يمنحُني فضلَهُ","ولكنَّ مثليَ لا يَمْنحُكْ",53,"ك",1,0],["ومثلك يا أبا حسنٍ حقيقٌ","بصَوْني عن فراقك واعتقالي",54,"ل",2,0],["ومثلُكَ منْ لم يُلْقَ في عرْضِ بِذْلَةٍ","وما عذرُ منْ يلقاك والعرضُ أدْسَمُ",55,"م",1,0],["ومثلك لا يَستحسنُ البُرْدَ ملبساً","إذا كان من إحدى نواحيه مُعلَما",56,"م",2,0],["ومثل أبيه الخير أعقبَ مثله","سقى الله هاتيك العظام الرَّمائما",57,"م",2,0],["ومثلك لا يحتجُّ والخَصْمُ ساغِبٌ","ولكنّهُ يحتجُّ والخصم طاعمُ",58,"م",1,0],["وَمِثلُ السَدوسِيَّينِ سادا وَذَبذَبا","رِجالَ الحِجازِ مِن مَسودٍ وَسائِدِ",59,"د",1,0],["وَمِثلُ اللَآلي لا يَخيسُ جَمالُها","وَإِن هِيَ لَم تُرصَف وَلَم تَنتَظِم عَقدا",60,"د",2,0],["وَمَثَّلوا الفَضلَ وَآياتِهِ","كَي يَستَزيدَ الرَجُلُ الفاضِلُ",61,"ل",1,0],["وَمِثلُ حَظِّ السَروِ مِن فَيإِهِ","وَالطَيرِ مِن تَغريدِها المُتقَنِ",62,"ن",1,0],["وَمِثلُ حَظِّ النَجمِ مِن نورِهِ","في الحِندِسِ المُعتَكِرِ الأَدجَنِ",62,"ن",1,0],["وَمِثلي وَلِيٌّ هَزَّ عِطفَيكَ مَدحُهُ","وَإِن شِئتَ سَلمانٌ وَإِن شِئتَ حَسّانُ",63,"ن",1,0],["وَمِثلُكَ لا يَأسى عَلى فَقدِ كاتِبٍ","وَلَكِنَّهُ يَأسى عَلَيكَ وَيَندَمُ",64,"م",1,0],["ومثل عبد اللطيف يُبكى","ويتبع الذكر والثناء",65,"ا",2,0],["ومثلك من يضيق الرحب عنه","ويحمله على السعة الضمير",66,"ر",1,0],["ومثله فلكان","فيما رأى اليونان",67,"ن",1,0],["وَمِثلُكَ يُرثى بِآيِ الكِتابِ","وَمِثلُكَ يُفدى بِنِصفِ البَشَر",68,"ر",1,0],["وَمِثلُ ما قَد أودِعَت مِن حُلىً","لَم تَتَّخِذ داراً وَلَم تُحشَدِ",69,"د",1,0],["وَمِثلُهُ أَنكَرَ المَماتَ عَلى","غَيرِ سُروجِ السَوابِحِ القودِ",70,"د",1,0],["وَمِثلِ العَمقِ مَملوءٍ دِماءً","جَرَت بِكَ في مَجاريهِ الخُيولُ",71,"ل",1,0],["وَمِثلُ الَّذي دُستَهُ حافِياً","يُؤَثِّرُ في قَدَمِ الناعِلِ",72,"ل",1,0],["وَمِثلُكَ لا يُبكي عَلى قَدرِ سِنِّهِ","وَلَكِن عَلى قَدرِ المَخيلَةِ وَالأَصلِ",73,"ل",1,0],["وَمِثلُكَ مَن كانَ الوَسيطَ فُؤادُهُ","فَكَلَّمَهُ عَنّي وَلَم أَتَكَلَّمِ",74,"م",1,0],["وَمِثلُكَ يُؤتى مِن بِلادٍ بَعيدَةٍ","لِيُضحِكَ رَبّاتِ الحِدادِ البَواكِيا",75,"ي",2,0],["ومثلُكَ لا يرضَى بتضييعِ خدمتي","وتخييب آمالٍ لديهِ طِوالِ",76,"ل",1,0],["وَمِثلُ أَبي النَجمِ المُهَذَّبِ فِعلُهُ","رَثى لِمَشوقٍ أَو أَوى لِغَريبِ",77,"ب",1,0],["وَمِثلُكَ حاطَ المُسلِمينَ بِمِثلِهِ","سَداداً وَلَم يُهمِل رَعِيَّتَهُ سُدى",78,"د",2,0],["وَمِثلُ نَداكَ أَذهَلَني حَبيبي","وَأَكسَبَني سُلُوَّن عَن بِلادي",79,"د",2,0],["وَمِثلُكَ أَعطى مِثلَهُ لَم يَضِق بِهِ","ذِراعاً وَلَم يَحرَج بِهِ أَو لَهُ صَدرُ",80,"ر",1,0],["وَمِثلُكَ أَعطاها وَأَضعافَ مِثلَها","وَلا غَروَ لِلبَحرِ اِنبَرى يَتَدَفَّقُ",81,"ق",1,0],["وَمِثلُكَ إِن أَبدى الفَعالُ أَعادَهُ","وَإِن صَنَعَ المَعروفُ زادَ وَتَمَّما",82,"م",2,0],["وَمِثلُكِ قَد أَعطى سُلَيمانُ بُلغَةً","إِلى المَجدِ لَو أَعطى سُلَيمانُ مُنعِما",83,"م",2,0],["وَمِثلَكِ قَد أَتعَبتُ حَتّى أَنَختُها","إِلى حَيثُ أَثرَت مِن قُصَيٍّ رِجالُها",84,"ل",3,0],["وَمِثلُكَ قَد أَبطَرتُهُ قَدرَ ذَرعِهِ","إِذا نَظَرَ الأَقوامُ كَيفَ أُراجِمُه",85,"م",2,0],["وَمِثلُكَ مُقرِفُ الطَرَفَينِ عَبدٌ","صُفِعتَ عَلى النَواظِرِ وَالبَنانِ",86,"ن",1,0],["وَمُثَقَّفٌ مِمّا بَرى مُتَمالِكٌ","بِالسَيرِ ذو أُطُرٍ عَلَيهِ وَمَنكِبُ",87,"ب",1,0],["وِمثلِيَ لاقى الهَولَ في مُفظِعاتِهِ","وَفَلَّ لَهُ الجَيشُ الخَميسُ العَطَبطَبُ",88,"ب",1,0],["وَمِثلُكَ لا يُدَلُّ عَلى صَوابٍ","وَأَنتَ تُعَلِّمُ الناسَ الصَوابا",89,"ب",2,0],["وَمِثلُ عُلاكَ نورَ الدينِ مَن لا","يُقَلقِلُ قَبلَهُ نُوَبٌ تَنوبُ",90,"ب",1,0],["وَمِثلُكَ مَن قَبِلَ الإِعتِذارَ","وَصَدَّقَ قَولَ المُحِبُّ الوَلي",91,"ل",2,0],["ومثَّلَ في القفر لغزَ الحِمام","لم نكتشف سره الأعمقَا",92,"ق",2,0],["ومثَّلَ فيه عتوَّ الدهور","لن تستباح ولن تخلقَا",92,"ق",2,0],["وَمَثّلَ للصّبّ في نومِهِ","ضجيعاً إذا أرّقَ الصّبَّ ناما",93,"م",2,0],["وَمِثلُ قُوى حَبلِ تِلكَ الذِراعِ","كانَ لِزازاً لِذاكَ الرِشاءِ",94,"ا",2,0],["وَمِثلُهُ ذو العُنُقِ السَبطِ قَد","أَمطَيتَهُ وَالكَفَلِ المَرمَريس",95,"س",1,0],["وَمِثلِكَ قَد خَوَّلتُهُ المَدحَ جازِياً","وَإِن كُنتَ لا مِثلٌ إِلَيكَ وَلا نِدُّ",96,"د",1,0],["وَمِثلُكَ مَن لا تُوحِشُ الرَكبَ دارُهُ","وَلا نازِلٌ عَنها إِذا نَزَلَ الوَفدُ",97,"د",1,0],["وَمِثلَها يَمَّمَت ذاتَ العُشيرَةِ في","جَيشٍ لُهامٍ كَمَوجِ البَحرِ مُلتَطِمِ",98,"م",1,0],["ومثلُكَ لا يرضى لمثليَ بالقُرى","وفي النفسِ حاجاتٌ وفي سيدي جبرُ",99,"ر",1,0],["ومثل خيمتكِ الدكناءِ فارهةً","كانت ترِفُّ على رملٍ صَوارينا",100,"ن",2,0],["وَمِثلي هَزَّ مِثلَكَ ثُمَّ أَصغى","عَلى ثِقَةٍ يُصيخُ إِلى مُجيبِ",101,"ب",1,0],["وَمِثلُ شُكري عَلى تَقَبَّلِهِ","يَجمَعُ بَينَ النَسيمِ وَالزَهرِ",102,"ر",1,0],["وَمِثلُكَ مَدَّ يَمينَ النَدى","بِعَلقٍ يُطيلُ عِنانَ النَظَر",103,"ر",1,1],["وَمُثَقَّفٌ لَدنُ المَهَزِّ يَشوقُهُ","ما شاقَني فَإِذا هَزَزتُ تَأَطَّرا",104,"ر",2,0],["وَمِثلِيَ يَبكي لِلمُصابِ بِمِثلِهِ","فَإِن أَخلَقَ الصَبرُ الجَميلُ فَأَخلِقِ",105,"ق",1,0],["وَمُثَقَّبٍ وارٍ يُريكَ مُضيئُهُ","في الداجِياتِ مِنَ الأُمورِ شِهابا",106,"ب",2,0],["وَمِثلُكَ يَملأ كَفَّ المُقِيمِ","وَيَنهَضُ مِن قَدَمِ الرَّاحِلِ",107,"ل",1,0],["وَمِثلِي كَثَكلَى فَارَقَت أنسَ حِبِّهَا","وَمِثلِيَ مُوسَى فَارَقَتهُ المَرَاضِعُ",108,"ع",1,0],["ومثيرَها شَعْواءَ أي","يوبيَّةَ الخيْلِ الهِجانِ",109,"ن",1,0],["وَمِثلُك ناحَت عَلَيهِ النِسا","ءُ مِن بَينِ بَكرٍ إِلى ناكِحَه",110,"ح",2,0],["وَمِثلُهُ مِن كِلابٍ في أَرومَتِها","يُعطى المَقاليدَ أَو يُلقى لَهُ السَلَمُ",111,"م",1,0],["ومثلُك يدعو المرهَفَ العضْبَ عزمُه","وتدعُو هواه كلَّ مُرهَفَةِ الخَصر",112,"ر",1,0],["ومِثلُكَ مَن أرضَى الخليفةَ سعيُهُ","فإن رضيَ المولى فقد نَصَحَ العبد",113,"د",1,0],["وَمِثلِكَ قَد سَيَّرتُهُ بِقَصيدَةٍ","فَسارَ وَلَم يَبرَح عِراصَ المَنازِلِ",114,"ل",1,1],["وَمِثلُ وَرقاءِ زُهَيرٍ مَضَت","وَرقاءُ تَعلو زَهراً بَينَ أَيك",115,"ك",1,0],["وَمِثلانِ زَيدُ الخَيلِ فيكُم وَغَيرُهُ","وَسَيّانَ قُسٌّ في الكَلامِ وَباقِلُ",116,"ل",1,0],["وَمِثلَ اِبنَ غَنمٍ إِن ذُحولٌ تُذُكِّرَت","وَقَتلى تَياسٍ عَن صَلاحٍ تُعَرِّبُ",117,"ب",1,0],["وَمِثلَهُم مِن بَنِي عَبسٍ تَدُقُّهُمُ","دَقَّ الرَحَى الحَبَّ إِدباراً وَإِقبَالا",118,"ل",2,0],["وَمِثلُ الدُمى شُمُّ العَرانِينِ ساكِنٌ","بِهِنَّ الحَياءُ لا يُشِعنَ التَّقافِيا",119,"ي",2,0],["ومثل العمق مملوءاً دماءً","مشت بك في مجاريه الخيول",120,"ل",1,0],["ومثّل الزيّف من حياةٍ","مرقع ثوبها القشيبُ",121,"ب",1,0],["ومثلما قدَّرْتَ صوَّرتَها","فروحكَ الصوتُ وروحي الصدَى",122,"د",2,0],["ومثَّل لي سمعي خُطاكَ فخِلتُها","صَدَى نبأٍ من عالم الغيبِ صادرِ",123,"ر",1,0],["ومِثلُكَ للأصادِقِ مُستَقِيد","وشَرُّ الخيْلِ أصْعبُها قِيادا",124,"د",2,0],["ومُثْكِلُ فرْسانِ الوَغى كلَّ نَشْرَةٍ","يَوَدّ خَلِيجٌ راكِدٌ لو يَكُونها",125,"ن",3,0],["ومثلُ ذاك جائزٌ في الحشْوِ","فنَحوُ هذا غيرُ ذاكَ النَّحوِ",126,"و",1,0],["ومثلهُ المَعروفُ بالمَقْطوفِ","لولا سكونُ آخرِ الحُروفِ",126,"ف",1,0],["ومثله المُسبغُ من هذي العِللْ","حَرْفٌ تَزيدهُ على شطْرِ الرَّملْ",126,"ل",1,0],["وَمِثْلُكَ مَنْ رَازَ الأُمُورَ بِعَقْلِهِ","وَأَدْرَكَ مِنْهَا مَا يَضُرُّ وَيَنْفَعُ",127,"ع",1,0],["وَمِثَالٌ مِنَ الجَّمَالِ بَدِيعٌ","حَارَ فِيهِ النَّثِيرُ قَبْلَ النَّظِيمِ",128,"م",1,0],["وَمِثْلُكَ في بَنِيهَا مَنْ يُرَجَّى","فَحَقَّقْ مَا لَها بِكَ مِنْ رَجَاءِ",129,"ا",2,0],["وَمِثْلُ رِجَالٍ فيهِمُ لَمْ أُسَمِّهِمْ","وَكَمْ مِنْ نجيبٍ في طوائِفِهِمْ شِمْرِ",130,"ر",1,0],["ومثلكَ مَن جَنَى ثَمرَ الأمانِي","وآتى حَقّه يَومَ الحصادِ",131,"د",1,0],["ومثلُكَ مَنْ ردّ العقُولَ لمنهجٍ","سديدٍ وأرْدَى الشك بالمنطقِ الحسْمِ",132,"م",1,0],["ومثِّلي مصرَ والشَأوَ الذي بلغَتْ","فأنتِ أصْدَقُ بُرهانٍ لدَعْواها",133,"ا",3,0],["ومثلُكَ يملأُ كلَّ فراغٍ","ويقطعُ حجَّةَ «أَيْزِنْهَوَر»",134,"ر",1,0],["ومثلك قد يرديه بالخب ثعلب","ولكنه يروي الأسود الضواريا",135,"ي",2,0],["ومثالاً من نهضة الشرق؛ حتى","يُؤمنَ الغرب بعد طول الجحود",136,"د",1,0],["ومثلُكَ من مَحا الطبقاتِ محوًا","ومن ساوى المُسوَّدُ بالمَسُود",137,"د",1,0],["ومثلك من يرمي بهمته العلا","ويرفع أعلام الثناء المجدد",138,"د",1,0],["ومثلُ قصيدٍ جسَّدَ الحزنَ رائعاً","قصيدٌ بتجسيدِ المسراتِ زاخر",139,"ر",1,0],["وَمِثْلُكَ قَدْ أَعْطَى سُلَيْمَانَ بُلْغَةً","إلى المَجْدِ، أوْ أعطى سُلَيْمَانَ مُنْعِمَا",140,"م",2,0],["ومثلُ الّذي تولونني في بيوتمك","يُقنّي سِناناً، كالقُدامى ، وَثَعّلَبَا",141,"ب",2,0],["ومثلي … أنا صرت عبد العبيد","وأنت لكلّ الجواري وصيفه",142,"ف",2,0],["ومثّل لي سمعي فخلتها","صدى نبإ من عالم الغيب صادر",143,"ر",1,0],["ومثلك من يعلو عن البغي طبعه","ويكرم احبابا ويرحم اصحابا",144,"ب",2,0],["ومثلك سيدي للعفو أهل","ومثلي من يساعده الكرام",145,"م",1,0],["ومثل نسيم الصبح أنت سماحة","يقبل ما يبدو له ويبرد",146,"د",1,0],["ومثلُك لا ينسَى وإن طالت المَدى","ولا ينكرُ الشىءَ الذي هو عارفُ",147,"ف",1,0],["وَمِثلُ ذَا بَقَعُ في نَكِرَةِ","مَوصُوفَةٍ بَأَحَدِ الثَّلاثَةِ",148,"ه",1,0],["ومثلي لا تروّعه الدياجي","ولا يخشى مكافحةَ الرجالِ",149,"ل",1,0],["ومثلك من يرجو الأسيرُ فِكَاكَه","ولو كان في جَور الليالي مقيَّدا",150,"د",2,0],["وَمِثلُكَ لا يَضِلُّ الحَزمُ عَنهُ","فَهَل أَنباكَ بِالصَدَرِ الوُرودُ",151,"د",1,0],["ومثلثٌ شام الحسام بكفِّه","والموت يمسح جانبيه فهللا",152,"ل",2,0],["وَمِثلي لا يُدلي بِصالِحِ كَسبِهِ","وَلَكِن بِحُبِّ في سُوَيداءِ قَلبِهِ",153,"ه",1,0],["ومثلك مأمون على الخلق إن سطا","فبالفضل أن يضحك وبالعدل إن ابكا",154,"ك",2,0],["ومثلك لا يؤذى ولكنهم لهم","إِلى ربهم في دينه ذلك الحرمُ",155,"م",1,0],["ومثل صلاح الدين من وهب المنا","ورد المعالي النافرات إلى الوكر",156,"ر",1,0],["ومثلك لم يكن فيما سمعنا","من الزمن القديم ولا يكون",157,"ن",1,0],["وَمِثلُ ذَلِكَ أَضعافاً مُضاعَفَةً","أَعطى وَقالَ قُصارى كُلِّ ذي العَطَبُ",158,"ب",1,0],["وَمِثلَكَ مَن حُقَّ التَأسُّفُ بَعدَهُ","وَغَيركَ مَخلوفٌ وَمِثلكَ يُعدمُ",159,"م",1,0],["وَمِثلُكَ مَن لا يَبلغِ المَدحَ وَصفُهُ","وَلَو أَسهَب المُثنِي عَلَيكَ وَأَبدَعا",160,"ع",2,0],["وَمثلُ نَسيبٍ أَهلُ كلِّ مَزِيَّةٍ","يَزيد بِها فَخَراً وَيَعتَزُّ سُؤدُدا",161,"د",2,0],["ومثبّتي من بعدما","زاغت لبانات الفقيه",162,"ي",2,0],["وَمثلَهُما النعمانُ قال بفسقهِ","بِلا قتلهِ لكنّه يحبسُ الدَهرا",163,"ر",2,0],["ومثلك أهديه القريض مهذّبا","ولم لا وأنت الراقصات قوافيه",164,"ي",2,0],["ومثلهم لنا الكفرا","وي والصبانُ والفرا",165,"ر",2,0],["ومثلي فتى الدنيا الذي إن مشوا بهِ","إلى القبرِ يطوي مآثرهُ القبرُ",166,"ر",1,0],["ومثل واو ألف وما يلي","أتى مزيداً نادراً كعبدل",167,"ل",1,0],["ومثلُكَ لا يبيع أخاً ببخسٍ","على حال ومثلي لا يباعُ",168,"ع",1,0],["ومثلَ ما قلتُ قال القوم كلّهمُ","نقول ذلك إعلاناً وإسرارا",169,"ر",2,0],["ومثلِها من الظِباء العُفْر","فطِرْن كالبرق خِلاَل القَطْر",170,"ر",1,0],["ومِثلُك من يزداد عُقْدُ إخائه","وفاءً إذا لم يَبقَ خِدْنٌ على عَقْد",171,"د",1,0],["ومثلكُ من لم يَرْضَ بالغدر شيمةً","ولم ينصرف مذ كان عن طاعة المجد",172,"د",1,0],["وَمِثلُكَ ما رَأَينا في البَرايا","حَبيباً فِعلُهُ فِعلُ الأَعادي",173,"د",2,0],["وَمثتاق إِلى غَير","أُهيلَ الحَيِّ لا يَصبو",174,"ب",2,0],["وَمُثقَلَةٌ بِالحَلِ سَوداءُ حُرَّةٌ","عِراقِيَّةٌ بَحرِيَةٌ أُمُّ أَطفالِ",175,"ل",1,0],["وَمِثلُكَ مَن أَولى الجَميلَ وَأَفضَلَت","مَواهِبُ كَفَّيهِ عَلى الفُضَلاءِ",176,"ا",2,0],["وَمُثْمِرَةٍ بِعُيُونِ الظِّبَاءِ","تَحَلَّتْ بِسُنْدُسِ أَوْرَاقِهَا",177,"ه",2,1],["ومثل ذا منّي لكم على المدى","به تنالون الأمان والندى",178,"د",2,0],["ومثلك لمياء الثنايا علقتها","وفارقتها سرى خيالٍ لحالم",179,"م",1,0],["ومثلك من ازال الزيف عنها","وزان بها معانيها وزادا",180,"د",2,0],["ومثلَ غصنٍ رنحته الصَّبا","جرَّرَتِ الذَّيلَ على المرمر",181,"ر",1,0],["ومثَّلنَ لي طيفَ الفتوَّةِ باسماً","يمدُّ لضمّاتِ المعاطفِ أذرعا",182,"ع",2,0],["ومثلَ شَتبريانَ في سَفَراتِه","شَقيتُ ومن أسفارِنا بقي السَفر",183,"ر",1,0],["وَمثل حَنين الجذع سجدة سرحة","وانس غَزال البر وَهي نفور",184,"ر",1,0],["ومثله ما رأت عبر وَلا سمعت","وَلا به نطقت في الكون أَفواه",185,"ا",2,0],["وَمَثْواهُ بِدَارِ المُلْكِ فَوْزٌ","بِصَفْوِ العَيْشِ وَالبالِ الرَّخِيِّ",186,"ي",1,0],["وَمُثَقَّفٍ ذَلِقِ السِّنانِ تَخَالُه","في السّرْدِ يَخْرُقُ جَانِبيهِ مُسرِّدا",187,"د",2,0],["وَمِثْلُكَ لا تَجُودُ بِهِ اللَّيالِي","وَلكِنْ رُبَّما سَمَحَ الْبَخِيلُ",188,"ل",1,0],["وَمِثْلُكَ حَلَّ بَذْلُ الْجُودِ مِنْهُ","مَحَلَّ هُوى الْحَبِيبِ مِنَ الْمُحِبِّ",189,"ب",1,0],["وَمُثَقَّفٍ قَدْ كَانَ قَبْلَ طِعانِهِ","تَنْدَقُّ أَكْعُبُهُ بِصَدْرِ طَعِينِهِ",190,"ن",2,0],["وَمِثْلُكَ لا يُعْطِي الدُّمُوعَ قِيادَهُ","وَلَوْ أَنَّ إِدْمانَ الْبُكا لَكَ َأرْوَحُ",191,"ح",1,0],["وَمِثْلُكَ يَا مُحَّمدُ سَاقَ جَيْشاً","يُكَلِّفُ نَفْسَ رَائِيهِ السِّيَاقا",192,"ق",2,0],["وَمثَّلوا بالجَسَد","وَالروحِ ذي التجرُّدِ",193,"د",1,0],["وَمِثلُك من لم ينسَ عَهداً وإنَّما","هوَ الدَهرُ لا يُلفى على الدَهر ناصرُ",194,"ر",1,0],["وَمثَّلْنكِ للقلبِ","فَهامَ وَلجَّ بالحبِّ",195,"ب",1,0],["وَمِثلُكَ مَن يبيحُ له قبولاً","يُشاكل حُسن منزعه الخفيفِ",196,"ف",1,0],["وَمثلك يُرجى حين يخشى اِمتنانه","فإنّك للأحرى بذي كرمٍ أصبا",197,"ب",2,0],["وَمَثَّلَ في حافاتِها كُلَّ مَثلَةٍ","كَفِعلِ كِلابٍ هارَشَت ثُمَّ شَمَّرا",198,"ر",2,0],["وَمِثلُكَ أَحرى بِالتَقَدُّمِ وَالعُلا","وَأَيُّ خَبيرٍ لا يُقَدِّرُ إِجلالَك",199,"ك",1,0],["وَمَثاني السُرورِ قَد أَرخَتهُ","طابَ حَظٌّ بَدا يَعودُ الدَريني",200,"ن",2,0],["ومثل شهقات سراب يموت","كانت خطاها فوق وجه الطريق",201,"ق",1,0],["ومثل شهقات سراب يموت","راحت خطاها وهي تطوى الطريق",201,"ق",1,0],["وَمِثلُ سَراةِ قَومِكَ لَم يُجارَوا","إِلى رُبُعِ الرِهانِ وَلا الثَمينِ",202,"ن",1,0],["وَمُثقّفٍ شَرِبَ الدِّماءَ وَهَزَّ من","أَعطافهِ فَكأَنَّهُ مخمُورُ",203,"ر",1,0],["وَمَثَّلَ لي الحَقيقَةَ في خَيالٍ","كَما في النورِ يَحكي الشَخصَ ظِلُّ",204,"ل",1,0],["وَمِثلُ جَميلِ ذِكرِكِ ما سَمِعنا","وَمِثلُ جَزيلِ بَرِّكِ ما رَأَينا",205,"ن",2,0],["وَمثلما رفعَ القيانُ له","عَضُدَيهِ حَولَ البَيتِ بالفأسِ",206,"س",1,0],["وَمِثلها إِلى الإمام الأَوحَد","القادري الزغبيّ بَدر السُؤددِ",207,"د",1,0],["وَمِثلُكَ ما يَنبَغي اِن يَصد","وَيَهجر صبا لَه قَد أَحب",208,"ب",1,0],["ومثْلُك مَن لا يَشْتري حَمْدَ ناظمٍ","ولا ناثرٍ إلاّ بأوفَرِ أثْمان",209,"ن",1,0],["ومثْلُ اخْتيارِكَ للصّلبِ ال","مُؤيّدِ ما عَهِدَ العاهِدونا",210,"ن",2,0],["ومثْلُكَ للورى مَن سَنَّ صَبْراً","لأنّك سابِقٌ والخَلْقُ تَال",211,"ل",1,0],["ومثْلُ وجيهِ المُلْكِ في عُظْمِ قَدْرِه","وما قُلْتُها من حيثُ أنّ له مِثْلا",212,"ل",2,0],["ومِثالُ مَوعظتي لِمثلِكَ قَطْرةٌ","من ديمةٍ تُسقَى بها دَأماء",213,"ا",2,0],["ومِثلَ زُبَيدٍ حين يشتجرُ القَنا","وقد قُلِبَت تحتَ السُروج لُبودُها",214,"د",3,0],["وَمِثلُكَ مِن قَبلِ المَسائِلِ واهِبٌ","وَلَكِنَّهُ بَعدَ الجَرائِمِ يَصفَحُ",215,"ح",1,0],["ومثلك يُولي فضله وهو شاكر","ويُسعفُ بالعُتبى وما خاف من عَتب",216,"ب",1,0],["ومثلُ إمامِ الدِّين يأتي صَنيعُهُ","ومثلكَ يا بكجورُ تأتي الصَّنائِعُ",217,"ع",1,0],["ومثقفٌ سبطُ الكعو","بِ إذا ركِبت به تجعَّد",218,"د",1,0],["وَمِثلي خَليق أَن يَذوب فُؤادَهُ","إِلى مثلَكُم شَوقاً وَذاكَ يَسيرُ",219,"ر",1,0],["وَمِثلي مَن يَذوب إِلَيكَ شَوقاً","وَمثلك سَيدي يَصبي القُلوبا",220,"ب",2,0],["ومُثقّل وافي مقامَ جماعةٍ","فيه السّقَاة تطوفُ بالكَاسَاتِ",221,"ت",1,1],["ومُثقّل يكفيكَ منه أنّه","أضحَى يخف لديه كلّ مثقّل",222,"ل",1,1],["ومثقّل وافاهُ يومُ حمامِه","في غفلةٍ وكذا الحياةُ غرورُ",223,"ر",1,1],["ومثقّفٌ ماضي السِّنانِ","لأنفُسِ الأَبطال سالِبْ",224,"ب",1,0],["ومثلكَ من يُرجَى لكلِّ عظيمةٍ","ومثلي عَلى ما أرتجيه يُعانُ",225,"ن",1,0],["ومثلك لا يراع لهول خَطْبٍ","وإن صار الصبور به جَزوعا",226,"ع",2,0],["ومثلك لا ينسى وإن حل في الثرى","فشخصك في إنسان عيني وفي لبي",227,"ب",2,0],["ومثلُكَ يلقى عندَ حادِثِ هَفْوَةٍ","بخفضِ جَناحٍ والثراسفاحُ",228,"ح",1,0],["ومثلك إن تطلبه خبير","بهذا الخلق ليس بمستفاد",229,"د",1,0],["ومثلُكَ من يجودُ بما لديه","ويسخو بالكثير من القليل",230,"ل",1,0],["ومثلك من يُدعى لكلِّ مُلِمَّةٍ","من الدهر مقدام على نوب الدهر",231,"ر",1,0],["ومُثَلَّثِ الأَضْلاَعِ أَعْيَى سَلاسَةً","مِنْ قَبْلُ رَسْطَالِيسَ وَالإِسْكَنْدَرَا",232,"ر",2,0],["ومثلُكَ بالوزارةِ ذو اضطلاعٍ","على من جاد فيها ذو اطلاعِ",233,"ع",1,0],["ومثلُك من تقلّد بالمعالي","فريداً حالياً منها فريدا",234,"د",2,0],["ومثلُك من تلبّيه الأماني","رُكوعاً حولَ كعبتِه سُجودا",234,"د",2,0],["ومثلُك لا يرضى بكوني ظامئاً","ومنهلُ جدواهُ هو الباردُ العذبُ",235,"ب",1,0],["ومثلُك حامي همّةٍ وأئمةٍ","لها الملأ الأعلى حمًى والملائكُ",236,"ك",1,0],["ومثلُكَ في انفرادِك بالمَعالي","تعالى أن نُصيبَ له مِثالا",237,"ل",2,0],["ومثلُك ملء عينِ الدهرِ حُسْناً","وملء قلوبِ أهليهِ جَلالا",237,"ل",2,0],["ومثلُك مَنْ رأى لهمُ اعتداءً","فقابلَهُ برحمَتِه اعتِدالا",237,"ل",2,0],["ومثلك من يصغي لمثلي وردهُ","ليعلم ما عندي له ويحقّق",238,"ق",1,0],["ومُ