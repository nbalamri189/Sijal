ُكمِهِ الكبْتُ",266,"ت",1,0],["ومثقّفٍ حطَمَ الحِمامُ كُعوبَه","فبكى عليهِ كلُّ لَدْنٍ أسْمَرا",267,"ر",2,0],["وَمِثلي في رِجالِكم قَليل","وَمثلك لَيسَ يُعدَم في النِساءِ",268,"ا",2,0],["ومثل الماء يروي منه قصدٌ","ويقتل منه بالغرق المزيدُ",269,"د",1,0],["ومِثْلُه المغَفّلُ","رَوى لَنَا ما نَقَلُوا",270,"ل",3,0],["ومِثْلُهُ عَنْ مَيْسَرَهْ","رِوايَةٌ مُشْتَهِرهْ",270,"ه",1,0],["ومِثْلُ هَذَا الْوَصْفِ","مُقَدَّمق في الصَّفِّ",270,"ف",1,0],["ومثلُكَ مَن باللُّطفِ رَقَّ شَمائِلاً","إلى أَن تَوارى عن غَبِيٍّ مَقَامُهُ",271,"م",2,0],["ومثلُه مِثلُ القَضَا","في سَيرِهِ لَم يُحجَبِ",272,"ب",1,0],["ومثلُ مثولك بين الرّجال","ثناؤك في المجلس الحافلِ",273,"ل",1,0],["ومثلُك من يولِي الحقوقَ رعايةً","وغيرك لا يَرعى ولا يتعطّفُ",274,"ف",1,0],["ومثلُك من قد كنتُ قبل وصالهِ","أَحِنُّ اِشتِياقاً نحوه وأنازعُ",275,"ع",1,0],["وَمثلُكَ أَهدى أنْ يعادَ إلى الهُدى","وأَرشدُ أنْ ينحازَ عن جهةِ القَصْدِ",276,"د",1,0],["ومُثْقَلَةً كؤوداً لا تُرادى","وداهيةً صموتاً لا تُناجى",277,"ج",2,0],["وَمُثقّفٍ مثلِ القنا","ةِ أتى المنيّةَ بالقناةِ",278,"ه",1,0],["وَمُثرٍ مِنَ المَعروفِ وَالبَأسِ وَالنَدى","عَديمٌ مِن السَوءاتِ وَالبُخلِ مُصرِمُ",279,"م",1,0],["ومثلها أسماؤه الحسنى علت","وعلمه المحيط بالبريه",280,"ي",2,0],["ومثلُه شعرُ زين العابدين أتى","يا ربَّ جوهرِ علمٍ قولَ منظوم",281,"م",1,0],["ومِثلُكَ مَن يَقِلُّ الدَّمعُ فيهِ","ولو أنَّ السَّحابَ لهُ مَسِيلُ",282,"ل",1,0],["ومثلُ البَدرِ إشراقاً وحُسناً","ومِثلُ الغَيثِ جوداً وابتِذالا",283,"ل",2,0],["ومثلُكَ لا يضيعُ فتىً لديهِ","وها أنتَ الأَمينُ على العبادِ",284,"د",1,0],["وَمِثْلَ الأَفَاعِي إِذَا أُلْهِبَتْ","حَرِيْقَاً مَخَافَةَ دِرْيَاقِهَا",285,"ق",3,0],["وَمُثَقَّلِ الأَرْدَافِ يَشْخَصُ عَنْ","أَرْدَافِهِ وَنُهُودِهِ المِرْطُ",286,"ط",1,0],["وَمِثْلَكَ قَدْ صِرْتُ رَسْمَاً عَفَا","فَقِفْ بِي وَلاَ تَجْفُنِي يَاعُمَرْ",287,"ر",1,0],["ومَثَّلَهُ لي المُنى","فَرُحْتُ بِهِ ظافِرَا",288,"ر",2,1],["ومثلي يرى شرْبَ الدِّماءِ محلَّلا","وشربَ دمِ الصهباءِ غيرَ محلَّل",289,"ل",1,0],["وَمُثَقَّفاتٍ ذُبَّلاً","حُصداً أَسِنَّتُها تَأَلَّق",290,"ق"