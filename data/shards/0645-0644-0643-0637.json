{"poems":[[63,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[68,"مثل التيمم للصعيد","https://www.aldiwan.net/poem40959.html","مجزوء الكامل"],[443,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62464","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120080","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76676","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48264","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130821",""],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101595","الخفيف"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130608","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59513","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33731","البسيط"],[5351,"شيماء","https://www.poetsgate.com/ViewPoem.aspx?id=202239",""]],"verses":[["مَلِكٌ طاعَه الحُتوفُ فلو شا","ءَ لبَثَّ الحُتوفَ والآجَالا",0,"ل",2,0],["مَلِكٌ طَويلُ يَدِ السَماحِ","قَصيرُ أَعمارِ الوُعودِ",1,"د",1,0],["ملك طاب فرعهُ ونماء ال","فرع ينبئك عن نماء العروق",2,"ق",1,0],["ملك طالما تمناه تاج","ورتاج ومنبر وسرير",3,"ر",1,0],["ملكٌ طَائِعٌ لِباريه لا ين","فَكُّ فِيه قِيامُه وقُعودُه",4,"د",2,0],["مَلك طَلْق المحيَّا باسط","للورى كف اللآلي والدررْ",5,"ر",1,0],["ملك طويل الباع سا","عد مجدد سعد رجدُ",6,"د",1,0],["مَلْكٌ طَلَعْتُ ثَنايا المَجْدِ آمِلَهُ","فكانَ بالرِّفْدِ نَزَّالاً على أَمَلي",7,"ل",2,0],["ملك طوى سر المهابة شخصه","لولا أسرة وجهه الميمون",8,"ن",1,0],["ملك طابَ رفعةً وجلالاً","وعلاَ مجدُه بطيبِ الخِيمِ",9,"م",1,0],["ملك طال حكمه في البرايا","وله الطوع أينما يتوسم",10,"م",1,0],["ملكٌ طائرٌ بغير جناحي","نِ بأمر الخيال يقضي وباسمه",11,"م",2,0],["ملك طاول السما بمعالِ","عاد عنها باع الثناء قصيرا",12,"ر",2,0],["ملك طَعون بالمثَّقفِ ضارب","فاسألْ عن الملكِ الضروب الطّاعنِ",13,"ن",1,0],["مُلِّكَ طوعَ النفوسِ حتَّى","عَلَّمَهُ الزهوُ كيفَ يبدو",14,"د",2,0],["مَلك ٌ طهورٌ أنتِ في قسماتهِ","ضحكاتُ طفل ٍ جسدت معناك",15,"ك",1,0]]}