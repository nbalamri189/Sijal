{"poems":[[79,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[88,"إني دعيت إلى احتفالك فجأة","https://www.aldiwan.net/poem68936.html","الكامل"],[74,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[72,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[47,"ضرطة وهب أنكرت","https://www.aldiwan.net/poem65140.html","مجزوء الرجز"],[68,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[99,"اليوم يومك في الشباب فناد","https://www.aldiwan.net/poem24755.html","الكامل"],[35,"واخجلتي من وقوفي وسط داركم","https://www.aldiwan.net/poem25850.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42553","البسيط"],[79,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[102,"لست أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=50150",""],[93,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[96,"أهوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=15665",""],[113,"ما جزت في روضة إلا وقد شخصت","https://www.aldiwan.net/poem16483.html","البسيط"],[139,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[159,"رضا الفنا عن بقائي بعدكم غضب","https://www.aldiwan.net/poem55792.html","البسيط"],[237,"أنا مسجد لله بيت عبادة","https://www.aldiwan.net/poem14738.html","الكامل"],[237,"من لي بموت يريح قلبي","https://www.aldiwan.net/poem14867.html","مخلع البسيط"],[242,"لعبد الله وجهت الخطابا","https://www.aldiwan.net/poem18079.html","الوافر"],[255,"في خده من بقايا اللثم تجميش","https://www.aldiwan.net/poem14987.html","البسيط"],[255,"أقبل مثل البدر في تمامه","https://www.aldiwan.net/poem15039.html","الرجز"],[257,"وأخجلها البراز فألبستها","https://www.aldiwan.net/poem1445.html",""],[266,"الحب ادواء عسيره","https://www.aldiwan.net/poem38138.html","مجزوء الكامل"],[276,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[287,"هل شرب البان شمولا فمال","https://www.aldiwan.net/poem32636.html","السريع"],[302,"حكيت الدجى والصبح والغصن والنقا","https://www.aldiwan.net/poem32958.html","الطويل"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[325,"إن الكريم وأنت أعلم أن يعد","https://www.aldiwan.net/poem61669.html","الكامل"],[353,"واخجلتي وصحائفي سود غدا","https://www.aldiwan.net/poem20628.html","الكامل"],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[385,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[385,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[385,"بكيت لتغريد الحمائم في الفجر","https://www.aldiwan.net/poem49260.html","الطويل"],[438,"قل للشريف على تقوله","https://www.aldiwan.net/poem12403.html","أحذ الكامل"],[449,"ما كان ذنبي يا أعز الناس","https://www.aldiwan.net/poem56049.html","عموديه"],[482,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[482,"قف بي على منزل بالربع قد دثرا","https://www.aldiwan.net/poem15341.html","البسيط"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122736","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48718","الكامل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31631","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84488","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128709","السريع"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102051","الكامل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128749","الوافر"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130678","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109280","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53031","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28535","السريع"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121214","السريع"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101694","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60906","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129932","المتقارب"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129900","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76099","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205837","السريع"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101950","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201741","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202765","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202589","الطويل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133249","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86366","الوافر"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36413","الدوبيت"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127121","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45018","الكامل"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33840","السريع"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143325","السريع"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35114","البسيط"],[4119,"لو كان سرك للوشاة معرضا","https://www.poetsgate.com/ViewPoem.aspx?id=16177",""],[5136,"شكري لما أوليت من بري","https://www.poetsgate.com/ViewPoem.aspx?id=121589",""],[5136,"وأخجلني من صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=121787",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""]],"verses":[["وا خَجْلَتي منْ حَلْيَةِ الفِكْرِ التي","أغرَيْتُها بغَراميَ المَشْروحِ",0,"ح",1,0],["واخَجلَتي أَيَكونُ هَذا مَوقِفي","في حَفلَةِ التَوديعِ وَالإِكرامِ",1,"م",1,0],["وا خجلتا لمقامٍ قد حضرتُ به","وما سقاني بكاس الموت ساقيكا",2,"ك",2,0],["واخَجلَتي مِنكُم إِذا","عَتِبتُمُ واقَلَقي",3,"ق",2,0],["وَأَخجَلَت مُرسِلَها","وَأَضحَكَت سامِعَها",4,"ه",2,0],["وَأَخجَلَ الوَردُ شُعاعَ الضُحى","فَاِبتَسَمَت مِنهُ ثُغورُ الأَقاح",5,"ح",1,0],["واخجلتا مما نقدمه إذا","حان الحساب وجاء يوم معادِ",6,"د",1,0],["واخَجلَتي مِن وُقوفي وَسطَ دارِكُمُ","وَقولِ واشيكُمُ مَن أَنتَ يا رَجُلُ",7,"ل",1,1],["وا خَجْلَةَ الْبَدْرِ إِنْ لاحَتْ أَسِرَّتُهَا","وَحَيْرَةَ الرَّشَإِ الْوَسْنَانِ إِنْ لَمَحَتْ",8,"ت",1,0],["واخجلتا من حلبة الفكر التي","أغريتها بغرامي المشروح",9,"ح",1,0],["واخجلي أنت والهوى واستكيني","واخلعي عن كيانك الكبرياء",10,"ا",2,0],["وا خجلة العربيّ من أجداده","صارت عبيدهم الطغاة موالية !..",11,"ي",2,0],["واخجلتي للناكرين جميلها","والثالمين مع العدوّ غررها",12,"ر",3,0],["وَإِخجَل مِن الوَرد مِن خَديك وَاِنعكفت","لِغُصن قَدك بانات وَأَفنان",13,"ن",1,0],["واخجلتاه الا يولى الجميل سوى","أمثال رتشلد أو أشباه قارونا",14,"ن",2,0],["وَاخَجْلتي من بقائي بعدَ فُرْقَتِكُمْ","إِذ ليس لي في حياتي بَعدكم أَربُ",15,"ب",1,0],["وَاِخجَلني وَالذُلُّ حينَ يُمُرُّ بي","فَيُقالُ هَذا مَسجِدٌ مَهجورُ",16,"ر",1,0],["وأخَجلَتا مِن وِدادِ خِلٍّ","لَستُ عَلى نَفعِهِ بِقادِر",17,"ر",1,0],["وَأَخْجَلَنِي فَأَبْدَيْتُ اعْتِرافاً","بِتَقْصيرٍ يُكَمِّلُ لِي عِقابَا",18,"ب",2,0],["واخجلةَ العُربِ إن كانتَ عمائمَهُم","لم تَحوِ ما قد حوتٌ منه الشرَّابيش",19,"ش",1,0],["واخجلَةَ البيض ويا وَيحَ القَنا","السُّمرِ بما يُبديهِ من اقلامهِ",20,"م",2,0],["وَأَخجلها البِرازُ فَألبَستها","يَدُ الساقي من الحَبَبِ القناعا",21,"ع",2,1],["واخجلة الزهر المنور","منه والزهر المنيره",22,"ر",2,0],["واخجلتي من عتاب ربي","انقالَ اسرفت يا فلان",23,"ن",1,0],["وا خَجلَةَ الوَردِ وَأَغصانِهِ","مِن وَجنَتَي قاتِلَتي بِالدَلال",24,"ل",1,0],["وأَخجلتَ حسناً طلعةَ البدرِ والرَشا","وورقَ الحِمى لحظاً ووجهاً ومَنطِقا",25,"ق",2,0],["وَأَخجل جفوّاً بالمداراة واِطّرح","رعونة نفسٍ في المكافاة بالريبِ",26,"ب",1,0],["وَأَخجَلَتي لَمّا سَئَلتَ وَلَم أَحرَ","عَنكَ الجَوابُ وَقَد رؤى فيكَ الجَفا",27,"ف",2,0],["واخَجْلتي وَصَحَائفي سُودٌ غَداً","وَصَحَائفُ الأَبْرارِ في إشْراقِ",28,"ق",1,1],["وأَخجَلُ في مَدِحيك خجلةَ غائصٍ","يَرُدُّ على البَحْرِ الّلآلى وقد طَما",29,"م",2,0],["وَأَخجَلنا بِالبرّ فَعل ابن حرة","وَما قَرَّع الجاني فَما قَرع السنّا",30,"ن",2,0],["وَأَخجَل لَما خَطَ اِبن مُقلة","وَأَرجاء لَما قالَ شاعر أَرجان",31,"ن",1,0],["وَأَخجَلتُهُ حَتّى تَلهب خَدهُ","تَلهب أَحشائي مِن الصَد وَالَهَجر",32,"ر",1,0],["واخَجْلَةَ الديوانِ إِن صرخُوا","من ذا يحاسِبُ سارِقَ الحَسَبِ",33,"ب",1,0],["واخجلتي بعد البشاشة منك لي","هذا الجفا بحضرة الجلاس",34,"س",1,0],["وأخجلَ الشمسَ بها","ءُ نُوُّرِه والقمرا",35,"ر",2,0],["وأَخْجَلَتْ سُحُبُ الجفانِ هاطلةً","سُحْباً حملنَ لسُقيا تُربهِ المطرا",36,"ر",2,0],["واخجلتا للبيض كيف تطاولت","سفهاً بأيدي السود وهي قصار",37,"ر",1,0],["واخجلَتا مِنكَ نَحيا بَعدَ مَوتِكَ لا","مِتنا عَلَيكَ وَلا ذُبنا مِنَ الخَجَلِ",38,"ل",1,0],["واخجلة الأنساب والأحساب إن","لم ألق لي مني لديك ضمينا",39,"ن",2,0],["وأَخٍ جَفا ظُلْماً ومَلَّ وطالَما","فُقْنا الأَنامَ مَوَدَّةً ونِداما",40,"م",2,1],["واخجلتي من خالقي وصحائفي","سودٌ إليه كلّ يومٍ تُرفَعُ",41,"ع",1,0],["وأخجل الغيث ندى كفّه","فاحمر وجها أفقه من حياه",42,"ا",2,0],["واخجلتاه من اللقا","ومن العتاب اذا الغطا",43,"ط",2,0],["واخجل سرب آرام المصلى","لحاظاً والغصون الميد قدّا",44,"د",2,0],["وأخجلت من كلام الحاسدين لها","وقولهم فيم لا ترنين للعطب",45,"ب",1,0],["واخجلتا إننا نعزى لهم ونرى","أخلاقهم بيننا تُجفى وتفتقد",46,"د",1,0],["واخجلة القَسْوَر من وقفة","ذل بها للرشأ الأخرق",47,"ق",1,0],["وأخجلة المثني عليك وهذه","علياء يُحْصَر دونها البلغاء",48,"ا",2,0],["وَاخَجلَتا لِلطَّيفِ لَمّا سَرى","في خَطَرِ اللَّيلِ إِلى ساهِرِ",49,"ر",1,1],["وا خجلتي من بعض احسائهم","مذ قلت ذنبي دون غفرانهم",50,"م",1,0],["وأخجلت غرّ السحب نيلا فغيثها","دموع على تقصيرها في الندى تجرى",51,"ر",2,0],["وأخجلُ إن قالوا محبٌ وعَاشقٌ","ولولا بياض الشيب ما كنت أخجل",52,"ل",1,0],["وأخجَلَ تُفّاحنا فاغتدى","يرومُ الكلام فلم ينبسِ",53,"س",1,0],["واخجلتي منه ومنكَ متى أنم","عيّرتني ومتى سهرت تنكّرا",54,"ر",2,0],["وَأَخجلَ نورَ الشَمسِ لَما تَقابَلا","فَحُمرتُهُ إِذ غابَ من فَرط ما اِستَحيا",55,"ي",2,0],["واخجلتا منه وقد سمْتُه","ذلّ الضنى من شدة الصبر",56,"ر",1,0],["واخجلتي منهم إذا جئتهم","بأي وجه أتلقاهم",57,"م",1,0],["وأخجل من أن أدعوَ الله خالقي","لرزقي وان عانيت داءَ الطوى القاسي",58,"س",2,0],["وأخجل من طردي لها إذ أخالها","تقول أما أوحيتُ قبل لك الشعرا",59,"ر",2,0],["وأخجل من صُبح المشيب بمفرقي","إذا رمتُ بالصهباء عَوداً لأهوائي",60,"ي",1,0],["واخجلتي من افتضاح السر","يا قلب دع عنك الهوى والشرا",61,"ر",2,0],["واخجلتي من ذنوبي حين أذكرها","منها الدموع كسح السحب مدراره",62,"ر",2,0],["وأخجل قرصها فاحمر حتى","حسبت شعاعها الكف الخضيبا",63,"ب",2,0],["وَا خجلةَ عاثِرٍ بِذَيلِ الكِبَرِ","قَد سَوَّدَ وَجهَه بَياضُ الشَعَرِ",64,"ر",1,1],["وأخجل نشر العنبر الورد نشركم","وأزرى محياكم بشمس الضحى الغرا",65,"ر",2,0],["واخَجلتاهُ وَأَنتَ أَنتَ وَراحَتي","مِمّا تُؤَمِّلُ في مَنيع قَيادِ",66,"د",1,0],["وا خَجلَتا مِنهُم وَمِن قولِهِم","ما ضَرَّكَ الفَقدُ لَنا شَيّا",67,"ي",2,0],["وا خجلتا إن لم أُطِقْ بَعْدَهمْ","تَصبُّراً من نظر الشامتين",68,"ن",1,0],["وا خجلةَ البَحر إِن لَم يَحلُ مَشرَبُهُ","وَإِن غَدا عَنبَرِيَّ اللَونِ وَالنَفسِ",69,"س",1,0],["واخجلتا لسبيكة مسخوطة","إن لم تكن جليت على عين الرضا",70,"ض",2,0],["واخجلتني مدحي يقصر عن","شكري فيا واخجلتي عذري",71,"ر",2,0],["وأخجلني من صديقي","أسدى إلى جميلا",72,"ل",2,1],["وأخجل في الأرض البحور نواله","ومن جو أعنان السماء السحائبا",73,"ب",2,0],["وأخجلني أن تقل لي يوم محشرنا","أهكذا صنعة النقاش ذي القلمِ",74,"م",1,0],["وأخجل مَعَناً ثم كعباً وحاتماً","إذا وَهَبتْ يُمنَاهُ بعض الهديةِ",75,"ه",1,0],["وأخجل منك أن تأتي إليهم","وأرجو أن أرى في الأرض لحدا",76,"د",2,0]]}