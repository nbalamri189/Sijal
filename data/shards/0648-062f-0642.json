{"poems":[[86,"أيا صوفيا حان التفرق فاذكري","https://www.aldiwan.net/poem10676.html","الطويل"],[23,"جزى الله مخزوما بأسوا صنيعها","https://www.aldiwan.net/poem21313.html","الطويل"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[72,"طحانكم قد زهى جمالا","https://www.aldiwan.net/poem20464.html","مخلع البسيط"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[45,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[80,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[69,"ودقاق يدق قفا عذولي","https://www.aldiwan.net/poem29004.html","الوافر"],[102,"كيف أغويتني وأمعنت صدا","https://www.aldiwan.net/poem33127.html","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140903",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55117","الكامل"],[72,"فتحت لي بَابا من الود مَا","https://www.poetsgate.com/ViewPoem.aspx?id=189424",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[80,"أمْطَتكَ همّتك العزيمة فاركبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3720",""],[64,"أنتم ملكتم فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=3136",""],[186,"أقول لمنكر يغتاظ مما","https://www.aldiwan.net/poem43235.html","الوافر"],[186,"فرخ الحرف وزقا","https://www.aldiwan.net/poem43563.html","مجزوء الرمل"],[186,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[223,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[275,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[468,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[500,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[524,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[538,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[567,"من لذاك الطبرزذ المسحوق","https://www.aldiwan.net/poem69574.html","الخفيف"],[587,"أعلى المنازل إذ عفت أعلامها","https://www.aldiwan.net/poem11516.html","عموديه"]],"verses":[["وَدُقَّت نَواقيسٌ وَقامَ مُزَمِّرٌ","مِنَ الرومِ في مِحرابِهِ يَتَرَنَّمُ",0,"م",1,0],["وَدِقَّةِ أَخلاقٍ وَرَأيٍ مُضَلَّلٍ","وَغَدرٍ وَلا يوفي بِزَندٍ عَقيدُها",1,"ه",2,0],["ودقَّ عليَّ البابَ رزقٌ ولم أسر","أدقّ بكعبي متعباً بطوافي",2,"ي",1,0],["ودقَّ خصراً فليت شعري","بكم يباع الدَّقيق منه",3,"ه",1,0],["وَدَقيقٌ قَذى الهَباءِ أَنيقٌ","مُتَوالٍ في مُستَوٍ هَزهازِ",4,"ز",1,0],["وَدَّ قَومٌ لو ساجَلوهُ وَلَو سو","جِلَ قَد خابَ جاهِلٌ وَتَعَنّى",5,"ن",2,0],["ودقيقَ معنَى العُرفِ يجعلُ بشرَه","بدرَ العدوِّ وتلك من أكفائِه",6,"ا",3,0],["ودقائقٍ بالفكر قد نَظّمْتُها","ولوَ انَّهُنَّ لآلئٌ لم تُثقبِ",7,"ب",1,0],["ودقاقٍ يدقُّ قفا عذولي","بِخَدٍّ منهُ ينشقُّ الشقيقُ",8,"ق",1,1],["وَدَّ قَلبي لَو يَجهل الحُب لَما","أَن رَآه يَحول سَقماً وَوَجدا",9,"د",2,0],["ودقيقٌ قدى الهباء أنيقٌ","متوالٍ في مستوٍ هزهاز",10,"ز",1,0],["وُدٌّ قَدِيمٌ فِي النفُوسِ مُؤَصَّلٌ","مُتَوَاصِلٌ فِي القَوْمِ جِيلاً جِيلاَ",11,"ل",2,0],["ودقه الْخَارِج لَا يختفي","وَرُبمَا يحلو لسؤالك",12,"ك",1,0],["ودقِّت بيمناها القضيَّةُ بابهُ","فقدَّم من حرِّ الدماء لها الفدا",13,"د",2,0],["ودقائقٍ بالفكر قد نظّمتُها","ولو انّهُنّ لآلىء ٌ لم تُثقبِ",14,"ب",1,0],["ودقّ على فؤادي","فقد عدمت رقادي",15,"د",2,0],["ودقّق إن فطنت ترى رجالا","تواصوا الخيانة والمهانه",16,"ن",2,0],["ودققت الحبّ من أش","نانه دقا وسحقا",17,"ق",2,0],["ودقق في الحكومة مستزيدا","وما فيه لمطلب مزيد",18,"د",1,0],["وَدَقَّ نِصفُ اللَيلِ في السُكونِ","فَاِختَلَجَ الشاعِرُ كَالظُنونِ",19,"ن",1,0],["وَدْقٌ تَوَلَّدَ عَنهُ وَقْدٌ في الرُّبَى","لأَزَاهِرٍ طَلَعَتْ بِهَا شُهْبَانا",20,"ن",2,0],["وَدُقَّةٍ كافورُ أَبرازِها","مُختَلِطٌ مِنها بِمِسكِيَّه",21,"ي",2,0],["وَدِقَّةِ مَنْحولِ القَوامِ الَّذي انْبَرى","بِعودٍ يَمانِيِّ السِّنانِ مُشَرَّعِ",22,"ع",1,0],["وَدَق طَبل الهَنا في كُل ناحِيَة","وَقابَلته مِن الآفاق كوسات",23,"ت",1,0],["ودقَّت طبولُ البشرِ تثزجِي نَفِيرَها","وكم من نساءٍ بين ذاك تُزغرد",24,"د",1,0],["ودقيقٌ أبرزتُهُ بجليلٍ","وحلالٌ أبَنْتُهُ من حرامِ",25,"م",1,0],["وَدَقِيْقُ السِّمْيِذِ يُعْجَنُ بِالْمَا","وَرْدِ عُلِّى بِمِسْكِهِ المَسْحُوقِ",26,"ق",1,0],["ودق السحايب إذ همى في صحصح","والحلى أوها سلكها نظامها",27,"م",3,0]]}