{"poems":[[88,"أيا صوفيا حان التفرق فاذكري","https://www.aldiwan.net/poem10676.html","الطويل"],[23,"جزى الله مخزوما بأسوا صنيعها","https://www.aldiwan.net/poem21313.html","الطويل"],[74,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[74,"طحانكم قد زهى جمالا","https://www.aldiwan.net/poem20464.html","مخلع البسيط"],[45,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[63,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[82,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[71,"ودقاق يدق قفا عذولي","https://www.aldiwan.net/poem29004.html","الوافر"],[104,"كيف أغويتني وأمعنت صدا","https://www.aldiwan.net/poem33127.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140903",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55117","الكامل"],[74,"فتحت لي بَابا من الود مَا","https://www.poetsgate.com/ViewPoem.aspx?id=189424",""],[108,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[82,"أمْطَتكَ همّتك العزيمة فاركبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3720",""],[66,"أنتم ملكتم فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=3136",""],[190,"أقول لمنكر يغتاظ مما","https://www.aldiwan.net/poem43235.html","الوافر"],[190,"فرخ الحرف وزقا","https://www.aldiwan.net/poem43563.html","مجزوء الرمل"],[190,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[228,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[280,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[473,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[505,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[529,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[543,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[556,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[572,"من لذاك الطبرزذ المسحوق","https://www.aldiwan.net/poem69574.html","الخفيف"],[592,"أعلى المنازل إذ عفت أعلامها","https://www.aldiwan.net/poem11516.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77637","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105464","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16718","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50008","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81892","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52035","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113760","الكامل"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198712","الوافر"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106995","الرجز"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110672","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110835","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127126","الطويل"],[4899,"الفروق العجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=177125",""],[3271,"محمد لاقى عليها المسيح","https://www.poetsgate.com/ViewPoem.aspx?id=128744",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[5370,"ليل شتاء","https://www.poetsgate.com/ViewPoem.aspx?id=87466",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5851,"دموع آذار","https://www.poetsgate.com/ViewPoem.aspx?id=175233",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6242,"على شرفة أبريل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87560&r=&rc=7",""],[572,"من لِذَاك الطبرزدِ المدقوقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9412&r=&rc=269",""]],"verses":[["وَدُقَّت نَواقيسٌ وَقامَ مُزَمِّرٌ","مِنَ الرومِ في مِحرابِهِ يَتَرَنَّمُ",0,"م",1,0],["وَدِقَّةِ أَخلاقٍ وَرَأيٍ مُضَلَّلٍ","وَغَدرٍ وَلا يوفي بِزَندٍ عَقيدُها",1,"ه",2,0],["ودقَّ عليَّ البابَ رزقٌ ولم أسر","أدقّ بكعبي متعباً بطوافي",2,"ف",2,0],["ودقَّ خصراً فليت شعري","بكم يباع الدَّقيق منه",3,"ه",1,0],["وَدَقيقٌ قَذى الهَباءِ أَنيقٌ","مُتَوالٍ في مُستَوٍ هَزهازِ",4,"ز",1,0],["وَدَّ قَومٌ لو ساجَلوهُ وَلَو سو","جِلَ قَد خابَ جاهِلٌ وَتَعَنّى",5,"ن",2,0],["ودقيقَ معنَى العُرفِ يجعلُ بشرَه","بدرَ العدوِّ وتلك من أكفائِه",6,"ا",3,0],["ودقائقٍ بالفكر قد نَظّمْتُها","ولوَ انَّهُنَّ لآلئٌ لم تُثقبِ",7,"ب",1,0],["ودقاقٍ يدقُّ قفا عذولي","بِخَدٍّ منهُ ينشقُّ الشقيقُ",8,"ق",1,1],["وَدَّ قَلبي لَو يَجهل الحُب لَما","أَن رَآه يَحول سَقماً وَوَجدا",9,"د",2,0],["ودقيقٌ قدى الهباء أنيقٌ","متوالٍ في مستوٍ هزهاز",10,"ز",1,0],["وُدٌّ قَدِيمٌ فِي النفُوسِ مُؤَصَّلٌ","مُتَوَاصِلٌ فِي القَوْمِ جِيلاً جِيلاَ",11,"ل",2,0],["ودقه الْخَارِج لَا يختفي","وَرُبمَا يحلو لسؤالك",12,"ك",1,0],["ودقِّت بيمناها القضيَّةُ بابهُ","فقدَّم من حرِّ الدماء لها الفدا",13,"د",2,0],["ودقائقٍ بالفكر قد نظّمتُها","ولو انّهُنّ لآلىء ٌ لم تُثقبِ",14,"ب",1,0],["ودقّ على فؤادي","فقد عدمت رقادي",15,"د",2,0],["ودقّق إن فطنت ترى رجالا","تواصوا الخيانة والمهانه",16,"ن",2,0],["ودققت الحبّ من أش","نانه دقا وسحقا",17,"ق",2,0],["ودقق في الحكومة مستزيدا","وما فيه لمطلب مزيد",18,"د",1,0],["وَدَقَّ نِصفُ اللَيلِ في السُكونِ","فَاِختَلَجَ الشاعِرُ كَالظُنونِ",19,"ن",1,0],["وَدْقٌ تَوَلَّدَ عَنهُ وَقْدٌ في الرُّبَى","لأَزَاهِرٍ طَلَعَتْ بِهَا شُهْبَانا",20,"ن",2,0],["وَدُقَّةٍ كافورُ أَبرازِها","مُختَلِطٌ مِنها بِمِسكِيَّه",21,"ي",2,0],["وَدِقَّةِ مَنْحولِ القَوامِ الَّذي انْبَرى","بِعودٍ يَمانِيِّ السِّنانِ مُشَرَّعِ",22,"ع",1,0],["وَدَق طَبل الهَنا في كُل ناحِيَة","وَقابَلته مِن الآفاق كوسات",23,"ت",1,0],["ودقَّت طبولُ البشرِ تثزجِي نَفِيرَها","وكم من نساءٍ بين ذاك تُزغرد",24,"د",1,0],["ودقيقٌ أبرزتُهُ بجليلٍ","وحلالٌ أبَنْتُهُ من حرامِ",25,"م",1,0],["وَدَقِيْقُ السِّمْيِذِ يُعْجَنُ بِالْمَا","وَرْدِ عُلِّى بِمِسْكِهِ المَسْحُوقِ",26,"ق",1,0],["ودق السحايب إذ همى في صحصح","والحلى أوها سلكها نظامها",27,"م",3,0],["ودقت عن العقل الظنين بظنه","وصانت جلال اللَه في عز صونه",28,"ه",1,0],["وَدَّ قَتلي وَوِصالي قَد أَبى","يا فُؤادي لِرِضا ما ودّ فَاِنحُ",29,"ح",1,0],["وَدَقَّ في حائطها مِسمارا","وَحَبلَ تيلٍ لَفَّهُ مِرارا",30,"ر",2,0],["ودقّوا عِطرَ مَنْشم وقتَ عصرٍ","ووجهُ الشمس مَطليٌّ بورسِ",31,"س",1,0],["ودقة في العلوم الغامضات كأن","على حقيقة ما في الغيب قد ظهرا",32,"ر",2,0],["وَدَقيقَةَ الأَطرافِ وَهيَ جَسيمَةٌ","رَيّا تُمَرمِرُ في مُتونِ ظِماءِ",33,"ا",2,0],["ودُقَّ جناحا طائر البين وانتشى","بنَحر مطايا الظَّاعن المترحّلِ",34,"ل",1,0],["وَدُقَّتْ لِي الْرَايَاتُ فِي الأَرْضِ وَالسَّمَا","وَأَهْلُ السَّمَا والأَرْضِ تَعْلَمُ سَطْوتِي",35,"ي",1,0],["ودقّة من ندى إمام البرايا","شيخنا البحر الواهب المعطاء",36,"ا",2,0],["وَدِقَّةُ فَهْمٍ لِلعَويصَةِ رَامَهَا","أخُو فِطنَةٍ أو لَجَّ فيهَا المُشَاغِبُ",37,"ب",1,0],["ودقائِقٌ وحقائِقٌ لا تَتنتهي","غاياتُها في كُلِّ تحقيقٍ إلى",38,"ل",2,0],["ودقي شحم حنظلة وعصري","حشيشة غافث أو انجدان",39,"ن",1,0],["ودقت منها ريقة رشفتها","اشهى واجلى من مذاق السلسل",40,"ل",1,0],["ودق من هاشم عرنين سؤددها","فعاد سابقها في الفضل تاليها",41,"ي",3,0],["وَدقَّت الطُّبول وَالبوقات","وَدقَّت الأسحار وَالأَوقاتُ",42,"ت",1,0],["ودقوق قل جبل وتكريت كذا","والدوركي جبل وتل درندة",43,"ه",1,0],["ودق قِرن بسيف للوغى دَرَقا","وَقَد تصبب كل في اللقا عرَقا",44,"ق",2,0],["ودق الناس أبواب الفتاوي","وقد وصلوا إلى باب الصيالِ",45,"ل",1,0],["وَدَقَّ عِراكُهُم حوضيكَ فاِصدُر","بآتُنِكَ العِطاشِ وَهُنَّ صِيدُ",46,"د",1,0],["ودقيقُ تلك الصارفيَّةِ لم يشحَّ","وفي دَوامِ الجَدب منهُ يُغتَذَى",47,"ا",1,0],["وَدقَ إسعَادٍ وَالسَّمَاواتُ شَحَّت","عِندَمَا دَرَّ ثَديُهَا الشَّاءُ دَرَّت",48,"ت",1,0],["ودقت طبول الرعد والريح شببت","وصفقت الأنهار يمنى على يسرى",49,"ر",2,0],["ودق النجر مع نسمة(ن) هفهفيه","من بعد حمس البن باشقر لهيبه",50,"ب",2,0],["ودقٌ يضجُّ على كل بابْ","سمعت به صولة الزاحفينْ",51,"ن",1,0],["وَدَقَايِقُ التَّدْقِيقِ فِي تَدقِيقِها","مِنْ رِقِّ مَن هُوَ للعلومِ مُدَارِسُ",52,"س",1,0],["ودقات قلبي تزيد وينشغل بالي","ويزداد خوفي لادرت الوجه للهوه",53,"و",2,0],["ودقت من الإسلام لدنا مثقفاً","رأى الموت رأساً منه بالطعن أصلعا",54,"ع",2,0],["ودقَّ القصفُ عَظْمَ القلب رَجْمًا يَتبعُ الرجما","كأنَّ الشُّهبَ قد خرَّت .. علينا تحرقُ الغيْما",55,"م",2,0],["ودٓقُ الغمامِ نقاؤها ومدامُها","من حُسنِها قد يشتهيها الرّاحُ",56,"ح",1,0],["ودقه بنجر تالي الليل رجاف","ويا حسين لقمها ببيض مهاديف",57,"ف",1,0],["ودقه بنجران ياظريف العيالي","يجذب لنا ربعن على اكوار جلاس",58,"س",1,0],["ودق قصر الرؤى طيف يزعزعني","تجيبه من عميق السهو أبواب",59,"ب",1,0],["وَدَقوا عَلى استنبول بِالنيل بالعجل","وَدار السَعادة بِالحكي جو ضونها",60,"ن",3,0],["وَدقوا عَلى دار السَعادة بتبلهم","وَاسترخصوا انا نريد نكال",61,"ل",1,0],["ودقائقُ شاخت أأنت نسيتها","أقسمْ بأنّ سكونها ما أفجعكْ ؟",62,"ك",1,0],["ودقيقِ السّميذِ يُعْجَنُ بالمَا","وَرْدِ عُلَّ بمسكِهِ المسحوقِ",63,"ق",1,0]]}