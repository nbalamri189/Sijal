es.php?name=Sh3er&doWhat=shqas&qid=86105&r=&rc=2",""],[6213,"العربية الصامدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81775&r=&rc=84",""]],"verses":[["هَيَّجَ أَحزاني وَرَوعاتي","مَن كانَ يَسعى بِرِسالاتي",0,"ت",2,1],["هِيَ جَنَّةُ الدُّنْيَا الَّتِي مَن حَلَّهَا","نَالَ الرِّضَى وَالرَّوْحَ وَالرِّيْحَانَا",1,"ن",2,0],["هَيَّجتُمُ حَسّانَ عِندَ ذَكائِهِ","غَيٌّ لِمَن وَلَدَ الحِماسُ طَويلُ",2,"ل",1,0],["هيَّجتْ لي ضدين ماءً وناراً","دمعَ عيني يَهْمي ولوعةَ جاشي",3,"ش",2,0],["هي جولةُ الضْحَّاكِ عمَّ بلاؤُها","كلَّ الأنامِ فأين أفْرِيدُونُ",4,"ن",1,0],["هَيَّجَ أَشواقَنا بِزَورَتِهِ","ثُمَّ اِنثَنى وَالقُلوبُ أَسراهُ",5,"ا",2,0],["هِيَ جَوهَرٌ نَثرٌ فَإِن أَلَّفتَهُ","بِالشِعرِ صارَ قَلائِداً وَعُقودا",6,"د",2,0],["هِيَ جَنَّةُ الْحُسْنِ الَّتِي زَهَرَاتُهَا","حُورُ الْمَهَا وَهَزارُ أَيْكَتِهَا فَمِي",7,"م",2,0],["هيَّجتْهُ حمائمٌ قدْ شجاها","فَقْدُ إِلْفٍ وفقدُهُ للقرينِ",8,"ن",1,0],["هَيَّجَني البُدَّنُ المِلاحُ فَما","أَنفَكُّ بَينَ الحِسانِ أَقتَصِرُ",9,"ر",1,0],["هَيَّجَ القَلبَ مَغانٍ وَصَيَر","دارِساتٌ قَد عَلاهُنَّ الشَجَر",10,"ر",1,1],["هيّجْتهُ نَزوةٌ من مُعْتَدٍ","جاهليِّ النّفسِ وحشيِّ الشِّيَمْ",11,"م",1,0],["هَيَّجتَ في النّيل طيراً ما بأيكتهِ","لِينٌ ولا عُودُه ريّانُ مَطلولُ",12,"ل",1,0],["هَيَّجْتَ للشرِّ وَقْداً","فأينَ غادرتَ وَقْدَكْ",13,"ك",1,0],["هَيَّجَ الشَوقَ لي مَعارِفُ مِنها","حينَ حَلَّ المَشيبُ دارَ الشَبابِ",14,"ب",1,0],["هيَّجَ البَينُ دَواعي سَقَمي","وكَسا جِسميَ ثوبَ الألَمِ",15,"م",1,1],["هيَ جزء صاغر من","عالم لا يَتَناهى",16,"ه",2,0],["هَيَّجَ الدَّاء في فُؤادِكَ حُورٌ","ناعِماتٌ بِجانِبِ الِملطَاطِ",17,"ط",1,1],["هَيَّجَ البَوعَ إذا هَيَّجتَهُ","يَخلِطُ الَمعجَ بتَقرِيبٍ وشَدّ",18,"د",1,0],["هِيَ جَمْرَةُ الفُرْسِ الَّتِي سَجَدَتْ لَهَا","أَملاكُها في سَالِفِ الآنَاءِ",19,"ا",2,0],["هِيَ جَوْهَرٌ كَالنَّفْسِ مَا بَرِحَتْ","تُهْدِي السُّرُورَ لِكُلِّ ذِي نَفْسِ",20,"س",1,0],["هيجاءَ تلْتَهمُ الورى","وتقول: هل لي من مزيد؟",21,"د",1,0],["هيَّجوا أوتارَهم وانبعثت","هِزّةُ الحب فهاجت وَتَري",22,"ر",2,0],["هَيَّجتَ منّي أيَّ داءِ كامنٍ","وقدحتَ منّي أيّ َزندٍ واري",23,"ر",2,0],["هي جَلَّت عُرساً فزيدت بهاءً","دارةُ المجدِ إنهُ جلَّ عُرسا",24,"س",2,0],["هيَّجوا النار انها أهونُ الشرّينِ","وقعاً ولا تَهيجوا الطباعا",25,"ع",2,0],["هي جت كذا ودّي وولاهوب ودّي","ماتمّت البسمات بس البكا.؟ تم",26,"م",1,1],["هي جنّة ما ارتادها ذو شرّة","إلاّ وأطمع حسنها مرتادها",27,"د",3,0],["هي جذوة حاولتم إطفاءها","والظلم راح محولا إيقادها",27,"د",3,0],["هَيجتَني رِياض أَخلاقِهِ الغُر","فَردَّت كَالحَمائِمِ صَدحا",28,"ح",2,0],["هيج البعد هواها","مهجة طال اساها",29,"ا",3,1],["هيجت وجدي يا نسيم الصبا","هببت والقلب هياما صبا",30,"ب",2,0],["هيجت أشواقَ صَبٍّ شفّه سقم","وليس يشفيه إلاّ الضّم والقبلُ",31,"ل",1,0],["هَيجاءَ لَم تُثكِل عَجائِزَ عامِرٍ","إِلّا وَأُمُّ المَوتِ فيها مُتبِعُ",32,"ع",1,0],["هي جنة مولاي أبدع صنعها","سبحانه من خالقٍ ومصوّر",33,"ر",1,0],["هيَّجني تذكرُ الأظعانِ","والغانيات الخُرَّدِ الحسانِ",34,"ن",1,1],["هِيَ جَونَةُ العَطّارِ إِن شُمَّت وَإِن","لُمِسَت فَتِلكَ كَزُبدَةِ اللَبّانِ",35,"ن",1,0],["هَيجَت وَجدي يا نَسيمَ الصَبا","إِن كُنتَ مِن نَجدٍ فَيا مَرحَبا",36,"ب",2,1],["هَيَّجتَ مِنّي عَليكَ رَقشاً","مِنَ القَوافي وَأَيَّ رَقشِ",37,"ش",1,0],["هيّجتِ من أبلغِ اللذّات أذكارا","لما هَتَكتِ من الأسرارِ أستارا",38,"ر",2,1],["هيجت وَجدي بدورهم","يا لقلب بالغَرام رمى",39,"م",2,0],["هيجتني نسمة نجدية","قلبت قَلبي عميدا مستهاما",40,"م",2,0],["هِيَ جَنَّةٌ مَحفوفَةٌ بِنَعيمِها","في ظِلِّها وِلدانُها وَالحورُ",41,"ر",1,0],["هيَّجه منظرُ قبرِ الصبِّ","فظلَّ يبكي من قضى بالوجد",42,"د",1,0],["هي جولةٌ لا تنجلي إلاّ وقدْ","بلغتْ بها نفسُ الأبيّ نجاحا",43,"ح",2,0],["هيّجا تذكارَ أَيامِ الصِبا","وَيْحَ قلبِ الصبِ من نكِ الجراح",44,"ح",1,0],["هي جنة المأوى لمن كلفت","آمائه بمطالب المجد",45,"د",1,0],["هيّجت أَشجان صَبٍّ لِلرُبوع هَفا","يا ساجِعاً فَوقَ أَغصان الربى هتفا",46,"ف",2,1],["هِيَ جَفوَةٌ في الدَهرِ ما","لِيَ حَسرَةٌ مِنهُ سِواها",47,"ا",3,0],["هيجعت وقد كُشِفَ الغطاء فأبصرت","بالإنفصال مقامَ كل مودِّع",48,"ع",1,0],["هِيَ جَنة في الأَرض واحِدَة","أَنهارُها مِن تَحتِها تَجري",49,"ر",2,0],["هَيّجتَ في قلبي الجريحِ بَلاَ بِلاً","وأَفَضْتَ من جفني القريح دموعا",50,"ع",2,0],["هِيَ جهدُ المقلِّ مولاي فاعذرْ","عبدَكم إن أَقلّ أو عن أخَلاّ",51,"ل",2,0],["هيَّجَ النَّارَ الَّتي أعهدها","ذات إيقاد بقلبي واشتعال",52,"ل",1,0],["هيَّجت أشجان قلبي فانتدبت لها","بكل منتدب للشجوِ مبتدر",53,"ر",1,0],["هيّج في الأحشاءِ تذكاري له","ناراً أضرّتْ بالفؤادِ والحشا",54,"ا",1,0],["هيّجْتَ ناراً سكَنا","بين الحشايا سكَني",55,"ي",1,0],["هيجت بعدك في البكاء حمائماً","فوق الغُصون على هديل تسجع",56,"ع",1,0],["هي جنَّةُ الفردوس لو","وجد أمروءٌ فيها خلودا",57,"د",2,0],["هيّج بلبالي بأهل بابلِ","ليلُ الخيال وصباحُ العاذلِ",58,"ل",1,1],["هي جنة وجهنم","أغياره تتلهب",59,"ب",1,0],["هَيَّجتَ لي شَوقاً إليهِ وكُنتُ قد","أهمَلتُهُ لمَّا رأيتُ كَسادَهُ",60,"د",2,0],["هَيَّجت عِندي شجوناً","سَكَنتْ دَهراً طَوِيلا",61,"ل",2,0],["هَيَّجْتُما شَجَنَ القريضِ فطابَ لي","وأطَلْتُما أمَدَ الثَّناءِ فأفحَما",62,"م",2,0],["هَيَّجت بي في الشعر بعد النَّوى","وَجداً قدِيماً في الحَشا قد ربي",63,"ب",2,0],["هِيَ جُؤذُرٍ وَلَكُم سَبَت مِن ضَيغَمِ","لا يَستَبيهِ مِنَ الجُيوشِ خَميسَها",64,"س",3,0],["هي جنةُ الدُنيا التي هي سَجسجٌ","يرضى بها المحرور والمقرورُ",65,"ر",1,1],["هَيِّجوني في هَواهُ هيِّجوا","في هَواهُ حقَّ لي خَلعُ العِذارْ",66,"ر",1,0],["هَيَّجت سُليمى مِنَ المُتيّم بِلبالْ","مِن حَيث تَبدّيتِ لِلمتيّم بِالبِالْ",67,"ل",1,1],["هيّجَ الشّوقَ الّذي كان صحا","حبْسكَ اليوم على ذاك الطّللْ",68,"ل",1,0],["هيّج الحبّ بِقَلبي وشغف","هاتفٌ مِن صادحِ الورقِ هَتَف",69,"ف",1,1],["هيَّجت شوقاً لفتى ذكرتهُ","مِن عهودِ الحبِّ ما كان عهد",70,"د",1,0],["هيَ جنّة في الوصلِ لكن هجرُها","كَالنارِ في الأحشاءِ والأكبادِ",71,"د",1,0],["هِيَ جَنَّةُ الدُنيا فَكَيفَ تَرَكتَها","وَسَكَنتَ دارا غَيرَ ذاتِ قَرار",72,"ر",1,0],["هَيَ جَنة مِن تَحتِها الأَنهارُ وَالأَ","شجارُ وَهُوَ الفائِضُ الآلاءِ",73,"ا",2,0],["هَيَّجْنَ شَوْقاً وَمَحَلٌّ شَوَّقا","كَالبُرْدِ أَبْلَى لِفْقَهُ المُلَفَّقا",74,"ق",2,0],["هَيَّجَ وَاجْتابَتْ جِدِيداً عَنْ خَلَقْ","كَالْهَرَوِيِّ انْجَابَ عَنْ لَوْن السَرَقْ",75,"ق",1,0],["هيَّجوا فتنةً إلى الجو