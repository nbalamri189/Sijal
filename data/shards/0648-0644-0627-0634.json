,"الكامل"],[456,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[456,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[456,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[462,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[462,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[468,"وما زال من قلبي لسودة ناصر","https://www.aldiwan.net/poem4847.html","الطويل"],[475,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[493,"يا آل عصم أنتم أولو العصم","https://www.aldiwan.net/poem10276.html","مشطور الرجز"],[498,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[503,"بيان","https://www.aldiwan.net/poem42464.html","الهزج"],[512,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[512,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[513,"قفا فلعل الفيض من عبراته","https://www.aldiwan.net/poem12041.html","الطويل"],[513,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[527,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[527,"وكيف يرجي الفتح والمنح بعدما","https://www.aldiwan.net/poem37366.html","الطويل"],[527,"نظام هو الدر الثمين منضدا","https://www.aldiwan.net/poem37444.html","الطويل"],[549,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[556,"جميع البرايا هي اليلمع","https://www.aldiwan.net/poem34380.html","المتقارب"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[573,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[573,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[584,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"]],"verses":[["وَلا شَرِبوا إِلّا دَماً بَعدَهُ وَلا","تَحابوا بِغَيرِ الزاعِبِيِّ المُقَصَّدِ",0,"د",1,0],["ولأَشْكُرَنّ نَداكَ شُكْرَ خَميلَةٍ","لندىً يُرَقْرِقُهُ الغَمامُ هَتونِ",1,"ن",1,0],["وَلاَ شَعَرَتْ مِنْ قَبْلِهِ بِتَشَوُّقٍ","تَخَلَّلَ مِنْهَا بَيْنَ رُوحٍ وَجْثْمَانِ",2,"ن",1,0],["ولا شَرَحَتْ مدوَّنَةَ المَعالي","سِوى فُتْيا أبي الحَسَنِ الصّغيرِ",3,"ر",1,0],["وَلا شَرَعَت هَذا اليَراعَ أَنامِلي","لِشَكوى وَلَكِنَّ اللَجاجَ يُثيرُ",4,"ر",1,0],["وَلَأَشكُرَنَّ حَوادِثاً قَذَفَت بِآ","مالي إِلى الملكِ الهمامِ الأَروَعِ",5,"ع",1,0],["وَلا شَمطاءُ لَم يَترُك شَقاه","لَها مِن تِسعَةٍ إَلّا جَنينا",6,"ن",2,0],["وَلا شَهِدَتنا يَومَ جَيشِ مُحَرِّقٍ","طُهَيَّةُ فُرسانُ الوَقيدِيَّةِ الشُقرِ",7,"ر",1,0],["وَلا شَهِدَت يَومَ النَقا خَيلُ هاجَرٍ","وَلا السيدُ إِذ يَنحِطنَ في الأَسَلِ الحُمرِ",7,"ر",1,0],["وَلا شَيءَ مِمّا يَأكُلُ الناسُ عِندَنا","سِوى العِلهَزِ العامِيِّ وَالعَبهَرِ الفَسلِ",8,"ل",1,0],["ولا شَجِيجٌ أقَامَ في دِمنَةِ ال","مَنزِلِ لا نَاكِحٌ ولا عَزَبٌ",9,"ب",1,0],["ولا شحيح اقام في دمن","ة المنزل لا ناكح ولا عزب",10,"ب",1,0],["وَلا شُدَّ لي سَرجٌ عَلى ظَهرِ سابِحٍ","وَلا ضُرِبَت لي بِالعَراءِ قِبابُ",11,"ب",1,0],["ولا شيء أحسن من مالك","تجود يداه على شافع",12,"ع",1,0],["ولا شفق الأصباح ماء وقهوة","ولا الطير في دوح على العود مرنان",13,"ن",1,0],["ولأشربنَّ على تنقُّصِهِ","حتى كأني لستُ منتقِصا",14,"ص",2,0],["ولا شِعر إلا ما يُقفَّى رويُّه","إذا قام بالشعر الرواةُ المقاوما",15,"م",2,0],["ولا شَقِينا بوعدٍ منك يتبعُهُ","مَطلٌ ولا كنتَ إلا صافي المِننِ",16,"ن",1,0],["وَلا شَبوبٌ مِنَ الثيرانِ أَفرَدَهُ","عَن كَورِهِ كَثرَةُ الإِغراءِ وَالطَرَدُ",17,"د",1,0],["ولا شرفٌ يَرحَمُ المُشرفيّ","مِمّا بِهِ مِن شَمات الوَتينِ",18,"ن",1,0],["ولا شمسا برأس التنين حلّت","وفي الدنيا ضحاها واللعاب",19,"ب",1,0],["وَلا شُغِلَ الأَميرُ عَنِ المَعالي","وَلا عَن حَقِّ خالِقِهِ بِكاسِ",20,"س",1,0],["وَلا شَغَلوا صُمَّ القَنا بِقُلوبِهِم","عَنِ الرِكزِ لَكِن عَن قُلوبِ الدَماسِقِ",21,"ق",1,0],["ولا شجوَ إلّا أنّ سَجْلي سقاكُما","وأنّكما يُعطَى سوايَ حيَاكما",22,"م",2,0],["ولا شِينتِ الدّنيا بيومكَ إنَّما","بقاؤك فيها غُرَّةٌ وحُجُولُ",23,"ل",1,0],["وَلأَشكرنَّ جميلَ ما أوليتَني","شُكراً تسيرُ بذكرهِ الأشعارُ",24,"ر",1,0],["وَلا شَرقَ اِمتِنانَكَ نَقصُ شُكري","وَلا غَطّى عَلى نُعماكَ كُفري",25,"ي",1,0],["وَلَأَشكُرَنَّ أَبا عَلِيَّ إِنَّ مِن","جَدوى يَدَيهِ تالِدي وَطَريفي",26,"ف",2,0],["وَلا شَيءَ شَرٌّ مِن شَريرَةِ خائِنٍ","يَجيءُ بِها يَومَ اِبتِلاءَ المَحاصِلِ",27,"ل",1,0],["وَلا شارَكوا في القَومِ في دَمِ نَوفَلٍ","وَلا وَهَبٍ مِنهُم وَلا اِبنِ المُحَزَّمِ",28,"م",1,0],["وَلا شَيءَ إِلّا لَهُ آفَةٌ","وَلا شَيءَ إِلّا لَهُ مُنتَهى",29,"ا",1,0],["ولا شكّ أنَّ الماء رطبٌ وكلّما","سَقَيْتَ حديداً فيه زادَ به يُبْسا",30,"س",2,0],["وَلَأُشهِرَنَّ عَلَيكَ شُنعَ أَوابِدٍ","يُحسَبنَ أَسيافاً وَهُنَّ قَصائِدُ",31,"د",1,0],["وَلا شَكَّ أَنَّ الخَيرَ مِنكَ سَجِيَّةٌ","وَلَكِنَّ خَيرَ الخَيرِ عِندي المُعَجَّلُ",32,"ل",1,0],["وَلا شَاقَنِي بَرْقٌ تَأَلَّقَ مَوْهِنَاً","كَزَنْدٍ تُوَالِي قَدْحَهُ كَفُّ ضَارِمِ",33,"م",1,0],["وَلا شِمتُ إِلّا غُرَّةً فَوقَ شُقرَةٍ","فَقُلتُ حَبابٌ يَستَديرُ عَلى خَمرِ",34,"ر",1,0],["وَلا شَرَفُ المَرءِ غَيرُ النُهى","وَإِلّا فَحَيثُ الوُجودُ العَدَم",35,"م",1,0],["وَلا شَوقَ حَتّى يَلصَقَ الجِلدُ بِالحَشا","وَتَصمُتَ حَتّى لا تُجيبُ المُنادِيا",36,"ي",2,1],["وَلاَ شَجَرٌ فِي الأرضِ إلاَّ مِنَ القَنَا","وَلاَ أنجُمٌ فِي الأفقِ إلاَّ المَنَاصِلُ",37,"ل",1,0],["ولا شَكَرْتُهُم مِنْ بَعْدِ ذَمِّهِمُ","كأنهم آمَنُوا مِنْ بَعْدِ ما كَفَرُوا",38,"ر",3,0],["وَلاشَكَّ أَنَّ كَذا فِعلُهُ","إِذا ما تَلَقَّتهُ ريحُ الجَنوبِ",39,"ب",1,0],["وَلا شُبوبٌ باتَت تُؤَرِّقُهُ ال","نَثرَةُ مِنها بِوابِلٍ قَصِفِ",40,"ف",1,0],["وَلا شَتَوتُ بِها عاماً فَأَدرَكَني","فيها المَصيفُ فَلي عَن ذاكَ مُرتَحَلُ",41,"ل",1,0],["وَلا شَدَدتُ بِها مِن خَيمَةٍ طُنُباً","جارى بِها الضَبُّ وَالحِرباءُ وَالوَرَلُ",41,"ل",1,0],["وَلا شَوَينا وَرَلاً","مُنَضنِضاً بِالذَنَبِ",42,"ب",1,0],["وَلَأَشرَبَنَّ مِنَ الحِمامِ كُؤوسَهُ","ما بَينَ جامِدِهِ وَبَينَ مُذابِهِ",43,"ب",2,0],["وَلا شَلّالِ عاناتٍ خِماصٍ","وَلَكِن خَيلِ جَيشٍ مُرجَحَنِّ",44,"ن",1,0],["وَلا شَيءَ مِثلُ الخَيرِ يُزمَعُ تَركُهُ","وَيُصبِحُ مَبذولاً لِمُكتَسِبيهِ",45,"ب",3,0],["وَلا شَمطاءُ لَم يَترُك شَقاها","لَها مِن تِسعَةٍ إَلّا جَنينا",46,"ن",2,0],["وَلاَ شِعْرَ بَعْدَ اليَوْمِ صَافٍ بَيَانُهُ","يُعِيدُ لَنَا أَخْفَى المَعَانِي مُمَثَّلاَ",47,"ل",2,0],["وَلا شَكَّ قَلبي ساعَةً في اِعتِقادِهِ","وَلا شابَ ظَنّي قَطُّ فيهِ الشَوائِبُ",48,"ب",1,0],["ولا شكَت الأرض من حملها","ولا ضاق بالناس رحبُ الفضاء",49,"ا",2,0],["ولا شعبٌ تحكَّم في سواه","ولا عانٍ برجليه شِكال",50,"ل",1,0],["ولاشيتُ نفسيَ في الأبعدين","أُفكّرُ فيهمْ ، وفي الأقرب!",51,"ب",1,0],["ولا شكّ أنَّ الماء رطبٌ وكلما","شقيتَ حديداً فيه زاد به يُبسا",52,"س",2,0],["وَلاَ شَارَكَتْ فِي المَوْتِ فِي دَمِ نَوْفَلٍ","وَلاَ وَهَبٍ مِنْهَا وَلا ابْنِ المُخَزَّمِ",53,"م",1,0],["وَلا شَدَّت لِيَ الأَيّام سَرجاً","وَلا قَطَعَت بِيَ العَيس القَفارا",54,"ر",2,0],["ولا شك أني قد نجوت وطالب لي","زماني وصحت لي جميع المآرب",55,"ب",1,0],["وَلا شَكَّ أَنَّ اللَهَ رافِعُ أَمرِهِ","وَمُعليهِ في الدُنيا وَيَومَ التَجادُلِ",56,"ل",1,0],["وَلا شَكَّ أَنَّ التُركَ يَنسَونَ رَميَهُم","بِطَعنٍ بِهِ أَنسَيتَ صَنهاجَةَ الزَرقا",57,"ق",2,0],["وَلا شَدّوا أَكُفَّهُمُ عَلَيها","لِتُؤخَذَ بِالخُصومَةِ وَالجِدالِ",58,"ل",1,0],["ولا شانها زقّ ولا سار سائر","بأجمالها كلا ولا نالها تجر",59,"ر",1,0],["ولا شيء خير للفتى من خضوعه","إذا لم يجد كرا يفيد ولا فرا",60,"ر",2,0],["وَلا شَكَّ مِنّا في التَأَسّي وَإِنَّما","نُعَزِّيكَ إِذ جاءَت بِذاكَ الشَرائِعُ",61,"ع",1,0],["وَلاَ شَرِبتُ بماءٍ تَشربينَ بِهِ","وَلاَ تجاورَ فِى الأمواتِ قَبرَانَا",62,"ن",2,0],["ولا شكر من أمال إذا","ما جاء يرجوك قبل يوم القيامه",63,"ه",1,0],["ولا شهد الناسون مني جناية","على الحب إلا أن يقال شهيد",64,"د",1,0],["ولأشكينك عند سلطان الهوى","ليعذبنك مثل ما عذبتني",65,"ن",2,0],["ولا شيءَ غيرَ المدحِ يَبْقَى لأنه","مقيمٌ جديدٌ والهدايا هوالكُ",66,"ك",1,0],["وَلا شَكَرتُ مُعلِناً حِباءَهُ","شُكرَ الرِياضِ لِلحَبِيِّ الماطِرِ",67,"ر",1,0],["وَلا شَكَّ في أَنَّني هارِبٌ","فَدَبِّر لِنَفسِكَ في كاتِبِ",68,"ب",1,0],["وَلا شوقي لكاظمة وَلكن","الى من ساد أمته وفاقا",69,"ق",2,0],["وَلا شيء مَعلوم وَلا الكَون مضيئة","وَلا الرزق مَقسوم وَلا الخلق افطار",70,"ر",1,0],["وَلا شَكَوتُ الَّذي فيهِ أُكابِدُهُ","إِلى عَذولِيَ إِلّا رَقَّ لي وَبَكى",71,"ك",2,0],["وَلا شَبَّتِ الحَربُ الأَجيجُ ضِرامَها","تُديرُ الرَحى دَورَ الحُروفِ بِهَوّازِ",72,"ز",1,0],["ولا شك أن المرء حيث صبارسا","فجحر لثعبان وخبت لغزلان",73,"ن",1,0],["ولا شيء في الدنيا بغير منافع","اذا دارت الافكار فيها لتبيان",73,"ن",1,0],["ولا شك في أن العقول محيلة ال","سامع والأبصار للحس رنت",74,"ت",1,0],["وَلا شَمَخَت بِأَنفي في المَلا عِظماً","وَلَم أَكُن في زَماني شاعِرَ الوالي",75,"ل",2,0],["ولا شاتم عرضا مصونا وان علا","ولا ناكح فرجا على وجه غية",76,"ه",1,0],["ولا شاهد بالزور إفكا وفرية","ولا قاذف للمحصنات بزنية",76,"ه",1,0],["وَلا شاهِداً مَعنىً لَكُم لَم يَغِب بِهِ","وَلا غائِباً فيكُم وَيَبدو لَهُ ظِلُّ",77,"ل",1,0],["وَلا شَدَّت ساجِعاتُ الوُرقِ في وَرَقِ ال","أَغصانِ إِلّا شَجَّتني فَوقَ أَشجاني",78,"ي",1,0],["وَلا شَهدت بِأَنَّ الشَهد ريقتها","حَتّى تَحقّقت فيهِ للأَنام شفا",79,"ف",2,0],["وَلا شين في نَجل الحسين محمّد","فَلا رَأبنا فيهِ الزَمان بِما نَكرَه",80,"ر",2,0],["ولا شَيءَ إلا مَا أُرِيدُ وَأشتَهِي","ولا عَائِقٌ مِن دُونِ ذَاكَ يَعُوقُ",81,"ق",1,0],["ولا شَكَّ أنّ البدْرَ في الأُفْقِ درْهمٌ","من النّثْرِ باقٍ في طَريقِ عُلاكا",82,"ك",2,0],["ولا شكوت بما أشكو إليك به","الفَقر والشَيب والتَزويج والجَربِ",83,"ب",1,0],["ولا شانه مذ قام تعليم مُفسدٍ","ولا غشه في النائبات عذول",84,"ل",1,0],["ولا شيء في الأعمال انجى لمسلم","كذكر كثير من عذابه في القبر",85,"ر",1,0],["ولاشَكَّ أنَّ المَرءَ طُعمَةُ دَهرِهِ","فما بالُهُ يا ويحَهُ يأمَنُ الدَّهْرا",86,"ر",2,0],["ولا شيء عندي وحقّ الهوى","أمرُّ من الهجر بعد الوصال",87,"ل",1,0],["ولا شاقني برقٌ يحاكي وميضه","ثناياك إذ أَصبو لها وأشيم",88,"م",1,0],["ولا شراباً كادَ من طيبِه","أن يُخْرجَ الميّتَ من رَمْسِه",89,"س",2,0],["ولا شكّ أنّ الجودَ للناسِ راحةٌ","كِلا ذا وذا منها لديكَ مواشِكُ",90,"ك",1,0],["ولأَشفِيَنَّ بِهَا سَقامَ تَغَرُّبِي","ولآسُوَنَّ بِهَا جراحَ مَصائبي",91,"ب",2,0],["ولا شكر عندي للذي لا له يد","علي ولا من إن تعوذت عوذا",92,"ذ",2,0],["ولا شك أن الردى مورد","وكل البرايا جميعاً ورود",93,"د",1,0],["ولا شدا طائر الا وضعت يدي","على فؤادي أظن القلب قد وقعا",94,"ع",2,0],["ولا شك أن البدر في الأفق كامل","وهذا نرى في كل عطف له بَدْرا",95,"ر",2,0],["ولأشرِجَنَّ عن العذول على الأسى","أُذُناً محرَّمةً على من لامَها",96,"م",3,0],["ولا شكا القائم في مكانه","منهم ولا عنّفهم ولا عذلْ",97,"ل",1,0],["ولا شرب المريَّةَ من رماكم","وإن هو ظنّ أن الماءَ طَرْقُ",98,"ق",1,0],["ولا شهدتَ اليومَ تغلي قِدرُه","لو لم يَصُبْ ماءُ الطُّلَى فيه احترقْ",99,"ق",1,0],["ولا شك في أن السيوف كثيرةٌ","وما يتساوى عضبها وكهامها",100,"م",3,0],["ولا شتَّ عامَ المحل شملُ سوامنا","فبتنا نرّجى رفد زيدٍ ولا عمر",101,"ر",1,0],["وَلا شادِنٌ تَرنُو بِهِ أُم شادِنٍ","بِجَوٍّ أَنيقِ النبتِ وَهوَ خَضيرُ",102,"ر",1,0],["ولا شاقني مِن بعدِما أوضعتْ بها","الى البينِ أعضادُ النجائبِ مَوضِعُ",103,"ع",1,0],["ولا شباب النبت فيها كالهرم","شتان ما بين الذُّنابى والقمم",104,"م",1,0],["ولا شهِدْتُ دونَهُمْ","أُمًّا لعَمْري وأَبَا",105,"ب",2,0],["ولا شيء يوازينا","سوى جهلٍ يُدانينا",106,"ن",2,0],["ولا شجانِيَ برقٌ في تبسُّمه","ولا جَنَيْتُ بسمعي شهدَةَ الغزَلِ",107,"ل",1,0],["ولا شهِدَتْ عيناهُ بينَ أحبّةٍ","ولا سمِعَتْ أُذْناهُ صوتَ النّوادِبِ",108,"ب",1,0],["ولاشك إلا أن همة يوسف","ستنجز ما قد كان لي من عداته",109,"ت",2,0],["ولا شكر لي فيما أقول لأنني","أعبر عما شرفوا وأنالوا",110,"ل",3,0],["ولا شَكَّ أَنَّ الأَصْلَ يَأْبَى مَقالَهُمْ","ومَنْ خالَفَ التَّأصيلَ عَنْ راجِحٍ يَهْوِي",111,"و",2,0],["ولا شَكّ أَنّ اللهَ للذّنْبِ غافِرٌ","ولكنْ لِرَجّاعٍ إليْه منَ النّاسِ",112,"س",1,0],["وَلا شَكَّ أَنَّ الذِّكْرَ في كُلِّ مَوْطِنٍ","عَلَى كُلِّ حالٍ شَرْعُهُ قَدْ تأْكّدا",113,"د",2,0],["وَلا شَرِبتمْ بِصفوٍ لا ولا عَلِقَتْ","لكمْ بنانٌ بأزمانٍ أراغيدِ",114,"د",1,0],["ولا شيء نحن ولكن لها","نسبنا فنحن بها أجمع",115,"ع",1,0],["ولا شك أن المؤمن البر ناظر","بنورٍ من الرحمن لا يتأول",116,"ل",1,0],["ولا شَكَّ أَن الشَّمْسَ أَبينُ طلعةً","تَراها ولكن فضلُه كان أَبْينَا",117,"ن",2,0],["ولا شَكَّ أَن الجُودَ قد حارَ قبلَه","من الناس لكن جودُه صَار دَيْدنا",117,"ن",2,0],["ولا شك في أَن الديارَ كأَهلِها","كما قيل تَشْقى في الزمانِ وتَنْعَمُ",118,"م",1,0],["ولا شَكَّ في إِحْسانِهِ مُتأَوِّلٌ","وَلا ارتابَ في حُسْنٍ لَهُ مُتَأَمِّلُ",119,"ل",1,0]]}