{"poems":[[53,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[63,"نظرت بألحاظ الظباء العين","https://www.aldiwan.net/poem46160.html","الكامل"],[77,"بنفسي وما نفسي علي بهينة","https://www.aldiwan.net/poem36063.html","الطويل"],[77,"لعمرك ما أغار على عدو","https://www.aldiwan.net/poem36485.html","الطويل"],[86,"قصرت عليك العمر وهو قصير","https://www.aldiwan.net/poem68948.html","الطويل"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[27,"أدار الجميع الصالحين بذي السدر","https://www.aldiwan.net/poem5770.html","الطويل"],[4,"أتيناك يا خير البرية كلها","https://www.aldiwan.net/poem21192.html","الطويل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[47,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[72,"بعثت به واثقا أن لي","https://www.aldiwan.net/poem19245.html","المتقارب"],[72,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[51,"رخصت معاملتي على رجل","https://www.aldiwan.net/poem64939.html","أحذ الكامل"],[51,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[51,"يا من عكفنا عليه لائذين به","https://www.aldiwan.net/poem66386.html","البسيط"],[26,"تالله يبقى على الأيام مبتقل","https://www.aldiwan.net/poem24086.html","البسيط"],[78,"كذا يهلك السيف في جفنه","https://www.aldiwan.net/poem14220.html","المتقارب"],[85,"على قدر الهوى يأتي العتاب","https://www.aldiwan.net/poem6820.html","الوافر"],[43,"ألا أذن فما أذكرت ناسي","https://www.aldiwan.net/poem9610.html","الوافر"],[43,"تذكرت ما بين العذيب وبارق","https://www.aldiwan.net/poem9734.html","الطويل"],[62,"خليلي لا راع الفراق حشاكما","https://www.aldiwan.net/poem52272.html","الطويل"],[62,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[45,"حرمت رضاك من عدمي وخسري","https://www.aldiwan.net/poem63561.html","الوافر"],[45,"حييتما من مربع ومصيف","https://www.aldiwan.net/poem65158.html","الطويل"],[28,"كفاك بحول من عزيز وقوة","https://www.aldiwan.net/poem5458.html","الطويل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[49,"أشد الجهاد جهاد الهوى","https://www.aldiwan.net/poem10319.html","المتقارب"],[80,"وريحانة في النفس منبت غصنها","https://www.aldiwan.net/poem31410.html","الطويل"],[44,"عياش زف إليك جهد جاهد","https://www.aldiwan.net/poem30050.html","الكامل"],[44,"تحمل عنه الصبر يوم تحملوا","https://www.aldiwan.net/poem30377.html","الطويل"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[33,"ولا شوق حتى يلصق الجلد بالحشا","https://www.aldiwan.net/poem25733.html","الطويل"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"أحب الشمال إذا أقبلت","https://www.aldiwan.net/poem62419.html","المتقارب"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[48,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[46,"جدث أريح وأستريح بلحده","https://www.aldiwan.net/poem22345.html","الكامل"],[46,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[46,"وجدت سجايا الفضل في الناس غربة","https://www.aldiwan.net/poem23585.html","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[80,"وريحانة ٍ في النفس منبتُ غصنها","https://www.poetsgate.com/ViewPoem.aspx?id=3323",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""]],"verses":[["وَلا شَرِبوا إِلّا دَماً بَعدَهُ وَلا","تَحابوا بِغَيرِ الزاعِبِيِّ المُقَصَّدِ",0,"د",1,0],["ولأَشْكُرَنّ نَداكَ شُكْرَ خَميلَةٍ","لندىً يُرَقْرِقُهُ الغَمامُ هَتونِ",1,"ن",1,0],["وَلاَ شَعَرَتْ مِنْ قَبْلِهِ بِتَشَوُّقٍ","تَخَلَّلَ مِنْهَا بَيْنَ رُوحٍ وَجْثْمَانِ",2,"ن",1,0],["ولا شَرَحَتْ مدوَّنَةَ المَعالي","سِوى فُتْيا أبي الحَسَنِ الصّغيرِ",3,"ر",1,0],["وَلا شَرَعَت هَذا اليَراعَ أَنامِلي","لِشَكوى وَلَكِنَّ اللَجاجَ يُثيرُ",4,"ر",1,0],["وَلَأَشكُرَنَّ حَوادِثاً قَذَفَت بِآ","مالي إِلى الملكِ الهمامِ الأَروَعِ",5,"ع",1,0],["وَلا شَمطاءُ لَم يَترُك شَقاه","لَها مِن تِسعَةٍ إَلّا جَنينا",6,"ن",2,0],["وَلا شَهِدَتنا يَومَ جَيشِ مُحَرِّقٍ","طُهَيَّةُ فُرسانُ الوَقيدِيَّةِ الشُقرِ",7,"ر",1,0],["وَلا شَهِدَت يَومَ النَقا خَيلُ هاجَرٍ","وَلا السيدُ إِذ يَنحِطنَ في الأَسَلِ الحُمرِ",7,"ر",1,0],["وَلا شَيءَ مِمّا يَأكُلُ الناسُ عِندَنا","سِوى العِلهَزِ العامِيِّ وَالعَبهَرِ الفَسلِ",8,"ل",1,0],["ولا شَجِيجٌ أقَامَ في دِمنَةِ ال","مَنزِلِ لا نَاكِحٌ ولا عَزَبٌ",9,"ب",1,0],["ولا شحيح اقام في دمن","ة المنزل لا ناكح ولا عزب",10,"ب",1,0],["وَلا شُدَّ لي سَرجٌ عَلى ظَهرِ سابِحٍ","وَلا ضُرِبَت لي بِالعَراءِ قِبابُ",11,"ب",1,0],["ولا شيء أحسن من مالك","تجود يداه على شافع",12,"ع",1,0],["ولا شفق الأصباح ماء وقهوة","ولا الطير في دوح على العود مرنان",13,"ن",1,0],["ولأشربنَّ على تنقُّصِهِ","حتى كأني لستُ منتقِصا",14,"ص",2,0],["ولا شِعر إلا ما يُقفَّى رويُّه","إذا قام بالشعر الرواةُ المقاوما",15,"م",2,0],["ولا شَقِينا بوعدٍ منك يتبعُهُ","مَطلٌ ولا كنتَ إلا صافي المِننِ",16,"ن",1,0],["وَلا شَبوبٌ مِنَ الثيرانِ أَفرَدَهُ","عَن كَورِهِ كَثرَةُ الإِغراءِ وَالطَرَدُ",17,"د",1,0],["ولا شرفٌ يَرحَمُ المُشرفيّ","مِمّا بِهِ مِن شَمات الوَتينِ",18,"ن",1,0],["ولا شمسا برأس التنين حلّت","وفي الدنيا ضحاها واللعاب",19,"ب",1,0],["وَلا شُغِلَ الأَميرُ عَنِ المَعالي","وَلا عَن حَقِّ خالِقِهِ بِكاسِ",20,"س",1,0],["وَلا شَغَلوا صُمَّ القَنا بِقُلوبِهِم","عَنِ الرِكزِ لَكِن عَن قُلوبِ الدَماسِقِ",21,"ق",1,0],["ولا شجوَ إلّا أنّ سَجْلي سقاكُما","وأنّكما يُعطَى سوايَ حيَاكما",22,"م",2,0],["ولا شِينتِ الدّنيا بيومكَ إنَّما","بقاؤك فيها غُرَّةٌ وحُجُولُ",23,"ل",1,0],["وَلأَشكرنَّ جميلَ ما أوليتَني","شُكراً تسيرُ بذكرهِ الأشعارُ",24,"ر",1,0],["وَلا شَرقَ اِمتِنانَكَ نَقصُ شُكري","وَلا غَطّى عَلى نُعماكَ كُفري",25,"ي",1,0],["وَلَأَشكُرَنَّ أَبا عَلِيَّ إِنَّ مِن","جَدوى يَدَيهِ تالِدي وَطَريفي",26,"ف",2,0],["وَلا شَيءَ شَرٌّ مِن شَريرَةِ خائِنٍ","يَجيءُ بِها يَومَ اِبتِلاءَ المَحاصِلِ",27,"ل",1,0],["وَلا شارَكوا في القَومِ في دَمِ نَوفَلٍ","وَلا وَهَبٍ مِنهُم وَلا اِبنِ المُحَزَّمِ",28,"م",1,0],["وَلا شَيءَ إِلّا لَهُ آفَةٌ","وَلا شَيءَ إِلّا لَهُ مُنتَهى",29,"ا",1,0],["ولا شكّ أنَّ الماء رطبٌ وكلّما","سَقَيْتَ حديداً فيه زادَ به يُبْسا",30,"س",2,0],["وَلَأُشهِرَنَّ عَلَيكَ شُنعَ أَوابِدٍ","يُحسَبنَ أَسيافاً وَهُنَّ قَصائِدُ",31,"د",1,0],["وَلا شَكَّ أَنَّ الخَيرَ مِنكَ سَجِيَّةٌ","وَلَكِنَّ خَيرَ الخَيرِ عِندي المُعَجَّلُ",32,"ل",1,0],["وَلا شَاقَنِي بَرْقٌ تَأَلَّقَ مَوْهِنَاً","كَزَنْدٍ تُوَالِي قَدْحَهُ كَفُّ ضَارِمِ",33,"م",1,0],["وَلا شِمتُ إِلّا غُرَّةً فَوقَ شُقرَةٍ","فَقُلتُ حَبابٌ يَستَديرُ عَلى خَمرِ",34,"ر",1,0],["وَلا شَرَفُ المَرءِ غَيرُ النُهى","وَإِلّا فَحَيثُ الوُجودُ العَدَم",35,"م",1,0],["وَلا شَوقَ حَتّى يَلصَقَ الجِلدُ بِالحَشا","وَتَصمُتَ حَتّى لا تُجيبُ المُنادِيا",36,"ي",2,1],["وَلاَ شَجَرٌ فِي الأرضِ إلاَّ مِنَ القَنَا","وَلاَ أنجُمٌ فِي الأفقِ إلاَّ المَنَاصِلُ",37,"ل",1,0],["ولا شَكَرْتُهُم مِنْ بَعْدِ ذَمِّهِمُ","كأنهم آمَنُوا مِنْ بَعْدِ ما كَفَرُوا",38,"ر",3,0],["وَلاشَكَّ أَنَّ كَذا فِعلُهُ","إِذا ما تَلَقَّتهُ ريحُ الجَنوبِ",39,"ب",1,0],["وَلا شُبوبٌ باتَت تُؤَرِّقُهُ ال","نَثرَةُ مِنها بِوابِلٍ قَصِفِ",40,"ف",1,0],["وَلا شَتَوتُ بِها عاماً فَأَدرَكَني","فيها المَصيفُ فَلي عَن ذاكَ مُرتَحَلُ",41,"ل",1,0],["وَلا شَدَدتُ بِها مِن خَيمَةٍ طُنُباً","جارى بِها الضَبُّ وَالحِرباءُ وَالوَرَلُ",41,"ل",1,0],["وَلا شَوَينا وَرَلاً","مُنَضنِضاً بِالذَنَبِ",42,"ب",1,0],["وَلَأَشرَبَنَّ مِنَ الحِمامِ كُؤوسَهُ","ما بَينَ جامِدِهِ وَبَينَ مُذابِهِ",43,"ب",2,0],["وَلا شَلّالِ عاناتٍ خِماصٍ","وَلَكِن خَيلِ جَيشٍ مُرجَحَنِّ",44,"ن",1,0],["وَلا شَيءَ مِثلُ الخَيرِ يُزمَعُ تَركُهُ","وَيُصبِحُ مَبذولاً لِمُكتَسِبيهِ",45,"ب",3,0],["وَلا شَمطاءُ لَم يَترُك شَقاها","لَها مِن تِسعَةٍ إَلّا جَنينا",46,"ن",2,0],["وَلاَ شِعْرَ بَعْدَ اليَوْمِ صَافٍ بَيَانُهُ","يُعِيدُ لَنَا أَخْفَى المَعَانِي مُمَثَّلاَ",47,"ل",2,0],["وَلا شَكَّ قَلبي ساعَةً في اِعتِقادِهِ","وَلا شابَ ظَنّي قَطُّ فيهِ الشَوائِبُ",48,"ب",1,0],["ولا شكَت الأرض من حملها","ولا ضاق بالناس رحبُ الفضاء",49,"ا",2,0],["ولا شعبٌ تحكَّم في سواه","ولا عانٍ برجليه شِكال",50,"ل",1,0],["ولاشيتُ نفسيَ في الأبعدين","أُفكّرُ فيهمْ ، وفي الأقرب!",51,"ب",1,0],["ولا شكّ أنَّ الماء رطبٌ وكلما","شقيتَ حديداً فيه زاد به يُبسا",52,"س",2,0],["وَلاَ شَارَكَتْ فِي المَوْتِ فِي دَمِ نَوْفَلٍ","وَلاَ وَهَبٍ مِنْهَا وَلا ابْنِ المُخَزَّمِ",53,"م",1,0]]}