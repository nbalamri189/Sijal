بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5353,"عندما ماتَ الشّاعرُ بينَ يديه ِ","https://www.poetsgate.com/ViewPoem.aspx?id=212466",""],[5358,"لكِ الأمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=202300",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5455,"وحده بوحده","https://www.poetsgate.com/ViewPoem.aspx?id=34435",""],[5463,"نظرة إرتياب","https://www.poetsgate.com/ViewPoem.aspx?id=33839",""],[5573,"عشنا عيال احرار","https://www.poetsgate.com/ViewPoem.aspx?id=201930",""],[5582,"أَهْدَى لَكَ الشَّوْقَ وَالتِّذْكارَ وَالوَصَبا","https://www.poetsgate.com/ViewPoem.aspx?id=63462",""],[5587,"أتعبني الهروب","https://www.poetsgate.com/ViewPoem.aspx?id=196679",""],[5616,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=205249",""],[5629,"ماني شبيهة","https://www.poetsgate.com/ViewPoem.aspx?id=184488",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5785,"قيلوا بنا تحت الظلال الظليل","https://www.poetsgate.com/ViewPoem.aspx?id=131567",""],[5804,"طبّاخ","https://www.poetsgate.com/ViewPoem.aspx?id=214750",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5845,"تجلتْ لوحدانية ِ الحقِّ أنوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=15448",""],[5893,"على الشِّدة صبور","https://www.poetsgate.com/ViewPoem.aspx?id=141385",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[1920,"ربيع لا يتاجر بالسلاح","https://www.poetsgate.com/ViewPoem.aspx?id=191410",""],[6038,"نون 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25700",""],[6056,"عديم المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130516",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6183,"شموخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79825&r=&rc=15",""],[463,"أروَّضَ الوادي أمْ ابيضَّ الغسقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60167&r=&rc=223",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["وَلا شَرِبوا إِلّا دَماً بَعدَهُ وَلا","تَحابوا بِغَيرِ الزاعِبِيِّ المُقَصَّدِ",0,"د",1,0],["ولأَشْكُرَنّ نَداكَ شُكْرَ خَميلَةٍ","لندىً يُرَقْرِقُهُ الغَمامُ هَتونِ",1,"ن",1,0],["وَلاَ شَعَرَتْ مِنْ قَبْلِهِ بِتَشَوُّقٍ","تَخَلَّلَ مِنْهَا بَيْنَ رُوحٍ وَجْثْمَانِ",2,"ن",1,0],["ولا شَرَحَتْ مدوَّنَةَ المَعالي","سِوى فُتْيا أبي الحَسَنِ الصّغيرِ",3,"ر",1,0],["وَلا شَرَعَت هَذا اليَراعَ أَنامِلي","لِشَكوى وَلَكِنَّ اللَجاجَ يُثيرُ",4,"ر",1,0],["وَلَأَشكُرَنَّ حَوادِثاً قَذَفَت بِآ","مالي إِلى الملكِ الهمامِ الأَروَعِ",5,"ع",1,0],["وَلا شَمطاءُ لَم يَترُك شَقاه","لَها مِن تِسعَةٍ إَلّا جَنينا",6,"ن",2,0],["وَلا شَهِدَتنا يَومَ جَيشِ مُحَرِّقٍ","طُهَيَّةُ فُرسانُ الوَقيدِيَّةِ الشُقرِ",7,"ر",1,0],["وَلا شَهِدَت يَومَ النَقا خَيلُ هاجَرٍ","وَلا السيدُ إِذ يَنحِطنَ في الأَسَلِ الحُمرِ",7,"ر",1,0],["وَلا شَيءَ مِمّا يَأكُلُ الناسُ عِندَنا","سِوى العِلهَزِ العامِيِّ وَالعَبهَرِ الفَسلِ",8,"ل",1,0],["ولا شَجِيجٌ أقَامَ في دِمنَةِ ال","مَنزِلِ لا نَاكِحٌ ولا عَزَبٌ",9,"ب",1,0],["ولا شحيح اقام في دمن","ة المنزل لا ناكح ولا عزب",10,"ب",1,0],["وَلا شُدَّ لي سَرجٌ عَلى ظَهرِ سابِحٍ","وَلا ضُرِبَت لي بِالعَراءِ قِبابُ",11,"ب",1,0],["ولا شيء أحسن من مالك","تجود يداه على شافع",12,"ع",1,0],["ولا شفق الأصباح ماء وقهوة","ولا الطير في دوح على العود مرنان",13,"ن",1,0],["ولأشربنَّ على تنقُّصِهِ","حتى كأني لستُ منتقِصا",14,"ص",2,0],["ولا شِعر إلا ما يُقفَّى رويُّه","إذا قام بالشعر الرواةُ المقاوما",15,"م",2,0],["ولا شَقِينا بوعدٍ منك يتبعُهُ","مَطلٌ ولا كنتَ إلا صافي المِننِ",16,"ن",1,0],["وَلا شَبوبٌ مِنَ الثيرانِ أَفرَدَهُ","عَن كَورِهِ كَثرَةُ الإِغراءِ وَالطَرَدُ",17,"د",1,0],["ولا شرفٌ يَرحَمُ المُشرفيّ","مِمّا بِهِ مِن شَمات الوَتينِ",18,"ن",1,0],["ولا شمسا برأس التنين حلّت","وفي الدنيا ضحاها واللعاب",19,"ب",1,0],["وَلا شُغِلَ الأَميرُ عَنِ المَعالي","وَلا عَن حَقِّ خالِقِهِ بِكاسِ",20,"س",1,0],["وَلا شَغَلوا صُمَّ القَنا بِقُلوبِهِم","عَنِ الرِكزِ لَكِن عَن قُلوبِ الدَماسِقِ",21,"ق",1,0],["ولا شجوَ إلّا أنّ سَجْلي سقاكُما","وأنّكما يُعطَى سوايَ حيَاكما",22,"م",2,0],["ولا شِينتِ الدّنيا بيومكَ إنَّما","بقاؤك فيها غُرَّةٌ وحُجُولُ",23,"ل",1,0],["وَلأَشكرنَّ جميلَ ما أوليتَني","شُكراً تسيرُ بذكرهِ الأشعارُ",24,"ر",1,0],["وَلا شَرقَ اِمتِنانَكَ نَقصُ شُكري","وَلا غَطّى عَلى نُعماكَ كُفري",25,"ر",2,0],["وَلَأَشكُرَنَّ أَبا عَلِيَّ إِنَّ مِن","جَدوى يَدَيهِ تالِدي وَطَريفي",26,"ف",2,0],["وَلا شَيءَ شَرٌّ مِن شَريرَةِ خائِنٍ","يَجيءُ بِها يَومَ اِبتِلاءَ المَحاصِلِ",27,"ل",1,0],["وَلا شارَكوا في القَومِ في دَمِ نَوفَلٍ","وَلا وَهَبٍ مِنهُم وَلا اِبنِ المُحَزَّمِ",28,"م",1,0],["وَلا شَيءَ إِلّا لَهُ آفَةٌ","وَلا شَيءَ إِلّا لَهُ مُنتَهى",29,"ا",1,0],["ولا شكّ أنَّ الماء رطبٌ وكلّما","سَقَيْتَ حديداً فيه زادَ به يُبْسا",30,"س",2,0],["وَلَأُشهِرَنَّ عَلَيكَ شُنعَ أَوابِدٍ","يُحسَبنَ أَسيافاً وَهُنَّ قَصائِدُ",31,"د",1,0],["وَلا شَكَّ أَنَّ الخَيرَ مِنكَ سَجِيَّةٌ","وَلَكِنَّ خَيرَ الخَيرِ عِندي المُعَجَّلُ",32,"ل",1,0],["وَلا شَاقَنِي بَرْقٌ تَأَلَّقَ مَوْهِنَاً","كَزَنْدٍ تُوَالِي قَدْحَهُ كَفُّ ضَارِمِ",33,"م",1,0],["وَلا شِمتُ إِلّا غُرَّةً فَوقَ شُقرَةٍ","فَقُلتُ حَبابٌ يَستَديرُ عَلى خَمرِ",34,"ر",1,0],["وَلا شَرَفُ المَرءِ غَيرُ النُهى","وَإِلّا فَحَيثُ الوُجودُ العَدَم",35,"م",1,0],["وَلا شَوقَ حَتّى يَلصَقَ الجِلدُ بِالحَشا","وَتَصمُتَ حَتّى لا تُجيبُ المُنادِيا",36,"ي",2,1],["وَلاَ شَجَرٌ فِي الأرضِ إلاَّ مِنَ القَنَا","وَلاَ أنجُمٌ فِي الأفقِ إلاَّ المَنَاصِلُ",37,"ل",1,0],["ولا شَكَرْتُهُم مِنْ بَعْدِ ذَمِّهِمُ","كأنهم آمَنُوا مِنْ بَعْدِ ما كَفَرُوا",38,"ر",3,0],["وَلاشَكَّ أَنَّ كَذا فِعلُهُ","إِذا ما تَلَقَّتهُ ريحُ الجَنوبِ",39,"ب",1,0],["وَلا شُبوبٌ باتَت تُؤَرِّقُهُ ال","نَثرَةُ مِنها بِوابِلٍ قَصِفِ",40,"ف",1,0],["وَلا شَتَوتُ بِها عاماً فَأَدرَكَني","فيها المَصيفُ فَلي عَن ذاكَ مُرتَحَلُ",41,"ل",1,0],["وَلا شَدَدتُ بِها مِن خَيمَةٍ طُنُباً","جارى بِها الضَبُّ وَالحِرباءُ وَالوَرَلُ",41,"ل",1,0],["وَلا شَوَينا وَرَلاً","مُنَضنِضاً بِالذَنَبِ",42,"ب",1,0],["وَلَأَشرَبَنَّ مِنَ الحِمامِ كُؤوسَهُ","ما بَينَ جامِدِهِ وَبَينَ مُذابِهِ",43,"ب",2,0],["وَلا شَلّالِ عاناتٍ خِماصٍ","وَلَكِن خَيلِ جَيشٍ مُرجَحَنِّ",44,"ن",1,0],["وَلا شَيءَ مِثلُ الخَيرِ يُزمَعُ تَركُهُ","وَيُصبِحُ مَبذولاً لِمُكتَسِبيهِ",45,"ب",3,0],["وَلا شَمطاءُ لَم يَترُك شَقاها","لَها مِن تِسعَةٍ إَلّا جَنينا",46,"ن",2,0],["وَلاَ شِعْرَ بَعْدَ اليَوْمِ صَافٍ بَيَانُهُ","يُعِيدُ لَنَا أَخْفَى المَعَانِي مُمَثَّلاَ",47,"ل",2,0],["وَلا شَكَّ قَلبي ساعَةً في اِعتِقادِهِ","وَلا شابَ ظَنّي قَطُّ فيهِ الشَوائِبُ",48,"ب",1,0],["ولا شكَت الأرض من حملها","ولا ضاق بالناس رحبُ الفضاء",49,"ا",2,0],["ولا شعبٌ تحكَّم في سواه","ولا عانٍ برجليه شِكال",50,"ل",1,0],["ولا شرفوا الا بخالصة التقى","حظوظهم منها البحور الجوامع",51,"ع",1,0],["ولا شفني حب لغيداء كاعب","كما ارتاع خشف في الخميلة باغم",52,"م",1,0],["ولا شيء غير جدار يقوم","بوجهي وثان يعدّ الركب",53,"ب",1,0],["ولاشيتُ نفسيَ في الأبعدين","أُفكّرُ فيهمْ ، وفي الأقرب!",54,"ب",1,0],["ولا شكّ أنَّ الماء رطبٌ وكلما","شقيتَ حديداً فيه زاد به يُبسا",55,"س",2,0],["ولأشهدنّ بكل فجّ معقلا","للظلم زعزعه القضاء فطاحا",56,"ح",2,0],["وَلاَ شَارَكَتْ فِي المَوْتِ فِي دَمِ نَوْفَلٍ","وَلاَ وَهَبٍ مِنْهَا وَلا ابْنِ المُخَزَّمِ",57,"م",1,0],["وَلا شَدَّت لِيَ الأَيّام سَرجاً","وَلا قَطَعَت بِيَ العَيس القَفارا",58,"ر",2,0],["ولا شك أني قد نجوت وطالب لي","زماني وصحت لي جميع المآرب",59,"ب",1,0],["وَلا شَكَّ أَنَّ اللَهَ رافِعُ أَمرِهِ","وَمُعليهِ في الدُنيا وَيَومَ التَجادُلِ",60,"ل",1,0],["وَلا شَكَّ أَنَّ التُركَ يَنسَونَ رَميَهُم","بِطَعنٍ بِهِ أَنسَيتَ صَنهاجَةَ الزَرقا",61,"ق",2,0],["وَلا شَدّوا أَكُفَّهُمُ عَلَيها","لِتُؤخَذَ بِالخُصومَةِ وَالجِدالِ",62,"ل",1,0],["ولا شانها زقّ ولا سار سائر","بأجمالها كلا ولا نالها تجر",63,"ر",1,0],["ولا شيء خير للفتى من خضوعه","إذا لم يجد كرا يفيد ولا فرا",64,"ر",2,0],["وَلا شَكَّ مِنّا في التَأَسّي وَإِنَّما","نُعَزِّيكَ إِذ جاءَت بِذاكَ الشَرائِعُ",65,"ع",1,0],["وَلاَ شَرِبتُ بماءٍ تَشربينَ بِهِ","وَلاَ تجاورَ فِى الأمواتِ قَبرَانَا",66,"ن",2,0],["ولا شكر من أمال إذا","ما جاء يرجوك قبل يوم القيامه",67,"ه",1,0],["ولا شهد الناسون مني جناية","على الحب إلا أن يقال شهيد",68,"د",1,0],["ولأشكينك عند سلطان الهوى","ليعذبنك مثل ما عذبتني",69,"ن",2,0],["ولا شيءَ غيرَ المدحِ يَبْقَى لأنه","مقيمٌ جديدٌ والهدايا هوالكُ",70,"ك",1,0],["وَلا شَكَرتُ مُعلِناً حِباءَهُ","شُكرَ الرِياضِ لِلحَبِيِّ الماطِرِ",71,"ر",1,0],["وَلا شَكَّ في أَنَّني هارِبٌ","فَدَبِّر لِنَفسِكَ في كاتِبِ",72,"ب",1,0],["وَلا شوقي لكاظمة وَلكن","الى من ساد أمته وفاقا",73,"ق",2,0],["وَلا شيء مَعلوم وَلا الكَون مضيئة","وَلا الرزق مَقسوم وَلا الخلق افطار",74,"ر",1,0],["وَلا شَكَوتُ الَّذي فيهِ أُكابِدُهُ","إِلى عَذولِيَ إِلّا رَقَّ لي وَبَكى",75,"ك",2,0],["وَلا شَبَّتِ الحَربُ الأَجيجُ ضِرامَها","تُديرُ الرَحى دَورَ الحُروفِ بِهَوّازِ",76,"ز",1,0],["ولا شك أن المرء حيث صبارسا","فجحر لثعبان وخبت لغزلان",77,"ن",1,0],["ولا شيء في الدنيا بغير منافع","اذا دارت الافكار فيها لتبيان",77,"ن",1,0],["ولا شك في أن العقول محيلة ال","سامع والأبصار للحس رنت",78,"ت",1,0],["وَلا شَمَخَت بِأَنفي في المَلا عِظماً","وَلَم أَكُن في زَماني شاعِرَ الوالي",79,"ل",2,0],["ولا شاتم عرضا مصونا وان علا","ولا ناكح فرجا على وجه غية",80,"ه",1,0],["ولا شاهد بالزور إفكا وفرية","ولا قاذف للمحصنات بزنية",80,"ه",1,0],["وَلا شاهِداً مَعنىً لَكُم لَم يَغِب بِهِ","وَلا غائِباً فيكُم وَيَبدو لَهُ ظِلُّ",81,"ل",1,0],["وَلا شَدَّت ساجِعاتُ الوُرقِ في وَرَقِ ال","أَغصانِ إِلّا شَجَّتني فَوقَ أَشجاني",82,"ن",2,0],["وَلا شَهدت بِأَنَّ الشَهد ريقتها","حَتّى تَحقّقت فيهِ للأَنام شفا",83,"ف",2,0],["وَلا شين في نَجل الحسين محمّد","فَلا رَأبنا فيهِ الزَمان بِم