9961",""],[4954,"سيَبْكيني إذا حَلّ الْمَغيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208830",""],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5337,"كم قد تؤمل نفس نيل منيتها","https://www.poetsgate.com/ViewPoem.aspx?id=171247",""],[5376,"كأنِّي أنا والبحرُ والطيرُ في هوى","https://www.poetsgate.com/ViewPoem.aspx?id=188428",""],[5596,"تحية الى العيينة واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=206718",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[5701,"ودنيا الورى فندق للورى","https://www.poetsgate.com/ViewPoem.aspx?id=164636",""],[402,"حب وما كان في الصبا جهلا","https://www.poetsgate.com/ViewPoem.aspx?id=36185",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[6149,"أناخ على قلبي الكآبة والكرب","https://www.poetsgate.com/ViewPoem.aspx?id=169622",""],[5377,"لحظات الإشراق الفني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79566&r=&rc=22",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""]],"verses":[["وَكُلَّ لَيلٍ تُضِلُّ النُجمَ ظُلمَتُهُ","قَلبُ الدَليلِ بِهِ حَيرانُ مَزؤودُ",0,"د",1,0],["وَكُلُّ لَفْظٍ كَدُرٍّ","يَصِيدُهُ السَّامِعُونَا",1,"ن",2,0],["وكلُّ لهوٍ بمثل وصلكُمُ","ذو غُرر إذ سواه ذو عُرَرِ",2,"ر",1,0],["وكل لهوٍ لَهاه الناسُ مَشغلةٌ","عن ذكر ما هم من الأحداث لاقونا",3,"ن",2,0],["وَكُلُّ لَيثٍ قَد رَمى","بِهِ الإِمامُ في العِدا",4,"د",2,0],["وَكُلٌّ لَهُ فَضلُهُ وَالجُحو","لُ يَومَ التَفاضُلِ دونَ الغُرَر",5,"ر",1,0],["وَكُلٌّ لَهُ مُدَّةٌ تَنقَضي","وَكُلٌّ لَهُ أَثَرٌ يُكتَبُ",6,"ب",1,0],["وَكُلٌّ لِاعتِسافِ الدَه","رِ مُعرِضَةٌ مَقاتِلُهُ",7,"ل",2,0],["وَكُلِّ لَحظٍ أَتى بِاِسمِ اِبنِ ذي يَزَنٍ","في فَتكِهِ بِالمُعنّى أَو أَبي هَرِمِ",8,"م",1,0],["وَكَلَّلَ الطَلُّ أَوراقَ الغُصونِ ضُحىً","كَما تَكَلَّلَ خَدُّ الخَودِ بِالعَرَقِ",9,"ق",1,0],["وكلُّ لَحظٍ مرسلٍ للورى","يد المداوي فوقَ آلامِ",10,"م",1,0],["وَكُلُّ لَونٍ فَليَكُن ما خَلا ال","أَشهَبَ فَالشُهبَةُ لَونٌ لَبيس",11,"س",1,0],["وَكُلٌّ لَهُ في جانِبِ المُلكِ مَسلَكٌ","كَريمٌ وَمِن نَفسِ الإِمارَةِ مَوقِعُ",12,"ع",1,0],["وَكُلُّ لُؤمٍ يُبيدُ الدَهرُ أَثلَتَهُ","وَلُؤمُ ضَبَّةَ لَم يَنقُص وَلَم يَبِدِ",13,"د",1,0],["وكلّ ليثٍ غضوبٍ مثل عاصفة","منه يطيرون ألباباً وأبصارا",14,"ر",2,0],["وَكُلِّ لَفْظٍ فِي طيِّ نَابِتَةٍ","كَالروحِ فِي جِسْمِ بَهْجةٍ حَلاَّ",15,"ل",2,0],["وكل لَذَاذَة تفني، وَيَبْقَى","متاعُ الخُلدِ في دار النعيم",16,"م",1,0],["وكل لجاج المرء في الشر نهمة","من النفس تغريها عليه الطبائع",17,"ع",1,0],["وَكُلٌّ لَهُ فَضْلُهُ والحُجُولُ","يَوْمَ التّفَاضُلِ، دُونَ الغُرَرْ",18,"ر",1,0],["وكلّ لب مثل قلبي له","حسناء ترجوه ويرجوها",19,"ه",2,0],["وكل له رغم المحرف صبغة","حقيقتها الخلصاء لا تتغير",20,"ر",1,0],["وكلٌّ له (ولَّادةٌ) غيرَ أنّني","أُداري الهَوى الغَلّابَ جَهْلًا ولا أَعِي",21,"ع",2,0],["وَكُلُّ لَجوجٍ في العِناقِ كَأَنَّها","إِذا اِغتَمَسَت في الماءِ فَتخاءُ كاسِرُ",22,"ر",1,1],["وكل ليالي في الدهر صارت","بيمنك في الورى ليلات قدر",23,"ر",1,0],["وكل لبيب أخي فطنة","يسائل عن شرح أخباره",24,"ر",2,0],["وكل لطيفة حسنَت وطابت","ستلقى من غدٍ في المستراح",25,"ح",1,0],["وكلّ ليمونة تحكي بظاهرها","لونَ المحبِّ إذا ما بات مهجوراً",26,"ر",2,0],["وَكُلُّ لَدنٍ كَأَنَّهُ شَطَنٌ","يَكادُ يُثنى ليناً وَيَنعَقِدُ",27,"د",1,0],["وكل له في كل ارض كفاية","ولكن طرفاً لا يراك كفيف",28,"ف",1,0],["وَكُلٌّ لَهُ وَخدٌ يخالِفُ سَيرَهُ","يُمَيِّلُهُ تِلقاءهُ فَيَميلُ",29,"ل",1,0],["وكل له قول وكل له منى","وكل له فعل وكل له عانى",30,"ن",2,0],["وكل له رأى وكل له هوى","ولكن كلا في مطابقة الشان",30,"ن",1,0],["وكل له عقل يسدده إلى","مقاصد أفعال وترك شديدة",31,"ه",1,0],["وكلٌّ له العُذْرُ فيما أتَى","كذلكَ يَعتقدُ المُؤْمنونا",32,"ن",2,0],["وكلُّ له في أوَّلِ الشّوطِ مَرْحَةٌ","ولكنْ يَبيِنُ السّبقُ في آخِرِ المَدى",33,"د",2,0],["وَكُلُّ لَيلٍ يُرجى لَهُ سَحَرٌ","وَلَيلُ مَن فارَقوا بِلا سَحَرِ",34,"ر",1,0],["وكلٌّ لَه شِعرٌ ولكِنَّ مَسلَكي","عَلَيهِ وإن نالَ المشَقَّةَ شاسِعُ",35,"ع",1,0],["وكلٌّ له منه ما يستحق","بوزن الرجال ورجحانها",36,"ن",3,0],["وكلٌّ لمطلوب الردى وهو لاعب","كأنَّ المنايا لا تجدُّ بلاعب",37,"ب",1,0],["وكل ليل لهُ من ذاته سحرٌ","وللبكور من الأيام أصالُ",38,"ل",1,0],["وكِلْ لله أمرَك إنه في","جميع الخلق يفعلُ ما يشاءُ",39,"ا",2,0],["وكل لسان فيك بالذكر منتج","وبالهجر والعصيان منك عقيم",40,"م",1,0],["وكل له وقت فما عنه فمرحل","وليس له عن يومه الفرد مفرد",41,"د",1,0],["وكل له رأي وفكر ومنهج","فهذا عميد في الهوى وعقيد",42,"د",1,0],["وكلَّ ليثٍ باسلٍ","على أقبَّ نَهْدِ",43,"د",1,0],["وكلٌّ له فيما انتحاه مزيةً","شريفة عنونٍ وأي مزية",44,"ه",1,0],["وكَلٌّ لم يزلْ يبكي أخاهُ","ونشهدُ كلَّ مُبكٍ صامتينا",45,"ن",2,0],["وكل لفظ لنا رسول","وكل معنى لنا كتاب",46,"ب",1,0],["وكُلٌّ لَهُ نِدٌ سِوى اللهِ وَحدَه","ولولاه ما قلنا لِوَجهِك مِن نِدِّ",47,"د",1,0],["وكللها الإكليل تاجاً مرصعاً","عليها نظام النجم در نثار",48,"ر",1,0],["وَكل لديوان الخَزينة شاكر","عَلى صَرفه الأَموال فيما يُلائم",49,"م",1,0],["وكل له غرفتان واما ال","حشا فلظرف وما به جرا",50,"ر",2,0],["وكل لحاظ لست انسانها قذى","وكل بلاد لست صيبها محل",51,"ل",1,0],["وكلٌ لهُ الدينُ مملكة","على الأرضِ والناسُ خُدَّامُها",52,"م",3,0],["وكلل الدرّ على الأوراق","ومالت الأغصان للعناق",53,"ق",1,0],["وَكُلٌّ لَهُ قَلْبٌ مِنْ الشَّوْقِ مَا سَلاَ","رِجَالُ بِهِ حَازُوا الْمَفَاخِرَ وَالْعُلاَ",54,"ل",2,0],["وكل لهم فيها صبابة عاشق","ومعشوقهم يفنى وعاشقهم يردى",55,"د",2,0],["وكل له أمد ينتهي","ويجري وشيكاً إلى مستقر",56,"ر",1,0],["وَكلل مفرق الأَدواح دراً","عَرائسها من التَشبيب مُيّد",57,"د",1,0],["وكل لسان أجتلي من لغاته","اذاً ألف ألف من غريب أغاني",58,"ن",2,0],["وَكَلَّلَ الطَّل أفْوَاهَ الأقَاحِ فَقُلْ","يَا حَبَّذَا شَنَبٌ فِي ثغرِ لَمْيَاءِ",59,"ا",2,0],["وكلل عقد النور جيد أراكه","تغنى بها القمري بحرا وهينما",60,"م",2,0],["وكلل بالأنواء جسما وهامة","نوسربل بالأنوال صدرا ومحزما",60,"م",2,0],["وكلٌ ليبْغى ما يكون مناسبا","له القرب لا ما لا يكون مناسبا",61,"ب",2,0],["وكل ليل نجي هم","تذوب نفسي ولا يذوب",62,"ب",1,0],["وكل لمحة طرفٍ","يزداد عزّاً ونصرا",63,"ر",2,0],["وكل له فيها من الفهم حظه","وحظ أولي العرفان حظ موفر",64,"ر",1,0],["وكلّ لفظ طّيبٍ ممتِعٍ","يُسكِرُ مِن قبلِ كؤوس الرحيق",65,"ق",1,0],["وكلّ لحظٍ فاتنٍ فاترٍ","أكحلَ مستغنٍ عن الكُحلِ",66,"ل",1,0],["وكل له ضدّ يساميه في العلا","ولست تسامى لا ومن علم الاسما",67,"م",2,0],["وَكُلُ لَيلَةٍ أَمسى لِميعادِ وَصلِهِ","مُسَيلَمَةً إِلّا وَأَصبَحَت أَشعَبا",68,"ب",2,0],["وكل له مما ذكرت من القوى","لسان ثناء حامد لك شاكر",69,"ر",1,0],["وكلل هامات الأكارم بالندى","وخرَّق لبّات العدى باللهاذم",70,"م",1,0],["وكل لَونٍ قد عَلا إشراقُهُ","من أَحْمَرٍ وأَخْضَرٍ وأَصْفَرِ",71,"ر",1,0],["وكلٌّ له وجهٌ صحيحٌ ومقصدٌ","فعم بما أوحى جميعَ المعالم",72,"م",1,0],["وكلٌّ له حالٌ ووقتٌ مُعيَّن","فحالٌ إلى كَشفٍ ووقتٌ إلى ستر",73,"ر",1,0],["وكلٌّ له فيه نعيمٌ ورغبةٌ","فما في عطاءِ الله شيءٌ من البخلِ",74,"ل",1,0],["وكلُّ لبيبِ القلبِ في الأمرِ حازمٌ","إذا جاءه خير إليه به يهفو",75,"ف",2,0],["وَكُلٌّ لِلثَرى يَزدادُ عِشقا","وَلَيسَ يَزيدُنا إِلّا عَداءَ",76,"ا",2,0],["وكل له من جنسه نظر إلى","سوى العورة الفحشاء ذات التزيّد",77,"د",1,0],["وكل له من زوجة لمس كله","مع النظر افهمه بغير تقيد",77,"د",1,0],["وكلٌّ له حبٌّ لأن تضارب ال","عواطف لا قولٌ يفيه ولا كتب",78,"ب",1,0],["وكل لواء خافق كقلوبهم","يشير وبوميء بالعذاب المنزل",79,"ل",1,0],["وَكُلُّ لَياحٍ بِالفَلاةِ إِذا غَدا","مَشى فَزِعاً كَالرائِحِ المُتَنَكِّبِ",80,"ب",1,0],["وكل له فضل ولكن تفاوتوا","ففي القوم مفضول وفي القوم فاضل",81,"ل",1,0],["وَكُل لِسان إِلَيكُم مَقَر","بِفَضل اِعتِراف وَشُكر اغتِراف",82,"ف",1,0],["وكلل تيجان الربا بلآلئ","من القطر يجلوها جلاء العرائس",83,"س",1,0],["وكلل بالوبل اعرافها","وقرّط بالطلّ آذانها",84,"ن",3,0],["وكل له ورد معدٌّ يسيغه","فمن غبّ عن ورد كمن عبَّ بالورد",85,"د",1,0],["وكلّ له عينٌ وشتّانَ ما ترى","دنيٌّ وأدنى أو بعيدٌ وأبعد",86,"د",1,0],["وكللت رياضها بالزَّهر","بحملهِ أضحى الفلا جميلا",87,"ل",2,0],["وكل لحظ فيه درس حكمة","لألف نحرير حكيم ذي نظر",88,"ر",1,0],["وكلٌ لصاحبهِ مُبْغِضٌ","يرى كلّ ما كان من ذاك دِينا",89,"ن",2,0],["وكل لكل الهاشميين طائع","كعاص وللمهدي عاص كطائع",90,"ع",1,0],["وكلل رأسها حببٌ","حكى الياسمين في الشكل",91,"ل",1,0],["وكُلُّ لَجوجٍ في العِنانِ كأَنَّها","إِذا انغَمَسَت في الماءِ فَتخاءُ كاسرُ",92,"ر",1,0],["وكل لئيم في الحضيض مقامه","رضوه بدنياه وللحكم ولاه",93,"ا",2,0],["وَكُلُّ لِسَانٍ فَائِحٍ بِالثَّنَاءِ مَا","رِيَاحُ الصَّبَا فَاحَت بِطِيبِ الحِمَى نَشرَا",94,"ر",2,0],["وَكُلِّلَ باحتفاءٍ واحتفالٍ","جَليلٍ ما عَلَيهِ مِن مزيدِ",95,"د",1,0],["وَكُلُّ لَبيبٍ في الهَوى طوع أَمرُها","تَقولُ لَهُ كُن مُغرماً فَيَكون",96,"ن",1,0],["وكل لفظ صيغ للمفاخر","كطاهر القلب جميل الظاهر",97,"ر",1,0],["وكللت يده بالزهر مفرقه","فعانقت قمَّة الميزاب صنينا",98,"ن",2,0],["وكلَّلها بياقوتٍ ثمين","وتيجان اللجين مع النضارِ",99,"ر",1,0],["وكل لما يهواه يجري برأسه","وليس له ردعٌ وليس له ضبطُ",100,"ط",1,0],["وكلٌّ له في الشرع أحسنُ مذهبٍ","فمَن يتكلم باعتِراضه يُكلَم",101,"م",1,0],["وكلٌّ لمولانا العليِّ مُسَبَّحٌ","صموتُ جماداتٍ كذا كل قائلِ",102,"ل",1,0],["وكلٌّ له طبعٌ به اختُصَّ لم يَزَلْ","فلا يَغُرَّنَّكَ الجاهلُ المتَقَوِّلُ",103,"ل",1,0],["وكلل تاجها التبري في رطب من الدرِّ","وخامر عقلهم في حث كاسات من الخمر",104,"ر",1,0],["وكلٌّ لديه لاح صبحٌ من العلى","وعنه انجلى ليلٌ من الدهر حالك",105,"ك",1,0],["وَكُلُّ لَطيفٍ جَلَّ أَو دَقَّ حُسنُهُ","وَكُلُّ جَليلٍ وَهوَ بِاللُطفِ صادِعُ",106,"ع",1,0],["وكلٌّ لَيَحيا إلى موعدٍ","فيهلِكُ هذا .. وهذا نجا",107,"ا",1,0],["وكُلٌّ لهُ فيها مُرادٌ وحِصَّةٌ","وكُلٌّ على قَدرِ اعتِدَاءَاتِهِ يُجزَى",108,"ز",2,0],["وكُلٌّ لهُ كَنزٌ.. وجَهلٌ بِأَنَّه","إِذا ما دَعَاهُ المَوتُ لَن يَفتَحَ الكَنزا",108,"ز",2,0],["وكلٌّ لا مَحالةَ مُسْتبادٌ","ويبْقى وجْهُهُ،جلّ الحسيبُ",109,"ب",1,0],["وكل لوعةِ محزونٍ محجبةٍ","في النفس حتى التقت ثم استوت كلما",110,"م",2,0],["وكل لحظ وطرفة ومعا","أنفاسا لا إله إلا الله",111,"ل",2,0],["وكل ليث شرى لم ينج منه إذا","ما صال قرم بأقدام ولا هرب",112,"ب",1,0],["وكلٌّ له مما اعتراه من الهوى","صريم كأنَّ العمر فيه مقاطعُ",113,"ع",1,0],["وكلّلي القمم الشماء باسمةً","بالبرق مرعدةً هُزّت نواحيها",114,"ي",3,0],["وكلله الإله بتاج نصرٍ","غدا جبلاً على رأس الكنود",115,"د",1,0],["وكل له حظه في النزول","فذا مستريح وذا متعب",116,"ب",1,0],["وكل لفظف طي نابتة","كالروح في جسم بهجة حلا",117,"ل",2,0],["وكَلّلْتَني باحترامٍ فريدٍ","كأنك نجْلي بأصفَى وَلاءِ",118,"ا",2,0],["وكل للثم البيض حمرا خدودها","وضم قدود السمر ما مله صب",119,"ب",1,0],["وكل له موضع معلم","يؤول اليه رشيداً لبيبا",120,"ب",2,0],["وكلّلَ حين تطايرَ شَعرُكِ","هامةَ مثلكِ في الحرب غار؟",121,"ر",1,0]]}