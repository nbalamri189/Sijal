{"poems":[[51,"بدني ناحل وصبري بدين","https://www.aldiwan.net/poem64175.html","الخفيف"],[33,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[48,"الله أكبر ما اشتريت بضاعة","https://www.aldiwan.net/poem22414.html","الكامل"],[92,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[369,"فعلت هذه الجفون الضواري","https://www.aldiwan.net/poem60874.html","الخفيف"],[385,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[482,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64089","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216847",""],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93106","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49942","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27203","المديد"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48060","الكامل"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143103","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202040","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201551","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202609","الطويل"],[3033,"","https://poetry.dctabudhabi.ae/diwan/poem/146113","الرمل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67593","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45862","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33719","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33596","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33630","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33493","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33442","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33215","الرمل"],[4739,"من ضيع فتيل الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=28039",""],[5160,"مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187489",""],[307,"وجوه في المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=214163",""],[5956,"مقدَّسَة رفاهي أمُّ عمري","https://www.poetsgate.com/ViewPoem.aspx?id=182420",""],[5957,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177510",""],[5997,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=214219",""],[6093,"بَدني مقيمٌ والخيالُ مسافرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176524",""],[6093,"شهيدٌ من القنفذة (الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=181456",""]],"verses":[["بَدَني ناحِلٌ وَصَبري بَدينُ","وَاِعتِزامي ماضٍ وَجِسمي حَسيرُ",0,"ر",1,1],["بُدَّنٍ في خَدالَةٍ وَبَهاءٍ","طَيِّباتِ الأَعطافِ وَالأَردانِ",1,"ن",1,0],["بدَنٌ بِلا بَدَنٍ يَعيشُ وَكَم طَوى","جَسَدٌ سَنيهِ وَما عَلَيهِ جِسادُ",2,"د",1,0],["بَدَنٌ بلا قلبٍ لدى أثِرٍ","عاتٍ على الشَّهَواتِ مُقْتَصِر",3,"ر",1,0],["بدَنٌ تحت قَبضةِ السُّقمِ مُلقىً","وفؤادٌ في مِخْلَبِ الاِفتكار",4,"ر",1,0],["بَدن صَبغ مِن سقام وَقَلب","صَيغ مِن حَرقة وَمِن أَشواق",5,"ق",1,0],["بُدْنٍ يطيرُ مِنَ الوحيف لُغامُها","كالعُطْبِ مِن فوقِ الحصى واليَرمَعِ",6,"ع",1,0],["بدنو إذا ما البينُ بانَ بِقُرْبه","عنّا وأزمعَ بالفراقِ فريقه",7,"ق",2,0],["بِدَنانِيرَ لا أَحَالُ على الْجِهْ","بِذِ فيهَا وَلاَ عَلَى كتُبْ رُوز",8,"ز",1,0],["بِدَنك فِيْ الكَدّ اتعِبَه","لا تِرتِبِط كابنِ بقَرَه",9,"ر",2,0],["بدنياي كنتم منال الرجا","وكنتم بأخراي لي مستجار",10,"ر",1,0],["بدنان خمرٍ قد أصابَ تجارُها","من حبّنا لشرابها ارْباحَها",11,"ح",3,0],["بدنوِّ انس نصيرنا","نالت مزيد الهناءِ انفسنا",12,"ن",2,0],["بدني أضحى إلى الأممِ","نائباً عن كعبةِ الحرمِ",13,"م",1,1],["بُدُنٌ فَدَتْ مِنَّا دِماءَ نُحورِها","بِبِغائِها فِي كُلِّ أُفقٍ مَنحرا",14,"ر",2,0],["بدناً كالصباح من تحت ليل","حالك اللون أسود غير جعد",15,"د",1,0],["بدنياي محصولي هو الهديُ للبشرْ","ولولاه كانت عيشتي كلها ضجرْ",16,"ر",1,1],["بدنياً ما تزاحمنا زماناً","ولكن التزاحم في الطريق",17,"ق",1,0],["بدنٍّ من الإخلاص خمّرت شهدها","فدع لابن هاني خمرة الدنّ والعصر",18,"ر",1,0],["بدن المرء إذا ما","لم يساعده بقاؤه",19,"ه",1,1],["بَدنٌ ذابلٌ وعظمٌ مهيضٌ","وجفونٌ قَرحى ودمعٌ هَمُوعُ",20,"ع",1,0],["بَدَني لي الأَمد البَعيد بِقَوله","في كُلِ يَوم طول أَلفي عام",21,"م",1,0],["بدُنُوِّ النَوءِ في الجَوِّ شَعَر","يَمُّهُ فَاِربَدَّ لَوناَ وَاِكفَهَر",22,"ر",1,0],["بَدَنُ المُستَهامِ كيفَ تَراهُ","شجنٌ ما له سِواهُ طَبيبُ",23,"ب",1,0],["بَدني ناحلٌ وأنتَ صَحيحٌ","إنما يرحمُ الصَّحيحُ السَّقيما",24,"م",2,0],["بدنٌ تفرق في جوانحه الضنى","إن التذكرَ يُنحِلُ الأبدانا",25,"ن",2,1],["بدني كم يذوبُ كم طالَ هذا","نفِدت عَبرتي وملَّ العذولُ",26,"ل",1,0],["بدنٌ ليس ينجلي السقم عنهُ","ما جنى بالهَوى عليكَ فؤادك",27,"ك",1,0],["بدني بالٍ وقلبي دنِفٍ","عشتُ مما بي سليماً أبدا",28,"د",2,0],["بدنيا كلها غربه ينادينا وطن وعروق","شعور البعد يربطنا وسيرة بعضنا تدما",29,"م",2,0],["بدنيا لا بقاء لها","تعذّبنا وتشقينا",30,"ن",2,0],["بدني ضعيفٌ والفؤادُ متيّمٌ","والعزمُ في حقِّ الفراشِ ذليلُ",31,"ل",1,0],["بدنيانا وفي الأخرى وعدْن","كما في الأرض كانت كلَّ ذُخْري",32,"ر",2,0],["بدنياكَ طيفا ً ترطبُ حزنا ً","تهلّ عبيرا ً إليك تُغني",33,"ن",2,0],["بِدُنْيَا لَمْ أَجِدْ فِيْهَا وَفِيَّاً","يَعُوْدُ بِمَكْرِهَا طَبْعُ التَّجَنِّي",34,"ن",2,0],["بَدني مقيمٌ والخيالُ مسافرٌ","نَحوَ التَّي بَخِلتْ بطيفٍ زائرِ",35,"ر",1,1],["بَدنٌ يأوي إلى أَصْلٍ لَهُ","خَالُهُ الطِّيْنُ وعَمٌّ مِنْ دِمَنْ",36,"ن",1,0]]}