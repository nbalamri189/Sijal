,[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86381","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4134,"","https://poetry.dctabudhabi.ae/diwan/poem/100556","الكامل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106743","الكامل"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141131","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28622","المنسرح"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147287","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120297","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52161","الرمل"],[4767,"صفقة خاسر","https://www.poetsgate.com/ViewPoem.aspx?id=211955",""],[4869,"راس مال العلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=151627",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[5061,"الديه","https://www.poetsgate.com/ViewPoem.aspx?id=147168",""],[5183,"حلبة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180215",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5344,"اما تقول الخير او إلزم الصمت..","https://www.poetsgate.com/ViewPoem.aspx?id=180834",""],[5410,"ألم","https://www.poetsgate.com/ViewPoem.aspx?id=142535",""],[5525,"هام القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=30108",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[5595,"عيد المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=144648",""],[5732,"مصايب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=177822",""],[5747,"ثمين الهرج","https://www.poetsgate.com/ViewPoem.aspx?id=61667",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5848,"يافؤادي لا تسلني","https://www.poetsgate.com/ViewPoem.aspx?id=51956",""],[5875,"يانجد","https://www.poetsgate.com/ViewPoem.aspx?id=22694",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[5956,"شِعري حصيلة أذواق البشر","https://www.poetsgate.com/ViewPoem.aspx?id=185733",""],[5970,"ينقم الناقمون فعل الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=130600",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[463,"نوازعُ الشوق والغليلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60235&r=&rc=291",""],[463,"أما لنجومِ ليلكَ بالمصلَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60170&r=&rc=226",""]],"verses":[["يَنقَضُّ لا تَلحَقُ مِن غُبارِهِ","إِلّا بَقايا فِلَقِ الجَراوِلِ",0,"ل",1,0],["يَنقادُ في كُلِّ يَومٍ","مِنّا الأَبِيُّ الصَعبُ",1,"ب",1,0],["يَنْقُدُكَ الْغِيبَةَ مَهْمَا خَلا","مَا بَيْنَ أَهْلِيهِ وَأَصْحَابِهِ",2,"ب",2,0],["يَنْقَضِي الدَّهْرُ وَ ابْنُ مَحْمُودَ بَاقٍ","خَالِدُ الذِّكْرِ فِي بَنِيهَا العِظَامِ",3,"م",1,0],["ينقِّب عن رأيٍ بها وفواضلٍ","سفيرٌ عن المعنى الخفيِّ نقاب",4,"ب",1,0],["ينقل الناس عن حديث هداها","طرق العلم عن متون العوالي",5,"ل",2,0],["ينقَّل من خُضر الثياب وصفرها","إلى حُمرها ما بين وشي إلى بردِ",6,"د",1,0],["يَنقُلنَهُم نَقلَ الكِلابِ جِرائَها","حَتّى وَرَدنَ عُراعِراً وَأُثالا",7,"ل",2,0],["يَنقَضي يَومٌ فَيَومٌ","في حَديثٍ لا يُفيدُ",8,"د",1,0],["ينقَضي العَيْشُ بَيْنَ شَوْقٍ ويأْسِ","والمُنَى بَيْنَ لَوْعَةٍ وتَأَسِّ",9,"س",1,1],["يَنقادُ طَوعاً لَهُ إِذا حَشَدَت","عَلَيهِ تِلكَ الأَشباهُ تَجتَذِبُه",10,"ب",2,0],["يَنقَضي ذِكرُهُ فَلا خَيرَ عَن","هُ وَلا أَوبَةٌ تُدَنّي قُفولَه",11,"ل",2,0],["ينقِّب كلبٌ في الحطامِ وربما","رَعَى الليلَ هِرٌّ ساهرٌ وغفا الجندي",12,"د",2,0],["يَنقضُّ جَلّادُهم في كلِّ مَملكةٍ","يَرْمِي العبيدَ ويحمي كل نخّاسِ",13,"س",1,0],["يُنقذُ العالمَ الغريقَ ويحمي","أُمَمَ الأرضِ أن تذوقَ الثُّبورا",14,"ر",2,0],["يَنقَضي العامُ وَيَتلو آخَرٌ","وَالنَوى لا تَنقَضي هَذا جُنون",15,"ن",1,0],["ينقضُّ كالسهم في دجنّتها","فتحسب الليل هُتّكت ستره",16,"ر",2,0],["يُنقَشُ الشعر في الصدور، ويُنسَى","نثرُ عبد الحميد، وابنِ العميد",17,"د",1,0],["ينقضُّ كالصقر فوق المدْنِ جيشهمو","كأنما هي صَيْدٌ وَهْوَ صيَّاد",18,"د",1,0],["ينقضُّ من أعلى عُقابًا كاسرًا","ويدِبّ مثل الأُفْعُوان دبيبا",19,"ب",2,0],["ينقش البوليس ، ما حقّقته","من فتوح با (لمواسبي ) في المقل",20,"ل",1,0],["ينقل الخطوَ فوقَ شِلوِ صديقٍ","او على مُخ صاحبٍ مقذوف",21,"ف",1,0],["ينقبُ كلبٌ في الحطام وربما","رعى الليل هوٌّ وساهرٌ وغفا الجندي",22,"د",2,0],["يَنْقَضُّ كَصَاعِقَةٍ، وَعَلَىْ","فَمِهِ وَأَنَامِلِهِ يَجْرِيْ",23,"ر",2,0],["ينقّر السهد عن ميعاد أغنية","كطائر جائع ، عن سربه نزحا",24,"ح",2,0],["ينقض اشهب جو حال معمعة","بها الصقور سواء والفواخيت",25,"ت",1,0],["ينقضّ من طرفي لفر","طٍ تلهب النار الشرارْ",26,"ر",1,0],["يَنقُلُ الناسُ الهَوى عَنكِ وَعَنّي","إِنَّ أُنثى غَنَّيتَها مِثلَ هذا ال",27,"ل",1,0],["يَنقَضي العُمرُ وَلا يَن","وينَ لِلدينِ قَضاءا",28,"ا",3,0],["يُنقّشُ بالأنوار نُمْرُقَةَ الدُّجى","ويبكي على الأزهارِ والنّجمُ قد غوّر",29,"ر",1,0],["يَنْقَضي يَومي كأَمسي خيبةً","أبَداً أقْرَع بَاباً مُوصَدا",30,"د",2,0],["ينقذ الخلق من كروب عظام","وشدائد قد شيبت بالغلام",31,"م",1,0],["ينقعُ اللّحظُ منه غلّة صادٍ","بِمحيّا مِن الحَيا ريّانِ",32,"ن",1,0],["يَنقلُه البَينُ من مكانٍ","في كلِّ يومٍ إلى مَكانِ",33,"ن",1,0],["ينقضُّ يَرجمُ مارداً","يبدو سناه للعيان",34,"ن",1,0],["ينقذُ الضالَ ويُحيي","من أتى وهو أثيم",35,"م",1,0],["ينقاد معْها طائعاً لعِنانها","مهما تقلْه قال هذا الأنفَس",36,"س",1,0],["يَنقَضي لَيلَةً بِهم وَتَسهي","د ويَمضي نَهارُهُ في عَذابِ",37,"ب",1,0],["يَنقَضُّ لامِعُها فَتَحسَب كاتِباً","قَد مَدَّ سَطراً مُذهَباً بِتَعَجُّلِ",38,"ل",1,0],["ينقد قول الرجال عن نظر","تراه مستخرجاً لمنكتمه",39,"م",2,0],["ينقضي جيلٌ ويستودِعُها","بعد ذاك الجبل في الآتين جيلا",40,"ل",2,0],["ينقضُّ من أوج الفضا","فكأنه أحدُ الزواهر",41,"ر",1,0],["ينقِّطُ لامَ الصدْغِ ياقوتُ خدِّه","بخالٍ ولو لم يُلفَ نَقْطٌ للامِهِ",42,"ه",1,1],["ينقُلني الودُّ إلى مثلها","والمالُ لا ينقُلُ أخلاقيا",43,"ي",2,0],["يُنقِّصُ الدهرُ كلَّ زائدةٍ","وأنت لا يعتريك نقصانُ",44,"ن",1,0],["ينقُلنَ وخداً بيضاءِ كنٍّ","نُحضنَ بالشدِّ والذميلِ",45,"ل",1,0],["ينقّحها لكم قلبٌ سليم","فيأتيكم بها حُبٌّ وحدْقُ",46,"ق",1,0],["يُنقِّصُ الفضلُ مِيزاتي ويُصغرني","ما كان فيه إذا أُنصفتُ إكباري",47,"ر",2,0],["يَنقُصُ من قدرِك وهو فاضلٌ","على وِسيعات الأماني زائدُ",48,"د",1,0],["ينقاد للذِّلّة طوعَ نسبٍ","حيرانَ في الأحساب أعمى لم يُقَدْ",49,"د",1,0],["يُنقِّلُ قوماً قربُهم وبعادُهم","ونفسيَ لا تهفو بها مُبْدِلاتُها",50,"ت",3,0],["ينقلن كلَّ مُساورٍ ذي هِمَّةٍ","تُجْلى بحدِّ حُسامهِ الغَمَّاءُ",51,"ا",2,0],["يَنْقُلُ الرُّكْبانُ ما جئتَ بهِ","مِن بَديعاتِ المَساعي والهِمَمْ",52,"م",1,0],["ينقَّحُها فكري فتأتي سليمةً","مبرأةَ الألفاظِ مِن خَجَلِ الخَرْمِ",53,"م",1,0],["ينقِّحُها فكري على ما يُريدُه","فيصبيكَ تنقيحُ المجيدِ المنجِّذِ",54,"ذ",1,0],["يَنقَدُّ ذو رِقَّةٍ تَهفو جَوانِبُهُ","كَما هَفا فُروعِ الأَيكَةِ الغَرَف",55,"ف",1,0],["ينقادُ في ظِلِّ الملوكِ.. وحينما","دَنَتِ الحقيقةُ قادَهُمْ في ظِلِّهِ",56,"ل",2,0],["ينقُل الإِنسانَ من عِزِّه","أَسْرَعَ ما كان إِلى هُونِه",57,"ن",2,0],["ينقضي بين عطفة وحنانٍ","وحديثٍ هو النُهى والهناءُ",58,"ا",2,0],["يُنقّحُها تدبيرُه فيُجيدُها","فدام لها منه مُجيدٌ مُنَقَّحُ",59,"ح",1,0],["ينقل ماء البحر في منخلٍ","ويسحق الريح بهاؤون",60,"ن",1,0],["ينقُر من خفّةٍ فتحسبُه","في دُبره دودةٌ تُنقِّزه",61,"ز",2,0],["يَنقادُ بِالقَولِ في عَدوٍ وتَوءدة","لَولا التّكلّم أَجراهُ بِلا رَسنِ",62,"ن",1,0],["يَنقَضُّ إِن غبتَ عَلى صِغارك","فَاِحذَر أَذاه وَاِقتَصر في دارك",63,"ك",1,0],["ينقط في وجهه العدى سمره","وبيضه من بعدها يشكل",64,"ل",1,0],["يُنْقذُكم من سُدَف الظلِام","فاْعتَرفُوا مَزِيَّةَ الإسْلام",65,"م",1,0],["يَنْقَعْنَ بِالعَذَابِ مُشاشَ السِنْسَنِ","وَالشُرْبُ يُغْشَى بِالمَقام الأَلْزَنِ",66,"ن",1,0],["ينقرها كنقرة الغراب","ينتظر المسكين فتح الباب",67,"ب",1,0],["ينقصُ الوجدُ كلما قدم العه","دُ ووجدي في كل يوم يزيد",68,"د",1,0],["ينقِصُ الحسن بل يُجل مقام ال","حسن عن سيره بهذا الطريقِ",69,"ق",1,0],["ينقله للناس بالروايه","عن شيخه في الخط والدرايه",70,"ه",1,0],["يُنَقِّلُ رِجْلَيْهِ على حينِ فَتْرَةٍ","كَمُنْتَعِلٍ لا يُحْسِنُ المَشْيَ في النَّعْلِ",71,"ل",1,0],["ينقد الشاعر بتسريجِ","من شعر غيره ولو لبَنّه",72,"ن",2,0],["ينقض بين لهام البهم صاعقة","لو صادفته الجبال الشم ما وهطا",73,"ط",2,0],["ينقلون الأحطاب من حيث وافوا","ها فبالطير مر لي غيضتان",74,"ن",1,0],["ينقضي العمرُ بين شهرٍ وعامٍ","لالوفٍ تسيرُ بعد الوفِ",75,"ف",1,0],["يُنَقِّلُ وُلْدَهُ كجراء كلبٍ","يُنقِّلها حذارَ الراجمينا",76,"ن",2,0],["ينقض ختطفاً كبش الكئيبة من","ظهر الجواد اختطاف الباز عصفورا",77,"ر",2,0],["يَنقُصُ حَولاً في حِسابِ الرومِ","بِذِكرِهِ في الخَبَرِ المَعلومِ",78,"م",1,0],["ينقضي الصبح والمجالس زهرٌ","وابتدا مثل صبحه الإمساء",79,"ا",2,0],["ينقضي الليلُ في سكونٍ رهيبٍ","شرَّدتهُ لواعجُ الوَلهَانِ",80,"ن",1,0],["ينقضي العمرُ والشبابُ يُوَلِّى","بين حالِ الوسنانِ واليقظانِ",81,"ن",1,0],["ينقضي العمرُ بين عُسرٍ ويُسرٍ","حُلوُهُ المرُّ والهناءُ الشَّقاء",82,"ا",2,0],["يُنقَلُ الناسُ من حياةٍ لأُخرى","قَدرَ أعمالهم يكونُ الجزاء",82,"ا",2,0],["يُنقذ المستجيرَ من بُرثُن الهُل","ك وليثُ الخطوب أنشَبَ نَابه",83,"ب",2,0],["ينقاد م المغرب له احياب","ويبات برّاقه لواضي",84,"ض",2,0],["ينقص ذو الإيثار في بذلِه","عن منزلِ الأفضالِ والفضل",85,"ل",1,0],["ينقل الشخصُ اختصاصا","من هنا لا عن ممات",86,"ت",1,0],["ينقلُ الماء خَطوهُ فَتُرَجِّي","هِ النُّعامى كَما يُرَجّي الحَسيرُ",87,"ر",1,0],["يَنقضّ كالصَقر عليها عِندَما","يصيدُ صِيدها متى تقضقَضا",88,"ض",2,0],["يَنقضي العُمر وَنار الحَرب","دَوماً في اِتِّقاد",89,"د",1,0],["يُنَقّي القَملَ مِنهُنَّ","إِذا باعَ بِتَدليسِ",90,"س",1,0],["يَنقًصُ رُبعاً في قِياسِ العَرَبِ","بالكُوسِ والشِّلي لَهُنَّ رَتِّبِ",91,"ب",1,0],["ينقاد جمعهم لاروع ماجد","يعطي المكارم من يديه قيادا",92,"د",2,0],["ينقضَّ كالريح أو كالسهم منخرِقاً","أو كالشهاب إذا ما انصاع إيضاحا",93,"ح",2,0],["ينقاد لاهل العشق مثل الرقيق","يصبر وطول الليل يا رق",94,"ق",1,0],["ينْقادُ للغِلْمانِ في خَلَواتِهِ","مِثْلَ السَّفِينِ زِمامُه في دُبْرِهِ",95,"ه",1,0],["يَنقَضي اللَيلُ وهو يَرعى نُجوماً","لم يَذُق لحظَةً لَذيذَ المنامِ",96,"م",1,0],["يَنقاد طوعك مسلساً لك قوده","صعب تمنّع أَن يقاد وَيسلسا",97,"س",2,0],["ينقل من سجنٍ لسجنٍ مكابداً","أذى القوم حتى سمه الغادر السندي",98,"د",2,0],["ينقص البدر وينمو في السنا","ومحيّاه مليّ بالكمال",99,"ل",1,0],["ينقب عن ذكر العواقب جهده","وما ذاق يوم الفتك طعم التردد",100,"د",1,0],["ينقسم الكلي عندهم إلى","خمس وعد الجنس منها أولا",101,"ل",2,0],["يَنقاد غرا للذي تَمضي به","نحوَ التَعاسة وَالشقا خطواته",102,"ت",2,0],["يَنقَضُّ مَدفوعاً بِفَرطِ السَغَبِ","لَكِن يَفوتُهُ نَوالُ الأَرَبِ",103,"ب",1,0],["ينقل كل البهم إلا أخيل","أهداه خيرون لفيلا الجليل",104,"ل",1,0],["يَنقَضَّ حَتّى مَباني الناسِ مُبتَغِياً","فَريسَةً بِفؤادٍ غَيرِ مَضطَرِبِ",105,"ب",1,0],["ينقضي العمر وما أقضي بكم","وطرا حتى قضيت العمرا",106,"ر",2,0],["ينقض فوق بهمة كالغَدَن","بدرُ ولكن الكمال هالُته",107,"ه",1,0],["ينقل منها للشتتاء كتائب","في فيلق للنصر فيه مقانب",108,"ب",1,0],["يَنقَضُّ جارِحُ كَيدِهِ في إثرِهِم","أَهدى إِلَيهِم مِن قَطا إِرسالِ",109,"ل",1,0],["ينقضي عامنا ويقبل عام","وبكل لربنا إنعامُ",110,"م",1,1],["ينقّقُ كَعبَيهِ في ملاعبة","بِالرِّفقِ لا ضَيرَ فيهِ بِالعُنفِ",111,"ف",1,0],["ينقي البصائر من طخاها مثل ما","ينقى من الأصداء وجه سجنجل",112,"ل",1,0],["ينقش الليل بحرف فترى","أنجم الكون بحسن تبتسم",113,"م",1,0],["ينقب عن دنياي فكري فينتهي","الى نقب تحمى فيرجع هائما",114,"م",2,1],["ينقل الحقَّ نزيهاً فإذا","ضلَّ عنهُ راده أيّانَ كانا",115,"ن",2,0],["ينقض مثلَ الصقر نحو فريسةٍ","مذعورةٍ من مخلبٍ متحادر",116,"ر",1,0],["ينقصك وسم ولابخلنا وسمناك","انا اشهد انك بين الاجواد ناقه",117,"ق",2,0],["يُنقِّلُني هواهُ لألفِ شوقٍ","فأغْرَقُ في لذيذ ِ الانتقال ِ",118,"ل",1,0],["ينقلب ليلي هواجيس وظنون","ﻻ لمحت الولد ذا مقبل علييه",119,"ي",2,0],["ينقض خلف البرق في طريقه","فيقتفيه البرق وهو متعب",120,"ب",1,0],["ينقلك عن فتح المجيد لشيخنا","فإن كان عيباً كان هذا يقابله",121,"ل",2,0],["ينقل لك السيّه وللشر دوار","واذا تكلم قلت وش له تكلمت !؟",122,"ت",1,0],["ينقلنا عبر خيال ثار","نجوب عصوراً وقرونا",123,"ن",2,0],["ينقاد لي من ما مع الناس ينقاد","وما قد عصا مهر القوافي عناني",1