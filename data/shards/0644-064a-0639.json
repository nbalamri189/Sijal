عرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5865,"أراهُ من بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=179824",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""],[5952,"أسير شُرْفةٍ وناي","https://www.poetsgate.com/ViewPoem.aspx?id=213322",""],[5956,"الشعور بالنقص حافزٌ للكمال","https://www.poetsgate.com/ViewPoem.aspx?id=184481",""],[5957,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182458",""],[5997,"براءة","https://www.poetsgate.com/ViewPoem.aspx?id=214220",""],[6001,"أوهام","https://www.poetsgate.com/ViewPoem.aspx?id=378",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6115,"يادار علمني وقل وين راعيك","https://www.poetsgate.com/ViewPoem.aspx?id=180499",""],[6152,"أنتِ مرامي","https://www.poetsgate.com/ViewPoem.aspx?id=203748",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6187,"الدائرة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82160&r=&rc=4",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[5355,"أطبق جفونك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86679&r=&rc=2",""],[6229,"نشيد أطفال الحضانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82510&r=&rc=45",""],[2220,"إذا طلعَ البدرُ المنيرُ عشاءً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11133&r=&rc=7",""]],"verses":[["لِيَعلَمَ مَن أُناضِلُ أَنَّ شِعري","يُطالِعُ بِالشَقاءِ وَبِالنَعيمِ",0,"م",1,0],["لِيَعتَسِفَنَّ هَذا اللَيلَ مِنّي","أُشَيعِثُ عابُ لِمَّتِهِ الغَوالي",1,"ل",2,0],["لَيَعودَن لِمَعَدٍّ عَكرُها","دَلَجُ اللَيلِ وَتَأخاذُ المِنَح",2,"ح",1,0],["لَيُعيدَن لِمَعَدٍّ عِكرَها","دَلَجَ اللَيلِ وَإِكفاءَ المِنَح",2,"ح",1,0],["لَيَعْرِفُونَ لَكَ الْفَضْلَ الْعَظِيمَ بِمَا","أَوْليتَ مِنْ مِنَنٍ مَوْصُولَةِ السَّبَبِ",3,"ب",1,0],["لي على روض جدّه كلّ يومٍ","أدمعٌ مستهلَّةٌ كالغيوم",4,"م",1,0],["ليَ عَينٌ هواي فيكم يُريها","منْ جَلاهَا بلومكم إقذاءَ",5,"ا",2,0],["لِيُعلَم ألَّا موتَ ميتٍ لكَبْرةٍ","ولا عيش حيٍّ لاقتبال نباتِ",6,"ت",1,0],["لي عنده بحر سُقيا","للفُلْك فيه مَسير",7,"ر",1,0],["لي عصبة لا تزال تُدْحس لي","عندك تَعْساً للعصبة الدُحُس",8,"س",1,0],["لي عفة حسب من تكون له","من الغنى غُفَّةٌ من الغُفَف",9,"ف",1,0],["ليعتزلْ أحد القِرْنين ثم يرى","حربي إذا قذفت أرجاؤها الشعلا",10,"ل",2,0],["ليعاقب وسْمِيَّ جُودٍ وَليُّهْ","مِنْ كريم رجا نداهُ وليُّهْ",11,"ي",2,1],["لي عِندَكَ حاجَةٌ فَقُل لي","هَل أَنتَ إِذا سَأَلتُ باذِل",12,"ل",1,0],["ليعلم الموتى باني امرؤ","قد جئتهم تواً من الدنيا",13,"ي",2,0],["لِيُعِنّا كل معبود معين","نحن حزب البكسِر المتفقين",14,"ن",1,1],["لِيَعلَمَ مَن هابَ السُرى خَشيَةَ الرَدى","بِأَنَّ قَضاءَ اللَهِ لَيسَ لَهُ رَدُّ",15,"د",1,0],["لَيَعتَسِفَنَّ العيسَ هَمُّ مُشَيَّعٍ","عَنوفٍ بِها في حَلِّهِ وَارتِحالِهِ",16,"ل",2,0],["لي عَن قَليلٍ ضَميرٌ لا يُلِمُّ بِهِ","وَجدٌ عَلَيكِ وَقَلبٌ غَيرُ مُرتَهَنِ",17,"ن",1,0],["لِيَعلَمَ ما أَحصاهُ فيمَن أَشَعتَهُ","جَميعاً إِلى يَومِ القِيامَةِ حاسِبُه",18,"ب",2,0],["لَيَعلَمَنَّ الناسُ أَنَّ التُقى","وَالبِرِّ كانا خَيرَ ما يُذخَرُ",19,"ر",1,0],["لِيَعلَم كُلُّ ذي عَمَلٍ","بِأَنَّ اللَهَ سائِلُهُ",20,"ل",2,0],["لِيُعطي الخِلافَةَ أَهلاً لَها","فَلَم يَرتَضوهُ لِإِيجابِها",21,"ب",3,0],["لي عَبرَةٌ في الخَدِّ سا","ئِرَةٌ وَبَيتٌ سائِرُ",22,"ر",1,0],["لِيُعلَمَ أَنَّ الغُرَّ مِن آلِ مُصعَبٍ","غَداةَ الوَغى آلُ الوَغى وَأَقارِبُه",23,"ب",2,0],["لي على أنَّ بلادي","تشتهي قربي دليلُ",24,"ل",1,1],["لي عُذرُهم ما أنتَ من عِدَةِ المُنَى","إلا وراءَ مخيلةٍ ما تَصدُقُ",25,"ق",1,0],["لِيُعلِمَكُم أَنَّ الَّتي قَد حَرَصتُمُ","عَلَيها وَغودِرتُم عَلى أَثرِها صَرعى",26,"ا",1,0],["لِيَعْلَمَ أَغْنَى العالَمِينَ بِأَنَّهُ","إلَى كَلِمي مِنِّي لِدُنْياهُ أَفْقَرُ",27,"ر",1,0],["لِيَعلَمَ أهْلُ الشّرْقِ والغَرْبِ أنّني","بنفسيَ لا بالوفدِ كان تَقَدُّمي",28,"م",2,0],["ليَعْقِدِ التاجَ هذا اليومُ مفتخراً","إن كان تُوِّجَ يْومٌ سائرُ المَثَل",29,"ل",1,0],["لِيَعْرِفْكَ من أنتَ مَنجاتُه","إذا ما اتّقى اللهَ حقَّ التُّقى",30,"ا",1,0],["ليَ عرسٌ حرّةٌ مملوكةٌ","حزتُها من غير مهرٍ وثمَن",31,"ن",1,1],["لِيَعدُ مَعَ الضَبابِ سَليلُ حُجرٍ","وَسائِرَ قَولِهِ في اِبنِ الضَبابِ",32,"ب",1,0],["لي على حبي للعراق شهود","من دموعي وَقَلبي الخفاق",33,"ق",1,0],["لي عندك حقٌّ أَنشدُهُ","أتقرّ به أم تجحدُهُ",34,"د",2,1],["لي عند ذكرك يا صفا إِطراقُ","وَدموع حزن في التراب تراقُ",35,"ق",1,1],["لِيَعلَمَ الغافِلُ ما أَمسُهُ","ما يَومُهُ ما مُنتَهى العيشَةِ",36,"ه",1,0],["لِي عِنْدَ سَاكِنِهَا عَهْدٌ شَقِيتُ بِهِ","وَالْعَهْدُ ما لَم يَصُنْهُ الْوُدُّ مُنْقَضِبُ",37,"ب",1,0],["لِيَعِشْ فَائِزاً بِأَغْلَى الأَمَانِي","وَلْيُخَلَّدْ ذِكْرَاهُ دَهْراً فَدَهْرَا",38,"ر",2,0],["لِيَعُنْكِ رَبُّكِ يَا مُصَوِّرَتِي عَلى","مَا سُمْتِ فَنَّكِ مِنْ عَنَاءٍ بَاهِر",39,"ر",1,0],["ليَعْذِرْنِيَ الإِخَوْانُ إِنْ جَفَّ مِرْقَمِي","فَقَدْ عَلِمَ الإِخْوَانُ مَنْ أَنَا فَاقِدُ",40,"د",1,0],["لِيَعِشْ وَلُيُطَاوِلِ الدَّهْرَ عُمْراً","وَلْتَزَدْهُ العَلْيَاءُ مَا يَتَزَيَّد",41,"د",1,0],["لِيَعِشْ سَعِيداً بَالِغاً مِنْ دَهْرِهِ","مَا شَاءَ مِنْ عِزّ وَمِنْ إِقْبَالِ",42,"ل",1,0],["ليعلموا أنه التكليف لا نسب","يغني ولا فيه دون الله من وزر",43,"ر",1,0],["ليعلم الجد أما زل بي قدما","اني على جد عزم ما به زلل",44,"ل",1,0],["ليعمل الحب بنفسي ما يرى","ان ضلالي بهوى القوم هدى",45,"ا",1,0],["ليعلم قصدي عالم الجهر والخفا","وللعبد ما ينوي وان سد مانع",46,"ع",1,0],["لي على الوجدِ ولا الصبرُ مُعِينا","وسلِ الرَّبعَ الذي سُكانُه",47,"ن",2,0],["ليعودَ مما \" تنفُثين \" به","مِسخاً فلا نَوماً ولا أرَقا",48,"ق",2,0],["لِيَعلِمَ سامعُه أنَّه","\" ينوبُ !\" عن البلدِ المُبتلى",49,"ا",1,0],["لَيَعْتَسِفَنّ العِيسَ، وَهْمٌ مُشَيَّعٌ،","عَنُوفٌ بها في حَلّهِ، وَارتحالهِ",50,"ل",2,0],["لي عنده من أدمعي كنز تضيق به العياب","يا ربّ : بابك لا يردّ اللائذين به حجاب",51,"ب",1,0],["ليعل ذا المجد ولتعظم مصادره","فقد تصدى له مولاه حين سطا",52,"ط",2,0],["ليعقبنا عليكم كلّ رزءٍ","يسيل الدمع منكم والدماء",53,"ا",2,0],["ليعيش بين الخاملين","ويقيم بين الميتين",54,"ن",1,0],["ليعلمَ قوماً بعدنا أن ماله","من النخلِ والأشجارِ والأرض فاهتدِى",55,"د",2,0],["لِيَعلمَ مَن تَأَمَّلَهُ بِأنَّا","عَبِيدُ أقَارِبِ الشَّيخِ الجَلَيلِ",56,"ل",1,1],["ليعلم من شكَّ أن المنو","نَ هوجاءُ ما عندها شافعُ",57,"ع",1,0],["لي عَنكَ إِن شَطَّ المَزارُ غَداً غِنىً","إِن كانَ يُغني مُمعِرٌ عَن مُمرِعِ",58,"ع",1,0],["لي عنه إن أعرض في الأرض رها","وأحمد ما باعني ولا رهن",59,"ن",1,0],["لِي عَن دِيارِ الأَذى وَالهُونِ مُتَّسَعٌ","ما كُلُّ دارٍ مَناخُ الوَيلِ وَالحرَبِ",60,"ب",1,0],["لِيَعلَمَ أَهلُ الغَدرِ أَنَّ عَداوَتي","لَأَمقَرُ مِن صابٍ وَأَقطَعُ مِن نَصلِ",61,"ل",1,0],["ليعلمنَّ زماني أيَّ مُنْقَلَبٍ","إذا لقيت بني داودَ يَنْقَلِبُ",62,"ب",1,0],["ليعلم أعداء الهدى أن ديننا","هو الحق فيه الأمر سهل موسع",63,"ع",1,0],["لي عِندَهُ وِردُ ظَمٍ","ظامٍ وَمَرعى سَغِبِ",64,"ب",1,0],["لي عجزٌ أراحَ قلبي من الهمِّ","ومن طول فكرتي في المُحال",65,"ل",1,0],["ليعلمَ أنَّنا فتيانُ صِدقٍ","يُلبّونَ المروءةَ مُسرعينا",66,"ن",2,0],["لي عَائِدٌ مِنْ عَطَايَاهَا ولِي صِلَةٌ","سَحَّتْ سَحَاباً فَلا مَحْلٌ وَلا شَظَفُ",67,"ف",1,0],["لِيَعْلَمَ مَنْ بِأَرْضِ النِّيلِ أَضْحى","وَمَنْ حَلَّ الْفُراتَ إلى الصَّراةِ",68,"ه",1,0],["لي عاذِلٌ في الحُبِّ ما أَعذَلَه","وَعَن طَريقِ العَدلِ ما أَعدَلَه",69,"ل",2,1],["لي عادةٌ مُستحسَنه","أَفعلُها كلَّ سنَه",70,"ه",1,0],["لِيَعُمَّهُ إِحسانُهُ","وَيَكونُ في أَعلى جِوارِ",71,"ر",1,0],["لِيَعدو هَمَّنا هَرَباً","وَروحُ الأُنسِ تُحيينا",72,"ن",2,0],["لي عَادَةٌ مِن أَيادِي","كَ يَالَها مِن عَوَائِدْ",73,"د",1,1],["لي علَي خَدِّ الحَبِيبِ دَمُ","فإلى مَنْ فِيهِ أَحتَكِمُ",74,"م",1,1],["لِيَعرِفَها في البَدوِ مَن كانَ عارِفاً","وَيُنكِرُها ذو الجَهلِ أَوَّلَ مَرَّةِ",75,"ه",1,0],["لِيعلمَ كُلٌّ عندك اليومَ مَوضِعي","وللفضلِ عند العارِفين قَبول",76,"ل",1,0],["لِيَعْلمَ فيَّ رأْيَكَ قَبْلُ عِلْماً","فيَتبَع إنْ أدالَ وإنْ أذالا",77,"ل",2,0],["ليعلَمَ مُهدي كُسوةٍ لك أنّه","هو المُكتسي للفَخْرِ حينَ كَساكا",78,"ك",2,0],["لي عِندَكُم دَينٌ وَلَكِن هَل لَهُ","مِن طالِبٍ وَفُؤاديَ المَوهونُ",79,"ن",1,1],["ليَعلمَ الناسُ أنِّي قد بذلت له","وَجهي إليكِ ولكِن حينه حانا",80,"ن",2,0],["لي عندكم فكرٌ يُسَرُّ بلَمْحِكم","ولكم لدي الذكرُ ضمنَ بكاء",81,"ا",2,0],["لَيعينِكِ وخزة في كُلِّ قَلبٍ","أَأَشفارٌ جفونك أَم شفارُ",82,"ر",1,0],["لِيَعلَمَ أنَّ سِهامَ الغَرا","مِ قبلَ إصابَتِها تَقتُلُ",83,"ل",1,0],["لي على قَدِّك نَوْحٌ في الدُّجى","مثلما ناحتْ على الغصنِ الحمائم",84,"م",1,0],["ليَعْلَمَ أنِّي فتًى أَمْرهُ","مطاعٌ وسطوتُه تَقْهَرُ",85,"ر",1,0],["لي عادة كلما خاصمتها وأنا","فقيرة ظفرت كفاي بالمنن",86,"ن",1,0],["ليعلم الحسَّادُ فيه أنني","بعتُ به الناس فلم أخشَ الغَبَنْ",87,"ن",1,0],["لي عفَّتي عنه وما نال له","وخيرُنا مَن عارك العيشَ الخشِنْ",88,"ن",1,0],["لي عند ظبي الأجرعِ","قصاصُ جرح ما رُعي",89,"ع",2,1],["ليعلمَ قبرٌ بالمدينة أنني","من الغيثِ أَوْفَى أو من الغيثِ أَسمَحُ",90,"ح",1,0],["ليعتلجنْ بي البيوتِ مع الضُّحى","مقالٌ كأطرافِ الرماح الشَّوارع",91,"ع",1,0],["ليَ عند البرق والريح إلى","تاجها مألكة لو بلَّغاها",92,"ا",3,0],["ليَعْلو طَريقَ القَوْمِ بعدَ انْحِطاطِهِ","ويبلُجُ من نَهْجِ الرِّجالِ المُعَتَّمُ",93,"م",1,0],["ليعودَ ميِّتُكُمْ بلمعَةِ أُنسِهِ","حَيًّا ويُحْيي العاشِقينَ رُجُوعُهُ",94,"ع",2,0],["ليعلم أن الله أبقى لكم بها","مآثر من مجد إلى الحشر تؤثر",95,"ر",1,0],["لي عند جودك عادة من كسوة","يعلو بها قدري ويسمو مفخري",96,"ر",2,0],["ليعلم أن الله جل جلاله","أفادك معنى العلم قبل التعلم",97,"م",1,0],["ليَعلَمَ أَنَّ البُعدَ لَم يُنسِ ذِكرَها","وَقَد يُذهِلُ النأيُ الطَويلُ وَقَد يُنسي",98,"س",2,0],["ليعرف الرب به وهو لا","ينهى عن العقل وتفكيره",99,"ر",2,0],["لي على قربه دواوين عشق","نظمها العذب أطرب النساخا",100,"خ",2,0],["ليعلموا ذلك من مقاله","وكان في إصلاح بعض ماله",101,"ه",1,0],["لي عُرسٌ في كُلِّ يومٍ بإِنْعا","مِكَ بلْ كلَّ ساعةٍ ليَ عِيدُ",102,"د",1,0],["لي عَدن مِنْ راحتيكَ وَمَدْحِي","لَك مِنْه لا زَال عَنْه الخُلُودُ",102,"د",1,0],["ليعوِّدا جسميهما نوم الثرى","من قبل ان يسطو عليه الضيغم",103,"م",1,0],["لي عَدُوٌّ وَلي صَديقٌ وَخَوفي","مِن صَديقي كَخيفَتي مِن عَدُوّي",104,"و",2,0],["ليَعلَمَ شَمسُ الدّينِ أحمَدُ وابنُهُ","مُحَمَّدُ شِبهُ الرُّوحِ عيسى ابنُ مَريَمَ",105,"م",1,0],["ليعلن أسراري وجهدي أصونه","ول