{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"قالوا انتبذ قلت مهلا","https://www.aldiwan.net/poem62888.html","المجتث"],[51,"حان كلام المعاتب الخرس","https://www.aldiwan.net/poem64655.html","المنسرح"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"قالوا هجاك أبو حفص ولحيته","https://www.aldiwan.net/poem65864.html","البسيط"],[51,"ليعاقب وسمي جود وليه","https://www.aldiwan.net/poem66723.html","الطويل"],[70,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[89,"ان مت فاجعل كفني طيبا","https://www.aldiwan.net/poem44686.html","السريع"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[45,"ليت الخليط الذي قد بان لم يبن","https://www.aldiwan.net/poem66670.html","البسيط"],[28,"أبا حاتم ما حاتم في زمانه","https://www.aldiwan.net/poem1270.html",""],[49,"يا عجبا للناس لو فكروا","https://www.aldiwan.net/poem62084.html","السريع"],[49,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[44,"وافى الحبيب الزائر","https://www.aldiwan.net/poem30250.html","مجزوء الكامل"],[44,"أهن عوادي يوسف وصواحبه","https://www.aldiwan.net/poem30578.html","الطويل"],[69,"لي على أن بلادي","https://www.aldiwan.net/poem28940.html","مجزوء الرمل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[52,"بني عمنا الأدنين من آل طالب","https://www.aldiwan.net/poem27319.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[46,"بني الآداب غرتكم قديما","https://www.aldiwan.net/poem22343.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85293","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19289","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54956","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54872","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"عَذِيريَ منْ وَاشٍ بهَا لَمْ أُوَالهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31868",""],[116,"تخَطّت منك قافيةٌ عشاء","https://www.aldiwan.net/poem491.html",""],[122,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[126,"بنينا بأرض الله لله مسجدا","https://www.aldiwan.net/poem50632.html","الطويل"],[130,"ليعلم من تأمله بأنا","https://www.aldiwan.net/poem54766.html","الطويل"],[140,"عزاء فما يصنع الجازع","https://www.aldiwan.net/poem58403.html","المتقارب"],[141,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[158,"إن له فرط غرام وأسا","https://www.aldiwan.net/poem58976.html","الرجز"],[167,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[167,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[196,"ألوت بأهل اللوى المهرية النجب","https://www.aldiwan.net/poem51984.html","البسيط"],[229,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[233,"واعجبي وحادث الد","https://www.aldiwan.net/poem32166.html","مجزوء الرجز"],[248,"أنا في راحة من الآمال","https://www.aldiwan.net/poem15018.html","الخفيف"],[268,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[273,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[278,"ألا من مبلغ عني عليا","https://www.aldiwan.net/poem60781.html","الوافر"],[280,"لي عاذل في الحب ما أعذله","https://www.aldiwan.net/poem32635.html","السريع"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[318,"هذا ضريح أخي علا","https://www.aldiwan.net/poem61610.html","مجزوء الكامل"],[318,"هلموا يا أخلائي","https://www.aldiwan.net/poem61784.html","مجزوء الوافر"],[346,"لي عادة من أيادي","https://www.aldiwan.net/poem20199.html","المجتث"],[346,"لي علي خد الحبيب دم","https://www.aldiwan.net/poem20693.html","المديد"],[347,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[362,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[362,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[362,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[364,"لي عندكم دين ولكن هل له","https://www.aldiwan.net/poem17132.html","الكامل"],[369,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[374,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[403,"سقى دمعي الأحبة حيث ساروا","https://www.aldiwan.net/poem50161.html","الوافر"],[406,"أما في الهوى حاكم يعدل","https://www.aldiwan.net/poem32553.html","المتقارب"],[413,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[413,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[426,"سالت مأسورة قامت مخاصمة","https://www.aldiwan.net/poem40823.html","البسيط"],[456,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[456,"يا دار لهوي بالنجيل من قطن","https://www.aldiwan.net/poem55854.html","الرجز"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[456,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[459,"حلفت بما شادت تميم من العلى","https://www.aldiwan.net/poem15122.html","الطويل"],[462,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[498,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[498,"لله من جفن هملن دموعه","https://www.aldiwan.net/poem37965.html","الكامل"],[513,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[513,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[513,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[538,"قفا فهريقا الدمع بالمنزل الدرس","https://www.aldiwan.net/poem56802.html","الطويل"],[556,"يا عابدا ربا بتصويره","https://www.aldiwan.net/poem34459.html","السريع"],[556,"ركب شوق بدار قلبي أناخا","https://www.aldiwan.net/poem34657.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"]],"verses":[["لِيَعلَمَ مَن أُناضِلُ أَنَّ شِعري","يُطالِعُ بِالشَقاءِ وَبِالنَعيمِ",0,"م",1,0],["لِيَعتَسِفَنَّ هَذا اللَيلَ مِنّي","أُشَيعِثُ عابُ لِمَّتِهِ الغَوالي",1,"ي",1,0],["لَيَعودَن لِمَعَدٍّ عَكرُها","دَلَجُ اللَيلِ وَتَأخاذُ المِنَح",2,"ح",1,0],["لَيُعيدَن لِمَعَدٍّ عِكرَها","دَلَجَ اللَيلِ وَإِكفاءَ المِنَح",2,"ح",1,0],["لَيَعْرِفُونَ لَكَ الْفَضْلَ الْعَظِيمَ بِمَا","أَوْليتَ مِنْ مِنَنٍ مَوْصُولَةِ السَّبَبِ",3,"ب",1,0],["لي على روض جدّه كلّ يومٍ","أدمعٌ مستهلَّةٌ كالغيوم",4,"م",1,0],["ليَ عَينٌ هواي فيكم يُريها","منْ جَلاهَا بلومكم إقذاءَ",5,"ا",2,0],["لِيُعلَم ألَّا موتَ ميتٍ لكَبْرةٍ","ولا عيش حيٍّ لاقتبال نباتِ",6,"ت",1,0],["لي عنده بحر سُقيا","للفُلْك فيه مَسير",7,"ر",1,0],["لي عصبة لا تزال تُدْحس لي","عندك تَعْساً للعصبة الدُحُس",8,"س",1,0],["لي عفة حسب من تكون له","من الغنى غُفَّةٌ من الغُفَف",9,"ف",1,0],["ليعتزلْ أحد القِرْنين ثم يرى","حربي إذا قذفت أرجاؤها الشعلا",10,"ل",2,0],["ليعاقب وسْمِيَّ جُودٍ وَليُّهْ","مِنْ كريم رجا نداهُ وليُّهْ",11,"ي",2,1],["لي عِندَكَ حاجَةٌ فَقُل لي","هَل أَنتَ إِذا سَأَلتُ باذِل",12,"ل",1,0],["ليعلم الموتى باني امرؤ","قد جئتهم تواً من الدنيا",13,"ي",2,0],["لِيُعِنّا كل معبود معين","نحن حزب البكسِر المتفقين",14,"ن",1,1],["لِيَعلَمَ مَن هابَ السُرى خَشيَةَ الرَدى","بِأَنَّ قَضاءَ اللَهِ لَيسَ لَهُ رَدُّ",15,"د",1,0],["لَيَعتَسِفَنَّ العيسَ هَمُّ مُشَيَّعٍ","عَنوفٍ بِها في حَلِّهِ وَارتِحالِهِ",16,"ل",2,0],["لي عَن قَليلٍ ضَميرٌ لا يُلِمُّ بِهِ","وَجدٌ عَلَيكِ وَقَلبٌ غَيرُ مُرتَهَنِ",17,"ن",1,0],["لِيَعلَمَ ما أَحصاهُ فيمَن أَشَعتَهُ","جَميعاً إِلى يَومِ القِيامَةِ حاسِبُه",18,"ب",2,0],["لَيَعلَمَنَّ الناسُ أَنَّ التُقى","وَالبِرِّ كانا خَيرَ ما يُذخَرُ",19,"ر",1,0],["لِيَعلَم كُلُّ ذي عَمَلٍ","بِأَنَّ اللَهَ سائِلُهُ",20,"ل",2,0],["لِيُعطي الخِلافَةَ أَهلاً لَها","فَلَم يَرتَضوهُ لِإِيجابِها",21,"ب",3,0],["لي عَبرَةٌ في الخَدِّ سا","ئِرَةٌ وَبَيتٌ سائِرُ",22,"ر",1,0],["لِيُعلَمَ أَنَّ الغُرَّ مِن آلِ مُصعَبٍ","غَداةَ الوَغى آلُ الوَغى وَأَقارِبُه",23,"ب",2,0],["لي على أنَّ بلادي","تشتهي قربي دليلُ",24,"ل",1,1],["لي عُذرُهم ما أنتَ من عِدَةِ المُنَى","إلا وراءَ مخيلةٍ ما تَصدُقُ",25,"ق",1,0],["لِيُعلِمَكُم أَنَّ الَّتي قَد حَرَصتُمُ","عَلَيها وَغودِرتُم عَلى أَثرِها صَرعى",26,"ا",1,0],["لِيَعْلَمَ أَغْنَى العالَمِينَ بِأَنَّهُ","إلَى كَلِمي مِنِّي لِدُنْياهُ أَفْقَرُ",27,"ر",1,0],["لِيَعلَمَ أهْلُ الشّرْقِ والغَرْبِ أنّني","بنفسيَ لا بالوفدِ كان تَقَدُّمي",28,"م",2,0],["ليَعْقِدِ التاجَ هذا اليومُ مفتخراً","إن كان تُوِّجَ يْومٌ سائرُ المَثَل",29,"ل",1,0],["لِيَعْرِفْكَ من أنتَ مَنجاتُه","إذا ما اتّقى اللهَ حقَّ التُّقى",30,"ا",1,0],["ليَ عرسٌ حرّةٌ مملوكةٌ","حزتُها من غير مهرٍ وثمَن",31,"ن",1,1],["لِيَعدُ مَعَ الضَبابِ سَليلُ حُجرٍ","وَسائِرَ قَولِهِ في اِبنِ الضَبابِ",32,"ب",1,0],["لي على حبي للعراق شهود","من دموعي وَقَلبي الخفاق",33,"ق",1,0],["لي عندك حقٌّ أَنشدُهُ","أتقرّ به أم تجحدُهُ",34,"د",2,1],["لي عند ذكرك يا صفا إِطراقُ","وَدموع حزن في التراب تراقُ",35,"ق",1,1],["لِيَعلَمَ الغافِلُ ما أَمسُهُ","ما يَومُهُ ما مُنتَهى العيشَةِ",36,"ه",1,0],["لِي عِنْدَ سَاكِنِهَا عَهْدٌ شَقِيتُ بِهِ","وَالْعَهْدُ ما لَم يَصُنْهُ الْوُدُّ مُنْقَضِبُ",37,"ب",1,0],["لِيَعِشْ فَائِزاً بِأَغْلَى الأَمَانِي","وَلْيُخَلَّدْ ذِكْرَاهُ دَهْراً فَدَهْرَا",38,"ر",2,0],["لِيَعُنْكِ رَبُّكِ يَا مُصَوِّرَتِي عَلى","مَا سُمْتِ فَنَّكِ مِنْ عَنَاءٍ بَاهِر",39,"ر",1,0],["ليَعْذِرْنِيَ الإِخَوْانُ إِنْ جَفَّ مِرْقَمِي","فَقَدْ عَلِمَ الإِخْوَانُ مَنْ أَنَا فَاقِدُ",40,"د",1,0],["لِيَعِشْ وَلُيُطَاوِلِ الدَّهْرَ عُمْراً","وَلْتَزَدْهُ العَلْيَاءُ مَا يَتَزَيَّد",41,"د",1,0],["لِيَعِشْ سَعِيداً بَالِغاً مِنْ دَهْرِهِ","مَا شَاءَ مِنْ عِزّ وَمِنْ إِقْبَالِ",42,"ل",1,0],["لي على الوجدِ ولا الصبرُ مُعِينا","وسلِ الرَّبعَ الذي سُكانُه",43,"ن",2,0],["ليعودَ مما \" تنفُثين \" به","مِسخاً فلا نَوماً ولا أرَقا",44,"ق",2,0],["لِيَعلِمَ سامعُه أنَّه","\" ينوبُ !\" عن البلدِ المُبتلى",45,"ا",1,0],["لَيَعْتَسِفَنّ العِيسَ، وَهْمٌ مُشَيَّعٌ،","عَنُوفٌ بها في حَلّهِ، وَارتحالهِ",46,"ل",2,0],["ليعقبنا عليكم كلّ رزءٍ","يسيل الدمع منكم والدماء",47,"ا",2,0],["ليعيش بين الخاملين","ويقيم بين الميتين",48,"ن",1,0],["ليعلمَ قوماً بعدنا أن ماله","من النخلِ والأشجارِ والأرض فاهتدِى",49,"د",2,0],["لِيَعلمَ مَن تَأَمَّلَهُ بِأنَّا","عَبِيدُ أقَارِبِ الشَّيخِ الجَلَيلِ",50,"ل",1,1],["ليعلم من شكَّ أن المنو","نَ هوجاءُ ما عندها شافعُ",51,"ع",1,0],["لي عَنكَ إِن شَطَّ المَزارُ غَداً غِنىً","إِن كانَ يُغني مُمعِرٌ عَن مُمرِعِ",52,"ع",1,0],["لي عنه إن أعرض في الأرض رها","وأحمد ما باعني ولا رهن",53,"ن",1,0],["لِي عَن دِيارِ الأَذى وَالهُونِ مُتَّسَعٌ","ما كُلُّ دارٍ مَناخُ الوَيلِ وَالحرَبِ",54,"ب",1,0],["لِيَعلَمَ أَهلُ الغَدرِ أَنَّ عَداوَتي","لَأَمقَرُ مِن صابٍ وَأَقطَعُ مِن نَصلِ",55,"ل",1,0],["ليعلمنَّ زماني أيَّ مُنْقَلَبٍ","إذا لقيت بني داودَ يَنْقَلِبُ",56,"ب",1,0],["ليعلم أعداء الهدى أن ديننا","هو الحق فيه الأمر سهل موسع",57,"ع",1,0],["لي عِندَهُ وِردُ ظَمٍ","ظامٍ وَمَرعى سَغِبِ",58,"ب",1,0],["لي عجزٌ أراحَ قلبي من الهمِّ","ومن طول فكرتي في المُحال",59,"ل",1,0],["ليعلمَ أنَّنا فتيانُ صِدقٍ","يُلبّونَ المروءةَ مُسرعينا",60,"ن",2,0],["لي عَائِدٌ مِنْ عَطَايَاهَا ولِي صِلَةٌ","سَحَّتْ سَحَاباً فَلا مَحْلٌ وَلا شَظَفُ",61,"ف",1,0],["لِيَعْلَمَ مَنْ بِأَرْضِ النِّيلِ أَضْحى","وَمَنْ حَلَّ الْفُراتَ إلى الصَّراةِ",62,"ه",1,0],["لي عاذِلٌ في الحُبِّ ما أَعذَلَه","وَعَن طَريقِ العَدلِ ما أَعدَلَه",63,"ل",2,1],["لي عادةٌ مُستحسَنه","أَفعلُها كلَّ سنَه",64,"ه",1,0],["لِيَعُمَّهُ إِحسانُهُ","وَيَكونُ في أَعلى جِوارِ",65,"ر",1,0],["لِيَعدو هَمَّنا هَرَباً","وَروحُ الأُنسِ تُحيينا",66,"ن",2,0],["لي عَادَةٌ مِن أَيادِي","كَ يَالَها مِن عَوَائِدْ",67,"د",1,1],["لي علَي خَدِّ الحَبِيبِ دَمُ","فإلى مَنْ فِيهِ أَحتَكِمُ",68,"م",1,1],["لِيَعرِفَها في البَدوِ مَن كانَ عارِفاً","وَيُنكِرُها ذو الجَهلِ أَوَّلَ مَرَّةِ",69,"ه",1,0],["لِيعلمَ كُلٌّ عندك اليومَ مَوضِعي","وللفضلِ عند العارِفين قَبول",70,"ل",1,0],["لِيَعْلمَ فيَّ رأْيَكَ قَبْلُ عِلْماً","فيَتبَع إنْ أدالَ وإنْ أذالا",71,"ل",2,0],["ليعلَمَ مُهدي كُسوةٍ لك أنّه","هو المُكتسي للفَخْرِ حينَ كَساكا",72,"ك",2,0],["لي عِندَكُم دَينٌ وَلَكِن هَل لَهُ","مِن طالِبٍ وَفُؤاديَ المَوهونُ",73,"ن",1,1],["ليَعلمَ الناسُ أنِّي قد بذلت له","وَجهي إليكِ ولكِن حينه حانا",74,"ن",2,0],["لي عندكم فكرٌ يُسَرُّ بلَمْحِكم","ولكم لدي الذكرُ ضمنَ بكاء",75,"ا",2,0],["لَيعينِكِ وخزة في كُلِّ قَلبٍ","أَأَشفارٌ جفونك أَم شفارُ",76,"ر",1,0],["لِيَعلَمَ أنَّ سِهامَ الغَرا","مِ قبلَ إصابَتِها تَقتُلُ",77,"ل",1,0],["لي على قَدِّك نَوْحٌ في الدُّجى","مثلما ناحتْ على الغصنِ الحمائم",78,"م",1,0],["ليَعْلَمَ أنِّي فتًى أَمْرهُ","مطاعٌ وسطوتُه تَقْهَرُ",79,"ر",1,0],["لي عادة كلما خاصمتها وأنا","فقيرة ظفرت كفاي بالمنن",80,"ن",1,0],["ليعلم الحسَّادُ فيه أنني","بعتُ به الناس فلم أخشَ الغَبَنْ",81,"ن",1,0],["لي عفَّتي عنه وما نال له","وخيرُنا مَن عارك العيشَ الخشِنْ",82,"ن",1,0],["لي عند ظبي الأجرعِ","قصاصُ جرح ما رُعي",83,"ي",1,1],["ليعلمَ قبرٌ بالمدينة أنني","من الغيثِ أَوْفَى أو من الغيثِ أَسمَحُ",84,"ح",1,0],["ليعتلجنْ بي البيوتِ مع الضُّحى","مقالٌ كأطرافِ الرماح الشَّوارع",85,"ع",1,0],["ليَ عند البرق والريح إلى","تاجها مألكة لو بلَّغاها",86,"ا",3,0],["ليَعْلو طَريقَ القَوْمِ بعدَ انْحِطاطِهِ","ويبلُجُ من نَهْجِ الرِّجالِ المُعَتَّمُ",87,"م",1,0],["ليعودَ ميِّتُكُمْ بلمعَةِ أُنسِهِ","حَيًّا ويُحْيي العاشِقينَ رُجُوعُهُ",88,"ع",2,0],["ليعلم أن الله أبقى لكم بها","مآثر من مجد إلى الحشر تؤثر",89,"ر",1,0],["لي عند جودك عادة من كسوة","يعلو بها قدري ويسمو مفخري",90,"ر",2,0],["ليعلم أن الله جل جلاله","أفادك معنى العلم قبل التعلم",91,"م",1,0],["ليَعلَمَ أَنَّ البُعدَ لَم يُنسِ ذِكرَها","وَقَد يُذهِلُ النأيُ الطَويلُ وَقَد يُنسي",92,"ي",1,0],["ليعرف الرب به وهو لا","ينهى عن العقل وتفكيره",93,"ر",2,0],["لي على قربه دواوين عشق","نظمها العذب أطرب النساخا",94,"خ",2,0],["ليعلموا ذلك من مقاله","وكان في إصلاح بعض ماله",95,"ه",1,0],["لي عُرسٌ في كُلِّ يومٍ بإِنْعا","مِكَ بلْ كلَّ ساعةٍ ليَ عِيدُ",96,"د",1,0],["لي عَدن مِنْ راحتيكَ وَمَدْحِي","لَك مِنْه لا زَال عَنْه الخُلُودُ",96,"د",1,0]]}