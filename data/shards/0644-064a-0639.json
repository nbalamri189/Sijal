{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"قالوا انتبذ قلت مهلا","https://www.aldiwan.net/poem62888.html","المجتث"],[51,"حان كلام المعاتب الخرس","https://www.aldiwan.net/poem64655.html","المنسرح"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"قالوا هجاك أبو حفص ولحيته","https://www.aldiwan.net/poem65864.html","البسيط"],[51,"ليعاقب وسمي جود وليه","https://www.aldiwan.net/poem66723.html","الطويل"],[70,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[89,"ان مت فاجعل كفني طيبا","https://www.aldiwan.net/poem44686.html","السريع"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[45,"ليت الخليط الذي قد بان لم يبن","https://www.aldiwan.net/poem66670.html","البسيط"],[28,"أبا حاتم ما حاتم في زمانه","https://www.aldiwan.net/poem1270.html",""],[49,"يا عجبا للناس لو فكروا","https://www.aldiwan.net/poem62084.html","السريع"],[49,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[44,"وافى الحبيب الزائر","https://www.aldiwan.net/poem30250.html","مجزوء الكامل"],[44,"أهن عوادي يوسف وصواحبه","https://www.aldiwan.net/poem30578.html","الطويل"],[69,"لي على أن بلادي","https://www.aldiwan.net/poem28940.html","مجزوء الرمل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[52,"بني عمنا الأدنين من آل طالب","https://www.aldiwan.net/poem27319.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[46,"بني الآداب غرتكم قديما","https://www.aldiwan.net/poem22343.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85293","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19289","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54956","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54872","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"عَذِيريَ منْ وَاشٍ بهَا لَمْ أُوَالهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31868",""]],"verses":[["لِيَعلَمَ مَن أُناضِلُ أَنَّ شِعري","يُطالِعُ بِالشَقاءِ وَبِالنَعيمِ",0,"م",1,0],["لِيَعتَسِفَنَّ هَذا اللَيلَ مِنّي","أُشَيعِثُ عابُ لِمَّتِهِ الغَوالي",1,"ي",1,0],["لَيَعودَن لِمَعَدٍّ عَكرُها","دَلَجُ اللَيلِ وَتَأخاذُ المِنَح",2,"ح",1,0],["لَيُعيدَن لِمَعَدٍّ عِكرَها","دَلَجَ اللَيلِ وَإِكفاءَ المِنَح",2,"ح",1,0],["لَيَعْرِفُونَ لَكَ الْفَضْلَ الْعَظِيمَ بِمَا","أَوْليتَ مِنْ مِنَنٍ مَوْصُولَةِ السَّبَبِ",3,"ب",1,0],["لي على روض جدّه كلّ يومٍ","أدمعٌ مستهلَّةٌ كالغيوم",4,"م",1,0],["ليَ عَينٌ هواي فيكم يُريها","منْ جَلاهَا بلومكم إقذاءَ",5,"ا",2,0],["لِيُعلَم ألَّا موتَ ميتٍ لكَبْرةٍ","ولا عيش حيٍّ لاقتبال نباتِ",6,"ت",1,0],["لي عنده بحر سُقيا","للفُلْك فيه مَسير",7,"ر",1,0],["لي عصبة لا تزال تُدْحس لي","عندك تَعْساً للعصبة الدُحُس",8,"س",1,0],["لي عفة حسب من تكون له","من الغنى غُفَّةٌ من الغُفَف",9,"ف",1,0],["ليعتزلْ أحد القِرْنين ثم يرى","حربي إذا قذفت أرجاؤها الشعلا",10,"ل",2,0],["ليعاقب وسْمِيَّ جُودٍ وَليُّهْ","مِنْ كريم رجا نداهُ وليُّهْ",11,"ي",2,1],["لي عِندَكَ حاجَةٌ فَقُل لي","هَل أَنتَ إِذا سَأَلتُ باذِل",12,"ل",1,0],["ليعلم الموتى باني امرؤ","قد جئتهم تواً من الدنيا",13,"ي",2,0],["لِيُعِنّا كل معبود معين","نحن حزب البكسِر المتفقين",14,"ن",1,1],["لِيَعلَمَ مَن هابَ السُرى خَشيَةَ الرَدى","بِأَنَّ قَضاءَ اللَهِ لَيسَ لَهُ رَدُّ",15,"د",1,0],["لَيَعتَسِفَنَّ العيسَ هَمُّ مُشَيَّعٍ","عَنوفٍ بِها في حَلِّهِ وَارتِحالِهِ",16,"ل",2,0],["لي عَن قَليلٍ ضَميرٌ لا يُلِمُّ بِهِ","وَجدٌ عَلَيكِ وَقَلبٌ غَيرُ مُرتَهَنِ",17,"ن",1,0],["لِيَعلَمَ ما أَحصاهُ فيمَن أَشَعتَهُ","جَميعاً إِلى يَومِ القِيامَةِ حاسِبُه",18,"ب",2,0],["لَيَعلَمَنَّ الناسُ أَنَّ التُقى","وَالبِرِّ كانا خَيرَ ما يُذخَرُ",19,"ر",1,0],["لِيَعلَم كُلُّ ذي عَمَلٍ","بِأَنَّ اللَهَ سائِلُهُ",20,"ل",2,0],["لِيُعطي الخِلافَةَ أَهلاً لَها","فَلَم يَرتَضوهُ لِإِيجابِها",21,"ب",3,0],["لي عَبرَةٌ في الخَدِّ سا","ئِرَةٌ وَبَيتٌ سائِرُ",22,"ر",1,0],["لِيُعلَمَ أَنَّ الغُرَّ مِن آلِ مُصعَبٍ","غَداةَ الوَغى آلُ الوَغى وَأَقارِبُه",23,"ب",2,0],["لي على أنَّ بلادي","تشتهي قربي دليلُ",24,"ل",1,1],["لي عُذرُهم ما أنتَ من عِدَةِ المُنَى","إلا وراءَ مخيلةٍ ما تَصدُقُ",25,"ق",1,0],["لِيُعلِمَكُم أَنَّ الَّتي قَد حَرَصتُمُ","عَلَيها وَغودِرتُم عَلى أَثرِها صَرعى",26,"ا",1,0],["لِيَعْلَمَ أَغْنَى العالَمِينَ بِأَنَّهُ","إلَى كَلِمي مِنِّي لِدُنْياهُ أَفْقَرُ",27,"ر",1,0],["لِيَعلَمَ أهْلُ الشّرْقِ والغَرْبِ أنّني","بنفسيَ لا بالوفدِ كان تَقَدُّمي",28,"م",2,0],["ليَعْقِدِ التاجَ هذا اليومُ مفتخراً","إن كان تُوِّجَ يْومٌ سائرُ المَثَل",29,"ل",1,0],["لِيَعْرِفْكَ من أنتَ مَنجاتُه","إذا ما اتّقى اللهَ حقَّ التُّقى",30,"ا",1,0],["ليَ عرسٌ حرّةٌ مملوكةٌ","حزتُها من غير مهرٍ وثمَن",31,"ن",1,1],["لِيَعدُ مَعَ الضَبابِ سَليلُ حُجرٍ","وَسائِرَ قَولِهِ في اِبنِ الضَبابِ",32,"ب",1,0],["لي على حبي للعراق شهود","من دموعي وَقَلبي الخفاق",33,"ق",1,0],["لي عندك حقٌّ أَنشدُهُ","أتقرّ به أم تجحدُهُ",34,"د",2,1],["لي عند ذكرك يا صفا إِطراقُ","وَدموع حزن في التراب تراقُ",35,"ق",1,1],["لِيَعلَمَ الغافِلُ ما أَمسُهُ","ما يَومُهُ ما مُنتَهى العيشَةِ",36,"ه",1,0],["لِي عِنْدَ سَاكِنِهَا عَهْدٌ شَقِيتُ بِهِ","وَالْعَهْدُ ما لَم يَصُنْهُ الْوُدُّ مُنْقَضِبُ",37,"ب",1,0],["لِيَعِشْ فَائِزاً بِأَغْلَى الأَمَانِي","وَلْيُخَلَّدْ ذِكْرَاهُ دَهْراً فَدَهْرَا",38,"ر",2,0],["لِيَعُنْكِ رَبُّكِ يَا مُصَوِّرَتِي عَلى","مَا سُمْتِ فَنَّكِ مِنْ عَنَاءٍ بَاهِر",39,"ر",1,0],["ليَعْذِرْنِيَ الإِخَوْانُ إِنْ جَفَّ مِرْقَمِي","فَقَدْ عَلِمَ الإِخْوَانُ مَنْ أَنَا فَاقِدُ",40,"د",1,0],["لِيَعِشْ وَلُيُطَاوِلِ الدَّهْرَ عُمْراً","وَلْتَزَدْهُ العَلْيَاءُ مَا يَتَزَيَّد",41,"د",1,0],["لِيَعِشْ سَعِيداً بَالِغاً مِنْ دَهْرِهِ","مَا شَاءَ مِنْ عِزّ وَمِنْ إِقْبَالِ",42,"ل",1,0],["لي على الوجدِ ولا الصبرُ مُعِينا","وسلِ الرَّبعَ الذي سُكانُه",43,"ن",2,0],["ليعودَ مما \" تنفُثين \" به","مِسخاً فلا نَوماً ولا أرَقا",44,"ق",2,0],["لِيَعلِمَ سامعُه أنَّه","\" ينوبُ !\" عن البلدِ المُبتلى",45,"ا",1,0],["لَيَعْتَسِفَنّ العِيسَ، وَهْمٌ مُشَيَّعٌ،","عَنُوفٌ بها في حَلّهِ، وَارتحالهِ",46,"ل",2,0]]}