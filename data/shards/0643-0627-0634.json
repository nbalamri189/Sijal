{"poems":[[88,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[95,"علمتني الخط فما راعني","https://www.aldiwan.net/poem11080.html","السريع"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[80,"يا سيدي الأعلى ومن","https://www.aldiwan.net/poem14171.html","مجزوء الكامل"],[87,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55008","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[119,"ما العقد الكربة الدهماء حل","https://www.aldiwan.net/poem42167.html","الرمل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[369,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[415,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[422,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[463,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[466,"أسد الدين والنداء لغيرا","https://www.aldiwan.net/poem16178.html","الخفيف"],[484,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[500,"كفم الحبيب كطرفه","https://www.aldiwan.net/poem9866.html","مجزوء الكامل"],[563,"أشكر الله خالقي في البريه","https://www.aldiwan.net/poem33560.html","الخفيف"],[563,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[563,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96987","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63841","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62541","الرمل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119254","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71077","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115217","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58287","الخفيف"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140283",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90877","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83458","الخفيف"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146764","الطويل"],[4753,"عاشق السوسن","https://www.poetsgate.com/ViewPoem.aspx?id=108350",""],[4755,"نَحنُ أَهدَافُ رَمْيِنَا.. والرُّمَاةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184090",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4852,"كيف لك..؟","https://www.poetsgate.com/ViewPoem.aspx?id=214328",""],[4869,"المتكبر","https://www.poetsgate.com/ViewPoem.aspx?id=151688",""],[5376,"أما في الدارِ أشواقٌ وشمسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=188450",""],[5387,"أرواح عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=62723",""],[5411,"سَبَّحَ الشِّعْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190638",""],[5431,"لغة الحب أن تذوب عطاءً","https://www.poetsgate.com/ViewPoem.aspx?id=198222",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[402,"علمتني الخط فما راعني","https://www.poetsgate.com/ViewPoem.aspx?id=35923",""],[5992,"سابقِ الناسَ بالسلامِ ففي","https://www.poetsgate.com/ViewPoem.aspx?id=41848",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[6124,"أمسيات","https://www.poetsgate.com/ViewPoem.aspx?id=105842",""]],"verses":[["كاشِفَ الكَهرَباءِ لَيتَكَ تُعنى","بِاِختِراعٍ يَروضُ مِنّا الطِباعا",0,"ع",2,0],["كاشفتني من فنه موجزاً","بذلك السر اللطيف البديع",1,"ع",1,0],["كَأَشقى ثَمودٍ إِذ تَعاطى لِحَينِهِ","خَصيلَةَ أُمِّ السَقبِ وَالسَقبُ وارِدُ",2,"د",1,0],["كاشَفتَنا عَن سرِّها","فَوَشى إِليّ بِها الصُرَدْ",3,"د",1,0],["كأشيبٍ من الفِرِ","نج منحن مسلم",4,"م",1,0],["كَاشفَتْنِي مِنْ فَنِّه مُوجِداً","بِذَلِكَ السِّرِّ اللِّطِيفِ الْبَديعْ",5,"ع",1,0],["كَاشَفَتْهُ بِسِرِّ ما هَرِمَتْ فِيه","وَمَا زَالَ فِي صِبَاهُ النَّضْرِ",6,"ر",1,0],["كاشَفْتِهِمْ سِرَّ الْعَناصِرِ فَانْبَرَوْا","يَتَخَيَّرُونَ أمَضَّها لِرَداكِ",7,"ك",1,0],["كاشف البلوى إذا ما طأطأت","دونها الأفراد والأوتاد ذلوا",8,"ل",3,0],["كَأَشدَقِ عَبدِ شَمسٍ إِذ تَبَغّى","تُراثاً لَم يُخَلِّفهُ سَعيدُ",9,"د",1,0],["كَأَشلاءِ مَن قَد حَلَّ بِالرَملِ راضِياً","بِخُطَّةِ خَسفٍ بِالمَلا المُتَواعِثِ",10,"ث",1,0],["كأشباهِ التّصاويرِ","حَواها الجُدْرُ والبُسط",11,"ط",1,0],["كاشِفِ الغُمَّةِ المُبِرِّ على السح","بِ بجودٍ مَدَى الزّمانِ يصوبُ",12,"ب",1,0],["كاشف الغمّ إنْ توالت غموم","فارج الهمِّ عند ضيق الخناق",13,"ق",1,0],["كاشفتُها وصعُبتُ لما لم يكن","عوناً عليها الرفقُ والإلطافُ",14,"ف",1,0],["كاشفني بعدكُمُ بغلِّهِ","مَن كان يخشى جانبي مستتِرا",15,"ر",2,0],["كاشف الأغْبرينِ حربٍ وجدبٍ","بين صُفْرِ اللُّهى وبيض النِّصالِ",16,"ل",1,0],["كاشفتني بالحب فازددت حبا","ساءلتني هل لم تزل بي صبا",17,"ب",2,0],["كإشارتي في قبلة","كجواب نذل غير حر",18,"ر",1,0],["كاشفاً لي عنه وعن كل شيء","فتحققت بالمعاني الخفيه",19,"ي",2,0],["كاشفاً ظلمة القلوب بنور","هو لله واضح البرهان",20,"ن",1,0],["كاشف حيث لا بداية عنها","نور حق يعرِّفُ التنكيرا",21,"ر",2,0],["كاشح سر لعقة الكلب أنفاً","ثم في غمه القديم استمرا",22,"ر",2,0],["كاشفاً عن مُثَقِّفاتِ القوافي","كَشْفَ بعضِ الشياهِ بعضَ الشِّفار",23,"ر",1,0],["كاشف من سرِّ آي الذكر ما","أكسب الأوهام وهباً وأفادْ",24,"د",1,0],["كاشف كاسف كمي كفاح","كامل كافل كريم كفاء",25,"ا",2,0],["كاشفات عن الوجوه الخمارا","وعيون الطيور بالمرصاد",26,"د",1,0],["كاشِفُ الضُّرِّ والبلاءِ مجيبٌ","دعوةَ الوامقِ الحزينِ العاني",27,"ن",2,0],["كأَشْياخِ صِدْقٍ من ذْوابَةِ حاشِدٍ","بهم غير شَكٍّ يَنْقِمُ الوِتْرَ ذو الوِتْرِ",28,"ر",1,0],["كاشفا كل كرب خطب عن الناس","برجع لربه وخطاب",29,"ب",1,0],["كأشقر أضحى بين رمحين إن مضى","على الرمح ينحر أو تأخّر يعقَر",30,"ر",1,0],["كاشفِ القومَ في الذي سَتَروهُ","فَهْوَ حالٌ يا شَيخنا مكشوفُ",31,"ف",1,0],["كاشِفاتِ الْوُجوهِ لِلاََضْدادِ","لَسْتُ أنْسَى سَليلَةَ الزَّهْراءِ",32,"ا",2,0],["كاشف الضر مزيلٍ للعنا","عالم الأسرار في بطن المهج",33,"ج",1,0],["كاشِفٌ لِلنِّقابِ عَن لَدُنِيَّا","تِ عُلُومٍ لَم تَدرِهَا الأذكِياءُ",34,"ا",2,0],["كاشِفُ العارِ وَدَرَّاءُ الشِّدَد","إِنَّ فارِيسَ هَوَى النَّفسِ اعتَمَد",35,"د",1,0],["كاشف الصبل إن حلَّ الورى","يوم فيه الرّوع في الرُّوعِ استحال",36,"ل",1,0],["كاشف الأسواء عن ام القرى","صارف عنها اعتداء المعتدين",37,"ن",1,0],["كاشِفُ الغُمَّة الشَفيعُ المرجّى","الأَمينُ المَأمونُ ملجا العاني",38,"ن",2,0],["كأشكال طير الماء مدت جناحها","وأشخصن أعناقاً لها وحواصلا",39,"ل",2,0],["كاشفات الستر ما حطت على","من على روحي وقلبي قد جنى",40,"ن",2,0],["كَاشَفَتْنِي بحُرْقَةٍ عَن أَسَاها","وهْيَ عِرضٌ أَشَاحَ عَنهُ الكُمَاةُ",41,"ه",1,0],["كاشفا ظلمة بها سار من قد","ظن فعلا أتاه أمرا خفيا",42,"ي",2,0],["كاشفتني حُبًّا بلا حَدٍّ ..ولا عَدٍّ ..","فكان الصمتُ أجلى لي ولكْ",43,"ك",1,0],["كاشخ ولبسه عليه عطور","مايدري ان عقله مغبر",44,"ر",1,0],["كأشباحِ الظلام ينوء فيها","يباغثهم ردى والموتُ خلسُ",45,"س",1,0],["كإشراقِ الصباحِ على سريري","تدندهُ العنادلُ إذ تغني",46,"ن",2,0],["كاشِفُ الغَمِّ، فارِجُ الْهَمّ ذُو العِزْ","زَّة وَاللَّهُ غَالِبٌ جَبَروتُهْ",47,"ت",2,0],["كاشتعال الحياة في قلب شمس","دفعتها بعشقها للطلوع",48,"ع",1,0],["كاشِفاً ما يُسِرُّهُ مِنْ غُموض ٍ","ألْبَسَتْ كُنْهَهُ البحوثُ قِناعا",49,"ع",2,0],["كاشفتني في فنه موجدا","بذلك السر اللطيف البديع",50,"ع",1,0],["كاشِفُ الريْبِ، قاطع العَيْبِ، مُح","يي الودِّ، سترُ الأحقادِ، بابُ الوصال",51,"ل",1,0],["كاشِطًا حَدَّ سَمهَرٍ في مُلاقاتي","قَدْ يَرَى ضَربَةً تَحنِي لَهُ الضِّلعا",52,"ع",2,0],["كاشفاتٌ فاعلاتن كاتباتٌ","آيَ سحري وامتناني بانبهاري",53,"ر",2,0]]}