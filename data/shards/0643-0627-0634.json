{"poems":[[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[93,"علمتني الخط فما راعني","https://www.aldiwan.net/poem11080.html","السريع"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[78,"يا سيدي الأعلى ومن","https://www.aldiwan.net/poem14171.html","مجزوء الكامل"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55008","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[116,"ما العقد الكربة الدهماء حل","https://www.aldiwan.net/poem42167.html","الرمل"],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[165,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[365,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[410,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[417,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[459,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[459,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[462,"أسد الدين والنداء لغيرا","https://www.aldiwan.net/poem16178.html","الخفيف"],[480,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[496,"كفم الحبيب كطرفه","https://www.aldiwan.net/poem9866.html","مجزوء الكامل"],[559,"أشكر الله خالقي في البريه","https://www.aldiwan.net/poem33560.html","الخفيف"],[559,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[559,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"]],"verses":[["كاشِفَ الكَهرَباءِ لَيتَكَ تُعنى","بِاِختِراعٍ يَروضُ مِنّا الطِباعا",0,"ع",2,0],["كاشفتني من فنه موجزاً","بذلك السر اللطيف البديع",1,"ع",1,0],["كَأَشقى ثَمودٍ إِذ تَعاطى لِحَينِهِ","خَصيلَةَ أُمِّ السَقبِ وَالسَقبُ وارِدُ",2,"د",1,0],["كاشَفتَنا عَن سرِّها","فَوَشى إِليّ بِها الصُرَدْ",3,"د",1,0],["كأشيبٍ من الفِرِ","نج منحن مسلم",4,"م",1,0],["كَاشفَتْنِي مِنْ فَنِّه مُوجِداً","بِذَلِكَ السِّرِّ اللِّطِيفِ الْبَديعْ",5,"ع",1,0],["كَاشَفَتْهُ بِسِرِّ ما هَرِمَتْ فِيه","وَمَا زَالَ فِي صِبَاهُ النَّضْرِ",6,"ر",1,0],["كاشَفْتِهِمْ سِرَّ الْعَناصِرِ فَانْبَرَوْا","يَتَخَيَّرُونَ أمَضَّها لِرَداكِ",7,"ك",1,0],["كاشف البلوى إذا ما طأطأت","دونها الأفراد والأوتاد ذلوا",8,"ل",3,0],["كَأَشدَقِ عَبدِ شَمسٍ إِذ تَبَغّى","تُراثاً لَم يُخَلِّفهُ سَعيدُ",9,"د",1,0],["كَأَشلاءِ مَن قَد حَلَّ بِالرَملِ راضِياً","بِخُطَّةِ خَسفٍ بِالمَلا المُتَواعِثِ",10,"ث",1,0],["كأشباهِ التّصاويرِ","حَواها الجُدْرُ والبُسط",11,"ط",1,0],["كاشِفِ الغُمَّةِ المُبِرِّ على السح","بِ بجودٍ مَدَى الزّمانِ يصوبُ",12,"ب",1,0],["كاشف الغمّ إنْ توالت غموم","فارج الهمِّ عند ضيق الخناق",13,"ق",1,0],["كاشفتُها وصعُبتُ لما لم يكن","عوناً عليها الرفقُ والإلطافُ",14,"ف",1,0],["كاشفني بعدكُمُ بغلِّهِ","مَن كان يخشى جانبي مستتِرا",15,"ر",2,0],["كاشف الأغْبرينِ حربٍ وجدبٍ","بين صُفْرِ اللُّهى وبيض النِّصالِ",16,"ل",1,0],["كاشفتني بالحب فازددت حبا","ساءلتني هل لم تزل بي صبا",17,"ب",2,0],["كإشارتي في قبلة","كجواب نذل غير حر",18,"ر",1,0],["كاشفاً لي عنه وعن كل شيء","فتحققت بالمعاني الخفيه",19,"ي",2,0],["كاشفاً ظلمة القلوب بنور","هو لله واضح البرهان",20,"ن",1,0],["كاشف حيث لا بداية عنها","نور حق يعرِّفُ التنكيرا",21,"ر",2,0]]}