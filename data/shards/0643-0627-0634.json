{"poems":[[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[93,"علمتني الخط فما راعني","https://www.aldiwan.net/poem11080.html","السريع"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[78,"يا سيدي الأعلى ومن","https://www.aldiwan.net/poem14171.html","مجزوء الكامل"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55008","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"]],"verses":[["كاشِفَ الكَهرَباءِ لَيتَكَ تُعنى","بِاِختِراعٍ يَروضُ مِنّا الطِباعا",0,"ع",2,0],["كاشفتني من فنه موجزاً","بذلك السر اللطيف البديع",1,"ع",1,0],["كَأَشقى ثَمودٍ إِذ تَعاطى لِحَينِهِ","خَصيلَةَ أُمِّ السَقبِ وَالسَقبُ وارِدُ",2,"د",1,0],["كاشَفتَنا عَن سرِّها","فَوَشى إِليّ بِها الصُرَدْ",3,"د",1,0],["كأشيبٍ من الفِرِ","نج منحن مسلم",4,"م",1,0],["كَاشفَتْنِي مِنْ فَنِّه مُوجِداً","بِذَلِكَ السِّرِّ اللِّطِيفِ الْبَديعْ",5,"ع",1,0],["كَاشَفَتْهُ بِسِرِّ ما هَرِمَتْ فِيه","وَمَا زَالَ فِي صِبَاهُ النَّضْرِ",6,"ر",1,0],["كاشَفْتِهِمْ سِرَّ الْعَناصِرِ فَانْبَرَوْا","يَتَخَيَّرُونَ أمَضَّها لِرَداكِ",7,"ك",1,0]]}