{"poems":[[90,"وأن أصدق برق أنت شائمه","https://www.aldiwan.net/poem44810.html","البسيط"],[63,"إذا غضبت فلا تعجل بسيئة","https://www.aldiwan.net/poem51589.html","البسيط"],[60,"ترد رداء الصبر عند النوائب","https://www.aldiwan.net/poem31184.html","الطويل"],[132,"وسلم إلى رب العلا وتوكلن","https://www.aldiwan.net/poem50672.html","الطويل"],[396,"عن الناس لا تسأل ولا عن فعالهم","https://www.aldiwan.net/poem54512.html","عموديه"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[563,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96638","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109152","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124784","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83217","الطويل"],[2822,"","https://poetry.dctabudhabi.ae/diwan/poem/131387","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100866","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45902","الطويل"],[4875,"دهاليز الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=133355",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5415,"الحث على العلم","https://www.poetsgate.com/ViewPoem.aspx?id=213358",""],[5497,"القناعة","https://www.poetsgate.com/ViewPoem.aspx?id=210618",""],[5535,"يا ساعي الشوقِ الذي مُذْ جَرى","https://www.poetsgate.com/ViewPoem.aspx?id=201498",""]],"verses":[["وكن صَليباً إذا عضتك حادثةٌ","تَعَضّ منك بعُود ليس ينعجم",0,"م",1,0],["وكُنْ صَفوحاً فإنَّ الصَّفْحَ مَنقَبةٌ","أذكَى من الوَرْدِ غِبَّ القَطْرِ والآسِ",1,"س",1,0],["وَكُن صاحِباً لِلحِلمِ في كُلِّ مَشهَدٍ","فَما الحِلمُ إِلّا خَيرُ خِدنٍ وَصاحِبِ",2,"ب",1,0],["وكن صامِتاً في كل نادٍ ومجلس","وكن ناطِقاً بالحق في كل واجبِ",3,"ب",1,0],["وكن صامتا إلا بخير وحكمة","وأمر بمعروف ونهي لمعضل",4,"ل",1,0],["وكن صابر وشاكر","وحامد كل الأوقات",5,"ت",1,0],["وكن صِرْفاً بلا مزج","وكن روضاً بلا بقل",6,"ل",1,0],["وَكُن صابراً للأقربينَ وغيرهم","فكلُّ أَخى صبرٍ على الصبر يحمدُ",7,"د",1,0],["وكن صابراً مثلي عليه وكن معي","نكن واحداً نلقى الورى وانظرن فعلى",8,"ل",2,0],["وكن صابراً إنا لقينا مشقة","فإن تلقها فاصبر كصبر صبرناه",9,"ن",3,0],["وكن صابرا للفقر وادرع الرضا","بما قدر الرحكمن واشكره واحمد",10,"د",1,0],["وَكُن صافِحاً صَفحاً جَميلاً مُؤَوِّلاً","وَإِن كَثُرَ الوِزرُ الَّذي أَنقَضَ الظَهرا",11,"ر",2,0],["وكن صاحبي باللطف والحفط كلما","سريت لأمر أو تبوأت مضجعا",12,"ع",2,0],["وكن صدوقا اذا أبديت سوأتهم","يوم الحساب ولا ترضى الاباطيلا",13,"ل",2,0],["وكن صبورا لما تلقاه من ضرر","وعاشر الاهل بالمعروف والكرم",14,"م",1,0],["وكن صبورا شكورا كيسا فطنا","موحداً ابدا وحده واعتصم",14,"م",1,0],["وَكُن صابِراً فَالوَقت لَيسَ بِصالح","لَما رمت لَكن إِن صَبَرت تَحصلا",15,"ل",2,0],["وكنْ صواديف الليالي مهرجانات وعروض","ان سلمت مْن المقنع ماسلمت البهلواني",16,"ن",2,0],["وكن صادق القول والفعل ما","حييت مقيماً بمحرابه",17,"ب",2,0],["وَكُنْ صَادِعًا بِالْحَقِّ سَيْفًا مُصَلَّتًا","وَدُكَّ حُصُونَ الْجَهْلِ بِالْعِلْمِ وَلْتَهْدِمْ",18,"م",1,0],["وكن صبورا بصيرا في الحياة فكم","تجلو وتمحو بها أعتى البلياتِ",19,"ت",1,0],["وكن صديقي واقضِ لي حاجة","فشكرُ ذا عندي وشُكرانه",20,"ن",2,0]]}