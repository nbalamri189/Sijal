{"poems":[[93,"وسائلة أي المذاهب مذهبي","https://www.aldiwan.net/poem62662.html","عموديه"],[285,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[409,"حمام بأغصان الرياض ترنما","https://www.aldiwan.net/poem33421.html","الطويل"],[445,"تسليت حتى أنسي الهائم الهما","https://www.aldiwan.net/poem34792.html","الطويل"],[556,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105212","البسيط"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113030","السريع"],[4755,"مأساة سُهَيل اليَمَاني ( 2 )","https://www.poetsgate.com/ViewPoem.aspx?id=210755",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""]],"verses":[["وَكَيفدَ يُزينُ الطَلُّ وَرداً وَعَوسَجاً","وَكَيفَ يُرَوِّ العارِضُ الوَعرَ وَالسَهلا",0,"ل",2,0],["وَكَيْفَ دُنُوُّ مَنْ طَوَتِ اللَّيالِي","كَما تَطْوِي عَلَى الظَّنِّ الضَّمِيرا",1,"ر",2,0],["وكيف درى أن المدامع عن دم","وظن سواه أن دمعي عندما",2,"م",2,0],["وكيفَ دَنَتْ منكَ الخطوبُ وَمَا رَجَتْ","بساحَةِ من والاكَ ظُلْماً ولا هَضْما",3,"م",2,0],["وَكَيف دُلّيتَ إِلى حُفرةٍ","يَمحوكَ مَحو الطِّرسِ فيها الثَّرى",4,"ا",1,0],["وكيف دّك جبال العز شامخة","وكيف غيّض بحراً منك قد زخرا",5,"ر",2,0],["وكيف دعدٌ بعد أيَّامنا","تبقى لنا دون النِّسا دعد",6,"د",1,0],["وكيف -دُونَ جَميعِ النَّاسِ- بِتُّ على","مَصَارِعِ الخَلقِ والأَفلاكِ نَدمانا!",7,"ن",2,0],["وكيف دجلة يجري في رصافته","وكيف بالكرخ قلبي كان منتقلا",8,"ل",2,0],["وكيف درست بفصلٍ قديمٍ","هزيل الكراسي ، كسير الرخامْ",9,"م",1,0]]}