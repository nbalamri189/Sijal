{"poems":[[65,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[24,"أتعرف رسما بين رهمان فالرقم","https://www.aldiwan.net/poem21880.html","الطويل"],[88,"أساحة للحرب أم محشر","https://www.aldiwan.net/poem10697.html","السريع"],[87,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[50,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"تريب وسوف يفترق التريب","https://www.aldiwan.net/poem22096.html","الوافر"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16624","الوافر"],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[92,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[164,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[190,"الحمد لله وشكرا له","https://www.aldiwan.net/poem43783.html","السريع"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[211,"إنك لم تك كابن الشريد","https://www.aldiwan.net/poem27897.html","المتقارب"],[234,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[242,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[275,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[276,"دمى طلل بين الطلول بحا جر","https://www.aldiwan.net/poem52110.html","الطويل"],[285,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[303,"أَسيغوا البث واحتبسوا الزفيرا","https://www.aldiwan.net/poem36267.html","عموديه"],[369,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[412,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[438,"فلما استنار سراج السما","https://www.aldiwan.net/poem12573.html","المتقارب"],[438,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[438,"ألا رب يوم لنا صالح","https://www.aldiwan.net/poem12589.html","المتقارب"],[438,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[466,"تعلمت البيداء فسحة صدره","https://www.aldiwan.net/poem15445.html","الطويل"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[556,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[563,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[580,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126897","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126753","المتقارب"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105448","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64979","الطويل"],[1282,"","https://poetry.dctabudhabi.ae/diwan/poem/105279","الرجز"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198167","المتقارب"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64467","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122108","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122105","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35798","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128720","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108832","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49600","المتقارب"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123157","البسيط"],[333,"","https://poetry.dctabudhabi.ae/diwan/poem/110986","المجتث"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124174","الوافر"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95238","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67876","المتقارب"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124774","الطويل"],[2579,"","https://poetry.dctabudhabi.ae/diwan/poem/206004","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130800",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130748","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/204159","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145039","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53026","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123927","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108391",""],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124643","الطويل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124644","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128937","الوافر"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34644","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133267","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58083","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4791,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=28422",""],[5121,"دوحة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=36288",""],[5121,"أَهَازِيج","https://www.poetsgate.com/ViewPoem.aspx?id=215876",""],[5194,"بحر الأسرار","https://www.poetsgate.com/ViewPoem.aspx?id=30631",""],[2365,"هل حكيم يردّ داء المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=96142",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5431,"إنَّ الحب فردوسٌ وروحي بابها التاسع","https://www.poetsgate.com/ViewPoem.aspx?id=185122",""],[5436,"قصيدة أسدلوا الستار","https://www.poetsgate.com/ViewPoem.aspx?id=36243",""],[5442,"لا تسأمي يا ناق طول السري","https://www.poetsgate.com/ViewPoem.aspx?id=114730",""],[5442,"دع الصب يدمع منه المآقيا","https://www.poetsgate.com/ViewPoem.aspx?id=114761",""],[5525,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=7196",""],[5550,"كفِّي الصُدود","https://www.poetsgate.com/ViewPoem.aspx?id=213892",""],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""],[243,"في يوم عابس","https://www.poetsgate.com/ViewPoem.aspx?id=8019",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5956,"على قدْر ما هو أسعدَ ناساً","https://www.poetsgate.com/ViewPoem.aspx?id=192977",""]],"verses":[["وأُشِبَّ لي طَمَعٌ فلَيتَ ركائِبي","عَلِمَتْ غَداةَ الجِزْعِ أينَ أَسوقُ",0,"ق",1,0],["وَأَشبَهتُهُ مِن بَينِ مَن وَطِئَ الحَصى","وَلَم يَنتَزِعني شِبهُ خالٍ وَلا اِبنِ عَمّ",1,"م",1,0],["وَأَشبَهَت يَومَ الوَغى أُختَها","إِذ لاحَ فيها الشَفَقُ الأَحمَرُ",2,"ر",1,0],["وَأَشبَهُ طُهرٍ في النِساءِ بِمَريَمٍ","فَتاةٌ عَلى نَهجِ المَسيحِ تَسيرُ",3,"ر",1,0],["وَأَشباهُ بَكرِ المَجدِ بَكرُ بنُ وائِلٍ","وَقاسِطُ عَدنانٍ وَأَنجَبَهُ هِنبُ",4,"ب",1,0],["وَأَشبَهَ السَفى الإِبَر","وَنَشَّ إِذخارُ النُقَر",5,"ر",1,0],["وَأَشباحٌ يُخالِطُهُنَّ غَدرٌ","فَما يَرعى الأَكيلُ وَلا الشَريبُ",6,"ب",1,0],["وَأَشبَرَنيهِ الهالِكِيُّ كَأَنَّهُ","غَديرٌ جَرَت في مَتنِهِ الريحُ سَلسَلُ",7,"ل",1,0],["وأشْبَعَت الوُحُوشَ فصاحَبَتْها","كأنّ الخامِعاتِ لها مِهارُ",8,"ر",1,0],["واشباحٌ تُراوحكم قِباحٌ","تَروعُ حَصاتَكم ساعاً فساعا",9,"ع",2,0],["وأشباحُ الضحايا في طواهُ","على السارينَ تحتشِد احتشادا!",10,"د",2,0],["وأشباحُ ناسٍ ، وإنْ أُوهِمُوا","بأنّهمُ \" قادةٌ \" في الورى",11,"ا",1,0],["واشبتُ ناصيةَ الزمانِ ورعته","بغرائبِ العزماتِ والآراءِ",12,"ا",2,0],["وأشبه الوصل بوقت الضحى","من صبحة الأضحى أو الفطر",13,"ر",1,0],["وَأَشبهَ منهُ الشهرُ عاماً لغيرهِ","نُموّاً ومنه اليوم قد أشبهَ الشهرا",14,"ر",2,0],["وَأَشبَهتَ جَدَّكَ شَرَّ الجُدو","دِ وَالعِرقُ يَسري إِلى النائِمِ",15,"م",1,0],["وأَشْبَهَهم في المجد فَرعا وعُنصراً","إذا ركبوا مِنه على كل مُخْلَق",16,"ق",1,0],["وَإِشْبَاعِ الْمَلاَ مِنْ مِلْءِ كَفٍّ","وَمَا قَدْ قَلَّ مِنْ شِبْعِ الْبَطِينِ",17,"ن",1,0],["وأشبَه ما ألقاهُ قلبي وخَصرُها","على رقَّةٍ مَقرونةٍ بثبات",18,"ت",1,0],["وأشبع يوم الخندق الجيش كله","بصاع شعير كان في بيت جابر",19,"ر",1,0],["وَأَشْبَعَ جُودُهُ غَرْثى الأَمَانِي","وَرَوَّى بَأُسُهُ الأَسَلَ الْحِرارا",20,"ر",2,0],["وَأشبهتَ (الوصيَّ) أَباك بأْساً","وَجدَّك (أحمداً) كرماً وَخيرا",21,"ر",2,0],["وأشْبهَ حَرْفَ الرّاءِ مأْمَنُ مُلْحدٍ","وأشبهَ وجهُ الأرضِ خُطْبةَ واصل",22,"ل",1,0],["وَأَشبَع ذِئباً جائِعاً مِن جُسومِهِم","وَضَبعاً وَنِسراً قَشعَمياً وَزَمَّجا",23,"ج",2,0],["وأشبهَ بدرُ الدُجى مَنْهلاً","تكشّفَ عن مائه الطُحْلُبُ",24,"ب",1,0],["وأشبه الحالُ به","إنسانَ عينِ الأرْمَدِ",25,"د",1,0],["وأشبهَ إن درجتْهُ الصَبا","بُرادةَ تبرٍ على مِبرَدِ",26,"د",1,0],["وأشبهَ النورانِ في نَضْرِه","الى حياءٍ وحَيفا ينتَمي",27,"م",2,0],["وأشبَعها ألاّ تكون طرائداً","إذا شُلَّ من سَرح المسيمِ عزيبُهُ",28,"ب",2,0],["وأشبِههُ الطَّوْدُ المُنيفُ رزانةً","فلم يخش من مَرِّ الصَّبا والجنائب",29,"ب",1,0],["وأشبال خيس كل يوم وليلة","يرشحها للفرس ليث غضنفر",30,"ر",1,0],["وأشبعتَ منهمْ سِغابَ السُّيوف","وروّيتَ منهمْ صَدَى الذّابلِ",31,"ل",1,0],["وأشبهتني في نفخ روحي وقد بدت","لقلبي هنا من سر قلبي ذخائر",32,"ر",1,0],["وأَشبَه حالي حالَها فَتَرى الرَّدَى","قَضَى نَحْبَها فيمَا أَرَى أَو قَضَى نحْبي",33,"ب",2,0],["وأشباله الأمجاد خير أكارمٍ","بمجدهم فاقوا على كلّ إنسانِ",34,"ن",1,0],["وأشبالهُ الأنجبون الكرام","لَهُم في الورى شرفٌ مُعتبَر",35,"ر",1,0],["وَأَشبَهَ عيسى في نَداهُ وَبَأسِه","وَفي حُبِّهِ الأَفضالَ وَالصَدَقاتِ",36,"ت",1,0],["وَأشبَهَ إِدريس الَّذي حَدُّ سَيفِهِ","تشبُّ بِهِ النيران في الفَلَواتِ",36,"ت",1,0],["وأشباله عترة المصطفى","فأكرم بأشرف جد ووالد",37,"د",1,0],["وأشبه غصن البان في الدوح منبرا","فقام عليه للحمام وخطيب",38,"ب",1,0],["وأشبع الجيش بالزاد القليل كما","روى بنزر حليب صحبه الخلفا",39,"ف",2,0],["وأشبع جيشه بصواع تمر","وكانوا كالجواد لدى انتشار",40,"ر",1,0],["وأشبع الجيش بالزاد القليل فلم","يخشوا لكثرتهم ضر المجاعات",41,"ت",1,0],["وأشبع الألف بالصاع الفريد فلم","يشكون جوعا ولا ذاقوا له اللمما",42,"م",2,0],["وأَشْبَهها غِيلُ القَنا فتضايقتْ","على كلِّ ذِمْرٍ يُوسِعُ الضَّربَ والطَّعْنا",43,"ن",2,0],["واشبب لظاها فهي مهما استعرت","لو رسبت في البحر ما أن تنطفي",44,"ف",2,0],["وأشبعَ منهم ضِباعَ الفلاة","فظلُّوا لأَنعُمِه شاكرينا",45,"ن",2,0],["وأشبه شيء يا مجيد بمجدك ال","جلي على الايقان تحقيق منيتي",46,"ي",1,0],["وَأَشْبَهَ مِهْيَاراً فَهَا تِلْكَ عَيْنُهُ","تَفِيضُ إِذَا شَامَ البُرُوقَ عَلَى ظَمْيَا",47,"ي",2,0],["وَأَشْبَهَ بِشْراً فِي اسْتِوَاءٍ فَلَيْتَهُ","بِحَرْبٍ عَلَى أَرْضِ العِرَاقِ قَدِ اسْتَوَى",48,"و",2,0],["وَأُشَبِّههُ وَأَظلمهُ","إِذا شَبَّهتُهُ الصَنَما",49,"م",2,0],["وأشبع الألف من صاع الشعير ومن","شاة دعاه إليها جابر فوفى",50,"ف",2,0],["وأشبعوا الوحش من أنصاره وأبوا","أن يدفنوا بسوى أرواثها الرمما",51,"م",2,0],["وأشْبَهْتَ آباءك الأكْرَمينَ","عِرْضاً عزيزاً ومالاً مُهانا",52,"ن",2,0],["وأشبالُ الغضنفر ليس تحذُو","سوى أخلاقِه لا الثّعلَبَان",53,"ن",1,0],["وأشبهت زهرة الكركيش نرجسة","أو ما تقرطم من زهرات نسرين",54,"ن",1,0],["وأشبعوني وداعا","وحطّموا الأقلاما",55,"م",2,0],["وأشبهتَ الظباءَ فصارَ قلبي","يميلُ إلى الغزالِ الحاجريِّ",56,"ي",1,0],["وأشبهَ البدرَ حُسناً رحتُ أنشدُهُ","أشرقتَ إِشراقَ بدرٍ حفَّهُ الشَّرفُ",57,"ف",1,0],["وأشبَهكَ البدرُ حُسناً فما","تَناقَصَ حسنُكَ حتَّى يزيدا",58,"د",2,0],["وأشباهها من ظاهر الحكم مجمع","عليه لجهل عرّفنه وأرشد",59,"د",1,0],["وأشبهُ شيءٍ إذا قِسْتَه",