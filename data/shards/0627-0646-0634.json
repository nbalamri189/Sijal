ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[106,"طلعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179627",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[77,"إن شَهَرتْ نصلي يدا يوسُفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=33565",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[58,"إِنَّ القَليلَ مِنَ الكلامِ بأَهْلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=10100",""],[45,"ما جَوُّ خَبْتٍ، وَإنْ نأتْ ظُعُنُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31881",""],[91,"يا أنشودتي انطلقي","https://www.poetsgate.com/ViewPoem.aspx?id=53391",""],[91,"الحسن لا يشترى ولا يستجلب","https://www.poetsgate.com/ViewPoem.aspx?id=14220",""],[46,"إن شئتَ أن تُرزَقَ الدنيا ونِعمتَها،","https://www.poetsgate.com/ViewPoem.aspx?id=18096",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[88,"الدهرُ بيَّن في كتابِ شهادة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19562&r=&rc=65",""]],"verses":[["إِنَّ شَرّاً عَلَيَّ إِسراعُ عَزمي","في طِلابِ العُلى وَحَظّي بَطِيُّ",0,"ي",1,0],["أَنشَدتُها فَحَدا سَمعي غَرائِبُها","إِلى الضَميرِ حَداءَ الرَكبِ لِلبُدُنِ",1,"ن",1,0],["إِنَّ شَكواكَ لِلزَمانِ مُبينٌ","لي عَلى قَدرِ عَقلِهِ المَضعوفِ",2,"ف",1,0],["إِن شَمَخَ اليَومَ بِعِرنينِهِ","فَهوَ غَداً يَعطُسُ عَن أَجدَعِ",3,"ع",1,0],["إِن شاعَ عَن أُزرِها مِن عِفَّتي خَبَرٌ","فَإِنَّ شاهِدَها فيما حَكَت كَرَمي",4,"ي",1,0],["إنْ شارَفَتْ أرْضاً تطلَّعَ نَحْوَها","أخْرى كأنّ مُقامَها تَحْليلُ",5,"ل",1,0],["إِنَّ شَمساً أَبصَرتُها فَوقَ سَطحٍ","غادَرَتني بِسَهمِ طَرفٍ قَتيلا",6,"ل",2,1],["إِنَّ شَوقي إِلَيكِ لَو شِئتُ أَن يَز","دادَ شَيئاً لَما وَجَدتُ مَزِيدا",7,"د",2,1],["أَنشَأَ الشَوقُ إِلى وَج","هِكَ في القَلبِ قُروحا",8,"ح",2,0],["إِنَّ شَوقي وَما أَطَلتُ المَغيبا","تَرَكَ الصَبرَ خاشِعاً مَغلوبا",9,"ب",2,0],["إِنَّ شَمْسَ الدِّينِ فّخْرَ الْمُلُوكْ","دُرَّةَ الْعِقْدِ وَوُسْطَى السُّلُوكْ",10,"ك",1,1],["إن شَهَرَتْ نَصْلي بَدا يوسُفٍ","رِيعَتْ لفَتْكي مُهْجَةُ اللّيْثِ",11,"ث",1,1],["أَنشى لَها الخُفَّ وَالبَراثِنَ وَال","حافِرَ شَتّى وَالأَعصَمَ الوَعِلا",12,"ل",2,0],["إِنَّ شَرَّ المُصابِ ما أَطلَقَ الدَم","عَ وَراعَ المُفَوَّهينَ بِعِيِّ",13,"ي",1,0],["إِن شاءَ حَدَّثَهُ أَو شاءَ أَطرَبَهُ","بِكُلِّ نادِرَةٍ تُجلى بِها الفِكَرُ",14,"ر",1,0],["أَنْشِدُوا وَأَعْيُنُ تُحَيِّي","رُتْبَةَ المَجْدِ وَيَحْيَى",15,"ي",2,0],["إِنَّ شَعْباً هَذِي حَمِيَّتُهُ","لَمْ يَضِعْ حَقُّهُ وَلا هَانَا",16,"ن",2,0],["إِنْ شَرَّفُوا قَدْرَ الوِدَادِ فَإِنَّهُمْ","لَمُشَرِّفُونَ الصحْفَ وَالأَقْلامَا",17,"م",2,0],["إِنْ شَامَ مِنْ جَانِبٍ فِينَا سَنَى أَمَلٍ","حَيَّى الرَّجَاءِ بِدَمْعٍ غَيْرَ مُكْتَتَمِ",18,"م",1,0],["أَنشَأتَ تَحلِفُ أَنَّ وُدَّكَ لي","صافٍ وَحَبلَكَ غَيرُ مُنحَذِقِ",19,"ق",1,0],["أَنشَأتَ تَطلُبُ وَصلَنا","في الصَّيفِ ضَيَّعتِ اللَبَن",20,"ن",1,0],["إن شمَّروا يوم الحروب ذيولهم","سحبوا من الزرد المُفاض ذيولا",21,"ل",2,0],["إن شجها بالماء كفُّ مديرها","ترمي من شُهب الحباب بها شَرَرْ",22,"ر",1,0],["أنشأت فيها من نداك غمائماً","بالفضل تنشأ والسماحة تهمِلُ",23,"ل",1,0],["أن شكوت الهوى تلعثمت حتى","خلتني في تكلّمي تمتاما",24,"م",2,0],["إن شهماً تقلّد العقل سيفاً","لحَرِيٌ بأن يكون رئيسا",25,"س",2,0],["أنَشقى بأمر الدين وهو سعادة","إذاً فإتباع الدين يا قوم خُسران",26,"ن",1,0],["إن شدا بالقريض لم تبصر السا","مع إلا مستحسناً مستعيدا",27,"د",2,0],["أنشأت تنطق في الأمو","ر كوافد الرخم المداور",28,"ر",1,0],["أَنشَدتَني فَكَأَنَّما","شَقَقتَ عَن دُرٍّ صَدَف",29,"ف",1,0],["إِنَّ شَرخَ الشَبابِ وَالشَعَرَ الأَس","وَدَ ما لَم يُعاصَ كانَ جُنونا",30,"ن",2,1],["أُنشُزوا عَنّا فَأَنتُم مَعشَرٌ","آلُ رِجسٍ وَفُجورٍ وَأَشَر",31,"ر",1,1],["أنشأتَ للشعرِ أسباباً يقالُ بها","وهل تنظمُ أشعارٌ بلا سببِ",32,"ب",1,0],["إن شئتُ من كاساتها أو ثغرِها","أرشفتُ خمرا أو لثمت حبابا",33,"ب",2,0],["أنْشأتها يدُ ابن خضرٍ ففاحتْ","وسرى عرفها بكلِّ الفجاج",34,"ج",1,0],["إن شئت تنظرُ في زهر الربى مطراً","فانظرْ نوالَ يديهِ في أناشيدي",35,"د",2,0],["إن شئت كالغصن ذات منعطف","أو شئت كالطير ذات تغريد",36,"د",1,0],["أنشأ المؤيد ألفاظي وأنشرها","فحبذا منشأ منها ومنشور",37,"ر",1,0],["إنَّ شيخ الشيوخ أيَّده الل","ه رأى أنَّني أعيشُ فقيرا",38,"ر",2,0],["إن شئت يا بدر الدجى إن بدا","فاطْلع وإن شئت فلا تطلع",39,"ع",1,0],["إن شق إيوان كسرى رهبة فلقد","جاء الدليل بأن الكفر مخذول",40,"ل",1,0],["أنشي مدائح سلطان العباد بلا","لغوٍ وأتلو معانيها بلا خلل",41,"ل",1,0],["أنشى بها العيش ينمو من محاسنه","ما ليس يحصره الناشي ولا النامي",42,"م",2,0],["إِنَّ شَمسَ النَهارِ تَغرُبُ بِاللَي","لِ وَشَمسُ القُلوبِ لَيسَ تَغيبُ",43,"ب",1,0],["أنشأتَ تهجوهُ فأكْ","ثرتَ الكلام بلا إطابهْ",44,"ب",2,0],["أنْشَرَ اللهُ دولةَ ابن سليما","ن فأيْقِن بأنها لا تموتُ",45,"ت",1,0],["أنشَرَ من شكري مَواتاً مُدْرَجا","حتى غدا عبداً له مستعْلَجا",46,"ج",2,0],["أنشأت تنطق بالصواب ولم تزل","قِدْماً وسهمُك في الصواب الأفلجُ",47,"ج",1,0],["أنشدْته مدحي فأنشد طَوْلَهُ","تَئِقُ السَّمَاح بمالِه نَفَّاحُه",48,"ح",2,0],["أنشدته منطقي ليشهده","فغاب عنه عَمىً وما شهدَهْ",49,"د",2,0],["أنشب فيه الدهرُ أظفاره","وعضَّه بالناب والناجذِ",50,"ذ",1,0],["أنشأ الدار التي أن","شا لإفراط اغترار",51,"ر",1,0],["إن شئت قلت مليحةٌ ما ضرها","أن لم يقلها المكتني بنُواس",52,"س",1,0],["إن شرخَ الشبابِ قرضُ الليالي","فتصرّف فيه قُبيل التقاضِي",53,"ي",1,0],["أنشأتَ تكحلُ بالهجوع معاشراً","بعد السهاد وما اكتحلت هجوعا",54,"ع",2,0],["إن شؤماً حُلَّتْ به عقدةُ العَه","دِ لشؤمٌ تزول منه الجبالُ",55,"ل",1,0],["أنشأتَ تَخدَعُنا وأمْ","رُكَ بيّنٌ بادي الشَّواكلْ",56,"ل",1,0],["أنشأْتُ أسألُهم بمثلكِ بعدما","أرجَت بريّاك الرُّبى والأهْجُلُ",57,"ل",1,0],["إنَّ شتْماً ألمته يا ابنَ بورا","نَ لأدهى من العذاب الأليم",58,"م",1,0],["أنشرْتَ آراءً وكنّ هوامداً","وأثرتَ أموالاً وكنَّ دفائنا",59,"ن",2,0],["أَنشَبتُ أَلحاظي بِوَردِ خُدودِها","لَمّا رَأَيتُ لِحاظَها بي تَنشُبُ",60,"ب",1,0],["إِن شَكَتِ الأَرضُ حَرَّ الصَدى","سَقاها النَجيعَ الوَرى صَيِّبا",61,"ب",2,0],["إِن شابَ مِنكَ المَفرِقانِ","فَما أَظُنُّ القَلبَ شاب",62,"ب",1,0],["إِن شِئتَ فَهوَ المَلِكُ في عَرشِهِ","أَو شِئتَ فَهوَ الطِفلُ في مَهدِهِ",63,"د",2,0],["إِن شِئتَ طالَ هُتافُه وَنَشيدُهُ","أَو شِئتَ دامَ نُواحُه وَزَفيرُهُ",64,"ر",2,0],["إِن شِئتَ تَعرى مِن قُيودِكَ كُلَّها","فَاِنظُر إِلى صَدرِ السَماءِ العاري",65,"ر",2,0],["إِنَّ شَرَّ الجُناةِ في الأَرضِ نَفسٌ","تَتَوَقّى قَبلَ الرَحيلِ الرَحيلا",66,"ل",2,0],["إِن شَكَت قالَت عَلى الدُنيا العَفاء","أَو شَكَوا قالوا عَلى الناسِ السَلام",67,"م",1,0],["أُنشودَةٌ في ضَميري كَم أُواريها","وَما شِفائِيَ إِلّا أَن أُغَنّيها",68,"ي",3,1],["إِن شَكا القَلبُ هَجرَكُم","مَهَّدَ الحُبُّ عُذرَكُم",69,"م",1,1],["أَنشُدُ الرَّاحَةَ البعيدَةَ لكنْ","خابَ ظنِّي وأَخطأَتْ أَحلامي",70,"ي",1,0],["أُنشودَةَ الماضي البعيدِ","وسُورَةَ الأَزَلِ القديمْ",71,"م",1,0],["إن شر السلاح في عصرنا النا","ر فما إن تقيك منها الدروع",72,"ع",1,0],["ان شر الحروب في كل عصر","هو مالا يثور فيه العجاج",73,"ج",1,0],["إن شا الله تفرح يا عريسنا","وان شا الله دايما نفرح بك",74,"ك",1,0],["أُنشر العرفان واجمع أمة","مثلت في العالمين العربا",75,"ب",2,0],["إن شرفوها رأوا في ظلها شرفا","واستقبلوا الخير نياتٍ بنيات",76,"ت",1,0],["إن شيدوا لسواه ما يمثله","فمجده فيه تمثيل بمرآة",76,"ه",1,0],["إن شئت تعرف حالتي فانظر إلى","داري فإن السر عند الدار",77,"ر",1,1],["إِن شِئتِ كانَ العَيرَ أَو","إِن شِئتِ كانَ الأَسَدا",78,"د",2,0],["إِن شِئتَ يَوماً أَو أَرَدتَ فَحُقبَةً","كُلٌّ يَمُرُّ كَلَيلَةٍ وَنَهارِ",79,"ر",1,0],["إِن شِئتَ أَهرِقهُ وَإِن شِئتَ اِحمِهِ","هُوَ لَم يَكُن لِسِواكَ بِالمَملوكِ",80,"ك",1,0],["أَنَشرُ الكِباءِ وَوَجهُ الأَميرِ","وَصَوتُ الغِناءِ وَصافي الخُمورِ",81,"ر",1,1],["إن شئتَ مُت أسفاً أو فابقَ مضطرباً","قد حلّ ما كنتَ تخشاه وقد وقعا",82,"ع",2,0],["أنشوةُ الخمرِ أم ذِكرى تُهَيِّجني","من أهل ودِّي وإخواني وأوطاني",83,"ي",1,0],["إِن شِئتَ أَن تَدَعَ الفَعالَ لِأَهلِهِ","فَاَعرِض لِمَجدِ سَعيدِهِ أَو وَهبِهِ",84,"ب",2,0],["إِنَّ شِعري سارَ في كُلِّ بَلَد","وَاِشتَهى رِقَّتَهُ كُلُّ أَحَد",85,"د",1,1],["إِن شِئتَ جاءَت نِعمَةٌ فَتُلُقِّيَت","مِنهُ وَسُهِّلَ مَطلَبٌ فَتَسَهَّلا",86,"ل",2,0],["أَنشَبتَ نَفسَكَ في خَضراءَ مُغدِقَةٍ","وَأَفسَدَتكَ عَلى إِخوانِكَ النِعَمُ",87,"م",1,0],["إِن شَذَّ عَن عَينَيهِ مُغَيَّبُها","كانَت وَفاءً مِن عَينِهِ أُذُنُه",88,"ن",2,0],["إِن شانَ قَوماً ضَربُ أَقفائِهِم","شَرَّفَهُ الضَربُ بِتَزيِينِهِ",89,"ن",2,0],["إِنَّ شَفيعي إِلَيكَ مِنّي","دُموعُ عَيني وَحُسنُ ظَنّي",90,"ن",2,0],["إن شيطانك في الظر","ف لشيطان مريد",91,"د",1,1],["إن شمت منه شيمة يمنيّة","جاءتك واهبة النطاق سكوبا",92,"ب",2,0],["إن شِينَ ذُو رَوْقَيْنِ نَاجِمَيْنِ","فإنَّه زَيْنٌ بِغَيْرْ شَيْنِ",93,"ن",1,0],["إن شاءَ عُدَّ من الشُّعوبِ أجلَّها","أو شاءَ عَدَّ من القبائلِ تَغلِبا",94,"ب",2,0],["أنشأْتَه منزلاً في قلبِ دجلةَ لا","تمتاحُ جَنَّتُه الغُدرانَ والقُلُبا",95,"ب",2,0],["إِن شِئتِ موتاً فَأَنتِ الدَهرَ مالِكَةٌ","روحي وَإِن شِئتِ أَن أَحيا فَأَحيِيني",96,"ن",2,0],["إن شوقي إليك في حال قربي","ضعف شوقي إليك في حال بعدي",97,"ي",1,0],["إِنَّ شَرطَ الكِرامِ لا العَبدُ يَشقى","في حِماهُم وَلا النَزيلُ يُضامُ",98,"م",1,0],["إِن شِئتُ أَن أَشرَبَ الكَثيرَ مِنَ الرا","حِ نَهانِيَ الوَقارُ وَالأَدَبُ",99,"ب",1,1],["إِنَّ شُربَ النَضوحِ يَسلِبُني الرُش","دَ فَكَيفَ المُشَعشَعِ الخَرَكاني",100,"ي",1,0],["إِن شاءَ تَسويدَ مُبيَضِّ الطَروسِ فَمِن","إِنشائِهِ لِبَياضِ الناسِ تَسويدُ",101,"د",1,0],["إِن شَبَّهوني بِمَن دوني فَلا عَجَبٌ","فَالدُرُّ يُشبِهُهُ في المَنظَرِ البَرَدُ",102,"د",1,0],["إِن شاءَ يَلقاني بِخُلقٍ واسِعٍ","عِندَ السَلامِ نَهاهُ طَرفٌ ضَيِّقُ",103,"ق",1,0],["أنشد في رائع أنوارها","رشداً فما أغنم إلا الضلال",104,"ل",1,0],["أنشأتَ شوانيَ طائرةً","وبنيتَ على ماءٍ مُدُنا",105,"ن",2,0],["إِن شِئتَ أن تَطْوي على ظَمَأٍ فَرِدْ","ماءَ المَحاسِنِ فَوْقَ وَجْنَةِ رُودِ",106,"د",1,0],["إنْ شئتَ أنْ تَحيا فكنْ صادقاً","فإنّما الكذّابُ كالم