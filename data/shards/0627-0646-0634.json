َمِ",150,"م",1,0],["أنْشرُ خُزامى فاح أم عَرْفُ حاجرٍ","بأُمّ القُرَى أم عِطْرُ عَزَّةَ ضائع",151,"ع",1,0],["إن شمس الدستور للقوم لاحَت","فأَضاءَت بنورها الأبصارا",152,"ر",2,0],["أنشر الكباء ووجه الأمير","وحسن الغناء وصافي الخمور",153,"ر",1,1],["أنشدها فأبكي","بالمدمع الذريف",154,"ف",1,0],["أنشودةُ الوادي ولحنُ شبابه","ذابتْ على صدر الغديرِ الطامي",155,"ي",1,0],["أَنَشَرَت في مِصرَ شَعباً صالِحاً","كانَ قَبلَ اليَومِ مُنفَكَّ العُرا",156,"ر",2,0],["إن شيد القصر في سرور","فبعده يحفر الضريح",157,"ح",1,0],["أنشأ ملكا أمويا ضخما","كملك كسرى رقعة وتخما",158,"م",2,0],["إِن شاءَ صَرْفُ الرَّدَى تَقْدِيم أَطْوعِنا","فقد رَضِيتُ حَمَاكَ اللَّهُ تَقْدِيمِي",159,"ي",1,0],["أنشودةً تَهَبُ العَزاءَ","لِكلِّ مُبتئسٍ غَريبْ",160,"ب",1,0],["إِنَّ شَوْقِي إِلَيهِ أَسْرَعُ شَأْواً","مِنْ سُلَيكٍ وَالْوَصْلُ فِي بُطءِ فِنْدِ",161,"د",1,0],["أَنْشَأْتُمَاهَا لِلعُلُومِ مَجَلَّةً","كسِبَتْ طَرَائِفهَا فُنُونَ جَمَالِ",162,"ل",1,0],["أَنْشَرْتَهُمْ بَعْدَ الْبِلَى","وَنُشُورُ قَوْمكَ مُبْتَغَاكْ",163,"ك",1,0],["أَنشَأْتَ مِنْ مِصْرَ الشَّتاتِ بِفضْلِهِ","مِصْرَ الفَتاةَ حِمى يُعَزُّ وَمَأْلفا",164,"ف",2,0],["إِنْ شَقَّ تَرْحَالٌ فَهَذِي هِجْرَة","لا شُقَّةً فِي مِثْلِهَا فَبَدَارِ",165,"ر",1,0],["أَنْشِفْهُ رُوحَكَ وَاسْقِهِ","مَا قطَّرَتْهُ مُقْلَتَاكْ",166,"ك",1,0],["أَنْشِدْهُمُ مَا يَجْلِبُ","الصَّفاءَ أَوْ يَنْفِي الكَدَرْ",167,"ر",1,0],["إن شئت سق من الرياض صحائفا","وأصاب من أزهارهن محابرا",168,"ر",2,0],["انشروا الهولَ وصبّوا ناركم","كيفما شئتم فلن تلقوا جبانا",169,"ن",2,0],["أنشرِ الموت ما استطعتَ","فلا تبقى ولا يبقى بعدنا ذو ثراء",170,"ا",2,0],["أنشدت أحلامي على فارغ","من القلب الذي تحملين",171,"ن",1,0],["إِن شِئتَ أَن تَسرِقَ مِن حُسنِهِ","فَلذ بِهِ يا بَدرُ أَو صافهِ",172,"ه",1,0],["إِنَّ شَبابي خانَني شَرخُهُ","وَإِنّ رَحلي حانَ إِشظاظَه",173,"ه",1,0],["إن شعراً سمعته يوم ودّع","ت سيملي وداع حيّ فحيّ",174,"ي",1,0],["إن شعري أجرُ النبوغِ فما ب","ضَ لغير المُجيدِ في مَيْدانه",175,"ن",2,0],["أنشَأْتَها جَنةً غَنَّتْ بلاَبِلُها","وغَرّدَتْ بين أوراقٍ وأَغْصانِ",176,"ن",1,0],["إن شَكَّ في عَزمةِ المضرِيّ مُخْتَبَلٌ","فبيْن فِتْيانِنا يلْقى البَراهينَا",177,"ن",2,0],["أَنْشِدْه حَسّاناً إِذا لاقَيْتَهُ","في جَنةِ الفِرْدَوْسِ بين رُواتِه",178,"ت",2,0],["اُنشر الأمنَ -أيها العيدُ- في كلِّ","مكانٍ مُرَفْرفَ الأعلام",179,"م",1,0],["إن شقَّ جوفَ البحر، راعَ عُبابَهُ","أو طارَ، أرعد في السماء وأبرَقا",180,"ق",2,0],["إنَّ شعبًا مفرَّقَ الشَّمل لا يقْهَ","رُ خصمًا، ولا يكيدُ حسودا",181,"د",2,0],["إنْ شُوِّه استعمالُهُ","فالوِزرُ ليس بوِزره",182,"ر",2,0],["إنَّ شعبًا لا شأنَ للشعر فيه","ليس بين الأحياء بالمعدود",183,"د",1,0],["إن شَهَرتْ نصلي يدا يوسُفٍ","ريعتْ لِفَتْكي مُهجة ُ اللَّيثِ",184,"ث",1,1],["أنشأت تطلبُ ما تغيَّر","بعدما نشب الأظافر",185,"ر",1,0],["أنشد النيل ساحرات لياليه","وألقى النجوم فى أحضانه",186,"ن",2,0],["إنْ شُبِّة النُّطقُ المُبِينَ بفِضَّة","ٍ فالصمت درٌ زانه ياقوتُ",187,"ت",1,0],["إنْ شَذّ عَنْ عَيْنِهِ مُغَيَّبُها،","كانَتْ وَفَاءً مِنْ عَيْنِهِ أُذُنُهْ",188,"ن",2,0],["أنشودة في ضميري كم أواريها","وما شقائي إلاّ أن أغنّيها",189,"ي",3,1],["أنشبت ألحاظي بورد خدودها","لّما رأيت لحاظها بي ننشب",190,"ب",1,0],["إن شئتَ أن تُرزَقَ الدنيا ونِعمتَها،","فخلِّ دنياكَ تظفرْ بالذي شيتا",191,"ت",2,1],["إنَّ شتْما ألمته يابنَ بورا","ن لأدهى من العذاب الأليم",192,"م",1,0],["إن شنَّ فوق ظهورهن إغارة","ترك العدو بلوعة المَحروب",193,"ب",1,0]]}