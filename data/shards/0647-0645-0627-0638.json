{"poems":[[30,"لما رأيت الأرض قد سد ظهرها","https://www.aldiwan.net/poem4968.html","الطويل"],[82,"إلى متى منكم هجري وإقصائي","https://www.aldiwan.net/poem31577.html","البسيط"],[82,"إلى متى منكمُ هجري وإقصائي","https://www.poetsgate.com/ViewPoem.aspx?id=2931",""],[137,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[275,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[534,"هم أخذوا عني العلوم بذلة","https://www.aldiwan.net/poem37500.html","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50042","المتقارب"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17659","الطويل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216547",""]],"verses":[["هُما ظُلمَتا لَيلٍ وَأَرضٍ تَلاقَتا","عَلى جامِحٍ مِن أَمرِهِ ما تَعَرَّجا",0,"ج",2,0],["هُمْ أظمؤُوني إلى ماءِ اللّمى ظمأً","تَرَحّلَ الرِّيُّ بي منهُ عنِ الماءِ",1,"ا",2,0],["هُمْ أظمأُونِي إلى ماءِ اللّمى ظمأً","ترحلَ الريّ بي منهُ عنِ الماء",2,"ا",2,0],["هم أظهرهُ معَ النبيِّ وواجِبٌ","أن يُتبِعُوا الإظهارَ بالإظهارِ",3,"ر",1,0],["هما ظهرا مِنا وفينا وإنَّنا","خُلِقنا لنحيا بالعَواطفِ والدّم",4,"م",1,0],["هُمُ أَظْهَروا عِنْدَ اللّقاءِ لُيُونَةً","فَلَمّا تَوَلَّوْا أَظْهَرُوا كُلَّ شِدَّةِ",5,"ه",1,0],["هُم أظهروا الدّين شرقاً وغرباً","وهم نصروا بالسّيوف النبيّا",6,"ي",2,0],["هُما ظَبيَتانِ مِن ظِباءِ تَبالَةٍ","يُساقِطُ مَرداً يانِعاً مِدرَياهُما",7,"م",2,0],["همّ اظهِروا لِعْيال فِيْ الحال","وانته خفقت مْبين لثنين",8,"ن",1,0]]}