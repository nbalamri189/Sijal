{"poems":[[469,"سهر البرق من صفات المعنى","https://www.aldiwan.net/poem3428.html","عموديه"],[811,"","https://poetry.dctabudhabi.ae/diwan/poem/205168","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38591","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59279","الرجز"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101187","الخفيف"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216674",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56662","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100226","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204443","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79726","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71392","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71389","السريع"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75708","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72588","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120212","الخفيف"],[5121,"لاَ شَيْء","https://www.poetsgate.com/ViewPoem.aspx?id=213488",""],[5225,"الضحكه الكذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25598",""],[5277,"ترَفُ الخوالج","https://www.poetsgate.com/ViewPoem.aspx?id=191056",""],[5899,"تطرف","https://www.poetsgate.com/ViewPoem.aspx?id=31781",""]],"verses":[["بي شاكي الجفون يهوى وكم","أدمى وأجرى من المحبّين جفنا",0,"ن",2,0],["بي شغلٌ به عن الشغل عنه","بهواه وإن تشاغل عني",1,"ن",2,1],["بي شَفَتاها فَوقَ ثَغرٍ بَدا","صَغيرِ حَجمٍ فيهِ أَسنى الدُّرَرْ",2,"ر",1,1],["بِي شّادِنٌ تَمَّ سَنَاءً وَسَنًى","مِنْ أجْلِ ذَا قَالُوا هُوّ البَدْرُ التَّمَامْ",3,"م",1,1],["بي شموساً بدت بنعمان ليلا","فكست حلة الضحى نعمانا",4,"ن",2,0],["بيْشاهد اكْمامٍ ظلاله ضوافي","تنفح زهوره بالشذا من غواليه",5,"ي",2,0],["بي شوق نما فأضحى هياما","وهيام نما فأمسى غليلاً",6,"ل",2,0],["بي شادناً أصلى بجمرة خده","زنجي خال قد تضوع طيبه",7,"ب",2,0],["بي شوق الى الحروب فان يهدأ","حسامي اثرت حرب كلامي",8,"م",2,0],["بي شكوي اللبيب أخطأه الحظ","ظ وحاطت به سهام الخطوب",9,"ب",1,0],["بِي شَادِنٌ لِغَرَامِي شَائِداً أَبَداً","وَلِلتَّصَبُّرِ نَفَّاءٌ وَنَفَّادُ",10,"د",1,0],["بِي شَادِنٌ قَلْبي شَقِيٌّ بِهِ","وَجْداً وَطَرْفِي نَظَراً يَسْعَدُ",11,"د",1,0],["بي شادن ملك الفؤاد فضره","ما ضر بدري لَو روى عَن نافع",12,"ع",1,1],["بيش راي توهيج باحور شيد","كس نكويد كه روشنائي هست",13,"ت",1,0],["بي شكاء من الجوائب لكن","من شقاء الدنيا شكائي امض",14,"ض",1,1],["بِيَ شَيْءٌ مِنْ كُلِّ شَيْءٍ حَزِينٍ","فَاحْتَوَتْنِيِ فُقَاعَتِي سَوَّاحَا",15,"ح",2,0],["بي شي بالانفاس يحيا ويكبر","ويموت بالانفاس يا ذي عجوبه؟",16,"ب",2,0],["بي شَهْقَةٌ تَشتاقُ وَجْهَكِ كُلَّما","نَأَتِ المَسافَةُ واستشطَّ دِيارُ",17,"ر",1,0],["بي شهوة حمراء دامية","تحتلني تحتل أعماقي",18,"ق",2,0]]}