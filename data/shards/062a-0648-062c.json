tps://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[243,"تحية القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50485",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5848,"ظلم الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=53097",""],[5853,"عودي لأجلي","https://www.poetsgate.com/ViewPoem.aspx?id=175621",""],[5956,"رشادٌ مستديم","https://www.poetsgate.com/ViewPoem.aspx?id=192321",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6125,"لماذا الحبُّ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=210965",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6355,"سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66607&r=&rc=67",""]],"verses":[["تَوَجُّسَ اللَيثِ اِستَرابَ بِالأَجَم","أَهدُرُ عَن شِقشِقَةِ العَودِ القَطِم",0,"م",1,0],["تؤجِّجُ نارُ الخدِّ نارَ جَوانِحي","ويعْبَثُ وسْواسُ الحُليِّ بوَسْواسِ",1,"س",1,0],["تَوَجَّسنِ رِكزاً مِن خَفِيِّ مَكانِهِ","وَإِرنانَ إِحدى المُعطِياتِ المَوانِعِ",2,"ع",1,0],["توَّجْتَني بعِمامهْ","تُوِّجْتَ تاجَ الكرامَهْ",3,"ه",1,1],["تَوَجَّسُ النُبوحَ شُعثاً غُبرا","كَالناسِكاتِ يَنتَظِرنَ النَذرا",4,"ر",2,0],["تَوَّجَ الضادَ بِالمَلاحَةِ حَتّى","خالَها القَومُ بَعضَ مُختَرعاتِه",5,"ت",2,0],["توجت هامهم كما توّجوها","بكريم من الثناء وغال",6,"ل",1,0],["تَوَّجَت هامَهُم كَما تَوَّجوها","بِكَريمٍ مِنَ الثَناءِ وَغالي",7,"ل",2,0],["تَوَجَّهتَ مَصحوباً إِلَيها بِعَزمَةٍ","مَضى بِسَدادٍ بَدؤُها وَأَخيرُها",8,"ر",3,0],["توجِفُ الأَذواءُ مِن طاعتِهِ","مِن حِوالٍ أَو رُعَينٍ أَو يَزَن",9,"ن",1,0],["تَوِّجْ بكأسِك قبلَ النائباتِ يدي","فالكأسُ تاجُ يدِ المُثْري من الأدبِ",10,"ب",1,0],["تَوَّج بِكاساتِ الطَلى هامَ الرُبى","في رَوضَةِ مَطلولَةِ الزَهَراتِ",11,"ت",1,0],["تَوَجَّعُ أَن رَأَت جِسمي نَحيفاً","كَأَنَّ المَجدَ يُدرَكُ بِالصِراعِ",12,"ع",1,0],["توجعت تشكو منه شيمة ظالم","يزيدك هجرا كلما زدته ودا",13,"د",2,0],["توجَّعُ تَبغِي بَعدَ عامَينِ غَيره","حِفاظاً على العَوراتِ وَالمرءُ مُعدِمُ",14,"م",1,0],["توجَّعَ لمّا قِيلَ ذاقوا حِمامَهم","وقال أُريدُ الموتَ فالعيشُ أخوفُ",15,"ف",1,0],["توّجتَ منها القنا تيجان ملحمةٍ","من كل محْلولِ سِلكِ النظمِ معقود",16,"د",1,0],["توجّعت لعزله العقابُ","وحلّ بالمبرّأ العقابُ",17,"ب",1,0],["توّجتْ رأسَكِ الرمالُ بتبرٍ","وجرَى النيلُ تحت رِجْليْك شهدا",18,"د",2,0],["توَّجَنا أنا أمير الهوى وأنتِ أحلى الغيد في الخافقين","يرتحل الصيف فوالهفتا على زمان..كغبار اللجين",19,"ن",1,0],["توجهوا لجمال الله وانتدبوا","للغوث يا أولياء الله في عجل",20,"ل",1,0],["توّجت أسقطت على غيري هدّي","وأنتقت دون رؤية أو بصيره",21,"ر",2,0],["تَوَّجَهُ الوعيُ بألطافه","بِشراً كما تُوِّجَ زهرُ البِطاح",22,"ح",1,0],["توجهت مصحوباً إليها بعزمة","مضى بسداد بدءها وأخيرها",23,"ر",3,0],["توَّجَنا أنا أمير الهوى","وأنتِ أحلى الغيد في الخافقين",24,"ن",1,0],["تُؤَجَّج بل ذاك حُلمٌ تَوارى","يطير بحُبّي الى الخلوةِ",25,"ه",1,0],["تَوَجُّهَ صِدقٍ تكفَ كُلَّ مُهمَّةٍ","مِنَ الدينِ وَالدنيا وَلَو بَعدَ أُمَّةٍ",26,"ه",1,0],["تَوَجَّهَ لِلأُخرى بِأَكرَمِ وِجهَةٍ","وَقَد نَجَهَ الدُنيا بِأَزجَرِ نَجهَةٍ",27,"ه",1,0],["توجه نحو الطالبين وصالها","فأسلاهم عنها بضرب مهدم",28,"م",1,0],["تَوَّجتُها مَعشَراً لا أَبتَغي عِوَضاً","عَنها وَإِنّيَ في قَومي لَذُو قَنَعِ",29,"ع",1,0],["توّجهم بخيرهِ وعمّما","محمّدُ السخيُّ ذو العطايا",30,"ي",2,0],["توّجيني تاج عزٍّ ورضا","وامنحيني ثوب فخرٍ وغنى",31,"ن",2,0],["توَّجْتَ (مصر) وَشدتَ عرشَ فخارِها","وَعقدتَ في جيدِ (الشآم) قلائدا",32,"د",2,0],["تَوجه رَسول اللَهِ في كُلِ حاجة","لَنا وَمهم في المَعاش وَفي القَلب",33,"ب",1,0],["تَوجّس إذا أَعطته يوماً يمينهُ","لِموقفةِ الألبابِ في ساحة العجبِ",34,"ب",1,0],["تَوَجَّهَ لَوْ مي علَى لائِمي","وَقَدْ مِسْتُ كالغُصُنِ النَّاعِمِ",35,"م",1,1],["تَوَجُّعي مِن جوىً شَبَّت شَرارَتُهُ","مَعَ العَنا قَد رَثى لي فيهِ ذو الحَسَدِ",36,"د",1,0],["تَوَجَّعُ نَوحاً أَو تَصُكُّ مَحَاجِراً","فَأوجُهُهَا حُمرٌ وَأصوَاتُهَا بُحُّ",37,"ح",1,0],["تؤجِّج حبرَه آلامُ قلبي","فظاهره كباطنه يَفُوح",38,"ح",1,0],["توَّجَها الماءُ من فُواقِعِهِ","تَاجاً به تَرتَدِي وتَنْتَطِقُ",39,"ق",1,0],["تُؤَجِّجُها حَسَرَاتُ التَّناسي","وتَنْفُخُها زَفَرَاتُ النَّحِيبِ",40,"ب",1,0],["توجت آمال القلوب بوحدة","في ظلهاعلم الحضارة يخفق",41,"ق",1,0],["توجت حبك بالإحسان تكرمة","فضلاً وبذلاً ونبلا فوق ما يجب",42,"ب",1,0],["توجوا رأسه بإِكليل آسٍ","وأناطوا بجيده تِقْصاره",43,"ر",2,0],["تُوِّجوا مُضغةً وساد كهولَ ال","ناس أبناؤهم شباباً ومُردا",44,"د",2,0],["توّجَتْ هامةَ السُرورِ وحلّتْ","خَصْرَ ماضي زَمانِنا بالنِّطاقِ",45,"ق",1,0],["تَوَّجتَ رَأسَكَ مِنهُ حينَ لَقيتَهُ","تاجاً شَريفاً لَيسَ كالتّيجانِ",46,"ن",1,0],["تؤجّ كما أج شعلة نار","لتطفي من الرشد لامع نور",47,"ر",1,0],["تَوِّجْهُ إِلَهي بِهَيبَتكا","أَلبِسهُ حُلَّةَ سَطوَتكا",48,"ك",2,0],["تَوَجَّهْ إِلى مَولاكَ وَاِرضَ بِفَصلِهِ","تَوَكَّلْ عَلى الرَّحمَنِ في الأَمرِ كُلِّهِ",49,"ه",1,0],["تَوَجَّه إِلَيها وَاِجهَد النّفسَ ساعِياً","وَسِر سَيرَ مُشتاقٍ يَجدُّ عَلى وَجدِ",50,"د",1,0],["تُوِّجتَ بِالمجدِ المُؤثَّلِ في الوَرى","وَكُسيتَ بِالشَّرفِ العَزيزِ المفرَدِ",51,"د",1,0],["تَوجَّهوا نَحوَ مصرٍ حيثُ عزمُهمُ","بالرُّعب من خشية الجزّار مقطولُ",52,"ل",1,0],["توجه للفيحا سمائل فاغتدا","بهامتها قهراً وفاح شذاها",53,"ا",3,0],["تَوِّجْ بِدُرِّ الْمَاءِ هَامَ الرَّاحِ","وَصُنِ اسْتِمَاعَكَ عَنْ كَلاَمِ اللاَّحِي",54,"ح",2,1],["تَوَّجَه الحُسْن إذْ كَسَاه","حُلَّةَ نُورٍ طِرَازهَا النَّدْ",55,"د",1,0],["تَوَجَّهَ بِالعَبّاسِ في الجَدبِ راغِباً","فَما كَرَّ حَتّى جاءَ بِالديمَةِ المَطَر",56,"ر",1,0],["توجه حيث كنت فانت فيما","تحاول في ذرى الحصن الحصين",57,"ن",1,0],["توجه في التعلق مستقيما","من التقوى على اقوى طريقه",58,"ق",2,0],["توجهت في سبيل التحقق ذاكرا","حقيقة علمي فاستبانت فؤادي",59,"د",2,0],["توجه ينتهي من حيث شاهده","إلى التحقق بالاخلاق والشيم",60,"م",1,0],["توجه به للحي وابلغ تحيتي","إلى أهله من غير طول مماطله",61,"ل",2,0],["توجه وعين الله ترعاك حيثما","توجهت وابعث باعث الصدق في عجل",62,"ل",1,0],["توجهت ارجو من الهي قبول ما","دعوت به والفضل لا شك اجزل",63,"ل",1,0],["توجه وحيث استحكم الحكم فاستقم","وخذ قلما ينبي عن الصدق والحق",64,"ق",1,0],["توجهت القلوب إلى حبيب","له الإحسان والأفضال وصف",65,"ف",1,1],["توجه وأن لم تستطع فانتسب له","ووقره حباياتك الفوز لا جرم",66,"م",1,0],["توجه بعزم صادق وفق سادة","هواهم تعالى عن سليمى وعن ليلى",67,"ل",2,1],["توجع بأمراض وخوف مطالب","وإشفاق محزون وحزن كئيب",68,"ب",1,1],["توجيهها تحريك حرف يقتدى","قبل رويّ قد أتى مقيدا",69,"د",2,0],["توجيههم هو اختلاف حركه","قبل رويّ قيّدوه مدركه",69,"ه",1,0],["توجه إليه واجعل الفقر ديدنا","يعدك بالفقر الحقيقي محسنا",70,"ن",2,0],["توجهت باسم البر يا بر بائساً","وأيقنت من بر الكريم بغنيتي",71,"ي",1,0],["توجَّستُ منه كُنهَ سؤلي فللفتي","خصالٌ ترجيِّه وللشيخ تخذُلُ",72,"ل",1,0],["توجتموها بتاج المجد مؤتلقاً","فكبَّر الكون هذا بعض مايجب",73,"ب",1,0],["توّج الثلج الروابي فغدت","تتغشى من حياً في برقع",74,"ع",1,0],["تَوَجَّهَ لِلدّارِ التي عَمَرَت بِهِ","على الطائِرِ المَيمونِ سارَ وَخَيَّما",75,"م",2,0],["توجهت في إصلاح قوم فأنجحت","مساعيك بلْ عادَ الزمان فأفسدا",76,"د",2,0],["تُوِّجَ بدرُ التَّمِّ بالديجور","مطلعه في غُصُن نضير",77,"ر",1,1],["توجني مولاي من قوله","تاجاً علا التيجان من قبله",78,"ل",2,1],["تؤجَجُ ناراً في الكفاح أكفُّه","وفي السلم منه تستمدْ بحورها",79,"ر",3,0],["تؤجر بالآف عدادها مئه","من عتق مملوك وحط سيئه",80,"ه",1,0],["توجتك الايام تاج علاء","بسجاياك زين لا باللئال",81,"ل",1,0],["توجه بوجن القلب ان شئت قربه","ولا تلتفت يسرى ولا تلتفت يمنى",82,"ن",2,0],["توجهت من مِري ضحى فكأنما","توجهت من مِرّي إلى العلقم المرِّ",83,"ر",1,0],["توجه ومنه السير سر فيه تنتهي","اليه فلولاه البسيطة بلقع",84,"ع",1,0],["توَّجنَ مِنهُ وَأُرسِلَت","مِنهُ إِلى الكُثُبِ الذوائب",85,"ب",1,0],["توج الفخر هامهم تاج عز","وعلاهم من العلا جلباب",86,"ب",1,0],["توج العرب فوقهم ملك المو","ت فلا سيدا ترى أو مسودا",87,"د",2,0],["توجّهوا لك في الشّكوى بقلب سج","باكي الدّما ولسان بالدّعا لهج",88,"ج",1,0],["توجه اذا شئت نحوى فانني","أنا سرها المعنى والنحو والشطر",89,"ر",1,0],["توجيه علام ورأي مجرب","وخطاب مقتدر وحكم فقيه",90,"ي",2,0],["توَّجتها تاج عزٍّ منكَ مزدهياً","بِالفَضلِ كللهُ الإِجلالُ وَالمَجدُ",91,"د",1,0],["توجه إلى المعاني حيث توجهت","ودر معها سريعا في كل دورة",92,"ه",1,0],["تَوَجَت ملكاً جَليلاً مِنكَ شارفه","مَجد أَثيل وَتَبجيل وَتَمجيد