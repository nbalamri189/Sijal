em/42598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55085","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116994","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10223","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[77,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[100,"حيث التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=50147",""],[100,"الربيع والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50128",""],[96,"راقصة الحانة","https://www.poetsgate.com/ViewPoem.aspx?id=17511",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"تنويمة الجياع","https://www.poetsgate.com/ViewPoem.aspx?id=647",""],[80,"أيّ نَعِيمٍ في الصِّبَا والمُقْتَرَحْ","https://www.poetsgate.com/ViewPoem.aspx?id=3053",""],[91,"لو أستطيع","https://www.poetsgate.com/ViewPoem.aspx?id=53119",""],[46,"ما حُرّكَتْ قدمٌ ولا بُسِطَتْ يدٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=20284",""],[46,"سرَيْنا، وطالبنا هاجعٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=16598",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""],[39,"قفَا فاسألاَ الدِّمنَة َ المَاصحَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=4239",""],[75,"الحِبّ حيثُ المعشرُ الأعداءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10780&r=&rc=0",""],[100,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""]],"verses":[["وَتَجَنَّبَ البَتّيُّ جانِبَنا","وَنَبا فَلا وُدٌّ وَلا شَعَفُ",0,"ف",1,0],["وَتَجَنُّبي جَرَّ القَنا فَلَقَد مَضى","عَنهُنَّ كَبشُ الفَيلَقِ الجَرّارِ",1,"ر",1,0],["وَتَجهَرُ بِالمَوتِ أَرواحُهُم","وَسُمرُ القَنا مَعَها في سِرارِ",2,"ر",1,0],["وَتَجلو غَمايمُها عَنكُما","هُموماً تُظِلُّ القُلوبَ الحِرارا",3,"ر",2,0],["وَتُجِدُّ لي وَالفَجرُ يَنهَضُ بِالدُّجى","هَجراً وَإِن جَثَمَ الظَّلامُ وِصالا",4,"ل",2,0],["وتَجْري أحاديثٌ تَلينُ مُتونُها","ويَفْتَنُّ في أطرافِها الهَزْلُ والجِدُّ",5,"د",1,0],["وتَجْمَحُ بي عن مَوْطِنِ الذُّلِّ هِمّةٌ","تُجَمِّعُ أشْتاتَ المَعالي بأحْمَدِ",6,"د",1,0],["وتَجمَحُ فيهمْ هَيْبةٌ قُرَشيّةٌ","لأبيَضَ منْ آلِ النّبيِّ هجانِ",7,"ن",1,0],["وتَجُرُّ أثناءَ الزِّمامِ إِلى فتَىً","خَضِلِ الأنامِلِ كِسْرَويّ المَفْخَرِ",8,"ر",1,0],["وتجاذبتك هضابها وسهوله","شغفاً كما جذب الفقير الدرهما",9,"م",2,0],["وتجتدي كل لص مترف هبة","وأنت تعطيه شعراً فوق ما يهب",10,"ب",1,0],["وتجلى يوم ميلاد الهدى","يملأ التاريخ آيات عظاما",11,"م",2,0],["وَتَجمَعُنا أَرضُ الشَرَبَّةِ وَاللِوى","وَنَرتَعُ في أَكنافِ تِلكَ المَرابِعِ",12,"ع",1,0],["وَتَجمَعُنا الأَرضُ القَرارُ وَفَوقَنا","سَماءٌ نَرى فيها النُجومَ تَجولُ",13,"ل",1,0],["وَتُجْفلُ إِجْفَالَ النَّعَامِ بِبَرْقَةٍ","لُيُوثُ الشَّرَى مَا بَيْنَ تُرْكٍ وَعُرْبَانِ",14,"ن",1,0],["وَتُجِيلُ فِي يَوْمِ الْبَيَانِ جِيَادَهُ","فَيُقَالُ هَذَا فَارِسُ الْمِيدَانِ",15,"ن",1,0],["وَتَجْمَعُ بَيْنَ الْقَبْضِ وَالْبَسْطِ كَفُّهُ","بِحِكْمَةِ مَنْ فِي كَفِّه الْقَبْضُ وَالْبَسْطُ",16,"ط",1,0],["وَتَجَلّى ضِياؤُهُ بَعدَ لَأيٍ","وَهوَ رَمزٌ لِعَهدِيَ المُستَرَدِّ",17,"د",1,0],["وَتَجَلّى في مِهرَجانٍ تَجَلّى","سَيفُ عُثمانَ فيهِ بِالتَقليدِ",18,"د",1,0],["وَتَجاوَبَ الأَطيارِ فيهِ فَمُطرِبٌ","يُلهي الشَجِيَّ وَنائِحٌ يُشجي الخَلي",19,"ي",1,0],["وَتَجهَلَ مِن أَسماءَ عَهدَ صَبابَةٍ","وَتَحذوها مِن نَعلِها بِمِثالِها",20,"ل",3,0],["وتَجْتَلِي مِنْ بَعِيدٍ","لَهَا ضِيَاءً حيِيا",21,"ي",2,0],["وَتَجِدْ سَنَاماً مُسْتَطِيلاً قَاتِماً","يَهْتَزُّ فِي بَحْرٍ مِنَ اللَّمَعَانِ",22,"ن",1,0],["وَتَجَنَّى عَلَى الهُدَى بِالِغَي","نَصَرَ الْوِزْرَ وَاسْتَحَلَّ الْحَرَامَا",23,"م",2,0],["وَتَجِيءُ الألْفَاظُ وَفْقَ المَعَانِي","فِي نِظَامٍ يُزْرِي نِظَامَ اللآَّلِي",24,"ل",2,0],["وَتَجلو بِفَرعٍ مِن أَراكٍ كَأَنَّهُ","مِن العَنبَرِ الهِنديِّ وَالمسكِ يُصبَحُ",25,"ح",1,0],["وتجلّى خيالها في المرايا","حاكياً من جمالها أعيانه",26,"ن",2,0],["وتجمعنا جوامع كبريات","وأكبرهنّ سيّدة اللغات",27,"ت",1,0],["وتجلّت في مسرح الرقص حتى","أرقصت بالغرام منّا القلوبا",28,"ب",2,0],["وتَجيء من عِبَر الزمان بمَشْهَد","يُلقي خشوعاً في النفوس عميقا",29,"ق",2,0],["وتجمع المتفرقو","ن من الفراعِل والعَسابِرْ",30,"ر",1,1],["وتَجَمّع المتفرقاتِ","من العسابرِ والوعولِ",31,"ل",1,1],["وَتَجفَلُ الشَولُ بَعدَ الخَمسِ صادِيَةً","إِذا سَمِعنَ عَلى الأَمواهِ حادينا",32,"ن",2,0],["وَتَجيءَ مِن نَقبِ الحِجازِ كَتيبَةٌ","وَتَسيلَ بِالمُستَلئِمينَ صِرارُ",33,"ر",1,0],["وتجلّت الأحكام شمس ظهيرة","وأطاع عطف الدّهر بعد شماس",34,"س",1,0],["وتجانست في العلمِ دوحته التي","مُدَّت فيا لكَ مغرساً أو معرشا",35,"ش",2,0],["وتجاذبنا الأحاديث فما","انخفضت حِسًا ولا سَفَّتْ خيالا",36,"ل",2,0],["وتجلى لها الفراق فاغضت","في ذهول وأجهشت بالبكاء",37,"ا",2,0],["وتَجبي إلى السلطان أوفى خَراجِهِ","وتكسبُ حمدَ الناسِ من خيرِ مكسَبِ",38,"ب",1,0],["وتجافيكَ حين يعطفُ والوا","جبُ أن تستهلَّ مثل السحابِ",39,"ب",1,0],["وتِجارٍ مثل البهائمِ فازوا","بالمنى في النفوس والأحبابِ",39,"ب",1,0],["وتجلى عن كل ما نتمنى","موعدُ الكَذْخُذَاة والهِيلاجِ",40,"ج",1,0],["وتجليتَ ملءَ عينٍ وصدرٍ","وقديماً ملأت عيناً وصدرا",41,"ر",2,0],["وتجمعنا من بَعْدِ قُرْبَى كتابةٌ","وإنْ قلَّ عِلْمي بالجريب وبالأشلِ",42,"ل",1,0],["وتجلّى بعين صقرٍ أبو الصق","رِ على رأس مَرْقبٍ متعالي",43,"ل",2,0],["وتجافي مؤمَّل لي خليلٍ","لجَّ منه الجفاء والهجران",44,"ن",1,0],["وتجلَّى على السرير جبينٌ","ذو شعاع يجول دون العيان",45,"ن",1,0],["وتجلَّتْ عن وجههِ حُجُبُ النو","ر فسبحانَ وجهِه سبحانا",46,"ن",2,0],["وَتَجَلُّدي لِلشامِتينَ أُريهِمُ","أَنّي لَرَيبِ الدَهرِ لا أَتَضَعضَعُ",47,"ع",1,0],["وَتَجمَعُ نَوفَلاً وَبَني عَكَبٍّ","كِلا الحَيَّينِ أَفلَحَ مَن أَصابا",48,"ب",2,0],["وَتَجَرَّدَت بَعدَ الهَديرِ وَصَرَّحَت","صَهباءُ تَبدَأُ شَربَها بِفُتارِ",49,"ر",1,0],["وَتَجاوَزَت خُشبَ الأُرَيطِ وَدونَهُ","عَرَبٌ يَرُدُّ ذَوي الهُمومِ وَرومُ",50,"م",1,0],["وَتَجَنّى ما شاءَ أَن يَتَجَنّى","وَاِستَبَدَّت صُروفُهُ اِستِبدادا",51,"ا",1,0],["وَتَجعَلُ الشَوكَ ذا أَريجٍ","وَتَجعَلُ الصَخرَ ذا شُعورِ",52,"ر",1,0],["وَتَجاهَلَت أَو أَنكَرَت","أَمي لَدى جُلّاسِها",53,"س",3,0],["وَتَجهَلُ أَنَّ الحُسنَ لَيسَ بِدائِمٍ","وَإِن هُوَ إِلّا زَهرَةٌ سَوفَ تَذبُلُ",54,"ل",1,0],["وتَجَلْبَبَ الزَّهرُ الجميلُ","بظُلْمَةِ اللَّيلِ المُريعْ",55,"ع",1,0],["وتَجِفُّ الزُّهورُ في قلبيَ الدَّا","جي وتهوي إلى قرارٍ بعيدِ",56,"د",1,0],["وتجاذب الليل البهيم وصبحه","حتى بدا وقميصه مشقوق",57,"ق",1,0],["وتجاهرت بالحقيقة مثنى","وثلاثاً من بعده ورباعا",58,"ع",2,0],["وتجلت أوجه زيَّنَها","غُرر من لمحة الخير تسيل",59,"ل",1,0],["وَتَجَنَّب كُلَّ خُلقٍ لَم يَرُق","إِنَّ ضيقَ الرِزقِ مِن ضيقِ الخُلُق",60,"ق",1,0],["وَتَجَنَّب في الصَغيراتِ الغَضَب","إِنَّهُ كَالنارِ وَالرُشدُ الَحطَب",60,"ب",1,0],["وَتَجُسُّ راحَتُهُ العَليلَ وَتارَةً","تَكسو الفَقيرَ وَتُطعِمُ المِسكينا",61,"ن",2,0],["وَتُجالِسُ العُلَماءَ في حُجُراتِها","وَتُسامِرُ الحُكَماءَ وَالشُعَراءَ",62,"ا",2,0],["وَتَجَلَّدوا لِلخَطبِ مِثلَ ثَباتِهِ","أَيّامَ يُدافِعُ الأَرزاءَ",63,"ا",2,0],["وَتَجَلَّيتَ فَاِستَلَمنا كَما لِلنا","سِ بِالرُكنِ ذي الجَلالِ اِستِلامُ",64,"م",1,0],["وتَجَسَّدَ الروح اللطيف به","ذا حَلَّ مالاقى وذاك عقد",65,"د",1,0],["وَتَجَمَّعَت بَغدادُ ثُمَّ تَفَرَّقَت","شِيَعاً يُشَيِّعُها الضَلالُ المُصحِبُ",66,"ب",1,0],["وَتَجَلّى لِلناظِرينَ أَبِيٌّ","فيهِ عَن جانِبِ القَبيحِ اِزوِرارُ",67,"ر",1,0],["وَتَجويدِ الحُروفِ إِذا اِبتَداها","مُقَوَّمَةً وَتَعديلِ السُطورِ",68,"ر",1,0],["وتجف أثواب الثناء لأنها","فجعت بريق مزنها الرقراق",69,"ق",1,0],["وتَجذبِنُي إذا ما الشَّامُ ضاقَتْ","عَليَّ رِحابُه رَحَبُ العِراقِ",70,"ق",1,0],["وتَجلُبُ من كَرمٍ في النَّدى","فإن أجلَبَ الدهرُ أضحى وَقورا",71,"ر",2,0],["وتجديدهُنَّ بجرِّ الذّيولِ","وجرِّ الزِّقاقِ أديمَ الفَضاءِ",72,"ا",2,0],["وَتَجرَةِ صِدقٍ لِلمَعادِ أَضَعتُها","وَقَد أَمكَنَتني مِن يَدِ الرِبحِ سوقُها",73,"ق",3,0],["وَتَجاوُبُ الأَطيارِ في أَشجارِهِ","كَبَناتِ مَعبَدَ في مَواجِبِ عودِهِ",74,"د",2,0],["وَتَجَلَّت مِن خِدرِها فَنَهَضنا","وَمَشَينا لِفَضلِها خُطُواتِ",75,"ت",1,0],["وَتَجارَيتُما إِلى حَلبَةِ المَج","دِ فَوافَيتُما كَمُهرَي رِهانِ",76,"ن",1,0],["وَتَجَمَّعوا حَتّى مَدَدتَ لَهُم يَداً","ذَكَروا بِها أَيدي سَبا فَتَفَرَّقوا",77,"ق",3,0],["وَتَجَرَّعوا غُصَصَ المَنونِ","بِما عَليهِ تَجَرَّأوا",78,"ا",1,0],["وتجد عيون اللهو جارية","فهنا الحياة وأنت لا تدري",79,"ي",1,0],["وتجعلُ القارَ الذي باشَرَها","في الدنّ مسكاً للعرانينِ نفح",80,"ح",1,0],["وَتَجزَعُ مِن مَزحي وَتَرضى قَصيدَةً","وَقَد أُخرِجَت أَلفاظُها مَخرَجَ الشَتمِ",81,"م",1,0],["وتجلَّدْ لزورِ هجوٍ ومدحٍ","أو ليسَ الملوكُ تُهجى وتُمدحْ",82,"ح",1,0],["وتجنبْهُ الأصدقاءُ وأشفقوا","مِنْ قربِهِ وجفتْهُ خلاّنُ الصِّبا",83,"ب",2,0],["وتجنَّبْ السلطانَ غيرَ مقاطعٍ","وإذا سطا فحذارِ ثمَّ حذارِ",84,"ر",1,0],["وتَجَنَّبِي الشُّبُهَاتِ في","وَعْيٍ سَيُوصَمُ ﺑﭑجْتِرَامِ",85,"م",1,0],["وَتَجعَلي نُطفَةً في القَعبِ بارِدَةً","فَتَغمِسي فاكِ فيها ثُمَّ تَسقيني",86,"ن",2,0],["وَتَجلو كَمُزنَةِ غَيثٍ لَها","غَفائِرُ تَكسو البِطاحَ النَفَل",87,"ل",1,0],["وَتَجَلَّدتَ لي لِتَصرِمَ حَبلي","بَعدَما كُنتَ رِثَّةً قَد وَصَلتا",88,"ت",2,0],["وَتَجلو سَوادَ المُشكِلاتِ بِخاطِرٍ","تَرَكَّبَ مِن نارٍ تُشَبُّ وَنورِ",89,"ر",1,0],["وَتُجلى بِها لِلماءِ وَالنارِ صورَةٌ","تَروقُ فَطَرفي حَيثُ يَغرَقُ يُحرَقُ",90,"ق",1,0],["وتَجفُلُ تتَّقِى عُقْبَى اللّيالي","وتَخشَى أن تَذِلَّ وأن تهونا",91,"ن",2,0],["وتجلّت غَمرةُ الهادي فلا","رِيبَةٌ تَغشى ولا ظَنٌّ يرين",92,"ن",1,0],["وَتَجَشَّموا البَحرَ الأُجاجَ فَإِنَّهُ","سَبَبٌ بِهِ تَرِدونَ نَهرَ الكَوثَرِ",93,"ر",1,0],["وَتَجَلّت أَنوار من مَلَك المل","ك فَخرَّ الحَضور للأَذقان",94,"ن",1,0],["وَتَجودُ مِن عَينٍ ضَفو","فِ الغَربِ مُترَعَةِ الجَداوِل",95,"ل",1,0],["وَتجَدَّلَ الأُسروعُ واطَّرَدَ السَفا","وَجَرَت بِجائِلِها الحِدابُ القَردَدُ",96,"د",1,0],["وَتَجرمُ أَمسِ وَما قَبلَهُ","وَمُختَلَفُ اليَومِ وَالبارِحَه",97,"ح",2,0],["وَتَجَنّى مُكابِراً يَحسُبُ الغَض","بانُ لِلعَفوِ كُلَّ وَقتٍ مُسَخَّر",98,"ر",1,0],["وَتَجَنَّت بي لِتَغدُرَني","أَنا أَهواها عَلى غَدرِ",99,"ر",1,0],["وَتَجَنَّبِ التَّأْوِيلَ في أقْوالِ مَنْ","صاحَبْتَ مِنْ أهْلِ السعادَةِ تَسْعَدِ",100,"د",1,0],["وتُجِنُّ منْهُ كلُّ وَبْرَةِ لِبْدَةٍ","لَيْثاً ويَحمِلُ كُلُّ عُضْوٍ فيلا",101,"ل",2,0],["وتُجدى وأُكْدى والمناديحُ جَمّةٌ","فما لي غنيَّ البَالِ وهي الصّعالك",102,"ك",1,0],["وتجمّعتْ فيك القلوبُ على الرّضى","وتشيّعتْ في حُبّكَ الأهواء",103,"ا",2,0],["وَتَجَشَّمَت بي هَولَ كُلِّ تَنوفَةٍ","هَوجاءَ فيها جُرأَةٌ إِقدامُ",104,"م",1,0],["وَتَجَوَّبَت مِزَقُ الدُجى عَن واضِحٍ","كَالفَرقِ وَاِنكَشَفَت سَماءُ ضَبابِهِ",105,"ب",2,0],["وَتَجمَعُ دَعوَتي آثارَ قَومي","هُمُ الأُسدُ الخَوادِرُ تَحتَ غابِ",106,"ب",1,0],["وَتَجادَلَت فُقَهاؤُها مِن حُبِّها","وَتَقَرَّأَت لِتَنالَها قُرّاؤُها",107,"ا",3,0],["وَتَجري دَفارِ بِها جَدَّها","بِمِثلِ الظَلامِ إِذا ما جَرى",108,"ر",2,0],["وَتَجوزُ مَعرِفَتي بِمَسقِطِ هامَتي","في الوِردِ بِالقَبرِ في الإِصدارِ",109,"ر",1,0],["وَتَجري المَقاديرُ مِنهُ عَلى","عِظامِ النُجومِ وَأَشراطِها",110,"ط",3,0],["وَتَجهَلُ العودَ إِلّا عودَ مِغزَلِها","وَلا تَراحُ إِذا ما عاتِقٌ بُزِلا",111,"ل",2,0],["وَتَجولُ فَوقَ الساكِنينَ كَأَنَّها","وَرهاءُ هاجِرَةٌ غَدَت في مِجوَلِ",112,"ل",1,0],["وَتَجعَلُهُ في سِربِها نُصبَ عَينِها","وَتَثني عَلَيهِ الجيدَ في كُلِّ مَرقَدِ",113,"د",1,0],["وَتَجاوَزوا ذاكُم إِلَينا كُلَّهُ","عَدواً وَمَرقَصَةً فَلَمّا قَرَّبوا",114,"ب",3,0],["وَتَجَلَّت مثل العروس بوجه","نوره باهر أولي الأبصار",115,"ر",1,0],["وتجلَّت لهم كما يتجلَّى","من وراء السحاب بدر التمام",116,"م",1,0],["وَتَجعَل الظهر بطناً","وَتَجعَل البطن ظهرا",117,"ر",2,0],["وتُجري ذِراعينِ منسابتينِ","كفرعينِ من جدولٍ في انثيالْ",118,"ل",1,0],["وتجلَّتْ في حُلمِهِ بنظامٍ","من بديعِ التكوين والتصويرِ",119,"ر",1,0],["وتجلتِ الدنيا كأبهج ما رأت