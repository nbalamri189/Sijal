1,0],["وتجعل القار الذي باشرها","في اللدن مسكاً للعرانين نفحْ",144,"ح",1,0],["وتجاهلت أو أنكرت","أمري لدى دلّاسها",145,"س",3,0],["وتجوزُ مَعرفتي بمسقِطِ هامَتي","في الوِرْدِ، لا بالقبرِ في الإصدار",146,"ر",1,0],["وتجري دُفارِ بها جَدُّها،","بمثلِ الظلامِ، فإذا ماجرى",147,"ر",2,0],["وتجَارَى الأمويونَ إلى","غَمرةِ الموتِ وفازَ السعداء",148,"ا",2,0],["وتَجْرِيمُ أمْسِ ومَا قَبْلَهُ","ومختلفُ اليومِ والبارِحَهْ",149,"ح",2,0],["وتجمّعتْ فيكَ القلوبُ على الرّضى","وشيّعتْ في حبكَ الأهواء",150,"ا",2,0],["وتجترّه من غيوم الصّديد","بلاد من الطيب ، في لا بلاد",151,"د",1,0],["وتجلت في مرسح الرقص حتى","أرقصت بالغرام منا القلوبا",152,"ب",2,0]]}