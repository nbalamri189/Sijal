{"poems":[[95,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[74,"لامني الفتح إذا عزمت على النأي","https://www.aldiwan.net/poem20585.html","الخفيف"],[94,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[94,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[58,"قولا لبكر بن دهمرد إذا اعتكرت","https://www.aldiwan.net/poem58502.html","البسيط"],[45,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10579.html","الرجز"],[68,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[99,"إيه سونيا إيهِ سونيا","https://www.aldiwan.net/poem24415.html","مجزوء الرمل"],[46,"غير مستأنس بشيء إذا غب","https://www.aldiwan.net/poem30289.html","الخفيف"],[104,"يا سراة البلاد يكفي البلادا","https://www.aldiwan.net/poem33129.html","الخفيف"],[78,"أرى للصبا وداعا","https://www.aldiwan.net/poem39273.html","المضارع"],[78,"أنت دائي وفي يديك دوائي","https://www.aldiwan.net/poem39505.html","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125711","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[111,"يا أخا عبس الحماة الأنوف","https://www.poetsgate.com/ViewPoem.aspx?id=529",""],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[234,"يا سراج الأنام جنح الظلام","https://www.aldiwan.net/poem50831.html","الخفيف"],[276,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[287,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[333,"أنت دنياي التي تهتف بي","https://www.aldiwan.net/poem54915.html","الرمل"],[333,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[333,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[443,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[447,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[556,"لا تطمعي في سلو قلب","https://www.aldiwan.net/poem47147.html","مخلع البسيط"],[556,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[566,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48787","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48901","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38635","الرمل"],[889,"","https://poetry.dctabudhabi.ae/diwan/poem/205129",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145945","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59785","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203793",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64703","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136783",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80014","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101040","المديد"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126651","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93603","السريع"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105402","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94146","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94233","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201047","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79702","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79699","الخفيف"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96127","البسيط"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13018","الرمل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140306",""],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70378","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97872","الرمل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133001","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62837","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108290","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125948","الخفيف"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200312","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46024","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205881","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117980","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117893","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101366","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101347","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45129","الرمل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81932","السريع"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73272","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83198","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120357","الكامل"],[4733,"نشيدُ البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=192765",""],[4767,"وردتي","https://www.poetsgate.com/ViewPoem.aspx?id=175104",""],[4859,"غرس الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=186761",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[585,"يا من تأنق في التصوير يحكينا","https://www.poetsgate.com/ViewPoem.aspx?id=161919",""],[5155,"الى معجزة الغناء العربي (ام كلثوم)","https://www.poetsgate.com/ViewPoem.aspx?id=176242",""],[5213,"ايها المدعي الحذاقة في الفن","https://www.poetsgate.com/ViewPoem.aspx?id=170574",""],[5281,"ذات مساء","https://www.poetsgate.com/ViewPoem.aspx?id=199499",""],[5388,"لتكن","https://www.poetsgate.com/ViewPoem.aspx?id=206918",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5809,"جمر وخوف","https://www.poetsgate.com/ViewPoem.aspx?id=205396",""],[5910,"دَعْ عتكَ مَن يدَّعي زُورًا أخوَّتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=206953",""],[5956,"لا تؤلِمُ \"البايْبايُ\" حين دفني في الحصا العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=208047",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[6256,"هاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65914&r=&rc=2",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["إِنْ تَدْعُكَ الجُلَّى مَضَيْتَ مَضَاءهُ","وَأَحبَّ مِنْ حَرْبٍ إليك سَلاَمُ",0,"م",1,0],["أنت دفنتَ النوى كما زعموا","فها أنا عن دمشق أنويه",1,"ه",1,0],["أَنْتَ دُنيا يُظلُّها أُفُقُ الماضي","وليلُ الكآبَةِ الأَبديُّ",2,"ي",1,0],["أَنتِ دنيا من الأَناشيدِ والأَحلامِ","والسِّحْرِ والخيال المديدِ",3,"د",1,0],["إنْ تَدْمَ فَخْذاكَ مِنْ رَكْضٍ فَرُبّمَتَأ","أُمْسي وقَلْبي عليكَ الموجَعُ الدَّامي",4,"م",2,0],["إِن تَدعُ يا سَيفُ لِتَستَعينَهُ","يُجِبكَ قَبلَ أَن تُتِمَّ سينَهُ",5,"ن",2,0],["أَنتَدي في حِماكِ كَعباً وَمَغنىً","وَإِذا شِئتُ سَنبَساً وَعُقَيلا",6,"ل",2,0],["أنت دنيا الحسن لك","نَ سماواتك عُليا",7,"ي",2,0],["أَنتَ دونَ الجُلّاسِ أُنسي وَإِن كُن","تَ بَعيداً فَالحُزنُ فيكَ قَريبُ",8,"ب",1,0],["اِنتِداب أَحدُّ مِن شفرة السَي","ف وَأَورى مِن المَنايا زِنادا",9,"د",2,0],["إنْ تَدْنُ مِنْهُ شِبراً","يُقَرّبْكَ مِنْهُ باعا",10,"ع",2,0],["أَنْتِ دَائي وَفي يَدَيْكِ دَوَائي","يَا شِفائي مِنَ الجَوى وَبَلائي",11,"ي",1,1],["أنت دنيا الحسن لكن","نَ سماواتك عُليا",12,"ي",2,0],["إِنْ تدْعُ دَاعِيَةُ المُرُوءَة تَلْقَهُ","ذَا جَانِبٍ وَافَى المُرُوءَةَ وافِرِ",13,"ر",1,0],["إِنْ تدْهَهَا حُمْرُ الصوَاعِقِ تَبْتَسِمْ","فِيهَا النَّضارَة عَنْ لظى وَقَّادِ",14,"د",1,0],["إِنْ تَدْفَعُوا شَرَّ الخَصَاصَةِ فُزْتُمُ","في عَاجِلٍ بِثَوَابِ خَيْرِ مُثِيبِ",15,"ب",1,0],["أنت دنيا الجمال نمنمها السحر","فأغرى بها الجمال وأذهل",16,"ل",1,0],["أنت دون التوصيف فخر لعبس","لم تزد في علاك بالتوصيف",17,"ف",1,0],["أنت داء وليس كالأدواء","أنت رزء وليس كالأرزاء",18,"ا",2,0],["إنْ تداويتَ بالدَّواءِ فَقِدْماً","كنتَ لِلْمُعْتَفي أَسَا الإعدامِ",19,"م",1,0],["ان تدع أَحمد يبتدرك ملبيا","من ليس يعرف لا بغير تشهد",20,"د",1,0],["إِن تُدمِ أَلحاظُنا خَدَّيهِ مِن تَرَفٍ","فَلِم لِأَلحاظِهِ أَحشاؤُنا ثارُ",21,"ر",1,0],["أنت دنياي التي تهتف بي","فاسكبي عطرك في روحي اسكبي",22,"ي",1,1],["أنت ديوان شاعر سرمدي","عبقري الأوزان والأنغام",23,"م",1,0],["أنت دنياي التي","أنشدها في خلواتي",24,"ي",1,0],["إن تدم حلف الهوى","فهو يدني أجلك",25,"ك",1,0],["إن تدفعوا كيد العدا بشراسة","يبقى حماكم مخصبا منجوعا",26,"ع",2,0],["إنْ تَدْنُ يوماً إلى وِصالي","فحبّذا ذلك الدُّنُوُّ",27,"و",1,0],["إنْ تدنُ منّي وُصلةً وقرابةً","فَلأَنتَ في قلبي من الحُلّالِ",28,"ل",1,0],["إِن تَدنُ أَو تَنأ فَلا نَسِيُّ","لِما قَضى اللَهُ وَلا قَفِيُّ",29,"ي",1,0],["أنت داويت كل أمر فهل تُرْ","جَى مداواة هذه النفسيه",30,"ي",2,0],["إن تدع علتي القديمة بعضي","زاد في غمي الجديد وهمي",31,"م",2,0],["إِنْ تَدعْ شُكراً عَلَيها هَرَبَت","وَندمتَ الدّهرَ كلَّ النّدمِ",32,"م",1,0],["أنت دعها وارج أخرى","من رحيق السلسبيل",33,"ل",1,0],["أنتِ دُنياهُ في الهوى وأمانيهِ","حرامٌ عليكِ أن تحزنيهِ",34,"ي",2,0],["أنت دعصُ الرمل ردفاً","أنت غُصنُ البان قدَّا",35,"د",2,0],["أنت دخري ومنفذي وملاذي","أنت عوني ومنجدي ونصيري",36,"ر",2,0],["إن تُدْم كفَّيْهِ القيود","ُ فلن يلين على القيود",37,"د",1,0],["أَنْتَ دَواءٌ لِكلِّ داءٍ","تَعْجَزُ عَنْ طِبِّهِ الأُساةُ",38,"ه",1,0],["إِنْ تَدْعُني خالِياً مِنْ لَوْعَتي فَلَقَدْ","أَجابَ دَمْعي وما الدَّاعي سِوى طَلَلِ",39,"ل",1,0],["أن تدعو الضيف ولا تبالي","رفيقه الحقيق بالإجلال",40,"ل",1,0],["أنت درعٌ محكم السردِ إذا","صوب الدهر على مثلي سهامه",41,"م",2,0],["إنْ تدعُه لملمَّةٍ","جاءتْ كفايتُه سريعه",42,"ع",2,0],["إن تدلى عن جبينٍ منير","فوق متنٍ زانه باعتدال",43,"ل",1,0],["أنت دار السلام صاحبة المج","د وأم الحصون أم القلاع",44,"ع",1,0],["إن تدبرت في النجوم الجواري","تَرَهُنَّ انطباع نور حصاها",45,"ا",3,0],["إن تدعُه صدقاً أجابَ بعزمه","علمُ الفتوّة نجدةُ الشجعان",46,"ن",1,0],["إِن تَدر الحَرب كَدور الرحى","فَمِنهُم القُطب وَفيهُم تُدار",47,"ر",1,0],["أنت دون الأنام مالك رقي","وقيادي وتحت رقي الأنام",48,"م",1,0],["انتدبت لزينه مذ أرخوا","ندبت ميمونة أم المؤمنين",49,"ن",1,0],["إن تداعو وضاهؤوه فلا حب","ب كمالاً كرامة للتداعي",50,"ع",2,0],["انتدا بالواجب الأمر ممن","فرض العدل في القضايا وسنه",51,"ن",2,0],["إن تدانى الشمل في أرض الحمى","عن لي بالأبرق الفرد وراما",52,"م",2,0],["انت دفئي إذا بُليتُ ببرد","وسراجي إن اظلمَ النفسَ بؤس",53,"س",1,1],["أنت دون الأطفال أكبرت غمي","وعهدت الأطفال تنسى الغموما",54,"م",2,0],["أنت دون الأزهار ينبتك ال","حب وتسقين من دموع المآقي",55,"ق",2,0],["ان تدع خندف بغيا او مكاثرة","أدع القبائل من قيس وعيلانا",56,"ن",2,0],["أَنتَ داوَيتَ زَماناً","كانَ مَعدومَ العِلاجِ",57,"ج",1,0],["أنت دمشق من البلوى فشايعها","بواكف الدمع والبرحاء لبنان",58,"ن",1,0],["أنْتَ دَلِيلٌ لي عَلَى أَنَّهُ","يُحالُ بَيْنَ الْمَرء والقلب",59,"ب",1,0],["أنت دنياي وديني","أنت عمري والخلود",60,"د",1,0],["إن تَدعُهُم مرَّة لنائبةٍ","يَنفَصِلوا عَنكَ بَعدَ ما اتصلوا",61,"ل",3,0],["أنتَ دافعتَ عنه يوماً بسورا","بَ ويوماً بجانِبِ الأجْيالِ",62,"ل",1,0],["أنتَ دُرٌّ كرمت فاخترت داراً","تلتقي في ربوعها التكريما",63,"م",2,0],["أنت دمع النهار في صفحة الكو","ن يحى في الليل سراً