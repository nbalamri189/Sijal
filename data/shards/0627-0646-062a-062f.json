{"poems":[[93,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[72,"لامني الفتح إذا عزمت على النأي","https://www.aldiwan.net/poem20585.html","الخفيف"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[56,"قولا لبكر بن دهمرد إذا اعتكرت","https://www.aldiwan.net/poem58502.html","البسيط"],[43,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10579.html","الرجز"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[97,"إيه سونيا إيهِ سونيا","https://www.aldiwan.net/poem24415.html","مجزوء الرمل"],[44,"غير مستأنس بشيء إذا غب","https://www.aldiwan.net/poem30289.html","الخفيف"],[102,"يا سراة البلاد يكفي البلادا","https://www.aldiwan.net/poem33129.html","الخفيف"],[76,"أرى للصبا وداعا","https://www.aldiwan.net/poem39273.html","المضارع"],[76,"أنت دائي وفي يديك دوائي","https://www.aldiwan.net/poem39505.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125711","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[229,"يا سراج الأنام جنح الظلام","https://www.aldiwan.net/poem50831.html","الخفيف"],[271,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[282,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[328,"أنت دنياي التي تهتف بي","https://www.aldiwan.net/poem54915.html","الرمل"],[328,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[328,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[437,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[441,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[551,"لا تطمعي في سلو قلب","https://www.aldiwan.net/poem47147.html","مخلع البسيط"],[551,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["إِنْ تَدْعُكَ الجُلَّى مَضَيْتَ مَضَاءهُ","وَأَحبَّ مِنْ حَرْبٍ إليك سَلاَمُ",0,"م",1,0],["أنت دفنتَ النوى كما زعموا","فها أنا عن دمشق أنويه",1,"ه",1,0],["أَنْتَ دُنيا يُظلُّها أُفُقُ الماضي","وليلُ الكآبَةِ الأَبديُّ",2,"ي",1,0],["أَنتِ دنيا من الأَناشيدِ والأَحلامِ","والسِّحْرِ والخيال المديدِ",3,"د",1,0],["إنْ تَدْمَ فَخْذاكَ مِنْ رَكْضٍ فَرُبّمَتَأ","أُمْسي وقَلْبي عليكَ الموجَعُ الدَّامي",4,"ي",1,0],["إِن تَدعُ يا سَيفُ لِتَستَعينَهُ","يُجِبكَ قَبلَ أَن تُتِمَّ سينَهُ",5,"ن",2,0],["أَنتَدي في حِماكِ كَعباً وَمَغنىً","وَإِذا شِئتُ سَنبَساً وَعُقَيلا",6,"ل",2,0],["أنت دنيا الحسن لك","نَ سماواتك عُليا",7,"ي",2,0],["أَنتَ دونَ الجُلّاسِ أُنسي وَإِن كُن","تَ بَعيداً فَالحُزنُ فيكَ قَريبُ",8,"ب",1,0],["اِنتِداب أَحدُّ مِن شفرة السَي","ف وَأَورى مِن المَنايا زِنادا",9,"د",2,0],["إنْ تَدْنُ مِنْهُ شِبراً","يُقَرّبْكَ مِنْهُ باعا",10,"ع",2,0],["أَنْتِ دَائي وَفي يَدَيْكِ دَوَائي","يَا شِفائي مِنَ الجَوى وَبَلائي",11,"ي",1,1],["أنت دنيا الحسن لكن","نَ سماواتك عُليا",12,"ي",2,0],["إِنْ تدْعُ دَاعِيَةُ المُرُوءَة تَلْقَهُ","ذَا جَانِبٍ وَافَى المُرُوءَةَ وافِرِ",13,"ر",1,0],["إِنْ تدْهَهَا حُمْرُ الصوَاعِقِ تَبْتَسِمْ","فِيهَا النَّضارَة عَنْ لظى وَقَّادِ",14,"د",1,0],["إِنْ تَدْفَعُوا شَرَّ الخَصَاصَةِ فُزْتُمُ","في عَاجِلٍ بِثَوَابِ خَيْرِ مُثِيبِ",15,"ب",1,0],["أنت دنيا الجمال نمنمها السحر","فأغرى بها الجمال وأذهل",16,"ل",1,0],["أنت داء وليس كالأدواء","أنت رزء وليس كالأرزاء",17,"ا",2,0],["إنْ تداويتَ بالدَّواءِ فَقِدْماً","كنتَ لِلْمُعْتَفي أَسَا الإعدامِ",18,"م",1,0],["ان تدع أَحمد يبتدرك ملبيا","من ليس يعرف لا بغير تشهد",19,"د",1,0],["إِن تُدمِ أَلحاظُنا خَدَّيهِ مِن تَرَفٍ","فَلِم لِأَلحاظِهِ أَحشاؤُنا ثارُ",20,"ر",1,0],["أنت دنياي التي تهتف بي","فاسكبي عطرك في روحي اسكبي",21,"ي",1,1],["أنت ديوان شاعر سرمدي","عبقري الأوزان والأنغام",22,"م",1,0],["أنت دنياي التي","أنشدها في خلواتي",23,"ي",1,0],["إن تدم حلف الهوى","فهو يدني أجلك",24,"ك",1,0],["إن تدفعوا كيد العدا بشراسة","يبقى حماكم مخصبا منجوعا",25,"ع",2,0],["إنْ تَدْنُ يوماً إلى وِصالي","فحبّذا ذلك الدُّنُوُّ",26,"و",1,0],["إنْ تدنُ منّي وُصلةً وقرابةً","فَلأَنتَ في قلبي من الحُلّالِ",27,"ل",1,0],["إِن تَدنُ أَو تَنأ فَلا نَسِيُّ","لِما قَضى اللَهُ وَلا قَفِيُّ",28,"ي",1,0]]}