{"poems":[[55,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[55,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[65,"خليلي ما بال الليالي تلفتت","https://www.aldiwan.net/poem45943.html","الطويل"],[3,"يا أيها الملك الذي راحاته","https://www.aldiwan.net/poem213.html","الكامل"],[73,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[95,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[29,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[74,"إنسان عيني ساهر بك سافح","https://www.aldiwan.net/poem18483.html","الكامل"],[74,"عوذت شعرك بالظلام وما وسق","https://www.aldiwan.net/poem19349.html","الكامل"],[74,"ألحب مفروض علي لغادة","https://www.aldiwan.net/poem20284.html","الكامل"],[53,"وسيد قد عمرتني أنعمه","https://www.aldiwan.net/poem66090.html","الرجز"],[72,"أشكو إليك لأننا أخوان","https://www.aldiwan.net/poem42684.html","الكامل"],[47,"وجدت وعدك زورا في مزورة","https://www.aldiwan.net/poem66853.html","البسيط"],[30,"وقائلة والدمع يحدر كحلها","https://www.aldiwan.net/poem5499.html","الطويل"],[63,"فلأشهرن عليك منه قصائدا","https://www.aldiwan.net/poem51304.html","الكامل"],[68,"أوليتني نعما تتابع منها","https://www.aldiwan.net/poem40953.html","الكامل"],[46,"شجا في الحشى ترداده ليس يفتر","https://www.aldiwan.net/poem30502.html","الطويل"],[107,"إليك أبا سفيان لا الوعد صادق","https://www.aldiwan.net/poem44202.html","الطويل"],[83,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[50,"اعدل عن الطلل المحيل وعن هوى","https://www.aldiwan.net/poem62557.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85488","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10712","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9983","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[118,"لقد طال للركب المجد تلفتي","https://www.aldiwan.net/poem41193.html","عموديه"],[131,"ما زلت في لهو وفي طرب وفي","https://www.aldiwan.net/poem50542.html","الكامل"],[146,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[150,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[153,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[153,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[163,"خطرت بقد أهيف مياس","https://www.aldiwan.net/poem58852.html","الكامل"],[163,"تلاطم بحر جيشه وماجا","https://www.aldiwan.net/poem58954.html","الوافر"],[200,"إعزف على العود يا معبودي الثاني","https://www.aldiwan.net/poem39888.html","البسيط"],[213,"أحيا الربيع الأرض بعد مماتها","https://www.aldiwan.net/poem13322.html","الكامل"],[238,"مالي على جور الليالي صاحب","https://www.aldiwan.net/poem32144.html","الكامل"],[238,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[240,"قصدنا ابن داود ذا المعلوات","https://www.aldiwan.net/poem19065.html","المتقارب"],[273,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[273,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[273,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[278,"أشد بالقوافي ذكر علوة أو عليا","https://www.aldiwan.net/poem25451.html","الطويل"],[283,"أدنى اشتياقي أن أبيت عليلا","https://www.aldiwan.net/poem60594.html","الكامل"],[283,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[290,"بكرت لتحزن عاشقاً طفل","https://www.aldiwan.net/poem1914.html","أحذ الكامل"],[323,"ماذا عسى لأبي الفضائل أن تجيب","https://www.aldiwan.net/poem67144.html","الكامل"],[367,"أرى فكرتي في فنون القريض","https://www.aldiwan.net/poem60661.html","المتقارب"],[367,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[367,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[367,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[380,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[383,"فؤاد إلى تلك الرحاب جموح","https://www.aldiwan.net/poem48840.html","الطويل"],[383,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[383,"على ثقة باتلافي وعلم","https://www.aldiwan.net/poem49243.html","الوافر"],[408,"فأتى وفاؤك وهو أنس ناضر","https://www.aldiwan.net/poem49932.html","الكامل"],[435,"أحبب طرسا رأيت صباحه","https://www.aldiwan.net/poem12726.html","أحذ الكامل"],[442,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[442,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[460,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[460,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[466,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[466,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[472,"زايلت ما صنعوا إليك برحلة","https://www.aldiwan.net/poem4781.html","الكامل"],[481,"الوافر","https://www.aldiwan.net/poem36955.html","الوافر"],[506,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[506,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[518,"فلا شك ان الحي ادنى مقيلهم","https://www.aldiwan.net/poem48667.html","الطويل"],[553,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[555,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/29439","الطويل"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18751","الطويل"]],"verses":[["فَلَأَشرَبَنَّ مَناقِباً بِدَمي","وَلَأَنقُبَنَّ عَلى العُلى جُهدي",0,"د",2,0],["فَلأَشكُرَنَّكَ ما تَجاذَبَ مِقوَلي","نَثرٌ يَشُقُّ عَلى العِدى وَقَصيدُ",1,"د",1,0],["فَلا شَامَ في هَامِ الأَعادِي مُهَنَّداً","يَميني وَلا شَمَّ الحَمائِلَ عاتِقي",2,"ق",2,0],["فَلَأَشكُرَنَّ صَنيعَهُ بَينَ المَل","وَأُطاعِنُ الفُرسانَ في مَيدانِهِ",3,"ن",2,0],["فَلَأَشكُرَنَّ حَوادِثاً قَذَفَت بِآ","مالي إِلَيكَ وَحَقُّها أَن تُشكَرا",4,"ر",2,0],["فَلا شَيْءَ مِمَّا صَرَفْتَ إِلَيْهِ","مَشِيئَةَ مُقْتَدِرٍ عَازِمٍ",5,"م",1,0],["فَلَأَشكُرَنَّ بَلاءَ قَومٍ ثَبَّتوا","قَصَبَ الجَناحِ وَأَنبَتوا ريشَ الغِنا",6,"ا",1,0],["فلأشكرنَّك في القريض بسبّق","مع أنها عمَّا بلغت طلائح",7,"ح",1,0],["فلأشكرنّ جميل ما أوليتني","شكر الرياض الزهر للماء الغدق",8,"ق",1,0],["فلأشكرنَّك ما حَييتُ","وإن أمتْ فلتشكرنَّكْ",9,"ك",1,0],["فلا شفاني من سقام ألمُهْ","أو أجرعُ الموتَ مَذُوقاً علْقَمُهْ",10,"م",2,0],["فَلَأَشكُرَنَّ عُهودَها وَعِهادَها","بِصَفاءِ وُدٍّ أَو صَفاءِ بَيانِ",11,"ن",1,0],["فَلا شَفى اللَهُ مَن يَرجو الشَفاءَ بِها","وَلا عَلَت كَفُّ مُلقٍ كَفُّهُ فيها",12,"ي",3,0],["فَلا شَرِبوا إِلّا بِمِلحٍ مُزَلَّجٍ","وَلا نَسَكوا الإِسلامَ إِن لَم تَنَدَّمِ",13,"م",1,0],["فلأشهرن عليك منه قصائدا","لحسبن أسيافا وهن قصائد",14,"د",1,1],["فَلَأَشكُرَنَّكَ ما اِستَطَعتُ تَلَفُّظاً","شُكرَ الرِياضِ لِصَيِّبِ الأَنواءِ",15,"ا",2,0],["فَلا شَيءَ أَمضى مِن رَجائِكَ في النَدى","وَلا شَيءَ أَبقى مِن ثَناءٍ يُحَبَّرُ",16,"ر",1,0],["فلا شأنُها الشأنُ الذي كان يرتضِي","بَنُوها الأُلى بادوا ولا حالُها الحال",17,"ل",1,0],["فَلا شَفاني اللَهُ إِن","دَعَوتُ مِنهُ بِالشِفا",18,"ف",2,0],["فَلا شارِدٌ إِلّا نَداكَ عِقالُهُ","وَلا خائِفٌ إِلّا عُلاكَ مَعاقِلُه",19,"ل",2,0],["فلا شفى داءَهم إلاّ دواؤهُمُ","والسيْفُ نِعْمَ دَواءُ الداء والعِلل",20,"ل",1,0],["فلا شَدْوَ إلاّ من رَنينِكَ شائِقٌ","ولا دَمعَ إلاّ من جفونيَ مسكوب",21,"ب",1,0],["فَلَأَشرَبَنَّ بِطارِفٍ وَبِتالِدٍ","بِنتَ الكُرومِ بِرَغمِ أَنفِ الحُسَّدِ",22,"د",1,0],["فَلا شعب إلا وهوَ بالعلم وحده","سَعيد وإلا كانَ جم الفَجائع",23,"ع",1,0],["فَلا شَخصٌ يَرُدُّ جَوابَ قَولي","وَلا العَتّابُ يَرجِعُ في جَوابي",24,"ب",2,0],["فَلَأَشكُرَنَّ صَنيعَهُ بَينَ المَلا","وَأُطاعِنُ الفُرسانَ في مَيدانِهِ",25,"ن",2,0],["فَلا شَقَاءٌ وَلا بَأْسٌ وَلا فَزَعٌ","وَلا عَدَاءٌ وَلا غَدْرٌ وَلا حَذَرُ",26,"ر",1,0],["فلا شطحت الا الى الحي نظرتي","ولا طلبت غير الاحبة همتي",27,"ي",1,0],["فلأشكرنَّ جَدَا يديك لأنه","يأتي إلىّ بسرعةٍ في العاجِلِ",28,"ل",1,0],["فَلَأَشكُرَنَّ نَداكَ مَبلَغَ طاقَتي","أَنا إِن رَجَوتُ لَهُ جَزاءً أَشعَبُ",29,"ب",1,0],["فلا شيخ إلا من يخلّص هالكاً","غريقاً ينادي قد أحاط بي المكر",30,"ر",1,0],["فَلا شُبهَةٌ تُغوي وَلا لَفحَةٌ تُذوي","أَتى بِالهُدى ما بَينَ فَرضٍ وَسُنَّةٍ",31,"ه",1,0],["فَلا شَكَّ مِن شَكٍّ وَلا شِركَ مِن شِركِ","فَلِلَّهِ صَبٌّ باتَ وَهوَ مُرَرَّقُ",32,"ق",1,0],["فلأشكها عند المليك الطاهر","ابن الأشرف بن الأفضل العباسي",33,"س",2,0],["فلا شلت يداك لقد رأينا","بها أسد الشرى وانقلبت نعاجا",34,"ج",2,0],["فلا شويطئك الرمليّ اطرَبني","كلا ولا موجه الفضي وأساني",35,"ن",2,0],["فلأشكرنها ما حييت لياليا","قاضي القضاة اليوم من حسناتها",36,"ت",3,0],["فَلَأَشكُرَنَّ نَداهُ شُكرَ الرَوضَةِ","الغَنّاءِ مُنهَلَّ الغَمامِ الساكِبِ",37,"ب",1,0],["فَلّأَشكُرَنَّ نَداكَ ما","غَنّى الحَمامُ وَطَرَّبا",38,"ب",2,0],["فَلاَ شَكَّ عِنْدِي مِنْ فَيْضِهِ","عَلَيْنَا إِذَا مَا نَوَيْنَا الرَّحِيلْ",39,"ل",1,0],["فلا شرفٌ فوقَ الذي نلتُهُ ولا","كلامٌ لوَصفِ النَّعمةِ العلوية",40,"ه",1,0],["فلا شرفٌ إِلا بجُنديّةٍ غَدت","كفرضٍ من الإسلامِ والفرضُ لازِم",41,"م",1,0],["فلا شرائعَ إلا عنكِ مأخذُها","وفي اللغاتِ كثيرٌ من عطاياك",42,"ك",1,0],["فَلا شَكَّ أَنَّ السُّمْرَ شَكّاً تُبيتُهُم","وَلا رَيْبَ أَنَّ البِيضَ تُفْنِيهِمُ بَرْيَا",43,"ي",2,0],["فَلأَشْكُرَنَّكَ ما تَغَنّى تائِقٌ","طَرِبٌ وَما دَعَتِ الْحَمامُ هَدِيلا",44,"ل",2,0],["فَلا شَفَّها ما شَفَّنِي يَوْمَ أَعْرَضَتْ","صُدُوداً وَزُمَّتْ لِلتَّرَحُّلِ نُوقُها",45,"ق",3,0],["فَلَأَشكُرَنَّ فُضولَ نَعمَتِهِ","حَتّى أَموتَ وَفَضلُهُ فَضلُ",46,"ل",1,0],["فَلا شَكَرنَ هَناءَهُ وَوَلاءَهُ","ما اِهتَزَّ غُصنٌ أَو تَغَنّى عَندَليب",47,"ب",1,0],["فَلا شُكرَ عِندي سِوى ما رَهَن","تُ عِندَ الكَريمِ اِبنِ عَبدِ ا