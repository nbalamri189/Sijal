=211617",""],[5628,"لا جديد","https://www.poetsgate.com/ViewPoem.aspx?id=178475",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5689,"أراك على مر الجديدين خاسرا","https://www.poetsgate.com/ViewPoem.aspx?id=143410",""],[5691,"تألم في القبر الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206524",""],[5751,"أحزان أرضية لطفلٍ سماوي","https://www.poetsgate.com/ViewPoem.aspx?id=214761",""],[5855,"تملكت الفؤاد بدون علمي","https://www.poetsgate.com/ViewPoem.aspx?id=209004",""],[5956,"تصدُّ النفسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215870",""],[6031,"يا طِرْسُ قُلْ لأخِي السَّمَاحَةِ والنَّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=46397",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6093,"أ تخشى الشَّهادةَ أوْ أنْ تَموتْ؟","https://www.poetsgate.com/ViewPoem.aspx?id=176268",""],[6101,"مبتور عدوك / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[6102,"إِفراط ..","https://www.poetsgate.com/ViewPoem.aspx?id=182848",""],[6102,"شادن","https://www.poetsgate.com/ViewPoem.aspx?id=184418",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَلَأَشرَبَنَّ مَناقِباً بِدَمي","وَلَأَنقُبَنَّ عَلى العُلى جُهدي",0,"د",2,0],["فَلأَشكُرَنَّكَ ما تَجاذَبَ مِقوَلي","نَثرٌ يَشُقُّ عَلى العِدى وَقَصيدُ",1,"د",1,0],["فَلا شَامَ في هَامِ الأَعادِي مُهَنَّداً","يَميني وَلا شَمَّ الحَمائِلَ عاتِقي",2,"ق",2,0],["فَلَأَشكُرَنَّ صَنيعَهُ بَينَ المَل","وَأُطاعِنُ الفُرسانَ في مَيدانِهِ",3,"ن",2,0],["فَلَأَشكُرَنَّ حَوادِثاً قَذَفَت بِآ","مالي إِلَيكَ وَحَقُّها أَن تُشكَرا",4,"ر",2,0],["فَلا شَيْءَ مِمَّا صَرَفْتَ إِلَيْهِ","مَشِيئَةَ مُقْتَدِرٍ عَازِمٍ",5,"م",1,0],["فَلَأَشكُرَنَّ بَلاءَ قَومٍ ثَبَّتوا","قَصَبَ الجَناحِ وَأَنبَتوا ريشَ الغِنا",6,"ا",1,0],["فلأشكرنَّك في القريض بسبّق","مع أنها عمَّا بلغت طلائح",7,"ح",1,0],["فلأشكرنّ جميل ما أوليتني","شكر الرياض الزهر للماء الغدق",8,"ق",1,0],["فلأشكرنَّك ما حَييتُ","وإن أمتْ فلتشكرنَّكْ",9,"ك",1,0],["فلا شفاني من سقام ألمُهْ","أو أجرعُ الموتَ مَذُوقاً علْقَمُهْ",10,"م",2,0],["فَلَأَشكُرَنَّ عُهودَها وَعِهادَها","بِصَفاءِ وُدٍّ أَو صَفاءِ بَيانِ",11,"ن",1,0],["فَلا شَفى اللَهُ مَن يَرجو الشَفاءَ بِها","وَلا عَلَت كَفُّ مُلقٍ كَفُّهُ فيها",12,"ي",3,0],["فَلا شَرِبوا إِلّا بِمِلحٍ مُزَلَّجٍ","وَلا نَسَكوا الإِسلامَ إِن لَم تَنَدَّمِ",13,"م",1,0],["فلأشهرن عليك منه قصائدا","لحسبن أسيافا وهن قصائد",14,"د",1,1],["فَلَأَشكُرَنَّكَ ما اِستَطَعتُ تَلَفُّظاً","شُكرَ الرِياضِ لِصَيِّبِ الأَنواءِ",15,"ا",2,0],["فَلا شَيءَ أَمضى مِن رَجائِكَ في النَدى","وَلا شَيءَ أَبقى مِن ثَناءٍ يُحَبَّرُ",16,"ر",1,0],["فلا شأنُها الشأنُ الذي كان يرتضِي","بَنُوها الأُلى بادوا ولا حالُها الحال",17,"ل",1,0],["فَلا شَفاني اللَهُ إِن","دَعَوتُ مِنهُ بِالشِفا",18,"ف",2,0],["فَلا شارِدٌ إِلّا نَداكَ عِقالُهُ","وَلا خائِفٌ إِلّا عُلاكَ مَعاقِلُه",19,"ل",2,0],["فلا شفى داءَهم إلاّ دواؤهُمُ","والسيْفُ نِعْمَ دَواءُ الداء والعِلل",20,"ل",1,0],["فلا شَدْوَ إلاّ من رَنينِكَ شائِقٌ","ولا دَمعَ إلاّ من جفونيَ مسكوب",21,"ب",1,0],["فَلَأَشرَبَنَّ بِطارِفٍ وَبِتالِدٍ","بِنتَ الكُرومِ بِرَغمِ أَنفِ الحُسَّدِ",22,"د",1,0],["فَلا شعب إلا وهوَ بالعلم وحده","سَعيد وإلا كانَ جم الفَجائع",23,"ع",1,0],["فَلا شَخصٌ يَرُدُّ جَوابَ قَولي","وَلا العَتّابُ يَرجِعُ في جَوابي",24,"ب",2,0],["فَلَأَشكُرَنَّ صَنيعَهُ بَينَ المَلا","وَأُطاعِنُ الفُرسانَ في مَيدانِهِ",25,"ن",2,0],["فَلا شَقَاءٌ وَلا بَأْسٌ وَلا فَزَعٌ","وَلا عَدَاءٌ وَلا غَدْرٌ وَلا حَذَرُ",26,"ر",1,0],["فلا شطحت الا الى الحي نظرتي","ولا طلبت غير الاحبة همتي",27,"ي",1,0],["فلأشكرنَّ جَدَا يديك لأنه","يأتي إلىّ بسرعةٍ في العاجِلِ",28,"ل",1,0],["فَلَأَشكُرَنَّ نَداكَ مَبلَغَ طاقَتي","أَنا إِن رَجَوتُ لَهُ جَزاءً أَشعَبُ",29,"ب",1,0],["فلا شيخ إلا من يخلّص هالكاً","غريقاً ينادي قد أحاط بي المكر",30,"ر",1,0],["فَلا شُبهَةٌ تُغوي وَلا لَفحَةٌ تُذوي","أَتى بِالهُدى ما بَينَ فَرضٍ وَسُنَّةٍ",31,"ه",1,0],["فَلا شَكَّ مِن شَكٍّ وَلا شِركَ مِن شِركِ","فَلِلَّهِ صَبٌّ باتَ وَهوَ مُرَرَّقُ",32,"ق",1,0],["فلأشكها عند المليك الطاهر","ابن الأشرف بن الأفضل العباسي",33,"س",2,0],["فلا شلت يداك لقد رأينا","بها أسد الشرى وانقلبت نعاجا",34,"ج",2,0],["فلا شويطئك الرمليّ اطرَبني","كلا ولا موجه الفضي وأساني",35,"ن",2,0],["فلأشكرنها ما حييت لياليا","قاضي القضاة اليوم من حسناتها",36,"ت",3,0],["فَلَأَشكُرَنَّ نَداهُ شُكرَ الرَوضَةِ","الغَنّاءِ مُنهَلَّ الغَمامِ الساكِبِ",37,"ب",1,0],["فَلّأَشكُرَنَّ نَداكَ ما","غَنّى الحَمامُ وَطَرَّبا",38,"ب",2,0],["فَلاَ شَكَّ عِنْدِي مِنْ فَيْضِهِ","عَلَيْنَا إِذَا مَا نَوَيْنَا الرَّحِيلْ",39,"ل",1,0],["فلا شرفٌ فوقَ الذي نلتُهُ ولا","كلامٌ لوَصفِ النَّعمةِ العلوية",40,"ه",1,0],["فلا شرفٌ إِلا بجُنديّةٍ غَدت","كفرضٍ من الإسلامِ والفرضُ لازِم",41,"م",1,0],["فلا شرائعَ إلا عنكِ مأخذُها","وفي اللغاتِ كثيرٌ من عطاياك",42,"ك",1,0],["فَلا شَكَّ أَنَّ السُّمْرَ شَكّاً تُبيتُهُم","وَلا رَيْبَ أَنَّ البِيضَ تُفْنِيهِمُ بَرْيَا",43,"ي",2,0],["فَلأَشْكُرَنَّكَ ما تَغَنّى تائِقٌ","طَرِبٌ وَما دَعَتِ الْحَمامُ هَدِيلا",44,"ل",2,0],["فَلا شَفَّها ما شَفَّنِي يَوْمَ أَعْرَضَتْ","صُدُوداً وَزُمَّتْ لِلتَّرَحُّلِ نُوقُها",45,"ق",3,0],["فَلَأَشكُرَنَّ فُضولَ نَعمَتِهِ","حَتّى أَموتَ وَفَضلُهُ فَضلُ",46,"ل",1,0],["فَلا شَكَرنَ هَناءَهُ وَوَلاءَهُ","ما اِهتَزَّ غُصنٌ أَو تَغَنّى عَندَليب",47,"ب",1,0],["فَلا شُكرَ عِندي سِوى ما رَهَن","تُ عِندَ الكَريمِ اِبنِ عَبدِ الكَريمِ",48,"م",1,0],["فلأشكُرَنّ جزيلَ أنعُمِه","ويفوقُ كُفْرُ النِّعمةِ الكُفرا",49,"ر",2,0],["فلأ شكُرنَّ على دُنُوِّ الدراما","توليه من حظٍ ومن إسنانه",50,"ا",3,0],["فلأَشكُرنّكَ ما صنَعْتَ مُواصِلاً","شُكْرَ الرّياضِ صنائعَ الأنواء",51,"ا",2,0],["فلا شرفٌ إلّا وفيها مكمَّلٌ","ولا كاملٌ إلّا وفيها مشرَّف",52,"ف",1,0],["فَلا شَيء إِلّا أَنَّهُ بَعد أَنَّةِ","وَلَيسَ ببدع أَن يَئنَّ جَريح",53,"ح",1,0],["فَلأَشكُوَنَ ظَلامَتي","لِجَناب عَدل مُنصف",54,"ف",1,0],["فَلا شَيءٌ سِوى نَفسٍ خَفيٍ","وَدَمع كَإِنهِمال المُزن يَهمي",55,"م",2,0],["فَلأشكُرَنَّكَ شكرَ رَوضٍ ناضرٍ","سمحَ الغَمامُ له بغَيْثٍ باكرِ",56,"ر",1,0],["فلأشكرنّ نوالَها أبداً","شكر الرياض لهاطِلِ الدِيَمِ",57,"م",1,0],["فلأَشكُرَنَّكَ أَوْ تَجِيءَ مَنِيَّتِي","ولأَرْجُوَنَّكَ أَوْ يُحَمَّ حِمامي",58,"م",2,0],["فلا شاءَ دهرُكَ مَا لا تشاءُ","ولا رامَ شانِيكَ مَا لا تَرُومُ",59,"م",1,0],["فلا شكروا فضلَ العتاب فإنه","فُضالاتُ داء الصدر والداءُ يُكظَمُ",60,"م",1,0],["فلا شوقَ إلا بالزيارة يُشتفَى","ولا بُعدَ إلا باللقاء يُزالُ",61,"ل",1,0],["فلا شكرنَّك ما حييتُ ومدَّ لي","هذا البقاءُ سمعتَ أو لم تسمع",62,"ع",1,0],["فلا شاربٌ ظمأ غيرَ دمعٍ","ولا قارع طرباً غير سنّ",63,"ن",1,0],["فلا شكّ في أن حدّ الحسامِ","مما يقامُ بصفحِ المسن",63,"ن",1,0],["فَلأَشكُرَنَّ لَكَ الَّذي أَولَيتَني","شُكراً تَحُلُّ بِهِ المَطِيُّ وَتَرحَلُ",64,"ل",1,0],["فلا شرقية بلغت علاها","ولا غربية في أي حين",65,"ن",1,0],["فلا شك من تلك الجنان لطافة","حريمك عند العقل اقصى واوسع",66,"ع",1,0],["فلا شك انا خير خلق وامته","فليس كمهجور الأحبّة واصل",67,"ل",1,0],["فَلا شَكَّ انَّ الحَيَّ ادنى مَقيلهم","كُناتِر او رِغمان بيضِ الدَوايِر",68,"ر",1,1],["فلأَشكرنّك ما مشتْ بفتىً","قدمٌ وحنّتْ للنّوى إِبِلُ",69,"ل",1,0],["فَلا شَوقَ إِنَّ اليَأسَ أَعقَبَ سَلوَةً","سَواءٌ نَوى مَن لا يُراجَعُ وَالثُكلُ",70,"ل",1,0],["فلا شغل لهن سوى صلاة","وتسبيح بأصوات شجيه",71,"ي",2,0],["فَلا شَغَفَت لي بِالمَكارِمِ مُهجَةً","وَلا عَزَّ آبائي وَلا طابَ مُحتَدي",72,"د",2,0],["فلا شمساً يَرون ولا حَميماً","ولا غَسّاقَ بين الزمهريرِ",73,"ر",1,0],["فلا شِدَّةٌ تُعديكَ إلّا لَجاجةً","ولا فَتْرَةٌ تُجديكَ إلّا تَمادِيا",74,"ي",2,0],["فَلا شَيء إِلّا قَد يُقيم دَليلَهُ","فَإِمّا بِنَصِّ العقلِ أَو بِالنقولِ",75,"ل",1,0],["فلا شَمِتَ الاعادي في شبيبٍ","ومن قاسى ومن بالسرو غارا",76,"ر",2,0],["فلا شكرنه ما حييت وإن أمت","فلتشكرنه في ثراي الأعظمُ",77,"م",1,0],["فلأَ شكرنَّ غيوث نعماك التي","هطلت فأضحت للغيوث فواضحا",78,"ح",2,0],["فلاشكرنك ما ندوت بمجلس","وإذا خلوت مضت بذكرك خلوتي",79,"ت",2,0],["فلأشكرنك ما همت منهلَّة","سحب وما هتف الحمام الصادحُ",80,"ح",1,0],["فلأشكرنك في المحافل دائما","شكر الرياض لصوب كل غامِ",81,"م",1,0],["فلا شمم الفجر يذكر فيه","نشيء ولا عربدات الضياء",82,"ا",2,0],["فَلا شَوق حَتّى لا تَرى لي زَفرة","وَلا وَجد حَتّى لا تَسيل دُموع",83,"ع",1,0],["فَلأشكُرَنَّ