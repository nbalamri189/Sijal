bi.ae/diwan/poem/131342","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40134","المتقارب"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44915","المتقارب"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143835","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119597","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119627","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93253","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123521","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90801","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90834","الطويل"],[4225,"","https://poetry.dctabudhabi.ae/diwan/poem/143359","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35055","السريع"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72404","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76767","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104929","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35147","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4782,"سلِّم على قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=202631",""],[4816,"سابق الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=8469",""],[3749,"وليلة الربوة الشماء معلمة","https://www.poetsgate.com/ViewPoem.aspx?id=134972",""],[5167,"تغيب الخلق عن عيني سوى قمر","https://www.poetsgate.com/ViewPoem.aspx?id=181116",""],[5183,"سَيْفُ الْلّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186452",""],[5294,"وعود زمانى","https://www.poetsgate.com/ViewPoem.aspx?id=106859",""],[5335,"اطعن","https://www.poetsgate.com/ViewPoem.aspx?id=35185",""],[5431,"بروحه احتشدا","https://www.poetsgate.com/ViewPoem.aspx?id=213694",""],[5518,"إلى متى أنتَ باللذاتِ مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=187371",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5847,"يمشي على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=1320",""],[5939,"باربي","https://www.poetsgate.com/ViewPoem.aspx?id=180017",""],[6085,"كامل الزين","https://www.poetsgate.com/ViewPoem.aspx?id=8676",""],[231,"العود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79153&r=&rc=27",""],[463,"ألاَ من مبلغٌ أسدا رسولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59979&r=&rc=35",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[572,"حَسْبِي مِنَ اللهوِ وآلاَتِ الطَّرَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9168&r=&rc=25",""]],"verses":[["مُحَلِّقاً يَبلُغُ مِنها غايَةً","لَو رامَها العَيّوقُ ما اِستَطاعَها",0,"ع",3,0],["مَحلُ البِلادِ وَلا جارٌ تَغَصُّ بِهِ","يَضوي الفَتى وَيَكونُ العامُ مَمطورا",1,"ر",2,0],["مَحَلٌّ لِلكَواعِبِ فيهِ مَغنىً","أَطابَ تُرابَهُ المِرْطُ اليَديُّ",2,"ي",1,0],["محَلَّكَ بالدُّنْيا وبالدّينِ معْمورُ","فشانِيكَ مخْذولٌ وراجيكَ منْصورُ",3,"ر",1,1],["مَحَلٌّ لسُعْدَى والزّمانُ مُساعِدٌ","وجَفْنُ اللّيالي لا يَريمُ هُجودُه",4,"د",2,0],["مَحَلُّ اِرتِياحٍ يُذكِرُ الخُلدَ طيبُهُ","إِذا عَزَّ أَن يَصدى الفَتى فيهِ أَو يَضحى",5,"ح",2,0],["مَحَلٌّ غَنَّينا بِالتَصابي خِلالَهُ","فَأَسعَدَنا وَالحادِثاتُ نِيامُ",6,"م",1,0],["مَحَلَّ أَخي بَني أَسَدٍ قَنَونا","إِلى يَبَةٍ إِلى بَركِ الغِمادِ",7,"د",1,0],["مَحَلَّ الحِواءَينِ الَّذي لَستُ ذاكِراً","مَحَلَّهُما إِلاّ غُلِبتُ عَلى الصَدرِ",8,"ر",1,0],["محلّ اصطياف الأغنياء من الورى","يعيش عزيزاً فيه من ذلّ فلسه",9,"س",2,0],["محلّ به تهفو القلوب من الأسى","فإن زرتَه فاربط على القلب باليد",10,"د",1,0],["مَحَلُّ الحَيِّ إِذ أَمسَوا جَميعاً","فَأَمسى اليَومَ لَيسَ بِهِ أَنامُ",11,"م",1,0],["مَحلُوقَةَ الرأسِ لا تَجَرَّدُ بال","حُسنِ ولا بالحَياء تأتَتِبُ",12,"ب",1,0],["محلوقة الرأس لا تجرّد بالحسن","ولا بالحياء تتئب",13,"ب",1,0],["مُحَلَّثونَ فَأَصفى شُربِهِم وَشَلٌ","عِندَ الوُرودِ وَأَوفى وُدِّهِم لَمَمُ",14,"م",1,0],["مَحَلُّكَ الجَوزاءُ بَل أَرفَعُ","وَصَدرُكَ الدَهناءُ بَل أَوسَعُ",15,"ع",1,1],["مَحَلُّهُمُ دارُ البَوارِ وَرَأيُهُم","إِذا نابَهُم أَمرٌ كَرَأيِ البَهائِمِ",16,"م",1,0],["محلّ ترى فيه جوامعَ لذَّةٍ","بها تخطب الأطيار والقضب تركع",17,"ع",1,0],["محلُّ الشيمة الهَجْنى","وأهل اللغة اللَّكنى",18,"ن",2,0],["محلٌّ ما ترى إلا صريعاً","به ملقىً وذا خدٍّ تَريبِ",19,"ب",1,0],["محلُّ صدقٍ يحل فيه","أهل السعادات والفلاحِ",20,"ح",1,0],["محلاً إذا وافاه للرِّفد وفده","رأى خير معمورٍ وأفضل عامر",21,"ر",1,0],["محلولكٌ أحسب ديباجَه","أسففتَه من حُمَم القِدرِ",22,"ر",1,0],["مُحَلِّقَةٍ مِنها العُيونُ كَأَنَّها","قَلاتٌ ثَوَت فيها مَطائِطُها الخُضرُ",23,"ر",1,0],["مَحَلُّهُم مِن بَني تَيمٍ وَإِخوَتِهِم","حَيثُ يَكونُ مِنَ الحِمارَةِ الثَفَرُ",24,"ر",1,0],["مَحَلُّكَ مَقصودٌ وَشانيكَ مُفحَمُ","وَمِثلُكَ مَفقودٌ وَنَيلُكَ خِضرِمُ",25,"م",1,0],["محلَّى بأوفاضِ النجوم معلَّقٌ","عليه هلالُ الأُفقِ في موطئِ النعلِ",26,"ل",1,0],["مَحَلٌّ عَلى القاطولِ أَخلَقَ داثِرُه","وَعادَت صُروفُ الدَهرِ جَيشاً تُغاوِرُه",27,"ر",2,1],["مَحَلٌّ يَطيبُ العَيشَ رِقَّةُ لَيلِهِ","وَبَردُ ضُحاهُ وَاِعتِدالُ أَصيلِهِ",28,"ل",2,0],["مَحَلَّتُنا وَالعَيشُ غَضٌّ نَباتُهُ","وَأَفنِيَةُ الأَيامِ خُضرٌ ظِلالُها",29,"ل",3,0],["مُحَلِّقَةً يُنبي عَنِ النَصرِ نُطقُها","وَقَبلَكَ ما قَد كانَ طالَ وُجومُها",30,"م",3,0],["مُحلِّقةٍ يكِلُّ الطَّرفُ عَنها","إذا ما الطَّرفُ حاولَ مُنتهَاها",31,"ا",3,0],["مَحَلُّ قَومٍ ينوبُ الدَّهرَ جُودُهُمُ","عَنِ السَّحائبِ إن ضنَت هَوامِيها",32,"ي",3,0],["مَحَلُّكَ مثلُ الغابِ ليسَ يُرامُ","وجارُك مثلُ النجمِ ليسَ يضُامُ",33,"م",1,1],["مَحَلٌّ تَرتَعُ الآمالُ فيه","مدى الأيَّامِ في ظِلٍّ ظَليلِ",34,"ل",1,0],["مَحلُّكَ من وَصْلِ الأحبَّةِ آنسُ","وغُصنُكَ من ماءِ الشّبيبَةِ مائِسُ",35,"س",1,1],["مَحلُّكَ الغابُ يحمي اللَّيثَ حَوزَتُه","فإن خَلا منه يوماً فهو مَجذُورُ",36,"ر",1,0],["مَحلُّ الهَوى العُذريِّ في غَيرِ حِلَّةٍ","وعَهْدُ الشَّبابِ الغَضِّ في غَيرِ مَعهَدِ",37,"د",1,0],["مُحَلِّقٌ في كَبِدِ السَّماءِ","وتارةً يَلصَقُ بالغَبراءِ",38,"ا",2,0],["مَحَلٌّ ما عَلَيهِم في","هِ أَردِيَةٌ وَلا حُجَرُ",39,"ر",1,0],["مَحَلٌّ بِهِ الأَقوامُ وَيحَكَ تَستَوي","فَصيدٌ كِرامٌ سادَةٌ وَنَبيطُ",40,"ط",1,0],["مَحَلُّ الرَدى في سَيفِهِ وَسِنانِهِ","وَبَحرُ النَدىفي كَفِّهِ وَالبَراجِمِ",41,"م",1,0],["مُحلّقَةٌ في الجوّ منه قشاعمٌ","كأنَّ شراراً حشْوَ أعيُنِها الخزرِ",42,"ر",1,0],["مُحَلَّقي أَرْؤُسٍ يدَتْ وُجُوهُهُمْ","حُسْناً بهِ فكأنَّ الحَلْقَ تَرْجِيلُ",43,"ل",1,0],["مَحَلٌّ لَيسَ يَعدَمُني","بِهِ ذو غُمَّةٍ جَحِدُ",44,"د",1,0],["مَحَلَّتُهُم ذاتُ الإِلَهِ وَدينُهُم","قَويمٌ فَما يَرجونَ غَيرَ العَواقِبِ",45,"ب",1,0],["مَحَلُّ الجِسمِ في الغَبراءِ ضَنكٌ","وَلَكِن عَفوُ خالِقِنا رَحيبُ",46,"ب",1,0],["مَحَلّي إِن جَلاني عَنكَ خَطبٌ","فَمِن خَطَأي تُراحُ وَمِن خَطايا",47,"ا",3,0],["مُحَلّى البُرْدِ تَحْسَبُهُ تَرَدَّى","نُجُومَ اللّيْلِ وانْتَعَلَ الهِلالا",48,"ل",2,0],["مَحَلٌّ بأرضِ الشامِ يطْرُدُ أهْلَه","ولكنّهمْ عمّا يقولُ نِيامُ",49,"م",1,0],["مَحلٌّ تحُلُّ عُراها السَّحابُ","وتحكي الجنوبُ عليه الشَّمالا",50,"ل",2,0],["محلة النفسِ فيهم أَينَما قَطنوا","ومنزِلُ الروحِ فيهم حَيثُما كانوا",51,"ن",3,0],["مَحَلُوا مَحلَهُم لِصَرعَتنا العا","م فقد أَوقَعُوا الرَّحَى في الثِّقَالِ",52,"ل",1,0],["مَحَلٌّ لِعَيني دَمعُها وَسُهادُها","وَحُرمٌ عَلى جَنبي الأسرّةُ وَالفرشُ",53,"ش",1,0],["مَحَلُّ مَن ماتَ لَيسَ يَلوي","بِهِ وَصولٌ عَلى وَصولِ",54,"ل",1,0],["مُحَلِّق بفكره، جوَّاب","في المُلك مُلْك سيد الأَرباب",55,"ب",1,0],["محل تجلي الحق مشكاة نوره","له وسعت اذ لم تسعه العوالم",56,"م",1,0],["مَحَلوا مَحلَهُم لِصَرعَتِنا العا","مَ فَقَد أَوقَعوا الرَحا بِالثِقالِ",57,"ل",1,0],["محل الندى والمجد بحبوحة الهدى","وبيت علوم الدين والحال والسر",58,"ر",1,0],["محل عناية الرحمن مجرى","ندا الرحموت مفتاح الغيوب",59,"ب",1,0],["مَحَلِّ الأمينِ المُرتَضَى خيرِ سيِّدٍ","مِن الناس مَن لاَ يَمنعُ الناسَ رِفدَهُ",60,"د",2,0],["مَحَلَّةُ الأَمنِ لا خَوفٌ يُمازِجُها","وَمَوطِنُ العَيشِ ما في صَفوِهِ كَدَرُ",61,"ر",1,0],["مَحَلٌّ لَهُم بَينَ النَقا وَالأَجارِعِ","عَدَته