{"poems":[[119,"اهلا بهذا الاهيف البسام","https://www.aldiwan.net/poem40490.html","عموديه"],[262,"ما للموله من سكره لا يفيق","https://www.aldiwan.net/poem2656.html","المجتث"],[463,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116095",""],[4820,"....قُبلةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175611",""],[4859,"أضغاث أحلام!","https://www.poetsgate.com/ViewPoem.aspx?id=208817",""],[4927,"ارحل يا بلطجي","https://www.poetsgate.com/ViewPoem.aspx?id=79604",""],[4929,"عيناك في قنص القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=199387",""],[5219,"الرجولة موقف","https://www.poetsgate.com/ViewPoem.aspx?id=193709",""],[5219,"أوهام وأوهام","https://www.poetsgate.com/ViewPoem.aspx?id=194031",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5411,"في الْقَلْبِ مُتَّسَعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194859",""],[5510,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215370",""],[5725,"الحاضرون","https://www.poetsgate.com/ViewPoem.aspx?id=210514",""],[5853,"كلاسيكية على جدار التجريد","https://www.poetsgate.com/ViewPoem.aspx?id=175721",""]],"verses":[["اضغاث احلام وجود شخوصنا","فارقب اقلب حوادث الايام",0,"م",1,0],["أَضغاثُ فِكرٍ تَحدو بِهِ وَتَسوق","هذِهِ الأَلحان",1,"ن",1,0],["أضغاثُ ليلٍ ضاحكت بروقُها","حقيقةَ الصبح ومن نام حَلَمْ",2,"م",1,0],["اضغاث أحلام نظيرك في الدنا","حلما بموضعه يفوق الاحنفا",3,"ف",2,0],["أضغاث أحلامكم كادت تؤولها","آمالكم بحديث ضل رافعه",4,"ع",2,0],["أضغاثُ أحلام أتتني في الهوى","من ذا يشي لليلِ عنها .. تنجلي",5,"ل",2,1],["أضغاثُ أحلامٍ وهل","للحلم وقعٌ أو صدى!",6,"د",2,0],["أَضْغَاْثُ أَحْلاْمٍ مَضَتْ","خَدَعَتْكَ، \\\"وَالْفِلْمُ\\\" اكْتَمَلْ",7,"ل",1,0],["أضغاث أحلامي تزيد تأججا","وسراب وهمي لم تحطه حدودُ",8,"د",1,0],["أضغاث أحلام تطاول عهدها","أمسى اللبيب بأمرها حيرانا",9,"ن",2,0],["أضغاثها عصفت بالخلد ترهقني","من هول ما صنعت لازمت إصماتا",10,"ت",2,0],["أضغاث حلمٍ إذا ترجو ملامحها","عند الصباحِ وقد زالتْ معالمُها",11,"م",3,0],["أَضْغَاثُ أَحْلَامٍ بِها غَبَشٌ","سَيُسِرُّ مَنْ أفْتَى لِمَنْ شَاهُوا",12,"ه",3,0],["أضغاث حزنك يا زمان غريمها ال","إهمالُ ليس القاتلَ الكبريتُ",13,"ت",1,0],["أضغاث حلمٍ أن أراك بل الهوى","سيعيد صبّاً والهوى غلَابُ",14,"ب",1,0],["أضغاثُ أحلامٍ تجول بخاطري","صمتٌ لنعش الموت علّمني الغنى",15,"ن",2,0]]}