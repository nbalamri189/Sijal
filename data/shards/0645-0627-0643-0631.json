{"poems":[[53,"ما كرم اللّه بني آدم","https://www.aldiwan.net/poem61874.html","السريع"],[47,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[48,"جسمي أودى مر السنين به","https://www.aldiwan.net/poem23186.html","المنسرح"],[108,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[182,"عذراً يا شعر","https://www.aldiwan.net/poem50707.html","أحذ الكامل"],[287,"جاء الربيع وروضه الممطور","https://www.aldiwan.net/poem32758.html","الكامل"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[463,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[519,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[549,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48689","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93702","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138705",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94617","البسيط"],[5039,"المسامح كريم","https://www.poetsgate.com/ViewPoem.aspx?id=48114",""],[5136,"ما كريم من لا يقبل عثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=121492",""],[5136,"ما كريم من لا يقيل عثارا","https://www.poetsgate.com/ViewPoem.aspx?id=121793",""],[5461,"بنت الكحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=5038",""]],"verses":[["ما كرَّم اللّه بني آدمٍ","إذ كان أمْسى منهمُ خالدُ",0,"د",1,1],["ما كَرِهتُ الغِنى لِشَيءٍ وَلَكِن","ساوَرَتني نُعماكَ مِن فَوقِ قَدري",1,"ر",2,0],["ما كَرَّ جيشُكَ قافِلاً حتى خَلَتْ","تِلكَ الهِضابُ مُنِيفَةً والأجبُل",2,"ل",1,0],["ما كَرِهَت مَأثَماً وَلا فَعَلَت","خَيراً وَعادَت مُسيئَةً جَدِلَه",3,"ل",2,0],["ما كريمُ الأَحْجَار درٌّ يتيمٌ","لاَحَ فوق النُّحورِ واللَّبَّات",4,"ت",1,0],["ما كَرَّ قومي إنما أفَلوا","لا عِزَّ للفُرّارِ في الوَهَلِ",5,"ل",1,0],["ما كَرَّ إِلّا قالَتِ الأَقيالُ في","يَومِ الوَغى بكرورُ يا مَنصورُ",6,"ر",1,0],["ما كرهتَ الأقدارَ قطُّ ولو جا","ءت ببؤسَى ولا ذممتَ القضاءَ",7,"ا",2,0],["ما كرّ يوم المِهرَجانِ وأرت","ليلةَ عيدٍ من هلالٍ نونا",8,"ن",2,0],["ما كرَّ يومٌ عائد بصباحه","ورواحه من مغرِبٍ أو مَطلعِ",9,"ع",1,0],["ماكرَّ يومُ المهرجان وطَرَا","وصامَ ذو شهادةٍ وأفطَرا",10,"ر",2,0],["ما كرَّ عَوْداً شبابُ ليلٍ","يَردُفُهُ من ضُحىً مَشيبُ",11,"ب",1,0],["ما كرَّ في جيشهِ مِهْراجُ طرّته","على سَنا البدرِ إلّا فرّ قيصَرُهُ",12,"ر",2,0],["ما كَرَّرَتْني في هواكِ سلالتي","فالحبُّ مثلُ الرُّوحِ لا يَتَكَرَّرُ",13,"ر",1,0],["ما كرَّم الشعراءَ أنّك شاعرٌ","حتى أجلتك الملوك سفيرا",14,"ر",2,0],["ما كرَّ ذو بَأس لَهُ متقدِّماً","إِلا وَفَرَّ وَرَأسُهُ المتقدِّم",15,"م",1,0],["ما كررت ذكراهم إِلا عَلَت","زَفراته بِتنفس الصُعداء",16,"ا",2,0],["ما كرت الأبطال الا انثنت","تندك رعباً من ملاقاتها",17,"ت",3,0],["ما كرَّ صبحٌ على ليلٍ وما طلعت","شمس النهار وما حادي النياق سرى",18,"ر",2,0],["ماكره طول عمره لا ولا له خصيم","ولا عرف حي ٍ إلا حبه بلا سبايب",19,"ب",1,0],["ما كريم من لا يقبل عثاراً","لكريم ويستر العوراء",20,"ا",2,1],["ما كريم من لا يقيل عثارا","لكريم ويستر العوراء",21,"ا",2,1],["ماكر حرار ديرتي","ما في هل العوجا ذليل",22,"ل",1,0]]}