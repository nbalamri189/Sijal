لنّهر","https://www.poetsgate.com/ViewPoem.aspx?id=214735",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[5459,"رفقا به..","https://www.poetsgate.com/ViewPoem.aspx?id=191935",""],[5526,"الياس","https://www.poetsgate.com/ViewPoem.aspx?id=192390",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[5615,"راجي الوصل .....!","https://www.poetsgate.com/ViewPoem.aspx?id=192205",""],[5648,"شموخ ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=154830",""],[5652,"ماغير صوتك لا ندهني ولبيت","https://www.poetsgate.com/ViewPoem.aspx?id=136695",""],[5739,"أرحب يالهلاك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155471",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5916,"َلْبَسْتَنِيْ قَيْدَ الْهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=190589",""],[5956,"الديمقراطية السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=192214",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6093,"ثعالب النقد","https://www.poetsgate.com/ViewPoem.aspx?id=202605",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[6108,"قبل العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=192394",""],[6127,"سقطَ النصيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=198388",""],[6147,"أنا ودليلتي.. والطريق..","https://www.poetsgate.com/ViewPoem.aspx?id=151496",""],[469,"أجنها الفكر وأبداها العبق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574814",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6352,"يابن الإمام العسكريّ وَمن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22742&r=&rc=3",""]],"verses":[["آفَةُ المَرءِ إِذا المَرءُ وَنى","آفَةُ الشَعبِ إِذا الشَعبُ اِنقَسَم",0,"م",1,0],["أفَهَذِي هِيَ البَقِيَّةُ مِنْ شَعْ","بٍ شَدِيدِ القُوَى بَنَى الأهْرَامَا",1,"م",2,0],["أفهذا تمدّن وعلاء","شعبكم يدّعي إليه عروجه",2,"ج",2,0],["أفهكذا تبقى الحكومة عندنا","كلماً تموَّه للورى وتُزخرَف",3,"ف",1,0],["أفهلّا انتظرْت تصحيحك الدع","وةَ في القومِ طرْتَ قبلَ ارتياشِك",4,"ك",1,0],["آفَةُ الحُبِّ أَنَّهُ","في قُلوب وَأَكبُدِ",5,"د",1,0],["أَفَهمي إِنَّ الصَبرَ أَليَقُ بَِلفَتى","وَلا سِيَّما مَن كانَ مِثلَكَ سَيِّدا",6,"د",2,0],["أَفهَمُ مِن طَيِّبِ أَنفاسِها","عِبارَةً عَنكَ هِيَ العَنبَرُ",7,"ر",1,0],["أفهل دهاك كروم","حتى كأنك بطرس",8,"س",1,0],["آفة النصح أن يكون جدالا","واذى النصح أن يكون جهارا",9,"ر",2,0],["آفَةُ النُصحِ أَن يَكونَ لَجاجاً","وَأَذى النُصحِ أَن يَكونَ جِهارا",10,"ر",2,0],["إِفهَم أَبا العَبّاسِ غَيرَ مُفَهَّمٍ","قَولاً يَشيدُ أَساسَهُ الإِحكامُ",11,"م",1,0],["إفهموني.. فما أنا غير طفلٍ","فوق عينيه يستحم المساء",12,"ا",2,0],["أَفهَقتَ حَتّى البَحرُ يُدعى جَدوَلاً","وَأَضَأتَ حَتّى الشَمسُ تُدعى كَوكَبا",13,"ب",2,0],["اِفهَم فَدَيتُكَ بَيتاً سائِراً مَثَلاً","مِن أَوَّلٍ كانَ يَأتي بِالأَعاجيبِ",14,"ب",1,0],["أَفهِم أَخاكَ بِما تَشاءُ وَلا تُبَل","يا حارِ قُلتَ هُناكَ أَو يا حارُ",15,"ر",1,0],["اِفهَم عَنِ الأَيّامِ فَهيَ نَواطِقٌ","مازالَ يَضرِبُ صَرفُها الأَمثالا",16,"ل",2,1],["آفَةُ الفَنِّ جَهْلُهُ كَيْفَ","وَالأَعْلاَمُ تُطْوَى مَا بَيْنَ جِيلِ فَجِيلِ",17,"ل",1,0],["آفَةُ أَموالِنا الرَزايا","وَآفَةُ العالمِ الفَناءُ",18,"ا",2,0],["أفهذه عقبى النذ","يرِ وتلك آخرة الوعيد؟",19,"د",1,0],["أفهذا نسلُ الشياطينِ والشيطانُ","لم يَرْبُ في دُموع المآتم",20,"م",1,0],["أفَهذا قصرُ \" فَرهادِ \" الذي","جمعته مع \" شيرينَ\" المَنون",21,"ن",1,0],["( أفهمي ) إنّ الصبر أليق بالفتى","ولا سيما من كان مثلك ( سيّدا )",22,"د",2,0],["آفَةُ العِزِّ الترَدِّي في هَوىً","فَشَلُ القَومِ إِذا كَانَ الفَشَل",23,"ل",1,0],["أَفَهَل ظَفِرتَ بِمَن جَرى في ذا المَدى","مُذ قامَ بِالإِحسانِ فيهِم قَيِّمُ",24,"م",1,0],["أَفْهمَتْني على قُحولِ رُباها","فكأني قرأتُ منه سطورا",25,"ر",2,0],["آفةُ العالمِ أن لا يعملا","وشقا الجاهلِ أن لا يسالا",26,"ل",2,1],["أ فهذي مصر أم ماذا أرى ؟","أمة أخرى وشعب منقلب !",27,"ب",1,0],["آفةُ العَقلِ أن يرى الحمدَ ذَماً","ويرى الخُطَّةَ الدنيئة حمدا",28,"د",2,0],["أَفهَل يجملُ مِن ذي نُهيةٍ","أثرةُ الدنيا وَتسويفُ الأخيرَه",29,"ر",2,0],["أفهمتِ انك تفهمين","يا نفس قد ذكرتني",30,"ي",1,0],["آفةُ الدِّرْهَمِ العِمارَةُ عَافَى اللَّ","هُ مِنها وَآفَةُ الدِّينارِ",31,"ر",1,0],["أفَهَلْ بَقي عُذرٌ لِمَنْ عَرفَ الهدى","ثُم انْثَنَى عَنْ نَهجهِ وتغيّرا",32,"ر",2,0],["أفهامُ أهلِ الفَهمِ إن قِستَها","دوائرٌ فهمُكَ فيها نُقَطْ",33,"ط",1,1],["أفهمتني على نحولِ رباها","فكأنّي قرأتُ منها سطورا",34,"ر",2,0],["أفهمني وحيَ الغرام ومضهُ","والشأن أن يفصح ثغرٌ ما نطقْ",35,"ق",1,0],["أفَهذِه ِلُغَة ُ العَدالَة ِمُصطَفى","جاءوا بِها لِيُقَوِّموا ، وَيُحَرِّروا؟",36,"ر",3,0],["أفهمتها الشعر حتى تستفز به","حر الضمير ليعط الفضل داريه",37,"ي",2,0],["أفهمت شعبك معنى الإعتصام به","فاصدع بأمرك إن القوم قد فهموا",38,"م",3,0],["أَفَهَل دَرى قبرٌ بهِ الهادي ثوى","مَن ذا الّذي بِضريحهِ مقبورُ",39,"ر",1,1],["أفهذا حال محسو","ب قد استوثق ودّك",40,"ك",1,0],["أفهمتَ ما ألقى الركابُ المدْلج","والزُّهرُ يُخفيها الصباح المبهج",41,"ج",1,1],["افهمتهم يومَ جَدَّ البَينُ بينَهُمُ","لو كان فيهِم غداة البَينِ مَن فَهِما",42,"م",2,0],["آفَةُ السِرِّ مِن جُفو","نٍ دَوامٍ دَوامِعِ",43,"ع",1,1],["أفهل ترى في بال مولاي الذي","قد قاله أو زال من بحر الفكرْ",44,"ر",1,0],["افهل ترى ما تدّعيه بنفسها","جدٌّ وليست في المقال بمهزلَهْ",45,"ل",2,0],["آفَةُ الْعَقْلِ طاعَةُ الأَهْواءِ","فَاعْصِها ما اسْتَطَعتَ شَمَّ الهَواءِ",46,"ا",2,1],["أفهل درت أم العلى ان ابنها","فاق الورى رغماً على عذاله",47,"ل",2,0],["أفهل نبقى كما تُبصرُنا","نُنفِذ الأيامَ والصبر رَجاءا",48,"ا",3,0],["أفهل أذودُ الحادثات بكفّي ال","جذاء أم بحساميَ المغمود",49,"د",1,0],["أفهكذا تُغضي وأنت ترى","نارَ الوباءِ تشبُّ ملتهبه",50,"ب",2,0],["آفَةُ الحلمِ والنُهى رجعُها الطَر","فَ وأن تُمسِكَ الرداءَ اليدانِ",51,"ن",1,0],["أفهمت ما قالت لنا الورقاءُ","قالت لنا أن الصبابة داءُ",52,"ا",2,1],["آفَةُ الشَرقِ اِهتِضامُ الضُعَفاءِ","وَهَوى الظُلمِ وَإِرهاقُ العِبادِ",53,"د",1,1],["أفهل كان ذلك الرمي نسكاً","أي نسك دعا إلى مرماها",54,"ا",3,0],["أفهل جاء حتفها عن سواه","أوَليس الإعجاز في إحياها",54,"ا",3,0],["أفهل عاقد الإله البرايا","للتساوي أو أنه صافاها",54,"ا",3,0],["أفهل راقبت أباها وهلا","راقبت بابنة النبي أباها",54,"ا",3,0],["أفهل ساءه إذا أسلموه","لو دعت غب أمرها لأساها",54,"ا",3,0],["أفهل بعد ذا لنيل المعالي","غاية صانع امرىء لارتقاها",54,"ا",3,0],["أفهل زعم أنهم هاشميو","ن دواع كون شر علاها",54,"ا",3,0],["أفهل كان في العوالم شيء","متوار بالغيب عن مرآها",54,"ا",3,0],["أفهل واصف من الشمس شيئاً","قايل أنْ يقول ما أسناها",54,"ا",3,0],["افهل وعدتك في مزخرف قولها","وصلا فبت ودمعك المستعبر",55,"ر",1,0],["أفهل أهنيه بعزمته التي","جاءت به نحو الغري تقود",56,"د",1,0],["أَفَهَلْ فَتىً فَطِنٌ لديه دلائِلٌ","يجلو بها ظُلَمَ الشكوك فهاتِها",57,"ت",3,0],["أَفَهَلْ فَتىً فَطِنٌ لديه بصائِرٌ","غير البصائر في القريض فهاتِها",58,"ت",3,0],["افهل من وسيلة أو سبيل","للتوقي اوسد ذاك المصب",59,"ب",1,0],["أفهل علمت بقتل سبط محمد","فلبست من حزن عليه سوادا",60,"د",2,0],["أفهل سواك مؤمل يدعى به","فيجيب داعية ويورق عودا",61,"د",2,0],["افهم كلامي فإنَّ الفهم اسعدكم","ولا تحد عنه إنَّ العلم قد جمعا",62,"ع",2,0],["أفَهَل يَمُوتُ الرُّسلُ أم يَبقَوا إذَا","مَاتَ الوَرَى أم هَل لَكُم قَولاَنِ",63,"ن",1,0],["أفهل ترى في الكونِ من مثلٍ لهم","ولِنوره بهُم المُهيمنُ مثَّلاً",64,"ل",2,0],["افهل من الإنصاف أضحي معطشا","وَحياضكم فيها الفُرات السَلْسَلُ",65,"ل",1,0],["أفهل نظمت لئالئا من أدمعي","سمطين حول رضابك المعسول",66,"ل",1,0],["أَفهل تَرى وَجه امرئ ما غادرت","لَطمات نائبة عَليه ندوبا",67,"ب",2,0],["افهل يدري غداة نأي","اودع الاحشاء في ضرم",68,"م",1,0],["أفهل بها قعدت حميتها وكم","هذا القعود وقد أذل رقابها",69,"ب",3,0],["أفهل بعد ذا يلم بمعنى","من علاك الإيجاز والأطناب",70,"ب",1,0],["أفهّمه حتى أقول أراحني","ولكن الى عين السخافة يرجع",71,"ع",1,0],["أَفهل يرام مَقام والد أَسعد","علم الهُدى وَمَناره وَزِناده",72,"د",2,0],["أَفهل تَعود لَنا وَانشق في الضُحى","طيب المَكان بِغفلة الرقباء",73,"ا",2,0],["أَفهل تَعود لَنا المَسرة عاجِلاً","يَوماً وَأسمح بَعده بِبَقاء",73,"ا",2,0],["أفهل تنال الشمس وهي بعيدة","أم هل تقل السيف كف تحسم",74,"م",1,0],["أفهذا الحق الالهيُّ أن يق","تل شعبٌ أتاك لاسترحام",75,"م",1,0],["أفهل يفرق من يموت إذا قضى","خمسين أو ألفا من الأعوام",76,"م",1,0],["أفهكذا أبقى إلى أجل","إن لم يجيء يوما فسوف يجي",77,"ي",1,0],["أفهل سواه لقصد مكرمة","يرجى فيأمله أخو قصد",78,"د",1,0],["أفهمتنا فنقت بالإِفهام","فاسمع جوابك يا أبا تمام",79,"م",1,1],["أَفَهَل إِلى ذاكَ الرضاب مُعَرِّجٌ","أَم هَل لهاتيكَ اللثاتِ سَبيلُ",80,"ل",1,0],["أفهذا وضع السلام على الأر","ض وهذا تمدن الإنسان",81,"ن",1,0],["أفهل أنت على ما قد مضى","من وثيق العهد أم لست عليه",82,"ه",1,0],["أفهل يفدى اسير هوى","بغرير أغيد يرج",83,"ج",1,0],["أَفهادِمٌ ما قَد بَنَيتَ وَخافِضٌ","شَرَفي وَأَنتَ لِغَيرِ ذلِكَ أَوسَعُ",84,"ع",1,0],["أفهل رأى يحيى إليه أخا وفاً","قطعوا يديه ووسدوه رغاما",85,"م",2,0],["أفهل نسوا ما أحمد قد قاله","بغدير خم أم عتوا واستكبروا",86,"ر",3,0],["اِفهم مطارحَ أَحوالي وما حكمت","بهِ الشواهدُ واِعذُرني ولا تلمِ",87,"م",1,1],["أَفهذِهِ كأسُ الخَلاصِ نَعَم وها","إِنِّي لَأَقبَلُها قَبُولاً يُرتَضَى",88,"ا",1,0],["أَفَهكذا يُجزَى فَتىً","قَد كانَ يَهواكُم فقَط",89,"ط",1,0],["آفة القول جميعاً والعمل","وبلاء الله فيما يخلق",90,"ق",1,0],["أفهذي دنيا نعشقها","لولا رضوان يكفلُهَا؟",91,"ل",3,0],["آفة التقليد مهلكة","تخنق الأسرى بمحبسهم",92,"م",1,0],["أفهكذا كانت طريق مشايخ ال","إسلام أرباب السلوك العادل",93,"ل",1,0],["افهذى ارادة الضعف والقوة","أم ذي ارادة للقدير",94,"ر",1,0],["آفَةُ الدِّينِ الهَوَى فَاحْذَرْ فَمَنْ","أمَّهُ وَاتَّبَعَ الصَّيْدَ غَفَلْ",95,"ل",1,0],["أَفَهَلْ لِوَجْدكَ من مَدَى","يُفْضي إِلَيهِ فَينتظرْ",96,"ر",1,0],["آفَةً أَوجَدَهُ زَفسُ لَنا","عِلَّةً حَتَّى يَزِيدَ الشجَّنَا",97,"ن",2,0],["آفةُ العشَّاقِ منه خُلقٌ","سيءٌ صَعبُ وَخَلقٌ حَسنُ",98,"ن",1,0],["أفَهل على المشتاق من","حدٍ قضاؤك يقتضيه",99,"ي",2,0],["أفهل الآمُ إذا حَبستُ","على المغاني والطلول",100,"ل",1,0],["أَفَهذا ظُلمٌ سَلَ