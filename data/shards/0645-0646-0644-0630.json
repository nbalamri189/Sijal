{"poems":[[55,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[95,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[572,"من لذاك الطبرزذ المسحوق","https://www.aldiwan.net/poem69574.html","الخفيف"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112766","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66317","المقتضب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[5065,"سبحة الإنطواء","https://www.poetsgate.com/ViewPoem.aspx?id=205183",""],[5480,"من لذي بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=1149",""],[572,"من لِذَاك الطبرزدِ المدقوقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9412&r=&rc=269",""]],"verses":[["مَن لَذَّ وِردَ المَوتِ لا","يَصفو لَهُ أَبَداً شَرابُ",0,"ب",1,0],["مَنْ لِذَاكَ النَّثِيرِ فِي وَشْيِهِ الرَّا","ئِعِ حُسْناً وَمَنْ لِذَاكَ النَّظِيمِ",1,"م",1,0],["مَنْ لِذَاكَ الطَّبَرْزَذِ الْمَسْحُوقِ","وَلِذَاكَ اللَّوْزِ الطَّرِي الْمَدْقُوقِ",2,"ق",1,1],["من لذيذ عشقي حلالي","في الهوى شرب ألف غصة",3,"ه",1,0],["من لذليل مذنب","من لفقير قد هفا",4,"ف",2,0],["من لذي الهيام بها","لو تصاب لم يهم",5,"م",1,0],["من لذي جسم عليل نحفا","بالهوى ليت الهوى لم يكن",6,"ن",1,0],["مِن لَذةِ الغَوصِ في حَبَّاتِها سَتَرى","شِهَابَ موسى وَجِبرَائِيلَ والطُّورَا",7,"ر",2,0],["من لذي بالشعر والحدي","باين(ن) فالشعر سلطانه",8,"ن",2,1],["من لِذَاك الطبرزدِ المدقوقِ","ولذاكَ اللّوزِ النّقيّ الأَنيقِ",9,"ق",1,1]]}