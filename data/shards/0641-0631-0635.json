{"poems":[[95,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[119,"لك هل من مسامت او موازي","https://www.aldiwan.net/poem40930.html","عموديه"],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[226,"ذاب قلبي عليه حين تدانى","https://www.aldiwan.net/poem55285.html","الخفيف"],[369,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[406,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[458,"بشراك هذا العم عيسي","https://www.aldiwan.net/poem61242.html","مجزوء الكامل"],[458,"الشكر يجدر أن يمثل عيدا","https://www.aldiwan.net/poem61637.html","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143281","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130204","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63861","الخفيف"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104482","الرمل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128279","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48246","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88635","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93563","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93554","الخفيف"],[2587,"","https://poetry.dctabudhabi.ae/diwan/poem/178145",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100358","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91877","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216821","الرمل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111196","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72372","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104875","الخفيف"],[4702,"مارد وشيطانيه","https://www.poetsgate.com/ViewPoem.aspx?id=155200",""],[4750,"الأزمات","https://www.poetsgate.com/ViewPoem.aspx?id=180409",""],[4987,"قبل اسافر","https://www.poetsgate.com/ViewPoem.aspx?id=49555",""],[5409,"ليس يجدي من الضعيف الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=155309",""],[5542,"أيها العالم","https://www.poetsgate.com/ViewPoem.aspx?id=10056",""],[5829,"اهل الحق","https://www.poetsgate.com/ViewPoem.aspx?id=209027",""],[6032,"عهود الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181520",""],[6079,"أمِن بأسِ الفواجعِ تدمعينا","https://www.poetsgate.com/ViewPoem.aspx?id=208563",""],[6102,"غَنِيمَةُ العُمر !!","https://www.poetsgate.com/ViewPoem.aspx?id=184543",""]],"verses":[["فُرَصُ الْعَيْشِ لِلْجُنُودِ نِهَابٌ","قَبْلَ يَوْمٍ مُعَجَّلٍ مَحْتُومِ",0,"م",1,0],["فرصة العمر وهى ظل فدعنا","ننتقيها باحسن الانتهاز",1,"ز",1,0],["فَرُصّوا وَصُرّوا أَعيُناً أَو فَبَلِّقُوا","فَما نَفخُ حُفّاثٍ لِصلٍّ بِكارِبِ",2,"ب",1,0],["فرّ صَحبٌ إذ أعجَبوا ثمّ عادوا","وَهوَ نحوَ العدا بها عدّاءُ",3,"ا",2,0],["فرصة لو تتح لناسك قوم","لتناسى الى القيامة فرضه",4,"ض",2,0],["فَرصَّع في تُرسٍ هلالاً وأنجُماً","وأغمدَ شَمساً في دُجىً ورَشاكا",5,"ك",2,0],["فَرصَّعْتُ في تاج على الدّينِ درّةً","تَخيّرتُها من بَحْرِيَ المُتَمَوِّجِ",6,"ج",1,0],["فُرَصٌ من التَّوْظيف يُفْتَحُ باَبُه","لشبابنا بكمالها وتمامِ",7,"م",1,0],["فرص النهوض تكافأت","فيه كذرات الغمام",8,"م",1,0],["فُرصُ الحياةِ أمامهَ موفورةٌ","وتكافأت كالنورِ فاضَ وَحيدا",9,"د",2,0],["فرِصافُهُ عظمٌ وقُذَّتُهُ","قِطعُ اللُّجينِ وفُوقُهُ الذَّهبُ",10,"ب",1,0],["فرصعت المرجان فضة نحرها","بدمعي من كف العناق المردد",11,"د",1,0],["فرصةٌ أيُّ فرصةٍ من سرورٍ","نجتنيها وَنُهْزَةٌ أيُّ نُهْزَه",12,"ز",2,0],["فرصة قد امكنت ثم انقضت","ودهاها من صروف البين داهي",13,"ا",3,0],["فرصة في زمانها اغتنمتها","واطمأنت إذ الرفاق نيام",14,"م",1,0],["فُرَصُ الصَّبِّ ممكناتٌ وقد عز","زَ له منه مكْمَنُ الإنتهازِ",15,"ز",1,0],["فرصة امكنت زمانا من الدهر","وَتاللَه ما الزَمان سواها",16,"ا",3,0],["فَرَّصفتها مثل السَبيكة مدحة","عَميق المَعاني لَفظَها وَهُوَ واضح",17,"ح",1,0],["فُرصة لِلشَباب فَاِنتَهَزوها","في زَمان أَعوامه ساعات",18,"ت",1,0],["فرصتك اليوم فاغتنمها","فكلّ وقت سواه فان",19,"ن",1,0],["فرصٌ سرقناها بقربهمُ","فكأنما اوقاتُها قبلُ",20,"ل",1,0],["فُرَصٌ الهَوى سَببٌ إِلى غصص النَوى","لَو يَعلم المجهود جب متاعبه",21,"ب",2,0],["فرصة فيها جمال وصبا","ثم تمضي فإذا الكل سواء",22,"ا",2,0],["فرصة من صباك تذهب قسراً","فانتهزها فلن يعود صباكا",23,"ك",2,0],["فرصع اللثم بالافواه ساحته","وكللتها بدرَّ أدمع المقل",24,"ل",1,0],["فرصة للشباب فانتهزوها","في زمان أعوانه ساعات",25,"ت",1,0],["فرصة لمن يعمل ال","خيرات بايمانيه",26,"ن",3,0],["فرصتي ويقت حرارٍ على ماكر حرار","ما يعوّد فالمكان الربيب الا البعير",27,"ر",1,0],["فرصة العمر قالوا لا غدت ما تجيك","جتني اكثر فرص عمري وضاعت سدى",28,"د",2,0],["فرصةً في زمانها اغتنمتها","واطمأنت حيث الرفاق نيام",29,"م",1,0],["فرصة أن تُعلن الحق ولكن","فرص الحق على الباغي تفوت",30,"ت",1,0],["فرصوا الصف يا أبناء همّ","يوحدُنا إذا عَدَتْ العُداة",31,"ا",2,0],["فرصفتُ أفنان الدروب زبرجدا","يخضرُّ فيءُ رياضِها ويميدُ",32,"د",1,0],["فرصّوا أمّةَ الإسلامِ صَفًّا","وكِيدوا فوقَ كيد الكائدينا",33,"ن",2,0],["فُرَصُ الحَياةِ غَنائِمٌ مَقدُورَةٌ","يَحظَى بِها الأَقوَى وَلَيسَ الأَحوَجُ",34,"ج",1,0]]}