{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[55,"لهذه كان الزمان ينتظر","https://www.aldiwan.net/poem30211.html","الرجز"],[45,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140826",""],[376,"من حائم ملتهب الغله","https://www.aldiwan.net/poem56991.html","السريع"],[438,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70863","السريع"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130640","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69399","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69371","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36499","الدوبيت"],[4858,"إلى روح الشهيد سيد قطب","https://www.poetsgate.com/ViewPoem.aspx?id=29820",""]],"verses":[["لَولا ظِباءٌ مَعاطيلٌ سَنَحنَ لَنا","ما كانَ يَذهَلُ عَن عَقلٍ وَعَن دينِ",0,"ن",1,0],["لَولا ظُبى سَيفِكَ في صُدورِها","لَما نَهى فيها الرَدى وَلا أَمَر",1,"ر",1,0],["لَولا ظِباءُ عَدِيٍّ ما شُغِفتُ بِهِم","وَلا بِرَبرَبِهِم لَولا جَآذِرُهُ",2,"ر",2,0],["لولا ظباء عديٍّ ما شقيت بهم","ولا بربربهم لولا جآذره",3,"ر",2,0],["لَولا ظُنُونٌ علَّقَت نَفسَهُ","بالفَوزِ مِن فَوزِ بنِ عَبد اللَّه",4,"ل",2,0],["لولا ظُبىً تنسلُّ من لحَظاتِه","لجنيتُ ورداً لاحَ في وجَناتِه",5,"ت",2,1],["لولا ظُبانا يا ظِباء القِفارْ","لما فؤادُ الصَّب في الحبِّ جارْ",6,"ر",1,1],["لولا ظلام شعوره","ما اسود جنح للدياجر",7,"ر",1,0],["لَولا ظِباءُ بَني الشَريدِ لَما انثَنى","طِيبُ الرُقادِ مِنَ الجُفونِ شَرِيدا",8,"د",2,0],["لَولا ظِباءُ رِماحٍ لَم أَمُت شَغَفاً","بِظَبيَةٍ مِن ظِباءِ السِربِ مِعطالِ",9,"ل",1,0],["لَولا ظُبَّةُ الحُسام أَرويهِ دَماً","ما قُلتُ بِتَوريد خُدود البيضِ",10,"ض",1,0],["لولا ظلالٌ للكتابِ تفيأتْ","فيْها القلوبُ وأنتَ فيها المرشدُ",11,"د",1,0]]}