{"poems":[[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[68,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[113,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[396,"يامجمل لا تهمل","https://www.aldiwan.net/poem54431.html","عموديه"],[463,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[469,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[469,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[484,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[563,"ربنا الله شارع الأحكام","https://www.aldiwan.net/poem33883.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122650","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119900","الخفيف"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216932","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/131353","الخفيف"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27203","المديد"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109533","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204695","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74041","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123912","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86447","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72479","الخفيف"],[5171,"سلامة البيت","https://www.poetsgate.com/ViewPoem.aspx?id=198198",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5327,"زَلزِلِ الطُّغيان","https://www.poetsgate.com/ViewPoem.aspx?id=151528",""],[5431,"دثروني...تتمة","https://www.poetsgate.com/ViewPoem.aspx?id=196860",""],[5431,"جبل العرب ...للعرب","https://www.poetsgate.com/ViewPoem.aspx?id=198887",""],[5431,"الشعر واللين...","https://www.poetsgate.com/ViewPoem.aspx?id=202299",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5739,"راسبه والاّ ناجحه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126872",""],[6023,"قل لمن بالقريض بزَّ الفحولا","https://www.poetsgate.com/ViewPoem.aspx?id=123905",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[5190,"ثمن الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78316&r=&rc=29",""],[4890,"مواعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72396&r=&rc=86",""]],"verses":[["كلُّ طفلٍ يُدعى بأسماءَ شتَّى","بين عودٍ ومِزْهَرٍ وكِرانِ",0,"ن",1,0],["كُلُّ طَويلٍ نِجادِ السَيفِ يُطرِبُهُ","وَقعُ الصَوارِمِ كَالأَوتارِ وَالنَغَمِ",1,"م",1,0],["كُلِّ طِرفٍ مُطَهَّمٍ سائِلِ الغُر","رَةِ جَعدِ الرِسغَينِ سِبطِ الإِهابِ",2,"ب",1,0],["كُلُّ طِفلٍ يَجِلُّ أَن يَحكِيَ البَد","رَ وَلَكِن لَهُ البُّدورُ تُحاكي",3,"ك",2,0],["كُلُ طَرف يَغض مِن وَهج الشَمس","وَأَنتَ المُنوّر الأَبصارا",4,"ر",2,0],["كل طاعاتي بغفله","حاويه كل الرذاله",5,"ل",2,0],["كلُّ طويلِ النِّجاد زلَّت","عنه فضول البرد المذال",6,"ل",1,0],["كلُّ طريقٍ نفَضَتْ إلى العُلا","فهي وإن تطاولت مِضمارُها",7,"ر",3,0],["كل طيارة حبتها طيور ال","جو والدارعون حمداً وذما",8,"م",2,0],["كل طيّارةٍ إلى كلّ ظاغٍ","بجناحين من مدادٍ ولبد",9,"د",1,0],["كلّ طيّارةٍ إلى قصب","الغاياتِ يعني آذيّها بالجزع",10,"ع",1,0],["كل طائيةٍ تعدّ إلى الغوث","سراة الأخوال والأعماما",11,"م",2,0],["كل طفل بيننا","بالعلوم يهتدي",12,"ي",1,0],["كل طاعاتنا من الله إنعا","مٌ ومنا شكر على الإنعام",13,"م",1,0],["كُلُّ طَرفٍ لِفِكرِ عِندَ كَليلٍ","كُلَّ طَرفٍ لِلجَريِ فيهِ كَهامِ",14,"م",1,0],["كُلُّ طِفلٍ سَقَى حَماليقَ عَينَي","هِ بأكرُومَةٍ وحِلمٍ ويأس",15,"س",1,0],["كل طرف الزمان عنه فمن دو","ن علاء السماك والإكليل",16,"ل",1,0],["كُلَّ طرْفٍ مُوثّقٍ عنْتَريسٍ","مُستطيلِ الأقرَابِ والبُلْعُومُ",17,"م",1,0],["كل طريق قد عدتها الحجة","فإنها طريقة معوجة",18,"ه",1,0],["كل طرد به عليهم تجلى","ذو الجلال ادّعوا به التقريبا",19,"ب",2,0],["كُلَّ طحون شَهباءَ باسِلَةٍ","تُسقط أَحبالها زماجرها",20,"ر",3,0],["كلُّ طَرفٍ في العلى سابحٌ","نحونا وجداً بنا يرتمي",21,"م",2,0],["كل طيرٍ ان هام شوقاً يغني","فوق عودٍ والقلب يصبو إليه",22,"ه",1,1],["كل طفل مهيئ لطريق","ان عداه لن يبلغن آماله",23,"ل",2,0],["كلّ طَلا مشوبة","وَتِلكَ صرف لَم تشب",24,"ب",1,0],["كل طود كالشيخ قد غالب الكون","عراكاً فقوس الدهر ظهره",25,"ر",2,0],["كل طير يهدي لقلبي حزناً","واكتئاباً وإن يكن عندليبا",26,"ب",2,0],["كل طود إذا تجلى عليه","شرفي عنده يرى متلاشي",27,"ش",2,0],["كل طفل وطفلة كَبَّرَ الرح","من واستأنسا بزهوة عيد",28,"د",1,0],["كلّ طَقسٍ مارسوا في غَدرِهِم","هُمْ صَلوْا ناري وأدموا عِزَّتي",29,"ت",2,0],["كُلُّ طاغُوتٍ سَيَفنَى","أَينَ فِرعَوْنُ وَتُبَّع",30,"ع",1,0],["كلّ طفلٍ قتلته سوف يغدو","خنجرا في ضلالك المتعالي",31,"ل",2,0],["كل طفلٍ سيبذل الروح سُقيا","ألف نهرٍ وروحه صُنوانُ",32,"ن",1,0],["كلّ طيرٍ لنعمة الله يغدو","شاكرا ما إلهه اليوم باسط",33,"ط",1,0],["كل طفل وطفلة فيه صَخْرٌ","مَنْبِتٌ في ذُرا فلسطينَ رايهْ",34,"ا",3,0],["كل طيف ٍ في عيوني المحه.","ابتسم له اشعل الشعر بسماك.",35,"ك",1,0],["كل طرفٍ إذا ترجع منها","عاد من حسنه حسيراً كليلا",36,"ل",2,0],["كُلُّ طَودٍ أَراهُ دُونَ صُمُودِي","كُلُّ طُورٍ دَكَكتُهُ صارَ سَهلَا",37,"ل",2,0],["كلٌّ طوى ليلَهُ واغتال غربتهُ","وأنت لا زلتَ بالدينارِ تنشغلُ",38,"ل",1,0],["كلّ طريقي سفَرٌ دائِمٌ","وفي المجاهيل مواعيدي.",39,"ي",1,0]]}