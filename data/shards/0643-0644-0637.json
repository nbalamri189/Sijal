{"poems":[[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[110,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[392,"يامجمل لا تهمل","https://www.aldiwan.net/poem54431.html","عموديه"],[459,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[465,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[465,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[465,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[480,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[559,"ربنا الله شارع الأحكام","https://www.aldiwan.net/poem33883.html","الخفيف"]],"verses":[["كلُّ طفلٍ يُدعى بأسماءَ شتَّى","بين عودٍ ومِزْهَرٍ وكِرانِ",0,"ن",1,0],["كُلُّ طَويلٍ نِجادِ السَيفِ يُطرِبُهُ","وَقعُ الصَوارِمِ كَالأَوتارِ وَالنَغَمِ",1,"م",1,0],["كُلِّ طِرفٍ مُطَهَّمٍ سائِلِ الغُر","رَةِ جَعدِ الرِسغَينِ سِبطِ الإِهابِ",2,"ب",1,0],["كُلُّ طِفلٍ يَجِلُّ أَن يَحكِيَ البَد","رَ وَلَكِن لَهُ البُّدورُ تُحاكي",3,"ك",2,0],["كُلُ طَرف يَغض مِن وَهج الشَمس","وَأَنتَ المُنوّر الأَبصارا",4,"ر",2,0],["كل طاعاتي بغفله","حاويه كل الرذاله",5,"ل",2,0],["كلُّ طويلِ النِّجاد زلَّت","عنه فضول البرد المذال",6,"ل",1,0],["كلُّ طريقٍ نفَضَتْ إلى العُلا","فهي وإن تطاولت مِضمارُها",7,"ر",3,0],["كل طيارة حبتها طيور ال","جو والدارعون حمداً وذما",8,"م",2,0],["كل طيّارةٍ إلى كلّ ظاغٍ","بجناحين من مدادٍ ولبد",9,"د",1,0],["كلّ طيّارةٍ إلى قصب","الغاياتِ يعني آذيّها بالجزع",10,"ع",1,0],["كل طائيةٍ تعدّ إلى الغوث","سراة الأخوال والأعماما",11,"م",2,0],["كل طفل بيننا","بالعلوم يهتدي",12,"ي",1,0],["كل طاعاتنا من الله إنعا","مٌ ومنا شكر على الإنعام",13,"م",1,0]]}