{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[469,"رحلوا فشموسهم تجب","https://www.aldiwan.net/poem3622.html","عموديه"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[5277,"أختُ الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=208846",""],[5538,"الله يقسم من أضاع فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=142624",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""]],"verses":[["عَجَبٌ عِجابٌ لِلْنُّفُوسِ ذَكَاؤُهَا","مُتَلأَلِئَاً فِي لَحْظِهَا السَحَّارِ",0,"ر",1,0],["عجبٌ عشّاقك أنّهمُ","سكروا باللحظ وما شربوا",1,"ب",3,0],["عجبٌ عظيمٌ يشدهُ الألبابَ إذ","ظهرَ الإلهُ برفدهِ مُتَجسِّدا",2,"د",2,0],["عجبٌ عجابْ أن هويتُ فإنني","مِن أهلِ بيتٍ بالحياءِ تحجَّبوا",3,"ب",3,0],["عجب عجيب ما رأيت مثيله","أسعى لمصلحته تزيد فساد",4,"د",1,0],["عَجَبٌ عَيْثُهُنَّ فينا ولا عِدْ","دَةُ إلاَّ مَجَاسِدٌ وبُرُودُ",5,"د",1,0]]}