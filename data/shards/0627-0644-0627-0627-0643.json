{"poems":[[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[64,"فيم المقام على الهوان وهمتي","https://www.aldiwan.net/poem52291.html","الكامل"],[47,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[107,"أما ومضارب البيض الرقاق","https://www.aldiwan.net/poem43994.html","الوافر"],[77,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[416,"أمسى المشيب من الشباب بديلا","https://www.aldiwan.net/poem67485.html","الكامل"],[2150,"","https://poetry.dctabudhabi.ae/diwan/poem/116924","الطويل"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117814","الطويل"],[592,"أقول هذا كله لا يعقل","https://www.poetsgate.com/ViewPoem.aspx?id=128804",""],[5431,"لبيروت الصلاة...","https://www.poetsgate.com/ViewPoem.aspx?id=215336",""]],"verses":[["إلّا أكن متُّ فانقرضتُ فكَمْ","من مَوْتةٍ للفؤادِ في الذِّكَرِ",0,"ر",1,0],["إِلّا أكنْ شاكي السلاحِ فإنَّني","بالعزم والرأي الحصيف مُسَوَّمُ",1,"م",1,0],["إِلّا أَكُن كُلِفتُ مِنهُ يَذبُلاً","فَلَقَد مُنيتُ بِخِدنِهِ أَو تِربِهِ",2,"ب",2,0],["ألا اكْشِفْ ما بنا يا زيدُ عَنَّا","فليسَ بِمُستطاعٍ أو مُطاقِ",3,"ق",1,0],["إلاّ أكُنْ بلَغَتْ بيَ السّنُّ المَدى","فلقد بلَغْتُ من الطّريقِ المَنصَفا",4,"ف",2,0],["إِلّا أَكُن مِمَّن قَتَلنَ فَإِنَّني","مِمَّن تَرَكنَ فُؤادَهُ مَخبولا",5,"ل",2,0],["إلا أكُن مِمَّن علمتِ فانّني","إلىنسبٍ مِمَّن جَهلتِ كريمِ",6,"م",1,1],["ألا أكن لاقيتُ يومَ مخطط","فقد خَبَّرَ الركبانُ ما أَتَودَدَ",7,"د",1,1],["إلا أكاذيب رواها عصبة","مرفوضة أقوالهم لا تنقل",8,"ل",1,0],["ألا أكمل بلعبٍ مستميتٍ","ولو ضغطت قيامتنا الزنادا",9,"د",2,0],["ألا أكمل مسيرك دون لأيٍ","تعوّد أن تسود ولا تُسادا",9,"د",2,0]]}