{"poems":[[53,"شرف الخلافة يا بني العباس","https://www.aldiwan.net/poem30200.html","الكامل"],[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[55,"ما تأمرين بذي مراقبة","https://www.aldiwan.net/poem26310.html","الكامل"],[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[71,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[93,"تمضي وذكرك ملء كل جنان","https://www.aldiwan.net/poem11244.html","الكامل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[72,"قاضي القضاة المرتجى دمت ذا","https://www.aldiwan.net/poem18681.html","السريع"],[72,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[91,"يا نفس قد ذهب الرفيق الألمعي","https://www.aldiwan.net/poem8979.html","عموديه"],[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[56,"في خده خال كأن","https://www.aldiwan.net/poem58605.html","مجزوء الكامل"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[45,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[45,"تلك الديار ودارسات طلولها","https://www.aldiwan.net/poem65581.html","الكامل"],[61,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[66,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[66,"طاف وفي راحته كأس راح","https://www.aldiwan.net/poem39642.html","السريع"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[91,"حديث موجة","https://www.poetsgate.com/ViewPoem.aspx?id=53069",""],[118,"ماض على غلوائه يجري","https://www.aldiwan.net/poem49330.html","أحذ الكامل"],[130,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[153,"لمن الرسوم برامتين بلينا","https://www.aldiwan.net/poem55540.html","الكامل"],[158,"مقعد صدق لمليك مقتدر","https://www.aldiwan.net/poem58936.html","الرجز"],[184,"أصبحت أكره أن أزاد","https://www.aldiwan.net/poem43610.html","مجزوء الكامل"],[208,"بدر توارى في من رقبائه","https://www.aldiwan.net/poem13380.html","الكامل"],[233,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[233,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[235,"أتلومني يا عاذلي","https://www.aldiwan.net/poem19497.html","مجزوء الكامل"],[278,"أو ما ترى قلق الغدير كأنما","https://www.aldiwan.net/poem60748.html","الكامل"],[303,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[364,"كم قلت للعاني المنى بلحاقه","https://www.aldiwan.net/poem17256.html","الكامل"],[369,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[374,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[374,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[400,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[413,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[436,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[436,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[436,"جهز لنا في الأرض غزوة محتسب","https://www.aldiwan.net/poem34905.html","الكامل"],[438,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[450,"أي قلب يبقى على الحب أي","https://www.aldiwan.net/poem13969.html","الخفيف"],[456,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[456,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[549,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[565,"روح من الماء في جسم من الصفر","https://www.aldiwan.net/poem69680.html","البسيط"],[565,"برزت وأتراب لها عرب","https://www.aldiwan.net/poem69683.html","الكامل"],[571,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[573,"لام العذول على هواك وفندا","https://www.aldiwan.net/poem2960.html","الكامل"]],"verses":[["مُتَرادِفينَ عَلى المَكارِمِ وَالعُلى","مُتَسابِقينَ إِلى النَدى وَالباسِ",0,"س",1,0],["مُتَرَّفَةٌ إِلى الغاياتِ حَتّى","تَرَنَّحُ في الشَكيمِ مِنَ اللُغوبِ",1,"ب",1,0],["مُتَرَبِّصٌ سُدَّت مَذاهِبُهُ","أَفنى بِطولِ رَجائِكِ الدَهرا",2,"ر",2,0],["مُتَرَبِّعٌ مِنها رِيا","ضاً صابَها وَدقُ الهَواطِل",3,"ل",1,0],["مَتَرَنِّحينَ مِنَ النُعاسِ كَأَنَّهُم","شَرِبوا بِكاساتِ الوَجيفِ المُسكِرا",4,"ر",2,0],["مُتَرَقْرِقُ المَجْرَى تَرَقْرُقَ جَدْوَلٍ","مُتَمَاسِكُ الأَجْزَاءِ كَالْبُنْيَانِ",5,"ن",1,0],["مُتَرَسِّماً آثَارَهُمْ مِنْ عِفَّةٍ","وَنَزَاهَةٍ وَتُقًى وَبَسْطِ بَنَانِ",6,"ن",1,0],["مترنحين على الرمال كأنما","عاطينُ من فرط الكلال شَمُولا",7,"ل",2,0],["مُتَراكِبٌ زَجِلٌ يُضيءُ وَميضُهُ","كَالبُلقِ تَحتَ بُطونِها الأَمهارُ",8,"ر",1,0],["مترفع الأوصاف عن مدح الورى","فكأنما قول المديح له بذا",9,"ذ",2,0],["مترادِفٌ لذَوي الرَّجا","بهباته المتواتره",10,"ر",2,0],["مُترقِّباً مِنْ فوقهِ","يخشى عَذابي وانصبابهْ",11,"ب",2,0],["مُتَرَجرِجُ الأَخلاقِ أَصدَقُ وَعدِهِ","آل وَخَيرُ هِباتِهِ الأَعذارُ",12,"ر",1,0],["مُتَرَنِّحٌ مِن خَمرَةٍ قُدسِيَّةٍ","فيها الهَوى وَفُتونِه وَفُتورُهُ",13,"ر",2,0],["مُتَرَفِّقٌ في مَشيِهِ يَطَءُ الثَرى","وَكَأَنَّما بَينَ النُجومِ مَسيرُهُ",13,"ر",2,0],["مُتَرَفِّعاً في قَولِهِ وَفِعالِهِ","عَمَّن غَوى وَهَوى وَلَم يَتَرَفَّعِ",14,"ع",1,0],["مترنِّحَ الخطواتِ مَا","بَيْنَ المَزالقِ والصُّخورْ",15,"ر",1,0],["مُتَرَقْرِقُ الخَدَّينِ مِنْ","ماءِ الصِّبَا والطِّيبِ يَنْدَى",16,"د",2,0],["مترجِّحاً يحدو به رَغَبٌ","فيصدُّهُ عن قَصْدهِ الرَّهْبُ",17,"ب",1,0],["مُتَرادِفينَ عَلى سُرادِقِ أَغلَبٍ","تَعنو لَهُ نَظَرُ المُلوكِ الصيدِ",18,"د",1,0],["مَتروكَةٌ لِلريحِ بَينَ جَنوبِها","وَشَمالِها وَدَبورِها وَقَبولِها",19,"ل",3,0],["مُترَدِّدٌ في الجَفْنِ ماءُ شُؤُونِه","متحدِّرٌ في الخَدِّ ماءُ شَبابِه",20,"ب",2,0],["مُتَرَّكُ اللَحظِ في أَخلاقِهِ دَمَثٌ","مُستَعرِبُ اللَفظِ تُركِيٌّ إِذا اِنتَسَبا",21,"ب",2,0],["مُتَرَّكُ اللَحظِ لَهُ قامَةٌ","أَلطَفُ هَزّاً مِن قُدودِ الرِماح",22,"ح",1,0],["مُتَرْجِمٌ عنه لسانُ العُلى","فيما عَنَاهُ أو لسانُ الحسام",23,"م",1,0],["مُتَرَحِّلاً نحوَ المعالي ساكِناً","بالجيش في ظلِّ اللواءِ الخافِقِ",24,"ق",1,0],["مُتَردِّدٌ في سامِياتِ مَراتِبٍ","والبَدرُ في الأَبراجِ ذو تَغريدِ",25,"د",1,0],["متراقِصَاتٍ والسِّيَاط ُ","تَجِدُّ عَزْفَاً ﺑﭑرْتِزَامِ",26,"م",1,0],["مُتَرَقِّبٌ رُسُلَ الرِياحِ عَشِيَّةً","بِمَساقِطِ الأَنواءِ وَالأَنوارِ",27,"ر",1,0],["مُتَرَدِّداً يَرمي بِهِ خَوفُ الرَدى","كُرَةً تَهادَتها أَكُفُّ قِفارِ",27,"ر",1,0],["مُتَرَكِّبٍ عَن نَفحَةٍ في لَفحَةٍ","وَكَفاكَ مِن كاسٍ هُناكَ دِهاقِ",28,"ق",1,0],["مُتَرادِفُ النَجداتِ مُنصَلِتُ القُوى","مُتَطايِحُ النَخَواتِ وَاري الأَزنُدِ",29,"د",1,0],["مُتَراخي الحُبى ثَقيلينَ في المي","زانِ يَشفونَ صَورَةَ الجُهّالِ",30,"ل",1,0],["مترنحاً كالعاشقِ الثملِ","ريّانَ من بَهجٍ ومن حَزَنِ",31,"ن",1,0],["مُتربِّصِ السطوات تختبىءُ الرُّبى","وتفِرُّ من طُرُقاتِهِ الأشجارُ",32,"ر",1,0],["مُتَرَقِّصاً وَهْوَ النَّبِيُّ مُعَالِجاً","وَهْوَ المَلِيكُ النَّفْخَ فِي المِزْمَارِ",33,"ر",1,0],["مُتْرَعُ الأَصْغَرَيْنِ عِلْماً وَفَناً","وَكِلاَ المَشْرَعَيْنِ عذْبٌ وَشافِ",34,"ف",1,0],["مُتَردٍ في هَاوياتِ وِهادٍ","لاهِثٍ فوقَ شامِخَاتِ جِبال",35,"ل",1,0],["مترفّق في مشيه يطأ الثّرى","وكأنّما بين النجوم مسيره",36,"ر",2,0],["مترقرق لا شيء يحسبه","متزاحم كتزاحم الشعر",37,"ر",1,0],["مُترَعٍ بِالهِجَاءِ في سَنَنٍ","غَيرِ لَذِيذٍ بِكُلِّ لَفظٍ بَشِيعِ",38,"ع",1,0],["مُتَرَسِّماتٍ بِالرُّسُومِ تَخَالُ في","أَلْوَانِها مِمَّا بِنا تَلْوِينا",39,"ن",2,0],["مترعةٌ ماءً يظل ينطوى","فيها على حكم الهوى وينتشر",40,"ر",1,0],["متردّيا ثوب التقى","متأزّراً ثوب العفاف",41,"ف",1,0],["مترنح الاعطاف ميله الصبا","يثني على رياه طيب ثنائه",42,"ا",3,0],["مُتَرَدِّياً بِرِداءِ حَظٍّ ناقِصٍ","في أَهلِها وَجَمالِ فَضلٍ كامِلِ",43,"ل",1,0],["مُتَرَفِّعٌ عِندَ الحَوا","دِثِ أَن تُطَأمِنَ مَنكِبا",44,"ب",2,0],["مُتَرَنِّمٌ كَلَفاً بِهَا","طَرِبٌ عَلَى الأَفْرَاحِ عَاكِفْ",45,"ف",1,0],["مُتَرَقْرِقٌ لَعِبَ الشُّعاعُ بِمائِهِ","فَارْتَجَّ يَخْفُقُ مِثْلَ قَلْبِ الْعاشقِ",46,"ق",1,0],["مُترفُ الجسمِ آسر نفسه في","قيدِ جبنٍ وحاجةٍ وهوانِ",47,"ن",1,0],["مُترقّباً طَوراً فطوراً لا يرى","مَرمى ورا ما فيه أضحى يزمعُ",48,"ع",1,0],["مُتَرَجِّياً لِلعَيشِ في إِعزازِهِ","مُتَخَوِّفاً لِلمَوتِ في إِذلالِهِ",49,"ل",2,0],["مُترشِّحٌ للمُلكِ قد","نصبَت سَريرتُه السريرا",50,"ر",2,0],["مترقياً نحو السماء بمهيعٍ","قد حده أنطونيوس بالسلَّم",51,"م",1,0],["مُتَرَقِّبينَ وُرودَ كَأس حُتوفنا","فنبيتُ عند مَطافهِ نُدماءَ",52,"ا",2,0],["متردد وكفى بذلك قادح","فتأملوا بُلِّغْتُم المأمولا",53,"ل",2,0],["مترجّلين كأنّما مالت بهم","راحٌ يسكِّر ذكرها أو تسكر",54,"ر",1,0],["مُتَرَبِّصينَ جَنى ثمارٍ قَدْ أنى","منها إليكَ تَفَتُّحُ الأكمامِ",55,"م",1,0],["مُتَرَشِّفُ الهبواتِ قبلَ شِفاهِها","ومُعَانِقُ الأَبطالِ قبلَ عِناقِها",56,"ق",3,0],["مُتَرَقِّبينَ لأَمره وَقَدْ ارْتقى","خَلَلَ البناءِ ومَدَّ صَفْحَةَ مُرتقِبْ",57,"ب",1,0],["مترى النجوم غوائراً ونواجداً","فيها ومنها من هنا فإلى هنا",58,"ن",2,0],["مُتْرفٌ ما يكاد يَخْطر إِلاّ","بانَ في عطفه كلالٌ وعيّ",59,"ي",1,0],["مترادفين على الرياسة أُقعِدوا","منها على سيساءِ ظهرٍ طيّع",60,"ع",1,0],["متراهنين على الدنيَّةِ أحرزوا","غاياتِها وتناهبوا حَلَباتِها",61,"ت",3,0],["مُترنّحينَ منَ الغرامِ كأنّنا","قُضُبٌ تميلُ مع الصِّبا وتميدُ",62,"د",1,0],["مترجِمٌ عن مواقيتٍ يُخْبِرُنا","عنها فيوجَدُ فيها صادِقُ الخَبَرِ",63,"ر",1,0],["مترقِبٌ يَرْجُو مُعَاوَدَتي","أفدِيْهِ مُنْتَظِراً ومُنْتَظِرا",64,"ر",2,0],["مُتَرَنِّمينَ عَلى ذُرى كيرانِهِم","وَصَريرُها بَدلٌ مِنَ التَرنيمِ",65,"م",1,0],["مترِّدُ الحسرات حتَّ","ى بالتردُّد صِرْنَ حَسري",66,"ر",2,0],["مُترنِّحُ الأَعطافِ من خَمْرِ الصِّبَا","أَو ما تراهُ باللِّحاظِ مُعَرْبِدَا",67,"د",2,0]]}