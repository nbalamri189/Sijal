gate.com/ViewPoem.aspx?id=156500",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5425,"لم أَعتَذِر","https://www.poetsgate.com/ViewPoem.aspx?id=207507",""],[5431,"متورطٌ إني به متورط...","https://www.poetsgate.com/ViewPoem.aspx?id=199177",""],[5431,"باريس ...","https://www.poetsgate.com/ViewPoem.aspx?id=208588",""],[5652,"يوم الرفاقه لوحت لي على الكمْ","https://www.poetsgate.com/ViewPoem.aspx?id=190142",""],[5725,"ياايها السالي","https://www.poetsgate.com/ViewPoem.aspx?id=191670",""],[5725,"آه يا بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215377",""],[402,"ألغرس غرسك أيها البستاني","https://www.poetsgate.com/ViewPoem.aspx?id=36486",""],[5790,"أهواه أسمر في اعتدال الأسمر","https://www.poetsgate.com/ViewPoem.aspx?id=112056",""],[5818,"يا أيّها الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=193191",""],[5865,"هذا المساء","https://www.poetsgate.com/ViewPoem.aspx?id=179857",""],[5897,"إيه .. يا جنة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=176413",""],[5943,"دمعٌ بعيني لايكفكفه الملل","https://www.poetsgate.com/ViewPoem.aspx?id=11286",""],[5956,"متربصون","https://www.poetsgate.com/ViewPoem.aspx?id=185606",""],[5956,"تعريف بإسرائيل المعتدية","https://www.poetsgate.com/ViewPoem.aspx?id=194415",""],[391,"لا تَقُولن إذا ما لم تُرِدْ","https://www.poetsgate.com/ViewPoem.aspx?id=22522",""],[6069,"ومجدرٍ عذبت مراشف ثغره","https://www.poetsgate.com/ViewPoem.aspx?id=105708",""],[6238,"قلب قزح...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86772&r=&rc=1",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""],[572,"بَرَزَتْ وأترابٌ لها عُرُبٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9273&r=&rc=130",""]],"verses":[["مُتَرادِفينَ عَلى المَكارِمِ وَالعُلى","مُتَسابِقينَ إِلى النَدى وَالباسِ",0,"س",1,0],["مُتَرَّفَةٌ إِلى الغاياتِ حَتّى","تَرَنَّحُ في الشَكيمِ مِنَ اللُغوبِ",1,"ب",1,0],["مُتَرَبِّصٌ سُدَّت مَذاهِبُهُ","أَفنى بِطولِ رَجائِكِ الدَهرا",2,"ر",2,0],["مُتَرَبِّعٌ مِنها رِيا","ضاً صابَها وَدقُ الهَواطِل",3,"ل",1,0],["مَتَرَنِّحينَ مِنَ النُعاسِ كَأَنَّهُم","شَرِبوا بِكاساتِ الوَجيفِ المُسكِرا",4,"ر",2,0],["مُتَرَقْرِقُ المَجْرَى تَرَقْرُقَ جَدْوَلٍ","مُتَمَاسِكُ الأَجْزَاءِ كَالْبُنْيَانِ",5,"ن",1,0],["مُتَرَسِّماً آثَارَهُمْ مِنْ عِفَّةٍ","وَنَزَاهَةٍ وَتُقًى وَبَسْطِ بَنَانِ",6,"ن",1,0],["مترنحين على الرمال كأنما","عاطينُ من فرط الكلال شَمُولا",7,"ل",2,0],["مُتَراكِبٌ زَجِلٌ يُضيءُ وَميضُهُ","كَالبُلقِ تَحتَ بُطونِها الأَمهارُ",8,"ر",1,0],["مترفع الأوصاف عن مدح الورى","فكأنما قول المديح له بذا",9,"ذ",2,0],["مترادِفٌ لذَوي الرَّجا","بهباته المتواتره",10,"ر",2,0],["مُترقِّباً مِنْ فوقهِ","يخشى عَذابي وانصبابهْ",11,"ب",2,0],["مُتَرَجرِجُ الأَخلاقِ أَصدَقُ وَعدِهِ","آل وَخَيرُ هِباتِهِ الأَعذارُ",12,"ر",1,0],["مُتَرَنِّحٌ مِن خَمرَةٍ قُدسِيَّةٍ","فيها الهَوى وَفُتونِه وَفُتورُهُ",13,"ر",2,0],["مُتَرَفِّقٌ في مَشيِهِ يَطَءُ الثَرى","وَكَأَنَّما بَينَ النُجومِ مَسيرُهُ",13,"ر",2,0],["مُتَرَفِّعاً في قَولِهِ وَفِعالِهِ","عَمَّن غَوى وَهَوى وَلَم يَتَرَفَّعِ",14,"ع",1,0],["مترنِّحَ الخطواتِ مَا","بَيْنَ المَزالقِ والصُّخورْ",15,"ر",1,0],["مُتَرَقْرِقُ الخَدَّينِ مِنْ","ماءِ الصِّبَا والطِّيبِ يَنْدَى",16,"د",2,0],["مترجِّحاً يحدو به رَغَبٌ","فيصدُّهُ عن قَصْدهِ الرَّهْبُ",17,"ب",1,0],["مُتَرادِفينَ عَلى سُرادِقِ أَغلَبٍ","تَعنو لَهُ نَظَرُ المُلوكِ الصيدِ",18,"د",1,0],["مَتروكَةٌ لِلريحِ بَينَ جَنوبِها","وَشَمالِها وَدَبورِها وَقَبولِها",19,"ل",3,0],["مُترَدِّدٌ في الجَفْنِ ماءُ شُؤُونِه","متحدِّرٌ في الخَدِّ ماءُ شَبابِه",20,"ب",2,0],["مُتَرَّكُ اللَحظِ في أَخلاقِهِ دَمَثٌ","مُستَعرِبُ اللَفظِ تُركِيٌّ إِذا اِنتَسَبا",21,"ب",2,0],["مُتَرَّكُ اللَحظِ لَهُ قامَةٌ","أَلطَفُ هَزّاً مِن قُدودِ الرِماح",22,"ح",1,0],["مُتَرْجِمٌ عنه لسانُ العُلى","فيما عَنَاهُ أو لسانُ الحسام",23,"م",1,0],["مُتَرَحِّلاً نحوَ المعالي ساكِناً","بالجيش في ظلِّ اللواءِ الخافِقِ",24,"ق",1,0],["مُتَردِّدٌ في سامِياتِ مَراتِبٍ","والبَدرُ في الأَبراجِ ذو تَغريدِ",25,"د",1,0],["متراقِصَاتٍ والسِّيَاط ُ","تَجِدُّ عَزْفَاً ﺑﭑرْتِزَامِ",26,"م",1,0],["مُتَرَقِّبٌ رُسُلَ الرِياحِ عَشِيَّةً","بِمَساقِطِ الأَنواءِ وَالأَنوارِ",27,"ر",1,0],["مُتَرَدِّداً يَرمي بِهِ خَوفُ الرَدى","كُرَةً تَهادَتها أَكُفُّ قِفارِ",27,"ر",1,0],["مُتَرَكِّبٍ عَن نَفحَةٍ في لَفحَةٍ","وَكَفاكَ مِن كاسٍ هُناكَ دِهاقِ",28,"ق",1,0],["مُتَرادِفُ النَجداتِ مُنصَلِتُ القُوى","مُتَطايِحُ النَخَواتِ وَاري الأَزنُدِ",29,"د",1,0],["مُتَراخي الحُبى ثَقيلينَ في المي","زانِ يَشفونَ صَورَةَ الجُهّالِ",30,"ل",1,0],["مترنحاً كالعاشقِ الثملِ","ريّانَ من بَهجٍ ومن حَزَنِ",31,"ن",1,0],["مُتربِّصِ السطوات تختبىءُ الرُّبى","وتفِرُّ من طُرُقاتِهِ الأشجارُ",32,"ر",1,0],["مُتَرَقِّصاً وَهْوَ النَّبِيُّ مُعَالِجاً","وَهْوَ المَلِيكُ النَّفْخَ فِي المِزْمَارِ",33,"ر",1,0],["مُتْرَعُ الأَصْغَرَيْنِ عِلْماً وَفَناً","وَكِلاَ المَشْرَعَيْنِ عذْبٌ وَشافِ",34,"ف",1,0],["مُتَردٍ في هَاوياتِ وِهادٍ","لاهِثٍ فوقَ شامِخَاتِ جِبال",35,"ل",1,0],["متربّص السّطوات تختبئ الرّبى","وتفرّ من طرقاته الأشجار",36,"ر",1,0],["مترفّق في مشيه يطأ الثّرى","وكأنّما بين النجوم مسيره",37,"ر",2,0],["مترف في رجولة واعتداد","راع زيّا وراع وجها وقدّا",38,"د",2,0],["مترف الفكر والبيان غنيّ","بالآلي يصوغ عقدا فعقدا",38,"د",2,0],["مترنّح العطفين من خيلائه","ماذا تركت لغارة وكفاح",39,"ح",1,0],["مترقرق لا شيء يحسبه","متزاحم كتزاحم الشعر",40,"ر",1,0],["مُترَعٍ بِالهِجَاءِ في سَنَنٍ","غَيرِ لَذِيذٍ بِكُلِّ لَفظٍ بَشِيعِ",41,"ع",1,0],["مُتَرَسِّماتٍ بِالرُّسُومِ تَخَالُ في","أَلْوَانِها مِمَّا بِنا تَلْوِينا",42,"ن",2,0],["مترعةٌ ماءً يظل ينطوى","فيها على حكم الهوى وينتشر",43,"ر",1,0],["متردّيا ثوب التقى","متأزّراً ثوب العفاف",44,"ف",1,0],["مترنح الاعطاف ميله الصبا","يثني على رياه طيب ثنائه",45,"ا",3,0],["مُتَرَدِّياً بِرِداءِ حَظٍّ ناقِصٍ","في أَهلِها وَجَمالِ فَضلٍ كامِلِ",46,"ل",1,0],["مُتَرَفِّعٌ عِندَ الحَوا","دِثِ أَن تُطَأمِنَ مَنكِبا",47,"ب",2,0],["مُتَرَنِّمٌ كَلَفاً بِهَا","طَرِبٌ عَلَى الأَفْرَاحِ عَاكِفْ",48,"ف",1,0],["مُتَرَقْرِقٌ لَعِبَ الشُّعاعُ بِمائِهِ","فَارْتَجَّ يَخْفُقُ مِثْلَ قَلْبِ الْعاشق