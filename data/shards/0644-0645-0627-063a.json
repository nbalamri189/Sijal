.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83529","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35431","الكامل"],[4699,"همس الورد","https://www.poetsgate.com/ViewPoem.aspx?id=153932",""],[4984,"افْتَحْ من العهد القديم ..","https://www.poetsgate.com/ViewPoem.aspx?id=191325",""],[4985,"عمان في مواجهة جونو","https://www.poetsgate.com/ViewPoem.aspx?id=27053",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5136,"أدعوه يا قمري غلط","https://www.poetsgate.com/ViewPoem.aspx?id=121933",""],[5183,"أَلْفَرَاهيدِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=186453",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5431,"على لوحٍ بنور الله يُسقى...","https://www.poetsgate.com/ViewPoem.aspx?id=200032",""],[5431,"غمامٌ حاتميٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214181",""],[5473,"مصَارِع تصرع الآساد سمرته","https://www.poetsgate.com/ViewPoem.aspx?id=189601",""],[5733,"لَمَّا غَضِبْتَ حَرَمْتَنِي وَجَفَوْتَني","https://www.poetsgate.com/ViewPoem.aspx?id=201112",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5956,"ضيّعتُها وأخذتُ أرجع نحوها ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182141",""],[199,"لَمَّا غَدَا الحَيُّ من صَرْخٍ وغَيَّبَهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=22441",""],[6152,"أمطار مكة المكرمة","https://www.poetsgate.com/ViewPoem.aspx?id=204736",""],[6183,"يوم الخميس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79818&r=&rc=8",""]],"verses":[["لَمّا غَدا السَربُ يَعطو بَينَ أَرحُلِنا","ما كانَ فيهِ غَريمُ القَلبِ إِلّاكِ",0,"ك",1,0],["لَمّا غَدَوا وَغَدَت سَطيحَتُهُم","مَلأى وَبَطنُ جَوادِهِم صِفرُ",1,"ر",1,0],["لمّا غدا لحْظاً وهُمْ أجفانُهُ","نابَتْ شِفارُهُمُ عنِ الأشْفارِ",2,"ر",1,0],["لَمّا غَدَوا بِأَغَرَّ أَروَعَ ماجِدٍ","كَالبَدرِ تُستَسقى بِهِ الأَمطارُ",3,"ر",1,0],["لما غدا جدولاً تسقى المنون به","أضحى يشفّ على حافاته العلق",4,"ق",1,0],["لما غدا العارُ الذي سُرْبِلْتَهُ","أحدوثةَ الرُّكبانِ والأَمْلاءِ",5,"ا",2,0],["لمَّا غدتْ كسحائبٍ","أيقظنَ بالعبراتِ نَبْتَا",6,"ت",2,0],["لَم أَغِب عَنكَ اِختِياراً","إِنَّما ذاكَ لَأَمري",7,"ر",2,0],["لَم أَغشَ مَغناكِ إِلّا في غُضونِ كِرىً","مَغناكَ أَبعَدُ لِلمُشتاقِ مِن إِرَمِ",8,"م",1,0],["لَمّا غَدا بَكرُ بَكرٍ في قَساطِلِهِ","غَدا بَنو حَسَنٍ فيها بَني سَمَجِ",9,"ج",1,0],["لما غدا سلطان حسنك في البها","فردا وحاذر لحظ كل متيم",10,"م",1,1],["لَمّا غَضِبتُ عَلى القَريضِ هَجَوتُهُ","وَجَعَلتُ خِلقَتَهُ هِجاءَ هِجائي",11,"ا",2,0],["لَمّا غَدا مُظلِمَ الأَحشاءِ مِن أَشَرٍ","أَسكَنتَ جانِحَتَيهِ كَوكَباً يَقِدُ",12,"د",1,0],["لم أَغِبْ عن أُحُدٍ لولا أبي","يا رسولَ اللهِ والجَدِّ النَّكِدْ",13,"د",1,0],["لَمّا غَرَبتَ عَجَمتُ الصَبرَ أَسبُرُهُ","فَلَم أَجِد عودَهُ نَبعاً وَلا غَرَبا",14,"ب",2,0],["لَمَّا غَفَرْتُ لَهُ ذَنْباً وَصُنْتَ دَماً","لولا ذِمامُكَ أَضْحَى وَهْوَ مَطْلُولُ",15,"ل",1,0],["لَمّا غَدا الثَعلَبُ في اِعتِدائِهِ","وَالأَجَلُ المَقدورُ مِن وَرائِهِ",16,"ا",3,1],["لَمّا غَدا الثَعلَبُ مِن وِجارِهِ","يَلتَمِسُ الكَسبَ عَلى صِغارِهِ",17,"ر",2,1],["لمَّا غَدا بَينَ الحُمُولِ مُقَوَّضاً","كادَ الفُؤادُ عَنِ الحياةِ يُقَوّضُ",18,"ض",1,0],["لما غَزاها قائدُ الأَميرِ","باليُمنِ في لِوائهِ المنْصورِ",19,"ر",1,0],["لمّا غَزا إلى بني ذي النُّونِ","فكانَ فتحا ًلم يَكُن بالدُّونِ",19,"ن",1,0],["لَم أُغَمِّض طولَهُ حتَّى انقَضَى","أَتَمَنَّى لَو أَرَى الصُّبحَ جَشَر",20,"ر",1,0],["لَمّا غَدا يَتَشَكّى","كَسلانُ وَهوَ نَشيطُ",21,"ط",1,1],["لَم أُغَمِّض طولَهُ حَتّى اِنقَضى","أَتَمَنّى لَو أَرى الصُبحَ حَسَر",22,"ر",1,0],["لَما غَلت أَسعارهم","ناديت أَرخصهُ غَلا",23,"ل",2,0],["لما غدا موسى إلى ربه","أضل إسرائيل من فوره",24,"ر",2,0],["لما غَدا جَيحونُ طوعَ مُرادِهِ","كيفَ اقتْضاهُ جامداً أو سائِلا",25,"ل",2,0],["لَمّا غَدا الحَيُّ مِن صُرخٍ وَغَيَّبَهُم","مِنَ الرَوابي الَّتي غَربِيُّها الكُمَمُ",26,"م",1,0],["لما غَذَتْها السحابُ دِرَّتها","من فوقِ حوذانها ونرجسها",27,"س",3,0],["لَم أَغتَصِب حِبَرَ الكَلامِ وَإِنَّما","عَينايَ مِن عَينَيكِ تَغتَرِقانِ",28,"ن",1,0],["لَم أَغشَ في النَفسِ مَأثَم","وَلم أُنادم رجالَك",29,"ك",1,0],["لم أُغرِهنَّ ولكن","لي عندهنَّ هِنات",30,"ت",1,0],["لما غَدا رَعدُ المدافعِ قاصفاً","بحرابهم وشِفارهم صانوك",31,"ك",1,0],["لما غدا واعظا صموا فَخالطهم","بالسَيف بأسا فَلبى السيف اذ شهرا",32,"ر",2,0],["لَما غَدا راسِخاً في العِلمِ أَظهَرَهُ","وَالشَمسُ لا شَيءَ يَومَ الصَحوِ يخفيها",33,"ي",3,0],["لَمّا غَدا في كُلِّ حالاتِهِ","مُبارَكَ الطَّلعَةِ مَيمونا",34,"ن",2,0],["لَمّا غَدا المَنصورُ أَفضَلَ سَيِّدٍ","في فَضلِهِ نالَ المُنى الفُضَلاءُ",35,"ا",2,0],["لما غدا في لينه واحداً","أضحت له ريح الصبا ثانيه",36,"ه",1,0],["لما غدا في طافة جالسا","شباكها قد زاد قلبي جنون",37,"ن",1,1],["لما غدا من حسنه في موكب","حملت له نفس المتيم غاشيه",38,"ه",1,0],["لمّا غدا حَسناً ما أنت فاعِلُه","قُلنا بفِعلكِ قد أصبَحْتَ مكتَنيا",39,"ي",2,0],["لَمّا غدا الأسيافُ من شَرَفٍ","فيها معَ الأقلام تَخْتَصِم",40,"م",1,0],["لمّا غدا عِقْدُ آدابٍ به انْتظمَتْ","أشتاتُها جعلَتْه تاجَ أمْلاكِ",41,"ك",1,0],["لمّا غدا وَزَرَ الخِلافةِ رأْيُه","مدَّ الزّمانُ إليه كفَّ مُبايع",42,"ع",1,0],["لمّا غدا شَمساً وكان زَمانُنا","ليلاً وقَلّ اللّيلُ عنْ إشْماس",43,"س",1,0],["لمّا غدَتْ خَيلُ اشتِياقي لكم","تَركُضُ في مِضمارِ إضماري",44,"ر",2,0],["لمّا غدا من أبيكم واضِعاً يَدَهُ","مَجداً على ظَهْرِ خيرِ البدْوِ والحضَر",45,"ر",1,0],["لَمّا غَزَت أَرواحَنا","حَمَلَت مَحاسِنَها سِلاحا",46,"ح",2,0],["لمَّا غدا فَرجٌ بِسا","حَتِها يُفرِّجُ كلَّ غُمَّه",47,"م",2,0],["لمّا غوَت حَوّاءُ أَغوت آدماً","فكسا بنيهِ الرُزءَ والبلواءَ",48,"ا",2,0],["لم أغْتَبِطْ فيه بفا","ئِدةٍ ولم أخشَ الرّزايا",49,"ا",3,0],["لما غدا من كل شينٍ حسنهُ","متبرئا فأمات حرف الشينِ",50,"ن",1,0],["لما غدَتْ عيسُها تمشي على مَهَلٍ","نادَيْتُ من حُرَقٍ هل في الورى أحدُ",51,"د",1,0],["لِمَ أُغمدتْ عن نصره أسيافُكم","ولسانُه من دونكم مسلولُ",52,"ل",1,0],["لما غدت عيونُه","تصغُر عن تتبُّعي",53,"ع",2,0],["لما غَدا بِهْروزُ مُتَّقياً","ربَّ العُلى في السر والجهرِ",54,"ر",1,1],["لم أغيبك طرفة العين عني","ولقد يفقد الحبيب الحبيب",55,"ب",1,0],["لما غدت صعدته منآدة","ثقفتم المائل من صعاده",56,"د",2,0],["لما غدوتم أمة وحدكم","غدوت فيكم أمة وحدي",57,"د",2,0],["لما غدا تاجاً لمفرق عزه ال","سامي وعقداً في ترائب نحره",58,"ر",2,0],["لما غدوت أبا المهند عندهم","سر الضمير وفارس المضمار",59,"ر",1,0],["لما غدت خسارتي لربحه","أفسدت حالي بصلاح حاله",60,"ل",2,0],["لم أَغْتَمِضْ طُولَها حَتَّى انْقَضَتْ","أكلؤُها بَعْدَما نامَ السَّليِمْ",61,"م",1,0],["لَمّا غَدَوتَ إِلى الأَعداءِ مُطَّلِعاً","غَيرَ الجَبانِ عَلَيها لا تُباليها",62,"ي",3,0],["لما غدوت لوصلكم متعرضا","يا سادة فيهم على طبق القضا",63,"ض",2,0],["لما غدا الريقُ منه عذباً","مالت إلى رشفه الغصون",64,"ن",1,0],["لَمّا غَدَتْ وجْنَتُهُ جَنَّةً","مَحْفُوفَةً بالوَرْدِ والنَّرجِسِ",65,"س",1,0],["لَمّا غَدا مُخلّصاً مِن شِدَّه","مَرَّت عَلى الكُلّ بِثَغر جدَّه",66,"ه",1,0],["لمّا غَدا بي مُشفِقاً","حملَ الفنارَ ليُرشدا",67,"د",2,0],["لما غدا بنيان نفعَا هدمُه","أولى وأبقي هَدَّ ما قد شيّدُوا",68,"د",3,0],["لما غدت هدف البلى","أصبحت للبلوى هدف",69,"ف",1,0],["لم اغتنم فيها النهوض إلى العلى","وعلى التحرك قامت الأسباب",70,"ب",1,0],["لما غَدَوتَ وماءُ العينِ ملتًفتٌ","إلا إلى منظرٍ يُبهِي ويُحتَبَرُ",71,"ر",1,0],["لما غدا الدّيكُ في علياء مشرفةٍ","يحثُّنا يزميرٍ بعدَ تصفيقِ",72,"ق",1,0],["لما غدا قازان فخاراً بما","قد نال بالأمس وأغراه البطر",73,"ر",1,1],["لما غدا تحمله بغلةٌ","معتجراً كالقمر الأزهر",74,"ر",1,0],["لما غدوت مليك الأرض أفضل من","جلت مفاخره عن كل إطراء",75,"ا",2,1],["لَمّا غَزَت حَرَمي سودُ الحَوادِثُ في","جَيشِ النَجاشي وَالأَيّامُ تَختانُ",76,"ن",1,0],["لما غدوت مديرها فملأتها","عدلا يعز لدى الزمان نظيره",77,"ر",2,0],["لما غدت صحف أوزاري مسودةً","بك التجأت لكي يبيض ما فيها",78,"ي",3,0],["لمّا غلا عظمٌ به فكأنه","من حسن بنيته قضيب نُضارِ",79,"ر",1,0],["لما غدا في سيرهِ","ملازما للمنطقَه",80,"ق",2,0],["لَما غَدا وَعِقاب النَصر في يَده","كَاللَيث يَضرب يُمناها بِيُسراها",81,"ا",3,0],["لما غدا فرعون في سطوة","خشيته خشية موسى الكليم",82,"م",1,0],["لما غدا جانب الزوراء يلعب بي","ولا استقلت برحلي الجلة الشرف",83,"ف",1,0],["لَما غَدا المِقياسُ مقسِمَ رَحمَةٍ","يُحيي الرعيّةَ فيضُها المُتدفِّقُ",84,"ق",1,0],["لما غدا وِترُ الوَرَى صَدرَ الوَرَى","صَدَرَ الحسودُ وصَدرُهُ موتورُ",85,"ر",1,0],["لَما غَنّت مطوّقة سُحيراً","بِغير تَرنمي وَسِوى نَشيدي",86,"د",2,0],["لمَّا غَفَا فيها النَّباتُ سُحْرَةً","دَغْدَغَهُ نَسِيمُها فانْتَبَها",87,"ه",2,0],["لما غدوت به أسير","لا تستطيع بأن تطير",88,"ر",1,0],["لما غدا جمكم عنا يميزكم","جاءت تمزينا الاخلاق والشيم",89,"م",1,0],["لما غدوت بعيدة عن ناظري","أضحي فؤادي في الهوى يرعاك",90,"ك",1,0],["لما غدوت بصرف الدهر مكترثا","من قال يعبث مر الريح بالجبل",91,"ل",1,0],["لما غدت بفناء مجدك تجتلي","مالت كغصن البانة الميال",92,"ل",1,0],["لما غرستهُ في الفؤادِ وانفجرت","مياهُ عيني ونارُ القلبِ تضطرِمُ",93,"م",1,0],["لما غدا يستخف رضوى","تيهاً وكبراً لجهد ربه",94,"ب",2,1],["لمَّا غَزا مَدائِناً عَظِيمَه","فيها بنو زَفسِ العُلى مُقِيمَه",95,"ه",1,0],["لم أغالِ به وإن كمالاً","كاسمِه فهو في الكمال إمام",96,"م",1,0],["لما غَدت أَيّامُكُم غرر المُنى","وافى لِيشرف بِالبَلقاء العيد",97,"د",1,0],["لما غدا بربه مأنوسا","من القبول وعظيم المِنَنِ",98,"ن",1,0],["لم أغتفر ذنبا لهن اتيته","إلا بسير في المهامه أحوذ",99,"ذ",1,0],["لما غدا مُعلناً شعارُ بني ال","عبّاسِ حقّاً والباطل اكتتما",100,"م",2,0],["لما غدا بالرمس أرخ راقداً","بكت الفوارس فارساً كرّارا",101,"ر",2,0],["لما غدت دار الأمان سعيدةً","قلنا بها نعم الأمير أميرُها",102,"ر",3,0],["لما غادرتمُ الركبان تسري","فهل حرّاسكم كانوا سكارى",103,"ر",2,0],["لما غلاما أرخصت من وصله","أرخصتُ مِن دُرِّ الدُموعِ ما غلا",104,"ا",1,0],["لَم أَغفُ مفتَكِراً ببطلان الَّذي","شاهدتُهُ ناهيكَ بِالبُطلانِ",105,"ن",1,0],["لَمّا غَدا مِن ذِكرِهِ لِحَبيبِهِ","في كُلِّ آنٍ لا يَزالُ يَراهُ",106,"ا",2,0],["لَمَّا غَدَوْتَ تُقِلُّ في إرسالها","أهمَلْتَ نَبْعَ مَحَبةٍ لِعُيُونِي",107,"ن",2,0],["لمَّا غدا للمؤمنين بشارة","وغدا لحشد الكافرين عقابا",108,"ب",2,0],["لماغشانا وكان الامن يغمرنا","في ليلة ماعهدناها مدى الحقب",109,"ب",1,0],["لما غدا متقحما","لجج المنون ولم يهب",110,"ب",1,0],["لما غدت في خده","ما قال جار ولا قسط",111,"ط",1,0],["لما غدا يهتز تحت حسامه","في كفه عن هزة استهتار",112,"ر",1,0],["لما غدونا أسودَ الشرق نقطعه","لما غ