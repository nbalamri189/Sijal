{"poems":[[53,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[3,"أبني زبيبة ما لمهركم","https://www.aldiwan.net/poem97.html",""],[77,"يا حسنها من أربع وديار","https://www.aldiwan.net/poem36462.html","الكامل"],[27,"راح الرفاق ولم يرح مرار","https://www.aldiwan.net/poem5742.html","الكامل"],[72,"وصارم كعباب الموج ملتمع","https://www.aldiwan.net/poem19376.html","البسيط"],[51,"يا خالد بن الخالدات مخازيا","https://www.aldiwan.net/poem7964.html","الكامل"],[51,"يوم كأن سماءه تحكي جفوني حين بنتا","https://www.aldiwan.net/poem8684.html","مجزوء الكامل"],[70,"أنا في أوسع عذري","https://www.aldiwan.net/poem42898.html","مجزوء الرمل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[45,"ما قام لكي لعجل حين زاحفها","https://www.aldiwan.net/poem62678.html","البسيط"],[66,"لما غدا سلطان حسنك في البها","https://www.aldiwan.net/poem38459.html","الكامل"],[44,"نبئت عتبة شاعر الغوغاء","https://www.aldiwan.net/poem30073.html","الكامل"],[44,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[81,"ردوا على طرفي النوم الذي سلبا","https://www.aldiwan.net/poem61557.html","البسيط"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"لما غدا الثعلب في اعتدائه","https://www.aldiwan.net/poem10417.html","الرجز"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[76,"في الكلة الصفراء ريم أبيض","https://www.aldiwan.net/poem38838.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43721","المجتث"],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[110,"العام أقبل ممحلا","https://www.aldiwan.net/poem16725.html","مجزوء الكامل"],[121,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[167,"طاب العميد الكندري شمائلا","https://www.aldiwan.net/poem46881.html","الكامل"],[196,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[199,"وروضة عاطر بنفسجها","https://www.aldiwan.net/poem51852.html","المنسرح"],[224,"الشاعران تبارك الغزلان","https://www.aldiwan.net/poem41447.html","الكامل"],[224,"حول خيالك عني","https://www.aldiwan.net/poem41587.html","المجتث"],[271,"مني تحب البنات","https://www.aldiwan.net/poem35261.html","المجتث"],[271,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[272,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[283,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[283,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[283,"لعفاته وعداته من جوده","https://www.aldiwan.net/poem32900.html","الكامل"],[304,"جاء بقد قد ثنته الصبا","https://www.aldiwan.net/poem57874.html","البسيط"],[304,"لما غدا في طافة جالسا","https://www.aldiwan.net/poem58056.html","السريع"],[304,"سلطان حسن إن سطت أجفانه","https://www.aldiwan.net/poem58092.html","الكامل"],[365,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[365,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[365,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[365,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[365,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[365,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[365,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[367,"باح الهوى بك واستراحا","https://www.aldiwan.net/poem16953.html","مجزوء الكامل"],[372,"يا رب يوم ظلت في","https://www.aldiwan.net/poem57153.html","مجزوء الكامل"],[378,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[410,"لما رأيت صروف هذا","https://www.aldiwan.net/poem32056.html","مجزوء الكامل"],[430,"لا تزدري يا عاذلي بمهفهف","https://www.aldiwan.net/poem40536.html","الكامل"],[433,"بان الحبيب فبان الصبر والجلد","https://www.aldiwan.net/poem12477.html","البسيط"],[459,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[459,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[462,"لما غدا بهروز متقيا","https://www.aldiwan.net/poem15166.html","أحذ الكامل"],[501,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[516,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[516,"يا عاضد الدين من المهد","https://www.aldiwan.net/poem12084.html","السريع"],[516,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[516,"أنسيم عرفك أم شميم عرار","https://www.aldiwan.net/poem12150.html","الكامل"],[516,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[547,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[554,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[559,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"]],"verses":[["لَمّا غَدا السَربُ يَعطو بَينَ أَرحُلِنا","ما كانَ فيهِ غَريمُ القَلبِ إِلّاكِ",0,"ك",1,0],["لَمّا غَدَوا وَغَدَت سَطيحَتُهُم","مَلأى وَبَطنُ جَوادِهِم صِفرُ",1,"ر",1,0],["لمّا غدا لحْظاً وهُمْ أجفانُهُ","نابَتْ شِفارُهُمُ عنِ الأشْفارِ",2,"ر",1,0],["لَمّا غَدَوا بِأَغَرَّ أَروَعَ ماجِدٍ","كَالبَدرِ تُستَسقى بِهِ الأَمطارُ",3,"ر",1,0],["لما غدا جدولاً تسقى المنون به","أضحى يشفّ على حافاته العلق",4,"ق",1,0],["لما غدا العارُ الذي سُرْبِلْتَهُ","أحدوثةَ الرُّكبانِ والأَمْلاءِ",5,"ا",2,0],["لمَّا غدتْ كسحائبٍ","أيقظنَ بالعبراتِ نَبْتَا",6,"ت",2,0],["لَم أَغِب عَنكَ اِختِياراً","إِنَّما ذاكَ لَأَمري",7,"ر",2,0],["لَم أَغشَ مَغناكِ إِلّا في غُضونِ كِرىً","مَغناكَ أَبعَدُ لِلمُشتاقِ مِن إِرَمِ",8,"م",1,0],["لَمّا غَدا بَكرُ بَكرٍ في قَساطِلِهِ","غَدا بَنو حَسَنٍ فيها بَني سَمَجِ",9,"ج",1,0],["لما غدا سلطان حسنك في البها","فردا وحاذر لحظ كل متيم",10,"م",1,1],["لَمّا غَضِبتُ عَلى القَريضِ هَجَوتُهُ","وَجَعَلتُ خِلقَتَهُ هِجاءَ هِجائي",11,"ا",2,0],["لَمّا غَدا مُظلِمَ الأَحشاءِ مِن أَشَرٍ","أَسكَنتَ جانِحَتَيهِ كَوكَباً يَقِدُ",12,"د",1,0],["لم أَغِبْ عن أُحُدٍ لولا أبي","يا رسولَ اللهِ والجَدِّ النَّكِدْ",13,"د",1,0],["لَمّا غَرَبتَ عَجَمتُ الصَبرَ أَسبُرُهُ","فَلَم أَجِد عودَهُ نَبعاً وَلا غَرَبا",14,"ب",2,0],["لَمَّا غَفَرْتُ لَهُ ذَنْباً وَصُنْتَ دَماً","لولا ذِمامُكَ أَضْحَى وَهْوَ مَطْلُولُ",15,"ل",1,0],["لَمّا غَدا الثَعلَبُ في اِعتِدائِهِ","وَالأَجَلُ المَقدورُ مِن وَرائِهِ",16,"ا",3,1],["لَمّا غَدا الثَعلَبُ مِن وِجارِهِ","يَلتَمِسُ الكَسبَ عَلى صِغارِهِ",17,"ر",2,1],["لمَّا غَدا بَينَ الحُمُولِ مُقَوَّضاً","كادَ الفُؤادُ عَنِ الحياةِ يُقَوّضُ",18,"ض",1,0],["لما غَزاها قائدُ الأَميرِ","باليُمنِ في لِوائهِ المنْصورِ",19,"ر",1,0],["لمّا غَزا إلى بني ذي النُّونِ","فكانَ فتحا ًلم يَكُن بالدُّونِ",19,"ن",1,0],["لَم أُغَمِّض طولَهُ حتَّى انقَضَى","أَتَمَنَّى لَو أَرَى الصُّبحَ جَشَر",20,"ر",1,0],["لَمّا غَدا يَتَشَكّى","كَسلانُ وَهوَ نَشيطُ",21,"ط",1,1],["لَم أُغَمِّض طولَهُ حَتّى اِنقَضى","أَتَمَنّى لَو أَرى الصُبحَ حَسَر",22,"ر",1,0],["لَما غَلت أَسعارهم","ناديت أَرخصهُ غَلا",23,"ل",2,0],["لما غدا موسى إلى ربه","أضل إسرائيل من فوره",24,"ر",2,0],["لما غَدا جَيحونُ طوعَ مُرادِهِ","كيفَ اقتْضاهُ جامداً أو سائِلا",25,"ل",2,0],["لَمّا غَدا الحَيُّ مِن صُرخٍ وَغَيَّبَهُم","مِنَ الرَوابي الَّتي غَربِيُّها الكُمَمُ",26,"م",1,0],["لما غَذَتْها السحابُ دِرَّتها","من فوقِ حوذانها ونرجسها",27,"س",3,0],["لَم أَغتَصِب حِبَرَ الكَلامِ وَإِنَّما","عَينايَ مِن عَينَيكِ تَغتَرِقانِ",28,"ن",1,0],["لَم أَغشَ في النَفسِ مَأثَم","وَلم أُنادم رجالَك",29,"ك",1,0],["لم أُغرِهنَّ ولكن","لي عندهنَّ هِنات",30,"ت",1,0],["لما غَدا رَعدُ المدافعِ قاصفاً","بحرابهم وشِفارهم صانوك",31,"ك",1,0],["لما غدا واعظا صموا فَخالطهم","بالسَيف بأسا فَلبى السيف اذ شهرا",32,"ر",2,0],["لَما غَدا راسِخاً في العِلمِ أَظهَرَهُ","وَالشَمسُ لا شَيءَ يَومَ الصَحوِ يخفيها",33,"ي",3,0],["لَمّا غَدا في كُلِّ حالاتِهِ","مُبارَكَ الطَّلعَةِ مَيمونا",34,"ن",2,0],["لَمّا غَدا المَنصورُ أَفضَلَ سَيِّدٍ","في فَضلِهِ نالَ المُنى الفُضَلاءُ",35,"ا",2,0],["لما غدا في لينه واحداً","أضحت له ريح الصبا ثانيه",36,"ه",1,0],["لما غدا في طافة جالسا","شباكها قد زاد قلبي جنون",37,"ن",1,1],["لما غدا من حسنه في موكب","حملت له نفس المتيم غاشيه",38,"ه",1,0],["لمّا غدا حَسناً ما أنت فاعِلُه","قُلنا بفِعلكِ قد أصبَحْتَ مكتَنيا",39,"ي",2,0],["لَمّا غدا الأسيافُ من شَرَفٍ","فيها معَ الأقلام تَخْتَصِم",40,"م",1,0],["لمّا غدا عِقْدُ آدابٍ به انْتظمَتْ","أشتاتُها جعلَتْه تاجَ أمْلاكِ",41,"ك",1,0],["لمّا غدا وَزَرَ الخِلافةِ رأْيُه","مدَّ الزّمانُ إليه كفَّ مُبايع",42,"ع",1,0],["لمّا غدا شَمساً وكان زَمانُنا","ليلاً وقَلّ اللّيلُ عنْ إشْماس",43,"س",1,0],["لمّا غدَتْ خَيلُ اشتِياقي لكم","تَركُضُ في مِضمارِ إضماري",44,"ر",2,0],["لمّا غدا من أبيكم واضِعاً يَدَهُ","مَجداً على ظَهْرِ خيرِ البدْوِ والحضَر",45,"ر",1,0],["لَمّا غَزَت أَرواحَنا","حَمَلَت مَحاسِنَها سِلاحا",46,"ح",2,0],["لمَّا غدا فَرجٌ بِسا","حَتِها يُفرِّجُ كلَّ غُمَّه",47,"م",2,0],["لمّا غوَت حَوّاءُ أَغوت آدماً","فكسا بنيهِ الرُزءَ والبلواءَ",48,"ا",2,0],["لم أغْتَبِطْ فيه بفا","ئِدةٍ ولم أخشَ الرّزايا",49,"ا",3,0],["لما غدا من كل شينٍ حسنهُ","متبرئا فأمات حرف الشينِ",50,"ن",1,0],["لما غدَتْ عيسُها تمشي على مَهَلٍ","نادَيْتُ من حُرَقٍ هل في الورى أحدُ",51,"د",1,0],["لِمَ أُغمدتْ عن نصره أسيافُكم","ولسانُه من دونكم مسلولُ",52,"ل",1,0],["لما غدت عيونُه","تصغُر عن تتبُّعي",53,"ع",2,0],["لما غَدا بِهْروزُ مُتَّقياً","ربَّ العُلى في السر والجهرِ",54,"ر",1,1],["لم أغيبك طرفة العين عني","ولقد يفقد الحبيب الحبيب",55,"ب",1,0],["لما غدت صعدته منآدة","ثقفتم المائل من صعاده",56,"د",2,0],["لما غدوتم أمة وحدكم","غدوت فيكم أمة وحدي",57,"د",2,0],["لما غدا تاجاً لمفرق عزه ال","سامي وعقداً في ترائب نحره",58,"ر",2,0],["لما غدوت أبا المهند عندهم","سر الضمير وفارس المضمار",59,"ر",1,0],["لما غدت خسارتي لربحه","أفسدت حالي بصلاح حاله",60,"ل",2,0],["لم أَغْتَمِضْ طُولَها حَتَّى انْقَضَتْ","أكلؤُها بَعْدَما نامَ السَّليِمْ",61,"م",1,0],["لَمّا غَدَوتَ إِلى الأَعداءِ مُطَّلِعاً","غَيرَ الجَبانِ عَلَيها لا تُباليها",62,"ي",3,0],["لما غدوت لوصلكم متعرضا","يا سادة فيهم على طبق القضا",63,"ض",2,0]]}