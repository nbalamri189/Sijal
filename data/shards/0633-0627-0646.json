{"poems":[[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"سأنزل حاجاتي إذا طال حبسها","https://www.aldiwan.net/poem30453.html","الطويل"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[3,"إِذا كان دمعي شاهدي كيف أجحَدُ","https://www.aldiwan.net/poem155.html",""],[55,"أيا معرضا عني ولم أجترم ذنبا","https://www.aldiwan.net/poem26517.html","الطويل"],[88,"لهذا اليوم في التأريخ ذكر","https://www.aldiwan.net/poem44990.html","الوافر"],[88,"مضى عبد وهاب الهبات لربه","https://www.aldiwan.net/poem45046.html","الطويل"],[11,"أرسماً جديداً من نوار تعرف","https://www.aldiwan.net/poem261.html",""],[23,"أتاني عن أمي نثا كلام","https://www.aldiwan.net/poem21316.html","الوافر"],[51,"سأنظر نحو دارك حين أخشى","https://www.aldiwan.net/poem61955.html","الوافر"],[51,"إلهي أجرني من شنيف وزيرك","https://www.aldiwan.net/poem64922.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[28,"سأنعى ابن ليلى للذي راح بعده","https://www.aldiwan.net/poem5432.html","الوافر"],[61,"سواء علينا وعدها ووعيدها","https://www.aldiwan.net/poem51714.html","الطويل"],[49,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[50,"تلوم ابنة السعدي في حل عقدة","https://www.aldiwan.net/poem63915.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85472","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/178163","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10390","الطويل"],[11,"أرَسْماً جديداً، من نَوَارَ، تعَرّفُ","https://www.poetsgate.com/ViewPoem.aspx?id=16863",""],[169,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[211,"سلام على الشط الذي كنت نوره","https://www.aldiwan.net/poem46252.html","الطويل"],[211,"خلا جيبي ففارقني رفاقي","https://www.aldiwan.net/poem46253.html","الوافر"],[211,"عيونك ألهبت قلبي وروحي","https://www.aldiwan.net/poem46289.html","الوافر"],[211,"مليح له المرآة أخت حبيبة","https://www.aldiwan.net/poem46298.html","الطويل"],[211,"خلعت عليكم خلعة الحب حقبة","https://www.aldiwan.net/poem46599.html","الطويل"],[211,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[221,"صبرت وما الصبر فيه الشفاء","https://www.aldiwan.net/poem55270.html","المتقارب"],[223,"ذلك اليوم كيف كان وصارا","https://www.aldiwan.net/poem39715.html","الخفيف"],[229,"ولما رأيت الله حض على الشكر","https://www.aldiwan.net/poem51095.html","الطويل"],[235,"عليل الشوق فيك متى يصح","https://www.aldiwan.net/poem32107.html","الوافر"],[237,"هل لذي البعد من تدان يدوم","https://www.aldiwan.net/poem19071.html","الخفيف"],[280,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[328,"بحبي بأشواقي بدمعي الذي همى","https://www.aldiwan.net/poem54998.html","الطويل"],[353,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[364,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[364,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[364,"سأنشر أوصاف المهدب مادحا","https://www.aldiwan.net/poem60993.html","الطويل"],[366,"برأيكم أمسى الزمان مدارا","https://www.aldiwan.net/poem17207.html","الكامل"],[371,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[380,"أرى السحر ما توحيه أجفانه المرضى","https://www.aldiwan.net/poem48828.html","الطويل"],[402,"أتدري من تخرمت المنون","https://www.aldiwan.net/poem46438.html","الوافر"],[406,"أسيلة خد دونه الأسل السمر","https://www.aldiwan.net/poem50165.html","الطويل"],[406,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[409,"سأنفق وفرى في اكتساب مكارم","https://www.aldiwan.net/poem32080.html","الطويل"],[416,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[449,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[453,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[458,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[477,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[479,"دخلت مداخلا لا بد منها","https://www.aldiwan.net/poem37588.html","الوافر"],[495,"كذا من شام بارقة الثنايا","https://www.aldiwan.net/poem10288.html","الوافر"],[500,"من لجسم من لوعة الهجر بالي","https://www.aldiwan.net/poem37923.html","الخفيف"],[553,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"]],"verses":[["سَأَنقُضُ مِن لَيلِ الثَوِيَّةِ وَفرَتي","إِلى مَنزِلٍ لِلدَهرِ فيهِ خُضوعُ",0,"ع",1,0],["سَأُنزِلُ حاجاتي إِذا طالَ حَبسُها","بِأَبوابِ نُوّامٍ عَنِ الحَمدِ وَالأَجرِ",1,"ر",1,1],["سَأَنتَظِرُ الدَهرَ ما دامَ لي","بِوَعدٍ وَأَسأَرُ عِندي اِنتِظارا",2,"ر",2,0],["سَأَندُبُ حَتّى يَعلَمَ الطَيرُ أَنَّني","حَزينٌ وَيَرثي لي الحَمامُ المُغَرِّدُ",3,"د",1,0],["سَأَنهى وَلَكِن لا أُراهُ يُطيعُني","وَأَزجُرُ عَمّا فيهِ سُخطٌ لَكِ القَلبا",4,"ب",2,0],["سأنصِب للهواجر حُرّ وجه","يعود إلى الشروق به الغروب",5,"ب",1,0],["سأنثر دمعي فيك نثر لآلىءٍ","وأنظم شعري في رثائك من درّ",6,"ر",1,0],["سَأَنصُرُهُ إِن كانَ لِلحَقِّ تابِع","وَإِن جارَ لَم يَكثُر عَلَيَّ التَعَطُّفُ",7,"ف",1,0],["سَأَنشُرُ إِن بَقيتُ لَهُ كَلاماً","يُسَيَّرُ في المَجامِعِ مِن عُكاظِ",8,"ظ",1,0],["سأنظرُ نحو دارك حين أخشى","على كبدي التَّفَتُّتَ من بعيدِ",9,"د",1,1],["سأنقشُ سطراً بيِّناً في جبينه","بأن له فصَّي زجاجٍ بلا نقش",10,"ش",1,0],["سأنْثُو نثا آلائكُم آل مصعب","نثا الروضِ آلاء السحاب الهواطلِ",11,"ل",1,0],["سأنْثو ثناكِ الخيرَ لا مُتزيِّداً","على ما جرى بين الصَّحيفة والقلمْ",12,"م",1,0],["سَأَندُبُ ما أَبلَيتُهُ مِن شَبيبَتي","وَأُعوِلُ مِن شَيبي إِلى كُلِّ مُعوَلِ",13,"ل",1,0],["سَأَنعى اِبنَ لَيلى لِلَّذي راحَ بَعدَهُ","يُرَجّي القِرى وَالدَهرُ جَمٌّ غَوائِلُه",14,"ل",2,1],["سأنشُرُ فَضْلاً لا تَزالُ تُديمُهُ","وأُثني بنُعمى لا تزالُ تُفيدُها",15,"د",3,0],["سَأَنعي إِلى الناسِ الشَبابَ الَّذي مَضى","تَخَرَّمَتِ الدُنيا الشَبابَ وَشَيَّبَت",16,"ت",1,0],["سَأُنفِقُ ما نالَت يَدي وَيَهُزُّني","لِبَذلِ النَدى ميراثُ مَن لَم يَكُن وَغدا",17,"د",2,0],["سأَنام في حضن الطَبي","عة فَهيَ لي الأم العَطوف",18,"ف",1,0],["سأنام ثُمَّ أَنام في ملحودة","ضاقَت وَفي ليل عليَّ طَويل",19,"ل",1,0],["سأنشر شكره في يوم حشر","أجل، وعلى الصّراط المستقيم",20,"م",1,0],["سَأَنصُرُهُ إِن كانَ لِلحَقِّ تابِعاً","وَإِن جارَ لَم يَكثُر عَلَيَّ التَعَطُّفُ",21,"ف",1,0],["سأنصره، إن كان للحق نابعاً،","وإنْ جارَ لم يَكْثُرْ عليّ التّعَطّفُ",22,"ف",1,0],["سأُنزِلُها المَلحُودَ أَو رَأسَ هَضبَةٍ","مِنَ العِزِّ يُعيي كُلَّ راقٍ طُلوعُها",23,"ع",3,0],["سأنسى كما تنسى وما تلك بدعة","فما كل نسيان يكون من البصر",24,"ر",1,0],["سأنسى الذي قد كان بيني وبينكم","وإن أصبح النسيان ضربا من الكفر",24,"ر",1,0],["سأنسى كيف أنسى لست أدرى","ففي النسيان أكواب العذاب",25,"ب",1,0],["سأنسى أنني عاقرت يوماً","رحيق هواه كي أنسى صوابي",26,"ي",1,0],["سأنسى سانسى أنني قد عرفتهُ","لأني بجهر الحب فيه بخيل",27,"ل",1,0],["سأنحر قلبي في غد قد نحرتهُ","فلم يبق لي قلبٌ يميم فيوثق",28,"ق",1,0],["سأنسى سأنسى قد نسيت صبابتي","وطلّقتها والعزم كالسهم يمرق",28,"ق",1,0],["سأنساكم يوماً وللقلب رجعةٌ","على جهله للراجحات من الجد",29,"د",1,0],["سأنسى هيامى ثم أنسى غوايتي","وكلّ ضرام في الغرام إلى خمد",29,"د",1,0],["سأنزل عن منصب يقتضي احتكاكي","بشر الورى الأغبياء",30,"ا",2,0],["سَأُنادي في عُزلَتي كُلَّ غَيمٍ","كُلَّ عِطرٍ سَرى وَطَيرٍ طارا",31,"ر",2,0],["سأنشر ما أوليتني من تفضُّل","ثناء كما تُثنِي الرياضُ على القَطْر",32,"ر",1,0],["سَأَنفُضُ مِن جُدى البُخَلاءِ كَفّي","وَإِن لَم يُلفَ مِنهُ لَدَيَّ رَشحُ",33,"ح",1,0],["سَأَنُثُّ حَدِيثَ وَجْدِي وَبَثِّي","لِسَرِيٍّ إِذْ لاَ خَلِيلَ حَمِيمُ",34,"م",1,0],["سَأُنْفِقُ ما بَقِيتُ عَلَيْكَ عُمْرِي","بُكاءً شَأْنُهُ أَبَداً وَشانِي",35,"ي",1,0],["سأنساكِ وهماً أرّقتني طيوفُه","وحسناً وآمالاً وحبّاً محرّما",36,"م",2,0],["سَأَنشُر مَدحكم شَرقاً وَغَرباً","وَبِاللَه الكَريم المُستَعانُ",37,"ن",1,0],["سأنظِمُ في عُلياكَ كُلَّ قصيدةٍ","وقافيةٍ يَسْبى العُقولَ بَديعها",38,"ع",3,0],["سأنَشُر في الآفاقِ عنك مدائحاً","مَحاسِنُ قومٍ عندَها كالمقابح",39,"ح",1,0],["سأنشُرُ أوصافَ المُهدَّب مادحاً","كوَصْفِ نزيلِ المحْل آلَ المُهَلّبِ",40,"ب",1,1],["سَأُنصِفُ أَصنافَ القَوافي بِمَدحِهِ","فَإِنَّ القَوافي في عُلاهُ غَيارى",41,"ر",2,0],["سأنظمُ من سميك فيك عقداً","وأنزِلُ ما تبَقَّى للنثارِ",42,"ر",1,0],["سَأَندُب عَصر الوَصل ما ذَرَ شارِقٌ","فَما كانَ إِلّا كَوكَباً لاحَ وَإِنقَضّا",43,"ض",2,0],["سأنظمُ فيكَ ما يعلو ويغلُو","ويرخُص عندَه الدرُّ الثمينُ",44,"ن",1,0],["سأَنفي الأذى عَنّي وَشيكاتٍ بِفَتيَةٍ","طَعانهمُ نظمٌ وَضربِهُمُ نَثرُ",45,"ر",1,0],["سَأَنفقُ ريعان الشَبيبَة آنِفاً","عَلى طلبِ العَلياء أَو طَلَبِ الأَجرِ",46,"ر",1,0],["سأُنْفِق وفَرْى في اكتسابِ مكارِمٍ","أظَلُّ بها بعد المَماتِ مخلَّدَا",47,"د",2,1],["سأُنزِلُ آمالي بساحة باسلٍ","وما ضيمَ يوماً في حماه نزيل",48,"ل",1,0],["سأنشرها والهندوانيّ شاهدي","وأذكرها والسمهريُّ وكيلها",49,"ه",2,0],["ساندت شعبا بجيش لو صدمت به","شم الحبال لغارت أي إغوار",50,"ر",1,0],["سأنبذهم نبذا لقاء جنونهم","فإن جنوني صار أحجى وأحكما",51,"م",2,0],["سأنتظر الزمانَ لها ويوماً","يطيل يدَ الصديق على المعادي",52,"ي",1,0],["ساندت فيها ما عليك صلاحُهُ","وفسادُه إن أصلِحتْ أو أُفسِدتْ",53,"ت",1,0],["سأنشرُ منه ما قد ماتَ دهراً","ويَشكرُني له عَظْمٌ رميمُ",54,"م",1,0],["سأنشر دعوة الدستور فيها","وإن هالت معاكسه وإن ها",55,"ن",3,0],["سأنتاب الوزير فإن أتيحت","زيارته وساعدت القضايا",56,"ا",3,0],["سانِحاتُ البِعادِ تلكَ وكَمْ في ال","بُعْدِ من ناهِضاتِ هَمٍّ ثِقالِ",57,"ل",1,0],["سَأَنقادُ لِلَّذاتِ مُتَّبِعَ الصِبا","لِأُمضِيَ هَمّي أَو أُصيبَ فَتىً مِثلي",58,"ل",2,0]]}