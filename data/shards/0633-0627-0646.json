نقش",10,"ش",1,0],["سأنْثُو نثا آلائكُم آل مصعب","نثا الروضِ آلاء السحاب الهواطلِ",11,"ل",1,0],["سأنْثو ثناكِ الخيرَ لا مُتزيِّداً","على ما جرى بين الصَّحيفة والقلمْ",12,"م",1,0],["سَأَندُبُ ما أَبلَيتُهُ مِن شَبيبَتي","وَأُعوِلُ مِن شَيبي إِلى كُلِّ مُعوَلِ",13,"ل",1,0],["سَأَنعى اِبنَ لَيلى لِلَّذي راحَ بَعدَهُ","يُرَجّي القِرى وَالدَهرُ جَمٌّ غَوائِلُه",14,"ل",2,1],["سأنشُرُ فَضْلاً لا تَزالُ تُديمُهُ","وأُثني بنُعمى لا تزالُ تُفيدُها",15,"د",3,0],["سَأَنعي إِلى الناسِ الشَبابَ الَّذي مَضى","تَخَرَّمَتِ الدُنيا الشَبابَ وَشَيَّبَت",16,"ت",1,0],["سَأُنفِقُ ما نالَت يَدي وَيَهُزُّني","لِبَذلِ النَدى ميراثُ مَن لَم يَكُن وَغدا",17,"د",2,0],["سأَنام في حضن الطَبي","عة فَهيَ لي الأم العَطوف",18,"ف",1,0],["سأنام ثُمَّ أَنام في ملحودة","ضاقَت وَفي ليل عليَّ طَويل",19,"ل",1,0],["سأنشر شكره في يوم حشر","أجل، وعلى الصّراط المستقيم",20,"م",1,0],["سَأَنصُرُهُ إِن كانَ لِلحَقِّ تابِعاً","وَإِن جارَ لَم يَكثُر عَلَيَّ التَعَطُّفُ",21,"ف",1,0],["سأنصره، إن كان للحق نابعاً،","وإنْ جارَ لم يَكْثُرْ عليّ التّعَطّفُ",22,"ف",1,0],["سأُنزِلُها المَلحُودَ أَو رَأسَ هَضبَةٍ","مِنَ العِزِّ يُعيي كُلَّ راقٍ طُلوعُها",23,"ع",3,0],["سأنسى كما تنسى وما تلك بدعة","فما كل نسيان يكون من البصر",24,"ر",1,0],["سأنسى الذي قد كان بيني وبينكم","وإن أصبح النسيان ضربا من الكفر",24,"ر",1,0],["سأنسى كيف أنسى لست أدرى","ففي النسيان أكواب العذاب",25,"ب",1,0],["سأنسى أنني عاقرت يوماً","رحيق هواه كي أنسى صوابي",26,"ب",2,0],["سأنسى سانسى أنني قد عرفتهُ","لأني بجهر الحب فيه بخيل",27,"ل",1,0],["سأنحر قلبي في غد قد نحرتهُ","فلم يبق لي قلبٌ يميم فيوثق",28,"ق",1,0],["سأنسى سأنسى قد نسيت صبابتي","وطلّقتها والعزم كالسهم يمرق",28,"ق",1,0],["سأنساكم يوماً وللقلب رجعةٌ","على جهله للراجحات من الجد",29,"د",1,0],["سأنسى هيامى ثم أنسى غوايتي","وكلّ ضرام في الغرام إلى خمد",29,"د",1,0],["سأنزل عن منصب يقتضي احتكاكي","بشر الورى الأغبياء",30,"ا",2,0],["سَأُنادي في عُزلَتي كُلَّ غَيمٍ","كُلَّ عِطرٍ سَرى وَطَيرٍ طارا",31,"ر",2,0],["سأنشر ما أوليتني من تفضُّل","ثناء كما تُثنِي الرياضُ على القَطْر",32,"ر",1,0],["سَأَنفُضُ مِن جُدى البُخَلاءِ كَفّي","وَإِن لَم يُلفَ مِنهُ لَدَيَّ رَشحُ",33,"ح",1,0],["سَأَنُثُّ حَدِيثَ وَجْدِي وَبَثِّي","لِسَرِيٍّ إِذْ لاَ خَلِيلَ حَمِيمُ",34,"م",1,0],["سَأُنْفِقُ ما بَقِيتُ عَلَيْكَ عُمْرِي","بُكاءً شَأْنُهُ أَبَداً وَشانِي",35,"ن",2,0],["سأنساكِ وهماً أرّقتني طيوفُه","وحسناً وآمالاً وحبّاً محرّما",36,"م",2,0],["سَأَنشُر مَدحكم شَرقاً وَغَرباً","وَبِاللَه الكَريم المُستَعانُ",37,"ن",1,0],["سأنظِمُ في عُلياكَ كُلَّ قصيدةٍ","وقافيةٍ يَسْبى العُقولَ بَديعها",38,"ع",3,0],["سأنَشُر في الآفاقِ عنك مدائحاً","مَحاسِنُ قومٍ عندَها كالمقابح",39,"ح",1,0],["سأنشُرُ أوصافَ المُهدَّب مادحاً","كوَصْفِ نزيلِ المحْل آلَ المُهَلّبِ",40,"ب",1,1],["سَأُنصِفُ أَصنافَ القَوافي بِمَدحِهِ","فَإِنَّ القَوافي في عُلاهُ غَيارى",41,"ر",2,0],["سأنظمُ من سميك فيك عقداً","وأنزِلُ ما تبَقَّى للنثارِ",42,"ر",1,0],["سَأَندُب عَصر الوَصل ما ذَرَ شارِقٌ","فَما كانَ إِلّا كَوكَباً لاحَ وَإِنقَضّا",43,"ض",2,0],["سأنظمُ فيكَ ما يعلو ويغلُو","ويرخُص عندَه الدرُّ الثمينُ",44,"ن",1,0],["سأَنفي الأذى عَنّي وَشيكاتٍ بِفَتيَةٍ","طَعانهمُ نظمٌ وَضربِهُمُ نَثرُ",45,"ر",1,0],["سَأَنفقُ ريعان الشَبيبَة آنِفاً","عَلى طلبِ العَلياء أَو طَلَبِ الأَجرِ",46,"ر",1,0],["سأُنْفِق وفَرْى في اكتسابِ مكارِمٍ","أظَلُّ بها بعد المَماتِ مخلَّدَا",47,"د",2,1],["سأُنزِلُ آمالي بساحة باسلٍ","وما ضيمَ يوماً في حماه نزيل",48,"ل",1,0],["سأنشرها والهندوانيّ شاهدي","وأذكرها والسمهريُّ وكيلها",49,"ه",2,0],["ساندت شعبا بجيش لو صدمت به","شم الحبال لغارت أي إغوار",50,"ر",1,0],["سأنبذهم نبذا لقاء جنونهم","فإن جنوني صار أحجى وأحكما",51,"م",2,0],["سأنتظر الزمانَ لها ويوماً","يطيل يدَ الصديق على المعادي",52,"د",2,0],["ساندت فيها ما عليك صلاحُهُ","وفسادُه إن أصلِحتْ أو أُفسِدتْ",53,"ت",1,0],["سأنشرُ منه ما قد ماتَ دهراً","ويَشكرُني له عَظْمٌ رميمُ",54,"م",1,0],["سأنشر دعوة الدستور فيها","وإن هالت معاكسه وإن ها",55,"ن",3,0],["سأنتاب الوزير فإن أتيحت","زيارته وساعدت القضايا",56,"ا",3,0],["سانِحاتُ البِعادِ تلكَ وكَمْ في ال","بُعْدِ من ناهِضاتِ هَمٍّ ثِقالِ",57,"ل",1,0],["سَأَنقادُ لِلَّذاتِ مُتَّبِعَ الصِبا","لِأُمضِيَ هَمّي أَو أُصيبَ فَتىً مِثلي",58,"ل",2,0],["سَأَندِبُهُ لا زاخِراً دَرَّ مَدمَعُ","وَلا سامِعاً في الحُزنِ لَومَةً لائِمِ",59,"م",1,0],["سَأَنقع مِمَن خانَت العَهد غلتي","وَهَيهات ما غَير الحَمام بِناقع",60,"ع",1,0],["سَأنقُشُ في غُرَّةِ الشَّمسِ مِنكَ","مَحاسِنَ مُعجِزَةً من نَقَش",61,"ش",1,0],["سأنشد قبراً حل فيه رثاءه","وأسمع ما أمليه صم الجنادل",62,"ل",1,0],["سأنشرُ في الورى ذكراك حتى","يفوحَ بكل ناحيةٍ شذاكا",63,"ك",2,0],["ساندبهُ ما عشتُ دهري وأنهُ","جديرٌ بأَن يُبكَي على فقدهِ دهرا",64,"ر",2,0],["سَأَنشُر مِنهُ في الدَواوين لِلوَرى","سجلّاً فَلا أَطويهِ إِلّا عَلى الثَنا",65,"ن",2,0],["سانسج من حسن الثناء لمجده","طرازا يسدى بالنجوم ويلحم",66,"م",1,0],["سأنْسَلُّ طوعاً من يد الحبِّ أو كَرْها","فخذْ طُرُقَ الهجرانِ إن شئتَ أو ذرها",67,"ه",2,1],["سَأنتقي الحَرفَ مثلَ الطيرِ مُنتقِياً","غُصْناً وحَاشَا يُعيقُ الطائِرَ الغُصُنُ",68,"ن",1,0],["سأنبيك أشواقي وفرط صبابَتي","فإن أنت لم ترحم محبكم حسبي",69,"ب",2,0],["سأنفق أيامي البواقي بحسرة","تمزّق قلبي أينما كنت ثاويا",70,"ي",2,0],["سَآنف نَفسي أينَما كنت زارني","على طمعٍ للأرذلين منادِما",71,"م",2,0],["سَأَنْعَى أبا عَمْروٍ بِكلّ مُثَقّفٍ","وبِيضٍ لها في الدّارعينَ صَليلُ",72,"ل",1,0],["سأنقل من دار المآثم والدها","إِلى حيث لا نكرٌ يشين ولا مكر",73,"ر",1,0],["سأنْسى الورى الخنساءَ حُزْناً وحَسْرَةً","ويخجلُ من وَجدي عليهم متمّمُ",74,"م",1,0],["سأندُبُ عَهداً مضى للصِّبا","وابكي الشبابَ بُكاءً طويلا",75,"ل",2,0],["سَأَنفُثُ وَالمَصدُورُ لا شَكَّ نَافِثُ","وَأُسمِعُ إِن أَصغَت إِلَيَّ الحَوَادِثُ",76,"ث",1,1],["سأنشد لا عجزاً ولكن تحمساً","ليَ الله أيّ الحادثات أصانع",77,"ع",1,0],["سأنبئ من عن دينه جاء يسأل","وقاتل نفس آمنت كيف يفعل",78,"ل",1,1],["سانَدوهُ إِذا لَم يَرَوهُ","شُدَّ أَجلادُهُ عَلى التَسنيدي",79,"د",2,0],["سأندبُهُ نَدْبَ الَثواكلِ حَسْرَةً","وأبكيهِ من شَجْوٍ بكاء الحمائمِ",80,"م",1,0],["سانظم بعد بعدك كل يوم","قصيداً في مديحك مستجادا",81,"د",2,0],["سأنشد بيتاً نابغيّاً معظماً","تردِّده خوفاً وبأسك سامع",82,"ع",1,0],["سأنفق ما لي على لذتي","وأوثر نفسي على الوارث",83,"ث",1,0],["سأنسى عذاباً كان حبك أصله","وسيان عفواً كان ذ