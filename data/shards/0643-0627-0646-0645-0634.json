{"poems":[[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[31,"كأن مشنقا غول أضلت","https://www.aldiwan.net/poem6180.html","الوافر"],[58,"وكأس صهباء صرف ما سرت بيد","https://www.aldiwan.net/poem58659.html","البسيط"],[51,"ألا أين الألى سلفوا","https://www.aldiwan.net/poem62179.html","البسيط"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[7,"أتارِكَة ٌ تدَلَلّهَا قَطامِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17593",""],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[287,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[514,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140065",""],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115799","الطويل"],[4859,"قمة الخذلان!","https://www.poetsgate.com/ViewPoem.aspx?id=197030",""],[5419,"عذراً رسولَ الله","https://www.poetsgate.com/ViewPoem.aspx?id=32217",""]],"verses":[["كَأَنَّ مِشيَتَها مِن بَيتِ جارَتِها","مَرُّ السَحابَةِ لا رَيثٌ وَلا عَجَلُ",0,"ل",1,0],["كَأَنَّ مُشَنَّقاً غولٌ أَضَلَّت","بَنيها عِندَ أَخبِيَةِ التِجارِ",1,"ر",1,1],["كأنَّ مِشْيَتَها في جِسْمِ شَارِبِها","تَمَشِّيَ الصُّبْحِ في أَحْشَاءِ ظَلْماءِ",2,"ا",2,0],["كَأَنَّ مُشَيِّعيكَ وَقَد","رَمَوا بِكَ ثَمَّ وَانصَرَفوا",3,"ف",3,0],["كَأَنَّ مُشَعشَعاً مِن خَمرِ بُصرى","نَمَتهُ البُختُ مَشدودَ الخِتامِ",4,"م",1,0],["كَأَنَّ مَشمولَةً صِرفاً بِريقَتِها","مِن بَعدِ رَقدَتِها أَو شَهدَ مُشتارِ",5,"ر",1,0],["كأنّ مُشَعْشَعاً مِنْ بُصرَى","، نَمَتْهُ البُخْتُ، مَشدودَ الختامِ",6,"م",1,0],["كَأَنَّ مَشيدَ السُّورِ شَاءَ انْهِدَادَهُ","ليظْفَر بالأَشْقَى عَلَى يَدِهِ الأَتْقَى",7,"ق",2,0],["كَأَنَّ مِشمِشَها في دَوحِهِ ثَمَرُ ال","جِنانِ تَجنيهِ مِنها كَفُّ جانيهِ",8,"ي",2,0],["كان مشيباً ضلّ عن نهجه","فدلَّه الحبُّ على مَفرِقي",9,"ق",2,0],["كأنَّ مِشْيَتَها والثِّقْلُ يَغْلِبُها","غُصْنٌ إذا حرَّكَتْهُ الرِّيحُ يطَّرِدُ",10,"د",1,0],["كان مشيبه لما تولى","على جيش الصبا ولى انهزاما",11,"م",2,0],["كأنّ مشيبي واخضرار عذارهِ","إذا ما التقينا ياسمينٌ وريحان",12,"ن",1,0],["كان مشكاةً لحلمٍ نلتَهُ","وملاذَ القلبِ إن حارتْ خطاك",13,"ك",1,0],["كأنّ مشيتَك القرآنُ من ألقٍ","أو أنَّ جِلسَتَك الأنوارُ للحجبِ",14,"ب",1,0]]}