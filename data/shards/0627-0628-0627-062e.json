{"poems":[[65,"أبا خالد كم تدعي لي مودة","https://www.aldiwan.net/poem45859.html","الطويل"],[65,"أبا خالد لا تبخس الشعر حقه","https://www.aldiwan.net/poem45880.html","الطويل"],[65,"أبا خالد طال المقام على الأذى","https://www.aldiwan.net/poem45906.html","الطويل"],[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[37,"لا تكفرن قوما عززت بعزهم","https://www.aldiwan.net/poem39129.html","الطويل"],[29,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[49,"عذيري من طوالع في عذاري","https://www.aldiwan.net/poem25252.html","الوافر"],[74,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[40,"ظعنت وودعت الخليط اليمانيا","https://www.aldiwan.net/poem7822.html","الطويل"],[80,"يقولون صبرا لا سبيل إلى الصبر","https://www.aldiwan.net/poem14209.html","الطويل"],[47,"إساءة دهر برحت بي نوائبه","https://www.aldiwan.net/poem11056.html","الطويل"],[47,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[30,"أبا خالد بادت خراسان بعدكم","https://www.aldiwan.net/poem4993.html","الطويل"],[52,"أبا خالد ما زلت سباح غمرة","https://www.aldiwan.net/poem62351.html","الطويل"],[52,"أبا خالد دعني وزنجي خالد","https://www.aldiwan.net/poem63902.html","الطويل"],[52,"أشادن إن ريمة لا تصاد","https://www.aldiwan.net/poem63916.html","الوافر"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[52,"أَبا خالِدٍ دَعْنِي وزنْجِيَّ خالِدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=21807",""],[101,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[131,"أبا خراشة أما أنت ذا نفر","https://www.aldiwan.net/poem24217.html","البسيط"],[211,"أبا خراشة أما كنت ذا نفر","https://www.aldiwan.net/poem27934.html","البسيط"],[216,"أبا خالد ظني لتحفظ غيبتي","https://www.aldiwan.net/poem37912.html","الطويل"],[305,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[454,"أبا خليفة إن الطبع غلاب","https://www.aldiwan.net/poem981.html",""],[454,"مدى كتابك غابات وأنهار","https://www.aldiwan.net/poem983.html",""],[487,"أنخت مطايا الذل نحوك ملقيا","https://www.aldiwan.net/poem24461.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126692","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122722","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122686","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122614","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122759","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122679","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122647","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122689","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122589","الطويل"],[771,"","https://poetry.dctabudhabi.ae/diwan/poem/203650","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145779","المتقارب"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107222","الطويل"],[1380,"","https://poetry.dctabudhabi.ae/diwan/poem/21368","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64617","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141342","البسيط"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45413","الطويل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45412","الطويل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69502","الطويل"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33004","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46744","الطويل"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45335","الطويل"],[2995,"","https://poetry.dctabudhabi.ae/diwan/poem/198812","البسيط"],[3029,"","https://poetry.dctabudhabi.ae/diwan/poem/198796","البسيط"],[3376,"","https://poetry.dctabudhabi.ae/diwan/poem/198757","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130537","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198236","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198214","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/178104","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/178101","البسيط"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96061","الطويل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22807","الطويل"],[4680,"أبا خالدٍ أنت صوت العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185025",""],[5700,"وداعا أبا خلدون","https://www.poetsgate.com/ViewPoem.aspx?id=207483",""],[5956,"محبة جُمِّدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=182037",""]],"verses":[["أَبا خَالِدٍ كَمْ تَدَّعِي لِي مَودَّةً","أَرى النَّظَراتِ الشُّوسَ تُبْدي نَقيضَها",0,"ه",2,1],["أَبا خالِدٍ لا تَبْخَسِ الشِّعْرَ حَقَّهُ","فَتَقْتَصَّ مِنْكَ الشّارِداتُ الأَوابِدُ",1,"د",1,1],["أَبا خالدٍ طالَ المُقامُ على الأذى","وَضاقَ بِما تَسْمو لَهُ هِمَمي باعي",2,"ي",1,1],["أبا خالدٍ إنّي تَرَكْتُهُمُ سُدًى","وأحْسابُهُمْ فَوضَى وأعْراضُهُمْ نُهْبى",3,"ب",2,0],["أَبا خُبَثٍ أَكرِم كِنانَةَ إِنَّهُم","مَواليكَ إِن أَمرٌ سَما بِكَ مُعلَقُ",4,"ق",1,0],["أَبا خالِدٍ أَبلَيتَ حَزماً وَسُؤدُداً","وَكُلُّ اِمرِءِ مُثنىً عَلَيهِ بِما يُبلي",5,"ل",2,0],["أَبا خالِدٍ لا تُشمِتَنَّ أَعادِياً","يَوَدّونَ لَو زَلَّت بِمَهلَكَةٍ نَعلي",5,"ل",2,0],["أَباخِلَةٌ عَلَيَّ وَأَنتِ جارٌ","وَواصِلَةٌ عَلى بُعدِ المَزارِ",6,"ر",1,0],["أباخلةً عنِّي بطيف خيالها","عسى ولعلَّ الدهرَ فيك يسامح",7,"ح",1,0],["أَبا خالِدٍ دافَعتَ عَنّي عَظيمَةً","وَأَدرَكتَ لَحمي قَبلَ أَن يَتَبَدَّدا",8,"د",2,0],["أَبا خالِدٍ لا تَنبِذَنَّ نَصاحَةً","كَوَحيِ الصَفا خُطَّت لَكُم في فُؤادِيا",9,"ي",2,0],["أَبا خالِدٍ أَورَثتَني البَثَّ خالِداً","أَبا النَصرِ مُذ وُدّعتَ وَدَّعني نَصري",10,"ر",2,0],["أَبا خالِدٍ لا يَجزِكَ اللَهُ صالِحاً","فَما كُنتَ إِلّا التَيسَ أَخفَقَ حالِبُه",11,"ب",2,0],["أَبا خالِدٍ ما جاوَرَ اللَهُ نِعمَةً","بِمِثلِكَ إِلّا كانَ جَمّاً خُلودُها",12,"د",3,0],["أَبا خالِدٍ بادَت خُراسانُ بَعدَكُم","وَقالَ ذَوُو الحاجاتِ أَينَ يَزيدُ",13,"د",1,1],["أَبا خالِدٍ ما زِلتَ سَبّاحَ غَمرَةٍ","صَغيراً فَلَمّا شِبتَ خَيَّمتَ بِالشاطي",14,"ط",2,1],["أَبا خالِدٍ دَعني وَزِنجِيَّ خالِدٍ","وَقُل في فَتىً ما قَصَّ أَمراً وَلا سَدّا",15,"د",2,1],["أَبا خَلَفٍ لَكَ الشَرَفُ المُعَلّى","وَبَيتُ بَني المُهَلَّبِ وَالعِدادُ",16,"د",1,0],["أبا خليل تركت الأرض موحشة","فما أرى تغرها بالأنس مبتسما",17,"م",2,0],["أَبا خالِدٍ دَعْنِي وزنْجِيَّ خالِدٍ","وقل في فتى ً ما قص أكرا ولا سدا",18,"د",2,1],["أبا خالد أشكو إليك مواجعى","ومثلى له عذرٌ .. ومثلك يعذرُ",19,"ر",1,0],["أَبا خُراشَةَ أَمّا أَنتَ ذا نَفَرٍ","فَإِنَّ قَومِيَ لَم تَأَكُلهُمُ الضَبعُ",20,"ع",1,1],["أَبا خُراشَةَ أَمّا كُنتَ ذا نَفَرٍ","فَإِنَّ قَومِيَ لَم تَأكُلهُمُ الضَبُعُ",21,"ع",1,1],["أبا خالدٍ ظَنّي لتحفظَ غيبتي","وقد خابَ ظَنّي خيبةً إثْرَ خَيْبَةِ",22,"ه",1,1],["أَبا خالِدٍ هَدِّب خميلَكَ لَن تَرى","بِعَينَيكَ وَفداً آخِرَ الدَهرِ جائِيا",23,"ي",2,0],["أبا خليفة إن الطبع غلاب","خليقة في بني الإنسان تنساب",24,"ب",1,1],["أبا خليفة ما زلنا تلامذة","نأتي فيسحرنا نثر وأشعار",25,"ر",1,0],["أبا ختم هذا الدهر يا نقطة غدا","سناها على كل الحروف مجلل",26,"ل",1,0],["أبا خالص إن غِبتَ عنّي فإنّني","مقيمٌ على تلك المودّة والحبِّ",27,"ب",1,1],["أبا خالدٍ دَعوةٌ مِن عَزُوفٍ","إذا قُمتَ قامَ وإن مِلتَ مالا",28,"ل",2,0],["أبا خالدٍ أدعوكَ دَعوةَ خادِمٍ","نَسيبَ رَسُوليٍّ على البابِ واقِفِ",29,"ف",1,1],["أبا خالدٍ بَرَّزتَ في الفَضلِ فانثنى","عُمارَتُه فيما فَعلتَ وعامره",30,"ر",2,0],["أَبا خالِدٍ ما حُلتَ عَمّا عَلِمتُهُ","وَحُلتُ عَنِ الحالِ الَّذي أنتَ عالِمُهُ",31,"م",2,0],["أبا خالِدٍ ما شِئنَ بَعدَك فَلتَكُن","أمُورُ القَضا مَأمُونُها وَمَخُوفُها",32,"ف",3,0],["أبا خالدٍ والقولُ فيهِ حَماسَةٌ","أألهاكَ ما يُلهي وأنساكَ ما يُنسي",33,"س",2,0],["أبا خالدٍ وأبا غانِمٍ","وَخيرَ الوَرى وابنِ خَيرِ السَّلَف",34,"ف",1,1],["أبا خالدٍ إن تُدعَ للبأسِ والنَّدى","فأنتَ وأيمُ اللهِ أسمعُ مِن خَلد",35,"د",1,0],["أبا خالدٍ للِلبَحرِ جَزرٌ ولم تزل","إذا جَزُرَت تلك البِحارُ على مَدّ",35,"د",1,0],["أبا خليفة يا عزما ويا أملا","أنت الرجاء الذي نشكوه بلوانا",36,"ن",2,0],["أبا خالدٍ يا لِغيظِ السِّهَام","إذا لمْ تجِدْ لاصطدامٍ سَبيلا",37,"ل",2,0],["أبا خالِدٍ غَصَّةُ الذكريات","تزيدُ ذهولَ دِمَانَا ذهولا",37,"ل",2,0],["أَبا خالِدٍ وافَت مُحِبَّكَ تُحفَةٌ","بعثتَ بِهَا لُطفاً لِتَشهَدَ بِالوُدِّ",38,"د",1,1],["أَبا خالِدٍ بادَت خُراسانُ بَعدكُم","وصاحَ ذوو الحاجاتِ أَينَ يَزيدُ",39,"د",1,1],["أبا خليل تركت الأرض موحشة","فما أرى ثغرها بالأنس مبتسما",40,"م",2,0],["أبا خليل وأيام الصّفاء على","جمع الأحبة في ناديك تحويه",41,"ي",2,0],["أَبا خالِدٍ لَم يَبقَ بَعدَكَ سوقَةٌ","وَلا مَلِكٌ مِمَّن يُعينُ عَلى الرَفد",42,"د",1,1],["أَبا خالِدٍ زِدتَ الحَياةَ مَحَبَّةً","إِلى الناسِ إِن كُنتَ الأَميرَ المُتَوَّجا",43,"ج",2,1],["أَبا خالِدٍ ما كانَ أَدهى مُصيبَةً","أَصابَت مَعدّاً يَومَ أَصبَحتَ ثاويا",44,"ي",2,0],["أَبا خالِدٍ لا بَل عَمَمتَ بِنَكبَةٍ","فَتَبكي مَعدٌّ وَالقَبيلُ اليَمانيا",44,"ي",2,0],["أَبا خالِدٍ يا اِنفُر فَلَستَ بِخالِدٍ","وَما جَعَلَ الرَحمنُ عُذراً لِقاعِدِ",45,"د",1,1],["أَبا خالِدٍ حَنَّت إِلَيكَ مَطيَّتي","عَلى بُعدِ مُنتابٍ وَهَولِ جَنانِ",46,"ن",1,0],["أَبا خالِدٍ في الأَرضِ نأيٌ وَمَفسَحٌ","لِذي مِرَّةٍ يُرمى بِهِ الرجَوانِ",46,"ن",1,0],["أَبا خالِدٍ قَد هِجتَ حَرباً مَريرَةً","وَقَد شَمَّرَت حَربٌ عَوانٌ فَشَمِّرِ",47,"ر",1,1],["أبا خليفة ياسراً يساكنني","لا لم تغب، أنت في الفردوس مغتفر",48,"ر",1,0],["أبا خليفة، لو أنفدت محبرتي","وأبحر الشعر ظل الوجد ينتثر",48,"ر",1,0],["أبا خليفةَ دَعوانا إن اشتَجَرَتْ","سود المنايا ورَدَّ الباسل الخطَرُ",49,"ر",1,0],["أبا خليفة يا شعري وبهجته","يا أيها البدر والأقمار والشهب",50,"ب",1,0],["أبٌ أخٌ حَمٌ كذَاكَ وَهنُ","وَالنَّقصُ فِى هَذَا الأخِيرِ أحسَنُ",51,"ن",1,0],["أبا خالد أعني سعيد بن خالد","أخا العرف لا أعني ابن بنت سعيد",52,"د",1,1],["أبَا ((خَليفَةَ)) مِنْ ((لُبْنان)) أرْفَعُها","آياتَ شَوْقٍ وإخْلاصٍ لخيرِ أَبِ",53,"ب",1,0],["أَبا (خَليفَةَ) يا مَنْ لا يُقَاسُ بِهِ","عِزٌّ و((زائِدُ)) فَضْلٍ غَيْرُ مُتْحَجِبِ",53,"ب",1,0],["أبا خليفة يا من نلت مكرمة","ألشعب والجيش إخلاصا يحييكا",54,"ك",2,0],["أبا ((خليفةَ)) يا مَنْ قد غَدَوْتَ لَنا","عِزًّا وَنَحْنُ عَلى صَفوٍ بِلا كدَرِ",55,"ر",1,0],["((أبا خليفةَ)) يا مَنْ لا يُقاسُ به","عِزًّا و((زايدُ)) فَضْلٍ غَيْرُ مُتْحَجَبِ",56,"ب",1,0],["أبا خالدٍ ركني ومن أنا عبدُه","لقد غالني الأعداءُ عمداً لتغضبا",57,"ب",2,1],["أبا خالد أنت المنَوَّهُ باسمِهِ","إذا نزلت بالناس إحدى العظائم",58,"م",1,0],["أبا خالدٍ يا دويَّ المعالي","شموخاً تساميت ترقى لها",59,"ل",3,0],["أبا خالدٍ يا صدى أمّةٍ","وصوتك يوقظ آمالها",59,"ل",3,0],["أَبَا خَلدونَ مَا شَيءٌ مُخلَّدْ","سِوَى أَسفِي عَليكَ وَ أنتَ تُلحَدْ",60,"د",1,0],["أَبَا خَلدونَ يَا جُرحاً بِقلبِيْ","تَفجَّر بَينَ أَضلاعِي فَأقصَدْ",60,"د",1,0],["أَبَا خَلدونَ يَا سَيفاً شَطِيراً","تَجَالدَ يَأسَهُ واليَومَ أُغمِدْ",60,"د",1,0],["أبآخر العمر الجميل سنلتقي؟","هذي غيومُ الأفق منكِ تورَّدَتْ",61,"ت",1,0]]}