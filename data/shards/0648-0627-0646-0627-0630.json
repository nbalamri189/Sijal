{"poems":[[55,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[55,"أبيعك بيع الأديم النغل","https://www.aldiwan.net/poem29857.html","المتقارب"],[95,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[53,"يا ذا الذي ضن بمعروفه","https://www.aldiwan.net/poem65498.html","السريع"],[91,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[60,"إذا أذن الله في حاجة","https://www.aldiwan.net/poem30990.html","المتقارب"],[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[128,"بالنفس يا شيخ من تقواك أشياء","https://www.aldiwan.net/poem23734.html","البسيط"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[458,"ألا تعود سؤال رن في أذني","https://www.aldiwan.net/poem61599.html","البسيط"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128701","الطويل"],[2344,"","https://poetry.dctabudhabi.ae/diwan/poem/131383","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22565","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108106","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85269","الوافر"],[4679,"أيدري الدهر ما فعلت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=142734",""],[4797,"في شاعر المليون","https://www.poetsgate.com/ViewPoem.aspx?id=29427",""],[585,"عليك وإلا ما عقدت رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=161913",""],[5299,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=210542",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5956,"يُقتل الهمُّ بمثلِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182024",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""]],"verses":[["وَإِنَّ أَذى الهُمومِ عَلى فُؤادي","أَضَرُّ مِنَ النُصولِ عَلى أَديمي",0,"م",2,0],["وَإِنَّ أَذَلَّ الأَذَلّينَ مَن","يُريعُ بِبِضعِ النِساءِ الدُوَل",1,"ل",1,0],["وَانْ إِذَا نُهزُ النَّجَاحِ تَبَاطَأَتْ","فَإِذَا تَحَيَّنَهَا فَلَيْسَ بِوَانِ",2,"ن",1,0],["وأن إذا استخبر مستخبرٌ","ما ثوَّبَ المادح قلت القلق",3,"ق",1,0],["وأن أذم عندها","بعد الهوى مجثمي",4,"م",2,0],["وَإِن أَذِنَ اللَهُ في غَيرِها","أَتى دونَها عارِضٌ يَعرِضُ",5,"ض",1,0],["وإنْ أذكى الجوانحَ والضُّلوعا","ولاح سوادهُ فرماهُ رامِ",6,"م",1,0],["وأن آذان نواب البلاد سوى","عن الذي يقتضيه العلج صماء",7,"ا",2,0],["وأنا ذا وهذا هل لكم","في فتى عن أهله مغتربا",8,"ب",2,0],["وإِن أَذْمُمْ عوائِدَ لؤمِ دهري","فَحَيّ عَلَى عوائِدِكَ الكرامِ",9,"م",1,0],["وإن أذُق من حنيني لوعةً فأسىً","على مراتعِ أحلامي مع الزمن",10,"ن",1,0],["وإن أذنت جلالته عليه","فزاحم إن قدرت على الزحام",11,"م",1,0],["وإن أذنوا بالحرب يوما وشنفت","برفع منار الدين منهم مسامع",12,"ع",1,0],["وأنا ذوو قربى وأهل مودة","كما كان إخوان الطريق كذا قبل",13,"ل",1,0],["وإنّا ذحمنا كلّ نجدةٍ سيّدٍ","بَطينٍ ولا يحزنك إلا المهفهَفُ",14,"ف",1,0],["وأنا ذهبت لكي أعودك موقناً","بالرغم عني أن ستهجرنا غدا",15,"د",2,0],["وإن أذكر علاه فسلت أحصي","مزايا من مناقبه عظاما",16,"م",2,0],["وإن أذكت مصيبتهُ حشاها","فكم أذكت محبتها حشاهُ",17,"ا",2,0],["وأنا ذلولي بنت صوغان الأشعار ..",".. من حبها عندي تفحم وحدها",18,"د",3,0],["وإن أذى النصح الجدال وربما","تفاقم فاستشرى فكان عداء",19,"ا",2,0],["وإنْ أذهَبُوا عَقلِي،بِحُبِّكِ أهتدي","وَإنْ أزْهَقُوا رُوحِي فَمَوْتِيَ أرْحَمُ",20,"م",1,0],["وأنا ذوو الإسلام والدين والهدى","على سنة المعصوم من كان أكرما",21,"م",2,0],["وأنا ذاك المنادِي","والمعَلَّى تحتَ نعلِكْ",22,"ك",1,0],["وإن آذانهم صم وأعينهم","عمي عن الإهتدا والقلب مبتول",23,"ل",1,0]]}