لشوقِ فالدمْعُ مُنسَكِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=15324",""],[5725,"او كالذي سال الفؤاد الصادي","https://www.poetsgate.com/ViewPoem.aspx?id=198670",""],[5747,"البث المباشر","https://www.poetsgate.com/ViewPoem.aspx?id=61658",""],[5956,"لا تيأسَنّ أيا قلبي من البشر","https://www.poetsgate.com/ViewPoem.aspx?id=193578",""],[5956,"شحنتُ كواكبي من لقاءٍ بصاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=208508",""],[5969,"حِداداً على روحي","https://www.poetsgate.com/ViewPoem.aspx?id=198800",""],[6052,"شيخ القضية احمد","https://www.poetsgate.com/ViewPoem.aspx?id=35211",""],[463,"هل تحت ليلك بالغضا من رائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60040&r=&rc=96",""]],"verses":[["فَوَرَّعَ عَن جِلدِها رَوقُها","يَشُكُّ ضُلوعاً بِأَعضادِها",0,"د",3,0],["فَوَرَّكَ قِدراً بِالشَمالِ وَضَلفَعاً","وَحاذَتهُ أَعلاَمٌ لَها ومَخارِمُ",1,"م",1,0],["فَوَرَدتَ يا فَتحي الحِما","مَ وَأَنتَ مُنقَطِعُ النَظيرِ",2,"ر",1,0],["فَوَرَدنا قَبلَ فُرّاطِ القَطا","إِنَّ مِن وِردِيَ تَغليسَ النَهَل",3,"ل",1,0],["فَوَرِثتَ والِدَكَ الخِيانَةَ وَالخَنا","وَاللُؤمَ عِندَ تَقايُسِ الأَحسابِ",4,"ب",1,0],["فوردنا منك عذباً","وصدرنا عن زُعاق",5,"ق",1,0],["فوردتُه وشُقْرتُه احمرارٌ","وحُمْرتُه وخُضرتُه ادْهِمامُ",6,"م",1,0],["فَوَرَدنَ وَالعَيّوقُ مَقعَدَ رابِىءِ الض","ضُرَباءِ فَوقَ النَظمِ لا يَتَتَلَّعُ",7,"ع",1,0],["فَوَراءَ أَوْجاعِ الحَياةِ","عُذُوبَةُ الأَملِ الجَسُورْ",8,"ر",1,0],["فَوَراءَكَ الإِسلامُ مَحروسَ القُوى","لَمّا جَعَلتَ أَمامَكَ الإِشراكا",9,"ك",2,0],["فَوُرِّعَ تَوريعَ الجِيادِ عِنانُهُ","فَما جاءَ حَتّى ساوَرَ الشَمسَ قايِلُه",10,"ل",2,0],["فورقاءُ لم تأرقْ بحزنٍ جفونُها","وبلبلةٌ لم يدرِ منها الأسى بالُ",11,"ل",1,0],["فَوَرَبِّ البَيتِ العَتيقِ لَقَد طَح","طَحتَ مِنهُم رُكنَ الضَلالِ العَتيقِ",12,"ق",1,0],["فَوَراءَ سِترِ اللَيلِ مُضطَرِمُ الحَشا","لايَستَقِرُّ بِهِ هُناكَ مِهادُ",13,"د",1,0],["فوَرا السائرينَ وهْوَ أمامِي","سُبُلٌ وَعْرَةٌ وأرضٌ عَراءُ",14,"ا",2,0],["فوراءَهم حيثُ انْتَهَوْا وأمامَهُم","تُطَوى بِهنَّ تنائفٌ وهُجُول",15,"ل",1,0],["فَوَرَدَت ماءَ جَزعٍ عَن شَمائِلِها","في سَبسَبٍ مُقفِرٍ حُمرٌ بِهِ اللَغَطُ",16,"ط",1,0],["فورثوا قيصر في المشارق","وأخذوا الغرب بسيف طارق",17,"ق",1,0],["فوردتْ كتيبة الزّبير","وعُمَرٌ مصدرُ كلّ خير",18,"ر",1,0],["فوردْتُ جَمَّاتِ المُنَى","وكَرُمْتُ عن لُؤمِ المآثِمْ",19,"م",1,0],["فَورَدْتَ وِرْدَك في الخُلُودِ مُنَعَّماً","وَالأَرْضُ مائِدَةٌ عَليْك تَأَسُّفَا",20,"ف",2,0],["فَوَرَبّي لَيَشرَبَنَّ بِكَأسٍ","شربَ اِبني بِها وَعقباكَ تَجزي",21,"ز",2,0],["فورارس يستهدي أعنّة خيلهم","دم العرب الفادين والسؤدد العالي",22,"ل",2,0],["فوربيّ طرقتُ شرقاً وغرباً","وبلوت الأنامَ آلاّ فآلاَ",23,"ل",2,0],["فوربِّ السماء حِلقةِ بَرٍّ","لا يضامُ امرؤ له أنت بَعْلُ",24,"ل",1,0],["فَوَرى بِحُكمِكَ زَندُ عَدلٍ قَد كَبا","وَكَبا لِخَوفِكَ زَندُ جَورٍ قَد وَرى",25,"ر",2,0],["فوراءَ دولتِهِ ثناءٌ نازلٌ","وأمام دعوته دعاء صاعد",26,"د",1,0],["فور بهِ ما في بلادٍ موضعٌ","مغنٍ ولا في الأرض عنه معيضُ",27,"ض",1,0],["فَوَرَدنَ حينَ أَجَنَّهُنَّ مُجَلِّلٌ","تَتَحَيَّرُ الأَبصارُ فيهِ ظَليلُ",28,"ل",1,0],["فَوَرَدنَهُ وَنُهودُهُنَّ نَواشِرٌ","وَعُيونُهُنَّ سَواهِرٌ لَم لَم تَغفَلِ",29,"ل",1,0],["فوربِّ السماءِ والأرضِ إني","لأرى في مصارعِ الحبيبِ رمسي",30,"س",2,0],["فورَّدتِ الطبيعة وجنتيها","ونضَّرَ وجهَها الحسن الطبيعي",31,"ع",2,0],["فورحمةِ العشّاقِ لستُ براجعٍ","حتى أرى عِنبَ الخدودِ زَبيبا",32,"ب",2,0],["فَوَرَّثَهُ اللَهُ السَعادَةَ سَرمَداً","عَلى رغمِ آنافِ العِدا وَذَوي الحِقدِ",33,"د",1,0],["فَوَرَّثَت فيهِ سِرَّ ال","سُرورِ بِالتَعصيبِ",34,"ب",1,0],["فوردتُ من سَلسالها","أَحلى من العَذبِ النَميرِ",35,"ر",1,0],["فَوَرَّطَهُم وَسطَ البَياضِ كَأَنَّهُم","عَلى الشَرَفِ الأَقصى الضَرّاءُ اللَوازِمُ",36,"م",1,1],["فَوَرِثتَ قائِدَها وَفُزتَ بِقِدحِها","وَخَصَمتَ لُدّاً لَم يَهُلكَ خِصامُها",37,"م",3,0],["فَورِّثهُ منك أُخْرى الزّما","نِ نُصحاً مُبيناً ورأْيَاً مَتينا",38,"ن",2,0],["فوردت أعذبَ فهلٍ من ماجد","لي مصدرٌ عن راحتيه ومورد",39,"د",1,0],["فوراءَ آمالي عيونٌ إن تغِبْ","عنهن أنساني فما أنساني",40,"ن",2,0],["فوراءها أنف لكل دنية","ولئن هطلن وصحن مجنونات",41,"ت",1,0],["فوراءَ غِمدي صارمٌ ما ضرَّه","شعَثُ النّجاد وغربُه المثلومُ",42,"م",1,0],["فوراء عهدك بالنخيلة جَوْنةٌ","بَهماء تلعب بالمحبِّ الموجَعِ",43,"ع",1,0],["فوَراء يومك من صِباك ضُحَى غدٍ","وعدٌ يسوءُك منه صدقُ الواعدِ",44,"د",1,0],["فورَدْنَ الغَمْرَ من نبْعِ الطُّلى","قانياً ثُمَّ رَعَيْنَ اللِّمَما",45,"م",2,0],["فَوَرَدتُ أَروي مَورِدٍ وَشَرِبتُ أَح","لى مَشرَبٍ وَنَهَلتُ أَعذَبَ مَنهَلِ",46,"ل",1,0],["فَوَرَبّه قامت به","للدين أشراط القيامه",47,"م",2,0],["فوردوا إذ سمعوا المنادي","ونزل الجمعان خلف الوادي",48,"ي",1,0],["فَوردنا رَفهاً بِعَقوَةِ شَمسِ الدِّ","ين حوضِ النَّدى وبحرِ السَّماح",49,"ح",1,0],["فَوَرَدنَ في حَرَمِ الخِلافَةِ مَنهَلاً","فَصَفَت لِرائِدِها بِعَذبِ هَنيِّهِ",50,"ي",2,0],["فَوِردُها النّاسُ إحساناً وَلا عَجَبٌ","أن يَجمَعَ اللهُ بَينَ النَّاسِ في رَجل",51,"ل",1,0],["فَوَرَدنَ أعذَبَ مَنهَلٍ وَنَزلنَ أك","رَمَ مَنزِلٍ وَطَرقنَ أشرَفَ مَطرِقِ",52,"ق",1,0],["فورثتَ العلم منهُ","والكتابَ المُستَبينا",53,"ن",2,0],["فَوراءَ هذا الحُسنِ حُسنٌ قَدْ غَدا","مَطلوبَ نفسِكَ لو دَرتْ مَطلوبَها",54,"ب",3,0],["فوَرَّط الذئب بِما تَمَلَّقا","حَتّى دَنا مِن الحِصان وَاِرتَقى",55,"ق",2,0],["فَورّيت عمّا بي وفي الكبدِ وَالحشا","مِنَ الوجدِ برحٌ فَاِعلمَنّ شديدُ",56,"د",1,0],["فوربِّ السماء والأرض إني","لا أبالي أَلِنْتَ لي أم خَشُنْتا",57,"ت",2,0],["فَوُرْ قَبْرَهُ إنْ شِئْتَ تَحْظى بِقُرْبِهِ","لِتَسْلَمَ مِنْ هَوْلِ الْحِسَابِ وَكَرْبِهِ",58,"ه",1,0],["ف وردان وبردان يقولا","لحشف الظبي خذه يا عُقابُ",59,"ب",1,0],["فَوَرَثتَ مِن ذا قُبحَ مَنظَرِهِ","وَوَرَثتَ ذاكَ خَناهُ أَو صَلَفَه",60,"ف",2,0],["فوردتَ أفياءَ النعيم بحضرة","للَه واردُ حوضها لا يوزَع",61,"ع",1,0],["فَوراء خدع الشعب أهيف لَم يدع","في حسن للمحسن شيئاً يفقد",62,"د",1,0],["فورَّثني على رَغْم الأعادي","مَسَاعِيَ لا ألفَّ ولا وضِيعِ",63,"ع",1,0],["فوردت لم تلحق بغيبك ريبة","وصدرت لم يعلق بسعيك ذام",64,"م",1,0],["فَوَرَّكَ لَينا أَخلَصَ القَينُ أَثرَهُ","وَحاشِكَةً يَحصى الشِمالَ نِذيرُها",65,"ر",3,0],["فَوَرَّكَ لَينا لا يُثَمثَمُ نَصلُهُ","إِذا صابَ أَوساطَ العِظامِ صَميمُ",66,"م",1,0],["فورثتموه حماسة وسماحة","وخلفتموه عزائماً ومناصلا",67,"ل",2,0],["فورثت طول بقائها متمتعاً","بدوام ملك لا يزال مؤيدا",68,"د",2,0],["فورثت طول بقائها في دولة","تفنى الليالي وهي دائمة البقا",69,"ق",2,0],["فورثت طول بقائها متمتعاً","فالدهر يفنى وهي دائمة البقا",70,"ق",2,0],["فورثت طول بقائها متمتعاً","بلقائها في ظلِّ عيش أرغد",71,"د",1,0],["فورثته قولاً وعلماً والذي","كلفت من عمل ومن إيمان",72,"ن",1,0],["فَوَرِثتُمُ عَمراً كَمَا وَرِثُوا لِعَب","دِ الله أنَّى يَستَوِي الإرثَانِ",73,"ن",1,0],["فَوَراءَكُم شَعبٌ يَبيعُ حَياتَهُ","في حُبِّ مِصرَ كَريمَةِ الأَحسابِ",74,"ب",1,0],["فوّرْت سِكَّرْ واستوى مِرّ","مِنْ قَالْ لِيْ عَلَيْك هَبْ مارْ",75,"ر",1,1],["فورثت صالح ما حووا ولقد","زينت ذاك بأطيب الخمر",76,"ر",1,0],["فورق التهاني بألحانها","عن الحظ تعرب إذ تنشد",77,"د",1,0],["فَوراءَهُ مُستنجِزا","تٌ من قِيامٍ أو قُعود",78,"د",1,0],["فوردت المر كما وردا","ويكون البادئ اظلمنا",79,"ن",2,0],["فوَرْدان وبَرْدان يقولا","لخشْفِ الظَّبْي خذه يا عُقاب",80,"ب",1,0],["فَوراك مطراب العشيّ فَإِنَّني","كلفٌ بِغَير الغانياتِ عَميدُ",81,"د",1,0],["فوريْقُ غصنك بعد إيراقٍ ذوىَ","ومنير وجهك بعد إشراقٍ هوى",82,"ه",3,0],["فورُودُه أحْلى لديّ على الظما","من مَوْرِدٍ عذْبٍ وظلٍّ أوْرَفِ",83,"ف",1,0],["فورثناها بعدلٍ واجبٍ","أَوجَبَ الأرثَ بأُمٍّ وأَبِ",84,"ب",1,0],["فوُرقُ الحِمَى كُلٌّ عليهِ بأَيكِها","نَعاءً ونعتاً نائحاتٌ صوادحُ",85,"ح",1,0],["فَورَت زِنادَ الشَوقِ بَينَ جَوانحي","إِذ لَم أَكُن وَقَت الزِيارَةِ عالِما",86,"م",2,0],["فَوَريحانِ العِذارِ الخَضِلِ","فوقَ وردِ الوجنةِ المشتَعلِ",87,"ل",1,0],["فوردتُ جنة نحره","ونعيمها داني القطاف",88,"ف",1,0],["فورعت في حين الجني","وكففت عن فوق الكفاف",88,"ف",1,0],["فوراً تلجلجن أبازيمَ الشّبا","قد جَعل الناس إليه سببا",89,"ب",2,0],["فوردتهُ بنقيَّةٍ","وردَ الظماء من الحمامِ",90,"م",1,0],["فورى زناد حفاظه شرراً به","حمي الوطيس وتلك عادة زنده",91,"د",2,0],["فوردت بحر المجد غير مكدر","يرزجي سحاب الجود غير جهام",92,"م",1,0],["فوردت بحر المجد غير مكدر","يزجي سحاب الجود غير جهام",93,"م",1,0],["فَوَرَبِّ السَماءِ لَو قُلتِ لي صَ","لِّ لِوَجهي جَعَلتُهُ الدَهرَ قُبلَه",94,"ه",1,0],["فَورقةٌ ذاتُ أَلفٍ","بِها صُداعُك يَذهَبْ",95,"ب",1,0],["فوراء العتاب قد يبعثُ الغَير","ان عَتباً بماضياتٍ صِقال",96,"ل",1,0],["فوراء العتاب قد يَبعث الغيرانُ","عَتباً بماضيات الحُدود",97,"د",1,0],["فوردت منهل فضله","ووجدته عذب المساغ",98,"غ",1,0],["فوربي لا أبرح الدهر حتى","تختلى مهجتي أحب عليا",99,"ي",2,0],["فوربِّ نفسي، ما البُعادُ معيشةٌ","هل عائشٌ مَن مِن فؤادٍ .. جُرِّدا؟",100,"د",2,0],["فوَربّ ما أرْضى سِوى مُتعَفّفٍ","أنّى قدَ ارْضى منْ أُدينتْ بالصِّبَا!​",101,"ب",2,0],["فَوُرُودِي مَع الأَمِيرَةِ تَحْلُو","إِنَّمَا تُنْدِي إِنْ رَآهَا الأَمِيرُ",102,"ر",1,0],["فَوْرَةُ الشِّعْرِ فِي الْكُؤُوسِ انْبهَارُ","وَعَتِيقُ الشَّرَابِ بِالآهِ نَارُ",103,"ر",1,1],["فورد منها الحيا وجنة","لبوس الشقيقة من باسها",104,"س",3,0],["فورثت جدك إذ فداه بنفسه","والفضل ما ورثت له الاولاد",105,"د",1,0],["فوَردُ ربيعها الآتي ي","فوقُ جميعَ أورادِكْ",106,"ك",1,0],["فورَّعني بعد الجهالة والصّبا","عن الجهل عهدٌ بالشبيبة قد ذَهَبْ",107,"ب",1,0],["فوراءنا كل الملوك تعاضدت","فمتى تقوم قيامة الميعادِ",108,"د",1,0],["فوراً على البث المباشر ينتشر مع كل ريح","مادام ذنب المبتلا عُلق على شماعته",109,"ت",2,0],["فوراً ينفذ معلوماته بهُدىً","من الإله بلمح البرق والبصرِ",110,"ر",1,0],["فوراً شحنتُ كواكبي من ملتقى","بصديقيَ الروحيِّ حاتمَ طائي",111,"ا",3,1],["فَوِرْدُ الأَمَاني لَيْسَ فِيهِ تَعَكُرٌ","وَمَنْ يُنْشِدِ الآمالَ يَظْفَرْ بِمَا شَدا",112,"د",2,0],["فوراءها للحقِ داعيةٌ رَمى","سهماً بأفواهِ المحامدِ يُنشَدُ",113,"د",1,0],["فوراء يومك من صباك ضخى غدٍ","وعدٌ يسوءك منه صدقُ الواعدِ",114,"د",1,0]]}