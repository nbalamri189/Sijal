{"poems":[[51,"قل لذي الوجه الطرر","https://www.aldiwan.net/poem64193.html","مجزوء الرمل"],[50,"قل لذا الوجه الطرير","https://www.aldiwan.net/poem63335.html","مجزوء الرمل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/143298","البسيط"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138203",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48310","الخفيف"]],"verses":[["وَلِمِغلاقِ هُمومِ","وَلِمِفتاحِ سُروري",0,"ر",2,0],["وَلِمِغلاقِ هُمومي","وَلِمِفتاحِ سُروري",1,"ر",2,0],["ولم غدا القلب ذا يأس وذا طمع","يرجوك أن ترحميه ثم يخشاك",2,"ك",1,0],["وَلِم غَدَت أَسماءُ الاِسمِ دونَ ما اِختُ","صَّ بِهِ المَعنى إِماماً لِلسُوَر",3,"ر",1,0],["ولمغت شأوا ليس يدكه سوى","من جد في طلب المعالي أو دأب",4,"ب",1,0],["ولمُغرىً بحبّهم حينَ أمْسى","ساهِرَ الجَفْنِ بعْدهُمْ يَقظانَهْ",5,"ن",2,0]]}