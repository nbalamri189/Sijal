{"poems":[[55,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[65,"علا بمناط السها تستنير","https://www.aldiwan.net/poem46107.html","المتقارب"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[10,"يؤرقني التذكر حين أمسي","https://www.aldiwan.net/poem21102.html","الوافر"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[40,"يا عجبا للدهر شتى طرائقه","https://www.aldiwan.net/poem7734.html","الطويل"],[63,"ملامك في الهوى أذكى غليلي","https://www.aldiwan.net/poem51484.html","الوافر"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[107,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[54,"شجاك الحي إذ بانوا","https://www.aldiwan.net/poem26661.html","الهزج"],[52,"يعيش بجد عاجز وجليد","https://www.aldiwan.net/poem63956.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21003","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[96,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[56,"تَجَاوَبنَ بالإرنانِ وَالزَّفراتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16977&r=&rc=1",""],[164,"سطوت بسلطان الجمال على الصب","https://www.aldiwan.net/poem58871.html","الطويل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[240,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[275,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[358,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[411,"لله نيسابور من حله","https://www.aldiwan.net/poem49504.html","السريع"],[411,"أبوك حوى العليا وأنت مبرز","https://www.aldiwan.net/poem49600.html","الطويل"],[411,"وللخود مني ساعة ثم بيننا","https://www.aldiwan.net/poem49646.html","الطويل"],[433,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[443,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[463,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[556,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[556,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[556,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48830","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82259","الوافر"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130880","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90589","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101054","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26511","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69365","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48253","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96036","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53123","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27256","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47134","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77398","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60909","البسيط"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110668","البسيط"],[2713,"","https://poetry.dctabudhabi.ae/diwan/poem/125324","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58268","الطويل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102180","المجتث"],[2995,"","https://poetry.dctabudhabi.ae/diwan/poem/198812","البسيط"],[3039,"","https://poetry.dctabudhabi.ae/diwan/poem/105382","الوافر"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11254","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100193","الطويل"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104829","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91345","البسيط"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123842","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102977","الطويل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93750","البسيط"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138823",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58091","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136382",""],[4929,"في المولد النبيوي","https://www.poetsgate.com/ViewPoem.aspx?id=199724",""],[4984,"تفاءل","https://www.poetsgate.com/ViewPoem.aspx?id=187718",""],[5369,"ستشرق شمس","https://www.poetsgate.com/ViewPoem.aspx?id=177450",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5628,"هواجس مرعبة","https://www.poetsgate.com/ViewPoem.aspx?id=178464",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[402,"يبدو منيفا على هام الرجال كما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54025&r=&rc=877",""],[2220,"حمدتُ إلهي والمقامُ عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11732&r=&rc=602",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""]],"verses":[["وَلِلخَيلِ في أَرضِنا جَولَةٌ","تَحَلَّلَ عَنها نِطاقُ الثَرى",0,"ا",1,0],["وَلِلْخِلِّ مِنْ شِيَمِي رَوْضَةٌ","وفي راحَتي لِعُفاتِي غَديرُ",1,"ر",1,0],["وَلِلخَصمِ الأَلَدِّ إِذا تَعَدّى","لِيَأخُذَ حَقَّ مَقهورٍ بِقَسرِ",2,"ر",1,0],["وَلِلخَصمِ الأَلَدُّ إِذا تَعَدّى","لِيَأخُذَ حَقَّ مَظلومٍ بِقِنسِ",3,"س",1,0],["وَلِلْخُطُوطِ عِراضاً فَوْقَ جَبْهَتِهِ","شِبْهُ المَدَارِجِ قَدْ حُفَّتْ بِهَا القِمَمُ",4,"م",1,0],["وَلِلخالِقِ المُلك وَالمالِكونَ","فَلا تَتبَعوا فيكُمُ أَشعَبا",5,"ب",2,0],["وَلِلخُلدِ يُرجى وَالمَنِيَّةِ دونَهُ","وَلِلأَمَلِ المَبسوطِ وَالمَوتُ سابِقُه",6,"ق",2,0],["وللخَطِّيِّ فيه طُولُ خَطْو","يُقَصِّرُ مُدَّةَ العُمْرِ الطَّويلِ",7,"ل",1,0],["وَلِلخَيرِ كَسَّبٌ وَلِلمَجدِ رافِعٌ","وَلِلحَمدِ أَعوانُ وَلِلخَيلِ مُعتَلِ",8,"ل",1,0],["ولِلخَيْلِ قائدُها المُجتَبَى","وفَارسُها الشّمّريُّ الأغرّ",9,"ر",1,0],["وَلِلخَيرِ وَلِلشَرِّ","بِكَفِّ اللَهِ ميزانُ",10,"ن",1,0],["وَلِلخَيرِ أَسبابٌ وَلِلعَينِ فِتنَةٌ","وَمَن ماتَ مِن حُبِّ النِساءِ شَهيدُ",11,"د",1,0],["وللخود منّي ساعةٌ ثمّ بيننا","فلاةٌ إلى غير اللّقاء تجاب",12,"ب",1,0],["ولِلخَلقِ إذلالٌ لِمَن كانَ باخِلاً","ضَنيناً ومَن يَبخَل يُذَلَّ ويُزهَدِ",13,"د",1,0],["وَلِلخَيلِ لَما قَيَّدَ المَوتُ خَطوَها","فَأَطلَقتُمُ مِنهُنَّ بِالذَرِباتِ",14,"ت",1,0],["وللخمائِل في ثوب الدجَى حَذَرٌ","كأنّها تتوقَّى عينَ رائينا",15,"ن",2,0],["وللخوارق في لوح الوجود له","في برهة الحمل شأن غير مستتر",16,"ر",1,0],["وللخلود على أهل الجحيم يد","تجزي مع الدّهر إحسانا بإحسان",17,"ن",1,0],["وللخيلِ لم قيدَ الموتُ خطوها","فأَطْلَقْتُمُ مِنهُنَّ بالذَّرِياتِ",18,"ت",1,0],["وللخيل جثو كالعجاج يثيره","وفرط عجيج الصهيل وبالشغب",19,"ب",1,0],["وللخماسي أربع سفرجل","جحمرش قرطعب او قذعمل",20,"ل",1,0],["وَلِلخَلاعَةِ مَغنىً","مُعَطَّلٌ مَهجورُ",21,"ر",1,0],["وللخلفاءِ الرّاشدين فضيلةٌ","وفضلٌ هما للقانطينَ رجاء",22,"ا",2,0],["وَلِلخَواطر في الإِحماض تَسليةٌ","وَلِلنَواظر في الآداب مُكتَسَبُ",23,"ب",1,0],["وَلِلخَيلِ أَيّامٌ فَمَن يَصطَبِر لَها","وَيعرِف لَها أَيّامَها الخَيرَ تُعقِبِ",24,"ب",1,0],["وَللخَيْرُ والمَيْرُ بها كَثْرَةٌ","لَلَشَّرُّ والضَّيْر بِها قِلَّهْ",25,"ل",2,0],["ولِلخَمْرِ معنىً ليسَ في الكَرْمِ مثلُهُ","وللنّارِ نُورٌ ليسَ يوجَدُ للزَّنْدِ",26,"د",1,0],["وللِخُودِ مِنِّي ساعةٌ ثمَّ بَينَنا","فَلاةٌ إلى غَيرِ الوَفاءِ تُجابُ",27,"ب",1,1],["وللخمائل شدو في جوانبه","له صدى في رحاب النفس رنان",28,"ن",1,0],["وللخطوب كما حدثت حادثة","ترمي الصفاء بأقذاء وأكدار",29,"ر",1,0],["ولِلْخَفَرِ السَّحَّارِ فِي وَجَناتِها","خَوَاتِيمُ لا يَخْفِرْنَ مِنِّيَ وَصْلَها",30,"ل",3,0],["وللخصم يستشري عليَّ سفاهةً","وذي الودِّ يستعلي حؤولا ويستسني",31,"ن",2,0],["وللخوفِ في قومه أن يضا","مَ مات ابنُ حُجْرٍ قتيلَ الكلومِ",32,"م",1,0],["وللخيلِ إمّا بالجسومِ طريحةً","عِثارٌ وإمّا بالصّعيدِ بهامِ",33,"م",1,0],["وللخيلِ إمّا من نَجيعٍ براقعٌ","وإلّا عثارٌ في الصّعيد بِهامِ",34,"م",1,0],["وللخيلِ من نسج الغبارِ براقعٌ","وأجلالُها من صوبِ كلِّ نجيعِ",35,"ع",1,0],["وللخسف تحت العالمين وفوقهم","زلازل من أيديهمُ ورواجم",36,"م",1,0],["وللخيل غارات على فلَواتها","تُسابق عند الجَرْي سِربَ قَطاها",37,"ا",3,0],["وللخصْمِ الألدّ إذا دَعانِي","ليأخذَ حَقَّ مَقْهُورٍ بقَسْرِ",38,"ر",1,0],["وللخنا لما غدت مربضا","قد سجد الليث بها للحمار",39,"ر",1,0],["وللخطاب تا وكاف والنسب","باليا وهاء السكت في ختّم وجب",40,"ب",1,0],["ولِلخُمُرِ اللاتي تساقَطَ لوثُها","فتورُ الخُطا عن وارداتِ الذَوائبِ",41,"ب",1,0],["وللخيل منا ذمة لا نضيعها","رعينا لها حق العتاق الصلادم",42,"م",1,0],["وَلِلخَيرِ أَهلٌ يَسعَدونَ بِفِعلِهِ","وَلِلناسِ أَحوالٌ بِهِم تَتَنَقَّلُ",43,"ل",1,0],["وَلِلخَليفَةِ مِنّا حينَ يَندُبُنا","أَموالُنا وَالقَنا وَالمالُ وَالوَلَدُ",44,"د",1,0],["وللخليطِ انشراحٌ لا يدافعُهُ","عُسْرٌ وفي راحتيْهِ اليُسْرُ مُنْدفِعُ",45,"ع",1,0],["وللخليعِ أصولٌ ليس يُنْكرُها","شهو على أنها للعار تُفْتَرَعُ",45,"ع",1,0],["وللخيل خلي عن مداك فلن ترى","ليومك مقداماً على الهول كرارا",46,"ر",2,0],["وللخزامى نفحات نشرها","معبر عن نفس العبير",47,"ر",1,0],["وللختم سرٌّ لم يزل كلُّ عارفٍ","عليه إذا يسري إليه يحومُ",48,"م",1,0],["وللخطّة الشمّا خلافة أحمد","مسير على حمدٍ ووقف على شكر",49,"ر",1,0],["وَلِلخُلودِ دَليلٌ مِن صَحيفَتِهِ","وَعَنهُ بِالمَحوِ سطرٌ كُلُّهُ خَبَرُ",50,"ر",1,0],["وللخزاعي كل الفخر قاسَمَني","فيه وسيفٌ كساه الفخر ذويزن",51,"ن",1,0],["وللخلاعة أوقات يعد بها","ترك التصابي ولو آنا من الكسل",52,"ل",1,0],["وللخَلْق لا أشكو افتقاري وفاقتي","فمن يشكُ للمخلوق لا شكَّ يندمُ",53,"م",1,0],["وللخيل أجفالُ الظليم هزيمةً","تجولُ ولكن يومَ ضاقَ مجالُها",54,"ل",3,0],["وللخصام إذا ما","يوم القيامة نودي",55,"د",2,0],["وللخليج نشيج من تألمه","أما العراق فبالأحزان يختمر",56,"ر",1,0],["وللخطي والهندي جمع","وتفريق نظاماً أو نثارا",57,"ر",2,0],["وَلِلخَيالِ الَّذي قَد كانَ يَطرُقُني","وَلِلنَدامى وَلِلَّذّاتِ وَالطَرَبِ",58,"ب",1,0],["وللخود تقتاد النفوس بفاتك","من اللحظ أمضى من شبا الصارم الخال",59,"ل",1,0],["وللخيرات قد وعد العطايا","ومن يعِص الإله يذق وبالا",60,"ل",2,0],["وللخفرات الفاطميات عولة","وقد شرق الحادي بهنّ وغربا",61,"ب",2,0],["وَللخمائل وَشيٌ سندسٌ وَعَلى","خاماتِه رونقٌ يستوقف النَظَرا",62,"ر",2,0],["وللخورنق حين المعقلي بدا","كمثل ضدّ إذا قابلته انهزما",63,"م",2,0],["وللخمر خمر لا تخامر أهلها","ولكنها للأجنبي تخامر",64,"ر",1,0],["وَللخلاف كَم تَدرون عاقبة","آثارها بعيون الناس لم ترق",65,"ق",1,0],["وللخيلِ في شأوِ مضمارها","صعودٌ على جِسمه وانحدارُ",66,"ر",1,0],["وللخلاخلِ أصواتٌ مرجَّعَةٌ","يَزيدُ أهلَ الهوى ترجيعُها قَلَقَا",67,"ق",2,0],["وللخير أهلاً والمبرة منتجاً","وللخبر المهدي المسرة مبتدا",68,"د",2,0],["وللخوارقِ ترحيباً ب(أحمدِها)","فصاحةٌ لم تغب عن فهمِ قاريها",69,"ي",3,0],["وللخير يُفْتَحُ باب الغنى","فمن أغلق الباب .. من أغلقا ؟",70,"ق",2,0],["وللخائن الدعريط تجديد ديننا","ليُخصى جهارا ثم يؤتى ويُلبس",71,"س",1,0],["وللخلفاء الراشدين غضاضة","تروم بأن تمحو لأجداثهم أثرا",72,"ر",2,0],["وللخيرِ تنهجُ سُبْل الخداع","لتورده منْهلا للعَدمْ",73,"م",1,0],["وللخَجِل ِالفِطريِّ في خُطَواتِها","صديً.. حين تخطو مِثلَ غُصن ٍ منَ البان ِ",74,"ن",1,0],["وللخطوط عراضا فوق جبتهته","شبه المدارج قد حفت بها القمم",75,"م",1,0],["وللختمِ سرٌّ لمْ يزل كلُّ عارفٍ","عليهِ إذا يسري إليهِ نحومُ",76,"م",1,0],["وللخلاف لإظهار الخلاف على","أترابه ورق شبه السكاكين",77,"ن",1,0]]}