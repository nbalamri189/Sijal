{"poems":[[79,"عسى خطرة بالركب يا حادي العيس","https://www.aldiwan.net/poem35882.html","الطويل"],[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[40,"هممت الغداة همة أن تراجعا","https://www.aldiwan.net/poem7729.html","الطويل"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[50,"إذا أجرى أمين الله","https://www.aldiwan.net/poem63434.html","الهزج"],[50,"بمعودية الدين العتيقِ","https://www.aldiwan.net/poem66571.html","الوافر"],[48,"يا ربة الصمت أنت آمنة","https://www.aldiwan.net/poem22918.html","المنسرح"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[303,"أبى رق الحياة فمات حرا","https://www.aldiwan.net/poem36809.html","عموديه"],[445,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[469,"بم يجل خط عذاره وبنانه","https://www.aldiwan.net/poem3439.html","عموديه"],[580,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87230","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39061","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62480","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107187","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56387","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64585","المتقارب"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106705","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104988","المنسرح"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105009","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21479","المتقارب"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3418,"","https://poetry.dctabudhabi.ae/diwan/poem/111130","المتقارب"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85022","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125903","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91021","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90802","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94490","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94871","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76768","الوافر"],[4767,"يوم العسكري","https://www.poetsgate.com/ViewPoem.aspx?id=197293",""],[4767,"ميدان الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=210808",""],[4578,"لقلبي في مهاوي الحب أهوى","https://www.poetsgate.com/ViewPoem.aspx?id=49607",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5277,"لغة الزهور","https://www.poetsgate.com/ViewPoem.aspx?id=185387",""],[5518,"بين يدي الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=200953",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""]],"verses":[["بمَيْدانِ جَفْني للسّهادِ كَتيبةٌ","تُغيرُ على سرْحِ الكَرى في كَراديسِ",0,"س",1,0],["بَميٍّ إِذا أَدلَجتُما فاطرُدا الكَرى","وَإِن كانَ آلى أَهلُها لا أَطورُها",1,"ر",3,0],["بِمَيثاءَ سالَت مِن عَسيبٍ فَخالَطَت","بِبَطنِ الرِكاءِ بُرقَةً وَأَجارِعا",2,"ع",2,0],["بِمَ يَفْخَرُ الرُّسُلُ الكرامُ حضارةٌ","خرقاءُ فاجِرةٌ وعِلمٌ مُجرِمُ",3,"م",1,0],["بَميْثاءَ تَروي المسكَ بالخمرِ كلما","تَسلسَلَ فيها جَدولٌ يتنضّحُ",4,"ح",1,0],["بِمَيدانٍ جَعَلنا خَي","لَهُ طاساً وَأَكواسا",5,"س",2,0],["بميلادِ المسيحِ بيوم ذبح","وباعوثٍ لتأدية الحقوقِ",6,"ق",1,0],["بِمَيِّتٍ غادَرَتهُ أَينُقُهُم","مِن وَطئِها مِثلَ حَيَّةِ الرَقَطِ",7,"ط",1,0],["بِميزانِ قِسطٍ لا يُغيضُ شَعيرَةً","لَهُ شاهِدٌ مِن نَفسِهِ حقُّ عادِلِ",8,"ل",1,0],["بِميراثِها قد متّعتهم ولم تزَل","مجدّدَةً فيهم لعهدِ وعهدة",9,"ه",1,0],["بِمَيْمُونِ المَطالِعِ والمَساعي","ومَأْمُون الستارِ أَو السُفُورِ",10,"ر",1,0],["بميتته رأى إحياء شعبٍ","فأيقن أنَّ بعد العسرِ يسرا",11,"ر",2,0],["بِمِيتَةٍ فِي سبيلِ اللهِ أَسْلَمَهُ","فِيهَا إِلَى رَبِّهِ الأَبناءُ والشِّيَعُ",12,"ع",1,0],["بم يجلَ خطُّ عذارهِ وبنانهِ","إلا حسبتُ عذارهُ من خظّهِ",13,"ه",1,1],["بميمونِ رأْيكَ كان الفتوحُ","ومنصورِ عَزْمِك كانَ الغَلَب",14,"ب",1,0],["بِميلاد خَير الناس نَجل محمدٍ","أَضاءَت لَهُ الدُنيا وَنالَ المَعاليا",15,"ل",3,1],["بِمَ يَشْكُو أوْ كَيْفَ قُلْ ليَ يَشْكُو","تالِفٌ نَفْسُهُ رَقَتْ للتَّراقي",16,"ق",2,0],["بميدان الجيادِ خذوا وهاتوا","فقد ظهرت على الخيل الكماةُ",17,"ه",1,1],["بِميّاسَةِ الأَعطافِ خَمصَانَةِ الحشا","لَها الصَّونُ مِن دُونِ السُتُورِ سُتُورُ",18,"ر",1,0],["بميلاده مختارة العزّ أشرقت","سروراً وقد ضاء المقام الموطّدُ",19,"د",1,0],["بميم معارفك المشرقا","ت وأسرار مبدئها والنهايه",20,"ا",3,0],["بميامِنِ المنصورِ لاحَت للهُدى","شَمسٌ لها فِي الغَربِ أسطَعُ مَطلَعِ",21,"ع",1,0],["بميسم الشوق قد كوى كبدي","مَن بِسِماتِ الجمال قد وسمك",22,"ك",1,0],["بمَ يشمت الأعداء بعدك لا غفوا","إلاّ على حسكٍ من السعدان",23,"ن",1,0],["بِميثٍ بَثاءٍ نَصيفيَّةٍ","دَميثٍ بِها الرِّمثُ والحَيَّهَل",24,"ل",1,0],["بميلةٍ لركنهِ اليماني","إلى مُصَلَّى الهاشمي العدناني",25,"ي",1,0],["بميلةٍ حقيقةً للواقعِ","محقَّقاً فاتَّخذوا منافعي",25,"ي",1,0],["بميله لخسيس القدر يجمعه","من الحطام الذي يفنى ولم يدم",26,"م",1,0],["بميلاده بشر المصطفى","وفي قتله حرب تستبشر",27,"ر",1,0],["بميلادك الأقطارُ نارت وأصبحت","لحلي بنقصار السعادة جيدها",28,"د",3,0],["بِميمِ الثَغرِ جَرَّتني وَقالَت","تَلقَ النَحوُ في ذا العِشقِ عَنّي",29,"ن",2,0],["بميلاد سلمان تقام البشائر","نعم فهو نجم للخليفة زاهر",30,"ر",1,1],["بميلاد مولود لأكرم والد","سما إذ تسمي راشدا وهو في المهد",31,"د",1,0],["بميم ثغر حوى عين الرحيق لذا","طابت عليه حياة الشارب الخضر",32,"ر",1,0],["بَميناً بصافي القلب صدقاً حلفتها","وَلَستُ بجانٍ فاتقوا صدق حلفتي",33,"ي",1,0],["بميخائيل بيعتنا تسامت","وضاءَت باسم جبريل الزَعيم",34,"م",1,0],["بمياع الاديم يكاد يغشى","لنفثته لواحظ مبصرية",35,"ي",2,0],["بِميلاد الزكيِّ تطيب نفسٌ","ومِن عِقدِ الوَلا يزدان جيد",36,"د",1,0],["بميدان الهوى إنْ كلَّ عزم","فلا سرجٌ يفيد ولا لجام",37,"م",1,0],["بميل مه الهوى كل لهذا","غدت أحكاماً تجري يا هوا",38,"و",2,0],["بِمَيدَاِن تَحرِيرِنَا لاَحَ فَجرٌ","حَسِبْنَاهُ أَرخَى عَلَيْنَا ضِيَاهْ",39,"ا",2,0],["بمياسمِ الوردِ المضمخِ بالشذا","روحٌ تكلّمُ فطرةَ الأرواحِ",40,"ح",1,0],["بميلادِ الحبيبِ تهيمُ سَكْرَى","قلوبُ العاشقينَ وَلا تُضَامُ",41,"م",1,0],["بميزانٍ بدا صدئاً","أضاع الصحب مقياسه",42,"س",2,0],["بمئات معيار يكيل عدونا","مكيالَهُ المنحازَ دوماً للغجرْ",43,"ر",1,0]]}