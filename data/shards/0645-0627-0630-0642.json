{"poems":[[57,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[53,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[53,"ومسمع لا عدمت فرقته","https://www.aldiwan.net/poem66043.html","المنسرح"],[58,"مولاتنا يا غلام مبتكره","https://www.aldiwan.net/poem58590.html","المنسرح"],[54,"ما ذقت طعم النوى لو تدري","https://www.aldiwan.net/poem26951.html","السريع"],[50,"وخندريس لها شعاع","https://www.aldiwan.net/poem65100.html","مجزوء البسيط"],[78,"قلب بلوعات الهوى معمود","https://www.aldiwan.net/poem39451.html","الكامل"],[240,"ما ذقت قط أمر من أمري","https://www.aldiwan.net/poem31602.html","الطويل"],[287,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[345,"يا من نأت بهم الديار فأصبحوا","https://www.aldiwan.net/poem11560.html","الكامل"],[371,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122655","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59530","الرجز"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35392","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136292","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108635","المتدارك"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127968","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216649",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204626","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68025","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108343",""],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104903","الكامل"],[4767,"عمري","https://www.poetsgate.com/ViewPoem.aspx?id=87029",""],[4785,"شكوى الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=129743",""],[5026,"ثقب في كفن الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=210851",""],[5612,"ماذا برَأْيِكْ ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=180054",""],[5804,"مساجلة مع جار الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=190655",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""],[6068,"من ذكر هاجر -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175944",""]],"verses":[["ما ذُقتُ بَعدَكُمُ عَيشاً سُرِرت بِهِ","وَلا رَأَيتُ لَكُم عِدلاً وَلا خَلَفا",0,"ف",2,0],["ما ذُقتِه عَوْداً ولو سُبّلت","وقوفُه في الفسق تسبيلا",1,"ل",2,0],["ما ذُقْتُ شيئاً ولستُ ذائقه","أوقَعَ من صَمْتِه على القرمِ",2,"م",1,0],["ما ذُقْتُ منها سِوى مُقبَّلِها","وَضَمِّ تلكَ الفُروعِ مُنْحَدِرَهْ",3,"ر",2,0],["ما ذُقتُ طَعمَ النَوى لَو تَدري","كَأَنَّ جَنبَيَّ عَلى جَمرِ",4,"ر",1,1],["ما ذُقتُها قَطُّ أَو أُناجي","أَمامَها الكَأسَ بِالكَلامِ",5,"م",1,0],["مَا ذُقْتُ طَعْمَ المَوْتِ في كَأسِ الأسَى","حَتَّى سَقَتنِيْهِ الظِّباءُ الغِيدُ",6,"د",1,0],["ما ذُقتُ قَطُّ أَمَرَّ مِن أَمري","في البُسرِ وَالسيلانِ وَالتَمرِ",7,"ر",1,1],["ما ذُقتُ بَردَ العَيشِ بَعدَ فِراقِهِ","فَالماءُ سُمٌّ وَالنَّسيمُ سَمومُ",8,"م",1,0],["ما ذقتُ موردَها ولكن هَكَذا","نقلَ الأَراكُ وحدَّث المِسواكُ",9,"ك",1,0],["ماذقتُ عذبَ القرب الا ردَّهُ","وشكُ التفرّق والبعاد عذابا",10,"ب",2,0],["ما ذَقتُهُ ذَنَبٌ عَلى فَمِهِ","بَل هُوَ جُحرٌ غِطاؤُهُ ذَنَبُ",11,"ب",1,0],["ما ذُقتُ راحةَ ساعةٍ لِبَليَّةٍ","بَعدَ الفِراقش ولا احتَحلتُ غماضا",12,"ض",2,0],["ما ذُقتُ طَعم هَجر","مِنه ولا قُطوب",13,"ب",1,0],["ما ذُقتُ ماءَ لَماكَ في سِنَةِ الكَرى","إِلّا اِنتَبَهتُ فَكانَ لي أَحلاما",14,"م",2,0],["ما ذقت عذب الهوى الا بغصته","يا غارة الله من تعذيب امثالي",15,"ل",2,0],["ما ذقت حلاوة مبسمها ال","معسول ولازمني صبري",16,"ر",2,0],["ماذقت كأس الوصل حتى أنهم","لى يتزعون من الفراق كؤسا",17,"س",2,0],["مَا ذقت طعم الْحِبّ يَا شُوْق لَوْلَاك","كِلّ الْهَنا شفته بنظرات عَيْنِيْك",18,"ك",1,0],["ما ذقت إذ خنت للإخلاص لذته","ومن يذق لذة الإخلاص لم يخن",19,"ن",1,0],["مَا ذقتُ أشهى مَطْعماً","إِلاَّ كصابٍ عَلْقم",20,"م",1,0],["ما ذقت حلواً انيقاً لذَّ مطعمه","الا ذكرت لها شهد اللمى بفمي",21,"م",2,0],["ما ذقت خمرة ريقه","فيها لماذا تهت سكرا",22,"ر",2,0],["ما ذقت من أقداحها","إلا الحثالة علقما",23,"م",2,0],["ما ذقتَ من فرحٍ ومن ترحٍ","هو منك، فالدُّنيا هي الصدر",24,"ر",1,0],["ما ذُقْنَ مِنْ شَجرِ الجِنانِ فواكهًا","إلا الجِراحَ، لِمَ اقْتَحَمْنَ جَهَنَّمَك؟",25,"ك",1,0],["ما ذُقْتَ طَعْمَ الفَرْحِ منْذُ عرفْتَهُ","ما ذُقْتَ يا ظمْآنُ أُنْساً أو صَفا",26,"ف",2,0],["ما ذقتَ طعمَ الحبِّ إلاَ مرّةً","بدقيقةٍ فإذا الغرامُ حُطامُ",27,"م",1,0],["ماذقت حلو النوم والبال منحاس","والعين طاولها السهر مع بكاها",28,"ا",3,0],["ما ذقت منها غير صوت حنينها","أ ترى الكريم على هوى خوانا؟",29,"ن",2,0]]}