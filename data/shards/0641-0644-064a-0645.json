{"poems":[[65,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[65,"خليلي خوضا غمرة الليل إنني","https://www.aldiwan.net/poem45904.html","الطويل"],[65,"لحى الله دهرا لا نزال دريئة","https://www.aldiwan.net/poem46103.html","الطويل"],[75,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[90,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[74,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[53,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"ما رأت في الناس عيني","https://www.aldiwan.net/poem44968.html","مجزوء الرمل"],[68,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[71,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42569","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[108,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[101,"إمرأة من زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=16897",""],[119,"خليلي ما لي لا ارى القلب موضعه","https://www.aldiwan.net/poem40907.html","عموديه"],[189,"ألا يا نسيم الريح إن كنت عابرا","https://www.aldiwan.net/poem14661.html","الطويل"],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[215,"جئت وحدى إلى الشواطىء ظهرا","https://www.aldiwan.net/poem46265.html","الخفيف"],[216,"لقد هجرتني أم سعد وحبها","https://www.aldiwan.net/poem37826.html","الطويل"],[275,"جبينك لاح فجرا في حماك","https://www.aldiwan.net/poem35421.html","الوافر"],[275,"لئن ذبلت كالزهر يوما قريحتي","https://www.aldiwan.net/poem35607.html","الطويل"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[411,"لئن كدر الدهر الخؤون مشاربي","https://www.aldiwan.net/poem49824.html","الطويل"],[422,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[435,"أتت مثل خوط البان تهتز أو أرقى","https://www.aldiwan.net/poem40712.html","الطويل"],[435,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[447,"ألا مبلغ عني خميسا وحاجزا","https://www.aldiwan.net/poem14372.html","الطويل"],[447,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[463,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[484,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[487,"كتبت لقاضي العشق سطرا من الهوى","https://www.aldiwan.net/poem24441.html","عموديه"],[500,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[556,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[556,"بياضك يا لون المشيب سواد","https://www.aldiwan.net/poem47875.html","الطويل"],[556,"سقى دارها حيث استقرت بها النوى","https://www.aldiwan.net/poem47910.html","الطويل"],[563,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137802",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104579","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100140","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119302","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96641","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64687","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64909","المنسرح"],[1244,"","https://poetry.dctabudhabi.ae/diwan/poem/144835","الطويل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198192","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109161","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64458","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53194","الوافر"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105386","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202987","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205014","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123925","السريع"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66369","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205676",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131059",""],[3802,"","https://poetry.dctabudhabi.ae/diwan/poem/141077","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111062","الوافر"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/142523","البسيط"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130604","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116047","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204315","الطويل"],[4692,"تألق قلبي ثم انزوى","https://www.poetsgate.com/ViewPoem.aspx?id=181379",""],[4755,"ثُمَّ باعُوا جَنوبَنا والشمالا","https://www.poetsgate.com/ViewPoem.aspx?id=190112",""],[4927,"تهنئة","https://www.poetsgate.com/ViewPoem.aspx?id=29625",""],[4929,"هواكِ وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=199185",""],[5121,"حَدِيِثُ الرُّوحِ","https://www.poetsgate.com/ViewPoem.aspx?id=215166",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5582,"خَيالٌ سَرَى وَهْناً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=63489",""],[5582,"أَهاجَتْ لَكَ التَّذْكارَ تِلْكَ المَعاهِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63494",""],[5593,"أجل في البنين الزهر طرفك إنهم","https://www.poetsgate.com/ViewPoem.aspx?id=181018",""],[243,"على الرابية","https://www.poetsgate.com/ViewPoem.aspx?id=50495",""],[5956,"يا صفحة بيضاءَ اِفتح صفحة","https://www.poetsgate.com/ViewPoem.aspx?id=192132",""],[6046,"إسلامي في عصر الكفر","https://www.poetsgate.com/ViewPoem.aspx?id=37429",""],[6048,"أنَا التي مِن فَمي تُستَنزَلُ الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=198214",""]],"verses":[["فَلي مِن غياثِ الدِّينِ نَعماءُ ثَرَّةٌ","يُقَطِّعُ أَنفاسَ الحَيا دونَها الجَهْدُ",0,"د",1,0],["فَلي مِنْ قُرَيْشٍ أَطْيَبوها وَغامِدٌ","تُعاوِنُ مِنْ يَرْبوعَ فيَّ رِياحَها",1,"ح",3,0],["فَلِيمَ وَمَعْذُورٌ على الهَمِّ والبُكا","رَمِيٌّ بِما يُقْذِي العُيونَ كَئِيبُ",2,"ب",1,0],["فَليَمُت بِالداءِ مِن حالِ فَتىً","أَدَّبَتهُ سِيَرُ الناسِ الأُوَل",3,"ل",1,0],["فَليُمسِ لا سمعٌ ولا","بصر لديه ولا فم",4,"م",1,0],["فليمت من يشا ويذهب من شا","ء فإنَّا بعدها لا نبالي",5,"ل",2,0],["فَلْيَمُتْ حاسدوه همّاً وغمّاً","ما لحُكْم الإله منْ تعقيبِ",6,"ب",1,0],["فَلْيُمْضِ عزمَتَهُ الإمامُ فإنه","قد هزَّ منها مَشْرَفِيَّاً مِقْضَبَا",7,"ب",2,0],["فلي من بطن راحته ارتِواءٌ","ولي في ظهر راحته استلامُ",8,"م",1,0],["فليمت في الغيظ واشٍ","بينه يسعى وبيني",9,"ن",2,0],["فَلي مِن سَرجِ مُهري تَختُ مُلكٍ","مَنيعٍ لَم تَنَلهُ يَدُ الرَزايا",10,"ا",3,0],["فلي مِنْ نعمةِ الرحمنِ مالٌ","يصونُ عن احتياجٍ واجتياحِ",11,"ح",1,0],["فَلْيَمُوتُوا بِغَيْظِهِمْ فاحْتِمَالُ الْ","غَيْظِ موْتٌ لَهُمْ بِلا مِيعَادِ",12,"د",1,0],["فَلْيَمْجُدِ الْجَبَلُ الْحُرُّ المَنِيعُ بِهِمْ","وَلْيَشْتَمِلْ ظِلُّهُ الأَمْصَارَ وَالْبِيدَا",13,"د",2,0],["فَلْيُمْعنِ الدهرُ في مكايده","إن أنا لم أَضطلع بها، فمَن؟",14,"ن",1,0],["فليَمْضغِ النهدَ الذي","خلّفتُهُ أنقاضَ نهدِ..",15,"د",1,0],["فلي مقلة للبعد قرحها البكا","وقلب كئيب صادع البين اوجعه",16,"ع",2,0],["فلى من جُذام عصبةٌ جَرَوِيةٌ","صَفَتْ كزُلالٍ من مُتونِ غَمام",17,"م",1,0],["فلي مع الناس عيدٌ في الهلال ولي","وحدي هلال وعيدٌ فيهما زِيدا",18,"د",2,0],["فليمت من بدل الصد غما","كثر العاذلون والأحباب",19,"ب",1,0],["فلي من عَظِيم الشوقِ أعظمُ أنَّةً","ولي حَنَّةٌ مَعْ بُعْدِها وَنَواهَا",20,"ا",3,0],["فلي من ثغركِ الأحوى رجاءٌ","سِوى وحيٍ لِوصلِكِ أو رِضاك",21,"ك",1,0],["فلي منهُما عطرٌ ونورٌ لأنني","أَسلتُهما في خَيرِ أهلي وأُمتي",22,"ي",1,0],["فَليَمنَحَنكَ البَحرُ دُرَّةَ تاجِهِ","إِذ رُعتَهُ بِخَميسِكَ المُتَنَمِّرِ",23,"ر",1,0],["فلي من يَقيني بالإله ودينِهِ","أميرٌ يَقيني السُّوءَ في النَّفْسِ والمُلْكِ",24,"ك",1,0],["فلي من ماله شرف وجاه","ولي من جاهه عِزٌّ ومال",25,"ل",1,0],["فلي من روضك الزاهي","بروض الحسن بستان",26,"ن",1,0],["فلي مذهب بالحب لا تعلمانه","وصعب على من كان مثلكما طرقا",27,"ق",2,0],["فلي من قربها عهدٌ","ألذُّ بهِ مدى الدهرِ",28,"ر",1,0],["فلي مقلةٌ للخوف لم يجر دمعها","وقلبٌ فتىيٌ يحكي الصلاد والروابزا",29,"ز",2,0],["فلي من حزنك الموجود قسم","لكم سهم ولي في الحزن سهم",30,"م",1,0],["فلي من ربيب النعمة اليومَ نعمةٌ","تردُّ الصِّبا جذلانَ والعمرَ مونِقا",31,"ق",2,0],["فلي منها الشواهد بيد أني","سدلت على نقائصك النقابا",32,"ب",2,0],["فلي من جيوش الصبر جيشا مؤيدا","وعند فؤاد الحب فيه جفا جفا",33,"ف",2,0],["فلي مهجة لم تنبتر وتكاد أن","ولي نَفَس لم ينقطع وكأن قدِ",34,"د",1,0],["فليمضِ بعدك مَن أُحِبُّ فقد مضى","منك الحمامُ ببُغْيَتِي ووفاقي",35,"ق",2,0],["فلِي من قلوبِ الغانياتِ ملالةٌ","ولي من صلاحِ الغانياتِ فسادُ",36,"د",1,0],["فَلِي مِن جوىً فيهنَّ رنّةُ عاشِقٍ","وَلي أَدمعٌ تَجرِي دماً ونشيجُ",37,"ج",1,0],["فليمت غيظاً ويفنى كمداً","كل من ينكره لا يستريح",38,"ح",1,0],["فليمتليء دوما صميم الفؤاد","بحكمة الأعمال",39,"ل",1,0],["فلي مِن نداكم خَفضُ عيشٍ مُرفّهٍ","ولي في ذُراكم عزُّ قدرٍ مُرفّعِ",40,"ع",1,0],["فلي مقلة مهما أردت كفافها","أفاضت دموعاً فوق خدي أربعا",41,"ع",2,0],["فلي منه بستان صفا ضوء بعضه","يسير به ند ندى ونرجس",42,"س",1,1],["فَلي من أَمارات الصبابةِ سائقٌ","إِلَيها ولي من حادثِ الشوقِ قائدُ",43,"د",1,0],["فَلي ما تَكَسَّبْتُ مِنْ لذَّتي","بِهِ وعَلى عاذلي ما اكتَسَبْ",44,"ب",1,0],["فلي مَقاماتُ فَرْحةٍ وأَسىً","أَرجوكِ في كُلِّها وأَخشاكِ",45,"ك",1,0],["فلي مهجة تهفو بقابس لوعةً","وقلبٌ إذا فارقتُها يألف الضّرّ",46,"ر",1,0],["فلي من دمع أجفاني غَبوقٌ","تُدار كؤوسه بعد الصَّبوح",47,"ح",1,0],["فلي من كل دينار نصيبٌ","ولي في كل مغترب ديارُ",48,"ر",1,0],["فلي مخرج منها بلطفك رزئها","وإن جزعت نفسي له وتضنت",49,"ت",1,0],["فَلي مِن نَداكَ رَبيعٌ هُناكَ","وَلي مِن نَداكَ رَبيعٌ هُنا",50,"ا",1,0],["فلي ما شئت من روض جميم","أسيم به ومن حوض جمام",51,"م",1,0],["فلي من لاعج الزفرات زاد","ولي من ساكب العبرات شرب",52,"ب",1,0],["فلي مجلس في صدر مقهى أزينه","ولي مجلس في واجهات المكاتب",53,"ب",1,0],["فليمض توّا الى سوق القماش لكي","يلقي له سجدة العباد للوثن",54,"ن",1,0],["فليمرح الذئب ما شاءت مهانته","فقد عفت عنه عين الضيغم الضاري",55,"ر",2,0],["فليمزج الخمرة لي مديرها","بالخمر من عذب لماه الثالج",56,"ج",1,0],["فلي من بعدكم جفن","قريح دائم السهد",57,"د",1,0],["فلي من الأزرق ذي البهاء","يخطر فيه زينة الأحياء",58,"ا",2,0],["فلي ما بينهن عظيم قدر","ومنزلة وودّ واتحاد",59,"د",1,0],["فليمش في حر مع ال","فتيات فالمستور يظهر",60,"ر",1,0],["فلي من مضائي رفْقةٌ وعشيرةٌ","فلا سيِّدٌ ينأى ولا صاحبٌ يسلو",61,"ل",2,0],["فلي ما بين ذاك السرب فيها","أغن ضمن الجفن المنونا",62,"ن",2,0],["فليمرح الليلُ فالساعاتُ بائعةٌ","وقتاً مِنَ الليلِ لا يستلهِمُ الحِقَبا",63,"ب",2,0],["فليمض محمود النقيبة طاهر الا","ثواب رب فضيلة لا يجحد",64,"د",1,0],["فليُمسِكوا عنِّي فلولا أنّني","أبقى على عِرضي إذاً لم أجزَعِ",65,"ع",1,0],["فلي مقلة تقذى إذا ما مددتها","إلى حلة ممن أعول ودورق",66,"ق",1,0],["فلي من صدودكِ آية عشق","أرتّلها إذ فؤادي انْكوى",67,"و",2,0],["فَليَمُت كُلُّ طامِعٍ منه ذُلًّا","فهو عنه الجبالُ تُوصِي الجبالا",68,"ل",2,0],["فَلِيْ مَعَ الْعِشْقِº وَالْعُشَّاْقِ تَجْرُبَةٌ","ضَمَّتْ مِنَ النَّاْسِ أَشْكَاْلاًº وَأَلْوَاْناً",69,"ن",2,0],["فلي من شقاء ِ الدهرِ حَظٌّ مُصَادرٌ","ولي في ضميرِ العشقِ سِرٌ مُسَرَّبُ",70,"ب",1,0],["فَلِي مِنْ دَيَاجِيِرِ الْمُلاَءِ غَيَاهِبٌ","تَلُوذُ بِجِسْمِي وَالْمَلاَذُ حَزَائِقُ",71,"ق",1,0],["فلي منك ياذا الشور والعقل والحجا","مطاليب كان العلم باالحلم نايبه",72,"ب",2,0],["فَلِي مِنْ دَواعِي الحُبِّ ناهٍ وَآمِرٌ","وَلِي قائِدٌ مِنْهُ كَذاكَ وَحادِ",73,"د",1,0],["فَلِي مِنْ أَماراتِ الصَّبابَةِ سائِقٌ","إِلَيْها وَلِي مِنْ جاذِبِ الشَّوْقِ قائِدُ",74,"د",1,0],["فلي مقلة تقذى إذا ما مددتها","غلى حلة ممن أعول ودورق",75,"ق",1,0],["فلي مثلها سفرة في غد","ولي مثلها قصة دامية",76,"ي