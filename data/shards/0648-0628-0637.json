{"poems":[[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[83,"أهدي أبا العباس","https://www.aldiwan.net/poem54278.html","مجزوء الكامل"],[83,"إن الإمام محمدا","https://www.aldiwan.net/poem54326.html","مجزوء الكامل"],[23,"صقعب والد لأبيك قين","https://www.aldiwan.net/poem21391.html","الوافر"],[92,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[78,"يا أيها الملك الذي","https://www.aldiwan.net/poem14067.html","مجزوء الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[97,"جددي الحب واذكري لي الربيعا","https://www.aldiwan.net/poem24854.html","الخفيف"],[80,"وفدت عليك سعادة الأعوام","https://www.aldiwan.net/poem31285.html","الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[69,"نحويكم من شعره","https://www.aldiwan.net/poem28490.html","مجزوء الكامل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[3,"أشاقكَ مِنْ عَبلَ الخَيالُ المُبَهَّجُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10663&r=&rc=17",""]],"verses":[["وَبَطنٌ كَطَيِّ السابِرِيَّةِ لَيِّنٌ","أَقَبُّ لَطيفٌ ضامِرُ الكَشحِ مُدمَجُ",0,"ج",1,0],["وَبِطِيبِ مَحْتِدِهِ زَكَتْ أَخْلاَفُهُ","فَتَضَوَّعَتْ كَالْوَرْدِ فِي نَيْسَانِ",1,"ن",1,0],["وبطرزه مدحٌ زَرَى","بالمدح في القرطاسِ",2,"س",1,0],["وبطرزه لونٌ السما","ء ووجهه قمر بدا",3,"د",2,0],["وَبَطنَ حُباشَةَ السَوداءَ عَدِّد","وَسائِل كُلَّ ذي حَسَبٍ لَئيمِ",4,"م",1,0],["وبطُولِ المدى تُريكِ اللَّيالي","صادِقَ الحُبِّ والوَلاَ وسَجَاحَهْ",5,"ح",2,0],["وَبطيب أَيّامي لَدي","كَ عَرفتُ أَيّامَ الشَبابْ",6,"ب",1,0],["وبطرس الوزرا","يحرّرون المحضرا",7,"ر",2,0],["وبطش من يدَى سمح منيل","كريم معرق في الأكرمينا",8,"ن",2,0],["وبطئٌ في السَّيرِ يُسرعُ وَمْضاً","مثلَ ما تُسرِعُ الأناملُ عَدَّا",9,"د",2,0],["وبطيبِ الربيع أقتات زهراً","وعبيراً ولا أُكابد جوعَا",10,"ع",2,0],["وبطول عمرٍ يعمُرُ الرّتَبَ التي","يختطّها الخطّيّ وهي سَوَامِ",11,"م",1,0],["وبطيءُ الآمال يَسْعى بحرْصٍ","خَطَفَ العيشَ منه حَتْفٌ عجولُ",12,"ل",1,0],["وبطشُهُ ما زالَ عن قُدْرَةٍ","يُغْمِدُ في الصّفح شِفَارَ الصّفاح",13,"ح",1,0],["وبطرفِهِ وقوامِه","متقلِّداً سيفاً ورمحا",14,"ح",2,0],["وَبِطَرفٍ خِلتُهُ حينَ بَدَت","طَرفَ أُمِّ الخِشفِ في عَرفٍ نَدي",15,"ي",1,0],["وَبُطون التاريخ فيها عَجيب","وَغَريب بعاركم موسوم",16,"م",1,0],["وبِطَعْنَةٍ جَلَتِ السِّنانَ فَمثَّلَت","عَيناً لِعَيْنِكَ فِي الكَمِيِّ كَحِيلا",17,"ل",2,0],["وَبَطنٌ كَظَهرِ التُرسِ لَو نِيطَ أَربَعَاً","فَأَصبَحَ صِفراً بَطنُهُ قَد تَخَرخَرا",18,"ر",2,0],["وَبَطنٌ كَظَهرِ التُرسِ لَو شُلَّ أَربَعاً","لأَصبَحَ صِفراً بَطنُهُ ما تَخَرخَرا",19,"ر",2,0],["وبِطَرْفِهِ سِحْرٌ لَوَ ابْصَرَ فِعْله","هاروتُ كان له به أستاذا",20,"ذ",2,0],["وبطوناً من بَقايا طارقٍ","في البقاعِ الجردِ والخضرِ النوامي",21,"م",2,0],["وبطنٌ كطيِّ السابرية ِ لينٌ","أقبّ لطيفٌ ضامرُ الكشح أنعجُ",22,"ج",1,0]]}