الرمل"],[410,"شهر غدا مشتهرا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[436,"أي حبيب في خده شرطه","https://www.aldiwan.net/poem12465.html","المنسرح"],[436,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[436,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[441,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[443,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[455,"وبط من الوادي حللنا مقيلة","https://www.aldiwan.net/poem13630.html","الطويل"],[455,"وبطن من الوادي حللنا مسيله","https://www.aldiwan.net/poem13654.html","الطويل"],[455,"ترب الخطابة والمجادة","https://www.aldiwan.net/poem13873.html","مجزوء الكامل"],[471,"زفت إلينا مواشط الطرق","https://www.aldiwan.net/poem59833.html","المنسرح"],[471,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[503,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[512,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[554,"ليس دار الزوراء دار مقام","https://www.aldiwan.net/poem47209.html","الخفيف"],[554,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[554,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[561,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2562","الخفيف"]],"verses":[["وَبَطنٌ كَطَيِّ السابِرِيَّةِ لَيِّنٌ","أَقَبُّ لَطيفٌ ضامِرُ الكَشحِ مُدمَجُ",0,"ج",1,0],["وَبِطِيبِ مَحْتِدِهِ زَكَتْ أَخْلاَفُهُ","فَتَضَوَّعَتْ كَالْوَرْدِ فِي نَيْسَانِ",1,"ن",1,0],["وبطرزه مدحٌ زَرَى","بالمدح في القرطاسِ",2,"س",1,0],["وبطرزه لونٌ السما","ء ووجهه قمر بدا",3,"د",2,0],["وَبَطنَ حُباشَةَ السَوداءَ عَدِّد","وَسائِل كُلَّ ذي حَسَبٍ لَئيمِ",4,"م",1,0],["وبطُولِ المدى تُريكِ اللَّيالي","صادِقَ الحُبِّ والوَلاَ وسَجَاحَهْ",5,"ح",2,0],["وَبطيب أَيّامي لَدي","كَ عَرفتُ أَيّامَ الشَبابْ",6,"ب",1,0],["وبطرس الوزرا","يحرّرون المحضرا",7,"ر",2,0],["وبطش من يدَى سمح منيل","كريم معرق في الأكرمينا",8,"ن",2,0],["وبطئٌ في السَّيرِ يُسرعُ وَمْضاً","مثلَ ما تُسرِعُ الأناملُ عَدَّا",9,"د",2,0],["وبطيبِ الربيع أقتات زهراً","وعبيراً ولا أُكابد جوعَا",10,"ع",2,0],["وبطول عمرٍ يعمُرُ الرّتَبَ التي","يختطّها الخطّيّ وهي سَوَامِ",11,"م",1,0],["وبطيءُ الآمال يَسْعى بحرْصٍ","خَطَفَ العيشَ منه حَتْفٌ عجولُ",12,"ل",1,0],["وبطشُهُ ما زالَ عن قُدْرَةٍ","يُغْمِدُ في الصّفح شِفَارَ الصّفاح",13,"ح",1,0],["وبطرفِهِ وقوامِه","متقلِّداً سيفاً ورمحا",14,"ح",2,0],["وَبِطَرفٍ خِلتُهُ حينَ بَدَت","طَرفَ أُمِّ الخِشفِ في عَرفٍ نَدي",15,"ي",1,0],["وَبُطون التاريخ فيها عَجيب","وَغَريب بعاركم موسوم",16,"م",1,0],["وبِطَعْنَةٍ جَلَتِ السِّنانَ فَمثَّلَت","عَيناً لِعَيْنِكَ فِي الكَمِيِّ كَحِيلا",17,"ل",2,0],["وَبَطنٌ كَظَهرِ التُرسِ لَو نِيطَ أَربَعَاً","فَأَصبَحَ صِفراً بَطنُهُ قَد تَخَرخَرا",18,"ر",2,0],["وَبَطنٌ كَظَهرِ التُرسِ لَو شُلَّ أَربَعاً","لأَصبَحَ صِفراً بَطنُهُ ما تَخَرخَرا",19,"ر",2,0],["وبِطَرْفِهِ سِحْرٌ لَوَ ابْصَرَ فِعْله","هاروتُ كان له به أستاذا",20,"ذ",2,0],["وبطوناً من بَقايا طارقٍ","في البقاعِ الجردِ والخضرِ النوامي",21,"م",2,0],["وبطنٌ كطيِّ السابرية ِ لينٌ","أقبّ لطيفٌ ضامرُ الكشح أنعجُ",22,"ج",1,0],["وَبِطَلعة لَكَ يا عَلي","مِنها الجَمال بِمَشهَدِ",23,"د",1,0],["وبطرز آيات الجما","ل ببرج لطف ظاهر",24,"ر",1,0],["وبطور القرب ليلاً مذ بدا","ظن موسى أنه نار قبس",25,"س",1,0],["وَبطنُكَ مَملُوءٌ وَضيفُكَ جَائِعٌ","وَفسِقُكَ مَنبي ودِينُكَ قَد خوي",26,"ي",1,0],["وبِطَالَتِى وإِطَالَتِى في كُلِّ مَا","لاَ يَنبَغِى وتَوَافُقِى وشِقَاقِى",27,"ق",2,0],["وَبِطاحُ مَكَّةَ لا يُرى","فيها نَجيعٌ أَسوَدُ",28,"د",1,0],["وبطيب أيام خلت وبكُم جلت","كأس الصفا صرفا وكانت خاليهْ",29,"ي",2,0],["وبطيبةٍ طابت له الأوقات إذ","بلغ المسرة بانتشاقِ شذاها",30,"ا",3,0],["وبطينٍ وأبرصٍ وهمادا","ءانِ غضَّا من قدرِ كلّ رئيسِ",31,"س",1,0],["وبطشةُ قاسٍ تحتها قلبُ راحمٍ","ووثبةُ ليْثٍ قبل عدواه فضلهُ",32,"ل",2,0],["وَبِطَودَي عُمانَ وَالسَيف مِنكُم","عَدَدٌ كاثِرٌ وَعِزٌّ بَجيلُ",33,"ل",1,0],["وبطيفِها وبأنها علمتْ","أنى أَبيت بحبها كلِفا",34,"ف",2,0],["وبَطْشةُ قابضِ الأَرْوا","حِ ليس لأخذِها مَهَل",35,"ل",1,0],["وَبطيرٍ جاءت لنصرةِ طهَ","وَهو حملٌ بادوا وبالخسرِ باؤوا",36,"ا",1,0],["وبطنٌ عليه الطُول والصَّدرُ واسعٌ","رحيبٌ وأمّا ظهرُه فقصيرُ",37,"ر",1,0],["وَبِطيبِ ما أَودَعتَ مِن سِرِّ الهَوى","سَمعي وَذِكرِ صَبابَتي وَتَعَفُّفي",38,"ف",2,0],["وبطيب الوصل ولذّته","ببساط الأنس المنتسجِ",39,"ج",1,0],["وبطول لا عدمناك","على طول الزمان",40,"ن",1,0],["وبطفل في حالة الوضع يدعي","وعن الأم يذهب الخفقان",41,"ن",1,0],["وبطرفها أنا لا براكب طرفها","بين الظعائن هالك مجهود",42,"د",1,0],["وبطشة كف أو تخطى قديمة","وكل حراك بل وكل سكينة",43,"ه",1,0],["وَبِطولي وَبِعَرضي","وَبِعُمقي وَهوَ بُعدُ",44,"د",1,0],["وَبِطيبِ النَشرِ مِنهُ أَصبَحَت","طيبَةٌ تُطو إِلَيها الأَرضُ طَي",45,"ي",1,0],["وَبطرسهِ أَجرى اليَرا","ع فَكاد أَن يَتَكَلَّما",46,"م",2,0],["وبطرفٍ بابِليٍّ","مثلما سُلَّ اليَماني",47,"ن",2,0],["وبطيب النوم احذر تكتحل","وانقد الأقوال",48,"ل",1,0],["وَبطيب عَيش قَد صَفا","كالماءِ هادٍ في الغَدير",49,"ر",1,0],["وبطّةُ الزيتِ بعد ما ملئت","تفرّغَتْ ثم بيعَتِ البطّه",50,"ط",2,0],["وبطرفِه مرضٌ به","أعدى القلوبَ وما تعدّى",51,"د",2,0],["وبطَرْفي نظرتُ لمّا استقلّوا","في نُجومِ الحُمولِ إنّي سَقيمُ",52,"م",1,0],["وبطرفك سحر صدت به","قلبي إذ ينفث في العقد",53,"د",1,0],["وبَطَشتَ بالإِشراكِ بَطْشَةَ قادِرٍ","باللهِ مُجْتَثِّ العِدى مُجتاحِها",54,"ح",3,0],["وبطنٍ من الوادي حللنا مَقِيلة","وفي ضِفَّتَيهِ العُشْبُ يدعوكَ للخصب",55,"ب",1,1],["وبطن من الوادي حللنا مسيله","خلال غصون عاكفات على الشَرب",56,"ب",1,1],["وبطيب ما جنحت له الخُلصا","ءُ من إِحرازِ ودّكْ",57,"ك",1,0],["وَبَطِّنِ العَيشَ بِاِتِفاقِهِما","مِن قَبلُ تَبلى ظِهارَةُ الأُفُقِ",58,"ق",1,0],["وَبَطَّةٌ إِن دُلِّيَت تَحتَها","جوذابَةٌ فَهيَ الَّتي نَطلُبُ",59,"ب",1,0],["وبِطولِ عزْمِكَ مذْ تدلَّى صاعِداً","بمَعارِجِ الإِقْبالِ حتَّى أَنْ دَنَا",60,"ن",2,0],["وَبِطعنٍ لَنا نَوافِذَ فيهِم","كَفُواهِ المَزادِ يُروي الشَليلا",61,"ل",2,0],["وبطيئين عن مزاولةِ الخي","رِ سِراعاً إِلى اِنتِهاكِ الحرامِ",62,"م",1,0],["وبطيءٌ عن القبيحِ ثقيلٌ","وخفيفٌ إلى الجميلِ سريعُ",63,"ع",1,0],["وَبَطيئينَ عَن جَميلٍ فإن عَن","نَ قَبيحٌ سَعوْا لَه إِحضارا",64,"ر",2,0],["وبطه أحمد من بهرت","آيات هداه المنبلج",65,"ج",1,0],["وَبُطئ عَن الداعي فَلَستُ بِآخِذٍ","إِلَيهِ سلاحي مِثلَ ما كُنتُ أَفعَلُ",66,"ل",1,0],["وَبِطَعنِ الكَمِيِّ في حَمَسِ النَق","عِ عَلى مَتنِ هَيكَلٍ جَوّالِ",67,"ل",1,0]]}