www.poetsgate.com/ViewPoem.aspx?id=204945",""],[5741,"وبطحاء في وادٍ بروقك روضها","https://www.poetsgate.com/ViewPoem.aspx?id=187455",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5829,"من شرفتي","https://www.poetsgate.com/ViewPoem.aspx?id=202676",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[5956,"شاعر يدافع عن صديقه","https://www.poetsgate.com/ViewPoem.aspx?id=192463",""],[6023,"وبطومار الوفا ينسخ ما","https://www.poetsgate.com/ViewPoem.aspx?id=123878",""],[1362,"لله أيام لنا","https://www.poetsgate.com/ViewPoem.aspx?id=127725",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[242,"مات الحفيظ فمن يحفظ من عاشا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563799",""]],"verses":[["وَبَطنٌ كَطَيِّ السابِرِيَّةِ لَيِّنٌ","أَقَبُّ لَطيفٌ ضامِرُ الكَشحِ مُدمَجُ",0,"ج",1,0],["وَبِطِيبِ مَحْتِدِهِ زَكَتْ أَخْلاَفُهُ","فَتَضَوَّعَتْ كَالْوَرْدِ فِي نَيْسَانِ",1,"ن",1,0],["وبطرزه مدحٌ زَرَى","بالمدح في القرطاسِ",2,"س",1,0],["وبطرزه لونٌ السما","ء ووجهه قمر بدا",3,"د",2,0],["وَبَطنَ حُباشَةَ السَوداءَ عَدِّد","وَسائِل كُلَّ ذي حَسَبٍ لَئيمِ",4,"م",1,0],["وبطُولِ المدى تُريكِ اللَّيالي","صادِقَ الحُبِّ والوَلاَ وسَجَاحَهْ",5,"ح",2,0],["وَبطيب أَيّامي لَدي","كَ عَرفتُ أَيّامَ الشَبابْ",6,"ب",1,0],["وبطرس الوزرا","يحرّرون المحضرا",7,"ر",2,0],["وبطش من يدَى سمح منيل","كريم معرق في الأكرمينا",8,"ن",2,0],["وبطئٌ في السَّيرِ يُسرعُ وَمْضاً","مثلَ ما تُسرِعُ الأناملُ عَدَّا",9,"د",2,0],["وبطيبِ الربيع أقتات زهراً","وعبيراً ولا أُكابد جوعَا",10,"ع",2,0],["وبطول عمرٍ يعمُرُ الرّتَبَ التي","يختطّها الخطّيّ وهي سَوَامِ",11,"م",1,0],["وبطيءُ الآمال يَسْعى بحرْصٍ","خَطَفَ العيشَ منه حَتْفٌ عجولُ",12,"ل",1,0],["وبطشُهُ ما زالَ عن قُدْرَةٍ","يُغْمِدُ في الصّفح شِفَارَ الصّفاح",13,"ح",1,0],["وبطرفِهِ وقوامِه","متقلِّداً سيفاً ورمحا",14,"ح",2,0],["وَبِطَرفٍ خِلتُهُ حينَ بَدَت","طَرفَ أُمِّ الخِشفِ في عَرفٍ نَدي",15,"ي",1,0],["وَبُطون التاريخ فيها عَجيب","وَغَريب بعاركم موسوم",16,"م",1,0],["وبِطَعْنَةٍ جَلَتِ السِّنانَ فَمثَّلَت","عَيناً لِعَيْنِكَ فِي الكَمِيِّ كَحِيلا",17,"ل",2,0],["وَبَطنٌ كَظَهرِ التُرسِ لَو نِيطَ أَربَعَاً","فَأَصبَحَ صِفراً بَطنُهُ قَد تَخَرخَرا",18,"ر",2,0],["وَبَطنٌ كَظَهرِ التُرسِ لَو شُلَّ أَربَعاً","لأَصبَحَ صِفراً بَطنُهُ ما تَخَرخَرا",19,"ر",2,0],["وبِطَرْفِهِ سِحْرٌ لَوَ ابْصَرَ فِعْله","هاروتُ كان له به أستاذا",20,"ذ",2,0],["وبطوناً من بَقايا طارقٍ","في البقاعِ الجردِ والخضرِ النوامي",21,"م",2,0],["وبطنٌ كطيِّ السابرية ِ لينٌ","أقبّ لطيفٌ ضامرُ الكشح أنعجُ",22,"ج",1,0],["وَبِطَلعة لَكَ يا عَلي","مِنها الجَمال بِمَشهَدِ",23,"د",1,0],["وبطرز آيات الجما","ل ببرج لطف ظاهر",24,"ر",1,0],["وبطور القرب ليلاً مذ بدا","ظن موسى أنه نار قبس",25,"س",1,0],["وَبطنُكَ مَملُوءٌ وَضيفُكَ جَائِعٌ","وَفسِقُكَ مَنبي ودِينُكَ قَد خوي",26,"ي",1,0],["وبِطَالَتِى وإِطَالَتِى في كُلِّ مَا","لاَ يَنبَغِى وتَوَافُقِى وشِقَاقِى",27,"ق",2,0],["وَبِطاحُ مَكَّةَ لا يُرى","فيها نَجيعٌ أَسوَدُ",28,"د",1,0],["وبطيب أيام خلت وبكُم جلت","كأس الصفا صرفا وكانت خاليهْ",29,"ي",2,0],["وبطيبةٍ طابت له الأوقات إذ","بلغ المسرة بانتشاقِ شذاها",30,"ا",3,0],["وبطينٍ وأبرصٍ وهمادا","ءانِ غضَّا من قدرِ كلّ رئيسِ",31,"س",1,0],["وبطشةُ قاسٍ تحتها قلبُ راحمٍ","ووثبةُ ليْثٍ قبل عدواه فضلهُ",32,"ل",2,0],["وَبِطَودَي عُمانَ وَالسَيف مِنكُم","عَدَدٌ كاثِرٌ وَعِزٌّ بَجيلُ",33,"ل",1,0],["وبطيفِها وبأنها علمتْ","أنى أَبيت بحبها كلِفا",34,"ف",2,0],["وبَطْشةُ قابضِ الأَرْوا","حِ ليس لأخذِها مَهَل",35,"ل",1,0],["وَبطيرٍ جاءت لنصرةِ طهَ","وَهو حملٌ بادوا وبالخسرِ باؤوا",36,"ا",1,0],["وبطنٌ عليه الطُول والصَّدرُ واسعٌ","رحيبٌ وأمّا ظهرُه فقصيرُ",37,"ر",1,0],["وَبِطيبِ ما أَودَعتَ مِن سِرِّ الهَوى","سَمعي وَذِكرِ صَبابَتي وَتَعَفُّفي",38,"ف",2,0],["وبطيب الوصل ولذّته","ببساط الأنس المنتسجِ",39,"ج",1,0],["وبطول لا عدمناك","على طول الزمان",40,"ن",1,0],["وبطفل في حالة الوضع يدعي","وعن الأم يذهب الخفقان",41,"ن",1,0],["وبطرفها أنا لا براكب طرفها","بين الظعائن هالك مجهود",42,"د",1,0],["وبطشة كف أو تخطى قديمة","وكل حراك بل وكل سكينة",43,"ه",1,0],["وَبِطولي وَبِعَرضي","وَبِعُمقي وَهوَ بُعدُ",44,"د",1,0],["وَبِطيبِ النَشرِ مِنهُ أَصبَحَت","طيبَةٌ تُطو إِلَيها الأَرضُ طَي",45,"ي",1,0],["وَبطرسهِ أَجرى اليَرا","ع فَكاد أَن يَتَكَلَّما",46,"م",2,0],["وبطرفٍ بابِليٍّ","مثلما سُلَّ اليَماني",47,"ن",2,0],["وبطيب النوم احذر تكتحل","وانقد الأقوال",48,"ل",1,0],["وَبطيب عَيش قَد صَفا","كالماءِ هادٍ في الغَدير",49,"ر",1,0],["وبطّةُ الزيتِ بعد ما ملئت","تفرّغَتْ ثم بيعَتِ البطّه",50,"ط",2,0],["وبطرفِه مرضٌ به","أعدى القلوبَ وما تعدّى",51,"د",2,0],["وبطَرْفي نظرتُ لمّا استقلّوا","في نُجومِ الحُمولِ إنّي سَقيمُ",52,"م",1,0],["وبطرفك سحر صدت به","قلبي إذ ينفث في العقد",53,"د",1,0],["وبَطَشتَ بالإِشراكِ بَطْشَةَ قادِرٍ","باللهِ مُجْتَثِّ العِدى مُجتاحِها",54,"ح",3,0],["وبطنٍ من الوادي حللنا مَقِيلة","وفي ضِفَّتَيهِ العُشْبُ يدعوكَ للخصب",55,"ب",1,1],["وبطن من الوادي حللنا مسيله","خلال غصون عاكفات على الشَرب",56,"ب",1,1],["وبطيب ما جنحت له الخُلصا","ءُ من إِحرازِ ودّكْ",57,"ك",1,0],["وَبَطِّنِ العَيشَ بِاِتِفاقِهِما","مِن قَبلُ تَبلى ظِهارَةُ الأُفُقِ",58,"ق",1,0],["وَبَطَّةٌ إِن دُلِّيَت تَحتَها","جوذابَةٌ فَهيَ الَّتي نَطلُبُ",59,"ب",1,0],["وبِطولِ عزْمِكَ مذْ تدلَّى صاعِداً","بمَعارِجِ الإِقْبالِ حتَّى أَنْ دَنَا",60,"ن",2,0],["وَبِطعنٍ لَنا نَوافِذَ فيهِم","كَفُواهِ المَزادِ يُروي الشَليلا",61,"ل",2,0],["وبطيئين عن مزاولةِ الخي","رِ سِراعاً إِلى اِنتِهاكِ الحرامِ",62,"م",1,0],["وبطيءٌ عن القبيحِ ثقيلٌ","وخفيفٌ إلى الجميلِ سريعُ",63,"ع",1,0],["وَبَطيئينَ عَن جَميلٍ فإن عَن","نَ قَبيحٌ سَعوْا لَه إِحضارا",64,"ر",2,0],["وبطه أحمد من بهرت","آيات هداه المنبلج",65,"ج",1,0],["وَبِطوس قد زارَ الرِضا فحظي بما","قد كانَ يرجوهُ ومنه يأملُ",66,"ل",1,0],["وَبطيبة قد زُرتَ خير الرسل من","طه الهدى والدين كلّ يحصرُ",67,"ر",1,0],["وَبُطرس مُشتاقٌ إِلَيك وودّه","لَنا في زيادات عَلى طُول أَزمان",68,"ن",1,0],["وَبِطُول عمر في سُرور دائم","وَضِياء حلم معْه يُنسَى الأَحنَف",69,"ف",1,0],["وبطنا يحمد فيهم أقاما","بأبراج من الجوزاء قُعسِ",70,"س",1,0],["وبطعنة أردى أبية في الوغى","وشفى بنفث ساق نجل الأكوع",71,"ع",1,0],["وبطيبة وقبا ومكة مع منى","والخيف والجبل العلي الراس",72,"س",1,0],["وبطعنته أردى أبيا عندما","قد ظن جهلا أنه لم يقفل",73,"ل",1,0],["وبطيب ثغرك لي حياة في الهوى","لو كنت أسقي من مراشف فيه",74,"ي",2,0],["وبطشه في الأعادي","عند اشتداد النكالِ",75,"ل",1,0],["وبطرق عمال الخطايا لم يقف","وبمجلس المستهزيين فلم يقِرْ",76,"ر",1,0],["وبطيبة طابوا ونالوا رحمة","معنى الكتاب ومحكم الآيات",77,"ت",1,0],["وبطنُه كبطنِ نونه الذي","فيه بخسفٍ من جضمعٍ احتذي",78,"ي",1,0],["وَبَطَلٍ عَضَّ بِهِ سَيفُ ذَكَرْ","شاخَسَ فيما بَينَ صُدغَيهِ الأَثَرْ",79,"ر",1,0],["وبَطنِ قَوٍّ غَلَساً ويَأجَجَا","يُشبِهنَ هَيقاً هَيقَماً سَفَنَّجا",80,"ج",2,0],["وبطولة الكرّار إبراهيم من","فَتَحَ الشىمَ وجودُ إسماعيلا",81,"ل",2,0],["وبطلعةٍ منه مباركةٍ","حيّى بوجهك طلعةَ البدرِ",82,"ر",1,0],["وبطشه هو العذاب الأكبر","وكادت الأرض به تدمر",83,"ر",1,0],["وبطيخ يطيب الجغم منه","مع الجبسي الكبير الرستني",84,"ي",1,0],["وبطة وخروف","وماء مزن مزمل",85,"ل",1,0],["وبطيب حق النهد فوق ترائب","بيض لرود بضة بيضاء",86,"ا",2,0],["وبطيبةٍ والبانِ ثم بحاجرٍ","وبمرقدٍ جسمُ الحبيب به ثوى",87,"و",2,0],["وَبَطرَبُ في إِثرِ الحُمُولِ كَأَنَّهُ","عَدُوٌّ بِتَفرِيقِ الأَحِبَّةِ مُلهَجُ",88,"ج",1,0],["وَبُطئ عَن الداعي فَلَستُ بِآخِذٍ","إِلَيهِ سلاحي مِثلَ ما كُنتُ أَفعَلُ",89,"ل",1,0],["وبطيبه طاب الغوالي والسنا","بل كلّ ألوى وكُلّ صوار",90,"ر",1,0],["وبطُولِهِ قَد سَاقَهُ ابنُ إمَامِنَا","فِي سُنَّةٍ والحَافِظُ الطَّبَرَانِي",91,"ن",2,0],["وَبطهر الولاء قَلبك فاغمس","وَاخلع النعل فَهوُ واد مقدس",92,"س",1,0],["وبطر كنا المحبوب اولاه نعمة","بها الدين والخلاق والخلق قد ارضى",93,"ض",2,0],["وبطلعة الأنجال تحظى ما صفا","دهر وأشرق بالسرور فؤاد",94,"د",1,0],["وَبَطْنيَ خالٍ مثلَ راسك فارغٌ","على أَنّهُ من حُرقةٍ مثل شائطِ",95,"ط",1,0],["وبطنٌ خواصره كالوِطا","بِ زاد على كرشِ الأكرشِ",96,"ش",1,0],["وبطالع التوفيق لاح لنا السنا","وبدت بشائر كل صفو ادوم",97,"م",1,0],["وبُطونُ الطَّيرِ أمْسَتْ قُبوراً","لِلْعدى إذ تُمزَّق الأشْلاءُ",98,"ا",2,0],["وَبِطيِبِ لَيْلاَتِ العَقِيقِ وَمَا