{"poems":[[29,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[47,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[47,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[82,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[52,"صحا تربي وما قلبي بصاح","https://www.aldiwan.net/poem63977.html","الوافر"],[48,"لنا خفض المحلة والدنايا","https://www.aldiwan.net/poem23599.html","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[102,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[20,"أرِقت لمكفهِر بات فيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69759&r=&rc=0",""],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[201,"أسفر الصبح قم نحيي الصباحا","https://www.aldiwan.net/poem39883.html","الخفيف"],[275,"مسن في الوشي بين زهر ونور","https://www.aldiwan.net/poem35260.html","الخفيف"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[508,"لعمرك يا جرير لقول عمرو","https://www.aldiwan.net/poem21749.html","الوافر"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[563,"إني أنا المعني القديم","https://www.aldiwan.net/poem34081.html","مجزوء الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48891","الكامل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142216","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96464","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112806","البسيط"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137851",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49934","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118395","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109674","البسيط"],[2284,"","https://poetry.dctabudhabi.ae/diwan/poem/143056","الكامل"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21206","الوافر"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131685",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91859","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[4034,"","https://poetry.dctabudhabi.ae/diwan/poem/83117","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94466","الوافر"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123466","الطويل"],[4755,"عُقبَى الحائِرِين","https://www.poetsgate.com/ViewPoem.aspx?id=183683",""],[4755,"وسَأَلْتُهَا: ولِمَن كِتَابَتُهُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184804",""],[4755,"هَدَفٌ ولَيلٌ دامِسٌ وخَلِيَّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=198376",""],[4578,"يا منيتي في الهوى ما كان أوفاك","https://www.poetsgate.com/ViewPoem.aspx?id=49499",""],[4869,"وضح الافكار","https://www.poetsgate.com/ViewPoem.aspx?id=151540",""],[4908,"دمعة حزن على جراح الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=207338",""],[4961,"في ظلال ِ الصَّدق ِ تُنْتَخَبُ الجواهر","https://www.poetsgate.com/ViewPoem.aspx?id=58865",""],[5121,"لُغَةُ الرَّبِيِع","https://www.poetsgate.com/ViewPoem.aspx?id=68726",""],[5121,"وأنا هنا","https://www.poetsgate.com/ViewPoem.aspx?id=215051",""],[5122,"(غني الاوأدم ما تكفل أبمفلسها)","https://www.poetsgate.com/ViewPoem.aspx?id=34736",""],[5190,"في ظلال الوحي الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=153353",""],[5277,"هذيان","https://www.poetsgate.com/ViewPoem.aspx?id=188434",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5725,"امنية","https://www.poetsgate.com/ViewPoem.aspx?id=191275",""],[5725,"شذى الروح","https://www.poetsgate.com/ViewPoem.aspx?id=191727",""],[5725,"حرفي تجرأ","https://www.poetsgate.com/ViewPoem.aspx?id=193960",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5776,"ورطة","https://www.poetsgate.com/ViewPoem.aspx?id=199417",""],[5818,"ماتت","https://www.poetsgate.com/ViewPoem.aspx?id=180632",""],[5897,"يا عيد .. ماذا عن غزة ؟","https://www.poetsgate.com/ViewPoem.aspx?id=174865",""],[5909,"قدِّم لنفسك بيعةً","https://www.poetsgate.com/ViewPoem.aspx?id=210230",""],[5939,"أنثى الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=187751",""],[5956,"طمئنّي عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194621",""],[6019,"نبضاتٌ في حضرة الأمير (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=53829",""],[6089,"حشد الامنيات","https://www.poetsgate.com/ViewPoem.aspx?id=213037",""],[6102,"خامِس الفُصُول !!","https://www.poetsgate.com/ViewPoem.aspx?id=183982",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6225,"إلى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78030&r=&rc=115",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6262,"هل تَرْسُمينَ الآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80110&r=&rc=8",""],[6340,"غادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85846&r=&rc=11",""]],"verses":[["وَإِن أَهلُ الضَلالَةِ خالَفوكُم","أَصابَهُمُ كَما لَقِيَت ثَمودُ",0,"د",1,0],["وَأَناةُ مُقتَدِرٍ تُكَفكِفُ بَأسَهُ","وَقَفاتُ حِلمٍ عِندَهُ مَوجودِ",1,"د",1,0],["وَأَناةٌ عَن كُلِّ شَيءٍ سِوى البَي","نِ وَإِلّا بَينٌ فَصَدٌّ وَصَدفُ",2,"ف",1,0],["وأناةٍ أُرْسِيَتْ في خُلُقٍ","كَنَظيرِ الزَّهرِ في الرّوضِ المَجُود",3,"د",1,0],["وَإِن أَهلِك فَدامَ عَلَيَّ هُلكي","لَها طولُ السَلامَةِ وَالصَلاحِ",4,"ح",1,0],["وَإِن أَهَلَت دِيارٌ مِن أُناسٍ","فَسَوفَ يَمَسُّها مِنهُم خُلُوُّ",5,"ل",2,0],["وإن أَهلَك تَجِد فَقدي وتُخذَل","إذا التَقَتِ العَوالي في الخُطُوبِ",6,"ب",1,0],["وأناه ثانيه ، فماس أمامه","ثوب ، كوشي الموسم الهفهاف",7,"ف",1,0],["وَإِن أَهلِكَ تَجِد فَقدي وَنَجدي","إِذا أَلتَقَتِ العَوالي في الحُروبِ",8,"ب",1,0],["وَإِن أَهلَك فَقَد أَبلَيتُ عُذراً","أَقومُ بِهِ وَلَم آلُ اِجتِهادا",9,"د",2,0],["وأنا ههنا مقيم على العهد","أناجي الأوهام والأشباحا",10,"ح",2,0],["وأنا هكذا صريعُ الغواني","والقناني في مجلسٍ مستور",11,"ر",1,0],["وإن أهديتُ بِكراً من ثناء","إليه تميسُ في حُللِ الجمالِ",12,"ل",1,0],["وَإِن أهلِك فَقَد قَدَّمتُ أَمراً","أفُوزُ بِفَلجِهِ يَومَ الخِصَامِ",13,"م",1,0],["وإن أهَبْتُ بهمْ في يومِ معركةٍ","جاؤوا ولم يمطُلوا عنها بأعذارِ",14,"ر",1,0],["وأنا هو السر الخفي","وأنا الصراط المستقمُ",15,"م",1,0],["وأناة مرتقب السوانح ما أرى","أم حيرة المتردد المتواني",16,"ن",2,0],["وأنا هنا قررت أن أبقى فلا","تحلو الحياة لمن يضيع دياره",17,"ر",2,0],["وَإِن أَهتِف بِكِندَةَ يأتِ صَفٌّ","تُطِلُّ رِمَاحُهُم مَلِكاً هُمامَا",18,"م",2,0],["وان أهاج الضنا ريح الهوى","وطغى موج البلا وعثا جيش الضلالات",19,"ت",1,0],["وانآه عن اوطانه حيثما يرى","غداة النوى اشواقه وانفراده",20,"د",2,0],["وأُناةَ مائِسةِ التّهادي كلّما","قامّت تنوء بِردْفها الرَّجراجِ",21,"ج",1,0],["وان اهمك خطب ما استطعت له","دفعا بنفسك نبههم له ونم",22,"م",1,0],["وان أهل النهى قالوا لذي كسل","حرك ركابك ان الخير في الحركه",23,"ه",1,0],["وأنا هنا في وحدتي يا غادتي","ما زلت أنشقُ من هواكِ مَلابا",24,"ب",2,0],["وإن أهلك فكلُّ فتىً سَيلقى","من الأقدار متلفةً حروجا",25,"ج",2,0],["وانا هجره وهذا الاسم يغنى","وللهجرة ذمام والأمر واضح",26,"ح",1,0],["وإِن أهبتَ بمسرورٍ لدى جللٍ","فالنحس والسعد من جند الاشاراتِ",27,"ت",1,0],["وان اهانوه لا تقرب ودعه اذا","كانت شعاير دين فيه لم تقم",28,"م",1,0],["وَإِنّ أَهدى الناس في سَيره","من أَنزل العيس بِباب الكِرام",29,"م",1,0],["وأن أهل الغرب أعلاهم","خالقهم من قبل أن يخلقوا",30,"ق",3,0],["وإِن أَهلك فإِن الله","دون الخلقِ لِي وَزرُك",31,"ك",1,0],["وأن أهل العلم في ارتعاشِ","من تَعَبٍ في طلب المعاش",32,"ش",1,0],["وإن أهداب عيني لو كنت بها","رحاب مغنى الذي قد فاق معناه",33,"ا",2,0],["وإن أهديتها الدنيا تنادي","فلستَ بمالكٍ هذي الهديَّة",34,"ي",2,0],["وإنَّ أهالي العلمِ تَبقى على المدى","مُعظَّمةً تسمو بِعزةِ واهب",35,"ب",1,0],["وأَنا هُنالِكَ فِي الرَّصِيفِ تَدُورُ بي","رُوحِي, ورُوحِي مارِدٌ مَخمُورُ",36,"ر",1,0],["وأنا هَدِيرُ المَاءِ فِي جَسَدٍ","شَرِبَتْ (رُصَابَتَهُ) (حَبَابَتُهُ)",37,"ت",2,0],["وأنا هُنا ما زِلتُ أَعصِرُ مُهجَتِي","جُمَلًا وأحصدُ غُصَّتِي الأَزَلِيَّة",38,"ل",3,0],["وإن أهم طرباً بين الأنام فقد","طربت القتال وفكي قيد اسراكِ",39,"ك",1,0],["وانا هنا جيتك من الحيد للحيد","شبيت ضوٍ ما يبى اليوم يطفى",40,"ف",2,0],["وَأَنَا هُنَا وَحْدَي فخلف حكايتي","أَلمٌ وخلف قصيدتي إِطْنَابُ",41,"ب",1,0],["وأنا ها هنا مجاميعُ عشق ٍ","وإذا لمْ تكنْ بكفِّكِ تَبْلى",42,"ل",2,0],["وَأَنَا هُنَا بَيْنَ الْجَنَائِنِ حَائِرٌ","مِنْ أَيْنَ أَقْطِفُ وَرْدَةَ اسْتِسْلاَمِي",43,"م",2,0],["وَأَنَا هُنَا فَإِذَا أَرَدْتَ وِصَالِيَا","فَالْحَبْلُ لَمْ يُقْطَعْ فَرِقَّ خِلَالِيَا",44,"ل",3,1],["وأنا هاجسي بالقلب يفتح منافيسه","هواجيس خلق الله هجوسي تريسها",45,"س",3,0],["وأنا هناااااك يهزني رجعُ الصدى","وحدي، ويرقصُ في يدي \\\" المحمولُ \\\"",46,"ل",1,0],["وأنا هنالك حين أترك وجهها","مغرورقاً... والضاحكاتُ تراهُ",47,"ا",2,0],["وإنا ها هنا شعبٌ عظيمٌ","يلاوي الغولَ..هلْ في ذاكَ عُجبُ",48,"ب",1,0],["وأنا هنا لا شئَيَخْدَعُنِي","إلا ّ إذا الأيامُ تخدَعُكِ",49,"ك",1,0],["وانا هنا ارنو الى الوجه الصبيح","اذ لا ارى برصا سيبرؤه المسيح",50,"ح",1,1],["وانا هنا القيت كل محبتي","روحاً فتاهت كالحمامة فيه",51,"ي",2,0],["وانا هنا في الغار حفظ امانة","ركنا شديدا لا يصدّع سقفي",52,"ف",2,0],["وأنَّ أهلي العراقيين ما حَصَدوا","وأنَّ سنبُلَهم غيثٌ لِمَنْ حَصَدا",53,"د",2,0],["وأنا هنا ما بين أسئلة","روحا تجيب عليّ أم بدنا؟",54,"ن",2,0],["وأنا هنا أحسو الظلامَ وحسرتي","أبكي على الفلذات ِ يا طالوتُ",55,"ت",1,0],["وأنا هنا ما في يديّ سوى","أمنيّة وقصيدة خجلى",56,"ل",2,0],["وأنا هنا مقطوعةٌ عُزفت ولم","يَحدُثْ بأنْ نَشزتْ على صوتِ النغمْ",57,"م",1,0],["وأنا هنالِكَ شمسُها","وفصولُها بي مُولَعةْ",58,"ع",2,0],["وأنا هنا بدبيَّ شبه مُشرّدٍ","كيلا أُباد بطلقةٍ وصواعقِ",59,"ق",1,0],["وأنا هنا فوق الرمالِ سفينةٌ","عَشِقَتْكَ موجاً سيدي وبحارا",60,"ر",2,0],["وأنا هنا لغةٌ تشكل عالما","أزهى وتبتدع الجمال مِرارا",61,"ر",2,0],["وَأَنا هِزَبرُ الشِّعرِ دُونِي مَن عَوَى","وَأَنا إِذا حُمَّ المَطِيُّ الفارِسُ",62,"س",1,0],["وأنا هُناكَ على رَصيفِ عزائِهِ","أُقصي هَوايَ لكي أرتِّبَ منزِلَهْ",63,"ل",2,0],["وأنا هنا ببياضها متوسِّمٌ","وجْهَ الشُّروقِ ، بسِفْرِهِ مُسْتَبْصِرُ",64,"ر",1,0],["وأنا هنا , الأيام حولي أحكمتْ","سجنَ اغترابي , فاللقاءُ مُحاصَرُ",65,"ر",1,0],["وأنا هديرُ الهمسِ بينَ شفاهِهمْ","وجبينُهمْ بالمُرِّ راحَ يُقطِّبُ",66,"ب",1,0],["وأنا هنالك تحت غيمةِ موعدٍ","أرْعَى حرائقَ دهشةِ الروحِ الشريده",67,"د",2,0],["وأنا هنا.. جرحٌ توحّدَ نبضه","حزني قديمٌ... مثلما ميلادي",68,"د",2,0]]}