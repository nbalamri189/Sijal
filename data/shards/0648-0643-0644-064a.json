رتهِ","منا وسيفٌ أبيٌّ غير مزدجَر",2,"ر",1,0],["وكلُّ يدٍ أطالَ الحظُّ منها","بلا طَوْلٍ مُقَصِّرَةُ المنالِ",3,"ل",1,0],["وَكُلَّ يَومٍ خِوانٌ","مِنَ الجِدا وَالخِرافِ",4,"ف",1,0],["وكلٌّ يُؤَدِّي دَوْرَهُ وهو ضَاحكٌ","على الغيرِ مضْحُوكٌ على دوره العاتي",5,"ت",2,0],["وكل يوم عليه نعل","وكل يوم عليه جبه",6,"ه",1,0],["وَكُلٌّ يَرى طُرقَ الشَجاعَةِ وَالنَدى","وَلَكِنَّ طَبعَ النَفسِ لِلنَفسِ قائِدُ",7,"د",1,0],["وَكُلِّ يَومِ هِياجٍ نَحنُ قادَتُهُ","إِذا الكُماةُ جَثَوا وَالكَبشُ لِلرُكَبِ",8,"ب",1,0],["وَكُلُّ يَمانٍ أَنتَ جُنَّتُهُ الَّتي","بِها تُتَّقى لِلحَربِ إِذ فُرَّ نابُها",9,"ب",3,0],["وَكُلٌّ يَرى أَنَّهُ سَيِّدٌ","وَلَيسَ لِأَفعالِهِ سودَدُ",10,"د",1,0],["وَكُلَّ يَومٍ بِبَطنِ سِجنٍ","وَكُلَّ آنٍ بِبابِ والي",11,"ل",2,0],["وَكُلَّ يَومٍ مَقالي عِندَ ذِكرِكُمُ","يا ساكِني السَفحِ كَم عَينٍ بِكُم سَفَحَت",12,"ت",1,0],["وكل يومٍ حنينٌ","إلى بعيدِ المنالِ",13,"ل",1,0],["وكل يومٍ نزوعٌ","إلى قصيٍّ غالِ",13,"ل",1,0],["وكل يومٍ هيامٌ","بكلِّ معنىً عالِ",13,"ل",1,0],["وَكُلَيبٍ شُمِّ الفَوارِسِ إِذ حُم","مَ رَماهُ الكُماةُ بِالإِتِّفاقِ",14,"ق",1,0],["وَكُلٍّ يُدانُ بِما كانَ دانَ","فَثَمَّ الجَزاءُ وَثَمَّ الحِساب",15,"ب",1,0],["وَكِلي الأَمرَ إِلى اللَهِ فَما","لَكِ في الدُنيا سِواهُ مِن مُعينْ",16,"ن",1,0],["وَكُلَّ يَومٍ مَلِكٌ مَقتولٌ","أَو خائِفٌ مُرَوَّعٌ ذَليلُ",17,"ل",1,0],["وَكُلَّ يَومٍ شَغَبٌ وَغَصبُ","وَأَنفُسٌ مَقتولَةٌ وَحَربُ",17,"ب",1,0],["وَكُلَّ يَومٍ عَسكَراً فَعَسكَرا","بِالكَرخِ وَالدورِ مَواتاً أَحمَرا",17,"ر",2,0],["وَكُلُّ يُؤَمَّلُ صَفوَ الحَياةِ","وَذَلِكَ في فَلَكٍ لَم يَدُر",18,"ر",1,0],["وَكُلٌّ يُوَصّي النَفسَ عِندَ خُلُوِّهِ","بِزُهدٍ وَلَكِن لا تَصِحُّ العَزائِمُ",19,"م",1,0],["وَكُلَّ يَومٍ تَداعى مِنهُمُ نَفَرٌ","لِبالِغِ السِنِّ أَو طِفلٍ يُذَكّونَه",20,"ن",2,0],["وكُلٌّ يُريدُ العَيْشَ والعيشُ حَتفُه","ويَسْتَعْذِبُ اللذّاتِ وَهْيَ سِمامُ",21,"م",1,0],["وكليب عبر الفوارس إذ عي","ي رماة الأكف بالإنفاق",22,"ق",1,0],["وكلَّ يومٍ للمنايا عصيبْ","يسوقُهم للموتِ من حولِهِ",23,"ه",1,0],["وكليب سم الفوارس إذ حم","م رماه الكماة بالإيفاق",24,"ق",1,0],["وكلٌّ يُغِذُّ إلى طِيَّة","لنا عند غايتها مُلتقى",25,"ا",1,0],["وَكلُّ يُرَجِّي أَنْ يَضلَّ رَشَادُهَا","يَرُومُونَ مِنْهَا أَنْ تُبِيحَ وِسَادَهَا",26,"ه",2,0],["وكل يد بيضا لنا بالرضى انجلت","بسر دعاه قد منحنا بها جبرا",27,"ر",2,0],["وكلِّي لَكُنْ لي من قديمي وحادثي","ولست أُنادي غير من لي مناديا",28,"ي",2,0],["وكلُ يدٍ مرفوعةٍ لك بالدعا","وكل لسانٍ ناطق بالثنا رطبِ",29,"ب",1,0],["وكل يجر النار منهم لقرصه","فعاشوا وخلوا قرص غيرهم نيا",30,"ا",1,0],["وكل يوم ركب نعما طارق","وكل يوم وفد بشر طارى",31,"ر",2,0],["وكل يوم لجداوه ونائله","في ماله غارة شعواء توهيه",32,"ي",2,0],["وكل يوم يوافيني يعلّمني","أنّي من الموت في يومي على وجل",33,"ل",1,0],["وكل يد مبسوطة بإرادة","يسجمعها من بعد بسطتها القبض",34,"ض",1,0],["وكل يوم يكور","عليّ فيك يكرّ",35,"ر",1,0],["وكل يوم أرى في صرفه عبرا","تدقّ في جنبها الآيات والعبر",36,"ر",1,0],["وكلُّ يومٍ يخلفُ يوماً","أراهُ دهراً يعقبُ دهراً",37,"ر",2,0],["وكلّ يجرُّ النارَ حرصاً لقرصه","وكلّ بمكرٍ خادعٌ ودهاءٍ",38,"ا",2,0],["وكل يوم سيولٌ","تجتاح أرضا خصيبه",39,"ب",2,0],["وكل يوم بحار","تطغى بحال رهيبه",39,"ب",2,0],["وكليم الطور وخادمه","وبعيسى الروح وآدمه",40,"ه",1,0],["وكل ينال الكل في نفع نفسه","من العيش والمستبعض الأمر أنفع",41,"ع",1,0],["وكلٌّ يدَّعي وحياً وصدقاً","ونحنُ لأجلِ وَهمٍ نستميت",42,"ت",1,0],["وكلٌّ يحيّي باسماً متنفساً","وما الحيُّ إلا ميِّتٌ في الدُّجى يُقبر",43,"ر",1,0],["وكل يومٍ على ما فيه من هرم","يلقى صروف الليالي وهي أحداث",44,"ث",1,0],["وكل يوم مدّ من عمره","مقبرة في صحراء العمر",45,"ر",1,0],["وَكُلٌّ يَرى قَولَهُ واجِباً","وَقَولَ جَماعَتِهِ لا يَجوزُ",46,"ز",1,0],["وَكُلِّياتُ جُزئِيّا","تِ ما يَظهَرُ مِن كُلّي",47,"ل",2,0],["وكلٌّ يُعاني شُغْلَه غيرَ أنّه","على فَمِه دونَ الكلام رَقيب",48,"ب",1,0],["وَكُلُّ يَومٍ خَطيبٌ فَوقَ مِنبَرِها","وَالخَطبُ يُسمِعُ ما لا تُسمِعِ الخُطَبُ",49,"ب",1,0],["وكُلٌّ يَعافُ الوِردَ من بَعدِ ريِّهِ","وأرماحُ عَوفٍ لا تَعافُ المَوارِدا",50,"د",2,0],["وكلٌّ يرى إذ ذاك ما يستحقّه","ويشغل كلاًّ في الحقيقة شغْلُه",51,"ل",2,0],["وكلُّ يومٍ وَجْهُ خطبٍ كالحٍ","وللخطوب أوْجهٌ كوالح",52,"ح",1,0],["وكلِّي ثناء في علاك وألسن","إذا كنت ممدوحي وأنت المخاطبُ",53,"ب",1,0],["وكُلَّ يَوْمٍ أَقُولُ أُنْجِزُهُ","ونائباتُ الزَّمانِ تَصْرِفُني",54,"ن",2,0],["وكل يطلب الطمعا","ولو من مطمع لمعا",55,"ع",2,0],["وكل يوم ضحايا لا عداد لها","من غدرهم في جحيم البؤس والهون",56,"ن",1,0],["وكل يراعيه كطفل مدلل","عزيزٍ تُناغيه رؤى المتصوِّف",57,"ف",1,0],["وكلُّ يدٍ لها بطشٌ بأخرى","بغَشْمٍ لا ارتقابَ ولا ارتداعا",58,"ع",2,0],["وكلُّ يومٍ بفخر الدين مُقْترنٌ","فمنه للملتجي والمُعْتفي عيدُ",59,"د",1,0],["وكل يرى ما يعجز الفكر وصفه","وما ذاك إلا أن علياك مجمل",60,"ل",1,0],["وَكُلَيباً تَبكي عَلَيهِ البَواكي","وَحَبيبٌ هُناكَ يَدعو العَويلا",61,"ل",2,0],["وكل يوم للندى عنده","وللقرى الجم بها محضر",62,"ر",1,0],["وكلٌّ يَرتَإِي رَأياً ويَدعو","سِواه صاحبَ الرأيِ العَقيمِ",63,"م",1,0],["وَكلُّ يَومٍ مِنَ الأيّام يعجبُنا","فَإِنمّا هوَ نُقصانٌ من العُمُرِ",64,"ر",1,0],["وكل يوم أي لمحة هو في","شأن عليه الشئون منطبقه",65,"ق",2,0],["وكليمك موسى من أنجى","بك أمته يوم الخلج",66,"ج",1,0],["وكُلَّ يومٍ دموعٌ منهُ لو جُمِعَتْ","كانت غديراً كثيرَ الموجِ والزَّبدِ",67,"د",1,0],["وكلَّ يوم في شانْ","من الجَمال الفتان",68,"ن",1,0],["وكُلَّ يومٍ لفُؤادِي فتنةٌ","بفاتِن الحسنِ نحيفٍ عبْلِ",69,"ل",1,0],["وكل يخاف خياله ومخضب","يوم اللقاء شفتيه بالعناب",70,"ب",1,0],["وَكلِّي إِذا حاوَلتُ مَدحك أَلسنٌ","مَتى صادَفت مِنكَ القبول تَقول",71,"ل",1,0],["وكلٌّ يرى منهم سلامةَ عرضِة","ولكن طبعَ النفس للنفسِ يجنُبُ",72,"ب",1,0],["(وَكلٌ يَدَّعِي وَصْلاً بلَيْلى)","وَيَحْتَاجُ الوِصَالُ لِتُرْجُمَانِ",73,"ن",1,0],["وكلّ ٌيُغني لِليلاه ُحتى","يَقِيءَ على مَنْ يُغني الغِناءُ",74,"ا",2,0],["وكلَّ يوم لهم في غيرها رَصَدٌ","تُشَنُّ فيه على الإِسلام غاراتُ",75,"ت",1,0],["وكل يومٍ ترى في صاعِ جؤجؤها","تطلبُهُ أيدٍ كأيدي المعشرِ الفصدهْ",76,"ه",1,0],["وَكَلِيلَةِ الأجْفَانِ عَرْبَدَ طَرْفُهَا","بِصَوَارِمٍ فَرَتِ الحَشَا فِي غِمْدِهَا",77,"ه",2,1],["وكِليمُ الإله بَعْدَ خَليلٍ","وَمَسيحٌ قُوَّامُه الصَّوَّامُ",78,"م",1,0],["وَكُلُّ يَومٍ لَنا عيدٌ بِدَولَتِهِ","عَلى البَشائرِ وَالأَفراحِ نَشهرهُ",79,"ر",2,0],["وَكُل يَبكي طَرفه قَدر وَجده","فَدامَ عَلى إثر المطي وَدامع",80,"ع",1,0],["وكل يوم بكرةً إذ تنتبهْ","اكنس أراضى الدار رُبَّ تشتبهْ",81,"ه",1,0],["وكلُّ يَوْمٍ بِهِ عيدٌ نَسَرُّ بِهِ","فَإِنَ أَتى فيهِ عيدٌ فَهْوَ عيدانِ",82,"ن",1,0],["وكلٌّ يعشقُ الدنيا ولكن","يذوقُ فراقَها قبل الوصالِ",83,"ل",1,0],["وكلٌّ يجرُّ ذيول الرجاءِ","وثوبُ الرجاءِ طِرازُ الحِلَل",84,"ل",1,0],["وكل يستعير وما العواري","إلى من يستعير تضاف أصلا",85,"ل",2,0],["وَكَليم اللَه موسى المُجتَبى","من له الحق تَجلى في الجبل",86,"ل",1,0],["وكل يدٍ شلاء أصيبت فإنما","لها الثلث مما للصحيحة تجعلُ",87,"ل",1,0],["وكلُّ يَعسُوبٍ غدا قدوةً","يودُّ يَوماً أنَّه ما اقتُدي",88,"د",2,0],["وكلّ يومٍ لهُ نحوَ الرّدى سَفَرُ","تُدني منيّتَهُ الآصالُ والبُكَر",89,"ر",1,0],["وَكُلٌ يُبَرهن تَعليله","فَيا لَيتَ شِعريَ من ذا صدَق",90,"ق",1,0],["وكل يناقض بعضه بعضا وما","في الحق معقولان مختلفان",91,"ن",1,0],["وكلّ يوم مرّ منها لنا","عيد سعيد خيره قد شمل",92,"ل",1,0],["وكلي بكل الكل وَصلٌ محققٌ","حقائق حق في دوام تخلّدا",93,"د",2,0],["وكل ينادى بالتهاني مؤرخا","بعيد جلوس جئت يا مصر بالنصر",94,"ر",1,0],["وَكُلٌّ يُظهِرُ الإِسلامَ كَيداً","وَخَوفاً إِن تقتِّلَهُ السيوفُ",95,"ف",1,0],["وَكُلٌّ يَرى فيما أَتَيتُ مُعَبِّراً","عَنِ الوَجدِ أَو عَمّا يَدورُ بِهِ الحِجرُ",96,"ر",1,0],["وكل يوم نرى للغرب معجزة","بها ينال إذا ما سوبق القصبا",97,"ب",2,0],["وَكَليمُ اللَهِ في أُمَّتِهِ","رامَها لَمّا رَأى حُسنَ الثَنا",98,"ن",2,0],["وكل يروم بقلبي مقرا","ويقصي سواه ولا يؤثر",99,"ر",1,0],["وَكُل يَد إِذا مدَّت إِلَيه","يعلمها بِأَن تهب النّوالا",100,"ل",2,0],["وكلي عيونٌ معجباتٌ شواخصٌ","منعن على قلبي التنفس في صدري",101,"ر",2,0],["وكلَ يُسَرّ بما عِنْدهُ","يرى غَثّ ما في يَدَيْه سَمينا",102,"ن",2,0],["وكلي رجاء غير ما الأذن أبصرت","وما سمعت عيناي أو أدركت يدي",103,"د",2,0],["وكل يوم لغيري","من راحتيك مدود",104,"د",1,0],["وكلُّ يواقيتِ الأنام وحَلْيِها","من الأرض والأحجارِ فاخرةِ المَجْدِ",105,"د",1,0],["وكلُّ يومٍ لي برغمِ الزّمان","فوزٌ علىالدّنيَا وعيشٌ رَغِيد",106,"د",1,0],["وكل يتيمة لما ابينت","من الأصداف تهتف واضياعي