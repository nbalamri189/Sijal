يَا؟",132,"ا",3,0],["وكل يهوديٍّ لديك مخول","له الحكم يختار القوى والمغانيا",133,"ي",2,0],["وكل يدعي بالحب وصلا","ولكن أين منه الواصلونا",134,"ن",2,0],["وكل يدعي صدق التآخي","ولكن قلّ صدق القائلينا",134,"ن",2,0],["وكل يحط على غيره","ويمض أذى ذا تسارع لذاك",135,"ك",1,0],["وكل يرى أن المديح وسيلة","لكل كريم من أج الوسائل",136,"ل",1,0],["وكل يرى هذا لمن كان عنده","لينزجر الباغي ويعتدل الميل",137,"ل",1,0],["وكلّ يوم ٍ لنا في الدَّار ِ فاجعةٌ","حتى لقد عيلَتْ الفّهام ُ والعُقلا",138,"ل",2,0],["وكلٌ يدعي شرفا ولكن","قضى الشرفاءُ وارتحل الكريم",139,"م",1,0],["(وكل يدَّعي وصلاً بليلى","وليلى لا تقر لهم بذاكا)",140,"ك",2,0],["وكلّيَ عيبٌ وهم يغرقونَ","بحانِ الليالي ويسكرُ شَرْبُ",141,"ب",1,0],["وكلّي يقينٌ أنّ دربك ساطعٌ","ولي روضة المأوى وقمحٌ ومنزلُ",142,"ل",1,0],["وكلي قد غدوت كسرب نحلٍ","وياعسلا تباركه القطوفُ",143,"ف",1,0],["وكلّ يمانيّ غيورٍ على الهدى","هطول على غوثٍ من الغيثِ أسرعُ",144,"ع",1,0],["وَكُلّي في لَظىً يَغْلي وَشَدٍّ","تُغَلِّفُهُ الشَّهامَةُ وَالإِباءُ",145,"ا",2,0],["وكل يوم بنركع","زى عبيد الوسيه",146,"ي",2,0],["وكُلّي اشْتِياقٌ لِلُقيا الَّذي","سَيأتي كَما في الكِتابِ انْكَتَبْ",147,"ب",1,0],["وكلٌّ ينظمُ الأشعارَ لكن","أنا الأشعارُ والباقي ضبابُ",148,"ب",1,0],["وكلّي انتظاري، وينهدّ ظَهْري","وظَهْرُ الجِدارِ يظلّ عَصيّا",149,"ي",2,0]]}