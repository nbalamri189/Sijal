ry.dctabudhabi.ae/diwan/poem/86514","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75686","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119477","المنسرح"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119680","الرجز"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100673","البسيط"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67522","المنسرح"],[4684,"كورونا..","https://www.poetsgate.com/ViewPoem.aspx?id=201149",""],[4927,"دَاْرُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=30192",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5183,"لفح الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180226",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5725,"البهلول","https://www.poetsgate.com/ViewPoem.aspx?id=178160",""],[6237,"الليل في الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77891&r=&rc=33",""],[6237,"كوكب الشرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77890&r=&rc=32",""]],"verses":[["كَأَنَّهُ في السَمِلِ الأَخلاقِ","مِن تيهِهِ ذو التاجِ وَالأَطواقِ",0,"ق",1,0],["كَأَنَّهُ في الكُرَبِ الشِدادِ","جارُ الحُذاقيِّ أَبي دُوادِ",1,"د",1,0],["كَأَنَّهُ فَيْشَةٌ جَاءُوا لِقُلْفَتِهَا","بِخَاتِنٍ قَطَّ مِنْهَا النِّصْفَ عَنْ غَلَطِ",2,"ط",1,0],["كأنّه في الحَفْلِ ريحُ الصَّبا","وكُلُّ عِطْفٍ فهْوَ غُصْنٌ مَروحْ",3,"ح",1,0],["كَأَنَّهُ في قَلعَةِ ال","بيرَةِ صَيّادُ السَمَك",4,"ك",1,0],["كَأَنَّهُ فِلفِلٌ جَعدٌ يُدَحرِجُهُ","نَضخُ الذَفارى إِذا جَولانُهُ اِنحَدَرا",5,"ر",2,0],["كَأَنَّهُ في صَلاها وَهيَ بارِكَةٌ","ذِراعُ آدَمَ مِن ناطاءَ مَنزوعُ",6,"ع",1,0],["كأنه فيه بدرُ تِمٍّ","يَشُقُّ من زرقة السماءِ",7,"ا",2,0],["كأنه في الكف من خفّةٍ","مقدارُهُ من صُفرة الشمس",8,"س",1,1],["كأنه في فعله نحلة","تتبع منها مجَّةً لسعه",9,"ع",2,0],["كأنه في كل أحوالِهِ","من ذهبٍ لا شكَّ فيه سُبك",10,"ك",1,0],["كأنه في معمعا","ن الحرب سيف ذو شطب",11,"ب",1,0],["كَأَنَّهُ فِرعَونُ لَمّا بَنى","لِرَبِّهِ بَيتاً فَلَم يَقصِدِ",12,"د",1,0],["كأنه في رداء الليل منصلتاً","عن طيِّه بِسُراه رجمُ شيطانِ",13,"ن",1,0],["كأنه في الدار ليث غاب","مزببا يأنس بالأصحاب",14,"ب",1,0],["كأنَّه فَلَكٌ تَنقَضُّ أنجُمُهُ","إذا تصوَّبَ من كِيزانِهِ كُوزُ",15,"ز",1,0],["كَأَنَّهُ في القَومِ غِبَّ السُرى","بَعدَ وَنى الخَيلِ وَتَسآمِها",16,"م",3,0],["كَأَنَّهُ فُرنِيَّةٌ","كَثيرَةُ الشونيزِ",17,"ز",1,0],["كَأَنَّهُ في جَوشَنٍ مُزَرَّرِ","ذي مُقلَةٍ تَسرَحُ فَوقَ المَحجَرِ",18,"ر",1,0],["كَأَنَّهُ في الكَرِّ وَاِقتِحامِهِ","ضَربُ فَتى شَيبانَ في إِقدامِهِ",19,"م",2,0],["كَأَنَّهُ في بَياضِ الصُبحِ مُنصَرِفاً","بَدرُ السَماءِ تَمادى في التَماصيرِ",20,"ر",1,0],["كَأَنَّهُ في الحَياةِ ما فَرَعَ ال","غِصنَ فَغَنّى عَلَيهِ أَو هَتَفا",21,"ف",2,0],["كأنَّهُ فِضَّةٌ مَسبوكَةٌ","أو ذَهبٌ خالصٌ مَسْبوكُ",22,"ك",1,0],["كَأَنَّهُ فِي كِبْرِهِ سَادِرٌ","سَفِينَةٌ فِي لُجَّةٍ مَاخِرَهْ",23,"ر",2,0],["كأنهُ فيه بدرُ تِمٍّ","يَشُق زرقة َ السماءِ",24,"ا",2,0],["كَأنَّهُ فى كِبرهِ سادِراً","سَفينَة ٌ فى لُجَّة ٍ ماخِرَه",25,"ر",2,0],["كأنه في عصره بالعلا","قام على طور علي الإمام",26,"م",1,0],["كَأَنَّهُ فَجْرُ وِصالٍ بَدا","تَحْتَ ظَلامٍ مِنْ دُجى صَدِّهِ",27,"د",2,0],["كأنّه فرعونُ إلاّ أنّهُ","من جانبِ الوجْعاءٍ ذُو الأوتاد",28,"د",1,1],["كأنّه فَردٌ أقوتْ مراتِعُهُ","بُرْقُ الجُنَيْنَةِ فالأخْرابُ فالدّورُ",29,"ر",1,1],["كأنَّهُ فوقَ الجبينِ مشعل","يَراهُ مَن يعقلُ من لا يعقلُ",30,"ل",1,0],["كأنه في كل ما قال لي","يخبرني عن بعض أخباري",31,"ر",2,0],["كأنه في سماء المجد بدر دجى","وسعده لاح بالبشرى يقابله",32,"ل",2,0],["كَأَنَّهُ في جِسمِهِ الضَعيفِ","وَرُيَقَةٌ من وَرق الخَريفِ",33,"ف",1,0],["كأنه في الماءِ زَنْجِيّةٌ","لها من الموجِ أكاليلُ",34,"ل",1,0],["كأنه في ليله غُرَّةٌ","تمّ سناها بسواد الطُرَرْ",35,"ر",1,0],["كأنه في هَطْله المجوَّد","كفُّ العزيزِ الملِك المؤيَّد",36,"د",1,0],["كأنّه في نوره لابسٌ","نورَ الثنايا واحمرارَ الخدود",37,"د",1,0],["كَأَنَّهُ في الذَبِّ عَن","عِرضِ الكَريمِ مُنصُلُ",38,"ل",1,0],["كَأَنَّهُ في الهَيئَةِ ال","سَوداءِ بَدرٌ مُسدِفُ",39,"ف",1,0],["كَأَنَّهُ فَضَّ وَقَد فَضَّها","لَطائِمَ العِطرِ عَلى العِطرِ",40,"ر",1,0],["كأنه في القميص يمشي","فالموذج السوق في رقاقه",41,"ق",2,0],["كأنه في الفراش من سقم","معنى رفيق يجول في فمه",42,"م",2,0],["كَأَنَّهُ في الوَرى فَصلُ الرَبيعِ زَهَت","في العامِ أَيّامُهُ حَتّى لَياليهِ",43,"ي",2,0],["كَأَنَّهُ في صَدرِهِ طائِرٌ","أَو كُرَةٌ في مَلعَبِ الصَّولَجان",44,"ن",1,0],["كَأَنَّهُ في مَيسِرِ الحُسنِ بِال","قِدحِ المُعَلّى فازَ في قِسمِهِ",45,"م",2,0],["كأنه فيه عقد در","فقلت هذا سيفٌ مجوهر",46,"ر",1,0],["كأنَّه في الحَربِ سِلمُ الرَّدَى","إذ كانَ حَرب المالِ في السِّلمِ",47,"م",1,0],["كأنه فلو القَلا","جهلاً وعقباه القِلا",48,"ل",2,0],["كأنّه في الأَثيل مِنهُ","بدر دجىً حفّه الظلامُ",49,"م",1,1],["كأنه في جميعها ملك","ممكن والفنون من خدمه",50,"م",2,0],["كأنه في صدور المجد بدر دجىً","دارت بهِ كالنجوم الشهب أنجالُ",51,"ل",1,0],["كأنه في قناةٍ وهو منحدرٌ","ذوب اللجين جرى في جدول الذهبِ",52,"ب",1,0],["كأنّه في زُهدِه","مثلُ أوَيسَ القُرَني",53,"ي",1,0],["كَأَنَّهُ فِي مجالِ الخيلِ لَيْثُ شرىً","وعندَ مُزْدَحَمِ الفرسانِ قُطْبُ رَحى",54,"ح",2,0],["كأنه في الخطب بالحظِّ أو","بدرِ بني عبد الرحيم أهتدى",55,"ا",1,0],["كَأَنَّهُ في وَسطِ رَوضٍ مُعشِبِ","ما بَينَ شيحٍ كَمَشيبِ الأَشيَبِ",56,"ب",1,0],["كَأَنَّهُ في القُضُبِ المَوائِل","كَراتُ عاجٍ أَو نُضارٌ نازِل",56,"ل",1,0],["كَأَنَّهُ في اِصفِرارِ وَجنَتِها","فُصوصُ فيروزِجٍ عَلى ذَهَبِ",57,"ب",1,0],["كَأَنَّهُ في ليقَةِ الأَديبِ","غالِيَةٌ في سالِفِ الحَبيبِ",58,"ب",1,0],["كأنَّه في هَبَواتِ السُّرى","يُثيرُهنَّ الخاضِبُ الأصلَمُ",59,"م",1,0],["كأنه في دياج الليل دان له","بدر للثم ثغور الظلم مستدل",60,"ل",1,0],["كأنَّهُ فوقَ كُرسِيِّ الخِطابَةِ في","صَدْرِ المَحافِلِ موْلانا الإِمامُ عَلي",61,"ل",2,0],["كأنّه فوقنا نسرٌ","وعند الجارِ كالأرنبْ",62,"ب",1,0],["كأنَّه في الجُود قبلَ سُؤلِه","بابُ سَماءٍ سَحَّ في تدفُّقِ",63,"ق",1,0],["كَأَنَّ هِفتَ القِطقِطِ المَنثورِ","بَعدَ رَذاذِ الديمَةِ المَحدورِ",64,"ر",1,0],["كَأَنَّهُ فَوْقَ حَشِيَّاتِهِ","رَيْحَانَةٌ أَبْطَأَ عَنْهَا مَعِينْ",65,"ن",1,0],["كَأَنَّهُ في كَفِّها أَدْمُعٌ","مِنْ أَعْيُنٍ قَدْ مُلِئَتْ إِثْمِدَا",66,"د",2,0],["كأنّه فضّة تعلو زُمُرّدةً","خضراء يضحك منها ناظرٌ ذهبُ",67,"ب",1,0],["كأنهُ فلكُ نوحٍ غير أَنَّ بهِ","من كلِّ فنٍّ مكانَ الزوج أزواجها",68,"ا",1,0],["كأنَّهُ فارسيٌّ قد","عاين الشمس تَطلَع",69,"ع",1,0],["كانّه في يَدَ بمحركهِ","ينشُرُ قَلبي بهِ وما شَعَرا",70,"ر",2,0],["كأنّه في فعلهِ عاشقاً","روّعهُ العشقُ بهجرانِ",71,"ن",1,0],["كأنّه فَلَكٌ تنقَضُّ أنْجُمُهُ","إذا تَصَوَّبَ من كِيزَانِهَا كُوزُ",72,"ز",1,0],["كَأَنَّهُ فَكَّرَ المعنّى","في سوءِ أفعالِهِ فأَطرَق",73,"ق",1,0],["كَأَنَّهُ في عَينِ كُلِّ مُبصِرِ","مِذَبَّةٌ مِنَ الحَريرِ الأَخضَرِ",74,"ر",1,0],["كأنه فوق ظهر الخيل مستوياً","وقد حوى السبق بدرٌ خالط السُّحبا",75,"ب",2,0],["كَأنَّهُ فِي أفْقِهِ زَوْرَقٌ","قَدْ جَهَّزُوهُ بِالتَّهانِي إلَيْك",76,"ك",1,0],["كَأنَّهُ فِي الجُيُوشِ ظَافِرْ","لَمَّا بَدَا وَجْهُهُ وَلاَحْ",77,"ح",1,0],["كَأنَّهُ فِي أفْقِهِ مِنْجَلٌ","لِزَرْعِ أعْمَارِ العِدَى يَحْصُدُ",78,"د",1,0],["كأنه فيما عناه عُيّرا","أو أنه بما جرى تطيرا",79,"ر",2,0],["كأنه في رباها جيش ملحمةٍ","مدت عليه غصون الدوح أعلاما",80,"م",2,0],["كأنه فاقد إلفا يحنّ له","حتى يكاد من الأشواق يلتهب",81,"ب",1,0],["كأنه في صحون اللازورد إذا","ما قد بدا شفق واللوز نجمات",82,"ت",1,0],["كَأَنَّهُ فَلكَةٌ في كَفِّ فارِسِهِ","إِذا جَرى وَهوَ حامي العَقبِ مُنسَحِلُ",83,"ل",1,0],["كأنه في الكف من خفة","مقداره من صفرة الورس",84,"س",1,0],["كأنه فوق خده حبب","يلعب بعد المزاج في الراح",85,"ح",1,0],["كأنه في طوافه جملٌ","يخبط لا يلتوي على الحجر",86,"ر",1,0],["كأنَهُ في رهَجٍ شمعَةٌ","مصفَرّةٌ غرّتهُ نارُها",87,"ه",2,0],["كَأَنَّهُ فيكَ بَدرُ تِمٍّ","يَقطَعُ في زرقَةِ السماءِ",88,"ا",2,0],["كَأَنَّهُ في ضَربِها لاطمٌ","تُفَّاحَ خَدَّيهِ بِأَصدَاغِهِ",89,"غ",2,0],["كأنه في العلى مليك","لاق به التخت والسرير",90,"ر",1,0],["كأنّه في خدّه إذ بدا","ليل تبدّى طالعاً من نهار",91,"ر",1,0],["كأنه في الطول برج ايفلِ","وهي له كغرفة فوق الذرى",92,"ا",1,0],["كأنّه في الورى رصاصٌ","في الثقلِ والنتنِ والبرودَه",93,"ه",1,0],["كأنَّهُ في صواني التبر جمر غضاً","مستوقدٌ رُفعت عنّا مَضَرَّتهُ",94,"ت",2,0],["كأنه في منصته أمير","يخوف بطشه أهل العناد",95,"د",1,0],["كأنه في عشقه مهجورُ","دموعه من ناره تفورُ",96,"ر",1,0],["كأنّه في وجارِ لبّته","أرْيٌ وصدرُ القناةِ مُشتارُ",97,"ر",1,0],["كأنَّه فوقَ يَدَي حامله","دهرُ على كلّ أخي عَقلٍ سَلِط",98,"ط",1,1],["كَأَنَّهُ في نَفسِهِ عَروسُ","إِذ أَنَّهُ يَحلو بِهِ التَعريسُ",99,"س",1,0],["كَأَنّه فَوق طِرفٍ جال مستبقاً","طودٌ عَلا فعلاه مطلع البدر",100,"ر",1,0],["كَأَنَّهُ في دِلاءِ القَومِ إِذ نَهَزوا","حَمٌّ عَلى وَدَكٍ في القِدرِ مَجمولُ",101,"ل",1,0],["كأنه في البريا","خليفة للمسيح",102,"ح",1,0],["كأنّه فَلَكٌ تَختالُ أنجمُهُ","إذا التَّهَلُّلُ من تِيجانِهِ اطَّرَدَا",103,"د",2,0],["كأنه فوقما البسفور مستوياً","خالٌ ومن جانبيه مبسمٌ حسن",104,"ن",1,0],["كأنه فرخٌ من الزيتون","غضٍّ على مجتمع العيون",105,"ن",1,0],["كأَنَّه في دجاها راهب غزل","قَد شق عَن صدره الجلباب من طرب",106,"ب",1,0],["كأنه في الاناء أوعية","من البجادي ملؤها عسل",107,"ل",1,0],["كأنه في غفلةٍ","مذ نحن كنّا في طرَب",108,"ب",1,0],["كانهُ في محيا العز شامتُهُ","او منزل السعد مذ ارَّختهُ غرَّه",109,"ر",2,0],["كأنه في اتساع صورته","روثة فيل قد داسها جمل",110,"ل",1,0],["كأنه فارس قد رام حرباً","تأبط في الدجى أنياب أفعى",111,"ع",2,0],["كَأَنَّهُ فِيْ صَمِيْمِ الْجَوْفِ مُسْتَعِرٌ","وَأَهْلُ عَفْرَاْءَ فِيْ أَفْرَاْنِهِ حَطَبُ",112,"ب",1,0],["كأنه فوق أعواد نصبن له","بحر تكشّر عن فيه الأساطيل",113,"ل",1,0],["كأنه في حنايا الدهر تحمله","ذو النون يدعو ولطف الله يحميه",114,"ي",2,0],["كأنه فم واشٍ من تحذره","تعود الهمس والأوراق آذان",115,"ن",1,0],["كأنه فنن ألقى الرياح به","في أرض محنته لامن يشيعه",116,"ع",2,0],["كأنه في جنة روحه","نجم الثريا فيها قد علّقا",117,"ق",2,0],["كأنه فيلسوفٌ مطرقٌ عجباً","مما يرى في حياة الناس من درنِ",118,"ن",1,0],["كأنه في يديها غصنُ ناضرة","تسمو به ثم تدنو ذات منقارِ",119,"ر",1,0]]}