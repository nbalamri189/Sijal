{"poems":[[49,"ليس جودا عطية بسؤال","https://www.aldiwan.net/poem25304.html","الخفيف"],[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[47,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[68,"صال فينا الردى جهارا نهارا","https://www.aldiwan.net/poem40126.html","الخفيف"],[46,"وأخ أملى عليه اختلاط ال","https://www.aldiwan.net/poem29717.html","الخفيف"],[108,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[47,"يا فضل فيم الصدود والغضب","https://www.poetsgate.com/ViewPoem.aspx?id=33097",""],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[435,"ليس جفر الهباة يوم رهان","https://www.aldiwan.net/poem40810.html","الخفيف"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6774","السريع"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20029","الخفيف"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67889","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75861","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204903","الخفيف"],[4691,"قل: لسامي أخرستَ صوت َ الخصامِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=59591",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5362,"في ذمة التمدن الكاذب","https://www.poetsgate.com/ViewPoem.aspx?id=170371",""],[5410,"صرخات من أعلى المنارة","https://www.poetsgate.com/ViewPoem.aspx?id=142533",""],[5939,"بُعدًا هواكِ","https://www.poetsgate.com/ViewPoem.aspx?id=178576",""]],"verses":[["لَيسَ جوداً عَطِيَّةٌ بِسُؤالِ","قَد يَهُزُّ السُؤالُ غَيرَ الجَوادِ",0,"د",1,1],["لَيسَ جَلالُ اللَيلِ ما أَدهَشَني","وَإِنَّما أَدهَشَني جَلالي",1,"ي",1,0],["لَيسَ جَزاءُ القُشولِ فيكَ بِما","تَقصُرُ عَنهُ الصِفاتُ وَالخُطَبُ",2,"ب",1,0],["لَيسَ جُهدي مِن بَعدِ فَقدِكَ إِلّا","أَرسِلَ الدَمعَ فيكَ وَالأَشعارا",3,"ر",2,0],["لَيسَ جَدعُ الأُنوفِ جَدعاً وَلَكِن","بَعضُ مَن نَصطَفيهِ جَدعُ الأُنوفِ",4,"ف",1,0],["ليس جمالُ الطبع في غادة","مثلَ جمال اليد والساعد",5,"د",1,0],["ليس جزاء القئول فيك بما","تقصر عنه الصفات والخطب",6,"ب",1,0],["ليس جمالُ المرءِ في بُردِه","جمالُه في الحسَب الأرفعِ",7,"ع",1,0],["ليس جفر الهباة يوم رهانٍ","مثل يوم جرى بوادي الفواره",8,"ه",1,1],["لَيسَ جَمالُ الشَيخِ إِلّا التُقى","وَالمَحوُ لِلسوءِ بِفِعلٍ حَسَن",9,"ن",1,0],["لَيسَ جودٌ وَراءَ جودِكَ ينتا","بُ وَلا يُعتَفي لِغَيرِكَ عاني",10,"ن",2,0],["ليس جودُ الربيعِ راشَفَ وجهَ ال","أرضِ عن مبسمٍ من الأزهار",11,"ر",1,1],["لَيسَ جَمعُ الأَضدادِ عِندي مُحالاً","إِنَّني جامِع لِنار وَماءِ",12,"ا",2,0],["ليس جنسي من الورى أنت جنسي","فصليني وأقبلي يا طيور",13,"ر",1,0],["ليس َ جرما أن يخطئ المرء لكن","في تماديه غاية الإجرامِ",14,"م",1,0],["ليس جبن بهم ولكن نفوس","صاغيات إلى الخداع جنوح",15,"ح",1,0],["ليس جمال المرء في صبغة","أهو كتاب في يد الكاتب",16,"ب",1,0],["لِيُسَجِّلَ التاريخ صرخةَ حائرٍ","يُعلي لواءَ الشعر عزماً مُلهِما",17,"م",2,0],["لَيُسَجِّلَنْ أقوالَها","أنْ كِبْرُها أقوَى لها",18,"ل",3,0]]}