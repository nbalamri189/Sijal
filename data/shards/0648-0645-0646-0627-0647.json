{"poems":[[57,"أداري الناس عما بي","https://www.aldiwan.net/poem26556.html","الهزج"],[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[90,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[23,"كانت قريش بيضة فتفلقت","https://www.aldiwan.net/poem21409.html","الكامل"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[52,"ألا يا حبذا والله","https://www.aldiwan.net/poem63814.html","الهزج"],[146,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[190,"أرى ما أشتهيه يفر مني","https://www.aldiwan.net/poem44110.html","الوافر"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[504,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[510,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[543,"يا جلال العصر علما","https://www.aldiwan.net/poem47938.html","عموديه"],[543,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[563,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[563,"إن النصارى واليهود كلاهما","https://www.aldiwan.net/poem34613.html","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133828","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112713","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77798","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109005","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144763","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2222,"","https://poetry.dctabudhabi.ae/diwan/poem/147074","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76071","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127398","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53027","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109924","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91667","الهزج"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123488","الكامل"],[4691,"مبروك للعالمي متصدر لا تكلمني !!","https://www.poetsgate.com/ViewPoem.aspx?id=156952",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5277,"حبّها","https://www.poetsgate.com/ViewPoem.aspx?id=185615",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5956,"أرجو إله الناس يجمعني به","https://www.poetsgate.com/ViewPoem.aspx?id=207523",""],[6152,"إلى من أشتكي!؟","https://www.poetsgate.com/ViewPoem.aspx?id=203991",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""]],"verses":[["وَمَن أَهدى لِيَ العَتبَ","فَأَهدَيتُ لَهُ العُتبى",0,"ا",1,0],["وَمُناهُمُ أَن يَحطِموا بِيَدي","قَلَماً أَثارَ عَلَيهِمُ النَقعا",1,"ع",2,0],["ومن أهل آداب كشارقة الضحى","ومن أهل علم كالبحار الزواخر",2,"ر",1,0],["وَمَناةُ رَبّي خَصَّهُم بِكَرامَةٍ","حُجّابُ بَيتِ اللَهِ ذي الأَستارِ",3,"ر",1,0],["وَمَنّاهُمُ الخَيلَ مَجنوبَةً","فَجِئنَ بِكُلِّ فَتىً باسِلِ",4,"ل",1,0],["وَمَن أَهدى لِيَ الرَيحا","نَ قَد شابَ بِهِ سِحرا",5,"ر",2,0],["ومناهلٌ إن يرضَ واردها","بالنَّهْل يجبُرْهُ على العَلِّ",6,"ل",1,0],["ومن أهواه يبغضني عنادا","ومن أشناه شصّا في لهاتي",7,"ت",2,0],["ومن اهتدى طفلا واصبح علمه","علماً لمن ضل السبيل ومعلما",8,"م",2,0],["وَمُناةَ الرَجسِ عَن داري اِقصِها","وَمِنَ الأَوثانِ طَهِّر كَعبَتَي",9,"ي",1,0],["ومناه ذكرى سليمى لوجدٍ","ظل يذكي لهيبه واستعاره",10,"ر",2,0],["ومناه في الشدو شدو غريب","كلما اعتاده الهوى واستثاره",10,"ر",2,0],["وَمُناهِبٍ أَقصَدتُ وسط جُموعِهِ","وَعِشارِ راعٍ قَد أَخَذتُ فَما تُرى",11,"ا",1,0],["ومنْ أهلٍ وقدْ تمّوا خلاقاً","ومن نسبٍ يُعدُّ منَ المفاخرْ",12,"ر",1,0],["ومُناه لَثمُ أكوا","سٍ مِنَ آدابكَ لَثما",13,"م",2,0],["ومُناهُ يُرسِلُني أمامَهُ سيدي","وأنا الخديمُ الشاعرُ المتُكلِّمُ",14,"م",1,0],["ومُناها فازت به في مِناها","بعدما قد أتت إلى عرفاتك",15,"ك",1,0],["ومن اهتدى والله أكمل عقله","بعناية سبقت يرى فيشاهد",16,"د",1,0],["ومن أهلاً وجيراناً حباها","بما أسلفت من كرم الفعال",17,"ل",1,0],["ومن أهل ودك يا سيدي","انيل وفي المكرمين انحسب",18,"ب",1,0],["وَمناه بل قرباته","في المهرجان الأَقدم",19,"م",1,0],["ومناهل الخيل الجمي","لة حول أوطاني جميمه",20,"م",2,0],["ومن أهدت لواحظه","لجسمي السقمَ منعطفُ",21,"ف",1,0],["ومناها بلوغ أوفر قسم","وبكم أدركت بلوغ مناها",22,"ا",3,0],["ومن أهواه يبغضني عناداً","ومن أهواه شص في لهاتي",23,"ت",2,0],["وَمُناهم أَن قَد رَمَوا جمراتٍ","بِمناكُم يَشُبُّهُنَّ ضِرامُ",24,"م",1,0],["ومن أهاب بنا واليأس قاتلنا","لنصبرن وفضل الله ننتظر",25,"ر",1,0],["ومن أهيل النقى تمَّ النقى وبدا","تناقضُ الجسم من ضرٍّ ومن ضرمِ",26,"م",1,0],["ومَناهٍ قضيتُها بتلاهٍ","مُوبِقاتٍ تطولُ عنها الشُروحُ",27,"ح",1,0],["وَمَن أَهوى تدانيهِ","وَمَن يَهوى فُكاهاتي",28,"ت",2,0],["وَمَناهم بِالذُل وَالإرهاقِ","فَهُمُ في الثَراءِ وَالاملاقِ",29,"ق",1,0],["ومناهل الخيرات رد لا معرضا","عما زعمت بها كريه أجاج",30,"ج",1,0],["ومنا هريفيٌّ ومنا محيسنٌ","جميعمُ الأبطالُ في ذكرهم فخرُ",31,"ر",1,0],["ومَن أهدى لها وَرداً","وبَعدَ الصَّدِّ أرضاها",32,"ا",3,0],["ومن أهوى على طول المنافي","أدانيها إِتِّعاداً وادِّكارا",33,"ر",2,0],["ومن أهل نجد من تزلزل خيفة","وخالطه رعب وفر من الذعر",34,"ر",1,0],["ومناه من أغواعه إذ كان دأبه","غواية من والاه إذ كان أظلما",35,"م",2,0],["ومن أهل الحلول ذوي المخازي","فقد جاءوا بقول ذي وبال",36,"ل",1,0],["ومن أهيل النقى تم النقا وبدا","تناقص الجسم من ضرٍ ومن ضرم",37,"م",1,0],["ومناهلٍ يحيي القلوب ورودها","وعيونهُ تروي ظمأ الظمآنِ",38,"ن",1,0],["ومُناهِضُ الجهلِ الشَّنيع بأمتي","بتكتاتف البنك الذي يتجاوبُ",39,"ب",1,0],["ومن أهواه عز عليه وصلي","وصار بهجره يزداد صرما",40,"م",2,0],["ومنا هَفوا وَللحين غابَت نُجومَهُم","وَبتراب رودس دَفنوا فتيان",41,"ن",1,0],["وَمَنْ أَهَبُ الْصِّدْقَ الَّذِيْ طَالَ لَبْثُهُ","حَبِيْسَاً بَأَعْمَاقِيْ يَضُجُّ وَيَصْخَبُ؟",42,"ب",1,0]]}