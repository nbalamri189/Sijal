w.poetsgate.com/ViewPoem.aspx?id=20966",""],[51,"غابن الحمد حقَّهُ مغبُونهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30800",""],[51,"مكْرُ الزَّمانِ علينا غير مأمونِ","https://www.poetsgate.com/ViewPoem.aspx?id=30805",""],[39,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[105,"قل للوزير إذا خلا لك وجهه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54996&r=&rc=166",""],[63,"الوِردُ يَبسِمُ والرَّكائِبُ حُوَّمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25952&r=&rc=14",""],[63,"خاض الدُّجى -وَرِواقُ اللَّيل مَسدولِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25938&r=&rc=0",""],[31,"خَانَكَ مَنْ تَهْوَى فَلاَ تَخُنْهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19137&r=&rc=399",""]],"verses":[["خافِقَ الجَأشِ ناظِراً","مَن يُجيبُ الدَواعِيا",0,"ي",2,0],["خابِطَةً لا تَتَّقي","صَدمَ أَخٍ وَلا اِبنَ عَم",1,"م",1,0],["خاطَرَتِ الشَولُ بِأَذنابِها","لَمّا اِنطَوى قَرقارُ ذاكَ الفَنيق",2,"ق",1,0],["خارِجِيّاتٌ يُبادونَ المَدى","وَلَها فيكَ بَواقٍ وَقُعُد",3,"د",1,0],["خالَسنَنا النَظَرَ المُريبَ كَما رَنَت","بَقَرُ الجَواءِ إِلى وَميضٍ يَلمَحُ",4,"ح",1,0],["خاضَتْ دُجى الليلِ سَلْمى وهْيَ تَخْفِرُها","والدّارُ لا صَقَبٌ مِنّا ولا أَمَمُ",5,"م",1,0],["خاضَتْ بهِ ثُغَرَ الفَيافي والدُّجَى","خُوصٌ نَماهُنَّ الجَديلُ وشَدْقَمُ",6,"م",1,0],["خاض الدُّجى ورِواقُ الليل مَسدولبُ","بَرقٌ كما اهتزَّ ماضي الحدِّ مَصقولُ",7,"ل",1,1],["خاضَ العَجاجَ مُحَجَّلاً حَتّى إِذ","شَهِدَ الوَقيعَةَ عادَ غَيرَ مُحَجَّلِ",8,"ل",1,0],["خالِف هَوى مَن هَمُّهُ","في كُلِّ ما تَهوى خِلافُك",9,"ك",1,0],["خاتَمٌ لي ما لَهُ أَثَرٌ","فيهِ مِن عَضِّ الحَبيبِ أَثَر",10,"ر",1,1],["خالَفْتُ مُعْتادَ الرّماةِ بفِعْلَتي","فبَعْثْتُ نحْوَ السّهْمِ بالقِرْطاسِ",11,"س",1,0],["خانَتْ مَواثيقَ أعْطَتْها مؤكَّدةً","أخْسِرْ بعَهْدٍ قَريبِ العَهْدِ غيْرَ وَفِي",12,"ي",1,0],["خَالِصاً عِنْدَ كُلِّ سِرٍّ وَجَهْرٍ","لَكَ حُبِّي وَمِدْحَتِي وَدُعَائي",13,"ا",2,0],["خاشِعاتٍ يُظهِرنَ أَكسِيَةَ الخَز","زِ وَيُبطِنَّ دونَها بِشُفوفِ",14,"ف",1,0],["خالَطَ القَلبَ هُمومٌ وَحَزَن","وَاِدِّكارٌ بَعدَما كانَ اِطمَأَنّ",15,"ن",1,1],["خانَ نُطقي وَلَم تَخُنّي دُموعي","لَهفَ نَفسي فَقَصَّرَت أَشعاري",16,"ي",1,0],["خالَفتُ فيكَ الجازِعينِ فَلَم أَنُح","حُزناً عَلَيكَ وَأَنتَ مِن أَترابي",17,"ب",2,0],["خالِدَ الآثارِ لا تَخشَ البِلى","لَيسَ يَبلى مَن لَهُ ذِكرٌ خَلَد",18,"د",1,0],["خافَها العالَمُ حَتّى أَصبَحَت","رُسُلاً تَحمِلُ أَمناً وَسَلاما",19,"م",2,0],["خالِدٌ أَنتَ رَغمَ أَنفِ اللَيالي","في كِبارِ الرِجالِ أَهلِ الخُلودِ",20,"د",1,0],["خافَ مَأثورَ قَولِهِ فَتَعالى","عَن صَغارٍ وَماتَ مَوتَ الأُسودِ",20,"د",1,0],["خاطَهُ رَبُّهُ بِإِبرَةِ يُمنٍ","أَوجَروا سَمَّها خُيوطُ الهَناءِ",21,"ا",2,0],["خانا فَلَو حَكَما عَلى عَينِ اِمريءٍ","سَرَقا بِمَكرِهِما مِنَ الجفنِ الوَسَن",22,"ن",1,0],["خانَتنِيَ الأَيّامُ فيكَ فَقَرَّبَت","يَومَ الرَدى مِن لَيلَةِ الميلادِ",23,"د",1,0],["خاطِري أَنفَذُ مَهما","قيسَ مِن حَدِّ السِنانِ",24,"ن",1,0],["خالي بِذي بَقَرٍ حَمى أَصحابَهُ","وَشَرى بِحُسنِ حَديثِهِ أَن يُقتَلا",25,"ل",2,0],["خالي اِبنُ كَبشَةَ قَد عَلِمتَ مَكانَهُ","وَأَبو يَزيدَ وَرَهطُهُ أَعمامي",26,"م",2,0],["خَاطِبَةً فَضْلَهُ","والفضْلُ مَا يُخْتَطَبْ",27,"ب",1,0],["خَالَ عِيَّ اللِّسَانِ ضَنّاً","أَعْيَّ اللِّسَانِ ضَنّْ",28,"ن",1,0],["خَالَسَهَا فِي ثَغْرِهَا قُبْلَةً","وَكَانَ كَالدُّرَّةِ فِي الْخَاتِمِ",29,"م",1,0],["خَادِمُ العِلْمِ عَادِمُ الحَظِّ فِيهَا","وَعَزِيزٌ أَنْ يَشْكُرَ المَخْدُومُ",30,"م",1,0],["خَانَ عَزْمِي الشَّبَابُ وَاقْتَصَّ ضَعْفِي","مِنْ ثَبَاتِي فَكَيْفَ مِثْلِي يُقَاوِمْ",31,"م",1,0],["خانَ الزَمانُ بِكُم عَلى","رَغمِ الرَشادِ وَما وَفى",32,"ف",2,0],["خاضوا به لجج الفلا فتخلصت","منها خلوصَ البدر بعد سرارِ",33,"ر",1,0],["خافوا به أن تقوم الأسد واثبةً","حتى بنَوا حاجزاً فيه من الخشب",34,"ب",1,0],["خالق الكون ذو الجلال قديم","واحد عنده القرون ثوان",35,"ن",1,0],["خارت قواها فمارت في تخزّلها","يكاد يُسقِطها هبّ من الريح",36,"ح",1,0],["خابت ببغداد آمال أؤمّلها","فهل تخيب إذا استذرت بصِنّين",37,"ن",1,0],["خاض حرب العِدى بمِقول حرّ","فاق فيها المهنّد الصمصاما",38,"م",2,0],["خاض الدجى وظلام الليل مختلط","صوت به الوجد مثل السيف مُختَرَط",39,"ط",1,1],["خافوا التذبذُب في أعمال دولتهم","من أن يجُرّ على الأوطان تخريبا",40,"ب",2,0],["خارجاً في نَفَسِ كاللهب","مُحرقاً مهجة قلبي الدَنِفِ",41,"ف",1,0],["خالط ترب الأرض جثمانه","مطحونة منه بها الأضلع",42,"ع",1,0],["خاب قوم أتوا وغى العيش عزلاً","من سلاحي تعاون واتحاد",43,"د",1,0],["خانَ القُيونُ وَقَدَّموا يَومَ الصَفا","وِرداً فَغُوَّرَ أَسوَأَ التَغويرِ",44,"ر",1,0],["خابَت بَنو تَغلِبٍ إِذ ضَلَّ فارِطُهُم","حَوضَ المَكارِمِ إِنَّ المَجدَ مُبتَدَرُ",45,"ر",1,0],["خالي الَّذي اِعتَسَرَ الهُذَيلَ وَخَيلُهُ","في ضيقِ مُعتَرَكٍ لَها وَمَجالِ",46,"ل",1,0],["خالِصُ الوِدِّ صادِقُ الوَعدِ أُنسي","في حُضوري مُحافِظٌ في غِيابي",47,"ب",2,0],["خابَت بَنو أَسَدٍ وَآبَ غَزِيُّهُم","يَومَ القَليبِ بِسَوأَةٍ وَفُضوحِ",48,"ح",1,1],["خاضوا بحورَ الشعرِ إلا أنَّها","مما تريق وجوههم من ماء",49,"ا",2,0],["خافت مهابته الرماح فأذعنتْ","حتَّى تخوّفه السماكُ الرامحُ",50,"ح",1,0],["خاف خلاَّقه فخيف إلى أن","ضمَّ من عدلهِ ظباءً وأسدا",51,"د",2,0],["خالي الحشا إن دعَا فكرِي لشكوتهِ","أجابَ دمعي وما دمعي سوى طلل",52,"ل",1,0],["خاطَبَني الحَقُّ مِن جَناني","فَكانَ عِلمي عَلى لِساني",53,"ي",1,1],["خاشعٌ تارةً وجبّارُ أخرى","فتراني أرْضاً وطَوراً سماءَ",54,"ا",2,0],["خاضبُ الشيب في بياض مُبينٍ","حين يبدو وفي سوادٍ مريبِ",55,"ب",1,0],["خالدٌ أُمٌّ وأنتَ أبٌ","أيّها الشوكيُّ لا كَذِبا",56,"ب",2,1],["خادمٌ كان مرَّةً","مُسْرِفاً ثم أَعْتَبَا",57,"ب",2,0],["خاب من فيه بعض ما","قد وصفنا وما فلَجْ",58,"ج",1,0],["خالصةُ النَّتْن ولكنها","في ريقها من سَلْحها مجَّهْ",59,"ج",2,0],["خاطبْتُمُوه بالجليَّةِ فاتَّقى","بيَدِ السَّلام وقد أظلَّ شِيَاحُه",60,"ح",2,0],["خان الزمان فأعددتُ الكرامَ له","فمن أُعِدُّ إذا ما خانت العُددُ",61,"د",1,0],["خادم لم تُبْقِ خدمتُه","منه لا رُوحاً ولا جَسدا",62,"د",2,0],["خالط اللؤمَ في فقار أبيه","فجرى اللؤم منه في كل مجرى",63,"ر",2,0],["خافت على عذرتها غيلةً","فاتخذت فقحتها ترسا",64,"س",2,0],["خائفٍ من مبارز وكمينٍ","وجِلٍ من مُجاهرٍ ودسيس",65,"س",1,0],["خارَ أصحابُه لَدُنْ صَحِبُوهُ","فغدا اللِّيسُ منهم غير لِيس",65,"س",1,0],["خالدَ اللؤم أمُغْضٍ","أنت لا بل مُتغاضي",66,"ي",1,0],["خانكَ الدهرُ أسوةَ الناس كلّا","بل وفى إنَّ ما ترى منهُ شرطُ",67,"ط",1,0],["خافقي الأحشاء طارت","تلكمُ الأحشاء خفقا",68,"ق",2,0],["خائفٌ أن ينالَ جُو","دُكَ قصوى عقائلكْ",69,"ك",1,0],["خاف فتحِي بابَ السؤال عليه","أغلق اللَّه عنه باب السؤالِ",70,"ل",1,0],["خانك الصبرُ يومَ قيلَ الرحيلُ","إنّ خطبَ الفراقِ خطبٌ جليلُ",71,"ل",1,1],["خاشعاتٍ كأنَّها باكياتٌ","بادياتِ الثغور لا لابتسام",72,"م",1,0],["خالدَ اللُّؤْمِ أنتَ هيَّجْتَ حَرْبي","ولقد كنتَ وادعاً في سلامه",73,"م",2,0],["خاضتْ إليه غمار العِزّ مِيتَتُهُ","فَرَبْعُه منه قَفْرٌ غيرُ مسكون",74,"ن",1,0],["خانتْكَ إلفَكَ عبدَ اللَّهِ خائنةٌ","هي التي فَجَعَتْ موسى بهارون",74,"ن",1,0],["خازنو المالِ ساجنوه وما كا","ن ليسعَى لساجنٍ مَسْجونه",75,"ن",2,0],["خانت به أمُّه أباهُ","فعينُه عينُها الخَؤونُ",76,"ن",1,0],["خاب المؤمِّل فيك ظلمَ مؤمّلٍ","وإن استماح بهَيِّنٍ ومُهينِ",77,"ن",1,0],["خاشعَ الطرفِ عليه ربقةٌ","يخضعُ الجيدُ من العفوِ الحسن",78,"ن",1,0],["خالدٌ أمُّها وأنتَ أبوها","فاتَّقِ اللَّهَ أيها الشوكيُّ",79,"ي",1,1],["خاظي البَضيعِ لَم يَكُن مُجَشَّبا","كانَت لَهُ سِنجارُ أُمّاً وَأَبا",80,"ب",2,0],["خافِقاتٍ أَعلامُهُ أَرَأَيتُم","كَقُلوبِ العُشّاقِ عِندَ الصُدودِ",81,"د",1,0],["خالَفتِ مِقياسَ الوَرى أَجمَعين","فَكَيفَ يَرضونَ بِمِقياسي",82,"ي",1,0],["خانُحُمُ وَأَذاعوا أَنَّهُم نَفَرٌ","خانوا البِلادَ بِما قالوا وَما عَمِلوا",83,"ل",3,0],["خانَت عُهودي بَعدَما مَلَّكتُها","قَلبي فَكَيفَ أُطيقُ أَن أَتَبَسَّما",84,"م",2,0],["خانَتِ النَفسُ قُواها","خانَتِ البَينَ قُواه",85,"ه",1,0],["خاطِر بِنَفسِكَ كَي تُصيبَ غَنيمَةً","إِنَّ القُعودَ مَعَ العِيالِ قَبيحُ",86,"ح",1,0],["خالَفَتني وَفَعَلَتها","لَكَ في الخِلافِ المُنتَهى",87,"ت",3,1],["خانَني مَن لَم أَخُنهُ","لا وَلا أَذكُرُ مَن هو",88,"ن",3,1],["خافَ الرَسولُ مِنَ المَلامَه","فَكَنى بِسُعدى عَن أُمامَه",89,"م",2,1],["خالفت فيها أهل عصري كلهم","متطرفا ولقد يطول خلافي",90,"ي",1,0],["خاطبتهن لو سمعن","القول من مخاطب",91,"ب",1,0],["خافوا لسان اخي الشع","ر الحر فاستأصلوه",92,"ه",1,1],["خانوا العراق ببغيه