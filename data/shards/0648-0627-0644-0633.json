ْ رَدى مِن تَمَوّجٍ ولَهيب",162,"ب",1,0],["والسّمْهرِيّةُ ليس يَشْرُفُ قدْرُها","حتى يُسافِرَ لَدْنُها عن غابهِ",163,"ب",2,0],["والسَّهِدُ الآوي إلى أشواقِه","إذا الظلامُ مدَّ من رواقه",164,"ه",1,0],["والسّببُ الثَّقيلُ في التَّبيينِ","حَركتانِ غَيْر ذي تَنوينِ",165,"ن",1,0],["والسَّببانِ غيرُ مَزْحوفينِ","في جُزئهِ وغيرُ سالمينِ",165,"ن",1,0],["وَالسَّلْسلُ العَذْبُ فِي بَيَانٍ","يُنْشِي وَيَشْفِي مِنْهُ الوُرُودُ",166,"د",1,0],["وَالسَّائِمَاتِ أَقَرَّهَا فِي نَعْمَةٍ","أَخذُ الرُّعَاةِ لها مِن الاسادِ",167,"د",1,0],["وَالسَّهْلُ يَبْسُط لِلنَّوَاظِرِ بَعْدَهَا","طُرَفاً روَائِعُهَا بِلاَ تَعْدَادِ",167,"د",1,0],["وَالسَّيْفَ إِنْ يُثْلَمْ لهُ صَلَّةٌ","وَصَلَّةٌ أَنْكَرُ إِنْ يُكْسَرِ",168,"ر",1,0],["والسَّمَاحُ الَّذِي تَنَزهَ عَنْ مَرْمى","مُرِيبٍ وَجلَّ عَنْ إِسْفَافِ",169,"ف",1,0],["وَالسَّيْفُ يَجْلُو حَدَّهُ","مَا يُلْزِمُ الأَعْدَاءَ حَدَّا",170,"د",2,0],["والسهل يحلم منذ كان بزورة","لبس الحلي لها ندى وأزاهرا",171,"ر",2,0],["والسنونو يحدثُ الماء همسا","كيف أنسى",172,"ا",1,0],["والسكون الأسود الغا","في كأعراض البغايا",173,"ي",2,0],["وَالسَيْفُ مَسْلُولٌ وَسَيْلُ","الْمُرْجِفِينَ يَعُبُّ عَبَّا",174,"ب",2,0],["والسياسات والدهاء الذي كا","نَ سِلاحاً حيناً وحيناً مِجَنّا",175,"ن",2,0],["والسَيْفُ أَظْلَمُ ما فَزِعْتَ لِحُكْمِه","والْحَزْمُ خَيْرُ شَمائِلِ الأَمْلاكِ",176,"ك",1,0],["وَالسُرورُ السرورُ يَلْعَبُ بِالشَعْبِ","كَمَا هَزَّتِ النَّسَائِمُ عُودا",177,"د",2,0],["والسَّيْفُ أَكْثَرُ ما يُلاقِي حَتْفَه","يومَ الكَرِيهةِ صَارِماً صَمْصَاما",178,"م",2,0],["وَالسَّيْلُ إنْ أَحْكَمْتَ سَدَّ طَريقِه","دَكَّ الْحُصُونَ فَعُدْنَ كَالأَطْلالِ",179,"ل",1,0],["وَالسَّامِعُونَ كأنَّما لَعِبَتْ بِهِمْ","صَهْبَاءُ قَدْ نُفِحَتْ بِرِيحِ شَمَال",179,"ل",1,0],["والسيف يبري الهام كالأقلام","ألم تر العصبة في المنام",180,"م",1,0],["والسيدَ الحرَّ الأبيَّ","زمامهُ بيد المسُود",181,"د",1,0],["والسد مِنْ صنع بابل إلا","وَحْيُ شعر من عندِ هاروتَ آت",182,"ت",1,0],["والسلم قد كفت أكف عداتها","والباس نامت في الغمود نصوله",183,"ل",2,0],["والسحب تبكي وثغر الزهر مبتسم","والنرجس الغض