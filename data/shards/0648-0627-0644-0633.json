لّةٍ","في ضحكِهِ والموت في تقطيبهِ",115,"ب",2,0],["وَأَلسُنُنا مَمنوعَةٌ مِن مُرادِنا","وَأَبصارُنا عَنّا تُجيبُ وَتُفهَمُ",116,"م",1,0],["وَالسَيفُ يَحلِفُ أَنَّكَ السَيفُ الَّذي","ما اِهتَزَّ إِلّا اِجتَثَّ عَرشَ عَظيمِ",117,"م",1,0],["وَالسَيفُ ما لَم يُلفَ فيهِ صَيقَلٌ","مِن طَبعِهِ لَم يَنتَفِع بِصِقالِ",118,"ل",1,0],["وَالسَيفُ مُغفٍ غَيرَ أَنَّ غِرارَهُ","يَقِظٌ إِذا هادٍ نَحاهُ لِهادِ",119,"د",1,0],["وَالسَهمُ بِالريشِ اللَؤومِ وَلَن تَرى","بَيتاً بِلا عَمَدٍ وَلا أَطنابِ",120,"ب",1,0],["والسهمُ أبعدُ مرمى","منَ الرماحِ الطوالِ",121,"ل",1,0],["والساحبِ يأباه الزِّقَّ ويُكرِهُه","والمُنْفِقِ اليومَ يُفدى بالثلاثين",122,"ن",1,0],["والساترينَ بشتمي عُرْيَ سوأتِهم","كخَصْفِ حوّاءَ دوحَ التُوتِ والتين",122,"ن",1,0],["والسّبعةُ الفقهاءُ في ترتيلهم","للذِّكرِ والملأُ الأماثلُ حُضّرُ",123,"ر",1,0],["والسّابحاتُ على الغمارِ كأنّها","للجنِّ في الحدثِ الجليل مَصادُ",124,"د",1,0],["والسرُّ في بطشِ الورى خوفُهمْ","مِنْ هذِهِ الأَشواكِ يا وردتي",125,"ي",1,0],["وَالسُيوف الرقاق ظَمآ دماءً","تَشتَكي بَثَها إِلى المرّان",126,"ن",1,0],["وَالسُمرَ مَطرورَةً مُثَقَّفَةً","وَالبيضَ تُزهي تَخالُها شُهُبا",127,"ب",2,0],["وَالسَروُ مِثلُ قِطَعِ الزَبَرجَدِ","قَدِ اِستَمَدَّ الماءَ مِن تُربٍ نَدي",128,"ي",1,0],["وَالسَوسَنُ الآزِرُ مَنشورُ الحُلَل","كَقُطُنٍ قَد مَسَّهُ بَعضُ البَلَل",128,"ل",1,0],["والسابِقُ الأَوَّلِينَ في كَرَمٍ","لَمَّا جَرَى والكِرامُ في حَلْبَهْ",129,"ب",2,0],["والسِّترُ سترُ الغيْبِ وهو مُحجَّبٌ","والسِّرُّ سرُّ الوَحي وهو مَصون",130,"ن",1,0],["والسيْفُ يبلى وهو صاعقةٌ","وتُنالُ منه الهامُ والقَصَر",131,"ر",1,0],["والسيْلُ ليسَ يحيدُ عن مُستنّهِ","والسّهمُ لا يُدْلى به غُلَواء",132,"ا",2,0],["وَالسَعيُ في طَلَبِ التُقى","مِن خَيرِ مَكسَبَةِ الكَسوبِ",133,"ب",1,0],["وَالساقُ بَرّاقَةٌ خَلاخِلُها","كَأَنَّها مِحرَكُ الأَتاتينِ",134,"ن",1,0],["والسحُ عضَّ الكيرجان كأنّه","بين الشَبا والكلبتين رصاصُ",135,"ص",1,0],["وَالساقُ بَرّاقَةٌ خَلاخِلُها","وَالصَوتُ عالٍ فَقَد عَلا البُهُرُ",136,"ر",1,0],["وَالسودُ في الهَبواتِ يَكشِفُها","خُضرُ المُتونِ صُدورُها حُمرُ",13