ttps://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"عصبة الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=179423",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[77,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[77,"قلبي وسمعي في شغل عن الفند","https://www.poetsgate.com/ViewPoem.aspx?id=33815",""],[77,"لم لا تنال العلا أو يعقد التاج","https://www.poetsgate.com/ViewPoem.aspx?id=33564",""],[100,"صدى","https://www.poetsgate.com/ViewPoem.aspx?id=50403",""],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[7,"يَا دَارَ مَيَّةَ (المعلقات)","https://www.poetsgate.com/ViewPoem.aspx?id=10023",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"تَغَيَّرَ، أوْ حَالَ عَنْ عَهْدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31618",""],[80,"وأشمَّ من بيت الرئاسة أكبرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3223",""],[91,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""],[46,"ما جُدَرِيٌّ، أماتَ صاحبَهُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20145",""],[46,"الدّهرُ يَصمُتُ، وهو أبلَغُ ناطقٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=20290",""],[51,"ليس تُغني الشَّعر الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=30542",""],[101,"جَمَعَ الشُّجُونَ وَبدَّدَ الأَحْلاَمَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62423&r=&rc=15",""],[44,"لوْ أنَّ دهراً ردَّ رجعَ جوابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15648&r=&rc=8",""],[96,"على صخور المكس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66372&r=&rc=48",""]],"verses":[["وَالسُيوفُ الحِدادُ مِن آلِ بَدرٍ","وَالقَنا الصُمُّ مِن بَني الدَيّانِ",0,"ن",1,0],["وَالسامِرِ الهَبهابِ في","الظَلماءِ وَالشِربِ العَمَم",1,"م",1,0],["وَالسَبايا عَلى النَجائِبِ تُستا","قُ وَقَد نالَتِ الجُيوبَ الذُيولُ",2,"ل",1,0],["وَالسَيفُ أَولى أَن أَعوذَ بِهِ","مِمّا تَجُرُّ الأَعيُنُ النُجُلُ",3,"ل",1,0],["وَالسَيفُ قائِمُهُ يُفارِقُهُ","وَالرُمحُ عامِلُهُ يُطَلِّقُهُ",4,"ق",2,0],["وَالسَيفُ لَيسَ يُهابُ قَبلَ قِراعِهِ","حَتّى يَمَسُّ العَينَ مِنهُ بَريقُ",5,"ق",1,0],["وَالسَيفُ إِن مَرَّ عَلى هامَةٍ","رَوَّعَها إِن هُوَ لَم يَقطَعِ",6,"ع",1,0],["وَالسَبيُ تَعصِفُ بِالجُيوبِ أَكُفُّها","في جَنبِ ما عَصَفَت قَناً وَبَواتِرُ",7,"ر",1,0],["والسّقْفُ يَبكي بأجْفانِ المَشوقِ إذا","أرْسى بهِ هَزِمُ الأطْباءِ مُنهَمِرُ",8,"ر",1,0],["والسّيفُ لا يُعْرَفُ ما غَناؤُهُ","وهْوَ لَجيُّ الغِمْدِ حتى يُنْتَضى",9,"ا",1,0],["والسّيْفُ يَنْفَعُ يومَ الرّوعِ حامِلَهُ","إذا تبدَّلَ يُمْناهُ منَ الخَلَلِ",10,"ل",1,0],["والسُّمْرُ لمْ تَكْلَفْ بلَبّاتِهِمْ","راعِفَةً منها الأنابيبُ",11,"ب",1,0],["والسَّبُّ يَلْتَفُّ بِذي ثَرْوَةٍ","يَشِحُّ والباخِلُ مَسْبوبُ",11,"ب",1,0],["والسُّمْرُ منْ حَذَرِ التّحَطُّمِ في الوَغى","تُبدي اهْتِزازَ مُنَضْنِضٍ مَطْرودِ",12,"د",1,0],["والسُّمْرُ في اللّبّات راعِفةٌ دَماً","والبِيضُ يَخضِبُها النّجيعُ الأحْمَرُ",13,"ر",1,0],["والسُّمْرُ راجِفَةٌ كأنَّ كُعوبَها","تَلوي معاقِدَها يَدٌ شَلاّءُ",14,"ا",2,0],["والسّعْدُ يُغْني حُكمُهُ عن نصْبَةٍ","تسْتَخْبِرُ التّرْبيعَ والتّسْديسا",15,"س",2,0],["وَالسَّلْمُ قَدْ كَفَّتْ أَكُفَّ عِدَاتِهَا","وَالْبَأسُ نَامَتْ فِي الْغُمُودِ فُصُولُهُ",16,"ل",2,0],["والسُّحْبُ تَبْكي وثغْرُ الزّهرِ مُبْتَسِمٌ","والنّرْجِسُ الغَضُّ ساهٍ والغَمامُ نَدي",17,"د",2,0],["والسّعْدُ يَرْكُضُ في مَيْدانِها فَرحاً","جَذْلانَ والفلَكُ الدّوّارُ هِمْلاجُ",18,"ج",1,0],["وَالساحِباتُ ذُيولَ الخَزِّ آوِنَةً","وَالرافِلاتُ عَلى أَعجازِها العِجَلُ",19,"ل",1,0],["وَالسَمهَرِيُّ قَلَمٌ","في كَفِّ لَيثٍ قَسوَرِ",20,"ر",1,0],["وَالسُحبُ مُمسكَةٌ فَلَستُ أَقيسُها","بِسيولِ سَيبٍ لِلسَّحابِ خَبوسِ",21,"س",1,0],["والسنى تبسمه","وهو ضاحكٌ جذل",22,"ل",1,0],["والسماوات لو تأملت فيها","ليس تحصى شموسها والبدور",23,"ر",1,0],["وَالسَّعْيُ أَبْلَغُ في نُجْحٍ وَمسْعَدَةٍ","لِلنَّاسِ مِنْ شَقْشَقَاتِ المدْرَةِ الذَّرِبِ",24,"ب",1,0],["والسواقي عذبت أدمعها","وحلا في مشرب النفس بكاها",25,"ه",2,0],["وَالسُفعُ في آياتِهِنَّ الخُلَّدا","بِحَيثُ لاقى البُرَقاتِ الأَصمُدا",26,"د",2,0],["والسعود لو كتائب","تحروا شاهد وغائب",27,"ب",1,0],["والسيوف تفخر والأقلام","حن تسخّر وش تريحه",28,"ه",1,0],["والسعد يجري لغايات تؤمِّلها","ما دامتِ الشُّهب تجري في مجاريها",29,"ي",3,0],["والسحبُ تنثر دُرَّ الدمع من فَرَقٍ","والجوُّ يخلعُ من برق الدّجى وُشُحا",30,"ح",2,0],["والسحب تسمح بالمياه وجودُهُ","ذهبٌ به هلُ الغنى تتموّلُ",31,"ل",1,0],["والساحبون اللاحفو","ن الأرض هُدَّاب المآزر",32,"ر",1,0],["والسَّابِقُ الصَّادِقُ المُوَفَّقُ وال","خاتِمُ للأنبياءِ إذ ذَهَبُوا",33,"ب",3,0],["والسَّالِمُونَ المُطَهَّرُونَ من ال","عَيبِ ورأسُ الرُؤوسِ ال الذَنَبُ",33,"ب",1,0],["وَأَلسُنٌ دونَهُم حِدادٌ","لُدٌّ إِذا قامَتِ الخُصومُ",34,"م",1,0],["وَالسُمرُ عِندَكَ لَم تُدَقَّ صُدورُها","وَالخَيلُ واقِفَةٌ عَلى الأَطوالِ",35,"ل",1,0],["وَالسابِغاتُ مَصونَةٌ لَم تُبتَذَل","وَالبيضُ سالِمَةٌ مَعَ الأَبطالِ",35,"ل",1,0],["وَأَلسِنَةٍ مِنَ العَذَباتِ حُمرٌ","تُخاطِبُنا بِأَفواهِ الرِماحِ",36,"ح",1,0],["والسؤدد المحض يجتليه على","عطفيهِ لحظ النابل الأنبه",37,"ب",2,0],["والسيفُ والرمحُ لا يهوى لغيرهما","لَمى من الثغر أو نوعاً من الغيد",38,"د",1,0],["والسنُّ قد قرَّعتها الأربعون وفي","ضمائر النفس تسويفٌ وتسويل",39,"ل",1,0],["والسعي ما حكت المجرَّة مسلكاً","إلا لتحسب في السرى من سبله",40,"ل",2,0],["والساتر الدنيا بذيل مكارمٍ","أحيت أواخرها فعال أوالي",41,"ي",1,0],["والسدّ تسرح أسراب الوحوش به","بالأمنِ ما بين آسادٍ وغزلانِ",42,"ن",1,0],["والسعد من خدَّامه","والنجح من أعوانه",43,"ن",2,0],["والسمع قد صمَّ عن نجوى عواذله","وسيف جفنك عندِي يسبق العذلا",44,"ل",2,0],["وَأَلسِنَةٌ بِأَسرارٍ تُناجي","تَغيبُ عَنِ الكِرامِ الكاتِبينا",45,"ن",2,0],["والسيفُ ذو متن يَلذُّ مِسَاسُه","لكنْ له حَدٌّ يُهَاب كفاحُه",46,"ح",2,0],["وألسُنُ الناس شتَّى لستُ أمْلكُها","إذا رأَوْا مُحْسناً في حال مَصْفودِ",47,"د",1,0],["والسعيُ نحوك بعد ذاك فريضةٌ","وقضاءُ حقِّكَ واجب التقديمِ",48,"م",1,0],["والسوادُ المخضوبُ أوجبُ تكذي","باً إذا كُذِّبَ السوادُ الصَّميمُ",49,"م",1,0],["وَالسَواقي لَها غِنا","ءٌ كَأَلحانِ مَعبَدِ",50,"د",1,0],["وَالسِحرُ في الأَلوان وَالأَنغام وَال","أَنداء وَالأَشذاء وَالأَذهارِ",51,"ر",1,0],["وَالسورُ ما يَنفَكُّ مُمتَنِعاً","فَإِذا يُناكِرُ بَعضَهُ اِنهَدَما",52,"م",2,0],["وَالسَيفُ إِن طالَ الثَواءُ بِهِ","يَصدَء وَيُصبِحُ حَدُّهُ خَشِنا",53,"ن",2,0],["وَالسُحُبُ إِن وَقَفَت وَما هَطَلَت","لَم تَروِ أَودِيَةً وَلا قِنَنا",53,"ن",2,0],["وَالسَواقي اِستَتَرَت إِلّا غِناها","وَالرَوابي هَجَعَت إِلّا شَذاها",54,"ا",3,0],["وَالسَواقي فِتَنٌ راقِصَةٌ","ضِحكَتُها شَدوٌ وَتَهليلٌ بُكاها",55,"ا",3,0],["والسَّعيدُ السَّعيدُ من عاشَ كاللَّيل","غريباً في أهلِ هذا الوجودِ",56,"د",1,0],["وَالسَعدُ إِن طالَعَنا نَجمَهُ","وَغبتِ فَهوَ الآفلُ الناكِصُ",57,"ص",1,0],["والسبرمان اذا تولد فهو من","هذا وذلك في الدراية اوسع",58,"ع",1,0],["والسبرمان هو الحكيم فانه","لأذى الطبيعة بالطبيعة يدفع",58,"ع",1,0],["والسبرمان مجهز بقوى لها","تعنو الرقاب فليس منها مفزع",58,"ع",1,0],["والسبرمان موفق في امره","والسبرمان لغيره لا يخضع",58,"ع",1,0],["والسمن مولاتي ترى","كأمس لم اقلِّل",59,"ل",1,0],["والسَرو في الحِبَرِ السوابِغ كاشف","عن ساقهِ كمليحةِ مِفراح",60,"ح",1,0],["وألسن العزال خُر","س والرقيب قد عمى",61,"م",2,0],["والساحب الذيل على عصره","على ملوك الزمن الأوّل",62,"ل",1,0],["والساحبات من الحرير مطارفا","ودَّ الأصيل فشيبهنّ أديما",63,"م",2,0],["وَالساهِرينَ عَلى النيلِ الحَفِيِّ بِها","وَكَأسها وَحُمَيّاها وَساقَيها",64,"ي",3,0],["وَالسَيفُ أَرحَمُ قاتِلاً","مِن عِلَّةٍ في مَقتَلِ",65,"ل",1,0],["وَالسُيوفُ نَخوَتُها","في الوَطيسِ تَتَّقِدُ",66,"د",1,0],["وَالسُنُّ تَعصِفُ كُلَّ قَلبِ مُهَذَّبٍ","عَرَفَ الجُدودَ وَأ