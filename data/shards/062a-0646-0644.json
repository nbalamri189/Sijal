{"poems":[[267,"إن كنت تبغي العيش حلوا صافيا","https://www.aldiwan.net/poem68208.html","الكامل"],[285,"ألا من مبلغ عني عليا","https://www.aldiwan.net/poem60781.html","الوافر"],[285,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[318,"إذا ما كنت ملتمسا لرزق","https://www.aldiwan.net/poem59506.html","الوافر"],[409,"أبعد اليوم تدخر الدموعا","https://www.aldiwan.net/poem33680.html","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64559","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120643","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138447",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109897","الوافر"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123549","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135705","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77140","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/205363","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139177","المتقارب"],[5183,"البدوي والوهم","https://www.poetsgate.com/ViewPoem.aspx?id=180279",""],[5189,"تجارةْ","https://www.poetsgate.com/ViewPoem.aspx?id=198418",""],[5367,"سبيل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197666",""]],"verses":[["تَنَلِ الطَّرَائِفَ مِن ظِرَافٍ نُهَّدِ","يُحدِثنَ كُلَّ عَشِيَّةٍ أعراسَا",0,"س",2,0],["تَنَلْ أَجْراً وَذِكْراً سَوْفَ يَبْقى","عَلَيْكَ مَعَ اللَّيالِي الْباقِياتِ",1,"ت",1,0],["تَنَلْ بِسَدِيدِ الْمُلْكِ ثَرْوَةَ مُعْدِمٍ","وَفَرْجَةَ مَلْهُوفٍ وَعِصْمَةَ هَارِبِ",2,"ب",1,0],["تنل ما شئت من عز وجاه","وعظم مهابة وعلو قدر",3,"ر",1,0],["تنل ما شئت من علم وجود","وآداب بها تنسى البديعا",4,"ع",2,0],["تنل سرها المخزون في بحر نورها","بتكميل مشروط وإن لم يكن فلا",5,"ل",2,0],["تَنَل طِيبَ وقتٍ لم يُكَدِّر صفاؤه","ومشهَدَ أنسٍ لم يُدَنَّس بغفلةِ",6,"ه",1,0],["تنل الفضائل والفواضل منة","في النشأتين وصحبة الأخيار",7,"ر",1,0],["تَنَل صَفحاً بلا ريبٍ إذا لم","تَكُن عِندَ الرجاءِ بمُستريبِ",8,"ب",1,0],["تَنَلْ شَاشاً بِعشْرتِنا","فشَاشٌ قَلْبُه شَاشُ",9,"ش",1,0],["تنلْ لما أردت في الدنيهْ","كذاك في آخرة سنيّهْ",10,"ي",2,0],["تَنَل عِزّاً لَدَيهِم وَاِحتِشاماً","وَمَحمَدَة وَتَصحَبُكَ الكَرامَه",11,"م",2,0],["تنل فلاحاً وتظفر عند رؤيته","بكل ما تبتغي من صالح الأمل",12,"ل",1,0],["تنل ما تحب كما تبتغي","وحسبك جاهاً به وكفى",13,"ف",2,0],["تنل ما رمت من أمل","وتحيىعيشة الرغد",14,"د",1,0],["تنل روْحًا ومغفرةً وعتقًا","فيومُ الفطرِ من حسنِ البشارةْ",15,"ر",2,0],["تَنَلْ قُرْبًا مِن المَحْبوبِ فَوزًا","مُشاهَدةً تَلِي كَشْفَ الغِطاءِ",16,"ا",2,0]]}