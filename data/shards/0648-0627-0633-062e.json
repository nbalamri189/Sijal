{"poems":[[66,"أنا أنت بلا شك","https://www.aldiwan.net/poem67605.html","الهزج"],[53,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[53,"إذا كان صبري للعاجل","https://www.aldiwan.net/poem65905.html","الخفيف"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[87,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[54,"بقلبي لنار الهوى جمرة","https://www.aldiwan.net/poem27032.html","المتقارب"],[87,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[411,"ثقوا معشر الناس بي إنني","https://www.aldiwan.net/poem50083.html","المتقارب"],[458,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/144344","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104603","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112484","المتقارب"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138053","البسيط"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141170","البسيط"],[4927,"قصيدة الثورة على الشبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=79601",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[6268,"سجينُ الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82931&r=&rc=17",""]],"verses":[["وَإِسخاطُكَ إِسخاطي","وَغُفرانُكَ غُفراني",0,"ن",2,0],["وأسخطَ السادة سُخطاً ساقَهُ","تلقاءَهُ سُخطٌ من اللّه وَجَبْ",1,"ب",1,0],["وأُسخطُ ربّي وأُرضي العبا","دَ بغيرِ ثوابٍ ولا نائلِ",2,"ل",1,0],["وَاِسخُ في الشِدَّةِ وَاِزدَد في الرَخاء","كُلُّ خُلقٍ فاضِلٍ دونَ السَخاء",3,"ا",2,0],["وَاِسخَري مِن شانِئٍ أَو شامِتٍ","لَيسَ بِالمُخطِئِ يَومُ الشامِتين",4,"ن",1,0],["وَأَسخَنَ عَيني حَبيبٌ نَأى","وَكانَت لِعَيني بِهِ قُرَّةُ",5,"ر",2,0],["واسخري من شانِىء ٍ أَو شامتٍ","ليس بالمخطيءِ يومُ الشامتين",6,"ن",1,0],["واسخُ وارجو الإله واصدعْ وسامحْ","واسمُ واسترْ وزرْ وعشْ واحمِ وابْقَى",7,"ق",2,0],["وأسخو بواجب حقِّي ولا","ألِظُّ بحقِّي وإن لم يُجِبْ",8,"ب",1,0],["وأسخر من أوضاع من قد تفردوا","بهدي الورى حتى لقد نشروا العمى",9,"م",2,0],["وأسخطتُ فيكَ نفوسَ المُلوكِ","وما راعَ قلبيَ غَضْبانُها",10,"ن",3,0],["وأسخط لاستمرار هجرك ساعة","وتغلب أشواقي فأرجع راضيا",11,"ي",2,0],["وأسخو له بالنفسِ وهي عزيزةٌ","وأيُّ فتىً بالنّفسِ يسخو ويسمحُ",12,"ح",1,0],["وأسخنُ من عبرات العفاة","حبيس البكا بعيون الأباة",13,"ه",1,0],["وَأسْخَطُوا الْمُصْطَفى الْهادِي بِمَقْتَلِهِ","فَقَلْبُهُ مِن رَسِيس الْوَجْدِ مَلآنُ",14,"ن",1,0],["واسخوا بمال قليل لا دوام له","تحووا بذلك ملكا لا انقضاء له",15,"ه",1,0],["وَأَسْخَطْتُ شَبِيْحاً وَلِصاً مُنَاْوِراً","وَوَغْداً لَئِيْماً فَاْسِدَ الرَّأْيِ قَاْسِيَاْ",16,"ي",2,0],["وأسخف الناس عقلا في مخاتلة","من ظن يوما بأن الحر ينخدعُ",17,"ع",1,0],["وأسخرُ من قهقهاتِ الورى","ويُضحكُني الحُلمُ والأُمنياتْ",18,"ت",1,0]]}