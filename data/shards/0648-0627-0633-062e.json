{"poems":[[64,"أنا أنت بلا شك","https://www.aldiwan.net/poem67605.html","الهزج"],[51,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[51,"إذا كان صبري للعاجل","https://www.aldiwan.net/poem65905.html","الخفيف"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[85,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[52,"بقلبي لنار الهوى جمرة","https://www.aldiwan.net/poem27032.html","المتقارب"],[85,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""],[126,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[402,"ثقوا معشر الناس بي إنني","https://www.aldiwan.net/poem50083.html","المتقارب"],[451,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[459,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"]],"verses":[["وَإِسخاطُكَ إِسخاطي","وَغُفرانُكَ غُفراني",0,"ن",2,0],["وأسخطَ السادة سُخطاً ساقَهُ","تلقاءَهُ سُخطٌ من اللّه وَجَبْ",1,"ب",1,0],["وأُسخطُ ربّي وأُرضي العبا","دَ بغيرِ ثوابٍ ولا نائلِ",2,"ل",1,0],["وَاِسخُ في الشِدَّةِ وَاِزدَد في الرَخاء","كُلُّ خُلقٍ فاضِلٍ دونَ السَخاء",3,"ا",2,0],["وَاِسخَري مِن شانِئٍ أَو شامِتٍ","لَيسَ بِالمُخطِئِ يَومُ الشامِتين",4,"ن",1,0],["وَأَسخَنَ عَيني حَبيبٌ نَأى","وَكانَت لِعَيني بِهِ قُرَّةُ",5,"ر",2,0],["واسخري من شانِىء ٍ أَو شامتٍ","ليس بالمخطيءِ يومُ الشامتين",6,"ن",1,0],["واسخُ وارجو الإله واصدعْ وسامحْ","واسمُ واسترْ وزرْ وعشْ واحمِ وابْقَى",7,"ق",2,0],["وأسخو بواجب حقِّي ولا","ألِظُّ بحقِّي وإن لم يُجِبْ",8,"ب",1,0],["وأسخر من أوضاع من قد تفردوا","بهدي الورى حتى لقد نشروا العمى",9,"م",2,0],["وأسخطتُ فيكَ نفوسَ المُلوكِ","وما راعَ قلبيَ غَضْبانُها",10,"ن",3,0]]}