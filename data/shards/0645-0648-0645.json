{"poems":[[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[74,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[53,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[87,"يا أقرب الناس من أمين","https://www.aldiwan.net/poem7785.html","مخلع البسيط"],[47,"كم ليلة فيك بت أسهرها","https://www.aldiwan.net/poem63639.html","المنسرح"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[107,"طاف بالقوم يحيي المؤمنين","https://www.aldiwan.net/poem43102.html","الرمل"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[48,"مومس كالإناء دنسه الشر","https://www.aldiwan.net/poem22974.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[132,"يا هل شجتك برود الريق حواء","https://www.aldiwan.net/poem50682.html","البسيط"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[214,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[470,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[563,"كيف أخشى من اللعين اللاهي","https://www.aldiwan.net/poem33635.html","الخفيف"],[563,"نور هذا الوجود بالإيمان","https://www.aldiwan.net/poem33844.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86598","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120034","المنسرح"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109139","السريع"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118092","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71051","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77197","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100902","السريع"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65140","البسيط"],[3096,"","https://poetry.dctabudhabi.ae/diwan/poem/198785",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48301","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205948","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216832","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114594","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135850","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75719","المنسرح"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125823","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123521","الطويل"],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[4802,"سلامة قلبك الأصفى","https://www.poetsgate.com/ViewPoem.aspx?id=32674",""],[4888,"زمان مكفهر","https://www.poetsgate.com/ViewPoem.aspx?id=207771",""],[5277,"رسالةٌ إلى روحي","https://www.poetsgate.com/ViewPoem.aspx?id=194241",""],[5431,"باريس ...","https://www.poetsgate.com/ViewPoem.aspx?id=208588",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5599,"حزين وافكر","https://www.poetsgate.com/ViewPoem.aspx?id=213841",""],[5664,"الظما","https://www.poetsgate.com/ViewPoem.aspx?id=176678",""],[5664,"دعوة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=46525",""],[5764,"الشارع","https://www.poetsgate.com/ViewPoem.aspx?id=174220",""],[5792,"لك يوم","https://www.poetsgate.com/ViewPoem.aspx?id=180350",""],[6277,"والعلم في عمان أزياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64489&r=&rc=52",""]],"verses":[["مؤمَّلَ أبْنائي ومَظْهرَ دعْوَتي","ولوْلا اتّقائي عتْبَهُ قُلْتُ سيّدي",0,"د",2,0],["مؤمَّرةٌ تسري إلى حومة الوغى","ومن أسودٍ في أبيضٍ علم الرّنك",1,"ك",1,0],["مؤملي والذي أشجي الخطوب به","أضحى وأمسى وأدنى ظلمه سرف",2,"ف",1,0],["مؤمل الكل في شباب","ومرتجى الأهل والبنين",3,"ن",1,0],["مُؤَمَّلٌ لِلنَدى تُؤَمِّرُهُ","عَبدُ مَنافٍ وَمَن يُؤَمِّرُها",4,"ر",3,0],["مُؤمَّرون إذا ثارَتْ قرومُهُمُ","أَفْضَتْ إلى الغايةِ القُصْوى من الثَّارِ",5,"ر",1,0],["مُؤمِنٌ ما زَلزَلَتهُ بِدعَةٌ","مِن أَباطيلِ الدُعاةِ المُشرِكينْ",6,"ن",1,0],["مُؤمِنٌ حلَّ في العراءِ مَحَلّاً","جَمَعَ المؤمنينَ فيهِ وَضَمَّا",7,"م",2,0],["مومِسٌ كَالإِناءِ دَنَّسَهُ الشَر","بُ وَوَغدٌ كَأَنَّهُ الكَلبُ والِغ",8,"غ",1,1],["مؤملاً أن يرى بالعين ما سمعا","لَقَد تجرد من أوراقه الشجرُ",9,"ر",1,0],["مُؤمِنُ الصَّدرِ يُرَجِّي عِتقَهُ","يومَ لا يُكَفرُ عَبدٌ ما أدَّخَر",10,"ر",1,0],["مُؤمل المُسْتَجير كهْف اليَتامَى","وَالأْيَامي مَنارَة الرُّوَّاد",11,"د",1,0],["مومومَةٌ ورشوف برَّاقِ مَبْسَمها","معشوقةٌ وأَنُوفُ الأنْفِ قَنْوَاءُ",12,"ا",2,0],["مُؤَمِّلُهُ يُفيدُ غِنىً وَعِزّاً","وَشانيهِ بِغُصَّتِهِ يَفيدُ",13,"د",1,0],["مؤمل الصفح مأمون الجناب به","حلا جناسي مأمون ومأمول",14,"ل",1,0],["مؤمنا بالجمال والحق والخي","ر طليق الأسباب والغايات",15,"ت",1,0],["مُؤمِّلا ًأنْ تَهيضَ الرِّيحُ جَذوَتَها","فَتَستَحيلَ لِخيْرٍ دائِم ٍ سَبَبا",16,"ب",2,0],["مؤمناً لم أزل بهم وبما قد","جاء عنهم قطعاً بغير اشتباه",17,"ه",1,0],["مؤمنات جميعها بإلهٍ","واحدٍ ما له كما قال ثاني",18,"ن",2,0],["مؤمن مُحسن لِكُل مسيء","جاءَ بِالعذر عَن نَكير جِناه",19,"ا",2,0],["مؤمن محسن صفيٍّ وَفيٍّ","راشد مرشد لَهُ الحَزم صاحب",20,"ب",1,0],["مؤمل دهره مرجى","معذل عمره مؤنب",21,"ب",1,0],["مؤمنة دون ضمير لها","فإنما الإيمان فوق الضمير",22,"ر",1,0],["مؤمل الرفد في ليل سرى وقرى","ونافذ الأمر في يومي ندى وردا",23,"د",2,0],["مُؤمنيها خُصّا ذَوي الاعتقادا","تِ التي لا تزول والأَدْيانِ",24,"ن",1,0],["مؤمله لا يلحق النحس حظه","ولكن له عين العناية ترمق",25,"ق",1,0],["مُؤمِنٌ طاهِرٌ جَميلٌ وَدودٌ","مُحسِنٌ قادِرٌ حَليمٌ صَبورُ",26,"ر",1,0],["مومضَةً تحتَ قتَام الوغَى","إِيماضَ برقٍ فى دجًى مظلم",27,"م",1,0],["مُؤمِناً أَن يَكتُبَ اللَهُ لَهُ","عاجِلاً نَصراً عَزيزاً حاسِما",28,"م",2,0],["مُؤمّنا خوف من كانت جنايتهُ","من قبل جانيها أو من غير جانيها",29,"ي",3,0],["مؤمناً براً تقياً","راكعاً لله ساجد",30,"د",1,0],["مؤمّلاً منك لنصْرِ الهُدَى","مولىً هُماماً باذِلاً مُنْعِما",31,"م",2,0],["مُؤمّل منعم يُرجى فَآمله","مَتى يصله يصله مِنهُ بِالنعم",32,"م",1,0],["مؤمنًا بالرجاء يُزجي إلينا","من رجاء ما غاب حينًا وشحَّا",33,"ح",2,0],["مومياء المعابد الشم من قب","ل متى تستعيد روح اليقين",34,"ن",1,1],["مؤملة زلفى لديك وحظوة","ومعذرة عن عيها واحتشامها",35,"م",3,0],["مؤملي منيتي صدقاً بلا كذبِ","ومقصدي ذاك دأباً والهنا الأبدي",36,"د",2,0],["مومنُ يا حفيظُ إنّي خائفُ","منك أريدُ أمناً لا يخالَفُ",37,"ف",1,0],["مؤمل كل ما حَواه","أَعطاه إِلّا العلا والا",38,"ل",2,0],["مؤمنٌ سلواه في إيمانه","لَوْ دَعاهُ الغربُ للخير أجابا",39,"ب",2,0],["مؤمّلهم وهم لموالهمو لووا","وموعدهم هدم ومعهدهم عدم",40,"م",1,0],["مؤمناً كان لا سوى ذاك يوماً","كافلاً ناصراً معيناً وفيا",41,"ي",2,0],["مؤمناً بالذي به جاء طه","رحمةً للورى اقتفاها رضيا",41,"ي",2,0],["مؤمنٌ بينهم لَوَنَّ ابنَهُ ما","كان بين الذين جاءوا علِيًّا",41,"ي",2,0],["مو من فراقك صواب الشلع من شلفا","من يد مغلًّ بحرقة ثار قتالي",42,"ل",2,0],["مؤمنٌ أنّ الذي يجمعُنا","قدرةُ اللهِ بأمرٍ قد قُدِرْ",43,"ر",1,0],["مؤمَّلٌ أنْ أقصَّ الصوتَ بالصمتِ","وأنْ أراجعَ حكمَ العمرِ بالسمتِ",44,"ت",1,1],["(مومارتُ) أجملُ ماألقى بها شغفا","كأنّها انتصبت حيث الفراديس",45,"س",1,0],["مؤمناً فارق طوعاً كفره","إذ رأى معجزة قد بهرا",46,"ر",2,0],["مُؤَمِّلُهُ فِي النَّدَى لَمْ يَخَفْ","غَداةَ اللِّقا وَجْهَ حِرْمانِهِ",47,"ن",2,0],["مؤمن بربي عالم الاسرار..","ما همني لو الزمن جاير``",48,"ر",1,0],["مو مية نار تحرقني بقت هي بس على نارك","ابشرك مابقى اي شي تحرقه كفو اصحابي",49,"ب",2,0],["مو معقوله تجي منك وترميني لاي انسان","يلملمني ولا يلقى بعيوني غير دمعاتي",50,"ت",2,1],["مؤمن بما تعمله لاشك يُحسبلك","لذا ترد الجروح بطيبٍ تمده",51,"د",2,0],["مومشكله كذبتك ياسيدي اليوم","المشكله وشلون اصدقك بكره",52,"ر",2,0],["مؤمل الخير من كف ترنحنا","صفعا ، حنانيك إنّ القوم أعداء",53,"ا",2,0]]}