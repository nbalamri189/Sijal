{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[95,"يا من لها القصر المنيف","https://www.aldiwan.net/poem11092.html","مجزوء الكامل"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[80,"الملك في طي الدفاتر","https://www.aldiwan.net/poem14190.html","مجزوء الكامل"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42589","الطويل"],[53,"شابَ رأسي ولات حينَ مَشيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26854",""],[164,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[310,"نفسي الفداء لمن حل الحشا فرأى","https://www.aldiwan.net/poem56361.html","البسيط"],[445,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[466,"وإني ومدح الفارس الشهم يزدن","https://www.aldiwan.net/poem16415.html","الطويل"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[541,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[684,"","https://poetry.dctabudhabi.ae/diwan/poem/101261","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59374","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79864","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118433","الطويل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/122936","المجتث"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75981","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93830","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94021","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89371","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138599",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91228","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139440",""],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97095","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139582",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5512,"رثاء حبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=204150",""],[402,"يا من لها القصر المنيف","https://www.poetsgate.com/ViewPoem.aspx?id=36808",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[6093,"تحج نوايا لا مطايا تقلها","https://www.poetsgate.com/ViewPoem.aspx?id=205931",""]],"verses":[["فَحَجَبْتَ عَنْ آفَاقِهِمْ مَنْ يَهْتَدِي","وَمَنَعْتَ عَنْ أَحْكَامِهِمْ مَنْ يَعْدِلُ",0,"ل",1,0],["فَحَجَجْتِ بَيْتَ اللهِ وَال","أَدْنَى إِلَيْهِ هُوَ التَّقِيّ",1,"ي",1,0],["فحِجْلٌ برجليها وشاحٌ بخصرِها","وتاجٌ إذا ما حلَّ منها الأعاليا",2,"ي",2,0],["فَحُجبتَ وَجهَ رِضايَ عَن","كَ وَكُنتَ قَد تَلقاهُ سافِرْ",3,"ر",1,0],["فَحِجابُهُم تَحتَ الثَرى مِن هَيبَةٍ","كَحِجابِهِم فَوقَ الثَرى لا يُخرَقُ",4,"ق",1,0],["فَحَجَّ وهْوَ مُقِيمٌ والحِجَازُ به","قَوْمٌ يُقِيمُونَ لا حَجُّوا ولا اعْتَمَرُوا",5,"ر",3,0],["فَحُجَّتُهُ مَطْلُولَةٌ وَهْيَ حَقَّةٌ","وَمَنْطِقُهُ مُسْتَكْرَهٌ وَهْوَ قَاصِدُ",6,"د",1,0],["فحِجاهُ لكل يومٍ عصيبٍ","ونداهُ لكل عام شَصيب",7,"ب",1,0],["فحجتها أقوى ولو كشف الغطا","رثى لي مما في الحشا كل مسلم",8,"م",1,0],["فَحجّني فأحلتُ الأمرَ فيه على","جَفني فَهل لَه من عذر فيبديهِ",9,"ي",2,0],["فَحَجَّبَ منهُ الملكَ أَكرمُ حاجِبٍ","وقادَ جنودَ النصرِ أَكرمُ قائِدِ",10,"د",1,0],["فحُجَّتُهُ يومَ الجِدالِ كَسيْفِهِ","إذا اهْتَزَّ في رأسِ الكَمِيِّ المُصَمِّمِ",11,"م",1,0],["فَحُجَّةُ النُّفَاةِ","رواية الثقات",12,"ت",1,0],["فَحَجَّ إِلَيهِ الناسُ مِن كُلِّ جانِبٍ","بِأَحسَنِ دينِ اللَهِ خُلقاً وَمَنظَرا",13,"ر",2,0],["فحججت الجميع بالحجج الغر","فدانت لك الخصوم صغارا",14,"ر",2,0],["فَحَجَّرَهَا الدُّجَى بشهاب رَجْمٍ","وَسَمَّرَهَا بِمِسْمَارِ النُّجُومِ",15,"م",1,0],["فحجيجُ البيتِ لمّا أنزل الله","فيهم ذلك الرجزَ الأليما",16,"م",2,0],["فحجبت الفؤاد كي أتّقيها","أَو هَلْ يدرأ المنون نقاها",17,"ا",3,0],["فحج وخلص عسكر الجود والرضا","بكظم لصدق البقر زن احسن العلا",18,"ل",2,0],["فحجت الكأس ثغري","على مطيّة كفي",19,"ف",2,0],["فَحجَّت وَزارَت خَيرَ مِن وطِئ الثَرى","نَبيٌّ كَريمٌ في ذوي الحَرم شافِعُ",20,"ع",1,0],["فحج بنا يا صاح كعبة مجده","ولد بمقام جل عن لمس لامس",21,"س",1,0],["فحج بيتي لهم دواماً","وحجة البيت كل حول",22,"ل",1,0],["فحجك مقبولٌ بصفوك للصفا","وفعلك ممدوح وأجرك غفران",23,"ن",1,0],["فحجت من الشامات عرصة كربلا","ولم تلق إلا في رباها عصا السرى",24,"ر",2,0],["فحجك مبرورٌ وَقصدك ناجحٌ","وَسَعيك مَشكورٌ وَعَودُك شائقُ",25,"ق",1,0],["فحجب الظلام بانسدال","على السرى والخيل والعجال",26,"ل",1,0],["فحجبت دونكَ مرتين وقد","تشتد واحدةٌ على مثلي",27,"ي",1,0],["فحجتي أنني عبد الحسين وذي","لا شك عند كرام الخلق لم تهن",28,"ن",1,0],["فحجَّ وأزكى الحج محض تقرُّبٍ","وليس له إلا التشوق من مزج",29,"ج",1,0],["فحجت وسبط المصطفى الطهر كعبة","لهم ومحاريب الهدى حجراتها",30,"ت",3,0],["فحجارةُ المثوى لهيبٌ حارقٌ","وكأنَّهُ بلظى الرَّدى منقوشُ",31,"ش",1,0],["فحججت بيت الله","والدنى إليه هو التقي",32,"ي",1,0],["فحجت إلى الاسم الذي هو جامع","تراوده عما اقتضته المحبتي",33,"ت",2,0],["فَحَجَبْتُ وَصْفِي وَ اسْتَزَدتُّ صَبَابَتِي","وَ رَضِيتُ أَسْرِي دُونَمَا تَمْوِيهِ",34,"ي",2,0],["فحجَّتْ جسومُ الغَيرِ تنسكُ مَنْسَكَاً","وأرواح أهل الفقر كانت تَدُلُهَا",35,"ل",3,0]]}