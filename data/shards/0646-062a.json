{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[53,"أشكو إليك مدامعا تكف","https://www.aldiwan.net/poem29967.html","الكامل"],[53,"لعمري لقد ماطلت لو دفع الردى","https://www.aldiwan.net/poem30443.html","الطويل"],[53,"من معيد لي أيا","https://www.aldiwan.net/poem30672.html","مجزوء الرمل"],[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[83,"لولا تألق بارق التذكار","https://www.aldiwan.net/poem54296.html","الكامل"],[88,"أم كلثوم في فنون الأغاني","https://www.aldiwan.net/poem44430.html","الخفيف"],[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"ألا بيني وبينكم النفار","https://www.aldiwan.net/poem64002.html","الوافر"],[51,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[92,"كنا كزوجي طائر","https://www.aldiwan.net/poem38903.html","مجزوء الكامل"],[78,"أيها الصاحب الذي فارقت عي","https://www.aldiwan.net/poem14043.html","الخفيف"],[89,"ذكرى صباباتي فهزني الذكر","https://www.aldiwan.net/poem44845.html","الطويل"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[89,"خدعوها بقولهم حسناء","https://www.aldiwan.net/poem44939.html","الخفيف"],[85,"اليوم نسود بوادينا","https://www.aldiwan.net/poem7914.html","المتدارك"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[45,"خير يوميك في الهوى واقتباله","https://www.aldiwan.net/poem65606.html","الخفيف"],[61,"أربعاء حسامه مشهور","https://www.aldiwan.net/poem51674.html","الخفيف"],[61,"قم بنا قبل غرة الإصباح","https://www.aldiwan.net/poem51736.html","الخفيف"],[49,"إنقطاع الأيام عني سريع","https://www.aldiwan.net/poem62164.html","الخفيف"],[66,"نعم لقلوب العاشقين عيون","https://www.aldiwan.net/poem38477.html","الطويل"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[44,"أنبئت عبد الله أصبح يعول","https://www.aldiwan.net/poem30008.html","الكامل"],[44,"دنف بكى آيات ربع مدنف","https://www.aldiwan.net/poem30401.html","الكامل"],[31,"ما شجاك الغداة من رسم دار","https://www.aldiwan.net/poem42533.html","الخفيف"],[105,"خلق العروبة أن تجد وتدأبا","https://www.aldiwan.net/poem42057.html","الكامل"],[105,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[104,"شهداء","https://www.aldiwan.net/poem26158.html","عموديه"],[48,"لا يصرفنك عن قصف وإصباء","https://www.aldiwan.net/poem10400.html","البسيط"],[48,"لم أبك في مجلس منصور","https://www.aldiwan.net/poem63353.html","السريع"],[48,"مضى أيلول وارتفع الحرور","https://www.aldiwan.net/poem63370.html","الوافر"],[48,"أعاذل لا أموت بكف ساق","https://www.aldiwan.net/poem64422.html","الوافر"],[48,"لله أعيننا وهن من الخدى","https://www.aldiwan.net/poem66240.html","الكامل"],[50,"أفرخ الزنج طال بك البلاء","https://www.aldiwan.net/poem64886.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43769","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[90,"شدة لندن!..","https://www.poetsgate.com/ViewPoem.aspx?id=179068",""],[45,"خَيرُ يَوْمَيكَ في الهوَى وَاقتِبَالِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32129",""],[91,"عصر الشبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=53194",""],[91,"وداع وشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=53145",""],[101,"صَفَا وِرْدُهُ عذْباً وَطابَتْ مَنَاهِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62446&r=&rc=38",""],[48,"لا يَصرفَنَّك ،عن قَصْفٍ وإصْباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24834&r=&rc=4",""]],"verses":[["نَتَجوا في المَجدِ ما أَلقَحتَهُ","رُبَّما أَوقَدَ ناراً غَيرُ صالي",0,"ي",1,0],["نَتَجَ الصَباحُ عِشارَهُ سَبَلاً","جَوداً وَأَلقَحَ شَولَهُ السَدَفُ",1,"ف",1,0],["نُتَبِّعُهُ أَبصارَنا وَهوَ ذاهِبٌ","كَما مالَ قَرنُ الشَمسِ أَو وَجبَ البَدرُ",2,"ر",1,0],["نَتَشاكى ما عَنانا","بِكَلامِ العَبَراتِ",3,"ت",1,0],["نَتيجَةُ قَلْبٍ مُمْحِضٍ لكَ وُدَّهُ","تَبيدُ اللّيالي وهْيَ باقِيَةٌ تَحْيا",4,"ي",2,0],["نَتواعَدُ الرّجْعَى ونغْتَنِمُ اللِّقَى","ونُديرُ منْ شكْوى الغَرامِ كُؤوسا",5,"س",2,0],["نَتَعاطى الشَمولَ مُذهَبَةَ السِر","بالِ وَالجَوُّ في مَطارِفَ غُبرِ",6,"ر",1,0],["نَتَفَانَى وَمَا بِنَا مَا نُعَانِي","مِنْ شَقَاءٍ دُونَ النَّجَاحِ المَرُومِ",7,"م",1,0],["نَتوجٍ وَلَم تُقرَف لِما يُمتَنى لَهُ","إَذا نُتِجَت ماتَت وَحَيَّ سَليلُها",8,"ل",3,0],["نَتَجَشْم الأهوال في طلب العلا","ونروع سربَ النوم بالأفكارِ",9,"ر",1,0],["نتفانى في الاستماع إليها","ونرى لذّة لنا في التفاني",10,"ن",2,0],["نتمنَّى بلا احْتياجِ لمغنا","كَ سرانا فكيفَ عندَ احْتياج",11,"ج",1,0],["نتلاقى فلحْظَةٌ منك وعْدٌ","بوصال ولحظةٌ تهديدُ",12,"د",1,0],["نتيجةُ وعدٍ صادقٍ منك شاهدي","عليه كتابٌ يحفز السطرَ بالسطر",13,"ر",1,0],["نتائجُهُ عوارم باقياتٌ","خوالد لا يمَحُّ لها حَبار",14,"ر",1,0],["نتجتْه خواطرٌ من طباع","غيرَ مستكرَهٍ ولا منحوز",15,"ز",1,0],["نتعاطى بها الكؤوسَ رَواءً","واصِلي طِيبِها بِطيبِ نِدام",16,"م",1,0],["نَتَّقي في يَومِنا شَرَّ غَدٍ","وَإِذا الصُبحُ اِنطَوى خِفنا المَساء",17,"ا",2,0],["نَتَوَهَّمُ الدُنيا لِفَرطِغُرورِنا","كَمُلَت بِنا وَلِغَيرِنا لا تَكمُلُ",18,"ل",1,0],["نَتَراءى عَلى الصَعيدِ صَعاليكَ","وَلَكِن أَرواحُنا في العَنانِ",19,"ن",1,0],["نَتَناجى وَيَدي في يَدِها","فَإِذا لاحَ خَيالٌ نَتَلاهى",20,"ا",3,0],["نَتْلو أَناشيدَ المنى","بَيْنَ الخمائلِ والغُصُونْ",21,"ن",1,0],["نَتَعاطى الَّتي تُنَسِّيكَ في اللَذ","ذَة وَالرقَة الهَوى وَالهَواءَ",22,"ا",2,0],["نتمّ على رغم المقادير امرنا","اذا هي ضنت ان يتمّ لنا الامر",23,"ر",1,0],["نتباهى بنفسنا","لا باجدادنا الرمم",24,"م",1,0],["نتلاقى وعند ما نتلاقى","نتهادى من الهوى ما نشاء",25,"ا",2,0],["نَتَّخِذُ الشَمسَ لَهُ تاجا","وَضُحاها عَرشاً وَهّاجا",26,"ا",1,0],["نِتاجُ رَأيِكَ في وَقتٍ عَلى عَجَلٍ","كَلَفظِ حَرفٍ وَعاهُ سامِعٌ فَهِمُ",27,"م",1,0],["نَتَلَقّى المُدامَ مِن يَدِ حُرٍّ","يَختَطيها لَنا إِلى جَزيلِ نَوالِه",28,"ل",2,0],["نتوقّاه أولَ الشَّهرِ إن دا","رَ ونخشاه أخراً لا يدورُ",29,"ر",1,0],["نتوارى من الحوادثِ والده","رُ خبيرٌ بمَنْ توارَى بَصيرُ",29,"ر",1,0],["نتمشَّى إلى النَّعيمِ الذي في","ه صَلاحُ الأجسادِ والأرواحِ",30,"ح",1,0],["نَتَعامى وَنَحنُ نَسعى لِغَيٍّ","كَيفَ نَبقى وَالمَوتُ فينا ذَريعُ",31,"ع",1,0],["نُتابِعُهُ طَوراً وَلا عُروَةُ الهَوى","بِوُثقى وَلا حَبلُ الزَمانِ مَتينُ",32,"ن",1,0],["نتمنَّى كلما امتدَّت بنا","أن يَظَلَّ الليلُ مجهولَ الصباح",33,"ح",1,0],["نتمنى كلما طابت لنا","أن يظل الليل مجهول الصباح",34,"ح",1,0],["نَتَفَ العَوارِضَ غَضَّةً ما عُذرُهُ","في نَتفِ شَعرِ الخَدِّ حينَ يُسَنبِلُ",35,"ل",1,0],["نُتِجَت وَقَد حَوَتِ الهُنَيدَةَ وَاِبتَنَت","في شَطرِها وَتَبَوَّعَت في النَيِّفِ",36,"ف",1,0],["نَتَّقي العَينَ تَحتَ عَينٍ سَجومٍ","وَبلُها في دُجى الدُجُنَّةِ ساري",37,"ر",2,0],["نَتَجرّعُ البلوَى ونَدَّرِعُ الأسَى","نَرْعَى لإِخوتنا الذِّمامَ الأقربا",38,"ب",2,0],["نَتداعَى إلى الكريهةِ ضاحي","نَ نَحُلُّ الرُّبَى ونعلو الجبالا",39,"ل",2,0],["نتلقّاه باليمينِ ونلقَى","في سناه جبريلَ أو ميكالا",39,"ل",2,0],["نتحرتم ؟! نحن لذين نتحرن","بحية ٍ أموته أحيءُ",40,"ا",1,0],["نِتاجُ نَحلِ خَلايا غَيرِ مُقفِرَةٍ","خُصَّت بِأَطيَبِ مُصطافٍ وَمَشتاءِ",41,"ا",2,0],["نَتيجُ أَنوارٍ سَماوِيَّةٍ","قَرينُ تَقديسٍ وَتَطهيرِ",42,"ر",1,0],["نِتاجٌ لا تَدُرُّ عَلَيهِ أُمٌّ","بِحَملٍ لا تُعَدُّ لَهُ الشُهورُ",43,"ر",1,0],["نَتيجَةُ مُزنَةٍ مِن عودِ كَرمٍ","تُضيءُ اللَيلَ مَضروبَ الرُواقِ",44,"ق",1,0],["نُتجوا يرونَ الريحَ من استاههمُ","وبها من الجعرِ اليبيسِ عقاصُ",45,"ص",1,0],["نَتَيجٌ بَينَ خِنزيرٍ وَكَلبٍ","يَرى أَنَّ الكِمارَ لَهُ شِفاءُ",46,"ا",2,0],["نَتَمَنى للعَيش في هذه الدن","يا ثباتاً وَهَل لعيش ثبات",47,"ت",1,0],["نتساقاها على الفجر نديّهْ","وأغني أنت يا أندلسيَّهْ",48,"ه",1,0],["نتخاطف القبلَ الصباح كصبيةٍ","يتخاطفون هدية الأعياد",49,"د",1,0],["نَتَجَتهُ الشَمسُ ثُمَّ نَأَت","فَاِعتَدى الدَهرُ الَّذي اِعتَدَلا",50,"ل",2,0],["نَتَوَقّى مِن بَعوضٍ","نَتَغَنّى الهَجرَ بَعضا",51,"ض",2,0],["نتداوى مِن لاعجِ الشوقِ بالش","وقِ ونطوي أسى لننشر شجنا",52,"ن",2,0],["نَتَمنَّى الْحَياةَ جِدَّ تَمَنٍ","وَهْيَ لَيْسَتْ إِلاَّ مَتَاعاً قَلِيلاَ",53,"ل",2,0],["نتنسم الأخبارَ منه","كأنه ساعي البريد",54,"د",1,0],["نتغنى وعصْرنا من نُحاس","بأغاني عصورنا الذهبيه",55,"ي",2,0],["نَتَلَقّى المُدامَ مِنْ يَدِ حُرٍّ","يَخْتَطيهَا لَنَا إلى حُرّ مَالِهْ",56,"ل",2,0],["نتوهّم الدنيا لفرط غرورنا","كملت بنا وبغيرنا لا تكمل",57,"ل",1,0],["نتجاذب النظرات وهي ضعيفة","ونغالب الأنفاس كيلا تزهقا",58,"ق",2,0],["نتِيهُ بِهَا ضَافي الشبابِ ونَضْرُهُ","وَتَسْمُو حَوَاليهِ بِهَا وعَوَاطِلُهْ",59,"ل",2,0],["نِتاجُ نَحْلِ خلايا غيرِ مقْرِفَة ِ .","خُصّتْ بأطْيَب مُصْطافٍ ومَشتاءِ",60,"ا",2,0]]}