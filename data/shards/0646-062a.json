,"الوافر"],[466,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[466,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[467,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[470,"وهيف عليها معلمات القراطق","https://www.aldiwan.net/poem59812.html","الطويل"],[481,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[484,"أيا ربة الخال التي فتنت به","https://www.aldiwan.net/poem24373.html","عموديه"],[506,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[516,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[517,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[540,"بدون اجتهاد لا يكون التعلم","https://www.aldiwan.net/poem47465.html","عموديه"],[540,"ضمنا مجلس يناديك أقبل","https://www.aldiwan.net/poem47599.html","عموديه"],[540,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[553,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[553,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[560,"نحن بالأمر الإلهي","https://www.aldiwan.net/poem33646.html","مجزوء الرمل"],[560,"طلع امبدر في دياجي امظلام","https://www.aldiwan.net/poem33869.html","الخفيف"],[560,"نحن أهل العلوم بالإلهام","https://www.aldiwan.net/poem33878.html","الخفيف"],[560,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"],[560,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[564,"أتعلم ما هاجت بقلبي من الشغل","https://www.aldiwan.net/poem52926.html","الطويل"],[564,"شوقي إليك كما علمت طويل","https://www.aldiwan.net/poem52957.html","الكامل"],[569,"روح من الماء في جسم من الصفر","https://www.aldiwan.net/poem69680.html","البسيط"],[569,"ومستدير كجرم البدر مسطوح","https://www.aldiwan.net/poem69754.html","البسيط"],[611,"","https://poetry.dctabudhabi.ae/diwan/poem/18850","الطويل"]],"verses":[["نَتَجوا في المَجدِ ما أَلقَحتَهُ","رُبَّما أَوقَدَ ناراً غَيرُ صالي",0,"ل",2,0],["نَتَجَ الصَباحُ عِشارَهُ سَبَلاً","جَوداً وَأَلقَحَ شَولَهُ السَدَفُ",1,"ف",1,0],["نُتَبِّعُهُ أَبصارَنا وَهوَ ذاهِبٌ","كَما مالَ قَرنُ الشَمسِ أَو وَجبَ البَدرُ",2,"ر",1,0],["نَتَشاكى ما عَنانا","بِكَلامِ العَبَراتِ",3,"ت",1,0],["نَتيجَةُ قَلْبٍ مُمْحِضٍ لكَ وُدَّهُ","تَبيدُ اللّيالي وهْيَ باقِيَةٌ تَحْيا",4,"ي",2,0],["نَتواعَدُ الرّجْعَى ونغْتَنِمُ اللِّقَى","ونُديرُ منْ شكْوى الغَرامِ كُؤوسا",5,"س",2,0],["نَتَعاطى الشَمولَ مُذهَبَةَ السِر","بالِ وَالجَوُّ في مَطارِفَ غُبرِ",6,"ر",1,0],["نَتَفَانَى وَمَا بِنَا مَا نُعَانِي","مِنْ شَقَاءٍ دُونَ النَّجَاحِ المَرُومِ",7,"م",1,0],["نَتوجٍ وَلَم تُقرَف لِما يُمتَنى لَهُ","إَذا نُتِجَت ماتَت وَحَيَّ سَليلُها",8,"ل",3,0],["نَتَجَشْم الأهوال في طلب العلا","ونروع سربَ النوم بالأفكارِ",9,"ر",1,0],["نتفانى في الاستماع إليها","ونرى لذّة لنا في التفاني",10,"ن",2,0],["نتمنَّى بلا احْتياجِ لمغنا","كَ سرانا فكيفَ عندَ احْتياج",11,"ج",1,0],["نتلاقى فلحْظَةٌ منك وعْدٌ","بوصال ولحظةٌ تهديدُ",12,"د",1,0],["نتيجةُ وعدٍ صادقٍ منك شاهدي","عليه كتابٌ يحفز السطرَ بالسطر",13,"ر",1,0],["نتائجُهُ عوارم باقياتٌ","خوالد لا يمَحُّ لها حَبار",14,"ر",1,0],["نتجتْه خواطرٌ من طباع","غيرَ مستكرَهٍ ولا منحوز",15,"ز",1,0],["نتعاطى بها الكؤوسَ رَواءً","واصِلي طِيبِها بِطيبِ نِدام",16,"م",1,0],["نَتَّقي في يَومِنا شَرَّ غَدٍ","وَإِذا الصُبحُ اِنطَوى خِفنا المَساء",17,"ا",2,0],["نَتَوَهَّمُ الدُنيا لِفَرطِغُرورِنا","كَمُلَت بِنا وَلِغَيرِنا لا تَكمُلُ",18,"ل",1,0],["نَتَراءى عَلى الصَعيدِ صَعاليكَ","وَلَكِن أَرواحُنا في العَنانِ",19,"ن",1,0],["نَتَناجى وَيَدي في يَدِها","فَإِذا لاحَ خَيالٌ نَتَلاهى",20,"ا",3,0],["نَتْلو أَناشيدَ المنى","بَيْنَ الخمائلِ والغُصُونْ",21,"ن",1,0],["نَتَعاطى الَّتي تُنَسِّيكَ في اللَذ","ذَة وَالرقَة الهَوى وَالهَواءَ",22,"ا",2,0],["نتمّ على رغم المقادير امرنا","اذا هي ضنت ان يتمّ لنا الامر",23,"ر",1,0],["نتباهى بنفسنا","لا باجدادنا الرمم",24,"م",1,0],["نتلاقى وعند ما نتلاقى","نتهادى من الهوى ما نشاء",25,"ا",2,0],["نَتَّخِذُ الشَمسَ لَهُ تاجا","وَضُحاها عَرشاً وَهّاجا",26,"ا",1,0],["نِتاجُ رَأيِكَ في وَقتٍ عَلى عَجَلٍ","كَلَفظِ حَرفٍ وَعاهُ سامِعٌ فَهِمُ",27,"م",1,0],["نَتَلَقّى المُدامَ مِن يَدِ حُرٍّ","يَختَطيها لَنا إِلى جَزيلِ نَوالِه",28,"ل",2,0],["نتوقّاه أولَ الشَّهرِ إن دا","رَ ونخشاه أخراً لا يدورُ",29,"ر",1,0],["نتوارى من الحوادثِ والده","رُ خبيرٌ بمَنْ توارَى بَصيرُ",29,"ر",1,0],["نتمشَّى إلى النَّعيمِ الذي في","ه صَلاحُ الأجسادِ والأرواحِ",30,"ح",1,0],["نَتَعامى وَنَحنُ نَسعى لِغَيٍّ","كَيفَ نَبقى وَالمَوتُ فينا ذَريعُ",31,"ع",1,0],["نُتابِعُهُ طَوراً وَلا عُروَةُ الهَوى","بِوُثقى وَلا حَبلُ الزَمانِ مَتينُ",32,"ن",1,0],["نتمنَّى كلما امتدَّت بنا","أن يَظَلَّ الليلُ مجهولَ الصباح",33,"ح",1,0],["نتمنى كلما طابت لنا","أن يظل الليل مجهول الصباح",34,"ح",1,0],["نَتَفَ العَوارِضَ غَضَّةً ما عُذرُهُ","في نَتفِ شَعرِ الخَدِّ حينَ يُسَنبِلُ",35,"ل",1,0],["نُتِجَت وَقَد حَوَتِ الهُنَيدَةَ وَاِبتَنَت","في شَطرِها وَتَبَوَّعَت في النَيِّفِ",36,"ف",1,0],["نَتَّقي العَينَ تَحتَ عَينٍ سَجومٍ","وَبلُها في دُجى الدُجُنَّةِ ساري",37,"ر",2,0],["نَتَجرّعُ البلوَى ونَدَّرِعُ الأسَى","نَرْعَى لإِخوتنا الذِّمامَ الأقربا",38,"ب",2,0],["نَتداعَى إلى الكريهةِ ضاحي","نَ نَحُلُّ الرُّبَى ونعلو الجبالا",39,"ل",2,0],["نتلقّاه باليمينِ ونلقَى","في سناه جبريلَ أو ميكالا",39,"ل",2,0],["نتحرتم ؟! نحن لذين نتحرن","بحية ٍ أموته أحيءُ",40,"ا",1,0],["نِتاجُ نَحلِ خَلايا غَيرِ مُقفِرَةٍ","خُصَّت بِأَطيَبِ مُصطافٍ وَمَشتاءِ",41,"ا",2,0],["نَتيجُ أَنوارٍ سَماوِيَّةٍ","قَرينُ تَقديسٍ وَتَطهيرِ",42,"ر",1,0],["نِتاجٌ لا تَدُرُّ عَلَيهِ أُمٌّ","بِحَملٍ لا تُعَدُّ لَهُ الشُهورُ",43,"ر",1,0],["نَتيجَةُ مُزنَةٍ مِن عودِ كَرمٍ","تُضيءُ اللَيلَ مَضروبَ الرُواقِ",44,"ق",1,0],["نُتجوا يرونَ الريحَ من استاههمُ","وبها من الجعرِ اليبيسِ عقاصُ",45,"ص",1,0],["نَتَيجٌ بَينَ خِنزيرٍ وَكَلبٍ","يَرى أَنَّ الكِمارَ لَهُ شِفاءُ",46,"ا",2,0],["نَتَمَنى للعَيش في هذه الدن","يا ثباتاً وَهَل لعيش ثبات",47,"ت",1,0],["نَتَنَادَى ثُمَّ يَنْمِي صَوْتَنَا","صَلَقٌ يَهْدِمُ حَافَاتِ الأُطُمْ",48,"م",1,0],["نتساقاها على الفجر نديّهْ","وأغني أنت يا أندلسيَّهْ",49,"ه",1,0],["نتخاطف القبلَ الصباح كصبيةٍ","يتخاطفون هدية الأعياد",50,"د",1,0],["نَتَجَتهُ الشَمسُ ثُمَّ نَأَت","فَاِعتَدى الدَهرُ الَّذي اِعتَدَلا",51,"ل",2,0],["نَتَوَقّى مِن بَعوضٍ","نَتَغَنّى الهَجرَ بَعضا",52,"ض",2,0],["نتداوى مِن لاعجِ الشوقِ بالش","وقِ ونطوي أسى لننشر شجنا",53,"ن",2,0],["نَتَمنَّى الْحَياةَ جِدَّ تَمَنٍ","وَهْيَ لَيْسَتْ إِلاَّ مَتَاعاً قَلِيلاَ",54,"ل",2,0],["نتنسم الأخبارَ منه","كأنه ساعي البريد",55,"د",1,0],["نتشهى غدا ، يزيد ابتعادا","نرجع الأمس .. لا يطيق ارتجاعا",56,"ع",2,0],["نتغنى وعصْرنا من نُحاس","بأغاني عصورنا الذهبيه",57,"ي",2,0],["نَتَلَقّى المُدامَ مِنْ يَدِ حُرٍّ","يَخْتَطيهَا لَنَا إلى حُرّ مَالِهْ",58,"ل",2,0],["نتوهّم الدنيا لفرط غرورنا","كملت بنا وبغيرنا لا تكمل",59,"ل",1,0],["نتجاذب النظرات وهي ضعيفة","ونغالب الأنفاس كيلا تزهقا",60,"ق",2,0],["نتهادى على عيون الأقاحي","ونعفو على شفاه الورود",61,"د",1,0],["نتِيهُ بِهَا ضَافي الشبابِ ونَضْرُهُ","وَتَسْمُو حَوَاليهِ بِهَا وعَوَاطِلُهْ",62,"ل",2,0],["نِتاجُ نَحْلِ خلايا غيرِ مقْرِفَة ِ .","خُصّتْ بأطْيَب مُصْطافٍ ومَشتاءِ",63,"ا",2,0],["نتثنى على لظى البعد لهفا","مثلما انت رقة تتثنى",64,"ن",2,0],["نتيجة العمر ومعنى الحيا","ت اليوم في ذاتي وطرفي القرير",65,"ر",1,0],["نتلو الحنيفيّة السمحا إلى جهة","قد أطلعَ الدهرُ فيها كلّ أنحاس",66,"س",1,0],["نتناثَرُ الأزهارُ من حافاتِها","إن غَرَّدَت بقريضها الشُّعراءُ",67,"ا",2,0],["نَتَأمل مَسرَحَ الدُنيا","بِطَرفٍ لا يَحُور",68,"ر",1,0],["نتوارى بالسابرىِّ وننسَى","من وراء الضلوعِ ضربا وطعنا",69,"ن",2,0],["نتيجةُ العدلِ هذا الأمنُ نحن بهِ","والظلمُ ما زال للإِفساد مجتلبا",70,"ب",2,0],["نِتاجُ عُمَيرٍ وَالضُّبَيبِ وَكامِلٍ","وَذاتِ نُسوعٍ وَالنَعامَةِ وَالخَطرِ",71,"ر",1,0],["نِتاجُ اِبنِ حَلّابٍ وَقَيدٍ وَلاحِقٍ","وَغُلِّ المَذاكي كامِلٍ وَعُقالِ",72,"ل",1,0],["نَتائِجُ فِكرٍ غادَرَت كُلَّ فِكرَةٍ","نَتُوجٍ لِما يَحلُو مِنَ الشِعرِ حائِلا",73,"ل",2,0],["نَتَوَخَّى عَنك اِصطِباراً فَيغدو الصْ","صَبرُ ماءً مِن المَاجرِ هامي",74,"م",2,0],["نَتَجَتها خَواطِرٌ قَد أُبيحَت","كُلّ عَذبٍ مِنَ الكَلامِ خَطيرِ",75,"ر",1,0],["نتساقى من الهوى ما نشاء","يوم قالت العيش ليس يطيب",76,"ب",1,0],["نتساقى الحديث عذباً شهيّا","وقطفوُ المنى رطابٌ دواني",77,"ن",2,0],["نتساقى الحديث عذبا شهيّا","وقطوف المنى رطاب دواني",78,"ن",2,0],["نتمنى المنون من ألم الصد","وما حال من تمنى المنونا",79,"ن",2,0],["نتفداك ساقياً قد كساك الحسن","من فرقك المضيء لساقك",80,"ك",1,1],["نتيجةُ سعي الرومِ تلكَ فهل لكم","بها عبرةٌ أو أسوةٌ بعد يقظة",81,"ه",1,0],["نَتَائِجُ نَضْرَةٍ لِمُقَدّماتٍ","مُمَوَّهَةٍ بِمَنْظَرِهِ البَهِيِّ",82,"ي",1,0],["نَتائِجُ مَولىً قَدّم البرّ والتقى","وَأجْرى إلى ما سَوْفَ يُجزى بِه الأجْرا",83,"ر",2,0],["نَتائجي اِتَّصلت والاتّصال بهم","عزٌّ وعزّي بهم فَخرٌ على الأُمَمِ",84,"م",1,0],["نَتَمارى إِن لُحنَ هَل هُنَّ غيدٌ","أَم ظِباءٌ في حُسنها لا يُمارى",85,"ر",2,0],["نتمنى على الزمان الأماني","معجزات تخال في الممكنات",86,"ت",1,0],["نَتَشاكى وَجداً وَنَسفح دَمعاً","وَنُناجي رُبعاً وَعَصراً تَوَلى",87,"ل",2,0],["نترك لكل عاده","تناقض الزهاده",88,"د",2,0],["نتوب توبة توبة الصادقين","نصوح ما تنفض وتنسف",89,"ف",1,0],["نَتَحرّى كلَّ آنٍ جودَها","وهو بالفضل وبالمعروف أحرى",90,"ر",2,0],["نتيجة آباءٍ كرامٍ أئمَّةٍ","هُداةٍ بأمر الله تهدي إلى الرُّشد",91,"د",1,0],["نتَّقي ما نتَّقي من بأسه","وإذ أقْدَمَ خطبٌ أحجما",92,"م",2,0],["نتهادى به إليك جميعاً","وبه كانت المطايا تهادى",93,"د",2,0],["نتحول عاصفة مخمورة","تتخدد فوق ملامحنا",94,"ن",2,0],["نتائج طب بالقوافي موكل","لديه الكلام الحر والمنطق الذرب",95,"ب",1,0],["نتيه في الدنيا بما زخرفت","كتيهة المقتول بالصارم",96,"م",1,0],["نتج الحسن في صحائف خديه","ربيعاً توردت زهراته",97,"ت",2,1],["نتجتَ من المنى بطناً عقيماً","نَمَى بك والمنى أمٌّ ولودُ",98,"د",1,0],["نتائج أفكار إليك نوازع","وليست إلى غير العلى بنوازع",99,"ع",1,0],["نترجى منها الشفاء وما تحملُ","إلاَّ وجداً بكمْ وغراما",100,"م",2,0],["نَتَراءى فَقيرَة ً يَد ُنا","وَلكلِّ امريءٍ يَد ٌ وَيَد ُ",101,"د",1,0],["نَتَراءى نحنُ النّيامَ غَداً","بَينَما القَومُ كلُّهُم سَهِدوا!",101,"د",3,0],["نَتاجٌ كَريمُ الأَصلِ أَسرَعُ خَطوَةً","عَلى الطِرسِ مِن دَمعٍ عَلى خَدٍّ عاشِقِ",102,"ق",1,0],["نتهادى من الهوى ما نشاء","ذلك العهد بين سلمى وبيني",103,"ي",1,0],["نتيه