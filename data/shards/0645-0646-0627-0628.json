{"poems":[[53,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[63,"خليلي إن الأرض ضاقت برحبها","https://www.aldiwan.net/poem45853.html","الطويل"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[72,"هب أنها الظبي لكن غير ملتفت","https://www.aldiwan.net/poem18401.html","البسيط"],[72,"يا سيدا ما زال لي من منه","https://www.aldiwan.net/poem18692.html","الكامل"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[28,"وآلفة برد الحجال احتويتها","https://www.aldiwan.net/poem5224.html","الطويل"],[28,"ألما على أطلال سعدى نسلم","https://www.aldiwan.net/poem5505.html","الطويل"],[49,"لن تقوم الدنيا بمر الأهله","https://www.aldiwan.net/poem63098.html","الخفيف"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[44,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[105,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[52,"يا مسكة العطار","https://www.aldiwan.net/poem26955.html","المجتث"],[52,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[106,"تقدير أديب","https://www.poetsgate.com/ViewPoem.aspx?id=179698",""],[77,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[115,"الرّباط","https://www.aldiwan.net/poem24040.html","البسيط"],[124,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[183,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[205,"منا بمكة يوم فتح محمد","https://www.aldiwan.net/poem27909.html","الكامل"],[209,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[235,"وكأنما البطحاء بردة سندس","https://www.aldiwan.net/poem19271.html","الكامل"],[280,"لو عاينت عيناك بهجة جلقا","https://www.aldiwan.net/poem32692.html","الكامل"],[280,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[293,"أذلك أم ضرس من النخل مترع","https://www.aldiwan.net/poem1133.html",""],[296,"ألا كل مجد عرضة للتهدم","https://www.aldiwan.net/poem36812.html","عموديه"],[326,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[362,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[364,"هل الحب إلا أن وقفت بدار","https://www.aldiwan.net/poem17201.html","الطويل"],[400,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[402,"وعندي شي شد قوة أسره","https://www.aldiwan.net/poem49635.html","الطويل"],[402,"اشهد بأن الله ذو قدرة","https://www.aldiwan.net/poem49942.html","السريع"],[413,"من أبي الهدى لاح فينا مظهر","https://www.aldiwan.net/poem54096.html","الخفيف"],[413,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[413,"أيها القبر لا برحت مصوبا","https://www.aldiwan.net/poem54105.html","الخفيف"],[426,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[429,"سندوها من القدود رماحا","https://www.aldiwan.net/poem12579.html","الخفيف"],[451,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[498,"محاضر القوم لا تترك بها الأدبا","https://www.aldiwan.net/poem38080.html","البسيط"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"]],"verses":[["مَن أَبوهُ أَبي وَمَولاهُ مَولا","يَ إِذا ضامَني البَعيدُ القَصِيُّ",0,"ي",1,0],["مِن أُباةِ اللَعنِ الَّذينَ يُحَيّو","نَ بِها في مَعاقِدِ التِيجانِ",1,"ن",1,0],["مَنابِتُ العُشبِ لا حامٍ وَلا راعِ","مَضى الرَدى بِطَويلِ الرُمحِ وَالباعِ",2,"ع",1,1],["مَنابِتٌ سارَ فيها قادِحٌ عَمِلٌ","يَرمي العُروقَ وَعيدانٌ بِها خَوَرُ",3,"ر",1,0],["مِنَ ابنِ كَريِمٍ لَمْ تُصِبْهُ خَصاصَةٌ","وَمِنْ أُمَوِيٍّ لِلْأَراذِلِ مادِحِ",4,"ح",1,0],["مَنَابِرُ عِزٍّ أَذّنَ الْفَتْحُ فَوْقَهَا","وَأَفْصَحَ لِلْعَضْبِ الطَّرِيِرِ خَطيِبُ",5,"ب",1,0],["مَنابِتُهُ مِثلُ السُدوسِ وَلَونُهُ","كَشَوكِ السِيالِ فَهوَ عَذبٌ يَفيصُ",6,"ص",1,0],["مَنابِرَ مُلكٍ كُلُّها مُضَرِيَّةٌ","يُصَلِّ عَلَينا مَن أَعَرناهُ مِنبَرا",7,"ر",2,0],["من ابن فضل الإله المعتلي رتباً","لم يعتلِ مثلها نجمٌ على الكرةِ",8,"ه",1,0],["منًّا بعثتُ إليك إلاَّ أنَّهُ","من منَّ بالتقبيل يتبعه أذى",9,"ذ",2,0],["منابذ لأعاديه وثروتِه","فليس يألوهما ما اسطاع إتلافا",10,"ف",2,0],["مُنابذٌ لأعاديه وثروتِه","كلا الفريقين يُرمَى في مَقاتلِهِ",11,"ل",2,0],["من أبوه لأخي الوحي أخٌ","وابنُ عم ووصيٌّ وخَتَنْ",12,"ن",1,0],["مَن أَبى حُبَّكُم فَلَيسَ مِنَ اللَ","هِ وَلَو صامَ أَلفَ عامٍ وَصَلّى",13,"ل",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","في أَخضَرٍ بَهِجٍ وَأَحمَرَ قانِ",14,"ن",1,0],["مِنِ اِبنِ الثَمانينِ الَّذي لَيسَ وارِداً","وَلا جائِياً مِن غَيبَةٍ مُتَنَظَّرا",15,"ر",2,0],["مِنِ اِبنَي نِزارٍ وَاليَمانَينَ بَعدَهُم","أَيادي سَبا وَالعَقلُ لِلمُتَفَهِّمِ",16,"م",1,0],["مِن أَبٍ واحِدٍ خُلِقنا وَأُمٍّ","غَيرَ أَنّا في المالِ أَولادُ عَلَّه",17,"ل",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","أَو أَزرَقٍ صافٍ وَأَحمَرَ قاني",18,"ن",2,0],["مَن أَبَنَّ البُيوتَ أَصبَحَ في ثَو","بٍ مِنَ العَيشِ لَيسَ بِالفَضفاضِ",19,"ض",1,0],["مِن أَبيَضٍ لِبَياضِ وَجهِكَ ضامِنٌ","حينَ الوُجوهُ مَشوبَةٌ بِسَوادِ",20,"د",1,0],["منابتُ فِتنةٍ خَبُثَتْ وساءَتْ","فلم تَطِبِ الفُروعُ ولا الأُصولُ",21,"ل",1,0],["مِن أَبيهِ وَجَدِّهِ","فَهوَ حُسنٌ ذو حُسنَيَين",22,"ن",1,0],["مِن آبَنوسٍ تُسَمّى","بِاليُمنِ بَينَ الجَواري",23,"ي",1,0],["مِن أَبيَضٍ وَأَحمَرٍ وَأَصفَرِ","وَطارِفٍ أَجفانَهُ لَم يَنظُرِ",24,"ر",1,0],["من أبحر المكرمات حيث طمت","وسائرُ الناس من جداولها",25,"ل",3,0],["مِنَ أَبي هِشامٍ يا رِجالُ قَصيدَةٌ","تَبكي لَها الفِتيانُ وَالفَتَياتُ",26,"ت",1,1],["مَنَابِتٌ زَرْعُها بَهِيجٌ","وَغَيْضَةٌ ماؤُها رَوَاءُ",27,"ا",2,0],["مَنَابرُهُ تَهْتَزُّ بِاْسمِكَ فَوقَهَا","وَتَلْتَفُّ مِنْ شَوْقٍ عَلَيْكَ مَحَافِلُهْ",28,"ل",2,0],["مَن «ابنُ حمدانَ»؟ ما أطرافُ دولته؟","هل كان أكثرَ من والٍ على«حلبا»؟",29,"ب",2,0],["منابرُ عز أذزن الفتحُ فوقَها","وأفصح للعضب الطرير خطيبُ",30,"ب",1,0],["مِنْ (إبّ)، مِنْ (حَضْرَمَوْت) الشّهد مِن (سَبإ)","مِنْ جَنَّتَيْها اللَّتَيْنِ اللهُ حامِيها",31,"ي",3,0],["من أبيض ناصع في أخضر بهج","مع أحمر من شقيق الأرض ريّانا",32,"ن",2,0],["منَابِت أزهارٍ يكرر نشرُها","على القْطرِ شكراً ذائعا ومَحامدا",33,"د",2,0],["مِنّا بِمَكَّةَ يَومَ فَتحِ مَحَمَّدٍ","أَلفٌ تَسيلُ بِهِ البِطاحُ مُسَوَّمُ",34,"م",1,1],["من أبوه وهو للحسن أبُ","ليس للأقمار أمٌّ أو أبُ",35,"ب",1,0],["مِنْ أَبْيَضٍ قَدْ حَاكَهُ قَطْرُ النَّدَى","فِي أَحْمَرٍ فِي أَخْضَرٍ فَيْنَانِ",36,"ن",1,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","لَوناً يَسُرُّ الناظِرينَ وَأَزرَقا",37,"ق",2,0],["مَنابِرُ المَدحِ بِهِ عامِرَةٌ","وَصِيتُهُ في الناسِ مَنشورُ العَذَب",38,"ب",1,0],["من ابنائِهِ والعِرقُ يَنصُرُ فَرعَهُ","على أصلِهِ والعِرقُ للعِرقِ نازعُ",39,"ع",1,0],["منابتُ عزٍ فارعات فروعُه","وَمرقى إِباءٍ لا يُنال بسلّم",40,"م",1,0],["من أب معرق النجار وأمّ","هي منه في عزّة الأحساب",41,"ب",1,0],["من أبيهِ الحَبْرِ فيه شَبَهٌ","في بيانٍ وسَماح ودَهاء",42,"ا",2,0],["مَنابِرَ لِلإِسلامَ قامَت سُيوفُكُم","يَقومُ لَها في الدَهرِ أَيُّ مَنارِ",43,"ر",1,0],["منابر كانت للمواعظ والهدى","فما بالها عادت لسُخْرَةِ ساخر",44,"ر",1,0],["منابِتُها في عُصْعُصي غَيرَ أنَّها","لِشَيْبي في هَمٍّ مُعَنٍّ وفي نَصَبْ",45,"ب",1,0],["مَنْ أبدعَ الجَوهَرَ عن قُدْرَةٍ","فإنَّه أعلى مِنَ الجَوْهَرِ",46,"ر",1,0],["من أبي الهدى لاح فينا مظهرْ","فَتَجلّى لنا بنورٍ أزهرْ",47,"ر",1,1],["من أبٍ يفتخر المجد به","إنْ رمى أصْمى وأنْ ساعدَ أسعد",48,"د",1,0],["من أبٍ كانَ بي رؤوفاً رحيماً","جُزِيَ الخيرَ والمثوبة عني",49,"ي",1,0],["من ابن كرامة تهدي دعاء","مديحا في الأصائل والبكورِ",50,"ر",1,0],["من أبي القاسم اقتسَمْتَ صِفاتٍ","زِدْتَ أوضاحَها لنا إيضاحا",51,"ح",2,0],["من أبدع القصص العجيبة مثلما","خلقت بإبداع الإله القادر",52,"ر",1,0],["مَنابِرُ الغَيْبِ تَبنيها عَزائمهُمْ","وكم وكَمْ شامخٍ في عَزمهِمْ خَرُبا",53,"ب",2,0],["منْ أباحَ الحُصونَ بعد اِمتناعٍ","ومَحا بالحُسامِ زبرَ الغَساقِ",54,"ق",1,0]]}