{"poems":[[55,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[55,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[65,"خليلي إن الأرض ضاقت برحبها","https://www.aldiwan.net/poem45853.html","الطويل"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[29,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[74,"هب أنها الظبي لكن غير ملتفت","https://www.aldiwan.net/poem18401.html","البسيط"],[74,"يا سيدا ما زال لي من منه","https://www.aldiwan.net/poem18692.html","الكامل"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[53,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[47,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[30,"وآلفة برد الحجال احتويتها","https://www.aldiwan.net/poem5224.html","الطويل"],[30,"ألما على أطلال سعدى نسلم","https://www.aldiwan.net/poem5505.html","الطويل"],[51,"لن تقوم الدنيا بمر الأهله","https://www.aldiwan.net/poem63098.html","الخفيف"],[68,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[46,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[46,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[83,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[54,"يا مسكة العطار","https://www.aldiwan.net/poem26955.html","المجتث"],[54,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[77,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[52,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[108,"تقدير أديب","https://www.poetsgate.com/ViewPoem.aspx?id=179698",""],[79,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[121,"الرّباط","https://www.aldiwan.net/poem24040.html","البسيط"],[130,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[211,"منا بمكة يوم فتح محمد","https://www.aldiwan.net/poem27909.html","الكامل"],[215,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[241,"وكأنما البطحاء بردة سندس","https://www.aldiwan.net/poem19271.html","الكامل"],[286,"لو عاينت عيناك بهجة جلقا","https://www.aldiwan.net/poem32692.html","الكامل"],[286,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[299,"أذلك أم ضرس من النخل مترع","https://www.aldiwan.net/poem1133.html",""],[302,"ألا كل مجد عرضة للتهدم","https://www.aldiwan.net/poem36812.html","عموديه"],[332,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[368,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[370,"هل الحب إلا أن وقفت بدار","https://www.aldiwan.net/poem17201.html","الطويل"],[407,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[409,"وعندي شي شد قوة أسره","https://www.aldiwan.net/poem49635.html","الطويل"],[409,"اشهد بأن الله ذو قدرة","https://www.aldiwan.net/poem49942.html","السريع"],[420,"من أبي الهدى لاح فينا مظهر","https://www.aldiwan.net/poem54096.html","الخفيف"],[420,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[420,"أيها القبر لا برحت مصوبا","https://www.aldiwan.net/poem54105.html","الخفيف"],[433,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[436,"سندوها من القدود رماحا","https://www.aldiwan.net/poem12579.html","الخفيف"],[456,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[503,"محاضر القوم لا تترك بها الأدبا","https://www.aldiwan.net/poem38080.html","البسيط"],[517,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[650,"","https://poetry.dctabudhabi.ae/diwan/poem/89620","البسيط"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216874","البسيط"],[891,"","https://poetry.dctabudhabi.ae/diwan/poem/89610","الرمل"],[915,"","https://poetry.dctabudhabi.ae/diwan/poem/20053","الكامل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75824","الرمل"],[1145,"","https://poetry.dctabudhabi.ae/diwan/poem/31514","الكامل"]],"verses":[["مَن أَبوهُ أَبي وَمَولاهُ مَولا","يَ إِذا ضامَني البَعيدُ القَصِيُّ",0,"ي",1,0],["مِن أُباةِ اللَعنِ الَّذينَ يُحَيّو","نَ بِها في مَعاقِدِ التِيجانِ",1,"ن",1,0],["مَنابِتُ العُشبِ لا حامٍ وَلا راعِ","مَضى الرَدى بِطَويلِ الرُمحِ وَالباعِ",2,"ع",1,1],["مَنابِتٌ سارَ فيها قادِحٌ عَمِلٌ","يَرمي العُروقَ وَعيدانٌ بِها خَوَرُ",3,"ر",1,0],["مِنَ ابنِ كَريِمٍ لَمْ تُصِبْهُ خَصاصَةٌ","وَمِنْ أُمَوِيٍّ لِلْأَراذِلِ مادِحِ",4,"ح",1,0],["مَنَابِرُ عِزٍّ أَذّنَ الْفَتْحُ فَوْقَهَا","وَأَفْصَحَ لِلْعَضْبِ الطَّرِيِرِ خَطيِبُ",5,"ب",1,0],["مَنابِتُهُ مِثلُ السُدوسِ وَلَونُهُ","كَشَوكِ السِيالِ فَهوَ عَذبٌ يَفيصُ",6,"ص",1,0],["مَنابِرَ مُلكٍ كُلُّها مُضَرِيَّةٌ","يُصَلِّ عَلَينا مَن أَعَرناهُ مِنبَرا",7,"ر",2,0],["من ابن فضل الإله المعتلي رتباً","لم يعتلِ مثلها نجمٌ على الكرةِ",8,"ه",1,0],["منًّا بعثتُ إليك إلاَّ أنَّهُ","من منَّ بالتقبيل يتبعه أذى",9,"ذ",2,0],["منابذ لأعاديه وثروتِه","فليس يألوهما ما اسطاع إتلافا",10,"ف",2,0],["مُنابذٌ لأعاديه وثروتِه","كلا الفريقين يُرمَى في مَقاتلِهِ",11,"ل",2,0],["من أبوه لأخي الوحي أخٌ","وابنُ عم ووصيٌّ وخَتَنْ",12,"ن",1,0],["مَن أَبى حُبَّكُم فَلَيسَ مِنَ اللَ","هِ وَلَو صامَ أَلفَ عامٍ وَصَلّى",13,"ل",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","في أَخضَرٍ بَهِجٍ وَأَحمَرَ قانِ",14,"ن",1,0],["مِنِ اِبنِ الثَمانينِ الَّذي لَيسَ وارِداً","وَلا جائِياً مِن غَيبَةٍ مُتَنَظَّرا",15,"ر",2,0],["مِنِ اِبنَي نِزارٍ وَاليَمانَينَ بَعدَهُم","أَيادي سَبا وَالعَقلُ لِلمُتَفَهِّمِ",16,"م",1,0],["مِن أَبٍ واحِدٍ خُلِقنا وَأُمٍّ","غَيرَ أَنّا في المالِ أَولادُ عَلَّه",17,"ل",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","أَو أَزرَقٍ صافٍ وَأَحمَرَ قاني",18,"ن",2,0],["مَن أَبَنَّ البُيوتَ أَصبَحَ في ثَو","بٍ مِنَ العَيشِ لَيسَ بِالفَضفاضِ",19,"ض",1,0],["مِن أَبيَضٍ لِبَياضِ وَجهِكَ ضامِنٌ","حينَ الوُجوهُ مَشوبَةٌ بِسَوادِ",20,"د",1,0],["منابتُ فِتنةٍ خَبُثَتْ وساءَتْ","فلم تَطِبِ الفُروعُ ولا الأُصولُ",21,"ل",1,0],["مِن أَبيهِ وَجَدِّهِ","فَهوَ حُسنٌ ذو حُسنَيَين",22,"ن",1,0],["مِن آبَنوسٍ تُسَمّى","بِاليُمنِ بَينَ الجَواري",23,"ر",2,0],["مِن أَبيَضٍ وَأَحمَرٍ وَأَصفَرِ","وَطارِفٍ أَجفانَهُ لَم يَنظُرِ",24,"ر",1,0],["من أبحر المكرمات حيث طمت","وسائرُ الناس من جداولها",25,"ل",3,0],["مِنَ أَبي هِشامٍ يا رِجالُ قَصيدَةٌ","تَبكي لَها الفِتيانُ وَالفَتَياتُ",26,"ت",1,1],["مِنَّا بِبَادِيَةِ الأَعْرَابِ كِرْكِرْةٌ","إِلَى كَرَاكِرَ بِالأَمْصَارِ والْحَضَرِ",27,"ر",1,0],["مَنَابِتٌ زَرْعُها بَهِيجٌ","وَغَيْضَةٌ ماؤُها رَوَاءُ",28,"ا",2,0],["مَنَابرُهُ تَهْتَزُّ بِاْسمِكَ فَوقَهَا","وَتَلْتَفُّ مِنْ شَوْقٍ عَلَيْكَ مَحَافِلُهْ",29,"ل",2,0],["مَن «ابنُ حمدانَ»؟ ما أطرافُ دولته؟","هل كان أكثرَ من والٍ على«حلبا»؟",30,"ب",2,0],["منابرُ عز أذزن الفتحُ فوقَها","وأفصح للعضب الطرير خطيبُ",31,"ب",1,0],["مِنْ (إبّ)، مِنْ (حَضْرَمَوْت) الشّهد مِن (سَبإ)","مِنْ جَنَّتَيْها اللَّتَيْنِ اللهُ حامِيها",32,"ي",3,0],["من أبيض ناصع في أخضر بهج","مع أحمر من شقيق الأرض ريّانا",33,"ن",2,0],["منَابِت أزهارٍ يكرر نشرُها","على القْطرِ شكراً ذائعا ومَحامدا",34,"د",2,0],["مِنّا بِمَكَّةَ يَومَ فَتحِ مَحَمَّدٍ","أَلفٌ تَسيلُ بِهِ البِطاحُ مُسَوَّمُ",35,"م",1,1],["من أبوه وهو للحسن أبُ","ليس للأقمار أمٌّ أو أبُ",36,"ب",1,0],["مِنْ أَبْيَضٍ قَدْ حَاكَهُ قَطْرُ النَّدَى","فِي أَحْمَرٍ فِي أَخْضَرٍ فَيْنَانِ",37,"ن",1,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","لَوناً يَسُرُّ الناظِرينَ وَأَزرَقا",38,"ق",2,0],["مَنابِرُ المَدحِ بِهِ عامِرَةٌ","وَصِيتُهُ في الناسِ مَنشورُ العَذَب",39,"ب",1,0],["من ابنائِهِ والعِرقُ يَنصُرُ فَرعَهُ","على أصلِهِ والعِرقُ للعِرقِ نازعُ",40,"ع",1,0],["منابتُ عزٍ فارعات فروعُه","وَمرقى إِباءٍ لا يُنال بسلّم",41,"م",1,0],["من أب معرق النجار وأمّ","هي منه في عزّة الأحساب",42,"ب",1,0],["من أبيهِ الحَبْرِ فيه شَبَهٌ","في بيانٍ وسَماح ودَهاء",43,"ا",2,0],["مَنابِرَ لِلإِسلامَ قامَت سُيوفُكُم","يَقومُ لَها في الدَهرِ أَيُّ مَنارِ",44,"ر",1,0],["منابر كانت للمواعظ والهدى","فما بالها عادت لسُخْرَةِ ساخر",45,"ر",1,0],["منابِتُها في عُصْعُصي غَيرَ أنَّها","لِشَيْبي في هَمٍّ مُعَنٍّ وفي نَصَبْ",46,"ب",1,0],["مَنْ أبدعَ الجَوهَرَ عن قُدْرَةٍ","فإنَّه أعلى مِنَ الجَوْهَرِ",47,"ر",1,0],["من أبي الهدى لاح فينا مظهرْ","فَتَجلّى لنا بنورٍ أزهرْ",48,"ر",1,1],["من أبٍ يفتخر المجد به","إنْ رمى أصْمى وأنْ ساعدَ أسعد",49,"د",1,0],["من أبٍ كانَ بي رؤوفاً رحيماً","جُزِيَ الخيرَ والمثوبة عني",50,"ن",2,0],["من ابن كرامة تهدي دعاء","مديحا في الأصائل والبكورِ",51,"ر",1,0],["من أبي القاسم اقتسَمْتَ صِفاتٍ","زِدْتَ أوضاحَها لنا إيضاحا",52,"ح",2,0],["من أبدع القصص العجيبة مثلما","خلقت بإبداع الإله القادر",53,"ر",1,0],["مَنابِرُ الغَيْبِ تَبنيها عَزائمهُمْ","وكم وكَمْ شامخٍ في عَزمهِمْ خَرُبا",54,"ب",2,0],["منْ أباحَ الحُصونَ بعد اِمتناعٍ","ومَحا بالحُسامِ زبرَ الغَساقِ",55,"ق",1,0],["منا بأَرضِ عمانٍ سادةٌ رُجحٌ","عند اللقاءِ وحيٌّ دارهم هَجَرُ",56,"ر",1,0],["من ابن مامةَ كعب يوم عيَّ به","زوّ المنيةِ إلاّ حرّةً وقدى",57,"د",2,0],["من أَباريقَ تراها","لُثَّماً بيضاً خِفافا",58,"ف",2,0],["مِنّا بِشَجنَةٍ وَالذِنابِ فَوارِسٌ","وَعتائِدٍ مِثلُ السَوادِ المُظلَمِ",59,"م",1,0],["مِنْ أبارِيقَ تَراها","لُثَّماً ثُمَّ عِكافا",60,"ف",2,0],["مِن أَبي العِيالِ أَبي هُذَيلٍ فَاِعرِفوا","قَولي وَلا تَتَجَمجَموا ما أُرسِلُ",61,"ل",1,1]]}