دع التواكل","https://www.poetsgate.com/ViewPoem.aspx?id=189058",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[4929,"دين الله الاسلام","https://www.poetsgate.com/ViewPoem.aspx?id=208716",""],[4984,"عيد الشجرة","https://www.poetsgate.com/ViewPoem.aspx?id=180037",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5277,"وما مثلُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=191713",""],[5277,"دموعٌ في مكاحلِ الزمن..","https://www.poetsgate.com/ViewPoem.aspx?id=210585",""],[5314,"خلجات","https://www.poetsgate.com/ViewPoem.aspx?id=214746",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5431,"(سأزرع الأرضَ آلافا من القُبَلِ)!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200121",""],[5431,"ثورة فكرية ....","https://www.poetsgate.com/ViewPoem.aspx?id=207487",""],[5458,"عيد اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=72386",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5550,"لا تكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=215331",""],[5736,"من أغمد النصل بأضلعك","https://www.poetsgate.com/ViewPoem.aspx?id=208284",""],[5736,"أماه","https://www.poetsgate.com/ViewPoem.aspx?id=208890",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5851,"جسر الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175295",""],[5956,"اتّق شرّ من أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=192409",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[6093,"ثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=198733",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""]],"verses":[["مَن أَبوهُ أَبي وَمَولاهُ مَولا","يَ إِذا ضامَني البَعيدُ القَصِيُّ",0,"ي",1,0],["مِن أُباةِ اللَعنِ الَّذينَ يُحَيّو","نَ بِها في مَعاقِدِ التِيجانِ",1,"ن",1,0],["مَنابِتُ العُشبِ لا حامٍ وَلا راعِ","مَضى الرَدى بِطَويلِ الرُمحِ وَالباعِ",2,"ع",1,1],["مَنابِتٌ سارَ فيها قادِحٌ عَمِلٌ","يَرمي العُروقَ وَعيدانٌ بِها خَوَرُ",3,"ر",1,0],["مِنَ ابنِ كَريِمٍ لَمْ تُصِبْهُ خَصاصَةٌ","وَمِنْ أُمَوِيٍّ لِلْأَراذِلِ مادِحِ",4,"ح",1,0],["مَنَابِرُ عِزٍّ أَذّنَ الْفَتْحُ فَوْقَهَا","وَأَفْصَحَ لِلْعَضْبِ الطَّرِيِرِ خَطيِبُ",5,"ب",1,0],["مَنابِتُهُ مِثلُ السُدوسِ وَلَونُهُ","كَشَوكِ السِيالِ فَهوَ عَذبٌ يَفيصُ",6,"ص",1,0],["مَنابِرَ مُلكٍ كُلُّها مُضَرِيَّةٌ","يُصَلِّ عَلَينا مَن أَعَرناهُ مِنبَرا",7,"ر",2,0],["من ابن فضل الإله المعتلي رتباً","لم يعتلِ مثلها نجمٌ على الكرةِ",8,"ه",1,0],["منًّا بعثتُ إليك إلاَّ أنَّهُ","من منَّ بالتقبيل يتبعه أذى",9,"ذ",2,0],["منابذ لأعاديه وثروتِه","فليس يألوهما ما اسطاع إتلافا",10,"ف",2,0],["مُنابذٌ لأعاديه وثروتِه","كلا الفريقين يُرمَى في مَقاتلِهِ",11,"ل",2,0],["من أبوه لأخي الوحي أخٌ","وابنُ عم ووصيٌّ وخَتَنْ",12,"ن",1,0],["مَن أَبى حُبَّكُم فَلَيسَ مِنَ اللَ","هِ وَلَو صامَ أَلفَ عامٍ وَصَلّى",13,"ل",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","في أَخضَرٍ بَهِجٍ وَأَحمَرَ قانِ",14,"ن",1,0],["مِنِ اِبنِ الثَمانينِ الَّذي لَيسَ وارِداً","وَلا جائِياً مِن غَيبَةٍ مُتَنَظَّرا",15,"ر",2,0],["مِنِ اِبنَي نِزارٍ وَاليَمانَينَ بَعدَهُم","أَيادي سَبا وَالعَقلُ لِلمُتَفَهِّمِ",16,"م",1,0],["مِن أَبٍ واحِدٍ خُلِقنا وَأُمٍّ","غَيرَ أَنّا في المالِ أَولادُ عَلَّه",17,"ل",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","أَو أَزرَقٍ صافٍ وَأَحمَرَ قاني",18,"ن",2,0],["مَن أَبَنَّ البُيوتَ أَصبَحَ في ثَو","بٍ مِنَ العَيشِ لَيسَ بِالفَضفاضِ",19,"ض",1,0],["مِن أَبيَضٍ لِبَياضِ وَجهِكَ ضامِنٌ","حينَ الوُجوهُ مَشوبَةٌ بِسَوادِ",20,"د",1,0],["منابتُ فِتنةٍ خَبُثَتْ وساءَتْ","فلم تَطِبِ الفُروعُ ولا الأُصولُ",21,"ل",1,0],["مِن أَبيهِ وَجَدِّهِ","فَهوَ حُسنٌ ذو حُسنَيَين",22,"ن",1,0],["مِن آبَنوسٍ تُسَمّى","بِاليُمنِ بَينَ الجَواري",23,"ر",2,0],["مِن أَبيَضٍ وَأَحمَرٍ وَأَصفَرِ","وَطارِفٍ أَجفانَهُ لَم يَنظُرِ",24,"ر",1,0],["من أبحر المكرمات حيث طمت","وسائرُ الناس من جداولها",25,"ل",3,0],["مِنَ أَبي هِشامٍ يا رِجالُ قَصيدَةٌ","تَبكي لَها الفِتيانُ وَالفَتَياتُ",26,"ت",1,1],["مِنَّا بِبَادِيَةِ الأَعْرَابِ كِرْكِرْةٌ","إِلَى كَرَاكِرَ بِالأَمْصَارِ والْحَضَرِ",27,"ر",1,0],["مَنَابِتٌ زَرْعُها بَهِيجٌ","وَغَيْضَةٌ ماؤُها رَوَاءُ",28,"ا",2,0],["مَنَابرُهُ تَهْتَزُّ بِاْسمِكَ فَوقَهَا","وَتَلْتَفُّ مِنْ شَوْقٍ عَلَيْكَ مَحَافِلُهْ",29,"ل",2,0],["مَن «ابنُ حمدانَ»؟ ما أطرافُ دولته؟","هل كان أكثرَ من والٍ على«حلبا»؟",30,"ب",2,0],["منابرُ عز أذزن الفتحُ فوقَها","وأفصح للعضب الطرير خطيبُ",31,"ب",1,0],["مِنْ (إبّ)، مِنْ (حَضْرَمَوْت) الشّهد مِن (سَبإ)","مِنْ جَنَّتَيْها اللَّتَيْنِ اللهُ حامِيها",32,"ي",3,0],["من أبيض ناصع في أخضر بهج","مع أحمر من شقيق الأرض ريّانا",33,"ن",2,0],["منَابِت أزهارٍ يكرر نشرُها","على القْطرِ شكراً ذائعا ومَحامدا",34,"د",2,0],["مِنّا بِمَكَّةَ يَومَ فَتحِ مَحَمَّدٍ","أَلفٌ تَسيلُ بِهِ البِطاحُ مُسَوَّمُ",35,"م",1,1],["من أبوه وهو للحسن أبُ","ليس للأقمار أمٌّ أو أبُ",36,"ب",1,0],["مِنْ أَبْيَضٍ قَدْ حَاكَهُ قَطْرُ النَّدَى","فِي أَحْمَرٍ فِي أَخْضَرٍ فَيْنَانِ",37,"ن",1,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","لَوناً يَسُرُّ الناظِرينَ وَأَزرَقا",38,"ق",2,0],["مَنابِرُ المَدحِ بِهِ عامِرَةٌ","وَصِيتُهُ في الناسِ مَنشورُ العَذَب",39,"ب",1,0],["من ابنائِهِ والعِرقُ يَنصُرُ فَرعَهُ","على أصلِهِ والعِرقُ للعِرقِ نازعُ",40,"ع",1,0],["منابتُ عزٍ فارعات فروعُه","وَمرقى إِباءٍ لا يُنال بسلّم",41,"م",1,0],["من أب معرق النجار وأمّ","هي منه في عزّة الأحساب",42,"ب",1,0],["من أبيهِ الحَبْرِ فيه شَبَهٌ","في بيانٍ وسَماح ودَهاء",43,"ا",2,0],["مَنابِرَ لِلإِسلامَ قامَت سُيوفُكُم","يَقومُ لَها في الدَهرِ أَيُّ مَنارِ",44,"ر",1,0],["منابر كانت للمواعظ والهدى","فما بالها عادت لسُخْرَةِ ساخر",45,"ر",1,0],["منابِتُها في عُصْعُصي غَيرَ أنَّها","لِشَيْبي في هَمٍّ مُعَنٍّ وفي نَصَبْ",46,"ب",1,0],["مَنْ أبدعَ الجَوهَرَ عن قُدْرَةٍ","فإنَّه أعلى مِنَ الجَوْهَرِ",47,"ر",1,0],["من أبي الهدى لاح فينا مظهرْ","فَتَجلّى لنا بنورٍ أزهرْ",48,"ر",1,1],["من أبٍ يفتخر المجد به","إنْ رمى أصْمى وأنْ ساعدَ أسعد",49,"د",1,0],["من أبٍ كانَ بي رؤوفاً رحيماً","جُزِيَ الخيرَ والمثوبة عني",50,"ن",2,0],["من ابن كرامة تهدي دعاء","مديحا في الأصائل والبكورِ",51,"ر",1,0],["من أبي القاسم اقتسَمْتَ صِفاتٍ","زِدْتَ أوضاحَها لنا إيضاحا",52,"ح",2,0],["من أبدع القصص العجيبة مثلما","خلقت بإبداع الإله القادر",53,"ر",1,0],["مَنابِرُ الغَيْبِ تَبنيها عَزائمهُمْ","وكم وكَمْ شامخٍ في عَزمهِمْ خَرُبا",54,"ب",2,0],["منْ أباحَ الحُصونَ بعد اِمتناعٍ","ومَحا بالحُسامِ زبرَ الغَساقِ",55,"ق",1,0],["مِن أَبيَضٍ فَوقَ خَدٍّ أَبيَضٍ يَقِقٍ","جارٍ وَمَن أَحمَرٍ قانٍ عَلَى قانِ",56,"ن",1,0],["منابره فيه به كل ناطق","وأرقى مراقى مجده درجاته",57,"ت",2,0],["مَن أَبادوا بِالسِهامِ","كُلَّ ذي بَطشٍ همامِ",58,"م",1,0],["مِن أَبيَضٍ يُقَقٍ وَأَصفَرَ فاقِعٍ","مِثلِ الشُموسِ قُرِنَّ بِالأَقمارِ",59,"ر",1,0],["من أبى أن يكون جودك قيداً","كيف يرضى في الهوان قيودا",60,"د",2,0],["من أبيضٍ فاقَ نوعاً","وأحمرٍ راقَ جِنسا",61,"س",2,0],["مَنِ اِبتَغى عَنهُ بِالدّنيا لَهُ بَدَلاً","يَنالُهُ مُنتَهى الخُسْرانِ بِالبَدلِ",62,"ل",1,0],["مَنْ أبْدَلَ اللهَ بالأصْنامِ ثانيَةً","فما لمثلي على أمثالِهِ عَتَبُ",63,"ب",1,0],["مَن أبوه في البرايا","مَلك ناهٍ وآمرْ",64,"ر",1,0],["من أبوه فيصل أو","صنوه تيمور ابنا",65,"ن",2,0],["من ابن حنكلةٍ وإن عَربَت","مُذَالة لِقُدور الناس والحُرمِ",66,"م",1,0],["منا بأَرضِ عمانٍ سادةٌ رُجحٌ","عند اللقاءِ وحيٌّ دارهم هَجَرُ",67,"ر",1,0],["من ابن مامةَ كعب يوم عيَّ به","زوّ المنيةِ إلاّ حرّةً وقدى",68,"د",2,0],["من أبرأ عيسى به الجذام وأحيا ال","أموات وأغنى من السؤال بما قال",69,"ل",1,0],["من أبده الله بالملائك لما","وافته قريش نهار بدر بأبطال",69,"ل",1,0],["من أبرا عيني أبي الحسين بريق","في خيبر كيما يبيد مرجب الأبطال",69,"ل",1,0],["منابع العلم مفاتيح الحجى","مرابع الفهم مصابيح الدجى",70,"ج",2,0],["منَابِرُ الإِسْلاِم قَدْ طُهِّرَتْ","مِنَ سِمَةِ الطَّاِئع والقَادر",71,"ر",1,0],["من أبدعت آل الذكا واستنبطتْ","أمداً لهم حدّت بهم واشترطتْ",72,"ت",1,0],["منا بليتنا وفينا برؤها","لولا اختلاف الرأي والأميال",73,"ل",1,0],["مِن اِبنُ مامَةَ وَالطائيُّ في كَرَمٍ","وَشِدَّةِ الباسِ عَمروٌ وَاِبنُ شَدّادِ",74,"د",1,0],["مَن أَبادَ العِدى وَطَهَّرَ مِنهُم","في الجنوبِ البِقاعَ أَو في الشَمالِ",75,"ل",1,0],["منابتٌ وأصولٌ غيرُ زاكيةٍ","تَزهُو كنابتةِ الخضراءِ في الدِّمَنِ",76,"ن",1,0],["من آب يطلب منه العفو أدركه","ومن أبى وأحب الموت يعطاه",77,"ا",2,0],["من أبيين كراماً ضربوا","فوق هامات المعالي قببا",78,"ب",2,0],["مِن أَبيَضٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","أَو أَحمَرٍ مُخضَوضِلٍ نَضّاحِ",79,"ح",1,0],["من ابتهجَت به الأكوان نوراً","وأشرق من سناه النيران",80,"ن",1,0],["مِن أَبيض في أَحمَر قَد أَشبَها","صَلفَ الغواة وَخَجلة العَذراء",81,"ا",2,0],["من أَبيضٍ في أَزْرَق بِحُسْنِه","زاهٍ ومِنْ مُضَرَّجٍ مُعَصْفَرِ",82,"ر",1,0],["منابر في طول البلاد وعرضها","تنوح عليه عند كل صلاة",83,"ه",1,0],["مَنابِعُ أَنوارِ الهُدى في عِراصِها","لِباغي الهُدى وَالفَضلِ هديٌ وَمَرفِقُ",84,"ق",1,0],["منا بيننا الا الحكاية عن","ه والتعبير ذاك عبارة بلسان",85,"ن",1,0],["مَن أَباحَ الخَمرَ في أَسواقِنا","أَنبِؤوني مَن بِرِجسٍ أَمَرا",86,"ر",2,1],["مَنابِعُ أَدواءٍ مَوارِدُ مِحنَةٍ","تطولُ بِها البَلوى وَيَشقى بِها الفَمُ",87,"م",1,0],["منابت الشيح والقيصوم","ابحت من سري المكتوم",88,"م",1,0],["منابت سوء على دمنة","فلا تعبأن بخضرا الدمن",89,"ن",1,0],["منابر والأفكار فيها نواطق","مناهل والمورود أَريٌ وعلقم",90,"م",1,0],["من أبي بكر حاز ذاك وعبد الله","والقيلُ مشبه الرئبال",91,"ل",1,0],["من أبي بكر حاز ذاك وعب","د الله والشَّبْلُ مشبُهُ الرّئبال",92,"ل",1,0],["منابت الحسن كم فيها بدور التم","تقطف زهور الذي قد صار آمالي",93,"ي",1,0],["من أبيضٍ لدجى القنابلِ غُرَّة","متصدِّرٍ كالطَّلَّةِ الغَرَّاءِ",94,"ا",2,0],["من أَباريقَ تراها","لُثَّماً بيضاً خِفافا",95,"ف",2,0],["مِنّا بِشَجنَةٍ وَالذِنابِ فَوارِسٌ","وَعتائِدٍ مِثلُ السَوادِ المُظلَمِ",96,"م",1,0],["منابِتُك السفيرُ إِلى مُرادي","وإِسفار المَطالب بالسفير",97,"ر",1,0],["من ابتهجت مصر في عصره","وفازت سروراً بنيل الأماني",98,"ن",2,0],["من ابصر الدنيا بعين الحجى","هانت عليه فأصاب النجاة",99,"ه",1,0],["من ابنِ مرجانةَ فوقَ المنبَرِ","بمشهَدٍ من جمعِهُم ومَحضَرِ",100,"ر",1,0],["من أبصر الأجنبيّ بينهم","يظنّه واحداً من العصبَهْ",101,"ب",2,0],["من أَبَت نفسه الثَناء اِغتِصاباً","كانَ إِطراؤُنا له اِستِحقاقا",102,"ق",2,0],["من أَبيَض أَو أَ