h3er&doWhat=shqas&qid=77865&r=&rc=7",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[6242,"نبض للمعلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87567&r=&rc=14",""],[463,"على أيّ لائمة ٍ أربعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60121&r=&rc=177",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["وَاِسكُك سَبيلَ أَبيكَ إِنَّ سَبيلَه","لَقَمٌ يُجيزُ إِلى المَناقِبِ مَهيَعُ",0,"ع",1,0],["وَأَسْكُنُ وَالأقْدامُ بَعْدَ ثُبُوتِها","تَزِلُّ وَأَطْرافُ القنا تَتَحَرَّكُ",1,"ك",1,0],["وَأَسكِت كُلَّ صَوتٍ غَيرِ ضَربٍ","وَعَترَسَةٍ وَمَرمِيٍّ وَرامي",2,"م",2,0],["وَأَسكُتُ كَي يَخفى الَّذي بي مِنَ الهَوى","فَتَشكو إِلى الناسِ العِظامُ النَواحِلُ",3,"ل",1,0],["وأسْكَنْتُ ثأرِيَ لمّا دَعا","وأسْكَنْتُ بأسيَ لمّا غَلا",4,"ل",2,0],["وَاِسكُن قِبالَةَ بَيتِهِ وَفِنائِهِ","بِأَشَدِّ ما لَزِمَ الغَريمَ غَريمُ",5,"م",1,0],["وَاِسكُني يا رَحمَةَ اللَهِ بِهِ","وَاِجعَلي فَيضَكِ مُنهَلَّ السُكوبِ",6,"ب",1,0],["وَأَسكَنتُهُ بَيتاً خَسيساً مَتاعُهُ","وَإِنّي عَلى رُغمي بِهِ لَضَنينُ",7,"ن",1,0],["وأسكتها عنّي نشيج فلم تزل","تردّده منها بأقصى الحناجر",8,"ر",1,0],["واسكت درَّ الفحل واسترعفت به","حراجيج لم تلقح كشافاً سلوبها",9,"ب",3,0],["وأسكنته قلبي الذي طارَ فرحةً","فطائره قلبي الحزين ووكره",10,"ر",2,0],["وأسكر لحظه من غير ذوقٍ","فيالله من لحظٍ سحور",11,"ر",1,0],["وأسْكنتني بيتاً على البحرِ أرتجي","مكافاته في ألفِ بيتٍ على بحر",12,"ر",1,0],["وأسكنته عيني فزادَ ملاحةً","وقد راحَ فيها بالدّموع مقرطا",13,"ط",2,0],["وأسكب الدّمع محمرًّا كأنيَ قد","أجريت ذائب ما أعطيت مسبوكا",14,"ك",2,0],["وأسكنته كالضيف وسط جوانحي","فيا حزني والضيفِ بالبيتِ داخل",15,"ل",1,0],["وأسكن حيث الشهب حصباء واطئٍ","وحيث يمدُّ العزّ من فوقها ظلاَّ",16,"ل",2,0],["واسكبِ الخمرَ للعَصَافيرِ والنَّحْلِ","وخَلِّ الثَّرى يَضُمُّ عروسَكْ",17,"ك",1,0],["واسْكُبْ بأَجْفانِ الزُّهورِ","دُمُوعَ قلبي الدَّاميهْ",18,"ه",1,0],["وَاِسكُبِ العَبرَةَ في آماقِهِ","مِن تَباريحَ وَشَجوٍ وَعَزاء",19,"ا",2,0],["وأسكنتها الشمسُ من صنعةِ ال","تلويحِ في الأغرب فالأغربِ",20,"ب",1,0],["وأسكنْتَ السكينةَ ساحتَيها","فقرَّتْ بعدَما امتنعَ القَرارُ",21,"ر",1,0],["وَأَسكُتُ عَن أَشياءَ لَو شِئتُ قُلتُها","وَلَيسَ عَلَينا في المَقالِ أَميرُ",22,"ر",1,0],["واسكب نَدَى الحبِّ بأفواهِنا","كم من بَكِيٍّ وظَمِيٍّ طليح",23,"ح",1,0],["واسكب نداك لظامئ صديان","في كل أيك نفحة وبكل روض طاقة من عاطر الريحان",24,"ن",1,0],["وَأسكُنُ مِنكَ فِي جَبَلٍ مَنِيعٍ","وَأرعَى مِنكَ فِي رَوضٍ بَلِيلِ",25,"ل",1,0],["وأسكنَها أعْلى القِبابِ مَقاصِراً","وأحسنَها عاجاً وساجاً ومَرْمَرا",26,"ر",2,0],["واسكر لتضحى شُهرةً","متلوّثاً وسطَ القذَر",27,"ر",1,0],["وَأَسكَنَ في سُكٍّ مِنَ التُربِ ضَيِّقٍ","نُجومَ دُجىً في شَبوَةٍ أَبَت الثَلبا",28,"ب",2,0],["وأَسْكبْتِ دَمْعاً مِنْ جُفُونِ مُسَهَّدٍ","وَمَا رَقْرَقَتْ مِنْكِ المَدَامِعُ بِالسَّكبِ",29,"ب",1,0],["وَأَسْكَتَ أَفْراسَكَ الصَّاهِلاَتِ","وَأَصْمَتَ صَمْصَامَكَ الأَبْتَرَا",30,"ر",2,0],["واسكب على راحتيها روح عاشقها","ومص من شفتيها الشعر والعنبا",31,"ب",2,0],["واسكب لنا خمرةَ الفردوس تعصرها","مراشف الحور واشرب في أوانيها",32,"ي",3,0],["واسكن فروع ثهلان","وادْع كريماً يقظان",33,"ن",1,0],["وأسكنُ ما كنتُ في ضجرتي","وَأحْلَمُ مَا كُنْتُ عِنْدَ الغَضَبْ",34,"ب",1,0],["واسكب على قبر هناك معطّر","بالذكريات فؤادك الملتاحا",35,"ح",2,0],["وأسكرتني دموعي بعد زورته","أطيف ثغرك ساقاها حميّاه",36,"ا",2,0],["وأُسكِتِ كلُّ صوْتٍ غيْرِ ضَرْبٍ","وعترسة ٍ ومرميِّ ورام",37,"م",1,0],["وأَسْكَنْتُكَ الرُّوحَ يا كَعبةً","ويا ظالمًا لو تَرى مَوضِعَكْ",38,"ك",1,0],["واسكب في أذن الزمان مواجدي","وإن كانت الأضلاع منها تقصف",39,"ف",1,0],["وأسكَنَهُ جَنَّاتِ عَدنٍ مُنَعَّماً","ونَالَ بِمَا قَدَّمخَ الفَوزَ والرِّضَا",40,"ض",2,0],["واسكب مَدمَعَ العَينَينِ وأذرِ","وغَادِرهُ مَدَى الأيامِ يَجرِي",41,"ر",2,1],["وأسَّكنَهَا خَلِيفَتَه فأمسَى","لأدوَاءِ القلوبِ بِها طبيبا",42,"ب",2,0],["وأسكنهُ دار النعيم بقربهِ","وألهمَ أهليهِ الجميلَ من الصبرِ",43,"ر",1,0],["وأسكب عليها من رضاكَ سحائباً","طول الزمانُ على ثراها تمطرُ",44,"ر",1,0],["واسكنوها جنةً قد زُخرفت","لك يا يحيى تسرَّ الناظرينا",45,"ن",2,0],["وأسكرني شربُ كأسِ السُّرى","على عَزفِ جِنِّيِّها الجَهْوَرِيِّ",46,"ي",1,0],["وَاِسكُب هناكَ محاسن العبراتِ","وَاِغسل مَساوي سالف الزلّاتِ",47,"ت",1,0],["واسكُب أناشيدَ اللقاء بمَسمَع ال","دهر المصيخ وردّدِ الألحانا",48,"ن",2,0],["واسكنه من الفردوس داراً","مع الابرار اخوان الصفاء",49,"ا",2,0],["وأسكرني في الهوى ملء عيني","فكيف أقوم بملء فؤادي",50,"د",2,0],["وَأَسكَرَ مَشهَدُ الضِرغامِ بِشراً","وَكَم شَرِبَ الدَمَ المُهراقَ خَمرا",51,"ر",2,0],["وَاِسكُب ضِياءَكَ صِرفاً","عَلى شَديدِ سَوادي",52,"ي",1,0],["واسكَر من الرَّاحِ وأفهم ما اشرتُ له","فليس يحتاج لا كأساً ولا كُوبا",53,"ب",2,0],["وَاسْكُبْ دُمُوعَكَ إِذْ خَلَوْتَ لَعَلَّهَا","تُنْجِيكَ يَا ذَا مِنْ عَذَابِ النَّارِ",54,"ر",1,0],["وَأَسْكَنَهُ مِنْ جَنَّةِ الْخُلْدِ مَنْزِلاً","مَنُوطاً بِخَيْرِ الْخَلْقِ أَشْرَفِ مَنْ هَدَى",55,"ا",1,0],["وأسكرُ سكرةً لا صحوَ منها","وأَدخلُ جنّتَي حورٍ وغيد",56,"د",1,0],["وَأسكُنُ مِنها قاطِفاً ثَمَر المُنى","إلى سَكنٍ كالرّيمِ لم يَرمِ الفِكرا",57,"ر",2,0],["واسكبي نجواك ما بين يديها","فلديها نبعُ أسرار الإله",58,"ه",1,0],["وأسكب من حولها الأغنيات","مسعّرة اللحن حيرى النغم",59,"م",1,0],["واسكب القلب على ارماسهم","قطراتٍ واذرف الدمع دماء",60,"ا",2,0],["واسكُتْ إذا خاضَ الوَرَى في ذِكْرهِ","حتَّى يَخُوضُوا في حَدِيثٍ غَيْرِهِ",61,"ه",1,0],["وَأَسكَنَهُ في جَنّاتِ عَدن تَكَرُّما","فَأَنتَ الَّذي ما زِلت أَهل التَكَرّم",62,"م",1,0],["وَاِسكُب الدَمعَ سُرورا فَعَلى","غَيره دَمعُ الهَنا لَم يُسكَب",63,"ب",1,0],["وأَسكُبُ بالتَّبذُّلِ ماءَ وَجْهي","على حينَ استَشنَّ لي الأَديم",64,"م",1,0],["وأسكتُ إبقاءً وعندي مَقالةٌ","مُفّوَّفةٌ إن تَصدِمِ الصدرَ تَلْعَج",65,"ج",1,0],["وَاِسكُت فَإِنَّ العودَ يَن","طِقُ وَهوَ أَعذَبُ مِنكَ مَنطِق",66,"ق",1,0],["وأسكنك العلياء إرثاً مؤلَّفاً","وناهيك من إرثٍ لكم يتألَّف",67,"ف",1,0],["وَأَسكَن الأَرض كَي يَشتاق ساكِنُها","إِلى الجِنان وَمَن فيها بِرُؤيَتِهِ",68,"ت",2,0],["وأسكن شُذّاذ اليهود ديارن","وساق إلى الأقصى الجنود وكثّفا ؟",69,"ف",2,0],["وأُسْكنتَ التراب برغْم قومٍ","مَحلكَ في قلوبهُم مكينُ",70,"ن",1,0],["وأسكتتني ثانياً بعد أن","كنت المجلِّي قد غدوت الكميت",71,"ت",1,0],["وأُسكِّنُ القلبَ الْخَفُو","قَ إليكُمُ بِمُنَى التّلاقي",72,"ق",2,0],["وأسكَرَتْنا بألفاظٍ تكرّرها","وما أدارَتْ على النّدمان أقداحا",73,"ح",2,0],["وأَسكرني طرف ذاك الغرير","بغير المدام فهل أَنْتَ صاح",74,"ح",1,0],["وأَسْكَرَنَا بَيَاناً دامَ حَتَّى","عَجِبْنَا كيفَ خَدَّرْنا المُدَاما",75,"م",2,0],["وأسكرَني بالمَطْلِ غيرُك مدةً","وما يُعرفُ السكرانُ حتى يعربدُ",76,"د",1,0],["وأسكنت فيه من شواعر مهجتي","ثوائر لا ترضى النفاق الملثما",77,"م",2,0],["وأسكنُ من وطني بعدَه","إلى حسرةٍ قلّما تُقلعُ",78,"ع",1,0],["وَأَسكَرَ الإِعجابُ أَخلاقَهُ","فَحالَ مِنها العُلوَ وَالسُفلا",79,"ل",2,0],["واسكن بقلب راسخ بنيانه","وابدل به متداعي البنيان",80,"ن",1,0],["واسكر بنشوة قهوة تنفي الهمو","م وتنجلي لطموحها الأنراح",81,"ح",1,0],["وأسكرني بالعذب من خمر ريقه","وأمتعني بالورد من وجناته",82,"ت",2,0],["وأسكرها خمر النحور فأظهرت","عواملها سراً من النار مضمر",83,"ر",1,0],["وأُسكِنْتُ عندك ظلّاً أقول","كفانِيَ ما نلتُ منه كفاني",84,"ن",2,0],["وأسكنتني وصروفُ الزّما","نِ تُصحرني منك ظِلّاً ظليلا",85,"ل",2,0],["وأسكننا يومَ العباءَةِ وَسْطَها","وألْبابُ من لمُ يعطَ ذاك تَرَجَّفُ",86,"ف",1,0],["واسكن مدينات العلى","ودع الحواسد في القرايا",87,"ا",3,0],["واسكر بها مع كل شم","ماسٍ يميل كغصن بان",88,"ن",1,0],["واسكر من خمرة طلعته","وانظر نور الوجه البهج",89,"ج",1,0],["وأسكنته في الأرض أظهر كامناً","به من شقا أصحاب قبضة يسرتي",90,"ي",1,0],["وأسكنه الفردوس فضلاً ورحمةً","والحقه بالصالحين المهاديا",91,"ي",2,0],["وأسكنهُ اللّه أعلى الجنان","وَباللطفِ والعفو منه غمَر",92,"ر",1,0],["وأسكنها الرضوان في روض قدسها","وملكتها أشخاص أنواع جنسها",93,"ه",2,0],["وأسكنه في مَسجد الطُّهر وحدَه","وزوَّجه واللهُ من شاءَ يَرفَعُ",94,"ع",1,0],["وأسكن إلي رأي ذي احتفاء