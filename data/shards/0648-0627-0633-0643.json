{"poems":[[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[63,"هي النفس في مستنقع الموت تبرك","https://www.aldiwan.net/poem45893.html","الطويل"],[3,"نأتك رقاش إلا عن لمام","https://www.aldiwan.net/poem110.html",""],[55,"ظلوم هبي لي سوء ظنك واعلمي","https://www.aldiwan.net/poem26164.html","الطويل"],[77,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[42,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[86,"ولدي قد طال سهدي ونحيبي","https://www.aldiwan.net/poem10476.html","الرمل"],[54,"على الكره ما فارقت أحمد وانطوى","https://www.aldiwan.net/poem27461.html","الطويل"],[88,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[72,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"تقلدت من نعماك في حال غربتي","https://www.aldiwan.net/poem18897.html","الطويل"],[72,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[72,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[92,"قد سكرنا بحبنا واكتفينا","https://www.aldiwan.net/poem38928.html","الخفيف"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[85,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[62,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[61,"أغرتك الشهاب أم النهار","https://www.aldiwan.net/poem51685.html","الوافر"],[58,"أغمض عيني في أمور كثيرة","https://www.aldiwan.net/poem31012.html","الطويل"],[97,"يا أيها العالي الغفور الصفوح","https://www.aldiwan.net/poem24918.html","السريع"],[97,"يا صفوة الأحباب والخلان","https://www.aldiwan.net/poem24934.html","الكامل"],[81,"أمولاي الذي آوي به في","https://www.aldiwan.net/poem61326.html","الوافر"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[46,"أطل صليب الدلو بين نجومه","https://www.aldiwan.net/poem22112.html","الطويل"],[76,"لقد سجعت في جنح ليل حمامة","https://www.aldiwan.net/poem39484.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141997","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[47,"أَسَيْفُ الهُدَى ، وَقَرِيعَ العَرَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=14643",""],[94,"دمعة على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=12814",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[3,"نأَتكَ رقاش إلاّ عنْ لِمامِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10747&r=&rc=101",""],[117,"ولا تلثمه","https://www.aldiwan.net/poem24066.html","المتقارب"],[120,"صلاتي لربي الصمت في معبد الدجى","https://www.aldiwan.net/poem49273.html","الطويل"],[132,"رضا بالقضا إن المقادير ترتضى","https://www.aldiwan.net/poem54810.html","الطويل"],[132,"واسكب مدمع العينين وأذر","https://www.aldiwan.net/poem54820.html","الوافر"],[132,"آمنت من الخطوب أتيت طوبى","https://www.aldiwan.net/poem54892.html","الطويل"],[135,"سقى الله قبرا ضم أعظم ماجد","https://www.aldiwan.net/poem49158.html","الطويل"],[135,"خل العزاء فذا مصاب أكبر","https://www.aldiwan.net/poem49160.html","الكامل"],[160,"هذه دار أمير المؤمنينا","https://www.aldiwan.net/poem58825.html","الرمل"],[166,"وسقت الركائب حتى أنخن","https://www.aldiwan.net/poem46823.html","المتقارب"],[189,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[197,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[210,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[222,"أغرك صبري وفرط ودادي","https://www.aldiwan.net/poem55464.html","المتقارب"],[223,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[223,"رن رن ألو مركز القلب","https://www.aldiwan.net/poem41902.html","المجتث"],[232,"استعمل العصف بعد الدبغ مقلوبا","https://www.aldiwan.net/poem14936.html","البسيط"],[237,"ما شأن دنيانا سوى الإنذار","https://www.aldiwan.net/poem19781.html","الكامل"],[237,"أفاض عليه الله أبحر فضله","https://www.aldiwan.net/poem19805.html","الطويل"],[270,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[275,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[328,"طوفى يا روح بالوادي الأمين","https://www.aldiwan.net/poem54918.html","الرمل"],[328,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[342,"أنشد الشعر وحي الشهداء","https://www.aldiwan.net/poem55389.html","الرمل"],[348,"أما السماح فقد مضى وقد انقضى","https://www.aldiwan.net/poem20281.html","الكامل"],[361,"بروضة هذا النظم نزهت ناظري","https://www.aldiwan.net/poem68054.html","الطويل"],[361,"مقلتي قد نلت كل الارب","https://www.aldiwan.net/poem68142.html","الرمل"],[364,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[364,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[366,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[377,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[380,"تورد الدمع من توريد وجنته","https://www.aldiwan.net/poem48819.html","البسيط"],[400,"وماذا لو تمادى ؟؟","https://www.aldiwan.net/poem6736.html","عموديه"],[402,"أتدري من تخرمت المنون","https://www.aldiwan.net/poem46438.html","الوافر"],[403,"وافت هداياك التي مثلها","https://www.aldiwan.net/poem34101.html","السريع"],[409,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[416,"زارت وجنح الدجى يا سعد معتكر","https://www.aldiwan.net/poem53872.html","البسيط"],[416,"أما والهوى بالوجوه الملاح","https://www.aldiwan.net/poem53979.html","الرمل"],[432,"طرحنا فوق غاربها الزمانا","https://www.aldiwan.net/poem12375.html","الوافر"],[432,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[453,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[458,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[468,"أبو السرور بن جريج فتى","https://www.aldiwan.net/poem59716.html","السريع"],[479,"لست الإله ولست بالشيطان","https://www.aldiwan.net/poem36946.html","الكامل"],[482,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[493,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[551,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[551,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[551,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[558,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[558,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[558,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[587,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["وَاِسكُك سَبيلَ أَبيكَ إِنَّ سَبيلَه","لَقَمٌ يُجيزُ إِلى المَناقِبِ مَهيَعُ",0,"ع",1,0],["وَأَسْكُنُ وَالأقْدامُ بَعْدَ ثُبُوتِها","تَزِلُّ وَأَطْرافُ القنا تَتَحَرَّكُ",1,"ك",1,0],["وَأَسكِت كُلَّ صَوتٍ غَيرِ ضَربٍ","وَعَترَسَةٍ وَمَرمِيٍّ وَرامي",2,"م",2,0],["وَأَسكُتُ كَي يَخفى الَّذي بي مِنَ الهَوى","فَتَشكو إِلى الناسِ العِظامُ النَواحِلُ",3,"ل",1,0],["وأسْكَنْتُ ثأرِيَ لمّا دَعا","وأسْكَنْتُ بأسيَ لمّا غَلا",4,"ل",2,0],["وَاِسكُن قِبالَةَ بَيتِهِ وَفِنائِهِ","بِأَشَدِّ ما لَزِمَ الغَريمَ غَريمُ",5,"م",1,0],["وَاِسكُني يا رَحمَةَ اللَهِ بِهِ","وَاِجعَلي فَيضَكِ مُنهَلَّ السُكوبِ",6,"ب",1,0],["وَأَسكَنتُهُ بَيتاً خَسيساً مَتاعُهُ","وَإِنّي عَلى رُغمي بِهِ لَضَنينُ",7,"ن",1,0],["وأسكتها عنّي نشيج فلم تزل","تردّده منها بأقصى الحناجر",8,"ر",1,0],["واسكت درَّ الفحل واسترعفت به","حراجيج لم تلقح كشافاً سلوبها",9,"ب",3,0],["وأسكنته قلبي الذي طارَ فرحةً","فطائره قلبي الحزين ووكره",10,"ر",2,0],["وأسكر لحظه من غير ذوقٍ","فيالله من لحظٍ سحور",11,"ر",1,0],["وأسْكنتني بيتاً على البحرِ أرتجي","مكافاته في ألفِ بيتٍ على بحر",12,"ر",1,0],["وأسكنته عيني فزادَ ملاحةً","وقد راحَ فيها بالدّموع مقرطا",13,"ط",2,0],["وأسكب الدّمع محمرًّا كأنيَ قد","أجريت ذائب ما أعطيت مسبوكا",14,"ك",2,0],["وأسكنته كالضيف وسط جوانحي","فيا حزني والضيفِ بالبيتِ داخل",15,"ل",1,0],["وأسكن حيث الشهب حصباء واطئٍ","وحيث يمدُّ العزّ من فوقها ظلاَّ",16,"ل",2,0],["واسكبِ الخمرَ للعَصَافيرِ والنَّحْلِ","وخَلِّ الثَّرى يَضُمُّ عروسَكْ",17,"ك",1,0],["واسْكُبْ بأَجْفانِ الزُّهورِ","دُمُوعَ قلبي الدَّاميهْ",18,"ه",1,0],["وَاِسكُبِ العَبرَةَ في آماقِهِ","مِن تَباريحَ وَشَجوٍ وَعَزاء",19,"ا",2,0],["وأسكنتها الشمسُ من صنعةِ ال","تلويحِ في الأغرب فالأغربِ",20,"ب",1,0],["وأسكنْتَ السكينةَ ساحتَيها","فقرَّتْ بعدَما امتنعَ القَرارُ",21,"ر",1,0],["وَأَسكُتُ عَن أَشياءَ لَو شِئتُ قُلتُها","وَلَيسَ عَلَينا في المَقالِ أَميرُ",22,"ر",1,0],["واسكب نَدَى الحبِّ بأفواهِنا","كم من بَكِيٍّ وظَمِيٍّ طليح",23,"ح",1,0],["واسكب نداك لظامئ صديان","في كل أيك نفحة وبكل روض طاقة من عاطر الريحان",24,"ن",1,0],["وَأسكُنُ مِنكَ فِي جَبَلٍ مَنِيعٍ","وَأرعَى مِنكَ فِي رَوضٍ بَلِيلِ",25,"ل",1,0],["وأسكنَها أعْلى القِبابِ مَقاصِراً","وأحسنَها عاجاً وساجاً ومَرْمَرا",26,"ر",2,0],["واسكر لتضحى شُهرةً","متلوّثاً وسطَ القذَر",27,"ر",1,0],["وَأَسكَنَ في سُكٍّ مِنَ التُربِ ضَيِّقٍ","نُجومَ دُجىً في شَبوَةٍ أَبَت الثَلبا",28,"ب",2,0],["وأَسْكبْتِ دَمْعاً مِنْ جُفُونِ مُسَهَّدٍ","وَمَا رَقْرَقَتْ مِنْكِ المَدَامِعُ بِالسَّكبِ",29,"ب",1,0],["وَأَسْكَتَ أَفْراسَكَ الصَّاهِلاَتِ","وَأَصْمَتَ صَمْصَامَكَ الأَبْتَرَا",30,"ر",2,0],["واسكب على راحتيها روح عاشقها","ومص من شفتيها الشعر والعنبا",31,"ب",2,0],["واسكب لنا خمرةَ الفردوس تعصرها","مراشف الحور واشرب في أوانيها",32,"ي",3,0],["واسكن فروع ثهلان","وادْع كريماً يقظان",33,"ن",1,0],["وأسكنُ ما كنتُ في ضجرتي","وَأحْلَمُ مَا كُنْتُ عِنْدَ الغَضَبْ",34,"ب",1,0],["واسكب على قبر هناك معطّر","بالذكريات فؤادك الملتاحا",35,"ح",2,0],["وأسكرتني دموعي بعد زورته","أطيف ثغرك ساقاها حميّاه",36,"ا",2,0],["وأُسكِتِ كلُّ صوْتٍ غيْرِ ضَرْبٍ","وعترسة ٍ ومرميِّ ورام",37,"م",1,0],["وأَسْكَنْتُكَ الرُّوحَ يا كَعبةً","ويا ظالمًا لو تَرى مَوضِعَكْ",38,"ك",1,0],["واسكب في أذن الزمان مواجدي","وإن كانت الأضلاع منها تقصف",39,"ف",1,0],["وأسكَنَهُ جَنَّاتِ عَدنٍ مُنَعَّماً","ونَالَ بِمَا قَدَّمخَ الفَوزَ والرِّضَا",40,"ض",2,0],["واسكب مَدمَعَ العَينَينِ وأذرِ","وغَادِرهُ مَدَى الأيامِ يَجرِي",41,"ي",1,1],["وأسَّكنَهَا خَلِيفَتَه فأمسَى","لأدوَاءِ القلوبِ بِها طبيبا",42,"ب",2,0],["وأسكنهُ دار النعيم بقربهِ","وألهمَ أهليهِ الجميلَ من الصبرِ",43,"ر",1,0],["وأسكب عليها من رضاكَ سحائباً","طول الزمانُ على ثراها تمطرُ",44,"ر",1,0],["واسكنوها جنةً قد زُخرفت","لك يا يحيى تسرَّ الناظرينا",45,"ن",2,0],["وأسكرني شربُ كأسِ السُّرى","على عَزفِ جِنِّيِّها الجَهْوَرِيِّ",46,"ي",1,0],["وَاِسكُب هناكَ محاسن العبراتِ","وَاِغسل مَساوي سالف الزلّاتِ",47,"ت",1,0],["واسكُب أناشيدَ اللقاء بمَسمَع ال","دهر المصيخ وردّدِ الألحانا",48,"ن",2,0],["واسكنه من الفردوس داراً","مع الابرار اخوان الصفاء",49,"ا",2,0],["وأسكرني في الهوى ملء عيني","فكيف أقوم بملء فؤادي",50,"ي",1,0],["وَأَسكَرَ مَشهَدُ الضِرغامِ بِشراً","وَكَم شَرِبَ الدَمَ المُهراقَ خَمرا",51,"ر",2,0],["وَاِسكُب ضِياءَكَ صِرفاً","عَلى شَديدِ سَوادي",52,"ي",1,0],["واسكَر من الرَّاحِ وأفهم ما اشرتُ له","فليس يحتاج لا كأساً ولا كُوبا",53,"ب",2,0],["وَاسْكُبْ دُمُوعَكَ إِذْ خَلَوْتَ لَعَلَّهَا","تُنْجِيكَ يَا ذَا مِنْ عَذَابِ النَّارِ",54,"ر",1,0],["وَأَسْكَنَهُ مِنْ جَنَّةِ الْخُلْدِ مَنْزِلاً","مَنُوطاً بِخَيْرِ الْخَلْقِ أَشْرَفِ مَنْ هَدَى",55,"ا",1,0],["وأسكرُ 