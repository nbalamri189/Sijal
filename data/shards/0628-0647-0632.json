{"poems":[[83,"تبسم عن لما در نظيم","https://www.aldiwan.net/poem61310.html","البسيط"],[77,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[193,"أأحبابنا ما خنت عهدكم قط","https://www.aldiwan.net/poem35158.html","الطويل"],[201,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[214,"لطائر البشر بالأفراح تغريد","https://www.aldiwan.net/poem13312.html","البسيط"],[287,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[303,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[445,"هلال بنور السعد والحق مقمر","https://www.aldiwan.net/poem34759.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53883","الوافر"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123399","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96672","الطويل"],[1203,"","https://poetry.dctabudhabi.ae/diwan/poem/28271","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112816","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47492","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100888","الطويل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84929","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74270","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132666","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202284","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117879","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117997","الطويل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106729","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""]],"verses":[["بهِ زاد السُّرُورُ وطاب عَيشي","وراق العيش بِالعِزّ الرَّقِيمِ",0,"م",1,0],["بهِزَبْرِ هذا الناس وابنِ هِزَبرِهم","وأمينِ هذا الملك وابنِ أمينهِ",1,"ن",2,0],["بهِ زيّن اللَّه الوجودَ بخاتمٍ","لأعظمِ أفلاكِ السما نعلهُ قرطُ",2,"ط",1,0],["بهزالِ جسمي باصفراري","بالتجعّدِ بالغُصونِ",3,"ن",1,0],["به زهت حسنات الدهر وانتظمت","كما ينظم بالحبات عنقود",4,"د",1,0],["بِهِ زالَ عَنّا عُبوسُ الزَمانِ","وَأَبدى لَنا بشرَهُ وَاِبتَسَم",5,"م",1,0],["بهزلِ الدهرِ تاه بها وضيعٌ","كما إبليسُ في الفردوس تاها",6,"ا",3,0],["بِهِ زِيدَ فِي آلِ النَّبيِّ مُحَمَّدٍ","حسامٌ وبَحْرٌ بالنَّدى يَتَفَجَّرُ",7,"ر",1,0],["به زَهرٌ من الآداب غضٌّ","أنيقٌ لا يقاربُه ذُبُول",8,"ل",1,0],["به زَبَبٌ قد عَمَّ أكثرَ جِلدِه","ولكن فشافي نَبْتِ عارِضه المَرْطُ",9,"ط",1,0],["به زانتِ الأيّام وجهاً وأشرقت","بدولته أبكارها والأصائلُ",10,"ل",1,0],["بِه زانتِ الدنيا وأَضحت كأنّها","مِنَ الحسنِ مقلاق الوشاح عروسُ",11,"س",1,0],["بِهزمارٍ تُرادُ العيسُ فيها","إِذا أَشفَقن مِن قَلقِ الصِّفارِ",12,"ر",1,0],["به زخرفت جَنّات عدن لأهلها","به جاءت الآيات والذكر والسور",13,"ر",1,0],["به زجل التسبيح عالٍ يهيجه","حنينٌ إلى ذاك الحمى وتشوق",14,"ق",1,0],["بِهِ زَوجُ رُمَّانٍ يَلوحُ كَأَنَّهُ","قَناديلُ تِبْرٍ مُحْكَماتُ العَلائِقِ",15,"ق",1,0],["به زورةٌ لا يشفعُ الدمعُ عندَها","ولا تعصمُ الإنسانَ فيها موائله",16,"ل",2,0],["بِهِ زَهَت الجَنات وَالحور أَرخَت","محمد جَنات الخُلود عُلاه",17,"ا",2,0],["بِهِ زينت ذات الرِياسة إِذ غَدا","لَها شامة خَضراء في ذَلِكَ الخَد",18,"د",1,0],["بهزة العطف وهو رمح","ونظرة الطرف وهو مرهف",19,"ف",1,0],["بِهِ زَورُ العُبودَةِ فَهوَ أَدنى","نَصَتهُ الخَيلُ عَن مَيلٍ فَميلِ",20,"ل",1,0],["به زحفوا نحو بيت الإله","ليترك بنيانه يهدم",21,"م",1,0],["به زهت مصر وازدانت به وغدت","رأساً وأصبحت الدنيا لها ذنبا",22,"ب",2,0],["بهزّك غصن القدّ ماذا تريدينا","وماذا بلغز العين في السر تعنينا",23,"ن",2,1],["بِهِ زَها عَرضُ بَيداءٍ فَتَحسَبُها","عَلى غَديرِ سَرابٍ قَد طَفا حَبَبا",24,"ب",2,0],["بهُزالهِ سمَنُ العُلا وكذا","في الهَزْلِ منه حقيقةُ الجد",25,"د",1,0],["به زخم الحضارة والمعالي","به عشتار نجمة كلّ شادِ",26,"د",1,0]]}