{"poems":[[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[87,"ألا في سبيل الله ذاك الدم الغالي","https://www.aldiwan.net/poem62834.html","الطويل"],[64,"نارنجنا في لونه","https://www.aldiwan.net/poem52399.html","مجزوء الرجز"],[47,"مل فما تعطفه رحمة","https://www.aldiwan.net/poem66828.html","السريع"],[159,"مل فأبدى الصدود من ملل","https://www.aldiwan.net/poem55567.html","المنسرح"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[520,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118429","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103299","السريع"],[4877,"متاهات","https://www.poetsgate.com/ViewPoem.aspx?id=29460",""],[585,"هي الحرب فانظر كيف ومض البوارق","https://www.poetsgate.com/ViewPoem.aspx?id=161905",""],[5084,"قم يانديبي على حمراً","https://www.poetsgate.com/ViewPoem.aspx?id=177783",""],[5220,"البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=37049",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6170,"يعودُ للصفّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86032&r=&rc=3",""]],"verses":[["ملفوفةً قي غُبْشَةً وظَلامِ","صُوَرٌ من الفنِّ المروِّعِ أعجزتْ",0,"ت",1,0],["مُلَفَّفَةً في حُلَّةٍ شَفَقِيَّةٍ","هِلالِيَّةٍ مِن رايَةِ النيلِ تِمثالِ",1,"ل",1,0],["ملفوفةً في خِرَقٍ","من الحريرِ الأخضرِ",2,"ر",1,0],["مَلَّ فَما تَعطِفُهُ رَحمَةٌ","وَاتَّخَذَ العِلّاتَ أَعوانا",3,"ن",2,1],["مَلَّ فَأَبْدى الصُّدُودَ مِنْ مَلَلِ","وَاعْتَلَّ في صِحَّةٍ مِنَ العِلَلِ",4,"ل",1,1],["مُلَّ فلا الحصاةُ من فؤاده","تلينُ لي ولا اللسانُ يَرطُبُ",5,"ب",1,0],["مل فكري في الشعر من فرد لون","أي نفس لا تعتريها الملالة",6,"ل",2,0],["ملفُّها مقطها ومسطره","مصقلةٌ ومنفذٌ محررَه",7,"ه",1,0],["ملفى به نهج ارباب الضلال غدا","والحمد لله مولى الفضل والنعم",8,"م",1,0],["ملفتاً كان فالتوى بخطاه","عاثراً في أطرافها الملويه",9,"ه",1,0],["ملفق مظهر سرى وشان دمي","لما جرى من عيوني أو وشا ندمي",10,"م",2,0],["مَلفوفَةً في حُلَلٍ هُنَّ مِن","خُضرٍ ومن صُفرٍ ومن حُمرِ",11,"ر",1,0],["ملف عمري تاه بين الملفات","يا بنت أنا إنسان وقتي نساني",12,"ن",2,0],["ملفقةً من كل شرقٍ ومغربٍ","مفتقةً أعيت على كلّ راتق",13,"ق",1,0],["ملفاك خالي إلى يبست صرايرها","هو مسندي لا جت الضيقات وحزامي",14,"م",2,0],["ملفاه منهو طوع العاصيه طوع","مناحي ولد عمي عطيب الظروبي",15,"ب",2,0],["ملفقة ليست لديكم بحجة","وتلك كبيت العنكبوت لدى النقد",16,"د",1,0],["ملَفّاتٌ مُلَطَّخَةٌ بعهرٍ","تُريدُ النيلَ منْ هندٍ ومايا",17,"ا",3,0],["مَلفاك من دُون الرفافة أَبو علي","ذيب الشَلايا وَريف ركب لفونها",18,"ن",3,0],["ملفاك غلمه ينطحوا الضد بِالقَنا","مثل السباع مجنزرة مع شبالها",19,"ل",3,0],["ملفاك أَسداً ينطحوا الضد بِالقَنا","من طرح نامر أَربعا انجال",20,"ل",1,0],["مَلَفُّهُ، أوْرَاقهُ، شَمسُهُ","محرُوقةٌ في شَوقهِ الثَّائرِ",21,"ر",1,0]]}