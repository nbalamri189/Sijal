{"poems":[[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[85,"ألا في سبيل الله ذاك الدم الغالي","https://www.aldiwan.net/poem62834.html","الطويل"],[62,"نارنجنا في لونه","https://www.aldiwan.net/poem52399.html","مجزوء الرجز"],[45,"مل فما تعطفه رحمة","https://www.aldiwan.net/poem66828.html","السريع"],[153,"مل فأبدى الصدود من ملل","https://www.aldiwan.net/poem55567.html","المنسرح"],[456,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[513,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"]],"verses":[["ملفوفةً قي غُبْشَةً وظَلامِ","صُوَرٌ من الفنِّ المروِّعِ أعجزتْ",0,"ت",1,0],["مُلَفَّفَةً في حُلَّةٍ شَفَقِيَّةٍ","هِلالِيَّةٍ مِن رايَةِ النيلِ تِمثالِ",1,"ل",1,0],["ملفوفةً في خِرَقٍ","من الحريرِ الأخضرِ",2,"ر",1,0],["مَلَّ فَما تَعطِفُهُ رَحمَةٌ","وَاتَّخَذَ العِلّاتَ أَعوانا",3,"ن",2,1],["مَلَّ فَأَبْدى الصُّدُودَ مِنْ مَلَلِ","وَاعْتَلَّ في صِحَّةٍ مِنَ العِلَلِ",4,"ل",1,1],["مُلَّ فلا الحصاةُ من فؤاده","تلينُ لي ولا اللسانُ يَرطُبُ",5,"ب",1,0],["مل فكري في الشعر من فرد لون","أي نفس لا تعتريها الملالة",6,"ل",2,0]]}