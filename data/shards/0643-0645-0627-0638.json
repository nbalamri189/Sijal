{"poems":[[39,"ولما رأيت الدهر يقلب ظهره","https://www.aldiwan.net/poem7446.html","الطويل"],[53,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[109,"كم أظهر العشق من سر","https://www.aldiwan.net/poem58554.html","عموديه"],[69,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[139,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[412,"بعثن غداة تقويض الخيام","https://www.aldiwan.net/poem50124.html","الوافر"],[563,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117884","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94454","الكامل"],[5312,"الحكمُ للهِ كلٌّ غيرُه فاني","https://www.poetsgate.com/ViewPoem.aspx?id=128473",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""]],"verses":[["كما ظعنت عنا قضاعة ظعنة","هي الجد مأدوم النحيزة بالهزل",0,"ل",1,0],["كما ظهرتْ على العضْب اليماني","مآثرُ من يَدَيْ صَنَعٍ مُجيدِ",1,"د",1,0],["كم أظهر العشق من سر وكم كتما","وكم أمات وأحيا قبلنا أمما",2,"م",2,1],["كَمْ أَظْهَرَتْ أَقْلامُهُ مِنْ مُعْجِزٍ","لِلطَّرْسِ لَمَّا أنْ رَأَتْهُ مُرْسَلَهْ",3,"ل",2,0],["كم أظلَّتْ مِصْراً وحاطَتْ بَنِيها","من هَجيرِ الْخُطُوبِ والأهوال",4,"ل",1,0],["كم أظهر العلْمُ من أطفالهم علمَاً","فرداً وأخرج كنزاً كان مدفونا",5,"ن",2,0],["كما ظل في التهليل يهزا بنفيه","واثباته مستجهلا للمغاير",6,"ر",1,0],["كَما ظَلَمَ النَدى مَن قاسَ يَوماً","نَدى كَفَّ المفرِّج بِالغَمامِ",7,"م",1,0],["كما ظهرت بآدم وهو خلق","فأعمت عنه إبليس اللعينا",8,"ن",2,0],["كم أظهر هديا وكم أباد ضلالا","كم نوّل من صادق وخيّب محتال",9,"ل",1,0],["كم أظهروا كيد سوء في واقترفوا","ذنبا وفي كيدهم خسر وتضليل",10,"ل",1,0],["كما ظلمت عقود من جمان","إذا ما قلدت في جيد أرنب",11,"ب",1,0],["كم أظهرت بالمعجزات عجائباً","مذ خوَّلت روحَ الصفا الأشباحا",12,"ح",2,0],["كم أظهرت فرحًا في طيِّه حزَنٌ","وما استحت واحدًا في العصر ربّاني",13,"ن",2,0],["كما ظن غوغاء الكويت سفاهة","سمواً وعزاً بالطفات الأسافل",14,"ل",1,0],["كما ظنه من قل في العلم حظه","وليس له فيه مجال ولا دخل",15,"ل",1,0]]}