{"poems":[[53,"نأت القلوب وسوف تنأى الدار","https://www.aldiwan.net/poem30435.html","الكامل"],[53,"ولقد شهدت الخيل دامية","https://www.aldiwan.net/poem30449.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[73,"إن ساء فعلك بي فما ذنبي أنا","https://www.aldiwan.net/poem11880.html","الكامل"],[5,"أنذرت أعدائي غدا","https://www.aldiwan.net/poem315.html",""],[35,"لمن الديار بأبرق الحنان","https://www.aldiwan.net/poem38817.html","الكامل"],[35,"أمن آل قيلة بالدخول رسوم","https://www.aldiwan.net/poem39086.html","الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[23,"أسألت رسم الدار أم لم تسأل","https://www.aldiwan.net/poem21245.html","الكامل"],[23,"لا زال كعب يستهل دموعه","https://www.aldiwan.net/poem21511.html","الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[29,"الكاملبان الشباب وربما عللته","https://www.aldiwan.net/poem6029.html","الكامل"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[29,"أذكرت عهدك فاعترتك صبابة","https://www.aldiwan.net/poem6097.html","البسيط"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[70,"يا مولي النعماء إني شاكر","https://www.aldiwan.net/poem42697.html","الكامل"],[78,"ولقد شربت الراح يسطع نورها","https://www.aldiwan.net/poem14044.html","الكامل"],[89,"من كل زهر قد جمعت قليلا","https://www.aldiwan.net/poem44606.html","الكامل"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[89,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[89,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"في مهرجان الحق أو يوم الدم","https://www.aldiwan.net/poem62949.html","الكامل"],[45,"قل للوزير وماعدا سلطانه","https://www.aldiwan.net/poem63575.html","الكامل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"ما أنس من شيء فلست بناس","https://www.aldiwan.net/poem64607.html","الكامل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[52,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[46,"يا راعي الود الذي أفعاله","https://www.aldiwan.net/poem23629.html","الكامل"],[1,"ولقد شهدت الخيل وهي مغيرة","https://www.aldiwan.net/poem20968.html","الكامل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[8,"قالت أمامة كم عمرت زمانة","https://www.aldiwan.net/poem21849.html","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9850","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21022","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[45,"قُلْ للوَزِيرِ وَما عَدا سُلطانَهُ التّوْ","https://www.poetsgate.com/ViewPoem.aspx?id=31260",""],[35,"أمِنَ آلِ قَيلَة َ بالدَّخُولِ رُسُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=22153",""],[29,"بان الشّبابُ، ورُبّما عَلّلْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17433&r=&rc=6",""],[3,"هلْ غادرَ الشُّعراءُ منْ متردَّم ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10745&r=&rc=99",""],[18,"منْ مبلغٌ بكراً وَ آلَ أبيهمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26449&r=&rc=15",""],[119,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[126,"بحر الفصاحة غاض يا إخواني","https://www.aldiwan.net/poem50494.html","الكامل"],[140,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[141,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[141,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[141,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[158,"لا تأخذنك وحشة مما جرى","https://www.aldiwan.net/poem58918.html","الكامل"],[193,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[197,"زعموني نسيت والهجر ينسي","https://www.aldiwan.net/poem45601.html","الخفيف"],[227,"السقم في اللحظ السقيم","https://www.aldiwan.net/poem50789.html","مجزوء الكامل"],[227,"لا استوحشت لك أربع وقصور","https://www.aldiwan.net/poem51073.html","الكامل"],[229,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[230,"لمن اللحاظ مريضة الأجفان","https://www.aldiwan.net/poem14748.html","الكامل"],[245,"إن كنت عاذلتي فسيري","https://www.aldiwan.net/poem1933.html","مجزوء الكامل"],[248,"يا أيها المولى الرئيس ومن له","https://www.aldiwan.net/poem14928.html","الكامل"],[273,"ضن السماح عليه بالترحال","https://www.aldiwan.net/poem25539.html","الكامل"],[289,"ولقد شهدت الخيل تحمل شكتي","https://www.aldiwan.net/poem552.html",""],[317,"ولقد شهدت البرق برق تهامة","https://www.aldiwan.net/poem23895.html","الكامل"],[344,"ولقد طعنت الليل في أعجازه","https://www.aldiwan.net/poem23974.html","الطويل"],[364,"كم قلت للعاني المنى بلحاقه","https://www.aldiwan.net/poem17256.html","الكامل"],[400,"أترى يعود من الحمى قلبي","https://www.aldiwan.net/poem34152.html","الكامل"],[403,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[413,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[413,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[429,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[434,"عم الندى وتواتر الإنعام","https://www.aldiwan.net/poem2560.html","الكامل"],[436,"بلغت عبدك الخطوب مداها","https://www.aldiwan.net/poem34891.html","الخفيف"],[438,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[459,"لا تنكري شعثي ولو حسبت","https://www.aldiwan.net/poem16081.html","أحذ الكامل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"ولقد نزلت من الجزيرة منزلاً","https://www.aldiwan.net/poem3551.html","عموديه"],[468,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[475,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[556,"ولقد شهدت قبالة الأقصى الذي","https://www.aldiwan.net/poem33495.html","عموديه"],[584,"يا ذا الذي يروي الحدي","https://www.aldiwan.net/poem17753.html","مجزوء الكامل"]],"verses":[["وَلَقَد شَقَقتُ حَشى الزَمانِ فَلَم يَكُن","فيهِ سِوى سِرَّ النَوى إِضمارُ",0,"ر",1,0],["وَلَقَد شَهِدتُ الخَيلَ دامِيَةً","تَختالُ في أَعطافِها السُمرُ",1,"ر",1,1],["وَلَقَد شَرِبتُ مِنَ المُدامَةِ بَعدَم","رَكَدَ الهَواجِرُ بِالمَشوفِ المُعلَمِ",2,"م",1,0],["وَلَقَد شَفى نَفسي وَأَذهَبَ سُقمَه","قيلُ الفَوارِسِ وَيكَ عَنتَرَ أَقدِمِ",2,"م",1,0],["ولقدْ شَجاني بارِقٌ متَأنِّقٌ","يُشْجى بهِ صَبُّ الفؤادِ عَميدُهُ",3,"د",2,0],["وَلَقَد شَهِدتُ التاجِرَ ال","أُمّانَ مَوروداً شَرابُه",4,"ب",2,0],["وَلَقَد شَهِدتُ الجَيشَ تَخ","فِقُ فَوقَ سَيِّدِهِم عُقابُه",4,"ب",2,0],["وَلَقَد شَرِبتُ الراحَ أُس","قى مِن إِناءِ الطَهرَجارَه",5,"ر",2,0],["وَلَقَد شَرِبتُ الخَمرَ تَر","كُضُ حَولَنا تُركٌ وَكابُل",6,"ل",1,0],["وَلَقَد شُبَّتِ الحُروبُ فَما غُم","مِرتَ فيها إِذ قَلَّصَت عَن حِيالِ",7,"ل",1,0],["وَلَقَد شَهِدتُكَ يَومَ قَيسارِيَّةٍ","وَالشَمسُ قَد نَسَجَ القَتامُ لَها رِدا",8,"د",2,0],["وَلَقَد شَكَوتُكِ بِالضَميرِ إِلى الهَوى","وَدَعَوتُ مِن حَنَقٍ عَلَيكِ فَأَمِنّا",9,"ن",2,0],["وَلَقَد شَهِدتُ الخَيلَ تَح","تَ الدارِعينَ تَزُرُّ زَرّا",10,"ر",2,0],["وَلَقَد شَأَتكَ حُمولُها يَومَ اِستَوَت","بِالفُرعِ بَينَ خَفَينَنٍ وَدِعانِ",11,"ن",1,0],["وَلَقَد شَهِدتُ الخَيلَ يَحمِلُ شِكَّتي","مُتَلَمِّظٌ خَذِمُ العِنانِ بَهيمُ",12,"م",1,0],["وَلَقَد شَفَوكَ مِنَ المُكَوّى جَنبُهُ","وَاللَهُ أَنزَلَهُ بِدارِ هَوانِ",13,"ن",1,0],["وَلَقَد شَفَتني خَيلُ قَيسٍ مِنكُمُ","فيها الهُذَيلُ وَمالِكٌ وَعَقيلُ",14,"ل",1,0],["وَلَقَد شَكَرتُ نَوالَكُم وَبَلاكُمُ","إِن كانَ عِندَكَ نافِعاً شُكري",15,"ر",2,0],["وَلَقَد شَرِبتُ الخَمرَ في حانوتِها","صَهباءَ صافِيَةً كَطَعمِ الفُلفُلِ",16,"ل",1,0],["وَلَقَد شَفى الرَحمَنُ مِنّا سَيِّداً","وَأَهانَ قَوماً قاتَلوهُ وَصُرِّعوا",17,"ع",3,0],["ولقد شهدنك راكباً","فوق الغِلاظ من الغراملْ",18,"ل",1,0],["وَلَقَد شَرِبتُ الخَمرَ في حانوتِها","وَلَعِبتُ بِالقَيناتِ عَفَّ المَلعَبِ",19,"ب",1,0],["وَلَقَد شَفَيتَ غَليلَتي مِن مَعشَرٍ","نَزَلوا بِعَقوَةِ حَيَّةٍ قَتّالِ",20,"ل",1,0],["وَلَقَد شَرِبتُ الخَمرَ في حانوتِها","وَشَرِبتُها بِأَريضَةٍ مِحلالِ",20,"ل",1,0],["وَلَقَد شَدَدتَ عَلى المَراغَةِ سَرجَها","حَتّى نَزَعتَ وَأَنتَ غَيرُ مُجيدِ",21,"د",1,0],["وَلَقَد شَهِدتُ صِغارَهُ في حَيرَةٍ","مِن أَمرِهِم لَهَفي عَلى الأَشبالِ",22,"ل",1,0],["وَلَقَد شَكَرتُ وَإِنَّما إِحسانُهُ","مُتَقَدِّمٌ وَالفَضلُ لِلمُتَقَدِّمِ",23,"م",1,0],["وَلَقَد شَربتُ الراح يَسطَعُ نُورُها","وَاللَيلُ قَد مَدَّ الظَلامَ رِداءَ",24,"ا",2,1],["ولقد شجت خلف الظغائن نسوة","بملأن أجواز الفضاء عويلا",25,"ل",2,0],["ولقد شجتني النائحات عشية","يبكين نابغة كريم المحتد",26,"د",1,0],["ولقد شجت خلف الضعائن نسوة","يملأن اجواز الفضاء عويلا",27,"ل",2,0],["ولقد شبّت ثم لم تخب حتى","خفت ان تملأ الفضاء حريقا",28,"ق",2,0],["وَلَقَد شَرِبتِ بِحادِثٍ يا طالَما","شَرِبَت بَناتُ العالَمينَ بِصابِه",29,"ب",2,0],["وَلَقَد شَجاها الغائِبونَ وَراعَها","ما حَلَّ بِالبَيتِ المُضيءِ المُظلِمِ",30,"م",1,0],["وَلَقَد شَكَرتُ قَديمَ ما خَوَّلتَني","وَالحَزمُ أَجمَعُ أَن يُزادَ الشاكِرُ",31,"ر",1,0],["وَلَقَد شَرِبتُ بِطارِفي وَبِتالِدي","وَسَبَأتُها بِكراً بِغَيرِ مِكاسِ",32,"س",1,0],["وَلَقَد شَدَدتُ إِذا الهُمومُ تَضَيَّفَت","رَحلي بِكورِ عُذافِرٍ جِرفاسِ",32,"س",1,0],["وَلَقَد شَرِبتُ الكَأسَ مِن يَدِ أَحوَرٍ","مِثلِ القَضيبِ مُهَفهَفٍ مَيّاسِ",33,"س",1,0],["ولقد شَجاني أن يُقَوَّضَ مَجْلِسٌ","فيه الحِجَى والعِلْمُ والأحلام",34,"م",1,0],["ولقد شأوتُ الريح فيه مُسَابقاً","من بعد ما أمسكتُ فضْل عِناني",35,"ن",2,0],["وَلَقَد شَدَدتَ على خِناقِ علوجِهِم","وَأَدارَ رأيَكَ فيهِمُ مُستَبصِرُ",36,"ر",1,0],["وَلَقَد شَفى الأَحشاءَ مِن بُرَحائِها","أَن صارَ بابَكُ جارَ ما زَيّارِ",37,"ر",1,0],["وَلَقَد شَمَلتَ الحَضرَتَينِ بِنِعمَةٍ","يَجري الثَناءُ بِوَصفِها فَيُطيلُ",38,"ل",1,0],["وَلَقَد شَهِدتُ الحَربَ تَلمَعُ بيضُها","وَرَأَيتُ مِن غولِ المَنايا أَوجُها",39,"ه",2,0],["ولقد شهِدتَ الحرْبَ فيها يافِعاً","إذ لا بنفسِكَ غيرُ نفسكَ صائل",40,"ل",1,0],["وَلَقَد شَقَّ عَلَيَّ ال","حُبُّ ما شا أَن يَشُقّا",41,"ق",2,0],["وَلَقَد شَرِبتُ رُضابَهُنَّ عَلى الصَدا","وَعَلى الصَبابَةِ وُدَّهُنَّ بَرودا",42,"د",2,0],["ولقد شرِكتُكَ في أساكَ مُشاطِراً","وحَللتُ في وادي الهمومِ وخَبتِها",43,"ت",3,0],["وَلَقَد شَهِدتُ الخَيلَ وَهيَ مُغيرَةٌ","وَلَقَد طَعَنتُ مَجامِعَ الرَبِلاتِ",44,"ت",1,1],["وَلَقَد شَبَبنا بِالجِفارِ لِدارِمٍ","ناراً بِها طَيرُ الأَشائِمِ يَنعَبُ",45,"ب",1,0],["وَلَقَد شَهِدتُ عُكاظَ قَبلَ مَحَلِّها","فِيها وَكُنتُ أُعَدُّ مِنَ الفِتيانِ",46,"ن",1,0],["وَلَقَد شَرِبتُ مِنَ المُدامَةِ بَعدَما","رَكَدَ الهَواجِرُ بِالمَشوفِ المُعلَمِ",47,"م",1,0],["وَلَقَد شَفى نَفسي وَأَذهَبَ سُقمَها","قيلُ الفَوارِسِ وَيكَ عَنتَرَ أَقدِمِ",47,"م",1,0],["ولَقَد شَرِبتُ الَخمرَ أُسقَى صِرفَها","بالخوعِ بَينَ قُطَيَّةٍ ومُرَوَّدِ",48,"د",1,1],["وَلَقَدْ شَهِدْتُ الْحَرْبَ في إِبَّانِهَا","وَلَبِئْسَ رَاعِي الْحَيِّ إِنْ لَمْ أَشْهَدِ",49,"د",1,0],["وَلَقَدْ شَرِبْتُ الْخَمْرَ بَيْنَ غَطارِفٍ","شُمِّ الْمَعَاطِسِ كَالْغُصُونِ الْمُيَّدِ",49,"د",1,0],["وَلَقَدْ شَكَرْتُ بِمَا اسْتَطعْتُ وَحاجَتِي","مَا دُمْتُ حَيّاً أَنْ أَعُوْدَ فَأَشْكُرَا",50,"ر",2,0],["ولقد شجاني بارق متألق","يشجى به صب الفؤاد عميده",51,"د",2,0],["ولقد شجتني عَبرةٌ رَقراقةٌ","حَيرانةٌ في العين عند دُخوله",52,"ل",2,0],["ولقد شجاني أن ترى في مأتم","أمَّ الخلائف مرقد الأسياد",53,"د",1,0],["وَلَقَدْ شكَرْتُ قَديمَ ما خوْلتيَني،","وَالحَزْمُ أجمَعُ أن يُزَادَ الشّاكرُ",54,"ر",1,0],["ولقدْ شهدتُ الخيلَ يحملُ شكَّتي","متلمِّظٌ حذمَ العنانِ بهيمُ",55,"م",1,0],["ولقدْ شربتُ الخمرَ في حانوتها","ولعبتُ بالقانياتِ كلّ الملعبِ",56,"ب",1,0],["ولقد شفى نفسي وأبرأ سُقمها","قيلُ الفوارس ويكَ عنتر أقدم",57,"م",1,0],["وَ لقدْ شفيت النفسَ منْ سرواتهمْ","بالسيفِ في يومِ الذنيبِ الأغبسِ",58,"س",1,0],["ولقد شكرت إلهي حيث يولني","نعماً ويدرأ غيرها متألما",59,"م",2,0],["ولقد شغلتَ عيونَنا وقلوبنا","مُذْ هِمتَ بالهمَلانِ والخفقَانِ",60,"ن",1,0],["ولقد شددتَ وَثَاقَ كلِّ مُلَّمةٍ","يُلوَى عليها مُبَرمٌ وسحيلُ",61,"ل",1,0],["وَلَقَد شُغِلتَ بِمَنعِ ثَغرٍ طارِقٍ","عَمّا دَعاكَ إِلَيهِ ثَغرٌ أَشنَبُ",62,"ب",1,0],["وَلَقَد شاعَ مِن تَمَلُّكِكَ الأَم","رِ حَديثٌ بِنا إِلَيهِ أُوامُ",63,"م",1,0],["وَلَقَد شَفَعتَ الحَجَّ بِالغَزوِ الَّذي","لَولاكَ أَعجَزَ أَهلَهُ إِمكانُهُ",64,"ن",2,0],["ولقد شكوت فكاد يأكل بعضهم","بعضاً ويفترس الكبير الأَصغرا",65,"ر",2,0],["وَلَقَد شَكَرتُ لَكَ الَّذي أَولَيتَني","وَرَضيتَ مَنزِلَتي فَأَينَ أَزولُ",66,"ل",1,0],["ولقد شفتي العواذلُ حتى","خلتُ عمري مابينَ يومي وامسي",67,"ي",1,0],["ولقد شكوت هواه لو","أشكو هواه إلى رحيم",68,"م",1,0],["ولقد شكا القصر الذي خلَّفته","من ليلةٍ ما يشتكي المهجور",69,"ر",1,0],["ولقد شكا يوم الحديبية الصدى","جيش فتاه صريخهم لا يوهط",70,"ط",1,0],["وَلَقَد شَكَوتُ إِلى النَسيم صَبابَتي","لَمّا سَرَت مِسكِيَّة الأَردانِ",71,"ن",1,0],["وَلَقَد شَرِبتُ مِنَ المُدا","مَةِ بِالصَغيرِ وَبِالكَبيرِ",72,"ر",1,0],["وَلَقَد شَرِبتُ الخَمرَ بِال","خَيلِ الإِناثِ وَبِالذُكورِ",72,"ر",1,0],["وَلَقَد شَرِبتُ الخَمرَ بِال","عَبدِ الصَحيحِ وَبِالأَسيرِ",72,"ر",1,0],["ولقد شكا لك من حوادث دَهرهِ","سُقماً وَلستُ بعاجزٍ عن طبِّهِ",73,"ب",2,0],["وَلَقَدْ شَفَى إِقْبَالُهَا مَا شَفَّه","فَاعْتَاضَ مِنْ شَكْواه بِالإبْلالِ",74,"ل",1,0],["وَلَقَد شَهدتُ الخَيلَ تَحملُ شكتي","عَتَدٌ أُمِر مِن السَّوابِحِ هَيكَلُ",75,"ل",1,1],["وَلَقَد شَهِدتُ البَرقَ برق تَهامَةٍ","يَهدي المَقانِبَ راكِبُ العِيّارِ",76,"ر",1,1],["وَلَقَد شَرِبناها بِخاتَمِ رَبِّها","بِكراً وَلَيسَ مِثلَ الأَيَّمِ",77,"م",1,0],["وَلَقَد شَقيتُ بِخَوفِهِ وَحَرامِهِ","فَمَتى أَلَذُّ بِأَمنِهِ وَحَلالِهِ",78,"ل",2,0],["ولقد شجاني صوت صادحة","غنت على الأغصان بالشعب",79,"ب",1,0],["وَلَقَد شَجاكَ الظاعِنونَ وَلَم تَزَل","يَشجو فؤادك باكِر الإِظعانِ",80,"ن",1,0],["ولقد شملت المسلمين بنعمةٍ","كُفَّار نعمةِ ربِّها كُفَّارها",81,"ر",3,0],["ولقد شَرَيتُ هواهم","بالرُّوح قبل اليوم نقدا",82,"د",2,0],["ولقد شداني العزمُ سرْ تلقَ المُنى","فشدا له الإمكانُ دونك تمرُجِ",83,"ج",1,0],["ولقد شكرت صنيع دهري عالما","إن الزمان له عليّ ذمام",84,"م",1,0],["ولقد شافَهَتْ سيوفَ عدَاهُ","لَوْ كفاها بِهَا شمَلتَ عِدَاها",85,"ا",3,0],["ولقد شرقت بمدمعي لفراقكم","والحب أفطرني بكم وأضامني",86,"ن",2,0],["ولقد شكوْتُ الأمس قبل غَدٍ","وأتى غَدٌ فشكرْتُ للأمسِ",87,"س",1,0],["ولقد شفى نفسي وسكّن روعها","ثقتي بعفو الله والتوحيدِ",88,"د",1,0],["ولقد شقيت بوصل خودك ليلة","طالت فكان ظلامها لا ينفدُ",89,"د",1,0],["وَلَقَد شَكَوتُ إِلَيكَ بَعضَ صَبابَتي","وَلما كَتَمتُ مِن الصَبابَةِ أَطوَلُ",90,"ل",1,0],["ولقد شكرتُ الطيفَ لما زارني","بعدَ الهُدُوِّ وحَقُّهُ أن يُشكَرا",91,"ر",2,0],["ولَقد شَفى يومُ الغديرِ مَعاشراً","ثَلِجَتْ نفوسُهُمُ وأدوى معشرا",92,"ر",2,0],["ولقد شهدتُ قِبالة الأقصى الذي","وردَت إليه بنا كبار مواردِ",93,"د",1,1],["وَلقدْ شَربْتُ حَبابَها","في عِقْدِ كَاسَاتِ النَّظيمِ",94,"م",1,0]]}