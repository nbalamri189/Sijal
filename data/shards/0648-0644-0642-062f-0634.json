s://www.poetsgate.com/ViewPoem.aspx?id=121939",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5190,"يا صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=123994",""],[5358,"زينب","https://www.poetsgate.com/ViewPoem.aspx?id=211959",""],[5376,"لقد استبحتم أرضنا وسماءنا","https://www.poetsgate.com/ViewPoem.aspx?id=190448",""],[5409,"ذكرت صباً لها كان وفياً","https://www.poetsgate.com/ViewPoem.aspx?id=155366",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5612,"رسالة إلى عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=197096",""],[5725,"سلافة الخد","https://www.poetsgate.com/ViewPoem.aspx?id=201281",""],[5790,"ومهفهفٍ ماس القضيب وقده","https://www.poetsgate.com/ViewPoem.aspx?id=112146",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5943,"مفتاحُ السَّعادةِ","https://www.poetsgate.com/ViewPoem.aspx?id=92980",""],[5991,"ولقد شهدت جماله في ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=116388",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""]],"verses":[["وَلَقَد شَقَقتُ حَشى الزَمانِ فَلَم يَكُن","فيهِ سِوى سِرَّ النَوى إِضمارُ",0,"ر",1,0],["وَلَقَد شَهِدتُ الخَيلَ دامِيَةً","تَختالُ في أَعطافِها السُمرُ",1,"ر",1,1],["وَلَقَد شَرِبتُ مِنَ المُدامَةِ بَعدَم","رَكَدَ الهَواجِرُ بِالمَشوفِ المُعلَمِ",2,"م",1,0],["وَلَقَد شَفى نَفسي وَأَذهَبَ سُقمَه","قيلُ الفَوارِسِ وَيكَ عَنتَرَ أَقدِمِ",2,"م",1,0],["ولقدْ شَجاني بارِقٌ متَأنِّقٌ","يُشْجى بهِ صَبُّ الفؤادِ عَميدُهُ",3,"د",2,0],["وَلَقَد شَهِدتُ التاجِرَ ال","أُمّانَ مَوروداً شَرابُه",4,"ب",2,0],["وَلَقَد شَهِدتُ الجَيشَ تَخ","فِقُ فَوقَ سَيِّدِهِم عُقابُه",4,"ب",2,0],["وَلَقَد شَرِبتُ الراحَ أُس","قى مِن إِناءِ الطَهرَجارَه",5,"ر",2,0],["وَلَقَد شَرِبتُ الخَمرَ تَر","كُضُ حَولَنا تُركٌ وَكابُل",6,"ل",1,0],["وَلَقَد شُبَّتِ الحُروبُ فَما غُم","مِرتَ فيها إِذ قَلَّصَت عَن حِيالِ",7,"ل",1,0],["وَلَقَد شَهِدتُكَ يَومَ قَيسارِيَّةٍ","وَالشَمسُ قَد نَسَجَ القَتامُ لَها رِدا",8,"د",2,0],["وَلَقَد شَكَوتُكِ بِالضَميرِ إِلى الهَوى","وَدَعَوتُ مِن حَنَقٍ عَلَيكِ فَأَمِنّا",9,"ن",2,0],["وَلَقَد شَهِدتُ الخَيلَ تَح","تَ الدارِعينَ تَزُرُّ زَرّا",10,"ر",2,0],["وَلَقَد شَأَتكَ حُمولُها يَومَ اِستَوَت","بِالفُرعِ بَينَ خَفَينَنٍ وَدِعانِ",11,"ن",1,0],["وَلَقَد شَهِدتُ الخَيلَ يَحمِلُ شِكَّتي","مُتَلَمِّظٌ خَذِمُ العِنانِ بَهيمُ",12,"م",1,0],["وَلَقَد شَفَوكَ مِنَ المُكَوّى جَنبُهُ","وَاللَهُ أَنزَلَهُ بِدارِ هَوانِ",13,"ن",1,0],["وَلَقَد شَفَتني خَيلُ قَيسٍ مِنكُمُ","فيها الهُذَيلُ وَمالِكٌ وَعَقيلُ",14,"ل",1,0],["وَلَقَد شَكَرتُ نَوالَكُم وَبَلاكُمُ","إِن كانَ عِندَكَ نافِعاً شُكري",15,"ر",2,0],["وَلَقَد شَرِبتُ الخَمرَ في حانوتِها","صَهباءَ صافِيَةً كَطَعمِ الفُلفُلِ",16,"ل",1,0],["وَلَقَد شَفى الرَحمَنُ مِنّا سَيِّداً","وَأَهانَ قَوماً قاتَلوهُ وَصُرِّعوا",17,"ع",3,0],["ولقد شهدنك راكباً","فوق الغِلاظ من الغراملْ",18,"ل",1,0],["وَلَقَد شَرِبتُ الخَمرَ في حانوتِها","وَلَعِبتُ بِالقَيناتِ عَفَّ المَلعَبِ",19,"ب",1,0],["وَلَقَد شَفَيتَ غَليلَتي مِن مَعشَرٍ","نَزَلوا بِعَقوَةِ حَيَّةٍ قَتّالِ",20,"ل",1,0],["وَلَقَد شَرِبتُ الخَمرَ في حانوتِها","وَشَرِبتُها بِأَريضَةٍ مِحلالِ",20,"ل",1,0],["وَلَقَد شَدَدتَ عَلى المَراغَةِ سَرجَها","حَتّى نَزَعتَ وَأَنتَ غَيرُ مُجيدِ",21,"د",1,0],["وَلَقَد شَهِدتُ صِغارَهُ في حَيرَةٍ","مِن أَمرِهِم لَهَفي عَلى الأَشبالِ",22,"ل",1,0],["وَلَقَد شَكَرتُ وَإِنَّما إِحسانُهُ","مُتَقَدِّمٌ وَالفَضلُ لِلمُتَقَدِّمِ",23,"م",1,0],["وَلَقَد شَربتُ الراح يَسطَعُ نُورُها","وَاللَيلُ قَد مَدَّ الظَلامَ رِداءَ",24,"ا",2,1],["ولقد شجت خلف الظغائن نسوة","بملأن أجواز الفضاء عويلا",25,"ل",2,0],["ولقد شجتني النائحات عشية","يبكين نابغة كريم المحتد",26,"د",1,0],["ولقد شجت خلف الضعائن نسوة","يملأن اجواز الفضاء عويلا",27,"ل",2,0],["ولقد شبّت ثم لم تخب حتى","خفت ان تملأ الفضاء حريقا",28,"ق",2,0],["وَلَقَد شَرِبتِ بِحادِثٍ يا طالَما","شَرِبَت بَناتُ العالَمينَ بِصابِه",29,"ب",2,0],["وَلَقَد شَجاها الغائِبونَ وَراعَها","ما حَلَّ بِالبَيتِ المُضيءِ المُظلِمِ",30,"م",1,0],["وَلَقَد شَكَرتُ قَديمَ ما خَوَّلتَني","وَالحَزمُ أَجمَعُ أَن يُزادَ الشاكِرُ",31,"ر",1,0],["وَلَقَد شَرِبتُ بِطارِفي وَبِتالِدي","وَسَبَأتُها بِكراً بِغَيرِ مِكاسِ",32,"س",1,0],["وَلَقَد شَدَدتُ إِذا الهُمومُ تَضَيَّفَت","رَحلي بِكورِ عُذافِرٍ جِرفاسِ",32,"س",1,0],["وَلَقَد شَرِبتُ الكَأسَ مِن يَدِ أَحوَرٍ","مِثلِ القَضيبِ مُهَفهَفٍ مَيّاسِ",33,"س",1,0],["ولقد شَجاني أن يُقَوَّضَ مَجْلِسٌ","فيه الحِجَى والعِلْمُ والأحلام",34,"م",1,0],["وَلَقَد شَفَيتُ النَفسَ مِن سَرَواتِهِم","بِالسَيفِ في يَومِ الذُنَيبِ الأَغبَسِ",35,"س",1,0],["ولقد شأوتُ الريح فيه مُسَابقاً","من بعد ما أمسكتُ فضْل عِناني",36,"ن",2,0],["وَلَقَد شَدَدتَ على خِناقِ علوجِهِم","وَأَدارَ رأيَكَ فيهِمُ مُستَبصِرُ",37,"ر",1,0],["وَلَقَد شَفى الأَحشاءَ مِن بُرَحائِها","أَن صارَ بابَكُ جارَ ما زَيّارِ",38,"ر",1,0],["وَلَقَد شَمَلتَ الحَضرَتَينِ بِنِعمَةٍ","يَجري الثَناءُ بِوَصفِها فَيُطيلُ",39,"ل",1,0],["وَلَقَد شَهِدتُ الحَربَ تَلمَعُ بيضُها","وَرَأَيتُ مِن غولِ المَنايا أَوجُها",40,"ه",2,0],["ولقد شهِدتَ الحرْبَ فيها يافِعاً","إذ لا بنفسِكَ غيرُ نفسكَ صائل",41,"ل",1,0],["وَلَقَد شَقَّ عَلَيَّ ال","حُبُّ ما شا أَن يَشُقّا",42,"ق",2,0],["وَلَقَد شَرِبتُ رُضابَهُنَّ عَلى الصَدا","وَعَلى الصَبابَةِ وُدَّهُنَّ بَرودا",43,"د",2,0],["ولقد شرِكتُكَ في أساكَ مُشاطِراً","وحَللتُ في وادي الهمومِ وخَبتِها",44,"ت",3,0],["وَلَقَد شَهِدتُ الخَيلَ وَهيَ مُغيرَةٌ","وَلَقَد طَعَنتُ مَجامِعَ الرَبِلاتِ",45,"ت",1,1],["وَلَقَد شَبَبنا بِالجِفارِ لِدارِمٍ","ناراً بِها طَيرُ الأَشائِمِ يَنعَبُ",46,"ب",1,0],["وَلَقَد شَهِدتُ عُكاظَ قَبلَ مَحَلِّها","فِيها وَكُنتُ أُعَدُّ مِنَ الفِتيانِ",47,"ن",1,0],["وَلَقَد شَرِبتُ مِنَ المُدامَةِ بَعدَما","رَكَدَ الهَواجِرُ بِالمَشوفِ المُعلَمِ",48,"م",1,0],["وَلَقَد شَفى نَفسي وَأَذهَبَ سُقمَها","قيلُ الفَوارِسِ وَيكَ عَنتَرَ أَقدِمِ",48,"م",1,0],["ولَقَد شَرِبتُ الَخمرَ أُسقَى صِرفَها","بالخوعِ بَينَ قُطَيَّةٍ ومُرَوَّدِ",49,"د",1,1],["وَلَقَدْ شَهِدْتُ الْحَرْبَ في إِبَّانِهَا","وَلَبِئْسَ رَاعِي الْحَيِّ إِنْ لَمْ أَشْهَدِ",50,"د",1,0],["وَلَقَدْ شَرِبْتُ الْخَمْرَ بَيْنَ غَطارِفٍ","شُمِّ الْمَعَاطِسِ كَالْغُصُونِ الْمُيَّدِ",50,"د",1,0],["وَلَقَدْ شَكَرْتُ بِمَا اسْتَطعْتُ وَحاجَتِي","مَا دُمْتُ حَيّاً أَنْ أَعُوْدَ فَأَشْكُرَا",51,"ر",2,0],["ولقد شجاني بارق متألق","يشجى به صب الفؤاد عميده",52,"د",2,0],["ولقد شجتني عَبرةٌ رَقراقةٌ","حَيرانةٌ في العين عند دُخوله",53,"ل",2,0],["ولقد شجاني أن ترى في مأتم","أمَّ الخلائف مرقد الأسياد",54,"د",1,0],["وَلَقَدْ شكَرْتُ قَديمَ ما خوْلتيَني،","وَالحَزْمُ أجمَعُ أن يُزَادَ الشّاكرُ",55,"ر",1,0],["ولقدْ شهدتُ الخيلَ يحملُ شكَّتي","متلمِّظٌ حذمَ العنانِ بهيمُ",56,"م",1,0],["ولقدْ شربتُ الخمرَ في حانوتها","ولعبتُ بالقانياتِ كلّ الملعبِ",57,"ب",1,0],["ولقد شفى نفسي وأبرأ سُقمها","قيلُ الفوارس ويكَ عنتر أقدم",58,"م",1,0],["ولقد شكرت إلهي حيث يولني","نعماً ويدرأ غيرها متألما",59,"م",2,0],["ولقد شغلتَ عيونَنا وقلوبنا","مُذْ هِمتَ بالهمَلانِ والخفقَانِ",60,"ن",1,0],["ولقد شددتَ وَثَاقَ كلِّ مُلَّمةٍ","يُلوَى عليها مُبَرمٌ وسحيلُ",61,"ل",1,0],["وَلَقَد شُغِلتَ بِمَنعِ ثَغرٍ طارِقٍ","عَمّا دَعاكَ إِلَيهِ ثَغرٌ أَشنَبُ",62,"ب",1,0],["وَلَقَد شاعَ مِن تَمَلُّكِكَ الأَم","رِ حَديثٌ بِنا إِلَيهِ أُوامُ",63,"م",1,0],["وَلَقَد شَفَعتَ الحَجَّ بِالغَزوِ الَّذي","لَولاكَ أَعجَزَ أَهلَهُ إِمكانُهُ",64,"ن",2,0],["ولقد شكوت فكاد يأكل بعضهم","بعضاً ويفترس الكبير الأَصغرا",65,"ر",2,0],["وَلَقَد شَكَرتُ لَكَ الَّذي أَولَيتَني","وَرَضيتَ مَنزِلَتي فَأَينَ أَزولُ",66,"ل",1,0],["ولقد شفتي العواذلُ حتى","خلتُ عمري مابينَ يومي وامسي",67,"س",2,0],["ولقد شكوت هواه لو","أشكو هواه إلى رحيم",68,"م",1,0],["ولقد شكا القصر الذي خلَّفته","من ليلةٍ ما يشتكي المهجور",69,"ر",1,0],["ولقد شكا يوم الحديبية الصدى","جيش فتاه صريخهم لا يوهط",70,"ط",1,0],["وَلَقَد شَكَوتُ إِلى النَسيم صَبابَتي","لَمّا سَرَت مِسكِيَّة الأَردانِ",71,"ن",1,0],["وَلَقَد شَرِبتُ مِنَ المُدا","مَةِ بِالصَغيرِ وَبِالكَبيرِ",72,"ر",1,0],["وَلَقَد شَرِبتُ الخَمرَ بِال","خَيلِ الإِناثِ وَبِالذُكورِ",72,"ر",1,0],["وَلَقَد شَرِبتُ الخَمرَ بِال","عَبدِ الصَحيحِ وَبِالأَسيرِ",72,"ر",1,0],["ولقد شكا لك من حوادث دَهرهِ","سُقماً وَلستُ بعاجزٍ عن طبِّهِ",73,"ب",2,0],["وَلَقَدْ شَفَى إِقْبَالُهَا مَا شَفَّه","فَاعْتَاضَ مِن