قصور","https://www.poetsgate.com/ViewPoem.aspx?id=38189",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[5431,"وأوجاعٌ تولّدُ بي الجنونا","https://www.poetsgate.com/ViewPoem.aspx?id=186103",""],[5493,"تاجُ اللغَات","https://www.poetsgate.com/ViewPoem.aspx?id=201747",""],[5525,"الندم","https://www.poetsgate.com/ViewPoem.aspx?id=7280",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["كَأَنَّ الدَمعَ فَوقَ الحَدِّ مِنها","حَبابٌ يَستَديرُ عَلى عُقارِ",0,"ر",1,0],["كَأَنَّ الدُجى وَالفَجرُ يَركَبُ عِقبَه","نَزائِعُ دُهمٍ خَلفَهُنَّ وِرادُ",1,"د",1,0],["كَأَنَّ الدَبى الكُتفانَ يَكسو بُصاقَهُ","عَلابيّ حُرجوج طَويلٍ وَريدُها",2,"د",3,0],["كأن الدِّيات إذا عُلِّقت","مِئوها به الشَّنَقُ الأسفلُ",3,"ل",1,1],["كانَ الدَليلُ لَهُ مِنهُ إِلَيهِ بِهِ","من شاهد الحَقّ في تَنزيلِ فُرقانِ",4,"ن",1,0],["كانَ الدَليلُ لَهُ مِنهُ إِلَيهِ لَهُ","حَقّاً وَجَدناهُ بِل عِلماً بِتِبيانِ",4,"ن",1,0],["كان الدفاع مذلة وجبانة","ليت المداره يوم ذاك نساء",5,"ا",2,0],["كَأَنَّ الدُجى بَحرٌ إِلى النَجمِ صاعِدٌ","كَأَنَّ السَرايا مَوجُهُ المُتَضَرِّبُ",6,"ب",1,0],["كأَنَّ الدُّجى خَطُّ المَجَرَّةِ بَينَنا","وَقَد كُلّلَتْ حافاتُهُ بِبُدورِهِ",7,"ر",2,0],["كأنّ الدّجى من طوله كان جامداً","فلّما تنازعنا التحية ذابا",8,"ب",2,0],["كأنّ الدهرَ محْسنُهُ مُسيءٌ","فما يَجْزي على عملٍ ثوابا",9,"ب",2,0],["كأنّ الدَّهْرَ شَيّبَهُ قديماً","فما زال النجيعُ لهُ خضابا",9,"ب",2,0],["كَأَنَّ الدُنى حُمراً وَسوداً مِنَ الوَغى","جَهَنَّمُ تُحمى لِلعُصاةِ وتوقَدُ",10,"د",1,0],["كانَ الدَمَ المَسفوحَ أَكبَرُ ما بَنوا","وأَجَلُّ ما دَعَموا مِنَ الجُدرانِ",11,"ن",1,0],["كَأَنَّ الدُجى دونَ البِلادِ مُوَكَّلٌ","بِبَمِّ بِجَنبَي كُلِّ عُلوٍ وَمِرزَحِ",12,"ح",1,0],["كَأَنّا لَدَيها بَينَ عِطفَي نَعامَةٍ","جَفا زَورُها عَن مَبرَكٍ وَمَقيلِ",13,"ل",1,0],["كَأَنَّ الدَهرَ صادَفَ مِنكَ ثَأراً","أَوِ اِستَشفى بِهُلكِكَ مِن سَقام",14,"م",1,0],["كانَ الدَنِيَّ فَغالَ الدَهرُ أُلفَتَهُ","وَالدَهرُ يُحدِثُ وَهناً في الجَلاميدٍ",15,"د",1,0],["كَأَنَّ الدُجى زادَت وَما زادَتِ الدُجى","وَلَكِن أَطالَ اللَيلَ هَمٌّ مُبَرِّحُ",16,"ح",1,0],["كَأَنَّ الدارَ حينَ خَلَت رُسومٌ","كَهَذا العَصبِ أَو بَعضِ الكِتابِ",17,"ب",1,0],["كَأَنَّ الدَهرَ بَحرٌ نَحنُ فيهِ","عَلى خَطَرٍ كَرُكّابِ السَفينِ",18,"ن",1,1],["كأنّ الدَّبَى غرْقَى بها غيرَ أعْيُنٍ","إذا رُدّ فيها ناظِرٌ يَسْتَبِينُها",19,"ن",3,0],["كأنّ الدّجى نُوقٌ عَرِقْنَ مِن الوَنَى","وأنْجُمُها فيها قلائِدُ مِن وَدْع",20,"ع",1,0],["كأَنَّ الدُّجَى هَمّي ودَمْعِي نُجُومُهُ","تَحَدَّرَ إِشْفَاقاً لدَهْرِ الأَراذِلِ",21,"ل",1,0],["كأن الدراري حملت ما أبثه","إلى الليل من شكوى الأسى فهي ضلع",22,"ع",1,0],["كأنَّ الدُّهورَ بأطماحِها","إلى خِلقةٍ مِثْلِهِ تَطْمَح",23,"ح",1,0],["كأن الدجى من طوله كان جامداً","فلما تنارعنا التحية ذابا",24,"ب",2,0],["كان الدليل له منه إليه به","مِن شاهدِ الحقّ ِبل عِلماً بِتِبْيان",25,"ن",1,0],["كان الدليل له منه به وله","حقًّا وجدناه في تنزيل فُرقان",25,"ن",1,0],["كَأَنّ الدَّهْرَ يَطْلُبَنِي بِذَحْلِ","فَحَظِّي مِنْهُ إِضْرَاءُ الْخُطُوبِ",26,"ب",1,0],["كأن الدهرَ أليسَ جلدَ هرٍّ","وكلُّ مملكٍ في الناسِ فارُ",27,"ر",1,0],["كَأَنَّ الدُجى مَشعَلٌ في فُؤادي","تَزيّتُه بِالشَقاءِ الحَياةُ",28,"ه",1,0],["كأنّ الدُّروعَ السابِغاتِ عليهمُ","لمِا ألَفوها سُنْدُسٌ وحرير",29,"ر",1,0],["كأنّ الدجَى من لون صُدْغَيه طالِعٌ","وشمسُ الضُّحَى في صَحْن خَدَّيْه تَغْرُبُ",30,"ب",1,0],["كَأَنَّ الدَّرَارِي الشُّهْبَ فِي كَبِدِ السَّمَا","قَوَارِيرُ بَلُّورٍ عَلَى لُجَّةٍ خَضْرَا",31,"ر",2,0],["كأن الدجى فحمٌ سَرى في سَوادِه","من الفَجر نارٌ فاستحالَ إلى جَمرِ",32,"ر",1,0],["كأن الدجى روض اصم نباته","واغصانه حو وازهاره الزهر",33,"ر",1,0],["كَأَنَّ الدَّهْرَ يُحْزِنُهُ سُرُورِي","أَوِ الأَيّامَ يُظْمِئُهُنَّ شُرْبِي",34,"ب",2,0],["كَأَنَّ الدُّجَى لَمْ يَسْرِ فيها نُجومُها","وَلا خُطَّ عَن شَمْسِ النّهارِ نِقابُها",35,"ب",3,0],["كَأَنّ الدُجا وَالفَجر جَيشان أُعمِلَت","عَوامل كُلٍّ مِنهُما وَقواضبُه",36,"ب",2,0],["كَأَنّ الدَراري عقد درٍّ تَبدّدت","فَرائده وَاِستنثر الدُرَّ صاحبُه",36,"ب",2,0],["كأنّ الدُّجى منّي شبابٌ لِمَيْلها","إليَّ به والصُّبحَ في طَرْدِها وَخْط",37,"ط",1,0],["كَأَنَّ الدَهرَ في تَعذيبِ سِرٍّ","لِما يأتيهِ مِن تَعذيبِ سِرّي",38,"ر",2,0],["كأن الدُّجى جيشٌ من الزنج قد أتَى","على هذه الآفاق فابتزَّها غصباً",39,"ب",2,0],["كأنّ الدجى بُرد تعاقد هدبُه","برضوى يمادي عمرَه ويطاولُهْ",40,"ل",2,0],["كأنَّ الدهرَ قامرني عليها","معالَجةً فخانتني القِداحُ",41,"ح",1,0],["كأن الدجى نقع وفي الجو حرمة","كواكبها جند طوائرها رسل",42,"ل",1,0],["كأن الدجى جفن كأن نجومه","على ظهره حليٌ كأنا له نصل",42,"ل",1,0],["كأنّ الدّياجي منهُ سودٌ عَوابسٌ","وأنجمُه بيضُ الحِسانِ الثّواكلِ",43,"ل",1,0],["كأن الدهر يفرح أن يراني","على طول المدى قلق الركاب",44,"ب",1,0],["كأن الدهر يفرح ألا يرضيه إلا","إراقة ماء وجهي في الطلاب",44,"ب",1,0],["كَأَنَّ الدُجى وَالشُهبُ هَمّي","وَنارَهُ إِذا شَبَّ مِنها في الضُلوعِ لَهيبُ",45,"ب",1,0],["كأَنَّ الدُّجَى يَبْكِي لِحاليَ رَحْمةً","فَتِلْكَ النُّجُومُ الزّاهراتُ مَدامِعُ",46,"ع",1,0],["كأن الداء يخشاه فيمضى","إذا لمست يداه يدي سقيم",47,"م",1,0],["كأنّ الدّروعَ البِيضَ والبيضُ فَوقها","غَمائمُ غُرّ أفرَجَت عن بَوارقِ",48,"ق",1,1],["كأنّ الدكاكينَ التي اتصلت بها","صفائحُ كافورٍ تضيءُ وتَسطَعُ",49,"ع",1,0],["كأن الدجى والبرق والزهر ناهد","من الزنج يزهيها فيضحكها العقد",50,"د",1,0],["كأن الدجى والفجر يفتق رتقه","مواطن غي قد أناخ بها الرشد",50,"د",1,0],["كأنَّ الدجى زنجية ونُجُومَها","لآلئ قد نِيطت عليَها فرائدُ",51,"د",1,0],["كأن الدجى روض وزُهْرُ نجومِها","أزاهير والجوزا ليالي لوامعُ",52,"ع",1,0],["كأن الدُجى مِن آل حامدٍ كَتيبة","أَثارَت بهم سامٌ بإِصباحها نقعا",53,"ع",2,0],["كَأَنَّ الدُمى أُشرِبنَ دِرعا أَوانِس","بدونَ لَنا في القَزِّ وَالحَبَراتِ",54,"ت",1,0],["كان الدليلُ على وفاها أنها","أضحت تقابلنا بوجهٍ أبيضِ",55,"ض",1,0],["كَأَنَّ الدّارَ مَكَّةُ وهي أَمْنٌ","لِتِلْكَ الوَحْشِ من سَفْكِ الدِّماءِ",56,"ا",2,0],["كأنَّ الدرّ مرفضّ","إذا أَبدا لنا فاهُ",57,"ا",2,0],["كَأَنَّ الدُّجَى فِي مَجْمَرِ البَرْقِ عَنْبَرٌ","يَضُوعُ شَذَاهُ بَيْنَ نُدْمَانِ شُهْبَانِ",58,"ن",1,0],["كأَنَّ الدجى ملك من الزنج لابسٌ","من الأُفق تاجاً بالكوكبِ رُصّعا",59,"ع",2,0],["كانَ الدليل أقمتموه على الهُدى","علماً يدلُّ على الطريق الأقوم",60,"م",1,0],["كأن الدهر حين يقوم سعدٌ","طروبٌ هز مسمعه صداح",61,"ح",1,0],["كَأَنَّ الدِعصَ يَحمِلُ منه غُصناً","إِذا هَبَّت بِهِ النَكباءُ مالا",62,"ل",2,0],["كأن الدهر جن فليس يدري","أنعلا قد تناول أم عمامه",63,"م",2,0],["كأن الدين بينهم غريب","لقد حرم المرافق والجليسا",64,"س",2,0],["كأن الدهر مطبوع بجهل","فأعدى من يكون له أديب",65,"ب",1,0],["كأن الدهر يطلبني بثأر","فليس يسره إلا وفاتي",66,"ت",2,0],["كَأَنَّ الدُّجى لَمّا تَوَلَّت نُجومُهُ","مُدَبِّرُ حَربٍ قَد هَزَمنا لَهُ صَفّا",67,"ف",2,0],["كأن الدواهي حرة قد تزوجت","بقلبي ولم تبذل لغيري وصالها",68,"ل",3,0],["كأن الدجى سوداء تزهو عقودها","لها البدر شنف والعقود الكواكب",69,"ب",1,0],["كأنّ الدموعَ الواكِفات بذِكرِها","إذا أسلَمَتُهُنَّ الجفونُ فريدُ",70,"د",1,0],["كَأَنَّ الدِيارَ الخالِياتِ عَرائِسٌ","كَواسِدُ قَد أَزرَت بِهِنَّ الضَرائِرُ",71,"ر",1,1],["كَأَنَّ الدُّموعَ ماءُ وَردٍ بِأَوجُهٍ","يُخيَّلنَ مِن حرِّ اللجينِ مَدَاهنا",72,"ن",2,1],["كأن الدهر فتش فاصطفاني","وأمرضني ووظفني لديه",73,"ه",1,0],["كأن الدرب سوداء الأفاعي","سرت ما بين آكام تدُبّ",74,"ب",1,0],["كأنّ الدجى لم تخلق اللَه غيرَهُ","لدَيَّ وأنّ الصبحَ ماليسَ يُخلَق",75,"ق",1,0],["كأنَّ الدموعَ على خَدِّها","بَقِيَّةُ طَلٍّ على جُلَّنارِ",76,"ر",1,0],["كأن الدراري الزاهرات اسنة","لوامع في ليل تخب مقانبه",77,"ب",2,0],["كأن الدياجي وهي مارقة بها","طيالس رهبان تشق وترأب",78,"ب",1,0],["كأن الدجى شاب من حزنه","وما الشيب إلا بياض الفلق",79,"ق",1,0],["كأن الدمَ الجاري بصفحة خدّه","عطارة ورد في عبير وفي مسك",80,"ك",1,0],["كأنَّ الدَّهر أمضى الحكم فينا","بأن لا يستقرَّ لنا قرار",81,"ر",1,0],["كأَنَّ الدهرَ تفضحُه ذُنوبي","فليس سِوى بِعَادي واطرّاحي",82,"ح",2,0],["كأنّ الدُّجى مالت عليهِ كَتيبَةٌ","فنبّه من أهوالِهِ كلَّ نائِمِ",83,"م",1,0],["كأنّ الدُجى منّي تخافُ وتتقي","فكلُّ هواديهِ عليَّ عُيونُ",84,"ن",1,0],["كأنّ الدُجى سلّ زَنْجِيُّهُ","حُساماً علَى أفْقِهِ وانتَضى",85,"ض",2,0],["كأنّ الدُجى والفجْرُ تحت ذُيولِه","مُحجَّلُ أطْرافِ القوائِمِ أدْهَمُ",86,"م",1,0],["كأنّ الدُجى يُلْقَى لديهِ منَ الضُحى","حديثٌ إذا أوضَحْتَهُ عادَ مُبْهَما",87,"م",2,0],["كأنّ الدجى لمّا استنارت نجومُهُ","رداءٌ مُوَشّى أو كتابٌ مُنَمَّقُ",88,"ق",1,1],["كَأَنَّ الدَهرَ جُمِّعَ في لَيالٍ","ثَلاثٍ بِتُّهُنَّ بِشَهرَزورِ",89,"ر",1,0],["كَأنّ الدارَ يومَ تكون مِنها","عَلينا حُفرةٌ مُلئَت دُخانا",90,"ن",2,1],["كَأَنّ الدرّ في فيه نَظيمٌ","من المفضال عبدِ اللَه جاني",91,"ن",2,0],["كَأَن الدَراري سَفينٌ تَهادى","كَأن الظَلام بحار تَموج",92,"ج",1,0],["كَأن الدراري في فَضا الأُفق جحفلٌ","كَأَن الثريا بين هاتيك هودج",93,"ج",1,0],["كَأَنّ الدراري في سُراها ذَوابلٌ","هُزِزنَ وَمجراهنَّ عَضبَةُ صمصام",94,"م",1,0],["كأن الدجى هيجاء جرت نجومه","أسنتها والبرق فيها حسامها",95,"م",3,0],["كأن الدراري والثريا أمامها","كتائب مرفوع لهن لواء",96,"ا",2,1],["كأنّ الدم المسفوك بحر كانما","يظلله من ثائر النقع هيدب",97,"ب",1,0],["كأنَّ الدُّجَى وجهُ زنجيَّةٍ","مليحٌ بدا الصبحُ فيه بَرَصْ",98,"ص",1,0],["كَأَنَّ الدُجى بَحرٌ مُسفٌ جَناحَهُ","كَأَنَّكَ فيهِ دُرَّةٌ تَتَوَهَّجُ",99,"ج",1,0],["كأن الدهر لم يأن","له جرح وتعديل",100,"ل",1,0],["كانَّ الدُّجا الْقَى الرِّحالَ بَمامَنٍ","وباتَ وقَدْ اعْيا فَنامَ الى الاخْرى",101,"ر",2,0],["كأنّ الدهر من صبري مغيظ","فليس تغبنّي منه الخطوبُ",102,"ب",1,1],["كأن الدهرَ ألجمنا","على الشفتين إسكاتا",103,"ت",2,0],["كان الدواء سموما في ضمائرنا","فكيف جئنا بداء كي يداوينا",104,"ن",2,0],["كأنَّ الدُّمُوعَ اكتَفَت مِن جفُونِي","لِتُهدِي فُؤَادِي رَحِيبَ الصُّدُوعِ",105,"ع",1,0],["كأنَّ الدّهْرَ غدّارٌ","وأنْتَ الماكِرُ الْجاني",106,"ن",2,0],["كأن الدار لم تك في زوال","ولم تظهر عقيمات الأمور",107,"ر",1,0],["كان الدعاء بطول العمر يعذب لي","وكنت تترع ثغري رغوة اللبن",108,"ن",1,0],["كأن الدراري من خلال غصونها","حبيب يراعى عاشقاً غير مقبل",109,"ل",1,0],["كأن