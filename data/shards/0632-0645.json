dctabudhabi.ae/diwan/poem/42506","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54512","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54654","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141954","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[90,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[54,"زَمني بِمُطَّلبٍ سُقِيتَ زَمانا","https://www.poetsgate.com/ViewPoem.aspx?id=14241",""],[45,"ليالينا بين اللوى فزرود","https://www.poetsgate.com/ViewPoem.aspx?id=31334",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""]],"verses":[["زَمانٌ عَدا العَيُّ أَبناءَهُ","فَأَفصَحُ مِن ناطِقٍ راغِيَه",0,"ي",2,0],["زَمانَ الهَوى ما أَنتَ لي بِزَمانِ","وَلا لَكَ مِن قَلبي أَعَزُّ مَكانِ",1,"ن",1,1],["زَمانُ الأَذى عِش فيهِ تُشجَ بِأَهلِه","وَتُغضِ عَلى ذُلٍّ وَمُت فيهِ تَعظُمِ",2,"م",1,0],["زَمّوا المَطِيَّ وَأَحلَسوا","مِنها عَلى الدُبُرِ الدَوامي",3,"م",2,0],["زَمانُ عُلىً كَزَمامِ الشَبابِ","غَضُّ الجَنى أَو زَمانِ الوِصالِ",4,"ل",1,0],["زِمامُ عُلاً لَو غَيرُهُ رامَ جَرَّهُ","لَساقَ بِهِ حادٍ مِنَ الذُلِّ مُعنِفُ",5,"ف",1,0],["زَمَنٌ يَخِفُّ بِهِ الجَناحُ إِلى الصِبا","لَمّا ظَفِرتُ بِهِ خَفَضتُ جَناحي",6,"ي",1,0],["زِمامي بِكَفِّ الدَهرِ أَتبَعُ خَطوَهُ","وَما الدَهرُ إِلّا مالِكٌ لِلأَزِمَّةِ",7,"ه",1,0],["زمّ المَطايَا وتَخلَّفَني","أسْألُ عنْها الطّلَلَ البَلْقَعا",8,"ع",2,0],["زَمانُكَ أفْراحٌ لدَيْنا وأعْيادُ","فعِيدٌ ونَيْروزٌ سَعيدٌ وميلادُ",9,"د",1,1],["زَمانٌ تُسَخَّرُ فيهِ الرِياحُ","وَيَغدو الجَمادُ بِهِ مُنشِدا",10,"د",2,0],["زَمانَ رِياضُ العَيشِ خُضرٌ نَواضِرٌ","تَرِفَّ وَأَمواهُ السُرورِ جِمامُ",11,"م",1,0],["زَمَنٌ كَمَألوفِ الرَضاعِ","يَشوقُ ذِكراهُ الفَطيم",12,"م",1,0],["زَمَنٌ كَما راقَ السَقيطُ مِنَ النَدى","يَستَنُّ في صَفَحاتِ وَردٍ يانِعِ",13,"ع",1,0],["زَمانٌ كَأَنَّ الفَتى المَسلَمِيَّ","تَكَنَّفَهُ عَدلُهُ فَاِعتَدَل",14,"ل",1,0],["زَمَنِي تَوَلَّى وَالأُولَى","عَمَرُوهُ مِنْ صَحْبِي فَدَعْنِي",15,"ن",2,0],["زُمَرٌ بِهَا اسْتَبَقَ السُّرُورُ وَمَجْمَعٌ","زَاهٍ تَقَرُّ بِحُسنِهِ العَيْنَانِ",16,"ن",1,0],["زُمَرٌ بِلا عَدَدٍ هُجُومُهَا","حَفَّتْ بِرَكْبِكَ وَالوَلاءُ نِظَامُ",17,"م",1,0],["زَمَانٌ سَادَ شَعْبٌ فِيهِ شَعْباً","وَأَنْزَلَهُ بِمَنْزِلَةِ السَّوَامِ",18,"م",1,0],["زَمَني بِمُطَّلِبٍ سُقِيَت زَمانا","ما كُنتَ إِلّا رَوضَةً وَجِبانا",19,"ن",2,1],["زمان أتى من كل قوم بنهضةٍ","سياسية حتى أتت نهضة الكرد",20,"د",1,0],["زمن قد ضحكت فيه العلوم","ونراها اليوم تبكي العَربَا",21,"ب",2,0],["زَماناً يَترُكُ الفَتَياتِ سوداً","وَقَد كانَ المَحاجِرُ غَيرَ سودِ",22,"د",1,0],["زَمانِيَ كُلَّهُ غَضَبٌ وَعَتبُ","وَأَنتَ عَلَيَّ وَالأَيّامُ إِلبُ",23,"ب",1,1],["زمان مضى حلو المراشف والجنى","وعيش تقضى آمن السرب والسرح",24,"ح",1,0],["زمان تولى بالشبيبةِ وانقضى","وفي فيَّ طعمٌ من مجاجته بعدُ",25,"د",1,0],["زمان الصبى يا لهفَ حيران بعده","يظلّ على اللذاتِ في مصر مبعدا",26,"د",2,0],["زمن الأنس قائمٌ بالتهاني","ونوالُ الملكِ المؤيد يسري",27,"ي",1,0],["زمان الصبى والقرب لا نحذر النوى","ولكن نقضي الحال أحلى من التمر",28,"ر",1,0],["زمانُ العيش مبتسمُ الثنايا","ووجهُ الأنس وضَّاح السرور",29,"ر",1,0],["زمان الهوى والفوْدُ أسود حالكٌ","وعصر الصبى والعيش أبيض ناصع",30,"ع",1,0],["زمان لقاً أستغفر الله ليته","تقضَّى ولم أنعم زمانَ تجافي",31,"ي",1,0],["زمان شباب مضيء مضى","بعيشٍ لنا فائزٍ فائق",32,"ق",1,0],["زمانيَ مختارٌ وقصدِي منجحٌ","وراحيَ ريحانٌ وبدريَ مقبل",33,"ل",1,0],["زمان على حكمي تولت هباته","ولكنها ولت فزالت على رغمي",34,"م",2,0],["زمان غوايات الصبابة والصبا","أغرّ بنعماها وألهو بنعمها",35,"م",3,0],["زمان اللهو مبرور الليالي","ووجه الأنس وضَّاح الغمامهْ",36,"م",2,0],["زمن الليل والنهار تلاه","زمنٌ في اللسان والركبتين",37,"ن",1,0],["زمهريرٌ غناؤُها يَدَع المح","رور في مثل حالة المكروزِ",38,"ز",1,0],["زمهريرٌ على الأيور ولكن","هو في حِسِّها كنار الجحيم",39,"م",1,0],["زمَّها عنك ما فعلتَ وما أس","دَيْتَ أيامَ مجدكَ الموسومه",40,"م",2,0],["زمانُه بنداه مُمْرعٌ خَصِبٌ","كأنه من شهور الحول نيسان",41,"ن",1,0],["زَمرتَ فأنت أحذقُ من زُنامٍ","وقد نلقاكَ أحذقَ من بُنان",42,"ن",1,0],["زَمَنَ الشَبابِ رَحَلتَ غَيرَ مُذَمَّمٍ","وَتَرَكتَ لِلحَسَراتِ قَلبي الوالِها",43,"ل",3,0],["زَمانٌ كَقَلبِ الطِفلِ صافٍ وَكَالمُنى","لَذيذٌ وَلَكِن كانَ كَالحِلمِ فانِيا",44,"ي",2,0],["زَمانٌ عَهِدتُ الوَقتَ لي فيهِ واسِعاً","كَما شِئتُ مِن جِدٍّ بِهِ وَمُجونِ",45,"ن",1,0],["زَمَنٌ يَقِلُّ لَهُ البُكاءُ لِفَقدِهِ","وَلَوَ اِنَّ دَمعي دِجلَةٌ وَالنيلُ",46,"ل",1,0],["زُمَرٌ من ملائكِ الملأ الأع","لى يُغنُّونَ في حُنُوٍّ حَنُونِ",47,"ن",1,0],["زَمان تَنافَسَت في الحَظِّ منهُ","مُلوكٌ تَجور عَلى الدُهور",48,"ر",1,0],["زَمانَ تَراجَعَت عَن جانِبَيهِ","جِيادُ الخَيل بِالمَوتِ المُبيرِ",48,"ر",1,0],["زَماعٌ في اِنقِباضٍ في اِختِيالٍ","كَذَلِكَ كانَ بِسمَركُ النُباتُ",49,"ت",1,0],["زَمَنٌ تَقَضّى لِلهَوى","وَلَنا بِظِلِّكَ هَل يَعود",50,"د",1,0],["زَمانُ الفَردِ يا فِرعَونُ وَلّى","وَدالَت دَولَةُ المُتَجَبِّرينا",51,"ن",2,0],["زَمَنُ المَخاوِفِ كانَ فيهِ جَنابُهُم","حَرَمَ الأَمانِ وَكانَ ظِلُّهُمُ الذَرا",52,"ر",2,0],["زمُّوا جِمالَهُمُ وبدَّدَ شْملَهُمْ","بينٌ ولم يرعَ المقيمَ الراحلُ",53,"ل",1,1],["زمَّ الممالكَ أوّليّتَه","حتى أقامَ قناتَها الدوَلُ",54,"ل",1,0],["زَمانَ تَهاوى الناسُ في لَيلِ فِتنَةٍ","رَبوضِ النَواحي مُدلَهِمِّ الغَياهِبِ",55,"ب",1,0],["زَمَناً ما أَعاضَ مَذمومُهُ الآ","تي بَديلاً نَرضاهُ مِن مَحمودِه",56,"د",2,0],["زَمانُ وِصالٍ لَم يُرَنَّق صَفاؤُهُ","بِهَجرٍ وَلَم يَسنَح لَنا بِصُدودِ",57,"د",1,0],["زَمَنٌ تَلعَبُ بي أَحداثُهُ","لَعِبَ النَكباءِ بِالرُمحِ الخَطِل",58,"ل",1,0],["زِمامُ الَّتي تَخشى مَعَدٌّ وَغَيرُها","إِذا ما أَبى أَن يَستَقيمَ هُمامُها",59,"م",3,0],["زمانٌ تملَّيْتُه مُقبِلاً","وعَيشٌ تلقَّيتُهُ مُسْفِرا",60,"ر",2,0],["زُمَرٌ أَضاءَت لِلحِسابِ وُجوهُها","فَلَها بَريقٌ عِندَهُ وَتَلالي",61,"ل",2,0],["زَمَنٌ مَكاسِبُ أَهلِهِ مَدخولَةٌ","دَخَلاً فُروعُ أُصولِهِ الآثامُ",62,"م",1,0],["زَمَنٌ تَحامى المَكرُماتِ سَراتُهُ","حَتّى كَأَنَّ المَكرُماتِ حَرامُ",62,"م",1,0],["زَمَنٌ هَوَت أَعلامُهُ وَتَقَطَّعَت","قِطَعاً فَلَيسَ لِأَهلِهِ أَعلامُ",62,"م",1,0],["زَمَنٌ لَو رَنا إِلَينا بِخَطبٍ","لَغَزَونا جَيشَ الخُطوبِ بِغازِ",63,"ز",1,0],["زمانُ الرَبيعِ","شَبابُ الزَمانِ",64,"ن",1,1],["زمني ضاع وما أنصفتني","زاديَ الأول كالزاد الأخير",65,"ر",1,0],["زمانٌ لا يفارقني عذابي","ولازمني الشقاء به كظلّي",66,"ل",2,0],["زَمانُكَ لا يَنفَكُّ يَفتَرِسُ العدى","كذي لِبْدَةٍ مُسْتَعْظَمِ النابِ وَالظفرِ",67,"ر",1,0],["زمرُّدٌ في عقيق","في عاجةٍ في أديمِ",68,"م",1,0],["زمنٌ قطعناهُ وكنّا صبْيةً","لا يسألونَ عنِ السوادِ المقبلِ",69,"ل",1,0],["زَمَّت فُؤادي فَهوَ يَتبَعُها","لِلغَورِ إِن غارَت وَلِلجَلسِ",70,"س",1,0],["زُمَراً نَحوَ المُصَلّى","مُسرِعاتٍ في خَلاءِ",71,"ا",2,0],["زُمَرٌ يُعَدُّ بِها الحَصى مِن كَثرَةٍ","وَلَرُبَّما فَنِيَت بِها الأَعدادُ",72,"د",1,0],["زَمانٌ تَقَضّى غَيرَ عَهدِ مَحاسِنٍ","تَسومُ حَصاةَ القَلبِ أَن تَتَصَدَّعا",73,"ع",2,0],["زَمانٌ تَوَلّى بَينَ كَأسٍ تَليدَةٍ","تُدارُ وَعَيشٍ لِلحَداثَةِ طارِفِ",74,"ف",1,0],["زَمانٌ تَوَلّى بِالمَحاسِنِ عاطِرٌ","تَكادُ لَياليهِ تَسيلُ غَوالِيا",75,"ي",2,0],["زمنٌ تَصدُقُ إن سَمّيتَه","زمنَ الطّاغوتِ أو عصرَ الصَّنَمْ",76,"م",1,0],["زَمانُهُ في اِصطِباحِ","إِذا أَفاقَ تَذَكَّر",77,"ر",1,0],["زَمَنُ الصِبا وَرَدَدتُ كَف","فاً بَعدَهُ وَقَصَرتُ خَطوا",78,"و",2,0],["زَمانَ بَني حَربٍ وَمَروانَ مُمسِكو","أَعِنَّةِ مُلكٍ جائِرِ الحُكمِ غاصِبِ",79,"ب",1,0],["زَمَنٌ مَرَّ قَد مَضى بِنَعيمٍ","وَصَباحٌ أَسَرَّنا في مَساءِ",80,"ا",2,0],["زَمَنٌ أنت يا أبا الجعرِ فيهِ","ليس من تالِدٍ ولا من طَريف",81,"ف",1,0],["زُمَّت بِمَشزورِ المِرَر","لامٍ كَحُلقومِ النَغَر",82,"ر",1,0],["زَمانٌ يُخاطِبُ أَبناءَهُ","جِهاراً وَقَد جَهَلوا ما عَنى",83,"ن",2,0],["زَمانٌ حَباكَ قَليلَ العَطاءِ","ما زالَ يُكثِرُ أَخذَ المُهَج",84,"ج",1,0],["زَمَرَت رُبدُها وَغَنَّت بِها الوُر","قُ وَلا حَوبَ في غِناءٍ وَزَمرِ",85,"ر",1,0],["زَمانُ الغَواني عَصرَ جِسمَكَ زائِدٌ","وَهُنَّ عَناءٌ بَعدَ أَن يَقِفَ الجِسمُ",86,"م",1,0],["زَمَمتُ المَطايا لِلوَجيفِ وَلَم تَكُن","تُنالُ المَعالي بِالمَطِيِّ المُزَمَّمِ",87,"م",1,0],["زَمانٌ لا يَنالُ بَنوهُ خَيراً","إِذا لَم يَلحَظوهُ مِنَ التَمَنّي",88,"ي",1,0],["زمانَ تَوَلّتْ وأدَ حَوّاءَ بِنتِها","وكم وأدَتْ في إثْرِ حَوّاء مِن قَرْنِ",89,"ن",1,0],["زَمَانَ قَرَوْا بالمَشْرَفيّ ضُيوفَهُمْ","مَآلِكَ قَوْمٍ والكُماةُ صِيامُ",90,"م",1,0],["زَماناً مِنَ الدَهرِ ثُمَّ التَوى","فَعادَ إِلى صُفرَةٍ فاِنكَسَر",91,"ر",1,0],["زَمِيرُ الهَبانِيقِ فِي زَمخَرٍ","مَجُوفٍ إِذا ما ارتَجَسنَ ارتِجَاسا",92,"س",2,1],["زَمانٌ كانَ فِيهِ الرُّشْدُ غَيّاً","وكانَ الغَيُّ فِيهِ مِنَ الرَّشادِ",93,"د",1,0],["زمانكمو جَارحٌ لا يعِفُّ","رأيتُ الضعيفَ به لا يوالى",94,"ل",2,0],["زَمَنٌ قَضَى ثُمَّ انْقَضَى فكأَنه","حُلُمٌ قَرأْتُ المَوْتَ في تَفْسِيرِه",95,"ر",2,0],["زَمَانٌ تَوَلَّىغَيْرَ أَعْقَابِ ذُكْرَةٍ","إِذَا خَطَرَتْ كَادَتْ لَهَا النَّفْسُ تُنْزَعُ",96,"ع",1,0],["زَمْزِمِي الْكَأْسَ وَهَاتِي","واسْقِنِيهَا يا مَهاتِي",97,"ي",1,1],["زَمَانٌ كُلَّما لاحَتْ بِفِكْرِي","مَخَايِلُهُ بَكَيْتُ لِفَرْطِ ما بِي",98,"ب",2,0],["زَمَانٌ قَضَيْنَا المَجْدَ فِيهِ حُقُوقَهُ","وَلَمْ نَلْهُ عَنْ لَهْوٍ وَرَشْفِ رَُضَابِ",99,"ب",1,0],["زَمْزَمٌ أَسْرَتْ إِسْرَاءَ يُمْنِ","تُغْرِي الدَّيَاجِيرَ بِالضِّياءِ",100,"ا",2,1],["زَمَنٌ خَطَّ بِهِ آ","باؤُكُمْ سَفَراً مُجِيدا",101,"د",2,0],["زَمَانٌ شَاعَ حُبُّ النَّفْعِ فِيهِ","فَمَا الإِتْجَارُ بِالأَمْرِ الغَرِيبِ",102,"ب",1,0],["زمن به تشقي الفضائل أهلها","ألصدق يقتل والمرؤة تعدم",103,"م",1,0],["زَمانُ الصِبا لِلَّهِ دَرُّكَ لَم تَزَل","مَواعيدُ مَن نَهوى لَنا فيكَ تُنجَزُ",104,"ز",1,0],