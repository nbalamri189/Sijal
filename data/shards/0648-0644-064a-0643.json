عت الوصالا","https://www.aldiwan.net/poem65574.html","البسيط"],[80,"وجدت الحلم ينصرني على من","https://www.aldiwan.net/poem31297.html","الوافر"],[44,"وراءك عن شاك قليل العوائد","https://www.aldiwan.net/poem30605.html","الطويل"],[31,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[33,"فيا قلب مت حزنا ولا تك جازعا","https://www.aldiwan.net/poem25952.html","الطويل"],[33,"ولي كبد مقروحة من يبيعني","https://www.aldiwan.net/poem25971.html","الطويل"],[105,"أنشروا الآثار واستقصوا السير","https://www.aldiwan.net/poem43071.html","الرمل"],[102,"بين ليلى وسعاد ومنى","https://www.aldiwan.net/poem33048.html","الرمل"],[52,"بكاه على ما في الضمير دليل","https://www.aldiwan.net/poem26735.html","الطويل"],[48,"استعذ من رمضان","https://www.aldiwan.net/poem65312.html","مجزوء الرمل"],[50,"يا خليلي أسعدا","https://www.aldiwan.net/poem63945.html","مجزوء الخفيف"],[50,"أجارتنا لا تجزعي وأنيبي","https://www.aldiwan.net/poem64831.html","الطويل"],[76,"على مثلها من فجعة خانني الصبر","https://www.aldiwan.net/poem39311.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42666","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[33,"فيا قلب مت حزناً ولا تك جازعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14096&r=&rc=32",""],[128,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[128,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[182,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[198,"ومهفهف نبت الشقيق بخده","https://www.aldiwan.net/poem51839.html","الكامل"],[212,"فها مقلتي في السكب زاد عرامها","https://www.aldiwan.net/poem37832.html","الطويل"],[223,"أيكون الهوى ندى وملابا","https://www.aldiwan.net/poem39721.html","الخفيف"],[235,"ألا من لمسجون بغير جناية","https://www.aldiwan.net/poem31758.html","الطويل"],[297,"بكيت أسى لو رد عنك البكا حتفا","https://www.aldiwan.net/poem33216.html","الطويل"],[328,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[328,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[328,"دنياي يا دنياي","https://www.aldiwan.net/poem55040.html","مجزوء الرجز"],[342,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[348,"تعوذت مذ كنت خبر القلوب","https://www.aldiwan.net/poem19907.html","المتقارب"],[353,"راح ساقي الراح يجلو القدحا","https://www.aldiwan.net/poem40540.html","الرمل"],[364,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[364,"محلك سام والعلاء به اعتكف","https://www.aldiwan.net/poem60840.html","الطويل"],[377,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[377,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[380,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[380,"قفوا بالناجيات على زرود","https://www.aldiwan.net/poem49202.html","الوافر"],[403,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[416,"نسيم الصبا أهدى إلى القلب ما أهدى","https://www.aldiwan.net/poem53965.html","الطويل"],[416,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[416,"أمر بها مع الأرواح رند","https://www.aldiwan.net/poem54046.html","الرمل"],[416,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[429,"سلا ظبية الوعساء أين يمينها","https://www.aldiwan.net/poem39912.html","الطويل"],[429,"لعمرك يا أخا الأشواق أنا","https://www.aldiwan.net/poem40258.html","الوافر"],[429,"تجلت لدينا في محاسنها مصر","https://www.aldiwan.net/poem40262.html","الطويل"],[429,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[429,"ألا أيها الخل المودع مغرما","https://www.aldiwan.net/poem41017.html","الطويل"],[441,"أذاب فؤادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[458,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[516,"فإن أك حالكا فالمسك أحوى","https://www.aldiwan.net/poem48742.html","الوافر"],[551,"يا بأبي من زارني في الدجى","https://www.aldiwan.net/poem47710.html","السريع"],[551,"يقولون لي لم أنت بالذل راكد","https://www.aldiwan.net/poem48107.html","الطويل"],[558,"كيف يا قوم يوصف المخلوق","https://www.aldiwan.net/poem34317.html","الخفيف"],[558,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[575,"طرفي عن وجهك لم يطرف","https://www.aldiwan.net/poem2912.html","السريع"],[575,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"]],"verses":[["وَلي كَبِدٌ مِن حُبِّ ظَمياءَ أَصبَحَت","كَذي الجُرحِ يُنكى بَعدَما رَقَأَ الدَمُ",0,"م",1,1],["وَلي كَبِدٌ حَرَّى فَها هِيَ أُلقِيَتْ","إِلَيكَ فَصَدِّعْ كَيفَ شِئتَ وَفَتِّتِ",1,"ت",1,0],["وَلِي كَلِمٌ أَطايِبُ حِيْنَ يَشْدو","رُواةُ السُّوءِ بالْكَلِمِ الخَبيثِ",2,"ث",1,0],["وَلْيُكْثِرِ الْقَوْمُ ذِكْراً فِي مَجَالِسِهِ","مِنَ السِّيَاسَةِ والأَمْثَالِ وَالْحِكَمِ",3,"م",1,0],["وَلي كَبِدٌ قَد بَرَّحَت بي مَريضَةٌ","إِذا سُمتُها الهَجرانَ ظَلَّت تَصَدَّعُ",4,"ع",1,0],["وَليَكْحَلُوا هُدْبَ الجُفُونِ بِإِثْمِدٍ","مِنْ ذَرِّ ذَاكَ المِرْوَدِ النُّورَانِي",5,"ن",2,0],["وَليَكُنْ فَوْزُكَ العَتِيدُ لِمَا يَتْ","لُو مِنَ الفَوْزِ طَالِعاً مَيْمُونَا",6,"ن",2,0],["وَلْيَكُنْ فِي الأَسَى العَمِيمِ عَلَيْهَا","هَيْرُ سَلْوَى لِكُلِّ قَلْبٍ حَزِينِ",7,"ن",1,0],["وَلْيَكنْ حَظ مُنْجِبَيْهَا الْعِظيمَيْنِ","سُعُودٌ تَعْلُو وَعُمْرُ طَوِيلُ",8,"ل",1,0],["ولي كبد تندى إذا ما ذُكرتُمُ","وقلب بنيران الهوى يتضرّمُ",9,"م",1,0],["ولْيَكُن الكرُّ على غِرَّةٍ","والصيدُ في مأمنه ساربُ",10,"ب",1,0],["وَلْيَكْبِت الفُسّاقَ أهلَ الإلحادْ","قد نسخ الإصلاحُ كلَّ إفسادْ",11,"د",1,0],["وليكن الإيقاع في رأسه","من حاذق بالقفد صفّاعِ",12,"ع",1,0],["وليكن من صنعةِ الكو","فيِّ غريد زُبونه",13,"ن",2,0],["وَليَكُ اللَيلُ راهِبي وَشُموعي ال","شُهبُ وَالأَرضُ كُلُّها مِحرابي",14,"ي",1,0],["وَلِيُّكَ إِن يَمثُل فَأَزيَنُ ماثِلٍ","لَدَيكَ وَإِن يَخدُم فَأَنصَحُ خادِمِ",15,"م",1,0],["وَلي كُلَّ يَومٍ فَرحَةٌ في صَباحِهِ","عَسى الوَصلُ في أَثنائِهِ أَن يُقَيَّضا",16,"ض",2,0],["ولي كالخيل إصطبل ولكن","أفارقه وأترك فيه ظلي",17,"ي",1,0],["ولي كَبِدٌ حَرَّى ونَفْسٌ كأنّها","بكَفِّ عَدُوٍّ ما يُريدُ سَرَاحَها",18,"ه",2,1],["ولي كبدٌ من رأيِ همِّتِها النوى","فتُركِبُني من عزمِها المركبَ الوعرا",19,"ر",2,0],["وَليُّكَ اللَهُ لِمْ صيَّرتَني مَثَلاً","كالمُستَجيرِ من الرمضاءِ بالنارِ",20,"ر",1,0],["ولي كَبِدٌ مقروحةٌ وجوانِحٌ","تَحكَّمُ فيهن الحِسانُ الخراعيبُ",21,"ب",1,0],["وَلِيُّكَ دونَ الأَولِياءِ مَحَبَّةً","وَمَولاكَ وَالمَولى الصَريحُ نَسيبُ",22,"ب",1,0],["وَلِيُّكُمُ اللَهُ الَّذي لَم يَزَل لَنا","وَلِيٌّ دُروءٍ عَنكُمُ وَدِفاعِ",23,"ع",1,1],["وَلي كَبِدٌ تَلينُ عَلى التَصابي","وَتَأبى في الهَوى إِلّا اِشتِعالا",24,"ل",2,0],["ولي كَلِمٌ كأنّ اللّفْظَ منها","يَرُشّ السمعَ منه بالسّهامِ",25,"م",1,0],["وَلي كَبِدٌ مَقروحَةٌ لَو أَضاعَها","مِنَ السُقمِ غَيري ما بَغاها بِناشِدِ",26,"د",1,0],["وَليَكُن ذاكَ إِذا ما اِن","تَصَفَ اللَيلُ بَهيما",27,"م",2,0],["وَلي كَبِدٌ حَرّى وَقَلبٌ مُعَذَّبٌ","وَدَمعٌ حَثيثٌ في الهَوى غَيرُ جامِدِ",28,"د",1,0],["وَلي كَبِدٌ مَقروحَةٌ مَن يَبيعُني","بِها كَبِداً لَيسَت بِذاتِ قُروحِ",29,"ح",1,1],["وَليَكُن أَوَّلَ يَومٍ صالِحٍ","مِن حَياةِ المَجدِ فيها وَالخَطَرْ",30,"ر",1,0],["وَليَكُن مَجنون لَيلى وَليَكُن","طيّب القَلب ظَريفاً لَسِنا",31,"ن",2,0],["وَليَكُن مثل أَبيه إِنَّنا","لَم نوفِّر غادة في شعرِنا",31,"ن",2,0],["وَلَي كَبِدٌ أَمسى يُقَطِّعُهُ الهَوى","وَدَمعٌ عَصى الأَجفانَ وَهُوَ يَسيلُ",32,"ل",1,0],["وَليَكُن في كُلِّ يَومٍ","لَكَ فيهِ سَكرَتانِ",33,"ن",1,0],["وَليَكُن ما وَعَدتِني","نَسجَ نيرٍ عَلى سُدى",34,"د",2,0],["وَلي كُلَّ يَومٍ عَبرَةٌ لا أُفيضُها","لِأَحظى بِصَبرٍ أَو بِحَطِّ ذُنوبِ",35,"ب",1,0],["وَلي كَبدٌ مَشطورَةٌ في يَدِ الأَسى","فَتَحْتَ الثَّرى شَطْرٌ وفَوْقَ الثَّرى شَطرُ",36,"ر",1,0],["وليكن في العباب يهدر أموا","جاً على شاطئيك مثل الرعودِ",37,"د",1,0],["وليكنْ في النسيم ما هبَّ سار","يهِ يجوبُ الشطآن نحوكِ جوبا",37,"ب",2,0],["وليكنْ في شتيتِ ما تسمع الأذ","نُ وفيما نراهُ عيناً وقلبا",37,"ب",2,0],["وَليَكُن حَظُّكَ السَّلامَةَ والرُّشد","دَ وخِصباً في الَجدبِ والإِمحالِ",38,"ل",1,0],["وَلْيَكُنْ سَعْيُكَ مَجْداً كُلُّهُ","إِنَّ مَرْعى الشَّرِّ مَكْرُوهٌ أَحَصْ",39,"ص",1,0],["وَلِي كُلُّ مَلْسَاءِ الْمُتُونِ غَرِيبَةٍ","إِذَا أُنْشِدَتْ أَفْضَتْ لِذِكْرِ بَنِي سَعْدِ",40,"د",1,0],["وَليًّ كَانَ بَعَدَ أَبي كَفيلي","عَقَقْتُ جَميلَهُ وَلي الثَبُورُ",41,"ر",1,0],["وليكن بيتُنا بما فيه منهم","لاتكن أنت بعضهم يارفيقي",42,"ق",2,0],["وَلي كَبدٌ حَرّا وَقَلْبٌ مُعّذَّبٌ","ودَمْعٌ حَثِيثٌ في الهَوى غَيْرُ جامِدِ",43,"د",1,0],["وليكن صَمْتُكَ فِكْراً لا تكُنْ","ساكِناً إلا بقلبِ ذِى وَجَلْ",44,"ل",1,0],["ولِى كبدٌ حَرَّى تذوبُ كأنها","على ذَوْبِ مَهْلِ لا تَنِى تَتقطَّعُ",45,"ع",1,0],["وَلي كُلّ يَوم ما يَروعُ فَكَيفَ لا","يَذوبُ فُؤادي لَهفَةً بَينَ أَضلُعي",46,"ع",2,0],["وَلَيَكهَمِ السَيفُ الصَقيلُ فَإِنّما","عَيناهُ تُغني عَن ذَلاقَة حَدِّه",47,"د",2,0],["ولي كَبِدٌ حَرَّى من الوَجْدِ لم تزل","ولي مُهْجَةٌ مِ الشوقِ زادَ هُيامُها",48,"م",3,0],["وَليَكُن يَقظَةً تَسيلُ مَدى الدَه","ر فَتُزكي فينا الحَصى وَالتُرابا",49,"ب",2,0],["وَلِيُّكَ ضامَتهُ اللَيالي وَقَد يُرى","حَراماً عَلى الأَيّامِ وَالدَهرِ ضَيمُهُ",50,"م",2,0],["وَلي كربةٌ قد باينَ الصبرُ لهفَها","فَها أَنا أَنزو في حبائلها رَجفا",51,"ف",2,0],["وليكن نور شمسهم هو هادي","هم إلى نور ربها الصمداني",52,"ي",1,0],["وليكن في اسمه من الخلد معنى","تتمنّى جماله الأسماء",53,"ا",2,0],["ولي كما شاءت","سخرية الأقدار",54,"ر",1,0],["وليكن ثوب حرير","وليكن غير حرير",55,"ر",1,0],["وَلي كَرْمةٌ خَفَّفَتْ حِمْلَها","فَيَا لَيتَني مِثْلُها في الذُّنُوبِ",56,"ب",1,0],["وَليَكُن خَير زَفاف بِالمُنى","بابه اللَه عَلَيهِ فَتحا",57,"ح",2,0],["ولي كلِمٌ مازِلنَ والمجدُ شاهدٌ","قلائدَ أَعناقٍ وأَقراطَ آذان",58,"ن",1,0],["ولي كَبِدٌ منها على النّأي فِلْذَةٌ","إذا ما جرى ذكْرٌ لها عندَه ارتَجَف",59,"ف",1,0],["ولي كل خلٍّ فيه مسرىً ومسرحٌ","وفي كل وادٍ لي على ورده سرح",60,"ح",1,0],["وليكتسِ الثوبَ الذي أَلبستُه","لعروستي أخَويَّتي بحِجائي",61,"ي",1,0],["وليَكُ بالمقال لا اليدَينِ","يحسب الرِّضا من الخصمينِ",62,"ن",1,0],["وَلي كَبد بِذاكَ الجَو جَرى","تَلوب بِهِ مِن الظَمأ الشَديد",63,"د",1,0],["وليكن حال سجود إنه","أقرب الأحوال من رب القدر",64,"ر",1,0],["ولي كَبدٌ حرَّى لعلِّي أرى بها","بريَّا نسيمٍ مرَّ بي سحراً بَردا",65,"د",2,0],["ولي كبِدٌ حرَّى تَودُّ لوَ انَّها","تصادف من ريّ الحبيب بلالا",66,"ل",2,0],["ولي كدموعها عبراتُ جَفْنٍ","لها في وجنتي عكس وطرد",67,"د",1,0],["ولي كبدٌ إلى الأحبابِ حرَّى","فهل تلقى لها يا سعدُ بَردا",68,"د",2,0],["ولي كبد حرّى تئن صبابةً","ولم يجدها إلا التياعاً انينها",69,"ن",3,0],["ولي كبدٌ مضرمةٌ بوجدٍ","قبيل البعد كيف إذا افترقنا",70,"ن",2,0],["ولي كبدٌ تصبو إليها وإن نأت","ولم تأتلف صبراً وإن حمد الصبر",71,"ر",1,0],["وليكن الإرسال بالمقابله","فإنه يأخذهُ بالعاجله",72,"ه",1,0],["ولي كبدٌ حرّى وقلبٌ مولعٌ","فذي خلفكم تجري وذاك يطيرُ",73,"ر",1,0],["ولي كبد حرى إليها متى متى","أقبل خديها لأنقع غلها",74,"ل",3,0],["ولي كلَّ عيدٍ بها وقفةٌ","أناشدُ عَطفَك فيها نشيدا",75,"د",2,0],["وَلي كَرم عَنِ الفَحشاءِ ناءٍ","كَبُعد الأَرضِ من جو السَماءِ",76,"ا",2,0],["ولَّى كأنّ اللّيلَ في وصلِهِ","كسا قميصاً عاد منزوعا",77,"ع",2,0],["وَلي كلُّ داءٍ قاتلٍ ثُمّ لَيس لي","مِنَ الداءِ في كُلِّ الرّجالِ طَبيبُ",78,"ب",1,0],["وَلْيَكُ الفرق ظاهراً بذوات","وشخوص سوى الوجود تروق",79,"ق",1,0],["وليكن ظاهرا بما أنت فيه","ظاهر فهو مادح أو هاجي",80,"ي",1,0],["وَلي كما شاءَ الهَوَى صبوةٌ","مُسْرِفةٌ في حُسْنِكَ المُسْرفِ",81,"ف",1,0],["وليكفك الجورُ فَظَهْري حِمىً","منه لأَني سَاكِنٌ في حِمَاه",82,"ا",2,0]]}