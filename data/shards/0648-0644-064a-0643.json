رة أن تبيني","https://www.poetsgate.com/ViewPoem.aspx?id=36466",""],[402,"يا عائدا برعاية الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=36542",""],[402,"يفسح الراحلون للقادمينا","https://www.poetsgate.com/ViewPoem.aspx?id=36532",""],[5943,"رُبَّ حبٍّ يُرثُ القلبَ العنا","https://www.poetsgate.com/ViewPoem.aspx?id=34707",""],[6068,"ولي كلف وليس بها مثيل -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175926",""],[5309,"إن لم تعظنا الآي والسور","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573556",""]],"verses":[["وَلي كَبِدٌ مِن حُبِّ ظَمياءَ أَصبَحَت","كَذي الجُرحِ يُنكى بَعدَما رَقَأَ الدَمُ",0,"م",1,1],["وَلي كَبِدٌ حَرَّى فَها هِيَ أُلقِيَتْ","إِلَيكَ فَصَدِّعْ كَيفَ شِئتَ وَفَتِّتِ",1,"ت",1,0],["وَلِي كَلِمٌ أَطايِبُ حِيْنَ يَشْدو","رُواةُ السُّوءِ بالْكَلِمِ الخَبيثِ",2,"ث",1,0],["وَلْيُكْثِرِ الْقَوْمُ ذِكْراً فِي مَجَالِسِهِ","مِنَ السِّيَاسَةِ والأَمْثَالِ وَالْحِكَمِ",3,"م",1,0],["وَلي كَبِدٌ قَد بَرَّحَت بي مَريضَةٌ","إِذا سُمتُها الهَجرانَ ظَلَّت تَصَدَّعُ",4,"ع",1,0],["وَليَكْحَلُوا هُدْبَ الجُفُونِ بِإِثْمِدٍ","مِنْ ذَرِّ ذَاكَ المِرْوَدِ النُّورَانِي",5,"ن",2,0],["وَليَكُنْ فَوْزُكَ العَتِيدُ لِمَا يَتْ","لُو مِنَ الفَوْزِ طَالِعاً مَيْمُونَا",6,"ن",2,0],["وَلْيَكُنْ فِي الأَسَى العَمِيمِ عَلَيْهَا","هَيْرُ سَلْوَى لِكُلِّ قَلْبٍ حَزِينِ",7,"ن",1,0],["وَلْيَكنْ حَظ مُنْجِبَيْهَا الْعِظيمَيْنِ","سُعُودٌ تَعْلُو وَعُمْرُ طَوِيلُ",8,"ل",1,0],["ولي كبد تندى إذا ما ذُكرتُمُ","وقلب بنيران الهوى يتضرّمُ",9,"م",1,0],["ولْيَكُن الكرُّ على غِرَّةٍ","والصيدُ في مأمنه ساربُ",10,"ب",1,0],["وَلْيَكْبِت الفُسّاقَ أهلَ الإلحادْ","قد نسخ الإصلاحُ كلَّ إفسادْ",11,"د",1,0],["وليكن الإيقاع في رأسه","من حاذق بالقفد صفّاعِ",12,"ع",1,0],["وليكن من صنعةِ الكو","فيِّ غريد زُبونه",13,"ن",2,0],["وَليَكُ اللَيلُ راهِبي وَشُموعي ال","شُهبُ وَالأَرضُ كُلُّها مِحرابي",14,"ب",2,0],["وَلِيُّكَ إِن يَمثُل فَأَزيَنُ ماثِلٍ","لَدَيكَ وَإِن يَخدُم فَأَنصَحُ خادِمِ",15,"م",1,0],["وَلي كُلَّ يَومٍ فَرحَةٌ في صَباحِهِ","عَسى الوَصلُ في أَثنائِهِ أَن يُقَيَّضا",16,"ض",2,0],["ولي كالخيل إصطبل ولكن","أفارقه وأترك فيه ظلي",17,"ل",2,0],["ولي كَبِدٌ حَرَّى ونَفْسٌ كأنّها","بكَفِّ عَدُوٍّ ما يُريدُ سَرَاحَها",18,"ه",2,1],["ولي كبدٌ من رأيِ همِّتِها النوى","فتُركِبُني من عزمِها المركبَ الوعرا",19,"ر",2,0],["وَليُّكَ اللَهُ لِمْ صيَّرتَني مَثَلاً","كالمُستَجيرِ من الرمضاءِ بالنارِ",20,"ر",1,0],["ولي كَبِدٌ مقروحةٌ وجوانِحٌ","تَحكَّمُ فيهن الحِسانُ الخراعيبُ",21,"ب",1,0],["وَلِيُّكَ دونَ الأَولِياءِ مَحَبَّةً","وَمَولاكَ وَالمَولى الصَريحُ نَسيبُ",22,"ب",1,0],["وَلِيُّكُمُ اللَهُ الَّذي لَم يَزَل لَنا","وَلِيٌّ دُروءٍ عَنكُمُ وَدِفاعِ",23,"ع",1,1],["وَلي كَبِدٌ تَلينُ عَلى التَصابي","وَتَأبى في الهَوى إِلّا اِشتِعالا",24,"ل",2,0],["ولي كَلِمٌ كأنّ اللّفْظَ منها","يَرُشّ السمعَ منه بالسّهامِ",25,"م",1,0],["وَلي كَبِدٌ مَقروحَةٌ لَو أَضاعَها","مِنَ السُقمِ غَيري ما بَغاها بِناشِدِ",26,"د",1,0],["وَليَكُن ذاكَ إِذا ما اِن","تَصَفَ اللَيلُ بَهيما",27,"م",2,0],["وَلي كَبِدٌ حَرّى وَقَلبٌ مُعَذَّبٌ","وَدَمعٌ حَثيثٌ في الهَوى غَيرُ جامِدِ",28,"د",1,0],["وَلي كَبِدٌ مَقروحَةٌ مَن يَبيعُني","بِها كَبِداً لَيسَت بِذاتِ قُروحِ",29,"ح",1,1],["وَليَكُن أَوَّلَ يَومٍ صالِحٍ","مِن حَياةِ المَجدِ فيها وَالخَطَرْ",30,"ر",1,0],["وَليَكُن مَجنون لَيلى وَليَكُن","طيّب القَلب ظَريفاً لَسِنا",31,"ن",2,0],["وَليَكُن مثل أَبيه إِنَّنا","لَم نوفِّر غادة في شعرِنا",31,"ن",2,0],["وَلَي كَبِدٌ أَمسى يُقَطِّعُهُ الهَوى","وَدَمعٌ عَصى الأَجفانَ وَهُوَ يَسيلُ",32,"ل",1,0],["وَليَكُن في كُلِّ يَومٍ","لَكَ فيهِ سَكرَتانِ",33,"ن",1,0],["وَليَكُن ما وَعَدتِني","نَسجَ نيرٍ عَلى سُدى",34,"د",2,0],["وَلي كُلَّ يَومٍ عَبرَةٌ لا أُفيضُها","لِأَحظى بِصَبرٍ أَو بِحَطِّ ذُنوبِ",35,"ب",1,0],["وَلي كَبدٌ مَشطورَةٌ في يَدِ الأَسى","فَتَحْتَ الثَّرى شَطْرٌ وفَوْقَ الثَّرى شَطرُ",36,"ر",1,0],["وليكن في العباب يهدر أموا","جاً على شاطئيك مثل الرعودِ",37,"د",1,0],["وليكنْ في النسيم ما هبَّ سار","يهِ يجوبُ الشطآن نحوكِ جوبا",37,"ب",2,0],["وليكنْ في شتيتِ ما تسمع الأذ","نُ وفيما نراهُ عيناً وقلبا",37,"ب",2,0],["وَليَكُن حَظُّكَ السَّلامَةَ والرُّشد","دَ وخِصباً في الَجدبِ والإِمحالِ",38,"ل",1,0],["وَلْيَكُنْ سَعْيُكَ مَجْداً كُلُّهُ","إِنَّ مَرْعى الشَّرِّ مَكْرُوهٌ أَحَصْ",39,"ص",1,0],["وَلِي كُلُّ مَلْسَاءِ الْمُتُونِ غَرِيبَةٍ","إِذَا أُنْشِدَتْ أَفْضَتْ لِذِكْرِ بَنِي سَعْدِ",40,"د",1,0],["وَليًّ كَانَ بَعَدَ أَبي كَفيلي","عَقَقْتُ جَميلَهُ وَلي الثَبُورُ",41,"ر",1,0],["وليكن لوعة التذكار شبت","فطيرت التشبث في الرنين",42,"ن",1,0],["وليكن بيتُنا بما فيه منهم","لاتكن أنت بعضهم يارفيقي",43,"ق",2,0],["وَلي كَبدٌ حَرّا وَقَلْبٌ مُعّذَّبٌ","ودَمْعٌ حَثِيثٌ في الهَوى غَيْرُ جامِدِ",44,"د",1,0],["وليكن صَمْتُكَ فِكْراً لا تكُنْ","ساكِناً إلا بقلبِ ذِى وَجَلْ",45,"ل",1,0],["ولِى كبدٌ حَرَّى تذوبُ كأنها","على ذَوْبِ مَهْلِ لا تَنِى تَتقطَّعُ",46,"ع",1,0],["وَلي كُلّ يَوم ما يَروعُ فَكَيفَ لا","يَذوبُ فُؤادي لَهفَةً بَينَ أَضلُعي",47,"ع",2,0],["وَلَيَكهَمِ السَيفُ الصَقيلُ فَإِنّما","عَيناهُ تُغني عَن ذَلاقَة حَدِّه",48,"د",2,0],["ولي كَبِدٌ حَرَّى من الوَجْدِ لم تزل","ولي مُهْجَةٌ مِ الشوقِ زادَ هُيامُها",49,"م",3,0],["وَليَكُن يَقظَةً تَسيلُ مَدى الدَه","ر فَتُزكي فينا الحَصى وَالتُرابا",50,"ب",2,0],["وَلِيُّكَ ضامَتهُ اللَيالي وَقَد يُرى","حَراماً عَلى الأَيّامِ وَالدَهرِ ضَيمُهُ",51,"م",2,0],["وَلي كربةٌ قد باينَ الصبرُ لهفَها","فَها أَنا أَنزو في حبائلها رَجفا",52,"ف",2,0],["وليكن نور شمسهم هو هادي","هم إلى نور ربها الصمداني",53,"ن",2,0],["وليكن في اسمه من الخلد معنى","تتمنّى جماله الأسماء",54,"ا",2,0],["ولي كما شاءت","سخرية الأقدار",55,"ر",1,0],["وليكن ثوب حرير","وليكن غير حرير",56,"ر",1,0],["وَلي كَرْمةٌ خَفَّفَتْ حِمْلَها","فَيَا لَيتَني مِثْلُها في الذُّنُوبِ",57,"ب",1,0],["وَليَكُن خَير زَفاف بِالمُنى","بابه اللَه عَلَيهِ فَتحا",58,"ح",2,0],["ولي كلِمٌ مازِلنَ والمجدُ شاهدٌ","قلائدَ أَعناقٍ وأَقراطَ آذان",59,"ن",1,0],["ولي كَبِدٌ منها على النّأي فِلْذَةٌ","إذا ما جرى ذكْرٌ لها عندَه ارتَجَف",60,"ف",1,0],["ولي كل خلٍّ فيه مسرىً ومسرحٌ","وفي كل وادٍ لي على ورده سرح",61,"ح",1,0],["وليكتسِ الثوبَ الذي أَلبستُه","لعروستي أخَويَّتي بحِجائي",62,"ي",1,0],["وليَكُ بالمقال لا اليدَينِ","يحسب الرِّضا من الخصمينِ",63,"ن",1,0],["وَلي كَبد بِذاكَ الجَو جَرى","تَلوب بِهِ مِن الظَمأ الشَديد",64,"د",1,0],["وليكن حال سجود إنه","أقرب الأحوال من رب القدر",65,"ر",1,0],["ولي كَبدٌ حرَّى لعلِّي أرى بها","بريَّا نسيمٍ مرَّ بي سحراً بَردا",66,"د",2,0],["ولي كبِدٌ حرَّى تَودُّ لوَ انَّها","تصادف من ريّ الحبيب بلالا",67,"ل",2,0],["ولي كدموعها عبراتُ جَفْنٍ","لها في وجنتي عكس وطرد",68,"د",1,0],["ولي كبدٌ إلى الأحبابِ حرَّى","فهل تلقى لها يا سعدُ بَردا",69,"د",2,0],["ولي كبد حرّى تئن صبابةً","ولم يجدها إلا التياعاً انينها",70,"ن",3,0],["ولي كبدٌ مضرمةٌ بوجدٍ","قبيل البعد كيف إذا افترقنا",71,"ن",2,0],["ولي كبدٌ تصبو إليها وإن نأت","ولم تأتلف صبراً وإن حمد الصبر",72,"ر",1,0],["وليكن الإرسال بالمقابله","فإنه يأخذهُ بالعاجله",73,"ه",1,0],["ولي كبدٌ حرّى وقلبٌ مولعٌ","فذي خلفكم تجري وذاك يطيرُ",74,"ر",1,0],["ولي كبد حرى إليها متى متى","أقبل خديها لأنقع غلها",75,"ل",3,0],["ولي كلَّ عيدٍ بها وقفةٌ","أناشدُ عَطفَك فيها نشيدا",76,"د",2,0],["وَلي كَرم عَنِ الفَحشاءِ ناءٍ","كَبُعد الأَرضِ من جو السَماءِ",77,"ا",2,0],["ولَّى كأنّ اللّيلَ في وصلِهِ","كسا قميصاً عاد منزوعا",78,"ع",2,0],["وَلي كلُّ داءٍ قاتلٍ ثُمّ لَيس لي","مِنَ الداءِ في كُلِّ الرّجالِ طَبيبُ",79,"ب",1,0],["وَلْيَكُ الفرق ظاهراً بذوات","وشخوص سوى الوجود تروق",80,"ق",1,0],["وليكن ظاهرا بما أنت فيه","ظاهر فهو مادح أو هاجي",81,"ج",2,0],["وَلي كما شاءَ الهَوَى صبوةٌ","مُسْرِفةٌ في حُسْنِكَ المُسْرفِ",82,"ف",1,0],["وليكفك الجورُ فَظَهْري حِمىً","منه لأَني سَاكِنٌ في حِمَاه",83,"ا",2,0],["وليُّكُم بَعدي علي فايقنوا","وقائِعَهُ بعد الوقيعةِ تُسرِعُ",84,"ع",1,0],["وليُّكمُ بَعدي فوالوا وليَّه","وكانوا لمن عادى عدوّاً لمن كَفَرْ",85,"ر",1,0],["وَلي كُتُبٌ عرّبتُها عمّ نَفعُها","بِمصر وَمِنها موجزٌ وَطَويل",86,"ل",1,0],["وَليكن قيدي قبيل الرَفت في","زُمرة الناجين يا عالي المَقام",87,"م",1,0],["وليكنْ صافياً إذا لحظتْهُ ال","عينُ فازتْ منه بحسنِ الصفاء",88,"ا",2,0],["وَلْيَكُن مَهما غَلا فيه حَقيقْ","إِنَّهُ آتٍ بأدنى طَرفِ",89,"ف",1,0],["وَليَكُن اِبتِداء أَكلي في الوَتَر","لأَنَّ فيهِ أَثَرا مِن الزَفَر",90,"ر",1,0],["وَلْيَكُنْ إِنْ شِئْتَ مُكْتَتماً","إِنَّنا مِنْهُمْ عَلَى رَصَدِ",91,"د",1,0],["وليٌّ كريم مستقيمٌ مهذبٌ","قؤولٌ وفعَّال لما اللَّهُ آمره",92,"ر",2,0],["وَلي كِبَدٌ ذَابَتْ عَلَيْهِ صَبَابَةً","وَقَلْبٌ بِنَارِ الشَّوْقِ مِنْ هَجْرِهِ يُكْوى",93,"ك",3,0],["وليكف أن الله سبحانه","أثنى عليكم بالخلال الوسام",94,"م",1,0],["وَلْيَكْفِكُمْ فَخْراً يُمَجَّدُ شَأوُهُ","قَدْ أعْجَزَ الأمثَالَ والأقْرَانَا",95,"ن",2,0],["وليكفيكم شرفا ما في الدهر إن لكم","بأشرف المرسلين العز والطول",96,"ل",1,0],["وليكف أني قد أمنت بمدحه","من سطوة الخطب البهيم الأقتل",97,"ل",1,0],["وَلِي كَبِدٌ حَرَّاءُ فِي أبْحُرِ الجوَى","تَسِيرُ بِهَا سُفْنُ الهَوَى وَمَرَاكِبُهْ",98,"ب",2,0],["وَلْيَكْفِكُمْ مَجْداً بأن لِبَيْتِكُمْ","شَرَفاً يَفُوقُ سنَاه نُورَ النَّيِّرِ",99,"ر",1,0],["ولي كلمات فيه تصدعُ الحصا","إذا حكّموا العضب اليماني أقولها",100,"ل",3,0],["وليكم يا أهل بيت الهدى","في الخلق ذو عز وتمكين",101,"ن",1,0],["وَليَكُن كَالزَمانِ حالاً فحالا","تارةً آسِناً وأخرى معينا",102,"ن",2,0],["وليكفي بأن تسمىّ فلا يبقى","بهاء لغير ما أسماء",103,"ا",2,0],["ولي كلام نحوه","لا مثل نحو العرب",104,"ب",1,0],["وَلي كَبِدٌ أَجِّجَتْ نارُها","بِما أَجْرَتِ الْعَيْنُ مِنْ مائِها",105,"ا",3,0],["وليكتف العشاق من أهل الحما","بمظاهر فيها العيون سواهد",106,"د",1,0],["وليكن منك طول يومك لله","صلاة الى المساء وصوم",107,"م",1,0],["ولي كلَّ يومٍ وقوفٌ على","حمىً وسلامٌ على راحل",108,"ل",1,0],["ولي كبد وقف على الوجد بعدها","ودمع على طول البكاء حبيس",109,"س",1,0],["وَلْيَكُ العدلُ سيفَ فتح وغزوٍ","والأَعادي العقولَ والأَكبا",110,"ب",2,0],["وَلْيَكُ العدلُ حاكماً مستبداً","والأَمانُ الجنودَ والقُوِّادا",110,"د",2,0],["ولي كبد أودعتها في ظلاله","وجسم بأنحاء اللوى لم يزل مضنى",111,"ن",2,0],["وليكن بعد ركعتين لدى ال","بطحاء والبيت فارفض الأشغالا",112,"ل",2,0],["وَلي كَنيفٌ بِحَمدِ اللَهِ يُطرِقُني","أَرواحَ وَأَرى خَيالَ غَيرَ فَتّارِ",113,"ر",1,1],["ولي كبد مقروحة من يبيعني","علاجاً لها من وصل كل مليحِ",114,"ح",1,1],["ولي كبد حرى ونفس عليلة","كليم تولى كلمها البيض كالمها",115,"ه",2,0],["وليكُن حُكمكَ المسَدَّد فيها","حُكمَ سَعدٍ في قَتله لليهودِ",116,"د",1,0],["ولي كُلما نامَت عُيوني فَزعة","لذكراك أَخشى أَن تذوب لَها نَفسي",117,"س",2,0],["وليكثر المزح مع الصحب إذا","لم يسخط اللَه ولم يجلب أذى",118,"ذ",2,0],["وليكن الضيف بذاك راضي","ولا يكلفه بالاستقراض",118,"ض",1,0],["ولَّى كما امرَ الغرامُ وليتَه","قد كان خبَّرنى فولينَا معا",119,"ع",2,0],["وليك قلبك له أفرغَ من","حجّام ساباط ومن لم يعشق",120,"ق",1,0],["وليَّ كخافية الغراب سوادهُ","وبدا كقادمة الحمام مشيبه",121,"ب",2,0],["ولي كلُّ عتب مرير عليك","إذا صحّ عتبٌ على جاهل",122,"ل",1,0],["وَلي كَبد حَرى إِذا ما ذكرتكم","تَأَجج فيها جَمرها فَكَواني",123,"ن",2,0],["ولي كل عام في رحابك وقفة","اهز بها عطفي جليل المناقب",124,"ب",1,0],["ولي كوكب وحدي إذا زرت حجرتي","فإن غبت عن عيني إذا أطفئ الظهر",125,"ر",1,0],["ولي كبد قد شفها بعده النوى","وقلب براه الحزن حتى تقطعا",126,"ع",2,0],["ولي كبدٌ في الحب تصبو إلى الأسى","وتصبر في حرِّ البعاد على النارِ",127,"ر",1,1],["ولي كبد بلهاة الجوى","لعظم رزاياكم تمضغ",128,"غ",1,0],["ولي كبد يزداد حباً لهيبها","اذا حدها الورديُّ ما زاد بالوقد",129,"د",1,0],["ولي كلما مرّت بفكري صبابةٌ","شُجونٌ أُواريها بسترِ المدامع",130,"ع",1,0],["وَلي كَبِدٌ لا يُصلِحُ الطِبُّ سُقمَها","مِنَ الوَجدِ لا تَنفَكُّ دامِيَةٌ حَرّى",131,"ر",2,1],["وَلِيكُرغُ مِن ثَمَّ كُلُّ إِلاه","يَعيشُ بدارِ النَّعِيمِ قَلاه",132,"ه",1,0],["وَليَكُن يَومكَ الَّذي أَنتَ فيهِ","فائِقاً في التُقى صَحيفَه أَمسك",133,"ك",1,0],["ولي كبد تضج من الجروح","لئن علمت الحان الصدوح",134,"ح",1,0],["ولي كبد حري عليه قريحة","وقلب معنيّ في هواه يذوب",135,"ب",1,0],["وليكَ منكَ في ظلٍ ظليلٍ","من الإعزاز في كِنٍ كَنينِ",136,"ن",1,0],["وليكَ في بلادِ اليمنِ والٍ","وجارُكَ في رياضِ الأمنِ حجارِ",137,"ر",1,0],["ولي كبدٌ حرى عليك من الظما","يطولُ إذا ما شاهدتك خفوقها",138,"ق",3,0],["وَلي كُلُّ الكَمالِ وَكُلُّ شَأوٍ","لِكُلِّ عَلِيَّةٍ عُظمى وَكُبرى",139,"ر",2,0],["وليكوان في العلا بعد دركي","أدركاني السماك والعيوق",140,"ق",1,0],["ولي كبد من الأشجان طاحت","وجفن دمعه في الخد ساكب",141,"ب",1,0],["ولي كل يوم في علاك يتيمة","من الدر تنفي ما سواها وتنفق",142,"ق",1,0],["وَلي كَبِدٌ حَرّاءَ مِن ظَمَأٍ بِها","إِلَيكَ وَلَم يَبرُد غَليلاً مُصانِعُ",143,"ع",1,0],["ولي كبد ذابت إليك صبابة","وعين سفوح الجفن بالدمع ساجمه",144,"م",2,0],["ولِي كُلَّما حَرَّكتِ كَفَّيكِ شَهقَةٌ","لَهَا خافِقِي يَهفُو, وعَينايَ تَشْخَصُ",145,"ص",1,0],["ولْيكن حَدْوُك إن شئت ابتهالاً","إنَّ ذكرَ الله من خير الوسائل",146,"ل",1,0],["ولي كذلكَ تحتَ الشمسِ أجنحةٌ","نحو المراد برغمِ القيدِ خفّاقة",147,"ق",2,0],["وليكن آدم جنى حسبه فق","دان فردوسه الجميل عقابا",148,"ا",1,0],["ولي كبدٌ ذابت وآبت بحرقةٍ","لأن بها وَقْرًا يزيد على وقر",149,"ر",1,0],["ولي كفٌّ تصافحُ كلَّ ذكرى","وما كسرَ الزمانُ ليَّ اليراعا",150,"ع",2,0],["ولي كل شعرٍ ليس يؤتى بمثله","لو أن كان مثل الدف ننقرهُ رنا",151,"ن",2,0],["ولي كبد - أستغفر الله","قد بدا بها من قراع الحادثات فطور",152,"ر",1,0],["وليكن عند المشركين ولم يكن","ليظهر دين الله فيمن يخالله",153,"ل",2,0],["ولي كبدٌ وأنت تظنّ أني","بلا كبدٍ وأنت عليّ تقسو",154,"س",2,1],["ولْيكتبِ التاريخَ سيفُكِ عَنوةً","سِفْراً تنازَعَ صَوْغَهُ الشُّهَداءُ",155,"ا",2,0],["وليكن في الأسى العميم عليها","خير سلوى لكل قلب حزين",156,"ن",1,0],["وليكحوا هدب الجفون بإثمد","من ذر ذاك المرود النوراني",157,"ن",2,0],["وليكن فوزك العتيد لما يتلو","من الفوز طالع ميمونا",158,"ن",2,0],["وليكن حبَّا عفيفًا طاهرًا","كي يُنالَ برحمةٍ فيها الهنا",159,"ن",2,0],["ولي كلف وليس بها مثيل","كأني بالعذاب قضى الكتابُ",160,"ب",1,1],["وَليَكشِفِ التَّاريخُ بَعدَئِذٍ","أَعمالَ مَن غُدِروا وَمَن غَدَروا",161,"ر",3,0]]}