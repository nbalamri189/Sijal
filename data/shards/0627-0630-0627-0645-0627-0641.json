{"poems":[[95,"إذا ما فرنسا قلدتك وسامها","https://www.aldiwan.net/poem11113.html","الطويل"],[95,"على رغم النوى أبقى قريباً","https://www.aldiwan.net/poem11220.html","الوافر"],[53,"أيا فضلا غدا فضلا","https://www.aldiwan.net/poem7986.html","الهزج"],[14,"أفي ناب منحناها فقيرا","https://www.aldiwan.net/poem38314.html","الوافر"],[40,"وما مزنة جادت فأسبل ودقها","https://www.aldiwan.net/poem7709.html","الطويل"],[45,"ملومكما يجل عن الملام","https://www.aldiwan.net/poem10571.html","الوافر"],[68,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[17,"أعاذلتي ألا لا تعذليني","https://www.aldiwan.net/poem1196.html",""],[48,"أيا سارحا في الجو دنياك معدن","https://www.aldiwan.net/poem22599.html","الطويل"],[48,"لعمري لقد نام الفتى عن حمامه","https://www.aldiwan.net/poem23469.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[256,"رُبى لبنان","https://www.aldiwan.net/poem39738.html","عموديه"],[310,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[353,"وزائرة وليس بها احتشام","https://www.aldiwan.net/poem20687.html","الخفيف"],[371,"خليلي قد ابصرت عيشي بعده","https://www.aldiwan.net/poem17344.html","الطويل"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[391,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[466,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120097","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102143","الهزج"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28060","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18050","الطويل"],[2556,"","https://poetry.dctabudhabi.ae/diwan/poem/198704","الوافر"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10410","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75992","الوافر"],[2858,"","https://poetry.dctabudhabi.ae/diwan/poem/22625","الطويل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20540","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102381","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108378",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114296","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101349","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136928",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90894","الوافر"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103253","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83163","الوافر"],[4883,"قصيدة حب","https://www.poetsgate.com/ViewPoem.aspx?id=48366",""],[4927,"غَرِيْقُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29845",""],[5143,"وسائلة عنا بغيب وسائل","https://www.poetsgate.com/ViewPoem.aspx?id=186626",""],[5279,"حُلْمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182953",""],[5563,"لا بيت لي ولا صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=214534",""],[5582,"فَما كُنْتُ أَدْرِي أَنْ يَكُونَ سَعِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186978",""],[2696,"أتَعْرِفُ رَسْماً كاطِّرَادِ المَذاهبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27399&r=&rc=3",""]],"verses":[["إِذَا مَا فَرَنْسَا قَلَّدَتْكَ وِسَامَهَا","فَخَاراً بِمِصْريٍّ يَجِيدُ لِسَانَهَا",0,"ن",3,1],["إذّا مَا فَاتَ عَيْنِي أنْ تَرَاكُمْ","فَفِي قَلْبِي أَرَاكُمْ كُلَّ آنِ",1,"ن",1,0],["إذا ما فَيْشةً لاحت","صَبا قيسٌ إلى لبنى",2,"ن",2,0],["إِذا ما فاتَني لَم أَستَقِلهُ","حَياتي وَالمَلائِمُ لا تَفوتُ",3,"ت",1,0],["إِذا ما فَزِعنا أَو دُعينا لِنَجدَةٍ","لَبِسنا عَلَيهِنَّ الحَديدَ المُسَرَّدا",4,"د",2,0],["إِذا ما فارَقَتني غَسَّلَتني","كَأَنّا عاكِفانِ عَلى حَرامِ",5,"م",1,0],["إِذا ما فَعَلتَ الخَيرَ ضوعِفَ شَرُّهُم","وَكُلُّ إِناءٍ بِالَّذي فيهِ يَنضَحُ",6,"ح",1,0],["إِذا ما فاتَني لَحمٌ غَريضٌ","ضَرَبتُ ذِراعَ بَكري فَاِشتَوَيتُ",7,"ت",1,0],["إِذا ما فَعَلتَ الخَيرَ فَاِنسَ فِعالَهُ","فَإِنَّكَ ما تَنساهُ أَحيا لَهُ ذِكرا",8,"ر",2,0],["إِذا ما فَعَلتَ الخَيرَ فَاِجعَلهُ خالِصاً","لِرَبِّكَ وَاِزجُر عَن مَديحِكَ أَلسُنا",9,"ن",2,0],["إذا ما فتَّحَ الفجرُ","عيونَ النرجس الغضِّ",10,"ض",1,0],["إِذَا مَا فَتَحْنَا قُفْلَ رَمْزٍ بَدَتْ لَنَا","مَعَارِيضُ لَمْ تَفْتَحْ بِزِيجٍ وَلا جَبْرِ",11,"ر",1,0],["إذا ما فرّ صاحبه بليل","جرى يبكي.. ويسرف في النّواحِ",12,"ح",1,0],["إِذا ما فِرِند البيضِ ماجَ عبابهُ","تُوثِّقهُ منهنّ أشرعة حمرُ",13,"ر",1,0],["إذا ما فارقَتْني غَسَّلَتْني","لأَني قَد وَصَلْتُ إلى حِمَامي",14,"م",2,0],["إِذا ما فَقَدتَ الأُنسَ مِمَّن تُحِبُّهُ","فَنَفسُكَ لا المَحبوبُ أَفجَعُ بِالفَقدِ",15,"د",1,0],["إذا ما فؤادٌ حازَها بِاشتِمالِه","علَيها فقَد أمسَى علَيهِ اشتِمالُها",16,"ل",3,0],["إِذا ما فُتنَهُ يَوماً بِرَهنٍ","يَعِزُّ عَلَيهِ لَم يَرجِع بِحينِ",17,"ن",1,0],["إذا ما فاتني التقبيل منها","فليس يفوتني نَوْءُ الغمام",18,"م",1,0],["إذا ما فاخروهُ فهوَ نَجْمٌ","مُضيءٌ ثاقبٌ وهُمُ التُّرابُ",19,"ب",1,0],["إذا ما فل جيش هوى سلو","وقل غليل أحشاء صوادِي",20,"د",2,0],["إذا ما في القيامه","تجلّى في النظام",21,"م",1,0],["اذا ما فتى هزَّت معانيه شرّدا","سمعت صداها عند كل فتاة",22,"ه",1,0],["إِذا ما فَرَغنا مِن قِراعِ كَتيبَةٍ","نَصَبنا إِلى أُخرى تَكونُ لَنا شُغلا",23,"ل",2,0],["إِذا ما فَرَغنا مِن قِراعِ كَتيبَةٍ","صَرَفنا إِلى أُخرى يَكونُ لَهُم شُغلا",24,"ل",2,0],["إذا ما فرجت خلل الستور","ولاح وقد تمكن في السرير",25,"ر",1,1],["إِذا ما فَرَرنا كانَ أَسوَا فِرارِنا","صُدودَ الخُدودِ وَاِزوِرارَ المَناكِبِ",26,"ب",1,0],["إِذا ما فَسَّروا القُرآنَ قالوا","بواطِنهُم لَها فيهِ كشوفُ",27,"ف",1,0],["إِذا ما فَرَغنا مِن جِلادِ كَتيبَةٍ","أَتانا رِجالٌ دارِعونَ وَحُسَّرُ",28,"ر",1,0],["إِذا ما فَرَغنا مِن سِوارِ قَبيلة","سَمَونا لِأخَرى نَبتَغي مَن نُسَاوِرُ",29,"ر",1,0],["إذا ما فلاةُ الخِمسِ أضحتْ كأنَّها","مُنَطَّقةٌ أعلامُهنَّ مُلاءُ",30,"ا",2,0],["اذا ما فؤادي قد شكا غدر دهرهِ","تحمَّل عني بعض ما في فؤَاديا",31,"ي",2,0],["إِذَا مَا فَنِيتَ فِي فِعَالِهِ وَاصِلاً","يُنَادِي فَنَاءٌ فِي الصِّفَاتِ ألاَ اسْتَعلِي",32,"ل",2,0],["إذا ما فاتني للقاك فرض","ولم أستوف واجبه أداءا",33,"ا",3,0],["إذا ما فراشي ملَّني ومللتهُ","صحبتكِ حتى ما تطيقين صحبتي",34,"ت",2,0],["إذا ما فاه فاض الدر نثرا","ونظما فائقا عقد الجمان",35,"ن",1,0],["إذا ما فكّروا اتضح المعمّى","وزال اللبس وانكشف الغطاء",36,"ا",2,0],["إِذا ما فازَ بِالتَفضيلِ صَبري","رَأَيتُ البُحتريَّ يُميلُ فِكري",37,"ر",2,0],["إذَا مافَجَّرَ الشَّاعر قَصيْدة صِدقَهَاْ نِبْرَاس","يبّل الدَّفْتَر ويَشرَبْ حبْر كِذْبه ومَكتوبهْ",38,"ب",2,0],["إِذَاْ مَاْ فَرَّقَ الْعُشَاْقَ وَغْدٌ","وَ لَمْ تَأْتِ الرَّسَاْئِلُº وَالرُّدُوْدُ",39,"د",1,0],["إذا ما فرى هام الرؤوس اعترامها","تعاورها منا أكف وكاهل",40,"ل",1,0],["إِذَا مَا فَعَلْتُمْ سَتَأْتِي رِيَاحٌ","تُزِيلُ الهُمُومَ وَمِنْكُمْ تُسَرْ",41,"ر",1,0],["إذا ما فؤادي سلا ساعةً","تمعَّر وجهُ الأسى يصْخبُ",42,"ب",1,0],["إِذا ما فَقَدْتُ ابْنِي وَقَدْ كانَ جَنَّتِي","فَهَلْ لِمَسَرَّاتِ الزَّمانِ وُجُودُ",43,"د",1,0],["إذا ما فررنا كان أسوا فررانا","صدود الخدود وازورار المناكب",44,"ب",1,0]]}