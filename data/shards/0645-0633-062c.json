{"poems":[[230,"يا رائد الشعر لا تقرب مناهله","https://www.aldiwan.net/poem55212.html","البسيط"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130879","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96731","البسيط"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93136","البسيط"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116649","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88638","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94049","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202754","المجتث"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67971","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82818","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97107","البسيط"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136426",""],[5358,"مجرى الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=183421",""],[5431,"فإن الصبرَ من عزم الأمور","https://www.poetsgate.com/ViewPoem.aspx?id=187730",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5476,"كِبْرِيَاءُ الْمَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=194644",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5652,"رماد إنسان","https://www.poetsgate.com/ViewPoem.aspx?id=178409",""],[5837,"سجين المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=181854",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["مسجَّلا في كِتابٍ قيِّمٍ حَفِلٍ","بِقَولِ كلِّ طويلِ الباع ذي خَطَرِ",0,"ر",1,0],["مسجاة بثوب سندسي","مسردقة بديباج الجلال",1,"ل",1,0],["مسجّد فطن لا شكّ أنّ له","مجد وعزّ وأنصار وسلطانِ",2,"ن",1,0],["مسجورة القلب إلا أن أعينها","كالمعصرات تصوب الدمع عقيانا",3,"ن",2,0],["مسجدٌ كان مِن عليٍّ وسَعدٍ","عَافِراً بُرهَةً وَمِن عَمَّارِ",4,"ر",1,0],["مسجد المرتضى علي وكم ذا","عفر الانبياء فيه الجباها",5,"ا",3,0],["مسجد طالَما به سأل اللَه","رجال فيه اِستَجاب دعاها",5,"ا",3,0],["مسجد جددته أيدي مليك","صنعه جل عن نظير يعاني",6,"ن",2,1],["مسجّلاتٍ جزافاً","تحرّكي وسكوني",7,"ن",2,0],["مُسَجَّى عَلَى ظهرِ الأَريكةِ هادئاً","وتنسج أكفانَ الحتوفِ عناكبه",8,"ب",2,0],["مَسَّ جِسمي الغَرامُ وَالسُقمُ حَتّى","لم يَكَد يُستَبانُ لَولا الأَنينُ",9,"ن",1,0],["مَسجورةٍ سُترت بالغابِ جِمَّتُها","تفترُّ عن جدولٍ كالسيفِ مُطَّردِ",10,"د",1,0],["مسجورة القلب إلا أن أدمعها","كالمعصرات تصب الدمع عقيانا",11,"ن",2,0],["مسجد إبراهيم فيه صلوا","وسمعوا الخطيب ثم ولوا",12,"ل",3,0],["مسجد قد أسسوه بالتقى","فبإخلاص ترى فيه العباده",13,"د",2,1],["مسجونةٌ كلُّ روحي تحتَ قبضتِهِ","فلو تطلَّعْتَ في وجهي ستلقاهُ",14,"ا",2,0],["مسجاةٌ على حزن كبير","تجوب بها القذائف كالسعير",15,"ر",1,0],["مسجى بالدماء ولاحبال","له تُرمى بصمت كي يفرّا",16,"ر",2,0],["مُسَجًّى عَلَى الْكَلِمَاتِ الَّتِي","تُبَعْثِرُ صَوْتِيَ دُونَ صَدَاهْ",17,"ا",2,0],["مسجدُ الاقصى أنا، أُخبركم","أنني لا أَنثني للخطر",18,"ر",1,0],["مسجون ضيقه وأكثري يآس مركون","في وسط صدرٍ فاقدٍ معنوية",19,"ي",2,0],["مسجون ويراجع مع الوقت ماضيه","ولا وجد لاسباب تثبت وقوفه",20,"ف",2,0],["مسجوناً في عطرِ امْرأةٍ","وطفولةِ صفصافٍ كاذبْ",21,"ب",1,0],["مسجّياً لِمَا هَصَرْ","أَخْذَ عَزِيزٍ مُقْتَدِرْ",22,"ر",1,0]]}