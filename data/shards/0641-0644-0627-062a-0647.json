{"poems":[[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11945.html","الطويل"],[39,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[53,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[53,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[53,"أخا ثقتي أعزز علي بنوبة","https://www.aldiwan.net/poem62852.html","الطويل"],[53,"أخالد قد عاديت في كراكا","https://www.aldiwan.net/poem65799.html","الطويل"],[47,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[60,"فما نوب الحوادث باقيات","https://www.aldiwan.net/poem30866.html","الوافر"],[82,"بقيت مع الحياة ومات شعري","https://www.aldiwan.net/poem31357.html","الوافر"],[71,"ما دام في الإنسان روح","https://www.aldiwan.net/poem28554.html","السريع"],[69,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[92,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[53,"أخا ثقتي أعزِزْ عليّ بنوبة","https://www.poetsgate.com/ViewPoem.aspx?id=29056",""],[119,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[139,"لقد تبدى كغصن البان في الميل","https://www.aldiwan.net/poem47410.html","البسيط"],[151,"تساءلني أم البنين وإنها","https://www.aldiwan.net/poem47690.html","الطويل"],[164,"إذا لم يكن للصب من هجركم بد","https://www.aldiwan.net/poem58830.html","الطويل"],[190,"أبا حسن ما صدني عنك أنني","https://www.aldiwan.net/poem43914.html","الطويل"],[303,"لمن وبمن عسى يرجى العزاء","https://www.aldiwan.net/poem36264.html","عموديه"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[343,"فلا تهجر أخاك بغير ذنب فإن","https://www.aldiwan.net/poem68670.html","الوافر"],[369,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[385,"تعفى العقيق وكثبانه","https://www.aldiwan.net/poem49200.html","المتقارب"],[435,"أخا الانس هل أبصرت صبا مولعا","https://www.aldiwan.net/poem41392.html","الطويل"],[438,"وأهدى نسيم الروض مسكا وعنبرا","https://www.aldiwan.net/poem12526.html","الطويل"],[469,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[473,"كتمت الذي ألقاه منك عن الورى","https://www.aldiwan.net/poem59759.html","الطويل"],[505,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18259","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112795","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112716","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144763","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53038","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27268","الهزج"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115729","المنسرح"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115433","الوافر"],[2964,"","https://poetry.dctabudhabi.ae/diwan/poem/121986","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118826","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11337","السريع"],[3349,"","https://poetry.dctabudhabi.ae/diwan/poem/73843","البسيط"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28330","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91073","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91692","الطويل"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114866","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101388","الوافر"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45931","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94375","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139273","السريع"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147275","الوافر"],[4553,"","https://poetry.dctabudhabi.ae/diwan/poem/98073","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4978,"صباح من الفكر وافى وردّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=177288",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5074,"إلى ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=153514",""],[5081,"الرَّسُولُ العَاشِقُ !","https://www.poetsgate.com/ViewPoem.aspx?id=186695",""],[5419,"فيزياء ثورية","https://www.poetsgate.com/ViewPoem.aspx?id=71125",""],[5431,"وليس سوى التحنان عرْفٌ ومذهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=191897",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5660,"أَحَقُّ النّاسِ أَن تُهجى الشُعوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=23712",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""]],"verses":[["فَلا تَهِضِ الدُنيا جَناحَكَ بَعدَهُ","فَمِنكَ لِمَن هاضَت نَوائِبُها جَبرُ",0,"ر",1,0],["فَلا تَهِضِ الدُنيا جَناحَكَ بَعدَها","فَمِنكَ لِمَن هاضَت نَوائِبُها جَبرُ",1,"ر",1,0],["فلا تهنوا ولا تَرضوا بخف","ولا يغرركم أسد بعهدِ",2,"د",1,0],["فلا تهربنَّ إلى ذِلَّةٍ","ذليلُ الزمانِ كمنكوبِهِ",3,"ب",2,0],["فلا تَهجُني حسبي من الخزي أنني","وإياك ضمَّتنا ولادةُ والدِ",4,"د",1,0],["فلا تهلِكن حزناً على ابنة جنةٍ","غدتْ وهي عند الله تُحبَى وتحبر",5,"ر",1,0],["فلا تَهْجُنِي إني أخُوك لآدمٍ","وحَسْبي هجاءً أن أكون أخاكا",6,"ك",2,0],["فَلا تَهُمُّ بِتَقصيرٍ وَلا طَبعٍ","وَلَو هَمَمتَ نَهاكَ الدينُ وَالحَسَبُ",7,"ب",1,0],["فَلا تَهلِك عَلى ما فاتَ وَجدَاً","وَلا تَفرِدكَ بِالأَسَفِ الهُمومُ",8,"م",1,0],["فَلا تَهوَ الفتاةَ وأنْتَ شيخٌ","فأبعدُ وَصْلِها مِنْ صَيْدِ عَنْقا",9,"ق",2,0],["فلا تهينَنَّ صغيراً فقدْ","يحطُّكَ الدهرُ ويعليه",10,"ه",1,0],["فلا تُهْملْ أُمورَ المُلْكِ حَتَّى","يَذِّلَّ الجُنْدُ لِلْمُتَعَمِّمِينا",11,"ن",2,0],["فلا تهملوها بعد أن جد جدها","وقام بها حسب الشريعة قائم",12,"م",1,0],["فلا تهِنوا ، إنَّ هَذي الأكفَّ","تُملي على الدَهر ما يكتب",13,"ب",1,0],["فلا تهلِكن حزناً عن ابنة جنة ٍ","غدتْ وهي عند الله تُحبَى وتحبر",14,"ر",1,0],["فلا تهملوا تلك الحقوق وتنزعوا","وداد أمرئ قد غاب فيكم عن الطور",15,"ر",1,0],["فلا تهولنَّهُ في العلمِ مشكلةٌ","إلاّ أفاض لها من صوبهِ الهطلِ",16,"ل",1,0],["فلا تهزئي بي واعلمي أنني الذي","أهاب ولو أصبحتُ تحت الثرى بالي",17,"ل",2,0],["فلا تهجروه هجر من لا يحبكم","ولا هجر من ينسيه حبكم البعدُ",18,"د",1,0],["فلا تهجني واقبل قليل عطّيتي","وبعني بها عرضي وأنت المساعد",19,"د",1,0],["فلا تهنوا فما في الوهن إلا","مضاعفة الرزيَّةِ والشقاءُ",20,"ا",2,0],["فلا تهجر الاصحاب واستغن عنهمو","ولو كنت محتاجا وفيك الأمرّات",21,"ت",1,0],["فَلا تَهابَنَّ أَسفاراً وَإِن بَعُدَت","إِن هابَها عاجِزٌ في عودِهِ قَصَفُ",22,"ف",1,0],["فَلا تَهجُر أَخاكَ بِغَيرِ ذَنبٍ","فَإِنَّ الهَجرَ مِفتاحُ السُلُوِّ",23,"و",1,1],["فلا تُهدِيا نُصْحاً إليَّ فإنّني","كَفتْنيَ طاعةَ النُّصحاء",24,"ا",2,0],["فلا تهن بالله بعد تلك الجبهة","فإنّها لا تستحق الجبهة",25,"ه",1,0],["فَلا تَهوَ ما دُمتَ فَوقَ التُرا","ب شَيئاً بِسؤك فُقدانَهُ",26,"ن",2,0],["فلا تهجرن صبّا لغيرك ما صبا","ولا تنس مضنى بالسوى ما تولعا",27,"ع",2,0],["فلا تُهمِلا هذا الزمانَ فإنّه","يجدِّدُ للمشتاقِ عُمراً مُنعّما",28,"م",2,0],["فلا تهجر الذكرى ولستُ بهاجرٍ","فغير بعيدٍ من خلائقك النَصف",29,"ف",1,0],["فَلا تَهتِكَنَّ سِترَ المَوَدَّةِ بِالقِلى","فَيَنصُرَ في صَبري وَرَأيُكَ أَفضَلُ",30,"ل",1,0],["فلا تُهْضَمْ بزَفْرَةِ ذي ضَلالٍ","كَذوبٍ بالخَيالِ البحتِ عَادِ",31,"د",1,0],["فلا تهج ابن عباس مجيباً","فإن لسانه سلس قؤول",32,"ل",1,0],["فلا تهمل حبيب اللَه وانجد","بحق الآل يا ذخري وصحب",33,"ب",1,0],["فلا تهملوا وانجدونا وجملوا","بعاقبة عظمى وبالمدد المذكى",34,"ك",2,0],["فلا تهمل سلامَ شجٍ","مشوق شفَّهُ اللهفُ",35,"ف",1,0],["فلا تهمل العيس والصافنات","فرزقك في عَنَقٍ أَوْ خَبَب",36,"ب",1,0],["فلا تهتم يا نفسي","لقولِ الحاسدِ النِّكس",37,"س",1,0],["فلا تهجر العيش ما استطعت ولا","تأسف على مربع ولا طلل",38,"ل",1,0],["فلا تهدر دمي فدمى جليلٌ","وعقلي طائرٌ والقلبُ واجب",39,"ب",1,0],["فلا تهج أمّا للثغور حنونة","كفاها مديحا عدكم هفواتها",40,"ت",3,0],["فلا تهملوني يا أُحَيباب مهجتي","وإن لم أكن أهلاً لخير ولا برِ",41,"ر",1,0],["فَلا تَهِج إِن كُنتَ ذا إِربَةٍ","حَربَ أَخي التَجرِبَةِ الغافِلِ",42,"ل",1,0],["فَلا تَهابَنَّ فاسِياًّ مَرَرتَ بِهِ","وَإِن تَقُل فيهِ خَيراً حَوِّل الوَرَقَه",43,"ق",2,0],["فَلا تَهلِك ولا نَهلِك وشَمِّر","ولا تأسَف فللدُّنيا صُرُوفُ",44,"ف",1,0],["فلا تَهِن همّةٌ إِن عُزِّزَت عَظُمت","وَلا تَرى الفَخر بِالسُلطان وَالرتب",45,"ب",1,0],["فَلا تَهْنَ في الدُنيا وَقَد بَعُدَ اللقا","وَلا تَرتَجي صَفواً وَذي دارُ أَكدار",46,"ر",1,0],["فلا تهلكَنَّ النفس لوماً وحَسرةً","على الشيء سَدّاهُ لغيرك قادرُه",47,"ر",2,0],["فلا تهصر وشيج قناً لحربي","فقدُّك قدَّ من اسلٍ وريق",48,"ق",1,0],["فَلا تُهمِلوا مِن أُمِّكُم مُتَطَفِّلاً","عَلى جودِكُم حاشاكُمُ يا أَحِبَّتي",49,"ي",1,0],["فلا تهملي اللاجين يا خضرم الندى","وَبحر صلاحٍ قطُّ لم يؤتَ بالحصرِ",50,"ر",1,0],["فَلا تهمِلوا حقّاً يَضِع لِضَياعكم","بِداع اِنخِذالٍ فيكُمُ وَتَخاذُلِ",51,"ل",1,0],["فلا تهنهما وعززهما","تعش عزيزاً غير مستهضم",52,"م",1,0],["فلا تهمي ليذهب هم قلبي","وإن بقيت سيعصرها أنيني",53,"ن",2,0],["فَلا تهنئ الفتيان بعدكَ لذّة","وَلا رَجعوا من غيبةٍ بسلامِ",54,"م",1,0],["فَلا تُهمِلَن ذِكرَ الأَحِبَّةِ لَمحَةً","وَداوِم خِلافَ النَفسِ فَهيَ تُتابِعُ",55,"ع",1,0],["فلا تهجريه وظلي به","منارا لنهج بفكر مسدّدْ",56,"د",1,0],["فلا تهنوا لا تحزنوا قوم أبشروا","بنصرٍ وتأييدٍ من الله عاجل",57,"ل",1,0],["فَلا تُهَادِنْ ولا تُمْهِلْ وَكُنْ حَذِقَاً","واحْذرْ مِنَ القَوْلِ مَا يُؤْذِيْ وَمَا يَصِمُ",58,"م",1,0],["فَلَا تَهْجُرْ رَسُولِي دُونَ ذَنْبٍ","وَلَا تَحْرِمْهُ مِنْ تَقْبِيلِ فِيهِ",59,"ي",2,0],["فلا تهزأ لكونهمُ صِغارا","فقد صاروا بوقفتهم رجالا",60,"ل",2,0],["فلا تهدر الأيام من دون لهفة","وليس سوى التحنان عرْفٌ ومذهبُ",61,"ب",1,0],["فلا تهجر الأصحاب واستغن عنهمو","ولو كنت محتاجا وفيك الأمرَّان",62,"ن",1,0],["فَلا تَهجوا حُكوماتٍ تَوالَت","فَإِنَّ الحُكمَ فيكُم لا يَخيبُ",63,"ب",1,0],["فلا تهِنا إن فرقتْنا صروفُه","أُعيذكما أن يستبدّ بكم يأسُ",64,"س",1,0]]}