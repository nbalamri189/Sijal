{"poems":[[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[93,"وقعت نحلة على الأقحوان","https://www.aldiwan.net/poem8795.html","عموديه"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[111,"مدد الحق للقلوب الصواردي","https://www.poetsgate.com/ViewPoem.aspx?id=528",""],[132,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[214,"هل لصب قد غير السقم حاله","https://www.aldiwan.net/poem13303.html","الخفيف"],[228,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[358,"يا سميري في السرى عرجا بي","https://www.aldiwan.net/poem40822.html","الخفيف"],[406,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[473,"كن شاطر الإقرار لا تجحد أخا","https://www.aldiwan.net/poem59926.html","الكامل"],[543,"قيل ما بالنا نتيه سرورا","https://www.aldiwan.net/poem47524.html","عموديه"],[572,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126729","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119990","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136376","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48970","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123089","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104822","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104800","المديد"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123484","الرمل"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101294","المنسرح"],[4750,"الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180412",""],[4797,"سرحت فالقلص من عزبة تميم","https://www.poetsgate.com/ViewPoem.aspx?id=178126",""],[4851,"يا ربيعي ما كان ضرك لوجد","https://www.poetsgate.com/ViewPoem.aspx?id=182369",""],[5376,"لا تكلُّوا يا صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188464",""],[5376,"احزمْ متاعَك أيها الرجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198998",""],[5409,"بنفسي التي ذكرت خلها","https://www.poetsgate.com/ViewPoem.aspx?id=155501",""],[5431,"قم وعلّم جلودهم بالسياطِ!!","https://www.poetsgate.com/ViewPoem.aspx?id=201609",""],[5518,"يا حبيب الله","https://www.poetsgate.com/ViewPoem.aspx?id=188939",""],[5644,"أي شأن من شؤونك","https://www.poetsgate.com/ViewPoem.aspx?id=211271",""],[5739,"هيه يالمسترجله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=131708",""],[6093,"كن شاعر أو كن قصيدة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=199700",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""]],"verses":[["كُن شَوكَةً يُعيي اِنتِقاصُ شَباتِها","أَو حَمضَةً يَشجى بِها المُتَمَلِّحُ",0,"ح",1,0],["كُن شُعاعاً يَبينُ فيهِ كَياني","لا ظَلاما وَلا رَغام",1,"م",1,0],["كنشاوى مدهدهين أراقوا","فضلات الحلومِ في الأكوابِ",2,"ب",1,0],["كن شرحا لها واعظم بهذا الش","رح كنزا ما ان له من نفاد",3,"د",1,0],["كن شفيعِي لا شفيعَ سِواكْ","إنني متبعٌ نور هداكْ",4,"ك",1,0],["كن شفيعي مما جنيت قديما","زمن اللهو والصبا والجهالة",5,"ل",2,0],["كُن شَفيقاً عَلَيَّ وَاِرحَم فُؤادي","إِذ تَراهُ قَد ضَلَّ عَن إيمانِه",6,"ن",2,0],["كُن شَفيعي لَدى المُهيمن يا مَن","هُوَ أَدنى إِلَيهِ مِن قَوس قابِ",7,"ب",1,0],["كُنْ شامخَ الصبر وارفع للسماء يد","فالصبْرُ والراحةُ الكبرى قرينانِ",8,"ن",1,0],["كُن شاطِرَ الإِقرارِ لا تَجحَد أَخاً","ما كانَ مِنكَ إِلَيهِ خَوفُ قَصاصِ",9,"ص",1,1],["كَنشَاوىَ مِن فرطِ سُكرٍ تَهَأدَوا","حينَ مالَت بجَمعِهِم خَندَرِيسُ",10,"س",1,0],["كُنْ شَفِيْعي فأنتُمُ شُفَعَائي","في الحَيَاةِ الدُّنْيَا وَدَارَ الخُلُودِ",11,"د",1,0],["كُن شَفيعي يا اِبن الرِضا ومُعيني","بكَ أرجو النجاة يوم المعادِ",12,"د",1,0],["كنشر مدحي في كل ناد","على ندى أكرم الأكارمُ",13,"م",1,0],["كن شفيعي إذا دعيت لعرض","هوله قد أشاب راس العذارى",14,"ر",2,0],["كن شفيعي سيدي ان على","بابكم القيت نفسي ويدي",15,"ي",1,0],["كنْ شفيعاً لي كما أَنيَ لكْ","شاعرٌ لا تستبيهِ الكِبرياءْ",16,"ا",2,0],["كُن شافعاً لابن سودون لتُنقذه","يا أكرم الرسل من عرب ومن عجم",17,"م",1,0],["كن شافِعاً لِى ناصِراً يا خَيرَ مَن","وَطِىءَ الثَّرَاءَ بأَخُمصٍ ونِعالِ",18,"ل",1,0],["كُن شَفِيعِى يَومَ لاَحِيَلى","تُغنِنى عَن بارِىءِ النَسَمِ",19,"م",1,0],["كُن شَفيعي يَومَ اللِقا وَمُجيري","مِن جَميعِ الذُّنوبِ وَالآثامِ",20,"م",1,0],["كُن شَفيعي لعلَّني بِكَ أَحظى","بِرِضى ذي الجَلال وَالإِكرامِ",20,"م",1,0],["كن شفيعا للحميدى اذا","مالظى في الحشرشب لهبا",21,"ب",2,0],["كن شافعي عند مالكي فبها","تيك الخطايا العظام منغمسي",22,"س",2,0],["كن شطرطون الوكاله في جنوبه","والرخوم اللي روابعهم ضعيفه",23,"ف",2,0],["كن شواذرها حرامات الحريم","واللثامه برقع ٍ خيطه اعذار",24,"ر",1,0],["كن شفيعي إليك يا جنة الخلد","فمالي غير الخضوع شفيع",25,"ع",1,0],["كن شجاعا يا رفيقي","فالأعادي لا تحابي",26,"ب",2,0],["كن شامخاً أو سامقاً أبدا","واحرصْ فلا ينأى بك الجبلُ",27,"ل",1,0],["كنشر جناحين من طائرٍ","متى صار بالقرب من وكره",28,"ر",2,0],["كن شكوكا فظاهر الأمر حسٌ","قد يؤدي قبوله لاختلاطِ",29,"ط",1,0],["كن شفيعي ياحبيبي والحمى","يوم نلقى الله والخلق هيّام",30,"م",1,0],["كن شجاعا مثل فرسان الوغى","لا تصُدَّ القلب من خلفِ حصونِكْ",31,"ك",1,0],["كَنّ شين التربيه حَب ٍ ف/بُور.","يحرقه ملح ٍ تلحّف بالهجير.",32,"ر",1,0],["كُنْ شاعرًا أو كُنْ قصيدةَ شاعِرٍ","أو لا، فَقُمْ نَحْوَ الحبيبِ لِتُبْلِغَهْ",33,"غ",2,0],["كَنَشيدٍ كُلَّما أَنهَيتُهُ","صَفَّقَ القَلبُ وَغَنَّى أَوَّلَه",34,"ل",2,0],["كُنْ شَفِيعي فأَنْتُمُ شُفَعَائي","في الحياة ِ دوماً ودارِ الخلودِ",35,"د",1,0]]}