{"poems":[[0,"ألا يا لهف هند إثر قوم","https://www.aldiwan.net/poem72.html","الوافر"],[49,"سلام رائح غاد","https://www.aldiwan.net/poem25317.html","الهزج"],[74,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[53,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[164,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[409,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[469,"خليلي عوجاً بالمحلة إنها","https://www.aldiwan.net/poem3140.html","عموديه"],[519,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48633","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71025","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70758","الوافر"],[997,"","https://poetry.dctabudhabi.ae/diwan/poem/132404","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138090",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112818","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145153","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108625","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100981","الطويل"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110691","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216779","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127173","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127083","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127104","الوافر"],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5145,"فديتك يا أعز الناس قدرا","https://www.poetsgate.com/ViewPoem.aspx?id=108219",""],[5186,"أسير ولكن لا ترقي لحاله","https://www.poetsgate.com/ViewPoem.aspx?id=156508",""],[5338,"أرى أدمعي منها السحائب تستجدي","https://www.poetsgate.com/ViewPoem.aspx?id=187912",""],[5409,"شقاءٌ في شبابي والمشيب","https://www.poetsgate.com/ViewPoem.aspx?id=155252",""],[5190,"بلادي لم تزل للنور نبعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85060&r=&rc=135",""],[5190,"أُحمِّلك السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78312&r=&rc=25",""]],"verses":[["وَقاهُم جِدُّهُم بِبَني أَبيهِم","وَبِالأَشقينَ ما كانَ العِقابُ",0,"ب",1,0],["وَقاهُ اللَهُ فيما عا","شَ شَرَّ الزَمَنِ العادي",1,"د",2,0],["وقاهرة شادها لفظه","فشائدها أبداً جوهر",2,"ر",1,0],["وقاهُ وقاءٌ مِنْ يدِ اللَّهِ محصِنٌ","لنُعماه أَنْ يغتالها الدهرَ مغتالُ",3,"ل",1,0],["وقاهُمُ الجِدُّ ثم الجَدُّ بل حُرِسوا","بأنهم ما أتوْا غدرا وما خانوا",4,"ن",3,0],["وقاه اله العرش مما يخافه","وأكرم مثواه وأنعم باله",5,"ل",2,0],["وقاه من الرقش العوادي برجله","فبات يعاني السم والطرف تدمع",6,"ع",1,0],["وقاه ما كان من غوائلهم","لا بسيوف العباد والختن",7,"ن",1,0],["وقَاها من الأطماع حتى لو انه","جرى الدَّمُ فوق الأرض ما شَمَّ ذيبُها",8,"ب",3,0],["وقاهم قودَ الذلول مجاهراً","فواخجلتنا من بعدها للمناصل",9,"ل",1,0],["وقاهُ وإيّاهُم من السّوءِ ربُّهم","وبلّغَهُم أسنى المُنى والمطالِبِ",10,"ب",1,0],["وقاهرة الأشرار بالقوة التي","إليها يفرُّ المستجير ويفزع",11,"ع",1,0],["وقاه إلهُ العرشِ شرَّ النوائب","فلا الخيرُ نا آهُ ولانابه الشرُّ",12,"ر",1,0],["وقاه إله العرش شرَّ الحوادثِ","ونجاه من باغٍ وعاتٍ وعائِثِ",12,"ث",1,0],["وقاه اللَّهُ شرَّ الحا","سد الممقوت ذي الجهل",13,"ل",1,0],["وقاه إله العرش من كل محنة","وما أضمرت يوما عداه وحسد",14,"د",1,0],["وقاهموا لفحة الأيام ما لفحت","وشرّد الهمّ عنهم أيَّ تشريد",15,"د",1,0],["وقاهم بفضل منه من كل مبعد","وكان لهم أن جاء هول كريهة",16,"ه",1,0],["وقاه ربي كل ما ضر وسا","ودام ما قر ثبير ورسا",17,"س",2,0],["وقاه شعار الذل من لهب اللظى","وكان به من كل داهةٍ أحرى",18,"ر",2,0],["وقاه كتاب اللَه ما رام معتدٍ","خؤونٌ على أحشائه ختم الحقد",19,"د",1,0],["وقاه اللَه نظرة كل راء","فإن جماله بالعقل رائع",20,"ع",1,0],["وقاهُ بأمثالِ المَغالي كأنّها","بأجنحةٍ فيها إليهِ تطيرُ",21,"ر",1,0],["وقاهر كالطفل في عجزه","لولاك لم يقدر على قهره",22,"ر",2,0],["وقاه الله نظرة كل راء","فان جملة للعقل رائع",23,"ع",1,0],["وقاه ربي من عين النجوم فقد","تطرزت بمعالي مدحه الكتب",24,"ب",1,0],["وقاهم ربهم من كل سوء","فانهم لهذا الدهر روح",25,"ح",1,0],["وَقَاْهِرَةُ الْمُعِزَّ بِهَاْ رَمَاْهَاْ","ثَعَاْلِبُهَاْ تَسَاْقَتْهَاْ مَعِيْنَاْ",26,"ن",2,0],["وقاه الله أحداث الليالي","وبقّاه لأهل الدهر ذخرا",27,"ر",2,0],["وقاه التقى، والطرف للقلب مرسل","سنانيه، مرمى قوسه ونباله",28,"ل",2,0],["وَقَاهُ بِنَفْسٍ كَانَ لَولاَ وَفَاؤُهَا","لَوَفَّتْ قُرَيْشٌ لِلضَّلالَةِ بِالعَهْدِِ",29,"د",1,0],["وقاها الله من شر العوادي","وحياها بصوب حياً صبيب",30,"ب",1,0],["وقَاهِرةَ المُعِزِّ لها شُمُوخٌ","وأَزهَرَهَا على الدنيا تسامى",31,"م",2,0],["وقاهرةِ المُعِزِّ ، وكلِّ شبرٍ","بكفر الشيْخِ ساكنة الشعورِ",32,"ر",1,0]]}