{"poems":[[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[36,"وفى عروة العذري إن مت أسوة","https://www.aldiwan.net/poem4879.html","الطويل"],[39,"وفي ضبن حقف يراجعنه","https://www.aldiwan.net/poem7310.html","المتقارب"],[49,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[53,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[47,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[68,"أدرها بأمن لا يغيرك الوهم","https://www.aldiwan.net/poem40294.html","الطويل"],[82,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[36,"وفي عُروة َ العذريِّ إِنْ مُتُّ أسوة","https://www.poetsgate.com/ViewPoem.aspx?id=22460",""],[96,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[147,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[147,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[185,"وفى عروة العذرى إن مت أسوة","https://www.aldiwan.net/poem58853.html","الطويل"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[275,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[422,"أمر بها مع الأرواح رند","https://www.aldiwan.net/poem54046.html","الرمل"],[422,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[422,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[445,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[463,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[466,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[520,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[520,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126771","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122786","الوافر"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39039","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70738","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59674","المتقارب"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67821","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62553","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112783","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112957","المجتث"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141276","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114031","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113716","الطويل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45516","الطويل"],[2281,"","https://poetry.dctabudhabi.ae/diwan/poem/138880",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132659","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88983","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129378","الطويل"],[3861,"","https://poetry.dctabudhabi.ae/diwan/poem/73553","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44659","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81247","السريع"],[4888,"عشرون عاما من العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=207743",""],[4959,"أَهْلَاً بِكَ يَا شَهْرَ الصِّيَام","https://www.poetsgate.com/ViewPoem.aspx?id=211445",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5397,"بشرا بوجهك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5410,"وَكُوْنِي سِرَّ العَطا الزاخِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=152250",""],[5431,"ثورة 26 من سبتمبر..","https://www.poetsgate.com/ViewPoem.aspx?id=191551",""],[5444,"بلد الألف ربوة","https://www.poetsgate.com/ViewPoem.aspx?id=205450",""],[5595,"ومعشوقي هو الكبدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146094",""],[5626,"يا زورق الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189562",""],[5674,"جئت إليك ياخنساء أعتذر","https://www.poetsgate.com/ViewPoem.aspx?id=185907",""],[6171,"لا فِتَةٌ عَلى بَوابةِ العَام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84672&r=&rc=2",""],[463,"منَ العارِلولا أنَّ طيفكِ يطرقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60159&r=&rc=215",""],[463,"على أيّ لائمة ٍ أربعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60121&r=&rc=177",""],[433,"لقاء القاهرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87049&r=&rc=2",""]],"verses":[["وفَيْضُ يَدٍ تُجَنُّ على سَماحٍ","وأخرى تَسْتَريحُ إِلى طِعانِ",0,"ن",1,0],["وَفَيضُ دُموعِ العَينِ بِاللَيلِ كُلَّما","بَدا عَلَماً مِن أَرضِكُم لَم يَكُن يَبدو",1,"د",2,0],["وفي ضِبْنِ حِقفٍ يراجعنه","خطافِ وسرحةُ والأحدلُ",2,"ل",1,1],["وَفَيضَ دَمعٍ شَرِقَت مَدافِقُه","مِزاجُهُ مِن أَجَإٍ مُشارِقُه",3,"ق",2,0],["وفي ضَميرِيَ نُصحٌ لستُ أغمدُهُ","عنكم وما نصح ذي نصح بمغمودِ",4,"د",1,0],["وَفَيضَ عَطايا ما تَأَمَّلَ ناظِرٌ","إِلَيهِنَّ إِلّا قالَ فَيضُ غَوادِ",5,"د",1,0],["وَفَيضِ نَوالٍ مِن يَديهِ أَفَدتُهُ","لَهُ في قُلوبِ الناسِ مِن جَسَدي وَسمُ",6,"م",1,0],["وفي ضُلوعِكَ قَلبٌ حَشوُهُ هِمَمٌ","وبَينَ عَينَيكَ عَزمٌ نَوْمُهُ سَهَرُ",7,"ر",1,0],["وَفَيْضُ دُمُوعِ العَيْنِ باللَّيْلِ كُلَّما","بَدَا عَلَمٌ مِنْ أَرْضِكُمْ لم يَكُنْ يَبْدُو",8,"د",2,0],["وفي ضحك الطفولة وهو سحر","وفي مرح الصّغار وفي دماها",9,"ا",3,0],["وَفي ضِمنِ تِلكَ المَكرُماتِ كَرامَةٌ","ظَفِرتُ بِها حُرّاً فَصِرتُ لَها عَبدا",10,"د",2,0],["وَفي ضِمنِ الصَلاةِ لَكُم صَلاةٌ","فَلاحٌ في الإِقامَةِ وَالأَذانِ",11,"ن",1,0],["وَفَيضُ غُرُوبِ العَينِ بِالدّمعِ كُلَّما","بَدَا عَلمٌ مِن أَرضِكُم لم يكُن يَبدُو",12,"د",2,0],["وفي ضريم غرامي","ترى شعاعَ الخلود",13,"د",1,0],["وَفي ضمامٍ وَهوَ وافِد قَومِهِ","سَعد بن بَكرٍ خَير ما حَضّانِ",14,"ن",1,0],["وفي ضياءٍ على ماءٍ يُفَضّضُ ما","شَجا من الكوكبِ الدريِّ مطلعه",15,"ع",2,0],["وفيض علومه للناس جهراً","يدلُّ بأنَّهُ بحرٌ مُمدّ",16,"د",1,0],["وفي ضمن لحن القول لولا موانعٌ","دقائق لا تخفى على من تأمَّلا",17,"ل",2,0],["وفيض يدٍ يكاد البحر منها","على طولِ المدى أن يستمدَّا",18,"د",2,0],["وفَيْضُ يمينِهِ والحمدُ يَغْلُو","ونورُ جبينهِ والحربُ تَغْلي",19,"ل",2,0],["وفي ضمن فرحةِ عَودي جوىً","يدلّ على أنني موجَعُ",20,"ع",1,0],["وفيضَ عَبْرته من حُسن عِبْرته","بالذَّاهبين أولي النَّعماءِ والنَّجَدِ",21,"د",1,0],["وفي ضحوة الإثنين سكن جأشها","وشد قواها والبلاء شديد",22,"د",1,0],["وفي ضمير الملك من حبه","سريرة لابد ما تظهر",23,"ر",1,0],["وفي ضحوة الاثنين لولا دفاعه","لما كان كسر الملك والدين يجبر",24,"ر",1,0],["وفِيَّ ضدّانِ لا أسطيعُ دَفْعَهُما","نارٌ بقلبي وماءٌ بالهوى سَفَحا",25,"ح",2,0],["وفيضُ نائلهِ للمُجدبين غدا","كالبحرِ ينتج ألواناً من الدررِ",26,"ر",1,0],["وَفَيضُ مَدامِعي يُنبي بِسِرّي","كَما يُنبي عَنِ النّارِ الدُّخانُ",27,"ن",1,0],["وفي ضَميري لَكُمْ مكنونُ سِرِّ هَوَى","لو رامَ ذِهْنِيَ عنهُ الكَشْفَ لم يبِنِ",28,"ن",1,0],["وفي ضمير فؤادي علةٌ عرضَت","لم يشْفِها طِبُّ بِقراطٍ ولا عيسى",29,"س",2,0],["وفي ضِمن إهداء هذا الجواب","بُلوغُ الأماني ونبلُ الأمل",30,"ل",1,0],["وَفَيْضُ دُمُوعِي كَالسَّحَابِ الْهَوَامِلِ","وقَفْتُ وَمَا رَقُّوا لِوَقْفَةِ سَائِلِ",31,"ل",1,0],["وفيض وادي الخير والبركات من","يديه فأضحى في المحاسن مُفردا",32,"د",2,0],["وَفَيْضُكَ الفَيْضُ الرَواءُ طَغَمُهْ","إِذَا تَسامَى مَدَّهُ قَلَيْذَمُهْ",33,"م",2,0],["وفيضك مبذول لكل مؤمل","وقدرك مرفوع على كل رتبة",34,"ه",1,0],["وفيضه للمرجى","بالسؤل والصد يطفح",35,"ح",1,0],["وفيض نداه \"يشرح\" الحال إنه","يمد الحيا في \"السمحُ إذ يستمدُّه",36,"د",2,0],["وفي ضوئك الباهي سروا وتجملوا","بما فيك يا ربّ الهدى من محامد",37,"د",1,0],["وفيض يدٍ من الوسمي أندى","إذا الحي اشتكى سنةً أزاما",38,"م",2,0],["وفَيضٌ للمواهِبِ والعَطَايا","إذا ما أجهَدَ الزّمنُ العَسِيرُ",39,"ر",1,0],["وفي ضَمانِكَ أَن تَروى من العَلقِ","ظُبى السُّيوفِ وأَطرافُ القَنا السُّلُبِ",40,"ب",1,0],["وفي ضربِهِ عِندَ القِدَاحِ مُرَوَّعاً","وَمَن يُرمَ بَينَ العَينِ والأَنفِ يَرهَبِ",41,"ب",1,0],["وفيضاً ليسَ تَحصروهُ طروسٌ","وفَتحاً من لدنّي قد وفاكا",42,"ك",2,0],["وفي ضمنهِ زيارَةُ المصطفى الذي","لهُ خَلَقَ اللَهُ المشارقَ والغَربا",43,"ب",2,0],["وَفَيضُ دُموعِ العَينِ يا ميّ كلَّما","بَدا عَلَمٌ مِن أَرضِكُم لَم يَكُن يَبدو",44,"د",2,0],["وفي ضمن هذا فاذكروني فإنني","لمنتعش منكم على النأي بالذكر",45,"ر",1,0],["وفي ضمانك بعد الله وحدتنا","فاجهد بقومك ان لا يذهبو اشيعا",46,"ع",2,0],["وفي ضمان الله تأييدنا","ومجدنا فيه عزيز الشعار",47,"ر",1,0],["وفي ضيافاتهم قد احدثوا بدعا","يضيق صدرا بها من كان ذا قوم",48,"م",1,0],["وفي ضرب المباسم لي ضروب","من الأهواء أفديه رضابا",49,"ب",2,0],["وَفي ضَلال مُبين اِنتَ تابِعَه","ما بال شَيبِك يَستَهويهِ شَيطان",50,"ن",1,0],["وفيض أياد أوثقت في رقابنا","مكارم كالأطواق محكمة العرى",51,"ر",2,0],["وَفي ضَمانِ اللَّيالي مِنها","ما قَد تَعَالى عَنِ الضَّمانِ",52,"ن",1,0],["وَفي ضجعتي لِلغُسل وَالماءُ نازلٌ","تمثَّل في عَينِي حَنوطٌ وَمغسلُ",53,"ل",1,0],["وَفي ضِفاف الرُوح مِن مُلتَقى","دُنياي يَرتاح النجيّان",54,"ن",1,0],["وفي ضبابٍ من التَّفْريطِ يَلْفَحُنا","والرُّوحُ مِن كثرةِ الأهواءِ تَختنِقُ",55,"ق",1,0],["وَفِي ضَبْطِ وَقْتِ الطَّعَامِ يُرَبِّي","عَلَىٰ دِقَّةِ الْوَقْتِ وَالْإِلْتِزَامْ",56,"م",1,0],["وفيض رحمته ينهل منسجماً","على البرية يستجليه رضوانُ",57,"ن",1,0],["وفي ضمد أشجى نفوسا وفي الريا","ض احتفى يوما بساحات معهد",58,"د",1,0],["وفيض نداه من الأرض تنسو","خمائلها ويخضر الجناب",59,"ب",1,0],["وفي ضمة التوديع قبل عارضا","له عن طراز الحزن أبدى مواسما",60,"م",2,0],["وفيض معروفه في الأرض قد شبعت","منه الأوابد والعقبان والرخم",61,"م",1,0],["وفي ضميرك ودت أن تكفنك ال","علياء لو كان منه ينسج الكفن",62,"ن",1,0],["وفيضَ العطاء السخيّ المرجّى","وغيثَ الرضا في مدى الناظرِ",63,"ر",1,0],["وفيضي على الإنسان فكرا ورفعة","أضيئي على الأكوان نجما يمانيا",64,"ي",2,0],["وفيضُ الماءِ كأسٌ كوثريٌ","إذا أوردتَه تزدادُ وِردا",65,"د",2,0],["وفيضُ العشقِ ينسابُ","على قلبٍ بما يَعِدُ",66,"د",1,0],["وَفيضُ نبْعِكمُ لِلآنَ حاضرةٌ","آثارُها ألَقٌ حتّى وإن نَكَروا",67,"ر",3,0],["وفيضُ بوحكِ بحرٌ لا حدودٓ لهُ","تاهٓ الجٓنانُ بهِ ..والسمعُ والبصرُ",68,"ر",1,0],["وَفَيضٌ رَبيعيٌّ ، ودربٌ مُطرز","ونورٌ وأنوارٌ وسعدٌ مُسطرُ",69,"ر",1,0],["وفيضَ لها طبٌّ فلاءمَ بينها","صناعٌ إذا ولَّيتهُ متأنِّقُ",70,"ق",1,0],["وفي ضمن فرحة ِ عوذي جوى ً","يدلُّ على أنّني موجعُ",71,"ع",1,0],["وفي ضجّة الحيِّ في زحمة الطَّ","ريقِ وفي المركب العابر",72,"ر",1,0]]}