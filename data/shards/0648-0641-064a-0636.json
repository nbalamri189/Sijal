{"poems":[[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[34,"وفى عروة العذري إن مت أسوة","https://www.aldiwan.net/poem4879.html","الطويل"],[37,"وفي ضبن حقف يراجعنه","https://www.aldiwan.net/poem7310.html","المتقارب"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[45,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[66,"أدرها بأمن لا يغيرك الوهم","https://www.aldiwan.net/poem40294.html","الطويل"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[34,"وفي عُروة َ العذريِّ إِنْ مُتُّ أسوة","https://www.poetsgate.com/ViewPoem.aspx?id=22460",""],[141,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[141,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[179,"وفى عروة العذرى إن مت أسوة","https://www.aldiwan.net/poem58853.html","الطويل"],[209,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[268,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[413,"أمر بها مع الأرواح رند","https://www.aldiwan.net/poem54046.html","الرمل"],[413,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[413,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[436,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[456,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[459,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[513,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[513,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[513,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"]],"verses":[["وفَيْضُ يَدٍ تُجَنُّ على سَماحٍ","وأخرى تَسْتَريحُ إِلى طِعانِ",0,"ن",1,0],["وَفَيضُ دُموعِ العَينِ بِاللَيلِ كُلَّما","بَدا عَلَماً مِن أَرضِكُم لَم يَكُن يَبدو",1,"د",2,0],["وفي ضِبْنِ حِقفٍ يراجعنه","خطافِ وسرحةُ والأحدلُ",2,"ل",1,1],["وَفَيضَ دَمعٍ شَرِقَت مَدافِقُه","مِزاجُهُ مِن أَجَإٍ مُشارِقُه",3,"ق",2,0],["وفي ضَميرِيَ نُصحٌ لستُ أغمدُهُ","عنكم وما نصح ذي نصح بمغمودِ",4,"د",1,0],["وَفَيضَ عَطايا ما تَأَمَّلَ ناظِرٌ","إِلَيهِنَّ إِلّا قالَ فَيضُ غَوادِ",5,"د",1,0],["وَفَيضِ نَوالٍ مِن يَديهِ أَفَدتُهُ","لَهُ في قُلوبِ الناسِ مِن جَسَدي وَسمُ",6,"م",1,0],["وفي ضُلوعِكَ قَلبٌ حَشوُهُ هِمَمٌ","وبَينَ عَينَيكَ عَزمٌ نَوْمُهُ سَهَرُ",7,"ر",1,0],["وَفَيْضُ دُمُوعِ العَيْنِ باللَّيْلِ كُلَّما","بَدَا عَلَمٌ مِنْ أَرْضِكُمْ لم يَكُنْ يَبْدُو",8,"د",2,0],["وَفي ضِمنِ تِلكَ المَكرُماتِ كَرامَةٌ","ظَفِرتُ بِها حُرّاً فَصِرتُ لَها عَبدا",9,"د",2,0],["وَفي ضِمنِ الصَلاةِ لَكُم صَلاةٌ","فَلاحٌ في الإِقامَةِ وَالأَذانِ",10,"ن",1,0],["وَفَيضُ غُرُوبِ العَينِ بِالدّمعِ كُلَّما","بَدَا عَلمٌ مِن أَرضِكُم لم يكُن يَبدُو",11,"و",1,0],["وفي ضريم غرامي","ترى شعاعَ الخلود",12,"د",1,0],["وَفي ضمامٍ وَهوَ وافِد قَومِهِ","سَعد بن بَكرٍ خَير ما حَضّانِ",13,"ن",1,0],["وفي ضياءٍ على ماءٍ يُفَضّضُ ما","شَجا من الكوكبِ الدريِّ مطلعه",14,"ع",2,0],["وفيض علومه للناس جهراً","يدلُّ بأنَّهُ بحرٌ مُمدّ",15,"د",1,0],["وفي ضمن لحن القول لولا موانعٌ","دقائق لا تخفى على من تأمَّلا",16,"ل",2,0],["وفيض يدٍ يكاد البحر منها","على طولِ المدى أن يستمدَّا",17,"د",2,0],["وفَيْضُ يمينِهِ والحمدُ يَغْلُو","ونورُ جبينهِ والحربُ تَغْلي",18,"ي",1,0],["وفي ضمن فرحةِ عَودي جوىً","يدلّ على أنني موجَعُ",19,"ع",1,0],["وفيضَ عَبْرته من حُسن عِبْرته","بالذَّاهبين أولي النَّعماءِ والنَّجَدِ",20,"د",1,0],["وفي ضحوة الإثنين سكن جأشها","وشد قواها والبلاء شديد",21,"د",1,0],["وفي ضمير الملك من حبه","سريرة لابد ما تظهر",22,"ر",1,0],["وفي ضحوة الاثنين لولا دفاعه","لما كان كسر الملك والدين يجبر",23,"ر",1,0],["وفِيَّ ضدّانِ لا أسطيعُ دَفْعَهُما","نارٌ بقلبي وماءٌ بالهوى سَفَحا",24,"ح",2,0]]}