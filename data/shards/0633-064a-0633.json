{"poems":[[55,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[65,"سرى البرق والمزن مرخى العزالي","https://www.aldiwan.net/poem45700.html","المتقارب"],[53,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[53,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[94,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[80,"وطرد الناس بين يدي ممري","https://www.aldiwan.net/poem14218.html","الوافر"],[30,"ألم تر جنبي عن فراشي جفا به","https://www.aldiwan.net/poem5434.html","الوافر"],[99,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[83,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[48,"سيسأل ناس ما قريش ومكة","https://www.aldiwan.net/poem23280.html","الطويل"],[48,"إذا ماتبينا الأمور تكشفت","https://www.aldiwan.net/poem23292.html","الطويل"],[108,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[92,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[30,"ألم تر جنبي عن فراشي جفا به","https://www.poetsgate.com/ViewPoem.aspx?id=22003",""],[101,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[124,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[164,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[275,"أرى علمنا والمدعون بنوه","https://www.aldiwan.net/poem35066.html","الطويل"],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[376,"سيسأل من آذى النبي وأله","https://www.aldiwan.net/poem56944.html","الطويل"],[382,"ألحي قبلا هو القدوس ثم هو","https://www.aldiwan.net/poem59419.html","الطويل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[567,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138199",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145850","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119954","السريع"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131425","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201568","المنسرح"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147360","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132748","السريع"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104289","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34600","الطويل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97077","الكامل"],[4755,"لَيلٌ.. وصَنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203125",""],[4778,"واسي العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=206294",""],[4929,"ارهاصات النهاية","https://www.poetsgate.com/ViewPoem.aspx?id=199351",""],[4955,"إذا ما خدعت ببعض البشر","https://www.poetsgate.com/ViewPoem.aspx?id=187748",""],[5273,"صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=183084",""],[5277,"حواء..ولدتني شمساً..وأولدتُها قمرين","https://www.poetsgate.com/ViewPoem.aspx?id=192760",""],[5277,"ذاكرةُ الرماد...","https://www.poetsgate.com/ViewPoem.aspx?id=198358",""],[5365,"مالم تقلهُ زرقاءُ اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=190408",""],[5431,"إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=191707",""],[5431,"أبي وسرمد تحنان على شفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192441",""],[5431,"لقد شطبَ اليماني الإمامه...","https://www.poetsgate.com/ViewPoem.aspx?id=200001",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[5758,"سلامٌ على الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=200499",""],[5804,"الاقتراب الخطير","https://www.poetsgate.com/ViewPoem.aspx?id=180656",""],[5829,"حوار مع زائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178324",""],[5952,"غنائي ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=205982",""],[5956,"مهما أعش لن أرتوي من وصلكم","https://www.poetsgate.com/ViewPoem.aspx?id=193098",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""],[6093,"عند قبر","https://www.poetsgate.com/ViewPoem.aspx?id=192004",""],[6093,"حَبْرُ المدينةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199237",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[5309,"ضل رهط الأثرياء","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573890",""]],"verses":[["سَيُسكِتُني يَأسي وَفي الصَدرِ حاجَةٌ","كَما أَنطَقَتني وَالرِجالَ المَطامِعُ",0,"ع",1,1],["سَيَسمو بِيَ المَجدُ حَتَّى تَنالَ","يَميني السُّها وَالثُّرَيّا شِمالي",1,"ل",2,0],["سَيسْقي بني الدنيا كؤوسَ حتوفهم","إلى أن يناموا لا منامَ سُباتِ",2,"ت",1,0],["سيسألني الأقوام عما أثبْتني","به فبماذا أنت إياي آمر",3,"ر",1,0],["سيُسليك الشبيبةَ أرْيَحِيٌّ","بجودِ يديْه أورقتِ السِّلامُ",4,"م",1,0],["سَيُسْمَعُ صوتٌ كَلَحْنٍ شجيٍّ","تطايَرَ مِنْ خَفَقَاتِ الوَتَرْ",5,"ر",1,0],["سَيُسلي النَفسَ عمَّن فاتَ عِلمي","بِأَنَّ الكُلّ يُدرِكُهُ الفَناءُ",6,"ا",2,0],["سَيَسمَعُ مَن يَعوي إِلَيَّ وَقَومُهُ","عَوائِرَ مِنّي يَصدَعُ الصَخرَ قيلُها",7,"ل",3,0],["سيستمر المسرح الأعظم","روايةً طالت وأين الستار",8,"ر",1,0],["سَيَسيرُ هَذا الشَهرُ قَبلَ أَوانِهِ","إِذ لَم يَسعهُ لِما صَنَعتِ مَقامُ",9,"م",1,0],["سَيَسأَلُ ناسٌ ما قُرَيشٌ وَمَكَّةٌ","كَما قالَ ناسٌ ما جَديسٌ وَما طَسمُ",10,"م",1,1],["سَيُسليكَ أَنَّ القابِضَ باسِطٌ","وَأَنَّ الَّذي شادَ البَنِيَّةَ هادِمُ",11,"م",1,0],["سيَسودُ آخرُنا بفضلِ وقوفِنا","صفًّا، كما سار الرَّعِيلُ الأَوَّل",12,"ل",1,0],["سيسوء بعضاً ما أرى إثباتَه","ويسُرُّ بعضاً ما أرى ان يُرفَضا",13,"ض",2,0],["سَيَسْمَعُ مَنْ يَعْوي إليّ وَقَوْمُهُ","عَوَائِزَ مِني يَصْدَعُ الصّخرَ قِيلُهَا",14,"ل",3,0],["سيسألُ عنا الرعاة الشيوخُ","وتبكي العصافير أصحابُنا",15,"ن",2,0],["سيسقي الردى قلبي عن الحسن سلوةً","فلا بت حران الجوانح صاديا",16,"ي",2,0],["سيسفر الحق عن لألاء غرته","يوما ويصبح وجه الزور منتقبا",17,"ب",2,0],["سيسأل قومٌ من زكيٌّ مباركٌ","وجسمي مدفون بصحراء صماء",18,"ا",2,0],["سيستقلّ بنَصْري صولةً ذَكَرٌ","وصارِمٌ ليس يَنْبو حَدُّه خَذِمُ",19,"م",1,0],["سَيَسطع في جوِّ الحقيقةِ كوكبٌ","ينيرُ سبيلاً مُظلِماً سَلكوه",20,"و",2,0],["سيُسْرِعُ بي ما بقَلْبي إليكَ","ولو أنّ حَدَّ الحُسامِ الطّريق",21,"ق",1,0],["سَيُسألُ من آذَى النبيَّ وألَه","بِماذا خَلَفتُم لا خَلَفتُم مُحمَّدا",22,"د",2,1],["سيستقر ببكرٍ ما مقدسةٍ","سلطانةٍ ولها الأملاك أنصار",23,"ر",1,0],["سيسجد يوم الحشر كرها له على","صفايح من نار سجوداً مكرّرا",24,"ر",2,0],["سَيَسيلُ النَّهران ِسَيلَ البَراكين","وتَهوي بالنّارِ سَبْعٌ طِباقُ",25,"ق",1,0],["سيسلِّمُ الدَّعوى إليهِ كارهاً","مَن لم يكن طَوْعاً إليهِ مُسَلِّما",26,"م",2,0],["سيسطر التاريخ خير صحائف","لكما بتبر ينبغي أن تكتما",27,"م",2,0],["سيَسحبُنا حَبْلُهُ طالما","نُؤلّهُ بالحَبلِ والساحِبِ",28,"ب",1,0],["سيسر ولكن لا يساوي إذا","نودي عليه أجرة السائسِ",29,"س",1,0],["سيَستَبشِرُ البيت الحرامُ وزمزَمٌ","بأمّ وليّ العهد زينِ المواسمِ",30,"م",1,1],["سيستوي الموت والحياة لنا","إذا غدونا نعيش أجساما",31,"م",2,0],["سَيُسَطِّرُ النِّسْيَانُ وَرْدَ دَقَائِقِي","وَتُسَيِّجُ الأَوهَامُ نَثْرَ تُرَابِي",32,"ب",2,0],["سيسترد من عزنا","ما عرضته لندن للهوان",33,"ن",1,0],["سيسجل التاريخ كل صغيرة","وكبيرة بوثائق الأسفار",34,"ر",1,0],["سيسأل كل الناس عنك فيعلموا","بأنك أغلى أن تثمن بالرخص",35,"ص",1,0],["سيُسليك عما فات دولةُ مُفضِلٍ","أوائلُه محمودةٌ وأواخرُه",36,"ر",2,0],["سيسعى لما كنت تسعى له","ويحرز بالسعي سبقاً كثيرا",37,"ر",2,0],["سيسد ثغر الدين في","أسد لأخذ الثار ثائر",38,"ر",1,0],["سَيَسألُ اللهُ صَنعَا عِندَ مَحشَرِها","عَنِ اغتِرابِي، وعَن شَوقِي، إلى الأَبَدِ",39,"د",1,0],["(سيسلبونك بغدادٌ وجلقةٌ","ويتركونك لا لحما ولا عصبا)",40,"ب",2,0],["سيسقطون بلاشكٍّ ولو دفعتْ","شعوبنا ثمنًا في ذاك مرتفِعَا",41,"ع",2,0],["سيسقطُ عنهم قناعُ النّفاقِ","ويسعونَ كيما تذوقَ الأَمَرْ",42,"ر",1,0],["سيسألُكِ الصّباحُ عنِ القوافي","ويلهثُ خلفَ أسبابِ انصرافي",43,"ف",2,1],["سيسري في شفاهي الآنَ دفءٌ","بما أبدتْ شفاهُ الصبِّ رجفا",44,"ف",2,0],["سيسكت الناس عن جرحي وأفتحه","كما أبوحُ بأشعاري من الكلمِ",45,"م",1,0],["سيسقطون وتبقى شامخاً أبداً","سيسقطون وتبقى واحداً وطَنَا",46,"ن",2,0],["سيسجد القلب طوع الحب في ظللٍ","من الغرام على آلائها جلسا",47,"س",2,1],["سيسأل العشق عن ظبيٍ رآه هنا","هل يرتضي العشب بين الصدر إذْ يفدُ؟",48,"د",1,0],["سيسطع في هزيع العُرْب نجمٌ","يمانيٌّ ويكشف ما أمامه!",49,"م",2,0],["سيَسُودُ دِينُ الله أَرْضَ عِبادِه","حَتَّى تُعمَّرَ بالطُّيُوبِ سَماؤُها",50,"ا",3,0],["سَيَسْأَلُ يَوْمًا نَبْضَ مَاءٍ مُسَافِرٍ","هَلِ العَابِرُونَ اسْتَوْطَنُوا فِي المَسَاكِنِ",51,"ن",1,0],["سيسمحُ الحبُّ لأحبابِهِ","وتلتقي أقدارُنا في مسارْ",52,"ر",1,0],["سيسود من بعد الذي .",". تلقاه خير مستحل",53,"ل",1,0],["سيسقيك شعراً وتبقين دهراً","تعيشين قهراً بقولٍ هراء",54,"ا",2,0],["سيسير أحفادي على نهجِ الهدى","نحو العُلا يحميهم الرحمنُ",55,"ن",1,0],["سيسره مبنى بناه على تقى","ويسر منه المسلمين ثناء",56,"ا",2,0],["سَيَسْعَى إِلى قَبْرِ الحَبِيْبِ مُسَلِمًا","عَلَى رُوْحِ مَنْ يَهْوَى وَ يَعْلُو نَحِيْبُهُ",57,"ب",2,0],["سَيسوقُنا مَوت ٌ كسَو","قٍ للجُفاةِ مِنَ الرُّعاةْ",58,"ا",2,0],["سَيَسْخَرُ مَوْهُوْمٌ وَ يَغْتَاظُ كَارِهٌ","وَ يَشْغَلُهُ لَوْمٌ , وَ يُضْرِمُهُ حُمْقُ",59,"ق",1,0],["سَيسيرونَ طَويلاً","وَمَساعيهِم هَباء",60,"ا",2,0]]}