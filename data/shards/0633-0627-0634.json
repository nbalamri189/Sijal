{"poems":[[53,"رضينا الظبى من عناق الظبا","https://www.aldiwan.net/poem30773.html","المتقارب"],[42,"سأشكر عمرا ما تراخت منيتي","https://www.aldiwan.net/poem50242.html","الطويل"],[86,"أحامد كيف تنساني وبيني","https://www.aldiwan.net/poem68839.html","الوافر"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[47,"سلي فتيات هذا الحي عني","https://www.aldiwan.net/poem25127.html","الوافر"],[72,"سأشكر نعماك التي من أقلها","https://www.aldiwan.net/poem18947.html","الطويل"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[70,"أما آن للبدر المنير طلوع","https://www.aldiwan.net/poem42827.html","الطويل"],[70,"لأي جميل من جميلك أشكر","https://www.aldiwan.net/poem42919.html","الطويل"],[70,"مقيم على العهد من صبوتي","https://www.aldiwan.net/poem42995.html","المتقارب"],[70,"وزائرة زارت وقد هجم الدجى","https://www.aldiwan.net/poem43005.html","الطويل"],[56,"أما آن للطيف أن يأتيا","https://www.aldiwan.net/poem58478.html","المتقارب"],[43,"جارية ما لجسمها روح","https://www.aldiwan.net/poem9523.html","المنسرح"],[45,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[45,"تمادى اللائمون وفي فؤادي","https://www.aldiwan.net/poem63469.html","الوافر"],[45,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[45,"عليك السلام أيها القمر البدر","https://www.aldiwan.net/poem63569.html","الطويل"],[45,"قد سلم الله من الهجر","https://www.aldiwan.net/poem64521.html","السريع"],[61,"كملن فأطلعن البدور كواملا","https://www.aldiwan.net/poem51486.html","الطويل"],[61,"تلاف السهم أثبت في الشغاف","https://www.aldiwan.net/poem51548.html","الوافر"],[49,"سقيت الغيث يا قصر السلام","https://www.aldiwan.net/poem64905.html","الوافر"],[66,"سأشكر نعماك التي لو جحدتها","https://www.aldiwan.net/poem41345.html","الطويل"],[44,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[44,"سأشكر لابني وهب الهبة التي","https://www.aldiwan.net/poem30340.html","الطويل"],[81,"قبولك ريعان الشباب فلا ولى","https://www.aldiwan.net/poem61420.html","الطويل"],[81,"سأشكر منك العقوق الذي","https://www.aldiwan.net/poem61542.html","المتقارب"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[48,"سأشكر للذكرى صنيعتها عندي","https://www.aldiwan.net/poem62567.html","الطويل"],[48,"لقد جن من يبكي على رسم منزل","https://www.aldiwan.net/poem64510.html","الطويل"],[48,"طرحتم من الترحال ذكرا فغمنا","https://www.aldiwan.net/poem66141.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85472","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85328","المتقارب"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140885",""],[53,"رضينا الظبي من عناق الظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9813&r=&rc=10",""],[120,"سأشكو إلى الندمان خمر زجاجة","https://www.aldiwan.net/poem4337.html","الطويل"],[136,"نعم أذكرتني حين هبت صبا نجد","https://www.aldiwan.net/poem49118.html","الطويل"],[144,"محل لهم بين النقا والأجارع","https://www.aldiwan.net/poem11772.html","الطويل"],[144,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[144,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[148,"ولم أر أعظم من نعمة","https://www.aldiwan.net/poem47638.html","المتقارب"],[153,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[186,"عليك ثناء العالمين فصيح","https://www.aldiwan.net/poem14142.html","الطويل"],[212,"يا ليلة العيد ماذا أنت صانعة","https://www.aldiwan.net/poem46320.html","البسيط"],[230,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[238,"تركنا البحار الزاخرات وراءنا","https://www.aldiwan.net/poem19281.html","الطويل"],[271,"إذا نفحت ريح أقول سلاما","https://www.aldiwan.net/poem35581.html","الطويل"],[271,"ليالي قلت إن عددت اللياليا","https://www.aldiwan.net/poem35618.html","الطويل"],[281,"دعاني الأمير فلبيته","https://www.aldiwan.net/poem60590.html","المجتث"],[281,"متى أنا طاعن قلب الفجاج","https://www.aldiwan.net/poem60722.html","الوافر"],[281,"سأشكر ما مننت به ومثلي","https://www.aldiwan.net/poem60758.html","الوافر"],[283,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[298,"إليك فقلبي لا تقر بلابله","https://www.aldiwan.net/poem33195.html","الطويل"],[347,"أمن شربة من ماء كرم شربتها","https://www.aldiwan.net/poem24111.html","الطويل"],[360,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[417,"بدا ورنت لواحظه دلالا","https://www.aldiwan.net/poem53886.html","الوافر"],[417,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[435,"سأشكر للحمام بدءا وعودة","https://www.aldiwan.net/poem25696.html","الطويل"],[447,"قتيل ما قتيل المرء عمرو","https://www.aldiwan.net/poem23927.html","الوافر"],[462,"أقول وقد ضاقت قوافي مدائحي","https://www.aldiwan.net/poem16433.html","الطويل"],[465,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[514,"قصرت عليك النفس حتى توهمت","https://www.aldiwan.net/poem67784.html","الطويل"],[568,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"]],"verses":[["سَأَشدو بِذِكرِكِ ما اِستَعبَرَت","مَطِيٌّ يُسَلِّمُ فيها الوَجى",0,"ا",1,0],["سَأَشكُرُ عَمراً ما تَراخَت مَنيَّتي","أَياديَ لَم تُمنَن وَإِن هيَ جَلَّتِ",1,"ت",1,1],["سَأَشكو لِلوَزيرِ فَإِن تَوانى","شَكَوتُكَ بَعدَهُ لِلمُستَشارِ",2,"ر",1,0],["سَأَشكُرُ أَنَّكَ أَعلَيتَني","بِأَحظى مَكانٍ وَأَدنى مَحَلّ",3,"ل",1,0],["سَأَشكُرُ أَن رَدَدتَ عَلَيَّ ريشي","وَأَثبَتَّ القَوادِمَ في جَناحي",4,"ح",2,0],["سَأُشهِدُها عَلى ماكانَ مِنّي","بِبَسطي في النَدى بِكَلامِكُنَّه",5,"ن",2,0],["سأشكر نعماك التي من أقلّها","قطائف من قطر النبات لها بحر",6,"ر",1,1],["سأشكو الحزنَ ما بقيت حياتي","وأشكر في صنائعه الجمالا",7,"ل",2,0],["سأشكو إلى مستنكرِ النُّكر قاسمٍ","فينظر في أمري بناظرتَيْ صقر",8,"ر",1,0],["سَأَشكُرُ هَذا الدَهرَ يَومَ لِقائِهِ","وَإِن كانَ دَهراً لَم يَزَل وَهوَ خَوّانُ",9,"ن",1,0],["سَأَشكُرُ حُبّاً زانَ فيكَ عِبادَتي","وَإِن كانَ فيهِ ذِلَّةٌ وَخُضوعُ",10,"ع",1,0],["سَأَشكو نَدىً عَن شُكرِهِ رُحتُ عاجِزاً","وَمِن أَعجَبِ الأَشياءِ أَشكو وَأَشكُرُ",11,"ر",1,0],["سَأَشكُرُها مادُمتُ حَيّاً وَإِن أَمُت","سَأَنشُرُها في مَوقِفي حينَ أُنشَرُ",11,"ر",1,0],["سَأَشكُرُها أَبَداً مابَقيتُ","وَإِن عَظُمَت بَعدَها حَسرَتي",12,"ت",2,0],["سَأَشكُرُ كُلَّ الشُكرِ إِحسانَ مُحسِنٍ","تَحَيَّلَ حَتّى زارَني وَتَسَبَّبا",13,"ب",2,0],["سأَشْكُرُ ذلكَ لا ناسِياً","جَميلَ الصَّفَاءِ ولا قَالِيا",14,"ي",2,0],["سَأَشرَبُ الكَأسَ عَن إِشارَتِها","وَدَمعُ عَيني في الخَدِّ مَسفوحُ",15,"ح",1,0],["سَأَشكُرُ نُعماكَ المُرَفرِفَ ظِلُّها","عَلَيَّ وَهَل أَنسى رَبيعَ بِلادي",16,"د",2,0],["سَأَشكُرُ مِن عُبَيدِ اللَهِ نُعمى","تَقَدَّمَ عائِدٌ مِنها وَبادِ",17,"د",1,0],["سَأَشكُرُ مِن نُعماكَ آلاءَ مُنعِمٍ","وَجَدتُ طَريفي كُلُّهُ مِن تِلادِها",18,"د",3,0],["سَأَشكُرُ لا أَنّي أُجازيكَ نِعمَةً","بِأُخرى وَلَكِن كَي يُقالَ لَهُ شُكرُ",19,"ر",1,0],["سَأَشكُرُ الصَبرَ وَإِنعامَهُ","أَعانَني اللَهُ عَلى الشُكرِ",20,"ر",1,0],["سأشكُرُ إنعامَ الامير وفضلَه","فقد ألبساني أنعُماً وفَضائِلا",21,"ل",2,0],["سأشفي الشِّعْرَ منك بِنَظْمِ شِعْرٍ","تَبيتُ له على مثلِ الأثافي",22,"ف",2,0],["سَأَشكُرُ نِعمَةَ المَهدِيِّ حَتّى","تَدورَ عَلَيَّ دائِرَةُ الحِمامِ",23,"م",1,0],["سَأَشكُرُ نُعماكَ الَّتي لَو جَحَدتُها","أَقَرَّ بِها حالي وَنَمَّ بِها سِرّي",24,"ي",1,1],["سَأَشكُرُ فَرجَةَ اللَبَبِ الرَخِيِّ","وَلينَ أَخادِعِ الدَهرِ الأَبِيِّ",25,"ي",1,0],["سَأَشكُرُ لِاِبنَي وَهبٍ الهِبَةَ الَّتي","هِيَ الوُدُّ صاناهُ بِحُسنِ صِيانِهِ",26,"ن",2,1],["سَأَشكُرُ ما أَولَيتني وَلَو أَنَّني","سَكَتُّ لَكانَت حالَتي مَنطِقاً فَصلا",27,"ل",2,0],["سَأَشكُرُ مِنكَ العُقوقَ الَّذي","نَهى شَغَفي عَنكَ شُكرَ النَصيحَة",28,"ح",2,1],["سأشكركَ النُّعْمَى عليَّ وإنّني","بذاك لَواني الشّأوِ عنك مُرهَّقُه",29,"ق",2,0],["سَأَشكُرُ لِلذِكرى صَنيعَتَها عِندي","وَتَمثيلَها لي مَن أُحِبُّ عَلى البُعدِ",30,"د",1,1],["سَأَشرَبُها صِرفاً وَإِن هِيَ حُرِّمَت","فَقَد طالَما واقَعتُ غَيرَ مُحَلَّلِ",31,"ل",1,0],["سَأَشكو إِلى الفَضلِ اِبنِ يَحيا اِبنِ خالِدٍ","هَواكِ لَعَلَّ الفَضلَ يَجمَعُ بَينَنا",32,"ن",2,0],["سأشط عَن وَطَني الحَبيب مخلِّفاً","صحبي هناك وأُسرَتي وَقَبيلي",33,"ل",2,0],["سأَشرب بالرغم كأس الردى","ولو أنها الصاب والعلقم",34,"م",1,0],["سأشرب الكأس من إشارتها","ودمع عيني في الخد مسفوح",35,"ح",1,0],["سَأشدُوا بذِكْرِكَ ما استَعبَرَتْ","مَطِيٌّ يُثَلِّمُ فيها الوَجَى",36,"ا",1,0],["سأشكو إلى الندمان خمرَ زجاجةٍ","تردّت بثوبٍ حالكِ اللونِ أسحَمِ",37,"م",1,1],["سأشغل فكري ما حييتُ بمدحهِ","وإني إذا ما متُّ أمدح في لحدي",38,"د",2,0],["سَأَشكُرُ ما دامَ الكَلامُ يُطيعُني","صُنوفاً أَتَت مِن جودِكَ المُتَتابِعِ",39,"ع",1,0],["سَأَشكُرُها مُبيناً عَن ثَناءٍ","يُقَصِّرُ عَن مَداهُ مَن يُطيلُ",40,"ل",1,0],["سَأَشكُرُ رَأياً مُنقِذِيّاً أَحَلَّني","ذَراكَ لَقَد أَولى جَميلاً وَأَنعَما",41,"م",2,0],["سأشكرها شكر وقت السرور","وأذكرها ذكر وقت الشباب",42,"ب",1,0],["سَأُشْرِقُ فِي اليَوْمِ، أَوْ فِي غَدٍ","فَإِنَّ المَقَادِيرَ جَزْرٌ وَمَدُّ",43,"د",1,0],["سأشكر ما أوليتموا يا بني أبى","شُجاعٍ ولو أضْحى علىَّ ضريح",44,"ح",1,0],["سأشرب الثكل وحدى لا ظفرت به","ولا غدا من أرجيه بمفقود",45,"د",1,0],["سأشفى ببَرْد اليأَس غُلَّةَ ذا الهوى","وإن لم يُبَرِّدها النوى واللّوائم",46,"م",1,0],["سَأَشْكُو إِلَى مَثْوَاكَ أَيْضاً نُفُوسَنَا","فَقَدْ أَقْسَمْتَ أَلاَّ تُجِيبَ دُعَاءَنَا",47,"ن",2,0],["سأشكُرُ ما أوليتني فاذكُري فَتَىً","على العهدِ والمعروفِ منكِ أقاما",48,"م",2,0],["سأشرَبُها في كأسِ وهمي مدامةً","وأنظُمُها في سلكِ شِعري لآليا",49,"ل",3,0],["سَاَشْكُرُ ما دُمْتُ فِي الْعالَمِينَ","مَكارِمَ أَحْسَنَّ فِيكَ اصْطِناعِي",50,"ع",2,0],["سَأَشْكُرُ حادِثاً ألْقى زِمامِي","إِلَيْكَ وَرُبَّ أَمْنٍ فِي انْزِعاجِ",51,"ج",1,0],["سَأَشْكُرُ ما مَنَنْتَ بِهِ وَمِثْلِي","لأَهْلِ الْمَنِّ فَلْيَكُنِ الشَّكُورُ",52,"ر",1,1],["سَأَشكُرُ دَهري يا اِبنَ شُكرٍ لأَنَّهُ","بِهِ تابَ حَتّى صارَ يُحسِنُ فِعلَهُ",53,"ل",2,0],["سأَشكُرُ ما أَهدَيتَ لي من أَزاهرٍ","يَجولُ عليها من نَدى الحُسن جائلُه",54,"ل",2,0],["سَأَشرَبُ فَاِغضَب لا رَضيتَ كِلاهُما","حَبيبٌ إِلى قَلبي عُقوقُكَ وَالخَمرُ",55,"ر",1,0],["سأشرح ما قد كان في سيرةٍ جَرَت","من الدوحة العَليا الفلاحيةِ الغَرَّا",56,"ر",2,0],["سأشكو الحبَّ ما بَقِيَتْ حياتي","وأشكرُ من صنائعه الجمالا",57,"ل",2,0],["سَأشكرُ فضلَك الضّافي وأدعو","لمجدك بالدعاء المستجاب",58,"ب",1,0],["سأشْكُرُ لِلْحَمَّامِ بَدْءاً وَعَوْدَةً","أَيادي بِيضاً ما لهُنَّ ثَمينُ",59,"ن",1,1],["سَأَشرَبُ كَأسَها صِرفاً وَأَسقي","بِكَأسٍ غَيرِ مُنطِقَةٍ مُليمِ",60,"م",1,0],["سَأشْفَعُ مَدْحي والدُّجى مُرْجَحِنَّةٌ","وللنَّوْمِ عِندي جَيْئَةٌ وذَهابُ",61,"ب",1,0],["سأشكرهُ شكرّ الرياض يد الحيا","سرى خضلَ الشؤبوب وهو ركامُ",62,"م",1,0],["سأشكر ذنب الدهر فيك ولم أكن","على غير الأيام أشكر مذنبا",63,"ب",2,0],["سَأَشْكُو الزَّمَانَ فَقَدْ مَسَّنِي","بِنُصْبٍ إِلَى الحَسَنِ بِنِ الحَسَنْ",64,"ن",1,0]]}