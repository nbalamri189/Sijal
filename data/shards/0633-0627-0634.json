x?id=203580",""],[5410,"مُباح اللهو في يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[5431,"سأخبر ربي","https://www.poetsgate.com/ViewPoem.aspx?id=185607",""],[5431,"في ذمة الحب....","https://www.poetsgate.com/ViewPoem.aspx?id=199952",""],[5545,"قراب الفقد","https://www.poetsgate.com/ViewPoem.aspx?id=191686",""],[5582,"أَرَى رَسْمَ سُعْدَى فِي فُؤادِيَ راسِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63581",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5674,"نزف الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=196438",""],[5703,"ليلة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=206151",""],[5703,"سيد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=216010",""],[5720,"القِلادَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=214547",""],[5829,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=215729",""],[5956,"العروبة تناجي فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192289",""],[5957,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177510",""],[5988,"سأشكر ما أولى ابن عمروٍ مؤرجٌ","https://www.poetsgate.com/ViewPoem.aspx?id=99712",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6027,"حسرتي الأزلية","https://www.poetsgate.com/ViewPoem.aspx?id=198421",""],[6125,"لماذا الحبُّ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=210965",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""]],"verses":[["سَأَشدو بِذِكرِكِ ما اِستَعبَرَت","مَطِيٌّ يُسَلِّمُ فيها الوَجى",0,"ا",1,0],["سَأَشكُرُ عَمراً ما تَراخَت مَنيَّتي","أَياديَ لَم تُمنَن وَإِن هيَ جَلَّتِ",1,"ت",1,1],["سَأَشكو لِلوَزيرِ فَإِن تَوانى","شَكَوتُكَ بَعدَهُ لِلمُستَشارِ",2,"ر",1,0],["سَأَشكُرُ أَنَّكَ أَعلَيتَني","بِأَحظى مَكانٍ وَأَدنى مَحَلّ",3,"ل",1,0],["سَأَشكُرُ أَن رَدَدتَ عَلَيَّ ريشي","وَأَثبَتَّ القَوادِمَ في جَناحي",4,"ح",2,0],["سَأُشهِدُها عَلى ماكانَ مِنّي","بِبَسطي في النَدى بِكَلامِكُنَّه",5,"ن",2,0],["سأشكر نعماك التي من أقلّها","قطائف من قطر النبات لها بحر",6,"ر",1,1],["سأشكو الحزنَ ما بقيت حياتي","وأشكر في صنائعه الجمالا",7,"ل",2,0],["سأشكو إلى مستنكرِ النُّكر قاسمٍ","فينظر في أمري بناظرتَيْ صقر",8,"ر",1,0],["سَأَشكُرُ هَذا الدَهرَ يَومَ لِقائِهِ","وَإِن كانَ دَهراً لَم يَزَل وَهوَ خَوّانُ",9,"ن",1,0],["سَأَشكُرُ حُبّاً زانَ فيكَ عِبادَتي","وَإِن كانَ فيهِ ذِلَّةٌ وَخُضوعُ",10,"ع",1,0],["سَأَشكو نَدىً عَن شُكرِهِ رُحتُ عاجِزاً","وَمِن أَعجَبِ الأَشياءِ أَشكو وَأَشكُرُ",11,"ر",1,0],["سَأَشكُرُها مادُمتُ حَيّاً وَإِن أَمُت","سَأَنشُرُها في مَوقِفي حينَ أُنشَرُ",11,"ر",1,0],["سَأَشكُرُها أَبَداً مابَقيتُ","وَإِن عَظُمَت بَعدَها حَسرَتي",12,"ت",2,0],["سَأَشكُرُ كُلَّ الشُكرِ إِحسانَ مُحسِنٍ","تَحَيَّلَ حَتّى زارَني وَتَسَبَّبا",13,"ب",2,0],["سأَشْكُرُ ذلكَ لا ناسِياً","جَميلَ الصَّفَاءِ ولا قَالِيا",14,"ي",2,0],["سَأَشرَبُ الكَأسَ عَن إِشارَتِها","وَدَمعُ عَيني في الخَدِّ مَسفوحُ",15,"ح",1,0],["سَأَشكُرُ نُعماكَ المُرَفرِفَ ظِلُّها","عَلَيَّ وَهَل أَنسى رَبيعَ بِلادي",16,"د",2,0],["سَأَشكُرُ مِن عُبَيدِ اللَهِ نُعمى","تَقَدَّمَ عائِدٌ مِنها وَبادِ",17,"د",1,0],["سَأَشكُرُ مِن نُعماكَ آلاءَ مُنعِمٍ","وَجَدتُ طَريفي كُلُّهُ مِن تِلادِها",18,"د",3,0],["سَأَشكُرُ لا أَنّي أُجازيكَ نِعمَةً","بِأُخرى وَلَكِن كَي يُقالَ لَهُ شُكرُ",19,"ر",1,0],["سَأَشكُرُ الصَبرَ وَإِنعامَهُ","أَعانَني اللَهُ عَلى الشُكرِ",20,"ر",1,0],["سأشكُرُ إنعامَ الامير وفضلَه","فقد ألبساني أنعُماً وفَضائِلا",21,"ل",2,0],["سأشفي الشِّعْرَ منك بِنَظْمِ شِعْرٍ","تَبيتُ له على مثلِ الأثافي",22,"ف",2,0],["سَأَشكُرُ نِعمَةَ المَهدِيِّ حَتّى","تَدورَ عَلَيَّ دائِرَةُ الحِمامِ",23,"م",1,0],["سَأَشكُرُ نُعماكَ الَّتي لَو جَحَدتُها","أَقَرَّ بِها حالي وَنَمَّ بِها سِرّي",24,"ي",1,1],["سَأَشرَبُ كَأسَها صِرفاً وَأَسقي","بِكَأسٍ غَيرِ مُنطِقَةٍ مُليمِ",25,"م",1,0],["سَأَشكُرُ فَرجَةَ اللَبَبِ الرَخِيِّ","وَلينَ أَخادِعِ الدَهرِ الأَبِيِّ",26,"ي",1,0],["سَأَشكُرُ لِاِبنَي وَهبٍ الهِبَةَ الَّتي","هِيَ الوُدُّ صاناهُ بِحُسنِ صِيانِهِ",27,"ن",2,1],["سَأَشكُرُ ما أَولَيتني وَلَو أَنَّني","سَكَتُّ لَكانَت حالَتي مَنطِقاً فَصلا",28,"ل",2,0],["سَأَشكُرُ مِنكَ العُقوقَ الَّذي","نَهى شَغَفي عَنكَ شُكرَ النَصيحَة",29,"ح",2,1],["سأشكركَ النُّعْمَى عليَّ وإنّني","بذاك لَواني الشّأوِ عنك مُرهَّقُه",30,"ق",2,0],["سَأَشكُرُ لِلذِكرى صَنيعَتَها عِندي","وَتَمثيلَها لي مَن أُحِبُّ عَلى البُعدِ",31,"د",1,1],["سَأَشرَبُها صِرفاً وَإِن هِيَ حُرِّمَت","فَقَد طالَما واقَعتُ غَيرَ مُحَلَّلِ",32,"ل",1,0],["سَأَشكو إِلى الفَضلِ اِبنِ يَحيا اِبنِ خالِدٍ","هَواكِ لَعَلَّ الفَضلَ يَجمَعُ بَينَنا",33,"ن",2,0],["سأشط عَن وَطَني الحَبيب مخلِّفاً","صحبي هناك وأُسرَتي وَقَبيلي",34,"ل",2,0],["سأَشرب بالرغم كأس الردى","ولو أنها الصاب والعلقم",35,"م",1,0],["سأشرب الكأس من إشارتها","ودمع عيني في الخد مسفوح",36,"ح",1,0],["سَأشدُوا بذِكْرِكَ ما استَعبَرَتْ","مَطِيٌّ يُثَلِّمُ فيها الوَجَى",37,"ا",1,0],["سأشكو إلى الندمان خمرَ زجاجةٍ","تردّت بثوبٍ حالكِ اللونِ أسحَمِ",38,"م",1,1],["سأشغل فكري ما حييتُ بمدحهِ","وإني إذا ما متُّ أمدح في لحدي",39,"د",2,0],["سَأَشكُرُ ما دامَ الكَلامُ يُطيعُني","صُنوفاً أَتَت مِن جودِكَ المُتَتابِعِ",40,"ع",1,0],["سَأَشكُرُها مُبيناً عَن ثَناءٍ","يُقَصِّرُ عَن مَداهُ مَن يُطيلُ",41,"ل",1,0],["سَأَشكُرُ رَأياً مُنقِذِيّاً أَحَلَّني","ذَراكَ لَقَد أَولى جَميلاً وَأَنعَما",42,"م",2,0],["سأشكرها شكر وقت السرور","وأذكرها ذكر وقت الشباب",43,"ب",1,0],["سَأُشْرِقُ فِي اليَوْمِ، أَوْ فِي غَدٍ","فَإِنَّ المَقَادِيرَ جَزْرٌ وَمَدُّ",44,"د",1,0],["سأشكر ما أوليتموا يا بني أبى","شُجاعٍ ولو أضْحى علىَّ ضريح",45,"ح",1,0],["سأشرب الثكل وحدى لا ظفرت به","ولا غدا من أرجيه بمفقود",46,"د",1,0],["سأشفى ببَرْد اليأَس غُلَّةَ ذا الهوى","وإن لم يُبَرِّدها النوى واللّوائم",47,"م",1,0],["سَأَشْكُو إِلَى مَثْوَاكَ أَيْضاً نُفُوسَنَا","فَقَدْ أَقْسَمْتَ أَلاَّ تُجِيبَ دُعَاءَنَا",48,"ن",2,0],["سأشكُرُ ما أوليتني فاذكُري فَتَىً","على العهدِ والمعروفِ منكِ أقاما",49,"م",2,0],["سأشرَبُها في كأسِ وهمي مدامةً","وأنظُمُها في سلكِ شِعري لآليا",50,"ل",3,0],["سَاَشْكُرُ ما دُمْتُ فِي الْعالَمِينَ","مَكارِمَ أَحْسَنَّ فِيكَ اصْطِناعِي",51,"ع",2,0],["سَأَشْكُرُ حادِثاً ألْقى زِمامِي","إِلَيْكَ وَرُبَّ أَمْنٍ فِي انْزِعاجِ",52,"ج",1,0],["سَأَشْكُرُ ما مَنَنْتَ بِهِ وَمِثْلِي","لأَهْلِ الْمَنِّ فَلْيَكُنِ الشَّكُورُ",53,"ر",1,1],["سَأَشكُرُ دَهري يا اِبنَ شُكرٍ لأَنَّهُ","بِهِ تابَ حَتّى صارَ يُحسِنُ فِعلَهُ",54,"ل",2,0],["سأَشكُرُ ما أَهدَيتَ لي من أَزاهرٍ","يَجولُ عليها من نَدى الحُسن جائلُه",55,"ل",2,0],["سَأَشرَبُ فَاِغضَب لا رَضيتَ كِلاهُما","حَبيبٌ إِلى قَلبي عُقوقُكَ وَالخَمرُ",56,"ر",1,0],["سأشرح ما قد كان في سيرةٍ جَرَت","من الدوحة العَليا الفلاحيةِ الغَرَّا",57,"ر",2,0],["سأشكو الحبَّ ما بَقِيَتْ حياتي","وأشكرُ من صنائعه الجمالا",58,"ل",2,0],["سَأشكرُ فضلَك الضّافي وأدعو","لمجدك بالدعاء المستجاب",59,"ب",1,0],["سأشْكُرُ لِلْحَمَّامِ بَدْءاً وَعَوْدَةً","أَيادي بِيضاً ما لهُنَّ ثَمينُ",60,"ن",1,1],["سَأشْفَعُ مَدْحي والدُّجى مُرْجَحِنَّةٌ","وللنَّوْمِ عِندي جَيْئَةٌ وذَهابُ",61,"ب",1,0],["سأشكرهُ شكرّ الرياض يد الحيا","سرى خضلَ الشؤبوب وهو ركامُ",62,"م",1,0],["سأشكر ذنب الدهر فيك ولم أكن","على غير الأيام أشكر مذنبا",63,"ب",2,0],["سَأَشْكُو الزَّمَانَ فَقَدْ مَسَّنِي","بِنُصْبٍ إِلَى الحَسَنِ بِنِ الحَسَنْ",64,"ن",1,0],["سَأَشكُرُها إِذ أَنَّها مُذ حَداثَتي","لَقَد عَوَّدَتني الصَبرَ وَهوَ مُحَبَّبُ",65,"ب",1,0],["سأشكُو إلى الله الّذي مِنكَ نَالَنِي","وأدْعوهُ لي بالنَّصْر وهو سميعُ",66,"ع",1,0],["سأشكرُ للأيامِ حيلةَ بُرئها","لإِبلالِ قلبٍ بالرزيّةِ مُوجعِ",67,"ع",1,0],["سأَشكرُ ما أَسلفتَ من يدِكَ التي","أطَلْتَ بها مستعبدَ الشكرِ والشعر",68,"ر",1,0],["سأشكر الفضل والأقوامَ ما فعلوا","سواي من كفر النعماء أو غمطا",69,"ط",2,0],["سَأشكر ما أَوليتني من مكارمٍ","بِها نلتُ في الدنيا سروراً وأنعُما",70,"م",2,0],["سأشكر لا أني أجازيه منعماً","بشكري ولكن كي يراد له الشكرُ",71,"ر",1,0],["سأشكرُ النجمَ فيما جادَ لي ملكي","لأنَّهُ في الذي أعطيتُهُ السبَبُ",72,"ب",1,1],["سأشكو اعتداء منك لولاه ما درت","صروف الليالي في الهوى كيف تعتدي",73,"د",2,0],["سأشكوهم والعين يسفح ماؤها","وطير الجوى بين الجوانح واقع",74,"ع",1,0],["سَأَشرَبُ كَأسَيكَ اللَّتينِ سَقَيتَني","وَإِن كانَتا وَاللَّهِ صابا وَعَلقَما",75,"م",2,0],["سأشربُ ما دامت تُغنِّي مًلاحظُ","وإن كان لي في الشِّيبِ عن ذاكَ واعظُ",76,"ظ",1,1],["سأشكَرها من آل نبهان أنعُماً","وأَعظمُ شيء يمحقُ النّعمةَ الكُفْرُ",77,"ر",1,0],["سَأَشكُرُ عمرا إِن تَراخَت منيّتي","أَيادِيَ لَم تُمنَن وَإِن هي جَلّت",78,"ت",1,1],["سأشكو زماني شاكراً ما حبوتني","فها انا طول الدهر شاكٍ وشاكرُ",79,"ر",1,0],["سَأَشكو إِلَيكَ البَينَ حَسبي وَيا لَهُ","وَلَو غَيرهُ ما ضاقَ عَدلٌ وَلا صَرفُ",80,"ف",1,0],["سأشكر نعماك التي انبسطت بها","يدي ولساني فهو بالمجد ينطق",81,"ق",1,1],["سأشكو الذي يلقى فؤادي من الاسهى","الى عاذلي كي ما يفيق عن الزجر",82,"ر",1,0],["سأشهد قومي أن طرفك من دمي","بريء وإن كان الفتور يريب",83,"ب",1,0],["سأشفي منك بال","تهجاء مني غلة الصدر",84,"ر",1,0],["سَأَشكُرُ فَضلَهُ وَأَزيدُ مِنهُ","وَحُقَّ لِشُكرِهِ مِنّي المَزيدُ",85,"د",1,0],["سَأَشكُرُ مِنه نِعْمةً عُمَرِيَّةً","وَعَارِفَةً حَسْبي صَنائِعُها حَسْبي",86,"ب",2,0],["سَأَشكُرُهُ شُكراً إِذا فُضَّ خَتمُهُ","يُؤَرِّجُ أَفواهاً وَيُطرِبُ مِسمَعا",87,"ع",2,0],["سَأَشكُرُ لا أَني أَرومُ زِيادَةً","وَلَكِنَّ عَبداً فَضلَ مَولاهُ يَذكُرُ",88,"ر",1,0],["سأشرَبُها صرفاً وأسقي صحابتي","واطلب غرّاتِ الغزال المنَطّقِ",89,"ق",1,0],["سأشربها صهباء كالمسك ريحُها","وأشربُها في كل نادٍ ومشهد",90,"د",1,0],["سأشربها ما حجّ للَه راكبٌ","مجاهرةً وحدي ومع كل مسعدِ",90,"د",1,0],["سأشكره النعماء ما عانقت يدي","يراعي وما استولى على منطق فمي",91,"م",2,0],["سأشكر من نُعماك ما أستطيعه","ولست على شكر الجميع بقادر",92,"ر",1,0],["سأشكر للمولى الخديويّ فضله","على عبده الداعي له وابن عبده",93,"د",2,1],["سأشكر من لقائكم القليلا","وأشكو من فراقكم الطويلا",94,"ل",2,1],["سَأَشكُر ما بَقيت أَمير نَجد","فَكُل صَنيعه حسن جَميل",95,"ل",1,1],["سَأَشرَبُها ما دُمتُ حَيّاً فَإِن أَمُت","فَفي النَفسِ مِنها زَفرَةٌ وَشَهيقُ",96,"ق",1,0],["سأشكرُ ما أولى وأصبرُ للذي","توالي على أنّ العزاءَ سليب",97,"ب",1,0],["سأشربُها خمراً وأعلم أَنها","لآخر شربى فى الحياةِ من الخمرِ",98,"ر",1,0],["سَأَشكُرُ ما أُوليتُ مِن حُسنِ نعمَةٍ","وَمِثلي بِشُكرِ المُنعمينَ حَقيقُ",99,"ق",1,0],["ساشكر الصيف الذي","أهدي إلينا الزنب