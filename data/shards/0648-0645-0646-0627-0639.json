{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[79,"أرد ما كان وارض بما قضاه","https://www.aldiwan.net/poem36577.html","الوافر"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[53,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[53,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[72,"إقرأ سلامي على من لا أسميه","https://www.aldiwan.net/poem42419.html","البسيط"],[45,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[47,"وصلنا إلى التوديع غير مودع","https://www.aldiwan.net/poem65138.html","الطويل"],[51,"الجود لا ينفك حامده","https://www.aldiwan.net/poem63119.html","السريع"],[82,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[33,"بنفسي من شفني حبه","https://www.aldiwan.net/poem42545.html","المتقارب"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[119,"لذ بالرفاعي الحسيني الذي","https://www.aldiwan.net/poem41070.html","عموديه"],[132,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[132,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[147,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[147,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[159,"عليل القلب والبدن","https://www.aldiwan.net/poem55510.html","مجزوء الوافر"],[168,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[173,"أتدري الليالي أي خصم تشاغبه","https://www.aldiwan.net/poem1602.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[186,"إلى معاليك ينمى المجد والحسب","https://www.aldiwan.net/poem67083.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"وحبب يوم السبت عندي أنني","https://www.aldiwan.net/poem51976.html","الطويل"],[214,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[236,"ربع المنى بمنى نعمت صباحا","https://www.aldiwan.net/poem44594.html","الكامل"],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[242,"ما شأن دنيانا سوى الإنذار","https://www.aldiwan.net/poem19781.html","الكامل"],[266,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[302,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[303,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[369,"دم للعلا في ظلال العز مغتبطا","https://www.aldiwan.net/poem60854.html","البسيط"],[396,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[408,"أراك خليلي للمحاسن طالبا","https://www.aldiwan.net/poem46515.html","الطويل"],[409,"وجاورت دار الضرب كرها وبئس ذا","https://www.aldiwan.net/poem34110.html","الطويل"],[438,"أبثك أني في يد الحب موثق","https://www.aldiwan.net/poem12396.html","الطويل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[447,"عظمت فلا شيء سواك عظيم","https://www.aldiwan.net/poem14293.html","الطويل"],[447,"عزاء بني سمح فما قد لقي سمح","https://www.aldiwan.net/poem14443.html","الطويل"],[447,"عزاء وصبرا كل شيء فهالك","https://www.aldiwan.net/poem14469.html","الطويل"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[470,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[534,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[554,"يئست من الحذية أم عمرو","https://www.aldiwan.net/poem444.html",""],[556,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[563,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18210","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6758","الطويل"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114830","الطويل"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144585","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17509","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202555","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46461","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27424","المتقارب"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109621","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124778","الطويل"],[2513,"","https://poetry.dctabudhabi.ae/diwan/poem/95823","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137227",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100316","الهزج"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100488","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74270","الطويل"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124010","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103963","السريع"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123528","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85229","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131022",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86524","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135458","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125799","البسيط"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45919","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45073","الطويل"],[4340,"","https://poetry.dctabudhabi.ae/diwan/poem/199543","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76694","الكامل"],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[5038,"أنا أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=195430",""],[5213,"تهددني الأيام جهلا بجورها","https://www.poetsgate.com/ViewPoem.aspx?id=170468",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5353,"برقية عاجلة","https://www.poetsgate.com/ViewPoem.aspx?id=215398",""],[5607,"يعاهدني ألا يخون وينكث","https://www.poetsgate.com/ViewPoem.aspx?id=181266",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[186,"إلى معاليك ينمى المجد والحسب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55743&r=&rc=6",""]],"verses":[["ومَنْ أعْلَقْتُهُ أهْدابَ وعْدٍ","بِما يَهْواهُ لَم يَخَفِ المِطالا",0,"ل",2,0],["ومَنْ أعْطاكَ بالشُّكْرِ اسْتَزِدْهُ","فإنّ الشُّكْرَ مِفْتاحُ المَزيدِ",1,"د",1,0],["وَمِنّا عَلَيَّ فارِسُ الخَيلِ صِنوُهُ","عَلَيَّ اِبنُ نَصرٍ خَيرُ مَن زارَ زائِرُ",2,"ر",1,0],["ومن أعاجيبها التشاجي","كأنها غادة غريره",3,"ر",2,0],["ومن أعقف أحذاه منقارُهُ اسمَهُ","أضدَّ بديعُ الخلق فيه فأبدعا",4,"ع",2,0],["وَمَن أُعَرِّضُ عَنهُ حينَ أَذكُرُهُ","فَإِن ذَكَرتُ سِواهُ كُنتُ أَعنيهِ",5,"ي",2,0],["وَمَن أَعتاضُ عَنكَ إِذا اِفتَرَقنا","وَكُلُّ الناسِ زورٌ ما خَلاكا",6,"ك",2,0],["وَمِن أَعجَبِ الأَشياءِ أَنَّ قُلوبَنا","صِحاحٌ لِخَوفِ البَينِ لَم تَتَقَطَّعِ",7,"ع",1,0],["وَمَنِ اِعتَدى فَاللَهُ خاذِلُهُ","وَمَنِ اِتَّقى فَاللَهُ عاصِمُهُ",8,"م",2,0],["ومن أعجبِ الأشياءِ أنَّ سُيوفَها","تَعودُ رِماحاً حَيثُ تَلحَظُ أَو نبلا",9,"ل",2,0],["وَمَن أَعرِفُ الوُدَّ في وَجهِهِ","وَيَعرِفُ وُدي لَهُ الناظِرُ",10,"ر",1,0],["وَمَنْ أَعَانَ أُولِي الطاعاتِ شَارَكَهُمْ","في أَجْرِ ما حَصَرُوا منه وما تَجَرُوا",11,"ر",3,0],["ومن أعجب الأشياء وادعة النهى","وحرب المنايا عدة وعديد",12,"د",1,0],["ومن اعتدى واراد يطفيء نورهم","ذاق الوبال وماله انصار",13,"ر",1,0],["ومَنْ أعلاهُمُ مجداً وعيصاً","وأفخرُهمْ وأكثرهم نفيرَا",14,"ر",2,0],["ومن أعجبِ الأشياء ريقُك في فمي","زلالٌ برودٌ وهْو في كبدي وقدُ",15,"د",1,0],["وَمَن أَعادَ حَياتي غَضَّةً وَيَدي","مَلأى وَرَدَّ لِيَ العَيشَ الَّذي ذَهَبا",16,"ب",2,0],["وَمَن أَعزَزتَ لَيسَ لَهُ مُذِلٌّ","وَمَن أَذلَلتَ لَيسَ لَهُ مُديلُ",17,"ل",1,0],["وَمَنْ أَعْطى أَزِمَّتَهُ","بِلا مَنْعٍ يَد الزَّمَنِ",18,"ن",1,0],["وَمِن أَعاجيبِ ما جاءَ الزَمانُ بِهِ","وَقَد يُبينُ لَنا الدَهرُ الأَعاجيبا",19,"ب",2,0],["وَمَنّاعُ أَعقابِ اللَّيالي إِذا اِغتَدَت","تَعاطى وَواراها مِنَ النَقعِ ثائِبُهْ",20,"ب",2,0],["وَمِنّا عَوالِيها وَمِنّا دُرُوعُها","وَمِنّا مَواضيها وَفينا كِلامُها",21,"م",3,0],["وَمِن أَعجَبِ الأَشياءِ وَالدَهرُ كُلُّهُ","عَجائِب يَأتي فَذُّها وَتَوامُها",21,"م",3,0],["وَمَن أَعادَ شَبابَ الدَّهرِ فَاِبتَسَمَتْ","بِهِ اللَيالي وَرَدَت صَفوَها الحِقَبُ",22,"ب",1,0],["وَمِن أعجبِ الأشياء خبزٌ وخمرةٌ","إِذا طفقَ القسّيسُ فوقهما يقرا",23,"ر",2,0],["ومن أعجبِ الأشياءِ أنيَ مسلمٌ","تقيٌّ ولكن خيرُ أياميَ السبت",24,"ت",1,0],["ومن اعجب الاشياء ان خدوده","لنا نارها الحمرا بها جنة خضرا",25,"ر",2,0],["ومن اعتدى ظلماً وخالف أمره","كانت عقوبته ظبا ورماحا",26,"ح",2,0],["وَمِن أَعاجيبِ الهَوى أَنَّهُ","يَطلُبُ قَتلي وَهوَ مَودودُ",27,"د",1,0],["وَمَنِ اعْتَدَى لاَ يَرْعَوِي عَنْ جُرْمِهِ","مَا هَذِهِ ذَا حَالَةُ الأَبْرَارِ",28,"ر",1,0],["ومن أعظم الحرمان أن تشتكي ظما","ووردك سلسال نمير المشارب",29,"ب",1,0],["ومن أَعار الصباحَ طلعَتَه","فَلاحَ يَجلو عَن أفقه ظُلمَه",30,"م",2,0],["وَمن أعظم البلوى بذلك أنْ أَتتْ","عَلَى القومِ أَحداث تُشيبُ النواصيا",31,"ي",2,0],["ومن أعجب الأشياء فرعاً أرومة","وما اتحدا بالطبع في الثمرية",32,"ه",1,0],["ومن اعجب الاشياء خلق مشيئة","بها صار مختار الهدى بالضلالة",33,"ه",1,0],["ومَن أعادَ لعُودِ الفَضْلِ ماءَ ندىً","فشَبَّ ما شابَ من فِكْري وما شَمَطا",34,"ط",2,0],["ومن أعطى علوما ليس تحصى","تحير لها عقول الأذكياء",35,"ا",2,0],["ومن أعجبِ الأشياءَ أن تَسْتَعيرها","ومنك لعمري تُستعارُ المحاسِنُ",36,"ن",1,0],["ومن أعجب الأشياء أَنِّيَ مسلمٌ","حنيف ولكن في خير أَيَّامِيَ السبت",37,"ت",1,0],["ومن أَعجَبِ الأَشياءِ أَحورُ فاتنٌ","ثناهُ الهوى مُغْرًى بأَحْوَرَ فاتِنِ",38,"ن",1,0],["ومَنْ أَعْرَبتْ فِيهِ أَعاظِمُ يَعْرُبٍ","فَمُسْتَصْغَرٌ فِي أَصْغَرَيْهِ العَظَائِمُ",39,"م",1,0],["ومن أعجب الأشياء مني إذا ابتلى","بلائي بذنب كيف وهو نؤوم",40,"م",1,0],["ومن أعجب الأَشياء ميت معزيا","على فقد ميت ميتاً نحوهم ينحو",41,"ح",2,0],["ومن أعجب الأشيا يعزيك هالك","على هالك حيث المعزى فهالك",42,"ك",1,0],["ومن أعجب الأشياء تعليلُها بمَنْ","تَرَى عجزَه من حظِّه يتعجّبُ",43,"ب",1,0],["وَمَنْ أعانُوا،وَمَن صانُوا،وَمَن بَذ َلوا","وَمَن جَميعُ الوَرى مِِن مائِهِم نَهَلوا",44,"ل",3,0],["ومَنْ أَعْياهُ نُورق مِنْ نَهارٍ","فكَيْفَ يَرُومُ إدْراكَ الهَبَاءِ",45,"ا",2,0],["وَمِنّا عُصبَةٌ أُخرى حُماةٌ","كَغَليِ القِدرِ حُشَّت بِالثِقابِ",46,"ب",1,0],["وَمِنّا عُصبَةٌ أُخرى سِراعٌ","زَفَتها الريحُ كَالسَنَنِ الطِرابِ",46,"ب",1,0],["وَمَنْ أعزَّكمُ بعد الخمولِ ومَنْ","أدناكُمُ مِن أمانٍ بعد تبعيدِ",47,"د",1,0],["ومن أعجب الأمر هذا الخفا","وهذا الظهور لأهل الوفا",48,"ف",2,1],["ومَن أعطى العقول مميزات","لنا فغدون من أسمى المزايا",49,"ا",3,0],["وَمَن اِعتَدى وَطَغى وَخالف أَمره","يُنفَى إِذا لَم يَلتقطه الصارم",50,"م",1,0],["ومن اعتنى بمديح طه","كيف يخشى أن يرد",51,"د",1,0],["ومنا علي ذاك صاحب خيبر","وصاحب بدر يوم سالت كتائبه",52,"ب",2,0],["وَمِن أَعيُنٍ سالَت عَلى وَجَناتِها","وَمِن أَوجُهٍ في التُربِ مُنعَفِراتِ",53,"ت",1,0],["ومن أعجب الدنيا إِليَّ زُجاجةٌ","تَظَلُّ أيادي المنتشِينَ بها فُتلا",54,"ل",2,0],["ومن أعيُنٍ غُضّتْ وكانت عَليّةً","تُشاوسُ ألحاظَ الدُّجى نظراتها",55,"ت",3,0],["ومنا عابروا الرؤيا بما قد","تجيء به ومنا العائفونا",56,"ن",2,0],["وَمِن أَعظَمِ البَلوى بِأَنَّكَ جاهِلٌ","فَمَن لي بِأَن تَدري بِأَنَّكِ لا تَدري",57,"ر",2,0],["ومن اعتدى بالأكلِ وهو يظنهُ","حرماً فوافق غرةَ الفطرِ",58,"ر",1,0],["ومن اعتزى وزرا لأشرف دولة","شدت وزارته معاقد أزرها",59,"ر",3,0],["وَمن أَعلى يَداً فَاِنظر","إِلى الساطور وَالابره",60,"ر",2,0],["ومِن أعجبِ الأمر أني به","صدرت ولم يك عن واردِ",61,"د",1,0],["ومن أعجب الأشياء ألقى بقربها","بعاداً واخفي حبها وهو ظاهرُ",62,"ر",1,0],["ومن أعظم المندوب عتق وخيره","عبيد وعنه بل إماء لخرّد",63,"د",1,0],["ومن أعجب الأَشياء حِرفتُك التي","شُهرت والضيق في الخُلق وَالرِزقِ",64,"ق",1,1],["ومن اعتزى للعقل فهو بجنة","منه وفي كل الامور مسدد",65,"د",1,0],["ومِن أعالي راسِ جاشَ آجرِ","للسِّندِ في الجوزا ومِل للنِّسرِ",66,"ر",1,0],["ومن اعوزه المندل","رطبا قبل السوسا",67,"س",2,0],["ومن أعجب الأشياء أن يرتقي الردى","إلى روح من أمسى لجسم العلى روحا",68,"ح",2,1],["وَمَن أَعجَب الأَشياء ظبية عالج","تَصول بِجفنيها عَلى الأسد الوَرد",69,"د",1,0],["ومن أعار سواد القلب أتلفه","لكن يهون علينا فيك إتلافه",70,"ف",2,0],["ومن أعاجيب الزمان التي","طمت على السامع والقائل",71,"ل",1,1],["ومَن أعَدَّ للشِّتَا كافاتِه","فلا تُرِيعُه بُرودَةُ الْهَوا",72,"ا",1,0],["وَمِن أَعظَمِ التَقوى النَصيحَةُ أَنها","مِنَ الدينِ أَضحَت مِثلُ أُسِّ بِنائِهِ",73,"ا",3,0],["ومن أعطيت منه المروءة حقها","ومن كان يأبى في الأمور التصنعا",74,"ع",2,0],["ومناعة الأكتاف أيمن خطةٍ","لسناء ملك أو أمان ديار",75,"ر",1,0],["ومن أعان على ربحٍ فذاك له","حظٌّ من الربح أياً كان في ظفرِ",76,"ر",1,0],["ومن أعاد زمان الراشدين لنا","بالأمن منتشراً والعدل منتظما",77,"م",2,0],["وَمَن أَعدَدُّتُهُ كَنزاً لِفَقري","لَدى يَومٍ لَهُ هَولٌ فَظيعُ",78,"ع",1,0],["وَمِن أَعيُنٍ تَحكي النَباتَ الَّذي لَهُ","عُيونٌ عَنِ السَحرِ المُبين تُبين",79,"ن",1,0],["ومن أعظم الأشياء أن قلوبنا","صحاح سخت بالبين لم تتقطع",80,"ع",1,0],["ومن اعتدى ثم اهتدى لطريقةٍ","ما ضل مَن يسعى على منهاجها",81,"ج",3,0],["ومنا عامر الجبري خفاجة","هذاك الي غزا ملوك الادارس",82,"س",1,0],["ومَنْ أعْطاكَ أسْيافَ التّحدّي","ومَنْ أغْراكَ بالثاراتِ مِنّي",83,"ن",2,0],["ومن اعقبت غيري من الصيد هاشم","اذا انا لم أرو لهم اجمل الذكر",84,"ر",1,0],["ومنّا علي ّ يوم أردى بسيفهِ","عميراً، وكان فتىً ندياً مهدهدا",85,"د",2,0],["ومنّا علي ّ يوم أردى بسيفهِ","سفيهاً، وكان فتىً ندياً مهدهدا",86,"د",2,0],["ومن أعجب الأشياء أنك ساكن","بقلبي وأني عن مكانك أبحث",87,"ث",1,0],["وَمنا عَلى الطُرقان ماتوا من الظَما","وَصارَت عِظامهم لِلهَوام طَعام",88,"م",1,0],["وَمِنا عَلى الطرقان ماتوا مِن الضَنا","وَاللي مهاجر بَعد حينو حان",89,"ن",1,0],["وَمِنا عَلى الطرقان ماتوا من الظَما","هفوا مثل حربد يُوم دش بجال",90,"ل",1,0],["ومن أعاد شباب الدهر فاتبسمت","به الليالي وردت صفوها الحقب",91,"ب",1,0]]}