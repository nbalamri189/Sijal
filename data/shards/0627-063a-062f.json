[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63971","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64070","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38165","السلسلة"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82354","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50016","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95559","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52082","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77228","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120678","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106840","الكامل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103757","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65980","الرجز"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199447","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140301",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216821","الرمل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89990","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199048","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136556",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136713",""],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115331","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83186","الرجز"],[4875,"مشارف مراسيك","https://www.poetsgate.com/ViewPoem.aspx?id=132830",""],[4875,"مشارف مراسيك","https://www.poetsgate.com/ViewPoem.aspx?id=133838",""],[4927,"الباص العذول","https://www.poetsgate.com/ViewPoem.aspx?id=29647",""],[4942,"ساحر","https://www.poetsgate.com/ViewPoem.aspx?id=188681",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5257,"والمؤلف ما هلك","https://www.poetsgate.com/ViewPoem.aspx?id=206789",""],[5358,"متى تعود لنا","https://www.poetsgate.com/ViewPoem.aspx?id=21899",""],[5387,"بلسم العيون","https://www.poetsgate.com/ViewPoem.aspx?id=46997",""],[5388,"أفديك لولا الرّدى","https://www.poetsgate.com/ViewPoem.aspx?id=206907",""],[5431,"أتظنُ أنك من أنينك هالكُ","https://www.poetsgate.com/ViewPoem.aspx?id=195340",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5533,"نُكْران","https://www.poetsgate.com/ViewPoem.aspx?id=214447",""],[5536,"وقاحة الأشواق!!","https://www.poetsgate.com/ViewPoem.aspx?id=19782",""],[5616,"شموخا أيتها المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=204845",""],[5674,"أعمى الزمان قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=186707",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5736,"أضغاث عاطفة","https://www.poetsgate.com/ViewPoem.aspx?id=208867",""],[5776,"شفرة الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=199407",""],[5829,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180642",""],[5956,"اشتاقتِ الأرواحُ للأرواحِ","https://www.poetsgate.com/ViewPoem.aspx?id=182127",""],[5956,"إشراقة","https://www.poetsgate.com/ViewPoem.aspx?id=192026",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"يا بنيّ","https://www.poetsgate.com/ViewPoem.aspx?id=193447",""],[6032,"عهود الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181520",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[5126,"مُوجز حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87813&r=&rc=28",""],[572,"قَدْ كانَ شوقي إلى مصرٍ يورّقُنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9274&r=&rc=131",""]],"verses":[["أَغدو عَلى أَمَلٍ كَحُبِّكَ زائِدٍ","وَأَروحُ عَن حَظٍّ كَوَصلِكَ ناقِصِ",0,"ص",1,0],["أَغدو وَراءَ الذاهِبي","نَ تَهُزُّني الزَفَراتُ هَزّا",1,"ز",2,0],["أَغدو إِلى طَردِ الظِباءِ وَأَنثَني","وَأَنا الطَريدَةُ لِلظِباءِ الغيدِ",2,"د",1,0],["أَغدو عَلى سُبُلِ الأَنواءِ مُشتَرِطاً","سُقياكَ في البَلَدِ النائي وَمُقتَرِحا",3,"ح",2,0],["أَغَدراً يا زَمانُ وَيا شَبابُ","أُصابُ بِذا لَقَد عَظُمَ المُصابُ",4,"ب",1,1],["أغْدو علَيهِ في فُتُوٍّ أقْيالْ","كالإبِلِ الجُرْبِ هَناهُنّ الطّالْ",5,"ل",1,0],["أَغَدَوتَ أَم في الرَّائحين تَرُوحُ","أَم أَنتَ مِن ذِكرِ الحِسانِ صَحيحُ",6,"ح",1,1],["أغدو على المفروض من وجدٍ ومن","حدّ الجفا أمسي على المسنون",7,"ن",1,0],["أغدو فأجني ثمار اللهو دانيةً","مثلَ الغصون وأرمي صيدَه كَثَبَا",8,"ب",2,0],["أغدُو ولا حالَ تَسَنَّمْتُها","فيها ولا حال تَرَدَّفْتُهَا",9,"ت",3,0],["أغدُو بجُرْحٍ رغيبٍ غيرِ ملتحِمٍ","يَدمَى وشملٍ شتيتٍ غيرِ ملتئِمِ",10,"م",1,0],["أَغدَقَت بِالنَوالِ أَنواءُ كَفَّي","هِ وَفاضَت لِلراغِبينَ بُحورُه",11,"ر",2,0],["أَغدو فَأَسحَبُ في البِطالَةِ مِئزَري","وَكَذاكَ مَن يُصبِح بِبَثٍّ يُغبِقِ",12,"ق",1,0],["أَغَداً يَشِتُّ المَجدُ وَهوَ جَميعُ","وَتُرَدُّ دارُ الحَمدِ وَهيَ بَقيعُ",13,"ع",1,1],["أَغداةُ الكُلابِ أَوْدَتْ بِشِعْري","فمَضَى أو عشيَّةُ التَّحلاقِ",14,"ق",1,0],["أَغدو لِمَجدِكَ رائِماً","وَيَدُ النَدى لي رامِيَه",15,"م",3,0],["أغدو لقدسك بالمنى","وأزور عرشك بالخيالِ",16,"ل",1,0],["أغداً قلت فعلِّمني اصطبارا","ليتني أختصرُ العُمرَ اختِصارَا",17,"ر",2,0],["أغدراً يا له خُلُقاً وضيعا","تهمُّ به ولستَ بمستطيعِ",18,"ع",1,0],["أَغدو وَأُمسي وَآمالي قَطَعتُ بِها","عُمري تَخيبُ وَأَعمالي المَواعيدُ",19,"د",1,0],["أغداً تستقبل الدنيا مُناها","حرَّةً تشدو بمكنون هواها",20,"ه",2,0],["أَغْدِقْ عَلَيْهَا سَحَابَا","وَامْلأْ مَدَاها شَبَابَا",21,"ب",2,1],["أَغدو بِهِ حَيران لا أَد","ري يَميني مِن يَساري",22,"ر",2,0],["أغَدَّارُ لاَ تَتعَب فَلَستَ بِشَاعِرٍ","فَصاحِب مَذَاقاً وَأحسُ حَيساً أو أدَّوِ",23,"و",1,0],["أَغدُو إِلَى الخُبزِ مِن خَابِزٍ","لاَ يَقبَلُ الرَّهنَ وَلاَ يُنسِي",24,"س",2,0],["أغدو على العيد في أثواب مضطهد","والناس في العيد في خرّ ومقصور",25,"ر",1,0],["أغدو وأهل الدهر في قرن معا","وغذا صدرت رأيتني فردا",26,"د",2,0],["أغدراً وقلبي ما يفارقُهُ الجوى","وخوفاً وأنَّى والحشا حَشْوُها الوجد",27,"د",1,0],["إغدر ودعني أعيش","قتلى حرامٌ عليك",28,"ك",1,0],["أَغداً تَستَوي الأنوفُ فلا يَن","ظُرُ قومٌ قوماً على الأَرض شزرا",29,"ر",2,0],["أغداً كلُّنا ترابٌ ولا مُل","كَ خلاف الترابِ برّاً وَبحرا",29,"ر",2,0],["أغدا يُصبحُ الصِراعُ عناقاً","في الهَيولى وَيُصبحُ العَبدُ حُرّا",29,"ر",2,0],["أغداً إذا أحضرتُ عريان حافياً","وأرعد مني للحساب فريص",30,"ص",1,0],["أَغَدَتْ زِيَادَتُنَا إِلَى النُّقْصَانِ","أَمْ نُقْصُنَا قَدْ صَارَ لِلرُّجْحَانِ",31,"ن",1,1],["أغدُو إلى المَعمل في شَملَةٍ","خَرقَاءَ لم تَكسُ ولَم تَشمَل",32,"ل",1,0],["أَغدوا على الغداءِ","فالجوعُ شَرُّ داءِ",33,"ا",2,0],["أَغَدواً واعَدَ الحَيُّ الزِبالا","وَشَوقاً لا يُبالي العَينَ بالا",34,"ل",2,1],["أغدو بهمَّة راغبٍ","فيها وحالةِ زاهدِ",35,"د",1,0],["أغدُو لنارِ الوغَى في الحرب إن خَمَدَت","بالبِيضِ في البَيْضِ والهاماتِ مُقتَدِحَا",36,"ح",2,0],["اغدو بجفن ساهرا من لوعتي","وأروح من كمدي بقلب موجعِ",37,"ع",1,0],["أَغَدْراً وَلَمْ أَغدِرْ وخَوْناً وَلَمْ أَخُنْ","لقد ضاعَ لي صدْقُ الوفاءِ لَدَيْكِ",38,"ك",1,0],["أغدراً وفيكم ذمّةٌ عربيّةٌ","وبخلاً ومنكم يستفادُ ندى اليدِ",39,"د",1,0],["أغدو وعلى شوقي ببط","ن شماله بيني دعان",40,"ن",1,0],["أغَداً سَيُحرَمُ من جَمالِهِ نَاظِرِي","فَيَبِيتُ رَيَّانا بِمَاءِ جُفُوني",41,"ن",2,0],["أغدو وعِرْضيَ محروسٌ بلا أَمَلٍ","يَسمو إليه ومالي غيرُ محروسِ",42,"س",1,0],["أَغْدو إلى الجيزَةِ الفيْحَاءِ مُصْطَبحاً","طَوْراً وأُزْجِي إلى شِيْرَازَ أطْوَارَا",43,"ر",2,0],["أَغْدُوا ولي نفْس ولي نَفسٌ","هذي منكَّسَةٌ وذا عالِ",44,"ل",1,0],["أغدَت عَلَيهِ مِنَ الرّياحِ مِراضُها","وَسَرى إليهِ مِنَ النَّسيمِ عَليلُه",45,"ل",2,0],["أغدو بتقبيل على حصبائه","وعلى كرائم جدره بعناق",46,"ق",1,0],["أَغدرتَ بي بَعدَ الوَفا","وَنقضتَ عَهدي يا علي",47,"ل",2,1],["أغدو عليها في الصَّبُو","حِ كما أروحُ الى الغُبوقِ",48,"ق",1,0],["أغدو به والأرضُ في","خيلٍ من الجنِّ تئطّ",49,"ط",1,0],["أَغْدوا على اللذاتِ غيرَ مراقبٍ","منعاً ولا متخوِّفٍ تَعْويقا",50,"ق",2,0],["أَغدو بِهَيامي إِلى الغَرامِ وَأُمسي","ما أَصدق صبّاً غَدا لِحبّك أَو راح",51,"ح",1,0],["إِغدي بِسُقيايَ فَاِصبِحيهِ","ثُمَّ اِغبِقيهِ مَعَ الصَّبوحِ",52