{"poems":[[65,"إن أخلف الوعد حي يظعنون غدا","https://www.aldiwan.net/poem45680.html","البسيط"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[95,"قضيت عمري لا مستديناً","https://www.aldiwan.net/poem9843.html","مخلع البسيط"],[74,"معاطف أو شراشف دبل","https://www.aldiwan.net/poem19535.html","المنسرح"],[53,"عيني لا تتهلل منكما الدرر","https://www.aldiwan.net/poem62856.html","البسيط"],[72,"علي وعندي ما تريد من الرضا","https://www.aldiwan.net/poem42844.html","الطويل"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[48,"مجوسية وحنيفية","https://www.aldiwan.net/poem23620.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85424","المجتث"],[159,"صولج لامين في عذارين","https://www.aldiwan.net/poem55539.html","المنسرح"],[208,"عبيد يا غصن بان","https://www.aldiwan.net/poem53165.html","المجتث"],[234,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[242,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[276,"قفا برياض الشعب شعب القرنفل","https://www.aldiwan.net/poem52096.html","الطويل"],[325,"الدهر لا تصفو له صافية","https://www.aldiwan.net/poem61760.html","السريع"],[325,"اليوم تحسدها الدنيا دمنهور","https://www.aldiwan.net/poem67229.html","البسيط"],[366,"وحقك أنت المنى والطلب","https://www.aldiwan.net/poem68141.html","المتقارب"],[371,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[382,"أذوب إذا رأيت يسوع يوما","https://www.aldiwan.net/poem59292.html","الطويل"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[408,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[463,"أيا بانة الغور عطفا سقيت","https://www.aldiwan.net/poem56084.html","المتقارب"],[505,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[505,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[572,"عرش العلا منهدم مؤتفك","https://www.aldiwan.net/poem69561.html","الرجز"],[591,"يا فاضح البدر حسنا","https://www.aldiwan.net/poem17439.html","المجتث"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83319","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105614","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59158","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138064",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109085","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64513","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199044","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113736","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199818","المسحوب"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110616","المتقارب"],[501,"","https://poetry.dctabudhabi.ae/diwan/poem/142586","البسيط"],[2783,"","https://poetry.dctabudhabi.ae/diwan/poem/35030","الطويل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146341","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100222","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100263","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199960","الهزج"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134201","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100187","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103873","الطويل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125938","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59479","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59463","الوافر"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29313","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111449","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93255","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73275","البسيط"],[4767,"تاج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=179616",""],[4883,"صورة با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=48361",""],[4968,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208077",""],[5136,"يا شمس أفق سما المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=121560",""],[5155,"الربيع والفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=176155",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5553,"انتم بدو","https://www.poetsgate.com/ViewPoem.aspx?id=185922",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[402,"قضيت عمري لا مستديتا","https://www.poetsgate.com/ViewPoem.aspx?id=36484",""],[5790,"من منصفي منك يا ظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=112131",""],[5845,"قفا برياضِ الشعبِ شعبِ القرنفلِ","https://www.poetsgate.com/ViewPoem.aspx?id=198491",""]],"verses":[["وَيا هُذَيمُ أَلاتَبكي عَلى وَطَنٍ","يُذيبُ مِن أَدمُعي ذِكراهُ ماجَمَدا",0,"د",2,0],["وَيَا هَاجِرَ الْجَوِّ الْجَديبِ تَلَبُّثاً","فَعَهْدِيَ رَطْبُ الْجَانِبَيْن خَصِيبُ",1,"ب",1,0],["ويا هماماً أجد في ال","أمة الصناعات والفنونا",2,"ن",2,0],["ويا هنا من يضمّ مهجته","على ولاءٍ في ابن الإمام علي",3,"ل",2,0],["ويا همومي ابتغي مأوىً سوى خلدي","فلن يضمّك مني اليوم محتضَرُ",4,"ر",1,0],["وَيا هاجِري حاشا الَّذي كانَ بَينَنا","مِنَ الوُدِّ أَن يُنسى سَريعاً وَيُنقَضا",5,"ض",2,0],["ويا هندُ اندبي القتلى ونوحي","وزيدي ما بقومِكِ من جُروحِ",6,"ح",1,0],["وَيا هِندُ ما عَصَمَت أَهلَها","قَواضِبُ في الضَربِ هِندِيَّه",7,"د",3,0],["وَيا هزار أَعد لي","ما كنت بالأمس تُملي",8,"ل",2,0],["وَيا هِلالاً بَدَتْ مَطَالِعُهُ","فِي أُفْقِ بَدْرَيْنِ تَغْلِبِيَّيْنِ",9,"ن",1,0],["ويا هلال سرورٍ","بالفطر من رمضانِ",10,"ن",1,0],["ويا هُدَى مَن ضلَّ عن رُشْدِه","واشتبه الحقّ عليه فحار",11,"ر",1,0],["وَيَا هَاجِرِي لاَ تَكُنْ وَاصِلِي","إِلَى أَنْ تُوَازِي الْحَصَاةُ ثَبِيرَا",12,"ر",2,0],["وَياهطلات السحب جودي كَرامة","عَلى خير أَرض اودعت خير مرسل",13,"ل",1,0],["وَيا هَنا مَن اِنقَضى عُمرُهُ","في عيشَةٍ لِرَبِّهِ راضِيَةِ",14,"ي",2,0],["وَيا هُماماً لَهُ في مُلكِهِ هِمَمٌ","عَنها يُقصِرُ إِنشاءَ وَتَحبيرِ",15,"ر",1,0],["وَيا هاجِري بَعد ذاكَ الرِضا","بِحَقِّكَ قل لي لِهذا سَبَب",16,"ب",1,0],["وَيَأَهلَ العُلا بَكّوا هِلالاً","لَيالي التِمِّ عُدَّ مِنَ الشُهورِ",17,"ر",1,0],["ويا هارون خبِّر عن أناسٍ","رأوا كفر الجميل من الجمال",18,"ل",1,0],["ويا هيكل الغفران بالصفح قائماً","فلولاك ما كان الخلاص ولا الصلح",19,"ح",1,0],["ويا هَاجراً ليَ حَتّى مَتَى","لِمُضْناكَ طُول المدى تهجر",20,"ر",1,0],["ويا هندُ إن عقل الكاشحون","وعندَهُمُ من ذنوبي نِداكِ",21,"ك",1,0],["ويا هَفاهِفَ النَّسيمِ سَحَراً","من سِنَةِ الذُّهولِ أَيقِظينِي",22,"ن",2,0],["ويا همَّةَ المُخْتارِ غَوْثاً فإنَّني","شَذا القُرْبِ من هذا الحِمى أتَنَسَّمُ",23,"م",1,0],["وَيَا هِلاَلاً مَحَقَتْ نُورَهُ","أَيْدِي الْبِلَى مَا أَوْحَشَ الْمَجْدَ لَكْ",24,"ك",1,0],["ويا هِلالاً تَبدَّى","على قضيبٍ رَطيبِ",25,"ب",1,0],["وَيا هَذِهِ الأَعطافُ رُمحُكَ طاعِني","وَيا هَذِهِ الأَلحاظُ سِحرَكَ بابِلي",26,"ل",2,0],["وياهل يريني الله أسياف هاشم","تحز به آناف حرب وتصلم",27,"م",1,0],["وَيَا هِلاَلَ الدُّجَى رَاعِ سَنَاهُ تَجِدْ","بَدْراً مُنِيراً بِهِ قَدْ عَزَّتِ الرُّتَبُ",28,"ب",1,0],["ويا هل أقيم في مسجد الخيف ليلة","ليأمن قلبي من مهول فظائعي",29,"ع",2,0],["ويا هلالاً أحال الخسف مطلعه","فغاب في جدثٍ عنا ولم يأب",30,"ب",1,0],["ويا هاجري حاشا الذي كان بيننا","من القرب إن ينسى وتصبح هاجري",31,"ر",2,0],["ويا هادياً من شاءه من عباده","لعرفانه بالذات لا بوسيطة",32,"ه",1,1],["ويا هادياً من شاءه من عباده","إلى ذاته سبحنه بالخليقة",32,"ه",1,0],["ويا هادي الأحياء لطفاً ومنة","إلى جلبها نفعاً ودفع مضرة",32,"ه",1,0],["ويا هادياً بالوحي للخلق حجة","لئلا يكون الأخذ إلا بحجة",32,"ه",1,0],["ويا هادي الألباب من حيث أنه","تكرم هاديها بخلق الهداية",32,"ه",1,0],["ويا هادياً من حيث قدم أهله","إلى الرتب العلياء والسابقية",32,"ه",1,0],["وَيَا هَلْ تَرَى يَا سَعْدُ نَصْراً يَسُرُّنَا","عَلَى يَوْمِ بَيْنٍ زَاغَ كُلَّ مَزَاغِ",33,"غ",1,0],["ويا هل أرى السادات من حي هاشم","دروا بضياع الجود يوم جوادها",34,"د",3,0],["ويا هاشِمِيّاً أنجَبَتهُ نجائِبُ","تخيَّرها الشُمُّ الكِرامُ الأخايِرُ",35,"ر",1,0],["ويا هلاً عد ما نجمس سرى به","عجيد القوم وان قاد السّريّه",36,"ي",2,0],["ويا هل ترى علمت فاطم","نساؤك ركبن للسبي نيبا",37,"ب",2,0],["ويا هَوىً مِنْ دِمَشْقٍ لا يُفَارِقُنِي","سُكْنَاكَ في البَالِ سُكْنَى اللّوْنِ في العَلَمِ",38,"م",1,0],["وَيا هَدبُ كَم مِن مُلحَمٍ قَد أَجَبتُهُ","وَقَد أَسلَمَتهُ لِلرِّماحِ جَوالِبُه",39,"ب",2,0],["ويا همّتي لا تُنْكِري شَيْب لِمّتي","فذا النّورُ بين الجهْل والحِلْم فاصل",40,"ل",1,0],["ويا هل درت نكبات المنون","غداة لوت من لوي عقابا",41,"ب",2,0],["ويا هل درى أي مارنَ دقَّ","وأية كفّ أطار وزندا",42,"د",2,0],["ويا هجمة أمراض","ولا طب ولا آسي",43,"س",2,0],["ويا هل أتى في يالعصر للناس قدوة","بقدر كمالات حواها محمد",44,"د",1,0],["ويا هاجراً حاشاه لا عن ملالةٍ","ومودعنا نار الجوى يوم ودعا",45,"ع",2,0],["ويا هم ما أعدى ويا شجو ما أبرا","ويا وجد ما أشجى ويا بين ما أقرا",46,"ر",2,0],["ويا هرماً ترنو إلي ملبياً","ندائي وفي أحشائه سر عليائي",47,"ي",1,0],["ويا هل شِمْتَ بَرقاً مرَّ وَهْناً","يؤمُّ جبالَ رامة والبُراقا",48,"ق",2,0],["ويا هل أبصرتْ عيناكَ ظعناً","بهنَّ الكاشحُ المغيارُ سارا",49,"ر",2,0],["وَيا هُدى التَيهاءِ","يا شَجَرَ النَخيلِ",50,"ل",1,0],["وَياهادِمَ الأسوَارِ يا باعِثَ الفَنا","أَلاَ ما تَرَكنَا الحَربَ للنَّاسِ مَعلَما",51,"م",2,0],["ويا هَلْ لِذاك اليوم في الدّهر ليلةٌ","تعودُ ولو عادت عقيماً بلا غدِ",52,"د",1,0],["ويا هِلالاً على قَضيبٍ","أَقعَدني عِطفُهُ القَويمُ",53,"م",1,0],["ويا هارون طه حين أبقا","ك طه بعده بين العيال",54,"ل",1,0],["وياهي ملامحك يشربها الغريبين","ومن أربعين الشبه ماتشبه إنسان!",55,"ن",1,0],["ويا هاشميَّ العُلا أنتَ فخر ٌ","حفيدَ الجدودِ الكبارِ الفخام",56,"م",1,0],["ويا هزبراً إذا ما شق غارته","وشن يوماً عليه تسبيح داود",57,"د",1,0],["وياه من مهجة حرى ومن حلم","لو يستعاد لعاد القفر بستانا",58,"ن",2,0],["ويا همة قعساء حزت لو انها","تلاقى بها هضبا لساخت به الهضب",59,"ب",1,0],["وياهل البيوت اللي تشدوا على وين","الله حسبكم كان بعتوا طنبنا",60,"ن",2,0],["ويا هل ترى للعندليب معلم","يعلمه كيف التغني على الغصن؟",61,"ن",1,0],["ويا هماما أجد في المة","الصناعات والفنونا",62,"ن",2,0],["ويا هلالا على قضيب","أقعدني عطفك القويم",63,"م",1,0],["ويا هاطلاتِ السحبِ جودي كرامة ً","على خيرِ أرضٍ أودعتْ خيرَ مرسلِ",64,"ل",1,0]]}