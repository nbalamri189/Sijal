{"poems":[[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63908","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145827","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25389","الرجز"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77749","الرجز"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95380","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121786","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[5358,"ناصية الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=21905",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""]],"verses":[["كلُّ أجفانه سيوفٌ وما لي","غير قلبي إذا انتضاهنَّ تُرْس",0,"س",1,0],["كلّ أجسادِنا الضخامِ زوايَا","فضحِكنا نكاية ًبالزوايا",1,"ا",3,1],["كُل أَجشَّ حالِك السَوادِ","ما كانَ إِلَّا طَلَقَ الأهْمادِ",2,"د",1,0],["كلا جانبيه معلم متجعدٌ","من الماء في أطلاله يتدفق",3,"ق",1,0],["كَلا جَفاكم لا يَكون كَلا","بَل أَنتم أَهل المَقام الأَعلى",4,"ل",2,1],["كلاج فيه كل لاج حل في","حصن من اللذات فهو ينعم",5,"م",1,0],["كِلاَ جَانِبَيْ هَرْشَي طَرِيقٌ لسالِكٍ","إذا لم يكن يَرْضَ مُقاماً على ذُلِّ",6,"ل",1,1],["كل اجارته كريمة لها","قرين سوءٍ ما رعى ما وجبا",7,"ب",2,0],["كلّ ُ اجتِماع ٍ الى هجر ٍ بمَوطِنِنا","هنا وبلّغَ أدنانا أقاصينا",8,"ن",2,0],["كُلُّ أَجرٍ قَبَضتُهُ بِيَمِينِي","بِيَسارِي دَفَعتُهُ لِلفَناءِ",9,"ا",2,0]]}