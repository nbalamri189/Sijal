{"poems":[[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[240,"يا رب قد حج الوزير","https://www.aldiwan.net/poem32138.html","مجزوء الكامل"],[409,"وأخف خلق الله روحا جاءني","https://www.aldiwan.net/poem33389.html","الكامل"],[435,"طاف الحباب على حميا الكاس","https://www.aldiwan.net/poem41066.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48540","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77616","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77500","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77629","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77609","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62648","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62496","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46527","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[2488,"","https://poetry.dctabudhabi.ae/diwan/poem/31476","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93860","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127368","الرمل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52994","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205721",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40099","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44693","الكامل"],[3998,"","https://poetry.dctabudhabi.ae/diwan/poem/34825","الكامل"],[4858,"الطيرُ في بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=33864",""],[5038,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=188573",""],[5431,"فحضنت قلبك حانيا ..ومضيتُ..","https://www.poetsgate.com/ViewPoem.aspx?id=191815",""],[5703,"لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=213604",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""]],"verses":[["فَدَخَلتُ إِذ نامَ الرَقي","بُ فَبِتُّ دونَ ثيابِها",0,"ب",3,0],["فَدَخَّنوهُ بِدُخانِ التِبنِ","وَأَوقَدوهُ بِثِفالِ اللِبنِ",1,"ن",1,0],["فدخَلوا حَديقَةً للموتِ","إذ طَمِعوا في حصْنها بالفَوتِ",2,"ت",1,0],["فَدُخولُ مِثلِهِمُ إِلى ال","حَرَمَينِ يامَولايَ سُبَّه",3,"ب",2,0],["فدخلته فإذا الجنان بعينها","وإذا بمالكه أخو رضوانه",4,"ه",1,0],["فدخلت روضة حانها مع أهيف","يسبي بدور التم ظبي كناس",5,"س",1,0],["فدخل الحجرة فيما سمعوا","لما رآهم للصلاة اجتمعوا",6,"ع",3,0],["فدخلت غرفته","كالشمس لم تحتجب",7,"ب",1,0],["فَدَخل المسمار في قَبضته","وَوَقع الغُلام في غشيته",8,"ه",1,0],["فَدَخلا وَتَرَكا الطَعاما","وَالقط ما غَضَّ وَلا تَعامى",9,"م",2,0],["فَدَخَلَ الحاكمُ بَيتَ التاجر","وَكانَ في بَيانِهِ كَالساحِر",10,"ر",1,0],["فَدَخل الثَعلبُ في حُجَيرِه","وَحَطّ أَكلَه وَأَكل غَيرَه",11,"ه",1,0],["فدخول أل في تلكم الأ","علام نقلاً قد ظهر",12,"ر",1,0],["فدخلت بستان السرو","رضي الله عنه بهم لألتقط الجنى",13,"ن",2,0],["فَدَخَلت وَفَعَلت ما قالا","لَقَد أَجادَ الكَيد لَما اِحتالا",14,"ل",2,0],["فَدخل الحَمام يَوماً فاحتجم","وَحَولهُ جَماعة مِن الخَدَم",15,"م",1,0],["فَدَخلتُمُ دَارَينِ دَارَ الجَهلِ فِي الدُّ","نيَا وَدَارَ الخِزيِ فِي النِّيرَانِ",16,"ن",1,0],["فدخن فاك ما عتقت فيه","ولا يعجن بأظفار وند",17,"د",1,0],["فَدَخَلتُ بَيتاً غَيرَ بَيتِ سَناخَةٍ","وَاِزدَرتُ مُزدارَ الكَريمِ المُعوِلِ",18,"ل",1,0],["فدخلت الحمى قصداً","للمعالي أتعمد",19,"د",1,0],["فدخلنا الوكر في يوم سعيد","وقضيناها سويعات غرر",20,"ر",1,0],["فدخلتَ في ذاك الحمى مُتيامناً","ويحفك الإقبالُ أين تُيَمِّم",21,"م",1,0],["فدخلت في خدر الحيا","ة وراء ألفاف الشباك",22,"ك",1,0],["فدخلنا الدِّهْليزَ وابتدر الإذ","نَ فَغَرِقْتُ في دِمَقْسٍ وخزِّ",23,"ز",1,0],["فَدَخَلتُ لِلكُتّابِ أَكمل فاضلٍ","لزِمَ التُقى في السرِّ وَالإِعلانِ",24,"ن",1,0],["فَدخَلتُ مِصرَ وَأَرضَها","وَالشامَ ثُمَّ المَوصِلا",25,"ل",2,0],["فَدَخيلٌ جاءَ يُطارِدُها","يرمي بالموتِ وبالنِّقَمِ!",26,"م",1,0],["فدخلْنا في رضاها جنّةً","روضُها الْإيمانُ والْخُلْقُ النّبيلْ",27,"ل",1,0],["فدخلتُ عرشك خاشعا صليت","وعلى جلالٍ في الرؤى أبقيتُ",28,"ت",1,0],["فدَخلنا جِنانَهُ باشتياقٍ","طالَما من لَهيبهِ قد بكينا",29,"ن",2,0],["فَدَخَلتُ لِل \" ماخُورِ \" فِي وَجَلٍ","وَ النَّاسُ بَينَ \" الرَّفعِ وَ الكَبسِ \" !!",30,"س",1,0]]}