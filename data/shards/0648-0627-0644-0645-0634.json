848,"أحد ينام وحط راسه","https://www.poetsgate.com/ViewPoem.aspx?id=48835",""],[5862,"البُ ع د يرضي .. جَنابِكْ ... !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31906",""],[5862,"الفعايل أصيله","https://www.poetsgate.com/ViewPoem.aspx?id=34140",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5956,"الشامُ فيها العشقُ والتَّرحامُ","https://www.poetsgate.com/ViewPoem.aspx?id=184921",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[6056,"اقول معصي","https://www.poetsgate.com/ViewPoem.aspx?id=130136",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6113,"حراااامي","https://www.poetsgate.com/ViewPoem.aspx?id=35354",""]],"verses":[["وَالمَشْرَفِيّةُ لا تَنْبو مَضارِبُها","فيها المَضاءُ وَإِن رُدَّتْ إِلى القُرُبِ",0,"ب",1,0],["والمَشْرَفيّاتُ الرِّقاقُ كأنّها","ماءٌ أصابَ قَرارَةً في نارِ",1,"ر",1,0],["وَالمُشبِعُ القَومِ إِن هَبَّت مُصَرصَرَةٌ","نَكباءُ مُغبَرَّةٌ هَبَّت بِصُرّادِ",2,"د",1,0],["والمشيبُ البريءُ يُعرضُ عنه","أو يُلاقى بجفوةٍ وانقباض",3,"ض",1,0],["وَالمَشرَفِيَّةُ أَشباهُ البُروقِ لَها","في كُلِّ جُمجُمَةٍ أَو بَيضَةٍ خُدَدُ",4,"د",1,0],["والمشعر الحرام","والبيت العتيق الأكرم",5,"م",1,0],["وَالمَشرَفِيَّةُ لا زالَت مُشَرَّفَةً","دَواءُ كُلِّ كَريمٍ أَوهِيَ الوَجَعُ",6,"ع",1,0],["والمشرفيّةُ في العجاج لوامعٌ","والأعوجيةُ في الصفوفِ صُفونُ",7,"ن",1,0],["وَالمَشرَفِيَّةَ لا تُعَرِّجُ عَنهُمُ","ضَرباً يُقُدُّ مَغافِراً وَدُروعا",8,"ع",2,0],["وَالمُشعِلونَ ضِرامَ الحَربِ إِذ لَقِحَت","يَوماً إِذا اِزوَرَّ عَنها مَن يُصاليها",9,"ي",3,0],["والمَشرَفِيّةُ والخِرْصانُ والحَجَفُ ال","منضودُ واليَلَبُ الموضون والحلَق",10,"ق",1,0],["والمُشرِقاتُ النّيّراتُ ثلاثةٌ","الشمسُ والقمرُ المنيرُ وجعفرُ",11,"ر",1,0],["وَالمَشرَفِيَّةُ قَد فُلَّت مَضارِبُها","عَنِ الكُماةِ وَأَطرافُ القَنا قِصَدُ",12,"د",1,0],["وَالمَشرَفِيَّةُ مَفلولٌ ضَوارِبُها","يَومَ اللِقاءِ وَأَيدٍ بِالنَدى سَبِطُ",13,"ط",1,0],["والمُشرِفُ الَمشمُولُ يُسقَى بِهِ","أَخضَرَ مَطموثاً كَمَاءِ الَخريص",14,"ص",1,0],["وَالُمشتَلِيكُم وقد زالَت دَعامَتكُم","أو تَزعَمُونَ وتَزدادُونَ أوتارا",15,"ر",2,0],["والمَشرِقُ أنبأَ مُتْهِمُهُ","بالفضلِ عليكَ وَمُنْجِدُهُ",16,"د",2,0],["والمشرفية قد تداعت فيهم","سفكا وقد دارت بكاسات الفنا",17,"ن",2,0],["والمَشْرَفيةُ قد حكَتْ في جيشه","فِي العَلِّ والنَّهَل القَطا الفُرّاطا",18,"ط",2,0],["وَالمُشعَراتِ الهَدايا في أَزِمَّتِها","مِنَ الغَوارِبِ أَنقاءٌ وَكُثبانُ",19,"ن",1,0],["والمشاهد والمآثر زرنا","كقباها وقبر خير همام",20,"م",1,0],["والمشاهد والمعاهد","والمعابد والمآثر",21,"ر",1,0],["وَالمِشطُ فيهِ مَغرِزٌ كَأَنامِلٍ","بِخَواتِمٍ مِن لُؤلُؤِ لَألَآءِ",22,"ا",2,0],["والمشرفيات في الهيجاء تندبهُ","والأعوجيات تبكي منه كرارا",23,"ر",2,0],["والمشرَفِيُّ تقولُ شَفْرَتُه","لو شاءَ كنتُ بأَجْمَعِي فَلاَّ",24,"ل",2,0],["والمشرِقُ الأَعْلى أَبُو الحَكَمِ الَّذِي","نادَيتُمُ فالدَّهْرُ عَبْدٌ طائِعُ",25,"ع",1,0],["والمُشرِفاتِ من مِنىً كأنّها","على ظُهور الهَضَباتِ حَدَبُ",26,"ب",1,0],["والمشرفية من شقيقٍ أحمرٍ","والجوُّ أكلفُ في مسوحٍ سودِ",27,"د",1,0],["والمشرفيَّة وهيَ جنسٌ واحدٌ","خوفُ الجبانِ وأمنُ روع الأروع",28,"ع",1,0],["والمشرفيّ انتَمى إلى حِلل","قالوا من الريف عذبة الحلل",29,"ل",1,0],["والمشرفية لا يروق بياضها","إلا إذا صبغ النجيع الأحمرا",30,"ر",2,0],["والمشتري الغالي مدىً من حمدِ","من مالِهِ وجاهِهِ بالنّقْدِ",31,"د",1,0],["والمُشْطُ يَشْكُو فيه طولَ سُرىً","وكذاكَ يشكو منه بُعْدَ سَفَرْ",32,"ر",1,0],["والمشترِي حُرَّ الثناءِ بأَنْعُمٍ","رَكَضَتْ بِه جُردُ الجِياد وقَبُّها",33,"ب",3,0],["والمشرَفيُّ بحدَّيه صَرامَتُه","يَومَ الضِّرابِ ولَيسَت كاليدَينِ يَدُ",34,"د",1,0],["والمشرفيّةُ في الأكفِّ كأنّها","لمعُ البروقِ بعارضٍ مُتَحَلِّبِ",35,"ب",1,0],["وَالمَشي خَلف جَنازة بِتَطوّع","لا من مُلامة لائم هجّاء",36,"ا",2,0],["والمشتهي الحكم ممن ليس يأمنه","كشارب السم يستشفي من السمن",37,"ن",1,0],["والمشير المطاع من ساير الأي","يام والناس آمناً مأمونا",38,"ن",2,0],["والمشرفيُّ العضبُ بالغِرار","قد انتعلنا قُلَلَ الأخطار",39,"ر",1,0],["والمشرفات على دجي","ل لاشرافَ ولا المثَفر",40,"ر",1,0],["والمشتري الحمد والمعالي","فيه وقد أرخص المساوم",41,"م",1,0],["والمشكله كلْما عتق طاب فَحْواه","يا شبْه دهن العود نفحَه ونَشْره",42,"ر",2,0],["والمُشْتَري وَسَطَ السَّماءِ تَخالُهُ","وسَنَاهُ مِثْلَ الزِّئْبَقِ المُتَرَجْرِجِ",43,"ج",1,0],["والمَشرَبُ العَذبُ الذِي","يُروى بِجمَّتِهِ الحَوَائِم",44,"م",1,0],["والمشتري الحمدَ والأشرافُ أكسبها","لجوهر الحمد أغلاها به قيما",45,"م",2,0],["والمشتري الحمدان الحمد ذو مهل","والتارك البخل ان البخل مذموم",46,"م",1,0],["والمشس من فوق العلا درةٌ","في شرف تعلو على المستري",47,"ر",2,0],["والمشمس الحموي يحاكي عاشقاً","زاد العزول عليه بالإرجاف",48,"ف",1,0],["والمشي فيه إذا آلى به رجل","يوماً أحجُّ أمراً معه على الإبل",49,"ل",1,0],["والمشكرون إذا أتوا فتحنفوا","والبالغون به ذوو الصغر",50,"ر",1,0],["والمشرفيّاتُ التي بشفارها","هلكت ملوكُ أعاجمٍ وأعارب",51,"ب",1,0],["والمشرق العربي ضج لدولة","عربية مفجوعة بعماد",52,"د",1,0],["والمشتري رقّ العلا","بكل ما دقّ وجل",53,"ل",1,0],["وَالمُشرِكُونَ أقَلُّ شِركاً مِنهُمُ","هُم خَصَّصُوا ذَا الإسمَ بِالأوثَانِ",54,"ن",1,0],["وَالمُشكِلُ القَولُ المُخَالِفُ عِندَنَا","فِي غَايَةِ الإِشكَالِ لاَ التِّبيَانِ",54,"ن",1,0],["والمشركون أخف في كفرانهم","وكلاهما من شيعة الشيطان",54,"ن",1,0],["والمشتري الأمة الحسناء من شغف","يستصغر البدرة النجلاء في الثمن",55,"ن",1,0],["والمشرب الأصفى الذي مَن ذاقه","فقد اهتدى منهُ بنور سراجِ",56,"ج",1,0],["والمشتري حسن الثنا بماله","لما رأى حسن الثناء أنفعا",57,"ع",2,0],["وَالمَشرَفِيَّةُ قَد فُلَّت مَضارِبُها","وَالسَّمهَريَّةُ مُرفَض وَمَقصودُ",58,"د",1,0],["وَالمَشرَفيَّةُ كُلُّ أَبيَضَ باتِرٍ","مِنها وآخَرُ مُخلَصٍ بِصِقالِ",59,"ل",1,0],["والمَشرِقيَّاتُ منَ المربَّع","أوَّلُ زامٍ قَايِماتٌ شُرَّع",60,"ع",1,0],["والمُشتري للياء والزُّهره ها","واللامُ للنَّحسِ وشَمسٌ سينُها",61,"ه",2,0],["والمشرعُ الفيَّاضُ سُدَّ سبيلهُ","وطغَى الهجيرُ بمهجةِ الظمآن",62,"ن",1,0],["والمشترون له حازوه وانقلبوا","بنعمة في الفواتي خير منقلب",63,"ب",1,0],["والمشتري وعطارد يتناظرا","ذا للظهور وذا طويل الغيبة",64,"ه",1,0],["والمشتري جسدي من خصرة سقما","ولحظة أسد للقلب كاسره",65,"ر",2,0],["والمشعرين ومن تلبث","يومه والعيس وقَّف",66,"ف",1,0],["والمشمس الفاقع في أكمامه","مثل كرى التبر بكفي جؤذر",67,"ر",1,0],["والمشكلاتُ من المسائل أسفرت","تفترُّ بعد كآبة وخفاء",68,"ا",2,0],["والمُشرِكون قَسَتْ قلوبُهُم","فطَغَوْا ولم يُصْغُوا لخيرٍ نَبَا",69,"ب",2,0],["والمشتفى ببروقه وبريقه","من كل ذي حمة وداء معضل",70,"ل",1,0],["والمشترى حَاز اليَسار","فغدا بزهزته أسير",71,"ر",1,0],["والمَشْرفيةُ لا يُقي","مُ صُدُورَها الا القَوائِمْ",72,"م",1,0],["والمَشْرفيّةُ ليسَ يُنجِدُ حمْلَها","إن لمْ تُطِلْ شرَفاً لديْكَ نِجادَها",73,"د",3,0],["والمشركون خواسر فى سعيهم","هزموا وقد نكصوا على الأعقاب",74,"ب",1,0],["وَالمُشتَري قَد غَدا بِاللَهِ مُحتَسِباً","في أَمرِهِ مُذ رَأى الميزان قَد رَجحا",75,"ح",2,0],["وَالمُشتري الحَمد في حل وَمُرتَحل","تَأتي المَكارم مِنهُ كُلَ مَحمود",76,"د",1,0],["والمشتري راهبٌ من حولِ هيكلِهِ","بيضُ المصابيحِ في زُرقِ القناديلِ",77,"ل",1,0],["والمشرفيات المواضي والقنا","والمقربات كأنها آرام",78,"م",1,0],["والمشرفيَّاتِ الصوار","مِ والَّلهازمِ والقبائلْ",79,"ل",1,0],["والمشرفية تستدير على الطلى","فكأنها صيغت لها أغلالا",80,"ل",2,0],["والمشكلات تحلها","بالعلم في أهدى الحلول",81,"ل",1,0],["والمشتري قال للمريخ حين راى ال","شعرى العَبورَ مع العّيوقِ في سَمَر",82,"ر",1,0],["والمشجر ندماني","والورد محيّانا",83,"ن",2,0],["والمشكلة يلقى سواته من يصفّق له رخوم","اهل القلوب الحاسدة واهل العلوم الهافيه",84,"ف",3,0],["والمُشيرُ الآنَ يَبدُو","ناطِقًا باسمِ \"العَسِيرِي\"",85,"ر",2,0],["والمشكلة حتى الغريب ايتجبر","الغدر مذهب والرذايل لهم دين",86,"ن",1,0],["والمشكله مآيلد لنظرة مصآرح","ومهمآ يسوي ابد يآقلب مآ املّه",87,"ل",2,0],["وَالْمُشْرِكُوْنَ يُصَاْدِرُوْنَ غِلاْلَهَاْ","وَيُرَوِّجُوْنَ: بِأَنَّهَمْ \"شُرَكَاْءُ\"",88,"ا",2,0],["والمشتهى صوتُ البنين، يجيبهُ","صوت الحنينِ: جميعكم زكريّا",89,"ي",2,0],["والمشكل اني مافهمت السؤالات","لين استغلت طيبتي وسرقتها",90,"ت",3,0],["والمشتري يتباهى في تصدده","فيمتطي الشعر للشعري بلا خور",91,"ر",1,0],["والمشركون بجنب الغار في أسف","وهم يقولون ما بالغار من إرم",92,"م",1,0],["والمشركون ..يحدقون ..تحجروا","وقريش مذهول بها الإلهام",93,"م",1,0],["والمشرفون حداة ركب طامح","فتراهمو نجم السماء وكوكبا",94,"ب",2,0],["والمشهد صوت يلذعنى","مظلوم يا شعبى الصاهر",95,"ر",1,0],["والمشكله : إني أجازيك غفران","وأمسح خطياتك وأقبل معاهدك",96,"ك",1,0],["والمشاعر تنتمي للي تحبه","وغيرها أفخر بمنهو انتمي له",97,"ل",2,0],["والمشكله حتى من لقلبي اجتاح","ماهي مثل اول ولاهي تركتني..",98,"ن",2,0],["والمشكلة ماهي سياسات ظلاّم","المشكلة اليا حان يوم التلاقي",99,"ق",2,0],["والمشبكُ القمحيّ في شَعري ثرًى","ورذاذُ ظلّك قُبلةٌ تتودّدُ",100,"د",1,0],["والمشرفيّ اذا الصوافن اسرجت","يأتيك في شكّ الصدور يدمدمُ",101,"م",1,0],["والمشكله في عقول العالم القشرى","الي تصدق سفيه القوم واجللته",102,"ت",2,0],["والمشاعر ..! حالها في مذبحه.","خنجر غيابك أكل منها ولاك.",103,"ك",1,0],["والمشي فيه التغنج والدلع فيه إعتراف","إنه أجمل من جمالٍ سطره في ملحمه",104,"م",2,0],["والمشكلة أني كل ما حنّت عيوني للجنوب","تطري لي الريم اللعوب وسالفة ترحالها",105,"ل",3,0],["والمشكلة ماهي ب قولتك بعدين","المشكلة بعدين ما جت إلى الآن !!",106,"ن",1,0],["والمشكلة والكارثة والمطمّة","قلب الشجاع ليا خذلته الشجاعة !!",107,"ع",2,0],["والمشكله باللي تسويه محشوم","لو أرتوي حسرات بأعشق سحابك",108,"ك",1,0],["والمشكله : ذوقك يموّت خيالك ..","والقصد شعرك ماله اللي يشيله",109,"ل",2,0],["والمشتري حسن الثنا بماله","حين رأى حسن الثناء أنفعا",110,"ا",1,0],["والمشمشَ الذهبيَّ يسبح عارياً","في الجو تخجلُ مثلُه الأحلامُ",111,"م",1,0],["والمشكلاتُ يغررون ببعضنا","بدهائهم.. لله ما أغبانا",112,"ن",2,0],["والمشاعر لاحداها الشوق قامت ترقصي","تنعش القلب المعذّب من عنا فرقا الضنين",113,"ن",1,0],["والمشاعر بصدري ، نارها مضرمه","ألهبت خافقي والصدر منها إلتهب",114,"ب",1,0],["والمشاعر بصدري في نزول وصعود","تكشف أشواق حب ٍ كنت قاسيتها",115,"ت",3,0],["والمشكله لاقلت حبك مجافيك","قال انت ماتدري يسوي نطامي",116,"م",2,0]]}