{"poems":[[79,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[88,"إن عضيك يا أخي بالملام","https://www.aldiwan.net/poem68843.html","الخفيف"],[75,"أنت معنى الضنى وسر الدموع","https://www.aldiwan.net/poem11878.html","الخفيف"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[95,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[90,"أدب العلم وعلم الأدب","https://www.aldiwan.net/poem45003.html","الرمل"],[90,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[74,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[53,"يسمو إلى المجد أقوام فتلهزهم","https://www.aldiwan.net/poem64525.html","البسيط"],[53,"قبلته فمج في جوف فيها","https://www.aldiwan.net/poem65434.html","الخفيف"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[93,"هات اسقني بالقدح الكبير","https://www.aldiwan.net/poem8839.html","عموديه"],[93,"أشرف البدر على الغاية","https://www.aldiwan.net/poem62629.html","عموديه"],[72,"يا ثقيلا لي من رؤيته","https://www.aldiwan.net/poem42752.html","مجزوء الرمل"],[91,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[87,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[63,"أقصر الزاجر عنه فازدجر","https://www.aldiwan.net/poem51677.html","الرمل"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[2,"كم للمنازل من عام ومن زمن","https://www.aldiwan.net/poem25005.html","البسيط"],[99,"أنت وحي العبقرية","https://www.aldiwan.net/poem24802.html","مجزوء الرمل"],[46,"لهف نفسي علي لا بل عليكا","https://www.aldiwan.net/poem30192.html","الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[50,"قل لذي الدل تولب","https://www.aldiwan.net/poem66563.html","مجزوء الخفيف"],[48,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62216","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19309","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[119,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[132,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[177,"قال لي يهزأ من لم","https://www.aldiwan.net/poem4415.html","مجزوء الرمل"],[186,"حبذا للسليم أبهى قران","https://www.aldiwan.net/poem61059.html","الخفيف"],[190,"أنت والله يا غلام مليح","https://www.aldiwan.net/poem44074.html","الخفيف"],[203,"يا من أطال الهجر من بعد ما","https://www.aldiwan.net/poem45611.html","السريع"],[203,"يا قوام الغصن منثنيا","https://www.aldiwan.net/poem45615.html","المديد"],[215,"أنت ورد فهب محبك شوكا","https://www.aldiwan.net/poem46628.html","الخفيف"],[227,"زارع الحقل في البكور","https://www.aldiwan.net/poem41457.html","مجزوء الخفيف"],[239,"يا جلال الدين يا ملكا","https://www.aldiwan.net/poem31800.html","المديد"],[239,"ياسمي النبي يا ابن علي","https://www.aldiwan.net/poem31970.html","الخفيف"],[241,"رد صفوها يا أخي مندوصه","https://www.aldiwan.net/poem19298.html","مجزوء البسيط"],[260,"ويحك اسكت فضحتني يا راسي","https://www.aldiwan.net/poem48482.html","الخفيف"],[324,"اتخذني عبد رق","https://www.aldiwan.net/poem61645.html","مجزوء الرمل"],[346,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[365,"أيها الاهيف الذي أهواه","https://www.aldiwan.net/poem68044.html","الخفيف"],[368,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[398,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[420,"جئت يا ابن الفاروق من معجز","https://www.aldiwan.net/poem53865.html","الخفيف"],[420,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[420,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[420,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[458,"من لعين كثيرة الهملان","https://www.aldiwan.net/poem26633.html","الخفيف"],[461,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[464,"أنت والماء يا مجاهد دين","https://www.aldiwan.net/poem16134.html","الخفيف"],[482,"كأس من الراح أم كأس من الأدب","https://www.aldiwan.net/poem36934.html","البسيط"],[482,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[516,"يا غارس الحب بين القلب والكبد","https://www.aldiwan.net/poem67759.html","البسيط"],[518,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[532,"لم أزل أرقب وعدا","https://www.aldiwan.net/poem37113.html","مجزوء الرمل"],[561,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[561,"مهجة ناظراك قد فتناها","https://www.aldiwan.net/poem33674.html","الخفيف"],[564,"يا رب أنت تجبر الكسيرا","https://www.aldiwan.net/poem27849.html","الرجز"],[565,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67397","الخفيف"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10455","البسيط"]],"verses":[["إنْ تورّعْتُ أصْبَحَتْ حوْزَةُ","المُلْكِ ضِياعاً لجُرأةِ الفُجّارِ",0,"ر",1,1],["أَنتَ وَالشَمسِ وَالضُحى وَاللَيالي ال","عَشرِ وَالفَجرِ غَيرُ راعي الذِمامِ",1,"م",1,0],["أَنتِ وَالشَمسُ ضَرَّتانِ وَلَكِن","لَكِ عِندَ الغُروبِ فَضلُ الطُلوعِ",2,"ع",1,0],["إِنْ تَوَارَوْا فِي دَارِةِ الدَّارِ عَنْهُ","جَدَّ شَوْقٌ بِهِ وَلَجَّ حَنِينُ",3,"ن",1,0],["إِنْ تُولِهِمْ مِنْ ثَنَاءٍ مَا يَحِقُّ فَلا","يَفُتْكَ حَمدٌ لِهَذَا الضَّيْفِ فِي آنِ",4,"ن",1,0],["أنت واللَّه على رغم المنون","ذو وجود قاتل للعَدَم",5,"م",1,0],["أنت والله عسجد ولجين","لو أتينا الأمور باستعداد",6,"د",1,0],["إن توارت شمس الضحى فلعمري","ما توارت شمس العلا بالحجاب",7,"ب",1,0],["أنتَ والموتُ غائبان لذي الصَّبْ","وة تلقى حياضه أو مُذيدَكْ",8,"ك",1,0],["إن تُوَحِّدْهُ في الصَّنِيعة والصُّنْ","عِ فقد راح مخلصاً توحيدَكْ",8,"ك",1,0],["أنت وكَّدْتَ حرمتي بك فانْفِ","أن تَرى الغدْرَ ناقضاً توكيدَكْ",8,"ك",1,0],["إن تولني يا ابن يحيى منك عارفةً","لا تقرِها في سقاء غير مخروز",9,"ز",1,0],["أنت والعبد جيفةٌ صادفتها","كلبة في الدماء ذات ولوغ",10,"غ",1,0],["أَنت وَالكَأسُ في يَدي","فَلِمَن أَنتِ في غَدِ",11,"د",1,1],["أَنت وَإِن لامَ الوَرى شَرابي","في الخالِدينَ القَر وَالهَجيرِ",12,"ر",1,0],["أَنتَ وَضّاحٌ وَلَكِن قاحِلٌ","لا صَيدَ فيكا أَو حِيالَك",13,"ك",1,0],["أَنتَ وَاللَهِ ثَقيلٌ","أَنتَ وَاللَهِ ثَقيلُ",14,"ل",1,0],["انت والارض طائران مع الشمس","بهذا الفضاء ذي الفجوات",15,"ت",1,0],["أَنتِ وَأَولادُكِ حَ","تى يَكبُروا في خُفرَتي",16,"ي",1,0],["أنتَ والعيدُ الذي عاودْتَه","غُرَّتا هذا الزمانِ المُعتَكِر",17,"ر",1,0],["إن توَّجاكَ بدُرٍّ فهو من لُجَجي","أو ختَّماكَ بياقوتٍ فأحجاري",18,"ر",2,0],["إِن تُؤتِهِ النُصحَ يوجَد لا يُضَيِّعُهُ","وَبِالأَمانَةِ لَم يَغدُر وَلَم يَخُنِ",19,"ن",1,0],["أنت وحيُ العبقرية","وجلالُ الأبدية",20,"ي",2,1],["أَنتَ وَقفٌ عَلى القُلوبِ بِما أَص","بَحتَ تُهوى وَهُنَّ وَقفٌ عَلَيكا",21,"ك",2,0],["أنتَ واليتهُ وعاديتَ فيه","من توخَّى الأذى وأبدى النفورا",22,"ر",2,0],["أنتَ واللَهِ مركبٌ","موطأٌ خير مركب",23,"ب",1,0],["إِن تَوافَقنَ صَحَّ أَو لا فَما يَن","فَكُّ عَنها الإِمراضُ وَالإِغماءُ",24,"م",3,0],["إن توَلّى على النّفوس تَوَلّى","أو تجَلّى يستعبِدُ النُّساكا",25,"ك",2,0],["إِنْ تُؤْنِسَا نَارَ حَيٍّ قَدْ فُجِعْتُ بِهِمْ","أَمْسَتْ عَلَى شَزَنٍ مِنْ دَارِهِمْ دَارِي",26,"ر",2,0],["أَنتِ وَأَولادُكِ حَت","تى يَكبُروا في خُفرَتي",27,"ي",1,0],["أنت والنيل ضفتان لمصرٍ","تنبتان الأذواق والأرزاقا",28,"ق",2,0],["أنت وحش ما زال في كل يوم","والغاً من شراسة في الدماء",29,"ا",2,0],["أنت واللَه الملاذ المرتجى","والغياث الغوث والحامي الحمى",30,"م",2,0],["أنت واللَه الذي من أمه","في مطايا صدقه لن يندما",30,"م",2,0],["أنت واللَه الذي من لاذ في","ركنه العالي بخوف سلما",30,"م",2,0],["أنت واللَه الذي في بابه","عظم العاني وذل العظما",30,"م",2,0],["أنت واللَه اللذي شانا له","فيه خلاق البرايا أقسما",30,"م",2,0],["أنت واللَه الذي لما أتى","موكب الرسل بخير ختما",30,"م",2,0],["أنت واللَه على رغم العدا","ناصر العبد على من ظلما",30,"م",2,0],["أنت واللَه رؤوف كلما","جاء بالذنب محب رحما",30,"م",2,0],["أنت واللَه سراج للهدى","ومعين من حماه التزما",30,"م",2,0],["أنت وثبتنا عليك وقد كنت","موقى على غرة ورخاء",31,"ا",2,0],["أنتَ وابناك أهلُ فضلٍ وعدل","واعتزاز وعزةٍ وسدادِ",32,"د",1,0],["أنتَ والحَالُ شَاهِدٌ وشُهودُ ال","حالِ أحرَى بِأَن تَبُتَّ الخُصُومَا",33,"م",2,0],["أَنتَ وَاللَّهِ صَحِيحٌ","سَوفَ تَبقَى لِلقِيامَه",34,"م",2,0],["أَن تؤرِّخْهُ قُل كَما قُلتُ فيهِ","دُم قَرينَ الهَنا وَأَنتَ سَليمُ",35,"م",1,0],["أنت والله يا غلام مليح","وجميل بك الجمال يلوح",36,"ح",1,1],["أنتَ وإن أسرفتَ في ذا الجفا","أحسنُ خلقِ اللهِ في أعيني",37,"ي",1,0],["أنتَ والطربوشُ منحرفٌ","كهلالِ الأفقِ في النصفِ",38,"ف",1,0],["أنت وردٌ فهب محبّك شوكاً","أترى الورد عاش من غير شوك",39,"ك",1,1],["أَنتَ وجهٌ مُخَلَّدُ","لِلجُدودِ المُخَلَّدين",40,"ن",1,0],["أَنتَ وَالأَحلامُ طائِشَةٌ","ثابِتُ الأَراءِ مُحتَنَكُ",41,"ك",1,0],["أَنتَ وَلَّيتَنيهِ مِنكَ اِبتِداءً","غَيرَ مُستَكرَهٍ وَلا مَجبورِ",42,"ر",1,0],["أَنْتَ وَلاَ زَعَمَاتِ نَذْلٍ","شَجَى ذَوِي فِطَرٍ مَنْقُوصَهْ",43,"ص",2,0],["أنت والله فارغ القحف إلا","من كنوز الخباط والإفلاس",44,"س",1,0],["أَنتَ وَاللَهِ لِطيفٌ","وَأَنا عَبدُ اللَطيفِ",45,"ف",1,0],["انت وهمٌ في جسمنا وعجيب","ان نرى الوهم كالحقيقة يألم",46,"م",1,0],["أَنتَ وَالبَدر وَالغَزال وَغُصن ال","بان لينا وَبَهجَة أَشباه",47,"ا",2,0],["أَنت والسّاكنوك فيما عَهِدْنا","هِجْتُما لي جوىً أعادَ وأَبدا",48,"د",2,0],["أنت وحيي ومنك تنبع أحلا","مي, وإن كنت في حماك الوضيع",49,"ع",1,0],["أَنْتَ وفّيتها المحاسن طرًّا","إنَّما شيمة الكرام الوفاء",50,"ا",2,0],["إنْ تؤَمّلْه تُؤَمِّلْ صيّباً","أو تُجادِلْه تُجادلْ ضَيْغَما",51,"م",2,0],["أَنت والغيث جوادا حلبةٍ","مثلما أَنت مع العلياء توأَم",52,"م",1,0],["أَنت والله لأندى من حياً","مستهلّ القطر بالجود وأَكرم",52,"م",1,0],["إنْ تولدوا من صلب أكرم والد","فكذلك الأخلاق قد تتولد",53,"د",1,0],["أَن تَوَلّى أَخي وَعارِفُ حَقّي","وَأَميني في السِرِّ وَالإِعلانِ",54,"ن",1,0],["أنتِ والأيامُ ما أنكرتُه","وبلاءُ المرء يومٌ أو خليلُ",55,"ل",1,0],["أنتَ والماءُ يا مُجاهِدَ دِينِ","اللّهِ حيَّانِ في حَياةِ الأنامِ",56,"م",1,1],["أنت وإن أمسيت مسعفنا","كم فيك من مهج ضلت فلم تثب",57,"ب",1,0],["أنت وأنتها في قلب والدها","كأنها طعنة من سيف ذي يزن",58,"ن",1,0],["إن توف لي لا أرد ما دمت لي بدلاً","وإن تعزيت لم أركن إلى أحد",59,"د",1,0],["أنت واصلت بالكرامة بري","وهي أقصى مطالبي ومرادي",60,"د",2,0],["إنْ تُواصِلْنِي ولا يَعْ","لَقُ في الْحُبِّ رِهاني",61,"ن",2,0],["إن توحيد كل عقل إذا لم","يك بالشرع لا يكونُ وجيها",62,"ي",3,0],["إن توخت إيمانها أنكروها","وإلى العقل يرجعون قواها",63,"ا",3,0],["أَنتَ وَهَبتَ هَجمَةً جُرجورا","أُدماً وَعيساً مَعَصاً خُبورا",64,"ر",2,0],["إن تولاَّكُما البِلَى فلَعمري","ليسَ تَبلَى الهمومُ والأحزانُ",65,"ن",1,0],["أنت وصي والإمام بعدي","تقضي ديوني وتفي بوعدي",66,"ي",1,0],["أنْتَ وَاللهِ حَيَّةٌ تَنْفُثُ السُّم","مَ قَلِيلٌ فِيهَا غَنَاءُ الرَّاقِي",67,"ق",2,0],["إِن توعِدوني فَإِنّي لِاِبنُ عَمِّكُمُ","وَقَد أَصابوكُمُ مِنهُ بِشُؤبوبِ",68,"ب",1,0]]}