ن",1,0],["أنت واللَّه على رغم المنون","ذو وجود قاتل للعَدَم",5,"م",1,0],["أنت والله عسجد ولجين","لو أتينا الأمور باستعداد",6,"د",1,0],["إن توارت شمس الضحى فلعمري","ما توارت شمس العلا بالحجاب",7,"ب",1,0],["أنتَ والموتُ غائبان لذي الصَّبْ","وة تلقى حياضه أو مُذيدَكْ",8,"ك",1,0],["إن تُوَحِّدْهُ في الصَّنِيعة والصُّنْ","عِ فقد راح مخلصاً توحيدَكْ",8,"ك",1,0],["أنت وكَّدْتَ حرمتي بك فانْفِ","أن تَرى الغدْرَ ناقضاً توكيدَكْ",8,"ك",1,0],["إن تولني يا ابن يحيى منك عارفةً","لا تقرِها في سقاء غير مخروز",9,"ز",1,0],["أنت والعبد جيفةٌ صادفتها","كلبة في الدماء ذات ولوغ",10,"غ",1,0],["أَنت وَالكَأسُ في يَدي","فَلِمَن أَنتِ في غَدِ",11,"د",1,1],["أَنت وَإِن لامَ الوَرى شَرابي","في الخالِدينَ القَر وَالهَجيرِ",12,"ر",1,0],["أَنتَ وَضّاحٌ وَلَكِن قاحِلٌ","لا صَيدَ فيكا أَو حِيالَك",13,"ك",1,0],["أَنتَ وَاللَهِ ثَقيلٌ","أَنتَ وَاللَهِ ثَقيلُ",14,"ل",1,0],["انت والارض طائران مع الشمس","بهذا الفضاء ذي الفجوات",15,"ت",1,0],["أَنتِ وَأَولادُكِ حَ","تى يَكبُروا في خُفرَتي",16,"ي",1,0],["أنتَ والعيدُ الذي عاودْتَه","غُرَّتا هذا الزمانِ المُعتَكِر",17,"ر",1,0],["إن توَّجاكَ بدُرٍّ فهو من لُجَجي","أو ختَّماكَ بياقوتٍ فأحجاري",18,"ر",2,0],["إِن تُؤتِهِ النُصحَ يوجَد لا يُضَيِّعُهُ","وَبِالأَمانَةِ لَم يَغدُر وَلَم يَخُنِ",19,"ن",1,0],["أنت وحيُ العبقرية","وجلالُ الأبدية",20,"ي",2,1],["أَنتَ وَقفٌ عَلى القُلوبِ بِما أَص","بَحتَ تُهوى وَهُنَّ وَقفٌ عَلَيكا",21,"ك",2,0],["أنتَ واليتهُ وعاديتَ فيه","من توخَّى الأذى وأبدى النفورا",22,"ر",2,0],["أنتَ واللَهِ مركبٌ","موطأٌ خير مركب",23,"ب",1,0],["إِن تَوافَقنَ صَحَّ أَو لا فَما يَن","فَكُّ عَنها الإِمراضُ وَالإِغماءُ",24,"م",3,0],["إن توَلّى على النّفوس تَوَلّى","أو تجَلّى يستعبِدُ النُّساكا",25,"ك",2,0],["إِنْ تُؤْنِسَا نَارَ حَيٍّ قَدْ فُجِعْتُ بِهِمْ","أَمْسَتْ عَلَى شَزَنٍ مِنْ دَارِهِمْ دَارِي",26,"ر",2,0],["أَنتِ وَأَولادُكِ حَت","تى يَكبُروا في خُفرَتي",27,"ي",1,0],["أنت والنيل ضفتان لمصرٍ","تنبتان الأذواق والأرزاقا",28,"ق",2,0],["أنت وحش ما زال في كل يوم","والغاً من شراسة في الدماء",29,"ا",2,0],["أنت واللَه الملاذ المرتجى","والغياث الغوث والحامي الحمى",30,"م",2,0],["أنت واللَه الذي من أمه","في مطايا صدقه لن يندما",30,"م",2,0],["أنت واللَه الذي من لاذ في","ركنه العالي بخوف سلما",30,"م",2,0],["أنت واللَه الذي في بابه","عظم العاني وذل العظما",30,"م",2,0],["أنت واللَه اللذي شانا له","فيه خلاق البرايا أقسما",30,"م",2,0],["أنت واللَه الذي لما أتى","موكب الرسل بخير ختما",30,"م",2,0],["أنت واللَه على رغم العدا","ناصر العبد على من ظلما",30,"م",2,0],["أنت واللَه رؤوف كلما","جاء بالذنب محب رحما",30,"م",2,0],["أنت واللَه سراج للهدى","ومعين من حماه التزما",30,"م",2,0],["أنت وثبتنا عليك وقد كنت","موقى على غرة ورخاء",31,"ا",2,0],["أنتَ وابناك أهلُ فضلٍ وعدل","واعتزاز وعزةٍ وسدادِ",32,"د",1,0],["أنتَ والحَالُ شَاهِدٌ وشُهودُ ال","حالِ أحرَى بِأَن تَبُتَّ الخُصُومَا",33,"م",2,0],["أَنتَ وَاللَّهِ صَحِيحٌ","سَوفَ تَبقَى لِلقِيامَه",34,"م",2,0],["أَن تؤرِّخْهُ قُل كَما قُلتُ فيهِ","دُم قَرينَ الهَنا وَأَنتَ سَليمُ",35,"م",1,0],["أنت والله يا غلام مليح","وجميل بك الجمال يلوح",36,"ح",1,1],["أنتَ وإن أسرفتَ في ذا الجفا","أحسنُ خلقِ اللهِ في أعيني",37,"ي",1,0],["أنتَ والطربوشُ منحرفٌ","كهلالِ الأفقِ في النصفِ",38,"ف",1,0],["أنت وردٌ فهب محبّك شوكاً","أترى الورد عاش من غير شوك",39,"ك",1,1],["أَنتَ وجهٌ مُخَلَّدُ","لِلجُدودِ المُخَلَّدين",40,"ن",1,0],["أَنتَ وَالأَحلامُ طائِشَةٌ","ثابِتُ الأَراءِ مُحتَنَكُ",41,"ك",1,0],["أَنتَ وَلَّيتَنيهِ مِنكَ اِبتِداءً","غَيرَ مُستَكرَهٍ وَلا مَجبورِ",42,"ر",1,0],["أَنْتَ وَلاَ زَعَمَاتِ نَذْلٍ","شَجَى ذَوِي فِطَرٍ مَنْقُوصَهْ",43,"ص",2,0],["أنت والله فارغ القحف إلا","من كنوز الخباط والإفلاس",44,"س",1,0],["أَنتَ وَاللَهِ لِطيفٌ","وَأَنا عَبدُ اللَطيفِ",45,"ف",1,0],["انت وهمٌ في جسمنا وعجيب","ان نرى الوهم كالحقيقة يألم",46,"م",1,0],["أَنتَ وَالبَدر وَالغَزال وَغُصن ال","بان لينا وَبَهجَة أَشباه",47,"ا",2,0],["أَنت والسّاكنوك فيما عَهِدْنا","هِجْتُما لي جوىً أعادَ وأَبدا",48,"د",2,0],["أنت وحيي ومنك تنبع أحلا","مي, وإن كنت في حماك الوضيع",49,"ع",1,0],["أَنْتَ وفّيتها المحاسن طرًّا","إنَّما شيمة الكرام الوفاء",50,"ا",2,0],["إنْ تؤَمّلْه تُؤَمِّلْ صيّباً","أو تُجادِلْه تُجادلْ ضَيْغَما",51,"م",2,0],["أَنت والغيث جوادا حلبةٍ","مثلما أَنت مع العلياء توأَم",52,"م",1,0],["أَنت والله لأندى من حياً","مستهلّ القطر بالجود وأَكرم",52,"م",1,0],["إنْ تولدوا من صلب أكرم والد","فكذلك الأخلاق قد تتولد",53,"د",1,0],["أَن تَوَلّى أَخي وَعارِفُ حَقّي","وَأَميني في السِرِّ وَالإِعلانِ",54,"ن",1,0],["أنتِ والأيامُ ما أنكرتُه","وبلاءُ المرء يومٌ أو خليلُ",55,"ل",1,0],["أنتَ والماءُ يا مُجاهِدَ دِينِ","اللّهِ حيَّانِ في حَياةِ الأنامِ",56,"م",1,1],["أنت وإن أمسيت مسعفنا","كم فيك من مهج ضلت فلم تثب",57,"ب",1,0],["أنت وأنتها في قلب والدها","كأنها طعنة من سيف ذي يزن",58,"ن",1,0],["إن توف لي لا أرد ما دمت لي بدلاً","وإن تعزيت لم أركن إلى أحد",59,"د",1,0],["أنت واصلت بالكرامة بري","وهي أقصى مطالبي ومرادي",60,"د",2,0],["إنْ تُواصِلْنِي ولا يَعْ","لَقُ في الْحُبِّ رِهاني",61,"ن",2,0],["إن توحيد كل عقل إذا لم","يك بالشرع لا يكونُ وجيها",62,"ي",3,0],["إن توخت إيمانها أنكروها","وإلى العقل يرجعون قواها",63,"ا",3,0],["أَنتَ وَهَبتَ هَجمَةً جُرجورا","أُدماً وَعيساً مَعَصاً خُبورا",64,"ر",2,0],["إن تولاَّكُما البِلَى فلَعمري","ليسَ تَبلَى الهمومُ والأحزانُ",65,"ن",1,0],["أنت وصي والإمام بعدي","تقضي ديوني وتفي بوعدي",66,"ي",1,0],["أَنتِ وَأَيدي الرِكابِ مُعمَلَةً","يَهوينَ في كُلِّ سَربَخٍ جَدَدِ",67,"د",1,0],["إِن تُوَدِّع مِنَ البِلادِ قُرَيشٌ","لا يَكُن بَعدَهُم لِحَيٍّ بَقاءُ",68,"ا",2,0],["أَنتَ وَاللَهُ مِن كُنوزِ اللَيالي","أَبرَزَتكَ الأَقدارُ كُلَّكَ جَوهَر",69,"ر",1,0],["أنت واللّه معْجَبٌ","ولنا غيرُ معجِبِ",70,"ب",1,0],["أنت والشرق في الوجود سواء","لم يميزك دونه الإبداع",71,"ع",1,0],["أنت والصحب بالغون لمصر ال","ضخمَ من سؤودٍ ومن مدنيه",72,"ي",2,0],["أنت وفقت بين أمسك واليو","م فساوى الطريف منك التليدا",73,"د",2,0],["أنت وفَّيتَهُ ولاءً ووفّا","ك جزاء والخير ما تصنعان",74,"ن",1,0],["أنتوا معنا الفرايض","ومشاهدكم حياه",75,"ا",2,0],["أَنتَ وَاللَّهِ عَلَينا السيّدُ","مَنْ لَهُ كلُّ المَعالي خادِمات",76,"ت",1,0],["أنت وآباؤك ممن مضى","روضة بين القبر والمنبر",77,"ر",1,0],["أنت والحب وساعات الصفا","وثوان ما لسواها مدى",78,"د",2,0],["أنت والمال فالمردُّ إلى","الله فبالحق تستبينُ السب