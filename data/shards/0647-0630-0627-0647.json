 حشاشة ذوبي","https://www.aldiwan.net/poem52735.html","الكامل"],[565,"ما زلت أسمع ذكر عبد القادر","https://www.aldiwan.net/poem52770.html","الكامل"],[565,"طال البعاد فطال الشوق والكمد","https://www.aldiwan.net/poem52804.html","البسيط"],[565,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[565,"الفضل من أهل الكرامة يعرف","https://www.aldiwan.net/poem52807.html","الكامل"],[565,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[565,"ماذا شعوب بني عثمان تنتظر","https://www.aldiwan.net/poem52830.html","البسيط"],[565,"غاب الأمير فما تمادى المرجع","https://www.aldiwan.net/poem52842.html","الكامل"],[565,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[565,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[565,"للشعر في كل عصر مركب خشن","https://www.aldiwan.net/poem52868.html","البسيط"],[565,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[565,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[578,"لم لا أجبت ولو بنثر","https://www.aldiwan.net/poem2720.html","مجزوء الكامل"],[578,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["هَذا هُوَ الأَثَرُ الباقي فَلا تَقِفوا","عِندَ الكَلامِ إِذا حاوَلتُمُ أَرَبا",0,"ب",2,0],["هَذا هُوَ العَمَلُ المَبرورُ فَاِكتَتِبوا","بِالمالِ إِنّا اِكتَتَبنا فيهِ بِالأَدَبِ",1,"ب",1,0],["هَذا هُوَ المُلكُ فَليَهنَئ مُمَلَّكُهُ","وَذا هُوَ الشِعرُ فَلتُنشِدهُ أَزماني",2,"ن",2,0],["هَذا هُوَ العيدُ قَد لاحَت مَطالِعُهُ","وَكُلُّنا بَينَ مُشتاقٍ وَمُرتَقِبِ",3,"ب",1,0],["هَذَا هُوَ المَجْدُ نَفْنَى وَالبَقَاءُ لَهُ","عَلَى تَعَاقُبِ أَجيالٍ وَأَزْمَانِ",4,"ن",1,0],["هَذَا هُوَ الْبِرُّ أَشْقَى مَا يَكُونُ نَدىً","وَتِلْكَ فِي مَعْنىً خِدْمَةُ الْوَطَنِ",5,"ن",1,0],["هَذَا هُوَ الفَوْزُ العَظِيمُ وَهَكَذَا","يَغْلُو الجَزَاءُ إِذَا غَلا الإِحْسَانُ",6,"ن",1,0],["هَذَا هُوَ الخَطْبُ الأَجَلُّ وَهَذِهِ","أَدْعَى رَزَايَاهَا إلىَ الأَشْجَانِ",7,"ن",1,0],["هَذَا هُوَ العَيْشُ والقِسْطُ العَظِيمُ بِهِ","مِنْ خَالِدِ الفَخْرِ فَوْقَ العُمْرِ تَقْويما",8,"م",2,0],["هذا هو ليل الليالي","بالغنا والفرح يسهر",9,"ر",1,0],["هذا هو العلم لا ما تَدْأبون له","مما تكون به عقباكم الفشلا",10,"ل",2,0],["هذا هو البطل الذي فجعت به","صيد البلاد وسادة الأمصار",11,"ر",1,0],["هذا هنا قد سعى للمجد مبتدراً","وذا هناك سعى للمجد مقتدرا",12,"ر",2,0],["هذا هو الخبز يا أجنادَ أدعية","وفي المجاريب حرب الليل مصفوف",13,"ف",1,0],["هذا هو الشرف الذي بأقله","ضرب القديم غرائب الأمثال",14,"ل",1,0],["هَذا هُوَ الرَأيُ الصَوابُ وَغَيرُهُ","مَهما حَلا لِلناسِ غَيرُ صَوابِ",15,"ب",1,0],["هَذا هُوَ المَرءُ يا ذاتَ العَفافِ فَمَن","يُنصِفهُ لا شَكَّ فيهِ يُنصِفُ الأَدَبا",16,"ب",2,0],["هَذا هُوَ الكَرنَفالُ فَاِستَبِقوا","إِلَيهِ فَهوَ السُرورُ يُختَلَقُ",17,"ق",1,0],["هَذا هُوَ الدَنِفُ الَّذي أَرضى الهَوى","فيها وَأَغضَبَ كاشِحاً وَعَذولا",18,"ل",2,0],["هَذا هُوَ العيدُ قَد لاحَت مَواكِبُهُ","يا قَلبُ هَلِّل لَها يا شِعرُ حَيِّها",19,"ي",3,0],["هَذا هُوَ الخَرَفُ الَّذي لا يُدَّعى","هَيهاتَ ماكُلُّ الرِجالِ فُحولُ",20,"ل",1,0],["هَذا هُوَ الأَدَبُ الَّذي أَنشَأتُهُ","فَاِهتَزَّ مِنهُ رَوضُهُ المَطلولُ",20,"ل",1,0],["هَذا هُوَ الدُرُّ الَّذي مِن بَحرِهِ","مازِلتَ تَبذُلُهُ لَنا وَتُنيلُ",20,"ل",1,0],["هذا هو اللغْزُ عَمَّاهُ وعَقَّدَهُ","على الخليقةِ وَحْشٌ فاتكٌ حَذِرُ",21,"ر",1,0],["هذا هو الخبر الذي لسماعه","أمسى رجائي حبله يتقطع",22,"ع",1,0],["هذا هو الخبر الذي باتت له","في الليل نفسي والنهار تُروّع",22,"ع",1,0],["هَذا هُوَ المَعروفُ يَا أَهلَ الفِطَن","الناسُ بِالناسِ وَمَن يُعِن يُعَن",23,"ن",1,0],["هَذا هُوَ الرَيحانُ إِلّا أَنَّهُ","نَفَحاتُ تِلكَ الرَوضَةِ المِئنافِ",24,"ف",1,0],["هَذا هِلالُكُمُ تَكَفَّلَ بِالهُدى","هَل تَعلَمونَ مَعَ الهِلالِ ضَلالا",25,"ل",2,0],["هَذا هُوَ الحَجَرُ الدُرِّيُّ بَينَكُمُ","فَاِبنوا بِناءَ قُرَيشٍ بَيتَها العالي",26,"ل",2,0],["هذا هواي وذا ابني خُطَّ مسكن ذا","بمصر والشام ألقى ذا بها خططا",27,"ط",2,0],["هذا هو السر في الحل الذي كتموا","أظهرته فهو باد غير مستتر",28,"ر",1,0],["هذا هلالُ الفِطرِ قد جاءنا","بمنجلٍ يحصدُ شهرَ الصيامْ",29,"م",1,0],["هذا هو العصرُ الذي سبقتْ بهِ ال","بُشرَى وجاءَ بذكرهِ الآثارُ",30,"ر",1,0],["هذا هو الدَّاءُ الذي ضاقتْ بهِ","حِيَلُ الطبيبِ وطالَ يَأْسُ العائِدِ",31,"د",1,0],["هذا هو الدَّاءُ العياءُ بمثلِهِ","ضلَّتْ حلومُ حواضرٍ وبوادي",32,"د",2,0],["هذا هو الحَسَنُ الذي حَسَناتُه","قعدت لدى الكرماءِ بعد قيامِ",33,"م",1,0],["هَذا هَواكَ وَهَذِهِ آثارُهُ","أَمّا الفُؤادُ فَلا يَقَرُّ قَرارُهُ",34,"ر",2,1],["هذا هدى قد غوى قلبي ببهجته","فصارَ كالصبِّ أصباهُ الهوى فصبا",35,"ب",2,0],["هذا هو الطُّوفانُ إن تَتَهَيَّبي","يُطْبِقْ عليكِ وإن تَهُبِّي تُعْصَمي",36,"م",2,0],["هذا هو الدّينُ لا ما هاجَ من فِتنٍ","بين القبائلِ دينُ الجهلِ والعارِ",37,"ر",1,0],["هَذا هُوَ النُصحُ الصَريحُ وَرُبَّما","مَحضُ النَصيحَةِ صاحِبٌ لَم يَجهَدِ",38,"د",1,0],["هذا هُو الفَضْلُ لا الدُّنيا وما رَجَحَت","به الموازِينُ منها والمكايِيلُ",39,"ل",1,0],["هذا هرقلُ يسوقُ الجيشَ مُرتكماً","كالعارِض الجوَنْ يرمِي الأرضَ بالوَهَلِ",40,"ل",1,0],["هذا هو الإيثارُ فاعجَبْ وَاعْتَبِرْ","وأَعِدْ على الدَّهرِ الحديثَ ورَدِّدِ",41,"د",1,0],["هذا هو الملِكُ الذي سعِدتْ به","مِصرٌ وهذا حُبُّها المتجسِّمُ",42,"م",1,0],["هذا هوَ المَوْتُ كيْفَ تَغْلِبُه","وفضْلُه الشمسُ كيْفَ تَجْحَدُها",43,"د",3,0],["هَذَا هُوَ الْعَيْشُ لا لَغْوُ الْحَدِيثِ وَلا","مَا يَسْتَغِيرُ بِهِ ذو الإِفْكَةِ النَّمِلُ",44,"ل",1,0],["هَذَا هُوَ الأَدَبُ الْمَأْثُورُ فَارْضَ بِهِ","عِلْماً لِنَفْسِكَ فَالأَخْلاقُ تَنْتَقِلُ",44,"ل",1,0],["هَذَا هُوَ الْحُبُّ الَّذِي ضَاقَتْ بِهِ","تِلْكَ الصُّدُورُ وَقَلَّتِ الْحُفَّاظُ",45,"ظ",1,0],["هَذا هُوَ الصَّحَفِيُّ إِلاَّ أَنَّهُ","فِي صُورَةٍ أُخْرَى مِنَ التجَّارِ",46,"ر",1,0],["هَذا هُوَ الفَضْلُ الَّذِي مابَعْدَهُ","فَضلٌ وَليْسَ وَرَاءَهُ مِنْ مَفْخَرِ",47,"ر",1,0],["هَذَا هُوَ الرُّكْنُ الَّذِي أَحْمَالُهُ","تُوهِي وَلاَ يَشْكُو مِنَ الأَحْمَالِ",48,"ل",1,0],["هَذَا هُوَ السَّنَنَ الْقَويمُ","فَكِلْ أَسَاكَ إِلى تُقَاكْ",49,"ك",1,0],["هَذَا هوَ الْعَلم الَّذِي زُهِيَتْ","مصْرٌ بِهِ وَتَبَاهَت السيَرُ",50,"ر",1,0],["هَذَا هُوَ الْكَرَمُ الْخَلِيقُ ب