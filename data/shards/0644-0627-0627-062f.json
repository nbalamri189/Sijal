{"poems":[[55,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[74,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"الحمد لله لا شريك له","https://www.aldiwan.net/poem64017.html","المنسرح"],[93,"مرت ليال وقلبي حائر قلق","https://www.aldiwan.net/poem62798.html","عموديه"],[45,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[64,"لا أدعي أني وفيت بعهدكم","https://www.aldiwan.net/poem52494.html","الكامل"],[47,"حاجة ذا الحيران أن ترشده","https://www.aldiwan.net/poem63481.html","البسيط"],[47,"أرج لريا طلة رياه","https://www.aldiwan.net/poem66848.html","الكامل"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[92,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[50,"صاحبة القرقرِ لا تشغبي","https://www.aldiwan.net/poem66551.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43859","البسيط"],[92,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[92,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[92,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[102,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[234,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[236,"سلوان مثلك للمحب عزيز","https://www.aldiwan.net/poem44589.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[309,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[422,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[438,"عليكم جانبت أصحابي","https://www.aldiwan.net/poem12326.html","السريع"],[447,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[447,"لا جدد الله فيما بينكم حزنا","https://www.aldiwan.net/poem14483.html","البسيط"],[463,"قد قنعنا أن نرقب الأحلاما","https://www.aldiwan.net/poem55874.html","الخفيف"],[466,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[469,"عاد مني الخيال طيف الخيال","https://www.aldiwan.net/poem3497.html","عموديه"],[482,"ما ضر أهل الحمى لو أنهم رجعوا","https://www.aldiwan.net/poem15287.html","البسيط"],[549,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[556,"رم النجاء عن الفحشاء والهون","https://www.aldiwan.net/poem47160.html","البسيط"],[580,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138190",""],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199587","المسحوب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49979","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71033","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71036","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109326","البسيط"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144425","السريع"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127401","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201128","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202937","البسيط"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199442","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97885","المتدارك"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99314","الكامل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45239","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40102","المنسرح"],[4037,"","https://poetry.dctabudhabi.ae/diwan/poem/147405","البسيط"],[4075,"","https://poetry.dctabudhabi.ae/diwan/poem/177851","البسيط"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126358","الكامل"],[4619,"","https://poetry.dctabudhabi.ae/diwan/poem/28235","الخفيف"],[4693,"يبكي الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=29934",""],[4797,"ياساكن القلب وعن العين غطيت","https://www.poetsgate.com/ViewPoem.aspx?id=174652",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[5092,"بالجرحِ أكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=163044",""],[5189,"خانني التزييفُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=211713",""],[5387,"سراب","https://www.poetsgate.com/ViewPoem.aspx?id=53690",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5725,"كن في غيابة قلب من تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=212011",""],[5879,"ما رام قلبي حقلا لست جدوله","https://www.poetsgate.com/ViewPoem.aspx?id=215461",""],[5910,"لو كانتِ الأشعارُ تنطقُ","https://www.poetsgate.com/ViewPoem.aspx?id=206287",""],[5956,"رغم التآمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192938",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[6019,"مَرُّوا عليَّ طيوفاً","https://www.poetsgate.com/ViewPoem.aspx?id=175400",""],[6110,"في كاظمة أو ذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=141177",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[6213,"كل الهوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76310&r=&rc=58",""],[5567,"يانفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81771&r=&rc=39",""]],"verses":[["لا أَدَّعي فيهِ الغُلُوَّ وَإِنَّما","يوفي عَلى قُلَلِ الرِجالِ كَلامي",0,"م",2,0],["لا أدري حينَ حلَّ عقرب صدغ","سفر القلب في هواها رديّا",1,"ي",2,0],["لا أداجيك أيها السيّد البا","سِطُ نُعماهُ والمُداجِي كذُوبُ",2,"ب",1,0],["لا أدَعُ النصح ما استطعتُ وإن","لاقيتني بالعُبوس والزجر",3,"ر",1,0],["لا أُدرِكُ الأَمرَ أَهواهُ وَأَطلُبُهُ","وَأَبلُغُ الأَمرَ نَفسي لَيسَ تَهواهُ",4,"ا",2,0],["لا أَدَبٌ عِندَهُم وَلا حَسَبٌ","وَلا عُهودٌ لَهُم وَلا ذِمَمُ",5,"م",1,0],["لا أدَّعِي أنِّي وفَيْتُ بعهدِكمْ","ورعيتُكمْ إنّ الوفاءَ ضُروبُ",6,"ب",1,1],["لا أَدَعُ الأُلّافَ أَشتاقُهُم","وَاللَهوَ أَن أَتبَعَ فيهِم دَدَه",7,"د",2,0],["لا أَدَّعي لِأَبي العَلاءِ فَضيلَةً","حَتّى يُسَلِّمَها إِلَيهِ عِداهُ",8,"ا",2,0],["لا أَدَّعي العُذرَ عَن تَأخيرِ قَصدِكُمُ","لَيسَ المُحِبُّ عَلى بُعدٍ بِمَعذورِ",9,"ر",1,0],["لا أَدَّعي عِصمَةً لَكِن يَدِي عَلِقَت","بِسَيِّدٍ مَن يَرِد مَرعاتَهُ يَسُمِ",10,"م",1,0],["لا أدَّعي سهرَ العشاق يشبعَهُم","ياسامرَ الحي بي جْوع إلى السهَرِ",11,"ر",1,0],["لا أدخلُ الجحرَ يدي طائعاً","أخشى من الحيّةِ والعقربِ",12,"ب",1,0],["لا أَدَّعي الصَبرَ إِنَّ قَلبي","كانَ مِنَ الصَخرِ فَاِستَحالا",13,"ل",2,0],["لا أدَّعي أنْ قد أتمَّ نموَّه","من كان أمسِ بشكلِ طِفل حاب",14,"ب",1,0],["لا أدَّعي أنني أولَى بتَكرِمةٍ","وأنني فوقَ أصحابي وأقراني",15,"ن",2,0],["لا أدّعي هجر الخيال وإنما","أرَّقْتُ اجفاني فَسُد َّ طريقه",16,"ق",2,0],["لا أدري الساعة … أين أنا","أوّ ما اسمي … أو من أي مكان؟",17,"ن",1,0],["لا أَدَّعي بِالقَولِ فيكَ فَضيلَةً","باغي مَديحِكَ رائِدٌ لا يَتعَبُ",18,"ب",1,0],["لا أدّعي الفضلَ قبل يشهدُ لي","به أداني الدُّنَا وأقصاها",19,"ا",3,0],["لا أدعي فيك الغرام مغمغماً","في مثل حبك يكُشف المرموز",20,"ز",1,0],["لا أَدعِ الذُبابا","يسومُه عَذابا",21,"ب",2,0],["لا أَدخُلَ الشَكَّ بَيتَ مُعتَقِدي","أَغلَفَهُ أَو تَدُقَّهُ الغِيَرُ",22,"ر",1,0],["لا أَدَّعي جَوْرَ الزّمانِ ولا أَرى","لَيْلي يَزيدُ على اللّيالي طُولا",23,"ل",2,0],["لا أُداري ولا أُمالي ولا أش","هدُ زوراً ولا أُبدِّلُ نقلا",24,"ل",2,0],["لا أَدَّعِي السُّلوانَ عن حبِّكمْ","كلاًّ ولا أَكْتُمُ أَوْصَابي",25,"ب",2,0],["لا أدخل اللَه واو العطف بينكم","وإن فقدت فهم عاشوا ولا فقدوا",26,"د",3,0],["لا أدخل اللَه واو العطف بينكم","ولا لقيت وايناه أذى وعنا",27,"ن",2,0],["لا ادعت بعده الغصونُ قَواما","عند عيني ولا البدور تَماما",28,"م",2,0],["لا ادكارُ الأوطانِ سَنَّ لي الذُّ","لَّ ولا راعني الردى والرمْدُ",29,"د",1,0],["لا أدمُّ البين المشتَّ وقد","جادَ لنا بالمعظّم المفضال",30,"ل",1,0],["لا أدَّعى أننّي جلدٌ عليه ولا","أقولُاِنّي بدرعِ الصبرِ مدَّرعُ",31,"ع",1,0],["لا أدعيك لنفسي إن جنتها","تضيق عن كل هذا الماء والعشب",32,"ب",1,0],["لا أدْرَكتْ أُذُني ما ليس يُعجبني","فيه ولا مُقلتي ما ليس يُرْضيني",33,"ن",2,0],["لا أَدّعي أَنَّ النَّعيَّ أَصمَّني","في من أَصَمَّ وإِنَّما أَصْمَاني",34,"ن",2,0],["لا أدّعي صفة الكمال فلست في","شعري من الفصحاء والبلغاء",35,"ا",2,0],["لا ادقع وين معيوني","سكر مصر وانذاب",36,"ب",1,0],["لا أَدَّعي جَزَعاً للشامتين ولا","أرضى العَزآءَ لقلبي عنك يا عمَرا",37,"ر",2,0],["لا أَدَّعي القُدرَةَ مِن دونِهِ","بِاللَهِ حَولي وَبِهِ أَقدِرُ",38,"ر",1,0],["لا (آدم) المأثور صدك عن هدى","بحثا، ولا أغني اليقين فتيلا",39,"ل",2,0],["لا أَدَّعِى فيك ما قالوه من كذِبٍ","للعَيْن أَنّي وعنك الفِكْرُ مقصورُ",40,"ر",1,0],["لا أَدَّعى الإِدراك لكنْ لُحْن لي","منِّي علىَّ شواهِد ودلائِل",41,"ل",1,0],["لا أدعي انني وفيت واجبكم","إن اعترافي بالتقصير اوفى لي",42,"ل",2,0],["لا أدَّعي الحب وفي حالتي","للناس ما يغني عن الدَّعوى",43,"و",2,0],["لا أدري شيئا لا أرى","شيئا ولو مني اقترب",44,"ب",1,0],["لا اداوي آلام نفسي ببشْرٍ","بل اداوي الآلام بالآلام",45,"م",1,0],["لا أدّعي الخلق فيما قلته أبداً","نقلت من عالم المجهول أحياء",46,"ا",2,0],["لا أدركت تلك الأهلة دهرها","نقصاً ولا تلك النجوم أفولا",47,"ل",2,0],["لا أدركَ كنهُ الكونِ ولا","ماز المحدود من الحد",48,"د",1,0],["لا أدعي لك إنما بك أدعي","اني وصلت الى أعز جناب",49,"ب",1,0],["لا أُدخُلِ البَيتَ أَحبو مِن مُؤَخِّرِهِ","وَلا اِكسِّرُ في اِبنِ العَمِّ أَظفاري",50,"ر",2,0],["لا أدع الذبابا","يسميه عذابا",51,"ب",2,0],["لا أدبٌ عاطفٌ على أدبي","بل كلُّ وجْهٍ دَنَوْتُ منه زَوِ",52,"و",1,0],["لا أدعى نسبا في غير مولده","ولا ترسى بدار الذل أوتادى",53,"د",2,0],["لا أدعي أن جفني سحبة مطرت","من طول ما رعدوا وجداً وبرقوا",54,"ق",3,0],["لا أدّعي بطل العلاج وإنّما","بطل المنيّة أبطل الأعمالا",55,"ل",2,0],["لا أَدِيهِ حِقّاً وَلا اِبنَ لَبونٍ","وَمَعي مُهجَتي وَلا اِبنَ إِفالِ",56,"ل",1,0],["لا ادعي نيل الكمال وإنما","يملي عليّ الشعر قلب أصمع",57,"ع",1,0],["لا ادري بعنوانك ولا ادل لك بيت","وانا اتحرا لك شتاي ومصيفي",58,"ف",2,0],["لاْ آدَمَ الْمَقْمُوْعَ يُنْقِذُهَاْº وَ لاْ","فِيْ حَقِّهَاْ يَتَرَفَّقُ الرُّفَقَاْءُ",59,"ا",2,0],["لا أدّعي الطُهر دوماً في معاتبتي","لا تظلميني , فبعض الماء يغتسلُ",60,"ل",1,0],["لا أدَّعي لي في القريضِ قصيدةً","لا قصد فيها ظاهرٌ ونظيفُ",61,"ف",1,0],["لا أدري كنه علاقتنا","وحنين القلب إلى القلبِ",62,"ب",1,0],["لا أدّعي جَلَدا ً .. ولكنْ للهوى","حُكْمٌ يُطاعُ بشرْعِهِ المحبوبُ",63,"ب",1,0],["لا أدَّعي أنَّني أحتاجُ تَذكِرَة ً","فَمِنكُما فُصِّلَ التَّاريخُ تَفصيلا",64,"ل",2,0],["لا أدّليك فكل ما رجعتْ","سيارةٌ ساءوا لنا النجوى",65,"و",2,0],["لا أدعي أنني \"روح\" بلا خطإ","حتما أنا لست في الأعماق شيطانا",66,"ن",2,0],["لا أدَّعي الألقابَ إنَّ وراءها","شرًّا يؤجِّجُ في الخفاء سعيرَها",67,"ر",3,0],["لا أدَّعي المجدَ لولا المجد يلحقني","مهما هربتُ، لِكَوْنِ الأسرِ لي قدَرا",68,"ر",2,0],["لا أديم العيش في البر","ولكن في القواربْ",69,"ب",1,0],["لا أدري إن كان باب الدار أدخلَهُم","أم أنهم من شرايينِ الهوى مَرقوا",70,"ق",3,0],["لا أدري أين محلتها","فبقيت حسيراً كالوجم",71,"م",1,0],["لا أدعي علما ولكن ربما","قبضا من الريح التي لا تخدم",72,"م",1,0],["لا أدّعي أني أفيض طهارة","أنا شاعر متبعثر متجمع",73,"ع",1,0],["لا أدركُ الناس هل للناس تدركني","من أخطأ الحدس أم من ساقه الوجل",74,"ل",1,0],["لا أدركُ أسبابَ وجودي","إلا في نزقٍ ٍ قد أَزِفَا",75,"ف",2,0]]}