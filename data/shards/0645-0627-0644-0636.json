{"poems":[[93,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[318,"سقمي في الحب عافيتي","https://www.aldiwan.net/poem59480.html","المديد"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132679","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216817",""]],"verses":[["ما لّضَعيفِ مَعَ القَوِيِّ مَكانَةٌ","إِنَّ القَوِيَّ هُوَ الأَحَبُّ الأَفضَلُ",0,"ل",1,0],["مَا لِضُرِّ فِي مَحَبَّتِكُم","عِندَنا والله مِن أَلَمِ",1,"م",1,0],["ما لضعيف عندهم رحمة","وان يكن ضاق عليه الخناق",2,"ق",1,0],["ما لضحاياى لا أراها","لديك بالموضع المجاب",3,"ب",1,0]]}