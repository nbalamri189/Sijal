رْبِ في قدْسنا الفجْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=188290",""],[5550,"لماذا","https://www.poetsgate.com/ViewPoem.aspx?id=211905",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5606,"ليت فلان نام","https://www.poetsgate.com/ViewPoem.aspx?id=207434",""],[402,"مضى حسن في ذمة الله أنسه","https://www.poetsgate.com/ViewPoem.aspx?id=35345",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5953,"وباكي يبكي على ربه","https://www.poetsgate.com/ViewPoem.aspx?id=93796",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[5977,"كل التفاصيل","https://www.poetsgate.com/ViewPoem.aspx?id=213065",""],[5997,"وحي المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214233",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[5696,"إلى الخرطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65222&r=&rc=1",""]],"verses":[["وَمُنصَرِفٌ وَقَد أَثقَلتَ عِطفي","مِنَ النَعماءِ وَالمِنَنِ الجِسامِ",0,"م",1,0],["ومِنْ صِبْيَةٍ حُمْرِ الحَواصِلِ أصبَحَتْ","تُقَلِّبُ ذُعْراً بينَ أعْدائِها الطّرْفا",1,"ف",2,0],["ومُنْصَلِتٌ كالصُّبْحِ أشهَبُ ساطِعٌ","وأحْمَرُ وردِيٌّ وأصْفَرُ فاقِعُ",2,"ع",1,0],["ومن صَدَق الأخيارَ داوَوْا سقامَهُ","بصِحَّةِ آراءٍ ويُمْنِ نَقائبِ",3,"ب",1,0],["ومن صحِبَ الدنيا على جَوْرِ حُكمها","فأيّامُهُ محفوفةٌ بالمصائبِ",4,"ب",1,0],["وَمَن صَدَّ عَنِ المِلحِ","وَلَم يُقبِل عَلى الشُهدِ",5,"د",1,0],["وَمَن صابَرَ الدَهرَ صَبري لَهُ","شَكا في الثَلاثينَ شَكوى لَبيد",6,"د",1,0],["وَمَن صَحِبَ الدُنيا طَويلاً تَقَلَّبَت","عَلى عَينِهِ حَتّى يَرى صِدقَها كِذبا",7,"ب",2,0],["ومن صبرها في قتال السعير","تثبت فيها ولا تهرمُ",8,"م",1,0],["وَمُنصَرِفٌ عَنِ المَكارِمِ وَالعُلا","وَقَد شَرَعَت فَوتَ العُيونِ النَواظِرِ",9,"ر",1,0],["وَمِن صَولَةٍ في يَومِ بُؤسٍ عَلى العِدى","يُهالُ فُؤادُ الدَهرِ حينَ يَصولُها",10,"ل",3,0],["وَمَنصورٍ أُعينَ عَلى الأَعادي","بِكَرِّ عَواقِبِ الحَربِ العَوانِ",11,"ن",1,0],["ومن صُوَرِ الفكر محبوبةً","يعودُ عليلاً بها مستهاما",12,"م",2,0],["وَمَنصِبٍ نَماهُ","وَوالِدٍ سَما بِه",13,"ب",2,0],["وَمِنْ صِبْيَةٍ رِيعَتْ لِذَاكَ وَنِسْوَةٍ","قَوَائِمَ دُونَ الْبَابِ يَهْتِفْنَ بِالْوَالِي",14,"ل",2,0],["وَمُنصَلِتٍ كَالسَيفِ نُصرَةَ صاحِبٍ","وَضِحكَةَ بِشرٍ وَاِعتِزازَ مَقامِ",15,"م",1,0],["وَمَن صُنعِهِ يَومَ فَيلِ الحَبوش","إِذ كُلُّ ما بَعَثوه رَزَم",16,"م",1,1],["وَمِن صَوت حَمّاءِ العَلاطينِ غَرَّدَت","تُبَكّي عَلى غُصنٍ مِنَ الضالِ أَسحَمِ",17,"م",1,0],["وَمِن صُنعِ المَليكِ إِلَيَّ أَنّي","تَعَجَّلتُ الرَحيلَ فَما بَقَيتُ",18,"ت",1,0],["وَمِن صِفاتِ النِساءِ قِدماً","أَن لَسنَ في الوُدِّ مُنصِفاتِ",19,"ت",1,0],["وَمِن صَقرٍ يَقولُ لَهُ رُوَيداً","وَمِن شَرَكٍ يَصيحُ بِهِ تَعالَه",20,"ل",2,0],["وَمَنْ صَحِبَ اللْيالي عَلّمَتْهُ","خِداعَ الإلْفِ والقيلَ المُحالا",21,"ل",2,0],["وَمِنْ صَانِعٌ عُرْفَاً فَمُغْلِيهِ حِيطَةً","وَيَجْذَلُ أَنْ يُوفَى بِلَفْظَةِ تَمْدَاحِ",22,"ح",1,0],["ومنصب ملك أوحشت جنباته","وهالة إيوان تراءت بلا بدر",23,"ر",1,0],["ومن صمتي كتمثال","أشكل وجه نحاتي",24,"ت",2,0],["ومن صحب الصحراء هام بعالم","من السحر جنّي الطيوف رهيب",25,"ب",1,0],["ومن صميم سقمي","فما لجسمي فيّ",26,"ي",1,0],["ومنصب لم تفد منه بلهنية","من المعاش سوى أجر سنماري",27,"ر",2,0],["وَمِن صاحِبَيهِ بَعدُ تَعرِفُ قَدرَهُ","فَهَذا يُنَقي لِلرِسالَةِ صَدرَهُ",28,"ه",1,0],["وَمِن صارِمٍ أَبلى بِهامَةِ صارِمٍ","وَكَم مِن أَبيٍّ في العَرَمرَمِ عارِمٍ",29,"م",1,0],["ومنصب عال وسعد قائم","ويقظة منها العدو في وجل",30,"ل",1,0],["ومن صدقتني في الهوى وصدقتها","فلم نتعامل بالغرور وبالغدر",31,"ر",1,0],["وَمَنصِبُكَ السامي إِلى الفَخرِ مَنصِبي","وَرَبعُكَ رَبعي وَالعُلى أَنتَ آيِلُه",32,"ل",2,0],["وَمَن صُلبِ إِبراهيمَ جَدِّكَ عُصبَةٌ","يَسُرُّكَ في يَومِ التَلاقي مُقامُها",33,"م",3,0],["وَمَنصِبُها حَمشٌ أَحَمُّ يَزِينُهُ","عَوارضُ فِيها شُنبَةٌ وغُرُوبُ",34,"ب",1,0],["وَمَن صَحِبَ الأَخطارَ حَتّى غَدا لَها","أَليفاً فَما تَلَقى عَلى قَلبِهِ ذُعرا",35,"ر",2,0],["ومن صَحِب الليالي ذاقَ منها","ضُروبا ضِمنْها ضَرَبٌ وصاب",36,"ب",1,0],["ومن صلى بقوم أو تقرّا","يصولُ عليك كالعير النهوق",37,"ق",1,0],["ومن صلى بقوم أو تقرّا","فغثّ يشتكي أبدا مجاعه",38,"ع",2,0],["وَمنصبٌ ليلةَ المعراجِ خصّ به","كلُّ الورى عنه معدولٌ ومعزولُ",39,"ل",1,0],["ومن صهوات المقربات تقلقل","هدوت به كالطفل حرك مهده",40,"د",2,0],["ومن صحب الدنيا ولو عمر ساعة","تحول فيها حاله وتنوعا",41,"ع",2,0],["ومن صوّحت من عمره واحة المنى","فليس لصحراء الحياة بذاكر",42,"ر",1,0],["وَمِن صَباحَينِ ذا إِن زُرتُ زارَ وَذا","إِن لَم تَعُد مُرضي بِالوَصلِ لَم يَعُدِ",43,"د",1,0],["ومَن صدِئَتْ عيَنْي بناشئة الورَى","فلمّا رأَتْهُ حُودِثَتْ بجِلاء",44,"ا",2,0],["ومُنصِفةِ الأجفانِ في قسمةِ الضَّنَى","لها أوفرُ الأقسامِ مِنه إِذا امتُحِن",45,"ن",1,0],["ومن صدَّ تَخفيفاً فقد قامَ صدُّه","لمن لم يَجد عُذراً على الصدِّ بالعُذرِ",46,"ر",1,0],["وَمِن صَفا مائِها تَبدو ضَمائِرُهُ","فَكُلُ ما قَد طَواهُ غَير مُستَتَر",47,"ر",1,0],["ومن صحب الدنيا رأى كل عِبْرَةٍ","وفي نفسه يلقى الْعُجَابَ من الأمر",48,"ر",1,0],["ومن صدق الكهان أو كان آتياً","لامرأة في حشِّها غير مستهد",49,"د",1,0],["ومن صحب الأيام أيقن أنها","بأفعالها في الخلق من أخبث الصحب",50,"ب",1,0],["ومن صحب الدنيا قليلاً تقلَّبَتْ","على عينه حتى يرى صِدْقها كِذْباً",51,"ب",2,0],["ومن صارَ سِجني قطعة من صُدودِهِ","وَطول التَنائي قطعة مِن مَلالِهِ",52,"ل",2,0],["ومن صحب الدنيا رأى سوء فعلها","بتقليبها ظهر الأمر على البطن",53,"ن",1,0],["ومنصف أيديها إذا ما تقاصرت","خطاها وبوع الليل بعد طوالُ",54,"ل",1,0],["ومن صُعَداء أنفاسي شِرار","تمرُّ مع الجَنوب بها تنادي",55,"د",2,0],["ومنصدع الأمور بجاهكم من","صحيح الحب ملتئم ثقيف",56,"ف",1,0],["وَمِن صَحِبَ التَقوى فَلَيسَ بِنادِمٍ","إِذا صَرَخَت يَوماً عَلَيهِ الصَوارِخُ",57,"خ",1,0],["ومنصباً فوق السّمَاكين عرج","يا عائباً مدحي له انظر لا تلج",58,"ج",1,0],["ومِن صُحفٍ أدنَت قُطوفُ ثمارِها","وجَادت على القُرَى حَدائقُها الغُلبُ",59,"ب",1,0],["ومن صَبْوَةٍ نحو مُسْتَقلعِ ال","غُروسِ وشيكِ النّوى زائلِ",60,"ل",1,0],["ومَن صدّ عن مثل أفعالهمْ","كمنْ صدّ عن كُفَّة الحابِلِ",61,"ل",1,0],["وَمَنْ صَدَّ عَنْ وَجْهِ دُنْيَاهُمُ","وَقَدْ لَبِسَتْ حَلْيَهَا والحُلَلْ",62,"ل",1,0],["ومن صلاح أمرهم أن يخلعا","ويجمع الناس إلى ذاك معا",63,"ع",2,0],["ومن صَفَتْ مِنْه عَيْنٌ في الفؤادِ رأَى","ما خطَّهُ اللهُ فَوْقَ اللَّوحِ بالقَلَم",64,"م",1,0],["ومَنْ صَحَّ مِنْ داءِ الصَّبابَةِ قَلْبُه","رَأَى أَنَّ رأْي العَاذِلينَ صَوابُ",65,"ب",1,0],["ومن صدرك المملوء عطفا ورحمة","يضئ ويزهو للملوك وسام",66,"م",1,0],["ومن صميم قلبي","لعابد الستار",67,"ر",1,0],["وَمنصب أَكبر الوزراء أَضحى","بِذاتك سامياً قَولاً وَفعلا",68,"ل",2,0],["ومن صفاءٍ ومن وفاءٍ","ومن علاءٍ ومن أداةِ",69,"ه",1,0],["ومن صان منهم شعره وبيانه","على ما به صان الكرامة والعرضا",70,"ض",2,0],["ومن صوابك إعداد الرجال لها","بالعلم قبل القنا والمشرفيات",71,"ت",1,0],["ومن صارح القوم في أمسه","رأى اليوم فرصته فاغتنم",72,"م",1,0],["ومن صدقت أقواله ففعاله","رواة إلى الدنيا له وتراجم",73,"م",1,0],["وَمُنْصلي وَلَهْذمي وَجُرْزِي","مَنْ كان ذا حِزْرٍ فأنت حِزْزِي",74,"ز",2,0],["ومن صلف فيهم وخيلاء أنهم","يعيبوننا والعيب فيهم وعنهم",75,"م",1,0],["ومن صار ليثاً في المعارك كلها","وخير فتى قد صال بالسمرِ والبترِ",76,"ر",1,0],["وَمِن صَباحِ غَدِنا نَهَضنا","يَسوقُنا الشَّوقُ لِما قَصَدنا",77,"ن",2,0],["ومِنْ صلاح الرعايا عدل ذى ثقةٍ","عدْلٍ ومَعْه الثقاتُ العُدْلُ عمال",78,"ل",1,0],["ومن صيحّةٍ في الملتقى ثمّ سكتةٍ","وكلتاهما عندي ألذُّ منَ الخُلدِ",79,"د",1,0],["ومنصب الوحي ينبغي بغير ان","تعتدي دولة من الدول",80,"ل",1,0],["وَمِنْ صَباحٍ رامِياً مُجَشَّبا","فِإِنْ رَآنِي شاعِرٌ تَثَعْلَبا",81,"ب",2,0],["ومنصورٍ به لكن يُكنّى","بفرعون ويسوى ألف موسى",82,"س",2,0],["وَمنصل ذي فرندكم سطوت به","عَلى الزَمان إِذا ما جاء في عنق",83,"ق",1,0],["ومن صارت مباحته دواما","عليما فيه ادمان العطاء",84,"ا",2,0],["ومن صارت امانيه جميعا","وصال الحب في حلل الرضاء",84,"ا",2,0],["ومن صافي الغرام اسقوا","وقولوا حزت افضالا",85,"ل",2,0],["ومِن صَديق صادِقٍ أفرَدتَني","رَفِّه عَليَّ طالَما أنصَب