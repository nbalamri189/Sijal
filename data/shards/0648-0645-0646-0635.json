{"poems":[[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"ولما رأيت الدهر يؤذن صرفه","https://www.aldiwan.net/poem8677.html","الطويل"],[85,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[85,"سنون تعاد ودهر يعيد","https://www.aldiwan.net/poem63719.html","المتقارب"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[62,"أنات وذكرانها صنوها","https://www.aldiwan.net/poem52217.html","المتقارب"],[45,"عذيري من صرف الليالي الغوادر","https://www.aldiwan.net/poem63598.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[45,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[80,"رعى من أخي الوجد طيف ذماما","https://www.aldiwan.net/poem31291.html","المتقارب"],[44,"الحسن بن وهب","https://www.aldiwan.net/poem30588.html","مجزوء الرجز"],[87,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[21,"ومن صنعه يوم فيل الحبوش","https://www.aldiwan.net/poem36162.html","المتقارب"],[40,"يقول خليلي والمطي خواضع","https://www.aldiwan.net/poem42310.html","الطويل"],[46,"أيا طفل الشفيقة إن ربي","https://www.aldiwan.net/poem22155.html","الوافر"],[46,"الكون في جملة العوافي","https://www.aldiwan.net/poem22211.html","مجزوء البسيط"],[46,"ليذمم والدا ولد ويعتب","https://www.aldiwan.net/poem23172.html","الوافر"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54689","الطويل"],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""]],"verses":[["وَمُنصَرِفٌ وَقَد أَثقَلتَ عِطفي","مِنَ النَعماءِ وَالمِنَنِ الجِسامِ",0,"م",1,0],["ومِنْ صِبْيَةٍ حُمْرِ الحَواصِلِ أصبَحَتْ","تُقَلِّبُ ذُعْراً بينَ أعْدائِها الطّرْفا",1,"ف",2,0],["ومُنْصَلِتٌ كالصُّبْحِ أشهَبُ ساطِعٌ","وأحْمَرُ وردِيٌّ وأصْفَرُ فاقِعُ",2,"ع",1,0],["ومن صَدَق الأخيارَ داوَوْا سقامَهُ","بصِحَّةِ آراءٍ ويُمْنِ نَقائبِ",3,"ب",1,0],["ومن صحِبَ الدنيا على جَوْرِ حُكمها","فأيّامُهُ محفوفةٌ بالمصائبِ",4,"ب",1,0],["وَمَن صَدَّ عَنِ المِلحِ","وَلَم يُقبِل عَلى الشُهدِ",5,"د",1,0],["وَمَن صابَرَ الدَهرَ صَبري لَهُ","شَكا في الثَلاثينَ شَكوى لَبيد",6,"د",1,0],["وَمَن صَحِبَ الدُنيا طَويلاً تَقَلَّبَت","عَلى عَينِهِ حَتّى يَرى صِدقَها كِذبا",7,"ب",2,0],["ومن صبرها في قتال السعير","تثبت فيها ولا تهرمُ",8,"م",1,0],["وَمُنصَرِفٌ عَنِ المَكارِمِ وَالعُلا","وَقَد شَرَعَت فَوتَ العُيونِ النَواظِرِ",9,"ر",1,0],["وَمِن صَولَةٍ في يَومِ بُؤسٍ عَلى العِدى","يُهالُ فُؤادُ الدَهرِ حينَ يَصولُها",10,"ل",3,0],["وَمَنصورٍ أُعينَ عَلى الأَعادي","بِكَرِّ عَواقِبِ الحَربِ العَوانِ",11,"ن",1,0],["ومن صُوَرِ الفكر محبوبةً","يعودُ عليلاً بها مستهاما",12,"م",2,0],["وَمَنصِبٍ نَماهُ","وَوالِدٍ سَما بِه",13,"ب",2,0],["وَمِنْ صِبْيَةٍ رِيعَتْ لِذَاكَ وَنِسْوَةٍ","قَوَائِمَ دُونَ الْبَابِ يَهْتِفْنَ بِالْوَالِي",14,"ل",2,0],["وَمُنصَلِتٍ كَالسَيفِ نُصرَةَ صاحِبٍ","وَضِحكَةَ بِشرٍ وَاِعتِزازَ مَقامِ",15,"م",1,0],["وَمَن صُنعِهِ يَومَ فَيلِ الحَبوش","إِذ كُلُّ ما بَعَثوه رَزَم",16,"م",1,1],["وَمِن صَوت حَمّاءِ العَلاطينِ غَرَّدَت","تُبَكّي عَلى غُصنٍ مِنَ الضالِ أَسحَمِ",17,"م",1,0],["وَمِن صُنعِ المَليكِ إِلَيَّ أَنّي","تَعَجَّلتُ الرَحيلَ فَما بَقَيتُ",18,"ت",1,0],["وَمِن صِفاتِ النِساءِ قِدماً","أَن لَسنَ في الوُدِّ مُنصِفاتِ",19,"ت",1,0],["وَمِن صَقرٍ يَقولُ لَهُ رُوَيداً","وَمِن شَرَكٍ يَصيحُ بِهِ تَعالَه",20,"ل",2,0],["وَمَنْ صَحِبَ اللْيالي عَلّمَتْهُ","خِداعَ الإلْفِ والقيلَ المُحالا",21,"ل",2,0],["وَمِنْ صَانِعٌ عُرْفَاً فَمُغْلِيهِ حِيطَةً","وَيَجْذَلُ أَنْ يُوفَى بِلَفْظَةِ تَمْدَاحِ",22,"ح",1,0],["ومنصب ملك أوحشت جنباته","وهالة إيوان تراءت بلا بدر",23,"ر",1,0]]}