{"poems":[[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"ولما رأيت الدهر يؤذن صرفه","https://www.aldiwan.net/poem8677.html","الطويل"],[85,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[85,"سنون تعاد ودهر يعيد","https://www.aldiwan.net/poem63719.html","المتقارب"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[62,"أنات وذكرانها صنوها","https://www.aldiwan.net/poem52217.html","المتقارب"],[45,"عذيري من صرف الليالي الغوادر","https://www.aldiwan.net/poem63598.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[45,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[80,"رعى من أخي الوجد طيف ذماما","https://www.aldiwan.net/poem31291.html","المتقارب"],[44,"الحسن بن وهب","https://www.aldiwan.net/poem30588.html","مجزوء الرجز"],[87,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[21,"ومن صنعه يوم فيل الحبوش","https://www.aldiwan.net/poem36162.html","المتقارب"],[40,"يقول خليلي والمطي خواضع","https://www.aldiwan.net/poem42310.html","الطويل"],[46,"أيا طفل الشفيقة إن ربي","https://www.aldiwan.net/poem22155.html","الوافر"],[46,"الكون في جملة العوافي","https://www.aldiwan.net/poem22211.html","مجزوء البسيط"],[46,"ليذمم والدا ولد ويعتب","https://www.aldiwan.net/poem23172.html","الوافر"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54689","الطويل"],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[113,"هيمني آمي","https://www.aldiwan.net/poem40410.html","عموديه"],[122,"والهبر يرفل في نعمى تشرده","https://www.aldiwan.net/poem23730.html","البسيط"],[148,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[148,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[158,"لي منكم يا كهف الملوك والدول","https://www.aldiwan.net/poem58757.html","الرجز"],[158,"عيون المها ردى سهامك من نحر","https://www.aldiwan.net/poem58986.html","الطويل"],[167,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[167,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[179,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[180,"كل الأمر من الذي ملك الأمرا","https://www.aldiwan.net/poem67074.html","الطويل"],[183,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[184,"أقول لمن أراد الحزم يوما","https://www.aldiwan.net/poem43549.html","الوافر"],[184,"سألت عن العمى قوما ظرافا","https://www.aldiwan.net/poem43644.html","الوافر"],[187,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[259,"أشاقك من هذا الرديني قده","https://www.aldiwan.net/poem38143.html","الطويل"],[259,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[326,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[347,"تعاقبا لعقابي منك بالكمد","https://www.aldiwan.net/poem15624.html","البسيط"],[362,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[369,"أعادتك في حال الهوى عودةالفتن","https://www.aldiwan.net/poem57070.html","الطويل"],[369,"أمن جزع هذا التجنب أم صبر","https://www.aldiwan.net/poem57380.html","الطويل"],[377,"سقى دمشق ومن فيها بما رحبت","https://www.aldiwan.net/poem48771.html","البسيط"],[400,"خلعت ردا التشبيب عن منكب الفكر","https://www.aldiwan.net/poem33905.html","الطويل"],[400,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[400,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[400,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[403,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[438,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[456,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[466,"إذا شيد الإنسان أبنية التقى","https://www.aldiwan.net/poem60256.html","الطويل"],[493,"أنعت ليلا ذا سواد كالسبج","https://www.aldiwan.net/poem9804.html","مشطور الرجز"],[536,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[549,"ألا إن قلبي من بعدكم","https://www.aldiwan.net/poem47260.html","المتقارب"],[549,"وقوفي في ذا الورى الخامل","https://www.aldiwan.net/poem47292.html","الخفيف"],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[573,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"]],"verses":[["وَمُنصَرِفٌ وَقَد أَثقَلتَ عِطفي","مِنَ النَعماءِ وَالمِنَنِ الجِسامِ",0,"م",1,0],["ومِنْ صِبْيَةٍ حُمْرِ الحَواصِلِ أصبَحَتْ","تُقَلِّبُ ذُعْراً بينَ أعْدائِها الطّرْفا",1,"ف",2,0],["ومُنْصَلِتٌ كالصُّبْحِ أشهَبُ ساطِعٌ","وأحْمَرُ وردِيٌّ وأصْفَرُ فاقِعُ",2,"ع",1,0],["ومن صَدَق الأخيارَ داوَوْا سقامَهُ","بصِحَّةِ آراءٍ ويُمْنِ نَقائبِ",3,"ب",1,0],["ومن صحِبَ الدنيا على جَوْرِ حُكمها","فأيّامُهُ محفوفةٌ بالمصائبِ",4,"ب",1,0],["وَمَن صَدَّ عَنِ المِلحِ","وَلَم يُقبِل عَلى الشُهدِ",5,"د",1,0],["وَمَن صابَرَ الدَهرَ صَبري لَهُ","شَكا في الثَلاثينَ شَكوى لَبيد",6,"د",1,0],["وَمَن صَحِبَ الدُنيا طَويلاً تَقَلَّبَت","عَلى عَينِهِ حَتّى يَرى صِدقَها كِذبا",7,"ب",2,0],["ومن صبرها في قتال السعير","تثبت فيها ولا تهرمُ",8,"م",1,0],["وَمُنصَرِفٌ عَنِ المَكارِمِ وَالعُلا","وَقَد شَرَعَت فَوتَ العُيونِ النَواظِرِ",9,"ر",1,0],["وَمِن صَولَةٍ في يَومِ بُؤسٍ عَلى العِدى","يُهالُ فُؤادُ الدَهرِ حينَ يَصولُها",10,"ل",3,0],["وَمَنصورٍ أُعينَ عَلى الأَعادي","بِكَرِّ عَواقِبِ الحَربِ العَوانِ",11,"ن",1,0],["ومن صُوَرِ الفكر محبوبةً","يعودُ عليلاً بها مستهاما",12,"م",2,0],["وَمَنصِبٍ نَماهُ","وَوالِدٍ سَما بِه",13,"ب",2,0],["وَمِنْ صِبْيَةٍ رِيعَتْ لِذَاكَ وَنِسْوَةٍ","قَوَائِمَ دُونَ الْبَابِ يَهْتِفْنَ بِالْوَالِي",14,"ل",2,0],["وَمُنصَلِتٍ كَالسَيفِ نُصرَةَ صاحِبٍ","وَضِحكَةَ بِشرٍ وَاِعتِزازَ مَقامِ",15,"م",1,0],["وَمَن صُنعِهِ يَومَ فَيلِ الحَبوش","إِذ كُلُّ ما بَعَثوه رَزَم",16,"م",1,1],["وَمِن صَوت حَمّاءِ العَلاطينِ غَرَّدَت","تُبَكّي عَلى غُصنٍ مِنَ الضالِ أَسحَمِ",17,"م",1,0],["وَمِن صُنعِ المَليكِ إِلَيَّ أَنّي","تَعَجَّلتُ الرَحيلَ فَما بَقَيتُ",18,"ت",1,0],["وَمِن صِفاتِ النِساءِ قِدماً","أَن لَسنَ في الوُدِّ مُنصِفاتِ",19,"ت",1,0],["وَمِن صَقرٍ يَقولُ لَهُ رُوَيداً","وَمِن شَرَكٍ يَصيحُ بِهِ تَعالَه",20,"ل",2,0],["وَمَنْ صَحِبَ اللْيالي عَلّمَتْهُ","خِداعَ الإلْفِ والقيلَ المُحالا",21,"ل",2,0],["وَمِنْ صَانِعٌ عُرْفَاً فَمُغْلِيهِ حِيطَةً","وَيَجْذَلُ أَنْ يُوفَى بِلَفْظَةِ تَمْدَاحِ",22,"ح",1,0],["ومنصب ملك أوحشت جنباته","وهالة إيوان تراءت بلا بدر",23,"ر",1,0],["ومن صميم سقمي","فما لجسمي فيّ",24,"ي",1,0],["ومنصب لم تفد منه بلهنية","من المعاش سوى أجر سنماري",25,"ر",2,0],["وَمِن صاحِبَيهِ بَعدُ تَعرِفُ قَدرَهُ","فَهَذا يُنَقي لِلرِسالَةِ صَدرَهُ",26,"ه",1,0],["وَمِن صارِمٍ أَبلى بِهامَةِ صارِمٍ","وَكَم مِن أَبيٍّ في العَرَمرَمِ عارِمٍ",27,"م",1,0],["ومنصب عال وسعد قائم","ويقظة منها العدو في وجل",28,"ل",1,0],["ومن صدقتني في الهوى وصدقتها","فلم نتعامل بالغرور وبالغدر",29,"ر",1,0],["وَمَنصِبُكَ السامي إِلى الفَخرِ مَنصِبي","وَرَبعُكَ رَبعي وَالعُلى أَنتَ آيِلُه",30,"ل",2,0],["وَمَن صُلبِ إِبراهيمَ جَدِّكَ عُصبَةٌ","يَسُرُّكَ في يَومِ التَلاقي مُقامُها",31,"م",3,0],["وَمَنصِبُها حَمشٌ أَحَمُّ يَزِينُهُ","عَوارضُ فِيها شُنبَةٌ وغُرُوبُ",32,"ب",1,0],["وَمَن صَحِبَ الأَخطارَ حَتّى غَدا لَها","أَليفاً فَما تَلَقى عَلى قَلبِهِ ذُعرا",33,"ر",2,0],["ومن صَحِب الليالي ذاقَ منها","ضُروبا ضِمنْها ضَرَبٌ وصاب",34,"ب",1,0],["ومن صلى بقوم أو تقرّا","يصولُ عليك كالعير النهوق",35,"ق",1,0],["ومن صلى بقوم أو تقرّا","فغثّ يشتكي أبدا مجاعه",36,"ع",2,0],["وَمنصبٌ ليلةَ المعراجِ خصّ به","كلُّ الورى عنه معدولٌ ومعزولُ",37,"ل",1,0],["ومن صهوات المقربات تقلقل","هدوت به كالطفل حرك مهده",38,"د",2,0],["ومن صحب الدنيا ولو عمر ساعة","تحول فيها حاله وتنوعا",39,"ع",2,0],["ومن صوّحت من عمره واحة المنى","فليس لصحراء الحياة بذاكر",40,"ر",1,0],["وَمِن صَباحَينِ ذا إِن زُرتُ زارَ وَذا","إِن لَم تَعُد مُرضي بِالوَصلِ لَم يَعُدِ",41,"د",1,0],["ومَن صدِئَتْ عيَنْي بناشئة الورَى","فلمّا رأَتْهُ حُودِثَتْ بجِلاء",42,"ا",2,0],["ومُنصِفةِ الأجفانِ في قسمةِ الضَّنَى","لها أوفرُ الأقسامِ مِنه إِذا امتُحِن",43,"ن",1,0],["ومن صدَّ تَخفيفاً فقد قامَ صدُّه","لمن لم يَجد عُذراً على الصدِّ بالعُذرِ",44,"ر",1,0],["وَمِن صَفا مائِها تَبدو ضَمائِرُهُ","فَكُلُ ما قَد طَواهُ غَير مُستَتَر",45,"ر",1,0],["ومن صحب الدنيا رأى كل عِبْرَةٍ","وفي نفسه يلقى الْعُجَابَ من الأمر",46,"ر",1,0],["ومن صدق الكهان أو كان آتياً","لامرأة في حشِّها غير مستهد",47,"د",1,0],["ومن صحب الأيام أيقن أنها","بأفعالها في الخلق من أخبث الصحب",48,"ب",1,0],["ومن صحب الدنيا قليلاً تقلَّبَتْ","على عينه حتى يرى صِدْقها كِذْباً",49,"ب",2,0],["ومن صارَ سِجني قطعة من صُدودِهِ","وَطول التَنائي قطعة مِن مَلالِهِ",50,"ل",2,0],["ومن صحب الدنيا رأى سوء فعلها","بتقليبها ظهر الأمر على البطن",51,"ن",1,0],["ومنصف أيديها إذا ما تقاصرت","خطاها وبوع الليل بعد طوالُ",52,"ل",1,0],["ومن صُعَداء أنفاسي شِرار","تمرُّ مع الجَنوب بها تنادي",53,"ي",1,0],["ومنصدع الأمور بجاهكم من","صحيح الحب ملتئم ثقيف",54,"ف",1,0],["وَمِن صَحِبَ التَقوى فَلَيسَ بِنادِمٍ","إِذا صَرَخَت يَوماً عَلَيهِ الصَوارِخُ",55,"خ",1,0],["ومنصباً فوق السّمَاكين عرج","يا عائباً مدحي له انظر لا تلج",56,"ج",1,0],["ومِن صُحفٍ أدنَت قُطوفُ ثمارِها","وجَادت على القُرَى حَدائقُها الغُلبُ",57,"ب",1,0],["ومن صَبْوَةٍ نحو مُسْتَقلعِ ال","غُروسِ وشيكِ النّوى زائلِ",58,"ل",1,0],["ومَن صدّ عن مثل أفعالهمْ","كمنْ صدّ عن كُفَّة الحابِلِ",59,"ل",1,0],["وَمَنْ صَدَّ عَنْ وَجْهِ دُنْيَاهُمُ","وَقَدْ لَبِسَتْ حَلْيَهَا والحُلَلْ",60,"ل",1,0],["ومن صلاح أمرهم أن يخلعا","ويجمع الناس إلى ذاك معا",61,"ع",2,0],["ومن صَفَتْ مِنْه عَيْنٌ في الفؤادِ رأَى","ما خطَّهُ اللهُ فَوْقَ اللَّوحِ بالقَلَم",62,"م",1,0],["ومَنْ صَحَّ مِنْ داءِ الصَّبابَةِ قَلْبُه","رَأَى أَنَّ رأْي العَاذِلينَ صَوابُ",63,"ب",1,0]]}