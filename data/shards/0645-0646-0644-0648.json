{"poems":[[55,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[74,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[74,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[53,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[53,"للناس فيما يكلفون مغارم","https://www.aldiwan.net/poem66333.html","الكامل"],[45,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[42,"يا لقومي لطول هذا العتاب","https://www.aldiwan.net/poem42286.html","الخفيف"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[50,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[52,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[113,"من لوجدي وحيرتي والتهابي","https://www.aldiwan.net/poem16216.html","الطويل"],[113,"قمر إذا فكرت فيه تعتبا","https://www.aldiwan.net/poem16217.html","الكامل"],[113,"من لوجدي وحيرتي وافتقاري","https://www.aldiwan.net/poem16692.html","الخفيف"],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[189,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[234,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[276,"ما ضر وجد الهوى العذرى لوهانا","https://www.aldiwan.net/poem52061.html","البسيط"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[385,"من لولهان كئيب","https://www.aldiwan.net/poem49235.html","مجزوء الرمل"],[408,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[475,"طاف الخيال وطاف الهم فاعتكرا","https://www.aldiwan.net/poem4684.html","البسيط"],[556,"يا رب ليل أخذنا فيه منيتنا","https://www.aldiwan.net/poem47809.html","البسيط"],[580,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63721","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38014","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70761","المجتث"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84477","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79899","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79920","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79796","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96346","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42444","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53221","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110652","الخفيف"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105081","الخفيف"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131463",""],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121344","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127052","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126966","الرمل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86306","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28682","المنسرح"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133175","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139704",""],[4697,"يا بوش","https://www.poetsgate.com/ViewPoem.aspx?id=22667",""],[4709,"قلمٌ وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=214835",""],[4908,"طائر الغربات","https://www.poetsgate.com/ViewPoem.aspx?id=207531",""],[4924,"ملل","https://www.poetsgate.com/ViewPoem.aspx?id=34871",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5187,"أنا وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=29693",""],[5199,"شوطين اضافيه","https://www.poetsgate.com/ViewPoem.aspx?id=147582",""],[5277,"أخَوان..برضاعة الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=201013",""],[5351,"الأرض تعشق روح من ضحى","https://www.poetsgate.com/ViewPoem.aspx?id=202698",""],[475,"طَافَ الخَيَالُ وَطَافَ الهَمُّ فَاعْتَكَرَا","https://www.poetsgate.com/ViewPoem.aspx?id=20544",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5732,"يا روح روحي","https://www.poetsgate.com/ViewPoem.aspx?id=177940",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""]],"verses":[["مَن لَو يَشا طَعنَ العِدا بِرُؤوسِها","وَأَثارَ مِن جِريالِها قَسطالا",0,"ل",2,0],["من لو أعارت حلاه المشتري شرفاً","لم تعترضه عوادِي النحس من زحل",1,"ل",1,0],["من لو أشار إلى الدقائق كمّه","قرأت خواتمها عيون الأكمه",2,"ه",1,0],["من لو يزاحمُ ركنَي","ك آذناً بانهدامِ",3,"م",1,0],["مَنْ لو بخدمته تشاغَلَ مَعْشرٌ","خدموكُمُ أجدى على الخُدّام",4,"م",1,0],["مَن لَو رَآنِيَ ماءً ماتَ مِن ظَمَأٍ","وَلَو مَثَلتُ لَهُ في النَومِ لَم يَنَمِ",5,"م",1,0],["مَن لَو انَّ الفُؤادَ خُيِّرَ يَوماً","بَينَهُ صادِياً وَبَينَ الشَرابِ",6,"ب",1,0],["مِنْ لُؤْمِ أحْسَابِهِمْ إنْ شاتَمُوا رَبحوا","وَمِنْ حَقَارَتِهِمْ إنْ قاتَلوا خَسِروا",7,"ر",3,0],["مِن لَوعَةٍ لَيسَ تُطفى","تَطيرُ في جانِحاتي",8,"ت",2,0],["مِن لُؤلُؤٍ أَشِرِ الأَطرافِ مَنبَتُهُ","في طَيِّبِ الطَعمِ عَذبٍ بارِدٍ خَصِرِ",9,"ر",1,0],["من لَو عَلى البعد منه حيّا","أزال ما فيّ أَو أَراحا",10,"ح",2,0],["مَن لِوَجدي وَحيرَتي وَالتِهابي","وَلَدمَعي الهامي وَقَلبي المُذابِ",11,"ب",1,1],["مَن لَو أَصابَ البرا يَسر قَطرة","مِن راحَتيهِ عادَ رَوضاً مخصَبا",12,"ب",2,0],["مَن لَو نَظمت الشُهب فيهِ مَدائِحاً","لَظنَنت فكري قَد أَساءَ وَأَذنَبا",12,"ب",2,0],["مَن لِوَجدي وَحيرَتي وَاِفتِقاري","وَلذلي وَغُربَتي وَاِنكِساري",13,"ر",2,1],["من لوجه الأحساب يخدشه الغر","وينعى بالخدشة النكراء",14,"ا",2,0],["من لونِه ذهبٌ وأيُّ مَثوبةٍ","يَحْظَى بها لو خَصَّني بزَكاته",15,"ت",2,0],["مِن لوذعيِّ الطباع منتصح","ما خان نُعماك لا ولا غدرا",16,"ر",2,0],["من لو وزنت جَميع الاكرمين به","في الفضل والفخر خفوا عنه ميزانا",17,"ن",2,0],["مَن لو تَصافنَ ماءَ البحرِ عَسْكرُه","لَما استَتمَّ لهمْ في الشُّرْبِ دَوْران",18,"ن",1,0],["مَن لِوَلهان كَئيب","بَينَ همٍ وَكُروب",19,"ب",1,1],["مَن لو رآه البدرُ قال مخاطباً","أنت المليحُ وما سواكَ مَليحُ",20,"ح",1,0],["مِن لَوعَةٍ أَورَثَت قَرحاً عَلى كَبِدي","يَوماً فَأَصبَحَ مِنها القَلبُ مُنفَطِرا",21,"ر",2,0],["مِن لَونهِ يَستمدّ اللّيلُ ظلمتَه","والفجرُ من وجهه لاحت عساكرُهُ",22,"ر",2,0],["مَنْ لو أَبى الفلكُ الدَّوارُ طاعتَه","لصيَّر الرأْسَ منه موضعَ الذَّنَب",23,"ب",1,0],["من لَو رآه ابنُ إِدريس الإِمامُ إِذاً","أَقرَّ أَو قَرَّ عَيناً منه بِالنَظَرِ",24,"ر",1,0],["من لؤلؤٍ نضيدٍ","أو لؤلؤٍ نثير",25,"ر",1,0],["مَن لَو تَلَونا آيةً مِن فَضلِهِ","لَم نَستَمِعْ في الكَونِ غَيرِ مجوَّدِ",26,"د",1,0],["من لونها صار لون الزُّ","جاجِ أحمرَ أصْفر",27,"ر",1,0],["من لَو أَتاهُ كَسيرٌ عادَ منجبِراً","وَكانَ في نَفعِهِ كَالبُرءِ لِلسقَمِ",28,"م",1,0],["من لو عصبتَ بنانَ راحته","بالسيفِ ما درّت على العصب",29,"ب",1,0],["مَن لَو بِقيمة قدره","غاليتُ ما ساوى رجيعه",30,"ع",2,0],["من لو تساجِلهُ الغيوثُ","أراك وابلها رَشاشا",31,"ش",2,0],["من لو مشى حيثُ استحقَّ إذاً","لمشى على العيّوق والنَسر",32,"ر",1,0],["من لو يجود لعافٍ في نقيبته","لم يقرع السنَّ في آثارها ندما",33,"م",2,0],["من لوعة البيت إذ راح القطين بهم","ومضمر من دخيل الحب مكتوم",34,"م",1,0],["مِن لِوى عالِجٍ وَلَو أَمَّتِ العِي","سُ لِوى عالِجٍ لَأَرقَلنَ شَهرا",35,"ر",2,0],["من لوعةٍ وتشوُّقٍ وتلهُّفٍ","ولواعجٍ تركتْ وجودي مبهَما",36,"م",2,0],["من لو رآه ابن الحسين لما سرت","عنه الشوارد في بني حمدان",37,"ن",1,0],["من لوى من بني لؤي لواها","وطوى طود عزها وعلاها",38,"ا",3,1],["من لوّى بيض الوجوه اباة ال","ضيم اسد العرين شم الأنوف",39,"ف",1,0],["من لوجدي وشوقي واشجاني أثار","طبي نعمان مسكيّ الأنفاس",40,"س",1,0],["من لو يشاءُ أعادَ مشرقَها","متبسّماً لكَ من مغاربها",41,"ب",3,0],["من لوى من بني لوي لواها","وبأم الخطوب من ذا رماها",42,"ا",3,1],["من لوي من لوى أجيادها","بالمنايا من رمى آسادها",43,"ه",2,0],["من لَو عَلى البُعد حَيّاً كانَ يُحيينا","اَقولُ وَالنَفسُ تُبدي الشَوق هائِمَةً",44,"ه",1,0],["من لو تَجَلَّت والشموس طوالعٌ","لسمت ضياءً ثم فاقت سؤدَدا",45,"د",2,0],["من لو حوى بيديه عوداً يابساً","حقاً لأورق في يديه العود",46,"د",1,0],["مِن لُؤمِهِ أَنَّهُ إِذا مَنَعَ النَّا","سُ لَوى شِدقَهُ بِإِغرابِ",47,"ب",1,0],["من لوعتي أشكو ومن ضناها","أقول يا رب يا رحيم",48,"م",1,0],["من لوىٍّ لوى عماداً وفي غُل","بِ بنى غالب أراه ولوعا",49,"ع",2,0],["من لوّث البيئة حرايق ودخان","حتى شعاع الشمس عنه حجبنا",50,"ن",2,0],["من لوعتي اصفرَ وجهي شاحبا","أما الفؤادُ بحرقةٍ يتصدعُ",51,"ع",1,0],["من لوعة القلب الحزين وغربتي","من حيث ما عزف الحنين صداكا",52,"ك",2,0],["من لوعة المكنون أنا ونيت","وبيحت بعض الهم في شعري",53,"ر",2,0],["من لو تراهنه الورى في حلبة ال","علياء لم ير غيره من مقصب",54,"ب",1,0],["من لَوْنِه أخَذَ النَّهارُ ضياءَهُ","من لحنِهِ صوتُ الهزارِ يُموسَقُ",55,"ق",1,0],["من لوم والا عتاب والا تطاول","علامة استفاهم ناديت واوحاك",56,"ك",1,0],["من لؤلؤٍ صاغَ الجمالُ خدودَهَ","وعقيقُ عينيكِ السنا إذْ يبرقُ",57,"ق",1,0],["من لو أجابوها بصرختهم","قامت تمدُ السهل والسفحا",58,"ح",2,0],["مِنْ لَوْعَة ٍ أَوْرَثَتْ قَرْحاً عَلَى كَبِدِي","يوماً، فأصبحَ منها القلبُ منفرطا",59,"ر",3,0],["من لؤلؤ الصدر من خصري ومن عنقي","يمتصّ أوردتي الزرقاء مسعورُ!!",60,"ر",1,0],["من لوعتي من حسرتي يا حبيبي","من دمعتي من عبرتي من صوابي",61,"ب",2,0],["من لؤلؤٍ وزبرجد","ربّ البرية صنّعكْ",62,"ك",1,0]]}