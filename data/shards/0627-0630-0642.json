{"poems":[[57,"بموقف ذلي دون عزتك العظمى","https://www.aldiwan.net/poem24635.html","الطويل"],[77,"يا كوكب النحس من قرب على الحقب","https://www.aldiwan.net/poem36704.html","البسيط"],[41,"أغدوت أم في الرائحين تروح","https://www.aldiwan.net/poem42377.html","الكامل"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[88,"سمعت شعرا للعندليب","https://www.aldiwan.net/poem44413.html","مخلع البسيط"],[88,"أدب العلم وعلم الأدب","https://www.aldiwan.net/poem45003.html","الرمل"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[27,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[27,"حي الديار كوحي الكاف والميم","https://www.aldiwan.net/poem5980.html","البسيط"],[37,"أبرق وأرعد يا يزيد","https://www.aldiwan.net/poem7175.html","مجزوء الكامل"],[23,"ما نقمتم من ثياب خلفة","https://www.aldiwan.net/poem21262.html","الرمل"],[51,"أذقتنا ودك حتى إذا","https://www.aldiwan.net/poem65847.html","السريع"],[78,"القلب قد لج فما يقصر","https://www.aldiwan.net/poem14004.html","السريع"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[58,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[49,"بينا الفتى مرح الخطى فرحا بها","https://www.aldiwan.net/poem63218.html","الكامل"],[66,"يا رب ذنبي عظيم","https://www.aldiwan.net/poem38525.html","المجتث"],[40,"يا ويح هذا الطرف ما غمضا","https://www.aldiwan.net/poem42315.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"وخمار أنخت إليه رحلي","https://www.aldiwan.net/poem62483.html","البسيط"],[48,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[50,"ما بال عينك دمعها مسكوب","https://www.aldiwan.net/poem64802.html","الكامل"],[19,"كان بنو الأبرص أقرانكم","https://www.aldiwan.net/poem365.html","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43879","الكامل"],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[88,"يا ساكناً وهو مشنوق على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=25554",""],[39,"أَمِنْ دِمَنٍ بِشاجِنَة ٍ الحَجُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=4310",""],[118,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[158,"لم قدموا العجم إن كان الحديث كذا","https://www.aldiwan.net/poem58701.html","البسيط"],[158,"لم أستطع أنهى اللتي انهلت","https://www.aldiwan.net/poem59009.html","السريع"],[187,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[191,"رب جنين من جنى النمير","https://www.aldiwan.net/poem13053.html","الرجز"],[235,"أفدي رشا للوصال قالي","https://www.aldiwan.net/poem18859.html","مجزوء البسيط"],[250,"أيرجع عصر بالجزيرة رائق","https://www.aldiwan.net/poem1476.html",""],[254,"كل خفيف الرجلين ثقل","https://www.aldiwan.net/poem48530.html","مخلع البسيط"],[257,"بذكري لك اللهم أرجو تفضلا","https://www.aldiwan.net/poem35970.html","الطويل"],[259,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[364,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[374,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[374,"السيف والحيف في حرب وفي حربِ","https://www.aldiwan.net/poem66948.html","البسيط"],[377,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[413,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[413,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[441,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[466,"تهاونت مني بالذي فيك نظما","https://www.aldiwan.net/poem59695.html","الطويل"],[466,"أخ زاد معناه في صده","https://www.aldiwan.net/poem60234.html","المتقارب"],[477,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[480,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[498,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[541,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[549,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[549,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[561,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَذِقنا شَرابَ الأُنسِ يا مَن إِذا سَقى","مُحِبّاً شَراباً لا يُضامُ وَلا يَظما",0,"م",2,0],["إِذْ قَالَ شَاعِرٌ طَيّ فِي قَصِيدَتِهِ","وَهْوَ الْمُقَلَّدُ فِي عِلْمٍ وَفِي أَدَبِ",1,"ب",1,0],["إِذ قَالَتِ الحَسنَاءُ ما لِصَدِيقِنا","رثَّ الثيابِ وإنَّه لمَلِيحُ",2,"ح",1,0],["إِذ قَعقَعَ القَرَبُ البَصباصُ أَلحِيَها","وَاِستَرجَفَت هامَها الهيمُ الشَغاميمُ",3,"م",1,0],["إذ قال نفسي نفس رفيعه","لم تهو إلا حسن الطبيعة",4,"ه",1,0],["إذ قضى للعلم ربُّ الكائنات","بالعلا فهو زمام الملكوت",5,"ت",1,0],["إذ قصر عيسى كان عند مصبّه","وعليه منه أطلّت الغُرُفات",6,"ت",1,0],["إِذ قَرَّبوا جِلَّةً فُتلاً مَرافِقُها","مَيلَ العَرائِكِ إِذ هَمّوا بِإِصعادِ",7,"د",1,0],["إِذ قُلتَ عُمّالُ كَلبٍ ظالِمونَ لَنا","ماذا تَقَرَّبتَ مِن ظُلمٍ وَإِفسادِ",8,"د",1,0],["إِذ قُلتُ لِلتَيمِ لا تُدنوا فِلِزَّكُمُ","مِن قاطِعٍ طَبَقَ الأَعناقِ مَسمومِ",9,"م",1,0],["إذ قيل يا رخم انطقي","في الطير إنك شر طائر",10,"ر",1,0],["إِذ قَتَلتُم ماجِداً ذا مِرَّةٍ","واضِحَ السُنَّةِ مَعروفَ النَسَب",11,"ب",1,0],["أذَقْتَنا وُدّك حتى إذا","قلنا لذيذٌ كِدْتَ أن تغلو",12,"و",1,1],["إِذ قُلتُ هَل مِن أَلَمٍ طائِفٍ","ما بِكِ أَو شوقٌ فَما تَصبُرُ",13,"ر",1,0],["إذ قد غدا في النيه","أن تحفظ القضيه",14,"ه",1,0],["إذ قالت النظار","يا من له الفخار",14,"ر",1,0],["إِذ قَيظُها مِثلُ الرَبيعِ وَلَيلُها","مِثلُ النَهارِ يُخالُ رَأدَ ضَحاءِ",15,"ا",2,0],["أَذَقنا اِبنَ حَربٍ طَعنَنا وَضِرِابَنا","بِأَسيافِنا حَتّى تَولّى وَأَحجَما",16,"م",2,0],["إِذ قيلَ باتَ بِلَيلَةٍ ما باتَها","إِذ قيلَ أَصبَحَ مُثخَناً ما يُرتَجى",17,"ا",1,0],["إِذ قيلَ أَمسى شاخِصاً وَمُوَجَّهاً","وَمُعَلَّلاً إِذ قيلَ حَلَّ بِهِ الرَدى",17,"ا",1,0],["إِذ قُلتَ في الذِكرِ لِلمُص","طَفى وَأَنتَ كَريمُ",18,"م",1,0],["إِذ قَلبُها لي فارِغٌ كُلُّهُ","أَم كانَ شَيئاً كانَ ثُمَّ اِنقَضى",19,"ض",2,0],["إِذ قَدَّرَ الخِلافَ وَالعِصيانا","فَزادَهُ رَبُّ العُلى هَوانا",20,"ن",2,0],["إِذ قالَ قَد جاءَكُمُ الأَعرابُ","وَكَثُرَ الطِعانُ وَالضِرابُ",20,"ب",1,0],["إذ قالَ قد قَدَّستُهُ وعَصَمتُهُ","وَجَعَلتُ لِلأَجْناسِ منهُ رَسُولا",21,"ل",2,0],["إذ قامَ عَمُّكَ فِي الوَرَى مُستَسقِياً","كادَتْ تَجُرُّ عَلَى البِطَاحِ ذُيُولا",21,"ل",2,0],["إذْ قَلَّدانِيَ ما تُخْشَى عَواقِبُهُ","كأنَّني بِهِما هَدْيٌ مِنَ النَّعَمِ",22,"م",1,0],["إِذ قيلَ شَمسُ نَهارٍ","في أَربُعٍ عَطِراتِ",23,"ت",1,0],["أَذِقنيها لِأَعلَمَ ذاكَ مِنها","فَأَبرَزَ قَهوَةً ذاتِ اِرتِجاجِ",24,"ج",1,0],["إِذ قُلتُ مِن أَينَ لِلعَي","نِ يا فَدَيتُكَ أَصغَر",25,"ر",1,0],["إِذ قيلَ أَصبَحَ في المَقابِرِ ثاوِياً","عُمَرٌ وَشُقَّ لِواؤُهُ المَنصوبُ",26,"ب",1,0],["إِذ قالَ عَمروٌ لِبَني مالِكٍ","لا تَعجَلوا المِرَّةَ أَن تُحكَما",27,"م",2,0],["إذ قَومُها فَقَدتَهُ لا يُعَقِّلُها","حتَّى يُعَرِّفَكُم ذُلاًّ وإصغارا",28,"ر",2,0],["إِذْ قُمْت بِالأَمْرِ الجُسَامِ ولَمْ يَكُنْ","زَمَناً فَما مِنْ مُسْعِدٍ ومُوَالِ",29,"ل",1,0],["إِذ قامت الهيجا ولولا نصرُه","ما كان يعرف ليثُها من ذيبها",30,"ب",3,0],["إذ قامَ عَمُّكَرفي الورى مستسقياً","تُخْزُوا يَهُوذَا الآخِذَ البِرْطِيلا",31,"ل",2,0],["اذ قمت تطلب شيئاً انت جاهله","طوْعاً لمن خان أو سمْعاً لمن كذبا",32,"ب",2,0],["إذ قامتْ تأوَّدَ مسبكرٌّ","منَ القضبان في فننٍ كنينِ",33,"ن",1,0],["أذقتني النار في الدنيا فأحر بأن","يذيقني منك طعم الخلد رضوان",34,"ن",1,0],["إذ قدموا الآل من بعد النبي إذا","صلوا عليه على أصحابه النجب",35,"ب",1,0],["اذقتها ما ذاق يوم الوغا","من أحمد أعضا التي اعضلت",36,"ت",1,0],["إِذ قَد أتيت السيّد المَعصوما","صلّوا عليه وسلّموا تسليما",37,"م",2,0],["إِذ قَيظُهُ مِثلُ حَشا المَهجورِ","يُهدي إِلى الأَكبادِ وَالصُدورِ",38,"ر",1,0],["إِذْ قُلْتُ صَلْنِي حَبِيبَ قَلْبِي","يَا طَالِبَ الْخُوخِ فِي اللَّيَالِي",39,"ي",1,0],["إِذ قُلتُ يَصحو القَلبُ مِن فَرطِ ذكره","دَعا هاتِفٌ في الأَيك أَو لاح بارِقُ",40,"ق",1,0],["أذقهُ من غب ما جناه","ما ذاق يحيى من الرشيد",41,"د",1,0],["أَذِقني شَرابَ الذِكرِ في حَضرَةِ الصَفا","بِمَختومِ كَأسٍ بِالسَعادَةِ أَوّلا",42,"ل",2,0],["إذ قوا حميم الغيظ انفسهم اسى","وما زال داء النفس للنفس متلفا",43,"ف",2,0],["إِذ قُلتُ هاتيكَ النِيابُ ذَخِرتَها","خِلَعَ الطَبيبِ فَقُلتُ أَو أَكفاني",44,"ي",1,0],["إذ قال من يبغضْ أباه وأمَّه","وبنيه حتى نفسَه يتحكَّم",45,"م",1,0],["أذقت موتاً يسوعَ ابنَ الإله ضحىً","من إثمك المعتدي من سوء منقلَب",46,"ب",1,0],["إذ قد يكلّ السمعُ من إصغائِه","إذا جليسُ لجَّ في إهذائِهِ",47,"ه",1,0],["إذْ قام في لَفْحِ الهجيرة رافعاً","يدَه لأمْرٍ ما أقامَ وهَجرا",48,"ر",2,0],["أذقْتَهُم البأسَ عقوبةً","ويا طالما أنذرتهم بالزواجر",49,"ر",1,0],["أذقته العفو حُلواً عن جنايته","وكان عفوك عمَّن قد جنى كراما",50,"م",2,0],["إذ قد وهبت لي كيما ينجلي","ما بيننا عقدك ذات ليلة",51,"ه",1,0],["أَذَقتُكَ شَهداً مِن خَلِيَّةِ خاطِري","فَأَوهَمتَني أَنّي أَذَقتُكَ عَلقَما",52,"م",2,0],["أَذقناهُ أَحلى عِتابٍ لَنا","فَذُقنا الأَمَرَّينِ مِن صَدِّهِ",53,"د",2,0],["إذ قبرها صار شفعا","وكان قبله وترا",54,"ر",2,0],["أذقهم اللهم بؤس المشئمات","وقد خلت من قبلهم المثلات",55,"ت",1,0],["إذْ قالَ لا تحزَنْ وهَيْمَنَ قلبَهُ","بيدٍ بها مطوِيَّةٌ كلُّ الدُّوَلْ",56,"ل",1,0],["إِذ قَتَلنا بِالحِما ساداتِكُم","وَأَجَرناكُم وَفي ذاكَ اِعتِبارُ",57,"ر",1,0],["إذْ قامَتي مُمتدّةٌ وَذَوائِبي","مُسودّةٌ وَمسائحِي لم تَصْلَعِ",58,"ع",1,0],["إِذ قَناتي مُمتدّةٌ وَشفيعي","مِن شبابي إلى الحسانِ شفيعُ",59,"ع",1,0],["إِذ قَلبُها عَكَّ قَلبي","بِصالِبٍ وَمُلالِ",60,"ل",1,0],["إذ قد أقمتم من له أن يمضي","ذلكم برأيكم ويقضي",61,"ي",1,0],["إذ قدموا عليه فيما قد مضى","فمال عنهم وتولى معرضا",61,"ض",2,0],["إذ قام بالأمر ولي الناس","وإذ بنى الباني على الأساس",61,"س",1,0]]}