{"poems":[[57,"بموقف ذلي دون عزتك العظمى","https://www.aldiwan.net/poem24635.html","الطويل"],[77,"يا كوكب النحس من قرب على الحقب","https://www.aldiwan.net/poem36704.html","البسيط"],[41,"أغدوت أم في الرائحين تروح","https://www.aldiwan.net/poem42377.html","الكامل"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[88,"سمعت شعرا للعندليب","https://www.aldiwan.net/poem44413.html","مخلع البسيط"],[88,"أدب العلم وعلم الأدب","https://www.aldiwan.net/poem45003.html","الرمل"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[27,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[27,"حي الديار كوحي الكاف والميم","https://www.aldiwan.net/poem5980.html","البسيط"],[37,"أبرق وأرعد يا يزيد","https://www.aldiwan.net/poem7175.html","مجزوء الكامل"],[23,"ما نقمتم من ثياب خلفة","https://www.aldiwan.net/poem21262.html","الرمل"],[51,"أذقتنا ودك حتى إذا","https://www.aldiwan.net/poem65847.html","السريع"],[78,"القلب قد لج فما يقصر","https://www.aldiwan.net/poem14004.html","السريع"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[58,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[49,"بينا الفتى مرح الخطى فرحا بها","https://www.aldiwan.net/poem63218.html","الكامل"],[66,"يا رب ذنبي عظيم","https://www.aldiwan.net/poem38525.html","المجتث"],[40,"يا ويح هذا الطرف ما غمضا","https://www.aldiwan.net/poem42315.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"وخمار أنخت إليه رحلي","https://www.aldiwan.net/poem62483.html","البسيط"],[48,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[50,"ما بال عينك دمعها مسكوب","https://www.aldiwan.net/poem64802.html","الكامل"],[19,"كان بنو الأبرص أقرانكم","https://www.aldiwan.net/poem365.html","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43879","الكامل"],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[88,"يا ساكناً وهو مشنوق على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=25554",""],[39,"أَمِنْ دِمَنٍ بِشاجِنَة ٍ الحَجُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=4310",""]],"verses":[["أَذِقنا شَرابَ الأُنسِ يا مَن إِذا سَقى","مُحِبّاً شَراباً لا يُضامُ وَلا يَظما",0,"م",2,0],["إِذْ قَالَ شَاعِرٌ طَيّ فِي قَصِيدَتِهِ","وَهْوَ الْمُقَلَّدُ فِي عِلْمٍ وَفِي أَدَبِ",1,"ب",1,0],["إِذ قَالَتِ الحَسنَاءُ ما لِصَدِيقِنا","رثَّ الثيابِ وإنَّه لمَلِيحُ",2,"ح",1,0],["إِذ قَعقَعَ القَرَبُ البَصباصُ أَلحِيَها","وَاِستَرجَفَت هامَها الهيمُ الشَغاميمُ",3,"م",1,0],["إذ قال نفسي نفس رفيعه","لم تهو إلا حسن الطبيعة",4,"ه",1,0],["إذ قضى للعلم ربُّ الكائنات","بالعلا فهو زمام الملكوت",5,"ت",1,0],["إذ قصر عيسى كان عند مصبّه","وعليه منه أطلّت الغُرُفات",6,"ت",1,0],["إِذ قَرَّبوا جِلَّةً فُتلاً مَرافِقُها","مَيلَ العَرائِكِ إِذ هَمّوا بِإِصعادِ",7,"د",1,0],["إِذ قُلتَ عُمّالُ كَلبٍ ظالِمونَ لَنا","ماذا تَقَرَّبتَ مِن ظُلمٍ وَإِفسادِ",8,"د",1,0],["إِذ قُلتُ لِلتَيمِ لا تُدنوا فِلِزَّكُمُ","مِن قاطِعٍ طَبَقَ الأَعناقِ مَسمومِ",9,"م",1,0],["إذ قيل يا رخم انطقي","في الطير إنك شر طائر",10,"ر",1,0],["إِذ قَتَلتُم ماجِداً ذا مِرَّةٍ","واضِحَ السُنَّةِ مَعروفَ النَسَب",11,"ب",1,0],["أذَقْتَنا وُدّك حتى إذا","قلنا لذيذٌ كِدْتَ أن تغلو",12,"و",1,1],["إِذ قُلتُ هَل مِن أَلَمٍ طائِفٍ","ما بِكِ أَو شوقٌ فَما تَصبُرُ",13,"ر",1,0],["إذ قد غدا في النيه","أن تحفظ القضيه",14,"ه",1,0],["إذ قالت النظار","يا من له الفخار",14,"ر",1,0],["إِذ قَيظُها مِثلُ الرَبيعِ وَلَيلُها","مِثلُ النَهارِ يُخالُ رَأدَ ضَحاءِ",15,"ا",2,0],["أَذَقنا اِبنَ حَربٍ طَعنَنا وَضِرِابَنا","بِأَسيافِنا حَتّى تَولّى وَأَحجَما",16,"م",2,0],["إِذ قيلَ باتَ بِلَيلَةٍ ما باتَها","إِذ قيلَ أَصبَحَ مُثخَناً ما يُرتَجى",17,"ا",1,0],["إِذ قيلَ أَمسى شاخِصاً وَمُوَجَّهاً","وَمُعَلَّلاً إِذ قيلَ حَلَّ بِهِ الرَدى",17,"ا",1,0],["إِذ قُلتَ في الذِكرِ لِلمُص","طَفى وَأَنتَ كَريمُ",18,"م",1,0],["إِذ قَلبُها لي فارِغٌ كُلُّهُ","أَم كانَ شَيئاً كانَ ثُمَّ اِنقَضى",19,"ض",2,0],["إِذ قَدَّرَ الخِلافَ وَالعِصيانا","فَزادَهُ رَبُّ العُلى هَوانا",20,"ن",2,0],["إِذ قالَ قَد جاءَكُمُ الأَعرابُ","وَكَثُرَ الطِعانُ وَالضِرابُ",20,"ب",1,0],["إذ قالَ قد قَدَّستُهُ وعَصَمتُهُ","وَجَعَلتُ لِلأَجْناسِ منهُ رَسُولا",21,"ل",2,0],["إذ قامَ عَمُّكَ فِي الوَرَى مُستَسقِياً","كادَتْ تَجُرُّ عَلَى البِطَاحِ ذُيُولا",21,"ل",2,0],["إذْ قَلَّدانِيَ ما تُخْشَى عَواقِبُهُ","كأنَّني بِهِما هَدْيٌ مِنَ النَّعَمِ",22,"م",1,0],["إِذ قيلَ شَمسُ نَهارٍ","في أَربُعٍ عَطِراتِ",23,"ت",1,0],["أَذِقنيها لِأَعلَمَ ذاكَ مِنها","فَأَبرَزَ قَهوَةً ذاتِ اِرتِجاجِ",24,"ج",1,0],["إِذ قُلتُ مِن أَينَ لِلعَي","نِ يا فَدَيتُكَ أَصغَر",25,"ر",1,0],["إِذ قيلَ أَصبَحَ في المَقابِرِ ثاوِياً","عُمَرٌ وَشُقَّ لِواؤُهُ المَنصوبُ",26,"ب",1,0],["إِذ قالَ عَمروٌ لِبَني مالِكٍ","لا تَعجَلوا المِرَّةَ أَن تُحكَما",27,"م",2,0],["إذ قَومُها فَقَدتَهُ لا يُعَقِّلُها","حتَّى يُعَرِّفَكُم ذُلاًّ وإصغارا",28,"ر",2,0],["إِذْ قُمْت بِالأَمْرِ الجُسَامِ ولَمْ يَكُنْ","زَمَناً فَما مِنْ مُسْعِدٍ ومُوَالِ",29,"ل",1,0],["إِذ قامت الهيجا ولولا نصرُه","ما كان يعرف ليثُها من ذيبها",30,"ب",3,0],["إذ قامَ عَمُّكَرفي الورى مستسقياً","تُخْزُوا يَهُوذَا الآخِذَ البِرْطِيلا",31,"ل",2,0],["اذ قمت تطلب شيئاً انت جاهله","طوْعاً لمن خان أو سمْعاً لمن كذبا",32,"ب",2,0],["إذ قامتْ تأوَّدَ مسبكرٌّ","منَ القضبان في فننٍ كنينِ",33,"ن",1,0]]}