Poem.aspx?id=121521",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5190,"النيل يتحدث عن نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61840",""],[5246,"أبا سليمان يا من في الفؤاد له","https://www.poetsgate.com/ViewPoem.aspx?id=187051",""],[5281,"وفاءُ التَّاريخِ","https://www.poetsgate.com/ViewPoem.aspx?id=200243",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[592,"علماً بأن النقل نقل ثابت","https://www.poetsgate.com/ViewPoem.aspx?id=128723",""],[5431,"لعشتُ في الحوت لمْ تنفك أطواقي","https://www.poetsgate.com/ViewPoem.aspx?id=185286",""],[5431,"لا تغرها ببلاغة العرض....","https://www.poetsgate.com/ViewPoem.aspx?id=199881",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5660,"شَرِبتُ العِشقَ في الأَرحامِ صَفواً","https://www.poetsgate.com/ViewPoem.aspx?id=23799",""],[5725,"يا غصينا","https://www.poetsgate.com/ViewPoem.aspx?id=202816",""],[402,"أمنوا بموتك صولة الرئبال","https://www.poetsgate.com/ViewPoem.aspx?id=36074",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5865,"الحبّ.. حلب","https://www.poetsgate.com/ViewPoem.aspx?id=179834",""],[5897,"يا عيد .. ماذا عن غزة ؟","https://www.poetsgate.com/ViewPoem.aspx?id=174865",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5953,"يا محضر الغيد بالصمان بالغار","https://www.poetsgate.com/ViewPoem.aspx?id=93853",""],[5956,"ترجوني ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181967",""],[5956,"لن تشبع عيني","https://www.poetsgate.com/ViewPoem.aspx?id=182315",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6093,"لاشَكَّ أنَّكِ مُلهِمَتي","https://www.poetsgate.com/ViewPoem.aspx?id=195415",""],[6247,"بشراكِ أمَّ المؤمنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80290&r=&rc=29",""]],"verses":[["أَذِقنا شَرابَ الأُنسِ يا مَن إِذا سَقى","مُحِبّاً شَراباً لا يُضامُ وَلا يَظما",0,"م",2,0],["إِذْ قَالَ شَاعِرٌ طَيّ فِي قَصِيدَتِهِ","وَهْوَ الْمُقَلَّدُ فِي عِلْمٍ وَفِي أَدَبِ",1,"ب",1,0],["إِذ قَالَتِ الحَسنَاءُ ما لِصَدِيقِنا","رثَّ الثيابِ وإنَّه لمَلِيحُ",2,"ح",1,0],["إِذ قَعقَعَ القَرَبُ البَصباصُ أَلحِيَها","وَاِستَرجَفَت هامَها الهيمُ الشَغاميمُ",3,"م",1,0],["إذ قال نفسي نفس رفيعه","لم تهو إلا حسن الطبيعة",4,"ه",1,0],["إذ قضى للعلم ربُّ الكائنات","بالعلا فهو زمام الملكوت",5,"ت",1,0],["إذ قصر عيسى كان عند مصبّه","وعليه منه أطلّت الغُرُفات",6,"ت",1,0],["إِذ قَرَّبوا جِلَّةً فُتلاً مَرافِقُها","مَيلَ العَرائِكِ إِذ هَمّوا بِإِصعادِ",7,"د",1,0],["إِذ قُلتَ عُمّالُ كَلبٍ ظالِمونَ لَنا","ماذا تَقَرَّبتَ مِن ظُلمٍ وَإِفسادِ",8,"د",1,0],["إِذ قُلتُ لِلتَيمِ لا تُدنوا فِلِزَّكُمُ","مِن قاطِعٍ طَبَقَ الأَعناقِ مَسمومِ",9,"م",1,0],["إذ قيل يا رخم انطقي","في الطير إنك شر طائر",10,"ر",1,0],["إِذ قَتَلتُم ماجِداً ذا مِرَّةٍ","واضِحَ السُنَّةِ مَعروفَ النَسَب",11,"ب",1,0],["أذَقْتَنا وُدّك حتى إذا","قلنا لذيذٌ كِدْتَ أن تغلو",12,"و",1,1],["إِذ قُلتُ هَل مِن أَلَمٍ طائِفٍ","ما بِكِ أَو شوقٌ فَما تَصبُرُ",13,"ر",1,0],["إذ قد غدا في النيه","أن تحفظ القضيه",14,"ه",1,0],["إذ قالت النظار","يا من له الفخار",14,"ر",1,0],["إِذ قَيظُها مِثلُ الرَبيعِ وَلَيلُها","مِثلُ النَهارِ يُخالُ رَأدَ ضَحاءِ",15,"ا",2,0],["أَذَقنا اِبنَ حَربٍ طَعنَنا وَضِرِابَنا","بِأَسيافِنا حَتّى تَولّى وَأَحجَما",16,"م",2,0],["إِذ قيلَ باتَ بِلَيلَةٍ ما باتَها","إِذ قيلَ أَصبَحَ مُثخَناً ما يُرتَجى",17,"ا",1,0],["إِذ قيلَ أَمسى شاخِصاً وَمُوَجَّهاً","وَمُعَلَّلاً إِذ قيلَ حَلَّ بِهِ الرَدى",17,"ا",1,0],["إِذ قُلتَ في الذِكرِ لِلمُص","طَفى وَأَنتَ كَريمُ",18,"م",1,0],["إِذ قَلبُها لي فارِغٌ كُلُّهُ","أَم كانَ شَيئاً كانَ ثُمَّ اِنقَضى",19,"ض",2,0],["إِذ قَدَّرَ الخِلافَ وَالعِصيانا","فَزادَهُ رَبُّ العُلى هَوانا",20,"ن",2,0],["إِذ قالَ قَد جاءَكُمُ الأَعرابُ","وَكَثُرَ الطِعانُ وَالضِرابُ",20,"ب",1,0],["إذ قالَ قد قَدَّستُهُ وعَصَمتُهُ","وَجَعَلتُ لِلأَجْناسِ منهُ رَسُولا",21,"ل",2,0],["إذ قامَ عَمُّكَ فِي الوَرَى مُستَسقِياً","كادَتْ تَجُرُّ عَلَى البِطَاحِ ذُيُولا",21,"ل",2,0],["إذْ قَلَّدانِيَ ما تُخْشَى عَواقِبُهُ","كأنَّني بِهِما هَدْيٌ مِنَ النَّعَمِ",22,"م",1,0],["إِذ قيلَ شَمسُ نَهارٍ","في أَربُعٍ عَطِراتِ",23,"ت",1,0],["أَذِقنيها لِأَعلَمَ ذاكَ مِنها","فَأَبرَزَ قَهوَةً ذاتِ اِرتِجاجِ",24,"ج",1,0],["إِذ قُلتُ مِن أَينَ لِلعَي","نِ يا فَدَيتُكَ أَصغَر",25,"ر",1,0],["إِذ قيلَ أَصبَحَ في المَقابِرِ ثاوِياً","عُمَرٌ وَشُقَّ لِواؤُهُ المَنصوبُ",26,"ب",1,0],["إِذ قالَ عَمروٌ لِبَني مالِكٍ","لا تَعجَلوا المِرَّةَ أَن تُحكَما",27,"م",2,0],["إذ قَومُها فَقَدتَهُ لا يُعَقِّلُها","حتَّى يُعَرِّفَكُم ذُلاًّ وإصغارا",28,"ر",2,0],["إِذْ قُمْت بِالأَمْرِ الجُسَامِ ولَمْ يَكُنْ","زَمَناً فَما مِنْ مُسْعِدٍ ومُوَالِ",29,"ل",1,0],["إِذ قامت الهيجا ولولا نصرُه","ما كان يعرف ليثُها من ذيبها",30,"ب",3,0],["إذ قامَ عَمُّكَرفي الورى مستسقياً","تُخْزُوا يَهُوذَا الآخِذَ البِرْطِيلا",31,"ل",2,0],["اذ قمت تطلب شيئاً انت جاهله","طوْعاً لمن خان أو سمْعاً لمن كذبا",32,"ب",2,0],["إذ قامتْ تأوَّدَ مسبكرٌّ","منَ القضبان في فننٍ كنينِ",33,"ن",1,0],["أذقتني النار في الدنيا فأحر بأن","يذيقني منك طعم الخلد رضوان",34,"ن",1,0],["إذ قدموا الآل من بعد النبي إذا","صلوا عليه على أصحابه النجب",35,"ب",1,0],["اذقتها ما ذاق يوم الوغا","من أحمد أعضا التي اعضلت",36,"ت",1,0],["إِذ قَد أتيت السيّد المَعصوما","صلّوا عليه وسلّموا تسليما",37,"م",2,0],["إِذ قَيظُهُ مِثلُ حَشا المَهجورِ","يُهدي إِلى الأَكبادِ وَالصُدورِ",38,"ر",1,0],["إِذْ قُلْتُ صَلْنِي حَبِيبَ قَلْبِي","يَا طَالِبَ الْخُوخِ فِي اللَّيَالِي",39,"ل",2,0],["إِذ قُلتُ يَصحو القَلبُ مِن فَرطِ ذكره","دَعا هاتِفٌ في الأَيك أَو لاح بارِقُ",40,"ق",1,0],["أذقهُ من غب ما جناه","ما ذاق يحيى من الرشيد",41,"د",1,0],["أَذِقني شَرابَ الذِكرِ في حَضرَةِ الصَفا","بِمَختومِ كَأسٍ بِالسَعادَةِ أَوّلا",42,"ل",2,0],["إذ قوا حميم الغيظ انفسهم اسى","وما زال داء النفس للنفس متلفا",43,"ف",2,0],["إِذ قُلتُ هاتيكَ النِيابُ ذَخِرتَها","خِلَعَ الطَبيبِ فَقُلتُ أَو أَكفاني",44,"ن",2,0],["إذ قال من يبغضْ أباه وأمَّه","وبنيه حتى نفسَه يتحكَّم",45,"م",1,0],["أذقت موتاً يسوعَ ابنَ الإله ضحىً","من إثمك المعتدي من سوء منقلَب",46,"ب",1,0],["إذ قد يكلّ السمعُ من إصغائِه","إذا جليسُ لجَّ في إهذائِهِ",47,"ه",1,0],["إذْ قام في لَفْحِ الهجيرة رافعاً","يدَه لأمْرٍ ما أقامَ وهَجرا",48,"ر",2,0],["أذقْتَهُم البأسَ عقوبةً","ويا طالما أنذرتهم بالزواجر",49,"ر",1,0],["أذقته العفو حُلواً عن جنايته","وكان عفوك عمَّن قد جنى كراما",50,"م",2,0],["إذ قد وهبت لي كيما ينجلي","ما بيننا عقدك ذات ليلة",51,"ه",1,0],["أَذَقتُكَ شَهداً مِن خَلِيَّةِ خاطِري","فَأَوهَمتَني أَنّي أَذَقتُكَ عَلقَما",52,"م",2,0],["أَذقناهُ أَحلى عِتابٍ لَنا","فَذُقنا الأَمَرَّينِ مِن صَدِّهِ",53,"د",2,0],["إذ قبرها صار شفعا","وكان قبله وترا",54,"ر",2,0],["أذقهم اللهم بؤس المشئمات","وقد خلت من قبلهم المثلات",55,"ت",1,0],["إذْ قالَ لا تحزَنْ وهَيْمَنَ قلبَهُ","بيدٍ بها مطوِيَّةٌ كلُّ الدُّوَلْ",56,"ل",1,0],["إِذ قَتَلنا بِالحِما ساداتِكُم","وَأَجَرناكُم وَفي ذاكَ اِعتِبارُ",57,"ر",1,0],["إذْ قامَتي مُمتدّةٌ وَذَوائِبي","مُسودّةٌ وَمسائحِي لم تَصْلَعِ",58,"ع",1,0],["إِذ قَناتي مُمتدّةٌ وَشفيعي","مِن شبابي إلى الحسانِ شفيعُ",59,"ع",1,0],["إِذ قَلبُها عَكَّ قَلبي","بِصالِبٍ وَمُلالِ",60,"ل",1,0],["إذ قد أقمتم من له أن يمضي","ذلكم برأيكم ويقضي",61,"ي",1,0],["إذ قدموا عليه فيما قد مضى","فمال عنهم وتولى معرضا",61,"ض",2,0],["إذ قام بالأمر ولي الناس","وإذ بنى الباني على الأساس",61,"س",1,0],["إذ قد أرادوا منعَ أرباب العزا","بوقوعِ ما يجري الدما بمحرّمِ",62,"م",1,0],["إذ قال فارس عامر لهوازن:","الله درك، قد قدحت فأثقبي",63,"ب",2,0],["إذ قادَ نَصرُ اللهِ جَيشَك خارِجاً","بِفَتحٍ فلا يُثنيه فجٌّ ولا درب",64,"ب",1,0],["إذ قالَ كرِّرْ هاتمُ أبناءَكم","ونساءَكم حتى نُباهلَ في غَدِ",65,"د",1,0],["إذ قال من بَعد ما صلّى النبيُّ لهُ","أبشِرْ فقد ألتَ من وَعْكِ ومن سَقَمِ",66,"م",1,0],["أَذَقناهُمُ يَومَ المَدائِنِ بَأسَنا","صُراحاً وَأَسقَينا الأَلائِمَ عَلقَما",67,"م",2,0],["أذقتموني كأس الهجر مسرعة","ولوعة ضاق عنها السهل والجبل",68,"ل",1,0],["أَذَقتُ دعيَّ القوم من سمِّ منطقي","وأَحجِ بأنَّ السمَّ يتلَف ذائقه",69,"ق",2,0],["إذ قيظنا عِدْلُ الربي","ع وليلُنا عِدْلُ النهار",70,"ر",1,0],["أذقت المناوي منك كأس منيةٍ","أحاقَ به في البغي عاقبة المكرِ",71,"ر",1,0],["إِذ قمتُ أَركَبُهُ عِندَ الذّهابِ قَضى","فَأَركَبونيَ عنهُ أَشهبَ الصّبحِ",72,"ح",1,0],["إذ قال فيها ناقد مُتمثل","مبني بآجُر يُشاد وقرمد",73,"د",1,0],["إذ قلتُ للنفسِ عُودي بعد ما جشأت","وما ازدهاني بذاك الموطن الفَرقُ",74,"ق",1,0],["إِذ قُلتُ ما أَقساكَ قَلباً قالَ دَع","هَذا فَقَلبي لِلفِراقِ تَصَدَّعا",75,"ع",2,0],["إذ قال كنتم خير فيلهنكم","بالعز في الداري والاحترام",76,"م",1,0],["إذْ قالَ فِي كِتابِهِ إسْعُوْا لَها","وَبَيْعَكُمْ ذَرُوْهُ وَاقْضُوْا فِعْلَها",77,"ه",2,0],["إذ قلت ما جاوزت فيه واجبا","فلا تكن من واجب مغاضبا",78,"ب",2,0],["إذ قد علمت بأن منها المرء كم","يُكسى من التهذيب خير رداءِ",79,"ا",2,0],["إذ قد شممنا منه بئس روايح","مكروهة فاحت بشيءٍ منتنِ",80,"ن",1,0],["إذ قلت قول امرىء حكيمٍ","مراقب للإله علما",81,"م",2,0],["إذ قال صفها إنما حسنها","أصدق من حسنِ ذوات الخدور",82,"ر",1,0],["إذْ قوتُ أجسامِهِمْ ممَّا يبيعهُمُ","وقوتُ أرواحهِمْ من حُسْنِ صورَتِهِ",83,"ه",1,0],["اذقني من التوحيد كأس موفق","تدوم بها في حضرة القرب سكرتي",84,"ي",1,0],["إذ قد جنى الدهرُ ما لم تَستطع مَعهُ","نشرَ المسرَّةِ لكن راجَعَ الندما",85,"م",2,0],["إذ قالَ لي سوفَ ناتي الحيَّ عن عجَلٍ","فسِر هُديتَ فإنّي غيرُ مبطاءِ",86,"ا",2,0],["أذقت الحمام ابني عباد فاصبحوا","بمنزل موهون الجناح ثكول",87,"ل",1,0],["إِذ قلن يا ريح الصبا","باللَه بالأَحباب عوجي",88,"ج",2,0],["إذ قهقه البيض بوقع الظبا","واعتنق الأسمر بالأسمر",89,"ر",1,0],["إذ قد تحوَّلَ نحو وجهي وجهُهُ","فتسعَّرَت في مُهجتي آلامي",90,"ي",1,0],["إذ قال هل في النحو انت تدري","فقلت سلنى فيه تعرف قدري",91,"ي",1,0],["إذ قلت ما هذا به قراري","لأن ذا المبيت ذي قار",91,"ر",1,0],["إذ قد ذكرت بليلة فركبت في","غَدِها من ارضِ القيروان مُبكّرا",92,"ر",2,0],["إذْ قُلْتُ فِيِهِ أنَه قَدْ مُلِي","مِنْ فَيْضِهِ الْبَيدَاءُ وُالسَّبْسَبُ",93,"ب",1,0],["إذْ قامَ بِالعِبء الثَّقِيلِ لِثَأرِهِ","وَالحَزمُ بِالشَّهْمِ السُؤَيَّدِ أوفَقُ",94,"ق",1,0],["إذ قلتُ هذا مَنهَلٌ عن منهلُ","ورايةُ برقٍ نحوَها القلبُ يجنبُ",95,"ب",1,0],["إِذ قُلتَ شِعراً فَاحتَرِز مِنهُ إِنَّهُ","خَبِيرٌ إِذا لَم يَنقُدِ الشِعرَ ناقِدُه",96,"د",2,0],["إذ قام ناعيهم فينا فصبحنا","من نعيهم بدواه تكسف القمرا",97,"ر",2,0],["إِذْ قال قائِلُهم غداةَ كِفاحِنا","لي أَين قحطان أُباةُ العار",98,"ر",1,0],["إذ قال ركب لركب سائرين معا","لا بد أن تسمعونا أو تغنونا",99,"ن",2,0],["إذ قدمت رأس الفساد وأخرت","عين السداد وأمرت كفارها",100,"ر",3,0],["أذ قادها شعث النواصي","عاقدات للذيول",101,"ل",1,0],["إِذ قدرُ كلِّ مليحٍ","يَنحَطُّ عندَ عليّ",102,"ي",1,0],["إذ قد تسمى الله في خلقه","بما سمعتم وهو المنصفُ",103,"ف",1,0],["اذ قلتُ لها بّوابنا انتِ متى","ما غبتِ نخاف من دخول الصبح",104,"ح",1,0],["إذ قيل في نظافة الأبدانِ","والثوب والمكان عمرٌ ثان",105,"ن",1,0],["إذ قَالَ إبرَاهِيمُ ليسَ خِليلَهُ","كلا ولا مُوسى الكليمَ الداني",106,"ن",2,0],["إذ قَالَ لَيسَ بداخِلٍ فِينَا وَلاَ","هُوَ خَارِجٌ عَن جُملَةِ الأكوَانِ",106,"ن",1,0],["إذ قالَ مُوسَى رَبُّنَا مُتَكَلِّمٌ","فَوقَ السَّمَاءِ وَإنَّهُ نَادَانَي",106,"ن",2,0],["إذ قَد تَسَاعَدنَا بأنَّ نَصوصَهُ","لَفظِيَّةٌ عُزِلَت عَنِ الإيقَانِ",106,"ن",1,0],["إذ قَالَ أنتَ كَذا فَليسَ لِضدِّنهِ","أبَداً إلَيكَ تَطَرُّقَ الإتيَانِ",106,"ن",1,0],["إذ قَالَ إنَّ إلهَنَا حَقًّا يُرَى","يَومَ المَعَادِ كَمَا يُرَى القَمرَانِ",106,"ن",1,0],["إذ قَد أحَاطَ العِلمُ مِنهُم أنَّهُم","لَيسُوا بمعصُومِينَ بالبُرهَانِ",106,"ن",1,0],["إذ قَالَ رَبِّي فِي السَّمَاءِ لِرَغبَتِي","وَلِرَهبَتِي أدعُوه كُلَّ أوَانِ",106,"ن",1,0],["إذ قَالَ ذَا القُرآنُ نَفسُ كَلاَمِهِ","مَا ذَاكَ مَخلُوقٌ مِنَ الأكوَانِ",106,"ن",1,0],["إذ قَالَ تَفسِيرُ المُرَانِ وَكَشفُهُ","وَبَيَانُ مَعنَاهُ إلى الأذهَانِ",106,"ن",1,0],["إذ قُلتُمُ إنَّ المُرَادَ كَذَا فمَا","ذَا دَلَّكُم أتَخَرُّصُ الكُهَّانِ",106,"ن",1,0],["إذ قَالَ أنَّهُمُ مُشَبِّهَةٌ وَأن","تُمُ مِثلُهُم فَمَنِ الَّذِي يَلحَانِي",10