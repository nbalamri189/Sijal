","عنهنّ يغيب فكر كلّ قنيص",123,"ص",1,0],["أَذَقتُم رِجالاً خَيَّمَ العِزُّ حَولَهُم","بِأَسيافِكُم في الدَهرِ ذُلَّ المَناخِرِ",124,"ر",1,0],["إذ قام مضطلعا بالأمر مفترعاً","عزاً تقاعس عنه كل معتزم",125,"م",1,0],["إذ قام هذا الصبح يظهر ملةً","حكمت بأن ذبح الظلام الكافر",126,"ر",1,0],["أَذِقنيَ طَعمَ الأَمنِ أَو سَل حَقيقَةً","عَلَيَّ فَإِن قامَت فَفَصِّل بنانِيا",127,"ي",2,1],["أَذقتُ المَنايا بَعضَهُنَّ بِأَسهُمي","وَقَدَّدنَ لحمي وَاِمتَشَقنَ ردائِيا",127,"ي",2,0],["إذ قيل يفرق كل أمر محكم","فيها وفيها تسقط الورقات",128,"ت",1,0],["إذ قلت أنساها على نأي دارها","تصور في عيني وقلبي مثالها",129,"ل",3,0],["إذ قيل كم مزيّف صحيحا","لأجل كون فهمه قبيحا",130,"ح",2,0],["إِذ قُمنَ بِالقَلعة الشهباء مائِلَةً","طوعَ الرياح عَلى العَسّالة الذُّبُلِ",131,"ل",1,0],["إذ قال قنبلتي طرابلس متى انف","جرت تر الدول الدما كسيول",132,"ل",1,0],["إذ قمت في جنح الدياجي معرضاً","عن كل شيء للاله تعبد",133,"د",1,0],["إذ قال اني حجةٌ في الورى","من عالم بالسر سبوح",134,"ح",1,0],["إذ قال فيه وفي اخيه ان هما","قاما وان قعدا اماما امتي",135,"ي",1,0],["إذ قضت حكمته جعل الجزا","حسب الأفعال وعدا ووعيدا",136,"د",2,0],["إذ قلت: يا صاحب الحبشان إن لنا","من دون أن يهدم المعمور أخطارا",137,"ر",2,0],["إذ قد تطيرتُ من نعبِ الغرابِ ضُحىً","وقلتُ بينٌ وحى بالنعبِ طائرُهُ",138,"ر",2,0],["إذ قد اتتهُ طَعنةٌ نَجلاءُ غا","صَ بها إلى أَقصى الفُؤادِ اللَهذَمُ",139,"م",1,0],["اذ قامَ موسى رأسَ عهدٍ تالدٍ","وكذا الصفا راسُ الطريق الثاني",140,"ن",2,0],["إذ قال لنا من اين لكم","ختمٌ بالخير لهم يفرضْ",141,"ض",1,0],["أَذقهم اليوم ما بالأَمس قَد فعلوا","وَاذكر لهم سيئاً جمّاً موازيرا",142,"ر",2,0],["إذ قضاني الزمان غاية آما","لي فما لي بذمّة الدهر مغرم",143,"م",1,0],["إِذ قَضَيتُم بِالحَقِّ في ثُلثِ مالٍ","لَم يَكُن مُغنياً عَن اِبنِ النَشانجي",144,"ج",2,0],["إذ قال لي من لفظه","أشهى كلام مفحم",145,"م",1,0],["إذ قام يحمي من التوحيد جانبه","وما أصاخ لأهل الزور والمين",146,"ن",1,0],["إذ قال أعطاؤك الأجناد مالهم","يفني الخزائن فاحفظ واترك السرفا",147,"ف",2,0],["أذقتم الول اسرانا وما برحت","اسراكم عندنا ترعى وتحترم",148,"م",1,0],["اذقان بيض غلّفت","لمبصر ومنتشق",149,"ق",1,0],["إِذ قالَ أَوسٌ أَما مِن طَيّ مِن رَجُلٍ","يَحمي الذِمارَ وَبيضَ القَومِ تَأتَلِقُ",150,"ق",1,0],["إذ قصباتُ العريش تجمعنا","حتى تجلَّت أواخرُ الظُّلمِ",151,"م",1,0],["أذقت الشام سبع سنين جدباً","غداة هجرته هجراً جميلا",152,"ل",2,1],["إِذ قُرَيظَةُ سَنبَلَت بِاختِيانٍ","حُمُرٌ فِي كُفرٍ أضَلُّوا وَبَاءُوا",153,"ا",1,0],["إذ قالَ والتخصيصُ لازِمُ ال","تقديمِ غالباً لذي الفطنِ",154,"ن",1,0],["إذ قائلُ الوجود بالحقِّ كفرْ","وتاركُ الوجودِ عن شرعٍ نفرْ",155,"ر",1,0],["إذ قلتَ ندعوك فتستجِبْ لنا","أولَيتَنا بذاك ربِّ فضلَنا",156,"ن",2,0],["أذِقنيَ بالعتبى جَنى النحل منعما","فأنك قد جرتعني الصاب بالعَتبِ",157,"ب",1,0],["إذ قد أطالوا الحرب والإبلاء","ولم يوافوا فيكم وفاء",158,"ا",2,0],["إذ قد اتحت الفتك والتنكيلا","للقوم حتى يبلغوا الأسطولا",158,"ل",2,0],["إِذ قيل مِن المعلا ركنٌ يوطدهُ","دَلَت عَلَيهِ مِن الغازي اَصابعهُ",159,"ع",2,0],["إِذ قاَمَ جَلَّ رَبُّنَا بِذَِاتِ","لَكانَ مَعدُوماً مِنَ الصِّفَاتِ",160,"ت",1,0],["إِذ قالَ لا تَغضَب وَقال إِلهنا","وَالكاظِمينَ الغَيظ فَاِتبَع تَهتَدي",161,"د",2,0],["إذْ قيلَ قد قُتِل الرسُول ولَمْ يَخِمْ","حتَّى تبيّنَ ذاكَ غيرَ خفاءِ",162,"ا",2,0],["إِذ قُلتُ وَمَن يوصِلُني نَحوَكُم","قالوا اِهتَدِ نَحوَنا بِنار العِشقِ",163,"ق",1,0],["إذ قد جرى فيه بأعلى سَنَن","لم يلق من في أنصافه من أحد",164,"د",1,0],["إذ قام كالقسور من غيله","تحفه الأشبال فرسانا",165,"ن",2,0],["إذ قد تحلى بشهد من تواصلنا","وبالعقود من الأخبار والسير",166,"ر",1,0],["إذ قد اطعت بكل غي آمري","وعصيت ما تهذي به اللوام",167,"م",1,0],["أذقني صفا شهد الشهود باكؤس","لأهل الوفا ساقي الوجود لها ملا",168,"ل",2,0],["إذ قيل لي أرخ فصاح مُبشري","الياس حيّاً قد ثوى دار النعيم",169,"م",1,0],["إذ قد حباك ذا الرأوف تعطفاً","بفراسة الإيمان وهو خبيرُ",170,"ر",1,0],["إذ قد أتانا من سخاهُ وآصهٌ","مولىً بإعمار البلاد مجاهدُ",171,"د",1,0],["إذ قد حبانا عَزيزاً عزَّ عن شبهٍ","مليكَ مُلكٍ وَجى الأكوان تسعيدا",172,"د",2,0],["إذ قد سما فضلا بكل ما كتب","وكلما يليه كسره وجب",173,"ب",1,0],["إذ قلتُ أينَ الرَّاحُ قلتَ مُغالطاً","يُغنَيكَ عنها رشفُ ثغري الألعسِ",174,"س",1,0],["أَذِقني شرابَ الأنسِ في حضرة الرِضى","بِقُرب حَبيب اللَه وَاِشرح به صَدري",175,"ر",2,0],["أذِق عينهُ هجوعاً","تمتَّعتَ بالهُجوعِ",176,"ع",1,0],["إذ قال باليمن حاز أرخ","ابن شريف بنت السعيد",177,"د",1,0],["إذ قال يهنيك يا سميري","ما فيه قد يفرح السمير",178,"ر",1,0],["اذ قام اسماعيل يحكم آمرا","بالحق والتقوى له سيماء",179,"ا",2,0],["إذ قمت فيها ربع قرن أسقفاً","مابيننا فغدت بحزمك تطرب",180,"ب",1,0],["اِذ قالَ قد أبطَلتُ منكَ تهجّداً","قلتُ التَّهجُّدُ صارَ بالقُبُلاتِ",181,"ت",1,0],["اِذ قالَ لي هلاّ ضمَمتَ مُتيّماً","قاسى النوى من قبلِ أنْ يتَحتَّما",182,"م",2,0],["اِذ قالَ فِزتُ ولم يَهِنْ كلّا ولا","منها تزلزلَ في الفؤادِ يقينُ",183,"ن",1,0],["إذ قد نهى المصطفى عن خفر ذمته","وإن يكون لوالي الأمر عصيانُ",184,"ن",1,0],["إذ قد وُهبنا, وقد حلّ المَشيبُ بنا","مسكَ الختام وصفوَ الرّاح والسّكر",185,"ر",1,0],["إذ قد ظنَنّا أنّ ما حصّلْته","مِن عِلْمِ جامعةٍ هو التّهذيبُ",186,"ب",1,0],["أذَقْتَ فؤادي صُنوفَ البلاءِ","كأنّكَ (بُوشٌ) وقلبي (العراقْ)!",187,"ق",1,0],["إِذْ قَالَ زُورَاً طُولَ عِقْدٍ كَامِلٍ","وَالْمَاءُ لَيْسَ سُواهُ فِى الثَّلَّاجَةْ !",188,"ه",1,0],["إذ قرأ القاضي حليف الكيس","معاني الشعر على العبيسي",189,"س",2,0],["إذ قال أمته غدت علماؤها","كالأنبياء بهديها لا ترتب",190,"ب",1,0],["إذ قلت في صدر العقيدة سادراً","ما زال ذلك منذ غيبة أحمد",191,"د",1,0],["إذ قام بحجل حين بشر أنه","في الخلق والأخلاق شبه محمد",191,"د",1,0],["أذقني كأس الحب كأساً روية","ولله كأس ما ألذ وأحلاه",192,"ا",2,0],["إذ قال دونك فاقبل كف رملة في","عش الزواج وعش بعلا يغشيها",193,"ي",3,0],["إذ قال أشهدكم أني نزلت له","عن زينب لا قلى فيها ولا تيها",193,"ي",3,0],["إذ قال مصيب في تكهنه","بأنّ دينهم المعوج لم يقم",194,"م",1,0],["إذ قلّداني ما تخشى عواقبه","وألبساني رداء غير محترم",194,"م",1,0],["أَذَقْتُهُ المُرَّ فَاجتَرَّت جَحَافِلُهُ","قَاتَ الهَزِيمَةِ ، والإِذلالُ قَد لَحِقَا",195,"ق",2,0],["إذ قد هممت بأمر بان لي رشدا","وقد تبين لي من جنبكم عتب",196,"ب",1,0],["إِذْ قَالَ رَبُّكَ لِلمَلائِكَةِ اسجُدُوا","تَكريمَ عِلْمٍ لَيسَ فيهِ مِرَاءُ",197,"ا",2,0],["إذ قد يصير بسقيها متعاهداً","والعبد في الغفلات عن ذي الحال",198,"ل",1,0],["إذ قال تظهر ديننا جهلاً ولم","يدر الفتى المسكين ما الإظهار",199,"ر",1,0],["إذْ قد تبسم قلبي في محبته","سبحانك الله يانوراً بآفاقي",200,"ق",2,0],["إذْ قد تخطى كلّ جارحة","أضحى نزيفا بالغ الفيضِ",201,"ض",1,0],["أذقْتُها شَهْدَ ثَغْري ، واستكنْتُ لها","كنتُ الحبيبَ يداوي الرأسَ والعَصَبا",202,"ب",2,0],["أَذَقْتِنِي مِنْ هَواكِ العَذْبِ يا أَمَلِي","ما لَمْ يَذُقْ فِي الهَوَى قَيْسٌ وَغَيْلانُ",203,"ن",1,0],["أَذِقني في هَواكَ الشَّيبَ إِنّي","عَشَقتُ الشَّيبَ في زَمَنِ الشَّبابِ",204,"ب",1,1],["اذ قتلنا فساح عرْق نفوسٍ","قد سقاها الغرام ريب المنونِ",205,"ن",1,0],["إذ قمت بالأمر الجسام ولم يكن","فيمن أهبت بهم مجيب سؤال",206,"ل",1,0],["30. إذ قلت حقاً يا محمد فاستمع","قد قيل في القرآن ما زاغ البصر",207,"ر",1,0],["إذ قالَ لي لن تستطيعَ معي","صبراً فقلتُ : وهل ترى نَصَبَا ؟",208,"ب",2,0],["إذ قاوموا الدنيا وما معهم","للحرب غير حجارة عجلى",209,"ل",2,0],["إذ قد نفى عن ذاته جزما بلا","سدَّت عن المرئيِّ لا ذا البابا",210,"ب",2,0],["إذ قال ذو العرش باريهم ألست لكم","ربا فقالوا بلى طوعا بإقرار",211,"ر",1,0],["إذ قلتَ بأنّا أصبحنا","شخصاً أحَداً ذبتُ لديكْ",212,"ك",1,0],["إذْ قلتَ حديثاً فتَّاناً","لم تمزجْ فيهِ أيَّ ريا",213,"ي",2,0],["إِذْ قَالَ إِبْرَاْهِيْمُ مَاذَا تُعبدُونَ -","وما تَرِكْتُم وِجْهَةَ الْأَجْدَاْدِ",214,"د",1,0],["إِذ قَالَ مَاْ لِيْ لَاْ أَرَىْ لِيْ هُدْهُدَاً","أَمْ يَاْ تَرَىْ قَدْ غَاْبَ دُوْنَ مَفَاْدِ",214,"د",1,0],["إِذْ قُلتِ: أَنْتَ مُعَلِّمِيْ غَزَلًا","وأَقُولُ : أَنْتِ كَذَا مُعَلِّمَتِي",215,"ت",2,0],["إذ قلتِ:\" لا لا يا ابنَ عمي!لا تخفْ","فلأنتَ مأوىً للفضائل أجمعينْ",216,"ن",1,0]]}