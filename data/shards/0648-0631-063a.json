{"poems":[[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[27,"عرفت منازلاً بلوى الثماني","https://www.aldiwan.net/poem4450.html","الوافر"],[91,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[70,"تعلمت خط الرمل لما هجرتم","https://www.aldiwan.net/poem42737.html","الطويل"],[61,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[61,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[61,"أتظن أن الدهر يسعف طالبا","https://www.aldiwan.net/poem51807.html","الكامل"],[49,"رزأتك يا هذا فهنت عليكا","https://www.aldiwan.net/poem62208.html","الطويل"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[46,"ما أقبح المين قلتم لم يشب أحد","https://www.aldiwan.net/poem23380.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54689","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"النشيد الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=178973",""]],"verses":[["وَرَغَمتُ أَنفَ الحاسِدينَ بِسَطوَتي","فَغَدَوا لَها مِن راكِعينَ وَسُجَّدِ",0,"د",1,0],["وَرَغَّمنا الفَرَزدَقَ وَهوَ كابٍ","بِسامٍ مُحرِزٍ قَصَبَ الرِهانِ",1,"ن",1,0],["وَرَغِبَ المُثري عَنِ الديباجِ","إِلى اللِباسِ الخَشِنِ النِساجِ",2,"ج",1,0],["وَرَغَّبَني فيهِ بَياضٌ وَحُمرَةٌ","عَهَدتُهُما في وَجنَةٍ سَلَبَت عَقلي",3,"ل",2,0],["ورغبت في كأس البرية رغبة","تركتك في كأس المدامة زاهدا",4,"د",2,0],["ورَغبةٌ كلما جاءَت معرِّضةً","بجاهِه أعرضَت عنها رغائبُه",5,"ب",2,0],["ورغائبٌ شيَّدْتَها بمواهبٍ","لو أنهنَّ نطَقْنَ قُمْنَ خواطبا",6,"ب",2,0],["وَرَغَّبتَني حَتّى رَغِبتُ فَصِرتَ بي","إِلى بُغضِ ذُلِّ الراغِبينَ إِلَيكا",7,"ك",2,0],["وَرَغِبتُ عَن أُنسِ الأَوانِسِ تَجتَني","طُرَفَ الهَوى وَبِعَينِهِنَّ قَميرُ",8,"ر",1,0],["وَرَغبَتي في بَنيها غَيرُ كائِنَةٍ","وَكَيفَ يَرغَبُ خِدنُ العَقلِ في اللَمَمِ",9,"م",1,0],["وَرَغْمِ النَّدَامَى مِنْ أَدِيبٍ وَشَاعِرٍ","فِرَاقُ أَخٍ حُلْوِ الشَّمَائِلِ مِسْمَاحِ",10,"ح",1,0],["وَرَغِبْتَ عَنْهَا يَا فَطِيمُ","كَرَاهَةَ الثَّدْيِ المَرِيرْ",11,"ر",1,0],["ورغم القلوبِ التي تستفيضُ","عُطفاً تَحوطُكَ حَوْطَ الحِمى",12,"ا",1,0],["ورغبَني في الحب ان ليس خالياً","من الحب إلا بارد الطبع جامد",13,"د",1,0]]}