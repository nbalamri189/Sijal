e.com/ViewPoem.aspx?id=211698",""],[5558,"سأَصنعُ أَجنحةً وأَطيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=211842",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[5612,"إلى رَبِّ البَرِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179669",""],[5612,"أبي","https://www.poetsgate.com/ViewPoem.aspx?id=197097",""],[5616,"تغريبة \"محمود\"","https://www.poetsgate.com/ViewPoem.aspx?id=203240",""],[5644,"ككل المآسي ..ستمضي","https://www.poetsgate.com/ViewPoem.aspx?id=201847",""],[5688,"سيجمعني بك الرحمان يوما","https://www.poetsgate.com/ViewPoem.aspx?id=200761",""],[5688,"سنترككم هنالك تصدؤون","https://www.poetsgate.com/ViewPoem.aspx?id=200821",""],[5688,"إذا شئت الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=200846",""],[5751,"هوانا الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=215016",""],[5842,"ثورة .. قيامة البحرين ../ حسان علي الزاوي","https://www.poetsgate.com/ViewPoem.aspx?id=82895",""],[5861,"عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=188049",""],[5943,"كليني ياهموم فلن أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=34857",""],[5948,"وآنستني حتى أنسيتُ بقُربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=100579",""],[5956,"النساء ضحايا أحوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=181848",""],[5956,"مملكتي زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=182186",""],[5956,"يا نجم","https://www.poetsgate.com/ViewPoem.aspx?id=183342",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5956,"مُكافأة من الله","https://www.poetsgate.com/ViewPoem.aspx?id=194053",""],[5956,"لبتر أسباب الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=194895",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[6068,"يطيب لمبسمي ذكراك طيفا -04-","https://www.poetsgate.com/ViewPoem.aspx?id=175880",""],[6068,"يودّ القلب لقياكم فلمّا -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175887",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[6152,"بكِ أزهرت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=203310",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6072,"دَوّامات الندى والغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85443&r=&rc=30",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["وَرَغَمتُ أَنفَ الحاسِدينَ بِسَطوَتي","فَغَدَوا لَها مِن راكِعينَ وَسُجَّدِ",0,"د",1,0],["وَرَغَّمنا الفَرَزدَقَ وَهوَ كابٍ","بِسامٍ مُحرِزٍ قَصَبَ الرِهانِ",1,"ن",1,0],["وَرَغِبَ المُثري عَنِ الديباجِ","إِلى اللِباسِ الخَشِنِ النِساجِ",2,"ج",1,0],["وَرَغَّبَني فيهِ بَياضٌ وَحُمرَةٌ","عَهَدتُهُما في وَجنَةٍ سَلَبَت عَقلي",3,"ل",2,0],["ورغبت في كأس البرية رغبة","تركتك في كأس المدامة زاهدا",4,"د",2,0],["ورَغبةٌ كلما جاءَت معرِّضةً","بجاهِه أعرضَت عنها رغائبُه",5,"ب",2,0],["ورغائبٌ شيَّدْتَها بمواهبٍ","لو أنهنَّ نطَقْنَ قُمْنَ خواطبا",6,"ب",2,0],["وَرَغَّبتَني حَتّى رَغِبتُ فَصِرتَ بي","إِلى بُغضِ ذُلِّ الراغِبينَ إِلَيكا",7,"ك",2,0],["وَرَغِبتُ عَن أُنسِ الأَوانِسِ تَجتَني","طُرَفَ الهَوى وَبِعَينِهِنَّ قَميرُ",8,"ر",1,0],["وَرَغبَتي في بَنيها غَيرُ كائِنَةٍ","وَكَيفَ يَرغَبُ خِدنُ العَقلِ في اللَمَمِ",9,"م",1,0],["وَرَغْمِ النَّدَامَى مِنْ أَدِيبٍ وَشَاعِرٍ","فِرَاقُ أَخٍ حُلْوِ الشَّمَائِلِ مِسْمَاحِ",10,"ح",1,0],["وَرَغِبْتَ عَنْهَا يَا فَطِيمُ","كَرَاهَةَ الثَّدْيِ المَرِيرْ",11,"ر",1,0],["ورغم صرير السّكاكين فيه","يغنّي. يغنّي وينسى النصيحه",12,"ح",2,0],["ورغم القلوبِ التي تستفيضُ","عُطفاً تَحوطُكَ حَوْطَ الحِمى",13,"ا",1,0],["ورغبَني في الحب ان ليس خالياً","من الحب إلا بارد الطبع جامد",14,"د",1,0],["وَرَغِبتُم في المَكرُماتِ فَجُدتُم","وَأَرى الناسَ غَيرَكُم زُهّادا",15,"د",2,0],["ورغاما ينضر السرح به","حينما تمتصه منه الجذور",16,"ر",1,0],["وَرَغِبَت غَلواءُ أَن تَزورا","أُمَّ الجُدودِ الأَقدَمينَ صورا",17,"ر",2,0],["وَرغمَ هذا عِندَ مَرأى الهَوى","يُقدم كَالنِمرِ وَلا يُحجمُ",18,"م",1,0],["وَرَغِبتَ في وَصلي فَحي","نَ رَغِبتُ فيكَ مَلِلتَني",19,"ن",2,0],["وَرغبةً في مُوالاةٍ مؤكّدةٍ","بَيني وَبينَ حميمٍ من صميمكمُ",20,"م",1,0],["وَرَغبَتي في سَترِ ما","عَنهُ لَهُ اللَهُ سَتَر",21,"ر",1,0],["ورغَتْ فيه بالرعودِ عِشارٌ","نحرَتْها خناجِرُ الإيماضِ",22,"ض",1,0],["ورغبتم في علا أنسابها","وكرامٍ من ذويها صُلَحا",23,"ح",2,0],["ورغبة فيكم قادتني بغير زمام","أدري لها عند مثلك حرمةً وزمام",24,"م",1,0],["ورغبت عن عرف وعرف أوجبا","أن أهجر المقصود والمقصودا",25,"د",2,0],["وَرَغِبْتُ فِي لُبْسِ الحِدَادِ لِأَنَّهُ","لُبْسُ الحَزِيْنَةِ وَالحَزِيْنِ الهَائِمِ",26,"م",1,0],["وَرغبت عَني في الهَوى","لِلّائمين العُذَّل",27,"ل",1,0],["ورغبتي منكَ أن لا","تخُصَّ بالردّ قصدِي",28,"د",2,0],["ورغم ظلمك لي يا تاج مملكتي","فأنت عند الهوى للعدل ميزان",29,"ن",1,0],["وَرَغِيفُ النَّدِّ الَّذي عَصَبُوني","هِ وأَكْرِمْ بِذَاكَ مِنْ مَجْنُوز",30,"ز",1,0],["ورغِّب الناسَ طُرّاً في سماحته","وحذِّر الخِصْم منه أي تحذير",31,"ر",1,0],["ورغبتم في الملك حين","رضعتم منهم ضروعه",32,"ع",2,0],["ورغبة جاشت بها أضلعي","تطبق عينها إذا أطبق",33,"ق",1,0],["ورغمِ رجالٍ علَّمَتْهُمْ ذنوبُهُمْ","حِذَارَ الأعادي واحتقارَ المصائب",34,"ب",1,0],["ورغبتُ في ذكرى بحضرة مجدهِ","اذكرتهُ بمحاضرات الراغبِ",35,"ب",1,0],["ورغلَ المطلى به لواهِجا","مثل الشيوخ أحرمت حواجِجَا",36,"ج",2,0],["ورغبة تخجل العليا متوّجة","إليك عن صاحب بالغيب مأمونِ",37,"ن",1,0],["وَرَغمَ شُيوخٍ أَضرَبوا لِقَضِيَّةٍ","أَرَثَّ دَليلاً مِن قَضِيَّةِ شَيطانِ",38,"ن",1,0],["ورغبة في الله قد أنكرت","لذة دنياها لعرفانها",39,"ن",3,0],["ورُغماً على غَمضِ الفُنونِ بِدارنا","تُفَتِّحُها للِنَّاسِ أعينُه الزُّرقُ",40,"ق",1,0],["ورغم العفاءِ أراك رياضاً","تسير بها النسم الضُوَّع",41,"ع",1,0],["وَرَغابِهِم سَقبُ السَماءِ وَخُنِّقَت","مُهَجُ النُفوسِ بِكارِبٍ مُتَزَلِّفِ",42,"ف",1,0],["ورغم مستنبط الاسباب مبتدع","منها ومخترع الآلات والرجم",43,"م",1,0],["ورغبت في زى الأجانب معجبا","بحلاه واستقبحت زى أباكا",44,"ك",2,0],["وَرَغْدٌ عَيشُها الراضي","فلا كَبَدٌ ولا نَكَدُ",45,"د",1,0],["ورغبةٌ تُغْمَدُ في رَهْبَةٍ","تُذيبُ قلبَ الحَجَرِ الجامِدِ",46,"د",1,0],["ورغبتُ عن حُجج المعا","ذِرِ اِنَّ أَكثرها مفاخرْ",47,"ر",1,0],["ورَغبَةٌ فِى الخيرِ خَيرٌ وَعَمَل","بِرٍّ يَزِينُ وَليُقَس مَا لَم يُقَل",48,"ل",1,0],["وَرَغدٍ مِنَ العَيشِ ما إِن يقا","سَ بِأَطيَب مِنهُ وَلا أَرغَدِ",49,"د",1,0],["وَرغِبتُ في إِنعامِها فرَغِبتُ عن","نِعمٍ لما أَولَت من النَعماءِ",50,"ا",2,0],["ورغّبَه فينا عديُ بن حاتم","بأمرٍ جميل صدَّق القولَ والفعلا",51,"ل",2,0],["ورغم القضاء بجثته","خلت وبها للبراح جرت",52,"ت",1,0],["ورغبتم ومن ذكرتم حضوري","في حماكم وان اكون المسارع",53,"ع",1,0],["ورغم المآسي ما تزحزح صبرهُ","ولا سالمت كفّاه من لا يسالمُه",54,"م",2,0],["ورغم هذا كل ما رجله تسير","تنهض أذناب الرجال وتتبعه",55,"ع",2,0],["ورغائبٌ عُرِفتْ مقاصدُها","لم يستطعْ في نيلها صبرا",56,"ر",2,0],["ورغم هذا أبرّهُ ويرى","الفؤادُ في مقلتيهِ جنتَهُ",57,"ت",2,0],["ورغم أنوفهم ستظل صنعا","ليوم الحشر شامخة الجبال",58,"ل",1,1],["ورغم أنوفهم ستعيش عمرا","تمرغ كل أنف في الرمالِ",58,"ل",1,0],["ورغْم مسيرةٍ أدمتْ خطاه","سيرجعُ .. حيثُ تنكره حدودُهْ",59,"د",2,0],["ورُغمَ ما يَحويهِ مِن أَوجُهٍ","ما زالَ يَأتِينا بِوَجهٍ عَديمْ",60,"م",1,0],["ورُغمَ ما يَلقَاهُ مِن خَوفِهِ","يَرَى بِأَنَّ الأَمنَ أَن لا يَرَى!",61,"ر",2,0],["ورُغمَ الذي ذُقنا، ورُغمَ الذي غَدًا","سَنَلقَى.. سَيَرمِينا إِلى الحُوتِ (يُونسُ)",62,"س",1,0],["ورغم كل موجة قد طغت","غطست في أعماقها غطسا",63,"س",2,0],["ورغم الجفاف الذي لم يزل","فأشجارها لم تزل وارقة",64,"ق",2,0],["وَرَغِيفُ النَّدِّ الَّذي غَصَبُوني","هِ وأَكْرِمْ بِذَاكَ مِنْ مَجْنُوز",65,"ز",1,0],["ورغبت عن نشر السوالف روحت","نار الخدود وقد بدت تتوهج",66,"ج",1,0],["ورغم ذاكَ الذي -غصبًا- نعيشُ بهِ","نحتارُ .. أيُّ ظباءِ البيدِ ... نأسرُها",67,"ر",3,0],["ورغم كلّ صحاري الروحِ قاطبةً","نستمطرُ الصبرَ؛ لو يهمي يكوثرُها",67,"ر",3,0],["ورغم كلّ جراحٍ .. نشتهي وَلَهًا","كأنَّ ذي سُنَّةٌ .. نحيا نوقرُها",67,"ر",3,0],["ورغيف كَأَنَّهُ الترس يحْكى","حمرَة الشَّمْس بِالْغُدُوِّ أحمراره",68,"ر",2,1],["ورغم كل ماشكى حبري انا حالي :عال ال عال","لآني لاذكرت الله يضيع بهالفضاء لومي",69,"م",2,0],["وَرُغْمَ هَذَاْ وَهَذَاْº فَالْغَرَاْمُ فَتىً","يَصُوْغُ لِلْغِيْدِ أَقْرَاْطاًº وَتِيْجَاْنَاْ",70,"ن",2,0],["ورُغْمَ أُمورٍ لاْ مَجَالَ لِذِكْرِهَاْ","تصَوُغْ ُمِنَ الأَوْهَاِم أَبْرَاْجَ عَسْجَدِ",71,"د",1,0],["ورغمَ عنائهم كانوا إذا ما","أتاهم أبدَوا البِشر المبينا",72,"ن",2,0],["ورغم القيود.. ورغم العذاب","سيبقى نشيدي على كل باب..",73,"ب",1,0],["ورغم البؤس يملأ كل ركنٍ","فللجبّار أمرٌ واقتدارُ",74,"ر",1,0],["ورغم الدّجى والحالكات اختلت بها","أصرّت عيون الحزن حتّى تراها",75,"ا",3,0],["ورغم الحزن وجروح تحشم عن التقصير","والله وبس رضاچ أقصى طموحاتي",76,"ت",2,0],["ورغم الأماني نراها بمهد","كطفل رضيع بقلب المحب",77,"ب",1,0],["ورغم ذالك يجتثّ العداة بيو","م قمطرير شديد البأس محتدم",78,"م",1,0],["ورغم زود الغيث محروم الشروب","من نبع نهري ومشروبي حرام",79,"م",1,0],["ورغم َ تكالب ِ الآلام ِ حولى","سأنساها فعندي كبرياء ُ",80,"ا",2,0],["وَرَغْمَ شَيْبي لَازِلْتُ أَرْقَبُهَا","مُذْ كَانَ طِفْلِي يَضُمُّهُ الرَّحِمُ",81,"م",1,0],["وَرُغْمَ انْحِشَارِي فِي بَيَانِي وَكَلْكَلِي","أُرَدِّدُ قَوْلاً كَيْ تَطُوفَ العَلائِقُ",82,"ق",1,0],["ورغبتي فيه بياض وحمرة","عددتها في وجنة سلبت عقلي",83,"ل",2,0],["ورغمَ ذا علقتْ بالصبرِ ما غرقتْ","تقولُ: إنّك حتمًا سوفَ تُنجيها!",84,"ي",3,0],["ورغبت عما كنت تر","غب فيه من لطف الإخاء",85,"ا",2,0],["ورغم هذا لوقسى وقتي عليّه","نفسي المولى على العزة فطرها",86,"ر",3,0],["ورغم اليال وماحملنه من اسرار","ورغم العناء فى غربتى والكلافه",87,"ف",2,0],["وَرُغمَ الغرورِ الذي يعتري","نيأَقولُ بِإنّيَ رهنٌ لأمركْ",88,"ك",1,0],["ورغْمَ مَوْتِكَ كُلُّ الظّالمينَ لَنَا","يَغْتالُهم فَزَعٌ إنْ قيلَ: ها عُمَرُ",89,"ر",1,0],["ورغبة العشق من يسطيع يمنعها","إن ضمنا في هزيع الليل معترك",90,"ك",1,0],["ورغم الهمس والتجريحِ إني","سأبقى عاشقاً حتى أُجنَّا",91,"ن",2,0],["ورغم حزام أمنٍ لا يبارى","إليّ بكل أخباري وشيتُ",92,"ت",1,0],["ورغم كتابتي ضاقت حروفي","وقام أمامها سدٌ وسدُ",93,"د",1,0],["ورغم الظلم من أقوام جهلٍ","أذاعوا الرعب للناس استباحوا",94,"ح",3,0],["ورغم حثالة جاؤوا ليسبوا","أميرتنا وكلهم انبطاحُ",94,"ح",1,0],["ورغم الغدر أزهر في حبيب","يضم إلى ذراعيه دمشقا",95,"ق",2,0],["ورغبتُ لو يبقى بكوّته","للبرزخ المعسولِ يخطفه",96,"ف",2,0],["ورغم احتباس الضوء في بهواتها","تخاطرت الأذهان وحيا م