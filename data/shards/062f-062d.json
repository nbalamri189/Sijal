{"poems":[[79,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[79,"ماذا أحدث عن بحر سبحت به","https://www.aldiwan.net/poem36663.html","البسيط"],[73,"دحية لم يعقب فكم تنتمي","https://www.aldiwan.net/poem3762.html","السريع"],[53,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[58,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[47,"هل أنت مستمع لمن ناداكا","https://www.aldiwan.net/poem65217.html","الكامل"],[30,"إن بلالاً إن تلاقيه سالماً","https://www.aldiwan.net/poem1279.html",""],[21,"دحوت البلاد فسويتها","https://www.aldiwan.net/poem36212.html","المتقارب"],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[47,"هَلْ أنْتَ مُستَمِعٌ لِمَنْ نَاداكَا","https://www.poetsgate.com/ViewPoem.aspx?id=32145",""],[128,"صرعته بعد تطاحن وعراك","https://www.aldiwan.net/poem23737.html","الكامل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[382,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[409,"الواردات علينا كلها منن","https://www.aldiwan.net/poem33403.html","البسيط"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[578,"تلهي العيون رقومه فكأنها","https://www.aldiwan.net/poem3655.html","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108720","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198863","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71074","البسيط"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10499","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126207","الخفيف"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84518","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202342","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114202","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135785","الرجز"],[3986,"","https://poetry.dctabudhabi.ae/diwan/poem/20928","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4677,"دحنونة","https://www.poetsgate.com/ViewPoem.aspx?id=203953",""],[4859,"سبتمبر التحرير!","https://www.poetsgate.com/ViewPoem.aspx?id=206932",""],[4898,"يوم عاصف .","https://www.poetsgate.com/ViewPoem.aspx?id=35812",""],[4929,"القدس والخونة","https://www.poetsgate.com/ViewPoem.aspx?id=199525",""],[585,"دحر البدر حملة الظلماء","https://www.poetsgate.com/ViewPoem.aspx?id=161860",""],[5096,"مرثية القائد صالح 2 .","https://www.poetsgate.com/ViewPoem.aspx?id=211323",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5183,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=185639",""],[5186,"رفعت إلى أوج العلى راية الهند","https://www.poetsgate.com/ViewPoem.aspx?id=156480",""],[5956,"لمن تثور العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=181909",""],[1352,"الحمد لله الوهوب المجزل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=499950",""]],"verses":[["دَحَيْتَ من الزُّلِّيجِ صفْحَةَ أرْضِهِ","بلَوْنَيْنِ مُبْيَضِّ الأديمِ ومُسْوَدِّ",0,"د",1,0],["دَحاهُ مُبْتَدِعُ الأشْياءِ مُسْتَوياً","ما إنْ بهِ دَركٌ كلاّ ولا دَرَجُ",1,"ج",1,0],["دِحيَةُ لَم يُعقَب فَكَم تَنتَمي","إِلَيهِ بِالبُهتانِ وَالإِفكِ",2,"ك",1,1],["دحداحة الخلقة حدباؤها","قامتها قامة فُقّاعه",3,"ع",2,0],["دحضتْ حُجَّةُ المنيبِ إلى الشيْ","ب وأنَّى لطالبٍ بقوام",4,"م",1,0],["دَحَا أربعينَ ذِراعاً بها","هِزَبْرٌ لَهُ دانَتِ الأَشْبُلُ",5,"ل",1,0],["دَحَضَت بِهِ قَدَماهُ في أُهوَبَّةٍ","زَبَتَت عَلَيها بِالهُدى قَدَماكا",6,"ك",2,0],["دَحولٌ مِنَ اللاتي إِذا ما اِرتَمَت بِهِ","يَرى أَنَّهُ مِن قَعرِها غَيرُ آيِبِ",7,"ب",1,0],["دَحَوتَ البِلادَ فَسَوَّيتَها","وَأَنتَ عَلى طَيِّها قادِرُ",8,"ر",1,1],["دَحَا أرضَها ، وانصَبَّ كالموتِ فوقَها","ولُحْتَ له مَوتاً على الموتِ مُنصَباً",9,"ب",2,0],["دَحَضَتْ بهِ قَدَماهُ عَنْ أُهْوِيّةٍ،","ثَبَتَتْ عَلَيْهَا بالهُدَى قَدَمَاكَا",10,"ك",2,0],["دحنون وادي السير من جناته","لا تنكري أَتضرجا خداك",11,"ك",1,0],["دَحِيَّةٌ وَاللَيلُ مِن عَنعَنِها","عَن آدَمٍ إِلى الإِمامِ المُنتَظَر",12,"ر",1,0],["دحا الأرضَ لما شاء جلَّ اقتدارُه","على الماء والأمواه تجري بلا وقف",13,"ف",1,0],["دحى البسيطة فرشاً للأنام وقد","علت عليها الجبال الشم والقنن",14,"ن",1,0],["دَحَضوا الغيَّ بالرَّشاد فما","زالوا إلى الله يرشدون الأَناما",15,"ا",1,0],["دُحِيَت بِسيطَةُ أَرضِهِ مِن مَرمَرٍ","فَجَرى الزَجاجُ بِهِ وَثارَ عَجاجا",16,"ج",2,0],["دَحمَةَ قَبلَ الطَلقِ والإِرزامِ","فَطَرَّقَتْ بِسَبْعَةٍ تُؤَامِ",17,"م",1,0],["دحرت شياطين الغرام بأسرها","وصدُّك هذا ما استطعت لهُ دحرا",18,"ر",2,0],["دحا أستار الجلال لأجله","ودارت كؤوس بالوصال تردد",19,"د",1,0],["دحاكرة البيدا مالفة دَحْىَ","الصَّوالجِ ملموماً من الأَكرِ",20,"ر",1,0],["دَحِضَ السَراةِ إِذا عَلَوتَ سَراتَهُ","صافي الأَديمَ صَبيحَةَ الإِعمالِ",21,"ل",1,0],["دَحضَةُ هذه المسالِكِ فإحذر","لا تُمَثِّى إلاّ بجُهدٍ جَهيدِ",22,"د",1,0],["دحرت عَفاريت الطغاة فَلَم تَزَل","لأهل الخنا طول الزَمان تباعد",23,"د",1,0],["دحض المدلّ بنورها","حجج الخصوم وَأَفحما",24,"م",2,0],["دحا بباب لتلك الحصن قد عجزت","عن حملها كف آلاف من الغلب",25,"ب",1,0],["دحت لك مثل الأرض أرضاً حشودها","ومدت سماء كالسماء القساطل",26,"ل",1,0],["دَحَا الأرضَ مِن تَحتِ مَكَّةَ إِذ","حَوَت دُرَّةً فَاقَتِ الدُّرَرَا",27,"ر",2,0],["دحلعْ رخشْ بَوَينْ ضَتَظْ وسرها","أعداءنا فشتتن شملها",28,"ه",2,0],["دحاها فلما رآها استوت","على الماء أرسى عليها الجبالا",29,"ل",2,0],["دحوا من مثار النقع أرضا فلو بغوا","لساقوا عليها الصافنات المذاكيا",30,"ي",2,0],["دحنونة تهوى الربيع إذا أتى","كي يرتديها العاشقون سوارا",31,"ر",2,0],["دحر الذين تفننوا في قهرنا","وتربعوا دهراً على عرش العفن",32,"ن",1,0],["دَحَر المشاةَ زحامُها","لم يُظهروا بعضَ الجَلَدْ",33,"د",1,0],["دحرت عن الأقصى غرور عدو","فارتدَّ يحدو كبره استصغارُ",34,"ر",1,0],["دحر البدر حملة الظلماء","واستوى في مباءة العلياء",35,"ا",2,1],["دحْض العدا رهبةٌ تغزو مواقعهم","كرهْبةٍ زَعْزعتْ شكًّا بهم شَجبا",36,"ب",2,0],["دحضت أقوام زلازل فتنة","حزماً قلبت بطونها لظهور",37,"ر",1,0],["دحر الغاصب في الشرق فتأ","ريخه , ( حل عليه غضبا )",38,"ب",2,0],["دحرت جيوش الظلم دحرا منظما","بمغزلك الفتال لا الصارم الهندي",39,"د",2,0],["دحَرَتْ أمانينا العواصفُ عاطفةْ","أمواجَها فبكت بقلبي العاطفةْ",40,"ف",2,0],["دَحلِ أَبي المِرقالِ خَيرِ الأَدحُلِ","مِن نَحتِ عادٍ في الزَمانِ الأَوَّلِ",41,"ل",1,0]]}