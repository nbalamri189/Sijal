{"poems":[[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[77,"ماذا أحدث عن بحر سبحت به","https://www.aldiwan.net/poem36663.html","البسيط"],[71,"دحية لم يعقب فكم تنتمي","https://www.aldiwan.net/poem3762.html","السريع"],[51,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[56,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[45,"هل أنت مستمع لمن ناداكا","https://www.aldiwan.net/poem65217.html","الكامل"],[28,"إن بلالاً إن تلاقيه سالماً","https://www.aldiwan.net/poem1279.html",""],[21,"دحوت البلاد فسويتها","https://www.aldiwan.net/poem36212.html","المتقارب"],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[45,"هَلْ أنْتَ مُستَمِعٌ لِمَنْ نَاداكَا","https://www.poetsgate.com/ViewPoem.aspx?id=32145",""]],"verses":[["دَحَيْتَ من الزُّلِّيجِ صفْحَةَ أرْضِهِ","بلَوْنَيْنِ مُبْيَضِّ الأديمِ ومُسْوَدِّ",0,"د",1,0],["دَحاهُ مُبْتَدِعُ الأشْياءِ مُسْتَوياً","ما إنْ بهِ دَركٌ كلاّ ولا دَرَجُ",1,"ج",1,0],["دِحيَةُ لَم يُعقَب فَكَم تَنتَمي","إِلَيهِ بِالبُهتانِ وَالإِفكِ",2,"ك",1,1],["دحداحة الخلقة حدباؤها","قامتها قامة فُقّاعه",3,"ع",2,0],["دحضتْ حُجَّةُ المنيبِ إلى الشيْ","ب وأنَّى لطالبٍ بقوام",4,"م",1,0],["دَحَا أربعينَ ذِراعاً بها","هِزَبْرٌ لَهُ دانَتِ الأَشْبُلُ",5,"ل",1,0],["دَحَضَت بِهِ قَدَماهُ في أُهوَبَّةٍ","زَبَتَت عَلَيها بِالهُدى قَدَماكا",6,"ك",2,0],["دَحولٌ مِنَ اللاتي إِذا ما اِرتَمَت بِهِ","يَرى أَنَّهُ مِن قَعرِها غَيرُ آيِبِ",7,"ب",1,0],["دَحَوتَ البِلادَ فَسَوَّيتَها","وَأَنتَ عَلى طَيِّها قادِرُ",8,"ر",1,1],["دَحَا أرضَها ، وانصَبَّ كالموتِ فوقَها","ولُحْتَ له مَوتاً على الموتِ مُنصَباً",9,"ب",2,0],["دَحَضَتْ بهِ قَدَماهُ عَنْ أُهْوِيّةٍ،","ثَبَتَتْ عَلَيْهَا بالهُدَى قَدَمَاكَا",10,"ك",2,0]]}