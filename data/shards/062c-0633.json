4863.html","الطويل"],[438,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[444,"قتيل ما قتيل المرء عمرو","https://www.aldiwan.net/poem23927.html","الوافر"],[456,"لله قلبا قريني صبوة قطعا","https://www.aldiwan.net/poem55842.html","البسيط"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[456,"ما نازل بمن علا","https://www.aldiwan.net/poem56140.html","مجزوء الرجز"],[462,"خصرك هذا المخطف","https://www.aldiwan.net/poem3240.html","عموديه"],[462,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[466,"وقهوة كخلوق","https://www.aldiwan.net/poem59992.html","المجتث"],[466,"جسد ناحل وصبر ضعيف","https://www.aldiwan.net/poem60251.html","الخفيف"],[466,"جسم زجاج وروح راح","https://www.aldiwan.net/poem60282.html","مخلع البسيط"],[475,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[480,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[498,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[512,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[527,"جسم أقام بإب","https://www.aldiwan.net/poem37335.html","المجتث"],[536,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[549,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[549,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[556,"جل وجه بنوره الوهاج","https://www.aldiwan.net/poem33555.html","الخفيف"],[556,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[556,"شخصت لطلعة وجهك الأشخاص","https://www.aldiwan.net/poem34426.html","الكامل"],[556,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[556,"رح يا أنا يا فاسد التركيب","https://www.aldiwan.net/poem34954.html","الكامل"],[557,"أنظر للفظ أنا يا مغرما فيه","https://www.aldiwan.net/poem69335.html","البسيط"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[565,"ولما عبثن بأوتارهن","https://www.aldiwan.net/poem69490.html","البسيط"],[565,"وكثيرة النغمات تحسبها","https://www.aldiwan.net/poem69583.html","الكامل"],[565,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[565,"اعذر أخاك فما عليه جناح","https://www.aldiwan.net/poem69757.html","الكامل"],[573,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["جَسَدٌ يُقَلَّبُ لِلضَنى","بِيَدَي طُبَيَّبَةٍ سِواها",0,"ا",3,0],["جِسمٌ تَفَرَّدَ بِالأَكفانِ يَجعَلُها","مُذ طَلَّقَ العُمرَ أَبدالاً مِنَ الحُلَلِ",1,"ل",1,0],["جَسَرتُ عَلى بابِ الهَوى فَدَخَلتُهُ","فَقَد جاءَني مِنهُ الَّذي كُنتُ أَفرَقُ",2,"ق",1,1],["جِسْمي ولَحْظُكَ في السَّقامِ تَشارَكا","واللّهُ يعْلَمُ أيُّنا المَفْؤودُ",3,"د",1,0],["جِسمُهُ في الصَفاءِ وَالرِقَّةِ الماءُ","فَلا غَروَ أَن حَبابٌ عَلاهُ",4,"ه",1,0],["جِسمُ السُرورِ سَوِيٌّ","مِن صَوغِ نُعماكَ عِندي",5,"ي",1,0],["جَسَّتْ أَسَاسَهُمَا تُعَالِجُ نَقْضَه","فَعَصَى فَمَرَّتْ بِاصْطِحَابِ جُنُونِ",6,"ن",1,0],["جُسُّوا مِظَنَّةَ حِسِّهِ أَفَنَابِضٌ","فِيهَا فُؤَادُ مُتَيَّمٍ وَلْهَانِ",7,"ن",1,0],["جِسْمَانِ يَغْتَدِيَانِ جِسْماً وَاحِداً","كَتَوحُّدِ الحَبَبَيْنِ يَقْتَرِنَانِ",8,"ن",1,0],["جَسَّ القلوب بجَسّه أوتارَهُ","حتى كأن قلوبنا بَيْن الوتَرْ",9,"ر",1,0],["جسمٌ سقيمٌ لا يرام شفاؤه","سلبت سويدا مهجتي سوداؤه",10,"ا",3,1],["جسمان مرئيان جسماً واحدًا","كالنظم شدَّدَ حرَفهُ علماؤه",10,"ا",3,0],["جسمي إلى جدثِي مهوايَ من كثب","فكيف يعجبني مهوايَ من صعدِ",11,"د",1,0],["جسمي أبو ذرّ الضنا فذروني","أروي لأحبابي حديثَ شجوني",12,"ي",1,1],["جسمي وذاكَ الخصر والجفن الدنف","هنَّ حروف الاعتدال المكتنف",13,"ف",1,0],["جسورٌ على الأهوال يحسر للقنا","ويدّرعُ المعروف دون القوارص",14,"ص",1,0],["جَسَسْتُ بفيشلتي قلبَها","وزلزلْتُ بالرَّهْزِ أركانها",15,"ن",3,0],["جِسمٌ كَخَصرِكِ في النُحو","ل وَمِثلُ جَفنِكِ في الفُتورِ",16,"ر",1,0],["جسمه يوم سرت بالغرب ثاوٍ","بيد أن الفؤاد خلف ركابك",17,"ك",1,0],["جَسَّ الطّبيبَ يَدي جَهْلاً فقلتُ لهُ","إِنَّ المَحَبّةَ في قَلْبي فَخَلِّ يَدي",18,"ي",1,0],["جسَرتُ على دهياء مصرَ ففُتُّها","ولم يَكُنِ الدهياءَ إلا من استجرا",19,"ر",2,0],["جسد راسب وروح لطيف","خلق النفس منهما بين بينا",20,"ن",2,0],["جسمي طليقٌ غيرَ أنَّ عزِيمتي","مغلولةٌ قَهراً وقلبي عاني",21,"ن",2,0],["جِسمِيَ لا جِسمُكَ النَحيلُ","وَيا عَليلاً أَنا العَليلُ",22,"ل",1,1],["جَسيمُ مَحَلِّ البَيتِ ضَمَّنَكَ القِرى","أَبوكَ وَأَحداثُ الأُمورَ الجَوامِعِ",23,"ع",1,0],["جِسمي مَعي غَيرَ أَن الروحَ عِندَكُمُ","فَالجِسمُ في عزبَةٍ وَالروحُ في وَطَنِ",24,"ن",1,1],["جَسَّت يَدي لِتَرى ما بي فَقُلتُ لَها","كُفّي فَذاكَ جَوىً لَولاكِ لَم يَهجِ",25,"ج",1,0],["جَسَّ نَبضي وَقالَ ما أَنتَ شاكٍ","قُلتُ ناراً لَم يُطفِها التَبريدُ",26,"د",1,0],["جِسمٌ كَصَخرٍ في صَلابَةِ جِرمِهِ","وَجُفونُها في الدَمعِ كَالخَنساءِ",27,"ا",2,0],["جَسَدٌ في الثرى وروحٌ شريدٌ","في الأعالي محلِّقٌ في السماءِ",28,"ا",2,0],["جسمي هو الطّيْفُ الّذي","يُدْنِيهِ منكِ طِلابُ ديني",29,"ي",1,0],["جسمُ لجينٍ ناعمٌ لَمْسُهُ","لصفرةِ العسجدِ فيه اتّهام",30,"م",1,0],["جِسمُها بالبَقاءِ في الدنِّ يَبلى","وقُواها مع اللّيالي تَجَدّد",31,"د",1,0],["جسمي ضعيفٌ عنْ لظى وعذابُها","حاشاكَ تنسى مَنْ إليكَ قدِ التجا",32,"ج",2,0],["جِسمُ المُحِبِّ بِثَوبِ السَقمِ مُشتَمِلُ","وَجَفنُهُ بِدُموعِ الشَوقِ مُكتَحِلُ",33,"ل",1,1],["جِسمي يُقيكَ الَّذي تَشكوهُ مِن أَلَمٍ","وَدَمعُ عَينَيَّ يَفدي دَمعَ عَينَيكا",34,"ك",2,0],["جِسمي يَقولُ بِسُقمِهِ","عِندي مِنَ الحُبُّ الخَبَر",35,"ر",1,0],["جَسَدي قائِمٌ وَروحي مُواتُ","وَسُهادي مَعاً وَنَومي سُباتُ",36,"ت",1,1],["جَسَرَت مُشاغَبَتي وَفِيَّ بَقِيَّةٌ","تُخشى كَما يُتَخَوَّفُ المَأثورُ",37,"ر",1,0],["جِسمِيَ أَنجاسٌ فَما سَرَّني","أَنّي بِمِسكِ القَولِ ضُمِّختُ",38,"ت",1,0],["جَسَدٌ يُعَذَّبُ في الحَياةِ حَسِبتُهُ","مُستَشعِراً حَسَدَ العِظَامِ الهُمَّدِ",39,"د",1,0],["جَسَدٌ تَوى إِن تَفتَرِق أَجزاؤُهُ","لَم تَنأَ عَن فَلَكٍ عَلَيهِ مُدارِ",40,"ر",1,0],["جَسَدٌ مِن أَربَعٍ تَلحَظُها","سَبعَةٌ راتِبَةٌ في اِثنَي عَشَر",41,"ر",1,0],["جُسومٌ ثُمَّ عادَت فَأَصبَحَت","ضُروباً كَزَرعٍ نابِتٍ وَغِراسِ",42,"س",1,0],["جِسمُ الفَتى مِثلُ قامَ فِعلٌ","مُذ كانَ ما فارَقَ اِعتِلالا",43,"ل",2,1],["جِسمِيَ أَودى مَرُ السِنينَ بِهِ","فَلتَطلُبِ النَفسُ مَنزِلاً بَدَلَه",44,"ل",2,1],["جِسمٌ يَذُمُّ النَفسَ وَهيَ تَذُمُّهُ","في مُجمَلٍ مِن أَمرِها وَمُفَصَّلِ",45,"ل",1,0],["جَسَدي خِرقَةٌ تُخاطُ إِلى الأَر","ضِ فَيا خائِطَ العَوالِمِ خِطني",46,"ن",2,0],["جسم الفَتى ما عاشَ مملكة بها","تَجري أُمور للحَياة جسام",47,"م",1,0],["جسارتي قلت","جلادتي خارَت",48,"ت",1,0],["جسر أدق بعرضه من شعرة","واحد من سيف جراز مخذم",49,"م",1,0],["جِسْمٌ بَرَتْهُ يَدُ الضَّنَى حَتَّى غَدَا","قَفَصاً بِهِ لِلْقَلْبِ طَيْرٌ يَصْفِرُ",50,"ر",1,0],["جَسَدٌ عِنْدَ مُنْتَهَى ظُلَمِ الدّهْرِ","وَرُوحٌ في مُزْدَهَي الأَضْوَاءِ",51,"ا",2,0],["جِسْمٌ يُقَوِّضُهُ السَّقَامُ وَهَمُّسهَا","مُتَعَلِّقٌ بِالخَلْقِ وَالإِنْشَاءِ",52,"ا",2,0],["جِسْمٌ كحُقٍّ لِلْحَيَا","ةِ مُعَرَّقٍ ومُضَلَّعِ",53,"ع",1,0],["جِسمُهُ يضعُف مِمّا","يَشتَكي وَالنَفسُ تَقوى",54,"و",2,0],["جسمٌ نحيلٌ، غيرَ أنَّ وراءَهُ","أفُقًا يتيه الظنُّ في أرجائه",55,"ا",3,0],["جَسَدُ الشهيدِ إلى جوارِ اللهِ في","عَدْن، على أيدي الملائك يُحمَل",56,"ل",1,0],["جسمُك الغضُ مَنطقٌ يدحَض","الحجّة لو لم تُسَتِّري بُرهانه",57,"ن",2,0],["جَسورٍ رأي أنّ مَن يَقتحمْ","يُحكَّمْ، ومن يَنكمشْ يُنْهَب",58,"ب",1,0],["جَسَدي يشتاقُ إلى بغدادَ","وقلبي عند نساءِ الشَامْ ...",59,"م",1,0],["جِسمي نَحيلٌ لا يزالُ من الهوى","حتى غَدا من سُقْمِه كَحشَاكِ",60,"ك",1,0],["جسمي معي والروحُ في منجٍ ولي","قلبٌ يعذَّب في غرام بلادِي",61,"د",2,0],["جسمٌ تضيقُ بهمِّهِ","الدُنيا على نعشٍ يُمَدُّ",62,"د",1,0],["جسمي قد استولى عليهِ الضنا","في حب هذا الناعسِ الأعينِ",63,"ن",1,1],["جسمي وعيناه كل مثل صاحبه","يبدى له مثلما يبديه من سقمه",64,"م",2,0],["جِسمُ لُجَينٍ قَميصُهُ ذَهَب","زُرَّ عَلى لُعبَةٍ مِنَ الطيبِ",65,"ب",1,1],["جسّ زندي فقال لي بك داءٌ","من بلى بالذي بليت يذيبُ",66,"ب",1,0],["جَسَدٌ ناحِلٌ وَطَرفٌ قَريح","ظَلَّ يَهمي وَهامَةٌ شَعثاءُ",67,"ا",2,0],["جسمٌ تراهُ فلا تدري أمشتملٌ","بالثوبِ أم درجوهُ منهُ في كفنِ",68,"ن",1,0],["جسمٌ شمائله تضاهي لؤلؤاً","رطباً يقاس إلى قضيب الآسِ",69,"س",1,0],["جسمين قد قُسِما بروحٍ واحدٍ","كُلٌّ بكلٍّ مُسعَدٌ مُتَوافِ",70,"ف",1,0],["جسم تناهت به أشكالُ صنعته","فقد تفاوت فيه وصفُ من وصفا",71,"ف",2,0],["جسم من النور صاف","تغار منه الكميت",72,"ت",1,0],["جسم كجسم الهواء شاك","من رقةٍ بأسها شديدُ",73,"د",1,0],["جسمٌ من النور لو يوما ظهرت به","عريان ما كان للأرواح من واقى",74,"ق",2,0],["جَسَدي اِنضَنى لَم يَبقَ إِلّا نِصفُهُ","وَالنِصفُ مُقتَربٌ إِلَيهِ حَتفُه",75,"ه",1,0],["جسدي ناقصٌ وحبُّك نامِ","مذ غَدَا سُقم مقلتيك سقامي",76,"م",2,1],["جَسَدٌ ناحِلٌ وَقَلبٌ جَريحٌ","وَدُموعٌ عَلى الخدود تسيحُ",77,"ح",1,1],["جَسَدي كَما بَلِيَت طُلولُكِ بَعدَهُم","بالٍ وَصَبري مِثلُ رَبعِكِ عافِ",78,"ف",1,0],["جَسَستِ من الأوتارِ ألطفَها كما","جَسَستِ فؤادي وهو بالحبِّ يقتات",79,"ت",1,0],["جست مثاني عودها بأنامل","عبثت بلب الخاشع المتورع",80,"ع",1,1],["جسمك العبقريّ شكلا وظلّا","الغويّ الغنيّ عن كل حسن",81,"ن",1,0],["جسد داعر وجلد سميك","دونه في السماكة التمساح",82,"ح",1,0],["جسوُمُ لُجينٍ في غلائِلَ عَسْجِدٍ","وأَنمُلُ حُسَّابٍ بِغيرِ مَعَاصِم",83,"م",1,0],["جسمه الباديَ الضنى","مُغْرَقاً أو مُحَرَّقا",84,"ق",2,0],["جسمٌ تغير في التركيب منعكساً","روسٌ أخامصُ والأخماص كالروس",85,"س",1,0],["جُسيمي من لُويلاتي ذُوَيبٌ","كأني في بُوَيتٍ من سُقَيرِ",86,"ر",1,0],["جسم تَجسم مِن ضَناً","مبلٍ وَقَلب مِن أَوام",87,"م",1,0],["جسمي تراه المقيم في دعة","وفكرتي في الرحيل والظعن",88,"ن",1,0],["جست بها الأوتار قائلة","يا دهر هذا منتهى قصدي",89,"ي",1,0],["جسَّ الطبيب فلم يجد","من نبضه ما يستفيده",90,"د",2,0],["جسَّتْ فلم تر ما يدل","به على سوء المزاج",91,"ج",1,0],["جِسمي نَحيل بِالحَبِّ وَالحُبِّ","ذا مِن رَبيبي وَذاكَ مِن رَبّي",92,"ب",2,1],["جَسَدٌ ذاب نحولاً وسَقاما","وفؤادٌ زِيدَ وجداً وغراما",93,"م",2,1],["جَسَدٌ أشْبَهُ شيءٍ بالخيال","وفؤادي عن هَواكُم غيرُ 