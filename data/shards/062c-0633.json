{"poems":[[53,"عاد الهوى بظباء مك","https://www.aldiwan.net/poem29630.html","مجزوء الكامل"],[53,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[55,"جسرت على باب الهوى فدخلته","https://www.aldiwan.net/poem26211.html","الطويل"],[77,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[73,"قال لي اعتل من هويت حسود","https://www.aldiwan.net/poem11868.html","الخفيف"],[73,"يا بانيا كل مجد","https://www.aldiwan.net/poem11982.html","عموديه"],[93,"أمن الفساد طغيت نهر السين","https://www.aldiwan.net/poem11178.html","الكامل"],[93,"أحننت من شوق إلى لبنان","https://www.aldiwan.net/poem11270.html","الكامل"],[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[83,"والعود في كف النديم بسر ما","https://www.aldiwan.net/poem54308.html","الكامل"],[72,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[72,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"تعالت قرون أبي يوسف","https://www.aldiwan.net/poem66420.html","المتقارب"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[85,"يا أبا عاصم","https://www.aldiwan.net/poem7123.html","الخفيف"],[56,"ودعتها ولهيب الشوق في كبدي","https://www.aldiwan.net/poem58601.html","البسيط"],[43,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[45,"جسمي لا جسمك النحيل","https://www.aldiwan.net/poem65584.html","مجزوء البسيط"],[28,"إليك ابن سيار فتى الجود واعست","https://www.aldiwan.net/poem5297.html","الطويل"],[58,"جسمي معي غير أن الروح عندكم","https://www.aldiwan.net/poem30820.html","البسيط"],[66,"جاءت لتنظر ما أبقت من المهج","https://www.aldiwan.net/poem38497.html","الكامل"],[66,"ظن قومي أن الأساة ستبري","https://www.aldiwan.net/poem40115.html","الخفيف"],[66,"أنجوم روض أم نجوم سماء","https://www.aldiwan.net/poem40989.html","الكامل"],[97,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[80,"عذبتني بالعنصرين","https://www.aldiwan.net/poem31270.html","مجزوء الكامل"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"نحن في جنة نباكر منها","https://www.aldiwan.net/poem31497.html","الخفيف"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[52,"جسم المحب بثوب السقم مشتمل","https://www.aldiwan.net/poem26740.html","البسيط"],[52,"لبيك يا من دعاني عند عثرته","https://www.aldiwan.net/poem26778.html","البسيط"],[52,"يا من يسارقني النظر","https://www.aldiwan.net/poem27026.html","مجزوء الكامل"],[48,"جسدي قائم وروحي موات","https://www.aldiwan.net/poem62468.html","السريع"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[46,"بنت عن الدنيا ولا بنت لي","https://www.aldiwan.net/poem22160.html","السريع"],[46,"لا تبدأوني بالعداوة منكم","https://www.aldiwan.net/poem22485.html","الكامل"],[46,"ما حركت قدم ولا بسطت يد","https://www.aldiwan.net/poem22709.html","الكامل"],[46,"إدفع الشر إذا جاء بشر","https://www.aldiwan.net/poem22738.html","الرمل"],[46,"إذا طلع النسران غارت ظعائن","https://www.aldiwan.net/poem22825.html","الطويل"],[46,"جسم الفتى مثل قام فعل","https://www.aldiwan.net/poem23169.html","مجزوء البسيط"],[46,"جسمي أودى مر السنين به","https://www.aldiwan.net/poem23186.html","المنسرح"],[46,"شعر كساه الدهر صبغة حاذق","https://www.aldiwan.net/poem23248.html","الكامل"],[46,"نحن قطنية وصوفية أن","https://www.aldiwan.net/poem23541.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85349","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85824","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54539","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[99,"حلم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=16638",""]],"verses":[["جَسَدٌ يُقَلَّبُ لِلضَنى","بِيَدَي طُبَيَّبَةٍ سِواها",0,"ا",3,0],["جِسمٌ تَفَرَّدَ بِالأَكفانِ يَجعَلُها","مُذ طَلَّقَ العُمرَ أَبدالاً مِنَ الحُلَلِ",1,"ل",1,0],["جَسَرتُ عَلى بابِ الهَوى فَدَخَلتُهُ","فَقَد جاءَني مِنهُ الَّذي كُنتُ أَفرَقُ",2,"ق",1,1],["جِسْمي ولَحْظُكَ في السَّقامِ تَشارَكا","واللّهُ يعْلَمُ أيُّنا المَفْؤودُ",3,"د",1,0],["جِسمُهُ في الصَفاءِ وَالرِقَّةِ الماءُ","فَلا غَروَ أَن حَبابٌ عَلاهُ",4,"ه",1,0],["جِسمُ السُرورِ سَوِيٌّ","مِن صَوغِ نُعماكَ عِندي",5,"ي",1,0],["جَسَّتْ أَسَاسَهُمَا تُعَالِجُ نَقْضَه","فَعَصَى فَمَرَّتْ بِاصْطِحَابِ جُنُونِ",6,"ن",1,0],["جُسُّوا مِظَنَّةَ حِسِّهِ أَفَنَابِضٌ","فِيهَا فُؤَادُ مُتَيَّمٍ وَلْهَانِ",7,"ن",1,0],["جِسْمَانِ يَغْتَدِيَانِ جِسْماً وَاحِداً","كَتَوحُّدِ الحَبَبَيْنِ يَقْتَرِنَانِ",8,"ن",1,0],["جَسَّ القلوب بجَسّه أوتارَهُ","حتى كأن قلوبنا بَيْن الوتَرْ",9,"ر",1,0],["جسمٌ سقيمٌ لا يرام شفاؤه","سلبت سويدا مهجتي سوداؤه",10,"ا",3,1],["جسمان مرئيان جسماً واحدًا","كالنظم شدَّدَ حرَفهُ علماؤه",10,"ا",3,0],["جسمي إلى جدثِي مهوايَ من كثب","فكيف يعجبني مهوايَ من صعدِ",11,"د",1,0],["جسمي أبو ذرّ الضنا فذروني","أروي لأحبابي حديثَ شجوني",12,"ي",1,1],["جسمي وذاكَ الخصر والجفن الدنف","هنَّ حروف الاعتدال المكتنف",13,"ف",1,0],["جسورٌ على الأهوال يحسر للقنا","ويدّرعُ المعروف دون القوارص",14,"ص",1,0],["جَسَسْتُ بفيشلتي قلبَها","وزلزلْتُ بالرَّهْزِ أركانها",15,"ن",3,0],["جِسمٌ كَخَصرِكِ في النُحو","ل وَمِثلُ جَفنِكِ في الفُتورِ",16,"ر",1,0],["جسمه يوم سرت بالغرب ثاوٍ","بيد أن الفؤاد خلف ركابك",17,"ك",1,0],["جَسَّ الطّبيبَ يَدي جَهْلاً فقلتُ لهُ","إِنَّ المَحَبّةَ في قَلْبي فَخَلِّ يَدي",18,"ي",1,0],["جسَرتُ على دهياء مصرَ ففُتُّها","ولم يَكُنِ الدهياءَ إلا من استجرا",19,"ر",2,0],["جسد راسب وروح لطيف","خلق النفس منهما بين بينا",20,"ن",2,0],["جسمي طليقٌ غيرَ أنَّ عزِيمتي","مغلولةٌ قَهراً وقلبي عاني",21,"ن",2,0],["جِسمِيَ لا جِسمُكَ النَحيلُ","وَيا عَليلاً أَنا العَليلُ",22,"ل",1,1],["جَسيمُ مَحَلِّ البَيتِ ضَمَّنَكَ القِرى","أَبوكَ وَأَحداثُ الأُمورَ الجَوامِعِ",23,"ع",1,0],["جِسمي مَعي غَيرَ أَن الروحَ عِندَكُمُ","فَالجِسمُ في عزبَةٍ وَالروحُ في وَطَنِ",24,"ن",1,1],["جَسَّت يَدي لِتَرى ما بي فَقُلتُ لَها","كُفّي فَذاكَ جَوىً لَولاكِ لَم يَهجِ",25,"ج",1,0],["جَسَّ نَبضي وَقالَ ما أَنتَ شاكٍ","قُلتُ ناراً لَم يُطفِها التَبريدُ",26,"د",1,0],["جِسمٌ كَصَخرٍ في صَلابَةِ جِرمِهِ","وَجُفونُها في الدَمعِ كَالخَنساءِ",27,"ا",2,0],["جَسَدٌ في الثرى وروحٌ شريدٌ","في الأعالي محلِّقٌ في السماءِ",28,"ا",2,0],["جسمي هو الطّيْفُ الّذي","يُدْنِيهِ منكِ طِلابُ ديني",29,"ي",1,0],["جسمُ لجينٍ ناعمٌ لَمْسُهُ","لصفرةِ العسجدِ فيه اتّهام",30,"م",1,0],["جِسمُها بالبَقاءِ في الدنِّ يَبلى","وقُواها مع اللّيالي تَجَدّد",31,"د",1,0],["جسمي ضعيفٌ عنْ لظى وعذابُها","حاشاكَ تنسى مَنْ إليكَ قدِ التجا",32,"ج",2,0],["جِسمُ المُحِبِّ بِثَوبِ السَقمِ مُشتَمِلُ","وَجَفنُهُ بِدُموعِ الشَوقِ مُكتَحِلُ",33,"ل",1,1],["جِسمي يُقيكَ الَّذي تَشكوهُ مِن أَلَمٍ","وَدَمعُ عَينَيَّ يَفدي دَمعَ عَينَيكا",34,"ك",2,0],["جِسمي يَقولُ بِسُقمِهِ","عِندي مِنَ الحُبُّ الخَبَر",35,"ر",1,0],["جَسَدي قائِمٌ وَروحي مُواتُ","وَسُهادي مَعاً وَنَومي سُباتُ",36,"ت",1,1],["جَسَرَت مُشاغَبَتي وَفِيَّ بَقِيَّةٌ","تُخشى كَما يُتَخَوَّفُ المَأثورُ",37,"ر",1,0],["جِسمِيَ أَنجاسٌ فَما سَرَّني","أَنّي بِمِسكِ القَولِ ضُمِّختُ",38,"ت",1,0],["جَسَدٌ يُعَذَّبُ في الحَياةِ حَسِبتُهُ","مُستَشعِراً حَسَدَ العِظَامِ الهُمَّدِ",39,"د",1,0],["جَسَدٌ تَوى إِن تَفتَرِق أَجزاؤُهُ","لَم تَنأَ عَن فَلَكٍ عَلَيهِ مُدارِ",40,"ر",1,0],["جَسَدٌ مِن أَربَعٍ تَلحَظُها","سَبعَةٌ راتِبَةٌ في اِثنَي عَشَر",41,"ر",1,0],["جُسومٌ ثُمَّ عادَت فَأَصبَحَت","ضُروباً كَزَرعٍ نابِتٍ وَغِراسِ",42,"س",1,0],["جِسمُ الفَتى مِثلُ قامَ فِعلٌ","مُذ كانَ ما فارَقَ اِعتِلالا",43,"ل",2,1],["جِسمِيَ أَودى مَرُ السِنينَ بِهِ","فَلتَطلُبِ النَفسُ مَنزِلاً بَدَلَه",44,"ل",2,1],["جِسمٌ يَذُمُّ النَفسَ وَهيَ تَذُمُّهُ","في مُجمَلٍ مِن أَمرِها وَمُفَصَّلِ",45,"ل",1,0],["جَسَدي خِرقَةٌ تُخاطُ إِلى الأَر","ضِ فَيا خائِطَ العَوالِمِ خِطني",46,"ن",2,0],["جسم الفَتى ما عاشَ مملكة بها","تَجري أُمور للحَياة جسام",47,"م",1,0],["جسارتي قلت","جلادتي خارَت",48,"ت",1,0],["جسر أدق بعرضه من شعرة","واحد من سيف جراز مخذم",49,"م",1,0],["جِسْمٌ بَرَتْهُ يَدُ الضَّنَى حَتَّى غَدَا","قَفَصاً بِهِ لِلْقَلْبِ طَيْرٌ يَصْفِرُ",50,"ر",1,0],["جَسَدٌ عِنْدَ مُنْتَهَى ظُلَمِ الدّهْرِ","وَرُوحٌ في مُزْدَهَي الأَضْوَاءِ",51,"ا",2,0],["جِسْمٌ يُقَوِّضُهُ السَّقَامُ وَهَمُّسهَا","مُتَعَلِّقٌ بِالخَلْقِ وَالإِنْشَاءِ",52,"ا",2,0],["جِسْمٌ كحُقٍّ لِلْحَيَا","ةِ مُعَرَّقٍ ومُضَلَّعِ",53,"ع",1,0],["جِسمُهُ يضعُف مِمّا","يَشتَكي وَالنَفسُ تَقوى",54,"و",2,0],["جسمٌ نحيلٌ، غيرَ أنَّ وراءَهُ","أفُقًا يتيه الظنُّ في أرجائه",55,"ا",3,0],["جَسَدُ الشهيدِ إلى جوارِ اللهِ في","عَدْن، على أيدي الملائك يُحمَل",56,"ل",1,0],["جسمُك الغضُ مَنطقٌ يدحَض","الحجّة لو لم تُسَتِّري بُرهانه",57,"ن",2,0],["جَسورٍ رأي أنّ مَن يَقتحمْ","يُحكَّمْ، ومن يَنكمشْ يُنْهَب",58,"ب",1,0],["جَسَدي يشتاقُ إلى بغدادَ","وقلبي عند نساءِ الشَامْ ...",59,"م",1,0]]}