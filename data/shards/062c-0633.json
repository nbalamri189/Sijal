42,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[442,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[444,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[460,"لله قلبا قريني صبوة قطعا","https://www.aldiwan.net/poem55842.html","البسيط"],[460,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[460,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[460,"ما نازل بمن علا","https://www.aldiwan.net/poem56140.html","مجزوء الرجز"],[466,"خصرك هذا المخطف","https://www.aldiwan.net/poem3240.html","عموديه"],[466,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[466,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[470,"وقهوة كخلوق","https://www.aldiwan.net/poem59992.html","المجتث"],[470,"جسد ناحل وصبر ضعيف","https://www.aldiwan.net/poem60251.html","الخفيف"],[470,"جسم زجاج وروح راح","https://www.aldiwan.net/poem60282.html","مخلع البسيط"],[479,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[484,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[502,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[516,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[516,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[531,"جسم أقام بإب","https://www.aldiwan.net/poem37335.html","المجتث"],[540,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[553,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[553,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[560,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[560,"جل وجه بنوره الوهاج","https://www.aldiwan.net/poem33555.html","الخفيف"],[560,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[560,"شخصت لطلعة وجهك الأشخاص","https://www.aldiwan.net/poem34426.html","الكامل"],[560,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[560,"رح يا أنا يا فاسد التركيب","https://www.aldiwan.net/poem34954.html","الكامل"],[561,"أنظر للفظ أنا يا مغرما فيه","https://www.aldiwan.net/poem69335.html","البسيط"],[566,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[569,"ولما عبثن بأوتارهن","https://www.aldiwan.net/poem69490.html","البسيط"],[569,"وكثيرة النغمات تحسبها","https://www.aldiwan.net/poem69583.html","الكامل"],[569,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[569,"اعذر أخاك فما عليه جناح","https://www.aldiwan.net/poem69757.html","الكامل"],[577,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[909,"","https://poetry.dctabudhabi.ae/diwan/poem/20976","الكامل"]],"verses":[["جَسَدٌ يُقَلَّبُ لِلضَنى","بِيَدَي طُبَيَّبَةٍ سِواها",0,"ا",3,0],["جِسمٌ تَفَرَّدَ بِالأَكفانِ يَجعَلُها","مُذ طَلَّقَ العُمرَ أَبدالاً مِنَ الحُلَلِ",1,"ل",1,0],["جَسَرتُ عَلى بابِ الهَوى فَدَخَلتُهُ","فَقَد جاءَني مِنهُ الَّذي كُنتُ أَفرَقُ",2,"ق",1,1],["جِسْمي ولَحْظُكَ في السَّقامِ تَشارَكا","واللّهُ يعْلَمُ أيُّنا المَفْؤودُ",3,"د",1,0],["جِسمُهُ في الصَفاءِ وَالرِقَّةِ الماءُ","فَلا غَروَ أَن حَبابٌ عَلاهُ",4,"ه",1,0],["جِسمُ السُرورِ سَوِيٌّ","مِن صَوغِ نُعماكَ عِندي",5,"د",2,0],["جَسَّتْ أَسَاسَهُمَا تُعَالِجُ نَقْضَه","فَعَصَى فَمَرَّتْ بِاصْطِحَابِ جُنُونِ",6,"ن",1,0],["جُسُّوا مِظَنَّةَ حِسِّهِ أَفَنَابِضٌ","فِيهَا فُؤَادُ مُتَيَّمٍ وَلْهَانِ",7,"ن",1,0],["جِسْمَانِ يَغْتَدِيَانِ جِسْماً وَاحِداً","كَتَوحُّدِ الحَبَبَيْنِ يَقْتَرِنَانِ",8,"ن",1,0],["جَسَّ القلوب بجَسّه أوتارَهُ","حتى كأن قلوبنا بَيْن الوتَرْ",9,"ر",1,0],["جسمٌ سقيمٌ لا يرام شفاؤه","سلبت سويدا مهجتي سوداؤه",10,"ا",3,1],["جسمان مرئيان جسماً واحدًا","كالنظم شدَّدَ حرَفهُ علماؤه",10,"ا",3,0],["جسمي إلى جدثِي مهوايَ من كثب","فكيف يعجبني مهوايَ من صعدِ",11,"د",1,0],["جسمي أبو ذرّ الضنا فذروني","أروي لأحبابي حديثَ شجوني",12,"ن",2,1],["جسمي وذاكَ الخصر والجفن الدنف","هنَّ حروف الاعتدال المكتنف",13,"ف",1,0],["جسورٌ على الأهوال يحسر للقنا","ويدّرعُ المعروف دون القوارص",14,"ص",1,0],["جَسَسْتُ بفيشلتي قلبَها","وزلزلْتُ بالرَّهْزِ أركانها",15,"ن",3,0],["جِسمٌ كَخَصرِكِ في النُحو","ل وَمِثلُ جَفنِكِ في الفُتورِ",16,"ر",1,0],["جسمه يوم سرت بالغرب ثاوٍ","بيد أن الفؤاد خلف ركابك",17,"ك",1,0],["جَسَّ الطّبيبَ يَدي جَهْلاً فقلتُ لهُ","إِنَّ المَحَبّةَ في قَلْبي فَخَلِّ يَدي",18,"د",2,0],["جسَرتُ على دهياء مصرَ ففُتُّها","ولم يَكُنِ الدهياءَ إلا من استجرا",19,"ر",2,0],["جسد راسب وروح لطيف","خلق النفس منهما بين بينا",20,"ن",2,0],["جسمي طليقٌ غيرَ أنَّ عزِيمتي","مغلولةٌ قَهراً وقلبي عاني",21,"ن",2,0],["جِسمِيَ لا جِسمُكَ النَحيلُ","وَيا عَليلاً أَنا العَليلُ",22,"ل",1,1],["جَسيمُ مَحَلِّ البَيتِ ضَمَّنَكَ القِرى","أَبوكَ وَأَحداثُ الأُمورَ الجَوامِعِ",23,"ع",1,0],["جِسمي مَعي غَيرَ أَن الروحَ عِندَكُمُ","فَالجِسمُ في عزبَةٍ وَالروحُ في وَطَنِ",24,"ن",1,1],["جَسَّت يَدي لِتَرى ما بي فَقُلتُ لَها","كُفّي فَذاكَ جَوىً لَولاكِ لَم يَهجِ",25,"ج",1,0],["جَسَّ نَبضي وَقالَ ما أَنتَ شاكٍ","قُلتُ ناراً لَم يُطفِها التَبريدُ",26,"د",1,0],["جِسمٌ كَصَخرٍ في صَلابَةِ جِرمِهِ","وَجُفونُها في الدَمعِ كَالخَنساءِ",27,"ا",2,0],["جَسَدٌ في الثرى وروحٌ شريدٌ","في الأعالي محلِّقٌ في السماءِ",28,"ا",2,0],["جَسيماً ما بَكَيتُ بِهِ كُلَيباً","إِذا ذُكِرَ الفِعالُ مِنَ الجَسيمِ",29,"م",1,0],["جسمي هو الطّيْفُ الّذي","يُدْنِيهِ منكِ طِلابُ ديني",30,"ن",2,0],["جسمُ لجينٍ ناعمٌ لَمْسُهُ","لصفرةِ العسجدِ فيه اتّهام",31,"م",1,0],["جِسمُها بالبَقاءِ في الدنِّ يَبلى","وقُواها مع اللّيالي تَجَدّد",32,"د",1,0],["جسمي ضعيفٌ عنْ لظى وعذابُها","حاشاكَ تنسى مَنْ إليكَ قدِ التجا",33,"ج",2,0],["جِسمُ المُحِبِّ بِثَوبِ السَقمِ مُشتَمِلُ","وَجَفنُهُ بِدُموعِ الشَوقِ مُكتَحِلُ",34,"ل",1,1],["جِسمي يُقيكَ الَّذي تَشكوهُ مِن أَلَمٍ","وَدَمعُ عَينَيَّ يَفدي دَمعَ عَينَيكا",35,"ك",2,0],["جِسمي يَقولُ بِسُقمِهِ","عِندي مِنَ الحُبُّ الخَبَر",36,"ر",1,0],["جَسَدي قائِمٌ وَروحي مُواتُ","وَسُهادي مَعاً وَنَومي سُباتُ",37,"ت",1,1],["جَسَرَت مُشاغَبَتي وَفِيَّ بَقِيَّةٌ","تُخشى كَما يُتَخَوَّفُ المَأثورُ",38,"ر",1,0],["جِسمِيَ أَنجاسٌ فَما سَرَّني","أَنّي بِمِسكِ القَولِ ضُمِّختُ",39,"ت",1,0],["جَسَدٌ يُعَذَّبُ في الحَياةِ حَسِبتُهُ","مُستَشعِراً حَسَدَ العِظَامِ الهُمَّدِ",40,"د",1,0],["جَسَدٌ تَوى إِن تَفتَرِق أَجزاؤُهُ","لَم تَنأَ عَن فَلَكٍ عَلَيهِ مُدارِ",41,"ر",1,0],["جَسَدٌ مِن أَربَعٍ تَلحَظُها","سَبعَةٌ راتِبَةٌ في اِثنَي عَشَر",42,"ر",1,0],["جُسومٌ ثُمَّ عادَت فَأَصبَحَت","ضُروباً كَزَرعٍ نابِتٍ وَغِراسِ",43,"س",1,0],["جِسمُ الفَتى مِثلُ قامَ فِعلٌ","مُذ كانَ ما فارَقَ اِعتِلالا",44,"ل",2,1],["جِسمِيَ أَودى مَرُ السِنينَ بِهِ","فَلتَطلُبِ النَفسُ مَنزِلاً بَدَلَه",45,"ل",2,1],["جِسمٌ يَذُمُّ النَفسَ وَهيَ تَذُمُّهُ","في مُجمَلٍ مِن أَمرِها وَمُفَصَّلِ",46,"ل",1,0],["جَسَدي خِرقَةٌ تُخاطُ إِلى الأَر","ضِ فَيا خائِطَ العَوالِمِ خِطني",47,"ن",2,0],["جسم الفَتى ما عاشَ مملكة بها","تَجري أُمور للحَياة جسام",48,"م",1,0],["جسارتي قلت","جلادتي خارَت",49,"ت",1,0],["جسر أدق بعرضه من شعرة","واحد من سيف جراز مخذم",50,"م",1,0],["جِسْمٌ بَرَتْهُ يَدُ الضَّنَى حَتَّى غَدَا","قَفَصاً بِهِ لِلْقَلْبِ طَيْرٌ يَصْفِرُ",51,"ر",1,0],["جَسَدٌ عِنْدَ مُنْتَهَى ظُلَمِ الدّهْرِ","وَرُوحٌ في مُزْدَهَي الأَضْوَاءِ",52,"ا",2,0],["جِسْمٌ يُقَوِّضُهُ السَّقَامُ وَهَمُّسهَا","مُتَعَلِّقٌ بِالخَلْقِ وَالإِنْشَاءِ",53,"ا",2,0],["جِسْمٌ كحُقٍّ لِلْحَيَا","ةِ مُعَرَّقٍ ومُضَلَّعِ",54,"ع",1,0],["جِسمُهُ يضعُف مِمّا","يَشتَكي وَالنَفسُ تَقوى",55,"و",2,0],["جسمٌ نحيلٌ، غيرَ أنَّ وراءَهُ","أفُقًا يتيه الظنُّ في أرجائه",56,"ا",3,0],["جَسَدُ الشهيدِ إلى جوارِ اللهِ في","عَدْن، على أيدي الملائك يُحمَل",57,"ل",1,0],["جسّمت أنفاس الشّذا فترنّحت","فيك الطيوب كأنّها أجسام",58,"م",1,0],["جسمُك الغضُ مَنطقٌ يدحَض","الحجّة لو لم تُسَتِّري بُرهانه",59,"ن",2,0],["جَسورٍ رأي أنّ مَن يَقتحمْ","يُحكَّمْ، ومن يَنكمشْ يُنْهَب",60,"ب",1,0],["جَسَدي يشتاقُ إلى بغدادَ","وقلبي عند نساءِ الشَامْ ...",61,"م",1,0],["جِسمي نَحيلٌ لا يزالُ من الهوى","حتى غَدا من سُقْمِه كَحشَاكِ",62,"ك",1,0],["جسمي معي والروحُ في منجٍ ولي","قلبٌ يعذَّب في غرام بلادِي",63,"د",2,0],["جسمٌ تضيقُ بهمِّهِ","الدُنيا على نعشٍ يُمَدُّ",64,"د",1,0],["جسمي قد استولى عليهِ الضنا","في حب هذا الناعسِ الأعينِ",65,"ن",1,1],["جسمي وعيناه كل مثل صاحبه","يبدى له مثلما يبديه من سقمه",66,"م",2,0],["جِسمُ لُجَينٍ قَميصُهُ ذَهَب","زُرَّ عَلى لُعبَةٍ مِنَ الطيبِ",67,"ب",1,1],["جسّ زندي فقال لي بك داءٌ","من بلى بالذي بليت يذيبُ",68,"ب",1,0],["جَسَدٌ ناحِلٌ وَطَرفٌ قَريح","ظَلَّ يَهمي وَهامَةٌ شَعثاءُ",69,"ا",2,0],["جسمٌ تراهُ فلا تدري أمشتملٌ","بالثوبِ أم درجوهُ منهُ في كفنِ",70,"ن",1,0],["جسمٌ شمائله تضاهي لؤلؤاً","رطباً يقاس إلى قضيب الآسِ",71,"س",1,0],["جسمين قد قُسِما بروحٍ واحدٍ","كُلٌّ بكلٍّ مُسعَدٌ مُتَوافِ",72,"ف",1,0],["جسم تناهت به أشكالُ صنعته","فقد تفاوت فيه وصفُ من وصفا",73,"ف",2,0],["جسم من النور صاف","تغار منه الكميت",74,"ت",1,0],["جسم كجسم الهواء شاك","من رقةٍ بأسها شديدُ",75,"د",1,0],["جسمٌ من النور لو يوما ظهرت به","عريان ما كان للأرواح من واقى",76,"ق",2,0],["جَسَدي اِنضَنى لَم يَبقَ إِلّا نِصفُهُ","وَالنِصفُ مُقتَربٌ إِلَيهِ حَتفُه",77,"ه",1,0],["جسدي ناقصٌ وحبُّك نامِ","مذ غَدَا سُقم مقلتيك سقامي",78,"م",2,1],["جَسَدٌ ناحِلٌ وَقَلبٌ جَريحٌ","وَدُموعٌ عَلى الخدود تسيحُ",79,"ح",1,1],["جَسَدي كَما بَلِيَت طُلولُكِ بَعدَهُم","بالٍ وَصَبري مِثلُ رَبعِكِ عافِ",80,"ف",1,0],["جَسَستِ من الأوتارِ ألطفَها كما","جَسَستِ فؤادي وهو بالحبِّ يقتات",81,"ت",1,0],["جست مثاني عودها بأنامل","عبثت بلب الخاشع المتورع",82,"ع",1,1],["جسمك العبقريّ شكلا وظلّا","الغويّ الغنيّ عن كل حسن",83,"ن",1,0],["جسد داعر وجلد سميك","دونه في السماكة التمساح",84,"ح",1,0],["جسوُمُ لُجينٍ في غلائِلَ عَسْجِدٍ","وأَنمُلُ حُسَّابٍ بِغيرِ مَعَاصِم",85,"م",1,0],["جسمه الباديَ الضنى","مُغْرَقاً أو مُحَرَّقا",86,"ق",2,0],["جسمٌ تغير في التركيب منعكساً","روسٌ أخامصُ والأخماص كالروس",87,"س",1,0],["جُسيمي من لُويلاتي ذُوَيبٌ","كأني في بُوَيتٍ من سُقَيرِ",88,"ر",1,0],["جسم تَجسم مِن ضَناً","مبلٍ وَقَلب مِن أَوام",89,"م",1,0],["جسمي تراه المقيم في دعة","وفكرتي في الرحيل والظعن",90,"ن",1,0],["جست بها الأوتار قائلة","يا دهر هذا منتهى قصدي",91,"د",2,0],["جسَّ الطبيب فلم يجد","من نب