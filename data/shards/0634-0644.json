{"poems":[[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[85,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[31,"ألقتلى أراك أعرضت عني","https://www.aldiwan.net/poem42032.html","الخفيف"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43856","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""]],"verses":[["شُلِلتُم بِها شَلَّ الطَرائِدِ بِالقَنا","تَبَرَّأَ مَن وَلّى وَضَلَّ الَّذي هَدى",0,"د",2,0],["شَلَّ بَنانُ الزَمانِ كَيفَ رَمى","مُسَوَّماً لِلسِباقِ مَجنوبا",1,"ب",2,0],["شَلَّت أَنامِلُ مَن رَمى فَلِكَفِّهِ","حَزُّ المُدى وَلِكَفِّكَ التَقبيلُ",2,"ل",1,0],["شَلّالُ مِلفِرد لا يَقَرُّ قَرارَهُ","وَأَنا لِشَوقي لا يَقِرُّ قَراري",3,"ر",2,0],["شَلَّ مِنكَ التاجَ مُهتَضِماً","مَن يُعادِ الشَعبَ يُهتَضَمِ",4,"م",1,0],["شَلّالَها وَعَذبَها وَعِدَّها","وَاِصرِف إِلَينا جَزرَها وَمَدَّها",5,"د",3,0],["شلَّت يداك وخاست ريشةٌ غفلت","عن البلابل في رسم السعادين",6,"ن",1,0],["شَلَّ مِنهُ اللِسانُ إِن كُنتُ أَهوى","مِن بَني آدَمَ الغَداةَ سِواكا",7,"ك",2,0],["شلوٌ على شِلوٍ يطيرُ فُضاضُه","ودمٌ يسيلُ على دمٍ مطلولِ",8,"ل",1,0],["شلت يد الساقي فقد دست لنا","سماً زعافاً في كؤوس سلاف",9,"ف",1,0],["شُلَّتْ يَدُ البَيْنِ الَّذِي سَاءَنَا","بِفَقْدِ ذَاكَ العَالِمِ الحَبْرِ",10,"ر",1,0],["شِلْوٌ بِأَسْلِحَةِ الأَسَاةِ","مُبَضَّعٌ فَوْقَ السَّرِيرْ",11,"ر",1,0],["شُلَّت يَدي بَل سَلَبتنيها","وَحُقَّ لِلأَخذَمِ اِنكِماشُ",12,"ش",1,0],["شَلَّ زَنْدٌ قَدْ رَمَى زَنْدَ الْعُلاَ","وحَمَى اللَهُ الرئيسَ الأَكْبَرَا",13,"ر",2,0],["شَلَّتْ يدٌ عبِثتْ في أُختِها وكَبَتْ","رِجلٌ إلى نفسِها تسعى باضرار",14,"ر",1,0],["شَلَّتْ يدُ المستعمرينَ وفرضُها","هذي العُلوقَ على الدّماءِ ضرائبا",15,"ب",2,0]]}