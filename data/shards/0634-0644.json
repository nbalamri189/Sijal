{"poems":[[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[85,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[31,"ألقتلى أراك أعرضت عني","https://www.aldiwan.net/poem42032.html","الخفيف"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43856","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[128,"درويش يا ذا الخلفة الشوهاء","https://www.aldiwan.net/poem50675.html","البسيط"],[131,"شلت يميني ولا أشرب معتقة","https://www.aldiwan.net/poem24005.html","البسيط"],[160,"رضاك عني رضا الباري به قرنا","https://www.aldiwan.net/poem58662.html","البسيط"],[160,"شلت يمين حوادث الأيام","https://www.aldiwan.net/poem58670.html","الكامل"],[160,"حكم مضى وقضاء لا نغالبه","https://www.aldiwan.net/poem58710.html","الطويل"],[160,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[160,"ما كان حق محبكم أن يهجرا","https://www.aldiwan.net/poem58978.html","الكامل"],[197,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[212,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[252,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[259,"شلير لعمري أساء الجوارا","https://www.aldiwan.net/poem36002.html","المتقارب"],[270,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[270,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[300,"غادرني سهمه أعشى وغادره","https://www.aldiwan.net/poem45495.html","البسيط"],[403,"ما ضاع ما ضاع ما أهداه لومه","https://www.aldiwan.net/poem33418.html","البسيط"],[432,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[461,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[461,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[464,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[514,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[573,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"]],"verses":[["شُلِلتُم بِها شَلَّ الطَرائِدِ بِالقَنا","تَبَرَّأَ مَن وَلّى وَضَلَّ الَّذي هَدى",0,"د",2,0],["شَلَّ بَنانُ الزَمانِ كَيفَ رَمى","مُسَوَّماً لِلسِباقِ مَجنوبا",1,"ب",2,0],["شَلَّت أَنامِلُ مَن رَمى فَلِكَفِّهِ","حَزُّ المُدى وَلِكَفِّكَ التَقبيلُ",2,"ل",1,0],["شَلّالُ مِلفِرد لا يَقَرُّ قَرارَهُ","وَأَنا لِشَوقي لا يَقِرُّ قَراري",3,"ر",2,0],["شَلَّ مِنكَ التاجَ مُهتَضِماً","مَن يُعادِ الشَعبَ يُهتَضَمِ",4,"م",1,0],["شَلّالَها وَعَذبَها وَعِدَّها","وَاِصرِف إِلَينا جَزرَها وَمَدَّها",5,"د",3,0],["شلَّت يداك وخاست ريشةٌ غفلت","عن البلابل في رسم السعادين",6,"ن",1,0],["شَلَّ مِنهُ اللِسانُ إِن كُنتُ أَهوى","مِن بَني آدَمَ الغَداةَ سِواكا",7,"ك",2,0],["شلوٌ على شِلوٍ يطيرُ فُضاضُه","ودمٌ يسيلُ على دمٍ مطلولِ",8,"ل",1,0],["شلت يد الساقي فقد دست لنا","سماً زعافاً في كؤوس سلاف",9,"ف",1,0],["شُلَّتْ يَدُ البَيْنِ الَّذِي سَاءَنَا","بِفَقْدِ ذَاكَ العَالِمِ الحَبْرِ",10,"ر",1,0],["شِلْوٌ بِأَسْلِحَةِ الأَسَاةِ","مُبَضَّعٌ فَوْقَ السَّرِيرْ",11,"ر",1,0],["شُلَّت يَدي بَل سَلَبتنيها","وَحُقَّ لِلأَخذَمِ اِنكِماشُ",12,"ش",1,0],["شَلَّ زَنْدٌ قَدْ رَمَى زَنْدَ الْعُلاَ","وحَمَى اللَهُ الرئيسَ الأَكْبَرَا",13,"ر",2,0],["شَلَّتْ يدٌ عبِثتْ في أُختِها وكَبَتْ","رِجلٌ إلى نفسِها تسعى باضرار",14,"ر",1,0],["شَلَّتْ يدُ المستعمرينَ وفرضُها","هذي العُلوقَ على الدّماءِ ضرائبا",15,"ب",2,0],["شُلّتْ يداكَ وفضَّ فُوك وفرقت","أيديك يا أخَ مِحْنة وشقاءِ",16,"ا",2,0],["شُلَّت يَميني وَلا أَشرَب مُعَتَّقَةً","إِذ أَخطَأَ المَوتُ أَسماءَ بنَ زِنباعِ",17,"ع",1,1],["شلت يدي حين آتى الأمر تكرهه","وحين أصغى لما لا تشتهي أذنا",18,"ن",2,0],["شلت يمين حوادث الأيامِ","فلقد حكمن وجرن في الأحكام",19,"م",1,1],["شلّتْ يدُ الدهر ما أعمى بصيرته","عن درة إنشبت فيها مخالبهُ",20,"ب",2,0],["شلت يدا صب رمت نحره","ولم يقل اصميه لا شلت",21,"ت",1,0],["شلت يد الساعي لقد جاز المدى","كذبا وحرّف في الحديث وزورا",22,"ر",2,0],["شُلّت يداه فكم بها","عاثت ألا شلّت يدا",23,"د",2,0],["شَلَّتْ يَمِينُ العُلا من حين ميتَتهِ","وطُلَ للمجد أبصارٌ وأحداقُ",24,"ق",1,0],["شَلَّت يَدا عابثٍ أَهوى بمُديَتِه","مَزحاً فَقَرَّقَ بَينِ الروح وَالبَدَنِ",25,"ن",1,0],["شِلِيرٌ لَعَمْري أَسَاءَ الْجِوَارَا","وَسَدَّ عَلَيَّ رَحِيبَ الْفَضَا",26,"ض",2,1],["شُلَّت يمينُ المُسلم العادي على","إخوانهِ في الشَامِ كي يفديك",27,"ك",1,0],["شُلَّتِ أكفُّ الرومِ إن عَبثوا بها","لمزَاعمٍ ومآربٍ ومَفاسد",28,"د",1,0],["شُلَّت أَنامِلُ مَخشِيَّ فَلا جَبَرَت","وَلا اِستَعانَ بِضاحي كَفِّهِ أَبَدا",29,"د",2,0],["شُلَّتْ يدا رجل سل السلاح إلى","كلم امرىء كان للباري تكلمه",30,"م",2,0],["شُلَّت يَمِينُكَ عن صِيانَةِ مالِها","قَصْداً وصحَّتْ من بَنِيكَ لِنَاهِبِ",31,"ب",1,0],["شِلْوٌ لأَرْمَنْقُورها حُشِرَتْ بِهِ","للزَّحفِ ثُمَّ إِلَى الجَحيمِ حُشُودُها",32,"د",3,0],["شللتهم شل الطرائد في الضحى","وسقتهم سوق المطي المُخزَّم",33,"م",1,0],["شللتهمْ برَويٍّ لا نُبوَّ به","تنبو الظُّبى وهو ماضٍ غيرُ مُنثلم",34,"م",1,0],["شلّت سهام المزن في هضباتها","فكأنَّ جدولها حسام جردا",35,"د",2,0],["شُلّتْ يَداهُ لقد تقمّصَ خِزيةً","يأتي بها يومَ الحِسابِ مؤزَّرا",36,"ر",2,0],["شُلَّتْ يدا من رمى فلم تُصمك الر","رَميةُ لمّا لم يدر كيف رمى",37,"م",2,0],["شُلَّت يَمينُ المُلجَمِيِّ فِإِنَّهُ","تَرَكَ الإِمامَ عَلى شَفا",38,"ف",2,0]]}