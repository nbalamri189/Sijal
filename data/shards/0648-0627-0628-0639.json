aspx?id=177864",""],[5732,"قالو تتوب وقلت بالطرف مصيوب","https://www.poetsgate.com/ViewPoem.aspx?id=177872",""],[5747,"لا تقصر الفنجال","https://www.poetsgate.com/ViewPoem.aspx?id=61659",""],[5776,"رميمٌ وبعث","https://www.poetsgate.com/ViewPoem.aspx?id=203446",""],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5943,"في ملتقى شبَّابنا","https://www.poetsgate.com/ViewPoem.aspx?id=34292",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[6056,"عيب ٍ عليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=130525",""],[6056,"المايس المهصور","https://www.poetsgate.com/ViewPoem.aspx?id=156698",""],[6115,"لايضيق الصدر ولا يعتريه الفزه","https://www.poetsgate.com/ViewPoem.aspx?id=180523",""],[6115,"من عادتي اكتب من الشعربيتين","https://www.poetsgate.com/ViewPoem.aspx?id=180528",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[5309,"إصبر ففي الصبر اعجاز ومقدرة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573679",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[1333,"يا أيها المغتر بالله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56036&r=&rc=14",""],[6264,"نور من الآخاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79196&r=&rc=52",""],[201,"المولد النبوي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65307&r=&rc=15",""]],"verses":[["وَأَبعَدُ شَيءٍ مِنكَ ما فاتَ عَصرُهُ","وَأَقرَبُ شَيءٍ مِنكَ ما كانَ جائِيا",0,"ي",2,0],["وَأَبعَدُ مَوطِناً مِن كُلِّ عارٍ","وَأَمنَعُ جانِباً مِن كُلَّ ذامِ",1,"م",1,0],["وَابْعَثْ رَسُولَكَ مُنْذِراً وَمُحَذِّراً","وَبِمَا تُؤَمَّلُ نَيْلَهُ يَأْتِيكَا",2,"ك",2,0],["وَأَبعَدَهُم بِما غَدَروا وَخانوا","كَما بَعَدَت ثَمودُ وَقومُ عادِ",3,"د",1,0],["وَاِبعَثِ الأُسطولَ تَرمي دونَهُ","قُوَّةُ اللَهِ وَراءً وَأَماما",4,"م",2,0],["وَاِبعَث لَنا عيسى فَهَذا وَقتُهُ","فَالناسُ بَينَ مُخادِعٍ وَمُواري",5,"ر",2,0],["وَأَبعَدُ ما بَدا لَكَ غَيرَ مُشكٍ","خَليلاً لَستَ أَنتَ لَهُ بِقالي",6,"ل",2,0],["وَأَبعَدُهُ نيلاً وَأَوشَكُهُ قِلىً","وَإِن سُئِلَت عُرفاً فَشَرُّ مَسولِ",7,"ل",1,0],["وَأَبعَدُهُ سَمعاً وَأَطيَبُهُ نَثاً","وَأَعظَمُهُ حِلماً وَأَبعَدُهُ جَهلا",8,"ل",2,0],["وَأَبْعَثُهَا شَوَارِدَ فِيكَ تَزْرِي","بِرَنَّاتِ المَثَالِثِ وَالمَثَانِي",9,"ن",2,0],["وَأَبعَدِهِم مَسافَةَ غَورِ عَقلٍ","إِذا ما الأَمرُ ذو الشُبُهاتِ عالا",10,"ل",2,0],["وأبعد مرمى حبّها في شبابه","وجاهد في إسعادها وهوأشيب",11,"ب",1,0],["وَأَبعَدنا لِسوءِ الفِعلِ كَعباً","وَأَدنَينا لِطاعَتِها كِلابا",12,"ب",2,0],["وأبعدت عن حاسدٍ كائدٍ","أينَ السهى من مقعد أقطع",13,"ع",1,0],["وأبعدت علياك لي في الندى","فجبتها بالكلم المبدع",13,"ع",1,0],["وأبعدت بالرغم والعجز عن","جنا دَوْحك الناضر الباسق",14,"ق",1,0],["وابعث خيالاً تراني منه في جدلٍ","فالروح تثبته والجسم ينفيه",15,"ي",2,0],["وأبعدني إبعادَ جاني عظيمةٍ","وقد كنت أُستدعَى زماناً وأُسْتدنَى",16,"ن",2,0],["وأبعدُ أدواءِ الرجالِ ذوي الضّنى","من البرء داءُ المستطِبِّ المكاذبِ",17,"ب",1,0],["وأبعدَ الفِسقَ أشدَّ الإبعادْ","واستأثر اللَّهُ بصدق الميعادْ",18,"د",1,0],["وَأَبعَدُهُم وَأَهوَنُهُم عَلَيهِم","وَإِن أَمسى لَهُ حَسَبٌ وَخيرُ",19,"ر",1,0],["وابعَثْ بسحركَ في","قلبِها ضُرامُ الشَّبيبهْ",20,"ه",1,0],["وابعثي في دمي الحَرارَةَ عَلِّي","أَتغنَّى مع المنى مِنْ جَديدِ",21,"د",1,0],["وَأَبعَدَ ذي هِمَّةٍ هِمَّةً","وَأَعرَفَ ذي رُتبَةٍ بِالرُتَب",22,"ب",1,0],["وَأَبعَدَ بُعدَنا بُعدَ التَداني","وَقَرَّبَ قُربَنا قُربَ البِعادِ",23,"د",1,0],["وَأَبعُدُ حَتّى تَعرُضَ الأَرضُ بَينَنا","وَيُمسي التَلاقي وَهوَ غَيبٌ مُرَجَّمُ",24,"م",1,0],["وأُبْعِدُ بالمَوَدَّةِ منك جُهدي","فَقِفْ لي بالمَوَدّةِ خَلفَ قاف",25,"ف",1,0],["وأبعُدُ خِيفَةَ الواشين عنها","لكي أزدادَ في الحبِّ اقترابا",26,"ب",2,0],["وَأَبعِد بِذي رَأيٍ مِنَ الحُبِّ لِلتُقى","إِذا كانَ لا يُقصي عَلَيها وَلا يُدني",27,"ن",2,0],["وابعث لنا أرج النسيم معطراً","متخطراً كخواطر الأحلام",28,"م",1,0],["وَآبَ عَلى سَعدِ السُعودِ بِرَحلِهِ","عِتاقُ المَذاكي وَالقِلاصُ الرَواتِكُ",29,"ك",1,0],["وَاِبعَث بِطَيفِكَ وَاِعتَقِدها زَورَةً","وَصِلِ السَلامَ عَلى النَوى تَعليلا",30,"ل",2,0],["وأبعدُهم نُفوساً عن رياءٍ","وأصبرُهم إذا ملّوا السِّنينا",31,"ن",2,0],["وَابْعَثُوا النّارَ عليهِ جَهرةً","إنّما المؤمنُ مَنْ يُصْليهِ نارا",32,"ر",2,0],["وَأَبعَثُ أَنفاسي إِذا هَبَّت الصَبا","تَروحُ بِتَسليمي عَلَيكَ وَتَغتَدي",33,"د",2,0],["وَاِبعَث يَساراً إِلى وُفرٍ مُذَمَّمَةٍ","وَاِحدِج إِلَيها بِذي عَركَينِ قِنعاسِ",34,"س",1,0],["وَأَبعِدهُنَّ مِن رَبّاتِ مَكرٍ","سَواحِرَ يَغتَدينَ مُعَزِّماتِ",35,"ت",1,0],["وَأَبعُدُ عَن قائِلٍ لا سَلِمتَ","وَآخَرَ قالَ أَلا يا سَلَمي",36,"م",2,0],["وأبعدت عن حتف يسوء برحلتي","وَقَد كانَ مني قابَ قَوسين أَو أَدنى",37,"ن",2,0],["وأبعدت يا رحمة الخالقِ","فمَ الحب عن نبعك الدافق",38,"ق",1,0],["وابعثيها ثورة أخرى فما","يعرفُ الأحرارُ معنى للجمود",39,"د",1,0],["وَأَبْعَدُ مَفْقُودٍ شَبَابٌ رَمَتْ بِهِ","صُرُوفُ اللَّيَالِي عِنْدَ مَنْ لا يَرُدُّهُ",40,"د",2,0],["وابْعَثِ الأَلْحانَ مُطْرِبَةً","يا حَياةَ الْعيْنِ والأُذُن",41,"ن",1,0],["وابعثي صَحْوةً أغار عليها الش","يْبُ حتَّى غدتْ عَناءً وسُهدا",42,"د",2,0],["وابْعثِ اللّحْنَ من سَمائِكَ يا شعْرُ","ونافسْ به ذواتِ الجناحِ",43,"ح",1,0],["وَابْعَثِ الرَّوضَ مِنْ كَرَاهُ وَقَبِّلْ","وَجَنَاتٍ مِنْ زَهْرِهِ وَخُدُودا",44,"د",2,0],["وَأَبْعَثُ في الصَّحْراء أَنَّاتِ شَيِّقِ","وهَلْ تَسْمعَ الصَّحراء أَنَّاتِ شَيِّقِ",45,"ق",1,0],["وابْعثِ الشِّعْرَ جنَاحَيْ طائرٍ","كلّما شارفَ أُفْقاً دَوّما",46,"م",2,0],["وابْعَثْ أَنينَكَ للسَّحابِ شِكَايةً","فإلاَمَ تحْتَبِسْ الأَنِينَ إِلاَما",47,"م",2,0],["وابعثوه عَسْجداً مُؤْتلِقاً","زاد في لألائه طولُ السنينْ",48,"ن",1,0],["وأبعد ما بدا لَكَ غَيْرَ مُشْكٍ","خليلٌ لستَ أنتَ له بقالِ",49,"ل",1,0],["وَأَبعد ما يَكون الود مِنهُ","إِذا ما باتَ مِن أَمَلي قَريبا",50,"ب",2,0],["وابعد روحي منه وهي ظلاله","واهجر قلبي فيه وهو شفيعه",51,"ع",2,0],["وأُبعِدُ مَنزِلَ السُّفَهَاءِ مِنهُم","حِذَاراً مِن شَمَائِلِ مَن سِوَانَا",52,"ن",2,0],["وابعثي أسرار ما أسقيته","من يد النور وجدواه العميم",53,"م",1,0],["وأبعث الثناءَ","عليهم إرضاءَ",54,"ا",2,0],["وَأَبعِد أَن تُدَبِّرَهُ نُجومٌ","تَمَنّى أَن تَحُلَّ بِحَيثُ حَلّا",55,"ل",2,0],["وَأُبعَدُ إِعراضاً عَلى غَيرِ زَلَّةٍ","وَقَد شاعَ قُربي مِنكَ في العُربِ وَالعُجمِ",56,"م",1,0],["وَأَبعَدُهُم عَن غيِّهِ وَسَفاهِهِ","لِأُمَّتِهِ الجاهُ المَكينُ بِجاهِهِ",57,"ه",1,0],["وابعث جيوشك في البلاد تجوشها","حتى تقيمَ بكل أرضٍ عثيرا",58,"ر",2,0],["وَأَبعَدُها في باحَةِ المَجدِ غايَةً","وَقاباً إِذا ما اِمتَدَّ لِلمَجدِ قابُها",59,"ب",3,0],["وَاِبعَث إِلى المُدنِ بِالبُشرى مُخَبِّرَةً","بِمُلكِ أَروَعَ لا عِيٍّ وَلا وَكِلِ",60,"ل",1,0],["وَأَبعَدُهُم جَرياً إِلى كُلِ غايَةٍ","وَأَطوَلُهُم في كُلِّ مَكرُمةٍ يَدا",61,"د",2,0],["وأبعدهم من النسوان حظّا","إذا ما بيّض الشيخ الكبير",62,"ر",1,0],["وابعث له عادلا ترضى خلائقهُ","من خالص الترك أو من سائر العرب",63,"ب",1,0],["وابعث بأنفسنا ميت العزاء فقد","أودى بها اليأسُ واسمع بعد شكوانا",64,"ن",2,0],["وابعَث بها ميتَ العواطفِ واطرد","اليأسَ المُضّ وأيقظِ الإيمانا",65,"ن",2,0],["وَاِبعَثي من ضياءِ فِكركِ في النا","سِ سَفيراً مسدَّدَ الآراء",66,"ا",2,0],["وَاِبعَث بِها تَمرِيَّةً","إِن أَعوَزَت بِنتُ الكُرومِ",67,"م",1,0],["وَأَبعَدُ ما يُرامُ لَهُ شِفاءٌ","فُؤادٌ فيهِ مِن عَينَيكِ جُرحُ",68,"ح",1,0],["وَأَبْعَدُونِي وَقَدْ آنَسْتُ قُرْبَتَهُمْ","عَذَرْتُهُمْ فَلَقَدْ أَبْعَدْتُ مَا شَرَطُوا",69,"ط",3,0],["وَأَبعَثُها غَرّاءَ بِكراً عَقيلَةً","لِكفؤٍ بأَبكارِ المَعالي مُتَيَّمِ",70,"م",1,0],["وأبعدني جهلاً وقر بجاهلا","دنيا ومن يدني ذوي الجهل جاهل",71,"ل",1,0],["وابعث على آثارهم بكتائب","ملمومة صدعت بكل سميدع",72,"ع",1,0],["وابعد مطلوب عن المرء اول","من المجد لم يظفر له بأخير",73,"ر",1,0],["وابعد عني الزغف والبيض والقنا","وازجر عني المقربات السلاهبا",74,"ب",2,0],["وابعَث من السّجفِ الأشِعَّةَ عندما","يَلهو بذاتِ ملاحة وذكاء",75,"ا",2,0],["وابعث إليه تحيةً يسري بها","ركب ينضّ بشوقها أو يعنق",76,"ق",1,0],["وَاِبعَثَنها إِلى الخلاص برفقٍ","ربّما أَصبحت عقيب حرانِ",77,"ن",1,0],["وَأَبعدهم شأواً ومرمىً وهمّةً","وَأَقربهم رحماً وَأَرأفهم خلبا",78,"ب",2,0],["وإبعاده من بعد ذاك وصده","وتجريعه إياه أعظم غصة",79,"ه",1,0],["وابعثيني فقد تخلّدُ أيّا","مَك في عالمَ الهوى أشعاري",80,"ر",2,0],["وابعثي في المنام طيفك حتى","أنظم الشعر فاسمعيه وغني",81,"ن",2,0],["وابعثي الذكريات","في فؤادي الحزين",82,"ن",1,0],["وابعثه مع النسمات عطراً","واشعاعاً واكسيراً مذابا",83,"ب",2,0],["وَأَبعَدَ الخَلقُ عَنِ الحَقِّ مَن","يُحاوِلُ الحَقَّ بِعِلمِ الكَلامِ",84,"م",1,0],["وابعَث أبا الفَضلِ بينَ القِمتَينِ فقَد","جاوَزتَ بي مدَّة التَّوقيتِ والأجَلِ",85,"ل",1,0],["وابعُد إلى أن يُستماح فإنه","يهتزُّ جوداً عند ذلك عودُهُ",86,"د",2,0],["وأبعدن من الكَرَى","واللَه يمنحك الكِرى",87,"ر",2,0],["وابعد من الناس قاصيهم ودان","واحذر تسمع مقال القائلين",88,"ن",1,0],["وابعد جم جدا","عن أرباب الخطيات",89,"ت",1,0],["وابعثي لحنك الجميل نداءً","من صميم الفؤاد، لا تَخْذُليني:",90,"ن",2,0],["وابعثوا نحونا بهذا وبهذا","وأمهلونا حيناً من الأحيان",91,"ن",1,0],["وأبعد ما حاولت حرًّا دنوُّه","دنوك مما يرتضي واقترابه",92,"ب",2,0],["وَاِبعض إِذا اِنعِضت غَيرَ مُباعِدٍ","فَإِنَّكَ لا تَدري مَتى أَنتَ راجِع",93,"ع",1,0],["وابعث خيالاً منك يرتادني","إذ علّتي منك وأنت الدوا",94,"و",2,0],["وابعثْ إليه خيولَ جاهِك علّها","تَثْنيه بالإطلاقِ بين أسارِ",95,"ر",1,0],["وابعثوا أشباحَكم لي في الكرى","إن أذِنتم لجفوني أن تناما",96,"م",2,0],["وابعث لهم مراثياً ومِدَحاً","صفوةَ ما راض الضميرُ ونَخَلْ",97,"ل",1,0],["وأبعدُ ما ظفرتَ به حبيبٌ","جِراحتُه تصحُّ بكلّ سَبْرِ",98,"ر",1,0],["وابعث ضوارعَ عنك نائبةً","إن أخَّرتْك عوائقُ الدهرِ",99,"ر",1,0],["وأبعدتَ مَنْ أهوَى فإن كنتَ مزمعا","لتسلبني عنهم فسعد وقربُهُ",100,"ب",2,0],["وأبعد كرب الخطب عن موطن العلى","بدانٍ من النَّعْماء بادي المَلامِحِ",101,"ح",1,0],["وابعث من الشعر روحا في مشاعرهم","بعث المرائي إلى الأبصار بالنور",102,"ر",1,0],["وَابعَث عَزائِمَ عَزمٍ مِنكَ قاضِيَةً","عَلى الأَعادي فلا يَبقى لَها أَثَرُ",103,"ر",1,0],["وا