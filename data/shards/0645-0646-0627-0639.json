{"poems":[[29,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[74,"في دعة الله سر سعيدا","https://www.aldiwan.net/poem19373.html","مخلع البسيط"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[87,"من أعجب الأخبار أن الأرنبا","https://www.aldiwan.net/poem8001.html","الرجز"],[30,"مهاريس أشباه كأن رؤوسها","https://www.aldiwan.net/poem4963.html","الطويل"],[30,"إن الأرامل والأيتام قد يئسوا","https://www.aldiwan.net/poem5055.html","البسيط"],[30,"ومسجونة قالت وقد سد زوجها","https://www.aldiwan.net/poem5259.html","الطويل"],[48,"من أعجب الأشياء في دهرنا","https://www.aldiwan.net/poem22226.html","السريع"],[146,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[234,"من أعان الهموم والدهر والبين","https://www.aldiwan.net/poem50917.html","الخفيف"],[353,"من أعلقته للجفون حبائل","https://www.aldiwan.net/poem20413.html","الكامل"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110371","الكامل"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/113001","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59645","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59589","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62446","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126118","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77872","المنسرح"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123158","المتدارك"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123264","الدوبيت"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109334","المتقارب"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177829","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28024","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28030","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27947","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28056","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28051","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27631","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109400","السريع"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17734","الطويل"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111701","الهزج"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102563","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75869","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204757","البسيط"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138015",""],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11287","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87404","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126933","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138541",""],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199178","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114890","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111406","الخفيف"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20876","الكامل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126355","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102751","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139192","الوافر"],[4860,"ثمان سنين\"رسالة ل كل فتاة","https://www.poetsgate.com/ViewPoem.aspx?id=32513",""],[5030,"أم المؤمنين","https://www.poetsgate.com/ViewPoem.aspx?id=215814",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5431,"صفاقة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213693",""],[5437,"إنتفاضة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=143707",""],[5853,"((العيد))","https://www.poetsgate.com/ViewPoem.aspx?id=175643",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[5943,"قاوم، جاهد، اِصبر، صابرْ","https://www.poetsgate.com/ViewPoem.aspx?id=45281",""],[5956,"أرسلتُ من أموالكم لمياتمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193833",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[2588,"شاخصة (صدمة)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65599&r=&rc=31",""],[6344,"شعلة من وقود الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87982&r=&rc=22",""]],"verses":[["مِنّا عُتَيبَةُ فَاِنظُر مَن تُعِدُّ لَهُ","وَالحارِثانِ وَمِنّا الرَدفُ عَتّابُ",0,"ب",1,0],["من أعلم الطرف حين تسري","أنك تاجٌ على المفارق",1,"ق",1,0],["منَّاعةً للرشف منّاحةً","للطرف إن تُبرِئْكَ تستنكِس",2,"س",1,0],["مناعة نيلها المحب وما","تنفك من صدها على خفف",3,"ف",1,0],["مِن أَعجَبِ الأَخبارِ أَنَّ الأَرنَبا","لَمّا رَأى الديكَ يَسُبُّ الثَعلَبا",4,"ب",2,1],["مَناعيشُ لِلمَولى الضَريكِ وَلا تُرى","عَلى الضَيفِ إِلّا باكِرَ الغَدَواتِ",5,"ت",1,0],["مِن أَعيُنٍ عَلِمَت أَن لا حِجازَ لَهُم","وَلا طَعامَ إِذا ما هَبَّتِ القِرَرُ",6,"ر",1,0],["مَناعيشُ لِلمَولى مَرائيبُ لِلثَأى","مَعاقيرُ في يَومِ الشِتاءِ المُذَكَّرِ",7,"ر",1,0],["مِن أَعجَبِ الأَشياءِ في دَهرِنا","وَاللَهُ لا ناسٍ وَلا والِثُ",8,"ث",1,1],["منّاعةٍ بالحسن أجفانَنا","أن يتقاربن لإطراق",9,"ق",1,0],["من أعان الْهُمُوم والدهرَ وَالبَيْ","نَ على نفسِهِ بحزنٍ وضيقِ",10,"ق",1,1],["مَنْ أَعْلَقَتْهُ لِلجُفُونِ حَبَائِلٌ","مُتَيَّقِنِ أَنْ لَيسَ مِنها مَخْلَصُ",11,"ص",1,1],["مِن أَعيُنٍ بانَت قُلوبٌ لَنا","وَالكُلُّ في الأَجسامِ حَيرانُ",12,"ن",1,0],["مَنِ اعتدى يوماً عليك فاعْتَدي","عليه يا صاحِ بمثلِ ما اعتدى",13,"ا",1,0],["من أعادَ الأيامَ وهيَ عبيدٌ","والليالي مثلَ الإماء الوكع",14,"ع",1,0],["من اعتقاد الغي والنفاق","وننظم القول على اتساق",15,"ق",1,0],["منا عليك تحيةٌ منثورةٌ","وعلى ثراكَ من الدموعِ نظامُ",16,"م",1,0],["منا عليها عالما يجدد","دين الهدى لأنه مجدد",17,"د",1,0],["منا على الأعين أن نئهم","لكن على الأدُمع مَحوُ الأثر",18,"ر",1,0],["منا عليه وهو روض بدائع","دِيمٌ تُعاهِدُ منه أكرم معهد",19,"د",1,0],["منّا عجائب قد بدت في أرضهَا","وسمائها وهوائها نعمَ الهَوا",20,"و",2,0],["من أعطي جودا وعزة وغناء","إذ أعطيّ حلما ورفعة وعلا عال",21,"ل",1,0],["من أعلن بالقول إذ أتاه بلال","أنفق ودع المنع لا تخاف من إقلال",21,"ل",1,0],["من أعاد القضيب بالهز لما","إن غزا بدرا صارما مصقولا",22,"ل",2,0],["من أعاد القضيب في الكف سيفا","وبها فاض نبع ماء نمير",23,"ر",1,0],["من أعيدت له الغزالة لما","إن أرادت رضاعة الأولاد",24,"د",1,0],["من أعاد القضب في الكف سيفا","وبها أنبع الزلال لصادي",24,"د",2,0],["من أعاد اليبيس في الكف رطبا","وبه عادت العصا بتارا",25,"ر",2,0],["من أعاد القضيب في الكف سيفا","وبها الماء قد جرى مدرارا",25,"ر",2,0],["من اعتلى فوق السموات العلى","إلى مقام نال منه الأملا",26,"ل",2,0],["من أعتقوها في المُحول وأرهنوا","في السبق حتَّى استعبدوا أشرافَها",27,"ف",3,0],["من أَعين لا يزيغ شاهدها","وألسن تلهم الورى رشدا",28,"د",2,0],["مِن أَعرَبِ العُربِ إِلّا أَنَّ نِسبَتَهُ","إِلى قُرَيشٍ حُماةِ البَيتِ وَالحَرَمِ",29,"م",1,0],["من أعجب ما في مصر يُرى","الكرم يُرى فيه العنب",30,"ب",1,0],["من أعجب ما رأيت في أزماني","ما يولد عندنا سوى النسوان",31,"ن",1,1],["من اعتز فيهم حمى ملككم","مراراً لدى الخطر المحدق",32,"ق",1,0],["منا عليه صلاة صادٍ صادق","ولنا به برق السعود يشام",33,"م",1,0],["من أعجب الأمر فيهم ما أفوه به","هم المقرّون بالأمر الذي جحدوا",34,"د",3,0],["من أعجب الأمر أني حادث وأنا","عين القديم بما قد جاء بالسند",35,"د",1,0],["من أعجب الأمر أنَّ الستر منسدلٌ","والنورُ من خلفه وليس يخرقه",36,"ق",2,0],["من أعجبِ الأمرِ أنَّ قولا","تجابُ فيه وما سمعتا",37,"ت",2,0],["من أعجب الأمر أني حين أذكره","أغيبُ عنه ويدنيني تذكره",38,"ر",2,0],["من أعجب الأمر أن الأمر يحكمه","والحكم في فرح منه وفي حزن",39,"ن",1,0],["من اعجب الأمر أن الحكم من عدم","في عين كونٍ فأين العبدُ والله",40,"ل",2,0],["من أعجب الأشياء اجفانه","بها لقد كان الشفا والسقام",41,"م",1,0],["مَناعيشُ لِلمَولى مَساميحُ بِالقِرى","مَصاليتُ تَحتَ العارِضِ المُتَلَهِّبِ",42,"ب",1,0],["من اعتز بذي العز","زِ فذو العزِّ له عِزُّ",43,"ز",1,1],["من أعظم البلواء والشحناء","جور الهوى بمحبة الغبناء",44,"ا",2,1],["مَن أَعلَمَ القَلبَ أَنَّ الحُبَّ مَجلسُهُ","هُناكَ أعلمهُ سرٌّ لَهُ جَذَبا",45,"ب",2,0],["مناعة الذوق منها جاء يسندها","شعري فلم تتقبل زائف الدرر",46,"ر",1,0],["من اعتقدهم صار منهم يقين","من أمهم ما شاف تمحين",47,"ن",1,0],["مَن أَعمَلَ اليَأسَ كانَ اليَأسُ جاعِلَهُ","مُعَظِّماً أَبَداً في أَعيُنِ الناسِ",48,"س",1,1],["من اعلن السر كان القتل سيمته","فيما مضى هدرا من غير اخذ دم",49,"م",1,0],["من أَعينٍ فتّانَةٍ","لم تحمِنا منها التمائم",50,"م",1,0],["من أعزي بغصن بان إليه","قد سرى الموت ماشيا بدبيب",51,"ب",1,0],["منا عليه بالهدى وبالتقى","ولتؤتياه من بديع الحكمة",52,"ه",1,0],["من أعالي السور ناراً أرسلوا","في البرايا كي يحشوا أي حش",53,"ش",1,0],["من اعتاد هتك الدين جهلاً بلا حيا","وغصب حقوق الناس بالغدر والختل",54,"ل",1,0],["من أعار الآمال سمعاً تلقى","كل مالا يفيد غلا عرورا",55,"ر",2,0],["مناعيشُ للمولى تظلّ عيونها","إلى السيف تستبكي إذا لم تُعَقَّر",56,"ر",1,1],["من أَعالِي الأُولمبِ غَاصت وزَفسٌ","عادَ للصَّرحِ في المَقَامِ المُنيفِ",57,"ف",1,0],["منّاع ما ملكت يدا","ك وسائلٌ لهمُ نحوسا",58,"س",2,0],["من أعظم الأرزاءُ عمرٌ مديد","ما زدتَ عيشاً فالبلايا تزيد",59,"د",1,1],["من أعذب عينا وردّها وشفاها","بالتفل والايما وما بلمسته عاد",60,"د",1,0],["من اعتلى السبع مجتازا إلى أمد","حتى توقل اسنى منتهى الرتب",61,"ب",1,0],["من أعجز العرب الفصاح بمعجز","آياته أبدا لها أحكام",62,"م",1,0],["من اعتمد الصديق ولم يبال","يصبه الضر وهو به خليق",63,"ق",1,0],["من أعماق القلب فزيت دموعي سالت بسكته","خلاص أبشر مدام الحل في كم نظره ولو مَرَه",64,"ر",2,0],["من أعلم الناس بالتشريع قد حفظت","قولَ الرسول فجاءتنا الرواياتُ",65,"ت",1,0],["مَنَّاعَةٌ نَزَّاعَةٌ صَرَّاعَةٌ","جُرثُومَةُ الأمكَارِ فَهِيَ هَثَامِلُ",66,"ل",1,0],["من اعتدى شاكلوه الاعتداء ومن","يدن يحل من التأمين في حرم",67,"م",1,0],["من اعتاد التواء الذهن كسبا","يسير إلى انحناءات الصفاقةْ",68,"ق",2,1],["من اعلنت ديمه. علا صوت نكران","وإتبدل الترنيم باقصى المواويل",69,"ل",1,0],["من أعدم الأطفال صدرا حانيا","من شتّتَ الورد الجميل وبعثره",70,"ر",2,0],["مِنّا عَلِيُ وَصَحبُهُ وَمُعاوِيةْ","سَلمانُ مِنّا وَالوَليدُ وَأَزْهَرُ",71,"ر",1,0],["من أعطى الإذنَ لسارقِهِ","ليحاصرَهُ مثلَ الثعبانْ",72,"ن",1,0],["من أعظم البشر الذين عرفتُهم","كيلا عليَّ الناهبون يسُودُوا",73,"د",3,0],["مَن أَعَدَّ العَيشَ فَوقَ السُّحُبِ","لَيسَ يَخلو مِن دَواعي النَّصَبِ",74,"ب",1,1],["من أعاريبَ ماجدينَ نَمَتهمْ","للمعالي مَراتبٌ وعَراقي",75,"ق",2,0],["من أعمَلَ الفكرَ في","هذا الوجود انصدم !",76,"م",1,0],["مِنْ أَعَالِيهِ مَدَّ قَبْضَتَهُ","رَافِعًا حُلْمَهُ الذِي اخْتُزِلَا",77,"ل",2,0]]}