{"poems":[[27,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[72,"في دعة الله سر سعيدا","https://www.aldiwan.net/poem19373.html","مخلع البسيط"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[85,"من أعجب الأخبار أن الأرنبا","https://www.aldiwan.net/poem8001.html","الرجز"],[28,"مهاريس أشباه كأن رؤوسها","https://www.aldiwan.net/poem4963.html","الطويل"],[28,"إن الأرامل والأيتام قد يئسوا","https://www.aldiwan.net/poem5055.html","البسيط"],[28,"ومسجونة قالت وقد سد زوجها","https://www.aldiwan.net/poem5259.html","الطويل"],[46,"من أعجب الأشياء في دهرنا","https://www.aldiwan.net/poem22226.html","السريع"],[142,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[229,"من أعان الهموم والدهر والبين","https://www.aldiwan.net/poem50917.html","الخفيف"],[348,"من أعلقته للجفون حبائل","https://www.aldiwan.net/poem20413.html","الكامل"],[366,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[432,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["مِنّا عُتَيبَةُ فَاِنظُر مَن تُعِدُّ لَهُ","وَالحارِثانِ وَمِنّا الرَدفُ عَتّابُ",0,"ب",1,0],["من أعلم الطرف حين تسري","أنك تاجٌ على المفارق",1,"ق",1,0],["منَّاعةً للرشف منّاحةً","للطرف إن تُبرِئْكَ تستنكِس",2,"س",1,0],["مناعة نيلها المحب وما","تنفك من صدها على خفف",3,"ف",1,0],["مِن أَعجَبِ الأَخبارِ أَنَّ الأَرنَبا","لَمّا رَأى الديكَ يَسُبُّ الثَعلَبا",4,"ب",2,1],["مَناعيشُ لِلمَولى الضَريكِ وَلا تُرى","عَلى الضَيفِ إِلّا باكِرَ الغَدَواتِ",5,"ت",1,0],["مِن أَعيُنٍ عَلِمَت أَن لا حِجازَ لَهُم","وَلا طَعامَ إِذا ما هَبَّتِ القِرَرُ",6,"ر",1,0],["مَناعيشُ لِلمَولى مَرائيبُ لِلثَأى","مَعاقيرُ في يَومِ الشِتاءِ المُذَكَّرِ",7,"ر",1,0],["مِن أَعجَبِ الأَشياءِ في دَهرِنا","وَاللَهُ لا ناسٍ وَلا والِثُ",8,"ث",1,1],["منّاعةٍ بالحسن أجفانَنا","أن يتقاربن لإطراق",9,"ق",1,0],["من أعان الْهُمُوم والدهرَ وَالبَيْ","نَ على نفسِهِ بحزنٍ وضيقِ",10,"ق",1,1],["مَنْ أَعْلَقَتْهُ لِلجُفُونِ حَبَائِلٌ","مُتَيَّقِنِ أَنْ لَيسَ مِنها مَخْلَصُ",11,"ص",1,1],["مِن أَعيُنٍ بانَت قُلوبٌ لَنا","وَالكُلُّ في الأَجسامِ حَيرانُ",12,"ن",1,0],["مَنِ اعتدى يوماً عليك فاعْتَدي","عليه يا صاحِ بمثلِ ما اعتدى",13,"ا",1,0],["من أعادَ الأيامَ وهيَ عبيدٌ","والليالي مثلَ الإماء الوكع",14,"ع",1,0],["من اعتقاد الغي والنفاق","وننظم القول على اتساق",15,"ق",1,0]]}