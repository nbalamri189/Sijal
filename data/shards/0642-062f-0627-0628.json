ا الموعد","https://www.poetsgate.com/ViewPoem.aspx?id=181953",""],[5956,"شُبّاك الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=181975",""],[5956,"كما الشوق شاء","https://www.poetsgate.com/ViewPoem.aspx?id=182091",""],[5956,"إلى كل بطل مجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202506",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6093,"سعوديون ( الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=176006",""],[6110,"في كاظمة أو ذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=141177",""],[6126,"النَّخْلة","https://www.poetsgate.com/ViewPoem.aspx?id=190002",""],[186,"لغنطوس الكريم مقر عفو له","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55928&r=&rc=191",""],[6300,"الفارس المتجمّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82872&r=&rc=43",""]],"verses":[["قَد آبَ جارَتَها الحَسناءَ قَيَّمُها","رَكضاً وَآبَ إِلَيها الثَكلُ وَالتَلَفُ",0,"ف",1,0],["قَد أَبى اللَهُ أَن نَعيشَ عَلى النا","سِ وَإِن ضاقَتِ الوُجوهَ عِيالا",1,"ل",2,0],["قَدْ أَبْدَعُوا حَتَّى أَرَوْ","نَا جَابِرَ الْعَثَرَاتِ آبَا",2,"ب",2,0],["قد أبعدتني ذنوبي عنك يا أملي","فجهديَ اليومَ أن أُهدي لك المِدَحَا",3,"ح",2,0],["قد أبى بأسها الشديد سوى الفُو","لاذ درعاً لجسمها ولَبُوسا",4,"س",2,0],["قد أبْحَرت شُمُّ الجبال وأجبلتْ","لُجّج البحار ونحن لم نتبّدل",5,"ل",1,0],["قد ابيضَ وجه العيد لكنّ بؤسهم","رمى نُكَتاً سوداً به فهو أبقع",6,"ع",1,0],["قد ابتسمت وجوه الدهر بيضاً","لهم ورأيننا فعبسن سودا",7,"د",2,0],["قد أبت هذه السياسة إلاّ","أن تكون الغشّاشة الدسّاسه",8,"س",2,0],["قَد أَبرَزَ اللَهُ قَولاً فَوقَ قَولِهِمِ","كَما النُجومُ تَعالى فَوقَها القَمَرُ",9,"ر",1,0],["قد أبرم اللّه أسبابَ الأمورِ معاً","فلن ترى سبباً منْهنَّ منتكثا",10,"ث",2,0],["قد أبى الله أن تكون فقيدي","وأبى الله أن أكونَ فقيدَكْ",11,"ك",1,0],["قَدَ أَبقى لَكِ الأَينُ مِن جِسمِهِ","نَواشِرَ سيدٍ وَوَجهاً صَبيحا",12,"ح",2,0],["قد ابى الجسم تفارقه الرو","ح فقالت لا تخشين فراقي",13,"ق",2,0],["قد ابت لكن كيف ابت","وما نصيبك من ايابك",14,"ك",1,0],["قَد أُبتُ بِالحاجَةِ مَقضِيَّةً","وَعِفتُ في الجَلسَةِ تَطويلَها",15,"ه",2,1],["قَد أَبدَأَت قُطُفاً في المَشيِ مُنشَزَةَ ال","أَكتافِ تَنكُبُها الحِزّانُ وَالأَكَمُ",16,"م",1,0],["قَد أَبلَغَ الوَحيُ عَنهُ قَبلَ بِعثَتِهِ","مَسامِعَ الرُسلِ قَولاً غَيرَ مُنكَتِمِ",17,"م",1,0],["قَد أَبَحناهُ فَطابَ لَنا","وَحَوَينا مِنهُ إِنهابا",18,"ب",2,0],["قَدَّ اِبنَ بازٍ وَصَنيعَ بازِ","نِعمَ الخَليلُ ساعَةَ الإِعوازِ",19,"ز",1,0],["قَد أَبَت نَفسُهُ سِواكِ وَتَأبَي","نَ سِواهُ بِالصَرمِ وَالتَعذيبِ",20,"ب",1,0],["قَد أُبرِمَت هَذِهِ الأَجزاعُ لا سَأَماً","بِالزائِرينَ وَلَكِن طِبنَ عَن بَرَمِ",21,"م",1,0],["قَد أَباحَت جَمعَهُ أَسيافُنا ال","بيضُ وَالسُمرُ وَمِن حَيٍّ حِلالِ",22,"ل",1,0],["قد أبى الشعر أن يعيش مهانا","بعد عز أو أن يكون جبانا",23,"ن",2,1],["قَد أَبَت غيرَتي بِأَن فُؤادي","يَصطَفي من بِغَير طَرفي يشام",24,"م",1,1],["قد ابرز القبح بشكل حسن","فكل طاوس طويس المدني",25,"ن",2,0],["قد ابرزوا من طي غلغلة العما","مذ قلت كونوا يا عظيم فكانوا",26,"ن",3,0],["قد اباح الحظ بالالطاف لي","كل سر في خبايا لعلع",27,"ع",1,1],["قد أبهج الدينَ والدنيا مقامُكُمُ","وكُيفَ لا وَهوَ عند اللَهِ محمودُ",28,"د",1,0],["قد أبكروا لحظهم من نظرةٍ","منك ومن لثم الثرى المعتبِر",29,"ر",1,0],["قد أبرز الابريز من مرقومه","في طرزها محاسناً لا تستتر",30,"ر",1,0],["قَد اِبتَدَأَت أَوائِلُهُ بِخَيرٍ","وَنالَ مُؤرّخاً بِالخَيرِ ختما",31,"م",2,0],["قَد أَبى لي خِضابَ شَيبي فُؤاد","فِيه وَجدٌ بِكَتمِ سِرّي وَلُوعُ",32,"ع",1,1],["قد ابيضَّ وجهُ الدهرِ حين انتشى به","وصار منيراً بعدَ ما كانَ أسودا",33,"د",2,0],["قَد أُبدِيَت عَوراتُها لَكُم وَما","أَنتُم مَحارِمُها وَلا أَصهارُها",34,"ر",3,0],["قد أبهجتكَ بنورِها وصباها","أيامُ صيفٍ لا يطيبُ سِواها",35,"ا",3,1],["قَدْ أبْطَلَ الحَقُّ ما قالوهُ بُهْتانا","وَهَدَّمَ العَدْلُ ما شادُوهُ بُنْيانا",36,"ن",2,0],["قد أبلغوا النفسَ عذراً في مصارِعهم","وَمبلغٌ نفسَه عذراً كَمَنْ سلما",37,"م",2,0],["قد ابتليت وبَلَوْتُ أمْرَها","فلا أبالي بعدها بما أتى",38,"ا",1,0],["قد أبدعتها بلا شبيه","العبقريات لا المران",39,"ن",1,0],["قد أباح التعذيب شرعا","فإن قلت ضحاياه زادنا لهفه",40,"ف",2,0],["قد أبْصَرَ الزَّمانُ عَلْوى وَغَفا","جَهْلاً بِعَلْوى فَعَلى الدُّنيا العَفا",41,"ف",2,1],["قدِ ابتلَّ طرفُ المجدِ والجودِ والعُلاَ","وما ابتلَّ حتَّى صار يضحَكُ عَاليا",42,"ي",2,0],["قَد أَبرَزَتهُ قَريحَةُ سَيّالَةٍ","تَزري بِصَوبِ المُزنِ في تَهتانِهِ",43,"ن",2,0],["قد اِبتَهَجت وسُرّت ثمّ طابت","وَمَنهلها غدا حلوَ المذاقِ",44,"ق",1,0],["قدِ اِبتهج القضاء وزاد فخراً","غداةَ جَلستَ في دست القضاءِ",45,"ا",2,0],["قد ابتسمت دارُ المدوَّرِ حينما","أَتى قيصرٌ أَكرِم بقيصرَ من نجلِ",46,"ل",1,1],["قد ابتلت العصبة المسلمين","فلم تلق معتبةً قاسيه",47,"ي",2,0],["قد أبان الحق مبعثه","حيث ظل الشرك عنه جلا",48,"ل",2,0],["قد أبدعت أهزال أشعاره","في العالم السحر الحلال المبين",49,"ن",1,0],["قد أبطل الشجعَان في الوقت الذي","أمواجه تزري على التيارِ",50,"ر",1,0],["قَد أَبهَجوهُ بِتاريخٍ فَقالَ لَهُم","أَهلاً بِكُم قَد أَتيتُم مُربعاً رَحبا",51,"ب",2,0],["قَدْ أبدلَ اللهُ منكم خَيْرَ ذي كَلَعٍ","واليَحْصُبِيِّنَ أَهْلَ الحَقّ في الجَنَدِ",52,"د",1,0],["قد أبدعتها الأولون روابطاً","لصيان نثر جواهر الحكماء",53,"ا",2,0],["قد ابتنى مجلساً سامي المقام لهُ","يسعى الذي يبتغي وعظاً وتنذيرا",54,"ر",2,0],["قَدْ أَبى التَّبريحُ أَنْ يَبْرَحا","فاحسُرِ التَّعنيفَ أَو فاسْرَحَا",55,"ح",2,1],["قد أبانت سطوره لك حرفا","في سويداك قد بدا مرقوما",56,"م",2,0],["قد ابعدتني عن الألاف أزمنة","عدت علينا فوا شوقي لألافي",57,"ف",2,0],["قد أبرزتْ بدرتم في مجاسدها","وهزهزتْ غصن بان فوق دعص نقا",58,"ق",2,0],["قد أبى الضَّيم للبلاد وأذكى","جذوة الجهد طارقاً كلَّ بابِ",59,"ب",1,0],["قد أبانت حشايَ فاستهدفيها","نكبة طوَّحت ضحًى بأبان",60,"ن",1,0],["قد أبت تلكُم الخلائقُ حتَّى","للعِدى أن تكون إلاَّ عذابا",61,"ب",2,0],["قد أبات القومَ في غيظهم","يتجافون على الجمر جنوبا",62,"ب",2,0],["قد أبعد الطيف عني","لما صبوت إليه",63,"ي",2,0],["قد أبدعَ الرحمنُ صورة خلقه","ليَرى جميلَ الصنع فيها الناظِرُ",64,"ر",1,0],["قد ابتسمت ثناياه لبرق","له انتحبت سحائبه رعودا",65,"د",2,0],["قد أبصرت عندهُ الدنيا تغابُنها","نالت طلاقاً ولم يصرف لها نظرَه",66,"ر",2,0],["قد أبرزتْ أسلاكَ دُرِّ بلاغةٍ","تُزْري فريدَ جواهرِ الأَسْلاكِ",67,"ك",1,0],["قد أبدلوا الود في القربى ببغضهم","كأنما ودهم في الذكر بغضاء",68,"ا",2,0],["قد أبحنا لثمها فمه","عليه في سابق القدمِ",69,"م",1,0],["قد أبرزته معنى حقيقاً","إليه ما اهتدى قبل الكرامُ",70,"م",1,1],["قد أبصرت قبل أن تقضي منازِلها","في الخُلد لمَّا بدَت حُسنى بصائرها",71,"ر",3,0],["قَد أَبهظوا الشَعب حَتّى ناءَ كاهله","وَأَحرَجوه وَلَكن أَيّ إِحراج",72,"ج",1,0],["قد ابتسمت بيروت لما حللتها","بلألاء وجه قد حكى طلعة البدر",73,"ر",1,0],["قد ابتنى امس في الاسبان منزلة","فانهار في غده ما قد بنى الباني",74,"ن",2,0],["قد ابت والامال فيك تحققت","ولنا بمقدمك استبان المهيع",75,"ع",1,0],["قد أبت في النقصان فابشر بالقنا","كذاك في نقصانه يزيد",76,"د",1,0],["قد أبتدعت صنعها آثار ذي همم","ما النجم في سلكها الساعي بنسلك",77,"ك",1,0],["قد أبعد البؤس عني كل غانية","كما يصد الهدى عن كل زنديق",78,"ق",1,0],["قد إبتُ للحقّ ونعمَ الأوبَه","وتبتُ من ذنبي قهل من توبه",79,"ه",1,0],["قد ابتدعتها فرقة تبتغي بها","لدى اللّه أمرا حاز أصحابهُ الفضلا",80,"ل",2,0],["قَدْ أبرزَ اللهُ للدنيا حقيقتَه","أن كَانَ بالدِّين صَدْعٌ غيرُ مؤتلِف",81,"ف",1,0],["قد ابتسمت بعد التعبس مذ رأت","أرومة زاكي الأصل فرع الأكارم",82,"م",1,0],["قد ابدع العدل في شرعٍ سما فنما","واينع الفضل فرعاً في حماهُ حمي",83,"م",2,0],["قد ابتكروا واستقلت بهم","قلائص مشدودة الأنسع",84,"ع",1,0],["قد أبى أن ينثنى بكم","أوبة يحيى بها الأمل",85,"ل",1,0],["قَد ابعَدتَني عَن الاِوطانِ مُندَحِراً","مَطامِعٌ اِورَثَتني وَيلها كَدراً",86,"ر",2,0],["قد ابى الخسف أشم الانف لم","يخش ذا الجند وان كان وحيدا",87,"د",2,0],["قد أبى النزع عن الغرة أو","يغتدي في نزعه زيدٌ شهيدا",87,"د",2,0],["قد أبى الدهر أن تفوز دمى مص","رَ بشعري من دون باقي الغواني",88,"ن",2,0],["قد ابدعت ورد الصبى وجناتها","أَوموا الى ورد الربى ان يخجلا",89,"ل",2,0],["قد ابتكر العنق الغرير جماله","فزاد على حسن الطُلى في الظبا حسنا",90,"ن",2,0],["قَد اِبتَدأتني مِنهُ قَبلَ لِقائِهِ","مَكارم فَياض اللهى خَير سابق",91,"ق",1,0],["قد أَبصَرَ الأَعمى وأُذنُ الصُمّ قد","سَمِعَت بمُعجِزِهِ وفاهَ الأَبكَمُ",92,"م",1,0],["قَدِ ابْيَضَّتْ بِهِ عَيْنِي","وَلِلمَهْجورِ أَنْ يَحْزَن",93,"ن",1,0],["قَد أَبدَعَت صَبغَ وَشيٍ مِن مَطارِفِها","في حُمرَةٍ عَجَبٍ في فِتنَةٍ ذَهَبِ",94,"ب",1,0],["قَد ابدلت هيآته حَتّى لَقَد","آلت إِلىمستقبح هيآته",95,"ت",2,0],["قد أبصرته مقلتي ميتا","دون الحصون اخترمته القنا",96,"ن",2,0],["قد أبعد الأحرارَ عن دارهم","وقَرَّبَ الأَنذالَ من حضرته",97,"ت",2,0],["قد ابتسمت فلاح نظيم در","سما قدراً على الدر النضيد",98,"د",1,0],["قد أبت من دار السعادة مرحباً","بك مرحباً قد حلت البركات",99,"ت",1,0],["قد ابيضَّ حظِّي في ذَراهُ وإنّني","مُسَوَّدُ مجدٍ حظّه غيرُ مُسَوَدِّ",100,"د",1,0],["قَد أبصروا العَمل المثفّن مشفياً","فَاِستَمطَروا الأوهامَ غيث نضارِ",101,"ر",1,0],["قد أبدلوني عنهم بمعاشر","لم يرج فيهم للنزيل ذمام",102,"م",1,0],["قَد أَبْطَلَتْ إِذ أَطَلَّتْ كُلَّ تُرَّهَةٍ","فَأَجْفَلُوا هَرَبَاً في كُلِّ مَهْمَهَةٍ",103,"ه",1,0],["قَد أَبعَدوا في التمَنِّي","وَأرغبوا في العَطِيَّهْ",104,"ي",2,0],["قد أبت ألحاظه إلا الكفاح","وأبت أعطافه إلا النزق",105,"ق",1,0],["قد أبى الهجر أن يتم","مَ لعيني سُرورها",106,"ر",3,0],["قَد اِبتَلى اللَهُ بِخَيرٍ خَلقَهُ","أَلقى إِليَّ خَيرِ قُرَيشٍ وَسقَهُ",107,"ق",2,0],["قد آب للزوراء بعد غيابهِ","قمرٌ أعاد لها السنا بإيابهِ",108,"ب",2,1],["قد ابتسمت فإن نظيمُ دُرٍّ","سما قدراً على الدرِّ النضيد",109,"د",1,0],["قد أبَّد الله لهم مناقباً","في الدهر ما دام البقا بقاؤها",110,"ا",3,0],["قد أبان الشرع في أحكامه","وقضى الدهر صلات وصلاة",111,"ه",1,0],["قد أبصرت عيني العجائب كلّها","ما أبصرت مثل ابن نصر أبخرا",112,"ر",2,1],["قد ابتهجت جوارحنا بنجلٍ","بديع الحسن فاز به السليمُ",113,"م",1,1],["قد ابيضت فلا زاداً لطاوٍ","ولا صادٍ رأى فيها شرابا",114,"ب",2,0],["قد أبدع الرحمانُ صورتَك التي","تبدو بعيني مثلَ وجه ملاك",115,"ك",1,0],["قد أبصروا منه مقاماً هائلاً","تجري إليه بالحمى مدحارُ",116,"ر",1,0],["قَدِ ابتَهجَ الفُؤادُ هنَا ابتِسَامَا","فَسِحْرُكِ فِي رؤى النَّجوَى تَسَامَى",117,"م",2,1],["قد أبصرتها عين (صبٍ آثمٍ)","فتراجعت تخفي لواحظ فاترِ",118,"ر",1,0],["قد ابلسَ مَن أوهى جفناً","يَرمقُهُ شزراً اثمدُهُ",119,"د",2,0],["قَد أَبْدَعَتْهُ يَدُ الرَّحْمَنِ، سَارَ بِهَا","لِلْعَالَمِيْنَ وَنِبْرَاسًا لِمَنْ فَهِمَا"