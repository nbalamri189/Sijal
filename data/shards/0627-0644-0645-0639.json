{"poems":[[55,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[95,"يا أمير القلوب يحفظك الله","https://www.aldiwan.net/poem9826.html","عموديه"],[95,"يا ليل أبدعت نظام الحلى","https://www.aldiwan.net/poem9846.html","السريع"],[90,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[74,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[74,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[74,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[31,"ألم على عنبات العجوز","https://www.aldiwan.net/poem6218.html","المتقارب"],[93,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[91,"أين القصيد التي أبياتها خزف","https://www.aldiwan.net/poem44782.html","البسيط"],[87,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[87,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[87,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[47,"ألمع برق سرى أم ضوء مصباح","https://www.aldiwan.net/poem62689.html","البسيط"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202699","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54661","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55210","السريع"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[105,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[92,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[112,"أترى أين حل أم أين أمسى","https://www.aldiwan.net/poem16243.html","الخفيف"],[130,"ليس لشيء غير تقوى جداء","https://www.aldiwan.net/poem24259.html","السريع"],[213,"يا بريقاً بالحمى قد لمعا","https://www.aldiwan.net/poem13314.html","الرمل"],[300,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[334,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[419,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[432,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[455,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[460,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[460,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[460,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[463,"يبذل المال فان حل به","https://www.aldiwan.net/poem15666.html","الرمل"],[502,"لله موقفنا بأم عبيدة","https://www.aldiwan.net/poem38028.html","الكامل"],[516,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[540,"ما لمراكش تفيض سرورا","https://www.aldiwan.net/poem48173.html","عموديه"],[577,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"]],"verses":[["المَعازيلُ كِرامٌ عِندَهُ","وَالمَناجيبُ كَمَلفوظِ العَجَم",0,"م",1,0],["أَلمَعَ بَرقٍ أَم ضَرَم","بَينَ الحِرارِ وَالعَلَم",1,"م",1,1],["أَلْمَعِيٌّ تُزْجَى القَوَافِي إِلَيْهِ","خَاشِعَاتٍ لَدَى الْمُقَامِ الْمَهِيبِ",2,"ب",1,0],["المعتلي عن دهره قدره","وفكره عن قدره معتل",3,"ل",1,0],["ألمعيّ تبوّع المجد حتى","حاز منه قريبه والبعيدا",4,"د",2,0],["المعربون بألفاظٍ ولحن ظبا","ناهيك من عربٍ في الخلق عرباء",5,"ا",2,0],["المعرقين سماحةً وحماسةً","يوم الفخار دُعوا ويوم المفزع",6,"ع",1,0],["المعرقين مناسباً ومكارماً","تدري بها الأوصاف كيف تجول",7,"ل",1,0],["المعتلي رتباً يشيب لعجزه","عن قدرها الأعلى عذار هلال",8,"ل",1,0],["ألمَعِيٌّ يرى بأولِ ظنٍّ","آخرَ الأمر من وراء المغيبِ",9,"ب",1,0],["ألْمَعِيٌّ مُوَفَّقٌ بهدى اللَّ","ه لدى الخُطَّةِ العَياء العَقام",10,"م",1,0],["أَلَمَّ عَلى عِنَباتِ العَجوزِ","وَحُسوَتِها مِن غِياثٍ لَمَم",11,"م",1,1],["المُعرِضينَ عَنِ الخَنا فَإِذا عَلا","صَوتٌ يَقولُ إِلى المَكارِمِ أَقدَموا",12,"م",3,0],["أَلمَعِيُّ الذِهنِ وَالقَلبِ الكَبير","مَلَكٌ في بُردَتَيهِ ضَيغَمُ",13,"م",1,0],["المعت للسيف في شعري وليس لنا","بل نحن كالشاء لا ناب ولا ظفر",14,"ر",1,0],["أَلَمَّ عُصفورٌ بِمَجرىً صافِ","قَد غابَ تَحتَ الغابِ في الأَلفافِ",15,"ف",1,1],["المُعرِضينَ عَنِ الصَغا","ئِرِ وَالسِعايَةِ وَالنَميمِ",16,"م",1,0],["المُعرِضينَ وَلَو بِساحَةِ يَلدِزٍ","في الحَربِ عَن عِرضِ العَدُوِّ وَمالِهِ",17,"ل",2,0],["المَعهَدُ القُدسِيُّ كانَ نَدِيُّهُ","قُطباً لِدائِرَةِ البِلادِ وَمِحوَرا",18,"ر",2,0],["أَلَمعُ بَرقٍ سَرى أَم ضَوءُ مِصباحِ","أَمِ اِبتِسامَتُها بِالمَنظَرِ الضاحي",19,"ح",2,1],["المُعلِنينَ تُقى الإِلَهِ وَخَوفَهُ","وَالمُؤثِرينَ نَصيحَةَ السُلطانِ",20,"ن",1,0],["أَلْمَعِيٌّ لَهُ بَدِيهَةُ رَأْيٍ","تُدْرِكُ الْغَيْبَ مِنْ وَرَاءِ لِثَامِ",21,"م",1,0],["المَعالي وَلا كرزء المَعالي","فقدت غرة لها وَحجولا",22,"ل",2,0],["ألم على ابيات ليلى بى الهوى","وما غير أبياتي دليل ولا ركب",23,"ب",1,0],["المُعْجِلِين عِداتَهُمْ بِرماحِهِمْ","والجاعِلِين الْهَام مِن تِيجانِهَا",24,"ن",3,0],["أَلَمعِيٌّ مُهَذَّبُ الحِسِّ وَالمَعْ","نَى رَجِيحُ الحِجَى رَقِيقُ الخِيْمِ",25,"م",1,0],["الْمُعْجَمَاتُ مِنَ الْمَزَاهِرِ","قَبْلَ لَمْسِكِ مَا أَبَانَتْ",26,"ت",1,0],["المُعْتَلِي عَنْ دَهْرِهِ قَدْرُهُ","وَفِكْرُهُ عَنْ قَدْرِهِ مُعْتَلِي",27,"ل",2,0],["المعاني بدونه شارداتٌ","شاكياتٌ مرارةَ التشريد",28,"د",1,0],["المعهد الفرد الذي بجهاده","بلغت بلاد الضاد أعراف الذُّرَى",29,"ر",2,0],["المُعوِلاتُ عليك غُرُّ مكارمٍ","قامت عليها رنّةٌ وعويل",30,"ل",1,0],["المَعي يَكاد يخبر عَما","في غَدٍ لِلملا ذَكاءً وَحَدسا",31,"س",2,0],["المُعطي الجُردِ بِأَرسانِها","وَالناعِجاتِ المُسرِعاتِ النَجاء",32,"ا",2,0],["المعيّ كاد يقضي بالذي","لم يكن قبل عليه اطلعا",33,"ع",2,0],["المعلِنُ الحقَّ بلا خَشيَةٍ","حَيثُ خَطيبُ القوم لا يَنبِسُ",34,"س",1,0],["المُعَجّلُ القَوْمِ أَنْ تَغلي مَرَاجِلُهُمْ","قَبْلَ الصَّبَاحِ وَلَمّا يُمْسَحِ البَصَرُ",35,"ر",1,0],["أَلمعيٌّ ناظرٌ في بَصَرٍ","في خوافي غامضِ الأَمر حديد",36,"د",1,0],["المعيّ أخو الذكاءِ أديب","لوذعيٌّ بل فاضلٌ علّامه",37,"م",2,0],["ألمعيّ الإيقاع في كل ما تحكي","غناء وإن يكن جد ناعم",38,"م",1,0],["ألمعيّاً لا يبالي عزّةً","وهو طفلٌ أيّ عمريه اكتملْ",39,"ل",1,0],["أَلمعيَّاً رأَى بعينِ ابنِ ليلٍ","خافياً من مَحاسني مستسِرَّا",40,"ر",2,0],["أَلْمعِياً سوّدته نفسُهُ","والمساعي قبلَ تسويدِ الشعوبِ",41,"ب",1,0],["المَعالي خلَصتْ مُلْكاً لهُ","وهي في خُلْقِ سِواهُ قُلَعَهْ",42,"ع",2,0],["المُعْرِقُ الشَّرَفِ الصَّميمِ الوارِثُ ال","خُلُقِ العَظيمِ مقَرِّبُ المُسْتَبْعِدِ",43,"د",1,0],["ألمعيٌّ يُبري النفوسَ المَعاني","بجُسومٍ من لؤلؤٍ مَنضودِ",44,"د",1,0],["ألمَعِيًّا سَمَيدَعاً لَوذَعيًّا","وأديباً وعالِماً نِحريرا",45,"ر",2,0],["المعْتَلِي فوقَ السماءِ بِهمَّةٍ","لم ترضَ إِلاَّ والكواكبُ صَحْبُها",46,"ب",3,0]]}