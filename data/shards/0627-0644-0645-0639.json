em.aspx?id=202649",""],[5358,"كم حلوةٍ تلهو","https://www.poetsgate.com/ViewPoem.aspx?id=187054",""],[5431,"الانسان العربي..._وجعا يزلزل ذي العروش وراءه_","https://www.poetsgate.com/ViewPoem.aspx?id=194837",""],[709,"شرّفِ الوجهَ في رابِ زرودِ","https://www.poetsgate.com/ViewPoem.aspx?id=2910",""],[5461,"لا تملين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=5023",""],[5606,"مرفوع العتب","https://www.poetsgate.com/ViewPoem.aspx?id=194453",""],[5739,"المجره ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127066",""],[5792,"يا ظالمة","https://www.poetsgate.com/ViewPoem.aspx?id=180335",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"الكِذْبُ في قلبي وقلبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192187",""],[5956,"حالُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=192358",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5956,"هذي الحياة مشقة ومشاكلُ","https://www.poetsgate.com/ViewPoem.aspx?id=203755",""],[6032,"جفّ اليراعُ","https://www.poetsgate.com/ViewPoem.aspx?id=181527",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6190,"أتيتُ سهواً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87002&r=&rc=8",""],[6201,"تشكّلٌ أولي لزهرة ..على شاهد قبر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87488&r=&rc=12",""],[6345,"جف اليراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78678&r=&rc=49",""]],"verses":[["المَعازيلُ كِرامٌ عِندَهُ","وَالمَناجيبُ كَمَلفوظِ العَجَم",0,"م",1,0],["أَلمَعَ بَرقٍ أَم ضَرَم","بَينَ الحِرارِ وَالعَلَم",1,"م",1,1],["أَلْمَعِيٌّ تُزْجَى القَوَافِي إِلَيْهِ","خَاشِعَاتٍ لَدَى الْمُقَامِ الْمَهِيبِ",2,"ب",1,0],["المعتلي عن دهره قدره","وفكره عن قدره معتل",3,"ل",1,0],["ألمعيّ تبوّع المجد حتى","حاز منه قريبه والبعيدا",4,"د",2,0],["المعربون بألفاظٍ ولحن ظبا","ناهيك من عربٍ في الخلق عرباء",5,"ا",2,0],["المعرقين سماحةً وحماسةً","يوم الفخار دُعوا ويوم المفزع",6,"ع",1,0],["المعرقين مناسباً ومكارماً","تدري بها الأوصاف كيف تجول",7,"ل",1,0],["المعتلي رتباً يشيب لعجزه","عن قدرها الأعلى عذار هلال",8,"ل",1,0],["ألمَعِيٌّ يرى بأولِ ظنٍّ","آخرَ الأمر من وراء المغيبِ",9,"ب",1,0],["ألْمَعِيٌّ مُوَفَّقٌ بهدى اللَّ","ه لدى الخُطَّةِ العَياء العَقام",10,"م",1,0],["أَلَمَّ عَلى عِنَباتِ العَجوزِ","وَحُسوَتِها مِن غِياثٍ لَمَم",11,"م",1,1],["المُعرِضينَ عَنِ الخَنا فَإِذا عَلا","صَوتٌ يَقولُ إِلى المَكارِمِ أَقدَموا",12,"م",3,0],["أَلمَعِيُّ الذِهنِ وَالقَلبِ الكَبير","مَلَكٌ في بُردَتَيهِ ضَيغَمُ",13,"م",1,0],["المعت للسيف في شعري وليس لنا","بل نحن كالشاء لا ناب ولا ظفر",14,"ر",1,0],["أَلَمَّ عُصفورٌ بِمَجرىً صافِ","قَد غابَ تَحتَ الغابِ في الأَلفافِ",15,"ف",1,1],["المُعرِضينَ عَنِ الصَغا","ئِرِ وَالسِعايَةِ وَالنَميمِ",16,"م",1,0],["المُعرِضينَ وَلَو بِساحَةِ يَلدِزٍ","في الحَربِ عَن عِرضِ العَدُوِّ وَمالِهِ",17,"ل",2,0],["المَعهَدُ القُدسِيُّ كانَ نَدِيُّهُ","قُطباً لِدائِرَةِ البِلادِ وَمِحوَرا",18,"ر",2,0],["أَلَمعُ بَرقٍ سَرى أَم ضَوءُ مِصباحِ","أَمِ اِبتِسامَتُها بِالمَنظَرِ الضاحي",19,"ح",2,1],["المُعلِنينَ تُقى الإِلَهِ وَخَوفَهُ","وَالمُؤثِرينَ نَصيحَةَ السُلطانِ",20,"ن",1,0],["أَلْمَعِيٌّ لَهُ بَدِيهَةُ رَأْيٍ","تُدْرِكُ الْغَيْبَ مِنْ وَرَاءِ لِثَامِ",21,"م",1,0],["المَعالي وَلا كرزء المَعالي","فقدت غرة لها وَحجولا",22,"ل",2,0],["ألم على ابيات ليلى بى الهوى","وما غير أبياتي دليل ولا ركب",23,"ب",1,0],["المُعْجِلِين عِداتَهُمْ بِرماحِهِمْ","والجاعِلِين الْهَام مِن تِيجانِهَا",24,"ن",3,0],["أَلَمعِيٌّ مُهَذَّبُ الحِسِّ وَالمَعْ","نَى رَجِيحُ الحِجَى رَقِيقُ الخِيْمِ",25,"م",1,0],["الْمُعْجَمَاتُ مِنَ الْمَزَاهِرِ","قَبْلَ لَمْسِكِ مَا أَبَانَتْ",26,"ت",1,0],["المُعْتَلِي عَنْ دَهْرِهِ قَدْرُهُ","وَفِكْرُهُ عَنْ قَدْرِهِ مُعْتَلِي",27,"ل",2,0],["المعاني بدونه شارداتٌ","شاكياتٌ مرارةَ التشريد",28,"د",1,0],["المعهد الفرد الذي بجهاده","بلغت بلاد الضاد أعراف الذُّرَى",29,"ر",2,0],["المُعوِلاتُ عليك غُرُّ مكارمٍ","قامت عليها رنّةٌ وعويل",30,"ل",1,0],["المَعي يَكاد يخبر عَما","في غَدٍ لِلملا ذَكاءً وَحَدسا",31,"س",2,0],["المُعطي الجُردِ بِأَرسانِها","وَالناعِجاتِ المُسرِعاتِ النَجاء",32,"ا",2,0],["المعيّ كاد يقضي بالذي","لم يكن قبل عليه اطلعا",33,"ع",2,0],["المعلِنُ الحقَّ بلا خَشيَةٍ","حَيثُ خَطيبُ القوم لا يَنبِسُ",34,"س",1,0],["المُعَجّلُ القَوْمِ أَنْ تَغلي مَرَاجِلُهُمْ","قَبْلَ الصَّبَاحِ وَلَمّا يُمْسَحِ البَصَرُ",35,"ر",1,0],["أَلمعيٌّ ناظرٌ في بَصَرٍ","في خوافي غامضِ الأَمر حديد",36,"د",1,0],["المعيّ أخو الذكاءِ أديب","لوذعيٌّ بل فاضلٌ علّامه",37,"م",2,0],["ألمعيّ الإيقاع في كل ما تحكي","غناء وإن يكن جد ناعم",38,"م",1,0],["ألمعيّاً لا يبالي عزّةً","وهو طفلٌ أيّ عمريه اكتملْ",39,"ل",1,0],["أَلمعيَّاً رأَى بعينِ ابنِ ليلٍ","خافياً من مَحاسني مستسِرَّا",40,"ر",2,0],["أَلْمعِياً سوّدته نفسُهُ","والمساعي قبلَ تسويدِ الشعوبِ",41,"ب",1,0],["المَعالي خلَصتْ مُلْكاً لهُ","وهي في خُلْقِ سِواهُ قُلَعَهْ",42,"ع",2,0],["المُعْرِقُ الشَّرَفِ الصَّميمِ الوارِثُ ال","خُلُقِ العَظيمِ مقَرِّبُ المُسْتَبْعِدِ",43,"د",1,0],["ألمعيٌّ يُبري النفوسَ المَعاني","بجُسومٍ من لؤلؤٍ مَنضودِ",44,"د",1,0],["ألمَعِيًّا سَمَيدَعاً لَوذَعيًّا","وأديباً وعالِماً نِحريرا",45,"ر",2,0],["المعْتَلِي فوقَ السماءِ بِهمَّةٍ","لم ترضَ إِلاَّ والكواكبُ صَحْبُها",46,"ب",3,0],["أَلمَعِيٌّ فاضلٌ يمحو الدُّجَى","مثلَ بدرٍ لاح جنح الغَلَسِ",47,"س",1,0],["المُعجِزُ الباقي وَإِن طالَ المَدى","وَلأبلغِ البلغاءِ فَهوَ المُفحِمُ",48,"م",1,0],["المعتلي بالله والمَلِكُ الذي","تاجُ الفَخَارِ برأسهِ معصوب",49,"ب",1,0],["المُعرِبُ اللَّسِنُ الغَريبُ بَلاغَةً","سِحر البيانِ خِلالها يَتَلامَحُ",50,"ح",1,0],["أَلمَعِيٌّ وَجَهبَذٌ لَوذَعيّ","أَوحَدِيّ ما إِنْ لهُ الدّهرَ ثانِ",51,"ن",1,0],["المُعربِ القَول فاضَت عَينُ حِكمَتِهِ","سِحرُ البَيانِ يُجافي اللّحنَ بِاللّحنِ",52,"ن",1,0],["ألمعيٌّ مهذَّبٌ أريحيٌّ","فهو اللوذَعيُّ والى الإمام",53,"م",1,0],["المُعتلِينَ خيولَهُمْ","وَالمُوسِعِينَ لهَا المَجَالا",54,"ل",2,0],["المعنَ يقصُرنَ من بُختٍ مُخيَّسَةٍ","ومن عرابٍ بعيداتٍ من الحادي",55,"د",2,0],["ألمعيُ يرى الأمور بعقلٍ","لا يراه ذوو الحجا والأناةِ",56,"ه",1,0],["ألمْعُ بُروقٍ أم بَريق المباسم","وتلك دموعي أم دموع الغمائم",57,"م",1,1],["المعي الأراء متقد الفط","نة من طينة الندى مجبولُ",58,"ل",1,0],["المعيّ باهر باهي السنا","لوذعيّ فاق في بذل وجود",59,"د",1,0],["أَلمعِيٌّ يَجِلُّ عَنْ هَذَيانٍ","حَيْثُ عَمَّ السَّنا وتَمَّ السَّناءُ",60,"ا",2,0],["أَلَمَّ عَلى رَغمِ الرَقيبِ وَدوننا","عَلى عَدَوانِ الدَهر بِيدٌ فَدافِدُ",61,"د",1,0],["ألمعيٌّ بغوره سبر الده","رَ وما كانَ غورُه مسبورا",62,"ر",2,0],["المَعاني تحت خفضي","تحت رَفعي تحت نصيبي",63,"ي",1,0],["المعتني بعبيده وعديده","مثل اعتناء الليث بالأشبال",64,"ل",1,0],["المُعلَّى منَ القِداح وذو الأَثْر","المُحَلَّى بين المواضي الرقاق",65,"ق",1,0],["ألمعيٌّ والقضايا شُبَهٌ","أوْحَدِيٌّ وصروفُ الدهر حُد",66,"د",1,0],["المعيٌّ فات ابن سينا بفضل","لسنا نوره لنا لمعات",67,"ت",1,0],["المعالي والمال والمجد الفا","ظٌ عوارٍ مما لها من معاني",68,"ن",2,0],["ألمعيٌّ أسمى علاه أبو بك","ر فطالت وشادها أيّوبُ",69,"ب",1,0],["ألمعيٌّ تراه إن أعمل الفك","رة تلقى الأغراض منها سهاما",70,"م",2,0],["المعرضين لماذا أعْرضُوا وجفَوا","والهاجرين عقيب الوصلِ لَم هَجروا",71,"ر",3,0],["المعي ما خانه قط رايٌ","بمجالي الاصدار والايراد",72,"د",1,0],["المعادي ، أو نفحة من هواها","يودع القلب فى شذاها الأنينا",73,"ن",2,0],["المعادي فقد تركت فؤادى","فى رباه مشرداً مجنونا",73,"ن",2,0],["ألمعي الذكا أياسي فكر","بحتري الآيات نظما ونثرا",74,"ر",2,0],["المعنى يقول في هوى سامي القوام","قد تحملت ما لا أطيقه",75,"ق",2,0],["المعتلي بالدين لا بالأمم","أدين دين المصطفى المكرم",76,"م",1,0],["المعاني تجيئني سافرات","ليت عند الحسان ذوق المعاني",77,"ن",2,0],["ألمعيٌّ له ثواقب فكر","تستمد الأنوار منها النجوم",78,"م",1,0],["أَلمَعِىٌ كأَنَّه يَتعاطى","بصَوابِ الظنونِ عِلْمَ الغُيوبِ",79,"ب",1,0],["المعيد الزمان جيلًا فجيلا","وهو في ضحوة من العمر أضحى",80,"ح",2,0],["ألمع بارقة أم وهج نبراسِ","أم الحبيب تجلَّى بعد اغلاسِ",81,"س",1,1],["المعرق النسب الشريف المنتقى","من آل فاطمة البتول وحيدر",82,"ر",1,0],["المُعتلي شَرَفَ العُلا بِبيانِهِ","المُجتَلي سِرَّ القَضا بِعِيانِهِ",83,"ن",2,0],["ألمعي يكاد ينبيْك عمّا","كان في الغيب فطنة وذكاء",84,"ا",2,0],["المعالي لسواكم صبعة","وإذا متت لكم فهي ذلول",85,"ل",1,0],["أَلمعيّاً هواه عندي على","البُعْد مُوَلّىً على فؤادي المُوَلَّه",86,"ل",2,0],["المعجز اللسن في يوم المقال بما","يبديه من حكم الامثال والخطب",87,"ب",1,0],["المعٌ من دأبهِ فعل الجميل","كل معنىً رائقٍ فيهِ انحصَر",88,"ر",1,0],["المعالي ارتداؤُهُ فَلَهُ اللَّ","هُ نصيرٌ وبِالفَخَارِ اتِّشاحُه",89,"ح",2,0],["ألمعي ما أتى من عملٍ","قبل أن أدرك حسن العملِ",90,"ل",1,0],["المعتبر يآخذ على الدنيا دروس من العبر","والناس بكسبها معاملها بقد عقولها",91,"ل",3,0],["المُعْتِدينَ جيوشَ القهرِ كاتِمةً","أنفاسَ كلِّ كريمٍ رافضٍ وأبي",92,"ب",2,0],["المعتزين.. ومطلقين المحابيس","المبزعين .. ونبع بيض النوايا",93,"ا",3,0],["المعتلين... المكرمين.. المقابيس","الشامخين .. الراسخين.. الدهايا",93,"ا",3,0],["المعاني كانها ماهي [ فريده ]","ردّها لاهل السوالف والحكاوى",94,"ا",3,0],["ألَمٌ على ألَمٍ ومِثْلي يَألمُ","فالعشقُ جمرٌ في كياني مُضْرَمُ",95,"م",1,1],["المعضد المأتور عضبٍ صيرمي","رداد قوم وكاهمن كل هافي",96,"ف",2,0],["المعرفه ماهيب مثل الجهاله","والوقت يبغي عارف يستغله",97,"ل",2,0],["ألمعي به يقوم","من الأمر ما التوى",98,"و",2,0],["المعالي والمساعي هذه","فاحتفظها الأبنيات الطريق",99,"ق",1,0],["ألمعي يعيد بالخاطر العا","طر موهوم كلّ سرٍّ جهارا",100,"ر",2,0],["المعبد الشمع أنهى عهده لهب","أباح لي رؤية الأوحال والعشب",101,"ب",1,0],["المعولُ بُعدكِ فتتني","لا قلبٌ لا عقلٌ يَعملْ",102,"ل",1,0],["أُلّمعُ وجهَ الحقيقةِ حتى","يصيرَ الظلامُ صباحاً ويُسفر",103,"ر",1,0],["المعتدون بنوا قصور فى الهوا","وتحطت أحلامهم بنضالنا",104,"ن",2,0],["المعتدون الغاشمون إلى الردى","والخائنون مصيرهم أهوالُ",105,"ل",1,0],["المعجزات صناعتنا التي سقطت","بالمجرمين ومن خلقوا شياطينا",106,"ن",2,0],["المعجباتُ إلى الجحيمِ","فلم أكنْ بسِواكِ مُعجبْ",107,"ب",1,0],["ألمٌ على الأحداق فجّر ماءَه","وأنين هذا القلب يكتمُ داءه",108,"ا",3,1],["ألمعيٌّ يبريْ النّفوسَ المعاني","بحسودٍ من لؤلؤٍ منضودِ",109,"د",1,0],["المعاني من غرابيلي جديده","من عذابي لحّنوا حلو الأغاني",110,"ن",2,0],["المعاني بينها جدولعب","والله العالم بماتخفي الصدور",111,"ر",1,0],["المعانى تاجها ..... قل الكلام.","والسمين اليوم ماله مشتري.",112,"ر",2,0],["المعطي الله مالخلقه عطايا","لو هي على خلقه سقتنا المراير",113,"ر",1,0],["المُعيديون بالأمس أتو","مادهاهم عن حماكم يرحلون",114,"ن",1,0],["المعضلات هي المصالح والأنا","والاقتتال على الكلا يتعاظمُ",115,"م",1,0],["المعتدي كالشمسِ نشهد وجهه","أمّا العميل فتحت كل سريرِ",116,"ر",1,0],["المعجزات موازناتُ زمانهم","مع ديننا ببراعةٍ لم تُخْذَلِ",117,"ل",1,0],["ألمٌ على ألمٍ جميعُ حياتنا","عفنٌ على عفنٍ كمن هو بائلُ",118,"ل",1,0],["المعتدين بأرض مسرى محمدٍ","جاسوا فسادا , والرموزُ تهانُ",119,"ن",1,0],["المعلنين من القصورِ قصورَنا","واللاقطين عطيّةَ اللقطاءِ",120,"ا",2,0],["أُلَمّعُ كالبروقِ حذاءَ حُلْمي","ليزهرَ ماشياً في كلِّ دُجْنِ",121,"ن",1,0],["ألمعيُّ الروحِ .. تعرفهُ","حكمةُ الأيامِ .. والخَطْرَةْ",122,"ر",2,0],["المعتدون بأرض مسرى محمدٍ","جاسوا فسادا , والرموزُ تهانُ",123,"ن",1,0]]}