{"poems":[[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[57,"ما في المقام لذي عقل وذي أدب","https://www.aldiwan.net/poem24724.html","البسيط"],[77,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"يا كاتب الشرق ويا خير من","https://www.aldiwan.net/poem68849.html","السريع"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[27,"عيت تميم بأمر كان أفظعها","https://www.aldiwan.net/poem5715.html","البسيط"],[72,"سافرت للساحل مستبضعا","https://www.aldiwan.net/poem18428.html","السريع"],[51,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[51,"شهر الصيام مبارك لكنما","https://www.aldiwan.net/poem65985.html","الكامل"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[78,"لقد حصلت يا رنده","https://www.aldiwan.net/poem14257.html","مجزوء الوافر"],[85,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[61,"قام مثل القمر الزا","https://www.aldiwan.net/poem51318.html","مجزوء الرمل"],[44,"يا هذه أقصري ما هذه بشر","https://www.aldiwan.net/poem30512.html","البسيط"],[69,"يا قادما والثلج قد عم الفضا","https://www.aldiwan.net/poem29120.html","الكامل"],[33,"وعار من الأرياش كاس من الهوى","https://www.aldiwan.net/poem25858.html","الطويل"],[105,"أمهجة مصر يضرب كل رام","https://www.aldiwan.net/poem43149.html","الوافر"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[52,"يا من به صمم عن الشكوى","https://www.aldiwan.net/poem27318.html","الكامل"],[46,"سأفعل خيرا ما استطعت فلا تقم","https://www.aldiwan.net/poem23082.html","الطويل"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[107,"دنوا لقد أوهى تجلدي البعد","https://www.aldiwan.net/poem16228.html","الطويل"],[107,"هل وقفة بين الطلول","https://www.aldiwan.net/poem16305.html","مجزوء الكامل"],[115,"سافر","https://www.aldiwan.net/poem24065.html","السريع"],[158,"اسكنوها بسلام آمنينا","https://www.aldiwan.net/poem58828.html","الطويل"],[197,"أرى عقلي كساقية تدار","https://www.aldiwan.net/poem45403.html","الوافر"],[233,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[273,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[301,"سافر تنل عزا فما مسك الورى","https://www.aldiwan.net/poem58230.html","الكامل"],[301,"سافر تنل رتب المفاخر والعلا","https://www.aldiwan.net/poem58231.html","الكامل"],[302,"الله لا تشهد سواه ولا ترى","https://www.aldiwan.net/poem16758.html","الكامل"],[351,"يطارحني هذا الزمان بهمه","https://www.aldiwan.net/poem39778.html","الطويل"],[351,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[359,"صاح في العاشقين بال كنانه","https://www.aldiwan.net/poem68049.html","الخفيف"],[364,"سالت جفون الهوى على قدر","https://www.aldiwan.net/poem16982.html","المنسرح"],[369,"وأخ مسه نزولي عليه","https://www.aldiwan.net/poem57511.html","الخفيف"],[377,"ترى عندكم في الحب بعض الذي عندي","https://www.aldiwan.net/poem49198.html","الطويل"],[377,"أطاعك قلبي جاهدا فعصيته","https://www.aldiwan.net/poem49246.html","الطويل"],[397,"فمتى تعلمني ؟!","https://www.aldiwan.net/poem6708.html","عموديه"],[413,"يشق علي أن تشقى بحبس","https://www.aldiwan.net/poem53982.html","الوافر"],[429,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[456,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[462,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[462,"ما بالها لم تجرني في بالها","https://www.aldiwan.net/poem3414.html","عموديه"],[477,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[513,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[513,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[513,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[536,"قد غاب عبد الله عني من غدا","https://www.aldiwan.net/poem47575.html","عموديه"],[558,"أغنيات الفقد","https://www.aldiwan.net/poem67265.html","عموديه"],[573,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"]],"verses":[["سأَفْري أديمَ الأرضِ بالعيسِ نُقَّباً","حَبا بالذي أبغيهِ أو بَخِلَ القَضا",0,"ض",2,0],["سافِر تَجِد عِوَضاً عَمَّن تُفارِقُهُ","وَاِنصَب فَإِنَّ لَذيذَ العَيشِ في النَصَبِ",1,"ب",1,0],["سافَتْهُ في وَجٍّ وفي خردَلٍ","ومَنْ لِذاكَ الوَجْهِ بالوَجِّ",2,"ج",1,0],["سَأَفيكَ حَقَّك في الرِثاءِ كَما","تَرضى إِذا لَم تُقدَرِ الرُجعى",3,"ع",2,0],["سافِر وَعُد يَحفَظكَ رَبُّ الوَرى","وَاِبعَث لَنا عيسى بِآياتِهِ",4,"ه",1,0],["سافَت بِطَيِّبَةِ العِرنينِ مارِنُها","بِالمِسكِ وَالعَنبَرِ الهِندِيِّ مُختَضِبُ",5,"ب",1,0],["سافَهتَ مِن خالِدٍ ناباً تُكالِبُهُ","عَنّا سَقاكَ غَمامُ المُدجِنِ الغادي",6,"ي",1,0],["سافرت للساحل مستبضِعاً","حمداً وقصداً حسن الجملة",7,"ه",1,1],["سأَفخر إذ أعطانيَ الله مَفخراً","وأبجحُ إذ أعطاني الله مَبْجَحا",8,"ح",2,0],["سافرْ بفكركَ منه في نأي المدى","ممدودِه ممطولهِ موصولهِ",9,"ل",2,0],["سافِراً يَختالُ في هَذا الرَقيع","هَل أَتاهُ نَبَءُ الخَطبِ الفَظيع",10,"ع",1,0],["سأفني مُدَّةَ الأَعدا","ءِ إِن طالَت بيَ المُدَّهْ",11,"د",2,0],["سافَرَ أَربَعينَ قَرناً عَدَّها","حَتّى أَتى الدارَ فَأَلفى عِندَها",12,"د",3,0],["سافر عن حر وجه","صادق الحسن وجيه",13,"ي",2,0],["سافِر بِطَرفِكَ في أَقصى مَكارِمِنا","إِن لَم يَكُن لَكَ في تَأسيسِها سَفَرُ",14,"ر",1,0],["سافرتَ في يومٍ عبوسٍ أسودٍ","وقَدِمْتَ في يومٍ ضحوكٍ أبيضِ",15,"ض",1,0],["سَأُفضي إِلى سُبلِ الهَلاكِ وَإِنَّني","لَمُحتَسِبٌ راضٍ مَشيئَةَ خالِقي",16,"ق",2,0],["سَأُفزِعُ في المَضاجِعِ كُلَّ حَيٍّ","وَأَعصِفُ بِالقُبورِ وَبِالعِظامِ",17,"م",1,0],["سافَت قَليلاً أَعلى نَصائِبِهِ","ثُمَّ اِستَمَرَّت في طامِسٍ تَخِدُه",18,"د",2,0],["سافَرتُ بِالآمالِ فيكَ فَلَم","تَبلُغ وِصالَكَ وَاِنثَنَت حَسرى",19,"ا",1,0],["سَأَفعَلُ خَيراً ما اِستَطَعتُ فَلا تُقَم","عَلَيَّ صَلاةٌ يَومَ أُصبِحُ هالِكا",20,"ك",2,1],["سافَرْتَ عنّا فظَلّ النّاسُ كلّهُمُ","يُراقبونَ إيابَ العِيدِ مِن سَفَرِ",21,"ر",1,0],["سافرت من بغداد في سيارة","نفثت لظىً وتحركت بضرام",22,"م",1,0],["سأفوق من أثروا ، وتخبر جدّتي","أن الزّمان يرقّ بعد جفاف",23,"ف",1,0],["سَأَفزع مِن جور الخُطوب وَاِنثَني","إِلى عَدل مِن أَضحى لَهُ الحَل وَالعقد",24,"د",1,0],["سافَرت بِالآمال في","هِ فَلَم يَكُن إِلّا وُصولي",25,"ل",2,0],["سافِرْ مَتى شِئتَ إلى أَضْلُعي","بين دمي والرُّوحِ طابَ السَّفَرْ",26,"ر",1,1],["سافرت أبصارنا في قصرها","سفر القَصر على ما يشتهينا",27,"ن",2,0],["سأفعلُ فعلَ أجدادي فإمَّا","كما نالوا وإمَّا حيثُ صاروا",28,"ر",3,0],["سافِراتٍ رِياضُها عَن ثُغورٍ","وَخُدودٍ مِن أُقحُوانٍ وَوَردِ",29,"د",1,0],["سَافَتْ رِيَاحُ المَنَايَا مِنْ سُيُوفِهِمُ","سُفْيانَ فَانْهَزَمَتْ يَا وَيْحَ سُفْيانا",30,"ن",2,0],["سافر تنل عزاً فما مسك الورى","إلا دما في سرة الغزلان",31,"ن",1,1],["سافر تنل رتب المفاخر والعلا","كالدر سار فصار في التيجان",32,"ن",1,1],["سافر إليه بهمة علوية","حتى تراه وقل لنفسك موتي",33,"ت",2,0],["سَأَفري القَفا مِنهُ بِمَفريّ نَعلِهِ","وَأَنزَعه وَجهاً بِصَفع أغمّهِ",34,"م",2,0],["سَأفري الفَلا جوباً عَلى مَتن ضامر","لَهُ تضمر الأَيّام حيناً وَتظهرُ",35,"ر",1,0],["سافَر الوَجه عَن مَحاسِنَ بَدر","بِلِحاظ غَدّارَة خَوّانَه",36,"ن",2,0],["سافَرَ عَنّي وَلا أَرى قَمَراً","أُفْقاً وَأَرضاً إِلّا عَلى سَفَرِ",37,"ر",1,0],["سافِروا تَغنَموا فَقالَ وقَد قا","لَ تمام الحديثِ صُوموا تَصحُّوا",38,"ح",3,0],["سَأَفني اللَيالي بِإِتِكالي عَلى الَّذي","تَنَزهَ في أَحكامِهِ الواحد الفَرد",39,"د",1,0],["سَأَفني زَماني بِالتَوَكُل وَالرِضى","وَأَزجر نَفسي عَن مواردة الأَجن",40,"ن",1,0],["سافرتَ بي حتى رأيتُ غروبَ حزني","ينأى ، وحتَّى صرتُ أحتضن الشروقا",41,"ق",2,0],["سأُفْرِغُ للثناء عليه فكري","وإملاء القريض عليك طرسي",42,"ي",1,0],["سافِرْ إذا حاولتَ قَدْرا","سارَ الهلالُ فصارَ بَدرا",43,"ر",2,1],["سافرات بِمنىً لولا التقى","خَمَّرَتْهنّ شفاهٌ بالقُبَلْ",44,"ل",1,0],["سافرْ بطرفك واشترف هل تعرفُ","أَنَّى سرى برقٌ بوجرةَ يخطِفُ",45,"ف",1,1],["سافرٍ عن طلعة الشمس ضحىً","ناظرٍ عن مقلة الظبي الأغنّ",46,"ن",1,0],["سافحها سارحها فهاقها","دفاقها هاطلها هتانها",47,"ن",3,0],["سافرة عن طلعةٍ ما انتقبتْ","إلاَّ وغار البدر من هلالها",48,"ل",3,0],["سافت فريستها التعسا غباوته","وخادعت ذلك المغرور فانخدعا",49,"ع",2,0],["سافر في الدنيا وأقطارها","ذكر غداً عنه جميلاً وراح",50,"ح",1,0],["سأفنى ويفنى ما بذلتم من الندى","ويخلد مدحي فيكم ويعمر",51,"ر",1,0],["سافر بطرفك لا تجد إلا يداً","مخضوبة بيد له لم تنصل",52,"ل",1,0],["سَافرتَ يا عبدَ الإله مُبكِّرا","وتركتَ قلبِي بالجَوَى يتقَطعُ",53,"ع",1,0],["سافرتُها والتفاتُ اليأسِ يُفزِعني","فكلما ذُبتُ شوقاً مَدّ لي عُنُقَه",54,"ق",2,0],["سَافِرْ فَوجْهُ الْعِيد سَافِرْ","فلْتَرْجِعَنَّ وَأَنْتَ ظَافِرْ",55,"ر",1,1]]}