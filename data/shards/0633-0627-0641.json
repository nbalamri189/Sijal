gate.com/ViewPoem.aspx?id=189157",""],[5784,"العشق بلوى...","https://www.poetsgate.com/ViewPoem.aspx?id=190790",""],[5804,"قصيدة يتكرر فيها حرف السين","https://www.poetsgate.com/ViewPoem.aspx?id=182858",""],[5837,"سجين المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=181854",""],[5841,"سافرت في فكري وْ هجيت","https://www.poetsgate.com/ViewPoem.aspx?id=37007",""],[5848,"يادلعها","https://www.poetsgate.com/ViewPoem.aspx?id=48987",""],[5853,"دستور حبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175705",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5956,"وتثور نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=182639",""],[5956,"شوق إلى سيدنا محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=184651",""],[5956,"سأُفْصِح عن بعض وُدّي إليهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194180",""],[5956,"طلبات لا أعنيها لأنها هلوسة أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=194602",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6070,"أيام عمرك","https://www.poetsgate.com/ViewPoem.aspx?id=187805",""],[6070,"جنة الارض","https://www.poetsgate.com/ViewPoem.aspx?id=187975",""],[6070,"راحَ الفؤادُ بشوقهِ يتحرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188643",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6070,"يا أيها المأسورُ بالأوهامِ","https://www.poetsgate.com/ViewPoem.aspx?id=197527",""],[6070,"ما أجملَ الشِّعرَ حِينَ الرُّوحُ تَسْكبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=197535",""],[6084,"سافر فسوف ترى اللذات في السفر","https://www.poetsgate.com/ViewPoem.aspx?id=170838",""],[6093,"وَجهُ شِعرِي (الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=180589",""],[6097,"نَارانِ","https://www.poetsgate.com/ViewPoem.aspx?id=190672",""],[6147,"الدّفق الغامر.. في مدح الرسول الأعظم","https://www.poetsgate.com/ViewPoem.aspx?id=212925",""],[6152,"غادرت جدة","https://www.poetsgate.com/ViewPoem.aspx?id=202895",""],[6152,"غب ما تشاء","https://www.poetsgate.com/ViewPoem.aspx?id=203015",""],[6152,"هي موطني","https://www.poetsgate.com/ViewPoem.aspx?id=203751",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[6271,"أبناء الدروب الضيقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80702&r=&rc=8",""],[6277,"سأفتح حانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64456&r=&rc=19",""],[6344,"حجاب المرايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87979&r=&rc=19",""]],"verses":[["سأَفْري أديمَ الأرضِ بالعيسِ نُقَّباً","حَبا بالذي أبغيهِ أو بَخِلَ القَضا",0,"ض",2,0],["سافِر تَجِد عِوَضاً عَمَّن تُفارِقُهُ","وَاِنصَب فَإِنَّ لَذيذَ العَيشِ في النَصَبِ",1,"ب",1,0],["سافَتْهُ في وَجٍّ وفي خردَلٍ","ومَنْ لِذاكَ الوَجْهِ بالوَجِّ",2,"ج",1,0],["سَأَفيكَ حَقَّك في الرِثاءِ كَما","تَرضى إِذا لَم تُقدَرِ الرُجعى",3,"ع",2,0],["سافِر وَعُد يَحفَظكَ رَبُّ الوَرى","وَاِبعَث لَنا عيسى بِآياتِهِ",4,"ه",1,0],["سافَت بِطَيِّبَةِ العِرنينِ مارِنُها","بِالمِسكِ وَالعَنبَرِ الهِندِيِّ مُختَضِبُ",5,"ب",1,0],["سافَهتَ مِن خالِدٍ ناباً تُكالِبُهُ","عَنّا سَقاكَ غَمامُ المُدجِنِ الغادي",6,"ي",1,0],["سافرت للساحل مستبضِعاً","حمداً وقصداً حسن الجملة",7,"ه",1,1],["سأَفخر إذ أعطانيَ الله مَفخراً","وأبجحُ إذ أعطاني الله مَبْجَحا",8,"ح",2,0],["سافرْ بفكركَ منه في نأي المدى","ممدودِه ممطولهِ موصولهِ",9,"ل",2,0],["سافِراً يَختالُ في هَذا الرَقيع","هَل أَتاهُ نَبَءُ الخَطبِ الفَظيع",10,"ع",1,0],["سأفني مُدَّةَ الأَعدا","ءِ إِن طالَت بيَ المُدَّهْ",11,"د",2,0],["سافَرَ أَربَعينَ قَرناً عَدَّها","حَتّى أَتى الدارَ فَأَلفى عِندَها",12,"د",3,0],["سافر عن حر وجه","صادق الحسن وجيه",13,"ي",2,0],["سافِر بِطَرفِكَ في أَقصى مَكارِمِنا","إِن لَم يَكُن لَكَ في تَأسيسِها سَفَرُ