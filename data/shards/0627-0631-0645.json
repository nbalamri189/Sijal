{"poems":[[53,"يا عذولي قد غضضت جماحي","https://www.aldiwan.net/poem29800.html","الخفيف"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[41,"أغدوت أم في الرائحين تروح","https://www.aldiwan.net/poem42377.html","الكامل"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[38,"إني حلفت يمينا غير كاذبة","https://www.aldiwan.net/poem7711.html","البسيط"],[78,"أرمدت أم بنجومك الرمد","https://www.aldiwan.net/poem14197.html","أحذ الكامل"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[45,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[22,"يا دار هند عفت إلا أثافيها","https://www.aldiwan.net/poem22028.html","البسيط"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[46,"أرمى وجدك من رامي بني ثعل","https://www.aldiwan.net/poem22538.html","البسيط"],[46,"إرمنا يا ظلام في كل فج","https://www.aldiwan.net/poem23618.html","الخفيف"],[15,"لمن جمال قبيل الصبح مزمومه","https://www.aldiwan.net/poem45246.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/4775","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[35,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[78,"أَرمدت أَم بِنجومك الرّمد؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86657&r=&rc=152",""],[96,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""]],"verses":[["أَرمَضَت شَمسُكَ المُنيرَةُ فَودي","يَ فَمَن لي بِظِلِّ ذاكَ الغَمامَ",0,"م",1,0],["أَرمَضَتهُ هَواجِرُ الخَطبِ فَاِنقا","دَ حَمولَ الأَذى وَما قالَ هُجرا",1,"ر",2,0],["أَرمي بِأَيدي المَطايا كُلَّ مُشتَبِهٍ","تَنبو بِأَخفافِها عَنهُ الجَلاميدُ",2,"د",1,0],["إِرمي بِمثلِهِ جالَتِ الجِنُّ","فَآبَت لِخَصمِها الأَجلاءُ",3,"ا",2,0],["أَرمِي وَأَطعَنُ ثُمَّ أُتِبعُ ضَربَةً","تَدَعُ النساءَ على الرجالِ تَنُوحُ",4,"ح",1,0],["أرمى مسدسه في صدره بيدٍ","لا تعرف الضعف في المرمى ولا الخورا",5,"ر",2,0],["أرُمتَ زيني بأن تُعرِّضني","لمدحه فالذليل من عَضَدَهْ",6,"د",2,0],["أرمي مَشيمتها برأس مُلَمْلَمٍ","ريّان من ماءِ الشبيبةِ أعْجرِ",7,"ر",1,0],["أرمَتْ سواداً أنتَ في","ه لقد أتتْ أمراً يجلُّ",8,"ل",1,0],["أَرمي بِها كُلَّ مَوماةٍ مُوَدِّيَةٍ","جَدّاءَ غِشيانُها بِالقَومِ تَغريرُ",9,"ر",1,0],["أَرمدتَ أَمْ بِنَجومك الرمدُ","فَقَد عادَ ضدّا كُلُّ ما تَعِدُ",10,"د",1,1],["أَرمي بِهِ شَوكَ القَنا وَأَرُدُّهُ","كَالسَمعِ أَثَّرَ فيهِ شَوكُ العَوسَجِ",11,"ج",1,0],["أَرمي بِظَنّي فَلا أَعدو الخَطاءَ بِهِ","إِعجَب لِأَخطاءِ رامٍ مِن بَني ثُعَلِ",12,"ل",1,0],["أَرمي الحَصى مِن حافِرَيهِ بِمِثلِهِ","وَأَروعُ ضَوءَ الصُبحِ مِنهُ بِضِدِّهِ",13,"د",2,0],["أرمي الطريق بناظري رجل","وأنا لها طفل أضاحكها",14,"ه",2,0],["أَرمي بِها مَعرِضَ الدَوِّيِّ ضامِرَةً","في لَيلَةٍ ما يَذُوقُ النَومَ سارِيها",15,"ي",3,0],["أرماحه لا تزال عالمة","أن ليس بأس كبأس حاملها",16,"ل",3,0],["أَرمَدُ مِن نَأيِها وَلَو قَرُبَت","يَوماً شَفَت عَينَهُ مِنَ الرَمَدِ",17,"د",1,0],["أَرمى وَجَدِّكَ مِن رامي بَني ثُعَلٍ","حَتفٌ لَدَيهِ إِزاءُ الحَوضِ وَالعُقُرُ",18,"ر",1,1],["إِرمِنا يا ظَلامُ في كُلِّ فَجٍّ","فَالمُنى لَم تَزَل تَجُرُّ المَنايا",19,"ا",3,1],["أَرمي بِها عُرُضَ الدَوِّيُّ ضامِزَةً","في ساعَةٍ تَبعَثُ الحِرباءَ مَسمومَه",20,"م",2,0],["أرمق الشاطىء البعيدَ بعينٍ","عكفت في الدجى على التسكابِ",21,"ب",1,0],["أَرمِي به بَقَر الحِمى","وَأَصُدُّ عن عُصُم العواصِمْ",22,"م",1,0],["إِرمِ بِالكَهلِ عَلى جُمهورِهم","تَرمِ مِنهُ بِالشِهابِ المُتَّقِد",23,"د",1,0],["ارم نظارتيك كي أتملّى","كيف تبكي شواطئ المرجان",24,"ن",1,0],["ارم نظارتيك ما أنت أعمى","إنما نحن جوقة العميان",24,"ن",1,0],["إرمي بمثله جاكت الخي","ل وتأبى لخصمها الإجلاء",25,"ا",2,0],["أَرُمُ ثَابِتٌ يَهْتَزُّ فيه","بأكرمِ منبِتٍ فرعٌ أصيلُ",26,"ل",1,0],["أَرَمِدْتَ أَمْ بِنجُومك الرَّمدُ؟","قَد عادَ ضدًّا كُلُّ ما تَعِدُ",27,"د",1,1],["أرمق الشاطئ البعيد بعين","عكفت في الدّجى على التّسكاب",28,"ب",1,0]]}