{"poems":[[53,"يا عذولي قد غضضت جماحي","https://www.aldiwan.net/poem29800.html","الخفيف"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[41,"أغدوت أم في الرائحين تروح","https://www.aldiwan.net/poem42377.html","الكامل"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[38,"إني حلفت يمينا غير كاذبة","https://www.aldiwan.net/poem7711.html","البسيط"],[78,"أرمدت أم بنجومك الرمد","https://www.aldiwan.net/poem14197.html","أحذ الكامل"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[45,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[22,"يا دار هند عفت إلا أثافيها","https://www.aldiwan.net/poem22028.html","البسيط"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[46,"أرمى وجدك من رامي بني ثعل","https://www.aldiwan.net/poem22538.html","البسيط"],[46,"إرمنا يا ظلام في كل فج","https://www.aldiwan.net/poem23618.html","الخفيف"],[15,"لمن جمال قبيل الصبح مزمومه","https://www.aldiwan.net/poem45246.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/4775","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[96,"إلى البحر","https://www.poetsgate.com/ViewPoem.aspx?id=13194",""],[35,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[78,"أَرمدت أَم بِنجومك الرّمد؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86657&r=&rc=152",""],[120,"إيه عبد الرحمن أذكيت جمرا","https://www.aldiwan.net/poem49274.html","الخفيف"],[120,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[166,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[186,"عيناي ترتع في الملاح","https://www.aldiwan.net/poem43214.html","مجزوء الكامل"],[229,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[229,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[249,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[275,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[364,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[364,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[366,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[377,"أدعو بمريم في ضري فتنقذني","https://www.aldiwan.net/poem59151.html","البسيط"],[391,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[406,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[432,"وليلة أطلعت في جنحها","https://www.aldiwan.net/poem12571.html","السريع"],[458,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[458,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[458,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[479,"إنسانة أم ملاك","https://www.aldiwan.net/poem36915.html","المجتث"],[551,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[561,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[575,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"]],"verses":[["أَرمَضَت شَمسُكَ المُنيرَةُ فَودي","يَ فَمَن لي بِظِلِّ ذاكَ الغَمامَ",0,"م",1,0],["أَرمَضَتهُ هَواجِرُ الخَطبِ فَاِنقا","دَ حَمولَ الأَذى وَما قالَ هُجرا",1,"ر",2,0],["أَرمي بِأَيدي المَطايا كُلَّ مُشتَبِهٍ","تَنبو بِأَخفافِها عَنهُ الجَلاميدُ",2,"د",1,0],["إِرمي بِمثلِهِ جالَتِ الجِنُّ","فَآبَت لِخَصمِها الأَجلاءُ",3,"ا",2,0],["أَرمِي وَأَطعَنُ ثُمَّ أُتِبعُ ضَربَةً","تَدَعُ النساءَ على الرجالِ تَنُوحُ",4,"ح",1,0],["أرمى مسدسه في صدره بيدٍ","لا تعرف الضعف في المرمى ولا الخورا",5,"ر",2,0],["أرُمتَ زيني بأن تُعرِّضني","لمدحه فالذليل من عَضَدَهْ",6,"د",2,0],["أرمي مَشيمتها برأس مُلَمْلَمٍ","ريّان من ماءِ الشبيبةِ أعْجرِ",7,"ر",1,0],["أرمَتْ سواداً أنتَ في","ه لقد أتتْ أمراً يجلُّ",8,"ل",1,0],["أَرمي بِها كُلَّ مَوماةٍ مُوَدِّيَةٍ","جَدّاءَ غِشيانُها بِالقَومِ تَغريرُ",9,"ر",1,0],["أَرمدتَ أَمْ بِنَجومك الرمدُ","فَقَد عادَ ضدّا كُلُّ ما تَعِدُ",10,"د",1,1],["أَرمي بِهِ شَوكَ القَنا وَأَرُدُّهُ","كَالسَمعِ أَثَّرَ فيهِ شَوكُ العَوسَجِ",11,"ج",1,0],["أَرمي بِظَنّي فَلا أَعدو الخَطاءَ بِهِ","إِعجَب لِأَخطاءِ رامٍ مِن بَني ثُعَلِ",12,"ل",1,0],["أَرمي الحَصى مِن حافِرَيهِ بِمِثلِهِ","وَأَروعُ ضَوءَ الصُبحِ مِنهُ بِضِدِّهِ",13,"د",2,0],["أرمي الطريق بناظري رجل","وأنا لها طفل أضاحكها",14,"ه",2,0],["أَرمي بِها مَعرِضَ الدَوِّيِّ ضامِرَةً","في لَيلَةٍ ما يَذُوقُ النَومَ سارِيها",15,"ي",3,0],["أرماحه لا تزال عالمة","أن ليس بأس كبأس حاملها",16,"ل",3,0],["أَرمَدُ مِن نَأيِها وَلَو قَرُبَت","يَوماً شَفَت عَينَهُ مِنَ الرَمَدِ",17,"د",1,0],["أَرمى وَجَدِّكَ مِن رامي بَني ثُعَلٍ","حَتفٌ لَدَيهِ إِزاءُ الحَوضِ وَالعُقُرُ",18,"ر",1,1],["إِرمِنا يا ظَلامُ في كُلِّ فَجٍّ","فَالمُنى لَم تَزَل تَجُرُّ المَنايا",19,"ا",3,1],["أَرمي بِها عُرُضَ الدَوِّيُّ ضامِزَةً","في ساعَةٍ تَبعَثُ الحِرباءَ مَسمومَه",20,"م",2,0],["أرمق الشاطىء البعيدَ بعينٍ","عكفت في الدجى على التسكابِ",21,"ب",1,0],["أَرمِي به بَقَر الحِمى","وَأَصُدُّ عن عُصُم العواصِمْ",22,"م",1,0],["إِرمِ بِالكَهلِ عَلى جُمهورِهم","تَرمِ مِنهُ بِالشِهابِ المُتَّقِد",23,"د",1,0],["ارم نظارتيك كي أتملّى","كيف تبكي شواطئ المرجان",24,"ن",1,0],["ارم نظارتيك ما أنت أعمى","إنما نحن جوقة العميان",24,"ن",1,0],["إرمي بمثله جاكت الخي","ل وتأبى لخصمها الإجلاء",25,"ا",2,0],["أرمق الشاطئَ البعيد بعينٍ","عكفت في الدجى على التسكابِ",26,"ب",1,0],["أَرُمُ ثَابِتٌ يَهْتَزُّ فيه","بأكرمِ منبِتٍ فرعٌ أصيلُ",27,"ل",1,0],["أَرَمِدْتَ أَمْ بِنجُومك الرَّمدُ؟","قَد عادَ ضدًّا كُلُّ ما تَعِدُ",28,"د",1,1],["أرمضتني الخطوب في فدفد العي","ش ولم ألف غير دمعي فطرا",29,"ر",2,0],["أرمي بظني وأخلق أن يطيش وفي","عيني ضبابٌ وفي الآفاق أدجان",30,"ن",1,0],["أُرَمِّقُ العَيشَ عَلى بَرصٍ فَإِن","رُمتُ اِرتِشافاً رُمتُ صَعبَ المُنتَهى",31,"ا",1,0],["أَرمي بها البيداء تَفْرقُ جنّها","فيها وتَرميني إلى الآمادِ",32,"د",1,0],["أرميهم بلواحظي","وأمرّ منصرفا لشاني",33,"ن",2,0],["أَرْمَضْتَ يا رمضانُ السِّيئاتِ لنا","بُشْر بِنا للتُّقَى عَلاَّ على نَهَلِ",34,"ل",1,0],["أَرمِي مُعادِيَكم وأَجْبُرُ صَدْعَكُمْ","وأَذُبُّ عن أَعراضِكم مُتَوَرّعا",35,"ع",2,0],["أَرمي بِها الفَلَواتِ ضامِزَةً إِذا","سَمَعَ المُجِدُّ بِها صَريرَ الجُندُبِ",36,"ب",1,0],["أرَمّ لدَيْها هيْبةً كلُّ مادِح","وَأقْصرَ عَجزاً دُونَها كُلُّ مانِح",37,"ح",1,0],["أرمي بها دارَ العَدوّ وفي الحَشا","لِهوَى الأحبّةِ غُلّةً لم تُبْلَل",38,"ل",1,0],["أرمي إليهم بطَرْفِ العَيْن أقسِمُه","بين الرّقيب وبين الإْلف من حَذَر",39,"ر",1,0],["اِرمِ الفُؤادَ بِكُلِّ سَهمٍ تُمضِهِ","لي أَضلُعٌ مِثلُ القِسِيِّ حَوانِ",40,"ن",1,0],["ارمي بضيقتنا في كل نائبةٍ","وَضَمْحلي الداء عنا إنه قاء",41,"ا",2,0],["ارموا بهذه من ورا جبل قاف","يعني الولاية للقضا والأوقاف",42,"ف",1,0],["أَرمي الفِجاجِ بِها لأَلقيَ رحلها","في حَيث تُلقى أَرحلُ الفِتيانِ",43,"ن",1,0],["أرماحُها الشمعُ وأسيافها","نارُ الغَضى والدمُ ماءُ العِنَبْ",44,"ب",1,0],["أرمُّ من أخلاقه ملوّناً","يصبغ لي في كلّ يومٍ خُلُقا",45,"ق",2,0],["أرميا على الهجران والشَّيب واخِطٌ","فهلاّ وفي قوس الشبيبة منزَعُ",46,"ع",1,0],["اِرْمِ بهم على الليالي تَنتصِفْ","بهِمْ على ضعفِك من شِدادِها",47,"د",3,0],["أرمينيا قلت لكن","إنسانة أم ملاك",48,"ك",1,0],["أَرمي فَلا أصمي فإنْ رُمِيَتْ","جهتي رُميتُ معرّضاً نحري",49,"ي",1,0],["أَرمي بِأِيدي العِيسِ إِذ هَويتُ","في بَلدَةٍ يَعيا بِها الخِرّيتُ",50,"ت",1,0],["أرْمَى وكَنْتُ أُصْطَفَى","أُقْلَى وكُنْتُ أُجْتَبى",51,"ب",2,0]]}