,"https://www.poetsgate.com/ViewPoem.aspx?id=186846",""],[168,"مقصورة ابن دريد","https://www.poetsgate.com/ViewPoem.aspx?id=1424",""],[5616,"مفاتن","https://www.poetsgate.com/ViewPoem.aspx?id=203233",""],[5664,"حفيف الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=176687",""],[5688,"ما بال قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=200961",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5885,"حيث سفينتي تأسى","https://www.poetsgate.com/ViewPoem.aspx?id=194836",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5956,"الوسواس الخناس يحطِّم كبارَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192093",""],[5963,"آخر ُ الأَلحان","https://www.poetsgate.com/ViewPoem.aspx?id=187414",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[463,"يقولونَ يومَ البينُ عينكَ تدمعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60123&r=&rc=179",""],[6290,"جبل ورابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85155&r=&rc=14",""]],"verses":[["أرمم سقفا قد تداعى أساسه","وأجبر عظما بعد أن شل صاحبه",0,"ب",2,0],["أَرمَضَت شَمسُكَ المُنيرَةُ فَودي","يَ فَمَن لي بِظِلِّ ذاكَ الغَمامَ",1,"م",1,0],["أَرمَضَتهُ هَواجِرُ الخَطبِ فَاِنقا","دَ حَمولَ الأَذى وَما قالَ هُجرا",2,"ر",2,0],["أَرمي بِأَيدي المَطايا كُلَّ مُشتَبِهٍ","تَنبو بِأَخفافِها عَنهُ الجَلاميدُ",3,"د",1,0],["إِرمي بِمثلِهِ جالَتِ الجِنُّ","فَآبَت لِخَصمِها الأَجلاءُ",4,"ا",2,0],["أَرمِي وَأَطعَنُ ثُمَّ أُتِبعُ ضَربَةً","تَدَعُ النساءَ على الرجالِ تَنُوحُ",5,"ح",1,0],["أرمى مسدسه في صدره بيدٍ","لا تعرف الضعف في المرمى ولا الخورا",6,"ر",2,0],["أرُمتَ زيني بأن تُعرِّضني","لمدحه فالذليل من عَضَدَهْ",7,"د",2,0],["أرمي مَشيمتها برأس مُلَمْلَمٍ","ريّان من ماءِ الشبيبةِ أعْجرِ",8,"ر",1,0],["أرمَتْ سواداً أنتَ في","ه لقد أتتْ أمراً يجلُّ",9,"ل",1,0],["أَرمي بِها كُلَّ مَوماةٍ مُوَدِّيَةٍ","جَدّاءَ غِشيانُها بِالقَومِ تَغريرُ",10,"ر",1,0],["أَرمدتَ أَمْ بِنَجومك الرمدُ","فَقَد عادَ ضدّا كُلُّ ما تَعِدُ",11,"د",1,1],["أَرمي بِهِ شَوكَ القَنا وَأَرُدُّهُ","كَالسَمعِ أَثَّرَ فيهِ شَوكُ العَوسَجِ",12,"ج",1,0],["أَرمي بِظَنّي فَلا أَعدو الخَطاءَ بِهِ","إِعجَب لِأَخطاءِ رامٍ مِن بَني ثُعَلِ",13,"ل",1,0],["أَرمي الحَصى مِن حافِرَيهِ بِمِثلِهِ","وَأَروعُ ضَوءَ الصُبحِ مِنهُ بِضِدِّهِ",14,"د",2,0],["أرمي الطريق بناظري رجل","وأنا لها طفل أضاحكها",15,"ه",2,0],["أَرمي بِها مَعرِضَ الدَوِّيِّ ضامِرَةً","في لَيلَةٍ ما يَذُوقُ النَومَ سارِيها",16,"ي",3,0],["أرماحه لا تزال عالمة","أن ليس بأس كبأس حاملها",17,"ل",3,0],["أَرمَدُ مِن نَأيِها وَلَو قَرُبَت","يَوماً شَفَت عَينَهُ مِنَ الرَمَدِ",18,"د",1,0],["أَرمى وَجَدِّكَ مِن رامي بَني ثُعَلٍ","حَتفٌ لَدَيهِ إِزاءُ الحَوضِ وَالعُقُرُ",19,"ر",1,1],["إِرمِنا يا ظَلامُ في كُلِّ فَجٍّ","فَالمُنى لَم تَزَل تَجُرُّ المَنايا",20,"ا",3,1],["أَرمي بِها عُرُضَ الدَوِّيُّ ضامِزَةً","في ساعَةٍ تَبعَثُ الحِرباءَ مَسمومَه",21,"م",2,0],["أرْمِي النُّحُورَ فَأُشْوِيها وتَثْلِمُنِي","ثَلْمَ الإِنَاءِ فَأَغْدُو غَيْرَ مُنْتَصِرِ",22,"ر",1,0],["أرمق الشاطىء البعيدَ بعينٍ","عكفت في الدجى على التسكابِ",23,"ب",1,0],["أَرمِي به بَقَر الحِمى","وَأَصُدُّ عن عُصُم العواصِمْ",24,"م",1,0],["إِرمِ بِالكَهلِ عَلى جُمهورِهم","تَرمِ مِنهُ بِالشِهابِ المُتَّقِد",25,"د",1,0],["ارم نظارتيك كي أتملّى","كيف تبكي شواطئ المرجان",26,"ن",1,0],["ارم نظارتيك ما أنت أعمى","إنما نحن جوقة العميان",26,"ن",1,0],["أرملة ناحت على أحرارها","ثم ثوت آسفة فيمن ثوى",27,"ا",1,0],["إرمي بمثله جاكت الخي","ل وتأبى لخصمها الإجلاء",28,"ا",2,0],["أرمق الشاطئَ البعيد بعينٍ","عكفت في الدجى على التسكابِ",29,"ب",1,0],["أَرُمُ ثَابِتٌ يَهْتَزُّ فيه","بأكرمِ منبِتٍ فرعٌ أصيلُ",30,"ل",1,0],["أَرَمِدْتَ أَمْ بِنجُومك الرَّمدُ؟","قَد عادَ ضدًّا كُلُّ ما تَعِدُ",31,"د",1,1],["أرمضتني الخطوب في فدفد العي","ش ولم ألف غير دمعي فطرا",32,"ر",2,0],["أرمي بظني وأخلق أن يطيش وفي","عيني ضبابٌ وفي الآفاق أدجان",33,"ن",1,0],["أُرَمِّقُ العَيشَ عَلى بَرصٍ فَإِن","رُمتُ اِرتِشافاً رُمتُ صَعبَ المُنتَهى",34,"ا",1,0],["أَرمي بها البيداء تَفْرقُ جنّها","فيها وتَرميني إلى الآمادِ",35,"د",1,0],["أرميهم بلواحظي","وأمرّ منصرفا لشاني",36,"ن",2,0],["أَرْمَضْتَ يا رمضانُ السِّيئاتِ لنا","بُشْر بِنا للتُّقَى عَلاَّ على نَهَلِ",37,"ل",1,0],["أَرمِي مُعادِيَكم وأَجْبُرُ صَدْعَكُمْ","وأَذُبُّ عن أَعراضِكم مُتَوَرّعا",38,"ع",2,0],["أَرمي بِها الفَلَواتِ ضامِزَةً إِذا","سَمَعَ المُجِدُّ بِها صَريرَ الجُندُبِ",39,"ب",1,0],["أرَمّ لدَيْها هيْبةً كلُّ مادِح","وَأقْصرَ عَجزاً دُونَها كُلُّ مانِح",40,"ح",1,0],["أرمي بها دارَ العَدوّ وفي الحَشا","لِهوَى الأحبّةِ غُلّةً لم تُبْلَل",41,"ل",1,0],["أرمي إليهم بطَرْفِ العَيْن أقسِمُه","بين الرّقيب وبين الإْلف من حَذَر",42,"ر",1,0],["اِرمِ الفُؤادَ بِكُلِّ سَهمٍ تُمضِهِ","لي أَضلُعٌ مِثلُ القِسِيِّ حَوانِ",43,"ن",1,0],["ارمي بضيقتنا في كل نائبةٍ","وَضَمْحلي الداء عنا إنه قاء",44,"ا",2,0],["ارموا بهذه من ورا جبل قاف","يعني الولاية للقضا والأوقاف",45,"ف",1,0],["أَرمي الفِجاجِ بِها لأَلقيَ رحلها","في حَيث تُلقى أَرحلُ الفِتيانِ",46,"ن",1,0],["أرماحُها الشمعُ وأسيافها","نارُ الغَضى والدمُ ماءُ العِنَبْ",47,"ب",1,0],["أرمُّ من أخلاقه ملوّناً","يصبغ لي في كلّ يومٍ خُلُقا",48,"ق",2,0],["أرميا على الهجران والشَّيب واخِطٌ","فهلاّ وفي قوس الشبيبة منزَعُ",49,"ع",1,0],["اِرْمِ بهم على الليالي تَنتصِفْ","بهِمْ على ضعفِك من شِدادِها",50,"د",3,0],["أرمينيا قلت لكن","إنسانة أم ملاك",51,"ك",1,0],["أَرمي فَلا أصمي فإنْ رُمِيَتْ","جهتي رُميتُ معرّضاً نحري",52,"ر",2,0],["أَرمي بِأِيدي العِيسِ إِذ هَويتُ","في بَلدَةٍ يَعيا بِها الخِرّيتُ",53,"ت",1,0],["أرْمَى وكَنْتُ أُصْطَفَى","أُقْلَى وكُنْتُ أُجْتَبى",54,"ب",2,0],["أرَمَيْتَهُ عن قَوسِ أج","فانٍ بسهمٍ من مَرَض",55,"ض",1,0],["أرمس حادثات عهد وأخرى","طامسات الصوى وأخرى قدام",56,"م",1,0],["أرمي قَصيدَهُمُ طرفي وقد سلكوا","بين المُجيمرِ فالرَّوحاءَِ فالوادي",57,"د",2,0],["إرَمٌ في المباسم الفَجْريهْ","وَضَحت أم كواكبٌ دُرّيّهْ",58,"ي",2,1],["أرماحه طعناًُ تقصد في العدا","وندى يديه لقاصد وقصيدِ",59,"د",1,0],["أَرْمِي إِذَا انْشَقَّتْ عَصَا الوَطْواطِ","بِرَجْم أَحْأَى مِقْذَف المِلاطِ",60,"ط",1,0],["أَرْمِي بِأَيْدِي العِيسِ إِذْ هَوِيتُ","فِي بَلْدَةٍ يَعْيَى بِهَا الخِرِّيتُ",61,"ت",1,0],["أَرمَلَ فُطناً أَو يُسَدِّي هَشنَقا","وَلَم تَذُق مِنَ البُقولِ الفُستُقا",62,"ق",2,1],["اِرْمِ شَيْطانَ الهَوَى مِنْ","شُهْبِ طَرْدٍ برُجومِ",63,"م",1,1],["أرمي وترميني شبيهات المها","فسهامها تصمي وسهمي يصردُ",64,"د",1,0],["أرَمِّقُ العَيشَ عَلى بَرضٍ فإِن","رُمتُ ارتِشافاً رُمتُ صَعبَ المُنتَشا",65,"ش",2,0],["أرمي بنَظرَةِ عينٍ لا اصطبارَ لها","من فُرجَةٍ صغُرَت من سجفِها سَرَقا",66,"ق",2,0],["أرميهمُ بالأذى حتى تخالُهُم","مرضى سُلالٍ وما بالقوم من مرضِ",67,"ض",1,0],["أرمي المذاكي لما أرعى على جذع","ولا ثنيٍّ كما يُرمى مدى الغرضِ",67,"ض",1,0],["أرمى العداة بأفراسٍ مكلّمَة","حتى أتخذن على حسّادهّن يدا",68,"د",2,0],["أَرمي بِسَهمي مَن رَماكَ بِسَهمِهِ","وَعَدو مَن عادَيتَ غَيرُ مُكَذَّبِ",69,"ب",1,0],["أرمق الخمسين أستدني الردى","والردى في مهجة الغيب جنين",70,"ن",1,0],["أَرمي بِها بَلَداً تَرميهِ عَن بَلَدٍ","حَتّى أُنيخَت عَلى أَحواضِ ضِرسامِ",71,"م",1,0],["أَرَملَ اِسكندرِيَّة هَل أَراكا","وَأفرِطُ عِقدَ دَمعي في ثَراكا",72,"ك",2,1],["أَرُمتُم مَديحي وَاطَّرَحتُم ثَوابَهُ","وَهَل تُملِكُ الحَسناءُ إِلّا عَلى مَهرِ",73,"ر",1,0],["أرَملَ رَامة حَلّوا أمْ بذي سَلَمِ","يا أخت رَامة الحُلاّلِ والسّلمُ",74,"م",1,0],["أَرمي بِهم وَبِنَفسي مَهمَهاً زَلِقاً","وَعُرضَ مُطَّرِدٍ أَكنافُه سودُ",75,"د",1,0],["أَرمي بِها عُرضَ الفَلاةِ إِذا دَجا","لَيلٌ كَلَونِ الطَّيلسانِ دَهيمُ",76,"م",1,0],["أَرم ضَريحه مر اللَيالي","فَعمره الفَتى عمر الوَسيم",77,"م",1,0],["ارمِ الصواعقَ فوقَ رأسي عاجلاً","أو فارمِها بالقطرِ رمي النّآبلِ",78,"ل",1,0],["ارمم من قبل التداعي ربوعه","اذا ما عفا للحسن في الوجه مربع",79,"ع",1,0],["أَرمَى بنو الرومِ المَرامَ فاخطأُوا","ثُلِمَت أَرُومتُهم بأَثلَمِ فاسِ",80,"س",1,0],["أَرمي بِهِ مِن جَمعِ قَومي مَعشَراً","بوراً أولي جَبرِيَّةٍ وَمَعايِبِ",81,"ب",1,0],["أرمس فوادٍ إن بحرين جاروا","ثراك فلا تنفك أخضر ممرعا",82,"ع",2,0],["أرمس نسيبٍ قد ثوى فيك ماجدٌ","أغر المحيا عبقري الشمائل",83,"ل",1,1],["إرم بها في لهوات الوهاد","وخض بها لجة واد فواد",84,"د",1,1],["أرمصتِ أجفاني بطول البكا","فما لأجفانك لا ترمصُ",85,"ص",1,0],["أَرُمتَ أَنّي أُطيعُ الطَيرَ إِن رَمَحَت","سِيذانِ تَعلَمُ عِندي كَيفَما سَرَحَت",86,"ت",1,0],["أرمت إذاً خبر هول المكر","خبذيها إذاً عبرةً تعتبر",87,"ر",1,0],["أَرمُقُ الحادثات وهي عبيدي","نائِماتٍ في حرمتي وذمامي",88,"م",2,0],["أرمي الغرائر بالغرام إذا امرؤ","جلب الغرام إليه حب غرائر",89,"ر",1,0],["أرمعوا على الرحيل في غد","ويح قلبي من نواهم في غد",90,"د",1,0],["أَرمي زَمَاني ما رَمَى","للعرضِ حتى لا يرام",91,"م",1,0],["أرمتك َ بالحسن البريء صغيرة ٌ","نثرتك َ يا قلبي فما جمعتك َ",92,"ك",1,0],["ارمُقْ بِعَين الرِّضا تنعش بعاطفةٍ","قَبلَ المَنيَّةِ ما أوهيتَ مِن رَمَقِ",93,"ق",1,0],["أرمي شباكي في السرابِ أظنّهُ","ماءً فالقى خيبةَ الخسرانِ",94,"ن",1,0],["أَرْمِيْ بِهِ فِيْ وَجْهِ كُلِّ مُنَافِقِ","ظَنَّ الْغَرَاْمَ فُكَاْهَةًº وَمُزَاْحَاْ",95,"ح",2,0],["أُرمِّزُ حُزنَها فَرَحاً","عَلى وجناتِ مِرآتي",96,"ت",2,0],["أرما لميعاد الرضا","يا هاجري أجل مسمى",97,"م",2,0],["أرمد العين يبغض الحق شمسا","في كهوف الظلام يُسقى الظلام",98,"م",1,0],["إرم الغداةَ من الدجى قِنديلَكْ","فلعلَّ بيْنَ الظلمتين سبيلك",99,"ك",1,1],["أرميتَ لي هُدباً يداوي لهفتي","أم جئتَ تُغرقُ بالعنا مرساكا ؟!",100,"ك",2,0],["إرميه خلفك قال عقلي ناصحا","فأجبت لا خلفي ولا قدامي",101,"م",2,0],["- أرمتك كف الدهر من قوس القضا","فعلى بكاؤك في البسيطة والفضا",102,"ض",2,1],["ارمِ الشباك فلا صيدٌ سواي أنا","ان شئت تسعدني فاسرج قناديلي",103,"ل",2,0],["أرموا على راسه بسيل النيالي","ولا غمّضت عينه ولا بات نايم",104,"م",1,0],["أُرَمِّقُ العَيشَ عَلى بَرضٍ فَإِن","رُمتُ ارتِشافاً رُمتُ صَعبَ المُنتَهى",105,"ا",1,0],["أرمي بعرض القهر ألف قصيدةٍ","لم تكتمل خلقا ولا أتأسَّف",106,"ف",1,0],["أرمي المراجل ياعسى فيهم تكون","ولا قد لقيت الا طلبتك تكوني!!",107,"ن",2,0],["أرمي القصيد يجاري الرّيح يسبقها","سهما أصاب وما ولّى بأنكاس",108,"س",1,0],["ارملت لاتخشئ الخصاصة انّما","آثرت في طيبِ الفقيرِ المفلسِ",109,"س",1,0],["ارْمِي سِلَالَكِ وَاجْتَنِي مِنْ رَوْضَتي","وَرْدًا نَديًّا عَاطِر النَّسَمَاتِ",110,"ت",1,1],["أرمي به الوسواس إن وطئت","رجلاه قلبي تبتغي الرجسا",111,"س",2,0],["أَرَمَتْكَ ليلى بابتسامةِ ثَغرِها؟","فَلأَوقعَتْكَ بِسح