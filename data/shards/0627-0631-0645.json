{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[55,"يا عذولي قد غضضت جماحي","https://www.aldiwan.net/poem29800.html","الخفيف"],[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[55,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[43,"أغدوت أم في الرائحين تروح","https://www.aldiwan.net/poem42377.html","الكامل"],[90,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[53,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[53,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[40,"إني حلفت يمينا غير كاذبة","https://www.aldiwan.net/poem7711.html","البسيط"],[80,"أرمدت أم بنجومك الرمد","https://www.aldiwan.net/poem14197.html","أحذ الكامل"],[47,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[47,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[99,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[22,"يا دار هند عفت إلا أثافيها","https://www.aldiwan.net/poem22028.html","البسيط"],[77,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[52,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[48,"أرمى وجدك من رامي بني ثعل","https://www.aldiwan.net/poem22538.html","البسيط"],[48,"إرمنا يا ظلام في كل فج","https://www.aldiwan.net/poem23618.html","الخفيف"],[15,"لمن جمال قبيل الصبح مزمومه","https://www.aldiwan.net/poem45246.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39565","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/4775","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[98,"إلى البحر","https://www.poetsgate.com/ViewPoem.aspx?id=13194",""],[37,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[80,"أَرمدت أَم بِنجومك الرّمد؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86657&r=&rc=152",""],[124,"إيه عبد الرحمن أذكيت جمرا","https://www.aldiwan.net/poem49274.html","الخفيف"],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[170,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[190,"عيناي ترتع في الملاح","https://www.aldiwan.net/poem43214.html","مجزوء الكامل"],[233,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[233,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[253,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[279,"أحد لسان الشكر جلب المنائح","https://www.aldiwan.net/poem25600.html","الطويل"],[368,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[368,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[370,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[381,"أدعو بمريم في ضري فتنقذني","https://www.aldiwan.net/poem59151.html","البسيط"],[395,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[410,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[436,"وليلة أطلعت في جنحها","https://www.aldiwan.net/poem12571.html","السريع"],[461,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[461,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[461,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[482,"إنسانة أم ملاك","https://www.aldiwan.net/poem36915.html","المجتث"],[554,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[564,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[578,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[746,"","https://poetry.dctabudhabi.ae/diwan/poem/31379","البسيط"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20471","البسيط"]],"verses":[["أرمم سقفا قد تداعى أساسه","وأجبر عظما بعد أن شل صاحبه",0,"ب",2,0],["أَرمَضَت شَمسُكَ المُنيرَةُ فَودي","يَ فَمَن لي بِظِلِّ ذاكَ الغَمامَ",1,"م",1,0],["أَرمَضَتهُ هَواجِرُ الخَطبِ فَاِنقا","دَ حَمولَ الأَذى وَما قالَ هُجرا",2,"ر",2,0],["أَرمي بِأَيدي المَطايا كُلَّ مُشتَبِهٍ","تَنبو بِأَخفافِها عَنهُ الجَلاميدُ",3,"د",1,0],["إِرمي بِمثلِهِ جالَتِ الجِنُّ","فَآبَت لِخَصمِها الأَجلاءُ",4,"ا",2,0],["أَرمِي وَأَطعَنُ ثُمَّ أُتِبعُ ضَربَةً","تَدَعُ النساءَ على الرجالِ تَنُوحُ",5,"ح",1,0],["أرمى مسدسه في صدره بيدٍ","لا تعرف الضعف في المرمى ولا الخورا",6,"ر",2,0],["أرُمتَ زيني بأن تُعرِّضني","لمدحه فالذليل من عَضَدَهْ",7,"د",2,0],["أرمي مَشيمتها برأس مُلَمْلَمٍ","ريّان من ماءِ الشبيبةِ أعْجرِ",8,"ر",1,0],["أرمَتْ سواداً أنتَ في","ه لقد أتتْ أمراً يجلُّ",9,"ل",1,0],["أَرمي بِها كُلَّ مَوماةٍ مُوَدِّيَةٍ","جَدّاءَ غِشيانُها بِالقَومِ تَغريرُ",10,"ر",1,0],["أَرمدتَ أَمْ بِنَجومك الرمدُ","فَقَد عادَ ضدّا كُلُّ ما تَعِدُ",11,"د",1,1],["أَرمي بِهِ شَوكَ القَنا وَأَرُدُّهُ","كَالسَمعِ أَثَّرَ فيهِ شَوكُ العَوسَجِ",12,"ج",1,0],["أَرمي بِظَنّي فَلا أَعدو الخَطاءَ بِهِ","إِعجَب لِأَخطاءِ رامٍ مِن بَني ثُعَلِ",13,"ل",1,0],["أَرمي الحَصى مِن حافِرَيهِ بِمِثلِهِ","وَأَروعُ ضَوءَ الصُبحِ مِنهُ بِضِدِّهِ",14,"د",2,0],["أرمي الطريق بناظري رجل","وأنا لها طفل أضاحكها",15,"ه",2,0],["أَرمي بِها مَعرِضَ الدَوِّيِّ ضامِرَةً","في لَيلَةٍ ما يَذُوقُ النَومَ سارِيها",16,"ي",3,0],["أرماحه لا تزال عالمة","أن ليس بأس كبأس حاملها",17,"ل",3,0],["أَرمَدُ مِن نَأيِها وَلَو قَرُبَت","يَوماً شَفَت عَينَهُ مِنَ الرَمَدِ",18,"د",1,0],["أَرمى وَجَدِّكَ مِن رامي بَني ثُعَلٍ","حَتفٌ لَدَيهِ إِزاءُ الحَوضِ وَالعُقُرُ",19,"ر",1,1],["إِرمِنا يا ظَلامُ في كُلِّ فَجٍّ","فَالمُنى لَم تَزَل تَجُرُّ المَنايا",20,"ا",3,1],["أَرمي بِها عُرُضَ الدَوِّيُّ ضامِزَةً","في ساعَةٍ تَبعَثُ الحِرباءَ مَسمومَه",21,"م",2,0],["أرْمِي النُّحُورَ فَأُشْوِيها وتَثْلِمُنِي","ثَلْمَ الإِنَاءِ فَأَغْدُو غَيْرَ مُنْتَصِرِ",22,"ر",1,0],["أرمق الشاطىء البعيدَ بعينٍ","عكفت في الدجى على التسكابِ",23,"ب",1,0],["أَرمِي به بَقَر الحِمى","وَأَصُدُّ عن عُصُم العواصِمْ",24,"م",1,0],["إِرمِ بِالكَهلِ عَلى جُمهورِهم","تَرمِ مِنهُ بِالشِهابِ المُتَّقِد",25,"د",1,0],["ارم نظارتيك كي أتملّى","كيف تبكي شواطئ المرجان",26,"ن",1,0],["ارم نظارتيك ما أنت أعمى","إنما نحن جوقة العميان",26,"ن",1,0],["أرملة ناحت على أحرارها","ثم ثوت آسفة فيمن ثوى",27,"ا",1,0],["إرمي بمثله جاكت الخي","ل وتأبى لخصمها الإجلاء",28,"ا",2,0],["أرمق الشاطئَ البعيد بعينٍ","عكفت في الدجى على التسكابِ",29,"ب",1,0],["أَرُمُ ثَابِتٌ يَهْتَزُّ فيه","بأكرمِ منبِتٍ فرعٌ أصيلُ",30,"ل",1,0],["أَرَمِدْتَ أَمْ بِنجُومك الرَّمدُ؟","قَد عادَ ضدًّا كُلُّ ما تَعِدُ",31,"د",1,1],["أرمضتني الخطوب في فدفد العي","ش ولم ألف غير دمعي فطرا",32,"ر",2,0],["أرمي بظني وأخلق أن يطيش وفي","عيني ضبابٌ وفي الآفاق أدجان",33,"ن",1,0],["أُرَمِّقُ العَيشَ عَلى بَرصٍ فَإِن","رُمتُ اِرتِشافاً رُمتُ صَعبَ المُنتَهى",34,"ا",1,0],["أَرمي بها البيداء تَفْرقُ جنّها","فيها وتَرميني إلى الآمادِ",35,"د",1,0],["أرميهم بلواحظي","وأمرّ منصرفا لشاني",36,"ن",2,0],["أَرْمَضْتَ يا رمضانُ السِّيئاتِ لنا","بُشْر بِنا للتُّقَى عَلاَّ على نَهَلِ",37,"ل",1,0],["أَرمِي مُعادِيَكم وأَجْبُرُ صَدْعَكُمْ","وأَذُبُّ عن أَعراضِكم مُتَوَرّعا",38,"ع",2,0],["أَرمي بِها الفَلَواتِ ضامِزَةً إِذا","سَمَعَ المُجِدُّ بِها صَريرَ الجُندُبِ",39,"ب",1,0],["أرَمّ لدَيْها هيْبةً كلُّ مادِح","وَأقْصرَ عَجزاً دُونَها كُلُّ مانِح",40,"ح",1,0],["أرمي بها دارَ العَدوّ وفي الحَشا","لِهوَى الأحبّةِ غُلّةً لم تُبْلَل",41,"ل",1,0],["أرمي إليهم بطَرْفِ العَيْن أقسِمُه","بين الرّقيب وبين الإْلف من حَذَر",42,"ر",1,0],["اِرمِ الفُؤادَ بِكُلِّ سَهمٍ تُمضِهِ","لي أَضلُعٌ مِثلُ القِسِيِّ حَوانِ",43,"ن",1,0],["ارمي بضيقتنا في كل نائبةٍ","وَضَمْحلي الداء عنا إنه قاء",44,"ا",2,0],["ارموا بهذه من ورا جبل قاف","يعني الولاية للقضا والأوقاف",45,"ف",1,0],["أَرمي الفِجاجِ بِها لأَلقيَ رحلها","في حَيث تُلقى أَرحلُ الفِتيانِ",46,"ن",1,0],["أرماحُها الشمعُ وأسيافها","نارُ الغَضى والدمُ ماءُ العِنَبْ",47,"ب",1,0],["أرمُّ من أخلاقه ملوّناً","يصبغ لي في كلّ يومٍ خُلُقا",48,"ق",2,0],["أرميا على الهجران والشَّيب واخِطٌ","فهلاّ وفي قوس الشبيبة منزَعُ",49,"ع",1,0],["اِرْمِ بهم على الليالي تَنتصِفْ","بهِمْ على ضعفِك من شِدادِها",50,"د",3,0],["أرمينيا قلت لكن","إنسانة أم ملاك",51,"ك",1,0],["أَرمي فَلا أصمي فإنْ رُمِيَتْ","جهتي رُميتُ معرّضاً نحري",52,"ر",2,0],["أَرمي بِأِيدي العِيسِ إِذ هَويتُ","في بَلدَةٍ يَعيا بِها الخِرّيتُ",53,"ت",1,0],["أرْمَى وكَنْتُ أُصْطَفَى","أُقْلَى وكُنْتُ أُجْتَبى",54,"ب",2,0],["أرميهمُ بالأذى حتى تخالُهُم","مرضى سُلالٍ وما بالقوم من مرضِ",55,"ض",1,0],["أرمي المذاكي لما أرعى على جذع","ولا ثنيٍّ كما يُرمى مدى الغرضِ",55,"ض",1,0],["أَرمي بِها بَلَداً تَرميهِ عَن بَلَدٍ","حَتّى أُنيخَت عَلى أَحواضِ ضِرسامِ",56,"م",1,0]]}