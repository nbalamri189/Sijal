{"poems":[[39,"كأن أكف الناس إن بنت عطفت","https://www.aldiwan.net/poem6906.html","الطويل"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[21,"غدا جيران أهلك ظاعنينا","https://www.aldiwan.net/poem36142.html","الوافر"],[54,"لقد صاح بالبين الحمام النوائح","https://www.aldiwan.net/poem27141.html","الطويل"],[50,"لأقطعن نياط الهم بكاس","https://www.aldiwan.net/poem63429.html","البسيط"],[50,"إلفان كانا لهذا الوصل قد خلقا","https://www.aldiwan.net/poem64455.html","البسيط"],[50,"لا تصحبن أخا نسك وإن نسكا","https://www.aldiwan.net/poem64465.html","البسيط"],[50,"وندمان صدق بل يزيد فكاهة","https://www.aldiwan.net/poem64466.html","الطويل"],[48,"كأن أكوان أعمار نعيش بها","https://www.aldiwan.net/poem23570.html","البسيط"],[146,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[199,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[473,"يا طيب نشوتنا على","https://www.aldiwan.net/poem60023.html","مجزوء الكامل"],[558,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96694","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96735","الوافر"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67882","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45655","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137058",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62773","الطويل"],[4692,"ضاقت بنا الأرض يا الله والسبلُ","https://www.poetsgate.com/ViewPoem.aspx?id=212674",""],[4884,"طفلة الحي","https://www.poetsgate.com/ViewPoem.aspx?id=210420",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5880,"الوحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=208578",""]],"verses":[["كأن أكف الناس إن بنت عطفت","عليها حثاة القبر ذات الرواعدِ",0,"د",1,1],["كَأَنَّ أَكُفَّ القابِلاتِ لِأُمِّهِ","رَمَينَ بِعادِيِّ الأُسودِ الدَراغِمِ",1,"م",1,0],["كَأَنَّ أَكُفَهُم عَذَبٌ مُلقَّىً","وَحُمّاضٌ بأَيدي مُعلِنينا",2,"ن",2,0],["كَأَنَّ أَكُفَّ القَومِ في جَنَباتِهِ","قَطاً لَم يُنَفِّرهُ عَنِ الماءِ سارِحُ",3,"ح",1,0],["كَأَنَّ إِكليلَهُ تاجُ اِبنِ مارِيَةٍ","إِذ راحَ مُعتَصِباً بِالوَردِ وَالآسِ",4,"س",1,0],["كانا كَغُصنَينِ في ساقٍ فَشانَهُما","رَيبُ الزَمانِ وَصَرفُ الدَهرِ فَاِنفَلَقا",5,"ق",2,0],["كَأَنَّ أَكرُعَهُ أَيدٍ مُقَطَّعَةٌ","لا يَرتَجي قَوَداً مِنها وَلا دَرَكا",6,"ك",2,0],["كَأَنَّ أَكُفَّ القَومِ وَالآلَةَ الَّتي","يُديرونَ فيها أَمرَها ضُمِّخَت مِسكا",7,"ك",2,0],["كَأَنَّ أَكوانَ أَعمارٍ نَعيشُ بِها","خَيلٌ يُبَدَّلُ ماضيها بِتاليها",8,"ي",3,1],["كأنا كشطنا عنه جِلدةَ بازلٍ","كسا شحمُه جنبيه والمتنَ والظهرا",9,"ر",2,0],["كَأَنَّ أَكُفَّ السائِلينَ بِبابِهِ","إِذا بُسِطَت وَالقُمصُ عَنها حَواسِرُ",10,"ر",1,0],["كانا كَوَردٍ أَبيَضٍ","مِن فَوقِ وَردٍ أَصفَرِ",11,"ر",1,0],["كَأَنَّ أَكُفَّ القَومِ مَثنى وَمَوحَدا","تَعاطَينَ جادِيّاً عَلى ظَهرِ قَرمَدِ",12,"د",1,0],["كأنّ أكفّ عرارٍ به","عشيّة بالودقِ روّى رياكا",13,"ك",2,0],["كأنّ أكفّه للجو","دِ سيحان وجيحانا",14,"ن",2,0],["كانا كتبر في التراب أرصدا","فمسحت يُمناك عنهما الصّدا",15,"د",2,0],["كأن أكاليل اللآلي سطورها","بشذر ومرجان ودر تكلل",16,"ل",1,0],["كانا كشمسِ نهارٍ في البُروجِ كما","أدارَها ثَمَّ إحكامٌ وتجويدُ",17,"د",1,0],["كَأَنَّ اِكتِتام المُشتَري في سَحابَةٍ","وَديعَةً سرٍ في ضَمير مُذيع",18,"ع",1,0],["كأن اكتشاف العلم كل خبيئةٍ","ليهدم ما الرحمان في الكون شيدا",19,"د",2,0],["كأن اكتشاف الجاذبية غاية","لان تجذب الارواح سلسلة الردى",19,"د",2,0],["كأنّ أكفَّ الرّكْبِ حولَ رِقابِها","تهزُّ أنابيبَ الرِّماح الذّوابِلِ",20,"ل",1,0],["كأن أكتوبرَ التحريرُ صار صدى","وذكْره الحلو مرا، كيف نحتفلُ",21,"ل",1,0],["كأن أكتوبرَ الدنيا وبهجتها","قد مات فينا.. ويحيا دونه هبلُ",21,"ل",1,0],["كأَنَّ أَكفَّه ثملتْ","تضمُّ الطَّيْفَ واحتضنتْ",22,"ت",1,0],["كأَنَّ أَكُفَّ عَرارٍ بِهِ","عَشِيَّةَ بِالوَدْقِ رَوَّى رُباكَا",23,"ك",2,0],["كان إكليلها بمفرقها","ذهبياً، كأنه الفلقُ",24,"ق",1,0]]}