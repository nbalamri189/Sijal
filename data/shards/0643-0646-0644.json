فيني بليه","https://www.poetsgate.com/ViewPoem.aspx?id=202277",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5660,"ما أَصعَبَ الذِكرى عَلى الأَحبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=23715",""],[5663,"مما قالت لي نجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200905",""],[5704,"قُمْ خليلي ...","https://www.poetsgate.com/ViewPoem.aspx?id=198798",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5736,"أين المفر","https://www.poetsgate.com/ViewPoem.aspx?id=203876",""],[4623,"ذكر فان النفع في التذكار ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146607",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[4623,"للحب تبدو وان تخفى علامات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146688",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5830,"كَتبْتُ شِعْرِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=201124",""],[5956,"الجانبان","https://www.poetsgate.com/ViewPoem.aspx?id=193911",""],[6152,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203757",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""]],"verses":[["كنْ لي كما كنتَ لي إذْ كنت لا عملٌ","أرجو ولا ذنبَ قد أذنبتُ أخشاهُ",0,"ا",2,0],["كُن لي كَما كُنتَ لي","في حينِ لَم أَكُنِ",1,"ن",1,1],["كن لدنياه انقطاعاً وشيكاً","وانقلاعاً ليس فيه انخداع",2,"ع",1,0],["كن لي كما كنت للراجين كلهم","لا زال قصرك بالراجين يكتنف",3,"ف",1,0],["كُنَّ لَكَم سَبَباً في كُلِّ مَكرُمَةٍ","وَكُنتُم في شَقاءِ المَرأَةِ السَبَبا",4,"ب",2,0],["كُن لِهاذا الشَعبِ يوسُفُهُ","يَنجُ مِن عَدَمٍ وَمِن عَدَمِ",5,"م",1,0],["كُن لُجَّةً أَيُّها السَماحُ فَقَد","آمَنَهُ سَيفُهُ مِنَ الغَرَقِ",6,"ق",1,0],["كُن لِلمَكارِهِ بِالعَزاءِ مُقَطِّعاً","فَلَعَلَّ يَوماً لا تَرى ما تَكرَهُ",7,"ه",1,1],["كُن لِما قَدَّمتَهُ مُغتَنِماً","لاتُؤَخِّر عَمَلَ اليَومِ لِغَد",8,"د",1,0],["كُن لي مُجيراً مِنَ الأَيّامِ إِنَّ لَها","يَداً تُفَحِّصُ عَن سِرّي وَإِعلاني",9,"ن",2,0],["كنْ لي شفيعاً إنَّ جسمي مثْقل","بالسيِّئاتِ وقدْ شجاني مَنْ شجا",10,"ج",2,0],["كنْ لنا فالأمرُ أمرُ القادرِ","ما لِشَعْبٍ عاجزٍ من ناصِرِ",11,"ر",1,0],["كُن لمَن لامَ عصيّا","واركب الأمرَ الغويّا",12,"ي",2,1],["كنْ للسلامِ وقاءَه ولواءَه","وشعاعه الهادي على الأرمانِ",13,"ن",1,0],["كُنْ لِلْوِزَاَةِ سَاعِداً","وَتَوحَّدَا رَأْياً وَلُبَّا",14,"ب",2,0],["كن لماذا لم تثر لفتة ؟","ولا استفزت لمحة كاشفه",15,"ف",2,0],["كن للسلامِ وقاءَه، ولواءَه","وشعاعَه الهادي على الأزمانِ",16,"ن",1,0],["كن لعبه في مطانيج الصداوي.؟","لعب .؟ ماشستر. ليا حس . أبهزيمه",17,"م",2,0],["كن لي على الودّ كمهدي عاقدا","لا زلتُ للأسواء فيكَ فاقدا",18,"د",2,0],["كُنْ لِلْوِزَارَة ِ سَاعِداً","وَتَوَحَّدَا رَأْياً وَلُبَّا",19,"ب",2,0],["كن للحب خاتماً وأراها","عبثاُ ما طبعن في الأجياد",20,"د",1,0],["كن لي فأتى استهلت","على الثرى ديمة الشؤون",21,"ن",1,0],["كن لي اذا ما نهار العرض لي عرضت","جرائمي وغدا في موقفي طول",22,"ل",1,0],["كن لي مجيراً في زمانٍ به","قوارع أسهمها ترشق",23,"ق",1,0],["كُن لي بِطَرفِكَ راعِياً يا مَن لَهُ","طَرفٌ بِرَعيِ العالَمينَ مُوَكَّلُ",24,"ل",1,0],["كن لي اذا أَغمضوا عيني وانصرفوا","باكين أسمع منهم كل ما قالوا",25,"ل",3,0],["كُن لِنَفسي معينا","ان هوت في هَواها",26,"ا",3,0],["كُنْ لِي شَفِيعاً إلى إمَامٍ","لَيْسَ عَلى فَضْلِهِ مَزيدُ",27,"د",1,0],["كُنْ لي جَوَاباً فَلفظي","إليكَ لَفْظٌ وَجِيزْ",28,"ز",1,1],["كُن لِي كَمَا أنتَ فِي نَفسِي فَقَد عَقَدَت","بَينِي وَبَينَكَ أَسبابُ العلا قُرُبا",29,"ب",2,0],["كنْ ليَ الماءَ إذا خفْتُ صدىً","وسَنا النّارِ إذا خُضْتُ الظَّلاما",30,"م",2,0],["كن لديه مقرَّباً","ناكس الراس مطرِقا",31,"ق",2,0],["كُن لي وكيلاً على الرّؤيِا ووكّلْ لِي","سواكَ يَسمعُ عَنّي شَدوَ رضْوانِ",32,"ن",1,0],["كن لي فرالي غير رابك في الورى","أبداً لترعم بالعطايا حسّدي",33,"د",2,0],["كن لي كعادتك التي عودتها","عند الملك منجزاً لنواله",34,"ل",2,0],["كن لي شفيعاً وهب لي منك عائدةً","بها لعمري تنزيل العسر والضرعا",35,"ع",2,0],["كن لنا يا ربنا رغم الزمان","واقياً وانشر لنا برد الأمان",36,"ن",1,0],["كن لي على شكر ما أوليت من نعم","عوناً فإني بحق الشكر لم أقم",37,"م",1,1],["كنْ له جانباً حَريزاً من الخَوْ","فِ وحِصْناً من الخطوبِ منيعا",38,"ع",2,0],["كن لمن يدعي الصلاح محبّاً","واحترم منه خرقة الأكياسِ",39,"س",1,1],["كن له لا لسواه أبداً","وانغسِلْ عنك به وانمسح",40,"ح",1,0],["كُنْ لهٌ مِنْهُ وصِلْهُ واحْمِهِ","فهو في قبضةِ دنياهُ الصريعْ",41,"ع",1,0],["كُن لي وَحَقَّكَ في المَواقِفِ شاهِداً","فَلَطالَما أَحيَيتَ مَن أَحياكا",42,"ك",2,0],["كن لِلزَّمانِ كما يكُونُ فإنَّه","أوفى بَنيهِ وإن تَخَلَّقَ غادر",43,"ر",1,0],["كُنْ لِدارٍ شَيَّدْتَها خَيْرَ نازِلْ","في هَناءٍ وسامِياتِ مَنازِلْ",44,"ل",1,1],["كُن لي إذا الرُّسلُ الكرامُ تعاظمت","ذَنبي فظنَّت أَنَّهُ لا يُغفَرُ",45,"ر",1,0],["كُن لِلدّعاءِ جاعِلا","قبولَهُ لَنا نَصيب",46,"ب",1,0],["كُن للنّجومِ مُسامِراً حينَ السُّرى","هاتيكَ خَيرُ مُسامِرٍ لَكَ يوجدُ",47,"د",1,0],["كُن للزَمانِ كَما تكون فإنّه","متقلّبُ الحالاتِ في تكوينهِ",48,"ن",2,0],["كُن لما أرجو ملاذاً","واِسقني غيثك هذا",49,"ذ",2,0],["كن للأقارب ما حييت مواسياً","ولدى الجوارِ تحيةً وسلاما",50,"م",2,1],["كن لي أماناً يا ابن آمنةِ الرضا","من هولِ كل بليةٍ وعناءِ",51,"ا",2,0],["كن لي مجيرا إذا ما شب جمر لظى","وشيب الهول فيه رأس أطفال",52,"ل",1,0],["كن لي شفيعا يوم لا يغني امرؤ","عنّي ولا أحد إليه ألتجي",53,"ج",2,0],["كن لي شفيعا إذا ما شب جمر لظى","نار الغضا وأغثني منك بالفرج",54,"ج",1,0],["كن لي مجيرا إذا ما شب جمر لظى","والناس من طول يوم العرض في وجل",55,"ل",1,0],["كن لي شفيعا يوم لا يغني امرؤ","عني ولا أحد هنالك ينفع",56,"ع",1,0],["كن لي وأغثني وأغنني وأعنّي","فالمعرق في المجد والسيادة معوان",57,"ن",1,0],["كن لي شفيعا يوم لا يغنى الورى","فيه شفاعة صاحب وخدين",58,"ن",1,0],["كن لي شفيعا في معادي إذا","ما أم مولود أباه أباه",59,"ا",2,0],["كن لي مجبرا إذا هاجت سعيرا لظى","والناس بين سعيد في الورى وشقي",60,"ق",2,0],["كن لهم صاحِباً حَريصاً عليهم","ها هنا تحظ منهم بالجوار",61,"ر",1,0],["كنَّ لكم حَرَماً في الارض محترماً","كنتم لهنَّ عبادَ الحبّ في رهب",62,"ب",1,0],["كن لي الهي يوم ما","تبلى السرائر في الخطر",63,"ر",1,0],["كن لهُ في النَدى شواهِدَ صِدقٍ","مِن أَيادٍ بَيَّضنَ سُودَ الأمانِي",64,"ن",2,0],["كَن لنا عوناً وذخراً","يا إله العالمين",65,"ن",1,0],["كُن لنا في هَذِه الدّنيا وفي","هَولِ الاخرى آخِذا مِنَّا بِيَد",66,"د",1,0],["كُن له عوناً على أعدائه","واكفهِ شرّ حَسُود قد حَسَد",66,"د",1,0],["كُن لِى إِذا ماالخَلقُ أَجثُوا خُشَّعاً","لاَ يَنطِقُونَ وَلَيسَ ثَمَّ مِزَاحَا",67,"ح",2,0],["كن لي إلى الله شفيعا إن لي","جرائما أخافها من الردى",68,"د",2,0],["كن له شاكراً واحمده في كلّ الأحوال","ما ذخر ذاخر ذخرا كما حسن الأعمال",69,"ل",1,0],["كُن لَهُ في كِلادا","رَيهِ حِصناً مُشادا",70,"ا",1,0],["كَن لَهُ مِن حَوادث الدَهر حام","وَشَفيعاً إِذا نَشَرت لواكا",71,"ك",2,0],["كن لي شفيعاً يوم لا شفاعة","الا بكم فكل ذنب يغتفر",72,"ر",1,0],["كُن لِمَا لا ترجُو أشَدَّ رَجاءً","وارْجُ رَبَّاً للعالمين كَرِيمَا",73,"م",2,1],["كُن لَنا صارِماً نَكُن لَك درعا","يَتلقى من دونك الحاقِدينا",74,"ن",2,0],["كن للرؤوس فَدتكَ نفسي ناثراً","كيما أكونَ لمدحِ طَبِعك ناظماً",75,"م",2,0],["كن لتلك العيون سَمْلاً وللأَسْ","ؤُقِ كَبْلاً وللسواعدِ غُلاّ",76,"ل",2,0],["كُن لي رَحيماً معينا وَاِستَجِب طَلَبي","يا باسِطَ الرِزقِ اِنتَ العَونِ وَالمدد",77,"د",1,0],["كن للصغير أباً ووقّر كل ذي","سنّ وبرّك إن جفوا لا تقطع",78,"ع",1,0],["كُن لي إلهى كَما قَد كُنت لي قِدَماً","وَأَهدني سبلاً للرُشد فَيحاء",79,"ا",2,0],["كن لي على النعمة عوناً أكن","عوناً لقلبي في العذاب الأليم",80,"م",1,0],["كن لقلبي بعض يوم ولتكن","كل يوم لك صبحاً ومساء",81,"ا",2,0],["كُنْ لي شفيعاً يومَ لا مُشَفَّعٌ","سِواكَ يُنْجي الخائفين مِن لَظَى",82,"ا",1,0],["كُن لي كما كنتَ لي إذا لم أكن شيا","يا من بهِ ليسَ إلا قامتِ الأشيا",83,"ي",2,1],["كُن لي كما كنتَ لي إذا لم أكن شيا","يا من بهِ طابتِ المماتُ والمحيا",84,"ي",2,1],["كن لي وللبنين والبناتِ","وللمحبّين بكل آتِ",85,"ت",1,0],["كن لي وكن لما نسبتَه لِيا","صلِّ وسلِّمَنْ على النبي لِيا",86,"ي",2,0],["كن لي وأعطني عطاءك الكملْ","حتى أُرى كأنَّني أزكى عملْ",87,"ل",1,0],["كن لي وكن لحضرتي","في ذي الحياة والمماتْ",88,"ت",1,0],["كن لي بموتي والحياة فإنني","ممن إليك مماتهم وحياتهم",89,"م",1,0],["كن لي وكن لمالي والأولادِ","من شرِّ ما في العُلْوِ والبلادِ",90,"د",1,0],["كن لي وكن لمن أحبّني ولا","تُشمتْ بنا عدوَّنا يا ذا العلى",91,"ل",2,0],["كن لي بعونك أيا ذا العونِ","وعزّني إلهَنا في الكونِ",92,"ن",1,0],["كن لي وأعطني مقاماً سرمدا","يحمدُه جميع من قد وَجدا",93,"د",2,0],["كُن لِنُصحِكَ يَزينُكَ الدَهرُ واعي","وَعَنِ الفَحشِ وَالخَناذا اِمتِناع",94,"ع",1,0],["كُن للعشيرة فِي الأمور إِذَا عرت","كهفاً وعنها فِي الخُطُوب مُدَافِعا",95,"ع",2,0],["كن لدى جلوتها منتبها","فعلى تكييفها طال اللجاج",96,"ج",1,0],["كُن لي إذا كُشِف الغطاء وجئت يو","م الجمع بين الناس كالمسجون",97,"ن",1,0],["كن لنا شافعا من النار في الحشر","وغوثا يا خير مولى وآلا",98,"ل",2,0],["كن لي شفيعا في القيامة من لطى","لهب تضاءل عنده الشفعاء",99,"ا",2,0],["كن لي شفيعا إذا ما قمت من جدثي","في موقف تستطير العقل رؤياه",100,"ا",2,0],["كن لي الشفيع إذا الجحيم تسعرت","وغدت تشوه للوجوه وترمض",101,"ض",1,0],["كن لي شفيعا إذا ما قمت مندهشا","من مرقدي يوم لا تغنى القرابات",102,"ت",1,0],["كن لي فمن لي ارتجيه لموقفي","والخلق في يوم الحساب قيام",103,"م",1,0],["كن لي الشفيع من الذنوب إذا اغتدت","تلك الخلائق في القيامة تلهث",104,"ث",1,0],["كن لينا بين الورى متواضعا","ترفع وتحمد في جميع الألسن",105,"ن",1,1],["كُن لهُ مَولايَ لا زِلت له","سيّدَ الساداتِ وَالرُسلِ الكِرام",106,"م",1,0],["كن له دُنيا وأخرى شافِعاً","يا شَفيع الخلق في يوم الزِحام",106,"م",1,0],["كن لِهذا الصبّ مَلكوم الحَشا","زادَه البَينُ سَقاماً في سقام",106,"م",1,0],["كن لِمَن يَبكي بكا الثَكلى إِذا","ما رَأى طيبة يَوماً في المَنام",106,"م",1,0],["كُن لِمَن ذاب لَها وجداً وللر","رَوضَة الغُرّا وَذياك المَقام",106,"م",1,0],["كُن لي رَسول اللَهِ في","جَمع القُلوب وَقرع صعبه",107,"ب",2,0],["كن لائذاً بالصالحين وجاههم","فبهم ستكشف في المآل خطوب",108,"ب",1,0],["كن لائذاً بذرا الصحابة كلهم","فلهم بنانُ المعلوات أشارا",109,"ر",2,0],["كن لي معيناً وكن لي ناصر