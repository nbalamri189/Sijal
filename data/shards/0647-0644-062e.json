{"poems":[[55,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[71,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[83,"وشى بسري في موسى وأعلنه","https://www.aldiwan.net/poem61442.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[147,"إن الفريق مذ استقل مغربا","https://www.aldiwan.net/poem11726.html","الكامل"],[147,"ما عليها أوان تطوي الفيافي","https://www.aldiwan.net/poem11782.html","الخفيف"],[228,"كم سهرت الساعات في الظلماء","https://www.aldiwan.net/poem41868.html","الخفيف"],[295,"أسفا لقد طفىء السراج","https://www.aldiwan.net/poem11668.html","مجزوء الكامل"],[302,"هاتا أعيدا لي حديثي القديم","https://www.aldiwan.net/poem33164.html","السريع"],[347,"ما أنت حتى تسفكي أدمعي","https://www.aldiwan.net/poem55352.html","السريع"],[408,"يا منكرا فضل بني أحمد","https://www.aldiwan.net/poem46505.html","السريع"],[408,"يا منكرا فضل بني أحمد","https://www.aldiwan.net/poem46965.html","الطويل"],[409,"برح الخفا ما الدار دار مقام","https://www.aldiwan.net/poem33416.html","الكامل"],[458,"مقبل الراحة النكراء مزدهيا","https://www.aldiwan.net/poem61609.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122690","البسيط"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96315","الرجز"],[1651,"","https://poetry.dctabudhabi.ae/diwan/poem/138878",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100951","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105012","الكامل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128114","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138456",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108051","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44900","الكامل"],[4130,"","https://poetry.dctabudhabi.ae/diwan/poem/198746","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97073","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76738","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120487","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204203",""],[4684,"فذلكة في مفتاح بحر الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=201106",""],[4749,"فوق الدفاتري دونت أخباري","https://www.poetsgate.com/ViewPoem.aspx?id=155781",""],[4852,"هيأتُني ورقا","https://www.poetsgate.com/ViewPoem.aspx?id=214349",""],[4929,"الموت القادم من الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=199561",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5187,"ليلة مع الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=29247",""],[5219,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=195012",""],[5461,"طالت القامات","https://www.poetsgate.com/ViewPoem.aspx?id=5039",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[5596,"عبق الزهر","https://www.poetsgate.com/ViewPoem.aspx?id=205463",""],[5674,"أمشي ودربي غائرة","https://www.poetsgate.com/ViewPoem.aspx?id=186057",""],[5674,"أمشي ودربي عاثرة","https://www.poetsgate.com/ViewPoem.aspx?id=187634",""],[5736,"هزائم","https://www.poetsgate.com/ViewPoem.aspx?id=203830",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5939,"بي لها","https://www.poetsgate.com/ViewPoem.aspx?id=179999",""],[5956,"شكراً دعوتِ لطفلتي أن تشتفي","https://www.poetsgate.com/ViewPoem.aspx?id=202659",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""]],"verses":[["هَل خَبَّرَت لَمّا أَتَت بِكَ ما الَّذي","في مَهدِها أَو ما يَصُمُّ حَزيمُها",0,"م",3,0],["هل خانكِ المخزونُ من دمعَةٍ","بكى بها عنك فمن خان هان",1,"ن",1,0],["هلْ خليلٌ بالبكا لي مُسعدٌ","هلْ صديقٌ يُرتجى أو يؤلَفُ",2,"ف",1,0],["هَل خالُهُ بِدَمي أَم سَيفُ ناظِرِهِ","قَد ضاعَ ثَأرِيَ بَينَ الهِندِ وَالحَبَشِ",3,"ش",1,0],["هل خالد الا فتى من فهر","لم يشتهر بصولةٍ وقهر",4,"ر",1,0],["هَل خافَ مِن عَدواكِ حينَ أَمَرتِهِ","أَن لا يُلِمَّ تَجَنِّياً وَتَجَنُّبا",5,"ب",2,0],["هَل خَلا قَطُّ مِن قَوادِمِهِ الطَا","ئِرُ إِلّا وَبانَ عَجزُ الخَوافي",6,"ف",2,0],["هَل خَلَقتَ الغَنِيَّ لِلمَجدِ","وَالبائِسَ أَوجدتَهُ تُرى لِلشَقاءِ",7,"ا",2,0],["هل خلف هاتيك الرموس","رأيت نوراً أم ضباب",8,"ب",1,0],["هَل خفرَ العَهدَ أُهيلُ الحِمى","بعديَ أَم يَرعون عَهدي القَديم",9,"م",1,0],["هل خلتِ يا هذي باني فتى","اذوب كالشمعة ان تسطعي",10,"ع",2,0],["هَلْ خاتمُ الرّسْلِ سِوى جدِّهم","أَمْ هَلْ أتَى في غيرِهمْ هَلْ أَتى",11,"ت",2,0],["هَل خاتم الرُّسْلِ سِوى جدِّهمْ","وهَلْ أتَى في غيرِهم هَل أتى",12,"ت",2,0],["هل خلدت أبواك أم هل خلدت","ذا عزة من سوقة وإمام",13,"م",1,0],["هل خابَ ظَنِّي فَيمن كنت أَعبدهُ","أم الضمائرُ كالثرواتِ تَصنعها",14,"ع",3,0],["هَل خاشنَ الصَّخرَ إلاَّ من بِه بَلَهٌ","وَحاسَنَ البَدرَ إلاَّ مَن بِهِ حَمَقُ",15,"ق",1,0],["هل خُبِّر السِّرحان إذ يستخبر","عنّي وقد نام الصِّحابُ السُّمّرُ",16,"ر",1,1],["هل خبّر القبر سائليه","أم قر عينا بزائريه",17,"ي",2,1],["هل خُبِّرَ الركبُ ما بي ليلةَ اغتربوا","قلب خَفوق وجَفن دمعه سَربُ",18,"ب",1,1],["هَل خَالَفَ العُقَلاَءُ أنَّ الله رّبُّ","العَالَمِينَ مُدَبِّرُ الأكوَانِ",19,"ن",1,0],["هل خولوك من الشفاعة ما به","أحظى وأحيا في الجنان مخلدا",20,"د",2,0],["هل خطيبُ المجدِ أستاذُ العُلا","ماتَ وجداً في رياضِ الحرمِ",21,"م",1,0],["هل خلا من سناه دهرٌ وسرمد","فهو قبل الإيجاد قد كاد يوجد",22,"د",1,0],["هل خجلتم من الرقيب فاعرض","تم وبنتم عن أعيني التائقات",23,"ت",1,0],["هَل خَبروك بدوحة فَينانة","مَخضلة الأَغصان بَيضاء الشيمْ",24,"م",1,0],["هل خرّجتك مدارس ومعاهد","أو جامعاتُ «مِشِيجَن» و«إِدِنبَرا»",25,"ر",2,0],["هل خبا بعد محصنات حسين","ساتر دون محصنات نزار",26,"ر",1,0],["هل خدعةٌ بتحية مخفية","في جنب موعدك الذي لا يصدق",27,"ق",1,0],["هل خادم السلطان وهو مكرم","ام خادم القسيس وهو مهين",28,"ن",1,0],["هل خلصت من هجنة وعاب","وسلمت من عيبة العياب",29,"ب",1,0],["هل خلقنا كي يكون الداء زاداً","في قرانا والحبالى مرضعاتُ",30,"ت",1,0],["هل خاضَ شِعري قِصةً فيها الهوى","مستسلمٌ للبحرِوالأسفار",31,"ر",1,0],["هل ..خَرَّ تَلُّ هوىً .. إِنْ زِيْدَ نجوانا؟","أم باتتِ الدنيا .. ماذا إذا شَهِقَا؟",32,"ق",2,0],["هل خائنٌ إلا وأنتَ ضميرُه","أو سارقٌ إلا بكفك يسرقُ",33,"ق",1,0],["هَلْ خَتَمْنَاْ الْبَدْرَ مِنَّاْ خَتْمَ رُوْحَيْنَاْ وَنَالْ","مَنْ لَقَاْنَاْ وَحْيَ سِحْرٍ وَاعْتَرَاْهُ الإِحْتَيَالْ",34,"ل",1,0],["هلْ خفقُ قلبي إذا ما اشْتَدَّ مِن وَلَهٍ","أمْ حينَ غنَّيتِ جُنَّ الكأسُ والوتَرُ",35,"ر",1,0],["هل خنت عهد الصبا أيام زهوتها ؟","أم إنه الدهر قد دارت دوائره ؟",36,"ر",2,0],["هل خير .. وحل خير .. وعم خير","ويسر الله كل امر في عسير",37,"ر",1,1],["هل خلا منها حُماها","يا ترى هذي البطاح",38,"ح",1,0],["هل خصّك الزهر بألوانه","وعطره أم كنت بهما احقّ",39,"ق",1,0],["هل خار وحي الشعر أم","أنّ القوافي ودّعت أم ناكرةْ",40,"ر",2,0],["هل خار وحي الشعر","أم أنّ القوافي كافرةْ",41,"ر",2,0],["هل خانني العزف في لحنٍ وأغنيةٍ","حتى تبدّى شحوبا وجهُ أغنيتي؟",42,"ت",2,0],["هل خانَها الصبرُ الذي هو خائنٌ","يومَ الرحيل فخانَهُنّ المدمَعُ",43,"ع",1,0],["هل خانني حبّي لها؟","أملا غَرورًا بي لَها؟",44,"ل",3,1],["هل خالدٌ إلا المهيمنُ وحدُه؟","وابن الوليد أرى يُسمَّى حامدا",45,"د",2,0],["هَلْ خَلَتْ جُعْبَتُهُمْ في مَرَّةٍ","مِنْ دَمَارٍ شَامِلٍ عَاتٍ مَرِيدْ؟",46,"د",1,0]]}