{"poems":[[53,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[69,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[81,"وشى بسري في موسى وأعلنه","https://www.aldiwan.net/poem61442.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[143,"إن الفريق مذ استقل مغربا","https://www.aldiwan.net/poem11726.html","الكامل"],[143,"ما عليها أوان تطوي الفيافي","https://www.aldiwan.net/poem11782.html","الخفيف"],[223,"كم سهرت الساعات في الظلماء","https://www.aldiwan.net/poem41868.html","الخفيف"],[290,"أسفا لقد طفىء السراج","https://www.aldiwan.net/poem11668.html","مجزوء الكامل"],[297,"هاتا أعيدا لي حديثي القديم","https://www.aldiwan.net/poem33164.html","السريع"],[342,"ما أنت حتى تسفكي أدمعي","https://www.aldiwan.net/poem55352.html","السريع"],[402,"يا منكرا فضل بني أحمد","https://www.aldiwan.net/poem46505.html","السريع"],[402,"يا منكرا فضل بني أحمد","https://www.aldiwan.net/poem46965.html","الطويل"],[403,"برح الخفا ما الدار دار مقام","https://www.aldiwan.net/poem33416.html","الكامل"],[453,"مقبل الراحة النكراء مزدهيا","https://www.aldiwan.net/poem61609.html","البسيط"]],"verses":[["هَل خَبَّرَت لَمّا أَتَت بِكَ ما الَّذي","في مَهدِها أَو ما يَصُمُّ حَزيمُها",0,"م",3,0],["هل خانكِ المخزونُ من دمعَةٍ","بكى بها عنك فمن خان هان",1,"ن",1,0],["هلْ خليلٌ بالبكا لي مُسعدٌ","هلْ صديقٌ يُرتجى أو يؤلَفُ",2,"ف",1,0],["هَل خالُهُ بِدَمي أَم سَيفُ ناظِرِهِ","قَد ضاعَ ثَأرِيَ بَينَ الهِندِ وَالحَبَشِ",3,"ش",1,0],["هل خالد الا فتى من فهر","لم يشتهر بصولةٍ وقهر",4,"ر",1,0],["هَل خافَ مِن عَدواكِ حينَ أَمَرتِهِ","أَن لا يُلِمَّ تَجَنِّياً وَتَجَنُّبا",5,"ب",2,0],["هَل خَلا قَطُّ مِن قَوادِمِهِ الطَا","ئِرُ إِلّا وَبانَ عَجزُ الخَوافي",6,"ف",2,0],["هَل خَلَقتَ الغَنِيَّ لِلمَجدِ","وَالبائِسَ أَوجدتَهُ تُرى لِلشَقاءِ",7,"ا",2,0],["هل خلف هاتيك الرموس","رأيت نوراً أم ضباب",8,"ب",1,0],["هَل خفرَ العَهدَ أُهيلُ الحِمى","بعديَ أَم يَرعون عَهدي القَديم",9,"م",1,0],["هل خلتِ يا هذي باني فتى","اذوب كالشمعة ان تسطعي",10,"ي",1,0],["هَلْ خاتمُ الرّسْلِ سِوى جدِّهم","أَمْ هَلْ أتَى في غيرِهمْ هَلْ أَتى",11,"ت",2,0],["هَل خاتم الرُّسْلِ سِوى جدِّهمْ","وهَلْ أتَى في غيرِهم هَل أتى",12,"ت",2,0],["هل خلدت أبواك أم هل خلدت","ذا عزة من سوقة وإمام",13,"م",1,0],["هل خابَ ظَنِّي فَيمن كنت أَعبدهُ","أم الضمائرُ كالثرواتِ تَصنعها",14,"ع",3,0]]}