{"poems":[[55,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[55,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[65,"خاض الدجى ورواق الليل مسدولب","https://www.aldiwan.net/poem46219.html","البسيط"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"ألا إنما الإخوان عند الحقائق","https://www.aldiwan.net/poem62188.html","الكامل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"يا بؤس كلبي سيد الكلاب","https://www.aldiwan.net/poem62453.html","الرجز"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[119,"عقولنا وسعت كل الشؤن بها","https://www.aldiwan.net/poem41214.html","عموديه"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[193,"ألا حبذا بين النخيل نزول","https://www.aldiwan.net/poem35151.html","الطويل"],[216,"فها كبدي من محجري تسيل","https://www.aldiwan.net/poem37841.html","الطويل"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[242,"مضوا كأن لم يكونوا","https://www.aldiwan.net/poem19280.html","المجتث"],[275,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[371,"أتملأ من خديك كأس مدامة","https://www.aldiwan.net/poem17095.html","الطويل"],[447,"تروح المنايا في البرايا وتغتدي","https://www.aldiwan.net/poem14444.html","الطويل"],[498,"كل الأمور إلى من","https://www.aldiwan.net/poem67375.html","المجتث"],[505,"لولاك لم تلو في الآفاق بارقة","https://www.aldiwan.net/poem37934.html","البسيط"],[543,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[556,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[563,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[567,"لكل قلب حبيب ظل يهواه","https://www.aldiwan.net/poem52742.html","البسيط"],[567,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83339","الوافر"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39122","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48899","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37986","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96362","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96741","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133833","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64835","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6758","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64488","الطويل"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202561","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27681","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137023",""],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105330","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133978","الطويل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137983",""],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71301","المنسرح"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92027","البسيط"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22813","المتقارب"],[4767,"مخابز","https://www.poetsgate.com/ViewPoem.aspx?id=180939",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[5444,"الدولار","https://www.poetsgate.com/ViewPoem.aspx?id=205443",""],[5533,"دَرْبُ المَحَبَّة","https://www.poetsgate.com/ViewPoem.aspx?id=183841",""],[5910,"لِلَّيلِ في أعيُني","https://www.poetsgate.com/ViewPoem.aspx?id=206317",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[6035,"ياابن الوليد وياسعد وياعمرو","https://www.poetsgate.com/ViewPoem.aspx?id=175127",""],[6152,"الصبح دونكِ ظلمة","https://www.poetsgate.com/ViewPoem.aspx?id=203114",""],[6225,"تسرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78013&r=&rc=100",""]],"verses":[["وَكُلُّ صَباحٍ شاحِبٍ مِن عَجاجَةٍ","وَشائِعُ بُردٍ بِالعَواني مُسَهَّمِ",0,"م",1,0],["وَكُلُّ صِلٍّ لامِظٍ","يَطلُبُ رَيّاً لِلصَدى",1,"د",2,0],["وكُلَّ صَحْبِكَ أهوى فالهُدى مَعَهُمْ","وغَرْبُ مَن أبغَضَ الأخيارَ مَفلولُ",2,"ل",1,0],["وكلُّ صوع مبهت المفاجي","كالبرقِ يخطو فوقَ ليلٍ داجي",3,"ي",1,0],["وكلُّ صقر مسبل الجناح","مواصل الغدوّ والرَّواح",3,"ح",1,0],["وَكُلُّ صَديقٍ لَيسَ في اللَهِ وُدُّهُ","فَإِنّي بِهِ في وُدِّهِ غَيرُ واثِقِ",4,"ق",1,0],["وكلَّ صَيودِ الإنسِ والوحش ثم لا","يُسائلُ أيٌّ منهُمُ كان أحضَرا",5,"ر",2,0],["وَكُلُّ صَقرٍ طالِعٍ وَثّابِ","يَختَطِفُ القُطّانَ في الرَوابي",6,"ب",2,0],["وَكُلُّ صَموتٍ نَثلَةٍ تُبَّعِيَّةٍ","وَنَسجُ سُلَيمٍ كُلَّ قَضّاءَ ذائِلِ",7,"ل",1,0],["وكلُّ صَمُوتٍ في الصّوانِ كأَنَّها","إذا لُبِسَتْ نَهيٌّ من الماءِ مُتْرَعُ",8,"ع",1,0],["وكل صنف حفظنا حق حرمته","فحرمة النوع حكم الدين والادب",9,"ب",1,0],["وَكُلُّ صَديقٍ وَاِبنُ أُختٍ نَعُدُّهُ","وَجَدنا لَعَمري غِبَّهُ غَيرَ طائِلِ",10,"ل",1,0],["وَكُلُّ صامِتَةٍ فيها وَناطِقَةٍ","تَدعو لَكَ اللَهَ إِسراراً وَإِعلانا",11,"ن",2,0],["وَكلّ صنوفِ الفضلِ في كلِّ فاضلٍ","بِنسبةِ فضلٍ قد حواه قليلُ",12,"ل",1,0],["وكلُّ صحيحٍ من مفاصِلنا غدا","من الهَمِّ بالتفريقِ فهو عَلِيْلُ",13,"ل",1,0],["وكل صحابي رآه ففضله","على غيره في نيله ليس يُطمع",14,"ع",1,0],["وَكُلُّ صَعْبٍ شَدِيدٍ","فَبِالْمُضَيِّ يَهُونُ",15,"ن",1,0],["وكلَّ صَبيحةٍ ألقي سلاماً","على فِتيانِك المُستَبسِلينا",16,"ن",2,0],["وَكُلُّ صَباحٍ بَعدَ فُرقَتِها دُجىً","وَكُلُّ لِحاظٍ جالَ في عَينِها عَمى",17,"م",2,0],["وكل صديق صادق في وداده","فصل حبله بالوصل منك وجدد",18,"د",1,0],["وَكُلُّ صَعبٍ عَسيرٍ","عَلَيهِ سَهلٌ يَسيرُ",19,"ر",1,0],["وكلُّ صَديقِ عزمٍ في حِماكَ له","رُبوضُ قلبٍ ويُلقى دونَهُ الدَّرَكُ",20,"ك",1,0],["وكلِّ صَانِغٍ وما","قد صَنَعت يَداه",21,"ا",2,0],["وَكلَّ صَفيحٍ بِالضّرابِ مُثَلَّمٍ","وكلَّ وشيجٍ بالطّعان مكسَّرِ",22,"ر",1,0],["وكل صب","لقاك رائم",23,"م",1,0],["وكل صفات الكون فهي صفاتها","وتنزيهها في الكون بالكون شائع",24,"ع",1,0],["وكلُّ صَبٍّ سيسلو دونَ عاشِقها","فذاكَ يُبقِى هواها طيَّ أحشاهُ",25,"ا",2,0],["وكُلُّ صِنفٍ لهُ وَقتٌ يُرادُ بهِ","فَلا يَصِحُّ لهُ من غَيرهِ بَدَلُ",26,"ل",1,0],["وَكُلُّ صُعوبَةٍ فَلَها سُهولُ","وَكُلُّ سُهولَةٍ فَلَها عِقابُ",27,"ب",1,0],["وكُلُّ صَعْبٍ جُمُوحٍ","يَنْقادُ طَوْعَ اللِّجامِ",28,"م",1,0],["وكل صنيع أنت في مصر صانع","لك الدهر بين الأولين أخ وابن",29,"ن",1,0],["وَكلُّ صِعابِ المُؤلِماتِ إِذا قَضَت","عَلَيَّ بِها فَالبعدُ عِندي عَسيرُها",30,"ر",3,0],["وُكلُّ صهابيٍّ كانَ عمامَةً","على الرَّأسِ مما قد كَسَتهُ مشافِرُه",31,"ر",2,0],["وَكلُّ صديقٍ كنتُ متّثقاً به","تغيّر عمّا قد عهدت وقد خانا",32,"ن",2,0],["وكل صوت نغمُ عاشقُ","ضوضاؤها والبث والهسهسات",33,"ت",1,0],["وكلِّ صفراءَ مِرْنانٍ مُفَتِّرَةٍ","نَبْضَ العُروقِ إِذا ثارَتْ لإنْباضِ",34,"ض",1,0],["وَكُلُّ صَغيرٍ كانَ لِلّهِ خالِصاً","يُرَبّي عَلى ما جاءَ في الصَدَقاتِ",35,"ت",1,0],["وكل صفات اللّه ليست مزيدة","وعين التزام الفقر قبل المزيدة",36,"ه",1,0],["وكل صادحة للطير صارخة","وكل رنانة في الأرض مران",37,"ن",1,0],["وكلّ صاحبِ عقدٍ في الذي علمت","ألبابنا إنه فيه على خطر",38,"ر",1,0],["وكل صفات الذم فيها تجمعت","كذا سميت أم الفجور فأسند",39,"د",1,0],["وكل صرح بنوه من مفاخرهم","ارسي واثبت من بنيان غمدانا",40,"ن",2,0],["وكل صفات المجد فيه عظيمة","وأدنى معانيه به يزدهي الشعر",41,"ر",1,0],["وكل صلاح لاح للقطر دائماً","لقد شرعت بالحزم منك مذاهبه",42,"ب",2,0],["وكل صادق في الهوى ما يخيب","يظفر بمطلوبه ورجواه",43,"ا",2,0],["وَكُلُّ صَبٍّ صَبَا لِسَاكِنِهِ","يَسْجُدُ شَوْقاً لَهُ وَيَقْترِبُ",44,"ب",1,0],["وكل صورة الفعل يبقى خيالها","تشاهدها الأسرار فارحل بسرعة",45,"ه",1,0],["وَكُل صَفوٍ سيتلو خيرَه كدرٌ","وَكل لين سيقضى الخطبُ تشديده",46,"د",2,0],["وَكُلُّ صقيِلٍ وَذي ثَروَةٍ","فَإِنَّ المَنِيَّةَ مِن خَلفِهِ",47,"ف",2,0],["وكل صف من المخبوز طازجهُ","لِمن أتى يشتري قد تم واكتملا",48,"ل",2,0],["وكل صحابي وللحال شاهد","يقدر أقدار الرجال بميزان",49,"ن",1,0],["وكل صفات راق في السمع ذكرها","فمن وصفها حادي السرى يستعيرها",50,"ر",3,0],["وكل صبحٍ به أرجو النجاةَ مضى","وما بنيت لهذا الصبح ينهار",51,"ر",1,0],["\"وكُلُّ صَعْبٍ بها سَهلٌ عليّ وما\"","سَهْلٌ على الأَحْبابِ نَأْيٌ وتَأْجِيلُ",52,"ل",1,0],["وكلُّ صبٍّ إذا طاب الوصالُ له","مضى إليه وقلبُ الصَّبِّ مأخوذُ",53,"ذ",1,0],["‏ ‏وكلّ صغير لائذٌ بالصغائر","‏ ‏ وكل كبيرٍ لائذ بالكبائرِ",54,"ر",1,0],["وكل صرح من الأمجاد كان لنا","أمسى خراباً وأودى المجدُ والشممُ",55,"م",1,0],["وكل صباح دون عينيكِ ظلمة","تعالي ليبدو نوره ويعود",56,"د",1,1],["وكلُّ صُحبتيَ الأخيارُ فاز بهم","صدرُ الترابِ , وحولي عطرُهم صَمتا",57,"ت",2,0]]}