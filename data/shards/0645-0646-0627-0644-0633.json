=189170",""],[5953,"سلام على أرض الحسين وحضرته","https://www.poetsgate.com/ViewPoem.aspx?id=93792",""],[5956,"تحيتك الجليلة نهرُ نيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=193349",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""],[463,"يقولونَ يومَ البينُ عينكَ تدمعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60123&r=&rc=179",""]],"verses":[["مِنَ السّاحِبينَ السّابِغاتِ إِلى الوَغَى","كأَنَّهُمُ بُزْلٌ تَناهَضْنَ في غُدْرِ",0,"ر",1,0],["من «السعيدة» هذي الأغنيات ومن","ظلالها هذه الأطياف والصور",1,"ر",1,0],["مِنْ آلِ سَعْدِ الْخَزْرَجِ بْنِ عُبَادَةٍ","صَحْبِ الرَّسُولِ وَأَسْرَةِ الْفُرْقَانِ",2,"ن",1,0],["مِنَ السودِ طَلساءُ الثِيابِ يَقودُها","إِلى الرَكبِ في الظَلماءِ قَلبٌ مُشَيَّعُ",3,"ع",1,0],["مِنَ الساكِناتِ الرَملَ فَوقَ سُويقَةٍ","إِذا طَيَّرَت عَنهُ الأَنيسَ الصَواخِدُ",4,"د",1,0],["من آل سعدٍ رافعي علم الهدى","والمصطَفَيْنَ لنصرة المختارِ",5,"ر",1,0],["مِنَ السِرِّ مِن أَولادِ عَمروِ بنِ عامِرٍ","يُنادونَكُم في كُلِّ مَندىً وَمَشهَدِ",6,"د",1,0],["من السراري التي من بعد موت أبٍ","لو مسَّها حجرٌ مسَّته سرَّاء",7,"ا",2,0],["من السُّمْرِ اللدانِ إذا اسبكَرَّت","وصِرْفُ الموتِ في السُّمْرِ اللِّدان",8,"ن",1,0],["من السما والأرض مستخرج","يلين منه الحجر الأغبر",9,"ر",1,0],["مِنَ السَيرِ وَالإِسآدِ حَتّى كَأَنَّما","سَقاهُ الكَرى في كُلِّ مَنزِلَةٍ خَمرا",10,"ر",2,0],["مِنَ السودِ السَراعِفِ ما يُبالي","أَلَيلاً ما تَلَطَّخَ أَم نَهارا",11,"ر",2,0],["مِنَ السودِ يَحمِلنَ اليَتامى كَأَنَّهُم","فِراخٌ عَلى الأَوراكِ زُغبٌ حِصالُها",12,"ل",3,0],["مِنَ السَنَةِ الَّتي لَم تُبقِ شَيئاً","مِنَ الأَنعامِ بالِيَةَ الثُمامِ",13,"م",1,0],["مِنَ السَبتِ إِلى السَبتِ","إِلى السَبتِ إِلى السَبتِ",14,"ت",1,0],["من السادة الغُرّ الألى ملكوا الورى","وأعطاهمُ الدّهرُ الأبِيُّ جنابا",15,"ب",2,0],["مِنَ السِحرِ الحَلالِ لِمُجتَنيهِ","وَلَم أَرَ قَبلَها سِحراً حَلالا",16,"ل",2,0],["من آلِ ساسانٍ مَنارٌ للصِّبا","قد بِتُّ أسأل عنه أنفاسَ الصَّبا",17,"ب",2,0],["مِنَ السَعدِ في دُنياكَ أَن يَهلَكَ الفَتى","بِهَيجاءَ يَغشى أَهلُها الطَعنَ وَالضَربا",18,"ب",2,0],["مِن السَّعْدِ تُهْدِيهِ إِلَيْهَا يدُ الهَوَى","وَأَوْلَى بِهَا مِنْ أَنْ تُذَالَ فَتَصْفُوَا",19,"ف",3,0],["من آلِ ساسانٍ منارٌ للصِّبا","قد بِتُّ أسأل عنه أنفاس االصبَّا",20,"ب",2,0],["مِن السُّودِ أستاهاً، فوارِسُ مُسْلِمٍ","غداة َ يَرُدُّ الموْتَ ذو النّفس بالكَرْبِ",21,"ب",1,0],["منَ السَّاكناتِ الرَّملَ فوقَ سوَيقة ٍ","إذا طيَّرتْ عنها الأنيسَ الصَّواخدُ",22,"د",1,0],["من السموات ممدود بعاصفة","تحمى وقاصمة تردى اذا سخطا",23,"ط",2,0],["مَن السَليم وَقَد أَحنى حَواجبهُ","وَطَرفُهُ بَينَ تَسديد وَتَفريق",24,"ق",1,0],["من السنة الغرا أخذنا طريقنا","ومعنى أفضناه على كل سالك",25,"ك",1,0],["مِنَ السَّعيدةِ، مِن صَنعاءَ طائرتي","مِنَ الحُدَيْدَةِ، مُشتاقًا أُناجيها",26,"ي",3,0],["مِنَ السَوائِرِ في الآفاقِ قَد جَمَعَت","مِن مَأثُراتِكَ ما لا تَجمَعُ السِيَرُ",27,"ر",1,0],["مِنَ السُمرِ وَالبيضِ الرِقاقِ وَقودُها","وَإِن ظُنَّ مِن طيبِ التَضَوُّعِ مَندَلا",28,"ل",2,0],["مِنَ السَّندِ المُقَابِلِ ذَا مُرَيخٍ","إِلَى السّاقَينِ ساقَى ذِى قِضِينَا",29,"ن",2,0],["من السمر بالألحاظ إن صال وانثنى","فلا تذكروا من بعده البيض والسمرا",30,"ر",2,0],["من السمر الرشاق لها قوام","به تسمو على الغصن القويم",31,"م",1,0],["من السمر لي قد هز لدنا قوامه","وقد سل من الحاظه لي مرهفا",32,"ف",2,0],["من السابحون على لنشهم","وأجسادهم فضة تلمع",33,"ع",1,0],["مِنَ السِحرِ في مُقلَتَيها رَشاشٌ","وَلِلحُبِّ في شَفَتَيها ثَمَر",34,"ر",1,0],["من آل سيفياء الأمير محمد الحالي","العطاء إذا شكوت الحالا",35,"ل",2,0],["من السلف الماضين والخلف الذي","ذكرنا كرام أعقبت بكرام",36,"م",1,0],["مِنَ السيّد المرسي عنِ الشاذلي من","هو القطبُ والأفلاكُ من حوله تجري",37,"ر",2,0],["منَ السبعِ الّذين يِظلّلون","بظلّ العرشِ إذ يضحى العبيدُ",38,"د",1,0],["من آلِ سالمٍ الألَى سَلِمَتْ","أَعراضُهمْ وتَمجَّد الخُلُق",39,"ق",1,0],["من السّابقاتِ الرّيحَ عَفْواً إذا غدَتْ","ضَوامِنَ تَقْريبِ المَدى المُتَباعد",40,"د",1,0],["من السَّادة النُجُبِ الطاهرين","تَزينُ العصورَ وأجيالها",41,"ل",3,0],["من السادة الغرّ الكرام مهذب","مكرٌّ على أمواله بالمكارم",42,"م",1,0],["من السادة الغُرِّ الميامين سيّد","أعزُّ بني الدنيا وأندى وأكرمُ",43,"م",1,0],["من السادات من أعلى قريشٍ","سلالة خير خلق الله طه",44,"ه",1,0],["من السَّادة الغرّ الميامين ينتمي","إلى خيرِ خلق الله فرعاً ومنتمى",45,"م",2,0],["من السادة الغر الكرام ومن لهم","فضائل مجدٍ قد تسامت متونها",46,"ن",3,0],["من آلِ ساسانَ الذين صِفاتُهُمْ","في جبْهةِ الأَيامِ خَطُّ ظاهِرُ",47,"ر",1,0],["من السواري الغوادي الحور رائحة","قد واصلت دهرها وبلا ضحى وسرى",48,"ر",2,0],["من السحب السواري والغوادي","معاقبة الرواعد والبروق",49,"ق",1,0],["مَن الساري تجِدُّ به بنجدٍ","أضاليل السرى عقب السآمهْ",50,"م",2,0],["من السوداء لم تك بنت كرمٍ","دفينٍ بل من الهِيف البِساقِ",51,"ق",1,0],["من السابقين نجدةً أن تحمّسوا","لحفظ حمىً أو عفَّةً إن تورَّعوا",52,"ع",3,0],["من السُّمر أخبار عشَّاقه","إليه يعنعن إسنادها",53,"د",3,0],["مِنَ السالِباتِ الشَمسَ ثَوبَ ضِيائِها","بِثوبٍ تَوَلّى نَسجَهُ عِثيَرُ التُربِ",54,"ب",1,0],["مِن آلِ سَعدانَ الَّذينَ بِجِدِّهِم","نِيلَ الحِفاظُ وَأُحكِم التَأديبُ",55,"ب",1,0],["مِنَ السَراةِ ناشِطاً لِلأَجبُلِ","بُعالِهِنَّ القَهبِ وَالمُجَزَّلِ",56,"ل",1,0],["من آلِ ساروفيمَ بدرٌ غابَ في","لحدٍ لحُكمِ القادِرِ الخَلاّقِ",57,"ق",1,1],["منَ السادةِ الأشرافِ أمَّا بَنانُهُ","فسُحْبٌ وأمَّا جُودُهُ فسيُولُ",58,"ل",1,0],["مِنْ آلِ سَاسَانَ صُبُرْ","عَلَى تَصَارِيْفَ الغِيَرْ",59,"ر",1,0],["من السَّابقين الأَولين إِلى الذي","يلائمُني والتَّابعِين بإِحْسَانِ",60,"ن",1,0],["من السعود لداوود المنى هطلت","غيوثها ساكبات أي تسكاب",61,"ب",1,0],["منا لسعد والصحاب سلام","فلهم يتوق النيل والاهرام",62,"م",1,1],["مِنَ السِّيادَة نَالُوا كُل مَنْزِلَةٍ","بَين الأَنَامِ بِمعروفٍ وهِمِّاتِ",63,"ت",1,0],["مَنِ السّاري إليَّ وللثريا","وللدّبرانِ في الغَربِ اطرِّد",64,"د",1,0],["مِن السَماءِ وَمِن العَرشِ طُرِد","وَحلَّ مِن ذُلٍّ بِهِ ما لَم يُرد",65,"د",1,0],["من السادة الصحب الذين بهديهم","وعدلهم قد قام في الزّمن القسط",66,"ط",1,0],["مِنَ السَّعِيدَةِ، مِنْ صَنعاءَ، مِنْ عَدَنٍ","مِنَ الحُدَيْدَةِ، هَلْ دَارٌ تُساوِيها؟",67,"ي",3,0],["من آل سلطان ممّن","قد دوخوا الأراضي شدا",68,"د",2,0],["مِنَ السَرابِ وَالقَتَام الأَعْبَقا","إِذَا رَمَى فِيهِ البَصِيرُ اغْرَوْرَقَا",69,"ق",2,0],["مِنَ السِنِين وَالهَلاكِ المُهْتَلِكْ","مُنْجَرِدِ الحارِكِ مَحْصُوصِ الوَرِكْ",70,"ك",1,0],["من السلف القوم الذين توجهوا","إلى الله يقفون النبي المصطفى الهادي",71,"د",2,0],["من السلف الذين بهم بلغتم","مقاما عز في المجد الاثيل",72,"ل",1,0],["مِنْ آلِ سَعْدِ الخَزْرَجِ بْنِ عُبَادَةِ","بْنِ دُلَيْمٍ المُوتَى لأَخْذِ قِصَاصِ",73,"ص",1,0],["مِنْ آلِ سَعْدٍ ذَلِكَ بْنِ عُبَادَةٍ","مَوْلًى بِنَصْرِ الدِّينِ كَانَ كَفِيلاَ",74,"ل",2,0],["من السادة الغر الميامين أنجم ال","هدى حول بدر في سما النقع يسفر",75,"ر",1,0],["مِنَ السُمرِ اللَواتي","هُنَّ أَمثالُ القَنا السُمرِ",76,"ر",1,0],["من السوء والأهواء طه أعيدني","واصلح لي حالاً مالاً مبلغُ",77,"غ",1,0],["من السفح حيث الورد استهول الذُّرى","وفوق ذُراه أبصرُ السَّفحَ يؤنِسُ",78,"س",1,0],["مِن السِمانِ الخِماصِ الغيدِ مالِئة","لِلعَينِ في طُرَّةٍ كَالشَمسِ مِنهاجِ",79,"ج",1,0],["من السلاح بندقاً","وابيضاً منصلا",80,"ل",2,0],["من ألسنةِ حِداد لا تُبارى","أتتك بهنَّ أفواهُ الرجال",81,"ل",1,0],["من السادة الاشراف اعمدة العلا","لهُ شيم من جده وشُكول",82,"ل",1,0],["من السنة الغرّاءأو من كتاب من","تقدّس عن قول الغواة وجحّد",83,"د",1,0],["مِنَ السُّيوفِ الَّتي لَولا مَضارِبُها","ما كانَ لِلدِّينِ لا عَينٌ وَلا أَثَرُ",84,"ر",1,0],["مِن السَنِينَ سَبعَة مُولِدَهُ","بِرَندةَ المَغرِبِ ذا مَهدُهُ",85,"ه",1,0],["من السنين كملت بعشرَه","من الشهور عدةً مشتهره",86,"ه",1,0],["مِنَ السُنَّةِ الشَنعاءِ وَالسَوءَةِ الَّتي","يَسُبُّ بِها الأَحياءُ أَهلَ المَقابِرِ",87,"ر",1,0],["مِنَ السَّعِيد لِقَريةِ الشيخ معا","فديرةُ البرِّ المغيبُ فاسمَعَا",88,"ع",2,0],["مِنَ السَّعيدِ في طلوعِ الرامح","لرأسِ خَنزِيرَه طريقٌ واضِح",88,"ح",1,0],["من السعادة أسعَد","سَعدُ الأميرِ المؤيَّد",89,"د",1,1],["من السقم ما حققتُ بعض مطامعي","فأفرغت في شعري المنَى والمطامعا",90,"ع",2,0],["من السمر فتاك القوام رشيقه","وما آفة السمر العوالي سوى الفتك",91,"ك",1,0],["من السما نودي الخديوي شرُفَتْ","بكم سمنّود التي قد أُتحفتْ",92,"ت",1,0],["مِنَ السِّيرَجَانِ الى الهُنْدُوَا","نِ مَبْثُوثة كالدَّبا المُنْتَشِرْ",9