{"poems":[[92,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[132,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[132,"ما زلت في لهو وفي طرب وفي","https://www.aldiwan.net/poem50542.html","الكامل"],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[325,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[1891,"","https://poetry.dctabudhabi.ae/diwan/poem/27047","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114275","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139768",""],[5973,"ضاع عام في الخصام وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=13685",""]],"verses":[["كلُّ أقطارِكِ يا \" فارسُ \" رِيفُ","طابَ فصلاك : ربيعٌ وخريفٌ",0,"ف",1,1],["كلُّ أقرّ لكمْ تقىً","بالفضل من سام وحام",1,"م",1,0],["كلٌّ أقَرَّ بعدْلِكم ونوالِكم","من ذا الورى من عالمٍ أو جاهلِ",2,"ل",1,0],["كَلا قَد اِنحَسَر الحِجاب وَإِنَّما","أَبصار قَومٍ في حِجابٍ ساترِ",3,"ر",1,0],["كُلَّ إِقليمٍ يولي","هِ الخِديوي مُديرُهُ",4,"ر",2,0],["كَلا قادِمَيها يَفضُلُ الكَفَّ نِصفُهُ","كَريشِ الحُبارى ريشُهُ قَد تَزَلَّعا",5,"ع",2,0],["كِلاَ قَمَرَي أفقٍ لِوَجهِكَ خَاضِعٌ","وَحُسنُكَ يَا زَينَ الوَرَى غَيرُ مُشتَرَك",6,"ك",1,0],["كلٌّ أقام بأنعمٍ حلفٌ لها","صفو النعيم يرى مدى أحقابه",7,"ب",2,0],["كل اقماري قد انطفأت وام","تصني ليل به اتعثر",8,"ر",1,0]]}