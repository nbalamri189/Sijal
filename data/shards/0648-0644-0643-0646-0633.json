{"poems":[[57,"أمرت بكتمان الذي لو أشعته","https://www.aldiwan.net/poem26050.html","الطويل"],[57,"وما طبت نفسا عنك لما هجرتني","https://www.aldiwan.net/poem26314.html","الطويل"],[36,"لو أن امرأ أخفى الهوى عن ضميره","https://www.aldiwan.net/poem4892.html","الطويل"],[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[37,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[90,"أ تونس أن في بغداد قوما","https://www.aldiwan.net/poem44988.html","الوافر"],[49,"سلي فتيات هذا الحي عني","https://www.aldiwan.net/poem25127.html","الوافر"],[49,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[94,"يقولون صوت المستذلين خافت","https://www.aldiwan.net/poem38912.html","الطويل"],[87,"أمينة يا بنتي الغاليه","https://www.aldiwan.net/poem8067.html","المتقارب"],[68,"علينا إذا ما طال مطلكم صبر","https://www.aldiwan.net/poem38734.html","الطويل"],[22,"أشاقتك ليلى في اللمام وما جزت","https://www.aldiwan.net/poem21660.html","الطويل"],[50,"وندمان يرى غبنا عليه","https://www.aldiwan.net/poem10399.html","الوافر"],[50,"دع الربع ما للربع فيك نصيب","https://www.aldiwan.net/poem10774.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21012","الوافر"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/842","المتقارب"],[94,"«صَوْتُ المُسْتَذِلِّين خَافِتٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14601&r=&rc=46",""],[139,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[189,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[189,"عسى يجري الزمان على اختياري","https://www.aldiwan.net/poem14534.html","الوافر"],[214,"فؤاد بذكر العامرية مغرم","https://www.aldiwan.net/poem13295.html","الطويل"],[234,"طوى البين عهد الوصل فهو قصير","https://www.aldiwan.net/poem51114.html","الطويل"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[358,"يقولون لي اهج الطبل لكنهم كنوا","https://www.aldiwan.net/poem39973.html","الطويل"],[366,"حليف العلا ان الفؤاد مصاب","https://www.aldiwan.net/poem68137.html","الطويل"],[371,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[374,"سقى الله بغداداً وساكنها الحيا","https://www.aldiwan.net/poem4294.html","الطويل"],[409,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[415,"إليك فما تثني شؤونك شاني","https://www.aldiwan.net/poem32160.html","الطويل"],[449,"سألنا فقالوا هذه جنة الورد","https://www.aldiwan.net/poem55934.html","عموديه"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[466,"أقول ودمعي مستهل وددتني","https://www.aldiwan.net/poem15113.html","الطويل"],[466,"سألت إلهي أن يعيش بغبطة","https://www.aldiwan.net/poem16424.html","الطويل"],[491,"ألا يا قيس لا تسمن درعي","https://www.aldiwan.net/poem461.html",""],[500,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[505,"أتيت إلى بابك الأمنع","https://www.aldiwan.net/poem37967.html","المتقارب"],[520,"دعوا كل برق شمتم غير بارق","https://www.aldiwan.net/poem12145.html","الطويل"],[543,"أدام الله أيام الخليفه","https://www.aldiwan.net/poem47554.html","عموديه"],[545,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[563,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[580,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[588,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86613","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54129","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48659","الكامل"],[918,"","https://poetry.dctabudhabi.ae/diwan/poem/107324","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100158","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96735","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17050","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133786","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64930","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11932","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113986","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103221","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76655","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76609","الطويل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202204","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177827","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109522","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28614","المتقارب"],[2615,"","https://poetry.dctabudhabi.ae/diwan/poem/124292","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65963","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22536","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11269","المتقارب"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82832","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48445","المتقارب"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126978","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108090","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140291",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92052","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117907","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95319","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44667","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107282","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139543",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139549",""],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[307,"نشيدُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=213751",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[5436,"زفرات(على لسان العراق)للشاعر إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=129741",""],[5638,"عيون.....","https://www.poetsgate.com/ViewPoem.aspx?id=198255",""],[5795,"أبيت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""]],"verses":[["وَلَكِن سَأُخفي ما كَتَمتُ تَجَلُّداً","وَلَيسَ لِأَسرارِ المُحِبّينَ كَالدَفنِ",0,"ن",1,0],["وَلَكِن سَخَت نَفسي بِنَفسي لِتَبلُغي","رِضاكِ بِقَتلي إِن عَزَمتِ عَلى الهَجرِ",1,"ر",1,0],["وَلَكِن سَأَلقى اللَهَ وَالنَفسُ لَم تَبُح","بِسِرِّكِ وَالمُستَخبِرونَ كَثيرُ",2,"ر",1,0],["وَلَكِن سَما بِيَ عَطفُ الأَميرِ","وَرَأيُ الوَزيرِ وَفَضلُ الأَدَب",3,"ب",1,0],["وَلَكِن سَقى صَوبُ الرَبيعِ إِذا أَتى","عَلى قَلَهِيَّ الدارِ وَالمُتَخَيَّما",4,"م",2,0],["ولكن ساح لأستِنهاض قوم","حكَوْا بجمودهم صفة الجماد",5,"د",1,0],["وَلَكِن سَوفَ أوجِدُهُنَّ وَصفاً","وَأَبسُطُ في المَديحِ كَلامُهُنَّه",6,"ن",2,0],["وَلَكِن سَأَلقاها فَإِمّا مَنِيَّةٌ","هِيَ الظَنُّ أَو بُنيانُ عِزٍّ مُوَطَّدِ",7,"د",1,0],["ولكنْ سيأتي بعدَ لأيٍ نُشُورُها","ويَنْبَثِقُ اليومُ الَّذي يَتَرَنَّمُ",8,"م",1,0],["وَلَكِن سَأَلتُكِ بِالوالِدَينِ","وَناشَدتُكِ اللُعَبَ الغالِيَه",9,"ي",2,0],["وَلَكِن سَنَنسى ما وَعَدتُم لَعَلَّهُ","يَدورُ لَهُ يَوماً بِفِكرِكُمُ ذِكرُ",10,"ر",1,0],["وَلَكِنَّ سَهماً أَفسَدَت دارَ غالِبٍ","كَما أَعدَتِ الجَربى الصِحاحَ فَعُرَّتِ",11,"ت",1,0],["وَلَكِن سَقِّني وَيَقولُ أَيضاً","عَلَيكَ الصِرفَ إِن أَعياكَ ماءُ",12,"ا",2,0],["وَلَكِن سَبَتني البابِلِيَّةُ إِنَّها","لَمِثلِيَ في طولِ الزَمانِ سَلوبُ",13,"ب",1,0],["ولكن سلام اللَه حاط حياته","فَلَم يقض سعد نحبه لا قضى نحبا",14,"ب",2,0],["ولَكِن سَرَّني أَن يَع","لَمُوا قَدري فأَقلَعتُ",15,"ت",1,0],["وَلَكِنَّ سُلطاني أَقَلُّ عَبيدِهِ","يَتيهُ عَلى كِسرى المُلوكِ وَيرجَحُ",16,"ح",1,0],["وَلَكِن سَمَحتُ لَها بِالبَقاءِ","رَجاءَ اللِقاءِ عَلى ما تُحِب",17,"ب",1,0],["ولكن سيأتي بعد لأي نشورها","وينبث اليومُ الذي يترنَّمُ",18,"م",1,0],["ولكن سطوة التقوى كفَتْهُ","عناءَ البيض والسمرِ العوالي",19,"ل",2,0],["ولكنْ سوف يفترقان قسْرا","وهل يبقَى مع الدهرِ اصطحاب",20,"ب",1,0],["ولكنْ سدَّ همُّ الشيبِ قلبي","فضاق عن الصغائر بالكبار",21,"ر",1,0],["ولكن سلوا عن حالة الصب دمعه","يخبركم عما جرى فهو يعلم",22,"م",1,0],["ولكن سمت بي هِمَّةٌ عَلَوِيَّةٌ","وقلبٌ إذا ارتاع الجَبانُ جَسُور",23,"ر",1,0],["ولكن سقاك الله بالغيث أينما","توجهت فالسحب الغزيرة تسكب",24,"ب",1,0],["وَلَكن سَأوليه المَديح فَإِنَّهُ","سَيَظهر مَعنى قَذفيَ الدرّ بِالوَحلِ",25,"ل",1,0],["وَلكن سَجاياكَ الحسان غَنِيَّة","عَنِ الشَرح وَالذَوق السَليم عِجاب",26,"ب",1,0],["وَلَكِن سَلِ اللَيلَ سَتراً عَلَيكَ","وَإِن كُنتَ تَأمَنُهُ كافِرا",27,"ر",2,0],["ولكنَّ سبعاً بعد سبعينَ لم تدع","لنفسيَ همَّاً غيرَ رقبة مِضجعي",28,"ع",2,0],["ولكنَّ سكان البسيطة أصبحوا","كأنهمُ عما حواه غِضاب",29,"ب",1,0],["ولكن سَلي عنِّي الزَّمانَ فإنّه","يُحَدِّثُ عن صَبري على الحَدَثانِ",30,"ن",1,0],["ولكن سر الحسن في النفس فعله","يقصر عن تعريفه كل ذي جهد",31,"د",1,0],["ولكن سحراً بابِلِيّاً عقودُه","تُحلَّلُ ألبابٌ بها وعقول",32,"ل",1,0],["ولكن سَموحاً بالودادِ وبالنَّدى","ومُبتسماً في الحادث المُتنمِّرِ",33,"ر",1,0],["ولكنْ سَليمُ القلْبِ مِن صَوَرِ الهوَى","رَاياهُ مِن إِيمانِهِ في مَعاقِلِ",34,"ل",1,0],["وَلَكِن سَمِّ ما أَحبَبتَ فيها","فَلَيسَ بِمُنكِرٍ غِبنَ البُيوعِ",35,"ع",1,0],["ولكن سأبلي العذر في كل حالة","بشكرك في يومَيْ مغيبي ومشهدي",36,"د",2,0],["ولكنْ سَنا شارِقاتِ الجَلا","لِ أقامَ جَلالَكَ في بُرْقُعِ",37,"ع",1,0],["ولكن سلوا منه العلى تظفروا بها","فكل امرئ يرجى على قدر قدره",38,"ر",2,0],["ولكن سَيِّدي أدرَى بِحَالي","خُصوصا مِثل لَيلَتِىَ الظَّرِيفَه",39,"ف",2,0],["وَلَكِن سَقطَةٌ عِيبَت عَلَينا","وَبَعضُ القَولِ يَذهَبُ في الرِياحِ",40,"ح",1,0],["ولكن سوى دين أهل الهدى","عقول رأت حسن إضلالها",41,"ل",3,0],["ولكن سأَلتُ الناصرَ الملك النَّدي","فأَغْنَى وأَقْنَى ثم مَنَّ وما مَنَّا",42,"ن",2,0],["وَلكن سقيتُ بِه بلدةً","تُباسِقُ عَنّا مَعَدا بِساقا",43,"ق",2,0],["وَلَكن ساءَ في الأَفعال جَهلاً","فَأَدركه مِن اللَيث اِنقِلاب",44,"ب",1,0],["ولكن ساءنا عجل ارتحالٍ","رأينا العذر عنه ذا انطراحِ",45,"ح",1,0],["ولكن سُقْتَهُم للحرب كَرهاً","وما أمنوك في جدب وحبس",46,"س",1,0],["ولكن سَعى داعي النَوى بينَ مَروَتي","وبين صفائِي فالأَسى مُتراكِمُ",47,"م",1,0],["ولكن ستبدو زخرفاً من تضرعي","لدى العروة الوثقى الذي نتولاه",48,"ا",2,0],["وَلكن سحب كفّيه","هَمت ورقاً وغفيانا",49,"ن",2,0],["وَلَكِن سَيُعديني عَلَيها اِبنُ أَحمَدٍ","نَبِيَّ الهُدى وَاِبنُ الوَصِيِّ المُكرَمِ",50,"م",1,0],["ولكنّ سرّك ليس يلم","الخيال بمكنونه الممنع",51,"ع",1,0],["ولكِنْ سَماحُ ابنِ المُعِزِّ أَعاقَني","هَواها لأَنَّ البُخْلَ بَعْضُ خِلالِها",52,"ل",3,0],["ولكن سرى الأملاك فيه يؤمّهم","بتكبيره فوق السما جبرئيلها",53,"ل",3,0],["وَلَكِن سَأَحويهِ إِذا كُنتُ قاصِداً","إِلى بَلَدٍ فيهِ الصَلاحُ أَميرُ",54,"ر",1,0],["ولكِن سَلي عنّي دخيلي إذا شتَوا","وأخلَفَ ما شيهمِ ذراعاً ومِرزَما",55,"م",2,0],["ولكن ستبكيني خُطوبٌ وَمَجلِسٌ","وشُعثٌ أُهينوا في المجالِسِ جُوَّعُ",56,"ع",1,0],["ولكن سأستعدي الوفاء وأقتضي","سماحك بالأنس اقتضاء غريم",57,"م",1,0],["ولكن سأكنى بالوفاء عن الجفا","وأرضى ببعد بعدما كان من قربي",58,"ب",2,0],["ولكن سيبكيني العلائق بالسرى","ويبكي على قبري البروق الرواعد",59,"د",1,0],["ولكن سفح الدمع يشفي صبابة","لذي لوعة فاسفح لنأيك دمعكا",60,"ك",2,0],["ولكن ساقها ابليس كيما","تحصل ما يحصل في المثالب",61,"ب",1,0],["وَلَكِن سَنَنتَ عُقوقَ الكِرامِ","فَقَد تَبِعوا فيكَ تِلكَ السُّنَن",62,"ن",1,0],["ولكن سماها في القصور مدين","فهيهات أن يحصى مناقبَها العدُ",63,"د",1,0],["وَلكِن سُهَيلٌ عِندَ ذُبَّانِهِ أرى","بِهم ثِقلَ عَن ذَينِ فَكُن عَأرفَ الأمرِ",64,"ر",1,0],["ولكن سلي ما شئت قرضاً ونحلة","فلست بخيلاً بالهبات وبالقرض",65,"ض",1,0],["وَلَكِن سَمِعنَ الشَيخَ قَد قالَ قَولَةً","عَلَيكُم إِذا ما رِبنَكُم بِالضَرائِرِ",66,"ر",1,0],["ولكن سلِ المالَ عند امرئٍ","إذا أورث المالَ عن جدهِ",67,"ه",1,0],["وَلكِن سَجاياك الكَريمَةُ أَنطَقَت","لساني بِما يَحلو بِانشاده قَولي",68,"ل",2,0],["ولكنْ سلِمْتَ فراقَ الوجودَ","مَقامٌ عن الجودِ لم يصْدِفِ",69,"ف",1,0],["ولكن سح يضحك عن سرور","بلتم تراك فهو عنا سجودا",70,"د",2,0],["ولكن سخت كفُّ الزمان بمرةٍ","والقى بنان الدهر من بعدها ضنا",71,"ن",2,0],["ولكن سن ربي للبرايا","سبيل الموت يؤذن بارتحال",72,"ل",1,0],["وَلَكن سكّنَ الأَلبابَ بدرٌ","تجلّى بعد ليل من غموم",73,"م",1,0],["ولكن سلاح المكر واكيد فاتك","بمن شئنه فتك الأساود والأسد",74,"د",1,0],["وَلكنَّ سِرّ اللَّه شُطِّرَ فيكما","فَكنتَ لِتسطو ثمَّ كانَ لِيَغفِرا",75,"ر",2,0],["وَلَكِنَّ سَهمُ المَوتِ لا بُدَّ نافذٌ","فَسُبحانَ مَن أَحيى وَأَفنى وَقَدَّرا",76,"ر",2,0],["ولكن سمعتُ ببدرٍ بدا","بدَلهِي وبحر علومٍ زَخَر",77,"ر",1,0],["ولكن سجتْني حادثاتٌ ترادفت","ودهرٌ فجيعٌ خطبُهُ وهو أشْيَعُ",78,"ع",1,0],["ولكن سيجلى الكربَ عنا سميدعٌ","هزبرٌ يهاب الموت منه قطوبا",79,"ب",2,0],["ولكن ستخصبُه أدمعي","فتروى القريض وتسقى الشعوبا",80,"ب",2,0],["ولكن سنة الله في الخلايق","دول تبنى على نهج الكوارس",81,"س",1,0],["ولكن ستأتي سنينٌ سمانٌ","تشافي الجروحَ تُضيءُ العتام",82,"م",1,0],["ولكن سعييك القصور عن الذي","يراد من المقصور فيمن تأخرا",83,"ر",2,0],["ولكنْ سأبقى رَغم خذلانِ ناصري","حسيناً لدهرٍ مستبدٍ وما جلبْ",84,"ب",1,0],["وَلَكِنْ سَأَرْضَى بِالْبِلالِ فَدُونَهُ","هَلاكٌ وَصَبْرًا فَالْمُنَى أَنْ تَكَرَّمَا",85,"م",2,0],["ولكن سجايا قد سمت ومعارف","بها هتفت في الخافقين العوالم",86,"م",1,0],["ولكنَّ سَجني سَجْنُ كلِّ حضارةٍ","تطير على رِجْلينِ فوق الكواكبِ",87,"ب",1,0],["وَلكِنَّ سَيفَ الدَّولَةِ ارتَدَّ ذِكرُهُ","مَعَ المُتَنّبّي فَانتَشى الدَّهرُ بِالسَّردِ",88,"د",1,0]]}