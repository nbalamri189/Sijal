{"poems":[[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[93,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[87,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[45,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[47,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[63,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[68,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[46,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[69,"ليت شعري ما مقتضى حرماني","https://www.aldiwan.net/poem18113.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[108,"الكادر","https://www.poetsgate.com/ViewPoem.aspx?id=179520",""],[119,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[214,"لا وعهد الصبا وعيش هواها","https://www.aldiwan.net/poem13367.html","الخفيف"],[228,"ما لسلمى التي استبدت وما لي","https://www.aldiwan.net/poem41624.html","الخفيف"],[353,"إن عيني وهي عضو دنف","https://www.aldiwan.net/poem20059.html","الرمل"],[366,"بابي شادنا تجدر فازداد","https://www.aldiwan.net/poem68101.html","الخفيف"],[382,"ذهب الناكث عنا","https://www.aldiwan.net/poem59228.html","مجزوء الرمل"],[415,"ما كف كفي عن جودي بموجودي","https://www.aldiwan.net/poem32077.html","البسيط"],[445,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[458,"سألوني لم ارتحلت كأني","https://www.aldiwan.net/poem61618.html","الخفيف"],[473,"يا شقيق الشقيق صدغا وخدا","https://www.aldiwan.net/poem60215.html","الخفيف"],[510,"نسوة الحيّ الشرقيّ","https://www.aldiwan.net/poem27890.html","الخفيف"],[543,"طلع الحسن من جبينك شمسا","https://www.aldiwan.net/poem48230.html","عموديه"],[580,"نثر الدهر عقد ثغر حبيبي","https://www.aldiwan.net/poem2944.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64037","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1008,"","https://poetry.dctabudhabi.ae/diwan/poem/95760","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55886","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136211","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64634","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82507","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108777","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96026","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77196","الرمل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[398,"","https://poetry.dctabudhabi.ae/diwan/poem/88162","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203013","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79707","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76542","الخفيف"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130076","الرمل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104315","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108021","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108290","الخفيف"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46033","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131207",""],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131345","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127077","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81286","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83578","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104537","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72772","الخفيف"],[4929,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199291",""],[5009,"بنت قنا","https://www.poetsgate.com/ViewPoem.aspx?id=24371",""],[5039,"ريش المحابر","https://www.poetsgate.com/ViewPoem.aspx?id=48125",""],[3591,"حيّ في مصر أربع الغادات","https://www.poetsgate.com/ViewPoem.aspx?id=149455",""],[5106,".. إِنَّ النِّفْطَ قَدْ جَبُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=151384",""],[5186,"تلك الخمائل ما تمايل بأنها","https://www.poetsgate.com/ViewPoem.aspx?id=156464",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5240,"لا تلمني فالنفس طال عناها","https://www.poetsgate.com/ViewPoem.aspx?id=171238",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5939,"طفلٌ بلا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=178610",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[6142,"لم تغن يوم حنين كثرة لبني ال","https://www.poetsgate.com/ViewPoem.aspx?id=155716",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["ما كفءُ عرضك عرضُ مع","رورٍ فلا تحكُكْ نِقابهْ",0,"ب",2,0],["ما كَفَتنا مَظالِمُ التُركِ حَتّى","زَحَفوا كَالجَرادِ أَو كَالوَباءِ",1,"ا",2,0],["ما كَفاهُ نَوائِبُ الحَقِّ حَتّى","زِدتَ في هَمِّهِ وَفي إِشغالِه",2,"ل",2,0],["ما كَفاني تَقصيرُ ما قُلتُ فيهِ","عَن عُلاهُ حَتّى ثَناهُ اِنتِقادُه",3,"د",2,0],["ما كَفى مَوقِفُ التَفَرُّقِ حَتّى","عادَ بِالبَثِّ مَوقِفُ الإِجتِماعِ",4,"ع",1,0],["ما كفَّ شادِيَهُ اعتراضُ عتابِه","بل زادَه طرباً إلى أطرابِه",5,"ب",2,1],["ما كَفى عَن حَملِ سَي","فٍ وَذابِل",6,"ل",1,0],["ما كَفَّ مِن حَربِ الزَمانِ وَرَميِهِ","بِالصَبرِ إِلّا أَنَّهُ لَم يُنصَرِ",7,"ر",1,0],["ما كفَاهُ مِنَ الطَّوافِ بِبُلْبَي","سَ إِلى أَنْ يَطُوفَ بي السَّيَّارَهْ",8,"ر",2,0],["ما كَفَتْ سائِرَ المدارِسِ","أَوْ ضُمَّ إليها مِنْ مالِها دِرْهَمانِ",9,"ن",1,0],["مَا كَفَتْنِي مُعْجِلَ السُّوءِ أَيَّا","مِي وَمَا مِنْ مُؤَجَّلِ السُّوءِ وَاقِ",10,"ق",1,0],["ما كفاكم أن العلاوة، يا قو","م، أطالت على الجيوب الفراقا",11,"ق",2,0],["ما كفى الصد والغريم الغرام","ازعجتنا بصدعها اللوام",12,"م",1,1],["ما كَفاهُ إِزالَةُ الفَقرِ بِالثَر","وَةِ عَنّي حَتّى أَزالَ الخُمولا",13,"ل",2,0],["ما كفاها ما قد جرى من دموعي","من دموعي ما قد جرى ما كفاها",14,"ا",3,0],["ما كَفاها أَنّي هَزيلٌ وَلكِن","سَمَّرت نَعلَها وَداسَت هزالي",15,"ل",2,0],["مَا كَفَاهَا بُعْدُهَا عنكَ إلى","أَنْ دَهَاهَا وَكُفِيتَ الرَّمَدا",16,"د",2,0],["ما كَفاهُ أَن تم في الحُسن حَتّى","كلل الوجه لُؤلؤا مَنثورا",17,"ر",2,0],["ما كفاه من دَهاهُ","أن رُزينا وافتَضحنا",18,"ن",2,0],["ما كفَّ كفِّيَ عن جودي بموجودي","ما كفَّ كفِّيَ عن جودي بموجودي",19,"ي",1,1],["ما كُفْرُ نُعْماكَ من شأْني فَيَثْنِيني","عَمَّنْ توالى لنصرِ الملكِ والدّينِ",20,"ن",1,1],["ما كَفاهُم أنِّى أعاني وجودي","في وُجودٍ بقاؤه مَحضُ غَبنِ",21,"ن",1,0],["ما كَفاهُم أني أواصلُ ليلى","بنهاري لأجلهم وسطَ من",21,"ن",1,0],["ما كفاهم أني أضحى بروحي","حينما عزَّ من يُضحَّى ويُغنى",21,"ن",2,0],["ما كفاهم أني تناسيتُ نفسي","فوق نسيانهمُ حقوقي وأينى",21,"ن",2,0],["ما كفاهم أنى لهم ذلك الرا","ئدُ يشقى كالراحِ في أسرِدنِّ",21,"ن",1,0],["ما كفاهُم أني ارتضيتُ شقائي","لي جزاءً ويهدمون وأبنى",21,"ن",2,0],["ما كفاهُم هذا وهذا فنادوا","بعقوقي وما رَعَوا حق سنِّى",21,"ن",2,0],["ما كَفاهُ أَن صارَ خَدّي بَهارا","مِنهُ حَتّى صارَت دُموعِيَ وَردا",22,"د",2,0],["ما كفى حُسنهنَّ نظمُ القوافي","أو رُسوماتُ مُلهَمٍ في مجلَّة",23,"ل",2,0],["ما كفَى في الشفَاعةِ الحَسنُ الفر","دُ ورِضوَانُ جنَّةِ الخلدِ وُدَّا",24,"د",2,0],["ما كفته تلك الملاحةُ مِنْهُ","أَو أَرَانَا مَلاحةً وشَطَارَهْ",25,"ر",2,0],["ما كَفى يا فَريدَةَ العِقدِ حَتّى","أَصبَحَ اليَومَ أَكتَبُ القَومِ أَشعَر",26,"ر",1,0],["ما كفى إن عجزتُ عن شكر نُعما","ك فأتبعتَها بنعمى نظيف",27,"ف",1,0],["ما كفاهُم ما جرى حتى عَدَوْا","لحِمى من لا يكافوهُ بَردّ",28,"د",1,0],["ما كَفى الناسَ ما بهم منك حتّى","صرتَ تغشاهمُ ومعك السِراجُ",29,"ج",1,1],["ما كفى أن لا يراعوا ذمما","لمحب ليس للعهد نسي",30,"ي",1,0],["ما كَفَّ مِنْ نَزَقي خَيْطُ المَشيبِ فَقَدْ","أَجْرَرْتُ حَبْلَ خَليعٍ في الهَوى غَزِلِ",31,"ل",1,0],["ما كفاها تهديد ربي تعالى","في الكتاب العزيز والانذار",32,"ر",1,0],["ما كفاني الصفاء في القلب حتى","أظهر الشعر ما أكن الصفاء",33,"ا",2,0],["ما كفاهم ما مر من غنم القر","ية حتى أخنوا على الثيران",34,"ن",1,0],["ما كَفّ حَتّى كَفّ آخرَه","وَلَقَد يَكون بِمِثلها طَبّا",35,"ب",2,0],["ما كفاه السمو في الدين حتى","بعلوم العباد أجمع أحدق",36,"ق",1,0],["ما كفاها أكل الكبود باحد","عن حسين في كربلا مذ أتاها",37,"ا",3,0],["ما كفاها حمل الكريم عن الأسره","لنسوانه وذل سباها",37,"ا",3,0],["ما كَفاهُ أَنَّهُ يَمضي بِها","وَأَنا أَمضي وَفي صَدري نُدوبُ",38,"ب",1,0],["ما كفاهم جهل الرجال فزادوا","له جهل النساء وإبعادا",39,"د",2,0],["ما كفَّ طَبعي عَن اِطالَة هذِهِ","مَلَل وَلا عَجزٌ عَنِ الاِسهاب",40,"ب",1,0],["ما كفى فعلها بعقلي حتى","ظهرت لي أفعالها في السنين",41,"ن",1,0],["ما كفاه الجوى وطول الفراق","فأتى بالرقيب يوم التلاقي",42,"ق",2,1],["ما كَفى أَن سَلَبتُمُوهُ الكَرى حَت","تى حَمَلتُهم فُؤادَهُ فِي الحُمولِ",43,"ل",1,0],["ما كفاه خيبة صادَفَها","في ذُرا الفيّوم إذ كرّ وشَد",44,"د",1,0],["ما كفاه بحاجيبيه قسيا","وبأهداب مقلتيه نبالا",45,"ل",2,0],["ما كفتنا محاسن العين حتى","ملكتنا الحسان بالهمات",46,"ت",1,0],["ما كفانا شاهين بينك حتى","يمسيَ البين بالردى مختوما",47,"م",2,0],["ما كفوء مَريَم إِلّا فارِس أَدَباً","وفقتما لِرِضى الرَّحمنِ وَالناسِ",48,"س",1,0],["ما كفانا شر الحروب فوافا","نا جرادٌ قد غادر الأرض جردا",49,"د",2,0],["ما كفى الناس أنهم فقدوا المال","فجاء الجرادُ للناس رفدا",49,"د",2,0],["ما كفى بائساتنا عطل النحر","فكان الجراد للنحر عقدا",49,"د",2,0],["ما كَفَى أنَّه أرادَ لي الكَيْ","دَ مِراراً ولم يَنَلْ غيرَ وَجْدِ",50,"د",1,0],["ما كفاهم قتل المطهر حتى","أوطؤوا الصدر منه جرد المذاكي",51,"ك",2,0],["ما كَفى البَين أَن يَست بِأَهلي","ه فَأَقصى حَبيبه وَمزاره",52,"ر",2,0],["ما كَفى الناسَ منهُ ضنك معاشٍ","كادَ يودي بِالكُلّ من إِملاقِ",53,"ق",1,0],["ما كَفى الناسَ ما الَّذي حَلَّ فيهِم","من شقاقٍ أَدّى لكلّ اِفتِراقِ",53,"ق",1,0],["ما كَفى الناس قطعُ كلّ صِلاتٍ","بَينَهُم في الإِخاءِ وَالأعراقِ",53,"ق",1,0],["ما كفاها السعير في الغرب حتى","أصبحت في مفارق الشرق تغلي",54,"ل",2,0],["ما كفا من بناتها ما نقاسي","كل يوم عنها يقولون حبلي",55,"ي",1,0],["ما كفاني لرد مِعشار َعُشْر ِ ال","عُشْر مهما بذلت من إِ سهامِ",56,"م",1,0],["ما كفه عنها تقاه ولا نهاه أن استقام","لا لا تسيئوا الظن فهي طهورة طهر الغمام",57,"م",1,0],["مأكفاك نزفي دم .. قلت أنزف جراح","وحبك مقيم وشرهتي شخص عابر",58,"ر",1,0],["ما كفتا محاسن العين حتى","ملكتنا الحسان بالهمّات",59,"ت",1,0],["مَاْ كَفَّنَا عَمَهٌ إِلا وَجَلَّلَهُ","وَغَدٌ لِسَيِّدِهِ وَغْدَاً قَضَىْ وَهَنَا",60,"ن",2,0],["ما كفة رجحت بقيمة أمة","ألا وفضل نشاطها ميزانها",61,"ن",3,0],["ما كَفاهُ الأمسَ من غَدرٍ لنا","ما كفاهُ كمْ جَنى مِن حِصّتي",62,"ت",2,0],["ما كفاها تقديم تيم عليه","وعدي وليته قد كفاها",63,"ا",3,0],["ما كفر الشيخ إلاَّ من طغى ودعا","غير الإله وبالإشراك قد دانا",64,"ن",2,0],["ما كفّنوهُمْ حينَ ماتَ شعورُهم","غِيدَ القصورِ وساكني الأبراجِ",65,"ج",1,0],["ما كفاهم أخذوا جُلَّ بلادي","وذرى الجولان أخذاً مُكْربا",66,"ب",2,0],["ما كفه غير حوض للمنون بها","والناس ورادها والسيف ساقيها",67,"ي",3,0],["ما كفته الحَمامة الحصداء","سارَ عَن مَكَّة وَقَد رام درءا",68,"ا",2,0],["ما كَفى القوم أَنَّه فات بَيته","وَمَضى مخفياً عَن الكل صوته",68,"ه",1,0]]}