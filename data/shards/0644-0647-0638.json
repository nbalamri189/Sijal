{"poems":[[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[471,"إذا انشق عند السابري رأيته","https://www.aldiwan.net/poem50369.html","الطويل"],[563,"فراشتي رأت النور الذي ظهرا","https://www.aldiwan.net/poem34480.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38123","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67909","المتقارب"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103455","المجتث"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26961","الطويل"]],"verses":[["لَهُ ظِلُّ نُعمى يَذكُرُ الهِمُّ عِندَهُ","ظِلالَ الصِبا بَل ذاكَ أَندى وَأَورَفُ",0,"ف",1,0],["لَهُ ظِلُّ أَرطاةٍ باعوَجَ مائِلٍ","إذا شاءَ أَصغَى خَدَّهُ فَتَوَسَّدا",1,"د",2,0],["له ظهور بأشكال قد اختلفت","فيعشقون له الأشكال والصورا",2,"ر",2,0],["لَهُ ظاهِرٌ قَد عَمَّه الحسنُ كلُّهُ","وَظاهِرُهُ لا شكّ عُنوانُ باطِنِ",3,"ن",1,0],["له ظاهرٌ مثلُ بُردٍ موشّى","وبطنٌ كما حَسَرَ الأصلعُ",4,"ع",1,0],["له ظنابيبُ هِقلٍ","وعينُ صقرٍ ذعورِ",5,"ر",1,0],["له ظلّ يرثي كلّ قاس فؤاده","وأعدى العدى يغدو له وهو راحم",6,"م",1,0],["لَهُ ظُلمَةٌ كَاللَيلِ أَسوَدَ حالِكٍ","وَمِن تَحتِ صُبح أَو شُعاع الثَواقِبِ",7,"ب",1,0],["لَهُ ظُلُماتٌ بَعضُها فَوقَ بَعضِها","دَآدِئُ مَوصولٌ بِهِنَّ دَآدي",8,"د",2,0]]}