/77696","البسيط"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143307","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72475","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120242","السريع"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105491","الطويل"],[4691,"إهداء لزياد بنجر","https://www.poetsgate.com/ViewPoem.aspx?id=170289",""],[4755,"لِإِيْلَافِ قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183517",""],[4778,"تعالوا لنبدأ يوما سعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=208999",""],[4884,"بَعِيْدٌ قريب","https://www.poetsgate.com/ViewPoem.aspx?id=201734",""],[4927,"جواز السفر","https://www.poetsgate.com/ViewPoem.aspx?id=80800",""],[585,"نح الدنان ودعني أيها الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=161929",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[5338,"أرى أدمعي منها السحائب تستجدي","https://www.poetsgate.com/ViewPoem.aspx?id=187912",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5413,"تلك عشرة كاملةٌ!!","https://www.poetsgate.com/ViewPoem.aspx?id=200576",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5587,"العلم","https://www.poetsgate.com/ViewPoem.aspx?id=196761",""],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""],[242,"إلى م فؤادي يذوب زفيرا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563700",""],[6267,"رحلتُ إليهِ مِنْ بَلدي وأهلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8336&r=&rc=45",""]],"verses":[["فَمِن راكِضٍ مائِلٍ نَحوَها","وَأَصحابُهُ نَحوَها راكِضونا",0,"ن",2,0],["فَمَن راني فَلا يَفتَرَّ بَعدي","بِحُلوِ القَولِ أَو يَبلو الدَفينا",1,"ن",2,0],["فمِنْ راحِهِ اليُسْرى ومِنْ عِنْدِهِ النّصْرُ","الى مَنْ لهُ في خَلْقِهِ النّهْيُ والأمْرُ",2,"ر",1,1],["فمن رآه رأى رياضا","الاس والورد والبهار",3,"ر",1,0],["فَمَن راقَبَ الجَوزاءَ أَو باتَ لَيلُهُ","طَويلاً فَلَيلي بِالمَجازَةِ أَطوَلُ",4,"ل",1,0],["فمن رآكَ وآثاراً ظهرت بها","رأى سليمانَ واسْتجلى عمائره",5,"ر",2,0],["فمن رفدٍ يفيئ لمستميحٍ","ومن رأيٍ يضيئ لمستنير",6,"ر",1,0],["فمن رأى مثل أبي حفصلٍ","في السبّ أو مثليَ في الذبِّ",7,"ب",1,0],["فمنْ رأى في بَذْلِهِ بَذْلَةً","للوجه والأوهامُ قد تُوهَمُ",8,"م",1,0],["فمن رحم اليتيم ففي","رسول الله يرحمه",9,"م",2,0],["فَمِن راجِلٍ تَهوي السِنونُ بِرِجلِهِ","وَمِن فارِسٍ تَمشي النِساءُ وَيَركَبُ",10,"ب",1,0],["فمن رام من بعد ذا أن نزيد","بياناً فقولوا له إلا مزيدا",11,"د",2,0],["فَمِنْ رَوْضٍ حَمَدتُ به مُرادي","ومن ظِلٍّ شكَرْتُ به مَقيلي",12,"ل",2,0],["فمِن رَوْضَةٍ سارٍ إلينا نسيمُها","ومن مُزْنَةٍ مُرخىً علينا سُتورُها",13,"ر",3,0],["فمَنْ راحَ يُسخِطُ عُذَّالَه","ويُرضي الهَوى بينَ عُودٍ وراحِ",14,"ح",1,0],["فمن رَهَجٍ لا يُستثارُ بحافرٍ","لديهم وخيلٍ لا تَذِلُّ لراكبِ",15,"ب",1,0],["فمن راكبٍ يأتي به الخصبَ بازلٌ","وَمِن فَارسٍ يَصْلَى بِهِ الحربَ شَيظمُ",16,"م",1,0],["فَمَن رَآني مِنَ الأَقوامِ كُلِّهِمِ","فَقَد رَأى مُحسِناً مِن غَيرِ إِحسانِ",17,"ن",1,0],["فَمَنْ رَامَهُ فَلْيَتَّخِذْ مِنْ قَصَائِدِي","سُطُوراً إِلَى مَرْقَاهُ مِثْلَ السَّلالِمِ",18,"م",1,0],["فمنْ رامَ تقويمي فإني مقوَّمٌ","ومَنْ رامَ تعويجي فإني مُعَوَّجُ",19,"ج",1,0],["فَمَن رَأى مِثلَ الرَبابِ قَصراً","كَم حِكمَةٍ فيهِ تُخالُ سِحرا",20,"ر",2,0],["فَمَن رَأى النيلَ رَأيَ العَينِ مِن كَثَبٍ","فَما أَرى النيلَ إِلّا في البَواقيلِ",21,"ل",1,0],["فَمَن راكبٌ يأَتي إِبنَ هِندَ بِحاجَتي","عَلى النّأيِ وَالأَنباءُ تُنمي وَتُجلَبُ",22,"ب",1,0],["فمَنْ رأى بنتَ مروانَ انحنتْ تَعَباً","من السَلاسِلِ يَرحَمْ بنتَ مَروانا",23,"ن",2,0],["فمن رقع العروق الى التهامي","وحرز من علي الال حالا",24,"ل",2,0],["فمن رام انفطامى عن هواها","فقد عُسُرُ انفطامى عن قَطَام",25,"م",1,0],["فَمَن رَأوهُ رَأَوهُ لاِشتِرَاكِهِما","في الظَّرفِ إِذ زَعَمُوهُ في القُرآنِ بَدَا",26,"د",2,0],["فمَن راغَمنَه رجَع الهُويْنا","ومن أخطأنه بلغ المَحلاّ",27,"ل",2,0],["فَمِن رَأيِهِ الواري عَواليهِ أُشرِعَت","وَمِن عَزمِهِ الماضي تُسَلُّ القَواضِبُ",28,"ب",1,0],["فَمَن رامَ ما قَد حازَهُ لَم يُضاهِهِ","هَنيئاً لَنا في الحَشرِ إِنّا بِجاهِهِ",29,"ه",1,0],["فَمَن رامَ أَن يَستَعبِدَ الناسَ فَليَمِل","عَلَيهِم بِأَطرافِ القَنا غَيرَ راحِمِ",30,"م",1,0],["فمن رأى ما رأت عيناي من نفر","كانوا هم الراس فيه السمع والبصر",31,"ر",1,0],["فَمِن رَهبةٍ أَو رَغبةٍ كَم سعى له","طَغامٌ من الجهّالِ أَكسبهم خُسرا",32,"ر",2,0],["فمن ربحَ اليومَ ذا","فذاكَ غداً يخسرُ",33,"ر",1,0],["فمن راحتيها الراح أرْشفُ صفوَه","وأرْشفُ بعد الراحِ ثَغْراً مُفَلّجا",34,"ج",2,0],["فَمِنْ رِقَّةٍ قَدْ حَكَيْتُ نَسِيماً","وَمِنْ دَنَفٍ قَدْ حَكَيْتُ نَضِيرَا",35,"ر",2,0],["فمن رآنِي ظنَّ بي نشوةً","أجل بكأسِ الحُزنِ لا السّلسَل",36,"ل",1,0],["فمن رامه الا بتقليد واصل","حكيم اضاع الحزم فيه وخابا",37,"ب",2,0],["فمن رام صيد المجد فليصطحبهما","فصائد هذي فوق هاتيك صائل",38,"ل",1,0],["فمن رحمٍ دفعٌ وبلعٌ من الثَّرى","وهذا لهُ طَمرٌ وذاك لهُ نبش",39,"ش",1,0],["فَمِن رعيِها أنسٌ وعِلمٌ وحِكمةٌ","وما هَيّجت إِلا اللّطيفَ المناظر",40,"ر",1,0],["فَمِن رُؤُوسٍ إِلى أَكُفٍّ","وَمِنْ أَكُفّ إِلَى رُؤُوسِ",41,"س",1,0],["فمِنْ رِئي رَبيعيٍّ وَري","كإشراقِ الرياضِ عَلى الغَديرِ",42,"ر",1,0],["فَمَن رَأى غُصنَ بانٍ في كَثيبِ نَقاً","مِن قَبلِهِ مُثمِراً تُفّاحَ لُبنانِ",43,"ن",1,0],["فَمَن رَآها مِن جَميعِ الوَرى","في مَجلِسٍ أَدرَكَ ما أَمَّلَه",44,"ل",2,0],["فَمِن رِدفِها وَالوَجهِ وَالقَدِّ سافِراً","رَأَيتُ اِرتِجاجَ الحِقفِ وَالخَوط وَالبَدرا",45,"ر",2,0],["فمن رأى بعدك طيف الكرى","أو سلم الغمض على مقلته",46,"ه",1,0],["فمن رسولي إلى سعدي يخبرها","أني سقيم وأن البعد أضناني",47,"ن",2,0],["فمن رسولي إلى سعاد","تعطيني الأمن والخفر",48,"ر",1,0],["فمن رفض العصيان أبقاه في هنا","وراعاه في الأرزاق عن شوب خسران",49,"ن",1,0],["فمن راهبٍ عارٍ وآخرَ متَّقٍ","ومن فاضلٍ برٍّ وعدلٍ وناسك",50,"ك",1,0],["فمن رام أن يعتاض منهم بغيرهم","يكون كمعتاض اللُجين بِآنُك",50,"ك",1,0],["فَمَن رامَ البَقاءَ بغير فضلٍ","يعودُ من الفَناءِ إلى الفَناءِ",51,"ا",2,0],["فمن رحم يرحم","جاعن رسول الله",52,"ه",1,0],["فَمن رَمَدٍ آذاهُ جَلّاهُ داعياً","لِساعته وَالريحُ في الحَربِ عاصِبُ",53,"ب",1,0],["فمن رام تقبيلا عبيد له لمى","رقيق خطاب راق انساً بلا صد",54,"د",1,0],["فمن رأى لوعتي بالوجد بان له","صدقي وجدّ به عشق وقد شغفا",55,"ف",2,0],["فمَنْ رآني فقد أحاطَ بما","في الدارِ عِلماً هذا هو العجَبُ",56,"ب",1,0],["فمَنْ رأى من قبلِها معرَكاً","يَحولُ في الحالةِ بُسْتانا",57,"ن",2,0],["فمن رام مني سلوة ينسخ الهوى","فكم فتنت قبلي بحكم الهوى الصلب",58,"ب",1,0],["فمن رضوى الكبير جرى فلاقى اب","نه الغربي فاختلطا ثناها",59,"ا",3,0],["فمن روضة غناء تجري خلالها","جداولُ من نهر يفيض إِلى نهر",60,"ر",1,0],["فمن رأى قبلَ صداي شفةً","جفَّ القَليبُ فارتوت بالشَّطَنِ",61,"ن",1,0],["فمن رسولٌ إليكِ يُذكِرِك ال","أَيْمان بل أين منكِ أَيْمانُ",62,"ن",1,0],["فَمَن رَآهُ رَأى مِن جِسمِهِ شَبَحاً","نُحولُهُ لِكِتابِ الحُبِّ عُنوانُ",63,"ن",1,0],["فمن رامنا يلق المعارف تنجلى","عليه وألطاف العوارف والبر",64,"ر",1,0],["فَمِن رَوضَةٍ بِالحُسنِ تُرفِدُ رَوضَةً","وَمِن نَهرٍ بِالفيضِ يَجري إِلى نَهرِ",65,"ر",1,0],["فمِنْ رحمِها أولدُ كلّ صبيحةٍ","وأُردىْ فأسقي أرْضَها دمَ طهَ",66,"ه",1,0],["فَمَنْ رامَ بأنْ يَأْتي","بما تَأْتي به أَبْلَهْ",67,"ل",2,0],["فَمنْ رآهْ مَنَاماً قَدْ رَآهُ كما","لَوْ كانَ حَيّاً وَهَذَا صَحَّ في الْخَبَرِ",68,"ر",1,0],["فَمِن رَاحٍ بها طَابَت سُقَاةٌ","ومِن سَاقٍ به راحٌ تَطِيبُ",69,"ب",1,0],["فمِن رجلٍ قضّى الحِمامُ ديونَه","وآخرَ يُلوى كلَّ يومٍ ويُمْطَلُ",70,"ل",1,0],["فمنْ راحلٍ لا إِيابٌ له","وماضٍ وليس له من خَلَفْ",71,"ف",1,0],["فَمَن رَأى مِنكُمُ في نَظمِها خَلَلاً","يُصلِحهُ إِنَّني مُلازِمٌ سَفَرا",72,"ر",2,0],["فمن رام أن يجنى جمانا ولؤلؤا","ففي ذلك البحر الجواهر والدر",73,"ر",1,0],["فَمِن راحل بِالشَط غادر أَهله","إِلى راكب قَديم الصَحب وَالأَهلا",74,"ل",2,0],["فمن رأى اللَه في مرآة تنظره","بلا مراء كبدر التم في الظلم",75,"م",1,0],["فَمَن رامَ يَحذو حَذوه فَهوَ قاصر","وَلَو أَنَّهُ بَينَ الأَنام نقاب",76,"ب",1,0],["فمن رام يبصر حرب العنا","صِر أجمع يبصرها ههنا",77,"ن",2,0],["فمن رأى مرة ما أنت مكتتبٌ","به تطوع للإحسان مرات",78,"ت",1,0],["فمن رأى خطأ مسعاك بات وفي","فؤاده منك غيظ محرق حام",79,"م",1,0],["فمن رآني فقد رأَى رجلاً","حليفَ وصلٍ في زيِّ مهجور",80,"ر",1,0],["فَمِن راقِصٍ بالنور أَحسَن رقصَةٍ","بِها يَخطِفُ الأَلبابَ مِن أَهلِها خَطفا",81,"ف",2,0],["فَمَن رَأى عاشِقاً بالحبِّ ماتَ بِلا","قَتلِ الهَوى أَو بِغَيرِ السّيفِ وَالأسَلِ",82,"ل",1,0],["فَمَن رَآكَ رَأى الدُنيا وَما جَمَعَت","وَالناسَ كُلُّهُمُ في شَخصِ إِنسانِ",83,"ن",1,1],["فمن رأى للهذيا","ن موكباً كموكبي",84,"ب",2,0],["فَمَنْ رَأَى ذلكَ الوِشاحَ ال","صائمَ صلَّى على مُحمَّدْ",85,"د",1,0],["فمن رأيت وماذا قد سمعت وفي","أي المراتب كان الشمس في الحمل",86,"ل",1,0],["فمن رام ان يلقى الحبيب بحقه","فهذا دليل الرشد في الذكر قد قري",87,"ر",2,0],["فمن رأى قمراً يُزهى وليلتُه","محجوبةٌ عن عيونِ الناسِ في شفقِ",88,"ق",1,0],["فمن رأس بلا بدن يعلى","وجثمان يكفنه الصعيد",89,"د",1,0],["فمن رضاب الشادن الا لعس","فلو سقيت المعدم المعسرا",90,"ر",2,0],["فَمن رَأَى سُوءَ حَالي","بَكَى عَليَّ ولامَكْ",91,"ك",1,0],["فمن رأى من قبلها","ناراً بها نقع الغلل",92,"ل",1,0],["فمن رام إبداعَ القريض يقل به","كقولي والا فهو في الناس اشعب",93,"ب",1,0],["فَمِن رُطَبٍ في النَّخلِ حُلوٌ مَذاقُهُ","إِلى عِنَبٍ يُسقى رَحيقاً وَيُؤكَلُ",94,"ل",1,0],["فمن رأى منظر اسماعيل ارخه","ازهى من الشمس بل اسنى من القمر",95,"ر",1,0],["فَمن راجف قَد أَلزَم القَلب كَفه","يسكِن بِالشلاء رَوعة خافق",96,"ق",1,0],["فَمَن رآني رَأى عبرى مولّهةً","عَجيبةَ الزيّ تَبكي بين أمواتِ",97,"ت",1,0],["فمن راحَةٍ ريحُها الارتياحُ","ومن ماءِ صادٍ إِلَى كلِّ صادِ",98,"د",1,0],["فمن رماه الدهر بالإفلاس","حتى عن المسكين واللباس",99,"س",1,0],["فمَنْ رامَ عند الفضل إدراكَ شأوه","كمنْ رامَ حَملَ الراسياتِ بإصبع",100,"ع",1,0],["فَمَن رَعى غَنَماً في أَرضِ مَسبَعَةٍ","وَنامَ عَنها رَعَت ذُؤبانُها الغَنَما",101,"م",2,0],["فَمَنْ رأى عُنْقَهُ الطويلَ ولا","يَنْزِل