{"poems":[[55,"سلا ظاهر الأنفاس عن باطن الوجد","https://www.aldiwan.net/poem30601.html","الطويل"],[47,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[68,"لئن ثلمتْ حدّي صُروفُ النّوائبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3074",""],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[287,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96974","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74060","البسيط"],[5725,"ترنيمة ام الربيعين","https://www.poetsgate.com/ViewPoem.aspx?id=183386",""]],"verses":[["لَئِن ثَلَمَت مِنّي اللَيالي عَشائِري","فَما ثَلَموا إِلّا مِنَ الحَسَبِ العِدِّ",0,"د",1,0],["لَئِن ثَنى الدَهرُ مِن سَهمي فَلَم يَصِلِ","وَرَدَّ مِن يَدِيَ الطولى فَلَم تَنَلِ",1,"ل",1,1],["لَئِن ثَلَمَت حَدّي صُروفُ النَوائِبِ","فَقَد أَخلَصَت سَبكي بِنارِ التَجارِبِ",2,"ب",1,1],["لئن ثلمتْ حدّي صُروفُ النّوائبِ","فقدَ أخلصتْ سبَكي بنارِ التَداربِ",3,"ب",1,1],["لئن ثبتت أقدامكم ونفوسكم","رجعتم إلى اليرموكِ والقادسية",4,"ه",1,0],["لَئِن ثُلَّ يا لِلَهِ بِالمَوتِ عَرشُهُ","فَما أَحَدٌ إِلّا عَلى ظَهرِ أَوفازِ",5,"ز",1,0],["لئن ثوى جسمه في كربلاء لقى","فراسه لنساه في السباء رعى",6,"ع",2,0],["لئن ثنت الأقدار عزمي عن السرى","فشوقي إليه دائمٌ وتلدّدي",7,"د",2,0],["لينثن الدهر وَلتنأد جوانبه","إنّ السبيل قويم غير منآدِ",8,"د",1,0],["لينثر امنا على الخائفين","ويدعو لفجر يشيع السنا",9,"ن",2,0]]}