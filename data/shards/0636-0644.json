غاضِ",77,"ض",1,0],["ضَلَّت عُقولُ بَني الدُنيا لَقَد عَلِقوا","فيها بِحَبلٍ مِنَ الآمالِ أَرمامِ",78,"م",1,0],["ضَللتُ سُبلاً وَخُنتُ عَهداً","إِن لَم تَبِت عبرَتي تَفيضُ",79,"ض",1,0],["ضَلَّت مَكائِدُ أَعدائي مَتى سَمِعوا","بِنابِحٍ في دَمِ الضّرغامِ وَلّاغِ",80,"غ",1,1],["ضلّ شعري وندّ عني بياني","ما على الشاعرين لو أرشداني",81,"ي",1,1],["ضِلَّةً نَكْتُمُ الْمَشِيبَ فَيَبْدُو","ضَاحِكاً سَاخِراً خِلاَلَ خِضَابِهْ",82,"ب",2,0],["ضِلَّةً تَطلُبُ الزُّلالَ من النَا","رِ وتَبْغِي غَضارةً من فَلاَةِ",83,"ه",1,0],["ضلَّ من يكفيه قليلٌ من الزا","دِ، ولا يكتفي بمُلكِ الرشيد",84,"د",1,0],["ضلَّت قوافلها؛ فكان دليلها","ووهت جحافلُها، فكان القائدا",85,"د",2,0],["ضلَّ ابنُ آدمَ إذ رام الوصولَ إلى","نهاية الكون! والإنسان إنسان!",86,"ن",1,0],["ضلَّ ابنُ آدمَ نهَجَهُ","حتى رأى كلبًا هداه",87,"ا",2,0],["ضلتْ حلومهمُ عنهم ، وغرهمُ","سنُّ المعيديّ غي رعيٍ وتغريبِ",88,"ب",1,0],["ضَلِلْتُمْ، فهل من كوكبٍ يُهتدى به،","فقد طالَ ما جَنّ الظلامُ وما دجّا",89,"ج",2,0],["ضلَّة ً للمهنِّيك بأن وُلّ","ِ يتَ ما تستحقه إقطاعا",90,"ع",2,0],["ضلعاً على اضغانها عوجاءَ","وَمُضَاغِنٍ مَلآنَ يَكْتُمُ غَيْظَهُ",91,"ه",1,0],["ضلَّ قومٌ توهموا الصبرَ حاماً","وَ هوَ - إلاَّ لدى الكريهوِ - ذامُ",92,"م",1,0],["ضلّ في جنح ليله زورقي البا","سم يهفو الحنين ملء وشاحه",93,"ح",2,0]]}