{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[53,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[63,"ضلت قبيلة راموا مساجلتي","https://www.aldiwan.net/poem45928.html","البسيط"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[73,"ليهن الهدى إنجاح سعيك في العدا","https://www.aldiwan.net/poem11949.html","الطويل"],[93,"لم تشق نفس أنت مسعدها","https://www.aldiwan.net/poem11086.html","أحذ الكامل"],[93,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[88,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[88,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"وما الفقر عيبا ما تجمل أهله","https://www.aldiwan.net/poem8133.html","الطويل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"لا تهولنك شمس كسفت","https://www.aldiwan.net/poem8167.html","الرمل"],[51,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"يا ابن بوران لات حين مناص","https://www.aldiwan.net/poem64937.html","الخفيف"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"يا أبا الصقر زادك الله في المجد","https://www.aldiwan.net/poem65411.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"أيها القائل بالجسم","https://www.aldiwan.net/poem66327.html","مجزوء الرمل"],[51,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[85,"ضللت أبناء البلاد بأسطر","https://www.aldiwan.net/poem7254.html","الكامل"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[56,"كلانا غصن شطب","https://www.aldiwan.net/poem58654.html","الهزج"],[43,"إذا كان مدح فالنسيب المقدم","https://www.aldiwan.net/poem10143.html","الطويل"],[62,"ضيف سرى والليل ينفض صبغه","https://www.aldiwan.net/poem52365.html","الكامل"],[45,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[45,"ما بعيني هذا الغزال الغرير","https://www.aldiwan.net/poem63566.html","الخفيف"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[87,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[105,"أيها القائد العظيم تقدم","https://www.aldiwan.net/poem42050.html","الخفيف"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[105,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[81,"ضللت بالبدر على نوره","https://www.aldiwan.net/poem61517.html","السريع"],[52,"ضلوا وقادهم إمام ضلالة","https://www.aldiwan.net/poem26733.html","الكامل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[7,"إني كأني لدى النعمان خبره","https://www.aldiwan.net/poem2016.html","البسيط"],[46,"لو كنت يعقوب طير كنت أرشد في","https://www.aldiwan.net/poem22128.html","البسيط"],[46,"تيمم فجا واحدا كل راكب","https://www.aldiwan.net/poem22248.html","الطويل"],[46,"بلوت من هذه الدنيا وساكنها","https://www.aldiwan.net/poem22397.html","البسيط"],[46,"فعلت فعل تجار مخسرين به","https://www.aldiwan.net/poem22667.html","البسيط"],[46,"المرء يأبر خسة في طبعه","https://www.aldiwan.net/poem22716.html","الكامل"],[46,"وقت يمر وأقدار مسببة","https://www.aldiwan.net/poem23130.html","البسيط"],[46,"يا راعي الود الذي أفعاله","https://www.aldiwan.net/poem23629.html","الكامل"],[8,"وأخرج من تحت العجاجة صدره","https://www.aldiwan.net/poem21819.html","الطويل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85457","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85317","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39591","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39540","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39658","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30483","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/199536","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43850","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43780","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[7,"إني كأني ، لدى النعمانِ خبرهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17545",""],[46,"تيمّمَ، فجّاً واحداً، كلُّ راكبٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18240",""],[51,"يا أبا الصقرِ زادكَ اللَّه في ال","https://www.poetsgate.com/ViewPoem.aspx?id=29584",""],[53,"أيُّ العُيُونِ تُجَانِبُ الأقْذاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9806&r=&rc=3",""],[87,"مَنْ لِعَيْنٍ إِنْسَانُهَا لاَ يَنَامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23860&r=&rc=122",""],[96,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""]],"verses":[["ضَلالاً لِراجي نَشطَةٍ مِن رَبيعِكُم","رَمى الداءَ في أَكلائِكُم فَحَماها",0,"ا",3,0],["ضَلّوا وَراءَكَ حَتّى قالَ قائِلُهُم","ماذا الضَلالُ وَذا يَجري عَلى السَنَنِ",1,"ن",1,0],["ضَلالاً لِسائِلِ هَذي المَغاني","وَغَيّاً لِطالِبِ تِلكَ الغَواني",2,"ي",1,1],["ضِلَّةُ الزائِدِ قَد خا","طَرَ بِالبَكرِ فَنيقَه",3,"ق",2,0],["ضَلالاً لِقَلبي ما يُجَنُّ مِنَ الهَوى","وَمِن عَجَبِ الأَيّامِ كَيفَ يُصابُ",4,"ب",1,0],["ضَلالاً لَكَ مِن غاوٍ","سَليبِ الرَأيِ وَاللُبِّ",5,"ب",1,0],["ضَلَّتْ قُبَيِّلَةٌ رامُوا مُساجَلَتي","وَلَمْ تَطَأْ صَفْحَةَ الغَبْراءِ أَمْثالي",6,"ي",1,1],["ضَلالاً تَمادى الحُبُّ في المَعشَرِ العِدا","وَلَفَّ الهَوى في حَيثُ تُخشى الغَوائِلُ",7,"ل",1,0],["ضَلالاً لِمَفتونٍ سَمَوتَ بِحالِهِ","إِلى أَن بَدَت بَينَ الفَراقِدِ فَرقَدا",8,"د",2,0],["ضل السعادة في الحياة ولم","يبرح على الأيام ينشدها",9,"د",3,0],["ضَلَّ مَنْ يَجْعَلُ الضُّلُولَ إِمَامَا","حَاذِرُوا فِي اخْتِيَارِكُمْ أَنْ تُرَاءُوا",10,"ا",3,0],["ضِلَّةً لِلَّذِينَ يَبْغُونَ مِنْهُمْ","قَبْلَ مِيعَادِهِ كَمَالَ الحُلُومِ",11,"م",1,0],["ضلّة جاهلية أنكرتها","رسل الفنّ في هدى الإسلام",12,"م",1,0],["ضلال على مرّ الجديدين لم تزل","مغاربنا من أمره كالمشارق",13,"ق",1,0],["ضلّ من رام راحةً في حياة","نحن منها في معرك وجلاد",14,"د",1,0],["ضَلَلتَ ضَلالَ السامِرِيِّ وَقَومِهِ","دَعاهُم فَظَلّوا عاكِفينَ عَلى عِجلِ",15,"ل",1,0],["ضَلالٌ مارَأَيتُ مِنَ الضَلالِ","مُعاتَبَةُ الكَريمِ عَلى النَوالِ",16,"ل",1,1],["ضَلةً لامرئٍ يُشمِّرُ في الجم","ع لعيش مُشَمِّرٍ للفناءِ",17,"ا",2,0],["ضَلالاً لمن يسعى إلى غير غايةٍ","ولا يرتجى ناهيهِ عند انتهائِهِ",18,"ا",3,0],["ضلّةً ضلّةً لمن وعَظَتْهُ","غِيَرُ الدهر وهْو غيرُ مُنيبِ",19,"ب",1,0],["ضلَّ باكٍ إن أبيخت جمرةٌ","سوف تُذكيها يَدا مُثْقبِها",20,"ب",3,0],["ضل فما يهتدي لطيِّبَةٍ","كأنما مُجتناه مُحتطبُهْ",21,"ب",2,0],["ضليعاً إذا ما اسْتُحْمِلَ الخطبَ ناهضاً","بأعبائه ليست له عثراتُ",22,"ت",1,0],["ضلَّ إهداؤكَ الخرائطَ يا نُجْ","حُ وألوَتْ به سَوَافي الرياحِ",23,"ح",1,0],["ضلَّةً للفُؤاد يَحْنُو عليها","وهي تَزْهُو حَياتَه وتَكيدُ",24,"د",1,0],["ضلَّ ما أطمعتْكَ نفسك فيه","من أماني شيطانها النكَّاص",25,"ص",1,0],["ضلّ منا الندى فلما نَشَدْنا","هُ وجدناهُ في بني الفيّاض",26,"ض",1,0],["ضلّةٌ للمهنئيك بأن ول","لِيت ما تستحقه إقطاعا",27,"ع",2,0],["ضلَّ يعقوبُ إذ يُعِدُّ التهاوي","لَ لمن لا يُهالُ بالأهوالِ",28,"ل",1,0],["ضلَّ حِلْمٌ لك أضحى","يعبُدُ الأير وعلمُ",29,"م",1,0],["ضلَّ من قد دعوتُ دونَكَ عني","ووجدت الكرامَ غيرَ كرام",30,"م",1,0],["ضَلَّ هَذا وَذا فَما حَفَزَ الإِن","سانَ شَيءٌ لِلشِعرِ كَالإِنسانِ",31,"ن",1,0],["ضَلَّلت أبناء البلاد بأسطر","ملأت قلوب الغافلين ضلالا",32,"ل",2,1],["ضَلَّت كَراها في غَياهِبِ حالِكٍ","ضَلَّ الصَباحَ عَلَيهِ صَوتُ الديكِ",33,"ك",1,0],["ضَلّوا عُقولاً بَعدَ عِرفانِ الهُدى","وَالعَقلُ إِن هُوَ ضَلَّ كانَ عِقالا",34,"ل",2,0],["ضَلَّ الأَميرُ كَما ضَلَّ الوَزيرُ بِهِم","كِلا السَرابَينِ أَظماهُم وَلَم يَصُبِ",35,"ب",1,0],["ضُلُوعٌ ما لها رُوحٌ","ولا يَسْكُنُها القَلْبُ",36,"ب",1,0],["ضَلالاً لِهَذي الريحِ ماذا تُريدُهُ","وَهَدياً لِهَذا السَيلِ ماذا يُؤَمِّمُ",37,"م",1,0],["ضَلَّ اِمرؤٌ يغتالُ ذروةَ عُمْرهِ","بشفائِه حَرَضاً من الأحراضِ",38,"ض",1,0],["ضَلالاً لَها ماذا أَرادَت إِلى الصَدِّ","وَنَحنُ وُقوفٌ مِن فِراقِ عَلى حَدِّ",39,"د",1,1],["ضَلَّ بَدرُ السَماءِ أَو كادَ لَمّا","واجَهَتهُ وُجوهُ تِلكَ البُدورِ",40,"ر",1,0],["ضَلَّ الَّذي أَضحى يُطاوِلُهُ","وَبِإِصرِهِ يَجري القَضا المَقضي",41,"ي",1,0],["ضَلَّيتُ إِن لَم أُصفِهِ مِدَحي","وَإِلَيهِ نِضوُ قَريحَتي أُنضي",41,"ي",1,0],["ضَلَّت فَظَنَّت في مُقارِعَةِ العِدى","أَنَّ الغُمودَ مَعاقِدُ التيجانِ",42,"ن",1,0],["ضل في الأرض الذي ينشد أبناء السماء","أي روحانية تعصر من طين وماء",43,"ا",2,0],["ضَلَّ قَوْمٌ تَوَهَّمُوا الصَّبْرَ حِلْمَاً","وَهْوَ إِلَّا لَدَى الْكَرِيهَةِ ذَامُ",44,"م",1,0],["ضلَّ من يَحسبُ الرجالَ سواءً","أفضلُ الناس من أعدَّ ونظّمْ",45,"م",1,0],["ضلّ الأُلىَ جَحَدوه واتّخذوا له","شُركاءَ من أربابهم وخُصوما",46,"م",2,0],["ضَلَّ المُلوكُ فَجَدَّدوا لِشُعوبِهِم","دينَ العَمى وَعِبادَةَ الأَوثانِ",47,"ن",1,0],["ضَلَّ من يدَّعِي لِمَنْ هُوَ فَردٌ","في عُلاهُ الأبناءَ والأندادا",48,"د",2,0],["ضلّ الألى تركوا دُستورَهُ سفهاً","فلا الدساتيرُ أغنتهم ولا النُّظمُ",49,"م",1,0],["ضَلّوا السَّبيلَ وفي يمينِكَ ساطعٌ","يَهدِي النفوسَ إلى التي هي أوضَحُ",50,"ح",1,0],["ضَلَلتُ بِالبَدرِ عَلى نورِهِ","وَالناسُ يَستَهدونَ بِالبَدرِ",51,"ر",1,1],["ضَلّوا وَقادَهُمُ إِمامُ ضَلالَةٍ","قَد كانَ بَدَّلَ دينَهُم تَبديلا",52,"ل",2,1],["ضَلَّ الَّذينَ تَأَلَّهوا أحبَارهم","ليُحَرِّمُوا وَيُحَلِّلُوا وَيُبِيحُوا",53,"ح",3,0],["ضَلَّ النَّصارَى في المَسِيحِ وَأَقْسَمُوا","لا يَهْتَدُونَ إلَى الرَّشادِ سَبِيلا",54,"ل",2,0],["ضَلَّ النَّصارَى واليَهُودُ فلا