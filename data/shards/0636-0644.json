ldiwan.net/poem48058.html","الوافر"],[553,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"],[558,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"],[558,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[558,"ضل الذي عن ضوء شمسك يعرض","https://www.aldiwan.net/poem34418.html","الكامل"],[558,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"],[562,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[564,"لا تبك تُونس يا ياسين أو فدسا","https://www.aldiwan.net/poem857.html",""],[567,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[573,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[573,"أحق ما كان من قلبي تباريح","https://www.aldiwan.net/poem3654.html","البسيط"],[575,"إن من خصه الفؤاد","https://www.aldiwan.net/poem2964.html","مجزوء الخفيف"],[575,"تعودت الهوى والخير عاده","https://www.aldiwan.net/poem2969.html","الوافر"],[575,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[575,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"],[575,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"]],"verses":[["ضَلالاً لِراجي نَشطَةٍ مِن رَبيعِكُم","رَمى الداءَ في أَكلائِكُم فَحَماها",0,"ا",3,0],["ضَلّوا وَراءَكَ حَتّى قالَ قائِلُهُم","ماذا الضَلالُ وَذا يَجري عَلى السَنَنِ",1,"ن",1,0],["ضَلالاً لِسائِلِ هَذي المَغاني","وَغَيّاً لِطالِبِ تِلكَ الغَواني",2,"ي",1,1],["ضِلَّةُ الزائِدِ قَد خا","طَرَ بِالبَكرِ فَنيقَه",3,"ق",2,0],["ضَلالاً لِقَلبي ما يُجَنُّ مِنَ الهَوى","وَمِن عَجَبِ الأَيّامِ كَيفَ يُصابُ",4,"ب",1,0],["ضَلالاً لَكَ مِن غاوٍ","سَليبِ الرَأيِ وَاللُبِّ",5,"ب",1,0],["ضَلَّتْ قُبَيِّلَةٌ رامُوا مُساجَلَتي","وَلَمْ تَطَأْ صَفْحَةَ الغَبْراءِ أَمْثالي",6,"ي",1,1],["ضَلالاً تَمادى الحُبُّ في المَعشَرِ العِدا","وَلَفَّ الهَوى في حَيثُ تُخشى الغَوائِلُ",7,"ل",1,0],["ضَلالاً لِمَفتونٍ سَمَوتَ بِحالِهِ","إِلى أَن بَدَت بَينَ الفَراقِدِ فَرقَدا",8,"د",2,0],["ضل السعادة في الحياة ولم","يبرح على الأيام ينشدها",9,"د",3,0],["ضَلَّ مَنْ يَجْعَلُ الضُّلُولَ إِمَامَا","حَاذِرُوا فِي اخْتِيَارِكُمْ أَنْ تُرَاءُوا",10,"ا",3,0],["ضِلَّةً لِلَّذِينَ يَبْغُونَ مِنْهُمْ","قَبْلَ مِيعَادِهِ كَمَالَ الحُلُومِ",11,"م",1,0],["ضلّة جاهلية أنكرتها","رسل الفنّ في هدى الإسلام",12,"م",1,0],["ضلال على مرّ الجديدين لم تزل","مغاربنا من أمره كالمشارق",13,"ق",1,0],["ضلّ من رام راحةً في حياة","نحن منها في معرك وجلاد",14,"د",1,0],["ضَلَلتَ ضَلالَ السامِرِيِّ وَقَومِهِ","دَعاهُم فَظَلّوا عاكِفينَ عَلى عِجلِ",15,"ل",1,0],["ضَلالٌ مارَأَيتُ مِنَ الضَلالِ","مُعاتَبَةُ الكَريمِ عَلى النَوالِ",16,"ل",1,1],["ضَلةً لامرئٍ يُشمِّرُ في الجم","ع لعيش مُشَمِّرٍ للفناءِ",17,"ا",2,0],["ضَلالاً لمن يسعى إلى غير غايةٍ","ولا يرتجى ناهيهِ عند انتهائِهِ",18,"ا",3,0],["ضلّةً ضلّةً لمن وعَظَتْهُ","غِيَرُ الدهر وهْو غيرُ مُنيبِ",19,"ب",1,0],["ضلَّ باكٍ إن أبيخت جمرةٌ","سوف تُذكيها يَدا مُثْقبِها",20,"ب",3,0],["ضل فما يهتدي لطيِّبَةٍ","كأنما مُجتناه مُحتطبُهْ",21,"ب",2,0],["ضليعاً إذا ما اسْتُحْمِلَ الخطبَ ناهضاً","بأعبائه ليست له عثراتُ",22,"ت",1,0],["ضلَّ إهداؤكَ الخرائطَ يا نُجْ","حُ وألوَتْ به سَوَافي الرياحِ",23,"ح",1,0],["ضلَّةً للفُؤاد يَحْنُو عليها","وهي تَزْهُو حَياتَه وتَكيدُ",24,"د",1,0],["ضلَّ ما أطمعتْكَ نفسك فيه","من أماني شيطانها النكَّاص",25,"ص",1,0],["ضلّ منا الندى فلما نَشَدْنا","هُ وجدناهُ في بني الفيّاض",26,"ض",1,0],["ضلّةٌ للمهنئيك بأن ول","لِيت ما تستحقه إقطاعا",27,"ع",2,0],["ضلَّ يعقوبُ إذ يُعِدُّ التهاوي","لَ لمن لا يُهالُ بالأهوالِ",28,"ل",1,0],["ضلَّ حِلْمٌ لك أضحى","يعبُدُ الأير وعلمُ",29,"م",1,0],["ضلَّ من قد دعوتُ دونَكَ عني","ووجدت الكرامَ غيرَ كرام",30,"م",1,0],["ضَلَّ هَذا وَذا فَما حَفَزَ الإِن","سانَ شَيءٌ لِلشِعرِ كَالإِنسانِ",31,"ن",1,0],["ضَلَّلت أبناء البلاد بأسطر","ملأت قلوب الغافلين ضلالا",32,"ل",2,1],["ضَلَّت كَراها في غَياهِبِ حالِكٍ","ضَلَّ الصَباحَ عَلَيهِ صَوتُ الديكِ",33,"ك",1,0],["ضَلّوا عُقولاً بَعدَ عِرفانِ الهُدى","وَالعَقلُ إِن هُوَ ضَلَّ كانَ عِقالا",34,"ل",2,0],["ضَلَّ الأَميرُ كَما ضَلَّ الوَزيرُ بِهِم","كِلا السَرابَينِ أَظماهُم وَلَم يَصُبِ",35,"ب",1,0],["ضُلُوعٌ ما لها رُوحٌ","ولا يَسْكُنُها القَلْبُ",36,"ب",1,0],["ضَلالاً لِهَذي الريحِ ماذا تُريدُهُ","وَهَدياً لِهَذا السَيلِ ماذا يُؤَمِّمُ",37,"م",1,0],["ضَلَّ اِمرؤٌ يغتالُ ذروةَ عُمْرهِ","بشفائِه حَرَضاً من الأحراضِ",38,"ض",1,0],["ضَلالاً لَها ماذا أَرادَت إِلى الصَدِّ","وَنَحنُ وُقوفٌ مِن فِراقِ عَلى حَدِّ",39,"د",1,1],["ضَلَّ بَدرُ السَماءِ أَو كادَ لَمّا","واجَهَتهُ وُجوهُ تِلكَ البُدورِ",40,"ر",1,0],["ضَلَّ الَّذي أَضحى يُطاوِلُهُ","وَبِإِصرِهِ يَجري القَضا المَقضي",41,"ي",1,0],["ضَلَّيتُ إِن لَم أُصفِهِ مِدَحي","وَإِلَيهِ نِضوُ قَريحَتي أُنضي",41,"ي",1,0],["ضَلَّت فَظَنَّت في مُقارِعَةِ العِدى","أَنَّ الغُمودَ مَعاقِدُ التيجانِ",42,"ن",1,0],["ضل في الأرض الذي ينشد أبناء السماء","أي روحانية تعصر من طين وماء",43,"ا",2,0],["ضَلَّ قَوْمٌ تَوَهَّمُوا الصَّبْرَ حِلْمَاً","وَهْوَ إِلَّا لَدَى الْكَرِيهَةِ ذَامُ",44,"م",1,0],["ضلَّ من يَحسبُ الرجالَ سواءً","أفضلُ الناس من أعدَّ ونظّمْ",45,"م",1,0],["ضلّ الأُلىَ جَحَدوه واتّخذوا له","شُركاءَ من أربابهم وخُصوما",46,"م",2,0],["ضَلَّ المُلوكُ فَجَدَّدوا لِشُعوبِهِم","دينَ العَمى وَعِبادَةَ الأَوثانِ",47,"ن",1,0],["ضَلَّ من يدَّعِي لِمَنْ هُوَ فَردٌ","في عُلاهُ الأبناءَ والأندادا",48,"د",2,0],["ضلّ الألى تركوا دُستورَهُ سفهاً","فلا الدساتيرُ أغنتهم ولا النُّظمُ",49,"م",1,0],["ضَلّوا السَّبيلَ وفي يمينِكَ ساطعٌ","يَهدِي النفوسَ إلى التي هي أوضَحُ",50,"ح",1,0],["ضَلَلتُ بِالبَدرِ عَلى نورِهِ","وَالناسُ يَستَهدونَ بِالبَدرِ",51,"ر",1,1],["ضَلّوا وَقادَهُمُ إِمامُ ضَلالَةٍ","قَد كانَ بَدَّلَ دينَهُم تَبديلا",52,"ل",2,1],["ضَلَّ الَّذينَ تَأَلَّهوا أحبَارهم","ليُحَرِّمُوا وَيُحَلِّلُوا وَيُبِيحُوا",53,"ح",3,0],["ضَلَّ النَّصارَى في المَسِيحِ وَأَقْسَمُوا","لا يَهْتَدُونَ إلَى الرَّشادِ سَبِيلا",54,"ل",2,0],["ضَلَّ النَّصارَى واليَهُودُ فلا تَكُنْ","بِهِم عَلَى سُ