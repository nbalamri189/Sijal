{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[63,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[63,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[73,"كأن عشي القطر في شاطئ النهر","https://www.aldiwan.net/poem11993.html","الطويل"],[56,"على هذه كانت تدور النوائب","https://www.aldiwan.net/poem58651.html","الطويل"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[45,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[61,"على الرغم بدلت من رغم لاحي","https://www.aldiwan.net/poem51742.html","المتقارب"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[75,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[94,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[94,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[133,"حق لهذا الشاي أن يوصفا","https://www.aldiwan.net/poem54800.html","السريع"],[156,"ترشفت من شفتيه العقارا","https://www.aldiwan.net/poem55487.html","المتقارب"],[199,"تأرج مطلول الروابي فزرتها","https://www.aldiwan.net/poem51942.html","الطويل"],[212,"سلام على الشط الذي كنت نوره","https://www.aldiwan.net/poem46252.html","الطويل"],[212,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[230,"بعثت بورد لم يغادر بياضه","https://www.aldiwan.net/poem50933.html","الطويل"],[306,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[404,"بروق بأكناف الحمى تتردد","https://www.aldiwan.net/poem33980.html","الطويل"],[442,"ألا من لصب بالحجاز غريب","https://www.aldiwan.net/poem14297.html","الطويل"],[444,"أما لقربك بعد الهجر ميعاد","https://www.aldiwan.net/poem55954.html","عموديه"],[480,"سيقارة لطيفة","https://www.aldiwan.net/poem36886.html","مجزوء الرجز"]],"verses":[["تُرَشِّفُني مَوارِدُهُ","وَتَلفِظُني مَصادِرُه",0,"ر",2,0],["تُرشّحُ للهَيْجاءِ نَفْساً شَريسةً","متى تُلْقِحِ الحَرْبَ العَقيمَةَ تُنتِجِ",1,"ج",1,0],["تُرشِّحُ أمُّ الخِشْفِ أطْلاءَها بِها","وتُسْحَبُ فيها للرِّياحِ ذُيولُ",2,"ل",1,0],["تُرَشُّ بِماءِ الوَردِ رَشّاً وَتَنثَني","لِتَغليفِ أَفواهٍ بِطَيِّبَةِ الخَمرِ",3,"ر",1,0],["تَرَشّفْتُ أَيّامِيْ وَهُنَّ كَوالِحٌ","عليك وغَالبْتُ الرَّدى وهوَ غالِب",4,"ب",1,0],["تَرَشَّفتُ فاها سُحرَةً فَكَأَنَّني","تَرَشَّفتُ حَرَّ الوَجدِ مِن بارِدِ الظُلمِ",5,"م",1,0],["تُرَشِّحُها نَجرانُ في كُلِّ مَأزِقٍ","كَما رَشَّحَت خَفّانُ آسادَ غابِها",6,"ب",3,0],["تَرُشُّ به السُّمْرُ طَعناً تَرى","مواقفَنا منه حُمرَ النَّواحي",7,"ح",2,0],["تُرَشَّحُ نِعمَةُ الأَيّامِ فيهِ","وَتُقسَمُ فيهِ أَرزاقُ العِبادِ",8,"د",1,0],["ترشف موجه قدر مهول","كأن اليم في فمه لعاب",9,"ب",1,0],["تَرشِفُ ماءَ الأَضاءِ مُترَعَةً","وَلا تَمُصُّ الثِمادَ وَالوَشَلا",10,"ل",2,0],["تُرَشِّفُها في السّلْمِ ماءَ جُفونِها","فتَجزَأُ عن ماء الطُّلى والبآدل",11,"ل",1,0],["ترَشَّفها خمرةً فانتشَى","فألقمها مرّ أثمارِهِ",12,"ه",1,0],["ترشّ النجوم النور فيها ممسّكا","فأترع أحلامي وأهرق كوبي",13,"ب",2,0],["ترشف من نهديك إغفاءتي","كأسين قد أترعتا بنت حان",14,"ن",1,0],["تَرشَافُها شَافٍ لِنَفسِ الفَتَى","إنَّ شِفَاءَ النَّفسِ أن تَرشُفَا",15,"ف",2,0],["تَرَشَّفْتُ مِنْ شَفَتَيْهِ العُقَارَا","وَقَبَّلْتُ مِنْ خَدِّهِ الجُلَّنارَا",16,"ر",2,1],["ترشّفتُ فاهاً إذ ترَشّفتُ كأسَها","فَلا والهوى لم أَدْرِ أيَّهما الخمر",17,"ر",1,0],["ترشفت من خديك كأس مدامة","فصرت أعيش الروح من ذلك السؤر",18,"ر",1,0],["ترشفت خديه بوهمي فصدّني","أفى الوهم إثم ايها المتبتل",19,"ل",1,0],["ترشّفتُها من أحورٍ مخطّفِ الحشا","يلوح لنا بدراً ويرن لنا خِشفا",20,"ف",2,0],["تَرشفُ الأسماعُ منهُ كلّما","كَمَنت فيهِ حياة الأنفسِ",21,"س",1,0],["ترشَّف ذهني من رحيق بديعة","كؤوساً فأضحى وهو منها معربدُ",22,"د",1,0],["ترشفت فاهاً والعيون نواظر","إلي ولم أحذر عيون رقيب",23,"ب",1,0],["ترشحوا للمعالي وهي راغبة","عن مثلهم ولها في الحي آساد",24,"د",1,0],["ترشفها من ريقها","والريق منها يعذب",25,"ب",1,0]]}