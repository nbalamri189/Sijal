{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[65,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[65,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[75,"كأن عشي القطر في شاطئ النهر","https://www.aldiwan.net/poem11993.html","الطويل"],[58,"على هذه كانت تدور النوائب","https://www.aldiwan.net/poem58651.html","الطويل"],[45,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[47,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[63,"على الرغم بدلت من رغم لاحي","https://www.aldiwan.net/poem51742.html","المتقارب"],[46,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[42,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[96,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[136,"حق لهذا الشاي أن يوصفا","https://www.aldiwan.net/poem54800.html","السريع"],[159,"ترشفت من شفتيه العقارا","https://www.aldiwan.net/poem55487.html","المتقارب"],[202,"تأرج مطلول الروابي فزرتها","https://www.aldiwan.net/poem51942.html","الطويل"],[215,"سلام على الشط الذي كنت نوره","https://www.aldiwan.net/poem46252.html","الطويل"],[215,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[234,"بعثت بورد لم يغادر بياضه","https://www.aldiwan.net/poem50933.html","الطويل"],[310,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[409,"بروق بأكناف الحمى تتردد","https://www.aldiwan.net/poem33980.html","الطويل"],[447,"ألا من لصب بالحجاز غريب","https://www.aldiwan.net/poem14297.html","الطويل"],[449,"أما لقربك بعد الهجر ميعاد","https://www.aldiwan.net/poem55954.html","عموديه"],[484,"سيقارة لطيفة","https://www.aldiwan.net/poem36886.html","مجزوء الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53810","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49988","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128698","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53117","الهزج"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93694","الوافر"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115374","المتقارب"],[2497,"","https://poetry.dctabudhabi.ae/diwan/poem/143744","المنسرح"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10427","المتقارب"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105344","السريع"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34721","الطويل"],[3632,"","https://poetry.dctabudhabi.ae/diwan/poem/146005","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35518","المنسرح"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33334","المتقارب"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4968,"لَحْنُ الحَيَاةِ","https://www.poetsgate.com/ViewPoem.aspx?id=206762",""],[5163,"إذا الشمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=33951",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5790,"تثنى كما هز الرديني حامله","https://www.poetsgate.com/ViewPoem.aspx?id=111888",""],[5966,"جريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=158860",""],[6147,"ترشف ..من دموعي..","https://www.poetsgate.com/ViewPoem.aspx?id=151494",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""]],"verses":[["تُرَشِّفُني مَوارِدُهُ","وَتَلفِظُني مَصادِرُه",0,"ر",2,0],["تُرشّحُ للهَيْجاءِ نَفْساً شَريسةً","متى تُلْقِحِ الحَرْبَ العَقيمَةَ تُنتِجِ",1,"ج",1,0],["تُرشِّحُ أمُّ الخِشْفِ أطْلاءَها بِها","وتُسْحَبُ فيها للرِّياحِ ذُيولُ",2,"ل",1,0],["تُرَشُّ بِماءِ الوَردِ رَشّاً وَتَنثَني","لِتَغليفِ أَفواهٍ بِطَيِّبَةِ الخَمرِ",3,"ر",1,0],["تَرَشّفْتُ أَيّامِيْ وَهُنَّ كَوالِحٌ","عليك وغَالبْتُ الرَّدى وهوَ غالِب",4,"ب",1,0],["تَرَشَّفتُ فاها سُحرَةً فَكَأَنَّني","تَرَشَّفتُ حَرَّ الوَجدِ مِن بارِدِ الظُلمِ",5,"م",1,0],["تُرَشِّحُها نَجرانُ في كُلِّ مَأزِقٍ","كَما رَشَّحَت خَفّانُ آسادَ غابِها",6,"ب",3,0],["تَرُشُّ به السُّمْرُ طَعناً تَرى","مواقفَنا منه حُمرَ النَّواحي",7,"ح",2,0],["تُرَشَّحُ نِعمَةُ الأَيّامِ فيهِ","وَتُقسَمُ فيهِ أَرزاقُ العِبادِ",8,"د",1,0],["ترشف موجه قدر مهول","كأن اليم في فمه لعاب",9,"ب",1,0],["تَرشِفُ ماءَ الأَضاءِ مُترَعَةً","وَلا تَمُصُّ الثِمادَ وَالوَشَلا",10,"ل",2,0],["تُرَشِّفُها في السّلْمِ ماءَ جُفونِها","فتَجزَأُ عن ماء الطُّلى والبآدل",11,"ل",1,0],["ترَشَّفها خمرةً فانتشَى","فألقمها مرّ أثمارِهِ",12,"ه",1,0],["ترشّ النجوم النور فيها ممسّكا","فأترع أحلامي وأهرق كوبي",13,"ب",2,0],["ترشف من نهديك إغفاءتي","كأسين قد أترعتا بنت حان",14,"ن",1,0],["تَرشَافُها شَافٍ لِنَفسِ الفَتَى","إنَّ شِفَاءَ النَّفسِ أن تَرشُفَا",15,"ف",2,0],["تَرَشَّفْتُ مِنْ شَفَتَيْهِ العُقَارَا","وَقَبَّلْتُ مِنْ خَدِّهِ الجُلَّنارَا",16,"ر",2,1],["ترشّفتُ فاهاً إذ ترَشّفتُ كأسَها","فَلا والهوى لم أَدْرِ أيَّهما الخمر",17,"ر",1,0],["ترشفت من خديك كأس مدامة","فصرت أعيش الروح من ذلك السؤر",18,"ر",1,0],["ترشفت خديه بوهمي فصدّني","أفى الوهم إثم ايها المتبتل",19,"ل",1,0],["ترشّفتُها من أحورٍ مخطّفِ الحشا","يلوح لنا بدراً ويرن لنا خِشفا",20,"ف",2,0],["تَرشفُ الأسماعُ منهُ كلّما","كَمَنت فيهِ حياة الأنفسِ",21,"س",1,0],["ترشَّف ذهني من رحيق بديعة","كؤوساً فأضحى وهو منها معربدُ",22,"د",1,0],["ترشفت فاهاً والعيون نواظر","إلي ولم أحذر عيون رقيب",23,"ب",1,0],["ترشحوا للمعالي وهي راغبة","عن مثلهم ولها في الحي آساد",24,"د",1,0],["ترشفها من ريقها","والريق منها يعذب",25,"ب",1,0],["ترشح المسك منه سالفة الظبي","وجيد الأدمانة العطبولِ",26,"ل",1,0],["ترشفَ التربُ من طَلَّ النَّدى بللاً","واستنشق الرّوض من ريح الصّبا نَفَسا",27,"س",2,0],["ترشق القلب باللحاظ وتصمي","من يراها بالطعنة النجلاء",28,"ا",2,0],["ترشفت سلاف الراح","في كأس من الدُّر",29,"ر",1,0],["تُرَشِّحُ أَحوى مُزلَغِبّا تَرى لَهُ","أَنابيبَ مِن مُستَعجِلِ الرِّيشِ حَمحَما",30,"م",2,0],["تَرشح لِلكَمال بَني نِزار","كَأَسد الغيل رشحت الشُبولا",31,"ل",2,0],["ترشفت من شفتيها العقارا","وقبلت من خدها جلنارا",32,"ر",2,1],["ترشُفُ أقصى قَعرِ الإناء وما","ردّتْ على الأرض حافراً صَفِنا",33,"ن",2,0],["تُرَشِّحُ طِفلاً وَتَحنو لَهُ","بِحِقفٍ قَدَ أَنبَتَ بَقلاً تُؤاما",34,"م",2,0],["ترشفني من ريقها خمرة","سلسالة يعذب ارشافها",35,"ف",3,0],["تُرَشُّ بِماءِ المِسكِ وَالوَردِ أَرضُها","تَفوحُ بِها مِن بَعدُ ريحُ المَجامِرِ",36,"ر",1,0],["ترشفت فاك العذب بالله خبري","أريقك أم مشمولة الراح أرشف؟",37,"ف",1,0],["تَرشِفُني مِن فُويهها بَرَدا","يَشِبُّ نارَ الهَوى وَيُوقِدُها",38,"د",3,0],["ترشّحها لِلِثامِ الرِجال","إِلى أَن تَصدّى لَها الساقيانِ",39,"ن",1,0],["تَرشُقُها بَأَسهُمِ الأَلحاظِ","وَساقِطِ الأَقوالِ وَالأَلفاظِ",40,"ظ",1,0],["ترشّفتُ من شفتيهِ عقارا","وقَبلتُ من خَدهِ جُلنارا",41,"ر",2,1],["تِرشاف ريجَه صَافيٍ مِنْ رِحيجِ","خَمْرٍ مصَفّى سَلسِبيل التّرايج",42,"ج",1,0],["تَرْشُفُ مِنْ فَيْضِ مَكَارِمِهِمْ","أَغْرَاسٌ يَمْلَؤُهَا وَرَقَا",43,"ق",2,0],["ترشَّحَ مني بعض منها فسلمت","ومنها إليها كل وجدي ترحَّلا",44,"ل",2,0],["(ترشحت للعلم الشريف مفاخراً","ولست بذي علمٍ عليك دلائله)",45,"ل",2,0],["ترشد العين وما أخذل من","يرتجي الرشد بضوء الجذوات",46,"ت",1,0],["ترشفته والليل داج شعره","وقد قلقت مني وغارت مراسله",47,"ل",2,0],["ترشفتُ من حامياتِ اللظى","عذاباً يؤرقُ ومضَ العُمر",48,"ر",1,0],["ترشّف من دموعي ما كفاكا","فكل زوابعي تبغي رضاكا",49,"ك",2,1],["ترشّفْنا المتاعب لم نمانع","فذوقوا من هَوانا ما لقِينا",50,"ن",2,0]]}