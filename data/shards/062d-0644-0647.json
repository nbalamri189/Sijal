{"poems":[[88,"سائلوا الليل عنهم والنهارا","https://www.aldiwan.net/poem10926.html","الخفيف"],[75,"لست بالجاحد آلاء العلل","https://www.aldiwan.net/poem11941.html","الرمل"],[90,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[53,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[53,"أفسدت توبتي علي غلام","https://www.aldiwan.net/poem66362.html","الخفيف"],[46,"قد كسانا من كسوة الصيف خرق","https://www.aldiwan.net/poem30462.html","الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[53,"أفسدتْ توبتي عليَّ غلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30611",""],[88,"سائِلُوا الَّليْلَ عنهمُ والنَّهارَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13084&r=&rc=39",""],[264,"إن سطا الدهر واعتدى","https://www.aldiwan.net/poem35952.html","مجزوء الخفيف"],[266,"أظهر الروض حلاه كنوزا","https://www.aldiwan.net/poem38260.html","الخفيف"],[303,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[398,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[463,"قل لها أيها الخيال الطروق","https://www.aldiwan.net/poem56105.html","الخفيف"],[563,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[563,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39007","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37848","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38241","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69191","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64682","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92034","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205894","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[3891,"","https://poetry.dctabudhabi.ae/diwan/poem/143645","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[3943,"","https://poetry.dctabudhabi.ae/diwan/poem/205127","المديد"],[5111,"تَقَاسِيمُ الصَّمْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=212043",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""]],"verses":[["حُلَّةً لا تَقيهِمُ البَردَ وَالحَر","رَ وَلا عَنهُمُ تَرُدُّ الغُبارا",0,"ر",2,0],["حُلَّةٌ أَلبَسَ عَيني فَخرَها","فَاِغتَدَت تَرفُلُ في أَبهى الحُلَل",1,"ل",1,0],["حلّها جيشكم يريد انتقاماً","وهو مُغرٍ بالساكنين عُلوجه",2,"ج",2,0],["حلَّها بحر وأوفت","فوق بحر ذي غِمار",3,"ر",1,0],["حِلُّه باردٌ فما كان لي مُذْ","كنتُ فيه بما يحل غرام",4,"م",1,0],["حُلَّةً سابِرِيَّةً وَرِداءً","كَسَحا القَيضِ أَو رِداءِ الشُجاعِ",5,"ع",1,0],["حَلّه الوحْيُ رَوضةً شَاعَ فيها","رَونقاً ساطعاً وفاحَ عَبيرا",6,"ر",2,0],["حِلُّه باردٌ فما كان لي مُنْ","ذُ كنتُ فيه بما يحل غرام",7,"م",1,0],["حُلَّة لا تَقيهِمُ البَردَ والحَ","رَّ ولا عنهُمُ ترُدُّ الغُبارا",8,"ر",2,0],["حلّه من غدت له","حضرة القرب مشهدا",9,"د",2,0],["حلها الجور من سواك وفي","ها بيد العدل كم حللت رموزا",10,"ز",2,0],["حلةٌ أَغرتْ بما قد سترتْ","حين زادتْ حسنَ ما أَبدتْ وضوحا",11,"ح",2,0],["حُلَّة لِلفُخارِ في العَترةِ الأَط","هارِ تمَّت مَنسوجةً في طِرازِ",12,"ز",1,0],["حلَّها الغيثُ في عَزاليهِ والشم","سُ ففيها الحيا ومنها الشروقُ",13,"ق",1,0],["حلة قد لبستها منه لما","كنت في الناس للكمال تعاني",14,"ن",2,0],["حلة أهل ديننا لبسوها","ما بهم بدعة ولا طغيان",15,"ن",1,0],["حَلَّ هَذا البرجَ مِن أَوجِ السّهى","بَدرٌ جاهٍ نورهُ حلم وَصفحُ",16,"ح",1,0],["حَلَّه عالِم إِمام جَليل","وَشَهيرٌ وَيا لَهُ مِن شَهيرِ",17,"ر",1,0],["حَلّه السَّعدُ فمِن أَينَ النّحوسْ","وَكَسَاه الحُسنُ أَنواعَ العَجبْ",18,"ب",1,0],["حُلّةُ العَلياءِ زينُ الشرفِ","حليةُ العزِّ وتاجُ الاِفتِخارْ",19,"ر",1,0],["حَلَّها جَوهَرٌ مِنَ المَجدِ فَردٌ","لِلمَعالي كَالشَّمسِ بَينَ النُّجومِ",20,"م",1,0],["حلّه الظبي الذي","بالرضا قد سمحا",21,"ح",2,0],["حُلَّة حبرها ذو مِقة","بِالهَوى يُسدي وَبالو يُنير",22,"ر",1,0],["حَلَّهُ جَمْرُ الغَضا مُذْ","حَلَّ جيرانُ الغَضا بِهْ",23,"ب",2,0],["حلّها وَجهٌ وَحسنٌ ناضرٌ","دونه ترتدُّ أَضواءُ الشموس",24,"س",1,0],["حُلَّة بعد حُلَّة تتراءى","في صداها ومعشر بعد معشرْ",25,"ر",1,0],["حلها العيدروس في سالف العصر","وفي سفحها المبارك خيم",26,"م",1,0],["حَلَّها واستجاب ما كان فيها","إنّ هذا معْ ما مضى لَتَعاطِ",27,"ط",1,0],["حَلَّها ثُمَّ حَلَّ دِرعَ الغَلائِل","وحِزَاماً دُونَ المَقَاتِلِ حائِل",28,"ل",1,0],["حلة خضراء تبصر فيها","جوهراً نظماً ودراً سريا",29,"ي",2,0],["حُلَّةٌ مِنْ سَنَى الْعَبِيرِ تَبَاهَتْ","زَرَعَتْ فِيْ أجْوَائِهَا .. الأحْلامَا",30,"م",2,0],["حلها شر وباء لم يدع","في زوايا كل كوخٍ درهما",31,"م",2,0]]}