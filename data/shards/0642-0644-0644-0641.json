{"poems":[[57,"قل لفوز ردي علي السلاما","https://www.aldiwan.net/poem26109.html","الخفيف"],[53,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[52,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[255,"أيهذا الأمير قد أشكل المعنى","https://www.aldiwan.net/poem15043.html","الخفيف"],[266,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[438,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[556,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80011","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126967","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101362","البسيط"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117208","الخفيف"]],"verses":[["قُل لِفَوزٍ رُدّي عَلَيَّ السَلاما","وَأَجيبي مُتَيَّماً مُستَهاما",0,"م",2,1],["قل لفتىً لم يزل بصورته","دونَ الفَعال الجميل مفتونا",1,"ن",2,1],["قُل لِفَرخِ الزِنجِيِّ لا تَشكُ لَيثاً","وَتَعَوَّذ مِن شَرِّهِ ما اِستَطَعتا",2,"ت",2,1],["قُل لِفهرٍ هاضَ الزَمان قَناةً","قَوَّمَتها العُلا لِطَعنٍ وَرَكزِ",3,"ز",1,0],["قل لفقري إذا تَفَرعَنَ خَف موسى","فكفَّاه بالنَّدا بَحرانِ",4,"ن",1,0],["قل لفظك يعي نطق كل فم","وساعة منك تحصى سالك الحجج",5,"ج",1,0],["قُلْ لفخرِ الأَئمّةِ العَلَمِ العا","لِمِ فَهْوَ المُهَدَّبُ المأْمولُ",6,"ل",1,1],["قلْ لفخر الملوك عَنِّيَ والقو","لُ صحيحٌ بني الورى وسقيمُ",7,"م",1,0],["قلْ لفيحاء بابلٍ كابديها","لوعةً في القلوب تبقى دهورا",8,"ر",2,0],["قل لفهر يا أولى الباس الشديد","مات من فيه الهدى كان مشيد",9,"د",1,1],["قلل فديتك بري السهم تنفذه","للعاشقين فقد اكثرت قتلاكا",10,"ك",2,0],["قُل لفتيانِنا المقيمينَ بالبا","بِ ثقوا بالنجاحِ يا فتيانُ",11,"ن",1,0]]}