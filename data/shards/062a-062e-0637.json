/poem/129352","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66478","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131959","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66566","المتقارب"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86568","الطويل"],[3912,"","https://poetry.dctabudhabi.ae/diwan/poem/131355","الطويل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105575","البسيط"],[4109,"","https://poetry.dctabudhabi.ae/diwan/poem/97542","المجتث"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102745","الطويل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111194","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4519,"","https://poetry.dctabudhabi.ae/diwan/poem/198925","الطويل"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104489","الطويل"],[4734,"فجر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4759,"وكيف إلتفاتي؟","https://www.poetsgate.com/ViewPoem.aspx?id=204067",""],[4778,"بات الهوى في خافقي يكويه","https://www.poetsgate.com/ViewPoem.aspx?id=188134",""],[4830,"نَخلُ العِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207898",""],[4830,"ورديُّ الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=214992",""],[4932,"من يساجلني يساجل ماجداً","https://www.poetsgate.com/ViewPoem.aspx?id=189367",""],[4119,"لعل خيالا ضل حين انتيابها","https://www.poetsgate.com/ViewPoem.aspx?id=16090",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5155,"أغنية عربية الى كردستان","https://www.poetsgate.com/ViewPoem.aspx?id=176153",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5277,"قصارى القول..في رسول الله صلى الله عليه وآلهِ وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=212991",""],[5397,"أترقد عين الصب والنجم يسهر","https://www.poetsgate.com/ViewPoem.aspx?id=157961",""],[5409,"أمحتضن الوادي حضانة مرضعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155273",""],[5425,"شَوْقٌ ، أَمْ حَسَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=198953",""],[5431,"الحرية والعقل ..نفحة!","https://www.poetsgate.com/ViewPoem.aspx?id=203772",""],[5450,"حنظلة","https://www.poetsgate.com/ViewPoem.aspx?id=50282",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[5530,"ترتيلةٌ على حدّ المُحال","https://www.poetsgate.com/ViewPoem.aspx?id=197855",""],[5545,"أغارُ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=184793",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5652,"مكاسر العنبر","https://www.poetsgate.com/ViewPoem.aspx?id=181102",""],[5721,"ينابيع البكاء","https://www.poetsgate.com/ViewPoem.aspx?id=214506",""],[402,"ربة الدولة والجاه المكين","https://www.poetsgate.com/ViewPoem.aspx?id=36472",""],[402,"يا ناعيا فاجأ الربوعا","https://www.poetsgate.com/ViewPoem.aspx?id=36009",""],[5952,"مرّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=213001",""],[5956,"يستشرف ابني بالحِجى المستقبَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193298",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""],[6093,"مَا عَبْدُهُ فِي الشِّعْرِ إلاَّ فتىً","https://www.poetsgate.com/ViewPoem.aspx?id=178842",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""],[199,"لِمَنْ رَسْمُ دَارٍ كالكتابِ المُنَمْنَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=22432",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[6186,"الأساطير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82886&r=&rc=6",""],[6201,"لا منطقيون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87482&r=&rc=6",""],[2696,"أنّى سَرَبْتِ وكنتِ غيرَ سَرُوبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27397&r=&rc=1",""]],"verses":[["تَخَطَّفُ أَبصارَ الأَعادي سُيوفُهُ","وَتَملَأُ أَسماعَ القَبائِلِ لُجمُهُ",0,"م",2,0],["تَخَطّى الرِياحُ الهوجُ أَعناقَ رَملِها","فَتَجبُرُها جَبرَ القَرا وَتَهيلُها",1,"ل",3,0],["تَخَطَّيتُها وَالصُبحُ يَخرُقُ في الدُجى","نَوافِذَ لا يَلقى بِها الجَوَّ راقِعُ",2,"ع",1,0],["تَخَطَّينا الصُفوفَ إِلى رِواقٍ","تَحَجَّبَ بِالصَوارِمِ وَالرِماحِ",3,"ح",1,1],["تَخَطّى بِها أَعناقَ كُلِّ قَبيلَةٍ","صَوارِمُها تَهتَزُّ أَو قَنَواتُها",4,"ت",3,0],["تَخَطّى المَشيبُ إِلى رَأسِهِ","وَقَد كانَ أَعلى قِبابِ الشَبابِ",5,"ب",1,0],["تَخَطَّتْ وَفَوْدُ اللَّيْلِ بَانَ بِهِ الْوَخْطُ","وَعَسْكَرُهُ الزَّنْجِيُّ هَمَّ بِهِ الْقِبْطُ",6,"ط",1,1],["تَخَطَّفُ خَزّانَ الشُرَيَّةِ بِالضُحى","وَقَد حَجَرَت مِنها ثَعالِبُ أَورالِ",7,"ل",1,0],["تُخْطِيءُ الحَصْرَ أَيَادٍ لَمْ تَدَعْ","مَوْضِعاً لِلْحُزْنِ فِي قَلْبٍ حَزِينْ",8,"ن",1,0],["تَخَطَّت بِنا جَوزَ الفَلا شَدَنِيَّةٌ","كَأَنَّ الصَفا أَوراكُها وَمَحالُها",9,"ل",3,0],["تَخَطَّى إِلى الفَقرِ اِمرُؤُ القَيسِ إِنَّهُ","سَوآءٌ عَلى الضَيفِ اِمرُؤُ القَيسِ وَالفَقرُ",10,"ر",1,0],["تَخَطَّيتُ بِاسِمي عِندَهُ وَدَسيعَتي","مَصاريعَ أَبوابٍ غِلاظِ المَناكِبِ",11,"ب",1,0],["تخطّفه في مخلب الجور غيلةً","فزجّ به من مظلم السجن في القمر",12,"ر",1,0],["تَخَطّى إِلَينا مِن بَعيدٍ خَيالُها","يَخوضُ خُدارِيّاً مِنَ اللَيلِ داجِيا",13,"ي",2,0],["تخطت خيرهم حلباً ونَسئا","إلى الوالي المغادر هاربينا",14,"ن",2,0],["تَخَطَّت خَيرَهُم حَلباً وَمَسًّا","إِلى الوالي المُغَادِرَهَا حَضُونَا",15,"ن",2,0],["تخطَّ أحسنَ خطٍّ أنتَ واضعه","في الحربِ والسلمِ بالهنديِّ والعرَب",16,"ب",1,0],["تخطت بنا أرض الشآم إلى حمى","به روضة ريا الجنان ومنبر",17,"ر",1,0],["تخط بالرمحِ في الأجسادِ صائلة","وتطعن العسر بالأقلام إن بذلت",18,"ت",1,0],["تخطى بنُعماه الجسيمة عاتقي","إلى أنْف عمرو تلك آبدةُ العصر",19,"ر",1,0],["تخطَّى اسمَ عَيَّارٍ إلى اسمِ مؤاجَرٍ","مُسمٍّ لها ما شئتَ من مُتفاتِك",20,"ك",1,0],["تَخَطّى إِلَينا رِكنَ هَيفٍ وَحافِراً","طُروقاً وَأَنّى مِنكَ هَيفٌ وَحافِرُ",21,"ر",1,0],["تَخَطَّفَت مُهَجَ الطاغينَ مِن عَرَبٍ","وَطَيَّرَت أَنفُسَ الباغينَ مِن عُجُمِ",22,"م",1,0],["تَخُطُّ وَتَبني صُروحَ العُلومِ","وَتَفتَحُ لِلشَرقِ أَقفالَها",23,"ل",3,0],["تَخطُرُ عَن عادِلٍ","لَم يُرَ إِلّا ظَلَم",24,"م",1,0],["تَخطِرُ مِن جَمعِهِم","بَينَ لُيوثٍ بُهَم",24,"م",1,0],["تُخطِرُ مَن أَمَّها","بَينَ صُنوفِ النِعَم",24,"م",1,0],["تَخُطُّ فيها العَوالي لَيسَ تَنفُذُها","كَأَنَّ كُلَّ سِنانٍ فَوقَها قَلَمُ",25,"م",1,0],["تخطَّى كعوبَ السمهريّ مقوَّماً","وخاضَ صفوفَ الأعوجيّ مسوَّما",26,"م",2,0],["تَخَطّى رِقبَةَ الوَشينَ وَهناً","وَبُعدَ مَسافَةُ الخَرقِ المَجوبِ",27,"ب",1,0],["تَخَطَّأَ عَرضَ الأَرضِ راكِبَ وَجهِهِ","لِيَمنَعَ مِنهُ البُعدُ ما يَبذُلُ القُربُ",28,"ب",1,0],["تَخَطّى اللَيالي مَعشَراً لا تُعِلُّهُم","بِشَكوٍ وَيَعتَلُّ الأَميرُ وَكاتِبُه",29,"ب",2,1],["تَخَطّى إِلى الأَمرِ الَّذي لَيسَ أَهلَهُ","فَطَوراً يُنازيهِ وَطَوراً يُشاغِبُه",30,"ب",2,0],["تُخطِئُ الدُنيا المَقاديرَ فَفي ال","جَوِّ مَن لَم يَكُ في قَعرُ النَفَق",31,"ق",1,0],["تَخَطّى إِلَيهِ الرُزءُ مِن كُلِّ وِجهَةٍ","حَريمَ نَداً لا تَختَطيهِ العَواذِلُ",32,"ل",1,0],["تَخَطّى الحَرَّةَ الرَجلاءَ لَيلاً","وَتَقطَعُ في مَخارِمِها نِعالا",33,"ل",2,0],["تَخَطّى رُؤوسَ الحارِسينَ مُخاطِراً","مَخافَةَ سُلطانٍ شَديدٍ شَكائِمُه",34,"م",2,0],["تَخَطَّت إِلَينا سَيرَ شَهرٍ لِساعَةٍ","مِنَ اللَيلِ خاضَتها إِلَينا الصَحارِيا",35,"ي",2,0],["تَخطُو على قُضُبِ العِقيانِ مُدمَجةً","لم تَدْنَ من قِصَرٍ مُزرٍ ولا طُولِ",36,"ل",1,0],["تَخطو عَلى رَبِذاتٍ غَيرِ فائِرَةٍ","تُحذى وَتُعقَدُ في أَرساغِها الخَدَمُ",37,"م",1,0],["تخطر والأنظار تحدو الركاب","ولفظة الإعجاب في سمعها",38,"ه",2,0],["تخطف القدر الجاري أحاسنهم","بصيرفي المنايا أو بنقاد",39,"د",1,0],["تَخَطَّ معَ المحلِ الجنوبِ بِمَحوِها","سطورَ البلى فيها وتعجبها المِسْعُ",40,"ع",1,0],["تخطّ الحوافرُ من جُرْدِهِمْ","محاريبَ مبثوثَةً في الصَعيدِ",41,"د",1,0],["تَخَطَّت بِيَ الكُثبانَ جَرداءُ شَطبَةٌ","فَلا الرَعيُ د