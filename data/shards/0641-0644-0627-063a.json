s://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[5943,"بإيمانٍ فلاحُ المسلمينا","https://www.poetsgate.com/ViewPoem.aspx?id=37270",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[6142,"يا أقرب الصحب للزهرا مصاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=155744",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَلا غَرِضَت سِنوكَ مِنَ اللَيالي","وَعُمرُ عَدُوِّ مَجدِكَ لا يَدومُ",0,"م",1,0],["فَلا غَرْوَ أَنْ يَسْتَودِعَ المَجْدَ هَمّهُ","أَغَرُّ طُوالُ السّاعِدَينِ نَجيبُ",1,"ب",1,0],["فَلَأُغضِبَنَّ عَواذِلي وَحَواسِدي","وَلِأَصبِرَنَّ عَلى قِلىً وَجَواءِ",2,"ا",2,0],["فلا غروَ أن ينتابه كل خائف","فيأمن من وقع الخطوب الطوارق",3,"ق",1,0],["فلا غَرْوَ أن آتي بهنَّ مضيئة","كأنَّ المعاني في البيوت مصابح",4,"ح",1,0],["فلا غزلٌ إلا لهُ من قصيدةٍ","ولا مدحَ إلا للمليكِ المؤيدِ",5,"د",1,0],["فَلأُغادِر هَذا الوُجودَ وَأَمضي","بِسَلامٍ إِنّي كَرِهتُ البَقاءَ",6,"ا",2,0],["فَلا غَروَ إِلّا قَولُهُنَّ عَشِيَّةً","مَضى أَهلُنا فَاِرفَع فِإِنّا قَواصِرُ",7,"ر",1,0],["فَلا غَفَلَ الدَهرُ عَن أَهلِهِ","فَإِنَّكَ عَينٌ بِها يَنظُرُ",8,"ر",1,0],["فَلا غيضَت بِحارُكَ يا جَموماً","عَلى عَلَلِ الغَرائِبِ وَالدِخالِ",9,"ل",1,0],["فلا غَرو أن أهديتُ من فيضِ بِرِّهِ","إليهِ قليلاً ليس يعتَدُّهُ نَزْرَا",10,"ر",2,0],["فَلا غَرَّني مِن بَعدِكُم عِزُّ كاتِبٍ","إِذا هُوَ لَم يَأخُذ بِحُجزَةِ رامِحِ",11,"ح",1,0],["فَلا غَمامَةَ إِلّا اِنَهَلَّ وابِلُها","وَلا قَرارَةَ إِلّا سالَ واديها",12,"ي",3,0],["فَلا غَروَ إِن لانَت لِظَبيٍ عَريكَتي","أَنا صائِدُ الضرغامِ وَالظبيُ صَائِدي",13,"د",2,0],["فلا غُنمَ إلّا كلّ رأسٍ كأنّهُ","على الرمح من ضَرْبِ المهندِ تاجُ",14,"ج",1,0],["فَلا غَرْوَ أَنْ تَدْمَى الْعُيُونُ أَسَافَةً","عَلَيْكَ وَيَرْعَى الْحُزْنُ كُلَّ جَنَانِ",15,"ن",1,0],["فَلا غَروَ أَنَّ الحُبَّ لِلمَرءِ قاتِلٌ","يُقَلِّبُهُ ما شاءَ جَنباً إِلى جَنبِ",16,"ب",1,0],["فَلأغْسِلَنَّ الأرضَ من أرجاسها","وَلأصْدَعَنَّ ظلامَها المركوما",17,"م",2,0],["فلا غَرْوَ أنْ أعزَزْتَ دينَ محمّدٍ","فأنْتَ لهُ دونَ الأنامِ عقيد",18,"د",1,0],["فَلا غَيمُها يُجلى فَيَيأَسُ طامِعٌ","وَلا غَيثُها يَأتي فَيُروى عِطاشُها",19,"ه",2,0],["فلا غرو إلا حين يضرب موهنا","ليوقط أهل البيت سالفة البكر",20,"ر",1,0],["فلا غرو من أم اليتيم إذا غدت","ضحى العيد يُبْكيها اليتيم المُضيَّع",21,"ع",1,0],["فَلا غَرْوَ أَنْ شَابَتْ مِنَ الْحُزْنِ لِمَّتِي","فَإِنِّيَ فِي دَهْرٍ يَشِيبُ وَلِيدُهُ",22,"د",2,0],["فَلا غَرْوَ أَنْ حُزْتُ الْمَكَارِمَ عَارِياً","فَقَدْ يَشْهَدُ السَّيْفُ الْوَغَى وَهْوَ حَاسِرُ",23,"ر",1,0],["فَلاَ غَرْوَ أَنْ أَلْقَيْتَ مِصْرَ حَفِيَّةً","تُعِيدُ عَلَى بَدْءٍ لِسُدَّتِكَ الوُدَّا",24,"د",2,0],["فَلاَ غَفَلَتْ عُيُونُ الْيُمْنِ عَنْكُمْ","وَلاَ حُرِمَتْ مَآبَكُمْ الْبِلاَدُ",25,"د",1,0],["فَلَا غير أجفان الْمليح سقيمة","وَلَا غير أرداف الْمليح ثقيل",26,"ل",1,0],["فلا غَمَضَتْ عنك عينُ فتَاكِ","ولا ذاقَت النَّوْمَ أجفانُها",27,"ن",3,0],["فلا غرو أن يستنكفوا من ديانة","وقد اسلبت فيها عداها الزرايع",28,"ع",1,0],["فَلاَ غَرّني مِن بَعْدِكمْ عزُّ كاتبٍ،","إذا هُوَ لمْ يأخُذْ بحُجْرَةِ رَامِحِ",29,"ح",1,0],["فلا غرو أن يستنكفوا من ديانة","وقد أسبلت فيما عداها الزرايع",30,"ع",1,0],["فلا غرو أن أصبحت في الحزنِ واجماً","فمن ذا الذي أمسى به غيرَ واجمِ",31,"م",1,0],["فلا غروَ أن أجريتُ مجرى مَدامِعي","نجيعاً وقد أوْدَى الولىُّ المشيّعُ",32,"ع",1,0],["فلا غروَ إنْ أجريتُ من بعد نَأْيِكُمْ","دُموعاً على خَدِّي يضيقُ بها الخد",33,"د",1,0],["فلا غَدراً أَخَافُ ولا أذاة","من الدَّهر الخئون ولا قطوبا",34,"ب",2,0],["فلا غرو أن نادى الزمان مؤرخاً","سعاد بدت في يومِ مولدهِ البشرى",35,"ر",2,0],["فَلا غَدَت نائِباتُ الدَهرِ رائِعَةً","رَعِيَّةً كُشِفَت عَنها بِكَ الكُرَبُ",36,"ب",1,0],["فَلا غَروَ أَن شَدّوا عَلَيكَ أَكُفَّهُم","بِذَلِكَ وَصّى اِبناً أَبٌّ وَأَباً جَدُّ",37,"د",1,0],["فلا غضبٌ حاشا بأن يستفزه","ولا حدّة كلا ولا عنده ضرّ",38,"ر",1,0],["فلا غول فيها لا ولا عنها نزفة","وليس لها برد وليس لها حرّ",38,"ر",1,0],["فلا غيثَ إلا من يمينك هامرٌ","ولا نورَ إلا من جبينك ساطع",39,"ع",1,0],["فَلا غروَ أنّ المُصطفى كانَ عندَما","يَرى شكلَهُ في الشيءِ حوّله غَيرا",40,"ر",2,0],["فلا غيداءُ تخطر في حماه","كرقص البدر من خلف السحاب",41,"ب",1,0],["فَلا غيره في الفضل يَختَرِق العلى","وَلا تحت ساق العرش لِلَّه يسجد",42,"د",1,0],["فَلا غرو فالآمالُ أَنت محطُّها","وَنحوَكَ أَزجت عزمَها وزماعَها",43,"ع",3,0],["فلا غَبَّها غادٍ من المزن رائحٌ","له كلَّ آن في أَجارِعها سَقطُ",44,"ط",1,0],["فَلا غَدا القَطْرُ مَغْناها وَمَنزِلَها","لا بَلْ أَقولُ غَداها وابِلُ المَطَرِ",45,"ر",1,0],["فَلا غروَ أَن تغرى الأَنام عَلى الهَوى","فَبالغرّة الغَرّاء كانَ غُرورها",46,"ر",3,0],["فلا غابِرٌ في الدَّهْرِ يَرجوهُ آملٌ","ولا غُبَّرٌ في الخِلْفِ يَمْريهِ طامع",47,"ع",1,0],["فَلا غَروَ وَالدُرُّ مِن كَفِّهِ اِس","تفيدَ إِلى سَمعِهِ أَن يَعودا",48,"د",2,0],["فَلَأَغرَقَنَّ بِفَيض دَم","عي كُلَّ واش مُرجف",49,"ف",1,0],["فَلاَ غَروَ أَنَّ الخَيلَ تَنحَطُ في القَنَ","تَمَطَّرُ مِن تَحتِ العوالي ذُكُورها",50,"ر",3,0],["فلا غروَ أنْ يعلو وها هو قد علا","ولا بِدْعَ أنْ يسمو وها هو قد سما",51,"م",2,0],["فلا غَرْوَ أن أرتاحَ يوماً بمدحكم","ويسمحَ لي في نظمي الشعر خاطر",52,"ر",1,0],["فلا غابت شموس بني عليٍّ","وقد أَذِنَتْ علينا بالشروق",53,"ق",1,0],["فلا غرْوَ إذ كانتْ أياديكَ لم تزَلْ","تسُحّ النّدى أن لا يكونَ فقيرُ",54,"ر",1,0],["فلا غرو أن أقهرَ الحادثاتِ","ورأيُك لي ولساني معي",55,"ع",2,0],["فلا غدوةٌ اِلا خَبارٌ ووعْتَةٌ","تناهُبها أخْفافُها المناسمُ",56,"م",1,0],["فلا غادة إلاّ من أهوى بخيلة","ولا أحدٌ غير المعزِّ كريم",57,"م",1,0],["فَلا غَروَ أن أضحى لكَ الغَربُ مَدفَناً","فَإنَّ مَغِيبَ الشَّمسِ وَالبَدرِ فِي الغَربِ",58,"ب",1,0],["فلا غرو أن أفضى إليك نعيمها","وأفضى إلى شاني علاك عذابها",59,"ب",3,0],["فَلا غايَة إِلّا وَمرماه فَوقَها","وَلا سَيد إِلّا وَعَن فَيضِهِ وَلي",60,"ل",2,0],["فلأغلبن بديهة ببديهتي","ولأرمين سواده ببياض",61,"ض",1,0],["فلا غَبَت منِّيَ المعارِضُ فالت","تعْريض مثلُ التّصريحِ إنْ فُهِما",62,"م",2,0],["فَلا غَروانَ 