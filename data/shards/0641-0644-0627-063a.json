{"poems":[[53,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[63,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[3,"ما زلت مرتقياَ إلى العلياء","https://www.aldiwan.net/poem122.html",""],[88,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[91,"سمع الليل ذو النجوم أنينا","https://www.aldiwan.net/poem8731.html","عموديه"],[38,"أمن آل وسنى آخر الليل زائر","https://www.aldiwan.net/poem7713.html","الطويل"],[43,"رضاك رضاي الذي أوثر","https://www.aldiwan.net/poem9564.html","المتقارب"],[43,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[62,"أهنئ مولانا بأيمن قادم","https://www.aldiwan.net/poem52431.html","الطويل"],[45,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[45,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[80,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[80,"ومسبلة دمعا يسوغ عذوبة","https://www.aldiwan.net/poem31529.html","الطويل"],[87,"نعاء عليه أيها الثقلان","https://www.aldiwan.net/poem8232.html","الطويل"],[33,"لقد هم قيس أن يزج بنفسه","https://www.aldiwan.net/poem25990.html","الطويل"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[50,"أظلت علينا منك يوما سحابة","https://www.aldiwan.net/poem62356.html","الطويل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42568","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54768","الوافر"],[72,"نثقل إِذْ نبغي بلفظك طبنا","https://www.poetsgate.com/ViewPoem.aspx?id=189421",""],[106,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[45,"نَهَيْتُكُمُ عن صالحٍ، فأبَى بِكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=33039",""],[128,"أيا عين جودى بالدموع السواجم","https://www.aldiwan.net/poem50525.html","الطويل"],[128,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[128,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[132,"آمنت من الخطوب أتيت طوبى","https://www.aldiwan.net/poem54892.html","الطويل"],[135,"تهللت يا شهر الصيام لنا بشرا","https://www.aldiwan.net/poem48896.html","الطويل"],[143,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[143,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[147,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[185,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[271,"هي العيس نوليها الحنين فتسعد","https://www.aldiwan.net/poem52091.html","البسيط"],[297,"سريرة شوق في الهوى من أذاعها","https://www.aldiwan.net/poem33229.html","الطويل"],[297,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[348,"هل تعلم الناس أني في صيامي قد","https://www.aldiwan.net/poem20259.html","البسيط"],[353,"بدا وسقاة الراح تجلى بدورها","https://www.aldiwan.net/poem40342.html","الطويل"],[364,"منحتك فاشكرها مقالة ناصح","https://www.aldiwan.net/poem60846.html","الطويل"],[366,"وخذها عقودا ولا منة","https://www.aldiwan.net/poem17178.html","المتقارب"],[380,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[412,"عاود عيني نصبها وغروره","https://www.aldiwan.net/poem39.html","الطويل"],[416,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[416,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[416,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[432,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[461,"اذا موسم عادت فوائد خيره","https://www.aldiwan.net/poem15408.html","الطويل"],[464,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem3516.html","عموديه"],[506,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[515,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[524,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[527,"يا قاضيا ما مثله من قاض","https://www.aldiwan.net/poem46005.html","الكامل"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"]],"verses":[["فَلا غَرِضَت سِنوكَ مِنَ اللَيالي","وَعُمرُ عَدُوِّ مَجدِكَ لا يَدومُ",0,"م",1,0],["فَلا غَرْوَ أَنْ يَسْتَودِعَ المَجْدَ هَمّهُ","أَغَرُّ طُوالُ السّاعِدَينِ نَجيبُ",1,"ب",1,0],["فَلَأُغضِبَنَّ عَواذِلي وَحَواسِدي","وَلِأَصبِرَنَّ عَلى قِلىً وَجَواءِ",2,"ا",2,0],["فلا غروَ أن ينتابه كل خائف","فيأمن من وقع الخطوب الطوارق",3,"ق",1,0],["فلا غَرْوَ أن آتي بهنَّ مضيئة","كأنَّ المعاني في البيوت مصابح",4,"ح",1,0],["فلا غزلٌ إلا لهُ من قصيدةٍ","ولا مدحَ إلا للمليكِ المؤيدِ",5,"د",1,0],["فَلأُغادِر هَذا الوُجودَ وَأَمضي","بِسَلامٍ إِنّي كَرِهتُ البَقاءَ",6,"ا",2,0],["فَلا غَروَ إِلّا قَولُهُنَّ عَشِيَّةً","مَضى أَهلُنا فَاِرفَع فِإِنّا قَواصِرُ",7,"ر",1,0],["فَلا غَفَلَ الدَهرُ عَن أَهلِهِ","فَإِنَّكَ عَينٌ بِها يَنظُرُ",8,"ر",1,0],["فَلا غيضَت بِحارُكَ يا جَموماً","عَلى عَلَلِ الغَرائِبِ وَالدِخالِ",9,"ل",1,0],["فلا غَرو أن أهديتُ من فيضِ بِرِّهِ","إليهِ قليلاً ليس يعتَدُّهُ نَزْرَا",10,"ر",2,0],["فَلا غَرَّني مِن بَعدِكُم عِزُّ كاتِبٍ","إِذا هُوَ لَم يَأخُذ بِحُجزَةِ رامِحِ",11,"ح",1,0],["فَلا غَمامَةَ إِلّا اِنَهَلَّ وابِلُها","وَلا قَرارَةَ إِلّا سالَ واديها",12,"ي",3,0],["فَلا غَروَ إِن لانَت لِظَبيٍ عَريكَتي","أَنا صائِدُ الضرغامِ وَالظبيُ صَائِدي",13,"د",2,0],["فلا غُنمَ إلّا كلّ رأسٍ كأنّهُ","على الرمح من ضَرْبِ المهندِ تاجُ",14,"ج",1,0],["فَلا غَرْوَ أَنْ تَدْمَى الْعُيُونُ أَسَافَةً","عَلَيْكَ وَيَرْعَى الْحُزْنُ كُلَّ جَنَانِ",15,"ن",1,0],["فَلا غَروَ أَنَّ الحُبَّ لِلمَرءِ قاتِلٌ","يُقَلِّبُهُ ما شاءَ جَنباً إِلى جَنبِ",16,"ب",1,0],["فَلأغْسِلَنَّ الأرضَ من أرجاسها","وَلأصْدَعَنَّ ظلامَها المركوما",17,"م",2,0],["فلا غَرْوَ أنْ أعزَزْتَ دينَ محمّدٍ","فأنْتَ لهُ دونَ الأنامِ عقيد",18,"د",1,0],["فَلا غَيمُها يُجلى فَيَيأَسُ طامِعٌ","وَلا غَيثُها يَأتي فَيُروى عِطاشُها",19,"ه",2,0],["فلا غرو من أم اليتيم إذا غدت","ضحى العيد يُبْكيها اليتيم المُضيَّع",20,"ع",1,0],["فَلا غَرْوَ أَنْ شَابَتْ مِنَ الْحُزْنِ لِمَّتِي","فَإِنِّيَ فِي دَهْرٍ يَشِيبُ وَلِيدُهُ",21,"د",2,0],["فَلا غَرْوَ أَنْ حُزْتُ الْمَكَارِمَ عَارِياً","فَقَدْ يَشْهَدُ السَّيْفُ الْوَغَى وَهْوَ حَاسِرُ",22,"ر",1,0],["فَلاَ غَرْوَ أَنْ أَلْقَيْتَ مِصْرَ حَفِيَّةً","تُعِيدُ عَلَى بَدْءٍ لِسُدَّتِكَ الوُدَّا",23,"د",2,0],["فَلاَ غَفَلَتْ عُيُونُ الْيُمْنِ عَنْكُمْ","وَلاَ حُرِمَتْ مَآبَكُمْ الْبِلاَدُ",24,"د",1,0],["فَلَا غير أجفان الْمليح سقيمة","وَلَا غير أرداف الْمليح ثقيل",25,"ل",1,0],["فلا غَمَضَتْ عنك عينُ فتَاكِ","ولا ذاقَت النَّوْمَ أجفانُها",26,"ن",3,0],["فَلاَ غَرّني مِن بَعْدِكمْ عزُّ كاتبٍ،","إذا هُوَ لمْ يأخُذْ بحُجْرَةِ رَامِحِ",27,"ح",1,0],["فلا غرو أن أصبحت في الحزنِ واجماً","فمن ذا الذي أمسى به غيرَ واجمِ",28,"م",1,0],["فلا غروَ أن أجريتُ مجرى مَدامِعي","نجيعاً وقد أوْدَى الولىُّ المشيّعُ",29,"ع",1,0],["فلا غروَ إنْ أجريتُ من بعد نَأْيِكُمْ","دُموعاً على خَدِّي يضيقُ بها الخد",30,"د",1,0],["فلا غَدراً أَخَافُ ولا أذاة","من الدَّهر الخئون ولا قطوبا",31,"ب",2,0],["فلا غرو أن نادى الزمان مؤرخاً","سعاد بدت في يومِ مولدهِ البشرى",32,"ر",2,0],["فَلا غَدَت نائِباتُ الدَهرِ رائِعَةً","رَعِيَّةً كُشِفَت عَنها بِكَ الكُرَبُ",33,"ب",1,0],["فَلا غَروَ أَن شَدّوا عَلَيكَ أَكُفَّهُم","بِذَلِكَ وَصّى اِبناً أَبٌّ وَأَباً جَدُّ",34,"د",1,0],["فلا غضبٌ حاشا بأن يستفزه","ولا حدّة كلا ولا عنده ضرّ",35,"ر",1,0],["فلا غول فيها لا ولا عنها نزفة","وليس لها برد وليس لها حرّ",35,"ر",1,0],["فلا غيثَ إلا من يمينك هامرٌ","ولا نورَ إلا من جبينك ساطع",36,"ع",1,0],["فَلا غروَ أنّ المُصطفى كانَ عندَما","يَرى شكلَهُ في الشيءِ حوّله غَيرا",37,"ر",2,0],["فلا غيداءُ تخطر في حماه","كرقص البدر من خلف السحاب",38,"ب",1,0],["فَلا غيره في الفضل يَختَرِق العلى","وَلا تحت ساق العرش لِلَّه يسجد",39,"د",1,0],["فَلا غرو فالآمالُ أَنت محطُّها","وَنحوَكَ أَزجت عزمَها وزماعَها",40,"ع",3,0],["فلا غَبَّها غادٍ من المزن رائحٌ","له كلَّ آن في أَجارِعها سَقطُ",41,"ط",1,0],["فَلا غَدا القَطْرُ مَغْناها وَمَنزِلَها","لا بَلْ أَقولُ غَداها وابِلُ المَطَرِ",42,"ر",1,0],["فَلا غروَ أَن تغرى الأَنام عَلى الهَوى","فَبالغرّة الغَرّاء كانَ غُرورها",43,"ر",3,0],["فلا غابِرٌ في الدَّهْرِ يَرجوهُ آملٌ","ولا غُبَّرٌ في الخِلْفِ يَمْريهِ طامع",44,"ع",1,0],["فَلا غَروَ وَالدُرُّ مِن كَفِّهِ اِس","تفيدَ إِلى سَمعِهِ أَن يَعودا",45,"د",2,0],["فَلَأَغرَقَنَّ بِفَيض دَم","عي كُلَّ واش مُرجف",46,"ف",1,0],["فَلاَ غَروَ أَنَّ الخَيلَ تَنحَطُ في القَنَ","تَمَطَّرُ مِن تَحتِ العوالي ذُكُورها",47,"ر",3,0],["فلا غروَ أنْ يعلو وها هو قد علا","ولا بِدْعَ أنْ يسمو وها هو قد سما",48,"م",2,0],["فلا غَرْوَ أن أرتاحَ يوماً بمدحكم","ويسمحَ لي في نظمي الشعر خاطر",49,"ر",1,0],["فلا غابت شموس بني عليٍّ","وقد أَذِنَتْ علينا بالشروق",50,"ق",1,0],["فلا غرْوَ إذ كانتْ أياديكَ لم تزَلْ","تسُحّ النّدى أن لا يكونَ فقيرُ",51,"ر",1,0],["فلا غرو أن أقهرَ الحادثاتِ","ورأيُك لي ولساني معي",52,"ع",2,0],["فلا غدوةٌ اِلا خَبارٌ ووعْتَةٌ","تناهُبها أخْفافُها المناسمُ",53,"م",1,0],["فلا غادة إلاّ من أهوى بخيلة","ولا أحدٌ غير المعزِّ كريم",54,"م",1,0],["فَلا غَروَ أن أضحى لكَ الغَربُ مَدفَناً","فَإنَّ مَغِيبَ الشَّمسِ وَالبَدرِ فِي الغَربِ",55,"ب",1,0],["فلا غرو أن أفضى إليك نعيمها","وأفضى إلى شاني علاك عذابها",56,"ب",3,0],["فَلا غايَة إِلّا وَمرماه فَوقَها","وَلا سَيد إِلّا وَعَن فَيضِهِ وَلي",57,"ي",1,0],["فلأغلبن بديهة ببديهتي","ولأرمين سواده ببياض",58,"ض",1,0],["فلا غَبَت منِّيَ المعارِضُ فالت","تعْريض مثلُ التّصريحِ إنْ فُهِما",59,"م",2,0]]}