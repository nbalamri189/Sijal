{"poems":[[55,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[65,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[3,"ما زلت مرتقياَ إلى العلياء","https://www.aldiwan.net/poem122.html",""],[90,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[74,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[93,"سمع الليل ذو النجوم أنينا","https://www.aldiwan.net/poem8731.html","عموديه"],[40,"أمن آل وسنى آخر الليل زائر","https://www.aldiwan.net/poem7713.html","الطويل"],[45,"رضاك رضاي الذي أوثر","https://www.aldiwan.net/poem9564.html","المتقارب"],[45,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[64,"أهنئ مولانا بأيمن قادم","https://www.aldiwan.net/poem52431.html","الطويل"],[47,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[47,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[82,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[82,"ومسبلة دمعا يسوغ عذوبة","https://www.aldiwan.net/poem31529.html","الطويل"],[89,"نعاء عليه أيها الثقلان","https://www.aldiwan.net/poem8232.html","الطويل"],[35,"لقد هم قيس أن يزج بنفسه","https://www.aldiwan.net/poem25990.html","الطويل"],[107,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[52,"أظلت علينا منك يوما سحابة","https://www.aldiwan.net/poem62356.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29337","الطويل"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42568","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54731","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54768","الوافر"],[74,"نثقل إِذْ نبغي بلفظك طبنا","https://www.poetsgate.com/ViewPoem.aspx?id=189421",""],[108,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[47,"نَهَيْتُكُمُ عن صالحٍ، فأبَى بِكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=33039",""],[131,"أيا عين جودى بالدموع السواجم","https://www.aldiwan.net/poem50525.html","الطويل"],[131,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[131,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[135,"آمنت من الخطوب أتيت طوبى","https://www.aldiwan.net/poem54892.html","الطويل"],[138,"تهللت يا شهر الصيام لنا بشرا","https://www.aldiwan.net/poem48896.html","الطويل"],[146,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[146,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[150,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[188,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[192,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[214,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[274,"هي العيس نوليها الحنين فتسعد","https://www.aldiwan.net/poem52091.html","البسيط"],[300,"سريرة شوق في الهوى من أذاعها","https://www.aldiwan.net/poem33229.html","الطويل"],[300,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[351,"هل تعلم الناس أني في صيامي قد","https://www.aldiwan.net/poem20259.html","البسيط"],[356,"بدا وسقاة الراح تجلى بدورها","https://www.aldiwan.net/poem40342.html","الطويل"],[367,"منحتك فاشكرها مقالة ناصح","https://www.aldiwan.net/poem60846.html","الطويل"],[369,"وخذها عقودا ولا منة","https://www.aldiwan.net/poem17178.html","المتقارب"],[383,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[415,"عاود عيني نصبها وغروره","https://www.aldiwan.net/poem39.html","الطويل"],[419,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[419,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[419,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[435,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[460,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[463,"اذا موسم عادت فوائد خيره","https://www.aldiwan.net/poem15408.html","الطويل"],[466,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem3516.html","عموديه"],[508,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[517,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[526,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[529,"يا قاضيا ما مثله من قاض","https://www.aldiwan.net/poem46005.html","الكامل"],[553,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[819,"","https://poetry.dctabudhabi.ae/diwan/poem/20908","الطويل"],[1153,"","https://poetry.dctabudhabi.ae/diwan/poem/116628","الطويل"]],"verses":[["فَلا غَرِضَت سِنوكَ مِنَ اللَيالي","وَعُمرُ عَدُوِّ مَجدِكَ لا يَدومُ",0,"م",1,0],["فَلا غَرْوَ أَنْ يَسْتَودِعَ المَجْدَ هَمّهُ","أَغَرُّ طُوالُ السّاعِدَينِ نَجيبُ",1,"ب",1,0],["فَلَأُغضِبَنَّ عَواذِلي وَحَواسِدي","وَلِأَصبِرَنَّ عَلى قِلىً وَجَواءِ",2,"ا",2,0],["فلا غروَ أن ينتابه كل خائف","فيأمن من وقع الخطوب الطوارق",3,"ق",1,0],["فلا غَرْوَ أن آتي بهنَّ مضيئة","كأنَّ المعاني في البيوت مصابح",4,"ح",1,0],["فلا غزلٌ إلا لهُ من قصيدةٍ","ولا مدحَ إلا للمليكِ المؤيدِ",5,"د",1,0],["فَلأُغادِر هَذا الوُجودَ وَأَمضي","بِسَلامٍ إِنّي كَرِهتُ البَقاءَ",6,"ا",2,0],["فَلا غَروَ إِلّا قَولُهُنَّ عَشِيَّةً","مَضى أَهلُنا فَاِرفَع فِإِنّا قَواصِرُ",7,"ر",1,0],["فَلا غَفَلَ الدَهرُ عَن أَهلِهِ","فَإِنَّكَ عَينٌ بِها يَنظُرُ",8,"ر",1,0],["فَلا غيضَت بِحارُكَ يا جَموماً","عَلى عَلَلِ الغَرائِبِ وَالدِخالِ",9,"ل",1,0],["فلا غَرو أن أهديتُ من فيضِ بِرِّهِ","إليهِ قليلاً ليس يعتَدُّهُ نَزْرَا",10,"ر",2,0],["فَلا غَرَّني مِن بَعدِكُم عِزُّ كاتِبٍ","إِذا هُوَ لَم يَأخُذ بِحُجزَةِ رامِحِ",11,"ح",1,0],["فَلا غَمامَةَ إِلّا اِنَهَلَّ وابِلُها","وَلا قَرارَةَ إِلّا سالَ واديها",12,"ي",3,0],["فَلا غَروَ إِن لانَت لِظَبيٍ عَريكَتي","أَنا صائِدُ الضرغامِ وَالظبيُ صَائِدي",13,"د",2,0],["فلا غُنمَ إلّا كلّ رأسٍ كأنّهُ","على الرمح من ضَرْبِ المهندِ تاجُ",14,"ج",1,0],["فَلا غَرْوَ أَنْ تَدْمَى الْعُيُونُ أَسَافَةً","عَلَيْكَ وَيَرْعَى الْحُزْنُ كُلَّ جَنَانِ",15,"ن",1,0],["فَلا غَروَ أَنَّ الحُبَّ لِلمَرءِ قاتِلٌ","يُقَلِّبُهُ ما شاءَ جَنباً إِلى جَنبِ",16,"ب",1,0],["فَلأغْسِلَنَّ الأرضَ من أرجاسها","وَلأصْدَعَنَّ ظلامَها المركوما",17,"م",2,0],["فلا غَرْوَ أنْ أعزَزْتَ دينَ محمّدٍ","فأنْتَ لهُ دونَ الأنامِ عقيد",18,"د",1,0],["فَلا غَيمُها يُجلى فَيَيأَسُ طامِعٌ","وَلا غَيثُها يَأتي فَيُروى عِطاشُها",19,"ه",2,0],["فلا غرو إلا حين يضرب موهنا","ليوقط أهل البيت سالفة البكر",20,"ر",1,0],["فلا غرو من أم اليتيم إذا غدت","ضحى العيد يُبْكيها اليتيم المُضيَّع",21,"ع",1,0],["فَلا غَرْوَ أَنْ شَابَتْ مِنَ الْحُزْنِ لِمَّتِي","فَإِنِّيَ فِي دَهْرٍ يَشِيبُ وَلِيدُهُ",22,"د",2,0],["فَلا غَرْوَ أَنْ حُزْتُ الْمَكَارِمَ عَارِياً","فَقَدْ يَشْهَدُ السَّيْفُ الْوَغَى وَهْوَ حَاسِرُ",23,"ر",1,0],["فَلاَ غَرْوَ أَنْ أَلْقَيْتَ مِصْرَ حَفِيَّةً","تُعِيدُ عَلَى بَدْءٍ لِسُدَّتِكَ الوُدَّا",24,"د",2,0],["فَلاَ غَفَلَتْ عُيُونُ الْيُمْنِ عَنْكُمْ","وَلاَ حُرِمَتْ مَآبَكُمْ الْبِلاَدُ",25,"د",1,0],["فَلَا غير أجفان الْمليح سقيمة","وَلَا غير أرداف الْمليح ثقيل",26,"ل",1,0],["فلا غَمَضَتْ عنك عينُ فتَاكِ","ولا ذاقَت النَّوْمَ أجفانُها",27,"ن",3,0],["فَلاَ غَرّني مِن بَعْدِكمْ عزُّ كاتبٍ،","إذا هُوَ لمْ يأخُذْ بحُجْرَةِ رَامِحِ",28,"ح",1,0],["فلا غرو أن أصبحت في الحزنِ واجماً","فمن ذا الذي أمسى به غيرَ واجمِ",29,"م",1,0],["فلا غروَ أن أجريتُ مجرى مَدامِعي","نجيعاً وقد أوْدَى الولىُّ المشيّعُ",30,"ع",1,0],["فلا غروَ إنْ أجريتُ من بعد نَأْيِكُمْ","دُموعاً على خَدِّي يضيقُ بها الخد",31,"د",1,0],["فلا غَدراً أَخَافُ ولا أذاة","من الدَّهر الخئون ولا قطوبا",32,"ب",2,0],["فلا غرو أن نادى الزمان مؤرخاً","سعاد بدت في يومِ مولدهِ البشرى",33,"ر",2,0],["فَلا غَدَت نائِباتُ الدَهرِ رائِعَةً","رَعِيَّةً كُشِفَت عَنها بِكَ الكُرَبُ",34,"ب",1,0],["فَلا غَروَ أَن شَدّوا عَلَيكَ أَكُفَّهُم","بِذَلِكَ وَصّى اِبناً أَبٌّ وَأَباً جَدُّ",35,"د",1,0],["فلا غضبٌ حاشا بأن يستفزه","ولا حدّة كلا ولا عنده ضرّ",36,"ر",1,0],["فلا غول فيها لا ولا عنها نزفة","وليس لها برد وليس لها حرّ",36,"ر",1,0],["فلا غيثَ إلا من يمينك هامرٌ","ولا نورَ إلا من جبينك ساطع",37,"ع",1,0],["فَلا غروَ أنّ المُصطفى كانَ عندَما","يَرى شكلَهُ في الشيءِ حوّله غَيرا",38,"ر",2,0],["فلا غيداءُ تخطر في حماه","كرقص البدر من خلف السحاب",39,"ب",1,0],["فَلا غيره في الفضل يَختَرِق العلى","وَلا تحت ساق العرش لِلَّه يسجد",40,"د",1,0],["فَلا غرو فالآمالُ أَنت محطُّها","وَنحوَكَ أَزجت عزمَها وزماعَها",41,"ع",3,0],["فلا غَبَّها غادٍ من المزن رائحٌ","له كلَّ آن في أَجارِعها سَقطُ",42,"ط",1,0],["فَلا غَدا القَطْرُ مَغْناها وَمَنزِلَها","لا بَلْ أَقولُ غَداها وابِلُ المَطَرِ",43,"ر",1,0],["فَلا غروَ أَن تغرى الأَنام عَلى الهَوى","فَبالغرّة الغَرّاء كانَ غُرورها",44,"ر",3,0],["فلا غابِرٌ في الدَّهْرِ يَرجوهُ آملٌ","ولا غُبَّرٌ في الخِلْفِ يَمْريهِ طامع",45,"ع",1,0],["فَلا غَروَ وَالدُرُّ مِن كَفِّهِ اِس","تفيدَ إِلى سَمعِهِ أَن يَعودا",46,"د",2,0],["فَلَأَغرَقَنَّ بِفَيض دَم","عي كُلَّ واش مُرجف",47,"ف",1,0],["فَلاَ غَروَ أَنَّ الخَيلَ تَنحَطُ في القَنَ","تَمَطَّرُ مِن تَحتِ العوالي ذُكُورها",48,"ر",3,0],["فلا غروَ أنْ يعلو وها هو قد علا","ولا بِدْعَ أنْ يسمو وها هو قد سما",49,"م",2,0],["فلا غَرْوَ أن أرتاحَ يوماً بمدحكم","ويسمحَ لي في نظمي الشعر خاطر",50,"ر",1,0],["فلا غابت شموس بني عليٍّ","وقد أَذِنَتْ علينا بالشروق",51,"ق",1,0],["فلا غرْوَ إذ كانتْ أياديكَ لم تزَلْ","تسُحّ النّدى أن لا يكونَ فقيرُ",52,"ر",1,0],["فلا غرو أن أقهرَ الحادثاتِ","ورأيُك لي ولساني معي",53,"ع",2,0],["فلا غدوةٌ اِلا خَبارٌ ووعْتَةٌ","تناهُبها أخْفافُها المناسمُ",54,"م",1,0],["فلا غادة إلاّ من أهوى بخيلة","ولا أحدٌ غير المعزِّ كريم",55,"م",1,0],["فَلا غَروَ أن أضحى لكَ الغَربُ مَدفَناً","فَإنَّ مَغِيبَ الشَّمسِ وَالبَدرِ فِي الغَربِ",56,"ب",1,0],["فلا غرو أن أفضى إليك نعيمها","وأفضى إلى شاني علاك عذابها",57,"ب",3,0],["فَلا غايَة إِلّا وَمرماه فَوقَها","وَلا سَيد إِلّا وَعَن فَيضِهِ وَلي",58,"ل",2,0],["فلأغلبن بديهة ببديهتي","ولأرمين سواده ببياض",59,"ض",1,0],["فلا غَبَت منِّيَ المعارِضُ فالت","تعْريض مثلُ التّصريحِ إنْ فُهِما",60,"م",2,0],["فَلا غَروَ إِلّا يَومَ جاءَت عَطينَةٌ","لَيَستَلِبوا نَسوانَنا ثُمَّ يَعنِقوا",61,"ق",3,0],["فَلاَ غَروَ أَنَّ الخَيلَ تَنحَطُ في القَنَا","تَمَطَّرُ مِن تَحتِ العوالي ذُكُورها",62,"ر",3,0]]}