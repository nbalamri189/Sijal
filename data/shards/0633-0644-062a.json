{"poems":[[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[74,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[74,"سلت مهجة قد كان صدعها الأسى","https://www.aldiwan.net/poem19218.html","الطويل"],[74,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[53,"وشاعر أجوع من ذيب","https://www.aldiwan.net/poem8519.html","السريع"],[80,"سلت علي يد الخطوب سيوفها","https://www.aldiwan.net/poem14234.html","الكامل"],[87,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[63,"أمعنفي إن زدت في التعنيف","https://www.aldiwan.net/poem51547.html","الكامل"],[63,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[68,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[76,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[54,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16660","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[112,"ذهاب بلا اياب","https://www.poetsgate.com/ViewPoem.aspx?id=35293",""],[80,"سَلَّت عَلَيَّ يَدُ الخُطوب سُيوفَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87625&r=&rc=171",""],[159,"سلت لواحظه سيوفا في الورى","https://www.aldiwan.net/poem55529.html","الكامل"],[193,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[275,"سلت مهندها فخف من حده","https://www.aldiwan.net/poem35414.html","الكامل"],[310,"سلت لواحظه مهند قده","https://www.aldiwan.net/poem56568.html","الكامل"],[364,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[385,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[408,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[435,"سلت أسابرة البزاة مخالبا","https://www.aldiwan.net/poem40749.html","الكامل"],[435,"لله يوم بذي الفوار كم فتكت","https://www.aldiwan.net/poem40761.html","البسيط"],[443,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[463,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[469,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[558,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[591,"وحياتكم في عزكم وهواني","https://www.aldiwan.net/poem17795.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82804","البسيط"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100586","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101528","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64074","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120067","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119898","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61083","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64917","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78046","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78045","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128723","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202171","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109316","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27646","الطويل"],[2321,"","https://poetry.dctabudhabi.ae/diwan/poem/147008","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94019","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65283","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107056","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71376","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45795","الكامل"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124269","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35487","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76494","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97063","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94794","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94786","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73260","الكامل"],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139112","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72432","الكامل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102000","الرمل"],[4830,"ما أصدقَ الصَّب","https://www.poetsgate.com/ViewPoem.aspx?id=204792",""],[4966,"فى تيهِ بُعْدِك..","https://www.poetsgate.com/ViewPoem.aspx?id=196796",""],[5064,"سُحُبُ الإبريز","https://www.poetsgate.com/ViewPoem.aspx?id=199176",""],[5364,"ثامن عشر آذار","https://www.poetsgate.com/ViewPoem.aspx?id=177161",""],[5376,"نورٌ على نورٍ بهاء محمد ِ","https://www.poetsgate.com/ViewPoem.aspx?id=188493",""],[5542,"عندما يعزف الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=10187",""],[5894,"ساقت جيوش التيه نحو أساسي","https://www.poetsgate.com/ViewPoem.aspx?id=131421",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""],[6102,"فارسية","https://www.poetsgate.com/ViewPoem.aspx?id=184546",""],[6238,"فجر الخليل...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86776&r=&rc=5",""],[6334,"في الرمل حمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82250&r=&rc=0",""]],"verses":[["سلَّتْ يمين الملك منك على العدا","عَضْباً مهيب الشفرتين صقيلا",0,"ل",2,0],["سلّت يد السعد على النحس من","أهل الشقا سكّينها فانذبح",1,"ح",1,0],["سلت مهجة قد كان صدعها الأسى","فلا آخذ الله الأسى بصدوعها",2,"ه",2,1],["سلّت صوارِمها من الأجفان","فسطت على الآساد والغزلان",3,"ن",1,1],["سَلَّتُهُ أقفرُ من سبسبٍ","فيها طِرازٌ للعناكيبِ",4,"ب",1,0],["سَلَّت عَلَيَّ يَدُ الخُطوب سُيوفَها","فَجذَذنَ مِن جِلَدي الخَطيفَ الأمتَنا",5,"ن",2,1],["سُلَّت سُيوفُ الحَيِّ إِلّا واحِداً","إِفرِندُهُ في جَفنِهِ يَحميكِ",6,"ك",1,0],["سلَّتْ على قَلبي ظُبا أسيافِها","يَومَ النَّوى مُقَلُ الظِّباءِ الهيفِ",7,"ف",1,0],["سُلَّتْ سيوفُهُمُ بغَيرِ بوارقٍ","وجَرَتْ جيادُهُمُ بغيرِ غُبارِ",8,"ر",1,0],["سُلَّت عَليها لِلمِزاجِ صَوارِمٌ","لِتَروضَ مِنها الخُلقَ بَعدَ شَماسِ",9,"س",1,0],["سُلَّتْ صوَارِمُهُ الحِداد ففَلَّقَتْ","هاماً عليها للجيادِ عِثارُ",10,"ر",1,0],["سلْ تُعْطَ واشفعْ تشفعْ ما تُرِدْهُ يكنْ","لوْ شئتَ لانتقلَ الأضحى إلى صفرِ",11,"ر",1,0],["سَلَّت عَتادَ الصَبرِ فيهِ صَبابَةً","ما لي بِها غَيرَ الدُموعِ عَتادُ",12,"د",1,0],["سَلَّت عَلَيَّ سُيوفَها أَجفانُهُ","فَلَقَيتُهُنَّ مِنَ المَشيبِ بِمَغفَرِ",13,"ر",1,0],["سَلَت نافِلاتِ الحُبِّ مِمَّن عَلِمتُهُ","فَكَيفَ بِمَشغوفٍ يَرى حُبَّها فَرضا",14,"ض",2,0],["سَلَّتهُ سيفاً كي يحرِّرَ قوْمَهُ","ويُزِيلَ عن أوطانِهِ استعبادَا",15,"د",2,0],["سَلَّتْ حرابَ البرق فوق سمائه","هوجاءُ تُنذر بالقضاءِ الجائحِ",16,"ح",1,0],["سَلّتْ سُيوفَ سَرابِها لتَرُوعَني","وسِوايَ عاذِلَ مَنْ يُراعُ ويُذْعَر",17,"ر",1,0],["سل تدمراً والقريتين وأركْ","هل ثبتوا لخالد في معترك",18,"ك",1,0],["سَلَتْ قُلُوبٌ فَقَرَّتْ في مَضَاجِعِهَا","بَعْدَ الْحَنِينِ وَقَلْبِي لَيْسَ بِالسَّالِي",19,"ل",2,0],["سلت ف ارضك وارتوت بي...وفاضتني عذاب","لين حبتني قلوب وتعاودت لي قلوب",20,"ب",1,0],["سَلَّت عَلَيَّ يَدُ الخُطوب سُيوفَها","فَجذَذنَ مِن جِلدي الحَصيفَ الأمتَنا",21,"ن",2,1],["سَلَّتْ لَوَاحِظُهُ سُيُوفاً في الوَرى","جَعَلَتْ لَهُنَّ قُلُوبَنا أَجْفانا",22,"ن",2,1],["سَل تُعط واِشفع في الجميع تشفّعِ","اللَّه ميّزهُ بذاك المجمعِ",23,"ع",1,0],["سلَّت مُهنَّدَها فخَف من حدّهِ","فصريمةُ ابنِ رواحةٍ في فردِهِ",24,"د",2,1],["سَلّت لَواحظهُ مهنّدَ قدّهِ","هاكَ الفؤادَ إذا رَضيت بِغمدهِ",25,"د",2,1],["سَلَّت سيوفاً من الأجفان نَحوهُمُو","وقد أبادتهُمُو تحت الثرى رِمَمَا",26,"م",2,0],["سَلَت الأكارعُ صِبْغَها كمُظاهرٍ","بُردَيْنِ شَمَّر ذا وهذا ذَيَّلا",27,"ل",2,0],["سَلتَ عَليَّ صَوارِماً مِن وَمضها","حَتّى اِشتَفى مِن قَلبيَ التَمزيق",28,"ق",1,0],["سُلَّتْ به مثل النجومِ صوارمٌ","تَرَكَتْ رداءَ النّقعِ وهو مُشَهَّرُ",29,"ر",1,0],["سلت أسابرة البزاة مخالباً","في يوم فاقعةٍ كحد المنصلِ",30,"ل",1,1],["سلت صوارم أظفارٍ مخضبةٍ","تسقي الحجال على تعدادهم لهفا",31,"ف",2,0],["سل تخبّر عن تجافيه وكم","مرهف للفتك من جفنيه سلا",32,"ل",2,0],["سَلَّتْ يداه وعينُ الحرب راقدةٌ","لهم أساودَ يقسمن الردى رُقُطا",33,"ط",2,0],["سلَّتِ الدولةُ منه صارماً","شِرقَ الصفحةِ ظمآنَ الغُروبِ",34,"ب",1,0],["سلت بفضها سيفاً صقيلاً","وحزت بنظمها عقداً ثمينا",35,"ن",2,0],["سُلَّت فَسُلَّت ثُمَّ سُلَّ سَليلُها","فَأَتى سَليلُ سَليلِها مَسلولا",36,"ل",2,0],["سَلَّتْ ظِباؤُكُمُ الظُّبَى مِنْ أَعْيُنٍ","إِنْسَانُهَا طِيبَ الكَرى أَنْسَانِي",37,"ن",2,0],["سَلت شُئون الوَرى في الرَمس جمجمة","قَد باتَ يُسعفها وَبل وَأَنداء",38,"ا",2,0],["سلت صفيحة مقلة وسنانة","حتى رأنيا الحتف في صفحاتها",39,"ت",3,0],["سلَّتهما من ناظرَين تحالفا","للفتكِ بي مع حاجبين منكَّبَين",40,"ن",1,0],["سُلَّت رؤوسهم بالرعب مِن أَمَدٍ","وَطرفُ مُرهَفِهِ في الجفن مَغمودُ",41,"د",1,0],["سلْ تجنِ عن عَوْدِ السؤالِ وبدئه","أذكى من المسكِ الذكيِّ وأعبقا",42,"ق",2,0],["سلت على الفضة من مائها","أنامل البرق ظبي من ذهب",43,"ب",1,0],["سلت عليه البارقات ظبي","لبس االغدير لحوفها دوعا",44,"ع",2,0],["سلت لَواحظها عَلي سيوفَها","فحذار ثُم حذار مِن فتكاتها",45,"ت",3,0],["سَلَّتْ حُقودَ الأَعادي إِذْ تَخَرَّمَها","مُهَنَّدٌ مِنْ سيوفِ اللهِ مسلولُ",46,"ل",1,0],["سَلّت مِن الطَرف الأَحور","سَيفاً مِن لَحظَيها مَشهر",47,"ر",1,0],["سَلَّت عَلى العُشاقِ","سَيفاً مِن الأَحداقِ",48,"ق",1,0],["سلّت فؤادي بنار فوق وجنتها","وغالطتني وقالت إنني سال",49,"ل",1,0],["سَلَّت صَوارِمَ لحظِها من غِمدِها","فسَطَت على الآسادِ والغُزلانِ",50,"ن",1,0],["سَلَّتْ يدُ الإِسلام منه مُهَنَّداً","مُتَحَكِّماً في هامةِ الإِشراك",51,"ك",1,0],["سلت على الأقداح من أنوارها","سيفاً يسمى هازم الأتراح",52,"ح",1,0],["سلت بوجودِ القيد عن نيل مُطلقٍ","عن الحبسِ بالتقييد باليومِ والأمس",53,"س",1,0],["سلت لواحظه سيفاً لعاشقه","ما كان أمضاه سيفاً جاء مكتحلا",54,"ل",2,0],["سلتني ولم أخطر ببالي سلوة","عروس كنوز تدهش اللب جلوة",55,"ه",1,1],["سلت عزمة السّلوان منهُ زواجرُ","من اللّحظ فانكفّ السّلوّ بطرفه",56,"ف",2,0],["سلت صوارم صرفه","وسطت وخطب الدهر يهدف",57,"ف",1,0],["سَلَّتْ جُفُونُكَ لي سُيوفَ حِدَادِ","فَقَتَلْنَنِي وَلَبَسْنَ ثَوْبَ حِدَادِ",58,"د",1,1],["سَلت صَوارِمها العَزائم فَاِرتَوَت","وَدَم العِدا مُتلهب بِنِصالها",59,"ا",1,0],["سلّت نعيماءُ بنت اما عليه ظُبى","أحداقها وظُبى الأحداقِ لم تُطَق",60,"ق",1,0],["سَلت سَواقيهِ مِنهُ صارِماً عَجَبا","لا يأتَلي الجَدب مِنهُ مُمعِنا هَرَبا",61,"ب",2,0],["سلت عَلى هامات سوء سيفها","وَالسوء عمت بيننا عاداته",62,"ت",2,0],["سل تعط واشفع تشفع يا له شرف","له وفخر وتعظيم وتبجيل",63,"ل",1,0],["سلت أمي حداداً من مغامدها","قادت بها الصعب مكم بل وكل أبي",64,"ب",2,0],["سلَّت حسام القضا عمداً وما فتئت","تغزو بصمصامها شيباً وشُبّانا",65,"ن",2,0],["سلتَ حُسام الغدر يا شر ظالمٍ","أليس لهذا السيف بالدهر من غمدِ",66,"د",1,0],["سَلَّت بهِ الظَّلماءُ منهُ عل الحمَى","سيفاً لهطَّالِ المدامعش يُنتضى",67,"ض",2,0],["سلَّت محاسنُه لقتلِ محبهِ","من سحرِ عينه حسامَ سميهِ",68,"ي",2,0],["سَلْ تُخبَّرْ عَنْ نَسِيم النَّفَحاتْ","ما رَوَى عنهُ رُواةُ الامَمْ",69,"م",1,0],["سَلْ تُنَبَّأْ عَنْ حَدِيثِ الأَدْمُعِ","خَبَراً يَرْوِيهِ شَوْقِي والسُّهادْ",69,"د",1,0],["سلت لحاظك مرهفا","بالجفن كان مغلفا",70,"ف",2,1],["سلت الأسياف من أجفانها","فغدت بالرغم أحشاي الغمودا",71,"د"