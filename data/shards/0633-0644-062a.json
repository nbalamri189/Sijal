{"poems":[[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[72,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[72,"سلت مهجة قد كان صدعها الأسى","https://www.aldiwan.net/poem19218.html","الطويل"],[72,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[51,"وشاعر أجوع من ذيب","https://www.aldiwan.net/poem8519.html","السريع"],[78,"سلت علي يد الخطوب سيوفها","https://www.aldiwan.net/poem14234.html","الكامل"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[61,"أمعنفي إن زدت في التعنيف","https://www.aldiwan.net/poem51547.html","الكامل"],[61,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[66,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16660","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[78,"سَلَّت عَلَيَّ يَدُ الخُطوب سُيوفَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87625&r=&rc=171",""],[153,"سلت لواحظه سيوفا في الورى","https://www.aldiwan.net/poem55529.html","الكامل"],[187,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[268,"سلت مهندها فخف من حده","https://www.aldiwan.net/poem35414.html","الكامل"],[303,"سلت لواحظه مهند قده","https://www.aldiwan.net/poem56568.html","الكامل"],[357,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[362,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[377,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[399,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[426,"سلت أسابرة البزاة مخالبا","https://www.aldiwan.net/poem40749.html","الكامل"],[426,"لله يوم بذي الفوار كم فتكت","https://www.aldiwan.net/poem40761.html","البسيط"],[434,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[456,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[462,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[551,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[584,"وحياتكم في عزكم وهواني","https://www.aldiwan.net/poem17795.html","الكامل"]],"verses":[["سلَّتْ يمين الملك منك على العدا","عَضْباً مهيب الشفرتين صقيلا",0,"ل",2,0],["سلّت يد السعد على النحس من","أهل الشقا سكّينها فانذبح",1,"ح",1,0],["سلت مهجة قد كان صدعها الأسى","فلا آخذ الله الأسى بصدوعها",2,"ه",2,1],["سلّت صوارِمها من الأجفان","فسطت على الآساد والغزلان",3,"ن",1,1],["سَلَّتُهُ أقفرُ من سبسبٍ","فيها طِرازٌ للعناكيبِ",4,"ب",1,0],["سَلَّت عَلَيَّ يَدُ الخُطوب سُيوفَها","فَجذَذنَ مِن جِلَدي الخَطيفَ الأمتَنا",5,"ن",2,1],["سُلَّت سُيوفُ الحَيِّ إِلّا واحِداً","إِفرِندُهُ في جَفنِهِ يَحميكِ",6,"ك",1,0],["سلَّتْ على قَلبي ظُبا أسيافِها","يَومَ النَّوى مُقَلُ الظِّباءِ الهيفِ",7,"ف",1,0],["سُلَّتْ سيوفُهُمُ بغَيرِ بوارقٍ","وجَرَتْ جيادُهُمُ بغيرِ غُبارِ",8,"ر",1,0],["سُلَّت عَليها لِلمِزاجِ صَوارِمٌ","لِتَروضَ مِنها الخُلقَ بَعدَ شَماسِ",9,"س",1,0],["سُلَّتْ صوَارِمُهُ الحِداد ففَلَّقَتْ","هاماً عليها للجيادِ عِثارُ",10,"ر",1,0],["سلْ تُعْطَ واشفعْ تشفعْ ما تُرِدْهُ يكنْ","لوْ شئتَ لانتقلَ الأضحى إلى صفرِ",11,"ر",1,0],["سَلَّت عَتادَ الصَبرِ فيهِ صَبابَةً","ما لي بِها غَيرَ الدُموعِ عَتادُ",12,"د",1,0],["سَلَّت عَلَيَّ سُيوفَها أَجفانُهُ","فَلَقَيتُهُنَّ مِنَ المَشيبِ بِمَغفَرِ",13,"ر",1,0],["سَلَت نافِلاتِ الحُبِّ مِمَّن عَلِمتُهُ","فَكَيفَ بِمَشغوفٍ يَرى حُبَّها فَرضا",14,"ض",2,0],["سَلَّتهُ سيفاً كي يحرِّرَ قوْمَهُ","ويُزِيلَ عن أوطانِهِ استعبادَا",15,"د",2,0],["سَلَّتْ حرابَ البرق فوق سمائه","هوجاءُ تُنذر بالقضاءِ الجائحِ",16,"ح",1,0],["سَلّتْ سُيوفَ سَرابِها لتَرُوعَني","وسِوايَ عاذِلَ مَنْ يُراعُ ويُذْعَر",17,"ر",1,0],["سل تدمراً والقريتين وأركْ","هل ثبتوا لخالد في معترك",18,"ك",1,0],["سَلَتْ قُلُوبٌ فَقَرَّتْ في مَضَاجِعِهَا","بَعْدَ الْحَنِينِ وَقَلْبِي لَيْسَ بِالسَّالِي",19,"ي",1,0],["سَلَّت عَلَيَّ يَدُ الخُطوب سُيوفَها","فَجذَذنَ مِن جِلدي الحَصيفَ الأمتَنا",20,"ن",2,1],["سَلَّتْ لَوَاحِظُهُ سُيُوفاً في الوَرى","جَعَلَتْ لَهُنَّ قُلُوبَنا أَجْفانا",21,"ن",2,1],["سَل تُعط واِشفع في الجميع تشفّعِ","اللَّه ميّزهُ بذاك المجمعِ",22,"ع",1,0],["سلَّت مُهنَّدَها فخَف من حدّهِ","فصريمةُ ابنِ رواحةٍ في فردِهِ",23,"د",2,1],["سَلّت لَواحظهُ مهنّدَ قدّهِ","هاكَ الفؤادَ إذا رَضيت بِغمدهِ",24,"د",2,1],["سَلَّت سيوفاً من الأجفان نَحوهُمُو","وقد أبادتهُمُو تحت الثرى رِمَمَا",25,"م",2,0],["سَلَت الأكارعُ صِبْغَها كمُظاهرٍ","بُردَيْنِ شَمَّر ذا وهذا ذَيَّلا",26,"ل",2,0],["سَلتَ عَليَّ صَوارِماً مِن وَمضها","حَتّى اِشتَفى مِن قَلبيَ التَمزيق",27,"ق",1,0],["سُلَّتْ به مثل النجومِ صوارمٌ","تَرَكَتْ رداءَ النّقعِ وهو مُشَهَّرُ",28,"ر",1,0],["سلت أسابرة البزاة مخالباً","في يوم فاقعةٍ كحد المنصلِ",29,"ل",1,1],["سلت صوارم أظفارٍ مخضبةٍ","تسقي الحجال على تعدادهم لهفا",30,"ف",2,0],["سل تخبّر عن تجافيه وكم","مرهف للفتك من جفنيه سلا",31,"ل",2,0],["سَلَّتْ يداه وعينُ الحرب راقدةٌ","لهم أساودَ يقسمن الردى رُقُطا",32,"ط",2,0],["سلَّتِ الدولةُ منه صارماً","شِرقَ الصفحةِ ظمآنَ الغُروبِ",33,"ب",1,0],["سلت بفضها سيفاً صقيلاً","وحزت بنظمها عقداً ثمينا",34,"ن",2,0],["سُلَّت فَسُلَّت ثُمَّ سُلَّ سَليلُها","فَأَتى سَليلُ سَليلِها مَسلولا",35,"ل",2,0],["سَلَّتْ ظِباؤُكُمُ الظُّبَى مِنْ أَعْيُنٍ","إِنْسَانُهَا طِيبَ الكَرى أَنْسَانِي",36,"ي",1,0]]}