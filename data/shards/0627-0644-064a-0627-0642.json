{"poems":[[40,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[275,"يحملنا العدى ما لا نطيق","https://www.aldiwan.net/poem35012.html","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140047",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91000","الوافر"],[4718,"فكرت بالدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=137302",""],[4988,"للخالدية جابني الشوق من غاد","https://www.poetsgate.com/ViewPoem.aspx?id=214086",""],[5274,"حكمةُ الأجداد","https://www.poetsgate.com/ViewPoem.aspx?id=203266",""],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5732,"الله من قلب","https://www.poetsgate.com/ViewPoem.aspx?id=177901",""],[5736,"خلوة","https://www.poetsgate.com/ViewPoem.aspx?id=210615",""],[5848,"الفيصليه والمملكه والوليد بن طلال","https://www.poetsgate.com/ViewPoem.aspx?id=53171",""],[6056,"القلب والنفس خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=130182",""]],"verses":[["إِلى أَقتادِ راحِلَتي فَظَلَّت","تُنازِعُهُ الأَعاصيرُ الوَضينا",0,"ن",2,0],["إلى أقصَى الفرنجةِ أرجِعوهم","فقَد شَهِدت جحافِلكم فروق",1,"ق",1,0],["آل ياقين في مقابل لوط","حوله زمرة من الأصحاب",2,"ب",1,0],["إلى اقتسام الزاد في ذا المشهد","لكن إذا طر الصباح من غد",3,"د",1,0],["إلى أقمار سعد خلفوني","هلال الشك احسب في الشام",4,"م",1,0],["اليا قبلت تعطيك زين التباشير","يضحك حجاجك من جزيل الهديه",5,"ي",2,0],["اليا قراهن غيري وما به احقاد","في كل بيتٍ لا نطق به قراني",6,"ن",2,0],["إلى أقاصي الدنا للحَقِ ألويةٌ","صانوا المواثيقَ لا خانوا ولا خرقوا",7,"ق",3,0],["إلى أقصى انفجاراتي احتراقا","إلى حيث استحال العشق خلقا",8,"ق",2,0],["اليا قلب الهيل يالقرم كفه","وليا ركد خله على الصين يذرف",9,"ف",1,0],["إليّ أقربُ من صحوي ومن قلقي","ومن وريدٍ به تسري فيستعرُ",10,"ر",1,0],["إليا قفل جواله اظلم كل ما حولي ومال","فكري لتيار العذاب وكل طاروق مسكه",11,"ك",2,0],["إلى أقبلت مثل الوضيحي تمدرا","بشعل العيون ، اللي بها الموت مدفون",12,"ن",1,0]]}