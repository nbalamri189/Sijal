{"poems":[[55,"صاحت بذودي بغداد فآنسني","https://www.aldiwan.net/poem30446.html","البسيط"],[55,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[3,"لا يحمل الحقد من تعلو به الرتب","https://www.aldiwan.net/poem126.html",""],[88,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[91,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[63,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[82,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[76,"والشمس شاحبة الجبين مريضة","https://www.aldiwan.net/poem13218.html","الكامل"],[50,"يختال في مشيته","https://www.aldiwan.net/poem66252.html","مجزوء الرجز"],[48,"الصبر يوجد إن باء له كسرت","https://www.aldiwan.net/poem22394.html","البسيط"],[48,"الصمت أولى وما رجل ممنعة","https://www.aldiwan.net/poem22550.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85481","الكامل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[108,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[53,"نجَّاكَ يا ابن الحاجِبِ الحاجبُ","https://www.poetsgate.com/ViewPoem.aspx?id=27045",""],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[164,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[164,"غدرت فيا باني الغزال الغادر","https://www.aldiwan.net/poem58938.html","الكامل"],[287,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[287,"من مبلغ نجدا ومن بنجد","https://www.aldiwan.net/poem32810.html","الرجز"],[325,"جاز التماس إعادة الأنظار في","https://www.aldiwan.net/poem61665.html","الكامل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[438,"أظنه حاذر سلوانا","https://www.aldiwan.net/poem12739.html","السريع"],[469,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[563,"لا خلق أعظم مثل خلق الآخره","https://www.aldiwan.net/poem34472.html","الكامل"],[568,"فالأولياء رحمة للخلق","https://www.aldiwan.net/poem13620.html","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64034","السريع"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90562","الكامل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44925","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79383","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64590","الكامل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45384","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141332","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121883","البسيط"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100467","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69408","المتدارك"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53045","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53212","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53132","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27949","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27462","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28542","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140091",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87571","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99386","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199021","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117996","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94773","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58146","الكامل"],[4491,"","https://poetry.dctabudhabi.ae/diwan/poem/95745","المنسرح"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204185",""],[4690,"المليكة","https://www.poetsgate.com/ViewPoem.aspx?id=175514",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""],[5150,"الرسام ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202939",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5397,"عز الحمى فثوى بالأمن خائفه","https://www.poetsgate.com/ViewPoem.aspx?id=157940",""],[5837,"ياناقد الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=181442",""],[6093,"اللقْطَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205374",""],[469,"والنقع ليل والأسنة انجم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574829",""],[2220,"الحمدُ للأولِ والآخرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11460&r=&rc=334",""]],"verses":[["وَالنَقعُ يَسحَبُ مِن أَذيالِهِ وَلَهُ","عَلى الغَزالَةِ جَيبٌ غَيرُ مَزرورِ",0,"ر",1,0],["وَالنَقعُ قَد كَتَمَ الرُبى فَكَأَنَّهُ","سَيلٌ تَحَدَّرَ وَالجِيادُ قَوارِبُ",1,"ب",1,0],["وَالنَقعُ يَومَ طِرادَ الخَيلِ يَشهَدُ لي","وَالضَربُ وَالطَعنُ وَالأَقلامُ وَالكُتُبُ",2,"ب",1,0],["وَالنَقلُ إِن عَدِمَ الأَما","نَةَ كانَ عُنوانَ الخَسارِ",3,"ر",1,0],["والنُّقْلُ والريحانُ من شأنهم","فلا يَعِبْ فقدَهما عائبُ",4,"ب",1,0],["والنقد بالاغراض في","اكثره متهم",5,"م",1,0],["وَالنَقعُ يَأخُذُ حَرّاناً وَبَقعَتَها","وَالشَمسُ تَسفِرُ أَحياناً وَتَلتَثِمُ",6,"م",1,0],["والنَّقْعُ لَيْلٌ يَكُفُّ الطَّرْفَ غَيهَبُه","والُمرهَفاتُ كقَرْنِ الشَّمْسِ تَزْدَحِمُ",7,"م",1,0],["والنّقْعُ فيه دُجُنّةٌ لا تَنجلي","والصُّبحُ مِنهُ مَلاءةٌ لا تُنشَرُ",8,"ر",1,0],["وَالنَقعُ يَكسُرُ مِن سَنا شَمسِ الضُحى","فَكَأَنَّهُ صَدَأٌ عَلى دينارِ",9,"ر",1,0],["وَالنَقعُ أَدهَمُ لِلرِماحِ بِوَجهِهِ","غُرَرٌ تَلوحُ وَلِلسُيوفِ حُجولُ",10,"ل",1,0],["والنقل من تقبيل ما","يقطفُ من وجنتهِ",11,"ت",2,0],["وَالنَقدُ يُهدى إِلى الدينارِ مَكرُمَةً","فَلَيتَهُ بَعدَ حُسنِ الضَربِ مَنقودُ",12,"د",1,0],["وَالنَقلُ غَيَّرَ أَنباءً سَمِعتَ بِها","وَآفَةُ القَولِ تَقليلٌ وَتَكثيرُ",13,"ر",1,0],["وَالنقد يهدي نوره","من سار في اللَيل البَهيم",14,"م",1,0],["وَالنقد يَضعف إِن بَنو","ه عَلى المظنة وَالرجوم",14,"م",1,0],["والنُّقطُ التي على الخُطوطِ","علامةٌ تُعدُّ للسُّقوطِ",15,"ط",1,0],["والنُّقطُ التي بأجوافِ الحَلقْ","لمبتدا الشُّطورِ منها يُخترقْ",15,"ق",1,0],["والنُّقطتانِ موضعَ التعاقُبِ","ومثلَ ذاكَ موضعَ التَّراقبِ",15,"ب",1,0],["والنقد يَجْني ورده من شوكه","غَضًّا، ويعصر شهْدَهُ من صَابه",16,"ب",2,0],["والنُّقْلُ والريحانُ من شأنهم","فلا يَعِبْ فقدَها عائبُ",17,"ب",1,0],["والنقطة البائية ال","مجرورة في العليا رداها",18,"ا",3,0],["والنقعُ يصعد في السماء قتامهُ","والخيلُ مثل السيل تطمي ضمّرا",19,"ر",2,0],["والنقع ليل والرماح نجومه","والخيل عقبان لديه كواسر",20,"ر",1,0],["وَالنَقعُ لَيلٌ في نَهارٍ شِبهُهُ","زُرقُ الأَسِنَّةِ في سَوادِ الحِندِسِ",21,"س",1,0],["وَالنَّقعُ فيهِ كَالغَمامِ وَالظُّبى","بُروقُهُ وَالرَّكضُ صَوتُ الرَعدِ",22,"د",1,0],["وَالنَقضُ يَحصُلُ بِالكِتابَةِ عاجِلاً","في أَودَةِ الكِتابِ دونَ تَوانِ",23,"ن",1,0],["وَالنَقعُ وَالرَيّانُ جُنَّ نَباتُهُ","مُستَأسِداً وَزَها الرِياضَ تُؤامُها",24,"م",3,0],["وَالنَقباءُ لَهُم","بِلا مَراءِ اِثنا عَشَر",25,"ر",1,0],["والنّقصُ في دينِهم أو في عِبارتِهِم","وكلُّ ذلكَ نوعٌ من تجارتِهِم",26,"م",1,0],["والنقْعُ قد مدّ رُواقَ الدُجى","وأطلعَ الخَرْصانُ شَهْبانا",27,"ن",2,0],["والنقعُ يتربُ من دم الفرسان ما","كتبت يراعُ رماحها في الصَّفصف",28,"ف",1,0],["والنَّقْصُ والزِّيادَهْ","مُخَالِفَانِ الْعَادَهْ",29,"ه",1,0],["وَالنَّقْعُ يغشى العينَ عن لِحاظها","والرَّكْضُ يرمي الأرضَ بالزَّلازِلِ",30,"ل",1,0],["وَالنّقصُ مُلتَحفٌ بكمْ ما فيكُمُ","عنهُ المحيصُ ولا له إفراجُ",31,"ج",1,0],["والنقر في الناقور يكشف خافياً","باللبس أول ما يقول وآخره",32,"ر",2,0],["وَالنُقَباءُ ذو العُيونَ المومِئَه","لِلَّهِ في الغَربِ وَهُم خَمسُمائَه",33,"ه",1,0],["وَالنَقعُ ثار دُخانا وَالظُبا شَرَرٌ","وَما سوى حطبِ الأَجسام مَوقودُ",34,"د",1,0],["والنقدُ لا يُؤخَذُ إلا كما","يُعْطَى بِنَزْعِ العينِ والماضغ",35,"غ",1,0],["والنقصُ في نفسِ الطبيعةِ كامنٌ","فبنو الطبيعة نقصُهم لا يُنكر",36,"ر",1,0],["وَالنَقرُ وَالنَغَمُ مِن كَعسابِ","مُصيبَةُ العودِ وَالقَضيب",37,"ب",1,0],["وَالنَقْرِ وَالتَأْيِيِهِ وَالإِجْدامِ","مِمَّنْ أَبُو رَبِيعَة الأَيْتامِ",38,"م",1,0],["والنقص أولى في هن وقيل ذا","شيء وفوه من فم قد أخذا",39,"ذ",2,0],["والنقص في الوافر خزل الكامل","كما ترى في سطح دور شامل",40,"ل",1,0],["والنقص في خامسه والسابع","والخزل في ثانيه ثم الرابع",40,"ع",1,0],["والنقط قسمان فقسم ربعا","وآخر مدوّر قد وقعا",41,"ع",2,0],["والنَّقْلُ من ذكرِ ابن مشكان الذي","هو غُرَّةُ الكرماءِ والفُضَلاءِ",42,"ا",2,0],["والنقض والابرام والتصريف وال","تدبير للمختار من آياته",43,"ت",2,0],["وَالنَقعُ قَد مَدَّ جُنحَ اللَيلِ فَوقَهُم","أَم عَينُهُم لا تَرى التَضفيرَ في الشَعرِ",44,"ر",1,0],["والنّقص في الشّعب من نقص الحكومة لو","تبغي الحكومة دفع النّقص ما صعبا",45,"ب",2,0],["والنقد في البيع والإنساء بشرطه","وقتين في البيع موصولا ومقتضبا",46,"ب",2,0],["والنقع قد ملأ الأرجاء عشيره","فصار كالجبل الموفي على الجبل",47,"ل",1,0],["والنقع يبني والوغى قد أعربت","صحف المنايا والصفاح تترجم",48,"م",1,0],["وَالنَقعُ يُبَرقِعُ أَوجُهَها","فَتَعُودُ مُبَدَّلَةَ الخُلُقِ",49,"ق",1,0],["والنقع ليل ماله","غير ظُبا الهند شُعل",50,"ل",1,0],["والنقع من وقع كل سلهبة","داج ووجه السماء محتجب",51,"ب",1,0],["والنقع من خلل السيوف كأنه","طُرَرُ الحراقة حول نار المضرم",52,"م",1,0],["والنقع يكسو الأفق ثوباً أدكناً","والأرض تلبس أرجواناً أحمرا",53,"ر",2,0],["والنقلُ قد أثبت أسماءَه","لحكمتهِ الخابرِ والحائر",54,"ر",1,0],["والنقلُ يأخذه بالعقلِ فهو به","فقد ترجَّح بالتفصيلِ معقول",55,"ل",1,0],["وَالنَّقلُ آحادٌ فََموقُوفٌ عَلَى","صِدقِ الرُّوَاةِ وَلَيسَ ذَا بُرهَانِ",56,"ن",1,0],["وَالنَّقلُ جَاءَ بِمَا يَحَارُ العَقلُ فِي","هِ لاَ المُحَالُ البَيِّنُ البُطلاَنِ",56,"ن",1,0],["وَالنَّقعُ يُسفِرُ بِالظُّبا فَكَأَنَّهُ","غَضَبٌ تَبَسَّم بَينَهُ لَمعُ الرِّضا",57,"ض",2,0],["والنقطتان شمالها وجنوبها","قد قيل قطباها بغير تعنت",58,"ت",1,0],["والنقطتين شمالها وجنوبها","فصلت برابعة لها وتسمت",58,"ت",1,0],["والنقع مثل الغيم يرفعه الهوى","والقطر من عرق يسيل بقوة",59,"ه",1,0],["وَالنقصُ قد عدَل الخَفيفَ وفوقهُ","جزءٌ من الثاني فَيَبقى فضلهُ",60,"ل",2,0],["والنقشبندي احمد الشهير","من خارج وقبره منير",61,"ر",1,0],["والنقل لا بد مع المشموم","فغير مهجو ولا مسؤوم",62,"م",1,0],["والنقع ثوب بالنسور مطير","والارض فرش بالجياد مخيل",63,"ل",1,0],["وَالنَّقلُ إن يُعدَم نَظيرٌ مُمتنِع","وَذَاكَ فِى المَهمُوزِ لَيسَ يَمتَنِع",64,"ع",1,0],["والنقل في تواتر الأخبار","يغني عن الرؤية بالأبصار",65,"ر",1,0],["والنقض يبذر في القلوب عداوة","لذوي الكمال ويورث الشنأنا",66,"ن",2,0],["والنَقتَصِر هُنَا عَلَى الأكوَانِ","فَإنَّهَا لِلقَصدِ كالعِنوَانِ",67,"ن",1,0],["والنقعُ يَنْصُلُ بالنُّصُولِ خضابُهُ","فكأَنّه لونُ الشباب الناصلِ",68,"ل",1,0],["والنقس أخجل من كتابة شَعرهِ","حنّا أتى عنها يقول بشِعرهِ",69,"ه",1,0],["والنقعُ مثل سحابةٍ تبكي دماً","والباتراتُ بوارقٌ تتبسم",70,"م",1,0],["والنَقى الرَجراج","واشَوقي لحُسّانَه",71,"ه",1,0],["والنقل من فستق جنيٍ","رطبٌ حديثٌ به القطاف",72,"ف",1,0],["والنّقدُ سلّمَ للمَليكة مُعْلنًا:","كلُّ القَصائد فيكِ، ما أحْلاها!",73,"ا",3,0],["والنقع فوق صقال البيض منعقد","كما استقل دخان تحته لهب",74,"ب",1,0],["والنقطةُ انسكبتْ لو شاءَ يجعلُها","دمعاً على الخدِّ أو طلاً وأسرارا",75,"ر",2,0],["والنقع قام سماء فوق ارؤسهم","آفاقها اظلمت منه نواحيها",76,"ي",3,0],["والنقع يحكي السحاب الجون مرتكما","وبارق البيض يجلو الجو خاطفه",77,"ف",2,0],["والنقد له مبدا وقيمة وقانون","وإن كان جاني من خبير ارتضيته",78,"ت",2,0],["والنقد يحمي حمى الإبداع يضبطهُ","وهيئة النقد عندي تشبه الشُّرطَةْ",79,"ط",2,0],["والنقع ليل والأسنة أنجم","والسمر غاب والكماة أسود",80,"د",1,1],["والنقلُ قد أثبت أسماءَه","لحكمة ِ الخابرِ والحائرِ",81,"ر",1,0]]}