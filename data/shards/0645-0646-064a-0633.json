الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""]],"verses":[["مَن يُسبِغُ النِعَمَ الجِسا","مَ وَيَصطَفي المَجدَ الجَزيلا",0,"ل",2,0],["مَن يَستَفِزُّ سُيوفاً مِن مَغامِدِها","وَمَن يُجَلُّلُ نوقاً بَينَ أَنساعِ",1,"ع",1,0],["مَن يَسأَلِ الناسَ عَن حالي فَشاهِدُها","مَحضُ العِيانِ الَّذي يُغني عَنِ الخَبَرِ",2,"ر",1,0],["مَنْ يُسْعِفُ الكَهْلَ وَحَاجَاتُ منْ","يَعُولُ مِنْ أُسْرَتِهِ مَاهِيَهْ",3,"ي",2,0],["مَنْ يَسْتَظِلُّ بِهَا وَلَيْسَ بِمُلْهَمٍ","تُلْقِي عَلَيْهِ ظِلالُهَا الإِلْهَامَا",4,"م",2,0],["مَنْ يَسْتبِيحُكَ وَالآسَادُ رَابِضَةٌ","إنَّ لثَّعَالِبَ لاَ تَدْنُو مِنَ الأَجَمِ",5,"م",1,0],["مَن يُسعِفُ الناسَ إِذا","نودِيَ كُلٌّ فَأَبى",6,"ب",2,0],["مَن يَستَنِر بِالهُدى يُنِرهُ وَمَن","يَبغِ إِلى اللَهِ مَطلَباً يَجِدِ",7,"د",1,0],["مَن يَسأَلِ اللَهَ أَن يُبقي سَراتَكُمُ","فَإِنَّما سالَهُ أَن يُبقِيَ الكَرَما",8,"م",2,0],["مَن يُسقَ بَعدَ المَنامِ ريقَتَها","يُسقَ بِمِسكٍ وَبارِدٍ خَصِرِ",9,"ر",1,0],["مَن يُسمِعُ القاصينَ شَكوى أُمَّةٍ","ناضَلتَ عَنها الدَهرَ خَيرَ نِضالِ",10,"ل",1,0],["مَن يُسعِدُ الأَوطانَ غَيرُ بَنيها","وَيُنيلُها الآمالَ غَيرُ ذَويها",11,"ي",3,1],["مَن يَسَلِ الناسَ يَحرِموهُ","وَسائِلُ اللَهِ لا يَخيبُ",12,"ب",1,0],["من يستعن بالعلم يف","تَتح البلاد بلا قتال",13,"ل",1,0],["مَنْ يَسْتَبِحْهُ عَدُّوُّنَا","فَلَهْ بِنَا صِلَةُ الرَّحِمْ",14,"م",1,0],["مَنْ يُسَبِّحْ عَلَى المَوَاهِبِ مَوْلاَهُ","فَزِدْهُ يَا سَيِّدِي تَسْبِيحَا",15,"ح",2,0],["مَنْ يَسْأَلِ الحُصَرِيَّ وَ ابْ","نَ ذُرَيْقَ فَاسْمُهُمَا يُجِيبُ",16,"ب",1,0],["مَنْ يُسَائِلْ يُفْحِمْهُ بِالرَّدِّ أَبْقى","أَثَرٍ مِنْكَ فِي النَّهَى مأْثُورِ",17,"ر",1,0],["من يسرقُ الخُبزَ إنقاذا لصبيبتهِ","أحق بالعذر ممن يسرق المِدَحا",18,"ح",2,0],["مَنْ يُسامِي أبا المواهِبِ وَالأشْبالِ","في فَيْضِ جُودِهِ أو يُداني",19,"ن",2,0],["مَنْ يستدِلَّ على الحقوق، فلن يَرَى","مثلَ الحسامِ على الحقوق دليلا",20,"ل",2,0],["مَن يُساري النَّجمَ نَحوى؟ مُكرِدٌ؟!","ما لَدَيكَ اليَوم؟ هل أنضَجتَ طَرحَك؟",21,"ك",1,0],["مَنْ يَسْألِ النَّاسَ يَحْرِمُوهُ","وسائِلُ اللهِ لا يَخيبُ",22,"ب",1,0],["مَن يَسعَ كَي يُدرِكَ أَيّامَهُ","يَجتَهِدِ الشَدَّ بِأَرضٍ فَضاء",23,"ا",2,0],["مني سَلاَمٌ ِإلى شَيخِي الذي جَعَلَه","رَبُّ البَرِيَّةِ فَرداً سَابِقاً كَمَلَه",24,"ه",1,1],["من يسمُ مطلبه يقع ان لم يقع","من أحمدِ بالضبع منه يهوضُ",25,"ض",1,0],["من يسلم الناس من فيه ومن يده","يصحب من الدهر عيشا خير مصطحب",26,"ب",1,0],["مَن يَستَرِق قَوماً يَعيشُ بِمالِهم","فَلتَبصُقِ الدُنيا عَلى أَلحادِهِ",27,"د",2,0],["من يستجير بفضل جاهك لائذا","فمن الذي في العالمين يضيمه",28,"م",2,0],["مَن يَستَعينُ بِقَلبي ال","مَحزونِ صَبراً جَميلا",29,"ل",2,0],["من يساويك بقاض في العلا","قد أطال الفكر في رد القضاء",30,"ا",2,0],["من يستضيءْ بالشّمس لا يحتجْ","إلى قبسٍ سواها يستمدُّ سناه",31,"ا",2,0],["من يستطيع الصبر أو يرضى به","عن مثل هذا المرشف المعسولِ",32,"ل",1,0],["مُنى سرورٍ كُحّلت","بِمرأى حظٍّ أكبرِ",33,"ر",1,1],["مَن يُسعِدِ اللَهُ يَلِن","لَهُ الزَمانُ إِن خَشُن",34,"ن",1,0],["مَن يَستَمِعُ صَوتَ عَبدَ الحَيِّ يَلقَ لَهُ","حَلاوَةَ زانَها إِتقانِ مَعرَفَتِهِ",35,"ه",1,1],["من يسأل الطرف المسهَّد","ما باله يجني ويسهَد",36,"د",1,1],["منِّي سلاماً طيباً نَشْرُه","أحلى من النوم لأهل السُّهاد",37,"د",1,0],["من يسحق الحق يحييه ويشعله","والحق أفصح نطقا وسط ضوضاء",38,"ا",2,0],["منّي سلامٌ إليك يا ابنَ منْ عرِبا","أنظرْ الى نفسِك كيْ تعلمَ العِلَلا",39,"ل",2,0],["مَن يُسَابِقُهُ إِلى مَعلُوةٍ","رَامَ بِالعيرِ سِبَاقَ الفَرَسِ",40,"س",1,0],["من يَسمع الأَوْتَارَ لا يعتَرِضْ","للناقِض الأَوْتَارَ وَالواتِر",41,"ر",1,0],["منْ يسأَل المحبوبَ ما","سَبُ العَداوَةِ للمُحِبِّ",42,"ب",1,0],["من يسود عشيرة بكماله","والحلم والإحسان فهو السيد",43,"د",1,0],["مَن يُساويه في وَفاء بِوَعد","لِمُقيم وَراحل وَمراقب",44,"ب",1,0],["من يسالمه ريبه لا يكونن","في أمان من ريبه سوف يودي",45,"د",2,0],["من يسؤْكم واريتموه ومن يح","سنْ إليكم سئمتمُ إحسانه",46,"ن",2,0],["من يسلُ وقتاً فأن ذكرهم","مجدد لي في كل أوقات",47,"ت",1,0],["مَن يَستَرق من ريش لَفظِ غَيره","وِبِالخَنا يدخله في شعره",48,"ه",1,0],["من يساميهم علا وفخارا","أو يحاكيهم فعالا وقيلا",49,"ل",2,0],["من يسترق لك المدائح","من معانيك العرائس",50,"س",1,0],["مَن يُساجِلني يُساجِل ماجِداً","يَملَأُ الدَلوَ إِلى عَقدِ الكَرَب",51,"ب",1,0],["مَنْ يُسالِمْني أُسالِمْهُ ومَنْ","رامَ حَرْبي فإِليهِ المَعْذرهْ",52,"ر",2,0],["من يستطيع بأن يحصي مناقبه","قد طبق الكون إفضالاً وإحسانا",53,"ن",2,0],["مَنْ يَستَحِلُّ لِصَيْدِها","فأَنا امرُؤٌ لا أَسْتَحِلّْ",54,"ل",1,0],["من يستعذ بربه كفاه","بحق لا إله إلا اللّه",55,"ه",1,0],["مني سقت من قواضيها أبا هرم","وهي كقَلب أبي كعب المُجيد صِفه",56,"ف",2,0],["مَن يُسَوّى بِأَحمَدَ بن يَزيدٍ","وَبِأَسلافِهِ مِن الأَسلافِ",57,"ف",1,0],["من يُسامي عُلاهُ شيخاً كبيراً","وله دانت القُرومُ صغيرا",58,"ر",2,0],["مَن يسعَ في شَقِّ العصا من قومِنا","فَلَقَد عصى وأتى فعالَ الأحمقِ",59,"ق",1,0],["مَن يسل يَعط وَمن يُستَفتح ال","باب يَفتَحهُ بَطيءُ او سَريع",60,"ع",1,1],["من يستطع فهرَك","من يعرفن فخرك",61,"ك",1,0],["من يسيرُ الغورَ ومن يعربه","قد أعجم الهولُ العقولَ فرَقا",62,"ق",2,0],["من يساويك ومن مثلك لا","ما سبيك التّبْرِ مثلُ الجندلِ",63,"ل",1,0],["من يستطيع كفاحها","أوردَّ غاثلة الحمام",64,"م",1,0],["من يسلك الدرب فليحضر مراكبه","وليحتكم سيرها فيه ومسراها",65,"ا",3,0],["من يستقل بعبأ كل عظيمة","يوماً إذا حربت ولد خصامها",66,"م",3,0],["من يستهل طلاقة لوفوده","من قبل عارفة يفيض سجامها",66,"م",3,0],["من يستقل بحمل كل عظيمة","وبمن يلوذ الصارخ المستنجد",67,"د",1,0],["من يُساويك فطنة وَذَكاء","وَيدانيك عزّة وَإِباءَ",68,"ا",2,0],["من يسكن الشام يعرس به","والشام إن لم يفننا كارب",69,"ب",1,1],["من يستقل من ذنبه","من قبل مصرعه يقل",70,"ل",1,0],["من يسوعَ المُجتَبَى هذا الأمين","صارَ رأساً للكنيسة مُشتهر",71,"ر",1,0],["مني سماعاً عبادَ اللَه واعتبروا","يا أَمّةً ضحكت من جهلها الأُمم",72,"م",1,0],["من يسمع الملهوف حق له","لا ريب أن يسمعه السامعونْ",73,"ن",1,0],["من يستعفُّ يُعفِه","وَيُنِيلُهُ ما يرتضيه",74,"ي",2,0],["مَن يَسدّ الثُّغورَ بَعدَك يا سَي","يدَ فهرٍ أَم مَن يَقود الجَميعا",75,"ع",2,0],["مَن يَسقُهُ القَبضاءُ لِلحتفِ مِنَّا","فَليذُقهُ وأنتُمُ بِأمانِ",76,"ن",1,0],["من يَسيرِ الأَموالِ تُقصَدُ من لعبٍ","ومن زينةٍ ومن ايلامِ",77,"م",1,0],["من يسر الزمان سيء وكل","كايلته الأيام صاعاً فصاعا",78,"ع",2,0],["من يستطيع مديح من في بابهِ","مستخدماً ربَّ الكمال السَهبلا",79,"ل",2,0],["مَن يَسمَع الجَفوَةَ في خِلٍّ وَلَم","يَغضَب لَها فإِنَّهُ كَمَن جَفَا",80,"ا",1,0],["مَن يَستَطِل يَوماً عَلى الكُفاةِ","فَقَد تَناسى كامِلَ الصِفاتِ",81,"ت",1,0],["مَن يستعنْ باللهِ في أمرِه","يَجِدْه عَوْناً ساعةَ العُسرَهْ",82,"ر",2,0],["من يستطيع بلوغ أعلى منزل","ما باله يرضى بأدنى منزل",83,"ل",1,0],["من يستطيع بلوغ أعلى منزل","متدرجا فوق السماك الاعزل",84,"ل",1,0],["من يستكين على ذل ومنقصة","حياته فوق سطح الأرض كالعدم",85,"م",1,0],["مَن يُسْمِعُ الحَربَ!.. مَوتَى عاطِلُونَ هُنا","في كُلِّ وَجهٍ قَتِيلٌ ظاهِرٌ وخَفِي",86,"ف",2,0],["من يسأل عنها متهم","بالأعمال الإجرامية",87,"ي",2,0],["من يسألُ المولى بهم","خيراً له فقد اكتفى",88,"ف",2,0],["مني سلام احمله بارد الريف","وازكى التحية صوب نسل المذاريب",89,"ب",1,0],["مَنْ يسدُلُ جَفنَ العينِ دُجىً","وجوى الأحشاءِ يُسَهّدُهُ",90,"د",2,0],["من يسأل البلقاء والزرقاء في ال","ميدان حيث به الروس تدحرج",91,"ج",1,0],["مَن يستطِع وصفاً لما هو قد نما","في قلبيَ المأسورِ فهو رسولُ",92,"ل",1,0],["مَنْ يَسْتَطِيْعُ بُلُوغَهَا وَدُخُوْلَها","حَتّى يُصَلِّيَ رَكْعَةً بِأمَانِ ؟",93,"ن",1,0],["من يساجلني يساجل ماجداً","يمْلَأ من آدابه كل ذنُوب الطَّوِيل",94,"ل",1,1],["مَنْ يَسْتَجِيبُ دُعَاءَ قَلْبٍ بِالرَّجَا","مَدَّ الْأَكُفَّ إِلَى السَّمَا مُتَوَسِّلَا ؟",95,"ل",2,1],["من يسمني تاريخها في دعاء","فليؤمن عليه وهو مصيخ",96,"خ",1,0],["من يستحقُّ هدياتي سواكِ؟.. فما","أهديتِ لي ليس يُفنى في مدى الدهرِ",97,"ر",1,0],["من يسمو مثلكِ يا سيدتي","بالإجلالِ وبالتبجيلْ",98,"ل",1,0],["من يسعفُ العطشانَ حتى يرتوي","من ذا الذي يروي كما الروحُ روتْ",99,"ت",1,0],["مَنْ يَسْكُنونَ الْحُ