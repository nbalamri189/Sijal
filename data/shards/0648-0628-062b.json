//www.poetsgate.com/ViewPoem.aspx?id=185057",""],[6125,"عَاقَرتُ حُبَّكِ فَاستَحَلتُ مُرِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=209068",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""],[242,"حي على الأنس ان طيف الهموم سرى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563699",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""]],"verses":[["وَبَثَّ ضياءً كادَ مِن فَرَقي لَهُ","يَضِلُّ بِهِ لُبِّي وَبالنُّورِ يُهتَدى",0,"د",2,0],["وبَثَّ نَسيمُ الرّوضِ فيها تحيّةً","قَريبَةَ عهْدٍ باجْتِيازٍ على الهِنْدِ",1,"د",1,0],["وَبِثَغرِ دِمياطٍ فَكَم مِن بيعَةٍ","عُبِدَ الصَليبُ بِها وَكانَت مَسجِدا",2,"د",2,0],["وَبَثَثتَ مَكرُمَةً فَقَد أَعدَدتَها","رَصَداً ليَومِ تَفاخُرٍ وَنِضالِ",3,"ل",1,0],["وبث فيهم كعجوز العرب","تصيح في الشجعان بين اللجب",4,"ب",1,0],["وبثَّ صبابتي إنسان عيني","فيا عجباً وفي الفم منه ماء",5,"ا",2,0],["وبثينة اما مضت في شدوها","انحى يشايع ما تقول المعزف",6,"ف",1,0],["وبثثت للعهد الذي","كنا به سعداء وجدا",7,"د",2,0],["وبثَّ السَّرايا حولها فتفرَّقَتْ","كما بثَّتِ الرِّيحُ الحَيا فتبدَّدا",8,"د",2,0],["وَبِثَغرٍ واضِحٍ أَنيابُهُ","طَيِّبِ الريحِ جَميلِ المُبتَسَم",9,"م",1,0],["وَبِثَغرٍ يَحكي المُخَبِّرُ عَنهُ","نَفحَةَ المِسكِ فُتَّ في كَأسِ راحِ",10,"ح",1,0],["وَبَثرٌ مائِحُ الحِدثانِ يَطمو","إِذا اِلتَقَتِ المِياهُ بِكُلِّ بِثرِ",11,"ر",1,0],["وَبَثَقْتَ لِي مِنْ فَيْضِ بَحْرِكَ جَدْوَلاً","غَمَرَ الْبِحَارَ بِسَيْلِهِ الْمُتَدَفِّعِ",12,"ع",1,0],["وَبَثِّ العُيُونِ شُعَاعَ النُّهَى","يُبِيحُ السَّرائِرَ مِنْ كُلِّ رَاءْ",13,"ا",2,0],["وَبَثَّهَا فِي زَفْرَةٍ فَانْبَرَتْ","بِخِفَّةِ البُشْرَى وَلُطْفِ السرُورْ",14,"ر",1,0],["وبَثثتَ رُوحَكَ في الشّيوخِ فكلُّهم","داعٍ إلى نُور النبوّة هادِي",15,"د",2,0],["وبثنة قد قالت وكل حديثها","إلينا ولو قالت بسوء مملح",16,"ح",1,1],["وبثبت شكوائي لسلطان عزه","وألقيت عقداً لا أشك بحله",17,"ل",2,0],["وبُثَّ شكواكَ مَعْ من لا شبيهَ له","فترجعَنَّ بأجرٍ غير مَمنُونٍ",18,"ن",1,0],["وبَثثنَ الأسَى الرَّسِيسَ حَوَالَي","كَ يَتَحَدَّرنَ لُؤلُؤاً مَنظُومَا",19,"م",2,0],["وبثَّ في كلِّ إقليمٍ هُدى وندى","فليسَ يُوجَدُ لا جهلٌ ولا عدمُ",20,"م",1,0],["وَبَثَّ بِكُلِّ بَحرٍ مُنشآتٍ","تَفوتُ بِطَيِّها الجُردَ الجِيادا",21,"د",2,0],["وبثَّ على البحر الأساطيل جَحْفَلا","بأكثرَ من نِينانِه ودَوابه",22,"ب",2,0],["وَبثغرهِ شنَبٌ يروقكَ حُسنهُ","مُتبسّمٌ عن بارقٍ متفلّجُ",23,"ج",1,0],["وبثغرهِ ظلمٌ يحرمُ رشفهُ","ظلماً وعهدي أن يحل الطيبُ",24,"ب",1,0],["وبث على جوانبهِ","مفاتن تفتن الورعا",25,"ع",2,0],["وَبِثَغرِها أُخرى خِتامُ كُؤوسِها","مِسكٌ وَلَكِن لا يُفَضُّ خِتامُها",26,"م",3,0],["وَبَثَّ ذَا بِبَنَانِ اللَّذْ يُحَرِّكُهُ","خُذْ مَا صَفَا لَكَ وَانْبُذْ كُلَّ مَنْ كَدَرَا",27,"ر",2,0],["وبثالث الحرمين صلى قانتا","بالأنبياء وهم له أنداد",28,"د",1,0],["وبثغر منضدٍ","شنب الريق بارد",29,"د",1,0],["وبثّي لهم ذكرى حبيبٍ ومنزلٍ","وطيبَ وصالٍ بالمجامع ضائع",30,"ع",1,0],["وبث محامد وشفا ثناء","يضوع على التنائي والتناسي",31,"س",2,0],["وَبَثّ العَدْلَ والعُدوانُ فاشٍ","فَلَيْسَ مِنَ المُلوكِ لَهُ عَديلُ",32,"ل",1,0],["وَبثّوا الجيادَ السابحات ليَلحقوا","وَهُل يُدرِك الكسلانُ شأو أَخي الجدِّ",33,"د",1,1],["وَبثّ لها بِساطٌ من نثارٍ","دَنانيرُ الشموسِ به نقودُ",34,"د",1,0],["وَبِثغري عَنهُ يَبدو","نَثرُ دُرٍّ وَهوَ عِقدُ",35,"د",1,0],["وَبثّ تَشوّقٍ مِن قَلب عان","لِساحة باب فَضل مِنكَ عالي",36,"ل",2,0],["وَبُثّا لَهُ ما بي عَسى تَستميله","عَواطفه اللاتي بِها الفَوز للصحبِ",37,"ب",1,0],["وبَثَّ مَشيبُ الصُّبْحِ أَوضاحَ فَرعِه","فغَضّتْ جُفونُ اللّيلِ عن لَمْع وَخْطها",38,"ط",3,0],["وبثالث الأيام قام بفعله","وبحكمه من غير قرنٍ ينفخ",39,"خ",1,0],["وَبَثَ اِشتِياق كُلَما رُمتَ وَصفَهُ","تَقول لِيَ الأَقلامُ كَم هَكَذا تَبكي",40,"ك",2,0],["وبث عرف الأقاحي والخزام ضحى","وادي الجنان فاحيى قلبيَ الوصبا",41,"ب",2,0],["وبثغرها حبب تضمن لؤلوءا","يروي عقودا عن صحاح الجوهري",42,"ر",2,0],["وبثغرك درّ زاد على","حسن الإغريض مع البرد",43,"د",1,0],["وبَثَّ الأيادي بينَ حِمْصٍ ومكَّةٍ","مُغِذَّاً فأحْيا كُلَّ جَدْب وماحِلِ",44,"ل",1,0],["وبثِّ كلّ مكْروهٍ","وافْسادِ أغانينا",45,"ن",2,0],["وبث العدل في الدنيا فأضحى","قطيع الشاء يأنس بالذئاب",46,"ب",1,0],["وَبَثَّ لِسانُ العَرَبِ خَمسينَ حَجَّةً","يُقَوِّمُ مُنآداً وَيُوَضِّحُ مُبهَما",47,"م",2,0],["وَبَثَثتَ في الحَرَمَينِ مِن صَدَقاتِك ال","حَسَناتِ ما يُغني عَنِ الحِرمانِ",48,"ن",1,0],["وبثثتها شكوى بأشعاري وفي","جنح الظلام تردد الأشعار",49,"ر",1,0],["وَبِثَغر الإِسكَندرية هَذا","قامَ عاماً بِالأَمر يَجلو قَذاه",50,"ا",2,0],["وَبِثاني شُهور عامك هَذا","قُلتَ لَبيك للسَميع العليم",51,"م",1,0],["وَبثغر الاسكندرية أَضحى","ناظِراً شُكرُه مِن الضَيف واجب",52,"ب",1,0],["وَبثغركَ الماءُ الزُلالُ فَما لَهُ","ما كانَ للظامي بِهِ مورودا",53,"د",2,0],["وَبِثُقْلٍ مِنَ الْعَذَابِ وَوِزْرٍ","يَنْقُضُ الظَّهْرَ أَيَّمَا إِنْقَاضِ",54,"ض",1,0],["وبثوب الحُسنِ مُشتمِلٌ","وبِحقْف الرمل مُتَّزِرُ",55,"ر",1,0],["وبثَّ في الأرض جميع خلقهِ","فكلُّ حيٍّ محْدَثٌ برزْقه",56,"ه",1,0],["وبث لها ليل التمام مَسهداً","عوازب ذكري أعملت في جهاده",57,"د",2,0],["وبثِّيه أشجاني ووجدي ولوعتي","وكيف عِناني عنه في الحب لا يُلوى",58,"و",2,0],["وَبِثَغْرِهِ شهدٌ حَلاَ","يَا مَنْ دَرَى مَنْ عَسَّلَهْ",59,"ل",2,0],["وَبِثغرِهِ شهدٌ يُنَادِي عَوْفُهُ","يَا أيُّهَا الحَلَوِي يَا ابْنَ السّكَّرِي",60,"ر",2,0],["وبثثتها في الناس منحة خالق","تهديهِمِ وتعزذهم وتخلّد",61,"د",1,0],["وبثّ التياعاتي التي قد تفاقمت","وفوراً وأشواقي الوفيّة مع وجدي",62,"د",2,0],["وبثّ على القطر البشير بشايراً","لها زينوا أهل البلاد ونوّروا",63,"ر",3,0],["وبثغرٍ عذبٍ حاز على","شهدٍ ما ماثله شهدُ",64,"د",1,0],["وبث علماً له وحلماً","أحكم أصليهما وأتقن",65,"ن",1,0],["وبثاني اثنين رفيق الغا","ر مدمر اصحاب العوج",66,"ج",1,0],["وبث فيها صنوفاً من بدائعه","من الخلائق من مثنى ومن وهد",67,"د",1,0],["وبثي وحزني يا محيط وكبوتي","على حروجهي وارتعاد فريصتي",68,"ي",1,0],["وبث لديه ما جرى يوم كربلا","فبالحشران قايسته كان أصعبا",69,"ب",2,0],["وَبِثقل ردف كَالكَثيب أَقَله","خصر كَخوط البانة المُتأود",70,"د",1,0],["وبثت شجونٌ وفاضت جفونٌ","وساءت ظنونٌ لأهل الودادِ",71,"د",1,0],["وبثغرٍ ذي عوارض غُرٍّ","مثل دُرٍّ هنَّ أو أقحوانِ",72,"ن",1,0],["وبثقل أجرهما ثقيلاتُ الخطا","صدرت كأَنَّ لها الرواسي أوسق",73,"ق",1,0],["وبُثّي بقومي روح الوئام","وبثّي بسلك القلوب السَّلاما",74,"م",2,0],["وَبَثَّ بِهِ من الوَسمي غَيثٌ","مَرادَ العَينِ منفرقَ البِساقِ",75,"ق",1,0],["وَبُثَّت حِبالٌ في مَرادٍ يَرودُهُ","فَأَخطَأَهُ مِنها كِفافٌ مُخَزَّمُ",76,"م",1,0],["وبثثنا بيننا شج","وا كنفث الراقياتِ",77,"ت",1,0],["وبثغره ماء الحياة لوارد","فبورده نار الجوانح تنطفي",78,"ف",2,0],["وبثغر رشفه أعطشني","حين روّانِيَ من عذبٍ جناه",79,"ه",1,1],["وبثَغرِه ماءُ الحيا","ةِ يروقُ كالصهبا صبيبُه",80,"ب",2,0],["وَبَثَثتها الشَكوى وَما لاقيته","مِن لَوم لائِمَة وَدهر مجحفِ",81,"ف",1,0],["وَبث النَدى وَالعرف حَتّى كَأَنَّما","تَكون مَولانا مِن الجود وَالنَدى",82,"د",2,0],["وبِثَبتٍ قارعتُ عَمراً عنِ المج","دِ فغادَرتُهُ صريعَ العوالي",83,"ل",2,0],["وَبِثَعرٍ طَيِّبِ النَف","حَةِ مَعسولِ المُجاجِ",84,"ج",1,0],["وبثَّ بذورَ الخُلفِ في القوم فاِنثنوا","وكاد يضيع الرشد لولا التكرّمُ",85,"م",1,0],["وبثغرها العطرى طلع أبيض","مابينه خمر الكؤوس مروق",86,"ق",1,0],["وبثثت في شكسبير ذكاءُ","يقرض الشعر بين نظم ونثر",87,"ر",1,0],["وبث لديك والآمال تجري","على خلدي وظلك منتهاها",88,"ا",3,0],["وَبثوا هَوى من لَم تَغير صِفاتُهُ","لِبُعدٍ وَلَو فيهِ غشاه مَماتُهُ",89,"ه",1,0],["وَبُثي له شَوقاً أَذاب حَشاشةً","تَقلِّبُها الأَيام في راحَتَي فكري",90,"ر",2,0],["وبثوا له لوعة أو ضنى","وشقوة حال ونجوى ندم",91,"م",1,0],["وبَثٌّ يسيل الدمع من قنواته","وحَثٌّ يهيج النفس فهي تضرّم",92,"م",1,0],["وبثغره ماء الحيا","ة وإنني ظمآنه",93,"ن",2,0],["وبثغره خمر سكرت به","سكراً أذاب حشاشة الجمر",94,"ر",1,0],["وبثي الحب للأزها","ر بالتغريد واللحن",95,"ن",1,0],["وبثغرها درر وفي لحظاتها","سحر يري أهل الغرام عجائبا",96,"ب",2,0],["وبثمان نفرٍ أنصاري","فلتنصرنِّي مدى الأعصارِ",97,"ر",1,0],["وبثلاثٍ نُسبوا للخزرجِ","من التفرُّقِ لنا فَنَجِّي",97,"ي",1,0],["وَبَثَثتُ في كُلِّ البِلادِ مَهابَةً","طَفق الغَزال بِها يُؤاخي الذيبا",98,"ب",2,0],["وَبثي له روح نهضتنا","تَري خير شهم وحر جري",99,"ر",2,0],["وَبَثَّ لِلشِركِ أَشراكاً فَما دَرَجَت","طَريدَة مِنهُ إِلّا اِستَوهَقَت فيها",100,"ي",3,0],["وبِثَوبِها العُطرِيِّ جَرَّتها وقد","صاحت 