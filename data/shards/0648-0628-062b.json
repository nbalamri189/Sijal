{"poems":[[63,"أعد نظرا هل شارف الحي ثهمدا","https://www.aldiwan.net/poem45830.html","الطويل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[89,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[89,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[61,"فتوحك ردت بهجة الملك سرمدا","https://www.aldiwan.net/poem51728.html","الطويل"],[31,"لمن الدار كخط بالقلم","https://www.aldiwan.net/poem41823.html","الرمل"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[46,"يجل الملك عن نظم ونثر","https://www.aldiwan.net/poem22681.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54950","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[32,"بثينة قد قالت","https://www.poetsgate.com/ViewPoem.aspx?id=109",""],[115,"لقد أكثر الباغي التعدي بقوله","https://www.aldiwan.net/poem42162.html","الطويل"],[128,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[133,"برء الإمام حياة الخلق كلهم","https://www.aldiwan.net/poem4214.html","البسيط"],[169,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[185,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[189,"الفلك تمخر والمهاري تنهج","https://www.aldiwan.net/poem35169.html","الكامل"],[199,"أمن الظبا ذاك الغرير المعجب","https://www.aldiwan.net/poem45580.html","الكامل"],[226,"على أطلال الحب","https://www.aldiwan.net/poem24227.html","عموديه"],[235,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[237,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[239,"في ليلة صبغ الظلام أديمها","https://www.aldiwan.net/poem23837.html","الكامل"],[256,"ومهاة غريرة","https://www.aldiwan.net/poem48364.html","مجزوء الرجز"],[259,"فؤاد على غصن الصبابة ساجع","https://www.aldiwan.net/poem35548.html","الطويل"],[261,"تحية مغرم للقاك مضنا","https://www.aldiwan.net/poem38252.html","الوافر"],[275,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[297,"وبثوا الجياد السابحات ليلحقوا","https://www.aldiwan.net/poem32993.html","الطويل"],[305,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[349,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[353,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[353,"ألا حدثا مولاي ذا المنزل الرحب","https://www.aldiwan.net/poem40776.html","الطويل"],[364,"ألا طرقتنا والثريا كقرطها","https://www.aldiwan.net/poem60853.html","الطويل"],[377,"ما بين جفني والأحبة برزخ","https://www.aldiwan.net/poem66880.html","الكامل"],[380,"سلام على من لا أنوه باسمه","https://www.aldiwan.net/poem48776.html","الطويل"],[429,"حسن اهتزاز غصون السرو هيمني","https://www.aldiwan.net/poem40525.html","البسيط"],[429,"برزت تفاخر بالجبين الأقمر","https://www.aldiwan.net/poem41402.html","الكامل"],[437,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[461,"أبر صلاح الدين وابن صلاحه","https://www.aldiwan.net/poem16398.html","الطويل"],[505,"بيان","https://www.aldiwan.net/poem42464.html","الهزج"],[515,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"]],"verses":[["وَبَثَّ ضياءً كادَ مِن فَرَقي لَهُ","يَضِلُّ بِهِ لُبِّي وَبالنُّورِ يُهتَدى",0,"د",2,0],["وبَثَّ نَسيمُ الرّوضِ فيها تحيّةً","قَريبَةَ عهْدٍ باجْتِيازٍ على الهِنْدِ",1,"د",1,0],["وَبِثَغرِ دِمياطٍ فَكَم مِن بيعَةٍ","عُبِدَ الصَليبُ بِها وَكانَت مَسجِدا",2,"د",2,0],["وَبَثَثتَ مَكرُمَةً فَقَد أَعدَدتَها","رَصَداً ليَومِ تَفاخُرٍ وَنِضالِ",3,"ل",1,0],["وبث فيهم كعجوز العرب","تصيح في الشجعان بين اللجب",4,"ب",1,0],["وبثَّ صبابتي إنسان عيني","فيا عجباً وفي الفم منه ماء",5,"ا",2,0],["وبثينة اما مضت في شدوها","انحى يشايع ما تقول المعزف",6,"ف",1,0],["وبثثت للعهد الذي","كنا به سعداء وجدا",7,"د",2,0],["وبثَّ السَّرايا حولها فتفرَّقَتْ","كما بثَّتِ الرِّيحُ الحَيا فتبدَّدا",8,"د",2,0],["وَبِثَغرٍ واضِحٍ أَنيابُهُ","طَيِّبِ الريحِ جَميلِ المُبتَسَم",9,"م",1,0],["وَبِثَغرٍ يَحكي المُخَبِّرُ عَنهُ","نَفحَةَ المِسكِ فُتَّ في كَأسِ راحِ",10,"ح",1,0],["وَبَثرٌ مائِحُ الحِدثانِ يَطمو","إِذا اِلتَقَتِ المِياهُ بِكُلِّ بِثرِ",11,"ر",1,0],["وَبَثَقْتَ لِي مِنْ فَيْضِ بَحْرِكَ جَدْوَلاً","غَمَرَ الْبِحَارَ بِسَيْلِهِ الْمُتَدَفِّعِ",12,"ع",1,0],["وَبَثِّ العُيُونِ شُعَاعَ النُّهَى","يُبِيحُ السَّرائِرَ مِنْ كُلِّ رَاءْ",13,"ا",2,0],["وَبَثَّهَا فِي زَفْرَةٍ فَانْبَرَتْ","بِخِفَّةِ البُشْرَى وَلُطْفِ السرُورْ",14,"ر",1,0],["وبَثثتَ رُوحَكَ في الشّيوخِ فكلُّهم","داعٍ إلى نُور النبوّة هادِي",15,"د",2,0],["وبثنة قد قالت وكل حديثها","إلينا ولو قالت بسوء مملح",16,"ح",1,1],["وبثبت شكوائي لسلطان عزه","وألقيت عقداً لا أشك بحله",17,"ل",2,0],["وبُثَّ شكواكَ مَعْ من لا شبيهَ له","فترجعَنَّ بأجرٍ غير مَمنُونٍ",18,"ن",1,0],["وبَثثنَ الأسَى الرَّسِيسَ حَوَالَي","كَ يَتَحَدَّرنَ لُؤلُؤاً مَنظُومَا",19,"م",2,0],["وبثَّ في كلِّ إقليمٍ هُدى وندى","فليسَ يُوجَدُ لا جهلٌ ولا عدمُ",20,"م",1,0],["وَبَثَّ بِكُلِّ بَحرٍ مُنشآتٍ","تَفوتُ بِطَيِّها الجُردَ الجِيادا",21,"د",2,0],["وبثَّ على البحر الأساطيل جَحْفَلا","بأكثرَ من نِينانِه ودَوابه",22,"ب",2,0],["وَبثغرهِ شنَبٌ يروقكَ حُسنهُ","مُتبسّمٌ عن بارقٍ متفلّجُ",23,"ج",1,0],["وبثغرهِ ظلمٌ يحرمُ رشفهُ","ظلماً وعهدي أن يحل الطيبُ",24,"ب",1,0],["وبث على جوانبهِ","مفاتن تفتن الورعا",25,"ع",2,0],["وَبِثَغرِها أُخرى خِتامُ كُؤوسِها","مِسكٌ وَلَكِن لا يُفَضُّ خِتامُها",26,"م",3,0],["وَبَثَّ ذَا بِبَنَانِ اللَّذْ يُحَرِّكُهُ","خُذْ مَا صَفَا لَكَ وَانْبُذْ كُلَّ مَنْ كَدَرَا",27,"ر",2,0],["وبثالث الحرمين صلى قانتا","بالأنبياء وهم له أنداد",28,"د",1,0],["وبثغر منضدٍ","شنب الريق بارد",29,"د",1,0],["وبثّي لهم ذكرى حبيبٍ ومنزلٍ","وطيبَ وصالٍ بالمجامع ضائع",30,"ع",1,0],["وبث محامد وشفا ثناء","يضوع على التنائي والتناسي",31,"س",2,0],["وَبَثّ العَدْلَ والعُدوانُ فاشٍ","فَلَيْسَ مِنَ المُلوكِ لَهُ عَديلُ",32,"ل",1,0],["وَبثّوا الجيادَ السابحات ليَلحقوا","وَهُل يُدرِك الكسلانُ شأو أَخي الجدِّ",33,"د",1,1],["وَبثّ لها بِساطٌ من نثارٍ","دَنانيرُ الشموسِ به نقودُ",34,"د",1,0],["وَبِثغري عَنهُ يَبدو","نَثرُ دُرٍّ وَهوَ عِقدُ",35,"د",1,0],["وَبثّ تَشوّقٍ مِن قَلب عان","لِساحة باب فَضل مِنكَ عالي",36,"ي",1,0],["وَبُثّا لَهُ ما بي عَسى تَستميله","عَواطفه اللاتي بِها الفَوز للصحبِ",37,"ب",1,0],["وبَثَّ مَشيبُ الصُّبْحِ أَوضاحَ فَرعِه","فغَضّتْ جُفونُ اللّيلِ عن لَمْع وَخْطها",38,"ط",3,0],["وبثالث الأيام قام بفعله","وبحكمه من غير قرنٍ ينفخ",39,"خ",1,0],["وَبَثَ اِشتِياق كُلَما رُمتَ وَصفَهُ","تَقول لِيَ الأَقلامُ كَم هَكَذا تَبكي",40,"ك",2,0],["وبث عرف الأقاحي والخزام ضحى","وادي الجنان فاحيى قلبيَ الوصبا",41,"ب",2,0],["وبثغرها حبب تضمن لؤلوءا","يروي عقودا عن صحاح الجوهري",42,"ي",1,0],["وبثغرك درّ زاد على","حسن الإغريض مع البرد",43,"د",1,0],["وبَثَّ الأيادي بينَ حِمْصٍ ومكَّةٍ","مُغِذَّاً فأحْيا كُلَّ جَدْب وماحِلِ",44,"ل",1,0],["وبثِّ كلّ مكْروهٍ","وافْسادِ أغانينا",45,"ن",2,0],["وبث العدل في الدنيا فأضحى","قطيع الشاء يأنس بالذئاب",46,"ب",1,0]]}