{"poems":[[63,"أعد نظرا هل شارف الحي ثهمدا","https://www.aldiwan.net/poem45830.html","الطويل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[89,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[89,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[61,"فتوحك ردت بهجة الملك سرمدا","https://www.aldiwan.net/poem51728.html","الطويل"],[31,"لمن الدار كخط بالقلم","https://www.aldiwan.net/poem41823.html","الرمل"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[46,"يجل الملك عن نظم ونثر","https://www.aldiwan.net/poem22681.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54950","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[32,"بثينة قد قالت","https://www.poetsgate.com/ViewPoem.aspx?id=109",""]],"verses":[["وَبَثَّ ضياءً كادَ مِن فَرَقي لَهُ","يَضِلُّ بِهِ لُبِّي وَبالنُّورِ يُهتَدى",0,"د",2,0],["وبَثَّ نَسيمُ الرّوضِ فيها تحيّةً","قَريبَةَ عهْدٍ باجْتِيازٍ على الهِنْدِ",1,"د",1,0],["وَبِثَغرِ دِمياطٍ فَكَم مِن بيعَةٍ","عُبِدَ الصَليبُ بِها وَكانَت مَسجِدا",2,"د",2,0],["وَبَثَثتَ مَكرُمَةً فَقَد أَعدَدتَها","رَصَداً ليَومِ تَفاخُرٍ وَنِضالِ",3,"ل",1,0],["وبث فيهم كعجوز العرب","تصيح في الشجعان بين اللجب",4,"ب",1,0],["وبثَّ صبابتي إنسان عيني","فيا عجباً وفي الفم منه ماء",5,"ا",2,0],["وبثينة اما مضت في شدوها","انحى يشايع ما تقول المعزف",6,"ف",1,0],["وبثثت للعهد الذي","كنا به سعداء وجدا",7,"د",2,0],["وبثَّ السَّرايا حولها فتفرَّقَتْ","كما بثَّتِ الرِّيحُ الحَيا فتبدَّدا",8,"د",2,0],["وَبِثَغرٍ واضِحٍ أَنيابُهُ","طَيِّبِ الريحِ جَميلِ المُبتَسَم",9,"م",1,0],["وَبِثَغرٍ يَحكي المُخَبِّرُ عَنهُ","نَفحَةَ المِسكِ فُتَّ في كَأسِ راحِ",10,"ح",1,0],["وَبَثرٌ مائِحُ الحِدثانِ يَطمو","إِذا اِلتَقَتِ المِياهُ بِكُلِّ بِثرِ",11,"ر",1,0],["وَبَثَقْتَ لِي مِنْ فَيْضِ بَحْرِكَ جَدْوَلاً","غَمَرَ الْبِحَارَ بِسَيْلِهِ الْمُتَدَفِّعِ",12,"ع",1,0],["وَبَثِّ العُيُونِ شُعَاعَ النُّهَى","يُبِيحُ السَّرائِرَ مِنْ كُلِّ رَاءْ",13,"ا",2,0],["وَبَثَّهَا فِي زَفْرَةٍ فَانْبَرَتْ","بِخِفَّةِ البُشْرَى وَلُطْفِ السرُورْ",14,"ر",1,0],["وبَثثتَ رُوحَكَ في الشّيوخِ فكلُّهم","داعٍ إلى نُور النبوّة هادِي",15,"د",2,0],["وبثنة قد قالت وكل حديثها","إلينا ولو قالت بسوء مملح",16,"ح",1,1]]}