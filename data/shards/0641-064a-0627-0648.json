لطويل"],[211,"أجبني إن تفضلت","https://www.aldiwan.net/poem46344.html","مجزوء الوافر"],[211,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[211,"لأصبحت نهب الأسى والحزن","https://www.aldiwan.net/poem46592.html","المتقارب"],[211,"لا صبحت نهب الأسى والحزن","https://www.aldiwan.net/poem46814.html","المتقارب"],[222,"عوارض آس ما أرى أم زبرجد","https://www.aldiwan.net/poem55411.html","الطويل"],[229,"يا سراج الأنام جنح الظلام","https://www.aldiwan.net/poem50831.html","الخفيف"],[229,"سقى السفح من دير القصير إلى النهر","https://www.aldiwan.net/poem51045.html","الطويل"],[229,"كل حي إلى الفناء يصير","https://www.aldiwan.net/poem51107.html","الخفيف"],[237,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[241,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[259,"ألا أيها الميال عن منهل الورد","https://www.aldiwan.net/poem35819.html","الطويل"],[270,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[270,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[271,"تعلقت بالاسباب دون مدبري","https://www.aldiwan.net/poem52080.html","الطويل"],[275,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[280,"أحتى إلى العلياء يا خطب تطمح","https://www.aldiwan.net/poem60783.html","الطويل"],[298,"أيصبر متبول الفؤاد كثيب","https://www.aldiwan.net/poem36324.html","عموديه"],[305,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[313,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[353,"توسلت للرحمن أدعو بعبده","https://www.aldiwan.net/poem40820.html","الطويل"],[366,"أفيكم لهذا الحسن بالله منكر","https://www.aldiwan.net/poem17004.html","الطويل"],[371,"غنني يا أعز ذا الخلق عندي","https://www.aldiwan.net/poem56940.html","الخفيف"],[377,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[377,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[380,"غلام كما سال في خده","https://www.aldiwan.net/poem48794.html","المتقارب"],[402,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[416,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[416,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[441,"تصاممت عن قذع السفيه حفيظة","https://www.aldiwan.net/poem14394.html","الطويل"],[443,"تقول غدا هل تدري ما يلد الغد","https://www.aldiwan.net/poem55970.html","عموديه"],[449,"ربيع العمر","https://www.aldiwan.net/poem1014.html",""],[464,"قفي فاسمعي محض النُّهى يا ابنة الفهم","https://www.aldiwan.net/poem3280.html","عموديه"],[513,"أراعك برق في دجى الليل لامع","https://www.aldiwan.net/poem67731.html","الطويل"],[515,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[515,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[515,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"]],"verses":[["فَيا واقِفاً دونَ الَّذي تَستَحِقُّهُ","لَوَ أَنَّكَ جُزتُ الشَمسَ لَم تَجُزِ القَدرا",0,"ر",2,0],["فَيا وَيحَ نَفسي لا أَرى الدَّهرَ مَنزِلاً","لِعَلوَةَ إِلّا ظَلَّتِ العَينُ تَذرِفُ",1,"ف",1,0],["فَيا وَيحَ نَفسي إِن تَمادى الَّذي بِها","مِنَ الحُبِّ لا تبلى وَلا يَتَصَرَّمُ",2,"م",1,0],["فَيا وَيحَ مَن كَلِفَت نَفسُهُ","بِمَن لا يُطيقُ إِلَيهِ سَبيلا",3,"ل",2,0],["فَيا واثِقاً مِنّي بِما قَد بَدا لَهُ","وَأَكثَرُ مِنهُ ما أُجِنُّ وَأُضمِرُ",4,"ر",1,0],["فَيا وَيحَ قَلبِكَ ماذا أَلَح","حَ عَلَيهِ مِنَ الداءِ حَتّى اِنفَطَر",5,"ر",1,0],["فَيا وَيلَنا إِن لَم تَسُدّوا مَكانَهُ","بِذي مِرَّةٍ في الخَطبِ لا يَتَضَعضَعُ",6,"ع",1,0],["فَيا وَيحَ لِلشورى إِذا جَدَّ جِدُّها","وَطاشَت بِها الآراءُ مُشتَجِراتِ",7,"ت",1,0],["فَيا وَيلَ القَناةِ إِذا اِحتَواها","بَنو التاميزِ وَاِنحَسَرَ اللِثامُ",8,"م",1,0],["فَيا وَيلَ مِصرٍ يَومَ تَشقى بِنَدوَةٍ","يَبيتُ بِها ذاكَ الغَريبُ مُسَوَّدا",9,"د",2,0],["فَيا وَيحَكُم أَبلى وَتَبلى مَحاسِني","وَمِنكُم وَإِن عَزَّ الدَواءُ أَساتي",10,"ي",1,0],["فَيا وَليدي كُن غَداً شاعِراً","وَاِبدَأ بِهَجوِ الوالِدِ الآمِرِ",11,"ر",1,1],["فَيا وَفدَ النَدى عودوا خِفافَ ال","حَقائِبِ لا تَليدَ وَلا طَريفُ",12,"ف",1,0],["فيا وارث الأنصار لا عن كلالةٍ","تراثَ جلال يستخفُّ الرواسيا",13,"ي",2,0],["فيا وفد مصر أنتم خير شاهد","على يقظة في الشرق وارية الزند",14,"د",1,0],["فيا ويل قوم في العراق قد انطَوَوْا","على الذُل إذ أمست قلوبهم غُلفْا",15,"ف",2,0],["فيا ولدي تولد حزن قلبٍ","فعمّ أصول بيتك والفروعا",16,"ع",2,0],["فيا ويح مولاك استغاث بمشربٍ","فأشرقَ واستشفى شفاءً فأمْرضا",17,"ض",2,0],["فَيا وَيحَ هَذا الشَرقِ كَيفَ اِغتِباطُهُ","وَأَمضى مَواضيهِ كَليلُ الأَظافِرِ",18,"ر",1,0],["فَيا وَيحَ قَلبي بِالغَرامِ أَطَعتُهُ","فَما لي أَراهُ في السُلُوِّ عَصاني",19,"ي",1,0],["فَيا وَيحَ نَفسي حَسب نَفسي الَّذي بِها","وَيا وَيحَ أَهلي ما أُصيبَ بِهِ أَهلي",20,"ي",1,0],["فَيا وَيحَهُم هَل أَحَسّوا الحَيا","ةَ لَقَد لَعِبوا وَهيَ لَم تَلعَبِ",21,"ب",1,0],["فَيا وَيحَ الحَوادِثِ كَيفَ تُعطي","شَقِيَّ القَومِ مِن حَظِّ السَعيدِ",22,"د",1,0],["فيا وَلَعَ العواذلِ خَلِّ عنّي","ويا كَفَّ الغَرامِ خُذي عِناني",23,"ي",1,0],["فيا وحشتي من سوءِ ما قدّمَتْ يدي","إذا لم يكنْ في القبر من رحمةٍ أُنْسي",24,"س",2,0],["فَيا وَحشَةَ الدُنيا وَكانَت أَنيسَةً","وَوَحدَةَ مَن فيها لِمَصرَعِ واحِدِ",25,"د",1,0],["فَيا وَشَلَ الدُنيا بِشَيبانَ لا تَغِض","وَيا كَوكَبَ الدُنيا بِشَيبانَ لا تَخبُ",26,"ب",1,0],["في أَوانٍ مِنَ الرَبيعِ كَريمٍ","وَزَمانٍ مِنَ الخَريفِ حَسيبِ",27,"ب",1,0],["فَيا وَيحَ قَلبي ما يَستَفي","قُ مِن ذِكرِ هِندٍ وَما أَن يُفيقا",28,"ق",2,1],["فيا وطناً وهبتُ له شبابي","وما رَعَتِ المُروءةُ من مَشيبي",29,"ب",2,0],["فَيا وَطَنَ السُلوانِ وَالعِشقِ غُربَةً","أَلا عَودَةً بِاللَهِ في ذَلِكَ الوَطَن",30,"ن",1,0],["فَيا وَيلي عَلى إِعرا","ضِ حَمدانَ الخُراساني",31,"ي",1,0],["فَيا واهاً لَهُ وَاللَهِ","هِ وَجهاً حينَ شَبَّهتُه",32,"ت",2,0],["فيا وقعةً أنستْ وقيعةَ راهطٍ","ويا عزمةً من دونِها البطنُ والنَّطحُ",33,"ح",1,0],["فَيا ويح قوم فوضوا أَمر نفسهم","إلى ملك عن فعله ليس يسأل",34,"ل",1,0],["فيا ويح قلبيض ماذا جنى","ليحمل هذا الأسى والضنى",35,"ن",2,0],["فيا وَطَني إنْ فاتَني بكَ سابِقٌ","من الدهرِ فليَنْعِمْ لساكِنِك البال",36,"ل",1,0],["فِي أَوْجُهِ الخَيرِ شَيَّدْتُمْ مَعَاهِدَكُمْ","بِمَا عَلَى الخَيْرِ مِنْ أَمْوَالِكُمْ وَقَفَا",37,"ف",2,0],["فَيَا وَلِيَّ العَهْدِ فِي دَوْلَة","مَكْلُؤَةٍ بِالمُصْحَفِ المُنْزَلِ",38,"ل",1,0],["فيا وطنيّة لا غشّ فيها","وكم وطنية جعلَت شباكا",39,"ك",2,0],["فَيا وارِثي عِلمِ النَبِيِّ وَآلِهِ","عَلَيكُم سَلامٌ دائِمُ النَفَحاتِ",40,"ت",1,0],["فَيَا وَيْحَ للصدرِ الرّحيبِ الّذي غدا","بمُزْدَحِمِ الآلامِ غيرَ رَحيب",41,"ب",1,0],["في أول كانون الثاني","أو في الثاني من ديسمبر",42,"ر",1,0],["فيا واها له والله","وجهاً حين شبَّهته",43,"ت",2,0],["فيا وطناً تناهبتِ الرزايا","حُشاشتَه وأقلقتِ المهادا",44,"د",2,0],["فيا وطناً جَفَوْهُ وهو راضٍ","وعقَّته بنوه وهو بَرّ",45,"ر",1,0],["فيا وطني من النكبات فَأمَنْ","فقد وَفََّّتكَ حظَّك والنصابا",46,"ب",2,0],["فيا وطني ومن ذكراك روحي","إذا ما الروحُ أحرجها السياق",47,"ق",1,0],["فيا وطني إن لم يحن رد فائت","عليك فان الدهر ماض وراجع",48,"ع",1,0],["فيا وحشي من سوء ما قدّمتْ يدي","إذا لم يكنْ في القبر من رحمة ٍ أنسْي",49,"س",2,0],["فَيَا وَيْحَ قَلْبِكَ، ما يَسْتَفِي","ذكرِ هندٍ، وما انْ يفيقا",50,"ق",2,1],["فيا وَيْحَ قَلْبٍ ما تَزَالُ سماؤُهُ","بهالِشَيَاطِينِ الخُطوبِ مَقاعِدُ",51,"د",1,0],["في اويقات سكرة واصطلام","خلت اوقاتها من الاعياد",52,"د",1,0],["فياوسنا اقصى الاماني وفرسخ","يقربه نحو المنايا وفرسخ",53,"خ",1,0],["فيا ويح للإنسان يحيا وينقضي","كأن لم تورثه الحياة رؤوم",54,"م",1,0],["فيا ويح شبان تخوض غمارها","ويا ويل شبان عن الموت أحجموا",55,"م",3,0],["فَيا وَيحَ نَفسي مِن غُرورٍ وَخَيبَةٍ","غُبِنتُ حُظوظي مِن زيارَةِ طَيبَةٍ",56,"ه",1,0],["فَيا وَيحَنا وَالمَرءُ يُقضى بِذَنبِهِ","رَجَونا مَواتاةَ اللَيالي بِقُربِهِ",57,"ه",1,0],["في أَوانٍ صافٍ وَجَوٍّ صَقِيلٍ","وَزَمانٍ رَطْبٍ وَدَهْرٍ رَشِيقِ",58,"ق",1,0],["فيا والي عذابي كنت أولى","بعفوك إذ قدرت وليس ذنب",59,"ب",1,0],["فيا ويل مغرور بعفة حصنه","وقد أضمر الحصن الخيانة والغدرا",60,"ر",2,0],["فيا ويل أم من عركته منهم","وقد دارت رحى الحرب الطحون",61,"ن",1,0],["فيا ويح قوم أبصروا سنن الهدى","لديهم بعين التافهات الحقائر",62,"ر",1,0],["فَيا واشِيَيْ عفرا دَعاني وَنَظْرةً","تَقَرُّ بِها عَيْنايَ ثمَّ دَعاني",63,"ي",1,0],["في أولِ القوم شمسُ الحسن يحملها","قَدٌّ يَميس بمثلِ الغصن فانْتَفضا",64,"ض",2,0],["فيا واحدَ الفضلِ الذي العلمُ قُوتُه","وأهلوه مشتاقون شُمٌّ وذُوّاق",65,"ق",1,0],["فيا ويح قلبي ماله حن كلما","تراءى له شبه انتسام على ثغر",66,"ر",1,0],["فيا ويلتي هَبني غُلِبتُ على المنى","برغمي فمالي قد غُلِبتُ على عقلي",67,"ي",1,0],["فيا ورد أمتعنا بطيبٍ وبهجةٍ","فأنت لتشبيه الحبيب حبيبُ",68,"ب",1,0],["فيا واحد الدنيا ومن نور فرقه","ازال الدجا عنا وابدى لنا الفجرا",69,"ر",2,0],["فيا واحد العليا ويا من نواله","يحلى به جيد الزمان وعاطله",70,"ل",2,0],["فيا واحد العليا لنحوك في الندى","جعلت التفاتي لا لزيد ولا عمرو",71,"ر",2,0],["فيا واحداً عزّ البيان بفضله","على طول ما لاقى البيان من الهجر",72,"ر",1,0],["فيا ويلاهُ من حبٍّ","حملت بلاءهُ وحدى",73,"د",2,0],["فيا ويح قلبي عضّه الدهر فاكتوى","بلفحة قتّالين جورٍ وإصباء",74,"ا",2,0],["فيا ويحهم يزمعون الرحيل","وما زوّدني سواء الشجن",75,"ن",1,0],["فيا ويحهم يزمعون الرحيل","وما زوّدوني سواء الشجن",76,"ن",1,0],["فيا واحد الدنيا مثناك لم يرد","وجمع العلى يقضي بأنك مفرد",77,"د",1,0],["في أوانٍ قد أينع الوَرْدُ فيه","بِافْترارٍ من نَوْرِه وابتسامِ",78,"م",1,0],["فيا واحدَ الأملاك طرّاً وما عسى","أُحَصِّله من نظم فضلك في الشعر",79,"ر",1,0],["في أوانٍ هو الشتاء فأمسى","بلهيب الأنفاس وهوْ هجير",80,"ر",1,0],["فَيَا وَهْمُ مَا أَدْجَاكَ فِي أَعْيُنِ الْوَرَى","وَيَا نُورُ مَا أَجْلَى سُطُوعَكَ إِذْ أَوْرَى",81,"ر",2,0],["فيا وَغدُ قلي لي هل سُعودٌ بِغَيره","فنفرحَ أو سعىٌ لديكَ حميدُ",82,"د",1,0],["فيا ويح ما أوحى غرورُك والهوى","إليك بنكس العهد يا ناقض العهد",83,"د",1,0],["فيا وَحشَةَ المنفى ويا ظُلمةَ الثَّرى","وراءَكما نورٌ يَلوحُ لراقب",84,"ب",1,0],["فيا ويل من ولَّى الأجانبَ أمرَهُ","وقوَّادهم حَوليه والوزراء",85,"ا",2,0],["فَيا واسع اللطف الخَفي تولني","بلطفك واشرح سيدي بالرضا صَدري",86,"ي",1,0],["فَيَا وَهْيَ أسْبَابِ السَّبَاسِبِ كُلَّمَا","أذِيقُوا الرَّدَى قَبْضاً وَسِيقُوا لَهُ قَبْصا",87,"ص",2,0],["فَيا وَيْحَ إِخْوانِ الصَّفاءِ مِنَ الأَسَى","إِذا ما اسْتَرَدَّ الدَّهْرُ ما كانَ يَمْنَحُ",88,"ح",1,0],["فيا وَقفةً ما كان أعظم رَوْعَها","يكاد لها قلبُ الجمادِ يذوب",89,"ب",1,0],["فَيا وَيحَها من عصبةٍ قد تهافَتَت","عَلى نارِ بغيٍ ما سواها وقودها",90,"د",3,0],["فيا ويح نفس آثرت طيب زائل","على طيب باق لا يحد بمدة",91,"ه",1,0],["فَيا وَيحَ راجٍ قامَ في باب واهِب","إِذا لَم تبلّغهُ الوَسيلة مَطلَبا",92,"ب",2,0],["فَيا وَيلَتي مِن بُعدِ ما لا أَذُمُّهُ","وَيا ضَيعَتي في قُربِ ما لَيسَ يُشكَرُ",93,"ر",1,0],["في أوانِ الشَّبابِ عاجَلَني الشَّيبُ","فَهذا من أول الدنِّ دُردي",94,"د",2,0],["فيا وافداً يبغي اشتراكاً بأهله","عليك به إن رمتَ أجرَ المُشارك",95,"ك",1,0],["فيا وارداً من خلِّه سُؤرَ موردٍ","أجاجٍ وماءُ المكر ينهلُّ ساكبه",96,"ب",2,0],["فَيا وَيح قَلبيَ مِن حُبِهِ","وَيا وَيحَ نَفسيَ مِن صَدِهِ",97,"د",2,0],["فيا وريحَ قلْبي ما أشدّ خضوعهُ","لدَيهِ وما أقساهُ قلباً وأجفاهُ",98,"ه",1,0],["فيا ويحَ قلْبي ما أشدّ خضوعهُ","لدَيهِ وما أقساهُ قلباَ وأجفاهُ",98,"ه",1,0],["فيا ويحَ نفسي ضاع عمري ولم أفُزْ","بِحُرٍّ ولا أبْصَرْتُ خِلاًّ مهذبا",99,"ب",2,0],["فيأوي من يُضام إلى علاه","ويعصِمُه من الضَّيم الإِباء",100,"ا",2,0],["فيا وحشتا من لي من الناس مصطفى","فقد أوحضتني عصبة اصطفيها",101,"ي",3,0],["فيا ويح قلبي كم يحن لهجرة","إلى جنة عنها يجنبني السعد",102,"د",1,0],["فيا ويلي لقد أتعبت ركبي","وصحبي والإقامة والرحيلا",103,"ل",2,0],["فيا واهب العلياء مهلاً فإنني","أردت جزاءَ المدح فامتنع الكلم",104,"م",1,0],["فيا ويك لا تسرع إلى البين أنه","هو الموت فاحظر غب ما أنت صانع",105,"ع",1,0],["فيا واصل الأرزاق كيف تركتني","أمد إلى نيل المنى كف أقطع",106,"ع",1,0],["فيا ولدي ويا كبدي تيقن","بأن أباك مغلوب اليقين",107,"ن",1,0],["فيا ويلي ويا حربي","ويا همي ويا حزني",108,"ي",1,0]]}