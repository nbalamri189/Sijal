.html","الطويل"],[378,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[381,"غلام كما سال في خده","https://www.aldiwan.net/poem48794.html","المتقارب"],[403,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[417,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[417,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[442,"تصاممت عن قذع السفيه حفيظة","https://www.aldiwan.net/poem14394.html","الطويل"],[444,"تقول غدا هل تدري ما يلد الغد","https://www.aldiwan.net/poem55970.html","عموديه"],[450,"ربيع العمر","https://www.aldiwan.net/poem1014.html",""],[465,"قفي فاسمعي محض النُّهى يا ابنة الفهم","https://www.aldiwan.net/poem3280.html","عموديه"],[514,"أراعك برق في دجى الليل لامع","https://www.aldiwan.net/poem67731.html","الطويل"],[516,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[516,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[516,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"]],"verses":[["فيا ويح صب إن تهتك بالهوى","تزيا بعين العرف ما لا يناسبه",0,"ب",2,0],["فَيا واقِفاً دونَ الَّذي تَستَحِقُّهُ","لَوَ أَنَّكَ جُزتُ الشَمسَ لَم تَجُزِ القَدرا",1,"ر",2,0],["فَيا وَيحَ نَفسي لا أَرى الدَّهرَ مَنزِلاً","لِعَلوَةَ إِلّا ظَلَّتِ العَينُ تَذرِفُ",2,"ف",1,0],["فَيا وَيحَ نَفسي إِن تَمادى الَّذي بِها","مِنَ الحُبِّ لا تبلى وَلا يَتَصَرَّمُ",3,"م",1,0],["فَيا وَيحَ مَن كَلِفَت نَفسُهُ","بِمَن لا يُطيقُ إِلَيهِ سَبيلا",4,"ل",2,0],["فَيا واثِقاً مِنّي بِما قَد بَدا لَهُ","وَأَكثَرُ مِنهُ ما أُجِنُّ وَأُضمِرُ",5,"ر",1,0],["فَيا وَيحَ قَلبِكَ ماذا أَلَح","حَ عَلَيهِ مِنَ الداءِ حَتّى اِنفَطَر",6,"ر",1,0],["فَيا وَيلَنا إِن لَم تَسُدّوا مَكانَهُ","بِذي مِرَّةٍ في الخَطبِ لا يَتَضَعضَعُ",7,"ع",1,0],["فَيا وَيحَ لِلشورى إِذا جَدَّ جِدُّها","وَطاشَت بِها الآراءُ مُشتَجِراتِ",8,"ت",1,0],["فَيا وَيلَ القَناةِ إِذا اِحتَواها","بَنو التاميزِ وَاِنحَسَرَ اللِثامُ",9,"م",1,0],["فَيا وَيلَ مِصرٍ يَومَ تَشقى بِنَدوَةٍ","يَبيتُ بِها ذاكَ الغَريبُ مُسَوَّدا",10,"د",2,0],["فَيا وَيحَكُم أَبلى وَتَبلى مَحاسِني","وَمِنكُم وَإِن عَزَّ الدَواءُ أَساتي",11,"ت",2,0],["فَيا وَليدي كُن غَداً شاعِراً","وَاِبدَأ بِهَجوِ الوالِدِ الآمِرِ",12,"ر",1,1],["فَيا وَفدَ النَدى عودوا خِفافَ ال","حَقائِبِ لا تَليدَ وَلا طَريفُ",13,"ف",1,0],["فيا وارث الأنصار لا عن كلالةٍ","تراثَ جلال يستخفُّ الرواسيا",14,"ي",2,0],["فيا وفد مصر أنتم خير شاهد","على يقظة في الشرق وارية الزند",15,"د",1,0],["فيا ويل قوم في العراق قد انطَوَوْا","على الذُل إذ أمست قلوبهم غُلفْا",16,"ف",2,0],["فيا ولدي تولد حزن قلبٍ","فعمّ أصول بيتك والفروعا",17,"ع",2,0],["فيا ويح مولاك استغاث بمشربٍ","فأشرقَ واستشفى شفاءً فأمْرضا",18,"ض",2,0],["فَيا وَيحَ هَذا الشَرقِ كَيفَ اِغتِباطُهُ","وَأَمضى مَواضيهِ كَليلُ الأَظافِرِ",19,"ر",1,0],["فَيا وَيحَ قَلبي بِالغَرامِ أَطَعتُهُ","فَما لي أَراهُ في السُلُوِّ عَصاني",20,"ن",2,0],["فَيا وَيحَ نَفسي حَسب نَفسي الَّذي بِها","وَيا وَيحَ أَهلي ما أُصيبَ بِهِ أَهلي",21,"ل",2,0],["فَيا وَيحَهُم هَل أَحَسّوا الحَيا","ةَ لَقَد لَعِبوا وَهيَ لَم تَلعَبِ",22,"ب",1,0],["فَيا وَيحَ الحَوادِثِ كَيفَ تُعطي","شَقِيَّ القَومِ مِن حَظِّ السَعيدِ",23,"د",1,0],["فيا وَلَعَ العواذلِ خَلِّ عنّي","ويا كَفَّ الغَرامِ خُذي عِناني",24,"ن",2,0],["فيا وحشتي من سوءِ ما قدّمَتْ يدي","إذا لم يكنْ في القبر من رحمةٍ أُنْسي",25,"س",2,0],["فَيا وَحشَةَ الدُنيا وَكانَت أَنيسَةً","وَوَحدَةَ مَن فيها لِمَصرَعِ واحِدِ",26,"د",1,0],["فَيا وَشَلَ الدُنيا بِشَيبانَ لا تَغِض","وَيا كَوكَبَ الدُنيا بِشَيبانَ لا تَخبُ",27,"ب",1,0],["في أَوانٍ مِنَ الرَبيعِ كَريمٍ","وَزَمانٍ مِنَ الخَريفِ حَسيبِ",28,"ب",1,0],["فَيا وَيحَ قَلبي ما يَستَفي","قُ مِن ذِكرِ هِندٍ وَما أَن يُفيقا",29,"ق",2,1],["فيا وطناً وهبتُ له شبابي","وما رَعَتِ المُروءةُ من مَشيبي",30,"ب",2,0],["فَيا وَطَنَ السُلوانِ وَالعِشقِ غُربَةً","أَلا عَودَةً بِاللَهِ في ذَلِكَ الوَطَن",31,"ن",1,0],["فَيا وَيلي عَلى إِعرا","ضِ حَمدانَ الخُراساني",32,"ن",2,0],["فَيا واهاً لَهُ وَاللَهِ","هِ وَجهاً حينَ شَبَّهتُه",33,"ت",2,0],["فيا وقعةً أنستْ وقيعةَ راهطٍ","ويا عزمةً من دونِها البطنُ والنَّطحُ",34,"ح",1,0],["فَيا ويح قوم فوضوا أَمر نفسهم","إلى ملك عن فعله ليس يسأل",35,"ل",1,0],["فيا ويح قلبيض ماذا جنى","ليحمل هذا الأسى والضنى",36,"ن",2,0],["فيا وَطَني إنْ فاتَني بكَ سابِقٌ","من الدهرِ فليَنْعِمْ لساكِنِك البال",37,"ل",1,0],["فِي أَوْجُهِ الخَيرِ شَيَّدْتُمْ مَعَاهِدَكُمْ","بِمَا عَلَى الخَيْرِ مِنْ أَمْوَالِكُمْ وَقَفَا",38,"ف",2,0],["فَيَا وَلِيَّ العَهْدِ فِي دَوْلَة","مَكْلُؤَةٍ بِالمُصْحَفِ المُنْزَلِ",39,"ل",1,0],["فيا وطنيّة لا غشّ فيها","وكم وطنية جعلَت شباكا",40,"ك",2,0],["فَيا وارِثي عِلمِ النَبِيِّ وَآلِهِ","عَلَيكُم سَلامٌ دائِمُ النَفَحاتِ",41,"ت",1,0],["فَيَا وَيْحَ للصدرِ الرّحيبِ الّذي غدا","بمُزْدَحِمِ الآلامِ غيرَ رَحيب",42,"ب",1,0],["في أول كانون الثاني","أو في الثاني من ديسمبر",43,"ر",1,0],["فيا واها له والله","وجهاً حين شبَّهته",44,"ت",2,0],["فيا وطناً تناهبتِ الرزايا","حُشاشتَه وأقلقتِ المهادا",45,"د",2,0],["فيا وطناً جَفَوْهُ وهو راضٍ","وعقَّته بنوه وهو بَرّ",46,"ر",1,0],["فيا وطني من النكبات فَأمَنْ","فقد وَفََّّتكَ حظَّك والنصابا",47,"ب",2,0],["فيا وطني ومن ذكراك روحي","إذا ما الروحُ أحرجها السياق",48,"ق",1,0],["فيا وطني إن لم يحن رد فائت","عليك فان الدهر ماض وراجع",49,"ع",1,0],["فيا وحشي من سوء ما قدّمتْ يدي","إذا لم يكنْ في القبر من رحمة ٍ أنسْي",50,"س",2,0],["فَيَا وَيْحَ قَلْبِكَ، ما يَسْتَفِي","ذكرِ هندٍ، وما انْ يفيقا",51,"ق",2,1],["فيا وَيْحَ قَلْبٍ ما تَزَالُ سماؤُهُ","بهالِشَيَاطِينِ الخُطوبِ مَقاعِدُ",52,"د",1,0],["في اويقات سكرة واصطلام","خلت اوقاتها من الاعياد",53,"د",1,0],["فياوسنا اقصى الاماني وفرسخ","يقربه نحو المنايا وفرسخ",54,"خ",1,0],["فيا ويح للإنسان يحيا وينقضي","كأن لم تورثه الحياة رؤوم",55,"م",1,0],["فيا ويح شبان تخوض غمارها","ويا ويل شبان عن الموت أحجموا",56,"م",3,0],["فَيا وَيحَ نَفسي مِن غُرورٍ وَخَيبَةٍ","غُبِنتُ حُظوظي مِن زيارَةِ طَيبَةٍ",57,"ه",1,0],["فَيا وَيحَنا وَالمَرءُ يُقضى بِذَنبِهِ","رَجَونا مَواتاةَ اللَيالي بِقُربِهِ",58,"ه",1,0],["في أَوانٍ صافٍ وَجَوٍّ صَقِيلٍ","وَزَمانٍ رَطْبٍ وَدَهْرٍ رَشِيقِ",59,"ق",1,0],["فيا والي عذابي كنت أولى","بعفوك إذ قدرت وليس ذنب",60,"ب",1,0],["فيا ويل مغرور بعفة حصنه","وقد أضمر الحصن الخيانة والغدرا",61,"ر",2,0],["فيا ويل أم من عركته منهم","وقد دارت رحى الحرب الطحون",62,"ن",1,0],["فيا ويح قوم أبصروا سنن الهدى","لديهم بعين التافهات الحقائر",63,"ر",1,0],["فَيا واشِيَيْ عفرا دَعاني وَنَظْرةً","تَقَرُّ بِها عَيْنايَ ثمَّ دَعاني",64,"ن",2,0],["في أولِ القوم شمسُ الحسن يحملها","قَدٌّ يَميس بمثلِ الغصن فانْتَفضا",65,"ض",2,0],["فيا واحدَ الفضلِ الذي العلمُ قُوتُه","وأهلوه مشتاقون شُمٌّ وذُوّاق",66,"ق",1,0],["فيا ويح قلبي ماله حن كلما","تراءى له شبه انتسام على ثغر",67,"ر",1,0],["فيا ويلتي هَبني غُلِبتُ على المنى","برغمي فمالي قد غُلِبتُ على عقلي",68,"ل",2,0],["فيا ورد أمتعنا بطيبٍ وبهجةٍ","فأنت لتشبيه الحبيب حبيبُ",69,"ب",1,0],["فيا واحد الدنيا ومن نور فرقه","ازال الدجا عنا وابدى لنا الفجرا",70,"ر",2,0],["فيا واحد العليا ويا من نواله","يحلى به جيد الزمان وعاطله",71,"ل",2,0],["فيا واحد العليا لنحوك في الندى","جعلت التفاتي لا لزيد ولا عمرو",72,"ر",2,0],["فيا واحداً عزّ البيان بفضله","على طول ما لاقى البيان من الهجر",73,"ر",1,0],["فيا ويلاهُ من حبٍّ","حملت بلاءهُ وحدى",74,"د",2,0],["فيا ويح قلبي عضّه الدهر فاكتوى","بلفحة قتّالين جورٍ وإصباء",75,"ا",2,0],["فيا ويحهم يزمعون الرحيل","وما زوّدني سواء الشجن",76,"ن",1,0],["فيا ويحهم يزمعون الرحيل","وما زوّدوني سواء الشجن",77,"ن",1,0],["فيا واحد الدنيا مثناك لم يرد","وجمع العلى يقضي بأنك مفرد",78,"د",1,0],["في أوانٍ قد أينع الوَرْدُ فيه","بِافْترارٍ من نَوْرِه وابتسامِ",79,"م",1,0],["فيا واحدَ الأملاك طرّاً وما عسى","أُحَصِّله من نظم فضلك في الشعر",80,"ر",1,0],["في أوانٍ هو الشتاء فأمسى","بلهيب الأنفاس وهوْ هجير",81,"ر",1,0],["فَيَا وَهْمُ مَا أَدْجَاكَ فِي أَعْيُنِ الْوَرَى","وَيَا نُورُ مَا أَجْلَى سُطُوعَكَ إِذْ أَوْرَى",82,"ر",2,0],["فيا وَغدُ قلي لي هل سُعودٌ بِغَيره","فنفرحَ أو سعىٌ لديكَ حميدُ",83,"د",1,0],["فيا ويح ما أوحى غرورُك والهوى","إليك بنكس العهد يا ناقض العهد",84,"د",1,0],["فيا وَحشَةَ المنفى ويا ظُلمةَ الثَّرى","وراءَكما نورٌ يَلوحُ لراقب",85,"ب",1,0],["فيا ويل من ولَّى الأجانبَ أمرَهُ","وقوَّادهم حَوليه والوزراء",86,"ا",2,0],["فَيا واسع اللطف الخَفي تولني","بلطفك واشرح سيدي بالرضا صَدري",87,"ر",2,0],["فَيَا وَهْيَ أسْبَابِ السَّبَاسِبِ كُلَّمَا","أذِيقُوا الرَّدَى قَبْضاً وَسِيقُوا لَهُ قَبْصا",88,"ص",2,0],["فَيا وَيْحَ إِخْوانِ الصَّفاءِ مِنَ الأَسَى","إِذا ما اسْتَرَدَّ الدَّهْرُ ما كانَ يَمْنَحُ",89,"ح",1,0],["فيا وَقفةً ما كان أعظم رَوْعَها","يكاد لها قلبُ الجمادِ يذوب",90,"ب",1,0],["فَيا وَيحَها من عصبةٍ قد تهافَتَت","عَلى نارِ بغيٍ ما سواها وقودها",91,"د",3,0],["فيا ويح نفس آثرت طيب زائل","على طيب باق لا يحد بمدة",92,"ه",1,0],["فَيا وَيحَ راجٍ قامَ في باب واهِب","إِذا لَم تبلّغهُ الوَسيلة مَطلَبا",93,"ب",2,0],["فَيا وَيلَتي مِن بُعدِ ما لا أَذُمُّهُ","وَيا ضَيعَتي في قُربِ ما لَيسَ يُشكَرُ",94,"ر",1,0],["في أوانِ الشَّبابِ عاجَلَني الشَّيبُ","فَهذا من أول الدنِّ دُردي",95,"د",2,0],["فيا وافداً يبغي اشتراكاً بأهله","عليك به إن رمتَ أجرَ المُشارك",96,"ك",1,0],["فيا وارداً من خلِّه سُؤرَ موردٍ","أجاجٍ وماءُ المكر ينهلُّ ساكبه",97,"ب",2,0],["فَيا وَيح قَلبيَ مِن حُبِهِ","وَيا وَيحَ نَفسيَ مِن صَدِهِ",98,"د",2,0],["فيا وريحَ قلْبي ما أشدّ خضوعهُ","لدَيهِ وما أقساهُ قلباً وأجفاهُ",99,"ه",1,0],["فيا ويحَ قلْبي ما أشدّ خضوعهُ","لدَيهِ وما أقساهُ قلباَ وأجفاهُ",99,"ه",1,0],["فيا ويحَ نفسي ضاع عمري ولم أفُزْ","بِحُرٍّ ولا أبْصَرْتُ خِلاًّ مهذبا",100,"ب",2,0],["فيأوي من يُضام إلى علاه","ويعصِمُه من الضَّيم الإِباء",101,"ا",2,0],["فيا وحشتا من لي من الناس مصطفى","فقد أوحضتني عصبة اصطفيها",102,"ي",3,0],["فيا ويح قلبي كم يحن لهجرة","إلى جنة عنها يجنبني السعد",103,"د",1,0],["فيا ويلي لقد أتعبت ركبي","وصحبي والإقامة والرحيلا",104,"ل",2,0],["فيا واهب العلياء مهلاً فإنني","أردت جزاءَ المدح فامتنع الكلم",105,"م",1,0],["فيا ويك لا تسرع إلى البين أنه","هو الموت فاحظر غب ما أنت صانع",106,"ع",1,0],["فيا واصل الأرزاق كيف تركتني","أمد إلى نيل المنى كف أقطع",107,"ع",1,0],["فيا ولدي ويا كبدي تيقن","بأن أباك مغلوب اليقين",108,"ن",1,0],["فيا ويلي ويا حربي","ويا همي ويا حزني",109,"ن",2,0]]}