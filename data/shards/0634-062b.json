{"poems":[[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[287,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83266","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89519","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103417","البسيط"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27114","الكامل"]],"verses":[["شَثَّ شعَبُ الحَيِّ التِئام","وَشَجاكَ الرَبعُ رَبعُ المُقام",0,"م",1,1],["شَثنُ البَراثِنِ قالِصاً عَن نابِهِ","دامي الأَظافِرِ واثِباً لا يُمهِلُ",1,"ل",1,0],["شَثِنٌ كَفٌّ لَكِن أَيديهِ الشَث","نَةَ بِالجودِ سَبطَةً سَمحاءُ",2,"ا",2,0],["شَثْنُ القفا عَبْلُه مُضَبَّرُه","ممكورُه ضخمُه مُلزَّزه",3,"ز",2,0],["شَثنُ البَراثِنِ لا تَعدو فَرائِسُهُ","صَيدَ المُلوكِ وَإِلّا تُخرَبُ الدارُ",4,"ر",1,0],["شَثنِ السُلامى رَحيبِ المنخرين إذا","أراح مِن غَيرِ بُهرٍ خِلتَهُ ارتاحا",5,"ح",2,0],["شُثنٌ براثِنُهُ كَأَنَّ نُيوبَهُ","زُرقُ المَعابِلِ أَو شَذاةُ زِجاجِ",6,"ج",1,0]]}