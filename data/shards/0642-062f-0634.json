,"الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"أكلة الثريد","https://www.poetsgate.com/ViewPoem.aspx?id=179172",""],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[105,"داء أهل الشرق ضعف الهمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54849&r=&rc=19",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["قَد شِبتُ مِن كَمَدٍ عَلَيكِ وَإِنَّني","لمُوَرِّقٌ غُصني حَديثٌ مَولِدي",0,"ي",1,0],["قَد شَكَّ فيما جاءَهُ","مِنَ الوُشاةِ الكُذَّبِ",1,"ب",1,0],["قَد شَقينا وَنَحنُ كَرَّمَنا اللَ","هُ بِعَصرٍ يُكَرِّمُ الأَنعاما",2,"م",2,0],["قَد شَهِدنا بِالأَمسِ في مِصرَ عُرساً","مَلَأَ العَينَ وَالفُؤادَ اِبتِهارا",3,"ر",2,0],["قَد شَيَّدوا آيَةً بِالشامِ خالِدَةً","شَتّى المَناهِلِ تَروي كُلَّ ظَمآنِ",4,"ن",1,0],["قَد شُغِلنا يا سَعدُ عَن كُلِّ شَيءٍ","وَشُغِلنا بِأَن يَتُمَّ شِفاكا",5,"ك",2,0],["قَد شاهَدا فيهِ تَحتَ النَقعِ عَنتَرَةً","يُصارِعُ المَوتَ عَن عَبسٍ وَذُبيانِ",6,"ن",1,0],["قَد شاقَها الإِغبابُ حَتّى إِنَّها","لَو تَستَطيعُ سَرَت إِلَيكَ خَيالا",7,"ل",2,0],["قَدْ شَمِمْنَا لِحُبِّ طِيبَةَ فِيهِ","نَفْحَ طِيبٍ أَذْكَى الحَمِيَّةِ فِينَا",8,"ن",2,0],["قَد شَفَّني عَطَشي وَأَقلَقَني الَّذي","أَنا فيهِ مِن ثِقَلِ الحَديدِ المُجهِدِ",9,"د",1,0],["قد شربت السهاد فيه مداماً","وتخذت النجوم فيه ندامى",10,"م",2,0],["قد شيد للأيتام مأوىً واقياً","يهتمّ بالأيتام فيه ويعتني",11,"ن",2,0],["قد شهدناه ليلة جعلتنا","نحمد الدهر غافرين الذنوبا",12,"ب",2,0],["قد شرّفت بقعة الجيليّ حفرته","كما ضريح علي شرّف النجفا",13,"ف",2,0],["قَد شانَ فَخرَ مُجاشِعٍ أَن لَم تَكُن","عِندَ الحَقائِقِ تُدرِكُ الأَوتارا",14,"ر",2,0],["قَد شَفَّني رَوعَةُ العَبّاسِ مِن فَزَعٍ","لَمّا أَتاهُ بِدَيرِ القَسطَلِ الخَبَرُ",15,"ر",1,0],["قد شدَّ عقداً عالياً أو بنى","قنطرةً في الحالِ ثمَّ انْفسخ",16,"خ",1,0],["قَد شابَ بِالتَدليسِ أَسرارُهُ","يَقولُ في حَيرَتِهِ هَل هو",17,"و",1,0],["قد شَفَّه حرصُه وحالفَهُ","طول عناءٍ وحسرةٍ وَصَبُهْ",18,"ب",2,0],["قد شتونا فكم نُصَي","يِّفُ طال التصيُّف",19,"ف",1,0],["قَد شَوَّشَت كَفُّ النَهارِ سَكينَتي","يا هَذِهِ رُدّي إِلَيَّ مَسائي",20,"ي",1,0],["قَد شَفى مَرآكَ مُقلَتُهُ","مِن عَمىً وَالأُذنَ مِن صَمَمِ",21,"م",1,0],["قَد شَكَرتُ اللَهَ في","ما كانَ مِنكُم وَحَمِدتُهُ",22,"ت",2,0],["قد شيعته رجال الحكم قاطبة","وشيعته نواقيس ورهبان",23,"ن",1,0],["قد شب يغذوه الشعو","ر فاستوى منه القصب",24,"ب",1,0],["قد شاء عقلي بعد تفكير","وطول تأمل",25,"ل",1,0],["قد شاء ربك ان تطو","ل يد العتاة وان تشدّا",26,"د",2,0],["قد شجاني من نأى وجهك عني","أن وجه الوداد باقٍ جميل",27,"ل",1,0],["قَد شَغَلَ الناسَ كَثرَةُ الأَمَلِ","وَأَنتَ بِالمَكرُماتِ في شُغُلِ",28,"ل",1,1],["قَد شَرَّفَ اللَهُ أَرضاً أَنتَ ساكِنُها","وَشَرَّفَ الناسَ إِذ سَوّاكَ إِنسانا",29,"ن",2,0],["قَد شامَ بَرقاً مِن نَداكَ أَحَبَّهُ","إِذ كانَ بَرقُ يَدَيكَ لَيسَ بِخُلَّبِ",30,"ب",1,0],["قَد شَكَونا إِلَيكَ شَكوى شَكاها","عامُ مَحلٍ إِلى الغَمامِ جَدوبُ",31,"ب",1,0],["قَد شَكَرتُم نُعماهُ بِالأَمسِ حَتّى","لَعُدِدتُم بِشُكرِهِ مُنعِمينا",32,"ن",2,0],["قَد شابَ رَأسي وَرَأسُ الحِرصِ لَم يَشِبِ","إِنَّ الحَريصَ عَلى الدُنيا لَفي تَعَبِ",33,"ب",1,1],["قَد شَهِدنا فِعلَ البِلى بِمَغاني","كِ وَدَمعُ الغُيومِ فيكِ سِجامُ",34,"م",1,0],["قَد شَرَحتُ المَبسوطَ مِن قِصرِ عُذري","فَاِعتَبِرهُ مِن رَأيِكَ الكَشّافِ",35,"ف",1,0],["قَد شابَ شِعري وَشَعري في مَديحِكُمُ","وَدُوِّنَت بِمَعاني نَظمِيَ الكُتُبُ",36,"ب",1,0],["قَد شاهَدوا مِن قَبلِ ذاكَ تَرَفُّعي","عَن حَربِهِم وَتَماسُكي وَتَجَمُّلي",37,"ي",1,0],["قد شريناه عزيزاً غالياً","إن تكن بعت فإني لن أبيعا",38,"ع",2,0],["قَد شَمَّروا عَن سوقِهِم في ساعَةٍ","أَمَرَت إِزارَ الحَربِ بِالإِسبالِ",39,"ل",1,0],["قَد شَرَّدَ الصُبحُ هَذا اللَيلَ عَن أُفُقِه","وَسَوَّغَ الدَهرُ ما قَد كانَ مِن شَرَقِه",40,"ق",2,1],["قَد شَدَّ أَطنابَها فَاِستَحكَمَت وَرَسَت","بِالأَرضِ لَكِنَّها قامَت بِلا دِعَمِ",41,"م",1,0],["قدْ شاعَ بينَ النساِ أني نشؤُهُ","وليَ الفخارُ بأنَّهُ أنشاني",42,"ي",1,0],["قدْ شَرَّفَ اللهُ مصراً أنتَ ساكنُهُ","وزادَ بكَ الكتابَ والكُتُبا",43,"ب",2,0],["قدْ شينَ مَنْ بالشينِ منطقُهُ","في عينِ راءٍ ذالِهِ كافي",44,"ي",1,1],["قَد شُطَّ في الزُبرِ فَاِطلُبوا بِدَمي","مَن لَم يُقِدني يَوماً وَلَم يَدني",45,"ي",1,0],["قَد شَفَينا النُفوسَ إِن كانَ يَشفي","مِن هَواها عِناقُها وَاِعتِناقي",46,"ي",1,0],["قَد شَبَّ في وَجهِهِ شُعاعٌ","وَشَبَّ عَن قَلبِهِ اِلتِهابا",47,"ب",2,0],["قَد شابَ مِن طَرَفِ المَجَرَّةِ مَفرِقٌ","فيها وَمِن خَطِّ الهِلالِ عِذارُ",48,"ر",1,0],["قَد شَجاني وَشَجاهُ أنَّهُ","بسوى أيديكمُ لم يُهدَمِ",49,"م",1,0],["قَد شِمتُ بَهجَتَها مُوَلِّيَةً عَلى","حَرفٍ كَما زارَ النَسيبُ مُعَذِّرا",50,"ر",2,0],["قد شهدنا لعهدكم بالعدالهْ","وختمنا لجندكم بالبسالَهْ",51,"ل",2,1],["قد شيّعوه إلى قبر يحفّ به","مِن المهابة اتباعٌ واشياعٌ",52,"ع",1,0],["قَد شَغَلتِ الهَوى بِطولِ التَجَنّي","كُلَّ يَومٍ يَؤُمُّ قَلبي اِعتِذارا",53,"ر",2,0],["قَد شَكا الوَعدُ مِنكِ حَبساً طَويلاً","فَاِحلِلي عَنهُ يا شُرَيرَ الصِفادا",54,"د",2,0],["قد شرّفَ اللّهُ الوَرَى بزَمانِهِ","حتى الكَواكبُ والوَرَى سِيّانِ",55,"ن",1,0],["قَد شَهِدتُ العيدَ فَاِستَسمَجتُهُ","ذاكَ أَن لَم تَكُ فيمَن شَهِدا",56,"د",2,0],["قَد شَرَّدَت أَموالَهُ فَضِحاتُهُ","وَمَقالُهُ لِنَديمِهِ هاتِ اِنشُدِ",57,"د",1,0],["قَد شَقَقتُ اللَيلَ عَنها","بِبَناتِ الريحِ شَقّا",58,"ق",2,0],["قَد شَفَّها التَأويبُ وَالتَهجيرُ","وَالوَخذُ حينَ اِحتَرَقَ الهَجيرُ",59,"ر",1,0],["قَد شَبَّهَ المالَ أَوغادٌ بِرَبِّهِمُ","وَأَوضَعَ الفَقرُ قَوماً بَعدَ تَسويدِ",60,"د",1,0],["قَد شابَ رَأسُكَ في تَذَكُّرِها","وَهَفا الفِراقُ وَرَقَّتِ الكَبِدُ",61,"د",1,0],["قَد شَبِعنا مِن وُدِّكِ المُرِّ طَعماً","وَرَوينا إِن كُنتِ مِنّا رَويتِ",62,"ت",1,0],["قَد شَكَكنا فيما عَهِدتِ إِلَينا","وَظَمِئنا فَوَجِّهينا لِشِربِ",63,"ب",1,0],["قَد شَفَّني الشَوقُ إِلى وَجهِها","وَشاقَني المَزهَرُ وَالقاصِبُ",64,"ب",1,0],["قَد شَفَّني حَزَنٌ ضاقَ الفُؤادُ بِهِ","وَسَرَّني زائِرٌ في النَومِ مُنتابا",65,"ب",2,0],["قَد شُيِّدَ القَصرُ لِسُكّانِهِ","وَغَيرُ مَن يَسكُنُهُ الشائِدُ",66,"د",1,0],["قَد شابَ رَأسي وَمِن نَبتِ الثَرى جَسَدي","فَالنَبتُ آخِرُ ما يَعتو بِهِ الزَهَرُ",67,"ر",1,1],["قَد شَرِبتُ المِياهَ بِالخَزَفِ الوَخ","شِ غَنيٌّ عَن مُحكَماتٍ بِجَرشِ",68,"ش",1,0],["قد شجاهُ هوى اقتحامِ الصحارى","والصحارى مثارةُ الصَّبواتِ",69,"ت",1,0],["قَدْ شَفَّنِي طُولُ وَجْدِي","وَالْحُبُّ دَاءٌ يَشُفُّ",70,"ف",1,0],["قَدْ شَاكَلَتْهَا فَهْيَ تَأْلَفُهَا","وَالْجِنْسُ يَأْلَفُ صُحْبَةَ الْجِنْسِ",71,"س",1,0],["قَدْ شتَّتَ الضَّغْنُ المُفَرِّقُ بَيْنَكُمْ","شَمْلاً كأَمْتَنِ مَا يَكُونُ جَمِيعَا",72,"ع",2,1],["قَدْ شَارَفَتْكَ فَلَطَّفَتْ بِتَبَسُّمٍ","عَذْبٍ مَرَارَةُ دَمْعِكَ المُتَسَاكِب",73,"ب",1,0],["قَد شُفيتَ مِنهُ وَلَم","تُشفَ عَن صُغَيِّرِها",74,"ر",3,0],["قد شُغِلْنا عن حافظٍ بأمير الشع","ر ويلي لو كان يدري لحاني",75,"ي",1,0],["قد شرَّدُوا العُرْبَ واستاقُوا حرائِرَهُمْ","فأينَ فِتيانُنا أيْنَ المحامُونا",76,"ن",2,0],["قد شهرنا في الرَّوع عَضبًا صقيلاً","وادَّخرنا سواه؛ لا عن كلال",77,"ل",1,0],["قد شهدت الإنسان ينتطحُ السُّح","بَ، ويَأوى رُفاته الهرمان",78,"ن",1,0],["قد شفينا غلّة في صدره","وعطشنا، فانظروا ماذا سقانا",79,"ن",2,0],["قد شكوناكِ لا لذمٍّ ولكن","ليس يخلو الغرامُ إلا لشاكي",80,"ك",2,0],["قد شَغَلْنا افكارَنا بقديمٍ","وَنَسِينا تقديرَ جيلٍ جديد",81,"د",1,0],["قد شفى مرآك مقتله","من عمى ، والأذن من صمم",82,"م",1,0],["قد شجاني وشجاه أنه","بسوى أيديكمو لم يهدم",83,"م",1,0],["قَدْ شَفَيْتُ الْغَلِيلَ مِنْ آلِ بَكْرٍ","ألِ شيبانَ بينَ عمًّ وَ خالِ",84,"ل",1,0]]}