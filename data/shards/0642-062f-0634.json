net/poem34214.html","الخفيف"],[562,"قد شاد هذا البرج يوسف عصره","https://www.aldiwan.net/poem52673.html","الكامل"],[562,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[562,"في ساحة الحي من تيماء غزلان","https://www.aldiwan.net/poem52848.html","البسيط"],[562,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[562,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[562,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[567,"يا أبا الفضل يا أمير الظراف","https://www.aldiwan.net/poem69594.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[575,"قد شاب شارب من أحب فجاز لي","https://www.aldiwan.net/poem2870.html","الكامل"],[575,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"],[575,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[587,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"]],"verses":[["قَد شِبتُ مِن كَمَدٍ عَلَيكِ وَإِنَّني","لمُوَرِّقٌ غُصني حَديثٌ مَولِدي",0,"ي",1,0],["قَد شَكَّ فيما جاءَهُ","مِنَ الوُشاةِ الكُذَّبِ",1,"ب",1,0],["قَد شَقينا وَنَحنُ كَرَّمَنا اللَ","هُ بِعَصرٍ يُكَرِّمُ الأَنعاما",2,"م",2,0],["قَد شَهِدنا بِالأَمسِ في مِصرَ عُرساً","مَلَأَ العَينَ وَالفُؤادَ اِبتِهارا",3,"ر",2,0],["قَد شَيَّدوا آيَةً بِالشامِ خالِدَةً","شَتّى المَناهِلِ تَروي كُلَّ ظَمآنِ",4,"ن",1,0],["قَد شُغِلنا يا سَعدُ عَن كُلِّ شَيءٍ","وَشُغِلنا بِأَن يَتُمَّ شِفاكا",5,"ك",2,0],["قَد شاهَدا فيهِ تَحتَ النَقعِ عَنتَرَةً","يُصارِعُ المَوتَ عَن عَبسٍ وَذُبيانِ",6,"ن",1,0],["قَد شاقَها الإِغبابُ حَتّى إِنَّها","لَو تَستَطيعُ سَرَت إِلَيكَ خَيالا",7,"ل",2,0],["قَدْ شَمِمْنَا لِحُبِّ طِيبَةَ فِيهِ","نَفْحَ طِيبٍ أَذْكَى الحَمِيَّةِ فِينَا",8,"ن",2,0],["قَد شَفَّني عَطَشي وَأَقلَقَني الَّذي","أَنا فيهِ مِن ثِقَلِ الحَديدِ المُجهِدِ",9,"د",1,0],["قد شربت السهاد فيه مداماً","وتخذت النجوم فيه ندامى",10,"م",2,0],["قد شيد للأيتام مأوىً واقياً","يهتمّ بالأيتام فيه ويعتني",11,"ن",2,0],["قد شهدناه ليلة جعلتنا","نحمد الدهر غافرين الذنوبا",12,"ب",2,0],["قد شرّفت بقعة الجيليّ حفرته","كما ضريح علي شرّف النجفا",13,"ف",2,0],["قَد شانَ فَخرَ مُجاشِعٍ أَن لَم تَكُن","عِندَ الحَقائِقِ تُدرِكُ الأَوتارا",14,"ر",2,0],["قَد شَفَّني رَوعَةُ العَبّاسِ مِن فَزَعٍ","لَمّا أَتاهُ بِدَيرِ القَسطَلِ الخَبَرُ",15,"ر",1,0],["قد شدَّ عقداً عالياً أو بنى","قنطرةً في الحالِ ثمَّ انْفسخ",16,"خ",1,0],["قَد شابَ بِالتَدليسِ أَسرارُهُ","يَقولُ في حَيرَتِهِ هَل هو",17,"و",1,0],["قد شَفَّه حرصُه وحالفَهُ","طول عناءٍ وحسرةٍ وَصَبُهْ",18,"ب",2,0],["قد شتونا فكم نُصَي","يِّفُ طال التصيُّف",19,"ف",1,0],["قَد شَوَّشَت كَفُّ النَهارِ سَكينَتي","يا هَذِهِ رُدّي إِلَيَّ مَسائي",20,"ي",1,0],["قَد شَفى مَرآكَ مُقلَتُهُ","مِن عَمىً وَالأُذنَ مِن صَمَمِ",21,"م",1,0],["قَد شَكَرتُ اللَهَ في","ما كانَ مِنكُم وَحَمِدتُهُ",22,"ت",2,0],["قد شيعته رجال الحكم قاطبة","وشيعته نواقيس ورهبان",23,"ن",1,0],["قد شب يغذوه الشعو","ر فاستوى منه القصب",24,"ب",1,0],["قد شاء عقلي بعد تفكير","وطول تأمل",25,"ل",1,0],["قد شاء ربك ان تطو","ل يد العتاة وان تشدّا",26,"د",2,0],["قد شجاني من نأى وجهك عني","أن وجه الوداد باقٍ جميل",27,"ل",1,0],["قَد شَغَلَ الناسَ كَثرَةُ الأَمَلِ","وَأَنتَ بِالمَكرُماتِ في شُغُلِ",28,"ل",1,1],["قَد شَرَّفَ اللَهُ أَرضاً أَنتَ ساكِنُها","وَشَرَّفَ الناسَ إِذ سَوّاكَ إِنسانا",29,"ن",2,0],["قَد شامَ بَرقاً مِن نَداكَ أَحَبَّهُ","إِذ كانَ بَرقُ يَدَيكَ لَيسَ بِخُلَّبِ",30,"ب",1,0],["قَد شَكَونا إِلَيكَ شَكوى شَكاها","عامُ مَحلٍ إِلى الغَمامِ جَدوبُ",31,"ب",1,0],["قَد شَكَرتُم نُعماهُ بِالأَمسِ حَتّى","لَعُدِدتُم بِشُكرِهِ مُنعِمينا",32,"ن",2,0],["قَد شابَ رَأسي وَرَأسُ الحِرصِ لَم يَشِبِ","إِنَّ الحَريصَ عَلى الدُنيا لَفي تَعَبِ",33,"ب",1,1],["قَد شَهِدنا فِعلَ البِلى بِمَغاني","كِ وَدَمعُ الغُيومِ فيكِ سِجامُ",34,"م",1,0],["قَد شَرَحتُ المَبسوطَ مِن قِصرِ عُذري","فَاِعتَبِرهُ مِن رَأيِكَ الكَشّافِ",35,"ف",1,0],["قَد شابَ شِعري وَشَعري في مَديحِكُمُ","وَدُوِّنَت بِمَعاني نَظمِيَ الكُتُبُ",36,"ب",1,0],["قَد شاهَدوا مِن قَبلِ ذاكَ تَرَفُّعي","عَن حَربِهِم وَتَماسُكي وَتَجَمُّلي",37,"ي",1,0],["قد شريناه عزيزاً غالياً","إن تكن بعت فإني لن أبيعا",38,"ع",2,0],["قَد شَمَّروا عَن سوقِهِم في ساعَةٍ","أَمَرَت إِزارَ الحَربِ بِالإِسبالِ",39,"ل",1,0],["قَد شَرَّدَ الصُبحُ هَذا اللَيلَ عَن أُفُقِه","وَسَوَّغَ الدَهرُ ما قَد كانَ مِن شَرَقِه",40,"ق",2,1],["قَد شَدَّ أَطنابَها فَاِستَحكَمَت وَرَسَت","بِالأَرضِ لَكِنَّها قامَت بِلا دِعَمِ",41,"م",1,0],["قدْ شاعَ بينَ النساِ أني نشؤُهُ","وليَ الفخارُ بأنَّهُ أنشاني",42,"ي",1,0],["قدْ شَرَّفَ اللهُ مصراً أنتَ ساكنُهُ","وزادَ بكَ الكتابَ والكُتُبا",43,"ب",2,0],["قدْ شينَ مَنْ بالشينِ منطقُهُ","في عينِ راءٍ ذالِهِ كافي",44,"ي",1,1],["قَد شُطَّ في الزُبرِ فَاِطلُبوا بِدَمي","مَن لَم يُقِدني يَوماً وَلَم يَدني",45,"ي",1,0],["قَد شَفَينا النُفوسَ إِن كانَ يَشفي","مِن هَواها عِناقُها وَاِعتِناقي",46,"ي",1,0],["قَد شَبَّ في وَجهِهِ شُعاعٌ","وَشَبَّ عَن قَلبِهِ اِلتِهابا",47,"ب",2,0],["قَد شابَ مِن طَرَفِ المَجَرَّةِ مَفرِقٌ","فيها وَمِن خَطِّ الهِلالِ عِذارُ",48,"ر",1,0],["قَد شَجاني وَشَجاهُ أنَّهُ","بسوى أيديكمُ لم يُهدَمِ",49,"م",1,0],["قَد شِمتُ بَهجَتَها مُوَلِّيَةً عَلى","حَرفٍ كَما زارَ النَسيبُ مُعَذِّرا",50,"ر",2,0],["قد شهدنا لعهدكم بالعدالهْ","وختمنا لجندكم بالبسالَهْ",51,"ل",2,1],["قد شيّعوه إلى قبر يحفّ به","مِن المهابة اتباعٌ واشياعٌ",52,"ع",1,0],["قَد شَغَلتِ الهَوى بِطولِ التَجَنّي","كُلَّ يَومٍ يَؤُمُّ قَلبي اِعتِذارا",53,"ر",2,0],["قَد شَكا الوَعدُ مِنكِ حَبساً طَويلاً","فَاِحلِلي عَنهُ يا شُرَيرَ الصِفادا",54,"د",2,0],["قد شرّفَ اللّهُ الوَرَى بزَمانِهِ","حتى الكَواكبُ والوَرَى سِيّانِ",55,"ن",1,0],["قَد شَهِدتُ العيدَ فَاِستَسمَجتُهُ","ذاكَ أَن لَم تَكُ فيمَن شَهِدا",56,"د",2,0],["قَد شَرَّدَت أَموالَهُ فَضِحاتُهُ","وَمَقالُهُ لِنَديمِهِ هاتِ اِنشُدِ",57,"د",1,0],["قَد شَقَقتُ اللَيلَ عَنها","بِبَناتِ الريحِ شَقّا",58,"ق",2,0],["قَد شَفَّها التَأويبُ وَالتَهجيرُ","وَالوَخذُ حينَ اِحتَرَقَ 