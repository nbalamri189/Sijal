{"poems":[[55,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[95,"باليمن قد آنست يا سيدي","https://www.aldiwan.net/poem11391.html","السريع"],[74,"قال العذول فزاد قلبا شيقا","https://www.aldiwan.net/poem19352.html","الكامل"],[53,"لي طيلسان إن يبده زمانه","https://www.aldiwan.net/poem66439.html","الطويل"],[93,"بات والكأس في الظلام","https://www.aldiwan.net/poem62746.html","عموديه"],[40,"وما مزنة جادت فأسبل ودقها","https://www.aldiwan.net/poem7709.html","الطويل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[63,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[76,"ترى يوسفا في ثوبه حسن صورة","https://www.aldiwan.net/poem13257.html","الطويل"],[76,"أهزك لا إني إخالك نابيا","https://www.aldiwan.net/poem13276.html","الطويل"],[78,"بليت عظامك والأسى يتجدد","https://www.aldiwan.net/poem39452.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[119,"لله من روح تدلى سرها","https://www.aldiwan.net/poem40471.html","عموديه"],[208,"عيد الأمير على الزمان أمير","https://www.aldiwan.net/poem53146.html","الكامل"],[286,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[287,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[354,"في ظله ظل من عن حده حادا","https://www.aldiwan.net/poem15601.html","البسيط"],[422,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[491,"أخلق الربع من سعاد فأمسى","https://www.aldiwan.net/poem457.html",""],[520,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138198",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138313",""],[615,"","https://poetry.dctabudhabi.ae/diwan/poem/34544","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48643","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48861","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119868","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216687",""],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124023","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21663","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80048","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108830","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125362","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46436","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26191","المنسرح"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134174","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134102","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134176","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140308",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89335","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89279","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91093","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117912","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135858","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90819","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54482","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72760","السريع"],[4755,"فِي البَالِ مَا لا يَنْحَكِيْ يَا (فِيْسُ)","https://www.poetsgate.com/ViewPoem.aspx?id=184672",""],[5543,"يا صاحبي كسدت أسواق أشواقي","https://www.poetsgate.com/ViewPoem.aspx?id=181706",""],[5739,"ساحر البطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127034",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[6008,"احترتُ بالحاير","https://www.poetsgate.com/ViewPoem.aspx?id=59158",""],[6038,"العيد الوطني للملكة 1422ه","https://www.poetsgate.com/ViewPoem.aspx?id=25699",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""],[6355,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66634&r=&rc=94",""]],"verses":[["بالي المَعالِمِ أَطرَقَت شَرَفاتُهُ","إِطراقَ مُنجِذِبِ القَرينَةِ عانِ",0,"ن",1,0],["بِاليُمْنِ قَدْ آنَسْتَ يَا سَيِّدِي","حَاضِرَةً أَوْحَشْتَهَا مُنْذُ عَامْ",1,"م",1,1],["بأليمهِ يا سيدي وأليمه","لا أستطيع بشكوها أن أنطقا",2,"ق",2,0],["بالٍ يُخلِّي للرياح سبيلها","عفواً فيسبِقُ وهيُه طيرانَهُ",3,"ن",2,0],["بِالئغاريدِ وَالبَلابِلِ","وَالنورِ وَالخُزام",4,"م",1,0],["بِأَليَنَ مَسّاً مِن سُعادَ لِلامِسٍ","وَأَحسَنَ مِنها حينَ تَبدو مُجَرَّدا",5,"د",2,0],["بِاليَتيمِ الأُمِّيِّ وَالبَشَرِ المو","حى إِلَيهِ العُلومُ وَالأَسماءُ",6,"ا",2,0],["باليُمْنِ ما رفعَ الأميرُ وشيَّدا","وبِجَدِّه النعماءُ ما قد جدَّدا",7,"د",2,1],["بِأَليَنَ أَعطافاً وَأَخشَنَ مَضرِباً","وَأَرهَبَ إِقداماً وَأَجدى تَخَذُّما",8,"م",2,0],["بِأَليَنَ أَعطافاً وَأَحسَنَ هَشَّةً","وَأعَطَرَ أَخلاقاً وَأَندى حَواشِيا",9,"ي",2,0],["بِاليَأسِ أَسْلو عَنْكَ لا بِتَجلُّدِي","هَيْهاتَ أَيْنَ مِنَ الحَزين تَجَلُّدُ",10,"د",1,0],["باليمن ألقى رحله في الخزرج","كأنه من أرضه لم يخرج",11,"ج",1,0],["بِالْيُمْنِ يَا غِرِّيدَةَ الْوَادِي","إلى الْوَادِي ارْجِعِي",12,"ع",2,0],["باليمن مولانا اعاد المرتضى","حسن الخصال ابن الحسين اخي الحسن",13,"ن",1,0],["باليمن والبركات ظَلتَ مُعَيِّداً","وظِلالُ عيدِك غبطةٌ وسرورُ",14,"ر",1,0],["باليمن وفداً يتصل","بالأمر غير المنفصل",15,"ل",1,0],["بِاليُمنِ حازَ مَمالِكَ اليَمَنِ الَّتي","سَمَقَت إِلى سَعدِ السُعودِ المُشتَري",16,"ر",2,0],["بِاليومِ من شهرٍ وأسبوعٍ وبالس","ساعاتِ ضبطُ مواسمِ الجذلانِ",17,"ن",1,0],["بالَيتُهُ في التيهِ وَلَهانٌ عَلى ظَمَأٍ","يَدعو إِلى الوَردِ مَن وافاهُ مُرتادا",18,"د",2,0],["باليد البيضاء كم أمطرنا","من غوادي جودها بيضاً وصُفرا",19,"ر",2,0],["باليتُ حيناً بسوء حظّي","ثمّ تألَّيتُ لا أبالي",20,"ل",2,0],["بالياً بَعدَ حاضِرِ ذي أَنيسٍ","مِن سُلَيمى إِذ تَغتَدي كَالمَهاةِ",21,"ه",1,0],["بالياسر المغني بأيسر جوده","والمقتني عز الزمان بأسره",22,"ر",2,0],["بالَيتُها بَذل وُسعي","لَكِنَّها لا تُبالي",23,"ل",2,0],["باليمن أقبل والإسعاد عاهلنا","يا مصرنا فرحايا قومنا طربا",24,"ب",2,0],["باليمن حل القطر فانشرحت به","للناس من فرط المسرة أنفس",25,"س",1,0],["بِاليَأسِ بَعدي فَاِقتَنِع","قُلتُ إِذا قَلَّ الغَنا",26,"ن",2,0],["بِأَليم عَذابٍ يقصدُهُ","وَهَوانِ هَوانٍ يَحصدُهُ",27,"ه",1,0],["باليمن ركبُك يغتدي ويروحُ","ويغيب محمودَ الثرى ويلوحُ",28,"ح",1,1],["باليمن في رمضان السمح تَشهده","والقول ما أولموا فيه وما أدبوا",29,"ب",3,0],["باليمن معضود وبالت","فيق منصور مؤيد",30,"د",1,0],["بالي بحبّك تاه دونك دليله","وآعلّن الخافق بمنظوم الاشعار",31,"ر",1,0],["بألينَ من سعدى عشيّةَ أقبَلَت","تهادي ثلاثاً كلُهُنَّ عروبُ",32,"ب",1,0],["باليُسرِ وَالعُسرِ وَالأَحداثُ مُعرِضَةٌ","لا بُدَّ مِن شِدَّةٍ فيها وَمِن لينِ",33,"ن",1,0],["باليمن فيها عقدا شراكة","لفتيةٍ مجموعها حظيُّها",34,"ي",3,0],["بآلي ومالي غادةً أحمديةً","تردُّ رسالاتي وترمي بها الرسلا",35,"ل",2,1],["باليُمنِ آبَ عَزيزُ مصرَ مبجلاً","يا طالما خفقت لهُ أعلامُ",36,"م",1,0],["بِاليُمن وَالاقبال وَالسَراء","وَسَعادَةٍ مَوصولَةٍ بِنَماء",37,"ا",2,0],["بِاليُمنِ وَالسَعدِ عُد وَبِالظُفرِ","مُوَفَّقَ الوِردِ غانِمُ الصَدَرِ",38,"ر",1,1],["باليمن عام سعيد لاح طالعه","لا زال في عزكم تأتي نظائره",39,"ه",1,1],["باليمن أضحى لك العيد السعيد ترى","نورا لطلعته في غرة العصر",40,"ر",1,1],["باليمن قد اقبل العام الجديد على","دوام عزك في كل المبرات",41,"ت",1,1],["بالياسمين وهذا منتهى قسمي","وكنت أقسم قبل اليوم بالتين",42,"ن",1,0],["باليمن أرخ جاء للنجارى","فتح الإله مصطفى سلامهْ",43,"م",2,0],["باليمن والعز والإقبال مزدوجا","من اتصال بعقد غير منفصل",44,"ل",1,0],["بِاليَأس وَالأَمل المغتال أَبصرها","تَحتَ الثَرى ثُم تَعلو فَرق كِيوان",45,"ن",1,0],["باليمن مقرون المدى وبنيه أق","مار السرى في أوج دائرة السعود",46,"د",1,0],["باليمن واليسر كف المصطفى وكفت","سيان في الجود يمناه ويسراه",47,"ا",2,0],["باليُمنِ واليُسر وعزّ بركاتْ","عفواً معافاةٍ كذاك عافياتْ",48,"ت",1,0],["بالياءِ والبسر بواو قد أَتى","وهكذا السويق فاعلم يا فتى",49,"ت",2,0],["بإليون قد خط القضاء أن من","دماء كلينا الأرض محمرةً تندى",50,"د",2,0],["باليد البيضاء أضحى ممسكي","إذ طغى فرعون حزني في الفؤاد",51,"د",1,0],["باليمن والإقبال جدد ارخوا","للناس سوقا قد تشيد في حما",52,"م",2,0],["باليُمنِ هذا الشّهرُ مشهورٌ كما","قد عمَّ بالبركاتِ هذا العامُ",53,"م",1,0],["باليمن والاقبال والعز وال","اجلال أرَّخت ببيت وجيز",54,"ز",1,1],["بَالِيْ نُشَارَةُ أحْرُفٍ مَطحُونَةٌ","فِي صَدْرِهَا , والشَّوقُ مَغنَاطِيسُ",55,"س",1,0],["باليت شعري هل سعد يساعدني","أم هل لداء الهوى من الناس من راق؟",56,"ق",1,0],["باليمين طويق واليسرى السراه.","والفكر فيض السحابه مزهبه.",57,"ب",2,0],["بالي عليكم دائماً مشغولُ","وجميعكُم بسَقامهِ مغلولُ",58,"ل",1,1],["باليل انا والقلم والتعابير","سهران حتى كوهفن النعايم",59,"م",1,0],["باليوم الأغر جيت للحكم جيت","ترسخ للعقيدة وسيف الحق تسله",60,"ل",2,0],["بالىغم من نفسوا الشَجية عنا لَها","يَنظر جمالا ما خَفاه لثام",61,"م",1,0],["بالياسمين تكونت آياتها","واستغرقت خلف البياض سفوحُ",62,"ح",1,0],["باليُمْنِ أقبلَ خَطْوُهُ الزُّهُرُ","وتشْرئبُّ إليه الأشهُرُ الأُخَرُ",63,"ر",1,1]]}