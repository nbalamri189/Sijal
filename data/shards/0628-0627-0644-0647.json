بِلادِي","https://www.poetsgate.com/ViewPoem.aspx?id=184731",""],[4791,"كبرياك","https://www.poetsgate.com/ViewPoem.aspx?id=37026",""],[4955,"عقوق أم","https://www.poetsgate.com/ViewPoem.aspx?id=192281",""],[5187,"بردى","https://www.poetsgate.com/ViewPoem.aspx?id=29702",""],[5198,"ليل داجي","https://www.poetsgate.com/ViewPoem.aspx?id=136228",""],[5376,"صنت نفسي من رميةٍ بسهامِ","https://www.poetsgate.com/ViewPoem.aspx?id=188313",""],[5461,"وداع يا نفس","https://www.poetsgate.com/ViewPoem.aspx?id=5040",""],[5573,"ياعين مالك بالسهر زود راحه","https://www.poetsgate.com/ViewPoem.aspx?id=200080",""],[5732,"ذابت الروح","https://www.poetsgate.com/ViewPoem.aspx?id=177904",""],[5732,"بالهرج يعطونك","https://www.poetsgate.com/ViewPoem.aspx?id=177914",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5956,"جاء الزكامُ يزيدنا تفريقا","https://www.poetsgate.com/ViewPoem.aspx?id=182425",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""]],"verses":[["بالهنا والسعود مقدمك الزا","ئد عمَّا تمنَّت الأغراض",0,"ض",1,0],["بِالهَيلِ مِن مَنفٍ وَمِن أَرباضِها","مَجدوعُ أَنفٍ في الرِمالِ كُفاري",1,"ر",2,0],["بِالهاشِمِيِّ الصالِحِيِّ المُكتَسي","مِن فَضلِ آصِرَةِ النَبِيِّ المُرسَلِ",2,"ل",1,0],["بِالهَمزِ مِن طولِ الثِقافِ وَجارُهُم","يُعطي الظُلامَةَ في الخُطوبِ الحُوَّسِ",3,"س",1,0],["بِالْهِجْرَة اتَّسَقَتْ لَهُمْ أَسْبَابُ مَا","أُوتُوهُ مِنْ نَقْضٍ وَمِنْ إِمْرَارِ",4,"ر",1,0],["بالهاشمي الذي نادت به الصحف","الأولى مبشرة في سالف العصر",5,"ر",1,0],["بالهوى من أنت يا مجهولة","دون أن ادعوها كانت مجيبه",6,"ب",2,0],["با (لهرواي) با (لسكاكين) .. بما","يجهل الشيطان من أخزى الحبل",7,"ل",1,0],["بِالهَدْيِ نُرْحَمُ.. نِعمةِ الرحمنِ","وَعْدٌ من الوهَّابِ في القرآنِ",8,"ن",1,1],["بالهولِ أركبُهُ بكلِّ دُجُنَّةٍ","والسيرِ أُعملُهُ بكلِّ يباب",9,"ب",1,0],["بالهوى قل لي متى يوما أفيق","من غرام هو كأسٌ من رحيق",10,"ق",1,0],["بالهُوتِ باللاهوت بالناسوتِ","بمعتلى سكينة التابوت",11,"ت",1,0],["بِالهِندِ قُبَّتُها وَفي أَتراكِها","بِئرٌ وَقَصرٌ في العَلاءِ مُشَيَّدُ",12,"د",1,0],["بالهُداةِ الأُمناء انتظمَتْ","حافَتاهُ والملوكِ العُظماء",13,"ا",2,0],["بالهادي البشير عليه صلى وسلم","الرب القدير ما حبر ذكر وعلم",14,"م",1,1],["بالهدى والتقى والنور مكبوس معمور","همه كله في الخير موقوف مقصور",15,"ر",1,0],["بِالهَوى هَامَ في الفَلاَ قيسُ ليلَى","وبه ماتَ عُروةٌ وجَميلُ",16,"ل",1,0],["بالهنا والسعود والمجد أرخ","لرشيد قد عاد دور الصداره",17,"ر",2,0],["بآله وصحبه العظام","ما حدا حاج بحمى الكرام",18,"م",1,0],["بآلِهِ الأَوصِياءِ الغُرِّ سادتِنا","أهلِ المَعارِجِ في المعَنَى ومن صَحِبَا",19,"ب",2,0],["بالهاء والواو به هويَّةٌ","في ملكوت واضح ومبهمِ",20,"م",1,0],["بالهمّ والغمّ والأحزان مشتملٌ","وَبالكآبة والأشجان والمحنِ",21,"ن",1,0],["بالهَنا والسرورِ والإقبالِ","شمس حسنٍ زفّت لبدر كمالِ",22,"ل",1,1],["بالهنا والسرور والسعد فُزنا","فهو عيدٌ مِن أعظمِ الأعيادِ",23,"د",1,0],["بالهلال الذي على أُفُق السو","ر يُرى دونَ سائر الآفاق",24,"ق",1,0],["بالهوى إن كنت ترعى","بيننا في الحب عهدا",25,"د",2,0],["بِالهَدْرِ تَكْشاشَ البِكارِ المُرَّغِ","لِلَّهِ دَرُّ المُحْدِثِينَ النُبَّغِ",26,"غ",1,0],["بالهندوانّيِ الصقيل الملتوي","أو بالثقيف المستوي الأقومِ",27,"م",1,0],["بالهمّة اشتمَلا بالعزمة انتعَلا","بالحدّة اتّشحا بالنجدة انتطقا",28,"ق",2,0],["بالهدى والندى يمير جمي","ع الخلق في دينها وفي دنياها",29,"ا",3,0],["بإله الناس قد عوّذته","في البرايا وبربّ الفلق",30,"ق",1,0],["بالهاشميِّ هدانا من ضَلالتنا","وَلَم يَكن ذينُه مني على بالي",31,"ل",2,0],["بآلةِ عهدٍ قلت فيه مصوّرٌ","لنا فيه والأرحام إذ قاله الله",32,"ل",2,0],["بالهوى فزتمُ وشاركتموني","في اسم حبيّ والشوقُ للغيابِ",33,"ب",1,0],["بالهزل لا بالجد جال القلم","وكل ذي لطفٍ بهذا العلم",34,"م",1,0],["بالهاشمي المصطفى خير الورى","وشفيعنا ذي الرحمة العظماء",35,"ا",2,0],["بالها كاسا فاشربها","ما به لغو ولا تأثيم",36,"م",1,0],["بالهون تصبح سامراء سامرها","يطارح الهمّ والأحزا والكدرا",37,"ر",2,0],["بالهمة القعساء قازوا","واجتنوا منها الثمر",38,"ر",1,0],["بالهند حيث العود والقرنفل","والمسك والكافور ثم الصندل",39,"ل",1,0],["بالهند ناءٍ أخي وجدٍ يَحِنُّ إلى","أوطانه وسهام البين ترشقه",40,"ق",2,0],["بالهضب من رمع والسهل من جرع","مأوى الطريد وغوث المجدب السغب",41,"ب",1,0],["بالهل ما خاب يوم القصد زائرهم","ولا اعتراه وحق الحق إذلال",42,"ل",1,0],["بالهاء أعطنا هدايةَ القُرَبْ","وارزق لنا بالواو وصلة الطلبْ",43,"ب",1,0],["بالهادي والمهدي والمقدّمِ","وبعزيزِ فاضلٍ لي قدِّمِ",44,"م",1,0],["بالهادي والمغني وبالقهارِ","يحبني بك جميع دارِ",45,"ر",1,0],["بِالهَوينا يَمشي وَيَختالُ في أَع","طافَه الهيف أَم لوى خَيزَرانَه",46,"ن",2,0],["بالهوى مثلي","بخمرِ الكوثر",47,"ر",1,0],["بِالهَجرِ رأت سفكَ دَمي مأخوذا","هَلّا بِغرار لَحظِها مَشحوذا",48,"ذ",2,1],["بِالهَزلِ تَشوبُ جَدَّها ظَمياءُ","إِذ مِنّيَ في فُؤادِها أَشياءُ",49,"ا",2,1],["بالهاشمي الشهم الأمير المرتجى","أبدا ليوم كريهة وسداد",50,"د",1,0],["بالهجر كلمت قلبي","داوي بوصل جراحه",51,"ح",2,0],["بالهند تُطبع أسيافُ الحديد وفي","بغداذَ تُطبع أسيافٌ من الحَدَقِ",52,"ق",1,1],["بالهنا غرفتهُ إذ كملت","بهجةً أرختها ذات العماد",53,"د",1,0],["بَالَهَ البَالْ.. لَيتِكْ يا بِلادِيْ بِلادِي","كُنتْ مِن عُشْبْ قَلبِي شَختَرِعْ لِكْ وِسَادَهْ",54,"د",2,1],["بَالَهَ البَالْ.. ليتِكْ رَقدَتِيْ مِن سُهَادِي","كُنتْ شَطرَحْ عيُونِي فَوقْ صَدْرِكْ قِلادَهْ",54,"د",2,0],["بَالَهَ البَالْ.. ليتِكْ تَحزَنِي لِاضطِهَادِي","كُنتْ حَرَّرْتْ صَدرِكْ مِن جُنُونْ البِيَادَهْ",54,"د",2,0],["بَالَهَ البَالْ.. ليتِكْ مَن يُفَكِّرْ بِزَادِي","كُنتْ شَفقِدْ حَيَاتِي لَو فَقَدْتِ السِّيَادَهْ",54,"د",2,0],["بَالَهَ البَالْ.. لكنْ مَن يحقِّقْ مُرَادِي","بَين حُلمِي وحُلمِك جَهلْ حامِل شهادهْ",54,"د",2,0],["بَالَهَ البَالْ.. بَالَهْ بَينْ صالِحْ وهادِي","وبَينْ صالِحْ وهادِي شَعبْ ضَيَّعْ بِلادَهْ",54,"د",2,0],["بالهوى معها على ذبحي دليل","قبر رأسي بالحشا معالمه",55,"م",2,0],["بالهجرِ قابلني والقهرُ قاربني","حتى هرمتُ من الأسقامِ والعللِ",56,"ل",1,0],["بالهمسِ يُفضي للصبايا حبَّهُ","ويضمّهنَّ برأفةِ وحَنَانِ",57,"ن",1,0],["بالهون ياللي ترمي الناس بالهون","تحذف عباد الله وبيتك زجاجي",58,"ج",2,1],["بالها مشغولٌ وقلبٌ شغوفٌ","لم تنمْ عينُها لنومِ الأنامِ",59,"م",1,0],["بالهون يا نزّاع روحي تراها","باقي عذاب أيام بيض(ن) على سود",60,"د",1,0],["بالهمس ظافر سامع السر صاحه","بالسان بُغض ولاهث بكيد نبّاح",61,"ح",1,0],["بالهوا يبو بندر وش ترا","منه قلبي على حامي لظاه",62,"ا",2,0],["بالهرج يعطونك رخيص المعاذير","عذر يفوت وثاني تابع له",63,"ل",2,0],["بالهوى ماهي غريبة نكبة عيال الحلال","ولاني أول من يصون ولا انتي آخر من يهين",64,"ن",1,0],["‏بالهجر داومتِ الضغوط على دمي","‏ ‏ وأَبَيتُ عمّن لا يكون لصيقا",65,"ق",2,0],["بالهمسة الملساء أخبرها الوفا","وبأنني رحب الجَنان حنون",66,"ن",1,0]]}