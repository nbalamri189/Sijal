{"poems":[[79,"برئت لله من حولي ومن حيلي","https://www.aldiwan.net/poem36340.html","البسيط"],[75,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[37,"ألمم بعزة إن الركب منطلق","https://www.aldiwan.net/poem39127.html","البسيط"],[95,"ملك العراق تجلة وسلام","https://www.aldiwan.net/poem11313.html","الكامل"],[29,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[87,"بات المعنى والدجى يبتلى","https://www.aldiwan.net/poem7887.html","السريع"],[87,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[47,"يا غاديا والثغر خلف مسائه","https://www.aldiwan.net/poem10200.html","الكامل"],[47,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[33,"ألمم بجور في الصفاح حسان","https://www.aldiwan.net/poem41303.html","الكامل"],[33,"ألمم بعفراء إن أصحابك ابتكروا","https://www.aldiwan.net/poem42541.html","البسيط"],[33,"ألمم بزينب إن البين قد أفدا","https://www.aldiwan.net/poem42567.html","البسيط"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[52,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[7,"ألمم برسم الطلل الأقدم","https://www.aldiwan.net/poem1939.html","السريع"],[48,"ألمم بدار النسك إلمامه","https://www.aldiwan.net/poem23358.html","السريع"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85427","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12821","السريع"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10282","البسيط"],[102,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[199,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[242,"ألمم بمكناسة فموردها","https://www.aldiwan.net/poem18187.html","المنسرح"],[370,"ألمم بسلمى قبل أن تظعنا","https://www.aldiwan.net/poem44476.html","السريع"],[463,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[484,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[520,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101979","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49918","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77852","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77809","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78019","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48216","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112300","المنسرح"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36738","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36739","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86448","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86373","الكامل"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141706","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4727,"ألمم على الطلل","https://www.poetsgate.com/ViewPoem.aspx?id=211740",""],[4729,"يَا خَليليَّ نِلتُما النعماءَ","https://www.poetsgate.com/ViewPoem.aspx?id=109430",""],[4750,"سلام عدة وبل مزن ٍ مراديف","https://www.poetsgate.com/ViewPoem.aspx?id=180429",""],[4849,"من يوم غبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53512",""],[5732,"ان دك به هاجوس","https://www.poetsgate.com/ViewPoem.aspx?id=177916",""],[6008,"مهداه إلى الإمير نواف بن فواز الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60802",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""],[2220,"ألممْ بمنزلِ أحبابٍ لهمْ ذممُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19316&r=&rc=858",""]],"verses":[["أَلْمَمْتُ بِالْعَتْبِ لَمْ أَحْذَرْ مَوَاقِعَهُ","أَنَا الْغَرِيقُ فَمَا خَوْفِي مِنَ الْبَلَلِ",0,"ل",1,0],["أَلمَمتُ بِالأَلطَفِ مِنهُ وَلَم","أَجنَح إِلى ما فيهِ بَعضُ الجُناح",1,"ح",1,0],["أَلمِم بِعَزَّةَ إنَّ الرَكبَ مُنطَلِقُ","وَإِن نَأتَكَ وَلَم يُلمِم بِها خَرَقُ",2,"ق",1,1],["أَلْمَمْتَ بِالأُمَمِ الَّتِي جَاوَرْتَهَا","خَيْرَ الجِوَارِ فَحَبَّذَ الإِلْمَامُ",3,"م",1,0],["أَلمِم عَلى الرَبعِ بِالتِرباعِ غَيَّرَهُ","ضَربُ الأَهاضيبِ وَالنَأآجَةُ العُصُفُ",4,"ف",1,0],["الممتطى متن السها عزة","فلو أشار الدهر لم ينزل",5,"ل",1,0],["المَماليكُ تَمَشّى ظُلمُهُم","ظُلُماتٍ كَدُجى اللَيلِ حِجابا",6,"ب",2,0],["أَلمِم بِساحَةِ يوسُفِ بنِ مُحَمَّدٍ","وَاِنظُر إِلى أَرضِ النَدى وَسَمائِهِ",7,"ا",3,0],["أَلمِم بِقَومٍ أَنتَ أَرضى عِندَهُم","وَأَجَدُّ مِن عَهدِ الرَبيعِ الأَزهَرِ",8,"ر",1,0],["أَلمِم بِجورٍ في الصِفاحِ حِسانِ","هَيَّجنَ مِنكَ رَوائِعَ الأَحزانِ",9,"ن",1,1],["أَلمِم بِعَفراءَ إِن أَصحابُكَ اِبتَكَروا","وَسَلهُمُ هَل لَدَيها اليَومَ مُنتَظَرُ",10,"ر",1,1],["أَلمِم بِزَينَبَ إِنَّ البَينَ قَد أَفِدا","قَلَّ الثَواءُ لَئِن كانَ الرَحيلُ غَدا",11,"د",2,1],["ألمِم بهِ تُلفِ رُوحَ البِشرِ في أحُدٍ","وَالعَدلَ فِي أسَدٍ وَالنَّاسَ فِي رَجُلِ",12,"ل",1,0],["أَلمِم بِعَبدَةَ قَبلَ حادِثَةٍ","فَهِيَ الشِفاءُ وَأَنتَ طالِبُهُ",13,"ب",2,0],["أَلمِم بِرَسمِ الطَلَلِ الأَقدَمِ","بِجانِبِ السَكرانِ فَالأَيهَمِ",14,"م",1,1],["أَلمِم بِدارِ النُسكِ إِلمامَه","فَالنَفسُ بِالباطِلِ هَمّامَه",15,"م",2,1],["المُمطِرينَ الأَرضَ عَدلاً كُلَّها","المُنبِتينَ بِها كِبارَ الأَنعُمِ",16,"م",1,0],["ألممت بالمستنصرية زائراً","أطلالها وَالجامِعاتُ تزارُ",17,"ر",1,1],["أَلمَمْتُ مِنْ شَوْقِي بِنَحُوٍ وَاحِدٍ","وَجَلاَلُهُ مُتَعَدِّدُ الأَنْحَاءِ",18,"ا",2,0],["أَلمِم بِفَوزٍ قَبلَ حينِ الرَحيل","وَاِشفِ بِتَوديعِكَ بَعضَ الغَليل",19,"ل",1,1],["أَلمِم بِجَوهَرَ بِالقُضبانِ وَالمَدَرِ","وَبِالعِصِيِّ الَّتي في روسِها عُجَرُ",20,"ر",1,1],["أَلمِم بِها لا لِتَسليمٍ وَلا مِقَةٍ","إِلّا لِيَكسِرَ مِنها أَنفَها الحَجَرُ",20,"ر",1,0],["أَلمِم بِوَطباءَ في أَشداقِها سَعَةٌ","في صورَةِ الكَلبِ إِلّا أَنَّها بَشَرُ",20,"ر",1,0],["الممرات، مغاراتٌ لها","وثبة الجنّ، وإجفال الظباءِ",21,"ا",2,0],["أَلمِم عَلى طَلَلٍ عَفا مُتَقادِمِ","بَينَ الذُؤَيبِ وَبَينَ غَيبِ الناعِمِ",22,"م",1,1],["أَلْمِمْ بِمَكْناسَةٍ فَمَوْرِدُهَا","أَحْلَى َموَارِدِنَا وَأَبْرَدِهَا",23,"د",3,1],["أَلمِم بِسلمى قبل أَن تَظعَنا","إِنَّ بنا من حُبِّها دَيدَنَا",24,"ن",2,1],["ألممتُ أستعدِي بلحدك من جوَى","قلبي فزاد صبابتي إلمامي",25,"م",2,0],["ألمم بها ففؤادي قد ألم به","ركب الشجون فكلي الآن أظعان",26,"ن",1,0],["ألمم بقطب الدين تعرف فضله","وعلى العيان تحيلك الأخبار",27,"ر",1,0],["الممتطي في سباق العلم سلهبة","من الجياد العتاق الضمر العرب",28,"ب",1,0],["الممطر","فلك المجد بك الدنيا ملك",29,"ك",1,0],["أْلمِمْ بيعرَبَ تُبصِرْ سيَّد العرَبِ","ومعدَن الجود في بُحبوحة الحَسَبِ",30,"ب",1,1],["أَلمم هديتَ بأَهل هَذا الدار","وانشر لهم أَوصاف تلك الدار",31,"ر",1,0],["أَلمم بنا يا بارقوشا","إِني أَنا أزمخشلوشا",32,"ش",2,1],["ألمم بهم ترشد وخذهم سادة","بل قادة فأولئك الأفلاك",33,"ك",1,0],["الممطرُ الجودَ ما لم تَهمِه ظُلَلٌ","من الغمام مفيضُ الوَدْقِ رُجَّاس",34,"س",1,0],["المُمتَطي الخَيلَ وهيَ سابِحَةٌ","في بحر حربٍ عُبابهُ اللّهب",35,"ب",1,0],["أَلمِم بِساعَةِ يَلبُغا مَهما اِنبَرَت","مِنكَ الهُمومُ وَمِل إِلى شُبّاكِهِ",36,"ك",2,1],["أَلمِم إِذا هَمٌّ غَزاكَ بِيلبُغا","وَاِعطف لِمَقصَفِهِ تَنَل ما يُبتَغى",37,"غ",2,1],["الممتطي للمجد كل طمرةٍ","أبداً تصرف كفه أرسانها",38,"ن",3,0],["الممتطي للمجد أرفع غارب","والمقتدي من عهده بوثيق",39,"ق",1,0],["ألمم على جدث حوى","تاج الملوك وقل سلامُ",40,"م",1,1],["أَلمِم بِرَبعِكَ غَيرَ مَأمورٍ فَقَد","غَصَّ الفناءُ بِأَرجُلِ القُصّادِ",41,"د",1,0],["ألمم على الطلل القديم بيثرب.","بينا وقوفا في سواد المغرب",42,"ب",1,1],["ألمما بالشاغورِ والمسجِدِ المعمُ","ورِ واستمطرا بهِ الأَنواءَ",43,"ا",2,0],["المملكه ما رد جيزان لي طريف","عاشت بخير الله بدي ثم خيره",44,"ر",2,0],["المملكة بديارها تبكيك يانور الديار","ما عاد باقي فى عيون الناس دمعٍ ينذرف",45,"ف",1,0],["المملكه عذرا تنور بالافلاك","حمى طهارتها ولا حد فتكها",46,"ك",3,0],["المملكه من دونها مصقلن حاف","فهد ملكنا يا ضلمت هو سفرها",47,"ر",3,0],["الممراتُ أعينٌ تَمتَطيني","والكُوى مخبرٌ وأشلاءُ رَجْعَةْ",48,"ع",2,0],["ألممْ بمنزلِ أحبابٍ لهمْ ذممُ،","سحَّتْ عليهمْ سحابٌ صوبها ديمُ",49,"م",1,1]]}