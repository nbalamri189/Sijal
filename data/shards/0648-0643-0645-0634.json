iewPoem.aspx?id=188695",""],[5001,"غُرْبةُ رُوْح","https://www.poetsgate.com/ViewPoem.aspx?id=176230",""],[5013,"ألا أيها القلب الذي قاده الحب","https://www.poetsgate.com/ViewPoem.aspx?id=170960",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5046,"من عاند الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=198513",""],[585,"يا ساحة المجد أين المعجب الصلف","https://www.poetsgate.com/ViewPoem.aspx?id=161925",""],[585,"يا جيرة البان مهلاً واسألوا البانا","https://www.poetsgate.com/ViewPoem.aspx?id=161926",""],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[585,"يا نازح الدار هل أحسست بالدار","https://www.poetsgate.com/ViewPoem.aspx?id=161940",""],[585,"يا أرض حسبك إرعاداً وإبراقاً","https://www.poetsgate.com/ViewPoem.aspx?id=161883",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5122,"((((( عيون الاخبار )))))","https://www.poetsgate.com/ViewPoem.aspx?id=37320",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[2365,"ألم تسألا بجنوب السلام","https://www.poetsgate.com/ViewPoem.aspx?id=200657",""],[308,"يَا حَافِظًا كم لرواياته","https://www.poetsgate.com/ViewPoem.aspx?id=189365",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[592,"معاني مبانيها الطوامح في العلا","https://www.poetsgate.com/ViewPoem.aspx?id=128851",""],[592,"أهاجك رسم بالديار الدوائر","https://www.poetsgate.com/ViewPoem.aspx?id=128849",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5408,"أبي...وعاد أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190865",""],[3294,"ليل يجيء ونهار يذهب","https://www.poetsgate.com/ViewPoem.aspx?id=173257",""],[5790,"إن فاض دمعي فقل أجفانه ذرفت","https://www.poetsgate.com/ViewPoem.aspx?id=112169",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5830,"صُبِّي كُؤُوسَ الهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=200762",""],[5849,"سمراءُ أم بيضاء ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=191276",""],[5873,"تصرّم الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=215353",""],[5878,"غاية القصد","https://www.poetsgate.com/ViewPoem.aspx?id=188326",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5969,"حِداداً على روحي","https://www.poetsgate.com/ViewPoem.aspx?id=198800",""],[6120,"يَحِنُّ قَلبِي لِأيَّامٍ مِنَ الغَزَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=213518",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[6186,"عادت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82885&r=&rc=5",""],[572,"لهُ شُغُلٌ عنْ سؤالِ الطّلَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9447&r=&rc=304",""]],"verses":[["وكمْ شَنَبٍ في ثغْرِهِ لم أُبَلْ بِهِ","ففي شَفَةِ الظَّلْماءِ منْ دُونِهِ لَمى",0,"م",2,0],["وكَم شَيّدَتْ أيّامُكُمْ مِن مَناقِبٍ","يُحَدِّثُ عَنها في مَجالِسِها فِهْرُ",1,"ر",1,0],["وكم شاعر قد أرخص الشعر دونها","وكم قلم فوق الطروس بها صرّا",2,"ر",2,0],["وكم شاعرٍ غادرت تشبيب شعره","بكاءً على سلمى بعَوْلة فاقدِ",3,"د",1,0],["وكم شقي ملكت قلبه","فقطعته قطعةً قطعه",4,"ع",2,0],["وكم شيء له بَذْرٌ يسيرٌ","ورَيْعٌ مثلُ أطواد الجبالِ",5,"ل",1,0],["وكم شعرٍ مدحتُ به ظلوماً","فصار هجاءَه لا بافتعالي",5,"ل",2,0],["وَكَم شِيَمٍ حَسناءَ عاشَت كَأَنَّها","مَساوِئٌ يُخشى شَرُّها وَذُنوبُ",6,"ب",1,0],["وَكَم شِفاهٍ أُرجُوانِيَّةٍ","كَأَنَّها مَخضوبَةٌ بَِلَّهيب",7,"ب",1,0],["وَكَم شاقَهُ خَدٌّ أَسيلٌ مُوَرَّدٌ","وَما ذاكَ إِلّا مُرهَفاتٌ وَمُرّانُ",8,"ن",1,0],["وَكَم شاعِرٍ وافى إِلَيكَ بِمَدحَةٍ","فَزَخرَفَها مِمّا أَفَدتَ وَنَمَّقا",9,"ق",2,0],["وَكَم شَرَفٍ قَد قُمتَ دونَ سَبيلِهِ","وَفُرصَةِ مَجدٍ لَم يَفُتكَ اِهتِبالُها",10,"ل",3,0],["وكم شَجّةٍ في حُرّ وجهك لم يَزَلْ","لك الحسنُ منها بالشجاعة واسما",11,"م",2,0],["وَكَم شُيوخٍ غَدَوا بيضاً مُفارِقُهُم","يُسَبِّحونَ وَباتوا في الخَنا سُبُحا",12,"ح",2,0],["وَكَم شاهَدتُ مِن عَجَبٍ وَخَطبٍ","وَمَرُّ الدَهرِ بِالإِنسانِ يُسلي",13,"ل",2,0],["وَكَم شيمَ في غِمدٍ مِنَ التُربِ صارِمٌ","وَكانَ لِبَرقِ الغَيثِ وَالغِمدِ شِياما",14,"م",2,0],["وَكَم شافهَتني لِلصّبا أَريَحِيَّةٌ","وَمازجَ ريقي لِلأَحِبَّةِ ريقُ",15,"ق",1,0],["وكم شاعرٍ لم يَمَسّ الشُّعورَ","فما قال شعرًا، ولكن نظم!",16,"م",1,0],["وكم شدوت بواديه الوريف وكم","أفعمت كأس القوافي من معانيه",17,"ي",2,0],["وكم شُيوخٍ غدّوْا، بِيضاً مفارقُهمْ،","يُسبِّحونَ، وباتوا في الخنى سُبُحا",18,"ح",2,0],["وكم شفاه أرجوانّية","كأنها مخضوبة باللّهيب",19,"ب",1,0],["وكم شيم حسناء عاشت كأنها","مساوىء يخشى شرّها وذنوب",20,"ب",1,0],["وَكَم شَهدت أَعدايَ فيَّ بِأَنَّني","نَشَأت بِمَهدي لِلمعالي مُناغيا",21,"ي",2,0],["وَكَم شَانئٍ أولَيتَهُ لِينَ جَانبي","وقَرَّبتُه خَوفاً مِنَ الشَّنَآنِ",22,"ن",1,0],["وكَم شَيءٍ أخَذتَ على اختِلاسٍ","فَبُيِّنَ بَينَ آمِنةٍ وآمِ",23,"م",1,0],["وكَم شَنُّوا إِغَارَتَهُم فَجَالُوا","بِأموَالِ الأعَادِى في البِقَاعِ",24,"ع",1,0],["وكم شهدَتْ يوما أغرَّ محجَّلا","تُخلِّده الأقلامُ ذِكرا بأطراسِ",25,"س",1,0],["وكَمْ شَكاني اشْتِكائي من هوى قَمَرٍ","مُحَكَّمٍ في قُلوبِ الخَلْقِ كَيفَ يَشا",26,"ش",2,0],["وَكَم شوهدَت من آيةٍ في رضاعهِ","فَأحيَت شياهَ الظئرِ في المحلِ والظئرا",27,"ر",2,0],["وَكَم شاهَدوا منهُ شواهدَ جمّةً","زَواهرَ يَعلو نورُها الأنجمُ الزُهرا",27,"ر",2,0],["وَكَم شهدَ الجمادُ له بحقٍّ","كأنَّ اللَّه قَد أعطاه عقلا",28,"ل",2,0],["وكم شيمة كالعضب منهُ انتضيتها","وألغيتها في غيرهِ طبعت غمدا",29,"د",2,0],["وكم شفعن ذاكَ الحسنَ لكنْ","متى احتاجَ الغواني للشفيعِ",30,"ع",1,0],["وكم شمتُ من بَرْقٍ لأَسماءَ خُلَّبٍ","وقلبي بما فيه من الزُّور عالِمُ",31,"م",1,0],["وكم شادَ اسماعيلُ في القُطرِ جامعاً","وخُرِّبَ قصرٌ في البلاد مشيدُ",32,"د",1,0],["وكم شهدت ستائرها عراكاً","وكم سمِعت وسائدُها هَديرا",33,"ر",2,0],["وكم شاعرٍ مُستهامٍ بَكى","على طَللي مَنزِلِ وغرام",34,"م",1,0],["وكم شاقَني قرنُ مِنَ الشمسِ قد بَدا","إلى أن غدا في الجوّ قرصاً من الشّهد",35,"د",1,0],["وكم شهيد قضى ظلماً بأربعها","وكم شريدٍ غريب الدار ينتظر",36,"ر",1,0],["وَكَم شقاً في نِعم","وَنقمٍ في لُقَمِ",37,"م",1,0],["وكم شذا من سنةِ المصطفى","قد ضاع من حفظك للناس",38,"س",1,0],["وكم شمت برق الذل فيكم فلم أجد","كلامع ذل من كلام عذولي",39,"ي",1,0],["وكم شمت لما قست مقدار ودكم","بوارق ياسٍ من بوارِ قياسي",40,"ي",1,0],["وكم شغل بما لا خير فيه","وكم حرص على شرف ومال",41,"ل",1,0],["وكم شرقت من فيض نورك أمّةٌ","غفا قلبا جهلا وناظرها سحرا",42,"ر",2,0],["وَكَمشِها ثَبتُ الحِضارِ مُلازِمٌ","لَمّا ضاعَ مِن أَدبارِهِنَّ لَزومُ",43,"م",1,0],["وَكَم شَق أَنواب الدياجي وَزارَني","وَكل لَياليه اِذا زارَني قمر",44,"ر",1,0],["وَكَم شَحَّتِ الدُنيا بِلَهجَةِ مادِحٍ","بَليغٍ فَلَم تُبلِغهُ مِنَّةُ مُنعِمِ",45,"م",1,0],["وَكَم شيمَ يَومٌ في يَدِ الصَبرِ أَسوَدٌ","وَأُغمِدَ لَيلٌ مِن يَدِ النَصرِ أَبيَضُ",46,"ض",1,0],["وَكَم شامَت بي بَعد موتِيَ جاهِلاً","بِظُلمي يسلُّ السَيفَ بَعد وَفاتي",47,"ي",1,1],["وكم شبح كاد يغتالني","فما كدت تظهر حتى اندحر",48,"ر",1,0],["وكم شكَونا لَه سبحانه ضَرَراً","ومنه كان امتحاناً ذكَ الضررُ",49,"ر",1,0],["وكم شادُوا قصوراً عالياتٍ","فَهَلْ وسعتْهُمُ إلاّ القبورُ",50,"ر",1,0],["وكَمْ شادوا الممالِكَ والمباني","فأينَ ترى المباني والممَالِكْ",51,"ك",1,0],["وكَم شَجِيتُ بتَرحَالٍ ومُفْتَقَدِ","فَما تنكّر لِي صبْرِي ولا جَلَدِي",52,"ي",1,0],["وكم شربتَ دواءً كنتَ تكرَهُهُ","فكان عافيةً فيه لمن شربا",53,"ب",2,0],["وكم شاهدت في الأَيَّام عسراً","ولذت به فشاهدت اليسارا",54,"ر",2,0],["وكم شرب الصب من عبرة","بذكر الأحبَّة دهراً طويلا",55,"ل",2,0],["وكم شاموا ظُباً بأكُفِّ غُلْبٍ","قضَتْ شؤماً عليهم أو غِلابا",56,"ب",2,0],["وكم شفيت بني دنياك من علل","فاليوم لاقيت ما أبلاك من علل",57,"ل",1,0],["وكم شفعت بيض الصّلات بمثلها","وما احمرَّ في أثنائها وجهُ شافع",58,"ع",1,0],["وكم شعرة في الجسم لبت مكانها","وما اسم طيور في الهواء مغيضتي",59,"ت",2,0],["وكم شمنا سناء كاملياً","فلاح نعائماً وجرى نعاما",60,"م",2,0],["وَكم شَنِفٍ يُنكِّدُ لا يُحابِي","وصُمٍّ كالأراقم لا تُحاشي",61,"ش",2,0],["وكم شيخٍ ومجذوبٍ","تبرّكنا بهم نهتمّْ",62,"م",1,0],["وكم شريك أثبتوه له","به فخرّوا من مكان سحيق",63,"ق",1,0],["وكم شَرَكٍ تُصادُ بهِ ظِباءٌ","ولكن لا تُصادُ بهِ الأُسودُ",64,"د",1,0],["وكمْ شاكٍ منَ الرَّحمنِ حتَّى","عليهِ الكُفرُ يَغلِبُ والجُحودُ",64,"د",1,0],["وكَمْ شاسعٍ لَمْ يلْق جودَك شَاسِعاً","وكم مرتج لم يلق بأبك مرتجا",65,"ج",2,0],["وكم شفيت مليك القطر من علل","بخير ادوبية في جسمه نجعت",66,"ت",1,0],["وَكَم شاهَدوها بِالحِجازِ وَنورُها","يَضيءُ بِأَعناقِ الأَيانِقِ مِن بُصرى",67,"ر",2,0],["وكم شدخت أخفافها هام سامد","من الشم تيها توجت بالغمائم",68,"م",1,0],["وكم شنب الأيام في الناس غارةً","أحالت بياض الصبح في العين أسودا",69,"د",2,0],["وكم شفى عاهة وعافى","بالريق والمسح من عراد",70,"د",1,0],["وكم شممت مطيب العجب منتيا","من سكرة التيه ألوي ما رنا شمما",71,"م",2,0],["وَكَم شفى في مساعيهِ بهمّتهِ","عينُ العلا إِذ رآها تشتكي الرَمَدا",72,"د",2,0],["وكمْ شَرَطْتُ لإخْواني على شِيمي","حَقاً وكنْتُ عليهمْ غيرَ مُشْتَرِطِهْ",73,"ط",2,0],["وَكَمْ شَهِدَتْ عَيْني بِبارِدِ دَمْعِها","بِأَنَّكَ بَدْرٌ كلُّ قَلْبٍ شَهيدُهُ",74,"د",2,0],["وكمْ شْديدِ الضَّلالِ أَعْمَى","أَشْرَكَ لمَّا رآهُ وحَّدْ",75,"د",1,0],["وكم شفت علل الإسلام منك يد","تروي بفيض نداها عاطش البيد",76,"د",1,0],["وكم شمت لما لاح بارق ثغرها","حدائق في وجناتها ذات بهجة",77,"ه",1,0],["وَكَم شاعِرٍ أَودَت ثَعابينُ شَعرِهِ","إِذا ما بَدا مِنهُنَّ سَبطٌ وَأَجعَدُ",78,"د",1,0],["وكم شدونا وصّفقنا وكم علمٍ","فوق الدّيار رفعناه منادينا",79,"ن",2,0],["وكم شدّت الظلاّم في مطلع الضّحى","على شامخ الأعناق في الشّام أمراسا",80,"س",2,0],["وكم شان زيف الشعر في الناس أمة","أصيبت به من واغلٍ ودخيل",81,"ل",1,0],["وكم شربوا للخلد في جنباتها","معين كؤوس صفوها يترقرق",82,"ق",1,0],["وكم شهدت له الزوراء يوماً","وكم حمد الحنيف له مقاما",83,"م",2,0],["وَكَم شجرت لهم فوق الهوادى","رماح تمنع الطير الوَقوعا",84,"ع",2,0],["وكم شمس بهالتها تجلت","ولاحت بالزوال خلال غين",85,"ن",1,0],["وكم شَهِدَت فيها الفراقدُ سامِرا","عليهم من الدُّنيا شُعاعٌ مُطنَّبُ",86,"ب",1,0],["وكم شاقني في الدوح نوح حمايم","على فقد إلفٍ غرّدت بحنين",87,"ن",1,0],["وكم شخصٍ ثقيلِ الرُّوح يأتي","به الدهرُ المصرُّ على عنادي",88,"ي",1,1],["وكم شموعٍ صُوِّرَتْ في قَصْرِ","أوصافُها طالَتْ بغير قَصْرِ",89,"ر",1,0],["وكم شنَّقت اذناً وكم برَّدت حشىً","وكم ابهجت قلباً وكم شرحت صدرا",90,"ر",2,0],["وَكَم شاهَدتُ ذاكَ اليَومَ طِفلاً","وَكُنتُ عَرَفتُهُ شَيخاً وَقورا",91,"ر",2,0],["وكم شهدت تلك المسالكُ حبنا","وتكل القصور البيضُ والنزهات",92,"ت",1,0],["وكم شيخ دين قدس الله سره","وكم شيخ عقل فاضلٌ زاهدٌ حمد",93,"د",1,0],["وكم شاعر يسمو زهيراً بنظمه","على حين يبدو في شبيبته العبد",93,"د",1,0],["وكم شام من نعوم بارق نعمة","لقد كفلت الا يغيبه اللحد",93,"د",1,0],["وكم شيدت في لبنان مجداً","فراح يشيد في علياك شكرا",94,"ر",2,0],["وكم شواهد تشهدها محققة","فكيف ينكر أخا الجهل باريه",95,"ي",2,0],["وكم شامت مستبشر بوفاتهِ","وعمّا قليل للّذي صار صائرُ",96,"ر",1,0],["وكم شخص يسود عداه لوم","وكم من مستحق للملام",97,"م",1,0],["وكم شكت العيون اليه وجداً","الى ان اصبحت شكرى العيون",98,"ن",1,0],["وكم شهود سوى هذا تُعَدّ له","ذكري لها جائز والترك للأدبِ",99,"ب",1,0],["وكم شفى لفوأد مسه سغب","من نذر قوت يسير بعد جوعهم",100,"م",1,0],["وكم شحيح كانز ماله","يوغل في الجمع ولا يرقد",101,"د",1,0],["وكم شريف غره اليمينُ","في عهده مع أنه يَمينُ",102,"ن",1,0],["وكم شهدتم من وغَى","وكم هزمتم من بَغى",103,"غ",2,0],["وَكَم شَقَّ في مسراهُ وَهو مزمجرِ","عَواصِف كانَت قَبل تَفَتُّك بِالصَخر",104,"ر",1,0],["وكم شياطين انس جان ماردها","أضحت رجوم نجوم منه تحرقها",105,"ق",3,0],["وكم شاد داود بوادي","بيتا سمت بالفضل أركانه",106,"ن",2,1],["وكم شنّت بك الغارات ناراً","وأجفان السيوف تسيل فتكا",107,"ك",2,0],["وَكَم شَدائد شدّت وَانقضت وَرخا","فَحذّرتني فَما أَغنَت وَأَغراني",108,"ن",2,0],["وَكَم شَهم تبختر باغترار","دَهاه أَسمر فذرى اِنتِهاسه",109,"س",2,0],["وكم شبهة للمشركين إزاحها","بكل دليل كاشفٍ المتردد",110,"د",1,0],["وكم شكوت الذي ألقاه منه فما","أوى لذلي ولا ألوي ولا اكترثا",111,"ث",2,0],["وكم شف فصل عن نبوغك ممتع","وقافيةٌ في الخافقين شرود",112,"د",1,0],["وكمْ شاعرٍ أهدى إليَّ قريضَهُ","ففاءَ بأثْوابٍ وخيْلٍ وجاملِ",113,"ل",1,0],["وكم شفعت إلى جيل بمنصلت","إن الحسام شفيع غير متهم",114,"م",1,0],["وَكَم شامِت بي أَن حُبستُ وَما دَرى","بِأَنّي حُسامٌ قَد أَ