{"poems":[[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[51,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[91,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[91,"يا صاح كم تفاحة غضة","https://www.aldiwan.net/poem8764.html","عموديه"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[46,"دعوا وما فيهم زاك ولا أحد","https://www.aldiwan.net/poem22291.html","البسيط"],[46,"غدت هذي الحوافل راتعات","https://www.aldiwan.net/poem23239.html","الوافر"],[46,"هياما يصير الجسم في هامد الثرى","https://www.aldiwan.net/poem23339.html","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39394","الطويل"],[106,"ذكرى شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179690",""],[46,"دَعَوْا، وما فيهمُ زاكٍ، ولا أحدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=18281",""],[91,"السجينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=374&r=&rc=2",""],[107,"خليلي مالي أبصر الدهر راضيا","https://www.aldiwan.net/poem16201.html","الطويل"],[130,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[130,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[130,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[140,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[153,"يا من تجنب دمعي منه حين وشى","https://www.aldiwan.net/poem55649.html","البسيط"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[187,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[197,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[197,"دموع الفجر هذي أم دموعي","https://www.aldiwan.net/poem45646.html","الوافر"],[227,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[239,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[268,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[268,"أصاحب لا تعذليه سلام","https://www.aldiwan.net/poem35591.html","المتقارب"],[268,"إذا الليل زاح الستر عن شفق ورد","https://www.aldiwan.net/poem35681.html","الطويل"],[288,"مهما تألبت الأحداث والغير","https://www.aldiwan.net/poem11710.html","البسيط"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[301,"يا حافظا كم لرواياته","https://www.aldiwan.net/poem57691.html","السريع"],[301,"أنعم روحي بالشقاء عليكم","https://www.aldiwan.net/poem58130.html","الخفيف"],[301,"ألا بئس ما قضيت عمري فيكم","https://www.aldiwan.net/poem58264.html","الطويل"],[302,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[326,"دع النائم اليقظان لا تستقه خمرا","https://www.aldiwan.net/poem54971.html","الطويل"],[335,"كأني كسوت الرحل جونا رباعيا","https://www.aldiwan.net/poem45420.html","الطويل"],[359,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[364,"وإنك إن ألبستني ثوب نعمة","https://www.aldiwan.net/poem17264.html","الطويل"],[364,"أنوما وألحاظ الخطوب سواهر","https://www.aldiwan.net/poem17319.html","الطويل"],[390,"وكم شامت بي بعد موتي جاهلا","https://www.aldiwan.net/poem53609.html","الطويل"],[399,"أذكر الوعد مولانا ومالكنا","https://www.aldiwan.net/poem46927.html","البسيط"],[399,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[399,"أضعت العمر في إصلاح حالك","https://www.aldiwan.net/poem47007.html","الوافر"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[413,"عشت الزمان بخفض العيش منتصبا","https://www.aldiwan.net/poem53964.html","البسيط"],[413,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[413,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[429,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[438,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[480,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[513,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[549,"ألا ماذا يريبك من همومي","https://www.aldiwan.net/poem47740.html","الوافر"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[560,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[573,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["وكمْ شَنَبٍ في ثغْرِهِ لم أُبَلْ بِهِ","ففي شَفَةِ الظَّلْماءِ منْ دُونِهِ لَمى",0,"م",2,0],["وكَم شَيّدَتْ أيّامُكُمْ مِن مَناقِبٍ","يُحَدِّثُ عَنها في مَجالِسِها فِهْرُ",1,"ر",1,0],["وكم شاعر قد أرخص الشعر دونها","وكم قلم فوق الطروس بها صرّا",2,"ر",2,0],["وكم شاعرٍ غادرت تشبيب شعره","بكاءً على سلمى بعَوْلة فاقدِ",3,"د",1,0],["وكم شقي ملكت قلبه","فقطعته قطعةً قطعه",4,"ع",2,0],["وكم شيء له بَذْرٌ يسيرٌ","ورَيْعٌ مثلُ أطواد الجبالِ",5,"ل",1,0],["وكم شعرٍ مدحتُ به ظلوماً","فصار هجاءَه لا بافتعالي",5,"ي",1,0],["وَكَم شِيَمٍ حَسناءَ عاشَت كَأَنَّها","مَساوِئٌ يُخشى شَرُّها وَذُنوبُ",6,"ب",1,0],["وَكَم شِفاهٍ أُرجُوانِيَّةٍ","كَأَنَّها مَخضوبَةٌ بَِلَّهيب",7,"ب",1,0],["وَكَم شاقَهُ خَدٌّ أَسيلٌ مُوَرَّدٌ","وَما ذاكَ إِلّا مُرهَفاتٌ وَمُرّانُ",8,"ن",1,0],["وَكَم شاعِرٍ وافى إِلَيكَ بِمَدحَةٍ","فَزَخرَفَها مِمّا أَفَدتَ وَنَمَّقا",9,"ق",2,0],["وَكَم شَرَفٍ قَد قُمتَ دونَ سَبيلِهِ","وَفُرصَةِ مَجدٍ لَم يَفُتكَ اِهتِبالُها",10,"ل",3,0],["وكم شَجّةٍ في حُرّ وجهك لم يَزَلْ","لك الحسنُ منها بالشجاعة واسما",11,"م",2,0],["وَكَم شُيوخٍ غَدَوا بيضاً مُفارِقُهُم","يُسَبِّحونَ وَباتوا في الخَنا سُبُحا",12,"ح",2,0],["وَكَم شاهَدتُ مِن عَجَبٍ وَخَطبٍ","وَمَرُّ الدَهرِ بِالإِنسانِ يُسلي",13,"ي",1,0],["وَكَم شيمَ في غِمدٍ مِنَ التُربِ صارِمٌ","وَكانَ لِبَرقِ الغَيثِ وَالغِمدِ شِياما",14,"م",2,0],["وَكَم شافهَتني لِلصّبا أَريَحِيَّةٌ","وَمازجَ ريقي لِلأَحِبَّةِ ريقُ",15,"ق",1,0],["وكم شاعرٍ لم يَمَسّ الشُّعورَ","فما قال شعرًا، ولكن نظم!",16,"م",1,0],["وكم شُيوخٍ غدّوْا، بِيضاً مفارقُهمْ،","يُسبِّحونَ، وباتوا في الخنى سُبُحا",17,"ح",2,0],["وكم شيم حسناء عاشت كأنها","مساوىء يخشى شرّها وذنوب",18,"ب",1,0],["وَكَم شَهدت أَعدايَ فيَّ بِأَنَّني","نَشَأت بِمَهدي لِلمعالي مُناغيا",19,"ي",2,0],["وَكَم شَانئٍ أولَيتَهُ لِينَ جَانبي","وقَرَّبتُه خَوفاً مِنَ الشَّنَآنِ",20,"ن",1,0],["وكَم شَيءٍ أخَذتَ على اختِلاسٍ","فَبُيِّنَ بَينَ آمِنةٍ وآمِ",21,"م",1,0],["وكَم شَنُّوا إِغَارَتَهُم فَجَالُوا","بِأموَالِ الأعَادِى في البِقَاعِ",22,"ع",1,0],["وكم شهدَتْ يوما أغرَّ محجَّلا","تُخلِّده الأقلامُ ذِكرا بأطراسِ",23,"س",1,0],["وكَمْ شَكاني اشْتِكائي من هوى قَمَرٍ","مُحَكَّمٍ في قُلوبِ الخَلْقِ كَيفَ يَشا",24,"ش",2,0],["وَكَم شوهدَت من آيةٍ في رضاعهِ","فَأحيَت شياهَ الظئرِ في المحلِ والظئرا",25,"ر",2,0],["وَكَم شاهَدوا منهُ شواهدَ جمّةً","زَواهرَ يَعلو نورُها الأنجمُ الزُهرا",25,"ر",2,0],["وَكَم شهدَ الجمادُ له بحقٍّ","كأنَّ اللَّه قَد أعطاه عقلا",26,"ل",2,0],["وكم شيمة كالعضب منهُ انتضيتها","وألغيتها في غيرهِ طبعت غمدا",27,"د",2,0],["وكم شفعن ذاكَ الحسنَ لكنْ","متى احتاجَ الغواني للشفيعِ",28,"ع",1,0],["وكم شمتُ من بَرْقٍ لأَسماءَ خُلَّبٍ","وقلبي بما فيه من الزُّور عالِمُ",29,"م",1,0],["وكم شادَ اسماعيلُ في القُطرِ جامعاً","وخُرِّبَ قصرٌ في البلاد مشيدُ",30,"د",1,0],["وكم شهدت ستائرها عراكاً","وكم سمِعت وسائدُها هَديرا",31,"ر",2,0],["وكم شاعرٍ مُستهامٍ بَكى","على طَللي مَنزِلِ وغرام",32,"م",1,0],["وكم شاقَني قرنُ مِنَ الشمسِ قد بَدا","إلى أن غدا في الجوّ قرصاً من الشّهد",33,"د",1,0],["وكم شهيد قضى ظلماً بأربعها","وكم شريدٍ غريب الدار ينتظر",34,"ر",1,0],["وَكَم شقاً في نِعم","وَنقمٍ في لُقَمِ",35,"م",1,0],["وكم شذا من سنةِ المصطفى","قد ضاع من حفظك للناس",36,"س",1,0],["وكم شمت برق الذل فيكم فلم أجد","كلامع ذل من كلام عذولي",37,"ي",1,0],["وكم شمت لما قست مقدار ودكم","بوارق ياسٍ من بوارِ قياسي",38,"ي",1,0],["وكم شغل بما لا خير فيه","وكم حرص على شرف ومال",39,"ل",1,0],["وكم شرقت من فيض نورك أمّةٌ","غفا قلبا جهلا وناظرها سحرا",40,"ر",2,0],["وَكَمشِها ثَبتُ الحِضارِ مُلازِمٌ","لَمّا ضاعَ مِن أَدبارِهِنَّ لَزومُ",41,"م",1,0],["وَكَم شَق أَنواب الدياجي وَزارَني","وَكل لَياليه اِذا زارَني قمر",42,"ر",1,0],["وَكَم شَحَّتِ الدُنيا بِلَهجَةِ مادِحٍ","بَليغٍ فَلَم تُبلِغهُ مِنَّةُ مُنعِمِ",43,"م",1,0],["وَكَم شيمَ يَومٌ في يَدِ الصَبرِ أَسوَدٌ","وَأُغمِدَ لَيلٌ مِن يَدِ النَصرِ أَبيَضُ",44,"ض",1,0],["وَكَم شامَت بي بَعد موتِيَ جاهِلاً","بِظُلمي يسلُّ السَيفَ بَعد وَفاتي",45,"ي",1,1],["وكم شكَونا لَه سبحانه ضَرَراً","ومنه كان امتحاناً ذكَ الضررُ",46,"ر",1,0],["وكم شادُوا قصوراً عالياتٍ","فَهَلْ وسعتْهُمُ إلاّ القبورُ",47,"ر",1,0],["وكَمْ شادوا الممالِكَ والمباني","فأينَ ترى المباني والممَالِكْ",48,"ك",1,0],["وكَم شَجِيتُ بتَرحَالٍ ومُفْتَقَدِ","فَما تنكّر لِي صبْرِي ولا جَلَدِي",49,"ي",1,0],["وكم شربتَ دواءً كنتَ تكرَهُهُ","فكان عافيةً فيه لمن شربا",50,"ب",2,0],["وكم شاهدت في الأَيَّام عسراً","ولذت به فشاهدت اليسارا",51,"ر",2,0],["وكم شرب الصب من عبرة","بذكر الأحبَّة دهراً طويلا",52,"ل",2,0],["وكم شاموا ظُباً بأكُفِّ غُلْبٍ","قضَتْ شؤماً عليهم أو غِلابا",53,"ب",2,0],["وكم شفيت بني دنياك من علل","فاليوم لاقيت ما أبلاك من علل",54,"ل",1,0],["وكم شفعت بيض الصّلات بمثلها","وما احمرَّ في أثنائها وجهُ شافع",55,"ع",1,0],["وكم شعرة في الجسم لبت مكانها","وما اسم طيور في الهواء مغيضتي",56,"ت",2,0],["وكم شمنا سناء كاملياً","فلاح نعائماً وجرى نعاما",57,"م",2,0],["وَكم شَنِفٍ يُنكِّدُ لا يُحابِي","وصُمٍّ كالأراقم لا تُحاشي",58,"ي",1,0],["وكم شيخٍ ومجذوبٍ","تبرّكنا بهم نهتمّْ",59,"م",1,0],["وكم شريك أثبتوه له","به فخرّوا من مكان سحيق",60,"ق",1,0],["وكم شَرَكٍ تُصادُ بهِ ظِباءٌ","ولكن لا تُصادُ بهِ الأُسودُ",61,"د",1,0],["وكمْ شاكٍ منَ الرَّحمنِ حتَّى","عليهِ الكُفرُ يَغلِبُ والجُحودُ",61,"د",1,0],["وكَمْ شاسعٍ لَمْ يلْق جودَك شَاسِعاً","وكم مرتج لم يلق بأبك مرتجا",62,"ج",2,0]]}