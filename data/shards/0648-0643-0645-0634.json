{"poems":[[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[51,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[91,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[91,"يا صاح كم تفاحة غضة","https://www.aldiwan.net/poem8764.html","عموديه"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[46,"دعوا وما فيهم زاك ولا أحد","https://www.aldiwan.net/poem22291.html","البسيط"],[46,"غدت هذي الحوافل راتعات","https://www.aldiwan.net/poem23239.html","الوافر"],[46,"هياما يصير الجسم في هامد الثرى","https://www.aldiwan.net/poem23339.html","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39394","الطويل"],[106,"ذكرى شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179690",""],[100,"الحبّ القتيل","https://www.poetsgate.com/ViewPoem.aspx?id=50345",""],[46,"دَعَوْا، وما فيهمُ زاكٍ، ولا أحدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=18281",""],[91,"يا صاح !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67607&r=&rc=49",""],[91,"السجينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=374&r=&rc=2",""],[110,"خليلي مالي أبصر الدهر راضيا","https://www.aldiwan.net/poem16201.html","الطويل"],[133,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[133,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[133,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[143,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[156,"يا من تجنب دمعي منه حين وشى","https://www.aldiwan.net/poem55649.html","البسيط"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[190,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[200,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[200,"دموع الفجر هذي أم دموعي","https://www.aldiwan.net/poem45646.html","الوافر"],[230,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[242,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[271,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[271,"أصاحب لا تعذليه سلام","https://www.aldiwan.net/poem35591.html","المتقارب"],[271,"إذا الليل زاح الستر عن شفق ورد","https://www.aldiwan.net/poem35681.html","الطويل"],[291,"مهما تألبت الأحداث والغير","https://www.aldiwan.net/poem11710.html","البسيط"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[304,"يا حافظا كم لرواياته","https://www.aldiwan.net/poem57691.html","السريع"],[304,"أنعم روحي بالشقاء عليكم","https://www.aldiwan.net/poem58130.html","الخفيف"],[304,"ألا بئس ما قضيت عمري فيكم","https://www.aldiwan.net/poem58264.html","الطويل"],[305,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[329,"دع النائم اليقظان لا تستقه خمرا","https://www.aldiwan.net/poem54971.html","الطويل"],[338,"كأني كسوت الرحل جونا رباعيا","https://www.aldiwan.net/poem45420.html","الطويل"],[362,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[367,"وإنك إن ألبستني ثوب نعمة","https://www.aldiwan.net/poem17264.html","الطويل"],[367,"أنوما وألحاظ الخطوب سواهر","https://www.aldiwan.net/poem17319.html","الطويل"],[394,"وكم شامت بي بعد موتي جاهلا","https://www.aldiwan.net/poem53609.html","الطويل"],[401,"أغصان الحروف","https://www.aldiwan.net/poem6789.html","عموديه"],[403,"أذكر الوعد مولانا ومالكنا","https://www.aldiwan.net/poem46927.html","البسيط"],[403,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[403,"أضعت العمر في إصلاح حالك","https://www.aldiwan.net/poem47007.html","الوافر"],[410,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[417,"عشت الزمان بخفض العيش منتصبا","https://www.aldiwan.net/poem53964.html","البسيط"],[417,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[417,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[433,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[442,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[465,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[516,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[552,"ألا ماذا يريبك من همومي","https://www.aldiwan.net/poem47740.html","الوافر"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[563,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[576,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["وكمْ شَنَبٍ في ثغْرِهِ لم أُبَلْ بِهِ","ففي شَفَةِ الظَّلْماءِ منْ دُونِهِ لَمى",0,"م",2,0],["وكَم شَيّدَتْ أيّامُكُمْ مِن مَناقِبٍ","يُحَدِّثُ عَنها في مَجالِسِها فِهْرُ",1,"ر",1,0],["وكم شاعر قد أرخص الشعر دونها","وكم قلم فوق الطروس بها صرّا",2,"ر",2,0],["وكم شاعرٍ غادرت تشبيب شعره","بكاءً على سلمى بعَوْلة فاقدِ",3,"د",1,0],["وكم شقي ملكت قلبه","فقطعته قطعةً قطعه",4,"ع",2,0],["وكم شيء له بَذْرٌ يسيرٌ","ورَيْعٌ مثلُ أطواد الجبالِ",5,"ل",1,0],["وكم شعرٍ مدحتُ به ظلوماً","فصار هجاءَه لا بافتعالي",5,"ل",2,0],["وَكَم شِيَمٍ حَسناءَ عاشَت كَأَنَّها","مَساوِئٌ يُخشى شَرُّها وَذُنوبُ",6,"ب",1,0],["وَكَم شِفاهٍ أُرجُوانِيَّةٍ","كَأَنَّها مَخضوبَةٌ بَِلَّهيب",7,"ب",1,0],["وَكَم شاقَهُ خَدٌّ أَسيلٌ مُوَرَّدٌ","وَما ذاكَ إِلّا مُرهَفاتٌ وَمُرّانُ",8,"ن",1,0],["وَكَم شاعِرٍ وافى إِلَيكَ بِمَدحَةٍ","فَزَخرَفَها مِمّا أَفَدتَ وَنَمَّقا",9,"ق",2,0],["وَكَم شَرَفٍ قَد قُمتَ دونَ سَبيلِهِ","وَفُرصَةِ مَجدٍ لَم يَفُتكَ اِهتِبالُها",10,"ل",3,0],["وكم شَجّةٍ في حُرّ وجهك لم يَزَلْ","لك الحسنُ منها بالشجاعة واسما",11,"م",2,0],["وَكَم شُيوخٍ غَدَوا بيضاً مُفارِقُهُم","يُسَبِّحونَ وَباتوا في الخَنا سُبُحا",12,"ح",2,0],["وَكَم شاهَدتُ مِن عَجَبٍ وَخَطبٍ","وَمَرُّ الدَهرِ بِالإِنسانِ يُسلي",13,"ل",2,0],["وَكَم شيمَ في غِمدٍ مِنَ التُربِ صارِمٌ","وَكانَ لِبَرقِ الغَيثِ وَالغِمدِ شِياما",14,"م",2,0],["وَكَم شافهَتني لِلصّبا أَريَحِيَّةٌ","وَمازجَ ريقي لِلأَحِبَّةِ ريقُ",15,"ق",1,0],["وكم شاعرٍ لم يَمَسّ الشُّعورَ","فما قال شعرًا، ولكن نظم!",16,"م",1,0],["وكم شدوت بواديه الوريف وكم","أفعمت كأس القوافي من معانيه",17,"ي",2,0],["وكم شُيوخٍ غدّوْا، بِيضاً مفارقُهمْ،","يُسبِّحونَ، وباتوا في الخنى سُبُحا",18,"ح",2,0],["وكم شفاه أرجوانّية","كأنها مخضوبة باللّهيب",19,"ب",1,0],["وكم شيم حسناء عاشت كأنها","مساوىء يخشى شرّها وذنوب",20,"ب",1,0],["وَكَم شَهدت أَعدايَ فيَّ بِأَنَّني","نَشَأت بِمَهدي لِلمعالي مُناغيا",21,"ي",2,0],["وَكَم شَانئٍ أولَيتَهُ لِينَ جَانبي","وقَرَّبتُه خَوفاً مِنَ الشَّنَآنِ",22,"ن",1,0],["وكَم شَيءٍ أخَذتَ على اختِلاسٍ","فَبُيِّنَ بَينَ آمِنةٍ وآمِ",23,"م",1,0],["وكَم شَنُّوا إِغَارَتَهُم فَجَالُوا","بِأموَالِ الأعَادِى في البِقَاعِ",24,"ع",1,0],["وكم شهدَتْ يوما أغرَّ محجَّلا","تُخلِّده الأقلامُ ذِكرا بأطراسِ",25,"س",1,0],["وكَمْ شَكاني اشْتِكائي من هوى قَمَرٍ","مُحَكَّمٍ في قُلوبِ الخَلْقِ كَيفَ يَشا",26,"ش",2,0],["وَكَم شوهدَت من آيةٍ في رضاعهِ","فَأحيَت شياهَ الظئرِ في المحلِ والظئرا",27,"ر",2,0],["وَكَم شاهَدوا منهُ شواهدَ جمّةً","زَواهرَ يَعلو نورُها الأنجمُ الزُهرا",27,"ر",2,0],["وَكَم شهدَ الجمادُ له بحقٍّ","كأنَّ اللَّه قَد أعطاه عقلا",28,"ل",2,0],["وكم شيمة كالعضب منهُ انتضيتها","وألغيتها في غيرهِ طبعت غمدا",29,"د",2,0],["وكم شفعن ذاكَ الحسنَ لكنْ","متى احتاجَ الغواني للشفيعِ",30,"ع",1,0],["وكم شمتُ من بَرْقٍ لأَسماءَ خُلَّبٍ","وقلبي بما فيه من الزُّور عالِمُ",31,"م",1,0],["وكم شادَ اسماعيلُ في القُطرِ جامعاً","وخُرِّبَ قصرٌ في البلاد مشيدُ",32,"د",1,0],["وكم شهدت ستائرها عراكاً","وكم سمِعت وسائدُها هَديرا",33,"ر",2,0],["وكم شاعرٍ مُستهامٍ بَكى","على طَللي مَنزِلِ وغرام",34,"م",1,0],["وكم شاقَني قرنُ مِنَ الشمسِ قد بَدا","إلى أن غدا في الجوّ قرصاً من الشّهد",35,"د",1,0],["وكم شهيد قضى ظلماً بأربعها","وكم شريدٍ غريب الدار ينتظر",36,"ر",1,0],["وَكَم شقاً في نِعم","وَنقمٍ في لُقَمِ",37,"م",1,0],["وكم شذا من سنةِ المصطفى","قد ضاع من حفظك للناس",38,"س",1,0],["وكم شمت برق الذل فيكم فلم أجد","كلامع ذل من كلام عذولي",39,"ي",1,0],["وكم شمت لما قست مقدار ودكم","بوارق ياسٍ من بوارِ قياسي",40,"ي",1,0],["وكم شغل بما لا خير فيه","وكم حرص على شرف ومال",41,"ل",1,0],["وكم شرقت من فيض نورك أمّةٌ","غفا قلبا جهلا وناظرها سحرا",42,"ر",2,0],["وَكَمشِها ثَبتُ الحِضارِ مُلازِمٌ","لَمّا ضاعَ مِن أَدبارِهِنَّ لَزومُ",43,"م",1,0],["وَكَم شَق أَنواب الدياجي وَزارَني","وَكل لَياليه اِذا زارَني قمر",44,"ر",1,0],["وَكَم شَحَّتِ الدُنيا بِلَهجَةِ مادِحٍ","بَليغٍ فَلَم تُبلِغهُ مِنَّةُ مُنعِمِ",45,"م",1,0],["وَكَم شيمَ يَومٌ في يَدِ الصَبرِ أَسوَدٌ","وَأُغمِدَ لَيلٌ مِن يَدِ النَصرِ أَبيَضُ",46,"ض",1,0],["وَكَم شامَت بي بَعد موتِيَ جاهِلاً","بِظُلمي يسلُّ السَيفَ بَعد وَفاتي",47,"ي",1,1],["وكم شبح كاد يغتالني","فما كدت تظهر حتى اندحر",48,"ر",1,0],["وكم شكَونا لَه سبحانه ضَرَراً","ومنه كان امتحاناً ذكَ الضررُ",49,"ر",1,0],["وكم شادُوا قصوراً عالياتٍ","فَهَلْ وسعتْهُمُ إلاّ القبورُ",50,"ر",1,0],["وكَمْ شادوا الممالِكَ والمباني","فأينَ ترى المباني والممَالِكْ",51,"ك",1,0],["وكَم شَجِيتُ بتَرحَالٍ ومُفْتَقَدِ","فَما تنكّر لِي صبْرِي ولا جَلَدِي",52,"ي",1,0],["وكم شربتَ دواءً كنتَ تكرَهُهُ","فكان عافيةً فيه لمن شربا",53,"ب",2,0],["وكم شاهدت في الأَيَّام عسراً","ولذت به فشاهدت اليسارا",54,"ر",2,0],["وكم شرب الصب من عبرة","بذكر الأحبَّة دهراً طويلا",55,"ل",2,0],["وكم شاموا ظُباً بأكُفِّ غُلْبٍ","قضَتْ شؤماً عليهم أو غِلابا",56,"ب",2,0],["وكم شفيت بني دنياك من علل","فاليوم لاقيت ما أبلاك من علل",57,"ل",1,0],["وكم شفعت بيض الصّلات بمثلها","وما احمرَّ في أثنائها وجهُ شافع",58,"ع",1,0],["وكم شعرة في الجسم لبت مكانها","وما اسم طيور في الهواء مغيضتي",59,"ت",2,0],["وكم شمنا سناء كاملياً","فلاح نعائماً وجرى نعاما",60,"م",2,0],["وَكم شَنِفٍ يُنكِّدُ لا يُحابِي","وصُمٍّ كالأراقم لا تُحاشي",61,"ش",2,0],["وكم شيخٍ ومجذوبٍ","تبرّكنا بهم نهتمّْ",62,"م",1,0],["وكم شريك أثبتوه له","به فخرّوا من مكان سحيق",63,"ق",1,0],["وكم شَرَكٍ تُصادُ بهِ ظِباءٌ","ولكن لا تُصادُ بهِ الأُسودُ",64,"د",1,0],["وكمْ شاكٍ منَ الرَّحمنِ حتَّى","عليهِ الكُفرُ يَغلِبُ والجُحودُ",64,"د",1,0],["وكَمْ شاسعٍ لَمْ يلْق جودَك شَاسِعاً","وكم مرتج لم يلق بأبك مرتجا",65,"ج",2,0]]}