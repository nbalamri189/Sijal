.aspx?id=121722",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5242,"رجاء الإله لنا شامل","https://www.poetsgate.com/ViewPoem.aspx?id=125970",""],[592,"معاني مبانيها الطوامح في العلا","https://www.poetsgate.com/ViewPoem.aspx?id=128851",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5458,"حتى يقال وقد قيل","https://www.poetsgate.com/ViewPoem.aspx?id=113377",""],[5587,"الدنيا يا الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=197804",""],[5587,"في القلب حزن","https://www.poetsgate.com/ViewPoem.aspx?id=200142",""],[5616,"حصار","https://www.poetsgate.com/ViewPoem.aspx?id=203228",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5664,"السمو","https://www.poetsgate.com/ViewPoem.aspx?id=176696",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5776,"وَصَايَاهُم","https://www.poetsgate.com/ViewPoem.aspx?id=199441",""],[402,"يا مصر أنت الهل والسكن","https://www.poetsgate.com/ViewPoem.aspx?id=36539",""],[5872,"إليك تحن النجب والنجباء","https://www.poetsgate.com/ViewPoem.aspx?id=120610",""],[5896,"القمران","https://www.poetsgate.com/ViewPoem.aspx?id=190063",""],[5923,"أنتِ المليكة","https://www.poetsgate.com/ViewPoem.aspx?id=152058",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"كما الشوق شاء","https://www.poetsgate.com/ViewPoem.aspx?id=182091",""],[5956,"فضل الله المتواصل","https://www.poetsgate.com/ViewPoem.aspx?id=193369",""],[5957,"أرى الآتي كما الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=14224",""],[5964,"على الخيف من أكناف برقة أطلال","https://www.poetsgate.com/ViewPoem.aspx?id=181306",""],[5977,"هم يزول وهم يدوم","https://www.poetsgate.com/ViewPoem.aspx?id=213254",""],[6106,"سيدتنا الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=6302",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""],[406,"مليون توقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63261&r=&rc=71",""],[138,"ألا هَلْ أتَى بَحْريِّنا صُنعُ ربِّنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17340&r=&rc=14",""],[2944,"حياة التشرّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86016&r=&rc=0",""]],"verses":[["هُم وَسَموا ما أَغفَلَ ال","ناسُ عَلى طولِ القِدَم",0,"م",1,0],["هُمومٌ تُناجى بِالعَلاءِ وَهِمَّةٌ","لَها فارِطٌ في كُلِّ مَجدٍ وَرائِدُ",1,"د",1,0],["هَمّوا بِهَجري وَكانَت في نُفوسِهِمُ","بَقِيَّةٌ مِن هَوىً باقٍ فَما وَقَفوا",2,"ف",3,0],["هَمُّوا وَأَفْرَطَ رُعْبُهُمْ فَتَوَقَّفُوا","فَعَلاَمَ لاَ تُنْضَى السُّيُوفُ عَلاَمَا",3,"م",2,0],["هُمْ وَارِثُو آلامِهَا وَبِهِمْ","سَتُرَدُّ عَنْ أَكْنَافِهَا المِحَنُ",4,"ن",1,0],["هَمُّوا بِأَنْ يَنتَقِصُوا فِي الوَرَى","خُلُقاً عَظِيماً فَسَمَا وَاسْتَتمّْ",5,"م",1,0],["هُمُ وَرَدوا الكُلابَ وَلَستَ مِنهُم","وَلا في الخَيلِ إِذ عَلَتِ النِسارا",6,"ر",2,0],["همو أسمعونا نعرة عربية","فدوّى صداها في المسامع مُصطرّا",7,"ر",2,0],["همومه له ترو","ض والحياة تلهم",8,"م",1,0],["همو رأوا أن تظل القضب مغمدة","فلن تذيب سوى أغمادها القضب",9,"ب",1,0],["همّوا ببَيْنٍ فاسْتُطيرَ له","قلبي فكيفَ يكونُ إِن شَطُّوا",10,"ط",3,0],["همومٌ قد مُنِيتُ بها طِوالٌ","لأيام مَضَيْنَ به قِصارِ",11,"ر",1,0],["هُمُ وَنَحنُ سَواءٌ غَيرَ أَنَّهُمُ","أَضحَوا لَنا سَلَفاً نُمسي لَهُم تَبَعا",12,"ع",2,0],["هُمُ وَرِثوا الخِلافَةُ حَيثُ شُقَّت","عَصا الإِسلامِ وَاِشتَغَرَ اِشتِغارا",13,"ر",2,0],["هُمُ وَلَدوا بَنِيَّ وَخِلتُ أَنّي","إِلى أُربِيَّةٍ عَمِدٍ ثَراها",14,"ا",3,0],["هُمومُها ما تَنقَضي ساعَةً","عَن مَلِكٍ فيها وَعِن سُوَقه",15,"ه",1,0],["هُمومُ رِجالٍ في أُمورٍ كَثيرَةٍ","وَهَمّي مِنَ الدُنيا صَديقٌ مُساعِدُ",16,"د",1,1],["همودُ رسمٍ منكِ تحتَ البلى","مُحَرِّكٌ مِنِّي سكونَ الغَرَام",17,"م",1,0],["هُمومَ الحَياةِ وَأَسقامَها","وَإِن كانَ حَتفاً جَهيزاً فَداكِ",18,"ك",1,0],["هَمّوا بِبُعدٍ مِنكَ غَيرِ تَقَرُّبٍ","شَتّانَ بَينَ القُربِ وَالإِبعادِ",19,"د",1,0],["همو نفضوا الهموم عليّ حتى","تظاهرت الفوادح والصعاب",20,"ب",1,0],["همو جعلوا الصّليبَ أذىً وبغياً","عليكِ صلاةُ ربّكِ أنصفينا",21,"ن",2,0],["هُمو سَلَبوهُ المالَ وَالآلَ وَاِحتَوَوا","مِنَ الحَبِّ وَالأَنعامِ ما هُوَ كاسِبُ",22,"ب",1,0],["هُمومٌ وَآلامٌ وَحاجاتُ أُمَّةٍ","تَهِمُّ وَيَأبى الظُلمُ أَن تَتَقَدَّما",23,"م",2,0],["هُمو أَخَذوكِ بِالنَكَباتِ حَرّى","وَبِالأَهوالِ شَتّى يَرتَمينا",24,"ن",2,0],["هُمو أَعوانُ مِصرَ وَناصِروها","إِذا نَزَلَت بِها النُوَبُ العِظامُ",25,"م",1,0],["همو غادروه كرَوضٍ أريضٍ","تَتوقُ النُفوسُ إِلى نَضرتِه",26,"ت",2,0],["همو زعموا أَنّا ضِعافٌ فَضاعفوا","أَذانا وَكَم مِن مُخطئٍ حينَ يَزعمُ",27,"م",1,0],["همو ضارَبوا عَنهُ فَصانوا ذِمارَهُ","بِصارِمِ عَزمٍ ما يُرَدُّ مَضاؤُهُ",28,"ا",3,0],["همو خذلوها فاستُبِيحَ حَريمُها","وَما بَرحَت تَبغي انتِصاراً فَتُخذَلُ",29,"ل",1,0],["هم وباءُ الأرضِ أو طاعونُها","شرعوا السُّحْتَ ودانوا بالربا",30,"ب",2,0],["همُو قتلوكَ مَصلوباً وأَغْروا","بِهِ وبِكَ الضِّعافَ مِنَ الموالي",31,"ل",2,0],["هُمومٌ بِالهَواءِ مُعَلَّقاتٌ","إِلى التَشريفِ أَنفُسُها طِرابُ",32,"ب",1,0],["همّوا فأمّوا فلمّا شارفوا وقَفوا","كوِقْفَةِ العَيْرِ بين الوِرْدِ والصّدَرِ",33,"ر",1,0],["هُمو ذُخرُها المَرجُوُّ في كلِّ حادثٍ","وَعُدَّتُها في كلِّ يَومٍ عَصَبصَبِ",34,"ب",1,0],["همو البُنَاةُ وإِنْ لم يذكروا يَدهُمْ","فيمَا يَرى الجيلُ من مرفوعِ بنيانِ",35,"ن",1,0],["هُمْ وابْنُ عمِّ بِهِ عَزُّوا وَعَزَّ بِهِمْ","كَمُحْكمِ العِقْدِ مِنْ دُرٍّ زها وَصَفَا",36,"ف",2,0],["هُمومٌ جَلَبنَ الشَيبَ قَبلَ أَوانه","وَصَدَّعنَ قَلباً لا يُغَضُّ صَفاهُ",37,"ا",2,0],["همومُك بالعيش مقرونةٌ","فما تقطعُ العيش إلّا بهم",38,"م",1,1],["همو نضحوا بالماء داميَ جرحه","ففاح عبير الماء كالمسك ذاكيا",39,"ي",2,0],["همو حملوا راية الضاد حتى","أعادوا لها جعفرا والرشيدا",40,"د",2,0],["همو حطَّموا صنَمًا قائمًا","وثنَّوْا بعُبَّاد هذا الصَّنَمْ",41,"م",1,0],["همو طيورُ الحمى في يومهم، وغدًا","همو ليوثٌ؛ إذا ريعَ الحمى، وثبُوا",42,"ب",3,0],["همو قطعٌ من ثراها تَدبُّ","عليها، وهُم صحبُها الأوفياء",43,"ا",2,0],["هُمُو حَسِبُوا مصر صَيْدًا سمينًا","وقدْ تَقْنصُ الأسْدُ صَيَّادها",44,"د",3,0],["هم وجبريل على حيزومه","بالتسابيح لهم فيها زجل",45,"ل",1,0],["هم وسعوا الكون حلوما وهدى","وصائلا ونائلا ومجتدى",46,"ا",1,0],["همو أقاموا سننا شامخة","تمثل الشهب ارتفاعا وسنا",46,"ا",1,0],["هموا وأفرط رعبهم فتوقفوا","فعلام لا تنطى السيوف علاما",47,"م",2,0],["هم وردوا الحياض مباركات","فسالت عندهم ماء معينا",48,"ن",2,0],["هموم ترى في كل حين بمظهر","سواء هديل شائق ونواح",49,"ح",1,0],["هم وجدوا حول الفرات أمانياً","لطافاً أضلتها نفوس نوازع",50,"ع",1,0],["همومي ما لها عن ضعف حالي","سوى اسعاف اهل البيت حاجز",51,"ز",1,1],["همومي أوهت هممي","فأجرني أنت معتمدي",52,"د",2,0],["هَمّوا فَمُذ نَزَلوا بِالشَطِّ شَطَّ بِهِم","عَن سَورَةِ الحَربِ ما خافوا مِنَ الحَرَبِ",53,"ب",1,0],["هموا بحرب ومناهم به الحلم","وهم نيام فلما استيقضوا ندموا",54,"م",3,1],["همومٌ تشفقُ الأطوادُ منها","وأحزانٌ يضيقُ بها القضاءُ",55,"ا",2,0],["همو الذخيرة إن جار الزمان غدوا","للناس بحراً فمنه الناس تغترف",56,"ف",1,0],["همومٌ كأثقال الجبال حملتها","وما لهموم الدهر عندي من وزن",57,"ن",1,0],["هُمُ وَرَدوا المِياهَ عَلى تَميمٍ","كَوِردِ قَطاً نَأَت عَنهُ الحِساءُ",58,"ا",2,0],["همومٌ سألتُ اللَه عني كشفَها","وأعظم ما أرجوهُ منه رِضَاهُ",59,"ا",2,0],["همومي من جدواك ان ابلغ العلا","وهم السوى جو دابة ورغيف",60,"ف",1,0],["همومي على نيل المعالي كهمتي","وان ابت الدنيا فقد وضح العذر",61,"ر",1,0],["همومٌ وأمراضٌ وموتٌ وحسرةٌ","فنفرحُ يوماً ثم نحزنُ عاما",62,"م",2,0],["هُمُ وَصَّفُوه العَزْمَ والحَزْمَ والتُّقَى","وَهُم وَرَّثُوهُ الهَدْيَ والخُلْقَ والخَلْقَا",63,"ق",2,0],["هُمُومٌ تُبَلِّدُ فَهْمَ الْبَلِيغِ","وَتُعْيِي نَوافِثَ سِحْرِ الْكَلامِ",64,"م",1,0],["هُمُ وَصَلوا إِلى قَتلي","بِبَينِهِمُ وَما وَصَلوا",65,"ل",3,0],["هُمُ وَعَدوني بِالوِصالِ فَأَخلَفوا","فَمِنهُم بِنيرانِ الغَرامِ صَليتُ",66,"ت",1,0],["هُم وَلّوا الأَدبارَ إِذ كَبَّتهُمِ ال","بيضُ الذُكورُ وَهاجَتِ الهَيجاءُ",67,"ا",2,0],["هُم وشَّحوني بمنثور الدموع وقد","توشَّحوا من لآليهم بمنتظمِ",68,"م",1,0],["همو تحت اقدار الاله وحكمه","كما انت فيما قد اتيت بحجة",69,"ه",1,0],["هُمُ وَهَبوا الأَملاكَ ما في يَدَيهِمُ","وَلَو أَنَّهُم مَدّوا اليَدَينِ لَحازوا",70,"ز",3,0],["هُمومي أَراها اليَومَ مِن أَمسِها أَسمى","فَلا يَذكُرِ العُذّالُ هِنداً وَلا أَسما",71,"م",2,1],["همو أهلة غسان ومجدهم","عال فإن حالوا ملكاً فلاعجبا",72,"ب",2,0],["هم ومن في اللحود سيان لكن","ما على ساكني اللحود مذمه",73,"م",2,0],["هم والحجارة كلما","نضجت تبدَّلتِ الجلود",74,"د",1,0],["هُمّو عَلَّموا عَيني سُؤال المَعالِمِ","بِنَوَعَينِ هَطّالٍ عَلَيها وَساجِمِ",75,"م",1,1],["همُ وضعوا أفاويق المعالي","كما رَضَعَ الفَصيلُ من اللقاحِ",76,"ح",1,0],["هموا بأقدام على ضمر","في سيرهم برق الغوادي حكو",77,"و",1,0],["همو مثل النجوم يغيب نجم","ونجم طالع بالنور سام",78,"م",1,0],["همْ وأبوهم شرفاً وأمّهم","أكرمُ من تحوي السماءُ وتُظِلّْ",79,"ل",1,0],["هم وإن أنكرهم حاسدُهم","بُرَةٌ يعرفها أنفُ الجَمَلْ",80,"ل",1,0],["هُمُ ومنابتُ هذي الملوك","من النبع والناسُ من خِروعِ",81,"ع",1,0],["هم وَزَرُوا الدولاتِ واستنصحوا","رَعْياً على العاطفِ والساربِ",82,"ب",1,0],["همومِيَ من قبل اكتهالي تَكَهُّلٌ","وغدرُكِ من قبل المَشيبِ مَشيبُ",83,"ب",1,0],["همُ واهبو خضرِ الدلاص منوطةً","بحمر المطايا والمطهَّمة القبِّ",84,"ب",1,0],["همُ وإيّاهُ ساداتي ومُستَنَدي ال","أقوى وكعبةُ إسلامي ومُستَلَمي",85,"م",2,0],["همّوا بإطفاءِ نورِ المجدِ منك فلا","فتمّ فيك ويأبى اللّهُ ما طَلبوا",86,"ب",3,0],["هم وسموا رقي بحسن اصطناعهم","وكم حفظت رق الجياد وسوم",87,"م",1,0],["هموا شرفوا البيت الحرام فقدست","مشاعر منها أبطح وحجون",88,"ن",1,0],["هُمُ وُجُوهُ الْيَمَنِ","هُمُ عُيُونُ الزَّمَنِ",89,"ن",1,0],["هُمو نَبَتوا فرعاً بِكُلِّ شَرارَةٍ","حَرامَ فَأَشبى فَرعُها وَأَرومُها",90,"ه",2,1],["همّوا ولم يفعلوا لعائقةٍ","وفاعلٌ للأمور مَن عزما",91,"م",2,0],["هُمُ ورِثوا تلك النّجابةَ فيهمُ","كَما شِئتَها عَن سيّدٍ بعد سيّدِ",92,"د",1,0],["همو اليوم الوغى بل أضربوا عظما","عن العدا بل نسوا كرات كل كمى",93,"م",2,0],["همّ ٌودَمْعٌ وخَوْفٌ وافتقارُ يَدٍ","هذي خُصُومٌ وما هَذَانِ خَصْمانِ",94,"ن",1,0],["همو قصدوا الأتراك حقاً بجمعهم","وما عاقهم عنهم أهاويل مارد",95,"د",1,0],["همو جددوا دين الهدى بعدما عفا","بصدق وجد قامع للمكابر",96,"ر",1,0],["هموا جدد والإسلام بعد اندراسه","وأحيوا من الأعلام ما كان خافيا",97,"ي",2,0],["همو سر حب اللَه في كل عاشق","وحق اشتياق الحق في كل شائق",98,"ق",1,0],["هم وسط يرضى الإله بحكمهم","إذا طرقت إحدى الليالي بمعظمِ",99,"م",1,1],["همّوا بها فرصة والشرق منتبهٌ","والغرب مضطربٌ بالخطب مشتغل",100,"ل",1,0],["همومكم بتقاسم","معكم إبلا هوان",101,"ن",1,0],["هِمْ وَاِستَمِع قَولَ مَن يُغريكَ فيهِ وتِهْ","وَدَعْ وَلا تَستَمِع أَقوالَ نصّاحِ",102,"ح",1,0],["هُمّوا لِشَرحِ الصّدور قوموا بِذكرِ اللَّه","هَل تَطمَئن القلوب إِلّا بِذكر اللَّهْ",103,"ه",1,0],["هُمّوا إِلى الصّلاةِ بي وَسارِعوا","وَاِعتَكِفوا في كلِّ حينٍ وَاِخشَعوا",104,"ع",3,0],["هُمُو العَلقَمِيِّونَ ، يَا طَالَمَا","أدَانُوا السَّبيِّةَ، لا مَنْ سَبَاهَا",105,"ا",3,0],["هموم الدهر منها الرأس شابا","وبالمُرِّ الحلاوة منه شابا",106,"ب",2,1],["هم والدي وإليهم أنتمي صُعداً","والحي قيس همُ صهري وجيراني",107,"ي",1,0],["همُ والحمائم أهل شأن واحد","إن غرّدت فوق الأراكة غرّدوا",108,"د",3,0],["هم وعدوك العدل كي يظلموابه","أباً ظالماً لكن دهتك المظالم",109,"م",1,0],["همو مهموا علت في اللَه صدقا","وأوجههم بتقواه وسيمة",110,"م",2,0],["همومهم فوق الكواكب رفعة","والبابهم نور وريحهم ندى",111,"د",2,0],["همومهم علت وسمت وفاقت","قلوبهم الكواكب والشعاعا",112,"ع",2,0],["هَمٌّ وَغَمٌّ وَأَذى","وَحَسرات كَالجذى",113,"ذ",2,0],["همو الذين ابتنوا بالأمس واحتفروا","فمالهم إن أرادوا حقهم دفعوا",114,"ع",3,0],["هموا الذين استبدت في حقوقهمو","يد الدّخيل فما ذادوا ولا منعوا",114,"ع",3,0],["همو الذين يقول الناس انهمو","إن صادفوا ملهيا عن جوعهم قنعوا",114,"ع",3,0],["هموم واحزان وسقم وغربة","واتعاب بال مثل لسع الاراقم",115,"م",1,0],["همُ ولاةُ العلى والملك في يمنٍ","وهم حُماة بنيِّ الأمّة الهادي",116,"د",2,0],["هم وجدوني موضعاً لصَنيعهم","فألفوه ذُخراً حيث يُحتَسب الذَّخرُ",117,"ر",1,0],["هم ورَّثوا المجد ذهلا فكانت","مساعيه غرَّته وال