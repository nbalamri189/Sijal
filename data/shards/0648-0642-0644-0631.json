{"poems":[[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202684","الطويل"],[119,"لقد أكثر الباغي التعدي بقوله","https://www.aldiwan.net/poem42162.html","الطويل"],[186,"مضى عن بني الخوام نخلة راحلا","https://www.aldiwan.net/poem67002.html","الطويل"],[409,"أقلب قلبا بعد بعدك في الجمر","https://www.aldiwan.net/poem33922.html","الطويل"],[511,"بلغت المنى وحللت الحرم","https://www.aldiwan.net/poem2400.html","المتقارب"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27934","الطويل"],[2293,"","https://poetry.dctabudhabi.ae/diwan/poem/198994","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109784","الطويل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145184","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4723,"تزوَّدْ من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=61934",""],[4929,"الهمة في بلوغ القمة","https://www.poetsgate.com/ViewPoem.aspx?id=199355",""]],"verses":[["وقُل رَبِّ وَفِّق لِلعَظائِمِ أُمَّتي","وَزَيِّن لَها الأَفعالَ وَالعَزَماتِ",0,"ت",1,0],["وقل رحمة مات العدو بغيظه","سريعاً بسيف هز غيبي نصله",1,"ل",2,0],["وَقُل رِضَي الرَحمنِ عَنكَ مُؤرِّخاً","وَجادَكِ ماَءُ الوَبلِ يا تُربَةَ النَخلِ",2,"ل",1,0],["وقل رب قد خلفت شيخي متيماً","إلى طيبة والبيت أدمعه تجري",3,"ر",2,0],["وقل ربّ هب رحمةً في غد","لعبدِ بسيما العُصاة اتسم",4,"م",1,0],["وقل ربنا أرحمنا وإخواننا الألى","بالايمان حازوا الخصل في سبقهم شدا",5,"د",2,0],["وقل ربِّ زدني من علومٍ تقيدت","علومٌ مذاق أنهن عوارف",6,"ف",1,0],["وقل رحم الله الفقيه فذكره","بخير له من اجرة ذي الطرس",7,"س",1,0],["وقل رجال النقد حتى لقد غدا","سواء لديهم جاهل ومعلم",8,"م",1,0],["وقل ربي عليك بهم وخذهم","ومثواهم يكون بدار مالك",9,"ك",1,0],["وَقَلَّ رُمحَينِ مُثَقَّفَينِ","حَتّى أَعالي الجَوِّ ساطِعَينِ",10,"ن",1,0],["وقلْ ربِّيَ اغفرْ لي فإنِّيَ تائبٌ","وعرَّجْ وصلِّ عند أقربِ مسجدِ",11,"د",1,0],["وقل ربي استعنتُك في أموري","عليك توكلي في كل حالِ",12,"ل",1,0]]}