.com/ViewPoem.aspx?id=200714",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5561,"كما تشائين","https://www.poetsgate.com/ViewPoem.aspx?id=201390",""],[5616,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=203462",""],[5729,"ضاعت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=203997",""],[5771,"ليسَ إلَّا","https://www.poetsgate.com/ViewPoem.aspx?id=189110",""],[5997,"مُحَمّدٌ ( ص )","https://www.poetsgate.com/ViewPoem.aspx?id=214259",""],[6102,"ريما","https://www.poetsgate.com/ViewPoem.aspx?id=184167",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""]],"verses":[["وَبائِنٍ مِن ثَناءٍ حُسنُهُ مَثَلٌ","وَشيُ المَحاسِنِ مِنهُ مُعلَمُ الطُرَرِ",0,"ر",1,0],["وَبِأَيِّ خَسْفٍ عُوقِبَ القَوْمُ الأُولَى","عَاقُوا شُمُوسَهُمُ عَنِ الدَّوَرَانِ",1,"ن",1,0],["وَبِأَيِّ الأسْبَابِ بُدِّلَتْ الحَا","لُ فَعَكْسُ الحَدِيثِ ذَاكَ القَدِيمُ",2,"م",1,0],["وبأي الأسى رمتها الليالي","فاكتست للحداد ثوب ظلام",3,"م",1,0],["وَبايَعتَ الرَسولَ وَكانَ خَيراً","إِلى خَيرٍ وَأَدّاكَ الثَراءُ",4,"ا",2,0],["وَبايَعوهُ فَلَم يَنكُث بِهِ أَحَدٌ","مِنهُم وَلَم يَكُ في إيمانِهِم دَخَلُ",5,"ل",1,0],["وبأيمنِ طالعٍ عقدُ سنيّ","جليّ اليمنِ متصلُ النجاح",6,"ح",1,1],["وبايعَ بعد الفتح قوم سبقتهم","فلِمْ أنا في نُعماك رِدْفٌ وهُمْ صدر",7,"ر",1,0],["وبأي الأحكام قولك برها","ن وقولي من خُلَّبات البروق",8,"ق",1,0],["وبأيما كيفية تحصيلها","ومن الجباة فهنّ شر جباة",9,"ه",1,0],["وَبِأَيِّ ذَنبٍ قَد طَعَن","تَ حَشايَ يا قَدَّ الكَبائِر",10,"ر",1,0],["وَبِأَيِّ عَينٍ أَم بِأَيَّةِ مُزنَةٍ","أَم أَيِّ طوفانٍ تَفيضُ وَتَفهَقُ",11,"ق",1,0],["وَبِأَيِّ نَولٍ أَنتَ ناسِجُ بُردَةٍ","لِلضِفَّتَينِ جَديدُها لا يُخلَقُ",11,"ق",1,0],["وَبِأَيّامِهِ الَّتي اِنسَلَخَت عَن","هُ وَما دارُهُ سِوى الهَيجاءِ",12,"ا",2,0],["وَبِأَيِّما آبائِهِ لا يَكتَسي","مَجداً يَفوتُ الرَوضَ في أَلوانِهِ",13,"ن",2,0],["وَبِأَيِّ البِلادِ تُقبَضُ روحي","وَبِأَيِّ البِقاعِ يُحفَرُ قَبري",14,"ي",1,0],["وبإيمان ركع","وتسابيح سجد",15,"د",1,0],["وَبِأَيِّ الأَسْبابِ يُعْطَى مَكانٌ","صَدَقاتِ السُّلطانِ دُونَ مَكانِ",16,"ن",1,0],["وبأيّ أُنمُله أطافَ ولم يَخَفْ","من بأسِها سَوطاً علَيهِ عَذابَا",17,"ب",2,0],["وبأيري أيرُ شيخٍ","ذاكرٌ أيامَ عادِ",18,"د",1,0],["وَبائِيَةٌ مِن ضُعفِ عَقلِ نُفوسِنا","كَبائِيَةٍ مِن شارِداتِ عَبيدِ",19,"د",1,0],["وبأيِّ الطُرْقِ أرجُو رَجْعَها","رُبَّما أقضي وما أدري بأي",20,"ي",1,0],["وبأيديهما أفاعٍ غلاظٌ","تتلوى مخوفةٌ وتدورُ",21,"ر",1,0],["وبايعَ في شبيبته المنايا","فعادت منه وادَّرأتْ حمامهْ",22,"م",2,0],["وبِأَيِّ ناحِيَةٍ أَقَمْتَ فإِنَّني","أَلْقاكَ بَيْنَ تَوثُّبٍ وجمِاحِ",23,"ح",1,0],["وبائعا لوطن فيه انتشى","بلقمة يلذها وهي الودى",24,"ا",1,0],["وبأيد مقطوعة نتصدى","وبأيدي العدا نشيد العرينا",25,"ن",2,0],["وبأيِّ مِيزانِ العُقولِ سَيَنْثَنِي ال","طَّاغوتُ إلّا بالكفاحِ الزَّاخِرِ",26,"ر",1,0],["وبأيديكم الزمانُ وأهلوهُ","ومنكم حياتُه ومماتُه",27,"ت",2,0],["وَبِأَيِّ فِعلٍ ما مَلَكتَ الحَمدَ أَم","في أَيِّ شَيءٍ ما بَلَغتَ مُناكا",28,"ك",2,0],["وَبايع كَريماً طابَ أَصلاً وَمَولِداً","فَشَبَّ شَبابَ الرَوضِ أَخضَلَهُ النَدى",29,"د",2,0],["وبأيدي حرٍّ لمن تفكر عبرةٌ","منها الأَريب بعقله يتحير",30,"ر",1,0],["وبايع صاعا بصاع وده","بقدر ما جذبته ينجذب",31,"ب",1,0],["وبأيِّ لحدٍ أودعوه وإنَّه","ما قَطُّ في الضريحِ حسام",32,"م",1,0],["وَبِأَيمَنِ الوادي الَّذي نَزَلوا بِهِ","ظَبيٌ لَهُ في كُلِّ قَلبٍ مَربَعُ",33,"ع",1,0],["وبايعه في نصرة الدين والهدى","كما بايعت في وفدها قبل يثرب",34,"ب",1,0],["وبايعوا ابنَ رسولِ اللهِ سَيدَكم","كي لا تروا فتنةً فيكم وأَحزابا",35,"ب",2,0],["وَبأى آونة أَزورك بَعدَما","حملت هجرك أَضعف الاجساد",36,"د",1,0],["وَبأى شيء تَستَقيم أَموره","قال المَلائكة الكِرام ظَهيره",37,"ه",1,0],["وَبِأَيِّما خَطْبٍ مُنِيتَ فَلَمْ تَكُنْ","سَكَّنْتَ مِنْهُ ما طَغى وَتَغَيَّضا",38,"ض",2,0],["وبايعوكِ بالتي","عزَّتْ عَلَى المطلِّب",39,"ب",1,0],["وبآيات القرآن عنوا","فاتئد فينا أخا الوهن",40,"ن",1,0],["وَبأيّ لبٍّ يُستطاعُ ومقولٍ","أَن ينكرَ المصنوع ما هو يصنعُ",41,"ع",1,0],["وبأيّ لحن والأغاريد","العذاب هجرن عودي",42,"د",2,0],["وبايعوه على أن ترخصوا دمكم","لتنقذوا الشرق من أنياب عدوان",43,"ن",1,0],["وَبِإِيّاهٍ إِذ بَدا لي كَإِيّايَ","إِلَيهِ عَرفَتُ مِنهُ دُعائي",44,"ي",1,0],["وَبائِنٍ المَيلِ وَمِل عَن مَلَلٍ","وَاِصحَب إِلَيهِ بِالرَواحِ مَن بَكَر",45,"ر",1,0],["وَبِأَيتامي اِحتَفِظ وَاِرغَب إِلى","صَفوَةٍ حَلّوا بِأَكنافِ الصُفَي",46,"ي",1,0],["وَبائع بعت روحي في مَحبّتهِ","وَقُلت يا أَيُّها المولى بِها اِحتكمِ",47,"م",1,1],["وبآية الكرسي سرّ كماله","في لفظها وحروفها نلاقاه",48,"ا",2,0],["وبأيامه تبَسَّمَتِ الدّنْ","يا سُروراً فلا اعترَاهَا قُطوبُ",49,"ب",1,0],["وبأيّ وقتٍ لم أقم لك شاكراً","يفنى الزمان وطيب ذكرك نامي",50,"م",2,0],["وبأيّ عدل أم بأيّ قضيةٍ","أنت المليُّ وأنت لا تقضيني",51,"ن",2,0],["وبايعوك عن خداعٍ كلُّهم","باسطُ كفٍّ تحتها قلبٌ نغِلْ",52,"ل",1,0],["وبأيمَنِ العلَمين من أبياتهم","ظبيٌ يُصادُ الظبيُ وهو يَصيدُ",53,"د",1,0],["وبأيّ جنح وغّى نجومُ رماحهِ","ما ضوَّأتْ ويروقها لم تخطف",54,"ف",1,0],["وبأيمَنِ الوادي غزالُ أراكةٍ","أصبو اليه واِنْ تزايدَ صَدُّه",55,"د",2,0],["وبأي الرقى توصلت","حتى سكن الصعب واستكان النفور",56,"ر",1,0],["وبأيِّ معنىً يا تُرى أصِفُ الذي","في الوصفِ من كلِّ المَعاني أعظَمُ",57,"م",1,0],["وَبائراً لا يزالُ الدّهرِ حِليَتهُ","وعاثِرَ الحظّ لولا فَرْطُ تحبيسي",58,"س",2,0],["وبأيدٍ يُرفَعْنَ في عَرَفاتٍ","داعياتٍ مخوِّلاً غفّارا",59,"ر",2,0],["وَبِأيّامه السَّعيدةِ أعطي","تُ لواءَ التّعديل والتّوحيدِ",60,"د",1,0],["وَبايَنتُ حَتّى صِرتُ لِلبينِ راكِباً","قَرى العَزمِ فَرداً مِثلَ ما اِنفَرَدَ النَصلُ",61,"ل",1,0],["وبأيمانهم على القرب آلوا","قصدوها فخابت الآمال",62,"ل",1,0],["وبأيمن العلمين من شرقيِّه","كم معهد قلبي إليه تلاحى",63,"ح",2,0],["وَبائِعٌ فَرَساً وَآخِذٌ غَنَماً","فَبَعضُها ماتَ وَالعَيبُ القَديمُ يُرى",64,"ر",2,0],["وبايعوا الوصيّ طائعينا","وأقبلوا عليه راغبينا",65,"ن",2,0],["وبايع الناس له بالكوفة","فحل فيهم مدة معروفة",65,"ه",1,0],["وَبأَيْمَنِ الوادي غَزالٌ ما بَدَا","إِلَّا وَيبْهَرني هَواهُ فَأُطْرِقُ",66,"ق",1,0],["وَبايعتهم يَد الأَفراح فَاِنشَرَحَت","مِنهُم صُدورٌ وما اِنفَكوا عَن الشُكر",67,"ر",1,0],["وَبِآية نسخت رُسوم مَواسم","لمحمد بن الظاهر السُلطان",68,"ن",1,0],["وبآيات الكتابِ كلها","وبما ضمنتَ منها الصحفا",69,"ف",2,0],["وبايعت ليلى في الخلاء ولم يكن","شهود على ليلى عدول مقانع",70,"ع",1,0],["وبايعوا واثقاً باللَه ثَمَّتَ في","عامِ الثمانِ قضى وسَمِّهِ عمرا",71,"ر",2,0],["وبايعوا بعدَهُ بالَله معتَصِماً","لعامِ إحدى وتسعين أزيل ورا",71,"ر",2,0],["وبأي تبيان أهنِّئُ معرضاً","لا يقبلنَّ شفاعة الأعياد",72,"د",1,0],["وبأي طب يستطاع علاج من","يستنكر البرهان وهو مجسد",73,"د",1,0],["وبأي الساحات يقتتل المف","ترسان الغرثان والمنهوم",74,"م",1,0],["وبأي سلطانٍ يتيه على الورى","من لا يمدُّ إلى الأخيذ يمينا",75,"ن",2,0],["وبآية الكرسي وآيات الشفا","والحفظ والتعويذ والأحراس",76,"س",1,0],["وبأي جارحة وصل","ت لوصفه نثراً ونظما",77,"م",2,0],["وبايعوه بيعة وثيقة","عرى وأعطوه عليها موثقا",78,"ق",2,0],["وبايمن الوادي المقدس مقعد","فيه استبان غوامض الاسرار",79,"ر",1,0],["وبايعتُ ليلى في الخلاء ولم يكن","شهودي على ليلى عدولٌ مقانعُ",80,"ع",1,1],["وبأيمنِ العلمين رب ملاحة","سدت على السلوانِ كل سبيلِ",81,"ل",1,0],["وباية الاحوال صفحك واجب","لاسم المسيح وحرمة القربان",82,"ن",1,0],["وبأيديهم الأسنَّة زُرقاً","ورقاق الظُّبا وصُمُّ الكُعوبِ",83,"ب",1,0],["وبايعوه بايمان يمانيةٍ","تناولت حسباً محضاً وإِيمانا",84,"ن",2,0],["وَبِأَيْمُنِ الأثَلاَتِ رَبْعٌ مَاحِلٌ","نِسْيَانُهُ وَالصَّبْرُ كُلٌّ مُعْوِزُ",85,"ز",1,0],["وبأيدهم قواض مواض","عودوها من الدما إغلالا",86,"ل",2,0],["وبأيام فتح مكة أضحى","دينه المستقيم رحب المداد",87,"د",1,0],["وبايعه على الهيجا رجال","رأوا موت النفوس حياتهنه",88,"ن",2,0],["وبأيمن العلمين أمثال لها","لا يستطيع أخو الغرام مزارها",89,"ر",3,0],["وبإيداعها لهُ السرَّ لطفٌ","وبتفويضها لهُ الأمر جبرُ",90,"ر",1,0],["وبأيّ أرضٍ قد سرى ففعاله","عن أهلها عين الحوادثِ تَطبِق",91,"ق",1,0],["وبأيّما وقتٍ حضرتُ فإنَّه","للزهو وقت بالسعود أ