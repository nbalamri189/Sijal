مَن يَجودُ وَيُسأَلُ",1,"ل",1,0],["كَالنَصلِ يَمضي صاقِلٌ","عَنهُ وَيَأتي صاقِلُ",2,"ل",1,0],["كَالناشِطِ اِمتَنَعَت مَوارِدُهُ","وَنَأَت عَلَيهِ الرَوضَةُ الأُنُفُ",3,"ف",1,0],["كالنّارِ إنْ حرَّكْتَهُ في حُضْرِهِ","وإنْ تُسكِّنْهُ فكالْماءِ جَرى",4,"ا",1,0],["كَالنَّحْلِ فِي رِقَّةِ خَصْرٍ وَفِي","لَسْعٍ مَتَى شَاءَ وَمَقْلُوبِهِ",5,"ه",1,0],["كَالنَّحْلِ طُفْنَ بِزَهْرَةٍ فَلَسَعْنَهَا","وَرَشَفْنَ مِنْهَا مَا رَشَفْنَ بِرغْمِها",6,"م",3,0],["كَالنَّجْمِ بُعْداً وَتُدْنِيه مُؤَانَسَةٌ","كَاللَّيْثِ بَأْساً وَفِيهِ حِلْمُ إِنْسَانِ",7,"ن",1,0],["كالنهر الجاري الذي تغيّرت","أوضاعه في الأرض كلما جرى",8,"ا",1,0],["كَالنيبِ خَرَّمَها الغَمائِمُ بَعدَما","ثَلَّطنَ عَن حُرُضٍ بِجَوفِ أُثالِ",9,"ل",1,0],["كَالنارِ وَالشَمسِ الَّتي قالَت لَه","بَيدَ اللُوَيمِسِ عالِماً ما يَلمِسُ",10,"س",1,0],["كالناطقات الصادقا","ت الواسعات من الذخائرْ",11,"ر",1,1],["كالنجم في صافي الغدير تظنه","أدنى منالاً وهو أبعد مأخذا",12,"ذ",2,0],["كالنخلِ يُشْرعُ شوكاً لا يذودُ بهِ","عن حملِهِ كفَّ جانٍ فهو مُنتهَبُ",13,"ب",1,0],["كالنخلِ يُشْرعُ شوكاً لا يذودُ به","أيدي الجُناةِ ولا يحميهمُ الرُّطَبا",14,"ب",2,0],["كالنار تحرقُ من تعرض لفحَها","وتكون مرتفَقَ امرئٍ متنوِّرِ",15,"ر",1,0],["كَالنارِ يَلتَهِمُ العَواطِفَ عَقلُهُ","فَيُميتُها وَيَموتُ في صَحرائِهِ",16,"ه",1,0],["كَالنارِ تَأكُلُ أَكلاً ما يُصادِفُها","وَالسَيلُ يَجرُفُ ما يَلقاهُ مِندَفِعا",17,"ع",2,0],["كَالنارِ إِلّا أَنَّها ما أُوقِدَت","في الكَأسِ إِلّا أَطفَأَت نيرانا",18,"ن",2,0],["كالنبت من مائه وتربته","والشمس قد جاءنا بأزهارِ",19,"ر",1,0],["كَالنورِ أَوقَدَهُ طَلُّ الرَبيعِ ضُحىً","في عاطِلٍ مِن رِياضِ الحَزنِ أَو حالِ",20,"ل",1,0],["كالنَّخلِ يُبْدي الطَّلْعَ من أثمارِه","حيناً ويُخفي الغَضَّ من جُمَّارِه",21,"ر",2,0],["كَالنارِ مِنهُ رِياحُ المَوتِ قَد عَصَفَت","لَمّا رَوى ماؤُهُ أَرضَ الوَغى بِدَمِ",22,"م",1,0],["كَالنارِ بارِدَةً في عودِها وَلَها","إِن فارَقَتهُ اِشتِعالٌ لَيسَ بِالواني",23,"ن",2,0],["كَالنَجمِ إِن سافَرتَ كانَ مُواكِباً","وَإِذا حَطَطَت الرَحلَ كانَ جَليسا",24,"س",2,0],["كَالنَبتِ لا يَلقى الغَمامَ وَإِن غَدا","مُتَنَعِّماً بِرُضابِهِ المُتَرَشَّفِ",25,"ف",1,0],["كَالنَجمِ حَلَّ مُحَسِّناً في أُفقِهِ","واِنقَضَّ مِنهُ حامِياً وَمُحَصَّنا",26,"ن",2,0],["كَالنَجمِ أَحرَقَ مارِداً وَسَقى الثَرى","مِن نَوئِهِ رَيّاً وَنَوَّرَ غَيهَبا",27,"ب",2,0],["كَالنَجمِ قَد لَجَّ في الغُروبِ وَقَد","أَنذَرَ بِالصُبحِ قَرعُ ناقوسِ",28,"س",1,0],["كَالنابِلَينِ غَدَت سِهامُهُما","لَيسَت مُرَيَّشَةً وَلا قُذّا",29,"ذ",2,0],["كالنجمِ في خفقٍ وفي ومضِ","متفرداً بعوالم السُّدُمِ",30,"م",1,1],["كالنهر يقتلع الأسدادَ منطلقاً","حراً ويجري حبيساً بين شطآنِ",31,"ن",1,0],["كَالنَّارِ تَخْتَدِعُ الْفَراشَ بِحُسْنِهَا","فَيَنَالُ مِنْهُ الْبُؤْسُ إِنْ لَمْ يَعْطَبِ",32,"ب",1,0],["كَالنَّدَى فِي وَحْدَةِ اللَّفظِ لَهُ","مَعْنَيَانِ اقْتَسَمَا حُسْنَ الْجِوَارِ",33,"ر",1,0],["كَالنِّيلِ مَدَّ فُرُوعاً","وَكُلُّ فَرْعٍ لِضِفَّهْ",34,"ف",2,0],["كَالنُّورِ فِي بَلّورَةٍ","حَسْنَاء يَشْتَعِلُ اسْتِعَالاَ",35,"ل",2,0],["كالنعجة البيضاء حين مرورها","بين الصخور وشائك العيدان",36,"ن",1,0],["كالنغم الرنان في آلة","فارغة تحت يد الضاربين",37,"ن",1,0],["كَالنارِ وَالشَمسِ الَّتي قالَت لَها","بَيدَ اللُوَيمِسِ عالِماً ما يَلمِسُ",38,"س",1,0],["كالنَّحلِ في رقة خصرٍ وفي","لسع متى تشاء ومقلوبَه",39,"ه",1,0],["كالنعش ، يستلقي عليه الدّجى","وتعجن السحب عليه الوحول",40,"ل",1,0],["كالنَّاسِ للحُفُراتِ مَرجِعُه","ومِنَ النِّطافِ النُزْرِ مولِده",41,"د",2,0],["كالنار تحرق نفسها وخمودها","حكم طبيعي وإن صعد اللهب",42,"ب",1,0],["كالنهر عمق مجراه تحدره","والنار ألعجها ريح وعيدان",43,"ن",1,0],["كالنِّقسِ ليلتُه وطِرسٍ يومُهُ","والنُّجحُ يَكتبُ والسعادةُ تختِمُ",44,"م",1,0],["كالنوم بين جفون من فقد الكرى","سَهَرا لما يلقاه من أَوْصابه",45,"ب",2,0],["كالنوم بينَ أجفانٍ أَضَرَّ بها","طولُ السُّهاد كبُرْءٍ بعد إضرار",46,"ر",1,0],["كالناصبِ المجادل المصارعِ","قَرنتهُ باِسمٍ ووصفٍ ساطعِ",47,"ع",1,0],["كالنفسِ تنسى الهوى في لهوها","وليسَ ينسى الأجلُ العاجلُ",48,"ل",1,0],["كالنمل تأتيه الوفود لأنه","بالحمد اضحى آية الشعراء",49,"ا",2,0],["كالنسر أراده سهم فاستعد له","عذراً وقال رمى قلبي به ريشي",50,"ش",2,0],["كالنَّثرَةِ والشِّعرَى 