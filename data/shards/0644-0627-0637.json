{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[82,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[23,"لاطت قريش حياض المجد فافترطت","https://www.aldiwan.net/poem21446.html","البسيط"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"شغل القرائح بالدعاء الصالح","https://www.aldiwan.net/poem18502.html","الكامل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[85,"محجوب إن جئت الحجاز","https://www.aldiwan.net/poem63699.html","مجزوء الكامل"],[61,"لا كان عبد الحميد من رجل","https://www.aldiwan.net/poem51367.html","المنسرح"],[61,"هل الصبر مجد حين أدرع الصبرا","https://www.aldiwan.net/poem51671.html","الطويل"],[80,"يا صورة الحسن التي طلعت","https://www.aldiwan.net/poem31267.html","أحذ الكامل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[44,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[87,"ذهب الصبا وتولت الأيام","https://www.aldiwan.net/poem8289.html","الكامل"],[87,"أسل الديار عن الحبيب وفي الحشا","https://www.aldiwan.net/poem8290.html","الكامل"],[74,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[102,"لا ما أعجبه","https://www.aldiwan.net/poem33032.html","مجزوء الرجز"],[13,"أبعد قتيل العوص آسى على فتاً","https://www.aldiwan.net/poem2217.html","الطويل"],[52,"تعاهدتك العهاد يا طلل","https://www.aldiwan.net/poem26766.html","المنسرح"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55032","السريع"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[106,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[13,"أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","https://www.poetsgate.com/ViewPoem.aspx?id=180772",""],[51,"الخيرُ مَصْنوعٌ بصانِعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30078",""]],"verses":[["لَأُطعِمَنَّ اللَيلَ عيدِيَّةً","ضابِعَةً تَكسو البَرى بِاللُغام",0,"م",1,0],["لا طَوَت عَنّا اللَيالي مَن غَدا","لِلوَرى غَيثاً وَلِلدينِ قِواما",1,"م",2,0],["لا طَحسُنُ النيقَةِ في قاطِعٍ","مَن لَيسَ لِلقاطِعِ بِالحامِلِ",2,"ل",1,0],["لا طَرَقَ الداءُ مَن بِصِحَّتِهِ","يَصِحُّ مِنّا الرَجاءُ وَالأَمَلُ",3,"ل",1,0],["لِأَطوَلِكُم طَولاً إِذا المُزنُ أَصبَحَت","غَوارِزَ لا يُعدَمنَ خَلفاً مُجَدَّدا",4,"د",2,0],["لا طَعنَ نَسطيعُ وَلا ضِرابا","مُقتَحِمٌ عَلى الأُسودِ الغابا",5,"ب",2,0],["لَأَطوَلِهِم إِذا رَكِبوا رِماحاً","وَأَعلاهُم إِذا نَزَلوا قِبابا",6,"ب",2,0],["لا طائِشٌ عِندَ الهِياجِ وَلا","رَثُّ السِلاحِ مُغادِرٌ أَعزَل",7,"ل",1,0],["لا طارَ بي حَظٌّ إِلى غايَةٍ","إِن لَم أَكُن مِنكَ مَريشَ الجَناح",8,"ح",1,0],["لا طَلَبتُ الثَأرَ مِنها ظالِماً","وَأَنا القاتلُ نَفسي بِيَدي",9,"د",2,0],["لا طَامِعٌ فِي غَيْرِ مَا مَطْمَعٍ","أَوْ زَاعِمٌ فِي غَيْرِ مَا مَزْعَمِ",10,"م",1,0],["لاطَت قُرَيشٌ حِياضَ المَجدِ فَاِفتَرَطَت","سَهمٌ فَأَصبَحَ مِنهُ حَوضُها صَفِرا",11,"ر",2,1],["لا طبّ بعدَ وُقوعهِ لهوىً","والكيّ آخر رتبة الطب",12,"ب",1,0],["لا طعنَ في قلم شرعتَ بدولةٍ","إن كانَ يطعنُ في السماك الرَّامح",13,"ح",1,0],["لا طوْقَ لي بالصبر عنه وطوْقها","بالزّهر بين مدبَّجٍ وموشّع",14,"ع",1,0],["لا طالباً رزقاً سوى مُسْكةٍ","ولو تعدّت ذاك عنَّفْتُها",15,"ت",3,0],["لأطْفأ ناراً قد تعالى شُوَاظُهَا","وأوْقَدَ نُوراً كاد لولاه يَخْمَدُ",16,"د",1,0],["لا طِبَّ إِلّا جَدُّهُ","شافي العُقولِ مِنَ الضَلالَه",17,"ل",2,0],["لاط به والتزمت وزنته","فناكني والبصاق من عندي",18,"ي",1,0],["لأّطفأتُما تلك النُّجومَ بأَسرِها","ودنَّستُما تلكَ المَطارِفَ والأُزْرا",19,"ر",2,0],["لا طابَ لي طِيبُ الحياة ولا","خَطَرَ الكرى بضميرِ أجفاني",20,"ن",2,0],["لا طائِشٌ تَهفو خَلائِقُهُ وَلا","خَشِنُ الوَقارِ كَأَنَّهُ في مَحفِلِ",21,"ل",1,0],["لا طالِبو جَدواكَ أَكدَوا وَلا","عافيكَ مِنهُم لِلَّيالي فَريس",22,"س",1,0],["لا طَائِرٌ يَنْجُو وَلا ذُو مِخْلَبٍ","يَبْقَى وَعَاقِبَةُ الْحَيَاة حِمَامُ",23,"م",1,0],["لا طَائِرٌ يَنْجُو وَلا ذُو مِخْلَبٍ","يَبْقَى وَعَاقِبَةُ النُّفُوسِ حِمَامُ",24,"م",1,0],["لاطَمتُ لُجَّتَهُ بِمَوجَةِ أَشهَبٍ","يُرمى بِها بَحرُ الظَلامِ فَتَرتَمي",25,"م",2,0],["لا طابَ لي عَيش إِذا","رَضيت مِنها بَدَلا",26,"ل",2,0],["لَأَطرُدُ نَهباً أَو نَزورُ بِفِتيَةٍ","بِأَيمانِهِم سُمرُ القَنا وَالعَقائِقُ",27,"ق",1,0],["لا طالَ لَيلي وَلا نَهاري مَن","يَسكُنُني أَو يَرُدَّهُم قَفَلُ",28,"ل",1,0],["لا طِيبَ يَعْدِلُ تُرْباً ضّمَّ أَعظُمَهُ","طُوبَى لِمُنْتَشِقٍ منهُ وَمُلْتَثِمِ",29,"م",1,0],["لأُطبِقتَ إطباقَ المَحارَةِ فاحتَفِظْ","بلؤلؤةِ المَجْدِ الحَقيقَةِ بالخزْنِ",30,"ن",1,0],["لاَ طُبَّ فِي رَأُسٍ بِهِ اعْلَوْلَقتْ","كَأَخْذِ ذَاكَ الرَّأُسِ بِالسَّيْفِ",31,"ف",1,0],["لا طيب ولا زهر","فقولي إنه القمر!",32,"ر",1,0],["لا طاب عيشٌ، يا هزبرُ، لنا، ولا","لك، إن رضيت بذلَّةٍ ورضينا",33,"ن",2,0],["لأَطْرُدَ نَهْبَاً أَوْ نَرُودَ بِفِتْيَةٍ","بِأَيْمَانِهِمْ سُمْرُ الْقَنَى وَالْفَتَائِقُ",34,"ق",1,0],["لا ُطمِعَنَّك فيه رأفتُهُ","إنَّ المطامع تنصِبُ الشَّبَكا",35,"ك",2,0]]}