{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[82,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[23,"لاطت قريش حياض المجد فافترطت","https://www.aldiwan.net/poem21446.html","البسيط"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"شغل القرائح بالدعاء الصالح","https://www.aldiwan.net/poem18502.html","الكامل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[85,"محجوب إن جئت الحجاز","https://www.aldiwan.net/poem63699.html","مجزوء الكامل"],[61,"لا كان عبد الحميد من رجل","https://www.aldiwan.net/poem51367.html","المنسرح"],[61,"هل الصبر مجد حين أدرع الصبرا","https://www.aldiwan.net/poem51671.html","الطويل"],[80,"يا صورة الحسن التي طلعت","https://www.aldiwan.net/poem31267.html","أحذ الكامل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[44,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[87,"ذهب الصبا وتولت الأيام","https://www.aldiwan.net/poem8289.html","الكامل"],[87,"أسل الديار عن الحبيب وفي الحشا","https://www.aldiwan.net/poem8290.html","الكامل"],[74,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[102,"لا ما أعجبه","https://www.aldiwan.net/poem33032.html","مجزوء الرجز"],[13,"أبعد قتيل العوص آسى على فتاً","https://www.aldiwan.net/poem2217.html","الطويل"],[52,"تعاهدتك العهاد يا طلل","https://www.aldiwan.net/poem26766.html","المنسرح"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55032","السريع"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[106,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[13,"أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","https://www.poetsgate.com/ViewPoem.aspx?id=180772",""],[109,"سابع المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=36761",""],[51,"الخيرُ مَصْنوعٌ بصانِعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30078",""],[129,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[144,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[156,"لمن الرسوم برامتين بلينا","https://www.aldiwan.net/poem55540.html","الكامل"],[170,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[222,"أرخصت يوم فراقك الدمعا","https://www.aldiwan.net/poem55275.html","أحذ الكامل"],[230,"يا من تعجب من مشيبي عاجلا","https://www.aldiwan.net/poem51228.html","الكامل"],[233,"لا والربيع النضير","https://www.aldiwan.net/poem14730.html","المجتث"],[233,"لا طيب من ذكري حبيب ومنزل","https://www.aldiwan.net/poem14828.html","الطويل"],[236,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[236,"أي نار ضرمت في كبدي","https://www.aldiwan.net/poem32094.html","الرمل"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[276,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[276,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[298,"لا طرقتك الخطوب والعلل","https://www.aldiwan.net/poem33193.html","المنسرح"],[304,"لما تناهت في البلاغةِ ربتة","https://www.aldiwan.net/poem57653.html","الكامل"],[365,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[433,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[433,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[433,"عني فلم يبق امرؤ حاضر","https://www.aldiwan.net/poem12785.html","السريع"],[442,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[459,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[459,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[459,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[459,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[462,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[462,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[465,"ما لي بألحاظ الظباء يدان","https://www.aldiwan.net/poem3424.html","عموديه"],[465,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[552,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[559,"مرج البحرين إذ يلتقيان","https://www.aldiwan.net/poem33756.html","الرمل"],[559,"أواه من سار فيكم","https://www.aldiwan.net/poem33796.html","المجتث"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[576,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[587,"لا طل صوب الغوادي ساحتي قطنا","https://www.aldiwan.net/poem17791.html","البسيط"]],"verses":[["لَأُطعِمَنَّ اللَيلَ عيدِيَّةً","ضابِعَةً تَكسو البَرى بِاللُغام",0,"م",1,0],["لا طَوَت عَنّا اللَيالي مَن غَدا","لِلوَرى غَيثاً وَلِلدينِ قِواما",1,"م",2,0],["لا طَحسُنُ النيقَةِ في قاطِعٍ","مَن لَيسَ لِلقاطِعِ بِالحامِلِ",2,"ل",1,0],["لا طَرَقَ الداءُ مَن بِصِحَّتِهِ","يَصِحُّ مِنّا الرَجاءُ وَالأَمَلُ",3,"ل",1,0],["لِأَطوَلِكُم طَولاً إِذا المُزنُ أَصبَحَت","غَوارِزَ لا يُعدَمنَ خَلفاً مُجَدَّدا",4,"د",2,0],["لا طَعنَ نَسطيعُ وَلا ضِرابا","مُقتَحِمٌ عَلى الأُسودِ الغابا",5,"ب",2,0],["لَأَطوَلِهِم إِذا رَكِبوا رِماحاً","وَأَعلاهُم إِذا نَزَلوا قِبابا",6,"ب",2,0],["لا طائِشٌ عِندَ الهِياجِ وَلا","رَثُّ السِلاحِ مُغادِرٌ أَعزَل",7,"ل",1,0],["لا طارَ بي حَظٌّ إِلى غايَةٍ","إِن لَم أَكُن مِنكَ مَريشَ الجَناح",8,"ح",1,0],["لا طَلَبتُ الثَأرَ مِنها ظالِماً","وَأَنا القاتلُ نَفسي بِيَدي",9,"د",2,0],["لا طَامِعٌ فِي غَيْرِ مَا مَطْمَعٍ","أَوْ زَاعِمٌ فِي غَيْرِ مَا مَزْعَمِ",10,"م",1,0],["لاطَت قُرَيشٌ حِياضَ المَجدِ فَاِفتَرَطَت","سَهمٌ فَأَصبَحَ مِنهُ حَوضُها صَفِرا",11,"ر",2,1],["لا طبّ بعدَ وُقوعهِ لهوىً","والكيّ آخر رتبة الطب",12,"ب",1,0],["لا طعنَ في قلم شرعتَ بدولةٍ","إن كانَ يطعنُ في السماك الرَّامح",13,"ح",1,0],["لا طوْقَ لي بالصبر عنه وطوْقها","بالزّهر بين مدبَّجٍ وموشّع",14,"ع",1,0],["لا طالباً رزقاً سوى مُسْكةٍ","ولو تعدّت ذاك عنَّفْتُها",15,"ت",3,0],["لأطْفأ ناراً قد تعالى شُوَاظُهَا","وأوْقَدَ نُوراً كاد لولاه يَخْمَدُ",16,"د",1,0],["لا طِبَّ إِلّا جَدُّهُ","شافي العُقولِ مِنَ الضَلالَه",17,"ل",2,0],["لاط به والتزمت وزنته","فناكني والبصاق من عندي",18,"د",2,0],["لأّطفأتُما تلك النُّجومَ بأَسرِها","ودنَّستُما تلكَ المَطارِفَ والأُزْرا",19,"ر",2,0],["لا طابَ لي طِيبُ الحياة ولا","خَطَرَ الكرى بضميرِ أجفاني",20,"ن",2,0],["لا طائِشٌ تَهفو خَلائِقُهُ وَلا","خَشِنُ الوَقارِ كَأَنَّهُ في مَحفِلِ",21,"ل",1,0],["لا طالِبو جَدواكَ أَكدَوا وَلا","عافيكَ مِنهُم لِلَّيالي فَريس",22,"س",1,0],["لا طَائِرٌ يَنْجُو وَلا ذُو مِخْلَبٍ","يَبْقَى وَعَاقِبَةُ الْحَيَاة حِمَامُ",23,"م",1,0],["لا طَائِرٌ يَنْجُو وَلا ذُو مِخْلَبٍ","يَبْقَى وَعَاقِبَةُ النُّفُوسِ حِمَامُ",24,"م",1,0],["لاطَمتُ لُجَّتَهُ بِمَوجَةِ أَشهَبٍ","يُرمى بِها بَحرُ الظَلامِ فَتَرتَمي",25,"م",2,0],["لا طابَ لي عَيش إِذا","رَضيت مِنها بَدَلا",26,"ل",2,0],["لَأَطرُدُ نَهباً أَو نَزورُ بِفِتيَةٍ","بِأَيمانِهِم سُمرُ القَنا وَالعَقائِقُ",27,"ق",1,0],["لا طالَ لَيلي وَلا نَهاري مَن","يَسكُنُني أَو يَرُدَّهُم قَفَلُ",28,"ل",1,0],["لا طِيبَ يَعْدِلُ تُرْباً ضّمَّ أَعظُمَهُ","طُوبَى لِمُنْتَشِقٍ منهُ وَمُلْتَثِمِ",29,"م",1,0],["لأُطبِقتَ إطباقَ المَحارَةِ فاحتَفِظْ","بلؤلؤةِ المَجْدِ الحَقيقَةِ بالخزْنِ",30,"ن",1,0],["لاَ طُبَّ فِي رَأُسٍ بِهِ اعْلَوْلَقتْ","كَأَخْذِ ذَاكَ الرَّأُسِ بِالسَّيْفِ",31,"ف",1,0],["لا طيب ولا زهر","فقولي إنه القمر!",32,"ر",1,0],["لا طاب عيشٌ، يا هزبرُ، لنا، ولا","لك، إن رضيت بذلَّةٍ ورضينا",33,"ن",2,0],["لأَطْرُدَ نَهْبَاً أَوْ نَرُودَ بِفِتْيَةٍ","بِأَيْمَانِهِمْ سُمْرُ الْقَنَى وَالْفَتَائِقُ",34,"ق",1,0],["لاطاح من جور الزمان أرتكيله","أرسم على مبدا مطيحه نهايات",35,"ت",1,0],["لا ُطمِعَنَّك فيه رأفتُهُ","إنَّ المطامع تنصِبُ الشَّبَكا",36,"ك",2,0],["لا طامِعٌ ولئن طمعت فإنما","طَمَعِى يؤولُ إلى جَدَى هتَّانِ",37,"ن",1,0],["لا طَوَت ظِلَّكَ الظَليلَ اللَيالي","ما تَوالى فِطرٌ وَكَرَّ صِيامُ",38,"م",1,0],["لاَ طلَّ مِنْ دَمْعِي عَلَى أَطْلالِها","مَا لَمْ يَكُنْ بِفنائِها يُغْنِينا",39,"ن",2,0],["لأَطلُبَنَّ العُلى جَهدي طِلابَ فَتىً","يَدوسُ بِالعَزمِ هامَ السَّبعَةِ الشُهُبِ",40,"ب",1,0],["لا طامعاً في ثلم عفتها","بل كي أهدىء من الروعا",41,"ع",2,0],["لا طال دهرٌ ليس يَزْرا جاهلاً","ويُصيب بالمكروه كلَّ لبيب",42,"ب",1,0],["لا طامِعاً في قَليلٍ","مِنهُ وَلا في كَثيرِ",43,"ر",1,0],["لا طيبَ مِن ذِكري حَبيب وَمَنزِل","بِسَقطِ اللَوى دارٌ بِشَرقِيِّ إربلِ",44,"ل",1,1],["لَأَطيلَنَّ مَدى الحُز","نِ لِمَن طالَ اِستِتارُه",45,"ر",2,0],["لَأُطِلَنَّ مَدى الغَمِّ عَلى","صاحِبِ العُمرِ القَصيرِ الآمَدِ",46,"د",1,0],["لا طارقٌ يطرق الأعلاجَ من كثبٍ","وإن دعونا فلا موسى يلبينا",47,"ن",2,0],["لا طِيبَ في الأَسْحارِ والآصالِ مُذْ","طَابَ الثَّرَى مِنْهُ بِخَيْرِ إِمامِ",48,"م",1,0],["لا طيبَ حينَ يُعبي عَسكراً لِوَغىً","ما لم يكن من دَم الكُفارِ يَعبَؤُهُ",49,"ا",2,0],["لا طرقتكَ الخطوبُ والعِلَلُ","ولا اِعتراكَ الفتورُ والكسلُ",50,"ل",1,1],["لا طاقةٌ من بعدها لأولي النهى","إن يدخلوا في مثل هذا الباب",51,"ب",1,0],["لا طالَبَ اللّهُ الأحِبّةَ إنّهم","نامُوا عن الصّبِّ الكئيب وأسهَروا",52,"ر",3,0],["لا طافَ بِي الطَّيْفُ المُلِمَّ فإنَّني","قد كُنْتُ لا أَهْوَى الزِّيارَةَ زُورا",53,"ر",2,0],["لا طرقَتْ ربْعَكُمُ غارةٌ","يسألُ منها مَعشَري عن دَمي",54,"م",2,0],["لا طرباً منه ولا خِفّةً","لكن لكي يسكرَ أو يرْقُدا",55,"د",2,0],["لا طارف عاد عندي لا ولا تلد","في جدة فبلي يا جدة جدد",56,"د",1,1],["لا طائش الحِلم إن هفا الطيشُ بال","ناس ولا ضيِّقٌ إذا برِمُوا",57,"م",3,0],["لا طفتِ الأرضَ بها مزنةٌ","تصفَّقتْ من مائها الهاطلِ",58,"ل",1,0],["لا طلقَاء منعَمٌ عليهمُ","ولا يحَارون إذا الناصر قَلّْ",59,"ل",1,0],["لا طاب نفساً بالنوالِ ولا","مخَضَ المودةَ زُبدةَ الصَّدرِ",60,"ر",1,0],["لا طارفُ النعماءِ منزعجٌ","فيها ولا مستحدثُ الفخرِ",60,"ر",1,0],["لا طامعاً تُفسدُ الآراءَ بُغيَتُه","ولا دنيَّ الأماني فهو مُغْتنمُ",61,"م",1,0],["لا طعم بعد أبي الأغَرُّ لحالةٍ","وإن اكتست من رونقٍ وبهاءِ",62,"ا",2,0],["لا طاقةٌ لمتيّم ذي صبوةٍ","بأسود ذاك الحيّ والغزلانِ",63,"ن",1,0],["لأطال ليلي حبُّ ليلى عامرٍ","فعلام لا تحنو على مجنونها",64,"ن",3,0],["لا طَرَقَ الطّيفُ الّذي كان مِنْ","أكبر همّي أنّه يطرُقُ",65,"ق",1,0],["لا طغا هذا على هذا فبانْ","لا ولا هذا على هذا فهانْ",66,"ن",1,0],["لا طبع جسم شمال","وجهل نفس يمينِ",67,"ن",1,0],["لا طائِشٌ قاقٌ وَلا عَيِيُّ","بِالطَعنِ إِذ طاعَنَها نُكرِيُّ",68,"ي",1,0],["لا طاقةً لي بما أَوْلَيْتَ مِنْ كَرَم","يُثرى ومَا لِي بما أَوليتَ مِن قِبَلِ",69,"ل",1,0],["لا طَلّ صَوْبَ الغَوادِي سَاحَتي قطنا","ولا رَعى اللّه مَنْ في أَرْضِها قطنا",70,"ن",2,1]]}