//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79322&r=&rc=96",""],[6238,"فجر الخليل...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86776&r=&rc=5",""]],"verses":[["لَأُطعِمَنَّ اللَيلَ عيدِيَّةً","ضابِعَةً تَكسو البَرى بِاللُغام",0,"م",1,0],["لا طَوَت عَنّا اللَيالي مَن غَدا","لِلوَرى غَيثاً وَلِلدينِ قِواما",1,"م",2,0],["لا طَحسُنُ النيقَةِ في قاطِعٍ","مَن لَيسَ لِلقاطِعِ بِالحامِلِ",2,"ل",1,0],["لا طَرَقَ الداءُ مَن بِصِحَّتِهِ","يَصِحُّ مِنّا الرَجاءُ وَالأَمَلُ",3,"ل",1,0],["لِأَطوَلِكُم طَولاً إِذا المُزنُ أَصبَحَت","غَوارِزَ لا يُعدَمنَ خَلفاً مُجَدَّدا",4,"د",2,0],["لا طَعنَ نَسطيعُ وَلا ضِرابا","مُقتَحِمٌ عَلى الأُسودِ الغابا",5,"ب",2,0],["لَأَطوَلِهِم إِذا رَكِبوا رِماحاً","وَأَعلاهُم إِذا نَزَلوا قِبابا",6,"ب",2,0],["لا طائِشٌ عِندَ الهِياجِ وَلا","رَثُّ السِلاحِ مُغادِرٌ أَعزَل",7,"ل",1,0],["لا طارَ بي حَظٌّ إِلى غايَةٍ","إِن لَم أَكُن مِنكَ مَريشَ الجَناح",8,"ح",1,0],["لا طَلَبتُ الثَأرَ مِنها ظالِماً","وَأَنا القاتلُ نَفسي بِيَدي",9,"د",2,0],["لا طَامِعٌ فِي غَيْرِ مَا مَطْمَعٍ","أَوْ زَاعِمٌ فِي غَيْرِ مَا مَزْعَمِ",10,"م",1,0],["لاطَت قُرَيشٌ حِياضَ المَجدِ فَاِفتَرَطَت","سَهمٌ فَأَصبَحَ مِنهُ حَوضُها صَفِرا",11,"ر",2,1],["لا طبّ بعدَ وُقوعهِ لهوىً","والكيّ آخر رتبة الطب",12,"ب",1,0],["لا طعنَ في قلم شرعتَ بدولةٍ","إن كانَ يطعنُ في السماك الرَّامح",13,"ح",1,0],["لا طوْقَ لي بالصبر عنه وطوْقها","بالزّهر بين مدبَّجٍ وموشّع",14,"ع",1,0],["لا طالباً رزقاً سوى مُسْكةٍ","ولو تعدّت ذاك عنَّفْتُها",15,"ت",3,0],["لأطْفأ ناراً قد تعالى شُوَاظُهَا","وأوْقَدَ نُوراً كاد لولاه يَخْمَدُ",16,"د",1,0],["لا طِبَّ إِلّا جَدُّهُ","شافي العُقولِ مِنَ الضَلالَه",17,"ل",2,0],["لاط به والتزمت وزنته","فناكني والبصاق من عندي",18,"د",2,0],["لأّطفأتُما تلك النُّجومَ بأَسرِها","ودنَّستُما تلكَ المَطارِفَ والأُزْرا",19,"ر",2,0],["لا طابَ لي طِيبُ الحياة ولا","خَطَرَ الكرى بضميرِ أجفاني",20,"ن",2,0],["لا طائِشٌ تَهفو خَلائِقُهُ وَلا","خَشِنُ الوَقارِ كَأَنَّهُ في مَحفِلِ",21,"ل",1,0],["لا طالِبو جَدواكَ أَكدَوا وَلا","عافيكَ مِنهُم لِلَّيالي فَريس",22,"س",1,0],["لا طَائِرٌ يَنْجُو وَلا ذُو مِخْلَبٍ","يَبْقَى وَعَاقِبَةُ الْحَيَاة حِمَامُ",23,"م",1,0],["لا طَائِرٌ يَنْجُو وَلا ذُو مِخْلَبٍ","يَبْقَى وَعَاقِبَةُ النُّفُوسِ حِمَامُ",24,"م",1,0],["لاطَمتُ لُجَّتَهُ بِمَوجَةِ أَشهَبٍ","يُرمى بِها بَحرُ الظَلامِ فَتَرتَمي",25,"م",2,0],["لا طابَ لي عَيش إِذا","رَضيت مِنها بَدَلا",26,"ل",2,0],["لَأَطرُدُ نَهباً أَو نَزورُ بِفِتيَةٍ","بِأَيمانِهِم سُمرُ القَنا وَالعَقائِقُ",27,"ق",1,0],["لا طالَ لَيلي وَلا نَهاري مَن","يَسكُنُني أَو يَرُدَّهُم قَفَلُ",28,"ل",1,0],["لا طِيبَ يَعْدِلُ تُرْباً ضّمَّ أَعظُمَهُ","طُوبَى لِمُنْتَشِقٍ منهُ وَمُلْتَثِمِ",29,"م",1,0],["لأُطبِقتَ إطباقَ المَحارَةِ فاحتَفِظْ","بلؤلؤةِ المَجْدِ الحَقيقَةِ بالخزْنِ",30,"ن",1,0],["لاَ طُبَّ فِي رَأُسٍ بِهِ اعْلَوْلَقتْ","كَأَخْذِ ذَاكَ الرَّأُسِ بِالسَّيْفِ",31,"ف",1,0],["لا طيب ولا زهر","فقولي إنه القمر!",32,"ر",1,0],["لا طاب عيشٌ، يا هزبرُ، لنا، ولا","لك، إن رضيت بذلَّةٍ ورضينا",33,"ن",2,0],["لأَطْرُدَ نَهْبَاً أَوْ نَرُودَ بِفِتْيَةٍ","بِأَيْمَانِهِمْ سُمْرُ الْقَنَى وَالْفَتَائِقُ",34,"ق",1,0],["لاطاح من جور الزمان أرتكيله","أرسم على مبدا مطيحه نهايات",35,"ت",1,0],["لا ُطمِعَنَّك فيه رأفتُهُ","إنَّ المطامع تنصِبُ الشَّبَكا",36,"ك",2,0],["لا طامِعٌ ولئن طمعت فإنما","طَمَعِى يؤولُ إلى جَدَى هتَّانِ",37,"ن",1,0],["لا طَوَت ظِلَّكَ الظَليلَ اللَيالي","ما تَوالى فِطرٌ وَكَرَّ صِيامُ",38,"م",1,0],["لاَ طلَّ مِنْ دَمْعِي عَلَى أَطْلالِها","مَا لَمْ يَكُنْ بِفنائِها يُغْنِينا",39,"ن",2,0],["لأَطلُبَنَّ العُلى جَهدي طِلابَ فَتىً","يَدوسُ بِالعَزمِ هامَ السَّبعَةِ الشُهُبِ",40,"ب",1,0],["لا طامعاً في ثلم عفتها","بل كي أهدىء من الروعا",41,"ع",2,0],["لا طال دهرٌ ليس يَزْرا جاهلاً","ويُصيب بالمكروه كلَّ لبيب",42,"ب",1,0],["لا طامِعاً في قَليلٍ","مِنهُ وَلا في كَثيرِ",43,"ر",1,0],["لا طيبَ مِن ذِكري حَبيب وَمَنزِل","بِسَقطِ اللَوى دارٌ بِشَرقِيِّ إربلِ",44,"ل",1,1],["لَأَطيلَنَّ مَدى الحُز","نِ لِمَن طالَ اِستِتارُه",45,"ر",2,0],["لَأُطِلَنَّ مَدى الغَمِّ عَلى","صاحِبِ العُمرِ القَصيرِ الآمَدِ",46,"د",1,0],["لا طارقٌ يطرق الأعلاجَ من كثبٍ","وإن دعونا فلا موسى يلبينا",47,"ن",2,0],["لا طِيبَ في الأَسْحارِ والآصالِ مُذْ","طَابَ الثَّرَى مِنْهُ بِخَيْرِ إِمامِ",48,"م",1,0],["لا طيبَ حينَ يُعبي عَسكراً لِوَغىً","ما لم يكن من دَم الكُفارِ يَعبَؤُهُ",49,"ا",2,0],["لا طرقتكَ الخطوبُ والعِلَلُ","ولا اِعتراكَ الفتورُ والكسلُ",50,"ل",1,1],["لا طاقةٌ من بعدها لأولي النهى","إن يدخلوا في مثل هذا الباب",51,"ب",1,0],["لا طالَبَ اللّهُ الأحِبّةَ إنّهم","نامُوا عن الصّبِّ الكئيب وأسهَروا",52,"ر",3,0],["لا طافَ بِي الطَّيْفُ المُلِمَّ فإنَّني","قد كُنْتُ لا أَهْوَى الزِّيارَةَ زُورا",53,"ر",2,0],["لا طرقَتْ ربْعَكُمُ غارةٌ","يسألُ منها مَعشَري عن دَمي",54,"م",2,0],["لا طرباً منه ولا خِفّةً","لكن لكي يسكرَ أو يرْقُدا",55,"د",2,0],["لا طارف عاد عندي لا ولا تلد","في جدة فبلي يا جدة جدد",56,"د",1,1],["لا طائش الحِلم إن هفا الطيشُ بال","ناس ولا ضيِّقٌ إذا برِمُوا",57,"م",3,0],["لا طفتِ الأرضَ بها مزنةٌ","تصفَّقتْ من مائها الهاطلِ",58,"ل",1,0],["لا طلقَاء منعَمٌ عليهمُ","ولا يحَارون إذا الناصر قَلّْ",59,"ل",1,0],["لا طاب نفساً بالنوالِ ولا","مخَضَ المودةَ زُبدةَ الصَّدرِ",60,"ر",1,0],["لا طارفُ النعماءِ منزعجٌ","فيها ولا مستحدثُ الفخرِ",60,"ر",1,0],["لا طامعاً تُفسدُ الآراءَ بُغيَتُه","ولا دنيَّ الأماني فهو مُغْتنمُ",61,"م",1,0],["لا طعم بعد أبي الأغَرُّ لحالةٍ","وإن اكتست من رونقٍ وبهاءِ",62,"ا",2,0],["لا طاقةٌ لمتيّم ذي صبوةٍ","بأسود ذاك الحيّ والغزلانِ",63,"ن",1,0],["لأطال ليلي حبُّ ليلى عامرٍ","فعلام لا تحنو على مجنونها",64,"ن",3,0],["لا طَرَقَ الطّيفُ الّذي كان مِنْ","أكبر همّي أنّه يطرُقُ",65,"ق",1,0],["لا طغا هذا على هذا فبانْ","لا ولا هذا على هذا فهانْ",66,"ن",1,0],["لا طبع جسم شمال","وجهل نفس يمينِ",67,"ن",1,0],["لا طائِشٌ قاقٌ وَلا عَيِيُّ","بِالطَعنِ إِذ طاعَنَها نُكرِيُّ",68,"ي",1,0],["لا طاقةً لي بما أَوْلَيْتَ مِنْ كَرَم","يُثرى ومَا لِي بما أَوليتَ مِن قِبَلِ",69,"ل",1,0],["لا طَلّ صَوْبَ الغَوادِي سَاحَتي قطنا","ولا رَعى اللّه مَنْ في أَرْضِها قطنا",70,"ن",2,1],["لِأَطيارِهِ في العِلمِ شَدوٌ وَإِنَّما","بِهِ الطائِرُ المَحكِيُّ في القَولِ جاشِمُ",71,"م",1,0],["لا طعنَ فيهِ وَقَدُّ الرُمحِ قامتُهُ","لَكِنَّ قَلبي لَهُ أَضحى كَبُرجاسِ",72,"س",1,0],[