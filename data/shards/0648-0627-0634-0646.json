{"poems":[[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[90,"أشر فعل البرايا فعل منتحر","https://www.aldiwan.net/poem44985.html","البسيط"],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[48,"عجبت لآمرنا لم يطع","https://www.aldiwan.net/poem22969.html","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62220","الطويل"],[90,"اشر فعل البرايا فعل منتحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19521&r=&rc=24",""],[409,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83285","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49969","الطويل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110093","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146752","الطويل"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[5010,"إني أتنفس شعرا","https://www.poetsgate.com/ViewPoem.aspx?id=189943",""],[5956,"مودة ورحمة","https://www.poetsgate.com/ViewPoem.aspx?id=182435",""]],"verses":[["وَأَشنَبَ واضِحاً حَسَنَ الثَنايا","تَرى مِن بَينِ ثَنِيَّتِهِ خِلالا",0,"ل",2,0],["وأشنع الكذب عندي ما يُمازجه","شيء من الصدق تمويها على الفِكَر",1,"ر",1,0],["وَأَشنَبَ مَعسولِ الثَنِيّاتِ واضِحٍ","سَتَرتُ فَمي عَنهُ فَقَبَّلَ مَفرِقي",2,"ق",2,0],["وَأَشنَبَ إِن أَنظَرَتهُ المَنونُ","فَلا بُدَّ مِن قَصمٍ أَو لَطَع",3,"ع",1,0],["وأَشْنَبَ تَجْلُوهُ بِعُودِ أَرَاكَةٍ","ورَخْصاً عَلَتْهُ بِالخِضَابِ مُسَيَّرَا",4,"ر",2,0],["واشنع الكذب عندي ما يمازجه","شئ من الصدق تمويهاً على الفكر",5,"ر",1,0],["وأشنع خَطْبٍ ما يقول خطيبكم","من الكذب المنشور فوق المنابر",6,"ر",1,0],["وأشنبَ يظمئني ريقهُ","وينقع من ظمأي وهو شهد",7,"د",1,0],["وَإشن تَكُنِ الأَكفانُ بيضاً نَواصِعاً","فَإِنَّ لَهُ مِن أَبيَضِ الذِكرِ أَنصَعا",8,"ع",2,0],["وأَشنَب فيه من سُلافة بابل","ونفثه هاروتَ المدامةُ والسّحرُ",9,"ر",1,0],["واشنأ الناس لك ابن أختِكا","فامقته فهو آخذ في مقتكا",10,"ك",2,0],["وأشنباً لِبَرقِهِ بَينَ سُم","رَةِ القُمُورِ واللَّثَّاتِ التياح",11,"ح",1,0],["واشنعُ الحال ان يُلفَى الكريمُ بهِ","ما بالكرائِم من بُخلٍ ومن جُبُنِ",12,"ن",1,0],["واشنيتَ شأناً شان شأنَكَ فاغتدَى","على صَفَحات الدهرِ عِزّاً مؤَيَّدا",13,"د",2,0],["وأشنب معشوق الدلال منعم","معقرب صدغ كالهلال مداره",14,"ر",2,0],["واشنبظر الظيان وللامة","البظر وفيه شظية ولماظ",15,"ظ",1,0],["وَأشنِّفُ آذَانَ الدُّنْيا","أَنغامًا تُطْرِبُ مَنْ يَقْرَا",16,"ر",2,0],["وأشنها حرباً ضروساً ضد ما","يلقي على عيني الدجى لِيُضلِّها",17,"ل",3,0]]}