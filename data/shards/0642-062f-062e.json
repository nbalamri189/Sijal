ww.aldiwan.net/poem20879.html","المواليا"],[515,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[515,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[515,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[540,"أرقتني تلومني أم بكر","https://www.aldiwan.net/poem56642.html","الخفيف"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[551,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[558,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[562,"وردا على الخد لا وردا ببستان","https://www.aldiwan.net/poem52759.html","البسيط"],[562,"ماذا جلبت لنا يا ليلة العيد","https://www.aldiwan.net/poem52846.html","البسيط"],[562,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[562,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[564,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[575,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[575,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[575,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[575,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"]],"verses":[["قَد خابَ مَن أَصبَحَ مِن غَيرِكُم","عَلَيَّ وَالإِقبالُ مِنكُم مَعي",0,"ع",2,0],["قَد خَفَّ عَن ذاكَ الرَواقِ حُضورُهُ","أَبَداً وَعَن ذاكَ الحِمى ضَوضاؤُهُ",1,"ا",3,0],["قَد خِفتُ أَن لا أَراكُم آخِرَ الأَبَدِ","وأَن أَموتَ بِهذا الشَوقِ وَالكَمَدِ",2,"د",1,1],["قدْ خلَعْنا نِعالَنا وافْتَرَشْنا","حضْرَةَ الجمْعِ والحَبيبُ السّاقي",3,"ي",1,0],["قَد خَصَّهُ اللَهُ بِالقافاتِ يَعلِكُها","وَاِختَصَّ سُبحانَهُ بِالكافِ وَالنونِ",4,"ن",1,0],["قَد خَتَمَ الصَكَّ بِأَرزاقِكُم","وَصَحَّحَ العرضَ فَلَم تَسقُطوا",5,"ط",3,0],["قد خَطّ نونَ عذاره في خده","قلمان من آس هناك ومن شعر",6,"ر",1,0],["قَد خُنتِ مَن لَم يَكُن يَخشى خِيانَتَكُم","ما كُنتُ أَوَّلَ مَوثوقٍ بِهِ خانا",7,"ن",2,0],["قَد خِفتَ يا اِبنَ الَّتي ماتَت مُنافِقَةً","مِن خُبثِ بَرزَةَ أَن لا يَنزِلَ المَطَرُ",8,"ر",1,0],["قَد خِفتُ عِندَكُمُ الوُشاةَ وَلَم يَكُن","لِيُنالَ عِندِيَ سِرُّكِ المُستَودَعُ",9,"ع",1,0],["قَد خابَ قَومٌ نِيارٌ مِن سَراتِهِمِ","رِجلاً مُجَوَّعَةٍ شُبَّت بِمِسعارِ",10,"ر",1,0],["قد خنقتني عبرتي كاسمها","وبادرت من خلفها تجرِي",11,"ي",1,0],["قد ختمت بيضة الإسلام والْتحقت","بعشِّ أقلامه في الحادثِ الجلل",12,"ل",1,0],["قد خلع العاشقون ما صنع ال","هجر بألوانهم على ورقه",13,"ه",1,0],["قَد خَلَت يَلديزُ مِنكَ وَما","ذِكرُها يُخليكَ مِن أَلَمِ",14,"م",1,0],["قَد خُبِّرَت عَنّيَ أَنّي امرؤٌ","فيهِ شُحوبٌ وَظَنّي يَظهَرُ",15,"ر",1,0],["قد خر من عين الدجى","ليلا كدمع ساكب",16,"ب",1,0],["قد خاب من حاد يوما عن محجته","اما الذي هو عنه لم يحد فنجا",17,"ج",2,0],["قَد خالَفَ المَأمونُ أَهل بَيتِهِ","حُبّاً بِأَبناءِ الوَصيِّ وَحِبا",18,"ا",1,0],["قَد خَلا بَيبَكُ مِن حاتِمِه","وَمِنَ الكاسينَ فيهِ الطاعِمين",19,"ن",1,0],["قَد خَلَّفَ العَبّاسُ غُرَّتَكَ اِبنَهُ","مَرأىً لَنا وَإِلى القِيامَةِ مَسمَعا",20,"ع",2,0],["قد خرج التنين من بحرنا","بين هبابات وأنارِ",21,"ر",1,1],["قد خلط البياض بالسوادِ","وأحكم التدبير بالتردادِ",22,"د",1,1],["قَد خَصَمَ الدَهرُ مِن مِقِلِّهِم","بِالجودِ وَالدَهرُ بَيِّنٌ لِدَدُه",23,"د",2,0],["قَد خِفتُ أَلّا أَراكُم آخِرَ الأَبَدِ","وَأَن أَموتَ بِهَذا الشَوقِ وَالكَمَدِ",24,"د",1,1],["قَد خَبَّروها قِيامَ شَيخِكَ في الحَم","مامِ فَاِستَعبَرَت مِنَ الأَسَفِ",25,"ف",1,0],["قَد خَنَّقَت تِسعينَ أَو كَرَبَت","تَدنو لِآخِرِ أَرذَلِ العُمرِ",26,"ر",1,0],["قد خُلِقَت راحةُ الأمير حَيَاً","تَغِلبُ صَوبَ الحيا بجَدواها",27,"ا",3,0],["قد خلعَ القَطْرُ جلابيبَه","إلا شظَاياها وأزرارَها",28,"ر",3,0],["قَد خَلَونا بِمَجلِسٍ كُلُّ ما في","هِ سِوى البُعدُ عَن عُلاكَ لَذيذُ",29,"ذ",1,0],["قَد خَفَّفَت عِطفَهُ شَمالٌ","وَثَقَّلَت جَفنَهُ شَمولُ",30,"ل",1,0],["قَد خَضِبَت بِخالِصِ النَجيعِ","لَم تَخلُ في البُروزِ وَالرُجوعِ",31,"ع",1,0],["قَد خُلِّقَت بِدَمِ القُلوبِ خُدودُهُم","وَدَروعُهُم بِدَمِ الكُماةِ تُخَلَّقُ",32,"ق",1,0],["قَدْ خُلِّدُوا في جِنَانِي والجِنَانِ مَعَاً","أَكْرِمْ بِهِمْ يَعْمُرُونَ الخُلْدَ والخَلَدَا",33,"د",2,0],["قَد خَصَّ مِن أَهلِ النِفاقِ عِصابَةً","وَهُمُ أَشَدُّ أَذىً مِنَ الكُفّارِ",34,"ر",1,0],["قَد خَلَونا فَتَمَنَّينَ بِنا","إِذ خَلَونا اليَومَ نُبدي ما نُسِر",35,"ر",1,0],["قَد خاضَ في يَومِ الوَغى في حُلَّةٍ","حَمراءَ تَسديها العَوالي وَالقُضُب",36,"ب",1,0],["قد خُصَّ بالفَضْلِ قَطْلِيجا وأَيْدمُرُ","وطابَ منه ومنكَ الأَصْلُ والثَّمَرُ",37,"ر",1,1],["قَد خُضتُ في لُجَجِ الهَوى","وَشَرِبتُ صافِيَةَ الدِنانِ",38,"ن",1,0],["قَد خَفَتِ القَومُ فَاِستَراحوا","آهِ مِنَ الصَمتِ وَالخُفاتِ",39,"ت",1,0],["قَد خَبَرنا فَكَيفَ يُغتَرُّ بِالشَيءِ","الَّذي باتَ عِندَنا مَخبورا",40,"ر",2,0],["قَد خانَتِ الَبَعلَ أُنثى تَستَجيشُ لَهُ","بِهَمزَةٍ وَهوَ غَيثٌ جِدُّ مُنهَمِرِ",41,"ر",1,0],["قَد خِلتَ أَنَّكَ مُحسِنٌ فيما مَضى","وَالخالُ يَكذِبُ فيهِ ظَنُّ الخائِلِ",42,"ل",1,0],["قَد خَدَمَ الدَولَةَ مُستَنصِحاً","فَأَلبَسَتهُ شِيَةَ العِظلِمِ",43,"م",1,0],["قَد خَطَبَ الخاطِبونَ نُسوَتَكُم","وَأَسكَت الحِسَّ مِن ضَرائِرِكُم",44,"م",1,0],["قَد خَبِرَ اللَهُ مِن ضَميري","ما لَم يَكُن عِندَ خابِرِيّا",45,"ر",3,0],["قَد خَفَّ جِرمي وَصارَ جُرمي","أَثقَلَ مِن هَضبَةٍ عَلَيّا",46,"ل",3,1],["قد خدمنا العلوم شتى بدنيا","نا فهل من حسن الجزاء السعير",47,"ر",1,0],["قَد خرَّ من أَلم الجراح لجنبه","وَتلطخت بدمائه الأثواب",48,"ب",1,0],["قد خبرت الوجود في كل حال","فوجدت الزَمان في السَكَناتِ",49,"ت",1,1],["قد خلت فيه محاسناً","وإذا محاسنه عيوب",50,"ب",1,0],["قد خاب في كل ما يَرجوه ذو كسل","وَنال مطلبه من جد في الطلب",51,"ب",1,0],["قَدْ خَبَرَ الدَّهْرَ فَمَا غَائِبٌ","يَجْهَلُهُ مِنْهُ وَلا حَاضِرُ",52,"ر",1,0],["قد خطّ بالمسك على خدّه","ما الحسن إلّا لأَديمي أَديم",53,"م",1,0],["قَدْ خَالَطَ الوَحْشَ حَتَّى مَا يُرَوّعُهَا","إِذَا تَعَرَّضَ لَمْ تَنْفِرْ وَلَمْ تَثِبِ",54,"ب",1,0],["قد خَبَرْتُ الدُّنيا فلم أرَ أَزْكَى","مِنْ يَمينٍ تفتَّحتْ عَنْ نَوال",55,"ل",1,0],["قَدْ خَشِينَا عَلَى الْحَمائِمِ في الدَّوْ","حِ أَظَافِيرَ بَازِهِ أَوْ عُقَابِهْ",56,"ب",2,0],["قد خاف من حرّها فراح لها","يصغي بقلبٍ تخيفه ذكره",57,"ر",2,0],["قد خانني الدهرُ يوماً","يا ليته لم يَخُنِّي",58,"ي",1,0],["قَدْ خَطَّ مِنْ أَخْلاَقِهِ وجِهَادِهِ","للِفْتيَةِ السَّارينَ خَيْرَ مِثَالِ",59,"ل",1,0],["قد خفَّفَ الحزنَ عني: أن ذهبتَ وما","أعقبت لليتم لا بنتًا ولا ولدا",60,"د",2,0],["قد خُلقتَ لي، وقد خُلقتُ لها","من قبلِ أن لم تكن ولم أكن",61,"ن",1,0],["قدْ خبَّروُها قِيامَ شَيْخِكَ في الحمّ","امِ، فاستَعبَرَتْ مِنَ الأسَفِ",62,"ف",1,0],["قَدْ خَصَمَ الدّهْرُ عَنْ مُقلّهمِ","بالجُودِ، والدّهْرُ بَيّنٌ لَدَدُهْ",63,"د",2,0],["قدْ خانتِ البَعْلَ أُنثى، تستَجيشُ له","بهَمزَةٍ، هو غَيثٌ جِدُّ منهَمِر",64,"ر",1,0],["قد خبرَ اللَّهُ من ضميري،-- ما لم يكنْ عندَ خابرِيّا","ولم يُطِلْ سامري حَديثي، -- بل عشتُ في الدّهرِ سامريّا",65,"ر",3,0],["قَد خُبِّرَت عَنّيَ أَنّي امرؤٌ","فيهِ شُحوبٌ وَضنًى يَظهَرُ",66,"ر",1,0],["قد خربوا نعم العباد وشيدوا","قللا لهم ومآلها الاقلال",67,"ل",1,0],["قد خبطوا بلا دين وآذوا","وجوها في محافلها بشاشا",68,"ش",2,0],["قد خاله أَبناء عصره","في عداد العاثرين",69,"ن",1,0],["قَد خُضِّبَ الكَعبُ مِن نَسفِ العُروقِ بِهِ","مِنَ الرُخامى بجنبي حَزمِ أَورالِ",70,"ل",1,0],["قد خصَصْنَا بها الذين جَداهُم","زادَ عن ظنّنا وفاقَ الغَمَامَا",71,"م",2,0],["قَد خَفَّ صَحبي وَأَشكوني وَأَرَّقَني","خَودٌ تُرَبِّبُها الأَبوابُ وَالدورُ",72,"ر",1,0],["قد خفّت النفقاتُ إذ","لا أشتري صوفاً وقطنا",73,"ن",2,0],["قد خصّهم ربهم في خير منقبة","ما خصّ صحبا بها قبلا ولا آلا",74,"ل",2,0],["قد خصّهم واختصّهم واختارهم","رب الأنام لذا بغير تعمّل",75,"ل",1,0],["قد خانني الصبر ما أجدى بمنفعة","سيل المدامع قد سالت على خدّي",76,"ي",1,0],["قَدْ خَلَّفَتْنِي طَريحاً وَهْيَ قَائِلَةٌ","تَأَمَّلوا كَيْفَ فِعْلُ الظَّبْيِ بِالأَسَدِ",77,"د",1,0],["قد خيّمت باللوى الغربيّ ضاربةً","عليه أطنابها من غير أوتاد",78,"د",1,0],["قد خسرَ الخلق على حمله","فليس يوفي بخراج السوق",79,"ق",1,0],["قد خير الرزق الورى فترى الفتى","جزلا خيولا ناهضا جلدا",80,"د",2,0],["قَد خاصمَ الناسَ حيناً ثمّ حاكَمهم","إِلى السيو