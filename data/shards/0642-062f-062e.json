{"poems":[[53,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[55,"قد خفت أن لا أراكم آخر الأبد","https://www.aldiwan.net/poem26393.html","البسيط"],[77,"يا نسيم الصبا على الأوراق","https://www.aldiwan.net/poem35898.html","الخفيف"],[86,"يرغي ويزبد بالقافات تحسبها","https://www.aldiwan.net/poem68854.html","البسيط"],[54,"يا معشر الأجناد لا تقنطوا","https://www.aldiwan.net/poem29387.html","السريع"],[83,"هب النسيم على الرياض مع السحر","https://www.aldiwan.net/poem54309.html","الكامل"],[27,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[23,"يا ابني رفاعة ما بالي وبالكما","https://www.aldiwan.net/poem21378.html","البسيط"],[72,"يا سيدي جاءتك في صدرها","https://www.aldiwan.net/poem18720.html","السريع"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[51,"خيري ورد أتاك في طبق","https://www.aldiwan.net/poem65745.html","المنسرح"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[78,"القلب قد لج فما يقصر","https://www.aldiwan.net/poem14004.html","السريع"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[62,"قد خرج التنين من بحرنا","https://www.aldiwan.net/poem52176.html","السريع"],[62,"قد خلط البياض بالسواد","https://www.aldiwan.net/poem52215.html","الرجز"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[45,"قد خفت ألا أراكم آخر الأبد","https://www.aldiwan.net/poem63511.html","البسيط"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[28,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[61,"هويتها والفراق يهواها","https://www.aldiwan.net/poem51406.html","المنسرح"],[61,"لو رحبت كاس بذي أوبة","https://www.aldiwan.net/poem51653.html","السريع"],[66,"بك من حادث الزمان نعوذ","https://www.aldiwan.net/poem39050.html","الخفيف"],[66,"جاء في قده اعتدال","https://www.aldiwan.net/poem39233.html","مجزوء البسيط"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[31,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[46,"الكون في جملة العوافي","https://www.aldiwan.net/poem22211.html","مجزوء البسيط"],[46,"يا حصان النساء كم فارسا ول","https://www.aldiwan.net/poem22638.html","الخفيف"],[46,"السعد يجعل ذري الدبى نعما","https://www.aldiwan.net/poem22663.html","البسيط"],[46,"أسررت إذا مر السنيح تفاؤلا","https://www.aldiwan.net/poem23255.html","الكامل"],[46,"إجتنب الناس وعش واحدا","https://www.aldiwan.net/poem23414.html","السريع"],[46,"يا أمة في التراب هامدة","https://www.aldiwan.net/poem23433.html","المنسرح"],[46,"ساء بريا من البرايا","https://www.aldiwan.net/poem23609.html","مجزوء البسيط"],[46,"قد خف جرمي وصار جرمي","https://www.aldiwan.net/poem23610.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85338","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85603","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43869","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"مأتم في عرس","https://www.poetsgate.com/ViewPoem.aspx?id=179495",""],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[45,"مَرّتْ على عَزْمِها، وَلمْ تَقِفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32845",""],[45,"رُنُوُّ ذاكَ الغَزَالِ، أوْ غَيَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31423",""],[46,"السّعدُ يجعلُ ذَرّيّ الدَّبَا نِعَماًº","https://www.poetsgate.com/ViewPoem.aspx?id=20239",""],[78,"القَلبُ قَد لجَّ فَما يُقصَرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86513&r=&rc=58",""]],"verses":[["قَد خابَ مَن أَصبَحَ مِن غَيرِكُم","عَلَيَّ وَالإِقبالُ مِنكُم مَعي",0,"ع",2,0],["قَد خَفَّ عَن ذاكَ الرَواقِ حُضورُهُ","أَبَداً وَعَن ذاكَ الحِمى ضَوضاؤُهُ",1,"ا",3,0],["قَد خِفتُ أَن لا أَراكُم آخِرَ الأَبَدِ","وأَن أَموتَ بِهذا الشَوقِ وَالكَمَدِ",2,"د",1,1],["قدْ خلَعْنا نِعالَنا وافْتَرَشْنا","حضْرَةَ الجمْعِ والحَبيبُ السّاقي",3,"ي",1,0],["قَد خَصَّهُ اللَهُ بِالقافاتِ يَعلِكُها","وَاِختَصَّ سُبحانَهُ بِالكافِ وَالنونِ",4,"ن",1,0],["قَد خَتَمَ الصَكَّ بِأَرزاقِكُم","وَصَحَّحَ العرضَ فَلَم تَسقُطوا",5,"ط",3,0],["قد خَطّ نونَ عذاره في خده","قلمان من آس هناك ومن شعر",6,"ر",1,0],["قَد خُنتِ مَن لَم يَكُن يَخشى خِيانَتَكُم","ما كُنتُ أَوَّلَ مَوثوقٍ بِهِ خانا",7,"ن",2,0],["قَد خِفتَ يا اِبنَ الَّتي ماتَت مُنافِقَةً","مِن خُبثِ بَرزَةَ أَن لا يَنزِلَ المَطَرُ",8,"ر",1,0],["قَد خِفتُ عِندَكُمُ الوُشاةَ وَلَم يَكُن","لِيُنالَ عِندِيَ سِرُّكِ المُستَودَعُ",9,"ع",1,0],["قَد خابَ قَومٌ نِيارٌ مِن سَراتِهِمِ","رِجلاً مُجَوَّعَةٍ شُبَّت بِمِسعارِ",10,"ر",1,0],["قد خنقتني عبرتي كاسمها","وبادرت من خلفها تجرِي",11,"ي",1,0],["قد ختمت بيضة الإسلام والْتحقت","بعشِّ أقلامه في الحادثِ الجلل",12,"ل",1,0],["قد خلع العاشقون ما صنع ال","هجر بألوانهم على ورقه",13,"ه",1,0],["قَد خَلَت يَلديزُ مِنكَ وَما","ذِكرُها يُخليكَ مِن أَلَمِ",14,"م",1,0],["قَد خُبِّرَت عَنّيَ أَنّي امرؤٌ","فيهِ شُحوبٌ وَظَنّي يَظهَرُ",15,"ر",1,0],["قد خر من عين الدجى","ليلا كدمع ساكب",16,"ب",1,0],["قد خاب من حاد يوما عن محجته","اما الذي هو عنه لم يحد فنجا",17,"ج",2,0],["قَد خالَفَ المَأمونُ أَهل بَيتِهِ","حُبّاً بِأَبناءِ الوَصيِّ وَحِبا",18,"ا",1,0],["قَد خَلا بَيبَكُ مِن حاتِمِه","وَمِنَ الكاسينَ فيهِ الطاعِمين",19,"ن",1,0],["قَد خَلَّفَ العَبّاسُ غُرَّتَكَ اِبنَهُ","مَرأىً لَنا وَإِلى القِيامَةِ مَسمَعا",20,"ع",2,0],["قد خرج التنين من بحرنا","بين هبابات وأنارِ",21,"ر",1,1],["قد خلط البياض بالسوادِ","وأحكم التدبير بالتردادِ",22,"د",1,1],["قَد خَصَمَ الدَهرُ مِن مِقِلِّهِم","بِالجودِ وَالدَهرُ بَيِّنٌ لِدَدُه",23,"د",2,0],["قَد خِفتُ أَلّا أَراكُم آخِرَ الأَبَدِ","وَأَن أَموتَ بِهَذا الشَوقِ وَالكَمَدِ",24,"د",1,1],["قَد خَبَّروها قِيامَ شَيخِكَ في الحَم","مامِ فَاِستَعبَرَت مِنَ الأَسَفِ",25,"ف",1,0],["قَد خَنَّقَت تِسعينَ أَو كَرَبَت","تَدنو لِآخِرِ أَرذَلِ العُمرِ",26,"ر",1,0],["قد خُلِقَت راحةُ الأمير حَيَاً","تَغِلبُ صَوبَ الحيا بجَدواها",27,"ا",3,0],["قد خلعَ القَطْرُ جلابيبَه","إلا شظَاياها وأزرارَها",28,"ر",3,0],["قَد خَلَونا بِمَجلِسٍ كُلُّ ما في","هِ سِوى البُعدُ عَن عُلاكَ لَذيذُ",29,"ذ",1,0],["قَد خَفَّفَت عِطفَهُ شَمالٌ","وَثَقَّلَت جَفنَهُ شَمولُ",30,"ل",1,0],["قَد خَضِبَت بِخالِصِ النَجيعِ","لَم تَخلُ في البُروزِ وَالرُجوعِ",31,"ع",1,0],["قَد خُلِّقَت بِدَمِ القُلوبِ خُدودُهُم","وَدَروعُهُم بِدَمِ الكُماةِ تُخَلَّقُ",32,"ق",1,0],["قَد خَصَّ مِن أَهلِ النِفاقِ عِصابَةً","وَهُمُ أَشَدُّ أَذىً مِنَ الكُفّارِ",33,"ر",1,0],["قَد خَلَونا فَتَمَنَّينَ بِنا","إِذ خَلَونا اليَومَ نُبدي ما نُسِر",34,"ر",1,0],["قَد خاضَ في يَومِ الوَغى في حُلَّةٍ","حَمراءَ تَسديها العَوالي وَالقُضُب",35,"ب",1,0],["قد خُصَّ بالفَضْلِ قَطْلِيجا وأَيْدمُرُ","وطابَ منه ومنكَ الأَصْلُ والثَّمَرُ",36,"ر",1,1],["قَد خُضتُ في لُجَجِ الهَوى","وَشَرِبتُ صافِيَةَ الدِنانِ",37,"ن",1,0],["قَد خَفَتِ القَومُ فَاِستَراحوا","آهِ مِنَ الصَمتِ وَالخُفاتِ",38,"ت",1,0],["قَد خَبَرنا فَكَيفَ يُغتَرُّ بِالشَيءِ","الَّذي باتَ عِندَنا مَخبورا",39,"ر",2,0],["قَد خانَتِ الَبَعلَ أُنثى تَستَجيشُ لَهُ","بِهَمزَةٍ وَهوَ غَيثٌ جِدُّ مُنهَمِرِ",40,"ر",1,0],["قَد خِلتَ أَنَّكَ مُحسِنٌ فيما مَضى","وَالخالُ يَكذِبُ فيهِ ظَنُّ الخائِلِ",41,"ل",1,0],["قَد خَدَمَ الدَولَةَ مُستَنصِحاً","فَأَلبَسَتهُ شِيَةَ العِظلِمِ",42,"م",1,0],["قَد خَطَبَ الخاطِبونَ نُسوَتَكُم","وَأَسكَت الحِسَّ مِن ضَرائِرِكُم",43,"م",1,0],["قَد خَبِرَ اللَهُ مِن ضَميري","ما لَم يَكُن عِندَ خابِرِيّا",44,"ر",3,0],["قَد خَفَّ جِرمي وَصارَ جُرمي","أَثقَلَ مِن هَضبَةٍ عَلَيّا",45,"ل",3,1],["قد خدمنا العلوم شتى بدنيا","نا فهل من حسن الجزاء السعير",46,"ر",1,0],["قَد خرَّ من أَلم الجراح لجنبه","وَتلطخت بدمائه الأثواب",47,"ب",1,0],["قد خبرت الوجود في كل حال","فوجدت الزَمان في السَكَناتِ",48,"ت",1,1],["قد خلت فيه محاسناً","وإذا محاسنه عيوب",49,"ب",1,0],["قد خاب في كل ما يَرجوه ذو كسل","وَنال مطلبه من جد في الطلب",50,"ب",1,0],["قَدْ خَبَرَ الدَّهْرَ فَمَا غَائِبٌ","يَجْهَلُهُ مِنْهُ وَلا حَاضِرُ",51,"ر",1,0],["قد خطّ بالمسك على خدّه","ما الحسن إلّا لأَديمي أَديم",52,"م",1,0],["قَدْ خَالَطَ الوَحْشَ حَتَّى مَا يُرَوّعُهَا","إِذَا تَعَرَّضَ لَمْ تَنْفِرْ وَلَمْ تَثِبِ",53,"ب",1,0],["قد خَبَرْتُ الدُّنيا فلم أرَ أَزْكَى","مِنْ يَمينٍ تفتَّحتْ عَنْ نَوال",54,"ل",1,0],["قَدْ خَشِينَا عَلَى الْحَمائِمِ في الدَّوْ","حِ أَظَافِيرَ بَازِهِ أَوْ عُقَابِهْ",55,"ب",2,0],["قد خاف من حرّها فراح لها","يصغي بقلبٍ تخيفه ذكره",56,"ر",2,0],["قد خانني الدهرُ يوماً","يا ليته لم يَخُنِّي",57,"ي",1,0],["قَدْ خَطَّ مِنْ أَخْلاَقِهِ وجِهَادِهِ","للِفْتيَةِ السَّارينَ خَيْرَ مِثَالِ",58,"ل",1,0],["قد خفَّفَ الحزنَ عني: أن ذهبتَ وما","أعقبت لليتم لا بنتًا ولا ولدا",59,"د",2,0],["قد خُلقتَ لي، وقد خُلقتُ لها","من قبلِ أن لم تكن ولم أكن",60,"ن",1,0],["قدْ خبَّروُها قِيامَ شَيْخِكَ في الحمّ","امِ، فاستَعبَرَتْ مِنَ الأسَفِ",61,"ف",1,0],["قَدْ خَصَمَ الدّهْرُ عَنْ مُقلّهمِ","بالجُودِ، والدّهْرُ بَيّنٌ لَدَدُهْ",62,"د",2,0],["قدْ خانتِ البَعْلَ أُنثى، تستَجيشُ له","بهَمزَةٍ، هو غَيثٌ جِدُّ منهَمِر",63,"ر",1,0],["قَد خُبِّرَت عَنّيَ أَنّي امرؤٌ","فيهِ شُحوبٌ وَضنًى يَظهَرُ",64,"ر",1,0]]}