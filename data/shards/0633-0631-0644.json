{"poems":[[95,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[74,"إلى مقرك تسري همة الساري","https://www.aldiwan.net/poem18737.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[119,"صحف الفضاء لما نقول دفاتر","https://www.aldiwan.net/poem40935.html","عموديه"],[133,"تفتحت أعين الدراري","https://www.aldiwan.net/poem67442.html","مخلع البسيط"],[371,"سالت جفون الهوى على قدر","https://www.aldiwan.net/poem16982.html","المنسرح"],[484,"سر لحي عزة سر","https://www.aldiwan.net/poem36895.html","مجزوء الرمل"],[505,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122758","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122748","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103096","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199576","المسحوب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80185","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112927","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202063","الخفيف"],[2057,"","https://poetry.dctabudhabi.ae/diwan/poem/130455","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93707","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100293","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76532","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75684","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199078","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101381","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72741","الخفيف"],[5257,"والمؤلف ما هلك","https://www.poetsgate.com/ViewPoem.aspx?id=206789",""]],"verses":[["سِرّ لَوْ أَنَّ المَرْءَ يُدْرِكُهُ","عَقْلاً لَشِمْتَ سَنَاهُ مِنْ أَمَمِ",0,"م",1,0],["سر للأمير فما خابت خطى رجلٍ","على الدوا دار في باب الدوا داري",1,"ر",2,0],["سِرُّ لُبْنَانَ أَنَّهُ لَيْسَ يُسْلَى","كَيْفَ سَلْوَى ابْنِهِ الْوَفِيِّ الْوَدُودِ",2,"د",1,0],["سر للشآم بمتجر فأطاعه","وعصى الفؤاد فظل في الأوطان",3,"ن",1,0],["سر لطيف في خيالك كم به","سير وقيعان وحي عامر",4,"ر",1,0],["سِر لستُ أخشى على فؤادي","أن يَبقى في الأرضِ للفَناء",5,"ا",2,0],["سِر لا تَقِف وَاِستَعِن بِأَجنِحَةِ ال","سُحبِ إِلى وَكرِ مَغرِبٍ وَطِرِ",6,"ر",1,0],["سر لحي عزة سر","لاكبا بك الفرس",7,"س",1,1],["سِرٌّ لَطيفٌ وهذا الجِسمُ ذابَ به","فَعَنْهُ باللُّطْفِ سِرًّا سادتي ذودوا",8,"د",3,0],["سِرٌّ لَها لَيسَ غَيرُ اللهِ يَعلَمُهُ","تُخفيهِ نَفسيَ مِن نَفسي وَتَكتُمُهُ",9,"م",2,1],["سِرٌ لِغانيَةٍ يَسري إليَّ بِهِ","مِنَ النَّسيم رَسُولٌ لَيسَ يُتَّهَمُ",10,"م",1,0],["سر لإدراك البصائر فائت","وجمال حسنك للبصائر فاتن",11,"ن",1,0],["سرْ للحبيب وراضه","لا تغتلظ لقلوب",12,"ب",1,0],["سرٌّ له صاحَبَ موسى الخِضرا","قال مِعي لنْ تَستَطِيع صَبْرا",13,"ر",2,0],["سِرٌّ لَزِمتُ الحفظَ في كِتمانِهِ","حَتّى مَلَلتُ وملني كِتماني",14,"ن",2,0],["سر للأحبة زاجرا يا حادي","بالصوت للاظعان نحو الواد",15,"د",1,1],["سر لنحو الأهرام سير كمي","في سبيل الإسلام راح يحارب",16,"ب",1,0],["سر لاظهار المكارم قد نزل","تزهو شؤون الذات فيه وتبسم",17,"م",1,0],["سر لا تَقل فيها الظَهيرة وَاعتسف","عجلان مِن سُود الإهاب ظلامها",18,"م",3,0],["سرٌّ لها من جرهم","يفضي بمكتمن السرائر",19,"ر",1,0],["سر للَحياة فللقوي سر اذا","ما جاء اوله لنحوك تَنتَهي",20,"ي",1,1],["سر لست تعمل إِلّا للعلى قدماً","وكل أَرض توافيها غدت حرما",21,"م",2,1],["سر للأمام بموكب أرجاؤه","حزم وعلم رائد ومشيع",22,"ع",1,0],["سر لبنائكم في الأرض ما شهدت","تأثيره في المراعي قبله الأمم",23,"م",1,0],["سر لسلمان سالما غانما لا","زلت للخير راشدا مهديا",24,"ي",2,0],["سِر لا تَقِف .. واكتُب عَلَى خَدِّ الزَّمانِ","تَجَارُبًا .. فَالحُرُّ يُعرَفُ إن مَلَكْ",25,"ك",1,1]]}