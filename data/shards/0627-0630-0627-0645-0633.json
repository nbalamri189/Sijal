{"poems":[[65,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[88,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[85,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[31,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[47,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[30,"إذا مسمع أعطتك يوما يمينه","https://www.aldiwan.net/poem5452.html","الطويل"],[63,"أرى الشاعر الملحي راح بنا صبا","https://www.aldiwan.net/poem51803.html","الطويل"],[68,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[48,"تدين غاويهم حذار أميرهم","https://www.aldiwan.net/poem23063.html","الطويل"],[48,"إذا شئت أن ترقى جدارك مرة","https://www.aldiwan.net/poem23120.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29362","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[92,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[208,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[343,"إذا كان شكري نعمة الله نعمة","https://www.aldiwan.net/poem68764.html","الطويل"],[350,"إذا مس خرشاء الثمالة أنفه","https://www.aldiwan.net/poem4471.html","الطويل"],[369,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[558,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[567,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129529","المتقارب"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114814","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79975","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108812","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108637","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93650","البسيط"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198980","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201638","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65174","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3711,"","https://poetry.dctabudhabi.ae/diwan/poem/31525","الوافر"],[4755,"أَطِلِّي عَلَيَّ الآنَ مِن كُلِّ وِجْهَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=183531",""],[4767,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=179611",""],[4929,"رمال الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=199317",""],[5183,"مُلْغِزَهَ رق209م","https://www.poetsgate.com/ViewPoem.aspx?id=186396",""],[5398,"ديار العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=37140",""],[5872,"هواكم بقلبي ما لنحكمه نسخ","https://www.poetsgate.com/ViewPoem.aspx?id=120616",""]],"verses":[["إذا مَسَحْتَ جِباهَ الخَيلِ سابِقَةً","فَفي يَديَّ عِنانُ السّابِحِ الأرِنِ",0,"ن",1,0],["إِذا مَسَّ خَدَّ الطِرسِ فاضَ جَبينُهُ","بِأَسطارِ نورٍ باهِرِ اللَمَعاتِ",1,"ت",1,0],["إذا مسحت كفُّ الصِّبا جفن نَوْرها","تنفّس ثغر الزهر عن عنبر الشَّحْرِ",2,"ر",1,0],["إِذا مَسَّ أَسآرَ الطُيورِ صَفَت لَهُ","مُشَعشَعَةٌ مِمّا تُعَتِّقُ بابِلُ",3,"ل",1,0],["إذا مِسْتَ فيها قيل وشيٌ محبَّرٌ","على قمرٍ أو قيل رَيْطٌ مُسَهَّمُ",4,"م",1,0],["إِذا مَسَّ أَطرافَ السَنابِكِ رَدَّها","إِلى صُلبِها جاذي حَصاهُ وَجائِلُه",5,"ل",2,0],["إِذا مَساعي أَميرِ المُؤمِنينَ بَدَت","لِلواصِفينَ فَلا وَصفٌ يُدانيها",6,"ي",3,0],["إِذا مِسمَعٌ أَعطَتكَ يَوماً يَمينُهُ","فَعُدتَ غَداً عادَت عَلَيكَ شِمالُها",7,"ل",3,1],["إذا مسحَتْها الرِّيحُ راحتْ كأنما","تُمسِّحُ موتَى كشَّفَتْ عنهمُ التُّربا",8,"ب",2,0],["إِذا مَسَّها وَقعُ المِزاجِ تَأَلَّمَت","وَأَزبَدَ مِنها الثَغرُ وَاِمتَلَأَت رُعبا",9,"ب",2,0],["إِذا مَسَّهُنَّ الرَشحُ أَو سَقَطَ النَدى","تَضَوَّعَ بِالمِسكِ السَحيقِ المَشارِفُ",10,"ف",1,0],["إِذا مَسَكَ الإِعدامُ فَاِصبُر وَلا تَكن","جَزوعاً لِكَي يَردى الفَتى وَبِهِ مُسكُ",11,"ك",1,0],["إِذا مُسَكُ العَيشِ اِنقَضَت وَتَقَضَّبَت","فَما يَسأَلُ الضِرغامُ ما فَعَلَ الشِبلُ",12,"ل",1,0],["إِذا مَسَّهُ الشَرُّ لَم يَكتَئِب","وَإِن مَسَّهُ الخَيرُ لَم يُعجَبِ",13,"ب",1,0],["إذا مسّ خرشاء الثمالة أنه","ثنى مشفريه المصريح فأقنعا",14,"ع",2,1],["إذا مسّتِ البأساءُ أذْيالَ دِجلةٍ","قرأتَ الأسَى في صفحةِ النيل والكَمْدا",15,"د",2,0],["إذا مسَّني خَطْبٌ فأولُ راكبٍ","يخوضُ لي الْجُلَّى وأَسرعُ نازل",16,"ل",1,0],["إذا مَسَّ بالكَفِّ الجبينَ تدافَعَتْ","جُيُوشُ المعانِي فَيْلقاً إِثْرَ فَيْلَقِ",17,"ق",1,0],["اذا مسها القولُ الصحيحُ تطايَحتْ","كما مرَّ يَمشي في السنابلِ مِنْجَل",18,"ل",1,0],["إذا مسها لينُ الحريرِ فجسمُها","ينعِّم ما قد مسَّها من حريرها",19,"ر",3,0],["إِذا مُسَّ بِالسَرّاءِ عَمَّ سُرورُها","وَإِن مُسَّ بِالضَرّاءِ أَعقَبَها الأَجرُ",20,"ر",1,0],["إِذا مَسَّ خِرشاءَ الثُمالَةَ أَنفُهُ","ثَنى مِشفَريهِ لِلصَّريحِ فَأَقنَعا",21,"ع",2,1],["إذا مَساعِي سديدِ الدَّولتينِ بدَتْ","فما لِسَعْيِ ملوكِ الدَّهْرِ أخطار",22,"ر",1,0],["إِذا مَسَّها الساقي أَعارَت بَنانَهُ","جَلابيبَ كَالجادِيِّ مِن لَونِها صُفرا",23,"ر",2,0],["إذا مسَّتْ الحاجاتُ قام كلاهُما","إليهما كَجمر النَّار عندَ اشتعالِهِ",24,"ل",2,0],["إذا مس فاضل ذيل الصبا","ثراه ثراه يفت العبيرا",25,"ر",2,0],["إذا مِسنَ قُدَّامَ البيوتِ عَشِيَّةً","قِصارَ الخُطَى يَرفُلنَ في الحَبَراتِ",26,"ت",1,0],["إذا مسحتْ منه العُلى وجهَ سابق","جلتْ من أبي محمود غرَّة لاحق",27,"ق",1,0],["إذا مس إحدى جانبيها بكوكب","غدت قول ميَّانٍ عن الحق يعدل",28,"ل",1,0],["إذا مست مراشفها الحميّا","نقدمها على الماء الطهور",29,"ر",1,0],["إِذا مسكت مِن الهادي بحبل أَخا","فَقَد مَسَكت بحبل غَير مُنقطع",30,"ع",1,0],["إذا مسلكٌ لم يستقم بطريقه","سلكت اعتدالاً مثل ما يسلك الرخ",31,"خ",1,0],["إذا مَسّ قلبي من جحيم الأسى جمر","تفجّر بركان له حممٌ كُثْرُ",32,"ر",1,1],["إذا مس عرض الحرّ مُقالة","فليس لحرّ بالمساس تألّمُ",33,"م",1,0],["اذا مَسَّ عوداً كاد من عزّةٍ بِهِ","يرنُّ بِلا ضَربٍ عليهِ ولا تقرِ",34,"ر",1,0],["اذا مَسَّتِ الضَرَّاءُ فاقصِد جَنابَها","تَجِد عِندَها السَرَّاءَ عن ثَغر باسمِ",35,"م",1,0],["إِذا مَسَّ الضَريبَةَ شَفرَتاهُ","كَفاكَ مِنَ الضَريبَةِ ما اِستَطاعا",36,"ع",2,0],["إِذا مُسلِمٌ يُرْدِي ويُردِيهِ مُسلِمٌ","فَقَد فازَ بالإسلامِ مَن لَيسَ يَركَعُ",37,"ع",1,0],["إذ أمست لعبة شانئكم","في ملك الله المسكون",38,"ن",1,0],["إذا مَسَّتْ حروفيْ الصَّخرَ أمسَى","لجوفِ الصَّخرِ نبضٌ غيرَ خافِ",39,"ف",1,0],["إذا مسه منها أذى يستفزه","وقطت يراع النصر منه عنايته",40,"ت",2,0],["إذا مسَّ ضيمٌ رباكِ التي","بها المجدُ غرَّدَ لحنَ الخلودْ",41,"د",1,0],["إذا مسلك لم تستقم بطريقه","سلكت اعتدالا مثلما يسلك الرخ",42,"خ",1,0]]}