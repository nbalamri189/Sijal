{"poems":[[63,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[86,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[83,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[29,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[28,"إذا مسمع أعطتك يوما يمينه","https://www.aldiwan.net/poem5452.html","الطويل"],[61,"أرى الشاعر الملحي راح بنا صبا","https://www.aldiwan.net/poem51803.html","الطويل"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[31,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[46,"تدين غاويهم حذار أميرهم","https://www.aldiwan.net/poem23063.html","الطويل"],[46,"إذا شئت أن ترقى جدارك مرة","https://www.aldiwan.net/poem23120.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[202,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[336,"إذا كان شكري نعمة الله نعمة","https://www.aldiwan.net/poem68764.html","الطويل"],[343,"إذا مس خرشاء الثمالة أنفه","https://www.aldiwan.net/poem4471.html","الطويل"],[362,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[551,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[560,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"]],"verses":[["إذا مَسَحْتَ جِباهَ الخَيلِ سابِقَةً","فَفي يَديَّ عِنانُ السّابِحِ الأرِنِ",0,"ن",1,0],["إِذا مَسَّ خَدَّ الطِرسِ فاضَ جَبينُهُ","بِأَسطارِ نورٍ باهِرِ اللَمَعاتِ",1,"ت",1,0],["إذا مسحت كفُّ الصِّبا جفن نَوْرها","تنفّس ثغر الزهر عن عنبر الشَّحْرِ",2,"ر",1,0],["إِذا مَسَّ أَسآرَ الطُيورِ صَفَت لَهُ","مُشَعشَعَةٌ مِمّا تُعَتِّقُ بابِلُ",3,"ل",1,0],["إذا مِسْتَ فيها قيل وشيٌ محبَّرٌ","على قمرٍ أو قيل رَيْطٌ مُسَهَّمُ",4,"م",1,0],["إِذا مَسَّ أَطرافَ السَنابِكِ رَدَّها","إِلى صُلبِها جاذي حَصاهُ وَجائِلُه",5,"ل",2,0],["إِذا مَساعي أَميرِ المُؤمِنينَ بَدَت","لِلواصِفينَ فَلا وَصفٌ يُدانيها",6,"ي",3,0],["إِذا مِسمَعٌ أَعطَتكَ يَوماً يَمينُهُ","فَعُدتَ غَداً عادَت عَلَيكَ شِمالُها",7,"ل",3,1],["إذا مسحَتْها الرِّيحُ راحتْ كأنما","تُمسِّحُ موتَى كشَّفَتْ عنهمُ التُّربا",8,"ب",2,0],["إِذا مَسَّها وَقعُ المِزاجِ تَأَلَّمَت","وَأَزبَدَ مِنها الثَغرُ وَاِمتَلَأَت رُعبا",9,"ب",2,0],["إِذا مَسَّهُنَّ الرَشحُ أَو سَقَطَ النَدى","تَضَوَّعَ بِالمِسكِ السَحيقِ المَشارِفُ",10,"ف",1,0],["إِذا مَسَكَ الإِعدامُ فَاِصبُر وَلا تَكن","جَزوعاً لِكَي يَردى الفَتى وَبِهِ مُسكُ",11,"ك",1,0],["إِذا مُسَكُ العَيشِ اِنقَضَت وَتَقَضَّبَت","فَما يَسأَلُ الضِرغامُ ما فَعَلَ الشِبلُ",12,"ل",1,0],["إِذا مَسَّهُ الشَرُّ لَم يَكتَئِب","وَإِن مَسَّهُ الخَيرُ لَم يُعجَبِ",13,"ب",1,0],["إذا مسّتِ البأساءُ أذْيالَ دِجلةٍ","قرأتَ الأسَى في صفحةِ النيل والكَمْدا",14,"د",2,0],["إذا مسَّني خَطْبٌ فأولُ راكبٍ","يخوضُ لي الْجُلَّى وأَسرعُ نازل",15,"ل",1,0],["إذا مَسَّ بالكَفِّ الجبينَ تدافَعَتْ","جُيُوشُ المعانِي فَيْلقاً إِثْرَ فَيْلَقِ",16,"ق",1,0],["اذا مسها القولُ الصحيحُ تطايَحتْ","كما مرَّ يَمشي في السنابلِ مِنْجَل",17,"ل",1,0],["إذا مسها لينُ الحريرِ فجسمُها","ينعِّم ما قد مسَّها من حريرها",18,"ر",3,0],["إِذا مُسَّ بِالسَرّاءِ عَمَّ سُرورُها","وَإِن مُسَّ بِالضَرّاءِ أَعقَبَها الأَجرُ",19,"ر",1,0],["إِذا مَسَّ خِرشاءَ الثُمالَةَ أَنفُهُ","ثَنى مِشفَريهِ لِلصَّريحِ فَأَقنَعا",20,"ع",2,1],["إذا مَساعِي سديدِ الدَّولتينِ بدَتْ","فما لِسَعْيِ ملوكِ الدَّهْرِ أخطار",21,"ر",1,0],["إِذا مَسَّها الساقي أَعارَت بَنانَهُ","جَلابيبَ كَالجادِيِّ مِن لَونِها صُفرا",22,"ر",2,0],["إذا مسَّتْ الحاجاتُ قام كلاهُما","إليهما كَجمر النَّار عندَ اشتعالِهِ",23,"ل",2,0]]}