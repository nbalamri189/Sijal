{"poems":[[63,"سقى الله رملي كوفن الغيث حافلا","https://www.aldiwan.net/poem45913.html","الطويل"],[55,"يا من يكاتمني تغير قلبه","https://www.aldiwan.net/poem26133.html","الكامل"],[77,"بلد قد غزاه صرف الليالي","https://www.aldiwan.net/poem36639.html","الخفيف"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[70,"سروري كان أن ألقاك يوما","https://www.aldiwan.net/poem42413.html","الوافر"],[70,"أأحبابنا بالله كيف تغيرت","https://www.aldiwan.net/poem42866.html","الطويل"],[70,"رسول الرضا أهلا وسهلا ومرحبا","https://www.aldiwan.net/poem43022.html","الطويل"],[92,"رفرفت في دجية الليل الحزين","https://www.aldiwan.net/poem38917.html","الرمل"],[78,"أهلا بكم صحبتكم نحوي الديم","https://www.aldiwan.net/poem14185.html","البسيط"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[69,"ساكني مصر أين ذاك التأني","https://www.aldiwan.net/poem28053.html","الخفيف"],[105,"تقدم فهذا مطلع الحق والهدى","https://www.aldiwan.net/poem44054.html","الطويل"],[52,"سأكتم حاجاتي عن الناس كلهم","https://www.aldiwan.net/poem26937.html","الطويل"],[7,"كتمتك ليلاً بالجمومين ساهرا","https://www.aldiwan.net/poem1994.html","الطويل"],[76,"عاتب ظلت له عاتبا","https://www.aldiwan.net/poem39497.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125511","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21003","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42666","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54322","الرمل"],[7,"كتمتكَ ليلاً بالجمومينَ ساهرا","https://www.poetsgate.com/ViewPoem.aspx?id=17564",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[120,"قمر يحلم في لج السما","https://www.aldiwan.net/poem49267.html","الرمل"],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[143,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[211,"عيونك ألهبت قلبي وروحي","https://www.aldiwan.net/poem46289.html","الوافر"],[211,"ما بكى باك على الحسن الأصيل","https://www.aldiwan.net/poem46773.html","الرمل"],[223,"عرائس الدلب على الشاطيء","https://www.aldiwan.net/poem41455.html","السريع"],[223,"أرقدي أرقدي فغير الرقاد","https://www.aldiwan.net/poem41895.html","الخفيف"],[229,"متى سالم الأيام قبلي مسالم","https://www.aldiwan.net/poem50813.html","الطويل"],[229,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[328,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[328,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[328,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[366,"ما تطيب الدنيا لفقد حبيب","https://www.aldiwan.net/poem17093.html","الخفيف"],[400,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[402,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[406,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[458,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[458,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[461,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[461,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[461,"نحن قوم من تميم بن مر","https://www.aldiwan.net/poem16100.html","المديد"],[464,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[479,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[495,"ويك يا دهر لحاك الله","https://www.aldiwan.net/poem10282.html","مجزوء الرمل"],[500,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[500,"سينسج لي بسمك الكون بدر","https://www.aldiwan.net/poem37997.html","الوافر"],[513,"سأكفيك نفسي لا كفاية غادر","https://www.aldiwan.net/poem67781.html","الطويل"],[515,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[527,"يبكي من الموت أبو طيب","https://www.aldiwan.net/poem45964.html","السريع"],[554,"من مبلغ عني سنانا رسالة","https://www.aldiwan.net/poem1849.html","الطويل"],[558,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[567,"سلام على الأطلال وحش خيامها","https://www.aldiwan.net/poem69505.html","الطويل"]],"verses":[["سَأَكْفيهمُ الخَطْبَ الجَسيمَ بِصارِمٍ","تَمَطَّى المَنايا بَيْنَ غَرْبَيْهِ ناحِلِ",0,"ل",1,0],["سَأَكُفُّ عَنكَ وَفي يَدَيَّ بَقِيَّةٌ","مِن حَبلِ وَصلِكَ قَبل أَن يَتَصَرَّما",1,"م",2,0],["ساكِنُ الدّارِ رُوحُها كيفَ يَبْقى","جَسَدٌ بعْدَما تولّى الرّوحُ",2,"ح",1,0],["ساكِناً في لَحدٍ قَبرٍ","في أَراضٍ سَبِخاتِ",3,"ت",1,0],["ساكِتاً لا يَقولُ شَيئاً وَلا يَس","مَع شَيئاً وَلَيسَ يُبصِرُ دونَه",4,"ن",2,0],["سَأُكرِمُها لِحُرمَةِ مَن حَوَتهُ","وَإِكرامُ الدِيارِ لِساكِنيها",5,"ي",3,0],["سَأَكتُمُ هاذا العَتبَ خيفَةَ شامِتٍ","وَأوهِمُ أَنّي بِالرِضا مِنكَ فائِزُ",6,"ز",1,0],["سَأَكتُبُ مِمّا قَد جَرى في عِتابِنا","كِتاباً بِدَمعي لِلمُحِبّينَ مُذهَبا",7,"ب",2,0],["سَاكِتاً مِثْلَ جَميعِ الكَائِناتْ","رَاكِدَ الأَلْحانْ",8,"ن",1,0],["سأكتُم اللَيلَ ما أَشكوهُ مِن بُعُدٍ","وَأسألُ الصُبحَ عَنكُم حينَ يَبتَسِمُ",9,"م",1,0],["سأكحلُ عيني مِنْ بعيدٍ بنظرةٍ","إلى نارها بالرَّغمِ مِنْ أَنْفِ راقِبِ",10,"ب",1,0],["ساكني مصرَ أينَ ذاكَ التأنِّي","والتأبِّي ومالكمْ عنهُ عذرُ",11,"ر",1,1],["سأكتمُ إسلامِي وأُوذِيكَ إنّهم","هُمُ القومُ لا يُؤذونَ إلا مَنِ اهْتدَى",12,"د",2,0],["سَأَكتُمُ حاجاتي عَنِ الناسِ كُلَّهُم","وَلَكِنَّها لِلَّهِ تَبدو وَتَظهَرُ",13,"ر",1,1],["سَأَكعَمُ كَلبي أَن يَريبَكَ نَبحُهُ","وَإِن كُنتُ أَرعى مُسحَلانَ فَحامِرا",14,"ر",2,0],["سَاكِنَ القَصْرِ وَمَنْ حَلَّهُ","أَصْبَحَ القَلْبُ بِكُمْ ذَاهِبَا",15,"ب",2,0],["ساكت أَنت والأعادي تقولُ","وَمضرٌّ بك السكوت الطَّويلُ",16,"ل",1,1],["سأكتب أنك أنت الربيع","وأنك أنضر ما في الربى",17,"ب",2,0],["سَأَكسِبُ مَجداً أو تَقُومَ قِيَامَتي","عَلَيَّ بِليلٍ نادبِاتي وعُوَّدي",18,"د",2,0],["سَاكِنُ الأَطْرَافِ إِلَّا أَنَّهُ","إِنْ رَأَى مَنْشَبَ أُظْفُورٍ رَقَصْ",19,"ص",1,0],["سَاكِناً آناً وَآناً نَزِقاً","يَفْحصُ المَوْقِفَ أَوْ يَهْمُرُ هَمْرَا",20,"ر",2,0],["ساكناً كالظَّلاَمِ يَحْسَبُهُ الرَّا","ءُونَ معْنىً لليأسِ في تِمْثَالِ",21,"ل",1,0],["ساكنِي الفيومِ إنِّي ذاكر","عهدَكُمُ والذكر في البعدِ وفَاءْ",22,"ا",2,1],["سأكعمُ كلبي أن يربيكَ نبحهُ ،","وإن كنتُ أرعى مُسحَلانَ فحامرَا",23,"ر",2,0],["ساكنُ القصر لو إلى ذِمة ِ الحقِ","احتكمنا لكانَ يسكُنُ سِجنا",24,"ن",2,0],["سَأَكسِبُ مَجداً أَو تَقومَ نَوائِحٌ","عَلَيَّ بِلَيلٍ مُبدِياتِ التَبَلُّدِ",25,"د",1,0],["ساكن يسخر منا كلما","قام بالقلب حنين وقعد",26,"د",1,0],["ساكَهَا أُكلَةَ طَعَامٍ أثِيمٍ","ولَقَد كُنتَ مُذ نَشَأَتَ أَثِيمَا",27,"م",2,0],["سَأُكرِهُ في رَحيلي عَنكَ عَزماً","إِلَيكَ سَرى يُجاذِبُني الزِماما",28,"م",2,0],["سأكتمُ حبَّهُ عنّى وعنهُ","وكتمان المحبّةِ من عقابي",29,"ي",1,0],["ساكنٌ أنت بوادي الظلمات","ما الذي أهداك أرض الظلمات",30,"ت",1,0],["ساكِنَةٌ في الساعَةِ الساكِنَه","كَشَيخَةٍ في أَمسِها تَحلُمُ",31,"م",1,0],["ساكِباتٌ في طُهرِ قَلبكِ نوراً","من سَراجِ النُفوسِ وَالأَكبادِ",32,"د",1,0],["سأُكرِم نفسي عَنْكِ بالصَّبْرِ عالماً","بأنّكِ ممّن سوف يُقْتَلُ قُدّامي",33,"ي",1,0],["سأكْسُوك من طِيبِ الثناءِ قوافياً","متى ما تَقَعْ فيها معاليك تَعْبَقِ",34,"ق",1,0],["ساكن الروح لا تطيش به البشرى","صبوراً على احتمال المصاب",35,"ب",1,0],["ساكن كالفناء يخلق بالأحلام","مالا يجرى عليه القضاء",36,"ا",2,0],["سأكفرُ بالأقداس في ديرِ حبّها","وأجعلُ شيطان الغرام إلهيا",37,"ي",2,0],["ساكناً في بنى أبيكَ تُحاكِي","قَمَراً وُسِّطَ النُّجومَ الزُّهرا",38,"ر",2,0],["ساكِنٌ ناظِري وَلَم يَسكُنِ المَح","بوبُ مُذ قَطُّ ناظِراً وَالمَنامُ",39,"م",1,0],["سأكون أصدقَ ما يكون محدَّثٌ","صْدقاً وألقاكم بغير لثام",40,"م",1,0],["سأكشف أستار اصطباري ولم يَفُزْ","بنَيل المنى من لا يكون مجاهرِا",41,"ر",2,0],["سَأكسوكَ مِن مَدحي عَلى النأي حلة","يَدوم عَلى مَرِّ الجَديد جَديدُها",42,"د",3,0],["ساكنُ الجأش وإن نفَّره ال","خطبُ صبَّارٌ لإلحاح السؤالِ",43,"ل",1,0],["ساكنُ الصدر ليانٌ مسُّه","فرشَ البشرَ شِعاراً ووِطا",44,"ط",2,0],["ساكبُ الجودِ إذا عَزَّ الحَيا","ببنانٍ كلما سيلَ هَتَنْ",45,"ن",1,0],["ساكِنُ العِطْفِ على اِقْدامهِ","فالمضاءُ الرَّيْث والرَّيثُ عجلْ",46,"ل",1,0],["ساكِبُ المعْروفِ والمُزْنُ مُكْدٍ","وهُمامُ الرَّوْعِ والذِّمرُ فَسْلُ",47,"ل",1,0],["سأكسوهما وشي الثناءِ يزينهُ","عقودُ قوافٍ كالعقود انتظامها",48,"م",3,0],["ساكن القلب حبها","حرك الوجد فالتهب",49,"ب",1,0],["ساكت أنت وما أك","ثر باللغو لسانَكْ",50,"ك",1,0],["ساكِنٌ ظاهِراً وفي باطِنِ الأَمْ","رِ وَلوعٌ أَخو فُؤادٍ خَفُوق",51,"ق",1,0],["سأَكتُبُ في الحِمى عنه رِقاعاً","وأَنقُشُ في أَبي البَرَكاتِ رَمْزا",52,"ز",2,0],["سأكفيك نفسي لا كفاية غادرٍ","ولا سامعاً عذلاً ولا متعتبا",53,"ب",2,1],["ساكن الروح سؤدداً ووقاراً","وهي أقوى في العصف من ريح",54,"ح",1,0],["ساكتنا الشيخ أبو طيّبٍ","والصّمت أحياناً من اللوم",55,"م",1,0],["سَأَكفيكَ جَنبي وَضعَه وَوِسادَهُ","وَأَقتُلُ إِن لَم تُعطِنا الحَقَّ أَشجَعا",56,"ع",2,0],["ساكن منها بمنزلة","دونها الأصقاع والخطط",57,"ط",1,0],["سَأُكْرِمُ نَفْسِي أَنْ يُهَانَ كَرِيْمُهَا","وَأَحْرُسُهَا مِنْ أَنْ يَزِلَّ مَقَامُهَا",58,"م",3,0]]}