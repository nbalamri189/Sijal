1&r=&rc=3",""],[6346,"بَريقٌ وشعاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84885&r=&rc=10",""],[572,"سلامٌ على الأطلالِ حسنى خيامِهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9466&r=&rc=323",""]],"verses":[["سَأَكْفيهمُ الخَطْبَ الجَسيمَ بِصارِمٍ","تَمَطَّى المَنايا بَيْنَ غَرْبَيْهِ ناحِلِ",0,"ل",1,0],["سَأَكُفُّ عَنكَ وَفي يَدَيَّ بَقِيَّةٌ","مِن حَبلِ وَصلِكَ قَبل أَن يَتَصَرَّما",1,"م",2,0],["ساكِنُ الدّارِ رُوحُها كيفَ يَبْقى","جَسَدٌ بعْدَما تولّى الرّوحُ",2,"ح",1,0],["ساكِناً في لَحدٍ قَبرٍ","في أَراضٍ سَبِخاتِ",3,"ت",1,0],["ساكِتاً لا يَقولُ شَيئاً وَلا يَس","مَع شَيئاً وَلَيسَ يُبصِرُ دونَه",4,"ن",2,0],["سَأُكرِمُها لِحُرمَةِ مَن حَوَتهُ","وَإِكرامُ الدِيارِ لِساكِنيها",5,"ي",3,0],["سَأَكتُمُ هاذا العَتبَ خيفَةَ شامِتٍ","وَأوهِمُ أَنّي بِالرِضا مِنكَ فائِزُ",6,"ز",1,0],["سَأَكتُبُ مِمّا قَد جَرى في عِتابِنا","كِتاباً بِدَمعي لِلمُحِبّينَ مُذهَبا",7,"ب",2,0],["سَاكِتاً مِثْلَ جَميعِ الكَائِناتْ","رَاكِدَ الأَلْحانْ",8,"ن",1,0],["سأكتُم اللَيلَ ما أَشكوهُ مِن بُعُدٍ","وَأسألُ الصُبحَ عَنكُم حينَ يَبتَسِمُ",9,"م",1,0],["سأكحلُ عيني مِنْ بعيدٍ بنظرةٍ","إلى نارها بالرَّغمِ مِنْ أَنْفِ راقِبِ",10,"ب",1,0],["ساكني مصرَ أينَ ذاكَ التأنِّي","والتأبِّي ومالكمْ عنهُ عذرُ",11,"ر",1,1],["سأكتمُ إسلامِي وأُوذِيكَ إنّهم","هُمُ القومُ لا يُؤذونَ إلا مَنِ اهْتدَى",12,"د",2,0],["سَأَكتُمُ حاجاتي عَنِ الناسِ كُلَّهُم","وَلَكِنَّها لِلَّهِ تَبدو وَتَظهَرُ",13,"ر",1,1],["سَأَكعَمُ كَلبي أَن يَريبَكَ نَبحُهُ","وَإِن كُنتُ أَرعى مُسحَلانَ فَحامِرا",14,"ر",2,0],["سَاكِنَ القَصْرِ وَمَنْ حَلَّهُ","أَصْبَحَ القَلْبُ بِكُمْ ذَاهِبَا",15,"ب",2,0],["ساكت أَنت والأعادي تقولُ","وَمضرٌّ بك السكوت الطَّويلُ",16,"ل",1,1],["سأكتب أنك أنت الربيع","وأنك أنضر ما في الربى",17,"ب",2,0],["سَأَكسِبُ مَجداً أو تَقُومَ قِيَامَتي","عَلَيَّ بِليلٍ نادبِاتي وعُوَّدي",18,"د",2,0],["سَاكِنُ الأَطْرَافِ إِلَّا أَنَّهُ","إِنْ رَأَى مَنْشَبَ أُظْفُورٍ رَقَصْ",19,"ص",1,0],["سَاكِناً آناً وَآناً نَزِقاً","يَفْحصُ المَوْقِفَ أَوْ يَهْمُرُ هَمْرَا",20,"ر",2,0],["ساكناً كالظَّلاَمِ يَحْسَبُهُ الرَّا","ءُونَ معْنىً لليأسِ في تِمْثَالِ",21,"ل",1,0],["ساكنِي الفيومِ إنِّي ذاكر","عهدَكُمُ والذكر في البعدِ وفَاءْ",22,"ا",2,1],["سأكعمُ كلبي أن يربيكَ نبحهُ ،","وإن كنتُ أرعى مُسحَلانَ فحامرَا",23,"ر",2,0],["ساكنُ القصر لو إلى ذِمة ِ الحقِ","احتكمنا لكانَ يسكُنُ سِجنا",24,"ن",2,0],["سَأَكسِبُ مَجداً أَو تَقومَ نَوائِحٌ","عَلَيَّ بِلَيلٍ مُبدِياتِ التَبَلُّدِ",25,"د",1,0],["ساكن يسخر منا كلما","قام بالقلب حنين وقعد",26,"د",1,0],["ساكَهَا أُكلَةَ طَعَامٍ أثِيمٍ","ولَقَد كُنتَ مُذ نَشَأَتَ أَثِيمَا",27,"م",2,0],["سَأُكرِهُ في رَحيلي عَنكَ عَزماً","إِلَيكَ سَرى يُجاذِبُني الزِماما",28,"م",2,0],["سأكتمُ حبَّهُ عنّى وعنهُ","وكتمان المحبّةِ من عقابي",29,"ب",2,0],["ساكنٌ أنت بوادي الظلمات","ما الذي أهداك أرض الظلمات",30,"ت",1,0],["ساكِنَةٌ في الساعَةِ الساكِنَه","كَشَيخَةٍ في أَمسِها تَحلُمُ",31,"م",1,0],["ساكِباتٌ في طُهرِ قَلبكِ نوراً","من سَراجِ النُفوسِ وَالأَكبادِ",32,"د",1,0],["سأُكرِم نفسي عَنْكِ بالصَّبْرِ عالماً","بأنّكِ ممّن سوف يُقْتَلُ قُدّامي",33,"م",2,0],["سأكْسُوك من طِيبِ الثناءِ قوافياً","متى ما تَقَعْ فيها معاليك تَعْبَقِ",34,"ق",1,0],["ساكن الروح لا تطيش به البشرى","صبوراً على احتمال المصاب",35,"ب",1,0],["ساكن كالفناء يخلق بالأحلام","مالا يجرى عليه القضاء",36,"ا",2,0],["سأكفرُ بالأقداس في ديرِ حبّها","وأجعلُ شيطان الغرام إلهيا",37,"ي",2,0],["ساكناً في بنى أبيكَ تُحاكِي","قَمَراً وُسِّطَ النُّجومَ الزُّهرا",38,"ر",2,0],["ساكِنٌ ناظِري وَلَم يَسكُنِ المَح","بوبُ مُذ قَطُّ ناظِراً وَالمَنامُ",39,"م",1,0],["سأكون أصدقَ ما يكون محدَّثٌ","صْدقاً وألقاكم بغير لثام",40,"م",1,0],["سأكشف أستار اصطباري ولم يَفُزْ","بنَيل المنى من لا يكون مجاهرِا",41,"ر",2,0],["سَأكسوكَ مِن مَدحي عَلى النأي حلة","يَدوم عَلى مَرِّ الجَديد جَديدُها",42,"د",3,0],["ساكنُ الجأش وإن نفَّره ال","خطبُ صبَّارٌ لإلحاح السؤالِ",43,"ل",1,0],["ساكنُ الصدر ليانٌ مسُّه","فرشَ البشرَ شِعاراً ووِطا",44,"ط",2,0],["ساكبُ الجودِ إذا عَزَّ الحَيا","ببنانٍ كلما سيلَ هَتَنْ",45,"ن",1,0],["ساكِنُ العِطْفِ على اِقْدامهِ","فالمضاءُ الرَّيْث والرَّيثُ عجلْ",46,"ل",1,0],["ساكِبُ المعْروفِ والمُزْنُ مُكْدٍ","وهُمامُ الرَّوْعِ والذِّمرُ فَسْلُ",47,"ل",1,0],["سأكسوهما وشي الثناءِ يزينهُ","عقودُ قوافٍ كالعقود انتظامها",48,"م",3,0],["ساكن القلب حبها","حرك الوجد فالتهب",49,"ب",1,0],["ساكت أنت وما أك","ثر باللغو لسانَكْ",50,"ك",1,0],["ساكِنٌ ظاهِراً وفي باطِنِ الأَمْ","رِ وَلوعٌ أَخو فُؤادٍ خَفُوق",51,"ق",1,0],["سأَكتُبُ في الحِمى عنه رِقاعاً","وأَنقُشُ في أَبي البَرَكاتِ رَمْزا",52,"ز",2,0],["سأكفيك نفسي لا كفاية غادرٍ","ولا سامعاً عذلاً ولا متعتبا",53,"ب",2,1],["ساكن الروح سؤدداً ووقاراً","وهي أقوى في العصف من ريح",54,"ح",1,0],["ساكتنا الشيخ أبو طيّبٍ","والصّمت أحياناً من اللوم",55,"م",1,0],["سَأَكفيكَ جَنبي وَضعَه وَوِسادَهُ","وَأَقتُلُ إِن لَم تُعطِنا الحَقَّ أَشجَعا",56,"ع",2,0],["ساكن منها بمنزلة","دونها الأصقاع والخطط",57,"ط",1,0],["سَأُكْرِمُ نَفْسِي أَنْ يُهَانَ كَرِيْمُهَا","وَأَحْرُسُهَا مِنْ أَنْ يَزِلَّ مَقَامُهَا",58,"م",3,0],["ساكني بغداد قد طاب السكن","لكمو والعيش فينان أنيق",59,"ق",1,0],["سأكون يا أماه حلماً طيباً","يأتيك من هدب الجفون الهجع",60,"ع",1,0],["سَاكِتاً إنْ سُئِلْتُ عَنْ قَدْرِ حَظِّي","لَمْ أَجِدْ لِلسُّؤالِ عِنْدِيَ خُبْرَا",61,"ر",2,0],["سأكسوك من مدْحي ثيابا جديدة","مدى الدهر لا تبلَى ولا تتمزق",62,"ق",1,0],["ساكن في السكون منه اضطراب","ساكت في السكوت منه مقال",63,"ل",1,0],["سأكره عزمي في أباحته الحجا","بِداهية صماء أو فتكة بِكر",64,"ر",1,0],["ساكسوك وشي ثناء به","يخجل في الحسن وشي البرودِ",65,"د",1,0],["سأكسوه برودا من ثناء","يخلن لحسنهن برود خالِ",66,"ل",1,0],["ساكِتٌ يَروي حَديثاً","مِثلَ إِعراضِ الرَقيبِ",67,"ب",1,0],["ساكِباً لِلفَضلِ حُلماً واهِباً","كُلَما يَخجلُ مَن مَنَّ وَجاد",68,"د",1,0],["ساكباً نفسه على راحتيك","ملقياً فوق منكبيك وشاحه",69,"ه",1,0],["سَأكفيكَ ما عندي فَقُلْ لابن عَامِرٍ","وصاحِبِ مصرٍ يَكفيانِ الذي أَكْفي",70,"ف",2,1],["ساكِني الأَبطحِ إِنّي بعدَكُم","في جوارِ الأُسد مَثلوجَ الكَبِد",71,"د",1,1],["سأكرم نفسي عنك حسب اهانتي","لها فيك اذ فرت وكف نزاعها",72,"ع",3,1],["ساكب العبرات ادمعه","فهي في الرحمن كالديم",73,"م",1,0],["سَأَكسِر ما أَبقوا لَهُ مِن عِظامِهِ","وَأَنكُت مُخَّ السّاقِ مِنهُ فَأَنتَقي",74,"ق",2,