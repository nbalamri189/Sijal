{"poems":[[55,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[49,"غيري يغيره الفعال الجافي","https://www.aldiwan.net/poem25226.html","الكامل"],[49,"مستجير الهوى بغير مجير","https://www.aldiwan.net/poem25293.html","الخفيف"],[53,"لا أقذع السلطان في أيامه","https://www.aldiwan.net/poem8328.html","الكامل"],[72,"كم ذا التصاغر والتصابي","https://www.aldiwan.net/poem43006.html","مجزوء الكامل"],[94,"شعري نفاثة صدري","https://www.aldiwan.net/poem38939.html","المجتث"],[45,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[45,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[45,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[47,"إليك ما أنا من لهو ولا طرب","https://www.aldiwan.net/poem10655.html","البسيط"],[47,"هذا كتابك فيه الجهل والعنف","https://www.aldiwan.net/poem65156.html","البسيط"],[63,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[54,"أسر القلب فأمسى لديه","https://www.aldiwan.net/poem26580.html","المديد"],[69,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43807","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[112,"بسألك","https://www.poetsgate.com/ViewPoem.aspx?id=8395",""],[119,"لا تلم يا مهذب الانذالا","https://www.aldiwan.net/poem40617.html","عموديه"],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[234,"جعل الله كل عصر جديدا","https://www.aldiwan.net/poem51171.html","الخفيف"],[240,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[259,"غرور","https://www.aldiwan.net/poem24950.html","مجزوء الرمل"],[422,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[438,"يا فارس المسلمين انظر إلي تجد","https://www.aldiwan.net/poem12773.html","البسيط"],[445,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[556,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[563,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96987","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86877","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122312","المنسرح"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205467","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1592,"","https://poetry.dctabudhabi.ae/diwan/poem/33056","البسيط"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110705","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105010","الخفيف"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146371","الكامل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127381","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200649","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202748","المنسرح"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3071,"","https://poetry.dctabudhabi.ae/diwan/poem/34878","المديد"],[3091,"","https://poetry.dctabudhabi.ae/diwan/poem/141764","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48462","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138646",""],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86472","السريع"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4718,"يالله يالمعبود ياعالم الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=137305",""],[4942,"إني ٱنطلقت","https://www.poetsgate.com/ViewPoem.aspx?id=188393",""],[5101,"حسبي به","https://www.poetsgate.com/ViewPoem.aspx?id=197781",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5277,"القدرُ الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=200621",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5525,"عبرة الحبر","https://www.poetsgate.com/ViewPoem.aspx?id=986",""],[5573,"ماحال دون معانق الشوق حراس","https://www.poetsgate.com/ViewPoem.aspx?id=201913",""],[5625,"تمرد انثى","https://www.poetsgate.com/ViewPoem.aspx?id=182834",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[5956,"لا أقبل ما يرفضه عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=194413",""],[5956,"لا أقبل ما يرفض عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=202509",""],[5956,"ضعفتْ عيني زاد سُهادي","https://www.poetsgate.com/ViewPoem.aspx?id=208054",""],[6056,"عيب ٍ عليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=130525",""],[6082,"فتاة شرقية","https://www.poetsgate.com/ViewPoem.aspx?id=60252",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""]],"verses":[["لا أَقالَ الإِلَهُ مَن خانَكَ العَه","دَ وَجازاكَ بَغضَةً بِالوَدادِ",0,"د",1,0],["لا أَقتَني لِصُروفِ دَهري عُدَّةً","حَتّى كَأَنَّ صُروفُهُ أَحلافي",1,"ف",2,0],["لا أَقولُ المَسيرُ أَرَّقَ عَيني","قَد تَناهى البَلاءُ قَبلَ المَسيرِ",2,"ر",1,0],["لا أقذَعُ السلطانَ في أيامه","خوفاً لسطوته ومُرِّ عقابِهِ",3,"ب",2,1],["لا أَقتَضيكِ مَوَدَّةً","رُفِعَ الخَراجُ عَنِ الخَرابِ",4,"ب",1,0],["لا أَقْرُضُ الشِّعْرَ أَبغي","به اقتناصَ نَوَالِ",5,"ل",1,0],["لا أَقَمنا عَلى مَكانٍ وَإِن طا","بَ وَلا يُمكِنُ المَكانَ الرَحيلُ",6,"ل",1,0],["لا أَقبَلوا سِرّاً وَلا ظَفِروا","غَدراً وَلا نَصَرَتهُمُ الغِيَلُ",7,"ل",1,0],["لا أَقتَري بَلَداً إِلّا عَلى غَرَرٍ","وَلا أَمُرُّ بِخَلقٍ غَيرِ مُضطَغِنِ",8,"ن",1,0],["لا أَقبَلُ الدَهرَ نَيلاً لا يَقومُ بِهِ","شُكري وَلَو كانَ مُسديهِ إِلَيَّ أَبي",9,"ب",2,0],["لا أَقرَبُ الراحَ أَو تَجلو السماءَ لَنا","شَمسُ الرَبيعِ وَتَبهى الرَوضَةُ الأُنُفُ",10,"ف",1,0],["لا أقولُ الغَمامُ مثلُ أيادي","كَ ولا السيفُ مثلُ عَزْمِكَ حَدَّا",11,"د",2,0],["لا أَقولُ البَدرُ أَنتَ وَلا","غُصنُ بانٍ أَنتَ لا أَشتَهيهِ",12,"ي",2,0],["لا أقالَ اللهُ لِي مِنْ حُبِّها","بَيعَه يَوْماً وَلاَ فَكَّ رُهُونا",13,"ن",2,0],["لا أَقتَفي أثر الغَوا","ني غير أني انظر",14,"ر",1,0],["لا أَقولُ العدى يَشو","نَ إِذا قُلتُ أَنتَشي",15,"ش",2,1],["لا أَقولُ الطِبُّ أَخطا إِنَّما","خالَفَ المِقدار فيهِ ما اِتَّفَق",16,"ق",1,0],["لا أقولُ \" العدوُّ \" إنَّ عِداتي","\" نَسَبٌ \" واضحٌ من الأنساب؟!",17,"ب",1,0],["لا اقفيت عن عينك رجعت وقلتلك","تكفى ليا قفّيت عنّك نادني",18,"ن",2,0],["لا اقول الكرام ما توا ولكن","ندروا ثم ادركوا اقلالا",19,"ل",2,0],["لا أقال الإله من خانني الغيب","وجازى الحفاظ شر جزاء",20,"ا",2,0],["لا أقرّ الإله عيناً لشاني","ك وأعطاك في البقاء الخلودا",21,"د",2,0],["لا أَقالَ اللَهُ دَهراً","لَم يُقَل فيهِ عِثارُه",22,"ر",2,0],["لا أقاضي من يعادي","منك سمعٌ منك منعُ",23,"ع",1,0],["لا أقرّ الندى عيون ظباءٍ","أعْدَمتْنا يوم الفراق القرارا",24,"ر",2,0],["لا أقتضيكَ لتقديمٍ وعدْتَ به","من شيمةِ الغيثِ أن يأتي بلا طلَبِ",25,"ب",1,0],["لا أَقتدِي بالخالِفينَ ولا أُرى","أَسعى لِنَيْلِ رِضاكَ فِي أَدْنى الهِمَمْ",26,"م",1,0],["لا أقفرتْ منكَ ربوعٌ عَمُرَتْ","أُنساً ولا أيبسَ عيشٌ رَطُبا",27,"ب",2,0],["لا أقول عذبني","بل أقول قد عذبا",28,"ب",2,0],["لا اِقتَرَبْنا إلّا إِليكَ ولا زُرْ","ناك إلّا عن سَيْبِكَ المورودِ",29,"د",1,0],["لا أقر الله عين فتى","عن هوى المحبوب يندفع",30,"ع",1,0],["لا أقر الإله أعين قومٍ","نظرتكم مزورة لن تقرا",31,"ر",2,0],["لا أَقال الإله عَثرة باغ","في قُيود مِن بَغيه مَأسور",32,"ر",1,0],["لا اقبل الضيم كيف اقبله","والمجد يأباه في والحسب",33,"ب",1,0],["لا أَقعد الجبنَ عَن الهيجاء","وَلَو توالَت زمر الأَعداء",34,"ا",2,0],["لا أقال الله للموت عثارا","فلقد أغرق في الناس وجارا",35,"ر",2,1],["لا أقالتني المقاديرُ إذا","كنتُ ممَّن لكَ يا دهرُ أقالا",36,"ل",2,0],["لا أَقرَبُ البَيتَ أَحبو مِن مُؤَخِّرَهِ","وَلا أُكَسِّرَ في اِبنِ العَمِّ أَظفاري",37,"ر",2,0],["لا أقبل الصبح بأسفاره","لأنه الفضاح والأوكس",38,"س",1,0],["لا أَقفَرَت شَجَراتٌ عَرَّقَت وَزَكَت","فُرُوعُها فَزَكا مِنهُنَّ ذا الثَمَرُ",39,"ر",1,0],["لا أقول الديار بعدك أقوت","أَوَهل قد ألفت غير المصلى",40,"ل",2,0],["لا أقتضيك بما سماحُك فوقَه","فأَكون كالراجي من البحر النَّدا",41,"د",2,1],["لا أقول الحق إلا مرغما","ولغش الناس جهدي أقسم",42,"م",1,0],["لا أقبلُ الشعر إن لم يأت طوع يدي","فلست أسعى إليه سعى مجتهد",43,"د",1,1],["لا أقطف الزهر لا أحيل يدي","نعشاً لطفلٍ من الزهور نديّ",44,"د",2,0],["لا أَقبل الرأي من ذي لومة أَبَداً","إن المحب عَن العذال في صَمم",45,"م",1,0],["لا أقول الله يظلمني","كيف أشكو غير متَّهمِ",46,"م",1,0],["لا أقفرت تلك الربوع ولا عفى","مغنى بها بالجود أصبح عامرا",47,"ر",2,0],["لا أقتَضي طلَباً سوى هذا الذي","هوَ عزّتي وعِنايتي وتشرُّفي",48,"ف",2,0],["لا أقال الله يوماً عثرةً","لامرئ يوماً إلى الدهر أقالا",49,"ل",2,0],["لا أقبل البيت في النديّ ولا","يعجبني ماؤهُ فأنتجعا",50,"ع",2,0],["لا أقطف الورد ولكنني","قد كدت من روضك أن أقطفك",51,"ك",1,0],["لا أقالَ الوصالُ عثرةَ قلبٍ","همَّ بعد الوصال بالسُلوان",52,"ن",1,0],["لااقام صدري داخله يقنب الذيب","جابت ضلوعي من صدا الصوت لجات",53,"ت",1,0],["لا أقطف الورد حتى لا أضيعه","وأزرع الحب وردا ثم اسقيه",54,"ي",2,0],["لا اقتفي عيباً ولستُ بفاعلٍ","يوماً وإنْ أبداهُ لي أنكرتُه",55,"ت",2,0],["لا أقبل الحبل موصولا بواحدة","غيري ولو كنت من أدنى أدانيها",56,"ي",3,0],["لا أقتفيك..كما تريدُ مواجدي","بل أحتويكِ وإنْ طغى الإعصارُ",57,"ر",1,0],["لا أقولُ المَكانُ شرّفَهُ","إنّما طالَ مكّةَ الشّرَفُ",58,"ف",1,0],["لاأقول أحبك .. لين بدموعي اشرق","وقبل الصديق يحس بي نايد الناس",59,"س",1,0],["لا اقفيت تقبل لي ولا اقبلت قفيت","حاير ويمسي طالب ارضاك محتاس",60,"س",1,0],["لا أقبلُ الشّركاءَ، شرعي في الهوى","لا ألفُ لا، أنا سرُّ لاءِ النّافية",61,"ف",3,0],["لا أَقْبَلُ الأَلوانَ فَوقَ رُؤوسِنا","لا أقبَلُ التَّفضيلَ فيما يُذكَرُ",62,"ر",1,0],["لا أقبَلُ المُتَزَمِتينَ بِرأيِهم","فَبِهم تَراجَعَ دِينُنا الَمُتَحَضِّرُ",62,"ر",1,0],["لا أقبل ما يرفض عقلي","لو كان إلى \"عدْنٍ\" يُعْلي",63,"ل",2,1],["لا أقبل ما يرفض عقلي","لو كان إلى \"مجدٍ\" يُعْلي",64,"ل",2,1],["لا أقْدر أن أخطو أعلى..","إلا وهويتَ إلى الوادي",65,"د",2,0],["لا أقبل جهام الزول قمت آتحفاّ","بإ قبالته ، لا من تخطىّ بهونه",66,"ن",2,0],["لا اقبل فيك مشاركة","فأنا في الحب انانية",67,"ي",2,0],["لا أقولُ الذي يريدونَ ، رأيي","ثابتٌ لا أرى من الحقِّ بَيْعَهْ",68,"ع",2,0]]}