 أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[456,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[456,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[456,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[456,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[459,"شهد العراق وكل راو بارع","https://www.aldiwan.net/poem15406.html","الكامل"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[462,"تباً لما اختلق الواشي وما نقلا","https://www.aldiwan.net/poem3504.html","عموديه"],[463,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[475,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[477,"أترافق الخود الحسان وتدعي","https://www.aldiwan.net/poem37179.html","الكامل"],[513,"تيقنوا أن قلبي منهم يجب","https://www.aldiwan.net/poem12032.html","البسيط"],[538,"أقصرت عن جهلي الأدنى وحلمني","https://www.aldiwan.net/poem56858.html","البسيط"],[556,"ما لابن مريم في تلك الأساطين","https://www.aldiwan.net/poem33794.html","البسيط"],[556,"العبد يلهو ويغفل","https://www.aldiwan.net/poem34242.html","المجتث"]],"verses":[["حَتَّى لَقَدْ عَلَّمْتُ سَاجِعَةَ الضُّحَى","شَجْوِي وَجَانِحَةَ الأَصِيلِ شُحُوبِي",0,"ب",2,0],["حَتَّى لَيَسْأَلُ مَنْ أَضَلَّهُمَا إِذَا","مَا قَاسَ بَيْنَ حَلِيمِهَا وَالحَالِمِ",1,"م",1,0],["حَتَّى لَكَادُوا يَفْتِكُونَ بِشَيْخِهِمْ","زُلْفَى إِلَى ذَاكَ الأَمِيرِ المُطْعِمِ",2,"م",1,0],["حَتّى لَقَد أَصبَحتُمُ","مِمّا يُخافُ عَلى شَفا",3,"ف",2,0],["حتى لقد أصبحوا أبناء واحدة","في المرزئات وهم في الحكم أشكال",4,"ل",1,0],["حتى لقد نِفدت في الحرب عِينَته","بحيث لم يَبق سَهم في كنانته",5,"ت",2,0],["حتى لقد ملكوا الأمصار مملكة","كانت بسرعتها من أعجب العجب",6,"ب",1,0],["حتَّى لقدْ صحَّ مقالُ قائلٍ","دمشقُ لا يوجدَ فيها صاحب",7,"ب",1,0],["حتَّى لجأت إلى جنابك شاكياً","فأجرتَ من ألقى الرَّجا وتعوذا",8,"ذ",2,0],["حتَّى لقد حسدوا جيران بابكمُ","وقيل بشراكُم يا جيرة العلم",9,"م",1,0],["حتَّى لقد حمُّوا سلاح خزائن","قال الرجاء بمثله ذبحوني",10,"ي",1,0],["حَتّى لَقَد عايَنَهُ خَلقُهُ","كَلَحظَةِ الحاجِبِ بِالحاجِبِ",11,"ب",1,0],["حتى لشبَّهتُ سُقياه وزَهرتَه","جَدوى أبي أحمدٍ أو وشيَ صنعاءِ",12,"ا",2,0],["حتى لَقال الناسُ فيكَ فأكثروا","هذا المسيح وَلاَتَ حينَ مَسِيحِ",13,"ح",1,0],["حتى لتحسب أن اللَّه أجبَرَهُ","على السماحِ ولم يَخْلُقْهُ مُمْتَحَنا",14,"ن",2,0],["حَتّى لَحِقنا وَقَد زالَ النَهارُ وَقَد","مالَت لَهُنَّ بِأَعلى خَينَفَ البُرَقُ",15,"ق",1,0],["حَتّى لَقيتَكُمُ فَبِتُّ كَأَنَّني","لِمَسَرَّتي اِستَرجَعتُ عَصرَ شَبابي",16,"ي",1,0],["حَتّى لِيَحسَبَهُ أَسيراً موثَقاً","وَيَراهُ أَبطَأَ مِن كَسيحٍ مُقعَدِ",17,"د",1,0],["حَتّى لَكِدتَ تُحِسَّ هاجِسَةَ المُنى","وَتَبينَ كَم في النَفسِ مِن أَضدادِ",18,"د",1,0],["حَتّى لَقَد كادَ القَريضُ يَقعُقُّني","وَيَصونُ عَنّي مائَه وَأَنا الصَدي",19,"د",2,0],["حَتّى لَمَحتُكَ مَرموقَ الهِلالِ عَلى","حَداثَةٍ تَعِدُ الأَوطانَ ما تَعِدُ",20,"د",1,0],["حَتّى لَنَسأَلُ هَل تَغا","رُ عَلى العَقائِدِ أَم تُغير",21,"ر",1,0],["حَتّى لَوِ اِرتَشَفَ الحَديدَ أَذابَهُ","بِالوَقدِ مِن أَنفاسِهِ الصُعَداءِ",22,"ا",2,0],["حَتّى لَوَ انَّ الجودَ خُيِّرَ في الوَرى","نَسَباً لَأَصبَحَ يَنتَمي في تَغلِبِ",23,"ب",1,0],["حَتّى لَأَنكَرتُ مَن قَد كُنتُ أَعرِفُهُ","مِنَ الأَخِلّاءِ وَاِستَوحَشتُ مِن بَلَدي",24,"د",2,0],["حَتّى لَكانَ الصَفحُ أَثقَلَ مَحمَلاً","مِمّا تَخَوَّفَهُ المُسيءُ العامِدُ",25,"د",1,0],["حَتّى لَقَد عَلِمَ الجَهولُ وَأَخلَصَت","نَفسُ المُرَوّي وَاِهتَدى المُتَحَيِّرُ",26,"ر",1,0],["حَتّى لَقَد أَفضَلتُ مِن أَفضالِهِ","وَرَأَيتُ نَهجَ الجودِ حينَ أَراني",27,"ي",1,0],["حتى لقيتك ذات أمسية","فعرفت فيك مطالع الأمل",28,"ل",1,0],["حَتّى لَبِستُ كُسىً لِليُسرِ تَنشُرُها","عَلى اِعتِساري يَدٌ لَم تَسهُ عَن شاني",29,"ي",1,0],["حَتّى لَوَ اَنَّكَ تَستَشِفُّ ضَميرَهُ","لَرَأَيتَني في الصَدرِ مِن آمالِهِ",30,"ل",2,0],["حَتّى لَوَ اَنَّ اللَيالي صُوِّرَت لَغَدَت","أَفعالُهُ الغُرُّ في آذانِها شُنُفا",31,"ف",2,0],["حَتّى لَقَد ظَنَّ الغُواةُ وَباطِلٌ","أَن قَد تَجَسّمَ فِيَّ روحُ السَيِّدِ",32,"د",1,0],["حتى لقدْ كادتْ صخورُكَ بالهنا","يرقصْنَ لولا أنهنَّ صخورُ",33,"ر",1,0],["حَتّى لَوَ اِسطيعُ مِمّا قَد فَعَلتَ بِنا","أَكَلتُ لَحمَكَ مِن غَيظي وَما نَضَجا",34,"ج",2,0],["حَتّى لَو اِعوَجَّ في أَحكامِهِ عُمرٌ","هَبَّت تُقَوِّمُهُ الهِندِيَّةُ القُضُبُ",35,"ب",1,0],["حَتّى لَقَد سَمّوهُ بِالكَنّاسِ","وَعايَنوا صَعباً شَديدَ الباسِ",36,"س",1,0],["حَتّى لَأَبقاني كَما تَرَني","صَمصامَةً مَفلولَةَ الغَربِ",37,"ب",1,0],["حتى لقد يَخْفَى على الناسِ ما","تُحِبُّ مِنْ أَمْرٍ وَما تَكرَه",38,"ر",2,0],["حتى لقد رَجَفَتْ ديارُ ربيعَةٍ","وتزلزلتْ أرضُ العراق تخَوُّفَا",39,"ف",2,0],["حَتّى لَوِ اِستودِعَت سِراراً","لَم يَخفَ في ضَوإِها السِرارُ",40,"ر",1,0],["حَتّى لَوِ اِستَطاعَ مِن تَحَنُّنِهِ","دافَعَ عَنها القَضاءَ وَالقَدَرا",41,"ر",2,0],["حَتّى لَقَد مَجَّ دَماً خالِصاً","مِن لِثَةٍ تَجري وَأَضراسِ",42,"س",1,0],["حَتّى لَعَيني بِكَ فيما أَرى","أَعلَمُ مِن نَفسي بِما أُخفي",43,"ي",1,0],["حَتّى لَقَد شاعَ ما أُكاتِمُهُ","وَصِرتُ لِلناسِ في الهَوى عَلَما",44,"م",2,0],["حتى لقد دبّت إلى معشرٍ","تبلعها كالرقشِ أشباها",45,"ه",2,0],["حَتّى لَحِقناهُمُ تُعدِي فَوارِسُنا","كأَنَّنا رَعنُ قُفٍّ يَرفَعُ الآلا",46,"ل",2,0],["حتَّى لقد كاد شعري","يبكي لضعفي ووهْني",47,"ي",1,0],["حتى ليحسبه أسيرا موثقا","ويراه أبطأ من يح مقعد",48,"د",1,0],["حَتَّى لَوَ کسْطيعَ مِمّا قَد فَعَلْتَ بنا","أكلتُ لحمكَ من غيظي، وما نضجا",49,"ج",2,0],["حتى لمحتُكَ مَرموقَ الهلالِ على","حداثة ٍ تععدُ الأوطانَ ما تعد",50,"د",1,0],["حتّى لا يَبقى فينا أَمَلٌ","يُرْجَى، والحِقْدُ يُقَطِّعُني",51,"ن",2,0],["حَتّى لَقالَ الناسُ مِمّا عَمَّهُم","ما ثَمَّ ذَنبٌ لِلعُقوبَةِ موجِبُ",52,"ب",1,0],["حَتّى لَخِلناهُ نَبِيّاً مُرسَلاً","وَمَحاسِنُ الأَخلاقِ مِن آياتِهِ",53,"ت",2,0],["حَتّى لَخِلنا دَوحَهُ وَتُرابَهُ","عوداً قَمارِيّاً وَمِسكاً أَذفَرا",54,"ر",2,0],["حَتّى لَقيدَت بُدَّناً وَلَوَ اِنَّها","قيدَت لِيَومِ وَغىً لَقيدَت ضُمَّرا",54,"ر",2,0],["حَتّى لَظَنَّ الناسُ يَقظَتَهُم كَرىً","أَو مُلكَ مِصرَ إِلى دِمَشقَ تَحَوَّلا",55,"ل",2,0],["حَتّى لَعاتَبَكَ العُفاةُ فَهَل رَأى","أَحَدٌ عُفاةَ نَدىً عَلَيهِ عُذَّلا",55,"ل",2,0],["حَتَّى لَقَدْ ضَمِنَتْ لأَحْمَدَ عنْوَةً","أَنْ لا يَزَالَ عَلَى الخُطُوبِ مُعِينا",56,"ن",2,0],["حَتَّى لقد صاروا وَهُمْ إِخْوتي","مِنْ شِدَّةِ الغَيْرَةِ أَعْدائي",57,"ي",1,0],["حتى لقد قالوا بأن سعوده","طال المدى فيها عليه تصعبُ",58,"ب",1,0],["حتى لقد حدثت عن شيخ لهم","بالثغر قال وقد أتى بطعام",59,"م",1,0],["حَتّى لَقَد راحَ كُلُّ عِلقٍ","عَلَيكَ في قَلبِهِ سَخِيمَه",60,"م",2,0],["حتّى لَحِقتُ حُمُولَ الحَىِّ أَقرَعُهُ","لَولا تَراغُبُ شِعبَى رَحلِهِ انشَعَبَا",61,"ب",2,0],["حَتّى لَحِقنا وَدُونَ الحىِّ مُنصلتاً","شاكى السِّلاَحِ بَعِيدُ السَّأوِ مُنشَمِرُ",62,"ر",1,0],["حتى لثمتُ فتاةَ الحيِّ فانتبهَتْ","ترنو إلىّ بعينَيْ جُؤْذرٍ شَرِد",63,"د",1,0],["حتى لقد كاد فيه","كعبي يُصافح فَرْقي",64,"ق",2,0],["حتى لقد ودَّ الحجازُ تشوقا","لو زاره برسُومه وطُلوله",65,"ل",2,0],["حتى لوِ اجتمع الخَليقةُ كلها","من شيخِها أو طفلها أو كَهْلها",66,"ل",3,0],["حتى لقد كاد الصِّباغ يَعْفُو","أو خامةٌ لم يعلُ منها الحرف",67,"ف",1,0],["حتى لقد طُلْتَ النجومَ تَسامِيا","وفضحتَ أَبكارَ السحابِ نَوالا",68,"ل",2,0],["حتى لقد عاقَني عن","صلاةِ ظُهري وعصري",69,"ي",1,0],["حتّى لقد أوهمتَني","أنّي أخونُك في وفائك",70,"ك",1,0],["حَتّى لَقَد بَرَكَت بِأَشرَفِ مَنزِلٍ","بِمَكانِ مَسجِدِهِ بِلا حيدانِ",71,"ن",1,0],["حَتّى لَقَد رَفَعوا لِيومِهِمُ","ما حَطَّهُ المَلّاحُ في شَهرِ",72,"ر",1,0],["حَتّى لَقَد ظَنَّ العَدُوُّ بِجَهلِهِ","مِمّا رَأى أَن لَستَ مِن أَكفائِهِ",73,"ا",3,0],["حَتّى لَعادَت وَفي أَنساعِها ضُمُراً","مِنها نُسوعٌ وَفي الأَقرانِ أَقرانُ",74,"ن",1,0],["حَتّى لَعُدنَ خَلاءً","مِنَ القُلوبِ الصُدورُ",75,"ر",1,0],["حَتّى لَقَد كادَ أَن يَذوبَ بِأَن","فاسِيَ في فيهِ ذَلِكَ البَرَدُ",76,"د",1,0],["حَتَّى لَقَدْ خِلْتُ آمَالِي قَوائِلَ لِي","قَدْكَ ابْنَ زَاكُورَ هَذَا الْبَحْرُ فَاقْتَصِرَا",77,"ر",2,0],["حتّى لحقوا بملائكةٍ","من قرب الروح المزدلف",78,"ف",1,0],["حَتّى لَقَد بيعَت عَقائِل أُرهِقَت","بِالسَبيِ بِالثَمَنِ الأَخَسِّ الأَحقَرِ",79,"ر",1,0],["حَتّى لَخِلنا أَنَّهُ إِن يَلتَمِس","نَثراً لِمُنتَظِمِ الثُرَيّا يُنثَرِ",79,"ر",1,0],["حَتّى لَقيتَ اِبنَ