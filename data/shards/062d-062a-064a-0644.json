767,"أنس المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=194930",""],[4767,"لملم جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=198534",""],[4767,"ثامن الحُجَج","https://www.poetsgate.com/ViewPoem.aspx?id=214501",""],[4767,"جرح لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=215436",""],[4778,"رسالة من جدث","https://www.poetsgate.com/ViewPoem.aspx?id=188427",""],[4802,"سلة أوجاعي","https://www.poetsgate.com/ViewPoem.aspx?id=32784",""],[463,"يا دارُ لا أنهجَ القشيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17994",""],[1901,"ترى على العهدِ أهلُ الودِّ أم خانوا","https://www.poetsgate.com/ViewPoem.aspx?id=160421",""],[5120,"إِيهِ يَا حُلُمًا..","https://www.poetsgate.com/ViewPoem.aspx?id=200686",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5264,"نفسى","https://www.poetsgate.com/ViewPoem.aspx?id=178666",""],[5277,"القدسُ..القدسُ..يا عربُ","https://www.poetsgate.com/ViewPoem.aspx?id=194614",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5401,"سجن المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=85961",""],[5431,"لعل خبزي قد يكفي له وعسى ...","https://www.poetsgate.com/ViewPoem.aspx?id=196722",""],[5455,"انت زعلان","https://www.poetsgate.com/ViewPoem.aspx?id=213962",""],[470,"حياتُهُ هكذا","https://www.poetsgate.com/ViewPoem.aspx?id=178032",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5643,"وصاحب أصبح من برده","https://www.poetsgate.com/ViewPoem.aspx?id=181295",""],[5747,"ماجيت أقدم عن غلاك إعتذاري","https://www.poetsgate.com/ViewPoem.aspx?id=61606",""],[5747,"مسرح جريمه","https://www.poetsgate.com/ViewPoem.aspx?id=61610",""],[402,"جلس الأمير إلى الطعام عشية","https://www.poetsgate.com/ViewPoem.aspx?id=36320",""],[5956,"مُبدِعون ، ومُجْتَرُّون","https://www.poetsgate.com/ViewPoem.aspx?id=185568",""],[5993,"ودعتك الله والليالي طويله","https://www.poetsgate.com/ViewPoem.aspx?id=186753",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6019,"فَضَحَ الهَوَى سِرِّيْ ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53001",""],[469,"ولرب ليلة موعد كصدوده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574794",""],[463,"أبلغْ بها أمنية َ الطالبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59982&r=&rc=38",""],[463,"ما المجدُ إلا بالعزيمة فاعزمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60294&r=&rc=350",""],[463,"هلْ في الشُّموسِ التي تحدى بها العيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60092&r=&rc=148",""]],"verses":[["حَتَّى لَقَدْ عَلَّمْتُ سَاجِعَةَ الضُّحَى","شَجْوِي وَجَانِحَةَ الأَصِيلِ شُحُوبِي",0,"ب",2,0],["حَتَّى لَيَسْأَلُ مَنْ أَضَلَّهُمَا إِذَا","مَا قَاسَ بَيْنَ حَلِيمِهَا وَالحَالِمِ",1,"م",1,0],["حَتَّى لَكَادُوا يَفْتِكُونَ بِشَيْخِهِمْ","زُلْفَى إِلَى ذَاكَ الأَمِيرِ المُطْعِمِ",2,"م",1,0],["حَتّى لَقَد أَصبَحتُمُ","مِمّا يُخافُ عَلى شَفا",3,"ف",2,0],["حتى لقد أصبحوا أبناء واحدة","في المرزئات وهم في الحكم أشكال",4,"ل",1,0],["حتى لقد نِفدت في الحرب عِينَته","بحيث لم يَبق سَهم في كنانته",5,"ت",2,0],["حتى لقد ملكوا الأمصار مملكة","كانت بسرعتها من أعجب العجب",6,"ب",1,0],["حتَّى لقدْ صحَّ مقالُ قائلٍ","دمشقُ لا يوجدَ فيها صاحب",7,"ب",1,0],["حتَّى لجأت إلى جنابك شاكياً","فأجرتَ من ألقى الرَّجا وتعوذا",8,"ذ",2,0],["حتَّى لقد حسدوا جيران بابكمُ","وقيل بشراكُم يا جيرة العلم",9,"م",1,0],["حتَّى لقد حمُّوا سلاح خزائن","قال الرجاء بمثله ذبحوني",10,"ن",2,0],["حَتّى لَقَد عايَنَهُ خَلقُهُ","كَلَحظَةِ الحاجِبِ بِالحاجِبِ",11,"ب",1,0],["حتى لشبَّهتُ سُقياه وزَهرتَه","جَدوى أبي أحمدٍ أو وشيَ صنعاءِ",12,"ا",2,0],["حتى لَقال الناسُ فيكَ فأكثروا","هذا المسيح وَلاَتَ حينَ مَسِيحِ",13,"ح",1,0],["حتى لتحسب أن اللَّه أجبَرَهُ","على السماحِ ولم يَخْلُقْهُ مُمْتَحَنا",14,"ن",2,0],["حَتّى لَحِقنا وَقَد زالَ النَهارُ وَقَد","مالَت لَهُنَّ بِأَعلى خَينَفَ البُرَقُ",15,"ق",1,0],["حَتّى لَقيتَكُمُ فَبِتُّ كَأَنَّني","لِمَسَرَّتي اِستَرجَعتُ عَصرَ شَبابي",16,"ب",2,0],["حَتّى لِيَحسَبَهُ أَسيراً موثَقاً","وَيَراهُ أَبطَأَ مِن كَسيحٍ مُقعَدِ",17,"د",1,0],["حَتّى لَكِدتَ تُحِسَّ هاجِسَةَ المُنى","وَتَبينَ كَم في النَفسِ مِن أَضدادِ",18,"د",1,0],["حَتّى لَقَد كادَ القَريضُ يَقعُقُّني","وَيَصونُ عَنّي مائَه وَأَنا الصَدي",19,"د",2,0],["حَتّى لَمَحتُكَ مَرموقَ الهِلالِ عَلى","حَداثَةٍ تَعِدُ الأَوطانَ ما تَعِدُ",20,"د",1,0],["حَتّى لَنَسأَلُ هَل تَغا","رُ عَلى العَقائِدِ أَم تُغير",21,"ر",1,0],["حَتّى لَوِ اِرتَشَفَ الحَديدَ أَذابَهُ","بِالوَقدِ مِن أَنفاسِهِ الصُعَداءِ",22,"ا",2,0],["حَتّى لَوَ انَّ الجودَ خُيِّرَ في الوَرى","نَسَباً لَأَصبَحَ يَنتَمي في تَغلِبِ",23,"ب",1,0],["حَتّى لَأَنكَرتُ مَن قَد كُنتُ أَعرِفُهُ","مِنَ الأَخِلّاءِ وَاِستَوحَشتُ مِن بَلَدي",24,"د",2,0],["حَتّى لَكانَ الصَفحُ أَثقَلَ مَحمَلاً","مِمّا تَخَوَّفَهُ المُسيءُ العامِدُ",25,"د",1,0],["حَتّى لَقَد عَلِمَ الجَهولُ وَأَخلَصَت","نَفسُ المُرَوّي وَاِهتَدى المُتَحَيِّرُ",26,"ر",1,0],["حَتّى لَقَد أَفضَلتُ مِن أَفضالِهِ","وَرَأَيتُ نَهجَ الجودِ حينَ أَراني",27,"ن",2,0],["حتى لقيتك ذات أمسية","فعرفت فيك مطالع الأمل",28,"ل",1,0],["حَتَّى لَتَحْسَبُ أَنَّ المُهْرَ أَبْصَرَهُ","أَو أَنَّ مَسَّاً أَصَابَ المُهْرَ فَانْجَرَدَا",29,"د",2,0],["حَتّى لَبِستُ كُسىً لِليُسرِ تَنشُرُها","عَلى اِعتِساري يَدٌ لَم تَسهُ عَن شاني",30,"ن",2,0],["حَتّى لَوَ اَنَّكَ تَستَشِفُّ ضَميرَهُ","لَرَأَيتَني في الصَدرِ مِن آمالِهِ",31,"ل",2,0],["حَتّى لَوَ اَنَّ اللَيالي صُوِّرَت لَغَدَت","أَفعالُهُ الغُرُّ في آذانِها شُنُفا",32,"ف",2,0],["حَتّى لَقَد ظَنَّ الغُواةُ وَباطِلٌ","أَن قَد تَجَسّمَ فِيَّ روحُ السَيِّدِ",33,"د",1,0],["حتى لقدْ كادتْ صخورُكَ بالهنا","يرقصْنَ لولا أنهنَّ صخورُ",34,"ر",1,0],["حَتّى لَوَ اِسطيعُ مِمّا قَد فَعَلتَ بِنا","أَكَلتُ لَحمَكَ مِن غَيظي وَما نَضَجا",35,"ج",2,0],["حَتّى لَو اِعوَجَّ في أَحكامِهِ عُمرٌ","هَبَّت تُقَوِّمُهُ الهِندِيَّةُ القُضُبُ",36,"ب",1,0],["حَتّى لَقَد سَمّوهُ بِالكَنّاسِ","وَعايَنوا صَعباً شَديدَ الباسِ",37,"س",1,0],["حَتّى لَأَبقاني كَما تَرَني","صَمصامَةً مَفلولَةَ الغَربِ",38,"ب",1,0],["حتى لقد يَخْفَى على الناسِ ما","تُحِبُّ مِنْ أَمْرٍ وَما تَكرَه",39,"ر",2,0],["حتى لقد رَجَفَتْ ديارُ ربيعَةٍ","وتزلزلتْ أرضُ العراق تخَوُّفَا",40,"ف",2,0],["حَتّى لَوِ اِستودِعَت سِراراً","لَم يَخفَ في ضَوإِها السِرارُ",41,"ر",1,0],["حَتّى لَوِ اِستَطاعَ مِن تَحَنُّنِهِ","دافَعَ عَنها القَضاءَ وَالقَدَرا",42,"ر",2,0],["حَتّى لَقَد مَجَّ دَماً خالِصاً","مِن لِثَةٍ تَجري وَأَضراسِ",43,"س",1,0],["حَتّى لَعَيني بِكَ فيما أَرى","أَعلَمُ مِن نَفسي بِما أُخفي",44,"ف",2,0],["حَتّى لَقَد شاعَ ما أُكاتِمُهُ","وَصِرتُ لِلناسِ في الهَوى عَلَما",45,"م",2,0],["حتى لقد دبّت إلى معشرٍ","تبلعها كالرقشِ أشباها",46,"ه",2,0],["حَتّى لَحِقناهُمُ تُعدِي فَوارِسُنا","كأَنَّنا رَعنُ قُفٍّ يَرفَعُ الآلا",47,"ل",2,0],["حتَّى لقد كاد شعري","يبكي لضعفي ووهْني",48,"ن",2,0],["حتى ليحسبه أسيرا موثقا","ويراه أبطأ من يح مقعد",49,"د",1,0],["حتّى لمحتك خلف الستر ضاحكة","إلى جوار وحجّاب وغلمان",50,"ن",1,0],["حَتَّى لَوَ کسْطيعَ مِمّا قَد فَعَلْتَ بنا","أكلتُ لحمكَ من غيظي، وما نضجا",51,"ج",2,0],["حتى لمحتُكَ مَرموقَ الهلالِ على","حداثة ٍ تععدُ الأوطانَ ما تعد",52,"د",1,0],["حتّى لا يَبقى فينا أَمَلٌ","يُرْجَى، والحِقْدُ يُقَطِّعُني",53,"ن",2,0],["حَتّى لَقالَ الناسُ مِمّا عَمَّهُم","ما ثَمَّ ذَنبٌ لِلعُقوبَةِ موجِبُ",54,"ب",1,0],["حَتّى لَخِلناهُ نَبِيّاً مُرسَلاً","وَمَحاسِنُ الأَخلاقِ مِن آياتِهِ",55,"ت",2,0],["حَتّى لَخِلنا دَوحَهُ وَتُرابَهُ","عوداً قَمارِيّاً وَمِسكاً أَذفَرا",56,"ر",2,0],["حَتّى لَقيدَت بُدَّناً وَلَوَ اِنَّها","قيدَت لِيَومِ وَغىً لَقيدَت ضُمَّرا",56,"ر",2,0],["حَتّى لَظَنَّ الناسُ يَقظَتَهُم كَرىً","أَو مُلكَ مِصرَ إِلى دِمَشقَ تَحَوَّلا",57,"ل",2,0],["حَتّى لَعاتَبَكَ العُفاةُ فَهَل رَأى","أَحَدٌ عُفاةَ نَدىً عَلَيهِ عُذَّلا",57,"ل",2,0],["حَتَّى لَقَدْ ضَمِنَتْ لأَحْمَدَ عنْوَةً","أَنْ لا يَزَالَ عَلَى الخُطُوبِ مُعِينا",58,"ن",2,0],["حَتَّى لقد صاروا وَهُمْ إِخْوتي","مِنْ شِدَّةِ الغَيْرَةِ أَعْدائي",59,"ي",1,0],["حتى لقد قالوا بأن سعوده","طال المدى فيها عليه تصعبُ",60,"ب",1,0],["حتى لقد حدثت عن شيخ لهم","بالثغر قال وقد أتى بطعام",61,"م",1,0],["حَتّى لَقَد راحَ كُلُّ عِلقٍ","عَلَيكَ في قَلبِهِ سَخِيمَه",62,"م",2,0],["حتّى لَحِقتُ حُمُولَ الحَىِّ أَقرَعُهُ","لَولا تَراغُبُ شِعبَى رَحلِهِ انشَعَبَا",63,"ب",2,0],["حَتّى لَحِقنا وَدُونَ الحىِّ مُنصلتاً","شاكى السِّلاَحِ بَعِيدُ السَّأوِ مُنشَمِرُ",64,"ر",1,0],["حتى لثمتُ فتاةَ الحيِّ فانتبهَتْ","ترنو إلىّ بعينَيْ جُؤْذرٍ شَرِد",65,"د",1,0],["حتى لقد كاد فيه","كعبي يُصافح فَرْقي",66,"ق",2,0],["حتى لقد ودَّ الحجازُ تشوقا","لو زاره برسُومه وطُلوله",67,"ل",2,0],["حتى لوِ اجتمع الخَليقةُ كلها","من شيخِها أو طفلها أو كَهْلها",68,"ل",3,0],["حتى لقد كاد الصِّباغ يَعْفُو","أو خامةٌ لم يعلُ منها الحرف",69,"ف",1,0],["حتى لقد طُلْتَ النجومَ تَسامِيا","وفضحتَ أَبكارَ السحابِ نَوالا",70,"ل",2,0],["حتى لقد عاقَني عن","صلاةِ ظُهري وعصري",71,"ر",2,0],["حتّى لقد أوهمتَني","أنّي أخونُك في وفائك",72,"ك",1,0],["حَتّى لَقَد بَرَكَت بِأَشرَفِ مَنزِلٍ","بِمَكانِ مَسجِدِهِ بِلا حيدانِ",73,"ن",1,0],["حَتّى لَقَد رَفَعوا لِيومِهِمُ","ما حَطَّهُ المَلّاحُ في شَهرِ",74,"ر",1,0],["حَتّى لَقَد ظَنَّ العَدُوُّ بِجَهلِهِ","مِمّا رَأى أَن لَستَ مِن أَكفائِهِ",75,"ا",3,0],["حَتّى لَعادَت وَفي أَنساعِها ضُمُراً","مِنها نُسوعٌ وَفي الأَقرانِ أَقرانُ",76,"ن",1,0],["حَتّى لَعُدنَ خَلاءً","مِنَ القُلوبِ الصُدورُ",77,"ر",1,0],["حَتّى لَقَد كادَ أَن يَذوبَ بِأَن","فاسِيَ في فيهِ ذَلِكَ البَرَدُ",78,"د",1,0],["حَتَّى لَقَدْ خِلْتُ آمَالِي قَوائِلَ لِي","قَدْكَ ابْنَ زَاكُورَ هَذَا الْبَحْرُ فَاقْتَصِرَا",79,"ر",2,0],["حتّى لحقوا بملائكةٍ","من قرب الروح المزدلف",80,"ف",1,0],["حَتّى لَقَد بيعَت عَقائِل أُرهِقَت","بِالسَبيِ بِالثَمَنِ الأَخَسِّ الأَحقَرِ",81,"ر",1,0],["حَتّى لَخِلنا أَنَّهُ إِن يَلتَمِس","نَثراً لِمُنتَظِمِ الثُرَيّا يُنثَرِ",81,"ر",1,0],["حَتّى لَقيتَ اِبنَ كَهفِ اللؤمِ في لَجِبٍ","يَنفي العَصافيرَ وَالغِربانَ جَرّارِ",82,"ر",1,0],["حتَّى لقد يُعْجَبُ السَّمَنْدلُ مِن","بَقاءِ جِسمِي وَحَشْوُ مُحمَّرُ",83,"ر",1,0],["حتىَّ لَقدْ رَقَّ النَّسِيمُ لها وَقَدْ","صُبِغَتْ بِصُفْرَةِ مَنُ يَردُّ فَيَخْجَلُ",84,"ل",1,0],["حَتّى لَقَد بُعثوا وَما بعثوا وَقَد","نالوا البَقاء وَكُلّ شَيء فاني",85,"ن",2,0],["حَتّى لَقَد مَنَّ الإله بِهِ عَلى","هَذي الدِيار تَكرّما وَ