1,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35597","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123523","السلسلة"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94411","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73154","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58178","السريع"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101166","الرمل"],[4858,"حتّامَ هذا القتلُ ؟ّ","https://www.poetsgate.com/ViewPoem.aspx?id=138194",""],[4929,"مفتي الوالي","https://www.poetsgate.com/ViewPoem.aspx?id=201087",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5431,"الحمد لله من قلبِ به سكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201907",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[5939,"قد طواك الموت عنا","https://www.poetsgate.com/ViewPoem.aspx?id=195329",""],[5953,"فكن يا خصيبي بحق محمد","https://www.poetsgate.com/ViewPoem.aspx?id=93881",""],[6075,"في صفحة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=190530",""],[6075,"( إِلَى عَهْد التَّمِيمِي )","https://www.poetsgate.com/ViewPoem.aspx?id=194823",""]],"verses":[["بِلَعوبٍ مَعَ الضَجيعِ إِذا ما","سَهِرَت بِالعِشاءِ غَيرِ أُسوفِ",0,"ف",1,0],["بِلَعوبٍ طَيِّبٍ أَردانُها","رَخصَةِ الأَطرافِ كَالرِئمِ الأَغَنِّ",1,"ن",1,0],["بَلْ عَلَى والدٍ حَزِينٍ","دهاهُ الرَّدَى بِمَنْ",2,"ن",1,0],["بَلَعتَ نَسيءَ العَنبَرِيِّ كَأَنَّما","تَرى بِنَسيءَ العَنبَرِيِّ جَنى النَحلِ",3,"ل",1,0],["بَل عِفَّةٌ وَمُروؤَةٌ وَفتوَةٌ","وَقَناعَةٌ وَطَهارَةٌ بِصَلاحِ",4,"ح",1,0],["بل عندكم من يُمنهِ شاهدٌ","قد أفصحَ القولَ وقد أعربا",5,"ب",2,0],["بل عُلِّلَتْ عنهم بأشباههمْ","في الحسن من سِرْبٍ ومن رَبْربِ",6,"ب",1,0],["بل عصمةً من وليِّ الصالحاتِ لهُ","كيلا يُجَشِّمَهُ حِرْصاً ولا تعبا",7,"ب",2,0],["بل عاملٌ من خلفهِ وأمامِهِ","عَمَلان يُقطع فيهما ويُعاثُ",8,"ث",1,0],["بل عز مثلك لا كفاء له","بنَّيت بعد حفوفه ربعه",9,"ع",2,0],["بل عطاياه لا تزال تبارى","وافداتٍ إلى ذوي الآمالِ",10,"ل",1,0],["بل عَدَتْ جُلَّهم عوادي المنايا","عن نوى المقفلين والقُفّالِ",11,"ل",1,0],["بَل عَزَّني مِنكَ وَعدٌ","لَهُ الأَنامُ تَرومُ",12,"م",1,0],["بَل عَدِّهِ لِلمَشهَدِ الجَوّابِ","وَصاحِبٍ يُدعى أَبا اللَبلابِ",13,"ب",1,0],["بل على وِدّي بجَفْن قد دَمي","كنتُ أسعى راغباً عن قَدَمَي",14,"ي",1,0],["بَلْ عَمَّ دُنْيَاهُمْ صُرُوفٌ لَهَا","مِنَ الرَّدَى أَوْدِيَةٌ زَاخِرَهْ",15,"ر",2,0],["بَل عِبادُ الإِلهِ نَحنُ يُعافي","مُحسِناً ذا وَيَبتَلي ذا مُثيبا",16,"ب",2,0],["بل عنه في سُود الوقائع فَتِّشُوا","أو فَاسْأَلُوا عنه النَّجيعَ الأحمرا",17,"ر",2,0],["بَلْ عصا ناصرٍ تَدبُّ على الأر","ض؛ ريَاضًا خضراءَ، مُعْشَوْشِبَات",18,"ت",1,0],["بلعرب العادل المرتضى","سلالةُ سلطانَ نسلَ الكرامْ",19,"م",1,0],["بل عاقني حنف الرجلين عن طلبي","وجه المعاش بتغريب وتشريق",20,"ق",1,0],["بلعتهم هذه الأر","ض فهم فيها رزوح",21,"ح",1,0],["بل عن الشمس أختها إذ أطلّت","لو رأت وجهها هوت من سماها",22,"ا",3,0],["بَل عالِماً يَخبِطُ في مَهزَلَه","وَاِنسَحَبَ الطَيفُ الى ظُلمَتِه",23,"ه",1,0],["بل عَدَت وَلَذَّ لها","في المَفاوِزِ الخَبَبُ",24,"ب",1,0],["بل عَزَّ أشياخُ النحاةِ بعلمها","فرّائها وَقرينه زَجّاجها",25,"ج",3,0],["بل عَرْفُ عُرْفِ الّذي أَملاهُ عَطَّرنا","لا مِسْكُ نِقْسٍ ولا كافورُ أَطْراس",26,"س",1,0],["بَلْ عَزَبَتْ في الشَّوْلِ حَتَّى نَوَتْ","وسُوِّغَتْ ذا حُبُكٍ كالإِرَمْ",27,"م",1,0],["بل عماء في مقلة الدين يا له","في عليه إذ أصبح الدين أعمه",28,"م",2,0],["بل عمَّه في الجميع لا برحت","سحائبُ الجود منك تنسكب",29,"ب",1,0],["بل عندَنا إن سألتُم واثقين بنا","في حاجَةٍ نِعَمٌ جوابُها نَعَمُ",30,"م",1,0],["بل عل طفَكَ إن يمنَّ بزورَةٍ","فأبثّهُ ما قد أجنّ فؤادي",31,"د",2,0],["بل عروض تنزهت عن مثال","حاطها بالكمال ذوق رئيس",32,"س",1,0],["بل عجيبٌ كيف بي قد غدر","حاسدا حرمة شيخ هشيم",33,"م",1,0],["بل عن تفجر رائد إيمانه","لا ينتهي ويزيد بالإنفاق",34,"ق",1,0],["بل عن محبة شعبة وخياره","والشعبُ حُقَّ له الذي يَختارُ",35,"ر",1,0],["بلعب قمار يقطعون زمانهم","ونرد وشطرنج أتوا معه ميسرا",36,"ر",2,0],["بلعنٍ صمّتَ الآذانُ منه","وسبّ للصحابة يستَدَام",37,"م",1,0],["بل عمموا إصلاحهم في ملكهم","لم يغفلوا أيا من الأجزاء",38,"ا",2,0],["بل عيشه قد نغصت ساعاته","ذكرى له تبدو بمختلف الصور",39,"ر",1,0],["بل عاقر الصهباء أمّ شرورنا","وذنوبنا والغيّ والضراء",40,"ا",2,0],["بل عاملاه بإحسان ومغفرة","ويصفح الله عمن عن أخ صفحا",41,"ح",2,0],["بلعوط جفتا بدائع","وعذار في الخد لامه",42,"ه",1,0],["بَل عِشتَ في طيبِ عَيشٍ","تَقيكَ نَفسي وَمالي",43,"ل",2,0],["بِلَعوبِ اليدينِ في ال","سَّير لُعب المُثاقِف",44,"ف",1,0],["بَل عَينُ أَعيانِ الأَكارِمِ في الوَرى","وَضِياؤُها في الدّهرِ بَل إِنسانُها",45,"ن",3,0],["بَل عوَّل الكُلُّ عَلى الحِمار","وَأَخَذوا الجار بِظُلمِ الجار",46,"ر",1,0],["بلعربُ ابنُ ابنِ سلطان الذي خضَعتْ","له من الناس عُبدانٌ وأحرارُ",47,"ر",1,0],["بَلَعْرُبٌ نجلُ سلطانَ الذي حسُنَتْ","أخلاقُه وهْوَ ربُّ المنظرِ الحسَن",48,"ن",1,0],["بل علم الكيمياء ناظره","فآض فضيه إلى ذهبه",49,"ب",2,0],["بل عَهدنا مألفاً ومعهداً","عمر الحسنُ حماهُ وسكن",50,"ن",1,0],["بل عطل الأفلاك وانزعجت له","الأملاك بل عرش المهيمن مادا",51,"د",2,0],["بل عنده لعداته","والمال قمع واجتياحُ",52,"ح",1,0],["بل عالجي باليأس آمالي ففي","شكى عذابك في الهوى وعذابي",53,"ي",1,0],["بل عذيري من ذي هوى لا يَراني","إن أصبت الصواب يوما مصيبا",54,"ب",2,0],["بلع الآمال بي","يا ليته لا بلعا",55,"ع",2,0],["بل عفة دارهُم مأمنٌ","أَعزّة جارهمُ لا يُضامْ",56,"م",1,0],["بل عين فكرتِها رأت إنسان ع","ين زمانه في نوره لا نورها",57,"ر",3,0],["بَل عذيري من مَعشَرٍ يَزعُمونا","أنَّهُم آمنوا وهُم يكذبونا",58,"ن",2,0],["بل عاش شعبٌ ناهضٌ يقظ","حرّ يحبّ العلم والعملا",59,"ل",2,0],["بل عهدناك ناطقاً تملأ الرّب","ع بما يجعل النّفوس سكارى",60,"ر",2,0],["بل علينا القدوة المثلى بمن","ملأوا الشّرق جهادًا وطلابا",61,"ب",2,0],["بلعت يوم بندقه","في لونها خضره",62,"ر",2,1],["بَل عَن تَمَنّي فَتاةٍ لَيسَ يَعلَمُها","وَلَم تَكُن مِن ذَواتِ الفُحشِ وَالعَهَرِ",63,"ر",1,0],["بل عجبي للدهر إذ جاء به","خير بنيه وهو في حاله الهرم",64,"م",1,0],