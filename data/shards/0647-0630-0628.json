abudhabi.ae/diwan/poem/132539","الرمل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97963","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88932","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108336",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101225","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92130","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91098","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91903","البسيط"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131910","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81276","الخفيف"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103268","الرمل"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114013","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66150","الرمل"],[4935,"خل عنك الهزل خلي والكسل","https://www.poetsgate.com/ViewPoem.aspx?id=129317",""],[5736,"كما تدين تدان","https://www.poetsgate.com/ViewPoem.aspx?id=203842",""],[402,"بكل عاد الرضي وابن العميد","https://www.poetsgate.com/ViewPoem.aspx?id=35457",""],[5970,"نحن يا أيام أضياف لديك","https://www.poetsgate.com/ViewPoem.aspx?id=130588",""],[6093,"فِيْ وَدَاعِ المُخْلِصينَا","https://www.poetsgate.com/ViewPoem.aspx?id=176427",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["هَذَّبْتَهَا فَالْعَرْضُ يُذْكِرُ يَوْمُهُ","عَرْضَ الْوَرَى لِلْمَوْعِدِ الْمَكْتُوبِ",0,"ب",1,0],["هَذِّبْ بَنَاتَ الشَّعْبِ إِنْ شِئْتَ أَنْ","تُبْلِغَهُ أَقْصَى المُنَى مِنْ أُمَمْ",1,"م",1,1],["هذّبَتْهُ رياضةٌ من مُجيدٍ","في مُجيدٍ يفوقُهُ تهذيبا",2,"ب",2,0],["هَذَّبتَهُ حَتّى اِستَقامَت","مِن خَلائِقِكَ السُطور",3,"ر",1,0],["هُذِّبَت فَفي","دَنِّها الأَدَب",4,"ب",1,0],["هَذَّبَتهُ السُيوفُ في الدَهرِ وَاليَو","مَ أَتَمَّت تَهذيبَهُ الأَقلامُ",5,"م",1,0],["هَذَّبَ أَخلاقَهُ الزَمانُ وَقَد","طَهَّرَ مَدحُ اِبنِ أُرتُقٍ فاهُ",6,"ا",2,0],["هُذِّبَ في جِنسِهِ وَنالَ المَدى","بِنَفسِهِ فَهوَ وَحدَهُ جِنسُ",7,"س",1,0],["هَذَّبَ اللَهُ مَنطِقي وَحباني","بِالصَفِيِّ الوَفِيِّ مِن أَقلامِكْ",8,"ك",1,0],["هَذبَ السُّؤْدُدُ أَخْلاقَهُم","فَلَهُمْ مِنْ شَرَفٍ ما يَدَّعُونا",9,"ن",2,0],["هَذِّب سَجاياكَ لا يَكثُرُ بِها دَنَسٌ","مِنَ الدَنايا لِيَرقى في العُلا راقِ",10,"ق",1,0],["هذبه العرض على الأذواق","فيما يقيم القوم من أسواق",11,"ق",1,0],["هَذَّبَتْهُمْ آدَابُهُ وَأَرَاهُمْ","أَقْوَمَ لَهُمْ السُّبْلِ فِي شِعَابِ الوُجُودِ",12,"د",1,0],["هذّبوا الفُصْحَى ولمُّوا شَمْلَها","بعد أن كانت صَدىً في سَبْسَبِ",13,"ب",1,0],["هذَّبْتَها بالعرض يذكر يومُهُ","عرض الوَرى للموعِدِ المكتوب",14,"ب",1,0],["هذِّب لنا أخلاق أهليه فقد","غشّى عليها الجهل والعدّوان",15,"ن",1,0],["هَذب الفَضل وَالمَكارم مِنهُ","خُلُقاً يُبهر الرِياض دَميثا",16,"ث",2,0],["هَذَّبْتُها أرجو الإله بها غداً","فيحطُّ عنى الإثْم والآصاَرَا",17,"ر",2,0],["هذّبتها في نحو نصف عامِ","حتّى غَدت في غاية الإحكامِ",18,"م",1,0],["هَذَّبتَ أَخلاقَ الزَمانِ وَطالَما","كانَت حَوادِثُهُ تُسيءُ وَتَجهَلُ",19,"ل",1,0],["هَذَّبتُ نَفسي جاهِداً وَلَم أَكُن","عَلى اِجتِلابِ حَظِّها بِقادِرِ",20,"ر",1,0],["هَذَّبَني دَهرِي وَما","دَهرِيَ بِالمُهَذَّبِ",21,"ب",1,0],["هذبتها العلوم دهراً ومن احسن","اوصاف حسنها الأحسان",22,"ن",1,0],["هذَّبوا بالهدى الطباع وعنهم","رونق الحق في الأنام يقام",23,"م",1,0],["هُذِّبَت جِسماً ونَفسا","وهيَ مِن ذَا فِي ازديَاد",24,"د",1,0],["هذّب فتاتك وهي في صغر تجد","تهذبها يسرى إلى الولدان",25,"ن",1,0],["هذِّب وليدكَ وهو طفلٌ راضعٌ","واغرس بهِ حبَّ المعارف عن صِغَر",26,"ر",1,1],["هذَّبوهُ واكسبوهُ نشاطاً","واجتنابَ الأضرارِ والأسواءِ",27,"ا",2,0],["هَذَّبتني آياتُ حسنِك حَتّى","صرت في الحُب مفرَداً في المَقال",28,"ل",1,0],["هَذّبتها ذا العُلى تَهذيبَ ذا أَدبٍ","وَصغتها مِن نضارِ الحسنِ مُغتَنِما",29,"م",2,0],["هَذَّب الشِّعرَ وَأَبدى المِلَحا","بِاِنسِجامٍ مُستَطابٍ مُتقَنِ",30,"ن",1,0],["هَذَّبَتها تَهذيبَ خِدْنِ فَطانةٍ","لِمهذّبٍ هُوَ لِلمَحاسِنِ مَجمَعُ",31,"ع",1,0],["هذب الأخلاق بل قد ثقفا","نفسه تثقفاً لم يدنسِ",32,"س",1,0],["هذَّبْتَني حتى لقَالَ الوَرَى","واهاً لهُ مِنْ شاعرٍ مُفْلِقِ",33,"ق",1,0],["هَذَّبَتني نَوائِبُ الدَهرِ حَتّى","صِرتُ كَالوَصلِ بَعدَ طولِ الجَفاءِ",34,"ا",2,0],["هذّب النفس بالعلوم لترقى","وخذ الكل فهي للكلّ بيت",35,"ت",1,1],["هذّبى نسلك للفدّى من المه","د بما يكفنل العلاء اللّبابَا",36,"ب",2,0],["هذّبوا المرأة فالمرأة في","كلّ عصرٍ روح طيبٍ ذائعة",37,"ع",2,0],["هذبوها بني الحمى هذبوها","وعلى منهج الهدى درّبوها",38,"و",3,1],["هذّبوها إذا أردتم علاها","فبغير التّهذيب لن ترفعوها",38,"و",3,0],["هذبوا خلقها ورّقوا نهاها","وارفعوا قدرها ولا تهملوها",38,"و",3,0],["هذِّبُوا النَّشءَ تسُودُوا","يا مصابيحَ الحياه",39,"ه",1,0],["هَذِّبِ النفسَ لا تطع ما تمَنَّت","وتمسَّك بشرعَةِ القرآنِ",40,"ن",1,0],["هَذّبَتنا أخلاقُه وسَقَتنا","راحَ أنسٍ لكن بغيرِ جُنَاح",41,"ح",1,0],["هذبها من ليس بالمهذب","لكنه في ضمنها لم يكذب",42,"ب",1,0],["هذب النفس بالعلوم لترقى","وترى الكل فهي للكل بيت",43,"ت",1,1],["هذبته الخلائق الأشرفي","ات فلله ذلك التهذيبُ",44,"ب",1,0],["هَذَّبَت فِكرُهُ التَّجارِبُ حَتّى","هَتَكَت دونَهُ مِنَ الغَيبِ سِترا",45,"ر",2,0],["هذبتها فكرة قد برقشت","حسنها في طرسها المرقّش",46,"ش",1,0],["هذّب ما يكتب من يعتقد","أنّ جميع الناس يلقونه",47,"ه",1,1],["هذبت أخلاق قوم لا خلاق لهم","فيها فلم يشكروا في الناس تهذيبي",48,"ب",2,0],["هذبته فطنة العل","م فما يخشى معابا",49,"ب",2,0],["هذب بامداحه فكراً فان له","مَدائِحاً ينعش الافكار معناها",50,"ا",3,0],["هذَّبِوني على التّثنّشي فَقَدِّي","غُصنُ بانٍ تَغارُ مِنْهُ الغُصون",51,"ن",1,0],["هذَّبتُه فجعلتُه لك باقيا","ومنعت صرفَ الدهر عن تَصريفه",52,"ف",2,0],["هذبت طبعه صروف الليالي مثلما","هذب السيوف الفيون",53,"ن",1,0],["هذبت من كل شوب صفونا","مثلما هذبت النار الذهب",54,"ب",1,0],["هذبت قرة عيني ثم لم أجد","واخيبة الأمل المرجو في الولد",55,"د",1,1],["هذبتها لجنابكم أبغي بها","حسن القبول الأنور داعي النظام",56,"م",1,0],["هذبتَ جندكَ والرعيةَ آخذاً","بالعُرفِ تنشُرهُ وبالانكَارِ",57,"ر",1,0],["هذب كلامك يا فتى تهذيبا","واهجر مقام الغيد والتشبيبا",58,"ب",2,1],["هذبتك الفضائل الغر حتى","لم يكن فيك مهمز للواحي",59,"ح",2,0],["هذّبتُه لكنني عززتُهُ","من أن يذلَّ لغير شهمٍ أمجدِ",60,"د",1,0],["هذبت نَفسي فَلم تحذر مصادقتي","وَلا يَخاف عدوّي إِن يَغب كذبي",61,"ب",2,0],["هذبه وَالنَفس للآداب قابلةٌ","فَإِنَّها فرصٌ يَحظى بِها السُعَدا",62,"د",2,0],["هذّب مداركها عضّد مدارسها","وارحم طفولتها اذ أنت راعيها",63,"ي",3,0],["هَذِ بَينَنا المَظاهر وَالسر","دَفين هُناكَ في موميائه",64,"ا",3,0],["هذبتهم أمهات ثقفت","بصنوف العلم في دنيا ودين",65,"ن",1,0],["هذبن وصدن أنيس الجليس","بذاك تعلمن حسن الخداع",66,"ع",1,0],["هَذِبُوا بالعِلْمِ والآدابِ","اخلاقَ الفَتاةِ",67,"ت",3,0],["هذب النفس إذا كنت فتى","يعشق العليا ولم يرض الفشل",68,"ل",1,0],["هذِّبْ فعالكَ كم تدورُ دوائرٌ","واحرص لئلا يجتبيكَ هوانُ",69,"ن",1,1],["هذبتهم آدابه وأراهم","أقوم السبل في شعاب الوجود",70,"د",1,0],["هذبينا إن نحد عن خطة","جملت عندك أو عزت عليك",71,"ك",1,0],["هَذَّبوا الأخلاقَ مِنَّا","حين قاموا ناصِحِينا",72,"ن",2,0],["هذب النفس من هيولى وجودي","وأعذني من ربقة الأحزان ِ",73,"ن",1,0]]}