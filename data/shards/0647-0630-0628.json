{"poems":[[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[93,"هذب بنات الشعب إن شئت أن","https://www.aldiwan.net/poem11305.html","السريع"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[85,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[66,"هل علم الطيف عند مسراه","https://www.aldiwan.net/poem38476.html","المنسرح"],[44,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[105,"مصر أنت الحياة والموت طرا","https://www.aldiwan.net/poem43126.html","الخفيف"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[46,"لقد فنيت وهل تبقى إذا عمرت","https://www.aldiwan.net/poem23055.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[90,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[109,"هاك إبلى فيك المطي حثيثا","https://www.aldiwan.net/poem16300.html","الخفيف"],[128,"يا أيها الملك المرجى فضله","https://www.aldiwan.net/poem50601.html","الكامل"],[189,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[235,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[235,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[235,"واعجبي وحادث الد","https://www.aldiwan.net/poem32166.html","مجزوء الرجز"],[261,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[500,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[538,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"]],"verses":[["هَذَّبْتَهَا فَالْعَرْضُ يُذْكِرُ يَوْمُهُ","عَرْضَ الْوَرَى لِلْمَوْعِدِ الْمَكْتُوبِ",0,"ب",1,0],["هَذِّبْ بَنَاتَ الشَّعْبِ إِنْ شِئْتَ أَنْ","تُبْلِغَهُ أَقْصَى المُنَى مِنْ أُمَمْ",1,"م",1,1],["هذّبَتْهُ رياضةٌ من مُجيدٍ","في مُجيدٍ يفوقُهُ تهذيبا",2,"ب",2,0],["هَذَّبتَهُ حَتّى اِستَقامَت","مِن خَلائِقِكَ السُطور",3,"ر",1,0],["هُذِّبَت فَفي","دَنِّها الأَدَب",4,"ب",1,0],["هَذَّبَتهُ السُيوفُ في الدَهرِ وَاليَو","مَ أَتَمَّت تَهذيبَهُ الأَقلامُ",5,"م",1,0],["هَذَّبَ أَخلاقَهُ الزَمانُ وَقَد","طَهَّرَ مَدحُ اِبنِ أُرتُقٍ فاهُ",6,"ا",2,0],["هُذِّبَ في جِنسِهِ وَنالَ المَدى","بِنَفسِهِ فَهوَ وَحدَهُ جِنسُ",7,"س",1,0],["هَذَّبَ اللَهُ مَنطِقي وَحباني","بِالصَفِيِّ الوَفِيِّ مِن أَقلامِكْ",8,"ك",1,0],["هَذبَ السُّؤْدُدُ أَخْلاقَهُم","فَلَهُمْ مِنْ شَرَفٍ ما يَدَّعُونا",9,"ن",2,0],["هَذِّب سَجاياكَ لا يَكثُرُ بِها دَنَسٌ","مِنَ الدَنايا لِيَرقى في العُلا راقِ",10,"ق",1,0],["هذبه العرض على الأذواق","فيما يقيم القوم من أسواق",11,"ق",1,0],["هَذَّبَتْهُمْ آدَابُهُ وَأَرَاهُمْ","أَقْوَمَ لَهُمْ السُّبْلِ فِي شِعَابِ الوُجُودِ",12,"د",1,0],["هذّبوا الفُصْحَى ولمُّوا شَمْلَها","بعد أن كانت صَدىً في سَبْسَبِ",13,"ب",1,0],["هذَّبْتَها بالعرض يذكر يومُهُ","عرض الوَرى للموعِدِ المكتوب",14,"ب",1,0],["هذِّب لنا أخلاق أهليه فقد","غشّى عليها الجهل والعدّوان",15,"ن",1,0],["هَذب الفَضل وَالمَكارم مِنهُ","خُلُقاً يُبهر الرِياض دَميثا",16,"ث",2,0],["هَذَّبْتُها أرجو الإله بها غداً","فيحطُّ عنى الإثْم والآصاَرَا",17,"ر",2,0],["هذّبتها في نحو نصف عامِ","حتّى غَدت في غاية الإحكامِ",18,"م",1,0],["هَذَّبتَ أَخلاقَ الزَمانِ وَطالَما","كانَت حَوادِثُهُ تُسيءُ وَتَجهَلُ",19,"ل",1,0],["هَذَّبتُ نَفسي جاهِداً وَلَم أَكُن","عَلى اِجتِلابِ حَظِّها بِقادِرِ",20,"ر",1,0],["هَذَّبَني دَهرِي وَما","دَهرِيَ بِالمُهَذَّبِ",21,"ب",1,0],["هذبتها العلوم دهراً ومن احسن","اوصاف حسنها الأحسان",22,"ن",1,0],["هذَّبوا بالهدى الطباع وعنهم","رونق الحق في الأنام يقام",23,"م",1,0],["هُذِّبَت جِسماً ونَفسا","وهيَ مِن ذَا فِي ازديَاد",24,"د",1,0]]}