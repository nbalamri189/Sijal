oem.aspx?id=59104",""],[6082,"كل الخطى","https://www.poetsgate.com/ViewPoem.aspx?id=60243",""],[6117,"تُمِّمَتْ أخْلاَقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=182796",""],[6225,"صلاة ودعاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80906&r=&rc=175",""],[6301,"مبارك هذا النجاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80679&r=&rc=43",""],[6355,"حصاد الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66593&r=&rc=53",""]],"verses":[["مَن يَرَ هَوذَةَ أَو يَحلُل بِساحَتِهِ","يَكُن لِهَوذَةَ فيما نابَهُ تَبَعا",0,"ع",2,0],["مُنيرٌ يَحسُرُ الغَمَراتِ عَنهُ","وَيَجلو ضَوءُ غُرَّتِهِ الظَلاما",1,"م",2,0],["مَنْ يُرَبِّي كَالأَفَاضِلِ مِنْ","هَؤُلاَءِ الصَّفْوَةِ النُّجْبِ",2,"ب",1,0],["مَنْ يَرْجِعُ الشَّيْخُ إِلَى بَيْتِهِ","إِلَى مُصَلاَّهُ مِنَ الزَّاوِيَهْ",3,"ي",2,0],["مُنِيرَ السُّرَى بِشْراً بِعَامِكَ مُقْبِلاً","وَلاَ طَابَ ذِكْراً صِنْوُهُ المُتَصرِّمُ",4,"م",1,0],["من يرّي طلعة غدوا","إش يريد الشمس تطلع",5,"ع",1,0],["من يريد يعمل نزيها","هاذ هو زمان الأفراح",6,"ح",1,0],["مَن يَرجِعِ العامَ إِلى أَهلِهِ","فَما أَكيلُ السَبعِ بِالراجِعِ",7,"ع",1,0],["من يَرَ كرسيكَ السنيّ فقد","رأى ابن جوزيها على دَرج",8,"ج",1,0],["من يرى رأسك الصقي","لَ فلا يشتهي الكَمرْ",9,"ر",1,0],["من يرد حقه فللحق أنصا","ر كثير وفي الزمان كرام",10,"م",1,1],["من يرده لغير عقباه يحرم","فتزوّد منه لتلك الدارِ",11,"ر",1,0],["مَن يُرتَجى في الناسِ غَي","رُكَ لِلعُيونِ الباكِيَه",12,"ي",2,0],["مَن يُرتَجى لِدِفاعِ كَر","بِ مُلِمَّةٍ هِيَ ما هِيَه",12,"ي",2,0],["من يراه وقد تبين فيه","زمراً في الزّحام تحشر حشرا",13,"ر",2,0],["مَن يَركَبِ الغَيَّ لا يَحمَد عَواقِبَهُ","وَمَن يُطِع قَلبُهُ أَمرَ الهَوى يَهِمِ",14,"م",1,0],["مَنْ يرتضي بشمائلي","إني أطالبُ بالكِرا",15,"ر",2,0],["مَنْ يرتضي لفضيلتي","إني أضارِبُ بالكرى",16,"ر",2,0],["مَن يَروم أَمراً بِقَلب حوّلِ","يَنقضِ الدَهر لَهُ ما أَبرَما",17,"م",2,0],["مَن يَرُم جَمعَهُم يَجدهُم مَراجي","حَ حُماةً لِلعُزَّلِ الأَحراضِ",18,"ض",1,0],["مَن يَركَبُ الخَطَرَ الصَعبَ الَّذي رَكِبوا","بِالأَمسِ أَو يَبذُلُ النَصرَ الَّذي بَذَلوا",19,"ل",3,0],["مَن يُرَجّيكِ بَعدَ بَيعِ مُحِبٍّ","كانَ يَهوى بِجُهدِهِ ما هَويتِ",20,"ت",1,0],["مَن يُرزَقِ الحَظَّ يَسعَد أَينَ كانَ بِهِ","وَمَن يُخَيَّب فَإِنَّ المَوتَ مِضمارُ",21,"ر",1,0],["مَن يُرِد صَفوَ عَيشَةٍ يَبغِ مِن دُن","ياهُ أَمراً مُبَيَّنَ الإِعجازِ",22,"ز",1,0],["مَنْ يُرْتَجى غَيرُكَ أَوْ يُتَّقَى","وفي يَدَيكَ الجودُ والباسُ",23,"س",1,1],["مَنْ يَرْقَى إِيمَانُهُ وَهُوَ اليَقِينُ فَمَا","وَهْمُ الحَيَاةِ وَمَا الأَخْطَارُ وَالرُّتَبُ",24,"ب",1,0],["من يَرضَ ربُّ العرش في ملكوته","عنه، تفاني الناسُ في مرضاته",25,"ت",2,0],["من يُرِدْ خدمةَ العروبة والإسْ","لامِ، يَجْعَلْه في الجهاد إمامه",26,"م",2,0],["من يرضَ بالعيش في ظل الهوان، فلا","آوتْه أرضٌ، ولا قرَّتْ نواظره",27,"ر",2,0],["مَنْ يرى؟ أي زحام ودرى","إنه يرنو إلى زيف الخواءِ؟",28,"ا",2,0],["من يرد اللون للألوان ؟ من","يهب الأجفان شئا من خلابة ؟",29,"ب",2,0],["من يرى مبدأ التعقل جبناً؟","من أراد الحياة مات رصينا",30,"ن",2,0],["من يراني ؟ اني هنا يا عشايا","أنفخ السقف ، أو أدراي الرقادا",31,"د",2,0],["من. يروح أبعمق.؟؟ وصفك.؟ مايحاوي","مثل من. راح .؟ أيتفقع..؟؟ في رحيمه",32,"م",2,0],["من يردّ اللّون للألوان ؟ من","يهب الأكفان شسئا من خلابه",33,"ب",2,0],["مَن يَراهُ وَلَو بِلَمحة طَرف","فَسَعيدٌ صَباحُهُ وَمَساؤُهُ",34,"ا",3,0],["مَن يَرى الحُب مَذهَباً","ماتَ بِالوَجد وَالجَوى",35,"و",2,0],["مَن يَرى وَجهَهُ وَداجي صَدغي","هِ سَعيد صَباحُهُ وَمَساؤُه",36,"ا",3,0],["مَن يُرِد مَطلَباً بِجَدِّكَ لا يُك","دي وَمَن كُنتَ رِدءَهُ لَن يُكادا",37,"د",2,0],["مُنيرُ الهُدى زاكي الفؤادِ مُنيبُهُ","بَعيدُ المَدى داني الغَياثِ قَريبُهُ",38,"ه",1,0],["مَنْ يَرْكَبِ الَّلهْوَ أَوْ تَغَشَّى بِهِ","عَاشَ أَسِيرًا مَا لَمْ يَعِ النَّهْيَا",39,"ي",2,0],["من يرضَ عبدالله يوماً خصمه","فليرض بيعَ حياته بمماتهِ",40,"ت",2,0],["منيرةٌ بشموسٍ","مُضيئةٌ ببُدور",41,"ر",1,0],["مَنْ يَرُمْ يَحْصُرُ أَمْدَاحَهُ","حَلَّ فِي لُجَّةٍ عِيٍّ بَوَاحْ",42,"ح",1,0],["مَنْ يَرَى مِنْكَ هِلاَلاً بِعِيدِ","يَجْتَلِي عِيدَيْنِ وَقْتَ الشًّهًودِ",43,"د",1,0],["من يَراها لا يَراها خُلِقَت","مثلَ خَلقِ الناس من طِينٍ وماء",44,"ا",2,0],["منير المحيا كلما شمت وجهه","أعاد إليك الطرف حد كليل",45,"ل",1,1],["مُنِيرٌ مُنيفٌ وَجْهُهُ ومَحَلُّه","عَلى القَصْرِ مِن لألائِهِ ما عَلى العَصْرِ",46,"ر",1,0],["مَن يَرُم إِحصاءَ ما فيهِ مِنَ ال","مَجدِ يُلجَمُ من يَدِ العَجزِ بِعِيِّ",47,"ي",1,0],["مَن يُرَجّي خَيراً مِن اِبنِ عُنَينِ","لَم يَنَل مِنهُ غَيرَ خُفَّي حُنَينِ",48,"ن",1,1],["مَن يَرَهُ في سَرجِهِ راكِضاً","حِصانَهُ يَوماً فَوَيلُ اُمِّهِ",49,"م",2,0],["مَن يَرُم مِثلاً لَكُم في دَهرِكُم","فَلَقَد باءَ بِزورٍ وَمُحالِ",50,"ل",1,0],["من يرى الصوم دواما حرفة","وله من خشية الله انزوا",51,"و",2,0],["من يَرُم في الحياة مجدا أثيلاً","وبلوغ المنى وعزةَ شان",52,"ن",1,0],["من يُرتَجى للجودِ بعدَك والنَدى","والفضلِ والإِسعاد والإِسعافِ",53,"ف",1,0],["مَن يَرَ في وُلدِهِ أَيداً يُسَرُّ بِهِ","تَهِن قِوى شَيخِهِ وَالشَيخُ مُنحَذِفُ",54,"ف",1,0],["من يرى الهوى نازلاً","بالحمى ثم لا يجن",55,"ن",1,0],["مَن يَرى بُعدي فَقَد أَبعدته","وَقَريبي كُلّ مَن يَرجو اِقتِرابي",56,"ب",2,0],["مَن يَرتدي بحديدِ الهندِ منْ شَرَفٍ","ويُنْعلُ الخيلَ راجيهِ بعِقْيان",57,"ن",1,0],["من يردِ الماء حيث كان إذا","كان عليه ما يمنعُ الوارِد",58,"د",1,0],["من يرى دنياه سجناً","هل يرى فيها الفُكاههْ",59,"ا",3,0],["من يروى العلم وما عنده","إجازة ما جار هذا بحال",60,"ل",1,0],["مَن يَرُم جارَهُ يَكُن مِثلُ مارا","مَ بِكَفَّيهِ أَن يَنالَ السِماكا",61,"ك",2,0],["من يريني البانَ والوردَ معاً","في تَثَنِّيه خدوداً وقدودا",62,"د",2,0],["من ير ذا وِرْداً وذاكَ قَربَاً","له يقل ذا العشبُ من ذاك المطَرْ",63,"ر",1,0],["من يرد إسعاف أمته","أغدقت فيها أياديه",64,"ي",2,0],["من يرتضي منكمو بالعار يلبسه","وللضلالات ان تنصح له بخعا",65,"ع",2,0],["من يُرى للشَّيْطانِ فيهِ نَصيبٌ","فهو مَبْعودُ دولَةِ الدَّيَّانِ",66,"ن",1,0],["من يرَى الأَغْيارَ في أَفعالِهِمْ","هو لا شكَّ البَعيدُ المُشْرِكُ",67,"ك",1,0],["منيرٌ تجلّى في سَماواتِ رِفعةٍ","كَواكِبُها أخلاقُه والمآثِرُ",68,"ر",1,0],["مَن يَركبِ البحرَ والبوصِيَّ مُعتَرِضاً","إِلى حَضَوضى فبئس المركبُ التمسا",69,"س",2,0],["مُنيرٌ تَجَلَّى فالوَرى","تُشيرُ تَطيرُ تُنيرُ تَسير",70,"ر",1,0],["مَن يرتَشِ