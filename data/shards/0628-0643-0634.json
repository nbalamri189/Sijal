{"poems":[[74,"عللونا عند النوى بالعناق","https://www.aldiwan.net/poem19354.html","الخفيف"],[30,"وكيف بنفس كلما قلت أشرفت","https://www.poetsgate.com/ViewPoem.aspx?id=21752",""],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47437","الرمل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137935",""],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105039","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110645","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100794","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89358","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114567","المجتث"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83569","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72464","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""]],"verses":[["بك شدتْ قريحتي بعد وهنٍ","وبنعمى يديك حلَّ وثاقي",0,"ق",2,0],["ب كَشَفَ الله البَلاءَ، وَأشْرَقَتْ","لَهُ الأرْضُ والآفاقُ نَحْسٌ هلالُها",1,"ل",3,0],["بِكِ شُغْلي واشْتِغالي","وَمَضَى زَيْدٌ وَعَمْرُو",2,"ر",2,0],["بكِ شلت في وقعة المرن يس","راهم فلم تقوَ أن تمدَّ اليمينا",3,"ن",2,0],["بك شيخ طائفة الدعاة الى الهدى","ومُجَمِّعُ الأحكام بعد تبدد",4,"د",1,0],["بك شيدت أعلامها وعليك ر","ف لواؤها وبراحتيك زمامها",5,"م",3,0],["بكَشِّي وراسِ المرِّ أيضاً وَفَالِكُم","وذَلِكَ نَجمٌ في الدجاجَةِ بالشَّهرِ",6,"ر",1,0],["بك شرفت أممٌ قفتك فحسنهم","يعلو بفضلك كل ذي حسناء",7,"ا",2,0],["بك شعري تروق فيه قوافٍ","خطرت في وشي الكتاب المنمنم",8,"م",1,0],["بِكَ شادَ اللَهُ مِلّتَهُ","حِينَ كادَ الكُفرُ يَثلِمُها",9,"م",3,0],["بك شرف العلم الشريف وأزهرت","أزهار أزهرنا يهنَّأ لم يُهَن",10,"ن",1,0],["بِكَشفِ حُجبِكَ رُوحي","رُوحي وباهي المُباهي",11,"ي",1,0],["بك شبهتها وفي عرس هادي","بالتهاني أزرتها العباسا",12,"س",2,0],["بِك شُغلي كَما عَلِمت وَما لي","شُغُلٌ في سِواكَ بِالكُليّه",13,"ي",2,0],["بكشف الكروب وستر العيوب","يقال له الكاشف الساتر",14,"ر",1,0],["بكشفك حجب النور عن وجهك الذي","رآه فؤاد المصطفى ليلة الاسرا",15,"ر",2,0],["بكشف الوجه كم ضاعت فتاة","وكم عار أتاها من خليل",16,"ل",1,0]]}