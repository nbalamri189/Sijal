wan/poem/108051","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131279",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131275",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34657","الرمل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40129","الكامل"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[4677,"لك با حنونة","https://www.poetsgate.com/ViewPoem.aspx?id=203949",""],[4679,"الحمدُ لله الكريم على","https://www.poetsgate.com/ViewPoem.aspx?id=142768",""],[4750,"ياسيدي خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=180430",""],[4755,"إنْ لَم تَجدْ لِقَصِيدَتِي بَحرَا","https://www.poetsgate.com/ViewPoem.aspx?id=184569",""],[4831,"لنْ يَنْحَنِيَ القلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=208012",""],[1901,"أرهقْتنا الأيامُ بسطاً وقبضاً","https://www.poetsgate.com/ViewPoem.aspx?id=160385",""],[4916,"ثورة احساسي","https://www.poetsgate.com/ViewPoem.aspx?id=136534",""],[4927,"أسعد الله مساها","https://www.poetsgate.com/ViewPoem.aspx?id=29614",""],[182,"الرويبضة","https://www.poetsgate.com/ViewPoem.aspx?id=72840",""],[4978,"تشطير يا غربتي","https://www.poetsgate.com/ViewPoem.aspx?id=177240",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5057,"يا عُمَرُ .","https://www.poetsgate.com/ViewPoem.aspx?id=184030",""],[585,"حي الشريف وحي البيت والحرما","https://www.poetsgate.com/ViewPoem.aspx?id=161911",""],[3591,"حلفتُ بأن أدوم على هواكا","https://www.poetsgate.com/ViewPoem.aspx?id=149396",""],[5102,"لا أهلاً ولا سهلا..","https://www.poetsgate.com/ViewPoem.aspx?id=12859",""],[5102,"كن إرهابيا ولو لمرة..","https://www.poetsgate.com/ViewPoem.aspx?id=13185",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5193,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=213571",""],[5199,"دمتي","https://www.poetsgate.com/ViewPoem.aspx?id=145544",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5409,"ليس يجدي من الضعيف الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=155309",""],[5458,"لا أحب الآفلين","https://www.poetsgate.com/ViewPoem.aspx?id=72400",""],[5590,"يا من هوى مع فضله همة","https://www.poetsgate.com/ViewPoem.aspx?id=105284",""],[5616,"متشاعرون","https://www.poetsgate.com/ViewPoem.aspx?id=203329",""],[5652,"طفلة العشرين","https://www.poetsgate.com/ViewPoem.aspx?id=137082",""],[5758,"مجاز الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=201128",""],[5758,"تراتيل الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=207926",""],[5829,"الكون يختصر","https://www.poetsgate.com/ViewPoem.aspx?id=187193",""],[5956,"غليل وعويل","https://www.poetsgate.com/ViewPoem.aspx?id=181971",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6035,"كارِهة.. ! .","https://www.poetsgate.com/ViewPoem.aspx?id=174226",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[4442,"أرهقتني بين المقابر جلبه","https://www.poetsgate.com/ViewPoem.aspx?id=171231",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6159,"كوز الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85858&r=&rc=4",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[463,"بلغتْ صبرا فقالت ما الخبرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60054&r=&rc=110",""],[6256,"يا حلو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65920&r=&rc=8",""],[6256,"مداعبة صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65926&r=&rc=14",""],[6355,"رحلة الحرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66594&r=&rc=54",""]],"verses":[["أَرهَبُ أَن يَظهَرَ الحَديثُ وَأن","تَسقُطَ في كَفِّ غَيرِهِ الكُتُبُ",0,"ب",1,0],["أرِهَا السَّوَابِحَ فِي الْمَجَازِ حَقِيقَةً","مِنْ كُلِّ قُعْدَةِ مِحْرَبٍ وَجَنِيبِ",1,"ب",1,0],["أرهط أمرىء القيس اعبأوا حظواتكم","لحي سوانا قبل قاصمة الظهرِ",2,"ر",1,1],["أرِهِ مكارمَكَ اللواتي لم تزل","منها يطول ضُغاؤُهُ وضُباحُه",3,"ح",2,0],["أرْهبْتَ فيه عُداة المُلك فانقلبوا","منه بأقلق أحشاءٍ وأكبادِ",4,"د",1,0],["أرهقتهم قدر البوار بقوة","وهبت لرأيك أوشك الإرهاق",5,"ق",1,0],["أَرهَفَت سَمعَ العَصا وَاِكتَحَلَت","إِثمِدَ الزَرقاءِ في عَرضِ السَدَر",6,"ر",1,0],["أَرهَفتهُ المَنون ثُمَ أَنامت","ه لِيَوم محجّل أَرونان",7,"ن",1,0],["أُرهِفنَ إِرهافَ الأَعِن","نَةِ وَالحَمائِلِ وَالسُيورِ",8,"ر",1,0],["أَرهَقتَني في هَوى مَن لَيسَ يُنصِفُني","وَلَيسَ يَنفَكُّ مِن زَهوٍ وَمِن تيهِ",9,"ي",2,0],["أَرهَبُ السَيفَ إِن وَرَدتُ عَلى الحَي","يِ وَأَطوي الهُمومَ وَالقَلبُ صادِ",10,"د",1,0],["أَرهَقَت هِندٌ حَياتي","ما لِهِندٍ مِن مَتابِ",11,"ب",1,0],["أرهَقَتْنا ملامةً","بعدَ إيضاحِ عُذْرِنا",12,"ن",2,0],["أرهب بطياراتها","تُلقي المنون وَتمطر",13,"ر",1,0],["أرهقوكم ذلاً وأَنتم سكوتٌ","أين أين الأحرار أين الأباة",14,"ه",1,0],["أَرْهَفْتَ حَدِّي فَهْوَ غَيْرُ مُفَلَّلٍ","وَرَعَيْتَ عَهْدِي فَهْوَم غَيْرُ مُضَيَّعِ",15,"ع",1,0],["أرهبَ الزئّار في تِس","عَةِ أَعوامٍ فَأَعوى",16,"و",2,0],["أرِها السَّوابح في المجاز حقيقة ً","من كلِّ قعدة ِ مجربٍ وجنيب",17,"ب",1,0],["أرِه لثورته عِظامَ جماجمٍ","وابعَثْ له زنداً أطنَّ وساعدا",18,"د",2,0],["أرهقونا ما شئتم واظلمونا","وامنعونا حتى الكرى والطعاما",19,"م",2,0],["أرهفتَ حَدِّى ، فَهوَ غيرُ مُفلَّلٍ","وَرَعَيْتَ عَهْدِي، فَهْوَ غَيْرُ مُضَيَّعِ",20,"ع",1,0],["أَرهَبتَهُم حَتّى تَحَقَّقَ مَن نَأى","أَن لَيسَ يُنجي مِن سُطاكَ بِعادُ",21,"د",1,0],["أرهَقتِ روحي بالعتابِ","فأَمسِكيه أو ذَريني",22,"ن",2,0],["أرهفْ سيوفكَ يا ده","رُ قدْ عرفتَ مَخَزِّي",23,"ي",1,1],["أَرهفتْ حساً وَهاجتْ شجنا","وَبها جوُّ المنى أَمسى فسيحا",24,"ح",2,0],["أرهقت عزلتي عمرا","رغم إبداعي السنا والخيالا",25,"ل",2,0],["أرهفَ للإعراض من عزمته","أصمعَ ما أنبلَ إلا قَرطسا",26,"س",2,0],["أرهفَ من نصحِك صَمصمامةً","بيضاءَ مثلَ البدرِ نَيَّارَهْ",27,"ر",2,0],["أرهفتْ سيفيْن في أجفانها","كلَّ مَنْ غَرَّا يبتْ علَى غَرَرْ",28,"ر",1,0],["أرهفَ من آرائه ذُبَّلاً","ترودُ للطعن أمامَ الطرادْ",29,"د",1,0],["أرهفته بيمين غير طائشة","عند الضراب وعزم غير مضطرب",30,"ب",1,0],["أَرْهَنْتَ عَقْلي بالولَو","عِ ففُكَّ بالسُّلْوانِ رَهْنِي",31,"ن",2,0],["أَرهَفَ الحَدَّ لِلخُطوبِ فَما يَن","فَعث مَعَ هَذِهِ اللَيالي اِحتِشامِ",32,"م",1,0],["أرهَفَتكَ الآدابُ والهِمَمُ العا","ليَةُ الهَمِّ أيَّما إرهافِ",33,"ف",1,0],["أرهفتها في كلّ خطبٍ مُعضلٍ","فنضا عليكَ حُسامهُ فشطرتَهُ",34,"ت",2,0],["أرهقتَ نفسك واستراحوا بعد ما","وكلوا إليك الدار والديارا",35,"ر",2,0],["أرهبوا العاتيَ العتيدَ بها وال","جندُ ملءُ الغبراءِ والزرقاء",36,"ا",2,0],["أَرِهِم مِراسَكَ بعد ما استدرجتَهم","حيناً تُلِينُ قلوبَهم وتدارى",37,"ر",2,0],["أرهَق الدهرُ همتي وشبابي","وسقتني كفاه مرَّ الشراب",38,"ب",1,1],["أرهقنا الغرب ولكنهم","كانوا له الخف وكانوا السّنام",39,"م",1,0],["أرهقت كاهل الثرى قدماها","وتحدَّت بمنكبيها الدراري",40,"ر",2,0],["أرهفت نفسك الهواجس حتى","كثرت في سباتك الأحلام",41,"م",1,0],["أَرهقه جَهلاً على ابن عَمه","عامر لما كان جَد همه",42,"ه",1,0],["أرْهَبْتَني بِلَوائِمٍ لَفَّقْتَها","لمّا عَلِمْتَ بشَأْنِهِ إعْجابي",43,"ب",2,0],["أرهط بن أكال أجيبوا دعاءه","تعاقدتم لا تسلموا السيد الكهلا",44,"ل",2,1],["أرهف للأغراض عن عزمته","أصمع ما أنبل إلا قرطسا",45,"س",2,0],["أرهفت الأجفانُ بيضَ الصفاحْ","وهزت الأعطافُ سمرَ الرِّماحْ",46,"ح",1,1],["أرهف منه الإله نصلاً","تقرأ في صفحتيه نصرا",47,"ر",2,0],["أَرهَفتَ في ظُلمِ الخُطوبِ عَزائِماً","تُثني بِها الأَقدارُ وَهيَ سُكونُ",48,"ن",1,0],["أَرهبت أَفئدة العِدى وَحططت مِن","غُلواء كُل مشيّع مقدام",49,"م",1,0],["أرهِ جَوْهَرَ السّوالفِ بالأص","داغِ لمّا تنوسُ تلكَ الشّنوفُ",50,"ف",1,0],["أرهقني الحجى فلو أمكنني","بعت بكاس قرقف ألف حجى",51,"ج",2,0],["ارهب الله في الخنى فاصدُّ الن","فس عما يدعونه موبقات",52,"ت",1,0],["أرهفتموها فما كانت مواقعها","إلا مواقع بيض الهند في الهام",53,"م",1,0],["أرهفت عزمك لا الأرزاء تثلمه","ولا يماثله الصمصامة الذكر",54,"ر",1,0],["ارهقته بالتكاليف وما","رحمت شيخاً ولا استثنت غلاما",55,"م",2,0],["أرِهِ العُنفَ اذا استع","صى وطالبهُ بدينِ",56,"ن",1,0],["أَرهَقتَ رائَكَ فَوقَ رائك تَحتَها","فَحَططتَ مِن شعفاتها أَعفارها",57,"ر",3,0],["أرهقتني عواصفُ الموت روحاً","وجموحاً وصدّعت أركاني",58,"ن",2,0],["أَرهقهُ الغربُ بويلاته","واستنزف القيراط من ثروته",59,"ت",2,0],["أرهيفة الإحساس منك ورثتُه","رقراق نبضي وارتواء معيني",60,"ن",2,0],["أرهبنا لكنه لم يشأ","أن يوصل الرعب إلى الآخرِ",61,"ر",1,0],["أرهي على جمع زرع ٍ حصده بعيدي","ولا أتحسف على الفايت إليافاتي",62,"ت",2,0],["أَرْهَقتَنِي بالشِّعرِ تَحسَبُها","بالشِّعرِ _إن عاتَبْتَهَا_ تَقرَا",63,"ر",2,0],["إرهابُ أَجْهِزةٍ، أوغادُ أَنظِمةٍ","جَارتْ عَلى أمَلٍ نَحياه في طَرِبِ",64,"ب",1,0],["أرهقْتنا الأيامُ بسطاً وقبضاً","ورضينا منها بما ليس يرضى",65,"ض",2,1],["ارهقت قلبٍ : عروقه : جرد يبّاسي","ياشجرةٍ تحتضر / بيدين / غارسها",66,"س",3,0],["أَرْهَقَتْهَاْ شَهَوَاْتٌ عِدَّةٌ","وَرَمَتْهَاْ حِيْنَمَا الْحُبُّ رَمَاْهَاْ",67,"ا",3,0],["أرهَقْتنا أرَّقتنا الويلُ لكْ","قد رفَّعوك وحكَّموكَ على الرقاب",68,"ب",1,1],["( أرهقني منذ أن غادرت مربَعَنا )","رفقا ً بقلبى فما فى القلب محتملُ",69,"ل",1,0],["أرهقت أعصاب البلاد ومالها","ورجالها في الهدم لا التكوين",70,"ن",1,0],["أرهقتَ بعدَك من سادوا ومن حكموا","فالأصلُ أنتَ وهُم ياسيدي صورُ .",71,"ر",1,0],["أرهقتم الشعب ضرباً في مفاصله","حتى استفاق وسل السيف منتقما",72,"م",2,0],["أرة الدنيا قد أبتسمت بوجهي","إذا ما جفن عيني قد رأكا",73,"ك",2,0],["إرهابيٌ من قال لا وتمردا","والمنعِمون لرأيهم أذنابا",74,"ب",2,0],["أرهب عدوك ما استطعتَ فإنه","أصلٌ لإرهابٍ وذا معلومُ",75,"م",1,0],["أرهقتنا أدواؤنا وسئمنا العي","ش لكن لكل داء دواء",76,"ا",2,0],["أرهق اللطف أزورارا","ومن العطف توارى",77,"ر",2,0],["أرهَقتْهُم عُزومُهُ فاستثاروا","إنَّ هذا بزعمِهم إرهابُ",78,"ب",1,0],["ارهالك بحلوك ومرك وهمتى","وارهيتى لحسه خجل فى رواقه",79,"ق",2,0],["إرهابُهُم سَموهُ في أَسمائِنا","نَعتُوا به صقراً برأسِ غرابِ",80,"ب",1,0],["أرهقت غيرك بالصراع وأنت في","جو السماء تسود بالطيران",81,"ن",1,0],["إرهابيونَ وأصنامٌُ","وملوكٌ عنها لا تغفلْ",82,"ل",1,0],["أرهقت نفسك الهواجس حتى","كثرت في سباتك الأحلام",83,"م",1,0],["إرهاب أنتم لأن الضعف شيمتكم","صاروخهم سِلمٌ إرهابكم حجر",84,"ر",1,0],["أرهقت عزمي في طلب العلا","لو رغبوا في كاتب مفلس",85,"س",1,0],["أرهقتم الشعر بل سَمّمتم دمه","كُفّوا عن الشعر إنّ الشعر غلبانُ",86,"ن",1,1],["ارهقتني بمفارق القرب يازين","وعيشتني بالحزن عيشة مذله",87,"ل",2,0],["أرهقتُ ظلّي معي خوفًا ومقترفًا","إثْم المسافةِ - ذنْبًا - ليس يعذرني",88,"ن",2,0],["أَرْهَقْتُ عَيْنِي لَمْ أَجِدْ كُحْلاً لَهَا","قِيلَ انْظُرُوا حُسْنُ النَّبِيِّ أُنِيرَا",89,"ر",2,0],["ارهاب من شرعوا دينا يقتلنا","والله قد زعموا دينا وقد كفروا",90,"ر",3,0],["أرهقَ الحبُّ فؤادي","بحبيبٍ لا يلينْ",91,"ن",1,0],["أرهقتكم بالعطف مرات طَمَتْ","في العام ما لم يأتني من غيركا",92,"ك",2,0],["أرهقتَ عينيكَ من أجلي فكيف وقد","أرهقتَها لتغيث الناس من عللِ",93,"ل",1,0],["أرْهقتْ أيّامي سهادًا وضرًّا","أسْكرتْ آمالي بدرْبٍ عواء",94,"ا",2,0],["أَرهَقتَ روحي في غرامك فابْتَئِسْ","يامن أراني في هواه عُجابا",95,"ب",2,0],["أرهقَ الموجُ ألفَ ألف عشيق","نسيَتْهُم عيونُِك الشاطئيةْ",96,"ي",2,0],["أرهفته يداه وهو كميت","فتهادى يحري على علاته",97,"ت",2,0],["أرهقتني بين المقابر جلبه","فتأملتها وعيني مر به",98,"ب",2,1],["أَرهَقَتنِي بِجُودِها قافِياتِي !","كُلَّما جُدتُ زادَنِي النَّاسُ غِلَّا !",99,"ل",2,0],["أرهقتني ، بالأمنيات تَخُطُّها ‍","وفؤاديَ الظمآن خلفكَ يلهثُ",100,"ث",1,0],["أرهقتِ بازَ الشِّعْرِ في تحليقهِ","من حيثُ جاءكِ كان شِعْرُكِ أجودا!",101,"د",2,0],["أرهفتْ سيفين في أجفانها","كلَّ منْ غرا يبيتْ على غررْ",102,"ر",1,0],["أرهقت هذا القلب في حبه","وهو الذي يا طالما حن لك",103,"ك",1,0],["أرهقت روحًا بنفسي لو أهدهدها","وأدمعًا من نجيع القلب تعتصر",104,"ر",1,0],["أرهقتْني رحلةُ الحرف رواحاً وغُدُوَّا","وأراها لي صديقاً وأراها لي عَدُوَّا",105,"و",2,1]]}