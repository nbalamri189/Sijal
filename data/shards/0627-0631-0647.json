{"poems":[[55,"أجفوه أني أبقي عليه وفي القلب","https://www.aldiwan.net/poem26477.html","المنسرح"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[37,"أرهط أمرىء القيس اعبأوا حظواتكم","https://www.aldiwan.net/poem6985.html","الطويل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[102,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[48,"إن مت منك وقلبي فيه ما فيه","https://www.aldiwan.net/poem66188.html","البسيط"],[50,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[76,"ما لليلى تبدلت","https://www.aldiwan.net/poem38880.html","مجزوء الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85405","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[87,"رُدِّي التَّحِيَّة َ يَا مَهَاة َ الأَجْرَعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24027&r=&rc=289",""]],"verses":[["أَرهَبُ أَن يَظهَرَ الحَديثُ وَأن","تَسقُطَ في كَفِّ غَيرِهِ الكُتُبُ",0,"ب",1,0],["أرِهَا السَّوَابِحَ فِي الْمَجَازِ حَقِيقَةً","مِنْ كُلِّ قُعْدَةِ مِحْرَبٍ وَجَنِيبِ",1,"ب",1,0],["أرهط أمرىء القيس اعبأوا حظواتكم","لحي سوانا قبل قاصمة الظهرِ",2,"ر",1,1],["أرِهِ مكارمَكَ اللواتي لم تزل","منها يطول ضُغاؤُهُ وضُباحُه",3,"ح",2,0],["أرْهبْتَ فيه عُداة المُلك فانقلبوا","منه بأقلق أحشاءٍ وأكبادِ",4,"د",1,0],["أرهقتهم قدر البوار بقوة","وهبت لرأيك أوشك الإرهاق",5,"ق",1,0],["أَرهَفَت سَمعَ العَصا وَاِكتَحَلَت","إِثمِدَ الزَرقاءِ في عَرضِ السَدَر",6,"ر",1,0],["أَرهَفتهُ المَنون ثُمَ أَنامت","ه لِيَوم محجّل أَرونان",7,"ن",1,0],["أُرهِفنَ إِرهافَ الأَعِن","نَةِ وَالحَمائِلِ وَالسُيورِ",8,"ر",1,0],["أَرهَقتَني في هَوى مَن لَيسَ يُنصِفُني","وَلَيسَ يَنفَكُّ مِن زَهوٍ وَمِن تيهِ",9,"ي",2,0],["أَرهَبُ السَيفَ إِن وَرَدتُ عَلى الحَي","يِ وَأَطوي الهُمومَ وَالقَلبُ صادِ",10,"د",1,0],["أَرهَقَت هِندٌ حَياتي","ما لِهِندٍ مِن مَتابِ",11,"ب",1,0],["أرهَقَتْنا ملامةً","بعدَ إيضاحِ عُذْرِنا",12,"ن",2,0],["أرهب بطياراتها","تُلقي المنون وَتمطر",13,"ر",1,0],["أرهقوكم ذلاً وأَنتم سكوتٌ","أين أين الأحرار أين الأباة",14,"ه",1,0],["أَرْهَفْتَ حَدِّي فَهْوَ غَيْرُ مُفَلَّلٍ","وَرَعَيْتَ عَهْدِي فَهْوَم غَيْرُ مُضَيَّعِ",15,"ع",1,0],["أرهبَ الزئّار في تِس","عَةِ أَعوامٍ فَأَعوى",16,"و",2,0],["أرِها السَّوابح في المجاز حقيقة ً","من كلِّ قعدة ِ مجربٍ وجنيب",17,"ب",1,0],["أرِه لثورته عِظامَ جماجمٍ","وابعَثْ له زنداً أطنَّ وساعدا",18,"د",2,0],["أرهفتَ حَدِّى ، فَهوَ غيرُ مُفلَّلٍ","وَرَعَيْتَ عَهْدِي، فَهْوَ غَيْرُ مُضَيَّعِ",19,"ع",1,0]]}