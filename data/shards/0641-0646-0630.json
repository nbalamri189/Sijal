{"poems":[[93,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85327","المتقارب"],[275,"ليالي النوى حتام ترخين برقعا","https://www.aldiwan.net/poem35627.html","الطويل"],[411,"إذا ما اصطنعت امرأ فليكن","https://www.aldiwan.net/poem50078.html","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48968","المتقارب"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126515","الطويل"],[5302,"لقاء بعد غياب","https://www.poetsgate.com/ViewPoem.aspx?id=215673",""]],"verses":[["فَنَذَرتُ أَن أَقضي الحَياةَ بِها","وَقَصَدتُها كَيما أَفي نَذري",0,"ر",2,0],["فنذكر أَشياء لكننا","بما نحن نذكر لا نجزم",1,"م",1,0],["فنذكر منسيّاً وننضرُ ذابلاً","وننشرُ مطويّاً ونمطرُ مربعا",2,"ع",2,0],["فَنَذل الرِّجالِ كَنذلِ النَّباتِ","فلاَ للثِّمارِ ولا للِحَطَبْ",3,"ب",1,0],["فنذيره وافاك يدعوكي فلا","تستهزئي وعلى الرحيل فعولي",4,"ل",2,0],["فنذكر فيه هلالَ الصِّبا","وخيرُ المحبةِ ما يُذَّكَر",5,"ر",1,0],["فنذرا إذا جاد الزمان بعودتي","ونوديت بالترحيب من جانب القصر",6,"ر",1,0],["فنذكر الكل على الترتيب","بعون رب واحد قريب",7,"ب",1,0],["فنذكره فرحى لرفعة شأنه","وحسرى لهذا الكلم أصعب به كلما",8,"م",2,0],["فنذكر الأمس والساحات في فرح","ملأى بنا وفصول العلم والجمع",9,"ع",1,0]]}