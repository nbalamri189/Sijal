{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"ما ضر لو سلم أو ودعا","https://www.aldiwan.net/poem35995.html","السريع"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"عاجت أصيلاً بالرياض تطوفها","https://www.aldiwan.net/poem11120.html","الكامل"],[93,"ألعرق الذوقي أشهى الطلا","https://www.aldiwan.net/poem11352.html","السريع"],[93,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[41,"يا مرحبا ألفا وألفا","https://www.aldiwan.net/poem42252.html","مجزوء الكامل"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[47,"يا سيدي أراكما","https://www.aldiwan.net/poem25140.html","مجزوء الكامل"],[72,"أوجز مديحك فالمقام عظيم","https://www.aldiwan.net/poem19667.html","الكامل"],[72,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"وفي أربع مني خلت منك أربع","https://www.aldiwan.net/poem8667.html","الطويل"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[38,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[78,"أوجه البدر يشرق في الظلام","https://www.aldiwan.net/poem14061.html","الوافر"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[62,"وكأن آذريون روضتنا","https://www.aldiwan.net/poem52499.html","أحذ الكامل"],[45,"لا أرى بالعقيق رسما يجيب","https://www.aldiwan.net/poem62639.html","الخفيف"],[45,"لا تلحني إن عزني الصبر","https://www.aldiwan.net/poem63599.html","البسيط"],[45,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[45,"قالت الشيب بدا قلت أجل","https://www.aldiwan.net/poem65571.html","الطويل"],[61,"ذممت زرعك خوفا من مطالبتي","https://www.aldiwan.net/poem51451.html","البسيط"],[61,"هذه الشمس أوشكت أن تغيبا","https://www.aldiwan.net/poem51805.html","الخفيف"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[74,"أوجهك بسام وطرفي باكي","https://www.aldiwan.net/poem13204.html","الطويل"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[40,"أوجع القلب قولها حين راحوا","https://www.aldiwan.net/poem42281.html","الخفيف"],[52,"وزائر زارني ثقيل","https://www.aldiwan.net/poem27006.html","مجزوء البسيط"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"رب غزال كأنه قمر","https://www.aldiwan.net/poem62561.html","المنسرح"],[48,"قولا لهارون إمام الهدى","https://www.aldiwan.net/poem62600.html","السريع"],[46,"أوجز الدهر في المقال إلى أن","https://www.aldiwan.net/poem22772.html","الخفيف"],[46,"يا خاطري لا توجه وجه سيئة","https://www.aldiwan.net/poem23220.html","البسيط"],[15,"يا دار هند عفاها كل هطال","https://www.aldiwan.net/poem45254.html","البسيط"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[76,"يا وجه معتذر ومقلة ظالم","https://www.aldiwan.net/poem38982.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/204571","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55174","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142001","الرمل"],[95,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=721",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[98,"مدد الله مدد","https://www.poetsgate.com/ViewPoem.aspx?id=55304",""],[80,"أعليتَ بين النجم والدّبرانِ","https://www.poetsgate.com/ViewPoem.aspx?id=3771",""],[51,"نِعال كِنْباية َ والعنبرُ","https://www.poetsgate.com/ViewPoem.aspx?id=29059",""]],"verses":[["أَوجَرَهُ رُمحُ ذُؤابٍ طَعنَةً","تَلغَطُ لَغطَ الأَعجَميَّ لَم يُبِن",0,"ن",1,0],["أَوجُهٌ صانَها الجَلالُ فَأَمسَي","نَ تُراباً تَحتَ الجَنادِلِ غُبرا",1,"ر",2,0],["أو جاسَ خِلالَ منازِلها","قذَفَتْهُ سُعودُكَ فاحْتَرَقا",2,"ق",2,0],["أوْ جِئْتَهُم في الجَدْبِ تبْغي النّدى","سحّوا عليْكَ السُّحْبَ الهُمَّعا",3,"ع",2,0],["أَوْ جَارِ في أَمْنٍ خَشَاشَ","الأَرْضِ تَنْسَحِبُ انْسِحَابَا",4,"ب",2,0],["أَوْ جَاوَرَتْ فَرْعاً رَطِيباً لَيِّناً","أَلوَى بِمِعْطَفِهِ وَمَالَ لِضَمِّهَا",5,"م",3,0],["أَوْجَبْتَ إِكْرَامِي فَيَا لَيْتَ مَا","أَقُولُهُ يَكْفِيكَ إِكْرَاما",6,"م",2,0],["أَوْ جِهْبِذٍ مُتَثَبِّتٍ مُسْتَعْصِمٍ","بِالحَقِّ لا يَلْوِي بِلَوْمَةِ لائِمِ",7,"م",1,0],["أَوجَعنَ كُلَّ مُغَازِلٍ","وَعَصَفنَ بِالغَيرَانِ عَصفَا",8,"ف",2,0],["أوجْهُك أمْ شمس النهار تطلعت","وكَفَّكَ أمْ سُحْبَ الحَيَا نَتَوَكَّفُ",9,"ف",1,0],["أوجدت للشعر دولة عظمت","به فعزت من غيره دوله",10,"ل",2,0],["أوجرتني من فنون العلم أدوية","شفت من الجهل داءً كان قتّالا",11,"ل",2,0],["أَوجَدتُما بَدَلاً بِهِ","يَبني سَماءَ عُلاكُما",12,"م",2,0],["أَوجَدتُما بَدَلاً بِهِ","يَفري نُحورَ عِداكُما",12,"م",2,0],["أوجز مديحك فالمقام عظيم","من دونه المنثور والمنظوم",13,"م",1,1],["أوجهك أم جنَّة عاليَة","قطوف لرائيها دانيه",14,"ي",2,1],["أوجهٌ لا تزال تُرمَى ولا تَدْ","مَى على كثرةِ السّهام الصِّيابِ",15,"ب",1,0],["أوجهُك في عيني أم الريقُ في فمي","أم النطقُ في سَمعي أم الحب في قلبي",16,"ي",1,0],["أو جاءنا المسك جَزينا به","ما يصبح المسك به يُهجَر",17,"ر",1,0],["أو جاءنا من عندكم مَركبٌ","أحمر كالشعلة أو أشقر",17,"ر",1,0],["أَو جَدوَلاً مُتَرَقرِقاً مُتَرَنِّماً","أَنا فيهِ مَوجٌ ضاحِك وَخَريرُ",18,"ر",1,0],["أَوجَسَ بِالأُذنِ رِزّاً مِن سَوابِقِها","فَجالَ أَزهَرُ مَذعورٌ مِنَ الخَمَرِ",19,"ر",1,0],["أَوجَهَ البَدرِ يُشرِقُ في الظَلامِ","وَسِتر اللَه مُدَّ عَلى الأَنام",20,"م",1,1],["أوجاع ما تبدي العيون شديدة","وأشد منها ما تجُنُّ الأضلع",21,"ع",1,0],["أو جيء بالشرشر له فاملأوا","مكانها من علقم جردله",22,"ل",2,0],["أو جامُ جَزعٍ حولَه سَبَجٌ","أو سورُ مِسْكٍ جامُهُ ذَهَبُ",23,"ب",1,0],["أَو جَرى في الَّذي تَضَمَّنتَ نُجحٌ","فَهُوَ ظَنّي بِكَ الَّذي لا يَخيبُ",24,"ب",1,0],["أَوَجهُهُ الواضِحُ أَم حِلمُهُ ال","راجِحُ أَم نائِلُهُ الغَمرُ",25,"ر",1,0],["أَوجَدَتنيهِ هِمَّةٌ خَرَقَت بي","كُلَّ خَرقٍ مِن البِلادِ مَخوفِ",26,"ف",1,0],["أَوجَلَتني بَعدَ أَمنٍ غِرَّتي","وَاِغتِرارُ الأَمنِ يَستَدعي الوَجَل",27,"ل",1,0],["أو جَحْفَلٌ مِنْ جُنودِ اللهِ مُنْتَشِرٌ","مِثلُ الخَناصِرِ مَنقوشُ الحيازيمِ",28,"م",1,0],["أو جُذوةٌ كَشِهابِ الجَوِّ مُشعَلَةٌ","تَطيرُ في مُعتَلٍ منه ومَركومِ",28,"م",1,0],["أوجَبَتْ لوعةُ الفِراقِ على الصَّبْ","بِ جَوىً يَقرَحُ الفؤادَ وَجيبا",29,"ب",2,0],["أو جحفلٌ لعبَتْ صدورُ رِماحِه","فكأنما انقضَّتْ نجومُ سَمائِه",30,"ا",3,0],["أوْجَبْتَ للمنصور سابقةَ العُلى","وعَدلْتَ عن كسرَى أنوشروانِ",31,"ن",1,0],["أو جعلتَ الحِمامَ قِرْنَكَ في الحر","ب لجرّعْتَهُ مذاقَ الحِمامِ",32,"م",1,0],["أوجَفْتَ طِرْفَكَ والإِيجافُ عادتُهُ","والصُّبحُ مُحتَجِبٌ واللَّيلُ مُعتَكِرُ",33,"ر",1,0],["أَو جُبَّ مِنّا غارِبٌ غَدواً فَقَد","رُحنا بِأَتمَكِ ذِروَةٍ وَسَنامِ",34,"م",1,0],["أَوَجهُكَ بَسّامٌ وَطَرفِيَ باكي","وَعَدلُكَ مَوجودٌ وَمِثلِيَ شاكي",35,"ي",1,1],["أوجعتها من عليٍّ شِدَّةٌ","هي من دأبِ الأُباةِ الأوّلينْ",36,"ن",1,0],["أَوجَعَ القَلبَ قَولُها حِينَ راحُوا","لي تَقَدَّم إِلى المَبيتِ هُدِيتا",37,"ت",2,1],["أَوجَعَ لِلقَلبِ مِن غَريمٍ","ظَلَّ مُلِحّاً عَلى فَقيرِ",38,"ر",1,0],["أُوجِعُ زَيْداً ضَرْباً وَأُشْبِعُهُ","سَبّاً كَأني مُرَقِّصُ الدُّبَّهْ",39,"ب",2,0],["أَو جَلَّ مَنْ جَعَلَ اليَهُودُ بِزَعمِكُمْ","شَوْكَ القَتادِ لِرَأْسِهِ إكلِيلا",40,"ل",2,0],["أَوجَرتُهُ القَرقَفَ العُقارَ فَما اِن","تَهَيتُ حَتّى اِتَّكى عَلى العَضُدِ",41,"د",1,0],["أَوجَدَهُ اللَهُ فَما مِثلُهُ","لِطالِبٍ ذاكَ وَلا ناشِدِ",42,"د",1,0],["أوجَزَ الدَهرُ في المَقالِ إِلى أَن","جَعَلَ الصَمتَ غايَةَ الإيجازِ",43,"ز",1,1],["أَوجالُ نَفسِيَ في الأولى مَضاعَفَةٌ","وَلا أَزالُ مِنَ الأُخرى عَلى وَجَلِ",44,"ل",1,0],["أَوجَرتُ جُفرَتَهُ خُرصاً فَمالَ بِهِ","كَما اِنثَنى مُخضَدٌ مِن ناعِمِ الضالِ",45,"ل",1,0],["أَوجَرتُهُ وَنَواصي الخَيلِ شاحِبَةٌ","سَمراءَ عامِلُها مِن خَلفِهِ بادي",46,"ي",1,0],["أَو جَدوَلٌ في ظِلالِ نَخلٍ","لِلماءِ مِن تَحتِهِ قَسيبُ",47,"ب",1,0],["أوَجدْتِ وَصْلي في الكتاب مُحرَّماً","ووجدْتِ قَتْلي فيهِ غيرَ مُحرَّمِ",48,"م",1,0],["أَوجست خيفة تغير منها","وَجهها فاِكتَسى البياض اصفرارا",49,"ر",2,0],["أَو جاءَني خير فَلا","أَغترّ منه وأَبطر",50,"ر",1,0],["أوجب الواجبات إكرام أمي","إن أمي أحق بالإكرام",51,"م",1,1],["أوجُهٌ مثلما رَنتْ","زهرةُ الصيف للمطَرْ",52,"ر",1,0],["أَوجَزتُ فِي وَصْفِي وَتحْتَ أَقلِّهِ","بَثٌ إِلَى حَدِّ الأَسَى متَمَادِي",53,"د",2,0],["أَوْجُ العَنَانِ بُرْجُهُ","وَنُورُهُ فِي المُقَلِ",54,"ل",1,0],["أَوْجَبَ الرِّزْقُ فَانْتَأْى حَافِظٌ يَكْ","دَحُ فِي بِيْئَةٍ مِنَ الأجْنَادِ",55,"د",1,0],["أَوْجُ المَعَالِي أَقْسَمَ أَنْ تَكُنْ","بَدْءاً مُنِحْتَ الرُّتْبَةَ الأُولَى",56,"ل",2,0],["أَوْجَزْتَ حِينَ بَلَغْتَ ذِكْرَى غِبِّهِمْ","إِيجَازَ لاَ عِيٍّ وَلاَ إِعْيَاءِ",57,"ا",2,0],["أو جناحي طائرٍ روّعَه","شرك الصياد يوما فشرد",58,"د",1,0],["أوجوم فيم الوجوم منى النفس","وفيم الذهول يكسو المحيا",59,"ي",2,0],["أوْ جَدولٌ في ظِلالِ نَخْلٍ","لِلماءِ مِنْ تَحتِها سَكوبُ",60,"ب",1,0],["أو جناحي طائرٍ روعه","شرك صياد يوما فشرد",61,"د",1,0],["أوْجَبَبْتَ للمنصور سابقة َ العُلَى","وعَدَلْتَ عن كسرَى أنوشروان",62,"ن",1,0],["أو جائنا المسك جَزينا به","ما يصبح المسك به يُهجَر",63,"ر",1,0],["أو جائنا من عندكم مَركبٌ","أحمر كالشعلة أو أشقر",63,"ر",1,0]]}