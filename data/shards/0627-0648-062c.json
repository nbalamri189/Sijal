www.aldiwan.net/poem57326.html","المتقارب"],[369,"ما لطويل الكمد","https://www.aldiwan.net/poem57492.html","مجزوء الرجز"],[369,"والدهر ليس بمستجيز","https://www.aldiwan.net/poem57513.html","مجزوء الكامل"],[377,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[377,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[388,"يا علي ماتوا اللي مانباهم يموتون","https://www.aldiwan.net/poem54469.html","عموديه"],[397,"سيل أشواقي","https://www.aldiwan.net/poem6717.html","عموديه"],[400,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[400,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[400,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[403,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[413,"إن النقيب عليا طاب عنصره","https://www.aldiwan.net/poem53879.html","البسيط"],[413,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[413,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[426,"باح الفؤاد بسر كنت أخفيه","https://www.aldiwan.net/poem41067.html","البسيط"],[426,"خطرت تفتر عن الجوهر","https://www.aldiwan.net/poem41404.html","المتدارك"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[450,"عهدي بأيامي على النيربين","https://www.aldiwan.net/poem13897.html","السريع"],[456,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[456,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[459,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[459,"نحن قوم من تميم بن مر","https://www.aldiwan.net/poem16100.html","المديد"],[462,"أوجداً وذياك الحمى ومنازله","https://www.aldiwan.net/poem3610.html","عموديه"],[477,"كل يؤمل أن يكون سعيدا","https://www.aldiwan.net/poem37600.html","الكامل"],[477,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[493,"كذا من شام بارقة العذاب","https://www.aldiwan.net/poem9765.html","الوافر"],[513,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[527,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[549,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[549,"من رأى لي في الدجى ذا خطل","https://www.aldiwan.net/poem47224.html","الرمل"],[549,"إن كان طيفك زارنا","https://www.aldiwan.net/poem47309.html","مجزوء الكامل"],[549,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[556,"ليس الوجود كما يقال اثنان","https://www.aldiwan.net/poem33757.html","الكامل"],[565,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"]],"verses":[["أَوجَرَهُ رُمحُ ذُؤابٍ طَعنَةً","تَلغَطُ لَغطَ الأَعجَميَّ لَم يُبِن",0,"ن",1,0],["أَوجُهٌ صانَها الجَلالُ فَأَمسَي","نَ تُراباً تَحتَ الجَنادِلِ غُبرا",1,"ر",2,0],["أو جاسَ خِلالَ منازِلها","قذَفَتْهُ سُعودُكَ فاحْتَرَقا",2,"ق",2,0],["أوْ جِئْتَهُم في الجَدْبِ تبْغي النّدى","سحّوا عليْكَ السُّحْبَ الهُمَّعا",3,"ع",2,0],["أَوْ جَارِ في أَمْنٍ خَشَاشَ","الأَرْضِ تَنْسَحِبُ انْسِحَابَا",4,"ب",2,0],["أَوْ جَاوَرَتْ فَرْعاً رَطِيباً لَيِّناً","أَلوَى بِمِعْطَفِهِ وَمَالَ لِضَمِّهَا",5,"م",3,0],["أَوْجَبْتَ إِكْرَامِي فَيَا لَيْتَ مَا","أَقُولُهُ يَكْفِيكَ إِكْرَاما",6,"م",2,0],["أَوْ جِهْبِذٍ مُتَثَبِّتٍ مُسْتَعْصِمٍ","بِالحَقِّ لا يَلْوِي بِلَوْمَةِ لائِمِ",7,"م",1,0],["أَوجَعنَ كُلَّ مُغَازِلٍ","وَعَصَفنَ بِالغَيرَانِ عَصفَا",8,"ف",2,0],["أوجْهُك أمْ شمس النهار تطلعت","وكَفَّكَ أمْ سُحْبَ الحَيَا نَتَوَكَّفُ",9,"ف",1,0],["أوجدت للشعر دولة عظمت","به فعزت من غيره دوله",10,"ل",2,0],["أوجرتني من فنون العلم أدوية","شفت من الجهل داءً كان قتّالا",11,"ل",2,0],["أَوجَدتُما بَدَلاً بِهِ","يَبني سَماءَ عُلاكُما",12,"م",2,0],["أَوجَدتُما بَدَلاً بِهِ","يَفري نُحورَ عِداكُما",12,"م",2,0],["أوجز مديحك فالمقام عظيم","من دونه المنثور والمنظوم",13,"م",1,1],["أوجهك أم جنَّة عاليَة","قطوف لرائيها دانيه",14,"ي",2,1],["أوجهٌ لا تزال تُرمَى ولا تَدْ","مَى على كثرةِ السّهام الصِّيابِ",15,"ب",1,0],["أوجهُك في عيني أم الريقُ في فمي","أم النطقُ في سَمعي أم الحب في قلبي",16,"ي",1,0],["أو جاءنا المسك جَزينا به","ما يصبح المسك به يُهجَر",17,"ر",1,0],["أو جاءنا من عندكم مَركبٌ","أحمر كالشعلة أو أشقر",17,"ر",1,0],["أَو جَدوَلاً مُتَرَقرِقاً مُتَرَنِّماً","أَنا فيهِ مَوجٌ ضاحِك وَخَريرُ",18,"ر",1,0],["أَوجَسَ بِالأُذنِ رِزّاً مِن سَوابِقِها","فَجالَ أَزهَرُ مَذعورٌ مِنَ الخَمَرِ",19,"ر",1,0],["أَوجَهَ البَدرِ يُشرِقُ في الظَلامِ","وَسِتر اللَه مُدَّ عَلى الأَنام",20,"م",1,1],["أوجاع ما تبدي العيون شديدة","وأشد منها ما تجُنُّ الأضلع",21,"ع",1,0],["أو جيء بالشرشر له فاملأوا","مكانها من علقم جردله",22,"ل",2,0],["أو جامُ جَزعٍ حولَه سَبَجٌ","أو سورُ مِسْكٍ جامُهُ ذَهَبُ",23,"ب",1,0],["أَو جَرى في الَّذي تَضَمَّنتَ نُجحٌ","فَهُوَ ظَنّي بِكَ الَّذي لا يَخيبُ",24,"ب",1,0],["أَوَجهُهُ الواضِحُ أَم حِلمُهُ ال","راجِحُ أَم نائِلُهُ الغَمرُ",25,"ر",1,0],["أَوجَدَتنيهِ هِمَّةٌ خَرَقَت بي","كُلَّ خَرقٍ مِن البِلادِ مَخوفِ",26,"ف",1,0],["أَوجَلَتني بَعدَ أَمنٍ غِرَّتي","وَاِغتِرارُ الأَمنِ يَستَدعي الوَجَل",27,"ل",1,0],["أو جَحْفَلٌ مِنْ جُنودِ اللهِ مُنْتَشِرٌ","مِثلُ الخَناصِرِ مَنقوشُ الحيازيمِ",28,"م",1,0],["أو جُذوةٌ كَشِهابِ الجَوِّ مُشعَلَةٌ","تَطيرُ في مُعتَلٍ منه ومَركومِ",28,"م",1,0],["أوجَبَتْ لوعةُ الفِراقِ على الصَّبْ","بِ جَوىً يَقرَحُ الفؤادَ وَجيبا",29,"ب",2,0],["أو جحفلٌ لعبَتْ صدورُ رِماحِه","فكأنما انقضَّتْ نجومُ سَمائِه",30,"ا",3,0],["أوْجَبْتَ للمنصور سابقةَ العُلى","وعَدلْتَ عن كسرَى أنوشروانِ",31,"ن",1,0],["أو جعلتَ الحِمامَ قِرْنَكَ في الحر","ب لجرّعْتَهُ مذاقَ الحِمامِ",32,"م",1,0],["أوجَفْتَ طِرْفَكَ والإِيجافُ عادتُهُ","والصُّبحُ مُحتَجِبٌ واللَّيلُ مُعتَكِرُ",33,"ر",1,0],["أَو جُبَّ مِنّا غارِبٌ غَدواً فَقَد","رُحنا بِأَتمَكِ ذِروَةٍ وَسَنامِ",34,"م",1,0],["أَوَجهُكَ بَسّامٌ وَطَرفِيَ باكي","وَعَدلُكَ مَوجودٌ وَمِثلِيَ شاكي",35,"ي",1,1],["أوجعتها من عليٍّ شِدَّةٌ","هي من دأبِ الأُباةِ الأوّلينْ",36,"ن",1,0],["أَوجَعَ القَلبَ قَولُها حِينَ راحُوا","لي تَقَدَّم إِلى المَبيتِ هُدِيتا",37,"ت",2,1],["أَوجَعَ لِلقَلبِ مِن غَريمٍ","ظَلَّ مُلِحّاً عَلى فَقيرِ",38,"ر",1,0],["أُوجِعُ زَيْداً ضَرْباً وَأُشْبِعُهُ","سَبّاً كَأني مُرَقِّصُ الدُّبَّهْ",39,"ب",2,0],["أَو جَلَّ مَنْ جَعَلَ اليَهُودُ بِزَعمِكُمْ","شَوْكَ القَتادِ لِرَأْسِهِ إكلِيلا",40,"ل",2,0],["أَوجَرتُهُ القَرقَفَ العُقارَ فَما اِن","تَهَيتُ حَتّى اِتَّكى عَلى العَضُدِ",41,"د",1,0],["أَوجَدَهُ اللَهُ فَما مِثلُهُ","لِطالِبٍ ذاكَ وَلا ناشِدِ",42,"د",1,0],["أوجَزَ الدَهرُ في المَقالِ إِلى أَن","جَعَلَ الصَمتَ غايَةَ الإيجازِ",43,"ز",1,1],["أَوجالُ نَفسِيَ في الأولى مَضاعَفَةٌ","وَلا أَزالُ مِنَ الأُخرى عَلى وَجَلِ",44,"ل",1,0],["أَوجَرتُ جُفرَتَهُ خُرصاً فَمالَ بِهِ","كَما اِنثَنى مُخضَدٌ مِن ناعِمِ الضالِ",45,"ل",1,0],["أَوجَرتُهُ وَنَواصي الخَيلِ شاحِبَةٌ","سَمراءَ عامِلُها مِن خَلفِهِ بادي",46,"ي",1,0],["أَو جَدوَلٌ في ظِلالِ نَخلٍ","لِلماءِ مِن تَحتِهِ قَسيبُ",47,"ب",1,0],["أوَجدْتِ وَصْلي في الكتاب مُحرَّماً","ووجدْتِ قَتْلي فيهِ غيرَ مُحرَّمِ",48,"م",1,0],["أَوجست خيفة تغير منها","وَجهها فاِكتَسى البياض اصفرارا",49,"ر",2,0],["أَو جاءَني خير فَلا","أَغترّ منه وأَبطر",50,"ر",1,0],["أوجب الواجبات إكرام أمي","إن أمي أحق بالإكرام",51,"م",1,1],["أوجُهٌ مثلما رَنتْ","زهرةُ الصيف للمطَرْ",52,"ر",1,0],["أَوجَزتُ فِي وَصْفِي وَتحْتَ أَقلِّهِ","بَثٌ إِلَى حَدِّ الأَسَى متَمَادِي",53,"د",2,0],["أَوْجُ العَنَانِ بُرْجُهُ","وَنُورُهُ فِي المُقَلِ",54,"ل",1,0],["أَوْجَبَ الرِّزْقُ فَانْتَأْى حَافِظٌ يَكْ","دَحُ فِي بِيْئَةٍ مِنَ الأجْنَادِ",55,"د",1,0],["أَوْجُ المَعَالِي أَقْسَمَ أَنْ تَكُنْ","بَدْءاً مُنِحْتَ الرُّتْبَةَ الأُولَى",56,"ل",2,0],["أَوْجَزْتَ حِينَ بَلَغْتَ ذِكْرَى غِبِّهِمْ","إِيجَازَ لاَ عِيٍّ وَلاَ إِعْيَاءِ",57,"ا",2,0],["أو جناحي طائرٍ روّعَه","شرك الصياد يوما فشرد",58,"د",1,0],["أوجوم فيم الوجوم منى النفس","وفيم الذهول يكسو المحيا",59,"ي",2,0],["أوْ جَدولٌ في ظِلالِ نَخْلٍ","لِلماءِ مِنْ تَحتِها سَكوبُ",60,"ب",1,0],["أو جناحي طائرٍ روعه","شرك صياد يوما فشرد",61,"د",1,0],["أوْجَبَبْتَ للمنصور سابقة َ العُلَى","وعَدَلْتَ عن كسرَى أنوشروان",62,"ن",1,0],["أو جائنا المسك جَزينا به","ما يصبح المسك به يُهجَر",63,"ر",1,0],["أو جائنا من عندكم مَركبٌ","أحمر كالشعلة أو أشقر",63,"ر",1,0],["أَو جاءَهُ ذو المُعضِلا","ت بِمغلق إِلّا فَتح",64,"ح",1,0],["أو جاء مُستَرِقَا إليكُم مارد","إلا وأحرَقَهُ هُناكَ شِهابُ",65,"ب",1,0],["أو جفةٌ قد زُخرفتْ","حُسناً لمحمودِ المساعِى",66,"ع",2,0],["أو جُمُانٌ فَالدَّمعُ يَجرِى كَمَا يَر","فَضُّ ِإذَا خَانَهُ النِّظَامُ الجُمَانُ",67,"ن",1,0],["أوجدَ اللَه منكَ للدينِ عِزَّاً","ومعيناً وناصِراً وظهيرا",68,"ر",2,0],["أَو جانَبَ النَومُ العُيونُ إِذِ اِشتَكى","فَسُطى أَبيهِ قَضَت لَها أَن تَهجَعا",69,"ع",2,0],["أو جلتَ في روضةٍ قد راق منظرها","بكل لونٍ جميل شيّق عطر",70,"ر",1,0],["أوْجَبَ الْبَيْنَ أُناسٌ","عَلَّمُوا قَلْبِي الْوَجِيبا",71,"ب",2,0],["أو جمرةِ الوَجَنات لا","ح شَقيقُها في آسِ شَعر",72,"ر",1,0],["أو جارح يُدرِكها بَغْتةً","في الجو لا يضرِب إلا كَسَر",73,"ر",1,0],["أوجهُك أم قِبْلة فالغصو","نُ من ساجداتٍ ومن رُكَّع",74,"ع",1,1],["أَو جاذِباً وَتَدتُهُ الفِهرَ صاحِبُهُ","مِنَ الَّذي كانَ مَعقوداً بِهِ جِذَمُ",75,"م",1,0],["أو جعله من باب بين بين ما","لم يأت في كلامهم مقدما",76,"م",2,0],["أوجهٌ مِثلَما نَثَرتَ على الأَج","داثِ ورداً إن هنَّ أَبدَين بِشرا",77,"ر",2,0],["أو جعلتم نِداء عبّاس في الحر","ب وقد فُرَّ عن لقاء الشِفَار",78,"ر",1,0],["أوجهك أم ضوء الصباح تبلجا","أم البدر في برج الكمال جلا الدجى",79,"ج",2,1],["أَوْ جَدَّهُ الْمَوْلَى أَبَا","حَسَنٍ يُدَمِّرُ مَنْ تَمَرَّدْ",80,"د",1,0],["أَوْ جَدَّهُ النَّفْسَ الزَّكِ","يَّةَمِنْ سَنَا الْمَنْصُورِ أَخْمَدْ",80,"د",1,0],["أَوْ جَنَّةُ الدَّجَّالِ تُبْصِرُهَا","تَنْدَى وَفِي أَحْشَائِهَا الْجَمْرُ",81,"ر",1,0],["أَوْجَزْتُ فِي قَصْدِ الدُّعَاءِ لَكُمْ","إِذَا كُنْتَ أَهْلاً لِلْكَلاَمِ الْوَجِيزْ",82,"ز",1,0],["أَوَجدي كَذا أَم هَكَذا كُلُّ مَن يَهوى","يَزيدُ غَراماً واِشتياقاً عَلى البَلوى",83,"و",2,1],["أوجع دماغاً القرع بالسلقِِ","اليوم يوم القطع والبلقِ",84,"ق",1,1],["أو جئتُ أجعلهُ شغلاً أهيمُ بهِ","لم يبقَ حبرٌ وأقلامُ وكتَّاب",85,"ب",1,0],["أوْجَبَت رَعْيَ الهَوَى فَقَفَتْ","رَأيَ تَخويفي بِتَخْويلِي",86,"ل",2,0],["أَوُجوهٌ واجَهنَنا أَم شُموسٌ","في غُصونٍ بَينَ اِعتِدالٍ وَلينِ",87,"ن",1,0],["أَوجبَ البينُ له فَرطَ الأَسى","بجفاكم يا تُرى ما أَوجبَه",88,"ب",2,0],["أوجعنَ لي قلبي وهجن مدامعي","وتركن جفني للفجيعةِ ساهدا",89,"د",2,0],["أو جحيم شأى الجحيم عذابا","من جحود وحرقة وشتات",90,"ت",1,0],["أَوجَبَتْ وَحْشَةُ الذُّنوبِ أنفِباضِي","عَن سُؤَالي لكِنَّ رَبّي كَرِيمُ",91,"م",1,1],["أَوجد فينا الودّ ربّ السَما","فَالحمد لِلّه الكَريم الوَدود",92,"د",1,0],["أَوجَزت في مَدحي مَناقبك الَّتي","بِالفَضل تَستَغني عَن الإِسهابِ",93,"ب",1,0],["أوجزتُ في شكرى وحالك مطنبٌ","وذكرت شعرا راق عند ذوي الحجا",94,"ج",2,0],["أَو جِئتُما سحرا ذاكَ الحمى فقِفا","وَسلما لي عَلى رُبع غلا وَعلا",95,"ل",2,0],["أَو جدى الجَمال وَالحال وَالقا","ل عَريق الاصول مجدا وَفَخرا",96,"ر",2,0],["أَوجستُ من جَمرٍ بخَدِّكِ ساطعٍ","خوفاً على بَرَدٍ بثَغرِك ناصعِ",97,"ع",1,1],["أَوَجهَ العُلا أَسفِرْ فَقَد أَقبَلَ البَدرُ","وَكَفَّ النَدى أَمطِر فَقَد بَخِلَ القَطرُ",98,"ر",1,1],["أوجدٌ عليهم ولا سَلوَةٌ","ولَومٌ عَليكَ ولا مسمَعُ",99,"ع",1,0],["أوجهُ جودٍ ماؤها","كالمتَصدي للصَّدي",100,"ي",1,0],["أوجبتُ من ضجرٍ إلى","نكباته روحي بروحي",101,"ي",1,0],["أَوجُهاً تَقطر البَشاشة مِنها","في خِلال الحَديث وَالإِبتِسام",102,"م",1,0],["أَوجمتني الهُموم بَل أَسكتَتني","فَبنطقي عَن البَيان قصورُ",103,"ر",1,0],["أو جلس عندهم جلسه وللذكر يتلون","ذاك يغفر له معهم كذا جاء يروون",104,"ن",1,0],["أوجِّهُ للمولى جميعَ حوائِجي","فما ألطف المولى الكريمَ وما أحْنى",105,"ن",2,0],["أو جاءكم رجل يريد سماعه","لكلام خالقه ونعم القاصد",106,"د",1,0],["أوجب واسلب أيُّمَا صفة","أنا أنت في الإِيجاب والسلب",107,"ب",1,0],["أوجدتهم فضلاً وجُدْتَ عليهمُ","وأنلتهم ما شئت مما شاءوا",108,"ا",1,0],["أَوجرته نَجلاء تَنضح بِالدما","نَضحاً كَجَيب الثاكِلِ المَرِنانِ",109,"ن",1,0],["أو جاءَ مسترشداً يبغي النجاة به","إلاَّ هداه إلى التقوى وأرشده",110,"د",2,0],["أوجب الشكر علينا فضله","فمن الواجد عندي أن يؤدى",111,"د",2,0],["أوجبت مدحكم عليَّ أيادٍ","في زمان من حقّه أنْ يُذمّا",112,"م",2,0],["أو جئت يا صاحبي نحو الديار فجز","حمي العبيد وعطفا عن شماليه",113,"ي",2,0],["أو جاد ببذل تحسب ان","براحته مزنٌ يحدر",114,"ر",1,0],["أَوْجَفْتُ خَيْلِي فِي الهوى ورِكابي","وَقَذَفْتُ نَبْلي بالصِّبا وحِرَابي",115,"ي",1,1],["أو جمعتنا في المنام الحلوم","وما على العاشق أن لا ينام",116,"م",1,0],["أوجعُ من ضمٍّ على جمر الغضا","في حسِّه كفٌّ تضمُّ دِرهما",117,"م",2,0],["أو جَدَّ في خطبٍ كفاه ووجهُه","متبسِّمٌ فيقول حاسدهُ مَزَحْ",118,"ح",1,0],["أوجبْتُ حقاً في أبٍ لم يَقْضهِ","وجزاءهُ أرجو من الأبْناءِ",119,"ا",2,0],["أوْجُهٌ غُرٌّ وأيْدٍ بِساطٌ","وندىً غَمْرٌ ومُلْفىَ وظِلُّ",120,"ل",1,0],["أوجداً وذيّاكَ الحمى ومنازلهْ","لك الله قلباً ما تقرُّ بلابلهْ",121,"ل",2,1],["أوجد لنفسك في البرية قيمة","أولا فإنك لم تكن معدودا",122,"د",2,0],["أوجد اليوم في النفوس شعورا","كيفما كان حبذاك الشعور",123,"ر",1,0],["أوجداً سرْع هذا واكتئابا","حلفت لتوكلَن بغير نابِ",124,"ب",1,0],["أوجبت في ذمة الأشعار والخطب","ديناً أبا حسن يبقى على الحقب",125,"ب",1,1],["أُوَجِّهُهُ شَرْقاً فَيَقْصِدُ مَغْرِباً","وإنْ رُمْتُ إصْعَاداً جَرَى بِوِهادِ",126,"د",1,0],["أو جَسَدٌ مُرَدَّدٌ","بَين العوافي والسَّقَمْ",127,"م",1,0],["أَو جَباناً هابَ من إقدامِه","أو لساناً عن مقالٍ جَمْجَما",128,"م",2,0],["أوجدتموه إلى الأما","ني في لقائكمُ السَّبيلا",129,"ل",2,0],["أو جَلالَ جَلَنْفَعٍ صَحِبَ الأي","يامَ حتّى أَعَدْنَه اليومَ نِقْضا",130,"ض",2,0],["أو جاء من عدم وليس يجيء من","عدم وجود إذ هما ضدان",131,"ن",1,0],["أَوْ جَرَى لاَنْبَجَسَتْ مِنْ","هُ اثْنَتَا عَشْرَةَ عَيْنَا",132,"ن",2,0]]}