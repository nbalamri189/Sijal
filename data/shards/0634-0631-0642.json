poem/62863","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62949","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102427","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129494","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95375","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35574","الوافر"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101157","الكامل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106735","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90799","الكامل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29456","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136595",""],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139112","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141685","الكامل"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113004","الكامل"],[4759,"متى سألت مكاني","https://www.poetsgate.com/ViewPoem.aspx?id=204207",""],[669,"لعمرك ما من مسجد بعد مسجد","https://www.poetsgate.com/ViewPoem.aspx?id=18401",""],[5225,"طال الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=36892",""],[5277,"بغداد بين الأمس واليوم","https://www.poetsgate.com/ViewPoem.aspx?id=185168",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5302,"برزت بكل أناقة","https://www.poetsgate.com/ViewPoem.aspx?id=205143",""],[5365,"بلا عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=190403",""],[5461,"استكثرك وقتي","https://www.poetsgate.com/ViewPoem.aspx?id=495",""],[5542,"نحن أدرى","https://www.poetsgate.com/ViewPoem.aspx?id=10197",""],[5542,"شموخ الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=10070",""],[5582,"نَفْسُ المُتَيَّمِ لَوْ ظَلَلْتَ تَلُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=187301",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5677,"ميثاق غلا ...!","https://www.poetsgate.com/ViewPoem.aspx?id=179806",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""],[5781,"قلوبٌ مَأهولةٌ بالظَّامئين","https://www.poetsgate.com/ViewPoem.aspx?id=202829",""],[5969,"سِفرُ الخلاصْ","https://www.poetsgate.com/ViewPoem.aspx?id=198863",""],[5975,"أظهرتِ ؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=53255",""],[6115,"رفرفي ياراية التوحيد عالي","https://www.poetsgate.com/ViewPoem.aspx?id=196475",""]],"verses":[["شَرِقنا بِلَذّاتِهِ وَالسَرو","رُ يُلَوّي إِزاراً وَيُرخي نِطاقا",0,"ق",2,0],["شَرِقَت بِأَدمُعِها المَطيُّ كَأَنَّما","فيها حَنينُ اليَعمَلاتِ شَهيقُ",1,"ق",1,0],["شَرِقَت غُرَّةُ القَريضِ بِنَدبٍ","أَشرَقَت عِندَهُ وُجوهُ الأَيادي",2,"د",2,0],["شَرَقٌ مِنَ الحِدثانِ لَو يُرمى بِهِ","ذا الماءُ مِن أَلَمٍ أَغَصُّ الماءَ",3,"ا",2,0],["شَرِقَتْ بنَغْمَةِ شاعِرٍ أو زائِرٍ","ودَعا هَديرٌ فاسْتَجابَ صَهيلُ",4,"ل",1,0],["شرّقت غرّبت من (والٍ) إلى ملك","يحثك الفقر... أو يقتادك الطلب",5,"ب",1,0],["شَرِقْتُ بعَبْرَتِي لَمَّا تَغَنَّتْ","عَلَى الأَوْتَارِ رَائِقَةُ الشَّبَابِ",6,"ب",1,1],["شَرِقاتٍ بِالسُمِّ مِن صُلَّبِيٍّ","وَرَكوضاً مِنَ السَراءِ طَحورا",7,"ر",2,0],["شَرقِيَّةٌ في طَبعِها","مَخدورَةٌ بَينَ الحُجَر",8,"ر",1,0],["شرقاً إلى مرتحل أقسمت","لا تبسم الأزهار من بعده",9,"د",2,0],["شرقَتْ شمسُهُ لمسترشديهِ","حين لم يألُ غيرُها تغريبا",10,"ب",2,0],["شرق شمس فيه تغيب وغربٌ","فيه تبدي صباحَها المفتوقا",11,"ق",2,0],["شَرَّقَ الناسُ بالذبائح في الأض","حى وأعطوْا طوابق اللُّحمان",12,"ن",1,0],["شَرَّقنَ إِذ عَصَرَ العيدانَ بارِحُها","وَأَيبَسَت غَيرَ مَجرى السِنَّةِ الخُضَرُ",13,"ر",1,0],["شَرَقَ الجَوِّ بِالغُبارِ إِذا سا","رَ عَلِيُّ اِبنُ أَحمَدَ القَمقامُ",14,"م",1,0],["شَرِقُ البنانِ بجوده غَدِقُ الندَى","كلتا يديهِ للعُفَاةِ يمينُ",15,"ن",1,0],["شَرِقوا بِالحَديدِ إِمّا سُيوفٌ","أَثخَنَت فيهِمُ وَإِمّا قُيودُ",16,"د",1,0],["شَرِّق وَغَرِّب فَعَهدُ العاهِدينَ بِما","طالَبتَ في ذَمَلانِ الأَنيُقِ الذُمُلِ",17,"ل",1,0],["شَرِقَتْ بماءِ الطَّبْعِ حتَّى خِلتُها","شَرِقَتْ لِريِّقِها ببردٍ ذائبِ",18,"ب",1,0],["شَرِّقْ لتجلوَ عن ضيائكَ ظلمةً","فالشمسُ يَمْرَضُ نورُها بالمغربِ",19,"ب",1,0],["شَرِقَ الظلامُ تألّقاً بضيائها","فكأنّما شَرِبَ الصَّباحُ المُسفرا",20,"ر",2,0],["شَرِقنا بِذَمِّ الدَهرِ يا سَلمُ إِنَّهُ","يُسيءُ فَما يَألو وَلَيسَ بِظالِمِ",21,"م",1,0],["شَرِقاتُ الأَطلالِ بِالماءِ مِن تِل","كَ العَزالي مُلِثَّةً وَالمَآقي",22,"ق",2,0],["شَرِقاً بِذَوبِ الشَهدِ يَخلِطُهُ","بِالزَنجَبيلِ وَفَأرَةِ التَجرِ",23,"ر",1,0],["شَرِقَت بِدَمعي وَجنَتي شَوقاً إِلى","ذي وَجنَةٍ شَرِقَت بِماءِ شَبابِهِ",24,"ب",2,0],["شَرِقَتْ بماء الوَرْدِ بَلّلَ جَيْبَها","فَسَرَتْ تُرَقْرِقُ دُرّه المنْضوحا",25,"ح",2,0],["شَرِقاً بِماءِ الذَوبِ أَسلَمَهُ","بِالطودِ أَيمنُ مِن قُرَى النَسرِ",26,"ر",1,0],["شرق الجو بالغبار إذا سا","ر علي بن أحمد القمقام",27,"م",1,0],["شَرَقَتْ لِماتُهَا أَصبِغَةً","وَرنَتْ أَعْيُنُهَا النَّجْلاءُ خُزرَا",28,"ر",2,0],["شرِقَت مقلَةُ المنابرِ بالدمع","ورقّ المحرابُ للمحرابِ",29,"ب",1,0],["شَرِقتُ بِالدَمعِ رُمتُ ريّي","بِهِ وَشُرّابُهُ عِطاشُ",30,"ش",1,0],["شَرِقت ثغورُ الدين منهُ بغُصَّة ٍ","ولقينَ منه حوادثاً وخُطوبا",31,"ب",2,0],["شرقت غربت من ( وال ) إلى ( ملك )","يحثك الفقر ... أو يقتادك لطلب",32,"ب",1,0],["شَرّقْ وَغَرّبْ فعَهدُ العاهدينَ بمَا","طالَبَتَ في ذَمَلانِ الأيْنُقِ الذُّمُلِ",33,"ل",1,0],["شرقيةٌ تسبيك لا غربية","بجمالها الموهوب فاعشق وافتد",34,"د",1,0],["شرَقتُ بريقي غيرةً وتحسُّراً","وقلتُ أهذا الكِسرُ ليسَ له جَبر",35,"ر",1,0],["شَرِقَتْ بِعارِضِها المُلِثِّ وأشْرَقَتْ","للَّهِ أَمْوَاهٌ غَدَتْ نِيرَانا",36,"ن",2,0],["شَرقُهُ الغَربِيُّ أَهداني إِلى","غَربِهِ في شَرقِهِ في مَشهَدَي",37,"ي",1,0],["شَرقيّةٌ غربَتْ دارُ الجميعِ بها","وفَرّقَتْ في البلادِ الجِيرةَ الخُلطَا",38,"ط",2,0],["شرَّقوا حيناً وحيناً غرَّبو","واستُبيحت أرضهم للغاصبين",39,"ن",1,0],["شرِّق وغرّبْ كيف شِئْتَ فإننا","لا نجهل التطبيل والتلميعا",40,"ع",2,0],["شَرِقاً بِهِ لَوْحُ الْهَوَاءِ وَجَوُّهُ","غَرِقاً به عَرْضُ البِلادِ وطُولُهُ",41,"ل",2,0],["شرقيّة الدار من غربيِّ دِجلةَ ما","جاورتُ بالحبِّ جيراني ولا وطني",42,"ن",2,0],["شَرَقَ العبيرُ بجيدها وحَماطَةٌ","للمسكِ فائِحةٌ على أردانها",43,"ه",2,1],["شَرَقتُ منك بِكأسِ الضّيمِ إِن وقعت","نَجواك مِن أُذني إلّا عَلى صممِ",44,"م",1,0],["شرقا وغربا مدحهم ملأ الدنى","عطرا يليق به بديع نشيد",45,"د",1,0],["شرِّق وغرِّب فالبلاد أمينة","دهماؤها منقادة دأماؤها",46,"ا",3,0],["شَرقَتْ مدامعُهُ بفَيضِ دُموعه","إذ ضاقَ ذرْعاً في الهوى بخضوعِهِ",47,"ع",2,1],["شَرقَت من دمٍ مدامعُ عينٍ","ما رَثَت لي وقد شرقتُ بريقي",48,"ق",2,0],["شرِقَت بهم أرجاؤهم","أرَجاً وأشرقت الدُنا",49,"ن",2,0],["شَرِقتُ بِرشفِ رِيقَتهِ وَيَامَا","ثَمِلْتُ وَقَدْ رَشَفْتُ بِهِ الزُّلاَلاَ",50,"ل",2,0],["شَرَقَ القُصورَ بَريقُها لَمّا اِجتَلَت","مِنّى عَلى بُسُطِ الرِياضِ عَروسا",51,"س",2,0],["شرقيكم ولذي مع الغربي وال","ملكي والقبطي والسرياني",52,"ن",2,0],["شرقت بِكَوكَب هَديهِ حمص كَما","شَرفت تهامة بِالنَبي الطاهر",53,"ر",1,0],["شَرِقَ العَدُّو وغَصَّ منْكُم بالشَّجا","وأَطابّ برّكم الوَليُّ وأَفلحا",54,"ح",2,0],["شرُّ قرين للكريم أقربه","ذلك أفعاه وذاك عقربه",55,"ه",1,0],["شرق الفضاء وغص بالجرد التي","من فوقها القُضُب الوشيج الذابل",56,"ل",1,0],["شرقا كضوء الصبح أسفر مشرقا","والصبح لا يخفي سناه ظلام",57,"م",1,0],["شرَّق حادي العيس في صحبه","فسالَ دمعُ العين من غربه",58,"ب",2,1],["شَرقت بِعبرة ثاكل فَكَأَنَّها","فَقَدت لَعمرك وَحيها وَكتابها",59,"ب",3,0],["شرق شوقي يمتاح غرب جفوني","بدلاءِ الهُمُومِ والهيمانِ",60,"ن",1,0],["شرقاً وغرباً لترى أرباعَه","لكلِّ رُبعٍ دَرَجٌ فاسمعَه",61,"ه",1,0],["شرقيَّةٌ فى طبعها غربيةٌ","فى فعلها وحريصةٌ لا تُخدع",62,"ع",1,0],["شرقية في شرقها تقتفي","غريبةً في غربها تخدعُ",63,"ع",1,0],["شرقتني بعبرة في هواها","بحرث حيث غرب التقبيل",64,"ل",1,0],["شَرقاً وَغَرباً قبلَة شَمالا","بَرقاً وَرَعداً مِثل سيلٍ سالا",65,"ل",2,0],["شرق الترائب يشرئب فانثني","والعين تشرق بالنجيع القاني",66,"ن",2,0],["شرق الترائب يشرئب فأنثني","والعين تشرق بالنجيع الجاري",67,"ر",2,0],["شرق المحيا حاسراً","عن طرة الفلق المقدد",68,"د",1,0],["شَرقية الأَعطان لَما أَن بَدَت","مال الوُجود مغرباً وَمشرقا",69,"ق",2,0],["شرقت بانجمها المدامع تجتلي","قمراً تمثله الصبابة مشرقا",70,"ق",2,0],["شرقية الأنساب الا انها","قد البست ثوب الجمال الأوربي",71,"ب",2,0],["شرقية الجنس لكن","غربيةٌ في العقائد",72,"د",1,0],["شرقيّه استاذُنا النسيمي","ممتزجُ المشرب بالتنسيم",73,"م",1,0],["شرقاً يشق الصبرُ فيه جيبَه","ويحلُّ عقدةَ غربِ جفنٍ ما غفا",74,"ف",2,0],["شرقية ابتهجي بنور أميرْ","صار به وجه البلاد منيرْ",75,"ر",1,1],["شرقية استغنمي في فقده حزناً","من بعده إن كل الحسن منك ددن",76,"ن",1,0],["شرقها دَرى","غربها عَلِم",77,"م",1,0],["شَرِقَتْ مُلْسُ الدَّيامِيمِ بها","شَرَقَ الغَارِ وفاءَتها البِحَارُ",78,"ر",1,0],["شَرِقْتُ على دَارِ الحبيبِ بأَدمعي","وقد شَرِقَتْ أَطلالُها بالمَصَائِبِ",79,"ب",1,0],["شَرقَتْ بهم شَرقَ الشجيْ","يِ بطونُ نجدٍ والظواهرْ",80,"ر",1,0],["شرقت بريا عارضيها كأنما","شرقت بدار العراق المعتق",81,"ق",1,0],["شرق الغرام كما المعالي أشرقت","في طلعة المولى قوي الجاش",82,"ش",1,0],["شرق الافق بالقساطل منه","واشتكت السن الجبال الكلالا",83,"ل",2,0],["شَرقت بِأَدمُعي وَصَليت وَحدي","فَها أَنا مِنكَ في طَرفي نَقيضِ",84,"ض",1,0],["شرق وسل عن ماجد","يعطي الجواهر بالجوائز",85,"ز",1,0],["شَرِقَت نُسورُ ظُباكَ مِنهُم بَعدَما","نَهِلَت وَعَلَّت مِن نَجيعِ أحمرِ",86,"ر",1,0],["شرقت دمشق الشام إذ نزلوا بها","سكنا أعز جوازه السكان",87,"ن",1,0],["شرِقاً بِهِ ماءُ السدِيف فإن يَكُن","لا شَحمَ فيهِ فَمَا استَطَعنَا نَحشُدِ",88,"د",1,0],["شَرقنا بكأس اللهَو والبدرُ مشرقٌ","وقلبُ سهيل في حَشا الليل يخَفق",89,"ق",1,1],["شَرِقَت بماء الحسن حتى خَلَّصت","ذهبية في الخدِّ من فضيه",90,"ي",2,0],["شرقتم فأنا بغُصَّة غربتي","في الغرب ذو شرق وذو أشجاء",91,"ا",2,0],["شرَّقْتني بالدَّمعِ مذْ","غرَّبتْ عني تحتَ حجبِكْ",92,"ك",1,0],["شرقت بالمثارعن موقع النجم","تداعى والعاشقون اجتياح",93,"ح",1,0],["شرق ولا غرب علمنا مكانه","من الأرض معمورا ولا متجنب",94,"ب",1,0],["شرقٍ وغربٍ صاحب الشوق وحده","حر جناحه دايم الوقت خفاق",95,"ق",1,0],["شرقيةٌ أجفانُ ليلى والهوى","بحرٌ به العادي يخوضُ ويبحرُ",96,"ر",1,0],["شرقت بآمالي وقد كنت عاشقا","له في بساط العشق بان وغازل",97,"ل",1,0],["شرقت بي وغربت واستحلت","كل فكري في وقفة وانطلاقة",98,"ق",2,0],["شرقيّةً غربيّةً وقريبةً","وبعيدةً مثلَ النّجومِ بعيدَه",99,"د",2,0],["شرق مشيت وغرب وقتي مشى بك","والقلب ماله لايم فيك لو ون",100,"ن",1,0],["شرقوا أو غربوا إنا ورثنا","من تعاليم الهدى خير الشمائل",101,"ل",1,0],["شرَّقوا حيناً وحيناً غرَّبوا","واستُبيحت أرضهم للغاصبين",102,"ن",1,0],["شَرَقَتْ بِكَ الدُّنْيا وَضاءَتْ أَرْضُها","وَسَماؤُها آفاقُها وَتُخُومُها",103,"م",3,0],["[ شَرَقَتْ بِسِيرَتِهِ البِلادُ وَأَوْضَحَتْ","أَرْجاءَها مِنْ عَدْلِهِ الأَنْوارُ ]",104,"ر",1,0],["شرقت بصدوف الليالي وغربت","تحاذفتني لين مالانهايه",105,"ا",3,0],["شَرِقْتُ باللا أسمّي من مطالعِها","فأورقَتْ قَسَمَاتُ الوَرْدِ والزَّهَرِ",106,"ر",1,0],["شَرَقتْ بِدَمْعَتِها كَكُلِّ بَليَّةٍ","وَمَنِيَّةٍ مَخْضوبةٍ بِدِماءِ",107,"ا",2,0],["شَرْقٌ وَغَربٌ كُلُهُ مأسورُ","في قاعِ جُبٍ جَوْفُهُ مَهجورُ",108,"ر",1,1],["شرَّقتُ في حبّي وغرَّبَ","خافقي ... نحوَ الفلاحْ",109,"ح",1,0],["شرق ولاّ غرب وجنوب وشمالي","دون حدّ المملكه درعٍ ضمينا",110,"ن",2,0]]}