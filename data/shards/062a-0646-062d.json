tml","الكامل"],[482,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[482,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[484,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[503,"يا راكضاً في طلاب دنيا","https://www.aldiwan.net/poem3693.html","مخلع البسيط"],[505,"ما قول هند إذا ما صدها القدر","https://www.aldiwan.net/poem37697.html","البسيط"],[563,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138276",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66851","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101525","الرمل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104009","الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[1033,"","https://poetry.dctabudhabi.ae/diwan/poem/18176","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133764","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25317","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64601","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123030","المتقارب"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10453","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93606","الطويل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84901","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65958","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100792","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145046","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68023","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59443","المتقارب"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95319","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35619","الوافر"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76441","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199105","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86391","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136708",""],[4782,"يَمَن الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=199200",""],[4797,"في كفها خاتم","https://www.poetsgate.com/ViewPoem.aspx?id=29432",""],[4927,"عُبُوْرُ السِّنِيْن","https://www.poetsgate.com/ViewPoem.aspx?id=29648",""],[4984,"حيَّ على الصبح *","https://www.poetsgate.com/ViewPoem.aspx?id=175747",""],[5145,"تنحط من قدرك السماء","https://www.poetsgate.com/ViewPoem.aspx?id=108099",""],[5147,"تغالطنا أصول الانتخاب","https://www.poetsgate.com/ViewPoem.aspx?id=166692",""],[5183,"وَقَارُ الحَوَادِثُ","https://www.poetsgate.com/ViewPoem.aspx?id=186446",""],[5256,"أنادي إلهي بيا ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=157390",""],[5411,"سادَةَ التَّدْليسِ","https://www.poetsgate.com/ViewPoem.aspx?id=196945",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[5843,"وصندوق البريد","https://www.poetsgate.com/ViewPoem.aspx?id=51286",""],[5848,"الجادل","https://www.poetsgate.com/ViewPoem.aspx?id=50589",""],[5957,"تنحى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=176787",""],[5601,"النبع والمقصلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65778&r=&rc=117",""]],"verses":[["تَنَحَّ فَما لِلحَيِّ كَلب بِأَرضِنا","قَرارٌ يَقيها النائِباتِ مَكينُ",0,"ن",1,0],["تَنَحّى بِصَفراءَ مِن نَبعَةٍ","عَلى الكَفِّ تَجمَع أَرزاً وَلينا",1,"ن",2,0],["تَنَحَّى لَهُ عَمروٌ فَشَكَّ ضُلوعَهُ","بِنافِذَةٍ نَجلاءَ وَالخَيلُ تَضبِرُ",2,"ر",1,0],["تُنحي بِأَلحِيَها رُؤوسَ البيدِ","يُصبِحنَ بَعدَ الطَلقِ بِالتَحريدِ",3,"د",1,0],["تَنَحى لِأَدناها فَصادَفَ سَهمَهُ","بِخاطِئَةٍ مِن جانِبِ الكيحِ ناطِحُ",4,"ح",1,0],["تنحو الشمال بضربةٍ فيردّها","نجو الجنوب ملاعب لطّام",5,"م",1,0],["تنحلّ بالرأي منك المشكلات لنا","كالنور ينحلّ ألواناً من الشرق",6,"ق",1,0],["تنحو بنا طُرُق البوار تحيُّفاً","وتَسومنا سوء العذاب الأهَول",7,"ل",1,0],["تَنَحَّ فَإِنَّ بَحري خِندِفِيٌّ","تَرى في مَوجِ جِريَتِهِ عُبابا",8,"ب",2,0],["تَنَحَّ اِبنَ صَفّارٍ إِلَيكَ فَإِنَّني","صَبورٌ عَلى الشَحناءِ وَالنَظَرِ الشَزرِ",9,"ر",1,0],["تَنحَشِدُ الطَيرُ بِأَكنافِهِ","وَيَجمَعُ الوَحشُ جَماعاتِهِ",10,"ت",2,0],["تَنحّى لِاِبنِ مَريَمَ حينَ جاءَ","وَخَلّى النَجمُ لِلقَمَرِ الفَضاءَ",11,"ا",2,0],["تَنْحوُ أَضَالِعَهُ سُيوفُ أُمَيّةٍ","فتراهُمُ الصَّمْصُومَ فالصَّمْصُوما",12,"م",2,0],["تَنَحَّ فإنّهُ صِبْغُ اللّيالي","وحَلْيُ الرَّأْيِ رُحْتُ بِهِ مُحَلّى",13,"ل",2,0],["تَنحاشُ نَفسي أَن أَذِلَّ مَقادَةً","وَيَزيدُ شَغبي أَن أَلينَ عِنانا",14,"ن",2,0],["تَنحَطُّ فيها وُفودُ الماءِ مُعجَلَةً","كَالخَيلِ خارِجَةً مِن حَبلِ مُجريها",15,"ي",3,0],["تَنَحَّ أَهانَ اللَهُ مَثواكَ خاسِئاً","عَنِ اِسمِ نَبِيِّ المُسلِمينَ مُحَمَّدِ",16,"د",1,0],["تَنَحَّ عَنِ البَطحاءِ إِنَّ قَديمَها","لَنا وَالجِبالُ الباذِخاتُ الفَوارِعُ",17,"ع",1,0],["تَنَحَّ عَنِ الحَجّاجِ إِنَّ زِحامَهُ","شَديدٌ إِذا أَغضى عَلى مَن يُزاحِمُه",18,"م",2,0],["تُنحي عَلى صَخرَةٍ صَمّاءَ تَحسِبُها","عُضواً خَلَوتَ بِهِ تَبري وَتَنتَحِضُ",19,"ض",1,0],["تَنحَني فَوقهُ كرائِمُ ذاكَ الد","دوح مِنها الجَني وَكَم يَتَجَنّى",20,"ن",2,0],["تَنَحَّل ما اِستَطَعتَ فَإِنَّ شِعري","تَلَقَّحَ بِالقَصائِدِ عَن كِشافِ",21,"ف",1,0],["تَنَحَّي فَاِجلِسي مِنّا بَعيداً","أَراحَ اللَهُ مِنكِ العالَمينا",22,"ن",2,0],["تَنَحَّ لَحاكَ اللَهُ لَستَ مِنَ العَدَد","وَلَيسَ أَبوكَ الوَغلُ بِالسَيِّدِ السَنَد",23,"د",1,1],["تَنَحَّ أَبا فِعلٍ لِأُمِّكَ حاجَةٌ","إِلَينا وَلا تَشغَب فَما كُنتَ مِشغَبا",24,"ب",2,0],["تَنَحَّى عَلَيهِ كُلُّ أَسقَفَ جانىءٍ","بِجَبهتِهِ حَتّى يَكِلَّ وَيَعمَلا",25,"ل",2,0],["تنحني الريح إذ تراه وتمشي","زُمَرُ الطير خلفه أسرابا",26,"ب",2,0],["تنحو ابن بجدتها العليا وبؤبؤها","وشأنها لمصاص المجد خلصان",27,"ن",1,0],["تنحو المقامات والزلفى بمسلكها","وقد وصلت ولولا الجد لم تصل",28,"ل",1,0],["تنحو على فضل أوطاري فتعكسها","فلست ابرام امرا ليس ينفتل",29,"ل",1,0],["تنحي واجلسي مني بعيدا","أراح الله منك العالمينا",30,"ن",2,0],["تَنحَّ أبا فِعْلٍ لأُمِّكَ حاجة","ٌ إلينا ولا تشتغب فما كنت مشغبا",31,"ب",2,0],["تنحوا بنا طرق البوار تحيُّفا","وتسومنا سوءَ العذاب الأهول",32,"ل",1,0],["تُنحرُ في مكّة العِشارُ ولا","تُنحرُ إلا عليهم المُقَلُ",33,"ل",1,0],["تَنحو هُماماً في ظِلِّ خِدمَتِهِ","تُجنى المَعالي وَتُكسَبُ الرُتَبُ",34,"ب",1,0],["تَنَحَّ وَدَعها هَكَذا غَيرَ صاغِرٍ","لِمَلكٍ هُمامٍ ما اِشتَهَت فَهوَ باذِلُ",35,"ل",1,0],["تنحّى بِهم مِن قلّةٍ في المعابدِ","وَزادوا فَصاروا بعدُ جَيشاً عَرَمرما",36,"م",2,0],["تنحطُّ قحطانٌ وساداتُها","عنهمْ وتمشي خلفهمْ تغلِبُ",37,"ب",1,0],["تنحر النوق والشاة والاعدا","ولو كان فذهم كالشاه",38,"ه",1,0],["تنحر البدن وتضحى آمنا","فيه والأعداء من بعض الأضاحي",39,"ح",2,0],["تنحط مثل السيل في سيرها","وفي عقاب الأرض مثل العقاب",40,"ب",1,0],["تنحى تنحى لاسلاماً ولا رضا","تريدين قطعي عن سبيل غنائي",41,"ا",3,0],["تَنح عذولي اِن دَمعي سائِلاً","وَلحظ الَّذي يَهواهُ قَلبي مُرهَف",42,"ف",1,0],["تَنحَسِرُ الغَمرَةُ عَنهُ كَما","يَنحَسِرُ النَجمُ عَنِ الفَرقَدِ",43,"د",1,0],["تنحَدِرُ الكاساتُ في مَتْنِهِ","فتَذْكُرُ العيُّوقَ والفَرْقَدا",44,"د",2,0],["تُنحي فأحملُها ثِقالاً مُكرهَاً","وكأنني بتجلُّدي مختارُ",45,"ر",1,0],["تنحَّ عن مكانه","من العلا تنحَّا",46,"ح",2,0],["تنحو بيَ البلدَ البعيدَ مزارُهُ","وخداً فًتُرْجِعُهُ قريباً دانيا",47,"ي",2,0],["تنحو الأحبَّةَ لمّا أن نأتْ بهمُ","نُجْبٌ تسابقُ منها كلَّ طيّارِ",48,"ر",1,0],["تنحو الشسيعَ واِنْ كانتْ مهزَّلَةً","تستنُّ ما بينَ أنقاءٍ وأعقادِ",49,"د",1,0],["تنحنح للقرى يا تغلبي","وقل يا ليتني كنت ترابا",50,"ب",2,0],["تَنَحَّ يا عُرضَةً لِرامٍ","أَسهُمُه بِالرَدى تُراشُ",51,"ش",1,0],["تَنحَطُّ ثورتُهُم والسَهمُ يَخدِشُهُم","مِن كلِّ وجهٍ فَهُم ماتوا وما شَعَروا",52,"ر",3,0],["تنحل فيها المشكلات جميعها","والسنة الغراء والقرآن",53,"ن",1,0],["تنحو البلاد مبجّلا ومكرّما","وتؤوب بالإجلال والإكبار",54,"ر",1,0]