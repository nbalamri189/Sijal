{"poems":[[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[102,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64630","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49547","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93571","الخفيف"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93740","الرمل"],[5277,"بين الركن والمقام","https://www.poetsgate.com/ViewPoem.aspx?id=208647",""],[6056,"مفهوم التميّز","https://www.poetsgate.com/ViewPoem.aspx?id=130345",""]],"verses":[["تُحَشَّشُ في أَذيالِها مُستَكينَةً","وَتَحطِبُ ذُلّاً في حِبالِ الغَدائِرِ",0,"ر",1,0],["تحشن الرميَ تارةً مستقيما","وإلى الخلف تارة مقلوبا",1,"ب",2,0],["تُحَشُّ بِصَندَلٍ صُمٍّ صِلابٍ","كَأَنَّ الضاحِياتِ لَها قَضيمُ",2,"م",1,0],["تحشدين الصفاء في كل لمس","وعلى كل نظره وافتراره",3,"ر",2,0],["تحشو الليالي ما يبقى ولو بليت","من المفاخر حتى لات مفتخر",4,"ر",1,0],["تحشيِّاً منه يخشى القومُ رفقتَهُ","تنحطُّ نفسه عن اسمى فضائلها",5,"ه",2,0],["تَحُشُّ به المنيةُ كلَّ قَرْمٍ","نجيبٍ فوق مُنْجَرِدٍ نجيب",6,"ب",1,0],["تحشر في عينِ كلِّ كونٍ","تنظر فيه الذي صنعتا",7,"ت",2,0],["تحشر الخَيل كَالوُحوش وَلَكن","خَلفَها الطَير سائق وَشَهيد",8,"د",1,0],["تحشر القدرة فيها وَالقوى","بَينَ آمال وَحسّ وَفكر",9,"ر",1,0],["تحشرجهُ المواجعُ حين يصبو","ويرطنُ من هواهُ فلا يَبينُ",10,"ن",1,0],["تحشرج داخل أعماقي فلول الشعرلي شكّاي","وأعسفه قاف منثور ٍ من الياقوت والمرجان",11,"ن",1,0]]}