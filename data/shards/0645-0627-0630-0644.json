.aspx?id=200349",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[5956,"ما ذَلَّ حكمٌ إنْ يقربْ ناقدا","https://www.poetsgate.com/ViewPoem.aspx?id=184127",""],[5956,"يا ناشر الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192511",""],[5975,"الوفاء لمن أحب","https://www.poetsgate.com/ViewPoem.aspx?id=52984",""],[6070,"إعدلْ هداكَ اللهُ للإحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188631",""],[5190,"عاشق الكنانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85059&r=&rc=134",""]],"verses":[["ما ذلك الشدو؟ من شاديه؟ إنهما","من أرض بلقيس هذا اللحن والوتر",0,"ر",1,0],["ما ذلك اللغز إلاَّ روضة أنف","تفاءل القلب فيه للحسودِ فنَا",1,"ن",2,0],["ما ذَلَّلتُ سُبُلَ المَعالي أُمَّةٌ","إِلّا بِقُوَّةِ مُصلِحٍ أَو هادي",2,"د",2,0],["ما ذلك الصوتُ شاجي اللحن سحَّارُ","يُجرِيهِ نبعٌ من الإِلهام زَخَّارُ",3,"ر",1,1],["مَا ذَلِكَ التَّرْصِيعُ لَيْسَ مُرَصَّعاً","مَا ذَلِكَ التَّفْويفُ لَيْسَ مُفَوَّفَا",4,"ف",2,0],["ما ذَلِكَ السمُّ في الآبارِ ويْلكُمُ","وَمَنْ نُحارِبُ جُنْداً أم ثَعابينَا",5,"ن",2,0],["ما ذلك الحمل الذي يحتسي","خفقي ، ويعصي ذا هلا أو يطيع",6,"ع",1,0],["ما ذلك العلم المبيح دم الفتى","في ملة الإسلام بالبرهان",7,"ن",1,0],["ما ذلك الصوت ما هذا البغام أجب","يا بلبلاً شدوه سورات صهباء",8,"ا",2,0],["ما ذلك الأحد الآتي وما غده","سوفت سوفت في ميعاد لقياني",9,"ن",2,0],["ما ذلك الوجه","إني عليه أحوم",10,"م",1,0],["ما ذلك العرض الشريف يثلم ؟","ويسيل من حنَق حواليه الدم ؟",11,"م",1,1],["ما ذلك المقبورُ عبدُ ال","لهِ لكن قابرُه",12,"ر",2,0],["ما ذَل مِن يَسْلِك سبيله ولا هانْ","يْهون غيره وانْ نفَد ما ينافي",13,"ف",2,0],["ما ذلك من دود بنى من فوقه","تلك البيوت وعاد ذا الطيران",14,"ن",1,0],["ما ذلّ للغادات إل","لا كل من فقد الهدى",15,"ا",1,0],["ما ذل شعب قط وهو مؤيد","بالاتحاد وصحة التفكير",16,"ر",1,0],["ما ذلك الاجتناب منك وما","مني ذنب بدا فتجتنب",17,"ب",1,0],["ما ذَلَّ لِلضَّيْمِ في غَفْوِ ولا يَقَظٍ","يَمُدُّهُ مِنْ خُطُوبِ الضُّرِّ أَعْوانُ",18,"ن",1,0],["ما ذلَّ من لذله ولائهم","وعز فيه جانباها فاحتمى",19,"ا",1,0],["ماذلّني .. شحّ الفرح .. وإحتياجه","ولا هدّني .. دمع المحاجر .. ولا هبْت !!",20,"ت",1,0],["ما ذلكَ القرآنُ يُشرقُ في دمٍ","إلا ويُنشئُ في العروق ِ لهُ حديقة",21,"ق",2,0],["ما ذَلَّ ذو شَرَفٍ إِلاّ بِمُنْصَرَفٍ","عَنْ هَبَّةِ الخيْلِ تَعْلو رَأْسَها الأَسَلُ",22,"ل",1,0],["ما ذلك الروض الأريض تضاحكت","أكمامه وبكاه غيث ريق",23,"ق",1,0],["مَا ذَلَّ جَارٌ وَكَانَ الفَهدُ نَاصِرُهُ","جِيرَانُ فَهدٍ وَلاجِيرَانَ ذِي سَلَمِ",24,"م",1,0],["ما ذَلَّ مَن رضِيَ الإباءَ مساكنا","فالمجدُ في شِعَبِ الحياةِ غريبُ",25,"ب",1,0],["ماذل منهو جاه للعفو راجيه","يكفيك نفسك حين تشكي بلدها",26,"د",3,0],["ما ذلك البؤسُ الذي يمشي به","وأنا على نسقٍ أكرّرُ منتحلْ",27,"ل",1,0],["ما ذلنا اليوم منهم بأسُ ألويةٍ","لكننا قد أذلتنا خطايانا",28,"ن",2,0],["ما ذَلَّ حكمٌ إنْ يقرِّبْ ناقدا","والذلُّ في حكم بلا نُقَّادِ",29,"د",1,0],["ما ذلّ مَن كان الإلهُ مُعِزَّهُ","والنصر يا قدسَ العروبةِ آتِ",30,"ت",1,0],["ما ذلكَ الحبُّ الذي في داخلي","إلا برقَّتكَ الجميلةِ لملما",31,"م",2,0],["ما ذلَّتِ الأعرابُ في بلدانها","إلا بظلمِ الجَهلِ والقضبانِ",32,"ن",1,0],["ما ذلَّ يوماً ، ما اْستكانَ لغاصِبٍ","كلاّ ، ولم تُرهِبْ خُطاهُ بنادِقُ",33,"ق",1,0]]}