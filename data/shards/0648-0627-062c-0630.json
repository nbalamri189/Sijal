{"poems":[[65,"نظرت بألحاظ الظباء العين","https://www.aldiwan.net/poem46160.html","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112739","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112707","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112709","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112762","الرمل"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114828","الوافر"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130695","الرمل"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198717","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135344","الطويل"],[5447,"أنا لي","https://www.poetsgate.com/ViewPoem.aspx?id=208295",""],[5956,"أغذي الناس بالشَّجَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=185732",""]],"verses":[["واجْذِبْ زِمامَ الأرْحَبيّ ولا تُبَلْ","ذِكْراً وَصَلْنَ حَنينَهُ بحَنيني",0,"ن",2,0],["واجذبه يا بر جذب المكرمين لخير","المرسلين لكي تسقيه راحته",1,"ت",2,0],["واجذبني إلى علاك بجذب","صالح فيه إصلاح أمري",2,"ر",2,0],["واجذب جناني مع جميعي للرضا","يا سيدي ليكون فيك تسابقي",3,"ق",2,0],["واجذبني جذبة وهبيّة","وقنى البأسا وقل لي قد وصل",4,"ل",1,0],["وأجذَمَ ذَبُّها عَوداً وبَدءاً","بدَفَّيهِ تَعَبقَرَتِ السِّخالُ",5,"ل",1,0],["واجذبِ العُودَ فَمِن نَغمَتِهِ","يَفزَعُ الهَمُّ إلى أقصى مَفَر",6,"ر",1,0],["وأجذبه إلي ولست أدري","أعطفا عطفه أو خيزرانا",7,"ن",2,0],["وأجذب خير الخلقِ بالله وحده","وأدفع عني بالإله شروره",8,"ر",2,0],["وأجذِبُني إليٍّ كجذعِ سروٍ","يجاذبُ غُصنَهُ لينالَ فَيَّا",9,"ي",2,0],["وأجذِبُهم لأرشدَهم","لِما يَقضي على المِحَنِ",10,"ن",1,0]]}