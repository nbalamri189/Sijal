ps://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55162","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[77,"سقى علم الجنتين فالجزع فالبانا","https://www.poetsgate.com/ViewPoem.aspx?id=34162",""],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"ذات الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=179215",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[45,"لا تَلْحَني، إنْ عَزّني الصّبْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31281",""],[24,"بان الشبابُ وأَمْسَى الشَّيْبُ قد أَزِفَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10871&r=&rc=12",""]],"verses":[["وَلاحَت لَنا أَبياتُ آلِ مُحَرِّقٍ","بِها اللُؤمُ ثاوٍ لا يَروحُ وَلا يَغدو",0,"و",1,1],["وَلاحَ كَجِلْدَة النَّمِرِ الثُّرَيّا","بِلَيْلٍ مِثْلِ ناظرَةِ الغزالِ",1,"ل",1,0],["وَلاحَتْ لَهُ فَرْعاءُ تَهْدِرُ فَوْقها","قُدُورٌ لَهَا تَحتَ الظَّلامِ نَئيمُ",2,"م",1,0],["ولاحَتْ تَباشيرُ الصّباحِ كأنّها","سَنا المُقْتَدي باللهِ في آلِ عَبّاسِ",3,"س",1,0],["ولاحَ في الكِلّةِ الصّفْراءِ لي رَشأٌ","يَرْمي دُجَى الليلِ عنْ أجْفانِ مَرْعوبِ",4,"ب",1,0],["ولا حَسَبٌ يُقَدِّمُهُمْ ولكنْ","أرى الأُنْبوبَ قُدّامَ السِّنانِ",5,"ن",1,0],["ولاحَ كَما يَقْتَذي طائِرٌ","ولم يَسْتَطِعْ منْ كَلالٍ سُراهْ",6,"ا",2,0],["وَلَأَحمِيَنَّ النَفسَ عَن شَهَواتِه","حَتّى أَرى ذا ذِمَّةٍ وَوَفاءِ",7,"ا",2,0],["وَلا حُزنٌ يَدومُ وَلا سُرورٌ","وَلا بُؤسٌ عَلَيكَ وَلا رَخاءُ",8,"ا",2,0],["ولاحَتْ لَنا منْ بِشْرِهِ ونَوالِهِ","سَحائِبُ تَهْمي والشُموسُ طَوالِعُ",9,"ع",1,0],["وَلاَ حَلِيَ الْحَالِي عَلَى الْبُعْدِ غَرّنِي","وَلاَ عَيْشِيَ الْهَانِي عَلَى النَّأي الْهَانِي",10,"ي",1,0],["وَلاَ حَلَّ فِي قَلْبِي لِغَيْرِكَ خَطْرَةٌ","وَلاَ اسْتَحْسَنَتْ عَيْنَايَ بَعْدَكَ إِنْسَانَا",11,"ن",2,0],["وَلاَحَتْ بآفَاقِ السَّمَاحِ مَخِيلَةٌ","مِنَ الْجُودِ يَتْلُو بَرْقَهَا الْعَارِضُ السَّجْمُ",12,"م",1,0],["ولاحَتْ لهُمْ خَطَفاتُ البُروقِ","تلوحُ مِراراً وتخْفى مِرارا",13,"ر",2,0],["ولاحَتْ لهُ في حوْمَةِ القَلْبِ فتْكَةٌ","تعجَّلَ نصْرَ اللهِ فيها لوَعْدِهِ",14,"د",2,0],["وَلاحِبٍ كَحَصيرِ الرامِلاتِ تَرى","مِنَ الَمَطِيِّ عَلى حافاتِهِ جِيَفا",15,"ف",2,0],["وَلا حَنَّ طِرسٌ إِلى كاتِبٍ","وَلا خَفَّ لَفظٌ عَلى مِسمَعِ",16,"ع",1,0],["وَلا حَياةَ لَكُم إِلّا بِجامِعَةٍ","تَكونُ أُمّاً لِطُلّابِ العُلا وَأَبا",17,"ب",2,0],["وَلا حُكمَ حينَ يُصلَبُ جَهرَةً","فَحينَئِذٍ لا ظُلمَ تَخشى وَلا هَضما",18,"م",2,0],["وَلاحَ سَنيرٌ عَن يَميني كَأَنَّهُ","سَنامٌ رَعيبٌ فَوقَ غارِبِ مُصعَبِ",19,"ب",1,0],["وَلاحَت جِبالُ الثَلجِ زُهراً كَأَنَّها","ضِياءُ صَباحٍ أَو مَفارِقُ أَشيَبِ",19,"ب",1,0],["وَلاحَت قُصورُ الغوطَتَينِ كَأَنَّها","سَفائِنُ في بَحرٍ يَعُبُّ عُبابُهُ",20,"ب",2,0],["وَلاحَت لِساري اللَيلِ فيهِ نُجومُهُ","عَلَيكَ مِنَ الصَبِّ المَشوقِ سَلامُ",21,"م",1,0],["وَلاحتِ الجَوزاءُ كَالعُقودِ","عارَضنَهُ مِن عَنَن بَعيدِ",22,"د",1,0],["وَلاحَ أَزهَرُ مَشهورٌ بِنُقبَتِهِ","كَأَنَّهُ حينَ يَعلو عاقِراً لَهَبُ",23,"ب",1,0],["ولاح عمود الصبح مثل انتسابه","رفعتُ عليه للمديح المبانيا",24,"ي",2,0],["ولاحت كالسراج لنا فطافت","بها قطع السحائب كالفراش",25,"ش",1,0],["ولا حياة لهم من بَعدُ أن جَبُنوا","كلاّ وأي حياة للذي جَبُنا",26,"ن",2,0],["ولاحت لنا حريّةُ العيش عندما","أماطت لنا الأحرار عن وجهها السَجْفا",27,"ف",2,0],["ولاحت تباشير الحقائق فانجلت","بها عن بني الدنيا شكوك التوهُم",28,"م",1,0],["وَلا حَسَبٌ فَخَرتَ بِهِ كَريمٌ","وَلا جَدٌّ إِذا اِزدَحَمَ الجُدودُ",29,"د",1,0],["ولا حليلة جاري لست زاعمها","تصبو إليَّ وساء الصدق والكذبُ",30,"ب",1,1],["ولاحُمولٍ غَدَت ولا دِمَنٍ","مَرَّ لها من بَعدِ حِقبَةٍ حِقَبُ",31,"ب",1,0],["وَلاحَت لي مِنَ السَلوَ","ةِ آياتٌ وَآثارُ",32,"ر",1,0],["وَلاحِقَةِ الإِطلَينِ مِن نَسلِ لاحِقٍ","أَمينَةَ ما نِطَت إِلَيهِ الحَوافِرُ",33,"ر",1,0],["ولاحٍ ما لهُ هاء وميمٌ","له من صبوتي ميم وهاء",34,"ا",2,0],["ولاحٍ ثقيلٍ في مليحٍ ممنَّعٍ","فيا لكَ من أُحدٍ لديَّ ومن بدر",35,"ر",1,0],["ولا حلت عنهُ فاتر اللحظ أغيداً","يخرُّ له الغصن الرطيب إذا خطا",36,"ط",2,0],["ولا حال يوم الشعر عنِّي هوى له","ولا قطعت يوم الشعير علائقي",37,"ي",1,0],["ولا حصلت على دنيا وآخرةٍ","إلا بدولة من أنشا ذوي الدول",38,"ل",1,0],["ولا حيا السحب في تراكمها","بالودق تسخو طلال تسجامه",39,"م",2,0],["ولا حَمِدَ اللَّهُ الأولى يَحْمَدونه","ولا اعتدَّهم في الناس من أوليائِهِ",40,"ا",3,0],["ولاح شيبي فراعَ قاليتي","بل خُلَّتي بل خليلتي شَهَبُهْ",41,"ب",2,0],["ولأحدُوَنَّ بك القوا","فيَ والكلام الشاردا",42,"د",2,0],["ولا حرب إلا عَتبُ نفسٍ كريمةٍ","على سيدٍ في رأيه قال بالظَّفر",43,"ر",1,0],["ولا حَليَ للأرض من نورِها","كحلي السماء سوى النَرجسِ",44,"س",1,1],["ولأحرصنَّ على قطيعتِهِ","وبعاده أضعافَ ما حرصا",45,"ص",2,0],["ولاح بديلٌ منه رذل كأنما","سقتني لياليه الزُعاف المخضخضا",46,"ض",2,0],["ولاحظت النوّار وهي مريضة","وقد وضعت خدّاً إلى الأرض أضرعا",47,"ع",2,0],["ولاحت بروق منك أخلف رعدها","على أنني ما أخلفتك بروقي",48,"ق",2,0],["ولا حمدَ لي في أن نَشْرك طيّبٌ","ولا حمدَ للمجداحِ أنْ نفحَ المِسْكُ",49,"ك",1,0],["ولا حاباك بعدَ الخُبر رأيٌ","رأى فضل اليمينِ على الشمالِ",50,"ل",1,0],["ولاحِظْني بطرفِك لا حديداً","ولا مستكرهاً فيه فلولُ",51,"ل",1,0],["ولا حمد إلّا لامرئٍ ذي قريحة","يهشُّ أخوها للتي هي أكرمُ",52,"م",1,0],["ولاحظتُهُ والخوفُ بيني وبينَهُ","كما تلحظُ الماءَ الظباءُ الحوائمُ",53,"م",1,0],["ولا حارَبتْ نفسي عليك ولا اصطفتْ","عِداكَ ولا لاءمَتُ من لا تُلائمُ",53,"م",1,0],["ولا حصونَ إذا ما آنسوا فزعاً","إلا نصالٌ مُعرّاةٌ وخِرصان",54,"ن",1,0],["ولاحٍ في القيانِ فقلتُ مَهْلاً","رُميتَ بنبلِ أوتارِ القيان",55,"ن",1,1],["وَلا حَنيني إِلى القَناني","وَ لا اِشتِياقي إِلى الظِباء",56,"ا",2,0],["وَلاحَ لي في الوَرَقِ","مُنطَرِحاً في الأَرضِ قُدّامي",57,"ي",1,0],["وَلا حَسَنٌ في ناظِرَيَّ وَقَلَّما","فَتَحتَهُما مِن قَبلُ إِلّا عَلى حُسنِ",58,"ن",1,0],["ولا حجارتنا تحكى قنابلهم","كلاّ ولا عندنا علم وتمهيد",59,"د",1,0],["ولا حطَمت لك الأيام نابا","ولا غضّت لك الدنيا صباحا",60,"ح",2,0],["ولاح لي من زماني مظهر كذب","حتى رميت على عُبَّاده الصنما",61,"م",2,0],["وَلاحِظ وَرَقَ السيرِ","وَما في وَرَقِ اللوردِ",62,"د",1,0],["وَلا حَسِبَ الحَفّارُ لِلمَوتِ بَعدَما","بَنى بِيَدَيهِ القَبرَ أَلفَ حِسابِ",63,"ب",1,0],["وَلا حَوى السَعدُ أَطغى في أَعِنَّتِهِ","مِنّا جِياداً وَلا أَرحى مَيادينا",64,"ن",2,0],["وَلا حُمِّلَت نَفسٌ هَوىً لِبِلادِها","كَنَفسِيَ في فِعلي وَفي نَفَثاتي",65,"ي",1,0],["وَلاحَت بِآفاقِ العَدُوِّ سَرِيَّةٌ","فَوارِسُ تَبدو تارَةً وَتُحَجَّبُ",66,"ب",1,0],["ولاحَتِ الأَنْوارُ مِنْهُ السّاطِعَهْ","وَصَفَّ أَمْلاكَ السّماءِ السّابِعَهْ",67,"ه",1,0],["ولا حَبَابٌ صَلَتَانُ السُّرَى","أَرْقَمُ لا يَعْرِفُ ما يَجْهَلُ",68,"ل",1,0],["وَلاحَ لَها صَوَرٌ وَالصَباحَ","وَلاحَ الشَغورُ لَها وَالضُحى",69,"ا",1,0],["وَلاحَ بَرقُكَ لي مِن عارِضَي مَلِكٍ","ما يَسقُطُ الغَيثُ إِلّا حَيثُ يَبتَسِمُ",70,"م",1,0],["ولاحَ لنا من خِلال الخُطوبِ","كما أخلصَ القُضُبُ اللُمَّعُ",71,"ع",1,0],["وَلا حَمَدنا في اِمرِئٍ خَلَّةً","إِلّا وَفيهِ مِثلُها عَشرُ",72,"ر",1,0],["وَلا حاتِماً أَزمانَ لَو شاءَ حاتِمٌ","مِنَ المالِ وَالأَنعامِ كانَ لَهُ وَفرُ",73,"ر",1,1],["وَلاحِقَةُ الآطالِ جُردٌ مُتونُها","تَبُذُّ هَواديها يَدَي كُلِّ مُلجِمِ",74,"م",1,0],["ولاح هلال الفطر نضوا كأنه","سنان لواه الطعن في رأس عامل",75,"ل",1,0],["ولاحَ على الكاساتِ فاضِلهُا كما","تَلوحُ على حُمْرِ الخُدُودِ السَّوالِفُ",76,"ف",1,0],["ولاحَ لنا الهلالُ كشَطْرِ طَوْقٍ","على لبَّاتِ زَرْقاءِ اللِّباسِ",77,"س",1,0],["ولاحَ للعينِ نارَنْجٌ كما اختَضبَتْ","بالزَّعفرانِ ثُدِيُّ النُّهَّدِ الغِيدِ",78,"د",1,0],["ولاحَ لنا نَهْجٌ خَفِيٌّ كأنَّه","إذا اطَّرَدَتْ أثناؤُه حيَّةٌ تَسعى",79,"ا",1,0],["وَلاحَ لِلَحظِ الصَحبِ ساطِعُ نورِها","فَقَد أُشرِكَت فيها حَواسِهُمُ الخَمسُ",80,"س",1,0],["وَلا حُلتُ إِن قاطَعتُمُ أَو وَصَلتُمُ","وَلَكِنَّني راضٍ بِما قَد فَعَلتُمُ",81,"م",1,0],["وَلاحَ لي مِن أَماراتِ الجَمالِ بِهِ","ما كانَ عَن لَحظِ غَيري بِالخُمولِ خَفي",82,"ف",2,0],["وَلاحَ كَالصارِم