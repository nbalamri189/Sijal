اً وَزُمَر",104,"ر",1,0],["وَلاحَتِ الشَعرى وَجَوزاؤُها","كَمِثلِ زُجٍّ جَرَّهُ رامِحُ",105,"ح",1,0],["وَلاحٍ لَحاني كَي يَجيءَ بِبِدعَةٍ","وَتِلكَ لَعَمري خُطَّةٌ لا أُطيقُها",106,"ق",3,1],["وَلا حَدا قَطُّ أَبي","خَلفَ بَعيرٍ جَرِبِ",107,"ب",1,0],["وَلاحَت وَماءُ الأَزرَقَينِ عَشِيَّةً","أَناقيعُ تَعفوها نُسورٌ وَأَذأُبُ",108,"ب",1,0],["وَلا حَلَّ سَرِيَّ قَطُّ في أُذنِ سامِعٍ","وَشِنفاهُ أَو قُرطاهُ يَستَمِعانِ",109,"ن",1,0],["ولاحَتْ مِن بُرُوجِ البَدرِ بُعْداً","بُدورُ مَهاً تَبَرّجُها اكْتِنانُ",110,"ن",1,0],["ولاحتْ لها نارٌ يُشَبّ وَقودُها","لأضْيافِهِ في كلّ غَوْرٍ وفَدْفَدِ",111,"د",1,0],["وَلاحَ بِها تَبَسُّمُ واضِحاتٍ","يَزينُ صَفائِحَ الحورِ القِلاصِ",112,"ص",1,0],["وَلا حكم إلا للأسنة وَالظُبى","وَللنار فهي اليوم تنهى وتأمر",113,"ر",1,0],["ولاح برقك لي من عارضَيْ ملكٍ","ما يسقط الغيث إلاّ حين يبتسم",114,"م",1,0],["ولاحت بمرأىً لعينيْ فتىً","طوى البحرَ ليس لهُ من قرارْ",115,"ر",1,0],["ولا حَبَتِ الفنَّانَ آياتِ فنِّه","ولا رُزِقَ الإبداع من نفحاتِها",116,"ت",3,0],["ولاحَ هِلالُ مِثلُ نُونٍ أجادَها","بجاري النَّضَارِ الكاتبُ ابنُ هِلال",117,"ل",1,0],["ولا حنوّ كحنوّ الجدّ","ورب عمٍّ من هبات الجدّ",118,"د",1,0],["وَلا حَطَمَت لَكَ الأَيّامُ ناباً","وَلا غَضَّت لَكَ الدُنيا صِياحا",119,"ح",2,0],["وَلَأَحمِيَنَّ النَفسَ عَن شَهَواتِها","حَتّى أَرى ذا ذِمَّةٍ وَوَفاءِ",120,"ا",2,0],["وَلاحَ خَيْطُ الْفَجْرِ فِي سُحْرَةٍ","كَصَارِمٍ فِي قَسْطَلٍ جُرِّدَا",121,"د",2,0],["وَلا حَمَلَتْ دِرْعِي كُمَيْتٌ طِمِرَّةٌ","وَلا دارَ في كَفِّي سِنانٌ مُذَرَّبُ",122,"ب",1,0],["وَلاحَ طَالِعُ سَعْدٍ","يُمِيطُ تِلْكَ السدْفَهْ",123,"ف",2,0],["وَلاَ حِرْصُ أَحْنَى الوَالِدَاتِ عَلَى ابْنِهَا","وَلاَ جُهْدُ أَوْفَى بَرَّةٍ فِي الْعقَائِلِ",124,"ل",1,0],["وَلا حَولَ إِلّا بِالإلهِ وَقُوَّةً","بِهِ مِن كَلامٍ طَيِّبٍ حُمل العَرشِ",125,"ش",1,0],["وَلاَ حَوَتْه الأمُّ في صَدْرِها","ولا أبٌ ناغاهُ في حِجْرِه",126,"ر",2,0],["ولا حيَّ إلا راح يمسك جنبهُ","ولا قلبَ إلا خلته صار داميا",127,"ي",2,0],["ولا حل في قلبي لغيرك خضرة","ولا استحسنت عيناي بعدك إنسانا",128,"ن",2,0],["ولاحت على وجه العلاء كآبة","فقطب من بعد الطلاقة والبشر",129,"ر",1,0],["ولاحت لنا من بشره ونواله","سحاب هوام أو شموس طوالع",130,"ع",1,0],["ولاحَ له \" الاسكندرُ \" الصِّدْقُ فانثنتْ","تُزَيَّفُ منه النفسُ إسكندراً كذِِبْا",131,"ب",2,0],["ولاحَت بَريقاً وُقيتِ الصِبا","وعادت رَماداً فلن تَسْطعا",132,"ع",2,0],["ولاحَ \" اللُّدُّ \" مُنبسِطاً عليهِ","مِن الزَهَراتِ يانِعةً خِضاب",133,"ب",1,0],["وَلاَ حَمِدْنَا في امرِىءٍ خُلّةً،","إلاّ وَفيهِ مِثْلَهَا عَشْرُ",134,"ر",1,0],["ولا حبٍ كحصيرِ الراملات ترى","من المطيِّ على حافاته نَطِفا",135,"ف",2,0]]}