{"poems":[[102,"خير ما في القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=50388",""],[186,"جهد الحزين إذا صرف القضا نزلا","https://www.aldiwan.net/poem67038.html","البسيط"],[275,"القلب حصن حصين","https://www.aldiwan.net/poem35467.html","المجتث"],[358,"ألا هل لقلب عنك قد فقد الصبرا","https://www.aldiwan.net/poem40238.html","الطويل"],[371,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[449,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49945","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125372","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124776","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124773","الطويل"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139805",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93647","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100309","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100779","المتقارب"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130097","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116864","المتقارب"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107531","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66154","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""]],"verses":[["ويا ثياباً ماشياتٍ على","مَشَاجِبٍ تَفتَرُّ فيها النُّدوب",0,"ب",1,0],["وَيا ثِقالَ الغَوادي جاوِري حَرَماً","مُكرَّماً فيهِ ذاكَ البَدرُ قَد أَفَلا",1,"ل",2,0],["ويا ثغوراً كآلٍ","فيهِ اللّهيبُ كمين",2,"ن",1,0],["وَيا ثَغر بَيروت تَعزَّ فَقَلّما","نَراك سُروراً بَعدَهُ باسِماً ثَغرا",3,"ر",2,0],["وَيا ثُكلَ الجُفونِ جَفا كَراها","وَيا هَمَّ القُلوبِ مِنَ السُرورِ",4,"ر",1,0],["ويا ثقيلا حلا ومرتحلا","اصبحت مثل القذاة في الحدق",5,"ق",1,0],["ويا ثاوياً في القَبر يا ابنَ معمرٍ","لك الله من ثاوٍ وقُدَّس من لَحْدِ",6,"د",1,0],["ويا ثاوياً لما نعوهُ لواضحِ ال","نهارِ توارى ضوؤُهُ فهو مُظلِمُ",7,"م",1,0],["ويأثم في إضرار نفس وعيله","ومطل غريم في التقاضي ملدّد",8,"د",1,0],["ويأثم ذو الإعسار في جحد دينه","ولم يستحق الأخذ إن يول تسعد",9,"د",1,0],["ويا ثاكل الليث الشهيد تصبراً","وكن واثقاً بالأجر من خير راحم",10,"م",1,0],["وَيا ثَراه إِلا باهي السَماء بِهِ","فَفيك أَضوء مِن أَقمارها وَضَعوا",11,"ع",3,0],["ويا ثلمة الثغر المخوف بخرقها","فما بعده انسدَّت ثغورٌ لأمصار",12,"ر",1,0],["ويا ثاقب الرأي عش أعزبا","اذا كنت للنصح بالقابل",13,"ل",1,0],["ويا ثغر كم من معهدٍ فيك أثمَرَت","شُجيراته لمّا بدا الغيث ينزلُ",14,"ل",1,0],["ويَا ثاوياً حَصباءُ مَثواهُ جوهَرٌ","وَعيدانُه عُودٌ وتُربَتُه طيبُ",15,"ب",1,0],["ويا ثامن الخلفاء الذين","حيوا بمساعيه بعد المماتِ",16,"ت",1,0],["ويا ثرىً قد حوى مرادا","فخراً وتيهاً على الثريا",17,"ي",2,0],["وياثِرُ الجَهْدَ لادْراكِ العُلا","عَلَى هَنْيءِ العَيْشِ في خِصْبِ الرُّبا",18,"ا",1,0],["ويا ثغورَ الأقاحِ فابتسمي","ويا عيونَ الرياضِ فارتقبي",19,"ب",2,0],["ويا ثاوياً في مرقدٍ ودت العلى","على تربه تحنو من الشوق أضلعا",20,"ع",2,0],["ويا ثغره مالي أذوقك باردا","فيزداج ما بي من صدى وأوار",21,"ر",1,0],["ويا ثغرَها.. يا إلهي","عبيدُكَ ليسوا حَجَرْ!",22,"ر",1,0]]}