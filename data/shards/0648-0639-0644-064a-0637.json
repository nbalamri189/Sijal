{"poems":[[88,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[72,"رق في الجو النسيم","https://www.aldiwan.net/poem42713.html","مجزوء الرمل"],[69,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[466,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[505,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18208","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94309","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93909","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62872","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85196","الرمل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5539,"على الله","https://www.poetsgate.com/ViewPoem.aspx?id=199247",""],[5626,"بغدادُ جودي","https://www.poetsgate.com/ViewPoem.aspx?id=189487",""],[5804,"على الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=180094",""],[5984,"لهف نفسي على الغزال الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=200379",""],[6124,"بساط الحرير","https://www.poetsgate.com/ViewPoem.aspx?id=194296",""]],"verses":[["وَعَلى طَبيبَيكِ اللَذَينِ رَماهُما","رامي المَنونِ تَحِيَّةٌ وَسَلامُ",0,"م",1,0],["وَعَلى طينَتِها مِن","سالِفِ الدَهرِ خُتومُ",1,"م",1,0],["وَعَلَى طُولِ طَواها حُرِمَتْ","عُشْبَهَا المُخْضَرَّ والماءَ المَعِينا",2,"ن",2,0],["وعلى طريق المجد من فالوجةٍ","مهجٌ حوائمُ في التراب وجيبها",3,"ب",3,0],["وَعَلَيَّ طِمرٌ لَو هَفَت","ريحُ الشَمالِ بِهِ لَذاب",4,"ب",1,0],["وعلى طِرْفٍ سبوقٍ في العُلى","عَقلوهُ عنْ مَداهُ بِعقالِ",5,"ل",1,0],["وعلى طَوْرِ المَعاني الوارِداتْ","قمْ لأَرْبابِ النُّهى بالعَجَبِ",6,"ب",1,0],["وَعَلى طَيبَةَ الَّتي بارَكَ اللَ","هُ عَلَيها بِخاتَمِ الأَنبِياءِ",7,"ا",2,1],["وعلى طه صلاة بالشذا","خصت الآل وعمت صحبه",8,"ب",2,0],["وعلى طه صلاة","بشذاها الكون عاطر",9,"ر",1,0],["وعلى طائرِ السعادةِ والاق","بالِ يَغْتَرُّ بابُك المعمورُ",10,"ر",1,0],["وعلى طه الشفيق المرتجي","صلوات دونها طول الدهور",11,"ر",1,0],["وعلى طرف الزهر غض جفونه","وحنت عليّ البانة الهيفاء",12,"ا",2,0],["وعليُّ طوَّق خالداً إذ جاءه","يبدو النفاق وفي يديه عمود",13,"د",1,0],["وعلٍ يطير النار من أظلافه","ببطون سهلٍ أومتون عزاز",14,"ز",1,0],["وعلى طاري هل الفزعات والماضي بلاتزييف تزييف","يفيض الدمع مادام الفكر منها يقربنا",15,"ن",2,0],["وَعَلى طَريقِ المَوتِ ذالَ كَبيرُهُم","الطِّفْلُ يَشدو والنِّساءُ تُكَبِّرُ",16,"ر",1,0],["وعلى طائرةٍ رُكَّابُها","سرحوا فيها بأحلامِ المُنى",17,"ا",1,0],["وعلى طبعه فداء له أه","لى ومالي ومعشري وعشيري",18,"ر",2,0],["وَعَلَى طَرِيْقٍ مُسْتَحِيْلِ","قَدْ يَأْذَنُوْنَ لِغَيْرِ قَلْبِيْ",19,"ي",1,0]]}