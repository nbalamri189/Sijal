{"poems":[[88,"أتيت سوق عكاظ","https://www.aldiwan.net/poem68903.html","المجتث"],[64,"أجساد صنعتنا مركبة","https://www.aldiwan.net/poem52142.html","أحذ الكامل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[104,"أجسادهم في تربة الأوطان","https://www.aldiwan.net/poem33053.html","الكامل"],[54,"ومحرق طاقين من سبج","https://www.aldiwan.net/poem27175.html","الكامل"],[48,"أجسما فيه هذي الروح هلا","https://www.aldiwan.net/poem23354.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55089","السريع"],[439,"عظم المصاب وعمت الأكدار","https://www.aldiwan.net/poem811.html",""],[505,"قف بدر نعمان وضاحا بمنزلة","https://www.aldiwan.net/poem37701.html","البسيط"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[572,"تقول وعانقتني يوم بين","https://www.aldiwan.net/poem69498.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77634","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145810","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50007","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77816","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66277","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104758","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27935","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27834","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202597","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127006","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66610","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119431","الرجز"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4734,"خيل من الرشقات","https://www.poetsgate.com/ViewPoem.aspx?id=50220",""],[4767,"فعل الضباع","https://www.poetsgate.com/ViewPoem.aspx?id=178912",""],[4929,"عربن الأسد","https://www.poetsgate.com/ViewPoem.aspx?id=202695",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""],[5038,"أيّها الشّهداء","https://www.poetsgate.com/ViewPoem.aspx?id=190077",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5212,"ربّانُ عشق","https://www.poetsgate.com/ViewPoem.aspx?id=212024",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5652,"سلمان الحزم","https://www.poetsgate.com/ViewPoem.aspx?id=177387",""],[5848,"البرتقاله","https://www.poetsgate.com/ViewPoem.aspx?id=53334",""],[5851,"سفيرة ورسالتها الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175291",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[5956,"رحلتْ إلى الرحمن زوجة عبد الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=215612",""],[6189,"شهادة حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83554&r=&rc=21",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""]],"verses":[["أَجسادُ أَملاكِ مِصرٍ","وَشائِدي مَنفيسِ",0,"س",1,0],["أجساد صنعتنا مركّبة","ذكرانها وإناثها فِرَقُ",1,"ق",1,1],["أجسُ يقظانَ أطرافي أعالجها","مما تحرَّقت في نومي بأتُون",2,"ن",1,0],["أجسادهمْ في تربة الأوطانِ","أرواُحهُم في جنَّةِ الرّضْوانِ",3,"ن",1,1],["أَجسامُنا بِالسُقمِ قَد فَنِيَت","فَسَلوا مَحاسِنَهُ عَنِ المُهَجِ",4,"ج",1,0],["أَجِسماً فيهِ هَذي الروحُ هَلّا","غَبَطتَ لِفَقدِها الأَلَمَ السِلاما",5,"م",2,1],["اجسروا أيها الرفاق فما نا","ل بعيدَ الآمال إلا الجسور",6,"ر",1,0],["أَجْسُرُ أَنْ أُهْدِيَ أُلْعُوبَةً","مَأْثُورَةً فِي تَسلِيَاتِ المُلوكْ",7,"ك",1,1],["أجسامنا للحادثات منابر","والموت فيها واعظ شهّارُ",8,"ر",1,0],["أجسامنا رقصت لما طلعت وكم","إليك قد رفصت بالوجد أرواح",9,"ح",1,0],["أجسامُهم للثَّرَى تُعطَى وأنفُسُهم","للهِ والمالُ للأعقابِ في القِسَمِ",10,"م",1,0],["أَجِسْمُكَ ذَا خَيَالٌ زَارَ جِسْمِي","فَقَلْتُ نَعَمْ وَوَصْلُكِ كَالْمَنَامِ",11,"م",1,0],["أجسامهن اللدن عند الإنثنا","تسبي العقول وكم سبتها الخود",12,"د",1,0],["أَجسام آدم فيها الجنّ قَد سَكَنَت","في كُلِّ جسمٍ أُربِّيهِ وَهيَ جَلَدي",13,"د",2,0],["أجسَادُنَا نتَف ٌأعمارُنَا نتَف","أحلامُنا نتَف ٌأسماؤُنَا نتَفُ",14,"ف",1,0],["أجسّمه سيْرَ الهَواجر والسُّرى","له خَذَيانٌ تارة وذَميلُ",15,"ل",1,0],["أَجسادهن من الكافور خالطها","مسك وَعنبر قدس صنع قدوس",16,"س",1,0],["أجسم يزيد في الحشايا منعمٌ","وجسم حسين في الصعيد نواعمه",17,"م",2,0],["أجسادُهم شهدَت بقوَّةِ عزمهم","وثباتهم وبحدَّةِ الأذهَانِ",18,"ن",1,0],["أجسامُهُم بِضِياءِ اللهِ مُشرِقَةٌ","وَبالعُيُونِ جَمالَ الحِبِّ شَهِدُوا",19,"د",3,0],["أجسامهم هي أجسادٌ ممثلةٌ","للناظرين وهم في العين إنسان",20,"ن",1,0],["أجسامُ كلِّ رسولٍ مصطفى نَدسْ","له المكانةُ والزُّلفى بلا محن",21,"ن",1,0],["أجسامهم تحيى بأعصر ذرة","وعقولهم تحيى بعصر ثمود",22,"د",1,0],["اجسامهم ان ترى تعجبك صورتها","اسرارها مثل خشب من كلامهم",23,"م",1,0],["أجسامُهم للخامعاتِ وهامُهم","للمضرحيةِ والغرابِ الحاجِلِ",24,"ل",1,0],["أجسمك قد أضناه بالشوق لملع","ومنك انحنت في منحنى الجزع أضلع",25,"ع",1,1],["أَجْسامُهُمْ كَالمَاءِ إلاَّ أَنَّها","حَمَلَتْ قُلُوباً مِن صَفَا الجُلْمُودِ",26,"د",1,0],["أجسم هكطور آخيلٌ رمى قطعاً","للغضف أم قرب تلك الفلك لم يزل",27,"ل",1,0],["أجسام صخر دفنت في صخر","تناسبا واختلفا في النجر",28,"ر",1,1],["أجسامهم تعجب الفرسان منظرها","والقول يُسمع والأكباد في نقم",29,"م",1,0],["أجسادهم درعُ الثرى ودماؤهمْ","زيتُ القناديل ِ التي لا تفطم",30,"م",1,0],["أجسامهم تحت الثرى مَحفوظةٌ","ما مسَّها التبديدُ كالأجسام",31,"م",1,0],["أجسادُ قَتْلاك َباتَتْ للكلابِ قِرًى","إذْ قَهْقَهَ المَوتُ في أدبَارِهَا طرَبَا",32,"ب",2,0],["أجسادهم في ثياب من دمائهم","مسلوبة وكأن القوم ما سلبوا",33,"ب",3,0],["أجْسادُكمْ أشْلاؤها تَبْني البِلا","دَ وفي الْقُصورِ يُسافِحُ الزّعَماءُ",34,"ا",2,0],["أجسامنا كالنار، وال","أكباد للنار الحطب",35,"ب",1,0],["أجسادُ صَحْبٍ كالنّجومِ تَناثَرَتْ","والبَدرُ كافِلُ زَينَبٍ مَطبورُ",36,"ر",1,0],["أجسامهم حكت الصخور صلابةً","وكذا الغضا في الرمل أصلب عودا",37,"د",2,0],["أَجْسامُ ناسٍ حِينَ تُبْصِرُهُمْ","كالصَّادِ بَيْنَ الرَّاءِ وَالزَّاءِ",38,"ا",2,0],["اجساد تُحرق والملى له نواظير","بالصمت ناخذ ذلنا بالوزايم",39,"م",1,0],["اجسامنا متفرقه بس الارواح","متعانقه مثل الغدير وزلاله",40,"ل",2,0],["أجُسُّ تُرْبَ اغترابي يا تُرى ألقٌ؟","وأُرقص البدرَ والأحلامُ مزمارُ",41,"ر",1,0],["أَجِسمٌ ناعمٌ مِن دُونِ حِسٍّ؟","سيَيبَسُ ما الزمانُ عليه طالا",42,"ل",2,0],["أجسامنا ترجو التمازج بالثرى","بعد الضنى ممّا الجسوم تعاني",43,"ن",2,0],["أجسادنا ربما ماتت وقد بُعِثت","رفاتنا لم يزل في عمقها روح",44,"ح",1,0],["أجسادُ آباءٍ تهيبُ بنا","إن تعدِلوا راياتكمْ خُضْرُ",45,"ر",1,0]]}