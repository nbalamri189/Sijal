{"poems":[[55,"حلفت بها صيد الرؤوس سوام","https://www.aldiwan.net/poem29752.html","الطويل"],[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[65,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[0,"غشيت ديار الحي بالبكرات","https://www.aldiwan.net/poem55.html","الطويل"],[32,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[32,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[64,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[76,"لاعب تلك الريح ذاك اللهب","https://www.aldiwan.net/poem12840.html","الرجز"],[106,"شهداء","https://www.aldiwan.net/poem26158.html","عموديه"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142164","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43897","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[96,"الكعبة السمراء","https://www.poetsgate.com/ViewPoem.aspx?id=15616",""],[203,"أدرت عيونك في كل وجه","https://www.aldiwan.net/poem45182.html","المتقارب"],[214,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[463,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[469,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[519,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[580,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108628","الوافر"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93326","المديد"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58358","المتقارب"],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143539","الطويل"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4772,"آذان الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=190807",""],[4859,"نور الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=187835",""],[5887,"عانق الشوق فؤادي إذ ذكرت اليوم أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=35285",""]],"verses":[["تَلَثَّمتَ مِن فَضلِ العَفافِ عَنِ الهَوى","نَجاءً مِنَ الدُنيا أَعَزَّ لِثامِ",0,"م",1,0],["تُلَثِّمُ مَنسِمَها بِالدِماءِ","إِذا ما اِطمَأَنَّ بِقَرعِ السَلامِ",1,"م",1,0],["تَلَثَّمُ فَوقَ اللَثمِ بِالنَقعِ وَالدُجى","فَلَولا ظُباها لَم تَبِن صَفَحاتُها",2,"ت",3,0],["تُلَثِّمُهُ المَواهِبُ كلَّ يومٍ","تَمُجُّ سَماؤهُ عَلَقاً بَوفْدِ",3,"د",1,0],["تَلِثُّ الحَصى لَثّاً بِسُمرٍ رَزينَةٍ","مَوازِنَ لا كُزمٍ وَلا مَعِراتِ",4,"ت",1,0],["تَلَثَّمَ في عَصائِبَ مِن لُغامٍ","إِذا الأَعطافُ ضَرَّجَها الحَميمُ",5,"م",1,0],["تَلَثَّمَتُ فَاِستَقبَلتُهُ ثُم مِثلَهُ","وَمِثلَيهِ خِمساً وِردُهُ غَيرُ صادِرِ",6,"ر",1,0],["تَلَثَّمتُ فَاِستَقَبلتُ مِن عُنفُوانِهِ","أُوارا إِذا ما أَسهَلَ اِستَنَّ حاصِبُه",7,"ب",2,0],["تَلَثَّمَت بِالأُرجُوا","نِ وَاِرتَدَتهُ مِئزَرَه",8,"ر",2,0],["تلثَّمَتْ بقناعِ الغَرْبِ من خَجَلٍ","إِذ لم تَنَلْ بمَداها بعضَ ما فِيكا",9,"ك",2,0],["تَلثُمُ مِنهُ الريحُ خَدّاً خَجِلاً","حَيثُ الشَرارُ أَعيُنٌ تَرتَقِبُ",10,"ب",1,0],["تلثم لموت وهي تضحك بشرً","ومن لموت يهرب ُ لزعمءُ",11,"ا",1,0],["تَلَثَّمُوا ثمَّ قالوا إننا عَرَبٌ","فقلتُ لا عَرَبٌ أنتمْ وَلا حَضَرُ",12,"ر",1,0],["تلثم الموت وهي تضحك بشراً","ومن الموت يهرب الزعماء",13,"ا",2,0],["تلثم حياءً يا زمان من العلا","مَضيتَ بمعروفٍ وجِئتَ بمُنْكَرِ",14,"ر",1,0],["تلثّم بالإباءِ فعاش حرّا","ولو عرف الرياءَ لمات عبدا",15,"د",2,0],["تلثّم الأنجم من أحلامها","بالأرجوان العبق الشفيف",16,"ف",1,0],["تلثمهنَّ بلحظِ وقاحِ","ويمنعهنَّ الحياءُ السفورا",17,"ر",2,0],["تلثم بالهلال فلا عجيب","بشمس ضحى الجمال اذ تردى",18,"د",2,0],["تلثمَّ كالغمامة أعجبته","فشام خلالها برقاً فَراعهْ",19,"ع",2,0],["تَلثّمنَ بالإصباح حتى إذا وشى","بأضوائه اردفنه بالغياهب",20,"ب",1,0],["تلثّمَ بالعقيقِ على اللآلي","فغشّى الفجرَ من شفَقِ الجمالِ",21,"ل",1,1],["تَلثَّمَ كَيْ يخْفَى علَى النّاسِ أَمرُه","فَلاحَ لنَا منْ عيْنِه عينُ أَمْردِ",22,"د",1,0],["تلثم خدها ذوب الدراري","نهار عتابها لفراق داري",23,"ر",2,1],["تلثمُ الأَوتارُ مِنها بناناً","يَعدِلُ الأَفواه إِلا الرضابا",24,"ب",2,1],["تَلَثّمَ لمّا بَدا بالهلالِ","وَمن شَعْرِهِ بالدُّجى شرْبَشا",25,"ش",2,0],["تلثم مرتاباً بفضل ردائه","فقلت هلالاً بعد بدر تمام",26,"م",1,0],["تلثم بدر التم بالمزن طالعا","فأزرى بذاك البدر منك التلثم",27,"م",1,0],["تلثمُ الأكفانَ في كفَِ الهوى","يا فؤادي ذا الهوى قد شيّعك",28,"ك",1,0],["تلثم الحسن في نواعم زهرٍ","ترشف السعد من رحيق الأقاحي",29,"ي",1,0],["تلثم الوجه بشوق","من صفاء يتورد",30,"د",1,0]]}