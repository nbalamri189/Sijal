{"poems":[[164,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[275,"صحيفة وجهها إنجيل رهط","https://www.aldiwan.net/poem35017.html","الوافر"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77491","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77650","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125471","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89176","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132087","الطويل"],[4984,"الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=196950",""],[5843,"موت طازج","https://www.poetsgate.com/ViewPoem.aspx?id=51285",""]],"verses":[["فأرصد الله هذي الشهب تحفظها","فها هي اليوم في أدبارهم رجم",0,"م",1,0],["فأرصدُ من محيَّاها نجوماً","وأقرأ فيهِ ترجمةَ المجسطي",1,"ط",2,0],["فَأُرْصُدْ بعينِ العقل أبوابَها تَفُزْ","وإن جزتَ ذا حَزمٍ بأطلالها لَبِّ",2,"ب",1,0],["فأُرْصِدَ هَذَا لِحُرٍّ كريمٍ","وأُسْبِلَ ذا طَمَعاً فِي الشِّفاءِ",3,"ا",2,0],["فَأرٌ صَغير ما عَثرتُ باسمهِ","لَكن سَمِعتُهُ حَكى لِأُمه",4,"ه",1,1],["فَأَرٌ صَغيرٌ ليس أَهل تجربه","أَمسكه قطٌّ عَجوزُ شهربه",5,"ه",1,1],["فأرصدت العيون بكل فخٍ","مزودةً بألسنةِ الخطوبَ",6,"ب",1,0],["فأرصد كنزاً من عقيق مدامعي","ورصَّع ياقوتَ المباسم بالدرِّ",7,"ر",1,0],["فأرصف من قطر الندى حكمي لهم","وأنظم أشعاري من النسماتِ",8,"ت",1,0],["فأرصد ما أرى حينا","على عجل من النظرة",9,"ر",2,0],["ف ارصفته اتخيل الشباك مدهول","ويقول بندر: ياعبدالله وش الفال؟",10,"ل",1,0],["ف ارصفته اشم ريحة موت مقتول!","والقاتل الحب ! ليت الحب رجال!",10,"ل",1,0]]}