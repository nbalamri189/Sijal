{"poems":[[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"أقول لسائلي بك يا ابن يحيى","https://www.aldiwan.net/poem61900.html","الوافر"],[53,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[68,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"إذا طلع النسران غارت ظعائن","https://www.aldiwan.net/poem22825.html","الطويل"],[8,"تأبد من ليلى رماح فعاذب","https://www.aldiwan.net/poem21765.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21045","الوافر"],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[102,"أغنية من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=50378",""],[119,"قد حرت مذ رمشت عيناك بالحور","https://www.aldiwan.net/poem41105.html","عموديه"],[136,"بالسب من يدعى ما ليس فيه حر","https://www.aldiwan.net/poem54822.html","البسيط"],[164,"على غيرك البهتان والزور ينفق","https://www.aldiwan.net/poem58945.html","الطويل"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[173,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[228,"لقد مر بي أمس بالصدفة","https://www.aldiwan.net/poem41637.html","المتقارب"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[314,"ولم يمرر به يوم فظيع","https://www.aldiwan.net/poem50239.html","الوافر"],[354,"هم المنى والأمل","https://www.aldiwan.net/poem15858.html","مجزوء الرجز"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[438,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[473,"إذا تثاقل عتب","https://www.aldiwan.net/poem59976.html","المجتث"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[541,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[581,"خليلي إما مت يوما وزحزحت","https://www.aldiwan.net/poem1781.html","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72267","الطويل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29611","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64671","الوافر"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101430","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33854","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99073","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93381","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205020","السريع"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120162","الوافر"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101633","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132643","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66488","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131292",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103037","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70166","الوافر"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139381",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133129","البسيط"],[4463,"","https://poetry.dctabudhabi.ae/diwan/poem/144936","الطويل"],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[5412,"أشاعوا فقالوا وقفة ووداع","https://www.poetsgate.com/ViewPoem.aspx?id=181278",""],[5490,"بلى أشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=176368",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6093,"سؤال يبحث عن جواب","https://www.poetsgate.com/ViewPoem.aspx?id=204280",""],[6251,"الأرقم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76494&r=&rc=34",""]],"verses":[["ولم يمشِ قيدَ الشبرِ إلا وفوقه","عصائبُ طيرٍ تهتدي بعصائبِ",0,"ب",1,0],["ولم يمطل جوادٌ قَطُّ إلا","أتاك حِبَاؤه ضخم السَّوادِ",1,"د",1,0],["ولم يُمادِ الخَطَراتِ الهُجَّسا","خوفاً على أدوائه أن تُنْكَسا",2,"س",2,0],["وَلَم يُمَهِّد لِلمُلكِ قاعِدَةً","بِها عُيونُ العُقولِ تَحتَلِمُ",3,"م",1,0],["وَلَمْ يمشِ في نَعْلٍ وَلا وَطِئَ الثَّرَى","شَبِيهٌ لَهُ في العالَمِينَ وَلا ندُّ",4,"د",1,0],["وَلَم يَمنَعوا بِالضَربِ وَالطَعنِ حادِثاً","أَتى دونَ أَدراعٍ لَهُم وَتِراسِ",5,"س",1,0],["وَلَم يُمسِ بِالسيدانِ نَبحٌ لِسامِعٍ","وَلاَ ضَوءُ نارٍ إِن تَنَوَّرَ راكِبُ",6,"ب",1,0],["ولَم يَمنَعهُ تَدبيرٌ وحَزمٌ","مِنَ الَموتِ الُمَنغِّص للسُّرور",7,"ر",1,0],["ولم يمرُرْ به إلا حطامٌ","يطير من النَّيازك أو نثَار؟",8,"ر",1,0],["ولم يمض شيء يسمّى غريبا","ولم يأت شيء يسمّى عجب",9,"ب",1,0],["ولم يمل بنسيم عاطر غصن","الا وخصرك يبدى الميل في فكري",10,"ر",2,0],["ولم يُمَيِّز جَوهَراً إن قِيلَ مِن عَرَضٍ","ولَم يُمَيِّز صُوراً في اللفظ مِن سُوَرِ",11,"ر",1,0],["ولم يمش تمويه يموهة الفتى","عليه ولا قول المحال الملفق",12,"ق",1,0],["وَلَم يَمُت مَن أَبو شُكرٍ خَليفَتُهُ","المخجِلُ البَدرَ وَالمُزري عَلى السُّحبِ",13,"ب",1,0],["وَلَم يَمُدَّ إِلى هَرمُوزَ مِنهُ يَداً","وَحاركٌ لَم يَمُدُّوا كَفَّ مُعتَصِمِ",14,"م",1,0],["وَلم يَمضِ يَومانِ حَتّى ذَبلتُ","فَأُسقِطتُ صَفراءَ كَالميتَةِ",15,"ه",1,0],["ولم يَمضِ بي الدهرُ صَفْحاً ولا","غدا ملءَ عينيَّ منه قَذَى",16,"ا",1,0],["وَلَم يَمرُر بِهِ يَومٌ فَظيعٌ","أَشَدُّ عَلَيهِ مِن يَومِ الحِمامِ",17,"م",1,1],["وَلَم يَمَل بي عَنهُم","مِمّا أُلاقي المَلَلُ",18,"ل",1,0],["وَلَم يُمحِل رِيَاضُ بَنَاتِ فِكرٍ","وَمَاءُ أبِي الرَّبيعِ لَهَا رَبِيعُ",19,"ع",1,0],["ولَمى مراشفِهِ وخالُ خُدودِه","وأحمُّ فَوْدَيْهِ وسرُّ جَنانِه",20,"ن",2,0],["ولم يمللْ مديحكُمُ لساني","فكيف مللْتُمُ من طول عمري",21,"ر",2,0],["وَلَم يَمِل بي جُحودٌ","عَن واجِبِ الإِقرارِ",22,"ر",1,0],["ولم يمرر بقلبي طيف جبن","ولم تجر الدموع على كلامي",23,"م",2,0],["وَلَم يَمنَحوا الأَعداءَ إِلّا مُقَوَّماً","أَصَمَّ رُدَينِيّاً وَعَضباً مُذَكَّرا",24,"ر",2,0],["وَلَم يَمض إِلّا بالشَّواة عن الشّوى","وَلم يرضَ إلّا بالطُّلى والذوائبِ",25,"ب",1,0],["وَلَم يَمدَحِ القَرمَ الهُمامَ بِكَفِّهِ","لَطائِمُ يُسقَى مِن فَواضِلِها القَفرُ",26,"ر",1,0],["ولم يمنعوا هتك الحريم وسبيهم","وهن يجدن الأرض بالعبرات",27,"ت",1,0],["وَلَم يَمُت مَن صَفِيُّ الدِينِ وارِثهُ","إِنَّ الغُصونَ لَقَد تُنمى عَلى الشَجَرِ",28,"ر",1,0],["ولم يَمْلِكْ عليَّ لُبابَ مَدْحي","سِوى محمودٍ الملكِ اللُّبابِ",29,"ب",1,0],["ولم يمل بفؤادي عن محبتكم","عذل لأن فؤادي الدهر ما خانا",30,"ن",2,0],["وَلَم يُمَنِّ التُقاةَ المُؤمِنينَ بِها","وَلا جَرَت مِن جِنانِ الخُلدِ في نَهَرِ",31,"ر",1,0],["وَلَمْ يَمُرَّ لهُ شَخصٌ على بَصَرِي","لكنْ أَحاديثُهُ مَرَّتْ على أُذُني",32,"ن",2,0],["وَلَم يَمضِ بَينَ الدارِعينَ سِنانُهُ","وَيَستَنَّ في أَعراضِهِم وَهوَ حاسِرُ",33,"ر",1,0],["ولم يمتحنهم كي يحيط بعلمهم","عليم تساوى عنده السرُّ والجهر",34,"ر",1,0],["ولم يمد إلى رأس على طرب","يديه إلا وفي اليمنى تطاريف",35,"ف",1,0],["وَلَم يمنَع مسيلٌ عَن مسيلٍ","وَكادَ الجرح يُرغبُ في اِنتِجاعي",36,"ع",2,0],["ولم يمد اللص كفا الى","شعري أو در به زاخر",37,"ر",1,0],["ولم يمنعك مما رمت نثر","ولا شعر ولا حسنُ ابتداع",38,"ع",1,0],["ولم يمض حينٌ فاستفقت بغصة","أرى ما رأيت الآن أوهام مغتر",39,"ر",1,0],["ولم يمت من كان ذكر فضله","حياً ومن سليل عبد الرضا",40,"ض",2,0],["ولم يمنع وصولي في سماطٍ","وحولٌ لن تسير به المطايا",41,"ا",3,0],["ولم يمنعوا غاداتهم من تهتك","فشأن ذوات الخدر شأن الوصائف",42,"ف",1,0],["ولم يمت الذي يتلوه شهم","يقرب للعلى نهج البعاد",43,"د",1,0],["ولم يمسهم من الضر سوى","أن القتيل ظل في أيدي العدى",44,"د",2,0],["وَلَم يَمنع شَجيّاً قَد تَعنى","اموراً مِن هموم الدَهر أَنّا",45,"ن",2,0],["ولم يملك الآسونَ دفعاً لمهجةٍ","عليها لإشراك المنون رقيبُ",46,"ب",1,0],["ولم يمت قبل انقضا عمرٍ أحد","وما سوى الروح وعجبٌ فاني",47,"ن",2,0],["ولم يمت أحدٌ قبل انقضا أجلٍ","والجسمُ يبلى سوى مستنشأ البشر",48,"ر",1,0],["ولم يمض في وجه من الأرض واسعٍ","من الناس إلا ضاق عنه فضاؤه",49,"ا",3,0],["ولم يمت من له علم كعلمك أو","ذكر كذكرك مهما مات جثمان",50,"ن",1,0],["ولم يملك الكتمان قلب ملكته","وعند النوى سر الكتوم مذاع",51,"ع",1,0],["ولم يمسس وفائيَ أيُّ شينٍ","وما استعديتُ روحاً أو جَنانا",52,"ن",2,0],["ولم يمض عصر إلا تقفوه أعصر","مشعشعة بالنور منك وبعثتي",53,"ت",2,0],["ولم يمض جيل إلا بشر قومه","بك الأنبيا والمرسلون وأبقت",53,"ت",1,0],["ولم يملكْ فؤاديْ في نقاشٍ","كدمعٍ جاء في دَرَجِ العتابِ",54,"ب",1,0],["ولم يمشِ فوق الأرض رجسٌ معطر","ولم تشهد الدنيا وباءً معقما",55,"م",2,0]]}