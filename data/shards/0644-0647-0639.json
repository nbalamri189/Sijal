an/poem/94403","البسيط"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33085","الطويل"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130536","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81686","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58015","الطويل"],[308,"","https://poetry.dctabudhabi.ae/diwan/poem/145002","البسيط"],[4508,"","https://poetry.dctabudhabi.ae/diwan/poem/146834","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72467","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72426","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139530",""],[416,"تَخَيَّرْتُ لِلْمَدْحِ ابنَ يَحْيَى بن خَالِد","https://www.poetsgate.com/ViewPoem.aspx?id=22363",""],[4767,"مشهد","https://www.poetsgate.com/ViewPoem.aspx?id=179800",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[2365,"أشاقك طائر غرد","https://www.poetsgate.com/ViewPoem.aspx?id=200645",""],[308,"أجوهر أم كَلَام","https://www.poetsgate.com/ViewPoem.aspx?id=189198",""],[5338,"لطيبة الغراء شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=187891",""],[5413,"إنا بفراقكما لمحزونون","https://www.poetsgate.com/ViewPoem.aspx?id=208634",""],[5582,"خَيالٌ سَرَى نَوْمَةَ السَّامِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187098",""],[5628,"ميادة الحناوي","https://www.poetsgate.com/ViewPoem.aspx?id=180395",""],[5742,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=206896",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[5804,"السر الخطير ( لغز )","https://www.poetsgate.com/ViewPoem.aspx?id=214755",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[6031,"إلى الملكِ الوهَّابِ ما في يمينِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46259",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[199,"طار الكرى وألم الهم فاكتنعا","https://www.poetsgate.com/ViewPoem.aspx?id=22418",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6164,"تنفيس .. وتقديس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66067&r=&rc=76",""],[240,"قُلْ لأَبِي کلنَّقْصِ وَکلْمَخَازِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26478&r=&rc=3",""],[2220,"لنا همته إن الثريا لدونها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11632&r=&rc=506",""],[572,"أَتَتْكَ ودُنيا إذا أقبلتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9448&r=&rc=305",""],[572,"روحٌ من الماءِ في جِسْمٍ مِنَ الصفَرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9301&r=&rc=158",""]],"verses":[["لَهُ عَينانِ تُبرى بِمَن","هُما لِلأَعيُنِ النَبلُ",0,"ل",1,0],["لَهُ عَبَقٌ يُغنيهِ عَن طيبِ عِرضِهِ","سُطوعاً مِنَ البانِ المَدينِيِّ وَالعِطرِ",1,"ر",1,0],["لَهُ عَن بُيوتِ الأَكرَمينَ دَوافِعٌ","وَعَن هَضَباتِ الماجِدينَ ذِيادُ",2,"د",1,0],["لهُ عِشارٌ ليسَ تُدْمى لَها","في نَدْوَةِ الحَيِّ عَواقيبُ",3,"ب",1,0],["لَهُ عِمَّةٌ لَوْثاءُ تَفْتَرُّ عنْ نُهىً","عَلِمْنا بِها أنَّ العَمائِمَ تيجانُ",4,"ن",1,0],["لَهُ عُنُقٌ تُلوي بِما وُصِلَت بِهِ","وَدَفّانِ يَشتَفّانِ كُلَّ ظِعانِ",5,"ن",1,1],["لَهُ عَلى البابِ خادِمٌ وَوَرا ال","بابِ قِحابٌ تَلقاهُ بِالرُحبِ",6,"ب",1,0],["لَهُ عَزمَةٌ مَطوِيَّةٌ في سَكينَةٍ","كَما لانَ مَتنُ السَيفِ وَاِخشَوشَنَ الحَدُّ",7,"د",1,0],["لَهُ عَهدُ وُدِّ لَم يُكَدَّر يَزينُهُ","رَدى قَولِ مَعروفٍ حَديثٍ وَمُزمِنِ",8,"ن",1,0],["لَهُ عَلَيهِنَّ بِالخَلصاءِ مَرتَعِهِ","فَالفَودّجاتِ فَجَنبَي واحِفٍ صَخَبُ",9,"ب",1,0],["لَهُ عُوَّدٌ رَأفَةً يَكتَنِفنَهُ","ولا شَفَقاً مِنها خَوَامِعُ تَعتُبُ",10,"ب",1,0],["له عاذرٌ من نفسه باجتهاده","ومبلغ نفسٍ عذرها مثل منجح",11,"ح",1,0],["له عزمات في العلى شادَوِّيةٌ","لها أبداً من كلِّ عزمٍ سديدُه",12,"د",2,0],["له على الرأيِ تنقيبٌ ومطلعٌ","وفي المقاصدِ تصويب وتصعيد",13,"د",1,0],["له على مسائل الجفون","خطّ لبعض الألفات الجون",14,"ن",1,0],["له عند إيغال الطريدة في الوغى","أَجاريُّ مضمونٌ لها دَرَكُ الطَّلْبِ",15,"ب",1,0],["له عزٌّ يُجيرُ على الليالي","ومالٌ مُستباحٌ كالنهابِ",16,"ب",1,0],["له عند الغُدُوِّ لها وفيها","حِذَار الفَوْتِ قلب مستطار",17,"ر",1,0],["له عزماتٌ ليس للسيف مِثلُها","مضاءً ولا للسيل والسيلُ مارس",18,"س",1,0],["له عِرسٌ له شركاءُ فيها","كسابلةٍ تضمُّهُمُ سبيلُ",19,"ل",1,1],["له عزماتٌ لا تُفاتُ بفرصةٍ","وفيه أَناة قبل ذاك وإمهالُ",20,"ل",1,0],["له عندَ قدْحِ الرأي من خطراته","وعند انتضاء العزم للأمرِ يدْهَمُ",21,"م",1,0],["له عزمٌ إذا نفذ ارتياءٌ","وإمضاءٌ إذا وقع اعتزامُ",22,"م",1,0],["لَهُ عُنُقٌ عاري المَحالِ وَحارِكٌ","كَلَوحِ المَحاني ذو سَناسِنَ أَفطَحُ",23,"ح",1,0],["له عيون بنور الله ناظرة","الى الامام ولا ترنو الى العقب",24,"ب",1,0],["لَهُ عَسكَراً خَيلٍ وَطَيرٍ إِذا رَمى","بِها عَسكَراً لَم يَبقَ إِلّا جَماجِمُه",25,"م",2,0],["له عندَكمْ صفحةٌ طلقَةٌ","وخدٌّ لدَى غيرِكمْ أضْرَعُ",26,"ع",1,0],["لَهُ عَزمَةٌ ما اِستَبطَأَ المُلكُ نُجحَها","وَلا اِستَعتَبَ الإِسلامَ وَريَ زِنادِها",27,"د",3,0],["لَهُ عِندَ تَجديدِ السُؤالِ طَلاقَةٌ","مُحَقَّقَةٌ بِالغَيبِ ظَنَّ المُؤَمِّلِ",28,"ل",1,0],["لَهُ عانَةٌ أَعفاؤُها آلِفاتُهُ","حُمولَتُهُ مِنها وَمِنها حَلائِلُه",29,"ل",2,0],["له على الشَّطِّ غرفةٌ جمَعَتْ","كلَّ خَليعٍ نَشا ببغداذِ",30,"ذ",1,0],["له على سَرْجِ شِعْري غارةٌ أبداً","يرتاعُ معقولُه منها وساربُه",31,"ب",2,0],["له عَزَماتٌ تَفُلُّ السيوفَ","وتَسبِقُ بالفَوْتِ شأوَ القَضاءِ",32,"ا",2,0],["له عينُ ضرغامٍ هصورٍ فقلبُهُ","بِتصريفِ فِعْلِ الجهل منه على علمِ",33,"م",1,0],["لَهُ عَمَلٌ يَستَغرِقُ القَولَ في العُلى","وكم في الوَرَى من قائلٍ غيرِ عامِلِ",34,"ل",1,0],["لَهُ عَلَى الشَّرِّ إِقْدَامٌ وَلَيْسَ لَهُ","إِلَّا عَنِ الْخَيْرِ وَالْمَعْرُوفِ إِحْجَامُ",35,"م",1,0],["لَهُ عَلَيَّ بِحُسْنِ الظَّنِّ مَأْثُرَةٌ","لا يَسْتَقِلُّ بِهَا شُكْرِي وَإِنْ جَمُلا",36,"ل",2,0],["لَهُ عَزمَةٌ لَو نَهنَهَت صارِماً نَبا","فَلَم يَمضِ أَو مَرَّت بِطَودٍ تَهَدَّما",37,"م",2,0],["لَهُ عَبرَةٌ تَهمي وَنيرانُ قَلبُهُ","وَأَجفانُهُ تُذري الدُموعَ عُيونُ",38,"ن",1,0],["له عذرُ الأمين فإنْ رَضِيتم","فخيرُ النّاسِ مَنْ عَذَر الأمينا",39,"ن",2,0],["لَهُ عَزَماتٌ ماضياتٌ متى تَرُمْ","مَراماً تَحاماها القَضاءُ المحتَّمُ",40,"م",1,0],["لَهُ عارِضٌ كَالجَيشِ تَفري سَوادَهُ","عَناجيجُ شُهبٍ خَرَّقَت مَتنُهُ رَكضا",41,"ض",2,0],["لَهُ عُنُقٌ يَغتالُ طولَ عِنانِهِ","وَصَدرٌ إِذا أَعطَيتَهُ الجَريَ سابِحُ",42,"ح",1,0],["لَهُ عَقرَبا صُدغٍ عَلى وَردِ خَدِّهِ","كَأَنَّهُما نونانِ مِن كَفِّ ماشِقِ",43,"ق",1,0],["لَهُ عَبدُ المَدانِ وَذو رُعَينٍ","كِلا خالَيهِ مُنتَخَبٌ يَماني",44,"ن",2,0],["لَهُ عُوَذٌ في كُلِّ شَرقٍ وَمَغرِبٍ","رَعاها اليَمانِيَ الدارِ وَالمُتَشائِمُ",45,"م",1,0],["لَهُ عُنُقٌ فِي كَاهِلٍ غَيرِ جَأنَبٍ","فَمَدَّ بِلَحيَيه وَنُحِّيَ مُدبِرا",46,"ر",2,0],["لَهُ عُنُقٌ في كاهِلٍ غَيرُ جَأنبٍ","وَلَجَّ بِلَحيَيهِ وَنُحِّيَ مُدبرا",47,"ر",2,0],["له على الأرض بطش","بمن به لا يدين",48,"ن",1,0],["له علّمت نفسي القول فيهم","كتعليم الطّراد بلا سنان",49,"ن",1,0],["له عسكرا خيلٍ وطيرٍ إذا رمى","بها عسكرا لم تبق إلاّ جماجمه",50,"م",2,0],["لَهُ عُنقٌ مِثلَ جِذعِ السَّحو","قِ وأُذنٌ مُصعَنَّةٌ كالقَلَم",51,"م",1,0],["له عثرة الطفل حول السرير","ودمعته البكر إذ يعول؟",52,"ل",1,0],["له على الآفاق فتح زاهر","وفي عباب الماء فتح أزهر",53,"ر",1,0],["لهُ عزمةٌ وثَّابةٌ عَلَويَّةٌ","تردُّ صُرُوفَ الدهرِ وهي حرَاب",54,"ب",1,0],["له (عبلة) في كل شبر ونسمة","وما قال إنّي (عنتر) أو تعنترا",55,"ر",2,0],["لهُ عَلَى الأملاكِ فضلٌ كما","فُضِّلَ في العالم المُرْسَلُ",56,"ل",1,0],["له عسكرُ مجرٌ من الصبرِ والتقى","يردُّ على أعقابِهِ العسكرَ المجرا",57,"ر",2,0],["لَهُ عَمَلٌ في البِرِّ وَفقَ الَّذي نَوى","لَهُ أَربَعٌ قَد حازَها لِلَّذي حَوى",58,"ح",3,0],["لَهُ عَمَلٌ في المَكرُماتِ وَنيَّةٌ","وَأَقوالُ صِدق في الإِلَهِ رَضيَّةٌ",59,"ه",1,0],["لَهُ عِزَّةُ الوالي عَلَيَّ وَتِيهُهُ","وَلي ذِلَّةُ المَعْزولِ عِنْدَ لِقائِهِ",60,"ا",3,0],["له على كل مدى همة","عذراء تجرى والصبا في عنان",61,"ن",1,0],["له عندَ نعماه ديونٌ قديمةٌ","وقد آن أن تقضي وتمضي ديونُها",62,"ن",3,0],["له على شَرفِ العلياء مرتبةٌ","منيفةٌ ذاتُ أطنابٍ وأوتادِ",63,"د",1,0],["له عِذارٌ أَثْرُهُ ظاهرٌ","للعين معدومٌ على اللَّمْسِ",64,"س",1,1],["له على كلِّ حُرٍّ مِنَّةٌ كَتبت","في وجهه لجميل الذِّكْرِ عنوانا",65,"ن",2,0],["له عنك متّجهٌ لو أراد","فلو صدّه عنك عقل عذر",66,"ر",1,0],["لَهُ عَلَيَّ أَيادٍ لَستُ أَكفُرُها","وَإِنَّما الكُفرُ أَلا تُشكَرَ النِعَمُ",67,"م",1,0],["لَهُ عَمَلٌ بِالعِلمِ يَزدادُ زينَةً","وَيا رُبَّ ذي عِلمٍ وَلَيسَ بِعَمّالِ",68,"ل",1,0],["لَهُ عَلى نَظمِهِ طَبعٌ يُساعِدُهُ","ما كُلُّ مَن قالَ شِعراً فَهوَ مَطبوعُ",69,"ع",1,0],["لَهُ عَنِ الأَرضِ وَمَن","فيها سِواكَ مُنتَدَح",70,"ح",1,0],["لَهُ عَلى زَعمِهِ مَديحٌ","أَقبَحُ عِندي مِنَ الهِجاءِ",71,"ا",2,0],["لَهُ عَلَى عُلاَكِ دَيْ","نٌ كُلُّ دَيْنٍ دُونَهْ",72,"ن",2,0],["لَه عادَتَا جُودٍ وبأسٍ أعادَتَا","عَلَى الدّين والدُّنيا نِظَام المَصالِح",73,"ح",1,0],["له عزةٌ أعلى من الشمس منزلاً","وعزمتُه أمضى من السيف منتضى",74,"ض",2,0],["له على الأردافِ شعرٌ إذا","دب عليها قلت ذا حيه",75,"ه",1,0],["له علي العهدفي تحليل ما","حلل مع تحريم ماقد حرما",76,"م",2,0],["لَهُ عَلاماتٌ عَلى حَدِّ الصُوى","أَقبَلنَ مِن مِصرَ يُبارينَ البُرى",77,"ا",1,0],["لَهُ عَنّي بِمالي فيهِ فَرقٌ","وَفيهِ مِنهُ جَمعٌ لَيسَ يَخلو",78,"ل",2,0],["له عارِضٌ فيه من الدَّمْعِ عارِض","وخَدٌّ به خَدٌّ وعَيْناهُ عَيْنان",79,"ن",1,0],["له عَقْدُ رَأيٍ بعدَه عَقْدُ رايةٍ","لِذَبِّ فَراشٍ في الهوى مُتَهافت",80,"ت",1,0],["له على رغمي كما شاء الهوى","مِني صَفا الودِّ ولي مِنه القِلَى",81,"ا",1,0],["له عند الثقا الأبطال وجدٌ","وشغل بالطعان وبالضراب",82,"ب",1,0],["لَهُ عادَةٌ أَن يَبسُطَ العَدلَ وَالنَدى","لِمَن ساسَ مِن قَحطانَ أَو مَن تَنَزَّرا",83,"ر",2,0],["له عبرات أغْرَقَتْهُ سيولها","ألَمْ تنظرِ الأَرزاء كيفَ تعدَّدَتْ",84,"ت",1,0],["له عزم حكى الشمّ الرَّواسي","وخُلقٌ قد حكى الرِّيح الشمالا",85,"ل",2,0],["له على الحسن ختمٌ","والحسن فيه تختم",86,"م",1,0],["له عزْمٌ كنائلِه شباباً","الى حِلْمٍ كحِنْكَتِهِ اكْتِهالا",87,"ل",2,0],["له عسكرا جيشٍ وجأشٍ إذا رمى","بها الدهر أضحى خشية منه مهجما",88,"م",2,0],["له عزمات الدهر إن همّ بالعدى","وكالغيث يهمي صوبهُ وهو مرعدُ",89,"د",1,0],["له عُنقٌ في صفحة الجوّ شَارفٌ","وذيلٌ على خدّ التراب عميمُ",90,"م",1,0],["له عطَنٌ لا تشُمُّ الدما","ءَ فيه ذئ