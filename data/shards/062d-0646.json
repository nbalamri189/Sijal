ُ",140,"ا",2,0],["حنانك إن العيش عمت وجوهه","وراحت وجوه الموت حمراً تلهب",141,"ب",1,0],["حنون الممرّات ، جدرانه","نجوم كسالى ، تدير الرّقاد",142,"د",1,0]]}