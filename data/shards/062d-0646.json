سَائِقٍ وَغُرابِ",5,"ب",1,0],["حِنّي رُوَيْداً ناقُ إنّ مُناخَنا","بعُنَيْزَتَيْنِ ونارُها بمُحجَّرِ",6,"ر",1,0],["حَنَانَيْكَ إنَّ الغَدْرَ ضَرْبةُ لازِبِ","فيا لَيتَ للأحبابِ عَهدَ الحَبائِبِ",7,"ب",1,1],["حَنَّتْ إلَيْهِمْ ظُبا الأسْيافِ ظامِئَةً","حتى أبَتْ صُحْبَةَ الأجْفانِ والخِلَلِ",8,"ل",1,0],["حَنَنتَ إِلى رَيّا وَنَفسُكَ باعَدَت","مَزارَكَ مِن رَيّا وَشِعبا كَما مَعا",9,"ع",2,1],["حنّتْ لخُضْرِ رُبيً وزُرْقٍ مِياهِ","وجآذِرٍ منْ قومِها أشْباهِ",10,"ه",1,1],["حَنَانَيْكَ تَكْفِي مُهْجَتِي مِنْكَ نَظْرَةٌ","وَيَا فَوْزَ قِدْحِي إِنْ رَضِيتَ بِهَا مِنِّي",11,"ي",1,0],["حنَنْتُ الى العهْدِ القديمِ الذي قضى","حَميداً فما أغْنى الحَنينُ ولا أجْدى",12,"د",2,0],["حَنانَيْكَ في نَفْسٍ شَعاعٍ ومُهْجَةٍ","إذا لمْ يحِنْ منْ بعْدِهِمْ فكأنْ قَدِ",13,"د",1,0],["حَنانَيْكُما يا صاحِبَيَّ بمُغْرَمٍ","جَوانِحُهُ نحْوَ الحَجيجِ جَوانِحُ",14,"ح",1,0],["حَنَّ جَنبايَ إِلى بَردِ الثَرى","حَيثُ أُنسى مِن عَدُوٍّ وَحَبيبِ",15,"ب",1,0],["حَنَنتُ إِلَيهِ بَعدَما نامَ صُحبَتي","حَنينَ العِشارِ الحائِماتِ إِلى الوَردِ",16,"د",1,0],["حَنينٌ إِلى الأَوطانِ لَيسَ يَزولُ","وَقَلبٌ عَنِ الأَشواقِ لَيسَ يَحولُ",17,"ل",1,1],["حَنينٌ إِلى أُلّافِهِنَّ وَقَد بَدا","لَهُنَّ مِن الشَكِّ الغَداةَ يَقينُ",18,"ن",1,0],["حَنيني إِلى أَسماءَ وَالخَرقُ دونَها","وَإِكرامِيَ القَومَ العِدى مِن جَلالِها",19,"ل",3,0],["حَنَّطتَهُ يا نَصرُ بِالكافورِ","وَرَفَعتَهُ لِلمَنزِلِ المَهجورِ",20,"ر",1,1],["حَنينَ اللِقاحِ الخورِ حَرَّقَ نارَهُ","بِغولانِ حَوضَى فَوقَ أَكبادِها العِشرُ",21,"ر",1,0],["حَنَّت إِلى نَعَمِ الدَهنا فَقُلتُ لَها","أُمّي هِلالاً عَلى التَوفيقِ وَالرَشَدِ",22,"د",1,0],["حنيناً لمولى أتلف المالَ جودُهُ","ولكنه قد خلّد الفخر باقيا",23,"ق",3,0],["حنّت معارجها إلى أعشارها","لما سمعن بها حنين عِشارِ",24,"ر",1,0],["حنَّتْ إلى نجد وليست دارَها","وصَبتْ إلى هنديّهِ والغارِ",25,"ر",1,0],["حنانَيْك يا هربر صموئيل كم لنا","على الدهر من حق مضاع ومن وِتْر",26,"ر",1,0],["حنانيك يا قبر ابن أيوب فانصدع","لِينهض ثاوٍ في مطاويك مِفضال",27,"ل",1,0],["حَنَوْن على الرضيع بغير علم","فضاع حُنُوّ تلك المرضعات",28,"ت",1,0],["حَنَنتُ إِلى الأَجبالِ أَجبالِ طَيِّئٍ","وَحَنَّت قَلوصي أَن رَأَت سَوطَ أَحمَرا",29,"ر",2,1],["حَنَانَيكَ رَبَّ النَّاسِ من أن يَغُرَّني","كما غَرَّهم شُربُ الحَيَاةِ المُنَضِبُ",30,"ب",1,0],["حنت فباطنها قلوبٌ كلّه","وبكت فظاهرها الجميع عيون",31,"ن",1,0],["حنينُ المَريدِ لِشَوقٍ يَزيدُ","أَنينُ المَريضِ لَفَقدِ الطَبيبِ",32,"ب",1,1],["حَنانَيْك قد أيقنتُ أنك كاتبٌ","له رتبةٌ تعلو به كلَّ كاتبِ",33,"ب",1,0],["حُنُوّاً بني وهب علينا فإنه","على ذاك منكمٍ يصلح الناسُ والعصر",34,"ر",1,0],["حنانيْكَ علِّقها عليك قلادةً","وعلِّقْ عليها إن أثرْتَ التمائما",35,"م",2,0],["حنانيك لا تظلم بي المجدَ إنَّهُ","صديقٌ جليلٌ تتقيه المظالمُ",36,"م",1,0],["حَنّوا إِلى أَرَجِ الأَزاهِرِ بَعدَما","عَبَثَت بِها أَيدي الرِياحِ الأَربَعِ",37,"ع",1,0],["حَنَقتَ بِلا سَبَبٍ عَلَيَّ وَإِنَّهُ","سَبَبٌ جَديرٌ عِندَهُ أَن أَحنَقا",38,"ق",2,0],["حَنِقَ الدَهرُ عَلَينا فَسَطا","وَكَذا الدَهرُ عَلى الحرّ حَنِقْ",39,"ق",1,0],["حنانك لا تؤاخذنا","على نسياننا الأمرا",40,"ر",2,1],["حنا لقد أقعدتني وأقمتني","أكذاك يفعل سائر البيكات",41,"ت",1,0],["حَنَّ لِلشامِ حِقبَةً وَإِلَيها","فاتِحُ الغَربِ مِن بَني مَروانِه",42,"ن",2,0],["حَنَّ لِلبانِ وَناجى العَلَما","أَينَ شَرقُ الأَرضِ مِن أَندَلُسِ",43,"س",1,0],["حَنانَيكَ قَلبي هَل أُعيدُ لَكَ الصِبا","وَهَل لِلفَتى بِالمُستَحيلِ يَدانِ",44,"ن",1,0],["حَنَنتِ إِلى الطَبيعَةِ دونَ مِصرِ","وَقُلتِ لَدى الطَبيعَةِ أَينَ مِصرُ",45,"ر",1,0],["حَنيفِيَّةٌ قَد عَزَّها وَأَعَزَّها","ثَلاثونَ مَلكاً فاتِحونَ غُزاةُ",46,"ه",1,0],["حَنانَكَ وَاِهدِ لِلحُسنى تِجاراً","بِها مَلَكوا المَرافِقَ وَالرِقابا",47,"ب",2,0],["حَنَاهُ الهوى بالشّوقِ حتى كأنّما","بأحشائِهِ للشّوْقِ لَدْغُ العَقاربِ",48,"ب",1,0],["حَنَانَيْكَ يا أَمَلي دَعوةً","لِمَنْ صارَ رَحْمَةَ أعدائِهِ",49,"ا",3,0],["حَنانَيكَ مَسؤولاً وَلَبَّيكَ داعِياً","وَحَسبِيَ مَوهوباً وَحَسبُكَ واهِبا",50,"ب",2,0],["حَنِقٌ عَلى بِدَرِ اللُجَينِ وَما أَتَت","بِإِساءَةٍ وَعَنِ المُسيءِ صَفوحُ",51,"ح",1,0],["حنينَ البُختِ وَدَّعَها حجيجٌ","كأنَّ خيامَنا لهمُ جمارُ",52,"ر",1,0],["حنايا إِذا قرطسن أغراضَ مهمهٍ","مرقنَ به من جلدة الليل أسهُما",53,"م",2,0],["حَنِقٌ على الأعداءِ مضطغِنٌ","وعلى الرعايَا مُشفِقٌ حَدِبُ",54,"ب",1,0],["حَنَوتَ عَلَيهِ بَعدَ أَن أَشرَفَ الرَدى","عَلى نَفسِ مُزوَرٍّ عَنِ الحَقِّ ناكِبِ",55,"ب",1,0],["حَنانَيكَ اِرحَمِ الشُعَراءَ وَاِمنُن","عَلَيهِم بِاِجتِنابِ أَبي سَعيدِ",56,"د",1,0],["حَنانَيكَ مِن هَولِ البَطائِحِ سائِراً","إِلى خَطَرٍ وَالريحُ هَولٌ دَبورُها",57,"ر",3,0],["حَنَتكَ أَميرَ المُؤمِنينَ كِفايَةٌ","مِنَ اللَهِ في الأَعداءِ نابِهَةُ الذِكرِ",58,"ر",1,0],["حَنَّت رِكابي بِالعِراقِ وَشاقَها","في ناجِرٍ بَردُ الشَآمِ وَريفُهُ",59,"ف",2,0],["حُنِيَت تِلكَ العَراجٍ عَلى","لُؤلُوٍ غَضٍّ وَخوصٍ كَالشُرُك",60,"ك",1,0],["حَنَت مَذحِجٌ حَولي وَباتَت عَمائِرٌ","تُدافِعُ دوني مِن عَرانينِها الشُمِّ",61,"م",1,0],["حَنيني إِلى ذاكَ القَليبِ وَلَوعَتي","عَلَيهِ وَقَلَّت لَوعَتي وَحَنيني",62,"ن",2,0],["حَنَّ فيها أَثلُ الغُوَيرِ فَأَشجى","مُغرَماتِ القُلوبِ وَإِهتَزَّ بانُه",63,"ن",2,0],["حَنيفَةُ أَفنَت بِالسُيوفِ وَبِالقَنا","حَرورِيَّةَ البَحرَينِ يَومَ اِبنُ بَخذَجِ",64,"ج",1,1],["حَنيفَةُ إِنَّ اللَهَ عَزَّ بِنَصرِهِ","حَنيفَةَ وَالكَلبُ العَقيلِيِّ مُخرَجُ",64,"ج",1,0],["حَنينِ الوالِهَينِ إِذا ذَكَرنا","فُؤادَينا اللَذَينِ مَعَ القُبورِ",65,"ر",1,0],["حَنِقٌ على الأموالِ غيرُ مُبَخَّلٍ","قاسٍ على الأعداءِ غيرُ رَؤوفِ",66,"ف",1,0],["حنَّاتَهٍ في الَّليلِ من غيرِ كَمَد","كأنَّ ماءَ البئرِ فيها يَطَّرِد",67,"د",1,0],["حَنَّتْ نفوسُهمُ إليك فأعلَنوا","نَفَساً يَقُدُّ مَسالكَ الأرواحِ",68,"ح",1,0],["حنَّ إلى أرضِ العِراقِ فامتطَى","مطيّةً تسبَحُ في اللُّجِّ اللَّجِبْ",69,"ب",1,0],["حنَّتْ رواعِدُه فأسبل دمعُهُ","كالصَّبِّ أتبعَ شدوَه ببكائِه",70,"ا",3,0],["حَنانيكِ قَد أَشهَدتِني كُلَّ واجِبٍ","عَليَّ فَلي مِن ذاكَ شُغلٌ عَنِ النَدبِ",71,"ب",1,0],["حنينا الرؤوس لمجد الجمالِ","ولُذنا بعرشكِ يا آسره",72,"ر",2,0],["حنانُكَ نضرة الدنيا","وقربُكَ نعمةُ اللهِ",73,"ه",1,0],["حنيّاتُهُ قانصاتٌ لنفسي","وَقَطْرَاتُهُ صائباتُ السهامِ",74,"م",1,0],["حَنَّ إِلى المَوتِ حَتّى ظَنَّ جاهِلُهُ","بِأَنَّهُ حَنَّ مُشتاقاً إِلى وَطَنِ",75,"ن",1,0],["حَنَت عَلَيهِ