زوء الرجز"],[406,"ما استقامت قناة رأيي إلا","https://www.aldiwan.net/poem49632.html","الخفيف"],[406,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[407,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[410,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[410,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[417,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[430,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[433,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[433,"ألشيم برق أم شميم عرار","https://www.aldiwan.net/poem12808.html","الكامل"],[438,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[438,"أفنيت صبري في الهوى وتجلدي","https://www.aldiwan.net/poem2581.html","الكامل"],[442,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[450,"لا تخدعنك كثرة الزراع","https://www.aldiwan.net/poem982.html",""],[453,"ما اسم ثلاثي تراه","https://www.aldiwan.net/poem13626.html","مجزوء الكامل"],[453,"ما اسم ثلاثي وبالت","https://www.aldiwan.net/poem13753.html","مجزوء الكامل"],[453,"ما اسم ثلاثي وفعل معا","https://www.aldiwan.net/poem13784.html","السريع"],[453,"ما اسم من الأزهار تركيبه","https://www.aldiwan.net/poem13949.html","السريع"],[453,"ما اسم ثلاثي ترى","https://www.aldiwan.net/poem13960.html","مجزوء الكامل"],[454,"ما اسكندر اليازجي اليوم أعرفه","https://www.aldiwan.net/poem61793.html","البسيط"],[459,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[459,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[459,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[459,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[469,"ما استطعم القصد مثل بشري","https://www.aldiwan.net/poem60003.html","مخلع السريع"],[478,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[480,"راق النشيد ورقت نغمة العود","https://www.aldiwan.net/poem37170.html","البسيط"],[480,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[483,"البين في سقر","https://www.aldiwan.net/poem24370.html","عموديه"],[494,"ومدام كأنها في حشا الدنن","https://www.aldiwan.net/poem67426.html","الخفيف"],[506,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[516,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[530,"ما اسم رباعي به","https://www.aldiwan.net/poem37256.html","مجزوء الكامل"],[530,"يا من له من ذهنه","https://www.aldiwan.net/poem37411.html","مجزوء الكامل"],[545,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[552,"قل لقوم لا أبالي","https://www.aldiwan.net/poem47239.html","مجزوء الرمل"],[552,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[552,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[559,"فر إبليس عن هدى العرفان","https://www.aldiwan.net/poem33728.html","الخفيف"],[559,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[559,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"],[559,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[587,"أهوى قمرا مر بنا مجتازا","https://www.aldiwan.net/poem17553.html","الدوبيت"],[587,"إني لفي كنف مولى جود راحته","https://www.aldiwan.net/poem17804.html","البسيط"]],"verses":[["ما أَسرَعَ الأَيّامَ في طَيَّنا","تَمضي عَلينا ثُمَّ تَمضي بِنا",0,"ن",2,1],["ما اِستَأخَرَت شِدّاتُها عَنِ مَعشَرٍ","بَعدَ قَطينِ اللَهِ أَو آلِ قَطَن",1,"ن",1,0],["ما اِستَجمَعَت فِرَقُ الهُمومِ بِهِ","إِلّا وَبَدَّدَ جَمعَها الجَذَلُ",2,"ل",1,0],["ما اِستَمتُ أُنثى نَفسَها في مَوطِنِ","حَتّى أُوَفّي مَهرَها مَولاها",3,"ا",3,0],["ما أَسمَجَ الناسَ في عَيني وَأَقبَحَهُم","إِذا نَظَرتُ فَلَم أُبصِركِ في الناسِ",4,"س",1,0],["ما أسْعَدَ المُلْكَ الذي سُسْتَهُ","يا عُمَرَ العدْلِ وما أسْعَدَكْ",5,"ك",1,0],["ما اسْمٌ إذا زِدْتَهُ ألْفاً منَ العَدَدِ","أفادَ مَعْناهُ لمْ يَنْقُصْ ولمْ يزِدِ",6,"د",1,1],["ما اِسمٌ جَميعُ الناسِ تَهوى قُربَهُ","وَتُحِبهُ مِن خامِلٍ وَمسوَّدِ",7,"د",1,1],["ما اِسمٌ لِحَيٍّ وَمَيتٍ","يُرى وَبَرّ وَبَحرِ",8,"ر",1,1],["ما اِسمٌ إِذا قَطَّعوهُ كانَ أَربَعَةً","وَعَدُّهُ سِتَّةٌ مَعروفَةُ السَبَبِ",9,"ب",1,1],["ما اِسمٌ إِذا صَحَّفوهُ كانَ مجلَبَةً","لِلهَمِّ أَو صَحَّفوا مَعكوسَهُ فَكَذا",10,"ذ",2,1],["ما اِسمٌ رُباعِيُّ الحُروفِ وَإِنَّما","بِاثنَينِ يُكتَبُ وَالصَحيحُ فَواحِدُ",11,"د",1,1],["ما اِسمٌ حَرامٌ لِلنِساءِ فِعالُهُ","وَتَراهُ بِالتَصحيفِ وَهوَ مُحَلَّلُ",12,"ل",1,1],["مَا اسْتِعَارَاتُ كَاتِبٍ وَالَّتِي يُثْ","نِي عَلَيْهَا خِصَالُهَا تَكْفِيهَا",13,"ي",3,0],["مَا أَسْخَفَ العَبَرَاتِ سَاكِبَةً","وَالنَّعْشُ يَحْجُبُ وَجْهَ مُبْتَسِمِ",14,"م",1,0],["ما أسعد الشعبين قد جمعتهما","أبداً أواصر من دم وعُروق",15,"ق",1,0],["ما استفاد الفتى وإن ملك الأر","ض بأعلى من علمه المستفاد",16,"د",1,0],["ما اِستَوصَفَ الناسُ عَن شَيءٍ يَروقُهُمُ","إِلّا أَرى أُمَّ عَمروٍ فَوقَ ما وَصَفوا",17,"ف",3,0],["ما اسم شيء فرغت منه فلا","أقولُ فيهِ ولا أقولُ بِه",18,"ب",2,1],["ما اسم ذي حجم لطيف","بين أيدي القوم ساعي",19,"ع",2,0],["ما اسم شيء فيه لقوم طعام","ولكلِّ الورَى بخمسيهِ ريّ",20,"ي",1,0],["ما أَستزيد لقاسمٍ","من رَبِّهِ غيرَ البقاءِ",21,"ق",3,1],["ما استَبَّ قَطُّ اثنان إلا غَلبَا","شرُّهما نفساً وأُمّاً وأبا",22,"ب",2,1],["ما أسمجَ ابنَ عُبيدٍ حين تفجؤهُ","والرِّدفُ في صعدٍ والرأسُ في صَبَبِ",23,"ب",1,0],["ما استأثرتْ دونكم كفَّي بصلعتهِ","فتحسدوني عليها معشر القَفَدَهْ",24,"د",2,0],["ما أستقل قليلاً أنت باذله","ذكراك إياي بالمعروف معروف",25,"ف",1,0],["ما استشرفتْ منك العيونُ ضئيلا","لكنْ عظيماً في الصدورِ جليلا",26,"ل",2,1],["ما استوجبا منك الكُفورَ بجرمها","فدعِ الهوادةَ في الحكومةِ واعدلِ",27,"ل",1,0],["ما استام بالحمدِ مُستامٌ فماكَسهُ","وهل يرَدُّ جوادٌ حُكْمَ مُسْتامِ",28,"م",1,0],["ما استخفَّ امرؤٌ بقدريَ حتَّى","بوَّأ النفسَ موقفَ المرحومه",29,"م",2,0],["ما استبنا فقدَ الربيع عليه","لا ولا فقدَ صوبه الهتان",30,"ن",1,0],["ما اسم عبد الإله واسم عُبيْد ال","لَه لولا التصغير مختلفانِ",30,"ن",1,0],["ما اِستَحالَ الهِرُّ لَيثاً إِنَّما","ىُسُدُ الآجامِ صارَت هِرَرَه",31,"ر",2,0],["ما اِستَخَفَّت عَنّي الأَفلاكُ","وَالشُهبُ بَلِ اِستَخفى حُبّي",32,"ي",1,0],["مَا أَسخَفَ العيشَ تَقْ","ضِي عليهِ زلَّةُ نَعْلِ",33,"ل",1,0],["ما اسطاعت الاحداث مهما حاولت","نقضاً لركن قام من اركانه",34,"ن",2,0],["ما اسبق الجيل شأواً في حضارته","لو لم تثبطه للجهل التقاليد",35,"د",1,0],["ما استجاب الإله مني دعاء","أوليس من أوهامي",36,"ي",1,0],["ما أَسأَرَت في القَعبِ مِن لَبَنٍ","تَرَكَتهُ وَهوَ المِسكُ وَالعَسَلُ",37,"ل",1,0],["ما أسعدَ السلطانَ بالرأي الذي","فيك ارتأى مستكفياً مستوزَرا",38,"ر",2,0],["ما اِستَغرَبَ الناسُ إِفضالاً وَلا اِشتَهَروا","مِن حاتِمٍ غَيرَ جودٍ بِالَّذي يَجِدُ",39,"د",1,0],["ما اِستَنَّ عَبدُ اللَهِ أُكرومَةً","إِلّا وَقَد نازَعَها مَخلَدَه",40,"د",2,0],["ما اِستَبَقَ الناسُ إِلى سُؤدَدٍ","إِلّا تَناهى وَلَهُ الذِكرُ",41,"ر",1,0],["ما اِستَعَنتُ الكَرى عَلى الشَوقِ إِلّا","باتَ قَيضاً مِنَ الحبيبِ خَيالُه",42,"ل",2,0],["ما اِستَماحَ العافونَ جَدواهُ إِلّا","كانَ عِدّاً لَهُم عَتيدَ الجُمومِ",43,"م",1,0],["ما أسلفَ البِرَّ فَلمْ يُجازِه","ولا خلا في الوَعدِ من إنجازِه",44,"ز",2,0],["ما اِستَعبَدَ الحِرصُ مَن لَهُ أَدَبُ","لِلمَرءِ في الحِرصِ هِمَّةٌ عَجَبُ",45,"ب",1,1],["ما استَطابَ العَيشَ فيها حَليمٌ","لا وَلا دامَ لَهُ ما اِستَطابا",46,"ب",2,0],["ما أَسرَعَ الأَمرَ الَّذي هُوَ كائِنٌ","لا بُدَّ مِنهُ وَأَقرَبَ الميقات",47,"ت",1,0],["ما أَسرَعَ اللَيلَ وَالنَهارَ بِسا","عاتٍ قِصارٍ تَأتي عَلى الأَمَدِ",48,"د",1,0],["ما أَسرَعَ الأَيامَ في الشَهرِ","وَأَسرَعَ الأَشهُرَ في العُمرِ",49,"ر",1,0],["ما اِستَوى الناسُ مُنذُ كان