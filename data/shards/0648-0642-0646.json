https://www.poetsgate.com/ViewPoem.aspx?id=94027",""],[5351,"الأرض تعشق روح من ضحى","https://www.poetsgate.com/ViewPoem.aspx?id=202698",""],[5431,"(سأزرع الأرضَ آلافا من القُبَلِ)!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200121",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[5660,"ما أَصعَبَ الذِكرى عَلى الأَحبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=23715",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6233,"عيناكِ تعلنان هزيمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82633&r=&rc=32",""]],"verses":[["وَقَنيصُها لَهُمُ قِرىً","وَظُهورُها لَهُمُ حُصونُ",0,"ن",1,0],["وَقَناةٍ صَمّاءَ تَطعَنُ في الخَط","بِ خِلاجاً عَلى الزَمانِ وَشَزرا",1,"ر",2,0],["وَقَناةٌ تَبغي بِحَربَةَ عَهداً","مِن ضَبوحٍ قَفّى عَلَيهِ الخَبالُ",2,"ل",1,0],["وقنابر الروض الاريض","صواعد ونوازل",3,"ل",1,0],["وقنطت من مرجوّ عودك يا علي","ورجوع بيتك ظافر الرايات",4,"ت",1,0],["وَقَناةً صَعدَةٌ لَو وُهِبَت","لِلسِماكِ الأَعزَلِ اِختالَ وَتاها",5,"ا",3,0],["وقَنَانٍ زَوَاهِرٍ هُنَّ بالشّمْ","سِ مِنَ الشّمْسِ بالقَلائِدِ أَحْكَى",6,"ك",2,1],["وَقَنا الخَطِّ في مَراكِزِها حَو","لَكَ وَالمُرهَفاتُ في الأَغمادِ",7,"د",1,0],["وَقَنِعتُ بِاللُقيا وَأَوَّلِ نَظرَةٍ","إِنَّ القَليلَ مِنَ الحَبيبِ كَثيرُ",8,"ر",1,0],["وَقَنوعُ المَرءِ يَحمي عِرضَهُ","ما القَريرُ العَينِ إِلّا مَن قَنِع",9,"ع",1,0],["وَقَنَّعَني القَتيرُ خِمارَ شَيبٍ","وَوَدَّعَني الشَبابُ وَرَقَّ عَظمي",10,"م",2,0],["وَقَناةٍ فَوقَها كَوكَبُها","وَمِجَنٍّ كُلُّ هَذا في بِلادي",11,"د",2,0],["وَقَناً جُردٍ وَخَيلٍ ضُمَّرٍ","شُزَّبٍ مِن طولِ تَعلاكِ اللُجُم",12,"م",1,0],["وقناعةٍ مِنْ قِسمةٍ","لَكِ عِنْدَ خَيْرِ مُوَزِّعِ",13,"ع",1,0],["وقناةً جَلَّ من ثَقَّفها","للحِفاظِ المُرِّ والعزم المكين",14,"ن",1,0],["وقناني الخمرِ التي عَصَرُها","من دُموعي ومن دُموعِكِ تُقْنَى",15,"ن",2,0],["وقنعت في جعل المجاز حقيقة","كالماذج اليقظات بالاحلام",16,"م",1,0],["وقناعة أسنى اللباس تجمّلن","بقناعة فبعزها لن تهدما",17,"م",2,0],["وقِنا اللهم من سوءِ العَذَابْ","فهو يرجوكَ فلقِّنْه المتاب",18,"ب",1,0],["وقِندِيلٍ وحَسكَةٍ اعتَلَتها","زجاجةٌ أقمَرَت سُودَ الدَّآدِى",19,"د",2,0],["وَقَناً تُرَوِّعُ في مَراكِزِها العِدى","رَهَباً فَماذا ظَنُّهُم إِذ تُشرَعُ",20,"ع",1,0],["وقناةُ ذاك القَدِّ كيف تَقوَّمت","وسِنان ذاك اللحظِ ما فُولاذه",21,"ذ",2,0],["وقَنَصتُ مُقْتَنِصِى بمثل نبالِه","حتى تَساوى في الهوى قلبانا",22,"ن",2,0],["وقنعت بالنزر اللقى","ورضيت شحّ شحيحه",23,"ح",2,0],["وقنابلٌ صرعَ القلوبَ صراخُها","ويلاهُ تمحو الدورَ والسكانا",24,"ن",2,0],["وَقَنَعْتُ مِنْكُمْ فِي الصَّبَا","بَةِ بِالتَّطَارُحِ وَالْغَزَلْ",25,"ل",1,0],["وَقَنَصْنَا بَيْنَ أَزْهَارِ الرُّبَى","قُرَّةَ الْعَيْنِ وَزَهْوَ الأَنْفُسِ",26,"س",1,0],["وَقَنا الخَطِّيِّ لَدنٌ","مَعَهُم حَدُّ كَثيرِ",27,"ر",1,0],["وَقُنوعٍ مِن حَبيبٍ","بِالمَواعيدِ الكِذابِ",28,"ب",1,0],["وقنوط ورجاء","ومشيب وشباب",29,"ب",1,0],["وَقَنِّعِ النَفسَ وَكُن مُذكِياً","عَلى مَواليها بِما عَنكَ فَضَل",30,"ل",1,0],["وقنا الاسوا وجنبنا الهوى","واجعل التقوى غذانا والزلال",31,"ل",1,0],["وقنعتُ منه بزورةٍ مُزْوَرّةٍ","قد سدّ عنها شوقه ينبوعَه",32,"ع",2,0],["وقَناً إِذَا اقْتَضَتِ العُدَاة نفوسَها","لَمْ يعتَلِلْ بأَدائِهِنَّ مِطالُ",33,"ل",1,0],["وقَنَّعَ وَجْهِي قَناعَاتِ حُرٍّ","فَقَنَّعَ دُوني وُجُوهَ العَطاءِ",34,"ا",2,0],["وقنعني برزق من","ك لو من حثوة الترب",35,"ب",1,0],["وقناة بارعة العلا قد حطمت","ولكم غدت بعلاك وهي تقوم",36,"م",1,0],["وقناعةٌ بالعفو تؤذن أنها","للفضل إن الحرص للنقصانِ",37,"ن",1,0],["وقنِعتُ من قِسم الزمان به","مذ صار من أبنائه قِسمي",38,"م",2,0],["وقنعت بالنظر الخفيّ تنزُّها","ووهبتُ طيبَ حرامه لحلاله",39,"ل",2,0],["وقنا الخطِّ ثاقباتُ المواضي","والمواضي بوارقٌ ذاتُ لمع",40,"ع",1,0],["وقناه كسامعي مدحهِ تختال","سكراً وما سقين مداما",41,"م",2,0],["وقنعت منها بالشريط محليا","صدر الشريف فزدته تنويرا",42,"ر",2,0],["وقنّعَ بالدُجى شمسَ المُحيّا","فبرقَعَ بالضُحى ليلَ القَذالِ",43,"ل",1,0],["وقنيصة لولا الخلافة لم تكن","أبداً لتعلق في حبال الصائد",44,"د",1,0],["وقُنّعتُ منه بِالمَخوفِ كأنّني","تقنّعتُ من طاقاتِهِ بالأراقمِ",45,"م",1,0],["وقنعتُ منهمْ بالقليل ولم أكنْ","أرضى قُبَيلَ فراقهمْ بقليلِ",46,"ل",1,0],["وقنعتُ من خلّي بعفوِ ودادِهِ","لا بالّذي يجفو عليه ويثقلُ",47,"ل",1,0],["وقنعت منها بالسّلامِ لو اِنّه","أروى صَدى أو بلّ لَهْفَ لهيفِ",48,"ف",1,0],["وقنعتُ منهُ بزَوْرَةٍ","عَرَضتْ ولم تكُ في حسابي",49,"ب",2,0],["وقنعنا من رؤْية الطَّيفِ بالطَّيْ","فِ وقد تَخْلُفُ الشموسُ الأَهلَّه",50,"ل",2,0],["وقنعني الزمان فلست آسى","على فوت الثراء وأنت عندي",51,"د",2,0],["وقَنَانا ضَعْ وصوارمَنا","برقابِهِمِ ثمَّ الكبدِ",52,"د",1,0],["وقنعت بالتمليك طوعاً للهوى","شغفاً وحباً أن أفوز بمالك",53,"ك",1,0],["وقنعت من نعمى الشباب بأنسه","وصرفت عن صفو الحياة شؤوني",54,"ن",2,0],["وقنعت منك بأَن تسا","عف بالوصال وإن تسامح",55,"ح",1,0],["وقني عذابك وأولني","في عدنك العيش الرغد",56,"د",1,0],["وقني مصاب الدين والرمد الذي","أهمى بصائب سهمه قلبي السليم",57,"م",1,0],["وقني النار واكفني كل هول","واجعل الخلد لي بفضلك دارا",58,"ر",2,0],["وقنعنا من الوصال بطيف","يطرق الجفن في ليالى البعاد",59,"د",1,0],["وقنعت بالنظر البرئ فقبلت","عيناي من فرط الجوى عينيك",60,"ك",1,0],["وَقناة الدينِ قد ثقّفها","فَهمُ بعدَ اِعوجاجٍ لرَشَد",61,"د",1,0],["وقناة خطية ما الينت","عند غمز قد قصفتها عقودا",62,"د",2,0],["وقنا الهوى والنفس يا رب الورى","وعدونا الشيطان مع زلزال",63,"ل",1,0],["وَقناة القوام مَع سَيف لَحظ","فَتكافي الأَنام حَتّى العَذارى",64,"ر",2,0],["وقناعسٍ واشاوس","وفوارس غُلبٍ مساعِرْ",65,"ر",1,0],["وقني من شر مجترىء","بمقال الزور مجترم",66,"م",1,0],["وَقَنِعْتُ منه بِظاهرٍ مُتَبَسّمٍ","وَرَّى به عن باطنٍ مُتَجَهّم",67,"م",1,0],["وقناطير من نضار يوافي","كم بها القطن كل عام أهلا",68,"ل",2,0],["وقنفذٍ سيري إلى حيةٍ","وحيةٌ يخلى لها الجحرُ",69,"ر",1,0],["وَقَنوعٍ مِثلي شَكورٍ وَأَنّى","لَكَ أَن تَشتَري القُنوعَ بِمالِك",70,"ك",1,0],["وقنا يا رب اشراك الردى","وتول الامر منا ياولي",71,"ي",1,0],["وَقَنِعتَ بِالنَزرِ القَليلِ وَلَم تَكُن","عِندَ القَناعَةِ بِالقَليلِ قَليلا",72,"ل",2,0],["وقناطر أم الحسن بها","ماء في الخضرة ينسرب",73,"ب",1,0],["وقنعت من حبي له بصدوده","وبصمته ودلاله وغيابه",74,"ب",2,0],["وقنعت منه بالخيال لو أنه","أهدى الرقاد لطرفي السهران",75,"ن",1,0],["وَقُندُسٌ عَالِقُ برِّ المَغربِ","مِنهُ الجبالُ كلُّها بالقُربِ",76,"ب",1,0],["وقنطرة قد حدثت عن محاسنه","لمنشئها تبقى بدون تناهي",77,"ي",1,0],["وقنِعْت باسم مُؤَمَّلٍ جاوَرْتُه","أَدعو لدولته مُسِرّاً مُعْلِنا",78,"ن",2,0],["وقناة معتنق الرماح قوامها","بالصف يطعن لا طويل قناتها",79,"ت",3,0],["وقناعهن مثقب","والوشي فيه مشجر",80,"ر",1,0],["وقني مفاتِنَ ما يروقُ لناظري","من ساحر القسمات والأوصافِ",81,"ف",1,0],["وقننوها اسسوا اساسها","وسننوها اوقدوا نبراسها",82,"ه",2,0],["وَقِني من مطامحي وأَقِلني","عَثرةَ الكِبرِ فَهيَ ارزى الرزايا",83,"ا",3,0],["وَقِني شَرَّ ما أَخافُ فَإِنّي","مُشفِقٌ خائِفٌ لِما تَستعِيدُ",84,"د",1,0],["وَقَنَت حينَ شَهِدَت مِنّي لَوعَتي","رَفُّ القَوادِمِ مِن خَوفِ فُؤادي",85,"د",2,0],["وقَناً خَواطرُ كلها خَطيَّةٌ","فيها سِنانُ كالمنارةِ يلمعُ",86,"ع",1,0],["وَقَنَاهُ فِي صَدرِ مَن حَادَ تُعرِب","وَتَوَالَت للمُصطفَى الآيةُ الكُب",87,"ب",1,0],["وقنعت حتى صرت أرجو منكم","من بعد ذاك القرب طيفاً يطرق",88,"ق",1,0],["وقنع الإنسان بالرزقَ الأقل","قناعة قنعَ معناه سأل",89,"ل",1,0],["وقناةً شحيذة الحد وانق","ض يجاري أياس في المضمار",90,"ر",1,0],["وقِني وعِترتِيَ الخُطوبَ وأَولِنا","رِزقاً حلالاً واسِعاً يا مُنعِمُ",91,"م",1,0],["وقنى الفتنتين وامنن بأنسى","حين أمسى ولحد رمسى عفاصى",92,"ص",2,0],["وقنى أذى الفتان في موتى وفى","قبرى اذا فيه اللسان تلجلجا",93,"ج",2,0],["وقنعتَ من طَيْف الخيالِ بزورةٍ","ورضيتَ من برقِ الوصال بخطفةِ",94,"ه",1,0],["وقناتها الحمراءُ بين غصونها","ياقوتةٌ حُفّت بثوب زمردِ",95,"د",1,0],["وَقنوعي بِالدونِ أَلبَسَني الذُّل","لَ وَأَلقى عَلَيَّ ثَوبَ الهَوانِ",96,"ن",1,0],["وقَنَصْتَ فيما تَبْتَغيهِ مَبارَكاً","((صَيْداً)) سَمَى يا زينَةَ الأُمَراءِ",97,"ا",2,0],["وقنديلٍ كأن الضوء فيه","محيّا من أُحب وقد تجلى",98,"ل",2,1],["وقنطرةٍ قد كان في الحرب ليثَها","وعنها جيوش البغي أفنى وطرَّدا",99,"د",2,0],["وقناة رقص ونقص والي يزيده","شات كلامه يجرح اعراض الاحرار",100,"ر",1,0],["وقناة دز اسمك سعيد وسعيده","واصبر وشوف للحب نسبة ومعيار",100,"ر",1,0],["وقناة تجمع كل جنس وضديده","بين اربعة جدران من كل الاقطار",100,"ر",1,0],["وقنعتُ بالأحلامِ حتى أنني..","أجزلتُ عطري في رُبوعِ منامي",101,"ي",1,1],["وَقَنَاْبِلُ الثُّوَّاْرِ تُرْشِدُ طَاْمِعاً","ضَلَّ السَّبِيْلَ، وَضَاْعَ مِنْهُ رَشَاْدُهُ",102,"د",2,0],["وَقنِعتُ مِنْ صلفِ الحبيبِ بنظرةٍ","حتّى وإنْ مُزجتْ بلونِ إِبَاهُ",103,"ا",2,0],["وقناعتي أنْ لمْ يزلْ في موطني","وجدانُ قاضٍ بالنزاهَةِ قد ألمْ",104,"م",1,0],["وقني من نزوات الظلم أو","نزغة الشيطان شر النزغات",105,"ت",1,0],["وقنعت بالنظر البريء فقبلت","عيناي من فرط الجوى عينيك",106,"ك",1,0],["وقنابلًا يوم الحصاد على","الغازين تنسف ذلك القبحا",107,"ح",2,0],["وقنفذ الأرض مأخوذا بحيرته",": (أيقرأ الشوكُ نزفَ الشمع في الشُعلِ)؟",108,"ل",1,0],["وَقَناةُ الدِّينِ قَدْ ثَقَّفَها","فِيهِمُ بَعْدَ اعْوِجاجٍ لِلرَّشَدْ",109,"د",1,0],["وَقَنَعتَ مِنّي بِالقَليلِ وَ زِدتَني","فَالجُودُ مِنكَ مُلَفَّعٌ بِثَوابِ",110,"ب",1,0],["وقنبر خير من أقنى وبر ومن","كان الغلام وعضدا أيما عضد",111,"د",1,0],["وقنيتها ماقصد كثر ٍ وقلي","باغيها لياجو النشامى لهم قوت",112,"ت",1,0],["وقَناً مُثَقَّفَةٌ أُنِيمَتْ بعدَمَا","دَعَمَتْ أَسِنَّتُها صَفيحَ سَمَائِها",113,"ا",3,0],["وقناعتي بالموت تُولَد فيهما","وتشكُّكي ببراءتي .. ويقيني",114,"ن",2,0]]}