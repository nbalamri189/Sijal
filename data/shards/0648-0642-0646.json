{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[4,"لم تبين عن أهلها الأطلال","https://www.aldiwan.net/poem21185.html","الخفيف"],[89,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[56,"وقنان زواهر هن بالشم","https://www.aldiwan.net/poem58540.html","الخفيف"],[43,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[43,"غاضت أنامله وهن بحور","https://www.aldiwan.net/poem9574.html","الكامل"],[49,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[22,"ألا هبت أمامة بعد هدء","https://www.aldiwan.net/poem21664.html","الوافر"],[52,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[116,"البرق حاجر ام لبرق الشام","https://www.aldiwan.net/poem40593.html","عموديه"],[122,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[129,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[133,"طبتنا اليوم عن ذكرى سعاد","https://www.aldiwan.net/poem54849.html","الطويل"],[144,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[186,"لو كان بالصبر الجميل ملاذه","https://www.aldiwan.net/poem14515.html","الكامل"],[186,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[187,"كلح الزمان إلى الورى","https://www.aldiwan.net/poem43983.html","مجزوء الكامل"],[198,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[238,"الحسن فيك قد اكتمل","https://www.aldiwan.net/poem18863.html","مجزوء الكامل"],[238,"قد قطفنا ذهبا من سندس","https://www.aldiwan.net/poem19707.html","الرمل"],[323,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[339,"اصطبح كأس شراب","https://www.aldiwan.net/poem68814.html","مجزوء الرمل"],[343,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[350,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[392,"أحمد السقاف إن شئت الوصال","https://www.aldiwan.net/poem54535.html","عموديه"],[433,"ماذا أقول وقد حبيت بفطنة","https://www.aldiwan.net/poem12655.html","الكامل"],[440,"عزم حداه السعد والإقبال","https://www.aldiwan.net/poem34802.html","الكامل"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[442,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[442,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[459,"ما أنتِ بعد البين من أوطاني","https://www.aldiwan.net/poem55853.html","الكامل"],[459,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[465,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[465,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[465,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[480,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[516,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[552,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[552,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[552,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[552,"يا حبذا من زارني","https://www.aldiwan.net/poem48053.html","مجزوء الكامل"],[576,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"]],"verses":[["وَقَنيصُها لَهُمُ قِرىً","وَظُهورُها لَهُمُ حُصونُ",0,"ن",1,0],["وَقَناةٍ صَمّاءَ تَطعَنُ في الخَط","بِ خِلاجاً عَلى الزَمانِ وَشَزرا",1,"ر",2,0],["وَقَناةٌ تَبغي بِحَربَةَ عَهداً","مِن ضَبوحٍ قَفّى عَلَيهِ الخَبالُ",2,"ل",1,0],["وقنابر الروض الاريض","صواعد ونوازل",3,"ل",1,0],["وقنطت من مرجوّ عودك يا علي","ورجوع بيتك ظافر الرايات",4,"ت",1,0],["وَقَناةً صَعدَةٌ لَو وُهِبَت","لِلسِماكِ الأَعزَلِ اِختالَ وَتاها",5,"ا",3,0],["وقَنَانٍ زَوَاهِرٍ هُنَّ بالشّمْ","سِ مِنَ الشّمْسِ بالقَلائِدِ أَحْكَى",6,"ك",2,1],["وَقَنا الخَطِّ في مَراكِزِها حَو","لَكَ وَالمُرهَفاتُ في الأَغمادِ",7,"د",1,0],["وَقَنِعتُ بِاللُقيا وَأَوَّلِ نَظرَةٍ","إِنَّ القَليلَ مِنَ الحَبيبِ كَثيرُ",8,"ر",1,0],["وَقَنوعُ المَرءِ يَحمي عِرضَهُ","ما القَريرُ العَينِ إِلّا مَن قَنِع",9,"ع",1,0],["وَقَنَّعَني القَتيرُ خِمارَ شَيبٍ","وَوَدَّعَني الشَبابُ وَرَقَّ عَظمي",10,"م",2,0],["وَقَناةٍ فَوقَها كَوكَبُها","وَمِجَنٍّ كُلُّ هَذا في بِلادي",11,"د",2,0],["وَقَناً جُردٍ وَخَيلٍ ضُمَّرٍ","شُزَّبٍ مِن طولِ تَعلاكِ اللُجُم",12,"م",1,0],["وقناعةٍ مِنْ قِسمةٍ","لَكِ عِنْدَ خَيْرِ مُوَزِّعِ",13,"ع",1,0],["وقناةً جَلَّ من ثَقَّفها","للحِفاظِ المُرِّ والعزم المكين",14,"ن",1,0],["وقناني الخمرِ التي عَصَرُها","من دُموعي ومن دُموعِكِ تُقْنَى",15,"ن",2,0],["وقنعت في جعل المجاز حقيقة","كالماذج اليقظات بالاحلام",16,"م",1,0],["وقناعة أسنى اللباس تجمّلن","بقناعة فبعزها لن تهدما",17,"م",2,0],["وقِنا اللهم من سوءِ العَذَابْ","فهو يرجوكَ فلقِّنْه المتاب",18,"ب",1,0],["وقِندِيلٍ وحَسكَةٍ اعتَلَتها","زجاجةٌ أقمَرَت سُودَ الدَّآدِى",19,"د",2,0],["وَقَناً تُرَوِّعُ في مَراكِزِها العِدى","رَهَباً فَماذا ظَنُّهُم إِذ تُشرَعُ",20,"ع",1,0],["وقناةُ ذاك القَدِّ كيف تَقوَّمت","وسِنان ذاك اللحظِ ما فُولاذه",21,"ذ",2,0],["وقَنَصتُ مُقْتَنِصِى بمثل نبالِه","حتى تَساوى في الهوى قلبانا",22,"ن",2,0],["وقنعت بالنزر اللقى","ورضيت شحّ شحيحه",23,"ح",2,0],["وقنابلٌ صرعَ القلوبَ صراخُها","ويلاهُ تمحو الدورَ والسكانا",24,"ن",2,0],["وَقَنَعْتُ مِنْكُمْ فِي الصَّبَا","بَةِ بِالتَّطَارُحِ وَالْغَزَلْ",25,"ل",1,0],["وَقَنَصْنَا بَيْنَ أَزْهَارِ الرُّبَى","قُرَّةَ الْعَيْنِ وَزَهْوَ الأَنْفُسِ",26,"س",1,0],["وَقَنا الخَطِّيِّ لَدنٌ","مَعَهُم حَدُّ كَثيرِ",27,"ر",1,0],["وَقُنوعٍ مِن حَبيبٍ","بِالمَواعيدِ الكِذابِ",28,"ب",1,0],["وقنوط ورجاء","ومشيب وشباب",29,"ب",1,0],["وَقَنِّعِ النَفسَ وَكُن مُذكِياً","عَلى مَواليها بِما عَنكَ فَضَل",30,"ل",1,0],["وقنا الاسوا وجنبنا الهوى","واجعل التقوى غذانا والزلال",31,"ل",1,0],["وقنعتُ منه بزورةٍ مُزْوَرّةٍ","قد سدّ عنها شوقه ينبوعَه",32,"ع",2,0],["وقَناً إِذَا اقْتَضَتِ العُدَاة نفوسَها","لَمْ يعتَلِلْ بأَدائِهِنَّ مِطالُ",33,"ل",1,0],["وقَنَّعَ وَجْهِي قَناعَاتِ حُرٍّ","فَقَنَّعَ دُوني وُجُوهَ العَطاءِ",34,"ا",2,0],["وقنعني برزق من","ك لو من حثوة الترب",35,"ب",1,0],["وقناة بارعة العلا قد حطمت","ولكم غدت بعلاك وهي تقوم",36,"م",1,0],["وقناعةٌ بالعفو تؤذن أنها","للفضل إن الحرص للنقصانِ",37,"ن",1,0],["وقنِعتُ من قِسم الزمان به","مذ صار من أبنائه قِسمي",38,"م",2,0],["وقنعت بالنظر الخفيّ تنزُّها","ووهبتُ طيبَ حرامه لحلاله",39,"ل",2,0],["وقنا الخطِّ ثاقباتُ المواضي","والمواضي بوارقٌ ذاتُ لمع",40,"ع",1,0],["وقناه كسامعي مدحهِ تختال","سكراً وما سقين مداما",41,"م",2,0],["وقنعت منها بالشريط محليا","صدر الشريف فزدته تنويرا",42,"ر",2,0],["وقنّعَ بالدُجى شمسَ المُحيّا","فبرقَعَ بالضُحى ليلَ القَذالِ",43,"ل",1,0],["وقنيصة لولا الخلافة لم تكن","أبداً لتعلق في حبال الصائد",44,"د",1,0],["وقُنّعتُ منه بِالمَخوفِ كأنّني","تقنّعتُ من طاقاتِهِ بالأراقمِ",45,"م",1,0],["وقنعتُ منهمْ بالقليل ولم أكنْ","أرضى قُبَيلَ فراقهمْ بقليلِ",46,"ل",1,0],["وقنعتُ من خلّي بعفوِ ودادِهِ","لا بالّذي يجفو عليه ويثقلُ",47,"ل",1,0],["وقنعت منها بالسّلامِ لو اِنّه","أروى صَدى أو بلّ لَهْفَ لهيفِ",48,"ف",1,0],["وقنعتُ منهُ بزَوْرَةٍ","عَرَضتْ ولم تكُ في حسابي",49,"ب",2,0],["وقنعنا من رؤْية الطَّيفِ بالطَّيْ","فِ وقد تَخْلُفُ الشموسُ الأَهلَّه",50,"ل",2,0]]}