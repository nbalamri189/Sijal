{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[4,"لم تبين عن أهلها الأطلال","https://www.aldiwan.net/poem21185.html","الخفيف"],[89,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[56,"وقنان زواهر هن بالشم","https://www.aldiwan.net/poem58540.html","الخفيف"],[43,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[43,"غاضت أنامله وهن بحور","https://www.aldiwan.net/poem9574.html","الكامل"],[49,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[22,"ألا هبت أمامة بعد هدء","https://www.aldiwan.net/poem21664.html","الوافر"],[52,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""]],"verses":[["وَقَنيصُها لَهُمُ قِرىً","وَظُهورُها لَهُمُ حُصونُ",0,"ن",1,0],["وَقَناةٍ صَمّاءَ تَطعَنُ في الخَط","بِ خِلاجاً عَلى الزَمانِ وَشَزرا",1,"ر",2,0],["وَقَناةٌ تَبغي بِحَربَةَ عَهداً","مِن ضَبوحٍ قَفّى عَلَيهِ الخَبالُ",2,"ل",1,0],["وقنابر الروض الاريض","صواعد ونوازل",3,"ل",1,0],["وقنطت من مرجوّ عودك يا علي","ورجوع بيتك ظافر الرايات",4,"ت",1,0],["وَقَناةً صَعدَةٌ لَو وُهِبَت","لِلسِماكِ الأَعزَلِ اِختالَ وَتاها",5,"ا",3,0],["وقَنَانٍ زَوَاهِرٍ هُنَّ بالشّمْ","سِ مِنَ الشّمْسِ بالقَلائِدِ أَحْكَى",6,"ك",2,1],["وَقَنا الخَطِّ في مَراكِزِها حَو","لَكَ وَالمُرهَفاتُ في الأَغمادِ",7,"د",1,0],["وَقَنِعتُ بِاللُقيا وَأَوَّلِ نَظرَةٍ","إِنَّ القَليلَ مِنَ الحَبيبِ كَثيرُ",8,"ر",1,0],["وَقَنوعُ المَرءِ يَحمي عِرضَهُ","ما القَريرُ العَينِ إِلّا مَن قَنِع",9,"ع",1,0],["وَقَنَّعَني القَتيرُ خِمارَ شَيبٍ","وَوَدَّعَني الشَبابُ وَرَقَّ عَظمي",10,"م",2,0],["وَقَناةٍ فَوقَها كَوكَبُها","وَمِجَنٍّ كُلُّ هَذا في بِلادي",11,"ي",1,0],["وَقَناً جُردٍ وَخَيلٍ ضُمَّرٍ","شُزَّبٍ مِن طولِ تَعلاكِ اللُجُم",12,"م",1,0],["وقناعةٍ مِنْ قِسمةٍ","لَكِ عِنْدَ خَيْرِ مُوَزِّعِ",13,"ع",1,0],["وقناةً جَلَّ من ثَقَّفها","للحِفاظِ المُرِّ والعزم المكين",14,"ن",1,0],["وقناني الخمرِ التي عَصَرُها","من دُموعي ومن دُموعِكِ تُقْنَى",15,"ن",2,0]]}