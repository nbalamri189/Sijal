{"poems":[[50,"أنعت كلبا أهله من كده","https://www.aldiwan.net/poem63250.html","الرجز"],[376,"بين نشو الغنا ونشو المعالي","https://www.aldiwan.net/poem57181.html","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59148","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136820",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133163","الرمل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""]],"verses":[["ذا غُرَّةٍ مُحَجَّلاً بِزَندِهِ","تَلَذُّ مِنهُ العَينُ حُسنَ قَدِّهِ",0,"د",2,0],["ذا غِناءٌ وَذا غِناء ولَم يَب","قَ سِوَى ذَينِ منيةٌ لِلرِّجالِ",1,"ل",1,0],["ذَا غَرْسَةُ البَارِي القديرِ وَمَنْ يَرُمْ","قَلْعاً لما غَرَسَ الإلهُ فقَدْ كَفَرْ",2,"ر",1,0],["ذا غالب الأَبطال في سَهل الحجى","فَالفكر مِنهُ اسهمٌ وَقَواضبُ",3,"ب",1,0],["ذا غناء يا فضيضه صوتش أو نغمة العود","أو سرت لي سريه من مزامير داود",4,"د",1,1],["ذا غرامٍ لم يزل أيامه","في صباباتٍ وتبريحٍ وعي",5,"ي",1,0],["ذا غرامي طفلا غلاماً وشيخاً","وصبياً فتى وكهلاً ويافع",6,"ع",1,0],["ذَا غُصْنُ زّيْتُونٍ يُطِلُّ بِرَأْسِهِ","يَرْجُو سَلَامًا فَرَّ مِنْ مَسْرَاكِ",7,"ك",1,0]]}