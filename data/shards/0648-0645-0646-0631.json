{"poems":[[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[53,"لعل الدهر أمضى منك غربا","https://www.aldiwan.net/poem30706.html","الوافر"],[53,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[63,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[63,"تأملت الورى جيلا فجيلا","https://www.aldiwan.net/poem46180.html","الوافر"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[57,"قنعت بالقوت من زماني","https://www.aldiwan.net/poem24630.html","مجزوء البسيط"],[77,"ماذا لقينا بماغوس من اللغط","https://www.aldiwan.net/poem36393.html","البسيط"],[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[77,"عسى خطرة بالركب يا حادي العيس","https://www.aldiwan.net/poem35882.html","الطويل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[83,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[51,"حتى علوتهم بالسيف فانتبهوا","https://www.aldiwan.net/poem61927.html","البسيط"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"مديحك من تعتفي فضله","https://www.aldiwan.net/poem64543.html","المتقارب"],[51,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"إني أراك بعين لا يراك بها","https://www.aldiwan.net/poem66345.html","البسيط"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[62,"رأى الله لي فيما يراه لي العدى","https://www.aldiwan.net/poem52433.html","الطويل"],[45,"واسوأتا من رأيك العازب","https://www.aldiwan.net/poem10893.html","السريع"],[45,"أما وهذا الزمان يمتحنه","https://www.aldiwan.net/poem66844.html","البسيط"],[49,"أراعك نقص منك لما وجدته","https://www.aldiwan.net/poem62052.html","البسيط"],[66,"أيا ابن الكرام الكماة الحماة","https://www.aldiwan.net/poem39059.html","المتقارب"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[80,"ومن راقصات ساحبات ذيولها","https://www.aldiwan.net/poem31503.html","الطويل"],[69,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[69,"يا جامع الحسن أما","https://www.aldiwan.net/poem28853.html","مجزوء الرجز"],[52,"ألا تريان البرق ما هو صانع","https://www.aldiwan.net/poem26872.html","الطويل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[15,"لمن دمنة أقوت بحرة ضرغد","https://www.aldiwan.net/poem45272.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55076","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[51,"مديحُك من تعتفي فضلَه","https://www.poetsgate.com/ViewPoem.aspx?id=29212",""],[75,"تقدّم خطى ً أو تأخّر خطى ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10782&r=&rc=2",""]],"verses":[["وَمَن رَدَّ النَقائِذَ بَعدَ يَأسٍ","وَقَد جاوَزنَ ضُوراً وَالوِلاجا",0,"ج",2,0],["وَمَن رَجَمَ السَماءَ فَلا عَجيبٌ","يُقالُ حَثا بِوَجهِ البَدرِ تُربا",1,"ب",2,0],["وَمِن رِفقَةٍ نَجديَّةٍ بَدَويَّةٍ","تُفَوِضُنا أَشجانَها وَاِكتِئابَها",2,"ب",3,0],["ومَنْ رامَ ما أسْمُو إلَيْهِ أزارَهُ","صَوارِمَ تَرْوى بالنّجيعِ ظِماؤُها",3,"ا",3,0],["ومَن راقَتْهُ ضَجْعَتُهُ بِدارٍ","يُقِلُّ المَشْرَفيُّ بِها صَليلا",4,"ل",2,0],["ومِنْ رَشأٍ يَثْني عليَّ وِشاحَهُ","بِما حدَّثَتْهُ عنهُ مِنْ عِفَّتي أُزْرُ",5,"ر",1,0],["وَمَن رَآني بِعَينِ نَقصٍ","رَأَيتُهُ بِالَّتي رَآني",6,"ي",1,0],["وَمَن رَآني بِعَينِ تَمٍّ","رَأَيتُهُ كامِلَ المَعاني",6,"ي",1,0],["وَمِنْ رَدَاءَةِ مَاءٍ لاَ يَسُوغُ لَنَا","شَرَابُ جُرْعَتِهِ إِلاَّ عَلَى شَطَطِ",7,"ط",1,0],["ومِنْ رُعْبِهِ الأوثانُ خرّتْ مَهابَةً","ومنْ هوْلِهِ إيوانُ فارِسَ قدْ هُدّا",8,"د",2,0],["ومَنْ رابَحَ الأيّامَ يا ابْنَةَ عامِرِ","بجَوْبِ الفَلا راحَتْ يَداهُ بتَفْليسِ",9,"س",1,0],["ومَن رآهُ أمامَ القِدْرِ مُنبَطِحاً","والنارُ تَأْخُذُ منه وهو يُذْكيها",10,"ي",3,0],["وَمِنْ رَفِيقِ صِباً مَا زِلْتُ مِنْ قِدَمٍ","أَرْعَاهُ رَعيَ أَخٍ بَرٍّ وَيَرْعَانِي",11,"ي",1,0],["وَمِن رَملَةٍ عَذراءَ مَن كُلِّ مَطلَعٍ","فَيُمرُقنَ مِن هاري التُرابِ رُكامِ",12,"م",1,0],["ومن رقا جبل المنيف","الدني ياخذ بالنظر",13,"ر",1,0],["ومن رام في سوق المعالي تجارة","فليس سوى بيض المساعي نقودها",14,"د",3,0],["ومن راح ذا حرص وجبن فإنه","فقير أتاه الفقر من كل جانبِ",15,"ب",1,0],["ومَن راغم الشيطانَ مثلك لم يُجب","رُقاهُ ولم يَتْبع له خُطواتِ",16,"ت",1,0],["ومن رام تشييد البناء وأُسُّهُ","ضعيفٌ فما يبنيه أَوَّلُ منهدِّ",17,"د",1,0],["ومن رعى غنماً في أرض مَسْبَعَةٍ","ونام عنها تولَّى رعيها الأسدُ",18,"د",1,0],["ومن رآه فلم يسمح بمهجته","ومن تخلف عنه غير مقتسَر",19,"ر",1,0],["ومن رام بالشعر رِفْد امرئٍ","ففي جوعه عنده مغْمَزُ",20,"ز",1,0],["وَمَنْ رعى حيث لا أمانَ له","فلا زلتَ بمرعىً مجانبٍ شركا",21,"ك",2,0],["ومَنْ رام ثَلْمِي وانتقاصي فإنَّني","لمُنْتَقِصٌ ما اسطعتُ منه وثالمُ",22,"م",1,0],["ومن رآكَ بعينٍ غير كاذبة","رأى الذي كُلُّ شيء بعده أممُ",23,"م",1,0],["وَمَن رَكِبَ الثَورَ بَعدَ الجَوادِ","أَنكَرَ أَظلافَهُ وَالغَبَب",24,"ب",1,0],["ومن رام أنْ يستبقيَ الودَّ من أخٍ","تعوَّدَ أن ينقادَ طوعَ الحزائمِ",25,"م",1,0],["ومن رامَ ما لا بُدَّ منهُ فما لَهُ","من الصْبرِ بُدٌّ طالَ أم قَصُرَ المَدى",26,"د",2,0],["وَمِن رَشيقٍ وَهوَ مُستَقدِمٌ","يَبصُقُ في شَعرِ اِستِكَ الشائِبِ",27,"ب",1,0],["وَمَن رَضيتُ السَقامَ في بَدَني","مِنهُ إِذا كانَ سالِماً بَدَنُه",28,"ن",2,0],["وَمِن رُشدِ رَأيِ المَرءِ أَن يَمحَضَ التُقى","وَإِنَّ امرَأً مَحضَ التُقى لَسَعيدُ",29,"د",1,0],["وَمَن رَأيُهُ في الأُمورِ الجِسامِ","سُبُلُ النَجاحِ وَسُفُنُ النَجاةِ",30,"ه",1,0],["وَمَن رَوَت فَضلَهُ حُسّادُ رُتبَتِهِ","وَعَنعَنَت عَن أَياديهِ الأَسانيدُ",31,"د",1,0],["وَمَن رَقي في الطِباقِ السَبعِ مَنزِلَةً","ما كانَ قَطَّ إِلَيها قَبلَ ذاكَ رَقي",32,"ق",2,0],["ومن راقصاتٍ ساحباتٍ ذيولَها","شوادٍ بمسكٍ في العبير تَضَمّخُ",33,"خ",1,1],["وَمَنْ رمى الأشياءَ عنْ قلبه","فعندهُ الوحدةُ مثلُ الزحامْ",34,"م",1,0],["وَمَنْ رأى وَهْوَ ذو لبٍّ يصدِّقُهُ","كالسيفِ دلَّ على التأثيرِ بالأُثُرِ",35,"ر",1,0],["ومَنْ رأى شعراً سجا","منكَ فللهِ سجدْ",36,"د",1,0],["وَمِن رَحمَةِ اللَهِ الَّتي أَنا آمِلٌ","وَمُنتَظِرٌ قُربَ المَزارِ وَإِن شَطّوا",37,"ط",3,0],["ومِنْ رِفْقِها أنّها لا تُحَسُّ","ومِنْ عَدْوِها أنّها لا تُرَى",38,"ا",1,0],["وَمَن رُزِقَ البَنينِ فَغَيرُ ناءٍ","بِذَلِكَ عَن نَوائِبَ مُسقِماتِ",39,"ت",1,0],["وَمَن رامَ ظُلمي مِنهُمُ فَكَأَنَّما","تَوَقَّصَ حيناً مِن شَواهِقِ صِندِدِ",40,"د",1,0],["ومن رمى الكعبة بالحجارهْ","وذعر البيت وراع جاره",41,"ه",1,0],["وَمَنْ رَامَ نَيْلَ الْعِزِّ فَلْيَصْطَبِرْ عَلَى","لِقَاءِ الْمَنَايَا وَاقْتِحَامِ الْمَضَايِقِ",42,"ق",1,0],["وَمِنْ رَسَائِلَ فِي فَنٍّ وفِي لُغَةٍ","سِيقَتْ لإِقْرَارِ رَأْيٍ أَوْ لِتَفْنِيدِ",43,"د",1,0],["وَمِنْ رحِيقٍ شَافٍ أَمنْتُ بِهِ","هُمُومَ لَيْلَى وَصوْلَةَ الأَرقِ",44,"ق",1,0],["ومَنْ رَمَى بالشوْكِ في مَضْجَعِي","فَبِتُّ مَكْلُومَ الْحَشَا مُوجَعَا",45,"ع",2,0],["ومَنْ رامَ تصويرَ الملائِكِ جاهداً","فكيف له أنْ يُحكِمَ النقشَ والرسمْا",46,"م",2,0],["ومن رام لَحْمَ الكَواسر زادًا","لَهُ، تَكُ أشلاؤُه زادها",47,"د",3,0],["ومن رام بالشعر رِفْد امرىء ٍ","ففي جوده عنده مَغْمَز",48,"ز",1,0],["ومِنْ رِفْقِهاأنها لا تُحَسُّ","ومِنْ عَدْوِها أمّها لا تُرَى",49,"ا",1,0]]}