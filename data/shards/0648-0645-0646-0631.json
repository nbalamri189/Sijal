ن تلم نوازله","https://www.aldiwan.net/poem2576.html","الطويل"],[440,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[440,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[442,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[459,"يا صاحبي عرجا بي ساعة","https://www.aldiwan.net/poem55815.html","الرجز"],[459,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[462,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[469,"يا أيها البدر الذي","https://www.aldiwan.net/poem60053.html","مجزوء الرجز"],[478,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[478,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[483,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[483,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[501,"بمعراجنا طر أنت للفلك الأعلى","https://www.aldiwan.net/poem37813.html","الطويل"],[516,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[530,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[539,"يوم بحلوان نقضيه على ظمإ","https://www.aldiwan.net/poem47598.html","عموديه"],[552,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[552,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[559,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"],[565,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[568,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[576,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["وَمَن رَدَّ النَقائِذَ بَعدَ يَأسٍ","وَقَد جاوَزنَ ضُوراً وَالوِلاجا",0,"ج",2,0],["وَمَن رَجَمَ السَماءَ فَلا عَجيبٌ","يُقالُ حَثا بِوَجهِ البَدرِ تُربا",1,"ب",2,0],["وَمِن رِفقَةٍ نَجديَّةٍ بَدَويَّةٍ","تُفَوِضُنا أَشجانَها وَاِكتِئابَها",2,"ب",3,0],["ومَنْ رامَ ما أسْمُو إلَيْهِ أزارَهُ","صَوارِمَ تَرْوى بالنّجيعِ ظِماؤُها",3,"ا",3,0],["ومَن راقَتْهُ ضَجْعَتُهُ بِدارٍ","يُقِلُّ المَشْرَفيُّ بِها صَليلا",4,"ل",2,0],["ومِنْ رَشأٍ يَثْني عليَّ وِشاحَهُ","بِما حدَّثَتْهُ عنهُ مِنْ عِفَّتي أُزْرُ",5,"ر",1,0],["وَمَن رَآني بِعَينِ نَقصٍ","رَأَيتُهُ بِالَّتي رَآني",6,"ن",2,0],["وَمَن رَآني بِعَينِ تَمٍّ","رَأَيتُهُ كامِلَ المَعاني",6,"ن",2,0],["وَمِنْ رَدَاءَةِ مَاءٍ لاَ يَسُوغُ لَنَا","شَرَابُ جُرْعَتِهِ إِلاَّ عَلَى شَطَطِ",7,"ط",1,0],["ومِنْ رُعْبِهِ الأوثانُ خرّتْ مَهابَةً","ومنْ هوْلِهِ إيوانُ فارِسَ قدْ هُدّا",8,"د",2,0],["ومَنْ رابَحَ الأيّامَ يا ابْنَةَ عامِرِ","بجَوْبِ الفَلا راحَتْ يَداهُ بتَفْليسِ",9,"س",1,0],["ومَن رآهُ أمامَ القِدْرِ مُنبَطِحاً","والنارُ تَأْخُذُ منه وهو يُذْكيها",10,"ي",3,0],["وَمِنْ رَفِيقِ صِباً مَا زِلْتُ مِنْ قِدَمٍ","أَرْعَاهُ رَعيَ أَخٍ بَرٍّ وَيَرْعَانِي",11,"ن",2,0],["وَمِن رَملَةٍ عَذراءَ مَن كُلِّ مَطلَعٍ","فَيُمرُقنَ مِن هاري التُرابِ رُكامِ",12,"م",1,0],["ومن رقا جبل المنيف","الدني ياخذ بالنظر",13,"ر",1,0],["ومن رام في سوق المعالي تجارة","فليس سوى بيض المساعي نقودها",14,"د",3,0],["ومن راح ذا حرص وجبن فإنه","فقير أتاه الفقر من كل جانبِ",15,"ب",1,0],["ومَن راغم الشيطانَ مثلك لم يُجب","رُقاهُ ولم يَتْبع له خُطواتِ",16,"ت",1,0],["ومن رام تشييد البناء وأُسُّهُ","ضعيفٌ فما يبنيه أَوَّلُ منهدِّ",17,"د",1,0],["ومن رعى غنماً في أرض مَسْبَعَةٍ","ونام عنها تولَّى رعيها الأسدُ",18,"د",1,0],["ومن رآه فلم يسمح بمهجته","ومن تخلف عنه غير مقتسَر",19,"ر",1,0],["ومن رام بالشعر رِفْد امرئٍ","ففي جوعه عنده مغْمَزُ",20,"ز",1,0],["وَمَنْ رعى حيث لا أمانَ له","فلا زلتَ بمرعىً مجانبٍ شركا",21,"ك",2,0],["ومَنْ رام ثَلْمِي وانتقاصي فإنَّني","لمُنْتَقِصٌ ما اسطعتُ منه وثالمُ",22,"م",1,0],["ومن رآكَ بعينٍ غير كاذبة","رأى الذي كُلُّ شيء بعده أممُ",23,"م",1,0],["وَمَن رَكِبَ الثَورَ بَعدَ الجَوادِ","أَنكَرَ أَظلافَهُ وَالغَبَب",24,"ب",1,0],["ومن رام أنْ يستبقيَ الودَّ من أخٍ","تعوَّدَ أن ينقادَ طوعَ الحزائمِ",25,"م",1,0],["ومن رامَ ما لا بُدَّ منهُ فما لَهُ","من الصْبرِ بُدٌّ طالَ أم قَصُرَ المَدى",26,"د",2,0],["وَمِن رَشيقٍ وَهوَ مُستَقدِمٌ","يَبصُقُ في شَعرِ اِستِكَ الشائِبِ",27,"ب",1,0],["وَمَن رَضيتُ السَقامَ في بَدَني","مِنهُ إِذا كانَ سالِماً بَدَنُه",28,"ن",2,0],["وَمِن رُشدِ رَأيِ المَرءِ أَن يَمحَضَ التُقى","وَإِنَّ امرَأً مَحضَ التُقى لَسَعيدُ",29,"د",1,0],["وَمَن رَأيُهُ في الأُمورِ الجِسامِ","سُبُلُ النَجاحِ وَسُفُنُ النَجاةِ",30,"ه",1,0],["وَمَن رَوَت فَضلَهُ حُسّادُ رُتبَتِهِ","وَعَنعَنَت عَن أَياديهِ الأَسانيدُ",31,"د",1,0],["وَمَن رَقي في الطِباقِ السَبعِ مَنزِلَةً","ما كانَ قَطَّ إِلَيها قَبلَ ذاكَ رَقي",32,"ق",2,0],["ومن راقصاتٍ ساحباتٍ ذيولَها","شوادٍ بمسكٍ في العبير تَضَمّخُ",33,"خ",1,1],["وَمَنْ رمى الأشياءَ عنْ قلبه","فعندهُ الوحدةُ مثلُ الزحامْ",34,"م",1,0],["وَمَنْ رأى وَهْوَ ذو لبٍّ يصدِّقُهُ","كالسيفِ دلَّ على التأثيرِ بالأُثُرِ",35,"ر",1,0],["ومَنْ رأى شعراً سجا","منكَ فللهِ سجدْ",36,"د",1,0],["وَمِن رَحمَةِ اللَهِ الَّتي أَنا آمِلٌ","وَمُنتَظِرٌ قُربَ المَزارِ وَإِن شَطّوا",37,"ط",3,0],["ومِنْ رِفْقِها أنّها لا تُحَسُّ","ومِنْ عَدْوِها أنّها لا تُرَى",38,"ا",1,0],["وَمَن رُزِقَ البَنينِ فَغَيرُ ناءٍ","بِذَلِكَ عَن نَوائِبَ مُسقِماتِ",39,"ت",1,0],["وَمَن رامَ ظُلمي مِنهُمُ فَكَأَنَّما","تَوَقَّصَ حيناً مِن شَواهِقِ صِندِدِ",40,"د",1,0],["ومن رمى الكعبة بالحجارهْ","وذعر البيت وراع جاره",41,"ه",1,0],["وَمَنْ رَامَ نَيْلَ الْعِزِّ فَلْيَصْطَبِرْ عَلَى","لِقَاءِ الْمَنَايَا وَاقْتِحَامِ الْمَضَايِقِ",42,"ق",1,0],["وَمِنْ رَسَائِلَ فِي فَنٍّ وفِي لُغَةٍ","سِيقَتْ لإِقْرَارِ رَأْيٍ أَوْ لِتَفْنِيدِ",43,"د",1,0],["وَمِنْ رحِيقٍ شَافٍ أَمنْتُ بِهِ","هُمُومَ لَيْلَى وَصوْلَةَ الأَرقِ",44,"ق",1,0],["ومَنْ رَمَى بالشوْكِ في مَضْجَعِي","فَبِتُّ مَكْلُومَ الْحَشَا مُوجَعَا",45,"ع",2,0],["ومَنْ رامَ تصويرَ الملائِكِ جاهداً","فكيف له أنْ يُحكِمَ النقشَ والرسمْا",46,"م",2,0],["ومن رام لَحْمَ الكَواسر زادًا","لَهُ، تَكُ أشلاؤُه زادها",47,"د",3,0],["ومن رام بالشعر رِفْد امرىء ٍ","ففي جوده عنده مَغْمَز",48,"ز",1,0],["ومِنْ رِفْقِهاأنها لا تُحَسُّ","ومِنْ عَدْوِها أمّها لا تُرَى",49,"ا",1,0],["ومن رأى سوء حالي","وكيف صرت غلامك",50,"ك",1,0],["ومِن رَاءٍ وحَاءِ مِيمٍ ويَاءٍ","عَرَاني مَا دَهَاني إِذ عَرَاني",51,"ن",2,0],["وَمِن رَهبَةِ التَقصيرِ عاوَدتُ قائِلاً","وَلَم تَحوِ شَرواها العُصورُ الذَواهِبُ",52,"ب",1,0],["وَمَن رَأى بَعثَهُ الكَتائِبَ لا","يَنفَعُ حامَت عَن نَفسِهِ الكُتُبُ",53,"ب",1,0],["ومن رامَ إلالاً لنا قلتُ حسبنا","إله الورى والجدّا أنعم به ذخرا",54,"ر",2,0],["ومن رمى ما فوقه بحجر","عاد على هامته ملبا",55,"ب",2,0],["ومن رام أولادا بغير تناكح","فذاك امرء في الرأس يستوجب الكيا",56,"ي",2,0],["ومن ربه في عونه فعدوه","شقي تلاقى من شقاه القواصما",57,"م",2,0],["ومن رمى حجراتٍ فوقه بطراً","صحا إِذا شجّهُ منهنَّ ما رجَعا",58,"ع",2,0],["ومن رام العلا فليمش فيها","كمشى الناصر الملك السماح",59,"ح",1,0],["وَمَن رَهطكَ الأَدنى الَّذي لَكَ فَخرُهُ","وَنابِهُ قَدرٍ لا يُساوِيهِ خامِلُه",60,"ل",2,0],["وَمَن رامَ طولَ العُمرِ بِالذُلِّ وَالغَبا","رَأى المَوتَ مَرأَىً عاجِلاً وَمُؤَجَّلا",61,"ل",2,0],["وَمَن رَأَى الضَيمَ عاراً لَم تَمُرَّ بِهِ","شَرارَةٌ مِنهُ إلّا خالَها أُطُما",62,"م",2,0],["وَمِن رقّةٍ في الدينِ وَالعرضِ أَصبحوا","بِأَنفُسهم كلٌّ غَدا حاكماً حرّا",63,"ر",2,0],["ومن رأى ذلته صحبهُ","فربما هانَ على صحبهِ",64,"ب",2,0],["ومن روتْهُ مرضَعةُ المعاصي","فقد جاءَتهُ أيَّامُ الفِطامِ",65,"م",1,0],["ومن رحيقي فارشف","يا أيها النحل",66,"ل",1,0],["ومن رشإ تصيّره الرزايا","وقيذ الشيب في شرخ الشباب",67,"ب",1,0],["وَمَنْ رَامَ نَيْلَ العِزّ لم يطوِ قَلْبَهُ","على وَجَلٍ والدارعونَ تَصَادَمُ",68,"م",1,0],["ومن رامَ في أيامِهِ نيلَ مَعْقِلٍ","سَقاه قَنَاةَ الموتَ كَرْهاً فَسَاغَهُ",69,"ه",1,0],["وَمن رِمالٍ كثُرت حَولَها","فحبّ أختي هو لي أَكثَرُ",70,"ر",1,0],["ومِنْ رِيقَتِهِ خَمْرٌ","ومِن خَدَّيهِ رَيْحان",71,"ن",1,0],["وَمَن رَأى دونَ سَلعٍ","ظِباءَ رَملٍ سَوانِح",72,"ح",1,0],["وَمَنْ رَامَ إِخْفَاءَ بَدْرِ الدَّيَاجِي","بِجُنْحِ دُجىً زَادَ نُوراً كَثِيرَا",73,"ر",2,0],["وَمَنْ رَوى الْمَجْدَ عَنْ سُرَاةٍ","قَدْ أَشْرَقَتْ بِهِمُ الْجَزِيرَهْ",74,"ر",2,0],["ومن رام إحياء الشعوب فلا أرى","يتم له وسط البداوة مطلب",75,"ب",1,0],["ومن رام في أمر معيناً على المنى","والا المنايا فالأغر المحجل",76,"ل",1,0],["ومن رام اخراج الزَكاة وَلَم يجد","نصابا يزكيه فمن أَينَ يخرج",77,"ج",1,0],["ومَنْ رامَ يحيى كَعْبَةً لِطَوافِه","غدا لا يُهابُ الهَضْم في ذَرْوَة الهَضْبِ",78,"ب",1,0],["وَمَن رَمى بِقَوافيهِ إِلى حَلَبٍ","يَحلُب بِها خَيرَ دَرٍّ مِن أَمانيهِ",79,"ي",2,0],["وَمَن رامَ مِن بَحرِ المَكارِمِ رَيَّهُ","فَما هُوَ فيما رامَهُ مِنهُ مُشتَطُّ",80,"ط",1,0],["ومَن ركبَ العجوزَ فَلا يُبالي","إذا ما اِضطرَّ من أَكلِ العجوزِ",81,"ز",1,1],["وَمَن رَآني والحِمَارُ مَرْكَبِي","وَزُرْقتي لِلرُّومِ عِرْقٌ قَدْ ضَرَبْ",82,"ب",1,1],["وَمِن روحِ أَنفاسي بِذِكرِ أَحِبَّتي","إِلى نَشرِ أَرواحِ المُحِبّينَ نافِخُ",83,"خ",1,0],["وَمِن راووقِها يَذهَ","بُ ما بِالسَمعِ مِن وَقَرِ",84,"ر",1,0],["وَمَن رَامَ النُّهوضَ بلا جَنَاحٍ","كَمَن رَكِبَ الجَموحَ بلا لِجَامِ",85,"م",1,0],["ومَن رِفْدُه وَقْفٌ على كُلّ طالبٍ","ومَن حُبُّه فرضٌ على كُلّ عابد",86,"د",1,0],["ومَن رام نَزْعَ الثّوبِ يَدْخُلْ بوَجهه","وكفّيهِ فيه دَخلةً ثمَّ يُخْرج",87,"ج",1,0],["وَمِن رَأيِ قَلبي أَن يُقَبِّلَ تُرْبَهُ","فَيُرسِلَ ثَغرَ الدَمعِ عَنهُ مُقَبِّلا",88,"ل",2,0],["ومن روض التجارات","تحفة عند تفه",89,"ف",2,0],["ومن ركب الأشواق لم يَرَ شُقَّةً","وإن عطبت في كل نجد مطاياه",90,"ا",2,0],["وَمَن رأى تاج المَعالي عَلى","مَفرق لَيث فَوقَ طَرَف النَجاح",91,"ح",1,0],["ومن رَاقَه خِلٌّ يُسَرُّ بِقُربِهِ","فيا ويحَ قلبي من فِراق الأقَارِبِ",92,"ب",1,0],["وَمِن رَكضِنا والخَيلَ في كُلِّ غارَةٍ","حَلالٌ بِأَرضٍ المُشرِكينَ نَهابُها",93,"ب",3,0],["ومن رشفاتٍ ترشَّفتها","تبلُّ غليلي وتأسو جراحي",94,"ح",2,0],["ومن راح يستهديك للجود والندى","رآك إلى الخيرات أهدى وأصوبا",95,"ب",2,0],["ومن رام ضم المعطفين فشاكر","يميس كخوط البان بالخصر والقد",96,"د",1,0],["ومن راية تستأصل الشمس نورها","ومن جوده يهمي من الغيث وابلُه",97,"ل",2,0],["ومَنْ رَفَعَ الأعلامَ فِي السَّلْمِ والوغى","لِيجعلَها للحقِّ والعدلِ سُلَّما",98,"م",2,0],["ومن رَتَقَ الفتْقَ الَّذِي أَعْجَزَ الورى","وأعْدَمَ فِيهِ الدَّهْرُ حِيلَةَ مُحْتالِ",99,"ل",1,0],["ومن رَدَّ فِي جسمِ المكارِمِ رُوحَهُ","فلا عُذْرَ للباكِي ولا ذَنْبَ للسَّالي",99,"ل",2,0],["ومن ركِبَ الفُلْكَ السَّوابِحَ فِي الوغَى","إِلَى كلِّ هَوْلٍ ينتحيهِ بأَهوالِ",99,"ل",1,0],["ومِنْ رَفْرَفِ الأَسْتارِ دُونَ حِجَالِها","تَرَقْرُقَ لَمْعِ الآلِ فِي المَهْمَهِ القَفْرِ",100,"ر",1,0],["ومن راكب نعله للمنايا","كمن راكب ثم ظهر البراق",101,"ق",1,0],["ومَن رعَى الروضَ بأكنافِ الحمى","واقتنصَ النافرَ من ظُباها",102,"ا",3,0],["ومن ركب الشرَّ طالت يداه","وطارت وَخُودٌ به معنِقُ",103,"ق",1,0],["ومن ردّها وهي أمّ البلا","د أُنساً على وحشة الأربُعِ",104,"ع",1,0],["ومن رأيه في الحربِ عَضبٌ وذابلٌ","وما الحرب إلا سيفُها وقَناتُها",105,"ت",3,0],["ومن رامَ ما أبغيه فالحربُ عنده","فتاةٌ وتحطيمُ العوالي بعالُها",106,"ل",3,0],["وَمن رِياضِ خَدِّهِ","خُرَّمُها عِذارُهُ",107,"ر",2,0],["ومِن رسمِ دارٍ قد تبدَّلَ ربعها","على الكرهِ مِن سُماّرِه بالنواعبِ",108,"ب",1,0],["ومِن راحةٍ قد نهنهتْ فيضَ عبرةٍ","وأُخرى على أحشائهِ والحيازمِ",109,"م",1,0],["ومن رامنا يلقى السعادة والمنى","ويحظى بما يرضاه في كل وجهه",110,"ه",1,0],["ومن رام منحى فليرمه فعندما","يرجى التلاقي تنزوي غين شبهة",110,"ه",1,0],["ومن رام هذا البحر شاهد أسرارا","من الحق في الأكوان أعلى وأرشد",111,"د",1,0],["ومن راحَ يَروي عن أُولي الحقِّ سُنَّةً","فقِسْها على نورِ الكِتابِ هو الأَجْلى",112,"ل",2,0],["ومن رجاك لنزر يستعين به","فحكمتي في ندى كفيك تحتكم",113,"م",1,0],["ومَنْ رامَ الْجدالَ فَقَدْ تَوَلَّتْ","لَكَ الْوَيْلاتُ أَوْقاتُ الْجِدالِ",114,"ل",1,0],["ومِن رِجالِ بَيانٍ في الكَلامِ إذَا","تَكَلَّمُوا أبكَموا قُسًّا وسَحبانا",115,"ن",2,0],["ومن رأى قبل أنْ ضوّأتَ ظُلمَتَهُ","ليلاً له في الدّآدي منظرٌ يَقَقُ",116,"ق",1,0],["ومن رَفعتْ لزائره قريشٌ","سراعاً عن بنيّتهِ السِّتارا",117,"ر",2,0],["ومن رحم الله الوجود ببعثه","وكرَّمنا طراً قريباً ونائيا",118,"ي",2,0],["ومن رامنا بالسوء فالله دائماً","كما جاء في القرآن عنا يدافع",119,"ع",1,0],["ومن رد عبداً آبقاً كان أجره","عظيماً على مولاه فهو الموادع",119,"ع",1,0],["ومَن رامَ مجداً فليكُن كابن هاشمٍ","وإلاّ فلا كي لا يُقالَ دَخيلُ",120,"ل",1,0],["ومن رام مجداً لم يبال بنفسه","ولم يعره في كل مكروهة ذعر",121,"ر",1,0],["وَمَنْ رَدَّ خَالِقُنَا شَمْسَهُ","عَلَيْهِ وَقَدْ جَنَحَتْ لِلطُّفَلِ",122,"ل",1,0],["وَمَنْ رَأَى مَبْسِمَهُ","رأَى عُقُودَ الأَحْقَاقْ",123,"ق",1,0]]}