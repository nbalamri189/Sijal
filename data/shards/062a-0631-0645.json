ل ملتاع","https://www.poetsgate.com/ViewPoem.aspx?id=103543",""],[3271,"فقراء","https://www.poetsgate.com/ViewPoem.aspx?id=128734",""],[5072,"موت ُ الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=51898",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5223,"صدت سعاد وما للحال تحويل","https://www.poetsgate.com/ViewPoem.aspx?id=187501",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5351,"يأتي مع الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=202288",""],[5358,"مجرى الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=183421",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5387,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=53792",""],[5425,"بَغداد .. حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=199911",""],[5447,"نظارة","https://www.poetsgate.com/ViewPoem.aspx?id=208338",""],[5460,"خبّاب إنك قد ملحت فما ترى","https://www.poetsgate.com/ViewPoem.aspx?id=200743",""],[5542,"شموخ اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=10072",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[5573,"ياخشف اشوف ان الهوى ماله حدود","https://www.poetsgate.com/ViewPoem.aspx?id=203090",""],[5671,"أمر لعينيك عندي غير ممتثل","https://www.poetsgate.com/ViewPoem.aspx?id=169354",""],[5694,"احذر من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=132101",""],[5732,"قلب صفق","https://www.poetsgate.com/ViewPoem.aspx?id=177942",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[5843,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=51282",""],[5897,"تسابيح","https://www.poetsgate.com/ViewPoem.aspx?id=157556",""],[5922,"القراءة من المهد إلى اللحد","https://www.poetsgate.com/ViewPoem.aspx?id=185135",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5989,"حلمٌ كاذب","https://www.poetsgate.com/ViewPoem.aspx?id=182772",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6120,"يَا أَهْلَ وِدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=213820",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""],[6355,"يد أبيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66586&r=&rc=46",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""]],"verses":[["تَرمي بِأَعيُنِها إِلى","البَلَدِ اليَماني وَالشَآمِ",0,"م",1,0],["تُرَمِّمُ المالَ وَبِالقَرضِ ثُلَم","إِنّي إِذا راحَت عَلى الحَيِّ النَعَم",1,"م",1,0],["تَرمي جِبالُ الثَلجِ مِن قَدحِها","نارَ الوَغى بِالشَرَرِ المُضرَمِ",2,"م",1,0],["تَرمي الإِكامَ بِمَنسِمٍ عَمَمٍ","دامي الأَظَلَّ كَأَنَّهُ قُرصُ",3,"ص",1,0],["تَرمي حَواليكِ بأحْداقِ المَها","إذا ارْتَقَبْنَ غِرَّةَ الحَبائِلِ",4,"ل",1,0],["تَرميهِ بِالوُدِّ عَينٌ لَستُ أَملِكُها","حَتّى إِذا نَظَرَت بَغَّضتُها النَظَرا",5,"ر",2,0],["تَرُمُّ مَتاعَهُ وَتَزيدُ فيهِ","وَصاحِبُنا لِضَيعَتِها مِضَمُّ",6,"م",1,0],["تَرمي الغُيوبَ بِعَينَي مُفرَدٍ لَهَقٍ","إِذا تَوَقَدَتِ الحُزّانُ وَالميلُ",7,"ل",1,0],["تَرمي بِهِ الدُنيا فَمِن جوعٍ إِلى","عُريٍ إِلى سُقمٍ إِلى إِقلالِ",8,"ل",1,0],["تَرمي الفِجاجَ إِذا الفِجاجُ تَشابَهَت","أَعلامُها بِمَهامِهٍ أَغفالِ",9,"ل",1,0],["تَرمي بِهِ القَفرَ بَعدَ القَفرِ ناجِيَةٌ","هَوجاءُ راكِبُها وَسنانُ مَسمومُ",10,"م",1,0],["تَرميهِ بِالمورِ مِهيافٌ يَمانِيَةٌ","هَوجاءُ فيها لِباقي الرُطبِ تَجريمُ",10,"م",1,0],["تَرمي الفِجاجَ بِآذانٍ مُؤَلَّلَةٍ","وَأَعيُنٍ كُتُم ما تَشتَكي السَهَرا",11,"ر",2,0],["تَرمي السُرى بِعُنُقٍ أُملودِ","وَهامَة مَلمومَةِ الجُلمودِ",12,"د",1,0],["ترمي بها وهي الحنايا ضمّراً","مثل السهام نُزعن عن أوتارِ",13,"ر",1,0],["تَرمي بِأَعيُنِها نَجداً وَقَد قَطَعَت","بَينَ السَلَوطَحِ وَالرَوحانِ صُوّانا",14,"ن",2,0],["تَرمي خُزَيمَةُ مَن أَرمي وَيَغضَبُ لي","أَبناءُ مُرٍّ بَنو غَرّاءَ مِذكارِ",15,"ر",1,0],["تَرمي بِها قاتِمَ الموماةِ عَن عُرُضٍ","إِذا تَوَقَّدَتِ التيهُ الدَياميمُ",16,"م",1,0],["ترمي الأهلة أعمار الأنام فلا","يفوتها حذر الأحشاء فرَّار",17,"ر",1,0],["ترميهِمُ بالإفك مُطْ","طَرِحاً سَداهُمْ واحتسابهْ",18,"ب",2,0],["تَرُمُّ عظام لابسها وتُبْلي","ولا تَبْلى على أبد الأبيدِ",19,"د",1,0],["ترمين آنافنا بأسهمه","عن شر قوسٍ وشرِّ ما وتر",20,"ر",1,0],["ترمي القلوب بأسهمٍ","يصدُرْن عن قِسي المَحاجر",21,"ر",1,0],["ترمي خياشيمَه بأسْهُمها","رَمياً كرمي الرماةِ بالشاش",22,"ش",1,0],["ترمي التي إنْ أصابَ ظاهرَها","سهْمُك شكَّتْ بحدِّه كبدَكْ",23,"ك",1,0],["تَرمي العِضاةَ بِحاصِبٍ مِن ثَلجِها","حَتّى يَبيتَ عَلى العِضاهِ جُفالا",24,"ل",2,0],["تَرمي مَقاتِلِ فُرّاغٍ فَتُقصِدُهُم","وَما تُصابُ وَقَد يَرمونَ مِن كَثَبِ",25,"ب",1,0],["تَرمي بِأَشباهِ الرُجومِ تَخالُها","حَمراءَ قَد صيغَت مِنَ المُرجانِ",26,"ن",1,0],["تَرمونَهُم بِقَبيحِ الكَلامِ","وَكانوا أَحَقَّ بِضافي الثَنا",27,"ن",2,0],["ترمي يَدُ الحِدثانِ مِنهُ مُرَوَّعاً","حَلَّ العِقابُ بِهِ وَأَنتَ المُذنِبُ",28,"ب",1,0],["تَرمي الفِجاجَ بِكَحلاوَينِ لَم تَجِدا","ريحَ الدُخانِ وَلَم يَأخُذهُما رَمَدُ",29,"د",1,0],["ترمي بِعينَي مَهاةٍ أَقصدَت بِهما","قَلبي عَشِيةَ ترميني وأَرميها",30,"ي",3,0],["تَرمي البَرِيَّةَ بِالحُبولِ وَتارَةً","بِحَبائِلٍ مِن خَيطِها وَكَفافِ",31,"ف",1,0],["تَرَ مِن لِداتِكَ أُمَّةً","كَسَتِ الدِيارَ جَلالَ غابِ",32,"ب",1,0],["تَرمي بِطَرفِكَ في المَجامِعِ لا تَرى","غَيرَ التَعانُقِ وَاِشتِباكِ الراحِ",33,"ح",1,0],["تَرمي عَلى شَفَراتِ الباتِراتِ بِهِم","مَكامِنُ الأَرضِ وَالغيطانُ وَالأَكَمُ",34,"م",1,0],["ترمي بها البِيدَ منشوراً صحائفُها","فلا تمَلُّ ولا تبغي تعنِّيكا",35,"ك",2,0],["ترمي بأسجلةِ البَنانِ على القَنَا","هذا ولو أنَّ الزمانَ منازعُ",36,"ع",1,0],["ترمي به نحو المدَجَّج قاطِعاً","فيمُرُّ فيهِ كأنَّه لم يُقْطَعِ",37,"ع",1,0],["تُرمى وَتُحذَفُ بِالعِصِيِّ وَما لَها","مِن ذي المَخالِبِ فَوقَها مِن مَهرَبِ",38,"ب",1,0],["تَرمي القُلوبَ وَلا يَصطادُها أَحَدٌ","بِسَهمِ قانِصَةٍ لِلقَومِ قَتّالِ",39,"ل",1,0],["تَرمي القصورُ الواضحا","تُ بهم إلى الغُبرِ الدَّوارِس",40,"س",1,0],["ترمي بمُحمَرِّ الشَّرارِ كأنَّما","تُرمَى جوانبُها بوردٍ أحمَرِ",41,"ر",1,0],["ترمقنا فيه ظنون الأنام","ولا تخلينا عيون الحسود",42,"د",1,0],["ترْمي ببروجٍ إنْ ظَهَرَتْ","لعدوٍّ محرقةً بَطَنَا",43,"ن",2,0],["تَرْمي قلوبَهُمُ بالرّعبِ رؤيتُها","كما يَرُوعُ نياماً بالردى الحلمُ",44,"م",1,0],["تَرْمي بنفطٍ كيفَ يُبْقي لَفْحُهُ","والشَمّ منهُ مُحَرّقُ الأَكبادِ",45,"د",1,0],["تَرمي العُلى مِنهُ بِمُستَيقِظٍ","لا فاتِرِ الطَرفِ وَلا خاشِعِ",46,"ع",1,0],["تَرمي بِأَشباحِنا إِلى مَلِكٍ","نَأخُذُ مِن مالِهِ وَمِن أَدَبِه",47,"ب",2,0],["تَرمي بِهِ الغيطانُ فيها وَالرُبى","دُوَلاً كَما يَتَمَوَّجُ التَيّارُ",48,"ر",1,0],["تَرْمِي فتهدمُ كُلَّ أَرْعَنَ شاهِقٍ","ويخافُها رَيْبُ الزّمانِ إذا رَمَى",49,"م",2,0],["تَرمِي به كلَّ خفَّاقِ المَدى قَذِفٍ","ما تنتهِي سَعَةٌ منه ولا طُولُ",50,"ل",1,0],["ترمي النُّسورَ فتهوِي عن مَعاقِلها","في السُّحبِ من جبلٍ عالٍ ومن سُورِ",51,"ر",1,0],["تَرمي بِها لُجَجٌ يَظَلُّ شُواظُها","مُتَدَفِّقاً كَتَدَفُّقِ الطوفانِ",52,"ن",1,0],["تَرمي بِأَعيُنِها الفِجاجَ كَأَنَّما","جُلِبَت صَوافِنُها لِيَومِ رِهانِ",52,"ن",1,0],["تَرمي السُدودُ سَراياهُ وَيَقذِفُهُ","مِنَ الحَواجِزِ وَالأَسوارِ عاتيها",53,"ي",3,0],["تَرمي فَتَجتاحُ الأُلوفَ حَواصِداً","وَتَظَلُّ جاثِيَةً كَأَن لَم تَحصُدِ",54,"د",1,0],["تَرمي العِدى بِعُيونٍ حَشوُها ضَغَنٌ","تُبدي خَفايا قُلوبٍ مِلؤُها دَخَلُ",55,"ل",1,0],["تَرمِي الجَلامِدَ والحديدَ بِقوّةٍ","تمضِي فتصدعُ ما تشاءُ وتَقصِفُ",56,"ف",1,0],["تَرمِي به الأرضُ شيطاناً وتَقذِفُه","رِجْساً مُغَطَّى وشرّاً جاءَ مُبتدعا",57,"ع",2,0],["تَرمِي بِنفسِكَ دُون نفسِ مُحمدٍ","وتقيه من بأسِ العِدَى ما تَرهب",58,"ب",1,0],["ترْمي بمارِجها وما","غيْرَ العجاجة من دخانِ",59,"ن",1,0],["تَرمي بِغَيرِ صائِبٍ صَلاتَها","مِنَ اِلتِظاءِ النارِ في لَهاتِها",60,"ت",3,0],["تَرمي الحَبابَ بِمِثلِهِ صُعُداً","دَقَّت مَسالِكُها عَنِ النَحسِ",61,"س",1,0],["تَرمي فَتَقصِدُ مَن لَهُ قَصَدَت","جَمَّ المِراحِ دَريرَةَ السَهمِ",62,"م",1,0],["تَرمي بِعُضوَينِ ذي نُطقٍ وَذي خُرسٍ","إِلى فَمٍ لِصُنوفِ الطَعمِ فَغّارِ",63,"ر",1,0],["تَرْمِي الفِجَاجَ بِحَيْدَارِ الحَصَى قُمَزاً","في مِشْيَةٍ سُرُحٍ خَلْطٍ أَفَانِينَا",64,"ن",2,0],["تَرْمِي بِهِ وهْيَ كَالحَرْدَاءِ خَائِفَةٌ","قَذْفَ البَنَانِ الحَصَى بَيْنَ المُخَاسِينَا",64,"ن",2,0],["ترمين أرض النيل عن قوس الفلك","يوما بشيطان ويوما بملك",65,"ك",1,0],["ترمى به ركن الثرى فتفزّه","تتناثر التيجان حين تهزه",66,"ه",1,0],["تَرَ مَا أَبْقَتِ الْحَوَادِثُ مِنْ شَعْ","بٍ قَدَيمِ الأَغْلاَلِ وَالأَصْفَادِ",67,"د",1,0],["تَرَ مَا جَرَّهُ عَلَى وَحْدَةِ الْقَوْ","مِ انْفِكَاكُ العُرَى مِنَ الأَحْقَادِ",67,"د",1,0],["تَرْمِي التنُوفَةُ بِي أُخْرَى بِجانِبِهَا","وَأَقْطَعُ الْبِيدَ بَعْدَ الْجَهْدِ لِلْبيدِ",68,"د",1,0],["ترمي أوراقا ميتة","وتلوح بالورق الأنضر",69,"ر",1,0],["ترمي بنفط طيف يُبقي لفحُهُ","والشمّ منهُ مُحَرّقُ الأكباد",70,"د",1,0],["تَرمِي بما فيك ذوِي المحاتدِ","ولستَ كفؤاً لِمغيظٍ حاقدِ",71,"د",1,0],["ترمي الفجاجَ بآذانٍ مؤلَّلة ٍ","وأعينٍ كتمٍ لا تشتكي السَّدرا",72,"ر",2,0],["ترمي المجانيقُ بالأحجار فضلة من","رمتهمُ منهم الجردُ السراحيب",73,"ب",1,0],["تَرمي الوُشاةُ فَلا تُخطي مَقاتِلَهُم","بِصادِقٍ مِن صَفاءِ الوُدِّ مَكنونِ",74,"ن",1,0],["تَرْمِى بأنفسها والأُسْدُ حائرةٌ","في مَأْزَق الحرب والأرماحُ تَشتَجِرُ",75,"ر",1,0],["تَرمُونني إِن لَم أكُن حَاذِفاً","يَاءً بسَهمٍ طَائِشٍ عَاصِفِ",76,"ف",1,0],["ترمي شياطينَ الأعادي في الوغى","برجومِ خيلٍ من سماءٍ غُبارِ",77,"ر",1,0],["ترمِى بعينيك الفِجاجَ مقلِّبا","ذاتَ الشِّمال بها وذاتَ يمينِ",78,"ن",1,0],["ترمي بألحاظها عن قوس حاجبها","تصيبني ثم تسبيني وتكويني",79,"ن",2,0],["ترمى فؤادىَ أيدي حوادثِه","بأَسْهمٍ عن قِسِيِّها تُرْشَق",80,"ق",1,0],["ترمي الحوادث بي في كل بادرةٍ","ولم ازل دائباً أَبقى ويمضينا",81,"ن",2,0],["ترمقيني بالف لحظ ولحظ","أنا من كل واحد كالطعين",82,"ن",1,0],["تَرمي العِدى بِنَوافِذِ ال","عَزَماتِ مِن آرائِها",83,"ا",3,0],["تَرمي حواجبها قلب المشوق بها","فَتسلب اللب بالتَدعيج وَالكحل",84,"ل",1,0],["تَرمي بعينك في عيون مطافل","لحظاتها بالسحر تقتل من رمى",85,"م",2,0],["تَرْمِي بأَعُيُنِها فِي كُلِّ داجِيةٍ","مِنْهُ إلى كَوْكَبٍ بِالسَّعْدِ سَيّارِ",86,"ر",1,0],["تَرمي الفَلا بِسهامٍ","وَلا سِهامَ الجروخِ",87,"خ",1,0],["تَرمي لَواحِظُهُ ع