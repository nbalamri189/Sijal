0171.html","البسيط"],[430,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[433,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[438,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[453,"لله يوم في طلائعه لنا","https://www.aldiwan.net/poem13845.html","مجزوء الكامل"],[459,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[459,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[459,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[459,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[459,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[466,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[478,"قد حق للمشتاق أن يتوجعا","https://www.aldiwan.net/poem15217.html","الكامل"],[478,"ماذا الوقوف وقد بانوا على الطلل","https://www.aldiwan.net/poem15230.html","البسيط"],[501,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"]],"verses":[["تَرمي بِأَعيُنِها إِلى","البَلَدِ اليَماني وَالشَآمِ",0,"م",1,0],["تُرَمِّمُ المالَ وَبِالقَرضِ ثُلَم","إِنّي إِذا راحَت عَلى الحَيِّ النَعَم",1,"م",1,0],["تَرمي جِبالُ الثَلجِ مِن قَدحِها","نارَ الوَغى بِالشَرَرِ المُضرَمِ",2,"م",1,0],["تَرمي الإِكامَ بِمَنسِمٍ عَمَمٍ","دامي الأَظَلَّ كَأَنَّهُ قُرصُ",3,"ص",1,0],["تَرمي حَواليكِ بأحْداقِ المَها","إذا ارْتَقَبْنَ غِرَّةَ الحَبائِلِ",4,"ل",1,0],["تَرميهِ بِالوُدِّ عَينٌ لَستُ أَملِكُها","حَتّى إِذا نَظَرَت بَغَّضتُها النَظَرا",5,"ر",2,0],["تَرُمُّ مَتاعَهُ وَتَزيدُ فيهِ","وَصاحِبُنا لِضَيعَتِها مِضَمُّ",6,"م",1,0],["تَرمي الغُيوبَ بِعَينَي مُفرَدٍ لَهَقٍ","إِذا تَوَقَدَتِ الحُزّانُ وَالميلُ",7,"ل",1,0],["تَرمي بِهِ الدُنيا فَمِن جوعٍ إِلى","عُريٍ إِلى سُقمٍ إِلى إِقلالِ",8,"ل",1,0],["تَرمي الفِجاجَ إِذا الفِجاجُ تَشابَهَت","أَعلامُها بِمَهامِهٍ أَغفالِ",9,"ل",1,0],["تَرمي بِهِ القَفرَ بَعدَ القَفرِ ناجِيَةٌ","هَوجاءُ راكِبُها وَسنانُ مَسمومُ",10,"م",1,0],["تَرميهِ بِالمورِ مِهيافٌ يَمانِيَةٌ","هَوجاءُ فيها لِباقي الرُطبِ تَجريمُ",10,"م",1,0],["تَرمي الفِجاجَ بِآذانٍ مُؤَلَّلَةٍ","وَأَعيُنٍ كُتُم ما تَشتَكي السَهَرا",11,"ر",2,0],["تَرمي السُرى بِعُنُقٍ أُملودِ","وَهامَة مَلمومَةِ الجُلمودِ",12,"د",1,0],["ترمي بها وهي الحنايا ضمّراً","مثل السهام نُزعن عن أوتارِ",13,"ر",1,0],["تَرمي بِأَعيُنِها نَجداً وَقَد قَطَعَت","بَينَ السَلَوطَحِ وَالرَوحانِ صُوّانا",14,"ن",2,0],["تَرمي خُزَيمَةُ مَن أَرمي وَيَغضَبُ لي","أَبناءُ مُرٍّ بَنو غَرّاءَ مِذكارِ",15,"ر",1,0],["تَرمي بِها قاتِمَ الموماةِ عَن عُرُضٍ","إِذا تَوَقَّدَتِ التيهُ الدَياميمُ",16,"م",1,0],["ترمي الأهلة أعمار الأنام فلا","يفوتها حذر الأحشاء فرَّار",17,"ر",1,0],["ترميهِمُ بالإفك مُطْ","طَرِحاً سَداهُمْ واحتسابهْ",18,"ب",2,0],["تَرُمُّ عظام لابسها وتُبْلي","ولا تَبْلى على أبد الأبيدِ",19,"د",1,0],["ترمين آنافنا بأسهمه","عن شر قوسٍ وشرِّ ما وتر",20,"ر",1,0],["ترمي القلوب بأسهمٍ","يصدُرْن عن قِسي المَحاجر",21,"ر",1,0],["ترمي خياشيمَه بأسْهُمها","رَمياً كرمي الرماةِ بالشاش",22,"ش",1,0],["ترمي التي إنْ أصابَ ظاهرَها","سهْمُك شكَّتْ بحدِّه كبدَكْ",23,"ك",1,0],["تَرمي العِضاةَ بِحاصِبٍ مِن ثَلجِها","حَتّى يَبيتَ عَلى العِضاهِ جُفالا",24,"ل",2,0],["تَرمي مَقاتِلِ فُرّاغٍ فَتُقصِدُهُم","وَما تُصابُ وَقَد يَرمونَ مِن كَثَبِ",25,"ب",1,0],["تَرمي بِأَشباهِ الرُجومِ تَخالُها","حَمراءَ قَد صيغَت مِنَ المُرجانِ",26,"ن",1,0],["تَرمونَهُم بِقَبيحِ الكَلامِ","وَكانوا أَحَقَّ بِضافي الثَنا",27,"ن",2,0],["ترمي يَدُ الحِدثانِ مِنهُ مُرَوَّعاً","حَلَّ العِقابُ بِهِ وَأَنتَ المُذنِبُ",28,"ب",1,0],["تَرمي الفِجاجَ بِكَحلاوَينِ لَم تَجِدا","ريحَ الدُخانِ وَلَم يَأخُذهُما رَمَدُ",29,"د",1,0],["ترمي بِعينَي مَهاةٍ أَقصدَت بِهما","قَلبي عَشِيةَ ترميني وأَرميها",30,"ي",3,0],["تَرمي البَرِيَّةَ بِالحُبولِ وَتارَةً","بِحَبائِلٍ مِن خَيطِها وَكَفافِ",31,"ف",1,0],["تَرَ مِن لِداتِكَ أُمَّةً","كَسَتِ الدِيارَ جَلالَ غابِ",32,"ب",1,0],["تَرمي بِطَرفِكَ في المَجامِعِ لا تَرى","غَيرَ التَعانُقِ وَاِشتِباكِ الراحِ",33,"ح",1,0],["تَرمي عَلى شَفَراتِ الباتِراتِ بِهِم","مَكامِنُ الأَرضِ وَالغيطانُ وَالأَكَمُ",34,"م",1,0],["ترمي بها البِيدَ منشوراً صحائفُها","فلا تمَلُّ ولا تبغي تعنِّيكا",35,"ك",2,0],["ترمي بأسجلةِ البَنانِ على القَنَا","هذا ولو أنَّ الزمانَ منازعُ",36,"ع",1,0],["ترمي به نحو المدَجَّج قاطِعاً","فيمُرُّ فيهِ كأنَّه لم يُقْطَعِ",37,"ع",1,0],["تُرمى وَتُحذَفُ بِالعِصِيِّ وَما لَها","مِن ذي المَخالِبِ فَوقَها مِن مَهرَبِ",38,"ب",1,0],["تَرمي القُلوبَ وَلا يَصطادُها أَحَدٌ","بِسَهمِ قانِصَةٍ لِلقَومِ قَتّالِ",39,"ل",1,0],["تَرمي القصورُ الواضحا","تُ بهم إلى الغُبرِ الدَّوارِس",40,"س",1,0],["ترمي بمُحمَرِّ الشَّرارِ كأنَّما","تُرمَى جوانبُها بوردٍ أحمَرِ",41,"ر",1,0],["ترمقنا فيه ظنون الأنام","ولا تخلينا عيون الحسود",42,"د",1,0],["ترْمي ببروجٍ إنْ ظَهَرَتْ","لعدوٍّ محرقةً بَطَنَا",43,"ن",2,0],["تَرْمي قلوبَهُمُ بالرّعبِ رؤيتُها","كما يَرُوعُ نياماً بالردى الحلمُ",44,"م",1,0],["تَرْمي بنفطٍ كيفَ يُبْقي لَفْحُهُ","والشَمّ منهُ مُحَرّقُ الأَكبادِ",45,"د",1,0],["تَرمي العُلى مِنهُ بِمُستَيقِظٍ","لا فاتِرِ الطَرفِ وَلا خاشِعِ",46,"ع",1,0],["تَرمي بِأَشباحِنا إِلى مَلِكٍ","نَأخُذُ مِن مالِهِ وَمِن أَدَبِه",47,"ب",2,0],["تَرمي بِهِ الغيطانُ فيها وَالرُبى","دُوَلاً كَما يَتَمَوَّجُ التَيّارُ",48,"ر",1,0],["تَرْمِي فتهدمُ كُلَّ أَرْعَنَ شاهِقٍ","ويخافُها رَيْبُ الزّمانِ إذا رَمَى",49,"م",2,0],["تَرمِي به كلَّ خفَّاقِ المَدى قَذِفٍ","ما تنتهِي سَعَةٌ منه ولا طُولُ",50,"ل",1,0],["ترمي النُّسورَ فتهوِي عن مَعاقِلها","في السُّحبِ من جبلٍ عالٍ ومن سُورِ",51,"ر",1,0],["تَرمي بِها لُجَجٌ يَظَلُّ شُواظُها","مُتَدَفِّقاً كَتَدَفُّقِ الطوفانِ",52,"ن",1,0],["تَرمي بِأَعيُنِها الفِجاجَ كَأَنَّما","جُلِبَت صَوافِنُها لِيَومِ رِهانِ",52,"ن",1,0],["تَرمي السُدودُ سَراياهُ وَيَقذِفُهُ","مِنَ الحَواجِزِ وَالأَسوارِ عاتيها",53,"ي",3,0],["تَرمي فَتَجتاحُ الأُلوفَ حَواصِداً","وَتَظَلُّ جاثِيَةً كَأَن لَم تَحصُدِ",54,"د",1,0],["تَرمي العِدى بِعُيونٍ حَشوُها ضَغَنٌ","تُبدي خَفايا قُلوبٍ مِلؤُها دَخَلُ",55,"ل",1,0],["تَرمِي الجَلامِدَ والحديدَ بِقوّةٍ","تمضِي فتصدعُ ما تشاءُ وتَقصِفُ",56,"ف",1,0],["تَرمِي به الأرضُ شيطاناً وتَقذِفُه","رِجْساً مُغَطَّى وشرّاً جاءَ مُبتدعا",57,"ع",2,0],["تَرمِي بِنفسِكَ دُون نفسِ مُحمدٍ","وتقيه من بأسِ العِدَى ما تَرهب",58,"ب",1,0],["ترْمي بمارِجها وما","غيْرَ العجاجة من دخانِ",59,"ن",1,0],["تَرمي بِغَيرِ صائِبٍ صَلاتَها","مِنَ اِلتِظاءِ النارِ في لَهاتِها",60,"ت",3,0],["تَرمي الحَبابَ بِمِثلِهِ صُعُداً","دَقَّت مَسالِكُها عَنِ النَحسِ",61,"س",1,0],["تَرمي فَتَقصِدُ مَن لَهُ قَصَدَت","جَمَّ المِراحِ دَريرَةَ السَهمِ",62,"م",1,0],["تَرمي بِعُضوَينِ ذي نُطقٍ وَذي خُرسٍ","إِلى فَمٍ لِصُنوفِ الطَعمِ فَغّارِ",63,"ر",1,0],["ترمين أرض النيل عن قوس الفلك","يوما بشيطان ويوما بملك",64,"ك",1,0],["ترمى به ركن الثرى فتفزّه","تتناثر التيجان حين تهزه",65,"ه",1,0],["تَرَ مَا أَبْقَتِ الْحَوَادِثُ مِنْ شَعْ","بٍ قَدَيمِ الأَغْلاَلِ وَالأَصْفَادِ",66,"د",1,0],["تَرَ مَا جَرَّهُ عَلَى وَحْدَةِ الْقَوْ","مِ انْفِكَاكُ العُرَى مِنَ الأَحْقَادِ",66,"د",1,0],["تَرْمِي التنُوفَةُ بِي أُخْرَى بِجانِبِهَا","وَأَقْطَعُ الْبِيدَ بَعْدَ الْجَهْدِ لِلْبيدِ",67,"د",1,0],["ترمي أوراقا ميتة","وتلوح بالورق الأنضر",68,"ر",1,0],["ترمي بنفط طيف يُبقي لفحُهُ","والشمّ منهُ مُحَرّقُ الأكباد",69,"د",1,0],["تَرمِي بما فيك ذوِي المحاتدِ","ولستَ كفؤاً لِمغيظٍ حاقدِ",70,"د",1,0],["ترمي الفجاجَ بآذانٍ مؤلَّلة ٍ","وأعينٍ كتمٍ لا تشتكي السَّدرا",71,"ر",2,0],["ترمي المجانيقُ بالأحجار فضلة من","رمتهمُ منهم الجردُ السراحيب",72,"ب",1,0],["تَرمي الوُشاةُ فَلا تُخطي مَقاتِلَهُم","بِصادِقٍ مِن صَفاءِ الوُدِّ مَكنونِ",73,"ن",1,0],["تَرْمِى بأنفسها والأُسْدُ حائرةٌ","في مَأْزَق الحرب والأرماحُ تَشتَجِرُ",74,"ر",1,0],["تَرمُونني إِن لَم أكُن حَاذِفاً","يَاءً بسَهمٍ طَائِشٍ عَاصِفِ",75,"ف",1,0],["ترمي شياطينَ الأعادي في الوغى","برجومِ خيلٍ من سماءٍ غُبارِ",76,"ر",1,0],["ترمِى بعينيك الفِجاجَ مقلِّبا","ذاتَ الشِّمال بها وذاتَ يمينِ",77,"ن",1,0],["ترمي بألحاظها عن قوس حاجبها","تصيبني ثم تسبيني وتكويني",78,"ن",2,0],["ترمى فؤادىَ أيدي حوادثِه","بأَسْهمٍ عن قِسِيِّها تُرْشَق",79,"ق",1,0],["ترمي الحوادث بي في كل بادرةٍ","ولم ازل دائباً أَبقى ويمضينا",80,"ن",2,0],["ترمقيني بالف لحظ ولحظ","أنا من كل واحد كالطعين",81,"ن",1,0],["تَرمي العِدى بِنَوافِذِ ال","عَزَماتِ مِن آرائِها",82,"ا",3,0],["تَرمي حواجبها قلب المشوق بها","فَتسلب اللب بالتَدعيج وَالكحل",83,"ل",1,0],["تَرمي بعينك في عيون مطافل","لحظاتها بالسحر تقتل من رمى",84,"م",2,0],["تَرْمِي بأَعُيُنِها فِي كُلِّ داجِيةٍ","مِنْهُ إلى كَوْكَبٍ بِالسَّعْدِ سَيّارِ",85,"ر",1,0],["تَرمي الفَلا بِسهامٍ","وَلا سِهامَ الجروخِ",86,"خ",1,0],["تَرمي لَواحِظُهُ عَن قَوسِ حاجِبِهِ","نَبلاً بِها الناسُ في حَربٍ وَفي حَرَبِ",87,"ب",1,0],["تَرمي الحُمَيّا المُحَيّا","مِن ضحكِها بِالقُطوبِ",88,"ب",1,0],["ترمي إلي بأطرافِ الهوانِ ومَا","كانت رِكابي بهِ مرحولةً ذُلُلا",89,"ل",2,1],["تَرمي وما تَدري بما سَفكت","منها اللَواحِظُ من دَمٍ هَدرِ",90,"ر",1,0],["تَرمي عيون ذَوي الشحنا بديهتهُ","بِغيهبٍ وَسراياهم بمحتفلِ",91,"ل",1,0],["ترميهم منهما بكل مدجج","شاكي السلاح إذا استعار الأعزل",92,"ل",1,0],["تَرمي الغُيوبَ بِمِرآتَينِ مِن ذَهَبٍ","صَلتَينِ ضاحيهِما بِالشَمسِ مَصقولُ",93,"ل",1,0],["ترمي به المنسج حالا عن حال","بسلطات كمساحي العمال",94,"ل",1,1],["ترمي وسائله فينا قذائفه","ناراً وسيلاً من التضليل موّارا",95,"ر",2,0],["تَرمي الحَجيج فَتصميهم وَيرشقها","راميهمُ فَيولّي سَهمَه هَدرا",96,"ر",2,0],["تَرمي الجِمارَ فَتُذكي في قُلوبِهِم","جَمراً تَكون لَهُ أَنفاسهم شَررا",96,"ر",2,0],["ترمي بقيس قيس قلب ناشد","أبثينةٌ صبري الجميل سقيم",97,"م",1,0],["ترمي الأعادي منه بالعِراضِ","لنزعِ بابِ الأزمةِ العضّاضِ",98,"ض",1,0],["ترمي بأشباحنا إلى ملكٍ","تأخذ من ماله ومن أدبه",99,"ب",2,0],["ترمي بماءٍ كاللجين","يشفُّ عن خِدع المثاقف",100,"ف",1,0],["ترمِي بألحاظِ مَضْرَحِيٍّ","من المَحاني إلى الرعِّانِ",101,"ن",1,0],["ترمى المقاتلَ لا تُقادُ بها","عن مقلةٍ موقوفةِ القتلِ",102,"ل",1,0],["ترمِي بدار الذلِّ من خلفها","ظهراً وتبغِي في العلا مظهرا",103,"ر",2,0],["تَرمِي به غرضَ الأخطارِ حاجتُهُ","يحلو له المِلحُ أو يصفو له الكَدَرُ",104,"ر",1,0],["تَرمِي الجِمارَ وبين أضلعنا","غرضٌ لها ترميه بالجمرِ",105,"ر",1,0],["تَرمي بِه ِالوَعْرَ لا يَلوي أعِنَّتَهُ","وَتَزحَمُ المَوتَ لا يَثني لَهُ رُكَبا",106,"ب",2