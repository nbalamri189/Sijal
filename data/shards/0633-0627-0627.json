{"poems":[[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66092","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66157","الرمل"]],"verses":[["ساالُوا عَنا العُصُورَ الاوَلا","يومَ فُقْنا الناسَ مَجْدا وعُلا",0,"ل",2,1],["ساالُوا الشامَ ومِصْرا والعِراقْ","وسِواها سائِلُوا السَّبْعَ الطِّباقْ",0,"ق",1,0],["ساالوا الخَطِّيَّ والبِيضَ الرِّقاقْ","ما خَطَطْنا بالقَنا والقُضُبِ",0,"ب",1,0],["ساالي يا مَيُّ فَيْضَ المَدْمَعِ","عنْ حَدِيثي يُنْثُرِ الدَّمْعَ كَلاَما",1,"م",2,0]]}