{"poems":[[99,"عادت لطائرها الذي غناها","https://www.aldiwan.net/poem24777.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[102,"بين ضياعين","https://www.poetsgate.com/ViewPoem.aspx?id=50373",""],[119,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[135,"أميم أجدي عافي الرزء واجشمي","https://www.aldiwan.net/poem24009.html","الطويل"],[214,"يا بريقاً بالحمى قد لمعا","https://www.aldiwan.net/poem13314.html","الرمل"],[409,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[422,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[422,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[469,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[471,"سقى دمنتين ليس لي بهم عهد","https://www.aldiwan.net/poem50453.html","الطويل"],[543,"ليس مصر وطنا لي","https://www.aldiwan.net/poem48138.html","عموديه"],[563,"ادخلو في تصرف الرحمان","https://www.aldiwan.net/poem33743.html","الخفيف"],[563,"إن عين الوجود ليس تنام","https://www.aldiwan.net/poem34186.html","الخفيف"],[572,"وإلى نداك ركبتها زنجية","https://www.aldiwan.net/poem69647.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122825","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133844","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48917","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137958",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53192","الوافر"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116515","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122471","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4869,"مضمار قضاعه","https://www.poetsgate.com/ViewPoem.aspx?id=137915",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[5722,"حنين مغترب","https://www.poetsgate.com/ViewPoem.aspx?id=12689",""],[572,"وإلى نَدَاكَ رَكبتُهَا لجيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9321&r=&rc=178",""]],"verses":[["وإلى نسائم جنة سحرية","قرّحت أجفاني على مغناهَا",0,"ا",3,0],["وَأَليَنُ مَا تُلْفِيهِ وَهْوَ مُخَالِفٌ","وَأَثْبَتُ مَا تُلفِيهِ وَهْوَ مُعَاهِد",1,"د",1,0],["وإلينا جاء الشراة تباعا","حبلت أخصب الجيوب تباعا",2,"ع",2,0],["وإلى نقتطك البحر التجا","وغلى همتك الدهر انتمى",3,"م",2,0],["وَأَليَنَ مِنهُ صَفحَةً لِعَشيرَةٍ","وَخَيراً أَبا ضَيفٍ وَخَيراً لِمَجلِسِ",4,"س",1,0],["والينا لم يزل متصلا","برك الجاري ولن ينقطعا",5,"ع",2,0],["وإلينا منه نظم قد أتى","منه أزهار المعاني جنيت",6,"ت",1,0],["وإلى ناديه في يوم النَّدى","أدبٌ يُجبى ومال يتبدّد",7,"د",1,0],["وألين بعد أحبَّتي","للحادثات من الشدائد",8,"د",1,0],["وإلى ندى عبد الرحيم سرت وفودُ","الأرض من مثنى ومن وحدان",9,"ن",1,0],["وَأَليَنَ مَن مَسَّ الرَحى باتَ يَلتَقي","بِمارِنِهِ الجاديَّ وَالعَنبَرُ الوَردُ",10,"د",1,0],["وإلى نادٍ منَ السُّو","دانِ فيها كُلُّ شُكري",11,"ر",2,0],["وإلينا بنا قريب بعيد","غير أنا لم يدره وهو داني",12,"ن",2,0],["وإلينا مراتب الفضل تعزى","في البرايا وينسب الإكرام",13,"م",1,0],["وَإِلَى نَدَاكَ رَكِبْتُهَا زِنْجِيَّةً","كَرُمَتْ مَنَابِتُ سَاجِهَا وَالعَرْعَرِ",14,"ر",1,1],["وَإلَى نَسيبِ المُصطَفَى وَشَريكِهِ","في فَضلِهِ وَشَبيهِهِ وَسَميِّهِ",15,"ي",2,0],["والينابيعُ حولنا","سلسل ماؤُها سجام",16,"م",1,0],["والين خير في سنى آدابِه","لكنّما الدنيا أساسُ الفِتنة",17,"ه",1,0],["وألين جانبا وأعم نفعا","إذا احمر السماء على التراب",18,"ب",1,0],["والينا إحسانهم بالتصافي","والمؤاخاةِ أعظمُ الإِحسانِ",19,"ن",1,0],["وألين رحمة وأشدّ بأساً","إذا أرسلت عفواً وانتقاما",20,"م",2,0],["وألينهم طبعا وأكرم عشرة","مهاب ومحبوب لدى الوصل والحزر",21,"ر",1,0],["وأَليَنِ من حَريرٍ للمُصَافِي","وَإِن يقسُو الشَّدِيدُ لَهُ فأَقسَى",22,"س",2,0],["وَإِلَينا عُدتَ تَبدُو بِقُفُول","آهِ ما أَدهى الأَغارِيقَ الأُولى",23,"ل",2,0],["وإلين هذآ اليوم تنذآع باخبآر","ومن شآنهآ كم شيخ هل اعبرآته",24,"ت",2,0],["وإلى نداء الأهل ما استمعت","أذناه أو قد لان واقتربا",25,"ب",2,0],["والينابيعُ حفُّلٌ بالأناشي","د تراخى فيها السَّنا والبِلال",26,"ل",1,0],["وإلى نَدَاكَ رَكبتُهَا لجيّة","كَرُمَتْ منابِتُ سَاحِهَا والعَرعَرِ",27,"ر",1,1]]}