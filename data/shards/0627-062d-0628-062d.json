{"poems":[[45,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141033",""],[92,"بين قطرين","https://www.poetsgate.com/ViewPoem.aspx?id=179019",""],[154,"ألم يأن أن يروى فؤاد متيم","https://www.aldiwan.net/poem68576.html","الطويل"],[228,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69412","الطويل"],[3812,"","https://poetry.dctabudhabi.ae/diwan/poem/142188","الطويل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22804","الوافر"],[5419,"حظ","https://www.poetsgate.com/ViewPoem.aspx?id=32223",""],[5419,"عتاب وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=32235",""],[5480,"مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=10858",""],[5533,"أُحِبُّ حَدِيثَها","https://www.poetsgate.com/ViewPoem.aspx?id=179990",""],[5538,"تمر الليالي طوالاً طوالا","https://www.poetsgate.com/ViewPoem.aspx?id=142640",""],[5956,"تخاصمني الحبيبة نايُ أيضاً","https://www.poetsgate.com/ViewPoem.aspx?id=194077",""]],"verses":[["أُحِبُّ حِمصاً إِلى خُناصِرَةٍ","وَكُلُّ نَفسٍ تُحِبُّ مَحياها",0,"ا",3,0],["أُحِبُّ حَبيباً نَجْلَ أوْسٍ لِقَوْلِهِ","فيا دَمعُ أَنجِدني على ساكِني نَجدِ",1,"د",1,0],["أحبّ حمصاً إلى خناصرةٍ","وكلّ نفسٍ تحبّ منشاها",2,"ا",3,0],["أُحب حصاها وهو جمر مؤجَّج","وأهوى ثراها وهو شَوكٌ وأدغال",3,"ل",1,0],["أُحِبُّ حَبيبا لا أُسَمَّيهِ هَيبَةً","وَكتمُ الهَوى للقَلبِ أنكى وأنكأُ",4,"ا",1,0],["أَحبَّ حَتّى مريَمَ الزانِيَه","ثُمَّ دَنا مِنها وَفي مُقلَتِه",5,"ه",1,0],["أحب حتى نجنيهم وجفوتهم","فلا أغاير شياص مرادهم",6,"م",1,0],["أَحَبُّ حَبيبٍ عِندَهُ رَسمُ مَنزِلِ","يُناجِيهِ أَو رَبعٌ مُحِيلٌ يُسائِلُه",7,"ل",2,0],["أحب حياتي وهي كالصاب مرةً","وأكره موتي وهو كالشهد حاليا",8,"ي",2,0],["أُحِبُّ حَديثَها وَتُحِبُّ قُربي","وَما إِن نَلتَقي إِلّا لِماما",9,"م",2,0],["أحبّ حروفَها معنى ولفظا","وأبصر في اسمها للقلب حظّا",10,"ظ",2,1],["أحبّ حبيبي ولكنّ قلبي","يحسّ الجحيم إذا ما اقتربتُ",11,"ت",1,1],["أحب حب الحب والقلب مشتاق","مشتاق لك والشوق يسري فكلي",12,"ل",2,1],["أحب حبك يالغلى حب بوثاق","وأتخيلك يا شوق دايم محلي",12,"ل",2,0],["أُحِبُّ حَدِيثَها في كلِّ حِينٍ","ولَسْتُ بمنْصِتٍ فيما عَدَاها",13,"ا",3,0],["أحب حياتي وأنتم حياتي","فهل جنحتم لقولي تعالا",14,"ل",2,0],["أحب حبيبتي هذي كثيراً","ولن تَجزي على خطئي انتقاما؟",15,"م",2,0]]}