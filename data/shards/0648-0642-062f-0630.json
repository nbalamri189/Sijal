{"poems":[[55,"وردنا بها بين العذيب وضارج","https://www.aldiwan.net/poem29925.html","الطويل"],[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[88,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[49,"أيا أم الأسير سقاك غيث","https://www.aldiwan.net/poem25257.html","الوافر"],[53,"أخالد يا ابن الخالدات مخازيا","https://www.aldiwan.net/poem65963.html","الطويل"],[72,"سواك الذي ودي لديه مضيع","https://www.aldiwan.net/poem43024.html","الطويل"],[87,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[45,"بنا منك فوق الرمل ما بك في الرمل","https://www.aldiwan.net/poem9926.html","الطويل"],[47,"سل الحلبي عن حلب","https://www.aldiwan.net/poem11047.html","مجزوء الوافر"],[47,"بني عثمان أنتم في غني","https://www.aldiwan.net/poem64673.html","الوافر"],[48,"متى أنا للدار المريحة ظاعن","https://www.aldiwan.net/poem23375.html","الطويل"],[48,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[92,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[47,"بَني عُثْمانَ! أنْتُمْ، في غُنَىٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=31120",""],[92,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[154,"وجدت ولا طب لما أنا واجد","https://www.aldiwan.net/poem68550.html","الطويل"],[190,"سمعنا بالوفاء وما رأينا","https://www.aldiwan.net/poem43976.html","الوافر"],[202,"يا فتية الحي كفوا الأعين النجلا","https://www.aldiwan.net/poem51900.html","البسيط"],[203,"سلي بعدك الواشين هل ذاع لي سر","https://www.aldiwan.net/poem45584.html","الطويل"],[216,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[216,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[275,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[297,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[309,"عسى من بلانا بالبعاد يجود","https://www.aldiwan.net/poem16804.html","الطويل"],[371,"وقد ذكرت والتذكار جهدي","https://www.aldiwan.net/poem17738.html","الوافر"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[408,"وقد أطلت ما ترى","https://www.aldiwan.net/poem46492.html","مجزوء الرجز"],[409,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[438,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[445,"إذا سقيت أرض فقد بشرت أرض","https://www.aldiwan.net/poem34784.html","الطويل"],[445,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[466,"طليق الوجه أغلب هاشمي","https://www.aldiwan.net/poem15629.html","الوافر"],[469,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[482,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[498,"ومعصرة أنخت بها","https://www.aldiwan.net/poem67409.html","مجزوء الوافر"],[505,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[518,"هبوني أخفيت الذي بي من الهوى","https://www.aldiwan.net/poem67701.html","الطويل"],[521,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem48672.html","الطويل"],[534,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[556,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[563,"دع المنكرين الجاحدين فإنهم","https://www.aldiwan.net/poem34944.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126701","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122679","الطويل"],[681,"","https://poetry.dctabudhabi.ae/diwan/poem/76589","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54163","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61155","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112962","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109153","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49981","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50022","المتقارب"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122033","الطويل"],[309,"","https://poetry.dctabudhabi.ae/diwan/poem/81091","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108887","الوافر"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138035","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49623","البسيط"],[1727,"","https://poetry.dctabudhabi.ae/diwan/poem/118046","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126645","الوافر"],[1873,"","https://poetry.dctabudhabi.ae/diwan/poem/73010","الوافر"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101673","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75962","البسيط"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103926","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45812","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45765","الطويل"],[3705,"","https://poetry.dctabudhabi.ae/diwan/poem/145357","الطويل"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66552","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114067","المتقارب"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44727","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44685","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94427","الوافر"],[4255,"","https://poetry.dctabudhabi.ae/diwan/poem/203174","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143039","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115305","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127930","الوافر"],[4477,"","https://poetry.dctabudhabi.ae/diwan/poem/202210","الوافر"],[4620,"","https://poetry.dctabudhabi.ae/diwan/poem/199981","المواليا"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52160","الوافر"],[5266,"جَلْجَلَةُ الظّلاَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=210280",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5376,"مررْتُ الدارَ اسألُ عنْ صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188387",""],[5431,"كفاك...","https://www.poetsgate.com/ViewPoem.aspx?id=194243",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5582,"قِفا بِمُقامٍ لِلأَحِبَّةِ ماصِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=63481",""],[5690,"سلوا عن فؤادي من بار واحنا يفدا","https://www.poetsgate.com/ViewPoem.aspx?id=172144",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[572,"وما زالَ يَبْرِي أعظُمَ الجسمِ حُبُّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9354&r=&rc=211",""]],"verses":[["وَقَد ذَعذَعَ اللَيلُ النُجومَ لِغَورِها","كَبَيضِ الأَداحي بَعثَرَتهُ النَقانِقُ",0,"ق",1,0],["وَقَدْ ذُعِرَتْ خَوْلاَنُ بَيْنَ بُيُوتِهَا","غَدَاةَ بَدَتْ مِنْهَا اللُّيَوُث بخَوْلاَنِ",1,"ن",1,0],["وَقَدْ ذَغَرَ الْعُرْبَانَ مِنْكَ غَضَنْفَرٌ","أَزَلُّ عَريضُ الصَّدْرِ سَاعِدُهُ فعْمُ",2,"م",1,0],["وَقَد ذُقتَ طَعمَ الرَدى عِندَما","أُصيبَ قِطارُكَ يَومَ السَفَر",3,"ر",1,0],["وَقَد ذُقتِ الرَزايا وَالمَنايا","وَلا وَلَدٌ لَدَيكِ وَلا عَشيرُ",4,"ر",1,0],["وقد ذَهِلتْ عن طِفلِها كلُّ مُطفلٍ","رؤومٍ وألقتْ حملها كلُّ حاملِ",5,"ل",1,0],["وَقَد ذَكَروا في خادِمِ القَومِ أَنَّهُ","بِما كانَ مِن أَخلاقِهِم يَتَهَذَّبُ",6,"ب",1,0],["وَقَد ذَهَبَ المُمتَلي صِحَّةً","وَصَحَّ السَقيمُ فَلَم يَذهَبِ",7,"ب",1,0],["وَقَد ذُقتُ حَلواءَ البَنينَ عَلى الصِبا","فَلا تَحسَبَنّي قُلتُ ما قُلتُ عَن جَهلِ",8,"ل",1,0],["وَقَد ذَبَحَ الدَجاجَ لَنا","فَأَمسى ديكُهُ عَزَبا",9,"ب",2,0],["وَقَد ذَبَحوكُمُ سَرَفاً وَبَغياً","بِتَلِّ عُقَيبَ إِذ كُرِهَ المِصاعُ",10,"ع",1,0],["وَقَد ذُقتُها ما بَينَ شَهدٍ وَعَلقَمٍ","وَجَرَّبتُها مِن صَحَّةٍ وَسَقامِ",11,"م",1,0],["وقد ذابَتْ بِنارِ الحِقْدِ منها","شَكائِمُها فمازَجَتِ الرُّوَالا",12,"ل",2,0],["وَقَد ذَهَبَت سَلمى بِعَقلِكَ كُلِّهِ","فَهَل غَيرُ صَيدٍ أَحرَزَتهُ حَبائِلُه",13,"ل",2,0],["وقد ذقت حلو العيش دهراً ومره","إلى أن تساوى في فمي الحلو والمر",14,"ر",1,0],["وقد ذر قرن الشمس يلمع نوره","فأطريت منها النور يلمع والقرنا",15,"ن",2,0],["وَقَد ذرفت أَدمعاً","فاِستهزأت بأَدمعي",16,"ع",2,0],["وَقَد ذُبتُ في حُبِّ الغَواني غِوايَةً","وَقَبَّلتُ أَطرافَ البنانِ المُطَرَّفِ",17,"ف",1,0],["وقد ذهب الَّليلُ إلاَّ ذَماً","كما ردَّدَ النَّفَس َ الجارضونا",18,"ن",2,0],["وَقَدْ ذَبَحُوكُمُ سَرَفاً وَبَغياً،","بِتَلّ عُقبََ أذْكَرَهُ المِصَاعُ",19,"ع",1,0],["وقد ذيدَ عنها الزادُ رَفهاً لآكلٍ","وحُرّم فيها الماء صفواً لشارب",20,"ب",1,0],["وَقَد ذَلَّ مَن حاوَلوا نَصرَهُ","فَكَيفَ يَعِزُّ بِهِ المُنتَصِر",21,"ر",1,0],["وَقَد ذُقتُ طَعمَ الحُبِّ بَدءاً وَعَودَةً","فلَم أدرِ هَل مُرَاً تَطَعَّمتُ أم حُلوا",22,"و",2,0],["وقد ذكر الوفاء فقال قوم","مقالا واسعا قبلي وبعدي",23,"د",2,0],["وقد ذكرنا حمول الحيِّ فاحتملت","منَّا الضلوع غراماً أثقل الإبلا",24,"ل",2,0],["وقد ذقتُ من حلوِ الزمانِ ومرِّهِ","فلا الحلو أنساني هواكِ ولا المرُّ",25,"ر",1,0],["وقد ذوى كلُّ ما في الأرضِ من شَجَرٍ","وقد سَفَحْنَ لضُمَ الصَّخْرِ آماقُ",26,"ق",1,0],["وقد ذبلَت أغصانُه وفروعهُ","وحلَّ به خطبٌ من الدَّهرِ مُفْظع",27,"ع",1,0],["وقد ذبُلَت كالياسمينِ جُفونُها","وإن تَفترِ العينانِ فالقلبُ ما فَتر",28,"ر",1,0],["وَقَد ذَبذَبَت بِالحَيِّ دارٌ مُشِتَّةٌ","وَصَرفُ النَوى أَشطانُها وَصُفوقُها",29,"ق",3,0],["وقد ذهبت أيامه وتنكرت","عليه أمور فاظطربن عهود",30,"د",1,0],["وَقَد ذَكَّرتُ وَالتَذكارُ جُهدي","وَقَد نادَيتُ لَو سُمِعَ النَداءُ",31,"ا",2,1],["وقد ذهبت في سر ناسوته الورى","مذاهب يرويها أولوا الألمعية",32,"ه",1,0],["وقد ذكر الغزالي","له جملة علامات",33,"ت",1,0],["وقد ذكرتُ قصَصاً","تحارُ فيهنّ الفِكَرْ",34,"ر",1,0],["وقد ذوى روض المعالي وهل","للروض إن لم تسقه مرتقا",35,"ق",2,0],["وقد ذكَروا أنّ الشبابَ ولايةً","تؤكّدُ بالإجمالِ أو بالتجمُّلِ",36,"ل",1,0],["وقد ذَبُلَت فِي رَوضِ جُودِكَ زَهرَةٌ","ثناؤكَ منها فِي الورى يانِعٌ غَضُّ",37,"ض",1,0],["وَقَدْ ذَكَّرَتْهُمْ جِفاناً نَمَتْكَ","إِلَى كلِّ ملكٍ رفيعِ العِمادِ",38,"د",1,0],["وقد ذهبتْ بصبري واجباتٌ","اِباءُ النَّفْسِ يمنعُ أنْ تُقالا",39,"ل",2,0],["وقد ذقتُ حلو الوجد فيك ومرَّهُ","وأرضعتُ في سهل التباريح والصعب",40,"ب",1,0],["وقد ذهبتْ عنها البشاشةُ بعدَما","تأنَّقَ مرآها وطابَ صعيدُها",41,"د",3,0],["وَقَد ذَرَفَت لِفَقدِ الكَر","مِ فيها أَعيُنُ العِنَبِ",42,"ب",1,0],["وقدْ ذَكَرْتِني لهُ","وتمَّ فيهِ أَمَلي",43,"ل",2,0],["وقد ذاب قلبي اليوم شوقاً وصبوةً","إليك وما ترثي لقلبي منهما",44,"م",2,0],["وَقَد ذَكَرنَ لي بِالكَثيبِ مُؤالِف","قِلاص عدى او قِلاص بَني وَبرِ",45,"ر",1,0],["وقدْ ذَهَبَ الخوارِجُ نَحْوَ هَذا","وما مِثلُ الخوارِجِ من يَقُود",46,"د",1,0],["وَقَد ذَهَبوا عَن طَريقِ الصّوابِ","وأنتَ عليه وما ثَمَّ ثانِ",47,"ن",1,0],["وقد ذلّ وقد كان","محلَّ العزِّ نَجْرانُ",48,"ن",1,0],["وقد ذادهم عن ورد حوض نبينا","لدينا بتبديل من الوهم غالب",49,"ب",1,0],["وقد ذكرت ذاك أن من نفى","ليس يشاهد على ما وصفا",50,"ف",2,0],["وقد ذكرت قبل هذا في الخبر","إنكار من شهدهم ممن حضر",50,"ر",1,0],["وقد ذكرت في الكتاب أولا","إيجابهم كفر الذي قد حولا",50,"ل",2,0],["وقد ذكرت قبل ذا أحداثه","وجوره في الحكم والتياثه",50,"ه",1,0],["وقد ذكرت شرطه عليهم","بذاك إذ قدمه إليهم",50,"م",1,0],["وقد ذكرت بالذي تقدما","من جعل القسم بذاك سلما",50,"م",2,0],["وقد ذكرت ههنا منونها","وسوف أحكي بعد ذا عيونها",50,"ه",2,0],["وقد ذكرت ذاك فيما قد مضى","وجئت بالحجة فيه وانقضى",50,"ض",2,0],["وقد ذكرت أمرها في باب","من قبل هذا الباب في الكتاب",50,"ب",1,0],["وقد ذكرت السبق والفضيلة","بالطهر في مسائل طويلة",50,"ه",1,0],["وقد ذكرت الرد فيما اصله","وقوله يعلم من قد حصله",50,"ه",1,0],["وقد ذكَرُوا البحرَ المحيطَ وَإِنَّما","نَدَاهُ هو البحْرُ الذي البَحرُ نَهرُه",51,"ر",2,0],["وَقَد ذَهبوا لا يهتدونَ طريقهم","وباؤوا بخزيٍ في جميع المذاهبِ",52,"ب",1,0],["وَقد ذَبَلَت خُضرُ الشِّفاهِ مِنَ الطّوى","وَعفَّى عَلى المِسكِ الذَّكيِّ خُلُوفُها",53,"ف",3,0],["وَقَد ذابَ الفُؤادَ وَحَنَّ شَوقاً","لِأَيّام التَآلُفِ وَالوِصالِ",54,"ل",1,0],["وقد ذهبتْ مني القوى وتغيرت","وهل قوةٌ بعد الذهاب تعاودُ",55,"د",1,0],["وقد ذقتما كاسات حب شربتها","على ثقة أن ليس بعتادني ظما",56,"م",2,0],["وَقَد ذَكرت اسمه في الشعر مكتتما","فَابحث عَلَيهِ فَإِني غَير مبديه",57,"ي",2,0],["وَقَدْ ذَكَرْنا النِعَمَ الأحابِرَا","وصَبْوَةً لَمْ تُنْسِنا الأَخافِرا",58,"ر",2,0],["وقد ذللت بعد الجموح نفوسهم","وصارت على نور الهداية والحب",59,"ب",1,0],["وقد ذهبت إِلى الطاهي وسرت إِلى","الخياط بغية أطعامي والباسي",60,"س",2,0],["وقد ذَخرتُ لنفسي من كرامتهِ","بصحبتي وولائي خيرَ مُدَّخرِ",61,"ر",1,0],["وقد ذهبَ النّاسُ أهل التّصافي","وأهل الفضائل إلاّ قليلا",62,"ل",2,0],["وَقدْ ذَهَبَتْ بِالأَمْنِ كُلُّ مَسَاءَةٍ","كَمَا ذَهَبْتْ شَيْمَا الإِمَارَةِ بِالْبَشْرِ",63,"ر",1,0],["وقد ذهب الأساة وقد تفانوا","وواراهم عن الأبصار ترب",64,"ب",1,0],["وقد ذابت حشاشته غراماً","وقام بديلها فيه الغرام",65,"م",1,0],["وقَدْ ذَبَحُوا الحُسَيْنَ بِكَرْبَلاءٍ","لأمْرِ عُبَيْدٍ الباغي الدَّعيِّ",66,"ي",1,0],["وقد ذهبت لها قلبي وما خطري","حتى يعاقب ذاك الحسن من سببي",67,"ب",2,0],["وقد ذوي الأحساب منهم من أقدمى","وإذا الدجل حتى عاد حرباً يبيدها",68,"د",3,1],["وقد ذهلت فلا تبدى كلاما","سوى همس بألفاظ خفيه",69,"ي",2,0],["وَقَد ذَهَبَ الوَفاءُ فَلا","يَقُولُ مُغالِطٌ نَقَصا",70,"ص",2,0],["وقد ذلت الاعداء في كل جانب","وضاق عليهم من فسيح الفضا رحب",71,"ب",1,0],["وقد ذَكَرَها والدي مِن قبلي","وما تَرك شيئاً يصفهُ مثلي",72,"ي",1,0],["وَقَد ذَوت زَهَراتُ الشِعر وا أَسَفا","لَمّا غَدا ماءُ فكري غائِراً يَبَسا",73,"س",2,0],["وقد ذكرنا قبل حال الجبهة","ملخصا فلم نغادر شبهه",74,"ه",1,0],["وقد ذهبَ الوَفاءُ فلسْتُ أرجو","وفاءَ مصاحبٍ بعد الشَّبابِ",75,"ب",1,0],["وقد ذعر البين الصدود فراعه","فولى فما يدرى له اليوم موضع",76,"ع",1,0],["وَقَد ذهبت بَعض الكَرائم حَسرة","إِلى حَيث أَلقَقت رحلها وَالمَكارم",77,"م",1,0],["وَقَد ذَبح الكَبش الرَئيس عَلَيهُم","فَظَنوا بِأَن الكَبش أُضحي لَهُم فَدا",78,"د",2,0],["وقد ذقت طعم البين حتى كأنني","لألفة من أهواه ما ذقت مطعما",79,"م",2,0],["وقد ذكرنا سائِرَ الأحباب","نتلوا لهم فاتحة الكتاب",80,"ب",1,0],["وَقَدْ ذاعَ سِرُّ الزَّهْرِ حينَ وَشى بِهِ","تَنَفُّسُ نَدِّيِّ النَّسيمِ نَدِيِّهِ",81,"ي",2,0],["وقَد ذَاقَ كَأساً دِهَاقاَ وَلَم","يُعَربِد بَلَى كَانَ أصحَى بِهَا",82,"ب",3,0],["وقد ذوَى العود الرطيب فذبل","وقد ذهَلت حين عايَنت الوَهَل",83,"ل",1,0],["وقد ذبح الأنصر إذ ذاك نعجةً","وداروا حواليه وزادهم مدوا",84,"د",3,0],["وَقَد ذَبَحوا الأَطفالَ ظُلماً قَساوة","فَما بِتُ حَيراناً لِأبلغَ غاية",85,"ه",1,0],["وَقَد ذَبُلَت فيَّ مَحاسنُ زَهرَتي","بِكَيتُ دَماً حَتى بَلَلتُ بِهِ الثَرى",86,"ر",2,0],["وقد ذرَّت شموس العلم لَمّا","تبدى بطرسٌ حبر الأوانِ",87,"ن",1,0],["وقد ذهبت إلا شكيراً كأنه","على ناهض لم يبرح العش أزغبا",88,"ب",2,0],["وقد ذفت من حلو الزمان ومره","وجربت طوري، عرفه والتنكر",89,"ر",1,0],["وقد ذَمّتِ الدنيا اليّ نعيمَها","وخاطبني أعجامُها وهو مُعرِبُ",90,"ب",1,0],["وقد ذرفت عيون السحب درَّا","كسا زهر الربى حلل الفخارِ",91,"ر",1,0],["وقد ذهب الذين ولدت فيهم","وقد رحلت لشقتهم ركابي",92,"ب",2,0],["وقد ذهب في مداراتكم حسي","وقد صبوت إلى هوني مع يسّي",93,"ي",1,0],["وقد ذَهَب الشبابُ فكان أَنَّا","تبدّلْنَا من الشَّيبِ الخضَابا",94,"ب",2,0],["وَقَد ذَهَبَتْ تَبْغِي بِذَاكَ شِقَاقَنَا","تُيَمِّمُ أَقْصَى الْبُعْدِ كَيْ تَتَحَامَى",95,"م",2,0],["وَقد ذاقَ حَرَّ السّيفِ صَبْراً مُكَبَّلًا","وَجَرّوهُ فِي الأَسوَاقِ دَامِي الْجَوَانِبِ",96,"ب",1,0],["وقد ذكر ابن القيم الثقة الرضى","على ذاك إجماع الهداة ذوي الرشد",97,"د",1,0],["وقد ذكر الإجماع بعض ذوي النهى","فسل عنه أهل للإصابة من نجد",97,"د",1,0],["وقد ذم جهلاً من سفاهة رائه","على السنة الغراء إماماً مفخما",98,"م",2,0],["وقد ذكر الأتراك قال وحزبهم","ويعني ملوك الدار من ذاك المحل",99,"ل",1,0],["وقد ذكر الأعلام والحق قولهم","جواب سؤال حرروه لمن سأل",99,"ل",1,0],["وقد ذقْنا من الآهاتِ دمعاً","علام الدمع مجراه سكيبُ",100,"ب",1,0],["وقد ذابت أناي بذات وجدٍ","وصارت فيك بعضا من أناكا",101,"ك",2,0],["وَقَدْ ذُعِرُوا لمَّا رأَوْكَ كَمِثْلِ ما","رأَتْ سائِماتُ الطَّيْرِ فِي سَوْمِها الصَّقْرا",102,"ر",2,0],["وَقَدْ ذابَتْ الأَكْبادُ مِنَّا وَأُجِّجَتْ","لَظَىً لِلْجَوَى فِينا وَشَبَّ ضِرامُ",103,"م",1,0],["وَقَدْ ذُدْتُ آمالِي فَأَضْحَتْ سَوامُها","مُعَقَّلَةً عَنْ رَعْيِها فِي المَسارِحِ",104,"ح",1,0],["وقد ذاق مر الصبر بعد بعادكم","عبيدٌ يرى في قربكم مرّه شهدا",105,"د",2,0],["وقد ذاقَ أهلُ الحُبَّ كلَّ نعيمهم","وللهائم المحروم ما يتَلَوَّع",106,"ع",1,0],["وقد ذهبوا في حدسهم كل مذهب","وفيما حوته نفسهُ من مشاعر !",107,"ر",1,0],["وقد ذبتُ حتّى صِرْتُ إنْ أنا زُرْتُها","أَمِنْتُ عليها أَن يَرَى أَهلُهَا شَخْصِي",108,"ي",1,0]]}