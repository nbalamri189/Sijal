{"poems":[[53,"وردنا بها بين العذيب وضارج","https://www.aldiwan.net/poem29925.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[47,"أيا أم الأسير سقاك غيث","https://www.aldiwan.net/poem25257.html","الوافر"],[51,"أخالد يا ابن الخالدات مخازيا","https://www.aldiwan.net/poem65963.html","الطويل"],[70,"سواك الذي ودي لديه مضيع","https://www.aldiwan.net/poem43024.html","الطويل"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[43,"بنا منك فوق الرمل ما بك في الرمل","https://www.aldiwan.net/poem9926.html","الطويل"],[45,"سل الحلبي عن حلب","https://www.aldiwan.net/poem11047.html","مجزوء الوافر"],[45,"بني عثمان أنتم في غني","https://www.aldiwan.net/poem64673.html","الوافر"],[46,"متى أنا للدار المريحة ظاعن","https://www.aldiwan.net/poem23375.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[45,"بَني عُثْمانَ! أنْتُمْ، في غُنَىٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=31120",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""]],"verses":[["وَقَد ذَعذَعَ اللَيلُ النُجومَ لِغَورِها","كَبَيضِ الأَداحي بَعثَرَتهُ النَقانِقُ",0,"ق",1,0],["وَقَدْ ذُعِرَتْ خَوْلاَنُ بَيْنَ بُيُوتِهَا","غَدَاةَ بَدَتْ مِنْهَا اللُّيَوُث بخَوْلاَنِ",1,"ن",1,0],["وَقَدْ ذَغَرَ الْعُرْبَانَ مِنْكَ غَضَنْفَرٌ","أَزَلُّ عَريضُ الصَّدْرِ سَاعِدُهُ فعْمُ",2,"م",1,0],["وَقَد ذُقتَ طَعمَ الرَدى عِندَما","أُصيبَ قِطارُكَ يَومَ السَفَر",3,"ر",1,0],["وَقَد ذُقتِ الرَزايا وَالمَنايا","وَلا وَلَدٌ لَدَيكِ وَلا عَشيرُ",4,"ر",1,0],["وقد ذَهِلتْ عن طِفلِها كلُّ مُطفلٍ","رؤومٍ وألقتْ حملها كلُّ حاملِ",5,"ل",1,0],["وَقَد ذَكَروا في خادِمِ القَومِ أَنَّهُ","بِما كانَ مِن أَخلاقِهِم يَتَهَذَّبُ",6,"ب",1,0],["وَقَد ذَهَبَ المُمتَلي صِحَّةً","وَصَحَّ السَقيمُ فَلَم يَذهَبِ",7,"ب",1,0],["وَقَد ذُقتُ حَلواءَ البَنينَ عَلى الصِبا","فَلا تَحسَبَنّي قُلتُ ما قُلتُ عَن جَهلِ",8,"ل",1,0],["وَقَد ذَبَحَ الدَجاجَ لَنا","فَأَمسى ديكُهُ عَزَبا",9,"ب",2,0],["وَقَد ذَبَحوكُمُ سَرَفاً وَبَغياً","بِتَلِّ عُقَيبَ إِذ كُرِهَ المِصاعُ",10,"ع",1,0],["وَقَد ذُقتُها ما بَينَ شَهدٍ وَعَلقَمٍ","وَجَرَّبتُها مِن صَحَّةٍ وَسَقامِ",11,"م",1,0],["وقد ذابَتْ بِنارِ الحِقْدِ منها","شَكائِمُها فمازَجَتِ الرُّوَالا",12,"ل",2,0],["وَقَد ذَهَبَت سَلمى بِعَقلِكَ كُلِّهِ","فَهَل غَيرُ صَيدٍ أَحرَزَتهُ حَبائِلُه",13,"ل",2,0],["وقد ذقت حلو العيش دهراً ومره","إلى أن تساوى في فمي الحلو والمر",14,"ر",1,0],["وقد ذر قرن الشمس يلمع نوره","فأطريت منها النور يلمع والقرنا",15,"ن",2,0],["وَقَد ذرفت أَدمعاً","فاِستهزأت بأَدمعي",16,"ي",1,0],["وَقَد ذُبتُ في حُبِّ الغَواني غِوايَةً","وَقَبَّلتُ أَطرافَ البنانِ المُطَرَّفِ",17,"ف",1,0],["وقد ذهب الَّليلُ إلاَّ ذَماً","كما ردَّدَ النَّفَس َ الجارضونا",18,"ن",2,0],["وَقَدْ ذَبَحُوكُمُ سَرَفاً وَبَغياً،","بِتَلّ عُقبََ أذْكَرَهُ المِصَاعُ",19,"ع",1,0],["وقد ذيدَ عنها الزادُ رَفهاً لآكلٍ","وحُرّم فيها الماء صفواً لشارب",20,"ب",1,0]]}